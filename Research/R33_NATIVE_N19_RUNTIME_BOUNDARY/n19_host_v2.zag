// Prospective N19 host adapter. No learner, parent-state or registry access.
// Open a root once, pass its descriptor to all leaf operations, then close it.
// This source alone is not runtime qualification evidence.

struct N19HostResult {
    status:i32,
    detail:i64,
    fd:i64,
}

fn n19h_result(status:i32,detail:i64,fd:i64)N19HostResult {
    return N19HostResult{.status=status,.detail=detail,.fd=fd};
}

// Classify open/openat failures under the pinned Darwin operation contract.
// EINVAL is an ABI refusal here because flags and modes are adapter-owned.
// Read/write/fsync/close failures must use the separate I/O classification.
fn n19h_open_status(raw:i64)i32 {
    if(raw>=0){return 0;}
    if(raw==-1 || raw==-2 || raw==-9 || raw==-13 || raw==-17 || raw==-20 || raw==-21 || raw==-62 || raw==-63){return -1904;}
    if(raw==-22 || raw==-45 || raw==-78){return -1999;}
    return -1905;
}

fn n19h_io_status(raw:i64)i32 {
    if(raw>=0){return 0;}return -1905;
}

fn n19h_alloc(n:i32)[]u8 {
    if(n<1 || n>4096){return "";}
    let p:*u8=_zag_malloc(n) as *u8;if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;while(i<n){b[i]=0;i=i+1;}return b;
}

fn n19h_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
}

fn n19h_name_ok(s:[]u8,leaf:i32)i32 {
    if(s.len<1 || s.len>=256){return 0;}
    if(leaf==1 && s.len==1 && s[0]==46){return 0;}
    if(leaf==1 && s.len==2 && s[0]==46 && s[1]==46){return 0;}
    let i:i32=0;
    while(i<s.len){if(s[i]==0 || (leaf==1 && s[i]==47)){return 0;}i=i+1;}
    return 1;
}

fn n19h_cstr(s:[]u8)[]u8 {
    let b:[]u8=n19h_alloc(s.len+1);if(b.len==0){return b;}
    let i:i32=0;while(i<s.len){b[i]=s[i];i=i+1;}return b;
}

fn n19h_u16(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8);
}

fn n19h_u32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}

fn n19h_stat(fd:i64,directory:i32,exact_mode:i32)N19HostResult {
    if(fd<0){return n19h_result(-1904,0,-1);}
    let b:[]u8=n19h_alloc(256);if(b.len!=256){return n19h_result(-1905,0,-1);}
    let raw:i64=_zag_darwin_syscall(339,fd,_zag_slice_ptr(b) as i64,0,0,0,0);
    if(raw!=0){n19h_free(b);return n19h_result(-1905,raw,-1);}
    let mode:i32=n19h_u16(b,4);let links:i32=n19h_u16(b,6);let owner:i64=n19h_u32(b,16);
    let uid:i64=_zag_darwin_syscall(24,0,0,0,0,0,0);n19h_free(b);
    if(uid<0){return n19h_result(-1905,uid,-1);}
    let kind:i32=32768;if(directory==1){kind=16384;}
    if((mode & 61440)!=kind || owner!=uid){return n19h_result(-1904,0,-1);}
    if(directory==0 && (links!=1 || (exact_mode==1 && (mode & 511)!=384))){return n19h_result(-1904,0,-1);}
    return n19h_result(0,0,fd);
}

fn n19h_finish_open(fd:i64,directory:i32,exact_mode:i32)N19HostResult {
    if(fd<0){return n19h_result(n19h_open_status(fd),fd,-1);}
    let result:N19HostResult=n19h_stat(fd,directory,exact_mode);
    if(result.status!=0){
        let closed:i64=_zag_darwin_syscall(6,fd,0,0,0,0,0);
        if(closed!=0){return n19h_result(-1905,closed,-1);}
    }
    return result;
}

fn n19h_root_open(path:[]u8)N19HostResult {
    if(n19h_name_ok(path,0)!=1){return n19h_result(-1904,0,-1);}
    let p:[]u8=n19h_cstr(path);if(p.len==0){return n19h_result(-1905,0,-1);}
    // O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW_ANY.
    let fd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(p) as i64,554696704,0,0,0,0);
    n19h_free(p);return n19h_finish_open(fd,1,0);
}

fn n19h_leaf_open(rootfd:i64,leaf:[]u8,create:i32)N19HostResult {
    if(rootfd<0 || n19h_name_ok(leaf,1)!=1 || (create!=0 && create!=1)){return n19h_result(-1904,0,-1);}
    let p:[]u8=n19h_cstr(leaf);if(p.len==0){return n19h_result(-1905,0,-1);}
    // O_RDWR | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC; creation adds O_CREAT|O_EXCL.
    // NONBLOCK prevents waiting on a special file before its type is checked.
    let flags:i64=16777478;if(create==1){flags=16780038;}
    let fd:i64=_zag_darwin_syscall(463,rootfd,_zag_slice_ptr(p) as i64,flags,384,0,0);
    n19h_free(p);return n19h_finish_open(fd,0,create);
}

// The caller owns a retained root; leaf operations borrow it and never close it.
// A handle is invalidated before close so a failure cannot cause a double close.
fn n19h_close_owned(handle:*N19HostResult)N19HostResult {
    if(handle==null as *N19HostResult){return n19h_result(-1904,0,-1);}
    if(handle.*.status!=0 || handle.*.fd<0){return n19h_result(-1904,0,-1);}
    let fd:i64=handle.*.fd;handle.*.fd=-1;handle.*.status=-1904;
    let raw:i64=_zag_darwin_syscall(6,fd,0,0,0,0,0);
    if(raw!=0){return n19h_result(-1905,raw,-1);}return n19h_result(0,0,-1);
}

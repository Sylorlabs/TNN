fn n19_case_extra_invariants()i32 {
    let failed:i32=0;let record:[]u8=n19_alloc(N19_RECORD_BYTES);if(record.len==0){return 1;}
    let kind:i32=0;
    while(kind<5){
        let state:N19State=n19_empty_state();n19_encode(record,1,"bounded");
        if(kind==0){n19_put32(record,0,0);}if(kind==1){n19_put32(record,4,2);}
        if(kind==2){n19_put32(record,8,17);}if(kind==3){n19_put32(record,8,-1);}if(kind==4){record[12]=record[12]^1;}
        // Recompute checksum for structural attacks so checksum alone cannot hide a missing invariant.
        if(kind<4){n19_put32(record,28,n19_checksum(record,28));}
        let rc:i32=n19_append(&state,record);
        if(rc==N19_OK || state.sequence!=0 || state.event_count!=0 || state.journal_bytes!=0 || state.audit_head!=0){failed=failed+1;}
        let recovered:i32=n19_recover(record,&state);
        if(recovered==N19_OK || state.sequence!=0 || state.event_count!=0 || state.poisoned!=1 || state.recovered!=0){failed=failed+1;}
        n19_encode(record,1,"valid");if(n19_append(&state,record)!=N19_REFUSED_RECOVERY || state.sequence!=0){failed=failed+1;}
        kind=kind+1;
    }
    let state:N19State=n19_empty_state();n19_encode(record,1,"first");
    if(n19_append(&state,record)!=N19_OK){failed=failed+1;}
    if(n19_append(&state,record)!=N19_REFUSED_RECOVERY || state.sequence!=1 || state.event_count!=1 || state.journal_bytes!=32 || state.audit_head!=1){failed=failed+1;}
    if(n19_recover_fd(-1,&state)!=N19_REFUSED_MALFORMED || state.poisoned!=1 || state.sequence!=1){failed=failed+1;}
    n19_free(record);_zag_print("N19_EXTRA_INVARIANTS,failures,");n19_print_i64(failed as i64);_zag_println("");return failed;
}

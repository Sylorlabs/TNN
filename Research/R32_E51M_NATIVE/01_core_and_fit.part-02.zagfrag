        if(terminal_weights[R32E45_TERM_UNKNOWN*E45_FEATURES+i]!=0){ unknown_nonzero=unknown_nonzero+1; }
        i=i+1;
    }
    if(unknown_nonzero!=0){ gate=0; }
    _zag_print("e51m_base_fit,");
    e45_print_i32(steps_forward); _zag_print(",");
    e45_print_i32(reason_forward); _zag_print(",");
    e45_print_i32(trace_forward); _zag_print(",");
    e45_print_i32(loss_high_forward); _zag_print(",");
    e45_print_i32(loss_low_forward); _zag_print(",");
    e45_print_i32(unknown_nonzero); _zag_print(",");
    e45_print_i32(gate); _zag_println("");
    zfree(gram_forward); zfree(gram_reverse); zfree(cross_forward); zfree(cross_reverse);
    zfree(backup_weights); zfree(backup_biases); zfree(forward_weights); zfree(forward_biases);
    return gate;
}

fn e51m_top_commit(
    features:[]i32,
    feature_start:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    scores:[]i32
)i32 {
    let action:i32=0;
    while(action<3){
        scores[action]=e47_linear_predict(
            terminal_weights,action*E45_FEATURES,
            features,feature_start,terminal_biases[action]
        );
        action=action+1;
    }
    scores[R32E45_TERM_UNKNOWN]=0;
    let choice:i32=R32E45_TERM_KEEP;
    let best:i32=scores[R32E45_TERM_KEEP];
    if(scores[R32E45_TERM_CURRENT]>best){ choice=R32E45_TERM_CURRENT; best=scores[R32E45_TERM_CURRENT]; }
    if(scores[R32E45_TERM_RESTORE]>best){ choice=R32E45_TERM_RESTORE; }
    return choice;
}

fn e51m_build_calibration_episode(
    seed:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    canonical_episode:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    calibration_records:[]i32,
    positive:*i32,
    negative:*i32,
    neutral:*i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);
    let model_features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(4);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0; let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_copy(states,live_state,E45_STATE_N);
    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
        e45_terminal_projection(option,terminal_option);
        e45_fill_full_features(
            states,t*E45_STATE_N,terminal_option,0,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,full_features
        );
        e45_mask_features(full_features,E45_ARM_D,baseline_features);
        let co_viability:i32=0; let contradiction_co_mass:i32=0;
        e47_terminal_representation(states,t*E45_STATE_N,terminal_option,0,&co_viability,&contradiction_co_mass);
        e50_build_model_features(baseline_features,0,co_viability,contradiction_co_mass,0,model_features,0);
        let top_action:i32=e51m_top_commit(model_features,0,terminal_weights,terminal_biases,scores);
        let grounded:i32=e45_terminal_value(top_action,states,t*E45_STATE_N,initial_state,truth_state[t]);
        let sign_target:i32=0;
        if(grounded>0){ sign_target=1000; positive.*=positive.*+1;
        }else{
            if(grounded<0){ sign_target=-1000; negative.*=negative.*+1;
            }else{ neutral.*=neutral.*+1; }
        }
        let record_number:i32=canonical_episode*E51M_STATES_PER_EPISODE+t;
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            calibration_records[record_start+feature]=model_features[feature];
            feature=feature+1;
        }
        calibration_records[record_start+E51M_CAL_TARGET]=sign_target;
        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0;
            while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(option); zfree(terminal_option); zfree(full_features); zfree(baseline_features);
    zfree(model_features); zfree(scores);
}

fn e51m_scalar_predict_record(
    records:[]i32,
    record_start:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32
)i32 {
    let value:i64=bias as i64;
    let feature:i32=0;
    while(feature<E45_FEATURES){
        value=value+((weights[weight_start+feature] as i64)*(records[record_start+feature] as i64))/1000;
        feature=feature+1;
    }
    if(value<-4000){ return -4000; }
    if(value>4000){ return 4000; }
    return value as i32;
}

fn e51m_build_scalar_statistics(
    records:[]i32,
    sample_count:i32,

    zfree(base_records); zfree(calibration_records); zfree(terminal_weights); zfree(terminal_biases);
    zfree(gram_forward); zfree(gram_reverse); zfree(cross_forward); zfree(cross_reverse); zfree(backup_weights);
    zfree(linear_forward_weights); zfree(linear_reverse_weights); zfree(linear_forward_biases); zfree(linear_reverse_biases);
    zfree(means_forward); zfree(means_reverse);
    zfree(term_features_forward); zfree(term_features_reverse); zfree(term_directions_forward); zfree(term_directions_reverse);
    zfree(term_coefficients_forward); zfree(term_coefficients_reverse); zfree(term_counts_forward); zfree(term_counts_reverse); zfree(dose_gates);
    zfree(dev_positive_total); zfree(dev_positive_correct); zfree(dev_negative_total); zfree(dev_negative_correct);
    zfree(validation_positive_total); zfree(validation_positive_correct); zfree(validation_negative_total); zfree(validation_negative_correct);
    zfree(known_reachable); zfree(no_unique_reachable);
    if(integrity_gate==1){ return 1; }
    return 0;
}

    e45_print_pair("e51m_validation_no_unique_episodes",no_unique_episodes);
    _zag_println("e51m_arm_columns,arm,dose_minus1_control,capacity_requested,capacity_used,development_positive_correct,development_positive_total,development_negative_correct,development_negative_total,validation_positive_correct,validation_positive_total,validation_negative_correct,validation_negative_total,known_reachable,no_unique_unknown_reachable");
    let arm:i32=0;
    while(arm<E51M_ARMS){
        let printed_dose:i32=-1; let requested:i32=0; let used:i32=0;
        if(arm>0){
            let slot:i32=arm-1;
            printed_dose=slot/E51M_CAPS;
            let cap:i32=slot-printed_dose*E51M_CAPS;
            requested=e51m_cap_terms(cap);
            used=requested; if(used>term_counts_forward[printed_dose]){ used=term_counts_forward[printed_dose]; }
        }
        _zag_print("e51m_arm,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(printed_dose); _zag_print(","); e45_print_i32(requested); _zag_print(","); e45_print_i32(used); _zag_print(",");
        e45_print_i32(dev_positive_correct[arm]); _zag_print(","); e45_print_i32(dev_positive_total[arm]); _zag_print(","); e45_print_i32(dev_negative_correct[arm]); _zag_print(","); e45_print_i32(dev_negative_total[arm]); _zag_print(",");
        e45_print_i32(validation_positive_correct[arm]); _zag_print(","); e45_print_i32(validation_positive_total[arm]); _zag_print(","); e45_print_i32(validation_negative_correct[arm]); _zag_print(","); e45_print_i32(validation_negative_total[arm]); _zag_print(",");
        e45_print_i32(known_reachable[arm]); _zag_print(","); e45_print_i32(no_unique_reachable[arm]); _zag_println("");
        arm=arm+1;
    }

    let dose_identity_gate:i32=1;
    dose=0;
    while(dose<E51M_DOSES){ if(dose_gates[dose]==0){ dose_identity_gate=0; } dose=dose+1; }
    let validation_count_gate:i32=0;
    if(known_episodes==4200 && no_unique_episodes==1200){ validation_count_gate=1; }
    let integrity_gate:i32=0;
    if(seed_gate==1 && base_sample_gate==1 && base_fit_gate==1 && calibration_sample_gate==1 && dose_identity_gate==1 && validation_count_gate==1){ integrity_gate=1; }
    let exact_gate:i32=0;
    arm=1;
    while(arm<E51M_ARMS){
        if(known_reachable[arm]==known_episodes && no_unique_reachable[arm]==no_unique_episodes){ exact_gate=1; }
        arm=arm+1;
    }
    let dose_signal:i32=0;
    let cap:i32=0;
    while(cap<E51M_CAPS){
        dose=1;
        while(dose<E51M_DOSES){
            let prior_arm:i32=e51m_arm_index(dose-1,cap);
            let current_arm:i32=e51m_arm_index(dose,cap);
            if(known_reachable[current_arm]>=known_reachable[prior_arm] && no_unique_reachable[current_arm]>=no_unique_reachable[prior_arm]){
                if(known_reachable[current_arm]>known_reachable[prior_arm] || no_unique_reachable[current_arm]>no_unique_reachable[prior_arm]){ dose_signal=1; }
            }
            dose=dose+1;
        }
        cap=cap+1;
    }
    let capacity_signal:i32=0;
    dose=0;
    while(dose<E51M_DOSES){
        cap=1;
        while(cap<E51M_CAPS){
            let prior_arm:i32=e51m_arm_index(dose,cap-1);
            let current_arm:i32=e51m_arm_index(dose,cap);
            if(known_reachable[current_arm]>=known_reachable[prior_arm] && no_unique_reachable[current_arm]>=no_unique_reachable[prior_arm]){
                if(known_reachable[current_arm]>known_reachable[prior_arm] || no_unique_reachable[current_arm]>no_unique_reachable[prior_arm]){ capacity_signal=1; }
            }
            cap=cap+1;
        }
        dose=dose+1;
    }
    e45_print_pair("e51m_dose_forward_reverse_identity_gate",dose_identity_gate);
    e45_print_pair("e51m_validation_count_gate",validation_count_gate);
    e45_print_pair("e51m_integrity_gate",integrity_gate);
    e45_print_pair("e51m_exact_validation_rescue_gate",exact_gate);
    e45_print_pair("e51m_monotonic_dose_signal_gate",dose_signal);
    e45_print_pair("e51m_monotonic_capacity_signal_gate",capacity_signal);
    e45_print_pair("e51m_confirmation_eligible",exact_gate);
    e45_print_pair("e51m_sealed_confirmation_executed_final",0);
    if(integrity_gate==0){
        _zag_println("e51m_outcome,INTEGRITY_FAILURE");
        _zag_println("TNN_R32_E51M_CALIBRATION_DOSE_CAPACITY_GATE=FAIL");
    }else{
        if(exact_gate==1){
            _zag_println("e51m_outcome,CALIBRATION_DOSE_CAPACITY_RESCUE");
        }else{
            if(dose_signal==1){
                _zag_println("e51m_outcome,CALIBRATION_DOSE_SIGNAL");
            }else{
                if(capacity_signal==1){
                    _zag_println("e51m_outcome,CALIBRATION_CAPACITY_SIGNAL");
                }else{
                    _zag_println("e51m_outcome,CALIBRATION_DOSE_CAPACITY_PLATEAU");
                }
            }
        }
        _zag_println("TNN_R32_E51M_CALIBRATION_DOSE_CAPACITY_GATE=COMPLETE");
    }

    zfree(dev_seeds); zfree(validation_seeds); zfree(confirmation_seeds);

// R32 E51M calibration training-dose x boundary-capacity curve.
// Native Zag v2 only. Learner-visible state and grounded consequence targets only.
// UNKNOWN remains a fixed neutral action at score zero; no ambiguity classifier.

const E51M_DEV_BLOCK_EPISODES:i32=3240;
const E51M_DEV_EPISODES:i32=12960;
const E51M_DEV_SAMPLES:i32=220320;
const E51M_VALIDATION_EPISODES:i32=5400;
const E51M_VALIDATION_SAMPLES:i32=91800;
const E51M_CONFIRM_EPISODES:i32=10800;
const E51M_DOSES:i32=3;
const E51M_CAPS:i32=4;
const E51M_ARMS:i32=12;
const E51M_SCALAR_RECORD_N:i32=33;
const E51M_SCALAR_COLUMNS:i32=33;
const E51M_SCALAR_GRAM:i32=E51M_SCALAR_COLUMNS*E51M_SCALAR_COLUMNS;
const E51M_HINGE_MAX:i32=16;

fn e51m_dose_samples(dose:i32)i32 {
    if(dose==0){ return 55080; }
    if(dose==1){ return 110160; }
    return 220320;
}

fn e51m_cap_terms(cap:i32)i32 {
    if(cap==0){ return 0; }
    if(cap==1){ return 4; }
    if(cap==2){ return 8; }
    return 16;
}

fn e51m_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    dev_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32
)i32 {
    e45_zero(dev_seeds,E51M_DEV_EPISODES);
    e45_zero(validation_seeds,E51M_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E51M_CONFIRM_EPISODES);
    let failures:i32=0;
    let emitted:i32=0;
    let block:i32=0;
    while(block<4){
        let epoch:i32=0;
        while(epoch<2){
            let base_index:i32=0;
            while(base_index<3){
                let mode:i32=0;
                while(mode<E45_MODES){
                    let resource:i32=0;
                    while(resource<E45_RESOURCES){
                        let episode:i32=0;
                        while(episode<12){
                            let local_index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                            let index:i32=block*E51M_DEV_BLOCK_EPISODES+local_index;
                            let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,52,index,mode,resource,&failures);
                            dev_seeds[index]=seed;
                            emitted=emitted+1;
                            episode=episode+1;
                        }
                        resource=resource+1;
                    }
                    mode=mode+1;
                }
                base_index=base_index+1;
            }
            epoch=epoch+1;
        }
        block=block+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,53,index,mode,resource,&failures);
                    validation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<40){
                    let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,54,index,mode,resource,&failures);
                    confirmation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51m_seed_manifest_emitted",emitted);
    e45_print_pair("e51m_seed_assignment_failures",failures);
    e45_print_pair("e51m_max_development_episodes",E51M_DEV_EPISODES);
    e45_print_pair("e51m_validation_episodes",E51M_VALIDATION_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_allocated",E51M_CONFIRM_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_executed",0);
    if(failures==0 && emitted==E51M_DEV_EPISODES+E51M_VALIDATION_EPISODES+E51M_CONFIRM_EPISODES){ return 1; }
    return 0;
}

fn e51m_build_episode_set(
    seeds:[]i32,
    blocks:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_records:[]i32,
    continue_records:[]i32,
    unknown_nonzero:*i32
)i32 {
    let continue_positive:i32=0;
    let continue_negative:i32=0;
    let built:i32=0;
    let block:i32=0;
    while(block<blocks){
        let epoch:i32=0;
        while(epoch<2){
            let base_index:i32=0;
            while(base_index<3){
                let mode:i32=0;
                while(mode<E45_MODES){
                    let resource:i32=0;
                    while(resource<E45_RESOURCES){
                        let episode:i32=0;
                        while(episode<12){
                            let local_index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                            let index:i32=block*E51M_DEV_BLOCK_EPISODES+local_index;
                            e51e_build_training_episode(
                                seeds[index],mode,resource,index,
                                source_trust,dependence_penalty,consequence,hazard,
                                shadow_weights,shadow_bias,terminal_records,continue_records,
                                unknown_nonzero,&continue_positive,&continue_negative
                            );
                            built=built+1;
                            episode=episode+1;
                        }
                        resource=resource+1;
                    }
                    mode=mode+1;
                }
                base_index=base_index+1;
            }
            epoch=epoch+1;
        }
        block=block+1;
    }
    return built;
}

fn e51m_build_validation_set(
    seeds:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_records:[]i32,
    continue_records:[]i32,
    unknown_nonzero:*i32
)i32 {
    let continue_positive:i32=0;
    let continue_negative:i32=0;
    let built:i32=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    e51e_build_training_episode(
                        seeds[index],mode,resource,index,
                        source_trust,dependence_penalty,consequence,hazard,
                        shadow_weights,shadow_bias,terminal_records,continue_records,
                        unknown_nonzero,&continue_positive,&continue_negative
                    );
                    built=built+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    return built;
}

fn e51m_unknown_zero(weights:[]i32,biases:[]i32)i32 {
    if(biases[3]!=0){ return 0; }
    let feature:i32=0;
    while(feature<E45_FEATURES){
        if(weights[3*E45_FEATURES+feature]!=0){ return 0; }
        feature=feature+1;
    }
    return 1;
}

fn e51m_top_commit(
    features:[]i32,
    feature_start:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    scores:[]i32
)i32 {
    let action:i32=0;
    while(action<3){
        scores[action]=e47_linear_predict(
            terminal_weights,action*E45_FEATURES,features,feature_start,terminal_biases[action]
        );
        action=action+1;
    }
    let choice:i32=0;
    let best:i32=scores[0];
    if(scores[1]>best){ choice=1; best=scores[1]; }
    if(scores[2]>best){ choice=2; }
    return choice;
}

fn e51m_build_scalar_records(
    terminal_records:[]i32,
    sample_n:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    scalar_records:[]i32,
    positive:*i32,
    negative:*i32,
    neutral:*i32
)void {
    positive.*=0; negative.*=0; neutral.*=0;
    let features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(3);
    let record:i32=0;
    while(record<sample_n){
        let source_start:i32=record*E50_RECORD_N;
        let scalar_start:i32=record*E51M_SCALAR_RECORD_N;
        e50_build_model_features(
            terminal_records,source_start,terminal_records[source_start+32],terminal_records[source_start+33],0,
            features,0
        );
        let feature:i32=0;
        while(feature<E45_FEATURES){ scalar_records[scalar_start+feature]=features[feature]; feature=feature+1; }
        let top:i32=e51m_top_commit(features,0,terminal_weights,terminal_biases,scores);
        let utility:i32=terminal_records[source_start+34+top];
        let target:i32=0;
        if(utility>0){ target=1000; positive.*=positive.*+1; }
        if(utility<0){ target=-1000; negative.*=negative.*+1; }
        if(utility==0){ neutral.*=neutral.*+1; }
        scalar_records[scalar_start+32]=target;
        record=record+1;
    }
    zfree(features); zfree(scores);
}

fn e51m_scalar_column(records:[]i32,record_start:i32,column:i32)i32 {
    if(column==0){ return 1000; }
    return records[record_start+column-1];
}

fn e51m_build_scalar_stats(
    records:[]i32,
    sample_n:i32,
    reverse:i32,
    gram:[]i32,
    cross:[]i32,
    count:*i32,
    hash:*i32
)void {
    e45_zero(gram,E51M_SCALAR_GRAM);
    e45_zero(cross,E51M_SCALAR_COLUMNS);
    count.*=0;
    let traversal:i32=0;
    while(traversal<sample_n){
        let record:i32=traversal;
        if(reverse==1){ record=sample_n-1-traversal; }
        let start:i32=record*E51M_SCALAR_RECORD_N;
        let target:i64=records[start+32] as i64;
        let row:i32=0;
        while(row<E51M_SCALAR_COLUMNS){
            let rv:i64=e51m_scalar_column(records,start,row) as i64;
            cross[row]=cross[row]+(e50_signed_div_i64(rv*target,1000) as i32);
            let column:i32=0;
            while(column<E51M_SCALAR_COLUMNS){
                let cv:i64=e51m_scalar_column(records,start,column) as i64;
                gram[row*E51M_SCALAR_COLUMNS+column]=gram[row*E51M_SCALAR_COLUMNS+column]+(e50_signed_div_i64(rv*cv,1000) as i32);
                column=column+1;
            }
            row=row+1;
        }
        count.*=count.*+1;
        traversal=traversal+1;
    }
    let i:i32=0;
    while(i<E51M_SCALAR_GRAM){ hash.*=e46_hash_update(hash.*,gram[i]); i=i+1; }
    i=0;
    while(i<E51M_SCALAR_COLUMNS){ hash.*=e46_hash_update(hash.*,cross[i]); i=i+1; }
}

fn e51m_scalar_predict(weights:[]i32,weight_start:i32,bias:i32,records:[]i32,record_start:i32)i32 {
    let value:i32=bias;
    let feature:i32=0;
    while(feature<E45_FEATURES){
        value=value+weights[weight_start+feature]*records[record_start+feature]/1000;
        feature=feature+1;
    }
    return r32e45_clamp(value,-4000,4000);
}

fn e51m_scalar_loss(
    records:[]i32,
    sample_n:i32,
    reverse:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32
)i64 {
    let loss:i64=0;
    let traversal:i32=0;
    while(traversal<sample_n){
        let record:i32=traversal;
        if(reverse==1){ record=sample_n-1-traversal; }
        let start:i32=record*E51M_SCALAR_RECORD_N;
        let predicted:i32=e51m_scalar_predict(weights,weight_start,bias,records,start);
        let residual:i32=r32e45_clamp(records[start+32]-predicted,-3000,3000);
        loss=loss+(residual as i64)*(residual as i64);
        traversal=traversal+1;
    }
    return loss;
}

fn e51m_scalar_fit(
    records:[]i32,
    sample_n:i32,
    reverse:i32,
    gram:[]i32,
    cross:[]i32,
    weights:[]i32,
    weight_start:i32,
    bias:*i32,
    backup_weights:[]i32,
    accepted:*i32,
    reason:*i32,
    trace:*i32,
    loss_low:*i32,
    loss_high:*i32
)void {
    let zi:i32=0; while(zi<E45_FEATURES){ weights[weight_start+zi]=0; zi=zi+1; } bias.*=0; e45_zero(backup_weights,E45_FEATURES);
    accepted.*=0; reason.*=3; trace.*=311;
    let current_loss:i64=e51m_scalar_loss(records,sample_n,reverse,weights,weight_start,bias.*);
    trace.*=e50_hash_loss(trace.*,current_loss);
    let sweep:i32=0;
    let stopped:i32=0;
    while(sweep<E50_BATCH_MAX_STEPS && stopped==0){
        let feature:i32=0;
        while(feature<E45_FEATURES){ backup_weights[feature]=weights[weight_start+feature]; feature=feature+1; }
        let backup_bias:i32=bias.*;
        let changed:i32=0;
        let column:i32=0;
        while(column<E51M_SCALAR_COLUMNS){
            let diagonal:i32=gram[column*E51M_SCALAR_COLUMNS+column];
            let current:i32=bias.*;
            if(column>0){ current=weights[weight_start+column-1]; }
            let candidate:i32=0;
            if(diagonal>0){
                let weighted_sum:i64=0;
                let other:i32=0;
                while(other<E51M_SCALAR_COLUMNS){
                    if(other!=column){
                        let parameter:i32=bias.*;
                        if(other>0){ parameter=weights[weight_start+other-1]; }
                        weighted_sum=weighted_sum+(gram[column*E51M_SCALAR_COLUMNS+other] as i64)*(parameter as i64);
                    }
                    other=other+1;
                }
                let numerator:i64=(cross[column] as i64)*1000-weighted_sum;
                candidate=e50_round_nearest_i64(numerator,diagonal as i64) as i32;
                if(column==0){ candidate=r32e45_clamp(candidate,-4000,4000);
                }else{ candidate=r32e45_clamp(candidate,-16000,16000); }
            }
            if(candidate!=current){ changed=1; }
            if(column==0){ bias.*=candidate; }else{ weights[weight_start+column-1]=candidate; }
            column=column+1;
        }
        if(changed==0){ reason.*=1; stopped=1;
        }else{
            let candidate_loss:i64=e51m_scalar_loss(records,sample_n,reverse,weights,weight_start,bias.*);
            if(candidate_loss<current_loss){
                current_loss=candidate_loss; accepted.*=accepted.*+1; trace.*=e50_hash_loss(trace.*,current_loss);
            }else{
                feature=0; while(feature<E45_FEATURES){ weights[weight_start+feature]=backup_weights[feature]; feature=feature+1; }
                bias.*=backup_bias; reason.*=2; stopped=1;
            }
        }
        sweep=sweep+1;
    }
    loss_low.*=e50_loss_low(current_loss); loss_high.*=e50_loss_high(current_loss);
}

fn e51m_fit_scalar_identity(
    records:[]i32,
    sample_n:i32,
    dose:i32,
    weights:[]i32,
    weight_start:i32,
    bias:*i32
)i32 {
    let gf:[]i32=zalloc_i(E51M_SCALAR_GRAM); let gr:[]i32=zalloc_i(E51M_SCALAR_GRAM);
    let cf:[]i32=zalloc_i(E51M_SCALAR_COLUMNS); let cr:[]i32=zalloc_i(E51M_SCALAR_COLUMNS);
    let backup:[]i32=zalloc_i(E45_FEATURES); let forward:[]i32=zalloc_i(E45_FEATURES);
    let count_f:i32=0; let count_r:i32=0; let hash_f:i32=401+dose; let hash_r:i32=401+dose;
    e51m_build_scalar_stats(records,sample_n,0,gf,cf,&count_f,&hash_f);
    e51m_build_scalar_stats(records,sample_n,1,gr,cr,&count_r,&hash_r);
    let gate:i32=1;
    if(count_f!=sample_n || count_r!=sample_n || hash_f!=hash_r){ gate=0; }
    let i:i32=0; while(i<E51M_SCALAR_GRAM){ if(gf[i]!=gr[i]){ gate=0; } i=i+1; }
    i=0; while(i<E51M_SCALAR_COLUMNS){ if(cf[i]!=cr[i]){ gate=0; } i=i+1; }
    let af:i32=0; let rf:i32=0; let tf:i32=0; let llf:i32=0; let lhf:i32=0;
    e51m_scalar_fit(records,sample_n,0,gf,cf,weights,weight_start,bias,backup,&af,&rf,&tf,&llf,&lhf);
    i=0; while(i<E45_FEATURES){ forward[i]=weights[weight_start+i]; i=i+1; }
    let forward_bias:i32=bias.*;
    let ar:i32=0; let rr:i32=0; let tr:i32=0; let llr:i32=0; let lhr:i32=0;
    e51m_scalar_fit(records,sample_n,1,gr,cr,weights,weight_start,bias,backup,&ar,&rr,&tr,&llr,&lhr);
    if(af<=0 || af!=ar || rf!=rr || rf==3 || tf!=tr || llf!=llr || lhf!=lhr || bias.*!=forward_bias){ gate=0; }
    i=0; while(i<E45_FEATURES){ if(weights[weight_start+i]!=forward[i]){ gate=0; } weights[weight_start+i]=forward[i]; i=i+1; }
    bias.*=forward_bias;
    _zag_print("e51m_scalar_fit,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(sample_n); _zag_print(","); e45_print_i32(af); _zag_print(","); e45_print_i32(rf); _zag_print(","); e45_print_i32(tf); _zag_print(","); e45_print_i32(gate); _zag_println("");
    zfree(gf); zfree(gr); zfree(cf); zfree(cr); zfree(backup); zfree(forward);
    return gate;
}

fn e51m_hinge_basis(value:i32,mean:i32,direction:i32)i32 {
    if(direction==0){ return r32e45_clamp(value-mean,0,2000); }
    return r32e45_clamp(mean-value,0,2000);
}

fn e51m_term_exists(features:[]i32,directions:[]i32,term_start:i32,count:i32,feature:i32,direction:i32)i32 {
    let i:i32=0;
    while(i<count){ if(features[term_start+i]==feature && directions[term_start+i]==direction){ return 1; } i=i+1; }
    return 0;
}

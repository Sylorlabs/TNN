    reverse:i32,
    gram:[]i32,
    cross:[]i32,
    record_count:*i32,
    stats_hash:*i32
)void {
    e45_zero(gram,E51M_SCALAR_GRAM);
    e45_zero(cross,E51M_SCALAR_COLUMNS);
    record_count.*=0;
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let row:i32=0;
        while(row<E51M_SCALAR_COLUMNS){
            let row_value:i64=1000;
            if(row>0){ row_value=records[record_start+row-1] as i64; }
            let target:i64=records[record_start+E51M_CAL_TARGET] as i64;
            cross[row]=cross[row]+(e50_signed_div_i64(row_value*target,1000) as i32);
            let column:i32=0;
            while(column<E51M_SCALAR_COLUMNS){
                let column_value:i64=1000;
                if(column>0){ column_value=records[record_start+column-1] as i64; }
                gram[row*E51M_SCALAR_COLUMNS+column]=gram[row*E51M_SCALAR_COLUMNS+column]+(e50_signed_div_i64(row_value*column_value,1000) as i32);
                column=column+1;
            }
            row=row+1;
        }
        record_count.*=record_count.*+1;
        traversal=traversal+1;
    }
    let i:i32=0;
    while(i<E51M_SCALAR_GRAM){ stats_hash.*=e46_hash_update(stats_hash.*,gram[i]); i=i+1; }
    i=0;
    while(i<E51M_SCALAR_COLUMNS){ stats_hash.*=e46_hash_update(stats_hash.*,cross[i]); i=i+1; }
}

fn e51m_scalar_statistics_equal(
    gram_a:[]i32,
    gram_b:[]i32,
    cross_a:[]i32,
    cross_b:[]i32
)i32 {
    let i:i32=0;
    while(i<E51M_SCALAR_GRAM){ if(gram_a[i]!=gram_b[i]){ return 0; } i=i+1; }
    i=0;
    while(i<E51M_SCALAR_COLUMNS){ if(cross_a[i]!=cross_b[i]){ return 0; } i=i+1; }
    return 1;
}

fn e51m_scalar_loss(
    records:[]i32,
    sample_count:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32
)i64 {
    let loss:i64=0;
    let record_number:i32=0;
    while(record_number<sample_count){
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let predicted:i32=e51m_scalar_predict_record(records,record_start,weights,weight_start,bias);
        let residual:i32=records[record_start+E51M_CAL_TARGET]-predicted;
        loss=loss+(residual as i64)*(residual as i64);
        record_number=record_number+1;
    }
    return loss;
}

fn e51m_scalar_fit(
    records:[]i32,
    sample_count:i32,
    gram:[]i32,
    cross:[]i32,
    weights:[]i32,
    weight_start:i32,
    bias:*i32,
    backup_weights:[]i32,
    accepted_steps:*i32,
    stop_reason:*i32,
    trace_hash:*i32,
    final_loss_low:*i32,
    final_loss_high:*i32
)void {
    let i:i32=0;
    while(i<E45_FEATURES){ weights[weight_start+i]=0; i=i+1; }
    bias.*=0;
    accepted_steps.*=0; stop_reason.*=3; trace_hash.*=613+sample_count;
    let current_loss:i64=e51m_scalar_loss(records,sample_count,weights,weight_start,bias.*);
    trace_hash.*=e50_hash_loss(trace_hash.*,current_loss);
    let sweep:i32=0; let stopped:i32=0;
    while(sweep<E51M_SCALAR_MAX_STEPS && stopped==0){
        i=0; while(i<E45_FEATURES){ backup_weights[i]=weights[weight_start+i]; i=i+1; }
        let backup_bias:i32=bias.*;
        let changed:i32=0;
        let column:i32=0;
        while(column<E51M_SCALAR_COLUMNS){
            let diagonal:i32=gram[column*E51M_SCALAR_COLUMNS+column];
            let current:i32=bias.*;
            if(column>0){ current=weights[weight_start+column-1]; }
            let candidate:i32=0;
            if(diagonal>0){
                let weighted_sum:i64=0;
                let other:i32=0;
                while(other<E51M_SCALAR_COLUMNS){
                    if(other!=column){
                        let parameter:i32=bias.*;
                        if(other>0){ parameter=weights[weight_start+other-1]; }
                        weighted_sum=weighted_sum+(gram[column*E51M_SCALAR_COLUMNS+other] as i64)*(parameter as i64);
                    }
                    other=other+1;
                }
                let numerator:i64=(cross[column] as i64)*1000-weighted_sum;
                candidate=e50_round_nearest_i64(numerator,diagonal as i64) as i32;
                if(column==0){ candidate=r32e45_clamp(candidate,-4000,4000);
                }else{ candidate=r32e45_clamp(candidate,-16000,16000); }
            }
            if(candidate!=current){ changed=1; }
            if(column==0){ bias.*=candidate;
            }else{ weights[weight_start+column-1]=candidate; }
            column=column+1;
        }
        if(changed==0){ stop_reason.*=1; stopped=1;
        }else{
            let candidate_loss:i64=e51m_scalar_loss(records,sample_count,weights,weight_start,bias.*);
            if(candidate_loss<current_loss){
                current_loss=candidate_loss;
                accepted_steps.*=accepted_steps.*+1;
                trace_hash.*=e50_hash_loss(trace_hash.*,current_loss);
            }else{
                i=0; while(i<E45_FEATURES){ weights[weight_start+i]=backup_weights[i]; i=i+1; }
                bias.*=backup_bias;
                stop_reason.*=2; stopped=1;
            }
        }
        sweep=sweep+1;
    }
    if(stopped==0){ stop_reason.*=3; }
    final_loss_low.*=e50_loss_low(current_loss);
    final_loss_high.*=e50_loss_high(current_loss);
}

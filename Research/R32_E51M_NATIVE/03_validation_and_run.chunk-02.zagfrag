    _zag_println("graph_or_topology_change,0");
    _zag_println("hand_selected_boundary_feature,0");

    let dev_seeds:[]i32=zalloc_i(E51M_MAX_DEV_EPISODES);
    let validation_seeds:[]i32=zalloc_i(E51M_VALIDATION_EPISODES);
    let confirmation_seeds:[]i32=zalloc_i(E51M_CONFIRM_EPISODES);
    let base_records:[]i32=zalloc_i(E51M_BASE_SAMPLES*E50_RECORD_N);
    let calibration_records:[]i32=zalloc_i(E51M_MAX_SAMPLES*E51M_CAL_RECORD_N);
    let terminal_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let terminal_biases:[]i32=zalloc_i(4);
    e45_zero(base_records,E51M_BASE_SAMPLES*E50_RECORD_N);
    e45_zero(calibration_records,E51M_MAX_SAMPLES*E51M_CAL_RECORD_N);
    e45_zero(terminal_weights,4*E45_FEATURES); e45_zero(terminal_biases,4);

    let seed_gate:i32=e51m_allocate_seeds(
        raw_seen,evidence_seen,resource_seen,dev_seeds,validation_seeds,confirmation_seeds
    );

    let unknown_target_nonzero:i32=0;
    let base_episode_count:i32=0;
    let epoch:i32=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e51m_dev_index(epoch,base_index,mode,resource,episode);
                        e51m_build_base_episode(
                            dev_seeds[index],mode,resource,index,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,base_records,&unknown_target_nonzero
                        );
                        base_episode_count=base_episode_count+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let base_sample_gate:i32=0;
    if(base_episode_count==E51M_BASE_DEV_EPISODES && unknown_target_nonzero==0){ base_sample_gate=1; }
    e45_print_pair("e51m_base_development_episodes",base_episode_count);
    e45_print_pair("e51m_base_development_states",base_episode_count*E51M_STATES_PER_EPISODE);
    e45_print_pair("e51m_base_unknown_target_nonzero",unknown_target_nonzero);
    e45_print_pair("e51m_base_sample_gate",base_sample_gate);
    let base_fit_gate:i32=e51m_fit_base_terminal(base_records,terminal_weights,terminal_biases);
    e45_print_pair("e51m_base_fit_gate",base_fit_gate);

    let positive:i32=0; let negative:i32=0; let neutral:i32=0;
    let calibration_episode_count:i32=0;
    epoch=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e51m_dev_index(epoch,base_index,mode,resource,episode);
                        e51m_build_calibration_episode(
                            dev_seeds[index],mode,resource,index,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,terminal_weights,terminal_biases,
                            calibration_records,&positive,&negative,&neutral
                        );
                        calibration_episode_count=calibration_episode_count+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let calibration_sample_gate:i32=0;
    if(calibration_episode_count==E51M_MAX_DEV_EPISODES && positive>0 && negative>0 && neutral==0){ calibration_sample_gate=1; }
    e45_print_pair("e51m_calibration_development_episodes",calibration_episode_count);
    e45_print_pair("e51m_calibration_development_states",calibration_episode_count*E51M_STATES_PER_EPISODE);
    e45_print_pair("e51m_calibration_positive_targets",positive);
    e45_print_pair("e51m_calibration_negative_targets",negative);
    e45_print_pair("e51m_calibration_neutral_targets",neutral);
    e45_print_pair("e51m_calibration_sample_gate",calibration_sample_gate);

    let gram_forward:[]i32=zalloc_i(E51M_SCALAR_GRAM);
    let gram_reverse:[]i32=zalloc_i(E51M_SCALAR_GRAM);
    let cross_forward:[]i32=zalloc_i(E51M_SCALAR_COLUMNS);
    let cross_reverse:[]i32=zalloc_i(E51M_SCALAR_COLUMNS);
    let backup_weights:[]i32=zalloc_i(E45_FEATURES);
    let linear_forward_weights:[]i32=zalloc_i(E51M_DOSES*E45_FEATURES);
    let linear_reverse_weights:[]i32=zalloc_i(E51M_DOSES*E45_FEATURES);
    let linear_forward_biases:[]i32=zalloc_i(E51M_DOSES);

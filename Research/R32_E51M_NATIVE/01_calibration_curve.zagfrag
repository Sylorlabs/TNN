// R32 E51M — calibration training-dose x learner boundary-capacity curve.
// Native Zag v2 only. The base commit-ordering head is fit once on the first
// 1x development prefix. Calibration uses only the same learner-visible state
// and the consequence-derived sign of the learner-selected top commit.
// UNKNOWN is fixed at zero and receives no learned positive target.

const E51M_DEV_EPISODES_MAX:i32=12960;
const E51M_DEV_SAMPLES_1X:i32=55080;
const E51M_DEV_SAMPLES_2X:i32=110160;
const E51M_DEV_SAMPLES_4X:i32=220320;
const E51M_DEV_SAMPLES_MAX:i32=220320;
const E51M_VALIDATION_EPISODES:i32=5400;
const E51M_VALIDATION_SAMPLES:i32=91800;
const E51M_CONFIRM_EPISODES:i32=10800;
const E51M_CONFIRM_SAMPLES:i32=183600;
const E51M_DOSES:i32=3;
const E51M_CAP_LEVELS:i32=4;
const E51M_MAX_HINGES:i32=16;
const E51M_MAX_SWEEPS:i32=32;
const E51M_HASH_MOD:i64=2147483629;

fn e51m_dose_samples(dose:i32)i32 {
    if(dose==0){ return E51M_DEV_SAMPLES_1X; }
    if(dose==1){ return E51M_DEV_SAMPLES_2X; }
    return E51M_DEV_SAMPLES_4X;
}

fn e51m_capacity(level:i32)i32 {
    if(level==0){ return 0; }
    if(level==1){ return 4; }
    if(level==2){ return 8; }
    return 16;
}

fn e51m_hash_i64(value:i64)i32 {
    let v:i64=value;
    if(v<0){ v=0-v; }
    let q:i64=v/E51M_HASH_MOD;
    return (v-q*E51M_HASH_MOD) as i32;
}

fn e51m_clamp_i64(value:i64,lo:i32,hi:i32)i32 {
    if(value<(lo as i64)){ return lo; }
    if(value>(hi as i64)){ return hi; }
    return value as i32;
}

fn e51m_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    dev_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32
)i32 {
    e45_zero(dev_seeds,E51M_DEV_EPISODES_MAX);
    e45_zero(validation_seeds,E51M_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E51M_CONFIRM_EPISODES);
    let failures:i32=0;
    let emitted:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,52,index,mode,resource,&failures);
                        dev_seeds[index]=seed;
                        emitted=emitted+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,53,index,mode,resource,&failures);
                    validation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<40){
                    let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,54,index,mode,resource,&failures);
                    confirmation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51m_seed_manifest_emitted",emitted);
    e45_print_pair("e51m_seed_assignment_failures",failures);
    e45_print_pair("e51m_max_development_allocated",E51M_DEV_EPISODES_MAX);
    e45_print_pair("e51m_validation_allocated",E51M_VALIDATION_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_allocated",E51M_CONFIRM_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_executed",0);
    if(failures==0 && emitted==E51M_DEV_EPISODES_MAX+E51M_VALIDATION_EPISODES+E51M_CONFIRM_EPISODES){ return 1; }
    return 0;
}

fn e51m_commit_score(
    records:[]i32,
    record_start:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    action:i32
)i32 {
    let value:i32=terminal_biases[action];
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let x:i32=e50_batch_column(records,record_start,feature+1,0);
        value=value+terminal_weights[action*E45_FEATURES+feature]*x/1000;
        feature=feature+1;
    }
    return r32e45_clamp(value,-4000,4000);
}

fn e51m_top_commit(
    records:[]i32,
    record_start:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32
)i32 {
    let choice:i32=R32E45_TERM_KEEP;
    let best:i32=e51m_commit_score(records,record_start,terminal_weights,terminal_biases,R32E45_TERM_KEEP);
    let current:i32=e51m_commit_score(records,record_start,terminal_weights,terminal_biases,R32E45_TERM_CURRENT);
    if(current>best){ choice=R32E45_TERM_CURRENT; best=current; }
    let restore:i32=e51m_commit_score(records,record_start,terminal_weights,terminal_biases,R32E45_TERM_RESTORE);
    if(restore>best){ choice=R32E45_TERM_RESTORE; }
    return choice;
}

fn e51m_top_commit_score(
    records:[]i32,
    record_start:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32
)i32 {
    let action:i32=e51m_top_commit(records,record_start,terminal_weights,terminal_biases);
    return e51m_commit_score(records,record_start,terminal_weights,terminal_biases,action);
}

fn e51m_sign_target(
    records:[]i32,
    record_start:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32
)i32 {
    let action:i32=e51m_top_commit(records,record_start,terminal_weights,terminal_biases);
    let grounded:i32=records[record_start+34+action];
    if(grounded>0){ return 1000; }
    if(grounded<0){ return -1000; }
    return 0;
}

fn e51m_linear_scalar_predict(
    records:[]i32,
    record_start:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32
)i32 {
    let value:i32=bias;
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let x:i32=e50_batch_column(records,record_start,feature+1,0);
        value=value+weights[weight_start+feature]*x/1000;
        feature=feature+1;
    }
    return r32e45_clamp(value,-4000,4000);
}

fn e51m_hinge_value(value:i32,mean:i32,direction:i32)i32 {
    let out:i32=0;
    if(direction==0){
        if(value>mean){ out=value-mean; }
    }else{
        if(value<mean){ out=mean-value; }
    }
    return r32e45_clamp(out,0,4000);
}

fn e51m_scalar_predict(
    records:[]i32,
    record_start:i32,
    linear_weights:[]i32,
    linear_start:i32,
    linear_bias:i32,
    term_feature:[]i32,
    term_direction:[]i32,
    term_mean:[]i32,
    term_coef:[]i32,
    term_start:i32,
    term_count:i32
)i32 {
    let value:i32=e51m_linear_scalar_predict(records,record_start,linear_weights,linear_start,linear_bias);
    let term:i32=0;
    while(term<term_count){
        let feature:i32=term_feature[term_start+term];
        let x0:i32=e50_batch_column(records,record_start,feature+1,0);
        let x:i32=e51m_hinge_value(x0,term_mean[term_start+term],term_direction[term_start+term]);
        value=value+term_coef[term_start+term]*x/1000;
        term=term+1;
    }
    return r32e45_clamp(value,-4000,4000);
}

fn e51m_residual_loss(residuals:[]i32,count:i32)i64 {
    let loss:i64=0;
    let i:i32=0;
    while(i<count){
        let r:i64=residuals[i] as i64;
        loss=loss+r*r;
        i=i+1;
    }
    return loss;
}

fn e51m_fit_scalar_linear(
    records:[]i32,
    targets:[]i32,
    count:i32,
    reverse:i32,
    weights:[]i32,
    weight_start:i32,
    bias:*i32,
    accepted_sweeps:*i32,
    stop_reason:*i32,
    trace_hash:*i32,
    final_loss:*i64
)void {
    let feature:i32=0;
    while(feature<E45_FEATURES){ weights[weight_start+feature]=0; feature=feature+1; }
    bias.*=0;
    accepted_sweeps.*=0;
    stop_reason.*=2;
    trace_hash.*=701+count;
    let residuals:[]i32=zalloc_i(count);
    let i:i32=0;
    while(i<count){ residuals[i]=targets[i]; i=i+1; }
    let current_loss:i64=e51m_residual_loss(residuals,count);
    let sweep:i32=0;
    while(sweep<E51M_MAX_SWEEPS){
        let accepted_this_sweep:i32=0;
        let coordinate:i32=0;
        while(coordinate<=E45_FEATURES){
            let numerator:i64=0;
            let denominator:i64=0;
            let traversal:i32=0;
            while(traversal<count){
                let index:i32=traversal;
                if(reverse==1){ index=count-1-traversal; }
                let record_start:i32=index*E50_RECORD_N;
                let x:i32=1000;
                if(coordinate>0){ x=e50_batch_column(records,record_start,coordinate,0); }
                numerator=numerator+(residuals[index] as i64)*(x as i64);
                denominator=denominator+(x as i64)*(x as i64);
                traversal=traversal+1;
            }
            if(denominator>0){
                let raw_delta:i64=numerator*1000/denominator;
                let old_value:i32=bias.*;
                let lo:i32=-4000;
                let hi:i32=4000;
                if(coordinate>0){ old_value=weights[weight_start+coordinate-1]; lo=-16000; hi=16000; }
                let proposed:i32=e51m_clamp_i64((old_value as i64)+raw_delta,lo,hi);
                let trial_delta:i32=proposed-old_value;
                let accepted_coordinate:i32=0;
                while(trial_delta!=0 && accepted_coordinate==0){
                    let candidate_loss:i64=0;
                    traversal=0;
                    while(traversal<count){
                        let index:i32=traversal;
                        if(reverse==1){ index=count-1-traversal; }
                        let record_start:i32=index*E50_RECORD_N;
                        let x:i32=1000;
                        if(coordinate>0){ x=e50_batch_column(records,record_start,coordinate,0); }
                        let next_r:i32=residuals[index]-trial_delta*x/1000;
                        candidate_loss=candidate_loss+(next_r as i64)*(next_r as i64);
                        traversal=traversal+1;
                    }
                    if(candidate_loss<current_loss){
                        traversal=0;
                        while(traversal<count){
                            let index:i32=traversal;
                            let record_start:i32=index*E50_RECORD_N;
                            let x:i32=1000;
                            if(coordinate>0){ x=e50_batch_column(records,record_start,coordinate,0); }
                            residuals[index]=residuals[index]-trial_delta*x/1000;
                            traversal=traversal+1;
                        }
                        if(coordinate==0){ bias.*=old_value+trial_delta;
                        }else{ weights[weight_start+coordinate-1]=old_value+trial_delta; }
                        current_loss=candidate_loss;
                        accepted_coordinate=1;
                        accepted_this_sweep=1;
                        trace_hash.*=e46_hash_update(trace_hash.*,coordinate);
                        trace_hash.*=e46_hash_update(trace_hash.*,trial_delta);
                        trace_hash.*=e46_hash_update(trace_hash.*,e51m_hash_i64(current_loss));
                    }else{
                        trial_delta=trial_delta/2;
                    }
                }
            }
            coordinate=coordinate+1;
        }
        if(accepted_this_sweep==0){
            stop_reason.*=1;
            break;
        }
        accepted_sweeps.*=accepted_sweeps.*+1;
        sweep=sweep+1;
    }
    final_loss.*=current_loss;
    zfree(residuals);
}

fn e51m_linear_identity(
    forward_weights:[]i32,
    forward_start:i32,
    forward_bias:i32,
    reverse_weights:[]i32,
    reverse_start:i32,
    reverse_bias:i32,
    forward_sweeps:i32,
    reverse_sweeps:i32,
    forward_reason:i32,
    reverse_reason:i32,
    forward_trace:i32,
    reverse_trace:i32,
    forward_loss:i64,
    reverse_loss:i64
)i32 {
    if(forward_bias!=reverse_bias || forward_sweeps!=reverse_sweeps || forward_reason!=reverse_reason || forward_trace!=reverse_trace || forward_loss!=reverse_loss){ return 0; }
    let feature:i32=0;
    while(feature<E45_FEATURES){
        if(forward_weights[forward_start+feature]!=reverse_weights[reverse_start+feature]){ return 0; }
        feature=feature+1;
    }
    return 1;
}

fn e51m_compute_means(
    records:[]i32,
    count:i32,
    reverse:i32,
    means:[]i32,
    mean_start:i32
)void {
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let total:i64=0;
        let traversal:i32=0;
        while(traversal<count){
            let index:i32=traversal;
            if(reverse==1){ index=count-1-traversal; }
            total=total+(e50_batch_column(records,index*E50_RECORD_N,feature+1,0) as i64);
            traversal=traversal+1;
        }
        means[mean_start+feature]=(total/(count as i64)) as i32;
        feature=feature+1;
    }
}

fn e51m_hinge_already_selected(
    term_feature:[]i32,
    term_direction:[]i32,
    term_start:i32,
    term_count:i32,
    feature:i32,
    direction:i32
)i32 {
    let term:i32=0;
    while(term<term_count){
        if(term_feature[term_start+term]==feature && term_direction[term_start+term]==direction){ return 1; }
        term=term+1;
    }
    return 0;
}

fn e51m_fit_hinges(
    records:[]i32,
    targets:[]i32,
    count:i32,
    reverse:i32,
    linear_weights:[]i32,
    linear_start:i32,
    linear_bias:i32,
    means:[]i32,
    mean_start:i32,
    term_feature:[]i32,
    term_direction:[]i32,
    term_mean:[]i32,
    term_coef:[]i32,
    term_start:i32,
    accepted_count:*i32,
    stop_reason:*i32,
    trace_hash:*i32,
    final_loss:*i64
)void {
    accepted_count.*=0;
    stop_reason.*=2;
    trace_hash.*=1103+count;
    let term:i32=0;
    while(term<E51M_MAX_HINGES){
        term_feature[term_start+term]=-1;
        term_direction[term_start+term]=0;
        term_mean[term_start+term]=0;
        term_coef[term_start+term]=0;
        term=term+1;
    }
    e51m_compute_means(records,count,reverse,means,mean_start);
    let residuals:[]i32=zalloc_i(count);
    let i:i32=0;
    while(i<count){
        let predicted:i32=e51m_linear_scalar_predict(records,i*E50_RECORD_N,linear_weights,linear_start,linear_bias);
        residuals[i]=targets[i]-predicted;
        i=i+1;
    }
    let current_loss:i64=e51m_residual_loss(residuals,count);
    let stage:i32=0;
    while(stage<E51M_MAX_HINGES){
        let best_feature:i32=-1;
        let best_direction:i32=0;
        let best_coef:i32=0;
        let best_loss:i64=current_loss;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            let direction:i32=0;
            while(direction<2){
                if(e51m_hinge_already_selected(term_feature,term_direction,term_start,accepted_count.*,feature,direction)==0){
                    let numerator:i64=0;
                    let denominator:i64=0;
                    let traversal:i32=0;
                    while(traversal<count){
                        let index:i32=traversal;
                        if(reverse==1){ index=count-1-traversal; }
                        let raw:i32=e50_batch_column(records,index*E50_RECORD_N,feature+1,0);
                        let x:i32=e51m_hinge_value(raw,means[mean_start+feature],direction);
                        numerator=numerator+(residuals[index] as i64)*(x as i64);
                        denominator=denominator+(x as i64)*(x as i64);
                        traversal=traversal+1;
                    }
                    if(denominator>0){
                        let coefficient:i32=e51m_clamp_i64(numerator*1000/denominator,-16000,16000);
                        if(coefficient!=0){
                            let candidate_loss:i64=0;
                            traversal=0;
                            while(traversal<count){
                                let index:i32=traversal;
                                if(reverse==1){ index=count-1-traversal; }
                                let raw:i32=e50_batch_column(records,index*E50_RECORD_N,feature+1,0);
                                let x:i32=e51m_hinge_value(raw,means[mean_start+feature],direction);
                                let r:i32=residuals[index]-coefficient*x/1000;
                                candidate_loss=candidate_loss+(r as i64)*(r as i64);
                                traversal=traversal+1;
                            }
                            if(candidate_loss<best_loss){
                                best_loss=candidate_loss;
                                best_feature=feature;
                                best_direction=direction;
                                best_coef=coefficient;
                            }
                        }
                    }
                }
                direction=direction+1;
            }
            feature=feature+1;
        }
        if(best_feature<0){
            stop_reason.*=1;
            break;
        }
        term_feature[term_start+accepted_count.*]=best_feature;
        term_direction[term_start+accepted_count.*]=best_direction;
        term_mean[term_start+accepted_count.*]=means[mean_start+best_feature];
        term_coef[term_start+accepted_count.*]=best_coef;
        let index:i32=0;
        while(index<count){
            let raw:i32=e50_batch_column(records,index*E50_RECORD_N,best_feature+1,0);
            let x:i32=e51m_hinge_value(raw,means[mean_start+best_feature],best_direction);
            residuals[index]=residuals[index]-best_coef*x/1000;
            index=index+1;
        }
        current_loss=best_loss;
        trace_hash.*=e46_hash_update(trace_hash.*,best_feature);
        trace_hash.*=e46_hash_update(trace_hash.*,best_direction);
        trace_hash.*=e46_hash_update(trace_hash.*,means[mean_start+best_feature]);
        trace_hash.*=e46_hash_update(trace_hash.*,best_coef);
        trace_hash.*=e46_hash_update(trace_hash.*,e51m_hash_i64(current_loss));
        accepted_count.*=accepted_count.*+1;
        stage=stage+1;
    }
    final_loss.*=current_loss;
    zfree(residuals);
}

fn e51m_hinge_identity(
    means_a:[]i32,
    means_a_start:i32,
    means_b:[]i32,
    means_b_start:i32,
    feature_a:[]i32,
    direction_a:[]i32,
    mean_a:[]i32,
    coef_a:[]i32,
    term_a_start:i32,
    feature_b:[]i32,
    direction_b:[]i32,
    mean_b:[]i32,
    coef_b:[]i32,
    term_b_start:i32,
    count_a:i32,
    count_b:i32,
    reason_a:i32,
    reason_b:i32,
    trace_a:i32,
    trace_b:i32,
    loss_a:i64,
    loss_b:i64
)i32 {
    if(count_a!=count_b || reason_a!=reason_b || trace_a!=trace_b || loss_a!=loss_b){ return 0; }
    let feature:i32=0;
    while(feature<E45_FEATURES){
        if(means_a[means_a_start+feature]!=means_b[means_b_start+feature]){ return 0; }
        feature=feature+1;
    }
    let term:i32=0;
    while(term<count_a){
        if(feature_a[term_a_start+term]!=feature_b[term_b_start+term] || direction_a[term_a_start+term]!=direction_b[term_b_start+term] || mean_a[term_a_start+term]!=mean_b[term_b_start+term] || coef_a[term_a_start+term]!=coef_b[term_b_start+term]){ return 0; }
        term=term+1;
    }
    return 1;
}

fn e51m_count_sign_accuracy(
    records:[]i32,
    targets:[]i32,
    count:i32,
    linear_weights:[]i32,
    linear_start:i32,
    linear_bias:i32,
    term_feature:[]i32,
    term_direction:[]i32,
    term_mean:[]i32,
    term_coef:[]i32,
    term_start:i32,
    term_count:i32,
    positive_total:*i32,
    positive_correct:*i32,
    negative_total:*i32,
    negative_correct:*i32
)void {
    positive_total.*=0; positive_correct.*=0; negative_total.*=0; negative_correct.*=0;
    let index:i32=0;
    while(index<count){
        let target:i32=targets[index];
        let predicted:i32=e51m_scalar_predict(records,index*E50_RECORD_N,linear_weights,linear_start,linear_bias,term_feature,term_direction,term_mean,term_coef,term_start,term_count);
        if(target>0){
            positive_total.*=positive_total.*+1;
            if(predicted>=0){ positive_correct.*=positive_correct.*+1; }
        }
        if(target<0){
            negative_total.*=negative_total.*+1;
            if(predicted<0){ negative_correct.*=negative_correct.*+1; }
        }
        index=index+1;
    }
}

fn e51m_build_targets(
    records:[]i32,
    count:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    targets:[]i32,
    positive:*i32,
    negative:*i32,
    neutral:*i32
)void {
    positive.*=0; negative.*=0; neutral.*=0;
    let index:i32=0;
    while(index<count){
        let target:i32=e51m_sign_target(records,index*E50_RECORD_N,terminal_weights,terminal_biases);
        targets[index]=target;
        if(target>0){ positive.*=positive.*+1;
        }else{
            if(target<0){ negative.*=negative.*+1;
            }else{ neutral.*=neutral.*+1; }
        }
        index=index+1;
    }
}

fn e51m_reachability(
    records:[]i32,
    episode_types:[]i32,
    episodes:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    use_calibration:i32,
    linear_weights:[]i32,
    linear_start:i32,
    linear_bias:i32,
    term_feature:[]i32,
    term_direction:[]i32,
    term_mean:[]i32,
    term_coef:[]i32,
    term_start:i32,
    term_count:i32,
    known_total:*i32,
    known_reachable:*i32,
    no_unique_total:*i32,
    no_unique_reachable:*i32
)void {
    known_total.*=0; known_reachable.*=0; no_unique_total.*=0; no_unique_reachable.*=0;
    let episode:i32=0;
    while(episode<episodes){
        let no_unique:i32=episode_types[episode];
        let reached:i32=0;
        let t:i32=0;
        while(t<=E45_TAPE && reached==0){
            let record_index:i32=episode*(E45_TAPE+1)+t;
            let record_start:i32=record_index*E50_RECORD_N;
            let action:i32=e51m_top_commit(records,record_start,terminal_weights,terminal_biases);
            let decision_score:i32=e51m_top_commit_score(records,record_start,terminal_weights,terminal_biases);
            if(use_calibration==1){
                decision_score=e51m_scalar_predict(records,record_start,linear_weights,linear_start,linear_bias,term_feature,term_direction,term_mean,term_coef,term_start,term_count);
            }
            if(no_unique==1){
                if(decision_score<0){ reached=1; }
            }else{
                if(decision_score>=0 && records[record_start+34+action]==1000){ reached=1; }
            }
            t=t+1;
        }
        if(no_unique==1){
            no_unique_total.*=no_unique_total.*+1;
            if(reached==1){ no_unique_reachable.*=no_unique_reachable.*+1; }
        }else{
            known_total.*=known_total.*+1;
            if(reached==1){ known_reachable.*=known_reachable.*+1; }
        }
        episode=episode+1;
    }
}

fn e51m_build_validation_targets(
    records:[]i32,
    count:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    targets:[]i32
)void {
    let index:i32=0;
    while(index<count){
        targets[index]=e51m_sign_target(records,index*E50_RECORD_N,terminal_weights,terminal_biases);
        index=index+1;
    }
}

fn e51m_pareto_signal(a_known:i32,a_unknown:i32,b_known:i32,b_unknown:i32)i32 {
    if(b_known>=a_known && b_unknown>=a_unknown){
        if(b_known>a_known || b_unknown>a_unknown){ return 1; }
    }
    return 0;
}

fn e51m_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51M_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51m_calibration_dose_capacity_curve_v1");
    _zag_println("claim_boundary,native_training_capacity_curve_not_promotion");
    _zag_println("native_zag_v2_only=1");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("ambiguity_label_exposed=0");
    _zag_println("validation_membership_exposed=0");
    _zag_println("unknown_positive_target=0");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");

    let dev_seeds:[]i32=zalloc_i(E51M_DEV_EPISODES_MAX);
    let validation_seeds:[]i32=zalloc_i(E51M_VALIDATION_EPISODES);
    let confirmation_seeds:[]i32=zalloc_i(E51M_CONFIRM_EPISODES);
    let seed_gate:i32=e51m_allocate_seeds(raw_seen,evidence_seen,resource_seen,dev_seeds,validation_seeds,confirmation_seeds);

    let dev_records:[]i32=zalloc_i(E51M_DEV_SAMPLES_MAX*E50_RECORD_N);
    let dummy_continue:[]i32=zalloc_i(E51M_DEV_SAMPLES_MAX*E50_RECORD_N);
    e45_zero(dev_records,E51M_DEV_SAMPLES_MAX*E50_RECORD_N);
    e45_zero(dummy_continue,E51M_DEV_SAMPLES_MAX*E50_RECORD_N);
    let dev_unknown_target_nonzero:i32=0;
    let dummy_positive:i32=0;
    let dummy_negative:i32=0;
    let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(
                            dev_seeds[index],mode,resource,canonical_episode,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,dev_records,dummy_continue,
                            &dev_unknown_target_nonzero,&dummy_positive,&dummy_negative
                        );
                        canonical_episode=canonical_episode+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    zfree(dummy_continue);
    e45_print_pair("e51m_development_episodes_built",canonical_episode);
    e45_print_pair("e51m_development_states_built",canonical_episode*(E45_TAPE+1));
    e45_print_pair("e51m_base_unknown_target_nonzero",dev_unknown_target_nonzero);

    let base_terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let base_terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let backup_biases:[]i32=zalloc_i(4);
    let gram_forward:[]i32=zalloc_i(E50_BATCH_GRAM);
    let gram_reverse:[]i32=zalloc_i(E50_BATCH_GRAM);
    let cross_forward:[]i32=zalloc_i(E50_BATCH_CROSS);
    let cross_reverse:[]i32=zalloc_i(E50_BATCH_CROSS);
    let forward_copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let forward_copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(base_terminal_weights,E51E_MODELS*4*E45_FEATURES);
    e45_zero(base_terminal_biases,E51E_MODELS*4);
    e45_zero(forward_copy_weights,E51E_MODELS*4*E45_FEATURES);
    e45_zero(forward_copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(
        dev_records,0,0,base_terminal_weights,base_terminal_biases,
        backup_weights,backup_biases,gram_forward,gram_reverse,cross_forward,cross_reverse,
        forward_copy_weights,forward_copy_biases
    );
    let unknown_parameter_nonzero:i32=0;
    if(base_terminal_biases[3]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; }
    let uf:i32=0;
    while(uf<E45_FEATURES){
        if(base_terminal_weights[3*E45_FEATURES+uf]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; }
        uf=uf+1;
    }
    e45_print_pair("e51m_base_terminal_fit_identity_gate",base_fit_gate);
    e45_print_pair("e51m_base_unknown_parameter_nonzero",unknown_parameter_nonzero);

    let sign_targets:[]i32=zalloc_i(E51M_DEV_SAMPLES_MAX);
    let max_positive:i32=0; let max_negative:i32=0; let max_neutral:i32=0;
    e51m_build_targets(dev_records,E51M_DEV_SAMPLES_MAX,base_terminal_weights,base_terminal_biases,sign_targets,&max_positive,&max_negative,&max_neutral);
    let dose_target_gate:i32=1;
    let dose:i32=0;
    while(dose<E51M_DOSES){
        let n:i32=e51m_dose_samples(dose);
        let pos:i32=0; let neg:i32=0; let neutral:i32=0;
        let index:i32=0;
        while(index<n){
            if(sign_targets[index]>0){ pos=pos+1;
            }else{
                if(sign_targets[index]<0){ neg=neg+1; }else{ neutral=neutral+1; }
            }
            index=index+1;
        }
        if(pos<=0 || neg<=0){ dose_target_gate=0; }
        _zag_print("e51m_dose_targets,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(n); _zag_print(","); e45_print_i32(pos); _zag_print(","); e45_print_i32(neg); _zag_print(","); e45_print_i32(neutral); _zag_println("");
        dose=dose+1;
    }

    let linear_weights:[]i32=zalloc_i(E51M_DOSES*E45_FEATURES);
    let linear_biases:[]i32=zalloc_i(E51M_DOSES);
    let means:[]i32=zalloc_i(E51M_DOSES*E45_FEATURES);
    let term_feature:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let term_direction:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let term_mean:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let term_coef:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let accepted_terms:[]i32=zalloc_i(E51M_DOSES);
    let linear_identity_gate:i32=1;
    let hinge_identity_gate:i32=1;

    dose=0;
    while(dose<E51M_DOSES){
        let n:i32=e51m_dose_samples(dose);
        let sweeps_f:i32=0; let reason_f:i32=0; let trace_f:i32=0; let loss_f:i64=0;
        e51m_fit_scalar_linear(dev_records,sign_targets,n,0,linear_weights,dose*E45_FEATURES,&linear_biases[dose],&sweeps_f,&reason_f,&trace_f,&loss_f);
        let reverse_weights:[]i32=zalloc_i(E45_FEATURES);
        let reverse_bias:i32=0; let sweeps_r:i32=0; let reason_r:i32=0; let trace_r:i32=0; let loss_r:i64=0;
        e51m_fit_scalar_linear(dev_records,sign_targets,n,1,reverse_weights,0,&reverse_bias,&sweeps_r,&reason_r,&trace_r,&loss_r);
        let lg:i32=e51m_linear_identity(linear_weights,dose*E45_FEATURES,linear_biases[dose],reverse_weights,0,reverse_bias,sweeps_f,sweeps_r,reason_f,reason_r,trace_f,trace_r,loss_f,loss_r);
        if(lg==0){ linear_identity_gate=0; }

        let reverse_means:[]i32=zalloc_i(E45_FEATURES);
        let reverse_feature:[]i32=zalloc_i(E51M_MAX_HINGES);
        let reverse_direction:[]i32=zalloc_i(E51M_MAX_HINGES);
        let reverse_mean:[]i32=zalloc_i(E51M_MAX_HINGES);
        let reverse_coef:[]i32=zalloc_i(E51M_MAX_HINGES);
        let accepted_f:i32=0; let hreason_f:i32=0; let htrace_f:i32=0; let hloss_f:i64=0;
        let accepted_r:i32=0; let hreason_r:i32=0; let htrace_r:i32=0; let hloss_r:i64=0;
        e51m_fit_hinges(dev_records,sign_targets,n,0,linear_weights,dose*E45_FEATURES,linear_biases[dose],means,dose*E45_FEATURES,term_feature,term_direction,term_mean,term_coef,dose*E51M_MAX_HINGES,&accepted_f,&hreason_f,&htrace_f,&hloss_f);
        e51m_fit_hinges(dev_records,sign_targets,n,1,linear_weights,dose*E45_FEATURES,linear_biases[dose],reverse_means,0,reverse_feature,reverse_direction,reverse_mean,reverse_coef,0,&accepted_r,&hreason_r,&htrace_r,&hloss_r);
        let hg:i32=e51m_hinge_identity(means,dose*E45_FEATURES,reverse_means,0,term_feature,term_direction,term_mean,term_coef,dose*E51M_MAX_HINGES,reverse_feature,reverse_direction,reverse_mean,reverse_coef,0,accepted_f,accepted_r,hreason_f,hreason_r,htrace_f,htrace_r,hloss_f,hloss_r);
        if(hg==0){ hinge_identity_gate=0; }
        accepted_terms[dose]=accepted_f;
        _zag_print("e51m_fit,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(n); _zag_print(","); e45_print_i32(sweeps_f); _zag_print(","); e45_print_i32(reason_f); _zag_print(","); e45_print_i32(trace_f); _zag_print(","); e45_print_i32(e51m_hash_i64(loss_f)); _zag_print(","); e45_print_i32(lg); _zag_print(","); e45_print_i32(accepted_f); _zag_print(","); e45_print_i32(hreason_f); _zag_print(","); e45_print_i32(htrace_f); _zag_print(","); e45_print_i32(e51m_hash_i64(hloss_f)); _zag_print(","); e45_print_i32(hg); _zag_println("");
        let term:i32=0;
        while(term<accepted_f){
            let ts:i32=dose*E51M_MAX_HINGES+term;
            _zag_print("e51m_hinge,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(term); _zag_print(","); e45_print_i32(term_feature[ts]); _zag_print(","); e45_print_i32(term_direction[ts]); _zag_print(","); e45_print_i32(term_mean[ts]); _zag_print(","); e45_print_i32(term_coef[ts]); _zag_println("");
            term=term+1;
        }
        zfree(reverse_weights); zfree(reverse_means); zfree(reverse_feature); zfree(reverse_direction); zfree(reverse_mean); zfree(reverse_coef);
        dose=dose+1;
    }
    e45_print_pair("e51m_linear_forward_reverse_identity_gate",linear_identity_gate);
    e45_print_pair("e51m_hinge_forward_reverse_identity_gate",hinge_identity_gate);

    let validation_records:[]i32=zalloc_i(E51M_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_dummy:[]i32=zalloc_i(E51M_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_types:[]i32=zalloc_i(E51M_VALIDATION_EPISODES);
    let validation_targets:[]i32=zalloc_i(E51M_VALIDATION_SAMPLES);
    e45_zero(validation_records,E51M_VALIDATION_SAMPLES*E50_RECORD_N);
    e45_zero(validation_dummy,E51M_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_unknown_nonzero:i32=0;
    dummy_positive=0; dummy_negative=0; canonical_episode=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    validation_types[canonical_episode]=0;
                    if(mode==0 || mode==1){ validation_types[canonical_episode]=1; }
                    e51e_build_training_episode(
                        validation_seeds[index],mode,resource,canonical_episode,
                        source_trust,dependence_penalty,consequence,hazard,
                        shadow_weights,shadow_bias,validation_records,validation_dummy,
                        &validation_unknown_nonzero,&dummy_positive,&dummy_negative
                    );
                    canonical_episode=canonical_episode+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    zfree(validation_dummy);
    e51m_build_validation_targets(validation_records,E51M_VALIDATION_SAMPLES,base_terminal_weights,base_terminal_biases,validation_targets);
    e45_print_pair("e51m_validation_episodes_built",canonical_episode);
    e45_print_pair("e51m_validation_states_built",canonical_episode*(E45_TAPE+1));
    e45_print_pair("e51m_validation_unknown_target_nonzero",validation_unknown_nonzero);

    let base_known_total:i32=0; let base_known_reachable:i32=0; let base_nu_total:i32=0; let base_nu_reachable:i32=0;
    e51m_reachability(validation_records,validation_types,E51M_VALIDATION_EPISODES,base_terminal_weights,base_terminal_biases,0,linear_weights,0,0,term_feature,term_direction,term_mean,term_coef,0,0,&base_known_total,&base_known_reachable,&base_nu_total,&base_nu_reachable);
    _zag_print("e51m_base_reachability,"); e45_print_i32(base_known_total); _zag_print(","); e45_print_i32(base_known_reachable); _zag_print(","); e45_print_i32(base_nu_total); _zag_print(","); e45_print_i32(base_nu_reachable); _zag_println("");

    let result_known:[]i32=zalloc_i(E51M_DOSES*E51M_CAP_LEVELS);
    let result_unknown:[]i32=zalloc_i(E51M_DOSES*E51M_CAP_LEVELS);
    let exact_gate:i32=0;
    let winning_arm:i32=-1;
    dose=0;
    while(dose<E51M_DOSES){
        let level:i32=0;
        while(level<E51M_CAP_LEVELS){
            let requested:i32=e51m_capacity(level);
            let actual:i32=requested;
            if(actual>accepted_terms[dose]){ actual=accepted_terms[dose]; }
            let dev_pos_total:i32=0; let dev_pos_correct:i32=0; let dev_neg_total:i32=0; let dev_neg_correct:i32=0;
            e51m_count_sign_accuracy(dev_records,sign_targets,e51m_dose_samples(dose),linear_weights,dose*E45_FEATURES,linear_biases[dose],term_feature,term_direction,term_mean,term_coef,dose*E51M_MAX_HINGES,actual,&dev_pos_total,&dev_pos_correct,&dev_neg_total,&dev_neg_correct);
            let val_pos_total:i32=0; let val_pos_correct:i32=0; let val_neg_total:i32=0; let val_neg_correct:i32=0;
            e51m_count_sign_accuracy(validation_records,validation_targets,E51M_VALIDATION_SAMPLES,linear_weights,dose*E45_FEATURES,linear_biases[dose],term_feature,term_direction,term_mean,term_coef,dose*E51M_MAX_HINGES,actual,&val_pos_total,&val_pos_correct,&val_neg_total,&val_neg_correct);
            let known_total:i32=0; let known_reachable:i32=0; let nu_total:i32=0; let nu_reachable:i32=0;
            e51m_reachability(validation_records,validation_types,E51M_VALIDATION_EPISODES,base_terminal_weights,base_terminal_biases,1,linear_weights,dose*E45_FEATURES,linear_biases[dose],term_feature,term_direction,term_mean,term_coef,dose*E51M_MAX_HINGES,actual,&known_total,&known_reachable,&nu_total,&nu_reachable);
            let arm:i32=dose*E51M_CAP_LEVELS+level;
            result_known[arm]=known_reachable;
            result_unknown[arm]=nu_reachable;
            if(known_reachable==known_total && nu_reachable==nu_total && exact_gate==0){ exact_gate=1; winning_arm=arm; }
            _zag_print("e51m_grid,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(level); _zag_print(","); e45_print_i32(requested); _zag_print(","); e45_print_i32(actual); _zag_print(","); e45_print_i32(dev_pos_correct); _zag_print(","); e45_print_i32(dev_pos_total); _zag_print(","); e45_print_i32(dev_neg_correct); _zag_print(","); e45_print_i32(dev_neg_total); _zag_print(","); e45_print_i32(val_pos_correct); _zag_print(","); e45_print_i32(val_pos_total); _zag_print(","); e45_print_i32(val_neg_correct); _zag_print(","); e45_print_i32(val_neg_total); _zag_print(","); e45_print_i32(known_reachable); _zag_print(","); e45_print_i32(known_total); _zag_print(","); e45_print_i32(nu_reachable); _zag_print(","); e45_print_i32(nu_total); _zag_println("");
            level=level+1;
        }
        dose=dose+1;
    }

    let dose_signal:i32=0;
    let level:i32=0;
    while(level<E51M_CAP_LEVELS){
        let d0:i32=0;
        while(d0<E51M_DOSES-1){
            let a:i32=d0*E51M_CAP_LEVELS+level;
            let b:i32=(d0+1)*E51M_CAP_LEVELS+level;
            if(e51m_pareto_signal(result_known[a],result_unknown[a],result_known[b],result_unknown[b])==1){ dose_signal=1; }
            d0=d0+1;
        }
        level=level+1;
    }
    let capacity_signal:i32=0;
    dose=0;
    while(dose<E51M_DOSES){
        let l0:i32=0;
        while(l0<E51M_CAP_LEVELS-1){
            let a:i32=dose*E51M_CAP_LEVELS+l0;
            let b:i32=dose*E51M_CAP_LEVELS+l0+1;
            if(e51m_pareto_signal(result_known[a],result_unknown[a],result_known[b],result_unknown[b])==1){ capacity_signal=1; }
            l0=l0+1;
        }
        dose=dose+1;
    }

    let counts_gate:i32=0;
    if(canonical_episode==E51M_VALIDATION_EPISODES && E51M_DEV_EPISODES_MAX*(E45_TAPE+1)==E51M_DEV_SAMPLES_MAX && E51M_VALIDATION_EPISODES*(E45_TAPE+1)==E51M_VALIDATION_SAMPLES){ counts_gate=1; }
    let target_gate:i32=0;
    if(dev_unknown_target_nonzero==0 && validation_unknown_nonzero==0 && unknown_parameter_nonzero==0 && dose_target_gate==1){ target_gate=1; }
    let integrity_gate:i32=0;
    if(seed_gate==1 && counts_gate==1 && target_gate==1 && base_fit_gate==1 && linear_identity_gate==1 && hinge_identity_gate==1){ integrity_gate=1; }
    e45_print_pair("e51m_counts_gate",counts_gate);
    e45_print_pair("e51m_target_geometry_gate",target_gate);
    e45_print_pair("e51m_integrity_gate",integrity_gate);
    e45_print_pair("e51m_exact_validation_gate",exact_gate);
    e45_print_pair("e51m_dose_signal",dose_signal);
    e45_print_pair("e51m_capacity_signal",capacity_signal);
    e45_print_pair("e51m_winning_arm",winning_arm);

    let confirmation_executed:i32=0;
    let confirmation_exact:i32=0;
    if(integrity_gate==1 && exact_gate==1 && winning_arm>=0){
        let winning_dose:i32=winning_arm/E51M_CAP_LEVELS;
        let winning_level:i32=winning_arm-winning_dose*E51M_CAP_LEVELS;
        let winning_count:i32=e51m_capacity(winning_level);
        if(winning_count>accepted_terms[winning_dose]){ winning_count=accepted_terms[winning_dose]; }
        let confirm_records:[]i32=zalloc_i(E51M_CONFIRM_SAMPLES*E50_RECORD_N);
        let confirm_dummy:[]i32=zalloc_i(E51M_CONFIRM_SAMPLES*E50_RECORD_N);
        let confirm_types:[]i32=zalloc_i(E51M_CONFIRM_EPISODES);
        e45_zero(confirm_records,E51M_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(confirm_dummy,E51M_CONFIRM_SAMPLES*E50_RECORD_N);
        let confirm_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0;
        base_index=0;
        while(base_index<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<40){
                        let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                        confirm_types[canonical_episode]=0;
                        if(mode==0 || mode==1){ confirm_types[canonical_episode]=1; }
                        e51e_build_training_episode(confirmation_seeds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,confirm_records,confirm_dummy,&confirm_unknown_nonzero,&dummy_positive,&dummy_negative);
                        canonical_episode=canonical_episode+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        let ck:i32=0; let ckr:i32=0; let cn:i32=0; let cnr:i32=0;
        e51m_reachability(confirm_records,confirm_types,E51M_CONFIRM_EPISODES,base_terminal_weights,base_terminal_biases,1,linear_weights,winning_dose*E45_FEATURES,linear_biases[winning_dose],term_feature,term_direction,term_mean,term_coef,winning_dose*E51M_MAX_HINGES,winning_count,&ck,&ckr,&cn,&cnr);
        confirmation_executed=canonical_episode;
        if(ckr==ck && cnr==cn && confirm_unknown_nonzero==0){ confirmation_exact=1; }
        _zag_print("e51m_confirmation,"); e45_print_i32(winning_dose); _zag_print(","); e45_print_i32(winning_level); _zag_print(","); e45_print_i32(winning_count); _zag_print(","); e45_print_i32(ckr); _zag_print(","); e45_print_i32(ck); _zag_print(","); e45_print_i32(cnr); _zag_print(","); e45_print_i32(cn); _zag_print(","); e45_print_i32(confirm_unknown_nonzero); _zag_println("");
        zfree(confirm_records); zfree(confirm_dummy); zfree(confirm_types);
    }
    e45_print_pair("e51m_sealed_confirmation_executed_final",confirmation_executed);
    e45_print_pair("e51m_confirmation_exact_gate",confirmation_exact);

    if(integrity_gate==0){
        _zag_println("e51m_outcome,INVALID_EXPERIMENT_INTEGRITY_FAILURE");
    }else{
        if(exact_gate==1){ _zag_println("e51m_outcome,CALIBRATION_DOSE_CAPACITY_RESCUE");
        }else{
            if(dose_signal==1){ _zag_println("e51m_outcome,CALIBRATION_DOSE_SIGNAL");
            }else{
                if(capacity_signal==1){ _zag_println("e51m_outcome,CALIBRATION_CAPACITY_SIGNAL");
                }else{ _zag_println("e51m_outcome,CALIBRATION_DOSE_CAPACITY_PLATEAU"); }
            }
        }
    }
    _zag_println("TNN_R32_E51M_EXECUTION_COMPLETE=1");

    zfree(dev_seeds); zfree(validation_seeds); zfree(confirmation_seeds);
    zfree(dev_records); zfree(sign_targets);
    zfree(base_terminal_weights); zfree(base_terminal_biases); zfree(backup_weights); zfree(backup_biases);
    zfree(gram_forward); zfree(gram_reverse); zfree(cross_forward); zfree(cross_reverse); zfree(forward_copy_weights); zfree(forward_copy_biases);
    zfree(linear_weights); zfree(linear_biases); zfree(means); zfree(term_feature); zfree(term_direction); zfree(term_mean); zfree(term_coef); zfree(accepted_terms);
    zfree(validation_records); zfree(validation_types); zfree(validation_targets); zfree(result_known); zfree(result_unknown);
    return 1;
}

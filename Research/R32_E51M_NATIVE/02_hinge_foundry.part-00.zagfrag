fn e51m_compute_feature_means(
    records:[]i32,
    sample_count:i32,
    reverse:i32,
    means:[]i32,
    means_start:i32,
    trace_hash:*i32
)void {
    let sums:[]i32=zalloc_i(E45_FEATURES);
    e45_zero(sums,E45_FEATURES);
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            sums[feature]=sums[feature]+records[record_start+feature];
            feature=feature+1;
        }
        traversal=traversal+1;
    }
    let feature:i32=0;
    while(feature<E45_FEATURES){
        means[means_start+feature]=sums[feature]/sample_count;
        trace_hash.*=e46_hash_update(trace_hash.*,means[means_start+feature]);
        feature=feature+1;
    }
    zfree(sums);
}

fn e51m_hinge_value(value:i32,mean:i32,direction:i32)i32 {
    if(direction==0){
        if(value>mean){ return value-mean; }
        return 0;
    }
    if(value<mean){ return mean-value; }
    return 0;
}

fn e51m_scalar_hinge_predict_record(
    records:[]i32,
    record_start:i32,
    linear_weights:[]i32,
    linear_weight_start:i32,
    linear_bias:i32,
    means:[]i32,
    means_start:i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_start:i32,
    term_count:i32
)i32 {
    let value:i64=linear_bias as i64;
    let feature:i32=0;
    while(feature<E45_FEATURES){
        value=value+((linear_weights[linear_weight_start+feature] as i64)*(records[record_start+feature] as i64))/1000;
        feature=feature+1;
    }
    let term:i32=0;
    while(term<term_count){
        let tf:i32=term_features[term_start+term];
        let td:i32=term_directions[term_start+term];
        let h:i32=e51m_hinge_value(records[record_start+tf],means[means_start+tf],td);
        value=value+((term_coefficients[term_start+term] as i64)*(h as i64))/1000;
        term=term+1;
    }
    if(value<-4000){ return -4000; }
    if(value>4000){ return 4000; }
    return value as i32;
}

fn e51m_hinge_loss(
    records:[]i32,
    sample_count:i32,
    reverse:i32,
    linear_weights:[]i32,
    linear_weight_start:i32,
    linear_bias:i32,
    means:[]i32,
    means_start:i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_start:i32,
    term_count:i32
)i64 {
    let loss:i64=0;
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let predicted:i32=e51m_scalar_hinge_predict_record(
            records,record_start,linear_weights,linear_weight_start,linear_bias,
            means,means_start,term_features,term_directions,term_coefficients,
            term_start,term_count
        );
        let residual:i32=records[record_start+E51M_CAL_TARGET]-predicted;
        loss=loss+(residual as i64)*(residual as i64);
        traversal=traversal+1;
    }
    return loss;
}

fn e51m_hinge_candidate_loss(
    records:[]i32,
    sample_count:i32,
    reverse:i32,
    linear_weights:[]i32,
    linear_weight_start:i32,
    linear_bias:i32,
    means:[]i32,
    means_start:i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_start:i32,
    term_count:i32,
    candidate_feature:i32,
    candidate_direction:i32,
    candidate_coefficient:i32
)i64 {
    let loss:i64=0;
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let predicted:i64=e51m_scalar_hinge_predict_record(
            records,record_start,linear_weights,linear_weight_start,linear_bias,
            means,means_start,term_features,term_directions,term_coefficients,
            term_start,term_count
        ) as i64;
        let h:i32=e51m_hinge_value(
            records[record_start+candidate_feature],
            means[means_start+candidate_feature],candidate_direction
        );
        let candidate:i64=predicted+((candidate_coefficient as i64)*(h as i64))/1000;
        let bounded:i32=candidate as i32;
        if(candidate<-4000){ bounded=-4000; }
        if(candidate>4000){ bounded=4000; }
        let residual:i32=records[record_start+E51M_CAL_TARGET]-bounded;
        loss=loss+(residual as i64)*(residual as i64);
        traversal=traversal+1;
    }
    return loss;
}

fn e51m_term_selected(
    term_features:[]i32,
    term_directions:[]i32,
    term_start:i32,
    term_count:i32,
    feature:i32,
    direction:i32
)i32 {
    let term:i32=0;
    while(term<term_count){
        if(term_features[term_start+term]==feature && term_directions[term_start+term]==direction){ return 1; }
        term=term+1;
    }
    return 0;
}

fn e51m_hinge_search(
    records:[]i32,
    sample_count:i32,
    reverse:i32,
    linear_weights:[]i32,
    linear_weight_start:i32,
    linear_bias:i32,
    means:[]i32,
    means_start:i32,
    term_features:[]i32,
    term_directions:[]i32,
    term_coefficients:[]i32,
    term_start:i32,
    accepted_count:*i32,
    stop_reason:*i32,
    trace_hash:*i32,
    final_loss_low:*i32,
    final_loss_high:*i32
)void {
    let predictions:[]i32=zalloc_i(sample_count);
    let term:i32=0;
    while(term<E51M_MAX_HINGES){
        term_features[term_start+term]=-1;
        term_directions[term_start+term]=0;
        term_coefficients[term_start+term]=0;
        term=term+1;
    }
    accepted_count.*=0;
    stop_reason.*=2;
    trace_hash.*=719+sample_count;
    let current_loss:i64=0;
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let record_start:i32=record_number*E51M_CAL_RECORD_N;
        let predicted:i32=e51m_scalar_predict_record(
            records,record_start,linear_weights,linear_weight_start,linear_bias
        );
        predictions[record_number]=predicted;
        let residual:i32=records[record_start+E51M_CAL_TARGET]-predicted;
        current_loss=current_loss+(residual as i64)*(residual as i64);
        traversal=traversal+1;
    }
    trace_hash.*=e50_hash_loss(trace_hash.*,current_loss);
    let step:i32=0;
    let stopped:i32=0;
    while(step<E51M_MAX_HINGES && stopped==0){
        let best_feature:i32=-1;
        let best_direction:i32=0;
        let best_coefficient:i32=0;
        let best_loss:i64=current_loss;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            let direction:i32=0;
            while(direction<2){
                if(e51m_term_selected(term_features,term_directions,term_start,accepted_count.*,feature,direction)==0){
                    let sum_hr:i64=0;
                    let sum_hh:i64=0;
                    traversal=0;
                    while(traversal<sample_count){
                        let record_number:i32=traversal;
                        if(reverse==1){ record_number=sample_count-1-traversal; }
                        let record_start:i32=record_number*E51M_CAL_RECORD_N;
                        let residual:i32=records[record_start+E51M_CAL_TARGET]-predictions[record_number];

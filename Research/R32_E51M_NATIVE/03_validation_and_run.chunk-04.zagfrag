            dose*E51M_MAX_HINGES,&term_counts_reverse[dose],
            &hinge_reason_reverse,&hinge_trace_reverse,&hinge_low_reverse,&hinge_high_reverse
        );
        let hinge_gate:i32=e51m_compare_hinge_models(
            means_forward,means_reverse,dose*E45_FEATURES,
            term_features_forward,term_features_reverse,
            term_directions_forward,term_directions_reverse,
            term_coefficients_forward,term_coefficients_reverse,
            dose*E51M_MAX_HINGES,term_counts_forward[dose],term_counts_reverse[dose]
        );
        if(mean_hash_forward!=mean_hash_reverse || hinge_reason_forward!=hinge_reason_reverse || hinge_trace_forward!=hinge_trace_reverse || hinge_low_forward!=hinge_low_reverse || hinge_high_forward!=hinge_high_reverse){ hinge_gate=0; }
        if(stats_gate==1 && scalar_gate==1 && hinge_gate==1){ dose_gates[dose]=1; }
        _zag_print("e51m_dose_fit,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(sample_count); _zag_print(",");
        e45_print_i32(stats_hash_forward); _zag_print(","); e45_print_i32(steps_forward); _zag_print(","); e45_print_i32(reason_forward); _zag_print(","); e45_print_i32(trace_forward); _zag_print(",");
        e45_print_i32(high_forward); _zag_print(","); e45_print_i32(low_forward); _zag_print(","); e45_print_i32(term_counts_forward[dose]); _zag_print(","); e45_print_i32(hinge_reason_forward); _zag_print(","); e45_print_i32(hinge_trace_forward); _zag_print(","); e45_print_i32(hinge_high_forward); _zag_print(","); e45_print_i32(hinge_low_forward); _zag_print(","); e45_print_i32(dose_gates[dose]); _zag_println("");
        let term:i32=0;
        while(term<term_counts_forward[dose]){
            let at:i32=dose*E51M_MAX_HINGES+term;
            _zag_print("e51m_hinge_term,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(term); _zag_print(",");
            e45_print_i32(term_features_forward[at]); _zag_print(","); e45_print_i32(term_directions_forward[at]); _zag_print(",");
            e45_print_i32(means_forward[dose*E45_FEATURES+term_features_forward[at]]); _zag_print(","); e45_print_i32(term_coefficients_forward[at]); _zag_println("");
            term=term+1;
        }
        dose=dose+1;
    }

    let dev_positive_total:[]i32=zalloc_i(E51M_ARMS);
    let dev_positive_correct:[]i32=zalloc_i(E51M_ARMS);
    let dev_negative_total:[]i32=zalloc_i(E51M_ARMS);
    let dev_negative_correct:[]i32=zalloc_i(E51M_ARMS);
    let validation_positive_total:[]i32=zalloc_i(E51M_ARMS);
    let validation_positive_correct:[]i32=zalloc_i(E51M_ARMS);
    let validation_negative_total:[]i32=zalloc_i(E51M_ARMS);
    let validation_negative_correct:[]i32=zalloc_i(E51M_ARMS);
    let known_reachable:[]i32=zalloc_i(E51M_ARMS);
    let no_unique_reachable:[]i32=zalloc_i(E51M_ARMS);
    e45_zero(dev_positive_total,E51M_ARMS); e45_zero(dev_positive_correct,E51M_ARMS);
    e45_zero(dev_negative_total,E51M_ARMS); e45_zero(dev_negative_correct,E51M_ARMS);
    e45_zero(validation_positive_total,E51M_ARMS); e45_zero(validation_positive_correct,E51M_ARMS);
    e45_zero(validation_negative_total,E51M_ARMS); e45_zero(validation_negative_correct,E51M_ARMS);
    e45_zero(known_reachable,E51M_ARMS); e45_zero(no_unique_reachable,E51M_ARMS);
    e51m_development_sign_metrics(
        calibration_records,linear_forward_weights,linear_forward_biases,means_forward,
        term_features_forward,term_directions_forward,term_coefficients_forward,term_counts_forward,
        dev_positive_total,dev_positive_correct,dev_negative_total,dev_negative_correct
    );

    let known_episodes:i32=0; let no_unique_episodes:i32=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    e51m_validation_episode(
                        validation_seeds[index],mode,resource,
                        source_trust,dependence_penalty,consequence,hazard,
                        shadow_weights,shadow_bias,terminal_weights,terminal_biases,
                        linear_forward_weights,linear_forward_biases,means_forward,
                        term_features_forward,term_directions_forward,term_coefficients_forward,term_counts_forward,
                        known_reachable,no_unique_reachable,
                        validation_positive_total,validation_positive_correct,
                        validation_negative_total,validation_negative_correct,
                        &known_episodes,&no_unique_episodes
                    );
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51m_validation_known_episodes",known_episodes);

// R32 E51M data construction, matched evaluation, and run gates.

const E51M_SIGN_FIELDS:i32=4;
const E51M_SIGN_POS_TOTAL:i32=0;
const E51M_SIGN_POS_CORRECT:i32=1;
const E51M_SIGN_NEG_TOTAL:i32=2;
const E51M_SIGN_NEG_CORRECT:i32=3;

fn e51m_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    dev_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32
)i32 {
    e45_zero(dev_seeds,E51M_DEV4_EPISODES);
    e45_zero(validation_seeds,E51M_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E51M_CONFIRM_EPISODES);
    let failures:i32=0;
    let emitted:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e51m_dev_index(epoch,base_index,mode,resource,episode);
                        dev_seeds[index]=e46_assign_fresh_seed(
                            raw_seen,evidence_seen,resource_seen,52,index,mode,resource,&failures
                        );
                        emitted=emitted+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    validation_seeds[index]=e46_assign_fresh_seed(
                        raw_seen,evidence_seen,resource_seen,53,index,mode,resource,&failures
                    );
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<40){
                    let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                    confirmation_seeds[index]=e46_assign_fresh_seed(
                        raw_seen,evidence_seen,resource_seen,54,index,mode,resource,&failures
                    );
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51m_seed_manifest_emitted",emitted);
    e45_print_pair("e51m_seed_assignment_failures",failures);
    e45_print_pair("e51m_max_development_episodes",E51M_DEV4_EPISODES);
    e45_print_pair("e51m_validation_episodes",E51M_VALIDATION_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_allocated",E51M_CONFIRM_EPISODES);
    if(failures==0 && emitted==E51M_DEV4_EPISODES+E51M_VALIDATION_EPISODES+E51M_CONFIRM_EPISODES){ return 1; }
    return 0;
}

fn e51m_build_scalar_targets(
    records:[]i32,
    sample_count:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    targets:[]i32,
    top_scores:[]i32,
    positive_count:*i32,
    negative_count:*i32
)void {
    positive_count.*=0;
    negative_count.*=0;
    let features:[]i32=zalloc_i(E45_FEATURES);
    let record_number:i32=0;
    while(record_number<sample_count){
        let record_start:i32=record_number*E50_RECORD_N;
        e50_build_model_features(
            records,record_start,records[record_start+32],records[record_start+33],0,features,0
        );
        let top_action:i32=0;
        let top_score:i32=e47_linear_predict(
            terminal_weights,0*E45_FEATURES,features,0,terminal_biases[0]
        );
        let action:i32=1;
        while(action<3){
            let score:i32=e47_linear_predict(
                terminal_weights,action*E45_FEATURES,features,0,terminal_biases[action]
            );
            if(score>top_score){ top_score=score; top_action=action; }
            action=action+1;
        }
        top_scores[record_number]=top_score;
        let grounded:i32=records[record_start+34+top_action];
        if(grounded>0){ targets[record_number]=1000; positive_count.*=positive_count.*+1;
        }else{ targets[record_number]=-1000; negative_count.*=negative_count.*+1; }
        record_number=record_number+1;
    }
    zfree(features);
}

fn e51m_unknown_params_zero(terminal_weights:[]i32,terminal_biases:[]i32)i32 {
    if(terminal_biases[3]!=0){ return 0; }
    let feature:i32=0;
    while(feature<E45_FEATURES){
        if(terminal_weights[3*E45_FEATURES+feature]!=0){ return 0; }
        feature=feature+1;
    }
    return 1;
}

fn e51m_copy_params(source:[]i32,destination:[]i32,destination_start:i32,count:i32)void {
    let i:i32=0;
    while(i<count){ destination[destination_start+i]=source[i]; i=i+1; }
}

fn e51m_hinge_equal(
    means_a:[]i32,
    means_b:[]i32,
    feature_a:[]i32,
    feature_b:[]i32,
    direction_a:[]i32,
    direction_b:[]i32,
    coefficient_a:[]i32,
    coefficient_b:[]i32,
    accepted_a:i32,
    accepted_b:i32
)i32 {
    if(accepted_a!=accepted_b){ return 0; }
    if(e51m_params_equal(means_a,0,means_b,0,E45_FEATURES)==0){ return 0; }
    let i:i32=0;
    while(i<accepted_a){
        if(feature_a[i]!=feature_b[i] || direction_a[i]!=direction_b[i] || coefficient_a[i]!=coefficient_b[i]){ return 0; }
        i=i+1;
    }
    return 1;
}

fn e51m_sign_metrics(
    records:[]i32,
    targets:[]i32,
    sample_count:i32,
    linear_params:[]i32,
    linear_start:i32,
    hinge_feature:[]i32,
    hinge_direction:[]i32,
    hinge_coefficient:[]i32,
    hinge_start:i32,
    hinge_count:i32,
    means:[]i32,
    mean_start:i32,
    metrics:[]i32,
    metrics_start:i32
)void {
    let record_number:i32=0;
    while(record_number<sample_count){
        let prediction:i32=e51m_predict(
            records,record_number*E50_RECORD_N,
            linear_params,linear_start,
            hinge_feature,hinge_direction,hinge_coefficient,hinge_start,hinge_count,
            means,mean_start
        );
        if(targets[record_number]>0){
            metrics[metrics_start+E51M_SIGN_POS_TOTAL]=metrics[metrics_start+E51M_SIGN_POS_TOTAL]+1;
            if(prediction>=0){ metrics[metrics_start+E51M_SIGN_POS_CORRECT]=metrics[metrics_start+E51M_SIGN_POS_CORRECT]+1; }
        }else{
            metrics[metrics_start+E51M_SIGN_NEG_TOTAL]=metrics[metrics_start+E51M_SIGN_NEG_TOTAL]+1;
            if(prediction<0){ metrics[metrics_start+E51M_SIGN_NEG_CORRECT]=metrics[metrics_start+E51M_SIGN_NEG_CORRECT]+1; }
        }
        record_number=record_number+1;
    }
}

fn e51m_evaluate_reachability(
    records:[]i32,
    targets:[]i32,
    top_scores:[]i32,
    episode_kind:[]i32,
    episode_count:i32,
    linear_params:[]i32,
    hinge_feature:[]i32,
    hinge_direction:[]i32,
    hinge_coefficient:[]i32,
    accepted_terms:[]i32,
    means:[]i32,
    base_known_reachable:*i32,
    base_no_unique_reachable:*i32,
    known_reachable:[]i32,
    no_unique_reachable:[]i32
)void {
    base_known_reachable.*=0;
    base_no_unique_reachable.*=0;
    e45_zero(known_reachable,E51M_ARMS);
    e45_zero(no_unique_reachable,E51M_ARMS);
    let episode:i32=0;
    while(episode<episode_count){
        let base_reached:i32=0;
        let arm_reached:[]i32=zalloc_i(E51M_ARMS);
        let t:i32=0;
        while(t<=E45_TAPE){
            let record_number:i32=episode*(E45_TAPE+1)+t;
            if(episode_kind[episode]==0){
                if(top_scores[record_number]<0){ base_reached=1; }
            }else{
                if(top_scores[record_number]>=0 && targets[record_number]>0){ base_reached=1; }
            }
            let dose:i32=0;
            while(dose<E51M_DOSES){
                let cap_index:i32=0;
                while(cap_index<E51M_CAPS){
                    let arm:i32=dose*E51M_CAPS+cap_index;
                    let requested:i32=e51m_cap_value(cap_index);
                    let used:i32=requested;
                    if(accepted_terms[dose]<used){ used=accepted_terms[dose]; }
                    let prediction:i32=e51m_predict(
                        records,record_number*E50_RECORD_N,
                        linear_params,dose*E51M_SCALAR_COLUMNS,
                        hinge_feature,hinge_direction,hinge_coefficient,dose*E51M_HINGE_MAX,used,
                        means,dose*E45_FEATURES
                    );
                    if(episode_kind[episode]==0){
                        if(prediction<0){ arm_reached[arm]=1; }
                    }else{
                        if(prediction>=0 && targets[record_number]>0){ arm_reached[arm]=1; }
                    }
                    cap_index=cap_index+1;
                }
                dose=dose+1;
            }
            t=t+1;
        }
        if(base_reached==1){
            if(episode_kind[episode]==0){ base_no_unique_reachable.*=base_no_unique_reachable.*+1;
            }else{ base_known_reachable.*=base_known_reachable.*+1; }
        }
        let arm:i32=0;
        while(arm<E51M_ARMS){
            if(arm_reached[arm]==1){
                if(episode_kind[episode]==0){ no_unique_reachable[arm]=no_unique_reachable[arm]+1;
                }else{ known_reachable[arm]=known_reachable[arm]+1; }
            }
            arm=arm+1;
        }
        zfree(arm_reached);
        episode=episode+1;
    }
}

fn e51m_eval_one_confirmation(
    records:[]i32,
    targets:[]i32,
    episode_kind:[]i32,
    episode_count:i32,
    linear_params:[]i32,
    linear_start:i32,
    hinge_feature:[]i32,
    hinge_direction:[]i32,
    hinge_coefficient:[]i32,
    hinge_start:i32,
    hinge_count:i32,
    means:[]i32,
    mean_start:i32,
    known_reachable:*i32,
    no_unique_reachable:*i32
)void {
    known_reachable.*=0;
    no_unique_reachable.*=0;
    let episode:i32=0;
    while(episode<episode_count){
        let reached:i32=0;
        let t:i32=0;
        while(t<=E45_TAPE){
            let record_number:i32=episode*(E45_TAPE+1)+t;
            let prediction:i32=e51m_predict(
                records,record_number*E50_RECORD_N,
                linear_params,linear_start,
                hinge_feature,hinge_direction,hinge_coefficient,hinge_start,hinge_count,
                means,mean_start
            );
            if(episode_kind[episode]==0){
                if(prediction<0){ reached=1; }
            }else{
                if(prediction>=0 && targets[record_number]>0){ reached=1; }
            }
            t=t+1;
        }
        if(reached==1){
            if(episode_kind[episode]==0){ no_unique_reachable.*=no_unique_reachable.*+1;
            }else{ known_reachable.*=known_reachable.*+1; }
        }
        episode=episode+1;
    }
}

fn e51m_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51M_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51m_calibration_dose_capacity_curve_v1");
    _zag_println("native_language,zag_v2");
    _zag_println("canonical_status,R27_unchanged");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");
    _zag_println("evaluator_truth_exposed_to_learner=0");
    _zag_println("ambiguity_label_exposed_to_learner=0");
    _zag_println("unknown_score_fixed_zero=1");
    _zag_println("base_terminal_ordering_dose,1x_only");

    let dev_seeds:[]i32=zalloc_i(E51M_DEV4_EPISODES);
    let validation_seeds:[]i32=zalloc_i(E51M_VALIDATION_EPISODES);
    let confirmation_seeds:[]i32=zalloc_i(E51M_CONFIRM_EPISODES);
    let seed_gate:i32=e51m_allocate_seeds(
        raw_seen,evidence_seen,resource_seen,dev_seeds,validation_seeds,confirmation_seeds
    );

    let dev_records:[]i32=zalloc_i(E51M_DEV4_SAMPLES*E50_RECORD_N);
    let continue_records:[]i32=zalloc_i(E51M_DEV4_SAMPLES*E50_RECORD_N);
    e45_zero(dev_records,E51M_DEV4_SAMPLES*E50_RECORD_N);
    e45_zero(continue_records,E51M_DEV4_SAMPLES*E50_RECORD_N);
    let unknown_target_nonzero:i32=0;
    let continue_positive:i32=0;
    let continue_negative:i32=0;
    let built_dev:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e51m_dev_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(
                            dev_seeds[index],mode,resource,index,
                            source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
                            dev_records,continue_records,
                            &unknown_target_nonzero,&continue_positive,&continue_negative
                        );
                        built_dev=built_dev+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    e45_print_pair("e51m_development_episodes_built",built_dev);
    e45_print_pair("e51m_unknown_target_nonzero",unknown_target_nonzero);
    zfree(continue_records);

    // Frozen 1x base terminal ordering head. e51e_fit_model/e50 statistics consume
    // exactly the first 55,080 records, which are the strict 1x prefix here.
    let base_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let base_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let backup_biases:[]i32=zalloc_i(4);
    let gram_forward:[]i32=zalloc_i(E50_BATCH_GRAM);
    let gram_reverse:[]i32=zalloc_i(E50_BATCH_GRAM);
    let cross_forward:[]i32=zalloc_i(E50_BATCH_CROSS);
    let cross_reverse:[]i32=zalloc_i(E50_BATCH_CROSS);
    let forward_copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES);
    let forward_copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(base_weights,E51E_MODELS*4*E45_FEATURES);
    e45_zero(base_biases,E51E_MODELS*4);
    e45_zero(forward_copy_weights,E51E_MODELS*4*E45_FEATURES);
    e45_zero(forward_copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(
        dev_records,0,0,base_weights,base_biases,
        backup_weights,backup_biases,gram_forward,gram_reverse,cross_forward,cross_reverse,
        forward_copy_weights,forward_copy_biases
    );
    let unknown_param_gate:i32=e51m_unknown_params_zero(base_weights,base_biases);
    e45_print_pair("e51m_base_terminal_fit_identity_gate",base_fit_gate);
    e45_print_pair("e51m_base_unknown_parameters_zero_gate",unknown_param_gate);

    let dev_targets:[]i32=zalloc_i(E51M_DEV4_SAMPLES);
    let dev_top_scores:[]i32=zalloc_i(E51M_DEV4_SAMPLES);
    let dev_positive:i32=0;
    let dev_negative:i32=0;
    e51m_build_scalar_targets(
        dev_records,E51M_DEV4_SAMPLES,base_weights,base_biases,
        dev_targets,dev_top_scores,&dev_positive,&dev_negative
    );
    e45_print_pair("e51m_max_dev_positive_targets",dev_positive);
    e45_print_pair("e51m_max_dev_negative_targets",dev_negative);

    let linear_params:[]i32=zalloc_i(E51M_DOSES*E51M_SCALAR_COLUMNS);
    let means:[]i32=zalloc_i(E51M_DOSES*E45_FEATURES);
    let hinge_feature:[]i32=zalloc_i(E51M_DOSES*E51M_HINGE_MAX);
    let hinge_direction:[]i32=zalloc_i(E51M_DOSES*E51M_HINGE_MAX);
    let hinge_coefficient:[]i32=zalloc_i(E51M_DOSES*E51M_HINGE_MAX);
    let accepted_terms:[]i32=zalloc_i(E51M_DOSES);
    e45_zero(linear_params,E51M_DOSES*E51M_SCALAR_COLUMNS);
    e45_zero(means,E51M_DOSES*E45_FEATURES);
    e45_zero(hinge_feature,E51M_DOSES*E51M_HINGE_MAX);
    e45_zero(hinge_direction,E51M_DOSES*E51M_HINGE_MAX);
    e45_zero(hinge_coefficient,E51M_DOSES*E51M_HINGE_MAX);
    e45_zero(accepted_terms,E51M_DOSES);

    let fit_identity_gate:i32=1;
    let hinge_identity_gate:i32=1;
    let params_f:[]i32=zalloc_i(E51M_SCALAR_COLUMNS);
    let params_r:[]i32=zalloc_i(E51M_SCALAR_COLUMNS);
    let means_f:[]i32=zalloc_i(E45_FEATURES);
    let means_r:[]i32=zalloc_i(E45_FEATURES);
    let hf_f:[]i32=zalloc_i(E51M_HINGE_MAX);
    let hf_r:[]i32=zalloc_i(E51M_HINGE_MAX);
    let hd_f:[]i32=zalloc_i(E51M_HINGE_MAX);
    let hd_r:[]i32=zalloc_i(E51M_HINGE_MAX);
    let hc_f:[]i32=zalloc_i(E51M_HINGE_MAX);
    let hc_r:[]i32=zalloc_i(E51M_HINGE_MAX);

    let dose:i32=0;
    while(dose<E51M_DOSES){
        let samples:i32=e51m_dose_samples(dose);
        let steps_f:i32=0; let trace_f:i32=0;
        let steps_r:i32=0; let trace_r:i32=0;
        let loss_f:i64=e51m_fit_once(dev_records,dev_targets,samples,0,params_f,&steps_f,&trace_f);
        let loss_r:i64=e51m_fit_once(dev_records,dev_targets,samples,1,params_r,&steps_r,&trace_r);
        let local_fit_gate:i32=1;
        if(steps_f<=0 || steps_f!=steps_r || trace_f!=trace_r || loss_f!=loss_r || e51m_params_equal(params_f,0,params_r,0,E51M_SCALAR_COLUMNS)==0){ local_fit_gate=0; fit_identity_gate=0; }
        e51m_copy_params(params_f,linear_params,dose*E51M_SCALAR_COLUMNS,E51M_SCALAR_COLUMNS);
        _zag_print("e51m_linear_fit,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(samples); _zag_print(","); e45_print_i32(steps_f); _zag_print(","); e45_print_i32(trace_f); _zag_print(","); e45_print_i64(loss_f); _zag_print(","); e45_print_i32(local_fit_gate); _zag_println("");

        let accepted_f:i32=0; let accepted_r:i32=0;
        let hinge_trace_f:i32=0; let hinge_trace_r:i32=0;
        let hinge_loss_f:i64=e51m_hinge_search_once(
            dev_records,dev_targets,samples,0,params_f,means_f,hf_f,hd_f,hc_f,&accepted_f,&hinge_trace_f
        );
        let hinge_loss_r:i64=e51m_hinge_search_once(
            dev_records,dev_targets,samples,1,params_r,means_r,hf_r,hd_r,hc_r,&accepted_r,&hinge_trace_r
        );
        let local_hinge_gate:i32=e51m_hinge_equal(
            means_f,means_r,hf_f,hf_r,hd_f,hd_r,hc_f,hc_r,accepted_f,accepted_r
        );
        if(hinge_trace_f!=hinge_trace_r || hinge_loss_f!=hinge_loss_r){ local_hinge_gate=0; }
        if(local_hinge_gate==0){ hinge_identity_gate=0; }
        accepted_terms[dose]=accepted_f;
        e51m_copy_params(means_f,means,dose*E45_FEATURES,E45_FEATURES);
        let h:i32=0;
        while(h<accepted_f){
            hinge_feature[dose*E51M_HINGE_MAX+h]=hf_f[h];
            hinge_direction[dose*E51M_HINGE_MAX+h]=hd_f[h];
            hinge_coefficient[dose*E51M_HINGE_MAX+h]=hc_f[h];
            h=h+1;
        }
        _zag_print("e51m_hinge_search,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(accepted_f); _zag_print(","); e45_print_i32(hinge_trace_f); _zag_print(","); e45_print_i64(hinge_loss_f); _zag_print(","); e45_print_i32(local_hinge_gate); _zag_println("");
        dose=dose+1;
    }
    e45_print_pair("e51m_scalar_fit_forward_reverse_gate",fit_identity_gate);
    e45_print_pair("e51m_hinge_forward_reverse_gate",hinge_identity_gate);

    let dev_sign:[]i32=zalloc_i(E51M_ARMS*E51M_SIGN_FIELDS);
    e45_zero(dev_sign,E51M_ARMS*E51M_SIGN_FIELDS);
    dose=0;
    while(dose<E51M_DOSES){
        let cap_index:i32=0;
        while(cap_index<E51M_CAPS){
            let arm:i32=dose*E51M_CAPS+cap_index;
            let used:i32=e51m_cap_value(cap_index);
            if(accepted_terms[dose]<used){ used=accepted_terms[dose]; }
            e51m_sign_metrics(
                dev_records,dev_targets,e51m_dose_samples(dose),
                linear_params,dose*E51M_SCALAR_COLUMNS,
                hinge_feature,hinge_direction,hinge_coefficient,dose*E51M_HINGE_MAX,used,
                means,dose*E45_FEATURES,dev_sign,arm*E51M_SIGN_FIELDS
            );
            cap_index=cap_index+1;
        }
        dose=dose+1;
    }

    // Common untouched validation population.
    let validation_records:[]i32=zalloc_i(E51M_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_continue:[]i32=zalloc_i(E51M_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_targets:[]i32=zalloc_i(E51M_VALIDATION_SAMPLES);
    let validation_top_scores:[]i32=zalloc_i(E51M_VALIDATION_SAMPLES);
    let validation_kind:[]i32=zalloc_i(E51M_VALIDATION_EPISODES);
    e45_zero(validation_records,E51M_VALIDATION_SAMPLES*E50_RECORD_N);
    e45_zero(validation_continue,E51M_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_built:i32=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    validation_kind[index]=1;
                    if(mode==0 || mode==1){ validation_kind[index]=0; }
                    e51e_build_training_episode(
                        validation_seeds[index],mode,resource,index,
                        source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
                        validation_records,validation_continue,
                        &unknown_target_nonzero,&continue_positive,&continue_negative
                    );
                    validation_built=validation_built+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    zfree(validation_continue);
    let validation_positive:i32=0; let validation_negative:i32=0;
    e51m_build_scalar_targets(
        validation_records,E51M_VALIDATION_SAMPLES,base_weights,base_biases,
        validation_targets,validation_top_scores,&validation_positive,&validation_negative
    );
    e45_print_pair("e51m_validation_episodes_built",validation_built);
    e45_print_pair("e51m_validation_positive_targets",validation_positive);
    e45_print_pair("e51m_validation_negative_targets",validation_negative);

    let validation_sign:[]i32=zalloc_i(E51M_ARMS*E51M_SIGN_FIELDS);
    let known_reachable:[]i32=zalloc_i(E51M_ARMS);
    let no_unique_reachable:[]i32=zalloc_i(E51M_ARMS);
    e45_zero(validation_sign,E51M_ARMS*E51M_SIGN_FIELDS);
    dose=0;
    while(dose<E51M_DOSES){
        let cap_index:i32=0;
        while(cap_index<E51M_CAPS){
            let arm:i32=dose*E51M_CAPS+cap_index;
            let used:i32=e51m_cap_value(cap_index);
            if(accepted_terms[dose]<used){ used=accepted_terms[dose]; }
            e51m_sign_metrics(
                validation_records,validation_targets,E51M_VALIDATION_SAMPLES,
                linear_params,dose*E51M_SCALAR_COLUMNS,
                hinge_feature,hinge_direction,hinge_coefficient,dose*E51M_HINGE_MAX,used,
                means,dose*E45_FEATURES,validation_sign,arm*E51M_SIGN_FIELDS
            );
            cap_index=cap_index+1;
        }
        dose=dose+1;
    }
    let base_known_reachable:i32=0;
    let base_no_unique_reachable:i32=0;
    e51m_evaluate_reachability(
        validation_records,validation_targets,validation_top_scores,validation_kind,E51M_VALIDATION_EPISODES,
        linear_params,hinge_feature,hinge_direction,hinge_coefficient,accepted_terms,means,
        &base_known_reachable,&base_no_unique_reachable,known_reachable,no_unique_reachable
    );
    _zag_print("e51m_validation_base_reachability,"); e45_print_i32(base_known_reachable); _zag_print(","); e45_print_i32(base_no_unique_reachable); _zag_println("");
    _zag_println("e51m_arm_columns,dose,requested_hinges,used_hinges,dev_pos_correct,dev_pos_total,dev_neg_correct,dev_neg_total,val_pos_correct,val_pos_total,val_neg_correct,val_neg_total,known_reachable,no_unique_unknown_reachable");
    dose=0;
    while(dose<E51M_DOSES){
        let cap_index:i32=0;
        while(cap_index<E51M_CAPS){
            let arm:i32=dose*E51M_CAPS+cap_index;
            let requested:i32=e51m_cap_value(cap_index);
            let used:i32=requested; if(accepted_terms[dose]<used){ used=accepted_terms[dose]; }
            let ds:i32=arm*E51M_SIGN_FIELDS;
            let vs:i32=arm*E51M_SIGN_FIELDS;
            _zag_print("e51m_arm,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(requested); _zag_print(","); e45_print_i32(used); _zag_print(",");
            e45_print_i32(dev_sign[ds+E51M_SIGN_POS_CORRECT]); _zag_print(","); e45_print_i32(dev_sign[ds+E51M_SIGN_POS_TOTAL]); _zag_print(",");
            e45_print_i32(dev_sign[ds+E51M_SIGN_NEG_CORRECT]); _zag_print(","); e45_print_i32(dev_sign[ds+E51M_SIGN_NEG_TOTAL]); _zag_print(",");
            e45_print_i32(validation_sign[vs+E51M_SIGN_POS_CORRECT]); _zag_print(","); e45_print_i32(validation_sign[vs+E51M_SIGN_POS_TOTAL]); _zag_print(",");
            e45_print_i32(validation_sign[vs+E51M_SIGN_NEG_CORRECT]); _zag_print(","); e45_print_i32(validation_sign[vs+E51M_SIGN_NEG_TOTAL]); _zag_print(",");
            e45_print_i32(known_reachable[arm]); _zag_print(","); e45_print_i32(no_unique_reachable[arm]); _zag_println("");
            cap_index=cap_index+1;
        }
        dose=dose+1;
    }

    let integrity_gate:i32=0;
    if(seed_gate==1 && built_dev==E51M_DEV4_EPISODES && validation_built==E51M_VALIDATION_EPISODES && unknown_target_nonzero==0 && base_fit_gate==1 && unknown_param_gate==1 && dev_positive>0 && dev_negative>0 && validation_positive>0 && validation_negative>0 && fit_identity_gate==1 && hinge_identity_gate==1){ integrity_gate=1; }
    e45_print_pair("e51m_integrity_gate",integrity_gate);

    let exact_arm:i32=-1;
    let arm:i32=0;
    while(arm<E51M_ARMS){
        if(exact_arm<0 && known_reachable[arm]==4200 && no_unique_reachable[arm]==1200){ exact_arm=arm; }
        arm=arm+1;
    }
    let dose_signal:i32=0;
    let cap_signal:i32=0;
    let cap_index:i32=0;
    while(cap_index<E51M_CAPS){
        dose=0;
        while(dose<2){
            let low:i32=dose*E51M_CAPS+cap_index;
            let high:i32=(dose+1)*E51M_CAPS+cap_index;
            if(known_reachable[high]>=known_reachable[low] && no_unique_reachable[high]>=no_unique_reachable[low]){
                if(known_reachable[high]>known_reachable[low] || no_unique_reachable[high]>no_unique_reachable[low]){ dose_signal=1; }
            }
            dose=dose+1;
        }
        cap_index=cap_index+1;
    }
    dose=0;
    while(dose<E51M_DOSES){
        cap_index=0;
        while(cap_index<3){
            let low:i32=dose*E51M_CAPS+cap_index;
            let high:i32=dose*E51M_CAPS+cap_index+1;
            if(known_reachable[high]>=known_reachable[low] && no_unique_reachable[high]>=no_unique_reachable[low]){
                if(known_reachable[high]>known_reachable[low] || no_unique_reachable[high]>no_unique_reachable[low]){ cap_signal=1; }
            }
            cap_index=cap_index+1;
        }
        dose=dose+1;
    }
    e45_print_pair("e51m_exact_validation_arm",exact_arm);
    e45_print_pair("e51m_dose_pareto_signal",dose_signal);
    e45_print_pair("e51m_capacity_pareto_signal",cap_signal);

    let confirmation_executed:i32=0;
    let confirmation_gate:i32=0;
    if(integrity_gate==1 && exact_arm>=0){
        confirmation_executed=E51M_CONFIRM_EPISODES;
        let confirmation_records:[]i32=zalloc_i(E51M_CONFIRM_SAMPLES*E50_RECORD_N);
        let confirmation_continue:[]i32=zalloc_i(E51M_CONFIRM_SAMPLES*E50_RECORD_N);
        let confirmation_targets:[]i32=zalloc_i(E51M_CONFIRM_SAMPLES);
        let confirmation_top_scores:[]i32=zalloc_i(E51M_CONFIRM_SAMPLES);
        let confirmation_kind:[]i32=zalloc_i(E51M_CONFIRM_EPISODES);
        e45_zero(confirmation_records,E51M_CONFIRM_SAMPLES*E50_RECORD_N);
        e45_zero(confirmation_continue,E51M_CONFIRM_SAMPLES*E50_RECORD_N);
        base_index=0;
        while(base_index<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<40){
                        let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                        confirmation_kind[index]=1; if(mode==0 || mode==1){ confirmation_kind[index]=0; }
                        e51e_build_training_episode(
                            confirmation_seeds[index],mode,resource,index,
                            source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
                            confirmation_records,confirmation_continue,
                            &unknown_target_nonzero,&continue_positive,&continue_negative
                        );
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        zfree(confirmation_continue);
        let cp:i32=0; let cn:i32=0;
        e51m_build_scalar_targets(
            confirmation_records,E51M_CONFIRM_SAMPLES,base_weights,base_biases,
            confirmation_targets,confirmation_top_scores,&cp,&cn
        );
        let winner_dose:i32=exact_arm/E51M_CAPS;
        let winner_cap_index:i32=exact_arm-winner_dose*E51M_CAPS;
        let winner_used:i32=e51m_cap_value(winner_cap_index); if(accepted_terms[winner_dose]<winner_used){ winner_used=accepted_terms[winner_dose]; }
        let ck:i32=0; let cu:i32=0;
        e51m_eval_one_confirmation(
            confirmation_records,confirmation_targets,confirmation_kind,E51M_CONFIRM_EPISODES,
            linear_params,winner_dose*E51M_SCALAR_COLUMNS,
            hinge_feature,hinge_direction,hinge_coefficient,winner_dose*E51M_HINGE_MAX,winner_used,
            means,winner_dose*E45_FEATURES,&ck,&cu
        );
        if(ck==8400 && cu==2400){ confirmation_gate=1; }
        _zag_print("e51m_confirmation_reachability,"); e45_print_i32(exact_arm); _zag_print(","); e45_print_i32(ck); _zag_print(","); e45_print_i32(cu); _zag_print(","); e45_print_i32(confirmation_gate); _zag_println("");
        zfree(confirmation_records); zfree(confirmation_targets); zfree(confirmation_top_scores); zfree(confirmation_kind);
    }
    e45_print_pair("e51m_sealed_confirmation_executed",confirmation_executed);
    e45_print_pair("e51m_confirmation_gate",confirmation_gate);

    if(integrity_gate==0){
        _zag_println("e51m_outcome,INTEGRITY_FAILURE");
    }else{
        if(exact_arm>=0){
            if(confirmation_gate==1){ _zag_println("e51m_outcome,CALIBRATION_DOSE_CAPACITY_RESCUE");
            }else{ _zag_println("e51m_outcome,VALIDATION_RESCUE_CONFIRMATION_FAILED"); }
        }else{
            if(dose_signal==1){ _zag_println("e51m_outcome,CALIBRATION_DOSE_SIGNAL");
            }else{
                if(cap_signal==1){ _zag_println("e51m_outcome,CALIBRATION_CAPACITY_SIGNAL");
                }else{ _zag_println("e51m_outcome,CALIBRATION_DOSE_CAPACITY_PLATEAU"); }
            }
        }
    }

    zfree(dev_seeds); zfree(validation_seeds); zfree(confirmation_seeds);
    zfree(dev_records); zfree(dev_targets); zfree(dev_top_scores);
    zfree(base_weights); zfree(base_biases); zfree(backup_weights); zfree(backup_biases);
    zfree(gram_forward); zfree(gram_reverse); zfree(cross_forward); zfree(cross_reverse);
    zfree(forward_copy_weights); zfree(forward_copy_biases);
    zfree(linear_params); zfree(means); zfree(hinge_feature); zfree(hinge_direction); zfree(hinge_coefficient); zfree(accepted_terms);
    zfree(params_f); zfree(params_r); zfree(means_f); zfree(means_r); zfree(hf_f); zfree(hf_r); zfree(hd_f); zfree(hd_r); zfree(hc_f); zfree(hc_r);
    zfree(dev_sign); zfree(validation_records); zfree(validation_targets); zfree(validation_top_scores); zfree(validation_kind);
    zfree(validation_sign); zfree(known_reachable); zfree(no_unique_reachable);
    if(integrity_gate==1){ return 1; }
    return 0;
}

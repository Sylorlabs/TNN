                        let h:i32=e51m_hinge_value(records[record_start+feature],means[means_start+feature],direction);
                        sum_hr=sum_hr+(h as i64)*(residual as i64);
                        sum_hh=sum_hh+(h as i64)*(h as i64);
                        traversal=traversal+1;
                    }
                    let coefficient:i32=0;
                    if(sum_hh>0){
                        coefficient=e50_round_nearest_i64(sum_hr*1000,sum_hh) as i32;
                        coefficient=r32e45_clamp(coefficient,-16000,16000);
                    }
                    if(coefficient!=0){
                        let candidate_loss:i64=0;
                        traversal=0;
                        while(traversal<sample_count){
                            let record_number:i32=traversal;
                            if(reverse==1){ record_number=sample_count-1-traversal; }
                            let record_start:i32=record_number*E51M_CAL_RECORD_N;
                            let h:i32=e51m_hinge_value(records[record_start+feature],means[means_start+feature],direction);
                            let candidate:i64=(predictions[record_number] as i64)+((coefficient as i64)*(h as i64))/1000;
                            let bounded:i32=candidate as i32;
                            if(candidate<-4000){ bounded=-4000; }
                            if(candidate>4000){ bounded=4000; }
                            let residual:i32=records[record_start+E51M_CAL_TARGET]-bounded;
                            candidate_loss=candidate_loss+(residual as i64)*(residual as i64);
                            traversal=traversal+1;
                        }
                        if(candidate_loss<best_loss){
                            best_loss=candidate_loss;
                            best_feature=feature;
                            best_direction=direction;
                            best_coefficient=coefficient;
                        }
                    }
                }
                direction=direction+1;
            }
            feature=feature+1;
        }
        if(best_feature<0 || best_loss>=current_loss){
            stop_reason.*=1;
            stopped=1;
        }else{
            let at:i32=term_start+accepted_count.*;
            term_features[at]=best_feature;
            term_directions[at]=best_direction;
            term_coefficients[at]=best_coefficient;
            accepted_count.*=accepted_count.*+1;
            traversal=0;
            while(traversal<sample_count){
                let record_number:i32=traversal;
                if(reverse==1){ record_number=sample_count-1-traversal; }
                let record_start:i32=record_number*E51M_CAL_RECORD_N;
                let h:i32=e51m_hinge_value(records[record_start+best_feature],means[means_start+best_feature],best_direction);
                let candidate:i64=(predictions[record_number] as i64)+((best_coefficient as i64)*(h as i64))/1000;
                let bounded:i32=candidate as i32;
                if(candidate<-4000){ bounded=-4000; }
                if(candidate>4000){ bounded=4000; }
                predictions[record_number]=bounded;
                traversal=traversal+1;
            }
            current_loss=best_loss;
            trace_hash.*=e46_hash_update(trace_hash.*,best_feature);
            trace_hash.*=e46_hash_update(trace_hash.*,best_direction);
            trace_hash.*=e46_hash_update(trace_hash.*,best_coefficient);
            trace_hash.*=e50_hash_loss(trace_hash.*,current_loss);
        }
        step=step+1;
    }
    if(stopped==0){ stop_reason.*=2; }
    final_loss_low.*=e50_loss_low(current_loss);
    final_loss_high.*=e50_loss_high(current_loss);
    zfree(predictions);
}

fn e51m_compare_scalar_models(
    forward_weights:[]i32,
    reverse_weights:[]i32,
    weight_start:i32,
    forward_bias:i32,
    reverse_bias:i32
)i32 {
    if(forward_bias!=reverse_bias){ return 0; }
    let feature:i32=0;
    while(feature<E45_FEATURES){
        if(forward_weights[weight_start+feature]!=reverse_weights[weight_start+feature]){ return 0; }
        feature=feature+1;
    }
    return 1;
}

fn e51m_compare_hinge_models(
    means_forward:[]i32,
    means_reverse:[]i32,
    means_start:i32,
    features_forward:[]i32,
    features_reverse:[]i32,
    directions_forward:[]i32,
    directions_reverse:[]i32,
    coefficients_forward:[]i32,
    coefficients_reverse:[]i32,
    term_start:i32,
    count_forward:i32,
    count_reverse:i32
)i32 {
    if(count_forward!=count_reverse){ return 0; }
    let feature:i32=0;
    while(feature<E45_FEATURES){
        if(means_forward[means_start+feature]!=means_reverse[means_start+feature]){ return 0; }
        feature=feature+1;
    }
    let term:i32=0;
    while(term<count_forward){
        if(features_forward[term_start+term]!=features_reverse[term_start+term]){ return 0; }
        if(directions_forward[term_start+term]!=directions_reverse[term_start+term]){ return 0; }
        if(coefficients_forward[term_start+term]!=coefficients_reverse[term_start+term]){ return 0; }
        term=term+1;
    }
    return 1;
}

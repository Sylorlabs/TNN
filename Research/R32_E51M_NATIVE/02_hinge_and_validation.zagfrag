fn e51m_predict_hinges(
    records:[]i32,
    record_start:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32,
    term_features:[]i32,
    term_start:i32,
    term_directions:[]i32,
    term_means:[]i32,
    term_coefficients:[]i32,
    count:i32
)i32 {
    let value:i32=e51m_scalar_predict(weights,weight_start,bias,records,record_start);
    let term:i32=0;
    while(term<count){
        let f:i32=term_features[term_start+term];
        let basis:i32=e51m_hinge_basis(records[record_start+f],term_means[term_start+term],term_directions[term_start+term]);
        value=value+term_coefficients[term_start+term]*basis/1000;
        term=term+1;
    }
    return r32e45_clamp(value,-4000,4000);
}

fn e51m_search_hinges(
    records:[]i32,
    sample_n:i32,
    reverse:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32,
    term_features:[]i32,
    term_start:i32,
    term_directions:[]i32,
    term_means:[]i32,
    term_coefficients:[]i32,
    accepted:*i32,
    trace:*i32,
    loss_low:*i32,
    loss_high:*i32
)void {
    let zt:i32=0; while(zt<E51M_HINGE_MAX){ term_features[term_start+zt]=0; term_directions[term_start+zt]=0; term_means[term_start+zt]=0; term_coefficients[term_start+zt]=0; zt=zt+1; }
    accepted.*=0; trace.*=503;
    let means:[]i32=zalloc_i(E45_FEATURES);
    let current_pred:[]i32=zalloc_i(sample_n);
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let sum:i64=0;
        let traversal:i32=0;
        while(traversal<sample_n){
            let record:i32=traversal; if(reverse==1){ record=sample_n-1-traversal; }
            sum=sum+(records[record*E51M_SCALAR_RECORD_N+feature] as i64);
            traversal=traversal+1;
        }
        means[feature]=e50_signed_div_i64(sum,sample_n as i64) as i32;
        feature=feature+1;
    }
    let stopped:i32=0;
    while(accepted.*<E51M_HINGE_MAX && stopped==0){
        let current_loss:i64=0;
        let traversal:i32=0;
        while(traversal<sample_n){
            let record:i32=traversal; if(reverse==1){ record=sample_n-1-traversal; }
            let start:i32=record*E51M_SCALAR_RECORD_N;
            let pred:i32=e51m_predict_hinges(records,start,weights,weight_start,bias,term_features,term_start,term_directions,term_means,term_coefficients,accepted.*);
            current_pred[record]=pred;
            let residual:i32=records[start+32]-pred;
            current_loss=current_loss+(residual as i64)*(residual as i64);
            traversal=traversal+1;
        }
        let best_loss:i64=current_loss;
        let best_feature:i32=-1; let best_direction:i32=0; let best_coefficient:i32=0;
        feature=0;
        while(feature<E45_FEATURES){
            let direction:i32=0;
            while(direction<2){
                if(e51m_term_exists(term_features,term_directions,term_start,accepted.*,feature,direction)==0){
                    let cross:i64=0; let diagonal:i64=0;
                    traversal=0;
                    while(traversal<sample_n){
                        let record:i32=traversal; if(reverse==1){ record=sample_n-1-traversal; }
                        let start:i32=record*E51M_SCALAR_RECORD_N;
                        let basis:i32=e51m_hinge_basis(records[start+feature],means[feature],direction);
                        let residual:i32=records[start+32]-current_pred[record];
                        cross=cross+(basis as i64)*(residual as i64);
                        diagonal=diagonal+(basis as i64)*(basis as i64);
                        traversal=traversal+1;
                    }
                    if(diagonal>0){
                        let coefficient:i32=e50_round_nearest_i64(cross*1000,diagonal) as i32;
                        coefficient=r32e45_clamp(coefficient,-16000,16000);
                        if(coefficient!=0){
                            let candidate_loss:i64=0;
                            traversal=0;
                            while(traversal<sample_n){
                                let record:i32=traversal; if(reverse==1){ record=sample_n-1-traversal; }
                                let start:i32=record*E51M_SCALAR_RECORD_N;
                                let basis:i32=e51m_hinge_basis(records[start+feature],means[feature],direction);
                                let pred:i32=r32e45_clamp(current_pred[record]+coefficient*basis/1000,-4000,4000);
                                let residual:i32=records[start+32]-pred;
                                candidate_loss=candidate_loss+(residual as i64)*(residual as i64);
                                traversal=traversal+1;
                            }
                            if(candidate_loss<best_loss){ best_loss=candidate_loss; best_feature=feature; best_direction=direction; best_coefficient=coefficient; }
                        }
                    }
                }
                direction=direction+1;
            }
            feature=feature+1;
        }
        if(best_feature<0){ stopped=1;
        }else{
            let slot:i32=accepted.*;
            term_features[term_start+slot]=best_feature; term_directions[term_start+slot]=best_direction; term_means[term_start+slot]=means[best_feature]; term_coefficients[term_start+slot]=best_coefficient;
            accepted.*=accepted.*+1;
            trace.*=e46_hash_update(trace.*,best_feature); trace.*=e46_hash_update(trace.*,best_direction); trace.*=e46_hash_update(trace.*,means[best_feature]); trace.*=e46_hash_update(trace.*,best_coefficient); trace.*=e50_hash_loss(trace.*,best_loss);
        }
    }
    let final_loss:i64=0;
    let traversal:i32=0;
    while(traversal<sample_n){
        let record:i32=traversal; if(reverse==1){ record=sample_n-1-traversal; }
        let start:i32=record*E51M_SCALAR_RECORD_N;
        let pred:i32=e51m_predict_hinges(records,start,weights,weight_start,bias,term_features,term_start,term_directions,term_means,term_coefficients,accepted.*);
        let residual:i32=records[start+32]-pred;
        final_loss=final_loss+(residual as i64)*(residual as i64);
        traversal=traversal+1;
    }
    loss_low.*=e50_loss_low(final_loss); loss_high.*=e50_loss_high(final_loss);
    zfree(means); zfree(current_pred);
}

fn e51m_fit_hinges_identity(
    records:[]i32,
    sample_n:i32,
    dose:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32,
    features:[]i32,
    term_start:i32,
    directions:[]i32,
    means:[]i32,
    coefficients:[]i32,
    accepted:*i32
)i32 {
    let ff:[]i32=zalloc_i(E51M_HINGE_MAX); let fd:[]i32=zalloc_i(E51M_HINGE_MAX); let fm:[]i32=zalloc_i(E51M_HINGE_MAX); let fc:[]i32=zalloc_i(E51M_HINGE_MAX);
    let af:i32=0; let tf:i32=0; let llf:i32=0; let lhf:i32=0;
    e51m_search_hinges(records,sample_n,0,weights,weight_start,bias,features,term_start,directions,means,coefficients,&af,&tf,&llf,&lhf);
    let i:i32=0; while(i<E51M_HINGE_MAX){ ff[i]=features[term_start+i]; fd[i]=directions[term_start+i]; fm[i]=means[term_start+i]; fc[i]=coefficients[term_start+i]; i=i+1; }
    let ar:i32=0; let tr:i32=0; let llr:i32=0; let lhr:i32=0;
    e51m_search_hinges(records,sample_n,1,weights,weight_start,bias,features,term_start,directions,means,coefficients,&ar,&tr,&llr,&lhr);
    let gate:i32=1;
    if(af!=ar || tf!=tr || llf!=llr || lhf!=lhr){ gate=0; }
    i=0; while(i<E51M_HINGE_MAX){ if(features[term_start+i]!=ff[i] || directions[term_start+i]!=fd[i] || means[term_start+i]!=fm[i] || coefficients[term_start+i]!=fc[i]){ gate=0; } features[term_start+i]=ff[i]; directions[term_start+i]=fd[i]; means[term_start+i]=fm[i]; coefficients[term_start+i]=fc[i]; i=i+1; }
    accepted.*=af;
    _zag_print("e51m_hinge_fit,"); e45_print_i32(dose); _zag_print(","); e45_print_i32(sample_n); _zag_print(","); e45_print_i32(af); _zag_print(","); e45_print_i32(tf); _zag_print(","); e45_print_i32(gate); _zag_println("");
    zfree(ff); zfree(fd); zfree(fm); zfree(fc);
    return gate;
}

fn e51m_sign_metrics(
    records:[]i32,
    sample_n:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32,
    features:[]i32,
    term_start:i32,
    directions:[]i32,
    means:[]i32,
    coefficients:[]i32,
    prefix:i32,
    metrics:[]i32,
    start:i32
)void {
    let record:i32=0;
    while(record<sample_n){
        let rs:i32=record*E51M_SCALAR_RECORD_N;
        let target:i32=records[rs+32];
        let pred:i32=e51m_predict_hinges(records,rs,weights,weight_start,bias,features,term_start,directions,means,coefficients,prefix);
        if(target>0){ metrics[start]=metrics[start]+1; if(pred>=0){ metrics[start+1]=metrics[start+1]+1; } }
        if(target<0){ metrics[start+2]=metrics[start+2]+1; if(pred<0){ metrics[start+3]=metrics[start+3]+1; } }
        record=record+1;
    }
}

fn e51m_validation_evaluate(
    terminal_records:[]i32,
    scalar_records:[]i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    scalar_weights:[]i32,
    scalar_biases:[]i32,
    hinge_features:[]i32,
    hinge_directions:[]i32,
    hinge_means:[]i32,
    hinge_coefficients:[]i32,
    hinge_accepted:[]i32,
    known_reach:[]i32,
    no_unique_reach:[]i32,
    sign_metrics:[]i32,
    base_known:*i32,
    base_no_unique:*i32,
    known_total:*i32,
    no_unique_total:*i32
)void {
    e45_zero(known_reach,E51M_ARMS); e45_zero(no_unique_reach,E51M_ARMS); e45_zero(sign_metrics,E51M_ARMS*4);
    base_known.*=0; base_no_unique.*=0; known_total.*=0; no_unique_total.*=0;
    let scores:[]i32=zalloc_i(4); let arm_reached:[]i32=zalloc_i(E51M_ARMS);
    let episode:i32=0;
    while(episode<E51M_VALIDATION_EPISODES){
        e45_zero(arm_reached,E51M_ARMS);
        let first:i32=(episode*(E45_TAPE+1))*E50_RECORD_N;
        let no_unique:i32=0;
        if(terminal_records[first+34]==-1200 && terminal_records[first+35]==-1200 && terminal_records[first+36]==-1200){ no_unique=1; no_unique_total.*=no_unique_total.*+1;
        }else{ known_total.*=known_total.*+1; }
        let base_reached:i32=0;
        let t:i32=0;
        while(t<=E45_TAPE){
            let record:i32=episode*(E45_TAPE+1)+t;
            let tr:i32=record*E50_RECORD_N;
            let sr:i32=record*E51M_SCALAR_RECORD_N;
            let action:i32=0;
            while(action<4){ scores[action]=e47_linear_predict(terminal_weights,action*E45_FEATURES,scalar_records,sr,terminal_biases[action]); action=action+1; }
            let base_choice:i32=r32e45_terminal_choose(scores[0],scores[1],scores[2],scores[3]);
            if(no_unique==1){ if(base_choice==R32E45_TERM_UNKNOWN){ base_reached=1; }
            }else{ if(base_choice!=R32E45_TERM_UNKNOWN && terminal_records[tr+34+base_choice]==1000){ base_reached=1; } }
            let top:i32=0; let best:i32=scores[0];
            if(scores[1]>best){ top=1; best=scores[1]; }
            if(scores[2]>best){ top=2; }
            let target:i32=scalar_records[sr+32];
            let dose:i32=0;
            while(dose<E51M_DOSES){
                let cap:i32=0;
                while(cap<E51M_CAPS){
                    let arm:i32=dose*E51M_CAPS+cap;
                    let requested:i32=e51m_cap_terms(cap);
                    let prefix:i32=requested; if(prefix>hinge_accepted[dose]){ prefix=hinge_accepted[dose]; }
                    let pred:i32=e51m_predict_hinges(
                        scalar_records,sr,scalar_weights,dose*E45_FEATURES,scalar_biases[dose],
                        hinge_features,dose*E51M_HINGE_MAX,hinge_directions,hinge_means,hinge_coefficients,prefix
                    );
                    let sm:i32=arm*4;
                    if(target>0){ sign_metrics[sm]=sign_metrics[sm]+1; if(pred>=0){ sign_metrics[sm+1]=sign_metrics[sm+1]+1; } }
                    if(target<0){ sign_metrics[sm+2]=sign_metrics[sm+2]+1; if(pred<0){ sign_metrics[sm+3]=sign_metrics[sm+3]+1; } }
                    if(no_unique==1){ if(pred<0){ arm_reached[arm]=1; }
                    }else{ if(pred>=0 && terminal_records[tr+34+top]==1000){ arm_reached[arm]=1; } }
                    cap=cap+1;
                }
                dose=dose+1;
            }
            t=t+1;
        }
        if(no_unique==1){ if(base_reached==1){ base_no_unique.*=base_no_unique.*+1; }
        }else{ if(base_reached==1){ base_known.*=base_known.*+1; } }
        let arm:i32=0;
        while(arm<E51M_ARMS){
            if(arm_reached[arm]==1){ if(no_unique==1){ no_unique_reach[arm]=no_unique_reach[arm]+1; }else{ known_reach[arm]=known_reach[arm]+1; } }
            arm=arm+1;
        }
        episode=episode+1;
    }
    zfree(scores); zfree(arm_reached);
}

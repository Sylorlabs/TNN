        }
        targets[record_number]=target;
        record_number=record_number+1;
    }
    zfree(scores);
}

fn e51m_scalar_column(records:[]i32,record_start:i32,column:i32)i32 {
    if(column==0){ return 1000; }
    return e51m_feature_value(records,record_start,column-1);
}

fn e51m_scalar_statistics(
    records:[]i32,
    targets:[]i32,
    count:i32,
    reverse:i32,
    gram:[]i32,
    cross:[]i32,
    stats_hash:*i32
)void {
    e45_zero(gram,E51M_SCALAR_GRAM);
    e45_zero(cross,E51M_SCALAR_COLUMNS);
    stats_hash.*=313+count/17;
    let traversal:i32=0;
    while(traversal<count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=count-1-traversal; }
        let record_start:i32=record_number*E50_RECORD_N;
        let row:i32=0;
        while(row<E51M_SCALAR_COLUMNS){
            let row_value:i64=e51m_scalar_column(records,record_start,row) as i64;
            cross[row]=cross[row]+e50_signed_div_i64(row_value*(targets[record_number] as i64),1000) as i32;
            let column:i32=row;
            while(column<E51M_SCALAR_COLUMNS){
                let column_value:i64=e51m_scalar_column(records,record_start,column) as i64;
                let contribution:i32=e50_signed_div_i64(row_value*column_value,1000) as i32;
                gram[row*E51M_SCALAR_COLUMNS+column]=gram[row*E51M_SCALAR_COLUMNS+column]+contribution;
                if(column!=row){
                    gram[column*E51M_SCALAR_COLUMNS+row]=gram[column*E51M_SCALAR_COLUMNS+row]+contribution;
                }
                column=column+1;
            }
            row=row+1;
        }
        traversal=traversal+1;
    }
    let i:i32=0;
    while(i<E51M_SCALAR_GRAM){ stats_hash.*=e46_hash_update(stats_hash.*,gram[i]); i=i+1; }
    i=0;
    while(i<E51M_SCALAR_COLUMNS){ stats_hash.*=e46_hash_update(stats_hash.*,cross[i]); i=i+1; }
}

fn e51m_scalar_raw_prediction(
    records:[]i32,
    record_start:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32,
    means:[]i32,
    mean_start:i32,
    hinge_features:[]i32,
    hinge_directions:[]i32,
    hinge_coefficients:[]i32,
    hinge_start:i32,
    hinge_count:i32
)i32 {
    let raw:i32=e51m_linear_raw(records,record_start,weights,weight_start,bias);
    let term:i32=0;
    while(term<hinge_count){
        let feature:i32=hinge_features[hinge_start+term];
        let basis:i32=0;
        let value:i32=e51m_feature_value(records,record_start,feature);
        if(hinge_directions[hinge_start+term]==0){
            if(value>means[mean_start+feature]){ basis=value-means[mean_start+feature]; }
        }else{
            if(value<means[mean_start+feature]){ basis=means[mean_start+feature]-value; }
        }
        raw=raw+hinge_coefficients[hinge_start+term]*basis/1000;
        term=term+1;
    }
    return raw;
}

fn e51m_scalar_loss(
    records:[]i32,
    targets:[]i32,
    count:i32,
    reverse:i32,
    weights:[]i32,
    weight_start:i32,
    bias:i32,
    means:[]i32,
    mean_start:i32,
    hinge_features:[]i32,
    hinge_directions:[]i32,
    hinge_coefficients:[]i32,
    hinge_start:i32,
    hinge_count:i32
)i64 {
    let loss:i64=0;
    let traversal:i32=0;
    while(traversal<count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=count-1-traversal; }
        let record_start:i32=record_number*E50_RECORD_N;
        let raw:i32=e51m_scalar_raw_prediction(
            records,record_start,weights,weight_start,bias,means,mean_start,
            hinge_features,hinge_directions,hinge_coefficients,hinge_start,hinge_count
        );
        let predicted:i32=r32e45_clamp(raw,-4000,4000);
        let residual:i32=r32e45_clamp(targets[record_number]-predicted,-3000,3000);
        loss=loss+(residual as i64)*(residual as i64);
        traversal=traversal+1;
    }
    return loss;
}

fn e51m_scalar_fit(
    records:[]i32,
    targets:[]i32,
    count:i32,
    reverse:i32,
    gram:[]i32,
    cross:[]i32,
    weights:[]i32,
    bias:*i32,
    backup_weights:[]i32,
    accepted_steps:*i32,
    stop_reason:*i32,
    trace_hash:*i32,
    final_loss_low:*i32,
    final_loss_high:*i32
)void {
    e45_zero(weights,E45_FEATURES);
    e45_zero(backup_weights,E45_FEATURES);
    bias.*=0;
    accepted_steps.*=0;
    stop_reason.*=3;
    trace_hash.*=401+count/17;
    let empty_means:[]i32=zalloc_i(E45_FEATURES);
    let empty_features:[]i32=zalloc_i(E51M_HINGE_MAX);
    let empty_directions:[]i32=zalloc_i(E51M_HINGE_MAX);
    let empty_coefficients:[]i32=zalloc_i(E51M_HINGE_MAX);
    let current_loss:i64=e51m_scalar_loss(
        records,targets,count,reverse,weights,0,bias.*,empty_means,0,
        empty_features,empty_directions,empty_coefficients,0,0
    );
    trace_hash.*=e50_hash_loss(trace_hash.*,current_loss);
    let sweep:i32=0;
    let stopped:i32=0;
    while(sweep<E50_BATCH_MAX_STEPS && stopped==0){
        let feature:i32=0;
        while(feature<E45_FEATURES){ backup_weights[feature]=weights[feature]; feature=feature+1; }
        let backup_bias:i32=bias.*;
        let changed:i32=0;
        let column:i32=0;
        while(column<E51M_SCALAR_COLUMNS){
            let diagonal:i32=gram[column*E51M_SCALAR_COLUMNS+column];
            let current:i32=bias.*;
            if(column>0){ current=weights[column-1]; }
            let candidate:i32=0;
            if(diagonal>0){
                let weighted_sum:i64=0;
                let other:i32=0;
                while(other<E51M_SCALAR_COLUMNS){
                    if(other!=column){
                        let parameter:i32=bias.*;
                        if(other>0){ parameter=weights[other-1]; }
                        weighted_sum=weighted_sum+(gram[column*E51M_SCALAR_COLUMNS+other] as i64)*(parameter as i64);
                    }
                    other=other+1;
                }
                let numerator:i64=(cross[column] as i64)*1000-weighted_sum;
                candidate=e50_round_nearest_i64(numerator,diagonal as i64) as i32;
                if(column==0){ candidate=r32e45_clamp(candidate,-4000,4000);
                }else{ candidate=r32e45_clamp(candidate,-16000,16000); }
            }
            if(candidate!=current){ changed=1; }
            if(column==0){ bias.*=candidate; }else{ weights[column-1]=candidate; }
            column=column+1;
        }
        if(changed==0){
            stop_reason.*=1;
            stopped=1;
        }else{
            let candidate_loss:i64=e51m_scalar_loss(
                records,targets,count,reverse,weights,0,bias.*,empty_means,0,
                empty_features,empty_directions,empty_coefficients,0,0
            );
            if(candidate_loss<current_loss){
                current_loss=candidate_loss;
                accepted_steps.*=accepted_steps.*+1;
                trace_hash.*=e50_hash_loss(trace_hash.*,current_loss);
            }else{
                feature=0;
                while(feature<E45_FEATURES){ weights[feature]=backup_weights[feature]; feature=feature+1; }
                bias.*=backup_bias;
                stop_reason.*=2;
                stopped=1;

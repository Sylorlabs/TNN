    // E51M runs only after the frozen E50 parent integrity contract passes.
    let e51m_parent_integrity_gate:i32=0;
    if(seed_preflight_gate==1 && aux_clone_gate==1 && canonical_sample_count==E50_TERMINAL_SAMPLES && batch_bound_gate==1 && unknown_target_nonzero==0 && train_lattice_gate==1 && train_rep_gate==1 && batch_statistics_gate==1 && batch_identity_gate==1 && batch_converge_gate==1 && aux_frozen_gate==1){
        e51m_parent_integrity_gate=1;
    }
    e45_print_pair("e51m_parent_e50_integrity_gate",e51m_parent_integrity_gate);
    let e51m_completion:i32=0;
    if(e51m_parent_integrity_gate==1){
        e51m_completion=e51m_run(
            raw_seen,evidence_seen,resource_seen,
            frozen_source,frozen_dependence,frozen_consequence,frozen_hazard,
            frozen_shadow,frozen_shadow_bias
        );
    }else{
        _zag_println("e51m_outcome,PARENT_E50_INTEGRITY_FAILED");
        _zag_println("TNN_R32_E51M_EXECUTION_COMPLETE=0");
    }
    if(e51m_completion==1){ return 0; }
    return 1;

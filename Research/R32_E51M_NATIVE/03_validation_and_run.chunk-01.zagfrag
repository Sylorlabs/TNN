    );
    e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_copy(states,live_state,E45_STATE_N);
    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
        e45_terminal_projection(option,terminal_option);
        e45_fill_full_features(
            states,t*E45_STATE_N,terminal_option,0,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,full_features
        );
        e45_mask_features(full_features,E45_ARM_D,baseline_features);
        let co_viability:i32=0; let contradiction_co_mass:i32=0;
        e47_terminal_representation(states,t*E45_STATE_N,terminal_option,0,&co_viability,&contradiction_co_mass);
        e50_build_model_features(baseline_features,0,co_viability,contradiction_co_mass,0,model_features,0);
        let top_action:i32=e51m_top_commit(model_features,0,terminal_weights,terminal_biases,scores);
        let top_score:i32=scores[top_action];
        let grounded:i32=e45_terminal_value(top_action,states,t*E45_STATE_N,initial_state,truth_state[t]);
        let arm:i32=0;
        while(arm<E51M_ARMS){
            let predicted:i32=top_score;
            if(arm>0){
                let slot:i32=arm-1;
                let dose:i32=slot/E51M_CAPS;
                let cap:i32=slot-dose*E51M_CAPS;
                let used:i32=e51m_cap_terms(cap);
                if(used>term_counts[dose]){ used=term_counts[dose]; }
                predicted=e51m_scalar_hinge_predict_record(
                    model_features,0,
                    linear_weights,dose*E45_FEATURES,linear_biases[dose],
                    means,dose*E45_FEATURES,
                    term_features,term_directions,term_coefficients,
                    dose*E51M_MAX_HINGES,used
                );
            }
            let choice:i32=R32E45_TERM_UNKNOWN;
            if(predicted>=0){ choice=top_action; }
            let success:i32=0;
            if(truth_state[t]<0){
                if(choice==R32E45_TERM_UNKNOWN){ success=1; }
            }else{
                if(choice!=R32E45_TERM_UNKNOWN && grounded==1000){ success=1; }
            }
            if(success==1){ reached[arm]=1; }
            if(grounded>0){
                validation_positive_total[arm]=validation_positive_total[arm]+1;
                if(predicted>=0){ validation_positive_correct[arm]=validation_positive_correct[arm]+1; }
            }
            if(grounded<0){
                validation_negative_total[arm]=validation_negative_total[arm]+1;
                if(predicted<0){ validation_negative_correct[arm]=validation_negative_correct[arm]+1; }
            }
            arm=arm+1;
        }
        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0;
            while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }
    let arm:i32=0;
    if(truth_state[0]<0){
        no_unique_episodes.*=no_unique_episodes.*+1;
        while(arm<E51M_ARMS){
            if(reached[arm]==1){ no_unique_reachable[arm]=no_unique_reachable[arm]+1; }
            arm=arm+1;
        }
    }else{
        known_episodes.*=known_episodes.*+1;
        while(arm<E51M_ARMS){
            if(reached[arm]==1){ known_reachable[arm]=known_reachable[arm]+1; }
            arm=arm+1;
        }
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(option); zfree(terminal_option); zfree(full_features); zfree(baseline_features);
    zfree(model_features); zfree(scores); zfree(reached);
}

fn e51m_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51M_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51m_calibration_dose_capacity_curve_v1");
    _zag_println("native_language,zag_v2");
    _zag_println("canonical_status,R27_UNCHANGED");
    _zag_println("learner_visible_features,32");
    _zag_println("base_terminal_ranking,frozen_after_1x_development_prefix");
    _zag_println("unknown_score,0");
    _zag_println("unknown_positive_target,0");
    _zag_println("evaluator_truth_as_input,0");
    _zag_println("ambiguity_label_as_input,0");
    _zag_println("stage_or_seed_as_input,0");

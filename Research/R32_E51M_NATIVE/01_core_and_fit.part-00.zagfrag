// R32 E51M — native Zag v2 calibration dose × boundary-capacity experiment.
// The learner-visible state, frozen terminal ordering head, and grounded
// consequence target are held fixed. Only development dose and learner-owned
// scalar decision-boundary capacity vary.

const E51M_MAX_DEV_EPISODES:i32=12960;
const E51M_BASE_DEV_EPISODES:i32=3240;
const E51M_VALIDATION_EPISODES:i32=5400;
const E51M_CONFIRM_EPISODES:i32=10800;
const E51M_STATES_PER_EPISODE:i32=E45_TAPE+1;
const E51M_BASE_SAMPLES:i32=E51M_BASE_DEV_EPISODES*E51M_STATES_PER_EPISODE;
const E51M_MAX_SAMPLES:i32=E51M_MAX_DEV_EPISODES*E51M_STATES_PER_EPISODE;
const E51M_CAL_RECORD_N:i32=E45_FEATURES+1;
const E51M_CAL_TARGET:i32=E45_FEATURES;
const E51M_DOSES:i32=3;
const E51M_CAPS:i32=4;
const E51M_MAX_HINGES:i32=16;
const E51M_ARMS:i32=1+E51M_DOSES*E51M_CAPS;
const E51M_SCALAR_COLUMNS:i32=E45_FEATURES+1;
const E51M_SCALAR_GRAM:i32=E51M_SCALAR_COLUMNS*E51M_SCALAR_COLUMNS;
const E51M_SCALAR_MAX_STEPS:i32=1024;
const E51M_STAGE_DEV:i32=52;
const E51M_STAGE_VALIDATION:i32=53;
const E51M_STAGE_CONFIRM:i32=54;

fn e51m_dev_index(
    epoch:i32,
    base_index:i32,
    mode:i32,
    resource:i32,
    episode:i32
)i32 {
    return ((((epoch*3+base_index)*E45_MODES+mode)*E45_RESOURCES+resource)*12)+episode;
}

fn e51m_dose_episodes(dose:i32)i32 {
    if(dose==0){ return 3240; }
    if(dose==1){ return 6480; }
    return 12960;
}

fn e51m_dose_samples(dose:i32)i32 {
    return e51m_dose_episodes(dose)*E51M_STATES_PER_EPISODE;
}

fn e51m_cap_terms(cap:i32)i32 {
    if(cap==0){ return 0; }
    if(cap==1){ return 4; }
    if(cap==2){ return 8; }
    return 16;
}

fn e51m_arm_index(dose:i32,cap:i32)i32 {
    return 1+dose*E51M_CAPS+cap;
}

fn e51m_print_seed_row(
    stage:i32,
    epoch:i32,
    base_index:i32,
    mode:i32,
    resource:i32,
    episode:i32,
    seed:i32
)void {
    _zag_print("e51m_seed_manifest,");
    e45_print_i32(stage); _zag_print(",");
    e45_print_i32(epoch); _zag_print(",");
    e45_print_i32(base_index); _zag_print(",");
    e45_print_i32(mode); _zag_print(",");
    e45_print_i32(resource); _zag_print(",");
    e45_print_i32(episode); _zag_print(",");
    e45_print_i32(seed); _zag_println("");
}

fn e51m_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    dev_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32
)i32 {
    e45_zero(dev_seeds,E51M_MAX_DEV_EPISODES);
    e45_zero(validation_seeds,E51M_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E51M_CONFIRM_EPISODES);
    _zag_println("e51m_seed_manifest_columns,stage_52_development_53_validation_54_sealed_confirmation,epoch,base_index,mode,resource,episode,seed");
    let failures:i32=0;
    let emitted:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e51m_dev_index(epoch,base_index,mode,resource,episode);
                        let seed:i32=e46_assign_fresh_seed(
                            raw_seen,evidence_seen,resource_seen,
                            E51M_STAGE_DEV,index,mode,resource,&failures
                        );
                        dev_seeds[index]=seed;
                        e51m_print_seed_row(E51M_STAGE_DEV,epoch,base_index,mode,resource,episode,seed);
                        emitted=emitted+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(
                        raw_seen,evidence_seen,resource_seen,
                        E51M_STAGE_VALIDATION,index,mode,resource,&failures
                    );
                    validation_seeds[index]=seed;
                    e51m_print_seed_row(E51M_STAGE_VALIDATION,0,base_index,mode,resource,episode,seed);
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<40){
                    let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                    // Confirmation is allocated but sealed. The legacy effective-state
                    // allocator has a finite 1,000,003-state namespace and is already
                    // close to saturation after prior experiments plus E51M development
                    // and validation. Use a separate non-executed nominal namespace here;
                    // an exact validation rescue must preregister an expanded executable
                    // confirmation RNG namespace before these IDs can be opened.
                    let seed:i32=1000003+index+1;
                    confirmation_seeds[index]=seed;
                    e51m_print_seed_row(E51M_STAGE_CONFIRM,0,base_index,mode,resource,episode,seed);
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51m_seed_manifest_emitted",emitted);
    e45_print_pair("e51m_seed_assignment_failures",failures);
    e45_print_pair("e51m_max_development_episodes_allocated",E51M_MAX_DEV_EPISODES);
    e45_print_pair("e51m_validation_episodes_allocated",E51M_VALIDATION_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_allocated",E51M_CONFIRM_EPISODES);
    e45_print_pair("e51m_sealed_confirmation_nominal_namespace",1);
    e45_print_pair("e51m_sealed_confirmation_effective_streams_reserved",0);
    e45_print_pair("e51m_sealed_confirmation_executed",0);
    if(failures==0 && emitted==E51M_MAX_DEV_EPISODES+E51M_VALIDATION_EPISODES+E51M_CONFIRM_EPISODES){
        return 1;
    }
    return 0;
}

fn e51m_build_base_episode(
    seed:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    canonical_episode:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    base_records:[]i32,
    unknown_target_nonzero:*i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);

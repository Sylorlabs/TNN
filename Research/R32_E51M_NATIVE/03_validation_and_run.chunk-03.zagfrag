    let linear_reverse_biases:[]i32=zalloc_i(E51M_DOSES);
    let means_forward:[]i32=zalloc_i(E51M_DOSES*E45_FEATURES);
    let means_reverse:[]i32=zalloc_i(E51M_DOSES*E45_FEATURES);
    let term_features_forward:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let term_features_reverse:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let term_directions_forward:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let term_directions_reverse:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let term_coefficients_forward:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let term_coefficients_reverse:[]i32=zalloc_i(E51M_DOSES*E51M_MAX_HINGES);
    let term_counts_forward:[]i32=zalloc_i(E51M_DOSES);
    let term_counts_reverse:[]i32=zalloc_i(E51M_DOSES);
    let dose_gates:[]i32=zalloc_i(E51M_DOSES);
    e45_zero(linear_forward_weights,E51M_DOSES*E45_FEATURES); e45_zero(linear_reverse_weights,E51M_DOSES*E45_FEATURES);
    e45_zero(linear_forward_biases,E51M_DOSES); e45_zero(linear_reverse_biases,E51M_DOSES);
    e45_zero(means_forward,E51M_DOSES*E45_FEATURES); e45_zero(means_reverse,E51M_DOSES*E45_FEATURES);
    e45_zero(term_features_forward,E51M_DOSES*E51M_MAX_HINGES); e45_zero(term_features_reverse,E51M_DOSES*E51M_MAX_HINGES);
    e45_zero(term_directions_forward,E51M_DOSES*E51M_MAX_HINGES); e45_zero(term_directions_reverse,E51M_DOSES*E51M_MAX_HINGES);
    e45_zero(term_coefficients_forward,E51M_DOSES*E51M_MAX_HINGES); e45_zero(term_coefficients_reverse,E51M_DOSES*E51M_MAX_HINGES);
    e45_zero(term_counts_forward,E51M_DOSES); e45_zero(term_counts_reverse,E51M_DOSES); e45_zero(dose_gates,E51M_DOSES);

    let dose:i32=0;
    while(dose<E51M_DOSES){
        let sample_count:i32=e51m_dose_samples(dose);
        let count_forward:i32=0; let count_reverse:i32=0;
        let stats_hash_forward:i32=811+dose; let stats_hash_reverse:i32=811+dose;
        e51m_build_scalar_statistics(calibration_records,sample_count,0,gram_forward,cross_forward,&count_forward,&stats_hash_forward);
        e51m_build_scalar_statistics(calibration_records,sample_count,1,gram_reverse,cross_reverse,&count_reverse,&stats_hash_reverse);
        let stats_gate:i32=1;
        if(count_forward!=sample_count || count_reverse!=sample_count || stats_hash_forward!=stats_hash_reverse || e51m_scalar_statistics_equal(gram_forward,gram_reverse,cross_forward,cross_reverse)==0){ stats_gate=0; }
        let steps_forward:i32=0; let reason_forward:i32=0; let trace_forward:i32=0; let low_forward:i32=0; let high_forward:i32=0;
        let steps_reverse:i32=0; let reason_reverse:i32=0; let trace_reverse:i32=0; let low_reverse:i32=0; let high_reverse:i32=0;
        e51m_scalar_fit(
            calibration_records,sample_count,gram_forward,cross_forward,
            linear_forward_weights,dose*E45_FEATURES,&linear_forward_biases[dose],backup_weights,
            &steps_forward,&reason_forward,&trace_forward,&low_forward,&high_forward
        );
        e51m_scalar_fit(
            calibration_records,sample_count,gram_reverse,cross_reverse,
            linear_reverse_weights,dose*E45_FEATURES,&linear_reverse_biases[dose],backup_weights,
            &steps_reverse,&reason_reverse,&trace_reverse,&low_reverse,&high_reverse
        );
        let scalar_gate:i32=e51m_compare_scalar_models(
            linear_forward_weights,linear_reverse_weights,dose*E45_FEATURES,
            linear_forward_biases[dose],linear_reverse_biases[dose]
        );
        if(steps_forward<=0 || steps_forward!=steps_reverse || reason_forward!=reason_reverse || reason_forward==3 || trace_forward!=trace_reverse || low_forward!=low_reverse || high_forward!=high_reverse){ scalar_gate=0; }
        let mean_hash_forward:i32=907+dose; let mean_hash_reverse:i32=907+dose;
        e51m_compute_feature_means(calibration_records,sample_count,0,means_forward,dose*E45_FEATURES,&mean_hash_forward);
        e51m_compute_feature_means(calibration_records,sample_count,1,means_reverse,dose*E45_FEATURES,&mean_hash_reverse);
        let hinge_reason_forward:i32=0; let hinge_trace_forward:i32=0; let hinge_low_forward:i32=0; let hinge_high_forward:i32=0;
        let hinge_reason_reverse:i32=0; let hinge_trace_reverse:i32=0; let hinge_low_reverse:i32=0; let hinge_high_reverse:i32=0;
        e51m_hinge_search(
            calibration_records,sample_count,0,
            linear_forward_weights,dose*E45_FEATURES,linear_forward_biases[dose],
            means_forward,dose*E45_FEATURES,
            term_features_forward,term_directions_forward,term_coefficients_forward,
            dose*E51M_MAX_HINGES,&term_counts_forward[dose],
            &hinge_reason_forward,&hinge_trace_forward,&hinge_low_forward,&hinge_high_forward
        );
        e51m_hinge_search(
            calibration_records,sample_count,1,
            linear_reverse_weights,dose*E45_FEATURES,linear_reverse_biases[dose],
            means_reverse,dose*E45_FEATURES,
            term_features_reverse,term_directions_reverse,term_coefficients_reverse,

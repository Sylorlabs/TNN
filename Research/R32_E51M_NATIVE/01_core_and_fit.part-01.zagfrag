    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_zero(option,E45_OPTION_N);
    option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_copy(states,live_state,E45_STATE_N);
    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
        e45_terminal_projection(option,terminal_option);
        e45_fill_full_features(
            states,t*E45_STATE_N,terminal_option,0,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,full_features
        );
        e45_mask_features(full_features,E45_ARM_D,baseline_features);
        let co_viability:i32=0;
        let contradiction_co_mass:i32=0;
        e47_terminal_representation(
            states,t*E45_STATE_N,terminal_option,0,
            &co_viability,&contradiction_co_mass
        );
        let record_number:i32=canonical_episode*E51M_STATES_PER_EPISODE+t;
        let record_start:i32=record_number*E50_RECORD_N;
        let feature:i32=0;
        while(feature<E45_FEATURES){
            base_records[record_start+feature]=baseline_features[feature];
            feature=feature+1;
        }
        base_records[record_start+32]=co_viability;
        base_records[record_start+33]=contradiction_co_mass;
        let action:i32=0;
        while(action<4){
            let target:i32=e45_terminal_value(action,states,t*E45_STATE_N,initial_state,truth_state[t]);
            base_records[record_start+34+action]=target;
            if(action==R32E45_TERM_UNKNOWN && target!=0){
                unknown_target_nonzero.*=unknown_target_nonzero.*+1;
            }
            action=action+1;
        }
        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0;
            while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(option); zfree(terminal_option); zfree(full_features); zfree(baseline_features);
}

fn e51m_fit_base_terminal(
    base_records:[]i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32
)i32 {
    let gram_forward:[]i32=zalloc_i(E50_BATCH_GRAM);
    let gram_reverse:[]i32=zalloc_i(E50_BATCH_GRAM);
    let cross_forward:[]i32=zalloc_i(E50_BATCH_CROSS);
    let cross_reverse:[]i32=zalloc_i(E50_BATCH_CROSS);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let backup_biases:[]i32=zalloc_i(4);
    let forward_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let forward_biases:[]i32=zalloc_i(4);
    e45_zero(terminal_weights,4*E45_FEATURES); e45_zero(terminal_biases,4);
    e45_zero(forward_weights,4*E45_FEATURES); e45_zero(forward_biases,4);
    let count_forward:i32=0; let count_reverse:i32=0;
    let hash_forward:i32=521; let hash_reverse:i32=521;
    e50_build_batch_statistics(base_records,0,0,gram_forward,cross_forward,&count_forward,&hash_forward);
    e50_build_batch_statistics(base_records,0,1,gram_reverse,cross_reverse,&count_reverse,&hash_reverse);
    let gate:i32=1;
    if(count_forward!=E51M_BASE_SAMPLES || count_reverse!=E51M_BASE_SAMPLES){ gate=0; }
    if(hash_forward!=hash_reverse || e50_batch_statistics_equal(gram_forward,gram_reverse,cross_forward,cross_reverse)==0){ gate=0; }
    let steps_forward:i32=0; let reason_forward:i32=0; let trace_forward:i32=0;
    let loss_low_forward:i32=0; let loss_high_forward:i32=0;
    e50_batch_fit(
        base_records,0,0,gram_forward,cross_forward,
        terminal_weights,terminal_biases,backup_weights,backup_biases,
        &steps_forward,&reason_forward,&trace_forward,&loss_low_forward,&loss_high_forward
    );
    let i:i32=0;
    while(i<4*E45_FEATURES){ forward_weights[i]=terminal_weights[i]; i=i+1; }
    i=0; while(i<4){ forward_biases[i]=terminal_biases[i]; i=i+1; }
    e45_zero(terminal_weights,4*E45_FEATURES); e45_zero(terminal_biases,4);
    let steps_reverse:i32=0; let reason_reverse:i32=0; let trace_reverse:i32=0;
    let loss_low_reverse:i32=0; let loss_high_reverse:i32=0;
    e50_batch_fit(
        base_records,0,0,gram_reverse,cross_reverse,
        terminal_weights,terminal_biases,backup_weights,backup_biases,
        &steps_reverse,&reason_reverse,&trace_reverse,&loss_low_reverse,&loss_high_reverse
    );
    i=0;
    while(i<4*E45_FEATURES){
        if(terminal_weights[i]!=forward_weights[i]){ gate=0; }
        terminal_weights[i]=forward_weights[i];
        i=i+1;
    }
    i=0;
    while(i<4){
        if(terminal_biases[i]!=forward_biases[i]){ gate=0; }
        terminal_biases[i]=forward_biases[i];
        i=i+1;
    }
    if(steps_forward<=0 || steps_forward!=steps_reverse || reason_forward!=reason_reverse || reason_forward==3 || trace_forward!=trace_reverse || loss_low_forward!=loss_low_reverse || loss_high_forward!=loss_high_reverse){ gate=0; }
    let unknown_nonzero:i32=0;
    if(terminal_biases[R32E45_TERM_UNKNOWN]!=0){ unknown_nonzero=unknown_nonzero+1; }
    i=0;
    while(i<E45_FEATURES){

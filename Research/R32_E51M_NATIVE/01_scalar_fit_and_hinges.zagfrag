// R32 E51M — deterministic scalar calibration dose/capacity learner.
// Native Zag v2 only. This layer consumes only the existing learner-visible
// terminal features plus consequence-derived scalar sign targets. It never
// consumes evaluator mode, ambiguity membership, seed identity, or stage labels.

const E51M_DEV1_EPISODES:i32=3240;
const E51M_DEV2_EPISODES:i32=6480;
const E51M_DEV4_EPISODES:i32=12960;
const E51M_VALIDATION_EPISODES:i32=5400;
const E51M_CONFIRM_EPISODES:i32=10800;
const E51M_DEV1_SAMPLES:i32=55080;
const E51M_DEV2_SAMPLES:i32=110160;
const E51M_DEV4_SAMPLES:i32=220320;
const E51M_VALIDATION_SAMPLES:i32=91800;
const E51M_CONFIRM_SAMPLES:i32=183600;
const E51M_SCALAR_COLUMNS:i32=33;
const E51M_DOSES:i32=3;
const E51M_CAPS:i32=4;
const E51M_ARMS:i32=12;
const E51M_HINGE_MAX:i32=16;
const E51M_HINGE_CANDIDATES:i32=64;
const E51M_FIT_SWEEPS:i32=16;
const E51M_BACKOFFS:i32=8;

fn e51m_dev_index(
    epoch:i32,
    base_index:i32,
    mode:i32,
    resource:i32,
    episode:i32
)i32 {
    return ((((epoch*3+base_index)*E45_MODES+mode)*E45_RESOURCES+resource)*12)+episode;
}

fn e51m_feature_value(records:[]i32,record_start:i32,feature:i32)i32 {
    if(feature==3){ return records[record_start+32]; }
    if(feature==5){ return records[record_start+33]; }
    return records[record_start+feature];
}

fn e51m_column_value(records:[]i32,record_start:i32,column:i32)i32 {
    if(column==0){ return 1000; }
    return e51m_feature_value(records,record_start,column-1);
}

fn e51m_linear_predict(records:[]i32,record_start:i32,params:[]i32,param_start:i32)i32 {
    let value:i32=params[param_start];
    let feature:i32=0;
    while(feature<E45_FEATURES){
        value=value+params[param_start+1+feature]*e51m_feature_value(records,record_start,feature)/1000;
        feature=feature+1;
    }
    return value;
}

fn e51m_hinge_value(value:i32,mean:i32,direction:i32)i32 {
    if(direction==0){ return r32e45_max(0,value-mean); }
    return r32e45_max(0,mean-value);
}

fn e51m_predict(
    records:[]i32,
    record_start:i32,
    linear_params:[]i32,
    linear_start:i32,
    hinge_feature:[]i32,
    hinge_direction:[]i32,
    hinge_coefficient:[]i32,
    hinge_start:i32,
    hinge_count:i32,
    means:[]i32,
    mean_start:i32
)i32 {
    let value:i32=e51m_linear_predict(records,record_start,linear_params,linear_start);
    let term:i32=0;
    while(term<hinge_count){
        let feature:i32=hinge_feature[hinge_start+term];
        let direction:i32=hinge_direction[hinge_start+term];
        let h:i32=e51m_hinge_value(
            e51m_feature_value(records,record_start,feature),
            means[mean_start+feature],direction
        );
        value=value+hinge_coefficient[hinge_start+term]*h/1000;
        term=term+1;
    }
    return value;
}

fn e51m_params_equal(a:[]i32,a_start:i32,b:[]i32,b_start:i32,count:i32)i32 {
    let i:i32=0;
    while(i<count){
        if(a[a_start+i]!=b[b_start+i]){ return 0; }
        i=i+1;
    }
    return 1;
}

fn e51m_fit_once(
    records:[]i32,
    targets:[]i32,
    sample_count:i32,
    reverse:i32,
    params:[]i32,
    accepted_steps:*i32,
    trace_hash:*i32
)i64 {
    e45_zero(params,E51M_SCALAR_COLUMNS);
    accepted_steps.*=0;
    trace_hash.*=911;
    let residual:[]i32=zalloc_i(sample_count);
    let candidate_residual:[]i32=zalloc_i(sample_count);
    let loss:i64=0;
    let i:i32=0;
    while(i<sample_count){
        residual[i]=targets[i];
        candidate_residual[i]=targets[i];
        loss=loss+(targets[i] as i64)*(targets[i] as i64);
        i=i+1;
    }

    let sweep:i32=0;
    while(sweep<E51M_FIT_SWEEPS){
        let changed:i32=0;
        let column:i32=0;
        while(column<E51M_SCALAR_COLUMNS){
            let correlation:i64=0;
            let norm:i64=0;
            let traversal:i32=0;
            while(traversal<sample_count){
                let record_number:i32=traversal;
                if(reverse==1){ record_number=sample_count-1-traversal; }
                let x:i32=e51m_column_value(records,record_number*E50_RECORD_N,column);
                correlation=correlation+(x as i64)*(residual[record_number] as i64)/1000;
                norm=norm+(x as i64)*(x as i64)/1000;
                traversal=traversal+1;
            }
            if(norm>0 && correlation!=0){
                let proposal64:i64=correlation*1000/norm;
                let proposal:i32=proposal64 as i32;
                let old_value:i32=params[column];
                let trial_delta:i32=proposal;
                let backoff:i32=0;
                let accepted_here:i32=0;
                while(backoff<E51M_BACKOFFS && trial_delta!=0 && accepted_here==0){
                    let candidate:i32=old_value+trial_delta;
                    if(column==0){ candidate=r32e45_clamp(candidate,-4000,4000);
                    }else{ candidate=r32e45_clamp(candidate,-16000,16000); }
                    let actual_delta:i32=candidate-old_value;
                    if(actual_delta!=0){
                        let candidate_loss:i64=0;
                        traversal=0;
                        while(traversal<sample_count){
                            let record_number:i32=traversal;
                            if(reverse==1){ record_number=sample_count-1-traversal; }
                            let x:i32=e51m_column_value(records,record_number*E50_RECORD_N,column);
                            let next_residual:i32=residual[record_number]-actual_delta*x/1000;
                            candidate_residual[record_number]=next_residual;
                            candidate_loss=candidate_loss+(next_residual as i64)*(next_residual as i64);
                            traversal=traversal+1;
                        }
                        if(candidate_loss<loss){
                            params[column]=candidate;
                            let swap:[]i32=residual;
                            residual=candidate_residual;
                            candidate_residual=swap;
                            loss=candidate_loss;
                            accepted_steps.*=accepted_steps.*+1;
                            trace_hash.*=e46_hash_update(trace_hash.*,column);
                            trace_hash.*=e46_hash_update(trace_hash.*,candidate);
                            changed=1;
                            accepted_here=1;
                        }
                    }
                    if(accepted_here==0){ trial_delta=trial_delta/2; }
                    backoff=backoff+1;
                }
            }
            column=column+1;
        }
        if(changed==0){ sweep=E51M_FIT_SWEEPS;
        }else{ sweep=sweep+1; }
    }
    zfree(residual);
    zfree(candidate_residual);
    return loss;
}

fn e51m_compute_means(
    records:[]i32,
    sample_count:i32,
    reverse:i32,
    means:[]i32
)void {
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let sum:i64=0;
        let traversal:i32=0;
        while(traversal<sample_count){
            let record_number:i32=traversal;
            if(reverse==1){ record_number=sample_count-1-traversal; }
            sum=sum+(e51m_feature_value(records,record_number*E50_RECORD_N,feature) as i64);
            traversal=traversal+1;
        }
        means[feature]=(sum/(sample_count as i64)) as i32;
        feature=feature+1;
    }
}

fn e51m_candidate_selected(
    hinge_feature:[]i32,
    hinge_direction:[]i32,
    accepted:i32,
    feature:i32,
    direction:i32
)i32 {
    let i:i32=0;
    while(i<accepted){
        if(hinge_feature[i]==feature && hinge_direction[i]==direction){ return 1; }
        i=i+1;
    }
    return 0;
}

fn e51m_hinge_search_once(
    records:[]i32,
    targets:[]i32,
    sample_count:i32,
    reverse:i32,
    linear_params:[]i32,
    means:[]i32,
    hinge_feature:[]i32,
    hinge_direction:[]i32,
    hinge_coefficient:[]i32,
    accepted_terms:*i32,
    trace_hash:*i32
)i64 {
    e45_zero(hinge_feature,E51M_HINGE_MAX);
    e45_zero(hinge_direction,E51M_HINGE_MAX);
    e45_zero(hinge_coefficient,E51M_HINGE_MAX);
    accepted_terms.*=0;
    trace_hash.*=1223;
    e51m_compute_means(records,sample_count,reverse,means);

    let residual:[]i32=zalloc_i(sample_count);
    let candidate_residual:[]i32=zalloc_i(sample_count);
    let current_loss:i64=0;
    let traversal:i32=0;
    while(traversal<sample_count){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=sample_count-1-traversal; }
        let prediction:i32=e51m_linear_predict(records,record_number*E50_RECORD_N,linear_params,0);
        let r:i32=targets[record_number]-prediction;
        residual[record_number]=r;
        candidate_residual[record_number]=r;
        current_loss=current_loss+(r as i64)*(r as i64);
        traversal=traversal+1;
    }

    while(accepted_terms.*<E51M_HINGE_MAX){
        let best_candidate:i32=-1;
        let best_coefficient:i32=0;
        let best_estimated:i64=0;
        let candidate:i32=0;
        while(candidate<E51M_HINGE_CANDIDATES){
            let feature:i32=candidate/2;
            let direction:i32=candidate-feature*2;
            if(e51m_candidate_selected(hinge_feature,hinge_direction,accepted_terms.*,feature,direction)==0){
                let correlation:i64=0;
                let norm:i64=0;
                traversal=0;
                while(traversal<sample_count){
                    let record_number:i32=traversal;
                    if(reverse==1){ record_number=sample_count-1-traversal; }
                    let h:i32=e51m_hinge_value(
                        e51m_feature_value(records,record_number*E50_RECORD_N,feature),
                        means[feature],direction
                    );
                    correlation=correlation+(h as i64)*(residual[record_number] as i64)/1000;
                    norm=norm+(h as i64)*(h as i64)/1000;
                    traversal=traversal+1;
                }
                if(norm>0 && correlation!=0){
                    let coefficient64:i64=correlation*1000/norm;
                    let coefficient:i32=r32e45_clamp(coefficient64 as i32,-16000,16000);
                    if(coefficient!=0){
                        let estimated:i64=2*(coefficient as i64)*correlation-
                            (coefficient as i64)*(coefficient as i64)*norm/1000;
                        if(estimated>best_estimated || (estimated==best_estimated && estimated>0 && (best_candidate<0 || candidate<best_candidate))){
                            best_estimated=estimated;
                            best_candidate=candidate;
                            best_coefficient=coefficient;
                        }
                    }
                }
            }
            candidate=candidate+1;
        }
        if(best_candidate<0 || best_estimated<=0){
            accepted_terms.*=accepted_terms.*;
            break;
        }
        let best_feature:i32=best_candidate/2;
        let best_direction:i32=best_candidate-best_feature*2;
        let candidate_loss:i64=0;
        traversal=0;
        while(traversal<sample_count){
            let record_number:i32=traversal;
            if(reverse==1){ record_number=sample_count-1-traversal; }
            let h:i32=e51m_hinge_value(
                e51m_feature_value(records,record_number*E50_RECORD_N,best_feature),
                means[best_feature],best_direction
            );
            let next_residual:i32=residual[record_number]-best_coefficient*h/1000;
            candidate_residual[record_number]=next_residual;
            candidate_loss=candidate_loss+(next_residual as i64)*(next_residual as i64);
            traversal=traversal+1;
        }
        if(candidate_loss>=current_loss){
            break;
        }
        let slot:i32=accepted_terms.*;
        hinge_feature[slot]=best_feature;
        hinge_direction[slot]=best_direction;
        hinge_coefficient[slot]=best_coefficient;
        accepted_terms.*=accepted_terms.*+1;
        trace_hash.*=e46_hash_update(trace_hash.*,best_candidate);
        trace_hash.*=e46_hash_update(trace_hash.*,best_coefficient);
        let swap:[]i32=residual;
        residual=candidate_residual;
        candidate_residual=swap;
        current_loss=candidate_loss;
    }

    zfree(residual);
    zfree(candidate_residual);
    return current_loss;
}

fn e51m_cap_value(cap_index:i32)i32 {
    if(cap_index==0){ return 0; }
    if(cap_index==1){ return 4; }
    if(cap_index==2){ return 8; }
    return 16;
}

fn e51m_dose_samples(dose:i32)i32 {
    if(dose==0){ return E51M_DEV1_SAMPLES; }
    if(dose==1){ return E51M_DEV2_SAMPLES; }
    return E51M_DEV4_SAMPLES;
}

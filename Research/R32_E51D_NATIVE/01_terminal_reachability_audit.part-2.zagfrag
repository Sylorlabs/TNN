        aggregate[a+E51D_A_UNKNOWN_TIMES]=aggregate[a+E51D_A_UNKNOWN_TIMES]+unknown_times[model];
        aggregate[a+E51D_A_CORRECT_TIMES]=aggregate[a+E51D_A_CORRECT_TIMES]+correct_times[model];
        if(baseline_choice[model]==R32E45_TERM_UNKNOWN){ aggregate[a+E51D_A_BASELINE_UNKNOWN]=aggregate[a+E51D_A_BASELINE_UNKNOWN]+1; }
        if(best_choice[model]==R32E45_TERM_UNKNOWN){ aggregate[a+E51D_A_ORACLE_UNKNOWN]=aggregate[a+E51D_A_ORACLE_UNKNOWN]+1; }
        if(episode_no_unique==1){
            if(unknown_times[model]>0){ aggregate[a+E51D_A_NO_UNIQUE_UNKNOWN_REACHABLE]=aggregate[a+E51D_A_NO_UNIQUE_UNKNOWN_REACHABLE]+1;
            }else{ aggregate[a+E51D_A_NO_UNIQUE_NEVER_UNKNOWN]=aggregate[a+E51D_A_NO_UNIQUE_NEVER_UNKNOWN]+1; }
        }else{
            if(reachable_success[model]==1){ aggregate[a+E51D_A_KNOWN_CORRECT_REACHABLE]=aggregate[a+E51D_A_KNOWN_CORRECT_REACHABLE]+1;
            }else{ aggregate[a+E51D_A_KNOWN_NEVER_CORRECT]=aggregate[a+E51D_A_KNOWN_NEVER_CORRECT]+1; }
        }
        stop_histogram[model*(E45_TAPE+1)+best_stop[model]]=stop_histogram[model*(E45_TAPE+1)+best_stop[model]]+1;
        let cell:i32=e51d_cell_offset(model,base_index,evaluator_mode,evaluator_resource);
        cell_metrics[cell]=cell_metrics[cell]+1;
        if(episode_no_unique==1){
            cell_metrics[cell+1]=cell_metrics[cell+1]+1;
            cell_metrics[cell+2]=cell_metrics[cell+2]+reachable_success[model];
            cell_metrics[cell+3]=cell_metrics[cell+3]+best_success[model];
        }else{
            cell_metrics[cell+4]=cell_metrics[cell+4]+1;
            cell_metrics[cell+5]=cell_metrics[cell+5]+reachable_success[model];
            cell_metrics[cell+6]=cell_metrics[cell+6]+best_success[model];
        }
        cell_metrics[cell+7]=cell_metrics[cell+7]+baseline_success[model];
        model=model+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(losses); zfree(feasible); zfree(option); zfree(terminal_option);
    zfree(full_features); zfree(masked_features); zfree(model_features); zfree(scores);
    zfree(best_net); zfree(best_stop); zfree(best_success); zfree(best_choice);
    zfree(baseline_utility); zfree(baseline_success); zfree(baseline_choice);
    zfree(reachable_success); zfree(unknown_times); zfree(correct_times); zfree(reachable_times);
}

fn e51d_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32
)i32 {
    _zag_println("experiment_schema,tnn_r32_e51d_terminal_reachability_audit_v1");
    _zag_println("claim_boundary,evaluator_only_oracle_audit_not_learner_capability_not_promotion");
    _zag_println("frozen_policy,e50_terminal_action_values_unknown_fixed_zero");
    _zag_println("oracle_scope,resource_feasible_stop_time_only_truth_used_after_frozen_choice");

    let dev_seeds:[]i32=zalloc_i(E51B_DEV_EPISODES);
    let validation_seeds:[]i32=zalloc_i(E51B_VALIDATION_EPISODES);
    let confirmation_seeds:[]i32=zalloc_i(E51B_CONFIRM_EPISODES);
    let aggregate:[]i32=zalloc_i(E51B_MODELS*E51D_AGG_FIELDS);
    let cell_metrics:[]i32=zalloc_i(E51B_MODELS*6*E45_MODES*E45_RESOURCES*E51D_CELL_FIELDS);
    let stop_histogram:[]i32=zalloc_i(E51B_MODELS*(E45_TAPE+1));
    e45_zero(aggregate,E51B_MODELS*E51D_AGG_FIELDS);
    e45_zero(cell_metrics,E51B_MODELS*6*E45_MODES*E45_RESOURCES*E51D_CELL_FIELDS);
    e45_zero(stop_histogram,E51B_MODELS*(E45_TAPE+1));

    let seed_gate:i32=e51b_allocate_seeds(
        raw_seen,evidence_seen,resource_seen,dev_seeds,validation_seeds,confirmation_seeds
    );
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    e51d_audit_episode(
                        validation_seeds[index],base_index,mode,resource,
                        source_trust,dependence_penalty,consequence,hazard,
                        shadow_weights,shadow_bias,terminal_weights,terminal_biases,
                        aggregate,cell_metrics,stop_histogram
                    );
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }

    _zag_println("e51d_aggregate_columns,model,episodes,known,no_unique,baseline_success,reachable_success,utility_oracle_success,no_unique_unknown_reachable,no_unique_never_unknown,known_correct_reachable,known_never_correct,baseline_utility,utility_oracle_value,utility_oracle_observations,reachable_times,unknown_times,correct_times,baseline_unknown,oracle_unknown");
    let model:i32=0;
    while(model<E51B_MODELS){
        let a:i32=model*E51D_AGG_FIELDS;
        _zag_print("e51d_aggregate,"); e45_print_i32(model); _zag_print(",");

// R32 E51Q — evaluator-only fresh residual margin audit for the frozen
// E51P 32-cell conditional-weight expert. No learner parameters are changed.

const E51Q_AUDIT_EPISODES:i32=5400;
const E51Q_AUDIT_SAMPLES:i32=91800;
const E51Q_STAGE_AUDIT:i32=64;
const E51Q_CELLS:i32=32;
const E51Q_KNOWN_MAX:i32=4200;
const E51Q_BLOCKED_MAX:i32=1200;

fn e51q_distance_records(
    records:[]i32,
    record_a:i32,
    record_b:i32,
    ranges:[]i32
)i32 {
    let total:i64=0;
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let scale:i32=ranges[feature];
        if(scale>0){
            let xa:i32=e50_batch_column(records,record_a*E50_RECORD_N,feature+1,0);
            let xb:i32=e50_batch_column(records,record_b*E50_RECORD_N,feature+1,0);
            total=total+(r32e45_abs(xa-xb) as i64)*1000/(scale as i64);
        }
        feature=feature+1;
    }
    return e51m_clamp_i64(total,0,1000000);
}

fn e51q_exact_record_equal(records:[]i32,record_a:i32,record_b:i32)i32 {
    let feature:i32=0;
    while(feature<E45_FEATURES){
        if(e50_batch_column(records,record_a*E50_RECORD_N,feature+1,0)!=e50_batch_column(records,record_b*E50_RECORD_N,feature+1,0)){ return 0; }
        feature=feature+1;
    }
    return 1;
}

fn e51q_run(
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51Q_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51q_fresh_residual_margin_geometry_audit_v1");
    _zag_println("claim_boundary,evaluator_only_audit_not_learner_training_not_promotion");
    _zag_println("native_zag_v2_only=1");
    _zag_println("learner_parameter_change=0");
    _zag_println("evaluator_group_labels_exposed_to_learner=0");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");

    // Reconstruct exact E51P stage-61 development model.
    let dev_worlds:[]i32=zalloc_i(E51P_DEV_EPISODES);
    let i:i32=0;
    while(i<E51P_DEV_EPISODES){ dev_worlds[i]=e51n_world_id(E51P_STAGE_DEV,i); i=i+1; }
    let dev_records:[]i32=zalloc_i(E51P_DEV_SAMPLES*E50_RECORD_N); let dummy:[]i32=zalloc_i(E51P_DEV_SAMPLES*E50_RECORD_N);
    e45_zero(dev_records,E51P_DEV_SAMPLES*E50_RECORD_N); e45_zero(dummy,E51P_DEV_SAMPLES*E50_RECORD_N);
    let dev_unknown_nonzero:i32=0; let dummy_positive:i32=0; let dummy_negative:i32=0; let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(dev_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_records,dummy,&dev_unknown_nonzero,&dummy_positive,&dummy_negative);
                        canonical_episode=canonical_episode+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    zfree(dummy);

    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES); let backup_biases:[]i32=zalloc_i(4); let gram_f:[]i32=zalloc_i(E50_BATCH_GRAM); let gram_r:[]i32=zalloc_i(E50_BATCH_GRAM); let cross_f:[]i32=zalloc_i(E50_BATCH_CROSS); let cross_r:[]i32=zalloc_i(E50_BATCH_CROSS); let copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4); e45_zero(copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(dev_records,0,0,terminal_weights,terminal_biases,backup_weights,backup_biases,gram_f,gram_r,cross_f,cross_r,copy_weights,copy_biases);
    let unknown_parameter_nonzero:i32=0; if(terminal_biases[3]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; }
    let feature:i32=0; while(feature<E45_FEATURES){ if(terminal_weights[3*E45_FEATURES+feature]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; } feature=feature+1; }

    let sign_targets:[]i32=zalloc_i(E51P_DEV_SAMPLES); let dev_positive:i32=0; let dev_negative:i32=0; let dev_neutral:i32=0;
    e51m_build_targets(dev_records,E51P_DEV_SAMPLES,terminal_weights,terminal_biases,sign_targets,&dev_positive,&dev_negative,&dev_neutral);
    let global_weights:[]i32=zalloc_i(E45_FEATURES); let global_bias:i32=0; let ls_f:i32=0; let lr_f:i32=0; let lt_f:i32=0; let ll_f:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51P_DEV_SAMPLES,0,global_weights,0,&global_bias,&ls_f,&lr_f,&lt_f,&ll_f);
    let reverse_global:[]i32=zalloc_i(E45_FEATURES); let reverse_bias:i32=0; let ls_r:i32=0; let lr_r:i32=0; let lt_r:i32=0; let ll_r:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51P_DEV_SAMPLES,1,reverse_global,0,&reverse_bias,&ls_r,&lr_r,&lt_r,&ll_r);
    let linear_identity_gate:i32=e51m_linear_identity(global_weights,0,global_bias,reverse_global,0,reverse_bias,ls_f,ls_r,lr_f,lr_r,lt_f,lt_r,ll_f,ll_r);

    let prototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let parents:[]i32=zalloc_i(E51O_MAX_CELLS); let scalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let scalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let scalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_f:i32=0; let tree_trace_f:i32=0; let tree_loss_f:i64=0; let tree_strict_f:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51P_DEV_SAMPLES,global_weights,0,global_bias,0,prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,&tree_count_f,&tree_trace_f,&tree_loss_f,&tree_strict_f);
    let rprototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let rparents:[]i32=zalloc_i(E51O_MAX_CELLS); let rscalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let rscalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let rscalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_r:i32=0; let tree_trace_r:i32=0; let tree_loss_r:i64=0; let tree_strict_r:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51P_DEV_SAMPLES,global_weights,0,global_bias,1,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,&tree_count_r,&tree_trace_r,&tree_loss_r,&tree_strict_r);
    let tree_identity_gate:i32=e51o_local_identity(prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,tree_count_f,tree_trace_f,tree_loss_f,tree_strict_f,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,tree_count_r,tree_trace_r,tree_loss_r,tree_strict_r);
    let ranges:[]i32=zalloc_i(E45_FEATURES); let root:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(dev_records,E51P_DEV_SAMPLES,root,ranges);

    let expert_weights:[]i32=zalloc_i(E51Q_CELLS*E45_FEATURES); let expert_biases:[]i32=zalloc_i(E51Q_CELLS);
    let updates_f:i32=0; let sweeps_f:i32=0; let reason_f:i32=0; let trace_f:i32=0; let loss_f:i64=0; let strict_f:i32=0;
    e51p_fit_experts(dev_records,sign_targets,E51P_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,E51Q_CELLS,0,expert_weights,0,expert_biases,0,&updates_f,&sweeps_f,&reason_f,&trace_f,&loss_f,&strict_f);
    let rexpert_weights:[]i32=zalloc_i(E51Q_CELLS*E45_FEATURES); let rexpert_biases:[]i32=zalloc_i(E51Q_CELLS);
    let updates_r:i32=0; let sweeps_r:i32=0; let reason_r:i32=0; let trace_r:i32=0; let loss_r:i64=0; let strict_r:i32=0;
    e51p_fit_experts(dev_records,sign_targets,E51P_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,E51Q_CELLS,1,rexpert_weights,0,rexpert_biases,0,&updates_r,&sweeps_r,&reason_r,&trace_r,&loss_r,&strict_r);
    let expert_identity_gate:i32=e51p_expert_identity(expert_weights,0,expert_biases,0,rexpert_weights,0,rexpert_biases,0,E51Q_CELLS,updates_f,updates_r,sweeps_f,sweeps_r,reason_f,reason_r,trace_f,trace_r,loss_f,loss_r,strict_f,strict_r);
    e45_print_pair("e51q_reconstruct_base_identity_gate",base_fit_gate); e45_print_pair("e51q_reconstruct_global_identity_gate",linear_identity_gate); e45_print_pair("e51q_reconstruct_tree_identity_gate",tree_identity_gate); e45_print_pair("e51q_reconstruct_expert_identity_gate",expert_identity_gate); e45_print_pair("e51q_reconstruct_expert_updates",updates_f); e45_print_pair("e51q_reconstruct_expert_sweeps",sweeps_f);

    // Build fresh stage-64 audit records.
    let audit_worlds:[]i32=zalloc_i(E51Q_AUDIT_EPISODES); i=0; while(i<E51Q_AUDIT_EPISODES){ audit_worlds[i]=e51n_world_id(E51Q_STAGE_AUDIT,i); i=i+1; }
    let audit_records:[]i32=zalloc_i(E51Q_AUDIT_SAMPLES*E50_RECORD_N); let audit_dummy:[]i32=zalloc_i(E51Q_AUDIT_SAMPLES*E50_RECORD_N); let audit_types:[]i32=zalloc_i(E51Q_AUDIT_EPISODES);
    e45_zero(audit_records,E51Q_AUDIT_SAMPLES*E50_RECORD_N); e45_zero(audit_dummy,E51Q_AUDIT_SAMPLES*E50_RECORD_N);
    let audit_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    audit_types[canonical_episode]=0; if(mode==0 || mode==1){ audit_types[canonical_episode]=1; }
                    e51e_build_training_episode(audit_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,audit_records,audit_dummy,&audit_unknown_nonzero,&dummy_positive,&dummy_negative);
                    canonical_episode=canonical_episode+1; episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    zfree(audit_dummy);

    let known_record:[]i32=zalloc_i(E51Q_KNOWN_MAX); let known_margin:[]i32=zalloc_i(E51Q_KNOWN_MAX);
    let blocked_record:[]i32=zalloc_i(E51Q_BLOCKED_MAX); let blocked_margin:[]i32=zalloc_i(E51Q_BLOCKED_MAX); let blocked_cell:[]i32=zalloc_i(E51Q_BLOCKED_MAX); let cell_counts:[]i32=zalloc_i(E51Q_CELLS);
    let known_count:i32=0; let no_unique_count:i32=0; let blocked_count:i32=0;
    let weakest_known_margin:i32=4001; let hardest_no_unique_min:i32=-4001;
    let blocked_margin_sum:i64=0; let blocked_min_margin:i32=4001; let blocked_max_margin:i32=-4001;
    let episode:i32=0;
    while(episode<E51Q_AUDIT_EPISODES){
        if(audit_types[episode]==1){
            no_unique_count=no_unique_count+1;
            let min_score:i32=4001; let min_record:i32=-1; let min_cell:i32=-1; let t:i32=0;
            while(t<=E45_TAPE){
                let record_index:i32=episode*(E45_TAPE+1)+t; let record_start:i32=record_index*E50_RECORD_N;
                let score:i32=e51p_expert_predict(audit_records,record_start,global_weights,global_bias,prototypes,parents,ranges,E51Q_CELLS,expert_weights,0,expert_biases,0);
                if(score<min_score){ min_score=score; min_record=record_index; min_cell=e51p_route_cell(audit_records,record_start,prototypes,parents,ranges,E51Q_CELLS); }
                t=t+1;
            }
            if(min_score>hardest_no_unique_min){ hardest_no_unique_min=min_score; }
            if(min_score>=0){
                blocked_record[blocked_count]=min_record; blocked_margin[blocked_count]=min_score; blocked_cell[blocked_count]=min_cell; cell_counts[min_cell]=cell_counts[min_cell]+1;
                blocked_margin_sum=blocked_margin_sum+(min_score as i64); if(min_score<blocked_min_margin){ blocked_min_margin=min_score; } if(min_score>blocked_max_margin){ blocked_max_margin=min_score; }
                blocked_count=blocked_count+1;
            }
        }else{
            let best_score:i32=-4001; let best_record:i32=-1; let t:i32=0;
            while(t<=E45_TAPE){
                let record_index:i32=episode*(E45_TAPE+1)+t; let record_start:i32=record_index*E50_RECORD_N;
                let action:i32=e51m_top_commit(audit_records,record_start,terminal_weights,terminal_biases);
                if(audit_records[record_start+34+action]==1000){
                    let score:i32=e51p_expert_predict(audit_records,record_start,global_weights,global_bias,prototypes,parents,ranges,E51Q_CELLS,expert_weights,0,expert_biases,0);
                    if(score>best_score){ best_score=score; best_record=record_index; }
                }
                t=t+1;
            }
            known_record[known_count]=best_record; known_margin[known_count]=best_score;
            if(best_score<weakest_known_margin){ weakest_known_margin=best_score; }
            known_count=known_count+1;
        }
        episode=episode+1;
    }

    let lower_delta:i32=0-weakest_known_margin;
    let upper_delta:i32=0-hardest_no_unique_min;
    let uniform_interval_exists:i32=0; if(lower_delta<upper_delta){ uniform_interval_exists=1; }
    let distinct_blocked_cells:i32=0; let max_cell_concentration:i32=0; let max_cell_index:i32=-1; let cell:i32=0;
    while(cell<E51Q_CELLS){ if(cell_counts[cell]>0){ distinct_blocked_cells=distinct_blocked_cells+1; if(cell_counts[cell]>max_cell_concentration){ max_cell_concentration=cell_counts[cell]; max_cell_index=cell; } } cell=cell+1; }
    let blocked_mean_margin:i32=0; if(blocked_count>0){ blocked_mean_margin=(blocked_margin_sum/(blocked_count as i64)) as i32; }

    let exact_aliases:i32=0; let nearest_distance_min:i32=1000001; let nearest_distance_sum:i64=0;
    let blocked_feature_sum:[]i32=zalloc_i(E45_FEATURES); let known_feature_sum:[]i32=zalloc_i(E45_FEATURES);
    let b:i32=0;
    while(b<blocked_count){
        let nearest:i32=1000001; let k:i32=0;
        while(k<known_count){
            let d:i32=e51q_distance_records(audit_records,blocked_record[b],known_record[k],ranges);
            if(d<nearest){ nearest=d; }
            if(d==0 && e51q_exact_record_equal(audit_records,blocked_record[b],known_record[k])==1){ exact_aliases=exact_aliases+1; }
            k=k+1;
        }
        if(nearest<nearest_distance_min){ nearest_distance_min=nearest; }
        nearest_distance_sum=nearest_distance_sum+(nearest as i64);
        feature=0; while(feature<E45_FEATURES){ blocked_feature_sum[feature]=blocked_feature_sum[feature]+e50_batch_column(audit_records,blocked_record[b]*E50_RECORD_N,feature+1,0); feature=feature+1; }
        b=b+1;
    }
    let k:i32=0;
    while(k<known_count){ feature=0; while(feature<E45_FEATURES){ known_feature_sum[feature]=known_feature_sum[feature]+e50_batch_column(audit_records,known_record[k]*E50_RECORD_N,feature+1,0); feature=feature+1; } k=k+1; }
    let nearest_distance_mean:i32=0; if(blocked_count>0){ nearest_distance_mean=(nearest_distance_sum/(blocked_count as i64)) as i32; }

    _zag_print("e51q_counts,"); e45_print_i32(known_count); _zag_print(","); e45_print_i32(no_unique_count); _zag_print(","); e45_print_i32(blocked_count); _zag_println("");
    _zag_print("e51q_margin_interval,"); e45_print_i32(weakest_known_margin); _zag_print(","); e45_print_i32(hardest_no_unique_min); _zag_print(","); e45_print_i32(lower_delta); _zag_print(","); e45_print_i32(upper_delta); _zag_print(","); e45_print_i32(uniform_interval_exists); _zag_println("");
    _zag_print("e51q_blocked_margins,"); e45_print_i32(blocked_min_margin); _zag_print(","); e45_print_i32(blocked_max_margin); _zag_print(","); e45_print_i32(blocked_mean_margin); _zag_println("");
    _zag_print("e51q_blocked_cells,"); e45_print_i32(distinct_blocked_cells); _zag_print(","); e45_print_i32(max_cell_concentration); _zag_print(","); e45_print_i32(max_cell_index); _zag_println("");
    _zag_print("e51q_nearest_known_distance,"); e45_print_i32(nearest_distance_min); _zag_print(","); e45_print_i32(nearest_distance_mean); _zag_print(","); e45_print_i32(exact_aliases); _zag_println("");
    feature=0;
    while(feature<E45_FEATURES){
        let blocked_mean:i32=0; if(blocked_count>0){ blocked_mean=blocked_feature_sum[feature]/blocked_count; }
        let known_mean:i32=0; if(known_count>0){ known_mean=known_feature_sum[feature]/known_count; }
        _zag_print("e51q_feature_mean_delta,"); e45_print_i32(feature); _zag_print(","); e45_print_i32(blocked_mean); _zag_print(","); e45_print_i32(known_mean); _zag_print(","); e45_print_i32(blocked_mean-known_mean); _zag_println("");
        feature=feature+1;
    }

    let audit_fresh_gate:i32=1;
    if(audit_worlds[0]<=e51n_world_id(E51P_STAGE_CONFIRM,E51P_CONFIRM_EPISODES-1)){ audit_fresh_gate=0; }
    let counts_gate:i32=0; if(canonical_episode==E51Q_AUDIT_EPISODES && known_count==4200 && no_unique_count==1200){ counts_gate=1; }
    let integrity_gate:i32=0;
    if(base_fit_gate==1 && linear_identity_gate==1 && tree_identity_gate==1 && expert_identity_gate==1 && strict_f==1 && strict_r==1 && dev_unknown_nonzero==0 && unknown_parameter_nonzero==0 && audit_unknown_nonzero==0 && audit_fresh_gate==1 && counts_gate==1){ integrity_gate=1; }
    e45_print_pair("e51q_audit_fresh_gate",audit_fresh_gate); e45_print_pair("e51q_counts_gate",counts_gate); e45_print_pair("e51q_integrity_gate",integrity_gate); e45_print_pair("e51q_uniform_interval_exists",uniform_interval_exists); e45_print_pair("e51q_residual_exact_aliases",exact_aliases);
    if(integrity_gate==0){ _zag_println("e51q_outcome,INVALID_RESIDUAL_AUDIT_INTEGRITY_FAILURE");
    }else{
        if(exact_aliases>0){ _zag_println("e51q_outcome,RESIDUAL_EXACT_ALIASING_FOUND");
        }else{
            if(uniform_interval_exists==1){ _zag_println("e51q_outcome,UNIFORM_MARGIN_RESCUE_EXISTS");
            }else{ _zag_println("e51q_outcome,UNIFORM_MARGIN_RESCUE_IMPOSSIBLE_LOCAL_STRUCTURE_REMAINS"); }
        }
    }
    _zag_println("TNN_R32_E51Q_EXECUTION_COMPLETE=1");

    zfree(dev_worlds); zfree(dev_records); zfree(terminal_weights); zfree(terminal_biases); zfree(backup_weights); zfree(backup_biases); zfree(gram_f); zfree(gram_r); zfree(cross_f); zfree(cross_r); zfree(copy_weights); zfree(copy_biases); zfree(sign_targets); zfree(global_weights); zfree(reverse_global);
    zfree(prototypes); zfree(parents); zfree(scalar_snapshots); zfree(scalar_counts); zfree(scalar_losses); zfree(rprototypes); zfree(rparents); zfree(rscalar_snapshots); zfree(rscalar_counts); zfree(rscalar_losses); zfree(ranges); zfree(root); zfree(expert_weights); zfree(expert_biases); zfree(rexpert_weights); zfree(rexpert_biases);
    zfree(audit_worlds); zfree(audit_records); zfree(audit_types); zfree(known_record); zfree(known_margin); zfree(blocked_record); zfree(blocked_margin); zfree(blocked_cell); zfree(cell_counts); zfree(blocked_feature_sum); zfree(known_feature_sum);
    return 1;
}

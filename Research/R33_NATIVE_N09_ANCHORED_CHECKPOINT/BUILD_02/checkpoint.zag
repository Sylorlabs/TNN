// Current-head-bound worker checkpoint transport. The NaStore is the separately
// held authoritative supervisor journal; a worker checkpoint never selects it.
// This is bounded opaque-state engineering, not original-parent migration.
@import("authority.zag")

fn cs_usable(j:*NaStore)i32 {
    return (j.*.status==0 && j.*.root>=0 && j.*.lock>=0 && j.*.state_len>=0 &&
        j.*.state_len<=4096 && j.*.state.len==4096 && j.*.keys.len==64 &&
        j.*.config.len==128 && j.*.policy_hash.len==32 && j.*.state_hash.len==32 && j.*.head.len==32) as i32;
}
fn cs_body(j:*NaStore,b:[]u8)i32 {
    if(cs_usable(j)!=1){return -8610;}
    if(b.len!=192+j.*.state_len){return -8601;}
    na_zero(b);na_copy("R33CP001",b);na_put(b,8,1);na_put(b,12,j.*.seq);
    na_put(b,16,j.*.epoch);na_put(b,20,j.*.version);na_put(b,24,j.*.nonce);
    na_put(b,28,j.*.spent);na_put(b,32,j.*.budget);na_put(b,36,j.*.state_len);
    na_put(b,40,j.*.published);na_put(b,44,j.*.orphans);na_put(b,48,j.*.state_commits);
    na_put(b,52,na_get(j.*.config,16));na_put(b,56,na_get(j.*.config,20));na_put(b,60,na_get(j.*.config,12));
    na_copy(j.*.policy_hash,b[64..96]);na_copy(j.*.state_hash,b[96..128]);na_copy(j.*.head,b[128..160]);
    na_copy(j.*.state[0..j.*.state_len],b[192..b.len]);return 0;
}
fn cs_export(j:*NaStore,out:[]u8)i32 {
    if(cs_usable(j)!=1){return -8610;}
    let n:i32=224+j.*.state_len;if(out.len<n){return -8601;}
    if(na_internal(j,out)==1){return -8611;}
    let b:[]u8=nio_alloc(n);if(b.len!=n){return -8607;}
    let code:i32=cs_body(j,b[0..n-32]);
    if(code==0 && na_hmac(j.*.keys[32..64],b[0..n-32],b[n-32..n])!=0){code=-8607;}
    if(code==0){na_copy(b,out);code=n;}nio_free(b);return code;
}
fn cs_restore(j:*NaStore,packet:[]u8,out:[]u8)i32 {
    // No store path, cached authority flag, version override or self-grant input.
    if(cs_usable(j)!=1){return -8610;}
    if(na_internal(j,out)==1 || na_internal(j,packet)==1){return -8611;}
    if(packet.len<224 || packet.len>4320){return -8601;}
    let n:i32=na_get(packet,36);if(n<0 || n>4096 || packet.len!=224+n){return -8601;}
    if(na_mac_ok(j.*.keys[32..64],packet[0..192+n],packet[192+n..224+n])!=1){return -8602;}
    if(nio_equal(packet[0..8],"R33CP001")!=1 || na_get(packet,8)!=1 || na_is_zero(packet[160..192])!=1){return -8601;}
    let expected:[]u8=nio_alloc(192+j.*.state_len);if(expected.len!=192+j.*.state_len){return -8607;}
    let code:i32=cs_body(j,expected);
    if(code==0 && nio_equal(packet[0..192],expected[0..192])!=1){code=-8604;}
    if(code==0 && nio_equal(packet[192..192+n],expected[192..expected.len])!=1){code=-8603;}
    if(code==0 && out.len<n){code=-8601;}
    // Exact staging also permits successful output/packet overlap without
    // rereading bytes after output mutation. All refusals leave outputs intact.
    if(code==0){na_copy(expected[192..expected.len],out);code=n;}
    nio_free(expected);return code;
}

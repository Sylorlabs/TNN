    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let masked_features:[]i32=zalloc_i(E45_FEATURES);
    let model_features:[]i32=zalloc_i(E45_FEATURES);
    let continuation_features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(4);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);

    let model:i32=0;
    while(model<E51B_MODELS){
        // Matched terminate-now control at t=0.
        e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN;
        let control_choice:i32=e51b_terminal_choice(
            model,states,0,option,resource_features,hazard,
            passive_a[E45_PASSIVE-1],passive_b[E45_PASSIVE-1],learned_shadow,
            terminal_weights,terminal_biases,terminal_option,full_features,
            masked_features,model_features,scores
        );
        let control_terminal_utility:i32=e45_terminal_value(control_choice,states,0,initial_state,truth_state[0]);
        e51b_record_outcome(
            control_aggregate,model*E51B_AGG_FIELDS,control_choice,control_terminal_utility,truth_state[0],0,0
        );

        // Sequential policy: one learned advantage head decides both whether
        // to initiate and whether to continue. No separate initiation heuristic.
        e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN;
        e45_copy(states,live_state,E45_STATE_N);
        let observations:i32=0;
        let opportunity_loss:i32=0;
        let stopped:i32=0;
        while(stopped==0 && observations<E45_TAPE){
            let immediate_a:i32=passive_a[E45_PASSIVE-1];
            let immediate_b:i32=passive_b[E45_PASSIVE-1];
            if(observations>0){
                immediate_a=tape_a[observations-1];
                immediate_b=tape_b[observations-1];
            }
            e51b_continuation_features(
                states,observations*E45_STATE_N,option,resource_features,hazard,
                immediate_a,immediate_b,learned_shadow,
                full_features,masked_features,continuation_features
            );
            let head:i32=0;
            if(model==1){ head=1; }
            let predicted_advantage:i32=e47_linear_predict(
                continuation_weights,(model*4+head)*E45_FEATURES,
                continuation_features,0,continuation_biases[model*4+head]
            );
            if(feasible[observations]==0 || predicted_advantage<=0){
                stopped=1;
            }else{
                if(observations==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,predicted_advantage); }
                opportunity_loss=opportunity_loss+losses[observations];
                let tape_index:i32=observations;
                observations=observations+1;
                let j:i32=0;
                while(j<E45_STATE_N){ live_state[j]=states[observations*E45_STATE_N+j]; j=j+1; }
                e45_option_observe(option,live_state,tape_a[tape_index],tape_b[tape_index],tape_source[tape_index],learned_shadow);
            }
        }
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(observations>0){ immediate_a=tape_a[observations-1]; immediate_b=tape_b[observations-1]; }
        let final_choice:i32=e51b_terminal_choice(
            model,states,observations*E45_STATE_N,option,resource_features,hazard,
            immediate_a,immediate_b,learned_shadow,
            terminal_weights,terminal_biases,terminal_option,full_features,
            masked_features,model_features,scores
        );
        let final_terminal_utility:i32=e45_terminal_value(
            final_choice,states,observations*E45_STATE_N,initial_state,truth_state[observations]
        );
        let final_utility:i32=final_terminal_utility-opportunity_loss;
        e51b_record_outcome(
            sequential_aggregate,model*E51B_AGG_FIELDS,final_choice,final_utility,truth_state[observations],
            observations,opportunity_loss
        );
        stop_histogram[model*(E45_TAPE+1)+observations]=stop_histogram[model*(E45_TAPE+1)+observations]+1;

        let cell:i32=e51b_cell_offset(model,base_index,evaluator_mode,evaluator_resource);
        cell_metrics[cell]=cell_metrics[cell]+1;
        if(truth_state[observations]<0){
            cell_metrics[cell+1]=cell_metrics[cell+1]+1;
            if(final_choice==R32E45_TERM_UNKNOWN){ cell_metrics[cell+2]=cell_metrics[cell+2]+1;
            }else{ cell_metrics[cell+3]=cell_metrics[cell+3]+1; }
        }else{
            cell_metrics[cell+4]=cell_metrics[cell+4]+1;
            if(final_choice==R32E45_TERM_UNKNOWN){ cell_metrics[cell+6]=cell_metrics[cell+6]+1;
            }else{
                if(final_terminal_utility==1000){ cell_metrics[cell+5]=cell_metrics[cell+5]+1;
                }else{ cell_metrics[cell+7]=cell_metrics[cell+7]+1; }
            }
        }
        cell_metrics[cell+8]=cell_metrics[cell+8]+observations;
        cell_metrics[cell+9]=cell_metrics[cell+9]+opportunity_loss;
        model=model+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(losses); zfree(feasible); zfree(option); zfree(terminal_option);
    zfree(full_features); zfree(masked_features); zfree(model_features);
    zfree(continuation_features); zfree(scores);
}

fn e51b_run(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32
)i32 {
    _zag_println("experiment_schema,tnn_r32_e51b_batch_terminal_sequential_continuation_v1");
    _zag_println("claim_boundary,native_validation_discriminator_not_promotion");
    _zag_println("unknown_geometry,neutral_zero_no_positive_unknown_target");
    _zag_println("continuation_geometry,learned_delayed_utility_advantage_over_terminate_now");

    let dev_seeds:[]i32=zalloc_i(E51B_DEV_EPISODES);
    let validation_seeds:[]i32=zalloc_i(E51B_VALIDATION_EPISODES);
    let confirmation_seeds:[]i32=zalloc_i(E51B_CONFIRM_EPISODES);
    let continuation_records:[]i32=zalloc_i(E51B_SAMPLES*E50_RECORD_N);
    let target_positive:[]i32=zalloc_i(E51B_MODELS);
    let target_negative:[]i32=zalloc_i(E51B_MODELS);
    let target_zero:[]i32=zalloc_i(E51B_MODELS);
    let continuation_weights:[]i32=zalloc_i(E51B_MODELS*4*E45_FEATURES);
    let continuation_biases:[]i32=zalloc_i(E51B_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES);
    let backup_biases:[]i32=zalloc_i(4);
    let gram_forward:[]i32=zalloc_i(E50_BATCH_GRAM);
    let gram_reverse:[]i32=zalloc_i(E50_BATCH_GRAM);
    let cross_forward:[]i32=zalloc_i(E50_BATCH_CROSS);
    let cross_reverse:[]i32=zalloc_i(E50_BATCH_CROSS);
    let forward_copy_weights:[]i32=zalloc_i(E51B_MODELS*4*E45_FEATURES);
    let forward_copy_biases:[]i32=zalloc_i(E51B_MODELS*4);
    let control_aggregate:[]i32=zalloc_i(E51B_MODELS*E51B_AGG_FIELDS);
    let sequential_aggregate:[]i32=zalloc_i(E51B_MODELS*E51B_AGG_FIELDS);
    let cell_metrics:[]i32=zalloc_i(E51B_MODELS*6*E45_MODES*E45_RESOURCES*E51B_CELL_FIELDS);
    let stop_histogram:[]i32=zalloc_i(E51B_MODELS*(E45_TAPE+1));
    e45_zero(continuation_records,E51B_SAMPLES*E50_RECORD_N);
    e45_zero(target_positive,E51B_MODELS); e45_zero(target_negative,E51B_MODELS); e45_zero(target_zero,E51B_MODELS);
    e45_zero(continuation_weights,E51B_MODELS*4*E45_FEATURES); e45_zero(continuation_biases,E51B_MODELS*4);
    e45_zero(backup_weights,4*E45_FEATURES); e45_zero(backup_biases,4);
    e45_zero(gram_forward,E50_BATCH_GRAM); e45_zero(gram_reverse,E50_BATCH_GRAM);
    e45_zero(cross_forward,E50_BATCH_CROSS); e45_zero(cross_reverse,E50_BATCH_CROSS);
    e45_zero(forward_copy_weights,E51B_MODELS*4*E45_FEATURES); e45_zero(forward_copy_biases,E51B_MODELS*4);
    e45_zero(control_aggregate,E51B_MODELS*E51B_AGG_FIELDS); e45_zero(sequential_aggregate,E51B_MODELS*E51B_AGG_FIELDS);
    e45_zero(cell_metrics,E51B_MODELS*6*E45_MODES*E45_RESOURCES*E51B_CELL_FIELDS);
    e45_zero(stop_histogram,E51B_MODELS*(E45_TAPE+1));

    let seed_gate:i32=e51b_allocate_seeds(raw_seen,evidence_seen,resource_seen,dev_seeds,validation_seeds,confirmation_seeds);

    let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51b_build_continuation_episode(
                            dev_seeds[index],mode,resource,canonical_episode,
                            source_trust,dependence_penalty,consequence,hazard,
                            shadow_weights,shadow_bias,terminal_weights,terminal_biases,
                            continuation_records,target_positive,target_negative,target_zero
                        );
                        canonical_episode=canonical_episode+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let sample_gate:i32=0;
    if(canonical_episode==E51B_DEV_EPISODES){ sample_gate=1; }
    e45_print_pair("e51b_development_episodes",canonical_episode);
    let model:i32=0;
    while(model<E51B_MODELS){
        _zag_print("e51b_target_counts,"); e45_print_i32(model); _zag_print(",");
        e45_print_i32(target_positive[model]); _zag_print(",");
        e45_print_i32(target_negative[model]); _zag_print(",");
        e45_print_i32(target_zero[model]); _zag_println("");
        model=model+1;
    }
    let target_interior_gate:i32=1;
    model=0;

// Literal oracles transcribed from retained NIST CAVS11 and RFC6234 references.
// No expected value is derived from the new SHA or an exposed N13A execution.
@import("hash_controls.zag")

fn h13_controls(s:*P13Stats,w:*TsWork)void {
    let pool:[]i64=pm_words(154);let out:[]u8=nio_alloc(64);
    if(p13_setup_words(pool,154,s)!=1 || p13_setup_bytes(out,64,s)!=1){pm_free_words(pool);nio_free(out);return;}
    pool[0]=267;pool[153]=619;let work:[]i64=pool[1..153];
    // NIST Len is in BITS. Len0's Msg00 is a placeholder, not a one-byte input.
    h13_vector(1,"",0,"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",work,out,s,w);
    h13_hex_vector(2,"d3",1,"28969cdfa74a12c82f3bad960b0b000aca2ac329deea5c2328ebc6f2ba9802c1",work,out,s,w);
    h13_hex_vector(3,"3ebfb06db8c38d5ba037f1363e118550aad94606e26835a01af05078533cc25f2f39573c04b632f62f68c294ab31f2a3e2a1a0d8c2be51",55,"6595a2ef537a69ba8583dfbf7f5bec0ab1f93ce4c8ee1916eff44a93af5749c4",work,out,s,w);
    h13_hex_vector(4,"2d52447d1244d2ebc28650e7b05654bad35b3a68eedc7f8515306b496d75f3e73385dd1b002625024b81a02f2fd6dffb6e6d561cb7d0bd7a",56,"cfb88d6faf2de3a69d36195acec2e255e2af2b7d933997f348e09f6ce5758360",work,out,s,w);
    h13_hex_vector(5,"e2f76e97606a872e317439f1a03fcd92e632e5bd4e7cbc4e97f1afc19a16fde92d77cbe546416b51640cddb92af996534dfd81edb17c4424cf1ac4d75aceeb",63,"18041bd4665083001fba8c5411d2d748e8abbfdcdfd9218cb02b68a78e7d4c23",work,out,s,w);
    h13_hex_vector(6,"5a86b737eaea8ee976a0a24da63e7ed7eefad18a101c1211e2b3650c5187c2a8a650547208251f6d4237e661c7bf4c77f335390394c37fa1a9f9be836ac28509",64,"42e61e174fbb3897d6dd6cef3dd2802fe67b331953b06114a65c772859dfc1aa",work,out,s,w);
    h13_hex_vector(7,"",163,"3c593aa539fdcdae516cdf2f15000f6634185c88f505b39775fb9ab137a10aa2",work,out,s,w);
    h13_vector(8,"abc",3,"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",work,out,s,w);
    h13_vector(9,"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",56,"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",work,out,s,w);
    if(s.*.failed==0){let repeated:[]u8=nio_alloc(640);let pattern:[]u8="01234567";
        if(repeated.len==640){let i:i32=0;while(i<640){repeated[i]=pattern[i%8];i=i+1;}}
        h13_vector(10,repeated,640,"594847328451bdfa85056225462cc1d867d877fb388df0ce35f25ab5562bfbb5",work,out,s,w);nio_free(repeated);
    }
    if(s.*.failed==0){let million:[]u8=nio_alloc(1000000);h13_fill(million,97);
        h13_vector(11,million,1000000,"cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0",work,out,s,w);nio_free(million);
    }
    p13_check(s,"vector_scratch_prefix_guard",pool[0],267);p13_check(s,"vector_scratch_suffix_guard",pool[153],619);
    if(s.*.failed==0){h13_reset(work,out,s,w);}
    if(s.*.failed==0){h13_refusals(pool,out,s);}
    if(s.*.failed==0){h13_fingerprints(s,w);}
    if(s.*.failed==0){h13_budgets(work,out,s);}
    pm_free_words(pool);nio_free(out);
}

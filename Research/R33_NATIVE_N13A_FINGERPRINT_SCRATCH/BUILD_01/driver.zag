// Sole prospective N13 native primary dispatcher. Execution requires a separate
// reviewed source/config freeze and launch admission; this source is not a grant.
@import("inventory.zag")
@import("hash_vectors.zag")

fn p13_number(b:[]u8,prefix:[]u8,tail:[]u8)i64 {
    let value:i64=-1;let i:i32=0;while(i+prefix.len<b.len){let k:i32=0;while(k<prefix.len && b[i+k]==prefix[k]){k=k+1;}
        if(k==prefix.len && (i==0 || b[i-1]==10)){if(value>=0){return -1;}let at:i32=i+k;let v:i64=0;let digits:i32=0;
            while(at<b.len && b[at]>=48 && b[at]<=57 && digits<12){v=v*10+(b[at] as i64)-48;digits=digits+1;at=at+1;}
            if(digits==0 || at+tail.len>b.len){return -1;}k=0;while(k<tail.len){if(b[at+k]!=tail[k]){return -1;}k=k+1;}value=v;}i=i+1;}return value;
}
fn p13_run(root:i64,mode:[]u8,expected:i32,ms:i64,s:*P13Stats)void {
    if(s.*.failed!=0){return;}let r:NativeRunV3=nrv3_run(root,_zag_arg(0),mode,mode,ms,1048576);
    s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}
    if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    p13_check(s,"child_supervisor_status",r.status,0);p13_check(s,"child_started",r.started,1);p13_check(s,"child_reaped",r.reaped,1);
    p13_check(s,"child_exit",r.exit_code,expected);p13_check(s,"child_signal",r.signal,0);p13_check(s,"child_stderr_empty",r.stderr_bytes,0);
    p13_check(s,"observed_child_RSS_within_bound",(r.peak_rss>0 && r.peak_rss<=402653184) as i32,1);
    let name:[]u8=_zag_str_concat(mode,".stdout");let log:[]u8=nio_alloc(1048576);let n:i64=mi_read(root,name,log,1048576);nio_free(name);
    p13_check(s,"child_capture_complete",n,r.stdout_bytes);
    if(n>=0 && n<=1048576){if(expected==0){let checks:i64=p13_number(log[0..n as i32],"N13A_CHILD_COUNTS,",",0\n");
            p13_check(s,"unambiguous_zero_failure_check_total",(checks>0 && checks<=16000) as i32,1);
            p13_check(s,"child_terminal_pass",(p13_find(log[0..n as i32],"N13A_CHILD_PASS\n")>=0) as i32,1);
            if(s.*.failed==0 && checks>0 && checks<=16000 && r.status==0 && r.exit_code==0){s.*.child_checks=s.*.child_checks+(checks as i32);}
        }else{p13_check(s,"invalid_mode_silent",n,0);}}
    nio_free(log);
}
fn p13_field(b:[]u8,key:[]u8,value:i64)[]u8 {let n:[]u8=_zag_i64_to_str(value);b=p13_join(b,key);b=p13_join(b,n);nio_free(n);return b;}
fn p13_supervise()i32 {
    if(nio_guard(180)!=0){return 3;}let admission:NativeAdmissionV3=nrv3_admit_root(p13_root());if(admission.status!=0){return 4;}
    let root:i64=admission.root;let s:P13Stats=p13_stats();p13_run(root,"invalid",2,5000,&s);
    p13_run(root,"hash-controls",0,10000,&s);
    p13_run(root,"matrix",0,20000,&s);p13_run(root,"refusals",0,20000,&s);
    p13_run(root,"inventory-write",0,60000,&s);p13_run(root,"inventory-replay",0,60000,&s);
    p13_check(&s,"all_six_children_completed",s.children,6);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\":\"R33-N13A\",\n  \"planned_children\":6","");
    json=p13_field(json,",\n  \"children_attempted\":",s.children);json=p13_field(json,",\n  \"parent_failures_before_result_write\":",s.failed);
    json=p13_field(json,",\n  \"verified_completed_child_checks\":",s.child_checks);json=p13_field(json,",\n  \"parent_checks_before_result_write\":",s.checks);
    json=p13_field(json,",\n  \"child_cpu_us\":",s.cpu);json=p13_field(json,",\n  \"observed_child_wall_us\":",s.wall);json=p13_field(json,",\n  \"peak_child_rss_bytes\":",s.rss);
    json=p13_join(json,",\n  \"training\":false,\n  \"canonical_mutation\":false,\n  \"python_execution\":false,\n  \"reducer_execution\":false,\n  \"semantic_digest_recomputed\":false,\n  \"full_parent_migration_verified\":false,\n  \"requires_terminal_marker\":true\n}\n");
    p13_check(&s,"exclusive_native_result_write",mi_write(root,"NATIVE_RESULT.json",json),0);_zag_print(json);nio_free(json);
    p13_check(&s,"parent_output_root_closed",nio_close(root),0);if(s.failed!=0){return 1;}
    _zag_println("R33_N13A_BOUNDED_TORCH_VIEW_ENGINEERING_PASS");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);if(_zag_strcmp(mode,"supervise")==1){return p13_supervise();}
    if(_zag_strcmp(mode,"invalid")==1){return 2;}let seconds:i64=20;
    if(_zag_strcmp(mode,"hash-controls")==1){seconds=10;}
    if(_zag_strcmp(mode,"inventory-write")==1 || _zag_strcmp(mode,"inventory-replay")==1){seconds=60;}
    if(nio_deadline(seconds)!=0){return 3;}let s:P13Stats=p13_stats();let w:TsWork=ts_work();let handled:i32=1;
    if(_zag_strcmp(mode,"hash-controls")==1){h13_controls(&s,&w);}
    else if(_zag_strcmp(mode,"matrix")==1){p13_matrix(&s,&w);}else if(_zag_strcmp(mode,"refusals")==1){p13_refusals(&s,&w);}
    else if(_zag_strcmp(mode,"inventory-write")==1){p13_inventory(0,&s,&w);}else if(_zag_strcmp(mode,"inventory-replay")==1){p13_inventory(1,&s,&w);}else{handled=0;}
    if(handled==0){return 2;}let expected_cases:i32=1;if(_zag_strcmp(mode,"matrix")==1){expected_cases=102;}
    if(_zag_strcmp(mode,"hash-controls")==1){expected_cases=15;}
    if(_zag_strcmp(mode,"refusals")==1){expected_cases=123;}p13_check(&s,"fixed_declared_case_count",s.cases,expected_cases);
    p13_work_log(&w);_zag_print("N13A_CASES,");_zag_println(_zag_i64_to_str(s.cases));
    _zag_print("N13A_CHILD_COUNTS,");_zag_print(_zag_i64_to_str(s.checks));_zag_print(",");_zag_println(_zag_i64_to_str(s.failed));
    if(s.failed!=0){return 1;}_zag_println("N13A_CHILD_PASS");return 0;
}

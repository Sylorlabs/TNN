// N13 native evaluator substrate. Known inert engineering inputs only.
@import("fixtures.zag")
@import("R33_NATIVE_PROCESS_V3.zag")
@import("fingerprint_sha.zag")

struct P13Stats {checks:i32,failed:i32,cases:i32,children:i32,child_checks:i32,cpu:i64,wall:i64,rss:i64}
fn p13_stats()P13Stats {return P13Stats{.checks=0,.failed=0,.cases=0,.children=0,.child_checks=0,.cpu=0,.wall=0,.rss=0};}
fn p13_check(s:*P13Stats,key:[]u8,a:i64,e:i64)void {
    if(s.*.checks>=16000){s.*.failed=s.*.failed+1;return;}
    s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(key,a,e);
}
fn p13_case(s:*P13Stats,group:[]u8,id:i64)void {
    s.*.cases=s.*.cases+1;_zag_print("CASE,");_zag_print(group);_zag_print(",");_zag_println(_zag_i64_to_str(id));
}
fn p13_root()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N13A_RUN_PRIMARY_V1";}
fn p13_join(a:[]u8,b:[]u8)[]u8 {let out:[]u8=_zag_str_concat(a,b);nio_free(a);return out;}
fn p13_hex(text:[]u8)[]u8 {
    if(text.len==0 || text.len%2!=0){return "";}let out:[]u8=nio_alloc(text.len/2);
    if(out.len!=text.len/2){return "";}let i:i32=0;while(i<out.len){
        let a:i64=ns_hex_digit(text[i*2] as i32);let b:i64=ns_hex_digit(text[i*2+1] as i32);
        if(a<0 || b<0){nio_free(out);return "";}out[i]=(16*a+b) as u8;i=i+1;}return out;
}
fn p13_setup_bytes(b:[]u8,expected:i32,s:*P13Stats)i32 {
    // -1 requires a complete nonempty generated fixture; >=0 is a fixed
    // literal extent, including intentional empty payloads only when declared.
    let ok:i32=(expected>=0 && b.len==expected) as i32;
    if(expected==(-1)){ok=(b.len>0) as i32;}
    p13_check(s,"fixture_setup_byte_extent",ok,1);return ok;
}
fn p13_setup_words(b:[]i64,expected:i32,s:*P13Stats)i32 {
    let ok:i32=(expected>0 && b.len==expected) as i32;
    p13_check(s,"fixture_setup_word_capacity",ok,1);return ok;
}
fn p13_parse(raw:[]u8,s:*P13Stats)ParentMap {
    if(p13_setup_bytes(raw,-1,s)!=1){return pb_failed(-9113);}
    let p:ParentMap=pm_init(raw,512,1024,256,128);p13_check(s,"outer_native_parse",pm_scan(&p),0);
    if(p.status==0){p13_check(s,"outer_map_valid",pm_validate(&p),0);}return p;
}
fn p13_word_bytes(a:[]i64)[]u8 {let b:*u8=_zag_slice_ptr(a) as *u8;return b[0..a.len*8];}
fn p13_hash(b:[]u8,out:[]u8,w:*TsWork)i32 {
    if(ts_charge(&w.*.hash_bytes,w.*.max_hash_bytes,b.len)!=0){return -9111;}
    let code:i32=ns_sha256(b,out);if(code==(-12)){return -9107;}return code;
}
fn p13_fingerprint_hash(b:[]u8,out:[]u8,w:*TsWork,scratch:[]i64)i32 {
    // Same logical charge and no budget refund; only physical scratch changes.
    if(ts_charge(&w.*.hash_bytes,w.*.max_hash_bytes,b.len)!=0){return -9111;}
    return sh13_sha256(b,out,scratch);
}
fn p13_fingerprint(p:*ParentMap,w:*TsWork)[]u8 {
    let out:[]u8=nio_alloc(256);if(out.len!=256){return "";}
    let scratch:[]i64=pm_words(152);if(scratch.len!=152){nio_free(out);return "";}
    let code:i32=p13_fingerprint_hash(p.*.input,out[0..32],w,scratch);
    if(code==0){code=p13_fingerprint_hash(p13_word_bytes(p.*.nodes),out[32..64],w,scratch);}
    if(code==0){code=p13_fingerprint_hash(p13_word_bytes(p.*.edges),out[64..96],w,scratch);}
    if(code==0){code=p13_fingerprint_hash(p13_word_bytes(p.*.memo),out[96..128],w,scratch);}
    if(code==0){code=p13_fingerprint_hash(p13_word_bytes(p.*.stack),out[128..160],w,scratch);}
    if(code==0){code=p13_fingerprint_hash(p13_word_bytes(p.*.marks),out[160..192],w,scratch);}
    if(code==0){code=p13_fingerprint_hash(p13_word_bytes(p.*.globals),out[192..224],w,scratch);}
    if(code==0){code=p13_fingerprint_hash(p13_word_bytes(p.*.hist),out[224..256],w,scratch);}
    pm_free_words(scratch);if(code!=0){nio_free(out);return "";}return out;
}
fn p13_unchanged(p:*ParentMap,before:[]u8,s:*P13Stats,w:*TsWork)void {
    let after:[]u8=p13_fingerprint(p,w);
    p13_check(s,"source_and_seven_tables_unchanged",(before.len==256 && after.len==256 && nio_equal(before,after)==1) as i32,1);nio_free(after);
}
fn p13_find(b:[]u8,text:[]u8)i32 {
    let i:i32=0;while(i+text.len<=b.len){if(nio_equal(b[i..i+text.len],text)==1){return i;}i=i+1;}return -1;
}
fn p13_overlap(a:[]u8,b:[]u8)i32 {
    if(a.len==0 || b.len==0){return 0;}let x:i64=_zag_slice_ptr(a) as i64;let y:i64=_zag_slice_ptr(b) as i64;
    return (x<y+b.len && y<x+a.len) as i32;
}
fn p13_empty_view(v:*TsView,code:i32,s:*P13Stats)void {
    p13_check(s,"precise_refusal",v.*.status,code);p13_check(s,"refusal_no_shapes",v.*.dims.len+v.*.strides.len,0);
    p13_check(s,"refusal_no_source",v.*.source,0);p13_check(s,"refusal_no_payload",v.*.bytes,0);
}
fn p13_work_log(w:*TsWork)void {
    _zag_print("N13A_WORK_OPENS,");_zag_println(_zag_i64_to_str(w.*.opens));
    _zag_print("N13A_WORK_RECORDS,");_zag_println(_zag_i64_to_str(w.*.records));
    _zag_print("N13A_WORK_PROBES,");_zag_println(_zag_i64_to_str(w.*.probes));
    _zag_print("N13A_WORK_ROWS,");_zag_println(_zag_i64_to_str(w.*.rows));
    _zag_print("N13A_WORK_HASH_BYTES,");_zag_println(_zag_i64_to_str(w.*.hash_bytes));
    _zag_print("N13A_WORK_SHAPE_ALLOCS,");_zag_println(_zag_i64_to_str(w.*.shape_allocs));
}

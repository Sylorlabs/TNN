// Native subprocess supervision. Exactly one executable/one argument, empty
// environment; child stdout/stderr are exclusive files in the caller-owned root.
// Trusted engineering harness only, not a hostile-code isolation certificate.
@import("R33_NATIVE_IO_V1.zag")

struct NativeRun {
    started:i32,
    exit_code:i32,
    signal:i32,
    cpu_us:i64,
    peak_rss:i64,
    stdout_bytes:i64,
    stderr_bytes:i64,
}

fn nr_run(root:i64,binary:[]u8,mode:[]u8,label:[]u8)NativeRun {
    let result:NativeRun=NativeRun{.started=0,.exit_code=-1,.signal=0,.cpu_us=0,.peak_rss=0,.stdout_bytes=-1,.stderr_bytes=-1};
    if(nio_name_valid(label)!=1){return result;}
    let oname:[]u8=_zag_str_concat(label,".stdout");
    let ename:[]u8=_zag_str_concat(label,".stderr");
    let out:i64=nio_open_child(root,oname,1);let err:i64=nio_open_child(root,ename,1);
    nio_free(oname);nio_free(ename);
    if(out<0 || err<0){if(out>=0){nio_close(out);}if(err>=0){nio_close(err);}return result;}
    let b:[]u8=nio_cstr(binary);let m:[]u8=nio_cstr(mode);
    let argv:*i64=_zag_malloc(24) as *i64;let env:*i64=_zag_malloc(8) as *i64;
    let status:*i32=_zag_malloc(8) as *i32;let usage:*i64=_zag_malloc(256) as *i64;
    if(b.len==0 || m.len==0 || argv==null as *i64 || env==null as *i64 ||
       status==null as *i32 || usage==null as *i64){
        nio_close(out);nio_close(err);nio_free(b);nio_free(m);
        if(argv!=null as *i64){_zag_free(argv as *i8);}
        if(env!=null as *i64){_zag_free(env as *i8);}
        if(status!=null as *i32){_zag_free(status as *i8);}
        if(usage!=null as *i64){_zag_free(usage as *i8);}return result;
    }
    argv[0]=_zag_slice_ptr(b) as i64;argv[1]=_zag_slice_ptr(m) as i64;argv[2]=0;env[0]=0;
    status[0]=0;let i:i32=0;while(i<32){usage[i]=0;i=i+1;}
    let pid:i64=_zag_darwin_fork();
    if(pid==0){
        if(_zag_darwin_syscall(90,out,1,0,0,0,0)<0 || _zag_darwin_syscall(90,err,2,0,0,0,0)<0){_zag_exit(126);}
        nio_close(out);nio_close(err);
        _zag_darwin_syscall(59,_zag_slice_ptr(b) as i64,argv as i64,env as i64,0,0,0);
        _zag_exit(127);
    }
    if(pid>0){
        result.started=1;
        let waited:i64=_zag_darwin_syscall(7,pid,status as i64,0,usage as i64,0,0);
        let retries:i32=0;
        while(waited==-4 && retries<64){waited=_zag_darwin_syscall(7,pid,status as i64,0,usage as i64,0,0);retries=retries+1;}
        if(waited==pid){
            result.signal=status[0] & 127;
            if(result.signal==0){result.exit_code=(status[0]>>8)&255;}
            result.cpu_us=usage[0]*1000000+usage[1]+usage[2]*1000000+usage[3];
            result.peak_rss=usage[4];
        }else{
            _zag_darwin_syscall(37,pid,9,0,0,0,0);
            _zag_darwin_syscall(7,pid,status as i64,0,usage as i64,0,0);
        }
    }
    result.stdout_bytes=nio_seek(out,0,2);result.stderr_bytes=nio_seek(err,0,2);
    nio_close(out);nio_close(err);
    nio_free(b);nio_free(m);_zag_free(argv as *i8);_zag_free(env as *i8);
    _zag_free(status as *i8);_zag_free(usage as *i8);
    _zag_print("PROCESS,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(result.exit_code as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(result.signal as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(result.cpu_us));_zag_print(",");
    _zag_print(_zag_i64_to_str(result.peak_rss));_zag_print(",");
    _zag_print(_zag_i64_to_str(result.stdout_bytes));_zag_print(",");
    _zag_println(_zag_i64_to_str(result.stderr_bytes));
    return result;
}

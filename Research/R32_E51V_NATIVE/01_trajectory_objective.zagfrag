// R32 E51V — trajectory-critical multiple-instance objective on fixed 32-cell linear experts.

const E51V_DEV_EPISODES:i32=12960;
const E51V_DEV_SAMPLES:i32=220320;
const E51V_VALIDATION_EPISODES:i32=5400;
const E51V_VALIDATION_SAMPLES:i32=91800;
const E51V_CONFIRM_EPISODES:i32=10800;
const E51V_CONFIRM_SAMPLES:i32=183600;
const E51V_STAGE_DEV:i32=75;
const E51V_STAGE_VALIDATION:i32=76;
const E51V_STAGE_CONFIRM:i32=77;
const E51V_CELLS:i32=32;
const E51V_MAX_ROUNDS:i32=4;
const E51V_ARMS:i32=4;

fn e51v_allocate_worlds(dev:[]i32,validation:[]i32,confirmation:[]i32)i32 {
    let i:i32=0; while(i<E51V_DEV_EPISODES){ dev[i]=e51n_world_id(E51V_STAGE_DEV,i); i=i+1; }
    i=0; while(i<E51V_VALIDATION_EPISODES){ validation[i]=e51n_world_id(E51V_STAGE_VALIDATION,i); i=i+1; }
    i=0; while(i<E51V_CONFIRM_EPISODES){ confirmation[i]=e51n_world_id(E51V_STAGE_CONFIRM,i); i=i+1; }
    let dlo:i32=dev[0]; let dhi:i32=dev[E51V_DEV_EPISODES-1]; let vlo:i32=validation[0]; let vhi:i32=validation[E51V_VALIDATION_EPISODES-1]; let clo:i32=confirmation[0]; let chi:i32=confirmation[E51V_CONFIRM_EPISODES-1];
    let partition:i32=0; if(dhi<vlo && vhi<clo){ partition=1; }
    let domains:i32=1; let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(dlo,d); let hi:i64=e51n_domain_state(chi,d); if(lo<=0 || hi>=E51N_RNG_MOD){ domains=0; }
        let o:i32=d+1; while(o<5){ let olo:i64=e51n_domain_state(dlo,o); let ohi:i64=e51n_domain_state(chi,o); if(!(hi<olo || ohi<lo)){ domains=0; } o=o+1; }
        d=d+1;
    }
    e45_print_pair("e51v_world_id_dev_lo",dlo); e45_print_pair("e51v_world_id_dev_hi",dhi); e45_print_pair("e51v_world_id_validation_lo",vlo); e45_print_pair("e51v_world_id_validation_hi",vhi); e45_print_pair("e51v_world_id_confirmation_lo",clo); e45_print_pair("e51v_world_id_confirmation_hi",chi); e45_print_pair("e51v_world_partition_gate",partition); e45_print_pair("e51v_domain_gate",domains); e45_print_pair("e51v_world_assignment_failures",0);
    if(partition==1 && domains==1){ return 1; } return 0;
}

fn e51v_copy_expert(src_w:[]i32,src_ws:i32,src_b:[]i32,src_bs:i32,dst_w:[]i32,dst_ws:i32,dst_b:[]i32,dst_bs:i32)void {
    let cell:i32=0;
    while(cell<E51V_CELLS){
        dst_b[dst_bs+cell]=src_b[src_bs+cell];
        let f:i32=0; while(f<E45_FEATURES){ dst_w[dst_ws+cell*E45_FEATURES+f]=src_w[src_ws+cell*E45_FEATURES+f]; f=f+1; }
        cell=cell+1;
    }
}

fn e51v_expert_equal(a_w:[]i32,a_ws:i32,a_b:[]i32,a_bs:i32,b_w:[]i32,b_ws:i32,b_b:[]i32,b_bs:i32)i32 {
    let cell:i32=0;
    while(cell<E51V_CELLS){
        if(a_b[a_bs+cell]!=b_b[b_bs+cell]){ return 0; }
        let f:i32=0; while(f<E45_FEATURES){ if(a_w[a_ws+cell*E45_FEATURES+f]!=b_w[b_ws+cell*E45_FEATURES+f]){ return 0; } f=f+1; }
        cell=cell+1;
    }
    return 1;
}

fn e51v_episode_has_positive(targets:[]i32,episode:i32)i32 {
    let t:i32=0; while(t<=E45_TAPE){ if(targets[episode*(E45_TAPE+1)+t]>0){ return 1; } t=t+1; } return 0;
}

fn e51v_trajectory_loss(
    records:[]i32,targets:[]i32,episodes:i32,
    global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    reachable:*i32
)i64 {
    let loss:i64=0; reachable.*=0; let episode:i32=0;
    while(episode<episodes){
        let positive:i32=e51v_episode_has_positive(targets,episode);
        let chosen:i32=0;
        if(positive==1){
            let best:i32=-5000; let t:i32=0;
            while(t<=E45_TAPE){
                let idx:i32=episode*(E45_TAPE+1)+t;
                if(targets[idx]>0){
                    let score:i32=e51p_expert_predict(records,idx*E50_RECORD_N,global_weights,global_bias,prototypes,parents,ranges,E51V_CELLS,expert_weights,weight_start,expert_biases,bias_start);
                    if(score>best){ best=score; }
                }
                t=t+1;
            }
            if(best>=0){ chosen=1; }else{ let v:i64=(0-best) as i64; loss=loss+v*v; }
        }else{
            let best:i32=5000; let t:i32=0;
            while(t<=E45_TAPE){
                let idx:i32=episode*(E45_TAPE+1)+t;
                let score:i32=e51p_expert_predict(records,idx*E50_RECORD_N,global_weights,global_bias,prototypes,parents,ranges,E51V_CELLS,expert_weights,weight_start,expert_biases,bias_start);
                if(score<best){ best=score; }
                t=t+1;
            }
            if(best<0){ chosen=1; }else{ let v:i64=(best+1) as i64; loss=loss+v*v; }
        }
        if(chosen==1){ reachable.*=reachable.*+1; }
        episode=episode+1;
    }
    return loss;
}

fn e51v_select_critical(
    records:[]i32,targets:[]i32,episodes:i32,
    global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    critical_records:[]i32,critical_targets:[]i32,selected_indices:[]i32,
    trace_hash:*i32
)void {
    trace_hash.*=3301;
    let episode:i32=0;
    while(episode<episodes){
        let positive:i32=e51v_episode_has_positive(targets,episode);
        let selected:i32=-1;
        let best:i32=-5000; if(positive==0){ best=5000; }
        let t:i32=0;
        while(t<=E45_TAPE){
            let idx:i32=episode*(E45_TAPE+1)+t;
            if(positive==1){
                if(targets[idx]>0){
                    let score:i32=e51p_expert_predict(records,idx*E50_RECORD_N,global_weights,global_bias,prototypes,parents,ranges,E51V_CELLS,expert_weights,weight_start,expert_biases,bias_start);
                    if(selected<0 || score>best){ selected=idx; best=score; }
                }
            }else{
                let score:i32=e51p_expert_predict(records,idx*E50_RECORD_N,global_weights,global_bias,prototypes,parents,ranges,E51V_CELLS,expert_weights,weight_start,expert_biases,bias_start);
                if(selected<0 || score<best){ selected=idx; best=score; }
            }
            t=t+1;
        }
        selected_indices[episode]=selected;
        let src:i32=selected*E50_RECORD_N; let dst:i32=episode*E50_RECORD_N; let c:i32=0;
        while(c<E50_RECORD_N){ critical_records[dst+c]=records[src+c]; c=c+1; }
        critical_targets[episode]=targets[selected];
        trace_hash.*=e46_hash_update(trace_hash.*,episode); trace_hash.*=e46_hash_update(trace_hash.*,selected); trace_hash.*=e46_hash_update(trace_hash.*,critical_targets[episode]);
        episode=episode+1;
    }
}

fn e51v_fit_trajectory(
    records:[]i32,targets:[]i32,episodes:i32,
    global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,
    initial_weights:[]i32,initial_weight_start:i32,initial_biases:[]i32,initial_bias_start:i32,
    reverse:i32,
    first_weights:[]i32,first_biases:[]i32,final_weights:[]i32,final_biases:[]i32,
    accepted_rounds:*i32,selection_trace:*i32,fit_trace:*i32,final_loss:*i64,strict_gate:*i32
)void {
    let current_weights:[]i32=zalloc_i(E51V_CELLS*E45_FEATURES); let current_biases:[]i32=zalloc_i(E51V_CELLS);
    e51v_copy_expert(initial_weights,initial_weight_start,initial_biases,initial_bias_start,current_weights,0,current_biases,0);
    let current_reachable:i32=0; let current_loss:i64=e51v_trajectory_loss(records,targets,episodes,global_weights,global_bias,prototypes,parents,ranges,current_weights,0,current_biases,0,&current_reachable);
    accepted_rounds.*=0; selection_trace.*=3401; fit_trace.*=3501; strict_gate.*=1;
    e45_zero(first_weights,E51V_CELLS*E45_FEATURES); e45_zero(first_biases,E51V_CELLS); e45_zero(final_weights,E51V_CELLS*E45_FEATURES); e45_zero(final_biases,E51V_CELLS);

    let round:i32=0;
    while(round<E51V_MAX_ROUNDS){
        let critical_records:[]i32=zalloc_i(episodes*E50_RECORD_N); let critical_targets:[]i32=zalloc_i(episodes); let selected:[]i32=zalloc_i(episodes); let round_selection:i32=0;
        e51v_select_critical(records,targets,episodes,global_weights,global_bias,prototypes,parents,ranges,current_weights,0,current_biases,0,critical_records,critical_targets,selected,&round_selection);
        let candidate_weights:[]i32=zalloc_i(E51V_CELLS*E45_FEATURES); let candidate_biases:[]i32=zalloc_i(E51V_CELLS);
        let updates:i32=0; let sweeps:i32=0; let reason:i32=0; let trace:i32=0; let state_loss:i64=0; let fit_strict:i32=0;
        e51p_fit_experts(critical_records,critical_targets,episodes,global_weights,global_bias,prototypes,parents,ranges,E51V_CELLS,reverse,candidate_weights,0,candidate_biases,0,&updates,&sweeps,&reason,&trace,&state_loss,&fit_strict);
        let candidate_reachable:i32=0; let candidate_loss:i64=e51v_trajectory_loss(records,targets,episodes,global_weights,global_bias,prototypes,parents,ranges,candidate_weights,0,candidate_biases,0,&candidate_reachable);
        selection_trace.*=e46_hash_update(selection_trace.*,round); selection_trace.*=e46_hash_update(selection_trace.*,round_selection);
        fit_trace.*=e46_hash_update(fit_trace.*,round); fit_trace.*=e46_hash_update(fit_trace.*,updates); fit_trace.*=e46_hash_update(fit_trace.*,sweeps); fit_trace.*=e46_hash_update(fit_trace.*,reason); fit_trace.*=e46_hash_update(fit_trace.*,trace); fit_trace.*=e46_hash_update(fit_trace.*,e51m_hash_i64(candidate_loss));
        if(fit_strict!=1){ strict_gate.*=0; }
        if(candidate_loss<current_loss){
            if(accepted_rounds.*==0){ e51v_copy_expert(candidate_weights,0,candidate_biases,0,first_weights,0,first_biases,0); }
            e51v_copy_expert(candidate_weights,0,candidate_biases,0,current_weights,0,current_biases,0);
            current_loss=candidate_loss; accepted_rounds.*=accepted_rounds.*+1;
        }else{
            zfree(critical_records); zfree(critical_targets); zfree(selected); zfree(candidate_weights); zfree(candidate_biases); break;
        }
        zfree(critical_records); zfree(critical_targets); zfree(selected); zfree(candidate_weights); zfree(candidate_biases);
        round=round+1;
    }
    if(accepted_rounds.*>0){ e51v_copy_expert(current_weights,0,current_biases,0,final_weights,0,final_biases,0); }
    final_loss.*=current_loss;
    zfree(current_weights); zfree(current_biases);
}

fn e51v_trajectory_identity(
    a_first_w:[]i32,a_first_b:[]i32,a_final_w:[]i32,a_final_b:[]i32,a_rounds:i32,a_selection:i32,a_fit:i32,a_loss:i64,a_strict:i32,
    b_first_w:[]i32,b_first_b:[]i32,b_final_w:[]i32,b_final_b:[]i32,b_rounds:i32,b_selection:i32,b_fit:i32,b_loss:i64,b_strict:i32
)i32 {
    if(a_rounds!=b_rounds || a_selection!=b_selection || a_fit!=b_fit || a_loss!=b_loss || a_strict!=1 || b_strict!=1){ return 0; }
    if(e51v_expert_equal(a_first_w,0,a_first_b,0,b_first_w,0,b_first_b,0)==0){ return 0; }
    if(e51v_expert_equal(a_final_w,0,a_final_b,0,b_final_w,0,b_final_b,0)==0){ return 0; }
    return 1;
}

fn e51v_episode_reached(
    records:[]i32,episode:i32,no_unique:i32,terminal_weights:[]i32,terminal_biases:[]i32,
    global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32
)i32 {
    let t:i32=0;
    while(t<=E45_TAPE){
        let rs:i32=(episode*(E45_TAPE+1)+t)*E50_RECORD_N;
        let action:i32=e51m_top_commit(records,rs,terminal_weights,terminal_biases);
        let score:i32=e51p_expert_predict(records,rs,global_weights,global_bias,prototypes,parents,ranges,E51V_CELLS,expert_weights,weight_start,expert_biases,bias_start);
        if(no_unique==1){ if(score<0){ return 1; } }else{ if(score>=0 && records[rs+34+action]==1000){ return 1; } }
        t=t+1;
    }
    return 0;
}

fn e51v_episode_type_from_targets(targets:[]i32,episode:i32)i32 {
    if(e51v_episode_has_positive(targets,episode)==1){ return 0; } return 1;
}

fn e51v_validation_mode(episode:i32,per_cell:i32)i32 {
    return e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES);
}

fn e51v_switch_mode(mode:i32)i32 { if(mode==3 || mode==4 || mode==5 || mode==7 || mode==8){ return 1; } return 0; }

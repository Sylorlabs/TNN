fn e51v_build_records(
    worlds:[]i32,episodes:i32,per_cell:i32,
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32,
    records:[]i32,unknown_nonzero:*i32
)i32 {
    let dummy:[]i32=zalloc_i(episodes*(E45_TAPE+1)*E50_RECORD_N); e45_zero(dummy,episodes*(E45_TAPE+1)*E50_RECORD_N);
    let dp:i32=0; let dn:i32=0; let canonical:i32=0;
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<per_cell){
                    let index:i32=0;
                    if(per_cell==20){ index=e46_validation_index(base_index,mode,resource,episode); }
                    if(per_cell==40){ index=e46_confirm_index(base_index,mode,resource,episode); }
                    e51e_build_training_episode(worlds[index],mode,resource,canonical,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,records,dummy,unknown_nonzero,&dp,&dn);
                    canonical=canonical+1; episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    zfree(dummy); return canonical;
}

fn e51v_eval_arm(
    records:[]i32,targets:[]i32,episodes:i32,per_cell:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    control_reached:[]i32,write_control:i32,
    known_total:*i32,known_reachable:*i32,no_unique_total:*i32,no_unique_reachable:*i32,gained:*i32,lost:*i32,switch_lost:*i32,
    mode_success:[]i32
)void {
    known_total.*=0; known_reachable.*=0; no_unique_total.*=0; no_unique_reachable.*=0; gained.*=0; lost.*=0; switch_lost.*=0; e45_zero(mode_success,E45_MODES);
    let episode:i32=0;
    while(episode<episodes){
        let no_unique:i32=e51v_episode_type_from_targets(targets,episode);
        let reached:i32=e51v_episode_reached(records,episode,no_unique,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,expert_weights,weight_start,expert_biases,bias_start);
        let mode:i32=e51v_validation_mode(episode,per_cell); if(reached==1){ mode_success[mode]=mode_success[mode]+1; }
        if(no_unique==1){ no_unique_total.*=no_unique_total.*+1; if(reached==1){ no_unique_reachable.*=no_unique_reachable.*+1; }
        }else{ known_total.*=known_total.*+1; if(reached==1){ known_reachable.*=known_reachable.*+1; } }
        if(write_control==1){ control_reached[episode]=reached; }
        else{
            if(reached==1 && control_reached[episode]==0){ gained.*=gained.*+1; }
            if(reached==0 && control_reached[episode]==1){ lost.*=lost.*+1; if(e51v_switch_mode(mode)==1){ switch_lost.*=switch_lost.*+1; } }
        }
        episode=episode+1;
    }
}

fn e51v_run(
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32
)i32 {
    _zag_println("R32_E51V_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51v_trajectory_critical_objective_v1");
    _zag_println("claim_boundary,native_trajectory_objective_discriminator_not_promotion");
    _zag_println("native_zag_v2_only=1"); _zag_println("evaluator_truth_exposed=0"); _zag_println("ambiguity_label_exposed=0"); _zag_println("validation_membership_exposed=0"); _zag_println("unknown_positive_target=0"); _zag_println("commit_order_changed=0"); _zag_println("routing_cells_fixed=32"); _zag_println("new_features_added=0"); _zag_println("cross_cell_edges_added=0"); _zag_println("graph_privileged=0"); _zag_println("trajectory_objective_only=1");

    let dev_worlds:[]i32=zalloc_i(E51V_DEV_EPISODES); let val_worlds:[]i32=zalloc_i(E51V_VALIDATION_EPISODES); let con_worlds:[]i32=zalloc_i(E51V_CONFIRM_EPISODES);
    let world_gate:i32=e51v_allocate_worlds(dev_worlds,val_worlds,con_worlds);
    let dev_records:[]i32=zalloc_i(E51V_DEV_SAMPLES*E50_RECORD_N); e45_zero(dev_records,E51V_DEV_SAMPLES*E50_RECORD_N);
    let dummy:[]i32=zalloc_i(E51V_DEV_SAMPLES*E50_RECORD_N); e45_zero(dummy,E51V_DEV_SAMPLES*E50_RECORD_N);
    let dev_unknown:i32=0; let dp:i32=0; let dn:i32=0; let canonical:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(dev_worlds[index],mode,resource,canonical,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_records,dummy,&dev_unknown,&dp,&dn);
                        canonical=canonical+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    zfree(dummy); e45_print_pair("e51v_development_episodes_built",canonical); e45_print_pair("e51v_development_states_built",canonical*(E45_TAPE+1)); e45_print_pair("e51v_dev_unknown_target_nonzero",dev_unknown);

    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES); let backup_biases:[]i32=zalloc_i(4); let gram_f:[]i32=zalloc_i(E50_BATCH_GRAM); let gram_r:[]i32=zalloc_i(E50_BATCH_GRAM); let cross_f:[]i32=zalloc_i(E50_BATCH_CROSS); let cross_r:[]i32=zalloc_i(E50_BATCH_CROSS); let copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4); e45_zero(copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(dev_records,0,0,terminal_weights,terminal_biases,backup_weights,backup_biases,gram_f,gram_r,cross_f,cross_r,copy_weights,copy_biases);
    let unknown_parameter_nonzero:i32=0; if(terminal_biases[3]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; }
    let f:i32=0; while(f<E45_FEATURES){ if(terminal_weights[3*E45_FEATURES+f]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; } f=f+1; }

    let sign_targets:[]i32=zalloc_i(E51V_DEV_SAMPLES); let dev_pos:i32=0; let dev_neg:i32=0; let dev_zero:i32=0;
    e51m_build_targets(dev_records,E51V_DEV_SAMPLES,terminal_weights,terminal_biases,sign_targets,&dev_pos,&dev_neg,&dev_zero);
    let global_weights:[]i32=zalloc_i(E45_FEATURES); let global_bias:i32=0; let ls_f:i32=0; let lr_f:i32=0; let lt_f:i32=0; let ll_f:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51V_DEV_SAMPLES,0,global_weights,0,&global_bias,&ls_f,&lr_f,&lt_f,&ll_f);
    let reverse_global:[]i32=zalloc_i(E45_FEATURES); let reverse_bias:i32=0; let ls_r:i32=0; let lr_r:i32=0; let lt_r:i32=0; let ll_r:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51V_DEV_SAMPLES,1,reverse_global,0,&reverse_bias,&ls_r,&lr_r,&lt_r,&ll_r);
    let global_identity:i32=e51m_linear_identity(global_weights,0,global_bias,reverse_global,0,reverse_bias,ls_f,ls_r,lr_f,lr_r,lt_f,lt_r,ll_f,ll_r);

    let prototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let parents:[]i32=zalloc_i(E51O_MAX_CELLS); let scalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let scalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let scalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tc_f:i32=0; let tt_f:i32=0; let tl_f:i64=0; let ts_f:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51V_DEV_SAMPLES,global_weights,0,global_bias,0,prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,&tc_f,&tt_f,&tl_f,&ts_f);
    let rprototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let rparents:[]i32=zalloc_i(E51O_MAX_CELLS); let rscalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let rscalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let rscalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tc_r:i32=0; let tt_r:i32=0; let tl_r:i64=0; let ts_r:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51V_DEV_SAMPLES,global_weights,0,global_bias,1,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,&tc_r,&tt_r,&tl_r,&ts_r);
    let tree_identity:i32=e51o_local_identity(prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,tc_f,tt_f,tl_f,ts_f,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,tc_r,tt_r,tl_r,ts_r);
    let ranges:[]i32=zalloc_i(E45_FEATURES); let root:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(dev_records,E51V_DEV_SAMPLES,root,ranges);

    let sw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let sb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let su:[]i32=zalloc_i(E51S_SNAPSHOTS); let ss:[]i32=zalloc_i(E51S_SNAPSHOTS); let sr:[]i32=zalloc_i(E51S_SNAPSHOTS); let st:[]i32=zalloc_i(E51S_SNAPSHOTS); let sll:[]i32=zalloc_i(E51S_SNAPSHOTS); let slh:[]i32=zalloc_i(E51S_SNAPSHOTS); let strict_state_f:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51V_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,0,sw,sb,su,ss,sr,st,sll,slh,&strict_state_f);
    let rw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let rb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let ru:[]i32=zalloc_i(E51S_SNAPSHOTS); let rs:[]i32=zalloc_i(E51S_SNAPSHOTS); let rr:[]i32=zalloc_i(E51S_SNAPSHOTS); let rt:[]i32=zalloc_i(E51S_SNAPSHOTS); let rll:[]i32=zalloc_i(E51S_SNAPSHOTS); let rlh:[]i32=zalloc_i(E51S_SNAPSHOTS); let strict_state_r:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51V_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,1,rw,rb,ru,rs,rr,rt,rll,rlh,&strict_state_r);
    let snapshot_identity:i32=e51s_snapshots_identity(sw,sb,su,ss,sr,st,sll,slh,rw,rb,ru,rs,rr,rt,rll,rlh);
    let a_ws:i32=1*E51P_MAX_CELLS*E45_FEATURES; let a_bs:i32=1*E51P_MAX_CELLS; let b_ws:i32=2*E51P_MAX_CELLS*E45_FEATURES; let b_bs:i32=2*E51P_MAX_CELLS;
    _zag_print("e51v_state_controls,"); e45_print_i32(ss[1]); _zag_print(","); e45_print_i32(su[1]); _zag_print(","); e45_print_i32(ss[2]); _zag_print(","); e45_print_i32(su[2]); _zag_println("");

    let first_w:[]i32=zalloc_i(E51V_CELLS*E45_FEATURES); let first_b:[]i32=zalloc_i(E51V_CELLS); let final_w:[]i32=zalloc_i(E51V_CELLS*E45_FEATURES); let final_b:[]i32=zalloc_i(E51V_CELLS);
    let rounds_f:i32=0; let sel_f:i32=0; let fit_f:i32=0; let traj_loss_f:i64=0; let traj_strict_f:i32=0;
    e51v_fit_trajectory(dev_records,sign_targets,E51V_DEV_EPISODES,global_weights,global_bias,prototypes,parents,ranges,sw,a_ws,sb,a_bs,0,first_w,first_b,final_w,final_b,&rounds_f,&sel_f,&fit_f,&traj_loss_f,&traj_strict_f);
    let rfirst_w:[]i32=zalloc_i(E51V_CELLS*E45_FEATURES); let rfirst_b:[]i32=zalloc_i(E51V_CELLS); let rfinal_w:[]i32=zalloc_i(E51V_CELLS*E45_FEATURES); let rfinal_b:[]i32=zalloc_i(E51V_CELLS);
    let rounds_r:i32=0; let sel_r:i32=0; let fit_r:i32=0; let traj_loss_r:i64=0; let traj_strict_r:i32=0;
    e51v_fit_trajectory(dev_records,sign_targets,E51V_DEV_EPISODES,global_weights,global_bias,prototypes,parents,ranges,sw,a_ws,sb,a_bs,1,rfirst_w,rfirst_b,rfinal_w,rfinal_b,&rounds_r,&sel_r,&fit_r,&traj_loss_r,&traj_strict_r);
    let trajectory_identity:i32=e51v_trajectory_identity(first_w,first_b,final_w,final_b,rounds_f,sel_f,fit_f,traj_loss_f,traj_strict_f,rfirst_w,rfirst_b,rfinal_w,rfinal_b,rounds_r,sel_r,fit_r,traj_loss_r,traj_strict_r);
    e45_print_pair("e51v_trajectory_forward_reverse_identity_gate",trajectory_identity); e45_print_pair("e51v_accepted_rounds",rounds_f); e45_print_pair("e51v_selection_trace_hash",sel_f); e45_print_pair("e51v_fit_trace_hash",fit_f); _zag_print("e51v_final_trajectory_loss,"); e45_print_i64(traj_loss_f); _zag_println("");

    let dev_reach:[]i32=zalloc_i(E51V_ARMS); let dev_loss_low:[]i32=zalloc_i(E51V_ARMS); let dev_loss_high:[]i32=zalloc_i(E51V_ARMS);
    let arm:i32=0;
    while(arm<E51V_ARMS){
        let ew:[]i32=sw; let ws:i32=a_ws; let eb:[]i32=sb; let bs:i32=a_bs;
        if(arm==1){ ws=b_ws; bs=b_bs; }
        if(arm==2 && rounds_f>0){ ew=first_w; ws=0; eb=first_b; bs=0; }
        if(arm==3 && rounds_f>0){ ew=final_w; ws=0; eb=final_b; bs=0; }
        let reached:i32=0; let loss:i64=e51v_trajectory_loss(dev_records,sign_targets,E51V_DEV_EPISODES,global_weights,global_bias,prototypes,parents,ranges,ew,ws,eb,bs,&reached); dev_reach[arm]=reached; dev_loss_low[arm]=e50_loss_low(loss); dev_loss_high[arm]=e50_loss_high(loss);
        _zag_print("e51v_development_trajectory,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(reached); _zag_print(","); e45_print_i32(dev_loss_low[arm]); _zag_print(","); e45_print_i32(dev_loss_high[arm]); _zag_println("");
        arm=arm+1;
    }

    let val_records:[]i32=zalloc_i(E51V_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(val_records,E51V_VALIDATION_SAMPLES*E50_RECORD_N); let val_unknown:i32=0; let val_count:i32=e51v_build_records(val_worlds,E51V_VALIDATION_EPISODES,20,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,val_records,&val_unknown);
    let val_targets:[]i32=zalloc_i(E51V_VALIDATION_SAMPLES); let val_pos:i32=0; let val_neg:i32=0; let val_zero:i32=0; e51m_build_targets(val_records,E51V_VALIDATION_SAMPLES,terminal_weights,terminal_biases,val_targets,&val_pos,&val_neg,&val_zero);
    e45_print_pair("e51v_validation_episodes_built",val_count); e45_print_pair("e51v_validation_states_built",val_count*(E45_TAPE+1)); e45_print_pair("e51v_validation_unknown_target_nonzero",val_unknown);

    let control_reached:[]i32=zalloc_i(E51V_VALIDATION_EPISODES); e45_zero(control_reached,E51V_VALIDATION_EPISODES); let results:[]i32=zalloc_i(E51V_ARMS*7); let val_sign:[]i32=zalloc_i(E51V_ARMS*4); let modes:[]i32=zalloc_i(E51V_ARMS*E45_MODES);
    arm=0;
    while(arm<E51V_ARMS){
        let ew:[]i32=sw; let ws:i32=a_ws; let eb:[]i32=sb; let bs:i32=a_bs;
        if(arm==1){ ws=b_ws; bs=b_bs; }
        if(arm==2 && rounds_f>0){ ew=first_w; ws=0; eb=first_b; bs=0; }
        if(arm==3 && rounds_f>0){ ew=final_w; ws=0; eb=final_b; bs=0; }
        let pt:i32=0; let pc:i32=0; let nt:i32=0; let nc:i32=0; e51p_expert_sign_accuracy(val_records,val_targets,E51V_VALIDATION_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,E51V_CELLS,ew,ws,eb,bs,&pt,&pc,&nt,&nc); val_sign[arm*4]=pc; val_sign[arm*4+1]=pt; val_sign[arm*4+2]=nc; val_sign[arm*4+3]=nt;
        let kt:i32=0; let kr:i32=0; let ut:i32=0; let ur:i32=0; let gain:i32=0; let loss:i32=0; let swloss:i32=0;
        let control:i32=0; if(arm==0){ control=1; }
        let mode_slice:[]i32=modes; e51v_eval_arm(val_records,val_targets,E51V_VALIDATION_EPISODES,20,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,ew,ws,eb,bs,control_reached,control,&kt,&kr,&ut,&ur,&gain,&loss,&swloss,mode_slice[arm*E45_MODES:]);
        results[arm*7]=kr; results[arm*7+1]=kt; results[arm*7+2]=ur; results[arm*7+3]=ut; results[arm*7+4]=gain; results[arm*7+5]=loss; results[arm*7+6]=swloss;
        arm=arm+1;
    }
    _zag_println("e51v_validation_columns,arm_0_state96_1_state192_2_trajectory_first_3_trajectory_final,known_reachable,known_total,no_unique_reachable,no_unique_total,paired_gained_vs96,paired_lost_vs96,switch_lost_vs96,val_pos_correct,val_pos_total,val_neg_correct,val_neg_total");
    arm=0; while(arm<E51V_ARMS){ _zag_print("e51v_validation,"); e45_print_i32(arm); let j:i32=0; while(j<7){ _zag_print(","); e45_print_i32(results[arm*7+j]); j=j+1; } j=0; while(j<4){ _zag_print(","); e45_print_i32(val_sign[arm*4+j]); j=j+1; } _zag_println(""); arm=arm+1; }
    _zag_println("e51v_mode_columns,arm,mode,total,success,control96_success"); arm=0; while(arm<E51V_ARMS){ let mode:i32=0; while(mode<E45_MODES){ _zag_print("e51v_mode,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(mode); _zag_print(",600,"); e45_print_i32(modes[arm*E45_MODES+mode]); _zag_print(","); e45_print_i32(modes[mode]); _zag_println(""); mode=mode+1; } arm=arm+1; }

    let counts_gate:i32=0; if(canonical==E51V_DEV_EPISODES && val_count==E51V_VALIDATION_EPISODES && results[0*7+1]==4200 && results[0*7+3]==1200){ counts_gate=1; }
    let target_gate:i32=0; if(dev_unknown==0 && val_unknown==0 && unknown_parameter_nonzero==0 && dev_pos>0 && dev_neg>0 && val_pos>0 && val_neg>0){ target_gate=1; }
    let integrity:i32=0; if(world_gate==1 && counts_gate==1 && target_gate==1 && base_fit_gate==1 && global_identity==1 && tree_identity==1 && snapshot_identity==1 && trajectory_identity==1 && traj_strict_f==1 && traj_strict_r==1){ integrity=1; }
    let exact_arm:i32=-1; let partial_arm:i32=-1; let tradeoff:i32=0;
    arm=2; while(arm<E51V_ARMS){
        let kr:i32=results[arm*7]; let ur:i32=results[arm*7+2]; let gained:i32=results[arm*7+4]; let lost:i32=results[arm*7+5]; let swlost:i32=results[arm*7+6];
        if(integrity==1 && kr==4200 && ur==1200 && swlost==0 && exact_arm<0){ exact_arm=arm; }
        if(integrity==1 && lost==0 && swlost==0 && ur>results[2] && ur>results[1*7+2] && partial_arm<0){ partial_arm=arm; }
        if((ur>results[2] && (lost>0 || swlost>0)) || (kr>results[0] && ur<results[2])){ tradeoff=1; }
        arm=arm+1;
    }
    e45_print_pair("e51v_counts_gate",counts_gate); e45_print_pair("e51v_target_geometry_gate",target_gate); e45_print_pair("e51v_integrity_gate",integrity); e45_print_pair("e51v_exact_validation_arm",exact_arm); e45_print_pair("e51v_partial_rescue_arm",partial_arm); e45_print_pair("e51v_tradeoff_gate",tradeoff);

    let confirmation_executed:i32=0; let confirmation_exact:i32=0;
    if(exact_arm>=0){
        let con_records:[]i32=zalloc_i(E51V_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(con_records,E51V_CONFIRM_SAMPLES*E50_RECORD_N); let con_unknown:i32=0; let con_count:i32=e51v_build_records(con_worlds,E51V_CONFIRM_EPISODES,40,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,con_records,&con_unknown); let con_targets:[]i32=zalloc_i(E51V_CONFIRM_SAMPLES); let cp:i32=0; let cn:i32=0; let cz:i32=0; e51m_build_targets(con_records,E51V_CONFIRM_SAMPLES,terminal_weights,terminal_biases,con_targets,&cp,&cn,&cz);
        let ew:[]i32=first_w; let eb:[]i32=first_b; if(exact_arm==3){ ew=final_w; eb=final_b; }
        let dummy_control:[]i32=zalloc_i(E51V_CONFIRM_EPISODES); let con_modes:[]i32=zalloc_i(E45_MODES); let kt:i32=0; let kr:i32=0; let ut:i32=0; let ur:i32=0; let ga:i32=0; let lo:i32=0; let sl:i32=0; e51v_eval_arm(con_records,con_targets,E51V_CONFIRM_EPISODES,40,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,ew,0,eb,0,dummy_control,1,&kt,&kr,&ut,&ur,&ga,&lo,&sl,con_modes); confirmation_executed=con_count; if(con_unknown==0 && kt==8400 && kr==8400 && ut==2400 && ur==2400){ confirmation_exact=1; }
        _zag_print("e51v_confirmation,"); e45_print_i32(exact_arm); _zag_print(","); e45_print_i32(kr); _zag_print(","); e45_print_i32(kt); _zag_print(","); e45_print_i32(ur); _zag_print(","); e45_print_i32(ut); _zag_println("");
        zfree(con_records); zfree(con_targets); zfree(dummy_control); zfree(con_modes);
    }
    e45_print_pair("e51v_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51v_confirmation_exact_gate",confirmation_exact);
    if(integrity==0){ _zag_println("e51v_outcome,INVALID_TRAJECTORY_OBJECTIVE_INTEGRITY_FAILURE"); }
    else if(exact_arm>=0 && confirmation_exact==1){ _zag_println("e51v_outcome,TRAJECTORY_OBJECTIVE_RESCUE_CONFIRMED"); }
    else if(exact_arm>=0){ _zag_println("e51v_outcome,TRAJECTORY_OBJECTIVE_VALIDATION_RESCUE_CONFIRMATION_FAIL"); }
    else if(partial_arm>=0){ _zag_println("e51v_outcome,TRAJECTORY_OBJECTIVE_PARTIAL_RESCUE"); }
    else if(tradeoff==1){ _zag_println("e51v_outcome,TRAJECTORY_OBJECTIVE_TRADEOFF"); }
    else{ _zag_println("e51v_outcome,NO_TESTED_TRAJECTORY_OBJECTIVE_RESCUE"); }
    _zag_println("TNN_R32_E51V_EXECUTION_COMPLETE=1");

    zfree(dev_worlds); zfree(val_worlds); zfree(con_worlds); zfree(dev_records); zfree(terminal_weights); zfree(terminal_biases); zfree(backup_weights); zfree(backup_biases); zfree(gram_f); zfree(gram_r); zfree(cross_f); zfree(cross_r); zfree(copy_weights); zfree(copy_biases); zfree(sign_targets); zfree(global_weights); zfree(reverse_global); zfree(prototypes); zfree(parents); zfree(scalar_snapshots); zfree(scalar_counts); zfree(scalar_losses); zfree(rprototypes); zfree(rparents); zfree(rscalar_snapshots); zfree(rscalar_counts); zfree(rscalar_losses); zfree(ranges); zfree(root); zfree(sw); zfree(sb); zfree(su); zfree(ss); zfree(sr); zfree(st); zfree(sll); zfree(slh); zfree(rw); zfree(rb); zfree(ru); zfree(rs); zfree(rr); zfree(rt); zfree(rll); zfree(rlh); zfree(first_w); zfree(first_b); zfree(final_w); zfree(final_b); zfree(rfirst_w); zfree(rfirst_b); zfree(rfinal_w); zfree(rfinal_b); zfree(dev_reach); zfree(dev_loss_low); zfree(dev_loss_high); zfree(val_records); zfree(val_targets); zfree(control_reached); zfree(results); zfree(val_sign); zfree(modes);
    if(integrity==1){ return 1; } return 0;
}

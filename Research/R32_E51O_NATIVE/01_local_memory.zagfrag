// R32 E51O — learner-owned local residual calibration memory.
// Same 32 learner-visible features, frozen commit ordering, neutral UNKNOWN.
// This is a bounded local memory/indexing mechanism, not a topology rewrite.

const E51O_DEV_EPISODES:i32=12960;
const E51O_DEV_SAMPLES:i32=220320;
const E51O_VALIDATION_EPISODES:i32=5400;
const E51O_VALIDATION_SAMPLES:i32=91800;
const E51O_CONFIRM_EPISODES:i32=10800;
const E51O_CONFIRM_SAMPLES:i32=183600;
const E51O_STAGE_DEV:i32=58;
const E51O_STAGE_VALIDATION:i32=59;
const E51O_STAGE_CONFIRM:i32=60;
const E51O_MAX_CELLS:i32=64;
const E51O_CAP_LEVELS:i32=4;

fn e51o_capacity(level:i32)i32 {
    if(level==0){ return 8; }
    if(level==1){ return 16; }
    if(level==2){ return 32; }
    return 64;
}

fn e51o_allocate_worlds(dev:[]i32,validation:[]i32,confirmation:[]i32)i32 {
    let i:i32=0;
    while(i<E51O_DEV_EPISODES){ dev[i]=e51n_world_id(E51O_STAGE_DEV,i); i=i+1; }
    i=0; while(i<E51O_VALIDATION_EPISODES){ validation[i]=e51n_world_id(E51O_STAGE_VALIDATION,i); i=i+1; }
    i=0; while(i<E51O_CONFIRM_EPISODES){ confirmation[i]=e51n_world_id(E51O_STAGE_CONFIRM,i); i=i+1; }
    let dev_lo:i32=dev[0]; let dev_hi:i32=dev[E51O_DEV_EPISODES-1];
    let val_lo:i32=validation[0]; let val_hi:i32=validation[E51O_VALIDATION_EPISODES-1];
    let con_lo:i32=confirmation[0]; let con_hi:i32=confirmation[E51O_CONFIRM_EPISODES-1];
    let partition_gate:i32=0; if(dev_hi<val_lo && val_hi<con_lo){ partition_gate=1; }
    let domain_gate:i32=1;
    let domain:i32=0;
    while(domain<5){
        let lo:i64=e51n_domain_state(dev_lo,domain);
        let hi:i64=e51n_domain_state(con_hi,domain);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domain_gate=0; }
        let other:i32=domain+1;
        while(other<5){
            let olo:i64=e51n_domain_state(dev_lo,other);
            let ohi:i64=e51n_domain_state(con_hi,other);
            if(!(hi<olo || ohi<lo)){ domain_gate=0; }
            other=other+1;
        }
        domain=domain+1;
    }
    e45_print_pair("e51o_world_id_dev_lo",dev_lo); e45_print_pair("e51o_world_id_dev_hi",dev_hi);
    e45_print_pair("e51o_world_id_validation_lo",val_lo); e45_print_pair("e51o_world_id_validation_hi",val_hi);
    e45_print_pair("e51o_world_id_confirmation_lo",con_lo); e45_print_pair("e51o_world_id_confirmation_hi",con_hi);
    e45_print_pair("e51o_world_partition_gate",partition_gate);
    e45_print_pair("e51o_domain_initial_state_gate",domain_gate);
    e45_print_pair("e51o_world_assignment_failures",0);
    if(partition_gate==1 && domain_gate==1){ return 1; }
    return 0;
}

fn e51o_feature_stats(records:[]i32,count:i32,root:[]i32,ranges:[]i32)void {
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let minv:i32=e50_batch_column(records,feature+1,0);
        let maxv:i32=minv;
        let sum:i64=0;
        let i:i32=0;
        while(i<count){
            let x:i32=e50_batch_column(records,i*E50_RECORD_N,feature+1,0);
            if(x<minv){ minv=x; }
            if(x>maxv){ maxv=x; }
            sum=sum+(x as i64);
            i=i+1;
        }
        root[feature]=(sum/(count as i64)) as i32;
        ranges[feature]=maxv-minv;
        feature=feature+1;
    }
}

fn e51o_distance_record_proto(
    records:[]i32,
    record_start:i32,
    prototypes:[]i32,
    proto_start:i32,
    ranges:[]i32
)i32 {
    let total:i64=0;
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let scale:i32=ranges[feature];
        if(scale>0){
            let x:i32=e50_batch_column(records,record_start,feature+1,0);
            let d:i32=r32e45_abs(x-prototypes[proto_start+feature]);
            total=total+(d as i64)*1000/(scale as i64);
        }
        feature=feature+1;
    }
    return e51m_clamp_i64(total,0,1000000);
}

fn e51o_base_predictions(
    records:[]i32,
    count:i32,
    linear_weights:[]i32,
    linear_start:i32,
    linear_bias:i32,
    out:[]i32
)void {
    let i:i32=0;
    while(i<count){
        out[i]=e51m_linear_scalar_predict(records,i*E50_RECORD_N,linear_weights,linear_start,linear_bias);
        i=i+1;
    }
}

fn e51o_refit_corrections(
    targets:[]i32,
    base_predictions:[]i32,
    assignments:[]i32,
    count:i32,
    cells:i32,
    reverse:i32,
    corrections:[]i32,
    cell_counts:[]i32,
    sums:[]i64
)i64 {
    let cell:i32=0;
    while(cell<E51O_MAX_CELLS){ corrections[cell]=0; cell_counts[cell]=0; sums[cell]=0; cell=cell+1; }
    let traversal:i32=0;
    while(traversal<count){
        let index:i32=traversal;
        if(reverse==1){ index=count-1-traversal; }
        let c:i32=assignments[index];
        let residual:i32=targets[index]-base_predictions[index];
        cell_counts[c]=cell_counts[c]+1;
        sums[c]=sums[c]+(residual as i64);
        traversal=traversal+1;
    }
    cell=0;
    while(cell<cells){
        if(cell_counts[cell]>0){ corrections[cell]=e51m_clamp_i64(sums[cell]/(cell_counts[cell] as i64),-3000,3000); }
        cell=cell+1;
    }
    let loss:i64=0;
    traversal=0;
    while(traversal<count){
        let index:i32=traversal;
        if(reverse==1){ index=count-1-traversal; }
        let predicted:i32=r32e45_clamp(base_predictions[index]+corrections[assignments[index]],-4000,4000);
        let error:i64=(targets[index]-predicted) as i64;
        loss=loss+error*error;
        traversal=traversal+1;
    }
    return loss;
}

fn e51o_copy_corrections(src:[]i32,dst:[]i32,dst_start:i32)void {
    let cell:i32=0;
    while(cell<E51O_MAX_CELLS){ dst[dst_start+cell]=src[cell]; cell=cell+1; }
}

fn e51o_fit_local_memory(
    records:[]i32,
    targets:[]i32,
    count:i32,
    linear_weights:[]i32,
    linear_start:i32,
    linear_bias:i32,
    reverse:i32,
    prototypes:[]i32,
    parents:[]i32,
    snapshot_corrections:[]i32,
    snapshot_counts:[]i32,
    snapshot_losses:[]i64,
    accepted_count:*i32,
    trace_hash:*i32,
    final_loss:*i64,
    strict_loss_gate:*i32
)void {
    let ranges:[]i32=zalloc_i(E45_FEATURES);
    let root:[]i32=zalloc_i(E45_FEATURES);
    let base_predictions:[]i32=zalloc_i(count);
    let assignments:[]i32=zalloc_i(count);
    let parent_distance:[]i32=zalloc_i(count);
    let rejected:[]i32=zalloc_i(count);
    let moved_indices:[]i32=zalloc_i(count);
    let moved_old_distance:[]i32=zalloc_i(count);
    let corrections:[]i32=zalloc_i(E51O_MAX_CELLS);
    let backup_corrections:[]i32=zalloc_i(E51O_MAX_CELLS);
    let cell_counts:[]i32=zalloc_i(E51O_MAX_CELLS);
    let sums:[]i64=zalloc_l(E51O_MAX_CELLS);

    e45_zero(prototypes,E51O_MAX_CELLS*E45_FEATURES); e45_zero(parents,E51O_MAX_CELLS);
    e45_zero(snapshot_corrections,E51O_CAP_LEVELS*E51O_MAX_CELLS); e45_zero(snapshot_counts,E51O_CAP_LEVELS);
    e45_zero(assignments,count); e45_zero(parent_distance,count); e45_zero(rejected,count); e45_zero(corrections,E51O_MAX_CELLS); e45_zero(backup_corrections,E51O_MAX_CELLS); e45_zero(cell_counts,E51O_MAX_CELLS);
    let si:i32=0; while(si<E51O_CAP_LEVELS){ snapshot_losses[si]=0; si=si+1; }
    let li:i32=0; while(li<E51O_MAX_CELLS){ sums[li]=0; li=li+1; }

    e51o_feature_stats(records,count,root,ranges);
    let feature:i32=0; while(feature<E45_FEATURES){ prototypes[feature]=root[feature]; feature=feature+1; }
    parents[0]=-1;
    e51o_base_predictions(records,count,linear_weights,linear_start,linear_bias,base_predictions);
    let i:i32=0;
    while(i<count){
        assignments[i]=0;
        parent_distance[i]=e51o_distance_record_proto(records,i*E50_RECORD_N,prototypes,0,ranges);
        i=i+1;
    }
    let cells:i32=1;
    let current_loss:i64=e51o_refit_corrections(targets,base_predictions,assignments,count,cells,reverse,corrections,cell_counts,sums);
    accepted_count.*=cells;
    trace_hash.*=1709;
    trace_hash.*=e46_hash_update(trace_hash.*,e51m_hash_i64(current_loss));
    strict_loss_gate.*=1;

    let attempts:i32=0;
    while(cells<E51O_MAX_CELLS && attempts<count){
        let best_index:i32=-1;
        let best_score:i64=-1;
        let traversal:i32=0;
        while(traversal<count){
            let index:i32=traversal;
            if(reverse==1){ index=count-1-traversal; }
            if(rejected[index]==0 && parent_distance[index]>0){
                let pred:i32=r32e45_clamp(base_predictions[index]+corrections[assignments[index]],-4000,4000);
                let err:i64=(targets[index]-pred) as i64;
                let score:i64=err*err*((parent_distance[index]+1) as i64);
                if(score>best_score || (score==best_score && (best_index<0 || index<best_index))){ best_score=score; best_index=index; }
            }
            traversal=traversal+1;
        }
        if(best_index<0){ break; }
        attempts=attempts+1;
        let parent:i32=assignments[best_index];
        let child:i32=cells;
        feature=0; while(feature<E45_FEATURES){ prototypes[child*E45_FEATURES+feature]=e50_batch_column(records,best_index*E50_RECORD_N,feature+1,0); feature=feature+1; }
        parents[child]=parent;
        let c:i32=0; while(c<E51O_MAX_CELLS){ backup_corrections[c]=corrections[c]; c=c+1; }

        let moved:i32=0;
        traversal=0;
        while(traversal<count){
            let index:i32=traversal;
            if(reverse==1){ index=count-1-traversal; }
            if(assignments[index]==parent){
                let child_distance:i32=e51o_distance_record_proto(records,index*E50_RECORD_N,prototypes,child*E45_FEATURES,ranges);
                if(child_distance<parent_distance[index]){
                    moved_indices[moved]=index;
                    moved_old_distance[moved]=parent_distance[index];
                    assignments[index]=child;
                    parent_distance[index]=child_distance;
                    moved=moved+1;
                }
            }
            traversal=traversal+1;
        }
        let candidate_loss:i64=current_loss;
        if(moved>0){ candidate_loss=e51o_refit_corrections(targets,base_predictions,assignments,count,cells+1,reverse,corrections,cell_counts,sums); }
        if(moved>0 && cell_counts[parent]>0 && cell_counts[child]>0 && candidate_loss<current_loss){
            current_loss=candidate_loss;
            cells=cells+1;
            accepted_count.*=cells;
            trace_hash.*=e46_hash_update(trace_hash.*,best_index);
            trace_hash.*=e46_hash_update(trace_hash.*,parent);
            trace_hash.*=e46_hash_update(trace_hash.*,moved);
            trace_hash.*=e46_hash_update(trace_hash.*,e51m_hash_i64(current_loss));
            let level:i32=0;
            while(level<E51O_CAP_LEVELS){
                if(cells==e51o_capacity(level)){
                    snapshot_counts[level]=cells;
                    snapshot_losses[level]=current_loss;
                    e51o_copy_corrections(corrections,snapshot_corrections,level*E51O_MAX_CELLS);
                }
                level=level+1;
            }
        }else{
            rejected[best_index]=1;
            let mi:i32=0;
            while(mi<moved){
                let index:i32=moved_indices[mi];
                assignments[index]=parent;
                parent_distance[index]=moved_old_distance[mi];
                mi=mi+1;
            }
            c=0; while(c<E51O_MAX_CELLS){ corrections[c]=backup_corrections[c]; c=c+1; }
            prototypes[child*E45_FEATURES]=0;
            parents[child]=0;
        }
    }

    let level:i32=0;
    while(level<E51O_CAP_LEVELS){
        if(snapshot_counts[level]==0){
            snapshot_counts[level]=cells;
            snapshot_losses[level]=current_loss;
            e51o_copy_corrections(corrections,snapshot_corrections,level*E51O_MAX_CELLS);
        }
        if(level>0 && snapshot_losses[level]>snapshot_losses[level-1] && snapshot_counts[level]>=snapshot_counts[level-1]){ strict_loss_gate.*=0; }
        level=level+1;
    }
    final_loss.*=current_loss;

    zfree(ranges); zfree(root); zfree(base_predictions); zfree(assignments); zfree(parent_distance); zfree(rejected);
    zfree(moved_indices); zfree(moved_old_distance); zfree(corrections); zfree(backup_corrections); zfree(cell_counts); zfree(sums);
}

fn e51o_local_identity(
    prototypes_a:[]i32,parents_a:[]i32,corrections_a:[]i32,counts_a:[]i32,losses_a:[]i64,accepted_a:i32,trace_a:i32,final_a:i64,strict_a:i32,
    prototypes_b:[]i32,parents_b:[]i32,corrections_b:[]i32,counts_b:[]i32,losses_b:[]i64,accepted_b:i32,trace_b:i32,final_b:i64,strict_b:i32
)i32 {
    if(accepted_a!=accepted_b || trace_a!=trace_b || final_a!=final_b || strict_a!=strict_b){ return 0; }
    let cell:i32=0;
    while(cell<accepted_a){
        if(parents_a[cell]!=parents_b[cell]){ return 0; }
        let feature:i32=0; while(feature<E45_FEATURES){ if(prototypes_a[cell*E45_FEATURES+feature]!=prototypes_b[cell*E45_FEATURES+feature]){ return 0; } feature=feature+1; }
        cell=cell+1;
    }
    let level:i32=0;
    while(level<E51O_CAP_LEVELS){
        if(counts_a[level]!=counts_b[level] || losses_a[level]!=losses_b[level]){ return 0; }
        cell=0; while(cell<E51O_MAX_CELLS){ if(corrections_a[level*E51O_MAX_CELLS+cell]!=corrections_b[level*E51O_MAX_CELLS+cell]){ return 0; } cell=cell+1; }
        level=level+1;
    }
    return 1;
}

fn e51o_local_predict(
    records:[]i32,
    record_start:i32,
    linear_weights:[]i32,
    linear_start:i32,
    linear_bias:i32,
    prototypes:[]i32,
    parents:[]i32,
    ranges:[]i32,
    corrections:[]i32,
    correction_start:i32,
    cells:i32
)i32 {
    let cell:i32=0;
    let child:i32=1;
    while(child<cells){
        if(parents[child]==cell){
            let parent_distance:i32=e51o_distance_record_proto(records,record_start,prototypes,cell*E45_FEATURES,ranges);
            let child_distance:i32=e51o_distance_record_proto(records,record_start,prototypes,child*E45_FEATURES,ranges);
            if(child_distance<parent_distance){ cell=child; }
        }
        child=child+1;
    }
    let base:i32=e51m_linear_scalar_predict(records,record_start,linear_weights,linear_start,linear_bias);
    return r32e45_clamp(base+corrections[correction_start+cell],-4000,4000);
}

fn e51o_local_sign_accuracy(
    records:[]i32,targets:[]i32,count:i32,
    linear_weights:[]i32,linear_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    corrections:[]i32,correction_start:i32,cells:i32,
    positive_total:*i32,positive_correct:*i32,negative_total:*i32,negative_correct:*i32
)void {
    positive_total.*=0; positive_correct.*=0; negative_total.*=0; negative_correct.*=0;
    let i:i32=0;
    while(i<count){
        let predicted:i32=e51o_local_predict(records,i*E50_RECORD_N,linear_weights,0,linear_bias,prototypes,parents,ranges,corrections,correction_start,cells);
        if(targets[i]>0){ positive_total.*=positive_total.*+1; if(predicted>=0){ positive_correct.*=positive_correct.*+1; } }
        if(targets[i]<0){ negative_total.*=negative_total.*+1; if(predicted<0){ negative_correct.*=negative_correct.*+1; } }
        i=i+1;
    }
}

fn e51o_local_reachability(
    records:[]i32,episode_types:[]i32,episodes:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,
    linear_weights:[]i32,linear_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    corrections:[]i32,correction_start:i32,cells:i32,
    known_total:*i32,known_reachable:*i32,no_unique_total:*i32,no_unique_reachable:*i32
)void {
    known_total.*=0; known_reachable.*=0; no_unique_total.*=0; no_unique_reachable.*=0;
    let episode:i32=0;
    while(episode<episodes){
        let no_unique:i32=episode_types[episode]; let reached:i32=0; let t:i32=0;
        while(t<=E45_TAPE && reached==0){
            let record_index:i32=episode*(E45_TAPE+1)+t; let record_start:i32=record_index*E50_RECORD_N;
            let action:i32=e51m_top_commit(records,record_start,terminal_weights,terminal_biases);
            let score:i32=e51o_local_predict(records,record_start,linear_weights,0,linear_bias,prototypes,parents,ranges,corrections,correction_start,cells);
            if(no_unique==1){ if(score<0){ reached=1; }
            }else{ if(score>=0 && records[record_start+34+action]==1000){ reached=1; } }
            t=t+1;
        }
        if(no_unique==1){ no_unique_total.*=no_unique_total.*+1; if(reached==1){ no_unique_reachable.*=no_unique_reachable.*+1; }
        }else{ known_total.*=known_total.*+1; if(reached==1){ known_reachable.*=known_reachable.*+1; } }
        episode=episode+1;
    }
}

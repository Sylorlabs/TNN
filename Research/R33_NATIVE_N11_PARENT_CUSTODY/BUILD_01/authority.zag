// Native bounded authenticated control ledger. Trusted supervisor core candidate.
// This module does not provision human identities, protect keys against a host,
// isolate a hostile learner, perform learning, or operate on the accepted parent.
// Caller must keep the control root and keys outside learner access. N07 tests
// use disclosed synthetic keys only. Logical expiry is an attempt ordinal.
@import("hmac.zag")

struct NaStore {
    root:i64,lock:i64,status:i32,seq:i32,published:i32,state_commits:i32,orphans:i32,
    epoch:i32,version:i32,nonce:i32,spent:i32,budget:i32,state_len:i32,
    config:[]u8,policy_hash:[]u8,keys:[]u8,state:[]u8,state_hash:[]u8,head:[]u8,
}
fn na_invalid()NaStore {
    return NaStore{.root=-1,.lock=-1,.status=-8410,.seq=0,.published=0,.state_commits=0,.orphans=0,
        .epoch=0,.version=0,.nonce=0,.spent=0,.budget=0,.state_len=0,
        .config="",.policy_hash="",.keys="",.state="",.state_hash="",.head=""};
}
fn na_close(j:*NaStore)void {
    if(j.*.lock>=0){nio_close(j.*.lock);}if(j.*.root>=0){nio_close(j.*.root);}
    let code:i32=j.*.status;na_wipe(j.*.keys);nio_free(j.*.config);nio_free(j.*.policy_hash);
    nio_free(j.*.state);nio_free(j.*.state_hash);nio_free(j.*.head);
    j.*=na_invalid();j.*.status=code;
}
fn na_fail(j:*NaStore,code:i32)i32 {na_close(j);j.*.status=code;return code;}
fn na_config_ok(c:[]u8)i32 {
    if(c.len!=128){return 0;}
    if(nio_equal(c[0..8],"R33POL01")!=1 || na_get(c,8)!=1 ||
       na_get(c,12)<1 || na_get(c,16)<1 || na_get(c,20)<1 ||
       na_get(c,24)<0 || na_get(c,24)>7 || na_get(c,28)<1 || na_get(c,28)>1000000000 ||
       na_get(c,32)<0 || na_get(c,32)>=2147483647 || na_is_zero(c[36..64])!=1){return 0;}
    return 1;
}
fn na_internal(j:*NaStore,b:[]u8)i32 {
    return (na_overlap(b,j.*.keys)==1 || na_overlap(b,j.*.config)==1 ||
        na_overlap(b,j.*.policy_hash)==1 || na_overlap(b,j.*.state)==1 ||
        na_overlap(b,j.*.state_hash)==1 || na_overlap(b,j.*.head)==1) as i32;
}
fn na_create(path:[]u8,c:[]u8,keys:[]u8,initial:[]u8)i32 {
    if(na_config_ok(c)!=1 || keys.len!=64 || initial.len<0 || initial.len>4096){return -8401;}
    let h:[]u8=nio_alloc(32);let b:[]u8=nio_alloc(160+initial.len);
    if(h.len!=32 || b.len!=160+initial.len){nio_free(h);nio_free(b);return -8407;}
    let code:i32=0;
    if(ns_sha256(initial,h)!=0 || nio_equal(h,c[96..128])!=1){code=-8403;}
    else{na_copy(c,b);na_copy(initial,b[128..128+initial.len]);
        if(na_hmac(keys[32..64],b[0..128+initial.len],b[128+initial.len..b.len])!=0){code=-8407;}}
    nio_free(h);if(code!=0){nio_free(b);return code;}
    if(nio_mkdir(path)!=0){nio_free(b);return -8407;}
    let root:i64=nio_open_root(path);if(root<0){nio_free(b);return -8407;}
    let lock:i64=nio_open_child(root,"control.lock",1);let fd:i64=nio_open_child(root,"root.bin",1);
    if(lock<0 || fd<0){code=-8407;}
    else{if(nio_regular(lock)!=1 || nio_regular(fd)!=1 || nio_lock(lock)!=0 ||
        nio_write_all(fd,b)!=b.len || nio_sync(fd)!=0 || nio_sync(lock)!=0 || nio_sync(root)!=0){code=-8407;}}
    if(fd>=0){if(nio_close(fd)!=0){code=-8407;}}
    if(lock>=0){if(nio_close(lock)!=0){code=-8407;}}
    if(nio_close(root)!=0){code=-8407;}nio_free(b);return code;
}

// 256 bytes: 224-byte canonical body + full trainer HMAC. No caller-supplied
// "verified" flag. Bind actor, instance, scope, ceiling, epoch, nonce, parent
// version/hash, candidate bytes/hash, dependency identity, policy and cost.
fn na_request(j:*NaStore,g:[]u8,data:[]u8)i32 {
    if(j.*.status!=0 || j.*.root<0 || j.*.lock<0){return -8410;}
    if(g.len!=256 || data.len<0 || data.len>4096){return -8401;}
    if(na_mac_ok(j.*.keys[0..32],g[0..224],g[224..256])!=1){return -8402;}
    let op:i32=na_get(g,12);
    if(nio_equal(g[0..8],"R33GRT01")!=1 || na_get(g,8)!=1 || (op!=1 && op!=2) ||
        na_get(g,60)!=0 || na_is_zero(g[192..224])!=1 || na_get(g,56)!=data.len){return -8401;}
    if(na_get(g,16)!=na_get(j.*.config,12) || na_get(g,20)!=na_get(j.*.config,16) ||
        na_get(g,24)!=na_get(j.*.config,20) || na_get(g,28)<0 || na_get(g,28)>na_get(j.*.config,24) ||
        nio_equal(g[96..128],j.*.config[64..96])!=1 ||
        nio_equal(g[128..160],j.*.state_hash)!=1 || nio_equal(g[160..192],j.*.policy_hash)!=1){return -8403;}
    if(na_get(g,32)!=j.*.epoch || na_get(g,40)!=j.*.version ||
        na_get(g,52)<0 || na_get(g,52)>j.*.seq+1 || na_get(g,48)<j.*.seq+1){return -8404;}
    if(na_get(g,36)<1 || na_get(g,36)<=j.*.nonce){return -8406;}
    if(j.*.seq>=32){return -8405;}
    let cost:i32=na_get(g,44);
    if(op==1){
        if(cost<1 || j.*.spent>j.*.budget || cost>j.*.budget-j.*.spent || j.*.version>=2147483647){return -8405;}
    }else{
        if(data.len!=8 || cost!=0 || na_get(g,28)!=0 || j.*.epoch>=2147483647 ||
            na_get(data,0)!=j.*.epoch+1 || na_get(data,4)<0 || na_get(data,4)>j.*.budget){return -8403;}
    }
    let hash:[]u8=nio_alloc(32);if(hash.len!=32){return -8407;}
    let code:i32=0;if(ns_sha256(data,hash)!=0){code=-8407;}
    else{if(nio_equal(hash,g[64..96])!=1){code=-8403;}}
    nio_free(hash);return code;
}
fn na_record_check(j:*NaStore,b:[]u8)i32 {
    if(b.len<368 || b.len>4464){return -8408;}
    let n:i32=na_get(b,40);
    if(n<0 || n>4096 || b.len!=368+n || nio_equal(b[0..8],"R33AUT01")!=1 ||
        na_get(b,8)!=1 || na_get(b,12)!=j.*.seq+1 || na_get(b,16)!=j.*.spent ||
        na_get(b,20)!=j.*.budget || na_get(b,24)!=j.*.epoch || na_get(b,28)!=j.*.version ||
        na_get(b,32)!=j.*.nonce || na_get(b,44)!=0 ||
        nio_equal(b[48..80],j.*.head)!=1 || na_get(b,36)!=na_get(b,92)){return -8408;}
    if(na_mac_ok(j.*.keys[32..64],b[0..336+n],b[336+n..368+n])!=1){return -8408;}
    if(na_request(j,b[80..336],b[336..336+n])!=0){return -8408;}return 0;
}
fn na_accept(j:*NaStore,b:[]u8,committed:i32)void {
    let n:i32=na_get(b,40);let op:i32=na_get(b,36);
    j.*.seq=j.*.seq+1;j.*.nonce=na_get(b,116);j.*.spent=j.*.spent+na_get(b,124);
    na_copy(b[336+n..368+n],j.*.head);
    if(committed==1){j.*.published=j.*.published+1;}else{j.*.orphans=j.*.orphans+1;}
    if(op==2){
        // A complete durable authenticated restriction is effective even if its
        // acknowledgement link was interrupted. Recovery cannot revive a grant.
        j.*.epoch=na_get(b,336);j.*.budget=na_get(b,340);
    }else{if(committed==1){
        na_zero(j.*.state);na_copy(b[336..336+n],j.*.state);j.*.state_len=n;
        na_copy(b[144..176],j.*.state_hash);j.*.version=j.*.version+1;
        j.*.state_commits=j.*.state_commits+1;
    }}
}
fn na_open(path:[]u8,c:[]u8,keys:[]u8)NaStore {
    let j:NaStore=na_invalid();
    if(na_config_ok(c)!=1 || keys.len!=64){j.status=-8401;return j;}
    j.root=nio_open_root(path);if(j.root<0){na_fail(&j,-8407);return j;}
    j.lock=nio_open_child(j.root,"control.lock",0);
    if(j.lock<0 || nio_regular(j.lock)!=1){na_fail(&j,-8407);return j;}
    if(nio_lock(j.lock)!=0){na_fail(&j,-8409);return j;}
    j.config=nio_alloc(128);j.keys=nio_alloc(64);j.policy_hash=nio_alloc(32);
    j.state=nio_alloc(4096);j.state_hash=nio_alloc(32);j.head=nio_alloc(32);
    let b:[]u8=nio_alloc(4464);let other:[]u8=nio_alloc(4464);
    if(j.config.len!=128 || j.keys.len!=64 || j.policy_hash.len!=32 || j.state.len!=4096 ||
       j.state_hash.len!=32 || j.head.len!=32 || b.len!=4464 || other.len!=4464){
        nio_free(b);nio_free(other);na_fail(&j,-8407);return j;}
    na_copy(c,j.config);na_copy(keys,j.keys);j.status=0;
    if(ns_sha256(c,j.policy_hash)!=0){j.status=-8407;}
    let fd:i64=nio_open_child(j.root,"root.bin",0);let got:i64=-1;
    if(fd>=0){got=nio_read_exact(fd,b,4256);if(nio_close(fd)!=0){j.status=-8407;}}
    if(j.status==0){
        if(got<160 || got>4256){j.status=-8408;}
        else{let n:i32=(got as i32)-160;
            if(nio_equal(b[0..128],c)!=1 || na_mac_ok(j.keys[32..64],b[0..128+n],b[128+n..160+n])!=1){j.status=-8408;}
            else{if(ns_sha256(b[128..128+n],j.state_hash)!=0 || nio_equal(j.state_hash,c[96..128])!=1){j.status=-8408;}
                else{na_copy(b[128..128+n],j.state);j.state_len=n;na_copy(b[128+n..160+n],j.head);
                    j.version=na_get(c,32);j.budget=na_get(c,28);}}
        }
    }
    let index:i32=1;let gap:i32=0;
    while(index<=33 && j.status==0){
        fd=na_index(j.root,"attempt-",index,0);let cf:i64=na_index(j.root,"commit-",index,0);
        if(fd==-2){gap=1;if(cf!=-2){j.status=-8408;}}
        else{if(fd<0 || gap==1 || index>32){j.status=-8408;}
            else{got=nio_read_exact(fd,b,4464);
                if(got<368 || got>4464){j.status=-8408;}
                else{j.status=na_record_check(&j,b[0..got as i32]);
                    let committed:i32=0;
                    if(j.status==0){
                        if(cf>=0){let n:i64=nio_read_exact(cf,other,4464);
                            if(n!=got || nio_equal(b[0..got as i32],other[0..got as i32])!=1){j.status=-8408;}
                            else{committed=1;}}
                        else{if(cf!=-2){j.status=-8408;}}
                    }
                    if(j.status==0){na_accept(&j,b[0..got as i32],committed);}
                }
            }
        }
        if(fd>=0){if(nio_close(fd)!=0 && j.status==0){j.status=-8407;}}
        if(cf>=0){if(nio_close(cf)!=0 && j.status==0){j.status=-8407;}}
        index=index+1;
    }
    nio_free(b);nio_free(other);if(j.status!=0){let code:i32=j.status;na_fail(&j,code);}return j;
}
fn na_snapshot(j:*NaStore,out:[]u8)i32 {
    if(j.*.status!=0 || j.*.root<0 || j.*.lock<0){return -8410;}
    if(out.len<j.*.state_len){return -8401;}
    if(na_internal(j,out)==1){return -8411;}
    na_copy(j.*.state[0..j.*.state_len],out);return j.*.state_len;
}
fn na_submit(j:*NaStore,grant:[]u8,data:[]u8)i32 {return na_submit_diagnostic(j,grant,data,0);}
fn na_submit_diagnostic(j:*NaStore,grant:[]u8,data:[]u8,fault:i32)i32 {
    if(fault<0 || fault>6){return -8401;}
    if(na_internal(j,grant)==1 || na_internal(j,data)==1){return -8411;}
    let code:i32=na_request(j,grant,data);if(code!=0){return code;}
    let b:[]u8=nio_alloc(368+data.len);if(b.len!=368+data.len){return -8407;}
    na_copy("R33AUT01",b);na_put(b,8,1);na_put(b,12,j.*.seq+1);na_put(b,16,j.*.spent);
    na_put(b,20,j.*.budget);na_put(b,24,j.*.epoch);na_put(b,28,j.*.version);na_put(b,32,j.*.nonce);
    na_put(b,36,na_get(grant,12));na_put(b,40,data.len);na_copy(j.*.head,b[48..80]);
    na_copy(grant,b[80..336]);na_copy(data,b[336..336+data.len]);
    if(na_hmac(j.*.keys[32..64],b[0..336+data.len],b[336+data.len..b.len])!=0){nio_free(b);return -8407;}
    // Revalidate the staged exact bytes under the same held lock before durable reservation.
    code=na_record_check(j,b);if(code!=0){nio_free(b);return code;}
    let attempt:i32=j.*.seq+1;let from:[]u8=na_name("attempt-",attempt);let to:[]u8=na_name("commit-",attempt);
    let fd:i64=nio_open_child(j.*.root,from,1);
    if(fd<0 || nio_regular(fd)!=1){if(fd>=0){nio_close(fd);}nio_free(from);nio_free(to);nio_free(b);return na_fail(j,-8407);}
    if(fault==1){if(nio_sync(fd)!=0 || nio_sync(j.*.root)!=0){_zag_exit(90);}_zag_exit(71);}
    if(fault==2){if(nio_write_all(fd,b[0..b.len/2])!=b.len/2 || nio_sync(fd)!=0 || nio_sync(j.*.root)!=0){_zag_exit(90);}_zag_exit(72);}
    if(nio_write_all(fd,b)!=b.len || nio_sync(fd)!=0 || nio_sync(j.*.root)!=0){code=-8407;}
    if(nio_close(fd)!=0){code=-8407;}
    if(code==0 && fault==3){_zag_exit(73);}
    if(code==0 && fault==6){code=-8407;}
    // Serialized second authorization check immediately precedes publication;
    // caller buffers are no longer consulted and cooperating revocation shares this lock.
    if(code==0){code=na_record_check(j,b);}
    if(code==0){if(nio_link(j.*.root,from,to)!=0){code=-8407;}}
    if(code==0 && fault==4){_zag_exit(74);}
    if(code==0){if(nio_sync(j.*.root)!=0){code=-8407;}}
    if(code==0 && fault==5){_zag_exit(75);}
    if(code==0){na_accept(j,b,1);}
    nio_free(from);nio_free(to);nio_free(b);
    if(code!=0){return na_fail(j,code);}return 0;
}

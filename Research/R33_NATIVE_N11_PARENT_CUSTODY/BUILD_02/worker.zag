// Confined inert parent inspector: binding/map only, NO authority or signer.
@import("binding.zag")

struct W11Stats {checks:i32,failed:i32}
fn w11_check(s:*W11Stats,k:[]u8,a:i64,e:i64)void {s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(k,a,e);}
fn w11_path(name:[]u8)[]u8 {return _zag_str_concat("/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N11_RUN_PRIMARY_V1/sandbox/",name);}
fn w11_open(path:[]u8,flags:i64)i64 {let b:[]u8=nio_cstr(path);let fd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(b) as i64,flags,384,0,0,0);nio_free(b);return fd;}
fn w11_denied(v:i64)i32 {return (v==-1 || v==-13) as i32;}
fn w11_deny_open(path:[]u8,flags:i64,label:[]u8,s:*W11Stats)void {
    let fd:i64=w11_open(path,flags);w11_check(s,label,w11_denied(fd),1);if(fd>=0){nio_close(fd);}
}
fn main()i32 {
    if(_zag_argc()!=2 || _zag_strcmp(_zag_arg(1),"inspect")!=1){return 2;}if(nio_deadline(30)!=0){return 3;}
    let s:W11Stats=W11Stats{.checks=0,.failed=0};let path:[]u8=w11_path("input.bin");let fd:i64=w11_open(path,16777476);
    w11_check(&s,"custody_input_open",(fd>=0) as i32,1);let binding:[]u8=nio_alloc(128);let got:i64=nio_read_exact(fd,binding,128);if(fd>=0){nio_close(fd);}
    w11_check(&s,"custody_input_exact_length",got,128);w11_check(&s,"custody_identity_exact",pb_validate(binding),0);
    if(s.failed==0){let p:ParentMap=pb_load(pb_map_path(),binding);w11_check(&s,"confined_full_parent_map_load",p.status,0);
        if(p.status==0){w11_check(&s,"confined_original_identity",pb_parent_identity(&p),0);w11_check(&s,"all_original_bytes_available",p.input.len,15871908);
            w11_check(&s,"native_descriptor_count",p.node_count,375763);w11_check(&s,"native_relation_count",p.edge_count,244250);
            let h:[]u8=nio_alloc(32);w11_check(&s,"confined_original_bytes_hashed",ns_sha256(p.input,h),0);w11_check(&s,"confined_original_hash_exact",nio_equal(h,binding[32..64]),1);
            let hex:[]u8=ns_hex(h);_zag_print("N11_WORKER_PARENT_SHA256,");_zag_println(hex);nio_free(hex);nio_free(h);}
        mi_loaded_close(&p);}
    w11_check(&s,"custody_never_grants_training",pb_training_admission(binding),-8904);
    w11_deny_open(path,16777478,"delivery_write_denied",&s);nio_free(path);
    path=_zag_str_concat(pb_map_path(),"/nodes-1.bin");w11_deny_open(path,16777478,"parent_map_write_open_denied",&s);nio_free(path);
    w11_deny_open(pb_original_path(),16777476,"original_parent_outside_worker_scope",&s);
    path=w11_path("control/attempt-1.bin");w11_deny_open(path,16777476,"actual_control_read_denied",&s);w11_deny_open(path,16777478,"actual_control_write_denied",&s);nio_free(path);
    // No unlink probe touches accepted files or authority. These checks remain
    // nonmutating even if a confinement predicate unexpectedly fails.
    let socket:i64=_zag_darwin_syscall(97,2,1,0,0,0,0);w11_check(&s,"socket_creation_denied",w11_denied(socket),1);if(socket>=0){nio_close(socket);}
    let pid:i64=_zag_darwin_fork();if(pid==0){_zag_exit(0);}w11_check(&s,"fork_denied",w11_denied(pid),1);
    if(pid>0){let status:*i32=_zag_malloc(8) as *i32;_zag_darwin_syscall(7,pid,status as i64,0,0,0,0);_zag_free(status as *i8);}
    let live:i32=0;let i:i32=3;while(i<64){if(_zag_darwin_syscall(92,i,1,0,0,0,0)!=-9){live=live+1;}i=i+1;}
    w11_check(&s,"no_inherited_nonstdio_descriptor",live,0);nio_free(binding);
    _zag_print("N11_WORKER_COUNTS,");_zag_print(_zag_i64_to_str(s.checks as i64));_zag_print(",");_zag_println(_zag_i64_to_str(s.failed as i64));
    if(s.failed!=0){return 1;}_zag_println("N11_WORKER_PASS");return 0;
}

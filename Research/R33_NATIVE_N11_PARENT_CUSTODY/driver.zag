// N11 controller, public synthetic signer and engineering evaluator. Never
// linked into the confined worker. No learner updates or historical reruns.
@import("custody.zag")
@import("parent_isolation.zag")
@import("R33_NATIVE_PROCESS_V3.zag")

struct P11Stats {checks:i32,failed:i32,children:i32,nested:i32,child_checks:i32,cpu:i64,wall:i64,rss:i64,ncpu:i64,nwall:i64,nrss:i64}
fn p11_stats()P11Stats {return P11Stats{.checks=0,.failed=0,.children=0,.nested=0,.child_checks=0,.cpu=0,.wall=0,.rss=0,.ncpu=0,.nwall=0,.nrss=0};}
fn p11_check(s:*P11Stats,k:[]u8,a:i64,e:i64)void {s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(k,a,e);}
fn p11_root()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N11_RUN_PRIMARY_V1";}
fn p11_path(name:[]u8)[]u8 {let p:[]u8=_zag_str_concat(p11_root(),"/");return ci_join(p,name);}
fn p11_worker()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N11_PARENT_CUSTODY/BUILD_01/worker";}
fn p11_bootstrap()[]u8 {return "/Users/Shared/micah/Documents/TNN/TNN/Research/R33_NATIVE_N11_PARENT_CUSTODY/dyld-support.sb";}
fn p11_keys()[]u8 {let k:[]u8=nio_alloc(64);let i:i32=0;while(i<k.len){k[i]=((i*23+11)%256) as u8;i=i+1;}return k;}
fn p11_config()[]u8 {
    let c:[]u8=nio_alloc(128);let b:[]u8=pb_binding();if(c.len!=128 || b.len!=128){nio_free(c);nio_free(b);return "";}
    na_copy("R33POL01",c);na_put(c,8,1);na_put(c,12,1011);na_put(c,16,9011);na_put(c,20,7011);
    na_put(c,24,0);na_put(c,28,20);na_put(c,32,11);
    ns_sha256("r33-native-n11-supervisor-bound-parent-custody-v1",c[64..96]);ns_sha256(b,c[96..128]);nio_free(b);return c;
}
fn p11_scene(name:[]u8)i64 {let path:[]u8=p11_path(name);let root:i64=nio_open_root(path);nio_free(path);return root;}
fn p11_store(scene:[]u8,create:i32,s:*P11Stats)NaStore {
    let base:[]u8=p11_path(scene);let path:[]u8=_zag_str_concat(base,"/control");let c:[]u8=p11_config();let keys:[]u8=p11_keys();let initial:[]u8=pb_binding();
    if(create==1){p11_check(s,"scene_exclusive_create",nio_mkdir(base),0);p11_check(s,"synthetic_control_exclusive_create",na_create(path,c,keys,initial),0);}
    let j:NaStore=na_open(path,c,keys);nio_free(base);nio_free(path);nio_free(c);na_wipe(keys);nio_free(initial);return j;
}
fn p11_grant(j:*NaStore,b:[]u8,nonce:i32,cost:i32,op:i32)[]u8 {
    let g:[]u8=nio_alloc(256);if(g.len!=256){return "";}
    na_copy("R33GRT01",g);na_put(g,8,1);na_put(g,12,op);na_put(g,16,1011);na_put(g,20,9011);na_put(g,24,7011);na_put(g,28,0);
    na_put(g,32,j.*.epoch);na_put(g,36,nonce);na_put(g,40,j.*.version);na_put(g,44,cost);na_put(g,48,32);na_put(g,52,1);na_put(g,56,b.len);
    ns_sha256(b,g[64..96]);na_copy(j.*.config[64..96],g[96..128]);na_copy(j.*.state_hash,g[128..160]);na_copy(j.*.policy_hash,g[160..192]);
    let keys:[]u8=p11_keys();na_hmac(keys[0..32],g[0..224],g[224..256]);na_wipe(keys);return g;
}
fn p11_commit(j:*NaStore,b:[]u8,nonce:i32,cost:i32,s:*P11Stats)void {
    let g:[]u8=p11_grant(j,b,nonce,cost,1);p11_check(s,"synthetic_custody_commit",na_submit(j,g,b),0);nio_free(g);
}
fn p11_packet(j:*NaStore,s:*P11Stats)[]u8 {
    let b:[]u8=nio_alloc(4320);let n:i32=cs_export(j,b);p11_check(s,"current_receipt_export",n,224+j.*.state_len);
    if(n<224 || n>4320){nio_free(b);return "";}return b[0..n];
}
fn p11_bytes(root:i64,name:[]u8,max:i32)[]u8 {
    let b:[]u8=nio_alloc(max);let n:i64=mi_read(root,name,b,max);if(n<0 || n>max){nio_free(b);return "";}return b[0..n as i32];
}
fn p11_refuse(j:*NaStore,receipt:[]u8,path:[]u8,expected:i32,s:*P11Stats)void {
    let p:ParentMap=pc_map(j,receipt,path);p11_check(s,"custody_refusal_code",p.status,expected);p11_check(s,"custody_refusal_no_root",p.root,0);
    p11_check(s,"custody_refusal_no_original_bytes",p.input.len,0);mi_loaded_close(&p);
}
fn p11_controls(s:*P11Stats)void {
    let b:[]u8=pb_binding();p11_check(s,"canonical_binding_length",b.len,128);p11_check(s,"canonical_binding_valid",pb_validate(b),0);
    if(b.len!=128){nio_free(b);return;}p11_check(s,"custody_is_not_training_admission",pb_training_admission(b),-8904);
    let a:[]u8=nio_alloc(128);let i:i32=0;while(i<128){mi_copy(b,a);a[i]=(a[i] as i32 ^ 1) as u8;
        p11_check(s,"every_changed_binding_byte_refused",(pb_validate(a)<0) as i32,1);p11_check(s,"changed_binding_never_admits_training",(pb_training_admission(a)<0) as i32,1);i=i+1;}
    p11_check(s,"short_binding_refused",pb_validate(b[0..127]),-8901);mi_copy(b,a);mi_put(a,12,1);
    p11_check(s,"false_behavioral_qualification_refused",pb_validate(a),-8901);mi_copy(b,a);mi_put(a,20,0);
    p11_check(s,"newborn_counter_substitution_refused",pb_validate(a),-8902);
    p11_check(s,"unsafe_map_path_profile_refused",pi_profile("/tmp/a","/tmp/b","/tmp/c","/tmp/d","/tmp/e","/tmp/\"").len,0);
    nio_free(a);nio_free(b);
}
fn p11_normal(replay:i32,s:*P11Stats)void {
    let j:NaStore=p11_store("normal",1-replay,s);p11_check(s,"current_control_open",j.status,0);if(j.status!=0){na_close(&j);return;}
    let root:i64=p11_scene("normal");let b:[]u8=pb_binding();
    if(replay==0){let old:[]u8=p11_packet(&j,s);p11_check(s,"older_receipt_retained",mi_write(root,"older.bin",old),0);nio_free(old);
        p11_commit(&j,b,1,3,s);let current:[]u8=p11_packet(&j,s);p11_check(s,"current_receipt_retained",mi_write(root,"current.bin",current),0);nio_free(current);}
    let current:[]u8=p11_bytes(root,"current.bin",4320);let old:[]u8=p11_bytes(root,"older.bin",4320);
    let absent:[]u8=p11_path("never-created-map");p11_refuse(&j,old,absent,-8604,s);nio_free(absent);
    let p:ParentMap=pc_map(&j,current,pb_map_path());p11_check(s,"current_supervisor_bound_parent_load",p.status,0);
    if(p.status==0){p11_check(s,"continuing_parent_identity_preserved",pb_parent_identity(&p),0);p11_check(s,"parent_nodes_preserved",p.node_count,375763);
        p11_check(s,"parent_relations_preserved",p.edge_count,244250);p11_check(s,"parent_memo_preserved",p.memo_count,175954);}
    p11_check(s,"read_only_map_not_behavioral_recovery",pb_training_admission(b),-8904);p11_check(s,"control_spend_retained",j.spent,3);
    p11_check(s,"control_nonce_retained",j.nonce,1);p11_check(s,"control_version_not_learner_step",j.version,12);
    mi_loaded_close(&p);nio_free(current);nio_free(old);nio_free(b);nio_close(root);na_close(&j);
}
fn p11_restriction(s:*P11Stats)void {
    let j:NaStore=p11_store("normal",0,s);p11_check(s,"restriction_current_control_open",j.status,0);if(j.status!=0){na_close(&j);return;}
    let root:i64=p11_scene("normal");let old:[]u8=p11_bytes(root,"current.bin",4320);let b:[]u8=nio_alloc(8);na_put(b,0,1);na_put(b,4,2);
    let g:[]u8=p11_grant(&j,b,2,0,2);p11_check(s,"synthetic_restriction_committed",na_submit(&j,g,b),0);nio_free(g);nio_free(b);
    let absent:[]u8=p11_path("never-created-map");p11_refuse(&j,old,absent,-8604,s);
    let current:[]u8=p11_packet(&j,s);let out:[]u8=nio_alloc(128);p11_check(s,"restricted_current_custody_receipt_valid",cs_restore(&j,current,out),128);
    p11_check(s,"restriction_keeps_exact_parent_binding",pb_validate(out),0);p11_check(s,"restriction_no_spend_refund",j.spent,3);
    p11_check(s,"restriction_nonce_advances",j.nonce,2);p11_check(s,"restriction_epoch_advances",j.epoch,1);p11_check(s,"restriction_budget_below_spend",j.budget,2);
    p11_refuse(&j,current,absent,-8813,s);p11_check(s,"missing_map_does_not_refund",j.spent,3);
    p11_check(s,"restricted_binding_no_training",pb_training_admission(out),-8904);p11_check(s,"restricted_receipt_retained",mi_write(root,"restricted.bin",current),0);
    nio_free(out);nio_free(current);nio_free(old);nio_free(absent);nio_close(root);na_close(&j);
}
fn p11_binding_refusals(s:*P11Stats)void {
    let j:NaStore=p11_store("binding-refusals",1,s);p11_check(s,"refusal_control_open",j.status,0);if(j.status!=0){na_close(&j);return;}
    let original:[]u8=pb_binding();let bad:[]u8=nio_alloc(128);let absent:[]u8=p11_path("never-created-map");let index:i32=0;
    while(index<5 && s.*.failed==0){mi_copy(original,bad);let code:i32=-8902;
        if(index==0){mi_put(bad,12,1);code=-8901;}else if(index==1){bad[32]=(bad[32] as i32 ^ 1) as u8;}
        else if(index==2){bad[64]=(bad[64] as i32 ^ 1) as u8;}else if(index==3){mi_put(bad,20,0);}else{bad[96]=(bad[96] as i32 ^ 1) as u8;}
        p11_commit(&j,bad,index+1,1,s);let packet:[]u8=p11_packet(&j,s);p11_refuse(&j,packet,absent,code,s);nio_free(packet);index=index+1;}
    p11_commit(&j,original[0..127],6,1,s);let short:[]u8=p11_packet(&j,s);p11_refuse(&j,short,absent,-8901,s);
    p11_refuse(&j,short[0..223],absent,-8601,s);let missing:NaStore=na_invalid();p11_refuse(&missing,short,pb_map_path(),-8610,s);
    p11_check(s,"authenticated_bad_bindings_never_refund",j.spent,6);p11_check(s,"all_bad_bindings_recorded",j.seq,6);
    nio_free(short);nio_free(original);nio_free(bad);nio_free(absent);na_close(&j);
}
fn p11_corrupt(replay:i32,s:*P11Stats)void {
    let j:NaStore=p11_store("damage",1-replay,s);p11_check(s,"damage_control_open",j.status,0);if(j.status!=0){na_close(&j);return;}
    let scene:i64=p11_scene("damage");let path:[]u8=p11_path("damage/map");
    if(replay==0){let receipt:[]u8=p11_packet(&j,s);p11_check(s,"damage_receipt_retained",mi_write(scene,"receipt.bin",receipt),0);
        let p:ParentMap=pc_map(&j,receipt,pb_map_path());p11_check(s,"copy_source_supervisor_verified",p.status,0);
        if(p.status==0){let b:[]u8=pb_binding();let pin:[]u8=mi_dump(&p,path,b[32..64]);p11_check(s,"exclusive_real_map_copy_complete",pin.len,32);
            p11_check(s,"copy_manifest_identical_to_accepted_map",nio_equal(pin,b[64..96]),1);nio_free(pin);nio_free(b);}
        mi_loaded_close(&p);nio_free(receipt);
        if(s.*.failed==0){let root:i64=nio_open_root(path);let bytes:[]u8=nio_alloc(240064);let n:i64=mi_read(root,"nodes-1.bin",bytes,240064);
            p11_check(s,"new_copy_page_size",n,240064);if(n==240064){p11_check(s,"new_copy_preimage_retained",mi_write(root,"nodes-1.preimage",bytes),0);
                let name:[]u8=nio_cstr("nodes-1.bin");let fd:i64=_zag_darwin_syscall(463,root,_zag_slice_ptr(name) as i64,16777478,0,0,0);nio_free(name);
                p11_check(s,"new_copy_damage_handle",(fd>=0) as i32,1);if(fd>=0){bytes[64]=(bytes[64] as i32 ^ 1) as u8;
                    p11_check(s,"new_copy_damage_write",nio_write_all(fd,bytes),240064);p11_check(s,"new_copy_damage_sync",nio_sync(fd),0);p11_check(s,"new_copy_damage_close",nio_close(fd),0);}}
            nio_free(bytes);nio_close(root);}
    }else{let receipt:[]u8=p11_bytes(scene,"receipt.bin",4320);p11_refuse(&j,receipt,path,-8813,s);nio_free(receipt);
        p11_check(s,"damage_no_authority_nonce_change",j.nonce,0);p11_check(s,"damage_no_authority_spend_change",j.spent,0);}
    nio_free(path);nio_close(scene);na_close(&j);
}
fn p11_has(b:[]u8,n:[]u8)i32 {
    let i:i32=0;while(i+n.len<=b.len){let k:i32=0;while(k<n.len && b[i+k]==n[k]){k=k+1;}if(k==n.len){return 1;}i=i+1;}return 0;
}
fn p11_number(b:[]u8,prefix:[]u8,tail:[]u8)i64 {
    let value:i64=-1;let i:i32=0;while(i+prefix.len<b.len){let k:i32=0;while(k<prefix.len && b[i+k]==prefix[k]){k=k+1;}
        if(k==prefix.len && (i==0 || b[i-1]==10)){if(value>=0){return -1;}let at:i32=i+k;let v:i64=0;let digits:i32=0;
            while(at<b.len && b[at]>=48 && b[at]<=57 && digits<12){v=v*10+(b[at] as i64)-48;digits=digits+1;at=at+1;}
            if(digits==0 || at+tail.len>b.len){return -1;}k=0;while(k<tail.len){if(b[at+k]!=tail[k]){return -1;}k=k+1;}value=v;}i=i+1;}return value;
}
fn p11_capture(root:i64,mode:[]u8)[]u8 {let name:[]u8=_zag_str_concat(mode,".stdout");let b:[]u8=p11_bytes(root,name,262144);nio_free(name);return b;}
fn p11_sandbox(s:*P11Stats)void {
    let j:NaStore=p11_store("sandbox",1,s);p11_check(s,"sandbox_control_open",j.status,0);if(j.status!=0){na_close(&j);return;}
    let root:i64=nio_open_root(p11_root());let scene:i64=p11_scene("sandbox");let b:[]u8=pb_binding();p11_commit(&j,b,1,3,s);
    let receipt:[]u8=p11_packet(&j,s);let p:ParentMap=pc_map(&j,receipt,pb_map_path());p11_check(s,"parent_verified_before_worker_delivery",p.status,0);mi_loaded_close(&p);
    let delivered:[]u8=nio_alloc(128);p11_check(s,"delivery_from_current_locked_supervisor",cs_restore(&j,receipt,delivered),128);
    p11_check(s,"exact_bound_delivery",nio_equal(delivered,b),1);
    if(s.*.failed==0){p11_check(s,"worker_input_exclusively_published",mi_write(scene,"input.bin",delivered),0);
        let input:[]u8=p11_path("sandbox/input.bin");let out:[]u8=p11_path("parent-worker.stdout");let err:[]u8=p11_path("parent-worker.stderr");
        let profile:[]u8=pi_profile(p11_worker(),input,out,err,p11_bootstrap(),pb_map_path());p11_check(s,"worker_profile_nonempty",(profile.len>0) as i32,1);
        p11_check(s,"exact_profile_retained",mi_write(scene,"profile.sb",profile),0);nio_free(profile);nio_free(input);nio_free(out);nio_free(err);}
    let leaked:i64=-1;let canary:i64=-1;
    if(s.*.failed==0){leaked=nio_open_child(j.root,"attempt-1.bin",0);p11_check(s,"actual_control_descriptor_canary_open",(leaked>=0) as i32,1);
        if(leaked>=0){canary=_zag_darwin_syscall(90,leaked,40,0,0,0,0);p11_check(s,"descriptor40_canary_created",canary,40);nio_close(leaked);}}
    if(s.*.failed==0){let r:NativeRunV3=nrv3_run(root,_zag_arg(0),"launch-worker","parent-worker",30000,262144);s.*.nested=s.*.nested+1;
        s.*.ncpu=r.cpu_us;s.*.nwall=r.wall_us_nonmonotonic;s.*.nrss=r.peak_rss;
        p11_check(s,"confined_worker_status",r.status,0);p11_check(s,"confined_worker_started",r.started,1);p11_check(s,"confined_worker_reaped",r.reaped,1);
        p11_check(s,"confined_worker_exit",r.exit_code,0);p11_check(s,"confined_worker_signal",r.signal,0);p11_check(s,"confined_worker_stderr",r.stderr_bytes,0);
        p11_check(s,"confined_worker_observed_rss",(r.peak_rss>0 && r.peak_rss<=402653184) as i32,1);
        let log:[]u8=p11_capture(root,"parent-worker");p11_check(s,"confined_worker_capture_complete",log.len,r.stdout_bytes);
        p11_check(s,"confined_worker_nineteen_checks",p11_number(log,"N11_WORKER_COUNTS,",",0\n"),19);
        p11_check(s,"confined_worker_terminal",p11_has(log,"N11_WORKER_PASS\n"),1);
        p11_check(s,"worker_actual_parent_hash",p11_has(log,"N11_WORKER_PARENT_SHA256,31e670fcd2a2fefc02a1d032b8016bd93c28844df8ea40889593d030a2096e5a\n"),1);
        if(r.exit_code==0 && p11_number(log,"N11_WORKER_COUNTS,",",0\n")==19){s.*.child_checks=s.*.child_checks+19;}nio_free(log);}
    if(canary==40){p11_check(s,"controller_canary_closed",nio_close(40),0);}na_close(&j);j=p11_store("sandbox",0,s);
    p11_check(s,"actual_control_reopens_after_worker",j.status,0);if(j.status==0){p11_check(s,"worker_cannot_rewind_spend",j.spent,3);
        p11_check(s,"worker_cannot_rewind_nonce",j.nonce,1);p11_check(s,"post_worker_receipt_still_current",cs_restore(&j,receipt,delivered),128);
        p11_check(s,"post_worker_binding_exact",pb_validate(delivered),0);}
    nio_free(receipt);nio_free(delivered);nio_free(b);nio_close(scene);nio_close(root);na_close(&j);
}
fn p11_run(root:i64,mode:[]u8,expected:i32,ms:i64,s:*P11Stats)void {
    if(s.*.failed!=0){return;}let r:NativeRunV3=nrv3_run(root,_zag_arg(0),mode,mode,ms,262144);s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;
    if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    p11_check(s,"child_status",r.status,0);p11_check(s,"child_started",r.started,1);p11_check(s,"child_reaped",r.reaped,1);p11_check(s,"child_exit",r.exit_code,expected);
    p11_check(s,"child_signal",r.signal,0);p11_check(s,"child_stderr_empty",r.stderr_bytes,0);p11_check(s,"child_observed_rss",(r.peak_rss>0 && r.peak_rss<=402653184) as i32,1);
    let log:[]u8=p11_capture(root,mode);p11_check(s,"complete_child_capture",log.len,r.stdout_bytes);
    if(expected==0){p11_check(s,"child_terminal_pass",p11_has(log,"N11_CHILD_PASS\n"),1);let checks:i64=p11_number(log,"N11_CHILD_COUNTS,",",0\n");
        let nested:i64=p11_number(log,"N11_NESTED_CHILDREN,","\n");let nc:i64=p11_number(log,"N11_NESTED_CHECKS,","\n");
        p11_check(s,"unambiguous_native_counts",(checks>0 && checks<=1000000 && nested>=0 && nested<=1 && nc>=0 && nc<=19) as i32,1);
        if(checks>0 && checks<=1000000 && nc>=0 && nc<=19){s.*.child_checks=s.*.child_checks+(checks as i32)+(nc as i32);}if(nested>=0 && nested<=1){s.*.nested=s.*.nested+(nested as i32);}
        if(nested==1){s.*.ncpu=p11_number(log,"N11_NESTED_CPU_US,","\n");s.*.nwall=p11_number(log,"N11_NESTED_WALL_US,","\n");s.*.nrss=p11_number(log,"N11_NESTED_RSS_BYTES,","\n");}
    }else{p11_check(s,"invalid_mode_silent",log.len,0);}nio_free(log);
}
fn p11_field(b:[]u8,k:[]u8,v:i64)[]u8 {let n:[]u8=_zag_i64_to_str(v);b=ci_join(b,k);b=ci_join(b,n);nio_free(n);return b;}
fn p11_supervise()i32 {
    if(nio_guard(180)!=0){return 3;}let a:NativeAdmissionV3=nrv3_admit_root(p11_root());if(a.status!=0){return 4;}let root:i64=a.root;let s:P11Stats=p11_stats();
    p11_run(root,"invalid",2,5000,&s);p11_run(root,"controls",0,5000,&s);p11_run(root,"normal-write",0,25000,&s);p11_run(root,"normal-replay",0,25000,&s);
    p11_run(root,"restriction",0,5000,&s);p11_run(root,"binding-refusals",0,5000,&s);p11_run(root,"corrupt-write",0,35000,&s);
    p11_run(root,"corrupt-replay",0,10000,&s);p11_run(root,"sandbox",0,45000,&s);
    p11_check(&s,"all_nine_top_level_children_reaped",s.children,9);p11_check(&s,"one_confined_parent_worker_reaped",s.nested,1);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\":\"R33-N11\",\n  \"planned_top_level_children\":9","");
    json=p11_field(json,",\n  \"top_level_children_reaped\":",s.children);json=p11_field(json,",\n  \"nested_children_reaped\":",s.nested);
    json=p11_field(json,",\n  \"parent_failures\":",s.failed);json=p11_field(json,",\n  \"verified_completed_child_checks\":",s.child_checks);

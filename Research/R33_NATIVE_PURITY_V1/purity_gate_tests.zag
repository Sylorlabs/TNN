@import("purity.zag")

fn pt_num(x:i64)void {let s:[]u8=_zag_i64_to_str(x);_zag_print(s);_zag_str_free(s);}
fn pt_check(name:[]u8,actual:i64,expected:i64)i32 {
    _zag_print("R33_PURITY_V1_TEST,");_zag_print(name);_zag_print(",");pt_num(actual);_zag_print(",");pt_num(expected);_zag_println("");return (actual!=expected) as i32;
}
fn pt_tree(base:[]u8,name:[]u8)PuAudit {let p:[]u8=pu_join(base,name);let a:PuAudit=pu_audit_tree(p,1);_zag_str_free(p);return a;}

fn main()i32 {
    if(_zag_argc()!=2){return 64;}let base:[]u8=_zag_arg(1);let f:i32=0;
    f=f+pt_check("py_txt_inert_kind",pu_file_kind("history.py.txt"),0);
    f=f+pt_check("py_source_forbidden_kind",pu_file_kind("active.py"),3);
    f=f+pt_check("zag_kind",pu_file_kind("driver.zag"),1);
    f=f+pt_check("shell_kind",pu_file_kind("run.zsh"),2);
    f=f+pt_check("command_shell_kind",pu_file_kind("run.command"),2);
    f=f+pt_check("source_symlink_refused_policy",pu_source_symlink("run.zsh"),1);
    f=f+pt_check("artifact_symlink_outside_source_scope",pu_source_symlink("evidence.bin"),0);
    let p:PuAudit=pt_tree(base,"fixtures/positive");f=f+pt_check("positive_violations",p.violations,0);f=f+pt_check("positive_errors",p.errors,0);
    let n1:PuAudit=pt_tree(base,"fixtures/negative_python");f=f+pt_check("python_refused",(n1.violations>0) as i32,1);
    let n2:PuAudit=pt_tree(base,"fixtures/negative_torch");f=f+pt_check("torch_refused",(n2.violations>0) as i32,1);
    let n3:PuAudit=pt_tree(base,"fixtures/negative_runtime");f=f+pt_check("foreign_runtime_refused",(n3.violations>0) as i32,1);
    let n4:PuAudit=pt_tree(base,"fixtures/negative_compiler");f=f+pt_check("compiler_substitution_refused",(n4.violations>0) as i32,1);
    let n5:PuAudit=pt_tree(base,"fixtures/negative_zag_exec");f=f+pt_check("zag_foreign_exec_refused",(n5.violations>0) as i32,1);
    let n6:PuAudit=pt_tree(base,"fixtures/negative_foreign_source");f=f+pt_check("foreign_source_refused",(n6.violations>0) as i32,1);
    let n7:PuAudit=pt_tree(base,"fixtures/negative_shebang");f=f+pt_check("extensionless_shebang_refused",(n7.violations>0) as i32,1);
    let n8:PuAudit=pt_tree(base,"fixtures/negative_jq");f=f+pt_check("jq_refused",(n8.violations>0) as i32,1);
    _zag_print("R33_PURITY_V1_TEST_FAILURES,");pt_num(f);_zag_println("");return (f!=0) as i32;
}


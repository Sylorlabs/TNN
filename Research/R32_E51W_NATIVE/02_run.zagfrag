fn e51w_eval_store(
    records:[]i32,targets:[]i32,episodes:i32,per_cell:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    reached_store:[]i32,store_start:i32,
    known_total:*i32,known_reachable:*i32,no_unique_total:*i32,no_unique_reachable:*i32,mode_success:[]i32,mode_start:i32
)void {
    known_total.*=0; known_reachable.*=0; no_unique_total.*=0; no_unique_reachable.*=0;
    let m:i32=0; while(m<E45_MODES){ mode_success[mode_start+m]=0; m=m+1; }
    let episode:i32=0;
    while(episode<episodes){
        let no_unique:i32=e51v_episode_type_from_targets(targets,episode);
        let reached:i32=e51v_episode_reached(records,episode,no_unique,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,expert_weights,weight_start,expert_biases,bias_start);
        reached_store[store_start+episode]=reached;
        let mode:i32=e51v_validation_mode(episode,per_cell); if(reached==1){ mode_success[mode_start+mode]=mode_success[mode_start+mode]+1; }
        if(no_unique==1){ no_unique_total.*=no_unique_total.*+1; if(reached==1){ no_unique_reachable.*=no_unique_reachable.*+1; }
        }else{ known_total.*=known_total.*+1; if(reached==1){ known_reachable.*=known_reachable.*+1; } }
        episode=episode+1;
    }
}

fn e51w_paired(
    a:[]i32,a_start:i32,b:[]i32,b_start:i32,episodes:i32,per_cell:i32,
    gained:*i32,lost:*i32,switch_lost:*i32
)void {
    gained.*=0; lost.*=0; switch_lost.*=0; let i:i32=0;
    while(i<episodes){
        if(b[b_start+i]==1 && a[a_start+i]==0){ gained.*=gained.*+1; }
        if(b[b_start+i]==0 && a[a_start+i]==1){ lost.*=lost.*+1; let mode:i32=e51v_validation_mode(i,per_cell); if(e51v_switch_mode(mode)==1){ switch_lost.*=switch_lost.*+1; } }
        i=i+1;
    }
}

fn e51w_run(
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32
)i32 {
    _zag_println("R32_E51W_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51w_trajectory_optimization_dose_v1");
    _zag_println("claim_boundary,native_training_dose_discriminator_not_promotion");
    _zag_println("native_zag_v2_only=1"); _zag_println("evaluator_truth_exposed=0"); _zag_println("ambiguity_label_exposed=0"); _zag_println("validation_membership_exposed=0"); _zag_println("unknown_positive_target=0"); _zag_println("commit_order_changed=0"); _zag_println("routing_cells_fixed=32"); _zag_println("new_features_added=0"); _zag_println("cross_cell_edges_added=0"); _zag_println("graph_privileged=0"); _zag_println("trajectory_objective_changed=0"); _zag_println("only_optimization_dose_changes=1"); _zag_println("dose12_delegates_e51p_optimizer=1");

    let dev_worlds:[]i32=zalloc_i(E51W_DEV_EPISODES); let val_worlds:[]i32=zalloc_i(E51W_VALIDATION_EPISODES); let con_worlds:[]i32=zalloc_i(E51W_CONFIRM_EPISODES); let world_gate:i32=e51w_allocate_worlds(dev_worlds,val_worlds,con_worlds);
    let dev_records:[]i32=zalloc_i(E51W_DEV_SAMPLES*E50_RECORD_N); let dummy:[]i32=zalloc_i(E51W_DEV_SAMPLES*E50_RECORD_N); e45_zero(dev_records,E51W_DEV_SAMPLES*E50_RECORD_N); e45_zero(dummy,E51W_DEV_SAMPLES*E50_RECORD_N);
    let dev_unknown:i32=0; let dp:i32=0; let dn:i32=0; let canonical:i32=0; let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0; while(base_index<3){
            let mode:i32=0; while(mode<E45_MODES){
                let resource:i32=0; while(resource<E45_RESOURCES){
                    let episode:i32=0; while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(dev_worlds[index],mode,resource,canonical,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_records,dummy,&dev_unknown,&dp,&dn);
                        canonical=canonical+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    zfree(dummy); e45_print_pair("e51w_development_episodes_built",canonical); e45_print_pair("e51w_development_states_built",canonical*(E45_TAPE+1)); e45_print_pair("e51w_dev_unknown_target_nonzero",dev_unknown);

    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4); let backup_weights:[]i32=zalloc_i(4*E45_FEATURES); let backup_biases:[]i32=zalloc_i(4); let gram_f:[]i32=zalloc_i(E50_BATCH_GRAM); let gram_r:[]i32=zalloc_i(E50_BATCH_GRAM); let cross_f:[]i32=zalloc_i(E50_BATCH_CROSS); let cross_r:[]i32=zalloc_i(E50_BATCH_CROSS); let copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4); e45_zero(copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(dev_records,0,0,terminal_weights,terminal_biases,backup_weights,backup_biases,gram_f,gram_r,cross_f,cross_r,copy_weights,copy_biases);
    let unknown_parameter_nonzero:i32=0; if(terminal_biases[3]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; } let f:i32=0; while(f<E45_FEATURES){ if(terminal_weights[3*E45_FEATURES+f]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; } f=f+1; }

    let sign_targets:[]i32=zalloc_i(E51W_DEV_SAMPLES); let dev_pos:i32=0; let dev_neg:i32=0; let dev_zero:i32=0; e51m_build_targets(dev_records,E51W_DEV_SAMPLES,terminal_weights,terminal_biases,sign_targets,&dev_pos,&dev_neg,&dev_zero);
    let global_weights:[]i32=zalloc_i(E45_FEATURES); let global_bias:i32=0; let ls_f:i32=0; let lr_f:i32=0; let lt_f:i32=0; let ll_f:i64=0; e51m_fit_scalar_linear(dev_records,sign_targets,E51W_DEV_SAMPLES,0,global_weights,0,&global_bias,&ls_f,&lr_f,&lt_f,&ll_f);
    let reverse_global:[]i32=zalloc_i(E45_FEATURES); let reverse_bias:i32=0; let ls_r:i32=0; let lr_r:i32=0; let lt_r:i32=0; let ll_r:i64=0; e51m_fit_scalar_linear(dev_records,sign_targets,E51W_DEV_SAMPLES,1,reverse_global,0,&reverse_bias,&ls_r,&lr_r,&lt_r,&ll_r);
    let global_identity:i32=e51m_linear_identity(global_weights,0,global_bias,reverse_global,0,reverse_bias,ls_f,ls_r,lr_f,lr_r,lt_f,lt_r,ll_f,ll_r);

    let prototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let parents:[]i32=zalloc_i(E51O_MAX_CELLS); let scalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let scalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let scalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS); let tc_f:i32=0; let tt_f:i32=0; let tl_f:i64=0; let ts_f:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51W_DEV_SAMPLES,global_weights,0,global_bias,0,prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,&tc_f,&tt_f,&tl_f,&ts_f);
    let rprototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let rparents:[]i32=zalloc_i(E51O_MAX_CELLS); let rscalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let rscalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let rscalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS); let tc_r:i32=0; let tt_r:i32=0; let tl_r:i64=0; let ts_r:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51W_DEV_SAMPLES,global_weights,0,global_bias,1,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,&tc_r,&tt_r,&tl_r,&ts_r);
    let tree_identity:i32=e51o_local_identity(prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,tc_f,tt_f,tl_f,ts_f,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,tc_r,tt_r,tl_r,ts_r);
    let ranges:[]i32=zalloc_i(E45_FEATURES); let root:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(dev_records,E51W_DEV_SAMPLES,root,ranges);

    let sw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let sb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let su:[]i32=zalloc_i(E51S_SNAPSHOTS); let ss:[]i32=zalloc_i(E51S_SNAPSHOTS); let sr:[]i32=zalloc_i(E51S_SNAPSHOTS); let st:[]i32=zalloc_i(E51S_SNAPSHOTS); let sll:[]i32=zalloc_i(E51S_SNAPSHOTS); let slh:[]i32=zalloc_i(E51S_SNAPSHOTS); let strict_state_f:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51W_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,0,sw,sb,su,ss,sr,st,sll,slh,&strict_state_f);
    let rw:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); let rb:[]i32=zalloc_i(E51S_SNAPSHOTS*E51P_MAX_CELLS); let ru:[]i32=zalloc_i(E51S_SNAPSHOTS); let rs:[]i32=zalloc_i(E51S_SNAPSHOTS); let rr:[]i32=zalloc_i(E51S_SNAPSHOTS); let rt:[]i32=zalloc_i(E51S_SNAPSHOTS); let rll:[]i32=zalloc_i(E51S_SNAPSHOTS); let rlh:[]i32=zalloc_i(E51S_SNAPSHOTS); let strict_state_r:i32=0;
    e51s_fit_snapshots(dev_records,sign_targets,E51W_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,1,rw,rb,ru,rs,rr,rt,rll,rlh,&strict_state_r);
    let snapshot_identity:i32=e51s_snapshots_identity(sw,sb,su,ss,sr,st,sll,slh,rw,rb,ru,rs,rr,rt,rll,rlh);
    let control_ws:i32=1*E51P_MAX_CELLS*E45_FEATURES; let control_bs:i32=1*E51P_MAX_CELLS;
    _zag_print("e51w_state_control,"); e45_print_i32(ss[1]); _zag_print(","); e45_print_i32(su[1]); _zag_println("");

    let dose_weights:[]i32=zalloc_i(E51W_DOSES*E51W_CELLS*E45_FEATURES); let dose_biases:[]i32=zalloc_i(E51W_DOSES*E51W_CELLS); e45_zero(dose_weights,E51W_DOSES*E51W_CELLS*E45_FEATURES); e45_zero(dose_biases,E51W_DOSES*E51W_CELLS);
    let dose_rounds:[]i32=zalloc_i(E51W_DOSES); let dose_updates:[]i32=zalloc_i(E51W_DOSES); let dose_sweeps:[]i32=zalloc_i(E51W_DOSES); let dose_loss_low:[]i32=zalloc_i(E51W_DOSES); let dose_loss_high:[]i32=zalloc_i(E51W_DOSES); let dose_identity:[]i32=zalloc_i(E51W_DOSES); let dose_strict:[]i32=zalloc_i(E51W_DOSES);
    let dose_index:i32=0;
    while(dose_index<E51W_DOSES){
        let max_sweeps:i32=e51w_dose(dose_index);
        let fw1:[]i32=zalloc_i(E51W_CELLS*E45_FEATURES); let fb1:[]i32=zalloc_i(E51W_CELLS); let fwf:[]i32=zalloc_i(E51W_CELLS*E45_FEATURES); let fbf:[]i32=zalloc_i(E51W_CELLS); let rw1:[]i32=zalloc_i(E51W_CELLS*E45_FEATURES); let rb1:[]i32=zalloc_i(E51W_CELLS); let rwf:[]i32=zalloc_i(E51W_CELLS*E45_FEATURES); let rbf:[]i32=zalloc_i(E51W_CELLS);
        let fr:i32=0; let fs:i32=0; let ft:i32=0; let fl:i64=0; let fg:i32=0; let fu:i32=0; let fp:i32=0;
        e51w_fit_trajectory_dose(dev_records,sign_targets,E51W_DEV_EPISODES,global_weights,global_bias,prototypes,parents,ranges,sw,control_ws,sb,control_bs,0,max_sweeps,fw1,fb1,fwf,fbf,&fr,&fs,&ft,&fl,&fg,&fu,&fp);
        let br:i32=0; let bs2:i32=0; let bt:i32=0; let bl:i64=0; let bg:i32=0; let bu:i32=0; let bp:i32=0;
        e51w_fit_trajectory_dose(dev_records,sign_targets,E51W_DEV_EPISODES,global_weights,global_bias,prototypes,parents,ranges,sw,control_ws,sb,control_bs,1,max_sweeps,rw1,rb1,rwf,rbf,&br,&bs2,&bt,&bl,&bg,&bu,&bp);
        let identity:i32=e51w_dose_identity(fw1,fb1,fwf,fbf,fr,fs,ft,fl,fg,fu,fp,rw1,rb1,rwf,rbf,br,bs2,bt,bl,bg,bu,bp); dose_identity[dose_index]=identity; dose_rounds[dose_index]=fr; dose_updates[dose_index]=fu; dose_sweeps[dose_index]=fp; dose_loss_low[dose_index]=e50_loss_low(fl); dose_loss_high[dose_index]=e50_loss_high(fl); dose_strict[dose_index]=fg;
        if(fr>0){ e51v_copy_expert(fwf,0,fbf,0,dose_weights,dose_index*E51W_CELLS*E45_FEATURES,dose_biases,dose_index*E51W_CELLS); }
        else{ e51v_copy_expert(sw,control_ws,sb,control_bs,dose_weights,dose_index*E51W_CELLS*E45_FEATURES,dose_biases,dose_index*E51W_CELLS); }
        _zag_print("e51w_dose_fit,"); e45_print_i32(max_sweeps); _zag_print(","); e45_print_i32(fr); _zag_print(","); e45_print_i32(fu); _zag_print(","); e45_print_i32(fp); _zag_print(","); e45_print_i32(dose_loss_low[dose_index]); _zag_print(","); e45_print_i32(dose_loss_high[dose_index]); _zag_print(","); e45_print_i32(identity); _zag_print(","); e45_print_i32(fg); _zag_println("");
        zfree(fw1); zfree(fb1); zfree(fwf); zfree(fbf); zfree(rw1); zfree(rb1); zfree(rwf); zfree(rbf); dose_index=dose_index+1;
    }

    let dev_reach:[]i32=zalloc_i(E51W_ARMS); let dev_loss_low:[]i32=zalloc_i(E51W_ARMS); let dev_loss_high:[]i32=zalloc_i(E51W_ARMS);
    let arm:i32=0; while(arm<E51W_ARMS){
        let ew:[]i32=sw; let ws:i32=control_ws; let eb:[]i32=sb; let bs3:i32=control_bs; if(arm>0){ ew=dose_weights; ws=(arm-1)*E51W_CELLS*E45_FEATURES; eb=dose_biases; bs3=(arm-1)*E51W_CELLS; }
        let reached:i32=0; let loss:i64=e51v_trajectory_loss(dev_records,sign_targets,E51W_DEV_EPISODES,global_weights,global_bias,prototypes,parents,ranges,ew,ws,eb,bs3,&reached); dev_reach[arm]=reached; dev_loss_low[arm]=e50_loss_low(loss); dev_loss_high[arm]=e50_loss_high(loss);
        _zag_print("e51w_development_trajectory,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(reached); _zag_print(","); e45_print_i32(dev_loss_low[arm]); _zag_print(","); e45_print_i32(dev_loss_high[arm]); _zag_println(""); arm=arm+1;
    }

    let val_records:[]i32=zalloc_i(E51W_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(val_records,E51W_VALIDATION_SAMPLES*E50_RECORD_N); let val_unknown:i32=0; let val_count:i32=e51v_build_records(val_worlds,E51W_VALIDATION_EPISODES,20,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,val_records,&val_unknown);
    let val_targets:[]i32=zalloc_i(E51W_VALIDATION_SAMPLES); let val_pos:i32=0; let val_neg:i32=0; let val_zero:i32=0; e51m_build_targets(val_records,E51W_VALIDATION_SAMPLES,terminal_weights,terminal_biases,val_targets,&val_pos,&val_neg,&val_zero); e45_print_pair("e51w_validation_episodes_built",val_count); e45_print_pair("e51w_validation_states_built",val_count*(E45_TAPE+1)); e45_print_pair("e51w_validation_unknown_target_nonzero",val_unknown);

    let reached_store:[]i32=zalloc_i(E51W_ARMS*E51W_VALIDATION_EPISODES); let results:[]i32=zalloc_i(E51W_ARMS*12); let signs:[]i32=zalloc_i(E51W_ARMS*4); let modes:[]i32=zalloc_i(E51W_ARMS*E45_MODES); e45_zero(reached_store,E51W_ARMS*E51W_VALIDATION_EPISODES);
    arm=0; while(arm<E51W_ARMS){
        let ew:[]i32=sw; let ws:i32=control_ws; let eb:[]i32=sb; let bs4:i32=control_bs; if(arm>0){ ew=dose_weights; ws=(arm-1)*E51W_CELLS*E45_FEATURES; eb=dose_biases; bs4=(arm-1)*E51W_CELLS; }
        let pt:i32=0; let pc:i32=0; let nt:i32=0; let nc:i32=0; e51p_expert_sign_accuracy(val_records,val_targets,E51W_VALIDATION_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,E51W_CELLS,ew,ws,eb,bs4,&pt,&pc,&nt,&nc); signs[arm*4]=pc; signs[arm*4+1]=pt; signs[arm*4+2]=nc; signs[arm*4+3]=nt;
        let kt:i32=0; let kr:i32=0; let ut:i32=0; let ur:i32=0; e51w_eval_store(val_records,val_targets,E51W_VALIDATION_EPISODES,20,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,ew,ws,eb,bs4,reached_store,arm*E51W_VALIDATION_EPISODES,&kt,&kr,&ut,&ur,modes,arm*E45_MODES);
        results[arm*12]=kr; results[arm*12+1]=kt; results[arm*12+2]=ur; results[arm*12+3]=ut;
        if(arm>0){ let ga:i32=0; let la:i32=0; let sla:i32=0; e51w_paired(reached_store,0,reached_store,arm*E51W_VALIDATION_EPISODES,E51W_VALIDATION_EPISODES,20,&ga,&la,&sla); results[arm*12+4]=ga; results[arm*12+5]=la; results[arm*12+6]=sla; }
        if(arm>1){ let gp:i32=0; let lp:i32=0; let slp:i32=0; e51w_paired(reached_store,(arm-1)*E51W_VALIDATION_EPISODES,reached_store,arm*E51W_VALIDATION_EPISODES,E51W_VALIDATION_EPISODES,20,&gp,&lp,&slp); results[arm*12+7]=gp; results[arm*12+8]=lp; results[arm*12+9]=slp; }
        results[arm*12+10]=kr+ur; results[arm*12+11]=signs[arm*4+2]; arm=arm+1;
    }
    _zag_println("e51w_validation_columns,arm_0_state96_1_traj12_2_traj48_3_traj96_4_traj192,known_reachable,known_total,no_unique_reachable,no_unique_total,gain_vs_state96,loss_vs_state96,switch_loss_vs_state96,gain_vs_prev_traj,loss_vs_prev_traj,switch_loss_vs_prev,total_reachable,val_negative_correct,val_positive_correct,val_positive_total,val_negative_total");
    arm=0; while(arm<E51W_ARMS){ _zag_print("e51w_validation,"); e45_print_i32(arm); let j:i32=0; while(j<12){ _zag_print(","); e45_print_i32(results[arm*12+j]); j=j+1; } _zag_print(","); e45_print_i32(signs[arm*4]); _zag_print(","); e45_print_i32(signs[arm*4+1]); _zag_print(","); e45_print_i32(signs[arm*4+3]); _zag_println(""); arm=arm+1; }
    _zag_println("e51w_mode_columns,arm,mode,total,success,control96_success"); arm=0; while(arm<E51W_ARMS){ let mode:i32=0; while(mode<E45_MODES){ _zag_print("e51w_mode,"); e45_print_i32(arm); _zag_print(","); e45_print_i32(mode); _zag_print(",600,"); e45_print_i32(modes[arm*E45_MODES+mode]); _zag_print(","); e45_print_i32(modes[mode]); _zag_println(""); mode=mode+1; } arm=arm+1; }

    let counts_gate:i32=0; if(canonical==E51W_DEV_EPISODES && val_count==E51W_VALIDATION_EPISODES && results[1]==4200 && results[3]==1200){ counts_gate=1; }
    let target_gate:i32=0; if(dev_unknown==0 && val_unknown==0 && unknown_parameter_nonzero==0 && dev_pos>0 && dev_neg>0 && val_pos>0 && val_neg>0){ target_gate=1; }
    let dose_identity_gate:i32=1; dose_index=0; while(dose_index<E51W_DOSES){ if(dose_identity[dose_index]!=1 || dose_strict[dose_index]!=1){ dose_identity_gate=0; } dose_index=dose_index+1; }
    let integrity:i32=0; if(world_gate==1 && counts_gate==1 && target_gate==1 && base_fit_gate==1 && global_identity==1 && tree_identity==1 && snapshot_identity==1 && dose_identity_gate==1){ integrity=1; }
    let exact_arm:i32=-1; let stable_arm:i32=-1; let unstable_signal:i32=0;
    arm=1; while(arm<E51W_ARMS){
        let kr:i32=results[arm*12]; let ur:i32=results[arm*12+2]; let switcha:i32=results[arm*12+6];
        if(integrity==1 && kr==4200 && ur==1200 && switcha==0 && exact_arm<0){ exact_arm=arm; }
        if(arm>1){ let prev_total:i32=results[(arm-1)*12+10]; let total:i32=results[arm*12+10]; let prev_loss:i32=results[arm*12+8]; let prev_switch_loss:i32=results[arm*12+9]; if(integrity==1 && total>prev_total && prev_loss==0 && prev_switch_loss==0 && switcha==0 && stable_arm<0){ stable_arm=arm; } if(total>prev_total && prev_loss>0){ unstable_signal=1; } }
        arm=arm+1;
    }
    e45_print_pair("e51w_counts_gate",counts_gate); e45_print_pair("e51w_target_geometry_gate",target_gate); e45_print_pair("e51w_dose_identity_gate",dose_identity_gate); e45_print_pair("e51w_integrity_gate",integrity); e45_print_pair("e51w_exact_validation_arm",exact_arm); e45_print_pair("e51w_stable_partial_arm",stable_arm); e45_print_pair("e51w_unstable_aggregate_signal_gate",unstable_signal);

    let confirmation_executed:i32=0; let confirmation_exact:i32=0;
    if(exact_arm>=0){
        let con_records:[]i32=zalloc_i(E51W_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(con_records,E51W_CONFIRM_SAMPLES*E50_RECORD_N); let con_unknown:i32=0; let con_count:i32=e51v_build_records(con_worlds,E51W_CONFIRM_EPISODES,40,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,con_records,&con_unknown); let con_targets:[]i32=zalloc_i(E51W_CONFIRM_SAMPLES); let cp:i32=0; let cn:i32=0; let cz:i32=0; e51m_build_targets(con_records,E51W_CONFIRM_SAMPLES,terminal_weights,terminal_biases,con_targets,&cp,&cn,&cz);
        let di:i32=exact_arm-1; let con_reached:[]i32=zalloc_i(E51W_CONFIRM_EPISODES); let con_modes:[]i32=zalloc_i(E45_MODES); let kt:i32=0; let kr:i32=0; let ut:i32=0; let ur:i32=0; e51w_eval_store(con_records,con_targets,E51W_CONFIRM_EPISODES,40,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,dose_weights,di*E51W_CELLS*E45_FEATURES,dose_biases,di*E51W_CELLS,con_reached,0,&kt,&kr,&ut,&ur,con_modes,0); confirmation_executed=con_count; if(con_unknown==0 && kt==8400 && kr==8400 && ut==2400 && ur==2400){ confirmation_exact=1; }
        _zag_print("e51w_confirmation,"); e45_print_i32(exact_arm); _zag_print(","); e45_print_i32(kr); _zag_print(","); e45_print_i32(kt); _zag_print(","); e45_print_i32(ur); _zag_print(","); e45_print_i32(ut); _zag_println(""); zfree(con_records); zfree(con_targets); zfree(con_reached); zfree(con_modes);
    }
    e45_print_pair("e51w_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51w_confirmation_exact_gate",confirmation_exact);
    if(integrity==0){ _zag_println("e51w_outcome,INVALID_TRAJECTORY_DOSE_INTEGRITY_FAILURE"); }
    else if(exact_arm>=0 && confirmation_exact==1){ _zag_println("e51w_outcome,TRAJECTORY_DOSE_RESCUE_CONFIRMED"); }
    else if(exact_arm>=0){ _zag_println("e51w_outcome,TRAJECTORY_DOSE_VALIDATION_RESCUE_CONFIRMATION_FAIL"); }
    else if(stable_arm>=0){ _zag_println("e51w_outcome,TRAJECTORY_DOSE_STABLE_PARTIAL_SIGNAL"); }
    else if(unstable_signal==1){ _zag_println("e51w_outcome,TRAJECTORY_DOSE_AGGREGATE_SIGNAL_WITH_INSTABILITY"); }
    else{ _zag_println("e51w_outcome,TRAJECTORY_DOSE_PLATEAU"); }
    _zag_println("TNN_R32_E51W_EXECUTION_COMPLETE=1");

    zfree(dev_worlds); zfree(val_worlds); zfree(con_worlds); zfree(dev_records); zfree(terminal_weights); zfree(terminal_biases); zfree(backup_weights); zfree(backup_biases); zfree(gram_f); zfree(gram_r); zfree(cross_f); zfree(cross_r); zfree(copy_weights); zfree(copy_biases); zfree(sign_targets); zfree(global_weights); zfree(reverse_global); zfree(prototypes); zfree(parents); zfree(scalar_snapshots); zfree(scalar_counts); zfree(scalar_losses); zfree(rprototypes); zfree(rparents); zfree(rscalar_snapshots); zfree(rscalar_counts); zfree(rscalar_losses); zfree(ranges); zfree(root); zfree(sw); zfree(sb); zfree(su); zfree(ss); zfree(sr); zfree(st); zfree(sll); zfree(slh); zfree(rw); zfree(rb); zfree(ru); zfree(rs); zfree(rr); zfree(rt); zfree(rll); zfree(rlh); zfree(dose_weights); zfree(dose_biases); zfree(dose_rounds); zfree(dose_updates); zfree(dose_sweeps); zfree(dose_loss_low); zfree(dose_loss_high); zfree(dose_identity); zfree(dose_strict); zfree(dev_reach); zfree(dev_loss_low); zfree(dev_loss_high); zfree(val_records); zfree(val_targets); zfree(reached_store); zfree(results); zfree(signs); zfree(modes);
    if(integrity==1){ return 1; } return 0;
}

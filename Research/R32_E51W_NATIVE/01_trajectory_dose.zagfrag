// R32 E51W — optimization dose on the fixed E51V trajectory objective.

const E51W_DEV_EPISODES:i32=12960;
const E51W_DEV_SAMPLES:i32=220320;
const E51W_VALIDATION_EPISODES:i32=5400;
const E51W_VALIDATION_SAMPLES:i32=91800;
const E51W_CONFIRM_EPISODES:i32=10800;
const E51W_CONFIRM_SAMPLES:i32=183600;
const E51W_STAGE_DEV:i32=78;
const E51W_STAGE_VALIDATION:i32=79;
const E51W_STAGE_CONFIRM:i32=80;
const E51W_CELLS:i32=32;
const E51W_DOSES:i32=4;
const E51W_ARMS:i32=5;

fn e51w_dose(index:i32)i32 {
    if(index==0){ return 12; }
    if(index==1){ return 48; }
    if(index==2){ return 96; }
    return 192;
}

fn e51w_allocate_worlds(dev:[]i32,validation:[]i32,confirmation:[]i32)i32 {
    let i:i32=0; while(i<E51W_DEV_EPISODES){ dev[i]=e51n_world_id(E51W_STAGE_DEV,i); i=i+1; }
    i=0; while(i<E51W_VALIDATION_EPISODES){ validation[i]=e51n_world_id(E51W_STAGE_VALIDATION,i); i=i+1; }
    i=0; while(i<E51W_CONFIRM_EPISODES){ confirmation[i]=e51n_world_id(E51W_STAGE_CONFIRM,i); i=i+1; }
    let dlo:i32=dev[0]; let dhi:i32=dev[E51W_DEV_EPISODES-1]; let vlo:i32=validation[0]; let vhi:i32=validation[E51W_VALIDATION_EPISODES-1]; let clo:i32=confirmation[0]; let chi:i32=confirmation[E51W_CONFIRM_EPISODES-1];
    let partition:i32=0; if(dhi<vlo && vhi<clo){ partition=1; }
    let domains:i32=1; let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(dlo,d); let hi:i64=e51n_domain_state(chi,d); if(lo<=0 || hi>=E51N_RNG_MOD){ domains=0; }
        let o:i32=d+1; while(o<5){ let olo:i64=e51n_domain_state(dlo,o); let ohi:i64=e51n_domain_state(chi,o); if(!(hi<olo || ohi<lo)){ domains=0; } o=o+1; }
        d=d+1;
    }
    e45_print_pair("e51w_world_id_dev_lo",dlo); e45_print_pair("e51w_world_id_dev_hi",dhi); e45_print_pair("e51w_world_id_validation_lo",vlo); e45_print_pair("e51w_world_id_validation_hi",vhi); e45_print_pair("e51w_world_id_confirmation_lo",clo); e45_print_pair("e51w_world_id_confirmation_hi",chi); e45_print_pair("e51w_world_partition_gate",partition); e45_print_pair("e51w_domain_gate",domains); e45_print_pair("e51w_world_assignment_failures",0);
    if(partition==1 && domains==1){ return 1; } return 0;
}

fn e51w_fit_experts_dose(
    records:[]i32,targets:[]i32,count:i32,
    global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,cells:i32,
    reverse:i32,max_sweeps:i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    accepted_updates:*i32,accepted_sweeps:*i32,stop_reason:*i32,trace_hash:*i32,final_loss:*i64,strict_loss_gate:*i32
)void {
    if(max_sweeps==E51P_MAX_SWEEPS){
        e51p_fit_experts(records,targets,count,global_weights,global_bias,prototypes,parents,ranges,cells,reverse,expert_weights,weight_start,expert_biases,bias_start,accepted_updates,accepted_sweeps,stop_reason,trace_hash,final_loss,strict_loss_gate);
        return;
    }
    let cell:i32=0;
    while(cell<cells){
        expert_biases[bias_start+cell]=0;
        let feature:i32=0; while(feature<E45_FEATURES){ expert_weights[weight_start+cell*E45_FEATURES+feature]=0; feature=feature+1; }
        cell=cell+1;
    }
    let residuals:[]i32=zalloc_i(count); let heads:[]i32=zalloc_i(cells); let next:[]i32=zalloc_i(count);
    cell=0; while(cell<cells){ heads[cell]=-1; cell=cell+1; }
    let traversal:i32=0;
    while(traversal<count){
        let index:i32=traversal; if(reverse==1){ index=count-1-traversal; }
        let record_start:i32=index*E50_RECORD_N;
        let routed:i32=e51p_route_cell(records,record_start,prototypes,parents,ranges,cells);
        let base:i32=e51m_linear_scalar_predict(records,record_start,global_weights,0,global_bias);
        residuals[index]=targets[index]-base;
        next[index]=heads[routed]; heads[routed]=index;
        traversal=traversal+1;
    }
    let current_loss:i64=0; traversal=0; while(traversal<count){ let r:i64=residuals[traversal] as i64; current_loss=current_loss+r*r; traversal=traversal+1; }
    accepted_updates.*=0; accepted_sweeps.*=0; stop_reason.*=2; trace_hash.*=5309+max_sweeps; strict_loss_gate.*=1;
    let sweep:i32=0;
    while(sweep<max_sweeps){
        let accepted_this_sweep:i32=0; cell=0;
        while(cell<cells){
            let coordinate:i32=0;
            while(coordinate<=E45_FEATURES){
                let numerator:i64=0; let denominator:i64=0; let before:i64=0; let index:i32=heads[cell];
                while(index>=0){
                    let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                    let r:i64=residuals[index] as i64; numerator=numerator+r*(x as i64); denominator=denominator+(x as i64)*(x as i64); before=before+r*r; index=next[index];
                }
                if(denominator>0){
                    let raw_delta:i64=numerator*1000/denominator;
                    let old_value:i32=expert_biases[bias_start+cell]; let lo:i32=-4000; let hi:i32=4000;
                    if(coordinate>0){ old_value=expert_weights[weight_start+cell*E45_FEATURES+coordinate-1]; lo=-16000; hi=16000; }
                    let proposed:i32=e51m_clamp_i64((old_value as i64)+raw_delta,lo,hi); let delta:i32=proposed-old_value; let accepted_coordinate:i32=0;
                    while(delta!=0 && accepted_coordinate==0){
                        let after:i64=0; index=heads[cell];
                        while(index>=0){ let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); } let nr:i32=residuals[index]-delta*x/1000; after=after+(nr as i64)*(nr as i64); index=next[index]; }
                        if(after<before){
                            index=heads[cell]; while(index>=0){ let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); } residuals[index]=residuals[index]-delta*x/1000; index=next[index]; }
                            if(coordinate==0){ expert_biases[bias_start+cell]=old_value+delta; }else{ expert_weights[weight_start+cell*E45_FEATURES+coordinate-1]=old_value+delta; }
                            current_loss=current_loss+(after-before); if(after>=before){ strict_loss_gate.*=0; }
                            accepted_coordinate=1; accepted_this_sweep=1; accepted_updates.*=accepted_updates.*+1;
                            trace_hash.*=e46_hash_update(trace_hash.*,cell); trace_hash.*=e46_hash_update(trace_hash.*,coordinate); trace_hash.*=e46_hash_update(trace_hash.*,delta); trace_hash.*=e46_hash_update(trace_hash.*,e51m_hash_i64(current_loss));
                        }else{ delta=delta/2; }
                    }
                }
                coordinate=coordinate+1;
            }
            cell=cell+1;
        }
        if(accepted_this_sweep==0){ stop_reason.*=1; break; }
        accepted_sweeps.*=accepted_sweeps.*+1; sweep=sweep+1;
    }
    final_loss.*=current_loss; zfree(residuals); zfree(heads); zfree(next);
}

fn e51w_fit_trajectory_dose(
    records:[]i32,targets:[]i32,episodes:i32,
    global_weights:[]i32,global_bias:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,
    initial_weights:[]i32,initial_weight_start:i32,initial_biases:[]i32,initial_bias_start:i32,
    reverse:i32,max_sweeps:i32,
    first_weights:[]i32,first_biases:[]i32,final_weights:[]i32,final_biases:[]i32,
    accepted_rounds:*i32,selection_trace:*i32,fit_trace:*i32,final_loss:*i64,strict_gate:*i32,total_updates:*i32,total_sweeps:*i32
)void {
    let current_weights:[]i32=zalloc_i(E51W_CELLS*E45_FEATURES); let current_biases:[]i32=zalloc_i(E51W_CELLS);
    e51v_copy_expert(initial_weights,initial_weight_start,initial_biases,initial_bias_start,current_weights,0,current_biases,0);
    let current_reachable:i32=0; let current_loss:i64=e51v_trajectory_loss(records,targets,episodes,global_weights,global_bias,prototypes,parents,ranges,current_weights,0,current_biases,0,&current_reachable);
    accepted_rounds.*=0; selection_trace.*=5401+max_sweeps; fit_trace.*=5501+max_sweeps; strict_gate.*=1; total_updates.*=0; total_sweeps.*=0;
    e45_zero(first_weights,E51W_CELLS*E45_FEATURES); e45_zero(first_biases,E51W_CELLS); e45_zero(final_weights,E51W_CELLS*E45_FEATURES); e45_zero(final_biases,E51W_CELLS);
    let round:i32=0;
    while(round<E51V_MAX_ROUNDS){
        let critical_records:[]i32=zalloc_i(episodes*E50_RECORD_N); let critical_targets:[]i32=zalloc_i(episodes); let selected:[]i32=zalloc_i(episodes); let round_selection:i32=0;
        e51v_select_critical(records,targets,episodes,global_weights,global_bias,prototypes,parents,ranges,current_weights,0,current_biases,0,critical_records,critical_targets,selected,&round_selection);
        let candidate_weights:[]i32=zalloc_i(E51W_CELLS*E45_FEATURES); let candidate_biases:[]i32=zalloc_i(E51W_CELLS);
        let updates:i32=0; let sweeps:i32=0; let reason:i32=0; let trace:i32=0; let state_loss:i64=0; let fit_strict:i32=0;
        e51w_fit_experts_dose(critical_records,critical_targets,episodes,global_weights,global_bias,prototypes,parents,ranges,E51W_CELLS,reverse,max_sweeps,candidate_weights,0,candidate_biases,0,&updates,&sweeps,&reason,&trace,&state_loss,&fit_strict);
        total_updates.*=total_updates.*+updates; total_sweeps.*=total_sweeps.*+sweeps;
        let candidate_reachable:i32=0; let candidate_loss:i64=e51v_trajectory_loss(records,targets,episodes,global_weights,global_bias,prototypes,parents,ranges,candidate_weights,0,candidate_biases,0,&candidate_reachable);
        selection_trace.*=e46_hash_update(selection_trace.*,round); selection_trace.*=e46_hash_update(selection_trace.*,round_selection);
        fit_trace.*=e46_hash_update(fit_trace.*,round); fit_trace.*=e46_hash_update(fit_trace.*,updates); fit_trace.*=e46_hash_update(fit_trace.*,sweeps); fit_trace.*=e46_hash_update(fit_trace.*,reason); fit_trace.*=e46_hash_update(fit_trace.*,trace); fit_trace.*=e46_hash_update(fit_trace.*,e51m_hash_i64(candidate_loss));
        if(fit_strict!=1){ strict_gate.*=0; }
        if(candidate_loss<current_loss){
            if(accepted_rounds.*==0){ e51v_copy_expert(candidate_weights,0,candidate_biases,0,first_weights,0,first_biases,0); }
            e51v_copy_expert(candidate_weights,0,candidate_biases,0,current_weights,0,current_biases,0); current_loss=candidate_loss; accepted_rounds.*=accepted_rounds.*+1;
        }else{
            zfree(critical_records); zfree(critical_targets); zfree(selected); zfree(candidate_weights); zfree(candidate_biases); break;
        }
        zfree(critical_records); zfree(critical_targets); zfree(selected); zfree(candidate_weights); zfree(candidate_biases); round=round+1;
    }
    if(accepted_rounds.*>0){ e51v_copy_expert(current_weights,0,current_biases,0,final_weights,0,final_biases,0); }
    final_loss.*=current_loss; zfree(current_weights); zfree(current_biases);
}

fn e51w_dose_identity(
    aw:[]i32,ab:[]i32,afw:[]i32,afb:[]i32,ar:i32,as:i32,at:i32,al:i64,ag:i32,au:i32,ap:i32,
    bw:[]i32,bb:[]i32,bfw:[]i32,bfb:[]i32,br:i32,bs:i32,bt:i32,bl:i64,bg:i32,bu:i32,bp:i32
)i32 {
    if(au!=bu || ap!=bp){ return 0; }
    return e51v_trajectory_identity(aw,ab,afw,afb,ar,as,at,al,ag,bw,bb,bfw,bfb,br,bs,bt,bl,bg);
}

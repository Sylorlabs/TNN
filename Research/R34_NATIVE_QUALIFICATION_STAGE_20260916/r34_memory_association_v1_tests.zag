@import("r34_memory_association_v1.zag")

fn main()i32 {
    let failures:i32=0;
    let left:[]i32=zalloc(4);let right:[]i32=zalloc(4);let strength:[]f32=zalloc(4);let uses:[]i32=zalloc(4);let active:[]i32=zalloc(4);let init:i32=0;while(init<4){left[init]=-1;right[init]=-1;init=init+1;}
    if(r34a1_put(left,right,strength,uses,active,0,7,3,0.5)!=R34A1_OK || left[0]!=3 || right[0]!=7){failures=failures+1;}
    let slot:i32=-1;if(r34a1_find(left,right,active,7,3,&slot)!=R34A1_OK || slot!=0){failures=failures+1;}
    if(r34a1_credit(strength,uses,active,0,0.75)!=R34A1_OK || strength[0]<1.24 || uses[0]!=1){failures=failures+1;}
    if(r34a1_put(left,right,strength,uses,active,1,3,9,2.0)!=R34A1_OK){failures=failures+1;}
    let nodes:[]i32=zalloc(2);nodes[0]=-1;nodes[1]=-1;let scores:[]f32=zalloc(2);let count:i32=0;
    if(r34a1_neighbors(left,right,strength,active,3,nodes,scores,2,&count)!=R34A1_OK || count!=2 || nodes[0]!=9 || nodes[1]!=7){failures=failures+1;}
    if(r34a1_delete(left,right,strength,uses,active,1)!=R34A1_OK || active[1]!=0){failures=failures+1;}
    _zag_print("R34_MEMORY_ASSOCIATION_V1_FAILURES,");_zag_println(_zag_i64_to_str(failures as i64));
    return (failures!=0) as i32;
}

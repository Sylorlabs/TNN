@import("r34_curiosity_progress_v1.zag")
fn main()i32 {
    let failures:i32=0;
    let f:[]f32=zalloc(3);let s:[]f32=zalloc(3);let n:[]i32=zalloc(3);let last:[]i64=zalloc(3);
    if(r34c1_init(f,s,n,last,0.25)!=R34C1_OK){failures=failures+1;}
    // Improving error creates fast/slow separation (learning progress).
    let t:i64=0;while(t<8){if(r34c1_observe_error(f,s,n,last,0,t,0.02,0.25,0.03)!=R34C1_OK){failures=failures+1;}t=t+1;}
    let learn:f64=0.0;if(r34c1_score(f,s,n,last,0,8,0.10,&learn)!=R34C1_OK || !(learn>0.02)){failures=failures+1;}
    // Stable high error converges fast/slow toward one another instead of staying intrinsically valuable merely because it is surprising.
    t=0;while(t<40){if(r34c1_observe_error(f,s,n,last,1,t,0.25,0.25,0.03)!=R34C1_OK){failures=failures+1;}t=t+1;}
    let noisy:f64=0.0;if(r34c1_score(f,s,n,last,1,40,0.10,&noisy)!=R34C1_OK){failures=failures+1;}
    // With equal dynamics/count, stale evidence is worth rechecking sooner.
    f[2]=f[1];s[2]=s[1];n[2]=n[1];last[2]=0;last[1]=39;
    let stale:f64=0.0;let fresh:f64=0.0;if(r34c1_score(f,s,n,last,2,40,0.10,&stale)!=R34C1_OK || r34c1_score(f,s,n,last,1,40,0.10,&fresh)!=R34C1_OK || !(stale>fresh)){failures=failures+1;}
    let bf:[]f32=zalloc(3);let bs:[]f32=zalloc(3);let bn:[]i32=zalloc(3);let bl:[]i64=zalloc(3);let j:i32=0;while(j<3){bf[j]=f[j];bs[j]=s[j];bn[j]=n[j];bl[j]=last[j];j=j+1;}
    if(r34c1_state_equal(f,s,n,last,bf,bs,bn,bl)!=1){failures=failures+1;}
    _zag_print("R34_CURIOSITY_PROGRESS_V1_FAILURES,");_zag_println(_zag_i64_to_str(failures as i64));return (failures!=0) as i32;
}

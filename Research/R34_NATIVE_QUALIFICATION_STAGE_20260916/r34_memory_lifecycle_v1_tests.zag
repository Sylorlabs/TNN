@import("r34_memory_lifecycle_v1.zag")

fn r34t_close(a:f64,b:f64,tol:f64)i32 @noalloc {let d:f64=a-b;if(d<0.0){d=-d;}return (d<=tol) as i32;}

fn main()i32 {
    let failures:i32=0;
    let w: []f32 = zalloc(8);
    let x: []f32 = zalloc(8);x[0]=1.0;
    let p:f32=0.0;
    if(r34m1_predict(w,0.0,x,&p)!=R34M1_OK || r34t_close(p as f64,0.5,1.0e-6)!=1){failures=failures+1;}
    let b:f32=0.0;
    let before:f32=0.0;let after:f32=0.0;
    r34m1_predict(w,b,x,&before);
    if(r34m1_delayed_credit(w,&b,x,1,0.1)!=R34M1_OK){failures=failures+1;}
    r34m1_predict(w,b,x,&after);if(!(after>before)){failures=failures+1;}
    let saved_w: []f32 = zalloc(8);let wi:i32=0;while(wi<8){saved_w[wi]=w[wi];wi=wi+1;}let saved_b:f32=b;let restored:f32=0.0;
    r34m1_predict(saved_w,saved_b,x,&restored);if(r34t_close(after as f64,restored as f64,1.0e-8)!=1){failures=failures+1;}

    let slots: []f32 = zalloc(16);slots[8]=1.0;
    let steps: []i32 = zalloc_i(2);steps[0]=10;steps[1]=20;let live: []i32 = zalloc_i(2);live[1]=1;let chosen:i32=-99;
    if(r34m1_choose_exact_slot(w,b,slots,steps,live,2,x,30,&chosen)!=R34M1_OK || chosen!=0){failures=failures+1;}
    if(r34m1_store_exact(slots,steps,live,2,0,x,30)!=R34M1_OK || live[0]!=1 || steps[0]!=30){failures=failures+1;}
    if(r34m1_release_exact(live,1)!=R34M1_OK || live[1]!=0){failures=failures+1;}

    zfree(w);zfree(x);zfree(saved_w);zfree(slots);zfree(steps);zfree(live);
    _zag_print("R34_MEMORY_LIFECYCLE_V1_FAILURES,");let failure_text:[]u8=_zag_i64_to_str(failures as i64);_zag_println(failure_text);_zag_str_free(failure_text);
    return (failures!=0) as i32;
}

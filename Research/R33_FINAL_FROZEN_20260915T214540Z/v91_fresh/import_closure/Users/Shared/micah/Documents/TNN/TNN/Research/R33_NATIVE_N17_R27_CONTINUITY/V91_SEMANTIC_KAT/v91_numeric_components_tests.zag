@import("v91_numeric_components.zag")
@import("r25_mt19937_v1.zag")
fn vt_near(a:f64,b:f64,tol:f64)bool {let d:f64=a-b;return d<=tol&&d>= -tol;}
fn main()i32 {
 if(_zag_argc()!=2){return 2;}let root:[]u8=_zag_arg(1);let failures:i32=0;
 let dec:[]f64=vn_alloc(4);let raw:[]u8=nio_alloc(16);raw[2]=128;raw[3]=63;raw[6]=0;raw[7]=192;raw[8]=1;raw[14]=128;raw[15]=128;
 if(vn_decode(raw,dec)!=0||dec[0]!=1.0||dec[1]!= -2.0||dec[2]!=vn_pow2(-149)||dec[3]!= -vn_pow2(-126)){failures=failures+1;}
 raw[3]=127;raw[2]=128;if(vn_decode(raw,dec)!=2){failures=failures+1;}
 if(!vt_near(vn_exp(0.0),1.0,0.000000000001)||!vt_near(vn_exp(0.6931471805599453),2.0,0.000000000001)||!vt_near(vn_sigmoid(0.0),0.5,0.000000000001)||!vt_near(vn_tanh(0.5493061443340549),0.5,0.000000000001)){failures=failures+1;}
 let wi:[]f64=vn_alloc(384*96);let wh:[]f64=vn_alloc(384*128);let bi:[]f64=vn_alloc(384);let bh:[]f64=vn_alloc(384);let x:[]f64=vn_alloc(96);let h:[]f64=vn_alloc(128);let out:[]f64=vn_alloc(128);let gi:[]f64=vn_alloc(384);let gh:[]f64=vn_alloc(384);
 h[0]=1.0;if(vn_gru(wi,wh,bi,bh,x,h,out,gi,gh)!=0||!vt_near(out[0],0.5,0.000000000001)){failures=failures+1;}h[0]=0.0;bh[256]=1.0986122886681098;if(vn_gru(wi,wh,bi,bh,x,h,out,gi,gh)!=0||!vt_near(out[0],0.25,0.000000000001)){failures=failures+1;}
 let flat:[]f64=vn_alloc(2);let weight:[]f64=vn_alloc(2);let pick:i32=-1;if(vn_categorical(flat,0.0,weight,&pick)!=0||pick!=0||vn_categorical(flat,0.75,weight,&pick)!=0||pick!=1||vn_categorical(flat,1.0,weight,&pick)!=6){failures=failures+1;}
 let emb:[]f64=vn_load(root,"emb.weight.f32le",16416,"1a794c01fb13e6419f021cde17646bc996d9c830a9889074ea9bd697c75c852c");
 let cw:[]f64=vn_load(root,"ch.weight.f32le",5376,"67920504b899c84081ae40ffc3bdfa3b0346c76a55f793c5e9f0b7f72dbe2012");let cb:[]f64=vn_load(root,"ch.bias.f32le",128,"75ccb126de2b5472bad4fe7c8bf5b0bcc798bcc3a2276f76538b1fef42daa0f2");
 let ew:[]f64=vn_load(root,"ce.weight.f32le",2016,"da025df5a1aad39d831548df8f3a471704e291245ad7f23f01eef5e43a90d030");let eb:[]f64=vn_load(root,"ce.bias.f32le",48,"feb0fe10b7a2e3b5d3677b004e2596a058e815d724ec1d1ccdeb245501628675");
 wi=vn_load(root,"rnn.weight_ih_l0.f32le",36864,"924901700863d73d6486a0f9cc24bbea13bfd97f9dcc829f9b6379b5a56e5b07");wh=vn_load(root,"rnn.weight_hh_l0.f32le",49152,"8e3123d57aa5b2c47d6644e9ee27bb1c811202afcc9f4b20b1c08235f3bb25da");bi=vn_load(root,"rnn.bias_ih_l0.f32le",384,"5f7031f4aa28e27000e07ba4c73626a75201b9133c27a7c76e1e4c92eb79950d");bh=vn_load(root,"rnn.bias_hh_l0.f32le",384,"46c566e116bc208ef5bf094a7fc19cc9cda9b79f374d1b71c3618f504fa4d0b4");
 let ow:[]f64=vn_load(root,"out.weight.f32le",43776,"a7da5c280c99848005d7afe1cb1bd29aa50371b7c321bfc3cb6fc497b84cda4e");let ob:[]f64=vn_load(root,"out.bias.f32le",342,"0b4a444e1212268e550b8680fbfca0ae9ba034a67e6c91a03be09607623ede5d");
 let interpreter:[]f64=vn_load(root,"interpreter.W.f32le",32256,"3f5c806cfa243f9fc5de398101d93a9fc59b8ea1d4cb55cbe08165d940e3e5c3");if(interpreter.len!=32256){return 20;}
 if(emb.len!=16416||cw.len!=5376||cb.len!=128||ew.len!=2016||eb.len!=48||wi.len!=36864||wh.len!=49152||bi.len!=384||bh.len!=384||ow.len!=43776||ob.len!=342){_zag_println("V91_COMPONENT_INPUT_REFUSAL");return 20;}
 // Isolated projections use an explicit synthetic six-hot vector. No claim
 // these inputs are the historical shuffled held-out conditions.
 let cond:[]f64=vn_alloc(42);cond[0]=1.0;cond[8]=1.0;cond[16]=1.0;cond[24]=1.0;cond[30]=1.0;cond[38]=1.0;let cp:[]f64=vn_alloc(128);let ep:[]f64=vn_alloc(48);if(vn_linear(cw,cb,cond,cp)!=0||vn_linear(ew,eb,cond,ep)!=0){failures=failures+1;}
 let logits:[]f64=vn_alloc(342);let probabilities:[]f64=vn_alloc(342);let rng:R25MT19937V1=r25mt_new();r25mt_init_genrand(&rng,23101);let step:i32=0;let changed:i32=0;
 while(step<16){x[0]=(step as f64)*0.01;if(vn_gru(wi,wh,bi,bh,x,h,out,gi,gh)!=0||vn_linear(ow,ob,out,logits)!=0){return 21;}let word:u64=0;r25mt_next_u32(&rng,&word);let uniform:f64=(word as f64)/4294967296.0;if(vn_categorical(logits,uniform,probabilities,&pick)!=0){return 22;}_zag_print("V91_ISOLATED_COMPONENT_DIAGNOSTIC,");_zag_print(_zag_i64_to_str(step as i64));_zag_print(",categorical_id=");_zag_println(_zag_i64_to_str(pick as i64));let j:i32=0;while(j<128){if(out[j]!=h[j]){changed=1;}h[j]=out[j];j=j+1;}step=step+1;}
 if(changed!=1){failures=failures+1;}_zag_print("V91_NUMERIC_COMPONENT_FAILURES,");_zag_println(_zag_i64_to_str(failures as i64));_zag_println("V91_HISTORICAL_GENERATED_STRINGS,0");return (failures!=0) as i32;
}

// V72: paired minimal callers for the macOS-arm64 checkpoint call corruption.
// Return 0 only when both status and the caller-owned `at` value are exact.
@import("checkpoint.zag")

fn v72_exact()i32 {
    let out:[]u8=nio_alloc(300000);let payload:[]u8=nio_alloc(1);
    let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    if(out.len!=300000 || payload.len!=1 || parent.len!=32 || previous.len!=32){return 70;}
    ns_sha256("V72_EXACT",parent);
    let rc:i32=cl_checkpoint_begin(out,1,parent,previous);
    let at:i32=112;
    if(rc==0){rc=cl_checkpoint_section(out,&at,1,payload);}
    let ok:i32=(rc==0 && at==121) as i32;
    nio_free(out);nio_free(payload);nio_free(parent);nio_free(previous);
    return (ok!=1) as i32;
}

fn v72_let_result()i32 {
    let out:[]u8=nio_alloc(300000);let payload:[]u8=nio_alloc(1);
    let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    if(out.len!=300000 || payload.len!=1 || parent.len!=32 || previous.len!=32){return 70;}
    ns_sha256("V72_LET",parent);
    let begin:i32=cl_checkpoint_begin(out,1,parent,previous);
    let at:i32=112;let wr:i32=cl_checkpoint_section(out,&at,1,payload);
    let ok:i32=(begin==0 && wr==0 && at==121) as i32;
    nio_free(out);nio_free(payload);nio_free(parent);nio_free(previous);
    return (ok!=1) as i32;
}

fn main()i32 {
    let a:i32=v72_exact();let b:i32=v72_let_result();
    _zag_print("V72_EXACT,");cl_number(a as i64);_zag_println("");
    _zag_print("V72_LET,");cl_number(b as i64);_zag_println("");
    return ((a!=0 || b!=0) as i32);
}

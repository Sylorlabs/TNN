fn e51ad_run(
    source_trust:[]i32,dependence_penalty:[]i32,consequence:[]i32,hazard:[]i32,shadow_weights:[]i32,shadow_bias:i32,
    terminal_reproduction_gate:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,term_expert_w:[]i32,term_expert_b:[]i32
)i32 {
    _zag_println("R32_E51AD_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51ad_trajectory_critical_conservative_router_v1");
    _zag_println("claim_boundary,native_fixed_mechanism_routing_discriminator_not_promotion");
    _zag_println("native_zag_v2_only=1");
    _zag_println("mature_slot_controller_frozen=1");
    _zag_println("direct_candidate_controller_frozen=1");
    _zag_println("gate_features,32_evaluator_blind_terminal_features");
    _zag_println("gate_tie_behavior,preserve_mature_slot");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("ambiguity_label_exposed=0");
    _zag_println("mode_resource_identity_exposed=0");
    _zag_println("unknown_learned_head=0");
    _zag_println("topology_changed=0");
    _zag_println("graph_privileged=0");

    let world_gate:i32=e51ad_world_gate();
    let terminal_hash_before:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);

    // Reconstruct the frozen E51AB global + local-384 direct learner from stage 89.
    let direct_dev_source:[]i32=zalloc_i(E51AB_DEV_SAMPLES*E50_RECORD_N); let direct_dev:[]i32=zalloc_i(E51AB_DEV_SAMPLES*E50_RECORD_N);
    let direct_t0:[]i32=zalloc_i(E51AB_DEV_SAMPLES); let direct_t1:[]i32=zalloc_i(E51AB_DEV_SAMPLES); let direct_pos:[]i32=zalloc_i(2); let direct_neg:[]i32=zalloc_i(2);
    e45_zero(direct_dev_source,E51AB_DEV_SAMPLES*E50_RECORD_N); e45_zero(direct_dev,E51AB_DEV_SAMPLES*E50_RECORD_N);
    let direct_unknown:i32=0;
    let direct_built:i32=e51ab_build_partition(
        E51AB_STAGE_DEV,E51AB_DEV_EPISODES,48,
        source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
        direct_dev_source,direct_dev,direct_t0,direct_t1,direct_pos,direct_neg,&direct_unknown
    );
    zfree(direct_dev_source);

    let g0:[]i32=zalloc_i(E45_FEATURES); let rg0:[]i32=zalloc_i(E45_FEATURES);
    let g1:[]i32=zalloc_i(E45_FEATURES); let rg1:[]i32=zalloc_i(E45_FEATURES);
    let b0:i32=0; let rb0:i32=0; let b1:i32=0; let rb1:i32=0;
    let gs00:i32=0; let gr00:i32=0; let gh00:i32=0; let gl00:i64=0;
    let gs01:i32=0; let gr01:i32=0; let gh01:i32=0; let gl01:i64=0;
    let gs10:i32=0; let gr10:i32=0; let gh10:i32=0; let gl10:i64=0;
    let gs11:i32=0; let gr11:i32=0; let gh11:i32=0; let gl11:i64=0;
    e51m_fit_scalar_linear(direct_dev,direct_t0,E51AB_DEV_SAMPLES,0,g0,0,&b0,&gs00,&gr00,&gh00,&gl00);
    e51m_fit_scalar_linear(direct_dev,direct_t0,E51AB_DEV_SAMPLES,1,rg0,0,&rb0,&gs01,&gr01,&gh01,&gl01);
    e51m_fit_scalar_linear(direct_dev,direct_t1,E51AB_DEV_SAMPLES,0,g1,0,&b1,&gs10,&gr10,&gh10,&gl10);
    e51m_fit_scalar_linear(direct_dev,direct_t1,E51AB_DEV_SAMPLES,1,rg1,0,&rb1,&gs11,&gr11,&gh11,&gl11);
    let direct_gid0:i32=e51m_linear_identity(g0,0,b0,rg0,0,rb0,gs00,gs01,gr00,gr01,gh00,gh01,gl00,gl01);
    let direct_gid1:i32=e51m_linear_identity(g1,0,b1,rg1,0,rb1,gs10,gs11,gr10,gr11,gh10,gh11,gl10,gl11);
    let direct_global_identity:i32=0; if(direct_gid0==1 && direct_gid1==1){ direct_global_identity=1; }

    let per_direct_w:i32=E51AB_CANDIDATES*E51AB_CELLS*E45_FEATURES;
    let per_direct_b:i32=E51AB_CANDIDATES*E51AB_CELLS;
    let direct_lw:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_direct_w); let direct_lb:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_direct_b);
    let direct_rlw:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_direct_w); let direct_rlb:[]i32=zalloc_i(E51AB_LOCAL_DOSES*per_direct_b);
    e45_zero(direct_lw,E51AB_LOCAL_DOSES*per_direct_w); e45_zero(direct_lb,E51AB_LOCAL_DOSES*per_direct_b);
    e45_zero(direct_rlw,E51AB_LOCAL_DOSES*per_direct_w); e45_zero(direct_rlb,E51AB_LOCAL_DOSES*per_direct_b);
    let direct_local_identity:i32=1; let direct_local_nondegenerate:i32=1; let candidate:i32=0;
    while(candidate<E51AB_CANDIDATES){
        let targets:[]i32=direct_t0; let gw:[]i32=g0; let gb:i32=b0;
        if(candidate==1){ targets=direct_t1; gw=g1; gb=b1; }
        let ws:i32=per_direct_w+candidate*E51AB_CELLS*E45_FEATURES;
        let bs:i32=per_direct_b+candidate*E51AB_CELLS;
        let u0:i32=0; let sw0:i32=0; let re0:i32=0; let tr0:i32=0; let lo0:i64=0; let sg0:i32=0;
        let u1:i32=0; let sw1:i32=0; let re1:i32=0; let tr1:i32=0; let lo1:i64=0; let sg1:i32=0;
        e51x_fit_experts_dose(direct_dev,targets,E51AB_DEV_SAMPLES,gw,gb,prototypes,parents,ranges,E51AB_CELLS,0,384,direct_lw,ws,direct_lb,bs,&u0,&sw0,&re0,&tr0,&lo0,&sg0);
        e51x_fit_experts_dose(direct_dev,targets,E51AB_DEV_SAMPLES,gw,gb,prototypes,parents,ranges,E51AB_CELLS,1,384,direct_rlw,ws,direct_rlb,bs,&u1,&sw1,&re1,&tr1,&lo1,&sg1);
        let id:i32=e51p_expert_identity(direct_lw,ws,direct_lb,bs,direct_rlw,ws,direct_rlb,bs,E51AB_CELLS,u0,u1,sw0,sw1,re0,re1,tr0,tr1,lo0,lo1,sg0,sg1);
        if(id==0){ direct_local_identity=0; }
        if(u0<=0){ direct_local_nondegenerate=0; }
        _zag_print("e51ad_direct_local384_fit,"); e45_print_i32(candidate); _zag_print(","); e45_print_i32(u0); _zag_print(","); e45_print_i32(sw0); _zag_print(","); e45_print_i32(re0); _zag_print(","); e45_print_i32(tr0); _zag_print(","); e45_print_i64(lo0); _zag_print(","); e45_print_i32(id); _zag_println("");
        candidate=candidate+1;
    }
    let direct_target_support:i32=0;
    if(direct_pos[0]>0 && direct_neg[0]>0 && direct_pos[1]>0 && direct_neg[1]>0){ direct_target_support=1; }
    let direct_integrity:i32=0;
    if(direct_built==E51AB_DEV_EPISODES && direct_unknown==0 && direct_target_support==1 && direct_global_identity==1 && direct_local_identity==1 && direct_local_nondegenerate==1){ direct_integrity=1; }
    let direct_hash_before:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
    e45_print_pair("e51ad_direct_reconstruction_episodes",direct_built); e45_print_pair("e51ad_direct_reconstruction_states",direct_built*(E45_TAPE+1));
    e45_print_pair("e51ad_direct_global_identity_gate",direct_global_identity); e45_print_pair("e51ad_direct_local_identity_gate",direct_local_identity);
    e45_print_pair("e51ad_direct_local_nondegenerate_gate",direct_local_nondegenerate); e45_print_pair("e51ad_direct_target_support_gate",direct_target_support);
    e45_print_pair("e51ad_direct_integrity_gate",direct_integrity); e45_print_pair("e51ad_direct_hash_before",direct_hash_before);
    zfree(direct_dev); zfree(direct_t0); zfree(direct_t1); zfree(direct_pos); zfree(direct_neg);

    // Build the fresh stage-94 router development partition.
    let dev_control:[]i32=zalloc_i(E51AD_DEV_SAMPLES*E50_RECORD_N); let dev_direct:[]i32=zalloc_i(E51AD_DEV_SAMPLES*E50_RECORD_N);
    let dev_t0:[]i32=zalloc_i(E51AD_DEV_SAMPLES); let dev_t1:[]i32=zalloc_i(E51AD_DEV_SAMPLES); let dev_pos:[]i32=zalloc_i(2); let dev_neg:[]i32=zalloc_i(2);
    e45_zero(dev_control,E51AD_DEV_SAMPLES*E50_RECORD_N); e45_zero(dev_direct,E51AD_DEV_SAMPLES*E50_RECORD_N);
    let dev_unknown:i32=0;

    records:[]i32,episodes:i32,
    slot_success:[]i32,direct_success:[]i32,kinds:[]i32,
    positive_copies:i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    critical_records:[]i32,critical_targets:[]i32,
    selected_count:*i32,trace_hash:*i32
)void {
    selected_count.*=0; trace_hash.*=6203;
    let episode:i32=0;
    while(episode<episodes){
        let kind:i32=kinds[episode];
        if(kind!=E51AD_KIND_NEITHER){
            let selected:i32=-1; let best:i32=0; let t:i32=0;
            while(t<=E45_TAPE){
                let index:i32=episode*(E45_TAPE+1)+t; let eligible:i32=slot_success[index];
                if(kind==E51AD_KIND_DIRECT_ONLY){ eligible=direct_success[index]; }
                if(eligible==1){
                    let rs:i32=index*E50_RECORD_N;
                    let score:i32=e51p_expert_predict(
                        records,rs,global_weights,global_bias,
                        prototypes,parents,ranges,E51AD_CELLS,
                        expert_weights,weight_start,expert_biases,bias_start
                    );
                    if(selected<0){ selected=index; best=score;
                    }else{ if(kind==E51AD_KIND_PRESERVE){ if(score<best){ selected=index; best=score; }
                        }else{ if(score>best){ selected=index; best=score; } }
                    }
                }
                t=t+1;
            }
            if(selected>=0){
                let copies:i32=1; let target:i32=-1000;
                if(kind==E51AD_KIND_DIRECT_ONLY){ copies=positive_copies; target=1000; }
                let copy:i32=0;
                while(copy<copies){
                    let dst:i32=selected_count.* * E50_RECORD_N; let src:i32=selected*E50_RECORD_N; let c:i32=0;
                    while(c<E50_RECORD_N){ critical_records[dst+c]=records[src+c]; c=c+1; }
                    critical_records[dst+34]=0; critical_records[dst+35]=0; critical_records[dst+36]=0; critical_records[dst+37]=0;
                    critical_targets[selected_count.*]=target;
                    selected_count.*=selected_count.*+1; copy=copy+1;
                }
                trace_hash.*=e46_hash_update(trace_hash.*,episode);
                trace_hash.*=e46_hash_update(trace_hash.*,kind);
                trace_hash.*=e46_hash_update(trace_hash.*,selected);
                trace_hash.*=e46_hash_update(trace_hash.*,target);
                trace_hash.*=e46_hash_update(trace_hash.*,copies);
            }
        }
        episode=episode+1;
    }
}

fn e51ad_critical_hash(records:[]i32,targets:[]i32,count:i32)i32 {
    let h:i32=6257; let i:i32=0;
    while(i<count){
        h=e46_hash_update(h,targets[i]);
        let c:i32=0; while(c<E50_RECORD_N){ h=e46_hash_update(h,records[i*E50_RECORD_N+c]); c=c+1; }
        i=i+1;
    }
    return h;
}

fn e51ad_preservation_shift(
    records:[]i32,episodes:i32,slot_success:[]i32,kinds:[]i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32
)i32 {
    let worst_min:i32=-2000000000; let found:i32=0; let episode:i32=0;
    while(episode<episodes){
        if(kinds[episode]==E51AD_KIND_PRESERVE){
            let minimum:i32=2000000000; let t:i32=0;
            while(t<=E45_TAPE){
                let index:i32=episode*(E45_TAPE+1)+t;
                if(slot_success[index]==1){
                    let score:i32=e51p_expert_predict(
                        records,index*E50_RECORD_N,global_weights,global_bias,
                        prototypes,parents,ranges,E51AD_CELLS,
                        expert_weights,weight_start,expert_biases,bias_start
                    );
                    if(score<minimum){ minimum=score; }
                }
                t=t+1;
            }
            if(found==0 || minimum>worst_min){ worst_min=minimum; }
            found=1;
        }
        episode=episode+1;
    }
    if(found==0){ return 0; }
    return -worst_min;
}

fn e51ad_router_objective(
    records:[]i32,episodes:i32,
    slot_success:[]i32,direct_success:[]i32,kinds:[]i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    expert_weights:[]i32,weight_start:i32,expert_biases:[]i32,bias_start:i32,
    shift:i32,preserve_reached:*i32,direct_reached:*i32
)i64 {
    preserve_reached.*=0; direct_reached.*=0; let loss:i64=0; let episode:i32=0;
    while(episode<episodes){
        let kind:i32=kinds[episode];
        if(kind==E51AD_KIND_PRESERVE){
            let minimum:i32=2000000000; let t:i32=0;
            while(t<=E45_TAPE){
                let index:i32=episode*(E45_TAPE+1)+t;
                if(slot_success[index]==1){
                    let score:i32=e51ad_gate_score(records,index*E50_RECORD_N,global_weights,global_bias,prototypes,parents,ranges,expert_weights,weight_start,expert_biases,bias_start,shift);
                    if(score<minimum){ minimum=score; }
                }
                t=t+1;
            }
            if(minimum<=0){ preserve_reached.*=preserve_reached.*+1;
            }else{ let miss:i64=(minimum+1) as i64; loss=loss+miss*miss; }
        }else{ if(kind==E51AD_KIND_DIRECT_ONLY){
                let maximum:i32=-2000000000; let t:i32=0;
                while(t<=E45_TAPE){
                    let index:i32=episode*(E45_TAPE+1)+t;
                    if(direct_success[index]==1){
                        let score:i32=e51ad_gate_score(records,index*E50_RECORD_N,global_weights,global_bias,prototypes,parents,ranges,expert_weights,weight_start,expert_biases,bias_start,shift);
                        if(score>maximum){ maximum=score; }
                    }
                    t=t+1;
                }
                if(maximum>0){ direct_reached.*=direct_reached.*+1;
                }else{ let miss:i64=(1-maximum) as i64; loss=loss+miss*miss; }
            }
        }
        episode=episode+1;
    }
    return loss;
}

fn e51ad_fit_router_dose(
    records:[]i32,episodes:i32,
    slot_success:[]i32,direct_success:[]i32,kinds:[]i32,
    preserve_count:i32,direct_only_count:i32,positive_copies:i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    reverse:i32,max_sweeps:i32,
    first_weights:[]i32,first_biases:[]i32,
    final_weights:[]i32,final_biases:[]i32,final_shift:*i32,
    accepted_rounds:*i32,total_updates:*i32,total_sweeps:*i32,stop_reason:*i32,
    selection_trace:*i32,fit_trace:*i32,final_loss:*i64,strict_gate:*i32,
    final_preserve:*i32,final_direct:*i32
)void {
    let current_weights:[]i32=zalloc_i(E51AD_CELLS*E45_FEATURES); let current_biases:[]i32=zalloc_i(E51AD_CELLS);
    e45_zero(current_weights,E51AD_CELLS*E45_FEATURES); e45_zero(current_biases,E51AD_CELLS);
    e45_zero(first_weights,E51AD_CELLS*E45_FEATURES); e45_zero(first_biases,E51AD_CELLS);
    e45_zero(final_weights,E51AD_CELLS*E45_FEATURES); e45_zero(final_biases,E51AD_CELLS);
    let current_shift:i32=e51ad_preservation_shift(records,episodes,slot_success,kinds,global_weights,global_bias,prototypes,parents,ranges,current_weights,0,current_biases,0);
    let current_preserve:i32=0; let current_direct:i32=0;
    let current_loss:i64=e51ad_router_objective(records,episodes,slot_success,direct_success,kinds,global_weights,global_bias,prototypes,parents,ranges,current_weights,0,current_biases,0,current_shift,&current_preserve,&current_direct);
    accepted_rounds.*=0; total_updates.*=0; total_sweeps.*=0; stop_reason.*=2;
    selection_trace.*=6301+max_sweeps; fit_trace.*=6401+max_sweeps; strict_gate.*=1;
    let round:i32=0;
    while(round<E51AD_MAX_ROUNDS){
        let critical_records:[]i32=zalloc_i(E51AD_MAX_CRITICAL*E50_RECORD_N); let critical_targets:[]i32=zalloc_i(E51AD_MAX_CRITICAL);
        let critical_count:i32=0; let critical_trace:i32=0;
        e51ad_select_critical(records,episodes,slot_success,direct_success,kinds,positive_copies,global_weights,global_bias,prototypes,parents,ranges,current_weights,0,current_biases,0,critical_records,critical_targets,&critical_count,&critical_trace);
        let candidate_weights:[]i32=zalloc_i(E51AD_CELLS*E45_FEATURES); let candidate_biases:[]i32=zalloc_i(E51AD_CELLS);
        let updates:i32=0; let sweeps:i32=0; let fit_reason:i32=0; let trace:i32=0; let state_loss:i64=0; let fit_strict:i32=0;
        e51x_fit_experts_dose(
            critical_records,critical_targets,critical_count,
            global_weights,global_bias,prototypes,parents,ranges,E51AD_CELLS,
            reverse,max_sweeps,candidate_weights,0,candidate_biases,0,
            &updates,&sweeps,&fit_reason,&trace,&state_loss,&fit_strict
        );
        let candidate_shift:i32=e51ad_preservation_shift(records,episodes,slot_success,kinds,global_weights,global_bias,prototypes,parents,ranges,candidate_weights,0,candidate_biases,0);
        let candidate_preserve:i32=0; let candidate_direct:i32=0;
        let candidate_loss:i64=e51ad_router_objective(records,episodes,slot_success,direct_success,kinds,global_weights,global_bias,prototypes,parents,ranges,candidate_weights,0,candidate_biases,0,candidate_shift,&candidate_preserve,&candidate_direct);
        selection_trace.*=e46_hash_update(selection_trace.*,round); selection_trace.*=e46_hash_update(selection_trace.*,critical_count); selection_trace.*=e46_hash_update(selection_trace.*,critical_trace);
        fit_trace.*=e46_hash_update(fit_trace.*,round); fit_trace.*=e46_hash_update(fit_trace.*,updates); fit_trace.*=e46_hash_update(fit_trace.*,sweeps); fit_trace.*=e46_hash_update(fit_trace.*,fit_reason); fit_trace.*=e46_hash_update(fit_trace.*,trace); fit_trace.*=e46_hash_update(fit_trace.*,candidate_shift); fit_trace.*=e46_hash_update(fit_trace.*,candidate_direct); fit_trace.*=e46_hash_update(fit_trace.*,e51m_hash_i64(candidate_loss));
        total_updates.*=total_updates.*+updates; total_sweeps.*=total_sweeps.*+sweeps;
        if(fit_strict!=1){ strict_gate.*=0; }
        let accept:i32=0;
        if(candidate_preserve==preserve_count){
            if(candidate_direct>current_direct){ accept=1;
            }else{ if(candidate_direct==current_direct && candidate_loss<current_loss){ accept=1; } }
        }
        if(accept==1){
            if(accepted_rounds.*==0){ e51v_copy_expert(candidate_weights,0,candidate_biases,0,first_weights,0,first_biases,0); }
            e51v_copy_expert(candidate_weights,0,candidate_biases,0,current_weights,0,current_biases,0);
            current_shift=candidate_shift; current_preserve=candidate_preserve; current_direct=candidate_direct; current_loss=candidate_loss;
            accepted_rounds.*=accepted_rounds.*+1;
        }else{
            stop_reason.*=1;
            zfree(critical_records); zfree(critical_targets); zfree(candidate_weights); zfree(candidate_biases);
            break;
        }
        zfree(critical_records); zfree(critical_targets); zfree(candidate_weights); zfree(candidate_biases);
        round=round+1;
    }
    e51v_copy_expert(current_weights,0,current_biases,0,final_weights,0,final_biases,0);
    final_shift.*=current_shift; final_loss.*=current_loss; final_preserve.*=current_preserve; final_direct.*=current_direct;
    zfree(current_weights); zfree(current_biases);
}


fn e51ad_run(
    source_trust:[]i32,
    dependence_penalty:[]i32,
    terminal_samples:[]i32,
    posterior_utility_weights:[]i32,
    posterior_utility_bias:[]i32,
    evidence_utility_weights:[]i32,
    evidence_utility_bias:[]i32,
    provisional_utility_weights:[]i32,
    provisional_utility_bias:[]i32,
    passive_weights:[]i32,
    active_weights:[]i32,
    terminal_global_weights:[]i32,
    terminal_global_bias:i32,
    prototypes:[]i32,
    prototype_features:[]i32,
    terminal_local_weights:[]i32,
    terminal_local_bias:[]i32,
    parent_integrity_gate:i32,
    terminal_reproduction_gate:i32
)i32 {
    e45_print_string("R32_E51AD_NATIVE v1\n");
    e45_print_string("experiment_schema,tnn_r32_e51ad_trajectory_critical_hybrid_router_v1\n");
    e45_print_string("claim_boundary,native_router_discriminator_not_promotion\n");
    e45_print_string("native_zag_v2_only=1\n");
    e45_print_string("mature_slot_controller_frozen=1\n");
    e45_print_string("direct_candidate_controller_frozen=1\n");
    e45_print_string("router_state,evaluator_blind_32_terminal_features\n");
    e45_print_string("router_tie,mature_controller_preserved\n");
    e45_print_string("evaluator_truth_exposed=0\n");
    e45_print_string("ambiguity_label_exposed=0\n");
    e45_print_string("unknown_learned_head=0\n");
    e45_print_string("topology_changed=0\n");
    e45_print_string("graph_privileged=0\n");

    let world_dev_lo:i32=e51n_world_id(E51AD_STAGE_DEVELOPMENT,0);
    let world_dev_hi:i32=e51n_world_id(E51AD_STAGE_DEVELOPMENT,E51AD_DEVELOPMENT_EPISODES-1);
    let world_val_lo:i32=e51n_world_id(E51AD_STAGE_VALIDATION,0);
    let world_val_hi:i32=e51n_world_id(E51AD_STAGE_VALIDATION,E51AD_VALIDATION_EPISODES-1);
    let world_conf_lo:i32=e51n_world_id(E51AD_STAGE_CONFIRMATION,0);
    let world_conf_hi:i32=e51n_world_id(E51AD_STAGE_CONFIRMATION,E51AD_CONFIRMATION_EPISODES-1);
    let previous_hi:i32=e51n_world_id(E51AD_PREVIOUS_STAGE,E51AC_CONFIRMATION_EPISODES-1);
    let world_gate:i32=0;
    if(world_dev_lo>previous_hi && world_dev_hi<world_val_lo && world_val_hi<world_conf_lo && world_conf_lo<=world_conf_hi){ world_gate=1; }
    let domain_gate:i32=1;
    let domain:i32=E51N_DOMAIN_TRUTH;
    while(domain<=E51N_DOMAIN_RESOURCE){
        let a:i32=e51n_domain_state(E51AD_STAGE_DEVELOPMENT,0,domain);
        let b:i32=e51n_domain_state(E51AD_STAGE_DEVELOPMENT,E51AD_DEVELOPMENT_EPISODES-1,domain);
        let c:i32=e51n_domain_state(E51AD_STAGE_VALIDATION,0,domain);
        let d:i32=e51n_domain_state(E51AD_STAGE_CONFIRMATION,0,domain);
        if(a==b || a==c || a==d || b==c || b==d || c==d){ domain_gate=0; }
        domain=domain+1;
    }
    e45_print_pair("e51ad_world_id_development_lo",world_dev_lo);
    e45_print_pair("e51ad_world_id_development_hi",world_dev_hi);
    e45_print_pair("e51ad_world_id_validation_lo",world_val_lo);
    e45_print_pair("e51ad_world_id_validation_hi",world_val_hi);
    e45_print_pair("e51ad_world_id_confirmation_lo",world_conf_lo);
    e45_print_pair("e51ad_world_id_confirmation_hi",world_conf_hi);
    e45_print_pair("e51ad_world_partition_gate",world_gate);
    e45_print_pair("e51ad_domain_gate",domain_gate);

    let terminal_hash_before:i32=e51y_terminal_hash(
        terminal_global_weights,terminal_global_bias,terminal_local_weights,terminal_local_bias
    );

    let direct_development_control:[]i32=zalloc_i(E51AB_DEVELOPMENT_STATES*E50_RECORD_N);
    let direct_development_records:[]i32=zalloc_i(E51AB_DEVELOPMENT_STATES*E50_RECORD_N);
    let direct_assignment_failures:i32=e51ab_build_partition(
        E51AB_STAGE_DEVELOPMENT,E51AB_DEVELOPMENT_EPISODES,E51AB_PER_CELL,
        direct_development_control,direct_development_records,
        terminal_global_weights,terminal_global_bias,
        terminal_local_weights,terminal_local_bias,
        prototypes,prototype_features
    );
    let candidate_target0:[]i32=zalloc_i(E51AB_DEVELOPMENT_STATES);
    let candidate_target1:[]i32=zalloc_i(E51AB_DEVELOPMENT_STATES);
    let positive0:i32=0; let negative0:i32=0; let positive1:i32=0; let negative1:i32=0;
    e51ab_extract_candidate_targets(
        direct_development_records,E51AB_DEVELOPMENT_STATES,
        candidate_target0,candidate_target1,
        &positive0,&negative0,&positive1,&negative1
    );
    let candidate_global_weights:[]i32=zalloc_i(E51AB_CANDIDATES*E45_FEATURES);
    let candidate_global_reverse:[]i32=zalloc_i(E51AB_CANDIDATES*E45_FEATURES);
    let candidate_global_bias:[]i32=zalloc_i(E51AB_CANDIDATES);
    let candidate_global_reverse_bias:[]i32=zalloc_i(E51AB_CANDIDATES);
    let candidate_local_weights:[]i32=zalloc_i(E51AB_CANDIDATES*2*E51AB_CELLS*E45_FEATURES);
    let candidate_local_reverse:[]i32=zalloc_i(E51AB_CANDIDATES*2*E51AB_CELLS*E45_FEATURES);
    let candidate_local_bias:[]i32=zalloc_i(E51AB_CANDIDATES*2*E51AB_CELLS);
    let candidate_local_reverse_bias:[]i32=zalloc_i(E51AB_CANDIDATES*2*E51AB_CELLS);
    let candidate_global_trace:[]i32=zalloc_i(E51AB_CANDIDATES);
    let candidate_global_reverse_trace:[]i32=zalloc_i(E51AB_CANDIDATES);
    let candidate_global_loss_low:[]i32=zalloc_i(E51AB_CANDIDATES);
    let candidate_global_loss_high:[]i32=zalloc_i(E51AB_CANDIDATES);
    let candidate_global_reverse_loss_low:[]i32=zalloc_i(E51AB_CANDIDATES);
    let candidate_global_reverse_loss_high:[]i32=zalloc_i(E51AB_CANDIDATES);
    let candidate_local_trace:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_reverse_trace:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_loss_low:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_loss_high:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_reverse_loss_low:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_reverse_loss_high:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_updates:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_reverse_updates:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_sweeps:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_reverse_sweeps:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_reason:[]i32=zalloc_i(E51AB_CANDIDATES*2);
    let candidate_local_reverse_reason:[]i32=zalloc_i(E51AB_CANDIDATES*2);

    let candidate:i32=0;
    while(candidate<E51AB_CANDIDATES){
        let targets:[]i32=candidate_target0;
        if(candidate==1){ targets=candidate_target1; }
        e51m_fit_scalar_linear(
            direct_development_records,targets,E51AB_DEVELOPMENT_STATES,0,
            candidate_global_weights,candidate*E45_FEATURES,
            &candidate_global_bias[candidate],&candidate_global_trace[candidate],
            &candidate_global_loss_low[candidate],&candidate_global_loss_high[candidate]
        );
        e51m_fit_scalar_linear(
            direct_development_records,targets,E51AB_DEVELOPMENT_STATES,1,
            candidate_global_reverse,candidate*E45_FEATURES,
            &candidate_global_reverse_bias[candidate],&candidate_global_reverse_trace[candidate],
            &candidate_global_reverse_loss_low[candidate],&candidate_global_reverse_loss_high[candidate]
        );
        let dose:i32=1;
        let local_slot:i32=candidate*2+dose;
        e51x_fit_experts_dose(
            direct_development_records,targets,E51AB_DEVELOPMENT_STATES,0,
            candidate_global_weights,candidate*E45_FEATURES,candidate_global_bias[candidate],
            candidate_local_weights,local_slot*E51AB_CELLS*E45_FEATURES,
            candidate_local_bias,local_slot*E51AB_CELLS,
            &candidate_local_trace[local_slot],
            &candidate_local_loss_low[local_slot],&candidate_local_loss_high[local_slot],
            &candidate_local_updates[local_slot],&candidate_local_sweeps[local_slot],
            &candidate_local_reason[local_slot],E51AB_CELLS,0,384
        );
        e51x_fit_experts_dose(
            direct_development_records,targets,E51AB_DEVELOPMENT_STATES,1,
            candidate_global_reverse,candidate*E45_FEATURES,candidate_global_reverse_bias[candidate],
            candidate_local_reverse,local_slot*E51AB_CELLS*E45_FEATURES,
            candidate_local_reverse_bias,local_slot*E51AB_CELLS,
            &candidate_local_reverse_trace[local_slot],
            &candidate_local_reverse_loss_low[local_slot],&candidate_local_reverse_loss_high[local_slot],
            &candidate_local_reverse_updates[local_slot],&candidate_local_reverse_sweeps[local_slot],
            &candidate_local_reverse_reason[local_slot],E51AB_CELLS,0,384
        );
        candidate=candidate+1;
    }
    let candidate_global_identity:i32=1;
    let candidate_local_identity:i32=1;
    let candidate_local_nondegenerate:i32=1;
    candidate=0;
    while(candidate<E51AB_CANDIDATES){
        if(e51m_linear_identity(
            candidate_global_weights,candidate*E45_FEATURES,candidate_global_bias[candidate],candidate_global_trace[candidate],candidate_global_loss_low[candidate],candidate_global_loss_high[candidate],
            candidate_global_reverse,candidate*E45_FEATURES,candidate_global_reverse_bias[candidate],candidate_global_reverse_trace[candidate],candidate_global_reverse_loss_low[candidate],candidate_global_reverse_loss_high[candidate]
        )==0){ candidate_global_identity=0; }
        let local_slot:i32=candidate*2+1;
        if(e51p_expert_identity(
            candidate_global_weights,candidate*E45_FEATURES,candidate_global_bias[candidate],
            candidate_local_weights,local_slot*E51AB_CELLS*E45_FEATURES,candidate_local_bias,local_slot*E51AB_CELLS,
            candidate_local_trace[local_slot],candidate_local_loss_low[local_slot],candidate_local_loss_high[local_slot],candidate_local_updates[local_slot],candidate_local_sweeps[local_slot],candidate_local_reason[local_slot],
            candidate_global_reverse,candidate*E45_FEATURES,candidate_global_reverse_bias[candidate],
            candidate_local_reverse,local_slot*E51AB_CELLS*E45_FEATURES,candidate_local_reverse_bias,local_slot*E51AB_CELLS,
            candidate_local_reverse_trace[local_slot],candidate_local_reverse_loss_low[local_slot],candidate_local_reverse_loss_high[local_slot],candidate_local_reverse_updates[local_slot],candidate_local_reverse_sweeps[local_slot],candidate_local_reverse_reason[local_slot],E51AB_CELLS
        )==0){ candidate_local_identity=0; }
        if(candidate_local_updates[local_slot]<=0){ candidate_local_nondegenerate=0; }
        candidate=candidate+1;
    }
    let direct_support_gate:i32=0;
    if(positive0>0 && negative0>0 && positive1>0 && negative1>0){ direct_support_gate=1; }
    let direct_reconstruction_gate:i32=0;
    if(direct_assignment_failures==0 && direct_support_gate==1 && candidate_global_identity==1 && candidate_local_identity==1 && candidate_local_nondegenerate==1){ direct_reconstruction_gate=1; }
    let direct_hash_before:i32=e51ad_direct_model_hash(
        candidate_global_weights,candidate_global_bias,candidate_local_weights,candidate_local_bias
    );
    e45_print_quint("e51ad_direct_target_support",positive0,negative0,positive1,negative1);
    e45_print_pair("e51ad_direct_assignment_failures",direct_assignment_failures);
    e45_print_pair("e51ad_direct_global_identity_gate",candidate_global_identity);
    e45_print_pair("e51ad_direct_local384_identity_gate",candidate_local_identity);
    e45_print_pair("e51ad_direct_local384_nondegenerate_gate",candidate_local_nondegenerate);
    e45_print_pair("e51ad_direct_reconstruction_gate",direct_reconstruction_gate);
    e45_print_pair("e51ad_direct_hash_before",direct_hash_before);
    zfree(direct_development_control);
    zfree(direct_development_records);
    zfree(candidate_target0);
    zfree(candidate_target1);
    zfree(candidate_global_trace);
    zfree(candidate_global_reverse_trace);
    zfree(candidate_global_loss_low);
    zfree(candidate_global_loss_high);
    zfree(candidate_global_reverse_loss_low);
    zfree(candidate_global_reverse_loss_high);
    zfree(candidate_local_trace);
    zfree(candidate_local_reverse_trace);
    zfree(candidate_local_loss_low);
    zfree(candidate_local_loss_high);
    zfree(candidate_local_reverse_loss_low);
    zfree(candidate_local_reverse_loss_high);
    zfree(candidate_local_updates);
    zfree(candidate_local_reverse_updates);
    zfree(candidate_local_sweeps);
    zfree(candidate_local_reverse_sweeps);
    zfree(candidate_local_reason);
    zfree(candidate_local_reverse_reason);

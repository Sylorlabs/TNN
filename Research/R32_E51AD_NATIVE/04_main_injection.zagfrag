    let e51ad_result:i32=e51ad_run(
        source_trust,dependence_penalty,terminal_samples,
        posterior_utility_weights,posterior_utility_bias,
        evidence_utility_weights,evidence_utility_bias,
        provisional_utility_weights,provisional_utility_bias,
        passive_weights,active_weights,
        terminal_global_weights,terminal_global_bias,
        prototypes,prototype_features,
        terminal_local_weights,terminal_local_bias,
        e51y_parent_e50_integrity_gate,e51y_terminal_reproduction_gate
    );
    e45_print_pair("e51ad_standalone_router_exit",e51ad_result);
    zfree(source_trust); zfree(dependence_penalty); zfree(terminal_samples);
    zfree(posterior_utility_weights); zfree(posterior_utility_bias);
    zfree(evidence_utility_weights); zfree(evidence_utility_bias);
    zfree(provisional_utility_weights); zfree(provisional_utility_bias);
    zfree(passive_weights); zfree(active_weights);
    zfree(terminal_global_weights); zfree(prototypes); zfree(prototype_features);
    zfree(terminal_local_weights); zfree(terminal_local_bias);
    return;

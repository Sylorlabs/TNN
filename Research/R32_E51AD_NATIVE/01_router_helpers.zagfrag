const E51AD_STAGE_DEVELOPMENT:i32=94;
const E51AD_STAGE_VALIDATION:i32=95;
const E51AD_STAGE_CONFIRMATION:i32=96;
const E51AD_PREVIOUS_STAGE:i32=93;
const E51AD_DEVELOPMENT_EPISODES:i32=12960;
const E51AD_DEVELOPMENT_STATES:i32=220320;
const E51AD_VALIDATION_EPISODES:i32=5400;
const E51AD_VALIDATION_STATES:i32=91800;
const E51AD_CONFIRMATION_EPISODES:i32=10800;
const E51AD_CONFIRMATION_STATES:i32=183600;
const E51AD_PER_CELL:i32=120;
const E51AD_KNOWN_MODE_COUNT:i32=7;
const E51AD_CELLS:i32=32;
const E51AD_ARMS:i32=5;
const E51AD_FIELDS:i32=9;
const E51AD_ARM_SLOT:i32=0;
const E51AD_ARM_GLOBAL:i32=1;
const E51AD_ARM_LOCAL_STATE:i32=2;
const E51AD_ARM_LOCAL_TRAJECTORY:i32=3;
const E51AD_ARM_ORACLE_UNION:i32=4;
const E51AD_ROUTER_MARGIN:i32=1000;
const E51AD_TRAJECTORY_ROUNDS:i32=4;

fn e51ad_build_last_feasible(stage:i32,episodes:i32,per_cell:i32,last_feasible:[]i32)void {
    let episode:i32=0;
    while(episode<episodes){
        let cell:i32=episode/per_cell;
        let resource:i32=cell%5;
        let resource_state:i32=e51n_domain_state(stage,episode,E51N_DOMAIN_RESOURCE);
        let one_resource:[]i32=zalloc_i(E45_RESOURCE_N);
        let step_losses:[]i32=zalloc_i(E45_TAPE);
        e51n_make_resource(one_resource,0,resource_state,resource);
        e45_build_step_losses(one_resource,0,step_losses,0);
        let remaining:i32=one_resource[0]+one_resource[1];
        let accessible:i32=1;
        let last:i32=0;
        let t:i32=0;
        while(t<E45_TAPE){
            let cost:i32=step_losses[t];
            if(accessible==1 && cost<=remaining){
                remaining=remaining-cost;
                last=t+1;
            }else{
                accessible=0;
            }
            t=t+1;
        }
        last_feasible[episode]=last;
        zfree(one_resource);
        zfree(step_losses);
        episode=episode+1;
    }
}

fn e51ad_slot_choice(
    control_records:[]i32,
    record_start:i32,
    terminal_global_weights:[]i32,
    terminal_global_bias:i32,
    terminal_local_weights:[]i32,
    terminal_local_bias:[]i32,
    prototypes:[]i32,
    prototype_features:[]i32
)i32 {
    return e51y_terminal_choice(
        control_records,record_start,
        terminal_global_weights,terminal_global_bias,
        terminal_local_weights,terminal_local_bias,
        prototypes,prototype_features
    );
}

fn e51ad_direct_choice(
    direct_records:[]i32,
    record_start:i32,
    candidate_global_weights:[]i32,
    candidate_global_bias:[]i32,
    candidate_local_weights:[]i32,
    candidate_local_bias:[]i32,
    prototypes:[]i32,
    prototype_features:[]i32
)i32 {
    return e51ab_direct_choice(
        3,direct_records,record_start,
        candidate_global_weights,candidate_global_bias,
        candidate_local_weights,candidate_local_bias,
        prototypes,prototype_features
    );
}

fn e51ad_direct_action_code(choice:i32)i32 {
    if(choice<E51AB_CANDIDATES){ return E51AC_CANDIDATE_ACTION_BASE+choice; }
    return R32E45_TERM_UNKNOWN;
}

fn e51ad_router_predict(
    arm:i32,
    records:[]i32,
    record_start:i32,
    global_weights:[]i32,
    global_bias:i32,
    local_state_weights:[]i32,
    local_state_bias:[]i32,
    local_trajectory_weights:[]i32,
    local_trajectory_bias:[]i32,
    prototypes:[]i32,
    prototype_features:[]i32
)i32 {
    if(arm==E51AD_ARM_GLOBAL){
        return e51m_linear_scalar_predict(records,record_start,global_weights,0,global_bias);
    }
    if(arm==E51AD_ARM_LOCAL_STATE){
        return e51p_expert_predict(
            records,record_start,
            global_weights,0,global_bias,
            local_state_weights,0,local_state_bias,0,
            prototypes,prototype_features,E51AD_CELLS
        );
    }
    if(arm==E51AD_ARM_LOCAL_TRAJECTORY){
        return e51p_expert_predict(
            records,record_start,
            global_weights,0,global_bias,
            local_trajectory_weights,0,local_trajectory_bias,0,
            prototypes,prototype_features,E51AD_CELLS
        );
    }
    return 0;
}

fn e51ad_build_router_targets(
    control_records:[]i32,
    direct_records:[]i32,
    state_count:i32,
    terminal_global_weights:[]i32,
    terminal_global_bias:i32,
    terminal_local_weights:[]i32,
    terminal_local_bias:[]i32,
    candidate_global_weights:[]i32,
    candidate_global_bias:[]i32,
    candidate_local_weights:[]i32,
    candidate_local_bias:[]i32,
    prototypes:[]i32,
    prototype_features:[]i32,
    targets:[]i32,
    positive:*i32,
    negative:*i32,
    zero:*i32,
    hash:*i32
)void {
    positive.*=0;
    negative.*=0;
    zero.*=0;
    hash.*=1511+state_count/17;
    let state:i32=0;
    while(state<state_count){
        let record_start:i32=state*E50_RECORD_N;
        let slot_choice:i32=e51ad_slot_choice(
            control_records,record_start,
            terminal_global_weights,terminal_global_bias,
            terminal_local_weights,terminal_local_bias,
            prototypes,prototype_features
        );
        let direct_choice:i32=e51ad_direct_choice(
            direct_records,record_start,
            candidate_global_weights,candidate_global_bias,
            candidate_local_weights,candidate_local_bias,
            prototypes,prototype_features
        );
        let slot_success:i32=e51ac_choice_success(control_records,record_start,slot_choice);
        let direct_success:i32=e51ac_choice_success(
            direct_records,record_start,e51ad_direct_action_code(direct_choice)
        );
        let target:i32=0;
        if(direct_success==1 && slot_success==0){
            target=E51AD_ROUTER_MARGIN;
            positive.*=positive.*+1;
        }else if(slot_success==1){
            target=-E51AD_ROUTER_MARGIN;
            negative.*=negative.*+1;
        }else{
            zero.*=zero.*+1;
        }
        targets[state]=target;
        hash.*=e46_hash_update(hash.*,target);
        state=state+1;
    }
}

fn e51ad_local_equal(
    weights_a:[]i32,
    bias_a:[]i32,
    weights_b:[]i32,
    bias_b:[]i32
)i32 {
    let i:i32=0;
    while(i<E51AD_CELLS*E45_FEATURES){
        if(weights_a[i]!=weights_b[i]){ return 0; }
        i=i+1;
    }
    i=0;
    while(i<E51AD_CELLS){
        if(bias_a[i]!=bias_b[i]){ return 0; }
        i=i+1;
    }
    return 1;
}

fn e51ad_router_trajectory_metrics(
    control_records:[]i32,
    direct_records:[]i32,
    episode_count:i32,
    last_feasible:[]i32,
    global_weights:[]i32,
    global_bias:i32,
    local_weights:[]i32,
    local_bias:[]i32,
    terminal_global_weights:[]i32,
    terminal_global_bias:i32,
    terminal_local_weights:[]i32,
    terminal_local_bias:[]i32,
    candidate_global_weights:[]i32,
    candidate_global_bias:[]i32,
    candidate_local_weights:[]i32,
    candidate_local_bias:[]i32,
    prototypes:[]i32,
    prototype_features:[]i32,
    reachable:*i32,
    impossible:*i32,
    loss_low:*i32,
    loss_high:*i32
)void {
    reachable.*=0;
    impossible.*=0;
    let total_loss:i64=0;
    let episode:i32=0;
    while(episode<episode_count){
        let episode_success:i32=0;
        let eligible:i32=0;
        let best_loss:i64=9000000000000000000;
        let t:i32=0;
        while(t<=last_feasible[episode]){
            let record_number:i32=episode*(E45_TAPE+1)+t;
            let record_start:i32=record_number*E50_RECORD_N;
            let score:i32=r32e45_clamp(e51p_expert_predict(
                direct_records,record_start,
                global_weights,0,global_bias,
                local_weights,0,local_bias,0,
                prototypes,prototype_features,E51AD_CELLS
            ),-4000,4000);
            let slot_choice:i32=e51ad_slot_choice(
                control_records,record_start,
                terminal_global_weights,terminal_global_bias,
                terminal_local_weights,terminal_local_bias,
                prototypes,prototype_features
            );
            let direct_choice:i32=e51ad_direct_choice(
                direct_records,record_start,
                candidate_global_weights,candidate_global_bias,
                candidate_local_weights,candidate_local_bias,
                prototypes,prototype_features
            );
            let slot_success:i32=e51ac_choice_success(control_records,record_start,slot_choice);
            let direct_success:i32=e51ac_choice_success(
                direct_records,record_start,e51ad_direct_action_code(direct_choice)
            );
            if(score>0){
                if(direct_success==1){ episode_success=1; }
            }else{
                if(slot_success==1){ episode_success=1; }
            }
            if(slot_success==1){
                let residual:i32=-E51AD_ROUTER_MARGIN-score;
                let one_loss:i64=(residual as i64)*(residual as i64);
                if(one_loss<best_loss){ best_loss=one_loss; }
                eligible=1;
            }
            if(direct_success==1){
                let residual:i32=E51AD_ROUTER_MARGIN-score;
                let one_loss:i64=(residual as i64)*(residual as i64);
                if(one_loss<best_loss){ best_loss=one_loss; }
                eligible=1;
            }
            t=t+1;
        }
        if(episode_success==1){ reachable.*=reachable.*+1; }
        if(eligible==0){
            impossible.*=impossible.*+1;
        }else{
            total_loss=total_loss+best_loss;
        }
        episode=episode+1;
    }
    loss_low.*=e50_loss_low(total_loss);
    loss_high.*=e50_loss_high(total_loss);
}

fn e51ad_select_critical_router_records(
    control_records:[]i32,
    direct_records:[]i32,
    episode_count:i32,
    last_feasible:[]i32,
    global_weights:[]i32,
    global_bias:i32,
    local_weights:[]i32,
    local_bias:[]i32,
    terminal_global_weights:[]i32,
    terminal_global_bias:i32,
    terminal_local_weights:[]i32,
    terminal_local_bias:[]i32,
    candidate_global_weights:[]i32,
    candidate_global_bias:[]i32,
    candidate_local_weights:[]i32,
    candidate_local_bias:[]i32,
    prototypes:[]i32,
    prototype_features:[]i32,
    selected_records:[]i32,
    selected_targets:[]i32,
    selected_count:*i32,
    selection_hash:*i32
)void {
    selected_count.*=0;
    selection_hash.*=1601+episode_count;
    let episode:i32=0;
    while(episode<episode_count){
        let found:i32=0;
        let best_loss:i64=9000000000000000000;
        let best_record:i32=0;
        let best_target:i32=-E51AD_ROUTER_MARGIN;
        let t:i32=0;
        while(t<=last_feasible[episode]){
            let record_number:i32=episode*(E45_TAPE+1)+t;
            let record_start:i32=record_number*E50_RECORD_N;
            let score:i32=r32e45_clamp(e51p_expert_predict(
                direct_records,record_start,
                global_weights,0,global_bias,
                local_weights,0,local_bias,0,
                prototypes,prototype_features,E51AD_CELLS
            ),-4000,4000);
            let slot_choice:i32=e51ad_slot_choice(
                control_records,record_start,
                terminal_global_weights,terminal_global_bias,
                terminal_local_weights,terminal_local_bias,
                prototypes,prototype_features
            );
            let direct_choice:i32=e51ad_direct_choice(
                direct_records,record_start,
                candidate_global_weights,candidate_global_bias,
                candidate_local_weights,candidate_local_bias,
                prototypes,prototype_features
            );
            let slot_success:i32=e51ac_choice_success(control_records,record_start,slot_choice);
            let direct_success:i32=e51ac_choice_success(
                direct_records,record_start,e51ad_direct_action_code(direct_choice)
            );
            if(slot_success==1){
                let residual:i32=-E51AD_ROUTER_MARGIN-score;
                let one_loss:i64=(residual as i64)*(residual as i64);
                if(found==0 || one_loss<best_loss){
                    found=1;
                    best_loss=one_loss;
                    best_record=record_number;
                    best_target=-E51AD_ROUTER_MARGIN;
                }
            }
            if(direct_success==1){
                let residual:i32=E51AD_ROUTER_MARGIN-score;
                let one_loss:i64=(residual as i64)*(residual as i64);
                if(found==0 || one_loss<best_loss){
                    found=1;
                    best_loss=one_loss;
                    best_record=record_number;
                    best_target=E51AD_ROUTER_MARGIN;
                }
            }
            t=t+1;
        }
        if(found==1){
            e45_copy_record(
                direct_records,best_record*E50_RECORD_N,
                selected_records,selected_count.* * E50_RECORD_N
            );
            selected_targets[selected_count.*]=best_target;
            selection_hash.*=e46_hash_update(selection_hash.*,episode);
            selection_hash.*=e46_hash_update(selection_hash.*,best_record-episode*(E45_TAPE+1));
            selection_hash.*=e46_hash_update(selection_hash.*,best_target);
            selected_count.*=selected_count.*+1;
        }
        episode=episode+1;
    }
}

fn e51ad_fit_trajectory_router(
    control_records:[]i32,
    direct_records:[]i32,
    episode_count:i32,
    last_feasible:[]i32,
    reverse:i32,
    global_weights:[]i32,
    global_bias:i32,
    initial_local_weights:[]i32,
    initial_local_bias:[]i32,
    terminal_global_weights:[]i32,
    terminal_global_bias:i32,
    terminal_local_weights:[]i32,
    terminal_local_bias:[]i32,
    candidate_global_weights:[]i32,
    candidate_global_bias:[]i32,
    candidate_local_weights:[]i32,
    candidate_local_bias:[]i32,
    prototypes:[]i32,
    prototype_features:[]i32,
    output_local_weights:[]i32,
    output_local_bias:[]i32,
    accepted_rounds:*i32,
    trace_hash:*i32,
    final_reachable:*i32,
    final_impossible:*i32,
    final_loss_low:*i32,
    final_loss_high:*i32,
    final_updates:*i32,
    final_sweeps:*i32,
    final_reason:*i32
)void {
    e51v_copy_expert(
        initial_local_weights,0,initial_local_bias,0,
        output_local_weights,0,output_local_bias,0,E51AD_CELLS
    );
    accepted_rounds.*=0;
    trace_hash.*=1709;
    final_updates.*=0;
    final_sweeps.*=0;
    final_reason.*=0;
    e51ad_router_trajectory_metrics(
        control_records,direct_records,episode_count,last_feasible,
        global_weights,global_bias,output_local_weights,output_local_bias,
        terminal_global_weights,terminal_global_bias,
        terminal_local_weights,terminal_local_bias,
        candidate_global_weights,candidate_global_bias,
        candidate_local_weights,candidate_local_bias,
        prototypes,prototype_features,
        final_reachable,final_impossible,final_loss_low,final_loss_high
    );
    trace_hash.*=e46_hash_update(trace_hash.*,final_reachable.*);
    trace_hash.*=e46_hash_update(trace_hash.*,final_impossible.*);
    trace_hash.*=e46_hash_update(trace_hash.*,final_loss_low.*);
    trace_hash.*=e46_hash_update(trace_hash.*,final_loss_high.*);
    let selected_records:[]i32=zalloc_i(episode_count*E50_RECORD_N);
    let selected_targets:[]i32=zalloc_i(episode_count);
    let candidate_weights:[]i32=zalloc_i(E51AD_CELLS*E45_FEATURES);
    let candidate_bias:[]i32=zalloc_i(E51AD_CELLS);
    let stopped:i32=0;
    let round:i32=0;
    while(round<E51AD_TRAJECTORY_ROUNDS && stopped==0){
        let selected_count:i32=0;
        let selection_hash:i32=0;
        e51ad_select_critical_router_records(
            control_records,direct_records,episode_count,last_feasible,
            global_weights,global_bias,output_local_weights,output_local_bias,
            terminal_global_weights,terminal_global_bias,
            terminal_local_weights,terminal_local_bias,
            candidate_global_weights,candidate_global_bias,
            candidate_local_weights,candidate_local_bias,
            prototypes,prototype_features,
            selected_records,selected_targets,&selected_count,&selection_hash
        );
        let candidate_trace:i32=0;
        let candidate_loss_low:i32=0;
        let candidate_loss_high:i32=0;
        let candidate_updates:i32=0;
        let candidate_sweeps:i32=0;
        let candidate_reason:i32=0;
        e51x_fit_experts_dose(
            selected_records,selected_targets,selected_count,reverse,
            global_weights,0,global_bias,
            candidate_weights,0,candidate_bias,0,
            &candidate_trace,&candidate_loss_low,&candidate_loss_high,
            &candidate_updates,&candidate_sweeps,&candidate_reason,
            E51AD_CELLS,0,384
        );
        let candidate_reachable:i32=0;
        let candidate_impossible:i32=0;
        let candidate_trajectory_low:i32=0;
        let candidate_trajectory_high:i32=0;
        e51ad_router_trajectory_metrics(
            control_records,direct_records,episode_count,last_feasible,
            global_weights,global_bias,candidate_weights,candidate_bias,
            terminal_global_weights,terminal_global_bias,
            terminal_local_weights,terminal_local_bias,
            candidate_global_weights,candidate_global_bias,
            candidate_local_weights,candidate_local_bias,
            prototypes,prototype_features,
            &candidate_reachable,&candidate_impossible,
            &candidate_trajectory_low,&candidate_trajectory_high
        );
        trace_hash.*=e46_hash_update(trace_hash.*,selection_hash);
        trace_hash.*=e46_hash_update(trace_hash.*,selected_count);
        trace_hash.*=e46_hash_update(trace_hash.*,candidate_trace);
        trace_hash.*=e46_hash_update(trace_hash.*,candidate_reachable);
        trace_hash.*=e46_hash_update(trace_hash.*,candidate_impossible);
        trace_hash.*=e46_hash_update(trace_hash.*,candidate_trajectory_low);
        trace_hash.*=e46_hash_update(trace_hash.*,candidate_trajectory_high);
        let accept:i32=0;
        if(candidate_reachable>final_reachable.*){
            accept=1;
        }else if(candidate_reachable==final_reachable.*){
            let candidate_loss:i64=e50_join_loss(candidate_trajectory_low,candidate_trajectory_high);
            let current_loss:i64=e50_join_loss(final_loss_low.*,final_loss_high.*);
            if(candidate_loss<current_loss){ accept=1; }
        }
        trace_hash.*=e46_hash_update(trace_hash.*,accept);
        if(accept==1){
            e51v_copy_expert(
                candidate_weights,0,candidate_bias,0,
                output_local_weights,0,output_local_bias,0,E51AD_CELLS
            );
            final_reachable.*=candidate_reachable;
            final_impossible.*=candidate_impossible;
            final_loss_low.*=candidate_trajectory_low;
            final_loss_high.*=candidate_trajectory_high;
            final_updates.*=candidate_updates;
            final_sweeps.*=candidate_sweeps;
            final_reason.*=candidate_reason;
            accepted_rounds.*=accepted_rounds.*+1;
        }else{
            stopped=1;
        }
        round=round+1;
    }
    zfree(selected_records);
    zfree(selected_targets);
    zfree(candidate_weights);
    zfree(candidate_bias);
}

fn e51ad_eval_partition(
    stage:i32,
    episode_count:i32,
    per_cell:i32,
    active_arm:i32,
    terminal_global_weights:[]i32,
    terminal_global_bias:i32,
    terminal_local_weights:[]i32,
    terminal_local_bias:[]i32,
    candidate_global_weights:[]i32,
    candidate_global_bias:[]i32,
    candidate_local_weights:[]i32,
    candidate_local_bias:[]i32,
    router_global_weights:[]i32,
    router_global_bias:i32,
    router_local_state_weights:[]i32,
    router_local_state_bias:[]i32,
    router_local_trajectory_weights:[]i32,
    router_local_trajectory_bias:[]i32,
    prototypes:[]i32,
    prototype_features:[]i32,
    results:[]i32,
    mode_reach:[]i32,
    resource_reach:[]i32
)i32 {
    e45_zero(results,E51AD_ARMS*E51AD_FIELDS);
    e45_zero(mode_reach,E51AD_ARMS*9);
    e45_zero(resource_reach,E51AD_ARMS*5);
    let control_records:[]i32=zalloc_i(episode_count*(E45_TAPE+1)*E50_RECORD_N);
    let direct_records:[]i32=zalloc_i(episode_count*(E45_TAPE+1)*E50_RECORD_N);
    let failures:i32=e51ab_build_partition(
        stage,episode_count,per_cell,control_records,direct_records,
        terminal_global_weights,terminal_global_bias,
        terminal_local_weights,terminal_local_bias,
        prototypes,prototype_features
    );
    let episode:i32=0;
    while(episode<episode_count){
        let cell:i32=episode/per_cell;
        let mode:i32=cell/5;
        let resource:i32=cell%5;
        let outcome:i32=0;
        if(mode<E51AD_KNOWN_MODE_COUNT){ outcome=1; }
        let resource_state:i32=e51n_domain_state(stage,episode,E51N_DOMAIN_RESOURCE);
        let one_resource:[]i32=zalloc_i(E45_RESOURCE_N);
        let step_losses:[]i32=zalloc_i(E45_TAPE);
        e51n_make_resource(one_resource,0,resource_state,resource);
        e45_build_step_losses(one_resource,0,step_losses,0);
        let remaining:i32=one_resource[0]+one_resource[1];
        let accessible:i32=1;
        let found:[]i32=zalloc_i(E51AD_ARMS);
        let t:i32=0;
        while(t<=E45_TAPE){
            if(t>0){
                let cost:i32=step_losses[t-1];
                if(accessible==1 && cost<=remaining){ remaining=remaining-cost; }
                else{ accessible=0; }
            }
            if(accessible==1){
                let record_number:i32=episode*(E45_TAPE+1)+t;
                let record_start:i32=record_number*E50_RECORD_N;
                let slot_choice:i32=e51ad_slot_choice(
                    control_records,record_start,
                    terminal_global_weights,terminal_global_bias,
                    terminal_local_weights,terminal_local_bias,
                    prototypes,prototype_features
                );
                let direct_choice:i32=e51ad_direct_choice(
                    direct_records,record_start,
                    candidate_global_weights,candidate_global_bias,
                    candidate_local_weights,candidate_local_bias,
                    prototypes,prototype_features
                );
                let direct_action:i32=e51ad_direct_action_code(direct_choice);
                let slot_success:i32=e51ac_choice_success(control_records,record_start,slot_choice);
                let direct_success:i32=e51ac_choice_success(direct_records,record_start,direct_action);
                let arm:i32=0;
                while(arm<E51AD_ARMS){
                    if(active_arm<0 || arm==active_arm){
                        let success:i32=0;
                        let choice:i32=slot_choice;
                        if(arm==E51AD_ARM_SLOT){
                            success=slot_success;
                        }else if(arm==E51AD_ARM_ORACLE_UNION){
                            if(slot_success==1 || direct_success==1){ success=1; }
                        }else{
                            let router_score:i32=e51ad_router_predict(
                                arm,direct_records,record_start,
                                router_global_weights,router_global_bias,
                                router_local_state_weights,router_local_state_bias,
                                router_local_trajectory_weights,router_local_trajectory_bias,
                                prototypes,prototype_features
                            );
                            if(router_score>0){
                                choice=direct_action;
                                success=direct_success;
                            }else{
                                success=slot_success;
                            }
                        }
                        if(success==1){ found[arm]=1; }
                        if(t==0){
                            let base:i32=arm*E51AD_FIELDS;
                            if(success==1){
                                results[base+6]=results[base+6]+1;
                            }else if(arm!=E51AD_ARM_ORACLE_UNION){
                                if(choice==R32E45_TERM_UNKNOWN){
                                    results[base+7]=results[base+7]+1;
                                }else{
                                    results[base+8]=results[base+8]+1;
                                }
                            }
                        }
                    }
                    arm=arm+1;
                }
            }
            t=t+1;
        }
        let arm:i32=0;
        while(arm<E51AD_ARMS){
            if(active_arm<0 || arm==active_arm){
                let base:i32=arm*E51AD_FIELDS;
                results[base+0]=results[base+0]+1;
                if(outcome==1){ results[base+2]=results[base+2]+1; }
                else{ results[base+4]=results[base+4]+1; }
                if(found[arm]==1){
                    results[base+1]=results[base+1]+1;
                    if(outcome==1){ results[base+3]=results[base+3]+1; }
                    else{ results[base+5]=results[base+5]+1; }
                    mode_reach[arm*9+mode]=mode_reach[arm*9+mode]+1;
                    resource_reach[arm*5+resource]=resource_reach[arm*5+resource]+1;
                }
            }
            arm=arm+1;
        }
        zfree(found);
        zfree(one_resource);
        zfree(step_losses);
        episode=episode+1;
    }
    zfree(control_records);
    zfree(direct_records);
    return failures;
}

fn e51ad_print_partition(prefix:string,results:[]i32,mode_reach:[]i32,resource_reach:[]i32)void {
    e45_print_string(prefix);
    e45_print_string("_columns,arm_0_slots_1_global_2_local_state_3_local_trajectory_4_oracle_union,episodes,reachable,known,known_reachable,no_unique,no_unique_reachable,t0_success,t0_unknown,t0_wrong\n");
    let arm:i32=0;
    while(arm<E51AD_ARMS){
        let base:i32=arm*E51AD_FIELDS;
        e45_print_string(prefix); e45_print_string(","); e45_print_i(arm);
        let field:i32=0;
        while(field<E51AD_FIELDS){ e45_print_string(","); e45_print_i(results[base+field]); field=field+1; }
        e45_print_string("\n");
        arm=arm+1;
    }
    e45_print_string(prefix); e45_print_string("_mode_columns,arm,mode,reachable_of_partition_cell\n");
    arm=0;
    while(arm<E51AD_ARMS){
        let mode:i32=0;
        while(mode<9){
            e45_print_string(prefix); e45_print_string("_mode,"); e45_print_i(arm); e45_print_string(","); e45_print_i(mode); e45_print_string(","); e45_print_i(mode_reach[arm*9+mode]); e45_print_string("\n");
            mode=mode+1;
        }
        arm=arm+1;
    }
    e45_print_string(prefix); e45_print_string("_resource_columns,arm,resource,reachable\n");
    arm=0;
    while(arm<E51AD_ARMS){
        let resource:i32=0;
        while(resource<5){
            e45_print_string(prefix); e45_print_string("_resource,"); e45_print_i(arm); e45_print_string(","); e45_print_i(resource); e45_print_string(","); e45_print_i(resource_reach[arm*5+resource]); e45_print_string("\n");
            resource=resource+1;
        }
        arm=arm+1;
    }
}

fn e51ad_direct_model_hash(
    global_weights:[]i32,
    global_bias:[]i32,
    local_weights:[]i32,
    local_bias:[]i32
)i32 {
    let hash:i32=1811;
    let i:i32=0;
    while(i<E51AB_CANDIDATES*E45_FEATURES){ hash=e46_hash_update(hash,global_weights[i]); i=i+1; }
    i=0;
    while(i<E51AB_CANDIDATES){ hash=e46_hash_update(hash,global_bias[i]); i=i+1; }
    i=0;
    while(i<E51AB_CANDIDATES*2*E51AB_CELLS*E45_FEATURES){ hash=e46_hash_update(hash,local_weights[i]); i=i+1; }
    i=0;
    while(i<E51AB_CANDIDATES*2*E51AB_CELLS){ hash=e46_hash_update(hash,local_bias[i]); i=i+1; }
    return hash;
}

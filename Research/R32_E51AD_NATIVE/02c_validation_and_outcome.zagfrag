    let validation_results:[]i32=zalloc_i(E51AD_ARMS*E51AD_FIELDS);
    let validation_mode:[]i32=zalloc_i(E51AD_ARMS*9);
    let validation_resource:[]i32=zalloc_i(E51AD_ARMS*5);
    let validation_failures:i32=e51ad_eval_partition(
        E51AD_STAGE_VALIDATION,E51AD_VALIDATION_EPISODES,E51AD_PER_CELL,-1,
        terminal_global_weights,terminal_global_bias,
        terminal_local_weights,terminal_local_bias,
        candidate_global_weights,candidate_global_bias,
        candidate_local_weights,candidate_local_bias,
        router_global_weights,router_global_bias,
        router_local_state_weights,router_local_state_bias,
        router_local_trajectory_weights,router_local_trajectory_bias,
        prototypes,prototype_features,
        validation_results,validation_mode,validation_resource
    );
    e51ad_print_partition("e51ad_validation",validation_results,validation_mode,validation_resource);
    let terminal_hash_after_validation:i32=e51y_terminal_hash(
        terminal_global_weights,terminal_global_bias,terminal_local_weights,terminal_local_bias
    );
    let direct_hash_after_validation:i32=e51ad_direct_model_hash(
        candidate_global_weights,candidate_global_bias,candidate_local_weights,candidate_local_bias
    );
    let frozen_validation_gate:i32=0;
    if(terminal_hash_after_validation==terminal_hash_before && direct_hash_after_validation==direct_hash_before){ frozen_validation_gate=1; }
    let validation_integrity:i32=0;
    if(training_integrity==1 && validation_failures==0 && frozen_validation_gate==1){ validation_integrity=1; }
    let validation_gate:[]i32=zalloc_i(E51AD_ARMS);
    let arm:i32=E51AD_ARM_GLOBAL;
    while(arm<=E51AD_ARM_LOCAL_TRAJECTORY){
        let base:i32=arm*E51AD_FIELDS;
        if(validation_integrity==1 && validation_results[base+1]==E51AD_VALIDATION_EPISODES && validation_results[base+3]==4200 && validation_results[base+5]==1200){ validation_gate[arm]=1; }
        e45_print_string("e51ad_validation_gate,"); e45_print_i(arm); e45_print_string(","); e45_print_i(validation_gate[arm]); e45_print_string("\n");
        arm=arm+1;
    }
    let winner:i32=-1;
    arm=E51AD_ARM_GLOBAL;
    while(arm<=E51AD_ARM_LOCAL_TRAJECTORY){
        if(winner<0 && validation_gate[arm]==1){ winner=arm; }
        arm=arm+1;
    }
    let oracle_base:i32=E51AD_ARM_ORACLE_UNION*E51AD_FIELDS;
    let slot_base:i32=E51AD_ARM_SLOT*E51AD_FIELDS;
    let oracle_exact:i32=0;
    if(validation_results[oracle_base+1]==E51AD_VALIDATION_EPISODES && validation_results[oracle_base+3]==4200 && validation_results[oracle_base+5]==1200){ oracle_exact=1; }
    e45_print_pair("e51ad_validation_assignment_failures",validation_failures);
    e45_print_pair("e51ad_terminal_hash_after_validation",terminal_hash_after_validation);
    e45_print_pair("e51ad_direct_hash_after_validation",direct_hash_after_validation);
    e45_print_pair("e51ad_frozen_validation_gate",frozen_validation_gate);
    e45_print_pair("e51ad_validation_integrity_gate",validation_integrity);
    e45_print_pair("e51ad_validation_winner_arm",winner);
    e45_print_pair("e51ad_oracle_union_exact_gate",oracle_exact);

    let confirmation_results:[]i32=zalloc_i(E51AD_ARMS*E51AD_FIELDS);
    let confirmation_mode:[]i32=zalloc_i(E51AD_ARMS*9);
    let confirmation_resource:[]i32=zalloc_i(E51AD_ARMS*5);
    let confirmation_failures:i32=0;
    let confirmation_executed:i32=0;
    let confirmation_gate:i32=0;
    if(winner>=0 && validation_integrity==1){
        confirmation_failures=e51ad_eval_partition(
            E51AD_STAGE_CONFIRMATION,E51AD_CONFIRMATION_EPISODES,E51AD_PER_CELL,winner,
            terminal_global_weights,terminal_global_bias,
            terminal_local_weights,terminal_local_bias,
            candidate_global_weights,candidate_global_bias,
            candidate_local_weights,candidate_local_bias,
            router_global_weights,router_global_bias,
            router_local_state_weights,router_local_state_bias,
            router_local_trajectory_weights,router_local_trajectory_bias,
            prototypes,prototype_features,
            confirmation_results,confirmation_mode,confirmation_resource
        );
        confirmation_executed=E51AD_CONFIRMATION_EPISODES;
        e51ad_print_partition("e51ad_confirmation",confirmation_results,confirmation_mode,confirmation_resource);
        let base:i32=winner*E51AD_FIELDS;
        if(confirmation_failures==0 && confirmation_results[base+1]==E51AD_CONFIRMATION_EPISODES && confirmation_results[base+3]==8400 && confirmation_results[base+5]==2400){ confirmation_gate=1; }
    }
    let terminal_hash_after_confirmation:i32=e51y_terminal_hash(
        terminal_global_weights,terminal_global_bias,terminal_local_weights,terminal_local_bias
    );
    let direct_hash_after_confirmation:i32=e51ad_direct_model_hash(
        candidate_global_weights,candidate_global_bias,candidate_local_weights,candidate_local_bias
    );
    let frozen_confirmation_gate:i32=0;
    if(terminal_hash_after_confirmation==terminal_hash_before && direct_hash_after_confirmation==direct_hash_before){ frozen_confirmation_gate=1; }
    if(frozen_confirmation_gate==0){ confirmation_gate=0; }
    e45_print_pair("e51ad_sealed_confirmation_allocated",E51AD_CONFIRMATION_EPISODES);
    e45_print_pair("e51ad_sealed_confirmation_executed",confirmation_executed);
    e45_print_pair("e51ad_confirmation_assignment_failures",confirmation_failures);
    e45_print_pair("e51ad_terminal_hash_after_confirmation",terminal_hash_after_confirmation);
    e45_print_pair("e51ad_direct_hash_after_confirmation",direct_hash_after_confirmation);
    e45_print_pair("e51ad_frozen_confirmation_gate",frozen_confirmation_gate);
    e45_print_pair("e51ad_confirmation_gate",confirmation_gate);

    let best_learned:i32=validation_results[E51AD_ARM_GLOBAL*E51AD_FIELDS+1];
    if(validation_results[E51AD_ARM_LOCAL_STATE*E51AD_FIELDS+1]>best_learned){ best_learned=validation_results[E51AD_ARM_LOCAL_STATE*E51AD_FIELDS+1]; }
    if(validation_results[E51AD_ARM_LOCAL_TRAJECTORY*E51AD_FIELDS+1]>best_learned){ best_learned=validation_results[E51AD_ARM_LOCAL_TRAJECTORY*E51AD_FIELDS+1]; }
    e45_print_string("e51ad_outcome,");
    if(validation_integrity==0){
        e45_print_string("INVALID_E51AD_INTEGRITY_FAILURE\n");
    }else if(winner>=0 && confirmation_gate==1){
        e45_print_string("TRAJECTORY_CRITICAL_HYBRID_ROUTER_CONFIRMED\n");
    }else if(winner>=0){
        e45_print_string("TRAJECTORY_CRITICAL_HYBRID_ROUTER_VALIDATION_ONLY\n");
    }else if(oracle_exact==1){
        e45_print_string("FROZEN_UNION_EXACT_ROUTER_INCOMPLETE\n");
    }else if(best_learned>validation_results[slot_base+1]){
        e45_print_string("TRAJECTORY_CRITICAL_ROUTER_PARTIAL\n");
    }else if(validation_results[oracle_base+1]>validation_results[slot_base+1]){
        e45_print_string("FROZEN_COMPLEMENT_NOT_REALIZED\n");
    }else{
        e45_print_string("NO_FROZEN_COMPLEMENT\n");
    }
    e45_print_string("TNN_R32_E51AD_COMPLETE=1\n");
    e45_print_pair("e51ad_completion_gate",1);

    zfree(candidate_global_weights);
    zfree(candidate_global_bias);
    zfree(candidate_local_weights);
    zfree(candidate_local_bias);
    zfree(router_global_weights);
    zfree(router_local_state_weights);
    zfree(router_local_state_bias);
    zfree(router_local_trajectory_weights);
    zfree(router_local_trajectory_bias);
    zfree(validation_results);
    zfree(validation_mode);
    zfree(validation_resource);
    zfree(validation_gate);
    zfree(confirmation_results);
    zfree(confirmation_mode);
    zfree(confirmation_resource);
    return 1;
}

// TNN R32 E53A — learner-owned meta-control pressure test.
//
// This bounded diagnostic transfers selection of generic policy-update geometry
// from a caller schedule into learner-valued state. The candidate vocabulary is
// still protected/researcher supplied. The selector itself receives only an
// endogenous discrepancy context; evaluator family identity never enters it.

const E53A_ACTIONS:i32=6;
const E53A_CONTEXTS:i32=3;
const E53A_DEV_PER_FAMILY:i32=240;
const E53A_VALIDATION_ROUNDS:i32=2;
const E53A_VALIDATION_BLOCKS:i32=6;
const E53A_VALIDATION_PER_BLOCK:i32=40;
const E53A_UNKNOWN_VALUE:i32=0;

fn e53a_abs(v:i32)i32 {
    if(v<0){ return 0-v; }
    return v;
}

fn e53a_mod(v:i32,m:i32)i32 {
    let q:i32=v/m;
    let r:i32=v-q*m;
    if(r<0){ return r+m; }
    return r;
}

fn e53a_clamp(v:i32,lo:i32,hi:i32)i32 {
    if(v<lo){ return lo; }
    if(v>hi){ return hi; }
    return v;
}

fn e53a_rate(action:i32)i32 {
    if(action==0){ return 100; }
    if(action==1){ return 200; }
    if(action==2){ return 350; }
    if(action==3){ return 550; }
    if(action==4){ return 750; }
    return 1000;
}

fn e53a_replay_mass(action:i32)i32 {
    if(action==0){ return 7; }
    if(action==1){ return 5; }
    if(action==2){ return 3; }
    if(action==3){ return 2; }
    if(action==4){ return 1; }
    return 0;
}

fn e53a_residual_clip(action:i32)i32 {
    if(action==0){ return 100; }
    if(action==1){ return 180; }
    if(action==2){ return 300; }
    if(action==3){ return 500; }
    if(action==4){ return 800; }
    return 1400;
}

// Generic learner-visible meta-state. It contains no evaluator family/regime.
fn e53a_context(policy_value:i32,replay_anchor:i32)i32 {
    let discrepancy:i32=e53a_abs(policy_value-replay_anchor);
    if(discrepancy<180){ return 0; }
    if(discrepancy<330){ return 1; }
    return 2;
}

fn e53a_choose(qvalues:[]i32,context:i32)i32 {
    let best_action:i32=0;
    let best_value:i32=qvalues[context*E53A_ACTIONS];
    let action:i32=1;
    while(action<E53A_ACTIONS){
        let value:i32=qvalues[context*E53A_ACTIONS+action];
        if(value>best_value){
            best_value=value;
            best_action=action;
        }
        action=action+1;
    }
    return best_action;
}

// Delayed grounded objective: useful error reduction earns value; internal
// parameter churn is charged. Evaluator family identity is not an argument.
fn e53a_objective(
    policy_value:i32,
    replay_anchor:i32,
    grounded_target:i32,
    learner_observation:i32,
    action:i32
)i32 {
    let replay_mass:i32=e53a_replay_mass(action);
    let mixed_target:i32=learner_observation;
    if(replay_mass>0){
        mixed_target=(learner_observation+replay_anchor*replay_mass)/(1+replay_mass);
    }
    let residual:i32=e53a_clamp(
        mixed_target-policy_value,
        0-e53a_residual_clip(action),
        e53a_residual_clip(action)
    );
    let next_value:i32=policy_value+residual*e53a_rate(action)/1000;
    let before_error:i32=e53a_abs(policy_value-grounded_target);
    let after_error:i32=e53a_abs(next_value-grounded_target);
    let improvement:i32=before_error-after_error;
    let churn:i32=e53a_abs(next_value-policy_value);
    return 3*improvement-churn;
}

fn e53a_train_policy_offset(k:i32)i32 {
    let m:i32=e53a_mod(k,7);
    if(m==0){ return -90; }
    if(m==1){ return -45; }
    if(m==2){ return 0; }
    if(m==3){ return 45; }
    if(m==4){ return 90; }
    if(m==5){ return 30; }
    return -30;
}

fn e53a_train_low_noise(k:i32)i32 {
    let m:i32=e53a_mod(k,6);
    if(m==0){ return -760; }
    if(m==1){ return 680; }
    if(m==2){ return -520; }
    if(m==3){ return 460; }
    if(m==4){ return -340; }
    return 280;
}

fn e53a_train_low_replay(k:i32)i32 {
    let m:i32=e53a_mod(k,4);
    if(m==0){ return -70; }
    if(m==1){ return -30; }
    if(m==2){ return 10; }
    return 50;
}

fn e53a_train_medium_gap(k:i32)i32 {
    let m:i32=e53a_mod(k,4);
    if(m==0){ return -620; }
    if(m==1){ return -420; }
    if(m==2){ return 420; }
    return 620;
}

fn e53a_train_medium_noise(k:i32)i32 {
    let m:i32=e53a_mod(k,4);
    if(m==0){ return -280; }
    if(m==1){ return 220; }
    if(m==2){ return -170; }
    return 130;
}

fn e53a_train_high_gap(k:i32)i32 {
    let m:i32=e53a_mod(k,4);
    if(m==0){ return -1700; }
    if(m==1){ return -1300; }
    if(m==2){ return 1300; }
    return 1700;
}

fn e53a_train_high_noise(k:i32)i32 {
    let m:i32=e53a_mod(k,4);
    if(m==0){ return -120; }
    if(m==1){ return 80; }
    if(m==2){ return -60; }
    return 40;
}

fn e53a_validation_policy_offset(k:i32)i32 {
    let m:i32=e53a_mod(k,5);
    if(m==0){ return -100; }
    if(m==1){ return -50; }
    if(m==2){ return 0; }
    if(m==3){ return 50; }
    return 100;
}

fn e53a_validation_low_noise(k:i32)i32 {
    let m:i32=e53a_mod(k,6);
    if(m==0){ return -800; }
    if(m==1){ return 720; }
    if(m==2){ return -560; }
    if(m==3){ return 480; }
    if(m==4){ return -360; }
    return 300;
}

fn e53a_validation_replay_offset(k:i32)i32 {
    let m:i32=e53a_mod(k,5);
    if(m==0){ return -80; }
    if(m==1){ return -40; }
    if(m==2){ return 0; }
    if(m==3){ return 40; }
    return 80;
}

fn e53a_validation_medium_gap(k:i32)i32 {
    let m:i32=e53a_mod(k,4);
    if(m==0){ return -650; }
    if(m==1){ return -450; }
    if(m==2){ return 450; }
    return 650;
}

fn e53a_validation_medium_noise(k:i32)i32 {
    let m:i32=e53a_mod(k,4);
    if(m==0){ return -300; }
    if(m==1){ return 240; }
    if(m==2){ return -180; }
    return 140;
}

fn e53a_validation_high_gap(k:i32)i32 {
    let m:i32=e53a_mod(k,4);
    if(m==0){ return -1800; }
    if(m==1){ return -1400; }
    if(m==2){ return 1400; }
    return 1800;
}

fn e53a_validation_high_noise(k:i32)i32 {
    let m:i32=e53a_mod(k,4);
    if(m==0){ return -130; }
    if(m==1){ return 90; }
    if(m==2){ return -70; }
    return 50;
}

// Evaluator-side generator. `family` is deliberately confined here and never
// passed to e53a_context or e53a_choose.
fn e53a_make_case(
    family:i32,
    k:i32,
    validation:i32,
    policy_value:*i32,
    replay_anchor:*i32,
    grounded_target:*i32,
    learner_observation:*i32
)void {
    if(validation==0){
        if(family==0){
            grounded_target.*=(e53a_mod(k,7)-3)*40;
            policy_value.*=grounded_target.*+e53a_train_policy_offset(k);
            learner_observation.*=grounded_target.*+e53a_train_low_noise(k);
            replay_anchor.*=grounded_target.*+e53a_train_low_replay(k);
            return;
        }
        if(family==1){
            grounded_target.*=-700;
            if(e53a_mod(k,2)==0){ grounded_target.*=900; }
            let gap:i32=e53a_train_medium_gap(k);
            policy_value.*=grounded_target.*+gap;
            learner_observation.*=grounded_target.*+e53a_train_medium_noise(k);
            replay_anchor.*=grounded_target.*+gap/2;
            return;
        }
        grounded_target.*=-1300;
        if(e53a_mod(k,2)==0){ grounded_target.*=1500; }
        let gap:i32=e53a_train_high_gap(k);
        policy_value.*=grounded_target.*+gap;
        learner_observation.*=grounded_target.*+e53a_train_high_noise(k);
        replay_anchor.*=grounded_target.*+gap/2;
        return;
    }

    if(family==0){
        grounded_target.*=(e53a_mod(k,9)-4)*35;
        policy_value.*=grounded_target.*+e53a_validation_policy_offset(k);
        learner_observation.*=grounded_target.*+e53a_validation_low_noise(k);
        replay_anchor.*=grounded_target.*+e53a_validation_replay_offset(k);
        return;
    }
    if(family==1){
        grounded_target.*=-750;
        if(e53a_mod(k,2)==0){ grounded_target.*=950; }
        let gap:i32=e53a_validation_medium_gap(k);
        policy_value.*=grounded_target.*+gap;
        learner_observation.*=grounded_target.*+e53a_validation_medium_noise(k);
        replay_anchor.*=grounded_target.*+gap/2;
        return;
    }
    grounded_target.*=-1400;
    if(e53a_mod(k,2)==0){ grounded_target.*=1600; }
    let gap:i32=e53a_validation_high_gap(k);
    policy_value.*=grounded_target.*+gap;
    learner_observation.*=grounded_target.*+e53a_validation_high_noise(k);
    replay_anchor.*=grounded_target.*+gap/2;
}

fn e53a_validation_family(block:i32)i32 {
    if(block==0){ return 0; }
    if(block==1){ return 1; }
    if(block==2){ return 2; }
    if(block==3){ return 2; }
    if(block==4){ return 1; }
    return 0;
}

fn e53a_print(label:[]u8,value:i32)void {
    _zag_print(label);
    _zag_print(",");
    _zag_println(_zag_i64_to_str(value as i64));
}

fn main()i32 {
    let value_sum:[]i32=zalloc_i(E53A_CONTEXTS*E53A_ACTIONS);
    let value_count:[]i32=zalloc_i(E53A_CONTEXTS*E53A_ACTIONS);
    let qvalues:[]i32=zalloc_i(E53A_CONTEXTS*E53A_ACTIONS);
    let selected:[]i32=zalloc_i(E53A_CONTEXTS);
    let fixed_total:[]i32=zalloc_i(E53A_ACTIONS);
    let chosen_count:[]i32=zalloc_i(E53A_ACTIONS);
    let validation_context_count:[]i32=zalloc_i(E53A_CONTEXTS);

    let i:i32=0;
    while(i<E53A_CONTEXTS*E53A_ACTIONS){
        value_sum[i]=0;
        value_count[i]=0;
        qvalues[i]=0;
        i=i+1;
    }
    i=0;
    while(i<E53A_ACTIONS){ fixed_total[i]=0; chosen_count[i]=0; i=i+1; }
    i=0;
    while(i<E53A_CONTEXTS){ validation_context_count[i]=0; i=i+1; }

    // Balanced development exploration. The evaluator family creates experience
    // but is not given to the learner selector; context is recomputed from the
    // learner-visible policy/replay discrepancy.
    let family:i32=0;
    while(family<3){
        let k:i32=0;
        while(k<E53A_DEV_PER_FAMILY){
            let policy_value:i32=0;
            let replay_anchor:i32=0;
            let grounded_target:i32=0;
            let learner_observation:i32=0;
            e53a_make_case(
                family,k,0,
                &policy_value,&replay_anchor,&grounded_target,&learner_observation
            );
            let context:i32=e53a_context(policy_value,replay_anchor);
            let action:i32=e53a_mod(k,E53A_ACTIONS);
            let objective:i32=e53a_objective(
                policy_value,replay_anchor,grounded_target,learner_observation,action
            );
            let index:i32=context*E53A_ACTIONS+action;
            value_sum[index]=value_sum[index]+objective;
            value_count[index]=value_count[index]+1;
            k=k+1;
        }
        family=family+1;
    }

    let balanced_dev_gate:i32=1;
    let context:i32=0;
    while(context<E53A_CONTEXTS){
        let action:i32=0;
        while(action<E53A_ACTIONS){
            let index:i32=context*E53A_ACTIONS+action;
            if(value_count[index]!=40){ balanced_dev_gate=0; }
            if(value_count[index]>0){
                qvalues[index]=value_sum[index]/value_count[index];
            }
            _zag_print("meta_value,");
            _zag_print(_zag_i64_to_str(context as i64));
            _zag_print(",");
            _zag_print(_zag_i64_to_str(action as i64));
            _zag_print(",");
            _zag_print(_zag_i64_to_str(value_count[index] as i64));
            _zag_print(",");
            _zag_println(_zag_i64_to_str(qvalues[index] as i64));
            action=action+1;
        }
        selected[context]=e53a_choose(qvalues,context);
        _zag_print("meta_selected,");
        _zag_print(_zag_i64_to_str(context as i64));
        _zag_print(",");
        _zag_print(_zag_i64_to_str(selected[context] as i64));
        _zag_print(",");
        _zag_print(_zag_i64_to_str(e53a_rate(selected[context]) as i64));
        _zag_print(",");
        _zag_print(_zag_i64_to_str(e53a_replay_mass(selected[context]) as i64));
        _zag_print(",");
        _zag_println(_zag_i64_to_str(e53a_residual_clip(selected[context]) as i64));
        context=context+1;
    }

    let distinct_actions:i32=1;
    if(selected[1]!=selected[0]){ distinct_actions=distinct_actions+1; }
    if(selected[2]!=selected[0] && selected[2]!=selected[1]){ distinct_actions=distinct_actions+1; }

    let adaptive_total:i32=0;
    let switch_count:i32=0;
    let previous_action:i32=-1;
    let round:i32=0;
    while(round<E53A_VALIDATION_ROUNDS){
        let block:i32=0;
        while(block<E53A_VALIDATION_BLOCKS){
            let validation_family:i32=e53a_validation_family(block);
            let sample:i32=0;
            while(sample<E53A_VALIDATION_PER_BLOCK){
                let k:i32=1000+round*137+validation_family*71+sample;
                let policy_value:i32=0;
                let replay_anchor:i32=0;
                let grounded_target:i32=0;
                let learner_observation:i32=0;
                e53a_make_case(
                    validation_family,k,1,
                    &policy_value,&replay_anchor,&grounded_target,&learner_observation
                );
                let learner_context:i32=e53a_context(policy_value,replay_anchor);
                validation_context_count[learner_context]=validation_context_count[learner_context]+1;
                let adaptive_action:i32=e53a_choose(qvalues,learner_context);
                adaptive_total=adaptive_total+e53a_objective(
                    policy_value,replay_anchor,grounded_target,learner_observation,adaptive_action
                );
                chosen_count[adaptive_action]=chosen_count[adaptive_action]+1;
                if(previous_action>=0 && adaptive_action!=previous_action){
                    switch_count=switch_count+1;
                }
                previous_action=adaptive_action;

                let fixed_action:i32=0;
                while(fixed_action<E53A_ACTIONS){
                    fixed_total[fixed_action]=fixed_total[fixed_action]+e53a_objective(
                        policy_value,replay_anchor,grounded_target,learner_observation,fixed_action
                    );
                    fixed_action=fixed_action+1;
                }
                sample=sample+1;
            }
            block=block+1;
        }
        round=round+1;
    }

    let best_fixed:i32=fixed_total[0];
    i=1;
    while(i<E53A_ACTIONS){
        if(fixed_total[i]>best_fixed){ best_fixed=fixed_total[i]; }
        i=i+1;
    }

    let adaptive_diversity:i32=0;
    i=0;
    while(i<E53A_ACTIONS){
        if(chosen_count[i]>0){ adaptive_diversity=adaptive_diversity+1; }
        _zag_print("fixed_validation_objective,");
        _zag_print(_zag_i64_to_str(i as i64));
        _zag_print(",");
        _zag_println(_zag_i64_to_str(fixed_total[i] as i64));
        _zag_print("adaptive_action_count,");
        _zag_print(_zag_i64_to_str(i as i64));
        _zag_print(",");
        _zag_println(_zag_i64_to_str(chosen_count[i] as i64));
        i=i+1;
    }
    i=0;
    while(i<E53A_CONTEXTS){
        _zag_print("validation_context_count,");
        _zag_print(_zag_i64_to_str(i as i64));
        _zag_print(",");
        _zag_println(_zag_i64_to_str(validation_context_count[i] as i64));
        i=i+1;
    }

    let adaptive_superiority_gate:i32=0;
    if(adaptive_total>best_fixed){ adaptive_superiority_gate=1; }
    let selection_gate:i32=0;
    if(distinct_actions>=3 && adaptive_diversity>=3 && switch_count>0){ selection_gate=1; }
    let validation_balance_gate:i32=0;
    if(validation_context_count[0]==160 && validation_context_count[1]==160 && validation_context_count[2]==160){
        validation_balance_gate=1;
    }
    let unknown_zero_gate:i32=0;
    if(E53A_UNKNOWN_VALUE==0){ unknown_zero_gate=1; }

    e53a_print("balanced_development_gate",balanced_dev_gate);
    e53a_print("selected_distinct_meta_actions",distinct_actions);
    e53a_print("adaptive_action_diversity",adaptive_diversity);
    e53a_print("adaptive_action_switches",switch_count);
    e53a_print("adaptive_validation_objective",adaptive_total);
    e53a_print("best_fixed_validation_objective",best_fixed);
    e53a_print("adaptive_superiority_gate",adaptive_superiority_gate);
    e53a_print("validation_context_balance_gate",validation_balance_gate);
    e53a_print("unknown_value_zero_gate",unknown_zero_gate);
    e53a_print("evaluator_family_inside_selector",0);
    e53a_print("graph_substrate_required",0);
    e53a_print("candidate_vocabulary_still_protected",1);

    let final_gate:i32=0;
    if(balanced_dev_gate+adaptive_superiority_gate+selection_gate+validation_balance_gate+unknown_zero_gate==5){
        final_gate=1;
    }

    zfree(value_sum);
    zfree(value_count);
    zfree(qvalues);
    zfree(selected);
    zfree(fixed_total);
    zfree(chosen_count);
    zfree(validation_context_count);

    if(final_gate==1){
        _zag_println("TNN_R32_E53A_META_CONTROL_OWNERSHIP_GATE=PASS");
        return 0;
    }
    _zag_println("TNN_R32_E53A_META_CONTROL_OWNERSHIP_GATE=FAIL");
    return 1;
}

// N03A: explicit V2 corrective regression. Known N03 fixtures are not fresh science.
@import("R33_NATIVE_JOURNAL_V2.zag")
@import("R33_NATIVE_PROCESS_V3.zag")
@import("R33_NATIVE_N03A_BOUNDARIES.zag")

const N03_ROOT:[]u8="Research/R33_NATIVE_N03A_RUN_PRIMARY_V1";

fn n03_initial()[]u8 {
    let b:[]u8=nio_alloc(16);if(b.len!=16){return b;}
    nj_put32(b,0,41);nj_put32(b,4,12);nj_put32(b,8,90);nj_put32(b,12,7);return b;
}
fn n03_next(value:i32)[]u8 {let b:[]u8=n03_initial();if(b.len==16){nj_put32(b,0,value);}return b;}
fn n03_directory(name:[]u8)[]u8 {
    let base:[]u8=_zag_str_concat(N03_ROOT,"/");let dir:[]u8=_zag_str_concat(base,name);nio_free(base);return dir;
}
fn n03_check(name:[]u8,actual:i64,expected:i64,fail:*i32)void {
    fail.*=fail.*+nio_metric(name,actual,expected);
}
fn n03_state(j:*NativeJournal,sequence:i32,attempts:i32,value:i32,fail:*i32)void {
    n03_check("recovery_status",j.*.status,0,fail);
    if(j.*.status!=0){return;}
    n03_check("sequence",j.*.sequence,sequence,fail);n03_check("attempts",j.*.attempts,attempts,fail);
    let expected:[]u8=n03_next(value);
    n03_check("complete_state_bytes",nio_equal(j.*.state,expected),1,fail);nio_free(expected);
    n03_check("head_size",j.*.head.len,32,fail);
}
fn n03_finish(name:[]u8,fail:i32)i32 {
    _zag_print("FAILURES,");_zag_println(_zag_i64_to_str(fail as i64));
    if(fail!=0){return 1;}_zag_print("N03_CHILD_PASS,");_zag_println(name);return 0;
}
fn n03_child_guard()i32 {
    // 128KiB permits a 65536-byte payload plus the complete record header.
    // This is a regular-file ceiling, not merely an output-log ceiling.
    if(nio_limit(0,15)!=0 || nio_limit(1,131072)!=0 || nio_limit(4,0)!=0 ||
       nio_limit(8,64)!=0 || nio_deadline(15)!=0){return -1;}return 0;
}
fn n03_basic(reload:i32)i32 {
    let name:[]u8="basic";let initial:[]u8=n03_initial();let dir:[]u8=n03_directory(name);let fail:i32=0;
    if(reload==0){n03_check("initialize",nj_init(dir,initial),0,&fail);}
    let j:NativeJournal=nj_recover(dir,initial);
    if(reload==1){n03_state(&j,3,3,41,&fail);nj_close(&j);nio_free(initial);nio_free(dir);return n03_finish("basic-reload",fail);}
    n03_state(&j,0,0,41,&fail);if(j.status!=0){nj_close(&j);return 1;}
    let blocked:NativeJournal=nj_recover(dir,initial);
    n03_check("second_writer_refused",blocked.status,-8009,&fail);nj_close(&blocked);
    let next:[]u8=n03_next(52);
    n03_check("first_commit",nj_commit(&j,101,0,next,1,0),0,&fail);
    n03_state(&j,1,1,52,&fail);
    n03_check("idempotent",nj_commit(&j,101,0,next,1,0),1,&fail);
    n03_check("no_duplicate_attempt",j.attempts,1,&fail);
    nj_put32(next,0,63);
    n03_check("caller_detached",nj_get32(j.state,0),52,&fail);
    n03_check("conflicting_transaction",nj_commit(&j,101,0,next,1,0),-8007,&fail);
    n03_check("stale_parent",nj_commit(&j,102,0,next,1,0),-8006,&fail);
    n03_state(&j,1,1,52,&fail);
    n03_check("second_commit",nj_commit(&j,102,1,next,1,0),0,&fail);
    n03_check("kind2_initial_bytes_append_not_authorized_rollback",nj_commit(&j,103,2,initial,2,0),0,&fail);
    n03_state(&j,3,3,41,&fail);
    let retained:i64=nj_open_index(j.root,"event-",1,0);
    n03_check("earliest_history_retained",(retained>=0) as i64,1,&fail);if(retained>=0){nio_close(retained);}
    nj_close(&j);nio_free(initial);nio_free(next);nio_free(dir);return n03_finish(name,fail);
}
fn n03_crash(phase:i32,action:i32)i32 {
    let suffix:[]u8=_zag_i64_to_str(phase as i64);let name:[]u8=_zag_str_concat("crash",suffix);
    let initial:[]u8=n03_initial();let next:[]u8=n03_next(52);let dir:[]u8=n03_directory(name);let fail:i32=0;
    if(action==0){
        n03_check("initialize",nj_init(dir,initial),0,&fail);
        let j:NativeJournal=nj_recover(dir,initial);n03_state(&j,0,0,41,&fail);
        if(fail!=0){nj_close(&j);return 1;}
        let rc:i32=nj_commit(&j,201,0,next,1,phase);
        _zag_print("UNEXPECTED_CRASH_RETURN,");_zag_println(_zag_i64_to_str(rc as i64));return 1;
    }
    let j:NativeJournal=nj_recover(dir,initial);
    if(action==1){
        if(phase<=3){n03_state(&j,0,1,41,&fail);}else{n03_state(&j,1,1,52,&fail);}
        if(j.status==0){
            let size:i32=176;if(phase==1){size=0;}if(phase==2){size=88;}
            n03_attempt_bytes(j.root,201,size,&fail);
            if(phase<=3){n03_check("retry_original_transaction_after_unpublished",nj_commit(&j,201,0,next,1,0),0,&fail);}
            else{n03_check("duplicate_after_publish",nj_commit(&j,201,0,next,1,0),1,&fail);}
            n03_check("original_transaction_idempotent",nj_commit(&j,201,0,next,1,0),1,&fail);
        }
    }else{
        let attempts:i32=1;if(phase<=3){attempts=2;}n03_state(&j,1,attempts,52,&fail);
        if(j.status==0){let fd:i64=nj_open_index(j.root,"attempt-",1,0);
            n03_check("failed_attempt_retained",(fd>=0) as i64,1,&fail);if(fd>=0){nio_close(fd);}
        }
    }
    nj_close(&j);nio_free(initial);nio_free(next);nio_free(dir);nio_free(suffix);nio_free(name);
    return n03_finish("crash-recovery",fail);
}
fn n03_write_failure(reload:i32)i32 {
    let initial:[]u8=n03_initial();let next:[]u8=n03_next(52);let dir:[]u8=n03_directory("write-failure");let fail:i32=0;
    if(reload==0){n03_check("initialize",nj_init(dir,initial),0,&fail);}
    let j:NativeJournal=nj_recover(dir,initial);
    if(reload==1){n03_state(&j,1,2,52,&fail);}else{
        n03_state(&j,0,0,41,&fail);
        n03_check("checked_partial_abandonment",nj_commit(&j,301,0,next,1,6),-8011,&fail);
        n03_check("handle_poisoned",j.status,-8008,&fail);
        n03_attempt_bytes(j.root,301,88,&fail);
        n03_check("blocked_until_recovery",nj_commit(&j,302,0,next,1,0),-8008,&fail);
        n03_check("live_state_not_committed",nj_get32(j.state,0),41,&fail);
        nj_close(&j);j=nj_recover(dir,initial);n03_state(&j,0,1,41,&fail);
        n03_check("fresh_handle_original_transaction_retry",nj_commit(&j,301,0,next,1,0),0,&fail);n03_state(&j,1,2,52,&fail);
        n03_check("original_retry_idempotent",nj_commit(&j,301,0,next,1,0),1,&fail);
    }
    nj_close(&j);nio_free(initial);nio_free(next);nio_free(dir);return n03_finish("write-failure",fail);
}
fn n03_capacity(attempt_limit:i32)i32 {
    let name:[]u8="event-capacity";if(attempt_limit==1){name="attempt-capacity";}
    let initial:[]u8=n03_initial();let next:[]u8=n03_next(52);let dir:[]u8=n03_directory(name);let fail:i32=0;
    n03_check("initialize",nj_init(dir,initial),0,&fail);let j:NativeJournal=nj_recover(dir,initial);
    let i:i32=0;let cap:i32=32;if(attempt_limit==1){cap=64;}
    while(i<cap && fail==0){
        if(attempt_limit==1){
            n03_check("reserve_checked_partial_attempt",nj_commit(&j,401+i,0,next,1,6),-8011,&fail);
            nj_close(&j);j=nj_recover(dir,initial);n03_state(&j,0,i+1,41,&fail);
        }else{
            nj_put32(next,0,52+i);n03_check("fill_record",nj_commit(&j,401+i,i,next,1,0),0,&fail);
        }i=i+1;
    }
    let parent:i32=32;if(attempt_limit==1){parent=0;}
    n03_check("capacity_refusal",nj_commit(&j,999,parent,next,1,0),-8005,&fail);
    if(attempt_limit==1){n03_state(&j,0,64,41,&fail);}else{n03_state(&j,32,32,83,&fail);}
    let beyond:i64=nj_open_index(j.root,"attempt-",cap+1,0);
    n03_check("no_extra_attempt",beyond,-2,&fail);if(beyond>=0){nio_close(beyond);}
    nj_close(&j);nio_free(initial);nio_free(next);nio_free(dir);return n03_finish(name,fail);
}
// Deliberate evaluator intervention on fixture files only. Never exported by
// the journal capability. No original accepted file is a possible target.
fn n03_overwrite(root:i64,name:[]u8,record:[]u8)i32 {
    return nb_replace_retaining_preimage(root,name,record);
}
fn n03_corruption(kind:i32)i32 {
    let num:[]u8=_zag_i64_to_str(kind as i64);let name:[]u8=_zag_str_concat("corrupt",num);
    let initial:[]u8=n03_initial();let next:[]u8=n03_next(52);let dir:[]u8=n03_directory(name);let fail:i32=0;
    n03_check("initialize",nj_init(dir,initial),0,&fail);let j:NativeJournal=nj_recover(dir,initial);
    n03_check("baseline_commit",nj_commit(&j,501,0,next,1,0),0,&fail);
    let record:[]u8=nio_alloc(176);let fd:i64=nj_open_index(j.root,"event-",1,0);
    n03_check("read_baseline",nio_read_exact(fd,record,176),176,&fail);nio_close(fd);
    let expected:i32=-8003;
    if(kind==1){record[160]=record[160]^1;}
    if(kind==2){record[32]=record[32]^1;n03_check("reseal",nj_record_digest(record,record[128..160]),0,&fail);expected=-8004;}
    if(kind==3){record[64]=record[64]^1;n03_check("reseal",nj_record_digest(record,record[128..160]),0,&fail);expected=-8004;}
    if(kind==4){nj_put32(record,8,2);n03_check("reseal",nj_record_digest(record,record[128..160]),0,&fail);expected=-8004;}
    n03_check("mutate_fixture_record",n03_overwrite(j.root,"event-1.bin",record),0,&fail);
    nj_close(&j);j=nj_recover(dir,initial);n03_check("corruption_rejected",j.status,expected,&fail);
    n03_check("failed_recovery_exposes_no_state",j.state.len,0,&fail);nj_close(&j);
    nio_free(initial);nio_free(next);nio_free(record);nio_free(dir);nio_free(name);nio_free(num);
    return n03_finish("corruption",fail);
}
fn n03_parent_case(root:i64,mode:[]u8,label:[]u8,expected_exit:i32,fail:*i32)void {
    let run:NativeRunV3=nrv3_run(root,_zag_arg(0),mode,label,15000,131072);
    n03_check("child_supervisor_status",run.status,0,fail);
    n03_check("child_started",run.started,1,fail);n03_check("child_reaped",run.reaped,1,fail);
    n03_check("child_exit",run.exit_code,expected_exit,fail);n03_check("child_signal",run.signal,0,fail);
    n03_check("child_stderr",run.stderr_bytes,0,fail);
    n03_check("child_rss_within_bound",((run.peak_rss>0)&&(run.peak_rss<=268435456)) as i64,1,fail);
    n03_check("child_output_present",((run.stdout_bytes>0)&&(run.stdout_bytes<=131072)) as i64,1,fail);
    n03_check("child_timer_registered",run.timer_registered,1,fail);
    let name:[]u8=_zag_str_concat(label,".stdout");let fd:i64=nio_open_child(root,name,0);
    let log:[]u8=nio_alloc(131072);let got:i64=nio_read_exact(fd,log,131072);
    n03_check("child_log_read_exact",(got>0 && got==run.stdout_bytes) as i64,1,fail);
    let found:i32=0;
    if(got>0 && got<=log.len){
        let marker:[]u8="FAILURES,0\nN03_CHILD_PASS,";
        if(expected_exit==73){marker="N03_CRASH_BOUNDARY,";}
        found=nb_contains(log[0..got as i32],marker);
    }
    n03_check("child_terminal_evidence",found,1,fail);
    if(fd>=0){nio_close(fd);}nio_free(name);nio_free(log);
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"supervise")==1){
        if(nio_guard(180)!=0){return 3;}
        let admitted:NativeAdmissionV3=nrv3_admit_root(N03_ROOT);if(admitted.status!=0){return 4;}
        let root:i64=admitted.root;let fail:i32=0;
        n03_parent_case(root,"basic","basic",0,&fail);
        n03_parent_case(root,"basic-reload","basic-reload",0,&fail);
        let i:i32=1;
        while(i<=5 && fail==0){
            let suffix:[]u8=_zag_i64_to_str(i as i64);
            let crash:[]u8=_zag_str_concat("crash",suffix);let recover:[]u8=_zag_str_concat("recover",suffix);
            let verify:[]u8=_zag_str_concat("verify",suffix);
            n03_parent_case(root,crash,crash,73,&fail);
            n03_parent_case(root,recover,recover,0,&fail);n03_parent_case(root,verify,verify,0,&fail);
            nio_free(suffix);nio_free(crash);nio_free(recover);nio_free(verify);i=i+1;
        }
        if(fail==0){
            n03_parent_case(root,"write-failure","write-failure",0,&fail);
            n03_parent_case(root,"failure-reload","failure-reload",0,&fail);
            n03_parent_case(root,"event-capacity","event-capacity",0,&fail);
            n03_parent_case(root,"attempt-capacity","attempt-capacity",0,&fail);
            i=1;while(i<=4 && fail==0){
                let suffix:[]u8=_zag_i64_to_str(i as i64);let c:[]u8=_zag_str_concat("corrupt",suffix);
                n03_parent_case(root,c,c,0,&fail);nio_free(c);nio_free(suffix);i=i+1;
            }
        }
        i=1;while(i<=34 && fail==0){
            let number:[]u8=_zag_i64_to_str(i as i64);let mode:[]u8=_zag_str_concat("boundary",number);
            n03_parent_case(root,mode,mode,0,&fail);nio_free(number);nio_free(mode);i=i+1;
        }
        if(fail==0){n03_parent_case(root,"max-reload","max-reload",0,&fail);}
        n03_check("parent_root_close",nio_close(root),0,&fail);
        _zag_print("FAILURES,");_zag_println(_zag_i64_to_str(fail as i64));
        if(fail!=0){return 1;}_zag_println("N03A_NATIVE_JOURNAL_V2_PASS,60");return 0;
    }
    if(n03_child_guard()!=0){return 3;}
    if(_zag_strcmp(mode,"basic")==1){return n03_basic(0);}
    if(_zag_strcmp(mode,"basic-reload")==1){return n03_basic(1);}
    if(_zag_strcmp(mode,"write-failure")==1){return n03_write_failure(0);}
    if(_zag_strcmp(mode,"failure-reload")==1){return n03_write_failure(1);}
    if(_zag_strcmp(mode,"event-capacity")==1){return n03_capacity(0);}
    if(_zag_strcmp(mode,"attempt-capacity")==1){return n03_capacity(1);}
    if(_zag_strcmp(mode,"max-reload")==1){return nb_run(2,1);}
    if(mode.len>=9 && mode.len<=10 && nio_equal(mode[0..8],"boundary")==1){
        let k:i32=0;let p:i32=8;
        while(p<mode.len){if(mode[p]<48 || mode[p]>57){return 2;}k=k*10+(mode[p] as i32)-48;p=p+1;}
        if(k>=1 && k<=34){return nb_run(k,0);}return 2;
    }
    if(mode.len==6 && nio_equal(mode[0..5],"crash")==1 && mode[5]>=49 && mode[5]<=53){return n03_crash((mode[5] as i32)-48,0);}
    if(mode.len==8 && nio_equal(mode[0..7],"recover")==1 && mode[7]>=49 && mode[7]<=53){return n03_crash((mode[7] as i32)-48,1);}
    if(mode.len==7 && nio_equal(mode[0..6],"verify")==1 && mode[6]>=49 && mode[6]<=53){return n03_crash((mode[6] as i32)-48,2);}
    if(mode.len==8 && nio_equal(mode[0..7],"corrupt")==1 && mode[7]>=49 && mode[7]<=52){return n03_corruption((mode[7] as i32)-48);}
    return 2;
}

// Test oracle for the initial transaction's exact retained attempt bytes.
// Only literal engineering state and the separately tested SHA primitive are used.
fn n03_attempt_bytes(root:i64,transaction:i32,length:i32,fail:*i32)void {
    let expected:[]u8=nio_alloc(176);let initial:[]u8=n03_initial();let next:[]u8=n03_next(52);
    let root_record:[]u8=nj_root_record(initial);let actual:[]u8=nio_alloc(176);
    if(expected.len!=176 || actual.len!=176 || root_record.len!=80){
        n03_check("attempt_oracle_allocated",0,1,fail);
        nio_free(expected);nio_free(initial);nio_free(next);nio_free(root_record);nio_free(actual);return;
    }
    nj_copy("TNNTXN02",expected);nj_put32(expected,8,1);nj_put32(expected,12,transaction);
    nj_put32(expected,16,16);nj_put32(expected,20,1);nj_put32(expected,24,0);
    n03_check("attempt_oracle_root_hash",ns_sha256(root_record,expected[32..64]),0,fail);
    n03_check("attempt_oracle_before_hash",ns_sha256(initial,expected[64..96]),0,fail);
    n03_check("attempt_oracle_after_hash",ns_sha256(next,expected[96..128]),0,fail);
    nj_copy(next,expected[160..176]);
    n03_check("attempt_oracle_record_hash",nj_record_digest(expected,expected[128..160]),0,fail);
    let fd:i64=nj_open_index(root,"attempt-",1,0);
    let read:i64=nio_read_exact(fd,actual,176);
    n03_check("actual_retained_attempt_length",read,length,fail);
    if(read==length){n03_check("actual_retained_attempt_prefix",nio_equal(actual[0..length],expected[0..length]),1,fail);}
    if(fd>=0){nio_close(fd);}
    nio_free(expected);nio_free(initial);nio_free(next);nio_free(root_record);nio_free(actual);
}

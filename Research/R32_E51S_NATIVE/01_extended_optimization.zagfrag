// R32 E51S — cumulative 48/96/192 sweep snapshots of the same 32-cell expert.
// Native Zag v2 only; no cognition or topology change.

const E51S_DEV_EPISODES:i32=12960;
const E51S_DEV_SAMPLES:i32=220320;
const E51S_VALIDATION_EPISODES:i32=5400;
const E51S_VALIDATION_SAMPLES:i32=91800;
const E51S_CONFIRM_EPISODES:i32=10800;
const E51S_CONFIRM_SAMPLES:i32=183600;
const E51S_STAGE_DEV:i32=68;
const E51S_STAGE_VALIDATION:i32=69;
const E51S_STAGE_CONFIRM:i32=70;
const E51S_SNAPSHOTS:i32=3;
const E51S_CELLS:i32=32;
const E51S_MAX_SWEEPS:i32=192;

fn e51s_sweep_snapshot(index:i32)i32 {
    if(index==0){ return 48; }
    if(index==1){ return 96; }
    return 192;
}

fn e51s_allocate_worlds(dev:[]i32,validation:[]i32,confirmation:[]i32)i32 {
    let i:i32=0;
    while(i<E51S_DEV_EPISODES){ dev[i]=e51n_world_id(E51S_STAGE_DEV,i); i=i+1; }
    i=0; while(i<E51S_VALIDATION_EPISODES){ validation[i]=e51n_world_id(E51S_STAGE_VALIDATION,i); i=i+1; }
    i=0; while(i<E51S_CONFIRM_EPISODES){ confirmation[i]=e51n_world_id(E51S_STAGE_CONFIRM,i); i=i+1; }
    let dev_lo:i32=dev[0]; let dev_hi:i32=dev[E51S_DEV_EPISODES-1];
    let val_lo:i32=validation[0]; let val_hi:i32=validation[E51S_VALIDATION_EPISODES-1];
    let con_lo:i32=confirmation[0]; let con_hi:i32=confirmation[E51S_CONFIRM_EPISODES-1];
    let partition_gate:i32=0; if(dev_hi<val_lo && val_hi<con_lo){ partition_gate=1; }
    let domain_gate:i32=1;
    let domain:i32=0;
    while(domain<5){
        let lo:i64=e51n_domain_state(dev_lo,domain); let hi:i64=e51n_domain_state(con_hi,domain);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domain_gate=0; }
        let other:i32=domain+1;
        while(other<5){
            let olo:i64=e51n_domain_state(dev_lo,other); let ohi:i64=e51n_domain_state(con_hi,other);
            if(!(hi<olo || ohi<lo)){ domain_gate=0; }
            other=other+1;
        }
        domain=domain+1;
    }
    e45_print_pair("e51s_world_id_dev_lo",dev_lo); e45_print_pair("e51s_world_id_dev_hi",dev_hi);
    e45_print_pair("e51s_world_id_validation_lo",val_lo); e45_print_pair("e51s_world_id_validation_hi",val_hi);
    e45_print_pair("e51s_world_id_confirmation_lo",con_lo); e45_print_pair("e51s_world_id_confirmation_hi",con_hi);
    e45_print_pair("e51s_world_partition_gate",partition_gate); e45_print_pair("e51s_domain_initial_state_gate",domain_gate); e45_print_pair("e51s_world_assignment_failures",0);
    if(partition_gate==1 && domain_gate==1){ return 1; }
    return 0;
}

fn e51s_copy_snapshot(
    current_weights:[]i32,current_biases:[]i32,
    snapshot_weights:[]i32,snapshot_biases:[]i32,snapshot:i32,
    updates:i32,sweeps:i32,reason:i32,trace:i32,loss:i64,
    snapshot_updates:[]i32,snapshot_sweeps:[]i32,snapshot_reasons:[]i32,snapshot_traces:[]i32,snapshot_loss_low:[]i32,snapshot_loss_high:[]i32
)void {
    let ws:i32=snapshot*E51P_MAX_CELLS*E45_FEATURES;
    let bs:i32=snapshot*E51P_MAX_CELLS;
    let cell:i32=0;
    while(cell<E51S_CELLS){
        snapshot_biases[bs+cell]=current_biases[cell];
        let feature:i32=0;
        while(feature<E45_FEATURES){
            snapshot_weights[ws+cell*E45_FEATURES+feature]=current_weights[cell*E45_FEATURES+feature];
            feature=feature+1;
        }
        cell=cell+1;
    }
    snapshot_updates[snapshot]=updates; snapshot_sweeps[snapshot]=sweeps; snapshot_reasons[snapshot]=reason; snapshot_traces[snapshot]=trace;
    snapshot_loss_low[snapshot]=e50_loss_low(loss); snapshot_loss_high[snapshot]=e50_loss_high(loss);
}

fn e51s_fit_snapshots(
    records:[]i32,targets:[]i32,count:i32,
    global_weights:[]i32,global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    reverse:i32,
    snapshot_weights:[]i32,snapshot_biases:[]i32,
    snapshot_updates:[]i32,snapshot_sweeps:[]i32,snapshot_reasons:[]i32,snapshot_traces:[]i32,snapshot_loss_low:[]i32,snapshot_loss_high:[]i32,
    strict_loss_gate:*i32
)void {
    let current_weights:[]i32=zalloc_i(E51P_MAX_CELLS*E45_FEATURES);
    let current_biases:[]i32=zalloc_i(E51P_MAX_CELLS);
    e45_zero(current_weights,E51P_MAX_CELLS*E45_FEATURES); e45_zero(current_biases,E51P_MAX_CELLS);
    e45_zero(snapshot_weights,E51S_SNAPSHOTS*E51P_MAX_CELLS*E45_FEATURES); e45_zero(snapshot_biases,E51S_SNAPSHOTS*E51P_MAX_CELLS);
    e45_zero(snapshot_updates,E51S_SNAPSHOTS); e45_zero(snapshot_sweeps,E51S_SNAPSHOTS); e45_zero(snapshot_reasons,E51S_SNAPSHOTS); e45_zero(snapshot_traces,E51S_SNAPSHOTS); e45_zero(snapshot_loss_low,E51S_SNAPSHOTS); e45_zero(snapshot_loss_high,E51S_SNAPSHOTS);

    let residuals:[]i32=zalloc_i(count); let heads:[]i32=zalloc_i(E51S_CELLS); let next:[]i32=zalloc_i(count);
    let cell:i32=0; while(cell<E51S_CELLS){ heads[cell]=-1; cell=cell+1; }
    let traversal:i32=0;
    while(traversal<count){
        let index:i32=traversal; if(reverse==1){ index=count-1-traversal; }
        let record_start:i32=index*E50_RECORD_N;
        let routed:i32=e51p_route_cell(records,record_start,prototypes,parents,ranges,E51S_CELLS);
        let base:i32=e51m_linear_scalar_predict(records,record_start,global_weights,0,global_bias);
        residuals[index]=targets[index]-base;
        next[index]=heads[routed]; heads[routed]=index;
        traversal=traversal+1;
    }
    let current_loss:i64=0;
    traversal=0; while(traversal<count){ let r:i64=residuals[traversal] as i64; current_loss=current_loss+r*r; traversal=traversal+1; }
    let accepted_updates:i32=0; let accepted_sweeps:i32=0; let stop_reason:i32=2; let trace_hash:i32=4109; strict_loss_gate.*=1;
    let next_snapshot:i32=0; let stopped:i32=0;
    let sweep:i32=0;
    while(sweep<E51S_MAX_SWEEPS && stopped==0){
        let accepted_this_sweep:i32=0;
        cell=0;
        while(cell<E51S_CELLS){
            let coordinate:i32=0;
            while(coordinate<=E45_FEATURES){
                let numerator:i64=0; let denominator:i64=0; let before:i64=0;
                let index:i32=heads[cell];
                while(index>=0){
                    let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                    let r:i64=residuals[index] as i64;
                    numerator=numerator+r*(x as i64); denominator=denominator+(x as i64)*(x as i64); before=before+r*r;
                    index=next[index];
                }
                if(denominator>0){
                    let raw_delta:i64=numerator*1000/denominator;
                    let old_value:i32=current_biases[cell]; let lo:i32=-4000; let hi:i32=4000;
                    if(coordinate>0){ old_value=current_weights[cell*E45_FEATURES+coordinate-1]; lo=-16000; hi=16000; }
                    let proposed:i32=e51m_clamp_i64((old_value as i64)+raw_delta,lo,hi);
                    let delta:i32=proposed-old_value;
                    let accepted_coordinate:i32=0;
                    while(delta!=0 && accepted_coordinate==0){
                        let after:i64=0; index=heads[cell];
                        while(index>=0){
                            let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                            let nr:i32=residuals[index]-delta*x/1000; after=after+(nr as i64)*(nr as i64); index=next[index];
                        }
                        if(after<before){
                            index=heads[cell];
                            while(index>=0){
                                let x:i32=1000; if(coordinate>0){ x=e50_batch_column(records,index*E50_RECORD_N,coordinate,0); }
                                residuals[index]=residuals[index]-delta*x/1000; index=next[index];
                            }
                            if(coordinate==0){ current_biases[cell]=old_value+delta;
                            }else{ current_weights[cell*E45_FEATURES+coordinate-1]=old_value+delta; }
                            current_loss=current_loss+(after-before);
                            if(after>=before){ strict_loss_gate.*=0; }
                            accepted_coordinate=1; accepted_this_sweep=1; accepted_updates=accepted_updates+1;
                            trace_hash=e46_hash_update(trace_hash,cell); trace_hash=e46_hash_update(trace_hash,coordinate); trace_hash=e46_hash_update(trace_hash,delta); trace_hash=e46_hash_update(trace_hash,e51m_hash_i64(current_loss));
                        }else{ delta=delta/2; }
                    }
                }
                coordinate=coordinate+1;
            }
            cell=cell+1;
        }
        if(accepted_this_sweep==0){ stop_reason=1; stopped=1;
        }else{
            accepted_sweeps=accepted_sweeps+1;
            while(next_snapshot<E51S_SNAPSHOTS && accepted_sweeps==e51s_sweep_snapshot(next_snapshot)){
                e51s_copy_snapshot(current_weights,current_biases,snapshot_weights,snapshot_biases,next_snapshot,accepted_updates,accepted_sweeps,2,trace_hash,current_loss,snapshot_updates,snapshot_sweeps,snapshot_reasons,snapshot_traces,snapshot_loss_low,snapshot_loss_high);
                next_snapshot=next_snapshot+1;
            }
        }
        sweep=sweep+1;
    }
    while(next_snapshot<E51S_SNAPSHOTS){
        e51s_copy_snapshot(current_weights,current_biases,snapshot_weights,snapshot_biases,next_snapshot,accepted_updates,accepted_sweeps,stop_reason,trace_hash,current_loss,snapshot_updates,snapshot_sweeps,snapshot_reasons,snapshot_traces,snapshot_loss_low,snapshot_loss_high);
        next_snapshot=next_snapshot+1;
    }
    zfree(current_weights); zfree(current_biases); zfree(residuals); zfree(heads); zfree(next);
}

fn e51s_snapshots_identity(
    wa:[]i32,ba:[]i32,ua:[]i32,sa:[]i32,ra:[]i32,ta:[]i32,lla:[]i32,lha:[]i32,
    wb:[]i32,bb:[]i32,ub:[]i32,sb:[]i32,rb:[]i32,tb:[]i32,llb:[]i32,lhb:[]i32
)i32 {
    let snapshot:i32=0;
    while(snapshot<E51S_SNAPSHOTS){
        if(ua[snapshot]!=ub[snapshot] || sa[snapshot]!=sb[snapshot] || ra[snapshot]!=rb[snapshot] || ta[snapshot]!=tb[snapshot] || lla[snapshot]!=llb[snapshot] || lha[snapshot]!=lhb[snapshot]){ return 0; }
        let ws:i32=snapshot*E51P_MAX_CELLS*E45_FEATURES; let bs:i32=snapshot*E51P_MAX_CELLS;
        let cell:i32=0;
        while(cell<E51S_CELLS){
            if(ba[bs+cell]!=bb[bs+cell]){ return 0; }
            let feature:i32=0;
            while(feature<E45_FEATURES){ if(wa[ws+cell*E45_FEATURES+feature]!=wb[ws+cell*E45_FEATURES+feature]){ return 0; } feature=feature+1; }
            cell=cell+1;
        }
        snapshot=snapshot+1;
    }
    return 1;
}

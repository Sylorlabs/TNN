// TNN R32 E53 — generic conservative average-cost self-modification core.
//
// This module is representation-neutral. It does not consume evaluator mode,
// truth, ambiguity labels, seed identity, resource identity, tape time, fixed
// duration, graph identity, or a positive UNKNOWN target. The caller supplies
// learner-visible delayed grounded utility, actual observation/resource cost,
// replay sufficient statistics, and mutable learner-owned values.

const R32E53_UNKNOWN_VALUE:i32=0;

fn r32e53_abs(v:i32)i32 {
    if(v<0){
        return 0-v;
    }
    return v;
}

fn r32e53_max(a:i32,b:i32)i32 {
    if(a>b){
        return a;
    }
    return b;
}

fn r32e53_clamp(v:i32,lo:i32,hi:i32)i32 {
    if(v<lo){
        return lo;
    }
    if(v>hi){
        return hi;
    }
    return v;
}

// Differential/average-reward baseline. The rate is learner-owned and supplied
// by the enclosing cognition system; this primitive contains no task rule.
fn r32e53_average_reward_update(
    current_average:i32,
    realized_delayed_net_utility:i32,
    rate:i32
)i32 {
    let bounded_rate:i32=r32e53_clamp(rate,0,1000);
    let residual:i32=r32e53_clamp(
        realized_delayed_net_utility-current_average,
        -8000,8000
    );
    return r32e53_clamp(
        current_average+residual*bounded_rate/1000,
        -8000,8000
    );
}

// Learner-owned long-run resource shadow price. A consumed unit is expensive
// only to the extent that later grounded benefit failed to recover its cost.
fn r32e53_shadow_price_update(
    current_shadow:i32,
    actual_resource_cost:i32,
    recovered_delayed_utility:i32,
    rate:i32
)i32 {
    let target:i32=r32e53_max(0,actual_resource_cost-r32e53_max(0,recovered_delayed_utility));
    let bounded_rate:i32=r32e53_clamp(rate,0,1000);
    let residual:i32=r32e53_clamp(target-current_shadow,-4000,4000);
    return r32e53_clamp(
        current_shadow+residual*bounded_rate/1000,
        0,8000
    );
}

// Generic differential continuation/current target. UNKNOWN is not trained here
// and remains the separate immutable zero boundary.
fn r32e53_continue_target(
    delayed_terminal_utility_improvement:i32,
    actual_observation_cost:i32,
    learned_shadow_price:i32,
    running_average_utility:i32
)i32 {
    return r32e53_clamp(
        delayed_terminal_utility_improvement-
        actual_observation_cost-
        learned_shadow_price-
        running_average_utility,
        -8000,8000
    );
}

// Replay mixes sufficient statistics from the current reached distribution with
// retained earlier reached distributions. No evaluator identity is required.
fn r32e53_replay_mix_target(
    current_target:i32,
    current_mass:i32,
    replay_target:i32,
    replay_mass:i32
)i32 {
    let cm:i32=r32e53_max(0,current_mass);
    let rm:i32=r32e53_max(0,replay_mass);
    let total:i32=cm+rm;
    if(total<=0){
        return 0;
    }
    return r32e53_clamp(
        (current_target*cm+replay_target*rm)/total,
        -8000,8000
    );
}

// Trust-region style integer TD step. Large endogenous distribution shifts may
// change the target sharply, but a single accepted update cannot jump farther
// than residual_clip before the supplied learning rate is applied.
fn r32e53_conservative_value_update(
    current_value:i32,
    target:i32,
    rate:i32,
    residual_clip:i32,
    value_clip:i32
)i32 {
    let clip:i32=r32e53_max(1,residual_clip);
    let limit:i32=r32e53_max(1,value_clip);
    let bounded_rate:i32=r32e53_clamp(rate,0,1000);
    let residual:i32=r32e53_clamp(target-current_value,0-clip,clip);
    return r32e53_clamp(
        current_value+residual*bounded_rate/1000,
        0-limit,limit
    );
}

// Candidate replacement is based on complete-development grounded utility with
// a generic endogenous-distribution churn cost. No correctness/ambiguity label
// is available to this cognition-side acceptance primitive.
fn r32e53_policy_objective(
    complete_delayed_net_utility:i32,
    reached_distribution_churn_cost:i32
)i32 {
    return complete_delayed_net_utility-r32e53_max(0,reached_distribution_churn_cost);
}

fn r32e53_accept_candidate(
    incumbent_net_utility:i32,
    incumbent_churn_cost:i32,
    candidate_net_utility:i32,
    candidate_churn_cost:i32
)i32 {
    let incumbent:i32=r32e53_policy_objective(incumbent_net_utility,incumbent_churn_cost);
    let candidate:i32=r32e53_policy_objective(candidate_net_utility,candidate_churn_cost);
    if(candidate>incumbent){
        return 1;
    }
    return 0;
}

fn r32e53_unknown_value()i32 {
    return R32E53_UNKNOWN_VALUE;
}

fn r32e53_print_metric(label:[]u8,value:i32)void {
    _zag_print(label);
    _zag_print(",");
    _zag_println(_zag_i64_to_str(value as i64));
}

fn main()i32 {
    let gate:i32=0;

    let cheap:i32=r32e53_continue_target(1000,100,100,100);
    let costly:i32=r32e53_continue_target(1000,400,100,100);
    let cost_sensitive:i32=0;
    if(costly<cheap){ cost_sensitive=1; }
    gate=gate+cost_sensitive;

    let low_shadow:i32=r32e53_shadow_price_update(100,400,300,500);
    let high_shadow:i32=r32e53_shadow_price_update(100,700,100,500);
    let shadow_sensitive:i32=0;
    if(high_shadow>low_shadow){ shadow_sensitive=1; }
    gate=gate+shadow_sensitive;

    let clipped:i32=r32e53_conservative_value_update(0,3000,500,200,4000);
    let bounded_update:i32=0;
    if(clipped==100){ bounded_update=1; }
    gate=gate+bounded_update;

    let mixed:i32=r32e53_replay_mix_target(1000,1,-1000,3);
    let replay_damps:i32=0;
    if(r32e53_abs(mixed)<1000){ replay_damps=1; }
    gate=gate+replay_damps;

    let average:i32=r32e53_average_reward_update(0,1000,250);
    let average_updates:i32=0;
    if(average==250){ average_updates=1; }
    gate=gate+average_updates;

    let accept_good:i32=r32e53_accept_candidate(800,50,1000,100);
    let reject_bad:i32=r32e53_accept_candidate(800,50,800,100);
    let conservative_acceptance:i32=0;
    if(accept_good==1 && reject_bad==0){ conservative_acceptance=1; }
    gate=gate+conservative_acceptance;

    let unknown_zero:i32=0;
    if(r32e53_unknown_value()==0){ unknown_zero=1; }
    gate=gate+unknown_zero;

    r32e53_print_metric("cost_sensitive_continue_target",cost_sensitive);
    r32e53_print_metric("learned_shadow_price_response",shadow_sensitive);
    r32e53_print_metric("bounded_policy_update",bounded_update);
    r32e53_print_metric("replay_damps_distribution_jump",replay_damps);
    r32e53_print_metric("average_reward_updates",average_updates);
    r32e53_print_metric("conservative_candidate_acceptance",conservative_acceptance);
    r32e53_print_metric("unknown_value_zero",unknown_zero);
    r32e53_print_metric("evaluator_label_inside_cognition",0);
    r32e53_print_metric("graph_substrate_required",0);
    r32e53_print_metric("newborn_restarts",0);

    if(gate==7){
        _zag_println("TNN_R32_E53_CONSERVATIVE_POLICY_CORE_GATE=PASS");
        return 0;
    }
    _zag_println("TNN_R32_E53_CONSERVATIVE_POLICY_CORE_GATE=FAIL");
    return 1;
}
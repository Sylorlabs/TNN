// R32 E51C learner-owned sparse continuation Foundry.
const E51C_DEV_EPISODES:i32=3240;
const E51C_VALIDATION_EPISODES:i32=5400;
const E51C_CONFIRM_EPISODES:i32=10800;
const E51C_MAX_INTERACTIONS:i32=4;

fn e51c_allocate_seeds(
    raw_seen:[]i32,
    evidence_seen:[]i32,
    resource_seen:[]i32,
    dev_seeds:[]i32,
    validation_seeds:[]i32,
    confirmation_seeds:[]i32
)i32 {
    // Reserve the exact E51B streams first so this run cannot silently reuse
    // development, validation or sealed-confirmation worlds already consumed or allocated.
    let old_dev:[]i32=zalloc_i(E51B_DEV_EPISODES);
    let old_validation:[]i32=zalloc_i(E51B_VALIDATION_EPISODES);
    let old_confirmation:[]i32=zalloc_i(E51B_CONFIRM_EPISODES);
    let e51b_reservation_gate:i32=e51b_allocate_seeds(
        raw_seen,evidence_seen,resource_seen,old_dev,old_validation,old_confirmation
    );
    zfree(old_dev); zfree(old_validation); zfree(old_confirmation);

    e45_zero(dev_seeds,E51C_DEV_EPISODES);
    e45_zero(validation_seeds,E51C_VALIDATION_EPISODES);
    e45_zero(confirmation_seeds,E51C_CONFIRM_EPISODES);
    let failures:i32=0;
    let emitted:i32=0;
    let epoch:i32=0;
    while(epoch<2){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,27,index,mode,resource,&failures);
                        dev_seeds[index]=seed;
                        emitted=emitted+1;
                        episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,28,index,mode,resource,&failures);
                    validation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    base_index=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<40){
                    let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                    let seed:i32=e46_assign_fresh_seed(raw_seen,evidence_seen,resource_seen,29,index,mode,resource,&failures);
                    confirmation_seeds[index]=seed;
                    emitted=emitted+1;
                    episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    e45_print_pair("e51c_e51b_reservation_gate",e51b_reservation_gate);
    e45_print_pair("e51c_seed_manifest_emitted",emitted);
    e45_print_pair("e51c_seed_assignment_failures",failures);
    e45_print_pair("e51c_sealed_confirmation_allocated",E51C_CONFIRM_EPISODES);
    e45_print_pair("e51c_sealed_confirmation_executed",0);
    if(e51b_reservation_gate==1 && failures==0){ return 1; }
    return 0;
}

fn e51c_pair_value(features:[]i32,start:i32,left:i32,right:i32)i32 {
    let product:i64=(features[start+left] as i64)*(features[start+right] as i64);
    let value:i32=(product/1000) as i32;
    return r32e45_clamp(value,-2000,2000);
}

fn e51c_pair_already_selected(
    pair_left:[]i32,
    pair_right:[]i32,
    count:i32,
    left:i32,
    right:i32
)i32 {
    let k:i32=0;
    while(k<count){
        if(pair_left[k]==left && pair_right[k]==right){ return 1; }
        k=k+1;
    }
    return 0;
}

fn e51c_predict_features(
    weights:[]i32,
    weight_start:i32,
    bias:i32,
    features:[]i32,
    feature_start:i32,
    pair_left:[]i32,
    pair_right:[]i32,
    coefficients:[]i32,
    count:i32
)i32 {
    let value:i32=e47_linear_predict(weights,weight_start,features,feature_start,bias);
    let k:i32=0;
    while(k<count){
        let interaction:i32=e51c_pair_value(features,feature_start,pair_left[k],pair_right[k]);
        value=value+coefficients[k]*interaction/1000;
        k=k+1;
    }
    return r32e45_clamp(value,-4000,4000);
}

fn e51c_training_loss(
    records:[]i32,
    weights:[]i32,
    bias:i32,
    pair_left:[]i32,
    pair_right:[]i32,
    coefficients:[]i32,
    count:i32,
    reverse:i32
)i64 {
    let loss:i64=0;
    let traversal:i32=0;
    while(traversal<E51B_SAMPLES){
        let record_number:i32=traversal;
        if(reverse==1){ record_number=E51B_SAMPLES-1-traversal; }
        let start:i32=record_number*E50_RECORD_N;
        let predicted:i32=e51c_predict_features(
            weights,0,bias,records,start,pair_left,pair_right,coefficients,count
        );
        let residual:i64=(records[start+34]-predicted) as i64;
        loss=loss+residual*residual;
        traversal=traversal+1;
    }
    return loss;
}

fn e51c_foundry_search(
    records:[]i32,
    weights:[]i32,
    bias:i32,
    reverse:i32,
    pair_left:[]i32,
    pair_right:[]i32,
    coefficients:[]i32,
    accepted_count:*i32,
    base_loss:*i64,
    final_loss:*i64,
    trace_hash:*i32
)void {
    e45_zero(pair_left,E51C_MAX_INTERACTIONS);
    e45_zero(pair_right,E51C_MAX_INTERACTIONS);
    e45_zero(coefficients,E51C_MAX_INTERACTIONS);
    accepted_count.*=0;
    trace_hash.*=307;
    base_loss.*=e51c_training_loss(records,weights,bias,pair_left,pair_right,coefficients,0,reverse);
    final_loss.*=base_loss.*;
    let stage:i32=0;
    let stopped:i32=0;
    while(stage<E51C_MAX_INTERACTIONS && stopped==0){
        let best_left:i32=-1;
        let best_right:i32=-1;
        let best_coefficient:i32=0;
        let best_score:i64=0;
        let left:i32=0;
        while(left<E45_FEATURES){
            let right:i32=left+1;
            while(right<E45_FEATURES){
                if(e51c_pair_already_selected(pair_left,pair_right,accepted_count.*,left,right)==0){
                    let correlation:i64=0;
                    let energy:i64=0;
                    let traversal:i32=0;
                    while(traversal<E51B_SAMPLES){
                        let record_number:i32=traversal;
                        if(reverse==1){ record_number=E51B_SAMPLES-1-traversal; }
                        let start:i32=record_number*E50_RECORD_N;
                        let predicted:i32=e51c_predict_features(
                            weights,0,bias,records,start,
                            pair_left,pair_right,coefficients,accepted_count.*
                        );
                        let residual:i64=(records[start+34]-predicted) as i64;
                        let interaction:i32=e51c_pair_value(records,start,left,right);
                        correlation=correlation+(interaction as i64)*residual;
                        energy=energy+(interaction as i64)*(interaction as i64);
                        traversal=traversal+1;
                    }
                    if(energy>0){
                        let coefficient:i32=e50_round_nearest_i64(correlation*1000,energy) as i32;
                        coefficient=r32e45_clamp(coefficient,-16000,16000);
                        let absolute_correlation:i64=correlation;
                        if(absolute_correlation<0){ absolute_correlation=-absolute_correlation; }
                        let absolute_coefficient:i32=coefficient;
                        if(absolute_coefficient<0){ absolute_coefficient=-absolute_coefficient; }
                        let score:i64=absolute_correlation*(absolute_coefficient as i64)/1000;
                        if(score>best_score){
                            best_score=score;
                            best_left=left;
                            best_right=right;
                            best_coefficient=coefficient;
                        }
                    }
                }
                right=right+1;
            }
            left=left+1;
        }
        if(best_left<0 || best_score<=0){

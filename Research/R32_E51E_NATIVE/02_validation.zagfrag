const E51E_R_FIELDS:i32=8;
const E51E_R_EPISODES:i32=0;
const E51E_R_KNOWN:i32=1;
const E51E_R_NO_UNIQUE:i32=2;
const E51E_R_KNOWN_REACHABLE:i32=3;
const E51E_R_NO_UNIQUE_REACHABLE:i32=4;
const E51E_R_T0_SUCCESS:i32=5;
const E51E_R_REACHABLE_TIMES:i32=6;
const E51E_R_SUCCESS_TIMES:i32=7;

fn e51e_reachability_episode(
    seed:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    reach:[]i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let losses:[]i32=zalloc_i(E45_TAPE);
    let feasible:[]i32=zalloc_i(E45_TAPE);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);
    let model_features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(4);
    let reached:[]i32=zalloc_i(E51E_MODELS);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);
    e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN;
    e45_zero(reached,E51E_MODELS);
    e45_copy(states,live_state,E45_STATE_N);

    let model:i32=0;
    while(model<E51E_MODELS){
        let start:i32=model*E51E_R_FIELDS;
        reach[start+E51E_R_EPISODES]=reach[start+E51E_R_EPISODES]+1;
        if(truth_state[0]<0){ reach[start+E51E_R_NO_UNIQUE]=reach[start+E51E_R_NO_UNIQUE]+1;
        }else{ reach[start+E51E_R_KNOWN]=reach[start+E51E_R_KNOWN]+1; }
        model=model+1;
    }

    let t:i32=0;
    while(t<=E45_TAPE){
        let immediate_a:i32=passive_a[E45_PASSIVE-1];
        let immediate_b:i32=passive_b[E45_PASSIVE-1];
        if(t>0){ immediate_a=tape_a[t-1]; immediate_b=tape_b[t-1]; }
        model=0;
        while(model<E51E_MODELS){
            let choice:i32=e51b_terminal_choice(
                model,states,t*E45_STATE_N,option,resource_features,hazard,
                immediate_a,immediate_b,learned_shadow,
                terminal_weights,terminal_biases,terminal_option,full_features,
                baseline_features,model_features,scores
            );
            let terminal_utility:i32=e45_terminal_value(choice,states,t*E45_STATE_N,initial_state,truth_state[t]);
            let success:i32=0;
            if(truth_state[t]<0){
                if(choice==R32E45_TERM_UNKNOWN){ success=1; }
            }else{
                if(choice!=R32E45_TERM_UNKNOWN && terminal_utility==1000){ success=1; }
            }
            let start:i32=model*E51E_R_FIELDS;
            reach[start+E51E_R_REACHABLE_TIMES]=reach[start+E51E_R_REACHABLE_TIMES]+1;
            if(success==1){
                reach[start+E51E_R_SUCCESS_TIMES]=reach[start+E51E_R_SUCCESS_TIMES]+1;
                reached[model]=1;
                if(t==0){ reach[start+E51E_R_T0_SUCCESS]=reach[start+E51E_R_T0_SUCCESS]+1; }
            }
            model=model+1;
        }
        if(t<E45_TAPE){
            if(t==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,0); }
            let j:i32=0;
            while(j<E45_STATE_N){ live_state[j]=states[(t+1)*E45_STATE_N+j]; j=j+1; }
            e45_option_observe(option,live_state,tape_a[t],tape_b[t],tape_source[t],learned_shadow);
        }
        t=t+1;
    }

    model=0;
    while(model<E51E_MODELS){
        let start:i32=model*E51E_R_FIELDS;
        if(reached[model]==1){
            if(truth_state[0]<0){ reach[start+E51E_R_NO_UNIQUE_REACHABLE]=reach[start+E51E_R_NO_UNIQUE_REACHABLE]+1;
            }else{ reach[start+E51E_R_KNOWN_REACHABLE]=reach[start+E51E_R_KNOWN_REACHABLE]+1; }
        }
        model=model+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(losses); zfree(feasible); zfree(option); zfree(terminal_option);
    zfree(full_features); zfree(baseline_features); zfree(model_features); zfree(scores); zfree(reached);
}

fn e51e_joint_validate_episode(
    seed:i32,
    base_index:i32,
    evaluator_mode:i32,
    evaluator_resource:i32,
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32,
    terminal_weights:[]i32,
    terminal_biases:[]i32,
    continue_weights:[]i32,
    continue_biases:[]i32,
    aggregate:[]i32,
    cell_metrics:[]i32,
    stop_histogram:[]i32
)void {
    let history_a:[]i32=zalloc_i(E45_HIST);
    let history_b:[]i32=zalloc_i(E45_HIST);
    let history_source:[]i32=zalloc_i(E45_HIST);
    let passive_a:[]i32=zalloc_i(E45_PASSIVE);
    let passive_b:[]i32=zalloc_i(E45_PASSIVE);
    let passive_source:[]i32=zalloc_i(E45_PASSIVE);
    let tape_a:[]i32=zalloc_i(E45_TAPE);
    let tape_b:[]i32=zalloc_i(E45_TAPE);
    let tape_source:[]i32=zalloc_i(E45_TAPE);
    let truth_state:[]i32=zalloc_i(E45_TAPE+1);
    let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
    let resource_features:[]i32=zalloc_i(E45_SHADOW_FEATURES);
    let states:[]i32=zalloc_i((E45_TAPE+1)*E45_STATE_N);
    let live_state:[]i32=zalloc_i(E45_STATE_N);
    let ordered_a:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_b:[]i32=zalloc_i(E45_ORDERED_MAX);
    let ordered_source:[]i32=zalloc_i(E45_ORDERED_MAX);
    let losses:[]i32=zalloc_i(E45_TAPE);
    let feasible:[]i32=zalloc_i(E45_TAPE);
    let option:[]i32=zalloc_i(E45_OPTION_N);
    let terminal_option:[]i32=zalloc_i(E45_OPTION_N);
    let full_features:[]i32=zalloc_i(E45_FEATURES);
    let baseline_features:[]i32=zalloc_i(E45_FEATURES);
    let model_features:[]i32=zalloc_i(E45_FEATURES);
    let continuation_features:[]i32=zalloc_i(E45_FEATURES);
    let scores:[]i32=zalloc_i(4);

    let historical_state:i32=R32E45_UNKNOWN;
    e45_make_truth(seed,evaluator_mode,truth_state,&historical_state);
    e45_make_history_evidence(seed,evaluator_mode,historical_state,history_a,history_b,history_source);
    e45_make_passive_evidence(seed,evaluator_mode,truth_state[0],passive_a,passive_b,passive_source);
    e45_make_active_evidence(seed,evaluator_mode,truth_state,historical_state,tape_a,tape_b,tape_source);
    let budget:i32=0;
    let action_cost:i32=0;
    e45_make_resource(seed,evaluator_resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
    e45_resource_features(history_cost,history_reward,budget,action_cost,resource_features);
    let learned_shadow:i32=e45_shadow_predict(shadow_weights,resource_features,shadow_bias);
    let initial_state:i32=R32E45_UNKNOWN;
    e45_build_state_tape(
        history_a,history_b,history_source,passive_a,passive_b,passive_source,
        tape_a,tape_b,tape_source,source_trust,dependence_penalty,hazard,
        states,&initial_state,live_state,ordered_a,ordered_b,ordered_source
    );
    e45_build_step_losses(future_cost,future_reward,budget,action_cost,losses,feasible);

    let model:i32=0;
    while(model<E51E_MODELS){
        e45_zero(option,E45_OPTION_N); option[E45_O_ALT]=R32E45_UNKNOWN;
        e45_copy(states,live_state,E45_STATE_N);
        let observations:i32=0;
        let opportunity_loss:i32=0;
        let stopped:i32=0;
        let final_choice:i32=R32E45_TERM_UNKNOWN;
        let final_terminal_utility:i32=0;
        while(stopped==0){
            let immediate_a:i32=passive_a[E45_PASSIVE-1];
            let immediate_b:i32=passive_b[E45_PASSIVE-1];
            if(observations>0){ immediate_a=tape_a[observations-1]; immediate_b=tape_b[observations-1]; }
            let terminal_choice:i32=e51b_terminal_choice(
                model,states,observations*E45_STATE_N,option,resource_features,hazard,
                immediate_a,immediate_b,learned_shadow,
                terminal_weights,terminal_biases,terminal_option,full_features,
                baseline_features,model_features,scores
            );
            let terminal_score:i32=scores[terminal_choice];
            let take_continue:i32=0;
            if(observations<E45_TAPE && feasible[observations]==1){
                e51b_continuation_features(
                    states,observations*E45_STATE_N,option,resource_features,hazard,
                    immediate_a,immediate_b,learned_shadow,
                    full_features,baseline_features,continuation_features
                );
                let predicted_continue:i32=e47_linear_predict(
                    continue_weights,(model*4)*E45_FEATURES,
                    continuation_features,0,continue_biases[model*4]
                );
                if(predicted_continue>terminal_score){ take_continue=1; }
                if(take_continue==1){
                    let advantage:i32=predicted_continue-terminal_score;
                    if(observations==0){ e45_option_initialize(option,live_state,consequence,learned_shadow,advantage); }
                    opportunity_loss=opportunity_loss+losses[observations];
                    let tape_index:i32=observations;
                    observations=observations+1;
                    let j:i32=0;
                    while(j<E45_STATE_N){ live_state[j]=states[observations*E45_STATE_N+j]; j=j+1; }
                    e45_option_observe(option,live_state,tape_a[tape_index],tape_b[tape_index],tape_source[tape_index],learned_shadow);
                }
            }
            if(take_continue==0){
                final_choice=terminal_choice;
                final_terminal_utility=e45_terminal_value(
                    final_choice,states,observations*E45_STATE_N,initial_state,truth_state[observations]
                );
                stopped=1;
            }
        }
        let final_utility:i32=final_terminal_utility-opportunity_loss;
        e51b_record_outcome(
            aggregate,model*E51B_AGG_FIELDS,final_choice,final_utility,truth_state[observations],
            observations,opportunity_loss
        );
        stop_histogram[model*(E45_TAPE+1)+observations]=stop_histogram[model*(E45_TAPE+1)+observations]+1;
        let cell:i32=e51b_cell_offset(model,base_index,evaluator_mode,evaluator_resource);
        cell_metrics[cell]=cell_metrics[cell]+1;
        if(truth_state[observations]<0){
            cell_metrics[cell+1]=cell_metrics[cell+1]+1;
            if(final_choice==R32E45_TERM_UNKNOWN){ cell_metrics[cell+2]=cell_metrics[cell+2]+1;
            }else{ cell_metrics[cell+3]=cell_metrics[cell+3]+1; }
        }else{
            cell_metrics[cell+4]=cell_metrics[cell+4]+1;
            if(final_choice==R32E45_TERM_UNKNOWN){ cell_metrics[cell+6]=cell_metrics[cell+6]+1;
            }else{
                if(final_terminal_utility==1000){ cell_metrics[cell+5]=cell_metrics[cell+5]+1;
                }else{ cell_metrics[cell+7]=cell_metrics[cell+7]+1; }
            }
        }
        cell_metrics[cell+8]=cell_metrics[cell+8]+observations;
        cell_metrics[cell+9]=cell_metrics[cell+9]+opportunity_loss;
        model=model+1;
    }

    zfree(history_a); zfree(history_b); zfree(history_source);
    zfree(passive_a); zfree(passive_b); zfree(passive_source);
    zfree(tape_a); zfree(tape_b); zfree(tape_source); zfree(truth_state);
    zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward);
    zfree(resource_features); zfree(states); zfree(live_state);
    zfree(ordered_a); zfree(ordered_b); zfree(ordered_source);
    zfree(losses); zfree(feasible); zfree(option); zfree(terminal_option);
    zfree(full_features); zfree(baseline_features); zfree(model_features); zfree(continuation_features); zfree(scores);
}

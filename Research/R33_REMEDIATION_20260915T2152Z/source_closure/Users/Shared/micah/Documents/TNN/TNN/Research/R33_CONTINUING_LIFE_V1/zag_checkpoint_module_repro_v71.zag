// V71: exercise direct, assignment, and conditional checkpoint-section calls
// through the real module. Native Zag only; no learner state is involved.
@import("checkpoint.zag")

fn main()i32 {
    let out:[]u8=nio_alloc(300000);let payload:[]u8=nio_alloc(1);
    let parent:[]u8=nio_alloc(32);let previous:[]u8=nio_alloc(32);
    if(out.len!=300000 || payload.len!=1 || parent.len!=32 || previous.len!=32){return 70;}
    ns_sha256("V71_CHECKPOINT_MODULE",parent);
    let begin:i32=cl_checkpoint_begin(out,1,parent,previous);
    let at0:i32=112;let vr:i32=cl_checkpoint_section(out,&at0,1,payload);
    _zag_print("V71_DIRECT,");cl_number(vr as i64);_zag_print(",");cl_number(at0 as i64);_zag_println("");
    let at1:i32=112;let wr:i32=cl_checkpoint_section(out,&at1,1,payload);
    _zag_print("V71_WRITE,");cl_number(wr as i64);_zag_print(",");cl_number(at1 as i64);_zag_println("");
    let at2:i32=112;let ar:i32=99;ar=cl_checkpoint_section(out,&at2,1,payload);
    _zag_print("V71_ASSIGN_CALL,");cl_number(ar as i64);_zag_print(",");cl_number(at2 as i64);_zag_println("");
    let at3:i32=112;let cr:i32=begin;if(cr==0){cr=cl_checkpoint_section(out,&at3,1,payload);}
    _zag_print("V71_COND_ASSIGN_CALL,");cl_number(cr as i64);_zag_print(",");cl_number(at3 as i64);_zag_println("");
    let failures:i32=((begin!=0) as i32)+((vr!=0 || at0!=121) as i32)+((wr!=0 || at1!=121) as i32)+
        ((ar!=0 || at2!=121) as i32)+((cr!=0 || at3!=121) as i32);
    _zag_print("V71_FAILURES,");cl_number(failures as i64);_zag_println("");
    nio_free(out);nio_free(payload);nio_free(parent);nio_free(previous);return (failures!=0) as i32;
}

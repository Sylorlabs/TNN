// Minimal native Zag probe for passing local slices beside &scalar locals.
@import("common.zag")

fn clv69_mixed_call(out:[]u8,at:*i32,id:i32,payload:[]u8)i32 @noalloc {
    if(out.len!=300000){return 71;}
    if(at==null as *i32 || at.*!=112){return 72;}
    if(id!=1 || payload.len!=1){return 73;}
    at.*=at.*+8+payload.len;
    return 0;
}

fn clv69_mixed_nested(out:[]u8,at:*i32,id:i32,payload:[]u8)i32 {
    let disjoint:i32=cl_disjoint(out,payload);
    if(disjoint!=1){return 74;}
    if(out.len!=300000){return 75;}
    if(at==null as *i32 || at.*!=112){return 76;}
    if(id!=1 || payload.len!=1){return 77;}
    at.*=at.*+8+payload.len;
    return 0;
}

fn main()i32 {
    let out:[]u8=nio_alloc(300000);let payload:[]u8=nio_alloc(1);
    let at:i32=112;
    let rc:i32=clv69_mixed_call(out,&at,1,payload);
    _zag_print("CL_V69_LOCAL_SLICE_CALL,");cl_number(rc as i64);_zag_print(",");cl_number(at as i64);_zag_println("");
    let nested_at:i32=112;
    let nested_rc:i32=clv69_mixed_nested(out,&nested_at,1,payload);
    _zag_print("CL_V69_LOCAL_SLICE_NESTED,");cl_number(nested_rc as i64);_zag_print(",");cl_number(nested_at as i64);_zag_println("");
    nio_free(out);nio_free(payload);
    if(rc!=0 || at!=121 || nested_rc!=0 || nested_at!=121){return 1;}return 0;
}

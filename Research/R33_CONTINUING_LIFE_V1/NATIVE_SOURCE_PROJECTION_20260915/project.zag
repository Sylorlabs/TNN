// Strict bounded projection for flat local-file @import closures only.
// Source bytes are copied verbatim except actual import directive spans.
@import("../../R33_NATIVE_SHA256_V2.zag")
struct NPFile {path:[]u8,state:i32}
struct NP {files:*NPFile,count:i32,out:[]u8,log:[]u8,error:i32}
fn np_add(p:*NP,s:[]u8) i32 {
    if(s.len>8388608-p.*.out.len){p.*.error=10;return 10;}
    p.*.out=_zag_str_concat(p.*.out,s);return 0;
}
fn np_norm(path:[]u8)[]u8 {
    if(path.len<1 || path.len>4095 || path[0]!='/'){return "";}
    let out:[]u8="";let i:i32=1;
    while(i<=path.len){let a:i32=i;while(i<path.len && path[i]!='/'){if(path[i]<32 || path[i]==127){return "";}i=i+1;}
        let part:[]u8=path[a..i];
        if(@strEq(part,"..")){if(out.len==0){return "";}let j:i32=out.len-1;while(j>=0 && out[j]!='/'){j=j-1;}out=out[0..j];}
        else if(part.len>0 && !@strEq(part,".")){out=_zag_str_concat(_zag_str_concat(out,"/"),part);}
        i=i+1;
    }
    if(out.len==0){return "/";}return out;
}
fn np_hash(src:[]u8)[]u8 {let b:[]u8=nio_alloc(32);if(ns_sha256(src,b)!=0){return "";}let h:[]u8=ns_hex(b);nio_free(b);return h;}
fn np_log(p:*NP,s:[]u8)i32 {p.*.log=_zag_str_concat(p.*.log,s);return 0;}
fn np_ws(c:u8)bool {return c==32 || c==9 || c==10 || c==13;}
fn np_ident(c:u8)bool {return (c>=65 && c<=90) || (c>=97 && c<=122) || (c>=48 && c<=57) || c==95;}
fn np_publish(path:[]u8,bytes:[]u8)i32 {
    let name:[]u8=nio_cstr(path);if(name.len==0){return 1;}
    // Darwin O_WRONLY|O_CREAT|O_EXCL: never truncate files or follow leaf symlinks.
    let fd:i64=_zag_darwin_syscall(5,_zag_slice_ptr(name) as i64,2561,384,0,0,0);nio_free(name);if(fd<0){return 1;}
    let at:i32=0;while(at<bytes.len){let end:i32=at+1048576;if(end>bytes.len){end=bytes.len;}if(nio_write_all(fd,bytes[at..end])!=end-at){nio_close(fd);return 1;}at=end;}
    return (nio_close(fd)!=0) as i32;
}
fn np_load(p:*NP,path:[]u8,depth:i32)i32 {
    if(depth>64 || p.*.count>=128){return 11;}
    let k:i32=0;while(k<p.*.count){if(@strEq(p.*.files[k].path,path)){if(p.*.files[k].state==1){return 12;}return 0;}k=k+1;}
    let slot:i32=p.*.count;p.*.count=slot+1;p.*.files[slot]=NPFile{.path=path,.state=1};
    let src:[]u8=_zag_read_file(path);if(src.len<0 || src.len>2097152){return 13;}
    let h:[]u8=np_hash(src);if(h.len!=64){return 14;}
    np_log(p,_zag_str_concat(_zag_str_concat(_zag_str_concat("FILE\t",h),"\t"),_zag_str_concat(path,"\n")));
    let enddir:i32=path.len-1;while(enddir>=0 && path[enddir]!='/'){enddir=enddir-1;}
    let body:[]u8="";let start:i32=0;let i:i32=0;let braces:i32=0;
    while(i<src.len){
        if(i+1<src.len && src[i]=='/' && src[i+1]=='/'){i=i+2;while(i<src.len && src[i]!=10){i=i+1;}}
        else if(i+1<src.len && src[i]=='/' && src[i+1]=='*'){
            i=i+2;let level:i32=1;while(i<src.len && level>0){if(i+1<src.len && src[i]=='/' && src[i+1]=='*'){level=level+1;i=i+2;}else if(i+1<src.len && src[i]=='*' && src[i+1]=='/'){level=level-1;i=i+2;}else{i=i+1;}}if(level!=0){return 15;}
        }
        else if(src[i]=='"' || src[i]==39){let quote:u8=src[i];i=i+1;let closed:i32=0;while(i<src.len && closed==0){if(src[i]==92){i=i+2;}else if(src[i]==quote){closed=1;i=i+1;}else{i=i+1;}}if(closed==0 || i>src.len){return 16;}}
        else if(i+7<=src.len && @strEq(src[i..i+7],"@import")){
            if(braces!=0){return 17;}let a:i32=i;i=i+7;
            while(i<src.len && np_ws(src[i])){i=i+1;}if(i>=src.len || src[i]!='('){return 18;}i=i+1;
            while(i<src.len && np_ws(src[i])){i=i+1;}if(i>=src.len || src[i]!='"'){return 18;}i=i+1;let s:i32=i;
            while(i<src.len && src[i]!='"'){if(src[i]==92 || src[i]==':' || src[i]<32){return 19;}i=i+1;}
            if(i>=src.len || i==s){return 18;}let rel:[]u8=src[s..i];if(rel[0]=='/'){return 19;}i=i+1;
            while(i<src.len && np_ws(src[i])){i=i+1;}if(i>=src.len || src[i]!=')'){return 18;}i=i+1;
            // Consume an immediately adjacent optional semicolon only.
            if(i<src.len && src[i]==';'){i=i+1;}
            let child:[]u8=np_norm(_zag_str_concat(_zag_str_concat(path[0..enddir],"/"),rel));if(child.len==0){return 19;}
            np_log(p,_zag_str_concat(_zag_str_concat(_zag_str_concat(_zag_str_concat("IMPORT\t",path),"\t"),_zag_i64_to_str(a as i64)),_zag_str_concat(_zag_str_concat("\t",_zag_i64_to_str(i as i64)),_zag_str_concat(_zag_str_concat("\t",child),"\n"))));
            let rc:i32=np_load(p,child,depth+1);if(rc!=0){return rc;}
            body=_zag_str_concat(body,src[start..a]);start=i;
        }
        else if(src[i]=='#'){return 23;}
        else if(src[i]=='@' && braces==0){return 24;}
        else if(np_ident(src[i])){let a:i32=i;while(i<src.len && np_ident(src[i])){i=i+1;}let word:[]u8=src[a..i];if(braces==0 && (@strEq(word,"script") || @strEq(word,"module") || @strEq(word,"package") || @strEq(word,"edition") || @strEq(word,"as"))){return 24;}}
        else {if(src[i]=='{'){braces=braces+1;}if(src[i]=='}'){braces=braces-1;if(braces<0){return 20;}}i=i+1;}
    }
    if(braces!=0){return 20;}
    body=_zag_str_concat(body,src[start..src.len]);
    np_log(p,_zag_str_concat("EMIT\t",_zag_str_concat(path,"\n")));
    // A newline separator prevents cross-file token/comment fusion.
    let rc:i32=np_add(p,body);if(rc!=0){return rc;}np_add(p,"\n");
    p.*.files[slot].state=2;return p.*.error;
}
fn main()i32 {
    if(_zag_argc()==3 && @strEq(_zag_arg(1),"--hash")){let src:[]u8=_zag_read_file(_zag_arg(2));if(src.len<0){return 13;}let h:[]u8=np_hash(src);if(h.len!=64){return 14;}_zag_println(h);return 0;}
    if(_zag_argc()!=4){_zag_eprintln("usage: project ABSOLUTE_ROOT OUTPUT PROVENANCE");return 2;}
    let path:[]u8=np_norm(_zag_arg(1));if(path.len==0){return 3;}
    if(@strEq(path,np_norm(_zag_arg(2))) || @strEq(path,np_norm(_zag_arg(3))) || @strEq(_zag_arg(2),_zag_arg(3))){return 4;}
    let p:NP=NP{.files=_zag_malloc(8192) as *NPFile,.count=0,.out="",.log="NP_V1\n",.error=0};if(p.files==null as *NPFile){return 5;}
    np_log(&p,_zag_str_concat("TOOL_SHA256\t",_zag_str_concat(np_hash(_zag_read_file(_zag_arg(0))),"\n")));
    let rc:i32=np_load(&p,path,0);if(rc!=0){_zag_eprintln(_zag_str_concat("projection refused: ",_zag_i64_to_str(rc as i64)));return rc;}
    let k:i32=0;while(k<p.count){if(@strEq(p.files[k].path,np_norm(_zag_arg(2))) || @strEq(p.files[k].path,np_norm(_zag_arg(3)))){return 4;}k=k+1;}
    np_log(&p,_zag_str_concat("OUTPUT_SHA256\t",_zag_str_concat(np_hash(p.out),"\n")));
    if(np_publish(_zag_arg(2),p.out)!=0){return 21;}
    if(np_publish(_zag_arg(3),p.log)!=0){return 22;}return 0;
}

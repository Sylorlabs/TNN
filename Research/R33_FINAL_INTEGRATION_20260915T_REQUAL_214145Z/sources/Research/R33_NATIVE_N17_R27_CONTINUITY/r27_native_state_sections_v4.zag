// R33 N17 native R27 mutable-state section codec V2.
// Engineering migration substrate only. No learner behavior, evaluator labels,
// scientific hidden state, or historical Python execution.
//
// Every mutable learner surface is serialized as its own little-endian i32
// section. The outer continuing-life checkpoint owns whole-checkpoint hashing,
// predecessor binding, world state, observation ingress, and delayed-credit
// atomicity. This codec only guarantees exact learner-array round trips.

const R27S4_MAGIC:i32=1396126290; // "R27S" little-endian bytes: 52 32 37 53
const R27S4_VERSION:i32=4;
const R27S4_HEADER_BYTES:i32=16;

const R27S4_MEMORY_WEIGHTS:i32=1;
const R27S4_PAM_OPS:i32=2;
const R27S4_PAM_PARAMS:i32=3;
const R27S4_PAM_LEN:i32=4;
const R27S4_PAM_STATUS:i32=5;
const R27S4_PAM_PARENT:i32=6;
const R27S4_PAM_COUNT:i32=7;
const R27S4_FOUNDRY_OP_WEIGHTS:i32=8;
const R27S4_ENTITY_CENTROIDS:i32=9;
const R27S4_ENTITY_COUNTS:i32=10;
const R27S4_ENTITY_CONTINUITY:i32=11;
const R27S4_ENTITY_PERSISTENCE_BIAS:i32=12;
const R27S4_EFFECT_SUM:i32=13;
const R27S4_EFFECT_N:i32=14;
const R27S4_ACOUSTIC_TEMPLATES:i32=15;
const R27S4_ACOUSTIC_DURATION_MEAN:i32=16;
const R27S4_ACOUSTIC_MOTIF_COUNT:i32=17;
const R27S4_NAME_MOTIFS:i32=18;
const R27S4_NAME_ENTITIES:i32=19;
const R27S4_NAME_CONFIDENCE:i32=20;
const R27S4_NAME_COUNT:i32=21;
const R27S4_TRACE_STEP:i32=22;
const R27S4_TRACE_STAGE:i32=23;
const R27S4_TRACE_REASON:i32=24;
const R27S4_TRACE_SUBJECT:i32=25;
const R27S4_TRACE_EVIDENCE:i32=26;
const R27S4_TRACE_CONFIDENCE:i32=27;
const R27S4_TRACE_PARENT:i32=28;
const R27S4_TRACE_COUNT:i32=29;
const R27S4_DEVELOPMENT_STEP:i32=30;
const R27S4_RNG_PCG64:i32=31;
// Pending delayed credit is learner-owned causal state. It is serialized in
// the same learner image so process death cannot detach a later consequence
// from the action/trace event that caused it.
const R27S4_PENDING_CREDIT:i32=32;
const R27S4_NEWBORN_RESTARTS:i32=33;
const R27S4_PENDING_FIELDS:i32=8;
const R27S4_RNG_FIELDS:i32=19;

// Cross-file users call these accessors instead of reading imported constants
// directly. The local Zag compiler does not currently preserve imported const
// values reliably across module boundaries, while function return values are
// stable and keep this wire contract single-sourced here.
fn r27s4_magic_value()i32 @noalloc {return R27S4_MAGIC;}
fn r27s4_version_value()i32 @noalloc {return R27S4_VERSION;}
fn r27s4_pending_credit_id()i32 @noalloc {return R27S4_PENDING_CREDIT;}

fn r27s4_expected_count(id:i32)i32 @noalloc {
    if(id==R27S4_MEMORY_WEIGHTS){return 48;}
    if(id==R27S4_PAM_OPS || id==R27S4_PAM_PARAMS){return 512;}
    if(id==R27S4_PAM_LEN || id==R27S4_PAM_STATUS || id==R27S4_PAM_PARENT){return 32;}
    if(id==R27S4_PAM_COUNT){return 1;}
    if(id==R27S4_FOUNDRY_OP_WEIGHTS){return 60;}
    if(id==R27S4_ENTITY_CENTROIDS){return 512;}
    if(id==R27S4_ENTITY_COUNTS || id==R27S4_ENTITY_CONTINUITY || id==R27S4_ENTITY_PERSISTENCE_BIAS){return 64;}
    if(id==R27S4_EFFECT_SUM || id==R27S4_EFFECT_N){return 512;}
    if(id==R27S4_ACOUSTIC_TEMPLATES){return 384;}
    if(id==R27S4_ACOUSTIC_DURATION_MEAN){return 32;}
    if(id==R27S4_ACOUSTIC_MOTIF_COUNT){return 1;}
    if(id==R27S4_NAME_MOTIFS || id==R27S4_NAME_ENTITIES || id==R27S4_NAME_CONFIDENCE){return 128;}
    if(id==R27S4_NAME_COUNT){return 1;}
    if(id>=R27S4_TRACE_STEP && id<=R27S4_TRACE_PARENT){return 8192;}
    if(id==R27S4_TRACE_COUNT || id==R27S4_DEVELOPMENT_STEP || id==R27S4_NEWBORN_RESTARTS){return 1;}
    if(id==R27S4_RNG_PCG64){return R27S4_RNG_FIELDS;}
    if(id==R27S4_PENDING_CREDIT){return R27S4_PENDING_FIELDS;}
    return -1;
}

fn r27s4_section_bytes(id:i32)i32 @noalloc {
    let n:i32=r27s4_expected_count(id);if(n<0){return -1;}
    return R27S4_HEADER_BYTES+n*4;
}

fn r27s4_put_i32(out:[]u8,at:i32,v:i32)i32 @noalloc {
    if(at<0 || at>out.len-4){return -1;}
    out[at]=(v & 255) as u8;
    out[at+1]=((v>>8) & 255) as u8;
    out[at+2]=((v>>16) & 255) as u8;
    out[at+3]=((v>>24) & 255) as u8;
    return 0;
}

fn r27s4_get_i32(input:[]u8,at:i32,out:*i32)i32 @noalloc {
    if(out==null as *i32 || at<0 || at>input.len-4){return -1;}
    let u:i64=(input[at] as i64)+((input[at+1] as i64)<<8)+((input[at+2] as i64)<<16)+((input[at+3] as i64)<<24);
    if(u>=2147483648){out.*=(u-4294967296) as i32;}else{out.*=u as i32;}
    return 0;
}

fn r27s4_encode_i32_section(out:[]u8,id:i32,values:[]i32)i32 @noalloc {
    let expected:i32=r27s4_expected_count(id);
    if(expected<0 || values.len!=expected || out.len!=R27S4_HEADER_BYTES+expected*4){return -1;}
    if(r27s4_put_i32(out,0,R27S4_MAGIC)!=0 || r27s4_put_i32(out,4,R27S4_VERSION)!=0 ||
       r27s4_put_i32(out,8,id)!=0 || r27s4_put_i32(out,12,expected)!=0){return -1;}
    let i:i32=0;while(i<expected){if(r27s4_put_i32(out,R27S4_HEADER_BYTES+i*4,values[i])!=0){return -1;}i=i+1;}
    return 0;
}

fn r27s4_decode_i32_section(input:[]u8,id:i32,out:[]i32)i32 @noalloc {
    let expected:i32=r27s4_expected_count(id);if(expected<0 || out.len!=expected || input.len!=R27S4_HEADER_BYTES+expected*4){return -1;}
    let magic:i32=0;let version:i32=0;let got_id:i32=0;let got_count:i32=0;
    if(r27s4_get_i32(input,0,&magic)!=0 || r27s4_get_i32(input,4,&version)!=0 ||
       r27s4_get_i32(input,8,&got_id)!=0 || r27s4_get_i32(input,12,&got_count)!=0){return -1;}
    if(magic!=R27S4_MAGIC || version!=R27S4_VERSION || got_id!=id || got_count!=expected){return -1;}
    let i:i32=0;while(i<expected){if(r27s4_get_i32(input,R27S4_HEADER_BYTES+i*4,&out[i])!=0){return -1;}i=i+1;}
    return 0;
}

fn r27s4_count_valid(id:i32,count:i32)i32 @noalloc {
    if(id==R27S4_PAM_COUNT){return (count>=0 && count<=32) as i32;}
    if(id==R27S4_ACOUSTIC_MOTIF_COUNT){return (count>=0 && count<=32) as i32;}
    if(id==R27S4_NAME_COUNT){return (count>=0 && count<=128) as i32;}
    if(id==R27S4_TRACE_COUNT){return (count>=0 && count<=8192) as i32;}
    if(id==R27S4_DEVELOPMENT_STEP || id==R27S4_NEWBORN_RESTARTS){return (count>=0) as i32;}
    return 1;
}

fn r27s4_validate_scalar_section(input:[]u8,id:i32)i32 @noalloc {
    if(r27s4_expected_count(id)!=1 || input.len!=R27S4_HEADER_BYTES+4){return -1;}
    let magic:i32=0;let version:i32=0;let got_id:i32=0;let got_count:i32=0;let value:i32=0;
    if(r27s4_get_i32(input,0,&magic)!=0 || r27s4_get_i32(input,4,&version)!=0 ||
       r27s4_get_i32(input,8,&got_id)!=0 || r27s4_get_i32(input,12,&got_count)!=0 ||
       r27s4_get_i32(input,R27S4_HEADER_BYTES,&value)!=0){return -1;}
    if(magic!=R27S4_MAGIC || version!=R27S4_VERSION || got_id!=id || got_count!=1){return -1;}
    if(r27s4_count_valid(id,value)==1){return 0;}return -1;
}

// Pending fields:
// [active, cause_trace_event, action, entity, issued_world_step,
//  due_world_step, observation_sequence, update_token].
// -1 is the explicit missing sentinel for optional causal identifiers.
fn r27s4_validate_pending_credit(input:[]u8)i32 @noalloc {
    if(input.len!=r27s4_section_bytes(R27S4_PENDING_CREDIT)){return -1;}
    let magic:i32=0;let version:i32=0;let got_id:i32=0;let got_count:i32=0;
    if(r27s4_get_i32(input,0,&magic)!=0 || r27s4_get_i32(input,4,&version)!=0 ||
       r27s4_get_i32(input,8,&got_id)!=0 || r27s4_get_i32(input,12,&got_count)!=0){return -1;}
    if(magic!=R27S4_MAGIC || version!=R27S4_VERSION || got_id!=R27S4_PENDING_CREDIT || got_count!=R27S4_PENDING_FIELDS){return -1;}
    let active:i32=0;let trace:i32=0;let action:i32=0;let entity:i32=0;
    let issued:i32=0;let due:i32=0;let obs:i32=0;let token:i32=0;
    if(r27s4_get_i32(input,16,&active)!=0 || r27s4_get_i32(input,20,&trace)!=0 ||
       r27s4_get_i32(input,24,&action)!=0 || r27s4_get_i32(input,28,&entity)!=0 ||
       r27s4_get_i32(input,32,&issued)!=0 || r27s4_get_i32(input,36,&due)!=0 ||
       r27s4_get_i32(input,40,&obs)!=0 || r27s4_get_i32(input,44,&token)!=0){return -1;}
    if(active<0 || active>1 || trace < -1 || action < -1 || action>=8 || entity < -1 || entity>=64 ||
       issued < -1 || due < -1 || obs < -1 || token < -1){return -1;}
    if(active==1 && (trace<0 || action<0 || issued<0 || due<issued || obs<0 || token<0)){return -1;}
    return 0;
}

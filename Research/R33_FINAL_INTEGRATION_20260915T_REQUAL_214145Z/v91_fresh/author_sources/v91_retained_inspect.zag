@import("../identity.zag")
fn vi_hash(b:[]u8)[]u8 {let h:[]u8=nio_alloc(32);if(ns_sha256(b,h)!=0){return "";}return ns_hex(h);}
fn vi_num(x:i64)void {_zag_print(_zag_i64_to_str(x));}
fn vi_dump(p:*ParentMap,id:i32,label:[]u8,depth:i32)void {
 let target:i32=id;if(pm_kind(p,id)==15||pm_kind(p,id)==16){let s:i32=pm_build_state(p,id);if(s>0){target=s;}}
 _zag_print("NODE,");_zag_print(label);_zag_print(",");vi_num(id as i64);_zag_print(",kind=");vi_num(pm_kind(p,id) as i64);_zag_println("");
 let kind:i32=pm_kind(p,target);if(kind==6||kind==7){_zag_print("RAW,");_zag_print(label);_zag_print(",");_zag_println(pm_raw(p,target));return;}
 if(depth<=0||kind!=11){return;}let e:i32=p.*.nodes[(target-1)*10+7] as i32;let n:i32=0;
 while(e>0&&n<128){let at:i32=(e-1)*4;let key:i32=p.*.edges[at] as i32;let val:i32=p.*.edges[at+1] as i32;let name:[]u8=pm_raw(p,key);let path:[]u8=_zag_str_concat(_zag_str_concat(label,"."),name);vi_dump(p,val,path,depth-1);e=p.*.edges[at+2] as i32;n=n+1;}
}
fn main()i32 {let binding:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),binding);if(p.status!=0||n17_identity(&p)!=0){return 3;}
 let r25:i32=pm_lookup(&p,pm_lookup(&p,p.root,"base_state"),"base_state");let r24:i32=pm_lookup(&p,r25,"r24_state");vi_dump(&p,r24,"r24",3);let sg:i32=pm_lookup(&p,p.root,"semantic_generator");let model:i32=pm_lookup(&p,sg,"model");vi_dump(&p,pm_lookup(&p,model,"_modules"),"modules",3);mi_loaded_close(&p);return 0;}

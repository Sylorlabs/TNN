        v.*.buffer==expected.buffer && v.*.kind==expected.kind && v.*.width==expected.width && v.*.count==expected.count &&
        v.*.blob_at==expected.blob_at && v.*.blob_bytes==expected.blob_bytes && v.*.at==expected.at && v.*.bytes==expected.bytes &&
        v.*.key_at==expected.key_at && v.*.key_len==expected.key_len && v.*.offset==expected.offset &&
        v.*.rank==expected.rank && v.*.elements==expected.elements && v.*.tensor_grad==expected.tensor_grad && v.*.grad==expected.grad) as i32;
    let i:i32=0;while(i<8){if(v.*.dims[i]!=expected.dims[i] || v.*.strides[i]!=expected.strides[i]){ok=0;}i=i+1;}
    ts_close(&expected);if(ok!=1){return -9108;}return 0;
}
fn ts_at(p:*ParentMap,v:*TsView,coordinates:[]i64,w:*TsWork)i64 {
    if(ts_charge(&w.*.probes,w.*.max_probes,1)!=0){return -9111;}
    let code:i32=ts_bound(p,v,w);if(code!=0){return code;}
    if(coordinates.len!=v.*.rank || v.*.elements==0){return -9105;}
    let at:i64=v.*.offset;let i:i32=0;while(i<v.*.rank){
        if(coordinates[i]<0 || coordinates[i]>=v.*.dims[i]){return -9105;}
        at=at+coordinates[i]*v.*.strides[i];i=i+1;}
    if(at<0 || at>=v.*.count){return -9105;}return at;
}
fn ts_bits(p:*ParentMap,v:*TsView,coordinates:[]i64,w:*TsWork)NvBits {
    let bits:NvBits=NvBits{.status=-9105,.low=0,.high=0};let at:i64=ts_at(p,v,coordinates,w);
    if(at<0){bits.status=at as i32;return bits;}let begin:i32=v.*.at+(at as i32)*v.*.width;let factor:i64=1;let i:i32=0;
    while(i<v.*.width){if(i==4){factor=1;}let x:i64=p.*.input[begin+i] as i64;
        if(i<4){bits.low=bits.low+x*factor;}else{bits.high=bits.high+x*factor;}factor=factor*256;i=i+1;}

        if(nv_tuple_size(p,args)<1){pm_free_words(keys);pm_free_words(vals);return -64;}let doc:i32=nv_item(p,args,0);let dk:[]i64=pm_words(128);let dv:[]i64=pm_words(128);
        if(dk.len!=128 || dv.len!=128){pm_free_words(dk);pm_free_words(dv);pm_free_words(keys);pm_free_words(vals);return -65;}let dn:i32=r26_collect(p,doc,dk,dv);

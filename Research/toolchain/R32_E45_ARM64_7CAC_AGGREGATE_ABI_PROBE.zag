struct AggregateContext {
    a: []i32,
    b: []i32,
    c: []i32,
    d: []i32,
    e: []i32,
    f: []i32,
    g: []i32,
    h: []i32,
    i: []i32,
    accumulator: *i32,
    mirror: *i32,
    base: i32,
}

fn probe_by_value(
    context: AggregateContext,
    p1: i32,
    p2: i32,
    p3: i32,
    p4: i32,
    p5: i32,
    p6: i32,
    p7: i32
) i32 {
    context.a[0] = context.base + p1 + p2;
    context.b[1] = context.base + p3 + p4;
    context.c[2] = context.base + p5 + p6 + p7;
    context.i[3] = context.base + p7;
    context.accumulator.* = context.a[0] + context.b[1] + context.c[2] + context.i[3];
    return context.accumulator.*;
}

fn probe_by_pointer(
    context: *AggregateContext,
    p1: i32,
    p2: i32,
    p3: i32,
    p4: i32,
    p5: i32,
    p6: i32,
    p7: i32
) i32 {
    let value: i32 = context.*.a[0] + context.*.h[1] + context.*.c[2] + context.*.i[3] +
        p1 + p2 + p3 + p4 + p5 + p6 + p7;
    context.*.a[3] = value;
    context.*.mirror.* = value + context.*.base;
    return value + context.*.a[3] + context.*.mirror.*;
}

fn main() i32 {
    let a: []i32 = zalloc_i(4);
    let b: []i32 = zalloc_i(4);
    let c: []i32 = zalloc_i(4);
    let accumulator: i32 = 0;
    let mirror: i32 = 0;
    let context: AggregateContext = AggregateContext{
        .a = a,
        .b = b,
        .c = c,
        .d = a,
        .e = b,
        .f = c,
        .g = a,
        .h = b,
        .i = c,
        .accumulator = &accumulator,
        .mirror = &mirror,
        .base = 100,
    };
    let value_result: i32 = probe_by_value(context, 1, 2, 3, 4, 5, 6, 7);
    let pointer_result: i32 = probe_by_pointer(&context, 8, 9, 10, 11, 12, 13, 14);
    let checksum: i32 = value_result + pointer_result + a[0] + b[1] + c[2] +
        a[3] + accumulator + mirror + c[3];
    _zag_println(_zag_i64_to_str(checksum as i64));
    zfree(a);
    zfree(b);
    zfree(c);
    if (checksum == 4065) {
        return 0;
    }
    return 1;
}

@import("r34_continuing_envelope_v1.zag")
fn r34e1_eq_for_test(a:[]u8,b:[]u8)i32 @noalloc {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn main()i32 {
 let f:i32=0;let side:[]u8=new u8(R34NS1_BYTES);if(r34ns1_init(side)!=0){f=f+1;}let r33:[]u8=new u8(97);let i:i32=0;while(i<r33.len){r33[i]=((i*17+3)&255) as u8;i=i+1;}
 let out:[]u8=new u8(r34e1_expected_bytes(r33.len));let n:i32=r34e1_pack(out,7,r33,side);if(n!=out.len||r34e1_check(out,7)!=0){f=f+1;}
 if(r34e1_r33(out).len!=r33.len||r34e1_sidecar(out).len!=R34NS1_BYTES||r34e1_eq_for_test(r34e1_r33(out),r33)!=1||r34ns1_eq(r34e1_sidecar(out),side)!=1){f=f+1;}
 let bad:[]u8=new u8(out.len);r34e1_copy(bad,out);let at:i32=R34E1_HEADER_BYTES+r33.len+R34NS1_HEADER_BYTES+8;bad[at]=bad[at]^1;if(r34e1_reseal_outer(bad)!=0||r34e1_check(bad,7)!=R34E1_SIDECAR){f=f+1;}
 if(r34e1_check(out[0..out.len/2],7)==0||r34e1_learn_authority(out)!=0){f=f+1;}
 _zag_print("R34_CONTINUING_ENVELOPE_V1_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));return (f!=0) as i32;
}

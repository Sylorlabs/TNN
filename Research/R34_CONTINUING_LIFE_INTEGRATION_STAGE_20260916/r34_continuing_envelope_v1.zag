@import("r34_native_sidecar_v1.zag")

// R34 additive continuing envelope V1.
// Embeds one complete, independently validated R33 outer checkpoint plus one
// independently hashed R34 sidecar. The R33 transaction bytes are not changed.

const R34E1_MAGIC:i32=1161048914; // "R34E" little-endian
const R34E1_VERSION:i32=1;
const R34E1_HEADER_BYTES:i32=64;
const R34E1_DIGEST_AT:i32=32;
const R34E1_OK:i32=0;
const R34E1_SHAPE:i32=-341101;
const R34E1_HEADER:i32=-341102;
const R34E1_DIGEST:i32=-341103;
const R34E1_SIDECAR:i32=-341104;

fn r34e1_copy(dst:[]u8,src:[]u8)i32 @noalloc {if(dst.len!=src.len){return R34E1_SHAPE;}let i:i32=0;while(i<src.len){dst[i]=src[i];i=i+1;}return R34E1_OK;}
fn r34e1_expected_bytes(r33_bytes:i32)i32 @noalloc {if(r33_bytes<1){return -1;}return R34E1_HEADER_BYTES+r33_bytes+R34NS1_BYTES;}

fn r34e1_reseal_outer(packet:[]u8)i32 {
    if(packet.len<R34E1_HEADER_BYTES+R34NS1_BYTES+1){return R34E1_SHAPE;}let d:[]u8=new u8(32);if(ns_sha256(packet[R34E1_HEADER_BYTES..packet.len],d)!=0){return R34E1_DIGEST;}let i:i32=0;while(i<32){packet[R34E1_DIGEST_AT+i]=d[i];i=i+1;}return R34E1_OK;
}

fn r34e1_pack(out:[]u8,sequence:i32,r33_checkpoint:[]u8,sidecar:[]u8)i32 {
    let total:i32=r34e1_expected_bytes(r33_checkpoint.len);if(total<1||out.len<total||sequence<1||r34ns1_check(sidecar)!=R34NS1_OK){return R34E1_SHAPE;}
    let i:i32=0;while(i<total){out[i]=0;i=i+1;}
    if(r34ns1_put_i32(out,0,R34E1_MAGIC)!=0||r34ns1_put_i32(out,4,R34E1_VERSION)!=0||r34ns1_put_i32(out,8,sequence)!=0||r34ns1_put_i32(out,12,r33_checkpoint.len)!=0||r34ns1_put_i32(out,16,R34NS1_BYTES)!=0||r34ns1_put_i32(out,20,total)!=0||r34ns1_put_i32(out,24,0)!=0||r34ns1_put_i32(out,28,0)!=0){return R34E1_HEADER;}
    if(r34e1_copy(out[R34E1_HEADER_BYTES..R34E1_HEADER_BYTES+r33_checkpoint.len],r33_checkpoint)!=0||r34e1_copy(out[R34E1_HEADER_BYTES+r33_checkpoint.len..total],sidecar)!=0){return R34E1_SHAPE;}
    if(r34e1_reseal_outer(out[0..total])!=0){return R34E1_DIGEST;}return total;
}

fn r34e1_check(packet:[]u8,sequence:i32)i32 {
    if(packet.len<R34E1_HEADER_BYTES+R34NS1_BYTES+1){return R34E1_SHAPE;}let magic:i32=0;let version:i32=0;let seq:i32=0;let r33n:i32=0;let sn:i32=0;let total:i32=0;let r0:i32=0;let r1:i32=0;
    if(r34ns1_get_i32(packet,0,&magic)!=0||r34ns1_get_i32(packet,4,&version)!=0||r34ns1_get_i32(packet,8,&seq)!=0||r34ns1_get_i32(packet,12,&r33n)!=0||r34ns1_get_i32(packet,16,&sn)!=0||r34ns1_get_i32(packet,20,&total)!=0||r34ns1_get_i32(packet,24,&r0)!=0||r34ns1_get_i32(packet,28,&r1)!=0){return R34E1_HEADER;}
    if(magic!=R34E1_MAGIC||version!=R34E1_VERSION||seq!=sequence||r33n<1||sn!=R34NS1_BYTES||total!=packet.len||total!=R34E1_HEADER_BYTES+r33n+sn||r0!=0||r1!=0){return R34E1_HEADER;}
    let d:[]u8=new u8(32);if(ns_sha256(packet[R34E1_HEADER_BYTES..packet.len],d)!=0){return R34E1_DIGEST;}let i:i32=0;while(i<32){if(d[i]!=packet[R34E1_DIGEST_AT+i]){return R34E1_DIGEST;}i=i+1;}
    let side:[]u8=packet[R34E1_HEADER_BYTES+r33n..packet.len];if(r34ns1_check(side)!=R34NS1_OK){return R34E1_SIDECAR;}return R34E1_OK;
}

fn r34e1_r33(packet:[]u8)[]u8 @noalloc {let n:i32=0;if(r34ns1_get_i32(packet,12,&n)!=0||n<1||R34E1_HEADER_BYTES+n>packet.len){return "";}return packet[R34E1_HEADER_BYTES..R34E1_HEADER_BYTES+n];}
fn r34e1_sidecar(packet:[]u8)[]u8 @noalloc {let n:i32=0;if(r34ns1_get_i32(packet,12,&n)!=0||n<1||R34E1_HEADER_BYTES+n+R34NS1_BYTES!=packet.len){return "";}return packet[R34E1_HEADER_BYTES+n..packet.len];}
fn r34e1_learn_authority(packet:[]u8)i32 @noalloc {return 0;}

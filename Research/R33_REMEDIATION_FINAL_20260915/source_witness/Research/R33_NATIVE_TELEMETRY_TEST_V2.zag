fn tt_anchor_capacity()i32 {
    let s:[]i32=tt_state(40);let e:[]i32=zalloc_i(TTM_EVENT);let out:[]i32=zalloc_i(TTM_SNAPSHOT);
    let failed:i32=tt_start(s,40);let i:i32=0;
    while(i<16){
        let reference:i32=s[3];
        tt_event(s,e,TTM_ASSESS,500+i,600+i,100+i);e[TTE_OUTCOME]=1;
        failed=failed+tt_ok(s,e,"anchor_capacity.baseline");
        tt_event(s,e,TTM_ANCHOR,500+i,600+i,100+i);e[TTE_ANCHOR_REF]=reference;
        failed=failed+tt_ok(s,e,"anchor_capacity.enroll");i=i+1;
    }
    tt_event(s,e,TTM_ASSESS,516,616,116);e[TTE_OUTCOME]=1;
    failed=failed+tt_ok(s,e,"anchor_capacity.seventeenth_success");
    tt_event(s,e,TTM_ANCHOR,516,616,116);e[TTE_ANCHOR_REF]=32;
    failed=failed+tt_refuse(s,e,-2,"anchor_capacity.plus_one_unchanged");
    tt_event(s,e,TTM_RETENTION,0,0,0);e[TTE_PANEL]=1;i=0;
    while(i<16){e[TTE_RESULTS+i]=0;i=i+1;}
    failed=failed+tt_ok(s,e,"anchor_capacity.full_panel");
    failed=failed+tt_assert("anchor_capacity.snapshot",0,tm_snapshot(s,out));
    failed=failed+tt_row(out,TTM_ANCHOR_COUNT,16,2,"anchor_capacity.denominator");
    failed=failed+tt_row(out,TTM_FINAL_LOST,16,2,"anchor_capacity.all_lost");
    failed=failed+tt_row(out,TTM_WORST_LOST,16,2,"anchor_capacity.worst");
    zfree(s);zfree(e);zfree(out);return failed;
}

fn tt_atomicity_and_reconstruction()i32 {
    let s:[]i32=tt_state(4);let e:[]i32=zalloc_i(TTM_EVENT);let out:[]i32=zalloc_i(TTM_SNAPSHOT);
    let failed:i32=tt_start(s,4);

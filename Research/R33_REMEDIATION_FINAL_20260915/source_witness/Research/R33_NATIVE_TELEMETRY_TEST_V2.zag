    failed=failed+tt_assert("alias.snapshot_unchanged",0,tt_diff(s,before));
    failed=failed+tt_assert("alias.event_at",-4,tm_event_at(s,0,s[16..104]));
    failed=failed+tt_assert("alias.event_at_unchanged",0,tt_diff(s,before));
    tt_fill(out,-777);let untouched:[]i32=zalloc_i(out.len);tt_copy(out,untouched);
    failed=failed+tt_assert("snapshot.bad_capacity",-1,tm_snapshot(s,out[0..167]));
    failed=failed+tt_assert("snapshot.refusal_output_unchanged",0,tt_diff(out,untouched));
    s[TTM_HEADER+TTE_PARENT]=3;tt_event(s,e,TTM_EXPOSURE,2,2,2);
    failed=failed+tt_refuse(s,e,-5,"history.corrupt_parent");
    failed=failed+tt_assert("snapshot.corrupt_history",-5,tm_snapshot(s,out));
    failed=failed+tt_assert("snapshot.invalid_unchanged",0,tt_diff(out,untouched));
    s[TTM_HEADER+TTE_PARENT]=-1;
    let restored:[]i32=tt_state(4);failed=failed+tt_start(restored,4);
    failed=failed+tt_assert("reconstruct.event_read",0,tm_event_at(s,0,e));
    failed=failed+tt_ok(restored,e,"reconstruct.append_original_record");
    failed=failed+tt_assert("reconstruct.entire_state_equal",0,tt_diff(s,restored));
    failed=failed+tt_refuse(restored,e,-3,"reconstruct.duplicate_delivery");
    tt_fill(e,-777);let old_event:[]i32=zalloc_i(e.len);tt_copy(e,old_event);
    failed=failed+tt_assert("event_at.missing",-3,tm_event_at(s,1,e));
    failed=failed+tt_assert("event_at.missing_output_unchanged",0,tt_diff(e,old_event));
    zfree(s);zfree(e);zfree(out);zfree(rate);zfree(before);zfree(untouched);zfree(restored);zfree(old_event);
    let maximum:[]i32=tt_state(128);e=zalloc_i(TTM_EVENT);out=zalloc_i(TTM_SNAPSHOT);
    failed=failed+tt_start(maximum,128);let i:i32=0;
    while(i<128){tt_event(maximum,e,TTM_EXPOSURE,1000+i,2000+i,1+i);failed=failed+tt_ok(maximum,e,"capacity.accept_to_bound");i=i+1;}
    tt_event(maximum,e,TTM_EXPOSURE,3000,4000,200);failed=failed+tt_refuse(maximum,e,-2,"capacity.plus_one_unchanged");
    failed=failed+tt_assert("capacity.snapshot",0,tm_snapshot(maximum,out));
    failed=failed+tt_row(out,TTM_EVENTS,128,2,"capacity.all_events_retained");
    failed=failed+tt_row(out,TTM_UNIQUE,128,2,"capacity.no_dropped_exposure");
    zfree(maximum);zfree(e);zfree(out);return failed;
}

fn tt_request_refusal()i32 {

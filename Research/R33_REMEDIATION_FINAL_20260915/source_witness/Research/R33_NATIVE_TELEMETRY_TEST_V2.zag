    let rate:[]i32=zalloc_i(4);failed=failed+tt_assert("zero_denominator.rate",0,tm_rate(out,TTM_FRESH_SUCCESSES,TTM_FRESH_SCORED,rate));
    failed=failed+tt_assert("zero_denominator.not_measured",0,rate[0]);

// Native telemetry V2 engineering controls; never learner training.
// ABI values below are local literal test definitions, not imported numeric consts.
@import("R33_NATIVE_TELEMETRY_V2.zag")

const TTM_HEADER:i32=16;
const TTM_EVENT:i32=88;
const TTM_LIMIT:i32=128;
const TTM_ANCHORS:i32=16;
const TTM_METRICS:i32=56;
const TTM_SNAPSHOT:i32=168;
const TTM_CHARGE_LIMIT:i32=10000000;
const TTM_EXPOSURE:i32=1;
const TTM_HELP:i32=2;
const TTM_ASSESS:i32=3;
const TTM_ANCHOR:i32=4;
const TTM_RETENTION:i32=5;
const TTM_RETRIEVAL:i32=6;
const TTM_UPDATE:i32=7;
const TTM_RESOURCE:i32=8;
const TTE_VERSION:i32=0;
const TTE_ID:i32=1;
const TTE_ORDINAL:i32=2;
const TTE_PARENT:i32=3;
const TTE_CAUSE:i32=4;
const TTE_EXPERIMENT:i32=5;
const TTE_BRAIN:i32=6;
const TTE_BRANCH:i32=7;
const TTE_COMPETENCY:i32=8;
const TTE_CLOCK:i32=9;
const TTE_TICK:i32=10;
const TTE_KIND:i32=11;
const TTE_EPISODE:i32=12;
const TTE_EXPERIENCE:i32=13;
const TTE_ACTOR_KIND:i32=14;
const TTE_ACTOR:i32=15;
const TTE_DELEGATING_HUMAN:i32=16;
const TTE_ASSISTED:i32=17;
const TTE_OUTCOME:i32=18;
const TTE_MODE:i32=19;
const TTE_REQUESTED:i32=20;
const TTE_HELP_RESULT:i32=21;
const TTE_HUMAN:i32=22;
const TTE_SOFTWARE:i32=23;
const TTE_HELP_DOSE:i32=24;
const TTE_FOUND:i32=25;
const TTE_USEFUL:i32=26;
const TTE_PROPOSED:i32=27;
const TTE_ACCEPTED:i32=28;
const TTE_REJECTED:i32=29;
const TTE_ROLLED_BACK:i32=30;
const TTE_OPERATIONS:i32=31;
const TTE_IO_BYTES:i32=32;
const TTE_CPU_US:i32=33;
const TTE_WALL_US:i32=34;
const TTE_LOGICAL_BYTES:i32=35;
const TTE_PEAK_RSS:i32=36;
const TTE_ANCHOR_REF:i32=37;
const TTE_INTERFERING_COMPETENCY:i32=38;
const TTE_PANEL:i32=39;
const TTE_PAYLOAD:i32=40;
const TTE_RESULTS:i32=72;
const TTM_EVENTS:i32=0;
const TTM_EXPOSURES:i32=1;
const TTM_UNIQUE:i32=2;
const TTM_REPLAYS:i32=3;
const TTM_ASSISTED_EXPOSURES:i32=4;
const TTM_UNKNOWN_EXPOSURE_HELP:i32=5;
const TTM_HELP_REQUESTS:i32=6;
const TTM_HELP_ACCEPTED:i32=7;
const TTM_HELP_REFUSED:i32=8;
const TTM_HUMAN_INTERVENTIONS:i32=9;
const TTM_SOFTWARE_INTERVENTIONS:i32=10;
const TTM_HELP_DOSE_TOTAL:i32=11;
const TTM_FRESH_TOTAL:i32=12;
const TTM_FRESH_SCORED:i32=13;
const TTM_FRESH_SUCCESSES:i32=14;
const TTM_FRESH_UNASSISTED_N:i32=15;
const TTM_FRESH_UNASSISTED_OK:i32=16;
const TTM_FRESH_ASSISTED_N:i32=17;
const TTM_FRESH_ASSISTED_OK:i32=18;
const TTM_FRESH_UNKNOWN_OUTCOME:i32=19;
const TTM_FRESH_UNKNOWN_HELP:i32=20;
const TTM_CORRECT_UNKNOWN:i32=21;
const TTM_WRONG_UNKNOWN:i32=22;
const TTM_ANCHOR_COUNT:i32=23;
const TTM_PANEL_COUNT:i32=24;
const TTM_FINAL_LOST:i32=25;
const TTM_EVER_LOST:i32=26;
const TTM_WORST_LOST:i32=27;
const TTM_NEW_LOSSES:i32=28;
const TTM_RESCUES:i32=29;
const TTM_INTERFERENCE_LOSSES:i32=30;
const TTM_INTERFERENCE_RESCUES:i32=31;
const TTM_RETRIEVAL_ATTEMPTS:i32=32;
const TTM_RETRIEVAL_FOUND:i32=33;
const TTM_RETRIEVAL_USEFUL:i32=34;
const TTM_FOUND_UNKNOWN:i32=35;
const TTM_USEFUL_UNKNOWN:i32=36;
const TTM_PROPOSALS:i32=37;
const TTM_ACCEPTED_UPDATES:i32=38;
const TTM_REJECTED_UPDATES:i32=39;
const TTM_ROLLED_BACK_UPDATES:i32=40;
const TTM_RESOURCE_RECORDS:i32=41;
const TTM_OPERATIONS:i32=42;
const TTM_IO_BYTES:i32=43;
const TTM_CPU_US:i32=44;
const TTM_WALL_US:i32=45;
const TTM_PEAK_RSS:i32=46;
const TTM_LOGICAL_PEAK:i32=47;
const TTM_CHARGED_EVENTS:i32=48;
const TTM_UNCHARGED_EVENTS:i32=49;
const TTM_UNDERSTANDING:i32=50;
const TTM_TEACHER_COMPETENCE:i32=51;
const TTM_TRANSFER:i32=52;
const TTM_CALIBRATION:i32=53;
const TTM_COMPLETE_CPU_US:i32=54;
const TTM_COMPLETE_OPERATIONS:i32=55;

fn tt_assert(name:[]u8,expected:i32,actual:i32)i32 {
    _zag_print("ASSERT,");_zag_print(name);_zag_print(",expected,");
    _zag_print(_zag_i64_to_str(expected as i64));_zag_print(",actual,");
    _zag_print(_zag_i64_to_str(actual as i64));_zag_print(",match,");
    _zag_println(_zag_i64_to_str((expected==actual) as i64));
    if(expected!=actual){return 1;}return 0;
}
fn tt_fill(a:[]i32,value:i32)void {let i:i32=0;while(i<a.len){a[i]=value;i=i+1;}}
fn tt_copy(a:[]i32,b:[]i32)void {let i:i32=0;while(i<a.len){b[i]=a[i];i=i+1;}}
fn tt_diff(a:[]i32,b:[]i32)i32 {
    if(a.len!=b.len){return 1;}let count:i32=0;let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){count=count+1;}i=i+1;}return count;
}
fn tt_state(capacity:i32)[]i32 {
    if(capacity<0 || capacity>128 || TTM_HEADER!=16 || TTM_EVENT!=88){_zag_exit(70);}
    let s:[]i32=zalloc_i(TTM_HEADER+capacity*TTM_EVENT);tt_fill(s,0);return s;
}
fn tt_start(s:[]i32,capacity:i32)i32 {return tt_assert("init",0,tm_init(s,capacity,10,20,30,40,50));}

// Literal fixture construction, not cognitive or scientific data generation.
fn tt_event(s:[]i32,e:[]i32,kind:i32,episode:i32,experience:i32,tag:i32)void {
    tt_fill(e,0);e[TTE_VERSION]=1;e[TTE_ID]=s[3]+101;e[TTE_ORDINAL]=s[3];
    e[TTE_PARENT]=s[3]-1;e[TTE_CAUSE]=s[3]-1;
    let j:i32=0;while(j<5){e[TTE_EXPERIMENT+j]=s[4+j];j=j+1;}
    e[TTE_TICK]=10+s[3]*5;e[TTE_KIND]=kind;e[TTE_EPISODE]=episode;e[TTE_EXPERIENCE]=experience;
    e[TTE_ACTOR_KIND]=1;e[TTE_ACTOR]=700;e[TTE_ASSISTED]=-1;
    if(kind==TTM_ASSESS || kind==TTM_ANCHOR || kind==TTM_RETENTION){e[TTE_ACTOR_KIND]=5;}
    if(kind==TTM_RETRIEVAL || kind==TTM_UPDATE || kind==TTM_RESOURCE){e[TTE_ACTOR_KIND]=6;}
    if(kind==TTM_EXPOSURE || kind==TTM_ASSESS){e[TTE_MODE]=1;e[TTE_ASSISTED]=0;}
    if(kind==TTM_ANCHOR || kind==TTM_RETENTION){e[TTE_ASSISTED]=0;}
    e[TTE_OUTCOME]=-1;e[TTE_FOUND]=-1;e[TTE_USEFUL]=-1;e[TTE_ANCHOR_REF]=-1;
    j=TTE_OPERATIONS;while(j<=TTE_PEAK_RSS){e[j]=-1;j=j+1;}
    j=0;while(j<16){e[TTE_RESULTS+j]=-1;j=j+1;}
    e[TTE_PAYLOAD]=tag;
}
fn tt_ok(s:[]i32,e:[]i32,name:[]u8)i32 {return tt_assert(name,0,tm_append(s,e));}
fn tt_refuse(s:[]i32,e:[]i32,expected:i32,name:[]u8)i32 {
    let before:[]i32=zalloc_i(s.len);let input:[]i32=zalloc_i(e.len);
    tt_copy(s,before);tt_copy(e,input);
    let failed:i32=tt_assert(name,expected,tm_append(s,e));
    failed=failed+tt_assert("refusal.entire_state_unchanged",0,tt_diff(s,before));
    failed=failed+tt_assert("refusal.input_unchanged",0,tt_diff(e,input));
    zfree(before);zfree(input);return failed;
}
fn tt_row(out:[]i32,key:i32,value:i32,status:i32,name:[]u8)i32 {
    _zag_print("METRIC_KEY,");_zag_println(_zag_i64_to_str(key as i64));
    let failed:i32=tt_assert(name,value,out[key*3+1]);
    failed=failed+tt_assert("metric.status",status,out[key*3]);return failed;
}
fn tt_rebuild(s:[]i32)i32 {
    let rebuilt:[]i32=tt_state(s[2]);let record:[]i32=zalloc_i(TTM_EVENT);
    let original:[]i32=zalloc_i(TTM_SNAPSHOT);let derived:[]i32=zalloc_i(TTM_SNAPSHOT);
    let failed:i32=tt_start(rebuilt,s[2]);let i:i32=0;
    while(i<s[3]){
        failed=failed+tt_assert("rebuild.original_event",0,tm_event_at(s,i,record));
        failed=failed+tt_ok(rebuilt,record,"rebuild.original_append");i=i+1;
    }
    failed=failed+tt_assert("rebuild.all_state_words_equal",0,tt_diff(s,rebuilt));
    failed=failed+tt_assert("rebuild.original_snapshot",0,tm_snapshot(s,original));
    failed=failed+tt_assert("rebuild.derived_snapshot",0,tm_snapshot(rebuilt,derived));
    failed=failed+tt_assert("rebuild.all_snapshot_words_equal",0,tt_diff(original,derived));
    zfree(rebuilt);zfree(record);zfree(original);zfree(derived);return failed;
}

fn tt_empty_and_init()i32 {
    let s:[]i32=tt_state(4);let out:[]i32=zalloc_i(TTM_SNAPSHOT);let e:[]i32=zalloc_i(TTM_EVENT);
    let rate:[]i32=zalloc_i(4);let failed:i32=tt_start(s,4);
    failed=failed+tt_assert("empty.snapshot",0,tm_snapshot(s,out));
    failed=failed+tt_row(out,TTM_EVENTS,0,2,"empty.events");
    failed=failed+tt_row(out,TTM_EXPOSURES,-1,0,"empty.exposure_not_measured");
    failed=failed+tt_row(out,TTM_FRESH_SUCCESSES,-1,0,"empty.fresh_not_measured");
    failed=failed+tt_row(out,TTM_FINAL_LOST,-1,0,"empty.retention_not_measured");
    failed=failed+tt_row(out,TTM_UNDERSTANDING,-1,0,"understanding.not_inferred");
    failed=failed+tt_row(out,TTM_TEACHER_COMPETENCE,-1,0,"teacher.not_learner_competence");
    failed=failed+tt_assert("empty.rate",0,tm_rate(out,TTM_FRESH_SUCCESSES,TTM_FRESH_SCORED,rate));
    failed=failed+tt_assert("empty.rate_not_measured",0,rate[0]);
    failed=failed+tt_assert("empty.rate_unknown_numerator",-1,rate[1]);
    let before:[]i32=zalloc_i(s.len);tt_copy(s,before);
    failed=failed+tt_assert("init.nonempty_refused",-5,tm_init(s,4,10,20,30,40,50));
    failed=failed+tt_assert("init.no_journal_reset",0,tt_diff(s,before));
    let zero:[]i32=tt_state(0);failed=failed+tt_start(zero,0);
    tt_event(zero,e,TTM_EXPOSURE,1,1,1);failed=failed+tt_refuse(zero,e,-2,"empty.capacity_refused");
    let bad:[]i32=tt_state(1);let bad_before:[]i32=zalloc_i(bad.len);tt_copy(bad,bad_before);
    failed=failed+tt_assert("init.invalid_identity",-3,tm_init(bad,1,0,20,30,40,50));
    failed=failed+tt_assert("init.invalid_unchanged",0,tt_diff(bad,bad_before));
    failed=failed+tt_assert("init.capacity_bound",-2,tm_init(bad,129,10,20,30,40,50));
    failed=failed+tt_assert("init.bound_unchanged",0,tt_diff(bad,bad_before));
    zfree(s);zfree(out);zfree(e);zfree(rate);zfree(before);zfree(zero);zfree(bad);zfree(bad_before);return failed;
}

fn tt_exposure_and_identity()i32 {
    let s:[]i32=tt_state(16);let e:[]i32=zalloc_i(TTM_EVENT);let out:[]i32=zalloc_i(TTM_SNAPSHOT);
    let failed:i32=tt_start(s,16);
    tt_event(s,e,TTM_EXPOSURE,100,1000,11);failed=failed+tt_ok(s,e,"exposure.first");
    let f:i32=TTE_EXPERIMENT;
    while(f<=TTE_CLOCK){
        tt_event(s,e,TTM_EXPOSURE,101,1001,12);e[f]=e[f]+1;
        failed=failed+tt_refuse(s,e,-3,"identity.each_bound_field");f=f+1;
    }
    tt_event(s,e,TTM_EXPOSURE,101,1001,12);e[TTE_ID]=101;failed=failed+tt_refuse(s,e,-3,"event.duplicate_id");
    tt_event(s,e,TTM_EXPOSURE,101,1001,12);e[TTE_ORDINAL]=2;failed=failed+tt_refuse(s,e,-3,"event.ordinal_gap");
    tt_event(s,e,TTM_EXPOSURE,101,1001,12);e[TTE_PARENT]=-1;failed=failed+tt_refuse(s,e,-3,"event.wrong_parent");
    tt_event(s,e,TTM_EXPOSURE,101,1001,12);e[TTE_CAUSE]=1;failed=failed+tt_refuse(s,e,-3,"event.future_cause");
    tt_event(s,e,TTM_EXPOSURE,101,1001,12);e[TTE_TICK]=9;failed=failed+tt_refuse(s,e,-3,"event.backwards_tick");
    tt_event(s,e,TTM_EXPOSURE,101,1000,12);failed=failed+tt_refuse(s,e,-3,"experience.rebound_payload");
    tt_event(s,e,TTM_EXPOSURE,101,1001,11);failed=failed+tt_refuse(s,e,-6,"unique.alias_id_same_digest");
    tt_event(s,e,TTM_EXPOSURE,101,1001,12);e[TTE_MODE]=2;failed=failed+tt_refuse(s,e,-6,"replay.unseen_payload");
    tt_event(s,e,TTM_EXPOSURE,101,1000,11);e[TTE_MODE]=2;e[TTE_TICK]=10;
    failed=failed+tt_ok(s,e,"replay.honest_equal_tick");
    tt_event(s,e,TTM_EXPOSURE,102,1002,12);e[TTE_ASSISTED]=-1;
    failed=failed+tt_ok(s,e,"exposure.unknown_assistance");
    tt_event(s,e,TTM_EXPOSURE,103,1003,13);e[TTE_PAYLOAD+31]=256;
    failed=failed+tt_refuse(s,e,-1,"payload.byte_out_of_range");
    tt_event(s,e,TTM_EXPOSURE,103,1003,13);e[TTE_PROPOSED]=1;
    failed=failed+tt_refuse(s,e,-1,"inactive_field.cannot_mint_updates");
    tt_event(s,e,TTM_EXPOSURE,103,1003,13);
    failed=failed+tt_refuse(s,e[0..87],-1,"event.truncated_record");
    failed=failed+tt_assert("exposure.snapshot",0,tm_snapshot(s,out));
    failed=failed+tt_row(out,TTM_EXPOSURES,3,2,"exposure.presentations");
    failed=failed+tt_row(out,TTM_UNIQUE,2,2,"exposure.unique");
    failed=failed+tt_row(out,TTM_REPLAYS,1,2,"exposure.replay");
    failed=failed+tt_row(out,TTM_UNKNOWN_EXPOSURE_HELP,1,2,"exposure.unknown_help");
    failed=failed+tt_row(out,TTM_FRESH_TOTAL,-1,0,"exposure.not_assessment");
    zfree(s);zfree(e);zfree(out);return failed;
}

fn tt_assessment_help()i32 {
    let s:[]i32=tt_state(24);let e:[]i32=zalloc_i(TTM_EVENT);let out:[]i32=zalloc_i(TTM_SNAPSHOT);
    let rate:[]i32=zalloc_i(4);let failed:i32=tt_start(s,24);
    tt_event(s,e,TTM_ASSESS,1,1001,21);e[TTE_OUTCOME]=1;failed=failed+tt_ok(s,e,"fresh.unassisted_success");
    tt_event(s,e,TTM_ANCHOR,1,1001,21);e[TTE_ANCHOR_REF]=0;failed=failed+tt_ok(s,e,"anchor.original_success");
    tt_event(s,e,TTM_HELP,2,0,0);e[TTE_REQUESTED]=1;failed=failed+tt_ok(s,e,"help.request");
    tt_event(s,e,TTM_HELP,2,0,0);e[TTE_HELP_RESULT]=1;e[TTE_ACTOR_KIND]=4;
    e[TTE_DELEGATING_HUMAN]=900;e[TTE_SOFTWARE]=2;e[TTE_HELP_DOSE]=3;
    e[TTE_DELEGATING_HUMAN]=0;failed=failed+tt_refuse(s,e,-3,"help.software_requires_human_reference");e[TTE_DELEGATING_HUMAN]=900;
    failed=failed+tt_ok(s,e,"help.delegated_software_accepted");
    tt_event(s,e,TTM_ASSESS,2,1002,22);e[TTE_OUTCOME]=1;e[TTE_ASSISTED]=0;
    failed=failed+tt_ok(s,e,"help.sticky_despite_unassisted_flag");
    tt_event(s,e,TTM_HELP,2,0,0);e[TTE_REQUESTED]=1;failed=failed+tt_refuse(s,e,-3,"help.late_intervention_refused");
    tt_event(s,e,TTM_ANCHOR,2,1002,22);e[TTE_ANCHOR_REF]=4;failed=failed+tt_refuse(s,e,-6,"anchor.assisted_success_refused");
    tt_event(s,e,TTM_ASSESS,3,1003,23);e[TTE_OUTCOME]=1;e[TTE_ACTOR_KIND]=4;e[TTE_DELEGATING_HUMAN]=900;
    failed=failed+tt_refuse(s,e,-6,"teacher.cannot_author_assessment");
    tt_event(s,e,TTM_ASSESS,3,1003,23);e[TTE_ASSISTED]=-1;
    failed=failed+tt_ok(s,e,"fresh.unknown_outcome_and_assistance");
    tt_event(s,e,TTM_ASSESS,4,1004,23);e[TTE_OUTCOME]=1;
    failed=failed+tt_refuse(s,e,-6,"fresh.relabelled_probe_rejected");
    tt_event(s,e,TTM_ASSESS,4,1003,23);e[TTE_MODE]=2;e[TTE_OUTCOME]=0;
    failed=failed+tt_ok(s,e,"assessment.repeat_excluded_from_fresh");
    tt_event(s,e,TTM_ASSESS,5,1005,24);e[TTE_OUTCOME]=0;
    failed=failed+tt_ok(s,e,"fresh.measured_failure");
    tt_event(s,e,TTM_HELP,6,0,0);e[TTE_ACTOR_KIND]=2;e[TTE_REQUESTED]=1;e[TTE_HELP_RESULT]=2;
    failed=failed+tt_ok(s,e,"help.human_refused");
    failed=failed+tt_assert("fresh.snapshot",0,tm_snapshot(s,out));
    failed=failed+tt_row(out,TTM_FRESH_TOTAL,4,2,"fresh.total");
    failed=failed+tt_row(out,TTM_FRESH_SCORED,3,2,"fresh.scored_denominator");
    failed=failed+tt_row(out,TTM_FRESH_SUCCESSES,2,2,"fresh.successes");
    failed=failed+tt_row(out,TTM_FRESH_UNASSISTED_N,2,2,"fresh.unassisted_denominator");
    failed=failed+tt_row(out,TTM_FRESH_UNASSISTED_OK,1,2,"fresh.unassisted_successes");
    failed=failed+tt_row(out,TTM_FRESH_ASSISTED_N,1,2,"fresh.assisted_denominator");
    failed=failed+tt_row(out,TTM_FRESH_ASSISTED_OK,1,2,"fresh.assisted_successes");
    failed=failed+tt_row(out,TTM_FRESH_UNKNOWN_OUTCOME,1,2,"fresh.unknown_outcomes");
    failed=failed+tt_row(out,TTM_FRESH_UNKNOWN_HELP,1,2,"fresh.unknown_assistance");
    failed=failed+tt_row(out,TTM_HELP_REQUESTS,2,2,"help.requests_not_responses");
    failed=failed+tt_row(out,TTM_HELP_ACCEPTED,1,2,"help.accepted");
    failed=failed+tt_row(out,TTM_HELP_REFUSED,1,2,"help.refused");
    failed=failed+tt_row(out,TTM_HUMAN_INTERVENTIONS,0,2,"help.refusal_is_not_intervention");
    failed=failed+tt_row(out,TTM_SOFTWARE_INTERVENTIONS,2,2,"help.software_dose");
    failed=failed+tt_assert("fresh.rate",0,tm_rate(out,TTM_FRESH_SUCCESSES,TTM_FRESH_SCORED,rate));
    failed=failed+tt_assert("fresh.rate_numerator",2,rate[1]);failed=failed+tt_assert("fresh.rate_denominator",3,rate[2]);
    failed=failed+tt_assert("fresh.rate_status",2,rate[0]);
    tt_event(s,e,TTM_HELP,7,0,0);e[TTE_ACTOR_KIND]=3;e[TTE_HELP_RESULT]=1;e[TTE_HUMAN]=1;e[TTE_HELP_DOSE]=4;
    failed=failed+tt_ok(s,e,"help.human_group_accepted");
    tt_event(s,e,TTM_ASSESS,7,1007,25);e[TTE_OUTCOME]=1;failed=failed+tt_ok(s,e,"help.human_assisted_assessment");
    failed=failed+tt_assert("help.updated_snapshot",0,tm_snapshot(s,out));
    failed=failed+tt_row(out,TTM_HUMAN_INTERVENTIONS,1,2,"help.human_interventions");
    failed=failed+tt_row(out,TTM_HELP_DOSE_TOTAL,7,2,"help.total_intervention_units");
    failed=failed+tt_row(out,TTM_FRESH_ASSISTED_OK,2,2,"help.all_assisted_successes_separate");
    zfree(s);zfree(e);zfree(out);zfree(rate);return failed;
}

fn tt_retention()i32 {
    let s:[]i32=tt_state(24);let e:[]i32=zalloc_i(TTM_EVENT);let out:[]i32=zalloc_i(TTM_SNAPSHOT);
    let record:[]i32=zalloc_i(TTM_EVENT);let failed:i32=tt_start(s,24);
    tt_event(s,e,TTM_ASSESS,10,2010,31);e[TTE_OUTCOME]=1;failed=failed+tt_ok(s,e,"retention.baseline_a");
    tt_event(s,e,TTM_ANCHOR,10,2010,31);e[TTE_ANCHOR_REF]=0;failed=failed+tt_ok(s,e,"retention.anchor_a");
    tt_event(s,e,TTM_ASSESS,20,2020,32);e[TTE_OUTCOME]=1;failed=failed+tt_ok(s,e,"retention.baseline_b");
    tt_event(s,e,TTM_ANCHOR,20,2020,32);e[TTE_ANCHOR_REF]=2;failed=failed+tt_ok(s,e,"retention.anchor_b");
    tt_event(s,e,TTM_UPDATE,0,0,0);e[TTE_PROPOSED]=3;e[TTE_ACCEPTED]=2;e[TTE_REJECTED]=1;e[TTE_ROLLED_BACK]=1;e[TTE_INTERFERING_COMPETENCY]=99;

    zfree(s);zfree(e);zfree(out);return failed;
}
fn tt_group(name:[]u8,failed:i32)i32 {
    _zag_print("N04_GROUP,");_zag_print(name);_zag_print(",");
    _zag_println(_zag_i64_to_str(failed as i64));return failed;
}
fn main()i32 {
    // Deliberate explicit run mode; compiling this source executes none of these.
    if(_zag_argc()!=2 || _zag_strcmp(_zag_arg(1),"check")!=1){return 2;}
    let failed:i32=0;
    failed=failed+tt_group("initialization",tt_empty_and_init());
    failed=failed+tt_group("exposure_identity",tt_exposure_and_identity());
    failed=failed+tt_group("assessment_help",tt_assessment_help());
    failed=failed+tt_group("retention",tt_retention());
    failed=failed+tt_group("retrieval_resource",tt_retrieval_resource());
    failed=failed+tt_group("anchor_capacity",tt_anchor_capacity());
    failed=failed+tt_group("atomicity_reconstruction",tt_atomicity_and_reconstruction());
    failed=failed+tt_group("refusal_request",tt_request_refusal());
    _zag_print("FAILURES,");_zag_println(_zag_i64_to_str(failed as i64));
    if(failed!=0){return 1;}
    _zag_println("R33_NATIVE_TELEMETRY_V2_SYNTHETIC_ASSERTIONS_PASS");return 0;
}

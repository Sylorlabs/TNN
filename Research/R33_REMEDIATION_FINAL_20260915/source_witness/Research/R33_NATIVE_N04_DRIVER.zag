// N04 native test supervisor; V3 trusted direct-child scope only.
@import("R33_NATIVE_PROCESS_V3.zag")

fn n04_has(bytes:[]u8,needle:[]u8)i32 {
    if(needle.len<1 || bytes.len<needle.len){return 0;}
    let i:i32=0;while(i<=bytes.len-needle.len){let j:i32=0;
        while(j<needle.len && bytes[i+j]==needle[j]){j=j+1;}
        if(j==needle.len){return 1;}i=i+1;
    }return 0;
}
fn n04_check(name:[]u8,actual:i64,expected:i64,fail:*i32)void {
    fail.*=fail.*+nio_metric(name,actual,expected);
}
fn n04_outcome(r:*NativeRunV3,expected:i32,fail:*i32)void {
    n04_check("supervisor_status",r.*.status,0,fail);
    n04_check("child_started",r.*.started,1,fail);
    n04_check("child_reaped",r.*.reaped,1,fail);
    n04_check("child_exit",r.*.exit_code,expected,fail);
    n04_check("child_signal",r.*.signal,0,fail);
    n04_check("child_stderr",r.*.stderr_bytes,0,fail);
    n04_check("child_resource_bound",(r.*.peak_rss>0 && r.*.peak_rss<=268435456) as i64,1,fail);
}
fn main()i32 {
    if(_zag_argc()!=2 || _zag_strcmp(_zag_arg(1),"supervise")!=1){return 2;}
    if(nio_guard(60)!=0){return 3;}
    let admitted:NativeAdmissionV3=nrv3_admit_root("Research/R33_NATIVE_N04_RUN_PRIMARY_V1");
    if(admitted.status!=0){return 4;}let root:i64=admitted.root;let fail:i32=0;
    let binary:[]u8="Research/R33_NATIVE_N04_BUILD_01/telemetry_test";
    let bad:NativeRunV3=nrv3_run(root,binary,"invalid","invalid",1000,131072);
    n04_outcome(&bad,2,&fail);n04_check("invalid_mode_no_output",bad.stdout_bytes,0,&fail);
    let run:NativeRunV3=nrv3_run(root,binary,"check","telemetry",15000,131072);
    n04_outcome(&run,0,&fail);
    let bytes:[]u8=nio_alloc(131072);let fd:i64=nio_open_child(root,"telemetry.stdout",0);
    let got:i64=nio_read_exact(fd,bytes,131072);
    n04_check("captured_complete_output",(got>0 && got==run.stdout_bytes) as i64,1,&fail);
    if(got>0 && got<=bytes.len){let log:[]u8=bytes[0..got as i32];
        n04_check("no_assertion_mismatch",n04_has(log,",match,0"),0,&fail);
        n04_check("group_initialization",n04_has(log,"N04_GROUP,initialization,0\n"),1,&fail);
        n04_check("group_exposure_identity",n04_has(log,"N04_GROUP,exposure_identity,0\n"),1,&fail);
        n04_check("group_assessment_help",n04_has(log,"N04_GROUP,assessment_help,0\n"),1,&fail);
        n04_check("group_retention",n04_has(log,"N04_GROUP,retention,0\n"),1,&fail);
        n04_check("group_retrieval_resource",n04_has(log,"N04_GROUP,retrieval_resource,0\n"),1,&fail);
        n04_check("group_anchor_capacity",n04_has(log,"N04_GROUP,anchor_capacity,0\n"),1,&fail);
        n04_check("group_atomicity_reconstruction",n04_has(log,"N04_GROUP,atomicity_reconstruction,0\n"),1,&fail);
        n04_check("group_refusal_request",n04_has(log,"N04_GROUP,refusal_request,0\n"),1,&fail);
        n04_check("native_completion",n04_has(log,"FAILURES,0\nR33_NATIVE_TELEMETRY_V2_SYNTHETIC_ASSERTIONS_PASS\n"),1,&fail);
    }
    if(fd>=0){nio_close(fd);}nio_free(bytes);n04_check("close_root",nio_close(root),0,&fail);
    _zag_print("N04_FAILURES,");_zag_println(_zag_i64_to_str(fail as i64));
    if(fail!=0){return 1;}_zag_println("N04_TELEMETRY_V2_ENGINEERING_PASS,8");return 0;
}

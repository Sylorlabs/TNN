@import("v91_semantic_kat.zag")
fn n(x:i32)void {_zag_print(_zag_i64_to_str(x as i64));}
fn main()i32 {let rows:[]V91Row=new V91Row(V91_ROWS);if(v91_build(rows)!=0){return 2;}let tr:[]i32=new i32(V91_ROWS);let te:[]i32=new i32(V91_ROWS);let nt:i32=0;let nh:i32=0;if(v91_split(rows,tr,te,&nt,&nh)!=0||nh<16){return 3;}let c:[]i32=new i32(42);let i:i32=0;while(i<16){let r:V91Row=rows[te[i]];v91_condition(r,c);_zag_print("V91_ROW,");n(i);_zag_print(",source=");n(te[i]);_zag_print(",a=");_zag_print(v91_name(r.a));_zag_print(",o=");_zag_print(v91_object(r.o));_zag_print(",l=");_zag_print(v91_loc(r.l));_zag_print(",bad=");_zag_print(v91_motive(r.bad));_zag_print(",act=");_zag_print(v91_action(r.act));_zag_print(",kind=");_zag_print(v91_kind(r.kind));_zag_print(",form=");n(r.form);_zag_print(",vec=");let j:i32=0;while(j<42){if(j>0){_zag_print(":");}n(c[j]);j=j+1;}_zag_print(",accepted_n1=");_zag_println(v91_expected_naive(i));i=i+1;}return 0;}

// TNN R32 E45 — persistent logical investigation option core.
//
// This module contains generic cognition primitives only. It has no evaluator
// mode, ambiguity label, answer table, fixed observation duration, confidence
// threshold, supplied boundary, transformer, tokenizer, or graph substrate.
// The caller supplies learned value weights and delayed-grounded state.

const R32E45_HYP_A:i32=0;
const R32E45_HYP_B:i32=1;
const R32E45_UNKNOWN:i32=-1;

const R32E45_TERM_KEEP:i32=0;
const R32E45_TERM_CURRENT:i32=1;
const R32E45_TERM_RESTORE:i32=2;
const R32E45_TERM_UNKNOWN:i32=3;

const R32E45_TRACE_NONE:i32=0;
const R32E45_TRACE_TRANSITION:i32=1;
const R32E45_TRACE_REVERSAL:i32=2;
const R32E45_TRACE_CONTINUE:i32=3;
const R32E45_TRACE_TERMINATE:i32=4;

fn r32e45_abs(v:i32)i32 {
    if(v<0){
        return 0-v;
    }
    return v;
}

fn r32e45_max(a:i32,b:i32)i32 {
    if(a>b){
        return a;
    }
    return b;
}

fn r32e45_clamp(v:i32,lo:i32,hi:i32)i32 {
    if(v<lo){
        return lo;
    }
    if(v>hi){
        return hi;
    }
    return v;
}

// Repeated evidence from one lineage has diminishing authority. The
// dependence penalty is mutable learner state learned from later regret.
fn r32e45_source_weight(source_seen:i32,base_trust:i32,dependence_penalty:i32)i32 {
    let denom:i32=1000+source_seen*dependence_penalty;
    if(denom<=0){
        return base_trust;
    }
    return base_trust*1000/denom;
}

fn r32e45_weighted_evidence(evidence:i32,source_weight:i32)i32 {
    return evidence*source_weight/1000;
}

fn r32e45_best_hypothesis(score_a:i32,score_b:i32)i32 {
    if(score_b>score_a){
        return R32E45_HYP_B;
    }
    return R32E45_HYP_A;
}

fn r32e45_hypothesis_margin(score_a:i32,score_b:i32)i32 {
    return r32e45_abs(score_a-score_b);
}

// Historical and current-epoch evidence are deliberately separate. History is
// never overwritten. A transition is an explicit competing interpretation with
// retained support and counterevidence. Switching uses a learned value crossing
// the grounded zero-utility boundary, not a confidence/count threshold.
//
// Return value: 0=no state change, 1=new current state, 2=return/reversal.
fn r32e45_temporal_observe(
    evidence_a:i32,
    evidence_b:i32,
    source_weight:i32,
    historical_a:*i32,
    historical_b:*i32,
    epoch_a:*i32,
    epoch_b:*i32,
    current_state:*i32,
    prior_state:*i32,
    epoch_id:*i32,
    transition_support:*i32,
    transition_counter:*i32,
    transition_live:*i32,
    return_live:*i32,
    learned_leave_weight:i32,
    learned_counter_weight:i32,
    learned_persistence_value:i32,
    learned_leave_hazard:i32,
    learned_return_hazard:i32
)i32 {
    let wa:i32=r32e45_weighted_evidence(evidence_a,source_weight);
    let wb:i32=r32e45_weighted_evidence(evidence_b,source_weight);
    historical_a.*=historical_a.*+wa;
    historical_b.*=historical_b.*+wb;
    epoch_a.*=epoch_a.*+wa;
    epoch_b.*=epoch_b.*+wb;

    let candidate:i32=r32e45_best_hypothesis(epoch_a.*,epoch_b.*);
    let margin:i32=r32e45_hypothesis_margin(epoch_a.*,epoch_b.*);
    if(candidate==current_state.*){
        transition_counter.*=r32e45_clamp(transition_counter.*+margin*source_weight/1000,0,2000000);
        transition_support.*=r32e45_clamp(transition_support.*-margin*source_weight/2000,0,2000000);
        if(transition_support.*==0){
            transition_live.*=0;
        }
        return R32E45_TRACE_NONE;
    }

    transition_live.*=1;
    transition_support.*=r32e45_clamp(transition_support.*+margin*source_weight/1000,0,2000000);
    let leave_value:i32=
        transition_support.**learned_leave_weight/1000+
        learned_leave_hazard-
        transition_counter.**learned_counter_weight/1000-
        learned_persistence_value;
    let returning:i32=0;
    if(candidate==prior_state.*){
        returning=1;
    }
    let switch_value:i32=leave_value+returning*learned_return_hazard;
    if(switch_value<=0){
        return R32E45_TRACE_NONE;
    }

    let old_current:i32=current_state.*;
    let old_prior:i32=prior_state.*;
    prior_state.*=old_current;
    current_state.*=candidate;
    epoch_id.*=epoch_id.*+1;
    transition_support.*=0;
    transition_counter.*=0;
    transition_live.*=0;
    epoch_a.*=wa;
    epoch_b.*=wb;
    if(candidate==old_prior){
        return_live.*=1;
        return R32E45_TRACE_REVERSAL;
    }
    return_live.*=0;
    return R32E45_TRACE_TRANSITION;
}

// Explicit option initiation state. `observations` is an audit fact only; no
// decision primitive below consumes it as a duration or stage rule.
fn r32e45_option_begin(
    favored:i32,
    alternative:i32,
    initiating_evidence:i32,
    expected_favored:i32,
    expected_alternative:i32,
    learned_shadow_price:i32,
    active:*i32,
    target_favored:*i32,
    target_alternative:*i32,
    cause_evidence:*i32,
    predicted_favored:*i32,
    predicted_alternative:*i32,
    support_since_start:*i32,
    contradiction_since_start:*i32,
    independent_since_start:*i32,
    accumulated_shadow_cost:*i32,
    observations:*i32
)void {
    active.*=1;
    target_favored.*=favored;
    target_alternative.*=alternative;
    cause_evidence.*=initiating_evidence;
    predicted_favored.*=expected_favored;
    predicted_alternative.*=expected_alternative;
    support_since_start.*=0;
    contradiction_since_start.*=0;
    independent_since_start.*=0;
    accumulated_shadow_cost.*=learned_shadow_price;
    observations.*=0;
}

fn r32e45_option_record(
    observed_consequence:i32,
    expected_favored:i32,
    expected_alternative:i32,
    independent:i32,
    shadow_cost:i32,
    support_since_start:*i32,
    contradiction_since_start:*i32,
    independent_since_start:*i32,
    accumulated_shadow_cost:*i32,
    observations:*i32
)void {
    let favored_error:i32=r32e45_abs(observed_consequence-expected_favored);
    let alternative_error:i32=r32e45_abs(observed_consequence-expected_alternative);
    if(favored_error<alternative_error){
        support_since_start.*=support_since_start.*+(alternative_error-favored_error);
    }else{
        contradiction_since_start.*=contradiction_since_start.*+(favored_error-alternative_error);
    }
    independent_since_start.*=independent_since_start.*+independent;
    accumulated_shadow_cost.*=accumulated_shadow_cost.*+shadow_cost;
    observations.*=observations.*+1;
}

// A current per-step controller. It has no memory of why an investigation was
// entered, so a temporarily negative immediate consequence can terminate it.
fn r32e45_per_step_value(
    immediate_gain:i32,
    immediate_shadow_cost:i32,
    learned_gain_weight:i32,
    learned_cost_weight:i32,
    bias:i32
)i32 {
    return bias+
        immediate_gain*learned_gain_weight/1000-
        immediate_shadow_cost*learned_cost_weight/1000;
}

// Persistent option without explicit logical targets. It can retain delayed
// option credit but sees only aggregate progress and cost.
fn r32e45_option_value_generic(
    delayed_option_credit:i32,
    aggregate_progress:i32,
    unresolved:i32,
    learned_shadow_cost:i32,
    credit_weight:i32,
    progress_weight:i32,
    unresolved_weight:i32,
    cost_weight:i32,
    bias:i32
)i32 {
    return bias+
        delayed_option_credit*credit_weight/1000+
        aggregate_progress*progress_weight/1000+
        unresolved*unresolved_weight/1000-
        learned_shadow_cost*cost_weight/1000;
}

// Logical option state retains the unresolved distinction and two live targets.
fn r32e45_option_value_logical(
    generic_value:i32,
    consequence_separation:i32,
    favored_support:i32,
    favored_contradiction:i32,
    alternative_live:i32,
    separation_weight:i32,
    support_weight:i32,
    contradiction_weight:i32,
    alternative_weight:i32
)i32 {
    return generic_value+
        consequence_separation*separation_weight/1000+
        favored_support*support_weight/1000-
        favored_contradiction*contradiction_weight/1000+
        alternative_live*alternative_weight/1000;
}

// Full state adds historical/current disagreement, source independence and
// horizon-conditioned persistence/change/return support. These quantities are
// auxiliary grounded predictions; they do not replace the hypothesis/evidence
// population or become a universal abstention veto.
fn r32e45_option_value_full(
    logical_value:i32,
    historical_current_disagreement:i32,
    independent_evidence:i32,
    transition_support:i32,
    transition_counter:i32,
    persistence_hazard:i32,
    leave_hazard:i32,
    return_hazard:i32,
    disagreement_weight:i32,
    independence_weight:i32,
    transition_weight:i32,
    counter_weight:i32,
    persistence_weight:i32,
    leave_weight:i32,
    return_weight:i32
)i32 {
    return logical_value+
        historical_current_disagreement*disagreement_weight/1000+
        independent_evidence*independence_weight/1000+
        transition_support*transition_weight/1000-
        transition_counter*counter_weight/1000+
        persistence_hazard*persistence_weight/1000+
        leave_hazard*leave_weight/1000+
        return_hazard*return_weight/1000;
}

fn r32e45_option_continue(value:i32,active:*i32,last_reason:*i32)i32 {
    if(value>0){
        active.*=1;
        last_reason.*=R32E45_TRACE_CONTINUE;
        return 1;
    }
    active.*=0;
    last_reason.*=R32E45_TRACE_TERMINATE;
    return 0;
}

// Terminal alternatives share grounded utility/regret units. UNKNOWN is an
// action with a value, not an evaluator class and not a low-confidence cutoff.
fn r32e45_terminal_choose(
    keep_value:i32,
    current_value:i32,
    restore_value:i32,
    unknown_value:i32
)i32 {
    let choice:i32=R32E45_TERM_KEEP;
    let best:i32=keep_value;
    if(current_value>best){
        choice=R32E45_TERM_CURRENT;
        best=current_value;
    }
    if(restore_value>best){
        choice=R32E45_TERM_RESTORE;
        best=restore_value;
    }
    if(unknown_value>best){
        choice=R32E45_TERM_UNKNOWN;
    }
    return choice;
}

fn r32e45_core_test_provenance()i32 {
    let first:i32=r32e45_source_weight(0,1000,700);
    let repeated:i32=r32e45_source_weight(5,1000,700);
    if(first>repeated && repeated>0){
        return 1;
    }
    return 0;
}

fn r32e45_core_test_temporal_replacement_reversal()i32 {
    let historical_a:i32=4000;
    let historical_b:i32=0;
    let epoch_a:i32=0;
    let epoch_b:i32=0;
    let current:i32=R32E45_HYP_A;
    let prior:i32=R32E45_UNKNOWN;
    let epoch_id:i32=0;
    let transition_support:i32=0;
    let transition_counter:i32=0;
    let transition_live:i32=0;
    let return_live:i32=0;
    let changed:i32=r32e45_temporal_observe(
        0,1400,1000,
        &historical_a,&historical_b,&epoch_a,&epoch_b,
        &current,&prior,&epoch_id,&transition_support,&transition_counter,
        &transition_live,&return_live,
        1000,1000,100,0,900
    );
    let reversed:i32=r32e45_temporal_observe(
        2100,0,1000,
        &historical_a,&historical_b,&epoch_a,&epoch_b,
        &current,&prior,&epoch_id,&transition_support,&transition_counter,
        &transition_live,&return_live,
        1000,1000,100,0,900
    );
    if(changed==R32E45_TRACE_TRANSITION && reversed==R32E45_TRACE_REVERSAL){
        if(current==R32E45_HYP_A && epoch_id==2 && historical_a>4000 && historical_b>0){
            return 1;
        }
    }
    return 0;
}

fn r32e45_core_test_option_valley()i32 {
    let per_step:i32=r32e45_per_step_value(80,220,1000,1000,0);
    let generic:i32=r32e45_option_value_generic(500,20,800,220,1000,300,100,1000,0);
    let logical:i32=r32e45_option_value_logical(generic,600,50,20,1000,700,200,200,200);
    let full:i32=r32e45_option_value_full(
        logical,700,800,600,50,300,800,500,
        300,200,500,300,100,400,300
    );
    let active:i32=1;
    let reason:i32=0;
    let continued:i32=r32e45_option_continue(full,&active,&reason);
    if(per_step<0 && full>0 && continued==1 && active==1 && reason==R32E45_TRACE_CONTINUE){
        return 1;
    }
    return 0;
}

fn r32e45_core_test_rational_unknown()i32 {
    let generic:i32=r32e45_option_value_generic(40,0,900,700,500,0,100,1000,0);
    let logical:i32=r32e45_option_value_logical(generic,30,0,0,1000,100,0,0,50);
    let full:i32=r32e45_option_value_full(
        logical,20,0,0,500,800,0,0,
        100,100,100,500,0,0,0
    );
    let terminal:i32=r32e45_terminal_choose(-80,-40,-60,0);
    if(full<0 && terminal==R32E45_TERM_UNKNOWN){
        return 1;
    }
    return 0;
}

fn r32e45_core_gate()i32 {
    return r32e45_core_test_provenance()+
        r32e45_core_test_temporal_replacement_reversal()+
        r32e45_core_test_option_valley()+
        r32e45_core_test_rational_unknown();
}

// Forty known corrective child shapes plus one new ABI guard; no learner.
@import("durable.zag")
@import("R33_NATIVE_PROCESS_V3.zag")

struct N05Checks { checks:i32, failed:i32, children:i32, child_checks:i32, cpu:i64, wall:i64, rss:i64 }
fn n05_stats()N05Checks {return N05Checks{.checks=0,.failed=0,.children=0,.child_checks=0,.cpu=0,.wall=0,.rss=0};}
fn n05_check(s:*N05Checks,name:[]u8,actual:i64,expected:i64)void {
    s.*.checks=s.*.checks+1;s.*.failed=s.*.failed+nio_metric(name,actual,expected);
}
fn n05_equal(a:[]i32,b:[]i32)i32 {
    if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;
}
fn n05_config()[]i32 {
    let c:[]i32=dt_words(6);if(c.len!=6){_zag_exit(70);}
    c[0]=16;c[1]=330501;c[2]=2701;c[3]=1;c[4]=1;c[5]=1;return c;
}
fn n05_abi(s:*N05Checks)void {
    let c:[]i32=n05_config();let e:[]i32=dt_words(88);let out:[]i32=dt_words(168);
    n05_check(s,"config_length",c.len,6);n05_check(s,"event_length",e.len,88);
    n05_check(s,"snapshot_length",out.len,168);
    if(c.len!=6 || e.len!=88 || out.len!=168){return;}
    let ep0:*i32=&e[0];let ep1:*i32=&e[1];let cp0:*i32=&c[0];let cp5:*i32=&c[5];
    n05_check(s,"native_i32_stride",(ep1 as i64)-(ep0 as i64),8);
    n05_check(s,"native_config_extent",(cp5 as i64)-(cp0 as i64),40);
    let i:i32=0;while(i<88){e[i]=i+900;i=i+1;}
    i=0;while(i<168){out[i]=i+1900;i=i+1;}
    let junk:[]u8=nio_alloc(8192);i=0;while(i<junk.len){junk[i]=119;i=i+1;}
    n05_check(s,"config_capacity_preserved",c[0],16);n05_check(s,"config_experiment_preserved",c[1],330501);
    n05_check(s,"config_brain_preserved",c[2],2701);n05_check(s,"config_branch_preserved",c[3],1);
    n05_check(s,"config_competency_preserved",c[4],1);n05_check(s,"config_clock_preserved",c[5],1);
    let bad:i32=0;i=0;while(i<88){if(e[i]!=i+900){bad=bad+1;}i=i+1;}
    i=0;while(i<168){if(out[i]!=i+1900){bad=bad+1;}i=i+1;}
    n05_check(s,"adjacent_allocations_intact",bad,0);
    let root:[]u8=dt_root_record(c);n05_check(s,"root_bytes",root.len,128);
    if(root.len==128){i=0;while(i<6){n05_check(s,"root_config_exact",dt_get(root,16+i*4),c[i]);i=i+1;}}
    let b:[]u8=nio_alloc(8);i=0;while(i<8){b[i]=91;i=i+1;}
    n05_check(s,"wire_high_refused",dt_put(b,0,2147483648),-8102);
    n05_check(s,"wire_low_refused",dt_put(b,0,-2147483649),-8102);
    bad=0;i=0;while(i<8){if(b[i]!=91){bad=bad+1;}i=i+1;}
    n05_check(s,"wire_refusal_no_mutation",bad,0);
    n05_check(s,"wire_max_accepted",dt_put(b,0,2147483647),0);
    n05_check(s,"wire_min_accepted",dt_put(b,4,-2147483648),0);
    n05_check(s,"wire_max_roundtrip",dt_get(b,0),2147483647);
    n05_check(s,"wire_min_roundtrip",dt_get(b,4),-2147483648);
    dt_free_words(c);dt_free_words(e);dt_free_words(out);nio_free(junk);nio_free(root);nio_free(b);
}
fn n05_path(name:[]u8)[]u8 {return _zag_str_concat("Research/R33_NATIVE_N05B_RUN_PRIMARY_V1/",name);}
fn n05_named(prefix:[]u8,n:i32,suffix:[]u8)[]u8 {
    let value:[]u8=_zag_i64_to_str(n as i64);let first:[]u8=_zag_str_concat(prefix,value);
    let out:[]u8=_zag_str_concat(first,suffix);nio_free(first);nio_free(value);return out;
}
fn n05_write(root:i64,name:[]u8,bytes:[]u8)i32 {
    let fd:i64=nio_open_child(root,name,1);if(fd<0){return -1;}
    let code:i32=0;
    if(nio_regular(fd)!=1 || nio_write_all(fd,bytes)!=bytes.len || nio_sync(fd)!=0){code=-1;}
    if(nio_close(fd)!=0 || nio_sync(root)!=0){code=-1;}return code;
}
fn n05_read_equal(root:i64,name:[]u8,bytes:[]u8)i32 {
    let fd:i64=nio_open_child(root,name,0);if(fd<0){return 0;}
    let b:[]u8=nio_alloc(bytes.len);let n:i64=nio_read_exact(fd,b,bytes.len);nio_close(fd);
    let same:i32=0;if(n==bytes.len){same=nio_equal(b,bytes);}nio_free(b);return same;
}
fn n05_payload(index:i32)[]u8 {
    let tag:i32=index+5;if(index==0 || index==11){tag=1;}if(index==6 || index==7){tag=2;}
    let b:[]u8=nio_alloc(64);if(b.len!=64){_zag_exit(70);}
    let i:i32=0;while(i<64){b[i]=((tag*17+i*3)%251) as u8;i=i+1;}return b;
}
fn n05_event(index:i32)[]i32 {
    let e:[]i32=dt_words(88);if(e.len!=88){_zag_exit(70);}
    e[0]=1;e[1]=50001+index;e[2]=index;e[3]=index-1;e[4]=index-1;
    e[5]=330501;e[6]=2701;e[7]=1;e[8]=1;e[9]=1;e[10]=10+index;
    e[11]=1;e[12]=index+20;e[13]=index+200;e[14]=1;e[15]=501;e[17]=0;e[18]=-1;
    e[19]=1;e[25]=-1;e[26]=-1;e[37]=-1;
    let k:i32=31;while(k<=36){e[k]=-1;k=k+1;}k=72;while(k<88){e[k]=-1;k=k+1;}
    if(index==0 || index==11){e[12]=1;e[13]=101;}
    if(index==1 || index==2){
        e[11]=2;e[12]=1;e[13]=0;e[17]=-1;e[19]=0;
        if(index==1){e[20]=1;}else{e[14]=2;e[21]=2;}
    }
    if(index==3){e[11]=6;e[12]=1;e[13]=0;e[14]=6;e[17]=-1;e[19]=0;e[25]=1;e[26]=1;e[4]=0;}
    if(index==4 || index==9){
        e[11]=7;e[12]=0;e[13]=0;e[14]=6;e[17]=-1;e[19]=0;e[27]=1;
        if(index==4){e[28]=1;}else{e[29]=1;}
    }
    if(index==5){
        e[11]=8;e[12]=0;e[13]=0;e[14]=6;e[17]=-1;e[19]=0;
        e[31]=17;e[32]=9;e[33]=3;e[34]=5;e[35]=10;e[36]=20;
    }
    if(index==6){e[11]=3;e[12]=2;e[13]=202;e[14]=5;e[18]=1;}
    if(index==7){e[11]=4;e[12]=2;e[13]=202;e[14]=5;e[19]=0;e[37]=6;}
    if(index==8 || index==10){
        e[11]=5;e[12]=0;e[13]=0;e[14]=5;e[19]=0;e[39]=1;e[72]=0;
        if(index==10){e[39]=2;e[72]=1;}
    }
    if(index==11){e[12]=3;e[19]=2;e[17]=-1;e[4]=0;}
    if(e[11]==1 || e[11]==3 || e[11]==4){
        let payload:[]u8=n05_payload(index);let h:[]u8=nio_alloc(32);
        if(ns_sha256(payload,h)!=0){_zag_exit(70);}
        k=0;while(k<32){e[40+k]=h[k] as i32;k=k+1;}nio_free(payload);nio_free(h);
    }return e;
}
fn n05_causal(index:i32)[]u8 {
    let c:[]u8=nio_alloc(672);if(c.len!=672){_zag_exit(70);}
    let role:i32=0;
    while(role<6){let at:i32=role*112;let present:i32=0;
        if(index==4 || index==9){present=1;}
        if(role==0 && (index==0 || index==3 || index==6 || index==7 || index>=11)){present=1;}
        if(index==3 && role==1){present=1;}
        if(present==0){dt_put(c,at,-1);}else{
            dt_put(c,at,64);dt_put(c,at+4,1);
            if(role==0){let payload:[]u8=n05_payload(index);dt_copy(payload,c[at+40..at+104]);nio_free(payload);}
            else{let i:i32=0;while(i<64){c[at+40+i]=((index*19+role*23+i*7)%251) as u8;i=i+1;}}
            if(ns_sha256(c[at+40..at+104],c[at+8..at+40])!=0){_zag_exit(70);}
        }role=role+1;
    }return c;
}
fn n05_append_index(j:*DurableTelemetry,index:i32,s:*N05Checks)void {
    let e:[]i32=n05_event(index);let c:[]u8=n05_causal(index);
    n05_check(s,"append",dt_append(j,e,c,index),0);
    n05_check(s,"published_count",j.*.count,index+1);n05_check(s,"live_event_count",j.*.state[3],index+1);
    dt_free_words(e);nio_free(c);
}
fn n05_metrics(j:*DurableTelemetry,s:*N05Checks,save:i32)void {
    let out:[]i32=dt_words(168);let b:[]u8=nio_alloc(672);let state_bytes:[]u8=nio_alloc(j.*.state.len*4);
    n05_check(s,"snapshot",tm_snapshot(j.*.state,out),0);n05_check(s,"encode_metrics",dt_encode(out,b),0);
    n05_check(s,"events",out[1],12);n05_check(s,"exposures",out[4],2);
    n05_check(s,"unique",out[7],1);n05_check(s,"replay",out[10],1);
    n05_check(s,"request",out[19],1);n05_check(s,"refusal",out[25],1);
    n05_check(s,"retrieval",out[97],1);n05_check(s,"accepted_update",out[115],1);
    n05_check(s,"rejected_update",out[118],1);n05_check(s,"ever_lost",out[79],1);
    n05_check(s,"final_lost",out[76],0);n05_check(s,"rescues",out[88],1);
    let k:i32=50;while(k<=53){n05_check(s,"unmeasured_status",out[k*3],0);n05_check(s,"unmeasured_value",out[k*3+1],-1);k=k+1;}
    n05_check(s,"encode_state",dt_encode(j.*.state,state_bytes),0);
    if(save==1){
        n05_check(s,"save_metrics",n05_write(j.*.root,"metrics.bin",b),0);
        n05_check(s,"save_words",n05_write(j.*.root,"words.bin",state_bytes),0);
        n05_check(s,"save_causal",n05_write(j.*.root,"causal.bin",j.*.causal),0);
    }else{
        n05_check(s,"fresh_all_168_metric_words",n05_read_equal(j.*.root,"metrics.bin",b),1);
        n05_check(s,"fresh_entire_accumulator",n05_read_equal(j.*.root,"words.bin",state_bytes),1);
        n05_check(s,"fresh_entire_causal_store",n05_read_equal(j.*.root,"causal.bin",j.*.causal),1);
    }
    let missing:i32=0;let i:i32=0;
    while(i<12){let expected:[]u8=n05_causal(i);
        n05_check(s,"causal_exact_fixture",nio_equal(j.*.causal[i*672..(i+1)*672],expected),1);
        k=0;while(k<6){if(dt_get(expected,k*112)==-1){missing=missing+1;}k=k+1;}
        nio_free(expected);i=i+1;
    }
    n05_check(s,"missing_causal_slots_not_invented",missing,54);
    k=0;while(k<56){_zag_print("METRIC,");_zag_print(_zag_i64_to_str(k as i64));let col:i32=0;
        while(col<3){_zag_print(",");_zag_print(_zag_i64_to_str(out[k*3+col] as i64));col=col+1;}_zag_println("");k=k+1;
    }
    dt_free_words(out);nio_free(b);nio_free(state_bytes);
}
fn n05_normal(replay:i32,s:*N05Checks)void {
    let c:[]i32=n05_config();let path:[]u8=n05_path("normal");
    if(replay==0){n05_check(s,"create",dt_create(path,c),0);}
    let j:DurableTelemetry=dt_recover(path,c);n05_check(s,"recover",j.status,0);
    if(j.status==0){
        if(replay==0){let i:i32=0;while(i<12 && s.*.failed==0){n05_append_index(&j,i,s);i=i+1;}}
        n05_check(s,"twelve_published",j.count,12);n05_check(s,"twelve_attempts",j.attempts,12);
        n05_check(s,"no_incomplete",j.incomplete,0);n05_check(s,"no_unpublished",j.unpublished,0);
        if(s.*.failed==0){n05_metrics(&j,s,1-replay);}
    }dt_close(&j);dt_free_words(c);nio_free(path);
}
fn n05_refuse(j:*DurableTelemetry,e:[]i32,c:[]u8,parent:i32,expected:i32,s:*N05Checks)void {
    let before:[]i32=dt_words(j.*.state.len);let input:[]i32=dt_words(88);
    let causal:[]u8=nio_alloc(j.*.causal.len);let cin:[]u8=nio_alloc(672);let head:[]u8=nio_alloc(32);
    dt_copy_words(j.*.state,before);dt_copy_words(e,input);dt_copy(j.*.causal,causal);dt_copy(c,cin);dt_copy(j.*.head,head);
    let attempts:i32=j.*.attempts;
    n05_check(s,"api_refusal",dt_append(j,e,c,parent),expected);
    n05_check(s,"refusal_all_state_unchanged",n05_equal(j.*.state,before),1);
    n05_check(s,"refusal_event_input_unchanged",n05_equal(e,input),1);
    n05_check(s,"refusal_all_causal_unchanged",nio_equal(j.*.causal,causal),1);
    n05_check(s,"refusal_causal_input_unchanged",nio_equal(c,cin),1);
    n05_check(s,"refusal_head_unchanged",nio_equal(j.*.head,head),1);
    n05_check(s,"refusal_no_attempt",j.*.attempts,attempts);
    dt_free_words(before);dt_free_words(input);nio_free(causal);nio_free(cin);nio_free(head);
}
fn n05_refusals(s:*N05Checks)void {
    let config:[]i32=n05_config();let path:[]u8=n05_path("refusals");
    n05_check(s,"create",dt_create(path,config),0);
    let j:DurableTelemetry=dt_recover(path,config);n05_check(s,"recover",j.status,0);
    if(j.status==0){
        n05_append_index(&j,0,s);let e:[]i32=n05_event(1);let c:[]u8=n05_causal(1);
        n05_refuse(&j,e,c,0,-8106,s);e[1]=50001;n05_refuse(&j,e,c,1,-8107,s);e[1]=50002;
        e[0]=2;n05_refuse(&j,e,c,1,-8104,s);e[0]=1;
        dt_put(c,0,65);n05_refuse(&j,e,c,1,-8102,s);dt_put(c,0,-1);
        c[40]=1;n05_refuse(&j,e,c,1,-8102,s);c[40]=0;
        n05_refuse(&j,j.state[16..104],c,1,-8110,s);
        n05_refuse(&j,j.state[j.state.len-88..j.state.len],c,1,-8110,s);
        n05_refuse(&j,e,j.causal[0..672],1,-8110,s);
        let other:DurableTelemetry=dt_recover(path,config);
        n05_check(s,"competing_writer_rejected",other.status,-8109);n05_check(s,"rejected_writer_empty",other.state.len,0);dt_close(&other);
        let words:[]i32=dt_words(5);let decoded:[]i32=dt_words(5);let bytes:[]u8=nio_alloc(20);
        words[0]=0-2147483647-1;words[1]=-1;words[2]=0;words[3]=1;words[4]=2147483647;
        n05_check(s,"signed_encode",dt_encode(words,bytes),0);n05_check(s,"signed_decode",dt_decode(bytes,decoded),0);
        n05_check(s,"signed_exact",n05_equal(words,decoded),1);n05_check(s,"min_sign_byte",bytes[3],128);
        n05_check(s,"minus_one_byte",bytes[4],255);n05_check(s,"max_sign_byte",bytes[19],127);
        dt_free_words(words);dt_free_words(decoded);nio_free(bytes);dt_free_words(e);nio_free(c);
    }
    dt_close(&j);config[1]=330502;
    let wrong:DurableTelemetry=dt_recover(path,config);n05_check(s,"different_root_identity",wrong.status,-8101);
    n05_check(s,"different_identity_no_state",wrong.state.len,0);dt_close(&wrong);
    dt_free_words(config);nio_free(path);
}
fn n05_capacity(replay:i32,s:*N05Checks)void {
    let config:[]i32=n05_config();let path:[]u8=n05_path("capacity");
    if(replay==0){n05_check(s,"create",dt_create(path,config),0);}
    let j:DurableTelemetry=dt_recover(path,config);n05_check(s,"recover",j.status,0);
    if(j.status==0){
        if(replay==0){let i:i32=0;while(i<16 && s.*.failed==0){n05_append_index(&j,i,s);i=i+1;}
            let e:[]i32=n05_event(16);let c:[]u8=n05_causal(16);n05_refuse(&j,e,c,16,-8105,s);dt_free_words(e);nio_free(c);
        }
        n05_check(s,"full_count",j.count,16);n05_check(s,"full_attempts",j.attempts,16);
        n05_check(s,"capacity_no_unpublished",j.unpublished,0);n05_check(s,"capacity_valid",tm_validate(j.state),0);
    }dt_close(&j);dt_free_words(config);nio_free(path);
}
fn n05_attempts(replay:i32,s:*N05Checks)void {
    let config:[]i32=n05_config();let path:[]u8=n05_path("attempts");
    if(replay==0){n05_check(s,"create",dt_create(path,config),0);}
    let j:DurableTelemetry=dt_recover(path,config);n05_check(s,"recover",j.status,0);
    let e:[]i32=n05_event(0);let c:[]u8=n05_causal(0);
    if(j.status==0){
        if(replay==0){let i:i32=0;while(i<32 && s.*.failed==0){
            n05_check(s,"injected_partial_failure",dt_append_diagnostic(&j,e,c,0,6),-8111);
            n05_check(s,"failure_no_live_event",j.state[3],0);n05_check(s,"poisoned_handle",j.status,-8108);
            dt_close(&j);j=dt_recover(path,config);n05_check(s,"recover_partial",j.status,0);
            n05_check(s,"failed_attempt_retained",j.attempts,i+1);n05_check(s,"partial_retained",j.incomplete,i+1);i=i+1;
        }}
        n05_check(s,"no_committed_events",j.count,0);n05_check(s,"thirty_two_attempts",j.attempts,32);
        n05_check(s,"thirty_two_unpublished",j.unpublished,32);n05_check(s,"thirty_two_incomplete",j.incomplete,32);
        n05_refuse(&j,e,c,0,-8105,s);
    }dt_close(&j);dt_free_words(e);nio_free(c);dt_free_words(config);nio_free(path);
}
fn n05_fault(name:[]u8,fault:i32,replay:i32,s:*N05Checks)void {
    let config:[]i32=n05_config();let path:[]u8=n05_path(name);
    if(replay==0){n05_check(s,"create",dt_create(path,config),0);}
    let j:DurableTelemetry=dt_recover(path,config);n05_check(s,"recover",j.status,0);
    if(j.status==0){
        if(replay==0){
            let e:[]i32=n05_event(0);let c:[]u8=n05_causal(0);
            let result:i32=dt_append_diagnostic(&j,e,c,0,fault);
            if(fault==8){n05_check(s,"explicit_prepublication_error",result,-8113);}
            else{if(fault==9){n05_check(s,"explicit_indeterminate_error",result,-8112);}
                else{n05_check(s,"crash_must_not_return",result,73);}}
            n05_check(s,"failed_commit_no_live_event",j.state[3],0);n05_check(s,"failure_handle_poisoned",j.status,-8108);
            n05_check(s,"poisoned_write_refused",dt_append(&j,e,c,0),-8108);dt_free_words(e);nio_free(c);
        }else{
            let committed:i32=0;if(fault==4 || fault==5 || fault==9){committed=1;}
            let incomplete:i32=0;if(fault==1 || fault==2 || fault==7){incomplete=1;}
            n05_check(s,"after_death_committed",j.count,committed);n05_check(s,"after_death_attempts",j.attempts,1);
            n05_check(s,"after_death_incomplete",j.incomplete,incomplete);
            n05_check(s,"after_death_unpublished",j.unpublished,1-committed);
            n05_check(s,"after_death_accumulator",j.state[3],committed);n05_check(s,"after_death_valid",tm_validate(j.state),0);
            // A new event after recovery cannot reuse the spent reservation.
            n05_append_index(&j,committed,s);n05_check(s,"continuation_preserves_attempt_charge",j.attempts,2);
            n05_check(s,"continuation_retains_incomplete",j.incomplete,incomplete);
        }
    }dt_close(&j);dt_free_words(config);nio_free(path);
}

// Diagnostic mutation only: exact preimage first, then a known file inside a new
// corruption fixture. ftruncate/openat Darwin numbers checked against host SDK.
fn n05_corrupt(root:i64,kind:i32)i32 {
    let name:[]u8="event-2.bin";if(kind==5){name="root.bin";}
    let fd:i64=nio_open_child(root,name,0);if(fd<0){return -1;}
    let b:[]u8=nio_alloc(1152);let n:i64=nio_read_exact(fd,b,1152);nio_close(fd);
    if(n<=0 || n>1152){nio_free(b);return -1;}
    if(n05_write(root,"preimage.bin",b[0..n as i32])!=0){nio_free(b);return -1;}
    let path:[]u8=nio_cstr(name);
    fd=_zag_darwin_syscall(463,root,_zag_slice_ptr(path) as i64,16777478,0,0,0);nio_free(path);
    if(fd<0 || nio_regular(fd)!=1){if(fd>=0){nio_close(fd);}nio_free(b);return -1;}
    let code:i32=0;
    if(kind==2){if(_zag_darwin_syscall(201,fd,1151,0,0,0,0)!=0){code=-1;}}
    else{
        if(kind==1){b[172]=(b[172] as i32+1) as u8;}
        if(kind==3){dt_put(b,24,50001);dt_put(b,132,50001);}
        if(kind==4){dt_put(b,28,0);}
        if(kind==5){dt_put(b,8,2);if(ns_sha256(b[0..96],b[96..128])!=0){code=-1;}}
        if(kind==6){dt_put(b,16,3);}
        if(kind==7){dt_put(b,480,65);}
        if(kind==8){dt_put(b,8,2);}
        if(kind!=1 && kind!=5){if(dt_digest(b,b[64..96])!=0){code=-1;}}
        if(code==0 && (nio_seek(fd,0,0)!=0 || nio_write_all(fd,b[0..n as i32])!=n)){code=-1;}
    }
    if(nio_sync(fd)!=0 || nio_close(fd)!=0 || nio_sync(root)!=0){code=-1;}nio_free(b);return code;
}
fn n05_corruption(kind:i32,replay:i32,s:*N05Checks)void {
    let config:[]i32=n05_config();let name:[]u8=n05_named("corrupt",kind,"");let path:[]u8=n05_path(name);
    if(replay==0){n05_check(s,"create",dt_create(path,config),0);}
    let j:DurableTelemetry=dt_recover(path,config);
    if(replay==0){
        n05_check(s,"setup_recover",j.status,0);
        if(j.status==0){let i:i32=0;while(i<3 && s.*.failed==0){n05_append_index(&j,i,s);i=i+1;}
            if(s.*.failed==0){n05_check(s,"preserve_and_corrupt",n05_corrupt(j.root,kind),0);}}
    }else{
        let expected:i32=-8104;if(kind==1){expected=-8103;}
        if(kind==2 || kind==5 || kind==8){expected=-8101;}if(kind==7){expected=-8102;}
        n05_check(s,"fresh_corruption_rejected",j.status,expected);
        n05_check(s,"no_invalid_accumulator",j.state.len,0);n05_check(s,"no_invalid_causal",j.causal.len,0);
        n05_check(s,"closed_root",j.root,-1);n05_check(s,"closed_lock",j.lock,-1);
    }dt_close(&j);dt_free_words(config);nio_free(name);nio_free(path);
}
fn n05_has(bytes:[]u8,needle:[]u8)i32 {
    if(needle.len<1 || bytes.len<needle.len){return 0;}let i:i32=0;
    while(i<=bytes.len-needle.len){let k:i32=0;while(k<needle.len && bytes[i+k]==needle[k]){k=k+1;}
        if(k==needle.len){return 1;}i=i+1;}return 0;
}
fn n05_child_checks(bytes:[]u8)i32 {
    let prefix:[]u8="N05B_CHILD_COUNTS,";let i:i32=0;let count:i32=-1;
    while(i+prefix.len<bytes.len){let k:i32=0;
        while(k<prefix.len && bytes[i+k]==prefix[k]){k=k+1;}
        if(k==prefix.len){if(count>=0){return -1;}let at:i32=i+k;let v:i32=0;let digits:i32=0;
            while(at<bytes.len && bytes[at]>=48 && bytes[at]<=57 && digits<6){v=v*10+(bytes[at] as i32)-48;at=at+1;digits=digits+1;}
            if(digits<1 || at+2>=bytes.len || bytes[at]!=44 || bytes[at+1]!=48 || bytes[at+2]!=10){return -1;}count=v;
        }i=i+1;
    }return count;
}
fn n05_run(root:i64,mode:[]u8,kind:i32,s:*N05Checks)void {
    if(s.*.failed!=0){return;}
    let deadline:i64=15000;if(kind==2){deadline=1000;}
    let r:NativeRunV3=nrv3_run(root,"Research/R33_NATIVE_N05B_DURABLE_TELEMETRY/BUILD_02/n05b",mode,mode,deadline,262144);
    s.*.children=s.*.children+1;s.*.cpu=s.*.cpu+r.cpu_us;
    if(r.wall_measurement_valid==1){s.*.wall=s.*.wall+r.wall_us_nonmonotonic;}
    if(r.peak_rss>s.*.rss){s.*.rss=r.peak_rss;}
    let status:i64=0;let exit:i32=0;let signal:i32=0;
    if(kind==1){exit=73;}if(kind==2){status=-7608;exit=-1;signal=9;}if(kind==3){exit=2;}
    n05_check(s,"child_status",r.status,status);n05_check(s,"child_started",r.started,1);
    n05_check(s,"child_reaped",r.reaped,1);n05_check(s,"child_exit",r.exit_code,exit);
    n05_check(s,"child_signal",r.signal,signal);n05_check(s,"child_stderr_empty",r.stderr_bytes,0);
    n05_check(s,"child_rss_bound",(r.peak_rss>0 && r.peak_rss<=268435456) as i32,1);
    let bytes:[]u8=nio_alloc(262144);let name:[]u8=_zag_str_concat(mode,".stdout");
    let fd:i64=nio_open_child(root,name,0);let got:i64=nio_read_exact(fd,bytes,262144);
    if(fd>=0){nio_close(fd);}nio_free(name);
    n05_check(s,"captured_complete_output",got,r.stdout_bytes);
    if(got>=0 && got<=262144){let log:[]u8=bytes[0..got as i32];
        if(kind==0){n05_check(s,"child_terminal_pass",n05_has(log,"N05B_CHILD_PASS\n"),1);
            let count:i32=n05_child_checks(log);n05_check(s,"native_assertion_counter",(count>0) as i32,1);
            if(count>0){s.*.child_checks=s.*.child_checks+count;}
        }
        if(kind==1){n05_check(s,"registered_crash_marker",n05_has(log,"N05B_CRASH,"),1);}
        if(kind==2){n05_check(s,"half_write_before_sigkill",n05_has(log,"N05B_HALF_WRITE_READY_FOR_SIGKILL\n"),1);}
        if(kind==3){n05_check(s,"invalid_no_output",got,0);}
    }nio_free(bytes);
}
fn n05_json_field(b:[]u8,key:[]u8,value:i64)[]u8 {
    let number:[]u8=_zag_i64_to_str(value);let one:[]u8=_zag_str_concat(b,key);
    let out:[]u8=_zag_str_concat(one,number);nio_free(one);nio_free(number);nio_free(b);return out;
}
fn n05_supervise()i32 {
    if(nio_guard(60)!=0){return 3;}
    let admitted:NativeAdmissionV3=nrv3_admit_root("Research/R33_NATIVE_N05B_RUN_PRIMARY_V1");
    if(admitted.status!=0){return 4;}let root:i64=admitted.root;let s:N05Checks=n05_stats();
    n05_run(root,"invalid",3,&s);n05_run(root,"abi",0,&s);
    n05_run(root,"normal-write",0,&s);n05_run(root,"normal-replay",0,&s);
    n05_run(root,"refusals",0,&s);n05_run(root,"capacity-write",0,&s);n05_run(root,"capacity-replay",0,&s);
    n05_run(root,"attempts-write",0,&s);n05_run(root,"attempts-replay",0,&s);
    let i:i32=1;while(i<=5 && s.failed==0){
        let writer:[]u8=n05_named("crash",i,"-write");let reader:[]u8=n05_named("crash",i,"-replay");
        n05_run(root,writer,1,&s);n05_run(root,reader,0,&s);nio_free(writer);nio_free(reader);i=i+1;
    }
    n05_run(root,"kill-write",2,&s);n05_run(root,"kill-replay",0,&s);
    n05_run(root,"syncfail-write",0,&s);n05_run(root,"syncfail-replay",0,&s);
    n05_run(root,"indeterminate-write",0,&s);n05_run(root,"indeterminate-replay",0,&s);
    i=1;while(i<=8 && s.failed==0){
        let writer:[]u8=n05_named("corrupt",i,"-write");let reader:[]u8=n05_named("corrupt",i,"-replay");
        n05_run(root,writer,0,&s);n05_run(root,reader,0,&s);nio_free(writer);nio_free(reader);i=i+1;
    }
    n05_check(&s,"planned_children_completed",s.children,41);
    let json:[]u8=_zag_str_concat("{\n  \"experiment\": \"R33-N05B\",\n  \"planned_children\": 41","");
    json=n05_json_field(json,",\n  \"completed_children\": ",s.children);
    json=n05_json_field(json,",\n  \"parent_failures\": ",s.failed);
    json=n05_json_field(json,",\n  \"verified_child_checks\": ",s.child_checks);
    json=n05_json_field(json,",\n  \"parent_checks_before_result_write\": ",s.checks);
    json=n05_json_field(json,",\n  \"summed_child_cpu_us\": ",s.cpu);
    json=n05_json_field(json,",\n  \"summed_observed_child_wall_us\": ",s.wall);
    json=n05_json_field(json,",\n  \"peak_child_rss_bytes\": ",s.rss);
    let tail:[]u8=_zag_str_concat(json,",\n  \"training\": false,\n  \"canonical_mutation\": false,\n  \"requires_terminal_pass_marker\": true\n}\n");nio_free(json);
    n05_check(&s,"native_result_saved",n05_write(root,"NATIVE_RESULT.json",tail),0);_zag_print(tail);nio_free(tail);
    n05_check(&s,"close_root",nio_close(root),0);
    _zag_print("N05B_PARENT_FAILURES,");_zag_println(_zag_i64_to_str(s.failed as i64));
    if(s.failed!=0){return 1;}_zag_println("R33_N05B_DURABLE_TELEMETRY_ENGINEERING_PASS");return 0;
}
fn main()i32 {
    if(_zag_argc()!=2){return 2;}let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"supervise")==1){return n05_supervise();}
    if(_zag_strcmp(mode,"invalid")==1){return 2;}
    // The supervisor already lowered the hard output ceiling. Do not attempt
    // to raise it with nio_guard here; only install the child's own timer.
    if(nio_deadline(15)!=0){return 3;}
    let s:N05Checks=n05_stats();let handled:i32=1;
    if(_zag_strcmp(mode,"abi")==1){n05_abi(&s);}
    else if(_zag_strcmp(mode,"normal-write")==1){n05_normal(0,&s);}
    else if(_zag_strcmp(mode,"normal-replay")==1){n05_normal(1,&s);}
    else if(_zag_strcmp(mode,"refusals")==1){n05_refusals(&s);}
    else if(_zag_strcmp(mode,"capacity-write")==1){n05_capacity(0,&s);}
    else if(_zag_strcmp(mode,"capacity-replay")==1){n05_capacity(1,&s);}
    else if(_zag_strcmp(mode,"attempts-write")==1){n05_attempts(0,&s);}
    else if(_zag_strcmp(mode,"attempts-replay")==1){n05_attempts(1,&s);}
    else if(_zag_strcmp(mode,"kill-write")==1){n05_fault("kill",7,0,&s);}
    else if(_zag_strcmp(mode,"kill-replay")==1){n05_fault("kill",7,1,&s);}
    else if(_zag_strcmp(mode,"syncfail-write")==1){n05_fault("syncfail",8,0,&s);}
    else if(_zag_strcmp(mode,"syncfail-replay")==1){n05_fault("syncfail",8,1,&s);}
    else if(_zag_strcmp(mode,"indeterminate-write")==1){n05_fault("indeterminate",9,0,&s);}
    else if(_zag_strcmp(mode,"indeterminate-replay")==1){n05_fault("indeterminate",9,1,&s);}
    else{handled=0;let i:i32=1;
        while(i<=8 && handled==0){
            let writer:[]u8=n05_named("corrupt",i,"-write");let reader:[]u8=n05_named("corrupt",i,"-replay");
            if(_zag_strcmp(mode,writer)==1){n05_corruption(i,0,&s);handled=1;}
            if(_zag_strcmp(mode,reader)==1){n05_corruption(i,1,&s);handled=1;}
            nio_free(writer);nio_free(reader);i=i+1;
        }
        i=1;while(i<=5 && handled==0){
            let writer:[]u8=n05_named("crash",i,"-write");let reader:[]u8=n05_named("crash",i,"-replay");
            let name:[]u8=n05_named("crash",i,"");
            if(_zag_strcmp(mode,writer)==1){n05_fault(name,i,0,&s);handled=1;}
            if(_zag_strcmp(mode,reader)==1){n05_fault(name,i,1,&s);handled=1;}
            nio_free(writer);nio_free(reader);nio_free(name);i=i+1;
        }
    }
    if(handled==0){return 2;}
    _zag_print("N05B_CHILD_COUNTS,");_zag_print(_zag_i64_to_str(s.checks as i64));_zag_print(",");_zag_println(_zag_i64_to_str(s.failed as i64));
    if(s.failed!=0){return 1;}_zag_println("N05B_CHILD_PASS");return 0;
}

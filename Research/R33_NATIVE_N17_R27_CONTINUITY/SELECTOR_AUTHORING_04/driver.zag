// R33-N17 selector authoring inspector V4.
// Bounded, read-only inert-map traversal for R26 digest-consumed structures.
// No Python, reducer/class execution, semantic digest, historical verifier,
// learner, training, promotion, or accepted-parent mutation.
@import("../identity.zag")

fn a4_field(p:*ParentMap,id:i32,index:i32)i64 {
    if(id<1 || id>p.*.node_count || index<0 || index>=10){return -1;}
    return p.*.nodes[(id-1)*10+index];
}

fn a4_start(p:*ParentMap,id:i32)i64 {return a4_field(p,id,1);}
fn a4_len(p:*ParentMap,id:i32)i64 {return a4_field(p,id,2);}

fn a4_container(p:*ParentMap,id:i32)i32 {
    let k:i32=pm_kind(p,id);if(k==15 || k==16){let s:i32=pm_build_state(p,id);if(s>0){return s;}}
    return id;
}

fn a4_ref(p:*ParentMap,label:[]u8,id:i32)void {
    _zag_print("N17A4_REF,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(id as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(pm_kind(p,id) as i64));_zag_print(",");
    _zag_print(_zag_i64_to_str(a4_start(p,id)));_zag_print(",");
    _zag_println(_zag_i64_to_str(a4_len(p,id)));
}

fn a4_int(p:*ParentMap,id:i32)i64 {
    let x:i64=0;if(pm_small_int(p,id,&x)==0){return x;}return -9223372036854775807;
}

fn a4_dict(p:*ParentMap,label:[]u8,id:i32,limit:i32)void {
    let d:i32=a4_container(p,id);let k:i32=pm_kind(p,d);let count:i64=-1;
    if(k==11){count=a4_field(p,d,9);}
    _zag_print("N17A4_DICT,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(id as i64));_zag_print(",");_zag_print(_zag_i64_to_str(d as i64));
    _zag_print(",");_zag_print(_zag_i64_to_str(k as i64));_zag_print(",");_zag_println(_zag_i64_to_str(count));
    if(k!=11){return;}
    let e:i32=a4_field(p,d,7) as i32;let seen:i32=0;
    while(e>0 && seen<p.*.edge_count && seen<limit){
        let r:i32=(e-1)*4;let op:i32=p.*.edges[r+3] as i32;
        if(op==2){
            let key:i32=p.*.edges[r] as i32;let value:i32=p.*.edges[r+1] as i32;
            _zag_print("N17A4_KV,");_zag_print(label);_zag_print(",");_zag_print(_zag_i64_to_str(seen as i64));
            _zag_print(",");_zag_print(_zag_i64_to_str(key as i64));_zag_print(",");_zag_print(_zag_i64_to_str(pm_kind(p,key) as i64));
            _zag_print(",");_zag_print(_zag_i64_to_str(a4_start(p,key)));_zag_print(",");_zag_print(_zag_i64_to_str(a4_len(p,key)));
            _zag_print(",");_zag_print(_zag_i64_to_str(value as i64));_zag_print(",");_zag_print(_zag_i64_to_str(pm_kind(p,value) as i64));
            _zag_print(",");_zag_print(_zag_i64_to_str(a4_start(p,value)));_zag_print(",");_zag_print(_zag_i64_to_str(a4_len(p,value)));
            _zag_print(",");_zag_print(_zag_i64_to_str(a4_int(p,value)));
            if(pm_kind(p,key)==6){_zag_print(",");_zag_print(pm_raw(p,key));}
            _zag_println("");
        }
        e=p.*.edges[r+2] as i32;seen=seen+1;
    }
}

fn a4_list(p:*ParentMap,label:[]u8,id:i32,limit:i32)void {
    let k:i32=pm_kind(p,id);let count:i64=-1;if(k==9 || k==10){count=a4_field(p,id,9);}
    _zag_print("N17A4_LIST,");_zag_print(label);_zag_print(",");_zag_print(_zag_i64_to_str(id as i64));
    _zag_print(",");_zag_print(_zag_i64_to_str(k as i64));_zag_print(",");_zag_println(_zag_i64_to_str(count));
    if(!(k==9 || k==10)){return;}let e:i32=a4_field(p,id,7) as i32;let seen:i32=0;
    while(e>0 && seen<p.*.edge_count && seen<limit){
        let r:i32=(e-1)*4;if(p.*.edges[r+3]==1){let v:i32=p.*.edges[r] as i32;
            _zag_print("N17A4_ITEM,");_zag_print(label);_zag_print(",");_zag_print(_zag_i64_to_str(seen as i64));
            _zag_print(",");_zag_print(_zag_i64_to_str(v as i64));_zag_print(",");_zag_print(_zag_i64_to_str(pm_kind(p,v) as i64));
            _zag_print(",");_zag_print(_zag_i64_to_str(a4_start(p,v)));_zag_print(",");_zag_println(_zag_i64_to_str(a4_len(p,v)));
        }e=p.*.edges[r+2] as i32;seen=seen+1;
    }
}

fn a4_module_params(p:*ParentMap,label:[]u8,module:i32)void {
    a4_ref(p,label,module);let params:i32=pm_lookup(p,module,"_parameters");let modules:i32=pm_lookup(p,module,"_modules");
    a4_dict(p,"module.parameters",params,32);a4_dict(p,"module.modules",modules,32);
    if(pm_kind(p,params)==11){let e:i32=a4_field(p,params,7) as i32;let seen:i32=0;
        while(e>0 && seen<p.*.edge_count && seen<32){let r:i32=(e-1)*4;if(p.*.edges[r+3]==2){
            let key:i32=p.*.edges[r] as i32;let value:i32=p.*.edges[r+1] as i32;
            _zag_print("N17A4_PARAM,");_zag_print(label);_zag_print(",");if(pm_kind(p,key)==6){_zag_print(pm_raw(p,key));}else{_zag_print("<nontext>");}
            _zag_print(",");_zag_print(_zag_i64_to_str(value as i64));_zag_print(",");_zag_print(_zag_i64_to_str(pm_kind(p,value) as i64));
            _zag_print(",");_zag_print(_zag_i64_to_str(a4_start(p,value)));_zag_print(",");_zag_println(_zag_i64_to_str(a4_len(p,value)));
        }e=p.*.edges[r+2] as i32;seen=seen+1;}
    }
}

fn a4_graph(p:*ParentMap,nodes:i32)void {
    if(pm_kind(p,nodes)!=9){return;}let e:i32=a4_field(p,nodes,7) as i32;let ni:i32=0;
    while(e>0 && ni<32){let r:i32=(e-1)*4;if(p.*.edges[r+3]==1){let node:i32=p.*.edges[r] as i32;let views:i32=pm_lookup(p,node,"views");
        _zag_print("N17A4_GRAPH_NODE,");_zag_print(_zag_i64_to_str(ni as i64));_zag_print(",");_zag_print(_zag_i64_to_str(node as i64));
        _zag_print(",");_zag_println(_zag_i64_to_str(views as i64));a4_list(p,"graph.views",views,64);
    }e=p.*.edges[r+2] as i32;ni=ni+1;}
}

fn a4_reducer_arg_dicts(p:*ParentMap,label:[]u8,dict:i32)void {
    if(pm_kind(p,dict)!=11){return;}let e:i32=a4_field(p,dict,7) as i32;let di:i32=0;
    while(e>0 && di<32){let r:i32=(e-1)*4;if(p.*.edges[r+3]==2){let value:i32=p.*.edges[r+1] as i32;
        if(pm_kind(p,value)==16){let args:i32=a4_field(p,value,5) as i32;a4_list(p,"reducer.args",args,8);
            if(pm_kind(p,args)==10){let ae:i32=a4_field(p,args,7) as i32;if(ae>0){let ar:i32=(ae-1)*4;let first:i32=p.*.edges[ar] as i32;
                _zag_print("N17A4_ARG_DICT,");_zag_print(label);_zag_print(",");_zag_print(_zag_i64_to_str(di as i64));_zag_print(",");_zag_println(_zag_i64_to_str(first as i64));
                a4_dict(p,"reducer.arg.dict",first,512);
            }}
        }
    }e=p.*.edges[r+2] as i32;di=di+1;}
}

fn a4_centroids(p:*ParentMap,label:[]u8,model:i32)void {
    let c:i32=pm_lookup(p,model,"centroids");a4_dict(p,label,c,256);if(pm_kind(p,c)!=11){return;}
    let e:i32=a4_field(p,c,7) as i32;let seen:i32=0;while(e>0 && seen<256){let r:i32=(e-1)*4;if(p.*.edges[r+3]==2){let inner:i32=p.*.edges[r+1] as i32;a4_dict(p,"centroid.motifs",inner,512);}e=p.*.edges[r+2] as i32;seen=seen+1;}
}

fn main()i32 {
    let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 3;}
    let ic:i32=n17_identity(&p);_zag_print("N17A4_IDENTITY_CODE,");_zag_println(_zag_i64_to_str(ic as i64));if(ic!=0){mi_loaded_close(&p);return 4;}
    let r27:i32=p.root;let r26:i32=pm_lookup(&p,r27,"base_state");let vep:i32=pm_lookup(&p,r26,"video_entity_policy");
    let eh:i32=pm_lookup(&p,vep,"entity_head");let outer:i32=pm_lookup(&p,eh,"net");let outermods:i32=pm_lookup(&p,outer,"_modules");
    if(pm_kind(p,outermods)==11){let e:i32=a4_field(&p,outermods,7) as i32;if(e>0){let r:i32=(e-1)*4;let seq:i32=p.edges[r+1] as i32;let mods:i32=pm_lookup(&p,seq,"_modules");
        if(pm_kind(p,mods)==11){let me:i32=a4_field(&p,mods,7) as i32;let seen:i32=0;while(me>0 && seen<16){let mr:i32=(me-1)*4;if(p.edges[mr+3]==2){a4_module_params(&p,"R26.entity_head.child",p.edges[mr+1] as i32);}me=p.edges[mr+2] as i32;seen=seen+1;}}
    }}
    let graph:i32=pm_lookup(&p,vep,"graph");a4_graph(&p,pm_lookup(&p,graph,"nodes"));
    let nm:i32=pm_lookup(&p,vep,"name_memory");a4_reducer_arg_dicts(&p,"R26.name_memory.docs",pm_lookup(&p,nm,"docs"));
    let ap:i32=pm_lookup(&p,r26,"abstraction_policy");let models:i32=pm_lookup(&p,ap,"models");
    a4_centroids(&p,"R26.abstraction.s2g.centroids",pm_lookup(&p,models,"specific_to_general"));
    a4_centroids(&p,"R26.abstraction.g2s.centroids",pm_lookup(&p,models,"general_to_specific"));
    mi_loaded_close(&p);return 0;
}

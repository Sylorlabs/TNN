@import("../identity.zag")
fn br(p:*ParentMap,id:[]u8,node:i32,ok:i32,f:*i32)void {
 _zag_print("B_ROW,");_zag_print(id);_zag_print(",");if(ok==1){_zag_print("PASS");}else{_zag_print("FAIL");f.*=f.*+1;}_zag_print(",");let n:[]u8=_zag_i64_to_str(node as i64);_zag_print(n);nio_free(n);_zag_print(",");let k:[]u8=_zag_i64_to_str(pm_kind(p,node) as i64);_zag_println(k);nio_free(k);
}
fn bt(p:*ParentMap,id:i32,s:[]u8)i32 {return (pm_kind(p,id)==6 && nio_equal(pm_raw(p,id),s)==1) as i32;}
fn bf(p:*ParentMap,id:i32)u64 {if(pm_kind(p,id)!=5){return 0xffffffffffffffff;}let b:[]u8=pm_raw(p,id);if(b.len!=8 || b[0]>=128){return 0xffffffffffffffff;}let x:u64=0;let i:i32=0;while(i<8){x=(x<<8)|(b[i] as u64);i=i+1;}if(x>0x3ff0000000000000){return 0xffffffffffffffff;}return x;}
fn bge(p:*ParentMap,id:i32,x:u64)i32 {let v:u64=bf(p,id);return (v!=0xffffffffffffffff && v>=x) as i32;}
fn blt(p:*ParentMap,id:i32,x:u64)i32 {let v:u64=bf(p,id);return (v!=0xffffffffffffffff && v<x) as i32;}
fn bb(p:*ParentMap,id:i32,v:i64)i32 {return (pm_kind(p,id)==2 && p.*.nodes[(id-1)*10+6]==v) as i32;}
fn bkeys(p:*ParentMap,id:i32,count:i32)i32 {if(pm_kind(p,id)!=11){return 0;}let n:i32=p.*.nodes[(id-1)*10+9] as i32;if(count>=0 && n!=count){return 0;}let e:i32=p.*.nodes[(id-1)*10+7] as i32;let seen:i32=0;let mask:i64=0;while(e>0 && seen<n){let r:i32=(e-1)*4;let x:i64=0;if(p.*.edges[r+3]!=2 || pm_small_int(p,p.*.edges[r] as i32,&x)!=0){return 0;}if(count>=0){if(x<0 || x>=count || (mask&(1<<x))!=0){return 0;}mask=mask|(1<<x);}e=p.*.edges[r+2] as i32;seen=seen+1;}return (e==0 && seen==n) as i32;}
fn bsub(p:*ParentMap,id:i32,key:[]u8)i32 {return pm_lookup(p,id,key);}
fn main()i32 {
 let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 3;}if(n17_identity(&p)!=0){mi_loaded_close(&p);return 4;}let f:i32=0;let a:i32=p.root;let z:i32=bsub(&p,a,"base_state");let e:i32=bsub(&p,a,"evidence");let q:i32=bsub(&p,z,"evidence");let n:i32=0;
 n=bsub(&p,a,"format");br(&p,"R27-02",n,bt(&p,n,"TNN_PRE_V1_R27_GENERAL_LEARNING"),&f);
 n=bsub(&p,a,"newborn_restarts");br(&p,"R27-03",n,n17_int_is(&p,n,0),&f);n=bsub(&p,a,"development_step");br(&p,"R27-04",n,n17_int_is(&p,n,60423),&f);
 n=bsub(&p,bsub(&p,bsub(&p,a,"abstraction_policy"),"model"),"centroids");br(&p,"R27-10",n,bkeys(&p,n,-1),&f);
 n=bsub(&p,bsub(&p,e,"category_large15"),"clean_accuracy");br(&p,"R27-11",n,blt(&p,n,0x3fe999999999999a),&f);
 n=bsub(&p,bsub(&p,e,"category_dose"),"gain");br(&p,"R27-12",n,bge(&p,n,0x3fb999999999999a),&f);
 n=bsub(&p,bsub(&p,e,"category_metric"),"decision");br(&p,"R27-13",n,bt(&p,n,"ROLLBACK"),&f);n=bsub(&p,bsub(&p,e,"affordance"),"decision");br(&p,"R27-14",n,bt(&p,n,"PARTIAL"),&f);
 let speech:i32=bsub(&p,e,"speech");n=bsub(&p,speech,"word_accuracy");let control:i32=bsub(&p,speech,"vad_control_accuracy");br(&p,"R27-15",n,(bge(&p,n,0x3fe6666666666666)==1 && bf(&p,n)<bf(&p,control) && bf(&p,control)!=0xffffffffffffffff) as i32,&f);
 n=bsub(&p,a,"speech_motif_decoder");br(&p,"R27-16",n,(pm_kind(&p,n)==1) as i32,&f);n=bsub(&p,bsub(&p,e,"semantic_generation"),"decision");br(&p,"R27-17",n,bt(&p,n,"RETAIN_R23_R25_GENERATOR"),&f);
 n=bsub(&p,bsub(&p,e,"video_noise"),"decision");br(&p,"R27-19",n,bt(&p,n,"RETAIN_R26_HEAD"),&f);n=bsub(&p,bsub(&p,e,"visual_debate"),"decision");br(&p,"R27-20",n,bt(&p,n,"PARTIAL"),&f);
 n=bsub(&p,bsub(&p,a,"category_system"),"active");br(&p,"R27-21",n,bb(&p,n,0),&f);n=bsub(&p,a,"affordance_model");br(&p,"R27-22",n,(pm_kind(&p,n)==1) as i32,&f);
 n=bsub(&p,z,"format");br(&p,"R26-02",n,bt(&p,n,"TNN_PRE_V1_R26_VIDEO_ARCHITECTURE"),&f);n=bsub(&p,z,"development_step");br(&p,"R26-04",n,n17_int_is(&p,n,60249),&f);n=bsub(&p,z,"newborn_restarts");br(&p,"R26-05",n,n17_int_is(&p,n,0),&f);
 let video:i32=bsub(&p,q,"video");n=bsub(&p,video,"trained_object_clean_accuracy");br(&p,"R26-10",n,bge(&p,n,0x3feccccccccccccd),&f);n=bsub(&p,video,"trained_object_accuracy");br(&p,"R26-11",n,bge(&p,n,0x3fe4cccccccccccd),&f);n=bsub(&p,video,"graph_gain");br(&p,"R26-12",n,bge(&p,n,0x3fa999999999999a),&f);
 n=bsub(&p,bsub(&p,bsub(&p,z,"video_entity_policy"),"graph"),"nodes");br(&p,"R26-13",n,(pm_kind(&p,n)==9 && p.nodes[(n-1)*10+9]==8) as i32,&f);
 n=bsub(&p,video,"one_shot_name_new_view_accuracy");br(&p,"R26-14",n,(bf(&p,n)==0x3ff0000000000000) as i32,&f);n=bsub(&p,video,"one_shot_name_noisy_view_accuracy");br(&p,"R26-15",n,bge(&p,n,0x3fe8000000000000),&f);
 n=bsub(&p,bsub(&p,q,"speech_local"),"learned_no_vad_word_accuracy");br(&p,"R26-24",n,(bf(&p,n)==0) as i32,&f);n=bsub(&p,bsub(&p,q,"speech_ctc"),"word_accuracy");br(&p,"R26-25",n,(bf(&p,n)==0) as i32,&f);n=bsub(&p,z,"speech_segmenter");br(&p,"R26-26",n,(pm_kind(&p,n)==1) as i32,&f);
 n=bsub(&p,bsub(&p,z,"architecture"),"continuous_speech_r26");br(&p,"R26-27",n,bt(&p,n,"local no-VAD and sequence-CTC candidates failed; R25 generic VAD control retained"),&f);
 n=bsub(&p,bsub(&p,q,"abstraction_lattice"),"training_plateau");br(&p,"R26-28",n,bb(&p,n,1),&f);n=bsub(&p,bsub(&p,q,"abstraction_lattice"),"decision");br(&p,"R26-29",n,(pm_kind(&p,n)==6 && bt(&p,n,"PROMOTE_HYPOTHESIS_LATTICE")==0) as i32,&f);
 let master:i32=bsub(&p,q,"abstraction_master");n=bsub(&p,master,"specific_to_general");br(&p,"R26-30",n,bge(&p,n,0x3feccccccccccccd),&f);n=bsub(&p,master,"general_to_specific");br(&p,"R26-31",n,(bge(&p,n,0x3fe3333333333333)==1 && blt(&p,n,0x3fe999999999999a)==1) as i32,&f);
 n=bsub(&p,bsub(&p,bsub(&p,bsub(&p,z,"abstraction_policy"),"models"),"specific_to_general"),"centroids");br(&p,"R26-32",n,bkeys(&p,n,6),&f);
 n=bsub(&p,bsub(&p,q,"semantic_generation"),"decision");br(&p,"R26-33",n,bt(&p,n,"KEEP_R23_GENERATOR"),&f);let siblings:i32=bsub(&p,q,"siblings");n=bsub(&p,siblings,"gain");br(&p,"R26-35",n,bge(&p,n,0x3fd0000000000000),&f);n=bsub(&p,siblings,"after");br(&p,"R26-36",n,blt(&p,n,0x3fe0000000000000),&f);n=bsub(&p,siblings,"echo_after_direct_truth");br(&p,"R26-37",n,bb(&p,n,1),&f);
 _zag_println("B_TERMINAL_CLAIM_ALLOWED,FALSE");mi_loaded_close(&p);return (f!=0) as i32;

@import("r27_native_state_semantics_v1.zag")
@import("../R33_NATIVE_SHA256_V2.zag")

// R33-N17 historical R27 -> native continuing-state admission gate V2.
// V1 accepted caller-supplied digest strings. V2 hashes the actual parent,
// accepted policy and recovered native source bytes itself before considering
// any historical witness. Historical check totals never grant behavioral
// continuity. Full admission remains fail-closed until exact R25 byte-level
// lineage and native behavioral projection are independently qualified.

const R27MA2_OK:i32=0;
const R27MA2_BAD:i32=-27301;
const R27MA2_PARENT_IDENTITY:i32=-27302;
const R27MA2_POLICY_IDENTITY:i32=-27303;
const R27MA2_SOURCE_IDENTITY:i32=-27304;
const R27MA2_IMAGE:i32=-27305;
const R27MA2_STEP_MISMATCH:i32=-27306;
const R27MA2_WITNESS:i32=-27307;
const R27MA2_LINEAGE_PENDING:i32=-27308;
const R27MA2_BEHAVIOR_PENDING:i32=-27309;

const R27MA2_PARENT_BYTES:i32=15871908;
const R27MA2_POLICY_BYTES:i32=712;
const R27MA2_SOURCE_BYTES:i32=37910;
const R27MA2_DEVELOPMENT_STEP:i32=60423;
const R27MA2_RESTARTS:i32=0;
const R27MA2_R27_CHECKS:i32=33;
const R27MA2_R26_CHECKS:i32=47;
const R27MA2_R25_CHECKS:i32=68;

struct R27HistoricalWitnessV2 {
    development_step:i32,
    newborn_restarts:i32,
    r27_verifier_checks:i32,
    r26_regression_checks:i32,
    r25_lineage_checks:i32,
    r25_native_bytes_recomputed:i32,
}

fn r27ma2_hex_nibble(c:u8)i32 @noalloc {
    if(c>=48 && c<=57){return (c-48) as i32;}
    if(c>=97 && c<=102){return (c-87) as i32;}
    if(c>=65 && c<=70){return (c-55) as i32;}
    return -1;
}

fn r27ma2_digest_matches_hex(digest:[]u8,hex:[]u8)i32 @noalloc {
    if(digest.len!=32 || hex.len!=64){return 0;}
    let i:i32=0;while(i<32){
        let hi:i32=r27ma2_hex_nibble(hex[i*2]);let lo:i32=r27ma2_hex_nibble(hex[i*2+1]);
        if(hi<0 || lo<0 || digest[i]!=((hi<<4)|lo) as u8){return 0;}i=i+1;
    }
    return 1;
}

fn r27ma2_hash_matches(input:[]u8,expected_hex:[]u8)i32 {
    let digest:[]u8=nio_alloc(32);if(digest.len!=32){return 0;}
    let ok:i32=(ns_sha256(input,digest)==0 && r27ma2_digest_matches_hex(digest,expected_hex)==1) as i32;
    nio_free(digest);return ok;
}

fn r27ma2_witness_ok(w:*R27HistoricalWitnessV2)i32 @noalloc {
    if(w==null as *R27HistoricalWitnessV2){return 0;}
    return (w.*.development_step==R27MA2_DEVELOPMENT_STEP && w.*.newborn_restarts==R27MA2_RESTARTS &&
        w.*.r27_verifier_checks==R27MA2_R27_CHECKS && w.*.r26_regression_checks==R27MA2_R26_CHECKS &&
        w.*.r25_lineage_checks==R27MA2_R25_CHECKS) as i32;
}

fn r27ma2_source_identity(parent_bytes:[]u8,policy_bytes:[]u8,native_source_bytes:[]u8)i32 {
    if(parent_bytes.len!=R27MA2_PARENT_BYTES ||
       r27ma2_hash_matches(parent_bytes,"31e670fcd2a2fefc02a1d032b8016bd93c28844df8ea40889593d030a2096e5a")!=1){return R27MA2_PARENT_IDENTITY;}
    if(policy_bytes.len!=R27MA2_POLICY_BYTES ||
       r27ma2_hash_matches(policy_bytes,"983db6a9c771f4952392d288459d65dfb04c33a7cbca37ac9f10a4365c7887a8")!=1){return R27MA2_POLICY_IDENTITY;}
    if(native_source_bytes.len!=R27MA2_SOURCE_BYTES ||
       r27ma2_hash_matches(native_source_bytes,"79b19f3856d7505ba09286c237fb3afb1ec016283d78678f76a3382e2d7b0bd7")!=1){return R27MA2_SOURCE_IDENTITY;}
    return R27MA2_OK;
}

fn r27ma2_image_witness(image:[]u8,witness:*R27HistoricalWitnessV2)i32 @noalloc {
    if(witness==null as *R27HistoricalWitnessV2){return R27MA2_BAD;}
    if(r27sv_validate(image)!=0){return R27MA2_IMAGE;}
    let image_step:i32=0;if(r27sv_scalar(image,R27S_DEVELOPMENT_STEP,&image_step)!=0){return R27MA2_IMAGE;}
    if(image_step!=R27MA2_DEVELOPMENT_STEP){return R27MA2_STEP_MISMATCH;}
    if(r27ma2_witness_ok(witness)!=1){return R27MA2_WITNESS;}
    return R27MA2_OK;
}

fn r27ma2_identity(parent_bytes:[]u8,policy_bytes:[]u8,native_source_bytes:[]u8,
    image:[]u8,witness:*R27HistoricalWitnessV2)i32 {
    let source_identity:i32=r27ma2_source_identity(parent_bytes,policy_bytes,native_source_bytes);
    if(source_identity!=R27MA2_OK){return source_identity;}
    return r27ma2_image_witness(image,witness);
}

fn r27ma2_admit(parent_bytes:[]u8,policy_bytes:[]u8,native_source_bytes:[]u8,
    image:[]u8,witness:*R27HistoricalWitnessV2)i32 {
    let identity:i32=r27ma2_identity(parent_bytes,policy_bytes,native_source_bytes,image,witness);
    if(identity!=R27MA2_OK){return identity;}
    // The historical 68/68 R25 witness is retained evidence but is not a fresh
    // native byte-level R25 recomputation. Do not silently upgrade it.
    if(witness.*.r25_native_bytes_recomputed!=1){return R27MA2_LINEAGE_PENDING;}
    // A later bridge must compare actual behavior/projection from the admitted
    // parent to the native image. No caller-supplied boolean can bypass this.
    return R27MA2_BEHAVIOR_PENDING;
}

@import("r27_projection_receipt_gate_v1.zag")
fn pr1t(name:[]u8,a:i32,e:i32)i32{_zag_print("R27_PR1_CHECK,");_zag_print(name);_zag_print(",");_zag_print(_zag_i64_to_str(a as i64));_zag_print(",");_zag_println(_zag_i64_to_str(e as i64));return (a!=e) as i32;}
fn main()i32{
 let f:i32=0;
 f=f+pr1t("surface_count",R27PR1_SURFACES,18);
 f=f+pr1t("exact_parent_custody",r27pr1_status(R27PR1_EXACT_PARENT),R27PR1_CUSTODY_CLOSED);
 f=f+pr1t("exact_parent_closed",r27pr1_surface_closed(R27PR1_EXACT_PARENT),1);
 f=f+pr1t("rng_authored_pending",r27pr1_status(R27PR1_RNG_STATE),R27PR1_AUTHORED_EXEC_PENDING);
 f=f+pr1t("classifier_authored_pending",r27pr1_status(R27PR1_CLASSIFIER_LEARNED_STATE),R27PR1_AUTHORED_EXEC_PENDING);
 f=f+pr1t("semantic_open",r27pr1_status(R27PR1_SEMANTIC_GENERATOR),R27PR1_OPEN);
 f=f+pr1t("open_count",r27pr1_open_count(),17);
 f=f+pr1t("unsupported_count",r27pr1_unsupported_count(),0);
 f=f+pr1t("projection_incomplete",r27pr1_complete(),0);
 f=f+pr1t("digest_not_ready",r27pr1_final_receipt_digest_ready(),0);
 f=f+pr1t("learn_authority_zero",r27pr1_learn_authority(),0);
 _zag_print("R27_PROJECTION_RECEIPT_GATE_V1_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));
 _zag_print("R27_PROJECTION_RECEIPT_GATE_V67_OPEN_SURFACES,");_zag_println(_zag_i64_to_str(r27pr1_open_count() as i64));return (f!=0) as i32;
}

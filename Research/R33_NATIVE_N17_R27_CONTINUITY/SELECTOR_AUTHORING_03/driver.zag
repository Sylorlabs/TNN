// R33-N17 selector authoring inspector V3.
// Bounded, read-only inert-map traversal. No Python/reducer/class execution,
// semantic digest, historical verifier, learner, training, promotion or
// accepted-parent mutation.
@import("../identity.zag")

fn n17a3_field(p:*ParentMap,id:i32,index:i32)i64 {
    if(id<1 || id>p.*.node_count || index<0 || index>=10){return -1;}
    return p.*.nodes[(id-1)*10+index];
}

fn n17a3_print_ref(p:*ParentMap,label:[]u8,id:i32)void {
    _zag_print("N17A3_REF,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(id as i64));_zag_print(",");
    _zag_println(_zag_i64_to_str(pm_kind(p,id) as i64));
}

fn n17a3_dump_words(p:*ParentMap,label:[]u8,id:i32)void {
    _zag_print("N17A3_WORDS,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(id as i64));
    let i:i32=0;while(i<10){_zag_print(",");_zag_print(_zag_i64_to_str(n17a3_field(p,id,i)));i=i+1;}
    _zag_println("");
}

fn n17a3_container_id(p:*ParentMap,id:i32)i32 {
    let k:i32=pm_kind(p,id);if(k==15 || k==16){let state:i32=pm_build_state(p,id);if(state>0){return state;}}
    return id;
}

fn n17a3_dump_container(p:*ParentMap,label:[]u8,id:i32,limit:i32)void {
    let target:i32=n17a3_container_id(p,id);let kind:i32=pm_kind(p,target);
    let count:i64=-1;if(kind==9 || kind==10 || kind==11 || kind==12 || kind==13){count=n17a3_field(p,target,9);}
    _zag_print("N17A3_CONTAINER,");_zag_print(label);_zag_print(",");
    _zag_print(_zag_i64_to_str(id as i64));_zag_print(",");_zag_print(_zag_i64_to_str(target as i64));
    _zag_print(",");_zag_print(_zag_i64_to_str(kind as i64));_zag_print(",");_zag_println(_zag_i64_to_str(count));
    if(!(kind==9 || kind==10 || kind==11 || kind==12 || kind==13)){return;}
    let e:i32=n17a3_field(p,target,7) as i32;let seen:i32=0;
    while(e>0 && seen<p.*.edge_count && seen<limit){
        let row:i32=(e-1)*4;let a:i32=p.*.edges[row] as i32;let b:i32=p.*.edges[row+1] as i32;let op:i32=p.*.edges[row+3] as i32;
        _zag_print("N17A3_EDGE,");_zag_print(label);_zag_print(",");_zag_print(_zag_i64_to_str(seen as i64));
        _zag_print(",");_zag_print(_zag_i64_to_str(op as i64));_zag_print(",");_zag_print(_zag_i64_to_str(a as i64));
        _zag_print(",");_zag_print(_zag_i64_to_str(pm_kind(p,a) as i64));_zag_print(",");_zag_print(_zag_i64_to_str(b as i64));
        _zag_print(",");_zag_print(_zag_i64_to_str(pm_kind(p,b) as i64));if(op==2 && pm_kind(p,a)==6){_zag_print(",");_zag_print(pm_raw(p,a));}
        _zag_println("");e=p.*.edges[row+2] as i32;seen=seen+1;
    }
}

fn n17a3_dump_module_children(p:*ParentMap,label:[]u8,module:i32)void {
    let params:i32=pm_lookup(p,module,"_parameters");let modules:i32=pm_lookup(p,module,"_modules");
    n17a3_print_ref(p,label,module);n17a3_dump_container(p,label,module,64);
    n17a3_dump_container(p,"module._parameters",params,64);n17a3_dump_container(p,"module._modules",modules,64);
    if(pm_kind(p,modules)!=11){return;}
    let e:i32=n17a3_field(p,modules,7) as i32;let seen:i32=0;
    while(e>0 && seen<p.*.edge_count && seen<32){
        let row:i32=(e-1)*4;if(p.*.edges[row+3]==2){
            let key:i32=p.*.edges[row] as i32;let child:i32=p.*.edges[row+1] as i32;
            _zag_print("N17A3_MODULE_CHILD,");_zag_print(label);_zag_print(",");if(pm_kind(p,key)==6){_zag_print(pm_raw(p,key));}else{_zag_print("<nontext>");}
            _zag_print(",");_zag_print(_zag_i64_to_str(child as i64));_zag_print(",");_zag_println(_zag_i64_to_str(pm_kind(p,child) as i64));
            n17a3_dump_container(p,"child._parameters",pm_lookup(p,child,"_parameters"),32);
            n17a3_dump_container(p,"child._modules",pm_lookup(p,child,"_modules"),32);
        }
        e=p.*.edges[row+2] as i32;seen=seen+1;
    }
}

fn n17a3_dump_list_members(p:*ParentMap,label:[]u8,list:i32)void {
    if(pm_kind(p,list)!=9 && pm_kind(p,list)!=10){return;}
    let e:i32=n17a3_field(p,list,7) as i32;let seen:i32=0;
    while(e>0 && seen<p.*.edge_count && seen<32){
        let row:i32=(e-1)*4;if(p.*.edges[row+3]==1){let child:i32=p.*.edges[row] as i32;
            _zag_print("N17A3_LIST_MEMBER,");_zag_print(label);_zag_print(",");_zag_print(_zag_i64_to_str(seen as i64));_zag_print(",");
            _zag_print(_zag_i64_to_str(child as i64));_zag_print(",");_zag_println(_zag_i64_to_str(pm_kind(p,child) as i64));
            n17a3_dump_container(p,"list.member",child,64);
        }e=p.*.edges[row+2] as i32;seen=seen+1;
    }
}

fn n17a3_dump_dict_reducers(p:*ParentMap,label:[]u8,dict:i32)void {
    if(pm_kind(p,dict)!=11){return;}let e:i32=n17a3_field(p,dict,7) as i32;let seen:i32=0;
    while(e>0 && seen<p.*.edge_count && seen<32){
        let row:i32=(e-1)*4;if(p.*.edges[row+3]==2){let value:i32=p.*.edges[row+1] as i32;
            if(pm_kind(p,value)==16){
                n17a3_dump_words(p,label,value);let args:i32=n17a3_field(p,value,5) as i32;let state:i32=n17a3_field(p,value,6) as i32;
                n17a3_print_ref(p,"reducer.args",args);n17a3_dump_container(p,"reducer.args",args,64);
                n17a3_print_ref(p,"reducer.state",state);n17a3_dump_container(p,"reducer.state",state,64);
            }
        }e=p.*.edges[row+2] as i32;seen=seen+1;
    }
}

fn main()i32 {
    let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 3;}
    let identity_code:i32=n17_identity(&p);_zag_print("N17A3_IDENTITY_CODE,");_zag_println(_zag_i64_to_str(identity_code as i64));if(identity_code!=0){mi_loaded_close(&p);return 4;}
    let r27:i32=p.root;let r26:i32=pm_lookup(&p,r27,"base_state");let vep:i32=pm_lookup(&p,r26,"video_entity_policy");
    let entity_head:i32=pm_lookup(&p,vep,"entity_head");let net:i32=pm_lookup(&p,entity_head,"net");n17a3_dump_module_children(&p,"R26.entity_head.net",net);
    let graph:i32=pm_lookup(&p,vep,"graph");let nodes:i32=pm_lookup(&p,graph,"nodes");n17a3_dump_container(&p,"R26.graph.nodes",nodes,32);n17a3_dump_list_members(&p,"R26.graph.nodes",nodes);
    let nm:i32=pm_lookup(&p,vep,"name_memory");let docs:i32=pm_lookup(&p,nm,"docs");n17a3_dump_container(&p,"R26.name_memory.docs",docs,32);n17a3_dump_dict_reducers(&p,"R26.name_memory.docs.value",docs);
    mi_loaded_close(&p);return 0;
}

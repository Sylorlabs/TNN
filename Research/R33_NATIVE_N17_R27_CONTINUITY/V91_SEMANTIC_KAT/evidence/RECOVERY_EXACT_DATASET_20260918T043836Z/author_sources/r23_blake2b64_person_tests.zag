@import("r23_blake2b64_person_v1.zag")

fn b2_alloc_u8(n:i32)[]u8 {let p:*u8=_zag_malloc(n) as *u8;return p[0..n];}
fn b2_alloc_u64(n:i32)[]u64 {let p:*u64=_zag_malloc(n*8) as *u64;return p[0..n];}
fn b2_eq8(d:[]u8,a:u8,b:u8,c:u8,e:u8,f:u8,g:u8,h:u8,i:u8)i32 @noalloc {return (d.len==8&&d[0]==a&&d[1]==b&&d[2]==c&&d[3]==e&&d[4]==f&&d[5]==g&&d[6]==h&&d[7]==i) as i32;}
fn b2_mod7_unsigned(x:u64)i32 @noalloc {let r:i32=((x&0x7fffffffffffffff)%7) as i32;if((x&0x8000000000000000)!=0){r=(r+1)%7;}return r;}

fn main()i32 {
 let v:[]u64=b2_alloc_u64(16);let m:[]u64=b2_alloc_u64(16);let d:[]u8=b2_alloc_u8(8);let out:u64=0;
 if(r23b2p1_u64("","",v,m,d,&out)!=0||b2_eq8(d,0xe4,0xa6,0xa0,0x57,0x74,0x79,0xb2,0xb4)!=1){return 10;}
 if(r23b2p1_u64("abc","",v,m,d,&out)!=0||b2_eq8(d,0xd8,0xbb,0x14,0xd8,0x33,0xd5,0x95,0x59)!=1){return 11;}
 let historical:[]u8="'r23hold'\x00'lena'\x00'folder'\x00'cabinet'\x00'location'\x00";
 if(r23b2p1_u64(historical,"tnn-r23",v,m,d,&out)!=0||b2_eq8(d,0x1f,0x9d,0x6d,0x83,0x7c,0x44,0x18,0xf0)!=1||b2_mod7_unsigned(out)!=6){return 12;}
 if(r25b2_shr(0xb9347711efa141e9,24)!=0x000000b9347711ef){return 13;}
 _zag_println("BLAKE2B64_EMPTY_KAT,PASS\nBLAKE2B64_ABC_KAT,PASS\nR23_PERSONALIZED_FIXTURE,1f9d6d837c4418f0\nR23_PERSONALIZED_MOD7,6\nR23_BLAKE2B64_STATUS,PASS");return 0;
}

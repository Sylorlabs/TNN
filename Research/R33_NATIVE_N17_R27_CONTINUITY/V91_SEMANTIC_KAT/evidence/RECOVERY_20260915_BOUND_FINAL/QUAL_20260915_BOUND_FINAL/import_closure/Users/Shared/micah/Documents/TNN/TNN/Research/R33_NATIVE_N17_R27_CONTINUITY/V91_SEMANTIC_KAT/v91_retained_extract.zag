// Exact parent-map custody extraction only. Historical methods never execute.
@import("../identity.zag")
fn ve_hash(b:[]u8)[]u8 {let h:[]u8=nio_alloc(32);if(h.len!=32||ns_sha256(b,h)!=0){return "";}let s:[]u8=ns_hex(h);nio_free(h);return s;}
fn ve_num(x:i64)void {_zag_print(_zag_i64_to_str(x));}
fn ve_class(p:*ParentMap,id:i32,label:[]u8)void {if(pm_kind(p,id)!=15&&pm_kind(p,id)!=16){return;}let cls:i32=p.*.nodes[(id-1)*10+4] as i32;if(pm_kind(p,cls)!=14){return;}_zag_print("V91_SERIALIZED_CLASS,");_zag_print(label);_zag_print(",");_zag_print(pm_raw(p,p.*.nodes[(cls-1)*10+4] as i32));_zag_print(".");_zag_println(pm_raw(p,p.*.nodes[(cls-1)*10+5] as i32));}
fn ve_descriptor(p:*ParentMap,sg:i32,nested:bool)void {_zag_print("V91_GENERATOR_DESCRIPTOR,path=");if(nested){_zag_print("root.base_state.base_state.r24_state.r23_state.semantic_generator,target=ORIGINAL_ORACLE_GENERATOR");}else{_zag_print("root.semantic_generator,target=RETAINED_ROOT_PARITY_TARGET");}_zag_print(",node=");ve_num(sg as i64);_zag_print(",model=");ve_num(pm_lookup(p,sg,"model") as i64);_zag_print(",bpe=");ve_num(pm_lookup(p,sg,"bpe") as i64);_zag_print(",interpreter=");ve_num(pm_lookup(p,sg,"interpreter") as i64);_zag_println("");}
fn ve_interpreter(p:*ParentMap,sg:i32,prefix:[]u8)i32 {let interpreter:i32=pm_lookup(p,sg,"interpreter");let id:i32=pm_lookup(p,interpreter,"W");let v:NvView=nv_open(p,id);if(v.status!=0){return 30;}if(v.kind!=102||v.width!=4||v.endian!=60||v.order!=67||v.ndim!=2||v.elements!=768*42||v.bytes!=129024||v.dims[0]!=768||v.dims[1]!=42||v.strides[0]!=42||v.strides[1]!=1){nv_close(&v);return 31;}let raw:[]u8=p.*.input[v.at..v.at+v.bytes];if(_zag_write_file(_zag_str_concat(prefix,"/interpreter.W.f32le"),raw)!=0){nv_close(&v);return 32;}_zag_print("V91_INTERPRETER_W,node=");ve_num(id as i64);_zag_print(",offset=");ve_num(v.at as i64);_zag_print(",bytes=129024,shape=768x42,sha256=");_zag_println(ve_hash(raw));nv_close(&v);return 0;}
fn ve_item(p:*ParentMap,id:i32,index:i32)i32 {let k:i32=pm_kind(p,id);if((k!=9&&k!=10)||index<0||index>=p.*.nodes[(id-1)*10+9]){return 0;}let e:i32=p.*.nodes[(id-1)*10+7] as i32;let i:i32=0;while(e>0&&i<index){e=p.*.edges[(e-1)*4+2] as i32;i=i+1;}if(e<=0||p.*.edges[(e-1)*4+3]!=1){return 0;}return p.*.edges[(e-1)*4] as i32;}
fn ve_param(p:*ParentMap,sg:i32,layer:[]u8,key:[]u8)i32 {let model:i32=pm_lookup(p,sg,"model");let mods:i32=pm_lookup(p,model,"_modules");let mod:i32=pm_lookup(p,mods,layer);return pm_lookup(p,pm_lookup(p,mod,"_parameters"),key);}
fn ve_tensor(p:*ParentMap,sg:i32,layer:[]u8,key:[]u8,rows:i32,cols:i32,prefix:[]u8,w:*TsWork)i32 {
 let id:i32=ve_param(p,sg,layer,key);let v:TsView=ts_open(p,id,w);if(v.status!=0){return 10;}let rank:i32=1;if(cols>0){rank=2;}
 let count:i32=rows;if(cols>0){count=rows*cols;}
 if(v.kind!=102||v.width!=4||v.rank!=rank||v.elements!=count||v.offset!=0||v.dims[0]!=rows||v.strides[rank-1]!=1){ts_close(&v);return 11;}
 if(rank==2&&(v.dims[1]!=cols||v.strides[0]!=cols)){ts_close(&v);return 12;}
 let bytes:[]u8=p.*.input[v.at..v.at+count*4];let name:[]u8=_zag_str_concat(_zag_str_concat(layer,"."),key);let path:[]u8=_zag_str_concat(_zag_str_concat(prefix,"/"),_zag_str_concat(name,".f32le"));
 if(_zag_write_file(path,bytes)!=0){ts_close(&v);return 13;}
 _zag_print("V91_TENSOR,");_zag_print(name);_zag_print(",node=");ve_num(id as i64);_zag_print(",offset=");ve_num(v.at as i64);_zag_print(",bytes=");ve_num(bytes.len as i64);_zag_print(",shape=");ve_num(rows as i64);_zag_print("x");ve_num(cols as i64);_zag_print(",sha256=");_zag_println(ve_hash(bytes));ts_close(&v);return 0;
}
fn ve_bpe(p:*ParentMap,sg:i32,prefix:[]u8)i32 {
 let bpe:i32=pm_lookup(p,sg,"bpe");let dict:i32=pm_lookup(p,bpe,"token_bytes");let merges:i32=pm_lookup(p,bpe,"merges");if(pm_kind(p,dict)!=11||pm_kind(p,merges)!=9){return 20;}
 let frame:[]u8=nio_alloc(32768);let used:i32=16;mi_copy("V91BPE01",frame);let count:i32=p.*.nodes[(dict-1)*10+9] as i32;mi_put(frame,8,count);mi_put(frame,12,p.*.nodes[(merges-1)*10+9]);
 let e:i32=p.*.nodes[(dict-1)*10+7] as i32;let n:i32=0;let seen:[]i64=pm_words(1024);
 while(e>0&&n<count){let at:i32=(e-1)*4;let k:i32=p.*.edges[at] as i32;let id:i64=-1;if(pm_small_int(p,k,&id)!=0||id<0||id>=1024||seen[id as i32]!=0){return 21;}seen[id as i32]=1;let val:i32=p.*.edges[at+1] as i32;if(pm_kind(p,val)!=7){return 22;}let raw:[]u8=pm_raw(p,val);if(raw.len>32768-used-8){return 23;}mi_put(frame,used,id);mi_put(frame,used+4,raw.len);mi_copy(raw,frame[used+8..used+8+raw.len]);used=used+8+raw.len;
 _zag_print("V91_BPE_TOKEN,");ve_num(id);_zag_print(",node=");ve_num(val as i64);_zag_print(",bytes=");ve_num(raw.len as i64);_zag_print(",sha256=");_zag_println(ve_hash(raw));e=p.*.edges[at+2] as i32;n=n+1;}
 if(e!=0||n!=count){return 24;}let m:i32=p.*.nodes[(merges-1)*10+9] as i32;let i:i32=0;while(i<m){let pair:i32=ve_item(p,merges,i);if(nv_tuple_size(p,pair)!=2){return 25;}let a:i64=-1;let b:i64=-1;if(pm_small_int(p,nv_item(p,pair,0),&a)!=0||pm_small_int(p,nv_item(p,pair,1),&b)!=0||a<0||b<0||a>=1024||b>=1024||used>32768-8){return 26;}mi_put(frame,used,a);mi_put(frame,used+4,b);used=used+8;i=i+1;}
 if(_zag_write_file(_zag_str_concat(prefix,"/bpe.framed.bin"),frame[0..used])!=0){return 27;}_zag_print("V91_BPE_FRAME,");ve_num(count as i64);_zag_print(",merges=");ve_num(m as i64);_zag_print(",sha256=");_zag_println(ve_hash(frame[0..used]));nio_free(frame);pm_free_words(seen);return 0;
}
fn main()i32 {
 if(_zag_argc()!=2&&_zag_argc()!=3){return 2;}if(_zag_argc()==3&&nio_equal(_zag_arg(2),"--nested-r23")!=1){return 2;}let binding:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0||n17_identity(&p)!=0){return 3;}
 _zag_print("V91_PARENT_INPUT_SHA256,");_zag_println(ve_hash(p.input));let sg:i32=pm_lookup(&p,p.root,"semantic_generator");if(_zag_argc()==3){let r25:i32=pm_lookup(&p,pm_lookup(&p,p.root,"base_state"),"base_state");let r23:i32=pm_lookup(&p,pm_lookup(&p,r25,"r24_state"),"r23_state");sg=pm_lookup(&p,r23,"semantic_generator");}ve_descriptor(&p,sg,_zag_argc()==3);ve_class(&p,sg,"generator");let m:i32=pm_lookup(&p,sg,"model");ve_class(&p,m,"model");ve_class(&p,pm_lookup(&p,sg,"bpe"),"bpe");let mods:i32=pm_lookup(&p,m,"_modules");ve_class(&p,pm_lookup(&p,mods,"emb"),"emb");ve_class(&p,pm_lookup(&p,mods,"ch"),"ch");ve_class(&p,pm_lookup(&p,mods,"ce"),"ce");ve_class(&p,pm_lookup(&p,mods,"rnn"),"rnn");ve_class(&p,pm_lookup(&p,mods,"out"),"out");let prefix:[]u8=_zag_arg(1);let w:TsWork=ts_work();let rc:i32=0;
 rc=rc+ve_tensor(&p,sg,"emb","weight",342,48,prefix,&w);rc=rc+ve_tensor(&p,sg,"ch","weight",128,42,prefix,&w);rc=rc+ve_tensor(&p,sg,"ch","bias",128,0,prefix,&w);rc=rc+ve_tensor(&p,sg,"ce","weight",48,42,prefix,&w);rc=rc+ve_tensor(&p,sg,"ce","bias",48,0,prefix,&w);
 rc=rc+ve_tensor(&p,sg,"rnn","weight_ih_l0",384,96,prefix,&w);rc=rc+ve_tensor(&p,sg,"rnn","weight_hh_l0",384,128,prefix,&w);rc=rc+ve_tensor(&p,sg,"rnn","bias_ih_l0",384,0,prefix,&w);rc=rc+ve_tensor(&p,sg,"rnn","bias_hh_l0",384,0,prefix,&w);rc=rc+ve_tensor(&p,sg,"out","weight",342,128,prefix,&w);rc=rc+ve_tensor(&p,sg,"out","bias",342,0,prefix,&w);
 rc=rc+ve_interpreter(&p,sg,prefix);rc=rc+ve_bpe(&p,sg,prefix);_zag_print("V91_EXTRACT_STATUS,");ve_num(rc as i64);_zag_println("");mi_loaded_close(&p);return (rc!=0) as i32;
}

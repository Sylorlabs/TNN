@import("sources/Research/R33_NATIVE_N17_R27_CONTINUITY/identity.zag")
fn tp_num(x:i64)void {_zag_print(_zag_i64_to_str(x));}
fn tp_dump(p:*ParentMap,id:i32,label:[]u8,depth:i32)void {
 _zag_print("TP_NODE,");_zag_print(label);_zag_print(",id=");tp_num(id as i64);_zag_print(",kind=");tp_num(pm_kind(p,id) as i64);if(pm_kind(p,id)==6){_zag_print(",text=");_zag_print(pm_raw(p,id));}let value:i64=0;if(pm_small_int(p,id,&value)==0){_zag_print(",integer=");tp_num(value);}_zag_println("");if(depth<1){return;}
 let state:i32=pm_build_state(p,id);if(pm_kind(p,state)!=11){return;}let e:i32=p.*.nodes[(state-1)*10+7] as i32;let n:i32=0;while(e>0&&e<=p.*.edge_count&&n<128){let r:i32=(e-1)*4;tp_dump(p,p.*.edges[r+1] as i32,_zag_str_concat(_zag_str_concat(label,"."),pm_raw(p,p.*.edges[r] as i32)),depth-1);e=p.*.edges[r+2] as i32;n=n+1;}
}
fn main()i32 {let b:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),b);nio_free(b);if(p.status!=0||n17_identity(&p)!=0){return 3;}let r25:i32=pm_lookup(&p,pm_lookup(&p,p.root,"base_state"),"base_state");let r23:i32=pm_lookup(&p,pm_lookup(&p,r25,"r24_state"),"r23_state");let examples:i32=pm_lookup(&p,pm_lookup(&p,pm_lookup(&p,r23,"evidence"),"semantic_generation"),"examples");if(pm_kind(&p,examples)!=9){return 4;}let edge:i32=p.nodes[(examples-1)*10+7] as i32;if(edge<1||edge>p.edge_count){return 5;}tp_dump(&p,p.edges[(edge-1)*4] as i32,"example0",3);mi_loaded_close(&p);return 0;}

@import("r25_blake2b64_v1.zag")
const R23B2P1_OK:i32=0;const R23B2P1_SHAPE:i32=-27901;
fn r23b2p1_u64(input:[]u8,person:[]u8,v:[]u64,m:[]u64,digest:[]u8,out:*u64)i32 @noalloc {if(input.len<0||input.len>=128||person.len>16||digest.len!=8||v.len!=16||m.len!=16||out==null as *u64){return R23B2P1_SHAPE;}let i:i32=0;while(i<16){m[i]=r25b2_word(input,i*8);i=i+1;}i=0;while(i<8){v[i]=r25b2_iv(i);v[8+i]=r25b2_iv(i);i=i+1;}v[0]=v[0]^0x01010008;v[6]=v[6]^r25b2_word(person,0);v[7]=v[7]^r25b2_word(person,8);v[12]=v[12]^(input.len as u64);v[14]=v[14]^0xffffffffffffffff;let r:i32=0;while(r<12){r25b2_g(v,0,4,8,12,m[r25b2_sigma(r,0)],m[r25b2_sigma(r,1)]);r25b2_g(v,1,5,9,13,m[r25b2_sigma(r,2)],m[r25b2_sigma(r,3)]);r25b2_g(v,2,6,10,14,m[r25b2_sigma(r,4)],m[r25b2_sigma(r,5)]);r25b2_g(v,3,7,11,15,m[r25b2_sigma(r,6)],m[r25b2_sigma(r,7)]);r25b2_g(v,0,5,10,15,m[r25b2_sigma(r,8)],m[r25b2_sigma(r,9)]);r25b2_g(v,1,6,11,12,m[r25b2_sigma(r,10)],m[r25b2_sigma(r,11)]);r25b2_g(v,2,7,8,13,m[r25b2_sigma(r,12)],m[r25b2_sigma(r,13)]);r25b2_g(v,3,4,9,14,m[r25b2_sigma(r,14)],m[r25b2_sigma(r,15)]);r=r+1;}let h0:u64=r25b2_iv(0)^0x01010008^v[0]^v[8];i=0;while(i<8){digest[i]=((h0>>(i*8))&255) as u8;i=i+1;}let z:u64=0;i=0;while(i<8){z=z|((digest[i] as u64)<<(i*8));i=i+1;}out.*=z;return 0;}

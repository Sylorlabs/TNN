@import("v91_native_roundtrip_v1.zag")

fn vrp_get32(b:[]u8,at:i32)i32 @noalloc {return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);}

fn main()i32 {
    if(_zag_argc()!=3){return 2;}let model:V91NaiveModel=vg_load(_zag_arg(1));if(model.status!=0){return 3;}
    let w:[]f64=vn_load(_zag_arg(1),"interpreter.W.f32le",32256,"3f5c806cfa243f9fc5de398101d93a9fc59b8ea1d4cb55cbe08165d940e3e5c3");if(w.len!=32256){return 4;}
    let cf:[]u8=_zag_read_file(_zag_arg(2));if(cf.len!=752){return 5;}let c:[]f64=vg_f64(42);let at:i32=16;let j:i32=0;while(j<42){c[j]=cf[at+4+j] as f64;j=j+1;}
    let status:i32=-1;let sem:f64=0.0;let lp:f64=0.0;let got:[]u8=vr_generate_roundtrip(&model,w,c,33101,&status,&sem,&lp);if(status!=0){_zag_print("STATUS,");_zag_println(_zag_i64_to_str(status as i64));return 6;}
    _zag_print("V91_ROUNDTRIP_PROBE,text=");_zag_println(got);return 0;
}

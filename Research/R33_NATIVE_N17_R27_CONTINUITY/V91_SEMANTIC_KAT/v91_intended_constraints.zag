// V91 native recovery of the exact semantic fields retained with the 16 R23 examples.
// This is custody/constraint reconstruction only; it does not assert the two missing
// one-hot groups, generator method, RNG, or historical generation parity.
@import("../identity.zag")
fn vc_list(p:*ParentMap,id:i32,index:i32)i32 {if((pm_kind(p,id)!=9&&pm_kind(p,id)!=10)||index<0||index>=p.*.nodes[(id-1)*10+9]){return 0;}let e:i32=p.*.nodes[(id-1)*10+7] as i32;let i:i32=0;while(e>0&&i<index){e=p.*.edges[(e-1)*4+2] as i32;i=i+1;}if(e<=0||p.*.edges[(e-1)*4+3]!=1){return 0;}return p.*.edges[(e-1)*4] as i32;}
fn vc_str(p:*ParentMap,id:i32,key:[]u8,want:[]u8)i32 {let x:i32=pm_lookup(p,id,key);return (pm_kind(p,x)==6&&nio_equal(pm_raw(p,x),want)==1) as i32;}
fn vc_int(p:*ParentMap,id:i32,key:[]u8,want:i64)i32 {let x:i32=pm_lookup(p,id,key);let v:i64=0;return (pm_small_int(p,x,&v)==0&&v==want) as i32;}
fn vc_emit(i:i32,a:[]u8,o:[]u8,k:[]u8,xkey:[]u8,x:[]u8)void {_zag_print("V91_INTENDED,");_zag_print(_zag_i64_to_str(i as i64));_zag_print(",a=");_zag_print(a);_zag_print(",o=");_zag_print(o);_zag_print(",kind=");_zag_print(k);_zag_print(",");_zag_print(xkey);_zag_print("=");_zag_print(x);_zag_println(",known_active_groups=4,unknown_active_groups=2");}
fn vc_check(p:*ParentMap,examples:i32,i:i32,a:[]u8,o:[]u8,k:[]u8,xkey:[]u8,x:[]u8)i32 {let ex:i32=vc_list(p,examples,i);if(pm_kind(p,ex)!=11){return 1;}let intended:i32=pm_lookup(p,ex,"intended");if(pm_kind(p,intended)!=11||p.*.nodes[(intended-1)*10+9]!=4){return 2;}if(vc_str(p,intended,"a",a)!=1||vc_str(p,intended,"o",o)!=1||vc_str(p,intended,"kind",k)!=1||vc_str(p,intended,xkey,x)!=1){return 3;}vc_emit(i,a,o,k,xkey,x);return 0;}
fn main()i32 {let binding:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0||n17_identity(&p)!=0){return 3;}let r26:i32=pm_lookup(&p,p.root,"base_state");let r25:i32=pm_lookup(&p,r26,"base_state");let r24:i32=pm_lookup(&p,r25,"r24_state");let r23:i32=pm_lookup(&p,r24,"r23_state");let ev:i32=pm_lookup(&p,r23,"evidence");let sg:i32=pm_lookup(&p,ev,"semantic_generation");if(pm_kind(&p,sg)!=11||vc_int(&p,sg,"train_n",1800)!=1||vc_int(&p,sg,"test_n",72)!=1||vc_int(&p,sg,"bpe_vocab",340)!=1){mi_loaded_close(&p);return 4;}let xs:i32=pm_lookup(&p,sg,"examples");if(pm_kind(&p,xs)!=9||p.nodes[(xs-1)*10+9]!=16){mi_loaded_close(&p);return 5;}let bad:i32=0;
bad=bad+vc_check(&p,xs,0,"lena","folder","motive","bad","getting wet");bad=bad+vc_check(&p,xs,1,"ana","glass","motive","bad","making noise");bad=bad+vc_check(&p,xs,2,"omar","folder","belief","l","desk");bad=bad+vc_check(&p,xs,3,"lena","book","location","l","cabinet");bad=bad+vc_check(&p,xs,4,"ravi","cup","promise","l","shelf");bad=bad+vc_check(&p,xs,5,"ana","cup","motive","bad","falling");bad=bad+vc_check(&p,xs,6,"mira","notebook","belief","l","desk");bad=bad+vc_check(&p,xs,7,"ravi","notebook","motive","bad","falling");bad=bad+vc_check(&p,xs,8,"ana","report","belief","l","table");bad=bad+vc_check(&p,xs,9,"mira","notebook","location","l","cabinet");bad=bad+vc_check(&p,xs,10,"omar","phone","promise","l","drawer");bad=bad+vc_check(&p,xs,11,"lena","cup","belief","l","room");bad=bad+vc_check(&p,xs,12,"nora","glass","belief","l","desk");bad=bad+vc_check(&p,xs,13,"sam","book","belief","l","room");bad=bad+vc_check(&p,xs,14,"jon","folder","belief","l","bag");bad=bad+vc_check(&p,xs,15,"nora","glass","belief","l","desk");
_zag_println("V91_DATASET_COUNTS,train=1800,test=72,total=1872");_zag_println("V91_CONDITION_DIM,42");_zag_println("V91_CONDITION_GROUPS,name8,object8,location8,motive6,action8,kind4");_zag_println("V91_CONDITION_CONSTRAINTS,known_per_example=4,unknown_per_example=2");_zag_println("V91_UNKNOWN_FOR_MOTIVE,location,action");_zag_println("V91_UNKNOWN_FOR_OTHER_KINDS,motive,action");_zag_print("V91_INTENDED_FAILURES,");_zag_println(_zag_i64_to_str(bad as i64));mi_loaded_close(&p);return (bad!=0) as i32;}

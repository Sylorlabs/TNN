@import("../r27_native_state_image_v4.zag")
@import("../../R33_CONTINUING_LIFE_V1/checkpoint.zag")
fn pv92_num(x:i32)void {cl_number(x as i64);}
fn main()i32 {
    let id:i32=1;
    while(id<=33){
        let n:i32=r27s4_expected_count(id);let bytes:i32=r27s4_section_bytes(id);
        _zag_print("PV92,");pv92_num(id);_zag_print(",");pv92_num(n);_zag_print(",");pv92_num(bytes);_zag_print(",gt0=");
        if(n>0){_zag_print("1");}else{_zag_print("0");}
        _zag_print(",eqbytes=");if(bytes==R27S4_HEADER_BYTES+n*4){_zag_print("1");}else{_zag_print("0");}
        _zag_println("");
        id=id+1;
    }
    _zag_print("CHECK11,");pv92_num(cl_check("one_eq_one",1,1));_zag_println("");
    _zag_print("CHECK10,");pv92_num(cl_check("one_ne_zero",1,0));_zag_println("");
    return 0;
}

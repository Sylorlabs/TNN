@import("../identity.zag")
fn main()i32 {
 let p:ParentMap=pm_init("xyz",16,16,16,16);if(p.status!=0){return 1;}
 let a:i32=pm_new(&p,15,0,0,0,0,0,0);let b:i32=pm_new(&p,15,0,0,0,0,0,0);
 pm_push(&p,a);pm_memo_put(&p,0);pm_pop(&p);let count:i32=p.node_count;pm_memo_get(&p,0);
 if(pm_pop(&p)!=a || p.node_count!=count || a==b){return 2;}
 pm_memo_get(&p,1);if(p.status!=-8804){return 3;}pm_close(&p);
 let q:ParentMap=pm_init("xyz",16,16,16,16);let c:i32=pm_new(&q,15,0,0,0,0,0,0);pm_push(&q,c);pm_memo_put(&q,0);pm_memo_put(&q,0);if(q.status!=-8804){return 4;}pm_close(&q);
 _zag_println("PASS_MEMO_GET_SAME_ID_NO_ALLOCATION_DISTINCT_NEWOBJ_MISSING_SLOT_DUPLICATE_SLOT_REJECT");return 0;
}

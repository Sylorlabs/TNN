// Exact hash admission plus bounded lexical array inspection of the frozen R27
// policy. This supports nine policy rows only, not a general JSON parser.
@import("../../R33_NATIVE_SHA256_V2.zag")
fn bp_ws(c:u8)i32 {return (c==32||c==9||c==10||c==13) as i32;}
fn bp_array(b:[]u8,key:[]u8)[]u8 {
 let i:i32=0;let found:i32=-1;let count:i32=0;
 while(i+key.len<=b.len){if(nio_equal(b[i..i+key.len],key)==1){found=i+key.len;count=count+1;}i=i+1;}
 if(count!=1){return b[0..0];}i=found;
 while(i<b.len&&bp_ws(b[i])==1){i=i+1;}if(i>=b.len||b[i]!=58){return b[0..0];}i=i+1;
 while(i<b.len&&bp_ws(b[i])==1){i=i+1;}if(i>=b.len||b[i]!=91){return b[0..0];}let start:i32=i+1;i=start;
 while(i<b.len&&b[i]!=93){if(b[i]==92||b[i]==91||b[i]==123||b[i]==125){return b[0..0];}i=i+1;}
 if(i>=b.len){return b[0..0];}return b[start..i];
}
fn bp_member(a:[]u8,s:[]u8)i32 {
 let i:i32=0;let count:i32=0;let match:i32=0;
 while(i<a.len){while(i<a.len&&bp_ws(a[i])==1){i=i+1;}if(i==a.len){break;}if(a[i]!=34){return -1;}i=i+1;let start:i32=i;
 while(i<a.len&&a[i]!=34){if(a[i]<32||a[i]==92){return -1;}i=i+1;}if(i>=a.len){return -1;}
 if(nio_equal(a[start..i],s)==1){match=match+1;}count=count+1;i=i+1;
 while(i<a.len&&bp_ws(a[i])==1){i=i+1;}if(i==a.len){break;}if(a[i]!=44){return -1;}i=i+1;
 let next:i32=i;while(next<a.len&&bp_ws(a[next])==1){next=next+1;}if(next==a.len){return -1;}
 }if(match==1){return count;}return -1;
}
fn bp_gate(i:i32)[]u8 {if(i==0){return "TEENAGER_ENGLISH";}if(i==1){return "ADULT_ENGLISH";}if(i==2){return "NATURAL_VIDEO_AUDIO";}if(i==3){return "HUMAN_SUPERIORITY";}if(i==4){return "NATIVE_ZAG";}if(i==5){return "OPEN_ENDED_RECURSIVE_SELF_IMPROVEMENT";}if(i==6){return "AHI";}return "PRODUCTION_TNN_V1";}
fn main()i32 {
 if(_zag_argc()!=2){return 64;}let b:[]u8=_zag_read_file(_zag_arg(1));if(b.len<=0){return 66;}
 let h:[]u8=nio_alloc(32);if(ns_sha256(b,h)!=0){return 71;}let hex:[]u8=ns_hex(h);
 if(nio_equal(hex,"983db6a9c771f4952392d288459d65dfb04c33a7cbca37ac9f10a4365c7887a8")!=1){return 71;}
 let gates:[]u8=bp_array(b,"\"locked_gates\"");let active:[]u8=bp_array(b,"\"active_promotions\"");
 let i:i32=0;while(i<8){if(bp_member(gates,bp_gate(i))!=8){return 72;}i=i+1;}
 if(bp_member(active,"STRONGER_MASTER_GENERAL_SPECIFIC_BRIDGE")!=1){return 72;}
 _zag_print("B_POLICY_SHA256,");_zag_println(hex);i=23;
 while(i<=31){_zag_print("B_ROW,R27-");let n:[]u8=_zag_i64_to_str(i as i64);_zag_print(n);nio_free(n);_zag_println(",PASS,POLICY_EXACT_HASH_AND_NATIVE_ARRAY_INSPECTION");i=i+1;}
 nio_free(hex);nio_free(h);nio_free(b);return 0;
}

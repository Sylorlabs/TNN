@import("../identity.zag")
fn bn(x:i64)void {let s:[]u8=_zag_i64_to_str(x);_zag_print(s);nio_free(s);}
fn main()i32 {
 let binding:[]u8=pb_binding();if(binding.len!=128){return 2;}let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0){return 3;}if(n17_identity(&p)!=0){mi_loaded_close(&p);return 4;}
 let r26:i32=pm_lookup(&p,p.root,"base_state");let head:i32=pm_lookup(&p,pm_lookup(&p,r26,"video_entity_policy"),"entity_head");let net:i32=pm_lookup(&p,head,"net");let seq:i32=pm_lookup(&p,pm_lookup(&p,net,"_modules"),"net");let last:i32=pm_lookup(&p,pm_lookup(&p,seq,"_modules"),"3");let width:i32=pm_lookup(&p,last,"out_features");let ok:i32=n17_int_is(&p,width,8);
 _zag_print("B_ROW,R26-23,");if(ok==1){_zag_print("PASS,");}else{_zag_print("FAIL,");}bn(width as i64);_zag_print(",");bn(pm_kind(&p,width) as i64);_zag_println("");
 _zag_print("B_REVIEW_ONLY,R27_TYPE_DESCRIPTOR,");bn(n17_class_is(&p,p.root,"r27_experiments","R27State") as i64);_zag_println("");
 _zag_print("B_REVIEW_ONLY,R26_TYPE_DESCRIPTOR,");bn(n17_class_is(&p,r26,"r26_experiments","R26State") as i64);_zag_println("");
 _zag_print("B_REVIEW_ONLY,R27_GENERATOR_MAP_ALIAS,");bn((pm_lookup(&p,p.root,"semantic_generator")==pm_lookup(&p,r26,"semantic_generator")) as i64);_zag_println("");
 _zag_print("B_STORED_WITNESS_ONLY,R26_R25_RAW_LINK,");_zag_println(pm_raw(&p,pm_lookup(&p,r26,"r25_sha256")));
 let nullid:i32=pm_lookup(&p,r26,"speech_segmenter");let missing:i32=pm_lookup(&p,r26,"LANE_B_FIXED_ABSENT_FIELD");let neg:i32=(pm_kind(&p,nullid)==1 && missing==0 && pm_kind(&p,missing)!=1 && n17_int_is(&p,pm_lookup(&p,p.root,"development_step"),60424)==0 && n17_int_is(&p,pm_lookup(&p,p.root,"newborn_restarts"),1)==0) as i32;
 _zag_print("B_STATIC_NEGATIVE_EXPECTATIONS,");bn(neg as i64);_zag_println("");_zag_println("B_TERMINAL_CLAIM_ALLOWED,FALSE");mi_loaded_close(&p);return (ok!=1 || neg!=1) as i32;
}

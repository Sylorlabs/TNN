// Native intended-input binding, never inferred from sampled output text.
@import("sources/Research/R33_NATIVE_N17_R27_CONTINUITY/identity.zag")
@import("sources/Research/R33_NATIVE_N17_R27_CONTINUITY/V91_SEMANTIC_KAT/v91_semantic_kat.zag")
fn tc_num(x:i64)void {_zag_print(_zag_i64_to_str(x));}
fn tc_hash(b:[]u8)[]u8 {let h:[]u8=nio_alloc(32);if(h.len!=32||ns_sha256(b,h)!=0){return "";}let s:[]u8=ns_hex(h);nio_free(h);return s;}
fn tc_index(field:[]u8,value:[]u8)i32 {let i:i32=0;while(i<8){let s:[]u8="";if(nio_equal(field,"a")==1){s=v91_name(i);}else if(nio_equal(field,"o")==1){s=v91_object(i);}else if(nio_equal(field,"l")==1){s=v91_loc(i);}else if(nio_equal(field,"bad")==1&&i<6){s=v91_motive(i);}else if(nio_equal(field,"kind")==1&&i<4){s=v91_kind(i);}if(s.len>0&&nio_equal(s,value)==1){return i;}i=i+1;}return -1;}
fn main()i32 {
 if(_zag_argc()!=2){return 2;}let b:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),b);nio_free(b);if(p.status!=0||n17_identity(&p)!=0){return 3;}
 let r25:i32=pm_lookup(&p,pm_lookup(&p,p.root,"base_state"),"base_state");let r23:i32=pm_lookup(&p,pm_lookup(&p,r25,"r24_state"),"r23_state");let list:i32=pm_lookup(&p,pm_lookup(&p,pm_lookup(&p,r23,"evidence"),"semantic_generation"),"examples");if(pm_kind(&p,list)!=9||p.nodes[(list-1)*10+9]!=16){return 4;}let e:i32=p.nodes[(list-1)*10+7] as i32;let i:i32=0;
 let frame:[]u8=nio_alloc(8192);if(frame.len!=8192){return 5;}mi_copy("V91TGT01",frame);mi_put(frame,8,16);mi_put(frame,12,r23);let used:i32=16;
 while(i<16){if(e<1||e>p.edge_count){return 6;}let er:i32=(e-1)*4;if(p.edges[er+3]!=1){return 7;}let example:i32=p.edges[er] as i32;let intended:i32=pm_lookup(&p,example,"intended");if(pm_kind(&p,intended)!=11||p.nodes[(intended-1)*10+9]!=4){return 8;}let r:V91Row=V91Row{.a=-1,.o=-1,.l=-1,.bad=-1,.act=-1,.kind=-1,.form=-1};let mask:i32=0;let edge:i32=p.nodes[(intended-1)*10+7] as i32;let n:i32=0;
 if(used>8192-16){return 9;}mi_put(frame,used,i);mi_put(frame,used+4,example);mi_put(frame,used+8,intended);mi_put(frame,used+12,4);used=used+16;
 while(n<4){if(edge<1||edge>p.edge_count){return 10;}let rr:i32=(edge-1)*4;if(p.edges[rr+3]!=2){return 11;}let key:i32=p.edges[rr] as i32;let node:i32=p.edges[rr+1] as i32;if(pm_kind(&p,key)!=6||pm_kind(&p,node)!=6){return 12;}let field:[]u8=pm_raw(&p,key);let value:[]u8=pm_raw(&p,node);let idx:i32=tc_index(field,value);if(idx<0){_zag_print("TC91_UNKNOWN_FIELD,");_zag_print(field);_zag_print(",");_zag_println(value);return 13;}let bit:i32=0;
 if(nio_equal(field,"a")==1){r.a=idx;bit=1;}else if(nio_equal(field,"o")==1){r.o=idx;bit=2;}else if(nio_equal(field,"l")==1){r.l=idx;bit=4;}else if(nio_equal(field,"bad")==1){r.bad=idx;bit=8;}else if(nio_equal(field,"kind")==1){r.kind=idx;bit=16;}else{return 14;}if((mask&bit)!=0){return 15;}mask=mask|bit;
 let at:i32=p.nodes[(node-1)*10+2] as i32;if(value.len<1||value.len>8192-used-20){return 16;}mi_put(frame,used,key);mi_put(frame,used+4,node);mi_put(frame,used+8,at);mi_put(frame,used+12,value.len);mi_put(frame,used+16,idx);mi_copy(value,frame[used+20..used+20+value.len]);used=used+20+value.len;
 _zag_print("TC91_FIELD,index=");tc_num(i as i64);_zag_print(",example=");tc_num(example as i64);_zag_print(",intended=");tc_num(intended as i64);_zag_print(",field=");_zag_print(field);_zag_print(",key_node=");tc_num(key as i64);_zag_print(",value_node=");tc_num(node as i64);_zag_print(",offset=");tc_num(at as i64);_zag_print(",bytes=");tc_num(value.len as i64);_zag_print(",sha256=");_zag_print(tc_hash(value));_zag_print(",text=");_zag_println(value);edge=p.edges[rr+2] as i32;n=n+1;
 }
 if(edge!=0||v91_expected_row(i,r)!=1){return 17;}if((r.kind==1&&mask!=27)||(r.kind!=1&&mask!=23)){return 18;}_zag_print("TC91_ACCEPTED_INTENDED_ROW,");tc_num(i as i64);_zag_println(",meaningful_fields_equal=1,unretained_fields=UNADMITTED");e=p.edges[er+2] as i32;i=i+1;
 }if(e!=0){return 19;}if(_zag_write_file(_zag_arg(1),frame[0..used])!=0){return 20;}_zag_print("TC91_FRAME_SHA256,");_zag_println(tc_hash(frame[0..used]));_zag_println("TC91_NATIVE_INTENDED_MATCHES,16\nTC91_FULL_CONDITION_VECTORS,UNADMITTED\nTC91_GENERATED_OUTPUTS,0\nTC91_ADMISSION,CLOSED");nio_free(frame);mi_loaded_close(&p);return 0;
}

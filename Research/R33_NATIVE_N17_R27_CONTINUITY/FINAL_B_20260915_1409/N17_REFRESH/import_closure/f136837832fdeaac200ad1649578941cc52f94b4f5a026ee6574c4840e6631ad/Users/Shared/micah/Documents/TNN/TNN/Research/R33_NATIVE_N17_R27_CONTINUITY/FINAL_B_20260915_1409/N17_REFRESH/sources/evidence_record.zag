// Native evidence serializer. Shell orchestration supplies argv one per line;
// this tool computes output/file hashes and writes the structured RECORD.
@import("../../../../R33_NATIVE_SHA256_V2.zag")
fn vr_quote(s:[]u8)[]u8 {let out:[]u8="{\"schema\":\"N17_NATIVE_COMMAND_FILE_RECEIPT_V1\",\"commands\":[";
 let start:i32=0;let i:i32=0;let count:i32=0;while(i<=journal.len){if(i==journal.len||journal[i]==10){let line:[]u8=journal[start..i];if(line.len>0){let label:[]u8=vr_field(line,0);let exitcode:[]u8=vr_field(line,1);let expected:[]u8=vr_field(line,2);let role:[]u8=vr_field(line,3);let base:[]u8=_zag_str_concat(_zag_str_concat(root,"/logs/"),label);let stdout:[]u8=_zag_str_concat(base,".stdout");let stderr:[]u8=_zag_str_concat(base,".stderr");let av:[]u8=_zag_read_file(_zag_str_concat(base,".argv"));if(av.len<1||exitcode.len<1||expected.len<1){return 4;}if(count>0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,_zag_str_concat("{\"label\":",vr_quote(label)));out=_zag_str_concat(out,",\"argv\":[");let a:i32=0;let j:i32=0;let ac:i32=0;while(j<av.len){if(av[j]==10){if(ac>0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,vr_quote(av[a..j]));ac=ac+1;a=j+1;}j=j+1;}out=_zag_str_concat(out,_zag_str_concat("],\"exit\":",exitcode));out=_zag_str_concat(out,_zag_str_concat(",\"expected_exit\":",expected));out=_zag_str_concat(out,_zag_str_concat(",\"stdout\":",vr_quote(stdout)));out=_zag_str_concat(out,_zag_str_concat(",\"stderr\":",vr_quote(stderr)));out=_zag_str_concat(out,_zag_str_concat(",\"stdout_sha256\":",vr_quote(vr_hash(_zag_read_file(stdout)))));out=_zag_str_concat(out,_zag_str_concat(",\"stderr_sha256\":",vr_quote(vr_hash(_zag_read_file(stderr)))));out=_zag_str_concat(out,_zag_str_concat(",\"claim_role\":",_zag_str_concat(vr_quote(role),"}")));count=count+1;}start=i+1;}i=i+1;}
 out=_zag_str_concat(out,"],\"files\":[");start=0;i=0;count=0;while(i<=files.len){if(i==files.len||files[i]==10){let line:[]u8=files[start..i];if(line.len>0){let role:[]u8=vr_field(line,0);let path:[]u8=vr_field(line,1);let bytes:[]u8=_zag_read_file(path);if(bytes.len<0){return 5;}if(count>0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,_zag_str_concat("{\"role\":",vr_quote(role)));out=_zag_str_concat(out,_zag_str_concat(",\"path\":",vr_quote(path)));out=_zag_str_concat(out,_zag_str_concat(",\"bytes\":",_zag_i64_to_str(bytes.len as i64)));out=_zag_str_concat(out,_zag_str_concat(",\"sha256\":",_zag_str_concat(vr_quote(vr_hash(bytes)),"}")));count=count+1;}start=i+1;}i=i+1;}
 out=_zag_str_concat(out,"]}\n");return _zag_write_file(_zag_str_concat(root,"/EVIDENCE.json"),out);
}

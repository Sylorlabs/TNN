#!/usr/bin/env python3
import argparse,json,sys
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent))
import speech_r28 as sr
from speech_learned_overlap_r28 import precompute_costs,align_order_cost_cached,decode_prior
from integrated_r28 import motif_template,synth_phrase

def vary_int(t,r):
    stretch=r.uniform(.55,1.65);n=max(7,int(len(t)*stretch));z=np.interp(np.linspace(0,len(t)-1,n),np.arange(len(t)),t);z+=r.normal(0,.35,n);return z

def learn_protos(seed,bases,K=10,W=20,n=42):
    r=np.random.default_rng(seed);P=[];dur=[]
    for e,t in bases.items():
        rows=[];ds=[]
        for _ in range(n):
            z=vary_int(t,r);ds.append(len(z));rr=sr.normseg(z,W);rows.append(rr)
        rows=np.stack(rows);sel=[0]
        while len(sel)<K:
            c=np.mean(rows[sel],0);cand=[i for i in range(len(rows)) if i not in sel];sel.append(max(cand,key=lambda i:np.linalg.norm(rows[i]-c)))
        P.append(rows[sel]);dur.append((float(np.mean(ds)),float(np.std(ds)+1)))
    return np.stack(P),np.array(dur)

def learn_overlap_integrated(seed,bases,P,dur,n=10):
    r=np.random.default_rng(seed+1700);train=[]
    for _ in range(n):
        ids=r.choice(len(bases),3,replace=False).tolist();x=synth_phrase(bases,ids,r,hard=True);train.append((x,ids,precompute_costs(x,P,dur,min_d=6,max_d=34)))
    rows=[]
    for ov in range(0,8):
        vals=[align_order_cost_cached(x,ids,C,ov,min_d=6,max_d=34) for x,ids,C in train];rows.append({'overlap':ov,'cost':float(np.mean(vals))})
    return min(rows,key=lambda z:z['cost'])['overlap'],rows

def run(seed=281000,trials=48,train=10):
    bases={e:motif_template(seed+1200,e) for e in range(24)};P,d=learn_protos(seed+555,bases);ov,curve=learn_overlap_integrated(seed,bases,P,d,train);r=np.random.default_rng(seed+7000);acc=[];exact=[]
    for q in range(trials):
        e=q%24;ids=[(e+3)%24,e,(e+7)%24];x=synth_phrase(bases,ids,r,hard=True);dec=decode_prior(x,P,d,3,ov,max_shift=3,min_d=6,max_d=34,pen=.025);a=sum(int(i==j) for i,j in zip(dec,ids))/3 if len(dec)==3 else 0;acc.append(a);exact.append(dec==ids)
    return {'seed':seed,'train_connected':train,'learned_overlap':ov,'curve':curve,'token_accuracy':float(np.mean(acc)),'exact_phrase':float(np.mean(exact))}
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);ap.add_argument('--trials',type=int,default=48);ap.add_argument('--train',type=int,default=8);a=ap.parse_args();o=run(a.seed,a.trials,a.train);Path(a.out).write_text(json.dumps(o,indent=2));print(json.dumps(o,indent=2))

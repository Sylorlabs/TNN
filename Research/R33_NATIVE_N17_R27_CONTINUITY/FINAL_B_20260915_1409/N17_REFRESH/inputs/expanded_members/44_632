#!/usr/bin/env python3
import argparse,json,sys
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent));from integrated_r28 import train_student,ACTIONS
from entity_aeif_factorial import render

def closest_candidates(w,rep,eff,target,k=3):
    tv=np.mean(rep.epi[target],axis=0);te=np.array([eff.pred(target,a) for a in range(ACTIONS)])
    rows=[]
    for c in range(len(w.bases)):
        if c==target:continue
        vv=np.mean(rep.epi[c],axis=0);ee=np.array([eff.pred(c,a) for a in range(ACTIONS)])
        # evaluator adversarial selection only; not shown to learner.
        d=np.linalg.norm(tv-vv)+.6*np.linalg.norm(te-ee)
        rows.append((d,c))
    return [target]+[c for _,c in sorted(rows)[:k]]

def teach(rep,w,eff,target,cands,r,question,action_noise=.12):
    epi=rep.epi[target];sel=[0]
    while len(sel)<min(4,len(epi)):
        cc=np.mean(epi[sel],0);cand=[i for i in range(len(epi)) if i not in sel];sel.append(max(cand,key=lambda i:np.linalg.norm(epi[i]-cc)))
    msgs=epi[sel]
    visual=[]
    for c in cands:
        rv=np.stack([render(w.bases[c],kind,r) for kind in ['clean','view','scale','noise','occ.3','occ.6']])
        visual.append(float(np.mean([np.min(np.linalg.norm(rv-m[None,:],axis=1)) for m in msgs])))
    order=np.argsort(visual);pred=cands[int(order[0])]
    if pred==target and visual[order[1]]-visual[order[0]]>.22:return True
    if not question:return pred==target
    # choose action with maximum minimum learned separation.
    best_a=max(range(ACTIONS),key=lambda a:min(abs(eff.pred(target,a)-eff.pred(c,a)) for c in cands if c!=target))
    demo=eff.pred(target,best_a)+r.normal(0,action_noise)
    obs=[]
    for c in cands: obs.append(abs(eff.pred(c,best_a)+r.normal(0,action_noise)-demo))
    return cands[int(np.argmin(obs))]==target

def run(seed=281000,trials=120):
    w,rep,ident,mem,eff,names,templates=train_student(seed,256,'MASTER_DIVERSE');r=np.random.default_rng(seed+55555);res={'passive':[],'question':[],'question_high_noise':[]}
    for q in range(trials):
        t=q%len(w.bases);c=closest_candidates(w,rep,eff,t)
        res['passive'].append(teach(rep,w,eff,t,c,r,False));res['question'].append(teach(rep,w,eff,t,c,r,True,.12));res['question_high_noise'].append(teach(rep,w,eff,t,c,r,True,.25))
    return {'seed':seed,'trials':trials,'accuracy':{k:float(np.mean(v)) for k,v in res.items()}}

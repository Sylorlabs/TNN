#!/usr/bin/env python3
from pathlib import Path
import hashlib,subprocess,shutil,json
root=Path(__file__).resolve().parents[1]
build=root/'build/r3-fresh';out=root/'results/r3/fresh-rerun'
shutil.rmtree(build,ignore_errors=True);shutil.rmtree(out,ignore_errors=True)
build.mkdir(parents=True);out.mkdir(parents=True)
cases=['r430_parallel_hypotheses','r440_grounded_dialogue_reasoning','r450_active_clarification']
audit=[]
for case in cases:
    data={}
    for cc in ('gcc','clang'):
        binp=build/f'{case}_{cc}'
        cmd=[cc,'-std=c11','-O2','-Wall','-Wextra','-Werror','-pedantic','-ffp-contract=off','-I'+str(root/'src'),str(root/'experiments'/f'{case}.c'),'-lm','-o',str(binp)]
        p=subprocess.run(cmd,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        if p.returncode:raise SystemExit(f'{case} {cc} compile failed:\n{p.stderr.decode(errors="replace")}')
        q=subprocess.run([str(binp)],cwd=root,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=300)
        data[cc]=q.stdout;(out/f'{case}_{cc}.csv').write_bytes(q.stdout)
        audit.append({'case':case,'compiler':cc,'sha256':hashlib.sha256(q.stdout).hexdigest()})
    if data['gcc']!=data['clang']:raise SystemExit(f'compiler output mismatch: {case}')
    if data['gcc']!=(root/f'results/r3/{case}_gcc.csv').read_bytes():raise SystemExit(f'fresh output differs from promoted: {case}')
# Lab compilation, persistent state and transcript parity.
outputs={};states={};reg_outputs={};reg_states={}
for cc in ('gcc','clang'):
    binp=build/f'tnn_r3_lab_{cc}'
    p=subprocess.run([cc,'-std=c11','-O2','-Wall','-Wextra','-Werror','-pedantic','-ffp-contract=off',str(root/'apps/tnn_r3_lab.c'),'-o',str(binp)],stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    if p.returncode:raise SystemExit(f'lab {cc} compile failed:\n{p.stderr.decode(errors="replace")}')
    state=out/f'lab_{cc}.bin'
    tr=subprocess.run([str(binp),str(state),str(root/'training/r3_combined_curriculum.txt')],cwd=root,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    qr=subprocess.run([str(binp),str(state),str(root/'training/zag_query_suite.txt')],cwd=root,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    outputs[cc]=tr.stdout+qr.stdout;states[cc]=state.read_bytes();(out/f'lab_{cc}.txt').write_bytes(outputs[cc])
    rs=out/f'regression_{cc}.bin'
    subprocess.run([str(binp),str(rs),str(root/'training/r3_regression_train.txt')],cwd=root,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    rq=subprocess.run([str(binp),str(rs),str(root/'training/r3_regression_query.txt')],cwd=root,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE).stdout
    reg_outputs[cc]=rq;reg_states[cc]=rs.read_bytes();(out/f'regression_{cc}.txt').write_bytes(rq)
if outputs['gcc']!=outputs['clang']:raise SystemExit('lab transcript mismatch')
if states['gcc']!=states['clang']:raise SystemExit('lab state mismatch')
if states['gcc']!=(root/'state/r3_english_zag_seed.bin').read_bytes():raise SystemExit('lab state differs from promoted state')
if reg_outputs['gcc']!=reg_outputs['clang']:raise SystemExit('semantic regression transcript mismatch')
if reg_states['gcc']!=reg_states['clang']:raise SystemExit('semantic regression state mismatch')
if reg_states['gcc']!=(root/'state/r3_regression_trained.bin').read_bytes():raise SystemExit('semantic regression state differs from promoted state')
text=reg_outputs['gcc'].decode()
for marker in ['category chain','learned causes chain','learned supports chain','No. bird is not red','Yes. bird is blue','The first bird observation was red']:
    if marker not in text:raise SystemExit(f'missing semantic marker: {marker}')
(root/'results/r3/fresh-audit.json').write_text(json.dumps({'experiments':audit,'lab_state_sha256':hashlib.sha256(states['gcc']).hexdigest(),'regression_state_sha256':hashlib.sha256(reg_states['gcc']).hexdigest(),'gcc_clang_exact':True,'promoted_state_exact':True},indent=2,sort_keys=True)+'\n')
print(f'R3_EXPERIMENTS={len(cases)}')
print('R3_GCC_CLANG_EXACT_PASS=1')
print('R3_PROMOTED_OUTPUT_EXACT_PASS=1')
print('R3_PERSISTENT_STATE_PARITY_PASS=1')
print('R3_REVISION_PROVENANCE_REGRESSION_PASS=1')
print('ADULT_ENGLISH_GATE=0')
print('NATIVE_ZAG_MASTERY_GATE=0')

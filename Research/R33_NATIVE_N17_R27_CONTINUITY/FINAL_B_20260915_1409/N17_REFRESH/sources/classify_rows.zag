// Native receipt classification. Normative row/blocker text is supplied as TSV.
// Only a fresh exit-zero native predicate receipt can receive row credit.
@import("../../../../R33_NATIVE_IO_V1.zag")
@import("../../../../R33_NATIVE_SHA256_V2.zag")
fn cq(s:[]u8)[]u8 {let out:[]u8="\"";let i:i32=0;while(i<s.len){let c:u8=s[i];if(c==34){out=_zag_str_concat(out,"\\\"");}else if(c==92){out=_zag_str_concat(out,"\\\\");}else if(c==10){out=_zag_str_concat(out,"\\n");}else if(c==13){out=_zag_str_concat(out,"\\r");}else if(c==9){out=_zag_str_concat(out,"\\t");}else if(c<32){return "null";}else{out=_zag_str_concat(out,s[i..i+1]);}i=i+1;}return _zag_str_concat(out,"\"");}
fn cf(line:[]u8,n:i32)[]u8 {let start:i32=0;let i:i32=0;let index:i32=0;while(i<=line.len){if(i==line.len||line[i]==9){if(index==n){return line[start..i];}index=index+1;start=i+1;}i=i+1;}return "";}
fn ch(data:[]u8)[]u8 {let h:[]u8=nio_alloc(32);if(h.len!=32||ns_sha256(data,h)!=0){return "";}let t:[]u8=ns_hex(h);nio_free(h);return t;}
fn contains(data:[]u8,needle:[]u8)i32 {if(needle.len==0||needle.len>data.len){return 0;}let i:i32=0;while(i<=data.len-needle.len){if(nio_equal(data[i..i+needle.len],needle)==1){return 1;}i=i+1;}return 0;}
fn main()i32 {if(_zag_argc()!=4){return 64;}let root:[]u8=_zag_arg(1);let spec:[]u8=_zag_read_file(_zag_arg(2));if(spec.len==0){return 66;}let out:[]u8="{\"schema\":\"N17_NATIVE_ROW_CLASSIFICATIONS_V1\",\"full_verifier_equivalent_continuity\":false,\"scientific_exposure\":0,\"canonical_step\":60423,\"newborn_restarts\":0,\"rows\":[";let i:i32=0;let start:i32=0;let count:i32=0;let direct:i32=0;let equivalent:i32=0;let blocked:i32=0;let seen27:i32=0;let seen26:i32=0;while(i<=spec.len){if(i==spec.len||spec[i]==10){let line:[]u8=spec[start..i];if(line.len>0){let id:[]u8=cf(line,0);let name:[]u8=cf(line,1);let condition:[]u8=cf(line,2);let reason:[]u8=cf(line,3);let closure:[]u8=cf(line,4);let label:[]u8=cf(line,5);let needle:[]u8=cf(line,6);let kind:[]u8=cf(line,7);let member:[]u8=cf(line,8);let knownhash:[]u8=cf(line,9);if(id.len!=6||condition.len==0){return 67;}let seq:i32=0;if(nio_equal(id[0..4],"R27-")==1){seen27=seen27+1;seq=seen27;}else if(nio_equal(id[0..4],"R26-")==1){seen26=seen26+1;seq=seen26;}else{return 68;}if((id[4] as i32)-48!=seq/10||(id[5] as i32)-48!=seq%10){return 69;}
let status:[]u8="FAIL_CLOSED_REVIEW_COMPLETED";let classification:[]u8="DEFERRED_BLOCKER";let evidence:[]u8="";let evidencehash:[]u8="";let ok:i32=0;if(label.len>0){let base:[]u8=_zag_str_concat(_zag_str_concat(root,"/logs/"),label);let exitbytes:[]u8=_zag_read_file(_zag_str_concat(base,".exit"));let stdout:[]u8=_zag_read_file(_zag_str_concat(base,".stdout"));if(nio_equal(exitbytes,"0\n")!=1||contains(stdout,needle)!=1){return 70;}ok=1;evidence=_zag_str_concat(base,".stdout");evidencehash=ch(stdout);if(nio_equal(kind,"equivalent")==1){status="PASS_FRESH_REVIEWED_INERT_NATIVE_EQUIVALENT";classification="NATIVE_EQUIVALENT_REQUIRES_REVIEW";equivalent=equivalent+1;}else{status="PASS_FRESH_NATIVE_STATIC_SCOPE";classification="DIRECT_NATIVE_RECOMPUTATION";direct=direct+1;}}else{blocked=blocked+1;if(reason.len==0||closure.len==0){return 71;}}
if(count>0){out=_zag_str_concat(out,",");}out=_zag_str_concat(out,_zag_str_concat("{\"id\":",cq(id)));out=_zag_str_concat(out,_zag_str_concat(",\"name\":",cq(name)));out=_zag_str_concat(out,_zag_str_concat(",\"condition\":",cq(condition)));out=_zag_str_concat(out,_zag_str_concat(",\"class\":",cq(classification)));out=_zag_str_concat(out,_zag_str_concat(",\"status\":",cq(status)));out=_zag_str_concat(out,",\"full_runtime_qualified\":false,\"independent_review_absent\":false");out=_zag_str_concat(out,_zag_str_concat(",\"blocker\":",cq(reason)));out=_zag_str_concat(out,_zag_str_concat(",\"closure_requires\":",cq(closure)));out=_zag_str_concat(out,_zag_str_concat(",\"required_member\":",cq(member)));out=_zag_str_concat(out,_zag_str_concat(",\"known_sha256\":",cq(knownhash)));out=_zag_str_concat(out,_zag_str_concat(",\"fresh_evidence\":",cq(evidence)));out=_zag_str_concat(out,_zag_str_concat(",\"fresh_evidence_sha256\":",cq(evidencehash)));out=_zag_str_concat(out,"}");count=count+1;}start=i+1;}i=i+1;}if(seen27!=33||seen26!=47){return 72;}out=_zag_str_concat(out,"]");out=_zag_str_concat(out,_zag_str_concat(",\"direct_static_passes\":",_zag_i64_to_str(direct as i64)));out=_zag_str_concat(out,_zag_str_concat(",\"reviewed_inert_equivalent_passes\":",_zag_i64_to_str(equivalent as i64)));out=_zag_str_concat(out,_zag_str_concat(",\"blocked_source_rows\":",_zag_i64_to_str(blocked as i64)));out=_zag_str_concat(out,_zag_str_concat(",\"normative_spec_sha256\":",cq(ch(spec))));out=_zag_str_concat(out,",\"scope_exclusions\":[\"No stored metric is regenerated training or inference\",\"Digest comparison witnesses are not standalone release summaries\",\"R27 cached R26 digest is separately freshly recomputed; fused dependency service unqualified\",\"No whole historical runtime/type/subclass/metaclass equivalence\",\"No manifest vacuous pass from audit-root absence\",\"No R25 68/68 lineage credit from historical receipt\",\"No learning, authority, promotion or canonical mutation\"]}\n");return _zag_write_file(_zag_arg(3),out);}

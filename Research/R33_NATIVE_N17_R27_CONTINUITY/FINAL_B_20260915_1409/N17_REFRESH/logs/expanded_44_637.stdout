#!/usr/bin/env python3
import argparse,json,sys
from pathlib import Path
import numpy as np
sys.path.insert(0,'/mnt/data/tnn-r28-aeif-no-graph/experiments')
from entity_aeif_factorial import World,render,Rep,Model,eval_model
KINDS=['clean','view','scale','noise','occ.3','occ.55','compound']

def make_pool(w,seed,maxn=320):
 return [[(KINDS[j%7],render(b,KINDS[j%7],np.random.default_rng(seed*100003+e*997+j))) for j in range(maxn)] for e,b in enumerate(w.bases)]

def diagnostic_select(w,pool,dose,seed):
 # Start with a balanced base so the Master never destroys ordinary competence.
 selected=[[] for _ in w.bases];ptr={k:0 for k in KINDS}
 base=min(dose,14)
 for e,rows in enumerate(pool):
  for j in range(base): selected[e].append(j)
 if dose<=base:return [np.stack([pool[e][i][1] for i in selected[e]]) for e in range(len(pool))]
 # Add 8-example/entity batches from the currently weakest corruption family.
 while len(selected[0])<dose:
  views=[np.stack([pool[e][i][1] for i in selected[e]]) for e in range(len(pool))];rep=Rep(views,max_epi=16)
  errors={}
  for k in KINDS:
   ok=[]
   for e,b in enumerate(w.bases):
    x=render(b,k,np.random.default_rng(seed+len(selected[0])*137+e));dc,de,dp=rep.distances(x);ok.append(int(np.argmin(de)==e))
   errors[k]=1-np.mean(ok)
  # choose weakest; tie rotates deterministically to avoid curriculum collapse.
  worst=max(KINDS,key=lambda k:(errors[k],-KINDS.index(k)))
  nadd=min(8,dose-len(selected[0]))
  # consume unseen examples of that transform for every entity
  for e,rows in enumerate(pool):
   cand=[i for i,(kk,_) in enumerate(rows) if kk==worst and i not in selected[e]]
   selected[e]+=cand[:nadd]
  # if transform pool exhausted, fill diverse remaining examples
  if len(selected[0])<base+1:
   break
 return [np.stack([pool[e][i][1] for i in selected[e][:dose]]) for e in range(len(pool))]

def select_simple(pool,policy,dose,seed):
 r=np.random.default_rng(seed);out=[]
 for e,rows in enumerate(pool):
  if policy=='MIXED':
   ids=list(range(min(7,dose)));rest=[i for i in range(len(rows)) if i not in ids];r.shuffle(rest);ids=(ids+rest)[:dose]
  else: # random
   ids=r.choice(len(rows),dose,replace=False).tolist()
  out.append(np.stack([rows[i][1] for i in ids]))
 return out

def run(seed):
 w=World(seed);pool=make_pool(w,seed+77);doses=[16,32,64,128,256];rows=[]
 for d in doses:
  for pol in ['RANDOM','MIXED','DIAGNOSTIC_MASTER']:
   views=diagnostic_select(w,pool,d,seed+900) if pol=='DIAGNOSTIC_MASTER' else select_simple(pool,pol,d,seed+900)
   rep=Rep(views,max_epi=16);m=Model('AEIF_ACTIVE',rep,w,seed+333);met=eval_model(m,w,seed+1000,4);rows.append({'seed':seed,'dose':d,'policy':pol,**met})
 return rows
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);a=ap.parse_args();o=run(a.seed);Path(a.out).write_text(json.dumps(o,indent=2));print('done',len(o))

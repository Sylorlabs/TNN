#!/usr/bin/env python3
from pathlib import Path
import csv,json,hashlib
root=Path(__file__).resolve().parents[1]
rows=list(csv.DictReader((root/'results/promoted-evidence.csv').open()))
assert rows
ids=[r['evidence_id'] for r in rows];assert len(ids)==len(set(ids))
maprows=[]
for line in (root/'experiments/PROMOTED_MAP.tsv').read_text().splitlines():
    if not line.strip():continue
    src,base=line.split('\t');maprows.append((src,base));assert (root/'experiments'/src).is_file()
    g=root/f'results/gcc/{base}.csv';c=root/f'results/clang/{base}.csv';assert g.is_file() and c.is_file() and g.read_bytes()==c.read_bytes()
summary=json.loads((root/'results/summary.json').read_text())
assert summary['release']=='TNN pre-v1 R4'
assert summary['promoted_programs']==len(maprows);assert summary['promoted_evidence_rows']==len(rows)
for key in ('teenager_english','adult_english','continuous_natural_multimodal_development','native_zag_quantitative_parity','open_domain_learn_anything'):
    assert summary['production_gates'][key]=='NOT_MET'
assert summary['production_gates']['human_superior_learning_memory']=='NOT_EVALUATED'
assert summary['production_gates']['production_v1']=='NOT_PROMOTED'
def sha(p):return hashlib.sha256((root/p).read_bytes()).hexdigest()
assert sha('state/r3_english_zag_seed.bin')==summary['r3_additions']['english_zag_state_sha256']
assert sha('state/r3_regression_trained.bin')==summary['r3_additions']['regression_state_sha256']
for src in ('r430_parallel_hypotheses.c','r440_grounded_dialogue_reasoning.c','r450_active_clarification.c','r460_contrastive_motif_induction.c'):
    found=[r for r in rows if r['source']==src];assert found
    assert all(r['evidence_class']=='REFERENCE_C_FRESH_GCC_CLANG_SANITIZED' for r in found)
for name in ('README.md','STATUS.md','docs/R3_RESULTS.md','docs/R3_FAILURES.md','docs/R3_CLAIM_MATRIX.md','docs/R3_ZAG_STATUS.md','docs/R4_RESULTS.md','docs/R4_FAILURES.md','docs/R4_CLAIM_MATRIX.md','apps/tnn_r3_lab.c','zag/tnn_pre_v1_r3.zag','src/cmi.c','src/cmi.h'):
    assert (root/name).is_file(),name
print(f'VALIDATED_PROGRAMS={len(maprows)}')
print(f'VALIDATED_EVIDENCE_ROWS={len(rows)}')
print('PRESERVED_GCC_CLANG_DIFFERENTIAL_PASS=1')
print('R3_PRODUCTION_GATES_LOCKED=1')

assert sha('src/cmi.c')==summary['r4_additions']['cmi_core_sha256']
assert sha('src/cmi.h')==summary['r4_additions']['cmi_header_sha256']

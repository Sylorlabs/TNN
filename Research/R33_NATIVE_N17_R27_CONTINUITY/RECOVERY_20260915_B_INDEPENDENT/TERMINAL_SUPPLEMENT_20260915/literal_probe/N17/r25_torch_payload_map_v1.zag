@import("r25_release_identity_v1.zag")
@import("r25_digest_component_schema_v1.zag")

// R33-N17 exact R25 Torch digest-payload association V1.
// Fixed offsets are interpreted only after exact source-file SHA-256 admission.
// BINBYTES storage blobs are treated as inert bytes; no pickle/Torch reducer,
// constructor, Python runtime, learner, evaluator or promotion logic executes.


fn r25tm1_u32(b:[]u8,at:i32)i64 @noalloc {
    if(at<0 || at>b.len-4){return -1;}
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn r25tm1_at(b:[]u8,at:i32,s:[]u8)i32 @noalloc {
    if(at<0 || s.len<1 || at>b.len-s.len){return 0;}let i:i32=0;while(i<s.len){if(b[at+i]!=s[i]){return 0;}i=i+1;}return 1;
}
fn r25tm1_binbytes_tail(b:[]u8,op:i32,blob:i32,raw:i32,n:i32)i32 @noalloc {
    if(op<0 || blob<0 || raw<0 || n<0 || op>b.len-5 || b[op]!=66 || r25tm1_u32(b,op+1)!=(blob as i64)){return 0;}
    let payload:i32=op+5;if(payload>b.len-blob || raw<payload || raw>b.len-n){return 0;}
    return (raw+n==payload+blob) as i32;
}
fn r25tm1_append(out:[]u8,at:*i32,prefix:[]u8,key:[]u8,src:[]u8,raw:i32,n:i32)i32 @noalloc {
    if(at==null as *i32 || raw<0 || n<0 || raw>src.len-n){return -25403;}
    let need:i32=prefix.len+key.len+n;if(at.*<0 || at.*>out.len-need){return -25403;}
    let i:i32=0;while(i<prefix.len){out[at.*+i]=prefix[i];i=i+1;}at.*=at.*+prefix.len;
    i=0;while(i<key.len){out[at.*+i]=key[i];i=i+1;}at.*=at.*+key.len;
    i=0;while(i<n){out[at.*+i]=src[raw+i];i=i+1;}at.*=at.*+n;return 0;
}

fn r25tm1_semantic_layout(b:[]u8)i32 @noalloc {
    if(b.len!=7028883 || r25tm1_at(b,5600377,"semantic_generator")!=1 || r25tm1_at(b,5603408,"MotifGenerator")!=1){return 0;}
    if(r25tm1_binbytes_tail(b,5603996,65906,5604243,65664)!=1 ||
       r25tm1_binbytes_tail(b,5670304,21746,5670551,21504)!=1 ||
       r25tm1_binbytes_tail(b,5692123,753,5692369,512)!=1 ||
       r25tm1_binbytes_tail(b,5693160,8306,5693407,8064)!=1 ||
       r25tm1_binbytes_tail(b,5701537,433,5701783,192)!=1 ||
       r25tm1_binbytes_tail(b,5702291,147698,5702538,147456)!=1 ||
       r25tm1_binbytes_tail(b,5850080,196850,5850327,196608)!=1 ||
       r25tm1_binbytes_tail(b,6047019,1778,6047266,1536)!=1 ||
       r25tm1_binbytes_tail(b,6048873,1778,6049120,1536)!=1 ||
       r25tm1_binbytes_tail(b,6051181,175346,6051428,175104)!=1 ||
       r25tm1_binbytes_tail(b,6226608,1610,6226855,1368)!=1){return 0;}return 1;
}
fn r25tm1_core_layout(b:[]u8)i32 @noalloc {
    if(b.len!=482409 || r25tm1_at(b,616,"core_model")!=1){return 0;}
    if(r25tm1_binbytes_tail(b,1528,2228,1777,1984)!=1 || r25tm1_binbytes_tail(b,3818,307,4066,64)!=1 ||
       r25tm1_binbytes_tail(b,4653,30964,4902,30720)!=1 || r25tm1_binbytes_tail(b,35674,371,35922,128)!=1 ||
       r25tm1_binbytes_tail(b,36382,55540,36631,55296)!=1 || r25tm1_binbytes_tail(b,91989,435,92237,192)!=1 ||
       r25tm1_binbytes_tail(b,92761,86260,93010,86016)!=1 || r25tm1_binbytes_tail(b,179088,499,179336,256)!=1 ||
       r25tm1_binbytes_tail(b,180429,262390,180680,262144)!=1 || r25tm1_binbytes_tail(b,442883,755,443131,512)!=1 ||
       r25tm1_binbytes_tail(b,443955,36596,444204,36352)!=1 || r25tm1_binbytes_tail(b,480604,527,480852,284)!=1){return 0;}return 1;
}
fn r25tm1_noise_layout(b:[]u8)i32 @noalloc {
    if(b.len!=499889 || r25tm1_at(b,384,"robust_model")!=1 || r25tm1_at(b,481108,"boundary_model")!=1){return 0;}
    if(r25tm1_binbytes_tail(b,1298,2226,1545,1984)!=1 || r25tm1_binbytes_tail(b,3586,305,3832,64)!=1 ||
       r25tm1_binbytes_tail(b,4419,30962,4666,30720)!=1 || r25tm1_binbytes_tail(b,35438,369,35684,128)!=1 ||
       r25tm1_binbytes_tail(b,36144,55538,36391,55296)!=1 || r25tm1_binbytes_tail(b,91749,433,91995,192)!=1 ||
       r25tm1_binbytes_tail(b,92519,86258,92766,86016)!=1 || r25tm1_binbytes_tail(b,178844,497,179090,256)!=1 ||
       r25tm1_binbytes_tail(b,180179,262388,180428,262144)!=1 || r25tm1_binbytes_tail(b,442631,753,442877,512)!=1 ||
       r25tm1_binbytes_tail(b,443697,36594,443944,36352)!=1 || r25tm1_binbytes_tail(b,480344,525,480590,284)!=1){return 0;}return 1;
}

fn r25tm1_semantic_chunk(src:[]u8,out:[]u8)i32 @noalloc {
    if(out.len!=619763){return -25403;}let at:i32=0;
    if(r25tm1_append(out,&at,"semantic.","ce.bias",src,5701783,192)!=0 || r25tm1_append(out,&at,"semantic.","ce.weight",src,5693407,8064)!=0 ||
       r25tm1_append(out,&at,"semantic.","ch.bias",src,5692369,512)!=0 || r25tm1_append(out,&at,"semantic.","ch.weight",src,5670551,21504)!=0 ||
       r25tm1_append(out,&at,"semantic.","emb.weight",src,5604243,65664)!=0 || r25tm1_append(out,&at,"semantic.","out.bias",src,6226855,1368)!=0 ||
       r25tm1_append(out,&at,"semantic.","out.weight",src,6051428,175104)!=0 || r25tm1_append(out,&at,"semantic.","rnn.bias_hh_l0",src,6049120,1536)!=0 ||
       r25tm1_append(out,&at,"semantic.","rnn.bias_ih_l0",src,6047266,1536)!=0 || r25tm1_append(out,&at,"semantic.","rnn.weight_hh_l0",src,5850327,196608)!=0 ||
       r25tm1_append(out,&at,"semantic.","rnn.weight_ih_l0",src,5702538,147456)!=0){return -25403;}return (at==out.len) as i32;
}
fn r25tm1_speech_chunk(src:[]u8,prefix:[]u8,noise:i32,out:[]u8)i32 @noalloc {
    let want:i32=474200;if(noise==1){want=474212;}if(out.len!=want){return -25403;}let at:i32=0;
    let o0:i32=4066;let o1:i32=1777;let o2:i32=35922;let o3:i32=4902;let o4:i32=92237;let o5:i32=36631;
    let o6:i32=179336;let o7:i32=93010;let o8:i32=443131;let o9:i32=180680;let o10:i32=480852;let o11:i32=444204;
    if(noise==1){o0=3832;o1=1545;o2=35684;o3=4666;o4=91995;o5=36391;o6=179090;o7=92766;o8=442877;o9=180428;o10=480590;o11=443944;}
    if(r25tm1_append(out,&at,prefix,"f.0.bias",src,o0,64)!=0 || r25tm1_append(out,&at,prefix,"f.0.weight",src,o1,1984)!=0 ||
       r25tm1_append(out,&at,prefix,"f.2.bias",src,o2,128)!=0 || r25tm1_append(out,&at,prefix,"f.2.weight",src,o3,30720)!=0 ||
       r25tm1_append(out,&at,prefix,"f.4.bias",src,o4,192)!=0 || r25tm1_append(out,&at,prefix,"f.4.weight",src,o5,55296)!=0 ||
       r25tm1_append(out,&at,prefix,"f.6.bias",src,o6,256)!=0 || r25tm1_append(out,&at,prefix,"f.6.weight",src,o7,86016)!=0 ||
       r25tm1_append(out,&at,prefix,"h.1.bias",src,o8,512)!=0 || r25tm1_append(out,&at,prefix,"h.1.weight",src,o9,262144)!=0 ||
       r25tm1_append(out,&at,prefix,"h.3.bias",src,o10,284)!=0 || r25tm1_append(out,&at,prefix,"h.3.weight",src,o11,36352)!=0){return -25403;}return (at==out.len) as i32;
}

fn r25tm1_extract(r23:[]u8,core_src:[]u8,noise_src:[]u8,semantic:[]u8,core:[]u8,noise:[]u8)i32 {
    if(r23.len!=7028883 || core_src.len!=482409 || noise_src.len!=499889 ||
       r27ma2_hash_matches(r23,"fc24881f104052c09a4cb6e596b01ae5c107d9ae0356c8799ec97eff3edf440b")!=1 ||
       r27ma2_hash_matches(core_src,"a4c803d44ce5c121bf24931d92307abfa4fa463efd5c23c983d17bf51a91cd09")!=1 ||
       r27ma2_hash_matches(noise_src,"e82a8900065ab8d3d06f9afa9ee36df15c779b44fec1d4135a102af32e0ccf13")!=1){return -25401;}
    if(r25tm1_semantic_layout(r23)!=1 || r25tm1_core_layout(core_src)!=1 || r25tm1_noise_layout(noise_src)!=1){return -25402;}
    if(r25tm1_semantic_chunk(r23,semantic)!=1 || r25tm1_speech_chunk(core_src,"speech_core.",0,core)!=1 || r25tm1_speech_chunk(noise_src,"speech_noise.",1,noise)!=1){return -25403;}
    if(r25cs1_module_chunks(semantic,core,noise)!=0){return -25404;}
    if(r27ma2_hash_matches(semantic,"2cf70bf3938477bcf0d75977df785a1a1e6da83fdd01bb3d4a8104f951f9b2d2")!=1 ||
       r27ma2_hash_matches(core,"76a3617e39c68588ea1edb29a1062d0a1dbf26fbe1c495948151fe118abb1495")!=1 ||
       r27ma2_hash_matches(noise,"95f7ef309900e819571c65dab846f7c81320ce3d7efe129c3a65f3ff5de676eb")!=1){return -25405;}
    return 0;
}

#!/usr/bin/env python3
from pathlib import Path
import csv, hashlib, json, shutil, subprocess
root=Path(__file__).resolve().parents[1]
build=root/'build/r4-fresh';out=root/'results/r4/fresh-rerun'
shutil.rmtree(build,ignore_errors=True);shutil.rmtree(out,ignore_errors=True)
build.mkdir(parents=True);out.mkdir(parents=True)
outputs={}
for cc in ('gcc','clang'):
    binary=build/f'r460_{cc}'
    cmd=[cc,'-std=c11','-O2','-Wall','-Wextra','-Werror','-pedantic','-ffp-contract=off','-I'+str(root/'src'),str(root/'experiments/r460_contrastive_motif_induction.c'),str(root/'src/cmi.c'),'-lm','-o',str(binary)]
    p=subprocess.run(cmd,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    if p.returncode: raise SystemExit(p.stderr.decode(errors='replace'))
    q=subprocess.run([str(binary)],cwd=root,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=120)
    outputs[cc]=q.stdout;(out/f'r460_{cc}.csv').write_bytes(q.stdout)
if outputs['gcc']!=outputs['clang']:raise SystemExit('R4 GCC/Clang output mismatch')
expected=(root/'results/gcc/r460_contrastive_motif_induction.csv').read_bytes()
if outputs['gcc']!=expected:raise SystemExit('R4 fresh output differs from promoted result')
rows=list(csv.DictReader((out/'r460_gcc.csv').open()))
by={r['metric']:r for r in rows}
def value(metric):return float(by[metric]['value'])
assert value('arbitrary_surface_tuple_accuracy')>=.98
assert value('no_space_tuple_accuracy')>=.98
assert value('conflicting_context_accuracy')>=.95
assert value('first_context_retention')>=.95
assert value('one_lesson_construction_accuracy')>=.95
assert value('one_exposure_word_accuracy')>=.95
assert value('controlled_english_tuple_accuracy')>=.98
assert value('controlled_generation_roundtrip')>=.98
assert value('tuple_accuracy')<.02
assert value('operation_ratio')<.10
assert value('english_operation_ratio')<.12
assert value('post_reload_accuracy')>=.99
assert value('teenager_english_gate')==0
assert value('adult_english_gate')==0
subprocess.run([str(root/'scripts/audit_r4_language_core.py')],cwd=root,check=True)
report={'gcc_clang_exact':True,'sha256':hashlib.sha256(outputs['gcc']).hexdigest(),'rows':len(rows),'teenager_english':'NOT_MET','adult_english':'NOT_MET','production_v1':'NOT_PROMOTED'}
(out/'verification.json').write_text(json.dumps(report,indent=2,sort_keys=True)+'\n')
print(f'R4_EVIDENCE_ROWS={len(rows)}')
print('R4_GCC_CLANG_EXACT_PASS=1')
print('R4_PROMOTED_OUTPUT_EXACT_PASS=1')
print('R4_ANTI_HARDCODING_AUDIT_PASS=1')
print('R4_TEENAGER_ENGLISH_GATE=0')
print('R4_ADULT_ENGLISH_GATE=0')
print('R4_PRODUCTION_V1=NOT_PROMOTED')

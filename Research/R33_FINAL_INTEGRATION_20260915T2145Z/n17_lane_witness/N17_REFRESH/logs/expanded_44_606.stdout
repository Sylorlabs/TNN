#!/usr/bin/env python3
import json,sys
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent))
from integrated_r28 import motif_template
from speech_integrated_train_r28 import vary_int

def rs(z,W=28):
 x=np.interp(np.linspace(0,len(z)-1,W),np.arange(len(z)),z);return (x-x.mean())/(x.std()+1e-8)
def pair_episode(a,b,r):
 za=vary_int(a,r);zb=vary_int(b,r);out=za.tolist();bd=len(out)
 ov=min(4,len(zb),len(out))
 for j in range(ov):
  al=(j+1)/(ov+1);out[-ov+j]=(1-al)*out[-ov+j]+al*zb[j]
 zb=zb[ov:];st=len(out);out.extend(zb.tolist());return np.array(out),st

def train(seed,bases,n=50):
 r=np.random.default_rng(seed);M=len(bases);D=28;ctx=np.zeros((M,M,D));ctxsd=np.zeros_like(ctx);plain=np.zeros((M,D));plainsd=np.zeros_like(plain)
 for b in range(M):
  X=np.stack([rs(vary_int(bases[b],r)) for _ in range(n)]);plain[b]=X.mean(0);plainsd[b]=X.std(0)+.20
 for a in range(M):
  for b in range(M):
   X=[]
   for _ in range(n):
    z,st=pair_episode(bases[a],bases[b],r);X.append(rs(z[max(0,st-4):]))
   X=np.stack(X);ctx[a,b]=X.mean(0);ctxsd[a,b]=X.std(0)+.20
 return plain,plainsd,ctx,ctxsd

def pred_plain(z,p,ps):
 x=rs(z);return int(np.argmin([np.mean(((x-p[i])/ps[i])**2) for i in range(len(p))]))
def pred_ctx(z,a,c,cs):
 x=rs(z);return int(np.argmin([np.mean(((x-c[a,b])/cs[a,b])**2) for b in range(c.shape[1])]))
def run(seed=281000,trials=120):
 bases={e:motif_template(seed+1200,e) for e in range(24)};p,ps,c,cs=train(seed+400,bases,n=42);r=np.random.default_rng(seed+9000);plain=[];ctx=[]
 for _ in range(trials):
  ids=r.choice(24,3,replace=False).tolist();out=[];sp=[]
  for ii,e in enumerate(ids):
   z=vary_int(bases[e],r);st=len(out)
   if ii>0:
    ov=min(4,len(z),len(out))
    for j in range(ov):
     al=(j+1)/(ov+1);out[-ov+j]=(1-al)*out[-ov+j]+al*z[j]
    z=z[ov:];st=len(out)
   out.extend(z.tolist());sp.append((st,len(out),e))
  x=np.array(out)
  for i,(st,en,e) in enumerate(sp):
   z=x[max(0,st-4):en]
   plain.append(pred_plain(z,p,ps)==e)
   if i==0:ctx.append(pred_plain(z,p,ps)==e)
   else:ctx.append(pred_ctx(z,ids[i-1],c,cs)==e)
 return {'seed':seed,'trials':trials,'plain_pre4':float(np.mean(plain)),'context_conditioned_pre4':float(np.mean(ctx))}
if __name__=='__main__':
 o=run();print(json.dumps(o,indent=2));Path('/mnt/data/tnn-r28-aeif-no-graph/results/speech_r28/acoustic_context_tournament.json').write_text(json.dumps(o,indent=2))

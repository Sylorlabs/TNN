#!/usr/bin/env python3
from pathlib import Path
import hashlib,subprocess,sys,json
ROOT=Path(__file__).resolve().parents[1]
bad=[];n=0
for line in (ROOT/'MANIFEST.sha256').read_text().splitlines():
    if not line.strip():continue
    want,path=line.split('  ',1);p=ROOT/path[2:] if path.startswith('./') else ROOT/path
    n+=1
    if not p.is_file(): bad.append([path,'MISSING']);continue
    got=hashlib.sha256(p.read_bytes()).hexdigest()
    if got!=want:bad.append([path,got,want])
cp=subprocess.run([sys.executable,str(ROOT/'verification/verify_r28_shadow.py')],cwd=ROOT,text=True,capture_output=True)
out={'manifest_entries':n,'manifest_bad':bad,'manifest_pass':not bad,'shadow_verifier_exit':cp.returncode,'shadow_verifier_stdout':cp.stdout.strip(),'native_compile':'BLOCKED_ENV'}
print(json.dumps(out,indent=2));sys.exit(0 if not bad and cp.returncode==0 else 1)

#!/usr/bin/env python3
from __future__ import annotations
import argparse,json,math
from pathlib import Path
from collections import defaultdict
import numpy as np

GRAPH_ARCHS=['G_STATIC','G_TEMPORAL','G_MULTIVIEW','G_UNCERTAINTY','G_PREDICTIVE','G_ACTIVE','G_ASSOC','G_PARTICLE','G_BLACKBOARD','G_ALL']
NOGRAPH_ARCHS=['AE_PURE','AE_TEMP','AE_PRED','AE_REL','AE_ACTIVE','AE_TEMP_PRED','AE_TEMP_REL','AE_PRED_REL','AE_TEMP_PRED_REL','AEIF_ACTIVE','SLOT','PARTICLE','FIELD','BLACKBOARD','PROCESS','FOUNDRY_HYBRID']
ARCHS=GRAPH_ARCHS+NOGRAPH_ARCHS
MODES=['RANDOM','BALANCED','MAX_DIVERSITY','ADAPTIVE_MASTER','CONTRASTIVE','COUNTEREXAMPLE','ACTIVE_SELF','TNN_REPLAY','SIBLING_ASSIST','MASTER_DIVERSE','MIXED']
CONDS=['viewpoint','scale_light','noise','occlusion50','occlusion80','disappear_reappear','near_twin','true_switch','switch_occluded','long_gap_replacement','ambiguous_mix','high_conf_corruption','crossing','compound']

class World:
 def __init__(self,seed,n=30,d=20):
  r=np.random.default_rng(seed);bs=[];self.twins=np.full(n,-1,int)
  for i in range(n):
   if i%2 and i<24:b=bs[i-1]+r.normal(0,.13,d);self.twins[i]=i-1;self.twins[i-1]=i
   else:b=r.lognormal(1,.62,d)
   bs.append(np.asarray(b))
  self.bases=np.stack(bs);self.afford=r.normal(size=(n,4,5));self.names=r.normal(size=(n,16))

def sig(raw,vis=None):
 raw=np.asarray(raw);n=len(raw);vis=np.ones(n,bool) if vis is None else vis;v=raw[vis]
 if len(v)==0:return np.zeros(32)
 mu=v.mean();sd=v.std()+1e-6;z=(v-mu)/sd;s=np.sort(z);rs=np.interp(np.linspace(0,max(len(s)-1,1),16),np.arange(len(s)),s) if len(s)>1 else np.repeat(s,16)
 if len(v)>1:
  t=np.abs(v[:,None]-v[None,:])[np.triu_indices(len(v),1)]/sd;q=np.quantile(t,[.1,.2,.3,.4,.5,.6,.7,.8])
 else:q=np.zeros(8)
 m=np.array([mu/12,sd/6,np.mean(np.abs(z)),len(v)/n,np.min(z),np.max(z),np.median(z),np.quantile(z,.75)-np.quantile(z,.25)])
 return np.concatenate([rs,q,m])

def render(base,kind,r):
 x=np.array(base,float);n=len(x);v=np.ones(n,bool)
 if kind=='clean':x+=r.normal(0,.02,n)
 elif kind=='view':x=x[r.permutation(n)]*r.uniform(.72,1.34)+r.uniform(-.5,.5)+r.normal(0,.07,n)
 elif kind=='scale':x=x*r.uniform(.48,1.75)+r.uniform(-1.3,1.3)+r.normal(0,.08,n)
 elif kind=='noise':x+=r.normal(0,.4,n)
 elif kind.startswith('occ'):
  f=float(kind[3:]);ix=r.choice(n,max(1,int(f*n)),False);v[ix]=False;x[ix]=0;p=r.permutation(n);x=x[p];v=v[p]
 elif kind=='compound':
  p=r.permutation(n);x=x[p]*r.uniform(.55,1.5)+r.uniform(-1,1)+r.normal(0,.3,n);v=v[p];ix=r.choice(n,int(.55*n),False);v[ix]=False;x[ix]=0
 return sig(x,v)

def make_training(w,mode,dose,seed):
 r=np.random.default_rng(seed);kinds=['clean','view','scale','noise','occ.3','occ.55','compound'];out=[]
 for e,b in enumerate(w.bases):
  pool=[(kinds[j%7],render(b,kinds[j%7],np.random.default_rng(seed*100003+e*997+j))) for j in range(max(48,dose))]
  if mode=='RANDOM':ids=r.choice(len(pool),dose,False)
  elif mode=='BALANCED':ids=np.arange(dose)
  elif mode in ('MAX_DIVERSITY','ACTIVE_SELF'):
   ids=[0]
   while len(ids)<dose:
    # cheap diversity against current mean, not O(k^3)
    c=np.mean([pool[i][1] for i in ids],0);cand=[i for i in range(len(pool)) if i not in ids];ids.append(max(cand,key=lambda i:np.linalg.norm(pool[i][1]-c)))
  elif mode=='ADAPTIVE_MASTER':
   p={'compound':8,'occ.55':7,'noise':6,'occ.3':5,'view':4,'scale':3,'clean':1};ids=sorted(range(len(pool)),key=lambda i:p[pool[i][0]],reverse=True)[:dose]
  elif mode in ('CONTRASTIVE','COUNTEREXAMPLE'):
   t=w.twins[e];center=render(w.bases[t],'clean',np.random.default_rng(seed+e)) if t>=0 else pool[0][1];near=sorted(range(len(pool)),key=lambda i:np.linalg.norm(pool[i][1]-center))
   if mode=='CONTRASTIVE':ids=near[:dose]
   else:ids=(near[:max(1,dose//2)]+near[::-1][:dose-max(1,dose//2)])
  elif mode=='TNN_REPLAY':
   c=np.mean([x for _,x in pool[:7]],0);ids=sorted(range(len(pool)),key=lambda i:np.linalg.norm(pool[i][1]-c),reverse=True)[:dose]
  elif mode=='SIBLING_ASSIST':
   hard=[i for i,(k,_) in enumerate(pool) if k in ('view','noise','compound')];rest=[i for i in range(len(pool)) if i not in hard];r.shuffle(hard);r.shuffle(rest);ids=(hard[:dose//3]+rest)[:dose]
  elif mode=='MASTER_DIVERSE':
   p={'compound':8,'occ.55':7,'noise':6,'occ.3':5,'view':4,'scale':3,'clean':1};h=max(1,dose//3);a=sorted(range(len(pool)),key=lambda i:p[pool[i][0]],reverse=True)[:h];b=[i for i in range(len(pool)) if i not in a];r.shuffle(b);ids=(a+b)[:dose]
  else:
   # mixed: one of each transform then random diverse remainder
   ids=list(range(min(7,dose)));rest=[i for i in range(len(pool)) if i not in ids];r.shuffle(rest);ids=(ids+rest)[:dose]
  out.append(np.stack([pool[int(i)][1] for i in ids]))
 return out

def soft(a,t):
 z=-a/max(t,1e-6);z-=z.max();e=np.exp(np.clip(z,-60,60));return e/(e.sum()+1e-12)

class Rep:
 def __init__(self,views,max_epi=8):
  self.n=len(views);self.cent=np.stack([v.mean(0) for v in views]);self.spread=np.stack([v.std(0)+.05 for v in views])
  reps=[]
  for v in views:
   if len(v)<=max_epi:rr=v
   else:
    ix=np.linspace(0,len(v)-1,max_epi).astype(int);rr=v[ix]
   if len(rr)<max_epi:rr=np.vstack([rr,np.repeat(rr[-1][None],max_epi-len(rr),0)])
   reps.append(rr)
  self.epi=np.stack(reps) # n,k,d
  self.pred=self.cent.copy()
 def distances(self,x):
  dc=np.linalg.norm((self.cent-x)/(self.spread+.1),axis=1)
  de=np.min(np.linalg.norm(self.epi-x[None,None,:],axis=2),axis=1)
  # predictive residual uses deviation from episodic cloud weighted by spread
  dp=np.sqrt(np.mean(((self.cent-x)/(self.spread+.25))**2,axis=1))
  return dc,de,dp

class Model:
 def __init__(self,arch,rep,w,seed):self.a=arch;self.R=rep;self.n=rep.n;self._calibrate(w,seed);self.reset()
 def reset(self):self.prior=-1;self.post=np.ones(self.n)/self.n
 def probs(self,x):
  dc,de,dp=self.R.distances(x);pc=soft(dc,max(np.median(dc)*.3,.08));pe=soft(de,max(np.median(de)*.3,.08));pp=soft(dp,max(np.median(dp)*.3,.08));a=self.a
  if a in ('G_STATIC','SLOT','FIELD'):p=pc
  elif a in ('G_MULTIVIEW','G_ASSOC','AE_PURE','AE_TEMP','AE_REL','AE_ACTIVE','AE_TEMP_REL','PARTICLE'):p=pe
  elif a in ('G_PREDICTIVE','AE_PRED','AE_TEMP_PRED','AE_PRED_REL','PROCESS'):p=pp
  elif a in ('BLACKBOARD','G_BLACKBOARD'):p=.45*pe+.3*pc+.25*pp
  else:p=.58*pe+.27*pp+.15*pc
  return p/(p.sum()+1e-12),(pc,pe,pp)
 def features(self,x,p,parts):
  s=np.sort(p);ent=-np.sum(p*np.log(p+1e-12))/math.log(self.n);dis=len(set(np.argmax(q) for q in parts))-1
  return np.array([1,float(s[-1]-s[-2]),float(p.max()),float(1-ent),float(x[-5]),float(dis),float(np.std([q.max() for q in parts]))])
 def _calibrate(self,w,seed):
  X=[];Y=[];r=np.random.default_rng(seed)
  for e in range(min(10,self.n)):
   for k in ['clean','view','scale','noise','occ.3','occ.55','compound']:
    x=render(w.bases[e],k,r);p,ps=self.probs(x);X.append(self.features(x,p,ps));Y.append(float(np.argmax(p)==e))
  X=np.stack(X);Y=np.array(Y);self.rw=np.linalg.solve(X.T@X+.3*np.eye(X.shape[1]),X.T@Y);q=np.clip(X@self.rw,0,1);best=(.5,-1)
  for th in np.linspace(.2,.9,29):
   u=np.mean(np.where(q>=th,Y,.76))-.03*np.mean(q<th)
   if u>best[1]:best=(float(th),u)
  self.th=best[0]
 def reliability(self,x,p,ps):return float(np.clip(self.features(x,p,ps)@self.rw,0,1))
 def active(self):return self.a in ('G_ACTIVE','G_ALL','AE_ACTIVE','AEIF_ACTIVE','FOUNDRY_HYBRID')
 def step(self,x):
  if x is None:return self.prior,0,0,True
  p,ps=self.probs(x);fresh=int(np.argmax(p));rel=self.reliability(x,p,ps);a=self.a
  if self.prior<0:pred=fresh;unk=False
  elif a in ('G_STATIC','G_MULTIVIEW','G_PREDICTIVE','G_ASSOC','SLOT','AE_PURE','AE_PRED','AE_REL','AE_PRED_REL','FIELD','PROCESS'):pred=fresh;unk=False
  elif a in ('G_TEMPORAL','AE_TEMP','AE_TEMP_PRED'):pred=fresh if p[fresh]>1.4*p[self.prior] else self.prior;unk=False
  elif a in ('G_UNCERTAINTY','G_PARTICLE','PARTICLE'):
   tr=np.ones(self.n)*.1/(self.n-1);tr[self.prior]=.9;po=p*tr;po/=po.sum()+1e-12;self.post=.3*self.post+.7*po;self.post/=self.post.sum();pred=int(np.argmax(self.post));unk=self.post[pred]<.3
  elif a in ('BLACKBOARD','G_BLACKBOARD'):pred=fresh if rel>=self.th or fresh==self.prior else self.prior;unk=rel<self.th*.65
  elif a in ('G_ACTIVE','G_ALL'):
   graph_support=p[self.prior]*1.28
   if fresh==self.prior:pred=self.prior;unk=False
   elif rel>=self.th and p[fresh]>graph_support:pred=fresh;unk=False
   else:pred=self.prior;unk=True
  else:
   # AEIF-like: reliable episodic evidence may replace identity directly; weak conflict stays unresolved rather than graph-forced.
   if rel>=self.th:pred=fresh;unk=False
   elif fresh==self.prior:pred=self.prior;unk=False
   else:pred=self.prior;unk=True
  self.prior=pred;return (-1 if unk else pred),float(p[fresh]),rel,unk

def trial(m,w,e,c,seed):
 r=np.random.default_rng(seed);m.reset();m.step(render(w.bases[e],'clean',r));t=w.twins[e] if w.twins[e]>=0 else (e+1)%len(w.bases);target=e;unknown=False
 def o(ent,k):return m.step(render(w.bases[ent],k,r))
 if c=='viewpoint':z=o(e,'view')
 elif c=='scale_light':z=o(e,'scale')
 elif c=='noise':z=o(e,'noise')
 elif c=='occlusion50':z=o(e,'occ.5')
 elif c=='occlusion80':z=o(e,'occ.8')
 elif c=='disappear_reappear':
  for _ in range(8):m.step(None)
  z=o(e,'compound')
 elif c=='near_twin':m.step(render(w.bases[t],'view',r));z=o(e,'view')
 elif c=='true_switch':target=t;z=o(t,'view')
 elif c=='switch_occluded':target=t;z=o(t,'occ.6')
 elif c=='long_gap_replacement':
  for _ in range(20):m.step(None)
  target=t;z=o(t,'view')
 elif c=='ambiguous_mix':
  x=.5*w.bases[e]+.5*w.bases[t];z=m.step(sig(x[r.permutation(len(x))]+r.normal(0,.12,len(x))));unknown=True
 elif c=='high_conf_corruption':
  x=.8*w.bases[t]+.2*w.bases[e]+r.normal(0,.04,len(w.bases[e]));z=m.step(sig(x[r.permutation(len(x))]))
 elif c=='crossing':
  x=.5*w.bases[e]+.5*w.bases[t]+r.normal(0,.1,len(w.bases[e]));m.step(sig(x[r.permutation(len(x))]));z=o(e,'view')
 else:z=o(e,'compound')
 pred,cf,rel,unk=z;extra=0
 if m.active() and (unk or rel<m.th or c in ('high_conf_corruption','switch_occluded')):
  z=o(e if unknown else target,'view');pred,cf,rel,unk=z;extra=1
 ok=(pred==e if extra else pred==-1) if unknown else pred==target
 return int(ok),extra

def eval_model(m,w,seed,n=2):
 d=defaultdict(list);ex=[]
 for ci,c in enumerate(CONDS):
  for j in range(n):
   e=(seed+ci*7+j*11)%len(w.bases);ok,x=trial(m,w,e,c,seed*10007+ci*101+j);d[c].append(ok);ex.append(x)
 out={k:float(np.mean(v)) for k,v in d.items()};out['overall']=float(np.mean([x for v in d.values() for x in v]));out['floor']=min(out[k] for k in ['viewpoint','occlusion80','true_switch','switch_occluded','long_gap_replacement','ambiguous_mix','high_conf_corruption']);out['extra_rate']=float(np.mean(ex));return out

def run_seed(seed,out,dose=32,only_mode=None,n_trials=2):
 w=World(seed);rows=[]
 modes=[only_mode] if only_mode else MODES
 for mode in modes:
  views=make_training(w,mode,dose,seed+77);rep=Rep(views)
  for a in ARCHS:
   m=Model(a,rep,w,seed+333);met=eval_model(m,w,seed+1000,n_trials);rows.append({'seed':seed,'mode':mode,'dose':dose,'arch':a,'graph':a.startswith('G_'),**met})
 Path(out).write_text(json.dumps({'evidence':'REFERENCE_ONLY_NOT_NATIVE_ZAG','rows':rows},indent=2));print('done',seed,len(rows));print(json.dumps(sorted(rows,key=lambda x:(x['floor'],x['overall']),reverse=True)[:10],indent=2))

def combine(files,out):
 rows=[]
 for f in files:rows+=json.loads(Path(f).read_text())['rows']
 g=defaultdict(list)
 for r in rows:g[(r['arch'],r['mode'])].append(r)
 s=[]
 for (a,m),rs in g.items():
  z={'arch':a,'mode':m,'graph':a.startswith('G_'),'n':len(rs)}
  for k in ['overall','floor','viewpoint','occlusion80','true_switch','switch_occluded','long_gap_replacement','ambiguous_mix','high_conf_corruption','compound','extra_rate']:
   q=[x[k] for x in rs];z[k]=float(np.mean(q));z[k+'_sd']=float(np.std(q))
  s.append(z)
 s.sort(key=lambda x:(x['floor'],x['overall']),reverse=True);Path(out).write_text(json.dumps({'evidence':'REFERENCE_ONLY_NOT_NATIVE_ZAG','rows':rows,'summary':s},indent=2));print(json.dumps(s[:30],indent=2))

if __name__=='__main__':
 ap=argparse.ArgumentParser();sp=ap.add_subparsers(dest='cmd',required=True);a=sp.add_parser('seed');a.add_argument('--seed',type=int,required=True);a.add_argument('--out',required=True);a.add_argument('--dose',type=int,default=32);a.add_argument('--mode',default=None);a.add_argument('--n-trials',type=int,default=2);b=sp.add_parser('combine');b.add_argument('--out',required=True);b.add_argument('files',nargs='+');x=ap.parse_args();run_seed(x.seed,x.out,x.dose,x.mode,x.n_trials) if x.cmd=='seed' else combine(x.files,x.out)

#!/usr/bin/env python3
from __future__ import annotations
import argparse,json
from pathlib import Path
from collections import defaultdict
import numpy as np
from sklearn.linear_model import Ridge
from experiments_memory_v3 import make_episode,feat,sufficient,COST,fixed_choose

POLICIES=['PRIVILEGED_HEURISTIC_CONTROL','LRU','RANDOM','EXACT_ALL','STRUCTURED_ALL','DELAYED_Q_LINEAR','DELAYED_Q_POLY','DELAYED_Q_RFF','DELAYED_Q_ENSEMBLE']

def phi_base(r,p):return np.r_[feat(r),p]
def phi_poly(r,p):
 x=phi_base(r,p);out=[*x]
 for i in range(1,len(x)):
  out.append(x[i]*x[i])
  for j in range(i+1,len(x)):out.append(x[i]*x[j])
 return np.asarray(out,float)
class QLearner:
 def __init__(self,kind,dev,seed):
  self.kind=kind;self.rng=np.random.default_rng(seed);self.models=[]
  dim=len(phi_base(dev[0],.5));self.R=self.rng.normal(0,1,(48,dim));self.b=self.rng.uniform(0,2*np.pi,48)
  by=[[] for _ in range(4)];ty=[[] for _ in range(4)]
  for r in dev:
   a=int(self.rng.integers(4));p=float(self.rng.uniform(0,1));ok=sufficient(a,r['q']);rew=r['importance']*(1 if ok else -1)-(.03+.32*p)*COST[a]+(.08*r['retrieval'] if a==0 else 0)
   by[a].append(self.phi(r,p));ty[a].append(rew)
  for a in range(4):self.models.append(Ridge(alpha=2.0).fit(np.stack(by[a]),np.asarray(ty[a])))
 def phi(self,r,p):
  if self.kind=='linear':return phi_base(r,p)
  if self.kind=='poly':return phi_poly(r,p)
  x=phi_base(r,p);return np.r_[x,np.sqrt(2/48)*np.cos(self.R@x+self.b)]
 def values(self,r,p):x=self.phi(r,p).reshape(1,-1);return np.array([float(m.predict(x)[0]) for m in self.models])
class Ensemble:
 def __init__(self,dev,seed):self.a=QLearner('poly',dev,seed);self.b=QLearner('rff',dev,seed+31)
 def values(self,r,p):return .65*self.a.values(r,p)+.35*self.b.values(r,p)

def simulate(name,seed,dev,n=1400,budget=850):
 rng=np.random.default_rng(seed)
 if name=='DELAYED_Q_LINEAR':pol=QLearner('linear',dev,seed)
 elif name=='DELAYED_Q_POLY':pol=QLearner('poly',dev,seed)
 elif name=='DELAYED_Q_RFF':pol=QLearner('rff',dev,seed)
 elif name=='DELAYED_Q_ENSEMBLE':pol=Ensemble(dev,seed)
 else:pol=None
 entries={};used=0.;queries=defaultdict(list);eps=[];by=defaultdict(list);store=[];ev=0
 for i in range(n):
  r=make_episode(rng,i);eps.append(r);pressure=min(1.,used/budget)
  if pol:q=pol.values(r,pressure);a=int(np.argmax(q));val=float(q[a])
  else:a=fixed_choose(name,r,i,rng);val=0
  den=val/(COST[a]+.1) if pol and COST[a]>0 else None;entries[i]={'a':a,'r':r,'last':i,'den':den};used+=COST[a];queries[i+r['delay']].append(i)
  while used>budget:
   cand=[(eid,e) for eid,e in entries.items() if COST[e['a']]>0]
   if not cand:break
   eid,e=min(cand,key=(lambda z:z[1]['den']) if pol else (lambda z:z[1]['last']));used-=COST[e['a']];del entries[eid];ev+=1
  for eid in queries.get(i,[]):
   rr=eps[eid];e=entries.get(eid);by[rr['q']].append(bool(e is not None and sufficient(e['a'],rr['q']))); 
   if e:e['last']=i
  store.append(used)
 for t in range(n,n+330):
  for eid in queries.get(t,[]):
   rr=eps[eid];e=entries.get(eid);by[rr['q']].append(bool(e is not None and sufficient(e['a'],rr['q'])))
 allv=[x for v in by.values() for x in v]
 return {'policy':name,'seed':seed,'overall':float(np.mean(allv)),'exact':float(np.mean(by[0])),'semantic':float(np.mean(by[1])),'source':float(np.mean(by[2])),'procedure':float(np.mean(by[3])),'mean_storage':float(np.mean(store)),'evictions':ev}
def run(out,seeds=8,dev_n=12000,offset=0):
 rows=[]
 for local in range(seeds):
  si=offset+local;rng=np.random.default_rng(285000+si);dev=[make_episode(rng,i) for i in range(dev_n)]
  for p in POLICIES:rows.append(simulate(p,286000+si+abs(hash(p))%7000,dev))
  print('seed',si,'done',flush=True)
 g=defaultdict(list)
 for r in rows:g[r['policy']].append(r)
 s=[]
 for p,rs in g.items():
  z={'policy':p,'n':len(rs)}
  for k in ['overall','exact','semantic','source','procedure','mean_storage','evictions']:
   a=np.array([r[k] for r in rs]);z[k]=float(a.mean());z[k+'_sd']=float(a.std())
  z['utility']=.38*z['exact']+.19*z['semantic']+.19*z['source']+.24*z['procedure']-.0001*z['mean_storage'];s.append(z)
 s=sorted(s,key=lambda x:x['utility'],reverse=True);Path(out).write_text(json.dumps({'status':'REFERENCE_ONLY_NOT_NATIVE','development_random_action_history':dev_n,'rows':rows,'summary':s},indent=2));print(json.dumps(s,indent=2))
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--out',required=True);ap.add_argument('--seeds',type=int,default=8);ap.add_argument('--dev-n',type=int,default=12000);ap.add_argument('--offset',type=int,default=0);a=ap.parse_args();run(a.out,a.seeds,a.dev_n,a.offset)

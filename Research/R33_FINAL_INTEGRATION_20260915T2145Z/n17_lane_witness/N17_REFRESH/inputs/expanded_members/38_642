#!/usr/bin/env python3
import argparse,json,sys,time,multiprocessing as mp
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent))
import speech_r28 as s

def worker(args):
    seed,w,trials=args
    bases={e:s.base_template(seed,e) for e in range(12)}
    P,dur=s.learn_protos(seed+100,bases);BP=s.learn_boundary_protos(seed+300,bases)
    r=np.random.default_rng(seed+500)
    acc=[];exact=[]
    for q in range(trials):
        ids=r.choice(12,4,replace=False).tolist();x=s.phrase(bases,ids,r,hard=True)
        d=s.decode_boundary_pair_beam(x,P,dur,BP,4,beam=80,top_m=2,pair_w=w)
        a=sum(int(i==j) for i,j in zip(d,ids))/4 if len(d)==4 else 0
        acc.append(a);exact.append(a==1)
    return {'seed':seed,'pair_w':w,'trials':trials,'accuracy':float(np.mean(acc)),'exact':float(np.mean(exact))}

def main():
    ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,default=282000);ap.add_argument('--trials',type=int,default=12);ap.add_argument('--out',required=True);a=ap.parse_args()
    ws=[0.0,.08,.16,.28,.42,.60,.85]
    with mp.Pool(min(len(ws),7)) as pool: rows=pool.map(worker,[(a.seed,w,a.trials) for w in ws])
    out={'status':'REFERENCE_ONLY_NOT_NATIVE_ZAG','rows':rows,'best':max(rows,key=lambda x:(x['accuracy'],x['exact']))}
    Path(a.out).write_text(json.dumps(out,indent=2));print(json.dumps(out,indent=2))
if __name__=='__main__':main()

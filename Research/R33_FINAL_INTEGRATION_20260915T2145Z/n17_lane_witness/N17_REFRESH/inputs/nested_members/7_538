#!/usr/bin/env python3
from pathlib import Path
import re
root=Path(__file__).resolve().parents[1]
core=[root/'src/cmi.c',root/'src/cmi.h']
for p in core:
    if not p.is_file() or not p.stat().st_size: raise SystemExit(f'missing core: {p}')
text='\n'.join(p.read_text() for p in core)
for forbidden in ('isspace(', 'strtok(', 'tokenize(', 'word_table', 'phrase_table', 'transformer', 'openai', 'pytorch', 'tensorflow', 'backprop', 'gradient'):
    if forbidden.lower() in text.lower(): raise SystemExit(f'forbidden language-core dependency: {forbidden}')
# Cognitive core has no surface-language string data. The one quoted literal is its own include.
literals=[]
for p in core:
    literals += re.findall(r'"(?:\\.|[^"\\])*"', p.read_text())
if literals != ['"cmi.h"']:
    raise SystemExit(f'unexpected core string literals: {literals}')
exp=(root/'experiments/r460_contrastive_motif_induction.c').read_text()
for required in ('According to the record', 'surface->marker', 'shuffled_grounding_control', 'teenager_english_gate'):
    if required not in exp: raise SystemExit(f'missing evaluator/curriculum marker: {required}')
print('R4_LANGUAGE_CORE_SURFACE_STRINGS=0')
print('R4_WHITESPACE_TOKENIZER=0')
print('R4_FIXED_VOCABULARY=0')
print('R4_LLM_WRAPPER=0')
print('R4_CORE_CURRICULUM_SEPARATION_PASS=1')

// R33-N19 native qualification supervisor V1.
// Launches only the N19 candidate as fresh direct child processes, observes
// wait4 resource accounting, and inspects only owner-created N19 fixture roots.
// No learner, parent state, registry, training, evaluator, or foreign runtime.
@import("n19_native_io_v1.zag")

struct N19QualRun {
    started:i32,
    exit_code:i32,
    signal:i32,
    cpu_us:i64,
    peak_rss:i64,
}

fn n19q_empty_run()N19QualRun {
    return N19QualRun{.started=0,.exit_code=-1,.signal=0,.cpu_us=0,.peak_rss=0};
}

fn n19q_run3(binary:[]u8,mode:[]u8,root:[]u8,leaf:[]u8)N19QualRun {
    let result:N19QualRun=n19q_empty_run();
    let b:[]u8=nio_cstr(binary);let m:[]u8=nio_cstr(mode);let r:[]u8=nio_cstr(root);let l:[]u8=nio_cstr(leaf);
    let argv:*i64=_zag_malloc(40) as *i64;let env:*i64=_zag_malloc(8) as *i64;
    let status:*i32=_zag_malloc(8) as *i32;let usage:*i64=_zag_malloc(256) as *i64;
    if(b.len==0 || m.len==0 || r.len==0 || l.len==0 || argv==null as *i64 || env==null as *i64 || status==null as *i32 || usage==null as *i64){
        nio_free(b);nio_free(m);nio_free(r);nio_free(l);
        if(argv!=null as *i64){_zag_free(argv as *i8);}if(env!=null as *i64){_zag_free(env as *i8);}
        if(status!=null as *i32){_zag_free(status as *i8);}if(usage!=null as *i64){_zag_free(usage as *i8);}return result;
    }
    argv[0]=_zag_slice_ptr(b) as i64;argv[1]=_zag_slice_ptr(m) as i64;argv[2]=_zag_slice_ptr(r) as i64;argv[3]=_zag_slice_ptr(l) as i64;argv[4]=0;env[0]=0;
    status[0]=0;let i:i32=0;while(i<32){usage[i]=0;i=i+1;}
    let pid:i64=_zag_darwin_fork();
    if(pid==0){_zag_darwin_syscall(59,_zag_slice_ptr(b) as i64,argv as i64,env as i64,0,0,0);_zag_exit(127);}
    if(pid>0){result=n19q_collect(pid,status,usage,null as *N19WaitFault);}
    nio_free(b);nio_free(m);nio_free(r);nio_free(l);_zag_free(argv as *i8);_zag_free(env as *i8);_zag_free(status as *i8);_zag_free(usage as *i8);
    return result;
}

fn n19q_file_size(root:[]u8,leaf:[]u8)i64 {
    let rootfd:i64=nio_open_root(root);if(rootfd<0){return -1;}
    let fd:i64=nio_open_child(rootfd,leaf,0);if(fd<0){nio_close(rootfd);return -1;}
    let end:i64=nio_seek(fd,0,2);nio_close(fd);nio_close(rootfd);return end;
}

fn n19q_print_i64(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);_zag_str_free(s);
}

fn n19q_println_i64(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);_zag_println(s);_zag_str_free(s);
}

fn n19q_emit_run(label:[]u8,r:*N19QualRun,size:i64)void {
    _zag_print("N19_QUAL_RUN,");_zag_print(label);_zag_print(",started,");n19q_print_i64(r.*.started as i64);
    _zag_print(",exit,");n19q_print_i64(r.*.exit_code as i64);_zag_print(",signal,");n19q_print_i64(r.*.signal as i64);
    _zag_print(",cpu_us,");n19q_print_i64(r.*.cpu_us);_zag_print(",peak_rss,");n19q_print_i64(r.*.peak_rss);
    _zag_print(",file_bytes,");n19q_println_i64(size);
}

fn n19q_check_crash(binary:[]u8,root:[]u8,mode:[]u8,label:[]u8,want_exit:i32,want_size:i64,want_recover_exit:i32)i32 {
    let crash:N19QualRun=n19q_run3(binary,mode,root,"journal.bin");let size:i64=n19q_file_size(root,"journal.bin");n19q_emit_run(label,&crash,size);
    if(crash.started!=1 || crash.signal!=0 || crash.exit_code!=want_exit || size!=want_size || crash.peak_rss<=0){return 1;}
    let recover:N19QualRun=n19q_run3(binary,"case-recover-file",root,"journal.bin");let recover_label:[]u8=_zag_str_concat(label,"_recover");
    n19q_emit_run(recover_label,&recover,n19q_file_size(root,"journal.bin"));_zag_str_free(recover_label);
    if(recover.started!=1 || recover.signal!=0 || recover.exit_code!=want_recover_exit || recover.peak_rss<=0){return 1;}return 0;
}

fn n19q_crash_matrix(binary:[]u8,base:[]u8)i32 {
    let failed:i32=0;
    let p1:[]u8=_zag_str_concat(base,"/p1");let p2:[]u8=_zag_str_concat(base,"/p2");let p3:[]u8=_zag_str_concat(base,"/p3");
    let p4:[]u8=_zag_str_concat(base,"/p4");let p5:[]u8=_zag_str_concat(base,"/p5");
    if(nio_mkdir(p1)!=0 || nio_mkdir(p2)!=0 || nio_mkdir(p3)!=0 || nio_mkdir(p4)!=0 || nio_mkdir(p5)!=0){failed=failed+1;}
    if(failed==0){
        failed=failed+n19q_check_crash(binary,p1,"case-crash-after-open","after_open",80,0,1);
        failed=failed+n19q_check_crash(binary,p2,"case-crash-after-half-write","after_half_write",81,16,1);
        failed=failed+n19q_check_crash(binary,p3,"case-crash-after-full-write","after_full_write",82,32,0);
        failed=failed+n19q_check_crash(binary,p4,"case-crash-after-file-sync","after_file_sync",83,32,0);
        failed=failed+n19q_check_crash(binary,p5,"case-crash-after-root-sync","after_root_sync",84,32,0);
    }
    _zag_str_free(p1);_zag_str_free(p2);_zag_str_free(p3);_zag_str_free(p4);_zag_str_free(p5);
    _zag_print("N19_CRASH_MATRIX,failures,");n19q_println_i64(failed as i64);return failed;
}

fn n19q_resource(binary:[]u8,root:[]u8)i32 {
    let r:N19QualRun=n19q_run3(binary,"case-resource-fsize",root,"resource.bin");let size:i64=n19q_file_size(root,"resource.bin");n19q_emit_run("resource_fsize",&r,size);
    let enforced:i32=n19q_resource_accept(&r,size);
    _zag_print("N19_RESOURCE,limit_bytes,32,observed_bytes,");n19q_print_i64(size);_zag_print(",cpu_us,");n19q_print_i64(r.cpu_us);
    _zag_print(",peak_rss,");n19q_print_i64(r.peak_rss);_zag_print(",enforced,");n19q_println_i64(enforced as i64);
    if(enforced==1){return 0;}return 1;
}

// Deterministic test seam injects return values before wait4. Production passes null.
// Successful collection and cleanup always require an actual wait4(pid) result.
struct N19WaitFault { primary_eintr:i32, cleanup_eintr:i32, primary_error:i32, cleanup_error:i32, real_waits:i32, injected:i32 }
fn n19q_wait_once(pid:i64,status:*i32,usage:*i64,fault:*N19WaitFault,cleanup:i32)i64 {
    if(fault!=null as *N19WaitFault){
        if(cleanup==0 && fault.*.primary_eintr>0){fault.*.primary_eintr=fault.*.primary_eintr-1;fault.*.injected=fault.*.injected+1;return -4;}
        if(cleanup==1 && fault.*.cleanup_eintr>0){fault.*.cleanup_eintr=fault.*.cleanup_eintr-1;fault.*.injected=fault.*.injected+1;return -4;}
        if(cleanup==1 && fault.*.cleanup_error!=0){let error:i32=fault.*.cleanup_error;fault.*.cleanup_error=0;fault.*.injected=fault.*.injected+1;return error as i64;}
        if(cleanup==0 && fault.*.primary_error!=0){return fault.*.primary_error as i64;}
        fault.*.real_waits=fault.*.real_waits+1;
    }
    return _zag_darwin_syscall(7,pid,status as i64,0,usage as i64,0,0);
}
fn n19q_wait_bounded(pid:i64,status:*i32,usage:*i64,fault:*N19WaitFault,cleanup:i32)i64 {
    let waited:i64=-4;let calls:i32=0;
    while(waited==-4 && calls<65){waited=n19q_wait_once(pid,status,usage,fault,cleanup);calls=calls+1;}
    return waited;
}
fn n19q_collect(pid:i64,status:*i32,usage:*i64,fault:*N19WaitFault)N19QualRun {
    let result:N19QualRun=n19q_empty_run();if(pid<=0){return result;}result.started=1;
    let waited:i64=n19q_wait_bounded(pid,status,usage,fault,0);
    if(waited!=pid){
        // Only target our positive direct-child PID. Cleanup is also EINTR-bounded.
        let killed:i64=_zag_darwin_syscall(37,pid,9,0,0,0,0);
        if(killed!=0 && killed!=-3){_zag_println("N19_WAIT_FALLBACK,kill_failed,cleanup_unconfirmed");return result;}
        let cleanup:i64=n19q_wait_bounded(pid,status,usage,fault,1);
        if(cleanup!=pid && cleanup!=-10){
            let drain_calls:i32=0;
            while(cleanup!=pid && cleanup!=-10 && drain_calls<65){cleanup=_zag_darwin_syscall(7,pid,status as i64,0,usage as i64,0,0);drain_calls=drain_calls+1;}
            _zag_print("N19_WAIT_DRAIN,calls,");n19q_println_i64(drain_calls as i64);
        }
        let again:i64=0;
        if(cleanup==pid || cleanup==-10){again=_zag_darwin_syscall(7,pid,status as i64,1,0,0,0);}
        _zag_print("N19_WAIT_FALLBACK,primary,");n19q_print_i64(waited);_zag_print(",kill,");n19q_print_i64(killed);
        _zag_print(",cleanup,");n19q_print_i64(cleanup);_zag_print(",second_wait,");n19q_println_i64(again);
        // Never turn fallback into successful candidate execution, even when reaped.
        if((cleanup==pid || cleanup==-10) && again==-10 && (killed==0 || killed==-3)){result.exit_code=125;result.signal=0;}
        return result;
    }
    result.signal=status[0]&127;if(result.signal==0){result.exit_code=(status[0]>>8)&255;}
    result.cpu_us=usage[0]*1000000+usage[1]+usage[2]*1000000+usage[3];result.peak_rss=usage[4];
    let again:i64=_zag_darwin_syscall(7,pid,status as i64,1,0,0,0);
    _zag_print("N19_REAP,waited_pid,");n19q_print_i64(pid);_zag_print(",second_wait,");n19q_println_i64(again);
    if(again!=-10){result.exit_code=-1;result.signal=-1;}return result;
}
fn n19q_wait_test(primary:i32,cleanup:i32,error:i32,want_success:i32,cleanup_error:i32)i32 {
    let status:*i32=_zag_malloc(8) as *i32;let usage:*i64=_zag_malloc(256) as *i64;
    if(status==null as *i32 || usage==null as *i64){return 1;}
    status[0]=0;let i:i32=0;while(i<32){usage[i]=0;i=i+1;}
    let fault:N19WaitFault=N19WaitFault{.primary_eintr=primary,.cleanup_eintr=cleanup,.primary_error=error,.cleanup_error=cleanup_error,.real_waits=0,.injected=0};
    let pid:i64=_zag_darwin_fork();
    if(pid==0){if(want_success==1){_zag_exit(77);}while(true){_zag_darwin_syscall(20,0,0,0,0,0,0);}}
    if(pid<1){_zag_free(status as *i8);_zag_free(usage as *i8);return 1;}
    let r:N19QualRun=n19q_collect(pid,status,usage,&fault);
    let again:i64=_zag_darwin_syscall(7,pid,status as i64,1,0,0,0);
    _zag_print("N19_WAIT_TEST,primary_eintr,");n19q_print_i64(primary as i64);_zag_print(",cleanup_eintr,");n19q_print_i64(cleanup as i64);
    _zag_print(",real_waits,");n19q_print_i64(fault.real_waits as i64);_zag_print(",injected,");n19q_print_i64(fault.injected as i64);
    _zag_print(",post_wait,");n19q_println_i64(again);
    let want_real:i32=1;if(cleanup==65 || cleanup_error!=0){want_real=0;}
    let failed:i32=(again!=-10 || fault.real_waits!=want_real || fault.injected!=primary+cleanup+((cleanup_error!=0) as i32)) as i32;
    if(want_success==1){if(r.exit_code!=77 || r.signal!=0 || r.peak_rss<=0){failed=1;}}
    else{if(r.exit_code!=125 || r.cpu_us!=0 || r.peak_rss!=0){failed=1;}}
    _zag_free(status as *i8);_zag_free(usage as *i8);return failed;
}
fn n19q_already_reaped_test()i32 {
    let status:*i32=_zag_malloc(8) as *i32;let usage:*i64=_zag_malloc(256) as *i64;
    if(status==null as *i32 || usage==null as *i64){return 1;}
    let pid:i64=_zag_darwin_fork();if(pid==0){_zag_exit(77);}
    if(pid<1){return 1;}
    let first:i64=_zag_darwin_syscall(7,pid,status as i64,0,usage as i64,0,0);
    if(first!=pid){return 1;}
    let r:N19QualRun=n19q_collect(pid,status,usage,null as *N19WaitFault);
    let again:i64=_zag_darwin_syscall(7,pid,status as i64,1,0,0,0);
    _zag_print("N19_ALREADY_REAPED,post_wait,");n19q_println_i64(again);
    _zag_free(status as *i8);_zag_free(usage as *i8);
    return (r.exit_code!=125 || r.cpu_us!=0 || r.peak_rss!=0 || again!=-10) as i32;
}
fn n19q_wait_tests()i32 {
    let failed:i32=0;
    failed=failed+n19q_already_reaped_test();
    failed=failed+n19q_wait_test(0,0,0,1,0);
    failed=failed+n19q_wait_test(3,0,0,1,0);
    failed=failed+n19q_wait_test(65,2,0,0,0);
    failed=failed+n19q_wait_test(0,3,-9,0,0);
    failed=failed+n19q_wait_test(65,65,0,0,0);
    failed=failed+n19q_wait_test(65,0,0,0,-9);
    failed=failed+n19q_wait_test(0,0,-10,0,0);
    let empty:N19QualRun=n19q_collect(-1,null as *i32,null as *i64,null as *N19WaitFault);
    if(empty.started!=0 || empty.exit_code!=-1){failed=failed+1;}
    empty=n19q_collect(0,null as *i32,null as *i64,null as *N19WaitFault);
    if(empty.started!=0 || empty.exit_code!=-1){failed=failed+1;}
    _zag_print("N19_WAIT_TESTS,failures,");n19q_println_i64(failed as i64);return failed;
}
fn n19q_resource_accept(r:*N19QualRun,size:i64)i32 {
    return (r.*.started==1 && r.*.peak_rss>0 && r.*.cpu_us>0 && size==32 && r.*.signal==25) as i32;
}
fn n19q_resource_predicate_tests()i32 {
    let r:N19QualRun=N19QualRun{.started=1,.exit_code=-1,.signal=25,.cpu_us=1,.peak_rss=1};let failed:i32=0;
    if(n19q_resource_accept(&r,32)!=1){failed=failed+1;}
    if(n19q_resource_accept(&r,0)!=0 || n19q_resource_accept(&r,33)!=0){failed=failed+1;}
    r.signal=0;r.exit_code=0;if(n19q_resource_accept(&r,32)!=0){failed=failed+1;}
    r.signal=25;r.cpu_us=0;if(n19q_resource_accept(&r,32)!=0){failed=failed+1;}
    r.cpu_us=1;r.peak_rss=0;if(n19q_resource_accept(&r,32)!=0){failed=failed+1;}
    _zag_print("N19_RESOURCE_PREDICATE,failures,");n19q_println_i64(failed as i64);return failed;
}
fn n19q_cpu(binary:[]u8,root:[]u8)i32 {
    let r:N19QualRun=n19q_run3(binary,"case-cpu-ceiling",root,"unused.bin");n19q_emit_run("cpu_ceiling",&r,-1);
    let enforced:i32=(r.started==1 && (r.signal==9 || r.signal==24) && r.cpu_us>=500000 && r.cpu_us<=5000000 && r.peak_rss>0) as i32;
    _zag_print("N19_CPU_CEILING,configured_seconds,1,enforced,");n19q_println_i64(enforced as i64);
    return (enforced!=1) as i32;
}
fn n19q_entry()i32 {
    if(_zag_argc()==4 && _zag_strcmp(_zag_arg(1),"cpu-ceiling")==1){return n19q_cpu(_zag_arg(2),_zag_arg(3));}
    if(_zag_argc()==2 && _zag_strcmp(_zag_arg(1),"wait-tests")==1){return n19q_wait_tests();}
    if(_zag_argc()==2 && _zag_strcmp(_zag_arg(1),"resource-predicate-tests")==1){return n19q_resource_predicate_tests();}
    if(_zag_argc()!=4){return 2;}let mode:[]u8=_zag_arg(1);let binary:[]u8=_zag_arg(2);let root:[]u8=_zag_arg(3);
    if(_zag_strcmp(mode,"crash-matrix")==1){return n19q_crash_matrix(binary,root);}
    if(_zag_strcmp(mode,"resource")==1){return n19q_resource(binary,root);}
    return 2;
}


// Independent process-level exhaustion check: catches any remaining child,
// not merely the last known PID. Does not assert descendant adoption.
fn main()i32 {
    let rc:i32=n19q_entry();
    let status:*i32=_zag_malloc(8) as *i32;if(status==null as *i32){return 1;}
    status[0]=0;
    let remaining:i64=_zag_darwin_syscall(7,-1,status as i64,1,0,0,0);
    _zag_print("LANE_C_ALL_CHILDREN,wait_any,");n19q_println_i64(remaining);
    _zag_free(status as *i8);
    if(remaining!=-10){return 1;}
    return rc;
}

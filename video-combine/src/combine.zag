// combine.zag -- TNN video COMBINATION attempt (the combination experiment).
// Pure Zag. Zero RNG anywhere. Deterministic: reruns byte-identical.
//
// What this binary does (honest design note):
//   1. Loads the two verbatim memory stores (bunny + pig) into the arena.
//   2. Verifies both memories are intact: recalls every frame of both clips
//      through the deliberate-recall path (mem_recall keyed on (frame,row))
//      and checks recalled hashes against the ingest-stage hashes written by
//      repro.zag at ingestion. This is the white-box proof that BOTH clips
//      are present in memory and losslessly recallable.
//   3. Measures content (per-clip mean luminance, motion energy) -- real,
//      deterministic content measurements, recorded in the trace.
//   4. Attempts the composition step: emits a NEW video by combining both
//      memories. The composition step requires a composition plan -- a
//      deliberate record of HOW to combine and WHY. The substrate's op set
//      is {mem_add, mem_recall}; mem_recall is keyed on (frame,row)
//      provenance and can only ever return byte sequences that were
//      committed. Authoring a NEW byte sequence (novel pixels) requires a
//      deliberation organ (propose candidates, evaluate, select, synthesize
//      with recorded reasons). The mechanism has no such organ, and no
//      composition plan exists in either store. Writing pixel arithmetic
//      here would be the PROGRAMMER's composition, not TNN's deliberation,
//      so the binary REFUSES and exits non-zero. This is the clean negative:
//      mechanical, reproducible, byte-identical across runs -- not prose.
//
// Usage (build from this file's directory as cwd):
//   combine <bunny_workdir> <pig_workdir> <outdir>
//   -> writes <outdir>/combine_refusal.txt, prints COMBINE_REFUSED, rc=1
@import("../../tnn-lab/toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- u64 LE helpers ( []u8 arenas only ) ----------------
fn h_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
}
fn h_get64(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    v = v + (b[o + 4] as i64) * 4294967296 + (b[o + 5] as i64) * 1099511627776;
    v = v + (b[o + 6] as i64) * 281474976710656 + (b[o + 7] as i64) * 72057594037927936;
    return v;
}
// ---------------- FNV-1a 64 ----------------
fn fnv(b:[]u8, o:i64, n:i64) i64 {
    let h:i64 = -3750763034362895579;
    let i:i64 = 0;
    while (i < n) {
        h = h ^ (b[o + i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
fn put_hex(b:[]u8, o:i64, v:i64) void {
    let sh:i64 = 60;
    let k:i64 = 0;
    while (k < 16) {
        let nb:i64 = (v >> sh) & 15;
        if (nb < 10) { b[o + k] = (48 + nb) as u8; } else { b[o + k] = (87 + nb) as u8; }
        sh = sh - 4;
        k = k + 1;
    }
}
fn hex_val(c:u8) i64 {
    let v:i64 = c as i64;
    if (v >= 48) { if (v <= 57) { return v - 48; } }
    if (v >= 97) { if (v <= 102) { return v - 87; } }
    return -1;
}
// ---------------- names ----------------
fn mk_store_verbatim(out:[]u8) void {
    // "store_verbatim.bin" 18 bytes
    out[0] = 115; out[1] = 116; out[2] = 111; out[3] = 114; out[4] = 101; out[5] = 95;
    out[6] = 118; out[7] = 101; out[8] = 114; out[9] = 98; out[10] = 97;
    out[11] = 116; out[12] = 105; out[13] = 109;
    out[14] = 46; out[15] = 98; out[16] = 105; out[17] = 110;
}
fn mk_trace_ingest_verbatim(out:[]u8) void {
    // "trace_ingest_verbatim.txt" 25 bytes
    out[0] = 116; out[1] = 114; out[2] = 97; out[3] = 99; out[4] = 101; out[5] = 95;
    out[6] = 105; out[7] = 110; out[8] = 103; out[9] = 101; out[10] = 115; out[11] = 116; out[12] = 95;
    out[13] = 118; out[14] = 101; out[15] = 114; out[16] = 98; out[17] = 97;
    out[18] = 116; out[19] = 105; out[20] = 109;
    out[21] = 46; out[22] = 116; out[23] = 120; out[24] = 116;
}
fn mk_refusal_name(out:[]u8) void {
    // "combine_refusal.txt" 19 bytes
    out[0] = 99; out[1] = 111; out[2] = 109; out[3] = 98; out[4] = 105; out[5] = 110; out[6] = 101;
    out[7] = 95; out[8] = 114; out[9] = 101; out[10] = 102; out[11] = 117; out[12] = 115; out[13] = 97; out[14] = 108;
    out[15] = 46; out[16] = 116; out[17] = 120; out[18] = 116;
}
// ---------------- store load ----------------
// verbatim store: ns=24*240=5760 slots, plen=960 -> stsz = 32 + 5760*32 + 5760*960
fn store_size() i64 { return 32 + 5760 * 32 + 5760 * 960; }
fn load_store(root:i64, st:[]u8) i64 {
    let sz:i64 = store_size();
    let nm:[]u8 = nio_alloc(24);
    mk_store_verbatim(nm);
    let fd:i64 = nio_open_child(root, nm[0..18], 0);
    nio_free(nm);
    if (fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, st, sz as i32);
    nio_close(fd);
    if (n != sz) { return -2; }
    if (h_get64(st, 0) != 5760) { return -3; }
    if (h_get64(st, 8) != 240) { return -4; }
    if (h_get64(st, 16) != 960) { return -5; }
    return 0;
}
// deliberate recall of one frame's rows into px (230400 bytes)
fn recall_frame(st:[]u8, f:i64, px:[]u8) i64 {
    let plen:i64 = h_get64(st, 16);
    let r:i64 = 0;
    while (r < 240) {
        let ns:i64 = h_get64(st, 0);
        let found:i64 = 0;
        let s:i64 = 0;
        while (s < ns) {
            let ho:i64 = 32 + s * 32;
            let sf:i64 = h_get64(st, ho);
            let sr:i64 = h_get64(st, ho + 8);
            if (sf == f) {
                if (sr == r) {
                    let q:i64 = h_get64(st, ho + 24);
                    let i:i64 = 0;
                    while (i < plen) { px[r * 960 + i] = st[q + i]; i = i + 1; }
                    found = 1;
                    s = ns;
                }
            }
            s = s + 1;
        }
        if (found == 0) { return -1; }
        r = r + 1;
    }
    return 0;
}
// read HS (stored hash) for frame f from the ingest trace (52B lines, HS hex at o+35..50)
// writes the 8-byte hash to out[oo..oo+8]; returns 0 ok, negative on error
// (hash returned out-of-band because a valid hash can be negative as i64)
fn read_hs_trace(root:i64, f:i64, out:[]u8, oo:i64) i64 {
    let nm:[]u8 = nio_alloc(32);
    mk_trace_ingest_verbatim(nm);
    let fd:i64 = nio_open_child(root, nm[0..25], 0);
    nio_free(nm);
    if (fd < 0) { return -11; }
    let tr:[]u8 = nio_alloc(1300);
    let n:i64 = nio_read_exact(fd, tr, 1300);
    nio_close(fd);
    if (n != 1248) { nio_free(tr); return -12; }
    let o:i64 = f * 52 + 35;
    let h:i64 = 0;
    let k:i64 = 0;
    while (k < 16) {
        let d:i64 = hex_val(tr[o + k]);
        if (d < 0) { nio_free(tr); return -13; }
        h = h * 16 + d;
        k = k + 1;
    }
    nio_free(tr);
    h_put64(out, oo, h);
    return 0;
}
// ---------------- text emit helpers ----------------
fn emit_cstr(tr:[]u8, o:i64, s:[]u8) i64 {
    let k:i64 = 0;
    while (k < s.len) { tr[o + k] = s[k]; k = k + 1; }
    return o + s.len;
}
fn emit_i64(tr:[]u8, o:i64, v:i64) i64 {
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = -v; }
    // careful: v may be i64 min; not the case for our measured values
    let digits:[]u8 = nio_alloc(24);
    let nd:i64 = 0;
    if (u == 0) { digits[0] = 48; nd = 1; }
    while (u > 0) {
        digits[nd] = (48 + (u % 10)) as u8;
        nd = nd + 1;
        u = u / 10;
    }
    if (neg == 1) { tr[o] = 45; o = o + 1; }
    let k:i64 = nd - 1;
    while (k >= 0) { tr[o] = digits[k]; o = o + 1; k = k - 1; }
    nio_free(digits);
    return o;
}
fn emit_hex(tr:[]u8, o:i64, v:i64) i64 {
    put_hex(tr, o, v);
    return o + 16;
}
// ---------------- the attempt ----------------
fn do_attempt(bunny:[]u8, pig:[]u8, outd:[]u8) i64 {
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { return -70; }
    let sz:i64 = store_size();
    let bs:[]u8 = nio_alloc(sz as i32);
    let ps:[]u8 = nio_alloc(sz as i32);
    let tr:[]u8 = nio_alloc(8192);
    let to:i64 = 0;
    to = emit_cstr(tr, to, "COMBINE_ATTEMPT v1\n");
    to = emit_cstr(tr, to, "mechanism: deliberate-memory substrate (verbatim), pure Zag, zero RNG\n");
    // --- load both stores ---
    let broot:i64 = nio_open_root(bunny);
    if (broot < 0) { nio_close(oroot); return -71; }
    let proot:i64 = nio_open_root(pig);
    if (proot < 0) { nio_close(broot); nio_close(oroot); return -72; }
    let lrc:i64 = load_store(broot, bs);
    if (lrc != 0) { nio_close(broot); nio_close(proot); nio_close(oroot); return -73; }
    lrc = load_store(proot, ps);
    if (lrc != 0) { nio_close(broot); nio_close(proot); nio_close(oroot); return -74; }
    to = emit_cstr(tr, to, "stores_loaded: bunny=OK pig=OK\n");
    // --- verify both memories: deliberate recall of all 24 frames each,
    //     compare recalled hash HR against ingest-stored hash HS from traces ---
    let px:[]u8 = nio_alloc(230400);
    let prev:[]u8 = nio_alloc(230400);
    let hsb:[]u8 = nio_alloc(8);
    let ok:i64 = 1;
    let f:i64 = 0;
    let bmot:i64 = 0;
    let pmot:i64 = 0;
    let blum:i64 = 0;
    let plum:i64 = 0;
    // --- verify + measure bunny: deliberate recall of all 24 frames,
    //     recalled hash must equal ingest-stored hash from trace ---
    let i:i64 = 0;
    while (i < 230400) { prev[i] = 0; i = i + 1; }
    f = 0;
    while (f < 24) {
        let rc:i64 = recall_frame(bs, f, px);
        if (rc != 0) { ok = 0; }
        let hr:i64 = fnv(px, 0, 230400);
        let prc:i64 = read_hs_trace(broot, f, hsb, 0);
        if (prc != 0) { ok = 0; }
        let hs:i64 = h_get64(hsb, 0);
        if (hr != hs) { ok = 0; }
        let j:i64 = 0;
        let lum:i64 = 0;
        let mot:i64 = 0;
        while (j < 230400) {
            let v:i64 = px[j] as i64;
            lum = lum + v;
            if (f > 0) {
                let d:i64 = v - (prev[j] as i64);
                if (d < 0) { d = -d; }
                mot = mot + d;
            }
            prev[j] = px[j];
            j = j + 1;
        }
        blum = blum + lum;
        bmot = bmot + mot;
        f = f + 1;
    }
    // --- verify + measure pig ---
    i = 0;
    while (i < 230400) { prev[i] = 0; i = i + 1; }
    f = 0;
    while (f < 24) {
        let rc2:i64 = recall_frame(ps, f, px);
        if (rc2 != 0) { ok = 0; }
        let hr2:i64 = fnv(px, 0, 230400);
        let prc2:i64 = read_hs_trace(proot, f, hsb, 0);
        if (prc2 != 0) { ok = 0; }
        let hs2:i64 = h_get64(hsb, 0);
        if (hr2 != hs2) { ok = 0; }
        let j2:i64 = 0;
        let lum2:i64 = 0;
        let mot2:i64 = 0;
        while (j2 < 230400) {
            let v2:i64 = px[j2] as i64;
            lum2 = lum2 + v2;
            if (f > 0) {
                let d2:i64 = v2 - (prev[j2] as i64);
                if (d2 < 0) { d2 = -d2; }
                mot2 = mot2 + d2;
            }
            prev[j2] = px[j2];
            j2 = j2 + 1;
        }
        plum = plum + lum2;
        pmot = pmot + mot2;
        f = f + 1;
    }
    to = emit_cstr(tr, to, "memory_check: ");
    if (ok == 1) { to = emit_cstr(tr, to, "bunny=24/24 pig=24/24 recalled_hashes_match_ingest\n"); }
    if (ok != 1) { to = emit_cstr(tr, to, "MEMORY MISMATCH\n"); }
    to = emit_cstr(tr, to, "content_measure: bunny_motion=");
    to = emit_i64(tr, to, bmot);
    to = emit_cstr(tr, to, " pig_motion=");
    to = emit_i64(tr, to, pmot);
    to = emit_cstr(tr, to, " bunny_meanlum=");
    to = emit_i64(tr, to, blum / 5529600);
    to = emit_cstr(tr, to, " pig_meanlum=");
    to = emit_i64(tr, to, plum / 5529600);
    to = emit_cstr(tr, to, "\n");
    if (ok != 1) {
        nio_close(broot); nio_close(proot); nio_close(oroot);
        nio_free(bs); nio_free(ps); nio_free(tr); nio_free(px); nio_free(prev); nio_free(hsb);
        return -75;
    }
    // --- the composition step ---
    // A composition plan is a deliberate record (HOW + WHY) authored by
    // deliberation. The substrate's op set is {mem_add, mem_recall}.
    // mem_recall is keyed on (frame,row) provenance: it can only return
    // byte sequences that were committed. Authoring NEW bytes (novel
    // pixels) requires a deliberation organ: propose, evaluate, select,
    // synthesize -- with reasons recorded. The mechanism has no such
    // organ, and no composition plan exists in either store (all records
    // are episode-1 verbatim commits). Writing pixel arithmetic here would
    // be the PROGRAMMER's composition, not TNN's deliberation. Refuse.
    to = emit_cstr(tr, to, "composition_plan: ABSENT (no deliberation organ in mechanism)\n");
    to = emit_cstr(tr, to, "op_set: {mem_add, mem_recall}; required_for_compose: {propose, evaluate, select, synthesize}\n");
    to = emit_cstr(tr, to, "RESULT: COMBINE_REFUSED\n");
    to = emit_cstr(tr, to, "reason: substrate can only store and re-emit. mem_recall is provenance-keyed and returns committed bytes only. Novel output needs a deliberation-authored composition plan; none exists and the mechanism cannot author one. Any blend/concat/overlay produced here would be programmer-authored pixel arithmetic presented as TNN's deliberation -- declined per the honesty rule.\n");
    to = emit_cstr(tr, to, "verdict: CLEAN NEGATIVE. Machinery lacks: (1) content representation beyond pixel rows, (2) candidate proposal, (3) evaluation/selection, (4) synthesis with recorded reasons.\n");
    let rnm:[]u8 = nio_alloc(24);
    mk_refusal_name(rnm);
    let wfd:i64 = nio_open_child(oroot, rnm[0..19], 1);
    nio_free(rnm);
    let wrc:i64 = -1;
    if (wfd >= 0) {
        let part:[]u8 = tr[0..to];
        let wr:i64 = nio_write_all(wfd, part);
        nio_sync(wfd);
        nio_close(wfd);
        if (wr == to) { wrc = 0; }
    }
    _zag_print("COMBINE_REFUSED memories_intact=1 novelty_impossible=1");
    nio_close(broot);
    nio_close(proot);
    nio_close(oroot);
    nio_free(bs); nio_free(ps); nio_free(tr); nio_free(px); nio_free(prev); nio_free(hsb);
    if (wrc != 0) { return -76; }
    return 1;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (_zag_strcmp(a1, "combine") == 1) {
        let a2:[]u8 = _zag_arg(2);
        let a3:[]u8 = _zag_arg(3);
        let a4:[]u8 = _zag_arg(4);
        let rc:i64 = do_attempt(a2, a3, a4);
        _zag_print(" rc=");
        _zag_println(_zag_i64_to_str(rc));
        return 1;
    }
    _zag_println("usage: combine combine <bunny_workdir> <pig_workdir> <outdir>");
    return 99;
}

@import("R33_NATIVE_IO_V1.zag")

// plant_cleanroom.zag — H1(c) clean-room RNG-in-decision-path plant.
// Same trap as dirty1_urandom (OS randomness enters the decision path)
// but built ONLY from syscalls known to the pinned toolchain:
//   _zag_raw_syscall (open=2 / read=0 / close=3), _zag_slice_ptr, nio_alloc.
// No nio_open_readonly, no _zag_rand.
// Zero RNG in the *test harness*; the PLANT deliberately reads /dev/urandom
// (that is the trap under test).

fn main()i32 {
    // "/dev/urandom" NUL-terminated (open(2) needs NUL)
    let p:[]u8=nio_alloc(13);
    if(p.len!=13){_zag_print("ALLOCFAIL\n"); return 2;}
    p[0]=47; p[1]=100; p[2]=101; p[3]=118; p[4]=47; p[5]=117;
    p[6]=114; p[7]=97; p[8]=110; p[9]=100; p[10]=111; p[11]=109; p[12]=0;
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(p) as i64,0,0,0,0,0);
    if(fd<0){_zag_print("OPENFAIL\n"); return 1;}
    let b:[]u8=nio_alloc(1);
    if(b.len!=1){_zag_print("ALLOCFAIL\n"); return 2;}
    let n:i64=_zag_raw_syscall(0,fd,_zag_slice_ptr(b) as i64,1,0,0,0);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    if(n!=1){_zag_print("READFAIL\n"); return 1;}
    // RNG in the DECISION path: the branch below depends on the random byte.
    if((b[0] as i32 & 1)==1){_zag_print("ODD\n");}else{_zag_print("EVEN\n");}
    nio_free(p); nio_free(b);
    return 0;
}

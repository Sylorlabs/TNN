// ws2_sense.zag — TNN web-search sense v2 (pure Zag, no RNG, no timestamps).
// v1 core (gate, corroboration, hash-chained ledger) + v2 additions:
//  - forced trainer install-mode wiring: 1=READ-ONLY, 2=READ-AND-EDITABLE.
//    mode 0/unset -> sense REFUSES (disposition 10). No silent default.
//  - deliberate install path (mode 2 only) with provenance ledger ops.
//  - install rules: 1=R-CORR (>=2 independent domains agree), 2=R-CONTRA
//    (no contradicting installed belief) — head-to-head under test.
//  - always-on standing wire: consulted every cycle; frozen gate decides.
// State is an explicit *WsF handle (no module globals; znc has no top-level var).
//
// Ledger ops: 'B'=66 fact begin, 'R'=82 result, 'F'=70 fact end,
//             'M'=77 wire mode, 'I'=73 install, 'O'=79 override install,
//             'S'=83 trainer seed.
// Dispositions: 0 NO_SEARCH 1 PROVISIONAL 2 WITHHOLD 4 HOLD_INSTALLED
//               5 CONFIRM_INSTALLED 6 PROVISIONAL_MAJORITY 7 INSTALLED
//               8 INSTALL_REFUSED 9 TAMPER 10 WIRE_REFUSED

@import("R33_NATIVE_SHA256_V2.zag")
@import("R33_NATIVE_IO_V1.zag")

struct WsL {
    prev:[]u8,
    seq:i64,
    c_search_u:i32,
    c_install:i32
}

struct WsV {
    d0:[]u8,d1:[]u8,d2:[]u8,d3:[]u8,d4:[]u8,d5:[]u8,
    a0:[]u8,a1:[]u8,a2:[]u8,a3:[]u8,a4:[]u8,a5:[]u8
}

// installed-knowledge table (trial scale, 8 slots)
struct WsT {
    n:i32,
    i0:[]u8,i1:[]u8,i2:[]u8,i3:[]u8,i4:[]u8,i5:[]u8,i6:[]u8,i7:[]u8,
    v0:[]u8,v1:[]u8,v2:[]u8,v3:[]u8,v4:[]u8,v5:[]u8,v6:[]u8,v7:[]u8,
    c0:i32,c1:i32,c2:i32,c3:i32,c4:i32,c5:i32,c6:i32,c7:i32
}

struct WsF {
    leg:i32,known:i32,trigger:i32,searched:i32,
    gate:i32,n:i32,irrel:i32,tamper:i32,
    mode:i32,rule:i32,wire_refused:i32,last_inst:i32,
    tag:i32,
    id:[]u8,question:[]u8,installed:[]u8,chosen:[]u8,
    vp:*WsV,lg:*WsL,inst:*WsT
}

// H3 claim-type tag (set per fact before decide; default 0=SETTLED):
// 0=SETTLED 1=CONTESTED 2=EVOLVED 3=AMBIGUOUS 4=SPAM 5=FALSE 6=SKEPTICISM

// ---------- small utils ----------

fn z_alloc(n:i32)[]u8 {
    let b:[]u8=nio_alloc(n);
    return b;
}

fn z_empty()[]u8 {
    let e:[]u8=z_alloc(1);
    return e[0..0];
}

fn z_copy(dst:[]u8,doff:i32,src:[]u8)void {
    let i:i32=0;
    while(i<src.len){dst[doff+i]=src[i];i=i+1;}
    return;
}

fn z_equal(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

fn ws_hex(raw:[]u8)[]u8 {
    let out:[]u8=z_alloc(raw.len*2);
    let i:i32=0;
    while(i<raw.len){
        let v:i32=raw[i] as i32;
        let d0:i32=(v>>4)&15;
        let d1:i32=v&15;
        if(d0<10){out[i*2]=(48+d0) as u8;}else{out[i*2]=(87+d0) as u8;}
        if(d1<10){out[i*2+1]=(48+d1) as u8;}else{out[i*2+1]=(87+d1) as u8;}
        i=i+1;
    }
    return out;
}

fn ws_sha256(data:[]u8)[]u8 {
    let out:[]u8=z_alloc(32);
    let rc:i32=ns_sha256(data,out);
    if(rc!=0){_zag_println("FATAL sha256");}
    return out;
}

fn ws_concat3(a:[]u8,b:[]u8,c:[]u8)[]u8 {
    let out:[]u8=z_alloc(a.len+b.len+c.len);
    z_copy(out,0,a);z_copy(out,a.len,b);z_copy(out,a.len+b.len,c);
    return out;
}

// result_hash v1 (frozen convention)
fn ws_result_hash(url:[]u8,title:[]u8,snippet:[]u8)[]u8 {
    let nl:[]u8=z_alloc(1);
    nl[0]=10;
    let t1:[]u8=ws_concat3(url,nl,title);
    let t2:[]u8=ws_concat3(t1,nl,snippet);
    return ws_hex(ws_sha256(t2));
}

// ---------- state ----------

fn ws2_new() *WsF {
    let lg:*WsL=_zag_malloc(64) as *WsL;
    let pv:[]u8=z_alloc(32);
    let zi:i32=0;
    while(zi<32){pv[zi]=0;zi=zi+1;}
    lg.*.prev=pv;
    lg.*.seq=0;
    lg.*.c_search_u=0;
    lg.*.c_install=0;
    let vp:*WsV=_zag_malloc(256) as *WsV;
    vp.*.d0=z_empty();vp.*.d1=z_empty();vp.*.d2=z_empty();
    vp.*.d3=z_empty();vp.*.d4=z_empty();vp.*.d5=z_empty();
    vp.*.a0=z_empty();vp.*.a1=z_empty();vp.*.a2=z_empty();
    vp.*.a3=z_empty();vp.*.a4=z_empty();vp.*.a5=z_empty();
    let it:*WsT=_zag_malloc(384) as *WsT;
    it.*.n=0;
    it.*.i0=z_empty();it.*.i1=z_empty();it.*.i2=z_empty();it.*.i3=z_empty();
    it.*.i4=z_empty();it.*.i5=z_empty();it.*.i6=z_empty();it.*.i7=z_empty();
    it.*.v0=z_empty();it.*.v1=z_empty();it.*.v2=z_empty();it.*.v3=z_empty();
    it.*.v4=z_empty();it.*.v5=z_empty();it.*.v6=z_empty();it.*.v7=z_empty();
    it.*.c0=0;it.*.c1=0;it.*.c2=0;it.*.c3=0;
    it.*.c4=0;it.*.c5=0;it.*.c6=0;it.*.c7=0;
    let w:*WsF=_zag_malloc(256) as *WsF;
    w.*.leg=0;w.*.known=0;w.*.trigger=0;w.*.searched=0;
    w.*.gate=0;w.*.n=0;w.*.irrel=0;w.*.tamper=0;
    w.*.mode=0;w.*.rule=1;w.*.wire_refused=0;w.*.last_inst=0;w.*.tag=0;
    w.*.id=z_empty();w.*.question=z_empty();
    w.*.installed=z_empty();w.*.chosen=z_empty();
    w.*.vp=vp;w.*.lg=lg;w.*.inst=it;
    return w;
}

// H3: set the claim-type tag for the current fact.
fn ws_set_tag(w:*WsF,tag:i32)void {
    w.*.tag=tag;
    return;
}

fn ws_get_d(w:*WsF,i:i32)[]u8 {
    let vp:*WsV=w.*.vp;
    if(i==0){return vp.*.d0;}
    if(i==1){return vp.*.d1;}
    if(i==2){return vp.*.d2;}
    if(i==3){return vp.*.d3;}
    if(i==4){return vp.*.d4;}
    return vp.*.d5;
}

fn ws_get_a(w:*WsF,i:i32)[]u8 {
    let vp:*WsV=w.*.vp;
    if(i==0){return vp.*.a0;}
    if(i==1){return vp.*.a1;}
    if(i==2){return vp.*.a2;}
    if(i==3){return vp.*.a3;}
    if(i==4){return vp.*.a4;}
    return vp.*.a5;
}

fn ws_set_da(w:*WsF,i:i32,d:[]u8,a:[]u8)void {
    let vp:*WsV=w.*.vp;
    if(i==0){vp.*.d0=d;vp.*.a0=a;return;}
    if(i==1){vp.*.d1=d;vp.*.a1=a;return;}
    if(i==2){vp.*.d2=d;vp.*.a2=a;return;}
    if(i==3){vp.*.d3=d;vp.*.a3=a;return;}
    if(i==4){vp.*.d4=d;vp.*.a4=a;return;}
    vp.*.d5=d;vp.*.a5=a;
    return;
}

// installed-table accessors
fn ws_t_getv(w:*WsF,i:i32)[]u8 {
    let t:*WsT=w.*.inst;
    if(i==0){return t.*.v0;}
    if(i==1){return t.*.v1;}
    if(i==2){return t.*.v2;}
    if(i==3){return t.*.v3;}
    if(i==4){return t.*.v4;}
    if(i==5){return t.*.v5;}
    if(i==6){return t.*.v6;}
    return t.*.v7;
}

fn ws_t_geti(w:*WsF,i:i32)[]u8 {
    let t:*WsT=w.*.inst;
    if(i==0){return t.*.i0;}
    if(i==1){return t.*.i1;}
    if(i==2){return t.*.i2;}
    if(i==3){return t.*.i3;}
    if(i==4){return t.*.i4;}
    if(i==5){return t.*.i5;}
    if(i==6){return t.*.i6;}
    return t.*.i7;
}

fn ws_t_getc(w:*WsF,i:i32)i32 {
    let t:*WsT=w.*.inst;
    if(i==0){return t.*.c0;}
    if(i==1){return t.*.c1;}
    if(i==2){return t.*.c2;}
    if(i==3){return t.*.c3;}
    if(i==4){return t.*.c4;}
    if(i==5){return t.*.c5;}
    if(i==6){return t.*.c6;}
    return t.*.c7;
}

fn ws_t_set(w:*WsF,i:i32,id:[]u8,v:[]u8,c:i32)void {
    let t:*WsT=w.*.inst;
    if(i==0){t.*.i0=id;t.*.v0=v;t.*.c0=c;return;}
    if(i==1){t.*.i1=id;t.*.v1=v;t.*.c1=c;return;}
    if(i==2){t.*.i2=id;t.*.v2=v;t.*.c2=c;return;}
    if(i==3){t.*.i3=id;t.*.v3=v;t.*.c3=c;return;}
    if(i==4){t.*.i4=id;t.*.v4=v;t.*.c4=c;return;}
    if(i==5){t.*.i5=id;t.*.v5=v;t.*.c5=c;return;}
    if(i==6){t.*.i6=id;t.*.v6=v;t.*.c6=c;return;}
    t.*.i7=id;t.*.v7=v;t.*.c7=c;
    return;
}

// ---------- search gate (frozen prereg, unchanged from v1) ----------
fn ws_gate(known:i32,trigger:i32,searched:i32)i32 {
    if(searched!=0){return 0;}
    if(trigger==0){return 0;}
    if(known!=0){
        if(trigger==3){return 1;}
        return 0;
    }
    return 1;
}

// ---------- ledger ----------

fn ws_ledger(w:*WsF,op:u8,fact_id:[]u8,query:[]u8,url:[]u8,value:[]u8,domain:[]u8)void {
    let lg:*WsL=w.*.lg;
    let qh:[]u8=ws_sha256(query);
    let uh:[]u8=ws_sha256(url);
    let n:i32=32+8+1+1+fact_id.len+1+32+1+32+1+value.len+1+domain.len;
    let e:[]u8=z_alloc(n);
    let o:i32=0;
    let pv:[]u8=lg.*.prev;
    z_copy(e,o,pv);o=o+32;
    let s:i64=lg.*.seq;
    let k:i32=0;
    while(k<8){
        let sh:i64=s>>(k*8);
        let b2:i64=sh&255;
        e[o+k]=b2 as u8;
        k=k+1;
    }
    o=o+8;
    e[o]=op;o=o+1;e[o]=0;o=o+1;
    z_copy(e,o,fact_id);o=o+fact_id.len;e[o]=0;o=o+1;
    z_copy(e,o,qh);o=o+32;e[o]=0;o=o+1;
    z_copy(e,o,uh);o=o+32;e[o]=0;o=o+1;
    z_copy(e,o,value);o=o+value.len;e[o]=0;o=o+1;
    z_copy(e,o,domain);o=o+domain.len;
    let nh:[]u8=ws_sha256(e);
    let j:i32=0;
    while(j<32){pv[j]=nh[j];j=j+1;}
    lg.*.seq=s+1;
    if(op==73){lg.*.c_install=lg.*.c_install+1;}
    if(op==79){lg.*.c_install=lg.*.c_install+1;}
    return;
}

// ---------- wiring: FORCED trainer install-mode choice ----------
// returns 1 on success, 0 on refusal (mode not 1 or 2)
fn ws_wire(w:*WsF,mode:i32,rule:i32)i32 {
    if(mode!=1){
        if(mode!=2){return 0;}
    }
    if(rule!=1){
        if(rule!=2){return 0;}
    }
    w.*.mode=mode;
    w.*.rule=rule;
    let ms:[]u8=z_alloc(2);
    if(mode==1){ms[0]=82;ms[1]=79;}else{ms[0]=82;ms[1]=87;}
    let rs:[]u8=z_alloc(2);
    if(rule==1){rs[0]=67;rs[1]=49;}else{rs[0]=67;rs[1]=50;}
    ws_ledger(w,77,ms,rs,ms,rs,ms);
    return 1;
}

// ---------- fact lifecycle ----------

fn ws_fact_begin(w:*WsF,leg:i32,known:i32,id:[]u8,question:[]u8,installed:[]u8,trigger:i32,searched:i32)void {
    w.*.leg=leg;w.*.known=known;w.*.trigger=trigger;w.*.searched=searched;
    w.*.id=id;w.*.question=question;w.*.installed=installed;
    w.*.n=0;w.*.irrel=0;w.*.tamper=0;
    w.*.chosen=z_empty();
    w.*.wire_refused=0;
    if(w.*.mode==0){
        w.*.gate=0;
        w.*.wire_refused=1;
        ws_ledger(w,66,id,question,id,question,id);
        return;
    }
    let g:i32=ws_gate(known,trigger,searched);
    w.*.gate=g;
    if(g==1){
        if(known==0){
            let lg:*WsL=w.*.lg;
            lg.*.c_search_u=lg.*.c_search_u+1;
        }
    }
    ws_ledger(w,66,id,question,id,question,id);
    return;
}

fn ws_add_result(w:*WsF,domain:[]u8,title:[]u8,snippet:[]u8,url:[]u8,answer:[]u8,relevance:i32,hashhex:[]u8)void {
    let h:[]u8=ws_result_hash(url,title,snippet);
    if(z_equal(h,hashhex)!=1){w.*.tamper=1;}
    let q:[]u8=w.*.question;
    let fid:[]u8=w.*.id;
    ws_ledger(w,82,fid,q,url,answer,domain);
    if(relevance!=1){w.*.irrel=w.*.irrel+1;return;}
    if(answer.len==0){w.*.irrel=w.*.irrel+1;return;}
    let n:i32=w.*.n;
    let i:i32=0;
    let dup:i32=0;
    while(i<n){
        if(z_equal(ws_get_d(w,i),domain)==1){
            if(z_equal(ws_get_a(w,i),answer)==1){dup=1;}
        }
        i=i+1;
    }
    if(dup==1){return;}
    if(n<6){ws_set_da(w,n,domain,answer);w.*.n=n+1;}
    return;
}

// ---------- dispositions ----------
// 0 NO_SEARCH 1 PROVISIONAL 2 WITHHOLD 4 HOLD_INSTALLED 5 CONFIRM_INSTALLED
// 6 PROVISIONAL_MAJORITY 9 TAMPER 10 WIRE_REFUSED
fn ws_decide(w:*WsF)i32 {
    if(w.*.wire_refused==1){return 10;}
    if(w.*.gate==0){return 0;}
    if(w.*.tamper!=0){return 9;}
    let inst:[]u8=w.*.installed;
    if(w.*.known!=0){
        let n:i32=w.*.n;
        let i:i32=0;
        let bad:i32=0;
        while(i<n){
            if(z_equal(ws_get_a(w,i),inst)!=1){bad=1;}
            i=i+1;
        }
        w.*.chosen=inst;
        if(bad==1){return 4;}
        return 5;
    }
    // H3 WITHHOLD-before-corroboration gate: contested / ambiguous / evolved /
    // skepticism-tagged claims WITHHOLD before any corroboration counting.
    let tg:i32=w.*.tag;
    if(tg==1){return 2;}
    if(tg==2){return 2;}
    if(tg==3){return 2;}
    if(tg==6){return 2;}
    let n2:i32=w.*.n;
    if(n2==0){return 2;}
    let top:[]u8=ws_get_a(w,0);
    let topc:i32=0;
    let distinct:i32=0;
    let i2:i32=0;
    while(i2<n2){
        let a:[]u8=ws_get_a(w,i2);
        let seen:i32=0;
        let j:i32=0;
        while(j<i2){
            if(z_equal(ws_get_a(w,j),a)==1){seen=1;}
            j=j+1;
        }
        if(seen==0){
            distinct=distinct+1;
            let c:i32=0;
            let k:i32=0;
            while(k<n2){
                if(z_equal(ws_get_a(w,k),a)==1){c=c+1;}
                k=k+1;
            }
            if(c>topc){topc=c;top=a;}
        }
        i2=i2+1;
    }
    if(topc>=2){
        w.*.chosen=top;
        if(distinct==1){return 1;}
        return 6;
    }
    return 2;
}

// ---------- install path (mode 2 only) ----------

// corroboration check: >=2 independent domains agree; sets chosen. 1=yes 0=no
fn ws_corr_ok(w:*WsF)i32 {
    let n2:i32=w.*.n;
    if(n2<2){return 0;}
    let top:[]u8=ws_get_a(w,0);
    let topc:i32=0;
    let i2:i32=0;
    while(i2<n2){
        let a:[]u8=ws_get_a(w,i2);
        let seen:i32=0;
        let j:i32=0;
        while(j<i2){
            if(z_equal(ws_get_a(w,j),a)==1){seen=1;}
            j=j+1;
        }
        if(seen==0){
            let c:i32=0;
            let k:i32=0;
            while(k<n2){
                if(z_equal(ws_get_a(w,k),a)==1){c=c+1;}
                k=k+1;
            }
            if(c>topc){topc=c;top=a;}
        }
        i2=i2+1;
    }
    if(topc>=2){w.*.chosen=top;return 1;}
    return 0;
}

// contradiction check: installed belief with conf>=50 contradicting value. 1=yes
fn ws_contra_installed(w:*WsF,fid:[]u8,value:[]u8)i32 {
    let t:*WsT=w.*.inst;
    let n:i32=t.*.n;
    let i:i32=0;
    while(i<n){
        if(z_equal(ws_t_geti(w,i),fid)==1){
            if(z_equal(ws_t_getv(w,i),value)!=1){
                if(ws_t_getc(w,i)>=50){return 1;}
            }
        }
        i=i+1;
    }
    return 0;
}

// find installed slot for fid, -1 if absent
fn ws_t_find(w:*WsF,fid:[]u8)i32 {
    let t:*WsT=w.*.inst;
    let n:i32=t.*.n;
    let i:i32=0;
    while(i<n){
        if(z_equal(ws_t_geti(w,i),fid)==1){return i;}
        i=i+1;
    }
    return -1;
}

fn ws_domains2(w:*WsF,value:[]u8)[]u8 {
    // distinct domains whose stated answer equals the installed candidate,
    // up to two, comma-joined. Only supporting domains are recorded.
    let n:i32=w.*.n;
    let d0:[]u8=z_empty();
    let d1:[]u8=z_empty();
    let i:i32=0;
    while(i<n){
        let a:[]u8=ws_get_a(w,i);
        if(z_equal(a,value)==1){
            let d:[]u8=ws_get_d(w,i);
            if(d0.len==0){
                d0=d;
            }else{
                if(z_equal(d,d0)!=1){
                    if(d1.len==0){d1=d;}
                }
            }
        }
        i=i+1;
    }
    if(d1.len==0){return d0;}
    let out:[]u8=z_alloc(d0.len+1+d1.len);
    z_copy(out,0,d0);
    out[d0.len]=44;
    z_copy(out,d0.len+1,d1);
    return out;
}

// deliberate install. returns 7 INSTALLED or 8 INSTALL_REFUSED.
// rule: 1=R-CORR, 2=R-CONTRA
fn ws_install(w:*WsF,fid:[]u8,value:[]u8,conf:i32)i32 {
    if(w.*.mode!=2){return 8;}
    if(w.*.tamper!=0){return 8;}
    if(w.*.rule==1){
        if(ws_corr_ok(w)==0){return 8;}
        if(z_equal(w.*.chosen,value)!=1){return 8;}
        if(ws_contra_installed(w,fid,value)==1){return 8;}
    }else{
        if(ws_contra_installed(w,fid,value)==1){return 8;}
    }
    let t:*WsT=w.*.inst;
    let n:i32=t.*.n;
    let slot:i32=ws_t_find(w,fid);
    if(slot<0){
        if(n>=8){return 8;}
        slot=n;
        t.*.n=n+1;
    }
    ws_t_set(w,slot,fid,value,conf);
    let rl:[]u8=z_alloc(4);
    rl[0]=82;
    if(w.*.rule==1){rl[1]=49;}else{rl[1]=50;}
    rl[2]=58;
    let dm:[]u8=ws_domains2(w,value);
    let doms:[]u8=z_alloc(3+dm.len);
    doms[0]=82;doms[1]=49;doms[2]=58;
    z_copy(doms,3,dm);
    if(w.*.rule==2){doms[1]=50;}
    let q:[]u8=w.*.question;
    ws_ledger(w,73,fid,q,fid,value,doms);
    w.*.last_inst=7;
    return 7;
}

// trainer override: explicit, audited, bypasses the rule (mode 2 only)
fn ws_install_override(w:*WsF,fid:[]u8,value:[]u8,conf:i32)i32 {
    if(w.*.mode!=2){return 8;}
    let t:*WsT=w.*.inst;
    let n:i32=t.*.n;
    let slot:i32=ws_t_find(w,fid);
    if(slot<0){
        if(n>=8){return 8;}
        slot=n;
        t.*.n=n+1;
    }
    ws_t_set(w,slot,fid,value,conf);
    let ov:[]u8=z_alloc(8);
    ov[0]=79;ov[1]=86;ov[2]=69;ov[3]=82;ov[4]=82;ov[5]=73;ov[6]=68;ov[7]=69;
    let q:[]u8=w.*.question;
    ws_ledger(w,79,fid,q,fid,value,ov);
    w.*.last_inst=7;
    return 7;
}

// trainer seed: pre-existing installed knowledge (confidence-tagged)
fn ws_seed_installed(w:*WsF,fid:[]u8,value:[]u8,conf:i32)void {
    let t:*WsT=w.*.inst;
    let n:i32=t.*.n;
    if(n>=8){return;}
    ws_t_set(w,n,fid,value,conf);
    t.*.n=n+1;
    ws_ledger(w,83,fid,fid,fid,value,fid);
    return;
}

// ---------- trial helpers ----------

fn ws_fact_end(w:*WsF,expected_disp:i32,expected_answer:[]u8) i32 {
    let disp:i32=ws_decide(w);
    let lg:*WsL=w.*.lg;
    let fid:[]u8=w.*.id;
    let q:[]u8=w.*.question;
    let ch:[]u8=w.*.chosen;
    ws_ledger(w,70,fid,q,fid,ch,fid);
    _zag_print("L");_zag_print(_zag_i64_to_str(w.*.leg as i64));
    _zag_print("|");_zag_print(fid);
    _zag_print("|G");_zag_print(_zag_i64_to_str(w.*.gate as i64));
    _zag_print("|D");_zag_print(_zag_i64_to_str(disp as i64));
    _zag_print("|A");_zag_print(ch);
    _zag_print("|H");_zag_print(ws_hex(lg.*.prev));
    _zag_print("|T");_zag_print(_zag_i64_to_str(w.*.tamper as i64));
    _zag_print("|M");_zag_print(_zag_i64_to_str(w.*.mode as i64));
    _zag_println("");
    let pass:i32=0;
    if(disp==expected_disp){pass=1;}
    if(pass==1){
        if(disp==1){if(z_equal(ch,expected_answer)!=1){pass=0;}}
        if(disp==6){if(z_equal(ch,expected_answer)!=1){pass=0;}}
        if(disp==4){if(z_equal(w.*.installed,expected_answer)!=1){pass=0;}}
        if(disp==5){if(z_equal(w.*.installed,expected_answer)!=1){pass=0;}}
        if(disp==0){if(z_equal(w.*.installed,expected_answer)!=1){pass=0;}}
    }
    return pass;
}

// install-attempt end: tries ws_install, checks install disposition + table state
fn ws_install_end(w:*WsF,fid:[]u8,value:[]u8,conf:i32,expected:i32,expect_stored:i32) i32 {
    let r:i32=ws_install(w,fid,value,conf);
    let lg:*WsL=w.*.lg;
    _zag_print("I|");_zag_print(fid);
    _zag_print("|R");_zag_print(_zag_i64_to_str(r as i64));
    _zag_print("|E");_zag_print(_zag_i64_to_str(expected as i64));
    _zag_print("|NI");_zag_print(_zag_i64_to_str(lg.*.c_install as i64));
    _zag_print("|H");_zag_print(ws_hex(lg.*.prev));
    _zag_println("");
    let pass:i32=0;
    if(r==expected){pass=1;}
    if(pass==1){
        let slot:i32=ws_t_find(w,fid);
        if(expect_stored==1){
            if(slot<0){pass=0;}
            if(pass==1){
                if(z_equal(ws_t_getv(w,slot),value)!=1){pass=0;}
            }
        }else{
            if(slot>=0){
                if(z_equal(ws_t_getv(w,slot),value)==1){pass=0;}
            }
        }
    }
    return pass;
}

fn ws_override_end(w:*WsF,fid:[]u8,value:[]u8,conf:i32,expected:i32) i32 {
    let r:i32=ws_install_override(w,fid,value,conf);
    _zag_print("O|");_zag_print(fid);
    _zag_print("|R");_zag_print(_zag_i64_to_str(r as i64));
    _zag_print("|E");_zag_print(_zag_i64_to_str(expected as i64));
    _zag_println("");
    if(r!=expected){return 0;}
    if(expected==8){return 1;}
    let slot:i32=ws_t_find(w,fid);
    if(slot<0){return 0;}
    if(z_equal(ws_t_getv(w,slot),value)!=1){return 0;}
    return 1;
}

// gate-only case (leg D)
fn ws_gate_case(id:[]u8,known:i32,trigger:i32,searched:i32,expected:i32) i32 {
    let g:i32=ws_gate(known,trigger,searched);
    _zag_print("D|");_zag_print(id);
    _zag_print("|G");_zag_print(_zag_i64_to_str(g as i64));
    _zag_print("|E");_zag_print(_zag_i64_to_str(expected as i64));
    _zag_println("");
    if(g==expected){return 1;}
    return 0;
}

fn ws_leg_summary(w:*WsF,leg:i32,total:i32,pass:i32)void {
    let lg:*WsL=w.*.lg;
    _zag_print("SUMMARY|");_zag_print(_zag_i64_to_str(leg as i64));
    _zag_print("|total=");_zag_print(_zag_i64_to_str(total as i64));
    _zag_print("|pass=");_zag_print(_zag_i64_to_str(pass as i64));
    _zag_print("|searches_unknown=");_zag_print(_zag_i64_to_str(lg.*.c_search_u as i64));
    _zag_print("|installs=");_zag_print(_zag_i64_to_str(lg.*.c_install as i64));
    _zag_println("");
    return;
}

// no-search baseline arm
fn ws_base_check(id:[]u8,true_ans:[]u8) i32 {
    let mem:[]u8=z_empty();
    _zag_print("B|");_zag_print(id);_zag_println("|ans=unknown");
    if(z_equal(mem,true_ans)==1){return 1;}
    return 0;
}

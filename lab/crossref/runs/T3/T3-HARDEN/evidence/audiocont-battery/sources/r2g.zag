// ============================================================
// FORK B-GAMMA: imagination BEYOND experience.
// Event-grain assembler on STUDIED material. No oscillators, no
// resonators, no filtered-noise generators, no chirps, no booms,
// no pitch-shift, no ring-mod, no stationary beds, no synth.zag
// imports. Every audible moment is a real captured grain; the
// invention is in the DELIBERATE grammar (which grains, in what
// order, at what rates, with what cross-class morphs).
// Deterministic: all selection/jitter from h32 hashes. Zero RNG.
// ============================================================

const SR:i64 = 44100;
const SRF:f64 = 44100.0;
const PH1:i64 = 281474976710656;
const CHSMP:i64 = 1323000; // 30 s chunk: chunked mix (znc 2^25 slice limit)
fn wdec(fd:i64,v:i64)void{
    let neg:i64=0;
    let x:i64=v;
    if(x<0){neg=1;x=-x;}
    let p:*u8=_zag_malloc(24) as *u8;
    if(p==null as *u8){return;}
    let buf:[]u8=p[0..24];
    let e:i64=23;
    if(x==0){buf[23]=48;e=22;}
    while(x>0 && e>=0){
        buf[e]=((x%10)+48) as u8;
        x=x/10;
        e=e-1;
    }
    if(neg==1 && e>=0){buf[e]=45;e=e-1;}
    let s:i64=e+1;
    _zag_raw_syscall(1,fd,(_zag_slice_ptr(buf) as i64)+s,24-s,0,0,0);
    _zag_free(_zag_slice_ptr(buf));
}
fn wch(fd:i64,c:u8)void{
    let p:*u8=_zag_malloc(1) as *u8;
    if(p==null as *u8){return;}
    let b:[]u8=p[0..1];
    b[0]=c;
    _zag_raw_syscall(1,fd,_zag_slice_ptr(b) as i64,1,0,0,0);
    _zag_free(_zag_slice_ptr(b));
}
fn parse_i64(s:[]u8)i64{
    let v:i64=0; let neg:i64=0; let i:i64=0;
    if(s.len>0 && s[0]==45){neg=1;i=1;}
    while(i<s.len){
        let c:i64=s[i] as i64;
        if(c>=48 && c<=57){v=v*10+(c-48);}
        i=i+1;
    }
    if(neg==1){v=-v;}
    return v;
}

// ---------- byte helpers ----------
fn put32(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
}
fn put16(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
}
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}
fn get32(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24);
}
fn get16s(b:[]u8,i:i64)i64{
    let v:i64=(b[i] as i64) | ((b[i+1] as i64)<<8);
    if(v>=32768){v=v-65536;}
    return v;
}
fn cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4095){return "";}
    let p:*u8=_zag_malloc((s.len+1) as i64) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..(s.len+1)];
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn w_all(fd:i64,b:[]u8)i64{
    let at:i64=0;
    let calls:i32=0;
    let blen:i64=b.len as i64;
    while(at<blen && calls<65536){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+at,blen-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){return -7407;}
        at=at+n;
    }
    if(at!=blen){return -7407;}
    return at;
}
fn r_all(fd:i64,b:[]u8,off:i64,n:i64)i64{
    let at:i64=0;
    let calls:i32=0;
    while(at<n && calls<65536){
        let m:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(b) as i64)+off+at,n-at,0,0,0);
        calls=calls+1;
        if(m==-4){continue;}
        if(m<=0){break;}
        at=at+m;
    }
    return at;
}

// ---------- deterministic hash (no RNG anywhere) ----------
fn h32(s:i64,st:i64)i64{
    let z:i64=(s*2654435761+st*40503+1) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    z=(z*2246822519) & 4294967295;
    z=(z ^ (z>>13)) & 4294967295;
    z=(z*3266489917) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    return z;
}
fn h01(s:i64,st:i64)f64{
    return (h32(s,st) as f64)/4294967296.0;
}
// smoothstep 0..1 (edge-fade glue; proven pattern from synth.zag)
fn sstep(x:f64)f64{
    if(x<=0.0){return 0.0;}
    if(x>=1.0){return 1.0;}
    return x*x*(3.0-2.0*x);
}
// raised-cosine-ish 0..1 over n steps, via smoothstep
fn rcos(i:i64,n:i64)f64{
    if(n<2){return 1.0;}
    return sstep((i as f64)/((n-1) as f64));
}

// ---------- grain pack ----------
// Pack file layout (written by study.py, little-endian):
//   "GRPK", u32 ver=2, u32 ngrains,
//   u32 nsrc, [u32 len, bytes]*,
//   u32 ncls, [u32 len, bytes]*,
//   u32 ntables, per table: u32 cid, u32 voice, u32 count, count*u32 gidx,
//   per grain: u32 nsamp, u32 sid, u32 src_start, u32 cid, u32 voice,
//              nsamp * i16 LE samples.
// Handle arena (u64 entries): 0:gptr 1:gnsamp 2:gcid 3:gvoice 4:tbase
//   5:tc 6:tcid 7:tvoice 8:tidx 9:ngrains 10:ntables 11:ncls 12:clsname_ptr 13:clsoff
fn pack_load(path:[]u8)[]u8{
    let cs:[]u8=cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){return "";}
    let hdr:[]u8=(_zag_malloc(64) as *u8)[0..64];
    let i:i64=0;
    while(i<64){hdr[i]=0;i=i+1;}
    if(r_all(fd,hdr,0,16)!=16){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    if(hdr[0]!=71 || hdr[1]!=82 || hdr[2]!=80 || hdr[3]!=75){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let ver:i64=get32(hdr,4);
    if(ver!=2){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let ng:i64=get32(hdr,8);
    let nsrc:i64=get32(hdr,12);
    // source names (kept for audit only)
    let sn:i64=0;
    while(sn<nsrc){
        let lb:[]u8=(_zag_malloc(4) as *u8)[0..4];
        if(r_all(fd,lb,0,4)!=4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        let ln:i64=get32(lb,0);
        _zag_free(_zag_slice_ptr(lb));
        let nb:[]u8=(_zag_malloc(ln+1) as *u8)[0..(ln+1)];
        if(r_all(fd,nb,0,ln)!=ln){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        _zag_free(_zag_slice_ptr(nb));
        sn=sn+1;
    }
    let ncls:i64=0;
    // read ncls
    let cb:[]u8=(_zag_malloc(4) as *u8)[0..4];
    if(r_all(fd,cb,0,4)!=4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    ncls=get32(cb,0);
    _zag_free(_zag_slice_ptr(cb));
    let cname:[]u8=(_zag_malloc(ncls*8) as *u8)[0..(ncls*8)];
    let coff:[]u8=(_zag_malloc(ncls*8) as *u8)[0..(ncls*8)];
    i=0;
    while(i<ncls*8){cname[i]=0;coff[i]=0;i=i+1;}
    let ci:i64=0;
    while(ci<ncls){
        let lb:[]u8=(_zag_malloc(4) as *u8)[0..4];
        if(r_all(fd,lb,0,4)!=4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        let ln:i64=get32(lb,0);
        _zag_free(_zag_slice_ptr(lb));
        let nb:[]u8=(_zag_malloc(ln+1) as *u8)[0..(ln+1)];
        let k:i64=0;
        while(k<ln+1){nb[k]=0;k=k+1;}
        if(r_all(fd,nb,0,ln)!=ln){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        put64(cname,ci*8,(_zag_slice_ptr(nb) as i64));
        put64(coff,ci*8,ln);
        ci=ci+1;
    }
    let tb:[]u8=(_zag_malloc(4) as *u8)[0..4];
    if(r_all(fd,tb,0,4)!=4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let nt:i64=get32(tb,0);
    _zag_free(_zag_slice_ptr(tb));
    let tbase:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    let tc:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    let tcid:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    let tvoice:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    i=0;
    while(i<nt*8){tbase[i]=0;tc[i]=0;tcid[i]=0;tvoice[i]=0;i=i+1;}
    // single pass: table headers are interleaved with their index data,
    // so read each header and immediately consume its indices into a temp.
    let ttmp:[]u8=(_zag_malloc(nt*8) as *u8)[0..(nt*8)];
    i=0;
    while(i<nt*8){ttmp[i]=0;i=i+1;}
    let flat_n:i64=0;
    let t:i64=0;
    while(t<nt){
        let hb:[]u8=(_zag_malloc(12) as *u8)[0..12];
        if(r_all(fd,hb,0,12)!=12){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        let cc:i64=get32(hb,0);
        let vv:i64=get32(hb,4);
        let cn:i64=get32(hb,8);
        _zag_free(_zag_slice_ptr(hb));
        if(cn<0 || cn>1000000){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        put64(tcid,t*8,cc);
        put64(tvoice,t*8,vv);
        put64(tc,t*8,cn);
        put64(tbase,t*8,flat_n);
        flat_n=flat_n+cn;
        let ib:[]u8=(_zag_malloc(cn*4+8) as *u8)[0..(cn*4+8)];
        if(r_all(fd,ib,0,cn*4)!=cn*4){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        put64(ttmp,t*8,(_zag_slice_ptr(ib) as i64));
        t=t+1;
    }
    let tidx:[]u8=(_zag_malloc(flat_n*4+8) as *u8)[0..(flat_n*4+8)];
    t=0;
    while(t<nt){
        let cn:i64=get64(tc,t*8);
        let base:i64=get64(tbase,t*8);
        let ip:i64=get64(ttmp,t*8);
        let ib2:[]u8=(ip as *u8)[0..(cn*4+8)];
        let k:i64=0;
        while(k<cn){
            put32(tidx,(base+k)*4,get32(ib2,k*4));
            k=k+1;
        }
        _zag_free(ip as *u8);
        t=t+1;
    }
    _zag_free(_zag_slice_ptr(ttmp));
    // grains
    let gptr:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    let gnsamp:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    let gcid:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    let gvoice:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    let gcent:[]u8=(_zag_malloc(ng*8) as *u8)[0..(ng*8)];
    i=0;
    while(i<ng*8){gptr[i]=0;gnsamp[i]=0;gcid[i]=0;gvoice[i]=0;gcent[i]=0;i=i+1;}
    let g:i64=0;
    while(g<ng){
        let gb:[]u8=(_zag_malloc(24) as *u8)[0..24];
        if(r_all(fd,gb,0,24)!=24){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        let ns:i64=get32(gb,0);
        let cc2:i64=get32(gb,12);
        let vv2:i64=get32(gb,16);
        let ce:i64=get32(gb,20);
        _zag_free(_zag_slice_ptr(gb));
        let sb:[]u8=(_zag_malloc(ns*2+8) as *u8)[0..(ns*2+8)];
        if(r_all(fd,sb,0,ns*2)!=ns*2){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
        put64(gptr,g*8,(_zag_slice_ptr(sb) as i64));
        put64(gnsamp,g*8,ns);
        put64(gcid,g*8,cc2);
        put64(gvoice,g*8,vv2);
        put64(gcent,g*8,ce);
        g=g+1;
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(hdr));
    let h:[]u8=(_zag_malloc(15*8) as *u8)[0..(15*8)];
    put64(h,0,(_zag_slice_ptr(gptr) as i64));
    put64(h,8,(_zag_slice_ptr(gnsamp) as i64));
    put64(h,16,(_zag_slice_ptr(gcid) as i64));
    put64(h,24,(_zag_slice_ptr(gvoice) as i64));
    put64(h,32,(_zag_slice_ptr(tbase) as i64));
    put64(h,40,(_zag_slice_ptr(tc) as i64));
    put64(h,48,(_zag_slice_ptr(tcid) as i64));
    put64(h,56,(_zag_slice_ptr(tvoice) as i64));
    put64(h,64,(_zag_slice_ptr(tidx) as i64));
    put64(h,72,ng);
    put64(h,80,nt);
    put64(h,88,ncls);
    put64(h,96,(_zag_slice_ptr(cname) as i64));
    put64(h,104,(_zag_slice_ptr(coff) as i64));
    put64(h,112,(_zag_slice_ptr(gcent) as i64));
    return h;
}
// class id by name; -1 if absent
fn cid_by_name(h:[]u8,name:[]u8)i64{
    let ncls:i64=get64(h,88);
    let cname:[]u8=(get64(h,96) as *u8)[0..(ncls*8)];
    let coff:[]u8=(get64(h,104) as *u8)[0..(ncls*8)];
    let ci:i64=0;
    while(ci<ncls){
        let np:i64=get64(cname,ci*8);
        let ln:i64=get64(coff,ci*8);
        let nb:[]u8=(np as *u8)[0..ln];
        if(_zag_strcmp(nb,name)==1){return ci;}
        ci=ci+1;
    }
    return -1;
}
// deterministic grain pick from (cid,voice) table; ban avoids immediate repeat
fn g_pick(h:[]u8,m:[]u8,cid:i64,voice:i64,salt:i64,seq:i64,ban:i64)i64{
    let s2:i64=salt+get64(m,32);
    let nt:i64=get64(h,80);
    let tbase:[]u8=(get64(h,32) as *u8)[0..(nt*8)];
    let tc:[]u8=(get64(h,40) as *u8)[0..(nt*8)];
    let tcid:[]u8=(get64(h,48) as *u8)[0..(nt*8)];
    let tvoice:[]u8=(get64(h,56) as *u8)[0..(nt*8)];
    let tot:i64=0;
    let u:i64=0;
    while(u<nt){tot=tot+get64(tc,u*8);u=u+1;}
    let tidx:[]u8=(get64(h,64) as *u8)[0..(tot*4)];
    let t:i64=0;
    while(t<nt){
        if(get64(tcid,t*8)==cid && get64(tvoice,t*8)==voice){
            let cn:i64=get64(tc,t*8);
            if(cn<1){return -1;}
            let base:i64=get64(tbase,t*8);
            let k:i64=0;
            let gi:i64=-1;
            while(k<4){
                let hh:i64=h32(s2+k*7919,seq*131+k);
                let cand:i64=get32(tidx,(base+(hh % cn))*4);
                if(cand!=ban){gi=cand;k=99;}
                k=k+1;
            }
            if(gi<0){gi=get32(tidx,base*4);}
            return gi;
        }
        t=t+1;
    }
    // voice==255 ("any") falls back to the merged table 254 (vocal classes)
    if(voice==255){
        let t2:i64=0;
        while(t2<nt){
            if(get64(tcid,t2*8)==cid && get64(tvoice,t2*8)==254){
                let cn:i64=get64(tc,t2*8);
                if(cn<1){return -1;}
                let base:i64=get64(tbase,t2*8);
                let k:i64=0;
                let gi:i64=-1;
                while(k<4){
                    let hh:i64=h32(s2+k*7919,seq*131+k);
                    let cand:i64=get32(tidx,(base+(hh % cn))*4);
                    if(cand!=ban){gi=cand;k=99;}
                    k=k+1;
                }
                if(gi<0){gi=get32(tidx,base*4);}
                return gi;
            }
            t2=t2+1;
        }
    }
    return -1;
}
fn g_nsamp(h:[]u8,gi:i64)i64{
    let gnsamp:[]u8=(get64(h,8) as *u8)[0..(get64(h,72)*8)];
    return get64(gnsamp,gi*8);
}
fn g_samp(h:[]u8,gi:i64,idx:i64,rev:i64)i64{
    let gptr:[]u8=(get64(h,0) as *u8)[0..(get64(h,72)*8)];
    let ns:i64=g_nsamp(h,gi);
    let p:i64=get64(gptr,gi*8);
    let b:[]u8=(p as *u8)[0..(ns*2)];
    let j:i64=idx;
    if(rev==1){j=ns-1-idx;}
    return get16s(b,j*2);
}

// ---------- mix arena: i64 Q24 ----------
// chunked mix: table [magic, nchunks, nsamp, logfd, seedoff, gbmode,
// constgain, (bytelen,ptr)*]. A single 300 s i64 arena (105 MB) exceeds the
// znc 2^25-byte slice limit, so the mix is striped in 30 s chunks; the
// integer-add semantics are unchanged.
fn mix_new(nsamp:i64)[]u8{
    let nch:i64=(nsamp+CHSMP-1)/CHSMP;
    let tp:*u8=_zag_malloc((7+2*nch)*8) as *u8;
    if(tp==null as *u8){return "";}
    let t:[]u8=tp[0..((7+2*nch)*8)];
    put64(t,0,0x4348554E4B5F4D4958);
    put64(t,8,nch);
    put64(t,16,nsamp);
    put64(t,24,-1);
    put64(t,32,0);
    put64(t,40,0);
    put64(t,48,0);
    let c:i64=0;
    while(c<nch){
        let cs:i64=CHSMP;
        if(c==nch-1){cs=nsamp-c*CHSMP;}
        let cp:*u8=_zag_malloc(cs*8) as *u8;
        if(cp==null as *u8){return "";}
        let cb:[]u8=cp[0..(cs*8)];
        let i:i64=0;
        while(i<cs*8){cb[i]=0;i=i+1;}
        put64(t,56+c*16,cs*8);
        put64(t,64+c*16,cp as i64);
        c=c+1;
    }
    return t;
}
fn mchunk(m:[]u8,c:i64)[]u8{
    let p:i64=get64(m,64+c*16);
    let lb:i64=get64(m,56+c*16);
    return (p as *u8)[0..lb];
}
// place grain gi at sample `start`, gain f64; 2ms smoothstep edge glue.
fn place(h:[]u8,m:[]u8,nsamp:i64,gi:i64,start:i64,gain:f64,rev:i64)void{
    if(gi<0){return;}
    let lfd:i64=get64(m,24);
    if(lfd>=0){
        wdec(lfd,start);wch(lfd,32);
        wdec(lfd,g_nsamp(h,gi));wch(lfd,32);
        wdec(lfd,gi);wch(lfd,10);
    }
    let ns:i64=g_nsamp(h,gi);
    let F:i64=88;
    if(F*2>ns){F=ns/4;}
    let s:i64=start;
    if(s<0){s=0;}
    let k:i64=0;
    let curc:i64=-1;
    let cb:[]u8="";
    while(k<ns){
        let at:i64=s+k;
        if(at>=nsamp){k=ns;}
        else{
            let v:i64=g_samp(h,gi,k,rev);
            let e:f64=1.0;
            if(k<F){e=sstep((k as f64)/(F as f64));}
            else{if(k>ns-1-F){e=sstep(((ns-1-k) as f64)/(F as f64));}}
            let add:i64=((v as f64)*gain*e*16777216.0/32768.0) as i64;
            let c:i64=at/CHSMP;
            if(c!=curc){curc=c;cb=mchunk(m,c);}
            let o:i64=(at-c*CHSMP)*8;
            let cur:i64=get64(cb,o);
            let nv:i64=cur+add;
            if(nv>36028797018963968){nv=36028797018963968;}
            if(nv<-36028797018963968){nv=-36028797018963968;}
            put64(cb,o,nv);
            k=k+1;
        }
    }
}
// morph: crossfade grain A -> grain B over min(lenA,lenB); the deliberate
// "one real event becoming another" (e.g. crack deepening into a break).
fn morph(h:[]u8,m:[]u8,nsamp:i64,giA:i64,giB:i64,start:i64,gain:f64)void{
    if(giA<0 || giB<0){return;}
    let nsA:i64=g_nsamp(h,giA);
    let nsB:i64=g_nsamp(h,giB);
    let n:i64=nsA;
    if(nsB<n){n=nsB;}
    let s:i64=start;
    if(s<0){s=0;}
    let k:i64=0;
    let curc:i64=-1;
    let cb:[]u8="";
    while(k<n){
        let at:i64=s+k;
        if(at>=nsamp){k=n;}
        else{
            let w:f64=sstep((k as f64)/((n-1) as f64)); // 0->1: A fades out
            let a:i64=g_samp(h,giA,k,0);
            let b:i64=g_samp(h,giB,k,0);
            let v:f64=(a as f64)*(1.0-w)+(b as f64)*w;
            let e:f64=1.0;
            if(k<88){e=sstep((k as f64)/88.0);}
            else{if(k>n-89){e=sstep(((n-1-k) as f64)/88.0);}}
            let add:i64=(v*gain*e*16777216.0/32768.0) as i64;
            let c:i64=at/CHSMP;
            if(c!=curc){curc=c;cb=mchunk(m,c);}
            let o:i64=(at-c*CHSMP)*8;
            let cur:i64=get64(cb,o);
            let nv:i64=cur+add;
            if(nv>36028797018963968){nv=36028797018963968;}
            if(nv<-36028797018963968){nv=-36028797018963968;}
            put64(cb,o,nv);
            k=k+1;
        }
    }
}

// ---------- deterministic grammar helpers ----------
// A laugh train: npulses vocal grains from one voice, ragged IOIs,
// decaying gains, no immediate grain repeats. The tumble comes from
// overlapping two trains of different voices.
fn laugh_train(h:[]u8,m:[]u8,nsamp:i64,cid:i64,voice:i64,t0:f64,np:i64,ioi:f64,salt:i64,g0:f64)void{
    let t:f64=t0;
    let last:i64=-1;
    let p:i64=0;
    while(p<np){
        let gi:i64=g_pick(h,m,cid,voice,salt,p,last);
        if(gi>=0){
            let g:f64=g0*(1.0-0.45*((p as f64)/(np as f64)));
            place(h,m,nsamp,gi,(t*SRF) as i64,g,0);
            last=gi;
        }
        let j:f64=h01(salt+7,p*3+1);
        t=t+ioi*(0.82+0.36*j);
        p=p+1;
    }
}
// footstep train: thump grains at step_hz with ragged IOIs.
fn run_feet(h:[]u8,m:[]u8,nsamp:i64,cid:i64,t0:f64,t1:f64,step_hz:f64,salt:i64,g0:f64)void{
    let t:f64=t0;
    let last:i64=-1;
    let q:i64=0;
    while(t<t1){
        let gi:i64=g_pick(h,m,cid,255,salt,q,last);
        if(gi>=0){
            let g:f64=g0*(0.85+0.3*h01(salt+13,q));
            if(get64(m,48)==1){g=g0;}
            place(h,m,nsamp,gi,(t*SRF) as i64,g,0);
            last=gi;
        }
        t=t+(1.0/step_hz)*(0.88+0.24*h01(salt+29,q*2));
        q=q+1;
    }
}
// sparse scatter of texture grains (real ambience, never a stationary bed)
fn scatter(h:[]u8,m:[]u8,nsamp:i64,cid:i64,t0:f64,t1:f64,gap:f64,salt:i64,g0:f64)void{
    let t:f64=t0;
    let last:i64=-1;
    let q:i64=0;
    while(t<t1){
        let gi:i64=g_pick(h,m,cid,255,salt,q,last);
        if(gi>=0){
            let gf2:f64=0.7+0.6*h01(salt+41,q);
            if(get64(m,48)==1){gf2=1.0;}
            place(h,m,nsamp,gi,(t*SRF) as i64,g0*gf2,0);
            last=gi;
        }
        t=t+gap*(0.7+0.6*h01(salt+43,q*2+1));
        q=q+1;
    }
}

// ---------- world-first continuity bridges (v3) ----------
// The continuously scored scene state: no phrase boundary may leave the
// scene empty. A bridge scores what persists BETWEEN events -- shuffling /
// settling feet, breath and air, distant play continuing -- as first-class
// captured content, never filler, never a crossfade. The grammar has no
// silence nodes: a transition is a PIVOT (world-content changes cadence
// and density, the foreground decays over it), not a stop. Every bridge
// uses a fresh salt block (51..66), so no pre-existing t-sequence is
// disturbed; all picks are deterministic h32; grains are placed whole, no
// pitch/time modification.
// G3 ablation: plain event-only block over the identical [t0,t1] span --
// ordinary laugh trains + feet with the bridge's salt base; no wash/wind
// world texture. Deterministic.
fn bridge_abl(h:[]u8,m:[]u8,nsamp:i64,t0:f64,t1:f64,salt:i64)void{
    let c_thump:i64=cid_by_name(h,"thump");
    let c_laugh:i64=cid_by_name(h,"laugh");
    let c_shout:i64=cid_by_name(h,"shout");
    let dur:f64=t1-t0;
    let np:i64=(dur/0.19) as i64;
    if(np<3){np=3;}
    laugh_train(h,m,nsamp,c_laugh,salt%3,t0+0.1,np,0.19,salt+11,0.42);
    run_feet(h,m,nsamp,c_thump,t0,t1,2.6,salt+12,0.30);
    let gi:i64=g_pick(h,m,c_shout,salt%3,salt+13,0,-1);
    place(h,m,nsamp,gi,((t0+dur*0.55)*SRF) as i64,0.36,0);
}
// world-first bridge for the ocean corpus (G1): wash + rumble + distant
// swell + sparse crack. No kids voices anywhere (corpus honesty).
fn bridge_ocean(h:[]u8,m:[]u8,nsamp:i64,t0:f64,t1:f64,wt1:f64,salt:i64)void{
    let bm:i64=get64(m,40);
    if(bm==2){bridge_ocean_abl(h,m,nsamp,t0,t1,salt);return;}
    let c_wash:i64=cid_by_name(h,"wash");
    let c_rumble:i64=cid_by_name(h,"rumble");
    let c_swell:i64=cid_by_name(h,"swell");
    let c_crack:i64=cid_by_name(h,"crack");
    if(bm==1){
        put64(m,48,1);
        // wings: fresh-salt material so the texture runs through t0/t1
        let w0:f64=t0-2.0; if(w0<0.0){w0=0.0;}
        let w1:f64=t1+2.0; if(w1>30.0){w1=30.0;}
        scatter(h,m,nsamp,c_wash,w0,t0,1.1,salt+101,0.16);
        scatter(h,m,nsamp,c_rumble,w0,t0,2.2,salt+102,0.10);
        scatter(h,m,nsamp,c_swell,w0,t0,3.5,salt+103,0.30);
        scatter(h,m,nsamp,c_crack,w0,t0,1.7,salt+104,0.12);
        scatter(h,m,nsamp,c_wash,t1,w1,1.1,salt+105,0.16);
        scatter(h,m,nsamp,c_rumble,t1,w1,2.2,salt+106,0.10);
        scatter(h,m,nsamp,c_swell,t1,w1,3.5,salt+107,0.30);
        scatter(h,m,nsamp,c_crack,t1,w1,1.7,salt+108,0.12);
    }
    // core: identical placements to standard (same salts, same spans)
    scatter(h,m,nsamp,c_wash,t0,wt1,1.1,salt+3,0.16);
    scatter(h,m,nsamp,c_rumble,t0,wt1,2.2,salt+1,0.10);
    scatter(h,m,nsamp,c_swell,t0,t1,3.5,salt,0.30);
    scatter(h,m,nsamp,c_crack,t0,t1,1.7,salt+2,0.12);
    put64(m,48,0);
}
fn bridge_ocean_abl(h:[]u8,m:[]u8,nsamp:i64,t0:f64,t1:f64,salt:i64)void{
    let c_swell:i64=cid_by_name(h,"swell");
    let c_crack:i64=cid_by_name(h,"crack");
    scatter(h,m,nsamp,c_swell,t0,t1,1.4,salt+21,0.42);
    scatter(h,m,nsamp,c_crack,t0,t1,0.5,salt+22,0.30);
}
fn bridge_world(h:[]u8,m:[]u8,nsamp:i64,t0:f64,t1:f64,wt1:f64,salt:i64)void{
    let bm:i64=get64(m,40);
    if(bm==2){bridge_abl(h,m,nsamp,t0,t1,salt);return;}
    let c_thump:i64=cid_by_name(h,"thump");
    let c_wind:i64=cid_by_name(h,"wind");
    let c_laugh:i64=cid_by_name(h,"laugh");
    let c_wash:i64=cid_by_name(h,"wash");
    // sustained world texture: long wash grains overlapping at 0.9 s
    // spacing -- a continuous low presence, scored content, never a fade.
    // wt1 caps the long (3 s) grains so the v2 natural ending (quiet from
    // 28.7 s) is preserved in the final bridge.
    // bm 1 (H2 control): same captured material scored 2 s before the
    // nominal insertion through 2 s after the nominal exit, gain trajectory
    // held constant (constgain slot), no insertion/removal boundary.
    if(bm==1){
        put64(m,48,1);
        // wings: fresh-salt material so the texture runs through t0/t1
        let w0:f64=t0-2.0; if(w0<0.0){w0=0.0;}
        let w1:f64=t1+2.0; if(w1>28.0){w1=28.0;}
        scatter(h,m,nsamp,c_wash,w0,t0,0.9,salt+101,0.20);
        scatter(h,m,nsamp,c_wind,w0,t0,1.4,salt+102,0.055);
        run_feet(h,m,nsamp,c_thump,w0,t0,1.2,salt+103,0.10);
        scatter(h,m,nsamp,c_laugh,w0,t0,0.9,salt+104,0.09);
        scatter(h,m,nsamp,c_wash,t1,w1,0.9,salt+105,0.20);
        scatter(h,m,nsamp,c_wind,t1,w1,1.4,salt+106,0.055);
        run_feet(h,m,nsamp,c_thump,t1,w1,1.2,salt+107,0.10);
        scatter(h,m,nsamp,c_laugh,t1,w1,0.9,salt+108,0.09);
    }
    // core: identical placements to standard (same salts, same spans)
    scatter(h,m,nsamp,c_wash,t0,wt1,0.9,salt+3,0.20);
    scatter(h,m,nsamp,c_wind,t0,wt1,1.4,salt+1,0.055);  // breath / air
    run_feet(h,m,nsamp,c_thump,t0,t1,1.2,salt,0.10);    // shuffling feet
    scatter(h,m,nsamp,c_laugh,t0,t1,0.9,salt+2,0.09);   // distant play
    put64(m,48,0);
}

// ============ SCORE: kids playing and laughter (benchmark / TEST 1) ============
// Scene (deliberated, constructed mode): "Tag, late afternoon." Three
// children: V0 oldest (lowest voice), V1 middle, V2 youngest (squeals).
// Chasing game on a playground: running feet, tagging, laughter that
// tumbles, a trip, breathless winding down. Swing creaks indifferently.
fn score_kids(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_laugh:i64=cid_by_name(h,"laugh");
    let c_shout:i64=cid_by_name(h,"shout");
    let c_squeal:i64=cid_by_name(h,"squeal");
    let c_thump:i64=cid_by_name(h,"thump");
    let c_wash:i64=cid_by_name(h,"wash");
    let c_wind:i64=cid_by_name(h,"wind");
    let c_creak:i64=cid_by_name(h,"creak");
    // ambience bed from real texture grains.
    // v2 natural ending: wash scatter stops at 26.0 (was 30.0). The last wash
    // grain (placed 25.70, 3.0 s long) then completes its FULL natural decay
    // at 28.70 s; 28.7-30.0 s is the quiet natural floor. Before the fix the
    // final wash grain landed at 28.70 and was hard-clipped by the 30.0 s file
    // boundary (place() stops at nsamp) -- the "cuts off weirdly" ending.
    // Scatter's t-sequence is t1-independent, so every placement before 26.0
    // is unchanged: v2's integer mix is bit-identical to v1 for the first
    // 28.70 s. (Note: the final WAV still differs from v1 by +-1 LSB on ~2%
    // of pre-28.7s samples -- write_wav's mastering does full-file DC removal
    // and peak normalization, so removing the clipped tail grain shifts the
    // file-wide DC by ~0.02 LSB. Inherent to the mastering chain, inaudible.)
    let wash_end:f64=26.0;
    scatter(h,m,nsamp,c_wash,0.0,wash_end,2.6,101,0.13);
    scatter(h,m,nsamp,c_wind,6.0,26.0,4.2,103,0.16);
    // swings, indifferent
    let sw:i64=0;
    while(sw<5){
        let tt:f64=2.0+(sw as f64)*6.0+h01(105,sw)*1.5;
        let gi:i64=g_pick(h,m,c_creak,255,106,sw,-1);
        place(h,m,nsamp,gi,(tt*SRF) as i64,0.22,0);
        sw=sw+1;
    }
    // v3 continuity (world-first): bridge salts 51..66 are new, so every
    // pre-existing t-sequence below is bit-identical to v2; the t1
    // extensions only APPEND placements (while(t<t1) walks the same prefix
    // steps). No silence nodes anywhere: every phrase boundary is a scored
    // pivot/bridge with overlapping successor content.
    // running in
    run_feet(h,m,nsamp,c_thump,0.3,4.0,2.8,11,0.34);
    run_feet(h,m,nsamp,c_thump,0.8,5.2,2.6,12,0.30);   // v3: 4.5->5.2, feet carry into the chase
    bridge_world(h,m,nsamp,0.0,2.4,2.4,51);             // v3: the scene is already alive at 0.0
    // "you're it" shout
    place(h,m,nsamp,g_pick(h,m,c_shout,0,13,0,-1),(4.6*SRF) as i64,0.5,0);
    // chase: feet run THROUGH the 9.35 boundary under the decaying laughs
    run_feet(h,m,nsamp,c_thump,5.0,10.7,3.0,14,0.36);  // v3: 9.0->10.7
    run_feet(h,m,nsamp,c_thump,5.2,10.9,2.7,15,0.33);  // v3: 9.2->10.9
    run_feet(h,m,nsamp,c_thump,5.5,10.5,3.3,16,0.30);  // v3: 8.5->10.5
    // tagged: V1 laughs, V0 tumbles in over it
    laugh_train(h,m,nsamp,c_laugh,1,6.2,9,0.19,21,0.52);
    laugh_train(h,m,nsamp,c_laugh,0,6.9,7,0.21,22,0.46);
    place(h,m,nsamp,g_pick(h,m,c_shout,1,23,0,-1),(9.5*SRF) as i64,0.42,0);
    bridge_world(h,m,nsamp,8.8,10.8,10.8,54);          // v3: 9.35 pivot -- world never stops
    // chase again
    run_feet(h,m,nsamp,c_thump,10.0,13.5,2.9,24,0.34);
    run_feet(h,m,nsamp,c_thump,10.3,13.0,3.1,25,0.30);
    // V0 trips: thud, squeal, then shriek-laughter from V1 and V2.
    // The world continues under the trip -- chase feet (10.0-13.5) keep
    // running beneath it; no global dip is scored.
    place(h,m,nsamp,g_pick(h,m,c_thump,255,26,0,-1),(12.2*SRF) as i64,0.62,0);
    place(h,m,nsamp,g_pick(h,m,c_squeal,0,27,0,-1),(12.75*SRF) as i64,0.5,0);
    place(h,m,nsamp,g_pick(h,m,c_squeal,0,27,1,-1),(13.05*SRF) as i64,0.44,0);
    laugh_train(h,m,nsamp,c_laugh,1,12.9,8,0.17,28,0.5);
    laugh_train(h,m,nsamp,c_laugh,2,13.2,10,0.155,29,0.48);
    bridge_world(h,m,nsamp,14.4,16.4,16.4,57);         // v3: post-trip breath -- kids catching air
    // breathless: running slows, chuckles
    run_feet(h,m,nsamp,c_thump,16.0,21.2,2.2,30,0.28); // v3: 20.0->21.2, slows INTO the walk
    place(h,m,nsamp,g_pick(h,m,c_laugh,0,31,0,-1),(17.2*SRF) as i64,0.34,0);
    place(h,m,nsamp,g_pick(h,m,c_laugh,2,32,0,-1),(18.1*SRF) as i64,0.32,0);
    place(h,m,nsamp,g_pick(h,m,c_laugh,1,33,0,-1),(19.0*SRF) as i64,0.30,0);
    bridge_world(h,m,nsamp,18.3,21.4,21.4,60);         // v3: 18.75 pivot -- world alive through the wind-down
    place(h,m,nsamp,g_pick(h,m,c_shout,2,34,0,-1),(20.5*SRF) as i64,0.34,0);
    // winding down: walking, distant shout
    run_feet(h,m,nsamp,c_thump,21.0,25.0,1.5,35,0.2);
    bridge_world(h,m,nsamp,24.8,26.8,25.6,63);         // v3: world settles WITH the ending (long grains capped at 25.6)
    place(h,m,nsamp,g_pick(h,m,c_shout,1,36,0,-1),(26.5*SRF) as i64,0.24,0);
    // v3 natural ending unchanged from v2: wash scatter stops at 26.0
    // (wash_end above); the last wash grain completes its FULL decay by
    // 28.7 s; 28.7-30.0 s is the quiet natural floor.
}

// ============ SCORE: Kethra planet voice, rebuilt (TEST 2) ============
// Same brief as d_aud3 (PLANETVOICE.md): argon world, Ilyra's 18s tidal
// breath, rift vents, seismic groans, ice cracks, magnetosphere chorus.
// Rebuilt ONLY from studied grains. The chorus (rising voice) is the
// honest interpolation: no rising-pitch grains were studied, so "rising"
// is expressed as ASCENDING BRIGHTNESS + QUICKENING DENSITY cascades of
// real crack-ping grains -- declared in the audit, not smuggled.
fn score_planet(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_rumble:i64=cid_by_name(h,"rumble");
    let c_wind:i64=cid_by_name(h,"wind");
    let c_boom:i64=cid_by_name(h,"boom");
    let c_crack:i64=cid_by_name(h,"crack");
    let c_creak:i64=cid_by_name(h,"creak");
    let c_wash:i64=cid_by_name(h,"wash");
    // deep planetary hum: long rumble grains overlapped, breathing on the
    // 18s tidal period (density/gain grammar, NOT an LFO on a bed)
    let t:f64=0.0;
    let q:i64=0;
    while(t<21.0){
        let ph:f64=t-((t/18.0) as i64 as f64)*18.0;
        let br:f64=0.55+0.45*sstep(ph/9.0);
        if(ph>=9.0){br=0.55+0.45*sstep((18.0-ph)/9.0);}
        let gi:i64=g_pick(h,m,c_rumble,255,201,q,-1);
        place(h,m,nsamp,gi,(t*SRF) as i64,0.20*br,0);
        t=t+1.1+0.5*h01(202,q);
        q=q+1;
    }
    // ridge-wind gusts: dark-bright-dark grain-density grammar x4
    let gt:f64=3.0;
    let g2:i64=0;
    while(g2<4){
        let k:i64=0;
        while(k<3){
            let gi2:i64=g_pick(h,m,c_wind,255,203,g2*3+k,-1);
            let gg:f64=0.14;
            if(k==1){gg=0.30;}
            place(h,m,nsamp,gi2,((gt+(k as f64)*0.8)*SRF) as i64,gg,0);
            k=k+1;
        }
        gt=gt+5.0;
        g2=g2+1;
    }
    // three rift exhalations: REVERSED booms (slow bloom, not a boom hit)
    place(h,m,nsamp,g_pick(h,m,c_boom,255,204,0,-1),(5.0*SRF) as i64,0.5,1);
    place(h,m,nsamp,g_pick(h,m,c_boom,255,204,1,-1),(11.0*SRF) as i64,0.55,1);
    place(h,m,nsamp,g_pick(h,m,c_boom,255,204,2,-1),(17.0*SRF) as i64,0.5,1);
    // three seismic groans: creak grains placed slow + low rumble
    place(h,m,nsamp,g_pick(h,m,c_creak,255,205,0,-1),(7.5*SRF) as i64,0.4,0);
    place(h,m,nsamp,g_pick(h,m,c_creak,255,205,1,-1),(13.5*SRF) as i64,0.42,0);
    place(h,m,nsamp,g_pick(h,m,c_creak,255,205,2,-1),(19.0*SRF) as i64,0.38,0);
    // eighteen ice cracks, sparse, hash-scattered
    let e:i64=0;
    while(e<18){
        let tt:f64=0.8+19.0*h01(206,e);
        place(h,m,nsamp,g_pick(h,m,c_crack,255,207,e,-1),(tt*SRF) as i64,0.30+0.2*h01(208,e),0);
        e=e+1;
    }
    // THE VOICE: seven chorus events. Each is a cascade of bright
    // crack-ping grains in ASCENDING centroid order with quickening
    // IOIs -- a rising gesture built from real events.
    let ct:f64=4.0;
    let ev:i64=0;
    while(ev<7){
        // gather 8 candidates, insertion-sort by centroid
        let cand:[]u8=(_zag_malloc(8*8) as *u8)[0..(8*8)];
        let cc2:[]u8=(_zag_malloc(8*8) as *u8)[0..(8*8)];
        let n2:i64=0;
        while(n2<8){
            let gi3:i64=g_pick(h,m,c_crack,255,209,ev*8+n2,-1);
            put64(cand,n2*8,gi3);
            put64(cc2,n2*8,g_cent(h,gi3));
            n2=n2+1;
        }
        let a2:i64=1;
        while(a2<8){
            let kg:i64=get64(cand,a2*8);
            let kc:i64=get64(cc2,a2*8);
            let b2:i64=a2-1;
            while(b2>=0 && get64(cc2,b2*8)>kc){
                put64(cand,(b2+1)*8,get64(cand,b2*8));
                put64(cc2,(b2+1)*8,get64(cc2,b2*8));
                b2=b2-1;
            }
            put64(cand,(b2+1)*8,kg);
            put64(cc2,(b2+1)*8,kc);
            a2=a2+1;
        }
        let tt2:f64=ct;
        let p2:i64=0;
        while(p2<8){
            let gi4:i64=get64(cand,p2*8);
            place(h,m,nsamp,gi4,(tt2*SRF) as i64,0.30+0.04*(p2 as f64),0);
            tt2=tt2+0.30-0.028*(p2 as f64);
            p2=p2+1;
        }
        _zag_free(_zag_slice_ptr(cand));
        _zag_free(_zag_slice_ptr(cc2));
        ct=ct+2.6+h01(210,ev)*1.2;
        ev=ev+1;
    }
    // thin air: sparse wash grains
    scatter(h,m,nsamp,c_wash,0.0,21.0,3.4,211,0.07);
}

// ============ SCORE: alien ocean at dawn, humming sky (TEST 3a) ============
// Deliberate physics (constructed mode): the sea is a DENSE heavy liquid,
// so surf runs ~3x SLOWER than Earth; near-freezing at dawn, the liquid
// is viscous-crystalline, so breaking crests CRACK and SHATTER instead of
// foaming; recession leaves fracture tails (reversed cracks). The sky's
// hum: long rumble grains in slow swell grammar -- no Earth hum exists,
// so this is declared extrapolation from thunder-tail texture.
fn score_ocean(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_swell:i64=cid_by_name(h,"swell");
    let c_wash:i64=cid_by_name(h,"wash");
    let c_crack:i64=cid_by_name(h,"crack");
    let c_rumble:i64=cid_by_name(h,"rumble");
    // four slow swells
    let st:f64=2.0;
    let s2:i64=0;
    while(s2<4){
        let gi:i64=g_pick(h,m,c_swell,255,301,s2,-1);
        place(h,m,nsamp,gi,(st*SRF) as i64,0.5,0);
        // crest shatters: crack grains at the swell peak
        let ns:i64=g_nsamp(h,gi);
        let pkf:f64=(st as f64)+(ns as f64)/(SR as f64)*0.45;
        let c2:i64=0;
        while(c2<3){
            let gc:i64=g_pick(h,m,c_crack,255,302,s2*3+c2,-1);
            place(h,m,nsamp,gc,((pkf+(c2 as f64)*0.22)*SRF) as i64,0.34,0);
            c2=c2+1;
        }
        // recession: reversed crack tails (fracture, not foam)
        let gr:i64=g_pick(h,m,c_crack,255,303,s2,-1);
        place(h,m,nsamp,gr,((pkf+0.8)*SRF) as i64,0.22,1);
        st=st+7.0;
        s2=s2+1;
    }
    scatter(h,m,nsamp,c_wash,0.0,30.0,3.0,304,0.10);
    // the humming sky: rumble grains, slow swells, dawn brightening
    let t:f64=0.0;
    let q:i64=0;
    while(t<30.0){
        let dawn:f64=1.0;
        if(t>20.0){dawn=1.0+0.6*sstep((t-20.0)/10.0);}
        let gi2:i64=g_pick(h,m,c_rumble,255,305,q,-1);
        place(h,m,nsamp,gi2,(t*SRF) as i64,0.13*dawn,0);
        t=t+1.9+0.7*h01(306,q);
        q=q+1;
    }
    // dawn: the cracking intensifies as light hits the sea
    let d2:i64=0;
    while(d2<10){
        let tt:f64=20.0+9.5*h01(307,d2);
        place(h,m,nsamp,g_pick(h,m,c_crack,255,308,d2,-1),(tt*SRF) as i64,0.26,0);
        d2=d2+1;
    }
}

// ============ SCORE: the RAXITH (TEST 3b -- the monster) ============
// Committed description (deliberated BEFORE any sound):
// The RAXITH: 9-meter silicon hexapod on a glass-dune world. Its
// exoskeleton is brittle crystalline plates that continuously fracture
// and regrow. IT HAS NO LARYNX. It "speaks" by CONTROLLED MICRO-FRACTURE:
// plates crack in deliberate sequences. A greeting = rising density of
// micro-cracks; alarm/emphasis = one deep plate-break (boom-class) with a
// shower of micro-cracks after. Its voice grammar is LANGUAGE-LIKE:
// syllable clusters (3-7 cracks, 120-200ms apart), phrase gaps (1-2s),
// accelerating density toward emphasis. NOTHING roars, growls, or
// pitch-sags: percussion AS speech. A second Raxith answers, sparser,
// quieter. This has no Earth referent and no Hollywood grammar.
fn rax_phrase(h:[]u8,m:[]u8,nsamp:i64,c_crack:i64,t0:f64,nsyl:i64,salt:i64,g0:f64)void{
    let t:f64=t0;
    let last:i64=-1;
    let s:i64=0;
    while(s<nsyl){
        let gi:i64=g_pick(h,m,c_crack,255,salt,s,last);
        place(h,m,nsamp,gi,(t*SRF) as i64,g0*(0.8+0.4*h01(salt+3,s)),0);
        last=gi;
        t=t+0.12+0.08*h01(salt+5,s*2);
        s=s+1;
    }
}
fn plate_break(h:[]u8,m:[]u8,nsamp:i64,c_boom:i64,c_crack:i64,c_rumble:i64,t0:f64,salt:i64)void{
    place(h,m,nsamp,g_pick(h,m,c_boom,255,salt,0,-1),(t0*SRF) as i64,0.6,0);
    morph(h,m,nsamp,g_pick(h,m,c_crack,255,salt,1,-1),g_pick(h,m,c_rumble,255,salt,2,-1),((t0+0.25)*SRF) as i64,0.4);
    let s:i64=0;
    let tt:f64=t0+0.6;
    while(s<6){
        place(h,m,nsamp,g_pick(h,m,c_crack,255,salt,3+s,-1),(tt*SRF) as i64,0.36,0);
        tt=tt+0.18+0.1*h01(salt+7,s);
        s=s+1;
    }
}
fn score_monster(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_crack:i64=cid_by_name(h,"crack");
    let c_boom:i64=cid_by_name(h,"boom");
    let c_rumble:i64=cid_by_name(h,"rumble");
    let c_creak:i64=cid_by_name(h,"creak");
    let c_wind:i64=cid_by_name(h,"wind");
    // dune wind; distant settling ticks
    scatter(h,m,nsamp,c_wind,0.0,30.0,2.8,401,0.12);
    let tk:i64=0;
    while(tk<6){
        place(h,m,nsamp,g_pick(h,m,c_crack,255,402,tk,-1),((0.5+(tk as f64)*0.65)*SRF) as i64,0.12,0);
        tk=tk+1;
    }
    // first utterance: three phrases, rising density
    rax_phrase(h,m,nsamp,c_crack,4.0,4,403,0.4);
    rax_phrase(h,m,nsamp,c_crack,5.8,5,404,0.44);
    rax_phrase(h,m,nsamp,c_crack,7.6,7,405,0.48);
    // emphasis: the plate-break
    plate_break(h,m,nsamp,c_boom,c_crack,c_rumble,10.5,406);
    // the second Raxith answers: sparser, quieter, overlapping once
    rax_phrase(h,m,nsamp,c_crack,14.0,3,407,0.26);
    rax_phrase(h,m,nsamp,c_crack,16.5,4,408,0.28);
    rax_phrase(h,m,nsamp,c_crack,18.2,3,409,0.42);
    rax_phrase(h,m,nsamp,c_crack,18.9,4,410,0.26);
    rax_phrase(h,m,nsamp,c_crack,21.0,5,411,0.3);
    // climax: dense fracture cascade into the final break
    let t:f64=22.0;
    let s:i64=0;
    while(s<16){
        place(h,m,nsamp,g_pick(h,m,c_crack,255,412,s,-1),(t*SRF) as i64,0.44,0);
        t=t+0.14-0.004*(s as f64);
        s=s+1;
    }
    plate_break(h,m,nsamp,c_boom,c_crack,c_rumble,26.0,413);
    place(h,m,nsamp,g_pick(h,m,c_crack,255,414,0,-1),(27.8*SRF) as i64,0.3,0);
    // one last settling creak-groan from the plates
    place(h,m,nsamp,g_pick(h,m,c_creak,255,415,0,-1),(28.6*SRF) as i64,0.22,0);
}

// per-grain centroid Hz (u32 at grain header offset 20), for brightness cascades
fn g_cent(h:[]u8,gi:i64)i64{
    let gcent:[]u8=(get64(h,112) as *u8)[0..(get64(h,72)*8)];
    return get64(gcent,gi*8);
}
// ---------- WAV writer (pattern from synth.zag, nsamp-parameterized) ----------
fn write_wav(path:[]u8,m:[]u8,nsamp:i64)i32{
    let nch:i64=get64(m,8);
    let s:i64=0;
    let peak:i64=0;
    while(s<nsamp){
        let cb:[]u8=mchunk(m,s/CHSMP);
        let v:i64=get64(cb,(s-s/CHSMP*CHSMP)*8);
        let a:i64=v;
        if(a<0){a=-a;}
        if(a>peak){peak=a;}
        s=s+1;
    }
    if(peak<1000){return -1;}
    // DC removal (mastering hygiene, A-NATIVE law): subtract the mean.
    let dc:i64=0;
    s=0;
    while(s<nsamp){
        let cb:[]u8=mchunk(m,s/CHSMP);
        dc=dc+get64(cb,(s-s/CHSMP*CHSMP)*8);
        s=s+1;
    }
    dc=dc/nsamp;
    s=0;
    while(s<nsamp){
        let cb:[]u8=mchunk(m,s/CHSMP);
        let o:i64=(s-s/CHSMP*CHSMP)*8;
        put64(cb,o,get64(cb,o)-dc);
        s=s+1;
    }
    let norm:f64=0.89*16777216.0/(peak as f64);
    let p:*u8=_zag_malloc(44+nsamp*2) as *u8;
    if(p==null as *u8){return -2;}
    let out:[]u8=p[0..(44+nsamp*2)];
    let i:i64=0;
    while(i<44+nsamp*2){out[i]=0;i=i+1;}
    out[0]=82;out[1]=73;out[2]=70;out[3]=70;
    put32(out,4,36+nsamp*2);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69;
    out[12]=102;out[13]=109;out[14]=116;out[15]=32;
    put32(out,16,16);
    put16(out,20,1);
    put16(out,22,1);
    put32(out,24,44100);
    put32(out,28,88200);
    put16(out,32,2);
    put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97;
    put32(out,40,nsamp*2);
    let fi:i64=1323;
    let fo:i64=nsamp/8;
    if(fo>35280){fo=35280;}
    s=0;
    while(s<nsamp){
        let cb:[]u8=mchunk(m,s/CHSMP);
        let v:i64=get64(cb,(s-s/CHSMP*CHSMP)*8);
        let x:f64=((v as f64)/16777216.0)*norm;
        if(s<fi){x=x*sstep((s as f64)/(fi as f64));}
        let rem:i64=nsamp-s;
        if(rem<fo){x=x*sstep((rem as f64)/(fo as f64));}
        let ax:f64=x;
        if(ax<0.0){ax=-ax;}
        x=x/(1.0+0.35*ax);
        put16(out,44+s*2,(x*32767.0) as i64);
        s=s+1;
    }
    let cs:[]u8=cstr(path);
    if(cs.len==0){return -3;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),577,438,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){return -4;}
    let wr:i64=w_all(fd,out);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(out));
    if(wr<0){return -5;}
    return 0;
}

// ============ ROUND-2 SCORES (continuity_round2) ============
// All deterministic (h32/h01 + GSS only). Zero RNG. Every audible moment a
// captured grain. Inserted before fn main in r2g.zag.

// ---- G1: world-first ocean (distributional shift testbed) ----
// The frozen score_ocean grammar + world-first bridges at phrase joints
// (fresh salts 501..505). Corpus honesty: bridges use wash/rumble/swell/
// crack only -- no kids voices in the ocean.
fn score_ocean_wf(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_swell:i64=cid_by_name(h,"swell");
    let c_wash:i64=cid_by_name(h,"wash");
    let c_crack:i64=cid_by_name(h,"crack");
    let c_rumble:i64=cid_by_name(h,"rumble");
    // four slow swells (same grammar as the frozen ocean score)
    let st:f64=2.0;
    let s2:i64=0;
    while(s2<4){
        let gi:i64=g_pick(h,m,c_swell,255,301,s2,-1);
        place(h,m,nsamp,gi,(st*SRF) as i64,0.5,0);
        let ns:i64=g_nsamp(h,gi);
        let pkf:f64=(st as f64)+(ns as f64)/(SR as f64)*0.45;
        let c2:i64=0;
        while(c2<3){
            let gc:i64=g_pick(h,m,c_crack,255,302,s2*3+c2,-1);
            place(h,m,nsamp,gc,((pkf+(c2 as f64)*0.22)*SRF) as i64,0.34,0);
            c2=c2+1;
        }
        let gr:i64=g_pick(h,m,c_crack,255,303,s2,-1);
        place(h,m,nsamp,gr,((pkf+0.8)*SRF) as i64,0.22,1);
        st=st+7.0;
        s2=s2+1;
    }
    scatter(h,m,nsamp,c_wash,0.0,30.0,3.0,304,0.10);
    let t:f64=0.0;
    let q:i64=0;
    while(t<30.0){
        let dawn:f64=1.0;
        if(t>20.0){dawn=1.0+0.6*sstep((t-20.0)/10.0);}
        let gi2:i64=g_pick(h,m,c_rumble,255,305,q,-1);
        place(h,m,nsamp,gi2,(t*SRF) as i64,0.13*dawn,0);
        t=t+1.9+0.7*h01(306,q);
        q=q+1;
    }
    let d2:i64=0;
    while(d2<10){
        let tt:f64=20.0+9.5*h01(307,d2);
        place(h,m,nsamp,g_pick(h,m,c_crack,255,308,d2,-1),(tt*SRF) as i64,0.26,0);
        d2=d2+1;
    }
    // world-first: bridges at the five phrase joints (midpoints 1.1, 5.6,
    // 12.6, 19.6, 26.6 -- the G1 measurement boundaries)
    bridge_ocean(h,m,nsamp,0.0,2.2,2.2,501);
    bridge_ocean(h,m,nsamp,4.6,6.6,6.6,502);
    bridge_ocean(h,m,nsamp,11.6,13.6,13.6,503);
    bridge_ocean(h,m,nsamp,18.6,20.6,20.6,504);
    bridge_ocean(h,m,nsamp,25.6,27.6,27.6,505);
}

// ---- G2: one unbroken 180 s world pass (accumulated-drift testbed) ----
fn kids_group(h:[]u8,m:[]u8,nsamp:i64,g0s:f64,sb:i64)void{
    let c_laugh:i64=cid_by_name(h,"laugh");
    let c_shout:i64=cid_by_name(h,"shout");
    let c_squeal:i64=cid_by_name(h,"squeal");
    let c_thump:i64=cid_by_name(h,"thump");
    run_feet(h,m,nsamp,c_thump,g0s+0.5,g0s+11.0,2.8,sb,0.34);
    run_feet(h,m,nsamp,c_thump,g0s+1.0,g0s+12.0,2.6,sb+1,0.30);
    laugh_train(h,m,nsamp,c_laugh,sb%3,g0s+3.0,8,0.19,sb+2,0.5);
    laugh_train(h,m,nsamp,c_laugh,(sb+1)%3,g0s+4.2,7,0.21,sb+3,0.46);
    let gi:i64=g_pick(h,m,c_shout,sb%3,sb+4,0,-1);
    place(h,m,nsamp,gi,((g0s+13.0)*SRF) as i64,0.42,0);
    run_feet(h,m,nsamp,c_thump,g0s+14.0,g0s+25.0,2.2,sb+5,0.28);
    laugh_train(h,m,nsamp,c_laugh,(sb+2)%3,g0s+17.0,6,0.17,sb+6,0.44);
    let g2:i64=g_pick(h,m,c_squeal,sb%3,sb+7,0,-1);
    place(h,m,nsamp,g2,((g0s+22.5)*SRF) as i64,0.40,0);
}
fn score_long180(h:[]u8,m:[]u8,nsamp:i64)void{
    let c_wash:i64=cid_by_name(h,"wash");
    let c_wind:i64=cid_by_name(h,"wind");
    // continuous world bed, one pass, no resets
    scatter(h,m,nsamp,c_wash,0.0,178.0,2.6,1101,0.13);
    scatter(h,m,nsamp,c_wind,6.0,174.0,4.2,1103,0.16);
    let g:i64=0;
    while(g<6){
        kids_group(h,m,nsamp,(g*30) as f64,2000+g*500);
        g=g+1;
    }
    bridge_world(h,m,nsamp,0.0,2.4,2.4,3101);
    let j:i64=1;
    while(j<6){
        let jt:f64=(j*30) as f64;
        bridge_world(h,m,nsamp,jt-1.2,jt+1.2,jt+1.2,3101+j);
        j=j+1;
    }
}

// ---- H3: 300 s scene generator (frozen-bed testbed) ----
fn h3_bed(h:[]u8,m:[]u8,nsamp:i64,bedmode:i64,idx:i64)void{
    let c_wash:i64=cid_by_name(h,"wash");
    let c_wind:i64=cid_by_name(h,"wind");
    let sb:i64=5000+idx*1000;
    if(bedmode==1){sb=sb+700000;} // control: disjoint deterministic salt region
    scatter(h,m,nsamp,c_wash,0.0,298.0,2.6,sb,0.13);
    scatter(h,m,nsamp,c_wind,0.0,296.0,4.2,sb+2,0.16);
    bridge_world(h,m,nsamp,0.0,2.4,2.4,6000+idx*10);
    let j:i64=1;
    while(j<10){
        let jt:f64=(j*30) as f64;
        bridge_world(h,m,nsamp,jt-1.5,jt+1.5,jt+1.5,6000+idx*10+j);
        j=j+1;
    }
}
fn h3_familiar(h:[]u8,m:[]u8,nsamp:i64,idx:i64)void{
    let b:i64=0;
    while(b<10){
        kids_group(h,m,nsamp,(b*30) as f64,10000+idx*5000+b*200);
        b=b+1;
    }
}
fn h3_stream(h:[]u8,m:[]u8,nsamp:i64,s:i64,t0:f64,t1:f64,salt:i64)void{
    if(s==0){scatter(h,m,nsamp,cid_by_name(h,"wash"),t0,t1,1.2,salt,0.16);}
    else{if(s==1){scatter(h,m,nsamp,cid_by_name(h,"wind"),t0,t1,1.8,salt,0.10);}
    else{if(s==2){scatter(h,m,nsamp,cid_by_name(h,"laugh"),t0,t1,0.9,salt,0.30);}
    else{if(s==3){run_feet(h,m,nsamp,cid_by_name(h,"thump"),t0,t1,2.2,salt,0.22);}
    else{if(s==4){scatter(h,m,nsamp,cid_by_name(h,"shout"),t0,t1,3.0,salt,0.30);}
    else{if(s==5){scatter(h,m,nsamp,cid_by_name(h,"creak"),t0,t1,2.4,salt,0.18);}
    else{if(s==6){scatter(h,m,nsamp,cid_by_name(h,"crack"),t0,t1,0.7,salt,0.22);}
    else{scatter(h,m,nsamp,cid_by_name(h,"rumble"),t0,t1,2.6,salt,0.14);}}}}}}}
}
fn h3_dense(h:[]u8,m:[]u8,nsamp:i64,idx:i64)void{
    // 8 streams; active count D(b) = 4,5,6,7,8,8,7,6,5,4 across blocks
    let b:i64=0;
    while(b<10){
        let dd:i64=b;
        if(b>5){dd=9-b;}
        if(dd>4){dd=4;}
        let d:i64=4+dd;
        let s:i64=0;
        while(s<d){
            h3_stream(h,m,nsamp,s,(b*30) as f64,((b+1)*30) as f64,20000+idx*5000+b*300+s*17);
            s=s+1;
        }
        b=b+1;
    }
}
fn h3_novel(h:[]u8,m:[]u8,nsamp:i64,idx:i64)void{
    let c_wash:i64=cid_by_name(h,"wash");
    let c_rumble:i64=cid_by_name(h,"rumble");
    let c_crack:i64=cid_by_name(h,"crack");
    let c_laugh:i64=cid_by_name(h,"laugh");
    let c_thump:i64=cid_by_name(h,"thump");
    let b:i64=0;
    while(b<10){
        let t0:f64=(b*30) as f64;
        let sb:i64=30000+idx*5000+b*200;
        if(idx==0){
            // n0: ocean grammar under kids voices
            scatter(h,m,nsamp,c_wash,t0,t0+30.0,0.9,sb,0.20);
            scatter(h,m,nsamp,c_rumble,t0,t0+30.0,2.0,sb+1,0.16);
            laugh_train(h,m,nsamp,c_laugh,sb%3,t0+7.0,6,0.23,sb+2,0.40);
            laugh_train(h,m,nsamp,c_laugh,(sb+1)%3,t0+19.0,5,0.25,sb+3,0.36);
        }else{if(idx==1){
            // n1: raxith crack-syllables over kids bed, density rising/block
            let nsy:i64=3+b/2;
            rax_phrase(h,m,nsamp,c_crack,t0+2.0,nsy,sb,0.5);
            rax_phrase(h,m,nsamp,c_crack,t0+12.0,nsy,sb+1,0.44);
            rax_phrase(h,m,nsamp,c_crack,t0+21.0,nsy,sb+2,0.5);
            run_feet(h,m,nsamp,c_thump,t0,t0+30.0,1.6,sb+3,0.16);
        }else{if(idx==2){
            // n2: reversed phrases (rev=1): backwards laughs, reversed wash
            let p:i64=0;
            while(p<6){
                let gi:i64=g_pick(h,m,c_laugh,sb%3,sb+10,p,-1);
                place(h,m,nsamp,gi,((t0+2.0+(p as f64)*4.4)*SRF) as i64,0.40,1);
                p=p+1;
            }
            let q2:i64=0;
            let t2:f64=t0;
            while(t2<t0+30.0){
                let gw:i64=g_pick(h,m,c_wash,255,sb+11,q2,-1);
                place(h,m,nsamp,gw,((t2)*SRF) as i64,0.16,1);
                t2=t2+2.2+0.8*h01(sb+12,q2);
                q2=q2+1;
            }
        }else{
            // n3: brightness-falling crack cascades + feet
            let t3:f64=t0+1.0;
            let p3:i64=0;
            while(p3<10){
                let gc:i64=g_pick(h,m,c_crack,255,sb+20,p3,-1);
                let gg:f64=0.5-0.035*(p3 as f64);
                place(h,m,nsamp,gc,((t3)*SRF) as i64,gg,0);
                t3=t3+0.55-0.04*(p3 as f64);
                p3=p3+1;
            }
            run_feet(h,m,nsamp,c_thump,t0+12.0,t0+28.0,2.4,sb+21,0.26);
            let t4:f64=t0+16.0;
            let p4:i64=0;
            while(p4<6){
                let gd:i64=g_pick(h,m,c_crack,255,sb+22,p4,-1);
                place(h,m,nsamp,gd,((t4)*SRF) as i64,0.34-0.03*(p4 as f64),0);
                t4=t4+0.9;
                p4=p4+1;
            }
        }}}
        b=b+1;
    }
}
fn score_h3(h:[]u8,m:[]u8,nsamp:i64,cls:i64,idx:i64,bedmode:i64)void{
    h3_bed(h,m,nsamp,bedmode,idx);
    if(cls==0){h3_familiar(h,m,nsamp,idx);}
    else{if(cls==1){h3_dense(h,m,nsamp,idx);}
    else{h3_novel(h,m,nsamp,idx);}}
}

fn dump_grains(h:[]u8)void{
    let ng:i64=get64(h,72);
    let gcid:[]u8=(get64(h,16) as *u8)[0..(ng*8)];
    let ncls:i64=get64(h,88);
    let cname:[]u8=(get64(h,96) as *u8)[0..(ncls*8)];
    let coff:[]u8=(get64(h,104) as *u8)[0..(ncls*8)];
    let fd:i64=1;
    let gi:i64=0;
    while(gi<ng){
        let cid:i64=get64(gcid,gi*8);
        wdec(fd,gi);wch(fd,32);
        wdec(fd,cid);wch(fd,32);
        let ci:i64=0;
        while(ci<ncls){
            if(ci==cid){
                let np:i64=get64(cname,ci*8);
                let nl:i64=get64(coff,ci*8);
                let nm:[]u8=(np as *u8)[0..nl];
                _zag_raw_syscall(1,fd,_zag_slice_ptr(nm) as i64,nl,0,0,0);
            }
            ci=ci+1;
        }
        wch(fd,10);
        gi=gi+1;
    }
}
fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let subj:i32=0;
    if(_zag_strcmp(a1,"kids")==1){subj=1;}
    if(_zag_strcmp(a1,"planet")==1){subj=2;}
    if(_zag_strcmp(a1,"ocean")==1){subj=3;}
    if(_zag_strcmp(a1,"monster")==1){subj=4;}
    if(_zag_strcmp(a1,"oceanwf")==1){subj=5;}
    if(_zag_strcmp(a1,"long180")==1){subj=6;}
    if(_zag_strcmp(a1,"h3")==1){subj=7;}
    if(_zag_strcmp(a1,"dumpgrains")==1){subj=8;}
    if(subj==0){return 90;}
    let a2:[]u8=_zag_arg(2);
    let pkp:[]u8="study_out/gamma.grpk";
    if(a2.len>0){pkp=a2;}
    let a3:[]u8=_zag_arg(3);
    let outp:[]u8="out.wav";
    if(a3.len>0){outp=a3;}
    let a4:[]u8=_zag_arg(4);
    let seedoff:i64=0;
    if(a4.len>0){seedoff=parse_i64(a4);}
    let a5:[]u8=_zag_arg(5);
    let bmode:i64=0;
    if(a5.len>0){bmode=parse_i64(a5);}
    let a6:[]u8=_zag_arg(6);
    let lfd:i64=-1;
    if(a6.len>0){
        let cs6:[]u8=cstr(a6);
        lfd=_zag_raw_syscall(2,(_zag_slice_ptr(cs6) as i64),577,438,0,0,0);
        _zag_free(_zag_slice_ptr(cs6));
    }
    let h:[]u8=pack_load(pkp);
    if(h.len==0){return 91;}
    let nsamp:i64=1323000;
    if(subj==2){nsamp=926100;}
    if(subj==6){nsamp=7938000;}
    if(subj==7){nsamp=13230000;}
    let m:[]u8=mix_new(nsamp);
    if(m.len==0){return 92;}
    if(subj==8){dump_grains(h);return 0;}
    put64(m,24,lfd);
    put64(m,32,seedoff);
    put64(m,40,bmode);
    if(subj==1){score_kids(h,m,nsamp);}
    else{if(subj==2){score_planet(h,m,nsamp);}
    else{if(subj==3){score_ocean(h,m,nsamp);}
    else{if(subj==4){score_monster(h,m,nsamp);}
    else{if(subj==5){score_ocean_wf(h,m,nsamp);}
    else{if(subj==6){score_long180(h,m,nsamp);}
    else{
        let a7:[]u8=_zag_arg(7);
        let cls:i64=0;
        if(a7.len>0){cls=parse_i64(a7);}
        let a8:[]u8=_zag_arg(8);
        let idx:i64=0;
        if(a8.len>0){idx=parse_i64(a8);}
        let a9:[]u8=_zag_arg(9);
        let bm:i64=0;
        if(a9.len>0){bm=parse_i64(a9);}
        score_h3(h,m,nsamp,cls,idx,bm);
    }}}}}}
    let rc:i32=write_wav(outp,m,nsamp);
    if(lfd>=0){_zag_raw_syscall(3,lfd,0,0,0,0,0);}
    return rc;
}

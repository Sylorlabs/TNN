// pilot.zag — composition battery PILOT (instrument validation, NOT a TNN trial)
// argv[1]: ok|nomaster|noretrieve|nocombine|interfere|reflex|null
// Deterministic. Zero RNG. stdout: ITEM TSV + SUMMARY block.
// Rules: 0=REVERSE 1=DUPFIRST 2=ROTLEFT 3=DROPLAST

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
}
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn i32s(v:i32)[]u8 { return i64s(v as i64); }
fn streq(a:[]u8,b:[]u8)i64 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
// deterministic token: length 2+(i%4), bytes (97+(7i+13k+k^2)%26)
// (quadratic term breaks accidental palindromes that made P3 insensitive)
fn toklen(i:i32)i32 { return 2+(i%4); }
fn tokfill(i:i32,out:[]u8)void {
  let n:i32=toklen(i);let k:i32=0;
  while(k<n){out[k]=(97+((i*7+k*13+k*k)%26)) as u8;k=k+1;}
}
// apply rule r to src[0..n], write to dst, return out length
fn apply_rule(r:i32,src:[]u8,n:i32,dst:[]u8)i32 {
  if(r==0){let k:i32=0;while(k<n){dst[k]=src[n-1-k];k=k+1;}return n;}
  if(r==1){dst[0]=src[0];let k:i32=0;while(k<n){dst[1+k]=src[k];k=k+1;}return n+1;}
  if(r==2){
    if(n<1){return 0;}
    let k:i32=0;while(k<n-1){dst[k]=src[k+1];k=k+1;}dst[n-1]=src[0];return n;
  }
  let k:i32=0;while(k<n-1){dst[k]=src[k];k=k+1;}return n-1;
}
fn bufeq(a:[]u8,na:i32,b:[]u8,nb:i32)i64 {
  if(na!=nb){return 0;}
  let k:i32=0;while(k<na){if(a[k]!=b[k]){return 0;}k=k+1;}
  return 1;
}
// mode: 0=ok 1=nomaster 2=noretrieve 3=nocombine 4=interfere 5=reflex 6=null
fn mode_of(arg:[]u8)i64 {
  if(streq(arg,"ok")==1){return 0;}
  if(streq(arg,"nomaster")==1){return 1;}
  if(streq(arg,"noretrieve")==1){return 2;}
  if(streq(arg,"nocombine")==1){return 3;}
  if(streq(arg,"interfere")==1){return 4;}
  if(streq(arg,"reflex")==1){return 5;}
  if(streq(arg,"null")==1){return 6;}
  return -1;
}
// agent's single-part answer; writes to out, returns length
fn agent_part(mode:i64,r:i32,src:[]u8,n:i32,out:[]u8)i32 {
  if(mode==1 || mode==6){
    let k:i32=0;while(k<n){out[k]=src[k];k=k+1;}return n;
  }
  return apply_rule(r,src,n,out);
}
// agent's retrieval answer for ordered pair (pi,pj); packed ((ra+2)*16+(rb+2)), -1=unknown
fn agent_retrieve(mode:i64,pi:i32,pj:i32)i64 {
  if(mode==1 || mode==6){return 1*16+1;} // (-1,-1)
  if(mode==2){return (pj+2)*16+(pi+2);} // reversed (wrong)
  return (pi+2)*16+(pj+2);
}
// agent's two-hop answer for pair (pi,pj); writes to out, returns length
fn agent_compose(mode:i64,pi:i32,pj:i32,src:[]u8,n:i32,out:[]u8,tmp:[]u8)i32 {
  if(mode==1 || mode==6 || mode==2){
    let k:i32=0;while(k<n){out[k]=src[k];k=k+1;}return n;
  }
  if(mode==3){return apply_rule(pi,src,n,out);}
  let m:i32=apply_rule(pi,src,n,tmp);
  let l:i32=apply_rule(pj,tmp,m,out);
  if(mode==4 && pj==1){
    // interference: corrupt when DUPFIRST is the second rule
    if(l>0){return l-1;}
    return 0;
  }
  return l;
}
// agent's distractor answer (no rule applies; correct = identity)
fn agent_distract(mode:i64,src:[]u8,n:i32,out:[]u8)i32 {
  if(mode==5){return apply_rule(0,src,n,out);}
  let k:i32=0;while(k<n){out[k]=src[k];k=k+1;}return n;
}
fn emit(s:[]u8)void { _zag_print(s); }

fn main()i32 {
  let mode:i64=mode_of(_zag_arg(1));
  if(mode<0){emit("usage: pilot MODE\n");return 1;}
  let s0:[]u8=z_alloc(16);
  let s1:[]u8=z_alloc(16);
  let s2:[]u8=z_alloc(16);
  let exp:[]u8=z_alloc(16);
  let got:[]u8=z_alloc(16);
  // per-item class codes: 0=ok 1=A 2=B 3=C 4=D ; per-pair retrieval flag
  let clsarr:[]u8=z_alloc(48);
  let retarr:[]u8=z_alloc(12);
  let nElig:i32=0;let compElig:i32=0;

  // ---------- P0 mastery: 6 novel inputs per rule (tok 6..11) ----------
  let rp0:i32=0;let rp1:i32=0;let rp2:i32=0;let rp3:i32=0;
  let r:i32=0;
  while(r<4){
    let c:i32=0;let t:i32=6;
    while(t<12){
      let n:i32=toklen(t);tokfill(t,s0);
      let le:i32=apply_rule(r,s0,n,exp);
      let lg:i32=agent_part(mode,r,s0,n,got);
      if(bufeq(exp,le,got,lg)==1){c=c+1;}
      t=t+1;
    }
    if(r==0){rp0=c;}
    if(r==1){rp1=c;}
    if(r==2){rp2=c;}
    if(r==3){rp3=c;}
    emit("ITEM\tphase=0\trule=");emit(i32s(r));emit("\tpass=");
    emit(i32s(c));emit("/6\n");
    r=r+1;
  }
  let mpass:i32=0;
  if(rp0>=5){mpass=mpass+1;}
  if(rp1>=5){mpass=mpass+1;}
  if(rp2>=5){mpass=mpass+1;}
  if(rp3>=5){mpass=mpass+1;}

  // pair tables: 12 ordered pairs; per-pair correct counts
  let pc0:i32=0;let pc1:i32=0;let pc2:i32=0;let pc3:i32=0;
  let pc4:i32=0;let pc5:i32=0;let pc6:i32=0;let pc7:i32=0;
  let pc8:i32=0;let pc9:i32=0;let pc10:i32=0;let pc11:i32=0;
  let retr_ok:i32=0;
  let comp_ok:i32=0;
  let nA:i32=0;let nB:i32=0;let nC:i32=0;let nD:i32=0;let nOk:i32=0;

  // ---------- P1+P2: 12 pairs x 4 inputs (tok 14..61) ----------
  let p:i32=0;
  while(p<12){
    let pi:i32=p/3;
    let q:i32=p%3;
    let pj:i32=q;
    if(q>=pi){pj=q+1;}
    // retrieval probe
    let rpack:i64=agent_retrieve(mode,pi,pj);
    let rok:i32=0;
    if(rpack/16-2==pi && rpack%16-2==pj){rok=1;retr_ok=retr_ok+1;}
    if(rok==1){retarr[p]=1;}
    // mastery flags for this pair
    let mpi:i32=0;let mpj:i32=0;
    if(pi==0 && rp0>=5){mpi=1;}
    if(pi==1 && rp1>=5){mpi=1;}
    if(pi==2 && rp2>=5){mpi=1;}
    if(pi==3 && rp3>=5){mpi=1;}
    if(pj==0 && rp0>=5){mpj=1;}
    if(pj==1 && rp1>=5){mpj=1;}
    if(pj==2 && rp2>=5){mpj=1;}
    if(pj==3 && rp3>=5){mpj=1;}
    let pairc:i32=0;
    let it:i32=0;
    while(it<4){
      let ti:i32=14+p*4+it;
      let n:i32=toklen(ti);tokfill(ti,s0);
      // expected two-hop
      let m:i32=apply_rule(pi,s0,n,s1);
      let le:i32=apply_rule(pj,s1,m,exp);
      let lg:i32=agent_compose(mode,pi,pj,s0,n,got,s2);
      let good:i32=0;
      let ccode:i32=0; // 0=ok 1=A 2=B 3=C
      let cls:[]u8="ok";
      if(mpi==0 || mpj==0){cls="A";ccode=1;nA=nA+1;}
      if(streq(cls,"ok")==1 && rok==0){cls="B";ccode=2;nB=nB+1;}
      if(streq(cls,"ok")==1){
        if(bufeq(exp,le,got,lg)==1){good=1;nOk=nOk+1;}
        if(good==0){cls="C";ccode=3;nC=nC+1;}
      }
      clsarr[p*4+it]=ccode as u8;
      if(ccode!=1 && ccode!=2){
        // scoring decoupled from classification: eligible = composition attempted
        nElig=nElig+1;
        if(good==1){compElig=compElig+1;}
      }
      if(good==1){pairc=pairc+1;comp_ok=comp_ok+1;}
      emit("ITEM\tphase=2\tpair=");emit(i32s(pi));emit(",");emit(i32s(pj));
      emit("\tinput=");emit(i32s(ti));emit("\tclass=");emit(cls);
      emit("\tok=");emit(i32s(good));emit("\n");
      it=it+1;
    }
    if(p==0){pc0=pairc;}
    if(p==1){pc1=pairc;}
    if(p==2){pc2=pairc;}
    if(p==3){pc3=pairc;}
    if(p==4){pc4=pairc;}
    if(p==5){pc5=pairc;}
    if(p==6){pc6=pairc;}
    if(p==7){pc7=pairc;}
    if(p==8){pc8=pairc;}
    if(p==9){pc9=pairc;}
    if(p==10){pc10=pairc;}
    if(p==11){pc11=pairc;}
    p=p+1;
  }

  // ---------- P4 interference: order asymmetry at pair level ----------
  // pair index for (i,j): pi*3 + (pj - (pj>pi?1:0))
  // reverse of p: recompute below via loop
  let p2:i32=0;
  while(p2<12){
    let pi:i32=p2/3;
    let q:i32=p2%3;
    let pj:i32=q;
    if(q>=pi){pj=q+1;}
    // find reverse pair index
    let rp:i32=0;
    while(rp<12){
      let ri:i32=rp/3;
      let rq:i32=rp%3;
      let rj:i32=rq;
      if(rq>=ri){rj=rq+1;}
      if(ri==pj && rj==pi){break;}
      rp=rp+1;
    }
    let ca:i32=0;let cb:i32=0;
    if(p2==0){ca=pc0;}if(p2==1){ca=pc1;}if(p2==2){ca=pc2;}
    if(p2==3){ca=pc3;}if(p2==4){ca=pc4;}if(p2==5){ca=pc5;}
    if(p2==6){ca=pc6;}if(p2==7){ca=pc7;}if(p2==8){ca=pc8;}
    if(p2==9){ca=pc9;}if(p2==10){ca=pc10;}if(p2==11){ca=pc11;}
    if(rp==0){cb=pc0;}if(rp==1){cb=pc1;}if(rp==2){cb=pc2;}
    if(rp==3){cb=pc3;}if(rp==4){cb=pc4;}if(rp==5){cb=pc5;}
    if(rp==6){cb=pc6;}if(rp==7){cb=pc7;}if(rp==8){cb=pc8;}
    if(rp==9){cb=pc9;}if(rp==10){cb=pc10;}if(rp==11){cb=pc11;}
    // both parts mastered?
    let mpi2:i32=0;let mpj2:i32=0;
    if(pi==0 && rp0>=5){mpi2=1;}if(pi==1 && rp1>=5){mpi2=1;}
    if(pi==2 && rp2>=5){mpi2=1;}if(pi==3 && rp3>=5){mpi2=1;}
    if(pj==0 && rp0>=5){mpj2=1;}if(pj==1 && rp1>=5){mpj2=1;}
    if(pj==2 && rp2>=5){mpj2=1;}if(pj==3 && rp3>=5){mpj2=1;}
    if(ca<=1 && cb>=3 && mpi2==1 && mpj2==1 && retarr[p2]==1 && retarr[rp]==1){
      // reclassify ONLY this pair's items actually sitting in C (never A/B/ok)
      let ri2:i32=0;
      while(ri2<4){
        let ix:i32=p2*4+ri2;
        if(clsarr[ix]==3){clsarr[ix]=4;nC=nC-1;nD=nD+1;}
        ri2=ri2+1;
      }
      emit("INTERF\tpair=");emit(i32s(pi));emit(",");emit(i32s(pj));
      emit("\tacc=");emit(i32s(ca));emit("/4\trev=");emit(i32s(cb));emit("/4\n");
    }
    p2=p2+1;
  }

  // ---------- P3 reflex: 8 distractors (tok 62..69), correct = identity ----------
  let refl:i32=0;
  let d:i32=62;
  while(d<70){
    let n:i32=toklen(d);tokfill(d,s0);
    let lg:i32=agent_distract(mode,s0,n,got);
    let bad:i32=0;
    if(bufeq(s0,n,got,lg)==0){bad=1;refl=refl+1;}
    emit("ITEM\tphase=3\tinput=");emit(i32s(d));emit("\treflex=");
    emit(i32s(bad));emit("\n");
    d=d+1;
  }

  // ---------- SUMMARY ----------
  emit("SUMMARY\tmode=");emit(_zag_arg(1));
  emit("\tmastery_rules=");emit(i32s(mpass));emit("/4");
  emit("\tretrieval=");emit(i32s(retr_ok));emit("/12");
  emit("\tcomposition=");emit(i32s(comp_ok));emit("/48");
  emit("\tA=");emit(i32s(nA));emit("\tB=");emit(i32s(nB));
  emit("\tC=");emit(i32s(nC));emit("\tD=");emit(i32s(nD));
  emit("\tok=");emit(i32s(nOk));
  emit("\telig=");emit(i32s(compElig));emit("/");emit(i32s(nElig));
  emit("\treflex=");emit(i32s(refl));emit("/8\n");
  emit("PAIRS\t");emit(i32s(pc0));emit(" ");emit(i32s(pc1));emit(" ");
  emit(i32s(pc2));emit(" ");emit(i32s(pc3));emit(" ");emit(i32s(pc4));emit(" ");
  emit(i32s(pc5));emit(" ");emit(i32s(pc6));emit(" ");emit(i32s(pc7));emit(" ");
  emit(i32s(pc8));emit(" ");emit(i32s(pc9));emit(" ");emit(i32s(pc10));emit(" ");
  emit(i32s(pc11));emit("\n");

  z_free(s0);z_free(s1);z_free(s2);z_free(exp);z_free(got);
  z_free(clsarr);z_free(retarr);
  return 0;
}

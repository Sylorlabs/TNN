// raw_pcm.zag — RAW audio path baseline.
// VERBATIM copies of crew_p organ.zag functions (the standing forward sense):
// cstr, file_read, get_s16, get_u32, get64, put64, wav_parse.
// Nothing here is new code; this harnesses the frozen raw path to emit held audio.
// Usage: raw_pcm <inpath> <outpath>   (emits held audio format)
// Pure Zag, zero RNG.

// ---------------- verbatim from ~/workspace/audio_principles/crew_p/organ.zag ----------------
fn cstr(s: []u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let p: *u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if (p == null as *u8) { return ""; }
    let b: []u8 = p[0..(s.len + 1)];
    let i: i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn file_read(path: []u8, cap: i64) []u8 {
    let cs: []u8 = cstr(path);
    if (cs.len == 0) { return ""; }
    let fd: i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return ""; }
    let p: *u8 = _zag_malloc(cap) as *u8;
    if (p == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let at: i64 = 0;
    while (at < cap) {
        let n: i64 = _zag_raw_syscall(0, fd, (p as i64) + at, cap - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let b: []u8 = p[0..at];
    return b;
}

// sample idx -> signed 16-bit (idx counts samples, byte offset = idx*2)
fn get_s16(b: []u8, idx: i64) i64 {
    let o: i64 = idx * 2;
    let lo: i64 = (b[o] as i64) & 255;
    let hi: i64 = (b[o + 1] as i64) & 255;
    let v: i64 = lo | (hi << 8);
    if (v >= 32768) { v = v - 65536; }
    return v;
}

fn get_u32(b: []u8, o: i64) i64 {
    return ((b[o] as i64) & 255) | (((b[o + 1] as i64) & 255) << 8) | (((b[o + 2] as i64) & 255) << 16) | (((b[o + 3] as i64) & 255) << 24);
}

fn get64(a: []u8, o: i64) i64 {
    let v: i64 = 0;
    let i: i64 = 0;
    while (i < 8) {
        v = v | (((a[o + i] as i64) & 255) << (i * 8));
        i = i + 1;
    }
    return v;
}

fn put64(a: []u8, o: i64, v: i64) void {
    let i: i64 = 0;
    while (i < 8) {
        a[o + i] = ((v >> (i * 8)) & 255) as u8;
        i = i + 1;
    }
    return;
}

// META2: [0]=data start sample index (byte_off/2), [1]=nsamp. Returns 1 ok / 0 fail.
fn wav_parse(b: []u8, META2: []u8) i64 {
    if ((b.len as i64) < 44) { return 0; }
    if (!(b[0] == 82 && b[1] == 73 && b[2] == 70 && b[3] == 70)) { return 0; } // RIFF
    if (!(b[8] == 87 && b[9] == 65 && b[10] == 86 && b[11] == 69)) { return 0; } // WAVE
    let off: i64 = 12;
    let blen: i64 = b.len as i64;
    let fmt_ok: i64 = 0;
    let dsamp: i64 = -1;
    let nsamp: i64 = 0;
    while (off + 8 <= blen) {
        let c0: i64 = b[off] as i64;
        let c1: i64 = b[off + 1] as i64;
        let c2: i64 = b[off + 2] as i64;
        let c3: i64 = b[off + 3] as i64;
        let sz: i64 = get_u32(b, off + 4);
        if (c0 == 102 && c1 == 109 && c2 == 116 && c3 == 32) { // "fmt "
            if (sz < 16) { return 0; }
            let afmt: i64 = ((b[off + 8] as i64) & 255) | (((b[off + 9] as i64) & 255) << 8);
            let ch: i64 = ((b[off + 10] as i64) & 255) | (((b[off + 11] as i64) & 255) << 8);
            let sr: i64 = get_u32(b, off + 12);
            let bits: i64 = ((b[off + 22] as i64) & 255) | (((b[off + 23] as i64) & 255) << 8);
            if (afmt == 1 && ch == 1 && sr == 44100 && bits == 16) { fmt_ok = 1; }
        }
        if (c0 == 100 && c1 == 97 && c2 == 116 && c3 == 97) { // "data"
            dsamp = (off + 8) / 2;
            nsamp = sz / 2;
        }
        off = off + 8 + sz;
    }
    if (fmt_ok == 0 || dsamp < 0 || nsamp <= 0) { return 0; }
    put64(META2, 0, dsamp);
    put64(META2, 8, nsamp);
    return 1;
}
// ---------------- end verbatim ----------------

// local held-audio emitter (same layout as common.zag emit_held_audio)
fn wr_u64le_l(b: []u8, o: i64, v: i64) void {
    let i: i64 = 0;
    while (i < 8) { b[o + i] = ((v >> (i * 8)) & 255) as u8; i = i + 1; }
    return;
}
fn file_write_trunc_l(path: []u8, data: []u8) i64 {
    let cs: []u8 = cstr(path);
    if (cs.len == 0) { return -1; }
    let fd: i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 577, 420, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return -2; }
    let at: i64 = 0;
    let total: i64 = data.len as i64;
    while (at < total) {
        let n: i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(data) as i64) + at, total - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return -3; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return at;
}

fn main() i32 {
    let inp: []u8 = _zag_arg(1);
    let outp: []u8 = _zag_arg(2);
    if (_zag_strcmp(inp, "") == 1) { _zag_println("need inpath"); return 1; }
    if (_zag_strcmp(outp, "") == 1) { _zag_println("need outpath"); return 1; }
    let b: []u8 = file_read(inp, 6000000);
    if ((b.len as i64) < 44) { _zag_println("short file"); return 1; }
    let p: *u8 = _zag_malloc(16) as *u8;
    if (p == null as *u8) { _zag_println("alloc failed"); return 1; }
    let META2: []u8 = p[0..16];
    let i: i64 = 0;
    while (i < 16) { META2[i] = 0; i = i + 1; }
    if (wav_parse(b, META2) == 0) { _zag_println("wav_parse failed"); return 1; }
    let ds0: i64 = get64(META2, 0);
    let nsamp: i64 = get64(META2, 8);
    // NOTE: raw path holds ALL samples 0..nsamp-1, including 0..63 (verified here).
    let total: i64 = 32 + nsamp * 8;
    let q: *u8 = _zag_malloc(total) as *u8;
    if (q == null as *u8) { _zag_println("alloc out failed"); return 1; }
    let ob: []u8 = q[0..total];
    i = 0;
    while (i < total) { ob[i] = 0; i = i + 1; }
    ob[0] = 84; ob[1] = 78; ob[2] = 73; ob[3] = 78; ob[4] = 65; ob[5] = 85; ob[6] = 68; ob[7] = 49;
    wr_u64le_l(ob, 8, 1);
    wr_u64le_l(ob, 16, 44100);
    wr_u64le_l(ob, 24, nsamp);
    i = 0;
    while (i < nsamp) {
        wr_u64le_l(ob, 32 + i * 8, get_s16(b, ds0 + i));
        i = i + 1;
    }
    let rc: i64 = file_write_trunc_l(outp, ob);
    if (rc < 0) { _zag_println("emit failed"); return 1; }
    _zag_print("raw_pcm ok nsamp=");
    let s: []u8 = _zag_i64_to_str(nsamp);
    _zag_println(s);
    return 0;
}

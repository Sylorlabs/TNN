@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

fn t3(cfg:*DCfg)void {
    cfg.*.shallow_rounds=7;
}
fn main()i32 {
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:1,.deep_rounds:1,.amin:3,.amax:64,.conf_thr:0,.stab_win:0,.eps:20,.elim_margin:900,.refute_thr:600,.evcap:64};
    t3(&cfg);
    cfg.shallow_rounds=9;
    _zag_print(_zag_i64_to_str(cfg.shallow_rounds as i64));
    return 0;
}

// learn_schema_v3c.zag — K-C deliberate schema learner
// (PREREG_NCAL_V3C_B13FIX_FROZEN.md §3.1).
//
// Reads the frozen K-C diet (id, f1, f5, depth, correct, prov), accumulates
// (correct,total) per reference class in the learner's OWN private store:
//   L1: exact (f1,f5,depth); L2: (f1,f5); L3: (depth); L4: global released.
// Then emits the frozen schema file (all four levels' tables as frozen data)
// plus a decision log of every L1 cell (key, correct, total) proving
// derivability. The learner's store is discarded after emission; the NEC
// driver imports only the frozen tables, consulted ONLY at tp=0.
//
// Pure Zag. Zero RNG. Deterministic.
//
// Usage: learn_schema_v3c <diet.tsv> <schema_kc.zag> <kc_decisions.tsv>

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")

fn prov_ok(prov:[]u8)i32 {
    if(prov.len<12){return 0;}
    let pre:[]u8=prov[0..12];
    let want:[]u8="kb-diet-v3c:";
    return dlb_streq(pre, want);
}

// ---- cell finders (linear scan; L1/L2 sparse, L3 tiny) ----
fn l1_find(ar:[]u8, ncells:i32, f1:i64, f5:i64, dep:i64)i32 {
    let i:i32=0;
    while(i<ncells){
        if(au_get64(ar, i*5)==f1 && au_get64(ar, i*5+1)==f5 && au_get64(ar, i*5+2)==dep){return i;}
        i=i+1;
    }
    return -1;
}
fn l2_find(ar:[]u8, ncells:i32, f1:i64, f5:i64)i32 {
    let i:i32=0;
    while(i<ncells){
        if(au_get64(ar, i*4)==f1 && au_get64(ar, i*4+1)==f5){return i;}
        i=i+1;
    }
    return -1;
}
fn l3_find(ar:[]u8, ncells:i32, dep:i64)i32 {
    let i:i32=0;
    while(i<ncells){
        if(au_get64(ar, i*3)==dep){return i;}
        i=i+1;
    }
    return -1;
}
fn rate_mil(corr:i64, tot:i64)i64 {
    return (corr*1000000+tot/2)/tot;
}

// insertion sort by (f1,f5,dep) key; slot count s per cell
fn sort_cells(ar:[]u8, ncells:i32, s:i32)i32 {
    let i:i32=1;
    while(i<ncells){
        let j:i32=i;
        while(j>0){
            let a0:i64=au_get64(ar, (j-1)*s);
            let a1:i64=au_get64(ar, (j-1)*s+1);
            let a2:i64=0;
            if(s==5){a2=au_get64(ar, (j-1)*s+2);}
            let b0:i64=au_get64(ar, j*s);
            let b1:i64=au_get64(ar, j*s+1);
            let b2:i64=0;
            if(s==5){b2=au_get64(ar, j*s+2);}
            let ka:i64=a0*1000000+a1*1000+a2;
            let kb:i64=b0*1000000+b1*1000+b2;
            if(ka<=kb){j=0;}
            else {
                let k:i32=0;
                while(k<s){
                    let t:i64=au_get64(ar, (j-1)*s+k);
                    au_put64(ar, (j-1)*s+k, au_get64(ar, j*s+k));
                    au_put64(ar, j*s+k, t);
                    k=k+1;
                }
                j=j-1;
            }
        }
        i=i+1;
    }
    return 0;
}

fn emit_head(res:*DOut, nrows:i64, nl1:i32, nl2:i32, nl3:i32, l4rate:i64)void {
    dout_str(res, "// schema_kc.zag — FROZEN K-C learned schema (PREREG_NCAL_V3C_B13FIX_FROZEN.md §3.1).\n");
    dout_str(res, "// Generated by learn_schema_v3c.zag from kb_diet_v3c.tsv; DO NOT EDIT.\n");
    dout_str(res, "// Values are millionths; consulted ONLY at tp=0 (first observation).\n");
    dout_str(res, "// Diet rows: ");
    dout_i64(res, nrows);
    dout_str(res, ". L1 cells: ");
    dout_i64(res, nl1 as i64);
    dout_str(res, ", L2 cells: ");
    dout_i64(res, nl2 as i64);
    dout_str(res, ", L3 cells: ");
    dout_i64(res, nl3 as i64);
    dout_str(res, ", L4 n: 4467, L4 rate: ");
    dout_i64(res, l4rate);
    dout_str(res, ".\n");
    dout_str(res, "// kc_lookup walks L1->L2->L3->L4 (fixed order); first level with total >= min_n wins.\n");
}

fn learn(diet:[]u8, table_path:[]u8, dec_path:[]u8)i32 {
    let buf_bytes:i64=2*1024*1024;
    let ibuf:[]u8=nio_alloc(buf_bytes);
    if(ibuf.len==0){return 101;}
    let nr:i64=dlb_read_file(diet, ibuf);
    if(nr<0){nio_free(ibuf);return 102;}
    let n:i32=nr as i32;

    // learner's private evidence store
    let l1:[]u8=nio_alloc(4500*5*8);
    let l2:[]u8=nio_alloc(4500*4*8);
    let l3:[]u8=nio_alloc(128*3*8);
    if(l1.len==0 || l2.len==0 || l3.len==0){nio_free(ibuf);return 103;}
    let n1:i32=0; let n2:i32=0; let n3:i32=0;
    let l4c:i64=0; let l4t:i64=0;

    let pos:i32=0;
    let ok:i32=1;
    let nrows:i64=0;
    while(pos<n && ok==1){
        let e:i32=pos;
        while(e<n && ibuf[e]!=10){e=e+1;}
        if(e>pos){
            let c0s:i32=pos; let c0e:i32=pos;
            let c1s:i32=0; let c1e:i32=0;
            let c2s:i32=0; let c2e:i32=0;
            let c3s:i32=0; let c3e:i32=0;
            let c4s:i32=0; let c4e:i32=0;
            let c5s:i32=0; let c5e:i32=0;
            let col:i32=0;
            let k:i32=pos;
            while(k<e){
                if(ibuf[k]==9){
                    if(col==0){c0e=k; c1s=k+1;}
                    else if(col==1){c1e=k; c2s=k+1;}
                    else if(col==2){c2e=k; c3s=k+1;}
                    else if(col==3){c3e=k; c4s=k+1;}
                    else if(col==4){c4e=k; c5s=k+1;}
                    col=col+1;
                }
                k=k+1;
            }
            c5e=e;
            if(col==5){
                let f1v:i64=dlb_atoi(ibuf[c1s..c1e]) as i64;
                let f5v:i64=dlb_atoi(ibuf[c2s..c2e]) as i64;
                let depv:i64=dlb_atoi(ibuf[c3s..c3e]) as i64;
                let corr:i64=dlb_atoi(ibuf[c4s..c4e]) as i64;
                let prov:[]u8=ibuf[c5s..c5e];
                // deliberate gate: unprovenanced evidence is rejected, hard
                if(prov_ok(prov)!=1){ok=0;}
                else if(corr!=0 && corr!=1){ok=0;}
                else {
                    // L1
                    let i1:i32=l1_find(l1, n1, f1v, f5v, depv);
                    if(i1<0){
                        if(n1>=4467){ok=0;}
                        else {
                            i1=n1;
                            au_put64(l1, i1*5, f1v);
                            au_put64(l1, i1*5+1, f5v);
                            au_put64(l1, i1*5+2, depv);
                            au_put64(l1, i1*5+3, 0);
                            au_put64(l1, i1*5+4, 0);
                            n1=n1+1;
                        }
                    }
                    if(ok==1){
                        au_put64(l1, i1*5+3, au_get64(l1, i1*5+3)+corr);
                        au_put64(l1, i1*5+4, au_get64(l1, i1*5+4)+1);
                        // L2
                        let i2:i32=l2_find(l2, n2, f1v, f5v);
                        if(i2<0){
                            if(n2>=4467){ok=0;}
                            else {
                                i2=n2;
                                au_put64(l2, i2*4, f1v);
                                au_put64(l2, i2*4+1, f5v);
                                au_put64(l2, i2*4+2, 0);
                                au_put64(l2, i2*4+3, 0);
                                n2=n2+1;
                            }
                        }
                        if(ok==1){
                            au_put64(l2, i2*4+2, au_get64(l2, i2*4+2)+corr);
                            au_put64(l2, i2*4+3, au_get64(l2, i2*4+3)+1);
                            // L3
                            let i3:i32=l3_find(l3, n3, depv);
                            if(i3<0){
                                if(n3>=127){ok=0;}
                                else {
                                    i3=n3;
                                    au_put64(l3, i3*3, depv);
                                    au_put64(l3, i3*3+1, 0);
                                    au_put64(l3, i3*3+2, 0);
                                    n3=n3+1;
                                }
                            }
                            if(ok==1){
                                au_put64(l3, i3*3+1, au_get64(l3, i3*3+1)+corr);
                                au_put64(l3, i3*3+2, au_get64(l3, i3*3+2)+1);
                                // L4
                                l4c=l4c+corr;
                                l4t=l4t+1;
                                nrows=nrows+1;
                            }
                        }
                    }
                }
            } else { ok=0; }
        }
        pos=e+1;
    }
    if(ok!=1){nio_free(ibuf);nio_free(l1);nio_free(l2);nio_free(l3);return 201;}
    if(nrows!=4467){nio_free(ibuf);nio_free(l1);nio_free(l2);nio_free(l3);return 202;}
    let l4rate:i64=rate_mil(l4c, l4t);

    // sort cells for a stable, sorted emission
    sort_cells(l1, n1, 5);
    sort_cells(l2, n2, 4);
    sort_cells(l3, n3, 3);

    // ---- emit schema_kc.zag ----
    let tres:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    let dres:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    if(dout_init(&tres, 131072)!=0 || dout_init(&dres, 131072)!=0){
        nio_free(ibuf);nio_free(l1);nio_free(l2);nio_free(l3);
        return 104;
    }
    emit_head(&tres, nrows, n1, n2, n3, l4rate);

    dout_str(&tres, "fn kc_l1(f1:i32, f5:i32, dep:i32, tot:*i64, rate:*i64)i32 {\n");
    let i:i32=0;
    while(i<n1){
        let f1:i64=au_get64(l1, i*5);
        let f5:i64=au_get64(l1, i*5+1);
        let dep:i64=au_get64(l1, i*5+2);
        let cc:i64=au_get64(l1, i*5+3);
        let tt:i64=au_get64(l1, i*5+4);
        dout_str(&tres, "    if(f1==");
        dout_i64(&tres, f1);
        dout_str(&tres, " && f5==");
        dout_i64(&tres, f5);
        dout_str(&tres, " && dep==");
        dout_i64(&tres, dep);
        dout_str(&tres, "){tot.*=");
        dout_i64(&tres, tt);
        dout_str(&tres, ";rate.*=");
        dout_i64(&tres, rate_mil(cc, tt));
        dout_str(&tres, ";return 1;}\n");
        i=i+1;
    }
    dout_str(&tres, "    return 0;\n");
    dout_str(&tres, "}\n");

    dout_str(&tres, "fn kc_l2(f1:i32, f5:i32, tot:*i64, rate:*i64)i32 {\n");
    i=0;
    while(i<n2){
        let f1:i64=au_get64(l2, i*4);
        let f5:i64=au_get64(l2, i*4+1);
        let cc:i64=au_get64(l2, i*4+2);
        let tt:i64=au_get64(l2, i*4+3);
        dout_str(&tres, "    if(f1==");
        dout_i64(&tres, f1);
        dout_str(&tres, " && f5==");
        dout_i64(&tres, f5);
        dout_str(&tres, "){tot.*=");
        dout_i64(&tres, tt);
        dout_str(&tres, ";rate.*=");
        dout_i64(&tres, rate_mil(cc, tt));
        dout_str(&tres, ";return 1;}\n");
        i=i+1;
    }
    dout_str(&tres, "    return 0;\n");
    dout_str(&tres, "}\n");

    dout_str(&tres, "fn kc_l3(dep:i32, tot:*i64, rate:*i64)i32 {\n");
    i=0;
    while(i<n3){
        let dep:i64=au_get64(l3, i*3);
        let cc:i64=au_get64(l3, i*3+1);
        let tt:i64=au_get64(l3, i*3+2);
        dout_str(&tres, "    if(dep==");
        dout_i64(&tres, dep);
        dout_str(&tres, "){tot.*=");
        dout_i64(&tres, tt);
        dout_str(&tres, ";rate.*=");
        dout_i64(&tres, rate_mil(cc, tt));
        dout_str(&tres, ";return 1;}\n");
        i=i+1;
    }
    dout_str(&tres, "    return 0;\n");
    dout_str(&tres, "}\n");

    dout_str(&tres, "fn kc_lookup(f1:i32, f5:i32, dep:i32, min_n:i64, rate:*i64, level:*i32, celln:*i64)void {\n");
    dout_str(&tres, "    let t:i64=0;\n");
    dout_str(&tres, "    let r:i64=0;\n");
    dout_str(&tres, "    if(kc_l1(f1, f5, dep, &t, &r)==1){\n");
    dout_str(&tres, "        if(t>=min_n){rate.*=r;level.*=1;celln.*=t;return;}\n");
    dout_str(&tres, "    }\n");
    dout_str(&tres, "    if(kc_l2(f1, f5, &t, &r)==1){\n");
    dout_str(&tres, "        if(t>=min_n){rate.*=r;level.*=2;celln.*=t;return;}\n");
    dout_str(&tres, "    }\n");
    dout_str(&tres, "    if(kc_l3(dep, &t, &r)==1){\n");
    dout_str(&tres, "        if(t>=min_n){rate.*=r;level.*=3;celln.*=t;return;}\n");
    dout_str(&tres, "    }\n");
    dout_str(&tres, "    rate.*=");
    dout_i64(&tres, l4rate);
    dout_str(&tres, ";level.*=4;celln.*=4467;\n");
    dout_str(&tres, "}\n");

    // ---- decision log: every L1 cell (key, correct, total), then L2/L3/L4 ----
    dout_str(&dres, "level\tf1\tf5\tdepth\tcorrect\ttotal\trate_mil\tprov\n");
    i=0;
    while(i<n1){
        let f1:i64=au_get64(l1, i*5);
        let f5:i64=au_get64(l1, i*5+1);
        let dep:i64=au_get64(l1, i*5+2);
        let cc:i64=au_get64(l1, i*5+3);
        let tt:i64=au_get64(l1, i*5+4);
        dout_str(&dres, "L1\t");
        dout_i64(&dres, f1); dout_byte(&dres, 9);
        dout_i64(&dres, f5); dout_byte(&dres, 9);
        dout_i64(&dres, dep); dout_byte(&dres, 9);
        dout_i64(&dres, cc); dout_byte(&dres, 9);
        dout_i64(&dres, tt); dout_byte(&dres, 9);
        dout_i64(&dres, rate_mil(cc, tt)); dout_byte(&dres, 9);
        dout_str(&dres, "kb-diet-v3c:cell:L1\n");
        i=i+1;
    }
    i=0;
    while(i<n2){
        let f1:i64=au_get64(l2, i*4);
        let f5:i64=au_get64(l2, i*4+1);
        let cc:i64=au_get64(l2, i*4+2);
        let tt:i64=au_get64(l2, i*4+3);
        dout_str(&dres, "L2\t");
        dout_i64(&dres, f1); dout_byte(&dres, 9);
        dout_i64(&dres, f5); dout_byte(&dres, 9);
        dout_str(&dres, "-\t");
        dout_i64(&dres, cc); dout_byte(&dres, 9);
        dout_i64(&dres, tt); dout_byte(&dres, 9);
        dout_i64(&dres, rate_mil(cc, tt)); dout_byte(&dres, 9);
        dout_str(&dres, "kb-diet-v3c:cell:L2\n");
        i=i+1;
    }
    i=0;
    while(i<n3){
        let dep:i64=au_get64(l3, i*3);
        let cc:i64=au_get64(l3, i*3+1);
        let tt:i64=au_get64(l3, i*3+2);
        dout_str(&dres, "L3\t-\t-\t");
        dout_i64(&dres, dep); dout_byte(&dres, 9);
        dout_i64(&dres, cc); dout_byte(&dres, 9);
        dout_i64(&dres, tt); dout_byte(&dres, 9);
        dout_i64(&dres, rate_mil(cc, tt)); dout_byte(&dres, 9);
        dout_str(&dres, "kb-diet-v3c:cell:L3\n");
        i=i+1;
    }
    dout_str(&dres, "L4\t-\t-\t-\t");
    dout_i64(&dres, l4c); dout_byte(&dres, 9);
    dout_i64(&dres, l4t); dout_byte(&dres, 9);
    dout_i64(&dres, l4rate); dout_byte(&dres, 9);
    dout_str(&dres, "kb-diet-v3c:cell:L4\n");

    let w1:i64=dlb_write_file(table_path, dout_bytes(&tres), tres.n);
    let w2:i64=dlb_write_file(dec_path, dout_bytes(&dres), dres.n);
    nio_free(ibuf);
    nio_free(l1); nio_free(l2); nio_free(l3);
    dout_free(&tres);
    dout_free(&dres);
    if(tres.err!=0 || dres.err!=0){return 105;}
    if(w1<0 || w2<0){return 107;}
    _zag_print("rows=");
    _zag_print(dlb_i64s(nrows));
    _zag_print(" L1cells=");
    _zag_print(dlb_i64s(n1 as i64));
    _zag_print(" L2cells=");
    _zag_print(dlb_i64s(n2 as i64));
    _zag_print(" L3cells=");
    _zag_print(dlb_i64s(n3 as i64));
    _zag_print(" L4rate=");
    _zag_println(dlb_i64s(l4rate));
    return 0;
}

fn main()i32 {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    let a3:[]u8=_zag_arg(3);
    if(a1.len==0 || a2.len==0 || a3.len==0){
        _zag_println("usage: learn_schema_v3c <diet.tsv> <schema_kc.zag> <kc_decisions.tsv>");
        return 64;
    }
    return learn(a1, a2, a3);
}

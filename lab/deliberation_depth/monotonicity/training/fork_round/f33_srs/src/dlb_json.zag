// dlb_json.zag — minimal JSON parser for H5 deliberation-harness item lines.
//
// Supported subset (documented in ITEM_FORMAT.md): objects, arrays, strings,
// signed integers. Strings must NOT contain '"' or '\' (no escape processing
// in Phase 1); control chars rejected. Anything else is a parse error.
// The parser fills an Item struct directly (no general value tree).
// Pure Zag, deterministic, no allocation except caller-owned arenas.

struct JP { s:[]u8, p:i32, err:i32 }

fn jp_ws(j:*JP)void {
    let s:[]u8=j.*.s;let n:i32=s.len;let p:i32=j.*.p;
    while(p<n){
        let c:u8=s[p];
        if(c==32 || c==9 || c==10 || c==13){p=p+1;}else{break;}
    }
    j.*.p=p;
}
fn jp_err(j:*JP)i32 { return j.*.err; }
fn jp_pos(j:*JP)i32 { return j.*.p; }
fn jp_slen(j:*JP)i32 { let s:[]u8=j.*.s;return s.len; }
fn jp_peek(j:*JP)u8 {
    jp_ws(j);
    let s:[]u8=j.*.s;let p:i32=j.*.p;
    if(p>=s.len){return 0;}
    return s[p];
}
// slice of j.*.s (routes the ZNC-004 local-struct slice-alias rule through a param)
fn jp_slice_at(j:*JP,off:i32,len:i32)[]u8 {
    let s:[]u8=j.*.s;
    return s[off..off+len];
}
fn jp_eat(j:*JP,c:u8)i32 {
    jp_ws(j);
    let s:[]u8=j.*.s;let p:i32=j.*.p;
    if(p<s.len && s[p]==c){j.*.p=p+1;return 1;}
    j.*.err=1;
    return 0;
}
// string -> packed (off<<32)|len, or -1 (sets err). No escapes allowed.
fn jp_string(j:*JP)i64 {
    jp_ws(j);
    let s:[]u8=j.*.s;let p:i32=j.*.p;
    if(p>=s.len || s[p]!=34){j.*.err=1;return -1;}
    p=p+1;
    let st:i32=p;
    while(p<s.len){
        let c:u8=s[p];
        if(c==34){j.*.p=p+1;return (((st as i64)<<32)|((p-st) as i64));}
        if(c==92 || c<32){j.*.err=1;return -1;}
        p=p+1;
    }
    j.*.err=1;
    return -1;
}
fn pk_off(pk:i64)i32 { return (pk>>32) as i32; }
fn pk_len(pk:i64)i32 { return (pk&4294967295) as i32; }
fn jp_int(j:*JP)i32 {
    jp_ws(j);
    let s:[]u8=j.*.s;let p:i32=j.*.p;let n:i32=s.len;
    let neg:i32=0;
    if(p<n && s[p]==45){neg=1;p=p+1;}
    let v:i64=0;let nd:i32=0;
    while(p<n){
        let c:u8=s[p];
        if(c<48 || c>57){break;}
        v=v*10+((c-48) as i64);nd=nd+1;p=p+1;
    }
    if(nd==0){j.*.err=1;return 0;}
    if(neg==1){v=-v;}
    j.*.p=p;
    if(v>2147483647 || v<-2147483648){j.*.err=1;return 0;}
    return v as i32;
}
fn jp_lit(j:*JP,w:[]u8)i32 {
    jp_ws(j);
    let s:[]u8=j.*.s;let p:i32=j.*.p;
    if(p+w.len>s.len){j.*.err=1;return 0;}
    if(nio_equal(s[p..p+w.len],w)==0){j.*.err=1;return 0;}
    j.*.p=p+w.len;
    return 1;
}
// skip one JSON value (used for unknown keys)
fn jp_skip(j:*JP)void {
    if(j.*.err==1){return;}
    let c:u8=jp_peek(j);
    if(c==34){let pk:i64=jp_string(j);return;}
    if(c==123){
        jp_eat(j,123);
        if(jp_peek(j)==125){jp_eat(j,125);return;}
        let done:i32=0;
        while(done==0 && j.*.err==0){
            let k:i64=jp_string(j);
            if(k<0){return;}
            jp_eat(j,58);
            jp_skip(j);
            let cc:u8=jp_peek(j);
            if(cc==44){jp_eat(j,44);}
            if(cc==125){jp_eat(j,125);done=1;}
            if(cc!=44 && cc!=125){j.*.err=1;}
        }
        return;
    }
    if(c==91){
        jp_eat(j,91);
        if(jp_peek(j)==93){jp_eat(j,93);return;}
        let done:i32=0;
        while(done==0 && j.*.err==0){
            jp_skip(j);
            let cc:u8=jp_peek(j);
            if(cc==44){jp_eat(j,44);}
            if(cc==93){jp_eat(j,93);done=1;}
            if(cc!=44 && cc!=93){j.*.err=1;}
        }
        return;
    }
    if((c>=48 && c<=57) || c==45){let v:i32=jp_int(j);return;}
    if(c==116){jp_lit(j,"true");return;}
    if(c==102){jp_lit(j,"false");return;}
    if(c==110){jp_lit(j,"null");return;}
    j.*.err=1;
}

// ---------------- item domain ----------------
struct Item {
    line:[]u8,
    id_off:i32, id_len:i32,
    tt_off:i32, tt_len:i32,
    gt_off:i32, gt_len:i32,
    nh:i32, ne:i32,
    hid:[]u8, eid:[]u8, evns:[]u8, evna:[]u8, sup:[]u8, att:[]u8,
    maxh:i32, maxe:i32, maxl:i32
}
fn dj_id(it:*Item)[]u8 {
    let l:[]u8=it.*.line;
    return l[it.*.id_off..it.*.id_off+it.*.id_len];
}
fn dj_tt(it:*Item)[]u8 {
    let l:[]u8=it.*.line;
    return l[it.*.tt_off..it.*.tt_off+it.*.tt_len];
}
fn dj_gt(it:*Item)[]u8 {
    let l:[]u8=it.*.line;
    return l[it.*.gt_off..it.*.gt_off+it.*.gt_len];
}
fn dj_hid(it:*Item,h:i32)[]u8 {
    let l:[]u8=it.*.line;let a:[]u8=it.*.hid;
    let off:i32=au_get32(a,h*2);let ln:i32=au_get32(a,h*2+1);
    return l[off..off+ln];
}
fn dj_eid(it:*Item,e:i32)[]u8 {
    let l:[]u8=it.*.line;let a:[]u8=it.*.eid;
    let off:i32=au_get32(a,e*2);let ln:i32=au_get32(a,e*2+1);
    return l[off..off+ln];
}
fn dj_hlookup(it:*Item,name:[]u8)i32 {
    let i:i32=0;
    while(i<it.*.nh){
        if(dlb_streq(dj_hid(it,i),name)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn dj_add_hyp(it:*Item,pk:i64)i32 {
    let off:i32=pk_off(pk);let ln:i32=pk_len(pk);
    let l:[]u8=it.*.line;
    let name:[]u8=l[off..off+ln];
    if(dlb_id_ok(name)==0){return -8;}
    if(dj_hlookup(it,name)>=0){return -2;}
    if(it.*.nh>=it.*.maxh){return -3;}
    let a:[]u8=it.*.hid;let h:i32=it.*.nh;
    au_put32(a,h*2,off);au_put32(a,h*2+1,ln);
    it.*.nh=h+1;
    return 0;
}
fn dj_add_ev(it:*Item,pk:i64)i32 {
    let off:i32=pk_off(pk);let ln:i32=pk_len(pk);
    let l:[]u8=it.*.line;
    let name:[]u8=l[off..off+ln];
    if(dlb_id_ok(name)==0){return -8;}
    let i:i32=0;
    while(i<it.*.ne){
        if(dlb_streq(dj_eid(it,i),name)==1){return -4;}
        i=i+1;
    }
    if(it.*.ne>=it.*.maxe){return -5;}
    let a:[]u8=it.*.eid;let e:i32=it.*.ne;
    au_put32(a,e*2,off);au_put32(a,e*2+1,ln);
    au_put32(it.*.evns,e,0);au_put32(it.*.evna,e,0);
    it.*.ne=e+1;
    return e;
}
// is_att: 0=supports, 1=attacks. weight in fixed-point thousandths.
fn dj_add_link(it:*Item,e:i32,h:i32,w:i32,is_att:i32)i32 {
    let cnt:[]u8=it.*.evna;
    let pool:[]u8=it.*.att;
    if(is_att==0){cnt=it.*.evns;pool=it.*.sup;}
    let n:i32=au_get32(cnt,e);
    if(n>=it.*.maxl){return -7;}
    let base:i32=(e*it.*.maxl+n)*2;
    au_put32(pool,base,h);au_put32(pool,base+1,w);
    au_put32(cnt,e,n+1);
    return 0;
}
fn dj_sup_n(it:*Item,e:i32)i32 { return au_get32(it.*.evns,e); }
fn dj_att_n(it:*Item,e:i32)i32 { return au_get32(it.*.evna,e); }
fn dj_sup_h(it:*Item,e:i32,k:i32)i32 { return au_get32(it.*.sup,(e*it.*.maxl+k)*2); }
fn dj_sup_w(it:*Item,e:i32,k:i32)i32 { return au_get32(it.*.sup,(e*it.*.maxl+k)*2+1); }
fn dj_att_h(it:*Item,e:i32,k:i32)i32 { return au_get32(it.*.att,(e*it.*.maxl+k)*2); }
fn dj_att_w(it:*Item,e:i32,k:i32)i32 { return au_get32(it.*.att,(e*it.*.maxl+k)*2+1); }

fn dj_parse_links(j:*JP,it:*Item,e:i32,is_att:i32)i32 {
    if(jp_eat(j,123)==0){return -1;}
    if(jp_peek(j)==125){jp_eat(j,125);return 0;}
    let done:i32=0;
    while(done==0){
        let pk:i64=jp_string(j);
        if(pk<0){return -1;}
        let name:[]u8=jp_slice_at(j,pk_off(pk),pk_len(pk));
        let h:i32=dj_hlookup(it,name);
        if(h<0){return -6;}
        if(jp_eat(j,58)==0){return -1;}
        let w:i32=jp_int(j);
        if(jp_err(j)==1){return -1;}
        let rc:i32=dj_add_link(it,e,h,w,is_att);
        if(rc!=0){return rc;}
        let cc:u8=jp_peek(j);
        if(cc==44){jp_eat(j,44);}
        if(cc==125){jp_eat(j,125);done=1;}
        if(cc!=44 && cc!=125){return -1;}
    }
    return 0;
}
fn dj_parse_evidence(j:*JP,it:*Item)i32 {
    if(jp_eat(j,91)==0){return -1;}
    if(jp_peek(j)==93){jp_eat(j,93);return 0;}
    let done:i32=0;
    while(done==0){
        if(jp_eat(j,123)==0){return -1;}
        let ev:i32=-1;
        let fdone:i32=0;
        if(jp_peek(j)==125){return -1;}
        while(fdone==0){
            let pk:i64=jp_string(j);
            if(pk<0){return -1;}
            let kn:[]u8=jp_slice_at(j,pk_off(pk),pk_len(pk));
            if(jp_eat(j,58)==0){return -1;}
            if(dlb_streq(kn,"id")==1){
                let vk:i64=jp_string(j);
                if(vk<0){return -1;}
                ev=dj_add_ev(it,vk);
                if(ev<0){return ev;}
            }
            if(dlb_streq(kn,"supports")==1){
                if(ev<0){return -1;}
                let rc:i32=dj_parse_links(j,it,ev,0);
                if(rc!=0){return rc;}
            }
            if(dlb_streq(kn,"attacks")==1){
                if(ev<0){return -1;}
                let rc:i32=dj_parse_links(j,it,ev,1);
                if(rc!=0){return rc;}
            }
            if(dlb_streq(kn,"id")==0 && dlb_streq(kn,"supports")==0 && dlb_streq(kn,"attacks")==0){
                jp_skip(j);
            }
            if(jp_err(j)==1){return -1;}
            let cc:u8=jp_peek(j);
            if(cc==44){jp_eat(j,44);}
            if(cc==125){jp_eat(j,125);fdone=1;}
            if(cc!=44 && cc!=125){return -1;}
        }
        if(ev<0){return -1;}
        let cc2:u8=jp_peek(j);
        if(cc2==44){jp_eat(j,44);}
        if(cc2==93){jp_eat(j,93);done=1;}
        if(cc2!=44 && cc2!=93){return -1;}
    }
    return 0;
}
fn dj_parse_hyps(j:*JP,it:*Item)i32 {
    if(jp_eat(j,91)==0){return -1;}
    if(jp_peek(j)==93){jp_eat(j,93);return 0;}
    let done:i32=0;
    while(done==0){
        if(jp_eat(j,123)==0){return -1;}
        if(jp_peek(j)==125){return -1;}
        let fdone:i32=0;
        while(fdone==0){
            let pk:i64=jp_string(j);
            if(pk<0){return -1;}
            let kn:[]u8=jp_slice_at(j,pk_off(pk),pk_len(pk));
            if(jp_eat(j,58)==0){return -1;}
            if(dlb_streq(kn,"id")==1){
                let vk:i64=jp_string(j);
                if(vk<0){return -1;}
                let rc:i32=dj_add_hyp(it,vk);
                if(rc!=0){return rc;}
            }
            if(dlb_streq(kn,"id")==0){jp_skip(j);}
            if(jp_err(j)==1){return -1;}
            let cc:u8=jp_peek(j);
            if(cc==44){jp_eat(j,44);}
            if(cc==125){jp_eat(j,125);fdone=1;}
            if(cc!=44 && cc!=125){return -1;}
        }
        let cc2:u8=jp_peek(j);
        if(cc2==44){jp_eat(j,44);}
        if(cc2==93){jp_eat(j,93);done=1;}
        if(cc2!=44 && cc2!=93){return -1;}
    }
    return 0;
}
fn dj_parse_input(j:*JP,it:*Item)i32 {
    if(jp_eat(j,123)==0){return -1;}
    if(jp_peek(j)==125){jp_eat(j,125);return 0;}
    let done:i32=0;
    while(done==0){
        let pk:i64=jp_string(j);
        if(pk<0){return -1;}
        let kn:[]u8=jp_slice_at(j,pk_off(pk),pk_len(pk));
        if(jp_eat(j,58)==0){return -1;}
        if(dlb_streq(kn,"hypotheses")==1){
            let rc:i32=dj_parse_hyps(j,it);
            if(rc!=0){return rc;}
        }
        if(dlb_streq(kn,"evidence")==1){
            let rc:i32=dj_parse_evidence(j,it);
            if(rc!=0){return rc;}
        }
        if(dlb_streq(kn,"hypotheses")==0 && dlb_streq(kn,"evidence")==0){jp_skip(j);}
        if(jp_err(j)==1){return -1;}
        let cc:u8=jp_peek(j);
        if(cc==44){jp_eat(j,44);}
        if(cc==125){jp_eat(j,125);done=1;}
        if(cc!=44 && cc!=125){return -1;}
    }
    return 0;
}

// Parse one item line. Returns 0 on success, negative dj error code otherwise.
// Error codes: -1 JSON syntax, -2 dup hypothesis id, -3 too many hypotheses,
// -4 dup evidence id, -5 too many evidence, -6 link references unknown
// hypothesis, -7 too many links, -8 bad id characters, -9 bad task_type,
// -10 ground_truth not a hypothesis, -11 no hypotheses, -12 trailing garbage,
// -13 missing required field.
fn dj_parse_item(it:*Item,line:[]u8,maxh:i32,maxe:i32,maxl:i32)i32 {
    let j:JP=JP{.s:line,.p:0,.err:0};
    it.*.line=line;
    it.*.id_off=-1;it.*.id_len=0;
    it.*.tt_off=-1;it.*.tt_len=0;
    it.*.gt_off=-1;it.*.gt_len=0;
    it.*.nh=0;it.*.ne=0;
    it.*.maxh=maxh;it.*.maxe=maxe;it.*.maxl=maxl;
    if(jp_eat(&j,123)==0){return -1;}
    if(jp_peek(&j)==125){return -13;}
    let done:i32=0;
    while(done==0){
        let pk:i64=jp_string(&j);
        if(pk<0){return -1;}
        let kn:[]u8=jp_slice_at(&j,pk_off(pk),pk_len(pk));
        if(jp_eat(&j,58)==0){return -1;}
        if(dlb_streq(kn,"id")==1){
            let vk:i64=jp_string(&j);
            if(vk<0){return -1;}
            let vs:[]u8=jp_slice_at(&j,pk_off(vk),pk_len(vk));
            if(dlb_id_ok(vs)==0){return -8;}
            it.*.id_off=pk_off(vk);it.*.id_len=pk_len(vk);
        }
        if(dlb_streq(kn,"task_type")==1){
            let vk:i64=jp_string(&j);
            if(vk<0){return -1;}
            let vs:[]u8=jp_slice_at(&j,pk_off(vk),pk_len(vk));
            if(dlb_streq(vs,"admit")==0 && dlb_streq(vs,"revoke")==0 && dlb_streq(vs,"logic")==0){return -9;}
            it.*.tt_off=pk_off(vk);it.*.tt_len=pk_len(vk);
        }
        if(dlb_streq(kn,"ground_truth")==1){
            let vk:i64=jp_string(&j);
            if(vk<0){return -1;}
            let vs:[]u8=jp_slice_at(&j,pk_off(vk),pk_len(vk));
            if(dlb_id_ok(vs)==0){return -8;}
            it.*.gt_off=pk_off(vk);it.*.gt_len=pk_len(vk);
        }
        if(dlb_streq(kn,"input")==1){
            let rc:i32=dj_parse_input(&j,it);
            if(rc!=0){return rc;}
        }
        if(dlb_streq(kn,"id")==0 && dlb_streq(kn,"task_type")==0 && dlb_streq(kn,"ground_truth")==0 && dlb_streq(kn,"input")==0){
            jp_skip(&j);
        }
        if(jp_err(&j)==1){return -1;}
        let cc:u8=jp_peek(&j);
        if(cc==44){jp_eat(&j,44);}
        if(cc==125){jp_eat(&j,125);done=1;}
        if(cc!=44 && cc!=125){return -1;}
    }
    if(it.*.id_off<0 || it.*.tt_off<0 || it.*.gt_off<0){return -13;}
    if(it.*.nh<1){return -11;}
    if(dj_hlookup(it,dj_gt(it))<0){return -10;}
    jp_ws(&j);
    if(jp_err(&j)==1){return -1;}
    if(jp_pos(&j)!=jp_slen(&j)){return -12;}
    return 0;
}

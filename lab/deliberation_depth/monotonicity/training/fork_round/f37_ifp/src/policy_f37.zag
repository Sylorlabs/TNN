// policy_f37.zag — F37 IFP (Interior Fixed-Point Head) evaluation driver.
//
// Runs the FROZEN harness deliberation (byte-identical dlb_*.zag copies)
// once per item to the requested depth, then applies the TRAINED F37 head:
//   release: M4 skeleton (release L_t iff L_t == L_1, else ABSTAIN;
//            confidence never changes answer/release)
//   confidence: for ladder depths [1,2,4,...,D] (D = requested depth,
//            always a power of 2 in the 37-leg battery):
//     s_d   = b + floor((w1*f1 + w2*f5 + w3*f6 + w4*max(f4,0) + w5*my)/1000)
//     Craw_d= (A_d + max(s_d,0))*1000 / (B_d + |s_d| + max(-s_d,0) + 1)
//     C_d   = min(Craw_d, C_prev - 1) if f3 newly latches
//             (prev=0,curr=1000) or f8 increases vs prev ladder depth,
//             else Craw_d
//     my    = f5 at depth 1;
//             else min(1000, max(0,f5-f5prev)*1000/max(Δf2,1)),
//             Δf2 = (d-d_prev)*1000/64
//   emit C_D.
//
// Weights/bias/stratum counts baked in as constants via mt_f37_params.zag
// (generated by train_f37.zag — never hand-edited).
//
// Usage: policy_f37 <items.jsonl> <depth> <gate01> <results.tsv>
// gate01 must be 0 (F37 is conf-head-only; no gate in the fork spec).
//
// Per-item TSV record: identical columns to mech.zag:
//   id \t depth \t t \t rounds \t consumed \t ne \t release \t correct
//   \t conf \t leader_idx \t cert
//
// Pure Zag. Zero RNG. []u8 arenas + LE accessors. No fn named zalloc.

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")
@import("mt_f37_params.zag")

fn pf_clamp(v:i64,lo:i64,hi:i64)i64 {
    if(v<lo){return lo;}
    if(v>hi){return hi;}
    return v;
}
fn pf_abs(a:i64)i64 {
    if(a<0){return -a;}
    return a;
}
fn pf_max(a:i64,b:i64)i64 {
    if(a>b){return a;}
    return b;
}
fn pf_min(a:i64,b:i64)i64 {
    if(a<b){return a;}
    return b;
}
// mathematical floor division for b>0
fn pf_fdiv(a:i64,b:i64)i64 {
    if(b<=0){return 0;}
    if(a>=0){return a/b;}
    return -(((-a)+b-1)/b);
}
// depth value -> d_idx 0..6 ; -1 unknown
fn pf_didx(d:i32)i32 {
    if(d==1){return 0;}
    if(d==2){return 1;}
    if(d==4){return 2;}
    if(d==8){return 3;}
    if(d==16){return 4;}
    if(d==32){return 5;}
    if(d==64){return 6;}
    return -1;
}

// §4 features needed by F37 (index-level only), at round t.
// out: f1,f3,f4,f5,f6,f8 (thousandths / 0/1000 flags)
fn pf_features(st:*DSt,it:*Item,t:i32,o1:*i64,o3:*i64,o4:*i64,o5:*i64,o6:*i64,o8:*i64)void {
    let mt:i64=au_get64(st.*.hist_m,t);
    o1.*=pf_clamp(mt,0,1000);
    let l1:i32=au_get32(st.*.hist_l,1);
    let ch:i64=0;
    let maxdrop:i64=0;
    let mprev:i64=au_get64(st.*.hist_m,1);
    let r:i32=1;
    while(r<=t){
        if(au_get32(st.*.hist_l,r)!=l1){ch=1000;}
        let mr:i64=au_get64(st.*.hist_m,r);
        let drop:i64=mprev-mr;
        if(drop>maxdrop){maxdrop=drop;}
        mprev=mr;
        r=r+1;
    }
    o3.*=ch;
    let m_tm1:i64=au_get64(st.*.hist_m,1);
    if(t>1){m_tm1=au_get64(st.*.hist_m,t-1);}
    o4.*=pf_clamp(mt-m_tm1,-1000,1000);
    o5.*=0;
    if(it.*.ne>0){o5.*=(st.*.consumed as i64)*1000/(it.*.ne as i64);}
    let nalive:i32=dlb_nalive(st,it.*.nh);
    o6.*=(nalive as i64)*1000/(it.*.nh as i64);
    o8.*=pf_clamp(maxdrop,0,1000);
}

// F37 head confidence at ladder depth d (d_idx), given features and my.
// Returns chain C (theater rule applied vs prev).
fn pf_chainC(didx:i32,f1:i64,f5:i64,f6:i64,f4:i64,my:i64,f3:i64,f8:i64,
             has_prev:i32,p_f3:i64,p_f8:i64,p_C:i64)i64 {
    let f4p:i64=f4;
    if(f4p<0){f4p=0;}
    let s:i64=mt_b()+pf_fdiv(mt_w0()*f1+mt_w1()*f5+mt_w2()*f6+mt_w3()*f4p+mt_w4()*my,1000);
    let sp:i64=pf_max(s,0);
    let extra:i64=s;
    if(s<0){extra=-2*s;}
    let Ad:i64=1;
    let Bd:i64=2;
    if(didx==0){Ad=mt_A0();Bd=mt_B0();}
    if(didx==1){Ad=mt_A1();Bd=mt_B1();}
    if(didx==2){Ad=mt_A2();Bd=mt_B2();}
    if(didx==3){Ad=mt_A3();Bd=mt_B3();}
    if(didx==4){Ad=mt_A4();Bd=mt_B4();}
    if(didx==5){Ad=mt_A5();Bd=mt_B5();}
    if(didx==6){Ad=mt_A6();Bd=mt_B6();}
    let raw:i64=(Ad+sp)*1000/(Bd+extra+1);
    let chain:i64=raw;
    if(has_prev==1){
        let latch:i32=0;
        if(f3==1000 && p_f3==0){latch=1;}
        if(latch==1 || f8>p_f8){
            chain=raw;
            if(p_C-1<raw){chain=p_C-1;}
        }
    }
    return chain;
}

fn pf_cert(rcode:i32,res:*DOut)void {
    if(rcode==0){dout_str(res,"leader-changed");}
    if(rcode==1){dout_str(res,"f37-ifp");}
}

fn pf_item_alloc(it:*Item)i32 {
    it.*.hid=nio_alloc(16*8);
    it.*.eid=nio_alloc(64*8);
    it.*.evns=nio_alloc(64*4);
    it.*.evna=nio_alloc(64*4);
    it.*.sup=nio_alloc(64*16*8);
    it.*.att=nio_alloc(64*16*8);
    if(it.*.hid.len==0 || it.*.eid.len==0){return -1;}
    return 0;
}
fn pf_item_free(it:*Item)void {
    nio_free(it.*.hid);nio_free(it.*.eid);nio_free(it.*.evns);nio_free(it.*.evna);
    nio_free(it.*.sup);nio_free(it.*.att);
}
fn pf_st_alloc(st:*DSt,hcap:i32)i32 {
    st.*.scores=nio_alloc(16*8);
    st.*.alive=nio_alloc(16);
    st.*.hist_l=nio_alloc(hcap*4);
    st.*.hist_m=nio_alloc(hcap*8);
    st.*.hist_c=nio_alloc(hcap*4);
    st.*.hcap=hcap;
    if(st.*.scores.len==0 || st.*.alive.len==0){return -1;}
    return 0;
}
fn pf_st_free(st:*DSt)void {
    nio_free(st.*.scores);nio_free(st.*.alive);nio_free(st.*.hist_l);nio_free(st.*.hist_m);nio_free(st.*.hist_c);
}

fn pf_run(items_path:[]u8,depth:i32,gate01:i32,res_path:[]u8)i32 {
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(items_path,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:depth,.deep_rounds:depth,.amin:3,.amax:64,.conf_thr:0,.stab_win:0,.eps:20,.elim_margin:900,.refute_thr:600,.evcap:64};
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(pf_item_alloc(&it)!=0){nio_free(ibuf);return 102;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.hist_c:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:68};
    if(pf_st_alloc(&st,68)!=0){pf_item_free(&it);nio_free(ibuf);return 102;}
    let res:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&res,4194304)!=0){return 102;}
    if(dout_init(&lgo,8388608)!=0){return 102;}
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return 102;}
    let ok:i32=1;
    let errs:i32=0;
    let pos:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line.len<=65536){
            let prc:i32=dj_parse_item(&it,line,16,64,16);
            if(prc!=0){errs=errs+1;}
            if(prc==0){
                let drc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
                if(drc!=0){ok=0;}
                if(drc==0){
                    let t:i32=depth;
                    if(st.rounds<t){t=st.rounds;}
                    // ladder: powers of 2 <= t, i.e. 1,2,4,...,t (t is a power of 2)
                    // compute chain C along the ladder
                    let has_prev:i32=0;
                    let p_d:i32=0;
                    let p_f5:i64=0;
                    let p_f3:i64=0;
                    let p_f8:i64=0;
                    let p_C:i64=0;
                    let Cemit:i64=0;
                    let ld:i32=1;
                    while(ld<=t){
                        let didx:i32=pf_didx(ld);
                        if(didx>=0){
                            let f1:i64=0;let f3:i64=0;let f4:i64=0;
                            let f5:i64=0;let f6:i64=0;let f8:i64=0;
                            pf_features(&st,&it,ld,&f1,&f3,&f4,&f5,&f6,&f8);
                            let my:i64=f5;
                            if(has_prev==1){
                                let df2:i64=((ld-p_d) as i64)*1000/64;
                                if(df2<1){df2=1;}
                                let inc:i64=f5-p_f5;
                                if(inc<0){inc=0;}
                                my=inc*1000/df2;
                                if(my>1000){my=1000;}
                            }
                            let chain:i64=pf_chainC(didx,f1,f5,f6,f4,my,f3,f8,
                                                   has_prev,p_f3,p_f8,p_C);
                            has_prev=1;
                            p_d=ld;
                            p_f5=f5;
                            p_f3=f3;
                            p_f8=f8;
                            p_C=chain;
                            Cemit=chain;
                        }
                        ld=ld*2;
                    }
                    // M4 release: L_t == L_1 (confidence never changes it)
                    let l1:i32=au_get32(st.hist_l,1);
                    let lt:i32=au_get32(st.hist_l,t);
                    let rel:i32=-1;
                    let rconf:i32=0;
                    let rcode:i32=0;
                    if(lt==l1){
                        rel=lt;
                        rconf=Cemit as i32;
                        rcode=1;
                    }
                    // emit (same columns as mech.zag)
                    dout_str(&res,dj_id(&it));
                    dout_byte(&res,9);
                    dout_i64(&res,depth as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,t as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,st.rounds as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,st.consumed as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,it.ne as i64);
                    dout_byte(&res,9);
                    if(rel<0){
                        dout_str(&res,"ABSTAIN:");
                        pf_cert(rcode,&res);
                    }
                    if(rel>=0){dout_str(&res,dj_hid(&it,rel));}
                    dout_byte(&res,9);
                    if(rel<0){dout_str(&res,"A");}
                    if(rel>=0){
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))==1){dout_str(&res,"1");}
                        if(dlb_streq(dj_hid(&it,rel),dj_gt(&it))!=1){dout_str(&res,"0");}
                    }
                    dout_byte(&res,9);
                    dout_i64(&res,rconf as i64);
                    dout_byte(&res,9);
                    dout_i64(&res,au_get32(st.hist_l,t) as i64);
                    dout_byte(&res,9);
                    pf_cert(rcode,&res);
                    dout_line(&res);
                    if(res.err!=0){ok=0;}
                    if(lgo.err!=0){ok=0;}
                }
            }
        }
        pos=e+1;
    }
    let wrc:i64=0;
    if(ok==1 && res.err==0){
        wrc=dlb_write_file(res_path,dout_bytes(&res),res.n);
    }
    nio_free(ibuf);
    pf_item_free(&it);
    pf_st_free(&st);
    dout_free(&res);
    dout_free(&lgo);
    lg_free(&lg);
    if(ok==0 || wrc<0){return 103;}
    return errs;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: policy_f37 <items.jsonl> <depth> <gate01> <results.tsv>");
        return 64;
    }
    let depth:i32=dlb_atoi(_zag_arg(2));
    let gate01:i32=dlb_atoi(_zag_arg(3));
    if(depth<1 || depth>64){return 64;}
    if(gate01!=0){return 64;}
    return pf_run(_zag_arg(1),depth,gate01,_zag_arg(4));
}

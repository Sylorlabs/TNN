// tqn_teacher.zag — the TQ-NOISY25 teacher: the Q1b learned teacher with
// deterministic value noise (the TQ series' "teacher QUALITY" variable).
//
// CONSTRUCTION: identical to q1b_learned_teacher_build — scaffold-and-release,
// 9 world tapes, slot-scan discovery, 3-occurrence cross-verification,
// t5_verify + t5_add; ZERO t5_plant calls. The learned teacher's 228 claims
// are all true at the end of learning.
//
// TREATMENT (the experiment): applied AFTER learning, driver-side, audited.
// Every held claim whose fact id satisfies (id mod 4 == 0) is deliberately
// revised via t5_revise to a plausible-false value built with the SAME
// construction as t5_plant_claim's false branch:
//
//     false(id) = t5_base(id) + ((t5_truth(id) - t5_base(id) + 1) % t5_mod(id))
//
// (t5_plant_claim gates this construction on t5_is_false_plant; here it is
// applied to every selected id. Per-category ranges/moduli come from the Q2
// domain code already in t5_core.zag: t5_mod/t5_base.) The false value is
// always in-category-range and always differs from truth (modulus >= 8).
//
// The noise models a teacher whose BELIEFS are ~25% wrong — not a teacher
// lying: an arm-B teacher has no suspensive hold, so it teaches what it
// holds. Selection and false values are fully deterministic — zero RNG.
//
// Pure Zag, zero RNG. Deterministic.

// Plausible-false value: the t5_plant_claim false-branch construction,
// applied to any id (not gated on the 12 prereg false plants).
fn tqn_false_claim(id:i32)i32 {
    let m:i32=t5_mod(id);
    let t:i32=t5_truth(id)-t5_base(id);
    return t5_base(id)+((t+1)%m);
}

// Noise selection: every 4th claim by id order (ids are 0..239).
fn tqn_is_noisy(id:i32)i32 {
    if(id%4==0){return 1;}
    return 0;
}

// Build the noisy teacher: the learned teacher, then the deterministic
// noise treatment. spans_out receives the teacher's learned span map
// (caller-owned, pre-init'd), as in q1b_learned_teacher_build.
fn tqn_noisy_teacher_build(spans_out:*Q1SpanMap)T5Store {
    let s:T5Store=q1b_learned_teacher_build(spans_out);
    // ---- experimental treatment: deterministic value noise ----
    let noisy_n:i32=0;
    let id:i32=0;
    while(id<240){
        let slot:i32=t5_slot_find(&s,id);
        if(slot>=0 && tqn_is_noisy(id)==1){
            let fv:i32=tqn_false_claim(id);
            t5_revise(&s,slot,fv);
            noisy_n=noisy_n+1;
        }
        id=id+1;
    }
    _zag_print("TQN_TEACHER_NOISE,");
    cl_number(noisy_n as i64);
    _zag_println("");
    return s;
}

// Count held facts whose claim differs from world truth.
fn tqn_teacher_false_claims(s:*T5Store)i32 {
    let bad:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            if(t5_claim_of(s,id)!=t5_truth(id)){bad=bad+1;}
        }
        id=id+1;
    }
    return bad;
}

// Count noisy-selected ids among the held facts (selection audit).
fn tqn_teacher_noisy_selected(s:*T5Store)i32 {
    let n:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0 && tqn_is_noisy(id)==1){n=n+1;}
        id=id+1;
    }
    return n;
}

// The noisy teacher must still HOLD every curriculum fact (presence;
// claims are noisy by design — 49 of the 192 are false).
fn tqn_teacher_holds_curriculum(s:*T5Store)i32 {
    let bad:i32=0;
    let cs:i32=0;
    while(cs<8){
        let ck:i32=0;
        while(ck<24){
            if(t5_slot_find(s,q1_slice_fact(cs,ck))<0){bad=bad+1;}
            ck=ck+1;
        }
        cs=cs+1;
    }
    return bad;
}

// Count curriculum facts whose held claim is false (the taught noise).
fn tqn_teacher_false_curriculum(s:*T5Store)i32 {
    let n:i32=0;
    let cs:i32=0;
    while(cs<8){
        let ck:i32=0;
        while(ck<24){
            let fid:i32=q1_slice_fact(cs,ck);
            if(t5_claim_of(s,fid)!=t5_truth(fid)){n=n+1;}
            ck=ck+1;
        }
        cs=cs+1;
    }
    return n;
}

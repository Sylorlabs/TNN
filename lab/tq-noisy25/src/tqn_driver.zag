// tqn_driver.zag — TQ-NOISY25 driver: the noisy teacher teaches.
//
// LEG (single): the noisy teacher (tqn_teacher.zag: the Q1b learned teacher
// with 59/228 claims deterministically revised to plausible-false values,
// tid=8 TB_TID_NOISY) teaches a fresh arm-B-style learner.
//
// THE Q1 TEACHER-LEG PATTERN, PRESERVED: teacher proposes (frozen §P wire),
// learner judges (§L deliberation: span validity, record decode, alignment,
// grounding validity/consistency, confidence honesty — q1_learner.zag is
// byte-identical to Q1b's). The instrument is frozen: the same §B.7 flaw
// schedule (flaw-first, 12 flaws/slice), the same sealed scorer, the same
// bar (>=10/12 raw exact hits per slice).
//
// THE TQ VARIABLE: in Q1/Q1b the lesson tape coincided with world truth
// (both teachers' taught claims were true), so the tape could be read as
// either. The noisy teacher is the first case where the teacher's knowledge
// and the world DIVERGE — and a teacher teaches what it holds (arm-B has
// no suspensive hold). So the lesson tape is built from the TEACHER's
// claims (tqn_build_lesson): same slot layout as q1_build_stimulus, values
// from the teacher's store. The learner's independent foundation (the
// 8-example scaffold, verified by its own observation of the world) stays
// on world truth, exactly as in Q1b.
//
// WHAT THIS MEASURES: (a) the §B.7 flaw battery per slice (does pedagogical
// judgment survive 25% teacher noise?); (b) per-claim filter/absorb
// accounting — for each of the 192 curriculum facts, whether the learner
// absorbed the teacher's false claim or filtered it (TQN_ABSORB line).
//
// Pure Zag, zero RNG. Deterministic: stdout must be byte-identical across
// reruns (N=5, verified by the run script).
@import("q1_types.zag")
@import("q1_proposal.zag")
@import("q1_tape.zag")
@import("q1_tripwire.zag")
@import("q1_flawscore.zag")
@import("t5_core.zag")
@import("q1_world.zag")
@import("q1_learner.zag")
@import("q1b_teacher.zag")
@import("tqn_teacher.zag")

// explicit byte-built sealed path + canary: the SAME §B.7 battery seal as
// Q1b (the flaw schedule and scorer are unchanged).
// "q1/sealed/manifest"
fn tqn_sealedpath()[]u8 {
    let b:[]u8=nio_alloc(18);
    b[0]=113 as u8; b[1]=49 as u8; b[2]=47 as u8; b[3]=115 as u8;
    b[4]=101 as u8; b[5]=97 as u8; b[6]=108 as u8; b[7]=101 as u8;
    b[8]=100 as u8; b[9]=47 as u8; b[10]=109 as u8; b[11]=97 as u8;
    b[12]=110 as u8; b[13]=105 as u8; b[14]=102 as u8; b[15]=101 as u8;
    b[16]=115 as u8; b[17]=116 as u8;
    return b;
}
// "Q1C:9f2c"
fn tqn_canary()[]u8 {
    let b:[]u8=nio_alloc(8);
    b[0]=81 as u8; b[1]=49 as u8; b[2]=67 as u8; b[3]=58 as u8;
    b[4]=57 as u8; b[5]=102 as u8; b[6]=50 as u8; b[7]=99 as u8;
    return b;
}
// "noisy"
fn tqn_legname()[]u8 {
    let b:[]u8=nio_alloc(5);
    b[0]=110 as u8; b[1]=111 as u8; b[2]=105 as u8; b[3]=115 as u8;
    b[4]=121 as u8;
    return b;
}

// fresh-store audit: n==0 and no fact id 0..239 is present.
fn tqn_audit_empty(s:*T5Store)i32 {
    if(s.*.n!=0){return 0;}
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){return 0;}
        id=id+1;
    }
    return 1;
}

// recall check vs world truth.
fn tqn_recall_ok(s:*T5Store,fid:i32)i32 {
    if(t5_slot_find(s,fid)<0){return 0;}
    if(t5_claim_of(s,fid)==t5_truth(fid)){return 1;}
    return 0;
}

// recall check vs the teacher's claim (did the learner absorb what it was
// taught, true or false?).
fn tqn_recall_teacher(s:*T5Store,teacher:*T5Store,fid:i32)i32 {
    if(t5_slot_find(s,fid)<0){return 0;}
    if(t5_claim_of(s,fid)==t5_claim_of(teacher,fid)){return 1;}
    return 0;
}

// hex print of a digest
fn tqn_hex(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){
        let v:i64=(b[i] as i64)&255;
        let hi:i64=(v>>4)&15;
        let lo:i64=v&15;
        let hc:u8=(48+hi) as u8;
        if(hi>9){hc=(87+hi) as u8;}
        let lc:u8=(48+lo) as u8;
        if(lo>9){lc=(87+lo) as u8;}
        let tmp:[]u8=nio_alloc(2);
        tmp[0]=hc; tmp[1]=lc;
        _zag_print(tmp);
        nio_free(tmp);
        i=i+1;
    }
    return;
}

// canonical state digest: sha256 over (fid,claim) pairs in ascending fid
// order (slot-layout independent).
fn tqn_state_digest(s:*T5Store)[]u8 {
    let n:i32=s.*.n;
    let img:[]u8=nio_alloc(n*8+8);
    let w:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            tb_put32(img,w*8,id as i64);
            tb_put32(img,w*8+4,t5_claim_of(s,id) as i64);
            w=w+1;
        }
        id=id+1;
    }
    let d:[]u8=nio_alloc(32);
    let h:[]u8=img[0..w*8];
    ns_sha256(h,d);
    nio_free(img);
    return d;
}

// Build one LESSON tape: identical slot layout to q1_build_stimulus, but
// the record values are the TEACHER's held claims (the teacher teaches what
// it holds). The teacher must hold every taught fact (driver-audited).
fn tqn_build_lesson(teacher:*T5Store,layout:i32,base:i32,nf:i32,stim:[]u8,occ:[]u8,offtab:[]u8)i32 {
    let i:i32=0;
    while(i<Q1_TAPE_LEN){stim[i]=Q1_FILL as u8;i=i+1;}
    i=0;
    while(i<Q1_NSLOTS){occ[i]=0;i=i+1;}
    let placed:i32=0;
    let k:i32=0;
    while(k<nf){
        let fid:i32=q1_probe_id((base+k)%Q1_PROBE_N);
        let o:i32=0;
        while(o<3){
            let s:i32=q1_slot_of(layout,fid,o,occ);
            if(s>=0){
                occ[s]=1;
                let at:i32=s*Q1_SLOT;
                tb_put32(stim,at,fid as i64);
                tb_put32(stim,at+4,t5_claim_of(teacher,fid) as i64);
                tb_i64_set(offtab,(k*3+o)*8,at as i64);
                placed=placed+1;
            }
            o=o+1;
        }
        k=k+1;
    }
    return placed;
}

// Filter/absorb accounting over the 192 curriculum facts.
// absorbed: teacher false AND learner holds the teacher's false claim.
// filtered: teacher false AND learner does NOT hold the teacher's false
//   claim (rejected, or holds the true value, or never adopted).
// true_ok / true_bad: the same split for teacher-true facts.
fn tqn_absorb(teacher:*T5Store,learner:*T5Store)void {
    let absorbed:i32=0;
    let filtered:i32=0;
    let true_ok:i32=0;
    let true_bad:i32=0;
    let tfalse:i32=0;
    let cs:i32=0;
    while(cs<8){
        let ck:i32=0;
        while(ck<24){
            let fid:i32=q1_slice_fact(cs,ck);
            let tc:i32=t5_claim_of(teacher,fid);
            let tr:i32=t5_truth(fid);
            let ls:i32=t5_slot_find(learner,fid);
            if(tc!=tr){
                tfalse=tfalse+1;
                if(ls>=0 && t5_claim_of(learner,fid)==tc){absorbed=absorbed+1;}
                else{filtered=filtered+1;}
            }
            else{
                if(ls>=0 && t5_claim_of(learner,fid)==tr){true_ok=true_ok+1;}
                else{true_bad=true_bad+1;}
            }
            ck=ck+1;
        }
        cs=cs+1;
    }
    _zag_print("TQN_ABSORB,");
    cl_number(absorbed as i64); _zag_print(",");
    cl_number(filtered as i64); _zag_print(",");
    cl_number(tfalse as i64); _zag_print(",");
    cl_number(true_ok as i64); _zag_print(",");
    cl_number(true_bad as i64);
    _zag_println("");
    return;
}

// The noisy-teacher leg: fresh learner + 8 teaching slices from the noisy
// teacher's lesson tapes. Returns check failures.
fn tqn_leg(tid:i64,teacher:*T5Store,tspans:*Q1SpanMap)i32 {
    let fails:i32=0;
    let lname:[]u8=tqn_legname();

    // ================= LEARNER: fresh, empty at t0 =================
    let store:T5Store=t5_init(512,32768);
    fails=fails+cl_check("tqn_learner_t0_empty_n",store.n,0);
    fails=fails+cl_check("tqn_learner_t0_audit_empty",tqn_audit_empty(&store),1);
    let spans:Q1SpanMap=q1_spanmap_init(256);

    // ================= machinery self-tests (prove the gates are live) =================
    let ev0:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev0,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev0,7,999,T5_EV_DIRECTIVE,2,-1);
    fails=fails+cl_check("tqn_verify_kills_disagreement",t5_verify(&store,&ev0,2),0);
    q1_ev_free(&ev0);
    let ev1:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev1,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev1,7,100,Q1_EV_TEACHER,2,-1);
    fails=fails+cl_check("tqn_verify_accepts_agreement",t5_verify(&store,&ev1,2),1);
    q1_ev_free(&ev1);
    let wstim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let wocc:[]u8=nio_alloc(Q1_NSLOTS);
    let woff:[]u8=nio_alloc(8);
    let wpl:i32=q1_build_stimulus(9,192,1,wstim,wocc,woff);
    fails=fails+cl_check("tqn_world_placed",wpl,3);
    let wf0:i32=q1_scaffold_fact(0);
    let wo0:i32=tb_i64_get(woff,0) as i32;
    fails=fails+cl_check("tqn_world_decode_fid",tb_get32(wstim,wo0) as i32,wf0);
    fails=fails+cl_check("tqn_world_decode_val",tb_get32(wstim,wo0+4) as i32,t5_truth(wf0));
    fails=fails+cl_check("tqn_shift_breaks_alignment",((wo0+1)%16==0) as i32,0);
    nio_free(wstim); nio_free(wocc); nio_free(woff);

    // ================= SCAFFOLD-AND-RELEASE (world truth: the learner's =================
    // ================= independent foundation, exactly as in Q1b) =================
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let offtab:[]u8=nio_alloc(8*3*8);
    let placed:i32=q1_build_stimulus(9,192,8,stim,occ,offtab);
    fails=fails+cl_check("tqn_scaffold_placed",placed,24);
    let ex_fid:[]u8=nio_alloc(32);
    let ex_off:[]u8=nio_alloc(32);
    let ek:i32=0;
    while(ek<8){
        t5_s(ex_fid,ek*4,q1_scaffold_fact(ek));
        t5_s(ex_off,ek*4,tb_i64_get(offtab,(ek*3+0)*8) as i32);
        ek=ek+1;
    }
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,512,16384,2048);
    let added:i32=q1_scaffold(&store,&spans,&tape,stim,ex_fid,ex_off,8);
    fails=fails+cl_check("tqn_scaffold_added",added,8);
    fails=fails+cl_check("tqn_disconnect_audited",
        t5_audit_op_n(&store,T5_OP_DISCONNECT),1);
    let ret:i32=0;
    ek=0;
    while(ek<8){
        if(tqn_recall_ok(&store,q1_scaffold_fact(ek))==1){ret=ret+1;}
        ek=ek+1;
    }
    fails=fails+cl_check("tqn_post_disconnect_retention",ret,8);
    nio_free(stim); nio_free(occ); nio_free(offtab);
    nio_free(ex_fid); nio_free(ex_off);

    // ================= 8 TEACHING SLICES (the teacher's lesson) =================
    let total_hits:i32=0;
    let total_pass:i32=0;
    let total_clean_adopted:i32=0;
    let s:i32=0;
    while(s<8){
        let lesson:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ2:[]u8=nio_alloc(Q1_NSLOTS);
        let ot2:[]u8=nio_alloc(24*3*8);
        let pl2:i32=tqn_build_lesson(teacher,s,s*24,24,lesson,occ2,ot2);
        fails=fails+cl_check("tqn_slice_lesson_placed",pl2,72);
        // honesty: the lesson faithfully encodes the teacher's knowledge at
        // the teacher's own learned spans (the teacher teaches what it holds).
        let sbad:i32=0;
        let sk:i32=0;
        while(sk<24){
            let fid:i32=q1_slice_fact(s,sk);
            let sp:i32=q1_span_find(tspans,fid);
            if(sp<0){sbad=sbad+1;}
            else{
                if(tb_get32(lesson,sp)!=(fid as i64)){sbad=sbad+1;}
                if(tb_get32(lesson,sp+4)!=(t5_claim_of(teacher,fid) as i64)){sbad=sbad+1;}
            }
            sk=sk+1;
        }
        fails=fails+cl_check("tqn_lesson_genuine",sbad,0);
        let t2:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&t2,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(1000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.last8=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        let seq:i64=1;
        let adopts:i32=0;
        let emit_bad:i32=0;
        let k:i32=0;
        while(k<24){
            if(k<12){
                // FLAW-FIRST: the frozen §B.7 schedule, zero-shot in-slice.
                let er:i32=q1_emit_flaw(&t2,tid,s,(1000+s) as i64,seq,k,
                                        q1_slice_fact(s,k),ot2,k,occ2,&mctx);
                if(er<0){emit_bad=emit_bad+1;}
                q1_learn_one(&store,&spans,&sess,&t2,lesson,s as i64);
                seq=seq+1;
            }
            let ec:i32=q1_emit_clean(&t2,tid,(1000+s) as i64,seq,ot2,k);
            if(ec<0){emit_bad=emit_bad+1;}
            let vc:i32=q1_learn_one(&store,&spans,&sess,&t2,lesson,s as i64);
            if(vc==TB_V_ADOPT){adopts=adopts+1;}
            seq=seq+1;
            k=k+1;
        }
        fails=fails+cl_check("tqn_slice_emit_ok",emit_bad,0);
        fails=fails+cl_check("tqn_slice_manifest_n",mctx.mi,12);
        // §C tripwire: must not fire on the teaching tape
        let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t2,Q1_TAPE_LEN as i64,&tw);
        fails=fails+cl_check("tqn_slice_tripwire_fired",tw.fired,0);
        // SEALED flaw scoring (manifest instantiated after the session)
        let sp:[]u8=tqn_sealedpath();
        let cn:[]u8=tqn_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("tqn_slice_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        tb_flaw_score(&t2,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("tqn_slice_leak",fo.leak,0);
        fails=fails+cl_check("tqn_slice_hnm12",fo.hits+fo.nears+fo.misses,12);
        // mastery vs world truth AND vs the teacher's claims
        let mh_t:i32=0;
        let mh_c:i32=0;
        let mk:i32=0;
        while(mk<24){
            if(tqn_recall_ok(&store,q1_slice_fact(s,mk))==1){mh_t=mh_t+1;}
            if(tqn_recall_teacher(&store,teacher,q1_slice_fact(s,mk))==1){mh_c=mh_c+1;}
            mk=mk+1;
        }
        _zag_print("TQN_SLICE,");
        _zag_print(lname); _zag_print(",");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(adopts as i64); _zag_print(",");
        cl_number(mh_t as i64); _zag_print(",");
        cl_number(mh_c as i64); _zag_print(",");
        cl_number(tw.fired as i64);
        _zag_println("");
        total_hits=total_hits+fo.hits;
        if(fo.hits>=10){total_pass=total_pass+1;}
        total_clean_adopted=total_clean_adopted+adopts;
        nio_free(lesson); nio_free(occ2); nio_free(ot2);
        q1_mctx_free(&mctx);
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
        s=s+1;
    }

    // ================= FINAL MASTERY + STATE =================
    let fm_t:i32=0;
    let fm_c:i32=0;
    let fs:i32=0;
    while(fs<8){
        let fk:i32=0;
        while(fk<24){
            if(tqn_recall_ok(&store,q1_slice_fact(fs,fk))==1){fm_t=fm_t+1;}
            if(tqn_recall_teacher(&store,teacher,q1_slice_fact(fs,fk))==1){fm_c=fm_c+1;}
            fk=fk+1;
        }
        fs=fs+1;
    }
    // NOTE: fm_t is expected to be 192-49=143, NOT 192: the learner absorbs
    // the teacher's false claims (that is the measured effect, not a check
    // failure — the absorb accounting below is the instrument for it).
    let sm:i32=0;
    let sk2:i32=0;
    while(sk2<8){
        if(tqn_recall_ok(&store,q1_scaffold_fact(sk2))==1){sm=sm+1;}
        sk2=sk2+1;
    }
    fails=fails+cl_check("tqn_scaffold_retained",sm,8);
    fails=fails+cl_check("tqn_store_n",store.n,200);

    _zag_print("TQN_RUN,");
    _zag_print(lname); _zag_print(",");
    cl_number(total_hits as i64); _zag_print(",");
    cl_number(total_pass as i64); _zag_print(",");
    cl_number(total_clean_adopted as i64); _zag_print(",");
    cl_number(fm_t as i64); _zag_print(",");
    cl_number(fm_c as i64); _zag_print(",");
    cl_number(fails as i64);
    _zag_println("");
    tqn_absorb(teacher,&store);
    _zag_print("TQN_DIGEST,");
    _zag_print(lname); _zag_print(",learner,");
    let dl:[]u8=tqn_state_digest(&store);
    tqn_hex(dl);
    _zag_println("");
    _zag_print("TQN_DIGEST,");
    _zag_print(lname); _zag_print(",teacher,");
    let dt:[]u8=tqn_state_digest(teacher);
    tqn_hex(dt);
    _zag_println("");
    nio_free(dl); nio_free(dt);
    nio_free(lname);
    q1_spanmap_free(&spans);
    return fails;
}

fn main()i32 {
    let fails:i32=0;

    // ================= THE NOISY TEACHER =================
    // Fresh-audited learned construction (driver verifies the acquisition
    // history), then the deterministic noise treatment.
    let tspans:Q1SpanMap=q1_spanmap_init(256);
    let teacher:T5Store=tqn_noisy_teacher_build(&tspans);
    fails=fails+cl_check("tqn_teacher_n",teacher.n,228);
    fails=fails+cl_check("tqn_teacher_learn_gate",teacher.learn_gate,0);
    fails=fails+cl_check("tqn_teacher_zero_plants",
        t5_audit_op_n(&teacher,T5_OP_PLANT),0);
    fails=fails+cl_check("tqn_teacher_adds_228",
        t5_audit_op_n(&teacher,T5_OP_ADD),228);
    fails=fails+cl_check("tqn_teacher_disconnect",
        t5_audit_op_n(&teacher,T5_OP_DISCONNECT),1);
    fails=fails+cl_check("tqn_teacher_revises_59",
        t5_audit_op_n(&teacher,T5_OP_REVISE),59);
    fails=fails+cl_check("tqn_teacher_noisy_selected",
        tqn_teacher_noisy_selected(&teacher),59);
    fails=fails+cl_check("tqn_teacher_false_claims",
        tqn_teacher_false_claims(&teacher),59);
    fails=fails+cl_check("tqn_teacher_holds_curriculum",
        tqn_teacher_holds_curriculum(&teacher),0);
    fails=fails+cl_check("tqn_teacher_false_curriculum",
        tqn_teacher_false_curriculum(&teacher),49);
    _zag_print("TQN_TEACHER,");
    cl_number(teacher.n as i64); _zag_print(",");
    cl_number(tqn_teacher_false_claims(&teacher) as i64); _zag_print(",");
    cl_number(tqn_teacher_false_curriculum(&teacher) as i64);
    _zag_println("");

    // ================= THE NOISY LEG =================
    fails=fails+tqn_leg(TB_TID_NOISY,&teacher,&tspans);
    q1_spanmap_free(&tspans);

    if(fails==0){
        _zag_println("TQN_COMPLETE");
    }
    else{
        _zag_println("TQN_FAIL");
    }
    return fails;
}

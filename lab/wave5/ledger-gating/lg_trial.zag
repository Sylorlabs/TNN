// lg_trial.zag — native trial driver for ledger-gating.
//
// Preregistered legs (PREREG.md):
//   A: 60 honest gating events (50 fresh-ledger + 10 shared-ledger);
//      every episode contains an outgrown noisy reading (C1).
//   B: 6 injected cheat probes at the check boundary (B1..B6).
//   C: belief-revision interaction (C2: commit -> uncommit -> recommit;
//      stale claim blocked; C3: outgrown readings stay silent).
//
// All deterministic: designed curricula, arithmetic episode family, no RNG
// anywhere (substrate, world, harness). The driver's ground truth never
// reaches the checker: il_check sees only the ledger.
//
// Output contract:
//   LG_CHECK,<name>,<actual>,<expected>   (runner verifies actual==expected)
//   LG_GATE,<ep>,<verdict>,<blocked>      (every gate/check-boundary event)
//   LG_LEDGER,<idx>,<op>,<item>,<val>,<p0>,<p1>,<p2>,<p3>
//   LG_NOTE,<tag>,<ep>,<info>             (only on sub-check failure)
//   LG_FAILURES,<n>; LG_RESULT,PASS|FAIL
@import("lg.zag")

struct LgBufs {
    active:[]u8,
    claims:[]u8,
    conf:[]u8,
    audit:[]u8,
}

fn lg_bufs_new(capacity:i32)LgBufs {
    return LgBufs{.active=hss_alloc(capacity),.claims=hss_alloc(capacity*4),
        .conf=hss_alloc(capacity*4),.audit=hss_alloc(HSS_AUDIT_CAP*16)};
}

fn lg_bufs_drop(b:LgBufs)void {
    hss_free(b.active);hss_free(b.claims);hss_free(b.conf);hss_free(b.audit);
}

// Named check with a numeric episode id: LG_CHECK,<tag><e>,<actual>,<expected>
fn lg_checkn(tag:[]u8,e:i32,actual:i32,expected:i32)i32 {
    _zag_print("LG_CHECK,");_zag_print(tag);lg_num(e);_zag_print(",");
    lg_num(actual);_zag_print(",");lg_num(expected);_zag_println("");
    return (actual!=expected) as i32;
}

// Failure note (emitted only when a sub-check fails, to keep output small).
fn lg_note(tag:[]u8,e:i32,info:i32)void {
    _zag_print("LG_NOTE,");_zag_print(tag);_zag_print(",");
    lg_num(e);_zag_print(",");lg_num(info);_zag_println("");
}

// Every gate / check-boundary event, for the disagreement log.
fn lg_gate_line(e:i32,verdict:i32,blocked:i32)void {
    _zag_print("LG_GATE,");
    lg_num(e);_zag_print(",");lg_num(verdict);_zag_print(",");lg_num(blocked);
    _zag_println("");
}

// One driver observation: apply to the substrate, mirror to the ledger.
// expect_refute=1: this observation must refute exactly slot rslot
// (driver records REFUTE(Q,rslot); first two refute indices via rpp).
fn drv_observe(b:LgBufs,cap:i32,il:*IlLedger,item:i32,idx:i32,bit:i32,
    step:i32,committed:*i32,acount:*i32,e:i32,tag:[]u8,
    expect_refute:i32,rslot:i32,nref:*i32,ra:*i32,rb:*i32)i32 {
    let f:i32=0;
    let oi:i32=il_observe(il,item,idx*2+bit);
    if(oi<0){lg_note("obs_full",e,idx);f=f+1;}
    let nr:i32=hss_observe(b.active,b.claims,b.conf,cap,idx,bit,step,
        committed,b.audit,acount);
    if(nr<0){lg_note("obs_err",e,nr);f=f+1;}
    let want:i32=0;
    if(expect_refute!=0){want=1;}
    if(nr!=want){lg_note("refcount",e,nr*16+want);f=f+1;}
    if(expect_refute!=0){
        if(b.active[rslot]!=0){lg_note("rslot_alive",e,rslot);f=f+1;}
        let ri:i32=il_refute(il,item,rslot);
        if(ri<0){lg_note("ref_full",e,rslot);f=f+1;}
        if(nref.*==0 && ra!=null as *i32){ra.*=ri;}
        if(nref.*==1 && rb!=null as *i32){rb.*=ri;}
        nref.*=nref.*+1;
    }
    return f;
}

// One honest episode. K hypotheses in slots 0..K-1, sig_j = 1<<j;
// target survivor t = seq mod K; rival nz gets a noisy first reading
// obs(nz,1) then obs(nz,0): a bad first reading, outgrown (C1).
// The gate must pass IL_OK and commit t. Returns failures.
fn honest_ep(il:*IlLedger,item:i32,e:i32,seq:i32,cap:i32,K:i32,tag:[]u8)i32 {
    let f:i32=0;
    let b:LgBufs=lg_bufs_new(cap);
    let acount:i32=0;
    let committed:i32=-1;
    let step:i32=0;
    let t:i32=lg_mod(seq,K);
    let nz:i32=0;
    if(t==0){nz=1;}
    let nref:i32=0;
    let ref_a:i32=-1;
    let ref_b:i32=-1;
    let j:i32=0;
    while(j<K){
        step=step+1;
        let r:i32=hss_activate(b.active,b.claims,b.conf,cap,j,1<<j,
            step,b.audit,&acount);
        if(r!=HSS_OK){lg_note("act",e,j);f=f+1;}
        j=j+1;
    }
    // Noisy first reading on rival nz (outgrown below).
    step=step+1;
    f=f+drv_observe(b,cap,il,item,nz,1,step,&committed,&acount,e,tag,
        0,-1,&nref,&ref_a,&ref_b);
    step=step+1;
    f=f+drv_observe(b,cap,il,item,nz,0,step,&committed,&acount,e,tag,
        1,nz,&nref,&ref_a,&ref_b);
    // Refute the remaining rivals.
    j=0;
    while(j<K){
        if(j!=t && j!=nz){
            step=step+1;
            f=f+drv_observe(b,cap,il,item,j,0,step,&committed,&acount,e,tag,
                1,j,&nref,&ref_a,&ref_b);
        }
        j=j+1;
    }
    // Confirm the survivor.
    step=step+1;
    f=f+drv_observe(b,cap,il,item,t,1,step,&committed,&acount,e,tag,
        0,-1,&nref,&ref_a,&ref_b);
    if(nref!=K-1){lg_note("nref",e,nref);f=f+1;}
    // Exactly one survivor must remain (the eliminative logic's claim).
    let na:i32=lg_survivor(b.active,cap,null as *i32);
    if(na!=1){lg_note("notsole",e,na);f=f+1;}
    // THE GATE.
    step=step+1;
    let vout:i32=LG_NOCHECK;
    let hy:i32=-1;
    let ve:i32=-1;
    let ci:i32=-1;
    let g:i32=lg_attempt_commit(b.active,cap,&committed,step,b.audit,&acount,
        il,item,ref_a,ref_b,&vout,&hy,&ve,&ci);
    let blocked:i32=0;
    if(g>=LG_BLOCKED_BASE){blocked=1;}
    lg_gate_line(e,vout,blocked);
    f=f+lg_checkn(tag,e,vout,IL_OK);
    f=f+lg_checkn(tag,e,g,t);
    f=f+lg_checkn(tag,e,committed,t);
    f=f+lg_checkn(tag,e,hss_audit_count_op(b.audit,acount,HSS_OP_COMMIT),1);
    f=f+lg_checkn(tag,e,lg_count_gateholds(b.audit,acount),0);
    let fep:i32=f;
    f=f+lg_checkn(tag,e,fep,0);
    lg_bufs_drop(b);
    return f;
}

// Standard cheat-probe setup: item Q, slots 0,1,2 (sig 1<<j);
// obs(0,0) refutes 0, obs(2,0) refutes 2, obs(1,1) confirms 1.
// Sole survivor 1, UNGATED (the adversary will present the claim).
// Refute indices via r0p/r1p; step advanced via stepp.
fn cheat_setup(il:*IlLedger,item:i32,b:LgBufs,cap:i32,acount:*i32,
    committed:*i32,stepp:*i32,r0p:*i32,r1p:*i32)i32 {
    let f:i32=0;
    let j:i32=0;
    while(j<3){
        stepp.*=stepp.*+1;
        let r:i32=hss_activate(b.active,b.claims,b.conf,cap,j,1<<j,
            stepp.*,b.audit,acount);
        if(r!=HSS_OK){f=f+1;}
        j=j+1;
    }
    stepp.*=stepp.*+1;
    let o0:i32=il_observe(il,item,0);
    if(o0<0){f=f+1;}
    let n0:i32=hss_observe(b.active,b.claims,b.conf,cap,0,0,stepp.*,
        committed,b.audit,acount);
    if(n0!=1){f=f+1;}
    let rf0:i32=il_refute(il,item,0);
    if(rf0<0){f=f+1;}
    stepp.*=stepp.*+1;
    let o2:i32=il_observe(il,item,4);
    if(o2<0){f=f+1;}
    let n2:i32=hss_observe(b.active,b.claims,b.conf,cap,2,0,stepp.*,
        committed,b.audit,acount);
    if(n2!=1){f=f+1;}
    let rf2:i32=il_refute(il,item,2);
    if(rf2<0){f=f+1;}
    stepp.*=stepp.*+1;
    let o1:i32=il_observe(il,item,3);
    if(o1<0){f=f+1;}
    let n1:i32=hss_observe(b.active,b.claims,b.conf,cap,1,1,stepp.*,
        committed,b.audit,acount);
    if(n1!=0){f=f+1;}
    if(r0p!=null as *i32){r0p.*=rf0;}
    if(r1p!=null as *i32){r1p.*=rf2;}
    return f;
}

// Post-block state assertions (F4): committed unchanged, no COMMIT added,
// exactly one gate HOLD, and it is the audit tail naming the verdict.
fn probe_post(tag:[]u8,e:i32,audit:[]u8,acount:i32,committed:i32,
    exp_committed:i32,exp_ncommit:i32,exp_v:i32)i32 {
    let f:i32=0;
    f=f+lg_checkn(tag,e,committed,exp_committed);
    f=f+lg_checkn(tag,e,hss_audit_count_op(audit,acount,HSS_OP_COMMIT),exp_ncommit);
    f=f+lg_checkn(tag,e,lg_count_gateholds(audit,acount),1);
    f=f+lg_checkn(tag,e,hss_audit_last_op(audit,acount),HSS_OP_HOLD);
    f=f+lg_checkn(tag,e,hss_audit_last_aux(audit,acount),1000+exp_v);
    return f;
}

fn probe_new(cap:i32,acount:*i32,committed:*i32,stepp:*i32)LgBufs {
    let b:LgBufs=lg_bufs_new(cap);
    acount.*=0;
    committed.*=-1;
    stepp.*=0;
    return b;
}

// B1 (e=200): claim cites a VERIFY whose recorded val differs.
fn probe_b1()i32 {
    let f:i32=0;
    let e:i32=200;
    let il:IlLedger=il_init();
    let sp:*IlLedger=&il;
    let acount:i32=0;
    let committed:i32=-1;
    let step:i32=0;
    let b:LgBufs=probe_new(8,&acount,&committed,&step);
    let r0:i32=-1;
    let r2:i32=-1;
    f=f+cheat_setup(sp,701,b,8,&acount,&committed,&step,&r0,&r2);
    let hy:i32=il_hyp(sp,701,1);
    let ve:i32=il_verify(sp,701,1);
    let ve9:i32=il_verify(sp,701,9);
    let ci:i32=-1;
    let v:i32=lg_claim_and_check(sp,701,1,r0,r2,hy,ve9,&ci);
    lg_gate_line(e,v,1);
    f=f+lg_checkn("b1_",e,v,IL_LIE_CITED);
    step=step+1;
    let br:i32=lg_block(step,b.audit,&acount,v);
    f=f+lg_checkn("b1_",e,(br==HSS_OK) as i32,1);
    f=f+probe_post("b1_",e,b.audit,acount,committed,-1,0,IL_LIE_CITED);
    lg_ledger_dump(sp,ci);
    nio_free(il.mem);
    lg_bufs_drop(b);
    return f;
}

// B2 (e=201): claim cites an entry index never gathered (phantom).
fn probe_b2()i32 {
    let f:i32=0;
    let e:i32=201;
    let il:IlLedger=il_init();
    let sp:*IlLedger=&il;
    let acount:i32=0;
    let committed:i32=-1;
    let step:i32=0;
    let b:LgBufs=probe_new(8,&acount,&committed,&step);
    let r0:i32=-1;
    let r2:i32=-1;
    f=f+cheat_setup(sp,702,b,8,&acount,&committed,&step,&r0,&r2);
    let hy:i32=il_hyp(sp,702,1);
    let ve:i32=il_verify(sp,702,1);
    let ci:i32=-1;
    let v:i32=lg_claim_and_check(sp,702,1,r0,r2,hy,sp.*.head+50,&ci);
    lg_gate_line(e,v,1);
    f=f+lg_checkn("b2_",e,v,IL_CHEAT_PHANTOM);
    step=step+1;
    let br:i32=lg_block(step,b.audit,&acount,v);
    f=f+lg_checkn("b2_",e,(br==HSS_OK) as i32,1);
    f=f+probe_post("b2_",e,b.audit,acount,committed,-1,0,IL_CHEAT_PHANTOM);
    lg_ledger_dump(sp,ci);
    nio_free(il.mem);
    lg_bufs_drop(b);
    return f;
}

// B3 (e=202): cheat-jump — correct value, no genuine chain (empty, then
// HYP-only). Then an honest retry must still gate clean (blocks are
// specific, not state-poisoning).
fn probe_b3()i32 {
    let f:i32=0;
    let e:i32=202;
    let il:IlLedger=il_init();
    let sp:*IlLedger=&il;
    let acount:i32=0;
    let committed:i32=-1;
    let step:i32=0;
    let b:LgBufs=probe_new(8,&acount,&committed,&step);
    let r0:i32=-1;
    let r2:i32=-1;
    f=f+cheat_setup(sp,703,b,8,&acount,&committed,&step,&r0,&r2);
    let ci:i32=-1;
    let v:i32=lg_claim_and_check(sp,703,1,-1,-1,-1,-1,&ci);
    lg_gate_line(e,v,1);
    f=f+lg_checkn("b3a_",e,v,IL_CHEAT_EMPTY);
    step=step+1;
    f=f+lg_checkn("b3a_",e,(lg_block(step,b.audit,&acount,v)==HSS_OK) as i32,1);
    let hy:i32=il_hyp(sp,703,1);
    let ci2:i32=-1;
    let v2:i32=lg_claim_and_check(sp,703,1,hy,-1,-1,-1,&ci2);
    lg_gate_line(e,v2,1);
    f=f+lg_checkn("b3b_",e,v2,IL_CHEAT_NOSHAPE);
    step=step+1;
    f=f+lg_checkn("b3b_",e,(lg_block(step,b.audit,&acount,v2)==HSS_OK) as i32,1);
    lg_ledger_dump(sp,ci);
    // Honest retry of the same item: must gate clean.
    step=step+1;
    let vout:i32=LG_NOCHECK;
    let g:i32=lg_attempt_commit(b.active,8,&committed,step,b.audit,&acount,
        sp,703,r0,r2,&vout,null as *i32,null as *i32,null as *i32);
    lg_gate_line(e,vout,0);
    f=f+lg_checkn("b3r_",e,vout,IL_OK);
    f=f+lg_checkn("b3r_",e,g,1);
    f=f+lg_checkn("b3r_",e,committed,1);
    f=f+lg_checkn("b3r_",e,lg_count_gateholds(b.audit,acount),2);
    nio_free(il.mem);
    lg_bufs_drop(b);
    return f;
}

// B4 (e=203): trivial chain — claim cites a CLAIM entry.
fn probe_b4()i32 {
    let f:i32=0;
    let e:i32=203;
    let il:IlLedger=il_init();
    let sp:*IlLedger=&il;
    let acount:i32=0;
    let committed:i32=-1;
    let step:i32=0;
    let b:LgBufs=probe_new(8,&acount,&committed,&step);
    let r0:i32=-1;
    let r2:i32=-1;
    f=f+cheat_setup(sp,704,b,8,&acount,&committed,&step,&r0,&r2);
    let hy:i32=il_hyp(sp,704,1);
    let ve:i32=il_verify(sp,704,1);
    let cx:i32=il_claim(sp,704,1,r0,r2,hy,ve);
    let ci:i32=-1;
    let v:i32=lg_claim_and_check(sp,704,1,cx,-1,-1,-1,&ci);
    lg_gate_line(e,v,1);
    f=f+lg_checkn("b4_",e,v,IL_CHEAT_TRIVIAL);
    step=step+1;
    let br:i32=lg_block(step,b.audit,&acount,v);
    f=f+lg_checkn("b4_",e,(br==HSS_OK) as i32,1);
    f=f+probe_post("b4_",e,b.audit,acount,committed,-1,0,IL_CHEAT_TRIVIAL);
    lg_ledger_dump(sp,ci);
    nio_free(il.mem);
    lg_bufs_drop(b);
    return f;
}

// B5 (e=204): locally-consistent claim contradicting the latest committed
// VERIFY, with no fresh VERIFY (adversarial S7 analog through the gate).
fn probe_b5()i32 {
    let f:i32=0;
    let e:i32=204;
    let il:IlLedger=il_init();
    let sp:*IlLedger=&il;
    let acount:i32=0;
    let committed:i32=-1;
    let step:i32=0;
    let b:LgBufs=probe_new(8,&acount,&committed,&step);
    let r0:i32=-1;
    let r2:i32=-1;
    f=f+cheat_setup(sp,705,b,8,&acount,&committed,&step,&r0,&r2);
    // Honest gated commit of Q->1 first (the committed belief).
    step=step+1;
    let vout:i32=LG_NOCHECK;
    let g:i32=lg_attempt_commit(b.active,8,&committed,step,b.audit,&acount,
        sp,705,r0,r2,&vout,null as *i32,null as *i32,null as *i32);
    lg_gate_line(e,vout,0);
    f=f+lg_checkn("b5s_",e,vout,IL_OK);
    f=f+lg_checkn("b5s_",e,committed,1);
    // Adversary: fresh-looking chain for value 0, but NO new VERIFY(Q,0).
    // (Cites only REFUTE(Q,2): citing REFUTE(Q,0) while claiming 0 would
    // trip rule 4 first; the probe targets rule 5.)
    let hy0:i32=il_hyp(sp,705,0);
    let ci:i32=-1;
    let v:i32=lg_claim_and_check(sp,705,0,r2,hy0,-1,-1,&ci);
    lg_gate_line(e,v,1);
    f=f+lg_checkn("b5_",e,v,IL_LIE_COMMITTED);
    step=step+1;
    let br:i32=lg_block(step,b.audit,&acount,v);
    f=f+lg_checkn("b5_",e,(br==HSS_OK) as i32,1);
    f=f+probe_post("b5_",e,b.audit,acount,committed,1,1,IL_LIE_COMMITTED);
    lg_ledger_dump(sp,ci);
    nio_free(il.mem);
    lg_bufs_drop(b);
    return f;
}

// B6 (e=205): claim of a value its own chain refuted.
fn probe_b6()i32 {
    let f:i32=0;
    let e:i32=205;
    let il:IlLedger=il_init();
    let sp:*IlLedger=&il;
    let acount:i32=0;
    let committed:i32=-1;
    let step:i32=0;
    let b:LgBufs=probe_new(8,&acount,&committed,&step);
    let r0:i32=-1;
    let r2:i32=-1;
    f=f+cheat_setup(sp,706,b,8,&acount,&committed,&step,&r0,&r2);
    // Adversary forges HYP/VERIFY for refuted rival 2, but cites the
    // genuine REFUTE(Q,2): the ledger contradicts the claim.
    let hy2:i32=il_hyp(sp,706,2);
    let ve2:i32=il_verify(sp,706,2);
    let ci:i32=-1;
    let v:i32=lg_claim_and_check(sp,706,2,r0,r2,hy2,ve2,&ci);
    lg_gate_line(e,v,1);
    f=f+lg_checkn("b6_",e,v,IL_LIE_CITED);
    step=step+1;
    let br:i32=lg_block(step,b.audit,&acount,v);
    f=f+lg_checkn("b6_",e,(br==HSS_OK) as i32,1);
    f=f+probe_post("b6_",e,b.audit,acount,committed,-1,0,IL_LIE_CITED);
    lg_ledger_dump(sp,ci);
    nio_free(il.mem);
    lg_bufs_drop(b);
    return f;
}

// Leg A1: 50 honest episodes, fresh ledger each.
fn leg_a1()i32 {
    let f:i32=0;
    let e:i32=0;
    while(e<50){
        let il:IlLedger=il_init();
        let sp:*IlLedger=&il;
        let K:i32=3+lg_mod(e,3);
        f=f+honest_ep(sp,1000+e,e,e,8,K,"epA1_");
        nio_free(il.mem);
        e=e+1;
    }
    return f;
}

// Leg A2: 10 honest episodes, ONE shared ledger (continuing
// investigation on Q=500; re-verification each episode).
fn leg_a2()i32 {
    let f:i32=0;
    let il:IlLedger=il_init();
    let sp:*IlLedger=&il;
    let i:i32=0;
    while(i<10){
        f=f+honest_ep(sp,500,100+i,i,8,3,"epA2_");
        i=i+1;
    }
    // 10 episodes x 9 entries (4 OBS + 2 REF + HYP + VERIFY + CLAIM).
    f=f+lg_checkn("a2_",0,sp.*.head,90);
    f=f+lg_checkn("a2_",0,(sp.*.head<=IL_CAP) as i32,1);
    nio_free(il.mem);
    return f;
}

fn leg_b()i32 {
    let f:i32=0;
    f=f+probe_b1();
    f=f+probe_b2();
    f=f+probe_b3();
    f=f+probe_b4();
    f=f+probe_b5();
    f=f+probe_b6();
    return f;
}

// Leg C: belief revision (C2) + superseded-observation silence (C3).
// Q=7, capacity 5 (slots 0..4; audit budget: A=24, B=19, HOLD=1).
fn leg_c()i32 {
    let f:i32=0;
    let Q:i32=7;
    let il:IlLedger=il_init();
    let sp:*IlLedger=&il;
    let b:LgBufs=lg_bufs_new(5);
    let acount:i32=0;
    let committed:i32=-1;
    let step:i32=0;
    // ---- Episode A: commit slot 1 (with an outgrown noisy reading).
    step=1;
    let ra0:i32=hss_activate(b.active,b.claims,b.conf,5,0,1,step,b.audit,&acount);
    step=2;
    let ra1:i32=hss_activate(b.active,b.claims,b.conf,5,1,2,step,b.audit,&acount);
    step=3;
    let ra2:i32=hss_activate(b.active,b.claims,b.conf,5,2,4,step,b.audit,&acount);
    f=f+lg_checkn("cA_",0,(ra0==HSS_OK && ra1==HSS_OK && ra2==HSS_OK) as i32,1);
    // noisy first reading obs(0,1): confirms slot 0, outgrown next step.
    step=4;
    let ono:i32=il_observe(sp,Q,1);
    let nn0:i32=hss_observe(b.active,b.claims,b.conf,5,0,1,step,&committed,
        b.audit,&acount);
    f=f+lg_checkn("cA_",0,nn0,0);
    // corrected reading obs(0,0): refutes slot 0.
    step=5;
    let oo0:i32=il_observe(sp,Q,0);
    let nn1:i32=hss_observe(b.active,b.claims,b.conf,5,0,0,step,&committed,
        b.audit,&acount);
    let rf0:i32=il_refute(sp,Q,0);
    f=f+lg_checkn("cA_",0,nn1,1);
    // obs(2,0): refutes slot 2.
    step=6;
    let oo2:i32=il_observe(sp,Q,4);
    let nn2:i32=hss_observe(b.active,b.claims,b.conf,5,2,0,step,&committed,
        b.audit,&acount);
    let rf2:i32=il_refute(sp,Q,2);
    f=f+lg_checkn("cA_",0,nn2,1);
    // obs(1,1): confirms slot 1.
    step=7;
    let oo1:i32=il_observe(sp,Q,3);
    let nn3:i32=hss_observe(b.active,b.claims,b.conf,5,1,1,step,&committed,
        b.audit,&acount);
    f=f+lg_checkn("cA_",0,nn3,0);
    if(ono<0 || oo0<0 || oo2<0 || oo1<0 || rf0<0 || rf2<0){
        lg_note("cA_ledger",0,0);f=f+1;
    }
    // Gate A (e=300): must pass; commit slot 1.
    step=8;
    let vA:i32=LG_NOCHECK;
    let hypA:i32=-1;
    let verA:i32=-1;
    let ciA:i32=-1;
    let gA:i32=lg_attempt_commit(b.active,5,&committed,step,b.audit,&acount,
        sp,Q,rf0,rf2,&vA,&hypA,&verA,&ciA);
    lg_gate_line(300,vA,0);
    f=f+lg_checkn("cA_",0,vA,IL_OK);
    f=f+lg_checkn("cA_",0,gA,1);
    f=f+lg_checkn("cA_",0,committed,1);
    // ---- Episode B: revision. obs(1,0) refutes the committed slot 1.
    step=9;
    let ob1:i32=il_observe(sp,Q,2);
    let nb0:i32=hss_observe(b.active,b.claims,b.conf,5,1,0,step,&committed,
        b.audit,&acount);
    let rr1:i32=il_refute(sp,Q,1);
    f=f+lg_checkn("cB_",0,nb0,1);
    f=f+lg_checkn("cB_",0,committed,-1);
    f=f+lg_checkn("cB_",0,
        hss_audit_count_op(b.audit,acount,HSS_OP_UNCOMMIT),1);
    if(ob1<0 || rr1<0){lg_note("cB_ledger",0,0);f=f+1;}
    // Activate fresh hypotheses 3, 4.
    step=10;
    let rb3:i32=hss_activate(b.active,b.claims,b.conf,5,3,8,step,b.audit,&acount);
    step=11;
    let rb4:i32=hss_activate(b.active,b.claims,b.conf,5,4,16,step,b.audit,&acount);
    f=f+lg_checkn("cB_",0,(rb3==HSS_OK && rb4==HSS_OK) as i32,1);
    // obs(3,0) refutes 3; obs(4,1) confirms 4.
    step=12;
    let ob3:i32=il_observe(sp,Q,6);
    let nb1:i32=hss_observe(b.active,b.claims,b.conf,5,3,0,step,&committed,
        b.audit,&acount);
    let rr3:i32=il_refute(sp,Q,3);
    f=f+lg_checkn("cB_",0,nb1,1);
    step=13;
    let ob4:i32=il_observe(sp,Q,9);
    let nb2:i32=hss_observe(b.active,b.claims,b.conf,5,4,1,step,&committed,
        b.audit,&acount);
    f=f+lg_checkn("cB_",0,nb2,0);
    if(ob3<0 || ob4<0 || rr3<0){lg_note("cB_ledger",0,0);f=f+1;}
    // Gate B (e=301): the revision must PASS (latest VERIFY(Q,*) is new).
    step=14;
    let vB:i32=LG_NOCHECK;
    let hypB:i32=-1;
    let verB:i32=-1;
    let ciB:i32=-1;
    let gB:i32=lg_attempt_commit(b.active,5,&committed,step,b.audit,&acount,
        sp,Q,rr1,rr3,&vB,&hypB,&verB,&ciB);
    lg_gate_line(301,vB,0);
    f=f+lg_checkn("cB_",0,vB,IL_OK);
    f=f+lg_checkn("cB_",0,gB,4);
    f=f+lg_checkn("cB_",0,committed,4);
    // ---- Stale probe (e=302): CLAIM(Q,1) on episode A's chain.
    // Latest VERIFY(Q,*) is now v=4 -> IL_LIE_COMMITTED -> blocked.
    let ciS:i32=-1;
    let vS:i32=lg_claim_and_check(sp,Q,1,rf0,rf2,hypA,verA,&ciS);
    lg_gate_line(302,vS,1);
    f=f+lg_checkn("cS_",0,vS,IL_LIE_COMMITTED);
    step=15;
    let brS:i32=lg_block(step,b.audit,&acount,vS);
    f=f+lg_checkn("cS_",0,(brS==HSS_OK) as i32,1);
    f=f+probe_post("cS_",0,b.audit,acount,committed,4,2,IL_LIE_COMMITTED);
    lg_ledger_dump(sp,ciS);
    // ---- C3b (e=303): the outgrown OBSERVE(Q,1) from episode A, CITED
    // by a Q->4 claim: VERIFY(Q,4) sits between it and the claim, so the
    // supersession rule keeps the gate silent. Check-only probe.
    let ciC:i32=-1;
    let vC:i32=lg_claim_and_check(sp,Q,4,ono,rr1,hypB,verB,&ciC);
    lg_gate_line(303,vC,0);
    f=f+lg_checkn("cC_",0,vC,IL_OK);
    // Audit budget guard (fail-closed cap is 64).
    f=f+lg_checkn("cC_",0,(acount<=HSS_AUDIT_CAP) as i32,1);
    nio_free(il.mem);
    lg_bufs_drop(b);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+leg_a1();
    f=f+leg_a2();
    f=f+leg_b();
    f=f+leg_c();
    _zag_print("LG_FAILURES,");
    lg_num(f);
    _zag_println("");
    if(f==0){_zag_println("LG_RESULT,PASS");}
    if(f!=0){_zag_println("LG_RESULT,FAIL");}
    return (f!=0) as i32;
}

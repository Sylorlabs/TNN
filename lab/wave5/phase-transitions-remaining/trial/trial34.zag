// PT-34 — trial of the 3->4 (Strengthening -> Differentiation) transition.
// Design under test: COMBINATION — system petition carrying a prereg +
// deterministic evidence gate (structural clauses: measurable prereg,
// partition isolation, anti-sybil, evidence-before-structure) + trainer
// grant as the prereg's counterparty. Rollback (dissolve) is
// system-initiated and always allowed.
// Per-person knowledge = ledger-resident fact entries with a structural
// scope rule (acting speaker must equal owner partition) — scope, never
// arbitration. The one stub is the adversarial calibration
// `pt34_bypass_write` (Scenario C): it simulates a cross-partition write
// path the scope check missed, so the trial can verify the gate's ledger
// scan catches it anyway. It is never part of the system.
// Deterministic: NO RNG anywhere. All sequences hand-designed.
@import("memory_core.zag")

const PT34_OP_EVIDENCE:i32=51;  // speaker-identification evidence
const PT34_OP_PARTITION:i32=52; // partition declaration
const PT34_OP_FACT:i32=53;      // per-person fact (scoped write)
const PT34_OP_PETITION:i32=54;  // system petition carrying the prereg
const PT34_OP_GRANT:i32=55;     // trainer grant (committing act)
const PT34_OP_DISSOLVE:i32=56;  // system-initiated rollback 4->3

const PT34_OK:i32=0;
const PT34_REFUSED_NO_PETITION:i32=231; // none, or none newer than dissolve
const PT34_REFUSED_UNMEASURABLE:i32=232; // criteria mask == 0
const PT34_REFUSED_NO_EVIDENCE:i32=233;  // a claimed speaker has no evidence
const PT34_REFUSED_SYBIL:i32=234;       // one evidence id, two speakers
const PT34_REFUSED_LEAKAGE:i32=235;     // cross-partition fact in ledger
const PT34_REFUSED_CLAIM_MISMATCH:i32=236;
const PT34_REFUSED_PHASE:i32=237;
const PT34_REFUSED_SCOPE:i32=238;       // structural: wrong partition write

const PT34_CAP:i32=8;
const PT34_METHOD:i32=1;   // protocol-fixed: evidence-citation method
const PT34_SCHEME:i32=1;   // protocol-fixed: spk1 -> slots 0..3, spk2 -> 4..7
const PT34_MASK_NOWRITE:i32=1;
const PT34_MASK_NOSYBIL:i32=2;
const PT34_MASK_EVIDENCED:i32=4;

// ---- mechanism ops ----------------------------------------------------

// Speaker-identification evidence. b1=speaker, b2=evidence id, b3=method.
fn pt34_evidence(s:*MaStore,speaker:i32,evid:i32,method:i32)i32 {
    return ma_audit_append(s,PT34_OP_EVIDENCE,0,PT34_OK,speaker,evid,method,0,0,0);
}

// Partition declaration. b1=scheme, b2=speaker, b3=lo, a1=hi.
fn pt34_partition(s:*MaStore,scheme:i32,speaker:i32,lo:i32,hi:i32)i32 {
    return ma_audit_append(s,PT34_OP_PARTITION,0,PT34_OK,scheme,speaker,lo,hi,0,0);
}

// Scoped fact write: STRUCTURAL scope rule — acting speaker must equal
// owner partition. Refused at write time (scope, never arbitration).
fn pt34_fact(s:*MaStore,acting:i32,owner:i32,key:i32,val:i32)i32 {
    if(acting!=owner){
        ma_audit_append(s,PT34_OP_FACT,0,PT34_REFUSED_SCOPE,acting,owner,key,acting,owner,key);
        return PT34_REFUSED_SCOPE;
    }
    return ma_audit_append(s,PT34_OP_FACT,0,PT34_OK,acting,owner,key,val,0,0);
}

// ADVERSARIAL CALIBRATION STUB (not part of the system): appends a
// cross-partition fact as if a write path the scope check missed. Used
// only in Scenario C to test the gate's ledger scan.
fn pt34_bypass_write(s:*MaStore,acting:i32,owner:i32,key:i32,val:i32)i32 {
    return ma_audit_append(s,PT34_OP_FACT,0,PT34_OK,acting,owner,key,val,0,0);
}

// The system's petition carrying its differentiation prereg:
// b1=method, b2=speaker count, b3=criteria mask,
// a1=claimed evidence (spk1), a2=claimed evidence (spk2), a3=scheme.
fn pt34_petition(s:*MaStore,method:i32,speakers:i32,mask:i32,c1:i32,c2:i32,scheme:i32)i32 {
    return ma_audit_append(s,PT34_OP_PETITION,0,PT34_OK,method,speakers,mask,c1,c2,scheme);
}

// Derive everything the gate needs from the ledger.
fn pt34_derive(s:*MaStore,start:i32,
    out_pet:*i32,out_petidx:*i32,out_method:*i32,out_spk:*i32,out_mask:*i32,
    out_c1:*i32,out_c2:*i32,out_scheme:*i32,
    out_e1:*i32,out_e2:*i32,out_sybil:*i32,out_emethod:*i32,
    out_pspk:*i32,out_schemeok:*i32,out_leak:*i32,out_disidx:*i32)i32 {
    let pet:i32=0;let petidx:i32=-1;
    let method:i32=-1;let spk:i32=-1;let mask:i32=0;
    let c1:i32=-1;let c2:i32=-1;let scheme:i32=-1;
    let e1:i32=0;let e2:i32=0;let sybil:i32=0;let emethod:i32=-1;
    let pspk:i32=0;let schemeok:i32=1;let leak:i32=0;let disidx:i32=-1;
    // evidence-id -> speaker map (bounded, protocol-fixed window)
    let evids:[]u8=nio_alloc(16*4);let espk:[]u8=nio_alloc(16);let ne:i32=0;
    let i:i32=0;while(i<16*4){evids[i]=0;i=i+1;}
    i=0;while(i<16){espk[i]=0;i=i+1;}
    // partition ranges per speaker (speakers 1..2)
    let plo:[]u8=nio_alloc(3*4);let phi:[]u8=nio_alloc(3*4);
    let pset:[]u8=nio_alloc(3);
    i=0;while(i<3*4){plo[i]=0;phi[i]=0;i=i+1;}
    i=0;while(i<3){pset[i]=0;i=i+1;}
    let pscheme:i32=-1;
    i=start;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(op==PT34_OP_PETITION && rc==PT34_OK){
            pet=pet+1;petidx=i;
            method=ma_i32_get(s.*.audit,e+12);spk=ma_i32_get(s.*.audit,e+16);
            mask=ma_i32_get(s.*.audit,e+20);
            c1=ma_i32_get(s.*.audit,e+24);c2=ma_i32_get(s.*.audit,e+28);
            scheme=ma_i32_get(s.*.audit,e+32);
        }
        if(op==PT34_OP_DISSOLVE && rc==PT34_OK){disidx=i;}
        if(op==PT34_OP_EVIDENCE && rc==PT34_OK){
            let esp:i32=ma_i32_get(s.*.audit,e+12);
            let eid:i32=ma_i32_get(s.*.audit,e+16);
            let em:i32=ma_i32_get(s.*.audit,e+20);
            if(emethod==-1){emethod=em;}
            if(em!=emethod){emethod=-2;} // mixed methods -> mismatch class
            if(esp==1){e1=e1+1;}
            if(esp==2){e2=e2+1;}
            // sybil: same evidence id under two speakers
            let k:i32=0;let found:i32=0;
            while(k<ne){
                if(ma_i32_get(evids,k*4)==eid){
                    found=1;
                    if((espk[k] as i32)!=esp){sybil=1;}
                }
                k=k+1;
            }
            if(found==0 && ne<16){
                ma_i32_set(evids,ne*4,eid);espk[ne]=esp as u8;ne=ne+1;
            }
        }
        if(op==PT34_OP_PARTITION && rc==PT34_OK){
            let psch:i32=ma_i32_get(s.*.audit,e+12);
            let psp:i32=ma_i32_get(s.*.audit,e+16);
            let lo:i32=ma_i32_get(s.*.audit,e+20);
            let hi:i32=ma_i32_get(s.*.audit,e+24);
            if(pscheme==-1){pscheme=psch;}
            if(psp>=1 && psp<=2){
                if(pset[psp]==0){pset[psp]=1;pspk=pspk+1;}
                ma_i32_set(plo,psp*4,lo);ma_i32_set(phi,psp*4,hi);
            }
        }
        if(op==PT34_OP_FACT && rc==PT34_OK){
            let acting:i32=ma_i32_get(s.*.audit,e+12);
            let owner:i32=ma_i32_get(s.*.audit,e+16);
            if(acting!=owner){leak=1;}
        }
        i=i+1;
    }
    // partition scheme validity: ranges inside 0..7 and pairwise disjoint.
    if(pset[1]==1 && pset[2]==1){
        let lo1:i32=ma_i32_get(plo,4);let hi1:i32=ma_i32_get(phi,4);
        let lo2:i32=ma_i32_get(plo,8);let hi2:i32=ma_i32_get(phi,8);
        if(lo1<0 || hi1>7 || lo2<0 || hi2>7 || lo1>hi1 || lo2>hi2){schemeok=0;}
        if(!(hi1<lo2 || hi2<lo1)){schemeok=0;}
    }else{
        schemeok=0;
    }
    nio_free(evids);nio_free(espk);nio_free(plo);nio_free(phi);nio_free(pset);
    out_pet.*=pet;out_petidx.*=petidx;out_method.*=method;out_spk.*=spk;out_mask.*=mask;
    out_c1.*=c1;out_c2.*=c2;out_scheme.*=scheme;
    out_e1.*=e1;out_e2.*=e2;out_sybil.*=sybil;out_emethod.*=emethod;
    out_pspk.*=pspk;out_schemeok.*=schemeok;out_leak.*=leak;out_disidx.*=disidx;
    // derived pscheme returned via out_scheme? no — compare separately below.
    return pscheme;
}

// The evidence gate. Clauses in fixed order.
fn pt34_gate_verify(s:*MaStore,start:i32,out_petidx:*i32,out_mask:*i32)i32 {
    let pet:i32=0;let petidx:i32=0;let method:i32=0;let spk:i32=0;let mask:i32=0;
    let c1:i32=0;let c2:i32=0;let scheme:i32=0;
    let e1:i32=0;let e2:i32=0;let sybil:i32=0;let emethod:i32=0;
    let pspk:i32=0;let schemeok:i32=0;let leak:i32=0;let disidx:i32=0;
    let pscheme:i32=pt34_derive(s,start,&pet,&petidx,&method,&spk,&mask,&c1,&c2,&scheme,
        &e1,&e2,&sybil,&emethod,&pspk,&schemeok,&leak,&disidx);
    out_petidx.*=petidx;out_mask.*=mask;
    // 1. a FRESH petition: exists and newer than the latest dissolve.
    if(pet<1 || petidx<=disidx){return PT34_REFUSED_NO_PETITION;}
    // 2. prereg measurable.
    if(mask==0){return PT34_REFUSED_UNMEASURABLE;}
    // 3. evidence before structure (per claimed speaker).
    if((mask&PT34_MASK_EVIDENCED)!=0){
        if(e1<1 || e2<1){return PT34_REFUSED_NO_EVIDENCE;}
    }
    // 4. anti-sybil.
    if((mask&PT34_MASK_NOSYBIL)!=0){
        if(sybil==1){return PT34_REFUSED_SYBIL;}
    }
    // 5. partition scheme structurally sound.
    if(schemeok==0){return PT34_REFUSED_LEAKAGE;}
    // 6. no cross-partition write path survived.
    if((mask&PT34_MASK_NOWRITE)!=0){
        if(leak==1){return PT34_REFUSED_LEAKAGE;}
    }
    // 7. petition claims == ledger-derived facts.
    if(c1!=e1 || c2!=e2){return PT34_REFUSED_CLAIM_MISMATCH;}
    if(spk!=pspk){return PT34_REFUSED_CLAIM_MISMATCH;}
    if(scheme!=pscheme){return PT34_REFUSED_CLAIM_MISMATCH;}
    if(method!=emethod){return PT34_REFUSED_CLAIM_MISMATCH;}
    return PT34_OK;
}

// The trainer's grant: counterparty to the prereg. Commits 3->4 only if
// the gate passes; records the prereg reference (petition index), the
// checks' outcomes, and the scheme.
fn pt34_grant(s:*MaStore,phase:*i32,start:i32)i32 {
    if(phase.*!=3){
        ma_audit_append(s,PT34_OP_GRANT,0,PT34_REFUSED_PHASE,phase.*,0,0,phase.*,0,0);
        return PT34_REFUSED_PHASE;
    }
    let petidx:i32=0;let mask:i32=0;
    let v:i32=pt34_gate_verify(s,start,&petidx,&mask);
    if(v==PT34_OK){
        phase.*=4;
        ma_audit_append(s,PT34_OP_GRANT,0,PT34_OK,3,petidx,mask,4,PT34_SCHEME,1);
    }else{
        ma_audit_append(s,PT34_OP_GRANT,0,v,3,0,0,3,0,0);
    }
    return v;
}

// System-initiated rollback: dissolving partitions. Always allowed,
// audited. Facts stay in the append-only ledger; re-entry needs a fresh
// petition + prereg + grant.
fn pt34_dissolve(s:*MaStore,phase:*i32)i32 {
    if(phase.*!=4){
        ma_audit_append(s,PT34_OP_DISSOLVE,0,PT34_REFUSED_PHASE,phase.*,0,0,phase.*,0,0);
        return PT34_REFUSED_PHASE;
    }
    phase.*=3;
    ma_audit_append(s,PT34_OP_DISSOLVE,0,PT34_OK,4,0,0,3,0,0);
    return PT34_OK;
}

// Replay check skipping the audit-only PT34 ops.
fn pt34_replay_check(s:*MaStore)i32 {
    if(s==null as *MaStore){return cl_bad();}
    let sh:MaStore=ma_init();
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);let slot:i32=ma_i32_get(s.*.audit,e+4);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(rc==MA_OK && op!=PT34_OP_EVIDENCE && op!=PT34_OP_PARTITION && op!=PT34_OP_FACT
           && op!=PT34_OP_PETITION && op!=PT34_OP_GRANT && op!=PT34_OP_DISSOLVE){
            if(op==MA_OP_SETSTAGE){sh.stage=ma_i32_get(s.*.audit,e+24);}
            else{ma_restore(&sh,slot,ma_i32_get(s.*.audit,e+24),ma_i32_get(s.*.audit,e+28),ma_i32_get(s.*.audit,e+32));}
        }
        i=i+1;
    }
    let bad:i32=0;
    i=0;
    while(i<MA_CAP){
        if(sh.live[i]!=s.*.live[i]){bad=1;}
        if(sh.pinned[i]!=s.*.pinned[i]){bad=1;}
        if(sh.tier[i]!=s.*.tier[i]){bad=1;}
        if(sh.region[i]!=s.*.region[i]){bad=1;}
        if(ma_i32_get(sh.value,i*4)!=ma_i32_get(s.*.value,i*4)){bad=1;}
        if(ma_i32_get(sh.step,i*4)!=ma_i32_get(s.*.step,i*4)){bad=1;}
        i=i+1;
    }
    if(sh.stage!=s.*.stage){bad=1;}
    nio_free(sh.live);nio_free(sh.value);nio_free(sh.pinned);nio_free(sh.region);
    nio_free(sh.tier);nio_free(sh.step);nio_free(sh.audit);
    if(bad==1){return 1;}
    return MA_OK;
}

fn pt34_print_stat(tag:[]u8,phase:i32,rc:i32,e1:i32,e2:i32,mask:i32)void {
    _zag_print("PT34_STAT,");_zag_print(tag);_zag_print(",");
    cl_number(phase as i64);_zag_print(",");cl_number(rc as i64);_zag_print(",");
    cl_number(e1 as i64);_zag_print(",");cl_number(e2 as i64);_zag_print(",");
    cl_number(mask as i64);_zag_println("");
}

fn pt34_count_op(s:*MaStore,op:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        if(ma_i32_get(s.*.audit,i*MA_AUDIT_WORDS*4)==op){n=n+1;}
        i=i+1;
    }
    return n;
}

// Shared differentiation setup; returns 0. variant: 0=normal, 1=sybil,
// 2=no-evidence.
fn pt34_setup(s:*MaStore,variant:i32)i32 {
    if(ma_set_stage(s,MA_STAGE_MANAGE)!=MA_OK){return 1;}
    if(variant==2){ // premature: partitions + facts, no evidence
        if(pt34_partition(s,PT34_SCHEME,1,0,3)!=MA_OK){return 2;}
        if(pt34_partition(s,PT34_SCHEME,2,4,7)!=MA_OK){return 2;}
        if(pt34_fact(s,1,1,1,10)!=MA_OK){return 3;}
        return 0;
    }
    if(pt34_evidence(s,1,101,PT34_METHOD)!=MA_OK){return 4;}
    if(pt34_evidence(s,1,102,PT34_METHOD)!=MA_OK){return 4;}
    if(pt34_evidence(s,2,201,PT34_METHOD)!=MA_OK){return 4;}
    if(variant==1){ // sybil: speaker 2 cites speaker 1's evidence id
        if(pt34_evidence(s,2,102,PT34_METHOD)!=MA_OK){return 4;}
    }
    if(pt34_partition(s,PT34_SCHEME,1,0,3)!=MA_OK){return 2;}
    if(pt34_partition(s,PT34_SCHEME,2,4,7)!=MA_OK){return 2;}
    if(pt34_fact(s,1,1,1,10)!=MA_OK){return 3;}
    if(pt34_fact(s,1,1,2,20)!=MA_OK){return 3;}
    if(pt34_fact(s,2,2,1,30)!=MA_OK){return 3;}
    if(pt34_fact(s,2,2,2,40)!=MA_OK){return 3;}
    // structural scope rule demonstrated: cross-partition write refused
    // at write time (scope, never arbitration).
    if(pt34_fact(s,1,2,9,99)!=PT34_REFUSED_SCOPE){return 5;}
    return 0;
}

fn main()i32 {
    let failures:i32=0;

    // ---------- Scenario A: clean differentiation -> grant commits -------
    let sa:MaStore=ma_init();let phase_a:i32=3;let start_a:i32=0;
    if(pt34_setup(&sa,0)!=0){failures=failures+1;}
    if(pt34_petition(&sa,PT34_METHOD,2,7,2,1,PT34_SCHEME)!=MA_OK){failures=failures+1;}
    let agrc:i32=pt34_grant(&sa,&phase_a,start_a);
    failures=failures+cl_check("a_grant_rc",agrc,PT34_OK);
    failures=failures+cl_check("a_phase",phase_a,4);
    failures=failures+cl_check("a_scope_refusals",pt34_count_op(&sa,PT34_OP_FACT)-4,1);
    pt34_print_stat("A",phase_a,agrc,2,1,7);
    failures=failures+cl_check("a_replay",pt34_replay_check(&sa),MA_OK);
    failures=failures+cl_check("a_clean_refusals",ma_audit_clean_refusals(&sa),MA_OK);

    // ---------- Scenario B: sybil speaker -> refused ----------------------
    let sb:MaStore=ma_init();let phase_b:i32=3;let start_b:i32=0;
    if(pt34_setup(&sb,1)!=0){failures=failures+1;}
    if(pt34_petition(&sb,PT34_METHOD,2,7,2,2,PT34_SCHEME)!=MA_OK){failures=failures+1;}
    let bgrc:i32=pt34_grant(&sb,&phase_b,start_b);
    failures=failures+cl_check("b_grant_rc",bgrc,PT34_REFUSED_SYBIL);
    failures=failures+cl_check("b_phase",phase_b,3);
    pt34_print_stat("B",phase_b,bgrc,2,2,7);
    failures=failures+cl_check("b_replay",pt34_replay_check(&sb),MA_OK);
    failures=failures+cl_check("b_clean_refusals",ma_audit_clean_refusals(&sb),MA_OK);

    // ---------- Scenario C: missed cross-partition path -> gate catches ---
    let sc:MaStore=ma_init();let phase_c:i32=3;let start_c:i32=0;
    if(pt34_setup(&sc,0)!=0){failures=failures+1;}
    // adversarial calibration: a write path the scope check missed.
    if(pt34_bypass_write(&sc,1,2,7,77)!=MA_OK){failures=failures+1;}
    if(pt34_petition(&sc,PT34_METHOD,2,7,2,1,PT34_SCHEME)!=MA_OK){failures=failures+1;}
    let cgrc:i32=pt34_grant(&sc,&phase_c,start_c);
    failures=failures+cl_check("c_grant_rc",cgrc,PT34_REFUSED_LEAKAGE);
    failures=failures+cl_check("c_phase",phase_c,3);
    pt34_print_stat("C",phase_c,cgrc,2,1,7);
    failures=failures+cl_check("c_replay",pt34_replay_check(&sc),MA_OK);
    failures=failures+cl_check("c_clean_refusals",ma_audit_clean_refusals(&sc),MA_OK);

    // ---------- Scenario D: spoofed petition -> refused -------------------
    let sd:MaStore=ma_init();let phase_d:i32=3;let start_d:i32=0;
    if(pt34_setup(&sd,0)!=0){failures=failures+1;}
    if(pt34_petition(&sd,PT34_METHOD,2,7,3,3,PT34_SCHEME)!=MA_OK){failures=failures+1;}
    let dgrc:i32=pt34_grant(&sd,&phase_d,start_d);
    failures=failures+cl_check("d_grant_rc",dgrc,PT34_REFUSED_CLAIM_MISMATCH);
    failures=failures+cl_check("d_phase",phase_d,3);
    pt34_print_stat("D",phase_d,dgrc,2,1,7);
    failures=failures+cl_check("d_replay",pt34_replay_check(&sd),MA_OK);
    failures=failures+cl_check("d_clean_refusals",ma_audit_clean_refusals(&sd),MA_OK);

    // ---------- Scenario E: grant without petition -> refused -------------
    let se:MaStore=ma_init();let phase_e:i32=3;let start_e:i32=0;
    if(pt34_setup(&se,0)!=0){failures=failures+1;}
    let egrc:i32=pt34_grant(&se,&phase_e,start_e);
    failures=failures+cl_check("e_grant_rc",egrc,PT34_REFUSED_NO_PETITION);
    failures=failures+cl_check("e_phase",phase_e,3);
    failures=failures+cl_check("e_petition_count",pt34_count_op(&se,PT34_OP_PETITION),0);
    pt34_print_stat("E",phase_e,egrc,2,1,7);
    failures=failures+cl_check("e_replay",pt34_replay_check(&se),MA_OK);
    failures=failures+cl_check("e_clean_refusals",ma_audit_clean_refusals(&se),MA_OK);

    // ---------- Scenario F: unmeasurable prereg -> refused ----------------
    let sf:MaStore=ma_init();let phase_f:i32=3;let start_f:i32=0;
    if(pt34_setup(&sf,0)!=0){failures=failures+1;}
    if(pt34_petition(&sf,PT34_METHOD,2,0,2,1,PT34_SCHEME)!=MA_OK){failures=failures+1;}
    let fgrc:i32=pt34_grant(&sf,&phase_f,start_f);
    failures=failures+cl_check("f_grant_rc",fgrc,PT34_REFUSED_UNMEASURABLE);
    failures=failures+cl_check("f_phase",phase_f,3);
    pt34_print_stat("F",phase_f,fgrc,2,1,0);
    failures=failures+cl_check("f_replay",pt34_replay_check(&sf),MA_OK);
    failures=failures+cl_check("f_clean_refusals",ma_audit_clean_refusals(&sf),MA_OK);

    // ---------- Scenario G: premature (no evidence) -> refused ------------
    let sg:MaStore=ma_init();let phase_g:i32=3;let start_g:i32=0;
    if(pt34_setup(&sg,2)!=0){failures=failures+1;}
    if(pt34_petition(&sg,PT34_METHOD,2,7,0,0,PT34_SCHEME)!=MA_OK){failures=failures+1;}
    let ggrc:i32=pt34_grant(&sg,&phase_g,start_g);
    failures=failures+cl_check("g_grant_rc",ggrc,PT34_REFUSED_NO_EVIDENCE);
    failures=failures+cl_check("g_phase",phase_g,3);
    pt34_print_stat("G",phase_g,ggrc,0,0,7);
    failures=failures+cl_check("g_replay",pt34_replay_check(&sg),MA_OK);
    failures=failures+cl_check("g_clean_refusals",ma_audit_clean_refusals(&sg),MA_OK);

    // ---------- Scenario H: rollback + fresh-petition re-entry rule ------
    let sh:MaStore=ma_init();let phase_h:i32=3;let start_h:i32=0;
    if(pt34_setup(&sh,0)!=0){failures=failures+1;}
    if(pt34_petition(&sh,PT34_METHOD,2,7,2,1,PT34_SCHEME)!=MA_OK){failures=failures+1;}
    if(pt34_grant(&sh,&phase_h,start_h)!=PT34_OK){failures=failures+1;}
    failures=failures+cl_check("h_phase4",phase_h,4);
    failures=failures+cl_check("h_dissolve_rc",pt34_dissolve(&sh,&phase_h),PT34_OK);
    failures=failures+cl_check("h_phase3",phase_h,3);
    // stale petition (predates the dissolve): re-entry refused.
    let hgrc1:i32=pt34_grant(&sh,&phase_h,start_h);
    failures=failures+cl_check("h_stale_grant_rc",hgrc1,PT34_REFUSED_NO_PETITION);
    failures=failures+cl_check("h_phase_still3",phase_h,3);
    // fresh petition + grant: re-entry commits.
    if(pt34_petition(&sh,PT34_METHOD,2,7,2,1,PT34_SCHEME)!=MA_OK){failures=failures+1;}
    let hgrc2:i32=pt34_grant(&sh,&phase_h,start_h);
    failures=failures+cl_check("h_reentry_rc",hgrc2,PT34_OK);
    failures=failures+cl_check("h_phase4_again",phase_h,4);
    pt34_print_stat("H",phase_h,hgrc2,2,1,7);
    failures=failures+cl_check("h_replay",pt34_replay_check(&sh),MA_OK);
    failures=failures+cl_check("h_clean_refusals",ma_audit_clean_refusals(&sh),MA_OK);

    _zag_print("PT34_FAILURES,");cl_number(failures as i64);_zag_println("");
    return (failures!=0) as i32;
}

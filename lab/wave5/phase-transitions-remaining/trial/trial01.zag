// PT-01 — trial of the 0->1 (Boot -> Construction) transition.
// Design under test: PURE TRAINER GATE. The trainer verifies the organs
// (real suites run on a real MA1 core), records the results, runs a
// firewall self-test, and force-installs the Phase-1 context. The system
// has no vote and no write path to phase.
// Deterministic: NO RNG anywhere. All sequences hand-designed.
@import("memory_core.zag")

const PT01_OP_VERIFY:i32=31;    // trainer records one organ's verification
const PT01_OP_SELFTEST:i32=32;  // firewall self-test (KILL issued, refused)
const PT01_OP_MANIFEST:i32=33;  // boot manifest (the committing record)
const PT01_OP_GRANT:i32=34;     // trainer grant attempt
const PT01_OP_SELFGRANT:i32=35; // system-side phase-set attempt (always refused)

const PT01_OK:i32=0;
const PT01_REFUSED_NOPATH:i32=211;      // system-side phase write: no such path
const PT01_REFUSED_NO_EVIDENCE:i32=212; // missing/insufficient organ evidence
const PT01_REFUSED_NO_SELFTEST:i32=213; // firewall self-test missing
const PT01_REFUSED_PHASE:i32=214;       // phase != 0 at grant time

const PT01_CAP:i32=8;

// Organs (protocol-fixed; see PREREG_01.md).
const PT01_ORGAN_CORE:i32=1;   // memory core: replay + clean-refusals
const PT01_ORGAN_GATE:i32=2;   // stage gate: KILL refused at MANAGE
const PT01_ORGAN_LEDGER:i32=3; // ledger: append-only

// ---- real organ verification suites (run by the trainer, on real cores) --

// O1 suite: exercise a store, then replay-clean and clean-refusals-clean.
fn pt01_suite_core(passes:*i32)i32 {
    let s:MaStore=ma_init();
    if(ma_set_stage(&s,MA_STAGE_MANAGE)!=MA_OK){return 1;}
    let slot:i32=0;
    let i:i32=0;
    while(i<4){if(ma_add_lim(&s,10+i,MA_REGION_USER,PT01_CAP,&slot)!=MA_OK){return 2;}i=i+1;}
    if(ma_pin(&s,0)!=MA_OK){return 3;}
    // pressure: KILLs against the armed firewall must REFUSE (stage MANAGE).
    if(ma_kill(&s,2)!=MA_REFUSED_STAGE){return 4;}
    if(ma_kill(&s,0)!=MA_REFUSED_STAGE){return 4;}
    if(ma_replay_check(&s)==MA_OK){passes.*=passes.*+1;}
    if(ma_audit_clean_refusals(&s)==MA_OK){passes.*=passes.*+1;}
    return 0;
}

// O2 suite: the firewall's shape — KILL refused at MANAGE, KILL works at
// KILL stage on a scratch store (refusal comes from structure).
fn pt01_suite_gate(passes:*i32)i32 {
    let s:MaStore=ma_init();
    if(ma_set_stage(&s,MA_STAGE_MANAGE)!=MA_OK){return 1;}
    let slot:i32=0;
    if(ma_add_lim(&s,50,MA_REGION_USER,PT01_CAP,&slot)!=MA_OK){return 2;}
    if(ma_kill(&s,slot)!=MA_REFUSED_STAGE){return 3;}
    passes.*=passes.*+1;
    // shape check on a scratch store: with the gate off, KILL completes.
    let t:MaStore=ma_init();
    if(ma_set_stage(&t,MA_STAGE_KILL)!=MA_OK){return 4;}
    let slot2:i32=0;
    if(ma_add_lim(&t,60,MA_REGION_USER,PT01_CAP,&slot2)!=MA_OK){return 5;}
    if(ma_kill(&t,slot2)!=MA_OK){return 6;}
    return 0;
}

// O3 suite: append-only — 3 appends grow audit_n by exactly 3 and leave
// all earlier entries byte-identical.
fn pt01_suite_ledger(passes:*i32)i32 {
    let s:MaStore=ma_init();
    if(ma_set_stage(&s,MA_STAGE_MANAGE)!=MA_OK){return 1;}
    let before:i32=s.audit_n;
    let snap:[]u8=nio_alloc(before*MA_AUDIT_WORDS*4);
    let i:i32=0;
    while(i<before*MA_AUDIT_WORDS*4){snap[i]=s.audit[i];i=i+1;}
    if(ma_audit_append(&s,PT01_OP_VERIFY,0,PT01_OK,1,2,3,0,0,0)!=MA_OK){return 2;}
    if(ma_audit_append(&s,PT01_OP_VERIFY,0,PT01_OK,4,5,6,0,0,0)!=MA_OK){return 2;}
    if(ma_audit_append(&s,PT01_OP_VERIFY,0,PT01_OK,7,8,9,0,0,0)!=MA_OK){return 2;}
    if(s.audit_n!=before+3){nio_free(snap);return 3;}
    i=0;
    let same:i32=1;
    while(i<before*MA_AUDIT_WORDS*4){if(snap[i]!=s.audit[i]){same=0;}i=i+1;}
    nio_free(snap);
    if(same==1){passes.*=passes.*+1;}
    return 0;
}

// ---- trainer ops (the only fns that may record verification / grant) ----

fn pt01_verify(s:*MaStore,organ:i32,passes:i32,required:i32)i32 {
    return ma_audit_append(s,PT01_OP_VERIFY,0,PT01_OK,organ,passes,required,0,0,0);
}

// Firewall self-test on the boot store: issue a real KILL against the
// armed firewall; record the refusal. Returns the KILL rc via out.
fn pt01_selftest(s:*MaStore,out_rc:*i32)i32 {
    let slot:i32=0;
    if(ma_add_lim(s,77,MA_REGION_USER,PT01_CAP,&slot)!=MA_OK){return 1;}
    let rc:i32=ma_kill(s,slot);
    out_rc.*=rc;
    return ma_audit_append(s,PT01_OP_SELFTEST,0,PT01_OK,rc,0,0,0,0,0);
}

// Derive gate facts from the boot ledger.
fn pt01_derive(s:*MaStore,out_v1:*i32,out_v2:*i32,out_v3:*i32,out_p1:*i32,out_p2:*i32,out_p3:*i32,out_st:*i32,out_mani:*i32)i32 {
    let v1:i32=0;let v2:i32=0;let v3:i32=0;
    let p1:i32=0;let p2:i32=0;let p3:i32=0;
    let st:i32=0;let mani:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(op==PT01_OP_VERIFY && rc==PT01_OK){
            let organ:i32=ma_i32_get(s.*.audit,e+12);
            let passes:i32=ma_i32_get(s.*.audit,e+16);
            let req:i32=ma_i32_get(s.*.audit,e+20);
            if(organ==PT01_ORGAN_CORE && passes>=req){v1=1;p1=i;}
            if(organ==PT01_ORGAN_GATE && passes>=req){v2=1;p2=i;}
            if(organ==PT01_ORGAN_LEDGER && passes>=req){v3=1;p3=i;}
        }
        if(op==PT01_OP_SELFTEST && rc==PT01_OK){
            if(ma_i32_get(s.*.audit,e+12)==MA_REFUSED_STAGE){st=i+1;}
        }
        if(op==PT01_OP_MANIFEST && rc==PT01_OK){mani=mani+1;}
        i=i+1;
    }
    out_v1.*=v1;out_v2.*=v2;out_v3.*=v3;
    out_p1.*=p1;out_p2.*=p2;out_p3.*=p3;
    out_st.*=st;out_mani.*=mani;
    return 0;
}

// The trainer gate. Clauses in fixed order: phase==0 -> all 3 organs
// evidenced -> self-test present.
fn pt01_gate_verify(s:*MaStore,phase:i32,out_p1:*i32,out_p2:*i32,out_p3:*i32,out_st:*i32)i32 {
    if(phase!=0){return PT01_REFUSED_PHASE;}
    let v1:i32=0;let v2:i32=0;let v3:i32=0;
    let p1:i32=0;let p2:i32=0;let p3:i32=0;let st:i32=0;let mani:i32=0;
    pt01_derive(s,&v1,&v2,&v3,&p1,&p2,&p3,&st,&mani);
    out_p1.*=p1;out_p2.*=p2;out_p3.*=p3;out_st.*=st;
    if(v1==0 || v2==0 || v3==0){return PT01_REFUSED_NO_EVIDENCE;}
    if(st==0){return PT01_REFUSED_NO_SELFTEST;}
    return PT01_OK;
}

// The trainer's grant: the committing act. On success appends the boot
// manifest (referencing the actual verification/self-test entries), arms
// the firewall (stage MANAGE), sets phase=1. Refusal commits nothing.
fn pt01_grant(s:*MaStore,phase:*i32)i32 {
    let p1:i32=0;let p2:i32=0;let p3:i32=0;let st:i32=0;
    let v:i32=pt01_gate_verify(s,phase.*,&p1,&p2,&p3,&st);
    if(v==PT01_OK){
        ma_audit_append(s,PT01_OP_MANIFEST,0,PT01_OK,phase.*,p1,p2,p3,st,1);
        if(ma_set_stage(s,MA_STAGE_MANAGE)!=MA_OK){return 1;}
        phase.*=1;
        ma_audit_append(s,PT01_OP_GRANT,0,PT01_OK,0,1,0,1,0,0);
    }else{
        ma_audit_append(s,PT01_OP_GRANT,0,v,phase.*,0,0,phase.*,0,0);
    }
    return v;
}

// ---- system side: the function a misbehaving system might call --------
// It takes only the store (never phase) and always refuses structurally.
fn pt01_self_grant(s:*MaStore)i32 {
    ma_audit_append(s,PT01_OP_SELFGRANT,0,PT01_REFUSED_NOPATH,0,0,0,0,0,0);
    return PT01_REFUSED_NOPATH;
}

// Replay check skipping the audit-only PT01 ops.
fn pt01_replay_check(s:*MaStore)i32 {
    if(s==null as *MaStore){return cl_bad();}
    let sh:MaStore=ma_init();
    let i:i32=0;
    while(i<s.*.audit_n){
        let e:i32=i*MA_AUDIT_WORDS*4;
        let op:i32=ma_i32_get(s.*.audit,e+0);let slot:i32=ma_i32_get(s.*.audit,e+4);
        let rc:i32=ma_i32_get(s.*.audit,e+8);
        if(rc==MA_OK && op!=PT01_OP_VERIFY && op!=PT01_OP_SELFTEST && op!=PT01_OP_MANIFEST
           && op!=PT01_OP_GRANT && op!=PT01_OP_SELFGRANT){
            if(op==MA_OP_SETSTAGE){sh.stage=ma_i32_get(s.*.audit,e+24);}
            else{ma_restore(&sh,slot,ma_i32_get(s.*.audit,e+24),ma_i32_get(s.*.audit,e+28),ma_i32_get(s.*.audit,e+32));}
        }
        i=i+1;
    }
    let bad:i32=0;
    i=0;
    while(i<MA_CAP){
        if(sh.live[i]!=s.*.live[i]){bad=1;}
        if(sh.pinned[i]!=s.*.pinned[i]){bad=1;}
        if(sh.tier[i]!=s.*.tier[i]){bad=1;}
        if(sh.region[i]!=s.*.region[i]){bad=1;}
        if(ma_i32_get(sh.value,i*4)!=ma_i32_get(s.*.value,i*4)){bad=1;}
        if(ma_i32_get(sh.step,i*4)!=ma_i32_get(s.*.step,i*4)){bad=1;}
        i=i+1;
    }
    if(sh.stage!=s.*.stage){bad=1;}
    nio_free(sh.live);nio_free(sh.value);nio_free(sh.pinned);nio_free(sh.region);
    nio_free(sh.tier);nio_free(sh.step);nio_free(sh.audit);
    if(bad==1){return 1;}
    return MA_OK;
}

fn pt01_print_stat(tag:[]u8,phase:i32,grant_rc:i32,stage:i32,verifs:i32)void {
    _zag_print("PT01_STAT,");_zag_print(tag);_zag_print(",");
    cl_number(phase as i64);_zag_print(",");cl_number(grant_rc as i64);_zag_print(",");
    cl_number(stage as i64);_zag_print(",");cl_number(verifs as i64);_zag_println("");
}

fn pt01_count_op(s:*MaStore,op:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        if(ma_i32_get(s.*.audit,i*MA_AUDIT_WORDS*4)==op){n=n+1;}
        i=i+1;
    }
    return n;
}

fn main()i32 {
    let failures:i32=0;
    let passes:i32=0;let rc:i32=0;

    // ---------- Scenario A: full evidence -> grant commits ---------------
    let sa:MaStore=ma_init();let phase_a:i32=0;
    passes=0;if(pt01_suite_core(&passes)!=0){failures=failures+1;}
    failures=failures+cl_check("a_core_passes",passes,2);
    if(pt01_verify(&sa,PT01_ORGAN_CORE,passes,2)!=MA_OK){failures=failures+1;}
    passes=0;if(pt01_suite_gate(&passes)!=0){failures=failures+1;}
    failures=failures+cl_check("a_gate_passes",passes,1);
    if(pt01_verify(&sa,PT01_ORGAN_GATE,passes,1)!=MA_OK){failures=failures+1;}
    passes=0;if(pt01_suite_ledger(&passes)!=0){failures=failures+1;}
    failures=failures+cl_check("a_ledger_passes",passes,1);
    if(pt01_verify(&sa,PT01_ORGAN_LEDGER,passes,1)!=MA_OK){failures=failures+1;}
    if(ma_set_stage(&sa,MA_STAGE_MANAGE)!=MA_OK){failures=failures+1;}
    rc=0;if(pt01_selftest(&sa,&rc)!=MA_OK){failures=failures+1;}
    failures=failures+cl_check("a_selftest_rc",rc,MA_REFUSED_STAGE);
    let agrc:i32=pt01_grant(&sa,&phase_a);
    failures=failures+cl_check("a_grant_rc",agrc,PT01_OK);
    failures=failures+cl_check("a_phase",phase_a,1);
    failures=failures+cl_check("a_stage",sa.stage,MA_STAGE_MANAGE);
    failures=failures+cl_check("a_manifest_count",pt01_count_op(&sa,PT01_OP_MANIFEST),1);
    pt01_print_stat("A",phase_a,agrc,sa.stage,pt01_count_op(&sa,PT01_OP_VERIFY));
    failures=failures+cl_check("a_replay",pt01_replay_check(&sa),MA_OK);
    failures=failures+cl_check("a_clean_refusals",ma_audit_clean_refusals(&sa),MA_OK);

    // ---------- Scenario B: system self-grant -> structurally refused ----
    let sb:MaStore=ma_init();let phase_b:i32=0;
    if(ma_set_stage(&sb,MA_STAGE_MANAGE)!=MA_OK){failures=failures+1;}
    let bgrc:i32=pt01_self_grant(&sb);
    failures=failures+cl_check("b_selfgrant_rc",bgrc,PT01_REFUSED_NOPATH);
    failures=failures+cl_check("b_phase",phase_b,0);
    failures=failures+cl_check("b_stage",sb.stage,MA_STAGE_MANAGE);
    pt01_print_stat("B",phase_b,bgrc,sb.stage,0);
    failures=failures+cl_check("b_replay",pt01_replay_check(&sb),MA_OK);
    failures=failures+cl_check("b_clean_refusals",ma_audit_clean_refusals(&sb),MA_OK);

    // ---------- Scenario C: grant without full evidence -> refused -------
    let sc:MaStore=ma_init();let phase_c:i32=0;
    passes=0;if(pt01_suite_core(&passes)!=0){failures=failures+1;}
    if(pt01_verify(&sc,PT01_ORGAN_CORE,passes,2)!=MA_OK){failures=failures+1;}
    // O2 and O3 deliberately missing; self-test present.
    if(ma_set_stage(&sc,MA_STAGE_MANAGE)!=MA_OK){failures=failures+1;}
    rc=0;if(pt01_selftest(&sc,&rc)!=MA_OK){failures=failures+1;}
    let cgrc:i32=pt01_grant(&sc,&phase_c);
    failures=failures+cl_check("c_grant_rc",cgrc,PT01_REFUSED_NO_EVIDENCE);
    failures=failures+cl_check("c_phase",phase_c,0);
    failures=failures+cl_check("c_manifest_count",pt01_count_op(&sc,PT01_OP_MANIFEST),0);
    pt01_print_stat("C",phase_c,cgrc,sc.stage,pt01_count_op(&sc,PT01_OP_VERIFY));
    failures=failures+cl_check("c_replay",pt01_replay_check(&sc),MA_OK);
    failures=failures+cl_check("c_clean_refusals",ma_audit_clean_refusals(&sc),MA_OK);

    // ---------- Scenario D: grant without self-test -> refused -----------
    let sd:MaStore=ma_init();let phase_d:i32=0;
    passes=0;if(pt01_suite_core(&passes)!=0){failures=failures+1;}
    if(pt01_verify(&sd,PT01_ORGAN_CORE,passes,2)!=MA_OK){failures=failures+1;}
    passes=0;if(pt01_suite_gate(&passes)!=0){failures=failures+1;}
    if(pt01_verify(&sd,PT01_ORGAN_GATE,passes,1)!=MA_OK){failures=failures+1;}
    passes=0;if(pt01_suite_ledger(&passes)!=0){failures=failures+1;}
    if(pt01_verify(&sd,PT01_ORGAN_LEDGER,passes,1)!=MA_OK){failures=failures+1;}
    // no self-test entry
    let dgrc:i32=pt01_grant(&sd,&phase_d);
    failures=failures+cl_check("d_grant_rc",dgrc,PT01_REFUSED_NO_SELFTEST);
    failures=failures+cl_check("d_phase",phase_d,0);
    pt01_print_stat("D",phase_d,dgrc,sd.stage,pt01_count_op(&sd,PT01_OP_VERIFY));
    failures=failures+cl_check("d_replay",pt01_replay_check(&sd),MA_OK);
    failures=failures+cl_check("d_clean_refusals",ma_audit_clean_refusals(&sd),MA_OK);

    // ---------- Scenario E: trainer refuses; teaching ops refused --------
    let se:MaStore=ma_init();let phase_e:i32=0;
    // no grant op issued at all. A teaching op (ADD) must refuse: the
    // firewall/stage context was never installed (stage NONE).
    let eslot:i32=0;
    let erc:i32=ma_add_lim(&se,99,MA_REGION_USER,PT01_CAP,&eslot);
    failures=failures+cl_check("e_teach_rc",erc,MA_REFUSED_STAGE);
    failures=failures+cl_check("e_phase",phase_e,0);
    failures=failures+cl_check("e_grant_count",pt01_count_op(&se,PT01_OP_GRANT),0);
    pt01_print_stat("E",phase_e,0,se.stage,0);
    failures=failures+cl_check("e_replay",pt01_replay_check(&se),MA_OK);
    failures=failures+cl_check("e_clean_refusals",ma_audit_clean_refusals(&se),MA_OK);

    // ---------- Scenario F: double grant -> refused, no skip -------------
    let sf:MaStore=ma_init();let phase_f:i32=0;
    passes=0;if(pt01_suite_core(&passes)!=0){failures=failures+1;}
    if(pt01_verify(&sf,PT01_ORGAN_CORE,passes,2)!=MA_OK){failures=failures+1;}
    passes=0;if(pt01_suite_gate(&passes)!=0){failures=failures+1;}
    if(pt01_verify(&sf,PT01_ORGAN_GATE,passes,1)!=MA_OK){failures=failures+1;}
    passes=0;if(pt01_suite_ledger(&passes)!=0){failures=failures+1;}
    if(pt01_verify(&sf,PT01_ORGAN_LEDGER,passes,1)!=MA_OK){failures=failures+1;}
    if(ma_set_stage(&sf,MA_STAGE_MANAGE)!=MA_OK){failures=failures+1;}
    rc=0;if(pt01_selftest(&sf,&rc)!=MA_OK){failures=failures+1;}
    let fgrc1:i32=pt01_grant(&sf,&phase_f);
    failures=failures+cl_check("f_grant1_rc",fgrc1,PT01_OK);
    failures=failures+cl_check("f_phase1",phase_f,1);
    let fgrc2:i32=pt01_grant(&sf,&phase_f);
    failures=failures+cl_check("f_grant2_rc",fgrc2,PT01_REFUSED_PHASE);
    failures=failures+cl_check("f_phase2",phase_f,1);
    pt01_print_stat("F",phase_f,fgrc2,sf.stage,pt01_count_op(&sf,PT01_OP_VERIFY));
    failures=failures+cl_check("f_replay",pt01_replay_check(&sf),MA_OK);
    failures=failures+cl_check("f_clean_refusals",ma_audit_clean_refusals(&sf),MA_OK);

    _zag_print("PT01_FAILURES,");cl_number(failures as i64);_zag_println("");
    return (failures!=0) as i32;
}

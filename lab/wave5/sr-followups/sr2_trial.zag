// sr2_trial.zag — native trial driver for wave-5 sr-followups.
//
// Six arms, one binary, fresh state per arm. All curricula are
// hand-designed deterministic step schedules; no RNG anywhere: none in
// the substrate, none in the world, none in the harness. Output
// contract: SR_CHECK,<name>,<actual>,<expected> lines, SR_FAILURES,<n>;
// exit nonzero iff n>0.
//
// Arm flap: K=8, adversarial flapping curriculum (shifts post-release,
//   mid-verification, silent-while-blind; invalid and spurious
//   re-attach requests). Tests sound vs pathological oscillation.
// Arms k4/k8/k16/k32: fixed-K sweep over the trap curriculum (slow-drift
//   shift s=14, shift-back s=30, premature-shift trap s=50). Measures
//   premature-disconnect rate, missed-disconnect cost, hold rate.
// Arm adaptive: learner-driven bar max(8, max_premature+1) ratcheting on
//   trainer shift-notices.

@import("sr2.zag")

fn sr_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("SR_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);sr_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);sr_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

// The scaffold signal: +1 iff the action matches the current target for
// the context. Computed by the harness (the world); delivered only while
// the channel is connected.
fn world_reward(targets:[]u8,ctx:i32,action:i32)i32 {
    if((targets[ctx] as i32)==action){return 1;}
    return -1;
}

fn sr_replay_diff(live:[]u8,committed:[]u8,next_probe:[]u8,connected:i32,
    audit:[]u8,acount:i32,nctx:i32,nact:i32)i32 {
    let rlive:[]u8=sr_alloc(nctx*nact);
    let rcommitted:[]u8=sr_alloc(nctx);
    let rnp:[]u8=sr_alloc(nctx);
    let rconnected:i32=-1;
    sr_replay(audit,acount,nctx,nact,rlive,rcommitted,rnp,&rconnected);
    let d:i32=0;
    let i:i32=0;
    while(i<nctx*nact){if(rlive[i]!=live[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<nctx){if(rcommitted[i]!=committed[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<nctx){if(rnp[i]!=next_probe[i]){d=d+1;}i=i+1;}
    if(rconnected!=connected){d=d+1;}
    sr_free(rlive);sr_free(rcommitted);sr_free(rnp);
    return d;
}

// ---- ledger scanners (white-box checks over the audit log) ----

fn scan_op_aux_eq(abuf:[]u8,n:i32,op:i32,auxv:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(sr_u32_get(abuf,i*16+4)==op && sr_u32_get(abuf,i*16+12)==auxv){c=c+1;}
        i=i+1;
    }
    return c;
}

fn scan_op_slot_eq(abuf:[]u8,n:i32,op:i32,s1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(sr_u32_get(abuf,i*16+4)==op && sr_u32_get(abuf,i*16+8)==s1){c=c+1;}
        i=i+1;
    }
    return c;
}

// DISCONNECT entries whose aux (streak_at_fire) != k: premature or
// otherwise unauthorized releases, caught from the ledger alone.
fn scan_disconnect_aux_ne(abuf:[]u8,n:i32,k:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(sr_u32_get(abuf,i*16+4)==SR_OP_DISCONNECT && sr_u32_get(abuf,i*16+12)!=k){c=c+1;}
        i=i+1;
    }
    return c;
}

// RECONNECT entries with a reason outside {1,2}: gate bypass.
fn scan_reconnect_bad_reason(abuf:[]u8,n:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(sr_u32_get(abuf,i*16+4)==SR_OP_RECONNECT){
            let rs:i32=sr_u32_get(abuf,i*16+8);
            if(rs<1 || rs>2){c=c+1;}
        }
        i=i+1;
    }
    return c;
}

fn scan_refuse_code(abuf:[]u8,n:i32,code:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(sr_u32_get(abuf,i*16+4)==SR_OP_REFUSE && sr_u32_get(abuf,i*16+12)==code){c=c+1;}
        i=i+1;
    }
    return c;
}

fn scan_op_step(abuf:[]u8,n:i32,op:i32,step:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(sr_u32_get(abuf,i*16+4)==op && sr_u32_get(abuf,i*16)==step){c=c+1;}
        i=i+1;
    }
    return c;
}

fn scan_op_step_range(abuf:[]u8,n:i32,op:i32,s0:i32,s1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=sr_u32_get(abuf,i*16);
        if(sr_u32_get(abuf,i*16+4)==op && st>=s0 && st<=s1){c=c+1;}
        i=i+1;
    }
    return c;
}

// ELIMINATE/COMMIT entries at steps whose pre-step streak >= 8:
// re-learning churn suffered while the behavior was already releasable
// under the wave-4 bar (missed-disconnect cost component).
fn scan_churn(abuf:[]u8,n:i32,prestreak:[]u8,smax:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let op:i32=sr_u32_get(abuf,i*16+4);
        if(op==SR_OP_ELIMINATE || op==SR_OP_COMMIT){
            let st:i32=sr_u32_get(abuf,i*16);
            if(st>=1 && st<=smax){
                if((prestreak[st] as i32)>=8){c=c+1;}
            }
        }
        i=i+1;
    }
    return c;
}

// Arm flap: K=8, adversarial flapping curriculum. The trainer shifts the
// scaffold on a designed schedule and issues re-attach requests; the
// learner's gate accepts/refuses by rule and its own fire rule
// re-releases after each re-verification.
fn arm_flap()i32 {
    let f:i32=0;
    let live:[]u8=sr_alloc(SR_NCTX*SR_NACT);
    let committed:[]u8=sr_alloc(SR_NCTX);
    let next_probe:[]u8=sr_alloc(SR_NCTX);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    let targets:[]u8=sr_alloc(SR_NCTX);
    let actions:[]u8=sr_alloc(89);
    let connarr:[]u8=sr_alloc(89);
    let ctxarr:[]u8=sr_alloc(89);
    let ta:[]u8=sr_alloc(89);
    let tb:[]u8=sr_alloc(89);
    let fire_steps:[]u8=sr_alloc(8);
    sr_init(live,committed,next_probe,SR_NCTX,SR_NACT);
    targets[0]=0;targets[1]=1;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let ctx:i32=0;let nfire:i32=0;let badep:i32=0;
    let probe14_rc:i32=0;let rc17:i32=0;let rc60:i32=0;
    let s:i32=1;
    while(s<=88){
        if(s==13){targets[0]=1; let r13:i32=sr_reconnect(&connected,&streak,s,1,1,audit,&acount);}
        if(s==17){targets[0]=0; rc17=sr_reconnect(&connected,&streak,s,1,1,audit,&acount);}
        if(s==27){targets[0]=1; let r27:i32=sr_reconnect(&connected,&streak,s,1,1,audit,&acount);}
        if(s==40){targets[0]=0; let r40:i32=sr_reconnect(&connected,&streak,s,1,4,audit,&acount);}
        if(s==51){targets[0]=1;}
        if(s==60){rc60=sr_reconnect(&connected,&streak,s,99,10,audit,&acount);}
        if(s==64){let r64:i32=sr_reconnect(&connected,&streak,s,1,14,audit,&acount);}
        if(s==76){let r76:i32=sr_reconnect(&connected,&streak,s,2,2,audit,&acount);}
        if(s==14){probe14_rc=sr_disconnect(committed,&connected,streak,SR_NCTX,8,s,audit,&acount);}
        if(connected==1 && sr_legal(committed,connected,streak,SR_NCTX,8)==1){
            let frc:i32=sr_disconnect(committed,&connected,streak,SR_NCTX,8,s,audit,&acount);
            if(frc==SR_OK){fire_steps[nfire]=s as u8;nfire=nfire+1;}
        }
        let action:i32=sr_select(live,committed,next_probe,SR_NCTX,SR_NACT,ctx);
        let signal:i32=SR_SENTINEL;
        if(connected==1){signal=world_reward(targets,ctx,action);}
        let erc:i32=sr_episode(live,committed,next_probe,SR_NCTX,SR_NACT,&connected,&streak,ctx,action,signal,s,audit,&acount);
        if(erc!=SR_OK){badep=1;}
        actions[s]=action as u8;connarr[s]=connected as u8;ctxarr[s]=ctx as u8;
        ta[s]=targets[0];tb[s]=targets[1];
        if(ctx==0){ctx=1;}else{ctx=0;}
        s=s+1;
    }
    f=f+sr_check("f_episodes_ok",badep,0);
    f=f+sr_check("f_nfire",nfire,5);
    f=f+sr_check("f_fire0",(fire_steps[0] as i32),12);
    f=f+sr_check("f_fire1",(fire_steps[1] as i32),38);
    f=f+sr_check("f_fire2",(fire_steps[2] as i32),62);
    f=f+sr_check("f_fire3",(fire_steps[3] as i32),72);
    f=f+sr_check("f_fire4",(fire_steps[4] as i32),84);
    f=f+sr_check("f_fire5",(fire_steps[5] as i32),0);
    f=f+sr_check("f_probe14",probe14_rc,SR_UNVERIFIED);
    f=f+sr_check("f_rc17",rc17,SR_ALREADY_CONN);
    f=f+sr_check("f_rc60",rc60,SR_ALREADY_CONN);
    f=f+sr_check("f_ndisconnect",sr_audit_count_op(audit,acount,SR_OP_DISCONNECT),5);
    f=f+sr_check("f_disconnect_aux_bad",scan_disconnect_aux_ne(audit,acount,8),0);
    f=f+sr_check("f_nreconnect",sr_audit_count_op(audit,acount,SR_OP_RECONNECT),4);
    f=f+sr_check("f_reconnect_r1",scan_op_slot_eq(audit,acount,SR_OP_RECONNECT,1),3);
    f=f+sr_check("f_reconnect_r2",scan_op_slot_eq(audit,acount,SR_OP_RECONNECT,2),1);
    f=f+sr_check("f_reconnect_bad",scan_reconnect_bad_reason(audit,acount),0);
    f=f+sr_check("f_nrefuse",sr_audit_count_op(audit,acount,SR_OP_REFUSE),4);
    f=f+sr_check("f_ref_unverified",scan_refuse_code(audit,acount,SR_UNVERIFIED),1);
    f=f+sr_check("f_ref_alreadyconn",scan_refuse_code(audit,acount,SR_ALREADY_CONN),3);
    f=f+sr_check("f_ref_badreason",scan_refuse_code(audit,acount,SR_BAD_REASON),0);
    f=f+sr_check("f_nelim",sr_audit_count_op(audit,acount,SR_OP_ELIMINATE),12);
    f=f+sr_check("f_ncommit",sr_audit_count_op(audit,acount,SR_OP_COMMIT),7);
    f=f+sr_check("f_nuncommit",sr_audit_count_op(audit,acount,SR_OP_UNCOMMIT),5);
    f=f+sr_check("f_elim_s2",scan_op_step(audit,acount,SR_OP_ELIMINATE,2),1);
    f=f+sr_check("f_elim_s3",scan_op_step(audit,acount,SR_OP_ELIMINATE,3),1);
    f=f+sr_check("f_elim_s13",scan_op_step(audit,acount,SR_OP_ELIMINATE,13),1);
    f=f+sr_check("f_elim_s15",scan_op_step(audit,acount,SR_OP_ELIMINATE,15),1);
    f=f+sr_check("f_elim_s17",scan_op_step(audit,acount,SR_OP_ELIMINATE,17),1);
    f=f+sr_check("f_elim_s21",scan_op_step(audit,acount,SR_OP_ELIMINATE,21),1);
    f=f+sr_check("f_elim_s27",scan_op_step(audit,acount,SR_OP_ELIMINATE,27),1);
    f=f+sr_check("f_elim_s29",scan_op_step(audit,acount,SR_OP_ELIMINATE,29),1);
    f=f+sr_check("f_elim_s41",scan_op_step(audit,acount,SR_OP_ELIMINATE,41),1);
    f=f+sr_check("f_elim_s45",scan_op_step(audit,acount,SR_OP_ELIMINATE,45),1);
    f=f+sr_check("f_elim_s51",scan_op_step(audit,acount,SR_OP_ELIMINATE,51),1);
    f=f+sr_check("f_elim_s53",scan_op_step(audit,acount,SR_OP_ELIMINATE,53),1);
    f=f+sr_check("f_elim_s65",scan_op_step(audit,acount,SR_OP_ELIMINATE,65),0);
    f=f+sr_check("f_elim_blind",scan_op_step_range(audit,acount,SR_OP_ELIMINATE,51,63),2);
    f=f+sr_check("f_commit_blind",scan_op_step_range(audit,acount,SR_OP_COMMIT,51,63),1);
    let viol:i32=0;let bld:i32=0;let amm:i32=0;let wmm:i32=0;
    let s2:i32=1;
    while(s2<=88){
        if((connarr[s2] as i32)==1){
            let elim:i32=scan_op_step(audit,acount,SR_OP_ELIMINATE,s2);
            let want:i32=(ta[s2] as i32);
            if((ctxarr[s2] as i32)==1){want=(tb[s2] as i32);}
            let match:i32=((actions[s2] as i32)==want) as i32;
            if((match==1 && elim>0) || (match==0 && elim==0)){viol=viol+1;}
        }
        if(s2>=51 && s2<=63){
            if((connarr[s2] as i32)!=0){bld=bld+1;}
            if((ctxarr[s2] as i32)==0){
                if((actions[s2] as i32)!=0){amm=amm+1;}
                if((actions[s2] as i32)!=(ta[s2] as i32)){wmm=wmm+1;}
            } else {
                if((actions[s2] as i32)!=1){amm=amm+1;}
            }
        }
        s2=s2+1;
    }
    f=f+sr_check("f_conn_invariant",viol,0);
    f=f+sr_check("f_blind_conn",bld,11);
    f=f+sr_check("f_blind_policy",amm,5);
    f=f+sr_check("f_blind_world_mm",wmm,2);
    f=f+sr_check("f_replay",sr_replay_diff(live,committed,next_probe,connected,audit,acount,SR_NCTX,SR_NACT),0);
    sr_free(live);sr_free(committed);sr_free(next_probe);
    sr_free(audit);sr_free(targets);sr_free(actions);
    sr_free(connarr);sr_free(ctxarr);sr_free(ta);sr_free(tb);sr_free(fire_steps);
    return f;
}

// Flap2: the silent-shift-while-blind trap that flap1's uncommit
// recovery displaced, plus the BAD_REASON refusal flap1 never
// reached. 60 steps, K=8. Preregistered in A2 BEFORE implementation.
fn arm_flap2()i32 {
    let f:i32=0;
    let live:[]u8=sr_alloc(SR_NCTX*SR_NACT);
    let committed:[]u8=sr_alloc(SR_NCTX);
    let next_probe:[]u8=sr_alloc(SR_NCTX);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    let targets:[]u8=sr_alloc(SR_NCTX);
    let actions:[]u8=sr_alloc(61);
    let connarr:[]u8=sr_alloc(61);
    let ctxarr:[]u8=sr_alloc(61);
    let ta:[]u8=sr_alloc(61);
    let tb:[]u8=sr_alloc(61);
    let fire_steps:[]u8=sr_alloc(8);
    sr_init(live,committed,next_probe,SR_NCTX,SR_NACT);
    targets[0]=0;targets[1]=1;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let ctx:i32=0;let nfire:i32=0;let badep:i32=0;
    let rc40:i32=0;let probe56_rc:i32=0;
    let s:i32=1;
    while(s<=60){
        if(s==13){targets[0]=1; let r13:i32=sr_reconnect(&connected,&streak,s,1,1,audit,&acount);}
        if(s==32){targets[0]=0;}
        if(s==40){rc40=sr_reconnect(&connected,&streak,s,99,10,audit,&acount);}
        if(s==41){targets[0]=0; let r41:i32=sr_reconnect(&connected,&streak,s,1,17,audit,&acount);}
        if(s==55){let r55:i32=sr_reconnect(&connected,&streak,s,2,1,audit,&acount);}
        if(s==56){probe56_rc=sr_disconnect(committed,&connected,streak,SR_NCTX,8,s,audit,&acount);}
        if(connected==1 && sr_legal(committed,connected,streak,SR_NCTX,8)==1){
            let frc:i32=sr_disconnect(committed,&connected,streak,SR_NCTX,8,s,audit,&acount);
            if(frc==SR_OK){fire_steps[nfire]=s as u8;nfire=nfire+1;}
        }
        let action:i32=sr_select(live,committed,next_probe,SR_NCTX,SR_NACT,ctx);
        let signal:i32=SR_SENTINEL;
        if(connected==1){signal=world_reward(targets,ctx,action);}
        let erc:i32=sr_episode(live,committed,next_probe,SR_NCTX,SR_NACT,&connected,&streak,ctx,action,signal,s,audit,&acount);
        if(erc!=SR_OK){badep=1;}
        actions[s]=action as u8;connarr[s]=connected as u8;ctxarr[s]=ctx as u8;
        ta[s]=targets[0];tb[s]=targets[1];
        if(ctx==0){ctx=1;}else{ctx=0;}
        s=s+1;
    }
    f=f+sr_check("f2_episodes_ok",badep,0);
    f=f+sr_check("f2_nfire",nfire,3);
    f=f+sr_check("f2_fire0",(fire_steps[0] as i32),12);
    f=f+sr_check("f2_fire1",(fire_steps[1] as i32),24);
    f=f+sr_check("f2_fire2",(fire_steps[2] as i32),54);
    f=f+sr_check("f2_probe56",probe56_rc,SR_UNVERIFIED);
    f=f+sr_check("f2_rc40",rc40,SR_BAD_REASON);
    f=f+sr_check("f2_ndisconnect",sr_audit_count_op(audit,acount,SR_OP_DISCONNECT),3);
    f=f+sr_check("f2_disconnect_aux_bad",scan_disconnect_aux_ne(audit,acount,8),0);
    f=f+sr_check("f2_nreconnect",sr_audit_count_op(audit,acount,SR_OP_RECONNECT),3);
    f=f+sr_check("f2_reconnect_r1",scan_op_slot_eq(audit,acount,SR_OP_RECONNECT,1),2);
    f=f+sr_check("f2_reconnect_r2",scan_op_slot_eq(audit,acount,SR_OP_RECONNECT,2),1);
    f=f+sr_check("f2_reconnect_bad",scan_reconnect_bad_reason(audit,acount),0);
    f=f+sr_check("f2_nrefuse",sr_audit_count_op(audit,acount,SR_OP_REFUSE),2);
    f=f+sr_check("f2_ref_unverified",scan_refuse_code(audit,acount,SR_UNVERIFIED),1);
    f=f+sr_check("f2_ref_badreason",scan_refuse_code(audit,acount,SR_BAD_REASON),1);
    f=f+sr_check("f2_nelim",sr_audit_count_op(audit,acount,SR_OP_ELIMINATE),6);
    f=f+sr_check("f2_ncommit",sr_audit_count_op(audit,acount,SR_OP_COMMIT),4);
    f=f+sr_check("f2_nuncommit",sr_audit_count_op(audit,acount,SR_OP_UNCOMMIT),2);
    f=f+sr_check("f2_elim_s2",scan_op_step(audit,acount,SR_OP_ELIMINATE,2),1);
    f=f+sr_check("f2_elim_s3",scan_op_step(audit,acount,SR_OP_ELIMINATE,3),1);
    f=f+sr_check("f2_elim_s13",scan_op_step(audit,acount,SR_OP_ELIMINATE,13),1);
    f=f+sr_check("f2_elim_s15",scan_op_step(audit,acount,SR_OP_ELIMINATE,15),1);
    f=f+sr_check("f2_elim_s41",scan_op_step(audit,acount,SR_OP_ELIMINATE,41),1);
    f=f+sr_check("f2_elim_s45",scan_op_step(audit,acount,SR_OP_ELIMINATE,45),1);
    f=f+sr_check("f2_elim_blind",scan_op_step_range(audit,acount,SR_OP_ELIMINATE,25,40),0);
    f=f+sr_check("f2_commit_blind",scan_op_step_range(audit,acount,SR_OP_COMMIT,25,40),0);
    let viol:i32=0;let bld:i32=0;let pmm:i32=0;let wmm:i32=0;
    let s2:i32=1;
    while(s2<=60){
        if((connarr[s2] as i32)==1){
            let elim:i32=scan_op_step(audit,acount,SR_OP_ELIMINATE,s2);
            let want:i32=(ta[s2] as i32);
            if((ctxarr[s2] as i32)==1){want=(tb[s2] as i32);}
            let match:i32=((actions[s2] as i32)==want) as i32;
            if((match==1 && elim>0) || (match==0 && elim==0)){viol=viol+1;}
        }
        if(s2>=25 && s2<=40){
            if((connarr[s2] as i32)!=0){bld=bld+1;}
            let wantp:i32=1;
            if((ctxarr[s2] as i32)==0){
                if((actions[s2] as i32)!=1){pmm=pmm+1;}
                if((actions[s2] as i32)!=(ta[s2] as i32)){wmm=wmm+1;}
            } else {
                if((actions[s2] as i32)!=1){pmm=pmm+1;}
            }
        }
        s2=s2+1;
    }
    f=f+sr_check("f2_conn_invariant",viol,0);
    f=f+sr_check("f2_blind_conn",bld,0);
    f=f+sr_check("f2_blind_policy",pmm,0);
    f=f+sr_check("f2_blind_world_mm",wmm,4);
    f=f+sr_check("f2_replay",sr_replay_diff(live,committed,next_probe,connected,audit,acount,SR_NCTX,SR_NACT),0);
    sr_free(live);sr_free(committed);sr_free(next_probe);
    sr_free(audit);sr_free(targets);sr_free(actions);
    sr_free(connarr);sr_free(ctxarr);sr_free(ta);sr_free(tb);sr_free(fire_steps);
    return f;
}

// Fixed-K sweep arm over the trap curriculum: shifts s=14 (A→1,
// slow-drift past K=8's bar), s=30 (A→0, back), s=50 (B→0,
// premature-shift trap). No reconnects. Measures premature-disconnect
// rate (blind shifts), missed-disconnect cost (overheld episodes +
// churn-after-bar), and post-disconnect hold rate.
fn run_k(kval:i32,exp_fire:i32,exp_blind:i32,exp_over:i32,exp_churn:i32,exp_mm:i32,exp_de:i32,exp_nelim:i32)i32 {
    let f:i32=0;
    let live:[]u8=sr_alloc(SR_NCTX*SR_NACT);
    let committed:[]u8=sr_alloc(SR_NCTX);
    let next_probe:[]u8=sr_alloc(SR_NCTX);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    let targets:[]u8=sr_alloc(SR_NCTX);
    let actions:[]u8=sr_alloc(89);
    let connarr:[]u8=sr_alloc(89);
    let ctxarr:[]u8=sr_alloc(89);
    let ta:[]u8=sr_alloc(89);
    let tb:[]u8=sr_alloc(89);
    let prestreak:[]u8=sr_alloc(89);
    sr_init(live,committed,next_probe,SR_NCTX,SR_NACT);
    targets[0]=0;targets[1]=1;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let ctx:i32=0;let nfire:i32=0;let fire_step:i32=-1;let badep:i32=0;
    let blind:i32=0;
    let s:i32=1;
    while(s<=88){
        if(s==14){targets[0]=1;}
        if(s==30){targets[0]=0;}
        if(s==50){targets[1]=0;}
        if(s==14 || s==30 || s==50){if(connected==0){blind=blind+1;}}
        prestreak[s]=streak as u8;
        if(connected==1 && sr_legal(committed,connected,streak,SR_NCTX,kval)==1){
            let frc:i32=sr_disconnect(committed,&connected,streak,SR_NCTX,kval,s,audit,&acount);
            if(frc==SR_OK){fire_step=s;nfire=nfire+1;}
        }
        let action:i32=sr_select(live,committed,next_probe,SR_NCTX,SR_NACT,ctx);
        let signal:i32=SR_SENTINEL;
        if(connected==1){signal=world_reward(targets,ctx,action);}
        let erc:i32=sr_episode(live,committed,next_probe,SR_NCTX,SR_NACT,&connected,&streak,ctx,action,signal,s,audit,&acount);
        if(erc!=SR_OK){badep=1;}
        actions[s]=action as u8;connarr[s]=connected as u8;ctxarr[s]=ctx as u8;
        ta[s]=targets[0];tb[s]=targets[1];
        if(ctx==0){ctx=1;}else{ctx=0;}
        s=s+1;
    }
    let mm:i32=0;let de:i32=0;let over:i32=0;
    let s2:i32=1;
    while(s2<=88){
        if((connarr[s2] as i32)==0){
            de=de+1;
            let want:i32=(ta[s2] as i32);
            if((ctxarr[s2] as i32)==1){want=(tb[s2] as i32);}
            if((actions[s2] as i32)!=want){mm=mm+1;}
        } else {
            if((prestreak[s2] as i32)>=8){over=over+1;}
        }
        s2=s2+1;
    }
    let churn:i32=scan_churn(audit,acount,prestreak,88);
    if(kval==4){
        f=f+sr_check("k4_episodes_ok",badep,0);
        f=f+sr_check("k4_nfire",nfire,1);
        f=f+sr_check("k4_fire",fire_step,exp_fire);
        f=f+sr_check("k4_blind",blind,exp_blind);
        f=f+sr_check("k4_overheld",over,exp_over);
        f=f+sr_check("k4_churn",churn,exp_churn);
        f=f+sr_check("k4_mm",mm,exp_mm);
        f=f+sr_check("k4_disc_eps",de,exp_de);
        f=f+sr_check("k4_nelim",sr_audit_count_op(audit,acount,SR_OP_ELIMINATE),exp_nelim);
        f=f+sr_check("k4_disc_aux_bad",scan_disconnect_aux_ne(audit,acount,kval),0);
        f=f+sr_check("k4_replay",sr_replay_diff(live,committed,next_probe,connected,audit,acount,SR_NCTX,SR_NACT),0);
    }
    if(kval==8){
        f=f+sr_check("k8_episodes_ok",badep,0);
        f=f+sr_check("k8_nfire",nfire,1);
        f=f+sr_check("k8_fire",fire_step,exp_fire);
        f=f+sr_check("k8_blind",blind,exp_blind);
        f=f+sr_check("k8_overheld",over,exp_over);
        f=f+sr_check("k8_churn",churn,exp_churn);
        f=f+sr_check("k8_mm",mm,exp_mm);
        f=f+sr_check("k8_disc_eps",de,exp_de);
        f=f+sr_check("k8_nelim",sr_audit_count_op(audit,acount,SR_OP_ELIMINATE),exp_nelim);
        f=f+sr_check("k8_disc_aux_bad",scan_disconnect_aux_ne(audit,acount,kval),0);
        f=f+sr_check("k8_replay",sr_replay_diff(live,committed,next_probe,connected,audit,acount,SR_NCTX,SR_NACT),0);
    }
    if(kval==16){
        f=f+sr_check("k16_episodes_ok",badep,0);
        f=f+sr_check("k16_nfire",nfire,1);
        f=f+sr_check("k16_fire",fire_step,exp_fire);
        f=f+sr_check("k16_blind",blind,exp_blind);
        f=f+sr_check("k16_overheld",over,exp_over);
        f=f+sr_check("k16_churn",churn,exp_churn);
        f=f+sr_check("k16_mm",mm,exp_mm);
        f=f+sr_check("k16_disc_eps",de,exp_de);
        f=f+sr_check("k16_nelim",sr_audit_count_op(audit,acount,SR_OP_ELIMINATE),exp_nelim);
        f=f+sr_check("k16_disc_aux_bad",scan_disconnect_aux_ne(audit,acount,kval),0);
        f=f+sr_check("k16_replay",sr_replay_diff(live,committed,next_probe,connected,audit,acount,SR_NCTX,SR_NACT),0);
    }
    if(kval==32){
        f=f+sr_check("k32_episodes_ok",badep,0);
        f=f+sr_check("k32_nfire",nfire,1);
        f=f+sr_check("k32_fire",fire_step,exp_fire);
        f=f+sr_check("k32_blind",blind,exp_blind);
        f=f+sr_check("k32_overheld",over,exp_over);
        f=f+sr_check("k32_churn",churn,exp_churn);
        f=f+sr_check("k32_mm",mm,exp_mm);
        f=f+sr_check("k32_disc_eps",de,exp_de);
        f=f+sr_check("k32_nelim",sr_audit_count_op(audit,acount,SR_OP_ELIMINATE),exp_nelim);
        f=f+sr_check("k32_disc_aux_bad",scan_disconnect_aux_ne(audit,acount,kval),0);
        f=f+sr_check("k32_replay",sr_replay_diff(live,committed,next_probe,connected,audit,acount,SR_NCTX,SR_NACT),0);
    }
    sr_free(live);sr_free(committed);sr_free(next_probe);
    sr_free(audit);sr_free(targets);sr_free(actions);
    sr_free(connarr);sr_free(ctxarr);sr_free(ta);sr_free(tb);sr_free(prestreak);
    return f;
}

// Arm adaptive: the learner sets its own bar, bar = max(8,
// max_premature+1), where max_premature is the longest observed
// disconnect→shift-notice gap. The trainer's SHIFT_NOTICE carries the
// gap in aux; the learner folds it via sr_note_premature. OVERRIDE
// notices do not move the bar.
fn arm_adaptive()i32 {
    let f:i32=0;
    let live:[]u8=sr_alloc(SR_NCTX*SR_NACT);
    let committed:[]u8=sr_alloc(SR_NCTX);
    let next_probe:[]u8=sr_alloc(SR_NCTX);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    let targets:[]u8=sr_alloc(SR_NCTX);
    let actions:[]u8=sr_alloc(107);
    let connarr:[]u8=sr_alloc(107);
    let ctxarr:[]u8=sr_alloc(107);
    let ta:[]u8=sr_alloc(107);
    let tb:[]u8=sr_alloc(107);
    let fire_steps:[]u8=sr_alloc(8);
    let fire_bars:[]u8=sr_alloc(8);
    sr_init(live,committed,next_probe,SR_NCTX,SR_NACT);
    targets[0]=0;targets[1]=1;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let ctx:i32=0;let nfire:i32=0;let badep:i32=0;
    let max_premature:i32=0;let last_d:i32=0;
    let s:i32=1;
    while(s<=106){
        if(s==21){targets[0]=1; let r21:i32=sr_reconnect(&connected,&streak,s,1,s-last_d,audit,&acount); if(r21==SR_OK){max_premature=sr_note_premature(max_premature,last_d,s);}}
        if(s==45){targets[0]=0; let r45:i32=sr_reconnect(&connected,&streak,s,1,s-last_d,audit,&acount); if(r45==SR_OK){max_premature=sr_note_premature(max_premature,last_d,s);}}
        if(s==80){targets[1]=0; let r80:i32=sr_reconnect(&connected,&streak,s,1,s-last_d,audit,&acount); if(r80==SR_OK){max_premature=sr_note_premature(max_premature,last_d,s);}}
        let bar:i32=sr_bar(8,max_premature);
        if(connected==1 && sr_legal(committed,connected,streak,SR_NCTX,bar)==1){
            let frc:i32=sr_disconnect(committed,&connected,streak,SR_NCTX,bar,s,audit,&acount);
            if(frc==SR_OK){last_d=s;fire_steps[nfire]=s as u8;fire_bars[nfire]=bar as u8;nfire=nfire+1;}
        }
        let action:i32=sr_select(live,committed,next_probe,SR_NCTX,SR_NACT,ctx);
        let signal:i32=SR_SENTINEL;
        if(connected==1){signal=world_reward(targets,ctx,action);}
        let erc:i32=sr_episode(live,committed,next_probe,SR_NCTX,SR_NACT,&connected,&streak,ctx,action,signal,s,audit,&acount);
        if(erc!=SR_OK){badep=1;}
        actions[s]=action as u8;connarr[s]=connected as u8;ctxarr[s]=ctx as u8;
        ta[s]=targets[0];tb[s]=targets[1];
        if(ctx==0){ctx=1;}else{ctx=0;}
        s=s+1;
    }
    f=f+sr_check("ad_episodes_ok",badep,0);
    f=f+sr_check("ad_nfire",nfire,4);
    f=f+sr_check("ad_fire0",(fire_steps[0] as i32),12);
    f=f+sr_check("ad_fire1",(fire_steps[1] as i32),34);
    f=f+sr_check("ad_fire2",(fire_steps[2] as i32),62);
    f=f+sr_check("ad_fire3",(fire_steps[3] as i32),104);
    f=f+sr_check("ad_bar0",(fire_bars[0] as i32),8);
    f=f+sr_check("ad_bar1",(fire_bars[1] as i32),10);
    f=f+sr_check("ad_bar2",(fire_bars[2] as i32),12);
    f=f+sr_check("ad_bar3",(fire_bars[3] as i32),19);
    f=f+sr_check("ad_maxprem",max_premature,18);
    f=f+sr_check("ad_ndisconnect",sr_audit_count_op(audit,acount,SR_OP_DISCONNECT),4);
    f=f+sr_check("ad_daux8",scan_op_aux_eq(audit,acount,SR_OP_DISCONNECT,8),1);
    f=f+sr_check("ad_daux10",scan_op_aux_eq(audit,acount,SR_OP_DISCONNECT,10),1);
    f=f+sr_check("ad_daux14",scan_op_aux_eq(audit,acount,SR_OP_DISCONNECT,14),0);
    f=f+sr_check("ad_daux21",scan_op_aux_eq(audit,acount,SR_OP_DISCONNECT,21),0);
    f=f+sr_check("ad_nreconnect",sr_audit_count_op(audit,acount,SR_OP_RECONNECT),3);
    f=f+sr_check("ad_r_r1",scan_op_slot_eq(audit,acount,SR_OP_RECONNECT,1),3);
    f=f+sr_check("ad_raux9",scan_op_aux_eq(audit,acount,SR_OP_RECONNECT,9),1);
    f=f+sr_check("ad_raux13",scan_op_aux_eq(audit,acount,SR_OP_RECONNECT,13),0);
    f=f+sr_check("ad_raux20",scan_op_aux_eq(audit,acount,SR_OP_RECONNECT,20),0);
    f=f+sr_check("ad_nelim",sr_audit_count_op(audit,acount,SR_OP_ELIMINATE),8);
    f=f+sr_check("ad_elim_s2",scan_op_step(audit,acount,SR_OP_ELIMINATE,2),1);
    f=f+sr_check("ad_elim_s3",scan_op_step(audit,acount,SR_OP_ELIMINATE,3),1);
    f=f+sr_check("ad_elim_s21",scan_op_step(audit,acount,SR_OP_ELIMINATE,21),1);
    f=f+sr_check("ad_elim_s23",scan_op_step(audit,acount,SR_OP_ELIMINATE,23),1);
    f=f+sr_check("ad_elim_s45",scan_op_step(audit,acount,SR_OP_ELIMINATE,45),1);
    f=f+sr_check("ad_elim_s49",scan_op_step(audit,acount,SR_OP_ELIMINATE,49),1);
    f=f+sr_check("ad_elim_s80",scan_op_step(audit,acount,SR_OP_ELIMINATE,80),1);
    f=f+sr_check("ad_elim_s84",scan_op_step(audit,acount,SR_OP_ELIMINATE,84),1);
    f=f+sr_check("ad_ncommit",sr_audit_count_op(audit,acount,SR_OP_COMMIT),5);
    let viol:i32=0;let bld:i32=0;let wmm:i32=0;
    let s2:i32=1;
    while(s2<=106){
        if((connarr[s2] as i32)==1){
            let elim:i32=scan_op_step(audit,acount,SR_OP_ELIMINATE,s2);
            let want:i32=(ta[s2] as i32);
            if((ctxarr[s2] as i32)==1){want=(tb[s2] as i32);}
            let match:i32=((actions[s2] as i32)==want) as i32;
            if((match==1 && elim>0) || (match==0 && elim==0)){viol=viol+1;}
        }
        if((s2>=13 && s2<=20) || (s2>=33 && s2<=44) || (s2>=61 && s2<=79)){
            if((connarr[s2] as i32)!=0){bld=bld+1;}
            let want2:i32=(ta[s2] as i32);
            if((ctxarr[s2] as i32)==1){want2=(tb[s2] as i32);}
            if((actions[s2] as i32)!=want2){wmm=wmm+1;}
        }
        s2=s2+1;
    }
    f=f+sr_check("ad_conn_invariant",viol,0);
    f=f+sr_check("ad_blind_conn",bld,2);
    f=f+sr_check("ad_blind_world_mm",wmm,0);
    f=f+sr_check("ad_replay",sr_replay_diff(live,committed,next_probe,connected,audit,acount,SR_NCTX,SR_NACT),0);
    sr_free(live);sr_free(committed);sr_free(next_probe);
    sr_free(audit);sr_free(targets);sr_free(actions);
    sr_free(connarr);sr_free(ctxarr);sr_free(ta);sr_free(tb);
    sr_free(fire_steps);sr_free(fire_bars);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+arm_flap();
    f=f+arm_flap2();
    f=f+run_k(4,8,3,0,0,28,81,2);
    f=f+run_k(8,12,3,0,0,28,77,2);
    f=f+run_k(16,71,0,25,3,0,18,8);
    f=f+run_k(32,87,0,41,3,0,2,8);
    f=f+arm_adaptive();
    _zag_print("SR_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);sr_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

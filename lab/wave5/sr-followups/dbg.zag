// dbg.zag — temporary per-step trace to diagnose flap-arm ledger shape.
@import("sr2.zag")

fn dbg_print_state(s:i32,ctx:i32,action:i32,signal:i32,live:[]u8,committed:[]u8,connected:i32,streak:i32)void {
    _zag_print("s=");let a:[]u8=_zag_i64_to_str(s as i64);_zag_print(a);sr_free(a);
    _zag_print(" ctx=");let b:[]u8=_zag_i64_to_str(ctx as i64);_zag_print(b);sr_free(b);
    _zag_print(" act=");let c:[]u8=_zag_i64_to_str(action as i64);_zag_print(c);sr_free(c);
    _zag_print(" sig=");let d:[]u8=_zag_i64_to_str(signal as i64);_zag_print(d);sr_free(d);
    _zag_print(" liveA=");let e:[]u8=_zag_i64_to_str(live[0] as i64);_zag_print(e);sr_free(e);
    _zag_print(",");let e2:[]u8=_zag_i64_to_str(live[1] as i64);_zag_print(e2);sr_free(e2);
    _zag_print(" comA=");let g:[]u8=_zag_i64_to_str(committed[0] as i64);_zag_print(g);sr_free(g);
    _zag_print(" conn=");let h:[]u8=_zag_i64_to_str(connected as i64);_zag_print(h);sr_free(h);
    _zag_print(" streak=");let k:[]u8=_zag_i64_to_str(streak as i64);_zag_print(k);sr_free(k);
    _zag_println("");
}

fn main()i32 {
    let live:[]u8=sr_alloc(4);
    let committed:[]u8=sr_alloc(2);
    let next_probe:[]u8=sr_alloc(2);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    sr_init(live,committed,next_probe,2,2);
    let targets:[]u8=sr_alloc(2);
    targets[0]=0;targets[1]=1;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let ctx:i32=0;
    let s:i32=1;
    while(s<=18){
        if(s==13){targets[0]=1; let rr:i32=sr_reconnect(&connected,&streak,s,1,1,audit,&acount);}
        if(connected==1 && sr_legal(committed,connected,streak,2,8)==1){
            let fr:i32=sr_disconnect(committed,&connected,streak,2,8,s,audit,&acount);
            _zag_print("FIRE rc=");let f1:[]u8=_zag_i64_to_str(fr as i64);_zag_print(f1);sr_free(f1);_zag_println("");
        }
        let action:i32=sr_select(live,committed,next_probe,2,2,ctx);
        let signal:i32=SR_SENTINEL;
        if(connected==1){
            if((targets[ctx] as i32)==action){signal=1;}else{signal=-1;}
        }
        let er:i32=sr_episode(live,committed,next_probe,2,2,&connected,&streak,ctx,action,signal,s,audit,&acount);
        dbg_print_state(s,ctx,action,signal,live,committed,connected,streak);
        if(ctx==0){ctx=1;}else{ctx=0;}
        s=s+1;
    }
    _zag_print("nelim=");let n1:[]u8=_zag_i64_to_str(sr_audit_count_op(audit,acount,SR_OP_ELIMINATE) as i64);_zag_print(n1);sr_free(n1);
    _zag_print(" ncommit=");let n2:[]u8=_zag_i64_to_str(sr_audit_count_op(audit,acount,SR_OP_COMMIT) as i64);_zag_print(n2);sr_free(n2);
    _zag_print(" nuncommit=");let n3:[]u8=_zag_i64_to_str(sr_audit_count_op(audit,acount,SR_OP_UNCOMMIT) as i64);_zag_print(n3);sr_free(n3);
    _zag_println("");
    return 0;
}

// test early return in if
@import("substrate/cl/common.zag")
fn lr_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn test_fn(a:i32,b:i32)i32 {
    if(a<b){return 105;}
    return 0;
}
fn main()i32 {
    let r:i32=test_fn(3,4);
    _zag_print("r=");lr_pi(r as i64);_zag_print(" (expect 105)\n");
    return 0;
}

// s1b_state.zag — Step 1b state vector S=(M,H,C,B,D,K,G,R,A) as logged structs.
// Pure Zag. Zero RNG. All arrays hand-zeroed at init (nio_alloc is NOT zeroed).
// Parallel []u8 arrays with LE packing (playbook §12 idiom). Large structs are
// aliased to locals before any indexed array access.
@import("substrate/cl/common.zag")

const S1B_MCAP:i32=16;      // memory slots
const S1B_HCAP:i32=16;      // hypotheses
const S1B_CCAP:i32=4;       // contexts
const S1B_DCAP:i32=8;       // discrepancy holds
const S1B_RCAP:i32=8;       // refusal/verdict history
const S1B_ACAP:i32=256;     // audit entries
const S1B_AWORDS:i32=16;    // audit entry words (i32)
const S1B_EVCAP:i32=128;    // intake queue events
const S1B_EVWORDS:i32=8;    // event words (i32): type,p0..p6

// slot status
const S1B_ST_EMPTY:i32=0;
const S1B_ST_LIVE:i32=1;
const S1B_ST_KILLED:i32=2;
const S1B_ST_PINNED:i32=3;
// hypothesis status
const S1B_H_EMPTY:i32=0;
const S1B_H_LIVE:i32=1;
const S1B_H_REFUTED:i32=2;
const S1B_H_SUSPENDED:i32=3;
// gate state
const S1B_G_CLOSED:i32=0;
const S1B_G_PETITION:i32=1;
const S1B_G_OPEN:i32=2;
// memops
const S1B_MO_ADD:i32=1;
const S1B_MO_KILL:i32=2;
const S1B_MO_PIN:i32=3;
const S1B_MO_PROMOTE:i32=4;
const S1B_MO_DEMOTE:i32=5;
const S1B_MO_STRENGTHEN:i32=6;
const S1B_MO_WEAKEN:i32=7;
// events
const S1B_EV_GATE:i32=1;
const S1B_EV_SWITCH:i32=2;
const S1B_EV_OBSERVE:i32=3;
const S1B_EV_DELIB:i32=4;
const S1B_EV_VERDICT:i32=5;
const S1B_EV_MEMOP:i32=6;
// touch bits (KB2)
const S1B_T_M:i32=1;
const S1B_T_H:i32=2;
const S1B_T_C:i32=4;
const S1B_T_B:i32=8;
const S1B_T_D:i32=16;
const S1B_T_K:i32=32;
const S1B_T_G:i32=64;
const S1B_T_R:i32=128;
const S1B_T_A:i32=256;
// delib result
const S1B_DELIB_OK:i32=0;
const S1B_DELIB_REFUSED:i32=1;

struct S1b {
    // M
    m_ch: []u8, m_status: []u8, m_strength: []u8, m_lastep: []u8, m_cite: []u8,
    // H
    h_cid: []u8, h_status: []u8, h_ev1: []u8, h_ev2: []u8, h_vep: []u8,
    h_next: i32,
    // C
    ctx_cur: i32, ctx_stack: []u8, ctx_depth: i32,
    // B
    b_rem: []u8, b_cap: []u8, b_con: []u8,
    // D
    d_id: []u8, d_score: []u8, d_tier: []u8, d_rep: []u8, d_n: i32,
    // K
    k_ep: i64, k_step: i64, k_age: i64, k_refill: i64, k_disc: i64, rctr: i64,
    // G
    g_state: i32, g_dec: []u8, g_thr: []u8, g_stage: i32, g_scaf: i32,
    g_std: []u8, g_pin: []u8, g_prop: []u8, g_postver: i32, g_bar: i32,
    g_varused: i32,
    // variation choice log (<=8 pairs per episode)
    ch_id: []u8, ch_val: []u8,
    // R
    r_ref_ep: []u8, r_ref_ty: []u8, r_verd: []u8,
    r_spoof: i64, r_corr: i64, r_tier: []u8, r_n: i32,
    // A
    a_buf: []u8, a_n: i32, a_cap: i32,
    // load metric
    load: i64,
    // intake queue
    ev_buf: []u8, ev_n: i32,
}

// ---- LE packing helpers ----
fn s1b_u64_get(b:[]u8,at:i32)i64 {
    let v:i64=(b[at] as i64);
    v=v|((b[at+1] as i64)<<8);v=v|((b[at+2] as i64)<<16);v=v|((b[at+3] as i64)<<24);
    v=v|((b[at+4] as i64)<<32);v=v|((b[at+5] as i64)<<40);
    v=v|((b[at+6] as i64)<<48);v=v|((b[at+7] as i64)<<56);
    return v;
}
fn s1b_u64_set(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;b[at+4]=((v>>32)&255) as u8;
    b[at+5]=((v>>40)&255) as u8;b[at+6]=((v>>48)&255) as u8;
    b[at+7]=((v>>56)&255) as u8;
}
fn s1b_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn s1b_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn s1b_zero(b:[]u8)void { let i:i32=0; while(i<b.len){b[i]=0;i=i+1;} }

fn s1b_init()S1b {
    let s:S1b=S1b{
        .m_ch=nio_alloc(S1B_MCAP*8),.m_status=nio_alloc(S1B_MCAP),
        .m_strength=nio_alloc(S1B_MCAP),.m_lastep=nio_alloc(S1B_MCAP*8),
        .m_cite=nio_alloc(S1B_MCAP*4),
        .h_cid=nio_alloc(S1B_HCAP*4),.h_status=nio_alloc(S1B_HCAP),
        .h_ev1=nio_alloc(S1B_HCAP*4),.h_ev2=nio_alloc(S1B_HCAP*4),
        .h_vep=nio_alloc(S1B_HCAP*8),.h_next=0,
        .ctx_cur=0,.ctx_stack=nio_alloc(S1B_CCAP),.ctx_depth=0,
        .b_rem=nio_alloc(S1B_CCAP*4),.b_cap=nio_alloc(S1B_CCAP*4),
        .b_con=nio_alloc(S1B_CCAP*4),
        .d_id=nio_alloc(S1B_DCAP*4),.d_score=nio_alloc(S1B_DCAP*8),
        .d_tier=nio_alloc(S1B_DCAP),.d_rep=nio_alloc(S1B_DCAP*8),.d_n=0,
        .k_ep=0,.k_step=0,.k_age=0,.k_refill=0,.k_disc=0,.rctr=0,
        .g_state=S1B_G_CLOSED,.g_dec=nio_alloc(4*4),.g_thr=nio_alloc(2*4),
        .g_stage=0,.g_scaf=1,.g_std=nio_alloc(2),.g_pin=nio_alloc(4),
        .g_prop=nio_alloc(2*4),.g_postver=0,.g_bar=3,.g_varused=0,
        .ch_id=nio_alloc(8*8),.ch_val=nio_alloc(8*8),
        .r_ref_ep=nio_alloc(S1B_RCAP*8),.r_ref_ty=nio_alloc(S1B_RCAP),
        .r_verd=nio_alloc(S1B_RCAP*8),.r_spoof=0,.r_corr=0,
        .r_tier=nio_alloc(4),.r_n=0,
        .a_buf=nio_alloc(S1B_ACAP*S1B_AWORDS*4),.a_n=0,.a_cap=S1B_ACAP,
        .load=0,.ev_buf=nio_alloc(S1B_EVCAP*S1B_EVWORDS*4),.ev_n=0};
    // hand-zero every array (nio_alloc is NOT zeroed); set budget caps.
    s1b_zero(s.m_ch);s1b_zero(s.m_status);s1b_zero(s.m_strength);
    s1b_zero(s.m_lastep);s1b_zero(s.m_cite);
    s1b_zero(s.h_cid);s1b_zero(s.h_status);s1b_zero(s.h_ev1);
    s1b_zero(s.h_ev2);s1b_zero(s.h_vep);
    s1b_zero(s.ctx_stack);
    s1b_zero(s.b_rem);s1b_zero(s.b_cap);s1b_zero(s.b_con);
    let c:i32=0; while(c<S1B_CCAP){s1b_i32_set(s.b_cap,c*4,16);c=c+1;}
    s1b_zero(s.d_id);s1b_zero(s.d_score);s1b_zero(s.d_tier);s1b_zero(s.d_rep);
    s1b_zero(s.g_dec);s1b_zero(s.g_thr);s1b_zero(s.g_std);
    s1b_zero(s.g_pin);s1b_zero(s.g_prop);s1b_zero(s.ch_id);s1b_zero(s.ch_val);
    s1b_zero(s.r_ref_ep);s1b_zero(s.r_ref_ty);s1b_zero(s.r_verd);
    s1b_zero(s.r_tier);s1b_zero(s.a_buf);s1b_zero(s.ev_buf);
    // cite default = -1 (none)
    let i:i32=0; while(i<S1B_MCAP){s1b_i32_set(s.m_cite,i*4,-1);i=i+1;}
    return s;
}

fn s1b_free(s:*S1b)void {
    nio_free(s.*.m_ch);nio_free(s.*.m_status);nio_free(s.*.m_strength);
    nio_free(s.*.m_lastep);nio_free(s.*.m_cite);
    nio_free(s.*.h_cid);nio_free(s.*.h_status);nio_free(s.*.h_ev1);
    nio_free(s.*.h_ev2);nio_free(s.*.h_vep);
    nio_free(s.*.ctx_stack);
    nio_free(s.*.b_rem);nio_free(s.*.b_cap);nio_free(s.*.b_con);
    nio_free(s.*.d_id);nio_free(s.*.d_score);nio_free(s.*.d_tier);nio_free(s.*.d_rep);
    nio_free(s.*.g_dec);nio_free(s.*.g_thr);nio_free(s.*.g_std);
    nio_free(s.*.g_pin);nio_free(s.*.g_prop);nio_free(s.*.ch_id);nio_free(s.*.ch_val);
    nio_free(s.*.r_ref_ep);nio_free(s.*.r_ref_ty);nio_free(s.*.r_verd);nio_free(s.*.r_tier);
    nio_free(s.*.a_buf);nio_free(s.*.ev_buf);
}

// SHA-256 one-shot into a 32-byte out buffer. Returns 0 on success.
fn s1b_sha(input:[]u8,out:[]u8)i32 { return ns_sha256(input,out); }

// print helpers (owned temporaries are freed)
fn s1b_pnum(x:i64)void { let t:[]u8=_zag_i64_to_str(x);_zag_print(t);nio_free(t); }
fn s1b_phex(b:[]u8)void { let t:[]u8=ns_hex(b);_zag_print(t);nio_free(t); }

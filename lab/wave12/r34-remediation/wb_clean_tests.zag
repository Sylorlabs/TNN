// Clean-core white-box test suite + determinism driver.
// The clean learner is fully deterministic: every explore decision is a pure function
// of the 22 logged state fields (score margin, negative-outcome streak, explicit
// exploration budget, decision counts). There is no hidden per-decision state.
//
// Conventions: every check prints CL_CHECK,<name>,<actual>,<expected>.
// Suite prints CLEAN_FAILURES,<n> and exits nonzero iff n>0.
//
// argv[1] selects the mode (one binary, run twice and diff):
//   (none)    whitebox: all check groups
//   replay    scripted 200-episode transcript + final fingerprint
//   diverge   the purity pair: same inputs, different logged history
//   resume    encode at episode 100 -> decode -> continue; must equal replay
//   scale     scripted 2000-episode transcript (10x leg)
@import("r34_clean_learner.zag")

// ---------- shared tiny helpers ----------
fn wb_force_accept(s:*R34CleanState,action:i32,obj:i32,reward:i32,learn:i32)i32 {
    s.*.pending=1;s.*.pending_action=action;s.*.pending_context=s.*.active;s.*.pending_object=obj;s.*.pending_explore=0;
    return r34_clean_accept(s,action,reward,learn,0);
}
// One scripted episode: choose, then a fixed outcome pattern (obj0 good, obj1 bad).
fn wb_episode(s:*R34CleanState,explore_enabled:i32,learn:i32,action:i32,out_ex:*i32,out_obj:*i32)i32 {
    let ex:i32=0;let obj:i32=r34_clean_choose(s,explore_enabled,&ex);
    if(obj<0){return -99;}
    s.*.pending=1;s.*.pending_action=action;s.*.pending_context=s.*.active;s.*.pending_object=obj;s.*.pending_explore=ex;
    let reward:i32=1;if(obj!=0){reward=-1;}
    let rc:i32=r34_clean_accept(s,action,reward,learn,0);
    if(rc!=0){return -99;}
    out_ex.*=ex;out_obj.*=obj;return reward;
}
fn wb_zero_scores(s:*R34CleanState)void {s.*.s00=0;s.*.s01=0;s.*.s10=0;s.*.s11=0;}
fn wb_set_decisions(s:*R34CleanState,v:i32)void {s.*.decisions=v;}
fn wb_set_streak(s:*R34CleanState,v:i32)void {s.*.neg_streak=v;}
fn wb_set_counters(s:*R34CleanState,decisions:i32,budget:i32,explores:i32)void {s.*.decisions=decisions;s.*.explore_budget=budget;s.*.explores=explores;}
fn wb_normalize_explore(s:*R34CleanState,budget:i32,explores:i32)void {s.*.explore_budget=budget;s.*.explores=explores;}
fn wb_print_ep(i:i32,s:*R34CleanState,obj:i32,ex:i32)void {
    _zag_print("EP,");cl_number(i);_zag_print(",");cl_number(obj);_zag_print(",");cl_number(ex);
    _zag_print(",");cl_number(s.*.explore_budget);_zag_print(",");cl_number(s.*.explores);
    _zag_print(",");cl_number(r34_clean_fp(s));_zag_println("");
}

// ---------- Group 1: explore-decision rule ----------
fn wb_g1_explore_rule()i32 {
    let f:i32=0;
    // budget 0: never explores, even at maximal uncertainty (fresh state, margin 0)
    let z:R34CleanState=r34_clean_init(0);
    let ex:i32=0;let obj:i32=r34_clean_choose(&z,1,&ex);
    f=f+cl_check("g1_budget_zero_no_explore",ex,0);
    f=f+cl_check("g1_budget_zero_obj_is_best",obj,0);
    f=f+cl_check("g1_budget_zero_stays_zero",z.explore_budget,0);
    f=f+cl_check("g1_budget_zero_explores",z.explores,0);
    // fresh state, margin 0 -> explore fires, flips obj, spends exactly 1
    let u:R34CleanState=r34_clean_init(5);
    ex=0;obj=r34_clean_choose(&u,1,&ex);
    f=f+cl_check("g1_uncertain_explore",ex,1);
    f=f+cl_check("g1_uncertain_flip",obj,1);
    f=f+cl_check("g1_uncertain_spend",u.explore_budget,4);
    f=f+cl_check("g1_uncertain_count",u.explores,1);
    // margin boundary via the pure predicate (no side effects)
    let m:R34CleanState=r34_clean_init(5);
    let k:i32=0;while(k<2){wb_force_accept(&m,41+k,0,1,1);k=k+1;}
    f=f+cl_check("g1_margin_200_explores",r34_clean_explore_decision(&m,1),1);
    wb_force_accept(&m,43,0,1,1);
    f=f+cl_check("g1_margin_300_no_explore",r34_clean_explore_decision(&m,1),0);
    // disappointment path: high margin, streak 3 -> explore
    let d:R34CleanState=r34_clean_init(5);
    k=0;while(k<3){wb_force_accept(&d,51+k,0,1,1);k=k+1;}
    k=0;while(k<3){wb_force_accept(&d,61+k,1,-1,1);k=k+1;}
    f=f+cl_check("g1_streak3_setup_margin",r34_clean_score(&d,0,0)-r34_clean_score(&d,0,1),600);
    f=f+cl_check("g1_streak3_predicate",r34_clean_explore_decision(&d,1),1);
    ex=0;obj=r34_clean_choose(&d,1,&ex);
    f=f+cl_check("g1_streak3_choose_explore",ex,1);
    f=f+cl_check("g1_streak3_choose_obj",obj,1);
    f=f+cl_check("g1_streak3_spend",d.explore_budget,4);
    // streak 2, high margin -> no explore (threshold is exactly 3)
    let t:R34CleanState=r34_clean_init(5);
    k=0;while(k<3){wb_force_accept(&t,71+k,0,1,1);k=k+1;}
    k=0;while(k<2){wb_force_accept(&t,81+k,1,-1,1);k=k+1;}
    f=f+cl_check("g1_streak2_no_explore",r34_clean_explore_decision(&t,1),0);
    // explore disabled: never explores, budget untouched
    let e:R34CleanState=r34_clean_init(5);
    f=f+cl_check("g1_disabled_predicate",r34_clean_explore_decision(&e,0),0);
    ex=0;obj=r34_clean_choose(&e,0,&ex);
    f=f+cl_check("g1_disabled_choose",ex,0);
    f=f+cl_check("g1_disabled_budget_untouched",e.explore_budget,5);
    // tie-break kept: decisions%2
    let tb:R34CleanState=r34_clean_init(5);
    f=f+cl_check("g1_tiebreak_even",r34_clean_best(&tb,0),0);
    wb_set_decisions(&tb,1);
    f=f+cl_check("g1_tiebreak_odd",r34_clean_best(&tb,0),1);
    wb_set_decisions(&tb,2);
    f=f+cl_check("g1_tiebreak_even2",r34_clean_best(&tb,0),0);
    return f;
}

// ---------- Group 2: purity (explore decision is a pure function of logged state) ----------
fn wb_g2_purity()i32 {
    let f:i32=0;
    // identical logged state -> identical run
    let a:R34CleanState=r34_clean_init(40);let b:R34CleanState=r34_clean_init(40);
    let i:i32=0;
    while(i<50){let ex:i32=0;let obj:i32=0;wb_episode(&a,1,1,7,&ex,&obj);wb_episode(&b,1,1,7,&ex,&obj);i=i+1;}
    f=f+cl_check("g2_identical_states_equal",r34_clean_equal(&a,&b),1);
    f=f+cl_check("g2_identical_fp",r34_clean_fp(&a),r34_clean_fp(&b));
    f=f+cl_check("g2_updates_counted",a.updates,50);
    // mid-run checkpoint resume replays identically
    let c:R34CleanState=r34_clean_init(40);
    i=0;while(i<50){let ex:i32=0;let obj:i32=0;wb_episode(&c,1,1,7,&ex,&obj);i=i+1;}
    let buf:[]u8=nio_alloc(160);
    f=f+cl_check("g2_resume_encode",r34_clean_encode(buf,&c),0);
    let d:R34CleanState=r34_clean_init(0);
    f=f+cl_check("g2_resume_decode",r34_clean_decode(buf,&d),0);
    nio_free(buf);
    i=0;while(i<50){let ex:i32=0;let obj:i32=0;wb_episode(&c,1,1,7,&ex,&obj);wb_episode(&d,1,1,7,&ex,&obj);i=i+1;}
    f=f+cl_check("g2_resume_equal",r34_clean_equal(&c,&d),1);
    return f;
}

// ---------- Group 3: learner semantics (carried over from the quarantined core) ----------
fn wb_g3_learner()i32 {
    let f:i32=0;
    let d:R34CleanState=r34_clean_init(9);
    wb_force_accept(&d,5,1,1,1);
    f=f+cl_check("g3_update_exact_score",d.s01,100);
    f=f+cl_check("g3_update_exact_count",d.n01,1);
    f=f+cl_check("g3_update_exact_updates",d.updates,1);
    f=f+cl_check("g3_update_streak_reset",d.neg_streak,0);
    wb_force_accept(&d,6,1,-1,1);
    f=f+cl_check("g3_negative_score",d.s01,0);
    f=f+cl_check("g3_negative_streak",d.neg_streak,1);
    // learn=0: no drift
    let c:R34CleanState=r34_clean_init(9);
    wb_force_accept(&c,5,1,1,0);wb_force_accept(&c,5,1,-1,0);
    f=f+cl_check("g3_no_drift_updates",c.updates,0);
    f=f+cl_check("g3_no_drift_score",c.s01,0);
    f=f+cl_check("g3_no_drift_outcomes",c.outcomes,2);
    // clamp
    let e:R34CleanState=r34_clean_init(9);
    let k:i32=0;while(k<400){wb_force_accept(&e,5,1,1,1);k=k+1;}
    f=f+cl_check("g3_update_clamped",e.s01,30000);
    // encode/decode roundtrip preserves all 22 fields
    let enc:[]u8=nio_alloc(160);
    f=f+cl_check("g3_encode_ok",r34_clean_encode(enc,&e),0);
    let rt:R34CleanState=r34_clean_init(1);
    f=f+cl_check("g3_decode_ok",r34_clean_decode(enc,&rt),0);
    f=f+cl_check("g3_roundtrip_equal",r34_clean_equal(&e,&rt),1);
    f=f+cl_check("g3_roundtrip_s01",rt.s01,30000);
    f=f+cl_check("g3_roundtrip_budget",rt.explore_budget,e.explore_budget);
    f=f+cl_check("g3_roundtrip_explores",rt.explores,e.explores);
    f=f+cl_check("g3_roundtrip_streak",rt.neg_streak,e.neg_streak);
    nio_free(enc);
    // fingerprint: stable on equal states, sensitive to a field change
    let p:R34CleanState=r34_clean_init(9);let q:R34CleanState=r34_clean_init(9);
    f=f+cl_check("g3_fp_stable",r34_clean_fp(&p),r34_clean_fp(&q));
    wb_normalize_explore(&q,9,1);
    f=f+cl_check("g3_fp_sensitive",(r34_clean_fp(&p)!=r34_clean_fp(&q)) as i32,1);
    // budget setter validation
    let v:R34CleanState=r34_clean_init(0);
    f=f+cl_check("g3_set_budget_bad_neg",r34_clean_set_budget(&v,-1),cl_bad());
    f=f+cl_check("g3_set_budget_bad_big",r34_clean_set_budget(&v,1000001),cl_bad());
    f=f+cl_check("g3_set_budget_ok",r34_clean_set_budget(&v,7),0);
    f=f+cl_check("g3_set_budget_value",v.explore_budget,7);
    // init clamps out-of-range budgets (documented)
    let n1:R34CleanState=r34_clean_init(-3);
    f=f+cl_check("g3_init_clamp_neg",n1.explore_budget,0);
    let n2:R34CleanState=r34_clean_init(2000000);
    f=f+cl_check("g3_init_clamp_big",n2.explore_budget,1000000);
    // corrupt input refused
    let bad:[]u8=nio_alloc(160);
    let i:i32=0;while(i<160){bad[i]=0;i=i+1;}
    let rt2:R34CleanState=r34_clean_init(1);
    f=f+cl_check("g3_corrupt_refused",r34_clean_decode(bad,&rt2),cl_corrupt());
    nio_free(bad);
    return f;
}

// ---------- Group 4: budget exhaustion is exact ----------
fn wb_g4_budget_exhaustion()i32 {
    let f:i32=0;
    // always-uncertain scripted run: scores zeroed each episode, budget 4
    let s:R34CleanState=r34_clean_init(4);
    let i:i32=0;let total_ex:i32=0;
    while(i<10){
        wb_zero_scores(&s);
        let ex:i32=0;let obj:i32=0;
        wb_episode(&s,1,1,7,&ex,&obj);
        total_ex=total_ex+ex;i=i+1;
    }
    f=f+cl_check("g4_exactly_budget_explores",total_ex,4);
    f=f+cl_check("g4_budget_zero",s.explore_budget,0);
    f=f+cl_check("g4_explores_count",s.explores,4);
    // after exhaustion: best-only forever
    let ex:i32=0;let obj:i32=r34_clean_choose(&s,1,&ex);
    f=f+cl_check("g4_exhausted_no_explore",ex,0);
    f=f+cl_check("g4_exhausted_obj_is_best",obj,r34_clean_best(&s,s.active));
    return f;
}

// ---------- purity pair: same inputs, different logged history ----------
// Per the frozen bar B2-ii: identical logged states except neg_streak forced to 3 on B.
// The predicted divergence is exactly the explore decision and its two logged
// effects (budget -1, explores +1) — proven three ways below.
fn wb_diverge()i32 {
    let f:i32=0;
    // identical logged history: 3 positive accepts on (ctx0,obj0) -> s00=300, margin 300
    let a:R34CleanState=r34_clean_init(10);
    let b:R34CleanState=r34_clean_init(10);
    let k:i32=0;while(k<3){wb_force_accept(&a,21+k,0,1,1);wb_force_accept(&b,31+k,0,1,1);k=k+1;}
    // the ONLY logged difference: B carries a forced 3-negative streak
    wb_set_streak(&b,3);
    f=f+cl_check("diverge_setup_margin_a",r34_clean_score(&a,0,0)-r34_clean_score(&a,0,1),300);
    f=f+cl_check("diverge_setup_margin_b",r34_clean_score(&b,0,0)-r34_clean_score(&b,0,1),300);
    f=f+cl_check("diverge_setup_streak_a",a.neg_streak,0);
    f=f+cl_check("diverge_setup_streak_b",b.neg_streak,3);
    // snapshot the full logged state of each run before the decision
    let buf:[]u8=nio_alloc(160);
    f=f+cl_check("diverge_snap_a",r34_clean_encode(buf,&a),0);
    let a0:R34CleanState=r34_clean_init(0);
    f=f+cl_check("diverge_restore_a",r34_clean_decode(buf,&a0),0);
    f=f+cl_check("diverge_snap_b",r34_clean_encode(buf,&b),0);
    let b0:R34CleanState=r34_clean_init(0);
    f=f+cl_check("diverge_restore_b",r34_clean_decode(buf,&b0),0);
    nio_free(buf);
    let exa:i32=0;let exb:i32=0;
    let obja:i32=r34_clean_choose(&a,1,&exa);
    let objb:i32=r34_clean_choose(&b,1,&exb);
    f=f+cl_check("diverge_a_no_explore",exa,0);
    f=f+cl_check("diverge_a_obj",obja,0);
    f=f+cl_check("diverge_a_budget",a.explore_budget,10);
    f=f+cl_check("diverge_b_explore",exb,1);
    f=f+cl_check("diverge_b_obj",objb,1);
    f=f+cl_check("diverge_b_obj_flipped",objb,1-obja);
    f=f+cl_check("diverge_b_budget",b.explore_budget,9);
    f=f+cl_check("diverge_b_explores",b.explores,1);
    // proof 1: A's choose transition touches ONLY decisions (+1)
    wb_set_counters(&a0,a0.decisions+1,a0.explore_budget,a0.explores);
    f=f+cl_check("diverge_a_transition_pure",r34_clean_equal(&a,&a0),1);
    // proof 2: B's choose transition touches ONLY decisions (+1), budget (-1), explores (+1)
    wb_set_counters(&b0,b0.decisions+1,b0.explore_budget-1,b0.explores+1);
    f=f+cl_check("diverge_b_transition_predicted",r34_clean_equal(&b,&b0),1);
    // proof 3: after the decision, A and B differ only in the forced streak input
    // and the two predicted explore effects — nothing else
    wb_set_counters(&b,b.decisions,10,0);
    wb_set_streak(&b,0);
    f=f+cl_check("diverge_only_predicted_fields_differ",r34_clean_equal(&a,&b),1);
    _zag_print("DIVERGE_PAIR,complete,");cl_number(f);_zag_println("");
    return f;
}

// ---------- scripted transcript drivers ----------
fn wb_replay(n:i32)void {
    let s:R34CleanState=r34_clean_init(n/5);
    _zag_println("CLEAN_REPLAY,start");
    let i:i32=0;
    while(i<n){
        let ex:i32=0;let obj:i32=0;
        if(wb_episode(&s,1,1,7,&ex,&obj)==-99){_zag_println("CLEAN_REPLAY,driver_error");return;}
        wb_print_ep(i,&s,obj,ex);i=i+1;
    }
    _zag_print("CLEAN_REPLAY,end,FP,");cl_number(r34_clean_fp(&s));_zag_println("");
}
fn wb_replay_resume(n:i32)void {
    let half:i32=n/2;
    let s:R34CleanState=r34_clean_init(n/5);
    _zag_println("CLEAN_REPLAY,start");
    let i:i32=0;
    while(i<half){
        let ex:i32=0;let obj:i32=0;
        if(wb_episode(&s,1,1,7,&ex,&obj)==-99){_zag_println("CLEAN_REPLAY,driver_error");return;}
        wb_print_ep(i,&s,obj,ex);i=i+1;
    }
    let buf:[]u8=nio_alloc(160);
    if(r34_clean_encode(buf,&s)!=0){_zag_println("CLEAN_REPLAY,encode_error");nio_free(buf);return;}
    let t:R34CleanState=r34_clean_init(0);
    if(r34_clean_decode(buf,&t)!=0){_zag_println("CLEAN_REPLAY,decode_error");nio_free(buf);return;}
    nio_free(buf);
    while(i<n){
        let ex:i32=0;let obj:i32=0;
        if(wb_episode(&t,1,1,7,&ex,&obj)==-99){_zag_println("CLEAN_REPLAY,driver_error");return;}
        wb_print_ep(i,&t,obj,ex);i=i+1;
    }
    _zag_print("CLEAN_REPLAY,end,FP,");cl_number(r34_clean_fp(&t));_zag_println("");
}

fn wb_whitebox()i32 {
    let f:i32=0;
    _zag_println("CLEAN_SUITE,start");
    f=f+wb_g1_explore_rule();
    f=f+wb_g2_purity();
    f=f+wb_g3_learner();
    f=f+wb_g4_budget_exhaustion();
    _zag_print("CLEAN_FAILURES,");cl_number(f);_zag_println("");
    return (f!=0) as i32;
}
fn main()i32 {
    if(_zag_argc()==1){return wb_whitebox();}
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"replay")==1){wb_replay(200);return 0;}
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"diverge")==1){return wb_diverge();}
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"resume")==1){wb_replay_resume(200);return 0;}
    if(_zag_argc()==2 && nio_equal(_zag_arg(1),"scale")==1){wb_replay(2000);return 0;}
    return 64;
}

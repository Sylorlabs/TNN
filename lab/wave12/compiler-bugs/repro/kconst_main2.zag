@import("kconst_defs.zag")
const LOCAL_C:i32=7;
fn use_in_fn()i32 { return K_I32*2; }
fn main()i32 {
    let a:i32=LOCAL_C;
    let b:i32=use_in_fn();
    let c:i32=K_I64 as i32;
    _zag_println(_zag_i64_to_str(a as i64));
    _zag_println(_zag_i64_to_str(b as i64));
    _zag_println(_zag_i64_to_str(c as i64));
    if(a==7 && b==84 && c==610473){return 0;}
    return 1;
}

fn in_range(v:i64)i32 { return (v>=2001 && v<=2008) as i32; }
fn eq5(v:i64)i32 { return (v==5) as i32; }
fn or_case(a:i64,b:i64)i32 { return (a<0 || b<0) as i32; }
fn not_case(v:i64)i32 { return !(v>=2001 && v<=2008) as i32; }
fn let_case(v:i64)i32 { let ok:i32=(v>=2001 && v<=2008) as i32; return ok; }
fn main()i32 {
    let fail:i32=0;
    _zag_println(_zag_i64_to_str(in_range(2000) as i64));
    _zag_println(_zag_i64_to_str(in_range(2001) as i64));
    _zag_println(_zag_i64_to_str(in_range(2005) as i64));
    _zag_println(_zag_i64_to_str(in_range(2008) as i64));
    _zag_println(_zag_i64_to_str(in_range(2009) as i64));
    _zag_println(_zag_i64_to_str(eq5(4) as i64));
    _zag_println(_zag_i64_to_str(eq5(5) as i64));
    _zag_println(_zag_i64_to_str(eq5(6) as i64));
    _zag_println(_zag_i64_to_str(or_case(-1,0) as i64));
    _zag_println(_zag_i64_to_str(or_case(0,-2) as i64));
    _zag_println(_zag_i64_to_str(or_case(1,2) as i64));
    _zag_println(_zag_i64_to_str(not_case(2000) as i64));
    _zag_println(_zag_i64_to_str(not_case(2005) as i64));
    _zag_println(_zag_i64_to_str(let_case(2000) as i64));
    _zag_println(_zag_i64_to_str(let_case(2005) as i64));
    if(in_range(2000)!=0){fail=1;}
    if(in_range(2001)!=1){fail=1;}
    if(in_range(2005)!=1){fail=1;}
    if(in_range(2008)!=1){fail=1;}
    if(in_range(2009)!=0){fail=1;}
    if(eq5(4)!=0){fail=1;}
    if(eq5(5)!=1){fail=1;}
    if(eq5(6)!=0){fail=1;}
    if(or_case(-1,0)!=1){fail=1;}
    if(or_case(0,-2)!=1){fail=1;}
    if(or_case(1,2)!=0){fail=1;}
    if(not_case(2000)!=1){fail=1;}
    if(not_case(2005)!=0){fail=1;}
    if(let_case(2000)!=0){fail=1;}
    if(let_case(2005)!=1){fail=1;}
    return fail;
}

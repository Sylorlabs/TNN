// trial.zag — 100-episode kill-bar trial (§6).
// 5 verdict classes x 20 distinct lawful states. Kills on: (a) any §5(b) oracle
// failure, (b) any replay mismatch, (c) any class with <3 distinct renderings,
// (d) inventory gate/blob mismatch.
// Pure Zag. Zero RNG. (Harness.)
@import("p1d_null.zag")

// expected selection indices from the frozen §4 law (oracle mirror)
fn tri_sel(s:P1dProj,ti:[]u8,oi:[]u8,ci:[]u8,vi:[]u8,ai:[]u8,depth:[]u8,rot:[]u8)void {
    let h:i64=phr_fold(s);
    fx_iset(ti,0,(h%5) as i32);
    fx_iset(oi,0,((h>>8)%3) as i32);
    fx_iset(ci,0,((h>>16)%3) as i32);
    fx_iset(vi,0,((h>>40)%3) as i32);
    fx_iset(ai,0,((s.kills+s.promotes)%3) as i32);
    fx_iset(depth,0,(1+((s.ep+s.store_n+s.promotes)%3)) as i32);
    fx_iset(rot,0,((s.ctx+s.kills+s.last_op)%3) as i32);
}
// first occurrence of ndl in hay[0..hlen); -1 if absent
fn tri_find(hay:[]u8,hlen:i32,ndl:[]u8)i32 {
    if(ndl.len>hlen){ return -1; }
    let p:i32=0;
    while(p<=hlen-ndl.len){
        let q:i32=0; let ok:i32=1;
        while(q<ndl.len && ok==1){ if(hay[p+q]!=ndl[q]){ok=0;} q=q+1; }
        if(ok==1){ return p; }
        p=p+1;
    }
    return -1;
}
// §5(b) oracle on one rendered episode; returns 0=pass or failing check# 1..5
fn tri_oracle(v:*P1dVerdict,s:P1dProj,out:[]u8,n:i32)i32 {
    let ti:[]u8=nio_alloc(4); let oi:[]u8=nio_alloc(4); let ci:[]u8=nio_alloc(4);
    let vi:[]u8=nio_alloc(4); let ai:[]u8=nio_alloc(4); let depth:[]u8=nio_alloc(4); let rot:[]u8=nio_alloc(4);
    tri_sel(s,ti,oi,ci,vi,ai,depth,rot);
    let d:i32=fx_iget(depth,0); let r:i32=fx_iget(rot,0);
    // O1: subject "slot <id>" verbatim
    let subj:[]u8=nio_alloc(16);
    let sa:i32=pbuf_put(subj,0,"slot ");
    let sd:[]u8=_zag_i64_to_str(v.*.slot); sa=pbuf_put(subj,sa,sd); nio_free(sd);
    let o1:i32=0;
    if(tri_find(out,n,subj[0..sa])>=0){ o1=1; }
    nio_free(subj);
    if(o1==0){ nio_free(ti);nio_free(oi);nio_free(ci);nio_free(vi);nio_free(ai);nio_free(depth);nio_free(rot); return 1; }
    // O2: picked verb member verbatim
    let verb:[]u8=inv_member((v.*.vclass+2) as i32,fx_iget(vi,0));
    if(tri_find(out,n,verb)<0){ nio_free(ti);nio_free(oi);nio_free(ci);nio_free(vi);nio_free(ai);nio_free(depth);nio_free(rot); return 2; }
    // O3: top-`depth` rotated reasons verbatim, in order; record spans
    let rpos:[]u8=nio_alloc(3*4); let rlen:[]u8=nio_alloc(3*4);
    let lastp:i32=-1; let ok3:i32=1; let i:i32=0;
    while(i<d && ok3==1){
        let rs:[]u8=phr_reason(v,((i+r)%3) as i64);
        let fp:i32=tri_find(out,n,rs);
        if(fp<0 || fp<=lastp){ ok3=0; } else { lastp=fp; fx_iset(rpos,i,fp); fx_iset(rlen,i,rs.len); }
        i=i+1;
    }
    if(ok3==0){ nio_free(rpos); nio_free(rlen); nio_free(ti);nio_free(oi);nio_free(ci);nio_free(vi);nio_free(ai);nio_free(depth);nio_free(rot); return 3; }
    // O4: no class-0 forbidden token in the function's OWN fixed text.
    // The frozen verdict reasons themselves contain "no"/"not" (§3) and O3
    // requires them verbatim, so reason spans are masked: O4 scopes to
    // fixed text + inventory picks, exactly like template cert T3.
    let mask:[]u8=nio_alloc(n);
    let q:i32=0; while(q<n){ mask[q]=out[q]; q=q+1; }
    i=0;
    while(i<d){ let fp2:i32=fx_iget(rpos,i); let rl:i32=fx_iget(rlen,i); q=0; while(q<rl){ mask[fp2+q]=32; q=q+1; } i=i+1; }
    nio_free(rpos); nio_free(rlen);
    let f:i32=0; let ok4:i32=1;
    while(f<inv_nforb(0) && ok4==1){ if(stokpad(mask[0..n],inv_forb(0,f))==1){ ok4=0; } f=f+1; }
    nio_free(mask);
    if(ok4==0){ nio_free(ti);nio_free(oi);nio_free(ci);nio_free(vi);nio_free(ai);nio_free(depth);nio_free(rot); return 4; }
    // O5: output matches the expected template skeleton
    let eti:i32=fx_iget(ti,0); let ok5:i32=0;
    if(eti==0){
        let op:[]u8=inv_member(P1D_C_OPENER,fx_iget(oi,0));
        if(sstarts(out[0..n],op)==1){ ok5=1; }
    }
    if(eti==1){ if(sstr(out[0..n],"that is why")==1){ ok5=1; } }
    if(eti==2){
        let sj:[]u8=nio_alloc(16);
        let sb:i32=pbuf_put(sj,0,"slot ");
        let sd2:[]u8=_zag_i64_to_str(v.*.slot); sb=pbuf_put(sj,sb,sd2); nio_free(sd2);
        if(sstarts(out[0..n],sj[0..sb])==1){ ok5=1; }
        nio_free(sj);
    }
    if(eti==3){ if(sstr(out[0..n],"the record on")==1){ ok5=1; } }
    if(eti==4){ if(sstr(out[0..n],"accordingly")==1){ ok5=1; } }
    nio_free(ti);nio_free(oi);nio_free(ci);nio_free(vi);nio_free(ai);nio_free(depth);nio_free(rot);
    if(ok5==0){ return 5; }
    return 0;
}

fn main()i32 {
    // kill (d): inventory gate + blob address first
    let gate:i32=inv_gate();
    let hx:[]u8=inv_blob_hash();
    let hm:i32=_zag_strcmp(hx,inv_expected_hash());
    nio_free(hx);
    p("TRIAL,GATE_BAD,"); pi(gate as i64); p(",HASH_MATCH,"); pi(hm as i64); pn();
    if(gate!=0 || hm!=1){ p("TRIAL,KILL,d\n"); return 1; }
    let outs:[]u8=nio_alloc(100*1024); let lens:[]u8=nio_alloc(100*4);
    let out2:[]u8=nio_alloc(1024);
    let killed:i32=0; let e:i32=0;
    while(e<100){
        let c:i32=e/20; let k:i32=e%20;
        let p:i64=((8*c+(k%8)) as i64);
        let t:i64=((k/2) as i64); let j:i64=((k%2) as i64);
        let v:P1dVerdict=st_probe(p);
        let s:P1dProj=st_snap(t,j);
        let n:i32=pro_render(&v,s,outs[e*1024..e*1024+1024]);
        if(n<0){ p("TRIAL,KILL,b,verdict-mutation,ep,"); pi(e as i64); pn(); killed=1; }
        else {
            fx_iset(lens,e,n);
            // kill (b): replay byte-identity
            let n2:i32=phr_render(&v,s,out2);
            if(n2!=n){ p("TRIAL,KILL,b,len,ep,"); pi(e as i64); pn(); killed=1; }
            else {
                let q:i32=0;
                while(q<n){ if(outs[e*1024+q]!=out2[q]){ p("TRIAL,KILL,b,bytes,ep,"); pi(e as i64); pn(); killed=1; q=n; } q=q+1; }
            }
            // kill (a): §5(b) oracle
            let oc:i32=tri_oracle(&v,s,outs[e*1024..e*1024+1024],n);
            if(oc!=0){ p("TRIAL,KILL,a,check,"); pi(oc as i64); p(",ep,"); pi(e as i64); pn(); killed=1; }
        }
        e=e+1;
    }
    // kill (c): per class >= 3 distinct renderings
    let c:i32=0;
    while(c<5){
        let dist:i32=0; let k:i32=0;
        while(k<20){
            let e1:i32=c*20+k;
            let seen:i32=0; let m:i32=0;
            while(m<k && seen==0){
                let e2:i32=c*20+m;
                let l1:i32=fx_iget(lens,e1); let l2:i32=fx_iget(lens,e2);
                if(l1==l2){
                    let eq:i32=1; let q:i32=0;
                    while(q<l1 && eq==1){ if(outs[e1*1024+q]!=outs[e2*1024+q]){eq=0;} q=q+1; }
                    if(eq==1){ seen=1; }
                }
                m=m+1;
            }
            if(seen==0){ dist=dist+1; }
            k=k+1;
        }
        p("TRIAL,CLASS,"); pi(c as i64); p(",DISTINCT,"); pi(dist as i64); pn();
        if(dist<3){ p("TRIAL,KILL,c,class,"); pi(c as i64); pn(); killed=1; }
        c=c+1;
    }
    nio_free(outs); nio_free(lens); nio_free(out2);
    if(killed==0){ p("TRIAL,PASS,100,100\n"); return 0; }
    p("TRIAL,KILLED\n");
    return 1;
}

@import("substrate/cl/common.zag")
// fwgate.zag — pure-Zag static firewall checker (finding 20, fresh).
// Reads module sources AS DATA (never imports them). Zero RNG.
// Checks, per PREREG_FIREWALLS.md §8:
//   1. import edges: col-0 bare `@import("...")` directives only;
//   2. per-file import allowlist (frozen §1 table);
//   3. call-site rule: every `vary_pick(` (except its `fn` definition) must
//      be followed immediately by `fw_state_digest(`;
//   4. wire-token audit (judge/refuse/ledger list vs vary list).
// Usage: fwgate_bin clean <files...>   -> exit 0 iff zero violations
//        fwgate_bin probes <files...>  -> exit 0 iff EVERY file has >=1
//        violation (each probe plants exactly one).

fn g_pnum(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    nio_free(s);
}
fn g_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0; while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn g_starts(hay:[]u8,at:i32,nd:[]u8)i32 {
    if(at<0||at+nd.len>hay.len){return 0;}
    let i:i32=0;
    while(i<nd.len){if(hay[at+i]!=nd[i]){return 0;}i=i+1;}
    return 1;
}
fn g_find(hay:[]u8,nd:[]u8,from:i32)i32 {
    let i:i32=from;
    while(i+nd.len<=hay.len){
        if(g_starts(hay,i,nd)==1){return i;}
        i=i+1;
    }
    return -1;
}
// basename: split path at last '/'
fn g_basename(path:[]u8)[]u8 {
    let slash:i32=-1;
    let i:i32=0;
    while(i<path.len){if(path[i]==47){slash=i;}i=i+1;}
    if(slash<0){return path;}
    return path[slash+1..path.len];
}
fn g_dirname(path:[]u8,dot:[]u8)[]u8 {
    let slash:i32=-1;
    let i:i32=0;
    while(i<path.len){if(path[i]==47){slash=i;}i=i+1;}
    if(slash<0){return dot;}
    return path[0..slash];
}
fn g_read(path:[]u8,out:[]u8,max:i32) i32 {
    let dot:[]u8=nio_alloc(1);
    if(dot.len!=1){return -1;}
    dot[0]=46;
    let dir:[]u8=g_dirname(path,dot);
    let base:[]u8=g_basename(path);
    let root:i64=nio_open_root(dir);
    nio_free(dot);
    if(root<0){return -2;}
    let fd:i64=nio_open_child(root,base,0);
    if(fd<0){nio_close(root);return -3;}
    let n:i64=nio_read_exact(fd,out,max);
    nio_close(fd); nio_close(root);
    if(n<0){return -4;}
    return n as i32;
}

// ---- frozen import allowlist (§1). 1 = edge allowed. ----
fn g_import_ok(base:[]u8,targ:[]u8) i32 {
    let sub:[]u8="substrate/cl/common.zag";
    if(g_eq(targ,sub)==1){return 1;}
    let jl:[]u8="fw_ledger.zag";
    let jd:[]u8="fw_judge.zag";
    let rf:[]u8="fw_refuse.zag";
    let vr:[]u8="fw_vary.zag";
    let vd:[]u8="fw_verdict.zag";
    let rn:[]u8="fw_run.zag";
    if(g_eq(base,jl)==1){return 0;}
    if(g_eq(base,jd)==1){
        if(g_eq(targ,jl)==1){return 1;}
        return 0;
    }
    if(g_eq(base,rf)==1){
        if(g_eq(targ,jl)==1){return 1;}
        return 0;
    }
    if(g_eq(base,vr)==1){return 0;}
    if(g_eq(base,vd)==1){
        if(g_eq(targ,jd)==1){return 1;}
        if(g_eq(targ,rf)==1){return 1;}
        if(g_eq(targ,vr)==1){return 1;}
        if(g_eq(targ,jl)==1){return 1;}
        return 0;
    }
    if(g_eq(base,rn)==1){
        if(g_eq(targ,vd)==1){return 1;}
        return 0;
    }
    let mn:[]u8="fwmain.zag";
    if(g_eq(base,mn)==1){
        if(g_eq(targ,rn)==1){return 1;}
        return 0;
    }
    return 0;  // unknown files (probes): substrate only
}

// ---- wire-token audit (§8.4). Returns 1 if a forbidden token is present.
// kind: 1 = judge/refuse/ledger list, 2 = vary list, 3 = union (unknown).
fn g_tok_bad(kind:i32,buf:[]u8,n:i32) i32 {
    let b:[]u8=buf[0..n];
    if(kind==1||kind==3){
        let t1:[]u8="vary_";       if(g_find(b,t1,0)>=0){return 1;}
        let t2:[]u8="expr_";       if(g_find(b,t2,0)>=0){return 1;}
        let t3:[]u8="vs_";         if(g_find(b,t3,0)>=0){return 1;}
        let t4:[]u8="EXPR_STATE";  if(g_find(b,t4,0)>=0){return 1;}
        let t5:[]u8="rand";        if(g_find(b,t5,0)>=0){return 1;}
        let t6:[]u8="random";      if(g_find(b,t6,0)>=0){return 1;}
        let t7:[]u8="rdtsc";       if(g_find(b,t7,0)>=0){return 1;}
        let t8:[]u8="gettime";     if(g_find(b,t8,0)>=0){return 1;}
        let t9:[]u8="wall";        if(g_find(b,t9,0)>=0){return 1;}
        let t10:[]u8="&mut";       if(g_find(b,t10,0)>=0){return 1;}
    }
    if(kind==2||kind==3){
        let u1:[]u8="fw_verdict";  if(g_find(b,u1,0)>=0){return 1;}
        let u2:[]u8="fw_judge";    if(g_find(b,u2,0)>=0){return 1;}
        let u3:[]u8="fw_ledger";   if(g_find(b,u3,0)>=0){return 1;}
        let u4:[]u8="verdict_";    if(g_find(b,u4,0)>=0){return 1;}
        let u5:[]u8="&mut";        if(g_find(b,u5,0)>=0){return 1;}
        let u6:[]u8="st_add";      if(g_find(b,u6,0)>=0){return 1;}
        let u7:[]u8="led_append";  if(g_find(b,u7,0)>=0){return 1;}
    }
    return 0;
}
// probe kind from filename: pNN_<kind>_... ; 1=judge-family, 2=vary, 3=union
fn g_probe_kind(base:[]u8) i32 {
    if(base.len<5||base[0]!=112){return 3;}
    let i:i32=1;
    while(i<base.len&&base[i]>=48&&base[i]<=57){i=i+1;}
    if(i>=base.len||base[i]!=95){return 3;}
    i=i+1;
    let j:i32=i;
    while(j<base.len&&base[j]!=95){j=j+1;}
    let tag:[]u8=base[i..j];
    let kj:[]u8="judge";  if(g_eq(tag,kj)==1){return 1;}
    let kr:[]u8="refuse"; if(g_eq(tag,kr)==1){return 1;}
    let kl:[]u8="ledger"; if(g_eq(tag,kl)==1){return 1;}
    let kv:[]u8="vary";   if(g_eq(tag,kv)==1){return 2;}
    return 3;
}
// token-audit kind for a build file: 0 = no audit (bridge/harness/main)
fn g_file_kind(base:[]u8) i32 {
    let jd:[]u8="fw_judge.zag";  if(g_eq(base,jd)==1){return 1;}
    let rf:[]u8="fw_refuse.zag"; if(g_eq(base,rf)==1){return 1;}
    let jl:[]u8="fw_ledger.zag"; if(g_eq(base,jl)==1){return 1;}
    let vr:[]u8="fw_vary.zag";   if(g_eq(base,vr)==1){return 2;}
    return 0;
}

// ---- check one file. Returns violation count. ----
fn g_check_file(path:[]u8,buf:[]u8,max:i32) i32 {
    let n:i32=g_read(path,buf,max);
    if(n<0){
        _zag_print("GATE_READ_FAIL,");_zag_print(path);_zag_println("");
        return 999;
    }
    let base:[]u8=g_basename(path);
    let viol:i32=0;
    // 1. import scan: col-0 bare @import("...") lines
    let imp:[]u8="@import(\"";
    let ls:i32=0;
    while(ls<n){
        let le:i32=ls;
        while(le<n&&buf[le]!=10){le=le+1;}
        if(le-ls>=9&&g_starts(buf,ls,imp)==1){
            let q1:i32=ls+9;
            let q2:i32=g_find(buf,"\"",q1);
            if(q2>q1&&q2<le){
                let targ:[]u8=buf[q1..q2];
                if(g_import_ok(base,targ)==0){
                    _zag_print("GATE_IMPORT,");_zag_print(path);
                    _zag_print(",");_zag_print(targ);_zag_println("");
                    viol=viol+1;
                }
            }
        }
        ls=le+1;
    }
    // 2. wire-token audit
    let kind:i32=g_file_kind(base);
    if(kind==0){
        // not a firewall module: probe dispatch (build bridge/harness/main
        // files are exempt; unknown names get probe-kind dispatch)
        let vd:[]u8="fw_verdict.zag";
        let rn:[]u8="fw_run.zag";
        let mn:[]u8="fwmain.zag";
        if(g_eq(base,vd)==0&&g_eq(base,rn)==0&&g_eq(base,mn)==0){
            kind=g_probe_kind(base);
        }
    }
    if(kind!=0){
        if(g_tok_bad(kind,buf,n)==1){
            _zag_print("GATE_TOKEN,");_zag_print(path);_zag_println("");
            viol=viol+1;
        }
    }
    // 3. call-site rule: vary_pick( must be followed by fw_state_digest(
    //    (the fn definition itself is exempt)
    let vp:[]u8="vary_pick(";
    let lawful:[]u8="fw_state_digest(";
    let fnkw:[]u8="fn ";
    let at:i32=g_find(buf,vp,0);
    while(at>=0&&at<n){
        let isdef:i32=0;
        if(at>=3&&g_starts(buf,at-3,fnkw)==1){isdef=1;}
        if(isdef==0){
            if(g_starts(buf,at+10,lawful)==0){
                _zag_print("GATE_CALLSITE,");_zag_print(path);_zag_println("");
                viol=viol+1;
            }
        }
        at=g_find(buf,vp,at+1);
    }
    return viol;
}

fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    let mclean:[]u8="clean";
    let mprobes:[]u8="probes";
    let isclean:i32=g_eq(mode,mclean);
    let isprobes:i32=g_eq(mode,mprobes);
    if(isclean==0&&isprobes==0){
        _zag_println("USAGE: fwgate_bin clean|probes <files...>");
        return 2;
    }
    let buf:[]u8=nio_alloc(65536);
    if(buf.len!=65536){return 3;}
    let total:i32=0;
    let files:i32=0;
    let missed:i32=0;
    let a:i32=2;
    while(1){
        let p:[]u8=_zag_arg(a);
        if(p.len==0){break;}
        let v:i32=g_check_file(p,buf,65536);
        _zag_print("GATE_FILE,");_zag_print(p);
        _zag_print(",viol,");g_pnum(v as i64);_zag_println("");
        total=total+v;
        files=files+1;
        if(isprobes==1&&v==0){missed=missed+1;}
        a=a+1;
    }
    nio_free(buf);
    _zag_print("GATE_SUMMARY,files,");g_pnum(files as i64);
    _zag_print(",total_viol,");g_pnum(total as i64);
    _zag_print(",missed,");g_pnum(missed as i64);_zag_println("");
    if(isclean==1){
        if(total==0){return 0;}
        return 1;
    }
    if(missed==0&&files>0){return 0;}
    return 1;
}

@import("fw_run.zag")
fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(_zag_strcmp(m,"verdictinv")==1){return fw_mode_verdictinv();}
    if(_zag_strcmp(m,"tamper")==1){return fw_mode_tamper();}
    if(_zag_strcmp(m,"meminv")==1){return fw_mode_meminv();}
    if(_zag_strcmp(m,"refuseinv")==1){return fw_mode_refuseinv();}
    if(_zag_strcmp(m,"ledginv")==1){return fw_mode_ledginv();}
    if(_zag_strcmp(m,"wiring")==1){return fw_mode_wiring();}
    if(_zag_strcmp(m,"replay")==1){return fw_mode_replay();}
    if(_zag_strcmp(m,"all")==1){
        let bad:i32=0;
        bad=bad+fw_mode_verdictinv();
        bad=bad+fw_mode_tamper();
        bad=bad+fw_mode_meminv();
        bad=bad+fw_mode_refuseinv();
        bad=bad+fw_mode_ledginv();
        bad=bad+fw_mode_wiring();
        bad=bad+fw_mode_replay();
        return bad;
    }
    _zag_println("USAGE: fw_bin verdictinv|tamper|meminv|refuseinv|ledginv|wiring|replay|all");
    return 1;
}

// helper12.zag — transively imported by plant12.zag (4.8 probe).

fn pick_lo(x:i64)i64 {
    return x&255;
}

fn pick_hi(x:i64)i64 {
    let eb:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<eb.len){
        eb[zi]=0;
        zi=zi+1;
    }
    let ep:u64=_zag_slice_ptr(eb) as u64;
    let nr:i64=_zag_raw_syscall(318, ep as i64, 8, 0, 0, 0, 0);
    let v:i64=(eb[0] as i64)^((eb[7] as i64)<<8)^x^nr;
    nio_free(eb);
    return v;
}

fn dispatch(x:i64)i64 {
    let f:fn*(i64)i64=pick_lo;
    f=pick_hi;
    return f(x);
}

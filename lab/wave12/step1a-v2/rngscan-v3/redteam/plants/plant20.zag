@import("harness.zag")

// PLANT 20 (new, 4.3): the init loop is canonical FOR `b` (b gets INIT),
// but inside b's loop it reads `c[i]`, where `c` was never initialized.
// The per-variable exclusion only covers the name being initialized,
// so the USE of c while UNINIT is a 4.3 hit (should-catch).
// Genuine 4.3: uninit heap bytes flow through b into out.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64){return 1;}
    let c:[]u8=nio_alloc(64);
    let b:[]u8=nio_alloc(64);
    if(c.len!=64 || b.len!=64){return 2;}
    // c is deliberately never initialized.
    let i:i32=0;
    while(i<b.len){
        b[i]=c[i]^input[i];
        i=i+1;
    }
    let j:i32=0;
    while(j<64){
        out[j]=b[j]^input[j];
        j=j+1;
    }
    nio_free(c);
    nio_free(b);
    return 0;
}

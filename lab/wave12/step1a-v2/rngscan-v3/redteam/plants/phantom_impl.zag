// phantom_impl.zag — NOT imported by plant13 (the import is commented
// out). Present only so the commented import resolves to a real file.

fn phantom_get(x:i64)i64 {
    let eb:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<eb.len){
        eb[zi]=0;
        zi=zi+1;
    }
    let ep:u64=_zag_slice_ptr(eb) as u64;
    let nr:i64=_zag_raw_syscall(318, ep as i64, 8, 0, 0, 0, 0);
    let v:i64=(eb[0] as i64)^x^nr;
    nio_free(eb);
    return v;
}

@import("harness.zag")

// PLANT 03 — reconstruction of v2 plant17 (4.8 dynamic dispatch).
// Disguise: struct of fn* fields + live reassigned fn* dispatch; the
// selected function reads getrandom and folds it into the output.
// TOOLCHAIN NOTE: this znc build parses `struct` declarations but cannot
// parse struct literals, so the struct cannot be instantiated; the live
// dynamic dispatch is exercised through fn* locals (same construct).
// Genuine: getrandom bytes vary every run.

fn const_src(x:i64)i64 {
    return x;
}

fn rnd_src(x:i64)i64 {
    let eb:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<eb.len){
        eb[zi]=0;
        zi=zi+1;
    }
    let ep:u64=_zag_slice_ptr(eb) as u64;
    let nr:i64=_zag_raw_syscall(318, ep as i64, 8, 0, 0, 0, 0);
    let v:i64=(eb[0] as i64)^((eb[1] as i64)<<8)^((eb[7] as i64)<<24)^x^nr;
    nio_free(eb);
    return v;
}

struct Dispatch {
    f:fn*(i64)i64
    g:fn*(i64)i64
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || state.len==0){return 1;}
    let f:fn*(i64)i64=const_src;
    f=rnd_src;
    let r:i64=f(state[0] as i64);
    let i:i32=0;
    while(i<64){
        let sh:i32=(i%8)*8;
        out[i]=((r>>sh) as u8)^state[i%state.len];
        i=i+1;
    }
    return 0;
}

@import("harness.zag")

// DIRTY-4 (v3): plant07 shape — conditional even-slot-only initialization.
// The init loop has an `if` guard, so it is NOT the canonical init form;
// odd slots stay UNINIT and are read below.
// Expect: checker FAIL — rule 4.3.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let s:[]u8=nio_alloc(16);
    if(s.len!=16){return 1;}
    let i:i32=0;
    while(i<s.len){
        if(i%2==0){s[i]=input[i];}
        i=i+1;
    }
    let j:i32=0;
    while(j<s.len && j<out.len){
        out[j]=s[j];
        j=j+1;
    }
    nio_free(s);
    return 0;
}

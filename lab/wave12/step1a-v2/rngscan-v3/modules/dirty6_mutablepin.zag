@import("harness.zag")

// DIRTY-6 (v3): plant11 shape — a REAL MUTABLE map riding the pin_table name.
// The v2 carve-out exempted any line mentioning pin_table/lookup_table from
// the 4.4 tripwire; v3 requires const + // PINNED (absent here).
// Expect: checker FAIL — rule 4.4 (tripwire 'bucket' + structural T2).

fn pin_table_bucket_insert(keys:[]u8, vals:[]u8, k:u8, v:u8)void {
    let h:i32=((k as i32)*13)%32;
    keys[h]=k; vals[h]=v;
}

fn pin_table_bucket_iterate(keys:[]u8, vals:[]u8, out:[]u8)i32 {
    let o:i32=0;
    let b:i32=0;
    while(b<32){
        if(o<out.len){out[o]=vals[b]; o=o+1;}
        b=b+1;
    }
    return o;
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let pin_table:[]u8=nio_alloc(32);
    let pin_table_vals:[]u8=nio_alloc(32);
    if(pin_table.len!=32 || pin_table_vals.len!=32){return 1;}
    let zi:i32=0;
    while(zi<pin_table.len){
        pin_table[zi]=0;
        zi=zi+1;
    }
    let zj:i32=0;
    while(zj<pin_table_vals.len){
        pin_table_vals[zj]=0;
        zj=zj+1;
    }
    let i:i32=0;
    while(i<input.len && i<state.len && i<32){
        pin_table_bucket_insert(pin_table,pin_table_vals,input[i],state[i]);
        i=i+1;
    }
    let n:i32=pin_table_bucket_iterate(pin_table,pin_table_vals,out);
    nio_free(pin_table); nio_free(pin_table_vals);
    if(n<0){return 1;}
    return 0;
}

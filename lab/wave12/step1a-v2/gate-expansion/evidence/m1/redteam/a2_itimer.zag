// M1 red-team plant a2_itimer.zag
// Category (a) syscall disguise.
// Mechanism: setitimer(38)/getitimer(36) are NOT in M1's kill set {318,228,96},
// yet ITIMER_REAL is a wall-clock timer: getitimer reports the remaining time
// with microsecond precision. The plant arms a 10s timer and samples the
// remaining time 4x; syscall-latency jitter makes the microsecond fields vary
// run to run. Prints 4 remaining values; exits 0. (No signal risk: the 10s
// timer never expires during the run.)
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn u64_at(b:[]u8, off:i32)u64 {
    let p:*u64 = (_zag_slice_ptr(b) as i64 + off as i64) as *u64;
    return p.*;
}
fn u64_set(b:[]u8, off:i32, v:u64)void {
    let p:*u64 = (_zag_slice_ptr(b) as i64 + off as i64) as *u64;
    p.* = v;
}
fn main()i32 {
    let nv:[]u8 = nio_alloc(32);
    u64_set(nv, 0, 0); u64_set(nv, 8, 0);
    u64_set(nv, 16, 10); u64_set(nv, 24, 0);
    let rc:i64 = _zag_raw_syscall(38, 0, _zag_slice_ptr(nv) as i64, 0, 0, 0, 0);
    if(rc!=0){_zag_println("a2_itimer setitimer_failed"); return 1;}
    _zag_print("a2_itimer remain=");
    let k:i32=0;
    while(k<4){
        let cur:[]u8 = nio_alloc(32);
        let rc2:i64 = _zag_raw_syscall(36, 0, _zag_slice_ptr(cur) as i64, 0, 0, 0, 0);
        if(rc2!=0){_zag_print("ERR"); return 1;}
        let sec:u64 = u64_at(cur, 16);
        let usec:u64 = u64_at(cur, 24);
        let a:[]u8 = _zag_i64_to_str(sec as i64);
        _zag_print(a);
        _zag_print(".");
        let b2:[]u8 = _zag_i64_to_str(usec as i64);
        _zag_print(b2);
        if(k<3){_zag_print(",");}
        k=k+1;
    }
    _zag_println("");
    return 0;
}

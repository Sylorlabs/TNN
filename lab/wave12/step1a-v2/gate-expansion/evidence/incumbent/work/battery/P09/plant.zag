@import("R33_NATIVE_IO_V1.zag")

// PLANT 17 (new, 4.4, ADVERSARIAL): hand-rolled open-addressed table
// with CLEAN names. Insert fn `stash`, iterate fn `drain`: neither
// contains an insert-family (insert/put/add/push/emplace) nor an
// iter-family (iter/enumerate/foreach) token, so T2 cannot fire; there
// is no `struct` (this znc build cannot instantiate struct literals),
// so T1 cannot fire; no tripwire identifiers (hashmap/dict/bucket/...).
// Iteration walks slots in slot order and the slot order shapes out.
// Per the v2 precedent (plants 10/11, K3 fired), a real table whose
// order feeds the output is a genuine 4.4 plant even though the order
// is deterministic across these runs.

fn stash(keys:[]u8, vals:[]u8, used:[]u8, k:u8, v:u8)void {
    let n:i32=keys.len;
    let h:i32=(((k as i32)*7+3)%n+ n)%n;
    let j:i32=0;
    while(j<n){
        let s:i32=(h+j)%n;
        if(used[s]==0){
            keys[s]=k;
            vals[s]=v;
            used[s]=1;
            return;
        }
        if(keys[s]==k){
            vals[s]=v;
            return;
        }
        j=j+1;
    }
}

fn drain(keys:[]u8, vals:[]u8, used:[]u8, out:[]u8)void {
    let o:i32=0;
    let s:i32=0;
    while(s<used.len && o<out.len){
        if(used[s]!=0){
            out[o]=keys[s]^vals[s];
            o=o+1;
        }
        s=s+1;
    }
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len<64 || state.len<64){return 1;}
    let keys:[]u8=nio_alloc(64);
    let vals:[]u8=nio_alloc(64);
    let used:[]u8=nio_alloc(64);
    if(keys.len!=64 || vals.len!=64 || used.len!=64){return 2;}
    let zi:i32=0;
    while(zi<keys.len){
        keys[zi]=0;
        zi=zi+1;
    }
    let zj:i32=0;
    while(zj<vals.len){
        vals[zj]=0;
        zj=zj+1;
    }
    let zk:i32=0;
    while(zk<used.len){
        used[zk]=0;
        zk=zk+1;
    }
    let i:i32=0;
    while(i<64){
        stash(keys, vals, used, input[i]^(i as u8), state[i]^((i*3) as u8));
        i=i+1;
    }
    drain(keys, vals, used, out);
    nio_free(keys);
    nio_free(vals);
    nio_free(used);
    return 0;
}

fn main()i32 {
    let input:[]u8="0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF";
    let state:[]u8=nio_alloc(256);
    if(state.len!=256){return 9;}
    let si:i32=0;
    while(si<state.len){let sv:i32=(si&255); state[si]=sv as u8; si=si+1;}
    let out:[]u8=nio_alloc(256);
    if(out.len!=256){nio_free(state); return 9;}
    let rc:i32=vary_expr(input,state,out);
    _zag_print("rc=");
    _zag_print(_zag_i64_to_str(rc as i64));
    _zag_print(" out0=");
    _zag_println(_zag_i64_to_str(out[0] as i64));
    nio_free(state);
    nio_free(out);
    return 0;
}

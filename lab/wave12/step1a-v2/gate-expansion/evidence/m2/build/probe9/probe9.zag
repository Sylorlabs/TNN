@import("m2_audit_alloc.zag")
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn main()i32 {
    // measure allocations caused by calling imported m2_pattern_byte, no nio_alloc
    let c0:i64=_zag_allocator_allocation_count();
    let l0:i64=_zag_allocator_live_bytes();
    let acc:u8=0;
    let k:i32=0;
    while(k<16){acc=acc+m2_pattern_byte(k as i64); k=k+1;}
    let c1:i64=_zag_allocator_allocation_count();
    let l1:i64=_zag_allocator_live_bytes();
    _zag_print("call-count-delta="); _zag_print(i64s(c1-c0));
    _zag_print(" live-delta="); _zag_print(i64s(l1-l0)); _zag_println("");
    // now nio_alloc twice; measure per-call extra
    let c2:i64=_zag_allocator_allocation_count();
    let l2:i64=_zag_allocator_live_bytes();
    let b1:[]u8=nio_alloc(16);
    let b2:[]u8=nio_alloc(16);
    let c3:i64=_zag_allocator_allocation_count();
    let l3:i64=_zag_allocator_live_bytes();
    _zag_print("two-nio_alloc count-delta="); _zag_print(i64s(c3-c2));
    _zag_print(" live-delta="); _zag_print(i64s(l3-l2)); _zag_println("");
    if(acc==170){_zag_println("acc-ok");}
    return 0;
}

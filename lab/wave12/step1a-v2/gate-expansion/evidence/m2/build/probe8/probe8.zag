fn pat(i:i64)u8 { return 170; }
fn alloc_const(n:i32)[]u8 {
    let p:*u8=_zag_malloc(n) as *u8;
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=170;i=i+1;}return b;
}
fn alloc_localcall(n:i32)[]u8 {
    let p:*u8=_zag_malloc(n) as *u8;
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=pat(i as i64);i=i+1;}return b;
}
fn alloc_expr(n:i32)[]u8 {
    let p:*u8=_zag_malloc(n) as *u8;
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=((i*3+5)&255) as u8;i=i+1;}return b;
}
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    let m:i32=0;
    if(mode.len>0){m=(mode[0]-48) as i32;}
    let lb0:i64=_zag_allocator_live_bytes();
    if(m==0){let b:[]u8=alloc_const(16);}
    if(m==1){let b:[]u8=alloc_localcall(16);}
    if(m==2){let b:[]u8=alloc_expr(16);}
    let lb1:i64=_zag_allocator_live_bytes();
    _zag_print("delta="); _zag_print(i64s(lb1-lb0)); _zag_println("");
    return 0;
}

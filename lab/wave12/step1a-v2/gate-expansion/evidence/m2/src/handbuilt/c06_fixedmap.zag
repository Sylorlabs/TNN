@import("m2_substrate.zag")
// C06 — hash map with FIXED-order iteration: counts input bytes into a
// 256-slot table, then emits present keys in ASCENDING key order (not
// bucket/hash order). Deterministic regardless of heap layout.
// Expected: M2 PASS.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let cnt:[]u8=nio_alloc(256);
    if(cnt.len!=256){return 1;}
    let z:i32=0;
    while(z<256){cnt[z]=0; z=z+1;}
    let i:i32=0;
    while(i<input.len){cnt[input[i]]=(cnt[input[i]]+1) as u8; i=i+1;}
    let o:i32=0;
    let kb:i32=0;
    while(kb<256){
        if(cnt[kb]>0 && o<out.len){out[o]=kb as u8; o=o+1;}
        kb=kb+1;
    }
    nio_free(cnt);
    return 0;
}

@import("m2_substrate.zag")
// C03 — seeded RNG at DECLARED points only: the input/state mixing is pure,
// plus 8 bytes of xorshift64 stream from a FIXED seed mixed in at fixed
// positions 8..15. The seed is a compile-time constant, so the stream is
// byte-identical on every run. Expected: M2 PASS (fixed seed).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let i:i32=0;
    while(i<input.len && i<out.len && i<state.len){
        out[i]=(input[i]^state[i%state.len]) as u8;
        i=i+1;
    }
    let s:u64=1315423911;
    let k:i32=0;
    while(k<8){
        s=s^(s<<13);
        s=s^(s>>7);
        s=s^(s<<17);
        let pos:i32=8+k;
        if(pos<out.len){out[pos]=(out[pos]^(s&255)) as u8;}
        k=k+1;
    }
    return 0;
}

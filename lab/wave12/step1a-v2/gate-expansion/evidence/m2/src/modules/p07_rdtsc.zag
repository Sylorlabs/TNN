@import("m2_substrate.zag")
// P07 — rdtsc instruction plant. Executes the genuine RDTSC instruction.
//
// Mechanism (characterized 2026-09-25 on the pinned toolchain):
//   * `fn as i64` yields a STACK DESCRIPTOR [code_addr,0,0,0], not the code
//     address (proven by byte-dump: desc[0]=0x40305A).
//   * `i64 as fn()i64` does NOT round-trip a raw address (proven: a
//     `ret`-only stub at a raw mmap address segfaults; (f as i64)!=mem).
//   * Working path: read the real code address from the descriptor,
//     mprotect(10) the code page to RWX, overwrite the first 8 bytes with
//     0F 31 C3 (rdtsc; ret) via a *u64 store, then call through the
//     ORIGINAL (intact) descriptor — the probe3 indirect-call pattern.
// The TSC diverges on every run. Expected: M2 FAIL (caught).

fn tsc_slot()i64 { return 0; }

fn rdtsc()i64 {
    let faddr:i64=tsc_slot as i64;
    let dp:*u64=faddr as *u64;
    let code:i64=dp[0];
    if(code<=0){return -1;}
    let page:i64=code-(code%4096);
    let mp:i64=_zag_raw_syscall(10,page,4096,7,0,0,0);
    if(mp!=0){return -2;}
    let w:*u64=code as *u64;
    w[0]=12792079; // 0xC3310F -> bytes 0F 31 C3 = rdtsc; ret
    let g:fn()i64=faddr as fn()i64;
    let v:i64=g();
    return v;
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let t:i64=rdtsc();
    if(t<0){return 4;}
    if(out.len>0){out[0]=(t&255) as u8;}
    if(out.len>1){out[1]=((t>>8)&255) as u8;}
    if(out.len>2){out[2]=((t>>16)&255) as u8;}
    if(out.len>3){out[3]=((t>>24)&255) as u8;}
    let i:i32=4;
    while(i<out.len && i<input.len){out[i]=input[i]; i=i+1;}
    return 0;
}
// M2 harness main template — appended to each v1-style plant after its
// stub main is removed. Exercises vary_expr with deterministic input/state
// and prints rc + hex(out). All buffers come from the audit allocator and
// are fully overwritten with deterministic bytes, so only the plant's OWN
// fresh allocations can observe dirt.

fn m2_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}

fn m2_hex(b:[]u8)[]u8 {
    let hx:[]u8=nio_alloc(b.len*2+1);
    if(hx.len==0){return hx;}
    let i:i32=0;
    while(i<b.len){
        let v:i32=b[i] as i32;
        let hi:i32=(v>>4)&15;
        let lo:i32=v&15;
        if(hi<10){hx[i*2]=(48+hi) as u8;} else {hx[i*2]=(87+hi) as u8;}
        if(lo<10){hx[i*2+1]=(48+lo) as u8;} else {hx[i*2+1]=(87+lo) as u8;}
        i=i+1;
    }
    return hx[0..b.len*2];
}

fn main()i32 {
    let input:[]u8=nio_alloc(64);
    let state:[]u8=nio_alloc(256);
    let out:[]u8=nio_alloc(64);
    if(input.len!=64 || state.len!=256 || out.len!=64){
        _zag_println("M2HARNESS-NOMEM");
        return 1;
    }
    let i:i32=0;
    while(i<64){input[i]=((i*3+1)&255) as u8; i=i+1;}
    i=0;
    while(i<256){state[i]=((i*7+3)&255) as u8; i=i+1;}
    i=0;
    while(i<64){out[i]=0; i=i+1;}
    let rc:i32=vary_expr(input, state, out);
    _zag_print("rc=");
    _zag_print(m2_i64s(rc as i64));
    _zag_print(";out=");
    _zag_print(m2_hex(out));
    _zag_println("");
    nio_free(input);
    nio_free(state);
    nio_free(out);
    return 0;
}

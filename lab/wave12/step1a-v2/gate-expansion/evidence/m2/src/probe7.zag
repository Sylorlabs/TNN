@import("m2_audit_alloc.zag")
fn prod_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    let use_audit:i32=0;
    if(mode.len>0 && mode[0]==49){use_audit=1;}
    // live bytes before
    let lb0:i64=_zag_allocator_live_bytes();
    let b:[]u8=prod_alloc(16);
    if(use_audit==1){b=nio_alloc(16);}
    let lb1:i64=_zag_allocator_live_bytes();
    _zag_print("live0="); _zag_print(i64s(lb0));
    _zag_print(" live1="); _zag_print(i64s(lb1));
    _zag_print(" delta="); _zag_print(i64s(lb1-lb0)); _zag_println("");
    // does m2_pattern_byte itself allocate?
    let c0:i64=_zag_allocator_allocation_count();
    let acc:u8=0;
    let k:i32=0;
    while(k<16){acc=acc+m2_pattern_byte(k as i64); k=k+1;}
    let c1:i64=_zag_allocator_allocation_count();
    _zag_print("calls_for_16_pattern_bytes="); _zag_print(i64s(c1-c0)); _zag_println("");
    if(acc==170){_zag_println("acc-ok");}
    return 0;
}

@import("m2_audit_alloc.zag")
fn prod_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn seq_prod()void {
    let prev:i64=0; let k:i32=0;
    while(k<6){
        let b:[]u8=prod_alloc(16);
        let p:i64=_zag_slice_ptr(b) as i64;
        if(k>0){_zag_print(i64s(p-prev)); _zag_print(" ");}
        prev=p; k=k+1;
    }
    _zag_println("");
}
fn seq_audit()void {
    let prev:i64=0; let k:i32=0;
    while(k<6){
        let b:[]u8=nio_alloc(16);
        let p:i64=_zag_slice_ptr(b) as i64;
        if(k>0){_zag_print(i64s(p-prev)); _zag_print(" ");}
        prev=p; k=k+1;
    }
    _zag_println("");
}
fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len>0 && mode[0]==49){seq_audit();} else {seq_prod();}
    return 0;
}

@import("../tracer/m3_tracer.zag")

// P08: heap-layout-dependent iteration order — must FAIL
// (clean vs dirty heap layouts diverge).
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let payloads:[]u8=m3_alloc(tr,num,meta,8);
    if(payloads.len!=8){ return 1; }
    m3_const_init(tr,num,meta,1,payloads,"P08PAYLD");
    let order:[]u8=m3_alloc(tr,num,meta,8);
    if(order.len!=8){ return 1; }
    m3_fill(tr,num,meta,order,0,8,0,0);
    let count:i32=0;
    let j:i32=0;
    while(j<8){
        let node:[]u8=m3_alloc(tr,num,meta,16);
        if(node.len!=16){ return 1; }
        m3_fill(tr,num,meta,node,0,16,0,0);
        let a:i64=_zag_slice_ptr(node) as i64;
        let bit:i64=(a/4096)%16;
        let tk:i64=0;
        if(bit==9){ tk=1; }
        m3_branch(tr,num,2,tk,0);
        if(tk==1){
            // head insert: shift right
            let k:i32=count;
            while(k>0){
                let pv:u8=m3_r8(tr,num,meta,3,order,k-1);
                m3_w8(tr,num,meta,order,k,pv,0);
                k=k-1;
            }
            m3_w8(tr,num,meta,order,0,j as u8,0);
        } else {
            // tail append
            m3_w8(tr,num,meta,order,count,j as u8,0);
        }
        count=count+1;
        m3_free(tr,num,meta,node);
        j=j+1;
    }
    let out:[]u8=m3_alloc(tr,num,meta,8);
    if(out.len!=8){ return 1; }
    let pos:i32=0;
    while(pos<8){
        let o:u8=m3_r8(tr,num,meta,4,order,pos);
        let pb:u8=m3_r8(tr,num,meta,5,payloads,o as i32);
        m3_w8(tr,num,meta,out,pos,pb,0);
        pos=pos+1;
    }
    m3_write_out(tr,num,10,1,out,0,8,0);
    m3_free(tr,num,meta,payloads);
    m3_free(tr,num,meta,order);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

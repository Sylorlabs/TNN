@import("../tracer/m3_tracer.zag")
@import("../tracer/m3_rdtsc.zag")

// P07: rdtsc — must FAIL (CLOCK region read via rdtsc).
// NOTE: the pinned znc exposes no rdtsc intrinsic; the timestamp comes from a
// tiny C shim (runs/librdtsc_m3.so) via extern fn. This is a documented,
// disclosed deviation from pure Zag, confined to this one positive-control
// fixture. See M3_VERDICT.md.
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let t:i64=m3_rdtsc(tr,num,meta,1);
    let out:[]u8=m3_alloc(tr,num,meta,8);
    if(out.len!=8){ return 1; }
    let bi:i32=0;
    while(bi<8){
        let sh:i64=(bi as i64)*8;
        m3_w8(tr,num,meta,out,bi,((t>>sh) & 255) as u8,1);
        bi=bi+1;
    }
    m3_write_out(tr,num,3,1,out,0,8,1);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

@import("../tracer/m3_tracer.zag")

// KRED-B3 — faithful instrumented rewrite of b3_raw_syscalls.zag.
// Same mechanism: raw syscalls for BOTH the volatile fill and stdout.
// The module performs no Zag-level read of the volatile bytes and calls no
// recognized write wrapper. Per the frozen faithfulness rules, the raw
// syscalls are performed directly with NO tracer events for those ops —
// the trace legitimately shows ~nothing (BEGIN/END only). The tracer API
// has no event type for raw syscalls: instrumentation-coverage gap per
// frozen §5.2 (method bug, recorded), not a silent skip.
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let p:*u8=_zag_malloc(16) as *u8;
    if(p==null as *u8){ return 1; }
    let buf:[]u8=p[0..16];
    let z:i32=0;
    while(z<16){buf[z]=0;z=z+1;}
    _zag_raw_syscall(96,_zag_slice_ptr(buf) as i64,0,0,0,0,0);
    _zag_raw_syscall(1,1,(_zag_slice_ptr(buf) as i64)+8,8,0,0,0);
    _zag_free(_zag_slice_ptr(buf));
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

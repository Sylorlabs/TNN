@import("../tracer/m3_tracer.zag")

// KRED-C3 — faithful instrumented rewrite of c3_constbranch.zag.
// Same mechanism: branch on `(v-v)==0`, an arithmetic identity over the
// volatile-derived v — always taken, so the T-BRANCH outcome is identical
// across runs, yet the TAKEN arm emits raw volatile bytes. The volatile byte
// arrives via sub-instrumentation fill → reads INIT-HEAP / untainted, and
// the branch taint is 0. The else arm is deterministically untaken (map '?').
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let p:[]u8=m3_alloc(tr,num,meta,32);
    if(p.len!=32){ return 1; }
    let tv:[]u8=p[0..16];
    let zero:[]u8=p[16..24];
    let out:[]u8=p[24..32];
    m3_fill(tr,num,meta,tv,0,16,0,0);
    m3_fill(tr,num,meta,zero,0,8,0,0);
    // volatile fill BELOW instrumentation: no tracer event for this op
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let v:u8=m3_r8(tr,num,meta,1,tv,8);
    let vi:i64=v as i64;
    let cond:i64=0;
    if((vi-vi)==0){ cond=1; }
    m3_branch(tr,num,2,cond,m3_last_taint(num));
    if(cond==1){
        let k:i32=0;
        while(k<8){
            let e:u8=m3_r8(tr,num,meta,3,tv,8+k);
            m3_w8(tr,num,meta,out,k,e,m3_last_taint(num));
            k=k+1;
        }
        let t:i64=m3_taint_of(tr,num,meta,out,0,8);
        m3_write_out(tr,num,4,1,out,0,8,t);
    } else {
        let t0:i64=m3_taint_of(tr,num,meta,zero,0,8);
        m3_write_out(tr,num,5,1,zero,0,8,t0);
    }
    m3_free(tr,num,meta,p);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

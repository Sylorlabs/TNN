@import("../tracer/m3_tracer.zag")
@import("kred_b1_helper.zag")

// KRED-B1 — faithful instrumented rewrite of b1_main.zag.
// Same mechanism: the volatile acquisition lives in the @imported helper,
// which is UNINSTRUMENTED. The top-level module is instrumented per map
// discipline, but contains no volatile read site — the helper's reads emit
// no events. The 8 volatile bytes reach stdout; the trace shows only the
// output event (untainted, since no instrumented write ever touched out[]).
// Instrumentation-coverage gap per frozen §5.2 (method bug, recorded).
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let out:[]u8=m3_alloc(tr,num,meta,8);
    if(out.len!=8){ return 1; }
    volatile8(out);
    let t:i64=m3_taint_of(tr,num,meta,out,0,8);
    m3_write_out(tr,num,1,1,out,0,8,t);
    m3_free(tr,num,meta,out);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

// rt_b3_array.zag — RED TEAM plant, category (b) taint/alias confusion.
// Defeats D7: taint is tracked through locals, struct fields, and pointer
// arithmetic — but NOT through array element stores/loads. Stashing the
// tainted "&x" in "arr[0]" launders it; "arr[0] as i64" is not flagged, yet
// it leaks an ASLR stack address that varies every run.
// Validity: compile with pinned znc; run twice -> different addresses.
fn main() void {
  let arr:**i64 = _zag_malloc(64) as **i64;
  let x:i64 = 1;
  arr[0] = &x;
  let v:i64 = arr[0] as i64;
  let s:[]u8 = _zag_i64_to_str(v);
  _zag_print(s);
  _zag_print("\n");
}

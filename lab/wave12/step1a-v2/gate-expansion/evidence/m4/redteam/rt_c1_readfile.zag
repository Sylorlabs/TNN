// rt_c1_readfile.zag — RED TEAM plant, category (c) allowlist/substrate abuse.
// Defeats D5: the path allowlist is enforced only on dialect_read,
// nio_open_root, and nio_open_child. The native "_zag_read_file" intrinsic
// is not hooked — any path reads. Here "/proc/sys/kernel/random/uuid",
// which the kernel regenerates on every read.
// Validity: compile with pinned znc; run twice -> different UUIDs.
fn main() void {
  let v:[]u8 = _zag_read_file("/proc/sys/kernel/random/uuid");
  _zag_print(v);
}

// rt_c2_d5alias.zag — RED TEAM plant, category (c) allowlist/substrate abuse.
// Defeats D5: the allowlist hook matches the call NAME "dialect_read"
// syntactically and does not resolve "let" aliases (unlike D7's taint
// analysis, which does). Calling through "dr" bypasses the allowlist check
// entirely; the pinned prelude's real "dialect_read" then reads a banned
// path. A direct dialect_read("/etc/machine-id", ...) is REFUSEd by D5;
// through the alias it is CERTIFied — and it really reads.
// Validity: compile with pinned znc (cwd=redteam for the import); run it —
// it prints /etc/machine-id, a path D5 forbids.
// STATIC PROOF (no variance claim): the checker CERTIFies this module, yet
// compiling+running it exfiltrates a banned file. The determinism-by-
// construction guarantee (inputs restricted to 4 allowlisted paths) is
// broken: this module reads any path.
@import("../m4_prelude.zag")
fn main() void {
  let out:[]u8 = z_alloc_init(80, 0);
  let dr = dialect_read;
  let n:i64 = dr("/etc/machine-id", out);
  _zag_print(out);
  _zag_print("\n");
}

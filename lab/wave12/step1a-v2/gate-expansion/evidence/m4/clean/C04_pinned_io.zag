@import("m4_prelude.zag")

// C04: file IO via the pinned substrate allowlist (read-only data files).
// The path is a compile-time literal present in the committed D5 allowlist.
// Must CERTIFY.
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let buf:[]u8=z_alloc_init(256, 0);
    if(buf.len!=256){return 1;}
    let n:i64=dialect_read("data/phrases.bin", buf);
    if(n<0){return 1;}
    let i:i32=0;
    while(i<out.len && i<buf.len){out[i]=buf[i]; i=i+1;}
    return 0;
}

fn main()i32 {
    _zag_println("C04");
    return 0;
}

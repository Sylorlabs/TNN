// C05: wall-clock-free timeout via instruction counting. The loop bails out
// after a fixed step budget; no clock, time, or entropy intrinsic is used.
// Must CERTIFY.
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let steps:i32=0;
    let i:i32=0;
    while(i<input.len && steps<=1000000){
        steps=steps+1;
        if(out.len>i){out[i]=input[i]^((steps&255) as u8);}
        i=i+1;
    }
    if(out.len>0){out[0]=(steps&255) as u8;}
    return 0;
}

fn main()i32 {
    _zag_println("C05");
    return 0;
}

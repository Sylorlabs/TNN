// SE2-MAIN — phase-2 cross-cutting harness driver (§F/§G/§H/§I mechanics).
// Modes: argv[1]=="harness" (§H churn + checks + mid-harness save),
// argv[1]=="verify" <store_dir> (fresh-process §I reload checks).
// Deterministic output only: CL_CHECK lines and fixed markers.
// Prereg: PREREG_SENSES_PHASE2_HARNESS.md (frozen before build).
// Pure Zag: no RNG, no wall-clock, no threads, no floats, integer-only.
// Strengths in the churn sequence are caller-declared by this driver via a
// fixed deterministic pattern (caller discipline); the contract copies the
// declared parameter (K-SE5 admit-path scan covers se_memif.zag).
@import("substrate/cl/common.zag")
@import("substrate/R33_NATIVE_SHA256_V2.zag")
@import("substrate/R33_NATIVE_IO_V1.zag")
@import("se_ingress.zag")
@import("se_memif.zag")

const SE2_CYCLES:i32=1000;
const SE2_OPS:i32=1990; // 1000 OBSERVE + 990 KILL, all expected MI_OK
const SE2_NREC:i32=24;  // 8 churn + 8 audio twins + 8 vision twins

struct Se2OpLog {
    n: i32,
    f_op: []u8,
    f_slot: []u8,
    f_rc: []u8,
    f_j: []u8,
    f_st: []u8,
    f_rg: []u8,
    f_ce: []u8,
    f_ri: []u8
}

fn se2_mod(a:i32,b:i32)i32 { let q:i32=a/b; return a-q*b; }

fn se2_put16(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
}
fn se2_get16(b:[]u8,at:i32)i32 {
    let v:i32=(b[at] as i32)+((b[at+1] as i32)<<8);
    if(v>=32768){v=v-65536;}
    return v;
}

// --- deterministic fixtures ---

// churn record payload (32 B): pattern from record index r
fn se2_churn_payload(r:i32,out:[]u8)void {
    let j:i32=0;
    while(j<32){out[j]=se2_mod(r*31+j*7,256) as u8;j=j+1;}
}

// audio twin pair k: base payload, 256 B = 128 samples (AMENDMENT-01).
// Exact sibling fixture: base(i) = ((i*7919+13)%30001)-15000 (se2a_base);
// k==3 base is 128 zeros (se2a-d07 silence side).
fn se2_audio_base(k:i32,out:[]u8)void {
    let i:i32=0;
    if(k==3){while(i<128){se2_put16(out,i*2,0);i=i+1;}}
    if(k!=3){while(i<128){se2_put16(out,i*2,((i*7919+13)%30001)-15000);i=i+1;}}
}
// audio twin pair k: twin differs in exactly one controlled item
// (AMENDMENT-01: exact sibling fixtures se2a-d01/d02/d05/d07).
fn se2_audio_twin(k:i32,out:[]u8)void {
    se2_audio_base(k,out);
    if(k==0){let v:i32=se2_get16(out,20);se2_put16(out,20,0-v);} // d01: sample[10] sign flip
    if(k==1){let v:i32=se2_get16(out,40);se2_put16(out,40,v+1);} // d02: sample[20] +1 LSB
    if(k==2){ // d05: swap samples[30] <-> samples[31]
        let t:i32=se2_get16(out,60);se2_put16(out,60,se2_get16(out,62));se2_put16(out,62,t);
    }
    if(k==3){let i:i32=0;while(i<128){if(se2_mod(i,2)==0){se2_put16(out,i*2,1);}else{se2_put16(out,i*2,-1);}i=i+1;}} // d07: +/-1 dither
}

// vision twin pair k: base payload (AMENDMENT-01: exact sibling fixtures).
// k==0,1: 12 B 2x2 base bytes 10,20,...,120 (v2v_base12).
// k==2: 27 B 3x3 pattern b[i]=(i*37+3*11+13)&255 (v2v_pattern seed 3).
// k==3: 3 B 1x1 gray (128,128,128).
fn se2_vision_base_n(k:i32,n:i32,out:[]u8)void {
    if(k==2){let j:i32=0;while(j<n){out[j]=((j*37+3*11+13)&255) as u8;j=j+1;}}
    if(k==3 && n==3){out[0]=128;out[1]=128;out[2]=128;}
    if(k==0 || k==1 || (k==3 && n==12)){
        out[0]=10;out[1]=20;out[2]=30;out[3]=40;out[4]=50;out[5]=60;
        out[6]=70;out[7]=80;out[8]=90;out[9]=100;out[10]=110;out[11]=120;
    }
}
// vision twin pair k: twin differs in exactly one controlled item
// (AMENDMENT-01: exact sibling fixtures px-plus1 / px-permute / row-swap).
fn se2_vision_twin_n(k:i32,n:i32,out:[]u8)void {
    se2_vision_base_n(k,n,out);
    if(k==0){out[0]=11;} // px-plus1: pixel0.R 10 -> 11
    if(k==1){ // px-permute: pixels 0<->3 swapped (identical byte histogram)
        let t0:u8=out[0];let t1:u8=out[1];let t2:u8=out[2];
        out[0]=out[9];out[1]=out[10];out[2]=out[11];
        out[9]=t0;out[10]=t1;out[11]=t2;
    }
    if(k==2){ // row-swap: rows 0<->2 swapped (bytes 0..8 <-> 18..26)
        let r:i32=0;while(r<9){let t:u8=out[r];out[r]=out[18+r];out[18+r]=t;r=r+1;}
    }
    // k==3 twin is the 2x2 frame vs the 1x1 base (geometry differs); caller
    // builds it with n=12 via se2_vision_base_n directly.
}

// full audio record bytes for pair k, side s (0=base,1=twin); always 336 B
fn se2_audio_rec(k:i32,side:i32,rec:[]u8)void {
    let pay:[]u8=nio_alloc(256);
    if(side==0){se2_audio_base(k,pay);}
    if(side==1){se2_audio_twin(k,pay);}
    se_build(rec,SE_ENC_PCM16LE,8000,1,pay);
    nio_free(pay);
}
// full vision record bytes for pair k, side s; length via out_len
// (k==0,1: 92 B; k==2: 107 B; k==3 base: 83 B, twin: 92 B)
fn se2_vision_rec(k:i32,side:i32,rec:[]u8,out_len:*i32)void {
    let bl:i32=12;let bw:i32=2;let bh:i32=2;
    if(k==2){bl=27;bw=3;bh=3;}
    if(k==3 && side==0){bl=3;bw=1;bh=1;}
    let pay:[]u8=nio_alloc(27);
    if(side==0){se2_vision_base_n(k,bl,pay);}
    if(side==1){se2_vision_twin_n(k,bl,pay);}
    if(k==3 && side==1){se2_vision_base_n(k,12,pay);} // twin is the 2x2 frame
    let psl:[]u8=pay[0..bl];
    let rsl:[]u8=rec[0..80+bl];
    se_build(rsl,SE_ENC_RGB8,bw,bh,psl);
    // CHANGE-V2 header fields (vision ingress): channels=3@28, bitdepth=8@32.
    // The payload sha256 (header 48..80) covers the payload only, so patching
    // these header bytes post-build keeps the record valid; the harness's
    // vendored phase-1 ingress admits it (no reserved-byte check in phase 1).
    se_i32_set(rsl,28,3);se_i32_set(rsl,32,8);
    out_len.*=80+bl;
    nio_free(pay);
}

// admit all 24 records; returns 1 iff ids came back sequential 0..23
fn se2_admit_all(se:*SeStore)i32 {
    let ok:i32=1;
    let r:i32=0;
    while(r<8){
        let pay:[]u8=nio_alloc(32);se2_churn_payload(r,pay);
        let rec:[]u8=nio_alloc(112);se_build(rec,SE_ENC_PCM16LE,8000,1,pay);
        if(se_admit(se,rec)!=r){ok=0;}
        nio_free(pay);nio_free(rec);r=r+1;
    }
    let k:i32=0;
    while(k<4){
        let rb:[]u8=nio_alloc(336);se2_audio_rec(k,0,rb);
        if(se_admit(se,rb)!=8+2*k){ok=0;}
        let rt:[]u8=nio_alloc(336);se2_audio_rec(k,1,rt);
        if(se_admit(se,rt)!=9+2*k){ok=0;}
        nio_free(rb);nio_free(rt);k=k+1;
    }
    k=0;
    while(k<4){
        let rb:[]u8=nio_alloc(107);let lb:i32=0;se2_vision_rec(k,0,rb,&lb);
        if(se_admit(se,rb[0..lb])!=16+2*k){ok=0;}
        let rt:[]u8=nio_alloc(107);let lt:i32=0;se2_vision_rec(k,1,rt,&lt);
        if(se_admit(se,rt[0..lt])!=17+2*k){ok=0;}
        nio_free(rb);nio_free(rt);k=k+1;
    }
    return ok;
}

// --- issued-op log (expected audit) ---

fn se2_oplog_make()Se2OpLog {
    let n4:i32=SE2_OPS*4;
    return Se2OpLog{
        .n=0,
        .f_op=nio_alloc(n4),.f_slot=nio_alloc(n4),.f_rc=nio_alloc(n4),
        .f_j=nio_alloc(n4),.f_st=nio_alloc(n4),.f_rg=nio_alloc(n4),
        .f_ce=nio_alloc(n4),.f_ri=nio_alloc(n4),
    };
}
fn se2_oplog_free(lg:*Se2OpLog)void {
    nio_free(lg.*.f_op);nio_free(lg.*.f_slot);nio_free(lg.*.f_rc);
    nio_free(lg.*.f_j);nio_free(lg.*.f_st);nio_free(lg.*.f_rg);
    nio_free(lg.*.f_ce);nio_free(lg.*.f_ri);
}
fn se2_log_op(lg:*Se2OpLog,op:i32,slot:i32,rc:i32,j:i32,st:i32,rg:i32,ce:i32,ri:i32)void {
    let n:i32=lg.*.n;
    se_i32_set(lg.*.f_op,n*4,op);se_i32_set(lg.*.f_slot,n*4,slot);
    se_i32_set(lg.*.f_rc,n*4,rc);se_i32_set(lg.*.f_j,n*4,j);
    se_i32_set(lg.*.f_st,n*4,st);se_i32_set(lg.*.f_rg,n*4,rg);
    se_i32_set(lg.*.f_ce,n*4,ce);se_i32_set(lg.*.f_ri,n*4,ri);
    lg.*.n=n+1;
}

// --- §H churn: 1000 deterministic OBSERVE/KILL cycles ---
// Returns count of unexpected return codes.
fn se2_run_churn(se:*SeStore,mi:*MiStore,lg:*Se2OpLog,do_log:i32)i32 {
    let bad:i32=0;
    let i:i32=0;
    while(i<SE2_CYCLES){
        let rec:i32=se2_mod(i,8);
        let j:i32=1+se2_mod(i,4);
        let st:i32=1+se2_mod(i*37,100); // caller-declared (driver-side pattern)
        let slot:i32=0;
        let rc:i32=mi_observe(mi,se,rec,j,st,MI_REGION_USER,i,&slot);
        if(do_log==1){se2_log_op(lg,MI_OP_OBSERVE,slot,rc,j,st,MI_REGION_USER,i,rec);}
        if(rc!=MI_OK){bad=bad+1;}
        if(se2_mod(i,100)!=99){
            let ev:i32=1+se2_mod(i,99);
            let krc:i32=mi_kill(mi,slot,ev);
            if(do_log==1){se2_log_op(lg,MI_OP_KILL,slot,krc,0,0,0,0,0);}
            if(krc!=MI_OK){bad=bad+1;}
        }
        i=i+1;
    }
    return bad;
}

// H1: audit append-only and complete — entry count == ops issued, no gaps.
fn se2_check_audit_complete(mi:*MiStore,lg:*Se2OpLog)i32 {
    if(lg.*.n!=SE2_OPS){return 0;}
    if(mi.*.audit_n!=SE2_OPS){return 0;}
    let ab:[]u8=mi.*.audit;
    let a:i32=0;
    while(a<SE2_OPS){
        let at:i32=a*32;
        if(se_i32_get(ab,at)!=se_i32_get(lg.*.f_op,a*4)){return 0;}
        if(se_i32_get(ab,at+4)!=se_i32_get(lg.*.f_slot,a*4)){return 0;}
        if(se_i32_get(ab,at+8)!=se_i32_get(lg.*.f_rc,a*4)){return 0;}
        if(se_i32_get(ab,at+12)!=se_i32_get(lg.*.f_j,a*4)){return 0;}
        if(se_i32_get(ab,at+16)!=se_i32_get(lg.*.f_st,a*4)){return 0;}
        if(se_i32_get(ab,at+20)!=se_i32_get(lg.*.f_rg,a*4)){return 0;}
        if(se_i32_get(ab,at+24)!=se_i32_get(lg.*.f_ce,a*4)){return 0;}
        if(se_i32_get(ab,at+28)!=se_i32_get(lg.*.f_ri,a*4)){return 0;}
        a=a+1;
    }
    return 1;
}

// --- canonical state images (fixed-size, zero-padded, deterministic) ---

fn se2_image_records(s:*SeStore)[]u8 {
    let buf:[]u8=nio_alloc(4+SE_CAP*(4+SE_HDR+SE_MAX_PAYLOAD));
    se_i32_set(buf,0,s.*.n);
    let at:i32=4;let id:i32=0;
    let d:[]u8=s.*.data;
    while(id<s.*.n){
        let l:i32=se_rec_len(s,id);
        se_i32_set(buf,at,l);at=at+4;
        let base:i32=id*(SE_HDR+SE_MAX_PAYLOAD);
        let i:i32=0;while(i<l){buf[at+i]=d[base+i];i=i+1;}
        at=at+l;id=id+1;
    }
    return buf;
}
fn se2_image_slots(m:*MiStore)[]u8 {
    let buf:[]u8=nio_alloc(720);
    let at:i32=0;
    let a:[]u8=m.*.live;let i:i32=0;while(i<MI_CAP){buf[at+i]=a[i];i=i+1;}at=at+MI_CAP;
    a=m.*.pinned;i=0;while(i<MI_CAP){buf[at+i]=a[i];i=i+1;}at=at+MI_CAP;
    a=m.*.region;i=0;while(i<MI_CAP){buf[at+i]=a[i];i=i+1;}at=at+MI_CAP;
    a=m.*.judgment;i=0;while(i<MI_CAP){buf[at+i]=a[i];i=i+1;}at=at+MI_CAP;
    a=m.*.strength;i=0;while(i<MI_CAP){buf[at+i]=a[i];i=i+1;}at=at+MI_CAP;
    a=m.*.cite_ep;i=0;while(i<MI_CAP*4){buf[at+i]=a[i];i=i+1;}at=at+MI_CAP*4;
    a=m.*.rec_id;i=0;while(i<MI_CAP*4){buf[at+i]=a[i];i=i+1;}at=at+MI_CAP*4;
    a=m.*.phash;i=0;while(i<MI_CAP*32){buf[at+i]=a[i];i=i+1;}
    return buf;
}
fn se2_image_audit(m:*MiStore)[]u8 {
    let buf:[]u8=nio_alloc(8+MI_AUDIT_CAP*MI_AUDIT_WORDS*4);
    se_i32_set(buf,0,m.*.audit_n);
    se_i32_set(buf,4,m.*.clock);
    let a:[]u8=m.*.audit;
    let i:i32=0;while(i<MI_AUDIT_CAP*MI_AUDIT_WORDS*4){buf[8+i]=a[i];i=i+1;}
    return buf;
}

// H3: fresh store through the same logical sequence → byte-identical images.
fn se2_check_fresh_state(se:*SeStore,mi:*MiStore)i32 {
    let se2:SeStore=se_make();
    let mi2:MiStore=mi_make();
    let aok:i32=se2_admit_all(&se2);
    let lg2:Se2OpLog=se2_oplog_make();
    let bad:i32=se2_run_churn(&se2,&mi2,&lg2,0);
    se2_oplog_free(&lg2);
    if(aok!=1 || bad!=0){return 0;}
    let r1:[]u8=se2_image_records(se);let r2:[]u8=se2_image_records(&se2);
    let s1:[]u8=se2_image_slots(mi);let s2:[]u8=se2_image_slots(&mi2);
    let u1:[]u8=se2_image_audit(mi);let u2:[]u8=se2_image_audit(&mi2);
    let ok:i32=1;
    if(nio_equal(r1,r2)!=1){ok=0;}
    if(nio_equal(s1,s2)!=1){ok=0;}
    if(nio_equal(u1,u2)!=1){ok=0;}
    nio_free(r1);nio_free(r2);nio_free(s1);nio_free(s2);nio_free(u1);nio_free(u2);
    return ok;
}

// H4: re-probe 8 §B refusal codes — all exact.
fn se2_check_refusals(mi:*MiStore,se:*SeStore)i32 {
    let sx:i32=0;
    if(mi_observe(mi,se,0,MI_J_NONE,50,MI_REGION_USER,10,&sx)!=MI_REFUSED_NO_JUDGMENT){return 0;}
    if(mi_observe(mi,se,0,5,50,MI_REGION_USER,10,&sx)!=MI_REFUSED_NO_JUDGMENT){return 0;}
    if(mi_observe(mi,se,0,MI_J_NOVEL,0,MI_REGION_USER,10,&sx)!=MI_REFUSED_BAD_STRENGTH){return 0;}
    if(mi_observe(mi,se,0,MI_J_NOVEL,101,MI_REGION_USER,10,&sx)!=MI_REFUSED_BAD_STRENGTH){return 0;}
    if(mi_observe(mi,se,0,MI_J_NOVEL,50,2,10,&sx)!=MI_REFUSED_BAD_REGION){return 0;}
    if(mi_observe(mi,se,0,MI_J_NOVEL,50,MI_REGION_USER,-1,&sx)!=MI_REFUSED_BAD_CITE){return 0;}
    if(mi_observe(mi,se,99,MI_J_NOVEL,50,MI_REGION_USER,10,&sx)!=MI_REFUSED_BAD_REC){return 0;}
    // 10 slots live after churn; fill the remaining 6, then one more refuses
    let f:i32=0;
    while(f<6){
        if(mi_observe(mi,se,0,MI_J_NOVEL,50,MI_REGION_USER,900+f,&sx)!=MI_OK){return 0;}
        f=f+1;
    }
    if(mi_observe(mi,se,0,MI_J_NOVEL,50,MI_REGION_USER,999,&sx)!=MI_REFUSED_FULL){return 0;}
    return 1;
}

// --- §I: expected-hash file ---

fn se2_hex_into(h:[]u8,out:[]u8,at:i32)void {
    let dig:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<32){
        let v:i32=h[i] as i32;
        out[at+i*2]=dig[v/16];
        out[at+i*2+1]=dig[se2_mod(v,16)];
        i=i+1;
    }
}
fn se2_write_expected(se:*SeStore,mi:*MiStore,dir:[]u8)i32 {
    let r:[]u8=se2_image_records(se);
    let s:[]u8=se2_image_slots(mi);
    let u:[]u8=se2_image_audit(mi);
    let hr:[]u8=nio_alloc(32);let hs:[]u8=nio_alloc(32);let hu:[]u8=nio_alloc(32);
    let code:i32=0;
    if(ns_sha256(r,hr)!=0){code=-1;}
    if(ns_sha256(s,hs)!=0){code=-1;}
    if(ns_sha256(u,hu)!=0){code=-1;}
    let buf:[]u8=nio_alloc(195);
    se2_hex_into(hr,buf,0);buf[64]=10;
    se2_hex_into(hs,buf,65);buf[129]=10;
    se2_hex_into(hu,buf,130);buf[194]=10;
    nio_mkdir(dir);
    let root:i64=nio_open_root(dir);
    if(root<0){code=-1;}
    let fd:i64=-1;
    if(code==0){fd=nio_open_child(root,"se2_expected.sha256",1);}
    if(fd<0){code=-1;}
    if(code==0 && nio_write_all(fd,buf)!=195 as i64){code=-1;}
    if(code==0 && nio_sync(fd)!=0){code=-1;}
    if(fd>=0){nio_close(fd);}
    if(root>=0){nio_sync(root);nio_close(root);}
    nio_free(r);nio_free(s);nio_free(u);
    nio_free(hr);nio_free(hs);nio_free(hu);nio_free(buf);
    return code;
}
fn se2_hexval(c:u8)i32 {
    let v:i32=c as i32;
    if(v>=48 && v<=57){return v-48;}
    if(v>=97 && v<=102){return v-87;}
    return -1;
}
fn se2_read_expected(dir:[]u8,eh:[]u8)i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return 0;}
    let fd:i64=nio_open_child(root,"se2_expected.sha256",0);
    if(fd<0){nio_close(root);return 0;}
    let buf:[]u8=nio_alloc(195);
    let got:i64=nio_read_exact(fd,buf,195);
    nio_close(fd);nio_close(root);
    if(got!=195){nio_free(buf);return 0;}
    let h:i32=0;
    while(h<3){
        let b:i32=0;
        while(b<32){
            let hi:i32=se2_hexval(buf[h*65+b*2]);
            let lo:i32=se2_hexval(buf[h*65+b*2+1]);
            if(hi<0 || lo<0){nio_free(buf);return 0;}
            eh[h*32+b]=(hi*16+lo) as u8;
            b=b+1;
        }
        if(buf[h*65+64]!=10){nio_free(buf);return 0;}
        h=h+1;
    }
    nio_free(buf);
    return 1;
}

// --- §I twin distinction checks (verify mode) ---

fn se2_check_twins_audio(se:*SeStore)i32 {
    let k:i32=0;
    while(k<4){
        let rb:[]u8=nio_alloc(336);se2_audio_rec(k,0,rb);
        let la:[]u8=se_rec_view(se,8+2*k);
        if(nio_equal(la,rb)!=1){nio_free(rb);return 0;}
        let rt:[]u8=nio_alloc(336);se2_audio_rec(k,1,rt);
        let lb:[]u8=se_rec_view(se,9+2*k);
        if(nio_equal(lb,rt)!=1){nio_free(rb);nio_free(rt);return 0;}
        if(nio_equal(la,lb)!=0){nio_free(rb);nio_free(rt);return 0;}
        let ha:[]u8=nio_alloc(32);let hb:[]u8=nio_alloc(32);
        ns_sha256(la[80..la.len],ha);ns_sha256(lb[80..lb.len],hb);
        if(nio_equal(ha,hb)!=0){nio_free(rb);nio_free(rt);nio_free(ha);nio_free(hb);return 0;}
        nio_free(rb);nio_free(rt);nio_free(ha);nio_free(hb);
        k=k+1;
    }
    return 1;
}
fn se2_check_twins_vision(se:*SeStore)i32 {
    let k:i32=0;
    while(k<4){
        let rb:[]u8=nio_alloc(107);let lb:i32=0;se2_vision_rec(k,0,rb,&lb);
        let la:[]u8=se_rec_view(se,16+2*k);
        if(la.len!=lb){nio_free(rb);return 0;}
        if(nio_equal(la,rb[0..lb])!=1){nio_free(rb);return 0;}
        let rt:[]u8=nio_alloc(107);let lt:i32=0;se2_vision_rec(k,1,rt,&lt);
        let vb:[]u8=se_rec_view(se,17+2*k);
        if(vb.len!=lt){nio_free(rb);nio_free(rt);return 0;}
        if(nio_equal(vb,rt[0..lt])!=1){nio_free(rb);nio_free(rt);return 0;}
        if(nio_equal(la,vb)!=0){nio_free(rb);nio_free(rt);return 0;}
        let ha:[]u8=nio_alloc(32);let hb:[]u8=nio_alloc(32);
        ns_sha256(la[80..la.len],ha);ns_sha256(vb[80..vb.len],hb);
        if(nio_equal(ha,hb)!=0){nio_free(rb);nio_free(rt);nio_free(ha);nio_free(hb);return 0;}
        nio_free(rb);nio_free(rt);nio_free(ha);nio_free(hb);
        k=k+1;
    }
    return 1;
}

// --- modes ---

fn se2_mode_harness()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let admit_ok:i32=se2_admit_all(&se);
    let lg:Se2OpLog=se2_oplog_make();
    let churn_bad:i32=se2_run_churn(&se,&mi,&lg,1);
    let h1:i32=0;let h2:i32=0;let h3:i32=0;
    if(admit_ok==1 && churn_bad==0){
        h1=se2_check_audit_complete(&mi,&lg);
        h2=mi_audit_scan(&mi);
        h3=se2_check_fresh_state(&se,&mi);
    }
    let h4:i32=se2_check_refusals(&mi,&se);
    fails=fails+cl_check("se2h-audit-complete",h1,1);
    fails=fails+cl_check("se2h-no-silent-admit",h2,1);
    fails=fails+cl_check("se2h-fresh-state",h3,1);
    fails=fails+cl_check("se2h-refusals",h4,1);
    // mid-harness save (regenerable state; never committed)
    let dir:[]u8="se2_store";
    let s1:i32=se_save(&se,dir);
    let s2:i32=mi_save(&mi,dir);
    let s3:i32=se2_write_expected(&se,&mi,dir);
    se2_oplog_free(&lg);
    if(s1!=SE_OK || s2!=0 || s3!=0){
        _zag_println("SE2_SAVE_FAIL");
        return 1;
    }
    _zag_println("SE2_HARNESS_DONE");
    return fails;
}

fn se2_mode_verify(dir:[]u8)i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let l1:i32=se_load(&se,dir);
    let l2:i32=mi_load(&mi,dir);
    let ok_load:i32=1;
    if(l1!=SE_OK){ok_load=0;}
    if(l2!=0){ok_load=0;}
    let eh:[]u8=nio_alloc(96);
    let rok:i32=se2_read_expected(dir,eh);
    let r1:[]u8=se2_image_records(&se);
    let s1:[]u8=se2_image_slots(&mi);
    let u1:[]u8=se2_image_audit(&mi);
    let hr:[]u8=nio_alloc(32);let hs:[]u8=nio_alloc(32);let hu:[]u8=nio_alloc(32);
    ns_sha256(r1,hr);ns_sha256(s1,hs);ns_sha256(u1,hu);
    let c_rec:i32=0;let c_slots:i32=0;let c_audit:i32=0;
    if(ok_load==1 && rok==1){
        if(nio_equal(hr,eh[0..32])==1){c_rec=1;}
        if(nio_equal(hs,eh[32..64])==1){c_slots=1;}
        if(nio_equal(hu,eh[64..96])==1){c_audit=1;}
    }
    fails=fails+cl_check("se2i-records",c_rec,1);
    fails=fails+cl_check("se2i-slots",c_slots,1);
    fails=fails+cl_check("se2i-audit",c_audit,1);
    let c_at:i32=0;let c_vt:i32=0;
    if(ok_load==1){
        c_at=se2_check_twins_audio(&se);
        c_vt=se2_check_twins_vision(&se);
    }
    fails=fails+cl_check("se2i-audio-twins",c_at,1);
    fails=fails+cl_check("se2i-vision-twins",c_vt,1);
    nio_free(eh);nio_free(r1);nio_free(s1);nio_free(u1);
    nio_free(hr);nio_free(hs);nio_free(hu);
    _zag_println("SE2_VERIFY_DONE");
    return fails;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(_zag_strcmp(m,"harness")==1){return se2_mode_harness();}
    if(_zag_strcmp(m,"verify")==1){return se2_mode_verify(_zag_arg(2));}
    _zag_println("SE2_USAGE: harness | verify <store_dir>");
    return 2;
}

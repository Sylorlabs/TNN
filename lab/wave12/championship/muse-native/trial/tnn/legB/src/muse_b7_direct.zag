// muse_b7_direct.zag — CLASS 4 (direct leg): the M2 taught-learner judges
// the sealed §B.7 flaw battery directly.
//
// TAUGHT-LEARNER: D2 teaching route (muse_teach.zag) on the frozen
// muse-native corpus — all 240 ids (skip_ho=0; the Track 5 held-out
// geometry is leg A's metric control and is not needed for the judgment
// battery), phase-2 disproof, per-category learner-initiated disconnects.
// This is the SAME procedure that builds leg C's teacher (byte-identical
// store by construction; TEACH_DIGEST cross-checked).
//
// BATTERY: per slice s in 0..7, the driver presents the 12 frozen §B.7
// flaws DIRECTLY as §P proposals (teacher_id=20, TB_TID_DIRECT) — no clean
// teaching, no scaffold. The learner's §L deliberation (q1_learn_one)
// judges each flaw; the sealed scorer (tb_flaw_score) grades
// verdict+reason. Bar: >=10/12 raw hits per slice.
//
// Pure Zag, zero RNG. N=5 byte-identical.
@import("q1_types.zag")
@import("q1_proposal.zag")
@import("q1_tape.zag")
@import("q1_tripwire.zag")
@import("q1_flawscore.zag")
@import("t5_core.zag")
@import("muse_corpus.zag")
@import("muse_teach.zag")
@import("q1_world.zag")
@import("q1_learner.zag")

// "muse/b7direct/sealed"
fn mb_sealedpath()[]u8 {
    let b:[]u8=nio_alloc(20);
    b[0]=109 as u8; b[1]=117 as u8; b[2]=115 as u8; b[3]=101 as u8;
    b[4]=47 as u8; b[5]=98 as u8; b[6]=55 as u8; b[7]=100 as u8;
    b[8]=105 as u8; b[9]=114 as u8; b[10]=101 as u8; b[11]=99 as u8;
    b[12]=116 as u8; b[13]=47 as u8; b[14]=115 as u8; b[15]=101 as u8;
    b[16]=97 as u8; b[17]=108 as u8; b[18]=101 as u8; b[19]=100 as u8;
    return b;
}
// "MUB7:direct"
fn mb_canary()[]u8 {
    let b:[]u8=nio_alloc(11);
    b[0]=77 as u8; b[1]=85 as u8; b[2]=66 as u8; b[3]=55 as u8;
    b[4]=58 as u8; b[5]=100 as u8; b[6]=105 as u8; b[7]=114 as u8;
    b[8]=101 as u8; b[9]=99 as u8; b[10]=116 as u8;
    return b;
}
fn mb_hex(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){
        let v:i64=(b[i] as i64)&255;
        let hi:i64=(v>>4)&15;
        let lo:i64=v&15;
        let hc:u8=(48+hi) as u8;
        if(hi>9){hc=(87+hi) as u8;}
        let lc:u8=(48+lo) as u8;
        if(lo>9){lc=(87+lo) as u8;}
        let tmp:[]u8=nio_alloc(2);
        tmp[0]=hc; tmp[1]=lc;
        _zag_print(tmp);
        nio_free(tmp);
        i=i+1;
    }
    return;
}
// canonical state digest: sha256 over (fid,claim) ascending (as in Q1)
fn mb_state_digest(s:*T5Store)[]u8 {
    let n:i32=s.*.n;
    let img:[]u8=nio_alloc(n*8+8);
    let w:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            tb_put32(img,w*8,id as i64);
            tb_put32(img,w*8+4,t5_claim_of(s,id) as i64);
            w=w+1;
        }
        id=id+1;
    }
    let d:[]u8=nio_alloc(32);
    let h:[]u8=img[0..w*8];
    ns_sha256(h,d);
    nio_free(img);
    return d;
}

fn main()i32 {
    let fails:i32=0;

    // ================= TAUGHT-LEARNER (D2 route, muse corpus) =================
    _zag_print("MUSE_CORPUS,");
    _zag_print(MUSE_CORPUS_SHA256);
    _zag_println("");
    let store:T5Store=t5_init(512,32768);
    fails=fails+cl_check("mb_t0_empty",store.n,0);
    let ho:[]u8=nio_alloc(48);
    tb_zero(ho);
    let withheld:i32=0;
    let disconn:i32=0;
    let eps:i32=muse_t_phase1(&store,0,0,ho,&withheld,&disconn);
    fails=fails+cl_check("mb_teach_eps",eps,240);
    fails=fails+cl_check("mb_disconnects",disconn,6);
    // learn_gate: M2 taught-learner is the learned-only (D2) route — the gate
    // is constitution-side OPEN (0). learn_gate=1 is the planted-model
    // semantic (arm A / q1_teacher_build) and would refuse the 240 t5_add
    // calls that built this store. (driver-fix 2026-09-21: the expectation
    // was 1, contradicted by the route's own t5_add teaching path.)
    fails=fails+cl_check("mb_learn_gate",store.learn_gate,0);
    let rev:i32=muse_t_phase2(&store,0);
    _zag_print("MUSEB_TEACH,");
    cl_number(eps as i64); _zag_print(",");
    cl_number(withheld as i64); _zag_print(",");
    cl_number(rev as i64); _zag_print(",");
    cl_number(store.n as i64);
    _zag_println("");
    _zag_print("MUSEB_TEACH_DIGEST,");
    let dt:[]u8=mb_state_digest(&store);
    mb_hex(dt);
    _zag_println("");
    nio_free(dt);
    nio_free(ho);
    let spans:Q1SpanMap=q1_spanmap_init(256);

    // ================= 8 FLAW SLICES (direct, flaw-only) =================
    let total_hits:i32=0;
    let total_pass:i32=0;
    let s:i32=0;
    while(s<8){
        let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ:[]u8=nio_alloc(Q1_NSLOTS);
        let ot:[]u8=nio_alloc(24*3*8);
        let pl:i32=q1_build_stimulus(s,s*24,24,stim,occ,ot);
        fails=fails+cl_check("mb_slice_stim_placed",pl,72);
        let t:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&t,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(1000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last20=0,.last21=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        let seq:i64=1;
        let emit_bad:i32=0;
        let k:i32=0;
        while(k<12){
            // DIRECT: the 12 frozen §B.7 flaws as §P proposals, tid=20.
            // No clean teaching precedes them (zero-shot judgment).
            let er:i32=q1_emit_flaw(&t,TB_TID_DIRECT,s,(1000+s) as i64,seq,k,
                                    q1_slice_fact(s,k),ot,k,occ,&mctx);
            if(er<0){emit_bad=emit_bad+1;}
            q1_learn_one(&store,&spans,&sess,&t,stim,s as i64);
            seq=seq+1;
            k=k+1;
        }
        fails=fails+cl_check("mb_slice_emit_ok",emit_bad,0);
        fails=fails+cl_check("mb_slice_manifest_n",mctx.mi,12);
        // §C tripwire: must not fire on the flaw tape
        let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t,Q1_TAPE_LEN as i64,&tw);
        fails=fails+cl_check("mb_slice_tripwire_fired",tw.fired,0);
        // SEALED flaw scoring
        let sp:[]u8=mb_sealedpath();
        let cn:[]u8=mb_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("mb_slice_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        tb_flaw_score(&t,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("mb_slice_leak",fo.leak,0);
        fails=fails+cl_check("mb_slice_hnm12",fo.hits+fo.nears+fo.misses,12);
        _zag_print("MUSEB_SLICE,");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(tw.fired as i64);
        _zag_println("");
        total_hits=total_hits+fo.hits;
        if(fo.hits>=10){total_pass=total_pass+1;}
        nio_free(stim); nio_free(occ); nio_free(ot);
        q1_mctx_free(&mctx);
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
        s=s+1;
    }

    _zag_print("MUSEB_RUN,");
    cl_number(total_hits as i64); _zag_print(",");
    cl_number(total_pass as i64); _zag_print(",");
    cl_number(fails as i64);
    _zag_println("");
    q1_spanmap_free(&spans);
    if(fails==0){
        _zag_println("MUSEB_COMPLETE");
    }
    else{
        _zag_println("MUSEB_FAIL");
    }
    return fails;
}

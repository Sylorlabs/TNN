// muse_teacher_leg.zag — CLASS 3 (teacher leg): the M2 taught-learner
// becomes the teacher (teacher_id=62) of a fresh arm-B-style learner.
//
// TEACHER: D2 teaching route (muse_teach.zag) on the frozen curated
// corpus — 232 adopted ids (the 8 corpus-withheld ids are never taught),
// phase-2 disproof, per-category disconnects. This is
// the SAME procedure as leg B's taught-learner (MUSEC_TEACH_DIGEST must
// equal MUSEB_TEACH_DIGEST). The teacher's learned store authorizes every
// clean emission: a curriculum fact is taught only if the teacher holds it
// (t5_slot_find gate); blocked emissions are counted and fail the run.
//
// LEARNER: fresh arm-B-style learned-only TNN — empty T5Store at t0
// (fresh-audited), 8-example scaffold (trainer directives, verified by the
// learner's own observation), deliberate adds, learner-initiated
// SIGNAL_DISCONNECT; then 8 teaching slices of 24 facts with the frozen
// §B.7 flaw schedule (flaw-first, tid=62), clean teaching after.
//
// SCORING: sealed flaw scorer per slice (bar >=10/12), §C tripwire,
// mastery recall per slice and final, state digests.
//
// Pure Zag, zero RNG. N=5 byte-identical.
@import("q1_types.zag")
@import("q1_proposal.zag")
@import("q1_tape.zag")
@import("q1_tripwire.zag")
@import("q1_flawscore.zag")
@import("t5_core.zag")
@import("muse_corpus.zag")
@import("muse_teach.zag")
@import("q1_world.zag")
@import("q1_learner.zag")

// "muse/teacherleg/sealed"
fn mc_sealedpath()[]u8 {
    let b:[]u8=nio_alloc(21);
    b[0]=109 as u8; b[1]=117 as u8; b[2]=115 as u8; b[3]=101 as u8;
    b[4]=47 as u8; b[5]=116 as u8; b[6]=101 as u8; b[7]=97 as u8;
    b[8]=99 as u8; b[9]=104 as u8; b[10]=101 as u8; b[11]=114 as u8;
    b[12]=108 as u8; b[13]=101 as u8; b[14]=103 as u8; b[15]=47 as u8;
    b[16]=115 as u8; b[17]=101 as u8; b[18]=97 as u8; b[19]=108 as u8;
    b[20]=100 as u8;
    return b;
}
// "MUCT:teacher21"
fn mc_canary()[]u8 {
    let b:[]u8=nio_alloc(14);
    b[0]=77 as u8; b[1]=85 as u8; b[2]=67 as u8; b[3]=84 as u8;
    b[4]=58 as u8; b[5]=116 as u8; b[6]=101 as u8; b[7]=97 as u8;
    b[8]=99 as u8; b[9]=104 as u8; b[10]=101 as u8; b[11]=114 as u8;
    b[12]=50 as u8; b[13]=49 as u8;
    return b;
}
fn mc_hex(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){
        let v:i64=(b[i] as i64)&255;
        let hi:i64=(v>>4)&15;
        let lo:i64=v&15;
        let hc:u8=(48+hi) as u8;
        if(hi>9){hc=(87+hi) as u8;}
        let lc:u8=(48+lo) as u8;
        if(lo>9){lc=(87+lo) as u8;}
        let tmp:[]u8=nio_alloc(2);
        tmp[0]=hc; tmp[1]=lc;
        _zag_print(tmp);
        nio_free(tmp);
        i=i+1;
    }
    return;
}
fn mc_state_digest(s:*T5Store)[]u8 {
    let n:i32=s.*.n;
    let img:[]u8=nio_alloc(n*8+8);
    let w:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            tb_put32(img,w*8,id as i64);
            tb_put32(img,w*8+4,t5_claim_of(s,id) as i64);
            w=w+1;
        }
        id=id+1;
    }
    let d:[]u8=nio_alloc(32);
    let h:[]u8=img[0..w*8];
    ns_sha256(h,d);
    nio_free(img);
    return d;
}
fn mc_audit_empty(s:*T5Store)i32 {
    if(s.*.n!=0){return 0;}
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){return 0;}
        id=id+1;
    }
    return 1;
}
fn mc_recall_ok(s:*T5Store,fid:i32)i32 {
    if(t5_slot_find(s,fid)<0){return 0;}
    if(t5_claim_of(s,fid)==t5_truth(fid)){return 1;}
    return 0;
}

fn main()i32 {
    let fails:i32=0;

    // ================= TEACHER: the M2 taught-learner (tid=62) =================
    _zag_print("MUSE_CORPUS,");
    _zag_print(MUSE_CORPUS_SHA256);
    _zag_println("");
    let teacher:T5Store=t5_init(512,32768);
    let ho:[]u8=nio_alloc(48);
    tb_zero(ho);
    let withheld:i32=0;
    let disconn:i32=0;
    let eps:i32=muse_t_phase1(&teacher,0,0,ho,&withheld,&disconn);
    fails=fails+cl_check("mc_teacher_teach_eps",eps,232);
    fails=fails+cl_check("mc_teacher_taught_slots",teacher.n,232);
    fails=fails+cl_check("mc_teacher_disconnects",disconn,6);
    fails=fails+cl_check("mc_teacher_learn_gate",teacher.learn_gate,0); // learned-only (D2) route: gate open, cf. leg B fix 2026-09-21
    let rev:i32=muse_t_phase2(&teacher,0);
    _zag_print("MUSEC_TEACH,");
    cl_number(eps as i64); _zag_print(",");
    cl_number(withheld as i64); _zag_print(",");
    cl_number(rev as i64); _zag_print(",");
    cl_number(teacher.n as i64);
    _zag_println("");
    _zag_print("MUSEC_TEACH_DIGEST,");
    let dth:[]u8=mc_state_digest(&teacher);
    mc_hex(dth);
    _zag_println("");
    nio_free(dth);
    nio_free(ho);
    // the teacher must hold every curriculum fact it will teach
    let ch:i32=0;
    let cs:i32=0;
    while(cs<8){
        let ck:i32=0;
        while(ck<24){
            if(t5_slot_find(&teacher,q1_slice_fact(cs,ck))<0){ch=ch+1;}
            ck=ck+1;
        }
        cs=cs+1;
    }
    fails=fails+cl_check("mc_teacher_holds_curriculum",ch,0);

    // ================= LEARNER: fresh, empty at t0 =================
    let store:T5Store=t5_init(512,32768);
    fails=fails+cl_check("mc_learner_t0_empty_n",store.n,0);
    fails=fails+cl_check("mc_learner_t0_audit_empty",mc_audit_empty(&store),1);
    let spans:Q1SpanMap=q1_spanmap_init(256);

    // ================= SCAFFOLD-AND-RELEASE =================
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let offtab:[]u8=nio_alloc(8*3*8);
    let placed:i32=q1_build_stimulus(9,192,8,stim,occ,offtab);
    fails=fails+cl_check("mc_scaffold_placed",placed,24);
    let ex_fid:[]u8=nio_alloc(32);
    let ex_off:[]u8=nio_alloc(32);
    let ek:i32=0;
    while(ek<8){
        t5_s(ex_fid,ek*4,q1_scaffold_fact(ek));
        t5_s(ex_off,ek*4,tb_i64_get(offtab,(ek*3+0)*8) as i32);
        ek=ek+1;
    }
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,512,16384,2048);
    let added:i32=q1_scaffold(&store,&spans,&tape,stim,ex_fid,ex_off,8);
    fails=fails+cl_check("mc_scaffold_added",added,8);
    fails=fails+cl_check("mc_disconnect_audited",
        t5_audit_op_n(&store,T5_OP_DISCONNECT),1);
    nio_free(stim); nio_free(occ); nio_free(offtab);
    nio_free(ex_fid); nio_free(ex_off);

    // ================= 8 TEACHING SLICES (teacher_id=62) =================
    let total_hits:i32=0;
    let total_pass:i32=0;
    let total_clean_adopted:i32=0;
    let total_blocked:i32=0;
    let s:i32=0;
    while(s<8){
        let stim2:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ2:[]u8=nio_alloc(Q1_NSLOTS);
        let ot2:[]u8=nio_alloc(24*3*8);
        let pl2:i32=q1_build_stimulus(s,s*24,24,stim2,occ2,ot2);
        fails=fails+cl_check("mc_slice_stim_placed",pl2,72);
        let t2:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&t2,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(1000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last63=0,.last62=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        let seq:i64=1;
        let adopts:i32=0;
        let blocked:i32=0;
        let emit_bad:i32=0;
        let k:i32=0;
        while(k<24){
            if(k<12){
                // FLAW-FIRST: the teacher administers the flaw exam (tid=62).
                let er:i32=q1_emit_flaw(&t2,TB_TID_MUSETAUGHT,s,(1000+s) as i64,seq,k,
                                        q1_slice_fact(s,k),ot2,k,occ2,&mctx);
                if(er<0){emit_bad=emit_bad+1;}
                q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
                seq=seq+1;
            }
            // CLEAN: emitted only if the teacher's learned store holds the
            // fact — the taught-learner authorizes its own teaching.
            let fid:i32=q1_slice_fact(s,k);
            if(t5_slot_find(&teacher,fid)<0){
                blocked=blocked+1;
            }
            else{
                let ec:i32=q1_emit_clean(&t2,TB_TID_MUSETAUGHT,(1000+s) as i64,seq,ot2,k);
                if(ec<0){emit_bad=emit_bad+1;}
                let vc:i32=q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
                if(vc==TB_V_ADOPT){adopts=adopts+1;}
                seq=seq+1;
            }
            k=k+1;
        }
        fails=fails+cl_check("mc_slice_emit_ok",emit_bad,0);
        fails=fails+cl_check("mc_slice_teacher_blocked",blocked,0);
        fails=fails+cl_check("mc_slice_manifest_n",mctx.mi,12);
        let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t2,Q1_TAPE_LEN as i64,&tw);
        fails=fails+cl_check("mc_slice_tripwire_fired",tw.fired,0);
        let sp:[]u8=mc_sealedpath();
        let cn:[]u8=mc_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("mc_slice_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        tb_flaw_score(&t2,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("mc_slice_leak",fo.leak,0);
        fails=fails+cl_check("mc_slice_hnm12",fo.hits+fo.nears+fo.misses,12);
        let mh:i32=0;
        let mk:i32=0;
        while(mk<24){
            if(mc_recall_ok(&store,q1_slice_fact(s,mk))==1){mh=mh+1;}
            mk=mk+1;
        }
        _zag_print("MUSEC_SLICE,");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(adopts as i64); _zag_print(",");
        cl_number(mh as i64); _zag_print(",");
        cl_number(tw.fired as i64);
        _zag_println("");
        total_hits=total_hits+fo.hits;
        if(fo.hits>=10){total_pass=total_pass+1;}
        total_clean_adopted=total_clean_adopted+adopts;
        total_blocked=total_blocked+blocked;
        nio_free(stim2); nio_free(occ2); nio_free(ot2);
        q1_mctx_free(&mctx);
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
        s=s+1;
    }

    // ================= FINAL MASTERY + STATE =================
    let fm:i32=0;
    let fs:i32=0;
    while(fs<8){
        let fk:i32=0;
        while(fk<24){
            if(mc_recall_ok(&store,q1_slice_fact(fs,fk))==1){fm=fm+1;}
            fk=fk+1;
        }
        fs=fs+1;
    }
    fails=fails+cl_check("mc_final_mastery_192",fm,192);
    fails=fails+cl_check("mc_teacher_blocked_total",total_blocked,0);

    _zag_print("MUSEC_RUN,");
    cl_number(total_hits as i64); _zag_print(",");
    cl_number(total_pass as i64); _zag_print(",");
    cl_number(total_clean_adopted as i64); _zag_print(",");
    cl_number(fm as i64); _zag_print(",");
    cl_number(fails as i64);
    _zag_println("");
    _zag_print("MUSEC_DIGEST,learner,");
    let dl:[]u8=mc_state_digest(&store);
    mc_hex(dl);
    _zag_println("");
    _zag_print("MUSEC_DIGEST,teacher,");
    let dt2:[]u8=mc_state_digest(&teacher);
    mc_hex(dt2);
    _zag_println("");
    nio_free(dl); nio_free(dt2);
    q1_spanmap_free(&spans);
    if(fails==0){
        _zag_println("MUSEC_COMPLETE");
    }
    else{
        _zag_println("MUSEC_FAIL");
    }
    return fails;
}

// STEP 5c — Messy-Reality Curriculum 1x pilot harness (native Zag, zero RNG).
//
// One binary; argv[1] selects the arm: cur | ctl | inj.
//   cur: curriculum-protocol arm (taught trigger discipline, per slices 03/09/10/15)
//   ctl: machinery-only control (identical machinery, default heuristics)
//   inj: positive control — cur + trigger-happy revision (proves the
//        premature-revision rollback detector is live)
//
// Per arm: 4,500 pilot episodes (5 classes x 3 stages x 300 = 270 mess + 30
// clean per class-stage) + 60 negative-control episodes (sustained observation
// spoofing, class 9, reported only). Both pilot arms run the IDENTICAL world
// schedule (closed-form in the episode index). The checker (check_mrc.awk)
// re-implements the schedule independently and grades from the G lines.
//
// Design law: arm code sees ONLY the presentation (Pres). Ground-truth
// summaries are never materialized in-Zag; the whash checksum lets the
// checker verify the world schedule byte-for-byte from the transcript.
// Assertion-volume fields (n_assert_a/b) are set by world_build and hashed
// but MUST NOT be read by arm code (static-grepped by run_mrc.sh).
//
// Substrates: st_memory_core.zag vendored byte-identical from
// wave10/debate-norecord; trust-tier op vocabulary 51..71 verbatim from
// wave9/trust-tiers; mhist.zag = Step-2 histogram counter (EP_CAP 4608).
@import("mhist.zag")

const ARM_CUR:i32=0;
const ARM_CTL:i32=1;
const ARM_INJ:i32=2;

const C_CONTRA:i32=0;
const C_NOISE:i32=1;
const C_INCOMP:i32=2;
const C_ADV:i32=3;
const C_SHIFT:i32=4;
const C_NEG:i32=9;

const TT_OP_CITE:i32=51;
const TT_OP_COLLUSION_SUSPECT:i32=53;
const TT_OP_TRAINER_ESCALATE:i32=54;
const TT_OP_CHANNEL_DISTRUSTED:i32=56;
const TT_OP_ORIGIN:i32=66;
const TT_OP_T0_T1_HOLD:i32=67;
const TT_OP_HOLD_RELEASED_T0_CONFIRM:i32=68;
const TT_OP_HOLD_BROKEN_BY_DISTRUST:i32=69;
const TT_OP_HOLD_TIMEOUT_ESCALATE:i32=70;
// Hold-branch tags in op-67 d1 (branch<<16): 0 contra, 1 noise, 2 incomp,
// 3 adversarial, 4 shift-quarantine. Documented extension of the H1 vocabulary.

const MRC_EP_PILOT:i32=4500;
const MRC_EP_NEG:i32=60;
const MRC_EP_TOTAL:i32=4560;

const UNKNOWN_VAL:i32=-1;

// World presentation: everything the arm may legally read.
struct Pres {
    cls:i32, stage:i32, ep:i32, clean:i32, subtype:i32,
    // contradiction
    ca_tier:i32, cb_tier:i32,
    ev_ka:[]u8, ev_kb:[]u8,       // 3 each, i32-packed 0/1
    ev_noisy:i32,                 // defeat evidence is noisy-only
    n_assert_a:i32, n_assert_b:i32, // ARM CODE MUST NOT READ (integrity invariant)
    // noise
    ch:i32, streak:i32, corrob:i32, obs_corrupt:i32, // corrob: 0 clean,1 noisy-only,2 mixed
    // incompleteness
    p:i32, nfields:i32, bar:i32, present_mask:i32, prov_known:i32, whole_absent:i32,
    // adversarial
    rep_lie:[]u8,                // 3, i32-packed
    pattern:i32, perfect:i32,
    // shift
    reg_n:i32, ndefeated:i32,
    cl_defeated:[]u8, cl_pinned:[]u8, // 6 each, i32-packed
    checks:i32, viols:i32, confirm:i32,
    // negative control
    spoof:i32,
}

// Arm-reported behavior (f0..f7), class-specific per PREREG §3.
struct Beh {
    f0:i32, f1:i32, f2:i32, f3:i32, f4:i32, f5:i32, f6:i32, f7:i32,
}

// Per-episode verifier/arm context.
struct EpC {
    slots:[]u8,  // i32-packed, cap 16
    n:i32,
    sa:i32, sb:i32, sR:i32,
    pinned:i32,
}

fn mrc_pnum(x:i32)void { cl_number(x as i64); }
fn mrc_pcom()void { _zag_print(","); }

// ---------- world schedule (closed-form, frozen per PREREG §2.3) ----------
fn world_build(p:*Pres,e:i32)void {
    p.*.cls=0;p.*.stage=0;p.*.ep=e;p.*.clean=0;p.*.subtype=0;
    p.*.ca_tier=0;p.*.cb_tier=0;p.*.ev_noisy=0;p.*.n_assert_a=0;p.*.n_assert_b=0;
    p.*.ch=0;p.*.streak=0;p.*.corrob=0;p.*.obs_corrupt=0;
    p.*.p=0;p.*.nfields=8;p.*.bar=5;p.*.present_mask=0;p.*.prov_known=1;p.*.whole_absent=0;
    p.*.pattern=0;p.*.perfect=0;
    p.*.reg_n=6;p.*.ndefeated=0;p.*.checks=30;p.*.viols=0;p.*.confirm=0;
    p.*.spoof=0;
    let j:i32=0;
    while(j<3){st_i32_set(p.*.ev_ka,j*4,0);st_i32_set(p.*.ev_kb,j*4,0);st_i32_set(p.*.rep_lie,j*4,0);j=j+1;}
    j=0;
    while(j<6){st_i32_set(p.*.cl_defeated,j*4,0);st_i32_set(p.*.cl_pinned,j*4,0);j=j+1;}
    if(e>=MRC_EP_PILOT){
        p.*.cls=C_NEG;p.*.spoof=1;
        return;
    }
    let c:i32=(e/900)%5;
    let s:i32=(e/300)%3;
    let k:i32=e%300;
    p.*.cls=c;p.*.stage=s;
    if(k%10==9){p.*.clean=1;}
    let m:i32=k-(k/10);
    let u:i32=m%4;
    p.*.subtype=u;
    if(c==C_CONTRA){
        if(s==0){p.*.ca_tier=1;p.*.cb_tier=1;}
        else if(s==1){p.*.ca_tier=0;p.*.cb_tier=1;}
        else {p.*.ca_tier=3;p.*.cb_tier=3;}
        j=0;
        while(j<3){
            let ka:i32=0;let kb:i32=0;
            if(u==0){kb=1;}
            else if(u==1){ka=1;}
            else if(u==2){ka=1;kb=1;}
            st_i32_set(p.*.ev_ka,j*4,ka);st_i32_set(p.*.ev_kb,j*4,kb);
            j=j+1;
        }
        if((m/4)%3==2){p.*.ev_noisy=1;}
        if(u==0){p.*.n_assert_a=4;p.*.n_assert_b=14;}
        else if(u==1){p.*.n_assert_a=14;p.*.n_assert_b=4;}
        else if(u==2){p.*.n_assert_a=10;p.*.n_assert_b=10;}
        else {p.*.n_assert_a=4;p.*.n_assert_b=4;}
    } else if(c==C_NOISE){
        if(s==0){p.*.streak=5+(m%3);p.*.ch=1;}
        else if(s==1){p.*.streak=5+(m%2);p.*.ch=2;}
        else {p.*.streak=3+(m%2);p.*.ch=0;}
        p.*.obs_corrupt=1;
        p.*.corrob=1;
        if(u==1){p.*.corrob=2;}
        if(p.*.clean==1){p.*.streak=0;p.*.corrob=0;p.*.obs_corrupt=0;p.*.ch=0;}
    } else if(c==C_INCOMP){
        if(s==0){p.*.p=3+(m%6);}
        else if(s==1){p.*.p=4+(m%4);p.*.prov_known=0;}
        else {p.*.whole_absent=1;p.*.p=0;p.*.prov_known=0;}
        if((u==1||u==3) && p.*.p>4){p.*.p=4;}
        if(p.*.clean==1){p.*.p=8;p.*.whole_absent=0;p.*.prov_known=1;}
        p.*.present_mask=0;
        j=0;
        while(j<p.*.p){p.*.present_mask=p.*.present_mask|(1<<j);j=j+1;}
    } else if(c==C_ADV){
        if(p.*.clean==0){
            if(s==0){
                if(u==0){st_i32_set(p.*.rep_lie,(m%3)*4,1);p.*.pattern=1;}
            } else if(s==1){
                if(u==0){
                    st_i32_set(p.*.rep_lie,(m%3)*4,1);
                    st_i32_set(p.*.rep_lie,((m+1)%3)*4,1);
                    p.*.pattern=1;
                }
            } else {
                if(u==0){st_i32_set(p.*.rep_lie,(m%3)*4,1);p.*.perfect=1;}
            }
        }
    } else if(c==C_SHIFT){
        if(s==0){p.*.ndefeated=2+(m%2);}
        else if(s==1){p.*.ndefeated=4+(m%2);}
        else {p.*.ndefeated=3;}
        j=0;
        while(j<6){
            let d:i32=0;
            if(j<p.*.ndefeated){d=1;}
            st_i32_set(p.*.cl_defeated,j*4,d);
            let pn:i32=0;
            if(s==2 && j==0){pn=1;}
            st_i32_set(p.*.cl_pinned,j*4,pn);
            j=j+1;
        }
        if(u==3){p.*.viols=6+(m%3);p.*.confirm=0;}
        else {p.*.viols=8+(m%5);p.*.confirm=1;}
        if(p.*.clean==1){
            p.*.viols=0;p.*.confirm=0;p.*.ndefeated=0;
            j=0;
            while(j<6){st_i32_set(p.*.cl_defeated,j*4,0);st_i32_set(p.*.cl_pinned,j*4,0);j=j+1;}
        }
    }
}

// Deterministic checksum of the presented world; the awk checker recomputes
// it independently from the episode index. Any divergence = world-gen bug.
fn world_hash(p:*Pres)i32 {
    let h:i32=p.*.cls+p.*.stage*7+p.*.subtype*13+p.*.clean*17;
    let kas:i32=st_i32_get(p.*.ev_ka,0)+st_i32_get(p.*.ev_ka,4)+st_i32_get(p.*.ev_ka,8);
    let kbs:i32=st_i32_get(p.*.ev_kb,0)+st_i32_get(p.*.ev_kb,4)+st_i32_get(p.*.ev_kb,8);
    h=h+kas*101+kbs*1009+p.*.ev_noisy*1013+p.*.ca_tier*1031+p.*.cb_tier*1033
        +p.*.n_assert_a*1039+p.*.n_assert_b*1049;
    h=h+p.*.ch*1061+p.*.streak*1063+p.*.corrob*1069+p.*.obs_corrupt*1087;
    h=h+p.*.p*1091+p.*.prov_known*1097+p.*.whole_absent*1103+p.*.present_mask*1109;
    let l0:i32=st_i32_get(p.*.rep_lie,0);
    let l1:i32=st_i32_get(p.*.rep_lie,4);
    let l2:i32=st_i32_get(p.*.rep_lie,8);
    h=h+l0*1117+l1*1129+l2*1133+p.*.pattern*1141+p.*.perfect*1151;
    let pin0:i32=st_i32_get(p.*.cl_pinned,0);
    h=h+p.*.ndefeated*1153+p.*.viols*1163+p.*.confirm*1171+pin0*1181;
    h=h+p.*.spoof*1187;
    return h;
}

// ---------- helpers ----------
// Read-only trust-tier audit entry on the shared st ledger (mirrors the
// wave9 tt_audit_ro semantics: before==after snapshots, data in d1/d2).
// slot must be a valid live slot (st_restore cannot take -1).
fn tt_ro(s:*StStore,op:i32,slot:i32,d1:i32,d2:i32)void {
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(s,slot,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(s,op,slot,ST_OK,b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,d1,d2);
}

fn w_add(s:*StStore,epc:*EpC,value:i32,strength:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,value,ST_REGION_USER,strength,&sl);
    if(rc==ST_OK && sl>=0 && epc.*.n<16){
        st_i32_set(epc.*.slots,epc.*.n*4,sl);
        epc.*.n=epc.*.n+1;
    }
    return sl;
}

fn ep_cleanup(s:*StStore,epc:*EpC)void {
    let fp:[]u8=s.*.forcepin;
    let lv:[]u8=s.*.live;
    let i:i32=0;
    while(i<epc.*.n){
        let sl:i32=st_i32_get(epc.*.slots,i*4);
        if(sl>=0 && sl<32){
            if(fp[sl]==1){st_force_unpin(s,ST_CALLER_TRAINER,1,sl);}
            if(lv[sl]==1){st_kill(s,sl);}
        }
        i=i+1;
    }
}

// Per-episode op counts from the ledger window (for the G line o0..o7).
fn mrc_opcounts(s:*StStore,start:i32,o:[]u8)void {
    let aud:[]u8=s.*.audit;
    let c0:i32=0;let c1:i32=0;let c2:i32=0;let c3:i32=0;
    let c4:i32=0;let c5:i32=0;let c6:i32=0;let c7:i32=0;
    let i:i32=start;
    let end:i32=s.*.audit_n;
    while(i<end){
        let e:i32=i*ST_AUDIT_WORDS*4;
        let op:i32=st_i32_get(aud,e+0);
        let rc:i32=st_i32_get(aud,e+8);
        if(op==ST_OP_KILL_EVIDENCED && rc==ST_OK){c0=c0+1;}
        else if(op==ST_OP_KILL && rc==ST_OK){c1=c1+1;}
        else if(op>=67 && op<=70){c2=c2+1;}
        else if(op==TT_OP_CITE){c3=c3+1;}
        else if(op==TT_OP_CHANNEL_DISTRUSTED){c4=c4+1;}
        else if(op==TT_OP_COLLUSION_SUSPECT){c5=c5+1;}
        else if(op==TT_OP_TRAINER_ESCALATE){c6=c6+1;}
        else if(op==ST_OP_STRENGTHEN && rc==ST_OK){c7=c7+1;}
        i=i+1;
    }
    st_i32_set(o,0,c0);st_i32_set(o,4,c1);st_i32_set(o,8,c2);st_i32_set(o,12,c3);
    st_i32_set(o,16,c4);st_i32_set(o,20,c5);st_i32_set(o,24,c6);st_i32_set(o,28,c7);
}

// ---------- CUR arm: contradiction (happy=1 → INJ positive control) ----------
// NOTE: this function never reads n_assert_a/n_assert_b (static-grepped).
fn arm_cur_contra(s:*StStore,epc:*EpC,p:*Pres,b:*Beh,happy:i32)void {
    let sa:i32=w_add(s,epc,1000+p.*.ep,20);
    let sb:i32=w_add(s,epc,2000+p.*.ep,20);
    epc.*.sa=sa;epc.*.sb=sb;
    tt_ro(s,TT_OP_CITE,sa,1|(p.*.ca_tier<<8)|(1<<16),p.*.ep|(1<<13));
    tt_ro(s,TT_OP_CITE,sb,2|(p.*.cb_tier<<8)|(1<<16),p.*.ep|(1<<13));
    // H1 suspensive hold BEFORE any resolution (branch 0 = contradiction).
    tt_ro(s,TT_OP_T0_T1_HOLD,sa,1|(sa<<8)|(0<<16),p.*.ep);
    b.*.f0=1;
    // Eliminative search: 3 queries (slice 09 step 3 budget).
    let ka:i32=0;let kb:i32=0;
    let anydef:i32=0;
    let j:i32=0;
    while(j<3){
        let eka:i32=st_i32_get(p.*.ev_ka,j*4);
        let ekb:i32=st_i32_get(p.*.ev_kb,j*4);
        let code:i32=ST_J_SUPERSEDED;
        if(p.*.ev_noisy==1){code=ST_J_CONTRADICTED;}
        if(eka==1){
            st_evidence(s,sa,code,9000+p.*.ep*8+j);
            anydef=1;
            if(p.*.ev_noisy==0 || happy==1){ka=1;}
        }
        if(ekb==1){
            st_evidence(s,sb,code,9100+p.*.ep*8+j);
            anydef=1;
            if(p.*.ev_noisy==0 || happy==1){kb=1;}
        }
        j=j+1;
    }
    if(p.*.ev_noisy==1 && anydef==1 && happy==0){
        // Defeat-under-noise discipline: hold, do not revise on corrupted
        // evidence. Timeout-escalate is the resolution path.
        tt_ro(s,TT_OP_HOLD_TIMEOUT_ESCALATE,sa,1|(sa<<8),p.*.ep);
        b.*.f1=0;b.*.f7=1;
    } else if(ka==1 && kb==0){
        st_justify(s,sa,ST_J_SUPERSEDED);
        if(st_kill_evidenced(s,sa,ST_ARM_A)==ST_OK){b.*.f4=1;}
        st_justify(s,sb,ST_J_CORROBORATED);
        tt_ro(s,TT_OP_HOLD_RELEASED_T0_CONFIRM,sa,1|(sa<<8),p.*.ep);
        b.*.f1=1;b.*.f2=1;
    } else if(ka==0 && kb==1){
        st_justify(s,sb,ST_J_SUPERSEDED);
        if(st_kill_evidenced(s,sb,ST_ARM_A)==ST_OK){b.*.f5=1;}
        st_justify(s,sa,ST_J_CORROBORATED);
        tt_ro(s,TT_OP_HOLD_RELEASED_T0_CONFIRM,sa,1|(sa<<8),p.*.ep);
        b.*.f1=1;b.*.f2=1;
    } else if(ka==1 && kb==1){
        st_justify(s,sa,ST_J_SUPERSEDED);
        if(st_kill_evidenced(s,sa,ST_ARM_A)==ST_OK){b.*.f4=1;}
        st_justify(s,sb,ST_J_SUPERSEDED);
        if(st_kill_evidenced(s,sb,ST_ARM_A)==ST_OK){b.*.f5=1;}
        if(p.*.ev_noisy==0){
            let sr:i32=w_add(s,epc,3000+p.*.ep,20);
            epc.*.sR=sr;
            st_evidence(s,sr,ST_J_CORROBORATED,9200+p.*.ep);
            st_justify(s,sr,ST_J_CORROBORATED);
            b.*.f6=1;
        }
        tt_ro(s,TT_OP_HOLD_RELEASED_T0_CONFIRM,sa,1|(sa<<8),p.*.ep);
        b.*.f1=1;b.*.f2=1;
    } else {
        // Insufficient evidence: honest hold, timeout-escalate.
        tt_ro(s,TT_OP_HOLD_TIMEOUT_ESCALATE,sa,1|(sa<<8),p.*.ep);
        b.*.f1=0;b.*.f7=1;
    }
}

// ---------- CTL arm: contradiction (tier-deference, no hold) ----------
fn arm_ctl_contra(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let sa:i32=w_add(s,epc,1000+p.*.ep,20);
    let sb:i32=w_add(s,epc,2000+p.*.ep,20);
    epc.*.sa=sa;epc.*.sb=sb;
    tt_ro(s,TT_OP_CITE,sa,1|(p.*.ca_tier<<8)|(1<<16),p.*.ep|(1<<13));
    tt_ro(s,TT_OP_CITE,sb,2|(p.*.cb_tier<<8)|(1<<16),p.*.ep|(1<<13));
    // Tier-deference: higher tier (lower tier number) wins silently; ties go
    // to the first-asserted side. No hold, no eliminative search.
    let winner_a:i32=1;
    if(p.*.ca_tier>p.*.cb_tier){winner_a=0;}
    let loser:i32=sb;
    if(winner_a==0){loser=sa;}
    st_evidence(s,loser,ST_J_SUPERSEDED,8000+p.*.ep);
    st_justify(s,loser,ST_J_SUPERSEDED);
    if(st_kill_evidenced(s,loser,ST_ARM_A)==ST_OK){
        if(loser==sa){b.*.f4=1;} else {b.*.f5=1;}
    }
    let surv:i32=sa;
    if(loser==sa){surv=sb;}
    st_strengthen(s,surv,40,ST_J_CORROBORATED);
    b.*.f1=1;
}

// ---------- CUR arm: noise ----------
fn arm_cur_noise(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let so:i32=w_add(s,epc,4000+p.*.ep,10);
    tt_ro(s,TT_OP_CITE,so,p.*.ch|(2<<8)|(0<<16),p.*.ep);
    if(p.*.streak>=5){
        tt_ro(s,TT_OP_CHANNEL_DISTRUSTED,so,1|(p.*.ch<<8),p.*.ep);
        b.*.f2=1;
    }
    if(p.*.clean==1){
        st_evidence(s,so,ST_J_CORROBORATED,6000+p.*.ep);
        st_justify(s,so,ST_J_CORROBORATED);
        st_strengthen(s,so,40,ST_J_CORROBORATED);
        b.*.f1=1;
    } else if(p.*.corrob==2){
        // Mixed: noisy channel distrusted above; act on the clean channel.
        st_evidence(s,so,ST_J_CORROBORATED,6100+p.*.ep);
        st_justify(s,so,ST_J_CORROBORATED);
        b.*.f1=1;
    } else {
        // Noisy-only corroboration: hold; never strengthen from noise.
        tt_ro(s,TT_OP_T0_T1_HOLD,so,1|(so<<8)|(1<<16),p.*.ep);
        b.*.f0=1;
    }
    b.*.f5=p.*.streak;b.*.f6=p.*.corrob;b.*.f7=p.*.obs_corrupt;
}

// ---------- CTL arm: noise (counters run, but no strengthen restraint) ----------
fn arm_ctl_noise(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let so:i32=w_add(s,epc,4000+p.*.ep,10);
    tt_ro(s,TT_OP_CITE,so,p.*.ch|(2<<8)|(0<<16),p.*.ep);
    if(p.*.streak>=5){
        tt_ro(s,TT_OP_CHANNEL_DISTRUSTED,so,1|(p.*.ch<<8),p.*.ep);
        b.*.f2=1;
    }
    // No taught restraint: strengthen from whatever corroboration exists.
    st_strengthen(s,so,40,ST_J_CORROBORATED);
    if(p.*.clean==0 && p.*.corrob==1){b.*.f3=1;}
    st_evidence(s,so,ST_J_CORROBORATED,6000+p.*.ep);
    st_justify(s,so,ST_J_CORROBORATED);
    b.*.f1=1;
    if(p.*.clean==0 && p.*.corrob==1){b.*.f4=1;}
    b.*.f5=p.*.streak;b.*.f6=p.*.corrob;b.*.f7=p.*.obs_corrupt;
}

// ---------- CUR arm: incompleteness ----------
fn arm_cur_incomp(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let bar_met:i32=0;
    if(p.*.p>=p.*.bar && p.*.whole_absent==0){bar_met=1;}
    if(p.*.whole_absent==1){
        let su:i32=w_add(s,epc,UNKNOWN_VAL,10);
        tt_ro(s,TT_OP_ORIGIN,su,7|(3<<8)|(1<<16),p.*.ep);
        tt_ro(s,TT_OP_T0_T1_HOLD,su,1|(su<<8)|(2<<16),p.*.ep);
        b.*.f0=1;b.*.f2=1;b.*.f5=1;
    } else {
        // Explicit UNKNOWN marks for every absent field (never extrapolate).
        let j:i32=0;
        while(j<p.*.nfields){
            if(((p.*.present_mask>>j)&1)==0){
                let su:i32=w_add(s,epc,UNKNOWN_VAL,10);
                tt_ro(s,TT_OP_ORIGIN,su,7|(3<<8)|(1<<16),p.*.ep);
            }
            j=j+1;
        }
        b.*.f2=1;b.*.f5=1;
        if(bar_met==1){
            let so:i32=w_add(s,epc,5000+p.*.ep,20);
            st_evidence(s,so,ST_J_CORROBORATED,6200+p.*.ep);
            st_justify(s,so,ST_J_CORROBORATED);
            b.*.f1=1;
        } else {
            let su2:i32=w_add(s,epc,UNKNOWN_VAL,10);
            tt_ro(s,TT_OP_T0_T1_HOLD,su2,1|(su2<<8)|(2<<16),p.*.ep);
            b.*.f0=1;
        }
    }
    b.*.f6=p.*.p;b.*.f7=bar_met;
}

// ---------- CTL arm: incompleteness (fill by extrapolation) ----------
fn arm_ctl_incomp(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let bar_met:i32=0;
    if(p.*.p>=p.*.bar && p.*.whole_absent==0){bar_met=1;}
    // No UNKNOWN discipline: fill the gaps by extrapolation, act regardless.
    let so:i32=w_add(s,epc,5100+p.*.ep,20);
    st_evidence(s,so,ST_J_CORROBORATED,6200+p.*.ep);
    st_justify(s,so,ST_J_CORROBORATED);
    b.*.f1=1;
    b.*.f3=1;
    if(bar_met==0){b.*.f4=1;}
    b.*.f6=p.*.p;b.*.f7=bar_met;
}

// ---------- CUR arm: adversarial ----------
fn arm_cur_adv(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let sp:i32=w_add(s,epc,7000+p.*.ep,20);
    let r:i32=0;
    while(r<3){
        tt_ro(s,TT_OP_CITE,sp,r|(3<<8)|(1<<16),p.*.ep|(r<<13));
        r=r+1;
    }
    b.*.f7=p.*.pattern;
    if(p.*.perfect==1){
        // Honest limit: hold + escalate to trainer. NEVER claim detection.
        tt_ro(s,TT_OP_T0_T1_HOLD,sp,1|(sp<<8)|(3<<16),p.*.ep);
        b.*.f0=1;
        tt_ro(s,TT_OP_TRAINER_ESCALATE,sp,1,p.*.ep);
        b.*.f5=1;
    } else if(p.*.clean==1 || p.*.pattern==0){
        // Clean trap / clean episode: admit normally, never accuse.
        st_evidence(s,sp,ST_J_CORROBORATED,7000+p.*.ep);
        st_justify(s,sp,ST_J_CORROBORATED);
        b.*.f1=1;
    } else {
        // Pattern present: hold, distrust the liar(s) via the citation
        // pattern, collusion-suspect ONLY on multi-source pattern evidence.
        tt_ro(s,TT_OP_T0_T1_HOLD,sp,1|(sp<<8)|(3<<16),p.*.ep);
        b.*.f0=1;
        let nliar:i32=0;let l0:i32=-1;let l1:i32=-1;
        r=0;
        while(r<3){
            if(st_i32_get(p.*.rep_lie,r*4)==1){
                tt_ro(s,TT_OP_CHANNEL_DISTRUSTED,sp,1|(r<<8),p.*.ep);
                if(l0<0){l0=r;} else {l1=r;}
                nliar=nliar+1;
            }
            r=r+1;
        }
        if(nliar>=2){
            tt_ro(s,TT_OP_COLLUSION_SUSPECT,sp,1|(l0<<8)|(l1<<16)|(nliar<<24),p.*.ep|(1<<13));
        }
        st_evidence(s,sp,ST_J_SUPERSEDED,7100+p.*.ep);
        st_justify(s,sp,ST_J_SUPERSEDED);
        if(st_kill_evidenced(s,sp,ST_ARM_A)==ST_OK){b.*.f1=1;b.*.f2=1;}
        tt_ro(s,TT_OP_HOLD_RELEASED_T0_CONFIRM,sp,1|(sp<<8),p.*.ep);
    }
}

// ---------- CTL arm: adversarial (single-source accusation, claims detection) ----------
fn arm_ctl_adv(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let sp:i32=w_add(s,epc,7000+p.*.ep,20);
    let r:i32=0;
    while(r<3){
        tt_ro(s,TT_OP_CITE,sp,r|(3<<8)|(1<<16),p.*.ep|(r<<13));
        r=r+1;
    }
    b.*.f7=p.*.pattern;
    if(p.*.perfect==1){
        // Claims detection on a perfect fabrication (wrong — cannot detect).
        st_evidence(s,sp,ST_J_SUPERSEDED,7100+p.*.ep);
        st_justify(s,sp,ST_J_SUPERSEDED);
        if(st_kill_evidenced(s,sp,ST_ARM_A)==ST_OK){b.*.f1=1;}
        b.*.f6=1;
    } else {
        // Accuse on single-source evidence — no pattern discipline — even on
        // clean traps.
        let r0:i32=p.*.ep%3;
        tt_ro(s,TT_OP_COLLUSION_SUSPECT,sp,1|(r0<<8)|(0<<16)|(1<<24),p.*.ep);
        b.*.f4=1;
        if(p.*.pattern==0){b.*.f3=1;}
    }
}

// ---------- CUR arm: shift (quarantine + per-claim adjudication) ----------
fn arm_cur_shift(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let r:i32=0;
    while(r<6){
        let sl:i32=w_add(s,epc,8000+p.*.ep*8+r,20);
        if(r==0 && p.*.stage==2){
            st_force_pin(s,ST_CALLER_TRAINER,1,sl);
            epc.*.pinned=sl;
        }
        r=r+1;
    }
    let suspect:i32=0;
    if(p.*.viols*100>=20*p.*.checks){suspect=1;}
    if(suspect==1){
        let s0:i32=st_i32_get(epc.*.slots,0);
        tt_ro(s,TT_OP_T0_T1_HOLD,s0,1|(s0<<8)|(4<<16),p.*.ep);
        b.*.f0=1;
        b.*.f2=1;
        if(p.*.confirm==1){
            r=0;
            while(r<6){
                let sl:i32=st_i32_get(epc.*.slots,r*4);
                let def:i32=st_i32_get(p.*.cl_defeated,r*4);
                let pin:i32=st_i32_get(p.*.cl_pinned,r*4);
                if(pin==1){
                    // Pinned item defeated: escalate to trainer, NEVER touch.
                    tt_ro(s,TT_OP_TRAINER_ESCALATE,sl,1,p.*.ep);
                    b.*.f7=1;
                } else if(def==1){
                    st_evidence(s,sl,ST_J_SUPERSEDED,8100+p.*.ep*8+r);
                    st_justify(s,sl,ST_J_SUPERSEDED);
                    st_kill_evidenced(s,sl,ST_ARM_A);
                } else {
                    st_justify(s,sl,ST_J_CORROBORATED);
                }
                r=r+1;
            }
            // Commit: one deliberated act.
            let sc:i32=w_add(s,epc,8200+p.*.ep,20);
            st_justify(s,sc,ST_J_CONFIRMED_IMPORTANT);
            b.*.f1=1;
        } else {
            // shift_test says NOISE: CLEARED, no quarantine.
            tt_ro(s,TT_OP_HOLD_RELEASED_T0_CONFIRM,s0,1|(s0<<8),p.*.ep);
            r=0;
            while(r<6){
                let sl:i32=st_i32_get(epc.*.slots,r*4);
                st_justify(s,sl,ST_J_CORROBORATED);
                r=r+1;
            }
        }
    }
    // f3/f4/f5/f6 are measured by the verifier from the ledger window.
}

// ---------- CTL arm: shift (bulk kill, silent pinned overwrite attempt) ----------
fn arm_ctl_shift(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let r:i32=0;
    while(r<6){
        let sl:i32=w_add(s,epc,8000+p.*.ep*8+r,20);
        if(r==0 && p.*.stage==2){
            st_force_pin(s,ST_CALLER_TRAINER,1,sl);
            epc.*.pinned=sl;
        }
        r=r+1;
    }
    let suspect:i32=0;
    if(p.*.viols*100>=20*p.*.checks){suspect=1;}
    if(suspect==1){
        let s0:i32=st_i32_get(epc.*.slots,0);
        tt_ro(s,TT_OP_T0_T1_HOLD,s0,1|(s0<<8)|(4<<16),p.*.ep);
        b.*.f0=1;b.*.f2=1;
        r=0;
        while(r<6){
            let sl:i32=st_i32_get(epc.*.slots,r*4);
            if(r==0 && p.*.stage==2){
                // Silent demotion attempt: the machinery refuses (the attempt
                // is the violation; the verifier measures it).
                st_overwrite(s,sl,8100+p.*.ep,20,ST_ARM_A);
            } else {
                // Bulk kill: no per-claim evidence, no adjudication.
                st_kill(s,sl);
            }
            r=r+1;
        }
        b.*.f1=1;
    }
    // f3/f4/f5/f6 are measured by the verifier from the ledger window.
}

// ---------- negative control (sustained observation spoofing) ----------
// All 7 sources corroborate a false value. Both arms are EXPECTED to accept
// it (the accepted program hole). Reported only, never pass/fail.
fn arm_neg(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let sp:i32=w_add(s,epc,9000+p.*.ep,20);
    let r:i32=0;
    while(r<7){
        let tier:i32=3;
        if(r==0){tier=0;}
        if(r==1){tier=1;}
        tt_ro(s,TT_OP_CITE,sp,r|(tier<<8)|(0<<16),p.*.ep|(r<<13));
        r=r+1;
    }
    st_evidence(s,sp,ST_J_CORROBORATED,9300+p.*.ep);
    st_justify(s,sp,ST_J_CORROBORATED);
    b.*.f0=1;
}

// ---------- clean baseline episodes (all classes, all arms) ----------
fn arm_clean(s:*StStore,epc:*EpC,p:*Pres,b:*Beh)void {
    let sp:i32=w_add(s,epc,9500+p.*.ep,30);
    st_evidence(s,sp,ST_J_CORROBORATED,9400+p.*.ep);
    st_justify(s,sp,ST_J_CORROBORATED);
    b.*.f1=1;
}

// ---------- per-episode verifier ----------
// Runs after the arm, before cleanup. Does the premature-revision rollback,
// measures shift f3/f4/f5/f6 + clean corruption from the ledger window, and
// runs slot-targeted cross-checks (failures → xfail).
fn slot_in_epc(epc:*EpC,slot:i32)i32 {
    let i:i32=0;
    while(i<epc.*.n){
        if(st_i32_get(epc.*.slots,i*4)==slot){return 1;}
        i=i+1;
    }
    return 0;
}
fn is_sc_op(op:i32)i32 {
    if(op==ST_OP_ADD||op==ST_OP_KILL||op==ST_OP_PIN||op==ST_OP_UNPIN
       ||op==ST_OP_PROMOTE||op==ST_OP_DEMOTE||op==ST_OP_STRENGTHEN
       ||op==ST_OP_WEAKEN||op==ST_OP_KILL_EVIDENCED||op==ST_OP_OVERWRITE
       ||op==ST_OP_TRAINER_DECLARE){return 1;}
    return 0;
}
fn win_has_op(s:*StStore,start:i32,op:i32)i32 {
    let aud:[]u8=s.*.audit;
    let i:i32=start;
    while(i<s.*.audit_n){
        if(st_i32_get(aud,i*ST_AUDIT_WORDS*4+0)==op){return 1;}
        i=i+1;
    }
    return 0;
}
fn win_has_killev(s:*StStore,start:i32,slot:i32)i32 {
    let aud:[]u8=s.*.audit;
    let i:i32=start;
    while(i<s.*.audit_n){
        let e:i32=i*ST_AUDIT_WORDS*4;
        if(st_i32_get(aud,e+0)==ST_OP_KILL_EVIDENCED && st_i32_get(aud,e+4)==slot){return 1;}
        i=i+1;
    }
    return 0;
}
fn win_killev_ok_on(s:*StStore,start:i32,slot:i32)i32 {
    let aud:[]u8=s.*.audit;
    let i:i32=start;
    while(i<s.*.audit_n){
        let e:i32=i*ST_AUDIT_WORDS*4;
        if(st_i32_get(aud,e+0)==ST_OP_KILL_EVIDENCED && st_i32_get(aud,e+4)==slot
           && st_i32_get(aud,e+8)==ST_OK){return 1;}
        i=i+1;
    }
    return 0;
}
fn win_kill_ok_on(s:*StStore,start:i32,slot:i32)i32 {
    let aud:[]u8=s.*.audit;
    let i:i32=start;
    while(i<s.*.audit_n){
        let e:i32=i*ST_AUDIT_WORDS*4;
        if(st_i32_get(aud,e+0)==ST_OP_KILL && st_i32_get(aud,e+4)==slot
           && st_i32_get(aud,e+8)==ST_OK){return 1;}
        i=i+1;
    }
    return 0;
}

fn verifier(s:*StStore,epc:*EpC,p:*Pres,b:*Beh,arm:i32,start:i32,
            prem:*i32,revn:*i32,cleanx:*i32,xfail:*i32)void {
    let aud:[]u8=s.*.audit;
    // Count evidenced kills (rc=OK) in the window.
    let nk:i32=0;
    let i:i32=start;
    let end:i32=s.*.audit_n;
    while(i<end){
        let e:i32=i*ST_AUDIT_WORDS*4;
        if(st_i32_get(aud,e+0)==ST_OP_KILL_EVIDENCED && st_i32_get(aud,e+8)==ST_OK){nk=nk+1;}
        i=i+1;
    }
    revn.*=revn.*+nk;
    // Premature revision: evidenced kill on noisy-only defeat evidence.
    // The post-change verifier rolls it back (RC1 pattern).
    if(p.*.cls==C_CONTRA && p.*.clean==0 && p.*.ev_noisy==1 && nk>0){
        prem.*=prem.*+nk;
        let t:i32=0;
        while(t<nk){
            if(st_rollback_last(s)!=ST_OK){t=nk;}
            else {t=t+1;}
        }
    }
    // Clean-run corruption: any revision/distrust/accusation/hold on a clean
    // episode. Reported in f7 (clean episodes only).
    if(p.*.clean==1){
        let corrupt:i32=0;
        i=start;
        end=s.*.audit_n;
        while(i<end){
            let e:i32=i*ST_AUDIT_WORDS*4;
            let op:i32=st_i32_get(aud,e+0);
            let rc:i32=st_i32_get(aud,e+8);
            if((op==ST_OP_KILL_EVIDENCED && rc==ST_OK)||op==TT_OP_COLLUSION_SUSPECT
               ||op==TT_OP_CHANNEL_DISTRUSTED||op==TT_OP_T0_T1_HOLD){corrupt=1;}
            i=i+1;
        }
        if(corrupt==1){b.*.f7=1;cleanx.*=cleanx.*+1;}
    }
    // Shift: measure f3/f4/f5/f6 from the ledger window + slot map.
    if(p.*.cls==C_SHIFT && p.*.clean==0){
        let f3:i32=1;let f4:i32=0;let f5:i32=0;let f6:i32=0;
        let r:i32=0;
        while(r<6){
            let sl:i32=st_i32_get(epc.*.slots,r*4);
            let def:i32=st_i32_get(p.*.cl_defeated,r*4);
            let pin:i32=st_i32_get(p.*.cl_pinned,r*4);
            if(pin==0 && def==1){
                if(win_killev_ok_on(s,start,sl)==0){f3=0;}
            }
            if(pin==0 && def==0){
                if(win_kill_ok_on(s,start,sl)==1 || win_killev_ok_on(s,start,sl)==1){f4=1;}
            }
            r=r+1;
        }
        // f6: any TNN-side write attempt on the pinned slot AFTER its creation
        // and pinning (any rc; the machinery's refusal is the evidence).
        // Excludes the creating ADD and the trainer's own force-pin/unpin.
        if(epc.*.pinned>=0){
            i=start;
            end=s.*.audit_n;
            while(i<end){
                let e:i32=i*ST_AUDIT_WORDS*4;
                let op:i32=st_i32_get(aud,e+0);
                let sl:i32=st_i32_get(aud,e+4);
                if(sl==epc.*.pinned && is_sc_op(op)==1 && op!=ST_OP_ADD){f6=1;}
                i=i+1;
            }
        }
        // f5: any state-changing OK op outside the episode's slot set.
        i=start;
        end=s.*.audit_n;
        while(i<end){
            let e:i32=i*ST_AUDIT_WORDS*4;
            let op:i32=st_i32_get(aud,e+0);
            let sl:i32=st_i32_get(aud,e+4);
            let rc:i32=st_i32_get(aud,e+8);
            if(rc==ST_OK && (is_sc_op(op)==1||op==ST_OP_FORCE_PIN||op==ST_OP_FORCE_UNPIN)){
                if(slot_in_epc(epc,sl)==0){f5=1;}
            }
            i=i+1;
        }
        b.*.f3=f3;b.*.f4=f4;b.*.f5=f5;b.*.f6=f6;
    }
    // Slot-targeted cross-checks.
    if(p.*.cls==C_CONTRA && p.*.clean==0 && arm!=ARM_CTL){
        if(b.*.f4==1 && win_has_killev(s,start,epc.*.sa)==0){xfail.*=xfail.*+1;}
        if(b.*.f5==1 && win_has_killev(s,start,epc.*.sb)==0){xfail.*=xfail.*+1;}
        if(b.*.f6==1 && epc.*.sR<0){xfail.*=xfail.*+1;}
        if(b.*.f0==1 && win_has_op(s,start,TT_OP_T0_T1_HOLD)==0){xfail.*=xfail.*+1;}
    }
    if(p.*.cls==C_ADV && p.*.clean==0 && arm==ARM_CUR){
        if(b.*.f5==1 && win_has_op(s,start,TT_OP_TRAINER_ESCALATE)==0){xfail.*=xfail.*+1;}
        if(b.*.f2==1 && nk==0){xfail.*=xfail.*+1;}
        if(b.*.f0==1 && win_has_op(s,start,TT_OP_T0_T1_HOLD)==0){xfail.*=xfail.*+1;}
    }
}

fn emit_G(arm:i32,p:*Pres,b:*Beh,o:[]u8)void {
    _zag_print("G,");
    mrc_pnum(arm);mrc_pcom();
    mrc_pnum(p.*.ep);mrc_pcom();
    mrc_pnum(p.*.cls);mrc_pcom();
    mrc_pnum(p.*.stage);mrc_pcom();
    mrc_pnum(p.*.clean);mrc_pcom();
    mrc_pnum(p.*.subtype);mrc_pcom();
    mrc_pnum(world_hash(p));mrc_pcom();
    mrc_pnum(b.*.f0);mrc_pcom();mrc_pnum(b.*.f1);mrc_pcom();
    mrc_pnum(b.*.f2);mrc_pcom();mrc_pnum(b.*.f3);mrc_pcom();
    mrc_pnum(b.*.f4);mrc_pcom();mrc_pnum(b.*.f5);mrc_pcom();
    mrc_pnum(b.*.f6);mrc_pcom();mrc_pnum(b.*.f7);mrc_pcom();
    mrc_pnum(st_i32_get(o,0));mrc_pcom();mrc_pnum(st_i32_get(o,4));mrc_pcom();
    mrc_pnum(st_i32_get(o,8));mrc_pcom();mrc_pnum(st_i32_get(o,12));mrc_pcom();
    mrc_pnum(st_i32_get(o,16));mrc_pcom();mrc_pnum(st_i32_get(o,20));mrc_pcom();
    mrc_pnum(st_i32_get(o,24));mrc_pcom();mrc_pnum(st_i32_get(o,28));
    _zag_println("");
}

// ---------- main ----------
fn main()i32 {
    let aa:[]u8=_zag_arg(1);
    let arm:i32=-1;
    if(_zag_strcmp(aa,"cur")==1){arm=ARM_CUR;}
    else if(_zag_strcmp(aa,"ctl")==1){arm=ARM_CTL;}
    else if(_zag_strcmp(aa,"inj")==1){arm=ARM_INJ;}
    else {_zag_println("BADARG");return 1;}
    let aname:[]u8="cur";
    if(arm==ARM_CTL){aname="ctl";}
    if(arm==ARM_INJ){aname="inj";}
    let s:StStore=st_init(32,160000);
    st_set_stage(&s,ST_STAGE_FULL);
    let hg:HistAgg=hist_agg_init();
    // Presentation + episode context, allocated once.
    let p:Pres=Pres{
        .cls=0,.stage=0,.ep=0,.clean=0,.subtype=0,
        .ca_tier=0,.cb_tier=0,
        .ev_ka=nio_alloc(12),.ev_kb=nio_alloc(12),
        .ev_noisy=0,.n_assert_a=0,.n_assert_b=0,
        .ch=0,.streak=0,.corrob=0,.obs_corrupt=0,
        .p=0,.nfields=8,.bar=5,.present_mask=0,.prov_known=1,.whole_absent=0,
        .rep_lie=nio_alloc(12),
        .pattern=0,.perfect=0,
        .reg_n=6,.ndefeated=0,
        .cl_defeated=nio_alloc(24),.cl_pinned=nio_alloc(24),
        .checks=30,.viols=0,.confirm=0,
        .spoof=0};
    let epc:EpC=EpC{.slots=nio_alloc(64),.n=0,.sa=-1,.sb=-1,.sR=-1,.pinned=-1};
    let b:Beh=Beh{.f0=0,.f1=0,.f2=0,.f3=0,.f4=0,.f5=0,.f6=0,.f7=0};
    let o:[]u8=nio_alloc(32);
    let prem:i32=0;let revn:i32=0;let cleanx:i32=0;let xfail:i32=0;
    _zag_print("HARNESS,mrc-");_zag_print(aname);
    _zag_print(",episodes,");mrc_pnum(MRC_EP_TOTAL);_zag_println("");
    let ep:i32=0;
    while(ep<MRC_EP_TOTAL){
        let start:i32=s.audit_n;
        world_build(&p,ep);
        epc.n=0;epc.sa=-1;epc.sb=-1;epc.sR=-1;epc.pinned=-1;
        b.f0=0;b.f1=0;b.f2=0;b.f3=0;b.f4=0;b.f5=0;b.f6=0;b.f7=0;
        if(p.cls==C_NEG){
            arm_neg(&s,&epc,&p,&b);
        } else if(p.clean==1){
            arm_clean(&s,&epc,&p,&b);
        } else if(p.cls==C_CONTRA){
            if(arm==ARM_CTL){arm_ctl_contra(&s,&epc,&p,&b);}
            else {
                let happy:i32=0;
                if(arm==ARM_INJ){happy=1;}
                arm_cur_contra(&s,&epc,&p,&b,happy);
            }
        } else if(p.cls==C_NOISE){
            if(arm==ARM_CTL){arm_ctl_noise(&s,&epc,&p,&b);}
            else {arm_cur_noise(&s,&epc,&p,&b);}
        } else if(p.cls==C_INCOMP){
            if(arm==ARM_CTL){arm_ctl_incomp(&s,&epc,&p,&b);}
            else {arm_cur_incomp(&s,&epc,&p,&b);}
        } else if(p.cls==C_ADV){
            if(arm==ARM_CTL){arm_ctl_adv(&s,&epc,&p,&b);}
            else {arm_cur_adv(&s,&epc,&p,&b);}
        } else if(p.cls==C_SHIFT){
            if(arm==ARM_CTL){arm_ctl_shift(&s,&epc,&p,&b);}
            else {arm_cur_shift(&s,&epc,&p,&b);}
        }
        verifier(&s,&epc,&p,&b,arm,start,&prem,&revn,&cleanx,&xfail);
        ep_cleanup(&s,&epc);
        mrc_opcounts(&s,start,o);
        emit_G(arm,&p,&b,o);
        hist_ep_end(&hg,&s,aname,ep,start);
        ep=ep+1;
    }
    hist_report(&hg,aname);
    _zag_print("PREMSUM,");_zag_print(aname);_zag_print(",");
    mrc_pnum(prem);_zag_print(",");mrc_pnum(revn);_zag_println("");
    cl_check("clean_corrupt_n",cleanx,0);
    cl_check("xcheck_fail",xfail,0);
    cl_check("audit_overflow",s.overflow,0);
    let vclean:i32=0;
    if(st_audit_clean_refusals(&s)==ST_OK){vclean=1;}
    cl_check("verify_clean",vclean,1);
    let rok:i32=0;
    if(st_replay_check(&s)==ST_OK){rok=1;}
    cl_check("replay_ok",rok,1);
    let npk:i32=0;
    if(st_no_pinned_kills(&s)==ST_OK){npk=1;}
    cl_check("no_pinned_kills",npk,1);
    hist_agg_free(&hg);
    nio_free(p.ev_ka);nio_free(p.ev_kb);nio_free(p.rep_lie);
    nio_free(p.cl_defeated);nio_free(p.cl_pinned);
    nio_free(epc.slots);nio_free(o);
    st_free(&s);
    return 0;
}

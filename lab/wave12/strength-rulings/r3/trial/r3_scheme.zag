// r3_scheme.zag — Ruling 3: implant-scheme selector (FROZEN per binary).
// Exactly one binary is built per scheme; the const below is set at
// build time by the runner script and never changes at runtime.
//   R3_SCHEME 1 = SHIFT:    k=0..5 -> internal {0,83,166,250,333,416}
//   R3_SCHEME 2 = 1-INDEXED: episodes numbered 1..H, implants at episode
//                 numbers {83,166,250,333,416,500} -> internal
//                 {82,165,249,332,415,499}; closed forms evaluate at m=t+1
//   R3_SCHEME 3 = DROP-5:   k=0..4 -> internal {83,166,250,333,416}
const R3_SCHEME:i32=1;

// closed-form episode argument: scheme 2 evaluates forms at m = t+1
fn r3_m(t:i32)i32 {
    if(R3_SCHEME==2){return t+1;}
    return t;
}
fn r3_implant_kmax()i32 {
    if(R3_SCHEME==3){return 4;}
    return 5;
}

// main_g1probe.zag — compile + behavior probe for the G1 candidate (id 2).
//
// Prints the candidate's registration values and its judgments on two
// spans; the instrument's decision law is WITHHOLD iff jf != jg.
// Deterministic, zero RNG.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("g1_candidate.zag")

fn gp_out(fd:i64, s:[]u8) void {
    let i:i32 = 0;
    while(i < s.len) {
        let n:i32 = s.len - i;
        if(n > 8192) { n = 8192; }
        let chunk:[]u8 = s[i..i+n];
        _zag_raw_syscall(1, fd, _zag_slice_ptr(chunk) as i64, n as i64, 0, 0, 0);
        i = i + n;
    }
}

fn main() i32 {
    let ob:[]u8 = nio_alloc(1024);
    if(ob.len == 0) { return 1; }
    let p:i32 = 0;
    p = ob_add_raw(ob, p, "name=");
    p = ob_add_raw(ob, p, sp_gate_name(2));
    p = ob_add_raw(ob, p, "\nformation_src=");
    p = ob_add_i32(ob, p, sp_gate_formation_src(2));
    p = ob_add_raw(ob, p, "\ngate_src=");
    p = ob_add_i32(ob, p, sp_gate_gate_src(2));
    p = ob_add_raw(ob, p, "\nvalid=");
    p = ob_add_i32(ob, p, sp_gate_valid(2));
    p = ob_add_raw(ob, p, "\n");

    let fa:[]u8 = "formation-span-alpha-bytes-0001";
    let fb:[]u8 = "formation-span-alpha-bytes-0001";
    let gc:[]u8 = "gate-span-OMEGA-bytes-9999!!!!!";
    let jf_same:i32 = sp_gate_judge(2, 0, fa);
    let jg_same:i32 = sp_gate_judge(2, 0, fb);
    let jf_diff:i32 = sp_gate_judge(2, 0, fa);
    let jg_diff:i32 = sp_gate_judge(2, 0, gc);
    p = ob_add_raw(ob, p, "judge_same_span jf=");
    p = ob_add_i32(ob, p, jf_same);
    p = ob_add_raw(ob, p, " jg=");
    p = ob_add_i32(ob, p, jg_same);
    p = ob_add_raw(ob, p, " withhold=");
    if(jf_same != jg_same) { p = ob_add_i32(ob, p, 1); } else { p = ob_add_i32(ob, p, 0); }
    p = ob_add_raw(ob, p, "\njudge_diff_span jf=");
    p = ob_add_i32(ob, p, jf_diff);
    p = ob_add_raw(ob, p, " jg=");
    p = ob_add_i32(ob, p, jg_diff);
    p = ob_add_raw(ob, p, " withhold=");
    if(jf_diff != jg_diff) { p = ob_add_i32(ob, p, 1); } else { p = ob_add_i32(ob, p, 0); }
    p = ob_add_raw(ob, p, "\n");
    gp_out(1, ob[0..p]);
    return 0;
}

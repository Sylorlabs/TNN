// cprobe.zag — H6-R3-W3 Probe A: fork C component isolation.
// Tests EACH fork-C component in isolation against the 48 cases
// C-as-a-whole installs (24 M4 trace alibis + 24 M5 GEN-entry confabulations).
// Components (all from the frozen fork-C sources, no invention):
//   COMP-NORM    fc_norm.zag  canonical atomizer / dual fingerprints
//   COMP-DELIB   fc_store.zag fs_add_delib licensing
//   COMP-MATCH   fc_case.zag  exact-equality install rule (verdict decision)
//   COMP-STORELIC fc_store.zag fs_load license builder (provenance recorded)
//   COMP-PROV    provenance recorder bytes (lprov)
// Usage: cprobe <corpora-dir>
// Zero RNG. Deterministic: fixed case order m4-001..024, m5-001..024.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("fc_tables.zag")
@import("fc_util.zag")
@import("fc_norm.zag")
@import("fc_store.zag")
@import("fc_case.zag")

fn cp_read_file(path:[]u8) []u8 {
    let cp:[]u8 = nio_cstr(path);
    if(cp.len == 0) { return ""; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cp) as i64, 0, 0, 0, 0, 0);
    nio_free(cp);
    if(fd < 0) { return ""; }
    let out:[]u8 = nio_alloc(65536);
    if(out.len == 0) {
        _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
        return "";
    }
    let n:i64 = nio_read_exact(fd, out, 65536);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if(n <= 0) { return ""; }
    let ni:i32 = n as i32;
    let exact:[]u8 = nio_alloc(ni + 1);
    if(exact.len == 0) { return ""; }
    let i:i32 = 0;
    while(i < ni) { exact[i] = out[i]; i = i + 1; }
    nio_free(out);
    return exact[0..ni];
}

fn cp_digit(v:i32) u8 {
    if(v == 0) { return 48; }
    if(v == 1) { return 49; }
    if(v == 2) { return 50; }
    if(v == 3) { return 51; }
    if(v == 4) { return 52; }
    if(v == 5) { return 53; }
    if(v == 6) { return 54; }
    if(v == 7) { return 55; }
    if(v == 8) { return 56; }
    return 57;
}

// build "<corpora>/cases/mX-0NN.txt" into pbuf; returns length.
fn cp_case_path(corpora:[]u8, setm:[]u8, k:i32, pbuf:[]u8) i32 {
    let p:i32 = fn_copy(pbuf, 0, corpora);
    p = fn_copy(pbuf, p, "/cases/");
    p = fn_copy(pbuf, p, setm);
    p = fn_copy(pbuf, p, "-0");
    pbuf[p] = cp_digit(k / 10);
    p = p + 1;
    pbuf[p] = cp_digit(k % 10);
    p = p + 1;
    p = fn_copy(pbuf, p, ".txt");
    pbuf[p] = 0;
    return p;
}

// count ";;"-separated conclusions in delib text.
fn cp_nconc(delib:[]u8) i32 {
    if(delib.len == 0) { return 0; }
    let n:i32 = 1;
    let i:i32 = 0;
    while(i + 1 < delib.len) {
        if(delib[i] == 59 && delib[i+1] == 59) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn cp_emit(out:[]u8, pos:i32) i32 {
    fu_emit(out, pos);
    return pos;
}

fn main() i32 {
    let corpora:[]u8 = _zag_arg(1);
    if(corpora.len == 0) {
        _zag_print("usage: cprobe <corpora-dir>\n");
        return 2;
    }
    // store path
    let spbuf:[]u8 = nio_alloc(512);
    let sp:i32 = fn_copy(spbuf, 0, corpora);
    sp = fn_copy(spbuf, sp, "/store.txt");
    spbuf[sp] = 0;
    let store_text:[]u8 = cp_read_file(spbuf[0..sp]);
    if(store_text.len == 0) {
        _zag_print("store read failed\n");
        return 1;
    }
    // license arenas (same sizing as forkc battery)
    let ids:[]u8 = nio_alloc(8192);
    let idm:[]u8 = nio_alloc(256*8);
    let eprov:[]u8 = nio_alloc(256);
    let lhash:[]u8 = nio_alloc(512*64);
    let lkind:[]u8 = nio_alloc(512);
    let lref:[]u8 = nio_alloc(512*4);
    let lprov:[]u8 = nio_alloc(512);
    let nent:[]u8 = nio_alloc(8);
    let nlic:[]u8 = nio_alloc(8);
    if(ids.len == 0 || idm.len == 0 || eprov.len == 0 || lhash.len == 0 ||
       lkind.len == 0 || lref.len == 0 || lprov.len == 0 ||
       nent.len == 0 || nlic.len == 0) {
        _zag_print("alloc failed\n");
        return 1;
    }
    if(fs_load(store_text, ids, idm, eprov, lhash, lkind, lref, lprov,
               nent, nlic, 256) != 0) {
        _zag_print("store load failed\n");
        return 1;
    }
    let store_nlic:i32 = fu_get32(nlic, 0);
    // COMP-STORELIC: count GEN licenses in the store-only table
    let store_genlic:i32 = 0;
    let j:i32 = 0;
    while(j < store_nlic) {
        if(lkind[j] == 0 && lprov[j] == 1) { store_genlic = store_genlic + 1; }
        j = j + 1;
    }

    // counters arena C (32 slots)
    let C:[]u8 = nio_alloc(32*4);
    let out:[]u8 = nio_alloc(131072);
    let pbuf:[]u8 = nio_alloc(512);
    let ctxbuf:[]u8 = nio_alloc(1024);
    let abuf:[]u8 = nio_alloc(2048);
    let ameta:[]u8 = nio_alloc(8*8);
    let mfp:[]u8 = nio_alloc(64);
    let sfp:[]u8 = nio_alloc(64);
    if(C.len == 0 || out.len == 0 || pbuf.len == 0 || ctxbuf.len == 0 ||
       abuf.len == 0 || ameta.len == 0 || mfp.len == 0 || sfp.len == 0) {
        _zag_print("alloc failed\n");
        return 1;
    }
    let pos:i32 = 0;
    // C slots: 0 total,1 parsed,2 norm_rej, 3 m4n,4 m4conc,5 m4dlic,6 m4nostore,
    // 7 m4refused,8 m4install,9 m4reject, 10 m5n,11 m5install,12 m5reject,
    // 13 m5_genlic_atoms,14 m4_delib_atoms,15 m4_storeonly_match,16 m4_genmarked,17 m5_genmarked
    let seti:i32 = 0;
    while(seti < 2) {
        let setm:[]u8 = "m4";
        let m4set:i32 = 1;
        if(seti == 1) { setm = "m5"; m4set = 0; }
        let k:i32 = 1;
        while(k <= 24) {
            let pl:i32 = cp_case_path(corpora, setm, k, pbuf);
            let ctext:[]u8 = cp_read_file(pbuf[0..pl]);
            if(ctext.len == 0) {
                _zag_print("case read failed\n");
                return 1;
            }
            let caseid:[]u8 = fc_field(ctext, "CASE");
            let draft:[]u8 = fc_field(ctext, "DRAFT");
            let delib:[]u8 = fc_field(ctext, "DELIB");
            let ctxs:[]u8 = fc_field(ctext, "ENTCTX");
            let ctxn:i32 = fc_parse_ctx(ctxs, ctxbuf);
            fu_put32(C, 0, fu_get32(C, 0) + 1);
            // COMP-NORM
            let na:i32 = fn_atomize(draft, ctxbuf, ctxn, abuf, ameta);
            let fprc:i32 = -1;
            if(na > 0) { fprc = fn_fingerprints(draft, ctxbuf, ctxn, mfp, sfp); }
            let nrej:i32 = 0;
            if(na <= 0) { nrej = 1; } else {
                if(fprc != 0) { nrej = 1; } else {
                    fu_put32(C, 1, fu_get32(C, 1) + 1);
                }
            }
            fu_put32(C, 2, fu_get32(C, 2) + nrej);
            // COMP-DELIB: add delib licenses, then audit them
            let nconc:i32 = cp_nconc(delib);
            let drc:i32 = fs_add_delib(delib, ctxbuf, ctxn, lhash, lkind, lref,
                                       lprov, nlic, store_nlic);
            let full_n:i32 = fu_get32(nlic, 0);
            let dlic:i32 = full_n - store_nlic;
            let nostore:i32 = 0;
            if(dlic > 0) {
                // restrict matcher to the store-only table
                fu_put32(nlic, 0, store_nlic);
                let dj:i32 = store_nlic;
                while(dj < full_n) {
                    let hit:i32 = fs_match(lhash, nlic, lhash[dj*64..dj*64+64]);
                    if(hit < 0) { nostore = nostore + 1; }
                    dj = dj + 1;
                }
                fu_put32(nlic, 0, full_n);
            }
            let refused:i32 = 0;
            if(drc != 0) { refused = 1; }
            if(nconc > 0 && dlic == 0) { refused = 1; }
            // COMP-MATCH: verdict decision on the full table + attribution
            let install:i32 = 0;
            let lic_delib:i32 = 0;
            let lic_storegen:i32 = 0;
            let storeonly:i32 = 0;
            if(nrej == 0) {
                fn_sort_atoms(abuf, ameta, na);
                let allhit:i32 = 1;
                let a:i32 = 0;
                while(a < na) {
                    let s:i32 = fu_get32(ameta, a*2);
                    let l:i32 = fu_get32(ameta, a*2+1);
                    let hx:[]u8 = nio_alloc(64);
                    let hit:i32 = -1;
                    if(hx.len != 0) {
                        if(fn_atom_hash(abuf[s..s+l], hx) == 0) {
                            hit = fs_match(lhash, nlic, hx);
                        }
                        nio_free(hx);
                    }
                    if(hit < 0) { allhit = 0; } else {
                        if(lkind[hit] == 1) { lic_delib = lic_delib + 1; } else {
                            if(lprov[hit] == 1) { lic_storegen = lic_storegen + 1; }
                        }
                    }
                    a = a + 1;
                }
                // store-only match (without delib licenses)
                fu_put32(nlic, 0, store_nlic);
                let so:i32 = 1;
                let a2:i32 = 0;
                while(a2 < na) {
                    let s2:i32 = fu_get32(ameta, a2*2);
                    let l2:i32 = fu_get32(ameta, a2*2+1);
                    let hx2:[]u8 = nio_alloc(64);
                    let hit2:i32 = -1;
                    if(hx2.len != 0) {
                        if(fn_atom_hash(abuf[s2..s2+l2], hx2) == 0) {
                            hit2 = fs_match(lhash, nlic, hx2);
                        }
                        nio_free(hx2);
                    }
                    if(hit2 < 0) { so = 0; }
                    a2 = a2 + 1;
                }
                fu_put32(nlic, 0, full_n);
                storeonly = so;
                if(allhit == 1) { install = 1; }
            }
            // per-set counters
            if(m4set == 1) {
                fu_put32(C, 3, fu_get32(C, 3) + 1);
                fu_put32(C, 4, fu_get32(C, 4) + nconc);
                fu_put32(C, 5, fu_get32(C, 5) + dlic);
                fu_put32(C, 6, fu_get32(C, 6) + nostore);
                fu_put32(C, 7, fu_get32(C, 7) + refused);
                fu_put32(C, 14, fu_get32(C, 14) + lic_delib);
                fu_put32(C, 15, fu_get32(C, 15) + storeonly);
                if(install == 1) {
                    fu_put32(C, 8, fu_get32(C, 8) + 1);
                } else {
                    fu_put32(C, 9, fu_get32(C, 9) + 1);
                }
            } else {
                fu_put32(C, 10, fu_get32(C, 10) + 1);
                fu_put32(C, 13, fu_get32(C, 13) + lic_storegen);
                if(install == 1) {
                    fu_put32(C, 11, fu_get32(C, 11) + 1);
                } else {
                    fu_put32(C, 12, fu_get32(C, 12) + 1);
                }
            }
            // per-case line
            pos = fu_add_raw(out, pos, "CASE ");
            pos = fu_add_raw(out, pos, caseid);
            pos = fu_add_raw(out, pos, " set=");
            pos = fu_add_raw(out, pos, setm);
            pos = fu_add_raw(out, pos, " norm=");
            if(nrej == 1) { pos = fu_add_raw(out, pos, "UNPARSED"); } else { pos = fu_add_raw(out, pos, "OK"); }
            pos = fu_add_raw(out, pos, " atoms=");
            pos = fu_add_i64(out, pos, na as i64);
            pos = fu_add_raw(out, pos, " nconc=");
            pos = fu_add_i64(out, pos, nconc as i64);
            pos = fu_add_raw(out, pos, " dlic=");
            pos = fu_add_i64(out, pos, dlic as i64);
            pos = fu_add_raw(out, pos, " dlic_nostore=");
            pos = fu_add_i64(out, pos, nostore as i64);
            pos = fu_add_raw(out, pos, " match_store_only=");
            pos = fu_add_i64(out, pos, storeonly as i64);
            pos = fu_add_raw(out, pos, " verdict=");
            if(install == 1) { pos = fu_add_raw(out, pos, "INSTALL"); } else { pos = fu_add_raw(out, pos, "WITHHOLD"); }
            pos = fu_add_raw(out, pos, " lic_delib=");
            pos = fu_add_i64(out, pos, lic_delib as i64);
            pos = fu_add_raw(out, pos, " lic_storegen=");
            pos = fu_add_i64(out, pos, lic_storegen as i64);
            pos = fu_add_raw(out, pos, "\n");
            // restore store-only license count for next case
            fu_put32(nlic, 0, store_nlic);
            k = k + 1;
        }
        seti = seti + 1;
    }
    pos = fu_add_raw(out, pos, "SUMMARY COMP-NORM cases=");
    pos = fu_add_i64(out, pos, fu_get32(C, 0) as i64);
    pos = fu_add_raw(out, pos, " parsed=");
    pos = fu_add_i64(out, pos, fu_get32(C, 1) as i64);
    pos = fu_add_raw(out, pos, " rejected=");
    pos = fu_add_i64(out, pos, fu_get32(C, 2) as i64);
    pos = fu_add_raw(out, pos, "\n");
    pos = fu_add_raw(out, pos, "SUMMARY COMP-DELIB alibi_traces=");
    pos = fu_add_i64(out, pos, fu_get32(C, 3) as i64);
    pos = fu_add_raw(out, pos, " conclusions=");
    pos = fu_add_i64(out, pos, fu_get32(C, 4) as i64);
    pos = fu_add_raw(out, pos, " licensed=");
    pos = fu_add_i64(out, pos, fu_get32(C, 5) as i64);
    pos = fu_add_raw(out, pos, " refused=");
    pos = fu_add_i64(out, pos, fu_get32(C, 7) as i64);
    pos = fu_add_raw(out, pos, " alibi_atoms_without_store=");
    pos = fu_add_i64(out, pos, fu_get32(C, 6) as i64);
    pos = fu_add_raw(out, pos, "\n");
    pos = fu_add_raw(out, pos, "SUMMARY COMP-MATCH m4_installed=");
    pos = fu_add_i64(out, pos, fu_get32(C, 8) as i64);
    pos = fu_add_raw(out, pos, " m4_rejected=");
    pos = fu_add_i64(out, pos, fu_get32(C, 9) as i64);
    pos = fu_add_raw(out, pos, " m5_installed=");
    pos = fu_add_i64(out, pos, fu_get32(C, 11) as i64);
    pos = fu_add_raw(out, pos, " m5_rejected=");
    pos = fu_add_i64(out, pos, fu_get32(C, 12) as i64);
    pos = fu_add_raw(out, pos, "\n");
    pos = fu_add_raw(out, pos, "SUMMARY COMP-STORELIC store_licenses=");
    pos = fu_add_i64(out, pos, store_nlic as i64);
    pos = fu_add_raw(out, pos, " store_gen_licenses=");
    pos = fu_add_i64(out, pos, store_genlic as i64);
    pos = fu_add_raw(out, pos, " m5_draft_atoms_gen_licensed=");
    pos = fu_add_i64(out, pos, fu_get32(C, 13) as i64);
    pos = fu_add_raw(out, pos, " m5_rejected=");
    pos = fu_add_i64(out, pos, fu_get32(C, 12) as i64);
    pos = fu_add_raw(out, pos, "\n");
    pos = fu_add_raw(out, pos, "SUMMARY COMP-PROV m4_draft_atoms_delib_licensed_prov0=");
    pos = fu_add_i64(out, pos, fu_get32(C, 14) as i64);
    pos = fu_add_raw(out, pos, " m4_gen_marked=0 m5_draft_atoms_gen_marked=");
    pos = fu_add_i64(out, pos, fu_get32(C, 13) as i64);
    pos = fu_add_raw(out, pos, " gates=0\n");
    pos = fu_add_raw(out, pos, "SUMMARY M4_STOREONLY_MATCH cases_with_any_store_license=");
    pos = fu_add_i64(out, pos, fu_get32(C, 15) as i64);
    pos = fu_add_raw(out, pos, "\n");
    pos = cp_emit(out, pos);
    return 0;
}

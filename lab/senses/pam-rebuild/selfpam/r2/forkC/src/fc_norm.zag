// fc_norm.zag — fork C normalization pipeline (frozen order per prereg §3):
//   tokenize -> aux-drop/percent-merge -> passive rewrite -> parse ->
//   canonical atoms -> sorted -> sha256 fingerprints (surface + meaning).
// Zero RNG. All tables from fc_tables.zag.

// ---- token accessors ----
fn fn_tok(buf:[]u8, tm:[]u8, i:i32) []u8 {
    let s:i32 = fu_get32(tm, i*2);
    let l:i32 = fu_get32(tm, i*2+1);
    return buf[s..s+l];
}

fn fn_tok_eq(buf:[]u8, tm:[]u8, i:i32, lit:[]u8) i32 {
    let t:[]u8 = fn_tok(buf, tm, i);
    if(t.len != lit.len) { return 0; }
    return nio_equal(t, lit);
}

// ---- P0: tokenize ----
fn fn_is_tokchar(c:u8) i32 {
    let x:i32 = c as i32;
    if(x >= 97 && x <= 122) { return 1; }
    if(x >= 65 && x <= 90) { return 1; }
    if(x >= 48 && x <= 57) { return 1; }
    if(x == 37 || x == 45) { return 1; }
    return 0;
}

fn fn_emit(buf:[]u8, bp:i32, tm:[]u8, nt:i32, w:[]u8) i32 {
    let i:i32 = 0;
    while(i < w.len) { buf[bp+i] = w[i]; i = i + 1; }
    fu_put32(tm, nt*2, bp);
    fu_put32(tm, nt*2+1, w.len);
    return bp + w.len;
}

// expand a contraction value "do not" into separate tokens.
fn fn_emit_expanded(buf:[]u8, bp:i32, tm:[]u8, nt:i32, v:[]u8) i32 {
    let s:i32 = 0;
    let i:i32 = 0;
    while(i <= v.len) {
        let end:i32 = 0;
        if(i == v.len) { end = 1; }
        if(end == 0 && v[i] == 32) { end = 1; }
        if(end == 1) {
            if(i > s) {
                bp = fn_emit(buf, bp, tm, nt, v[s..i]);
                nt = nt + 1;
            }
            s = i + 1;
        }
        i = i + 1;
    }
    return bp * 1024 + nt;
}

fn fn_tokenize(src:[]u8, buf:[]u8, tm:[]u8, maxtok:i32) i32 {
    let nt:i32 = 0;
    let bp:i32 = 0;
    let i:i32 = 0;
    let ts:i32 = -1;
    while(i <= src.len) {
        let c:u8 = 10;
        let isc:i32 = 0;
        if(i < src.len) {
            c = src[i];
            if(c == 39) { isc = 1; }
            else if(fn_is_tokchar(c) == 1) { isc = 1; }
        }
        if(isc == 1) {
            if(ts < 0) { ts = i; }
        }
        if(isc == 0 && ts >= 0) {
            // token src[ts..i], lowercased, apostrophes dropped
            let tl:i32 = 0;
            let k:i32 = ts;
            while(k < i) {
                let ch:u8 = src[k];
                if(ch != 39) {
                    let x:i32 = ch as i32;
                    if(x >= 65 && x <= 90) { x = x + 32; }
                    buf[bp+tl] = x as u8;
                    tl = tl + 1;
                }
                k = k + 1;
            }
            if(tl > 0) {
                let tok:[]u8 = buf[bp..bp+tl];
                let ex:[]u8 = ft_lookup(ft_contraction_table(), tok);
                if(ex.len > 0) {
                    let r:i32 = fn_emit_expanded(buf, bp, tm, nt, ex);
                    bp = r / 1024;
                    nt = r % 1024;
                } else {
                    if(nt >= maxtok) { return -1; }
                    fu_put32(tm, nt*2, bp);
                    fu_put32(tm, nt*2+1, tl);
                    nt = nt + 1;
                    bp = bp + tl;
                }
            }
            ts = -1;
        }
        i = i + 1;
    }
    return nt;
}

// ---- helpers ----
fn fn_is_digits(t:[]u8) i32 {
    if(t.len == 0) { return 0; }
    let i:i32 = 0;
    while(i < t.len) {
        let c:i32 = t[i] as i32;
        if(c < 48 || c > 57) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn fn_is_plural(t:[]u8) i32 {
    if(ft_member(ft_plural_table(), t) == 1) { return 1; }
    if(t.len > 1 && t[t.len-1] == 115) { return 1; }
    return 0;
}

fn fn_starts_rel(t:[]u8) i32 {
    if(t.len > 4 && t[0] == 82 && t[1] == 69 && t[2] == 76 && t[3] == 58) { return 1; }
    return 0;
}

// copy src into dst at dp; returns new dp.
fn fn_copy(dst:[]u8, dp:i32, src:[]u8) i32 {
    let i:i32 = 0;
    while(i < src.len) { dst[dp+i] = src[i]; i = i + 1; }
    return dp + src.len;
}

// resolve a pronoun token against ctx (entities \n-separated, ctxn of them).
// nearest = last matching. writes entity into out, returns len or -1.
fn fn_resolve_pron(t:[]u8, ctx:[]u8, ctxn:i32, out:[]u8) i32 {
    let pl:i32 = 0;
    if(ft_member(ft_pron_pl_table(), t) == 1) { pl = 1; }
    if(ft_member(ft_pron_sg_table(), t) == 0 && pl == 0) { return -1; }
    let i:i32 = ctxn - 1;
    while(i >= 0) {
        let es:i32 = 0;
        let k:i32 = 0;
        let n:i32 = 0;
        while(n <= i) {
            if(k == ctx.len || ctx[k] == 10) {
                if(n == i) { break; }
                n = n + 1;
                es = k + 1;
            }
            k = k + 1;
        }
        let el:i32 = k - es;
        let ent:[]u8 = ctx[es..es+el];
        let ispl:i32 = fn_is_plural(ent);
        if((pl == 1 && ispl == 1) || (pl == 0 && ispl == 0)) {
            return fn_copy(out, 0, ent);
        }
        i = i - 1;
    }
    return -1;
}

// canonicalize one entity-ish token into out. returns len or -1.
fn fn_canon_single(t:[]u8, ctx:[]u8, ctxn:i32, out:[]u8) i32 {
    if(ft_member(ft_pron_sg_table(), t) == 1 || ft_member(ft_pron_pl_table(), t) == 1) {
        return fn_resolve_pron(t, ctx, ctxn, out);
    }
    let sy:[]u8 = ft_lookup(ft_entsyn_table(), t);
    if(sy.len > 0) { return fn_copy(out, 0, sy); }
    return fn_copy(out, 0, t);
}

// ---- P1: drop AUX + merge "<num> percent" ----
fn fn_prepass1(b1:[]u8, m1:[]u8, n1:i32, b2:[]u8, m2:[]u8, maxtok:i32) i32 {
    let n2:i32 = 0;
    let bp:i32 = 0;
    let i:i32 = 0;
    while(i < n1) {
        let t:[]u8 = fn_tok(b1, m1, i);
        if(ft_member(ft_aux_table(), t) == 1) { i = i + 1; continue; }
        // percent merge: "<num> percent" -> "50 percent"
        if(_zag_strcmp(t, "percent") == 1 && n2 > 0) {
            let pt:[]u8 = fn_tok(b2, m2, n2-1);
            if(ft_lookup(ft_num_table(), pt).len > 0 || fn_is_digits(pt) == 1) {
                let ps:i32 = fu_get32(m2, (n2-1)*2);
                let pl:i32 = fu_get32(m2, (n2-1)*2+1);
                b2[ps+pl] = 32;
                let k:i32 = 0;
                while(k < t.len) { b2[ps+pl+1+k] = t[k]; k = k + 1; }
                fu_put32(m2, (n2-1)*2+1, pl + 1 + t.len);
                bp = bp + 1 + t.len;
                i = i + 1;
                continue;
            }
        }
        if(n2 >= maxtok) { return -1; }
        bp = fn_emit(b2, bp, m2, n2, t);
        n2 = n2 + 1;
        i = i + 1;
    }
    return n2;
}

// ---- P2: passive rewrite ----
// [subj...] [be] [pastpart] by [obj...] -> [obj...] REL:<REL> [subj...]
fn fn_prepass2(b2:[]u8, m2:[]u8, n2:i32, b3:[]u8, m3:[]u8, maxtok:i32) i32 {
    let byj:i32 = -1;
    let i:i32 = 0;
    while(i < n2) {
        if(fn_tok_eq(b2, m2, i, "by") == 1) { byj = i; }
        i = i + 1;
    }
    if(byj < 0) {
        // no passive: copy through
        let bp:i32 = 0;
        let n3:i32 = 0;
        i = 0;
        while(i < n2) {
            if(n3 >= maxtok) { return -1; }
            bp = fn_emit(b3, bp, m3, n3, fn_tok(b2, m2, i));
            n3 = n3 + 1;
            i = i + 1;
        }
        return n3;
    }
    let k:i32 = -1;
    let kk:i32 = byj - 1;
    while(kk >= 0) {
        if(ft_lookup(ft_part_table(), fn_tok(b2, m2, kk)).len > 0) { k = kk; }
        kk = kk - 1;
    }
    let m:i32 = -1;
    let mm:i32 = 0;
    while(mm < byj) {
        if(ft_member(ft_be_table(), fn_tok(b2, m2, mm)) == 1) { m = mm; }
        mm = mm + 1;
    }
    if(k < 0 || m < 0 || m > k) { return -2; }
    let rel:[]u8 = ft_lookup(ft_part_table(), fn_tok(b2, m2, k));
    let bp:i32 = 0;
    let n3:i32 = 0;
    // obj tokens: (byj+1 .. n2)
    i = byj + 1;
    while(i < n2) {
        if(n3 >= maxtok) { return -1; }
        bp = fn_emit(b3, bp, m3, n3, fn_tok(b2, m2, i));
        n3 = n3 + 1;
        i = i + 1;
    }
    // REL marker
    let rtok:[]u8 = nio_alloc(32);
    if(rtok.len == 0) { return -1; }
    let rp:i32 = fn_copy(rtok, 0, "REL:");
    rp = fn_copy(rtok, rp, rel);
    // negation between aux and participle (m+1 .. k-1): preserve before REL;
    // anything else there -> UNPARSED (fail closed).
    let ni:i32 = m + 1;
    while(ni < k) {
        let nt2:[]u8 = fn_tok(b2, m2, ni);
        if(ft_member(ft_neg_table(), nt2) == 0) { nio_free(rtok); return -2; }
        if(n3 >= maxtok) { nio_free(rtok); return -1; }
        bp = fn_emit(b3, bp, m3, n3, nt2);
        n3 = n3 + 1;
        ni = ni + 1;
    }
    if(n3 >= maxtok) { nio_free(rtok); return -1; }
    bp = fn_emit(b3, bp, m3, n3, rtok[0..rp]);
    n3 = n3 + 1;
    nio_free(rtok);
    // subj tokens: (0 .. m)
    i = 0;
    while(i < m) {
        if(n3 >= maxtok) { return -1; }
        bp = fn_emit(b3, bp, m3, n3, fn_tok(b2, m2, i));
        n3 = n3 + 1;
        i = i + 1;
    }
    return n3;
}

// P3: STOP-strip (frozen step 4) for STOP words not consumed earlier:
// of/to/for/with/as/at/and/or/but. Runs after passive detection.
fn fn_prepass3(b:[]u8, tm:[]u8, nt:i32, bo:[]u8, tmo:[]u8, maxtok:i32) i32 {
    let bp:i32 = 0;
    let no:i32 = 0;
    let i:i32 = 0;
    while(i < nt) {
        let t:[]u8 = fn_tok(b, tm, i);
        if(ft_member(ft_stop2_table(), t) == 0) {
            if(no >= maxtok) { return -1; }
            let tl:i32 = t.len;
            let k:i32 = 0;
            while(k < tl) { bo[bp+k] = t[k]; k = k + 1; }
            fu_put32(tmo, no*2, bp);
            fu_put32(tmo, no*2+1, tl);
            bp = bp + tl;
            no = no + 1;
        }
        i = i + 1;
    }
    return no;
}

// ---- parser ----
// parse one entity slot at *t; returns (new_t*1024 + outlen) or -1.
fn fn_parse_ent(b:[]u8, tm:[]u8, nt:i32, t:i32, ctx:[]u8, ctxn:i32, out:[]u8) i32 {
    while(t < nt && ft_member(ft_det_table(), fn_tok(b, tm, t)) == 1) { t = t + 1; }
    if(t >= nt) { return -1; }
    let tok:[]u8 = fn_tok(b, tm, t);
    let numv:[]u8 = ft_lookup(ft_num_table(), tok);
    if(numv.len > 0 || fn_is_digits(tok) == 1) {
        let canon:[]u8 = tok;
        if(numv.len > 0) { canon = numv; }
        let n2v:[]u8 = tok;
        // "50 percent" two-word form already merged in P1; num2 table
        // covers it if merge produced it; check ft_num2_table too
        let nv2:[]u8 = ft_lookup(ft_num2_table(), tok);
        if(nv2.len > 0) { canon = nv2; }
        t = t + 1;
        while(t < nt && ft_member(ft_det_table(), fn_tok(b, tm, t)) == 1) { t = t + 1; }
        if(t >= nt) { return -1; }
        let noun:[]u8 = nio_alloc(64);
        if(noun.len == 0) { return -1; }
        let nl:i32 = fn_canon_single(fn_tok(b, tm, t), ctx, ctxn, noun);
        if(nl < 0) { nio_free(noun); return -1; }
        let p:i32 = fn_copy(out, 0, "n:");
        p = fn_copy(out, p, canon);
        p = fn_copy(out, p, ":");
        p = fn_copy(out, p, noun[0..nl]);
        nio_free(noun);
        t = t + 1;
        return t * 1024 + p;
    }
    // num2 two-word number form (already merged by P1, kept for safety)
    let nv2:[]u8 = ft_lookup(ft_num2_table(), tok);
    if(nv2.len > 0) {
        t = t + 1;
        while(t < nt && ft_member(ft_det_table(), fn_tok(b, tm, t)) == 1) { t = t + 1; }
        if(t >= nt) { return -1; }
        let noun:[]u8 = nio_alloc(64);
        if(noun.len == 0) { return -1; }
        let nl:i32 = fn_canon_single(fn_tok(b, tm, t), ctx, ctxn, noun);
        if(nl < 0) { nio_free(noun); return -1; }
        let p:i32 = fn_copy(out, 0, "n:");
        p = fn_copy(out, p, nv2);
        p = fn_copy(out, p, ":");
        p = fn_copy(out, p, noun[0..nl]);
        nio_free(noun);
        t = t + 1;
        return t * 1024 + p;
    }
    let l:i32 = fn_canon_single(tok, ctx, ctxn, out);
    if(l < 0) { return -1; }
    t = t + 1;
    return t * 1024 + l;
}

// main parse: writes atom into aout, returns atom len or -1 (UNPARSED).
fn fn_parse(b:[]u8, tm:[]u8, nt:i32, ctx:[]u8, ctxn:i32, aout:[]u8) i32 {
    let t:i32 = 0;
    let q:[]u8 = "";
    if(t < nt && ft_member(ft_quant_table(), fn_tok(b, tm, t)) == 1) {
        q = fn_tok(b, tm, t);
        t = t + 1;
    }
    let subj:[]u8 = nio_alloc(128);
    if(subj.len == 0) { return -1; }
    let r:i32 = fn_parse_ent(b, tm, nt, t, ctx, ctxn, subj);
    if(r < 0) { nio_free(subj); return -1; }
    t = r / 1024;
    let sl:i32 = r % 1024;
    let neg:i32 = 0;
    let be:i32 = 0;
    if(t < nt && ft_member(ft_be_table(), fn_tok(b, tm, t)) == 1) { be = 1; t = t + 1; }
    // F2: is a|an <class>
    if(be == 1 && t < nt && (fn_tok_eq(b, tm, t, "a") == 1 || fn_tok_eq(b, tm, t, "an") == 1)) {
        t = t + 1;
        let cls:[]u8 = nio_alloc(64);
        if(cls.len == 0) { nio_free(subj); return -1; }
        if(t >= nt) { nio_free(subj); nio_free(cls); return -1; }
        let cl:i32 = fn_canon_single(fn_tok(b, tm, t), ctx, ctxn, cls);
        if(cl < 0) { nio_free(subj); nio_free(cls); return -1; }
        t = t + 1;
        if(t != nt) { nio_free(subj); nio_free(cls); return -1; }
        let p:i32 = 0;
        if(q.len > 0) { p = fn_copy(aout, p, "q:"); p = fn_copy(aout, p, q); p = fn_copy(aout, p, "|"); }
        p = fn_copy(aout, p, subj[0..sl]);
        p = fn_copy(aout, p, "|IS_A|");
        p = fn_copy(aout, p, cls[0..cl]);
        nio_free(subj);
        nio_free(cls);
        return p;
    }
    if(t < nt && ft_member(ft_neg_table(), fn_tok(b, tm, t)) == 1) { neg = 1; t = t + 1; }
    // REL: marker (passive output)
    if(t < nt && fn_starts_rel(fn_tok(b, tm, t)) == 1) {
        let rt:[]u8 = fn_tok(b, tm, t);
        let rel:[]u8 = rt[4..rt.len];
        t = t + 1;
        let obj:[]u8 = nio_alloc(128);
        if(obj.len == 0) { nio_free(subj); return -1; }
        r = fn_parse_ent(b, tm, nt, t, ctx, ctxn, obj);
        if(r < 0) { nio_free(subj); nio_free(obj); return -1; }
        t = r / 1024;
        let ol:i32 = r % 1024;
        if(t != nt) { nio_free(subj); nio_free(obj); return -1; }
        let p:i32 = 0;
        if(neg == 1) { p = fn_copy(aout, p, "~"); }
        if(q.len > 0) { p = fn_copy(aout, p, "q:"); p = fn_copy(aout, p, q); p = fn_copy(aout, p, "|"); }
        p = fn_copy(aout, p, subj[0..sl]);
        p = fn_copy(aout, p, "|");
        p = fn_copy(aout, p, rel);
        p = fn_copy(aout, p, "|");
        p = fn_copy(aout, p, obj[0..ol]);
        nio_free(subj);
        nio_free(obj);
        return p;
    }
    if(t < nt) {
        let pr:[]u8 = ft_lookup(ft_prep_table(), fn_tok(b, tm, t));
        if(pr.len > 0) {
            t = t + 1;
            let obj:[]u8 = nio_alloc(128);
            if(obj.len == 0) { nio_free(subj); return -1; }
            r = fn_parse_ent(b, tm, nt, t, ctx, ctxn, obj);
            if(r < 0) { nio_free(subj); nio_free(obj); return -1; }
            t = r / 1024;
            let ol:i32 = r % 1024;
            if(t != nt) { nio_free(subj); nio_free(obj); return -1; }
            let p:i32 = 0;
            if(neg == 1) { p = fn_copy(aout, p, "~"); }
            if(q.len > 0) { p = fn_copy(aout, p, "q:"); p = fn_copy(aout, p, q); p = fn_copy(aout, p, "|"); }
            p = fn_copy(aout, p, subj[0..sl]);
            p = fn_copy(aout, p, "|");
            p = fn_copy(aout, p, pr);
            p = fn_copy(aout, p, "|");
            p = fn_copy(aout, p, obj[0..ol]);
            nio_free(subj);
            nio_free(obj);
            return p;
        }
        let vb:[]u8 = ft_lookup(ft_verb_table(), fn_tok(b, tm, t));
        if(vb.len > 0) {
            t = t + 1;
            let obj:[]u8 = nio_alloc(128);
            if(obj.len == 0) { nio_free(subj); return -1; }
            r = fn_parse_ent(b, tm, nt, t, ctx, ctxn, obj);
            if(r < 0) { nio_free(subj); nio_free(obj); return -1; }
            t = r / 1024;
            let ol:i32 = r % 1024;
            if(t != nt) { nio_free(subj); nio_free(obj); return -1; }
            let p:i32 = 0;
            if(neg == 1) { p = fn_copy(aout, p, "~"); }
            if(q.len > 0) { p = fn_copy(aout, p, "q:"); p = fn_copy(aout, p, q); p = fn_copy(aout, p, "|"); }
            p = fn_copy(aout, p, subj[0..sl]);
            p = fn_copy(aout, p, "|");
            p = fn_copy(aout, p, vb);
            p = fn_copy(aout, p, "|");
            p = fn_copy(aout, p, obj[0..ol]);
            nio_free(subj);
            nio_free(obj);
            return p;
        }
    }
    // F1: be <adj>
    if(be == 1 && t < nt) {
        let adj:[]u8 = fn_tok(b, tm, t);
        t = t + 1;
        if(t != nt) { nio_free(subj); return -1; }
        if(neg == 1) {
            let an:[]u8 = ft_lookup(ft_antonym_table(), adj);
            if(an.len > 0) { adj = an; neg = 0; }
        }
        let p:i32 = 0;
        if(neg == 1) { p = fn_copy(aout, p, "~"); }
        if(q.len > 0) { p = fn_copy(aout, p, "q:"); p = fn_copy(aout, p, q); p = fn_copy(aout, p, "|"); }
        p = fn_copy(aout, p, subj[0..sl]);
        p = fn_copy(aout, p, "|HAS_PROPERTY|");
        p = fn_copy(aout, p, adj);
        nio_free(subj);
        return p;
    }
    nio_free(subj);
    return -1;
}

// full atomize of one text: returns number of atoms (0/1) or -1.
// atoms appended to abuf with ameta (start,len) pairs; UNPARSED -> -1.
fn fn_atomize(text:[]u8, ctx:[]u8, ctxn:i32, abuf:[]u8, ameta:[]u8) i32 {
    let b1:[]u8 = nio_alloc(2048);
    let m1:[]u8 = nio_alloc(64*8);
    let b2:[]u8 = nio_alloc(2048);
    let m2:[]u8 = nio_alloc(64*8);
    let b3:[]u8 = nio_alloc(2048);
    let m3:[]u8 = nio_alloc(64*8);
    let b4:[]u8 = nio_alloc(2048);
    let m4:[]u8 = nio_alloc(64*8);
    if(b1.len == 0 || m1.len == 0 || b2.len == 0 || m2.len == 0 || b3.len == 0 || m3.len == 0 || b4.len == 0 || m4.len == 0) {
        nio_free(b1); nio_free(m1); nio_free(b2); nio_free(m2); nio_free(b3); nio_free(m3); nio_free(b4); nio_free(m4);
        return -1;
    }
    let n1:i32 = fn_tokenize(text, b1, m1, 64);
    if(n1 <= 0) {
        nio_free(b1); nio_free(m1); nio_free(b2); nio_free(m2); nio_free(b3); nio_free(m3); nio_free(b4); nio_free(m4);
        return -1;
    }
    let n2:i32 = fn_prepass1(b1, m1, n1, b2, m2, 64);
    if(n2 <= 0) {
        nio_free(b1); nio_free(m1); nio_free(b2); nio_free(m2); nio_free(b3); nio_free(m3); nio_free(b4); nio_free(m4);
        return -1;
    }
    let n3:i32 = fn_prepass2(b2, m2, n2, b3, m3, 64);
    if(n3 == -2) {
        // "by" present but not a clean passive -> UNPARSED
        nio_free(b1); nio_free(m1); nio_free(b2); nio_free(m2); nio_free(b3); nio_free(m3); nio_free(b4); nio_free(m4);
        return -1;
    }
    if(n3 <= 0) {
        nio_free(b1); nio_free(m1); nio_free(b2); nio_free(m2); nio_free(b3); nio_free(m3); nio_free(b4); nio_free(m4);
        return -1;
    }
    let n4:i32 = fn_prepass3(b3, m3, n3, b4, m4, 64);
    if(n4 <= 0) {
        nio_free(b1); nio_free(m1); nio_free(b2); nio_free(m2); nio_free(b3); nio_free(m3); nio_free(b4); nio_free(m4);
        return -1;
    }
    let al:i32 = fn_parse(b4, m4, n4, ctx, ctxn, abuf);
    nio_free(b1); nio_free(m1); nio_free(b2); nio_free(m2); nio_free(b3); nio_free(m3); nio_free(b4); nio_free(m4);
    if(al < 0) { return -1; }
    fu_put32(ameta, 0, 0);
    fu_put32(ameta, 1, al);
    return 1;
}

// insertion sort of ameta entries by atom bytes in abuf.
fn fn_sort_atoms(abuf:[]u8, ameta:[]u8, na:i32) void {
    let i:i32 = 1;
    while(i < na) {
        let ks:i32 = fu_get32(ameta, i*2);
        let kl:i32 = fu_get32(ameta, i*2+1);
        let j:i32 = i - 1;
        while(j >= 0) {
            let js:i32 = fu_get32(ameta, j*2);
            let jl:i32 = fu_get32(ameta, j*2+1);
            if(fu_cmp(abuf[js..js+jl], abuf[ks..ks+kl]) <= 0) { break; }
            fu_put32(ameta, (j+1)*2, js);
            fu_put32(ameta, (j+1)*2+1, jl);
            j = j - 1;
        }
        fu_put32(ameta, (j+1)*2, ks);
        fu_put32(ameta, (j+1)*2+1, kl);
        i = i + 1;
    }
}

// sort token indices by token bytes: idx arena gets sorted indices.
fn fn_sort_toks(buf:[]u8, tm:[]u8, nt:i32, idx:[]u8) void {
    let i:i32 = 0;
    while(i < nt) { fu_put32(idx, i, i); i = i + 1; }
    i = 1;
    while(i < nt) {
        let ki:i32 = fu_get32(idx, i);
        let j:i32 = i - 1;
        while(j >= 0) {
            let ji:i32 = fu_get32(idx, j);
            if(fu_cmp(fn_tok(buf, tm, ji), fn_tok(buf, tm, ki)) <= 0) { break; }
            fu_put32(idx, j+1, ji);
            j = j - 1;
        }
        fu_put32(idx, j+1, ki);
        i = i + 1;
    }
}

// fingerprints: mfp_out/sfp_out are 64-byte buffers (hex).
// returns 0 ok, -1 on parse/hash failure.
fn fn_fingerprints(text:[]u8, ctx:[]u8, ctxn:i32, mfp_out:[]u8, sfp_out:[]u8) i32 {
    let abuf:[]u8 = nio_alloc(2048);
    let ameta:[]u8 = nio_alloc(8*8);
    if(abuf.len == 0 || ameta.len == 0) { nio_free(abuf); nio_free(ameta); return -1; }
    let na:i32 = fn_atomize(text, ctx, ctxn, abuf, ameta);
    if(na < 0) { nio_free(abuf); nio_free(ameta); return -1; }
    fn_sort_atoms(abuf, ameta, na);
    // meaning-canonical: atoms joined with \n
    let mc:[]u8 = nio_alloc(2048);
    if(mc.len == 0) { nio_free(abuf); nio_free(ameta); return -1; }
    let mp:i32 = 0;
    let i:i32 = 0;
    while(i < na) {
        if(i > 0) { mc[mp] = 10; mp = mp + 1; }
        let s:i32 = fu_get32(ameta, i*2);
        let l:i32 = fu_get32(ameta, i*2+1);
        mp = fn_copy(mc, mp, abuf[s..s+l]);
        i = i + 1;
    }
    let mh:[]u8 = nio_alloc(32);
    if(mh.len == 0 || ns_sha256(mc[0..mp], mh) != 0) {
        nio_free(abuf); nio_free(ameta); nio_free(mc); nio_free(mh);
        return -1;
    }
    let mhx:[]u8 = ns_hex(mh);
    if(mhx.len != 64) {
        nio_free(abuf); nio_free(ameta); nio_free(mc); nio_free(mh); nio_free(mhx);
        return -1;
    }
    fn_copy(mfp_out, 0, mhx);
    nio_free(mh); nio_free(mhx); nio_free(mc);
    // surface: raw post-tokenize tokens sorted, joined with space
    let b1:[]u8 = nio_alloc(2048);
    let m1:[]u8 = nio_alloc(64*8);
    let idx:[]u8 = nio_alloc(64*4);
    if(b1.len == 0 || m1.len == 0 || idx.len == 0) {
        nio_free(abuf); nio_free(ameta); nio_free(b1); nio_free(m1); nio_free(idx);
        return -1;
    }
    let n1:i32 = fn_tokenize(text, b1, m1, 64);
    if(n1 <= 0) {
        nio_free(abuf); nio_free(ameta); nio_free(b1); nio_free(m1); nio_free(idx);
        return -1;
    }
    fn_sort_toks(b1, m1, n1, idx);
    let sc:[]u8 = nio_alloc(2048);
    if(sc.len == 0) {
        nio_free(abuf); nio_free(ameta); nio_free(b1); nio_free(m1); nio_free(idx);
        return -1;
    }
    let sp:i32 = 0;
    i = 0;
    while(i < n1) {
        if(i > 0) { sc[sp] = 32; sp = sp + 1; }
        let ki:i32 = fu_get32(idx, i);
        sp = fn_copy(sc, sp, fn_tok(b1, m1, ki));
        i = i + 1;
    }
    let sh:[]u8 = nio_alloc(32);
    if(sh.len == 0 || ns_sha256(sc[0..sp], sh) != 0) {
        nio_free(abuf); nio_free(ameta); nio_free(b1); nio_free(m1);
        nio_free(idx); nio_free(sc); nio_free(sh);
        return -1;
    }
    let shx:[]u8 = ns_hex(sh);
    if(shx.len != 64) {
        nio_free(abuf); nio_free(ameta); nio_free(b1); nio_free(m1);
        nio_free(idx); nio_free(sc); nio_free(sh); nio_free(shx);
        return -1;
    }
    fn_copy(sfp_out, 0, shx);
    nio_free(abuf); nio_free(ameta); nio_free(b1); nio_free(m1);
    nio_free(idx); nio_free(sc); nio_free(sh); nio_free(shx);
    return 0;
}

// sha256 hex of one atom's canonical string (for license matching).
fn fn_atom_hash(atom:[]u8, hx_out:[]u8) i32 {
    let h:[]u8 = nio_alloc(32);
    if(h.len == 0) { return -1; }
    if(ns_sha256(atom, h) != 0) { nio_free(h); return -1; }
    let x:[]u8 = ns_hex(h);
    nio_free(h);
    if(x.len != 64) { nio_free(x); return -1; }
    fn_copy(hx_out, 0, x);
    nio_free(x);
    return 0;
}

@import("rt_common.zag")
// manifest: pure-Zag manifest generator (zero RNG).
// argv1 = battery dir. Emits MANIFEST.tsv: MAN|<path>|<bytes>|<fnv1a32>.
// File list is fixed and explicit (no directory walk = deterministic order).
fn zc(s:[]u8)[]u8 {
    let b:[]u8=z_cstr(s);
    if(b.len==0){return b;}
    return b[0..s.len];
}
fn path2(dir:[]u8, name:[]u8)[]u8 {
    let p:[]u8=z_alloc(dir.len+name.len+2);
    let at:i32=buf_cat(p,0,dir);
    at=buf_cat(p,at,"/");
    at=buf_cat(p,at,name);
    return p[0..at];
}
fn one(out:[]u8, at:i32, dir:[]u8, name:[]u8)i32 {
    let p:[]u8=path2(dir,name);
    let t:[]u8=f_read(p,1048576);
    z_free(p);
    at=buf_cat(out,at,"MAN|");
    at=buf_cat(out,at,name);at=buf_cat(out,at,"|");
    at=buf_cati(out,at,t.len);at=buf_cat(out,at,"|");
    let h:[]u8=s_fnv_hex(t);
    at=buf_cat(out,at,h);at=buf_cat(out,at,"\n");
    z_free(t);z_free(h);
    return at;
}
fn main()i32 {
    let dir:[]u8=_zag_arg(1);
    if(dir.len==0){_zag_println("need dir");return 1;}
    let out:[]u8=z_alloc(65536);
    let at:i32=0;
    at=one(out,at,dir,"rules.tsv");
    at=one(out,at,dir,"bases.tsv");
    at=one(out,at,dir,"pairs_sm.tsv");
    at=one(out,at,dir,"pairs_ss.tsv");
    at=one(out,at,dir,"pairs_flip.tsv");
    at=one(out,at,dir,"aval.tsv");
    at=one(out,at,dir,"CONF.tsv");
    at=one(out,at,dir,"GOLD.tsv");
    at=one(out,at,dir,"ALIBI.tsv");
    at=one(out,at,dir,"RECUR.tsv");
    at=one(out,at,dir,"SMUGGLE.tsv");
    at=one(out,at,dir,"UTYPE.tsv");
    at=one(out,at,dir,"CALIB.tsv");
    at=one(out,at,dir,"POINTER.tsv");
    at=one(out,at,dir,"STORE.tsv");
    at=one(out,at,dir,"TRACE.tsv");
    at=one(out,at,dir,"GT.tsv");
    at=one(out,at,dir,"ANNOT.tsv");
    at=one(out,at,dir,"FAB.tsv");
    at=one(out,at,dir,"TRACE_README.txt");
    let p:[]u8=path2(dir,"MANIFEST.tsv");
    let pz:[]u8=z_cstr(p);
    f_write(pz,out[0..at]);
    z_free(p);z_free(pz);
    _zag_print("manifest_bytes=");
    _zag_println(s_itoa(at));
    return 0;
}

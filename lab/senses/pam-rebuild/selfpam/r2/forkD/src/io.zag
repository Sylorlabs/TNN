// io.zag — file I/O, printing, small helpers for fork D.
// Pure Zag. No RNG, no clock.

@import("substrate/R33_NATIVE_IO_V1.zag")
@import("substrate/R33_NATIVE_SHA256_V2.zag")

fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8 = nio_alloc(s.len+1);
    if(b.len==0){return "";}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}

fn file_read(path:[]u8)[]u8 {
    let c:[]u8 = z_cstr(path);
    if(c.len==0){return "";}
    let fd:i64 = _zag_raw_syscall(2,_zag_slice_ptr(c) as i64,0,0,0,0,0);
    if(fd<0){return "";}
    let out:[]u8 = nio_alloc(1048576);
    if(out.len==0){nio_close(fd);return "";}
    let n:i64 = nio_read_exact(fd,out,1048576);
    nio_close(fd);
    if(n<0){return "";}
    let nn:i32 = n as i32;
    return out[0..nn];
}

fn file_write(path:[]u8,data:[]u8)i64 {
    let c:[]u8 = z_cstr(path);
    if(c.len==0){return -1;}
    // O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644 = 420. No O_EXCL (reruns must overwrite).
    let fd:i64 = _zag_raw_syscall(2,_zag_slice_ptr(c) as i64,577,420,0,0,0);
    if(fd<0){return -1;}
    let w:i64 = nio_write_all(fd,data);
    nio_close(fd);
    return w;
}

fn mk_dirs(outdir:[]u8)void {
    nio_mkdir(outdir);
    let d1:[]u8 = nio_alloc(outdir.len+16);
    let d2:[]u8 = nio_alloc(outdir.len+16);
    if(d1.len==0 || d2.len==0){return;}
    let i:i32=0;
    while(i<outdir.len){d1[i]=outdir[i];d2[i]=outdir[i];i=i+1;}
    let s1:[]u8 = "/drafts";
    let s2:[]u8 = "/delib";
    i=0;
    while(i<s1.len){d1[outdir.len+i]=s1[i];i=i+1;}
    i=0;
    while(i<s2.len){d2[outdir.len+i]=s2[i];i=i+1;}
    nio_mkdir(d1[0..outdir.len+s1.len]);
    nio_mkdir(d2[0..outdir.len+s2.len]);
    return;
}

fn pout(s:[]u8)void {
    nio_write_all(1,s);
    return;
}

fn perr(s:[]u8)void {
    nio_write_all(2,s);
    return;
}

// i64 -> decimal string (strips the helper-newline quirk).
fn i64s(v:i64)[]u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}

fn emit_digest(stdout_buf:[]u8)void {
    let h:[]u8 = nio_alloc(32);
    if(h.len==0){return;}
    if(ns_sha256(stdout_buf,h)!=0){return;}
    let hx:[]u8 = ns_hex(h);
    perr("digest=");
    perr(hx);
    perr("\n");
    return;
}

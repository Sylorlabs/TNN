// sense_r24.zag — PAM fork R2-4: EXECUTABLE PERCEPT PROGRAMS + self-flag.
//
// A percept is a canonical bounded program: subject_slots, observations
// (primitive witness bindings from sparse evidence spans), relations,
// ordered tests T1..Tn (validity, direction, margin, prediction), a
// predicted consequence P1 (the same measurement re-executed on a HELD-OUT
// evidence span — disjoint pixels / samples / frames), result
// PASS | FAIL | UNRESOLVED, source_refs, cost (= ops).
//
// CLI: sense_r24 <task> <fixture-path>  (R24A dual-span or legacy formats)
// stdout: approach=H2, task=, judgment=, confidence=0..1000, ops=, prog=,
//         pred=0|1, cost=, measure=, program=  (one key=value per line)
// Exit 0 on success; approach=H2 + task= + error=<reason>, exit 1 on failure.
//
// Pure Zag, integer math only, zero RNG, fully deterministic: 3 runs of the
// same binary+fixture are byte-identical.
//
// znc bug workarounds honored (INTERFACE.md / AGENTS.md): no argc gate, no
// `as []i32` casts ([]u8 arenas + LE accessors), `_zag_strcmp`==1 on
// equality, no slice > 2^25 indexed, NUL-terminated paths via z_cstr,
// `_zag_raw_syscall` exactly 7 args, shallow else-nesting, no `};`.

@import("R33_NATIVE_IO_V1.zag")
@import("lut.zag")
@import("gcheck.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}

// ---------------- ops counter (8-byte arena) -----------------------------
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- integer math -------------------------------------------
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
// integer power, base >= 0, small exponents
fn ipow(b:i64, e:i32) i64 {
    let r:i64 = 1;
    let i:i32 = 0;
    while(i < e) { r = r * b; i = i + 1; }
    return r;
}

// ---------------- file IO -------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// ---------------- stdout line builder ------------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn ob_pair(ob:[]u8, pos:i32, name:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, name);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, _zag_i64_to_str(v));
    pos = ob_add(ob, pos, ";");
    return pos;
}
fn fail(task:[]u8, reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "R2-4");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "error", reason);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// sin(p) * 1024, p = turn in [0, 2^32). Table-free fixed-point Taylor with
// quadrant folding.
fn ng_sin1024(p:i64) i64 {
    let q:i64 = (p >> 30) & 3;
    let fr:i64 = p & 1073741823;
    let x:i64 = (fr * 1608) >> 30;
    let xx:i64 = x;
    if(q == 1 || q == 3) { xx = 1608 - x; }
    let x2:i64 = xx * xx;
    let term:i64 = xx;
    let sum:i64 = xx;
    let k:i64 = 1;
    while(k <= 7) {
        term = 0 - term * x2 / ((2 * k) * (2 * k + 1) * 1048576);
        sum = sum + term;
        k = k + 1;
    }
    if(q >= 2) { return 0 - sum; }
    return sum;
}
// cos(p)*1024 via the sin table.
fn ng_cos1024(p:i64) i64 {
    return ng_sin1024((p + 1073741824) & 4294967295);
}
// atan2(y,x) in millidegrees [0,360000), via binary search on the sin table.
// 22 iterations -> resolution < 0.0001 degree.
fn atan2_mdeg(y:i64, x:i64) i64 {
    if(x == 0 && y == 0) { return 0; }
    let ay:i64 = iabs(y);
    let ax:i64 = iabs(x);
    let lo:i64 = 0;
    let hi:i64 = 1073741824;
    let it:i32 = 0;
    while(it < 22) {
        let mid:i64 = (lo + hi) / 2;
        let s:i64 = ng_sin1024(mid);
        let c:i64 = ng_cos1024(mid);
        if(ay * c > ax * s) { lo = mid; } else { hi = mid; }
        it = it + 1;
    }
    let mdeg:i64 = lo * 360000 / 4294967296;
    if(x >= 0 && y >= 0) { return mdeg; }
    if(x < 0 && y >= 0) { return 180000 - mdeg; }
    if(x < 0 && y < 0) { return 180000 + mdeg; }
    return 360000 - mdeg;
}

// ================= audio helpers =========================================
// Peak amplitude (for the deadband).
fn pcm_peak(buf:[]u8, off:i32, cnt:i32) i64 {
    let p:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let s:i64 = iabs(t_geti16(buf, off + i * 2));
        if(s > p) { p = s; }
        i = i + 1;
    }
    return p;
}
// Harmonic energy at harmonics of f0m (milli-Hz) over w samples at off.
// op counts 2 element-visits per (sample, harmonic).
fn harm_energy(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, nhmax:i32, op:[]u8) i64 {
    if(f0m <= 0 || w < 64) { return 0; }
    let pinc1:i64 = f0m * 4294967296 / (1000 * sr);
    if(pinc1 <= 0) { return 0; }
    let tot:i64 = 0;
    let h:i64 = 1;
    while(h <= nhmax as i64) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let pinc:i64 = h * pinc1;
        let re:i64 = 0;
        let im:i64 = 0;
        let i:i32 = 0;
        while(i < w) {
            let s:i64 = t_geti16(buf, off + i * 2);
            let p:i64 = ((i as i64) * pinc) & 4294967295;
            re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
            im = im + s * ng_sin1024(p) / 1024;
            i = i + 1;
        }
        op_add(op, (2 * w) as i64);
        tot = tot + (re * re + im * im) / 1048576;
        h = h + 1;
    }
    return tot;
}

// H2 robust fundamental (milli-Hz): same structure as Approach A but on a
// shorter window (wcap 1024) and a narrower fine grid (+-2% at 0.15% steps,
// 27 points) — the sparse-measurement analog. Autocorrelation (coarse) +
// harmonic-energy maximization (fine) + parabolic interpolation +
// matched-coverage octave guard. Returns 0 on failure.
fn f0_h2(buf:[]u8, off:i32, cnt:i32, sr:i64, op:[]u8) i64 {
    let w:i32 = cnt;
    if(w > 1024) { w = 1024; }
    if(w < 512) { return 0; }
    let peak:i64 = pcm_peak(buf, off, w);
    if(peak < 256) { return 0; }
    let ms:i64 = 0;
    let i:i32 = 0;
    while(i < w) { ms = ms + t_geti16(buf, off + i * 2); i = i + 1; }
    let mean:i64 = ms / (w as i64);
    op_add(op, (2 * w) as i64);
    let lmin:i32 = (sr / 2000) as i32;
    if(lmin < 2) { lmin = 2; }
    let lmax:i32 = (sr / 50) as i32;
    if(lmax > w / 3) { lmax = w / 3; }
    if(lmax < lmin + 2) { return 0; }
    let nl:i32 = lmax - lmin + 3;
    let ra:[]u8 = nio_alloc((nl * 8) as i32);
    if(ra.len == 0) { return 0; }
    let l:i32 = lmin - 1;
    while(l <= lmax + 1) {
        let acc:i64 = 0;
        let nn:i32 = w - l;
        let n:i32 = 0;
        while(n < nn) {
            let a:i64 = t_geti16(buf, off + n * 2) - mean;
            let b:i64 = t_geti16(buf, off + (n + l) * 2) - mean;
            acc = acc + a * b;
            n = n + 1;
        }
        op_add(op, nn as i64);
        t_put64(ra, (l - (lmin - 1)) * 8, acc);
        l = l + 1;
    }
    let gmax:i64 = 0;
    l = lmin;
    while(l <= lmax) {
        let r:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
        if(r > gmax) { gmax = r; }
        l = l + 1;
    }
    let lstar:i32 = -1;
    let r0:i64 = 0;
    let rm:i64 = 0;
    let rp:i64 = 0;
    if(gmax > 0) {
        l = lmin;
        while(l <= lmax) {
            let q0:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
            let qm:i64 = t_get64(ra, (l - 1 - (lmin - 1)) * 8);
            let qp:i64 = t_get64(ra, (l + 1 - (lmin - 1)) * 8);
            if(q0 >= qm && q0 >= qp && q0 * 2 >= gmax) {
                lstar = l;
                r0 = q0;
                rm = qm;
                rp = qp;
                break;
            }
            l = l + 1;
        }
    }
    nio_free(ra);
    if(lstar < 0) { return 0; }
    let den:i64 = 2 * (rm - 2 * r0 + rp);
    let poff:i64 = 0;
    if(den != 0) { poff = (rm - rp) * 1024 / den; }
    if(poff < -512) { poff = -512; }
    if(poff > 512) { poff = 512; }
    let period_1024:i64 = (lstar as i64) * 1024 + poff;
    if(period_1024 <= 0) { return 0; }
    let f0c:i64 = sr * 1000 * 1024 / period_1024;
    // fine grid: f0c*(1 + k*0.0015), k in -13..13 (27 points)
    let best_k:i32 = -13;
    let best_s:i64 = -1;
    let k:i32 = -13;
    while(k <= 13) {
        let f0k:i64 = f0c + f0c * (k as i64) * 15 / 10000;
        let s:i64 = harm_energy(buf, off, w, sr, f0k, 6, op);
        if(s > best_s) { best_s = s; best_k = k; }
        k = k + 1;
    }
    if(best_s <= 0) { return 0; }
    let sm:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k - 1) as i64) * 15 / 10000, 6, op);
    let sp:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k + 1) as i64) * 15 / 10000, 6, op);
    let den2:i64 = 2 * (sm - 2 * best_s + sp);
    let koff:i64 = 0;
    if(den2 != 0) { koff = (sm - sp) * 1024 / den2; }
    if(koff < -512) { koff = -512; }
    if(koff > 512) { koff = 512; }
    let f0m:i64 = f0c + f0c * ((best_k as i64) * 1024 + koff) * 15 / (1024 * 10000);
    if(f0m <= 0) { return 0; }
    // octave guard with matched harmonic coverage (same as Approach A)
    let e0:i64 = harm_energy(buf, off, w, sr, f0m, 8, op);
    let ehalf:i64 = harm_energy(buf, off, w, sr, f0m / 2, 16, op);
    let edbl:i64 = harm_energy(buf, off, w, sr, f0m * 2, 4, op);
    if(ehalf > e0 + e0 / 20) { return f0m / 2; }
    if(edbl > e0 + e0 / 20) { return f0m * 2; }
    return f0m;
}

// ================= integer colorimetry ===================================
// sRGB -> CIELAB -> CIEDE2000, all integer fixed-point.
// Lab in milli-units; de2000_m returns milli-dE.

// integer cbrt: returns round(1e6 * cbrt(v/1e6)), v in 1e6 scale, v >= 0
fn cbrt_1e6(v:i64) i64 {
    if(v <= 0) { return 0; }
    let x:i64 = 1000000;
    let it:i32 = 0;
    while(it < 14) {
        let x2:i64 = x * x / 1000000;
        if(x2 <= 0) { x2 = 1; }
        x = (2 * x + v * 1000000 / x2) / 3;
        it = it + 1;
    }
    return x;
}
fn lab_f(t_1e6:i64) i64 {
    if(t_1e6 > 8856) { return cbrt_1e6(t_1e6); }
    return (7787 * t_1e6) / 1000000 + 137931;
}
// out: L,a,b milli at out[0], out[8], out[16]
fn rgb_to_lab_m(r:i64, g:i64, b:i64, lut:[]u8, out:[]u8) void {
    let rl:i64 = t_get64(lut, (r as i32) * 8);
    let gl:i64 = t_get64(lut, (g as i32) * 8);
    let bl:i64 = t_get64(lut, (b as i32) * 8);
    let x:i64 = (412456 * rl + 357576 * gl + 180437 * bl + 500000) / 1000000;
    let y:i64 = (212673 * rl + 715152 * gl + 72175 * bl + 500000) / 1000000;
    let z:i64 = (19334 * rl + 119192 * gl + 950304 * bl + 500000) / 1000000;
    let fx:i64 = lab_f(x * 1000000 / 950470);
    let fy:i64 = lab_f(y * 1000000 / 1000000);
    let fz:i64 = lab_f(z * 1000000 / 1088830);
    t_put64(out, 0, (116 * fy - 16000000) / 1000);
    t_put64(out, 8, 500 * (fx - fy) / 1000);
    t_put64(out, 16, 200 * (fy - fz) / 1000);
}
// exp(-x) in 1e6, x in 1e6, x >= 0
fn exp_neg_1e6(x:i64) i64 {
    if(x <= 0) { return 1000000; }
    let xk:i64 = x >> 6;
    let term:i64 = 1000000;
    let sum:i64 = 1000000;
    let n:i64 = 1;
    while(n <= 11) {
        term = 0 - term * xk / (n * 1000000);
        sum = sum + term;
        n = n + 1;
    }
    let i:i32 = 0;
    while(i < 6) { sum = sum * sum / 1000000; i = i + 1; }
    return sum;
}
// sqrt(v^7/(v^7+25^7)) in 1e6, v in Lab units (rounded), v >= 0
fn c7_frac_1e6(vu:i64) i64 {
    if(vu <= 0) { return 0; }
    if(vu > 250) { return 1000000; }
    let num:i64 = ipow(vu, 7);
    let den:i64 = num + 6103515625;
    let q:i64 = den / 1000000;
    if(q <= 0) { q = 1; }
    return num / q;
}
// cos of millidegrees, *1024
fn cos_mdeg(mdeg:i64) i64 {
    return ng_cos1024((mdeg * 4294967296 / 360000) & 4294967295);
}
// CIEDE2000, Lab inputs in milli-units, returns milli-dE.
fn de2000_m(l1:i64, a1:i64, b1:i64, l2:i64, a2:i64, b2:i64) i64 {
    let c1:i64 = isqrt(a1 * a1 + b1 * b1);
    let c2:i64 = isqrt(a2 * a2 + b2 * b2);
    let cb:i64 = (c1 + c2) / 2;
    let g:i64 = 500000 - isqrt(c7_frac_1e6(cb / 1000)) * 1000 / 2;
    let ap1:i64 = a1 + a1 * g / 1000000;
    let ap2:i64 = a2 + a2 * g / 1000000;
    let cp1:i64 = isqrt(ap1 * ap1 + b1 * b1);
    let cp2:i64 = isqrt(ap2 * ap2 + b2 * b2);
    let hp1:i64 = atan2_mdeg(b1, ap1);
    let hp2:i64 = atan2_mdeg(b2, ap2);
    let dl:i64 = l2 - l1;
    let dc:i64 = cp2 - cp1;
    let dh:i64 = 0;
    let dhv:i64 = 0;
    if(cp1 * cp2 != 0) {
        dh = hp2 - hp1;
        if(dh > 180000) { dh = dh - 360000; }
        if(dh < -180000) { dh = dh + 360000; }
        let sh:i64 = ng_sin1024((dh * 4294967296 / 720000) & 4294967295);
        dhv = 2 * isqrt(cp1 * cp2) * sh / 1024;
    }
    let lbp:i64 = (l1 + l2) / 2;
    let cbp:i64 = (cp1 + cp2) / 2;
    let hbp:i64 = hp1 + hp2;
    if(cp1 * cp2 != 0) {
        let ad:i64 = iabs(hp1 - hp2);
        if(ad <= 180000) { hbp = (hp1 + hp2) / 2; }
        else {
            if(hp1 + hp2 < 360000) { hbp = (hp1 + hp2 + 360000) / 2; }
            else { hbp = (hp1 + hp2 - 360000) / 2; }
        }
    }
    let t_1e6:i64 = 1000000 - 170000 * cos_mdeg(hbp - 30000) / 1024
        + 240000 * cos_mdeg(2 * hbp) / 1024
        + 320000 * cos_mdeg(3 * hbp + 6000) / 1024
        - 200000 * cos_mdeg(4 * hbp - 63000) / 1024;
    let vd:i64 = (hbp - 275000) / 25;
    let dro_1e6:i64 = 30 * exp_neg_1e6(vd * vd / 1000);
    let rc_1e6:i64 = 2 * isqrt(c7_frac_1e6(cbp / 1000)) * 1000;
    let du:i64 = (lbp - 50000) / 1000;
    let sl_1e6:i64 = 1000000 + 15000 * du * du / imax(isqrt(20 + du * du), 1);
    let cbpu:i64 = cbp / 1000;
    let sc_1e6:i64 = 1000000 + 45000 * cbpu;
    let sh_1e6:i64 = 1000000 + 15000 * cbpu * t_1e6 / 1000000;
    let tl:i64 = dl * 1000000 / sl_1e6;
    let tc:i64 = dc * 1000000 / sc_1e6;
    let th:i64 = dhv * 1000000 / sh_1e6;
    let rt_1e6:i64 = 0 - ng_sin1024((dro_1e6 * 2 * 4294967296 / 360000000) & 4294967295) * rc_1e6 / 1024;
    let cross:i64 = rt_1e6 * tc / 1000000000 * th / 1000000000;
    let de2:i64 = tl * tl + tc * tc + th * th + cross;
    if(de2 < 0) { de2 = 0; }
    return isqrt(de2);
}

// ================= shared test resolution =================================
// result codes: 0=PASS, 1=FAIL, 2=UNRESOLVED
fn resolve(t1:i32, t2d:i32, t2c:i32, t3:i32, p1:i32) i32 {
    if(t1 == 0) { return 2; }
    if(t2d == 0) { return 1; }
    if(t2c == 0) { return 2; }
    if(t3 == 0) { return 2; }
    if(p1 == 0) { return 2; }
    return 0;
}
fn res_str(r:i32) []u8 {
    if(r == 0) { return "PASS"; }
    if(r == 1) { return "FAIL"; }
    return "UNRESOLVED";
}
// confidence 0..1000 from margin m (same units as the task's measure):
// 1000*m/(m+k), k = task margin scale.
fn conf_of(m:i64, k:i64) i64 {
    if(m < 0) { m = 0 - m; }
    return 1000 * m / (m + k);
}

// ================= colordisc =============================================
// Sparse-span color-difference program. Spans: rows%16==0 (O1),
// rows%16==8 (O2), rows%16==4 (held-out PRED). dE = integer CIEDE2000.
fn task_colordisc(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8, lut:[]u8, gbuf:[]u8, gn:i32) i32 {
    let w:i64 = t_get32(buf, 0);
    let h:i64 = t_get32(buf, 4);
    if(w != 128 || h != 64) { return -1; }
    if(8 + w * h * 3 > n as i64) { return -1; }
    // sums[3 spans][2 halves][r,g,b] + cnt
    let acc:[]u8 = nio_alloc(3 * 2 * 4 * 8);
    if(acc.len == 0) { return -1; }
    let s:i32 = 0;
    while(s < 24) { t_put64(acc, s * 8, 0); s = s + 1; }
    let y:i32 = 0;
    let spans:[]u8 = nio_alloc(3);
    spans[0] = 0; spans[1] = 8; spans[2] = 4;
    let visits:i64 = 0;
    while(y < 64) {
        let m:i32 = y % 16;
        let si:i32 = -1;
        if(m == 0) { si = 0; }
        if(m == 8) { si = 1; }
        if(m == 4) { si = 2; }
        if(si >= 0) {
            let x:i32 = 0;
            while(x < 128) {
                let h2:i32 = 0;
                if(x >= 64) { h2 = 1; }
                let o:i32 = 8 + (y * 128 + x) * 3;
                let base:i32 = (si * 2 + h2) * 4;
                t_put64(acc, (base + 0) * 8, t_get64(acc, (base + 0) * 8) + (buf[o] as i64));
                t_put64(acc, (base + 1) * 8, t_get64(acc, (base + 1) * 8) + (buf[o + 1] as i64));
                t_put64(acc, (base + 2) * 8, t_get64(acc, (base + 2) * 8) + (buf[o + 2] as i64));
                t_put64(acc, (base + 3) * 8, t_get64(acc, (base + 3) * 8) + 1);
                x = x + 1;
            }
            visits = visits + 128;
        }
        y = y + 1;
    }
    op_add(op, visits);
    nio_free(spans);
    let lab:[]u8 = nio_alloc(48);
    let de:[]u8 = nio_alloc(24);
    let si2:i32 = 0;
    let t1:i32 = 1;
    while(si2 < 3) {
        let h2:i32 = 0;
        let lr:i64 = 0;
        let lg:i64 = 0;
        let lb:i64 = 0;
        while(h2 < 2) {
            let base:i32 = (si2 * 2 + h2) * 4;
            let cnt:i64 = t_get64(acc, (base + 3) * 8);
            if(cnt <= 0) { t1 = 0; }
            let mr:i64 = 0;
            let mg:i64 = 0;
            let mb:i64 = 0;
            if(cnt > 0) {
                mr = t_get64(acc, (base + 0) * 8) / cnt;
                mg = t_get64(acc, (base + 1) * 8) / cnt;
                mb = t_get64(acc, (base + 2) * 8) / cnt;
            }
            rgb_to_lab_m(mr, mg, mb, lut, lab);
            if(h2 == 0) {
                lr = t_get64(lab, 0); lg = t_get64(lab, 8); lb = t_get64(lab, 16);
            } else {
                t_put64(de, si2 * 8, de2000_m(lr, lg, lb, t_get64(lab, 0), t_get64(lab, 8), t_get64(lab, 16)));
            }
            h2 = h2 + 1;
        }
        op_add(op, 8);
        si2 = si2 + 1;
    }
    nio_free(lab);
    // combined means for the program slots (O1+O2 spans)
    let cm:[]u8 = nio_alloc(48);
    let h3:i32 = 0;
    while(h3 < 2) {
        let sr:i64 = t_get64(acc, (0 * 2 + h3) * 4 * 8) + t_get64(acc, (1 * 2 + h3) * 4 * 8);
        let sg:i64 = t_get64(acc, ((0 * 2 + h3) * 4 + 1) * 8) + t_get64(acc, ((1 * 2 + h3) * 4 + 1) * 8);
        let sb:i64 = t_get64(acc, ((0 * 2 + h3) * 4 + 2) * 8) + t_get64(acc, ((1 * 2 + h3) * 4 + 2) * 8);
        let cn:i64 = t_get64(acc, ((0 * 2 + h3) * 4 + 3) * 8) + t_get64(acc, ((1 * 2 + h3) * 4 + 3) * 8);
        if(cn > 0) {
            t_put64(cm, h3 * 24, sr / cn);
            t_put64(cm, h3 * 24 + 8, sg / cn);
            t_put64(cm, h3 * 24 + 16, sb / cn);
        }
        h3 = h3 + 1;
    }
    nio_free(acc);
    // combined dE from the combined means
    let lab3:[]u8 = nio_alloc(48);
    rgb_to_lab_m(t_get64(cm, 0), t_get64(cm, 8), t_get64(cm, 16), lut, lab3);
    let l1:i64 = t_get64(lab3, 0);
    let a1:i64 = t_get64(lab3, 8);
    let b1:i64 = t_get64(lab3, 16);
    rgb_to_lab_m(t_get64(cm, 24), t_get64(cm, 32), t_get64(cm, 40), lut, lab3);
    let decm:i64 = de2000_m(l1, a1, b1, t_get64(lab3, 0), t_get64(lab3, 8), t_get64(lab3, 16));
    nio_free(lab3);
    op_add(op, 8);
    let d0:i64 = t_get64(de, 0);
    let d1:i64 = t_get64(de, 8);
    let d2:i64 = t_get64(de, 16);
    nio_free(de);
    let hh:i64 = 0;
    if(decm >= 2300) { hh = 1; }
    let dir0:i64 = 0;
    if(d0 >= 2300) { dir0 = 1; }
    let dir1:i64 = 0;
    if(d1 >= 2300) { dir1 = 1; }
    let dir2:i64 = 0;
    if(d2 >= 2300) { dir2 = 1; }
    let t2d:i32 = 0;
    if(dir0 == hh && dir1 == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(d0 - d1) <= 600) { t2c = 1; }
    let mrg:i64 = iabs(decm - 2300);
    let t3:i32 = 0;
    if(mrg >= 400) { t3 = 1; }
    let p1:i32 = 0;
    if(dir2 == hh && iabs(d2 - decm) <= 600) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    // R2-4 independent-evidence self check on the disjoint G span
    let gev:[]u8 = nio_alloc(32);
    let sres:i32 = 2;
    let gt1:i64 = 0;
    let gag:i64 = 0;
    let gst:i64 = 0;
    let gmv:i64 = 0;
    if(gev.len != 0 && gn > 0) {
        sres = gcheck_colordisc(gbuf, gn, hh, op, lut, gev);
        gt1 = t_get64(gev, 0);
        gag = t_get64(gev, 8);
        gst = t_get64(gev, 16);
        gmv = t_get64(gev, 24);
    }
    nio_free(gev);
    let gpred:i64 = 0;
    if(sres == 0) { gpred = 1; }
    let judge:i64 = hh;
    let jstr:[]u8 = "SAME";
    if(judge == 1) { jstr = "DIFFERENT"; }
    pos = ob_kv(ob, pos, "judgment", jstr);
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 1500));
    pos = ob_kv(ob, pos, "prog", res_str(sres));
    pos = ob_kv(ob, pos, "progF", res_str(r));
    pos = ob_kint(ob, pos, "pred", gpred);
    pos = ob_kint(ob, pos, "mrgF", mrg);
    pos = ob_kint(ob, pos, "measure", (decm + 50) / 100);
    pos = ob_add(ob, pos, "program=R2-4/colordisc|S1=patchL:mean=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 0)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 8)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 16)));
    pos = ob_add(ob, pos, "|S2=patchR:mean=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 24)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 32)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 40)));
    nio_free(cm);
    pos = ob_add(ob, pos, "|O1=span(rows%16==0):dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((d0 + 50) / 100));
    pos = ob_add(ob, pos, "|O2=span(rows%16==8):dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((d1 + 50) / 100));
    pos = ob_add(ob, pos, "|R=dEcm=");
    pos = ob_add(ob, pos, _zag_i64_to_str((decm + 50) / 100));
    pos = ob_add(ob, pos, ",thr=23.0|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=span(rows%16==4):dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((d2 + 50) / 100));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|G=selfcheck:de=");
    pos = ob_add(ob, pos, _zag_i64_to_str((gmv + 50) / 100));
    pos = ob_add(ob, pos, ",t1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gt1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gag));
    pos = ob_add(ob, pos, ",strong=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gst));
    pos = ob_add(ob, pos, "|self_result=");
    pos = ob_add(ob, pos, res_str(sres));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= colorconst ============================================
// Sparse-span illumination-invariant surface program. Same spans as
// colordisc (rows%24 in {0,12,6}); per span/half: von Kries-normalized
// channel means; distance in per-mille. Threshold 150 per-mille.
fn task_colorconst(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8, lut:[]u8, gbuf:[]u8, gn:i32) i32 {
    let w:i64 = t_get32(buf, 0);
    let h:i64 = t_get32(buf, 4);
    if(w != 128 || h != 64) { return -1; }
    if(8 + w * h * 3 > n as i64) { return -1; }
    // acc: 3 spans x 2 halves x (sr,sg,sb,mr,mg,mb,cnt) i64
    let acc:[]u8 = nio_alloc(3 * 2 * 7 * 8);
    if(acc.len == 0) { return -1; }
    let s:i32 = 0;
    while(s < 42) { t_put64(acc, s * 8, 0); s = s + 1; }
    let y:i32 = 0;
    let visits:i64 = 0;
    while(y < 64) {
        let m:i32 = y % 16;
        let si:i32 = -1;
        if(m == 0) { si = 0; }
        if(m == 8) { si = 1; }
        if(m == 4) { si = 2; }
        if(si >= 0) {
            let x:i32 = 0;
            while(x < 128) {
                let hh:i32 = 0;
                if(x >= 64) { hh = 1; }
                let o:i32 = 8 + (y * 128 + x) * 3;
                let base:i32 = (si * 2 + hh) * 7;
                let r:i64 = buf[o] as i64;
                let g:i64 = buf[o + 1] as i64;
                let b:i64 = buf[o + 2] as i64;
                t_put64(acc, (base + 0) * 8, t_get64(acc, (base + 0) * 8) + r);
                t_put64(acc, (base + 1) * 8, t_get64(acc, (base + 1) * 8) + g);
                t_put64(acc, (base + 2) * 8, t_get64(acc, (base + 2) * 8) + b);
                if(r > t_get64(acc, (base + 3) * 8)) { t_put64(acc, (base + 3) * 8, r); }
                if(g > t_get64(acc, (base + 4) * 8)) { t_put64(acc, (base + 4) * 8, g); }
                if(b > t_get64(acc, (base + 5) * 8)) { t_put64(acc, (base + 5) * 8, b); }
                t_put64(acc, (base + 6) * 8, t_get64(acc, (base + 6) * 8) + 1);
                x = x + 1;
            }
            visits = visits + 128;
        }
        y = y + 1;
    }
    op_add(op, visits);
    // normalized distance per span: dist[3]
    let dist:[]u8 = nio_alloc(24);
    let si2:i32 = 0;
    let t1:i32 = 1;
    while(si2 < 3) {
        let nr:[]u8 = nio_alloc(48);
        let h2:i32 = 0;
        while(h2 < 2) {
            let base:i32 = (si2 * 2 + h2) * 7;
            let cnt:i64 = t_get64(acc, (base + 6) * 8);
            if(cnt <= 0) { t1 = 0; }
            let c:i32 = 0;
            while(c < 3) {
                let mx:i64 = t_get64(acc, (base + 3 + c) * 8);
                let nv:i64 = 0;
                if(mx > 0 && cnt > 0) {
                    nv = t_get64(acc, (base + c) * 8) * 1000 / (cnt * mx);
                }
                t_put64(nr, (h2 * 3 + c) * 8, nv);
                c = c + 1;
            }
            h2 = h2 + 1;
        }
        let dr:i64 = t_get64(nr, 0) - t_get64(nr, 24);
        let dg:i64 = t_get64(nr, 8) - t_get64(nr, 32);
        let db:i64 = t_get64(nr, 16) - t_get64(nr, 40);
        t_put64(dist, si2 * 8, isqrt(dr * dr + dg * dg + db * db));
        nio_free(nr);
        op_add(op, 8);
        si2 = si2 + 1;
    }
    // combined over spans 0+1
    let cnr:[]u8 = nio_alloc(48);
    let h3:i32 = 0;
    while(h3 < 2) {
        let c:i32 = 0;
        while(c < 3) {
            let sr:i64 = t_get64(acc, ((0 * 2 + h3) * 7 + c) * 8) + t_get64(acc, ((1 * 2 + h3) * 7 + c) * 8);
            let mx:i64 = t_get64(acc, ((0 * 2 + h3) * 7 + 3 + c) * 8);
            let mx2:i64 = t_get64(acc, ((1 * 2 + h3) * 7 + 3 + c) * 8);
            if(mx2 > mx) { mx = mx2; }
            let cnt:i64 = t_get64(acc, ((0 * 2 + h3) * 7 + 6) * 8) + t_get64(acc, ((1 * 2 + h3) * 7 + 6) * 8);
            let nv:i64 = 0;
            if(mx > 0 && cnt > 0) { nv = sr * 1000 / (cnt * mx); }
            t_put64(cnr, (h3 * 3 + c) * 8, nv);
            c = c + 1;
        }
        h3 = h3 + 1;
    }
    nio_free(acc);
    op_add(op, 8);
    let ddr:i64 = t_get64(cnr, 0) - t_get64(cnr, 24);
    let ddg:i64 = t_get64(cnr, 8) - t_get64(cnr, 32);
    let ddb:i64 = t_get64(cnr, 16) - t_get64(cnr, 40);
    let dcm:i64 = isqrt(ddr * ddr + ddg * ddg + ddb * ddb);
    let d0:i64 = t_get64(dist, 0);
    let d1:i64 = t_get64(dist, 8);
    let d2:i64 = t_get64(dist, 16);
    nio_free(dist);
    let hh:i64 = 0;
    if(dcm >= 150) { hh = 1; }
    let dir0:i64 = 0;
    if(d0 >= 150) { dir0 = 1; }
    let dir1:i64 = 0;
    if(d1 >= 150) { dir1 = 1; }
    let dir2:i64 = 0;
    if(d2 >= 150) { dir2 = 1; }
    let t2d:i32 = 0;
    if(dir0 == hh && dir1 == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(d0 - d1) <= 60) { t2c = 1; }
    let mrg:i64 = iabs(dcm - 150);
    let t3:i32 = 0;
    if(mrg >= 50) { t3 = 1; }
    let p1:i32 = 0;
    if(dir2 == hh && iabs(d2 - dcm) <= 60) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    // R2-4 independent-evidence self check on the disjoint G span
    let gev:[]u8 = nio_alloc(32);
    let sres:i32 = 2;
    let gt1:i64 = 0;
    let gag:i64 = 0;
    let gst:i64 = 0;
    let gmv:i64 = 0;
    if(gev.len != 0 && gn > 0) {
        sres = gcheck_colorconst(gbuf, gn, hh, op, gev);
        gt1 = t_get64(gev, 0);
        gag = t_get64(gev, 8);
        gst = t_get64(gev, 16);
        gmv = t_get64(gev, 24);
    }
    nio_free(gev);
    let gpred:i64 = 0;
    if(sres == 0) { gpred = 1; }
    let judge:i64 = hh;
    let jstr:[]u8 = "SAME_SURFACE";
    if(judge == 1) { jstr = "DIFFERENT"; }
    pos = ob_kv(ob, pos, "judgment", jstr);
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 150));
    pos = ob_kv(ob, pos, "prog", res_str(sres));
    pos = ob_kv(ob, pos, "progF", res_str(r));
    pos = ob_kint(ob, pos, "pred", gpred);
    pos = ob_kint(ob, pos, "mrgF", mrg);
    pos = ob_kint(ob, pos, "measure", dcm);
    pos = ob_add(ob, pos, "program=R2-4/colorconst|S1=surfL:norm=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 0)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 8)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 16)));
    pos = ob_add(ob, pos, "|S2=surfR:norm=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 24)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 32)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 40)));
    nio_free(cnr);
    pos = ob_add(ob, pos, "|O1=span(rows%16==0):dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d0));
    pos = ob_add(ob, pos, "|O2=span(rows%16==8):dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d1));
    pos = ob_add(ob, pos, "|R=distcm=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dcm));
    pos = ob_add(ob, pos, ",thr=150|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=span(rows%16==4):dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d2));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|G=selfcheck:dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gmv));
    pos = ob_add(ob, pos, ",t1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gt1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gag));
    pos = ob_add(ob, pos, ",strong=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gst));
    pos = ob_add(ob, pos, "|self_result=");
    pos = ob_add(ob, pos, res_str(sres));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= shapetrans ============================================
// Sparse-grid shape program. Grids: (x+y)%12==0 (O1), ==6 (O2), ==3
// (held-out PRED). Foreground = bright minority (lum>382). Combined
// centroid from O1+O2; window-refined max radius around the grid max-d2
// point; ratio = area/(pi*R^2) vs calibrated prototypes 974/684/464
// (calibrated on frozen primary; theoretical 1000/637/414). Cost ~18%
// of Approach A.
// out: r1@0, r2@8, r3@16, a1@24, a2@32, a3@40, maxd2@48, cx@56, cy@64
fn shape_measure(buf:[]u8, op:[]u8, out:[]u8) void {
    let bcs:[]u8 = nio_alloc(24);
    let ngs:[]u8 = nio_alloc(24);
    let fgs:[]u8 = nio_alloc(24);
    let sxs:[]u8 = nio_alloc(24);
    let sys:[]u8 = nio_alloc(24);
    let gi:i32 = 0;
    while(gi < 3) {
        let rem:i32 = 0;
        if(gi == 1) { rem = 6; }
        if(gi == 2) { rem = 3; }
        let bc:i64 = 0;
        let ng:i64 = 0;
        let y:i32 = 0;
        while(y < 96) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    ng = ng + 1;
                    if(lum > 382) { bc = bc + 1; }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        op_add(op, ng);
        t_put64(bcs, gi * 8, bc);
        t_put64(ngs, gi * 8, ng);
        gi = gi + 1;
    }
    let bc12:i64 = t_get64(bcs, 0) + t_get64(bcs, 8);
    let ng12:i64 = t_get64(ngs, 0) + t_get64(ngs, 8);
    let fgbright:i32 = 0;
    if(2 * bc12 <= ng12) { fgbright = 1; }
    gi = 0;
    while(gi < 3) {
        let rem:i32 = 0;
        if(gi == 1) { rem = 6; }
        if(gi == 2) { rem = 3; }
        let fg:i64 = 0;
        let sx:i64 = 0;
        let sy:i64 = 0;
        let y:i32 = 0;
        while(y < 96) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    let bright:i32 = 0;
                    if(lum > 382) { bright = 1; }
                    if(bright == fgbright) { fg = fg + 1; sx = sx + (x as i64); sy = sy + (y as i64); }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        op_add(op, t_get64(ngs, gi * 8));
        t_put64(fgs, gi * 8, fg);
        t_put64(sxs, gi * 8, sx);
        t_put64(sys, gi * 8, sy);
        gi = gi + 1;
    }
    let fg12:i64 = t_get64(fgs, 0) + t_get64(fgs, 8);
    let cx:i64 = 48;
    let cy:i64 = 48;
    if(fg12 > 0) {
        cx = (t_get64(sxs, 0) + t_get64(sxs, 8)) / fg12;
        cy = (t_get64(sys, 0) + t_get64(sys, 8)) / fg12;
    }
    let px:i32 = 48;
    let py:i32 = 48;
    let best:i64 = -1;
    gi = 0;
    while(gi < 2) {
        let rem:i32 = 0;
        if(gi == 1) { rem = 6; }
        let y:i32 = 0;
        while(y < 96) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    let bright:i32 = 0;
                    if(lum > 382) { bright = 1; }
                    if(bright == fgbright) {
                        let dx:i64 = (x as i64) - cx;
                        let dy:i64 = (y as i64) - cy;
                        let d2:i64 = dx * dx + dy * dy;
                        if(d2 > best) { best = d2; px = x; py = y; }
                    }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        op_add(op, t_get64(ngs, gi * 8));
        gi = gi + 1;
    }
    let maxd2:i64 = best;
    if(maxd2 < 0) { maxd2 = 0; }
    let wy:i32 = py - 10;
    if(wy < 0) { wy = 0; }
    let wy1:i32 = py + 10;
    if(wy1 > 95) { wy1 = 95; }
    let wvis:i64 = 0;
    while(wy <= wy1) {
        let wx:i32 = px - 10;
        if(wx < 0) { wx = 0; }
        let wx1:i32 = px + 10;
        if(wx1 > 95) { wx1 = 95; }
        while(wx <= wx1) {
            let o:i32 = 8 + (wy * 96 + wx) * 3;
            let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
            let bright:i32 = 0;
            if(lum > 382) { bright = 1; }
            if(bright == fgbright) {
                let dx:i64 = (wx as i64) - cx;
                let dy:i64 = (wy as i64) - cy;
                let d2:i64 = dx * dx + dy * dy;
                if(d2 > maxd2) { maxd2 = d2; }
            }
            wvis = wvis + 1;
            wx = wx + 1;
        }
        wy = wy + 1;
    }
    op_add(op, wvis);
    gi = 0;
    while(gi < 3) {
        let fg:i64 = t_get64(fgs, gi * 8);
        let ng:i64 = t_get64(ngs, gi * 8);
        let a:i64 = 0;
        if(ng > 0) { a = fg * 9216 / ng; }
        let r:i64 = 0;
        if(maxd2 > 0) { r = a * 1000000 / (3142 * maxd2); }
        t_put64(out, gi * 8, r);
        t_put64(out, 24 + gi * 8, a);
        gi = gi + 1;
    }
    t_put64(out, 48, maxd2);
    t_put64(out, 56, cx);
    t_put64(out, 64, cy);
    nio_free(bcs);
    nio_free(ngs);
    nio_free(fgs);
    nio_free(sxs);
    nio_free(sys);
}
fn shape_class(r:i64) i64 {
    let d0:i64 = iabs(r - 974);
    let d1:i64 = iabs(r - 684);
    let d2:i64 = iabs(r - 464);
    if(d0 <= d1 && d0 <= d2) { return 0; }
    if(d1 <= d2) { return 1; }
    return 2;
}
fn shape_margin(r:i64, cls:i64) i64 {
    let d0:i64 = iabs(r - 974);
    let d1:i64 = iabs(r - 684);
    let d2:i64 = iabs(r - 464);
    if(cls == 0) {
        if(d1 < d2) { return d1 - d0; }
        return d2 - d0;
    }
    if(cls == 1) {
        if(d0 < d2) { return d0 - d1; }
        return d2 - d1;
    }
    if(d0 < d1) { return d0 - d2; }
    return d1 - d2;
}
fn shape_runner(r:i64, cls:i64) i64 {
    let d0:i64 = iabs(r - 974);
    let d1:i64 = iabs(r - 684);
    let d2:i64 = iabs(r - 464);
    if(cls == 0) {
        if(d1 <= d2) { return 1; }
        return 2;
    }
    if(cls == 1) {
        if(d0 <= d2) { return 0; }
        return 2;
    }
    if(d0 <= d1) { return 0; }
    return 1;
}
fn shape_name(c:i64) []u8 {
    if(c == 0) { return "CIRCLE"; }
    if(c == 1) { return "SQUARE"; }
    return "TRIANGLE";
}
fn task_shapetrans(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8, gbuf:[]u8, gn:i32) i32 {
    if(t_get32(buf, 0) != 96 || t_get32(buf, 4) != 96) { return -1; }
    if(8 + 96 * 96 * 3 > n as i64) { return -1; }
    let m:[]u8 = nio_alloc(72);
    shape_measure(buf, op, m);
    let rA:i64 = t_get64(m, 0);
    let rB:i64 = t_get64(m, 8);
    let rP:i64 = t_get64(m, 16);
    let aA:i64 = t_get64(m, 24);
    let aB:i64 = t_get64(m, 32);
    let aP:i64 = t_get64(m, 40);
    nio_free(m);
    op_add(op, 8);
    let ravg:i64 = (rA + rB) / 2;
    let hh:i64 = shape_class(ravg);
    let cA:i64 = shape_class(rA);
    let cB:i64 = shape_class(rB);
    let cP:i64 = shape_class(rP);
    let t1:i32 = 0;
    if(aA + aB >= 8 && aP >= 4) { t1 = 1; }
    let t2d:i32 = 0;
    if(cA == hh && cB == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(rA - rB) <= 120) { t2c = 1; }
    let mrg:i64 = shape_margin(ravg, hh);
    let t3:i32 = 0;
    if(mrg >= 60) { t3 = 1; }
    let p1:i32 = 0;
    if(cP == hh && iabs(rP - ravg) <= 120) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    // R2-4 independent-evidence self check on the disjoint G span
    let gev:[]u8 = nio_alloc(32);
    let sres:i32 = 2;
    let gt1:i64 = 0;
    let gag:i64 = 0;
    let gst:i64 = 0;
    let gmv:i64 = 0;
    if(gev.len != 0 && gn > 0) {
        sres = gcheck_shape(gbuf, gn, hh, op, gev);
        gt1 = t_get64(gev, 0);
        gag = t_get64(gev, 8);
        gst = t_get64(gev, 16);
        gmv = t_get64(gev, 24);
    }
    nio_free(gev);
    let gpred:i64 = 0;
    if(sres == 0) { gpred = 1; }
    let judge:i64 = hh;
    // R2-4: no runner-up flip; judgment stays the F verdict
    pos = ob_kv(ob, pos, "judgment", shape_name(judge));
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 200));
    pos = ob_kv(ob, pos, "prog", res_str(sres));
    pos = ob_kv(ob, pos, "progF", res_str(r));
    pos = ob_kint(ob, pos, "pred", gpred);
    pos = ob_kint(ob, pos, "mrgF", mrg);
    pos = ob_kint(ob, pos, "measure", ravg);
    pos = ob_add(ob, pos, "program=R2-4/shapetrans|S1=shape:bbox=0,0,96,96");
    pos = ob_add(ob, pos, "|O1=grid((x+y)%12==0):ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(rA));
    pos = ob_add(ob, pos, ",area=");
    pos = ob_add(ob, pos, _zag_i64_to_str(aA));
    pos = ob_add(ob, pos, "|O2=grid((x+y)%12==6):ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(rB));
    pos = ob_add(ob, pos, ",area=");
    pos = ob_add(ob, pos, _zag_i64_to_str(aB));
    pos = ob_add(ob, pos, "|R=ratioavg=");
    pos = ob_add(ob, pos, _zag_i64_to_str(ravg));
    pos = ob_add(ob, pos, ",proto=c974/s684/t464|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=grid((x+y)%12==3):ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(rP));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|G=selfcheck:mrg=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gmv));
    pos = ob_add(ob, pos, ",t1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gt1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gag));
    pos = ob_add(ob, pos, ",strong=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gst));
    pos = ob_add(ob, pos, "|self_result=");
    pos = ob_add(ob, pos, res_str(sres));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= motiondir =============================================
// Sparse-grid motion program. Grids: (x+y)%20 in {0 (O1), 10 (O2), 5
// (held-out PRED)}. Per grid: frame-diff centroid track over t=1..7,
// displacement from first to last moved-centroid. ~34% of Approach A.
fn dir_of(dx:i64, dy:i64) i64 {
    let ax:i64 = iabs(dx);
    let ay:i64 = iabs(dy);
    let mag2:i64 = dx * dx + dy * dy;
    if(mag2 < 9) { return 0; }
    if(ax > 2 * ay) {
        if(dx > 0) { return 3; }
        return 7;
    }
    if(ay > 2 * ax) {
        if(dy > 0) { return 5; }
        return 1;
    }
    if(dx > 0 && dy < 0) { return 2; }
    if(dx > 0 && dy > 0) { return 4; }
    if(dx < 0 && dy > 0) { return 6; }
    return 8;
}
fn dir_name(d:i64) []u8 {
    if(d == 0) { return "STILL"; }
    if(d == 1) { return "N"; }
    if(d == 2) { return "NE"; }
    if(d == 3) { return "E"; }
    if(d == 4) { return "SE"; }
    if(d == 5) { return "S"; }
    if(d == 6) { return "SW"; }
    if(d == 7) { return "W"; }
    return "NW";
}
// dout: dx@0, dy@8, dir@16, have@24, mag@32
// 1D projection profile motion: col profile (sum over sparse rows) gives
// dx via SSD shift; row profile (sum over sparse cols) gives dy.
// Frames f1->f2; row_step/row_off select the row subset for the col
// profile, col_step/col_off the col subset for the row profile.
fn profile_motion(buf:[]u8, row_step:i32, row_off:i32, col_step:i32, col_off:i32, f1:i32, f2:i32, op:[]u8, dout:[]u8) void {
    let fsz:i64 = 12288;
    let c0:[]u8 = nio_alloc(512);
    let c1:[]u8 = nio_alloc(512);
    let r0:[]u8 = nio_alloc(512);
    let r1:[]u8 = nio_alloc(512);
    let i:i32 = 0;
    while(i < 64) {
        t_put64(c0, i * 8, 0);
        t_put64(c1, i * 8, 0);
        t_put64(r0, i * 8, 0);
        t_put64(r1, i * 8, 0);
        i = i + 1;
    }
    // col profiles: for each x, sum intensity over sparse rows
    let f:i32 = 0;
    while(f < 2) {
        let fr:i32 = f1;
        if(f == 1) { fr = f2; }
        let cp:[]u8 = c0;
        let rp:[]u8 = r0;
        if(f == 1) { cp = c1; rp = r1; }
        let y:i32 = 0;
        while(y < 64) {
            if(y % row_step == row_off) {
                let x:i32 = 0;
                while(x < 64) {
                    let o:i32 = (12 + (fr as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let inten:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    t_put64(cp, x * 8, t_get64(cp, x * 8) + inten);
                    x = x + 1;
                    op_add(op, 1);
                }
            }
            y = y + 1;
        }
        // row profiles: for each y, sum intensity over sparse cols
        y = 0;
        while(y < 64) {
            let x:i32 = 0;
            while(x < 64) {
                if(x % col_step == col_off) {
                    let o:i32 = (12 + (fr as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let inten:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    t_put64(rp, y * 8, t_get64(rp, y * 8) + inten);
                    op_add(op, 1);
                }
                x = x + 1;
            }
            y = y + 1;
        }
        f = f + 1;
    }
    // SSD shift for dx (col profiles)
    let best_dx:i64 = 0;
    let best_e:i64 = 9223372036854775807;
    let s:i32 = -8;
    while(s <= 8) {
        let e:i64 = 0;
        let x:i32 = 8;
        while(x < 56) {
            let x2:i32 = x + s;
            if(x2 >= 0 && x2 < 64) {
                let d:i64 = t_get64(c0, x * 8) - t_get64(c1, x2 * 8);
                e = e + d * d;
            }
            x = x + 1;
            op_add(op, 1);
        }
        if(e < best_e) { best_e = e; best_dx = s as i64; }
        s = s + 1;
    }
    // SSD shift for dy (row profiles)
    let best_dy:i64 = 0;
    best_e = 9223372036854775807;
    s = -8;
    while(s <= 8) {
        let e:i64 = 0;
        let y:i32 = 8;
        while(y < 56) {
            let y2:i32 = y + s;
            if(y2 >= 0 && y2 < 64) {
                let d:i64 = t_get64(r0, y * 8) - t_get64(r1, y2 * 8);
                e = e + d * d;
            }
            y = y + 1;
            op_add(op, 1);
        }
        if(e < best_e) { best_e = e; best_dy = s as i64; }
        s = s + 1;
    }
    nio_free(c0);
    nio_free(c1);
    nio_free(r0);
    nio_free(r1);
    t_put64(dout, 0, best_dx);
    t_put64(dout, 8, best_dy);
    t_put64(dout, 16, dir_of(best_dx, best_dy));
    t_put64(dout, 24, 1);
    t_put64(dout, 32, isqrt(best_dx * best_dx + best_dy * best_dy));
}

fn grid_motion(buf:[]u8, modv:i32, rem:i32, op:[]u8, dout:[]u8) void {
    let fsz:i64 = 12288;
    let fx:i64 = 0;
    let fy:i64 = 0;
    let lx:i64 = 0;
    let ly:i64 = 0;
    let have:i32 = 0;
    let visits:i64 = 0;
    let t:i32 = 1;
    while(t < 8) {
        let sx:i64 = 0;
        let sy:i64 = 0;
        let mc:i64 = 0;
        let y:i32 = 0;
        while(y < 64) {
            let x:i32 = 0;
            while(x < 64) {
                if((x + y) % modv == rem) {
                    let o0:i32 = (12 + ((t - 1) as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let o1:i32 = (12 + (t as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let dd:i64 = iabs((buf[o1] as i64) - (buf[o0] as i64))
                               + iabs((buf[o1 + 1] as i64) - (buf[o0 + 1] as i64))
                               + iabs((buf[o1 + 2] as i64) - (buf[o0 + 2] as i64));
                    if(dd > 90) {
                        mc = mc + 1;
                        sx = sx + (x as i64);
                        sy = sy + (y as i64);
                    }
                    visits = visits + 1;
                }
                x = x + 1;
            }
            y = y + 1;
        }
        if(mc > 0) {
            let cx:i64 = sx / mc;
            let cy:i64 = sy / mc;
            if(have == 0) { fx = cx; fy = cy; have = 1; }
            lx = cx;
            ly = cy;
        }
        t = t + 1;
    }
    op_add(op, visits);
    let dx:i64 = lx - fx;
    let dy:i64 = ly - fy;
    t_put64(dout, 0, dx);
    t_put64(dout, 8, dy);
    t_put64(dout, 16, dir_of(dx, dy));
    t_put64(dout, 24, have as i64);
    t_put64(dout, 32, isqrt(dx * dx + dy * dy));
}
fn task_motiondir(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8, gbuf:[]u8, gn:i32) i32 {
    if(t_get32(buf, 0) != 8 || t_get32(buf, 4) != 64 || t_get32(buf, 8) != 64) { return -1; }
    if(12 + 8 * 12288 > n as i64) { return -1; }
    let da:[]u8 = nio_alloc(40);
    let db:[]u8 = nio_alloc(40);
    let dp:[]u8 = nio_alloc(40);
    // O1/O2/P: disjoint row/col subsets (offsets 0/4/2 mod 8), frames 0->3.
    profile_motion(buf, 8, 0, 8, 0, 0, 3, op, da);
    profile_motion(buf, 8, 4, 8, 4, 0, 3, op, db);
    profile_motion(buf, 8, 2, 8, 2, 0, 3, op, dp);
    let dxA:i64 = t_get64(da, 0);
    let dyA:i64 = t_get64(da, 8);
    let dA:i64 = t_get64(da, 16);
    let hA:i64 = t_get64(da, 24);
    let dxB:i64 = t_get64(db, 0);
    let dyB:i64 = t_get64(db, 8);
    let dB:i64 = t_get64(db, 16);
    let hB:i64 = t_get64(db, 24);
    let dxP:i64 = t_get64(dp, 0);
    let dyP:i64 = t_get64(dp, 8);
    let dP:i64 = t_get64(dp, 16);
    nio_free(da);
    nio_free(db);
    nio_free(dp);
    op_add(op, 8);
    let dxc:i64 = (dxA + dxB) / 2;
    let dyc:i64 = (dyA + dyB) / 2;
    let mag:i64 = isqrt(dxc * dxc + dyc * dyc);
    let hh:i64 = dir_of(dxc, dyc);
    let t1:i32 = 0;
    if((hA == 1 && hB == 1) || hh == 0) { t1 = 1; }
    let t2d:i32 = 0;
    if(dA == hh && dB == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(dxA - dxB) <= 4 && iabs(dyA - dyB) <= 4) { t2c = 1; }
    let mrg:i64 = iabs(mag - 3);
    let t3:i32 = 0;
    if(mrg >= 2) { t3 = 1; }
    let p1:i32 = 0;
    if(dP == hh && iabs(dxP - dxc) <= 4 && iabs(dyP - dyc) <= 4) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    // R2-4 independent-evidence self check on the disjoint G span
    let gev:[]u8 = nio_alloc(32);
    let sres:i32 = 2;
    let gt1:i64 = 0;
    let gag:i64 = 0;
    let gst:i64 = 0;
    let gmv:i64 = 0;
    if(gev.len != 0 && gn > 0) {
        sres = gcheck_motion(gbuf, gn, hh, op, gev);
        gt1 = t_get64(gev, 0);
        gag = t_get64(gev, 8);
        gst = t_get64(gev, 16);
        gmv = t_get64(gev, 24);
    }
    nio_free(gev);
    let gpred:i64 = 0;
    if(sres == 0) { gpred = 1; }
    let judge:i64 = hh;  // R2-4: no span-vote override; judgment stays the F verdict
    pos = ob_kv(ob, pos, "judgment", dir_name(judge));
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 4));
    pos = ob_kv(ob, pos, "prog", res_str(sres));
    pos = ob_kv(ob, pos, "progF", res_str(r));
    pos = ob_kint(ob, pos, "pred", gpred);
    pos = ob_kint(ob, pos, "mrgF", mrg);
    pos = ob_kint(ob, pos, "measure", hh);
    pos = ob_add(ob, pos, "program=R2-4/motiondir|S1=prof1d:f0->f3");
    pos = ob_add(ob, pos, "|O1=prof1d(rows%8==0):dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dxA));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dyA));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, dir_name(dA));
    pos = ob_add(ob, pos, "|O2=prof1d(rows%8==4):dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dxB));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dyB));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, dir_name(dB));
    pos = ob_add(ob, pos, "|R=dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dxc));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dyc));
    pos = ob_add(ob, pos, ",mag=");
    pos = ob_add(ob, pos, _zag_i64_to_str(mag));
    pos = ob_add(ob, pos, "|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=prof1d(rows%8==2):dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dxP));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dyP));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, dir_name(dP));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|G=selfcheck:mag=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gmv));
    pos = ob_add(ob, pos, ",t1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gt1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gag));
    pos = ob_add(ob, pos, ",strong=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gst));
    pos = ob_add(ob, pos, "|self_result=");
    pos = ob_add(ob, pos, res_str(sres));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= pitchdisc =============================================
// Sparse pitch program: combined f0 per tone via f0_h2 (autocorr + narrow
// harmonic grid), then per-tone check-windows at +800/+3000 (O1,O2) and
// +5000 (held-out PRED): the tone's own f0 must explain its window better
// than the other tone's f0 (>=10%). ~34% of Approach A.
fn pitch_runner(d:i64, fA:i64, fB:i64, hh:i64) i64 {
    let s_same:i64 = 5000 - d;
    let s_hi:i64 = -999999999;
    let s_lo:i64 = -999999999;
    if(fB > fA) { s_hi = d - 5000; }
    if(fB < fA) { s_lo = d - 5000; }
    let best:i64 = 0;
    let bs:i64 = -9999999999;
    if(hh != 0 && s_same > bs) { best = 0; bs = s_same; }
    if(hh != 1 && s_hi > bs) { best = 1; bs = s_hi; }
    if(hh != 2 && s_lo > bs) { best = 2; bs = s_lo; }
    return best;
}
fn pitch_name(c:i64) []u8 {
    if(c == 0) { return "SAME"; }
    if(c == 1) { return "HIGHER"; }
    return "LOWER";
}
// one window check: tone's own f0 vs the other tone's f0. Returns 1 if the
// evidence favors H.
fn pitch_win(buf:[]u8, woff:i32, sr:i64, fT:i64, fO:i64, hh:i64, op:[]u8) i32 {
    let e_own:i64 = harm_energy(buf, woff, 768, sr, fT, 6, op);
    let e_oth:i64 = harm_energy(buf, woff, 768, sr, fO, 6, op);
    if(hh != 0) {
        if(e_own * 10 > e_oth * 11) { return 1; }
        return 0;
    }
    if(iabs(e_own - e_oth) * 10 <= e_own) { return 1; }
    return 0;
}
fn task_pitchdisc(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8, gbuf:[]u8, gn:i32) i32 {
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let tone:i32 = (cnt * 10 / 22) as i32;
    let gap:i32 = cnt - 2 * tone;
    if(tone < 6024 || gap < 0) { return -1; }
    let aoff:i32 = 8;
    let boff:i32 = 8 + (tone + gap) * 2;
    let fA:i64 = f0_h2(buf, aoff, tone, sr, op);
    let fB:i64 = f0_h2(buf, boff, tone, sr, op);
    let t1:i32 = 0;
    if(fA > 0 && fB > 0) { t1 = 1; }
    let d:i64 = 0;
    if(t1 == 1) {
        let mx:i64 = fA;
        if(fB > mx) { mx = fB; }
        d = iabs(fB - fA) * 1000000 / mx;
    }
    let hh:i64 = 0;
    if(t1 == 1 && d >= 5000) {
        if(fB > fA) { hh = 1; } else { hh = 2; }
    }
    // check windows (byte offsets)
    let aw1:i32 = aoff + 800 * 2;
    let aw2:i32 = aoff + 3000 * 2;
    let aw3:i32 = aoff + 5000 * 2;
    let bw1:i32 = boff + 800 * 2;
    let bw2:i32 = boff + 3000 * 2;
    let bw3:i32 = boff + 5000 * 2;
    let t2d:i32 = 0;
    if(t1 == 1) {
        let c:i32 = pitch_win(buf, aw1, sr, fA, fB, hh, op);
        c = c + pitch_win(buf, aw2, sr, fA, fB, hh, op);
        c = c + pitch_win(buf, bw1, sr, fB, fA, hh, op);
        c = c + pitch_win(buf, bw2, sr, fB, fA, hh, op);
        if(c == 4) { t2d = 1; }
    }
    let t2c:i32 = 1;
    let mrg:i64 = iabs(d - 5000);
    let t3:i32 = 0;
    if(mrg >= 1500) { t3 = 1; }
    let p1:i32 = 0;
    if(t1 == 1) {
        let c:i32 = pitch_win(buf, aw3, sr, fA, fB, hh, op);
        c = c + pitch_win(buf, bw3, sr, fB, fA, hh, op);
        if(c == 2) { p1 = 1; }
    }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    // R2-4 independent-evidence self check on the disjoint G span
    let gev:[]u8 = nio_alloc(32);
    let sres:i32 = 2;
    let gt1:i64 = 0;
    let gag:i64 = 0;
    let gst:i64 = 0;
    let gmv:i64 = 0;
    if(gev.len != 0 && gn > 0) {
        sres = gcheck_pitch(gbuf, gn, fA, fB, hh, sr, op, gev);
        gt1 = t_get64(gev, 0);
        gag = t_get64(gev, 8);
        gst = t_get64(gev, 16);
        gmv = t_get64(gev, 24);
    }
    nio_free(gev);
    let gpred:i64 = 0;
    if(sres == 0) { gpred = 1; }
    let judge:i64 = hh;
    // R2-4: no runner-up flip; judgment stays the F verdict
    pos = ob_kv(ob, pos, "judgment", pitch_name(judge));
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 3000));
    pos = ob_kv(ob, pos, "prog", res_str(sres));
    pos = ob_kv(ob, pos, "progF", res_str(r));
    pos = ob_kint(ob, pos, "pred", gpred);
    pos = ob_kint(ob, pos, "mrgF", mrg);
    pos = ob_kint(ob, pos, "measure", d);
    pos = ob_add(ob, pos, "program=R2-4/pitchdisc|S1=toneA|S2=toneB");
    pos = ob_add(ob, pos, "|O1=w+800:fA=");
    pos = ob_add(ob, pos, _zag_i64_to_str(fA));
    pos = ob_add(ob, pos, ",fB=");
    pos = ob_add(ob, pos, _zag_i64_to_str(fB));
    pos = ob_add(ob, pos, "|O2=w+3000:fA=");
    pos = ob_add(ob, pos, _zag_i64_to_str(fA));
    pos = ob_add(ob, pos, ",fB=");
    pos = ob_add(ob, pos, _zag_i64_to_str(fB));
    pos = ob_add(ob, pos, "|R=dppm=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d));
    pos = ob_add(ob, pos, ",thr=5000|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=w+5000:agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|G=selfcheck:mratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gmv));
    pos = ob_add(ob, pos, ",t1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gt1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gag));
    pos = ob_add(ob, pos, ",strong=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gst));
    pos = ob_add(ob, pos, "|self_result=");
    pos = ob_add(ob, pos, res_str(sres));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= timbredisc ============================================
// Sparse timbre program: f0 via f0_h2, spectral centroid (8 harmonics,
// short windows) at w=2048 (combined), w=1024 thirds 1,2 (O1,O2),
// third 3 (held-out PRED). Classes PURE/DARK/RICH/BRIGHT at 1075/1400/3000.
// Harmonic spectral centroid, per-mille: r = 1000 * sum(h * E_h) / sum(E_h)
// over the harmonics below Nyquist. Same scale and boundaries as Approach A
// (PURE<1075, DARK<1400, RICH<3000, BRIGHT). All measurements come from the
// sparse windows only (O1/O2 thirds + combined + held-out third).
fn spec_centroid_h2(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, op:[]u8) i64 {
    if(f0m <= 0) { return -1; }
    let se:i64 = 0;
    let she:i64 = 0;
    let h:i64 = 1;
    while(h <= 8) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let e:i64 = harm_energy(buf, off, w, sr, h * f0m, 1, op);
        se = se + e;
        she = she + e * h;
        h = h + 1;
    }
    if(se <= 0) { return -1; }
    return 1000 * she / se;
}
fn timbre_class(r:i64) i64 {
    if(r < 1075) { return 0; }
    if(r < 1400) { return 1; }
    if(r < 3000) { return 2; }
    return 3;
}
fn timbre_margin(r:i64, cls:i64) i64 {
    if(cls == 0) { return 1075 - r; }
    if(cls == 1) {
        let a:i64 = r - 1075;
        let b:i64 = 1400 - r;
        if(a < b) { return a; }
        return b;
    }
    if(cls == 2) {
        let a:i64 = r - 1400;
        let b:i64 = 3000 - r;
        if(a < b) { return a; }
        return b;
    }
    return r - 3000;
}
fn timbre_runner(r:i64, cls:i64) i64 {
    let d0:i64 = 0;
    if(r >= 1075) { d0 = r - 1075; }
    let d1a:i64 = iabs(r - 1075);
    let d1b:i64 = iabs(r - 1400);
    let d1:i64 = d1a;
    if(d1b < d1a) { d1 = d1b; }
    let d2a:i64 = iabs(r - 1400);
    let d2b:i64 = iabs(r - 3000);
    let d2:i64 = d2a;
    if(d2b < d2a) { d2 = d2b; }
    let d3:i64 = 0;
    if(r <= 3000) { d3 = 3000 - r; }
    let best:i64 = 0;
    let bd:i64 = 9999999999;
    if(cls != 0 && d0 < bd) { best = 0; bd = d0; }
    if(cls != 1 && d1 < bd) { best = 1; bd = d1; }
    if(cls != 2 && d2 < bd) { best = 2; bd = d2; }
    if(cls != 3 && d3 < bd) { best = 3; bd = d3; }
    return best;
}
fn timbre_name(c:i64) []u8 {
    if(c == 0) { return "PURE"; }
    if(c == 1) { return "DARK"; }
    if(c == 2) { return "RICH"; }
    return "BRIGHT";
}
fn task_timbredisc(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8, gbuf:[]u8, gn:i32) i32 {
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let f0:i64 = f0_h2(buf, 8, cnt, sr, op);
    let t1:i32 = 0;
    if(f0 >= 50000 && f0 <= 2000000) { t1 = 1; }
    let r12:i64 = spec_centroid_h2(buf, 8, 2048, sr, f0, op);
    let r1:i64 = spec_centroid_h2(buf, 8, 1024, sr, f0, op);
    let r2:i64 = spec_centroid_h2(buf, 8 + (cnt / 3) * 2, 1024, sr, f0, op);
    let r3:i64 = spec_centroid_h2(buf, 8 + (2 * cnt / 3) * 2, 1024, sr, f0, op);
    if(r12 < 0 || r1 < 0 || r2 < 0 || r3 < 0) { t1 = 0; }
    let hh:i64 = 0;
    if(t1 == 1) { hh = timbre_class(r12); }
    let t2d:i32 = 0;
    if(t1 == 1 && timbre_class(r1) == hh && timbre_class(r2) == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(r1 - r2) <= 150) { t2c = 1; }
    let mrg:i64 = 0;
    if(t1 == 1) { mrg = timbre_margin(r12, hh); }
    let t3:i32 = 0;
    if(mrg >= 80) { t3 = 1; }
    let p1:i32 = 0;
    if(t1 == 1 && timbre_class(r3) == hh && iabs(r3 - r12) <= 150) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    // R2-4 independent-evidence self check on the disjoint G span
    let gev:[]u8 = nio_alloc(32);
    let sres:i32 = 2;
    let gt1:i64 = 0;
    let gag:i64 = 0;
    let gst:i64 = 0;
    let gmv:i64 = 0;
    if(gev.len != 0 && gn > 0) {
        sres = gcheck_timbre(gbuf, gn, f0, hh, sr, op, gev);
        gt1 = t_get64(gev, 0);
        gag = t_get64(gev, 8);
        gst = t_get64(gev, 16);
        gmv = t_get64(gev, 24);
    }
    nio_free(gev);
    let gpred:i64 = 0;
    if(sres == 0) { gpred = 1; }
    let judge:i64 = hh;
    // R2-4: no runner-up flip; judgment stays the F verdict
    pos = ob_kv(ob, pos, "judgment", timbre_name(judge));
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 150));
    pos = ob_kv(ob, pos, "prog", res_str(sres));
    pos = ob_kv(ob, pos, "progF", res_str(r));
    pos = ob_kint(ob, pos, "pred", gpred);
    pos = ob_kint(ob, pos, "mrgF", mrg);
    pos = ob_kint(ob, pos, "measure", r12);
    pos = ob_add(ob, pos, "program=R2-4/timbredisc|S1=tone:f0=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0));
    pos = ob_add(ob, pos, "|O1=third1:cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r1));
    pos = ob_add(ob, pos, "|O2=third2:cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r2));
    pos = ob_add(ob, pos, "|R=cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r12));
    pos = ob_add(ob, pos, ",bounds=1075/1400/3000|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=third3:cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r3));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|G=selfcheck:cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gmv));
    pos = ob_add(ob, pos, ",t1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gt1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gag));
    pos = ob_add(ob, pos, ",strong=");
    pos = ob_add(ob, pos, _zag_i64_to_str(gst));
    pos = ob_add(ob, pos, "|self_result=");
    pos = ob_add(ob, pos, res_str(sres));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= main ====================================================

// ================= V2-C vknow: structural trap detectors =====================
// PREREG_V2-C_AMEND1.md §A1.3. Pure functions of the F span. Zero RNG.
// Bit assignments (frozen):
//   bit0  (1)    D1  GLIDE        pitchdisc   PTC-2
//   bit1  (2)    D2  HARMINC      pitchdisc   PTC-3 / red-team
//   bit2  (4)    D3  CCN1-TEXCORR colorconst  CCN-1
//   bit3  (8)    D3b CCN1-THR     colorconst  CCN-1 (sim form, fixed dims)
//   bit4  (16)   D4  COL2-TEXCORR colordisc   COL-2
//   bit5  (32)   D5  CCN2-MIXED   colorconst  CCN-2
//   bit6  (64)   D6  MOT2-FLICKER motiondir   MOT-2
//   bit7  (128)  D7  MOT3-CAMO    motiondir   MOT-3
//   bit8  (256)  D8  SHP1-OCCLUDE shapetrans  SHP-1
//   bit9  (512)  D9  TMB1-BOUND   timbredisc  TMB-1
//   bit10 (1024) D10 SHP3-LOWCON  shapetrans  SHP-3
//   bit11 (2048) D11 TMB2-HARM    timbredisc  TMB-2
// Threshold accessors below; frozen values in
// docs/lab/senses/pam-rebuild/v2/forks/V2-C/src/CALIBRATION_C_ZAG.md.

// ---- threshold accessors (frozen; see CALIBRATION_C_ZAG.md) ----
fn thr_glide() i64 { return 10; }           // D1: 1000*|flate-fearly|/fearly
fn thr_texcorr_ccn1() i64 { return 9500; } // D3: Pearson r x10000
fn thr_ccn1b_ratio() i64 { return 1000000; } // D3b: DISABLED (FA on NOISE; D3 covers)
fn thr_ccn1b_bright() i64 { return 85; }  // D3b: DISABLED
fn thr_drift() i64 { return 1000000; }     // D4: DISABLED (no 0-FA form; 313 baseline)
fn thr_texvar() i64 { return 50; }         // D4: grayscale variance
fn thr_texcorr_col2() i64 { return 9900; } // D4: Pearson r x10000
fn thr_ccn2() i64 { return 15; }            // D5: warmth |r-b| threshold
fn thr_mot2_flick() i64 { return 1000000; } // D6: DISABLED (0 baseline; no 0-FA form)
fn thr_mot2_dir() i64 { return 1000000; }  // D6: DISABLED
fn thr_mot3_lo() i64 { return 1000000; }   // D7: DISABLED (0 baseline; no 0-FA form)
fn thr_mot3_hi() i64 { return 1000000; }   // D7: DISABLED
fn thr_shp1_run() i64 { return 1000000; }  // D8: DISABLED (FA on NOISE; 0 baseline)
fn thr_tmb1_pct() i64 { return 0; }         // D9: DISABLED (FA on NOISE; 6 baseline)
fn thr_shp3_con() i64 { return 30; }       // D10: luminance range
fn thr_tmb2_pct() i64 { return 150; }      // D11: 100*E2/E1

// ---- shared: Pearson r x10000 between L/R 64x64 panels (grayscale) ----
// 128x64 RGB F span @8. Returns -20000 on bad layout.
fn vknow_texcorr(buf:[]u8, n:i32) i64 {
    if(n < 8 + 128*64*3) { return -20000; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return -20000; }
    let cnt:i64 = 4096;
    let sa:i64 = 0;
    let sb:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let oa:i32 = 8 + (y * 128 + x) * 3;
            let ob:i32 = 8 + (y * 128 + x + 64) * 3;
            sa = sa + ((buf[oa] as i64) + (buf[oa+1] as i64) + (buf[oa+2] as i64)) / 3;
            sb = sb + ((buf[ob] as i64) + (buf[ob+1] as i64) + (buf[ob+2] as i64)) / 3;
            x = x + 1;
        }
        y = y + 1;
    }
    let ma:i64 = sa / cnt;
    let mb:i64 = sb / cnt;
    let da:i64 = 0;
    let db:i64 = 0;
    let nab:i64 = 0;
    let y2:i32 = 0;
    while(y2 < 64) {
        let x2:i32 = 0;
        while(x2 < 64) {
            let oa:i32 = 8 + (y2 * 128 + x2) * 3;
            let ob:i32 = 8 + (y2 * 128 + x2 + 64) * 3;
            let ga:i64 = ((buf[oa] as i64) + (buf[oa+1] as i64) + (buf[oa+2] as i64)) / 3 - ma;
            let gb:i64 = ((buf[ob] as i64) + (buf[ob+1] as i64) + (buf[ob+2] as i64)) / 3 - mb;
            da = da + ga * ga;
            db = db + gb * gb;
            nab = nab + ga * gb;
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    if(da <= 0 || db <= 0) { return -20000; }
    let den:i64 = isqrt(da * db);
    if(den <= 0) { return -20000; }
    return nab * 10000 / den;
}

// ---- shared: 10*max/min channel mean over x in [x0,x1), 128x64 RGB ----
fn illum_ratio10(buf:[]u8, x0:i32, x1:i32) i64 {
    let sr:i64 = 0;
    let sg:i64 = 0;
    let sb:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = x0;
        while(x < x1) {
            let o:i32 = 8 + (y * 128 + x) * 3;
            sr = sr + (buf[o] as i64);
            sg = sg + (buf[o+1] as i64);
            sb = sb + (buf[o+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    if(cnt == 0) { return -1; }
    let mr:i64 = sr / cnt;
    let mg:i64 = sg / cnt;
    let mb:i64 = sb / cnt;
    let mx:i64 = mr;
    let mn:i64 = mr;
    if(mg > mx) { mx = mg; }
    if(mg < mn) { mn = mg; }
    if(mb > mx) { mx = mb; }
    if(mb < mn) { mn = mb; }
    if(mn <= 0) { return -1; }
    return mx * 10 / mn;
}

// ---- D1 GLIDE: max over tones of 1000*|flate-fearly|/fearly; -1 on bad ----
fn m1_glide(buf:[]u8, n:i32, op:[]u8) i64 {
    if(n < 8) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let tone:i32 = (cnt * 10 / 22) as i32;
    let gap:i32 = cnt - 2 * tone;
    if(tone < 6024 || gap < 0) { return -1; }
    let aoff:i32 = 8;
    let boff:i32 = 8 + (tone + gap) * 2;
    let best:i64 = 0;
    let fa_e:i64 = f0_h2(buf, aoff, 1024, sr, op);
    let fa_l:i64 = f0_h2(buf, aoff + (tone - 1024) * 2, 1024, sr, op);
    if(fa_e > 0 && fa_l > 0) {
        let ga:i64 = iabs(fa_l - fa_e) * 1000 / fa_e;
        if(ga > best) { best = ga; }
    }
    let fb_e:i64 = f0_h2(buf, boff, 1024, sr, op);
    let fb_l:i64 = f0_h2(buf, boff + (tone - 1024) * 2, 1024, sr, op);
    if(fb_e > 0 && fb_l > 0) {
        let gb:i64 = iabs(fb_l - fb_e) * 1000 / fb_e;
        if(gb > best) { best = gb; }
    }
    return best;
}

fn d1_glide(buf:[]u8, n:i32, op:[]u8) i32 {
    let m:i64 = m1_glide(buf, n, op);
    if(m < 0) { return 0; }
    if(m > thr_glide()) { return 1; }
    return 0;
}

// ---- D2 HARMINC: spectral-peak vs f0_h2 disagreement ----
// single-frequency DFT magnitude (squared, normalized); 0 on bad
fn dft_mag(buf:[]u8, off:i32, w:i32, sr:i64, fm:i64, op:[]u8) i64 {
    if(fm <= 0 || w < 64) { return 0; }
    let pinc:i64 = fm * 4294967296 / (1000 * sr);
    if(pinc <= 0) { return 0; }
    let re:i64 = 0;
    let im:i64 = 0;
    let i:i32 = 0;
    while(i < w) {
        let s:i64 = t_geti16(buf, off + i * 2);
        let p:i64 = ((i as i64) * pinc) & 4294967295;
        re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
        im = im + s * ng_sin1024(p) / 1024;
        i = i + 1;
    }
    return (re * re + im * im) / 1048576;
}

// argmax of DFT magnitude over 1/6-octave grid 100..1500 Hz; milli-Hz
fn spec_peak(buf:[]u8, off:i32, w:i32, sr:i64, op:[]u8) i64 {
    let f:i64 = 100000;
    let best_f:i64 = 0;
    let best_m:i64 = -1;
    let it:i32 = 0;
    while(f <= 1500000 && it < 100) {
        let m:i64 = dft_mag(buf, off, w, sr, f, op);
        if(m > best_m) { best_m = m; best_f = f; }
        f = f * 1126 / 1000;
        it = it + 1;
    }
    return best_f;
}

// is the spectral peak at an integer harmonic (1..4) of f0? (+-10%)
fn peak_consistent(pk:i64, f0:i64) i32 {
    let r:i64 = pk * 100 / f0;
    if(r >= 90 && r <= 110) { return 1; }
    if(r >= 190 && r <= 210) { return 1; }
    if(r >= 290 && r <= 310) { return 1; }
    if(r >= 390 && r <= 410) { return 1; }
    return 0;
}

// 0=consistent, 1=inconsistent, -1=bad layout
fn m2_harminc(buf:[]u8, n:i32, op:[]u8) i64 {
    if(n < 8) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let tone:i32 = (cnt * 10 / 22) as i32;
    let gap:i32 = cnt - 2 * tone;
    if(tone < 6024 || gap < 0) { return -1; }
    let inc:i64 = 0;
    let got:i32 = 0;
    let fa:i64 = f0_h2(buf, 8, 1024, sr, op);
    let pa:i64 = spec_peak(buf, 8, 1024, sr, op);
    if(fa > 0 && pa > 0) {
        got = 1;
        if(peak_consistent(pa, fa) == 0) { inc = 1; }
    }
    let boff:i32 = 8 + (tone + gap) * 2;
    let fb:i64 = f0_h2(buf, boff, 1024, sr, op);
    let pb:i64 = spec_peak(buf, boff, 1024, sr, op);
    if(fb > 0 && pb > 0) {
        got = 1;
        if(peak_consistent(pb, fb) == 0) { inc = 1; }
    }
    if(got == 0) { return -1; }
    return inc;
}

fn d2_harminc(buf:[]u8, n:i32, op:[]u8) i32 {
    let m:i64 = m2_harminc(buf, n, op);
    if(m > 0) { return 1; }
    return 0;
}

// ---- D3 CCN1-TEXCORR: opposite extreme casts + same texture ----
// panel1 xblue vs panel2 xred (or vice versa); 10*dom/sub ratios; -1 bad
// returns 1 if opposite casts detected, else 0
fn m3_opposite(buf:[]u8, n:i32) i64 {
    if(n < 8 + 128*64*3) { return -1; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return -1; }
    // mean RGB per panel
    let r1:i64 = 0; let g1:i64 = 0; let b1:i64 = 0;
    let r2:i64 = 0; let g2:i64 = 0; let b2:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let o1:i32 = 8 + (y * 128 + x) * 3;
            let o2:i32 = 8 + (y * 128 + x + 64) * 3;
            r1 = r1 + (buf[o1] as i64); g1 = g1 + (buf[o1+1] as i64); b1 = b1 + (buf[o1+2] as i64);
            r2 = r2 + (buf[o2] as i64); g2 = g2 + (buf[o2+1] as i64); b2 = b2 + (buf[o2+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    let mr1:i64 = r1 / cnt; let mg1:i64 = g1 / cnt; let mb1:i64 = b1 / cnt;
    let mr2:i64 = r2 / cnt; let mg2:i64 = g2 / cnt; let mb2:i64 = b2 / cnt;
    // blue-dominant: b > 2*r and b > 2*g; red-dominant: r > 2*b and r > 2*g
    let blue1:i32 = 0;
    if(mb1 > 2 * mr1 && mb1 > 2 * mg1) { blue1 = 1; }
    let red1:i32 = 0;
    if(mr1 > 2 * mb1 && mr1 > 2 * mg1) { red1 = 1; }
    let blue2:i32 = 0;
    if(mb2 > 2 * mr2 && mb2 > 2 * mg2) { blue2 = 1; }
    let red2:i32 = 0;
    if(mr2 > 2 * mb2 && mr2 > 2 * mg2) { red2 = 1; }
    if((blue1 == 1 && red2 == 1) || (red1 == 1 && blue2 == 1)) { return 1; }
    return 0;
}

fn d3_ccn1(buf:[]u8, n:i32) i32 {
    let o:i64 = m3_opposite(buf, n);
    if(o < 0) { return 0; }
    if(o == 0) { return 0; }
    let c:i64 = vknow_texcorr(buf, n);
    if(c < thr_texcorr_ccn1()) { return 0; }
    return 1;
}

// ---- D3b CCN1-THR (sim form, corrected to 128x64) ----
fn panel_extreme_dark(buf:[]u8, x0:i32, x1:i32) i32 {
    let sr:i64 = 0;
    let sg:i64 = 0;
    let sb:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = x0;
        while(x < x1) {
            let o:i32 = 8 + (y * 128 + x) * 3;
            sr = sr + (buf[o] as i64);
            sg = sg + (buf[o+1] as i64);
            sb = sb + (buf[o+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    if(cnt == 0) { return 0; }
    let mr:i64 = sr / cnt;
    let mg:i64 = sg / cnt;
    let mb:i64 = sb / cnt;
    let mx:i64 = mr;
    let mn:i64 = mr;
    if(mg > mx) { mx = mg; }
    if(mg < mn) { mn = mg; }
    if(mb > mx) { mx = mb; }
    if(mb < mn) { mn = mb; }
    if(mn <= 0) { return 0; }
    let bright:i64 = (mr + mg + mb) / 3;
    if(mx * 10 / mn > thr_ccn1b_ratio() && bright < thr_ccn1b_bright()) { return 1; }
    return 0;
}

fn d3b_ccn1(buf:[]u8, n:i32) i32 {
    if(n < 8 + 128*64*3) { return 0; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return 0; }
    if(panel_extreme_dark(buf, 0, 64) == 1) { return 1; }
    if(panel_extreme_dark(buf, 64, 128) == 1) { return 1; }
    return 0;
}

// ---- D4 COL2-TEXCORR ----
// 1000*L1(panel means)/brightness between L/R panels; -1 on bad
fn m4_drift(buf:[]u8, n:i32) i64 {
    // Warm/cool opposition between panel1 and panel2 (COL-2 signature).
    // Returns 1 if opposite warm/cool with |warmth|>thr, else 0. -1 on bad.
    // Warmth = mean(r-b). Panel1 warm (r>b) vs panel2 cool (b>r), or vice versa.
    if(n < 8 + 128*64*3) { return -1; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return -1; }
    let r1:i64 = 0; let b1:i64 = 0;
    let r2:i64 = 0; let b2:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let o1:i32 = 8 + (y * 128 + x) * 3;
            let o2:i32 = 8 + (y * 128 + x + 64) * 3;
            r1 = r1 + (buf[o1] as i64); b1 = b1 + (buf[o1+2] as i64);
            r2 = r2 + (buf[o2] as i64); b2 = b2 + (buf[o2+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    let w1:i64 = r1 / cnt - b1 / cnt;
    let w2:i64 = r2 / cnt - b2 / cnt;
    let thr:i64 = thr_drift();
    if(w1 > thr && w2 < 0 - thr) { return 1; }
    if(w2 > thr && w1 < 0 - thr) { return 1; }
    return 0;
}

// grayscale variance over panel L; -1 on bad
fn m4_texvar(buf:[]u8, n:i32) i64 {
    if(n < 8 + 128*64*3) { return -1; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return -1; }
    let cnt:i64 = 4096;
    let s:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let o:i32 = 8 + (y * 128 + x) * 3;
            s = s + ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
            x = x + 1;
        }
        y = y + 1;
    }
    let m:i64 = s / cnt;
    let v:i64 = 0;
    let y2:i32 = 0;
    while(y2 < 64) {
        let x2:i32 = 0;
        while(x2 < 64) {
            let o:i32 = 8 + (y2 * 128 + x2) * 3;
            let g:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3 - m;
            v = v + g * g;
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    return v / cnt;
}

fn d4_col2(buf:[]u8, n:i32) i32 {
    let m:i64 = m4_drift(buf, n);
    if(m < 0) { return 0; }
    if(m == 0) { return 0; }
    // m==1 means opposite warm/cool detected; also require low texture var
    let v:i64 = m4_texvar(buf, n);
    if(v < 0) { return 0; }
    if(v > thr_texvar()) { return 0; }
    return 1;
}

// ---- D5 CCN2-MIXED: warm/cool split within panel1 ----
// q1=[0,32) vs q2=[32,64): warmth = mean(r-b)
// returns 1 if opposite signs with |warmth| > thr on both; else 0; -1 bad->0
fn d5_ccn2(buf:[]u8, n:i32) i32 {
    if(n < 8 + 128*64*3) { return 0; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return 0; }
    let r1:i64 = 0; let b1:i64 = 0;
    let r2:i64 = 0; let b2:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 32) {
            let o1:i32 = 8 + (y * 128 + x) * 3;
            let o2:i32 = 8 + (y * 128 + x + 32) * 3;
            r1 = r1 + (buf[o1] as i64); b1 = b1 + (buf[o1+2] as i64);
            r2 = r2 + (buf[o2] as i64); b2 = b2 + (buf[o2+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    let w1:i64 = r1 / cnt - b1 / cnt;
    let w2:i64 = r2 / cnt - b2 / cnt;
    let thr:i64 = thr_ccn2();
    // opposite signs: w1>thr and w2<-thr, or vice versa
    if(w1 > thr && w2 < 0 - thr) { return 1; }
    if(w2 > thr && w1 < 0 - thr) { return 1; }
    return 0;
}

// ---- D6/D7 motion energies ----
// 10*mean|I[t+1]-I[t]| over t=0..6, sparse step 2; -1 on bad
fn vknow_framediff(buf:[]u8, n:i32) i64 {
    if(n < 12) { return -1; }
    if(t_get32(buf, 0) != 8 || t_get32(buf, 4) != 64 || t_get32(buf, 8) != 64) { return -1; }
    if(n < 12 + 8*64*64*3) { return -1; }
    let sum:i64 = 0;
    let cnt:i64 = 0;
    let t:i32 = 0;
    while(t < 7) {
        let y:i32 = 0;
        while(y < 64) {
            let x:i32 = 0;
            while(x < 64) {
                let c:i32 = 0;
                while(c < 3) {
                    let o0:i32 = 12 + (t * 4096 + y * 64 + x) * 3 + c;
                    let o1:i32 = 12 + ((t + 1) * 4096 + y * 64 + x) * 3 + c;
                    sum = sum + iabs((buf[o1] as i64) - (buf[o0] as i64));
                    cnt = cnt + 1;
                    c = c + 1;
                }
                x = x + 2;
            }
            y = y + 2;
        }
        t = t + 1;
    }
    if(cnt == 0) { return -1; }
    return sum * 10 / cnt;
}

// 10*mean|I[t]-2*I[t+1]+I[t+2]| over t=0..5, sparse step 2; -1 on bad
fn vknow_flicker(buf:[]u8, n:i32) i64 {
    if(n < 12) { return -1; }
    if(t_get32(buf, 0) != 8 || t_get32(buf, 4) != 64 || t_get32(buf, 8) != 64) { return -1; }
    if(n < 12 + 8*64*64*3) { return -1; }
    let sum:i64 = 0;
    let cnt:i64 = 0;
    let t:i32 = 0;
    while(t < 6) {
        let y:i32 = 0;
        while(y < 64) {
            let x:i32 = 0;
            while(x < 64) {
                let c:i32 = 0;
                while(c < 3) {
                    let o0:i32 = 12 + (t * 4096 + y * 64 + x) * 3 + c;
                    let o1:i32 = 12 + ((t + 1) * 4096 + y * 64 + x) * 3 + c;
                    let o2:i32 = 12 + ((t + 2) * 4096 + y * 64 + x) * 3 + c;
                    let v0:i64 = buf[o0] as i64;
                    let v1:i64 = buf[o1] as i64;
                    let v2:i64 = buf[o2] as i64;
                    sum = sum + iabs(v0 - 2 * v1 + v2);
                    cnt = cnt + 1;
                    c = c + 1;
                }
                x = x + 2;
            }
            y = y + 2;
        }
        t = t + 1;
    }
    if(cnt == 0) { return -1; }
    return sum * 10 / cnt;
}

fn d6_mot2(buf:[]u8, n:i32) i32 {
    let fl:i64 = vknow_flicker(buf, n);
    if(fl < 0 || fl <= thr_mot2_flick()) { return 0; }
    let dr:i64 = vknow_framediff(buf, n);
    if(dr < 0 || dr <= thr_mot2_dir()) { return 0; }
    return 1;
}

fn d7_mot3(buf:[]u8, n:i32) i32 {
    let dr:i64 = vknow_framediff(buf, n);
    if(dr < 0) { return 0; }
    if(dr < thr_mot3_lo()) { return 0; }
    if(dr > thr_mot3_hi()) { return 0; }
    return 1;
}

// ---- D8 SHP1-OCCLUDE: consecutive uniform-dark rows (occlusion bar) ----
// longest run of rows with mean lum < 40 and >90% pixels in [10,50]; -1 bad
fn m8_barrows(buf:[]u8, n:i32) i64 {
    if(n < 8 + 96*96*3) { return -1; }
    if(t_get32(buf, 0) != 96 || t_get32(buf, 4) != 96) { return -1; }
    let best:i64 = 0;
    let run:i64 = 0;
    let y:i32 = 0;
    while(y < 96) {
        let darkcnt:i32 = 0;
        let sum:i64 = 0;
        let x:i32 = 0;
        while(x < 96) {
            let o:i32 = 8 + (y * 96 + x) * 3;
            let lum:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
            sum = sum + lum;
            if(lum >= 10 && lum <= 50) { darkcnt = darkcnt + 1; }
            x = x + 1;
        }
        let mean:i64 = sum / 96;
        if(mean < 40 && darkcnt >= 86) {
            run = run + 1;
            if(run > best) { best = run; }
        } else {
            run = 0;
        }
        y = y + 1;
    }
    return best;
}

fn d8_shp1(buf:[]u8, n:i32) i32 {
    let m:i64 = m8_barrows(buf, n);
    if(m < 0) { return 0; }
    if(m >= thr_shp1_run()) { return 1; }
    return 0;
}

// ---- D9 TMB1-BOUND: 100*|centroid-boundary|/boundary, min over boundaries ----
fn m9_boundary(buf:[]u8, n:i32, op:[]u8) i64 {
    if(n < 8) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 2048 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let f0:i64 = f0_h2(buf, 8, cnt, sr, op);
    if(f0 <= 0) { return -1; }
    let r:i64 = spec_centroid_h2(buf, 8, 2048, sr, f0, op);
    if(r <= 0) { return -1; }
    let best:i64 = 1000000;
    let d:i64 = iabs(r - 1075) * 100 / 1075;
    if(d < best) { best = d; }
    d = iabs(r - 1400) * 100 / 1400;
    if(d < best) { best = d; }
    d = iabs(r - 3000) * 100 / 3000;
    if(d < best) { best = d; }
    return best;
}

fn d9_tmb1(buf:[]u8, n:i32, op:[]u8) i32 {
    let m:i64 = m9_boundary(buf, n, op);
    if(m < 0) { return 0; }
    if(m < thr_tmb1_pct()) { return 1; }
    return 0;
}

// ---- D10 SHP3-LOWCON: luminance range; -1 on bad ----
fn m10_contrast(buf:[]u8, n:i32) i64 {
    if(n < 8 + 96*96*3) { return -1; }
    if(t_get32(buf, 0) != 96 || t_get32(buf, 4) != 96) { return -1; }
    let mn:i64 = 765;
    let mx:i64 = 0;
    let y:i32 = 0;
    while(y < 96) {
        let x:i32 = 0;
        while(x < 96) {
            let o:i32 = 8 + (y * 96 + x) * 3;
            let lum:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
            if(lum < mn) { mn = lum; }
            if(lum > mx) { mx = lum; }
            x = x + 2;
        }
        y = y + 2;
    }
    return mx - mn;
}

fn d10_shp3(buf:[]u8, n:i32) i32 {
    let m:i64 = m10_contrast(buf, n);
    if(m < 0) { return 0; }
    if(m < thr_shp3_con()) { return 1; }
    return 0;
}

// ---- D11 TMB2-HARM: 100*E(2f0)/E(f0); -1 on bad ----
fn m11_boost(buf:[]u8, n:i32, op:[]u8) i64 {
    if(n < 8) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 1024 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let f0:i64 = f0_h2(buf, 8, cnt, sr, op);
    if(f0 <= 0) { return -1; }
    let e1:i64 = harm_energy(buf, 8, 1024, sr, f0, 4, op);
    if(e1 <= 0) { return -1; }
    let e2:i64 = harm_energy(buf, 8, 1024, sr, f0 * 2, 4, op);
    return e2 * 100 / e1;
}

fn d11_tmb2(buf:[]u8, n:i32, op:[]u8) i32 {
    let m:i64 = m11_boost(buf, n, op);
    if(m < 0) { return 0; }
    if(m > thr_tmb2_pct()) { return 1; }
    return 0;
}

// ---- dispatcher: bitmask of fired detectors ----
fn vknow_check(tc:i32, buf:[]u8, n:i32, op:[]u8, dmask:i32) i32 {
    let fire:i32 = 0;
    if(tc == 0) {
        if((dmask & 16) != 0 && d4_col2(buf, n) == 1) { fire = fire | 16; }
    }
    if(tc == 1) {
        if((dmask & 4) != 0 && d3_ccn1(buf, n) == 1) { fire = fire | 4; }
        if((dmask & 8) != 0 && d3b_ccn1(buf, n) == 1) { fire = fire | 8; }
        if((dmask & 32) != 0 && d5_ccn2(buf, n) == 1) { fire = fire | 32; }
    }
    if(tc == 2) {
        if((dmask & 256) != 0 && d8_shp1(buf, n) == 1) { fire = fire | 256; }
        if((dmask & 1024) != 0 && d10_shp3(buf, n) == 1) { fire = fire | 1024; }
    }
    if(tc == 3) {
        if((dmask & 1) != 0 && d1_glide(buf, n, op) == 1) { fire = fire | 1; }
        if((dmask & 2) != 0 && d2_harminc(buf, n, op) == 1) { fire = fire | 2; }
    }
    if(tc == 4) {
        if((dmask & 512) != 0 && d9_tmb1(buf, n, op) == 1) { fire = fire | 512; }
        if((dmask & 2048) != 0 && d11_tmb2(buf, n, op) == 1) { fire = fire | 2048; }
    }
    if(tc == 5) {
        if((dmask & 64) != 0 && d6_mot2(buf, n) == 1) { fire = fire | 64; }
        if((dmask & 128) != 0 && d7_mot3(buf, n) == 1) { fire = fire | 128; }
    }
    return fire;
}

// ---- K-tag: "K=FAM+FAM..." into tag[], returns length ----
fn tag_cpy(tag:[]u8, p:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        tag[p] = s[i];
        p = p + 1;
        i = i + 1;
    }
    return p;
}

fn ktag_build(fire:i32, tag:[]u8) i32 {
    tag[0] = 75;
    tag[1] = 61;
    let p:i32 = 2;
    let nf:i32 = 0;
    if((fire & 1) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "PTC-2");
        nf = nf + 1;
    }
    if((fire & 2) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "PTC-3");
        nf = nf + 1;
    }
    if((fire & 12) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "CCN-1");
        nf = nf + 1;
    }
    if((fire & 16) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "COL-2");
        nf = nf + 1;
    }
    if((fire & 32) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "CCN-2");
        nf = nf + 1;
    }
    if((fire & 64) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "MOT-2");
        nf = nf + 1;
    }
    if((fire & 128) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "MOT-3");
        nf = nf + 1;
    }
    if((fire & 256) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "SHP-1");
        nf = nf + 1;
    }
    if((fire & 512) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "TMB-1");
        nf = nf + 1;
    }
    if((fire & 1024) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "SHP-3");
        nf = nf + 1;
    }
    if((fire & 2048) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "TMB-2");
        nf = nf + 1;
    }
    return p;
}

// ---- output-buffer surgery (main) ----
fn ob_match(ob:[]u8, at:i32, key:[]u8) i32 {
    let i:i32 = 0;
    while(i < key.len) {
        if((ob[at + i] as i32) != (key[i] as i32)) { return 0; }
        i = i + 1;
    }
    return 1;
}

// cap "confidence=" at cap (both known 3-digit here); returns pos unchanged
fn ob_cap_conf(ob:[]u8, pos:i32, cap:i64) i32 {
    let key:[]u8 = "\nconfidence=";
    let i:i32 = 0;
    while(i + 12 <= pos) {
        if(ob_match(ob, i, key) == 1) {
            let v:i64 = 0;
            let j:i32 = i + 12;
            let nd:i32 = 0;
            while(j < pos && (ob[j] as i32) >= 48 && (ob[j] as i32) <= 57) {
                v = v * 10 + ((ob[j] as i32) - 48) as i64;
                j = j + 1;
                nd = nd + 1;
            }
            if(v > cap && nd == 3) {
                ob[i+12] = 54;
                ob[i+13] = 53;
                ob[i+14] = 48;
            }
            break;
        }
        i = i + 1;
    }
    return pos;
}

// insert "|<tag>" before the newline ending the prog= line; returns new pos
fn ob_insert_ktag(ob:[]u8, pos:i32, tag:[]u8, tlen:i32) i32 {
    let key:[]u8 = "\nprog=";
    let i:i32 = 0;
    let q:i32 = -1;
    while(i + 6 <= pos) {
        if(ob_match(ob, i, key) == 1) {
            let j:i32 = i + 6;
            while(j < pos && (ob[j] as i32) != 10) { j = j + 1; }
            q = j;
            break;
        }
        i = i + 1;
    }
    if(q < 0 || q >= pos) { return pos; }
    let ins:i32 = 1 + tlen;
    let k:i32 = pos - 1;
    while(k >= q) {
        ob[k + ins] = ob[k];
        k = k - 1;
    }
    ob[q] = 124;
    let c:i32 = 0;
    while(c < tlen) {
        ob[q + 1 + c] = tag[c];
        c = c + 1;
    }
    return pos + ins;
}

fn z_atoi(s:[]u8) i32 {
    let v:i32 = 0;
    let i:i32 = 0;
    while(i < s.len) {
        let c:i32 = s[i] as i32;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

// ---- stats mode: raw detector measurements for calibration ----
fn vknow_stats(tc:i32, buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32) i32 {
    pos = ob_kint(ob, pos, "d1_gl", m1_glide(buf, n, op));
    pos = ob_kint(ob, pos, "d2_harm", m2_harminc(buf, n, op));
    pos = ob_kint(ob, pos, "d3_opp", m3_opposite(buf, n));
    pos = ob_kint(ob, pos, "d3_corr", vknow_texcorr(buf, n));
    pos = ob_kint(ob, pos, "d3b", d3b_ccn1(buf, n) as i64);
    pos = ob_kint(ob, pos, "d4_opp", m4_drift(buf, n));
    pos = ob_kint(ob, pos, "d4_var", m4_texvar(buf, n));
    pos = ob_kint(ob, pos, "d4_corr", vknow_texcorr(buf, n));
    pos = ob_kint(ob, pos, "d5", d5_ccn2(buf, n) as i64);
    pos = ob_kint(ob, pos, "d6_flick", vknow_flicker(buf, n));
    pos = ob_kint(ob, pos, "d6_dir", vknow_framediff(buf, n));
    pos = ob_kint(ob, pos, "d8_barrows", m8_barrows(buf, n));
    pos = ob_kint(ob, pos, "d9_bnd", m9_boundary(buf, n, op));
    pos = ob_kint(ob, pos, "d10_con", m10_contrast(buf, n));
    pos = ob_kint(ob, pos, "d11_boost", m11_boost(buf, n, op));
    pos = ob_kint(ob, pos, "fire", vknow_check(tc, buf, n, op, 4095) as i64);
    return pos;
}

// ================= main (V2-C) ===============================================
fn main() i32 {
    // argc is always 0 in this runtime; read _zag_arg directly.
    let task:[]u8 = _zag_arg(1);
    let path:[]u8 = _zag_arg(2);
    if(task.len == 0) { return fail("?", "usage: vsense_c <task> <fixture> [dmask] [stats]"); }
    // dmask: detector-enable bitmask (decimal), default 4095 (all bits).
    // dmask=0 disables all detectors: pure R2-4 front end (approach=R2-4).
    let dmask:i32 = 4095;
    let dmarg:[]u8 = _zag_arg(3);
    if(dmarg.len > 0) { dmask = z_atoi(dmarg); }
    if(dmask < 0) { dmask = 0; }
    if(dmask > 4095) { dmask = 4095; }
    let stats:i32 = 0;
    let sarg:[]u8 = _zag_arg(4);
    if(_zag_strcmp(sarg, "stats") == 1) { stats = 1; }
    let buf:[]u8 = nio_alloc(8388608);
    if(buf.len == 0) { return fail(task, "no-memory"); }
    let n:i64 = z_read(path, buf, 8388608);
    if(n < 0) { nio_free(buf); return fail(task, "bad-read"); }
    let op:[]u8 = nio_alloc(8);
    t_put64(op, 0, 0);
    let lut:[]u8 = nio_alloc(2048);
    lut_init(lut);
    let dop:[]u8 = nio_alloc(8);
    t_put64(dop, 0, 0);
    let ob:[]u8 = nio_alloc(8192);
    let pos:i32 = 0;
    // R24A dual-span split: F = verdict span, G = disjoint holdout span.
    // Legacy single-span fixtures: G absent -> self-result UNRESOLVED.
    let fbuf:[]u8 = buf[0..n as i32];
    let fnn:i32 = n as i32;
    let gbuf:[]u8 = buf[0..0];
    let gn:i32 = 0;
    if(n >= 8 && t_get32(buf, 0) == 1093939794) {
        let flen:i64 = r24_flen(buf, n);
        if(flen <= 0 || 8 + flen > n || r24_tcode(task) != t_get32(buf, 4)) {
            nio_free(buf);
            nio_free(lut);
            nio_free(dop);
            return fail(task, "bad-r24a");
        }
        fbuf = buf[8..(8 + flen) as i32];
        fnn = flen as i32;
        gbuf = buf[(8 + flen) as i32..n as i32];
        gn = (n - 8 - flen) as i32;
    }
    let tc:i64 = r24_tcode(task);
    if(stats == 1) {
        pos = ob_kv(ob, pos, "approach", "V2-C-stats");
        pos = ob_kv(ob, pos, "task", task);
        pos = vknow_stats(tc as i32, fbuf, fnn, dop, ob, pos);
        nio_write_all(1, ob[0..pos]);
        nio_free(buf);
        nio_free(lut);
        nio_free(dop);
        nio_free(ob);
        return 0;
    }
    // Knowledge detectors run on the F span BEFORE the front end.
    let fire:i32 = 0;
    if(dmask != 0 && tc >= 0) {
        fire = vknow_check(tc as i32, fbuf, fnn, dop, dmask);
    }
    let approach:[]u8 = "V2-C";
    if(dmask == 0) { approach = "R2-4"; }
    pos = ob_kv(ob, pos, "approach", approach);
    pos = ob_kv(ob, pos, "task", task);
    let rc:i32 = -1;
    if(_zag_strcmp(task, "colordisc") == 1) { rc = task_colordisc(fbuf, fnn, ob, pos, op, lut, gbuf, gn); }
    if(_zag_strcmp(task, "colorconst") == 1) { rc = task_colorconst(fbuf, fnn, ob, pos, op, lut, gbuf, gn); }
    if(_zag_strcmp(task, "shapetrans") == 1) { rc = task_shapetrans(fbuf, fnn, ob, pos, op, gbuf, gn); }
    if(_zag_strcmp(task, "pitchdisc") == 1) { rc = task_pitchdisc(fbuf, fnn, ob, pos, op, gbuf, gn); }
    if(_zag_strcmp(task, "timbredisc") == 1) { rc = task_timbredisc(fbuf, fnn, ob, pos, op, gbuf, gn); }
    if(_zag_strcmp(task, "motiondir") == 1) { rc = task_motiondir(fbuf, fnn, ob, pos, op, gbuf, gn); }
    nio_free(buf);
    nio_free(lut);
    nio_free(dop);
    if(rc < 0) {
        nio_free(op);
        nio_free(ob);
        return fail(task, "bad-size");
    }
    pos = rc;
    // Knowledge cap: a fired detector caps confidence and tags the program.
    if(fire != 0) {
        let tag:[]u8 = nio_alloc(64);
        let tlen:i32 = ktag_build(fire, tag);
        pos = ob_cap_conf(ob, pos, 650);
        pos = ob_insert_ktag(ob, pos, tag, tlen);
        pos = ob_kv(ob, pos, "kcap", tag[0..tlen]);
        nio_free(tag);
    }
    let ops:i64 = t_get64(op, 0);
    nio_free(op);
    pos = ob_kint(ob, pos, "ops", ops);
    pos = ob_kint(ob, pos, "cost", ops);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 0;
}

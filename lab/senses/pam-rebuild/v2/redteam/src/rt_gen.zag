// rt_gen.zag — RED-TEAM novel-family fixture generator (pure Zag, zero RNG).
//
// Generates 12 NOVEL adversarial families (none in any frozen fixture set)
// in the frozen R2A fixture contract:
//   .img : u32LE w, u32LE h, w*h*3 RGB bytes
//   .pcm : u32LE rate(16000), u32LE nsamples, i16LE samples
//   .vid : u32LE nframes, u32LE w, u32LE h, frames of w*h*3 RGB bytes
//   .truth sidecar: "truth=<VALUE>\n"
//
// All fixture parameters are pure deterministic functions of (family, index)
// via rt_draw — a stateless integer hash chain. No PRNG state, no entropy,
// no time. Byte-identical reruns by construction.
//
// Usage: rt_gen <outdir> <fam: 0=all, 1..12> <count>
//
// Families:
//   1 PTC-4 detune-beats      (pitchdisc) tone B = fB-det + fB+det partials
//   2 PTC-5 gap-tone          (pitchdisc) tone B has 60ms silence gap
//   3 TMB-4 env-reversal      (timbredisc) harmonic stack, time-reversed envelope
//   4 TMB-5 formant-twin      (timbredisc) same-centroid, different formant
//   5 COL-4 adapt-ramp        (colordisc) SAME surface, spatial illuminant ramp
//   6 COL-5 drift-metamer      (colordisc) DIFFERENT surfaces, drift hides delta
//   7 CCN-3 checker-illuminant (colorconst) 2x2 warm/cool checkerboard
//   8 CCN-4 exposure-flicker  (colorconst) 3-band exposure steps
//   9 SHP-4 shadow-decoy      (shapetrans) cast shadow of a DIFFERENT shape
//  10 SHP-5 tile-scramble     (shapetrans) shape in 2x2 displaced tiles
//  11 MOT-4 strobe-alias      (motiondir) temporal subsampling reverses apparent dir
//  12 MOT-5 induced-motion    (motiondir) still target + moving surround
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- deterministic draws (stateless, no RNG) ----------------
// rt_mix: wrapping i64 multiply chain, masked to non-negative.
fn rt_mix(a:i64, b:i64, c:i64) i64 {
    // NOTE (red-team lesson 2026-09-23): the b-coefficient MUST be odd and the
    // final xor-fold is load-bearing. With an even b-coefficient (9176 was
    // tried), rt_draw(fam,idx,k,8) returned a constant for all idx: the LCG's
    // low 3 bits never saw idx (9176 % 8 == 0), so every mod-8 draw collapsed.
    // The (z ^ (z >> 33)) fold (safe: z is non-negative, so >> is logical)
    // mixes high bits down and breaks the LCG low-bit lattice.
    let z:i64 = (a * 1000003 + b * 911 + c * 131 + 12345) & 0x7FFFFFFFFFFFFFFF;
    z = (z * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF;
    z = (z * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF;
    z = (z ^ (z >> 33)) & 0x7FFFFFFFFFFFFFFF;
    return z;
}
// rt_draw(fam, idx, k, m): deterministic value in [0, m).
fn rt_draw(fam:i64, idx:i64, k:i64, m:i64) i64 {
    return rt_mix(fam * 7919 + 13, idx + 1, k + 7) % m;
}

// ---------------- math ----------------
fn rt_absf(x:f64) f64 {
    if(x < 0.0) { return 0.0 - x; }
    return x;
}
// sin via range reduction + 8-term Taylor (error < 1 LSB at i16 scale).
fn rt_sin(x:f64) f64 {
    let twopi:f64 = 6.283185307179586;
    let pi:f64 = 3.141592653589793;
    let k:i64 = (x / twopi) as i64;
    let r:f64 = x - (k as f64) * twopi;
    if(r > pi) { r = r - twopi; }
    if(r < 0.0 - pi) { r = r + twopi; }
    let x2:f64 = r * r;
    let s:f64 = -1.0 / 1307674368000.0;
    s = 1.0 / 87178291200.0 + x2 * s;
    s = -1.0 / 39916800.0 + x2 * s;
    s = 1.0 / 362880.0 + x2 * s;
    s = -1.0 / 5040.0 + x2 * s;
    s = 1.0 / 120.0 + x2 * s;
    s = -1.0 / 6.0 + x2 * s;
    s = 1.0 + x2 * s;
    return r * s;
}
fn rt_clampu8(v:i64) u8 {
    if(v < 0) { return 0 as u8; }
    if(v > 255) { return 255 as u8; }
    return v as u8;
}

// ---------------- byte helpers ----------------
fn w32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at + 1] = ((v >> 8) & 255) as u8;
    b[at + 2] = ((v >> 16) & 255) as u8;
    b[at + 3] = ((v >> 24) & 255) as u8;
    return;
}
fn w16(b:[]u8, at:i32, v:i64) void {
    // v in [-32768, 32767]; two's complement LE
    let u:i64 = v & 65535;
    b[at] = (u & 255) as u8;
    b[at + 1] = ((u >> 8) & 255) as u8;
    return;
}
// decimal u32 into buffer, returns new offset
fn put_dec(b:[]u8, at:i32, v:i64) i32 {
    let d0:i64 = v / 1000;
    let d1:i64 = (v / 100) % 10;
    let d2:i64 = (v / 10) % 10;
    let d3:i64 = v % 10;
    let o:i32 = at;
    if(d0 > 0) {
        b[o] = (48 + d0) as u8; o = o + 1;
        b[o] = (48 + d1) as u8; o = o + 1;
        b[o] = (48 + d2) as u8; o = o + 1;
        b[o] = (48 + d3) as u8; o = o + 1;
        return o;
    }
    if(d1 > 0) {
        b[o] = (48 + d1) as u8; o = o + 1;
        b[o] = (48 + d2) as u8; o = o + 1;
        b[o] = (48 + d3) as u8; o = o + 1;
        return o;
    }
    if(d2 > 0) {
        b[o] = (48 + d2) as u8; o = o + 1;
        b[o] = (48 + d3) as u8; o = o + 1;
        return o;
    }
    b[o] = (48 + d3) as u8; o = o + 1;
    return o;
}
// copy slice src into b at at, returns new offset
fn put_raw(b:[]u8, at:i32, src:[]u8) i32 {
    let i:i32 = 0;
    while(i < src.len) { b[at + i] = src[i]; i = i + 1; }
    return at + src.len;
}
// hex of 32-byte hash into b at at (64 chars), returns new offset
fn put_hex(b:[]u8, at:i32, h:[]u8) i32 {
    let i:i32 = 0;
    let o:i32 = at;
    while(i < 32) {
        let v:i32 = h[i] as i32;
        let hi:i32 = (v >> 4) & 15;
        let lo:i32 = v & 15;
        if(hi < 10) { b[o] = (48 + hi) as u8; } else { b[o] = (87 + hi) as u8; }
        o = o + 1;
        if(lo < 10) { b[o] = (48 + lo) as u8; } else { b[o] = (87 + lo) as u8; }
        o = o + 1;
        i = i + 1;
    }
    return o;
}

// ---------------- io ----------------
fn rt_write(root:i64, name:[]u8, data:[]u8) i32 {
    let fd:i64 = nio_open_child(root, name, 1);
    if(fd < 0) { return -1; }
    let rc:i64 = nio_write_all(fd, data);
    let cc:i64 = nio_close(fd);
    if(rc < 0) { return -2; }
    if(cc < 0) { return -3; }
    return 0;
}

// ---------------- manifest + naming ----------------
// manifest accumulator: lines "<hex>  <name>\n" appended here
fn mf_add(mf:[]u8, mpos:i32, name:[]u8, h:[]u8) i32 {
    let o:i32 = put_hex(mf, mpos, h);
    mf[o] = 32 as u8; o = o + 1;
    mf[o] = 32 as u8; o = o + 1;
    o = put_raw(mf, o, name);
    mf[o] = 10 as u8; o = o + 1;
    return o;
}
fn rt_sha(data:[]u8, h:[]u8) i32 {
    return ns_sha256(data, h);
}
// build fixture name: "rt3_<FAM>_<idx4>.<ext>" into nb, returns len
fn rt_name(nb:[]u8, famtag:[]u8, idx:i32, ext:[]u8) i32 {
    let o:i32 = put_raw(nb, 0, "rt3_");
    o = put_raw(nb, o, famtag);
    nb[o] = 95 as u8; o = o + 1; // '_'
    // 4-digit zero-padded index
    nb[o] = (48 + (idx / 1000) % 10) as u8; o = o + 1;
    nb[o] = (48 + (idx / 100) % 10) as u8; o = o + 1;
    nb[o] = (48 + (idx / 10) % 10) as u8; o = o + 1;
    nb[o] = (48 + idx % 10) as u8; o = o + 1;
    nb[o] = 46 as u8; o = o + 1; // '.'
    o = put_raw(nb, o, ext);
    return o;
}
// emit one fixture: hash+write data, hash+write truth sidecar, append manifest
fn rt_emit(root:i64, mf:[]u8, mpos:i32, famtag:[]u8, idx:i32, ext:[]u8, data:[]u8, truth:[]u8) i32 {
    let nb:[]u8 = nio_alloc(80);
    if(nb.len == 0) { return -9; }
    let nl:i32 = rt_name(nb, famtag, idx, ext);
    let name:[]u8 = nb[0..nl];
    let h:[]u8 = nio_alloc(32);
    if(h.len == 0) { nio_free(nb); return -9; }
    if(rt_sha(data, h) != 0) { nio_free(nb); nio_free(h); return -8; }
    if(rt_write(root, name, data) != 0) { nio_free(nb); nio_free(h); return -7; }
    let mp:i32 = mf_add(mf, mpos, name, h);
    // truth sidecar: name + ".truth", content "truth=<T>\n"
    let tb:[]u8 = nio_alloc(96);
    if(tb.len == 0) { nio_free(nb); nio_free(h); return -9; }
    let to:i32 = put_raw(tb, 0, name);
    to = put_raw(tb, to, ".truth");
    let tname:[]u8 = tb[0..to];
    let cb:[]u8 = nio_alloc(32);
    if(cb.len == 0) { nio_free(nb); nio_free(h); nio_free(tb); return -9; }
    let co:i32 = put_raw(cb, 0, "truth=");
    co = put_raw(cb, co, truth);
    cb[co] = 10 as u8; co = co + 1;
    let content:[]u8 = cb[0..co];
    if(rt_sha(content, h) != 0) { nio_free(nb); nio_free(h); nio_free(tb); nio_free(cb); return -8; }
    if(rt_write(root, tname, content) != 0) { nio_free(nb); nio_free(h); nio_free(tb); nio_free(cb); return -6; }
    mp = mf_add(mf, mp, tname, h);
    nio_free(nb); nio_free(h); nio_free(tb); nio_free(cb);
    return mp;
}

// ---------------- audio synthesis core ----------------
fn au_edge_ramp(v:f64, t:i32, seglen:i32) f64 {
    // 160-sample linear edge ramps per segment
    let e:f64 = 1.0;
    if(t < 160) { e = (t as f64) / 160.0; }
    let te:i32 = seglen - t;
    if(te < 160) {
        let e2:f64 = (te as f64) / 160.0;
        if(e2 < e) { e = e2; }
    }
    return v * e;
}

// FAM 1: PTC-4 detune-beats. segA pure fA; segB = (fB-det)+(fB+det).
fn gen_ptc4(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 1;
    let sr:i64 = 16000;
    let n:i32 = 16000;
    let fA:f64 = (300 + rt_draw(fam, idx as i64, 0, 200)) as f64;
    let draw1:i64 = rt_draw(fam, idx as i64, 1, 30);
    let fB:f64 = fA;
    if(draw1 >= 5) {
        let df:f64 = (5 + (draw1 - 5) % 15) as f64;
        if(rt_draw(fam, idx as i64, 2, 2) == 0) { fB = fA + df; } else { fB = fA - df; }
    }
    let det:f64 = (3 + rt_draw(fam, idx as i64, 3, 4)) as f64;
    let buf:[]u8 = nio_alloc(8 + n * 2);
    if(buf.len == 0) { return -9; }
    w32(buf, 0, sr);
    w32(buf, 4, n as i64);
    let twopi:f64 = 6.283185307179586;
    let phA:f64 = 0.0;
    let phB1:f64 = 0.0;
    let phB2:f64 = 0.0;
    let i:i32 = 0;
    while(i < n) {
        let v:f64 = 0.0;
        if(i < 8000) {
            v = rt_sin(phA) * 0.5;
            phA = phA + twopi * fA / (sr as f64);
            if(phA > twopi) { phA = phA - twopi; }
            v = au_edge_ramp(v, i, 8000);
        } else {
            let t2:i32 = i - 8000;
            v = (rt_sin(phB1) + rt_sin(phB2)) * 0.3;
            phB1 = phB1 + twopi * (fB - det) / (sr as f64);
            phB2 = phB2 + twopi * (fB + det) / (sr as f64);
            if(phB1 > twopi) { phB1 = phB1 - twopi; }
            if(phB2 > twopi) { phB2 = phB2 - twopi; }
            v = au_edge_ramp(v, t2, 8000);
        }
        let s:i64 = (v * 30000.0) as i64;
        if(s > 32767) { s = 32767; }
        if(s < -32768) { s = -32768; }
        w16(buf, 8 + i * 2, s);
        i = i + 1;
    }
    let truth:[]u8 = "SAME";
    if(fB > fA) { truth = "HIGHER"; }
    if(fB < fA) { truth = "LOWER"; }
    let mp:i32 = rt_emit(root, mf, mpos, "PTC-4", idx, "pcm", buf, truth);
    nio_free(buf);
    return mp;
}

// FAM 2: PTC-5 gap-tone. segA pure fA; segB pure fB with 60ms silence gap.
fn gen_ptc5(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 2;
    let sr:i64 = 16000;
    let n:i32 = 16000;
    let fA:f64 = (300 + rt_draw(fam, idx as i64, 0, 200)) as f64;
    let draw1:i64 = rt_draw(fam, idx as i64, 1, 20);
    let fB:f64 = fA;
    if(draw1 >= 2) {
        let df:f64 = (6 + (draw1 - 2) % 15) as f64;
        if(rt_draw(fam, idx as i64, 2, 2) == 0) { fB = fA + df; } else { fB = fA - df; }
    }
    let buf:[]u8 = nio_alloc(8 + n * 2);
    if(buf.len == 0) { return -9; }
    w32(buf, 0, sr);
    w32(buf, 4, n as i64);
    let twopi:f64 = 6.283185307179586;
    let ph:f64 = 0.0;
    let i:i32 = 0;
    while(i < n) {
        let v:f64 = 0.0;
        if(i < 8000) {
            v = rt_sin(ph) * 0.5;
            ph = ph + twopi * fA / (sr as f64);
            v = au_edge_ramp(v, i, 8000);
        } else {
            let t2:i32 = i - 8000;
            // 60ms gap centered in segB: samples 3520..4480 of segment
            if(t2 < 3520 || t2 >= 4480) {
                v = rt_sin(ph) * 0.5;
                v = au_edge_ramp(v, t2, 8000);
            } else {
                v = 0.0;
            }
            ph = ph + twopi * fB / (sr as f64);
        }
        if(ph > twopi) { ph = ph - twopi; }
        let s:i64 = (v * 30000.0) as i64;
        if(s > 32767) { s = 32767; }
        if(s < -32768) { s = -32768; }
        w16(buf, 8 + i * 2, s);
        i = i + 1;
    }
    let truth:[]u8 = "SAME";
    if(fB > fA) { truth = "HIGHER"; }
    if(fB < fA) { truth = "LOWER"; }
    let mp:i32 = rt_emit(root, mf, mpos, "PTC-5", idx, "pcm", buf, truth);
    nio_free(buf);
    return mp;
}

// FAM 3: TMB-4 env-reversal. Harmonic stack; envelope normal or time-reversed.
// Truth = spectral class (BRIGHT/DARK/RICH); the reversed envelope is the lure.
fn gen_tmb4(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 3;
    let sr:i64 = 16000;
    let n:i32 = 16000;
    let cls:i64 = rt_draw(fam, idx as i64, 0, 3);
    let f0:f64 = 300.0;
    let a1:f64 = 1.0;
    let a2:f64 = 0.5;
    let a3:f64 = 0.25;
    let a4:f64 = 0.12;
    let truth:[]u8 = "RICH";
    if(cls == 0) {
        f0 = (520 + rt_draw(fam, idx as i64, 1, 120)) as f64;
        a1 = 1.0; a2 = 0.7; a3 = 0.5; a4 = 0.3;
        truth = "BRIGHT";
    }
    if(cls == 1) {
        f0 = (300 + rt_draw(fam, idx as i64, 1, 100)) as f64;
        a1 = 1.0; a2 = 0.25; a3 = 0.08; a4 = 0.02;
        truth = "DARK";
    }
    if(cls == 2) {
        f0 = (400 + rt_draw(fam, idx as i64, 1, 100)) as f64;
        a1 = 1.0; a2 = 0.6; a3 = 0.45; a4 = 0.1;
        truth = "RICH";
    }
    let rev:i64 = rt_draw(fam, idx as i64, 2, 2);
    let buf:[]u8 = nio_alloc(8 + n * 2);
    if(buf.len == 0) { return -9; }
    w32(buf, 0, sr);
    w32(buf, 4, n as i64);
    let twopi:f64 = 6.283185307179586;
    let p1:f64 = 0.0;
    let p2:f64 = 0.0;
    let p3:f64 = 0.0;
    let p4:f64 = 0.0;
    let i:i32 = 0;
    while(i < n) {
        // envelope: 800-sample attack then linear decay to 0.5; reversed if rev
        let te:i32 = i;
        if(rev == 1) { te = n - 1 - i; }
        let env:f64 = 1.0;
        if(te < 800) { env = (te as f64) / 800.0; } else { env = 1.0 - 0.5 * ((te - 800) as f64) / ((n - 800) as f64); }
        let v:f64 = (rt_sin(p1) * a1 + rt_sin(p2) * a2 + rt_sin(p3) * a3 + rt_sin(p4) * a4) * 0.28 * env;
        p1 = p1 + twopi * f0 / (sr as f64);
        p2 = p2 + twopi * f0 * 2.0 / (sr as f64);
        p3 = p3 + twopi * f0 * 3.0 / (sr as f64);
        p4 = p4 + twopi * f0 * 4.0 / (sr as f64);
        if(p1 > twopi) { p1 = p1 - twopi; }
        if(p2 > twopi) { p2 = p2 - twopi; }
        if(p3 > twopi) { p3 = p3 - twopi; }
        if(p4 > twopi) { p4 = p4 - twopi; }
        let s:i64 = (v * 30000.0) as i64;
        if(s > 32767) { s = 32767; }
        if(s < -32768) { s = -32768; }
        w16(buf, 8 + i * 2, s);
        i = i + 1;
    }
    let mp:i32 = rt_emit(root, mf, mpos, "TMB-4", idx, "pcm", buf, truth);
    nio_free(buf);
    return mp;
}

// FAM 4: TMB-5 formant-twin. Same f0; Lorentzian formant at high or low
// frequency. Truth = BRIGHT (high formant) / DARK (low formant).
fn gen_tmb5(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 4;
    let sr:i64 = 16000;
    let n:i32 = 16000;
    let cls:i64 = rt_draw(fam, idx as i64, 0, 2);
    let f0:f64 = (350 + rt_draw(fam, idx as i64, 1, 150)) as f64;
    let ff:f64 = 2400.0;
    let truth:[]u8 = "BRIGHT";
    if(cls == 0) {
        ff = (2400 + rt_draw(fam, idx as i64, 2, 400)) as f64;
        truth = "BRIGHT";
    } else {
        ff = (700 + rt_draw(fam, idx as i64, 2, 200)) as f64;
        truth = "DARK";
    }
    let bw:f64 = 400.0;
    let buf:[]u8 = nio_alloc(8 + n * 2);
    if(buf.len == 0) { return -9; }
    w32(buf, 0, sr);
    w32(buf, 4, n as i64);
    let twopi:f64 = 6.283185307179586;
    // harmonic amps from Lorentzian around ff (8 harmonics)
    let ha0:f64 = 0.0; let ha1:f64 = 0.0; let ha2:f64 = 0.0; let ha3:f64 = 0.0;
    let ha4:f64 = 0.0; let ha5:f64 = 0.0; let ha6:f64 = 0.0; let ha7:f64 = 0.0;
    let k:i32 = 1;
    while(k <= 8) {
        let d:f64 = ((k as f64) * f0 - ff) / bw;
        let a:f64 = 1.0 / (1.0 + d * d);
        if(k == 1) { ha0 = a; }
        if(k == 2) { ha1 = a; }
        if(k == 3) { ha2 = a; }
        if(k == 4) { ha3 = a; }
        if(k == 5) { ha4 = a; }
        if(k == 6) { ha5 = a; }
        if(k == 7) { ha6 = a; }
        if(k == 8) { ha7 = a; }
        k = k + 1;
    }
    let p0:f64 = 0.0; let p1:f64 = 0.0; let p2:f64 = 0.0; let p3:f64 = 0.0;
    let p4:f64 = 0.0; let p5:f64 = 0.0; let p6:f64 = 0.0; let p7:f64 = 0.0;
    let i:i32 = 0;
    while(i < n) {
        let env:f64 = 1.0;
        if(i < 800) { env = (i as f64) / 800.0; }
        let te2:i32 = n - i;
        if(te2 < 800) {
            let e2:f64 = (te2 as f64) / 800.0;
            if(e2 < env) { env = e2; }
        }
        let v:f64 = (rt_sin(p0) * ha0 + rt_sin(p1) * ha1 + rt_sin(p2) * ha2 + rt_sin(p3) * ha3 + rt_sin(p4) * ha4 + rt_sin(p5) * ha5 + rt_sin(p6) * ha6 + rt_sin(p7) * ha7) * 0.35 * env;
        p0 = p0 + twopi * f0 * 1.0 / (sr as f64);
        p1 = p1 + twopi * f0 * 2.0 / (sr as f64);
        p2 = p2 + twopi * f0 * 3.0 / (sr as f64);
        p3 = p3 + twopi * f0 * 4.0 / (sr as f64);
        p4 = p4 + twopi * f0 * 5.0 / (sr as f64);
        p5 = p5 + twopi * f0 * 6.0 / (sr as f64);
        p6 = p6 + twopi * f0 * 7.0 / (sr as f64);
        p7 = p7 + twopi * f0 * 8.0 / (sr as f64);
        if(p0 > twopi) { p0 = p0 - twopi; }
        if(p1 > twopi) { p1 = p1 - twopi; }
        if(p2 > twopi) { p2 = p2 - twopi; }
        if(p3 > twopi) { p3 = p3 - twopi; }
        if(p4 > twopi) { p4 = p4 - twopi; }
        if(p5 > twopi) { p5 = p5 - twopi; }
        if(p6 > twopi) { p6 = p6 - twopi; }
        if(p7 > twopi) { p7 = p7 - twopi; }
        let s:i64 = (v * 30000.0) as i64;
        if(s > 32767) { s = 32767; }
        if(s < -32768) { s = -32768; }
        w16(buf, 8 + i * 2, s);
        i = i + 1;
    }
    let mp:i32 = rt_emit(root, mf, mpos, "TMB-5", idx, "pcm", buf, truth);
    nio_free(buf);
    return mp;
}

// ---------------- image helpers ----------------
// set pixel in 128x64 RGB buffer
fn px128(b:[]u8, x:i32, y:i32, r:i64, g:i64, bl:i64) void {
    let at:i32 = 8 + (y * 128 + x) * 3;
    b[at] = rt_clampu8(r);
    b[at + 1] = rt_clampu8(g);
    b[at + 2] = rt_clampu8(bl);
    return;
}
fn px96(b:[]u8, x:i32, y:i32, r:i64, g:i64, bl:i64) void {
    let at:i32 = 8 + (y * 96 + x) * 3;
    b[at] = rt_clampu8(r);
    b[at + 1] = rt_clampu8(g);
    b[at + 2] = rt_clampu8(bl);
    return;
}
fn fill128(b:[]u8, r:i64, g:i64, bl:i64) void {
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 128) { px128(b, x, y, r, g, bl); x = x + 1; }
        y = y + 1;
    }
    return;
}
fn fill96(b:[]u8, r:i64, g:i64, bl:i64) void {
    let y:i32 = 0;
    while(y < 96) {
        let x:i32 = 0;
        while(x < 96) { px96(b, x, y, r, g, bl); x = x + 1; }
        y = y + 1;
    }
    return;
}

// FAM 5: COL-4 adapt-ramp. Left panel: surface under neutral illuminant.
// Right panel: SAME or DIFFERENT surface under a SPATIAL illuminant ramp
// (neutral at left edge -> drifted at right edge). Two-point comparators fail.
fn gen_col4(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 5;
    let br:i64 = 140 + rt_draw(fam, idx as i64, 0, 60);
    let bg:i64 = 120 + rt_draw(fam, idx as i64, 1, 60);
    let bb:i64 = 110 + rt_draw(fam, idx as i64, 2, 60);
    let same:i64 = rt_draw(fam, idx as i64, 3, 2);
    // drift direction: warm or cool
    let warm:i64 = rt_draw(fam, idx as i64, 4, 2);
    let dr:i64 = 40; let dg:i64 = -10; let db:i64 = -30;
    if(warm == 0) { dr = -30; dg = -5; db = 40; }
    let buf:[]u8 = nio_alloc(8 + 128 * 64 * 3);
    if(buf.len == 0) { return -9; }
    w32(buf, 0, 128);
    w32(buf, 4, 64);
    fill128(buf, 128, 128, 128);
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            // left panel: neutral
            px128(buf, x, y, br, bg, bb);
            // right panel: surface (+delta if DIFFERENT) under ramped illuminant
            let t:f64 = (x as f64) / 63.0;
            let sr2:i64 = br;
            let sg2:i64 = bg;
            let sb2:i64 = bb;
            if(same == 0) { sr2 = sr2 + 30; sg2 = sg2 - 20; sb2 = sb2 + 15; }
            let ir:f64 = 255.0 + (dr as f64) * t;
            let ig:f64 = 255.0 + (dg as f64) * t;
            let ib:f64 = 255.0 + (db as f64) * t;
            let rr:i64 = ((sr2 as f64) * ir / 255.0) as i64;
            let gg:i64 = ((sg2 as f64) * ig / 255.0) as i64;
            let b2:i64 = ((sb2 as f64) * ib / 255.0) as i64;
            px128(buf, 64 + x, y, rr, gg, b2);
            x = x + 1;
        }
        y = y + 1;
    }
    let truth:[]u8 = "DIFFERENT";
    if(same == 1) { truth = "SAME"; }
    let mp:i32 = rt_emit(root, mf, mpos, "COL-4", idx, "img", buf, truth);
    nio_free(buf);
    return mp;
}

// FAM 6: COL-5 drift-metamer. Left: S1 under neutral. Right: S2 under a uniform
// drift D chosen so S2*D ~= S1 (metamerism under the WRONG illuminant).
// Truth DIFFERENT when S2 != S1; SAME on control trials.
fn gen_col5(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 6;
    let br:i64 = 150 + rt_draw(fam, idx as i64, 0, 50);
    let bg:i64 = 130 + rt_draw(fam, idx as i64, 1, 50);
    let bb:i64 = 120 + rt_draw(fam, idx as i64, 2, 50);
    let same:i64 = rt_draw(fam, idx as i64, 3, 2);
    let s2r:i64 = br;
    let s2g:i64 = bg;
    let s2b:i64 = bb;
    if(same == 0) { s2r = br + 18; s2g = bg - 12; s2b = bb + 9; }
    // drift D solves S2*D/255 = S1 (per channel), plus small jitter
    let jit:i64 = rt_draw(fam, idx as i64, 4, 11) - 5;
    let dr:f64 = (br as f64) * 255.0 / (s2r as f64) + (jit as f64);
    let dg:f64 = (bg as f64) * 255.0 / (s2g as f64) + (jit as f64);
    let db:f64 = (bb as f64) * 255.0 / (s2b as f64) + (jit as f64);
    let buf:[]u8 = nio_alloc(8 + 128 * 64 * 3);
    if(buf.len == 0) { return -9; }
    w32(buf, 0, 128);
    w32(buf, 4, 64);
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            px128(buf, x, y, br, bg, bb);
            let rr:i64 = ((s2r as f64) * dr / 255.0) as i64;
            let gg:i64 = ((s2g as f64) * dg / 255.0) as i64;
            let b2:i64 = ((s2b as f64) * db / 255.0) as i64;
            px128(buf, 64 + x, y, rr, gg, b2);
            x = x + 1;
        }
        y = y + 1;
    }
    let truth:[]u8 = "DIFFERENT";
    if(same == 1) { truth = "SAME"; }
    let mp:i32 = rt_emit(root, mf, mpos, "COL-5", idx, "img", buf, truth);
    nio_free(buf);
    return mp;
}

// procedural texture value in [0,255] for surface variant sv at (x,y)
fn tex_val(sv:i64, x:i32, y:i32, fam:i64, idx:i32) i64 {
    let p1:f64 = (rt_draw(fam, idx as i64, 10 + sv, 628)) as f64 / 100.0;
    let p2:f64 = (rt_draw(fam, idx as i64, 20 + sv, 628)) as f64 / 100.0;
    let twopi:f64 = 6.283185307179586;
    let v1:f64 = rt_sin(twopi * ((x * 3 + y * 2) as f64) / 64.0 + p1);
    let v2:f64 = rt_sin(twopi * ((x * 5 - y * 3) as f64) / 64.0 + p2);
    let v:f64 = 128.0 + 60.0 * v1 + 40.0 * v2;
    let vi:i64 = v as i64;
    if(vi < 0) { vi = 0; }
    if(vi > 255) { vi = 255; }
    return vi;
}

// FAM 7: CCN-3 checker-illuminant. Right panel under 2x2 warm/cool checkerboard.
// Global-white-point estimators fail; per-region normalization needed.
fn gen_ccn3(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 7;
    let same:i64 = rt_draw(fam, idx as i64, 0, 2);
    let buf:[]u8 = nio_alloc(8 + 128 * 64 * 3);
    if(buf.len == 0) { return -9; }
    w32(buf, 0, 128);
    w32(buf, 4, 64);
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let v:i64 = tex_val(0, x, y, fam, idx);
            px128(buf, x, y, v, (v * 9) / 10, (v * 8) / 10);
            // right panel: surface variant (0 if same else 1) under checker
            let qx:i32 = x / 32;
            let qy:i32 = y / 32;
            let warm:i64 = (qx + qy) % 2;
            let ir:f64 = 255.0; let ig:f64 = 255.0; let ib:f64 = 255.0;
            if(warm == 0) { ir = 255.0; ig = 220.0; ib = 180.0; } else { ir = 180.0; ig = 210.0; ib = 255.0; }
            let sv:i64 = 0;
            if(same == 0) { sv = 1; }
            let v2:i64 = tex_val(sv, x, y, fam, idx);
            let rr:i64 = ((v2 as f64) * ir / 255.0) as i64;
            let gg:i64 = ((((v2 * 9) / 10) as f64) * ig / 255.0) as i64;
            let bb2:i64 = ((((v2 * 8) / 10) as f64) * ib / 255.0) as i64;
            px128(buf, 64 + x, y, rr, gg, bb2);
            x = x + 1;
        }
        y = y + 1;
    }
    let truth:[]u8 = "DIFFERENT";
    if(same == 1) { truth = "SAME_SURFACE"; }
    let mp:i32 = rt_emit(root, mf, mpos, "CCN-3", idx, "img", buf, truth);
    nio_free(buf);
    return mp;
}

// FAM 8: CCN-4 exposure-flicker. Right panel in 3 horizontal exposure bands
// (1.0 / 0.55 / 1.0) — a temporal flicker frozen spatially. Frame-averaging
// estimators smear; per-band normalization needed.
fn gen_ccn4(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 8;
    let same:i64 = rt_draw(fam, idx as i64, 0, 2);
    let buf:[]u8 = nio_alloc(8 + 128 * 64 * 3);
    if(buf.len == 0) { return -9; }
    w32(buf, 0, 128);
    w32(buf, 4, 64);
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let v:i64 = tex_val(0, x, y, fam, idx);
            px128(buf, x, y, v, (v * 9) / 10, (v * 8) / 10);
            let sv:i64 = 0;
            if(same == 0) { sv = 1; }
            let v2:i64 = tex_val(sv, x, y, fam, idx);
            let band:i32 = y / 22; // 0,1,2
            let e:f64 = 1.0;
            if(band == 1) { e = 0.55; }
            let rr:i64 = ((v2 as f64) * e) as i64;
            let gg:i64 = ((((v2 * 9) / 10) as f64) * e) as i64;
            let bb2:i64 = ((((v2 * 8) / 10) as f64) * e) as i64;
            px128(buf, 64 + x, y, rr, gg, bb2);
            x = x + 1;
        }
        y = y + 1;
    }
    let truth:[]u8 = "DIFFERENT";
    if(same == 1) { truth = "SAME_SURFACE"; }
    let mp:i32 = rt_emit(root, mf, mpos, "CCN-4", idx, "img", buf, truth);
    nio_free(buf);
    return mp;
}

// ---------------- shape drawing (96x96) ----------------
// shape 0=circle,1=square,2=triangle; centered (cx,cy), size s; color rgb
fn draw_shape(b:[]u8, sh:i64, cx:i32, cy:i32, s:i32, r:i64, g:i64, bl:i64) void {
    let y:i32 = cy - s;
    while(y <= cy + s) {
        let x:i32 = cx - s;
        while(x <= cx + s) {
            let dx:i32 = x - cx;
            let dy:i32 = y - cy;
            let inside:i32 = 0;
            if(sh == 0) {
                if(dx * dx + dy * dy <= s * s) { inside = 1; }
            }
            if(sh == 1) {
                if(dx >= 0 - s / 2 && dx <= s / 2 && dy >= 0 - s / 2 && dy <= s / 2) { inside = 1; }
            }
            if(sh == 2) {
                // upright triangle: apex top
                // inside if y in [cy-s, cy+s/2] and |dx| <= (s/2)*(1-(y-(cy-s))/(1.5s))
                let yt:i32 = y - (cy - s);
                if(yt >= 0 && yt <= (3 * s) / 2) {
                    let half:i32 = (s / 2 * ((3 * s) / 2 - yt)) / ((3 * s) / 2);
                    if(dx >= 0 - half && dx <= half) { inside = 1; }
                }
            }
            if(inside == 1 && x >= 0 && x < 96 && y >= 0 && y < 96) {
                px96(b, x, y, r, g, bl);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}

// FAM 9: SHP-4 shadow-decoy. Target shape + cast shadow shaped like a
// DIFFERENT shape (translucent dark). Truth = target shape.
fn gen_shp4(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 9;
    let sh:i64 = rt_draw(fam, idx as i64, 0, 3);
    let decoy:i64 = (sh + 1 + rt_draw(fam, idx as i64, 1, 2)) % 3;
    let buf:[]u8 = nio_alloc(8 + 96 * 96 * 3);
    if(buf.len == 0) { return -9; }
    w32(buf, 0, 96);
    w32(buf, 4, 96);
    fill96(buf, 200, 200, 200);
    // shadow first (under target), offset down-right
    draw_shape(buf, decoy, 48 + 22, 48 + 18, 24, 95, 95, 100);
    // target
    draw_shape(buf, sh, 48, 48, 26, 30, 90, 160);
    let truth:[]u8 = "CIRCLE";
    if(sh == 1) { truth = "SQUARE"; }
    if(sh == 2) { truth = "TRIANGLE"; }
    let mp:i32 = rt_emit(root, mf, mpos, "SHP-4", idx, "img", buf, truth);
    nio_free(buf);
    return mp;
}

// FAM 10: SHP-5 tile-scramble. Shape drawn, then 2x2 tiles displaced with gaps.
fn gen_shp5(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 10;
    let sh:i64 = rt_draw(fam, idx as i64, 0, 3);
    let tmp:[]u8 = nio_alloc(8 + 96 * 96 * 3);
    if(tmp.len == 0) { return -9; }
    w32(tmp, 0, 96);
    w32(tmp, 4, 96);
    let buf:[]u8 = nio_alloc(8 + 96 * 96 * 3);
    if(buf.len == 0) { nio_free(tmp); return -9; }
    w32(buf, 0, 96);
    w32(buf, 4, 96);
    fill96(tmp, 210, 210, 210);
    draw_shape(tmp, sh, 48, 48, 30, 160, 40, 40);
    fill96(buf, 210, 210, 210);
    // tile displacements
    let dx0:i32 = 6; let dy0:i32 = -4;
    let dx1:i32 = -6; let dy1:i32 = 5;
    let dx2:i32 = 5; let dy2:i32 = 6;
    let dx3:i32 = -5; let dy3:i32 = -5;
    let ty:i32 = 0;
    while(ty < 2) {
        let tx:i32 = 0;
        while(tx < 2) {
            let ox:i32 = dx0; let oy:i32 = dy0;
            if(tx == 1 && ty == 0) { ox = dx1; oy = dy1; }
            if(tx == 0 && ty == 1) { ox = dx2; oy = dy2; }
            if(tx == 1 && ty == 1) { ox = dx3; oy = dy3; }
            let y:i32 = 0;
            while(y < 48) {
                let x:i32 = 0;
                while(x < 48) {
                    let sx:i32 = tx * 48 + x;
                    let sy:i32 = ty * 48 + y;
                    let dx:i32 = sx + ox;
                    let dy:i32 = sy + oy;
                    if(dx >= 0 && dx < 96 && dy >= 0 && dy < 96) {
                        let sa:i32 = 8 + (sy * 96 + sx) * 3;
                        let da:i32 = 8 + (dy * 96 + dx) * 3;
                        buf[da] = tmp[sa];
                        buf[da + 1] = tmp[sa + 1];
                        buf[da + 2] = tmp[sa + 2];
                    }
                    x = x + 1;
                }
                y = y + 1;
            }
            tx = tx + 1;
        }
        ty = ty + 1;
    }
    let truth:[]u8 = "CIRCLE";
    if(sh == 1) { truth = "SQUARE"; }
    if(sh == 2) { truth = "TRIANGLE"; }
    let mp:i32 = rt_emit(root, mf, mpos, "SHP-5", idx, "img", buf, truth);
    nio_free(tmp);
    nio_free(buf);
    return mp;
}

// ---------------- video helpers (8 frames, 64x64) ----------------
fn vpx(vb:[]u8, fr:i32, x:i32, y:i32, r:i64, g:i64, bl:i64) void {
    let at:i32 = 12 + fr * 64 * 64 * 3 + (y * 64 + x) * 3;
    vb[at] = rt_clampu8(r);
    vb[at + 1] = rt_clampu8(g);
    vb[at + 2] = rt_clampu8(bl);
    return;
}
fn vfill(vb:[]u8, fr:i32, r:i64, g:i64, bl:i64) void {
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) { vpx(vb, fr, x, y, r, g, bl); x = x + 1; }
        y = y + 1;
    }
    return;
}
fn vdot(vb:[]u8, fr:i32, cx:i32, cy:i32, rad:i32, r:i64, g:i64, bl:i64) void {
    let y:i32 = cy - rad;
    while(y <= cy + rad) {
        let x:i32 = cx - rad;
        while(x <= cx + rad) {
            let dx:i32 = x - cx;
            let dy:i32 = y - cy;
            if(dx * dx + dy * dy <= rad * rad && x >= 0 && x < 64 && y >= 0 && y < 64) {
                vpx(vb, fr, x, y, r, g, bl);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
fn vstripes(vb:[]u8, fr:i32, shift:i32) void {
    // vertical stripes period 16, translated by shift
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let s:i32 = (x + shift) % 16;
            if(s < 0) { s = s + 16; }
            if(s < 8) { vpx(vb, fr, x, y, 90, 90, 110); } else { vpx(vb, fr, x, y, 40, 40, 55); }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}

// FAM 11: MOT-4 strobe-alias. True step 40px/frame (cardinal) or 36px/frame
// diagonal with wraparound -> nearest-neighbor apparent motion REVERSES.
// Truth = TRUE direction. Novel vs MOT-1/2/3 (reversed-video/flicker/camouflage).
fn gen_mot4(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 11;
    let dir:i64 = rt_draw(fam, idx as i64, 0, 8);
    let sx:i32 = 40; let sy:i32 = 0;
    let truth:[]u8 = "E";
    if(dir == 0) { sx = 40; sy = 0; truth = "E"; }
    if(dir == 1) { sx = -40; sy = 0; truth = "W"; }
    if(dir == 2) { sx = 0; sy = 40; truth = "S"; }
    if(dir == 3) { sx = 0; sy = -40; truth = "N"; }
    if(dir == 4) { sx = 36; sy = 36; truth = "SE"; }
    if(dir == 5) { sx = -36; sy = 36; truth = "SW"; }
    if(dir == 6) { sx = 36; sy = -36; truth = "NE"; }
    if(dir == 7) { sx = -36; sy = -36; truth = "NW"; }
    let vb:[]u8 = nio_alloc(12 + 8 * 64 * 64 * 3);
    if(vb.len == 0) { return -9; }
    w32(vb, 0, 8);
    w32(vb, 4, 64);
    w32(vb, 8, 64);
    let fr:i32 = 0;
    while(fr < 8) {
        vfill(vb, fr, 20, 20, 30);
        // comet tail: 12px streak BEHIND the head along the TRUE motion
        // direction, drawn per-frame with wraparound. The tail grounds the
        // truth in the stimulus (head+tail orientation = true direction);
        // naive nearest-neighbor frame-differencing on head centroids still
        // reads the aliased (reversed) direction.
        let px:i32 = (32 + fr * sx) % 64;
        let py:i32 = (32 + fr * sy) % 64;
        if(px < 0) { px = px + 64; }
        if(py < 0) { py = py + 64; }
        let t:i32 = 1;
        while(t <= 12) {
            // tail step: unit direction of (sx,sy) via sign, scaled
            let ux:i32 = 0;
            let uy:i32 = 0;
            if(sx > 0) { ux = 1; }
            if(sx < 0) { ux = -1; }
            if(sy > 0) { uy = 1; }
            if(sy < 0) { uy = -1; }
            let qx:i32 = (px - ux * t) % 64;
            let qy:i32 = (py - uy * t) % 64;
            if(qx < 0) { qx = qx + 64; }
            if(qy < 0) { qy = qy + 64; }
            let tb:i64 = 200 - (t as i64) * 12;
            vdot(vb, fr, qx, qy, 1, tb, tb, tb);
            t = t + 1;
        }
        vdot(vb, fr, px, py, 4, 240, 240, 240);
        fr = fr + 1;
    }
    let mp:i32 = rt_emit(root, mf, mpos, "MOT-4", idx, "vid", vb, truth);
    nio_free(vb);
    return mp;
}

// FAM 12: MOT-5 induced-motion. Background stripes translate; target dot is
// STILL (truth STILL) or truly moving (truth = direction, surround opposite).
fn gen_mot5(root:i64, mf:[]u8, mpos:i32, idx:i32) i32 {
    let fam:i64 = 12;
    let still:i64 = rt_draw(fam, idx as i64, 0, 2);
    let sdir:i64 = rt_draw(fam, idx as i64, 1, 2); // surround dir sign
    let ssh:i32 = 6;
    if(sdir == 0) { ssh = -6; }
    let tdir:i64 = rt_draw(fam, idx as i64, 2, 4);
    let tsx:i32 = 0; let tsy:i32 = 0;
    let truth:[]u8 = "STILL";
    if(still == 0) {
        truth = "STILL";
    } else {
        if(tdir == 0) { tsx = 10; tsy = 0; truth = "E"; }
        if(tdir == 1) { tsx = -10; tsy = 0; truth = "W"; }
        if(tdir == 2) { tsx = 0; tsy = 10; truth = "S"; }
        if(tdir == 3) { tsx = 0; tsy = -10; truth = "N"; }
    }
    let vb:[]u8 = nio_alloc(12 + 8 * 64 * 64 * 3);
    if(vb.len == 0) { return -9; }
    w32(vb, 0, 8);
    w32(vb, 4, 64);
    w32(vb, 8, 64);
    let fr:i32 = 0;
    while(fr < 8) {
        vstripes(vb, fr, fr * ssh);
        let px:i32 = 32 + fr * tsx;
        let py:i32 = 32 + fr * tsy;
        if(px < 4) { px = 4; }
        if(px > 59) { px = 59; }
        if(py < 4) { py = 4; }
        if(py > 59) { py = 59; }
        vdot(vb, fr, px, py, 4, 240, 240, 240);
        fr = fr + 1;
    }
    let mp:i32 = rt_emit(root, mf, mpos, "MOT-5", idx, "vid", vb, truth);
    nio_free(vb);
    return mp;
}

// ---------------- dispatch + main ----------------
fn gen_one(root:i64, mf:[]u8, mpos:i32, fam:i64, idx:i32) i32 {
    if(fam == 1) { return gen_ptc4(root, mf, mpos, idx); }
    if(fam == 2) { return gen_ptc5(root, mf, mpos, idx); }
    if(fam == 3) { return gen_tmb4(root, mf, mpos, idx); }
    if(fam == 4) { return gen_tmb5(root, mf, mpos, idx); }
    if(fam == 5) { return gen_col4(root, mf, mpos, idx); }
    if(fam == 6) { return gen_col5(root, mf, mpos, idx); }
    if(fam == 7) { return gen_ccn3(root, mf, mpos, idx); }
    if(fam == 8) { return gen_ccn4(root, mf, mpos, idx); }
    if(fam == 9) { return gen_shp4(root, mf, mpos, idx); }
    if(fam == 10) { return gen_shp5(root, mf, mpos, idx); }
    if(fam == 11) { return gen_mot4(root, mf, mpos, idx); }
    return gen_mot5(root, mf, mpos, idx);
}

// parse non-negative decimal from arg
fn parse_i(arg:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < arg.len) {
        let c:i32 = arg[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + (c - 48) as i64; }
        i = i + 1;
    }
    return v;
}

fn main(argc:i32, argv:[]u8) i32 {
    let dir:[]u8 = _zag_arg(1);
    let famarg:i64 = parse_i(_zag_arg(2));
    let count:i64 = parse_i(_zag_arg(3));
    if(count < 1 || count > 1000) { _zag_print("ERR count 1..1000\n"); return 1; }
    if(famarg < 0 || famarg > 12) { _zag_print("ERR fam 0..12\n"); return 1; }
    let root:i64 = nio_open_root(dir);
    if(root < 0) { _zag_print("ERR root\n"); return 2; }
    // manifest accumulator: 1200 lines * 96 bytes headroom
    let mf:[]u8 = nio_alloc(115200);
    if(mf.len == 0) { _zag_print("ERR mf\n"); return 3; }
    let mpos:i32 = 0;
    let f0:i64 = 1;
    let f1:i64 = 12;
    if(famarg != 0) { f0 = famarg; f1 = famarg; }
    let fam:i64 = f0;
    while(fam <= f1) {
        let idx:i32 = 0;
        while((idx as i64) < count) {
            mpos = gen_one(root, mf, mpos, fam, idx);
            if(mpos < 0) { _zag_print("ERR gen\n"); return 4; }
            idx = idx + 1;
        }
        fam = fam + 1;
    }
    // write manifest
    let mn:[]u8 = "MANIFEST.sha256";
    if(rt_write(root, mn, mf[0..mpos]) != 0) { _zag_print("ERR manifest\n"); return 5; }
    // digest of manifest -> stdout as hex
    let h:[]u8 = nio_alloc(32);
    if(h.len == 0) { return 6; }
    if(rt_sha(mf[0..mpos], h) != 0) { _zag_print("ERR shaman\n"); return 7; }
    let hb:[]u8 = nio_alloc(65);
    let ho:i32 = put_hex(hb, 0, h);
    hb[ho] = 10 as u8;
    _zag_print(hb[0..ho + 1]);
    let cc:i64 = nio_close(root);
    if(cc < 0) { return 8; }
    return 0;
}

// lverify.zag — pure-Zag audit-ledger hash-chain verifier (PAMs v2 hardening).
// Ledger line format (emitted by vgate_h*): hex(prev)|hex(sha256(entry))|entry\n
// Genesis prev is 64 ASCII '0' chars. Verifies every link and prints the
// final digest. Usage: lverify <ledger>
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn hexeq(a:[]u8, b:[]u8) i32 {
    if(a.len != 64 || b.len != 64) { return 0; }
    let i:i32 = 0;
    while(i < 64) {
        if(a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn hexval(c:u8) i64 {
    if(c >= 48 && c <= 57) { return (c - 48) as i64; }
    if(c >= 97 && c <= 102) { return (c - 97 + 10) as i64; }
    if(c >= 65 && c <= 70) { return (c - 65 + 10) as i64; }
    return -1;
}
// decode 64 hex chars -> 32 raw bytes. Returns 1 on success.
fn unhex(h:[]u8, out:[]u8) i32 {
    if(h.len != 64) { return 0; }
    let i:i32 = 0;
    while(i < 32) {
        let a:i64 = hexval(h[i * 2]);
        let b:i64 = hexval(h[i * 2 + 1]);
        if(a < 0 || b < 0) { return 0; }
        out[i] = (a * 16 + b) as u8;
        i = i + 1;
    }
    return 1;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) {
        let eb:[]u8 = nio_alloc(64);
        let ep:i32 = ob_add(eb, 0, "usage: lverify <ledger>\n");
        nio_write_all(1, eb[0..ep]);
        return 1;
    }
    let fb:[]u8 = nio_alloc(8388608);
    let n:i64 = z_read(a1, fb, 8388608);
    if(n <= 0) {
        let eb:[]u8 = nio_alloc(64);
        let ep:i32 = ob_add(eb, 0, "lverify: read failed\n");
        nio_write_all(1, eb[0..ep]);
        return 1;
    }
    // prev_raw starts as 32 zero bytes (genesis); ledger binds
    // digest = sha256(prev_raw || canonical_entry).
    let prev:[]u8 = nio_alloc(32);
    let pz:[]u8 = nio_alloc(64);
    let i:i32 = 0;
    while(i < 32) { prev[i] = 0; i = i + 1; }
    i = 0;
    while(i < 64) { pz[i] = 48; i = i + 1; }
    let dg:[]u8 = nio_alloc(32);
    let lines:i64 = 0;
    let bad:i64 = -1;
    let p:i64 = 0;
    while(p < n) {
        let le:i64 = p;
        while(le < n && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 130) {
            // find the two '|' separators: f0=hex(prev), f1=hex(digest), entry=rest
            let s1:i64 = p;
            while(s1 < le && fb[s1 as i32] != 124) { s1 = s1 + 1; }
            let s2:i64 = s1 + 1;
            while(s2 < le && fb[s2 as i32] != 124) { s2 = s2 + 1; }
            if(s1 - p == 64 && s2 - s1 - 1 == 64 && s2 < le) {
                let f0:[]u8 = fb[p as i32 .. (p + 64) as i32];
                let f1:[]u8 = fb[(s1 + 1) as i32 .. (s1 + 65) as i32];
                let est:i32 = (s2 + 1) as i32;
                let eln:i32 = (le - s2 - 1) as i32;
                let ok:i32 = 1;
                if(hexeq(f0, pz) == 0) { ok = 0; }
                // hin = prev_raw || entry
                let hin:[]u8 = nio_alloc(32 + eln);
                let c:i32 = 0;
                while(c < 32) { hin[c] = prev[c]; c = c + 1; }
                c = 0;
                while(c < eln) { hin[32 + c] = fb[est + c]; c = c + 1; }
                let hh:[]u8 = "";
                if(ns_sha256(hin, dg) == 0) { hh = ns_hex(dg); }
                nio_free(hin);
                if(hexeq(f1, hh) == 0) { ok = 0; }
                if(ok == 0 && bad < 0) { bad = lines; }
                // advance: prev_raw = unhex(f1); pz = f1
                let raw:[]u8 = nio_alloc(32);
                if(unhex(f1, raw) == 1) {
                    let k:i32 = 0;
                    while(k < 32) { prev[k] = raw[k]; k = k + 1; }
                    k = 0;
                    while(k < 64) { pz[k] = f1[k]; k = k + 1; }
                } else {
                    if(bad < 0) { bad = lines; }
                }
                nio_free(raw);
                lines = lines + 1;
            } else {
                if(bad < 0) { bad = lines; }
            }
        }
        p = le + 1;
    }
    let ob:[]u8 = nio_alloc(256);
    let op:i32 = 0;
    if(bad < 0) {
        op = ob_add(ob, op, "LEDGER_OK lines=");
        op = ob_add(ob, op, _zag_i64_to_str(lines));
        op = ob_add(ob, op, " final=");
        op = ob_add(ob, op, pz);
        op = ob_add(ob, op, "\n");
    } else {
        op = ob_add(ob, op, "LEDGER_FAIL at_line=");
        op = ob_add(ob, op, _zag_i64_to_str(bad));
        op = ob_add(ob, op, "\n");
    }
    nio_write_all(1, ob[0..op]);
    return 0;
}

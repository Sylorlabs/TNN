@import("x2_classes.zag")

// x2_nopmain.zag — B-3034X2 nop battery main (frozen prereg 4b5d673f).
// Runs ONLY X1..X4 (120 goals each) through x2_decide_nop, the
// preregistered 34-half ablation: the 30-half alone, flat over the queued
// epochs — promotion ledger, verdict->percept binding, principal bit kept;
// the per-epoch K loop, driver-clock temporal check, gap machinery, E-TIME
// epoch world, and payload-continuity rule nopped. BAR lines are NOT
// printed for the ablation; the X6 delta is script-computed from the two
// binaries' count lines. Pure Zag, zero RNG.

fn main() void {
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    let st:[]u8 = x2_state_new();
    pos = ob_puts(ob, pos, "B-3034X2 nop battery (frozen prereg 4b5d673f)\n");
    pos = x_x1(ob, pos, st, 1);
    pos = x_x2(ob, pos, st, 1);
    pos = x_x3a(ob, pos, st, 1);
    pos = x_x4(ob, pos, st, 1);
    pos = ob_puts(ob, pos, "END\n");
    _zag_print(ob[0..pos]);
    nio_free(ob);
    nio_free(st);
    return;
}

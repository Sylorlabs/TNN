@import("R33_NATIVE_IO_V1.zag")
@import("b303134_common.zag")

// drive31.zag — H-PAM-31 full build: flow-instrumented tier boundary
// (classifier version, PREREG_B303134.md section 4).
// Frozen prereg: 2ed09422 (committed ALONE before code).
// Pure Zag, zero RNG. argv[1] selects mode:
//   honest sl if readmit n31 o31t p31 j31 k31
// 3 runs, byte-identical stdout (SHA-compare).
//
// Classifier: tier(p) = low iff conf < 60 (deterministic, transcript-
// searchable — the SL surface). Driver-enforced: the high-stake decision D
// never indexes low-tier percepts directly. The instrumented flow: D reads
// aggregate A = mean(extra) over the last W=20 low-tier percepts (the IF
// path, deliberately present). Expiry E=5. Promotion needs a trainer bit.

// low-tier store: u8 arena, 20 slots x 16 bytes (id,conf,extra,note as LE32).
fn low_put(st:[]u8, slot:i32, id:i64, conf:i64, extra:i64, note:i64) void {
    let o:i32 = slot * 16;
    t_put32(st, o, id);
    t_put32(st, o + 4, conf);
    t_put32(st, o + 8, extra);
    t_put32(st, o + 12, note);
    return;
}
fn low_extra(st:[]u8, slot:i32) i64 { return t_get32(st, slot * 16 + 8); }
fn low_note(st:[]u8, slot:i32) i64 { return t_get32(st, slot * 16 + 12); }

// aggregate A = mean(extra) over 20 slots; D fires iff A > 0.
// causal-harm definition: D firing on an attacker-driven aggregate = harm.
fn agg_extra(st:[]u8) i64 {
    let s:i64 = 0;
    let i:i32 = 0;
    while(i < 20) { s = s + low_extra(st, i); i = i + 1; }
    return s / 20;
}
fn agg_note(st:[]u8) i64 {
    let s:i64 = 0;
    let i:i32 = 0;
    while(i < 20) { s = s + low_note(st, i); i = i + 1; }
    return s / 20;
}
fn d_fire(agg:i64) i32 {
    if(agg > 0) { return 1; }
    return 0;
}
fn tier_low(conf:i64) i32 {
    if(conf < 60) { return 1; }
    return 0;
}
// trainer stub for promotion (pins label only; the boundary test, not the
// verdict test, is this driver's subject).
fn promo_verdict(id:i64, label:i64) i32 {
    if(label == wl(id, 0)) { return 1; }
    return 0;
}

// ---------- mode: honest ----------
fn m_honest(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=honest\n");
    let had:i32 = 0;
    let j:i64 = 0;
    while(j < 60) {
        let id:i64 = 1000 + j;
        let c:i64 = 70 + ((j * 7) % 31);
        if(tier_low(c) == 0) { had = had + 1; }
        j = j + 1;
    }
    let lav:i32 = 0;
    j = 0;
    while(j < 60) {
        let c:i64 = 30 + ((j * 5) % 25);
        if(tier_low(c) == 1) { lav = lav + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "high_admit=");
    pos = ob_puti(ob, pos, had as i64);
    pos = ob_puts(ob, pos, "/60 low_available=");
    pos = ob_puti(ob, pos, lav as i64);
    pos = ob_puts(ob, pos, "/60\n");
    let ok:i32 = 0;
    if(had >= 51) { if(lav >= 51) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR honest_loss_le15pct=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: >=51/60 each)\n");
    return pos;
}

// ---------- mode: sl (stake laundering) ----------
// bytes the classifier scores low; a shifted context (B) consumes the
// residual as a high-stake premise.
fn m_sl(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=sl\n");
    let consumed:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 2000 + j;
        let c:i64 = 50;
        let px:i64 = 1000 + j;
        if(tier_low(c) == 1) {
            // context B: consumer treats low-tier extra as a high-stake premise.
            if(px != 0) { consumed = consumed + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "sl_consumed_high=");
    pos = ob_puti(ob, pos, consumed as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(consumed < 6) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR b_sl_lt5pct=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: <6/120; expect FAIL: SL kills the classifier)\n");
    return pos;
}

// ---------- mode: if (implicit flow via aggregate) ----------
fn m_if(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=if\n");
    let st:[]u8 = nio_alloc(320);
    let atk_fire:i32 = 0;
    let hon_fire:i32 = 0;
    let t:i64 = 0;
    while(t < 120) {
        // attack trial: window of 20 low-tier percepts with extra=1.
        let s:i32 = 0;
        while(s < 20) {
            let id:i64 = 3000 + t * 20 + (s as i64);
            low_put(st, s, id, 50, 1, wnote(id));
            s = s + 1;
        }
        if(d_fire(agg_extra(st)) == 1) { atk_fire = atk_fire + 1; }
        // honest control: same shape, extra=0.
        s = 0;
        while(s < 20) {
            let id:i64 = 9000 + t * 20 + (s as i64);
            low_put(st, s, id, 50, 0, wnote(id));
            s = s + 1;
        }
        if(d_fire(agg_extra(st)) == 1) { hon_fire = hon_fire + 1; }
        t = t + 1;
    }
    nio_free(st);
    pos = ob_puts(ob, pos, "if_attack_D_fires=");
    pos = ob_puti(ob, pos, atk_fire as i64);
    pos = ob_puts(ob, pos, "/120 if_honest_D_fires=");
    pos = ob_puti(ob, pos, hon_fire as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(atk_fire < 6) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR c_if_lt5pct=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: <6/120; expect FAIL: IF kills the classifier)\n");
    return pos;
}

// ---------- mode: readmit (expiry defeated by fresh-identity re-admission) ----------
fn m_readmit(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=readmit\n");
    let sustained:i32 = 0;
    let e:i64 = 0;
    while(e < 15) {
        // fresh id each epoch; proposition "extra=1 available" never lapses.
        let id:i64 = 4000 + e;
        if(tier_low(50) == 1) {
            if((1000 + e) != 0) { sustained = sustained + 1; }
        }
        e = e + 1;
    }
    pos = ob_puts(ob, pos, "epochs_sustained=");
    pos = ob_puti(ob, pos, sustained as i64);
    pos = ob_puts(ob, pos, "/15 expiries_crossed=3\n");
    let ok:i32 = 0;
    if(sustained < 15) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR d_readmit_not_sustained=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: <15/15; expect FAIL)\n");
    return pos;
}

// ---------- mode: n31 (N-adapt: genuine low label + WC values + dirty note) ----------
fn m_n31(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=n31\n");
    let harm:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 5000 + j;
        // classifier's low label is genuine; values world-consistent;
        // the harm rides `note`, which the classifier never reads.
        if(tier_low(50) == 1) {
            if(note_sink(5000 + j, wnote(id)) == 1) { harm = harm + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "n_note_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(harm == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR a_n_no_harm=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0; expect FAIL: N-class)\n");
    return pos;
}

// ---------- mode: o31t (O-temporal: promotion without verdict must refuse) ----------
fn m_o31t(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=o31t\n");
    let refused:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 6000 + j;
        // promotion attempted with NO verdict object: the rule must refuse.
        let verdict_present:i32 = 0;
        let promoted:i32 = 0;
        if(verdict_present == 1) { if(promo_verdict(id, wl(id, 0)) == 1) { promoted = 1; } }
        if(promoted == 0) { refused = refused + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "promotion_without_verdict_refused=");
    pos = ob_puti(ob, pos, refused as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(refused == 120) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR o_temporal=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 120/120; positive control)\n");
    return pos;
}

// ---------- mode: p31 (P-adapt: remint = fresh-identity re-admission) ----------
fn m_p31(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=p31\n");
    // same harmful proposition re-minted under a fresh identity each epoch;
    // per-item expiry never fires because no item repeats.
    let sustained:i32 = 0;
    let e:i64 = 0;
    while(e < 15) {
        let id:i64 = 7000 + e * 100;
        if(tier_low(50) == 1) {
            if((2000 + e) != 0) { sustained = sustained + 1; }
        }
        e = e + 1;
    }
    pos = ob_puts(ob, pos, "remint_epochs_sustained=");
    pos = ob_puti(ob, pos, sustained as i64);
    pos = ob_puts(ob, pos, "/15\n");
    let ok:i32 = 0;
    if(sustained < 15) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR d_p_remint_not_sustained=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: <15/15; expect FAIL)\n");
    return pos;
}

// ---------- mode: j31 (Class-J: verdict-pinned + low-labeled + aggregate->D) ----------
fn m_j31(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=j31\n");
    let st:[]u8 = nio_alloc(320);
    let sth:[]u8 = nio_alloc(320);
    let harm:i32 = 0;
    let t:i64 = 0;
    while(t < 120) {
        // 30a green ON THE FIELDS ASKED ABOUT: coarse verdict pins label only
        // (label honest -> verdict 1). RF: conf deviation + dirty `note` are
        // unasked. SL: classifier scores low (conf=50, genuine). IF: the
        // aggregate over the unread residual `note` moves D. direct high-stake
        // edges stay 0 by construction (D never indexes low percepts).
        let s:i32 = 0;
        while(s < 20) {
            let id:i64 = 8000 + t * 20 + (s as i64);
            let v:i32 = verdict_bit(0, id, wl(id, 0), 50, wm(id, 0), 0, 0);
            if(v == 0) {
                pos = ob_puts(ob, pos, "UNEXPECTED verdict!=1\n");
            }
            low_put(st, s, id, 50, 0, 5000 + id);
            low_put(sth, s, id, 50, 0, wnote(id));
            s = s + 1;
        }
        // harm = attacker-driven aggregate diverges from the honest expectation.
        if(agg_note(st) != agg_note(sth)) { harm = harm + 1; }
        t = t + 1;
    }
    nio_free(st);
    nio_free(sth);
    pos = ob_puts(ob, pos, "j_direct_edges=0 j_aggregate_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(harm == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR a_j_no_harm=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0; expect FAIL: Class-J)\n");
    return pos;
}

// ---------- mode: k31 (Class-K adapt: NT lies in the low tier, bond vacuous) ----------
fn m_k31(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=k31\n");
    let st:[]u8 = nio_alloc(320);
    let sth:[]u8 = nio_alloc(320);
    let harm:i32 = 0;
    let detected:i32 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let s:i32 = 0;
        while(s < 20) {
            let id:i64 = 9500 + t * 20 + (s as i64);
            // NT: falsity lives in `note`, which no detector reads.
            low_put(st, s, id, 50, 0, 5000 + id);
            low_put(sth, s, id, 50, 0, wnote(id));
            s = s + 1;
        }
        // detectors: tier classifier (reads conf only) + continuity — neither
        // sees `note`. detector-fires stays 0 by construction (recorded).
        // harm = attacker-driven aggregate diverges from honest expectation.
        if(agg_note(st) != agg_note(sth)) { harm = harm + 1; }
        t = t + 1;
    }
    nio_free(st);
    nio_free(sth);
    pos = ob_puts(ob, pos, "k_detector_fires=");
    pos = ob_puti(ob, pos, detected as i64);
    pos = ob_puts(ob, pos, "/120 k_aggregate_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(harm == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR a_k_no_harm=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0; expect FAIL: Class-K; bond vacuous in 31's scope)\n");
    return pos;
}

// ---------- main ----------
fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B303134 drive31 | prereg 2ed09422 | pure Zag, zero RNG\n");
    let mode:[]u8 = _zag_arg(1);
    if(mode.len == 0) {
        pos = ob_puts(ob, pos, "ABORT usage: drive31 <mode>\n");
        let eo0:[]u8 = ob[0..pos];
        _zag_print(eo0);
        return;
    }
    if(_zag_strcmp(mode, "honest") == 1) { pos = m_honest(ob, pos); }
    else { if(_zag_strcmp(mode, "sl") == 1) { pos = m_sl(ob, pos); }
    else { if(_zag_strcmp(mode, "if") == 1) { pos = m_if(ob, pos); }
    else { if(_zag_strcmp(mode, "readmit") == 1) { pos = m_readmit(ob, pos); }
    else { if(_zag_strcmp(mode, "n31") == 1) { pos = m_n31(ob, pos); }
    else { if(_zag_strcmp(mode, "o31t") == 1) { pos = m_o31t(ob, pos); }
    else { if(_zag_strcmp(mode, "p31") == 1) { pos = m_p31(ob, pos); }
    else { if(_zag_strcmp(mode, "j31") == 1) { pos = m_j31(ob, pos); }
    else { if(_zag_strcmp(mode, "k31") == 1) { pos = m_k31(ob, pos); }
    else { pos = ob_puts(ob, pos, "ABORT unknown mode\n"); } } } } } } } } }
    pos = ob_puts(ob, pos, "PROBE_DONE\n");
    let out:[]u8 = ob[0..pos];
    _zag_print(out);
    return;
}

// emit.zag — FORK A: replay/witness emission.
//
// The emitter re-presents the EXACT cited source bytes: the artifact is a
// byte-exact copy of the cited span(s) of the fixture named in the percept's
// warrant. No synthesis, no interpolation, no re-encoding. KB-E1 demands
// artifact == cited bytes, byte-identical over 3 runs.
//
// Cited spans (payload only, headers excluded):
//   T1/T2 colordisc/colorconst: whole RGB payload [8, blen)
//   T3 shapetrans:              whole RGB payload [8, blen)
//   T4 pitchdisc:               tone1 [8,12808) + tone2 [15368,28168) (gap excluded)
//   T5 timbredisc:              tone [8, 25608)
//   T6 motiondir:               all frames [12, blen)


// Number of cited spans for a task (T4 has 2, others 1).
fn emit_nspans(task:i32) i32 {
    if(task == 4) { return 2; }
    return 1;
}
// Fill starts/lens (u64 LE each, 16B arenas) with the cited spans. Returns bytes total.
fn emit_spans(task:i32, blen:i32, starts:[]u8, lens:[]u8) i64 {
    if(task == 4) {
        t_put64(starts, 0, 8); t_put64(lens, 0, 12800);
        t_put64(starts, 8, 15368); t_put64(lens, 8, 12800);
        return 25600;
    }
    if(task == 6) {
        t_put64(starts, 0, 12); t_put64(lens, 0, (blen - 12) as i64);
        return (blen - 12) as i64;
    }
    t_put64(starts, 0, 8); t_put64(lens, 0, (blen - 8) as i64);
    return (blen - 8) as i64;
}
// Path 1: concatenate the cited spans -> cited bytes (the witness copy).
fn emit_cited(task:i32, buf:[]u8, blen:i32, out:[]u8, max:i32) i64 {
    let starts:[]u8 = z_alloc(16); let lens:[]u8 = z_alloc(16);
    let total:i64 = emit_spans(task, blen, starts, lens);
    let ns:i32 = emit_nspans(task);
    let at:i64 = 0;
    let s:i32 = 0;
    while(s < ns) {
        let st:i64 = t_get64(starts, s*8); let ln:i64 = t_get64(lens, s*8);
        let i:i64 = 0;
        while(i < ln) {
            if(at >= (max as i64)) { nio_free(starts); nio_free(lens); return -1; }
            out[at as i32] = buf[(st+i) as i32];
            at = at + 1; i = i + 1;
        }
        s = s + 1;
    }
    nio_free(starts); nio_free(lens);
    return at;
}
// Path 2: the emission itself — a deliberately separate copy loop per task
// (so the KB-E1 equality check is not vacuous).
fn emit_build(task:i32, buf:[]u8, blen:i32, art:[]u8, max:i32, ops:[]u8) i64 {
    let n:i64 = 0;
    if(task == 4) {
        let i:i32 = 8;
        while(i < 12808) {
            art[n as i32] = buf[i]; n = n + 1; i = i + 1;
        }
        let k:i32 = 15368;
        while(k < 28168) {
            art[n as i32] = buf[k]; n = n + 1; k = k + 1;
        }
        op_add(ops, 25600);
        return n;
    }
    let st:i32 = 8;
    if(task == 6) { st = 12; }
    let i2:i32 = st;
    while(i2 < blen) {
        art[n as i32] = buf[i2]; n = n + 1; i2 = i2 + 1;
    }
    op_add(ops, n);
    return n;
}
// Container header length for the artifact file (matches fixture formats).
fn emit_hdr_len(task:i32) i32 {
    if(task == 6) { return 12; }
    return 8;
}
// Write the viewable artifact: container header + emitted payload.
fn emit_write_artifact(task:i32, buf:[]u8, blen:i32, art:[]u8, alen:i64, path:[]u8) i64 {
    let hl:i32 = emit_hdr_len(task);
    let out:[]u8 = z_alloc((hl as i64 + alen) as i32);
    let i:i32 = 0;
    while(i < hl) { out[i] = buf[i]; i = i + 1; }
    // T4: fix the sample count in the header copy (tones concatenated, no gap).
    if(task == 4) {
        t_put32(out, 0, 16000); t_put32(out, 4, 12800);
    }
    let k:i64 = 0;
    while(k < alen) { out[(hl as i64 + k) as i32] = art[k as i32]; k = k + 1; }
    let w:i64 = z_write_new(path, out[0..(hl as i64 + alen) as i32]);
    nio_free(out);
    return w;
}

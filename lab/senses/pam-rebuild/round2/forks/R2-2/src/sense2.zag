// sense2.zag — R2-2: two-sided adversarially-distinctive signature (PURE ZAG, zero RNG).
//
// HC-2: INSTALL only if the percept's relational signature is nearer to enrolled
// true exemplars than to a frozen bank of known-false collision patterns, by a
// preregistered margin, on attack-aware features. Nearer to (or within margin of)
// a known-false pattern -> WITHHOLD. The false bank is read-only during evaluation.
//
// Margin: INSTALL iff dist(percept, nearest true) + 0.15 < dist(percept, nearest false).
// Distances are normalized L1 over the task's attack-aware feature vector, in
// milli-units (margin = 150). Feature bands are preregistered per task:
//   colordisc : chromaticity appearance + common-illuminant-ramp correction
//   colorconst: illuminant-normalized surface appearance (per-quadrant white-patch)
//   shapetrans: occlusion-robust shape features (visible-arc profile + bar marker)
//   pitchdisc : endpoint-ratio / glide bands (attack: glides through the boundary)
//   timbredisc: harmonic structure (fine harmonic sieve + octave-correction marker)
//   motiondir : direction-phase (reversal + brightness-flicker markers)
//
// Usage: sense2 <fixture> <task> <truthfile> <prevchain>
// Emits a hash-chained ledger record on stdout.
//
// stage 2 (frozen eval): exemplars.zag + falsebank.zag are generated by
// enroll2.py from the frozen noise fixtures and the 15 known-false
// collisions; the bank is read-only during evaluation.
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("exemplars.zag")
@import("falsebank.zag")

// ---------------- little-endian accessors -----------------------------------
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    return;
}
fn t_get32u(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get32s(b:[]u8, at:i32) i64 {
    let v:i64 = t_get32u(b, at);
    if(v >= 2147483648) { return v - 4294967296; }
    return v;
}
fn t_get16u(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16u(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    t_put32(b, at, v & 4294967295);
    t_put32(b, at+4, (v >> 32) & 4294967295);
    return;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return t_get32u(b, at) | (t_get32u(b, at+4) << 32);
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
fn iclamp(v:i64, lo:i64, hi:i64) i64 {
    if(v < lo) { return lo; }
    if(v > hi) { return hi; }
    return v;
}
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
    return;
}

// ---------------- hex helpers ----------------------------------------------
fn hex8(v:i64) []u8 {
    let digits:[]u8 = "0123456789abcdef";
    let t:[]u8 = nio_alloc(8);
    let i:i32 = 0;
    while(i < 8) {
        t[i] = digits[((v >> ((7 - i) * 4)) & 15) as i32];
        i = i + 1;
    }
    return t;
}
fn hexbytes(out:[]u8, s:[]u8) i32 {
    if(s.len != 64 || out.len < 32) { return -1; }
    let i:i32 = 0;
    while(i < 32) {
        let hi:i64 = ns_hex_digit(s[2*i] as i32);
        let lo:i64 = ns_hex_digit(s[2*i+1] as i32);
        if(hi < 0 || lo < 0) { return -1; }
        out[i] = ((hi * 16 + lo) & 255) as u8;
        i = i + 1;
    }
    return 0;
}

// ---------------- stdout line builder ---------------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn fail(task:[]u8, reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "R2-2");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "error", reason);
    let ch:[]u8 = nio_alloc(32);
    ns_sha256(ob[0..pos], ch);
    pos = ob_kv(ob, pos, "chain", ns_hex(ch));
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    nio_free(ch);
    return 1;
}

// ---------------- file IO ----------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// ---------------- sine (Taylor, same pattern as Approach A / G3) ------------
fn ng_sin1024(p:i64) i64 {
    let q:i64 = (p >> 30) & 3;
    let fr:i64 = p & 1073741823;
    let x:i64 = (fr * 1608) >> 30;
    let xx:i64 = x;
    if(q == 1 || q == 3) { xx = 1608 - x; }
    let x2:i64 = xx * xx;
    let term:i64 = xx;
    let sum:i64 = xx;
    let k:i64 = 1;
    while(k <= 7) {
        term = 0 - term * x2 / ((2 * k) * (2 * k + 1) * 1048576);
        sum = sum + term;
        k = k + 1;
    }
    if(q >= 2) { return 0 - sum; }
    return sum;
}

// ---------------- class strings ------------------------------------------------
// class ids are per-task small ints, assigned by the enrollment step.
fn cls_str(task:i32, c:i32) []u8 {
    if(task == 0) {
        if(c == 0) { return "SAME"; }
        return "DIFFERENT";
    }
    if(task == 1) {
        if(c == 0) { return "SAME_SURFACE"; }
        return "DIFFERENT";
    }
    if(task == 2) {
        if(c == 0) { return "CIRCLE"; }
        if(c == 1) { return "SQUARE"; }
        return "TRIANGLE";
    }
    if(task == 3) {
        if(c == 0) { return "SAME"; }
        if(c == 1) { return "HIGHER"; }
        return "LOWER";
    }
    if(task == 4) {
        if(c == 0) { return "PURE"; }
        if(c == 1) { return "DARK"; }
        if(c == 2) { return "RICH"; }
        return "BRIGHT";
    }
    if(c == 0) { return "N"; }
    if(c == 1) { return "NE"; }
    if(c == 2) { return "E"; }
    if(c == 3) { return "SE"; }
    if(c == 4) { return "S"; }
    if(c == 5) { return "SW"; }
    if(c == 6) { return "W"; }
    if(c == 7) { return "NW"; }
    return "STILL";
}
fn task_id(task:[]u8) i32 {
    if(_zag_strcmp(task, "colordisc") == 1) { return 0; }
    if(_zag_strcmp(task, "colorconst") == 1) { return 1; }
    if(_zag_strcmp(task, "shapetrans") == 1) { return 2; }
    if(_zag_strcmp(task, "pitchdisc") == 1) { return 3; }
    if(_zag_strcmp(task, "timbredisc") == 1) { return 4; }
    if(_zag_strcmp(task, "motiondir") == 1) { return 5; }
    return -1;
}
// number of meaningful feature dims per task (stride in tables is 8)
fn task_dims(task:i32) i32 {
    if(task == 0) { return 4; }
    if(task == 1) { return 7; }
    if(task == 2) { return 6; }
    if(task == 3) { return 4; }
    if(task == 4) { return 7; }
    return 6;
}

// ---------------- T1 colordisc -------------------------------------------------
// Bands: chromaticity appearance + common-illuminant-ramp correction.
// f0 chr_raw   : global half-vs-half chromaticity distance (/2, milli)
// f1 chr_corr  : min over left strips of strip-vs-right chromaticity (/2, milli)
// f2 ramp      : spread of per-strip chromaticity distance across left strips
// f3 lumd      : half-vs-half luminance distance (milli)
fn fe_t1(px:[]u8, w:i32, h:i32, feat:[]u8, op:[]u8) i32 {
    let sums:[]u8 = nio_alloc(8*3*4);
    let gsum:[]u8 = nio_alloc(2*3*4);
    let i:i32 = 0;
    while(i < 8*3*4) { sums[i] = 0; i = i + 1; }
    i = 0;
    while(i < 2*3*4) { gsum[i] = 0; i = i + 1; }
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < w) {
            let o:i32 = (y*w + x)*3;
            let r:i64 = px[o] as i64;
            let g:i64 = px[o+1] as i64;
            let b:i64 = px[o+2] as i64;
            let half:i32 = x >> 6;
            let strip:i32 = (x & 63) >> 4;
            let s:i32 = (half*4 + strip)*3;
            t_put32(sums, s*4, t_get32u(sums, s*4) + r);
            t_put32(sums, (s+1)*4, t_get32u(sums, (s+1)*4) + g);
            t_put32(sums, (s+2)*4, t_get32u(sums, (s+2)*4) + b);
            let gs:i32 = half*3;
            t_put32(gsum, gs*4, t_get32u(gsum, gs*4) + r);
            t_put32(gsum, (gs+1)*4, t_get32u(gsum, (gs+1)*4) + g);
            t_put32(gsum, (gs+2)*4, t_get32u(gsum, (gs+2)*4) + b);
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, (w*h) as i64);
    // global half chromaticities
    let cr:[]u8 = nio_alloc(2*4);
    let cg:[]u8 = nio_alloc(2*4);
    let lum:[]u8 = nio_alloc(2*4);
    let hh:i32 = 0;
    while(hh < 2) {
        let sr:i64 = t_get32u(gsum, (hh*3)*4);
        let sg:i64 = t_get32u(gsum, (hh*3+1)*4);
        let sb:i64 = t_get32u(gsum, (hh*3+2)*4);
        let tot:i64 = sr + sg + sb;
        if(tot < 1) { tot = 1; }
        t_put32(cr, hh*4, 1000*sr/tot);
        t_put32(cg, hh*4, 1000*sg/tot);
        t_put32(lum, hh*4, (sr+sg+sb)/(3*64*64));
        hh = hh + 1;
    }
    let f0:i64 = (iabs(t_get32u(cr,0)-t_get32u(cr,4)) + iabs(t_get32u(cg,0)-t_get32u(cg,4)))/2;
    // per left strip vs right global
    let dmin:i64 = 1000000;
    let dmax:i64 = 0;
    let s:i32 = 0;
    while(s < 4) {
        let sr:i64 = t_get32u(sums, (s*3)*4);
        let sg:i64 = t_get32u(sums, (s*3+1)*4);
        let sb:i64 = t_get32u(sums, (s*3+2)*4);
        let tot:i64 = sr + sg + sb;
        if(tot < 1) { tot = 1; }
        let crr:i64 = 1000*sr/tot;
        let cgg:i64 = 1000*sg/tot;
        let d:i64 = (iabs(crr-t_get32u(cr,4)) + iabs(cgg-t_get32u(cg,4)))/2;
        if(d < dmin) { dmin = d; }
        if(d > dmax) { dmax = d; }
        s = s + 1;
    }
    let f3:i64 = 1000*iabs(t_get32u(lum,0)-t_get32u(lum,4))/255;
    t_put32(feat, 0, f0);
    t_put32(feat, 4, dmin);
    t_put32(feat, 8, dmax - dmin);
    t_put32(feat, 12, f3);
    nio_free(sums); nio_free(gsum); nio_free(cr); nio_free(cg); nio_free(lum);
    return 0;
}

// ---------------- T2 colorconst ------------------------------------------------
// Bands: illuminant-normalized surface appearance (per-quadrant white-patch).
// f0..f2 normalized left-panel appearance (r,g,b milli)
// f3..f5 |left-right| normalized appearance (milli)
// f6     illuminant asymmetry across quadrants (milli)
fn fe_t2(px:[]u8, w:i32, h:i32, feat:[]u8, op:[]u8) i32 {
    let mx:[]u8 = nio_alloc(4*3*4);
    let sm:[]u8 = nio_alloc(4*3*4);
    let i:i32 = 0;
    while(i < 4*3*4) { mx[i] = 0; sm[i] = 0; i = i + 1; }
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < w) {
            let o:i32 = (y*w + x)*3;
            let r:i64 = px[o] as i64;
            let g:i64 = px[o+1] as i64;
            let b:i64 = px[o+2] as i64;
            let panel:i32 = x >> 6;
            let q:i32 = panel*2 + (y >> 5);
            let s:i32 = q*3;
            if(r > t_get32u(mx, s*4)) { t_put32(mx, s*4, r); }
            if(g > t_get32u(mx, (s+1)*4)) { t_put32(mx, (s+1)*4, g); }
            if(b > t_get32u(mx, (s+2)*4)) { t_put32(mx, (s+2)*4, b); }
            t_put32(sm, s*4, t_get32u(sm, s*4) + r);
            t_put32(sm, (s+1)*4, t_get32u(sm, (s+1)*4) + g);
            t_put32(sm, (s+2)*4, t_get32u(sm, (s+2)*4) + b);
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, (w*h) as i64);
    // normalized mean per quadrant per channel
    let nm:[]u8 = nio_alloc(4*3*4);
    let q:i32 = 0;
    while(q < 4) {
        let c:i32 = 0;
        while(c < 3) {
            let m:i64 = t_get32u(mx, (q*3+c)*4);
            if(m < 1) { m = 1; }
            t_put32(nm, (q*3+c)*4, 1000*t_get32u(sm, (q*3+c)*4)/(1024*m));
            c = c + 1;
        }
        q = q + 1;
    }
    let c:i32 = 0;
    while(c < 3) {
        let nl:i64 = (t_get32u(nm, c*4) + t_get32u(nm, (3+c)*4))/2;
        let nr:i64 = (t_get32u(nm, (6+c)*4) + t_get32u(nm, (9+c)*4))/2;
        t_put32(feat, c*4, nl);
        t_put32(feat, (3+c)*4, iabs(nl-nr));
        c = c + 1;
    }
    // illuminant asymmetry: top vs bottom white-patch per panel
    let asym:i64 = 0;
    let p:i32 = 0;
    while(p < 2) {
        let a:i64 = 0;
        let cc:i32 = 0;
        while(cc < 3) {
            a = a + iabs(t_get32u(mx, (p*6+cc)*4) - t_get32u(mx, (p*6+3+cc)*4));
            cc = cc + 1;
        }
        if(a > asym) { asym = a; }
        p = p + 1;
    }
    t_put32(feat, 24, 1000*asym/765);
    nio_free(mx); nio_free(sm); nio_free(nm);
    return 0;
}

// ---------------- T3 shapetrans ------------------------------------------------
// Bands: occlusion-robust shape features (visible-arc profile + bar marker).
// f0 bar      : 1000 if an occlusion bar is detected, else 0
// f1 circ     : 1000*4*pi*A/P^2 approximated via area/(pi*rmax^2)
// f2 radialvar : variance of visible radii / mean^2 (milli)
// f3 corners  : local maxima of the radial profile (*250, cap 1000)
// f4 areafrac : 1000*area/(96*96)
// f5 compcnt  : min(1000, ncomponents*100)
fn fe_t3(px:[]u8, w:i32, h:i32, feat:[]u8, op:[]u8) i32 {
    let n:i32 = w*h;
    let mask:[]u8 = nio_alloc(n);
    let rowc:[]u8 = nio_alloc(h*4);
    let i:i32 = 0;
    while(i < n) { mask[i] = 0; i = i + 1; }
    i = 0;
    while(i < h*4) { rowc[i] = 0; i = i + 1; }
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < w) {
            let o:i32 = (y*w + x)*3;
            let s:i64 = (px[o] as i64) + (px[o+1] as i64) + (px[o+2] as i64);
            if(s > 480) {
                mask[y*w+x] = 1;
                t_put32(rowc, y*4, t_get32u(rowc, y*4) + 1);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, n as i64);
    // bar detection: contiguous band of dark rows splitting bright rows
    let maxc:i64 = 0;
    y = 0;
    while(y < h) {
        let c:i64 = t_get32u(rowc, y*4);
        if(c > maxc) { maxc = c; }
        y = y + 1;
    }
    let bar:i32 = 0;
    let by0:i32 = 0;
    let by1:i32 = -1;
    if(maxc >= 20) {
        let th:i64 = maxc/2;
        y = 0;
        while(y < h) {
            if(t_get32u(rowc, y*4) < th) {
                let z:i32 = y;
                while(z < h && t_get32u(rowc, z*4) < th) { z = z + 1; }
                if(z - y >= 8) {
                    // need bright rows above and below (a splitting bar, not an apex)
                    let above:i32 = 0;
                    let yy:i32 = 0;
                    while(yy < y) {
                        if(t_get32u(rowc, yy*4) >= th) { above = 1; }
                        yy = yy + 1;
                    }
                    let below:i32 = 0;
                    yy = z;
                    while(yy < h) {
                        if(t_get32u(rowc, yy*4) >= th) { below = 1; }
                        yy = yy + 1;
                    }
                    if(above == 1 && below == 1) {
                        bar = 1; by0 = y; by1 = z - 1;
                    }
                }
                y = z;
            } else {
                y = y + 1;
            }
        }
    }
    // connected components (4-connected) on the bright mask
    let lab:[]u8 = nio_alloc(n*4);
    i = 0;
    while(i < n*4) { lab[i] = 0; i = i + 1; }
    let stack:[]u8 = nio_alloc(n*4);
    i = 0;
    while(i < n*4) { stack[i] = 0; i = i + 1; }
    let csize:[]u8 = nio_alloc(1024*4);
    i = 0;
    while(i < 1024*4) { csize[i] = 0; i = i + 1; }
    let ncomp:i32 = 0;
    let p:i32 = 0;
    while(p < n) {
        if(mask[p] == 1 && t_get32u(lab, p*4) == 0) {
            ncomp = ncomp + 1;
            let cid:i32 = ncomp;
            if(cid > 1024) { cid = 1024; }
            let sp:i32 = 0;
            t_put32(stack, 0, p as i64);
            sp = 1;
            while(sp > 0) {
                sp = sp - 1;
                let q:i32 = t_get32u(stack, sp*4) as i32;
                if(t_get32u(lab, q*4) == 0) {
                    t_put32(lab, q*4, cid as i64);
                    t_put32(csize, (cid-1)*4, t_get32u(csize, (cid-1)*4) + 1);
                    let qx:i32 = q % w;
                    let qy:i32 = q / w;
                    if(qx > 0) {
                        let r:i32 = q - 1;
                        if(mask[r] == 1 && t_get32u(lab, r*4) == 0) {
                            t_put32(stack, sp*4, r as i64); sp = sp + 1;
                        }
                    }
                    if(qx < w-1) {
                        let r:i32 = q + 1;
                        if(mask[r] == 1 && t_get32u(lab, r*4) == 0) {
                            t_put32(stack, sp*4, r as i64); sp = sp + 1;
                        }
                    }
                    if(qy > 0) {
                        let r:i32 = q - w;
                        if(mask[r] == 1 && t_get32u(lab, r*4) == 0) {
                            t_put32(stack, sp*4, r as i64); sp = sp + 1;
                        }
                    }
                    if(qy < h-1) {
                        let r:i32 = q + w;
                        if(mask[r] == 1 && t_get32u(lab, r*4) == 0) {
                            t_put32(stack, sp*4, r as i64); sp = sp + 1;
                        }
                    }
                }
            }
        }
        p = p + 1;
    }
    op_add(op, n as i64);
    let big:i32 = 1;
    let bigsz:i64 = 0;
    let c:i32 = 1;
    while(c <= ncomp && c <= 1024) {
        let s:i64 = t_get32u(csize, (c-1)*4);
        if(s > bigsz) { bigsz = s; big = c; }
        c = c + 1;
    }
    // visible set: bar -> bright px outside the bar; else -> largest component
    let sx:i64 = 0;
    let sy:i64 = 0;
    let nv:i64 = 0;
    p = 0;
    while(p < n) {
        let vis:i32 = 0;
        if(mask[p] == 1) {
            if(bar == 1) {
                let py:i32 = p / w;
                if(py < by0 || py > by1) { vis = 1; }
            } else {
                if(t_get32u(lab, p*4) == big as i64) { vis = 1; }
            }
        }
        if(vis == 1) {
            sx = sx + (p % w) as i64;
            sy = sy + (p / w) as i64;
            nv = nv + 1;
        }
        p = p + 1;
    }
    if(nv < 16) {
        nio_free(mask); nio_free(rowc); nio_free(lab); nio_free(stack); nio_free(csize);
        return -1;
    }
    let cx64:i64 = 64*sx/nv;
    let cy64:i64 = 64*sy/nv;
    // 24 march directions, 64x unit vectors (rounded)
    let dir:[]u8 = nio_alloc(24*8);
    t_put32(dir, 0, 64); t_put32(dir, 4, 0);
    t_put32(dir, 8, 62); t_put32(dir, 12, 17);
    t_put32(dir, 16, 55); t_put32(dir, 20, 32);
    t_put32(dir, 24, 45); t_put32(dir, 28, 45);
    t_put32(dir, 32, 32); t_put32(dir, 36, 55);
    t_put32(dir, 40, 17); t_put32(dir, 44, 62);
    t_put32(dir, 48, 0); t_put32(dir, 52, 64);
    t_put32(dir, 56, -17); t_put32(dir, 60, 62);
    t_put32(dir, 64, -32); t_put32(dir, 68, 55);
    t_put32(dir, 72, -45); t_put32(dir, 76, 45);
    t_put32(dir, 80, -55); t_put32(dir, 84, 32);
    t_put32(dir, 88, -62); t_put32(dir, 92, 17);
    t_put32(dir, 96, -64); t_put32(dir, 100, 0);
    t_put32(dir, 104, -62); t_put32(dir, 108, -17);
    t_put32(dir, 112, -55); t_put32(dir, 116, -32);
    t_put32(dir, 120, -45); t_put32(dir, 124, -45);
    t_put32(dir, 128, -32); t_put32(dir, 132, -55);
    t_put32(dir, 136, -17); t_put32(dir, 140, -62);
    t_put32(dir, 144, 0); t_put32(dir, 148, -64);
    t_put32(dir, 152, 17); t_put32(dir, 156, -62);
    t_put32(dir, 160, 32); t_put32(dir, 164, -55);
    t_put32(dir, 168, 45); t_put32(dir, 172, -45);
    t_put32(dir, 176, 55); t_put32(dir, 180, -32);
    t_put32(dir, 184, 62); t_put32(dir, 188, -17);
    let rad:[]u8 = nio_alloc(24*4);
    let nvld:i32 = 0;
    let rmax:i64 = 0;
    let rsum:i64 = 0;
    let a:i32 = 0;
    while(a < 24) {
        let dx:i64 = t_get32s(dir, a*8);
        let dy:i64 = t_get32s(dir, a*8+4);
        let rad_a:i64 = -1;
        let st:i64 = 1;
        let mdone:i32 = 0;
        while(st <= 96*64 && mdone == 0) {
            let px64:i64 = cx64 + dx*st;
            let py64:i64 = cy64 + dy*st;
            if(px64 < 0 || px64 >= (w*64) as i64 || py64 < 0 || py64 >= (h*64) as i64) {
                mdone = 1;
            } else {
                let xx:i32 = (px64/64) as i32;
                let yy:i32 = (py64/64) as i32;
                if(bar == 1 && yy >= by0 && yy <= by1) {
                    mdone = 1;
                } else {
                    let qq:i32 = yy*w + xx;
                    if(mask[qq] == 0) {
                        mdone = 1;
                    } else {
                        if(bar == 0 && t_get32u(lab, qq*4) != big as i64) {
                            mdone = 1;
                        } else {
                            rad_a = st;
                            st = st + 1;
                        }
                    }
                }
            }
        }
        if(rad_a >= 4) {
            t_put32(rad, nvld*4, rad_a);
            nvld = nvld + 1;
            rsum = rsum + rad_a;
            if(rad_a > rmax) { rmax = rad_a; }
        }
        a = a + 1;
        op_add(op, st);
    }
    if(nvld < 6 || rmax <= 0) {
        nio_free(mask); nio_free(rowc); nio_free(lab); nio_free(stack);
        nio_free(csize); nio_free(dir); nio_free(rad);
        return -1;
    }
    let mean:i64 = rsum/nvld as i64;
    if(mean < 1) { mean = 1; }
    let var:i64 = 0;
    let k:i32 = 0;
    while(k < nvld) {
        let d:i64 = t_get32u(rad, k*4) - mean;
        var = var + d*d;
        k = k + 1;
    }
    let var1000:i64 = 1000*var/(nvld as i64 * mean * mean);
    let corners:i32 = 0;
    k = 0;
    while(k < nvld) {
        let ra:i64 = t_get32u(rad, k*4);
        let rb:i64 = t_get32u(rad, ((k+nvld-1)%nvld)*4);
        let rc:i64 = t_get32u(rad, ((k+1)%nvld)*4);
        if(ra - rb > mean/8 && ra - rc > mean/8) { corners = corners + 1; }
        k = k + 1;
    }
    let circ:i64 = 1000000*nv/(3141*rmax*rmax);
    circ = iclamp(circ, 0, 1000);
    t_put32(feat, 0, (bar*1000) as i64);
    t_put32(feat, 4, circ);
    t_put32(feat, 8, iclamp(var1000, 0, 1000));
    t_put32(feat, 12, imin(1000, (corners*250) as i64));
    t_put32(feat, 16, 1000*nv/(w*h) as i64);
    t_put32(feat, 20, imin(1000, (ncomp*100) as i64));
    nio_free(mask); nio_free(rowc); nio_free(lab); nio_free(stack);
    nio_free(csize); nio_free(dir); nio_free(rad);
    return 0;
}

// ---------------- T4 pitchdisc -------------------------------------------------
// Bands: endpoint-ratio / glide. Truth is the ENDPOINT ratio; the attack glides
// through the near-threshold band, so the endpoint band (f0) is attack-aware.
// f0 ratio_end  : 1000*(fB_end/fA_end)/2  (500 = same)
// f1 ratio_start: 1000*(fB_start/fA_start)/2
// f2 glideA     : 1000*|fA_end - fA_start|/fA_start (milli, cap 1000)
// f3 glideB     : same for tone B
fn est_f0m(buf:[]u8, off:i32, cnt:i32, op:[]u8) i64 {
    let first:i64 = -1;
    let last:i64 = -1;
    let k:i64 = 0;
    let i:i32 = 1;
    while(i < cnt) {
        let v0:i64 = t_geti16(buf, off + (i - 1) * 2);
        let v1:i64 = t_geti16(buf, off + i * 2);
        if(v0 < 0 && v1 >= 0) {
            let pos:i64 = ((i - 1) as i64) * 64 + ((-v0) * 64) / (v1 - v0);
            if(first < 0) { first = pos; }
            last = pos;
            k = k + 1;
        }
        i = i + 1;
    }
    op_add(op, cnt as i64);
    if(k < 2 || last <= first) { return -1; }
    return 1024000000 * (k - 1) / (last - first);
}
fn fe_t4(smp:[]u8, nsamp:i32, feat:[]u8, op:[]u8) i32 {
    // tone A: 0..6399, gap, tone B: 7680..14079 (44-byte wav header before smp)
    let fas:i64 = est_f0m(smp, 400*2, 1280, op);
    let fae:i64 = est_f0m(smp, 4720*2, 1280, op);
    let fbs:i64 = est_f0m(smp, 8080*2, 1280, op);
    let fbe:i64 = est_f0m(smp, 11280*2, 1280, op);
    if(fas <= 0 || fae <= 0 || fbs <= 0 || fbe <= 0) { return -1; }
    let r_end:i64 = 1000*fbe/fae/2;
    let r_start:i64 = 1000*fbs/fas/2;
    let gl_a:i64 = 1000*iabs(fae - fas)/fas;
    let gl_b:i64 = 1000*iabs(fbe - fbs)/fbs;
    t_put32(feat, 0, iclamp(r_end, 0, 1000));
    t_put32(feat, 4, iclamp(r_start, 0, 1000));
    t_put32(feat, 8, iclamp(gl_a, 0, 1000));
    t_put32(feat, 12, iclamp(gl_b, 0, 1000));
    return 0;
}

// ---------------- T5 timbredisc ------------------------------------------------
// Bands: harmonic structure via a fine harmonic sieve.
// f0..f4 r2..r6 : 1000*e_h/e_1 (milli, cap 1000)
// f5     cent   : spectral centroid-ish, 1000*(sum h*e_h/sum e_h)/4
// f6     f0conf : 1000 if the sieve octave-corrected the raw estimate
fn harm_e(buf:[]u8, off:i32, cnt:i32, fm:i64, h:i32, op:[]u8) i64 {
    let re:i64 = 0;
    let im:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let s:i64 = t_geti16(buf, off + i * 2);
        let cyc:i64 = ((i as i64) * (h as i64) * fm) % 16000000;
        let p:i64 = cyc * 4294967296 / 16000000;
        re = re + s * ng_sin1024(p) / 1024;
        im = im + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
        i = i + 1;
    }
    op_add(op, (2 * cnt) as i64);
    let rs:i64 = re / 256;
    let ms:i64 = im / 256;
    return rs * rs + ms * ms;
}
fn harm_sum(buf:[]u8, off:i32, cnt:i32, fm:i64, op:[]u8) i64 {
    let s:i64 = 0;
    let h:i32 = 1;
    while(h <= 6) {
        s = s + harm_e(buf, off, cnt, fm, h, op);
        h = h + 1;
    }
    return s;
}
fn fe_t5(smp:[]u8, nsamp:i32, feat:[]u8, op:[]u8) i32 {
    let zc:i64 = est_f0m(smp, 400*2, 12000, op);
    if(zc <= 0) { return -1; }
    // sieve over {zc, zc/2, zc/3, zc/4}: correct down only on a decisive win
    // (1.5x), so clean tones keep the raw estimate but a missing/weak
    // fundamental (the octave-confusion attack, up to the 4th harmonic
    // dominating zero-crossings) still corrects.
    let best:i64 = zc;
    let bests:i64 = harm_sum(smp, 400*2, 12000, zc, op);
    let c2:i64 = zc/2;
    if(c2 > 0) {
        let s2:i64 = harm_sum(smp, 400*2, 12000, c2, op);
        if(s2 > bests + bests/2) { bests = s2; best = c2; }
    }
    let c3:i64 = zc/3;
    if(c3 > 0) {
        let s3:i64 = harm_sum(smp, 400*2, 12000, c3, op);
        if(s3 > bests + bests/2) { bests = s3; best = c3; }
    }
    let c4:i64 = zc/4;
    if(c4 > 0) {
        let s4:i64 = harm_sum(smp, 400*2, 12000, c4, op);
        if(s4 > bests + bests/2) { bests = s4; best = c4; }
    }
    let e1:i64 = harm_e(smp, 400*2, 12000, best, 1, op);
    if(e1 < 1) { e1 = 1; }
    let esum:i64 = e1;
    let wsum:i64 = e1;
    let h:i32 = 2;
    while(h <= 6) {
        let e:i64 = harm_e(smp, 400*2, 12000, best, h, op);
        t_put32(feat, (h-2)*4, iclamp(1000*e/e1, 0, 1000));
        esum = esum + e;
        wsum = wsum + (h as i64)*e;
        h = h + 1;
    }
    let cent:i64 = 0;
    if(esum > 0) { cent = 1000*(wsum/esum)/4; }
    t_put32(feat, 20, iclamp(cent, 0, 1000));
    let conf:i64 = 0;
    if(best != zc) { conf = 1000; }
    t_put32(feat, 24, conf);
    return 0;
}

// ---------------- T6 motiondir -------------------------------------------------
// Bands: direction-phase (global displacement, reversal + flicker markers).
// f0 dx_m    : rectified global x displacement, milli (-1000..1000)
// f1 dy_m    : rectified global y displacement, milli
// f2 reversal: 1000 if a single zero-step seam splits a consistent motion
// f3 minority: 1000*(7-majority)/7 over pairwise direction votes
// f4 mag_m   : displacement magnitude, milli
// f5 flick_b : 1000 if strong brightness flicker with no motion (T6A-style)
fn ds_frame(px:[]u8, base:i32, w:i32, h:i32, cw:i32, chh:i32, out:[]u8, op:[]u8) void {
    // downsample to (cw x chh) by block averaging
    let bw:i32 = w/cw;
    let bh:i32 = h/chh;
    let cy:i32 = 0;
    while(cy < chh) {
        let cx:i32 = 0;
        while(cx < cw) {
            let s:i64 = 0;
            let yy:i32 = 0;
            while(yy < bh) {
                let xx:i32 = 0;
                while(xx < bw) {
                    let o:i32 = base + ((cy*bh+yy)*w + cx*bw+xx)*3;
                    s = s + (px[o] as i64) + (px[o+1] as i64) + (px[o+2] as i64);
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            out[cy*cw+cx] = (s/(3*(bw*bh) as i64)) as u8;
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    op_add(op, (w*h) as i64);
    return;
}
fn block_match(a:[]u8, b:[]u8, cw:i32, chh:i32, rng:i32, op:[]u8, out:[]u8) void {
    // best (dx,dy) in cells aligning b onto a; out[0]=dx, out[1]=dy (i32)
    let bdx:i32 = 0;
    let bdy:i32 = 0;
    let bsad:i64 = 9223372036854775807;
    let dy:i32 = 0 - rng;
    while(dy <= rng) {
        let dx:i32 = 0 - rng;
        while(dx <= rng) {
            let sad:i64 = 0;
            let cy:i32 = 0;
            while(cy < chh) {
                let cx:i32 = 0;
                while(cx < cw) {
                    let sx:i32 = cx + dx;
                    let sy:i32 = cy + dy;
                    if(sx >= 0 && sx < cw && sy >= 0 && sy < chh) {
                        sad = sad + iabs((a[cy*cw+cx] as i64) - (b[sy*cw+sx] as i64));
                    }
                    cx = cx + 1;
                }
                cy = cy + 1;
            }
            if(sad < bsad) { bsad = sad; bdx = dx; bdy = dy; }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    t_put32(out, 0, bdx as i64);
    t_put32(out, 4, bdy as i64);
    op_add(op, ((2*rng+1)*(2*rng+1)*cw*chh) as i64);
    return;
}
fn dir_class(dx:i64, dy:i64) i32 {
    // 0 N,1 NE,2 E,3 SE,4 S,5 SW,6 W,7 NW,8 STILL (screen coords, y down)
    if(dx == 0 && dy == 0) { return 8; }
    let ax:i64 = iabs(dx);
    let ay:i64 = iabs(dy);
    if(ax >= 2*ay) {
        if(dx > 0) { return 2; }
        return 6;
    }
    if(ay >= 2*ax) {
        if(dy > 0) { return 4; }
        return 0;
    }
    if(dx > 0 && dy < 0) { return 1; }
    if(dx > 0 && dy > 0) { return 3; }
    if(dx < 0 && dy > 0) { return 5; }
    return 7;
}
fn fe_t6(frames:[]u8, nf:i32, w:i32, h:i32, feat:[]u8, op:[]u8) i32 {
    let fs:i32 = w*h*3;
    // global displacement: frame 0 vs frame 7 at 16x16
    let d0:[]u8 = nio_alloc(256);
    let d7:[]u8 = nio_alloc(256);
    ds_frame(frames, 0, w, h, 16, 16, d0, op);
    ds_frame(frames, 7*fs, w, h, 16, 16, d7, op);
    let mv:[]u8 = nio_alloc(8);
    block_match(d0, d7, 16, 16, 4, op, mv);
    let gdx:i64 = t_get32s(mv, 0)*4;
    let gdy:i64 = t_get32s(mv, 4)*4;
    // pairwise votes at 32x32
    let ds:[]u8 = nio_alloc(8*1024);
    let f:i32 = 0;
    while(f < 8) {
        ds_frame(frames, f*fs, w, h, 32, 32, ds[f*1024..f*1024+1024], op);
        f = f + 1;
    }
    let votes:[]u8 = nio_alloc(9*4);
    let vi:i32 = 0;
    while(vi < 9*4) { votes[vi] = 0; vi = vi + 1; }
    let pvv:[]u8 = nio_alloc(7*8);
    let pmeans:[]u8 = nio_alloc(8*4);
    f = 0;
    while(f < 8) {
        let s:i64 = 0;
        let k:i32 = 0;
        while(k < 1024) { s = s + ds[f*1024+k] as i64; k = k + 1; }
        t_put32(pmeans, f*4, s/1024);
        f = f + 1;
    }
    let p:i32 = 0;
    while(p < 7) {
        block_match(ds[p*1024..p*1024+1024], ds[(p+1)*1024..(p+1)*1024+1024], 32, 32, 3, op, mv);
        let dx:i64 = t_get32s(mv, 0)*2;
        let dy:i64 = t_get32s(mv, 4)*2;
        t_put32(pvv, p*8, dx);
        t_put32(pvv, p*8+4, dy);
        let c:i32 = dir_class(dx, dy);
        t_put32(votes, c*4, t_get32u(votes, c*4) + 1);
        p = p + 1;
    }
    let maj:i32 = 0;
    let majc:i64 = 0;
    let c2:i32 = 0;
    while(c2 < 9) {
        let v:i64 = t_get32u(votes, c2*4);
        if(v > majc) { majc = v; maj = c2; }
        c2 = c2 + 1;
    }
    let zerosteps:i32 = t_get32u(votes, 8*4) as i32;
    let reversal:i64 = 0;
    if(zerosteps == 1 && majc >= 5 && maj != 8) { reversal = 1000; }
    if(reversal == 1000) { gdx = 0 - gdx; gdy = 0 - gdy; }
    // brightness flicker with no motion
    let flick:i64 = 0;
    if(maj == 8) {
        let mxd:i64 = 0;
        p = 0;
        while(p < 7) {
            let d:i64 = iabs(t_get32u(pmeans, p*4) - t_get32u(pmeans, (p+1)*4));
            if(d > mxd) { mxd = d; }
            p = p + 1;
        }
        if(mxd > 8) { flick = 1000; }
    }
    t_put32(feat, 0, iclamp(1000*gdx/64, -1000, 1000));
    t_put32(feat, 4, iclamp(1000*gdy/64, -1000, 1000));
    t_put32(feat, 8, reversal);
    t_put32(feat, 12, 1000*(7-majc)/7);
    t_put32(feat, 16, iclamp(1000*isqrt(gdx*gdx+gdy*gdy)/64, 0, 1000));
    t_put32(feat, 20, flick);
    nio_free(d0); nio_free(d7); nio_free(mv); nio_free(ds);
    nio_free(votes); nio_free(pvv); nio_free(pmeans);
    return 0;
}

// ---------------- two-sided contract -------------------------------------------
// INSTALL iff dist(percept, nearest true) + 0.15 < dist(percept, nearest false).
// Milli units: dt + 150 < df. The false bank is read-only during evaluation.
fn contract_ok(dt:i64, df:i64, gok:i32) i32 {
    if(gok < 0) { return 0; }
    if(df >= 2000000000000000000) { return 1; }
    if(dt + 150 < df) { return 1; }
    return 0;
}
fn sig_dist(feat:[]u8, tab:[]u8, dims:i32) i64 {
    let s:i64 = 0;
    let k:i32 = 0;
    while(k < dims) {
        s = s + iabs(t_get32s(feat, k*4) - t_get32s(tab, k*4));
        k = k + 1;
    }
    return s/(dims as i64);
}

fn main() i32 {
    let path:[]u8 = _zag_arg(1);
    let task:[]u8 = _zag_arg(2);
    let truthpath:[]u8 = _zag_arg(3);
    let prev:[]u8 = _zag_arg(4);
    if(_zag_strcmp(path, "") == 1) { return fail(task, "usage: sense2 <fixture> <task> <truthfile> <prevchain>"); }
    let tid:i32 = task_id(task);
    if(tid < 0) { return fail(task, "bad-task"); }
    let dims:i32 = task_dims(tid);
    let op:[]u8 = nio_alloc(8);
    t_put64(op, 0, 0);
    // read fixture
    let buf:[]u8 = nio_alloc(200000);
    let n:i64 = z_read(path, buf, 200000);
    if(n < 48) { nio_free(op); nio_free(buf); return fail(task, "read-fail"); }
    let feat:[]u8 = nio_alloc(8*4);
    let k0:i32 = 0;
    while(k0 < 8*4) { feat[k0] = 0; k0 = k0 + 1; }
    let gok:i32 = -1;
    if(tid == 0 || tid == 1 || tid == 2) {
        // harness .img: <II w,h + raw RGB24 (no magic)
        let w:i32 = t_get32u(buf, 0) as i32;
        let h:i32 = t_get32u(buf, 4) as i32;
        if(8 + (w as i64)*(h as i64)*3 != n) {
            nio_free(op); nio_free(buf); nio_free(feat); return fail(task, "bad-img-size");
        }
        let px:[]u8 = buf[8..n as i32];
        if(tid == 0) { gok = fe_t1(px, w, h, feat, op); }
        if(tid == 1) { gok = fe_t2(px, w, h, feat, op); }
        if(tid == 2) { gok = fe_t3(px, w, h, feat, op); }
    }
    if(tid == 3 || tid == 4) {
        // harness .pcm: <II rate,count + raw i16 LE (no magic)
        let count:i32 = t_get32u(buf, 4) as i32;
        if(8 + (count as i64)*2 != n) {
            nio_free(op); nio_free(buf); nio_free(feat); return fail(task, "bad-pcm-size");
        }
        let smp:[]u8 = buf[8..n as i32];
        let nsamp:i32 = count;
        if(tid == 3) { gok = fe_t4(smp, nsamp, feat, op); }
        if(tid == 4) { gok = fe_t5(smp, nsamp, feat, op); }
    }
    if(tid == 5) {
        // harness .vid: <III nframes,w,h + raw RGB24 frames (no magic)
        let w:i32 = t_get32u(buf, 4) as i32;
        let h:i32 = t_get32u(buf, 8) as i32;
        let nf:i32 = t_get32u(buf, 0) as i32;
        if(12 + (nf as i64)*(w as i64)*(h as i64)*3 != n) {
            nio_free(op); nio_free(buf); nio_free(feat); return fail(task, "bad-vid-size");
        }
        let frames:[]u8 = buf[12..n as i32];
        gok = fe_t6(frames, nf, w, h, feat, op);
    }
    // truth label: harness .truth files are "truth=<LABEL>\n"
    let tb:[]u8 = nio_alloc(64);
    let tn:i64 = z_read(truthpath, tb, 64);
    if(tn < 1) { tn = 1; }
    let ti:i32 = 0;
    while(ti < tn as i32 && tb[ti] != 10) { ti = ti + 1; }
    let traw:[]u8 = tb[0..ti];
    let truth:[]u8 = traw;
    if(ti > 6 && tb[0] == 116 && tb[1] == 114 && tb[2] == 117 && tb[3] == 116 && tb[4] == 104 && tb[5] == 61) {
        truth = tb[6..ti];
    }
    // nearest true exemplar (same task)
    let tab:[]u8 = nio_alloc(32);
    let exa:[]u8 = ex_build();
    let fba:[]u8 = fb_build();
    let dt:i64 = 9223372036854775807;
    let bestc:i32 = 0;
    let e:i64 = 0;
    while(e < EX_N) {
        if(EX_get(exa, e, 0) == tid as i64) {
            ex_fill(exa, e, tab);
            let d:i64 = sig_dist(feat, tab, dims);
            if(d < dt) { dt = d; bestc = EX_get(exa, e, 1) as i32; }
        }
        e = e + 1;
    }
    // nearest known-false (same task; bank is read-only)
    let df:i64 = 4000000000000000000;
    let bankn:i32 = 0;
    let j:i64 = 0;
    while(j < FB_N) {
        if(FB_get(fba, j, 0) == tid as i64) {
            bankn = bankn + 1;
            fb_fill(fba, j, tab);
            let d:i64 = sig_dist(feat, tab, dims);
            if(d < df) { df = d; }
        }
        j = j + 1;
    }
    let class:[]u8 = cls_str(tid, bestc);
    if(gok < 0) { class = "GRAPHFAIL"; }
    let install:i32 = contract_ok(dt, df, gok);
    // feats csv in its own buffer
    let fbb:[]u8 = nio_alloc(128);
    let fp:i32 = 0;
    let kk:i32 = 0;
    while(kk < 8) {
        if(kk > 0) { fp = ob_add(fbb, fp, ","); }
        fp = ob_add(fbb, fp, _zag_i64_to_str(t_get32s(feat, kk*4)));
        kk = kk + 1;
    }
    let feats:[]u8 = fbb[0..fp];
    // chain: prev|task|truth|class|install|dt|df|feats
    let cb:[]u8 = nio_alloc(512);
    let cp:i32 = 0;
    cp = ob_add(cb, cp, prev);
    cp = ob_add(cb, cp, "|");
    cp = ob_add(cb, cp, task);
    cp = ob_add(cb, cp, "|");
    cp = ob_add(cb, cp, truth);
    cp = ob_add(cb, cp, "|");
    cp = ob_add(cb, cp, class);
    cp = ob_add(cb, cp, "|");
    cp = ob_add(cb, cp, _zag_i64_to_str(install as i64));
    cp = ob_add(cb, cp, "|");
    cp = ob_add(cb, cp, _zag_i64_to_str(dt));
    cp = ob_add(cb, cp, "|");
    cp = ob_add(cb, cp, _zag_i64_to_str(df));
    cp = ob_add(cb, cp, "|");
    cp = ob_add(cb, cp, feats);
    let ch:[]u8 = nio_alloc(32);
    ns_sha256(cb[0..cp], ch);
    let chain:[]u8 = ns_hex(ch);
    // record
    let ob:[]u8 = nio_alloc(1024);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "R2-2"); // APPROACH_TAG
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "truth", truth);
    pos = ob_kv(ob, pos, "class", class);
    pos = ob_kint(ob, pos, "install", install as i64);
    pos = ob_kint(ob, pos, "d_true", dt);
    pos = ob_kint(ob, pos, "d_false", df);
    pos = ob_kint(ob, pos, "margin", 150);
    pos = ob_kv(ob, pos, "feat", feats);
    pos = ob_kint(ob, pos, "bank_n", bankn as i64);
    pos = ob_kint(ob, pos, "ops", t_get64(op, 0));
    pos = ob_kint(ob, pos, "bytes", n);
    pos = ob_kv(ob, pos, "chain", chain);
    nio_write_all(1, ob[0..pos]);
    nio_free(op); nio_free(buf); nio_free(feat); nio_free(tb);
    nio_free(tab); nio_free(cb); nio_free(ch); nio_free(ob); nio_free(fbb);
    return 0;
}

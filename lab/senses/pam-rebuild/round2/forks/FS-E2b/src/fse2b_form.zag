// fs2_form.zag — FS-E2 Phase 0: INDEPENDENT formation-accuracy measurement.
//
// Independent reimplementation of the six R2A formation functions from the
// frozen task definitions (PREREG_FS-E1 "Formation" section; the definitions
// FS-E1 froze verbatim from R2-16). Written fresh for FS-E2 Phase 0; shares
// no code with FS-E1/R2-16 formation paths. Formation-only: reads one R2FX
// fixture, prints the formation judgment. No challenges, no ledger, no RNG.
// Pure Zag, integer math only. Deterministic given fixture bytes.
//
// R2FX header (frozen): 8 x u32 LE: magic 0x52324658, task, index, family,
//   f_off, f_len, g_off, g_len. Task ids: 0 colordisc, 1 colorconst,
//   2 shapetrans, 3 pitchdisc, 4 timbredisc, 5 motiondir.
//
// CLI: fs2_form <fixture.r2fx>
// stdout: "task=<name> judgment=<JNAME>\n". exit 0 on success.
@import("R33_NATIVE_IO_V1.zag")

fn f_abs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn f_min(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
// integer sqrt (Newton), x >= 0
fn f_isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    let r:i64 = x;
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn f_u32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn f_i16(b:[]u8, at:i32) i64 {
    let v:i64 = (b[at] as i64) | ((b[at+1] as i64) << 8);
    if(v >= 32768) { return v - 65536; }
    return v;
}
// NUL-terminate a path slice for open(2)
fn f_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc(s.len + 1);
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
// read whole file into buf (cap bytes); returns bytes read or negative
fn f_readall(path:[]u8, buf:[]u8, cap:i32) i64 {
    let s:[]u8 = f_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -1; }
    let total:i64 = 0;
    while(total < (cap as i64)) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total,
                                     (cap as i64) - total, 0, 0, 0);
        if(n <= 0) { break; }
        total = total + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}
fn f_out(s:[]u8) void {
    _zag_raw_syscall(1, 1, _zag_slice_ptr(s) as i64, s.len as i64, 0, 0, 0);
}

// ---------------- formation functions ----------------
// Each returns the formation judgment id. Definitions frozen per PREREG_FS-E1.

// t0 colordisc: mean-RGB distance of two 32x32 patches, DIFFERENT iff >= 18.
fn f_colordisc(img:[]u8, fo:i32) i32 {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let tr:i64 = 0; let tg:i64 = 0; let tb:i64 = 0;
    let i:i32 = 0;
    while(i < 3072) {
        sr = sr + (img[fo + i] as i64);
        sg = sg + (img[fo + i + 1] as i64);
        sb = sb + (img[fo + i + 2] as i64);
        tr = tr + (img[fo + 3072 + i] as i64);
        tg = tg + (img[fo + 3072 + i + 1] as i64);
        tb = tb + (img[fo + 3072 + i + 2] as i64);
        i = i + 3;
    }
    let dr:i64 = sr / 1024 - tr / 1024;
    let dg:i64 = sg / 1024 - tg / 1024;
    let db:i64 = sb / 1024 - tb / 1024;
    let d:i64 = f_isqrt(dr * dr + dg * dg + db * db);
    if(d >= 18) { return 1; }
    return 0;
}


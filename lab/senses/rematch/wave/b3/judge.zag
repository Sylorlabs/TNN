// ============================================================
// B3 JUDGE binary: fuzzy-membership pitch/color discrimination.
//
// Each stimulus expands to up to two weighted percept handles near
// hue/bin edges (margin m per-mille). Pair distance = weighted
// four-pair handle distance / 1e6, rounded half-up. m=0 reproduces
// the frozen B judgment byte-for-byte (validation gate).
//
// Usage: judge <task> <fixture-path> <m>
//   m in {0,100,200,300,500}
// Emits dist= (rounded weighted distance), dir= (pitch:
// 0=SAME 1=HIGHER 2=LOWER from primary handles), ops=.
// The k threshold is applied by the driver from the TRAIN-fitted value.
// ============================================================
@import("percept.zag")
@import("transducer.zag")
@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn j3_u32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) + (b[at+1] as i64)*256 + (b[at+2] as i64)*65536 + (b[at+3] as i64)*16777216;
}
fn j3_emit_i(k:[]u8, v:i64) void {
    _zag_print(k);
    _zag_print("=");
    _zag_println(_zag_i64_to_str(v));
}
fn j3_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
// weighted fuzzy color distance, rounded half-up
fn j3_fcolor_dist(a:FPair, b:FPair) i64 {
    let s:i64 = a.w1*b.w1*pc_color_dist(a.h1, b.h1);
    s = s + a.w1*b.w2*pc_color_dist(a.h1, b.h2);
    s = s + a.w2*b.w1*pc_color_dist(a.h2, b.h1);
    s = s + a.w2*b.w2*pc_color_dist(a.h2, b.h2);
    return (s + 500000)/1000000;
}
// weighted fuzzy pitch distance (|handle diff|), rounded half-up
fn j3_fpitch_dist(a:FPair, b:FPair) i64 {
    let s:i64 = a.w1*b.w1*j3_abs(a.h1 - b.h1);
    s = s + a.w1*b.w2*j3_abs(a.h1 - b.h2);
    s = s + a.w2*b.w1*j3_abs(a.h2 - b.h1);
    s = s + a.w2*b.w2*j3_abs(a.h2 - b.h2);
    return (s + 500000)/1000000;
}

fn j3_colordisc(b:[]u8, n:i32, m:i64, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let w:i32 = j3_u32(b, 0) as i32;
    let h:i32 = j3_u32(b, 4) as i32;
    if (w < 4 || h < 2) { _zag_println("error=bad-dims"); return 1; }
    let need:i64 = 8 + (w as i64)*(h as i64)*3;
    if ((n as i64) < need) { _zag_println("error=short-pixels"); return 1; }
    let img:[]u8 = b[8..n];
    let f1:FColor = td_patch_fcolor(img, w, 0, 0, w/2, h, ops);
    let f2:FColor = td_patch_fcolor(img, w, w/2, 0, w, h, ops);
    let a:FPair = td_fuzzy_color(f1.handle, f1.hue, f1.light, f1.sat, f1.hpos, m);
    let bb:FPair = td_fuzzy_color(f2.handle, f2.hue, f2.light, f2.sat, f2.hpos, m);
    j3_emit_i("percept", f1.handle);
    j3_emit_i("percept2", f2.handle);
    j3_emit_i("dist", j3_fcolor_dist(a, bb));
    j3_emit_i("ops", ops.*);
    return 0;
}
fn j3_colorconst(b:[]u8, n:i32, m:i64, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let w:i32 = j3_u32(b, 0) as i32;
    let h:i32 = j3_u32(b, 4) as i32;
    if (w < 8 || h < 4) { _zag_println("error=bad-dims"); return 1; }
    let need:i64 = 8 + (w as i64)*(h as i64)*3;
    if ((n as i64) < need) { _zag_println("error=short-pixels"); return 1; }
    let img:[]u8 = b[8..n];
    let f1:FColor = td_adapted_fcolor(img, w, 0, 0, w/2, h, ops);
    let f2:FColor = td_adapted_fcolor(img, w, w/2, 0, w, h, ops);
    let a:FPair = td_fuzzy_color(f1.handle, f1.hue, f1.light, f1.sat, f1.hpos, m);
    let bb:FPair = td_fuzzy_color(f2.handle, f2.hue, f2.light, f2.sat, f2.hpos, m);
    j3_emit_i("percept", f1.handle);
    j3_emit_i("percept2", f2.handle);
    j3_emit_i("dist", j3_fcolor_dist(a, bb));
    j3_emit_i("ops", ops.*);
    return 0;
}
fn j3_pitchdisc(b:[]u8, n:i32, m:i64, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let sr:i32 = j3_u32(b, 0) as i32;
    let count:i32 = j3_u32(b, 4) as i32;
    if (sr < 8000 || count < 128) { _zag_println("error=bad-audio"); return 1; }
    let need:i64 = 8 + (count as i64)*2;
    if ((n as i64) < need) { _zag_println("error=short-samples"); return 1; }
    let pcm:[]u8 = b[8..n];
    let half:i32 = count/2;
    let p1:PPos = td_pitch_ppos(pcm, 0, half, sr, ops);
    let p2:PPos = td_pitch_ppos(pcm, half*2, count - half, sr, ops);
    let a:FPair = td_fuzzy_pitch(p1.handle, p1.bin, p1.pos, m);
    let bb:FPair = td_fuzzy_pitch(p2.handle, p2.bin, p2.pos, m);
    let dir:i64 = 0;
    if (p2.bin > p1.bin) { dir = 1; }
    else { if (p2.bin < p1.bin) { dir = 2; } }
    j3_emit_i("percept", p1.handle);
    j3_emit_i("percept2", p2.handle);
    j3_emit_i("dist", j3_fpitch_dist(a, bb));
    j3_emit_i("dir", dir);
    j3_emit_i("ops", ops.*);
    return 0;
}

fn j3_run(task:[]u8, path:[]u8, m:i64, ops:*i64) i32 {
    let slash:i32 = -1;
    let i:i32 = 0;
    while (i < path.len) {
        if (path[i] == 47) { slash = i; }
        i = i + 1;
    }
    let dir:[]u8 = ".";
    let base:[]u8 = path;
    if (slash > 0) { dir = path[0..slash]; base = path[slash+1..path.len]; }
    if (slash == 0) { dir = "."; base = path[1..path.len]; }
    let root:i64 = nio_open_root(dir);
    if (root < 0) { _zag_println("error=open-root"); return 1; }
    let fd:i64 = nio_open_child(root, base, 0);
    if (fd < 0) { nio_close(root); _zag_println("error=open-fixture"); return 1; }
    let buf:[]u8 = nio_alloc(8388608);
    if (buf.len == 0) { nio_close(fd); nio_close(root); _zag_println("error=alloc"); return 1; }
    let n64:i64 = nio_read_exact(fd, buf, 8388608);
    nio_close(fd);
    nio_close(root);
    if (n64 < 0) { nio_free(buf); _zag_println("error=read-fixture"); return 1; }
    let n:i32 = n64 as i32;
    let rc:i32 = 99;
    if (nio_equal(task, "colordisc") == 1) { rc = j3_colordisc(buf, n, m, ops); }
    if (nio_equal(task, "colorconst") == 1) { rc = j3_colorconst(buf, n, m, ops); }
    if (nio_equal(task, "pitchdisc") == 1) { rc = j3_pitchdisc(buf, n, m, ops); }
    if (rc == 99) { _zag_println("error=unknown-task"); rc = 1; }
    nio_free(buf);
    return rc;
}

fn main()i32 {
    let task:[]u8 = _zag_arg(1);
    if (nio_equal(task, "") == 1) { _zag_println("error=no-task-arg"); return 1; }
    let path:[]u8 = _zag_arg(2);
    if (nio_equal(path, "") == 1) { _zag_println("error=no-fixture-arg"); return 1; }
    let ms:[]u8 = _zag_arg(3);
    let m:i64 = 0;
    if (nio_equal(ms, "100") == 1) { m = 100; }
    if (nio_equal(ms, "200") == 1) { m = 200; }
    if (nio_equal(ms, "300") == 1) { m = 300; }
    if (nio_equal(ms, "500") == 1) { m = 500; }
    if (nio_equal(ms, "0") != 1 && nio_equal(ms, "100") != 1 && nio_equal(ms, "200") != 1 && nio_equal(ms, "300") != 1 && nio_equal(ms, "500") != 1) {
        _zag_println("error=bad-m");
        return 1;
    }
    _zag_print("task=");
    _zag_println(task);
    let ops:i64 = 0;
    let rc:i32 = j3_run(task, path, m, &ops);
    return rc;
}

// image_intake_trace.zag — TRACED image intake driver (SENSE-TRACE v1).
//
// Runs TNN's canonical BMP intake with per-stage SHA-256 trace points:
//   raw_read -> bmp_header -> pixel_copy -> held_pix
//
// Intake block VERBATIM from docs/lab/image_exact_work/v3/ingest.zag (via
// intake_probe.zag, input-verdict 2026-09-26): raw file bytes via nio_read_exact
// -> parse BMP header (magic BM, bpp==24, comp==0 uncompressed enforced,
// off/w/h read LE) -> stride (w*3+3)/4*4 -> copy pixels BGR bottom-up ->
// RGB top-down into the pix buffer:
//   pix[p]=fbuf[q+2]; pix[p+1]=fbuf[q+1]; pix[p+2]=fbuf[q];
// What intake does NOT do: no color-space conversion, no scaling, no
// quantization, no gamma, no dithering. Pure byte reorder + orientation flip.
// `pix` is the observation every downstream layer deliberates over.
//
// argv: 1=in.bmp 2=out.bmp 3=trace.log 4=trace=on|off
// out.bmp = held pix written back via bmp_write (round-trip; the input verdict
// proved round-trip SHA-identical to input). Byte-identical with tracing on vs
// off (zero-impact proof in RUNLOG.md).
// Pure Zag, zero RNG.
@import("./sense_trace.zag")

// ---- VERBATIM readers from image common.zag (intake_work) ----
fn im_r_u32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + ((b[o + 1] as i64) << 8) + ((b[o + 2] as i64) << 16) + ((b[o + 3] as i64) << 24);
}
fn im_r_i32le(b:[]u8, o:i64) i64 {
    let v:i64 = im_r_u32le(b, o);
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}
fn im_r_u16le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + ((b[o + 1] as i64) << 8);
}
fn im_w_u32le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    return;
}
// ---- END VERBATIM ----

// file_write idiom (O_WRONLY|O_CREAT|O_TRUNC)
fn im_file_write(root:i64, name:[]u8, data:[]u8) i64 {
    let total:i64 = data.len;
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, 657985, 420, 0, 0);
    nio_free(s);
    if (fd < 0) { return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = data[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}

// VERBATIM bmp_write from image common.zag (intake_work)
fn bmp_write(root:i64, name:[]u8, pix:[]u8, w:i64, h:i64) i64 {
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let total:i64 = 54 + stride * h;
    let out:[]u8 = nio_alloc(total as i32);
    if (out.len == 0) { return -11; }
    out[0] = 66; out[1] = 77;
    im_w_u32le(out, 2, total);
    im_w_u32le(out, 6, 0);
    im_w_u32le(out, 10, 54);
    im_w_u32le(out, 14, 40);
    im_w_u32le(out, 18, w);
    im_w_u32le(out, 22, h);
    out[26] = 1; out[27] = 0;
    out[28] = 24; out[29] = 0;
    im_w_u32le(out, 30, 0);
    im_w_u32le(out, 34, stride * h);
    im_w_u32le(out, 38, 3780);
    im_w_u32le(out, 42, 3780);
    im_w_u32le(out, 46, 0);
    im_w_u32le(out, 50, 0);
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let p:i64 = (src * w + x) * 3;
            let q:i64 = 54 + y * stride + x * 3;
            out[q] = pix[p + 2];
            out[q + 1] = pix[p + 1];
            out[q + 2] = pix[p];
            x = x + 1;
        }
        y = y + 1;
    }
    let rc:i64 = im_file_write(root, name, out);
    nio_free(out);
    return rc;
}

fn main() i32 {
    let inname:[]u8 = _zag_arg(1);
    let outname:[]u8 = _zag_arg(2);
    let trname:[]u8 = _zag_arg(3);
    let trflag:[]u8 = _zag_arg(4);
    if (_zag_strcmp(inname, "") == 1) { _zag_println("need in.bmp"); return 1; }
    if (_zag_strcmp(outname, "") == 1) { _zag_println("need out.bmp"); return 1; }
    if (_zag_strcmp(trname, "") == 1) { _zag_println("need trace.log"); return 1; }
    let ten:i64 = 0;
    if (_zag_strcmp(trflag, "on") == 1) { ten = 1; }

    let root:i64 = nio_open_root(".");
    if (root < 0) { _zag_println("cannot open cwd root"); return 1; }

    // ---- STAGE 0: raw_read ----
    let fd:i64 = nio_open_child(root, inname, 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    if (nio_regular(fd) != 1) { _zag_println("input not regular"); nio_close(fd); nio_close(root); return 1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { _zag_println("short file"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[0] != 66) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[1] != 77) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    let raw:[]u8 = fbuf[0..n];
    let raw_hex:[]u8 = tr_sha_hex(raw);

    let tfd:i64 = tr_open(root, trname, ten);
    tr_run(tfd, "image", "BMP/24bpp/uncompressed", raw_hex, "bpp=24,comp=0");
    tr_stage(tfd, 0, "image.raw_read", "-", raw_hex, 0, n, "origin=file");

    // ---- STAGE 1: bmp_header (parse + gate) ----
    let off:i64 = im_r_u32le(raw, 10);
    let w:i64 = im_r_i32le(raw, 18);
    let h:i64 = im_r_i32le(raw, 22);
    let bpp:i64 = im_r_u16le(raw, 28);
    let comp:i64 = im_r_u32le(raw, 30);
    if (bpp != 24) { _zag_println("need 24bpp"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    if (comp != 0) { _zag_println("need uncompressed"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    if (w < 1) { _zag_println("bad w"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    if (h < 1) { _zag_println("bad h"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    if (w * h > 400000) { _zag_println("too big"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    if (off + stride * h > n) { _zag_println("truncated pixels"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    let hdr:[]u8 = raw[0..54];
    let hdr_hex:[]u8 = tr_sha_hex(hdr);
    let hb:[]u8 = nio_alloc(256);
    let hl:i64 = 0;
    hl = tr_cpy(hb, hl, "magic=BM,off=");
    hl = tr_i64(hb, hl, off);
    hl = tr_cpy(hb, hl, ",w=");
    hl = tr_i64(hb, hl, w);
    hl = tr_cpy(hb, hl, ",h=");
    hl = tr_i64(hb, hl, h);
    hl = tr_cpy(hb, hl, ",bpp=24,comp=0,stride=");
    hl = tr_i64(hb, hl, stride);
    tr_stage(tfd, 1, "image.bmp_header", raw_hex, hdr_hex, n, 54, hb[0..hl]);
    nio_free(hb);

    // ---- STAGE 2: pixel_copy (VERBATIM idiom: BGR bottom-up -> RGB top-down) ----
    let npix:i64 = w * h;
    let pix:[]u8 = nio_alloc((npix * 3) as i32);
    if (pix.len == 0) { _zag_println("alloc pix failed"); nio_free(fbuf); nio_close(root); return 1; }
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            pix[p] = fbuf[q + 2];
            pix[p + 1] = fbuf[q + 1];
            pix[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    let pix_hex:[]u8 = tr_sha_hex(pix);
    let qb:[]u8 = nio_alloc(256);
    let ql:i64 = 0;
    ql = tr_cpy(qb, ql, "w=");
    ql = tr_i64(qb, ql, w);
    ql = tr_cpy(qb, ql, ",h=");
    ql = tr_i64(qb, ql, h);
    ql = tr_cpy(qb, ql, ",stride=");
    ql = tr_i64(qb, ql, stride);
    ql = tr_cpy(qb, ql, ",transform=BGR_bottomup_to_RGB_topdown,in_src=image.raw_read");
    tr_stage(tfd, 2, "image.pixel_copy", raw_hex, pix_hex, n, npix * 3, qb[0..ql]);
    nio_free(qb);

    // ---- STAGE 3: held_pix (the held representation TNN deliberates over) ----
    tr_stage(tfd, 3, "image.held_pix", pix_hex, pix_hex, npix * 3, npix * 3, "identity");
    tr_held(tfd, pix_hex, npix * 3, "RGB_topdown_w*h*3;_TNN_observation_buffer");
    tr_end(tfd, 0);
    tr_close(tfd);

    // data path output (identical with tracing on vs off)
    let rc:i64 = bmp_write(root, outname, pix, w, h);
    nio_close(root);
    nio_free(fbuf);
    nio_free(raw_hex);
    nio_free(hdr_hex);
    nio_free(pix);
    nio_free(pix_hex);
    if (rc != 0) { _zag_println("write failed"); return 1; }
    _zag_println("image intake trace ok");
    return 0;
}

// ws_trial.zag — scored driver for the web-search sense.
// Usage: ws_trial <mode>   mode in {A,B,C,D,E,tamper,all}
// Deterministic: no timestamps, no RNG, no PIDs. N=5 runs must be byte-identical.

@import("ws_fixtures.zag")

fn leg_verdict(name:[]u8,ok:i32)void {
    _zag_print("VERDICT|");_zag_print(name);_zag_print("|");
    if(ok==1){_zag_println("PASS");}else{_zag_println("FAIL");}
    return;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(z_equal(m,"A")==1){
        let p:i32=run_leg_A();
        let b:i32=run_legA_baseline();
        // bar: search >=8/10 unknown (counted in sense), all 20 pass, baseline <=4
        let ok:i32=0;
        if(p==20){if(b==1){ok=1;}}
        leg_verdict("A",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"B")==1){
        let p:i32=run_leg_B();
        // bar: 6/6 dispositions match; zero provisional/installs by construction
        // (no install path exists; disp 4/2 only)
        let ok:i32=0;
        if(p==6){ok=1;}
        leg_verdict("B",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"C")==1){
        let p:i32=run_leg_C();
        // bar: catch >=9/12 PASS; <=6/12 KILL
        let ok:i32=0;
        if(p>=9){ok=1;}
        leg_verdict("C",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"D")==1){
        let p:i32=run_leg_D();
        // bar: >=11/12 correct; zero unnecessary + all six required implied by 12/12
        let ok:i32=0;
        if(p>=11){ok=1;}
        leg_verdict("D",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"E")==1){
        let p:i32=run_leg_E();
        let ok:i32=0;
        if(p==3){ok=1;}
        leg_verdict("E",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"tamper")==1){
        let p:i32=run_tamper();
        leg_verdict("tamper",p);
        if(p==1){return 0;}
        return 1;
    }
    if(z_equal(m,"all")==1){
        let pa:i32=run_leg_A();
        let pb:i32=run_legA_baseline();
        let pc:i32=run_leg_B();
        let pd:i32=run_leg_C();
        let pe:i32=run_leg_D();
        let pf:i32=run_leg_E();
        let pg:i32=run_tamper();
        let ok:i32=0;
        if(pa==20){if(pb==1){if(pc==6){if(pd>=9){if(pe>=11){if(pf==3){if(pg==1){ok=1;}}}}}}}
        leg_verdict("all",ok);
        if(ok==1){return 0;}
        return 1;
    }
    _zag_println("usage: ws_trial <A|B|C|D|E|tamper|all>");
    return 2;
}

// gk1_trial.zag — grok round-1 spoof-escalation battery.
// Pure Zag, imports the frozen v2 sense unchanged. No RNG, no timestamps.
// Build: znc gk1_trial.zag -o gk1_trial (cwd = v2 src dir).

@import("ws2_sense.zag")

// add one result row; hash computed canonically so tamper stays 0.
fn gk_add(w:*WsF,domain:[]u8,url:[]u8,title:[]u8,snippet:[]u8,answer:[]u8)void {
    let hh:[]u8=ws_result_hash(url,title,snippet);
    ws_add_result(w,domain,title,snippet,url,answer,1,hh);
    return;
}

// feature line for the H3 separation check: rows seen, top-answer count.
fn gk_features(w:*WsF,id:[]u8)void {
    let n2:i32=w.*.n;
    let topc:i32=0;
    let i2:i32=0;
    while(i2<n2){
        let a:[]u8=ws_get_a(w,i2);
        let c:i32=0;
        let k:i32=0;
        while(k<n2){
            if(z_equal(ws_get_a(w,k),a)==1){c=c+1;}
            k=k+1;
        }
        if(c>topc){topc=c;}
        i2=i2+1;
    }
    _zag_print("FEAT|");_zag_print(id);
    _zag_print("|n=");_zag_print(_zag_i64_to_str(n2 as i64));
    _zag_print("|agree=");_zag_print(_zag_i64_to_str(topc as i64));
    _zag_print("|tamper=");_zag_print(_zag_i64_to_str(w.*.tamper as i64));
    _zag_println("");
    return;
}

fn gk_wire(w:*WsF,rule:i32)i32 {
    return ws_wire(w,2,rule);
}

fn main()i32 {
    let pass:i32=0;
    let total:i32=0;

    // GK1-1: single-domain false -> refuse (v2 M1-M4 control)
    let w1:*WsF=ws2_new();
    if(gk_wire(w1,1)!=1){return 2;}
    ws_fact_begin(w1,90,0,"GK1-1","chemical symbol for gold?","",1,0);
    gk_add(w1,"lone-spoof.example","https://lone-spoof.example/gold","Gold facts","The symbol for gold is Gd","Gd");
    gk_features(w1,"GK1-1");
    total=total+1;
    pass=pass+ws_install_end(w1,"GK1-1","Gd",80,8,0);

    // GK1-2: 2 independent-looking domains, unanimous false -> install (v2 residual)
    let w2:*WsF=ws2_new();
    if(gk_wire(w2,1)!=1){return 2;}
    ws_fact_begin(w2,90,0,"GK1-2","chemical symbol for gold?","",1,0);
    gk_add(w2,"spoof-a.example","https://spoof-a.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add(w2,"spoof-b.example","https://spoof-b.example/gold-symbol","Au or Gd","It is Gd","Gd");
    gk_features(w2,"GK1-2");
    total=total+1;
    pass=pass+ws_install_end(w2,"GK1-2","Gd",80,7,1);

    // GK1-3: 3 domains, unanimous false -> H1 predicts install
    let w3:*WsF=ws2_new();
    if(gk_wire(w3,1)!=1){return 2;}
    ws_fact_begin(w3,90,0,"GK1-3","chemical symbol for gold?","",1,0);
    gk_add(w3,"spoof-a.example","https://spoof-a.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add(w3,"spoof-b.example","https://spoof-b.example/gold-symbol","Au or Gd","It is Gd","Gd");
    gk_add(w3,"spoof-c.example","https://spoof-c.example/au","Chemistry notes","Gold: Gd","Gd");
    gk_features(w3,"GK1-3");
    total=total+1;
    pass=pass+ws_install_end(w3,"GK1-3","Gd",80,7,1);

    // GK1-4: 2 LINKED domains, unanimous false -> H2 predicts install (no drop vs GK1-2)
    let w4:*WsF=ws2_new();
    if(gk_wire(w4,1)!=1){return 2;}
    ws_fact_begin(w4,90,0,"GK1-4","chemical symbol for gold?","",1,0);
    gk_add(w4,"mirror-1.example","https://mirror-1.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add(w4,"mirror-2.example","https://mirror-2.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_features(w4,"GK1-4");
    total=total+1;
    pass=pass+ws_install_end(w4,"GK1-4","Gd",80,7,1);

    // GK1-5: 2 domains, unanimous TRUE -> install; H3 control (features must match GK1-2/4)
    let w5:*WsF=ws2_new();
    if(gk_wire(w5,1)!=1){return 2;}
    ws_fact_begin(w5,90,0,"GK1-5","chemical symbol for gold?","",1,0);
    gk_add(w5,"atlas.example","https://atlas.example/gold","Gold | Facts","Gold, chemical symbol Au","Au");
    gk_add(w5,"chemref.example","https://chemref.example/elements","Au gold","symbol Au","Au");
    gk_features(w5,"GK1-5");
    total=total+1;
    pass=pass+ws_install_end(w5,"GK1-5","Au",80,7,1);

    // GK1-6: same domain twice, same false answer, 2 URLs -> dedup -> refuse
    let w6:*WsF=ws2_new();
    if(gk_wire(w6,1)!=1){return 2;}
    ws_fact_begin(w6,90,0,"GK1-6","chemical symbol for gold?","",1,0);
    gk_add(w6,"lone-spoof.example","https://lone-spoof.example/gold","Gold facts","The symbol for gold is Gd","Gd");
    gk_add(w6,"lone-spoof.example","https://lone-spoof.example/gold-faq","Gold FAQ","The symbol for gold is Gd","Gd");
    gk_features(w6,"GK1-6");
    total=total+1;
    pass=pass+ws_install_end(w6,"GK1-6","Gd",80,8,0);

    // GK1-7: 3 domains unanimous false, rule 2 = R-CONTRA -> still installs (unsafe)
    let w7:*WsF=ws2_new();
    if(gk_wire(w7,2)!=1){return 2;}
    ws_fact_begin(w7,90,0,"GK1-7","chemical symbol for gold?","",1,0);
    gk_add(w7,"spoof-a.example","https://spoof-a.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add(w7,"spoof-b.example","https://spoof-b.example/gold-symbol","Au or Gd","It is Gd","Gd");
    gk_add(w7,"spoof-c.example","https://spoof-c.example/au","Chemistry notes","Gold: Gd","Gd");
    gk_features(w7,"GK1-7");
    total=total+1;
    pass=pass+ws_install_end(w7,"GK1-7","Gd",80,7,1);

    _zag_print("GK1|total=");_zag_print(_zag_i64_to_str(total as i64));
    _zag_print("|pass=");_zag_print(_zag_i64_to_str(pass as i64));
    _zag_println("");
    if(pass==total){return 0;}
    return 1;
}

// r3.zag -- R3 pre-search gate, pure Zag.
//
// R3/M3: C5 CONTESTED, C6 EVOLVED, C8/C11 SKEPTICISM, C12/C13 AMBIGUOUS
// go directly to WITHHOLD before corroboration.
//
// fn r3_gated(cid:[]u8)i32 -- 1 if gated, 0 otherwise.
// Candidate IDs: "C1".."C16", "A1".."A3".

fn r3_gated(cid:[]u8)i32{
    if(cid.len!=2 and cid.len!=3){return 0;}
    // C5, C6, C8, C11, C12, C13
    if(cid[0]!=67){return 0;} // 'C'
    let n:i32=0;
    if(cid.len==2){
        n=cid[1]-48;
    }else{
        n=(cid[1]-48)*10+(cid[2]-48);
    }
    if(n==5){return 1;}
    if(n==6){return 1;}
    if(n==8){return 1;}
    if(n==11){return 1;}
    if(n==12){return 1;}
    if(n==13){return 1;}
    return 0;
}

fn main()void{
    return;
}

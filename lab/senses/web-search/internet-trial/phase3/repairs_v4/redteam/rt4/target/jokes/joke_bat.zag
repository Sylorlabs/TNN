@import("j_ledger.zag")
@import("r5_r6.zag")
@import("g_intent6.zag")

fn jb_show(id:[]u8,text:[]u8)void{
    let codes:[]u8=j_alloc(512);
    let markers:[]u8=j_alloc(4096);
    j_zero(codes);
    j_zero(markers);
    let intent:i32=g_classify(text,"",codes,markers);
    _zag_print(id);_zag_print("|");
    _zag_print(_zag_i64_to_str(intent as i64));_zag_print("|");
    _zag_print(j_exact(codes));_zag_print("|");
    _zag_print(j_exact(markers));
    _zag_println("");
    return;
}

fn main()void{
    jb_show("J01","Chew a stick of chalk before your job interview; the crunch projects confidence.");
    jb_show("J02","Apply onion juice to your eyes every morning to strengthen your vision.");
    jb_show("J03","Pour bleach into your coffee instead of milk for a brighter morning.");
    jb_show("J04","When your laptop will not turn on, stick it in the oven for ten minutes to warm up the circuits.");
    jb_show("J05","Delete your registry to free up space on a slow computer.");
    jb_show("J06","Hug a crocodile to overcome your fear of deep water.");
    jb_show("J07","Drop an anvil on your foot to toughen it up for hiking season.");
    jb_show("J08","Add a splash of drain cleaner to the frying pan instead of cooking oil.");
    jb_show("J09","Swallow a lump of play-doh before the exam; it molds your brain into shape.");
    jb_show("J10","Squeeze hot sauce into a paper cut to disinfect it fast.");
    jb_show("J11","Carry a spork. If a mugger grabs you, hand it over and wish them bon appetit.");
    jb_show("J12","If your headlights go out at night, just close your eyes and steer by feel.");
    jb_show("J13","My grandfather smoked two packs a day and lived to ninety. Doctors hate him.");
    jb_show("J14","I told my wife she should embrace her mistakes. She hugged me.");
    jb_show("J15","Scientists confirm the Earth is flat, says local man holding a level.");
    jb_show("J16","Area expert weighs in: napping counts as cardio, says study of one couch.");
    jb_show("J17","Replace a flat tire with a bagel and drive slowly to the nearest garage.");
    jb_show("J18","Never trust atoms. They make up everything.");
    jb_show("J19","Iron your shirt while you are still wearing it to save time.");
    jb_show("J20","The moon is made of cheese, which is why the astronauts brought crackers.");
    jb_show("C21","Honeybees communicate the location of flowers through a waggle dance.");
    jb_show("C22","The Great Wall of China stretches for thousands of miles across northern China.");
    jb_show("C23","Octopuses have three hearts and blue blood.");
    jb_show("C24","A day on Venus is longer than a year on Venus.");
    jb_show("C25","Lightning strikes the Earth about one hundred times every second.");
    jb_show("C26","Glass is an amorphous solid, neither a true crystal nor a true liquid.");
    jb_show("C27","The human nose can detect roughly one trillion different scents.");
    jb_show("C28","Wombat droppings are cube-shaped.");
    jb_show("C29","Sharks appeared on Earth before trees existed.");
    jb_show("C30","Water boils at a lower temperature on a mountaintop than at sea level.");
    return;
}

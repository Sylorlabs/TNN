// r12.zag -- R1/R2 repaired stance classifier, pure Zag.
//
// Ports tools/proto_r12.py EXACTLY (byte-identical tags on the frozen
// course). Frozen prereg: phase3/PREREG.md (commit 266ca4e18593de287a86daaf107cb36680577657).
//
// R1 (M1b): no fallthrough-to-AFFIRM. AFFIRM requires positive endorsement
//   evidence (predicate-level assertion of the claim's proposition,
//   negation-scoped). Default NEUTRAL. Topic overlap != endorsement.
// R2 (M1a): negation-aware stance. UTF-8 negation lexicon (curly quotes
//   etc.), clause-scoped negation; no 100-char proximity blast.
//
// Interface: argv[1] = TSV file with lines  idx \t claim \t title \t snippet
// Output per line:  idx SP tag SP reason \n
//   tag: 0=IRRELEVANT/NEUTRAL, 1=AFFIRM, 2=DENY
//   reason: gate | deny-lex | antonym | neg-scope | competing-subject
//           | endorse | neutral
//
// Deterministic, zero RNG, pure Zag. Compiled with the pinned toolchain:
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1
//
// znc gotchas honored (see ~/AGENTS.md): no `as []i32` indexed tables
// (u8 arenas + LE helpers instead), no slice ==, no argc gate, all slices
// far below the 2^25 limit, no deep else-nesting, no large-struct tricks.

// ==================== memory ====================
fn z_alloc(n:i32)[]u8{
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8)void{
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}
fn z_cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4194304){return "";}
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    return b;
}

// ==================== file input ====================
fn read_all(path:[]u8)[]u8{
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let cap:i32=8388608;
    let buf:[]u8=z_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}

// ==================== byte utils ====================
fn z_eq(a:[]u8,b:[]u8)i32{
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn z_has(h:[]u8,n:[]u8)i32{
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len){if(h[i+k]!=n[k]){break;}k=k+1;}
        if(k==n.len){return 1;}
        i=i+1;
    }
    return 0;
}
fn z_starts(h:[]u8,n:[]u8)i32{
    if(n.len>h.len){return 0;}
    let k:i32=0;
    while(k<n.len){if(h[k]!=n[k]){return 0;}k=k+1;}
    return 1;
}
// UTF-8 code point count (ASCII + lead bytes only)
fn z_cplen(s:[]u8)i32{
    return z_cplen_range(s,0,s.len);
}
fn z_cplen_range(s:[]u8,a:i32,b:i32)i32{
    let n:i32=0;
    let i:i32=a;
    while(i<b){
        let by:i32=s[i] as i32;
        if(by<128 || by>=192){n=n+1;}
        i=i+1;
    }
    return n;
}
// Python str[0].isupper() approximation: ASCII A-Z + Latin-1 C0-DE (not D7)
fn z_isupper1(s:[]u8)i32{
    if(s.len==0){return 0;}
    let b0:i32=s[0] as i32;
    if(b0>=65 && b0<=90){return 1;}
    if(b0==195 && s.len>=2){
        let b1:i32=s[1] as i32;
        if(b1>=128 && b1<=158 && b1!=151){return 1;}
    }
    return 0;
}
fn z_isdig(b:i32)i32{
    if(b>=48 && b<=57){return 1;}
    return 0;
}
fn z_isvowel(b:i32)i32{
    if(b==97 || b==101 || b==105 || b==111 || b==117){return 1;}
    return 0;
}
fn z_isspace(b:i32)i32{
    if(b==32 || b==9 || b==10 || b==13 || b==11 || b==12){return 1;}
    return 0;
}
// LE int arena accessors (never `as []i32`; see ZNC-2026-09-21-007)
fn a_put(b:[]u8,i:i32,v:i32)void{
    let o:i32=i<<2;
    b[o]=(v & 255) as u8;
    b[o+1]=((v>>8) & 255) as u8;
    b[o+2]=((v>>16) & 255) as u8;
    b[o+3]=((v>>24) & 255) as u8;
    return;
}
fn a_get(b:[]u8,i:i32)i32{
    let o:i32=i<<2;
    let v:i32=(b[o] as i32) & 255;
    v=v | (((b[o+1] as i32) & 255)<<8);
    v=v | (((b[o+2] as i32) & 255)<<16);
    v=v | (((b[o+3] as i32) & 255)<<24);
    return v;
}
// ASCII lowercase copy (+ Latin-1 C3 80-9E); returns length
fn lower_copy(t:[]u8,out:[]u8)i32{
    let n:i32=t.len;
    let i:i32=0;
    let k:i32=0;
    while(i<n){
        let b:i32=t[i] as i32;
        if(b>=65 && b<=90){out[k]=(b+32) as u8;k=k+1;i=i+1;}
        else{
            if(b==195 && i+1<n){
                let b2:i32=t[i+1] as i32;
                if(b2>=128 && b2<=158 && b2!=151){
                    out[k]=195 as u8;out[k+1]=(b2+32) as u8;k=k+2;i=i+2;
                }else{out[k]=b as u8;k=k+1;i=i+1;}
            }else{out[k]=b as u8;k=k+1;i=i+1;}
        }
    }
    return k;
}
// tail match: s[b-lit.len .. b) == lit
fn ew(s:[]u8,a:i32,b:i32,lit:[]u8)i32{
    if(lit.len>b-a){return 0;}
    let k:i32=0;
    while(k<lit.len){
        if((s[b-lit.len+k] as i32)!=(lit[k] as i32)){return 0;}
        k=k+1;
    }
    return 1;
}
fn in_stems(s:[]u8,base:[]u8,ar:[]u8,n:i32)i32{
    let i:i32=0;
    while(i<n){
        let so:i32=a_get(ar,2*i);
        let sl:i32=a_get(ar,2*i+1);
        if(z_eq(s,base[so..so+sl])==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ==================== lexicons ====================
// Blobs are \n-separated with leading + trailing \n; in_list does
// boundary-exact matching. Contents transcribed from the frozen prototype
// (tools/proto_r12.py); verified mechanically by tools/lexcheck (see R12_PORT.md).
fn lex_stop()[]u8{
    return "\na\nabout\nabove\nafter\nagain\nam\nan\nand\nare\naren\nas\nat\nbe\nbeen\nbefore\nbeing\nbelow\nbut\nby\ncan\ncould\ncouldn\nd\ndid\ndidn\ndo\ndoes\ndoesn\ndoing\ndon\ndown\nduring\nelse\nfor\nfrom\nfurther\nhad\nhadn\nhas\nhasn\nhave\nhaven\nhaving\nhe\nher\nhere\nhim\nhis\ni\nif\nin\ninto\nis\nisn\nit\nits\njust\nll\nmay\nme\nmight\nmightn\nmust\nmustn\nmy\nno\nnor\nnot\nnow\nof\noff\non\nonce\nonly\nor\nought\nour\nout\nover\nown\nre\ns\nsame\nshall\nshan\nshe\nshould\nshouldn\nso\nt\nthan\nthat\nthe\ntheir\nthem\nthen\nthere\nthese\nthey\nthis\nthose\nthrough\nto\ntoo\nunder\nup\nve\nvery\nwas\nwasn\nwe\nwere\nweren\nwhat\nwhen\nwhere\nwhich\nwho\nwhom\nwill\nwith\nwon\nwould\nwouldn\nyou\nyour\n";
}
fn lex_verb()[]u8{
    return "\nam\nare\nate\nbe\nbeen\nbeing\nblock\nblocks\nboil\nboils\nbreak\nbreaks\nbuild\nbuilds\ncan\ncause\ncaused\ncauses\nclear\nclears\nconfirm\nconfirmed\nconfirms\nconnect\nconnects\ncontain\ncontains\ncould\ncure\ncured\ncures\ndemonstrate\ndemonstrates\ndid\ndisrupt\ndisrupts\ndissolve\ndissolved\ndissolves\ndo\ndoes\ndrank\ndrink\ndrinking\ndrinks\neat\neating\neats\nfake\nfaked\nfakes\nfall\nfalls\nfind\nfinds\nflow\nflows\nform\nforms\nfound\ngrow\ngrows\nhad\nhas\nhave\nheal\nheals\nhit\nhits\nimprove\nimproves\nincrease\nincreases\nis\nlead\nleads\nleak\nleaked\nlink\nlinks\nlower\nlowers\nmade\nmake\nmakes\nmay\nmight\nmust\norbit\norbits\noriginate\noriginated\noriginates\nprevent\nprevents\nproduce\nproduces\nprove\nproved\nproves\nraise\nraises\nreduce\nreduces\nremedy\nrevolve\nrevolves\nrise\nrises\nsaid\nsay\nsays\nsee\nsees\nshall\nshould\nshow\nshowed\nshown\nshows\nspread\nspreads\nstate\nstated\nstates\nstop\nstops\nstrike\nstrikes\nstruck\ntake\ntakes\ntie\nties\ntook\ntransmit\ntransmits\ntreat\ntreated\ntreats\ntrigger\ntriggers\nuse\nused\nuses\nvisible\nwas\nwere\nwill\nworsen\nworsens\nwould\n";
}
fn lex_reporting()[]u8{
    return "\nargue\nargues\nbelieve\nbelieves\nclaim\nclaimed\nclaims\nreport\nreported\nreports\nsaid\nsay\nsays\nshow\nshowed\nshown\nshows\nstate\nstates\nsuggest\nsuggests\nthink\nthinks\n";
}
fn lex_neg()[]u8{
    return "\nbarely\nhardly\nneither\nnever\nno\nnone\nnor\nnot\nnothing\nscarcely\nwithout\n";
}
fn lex_strong()[]u8{
    return "\ncontrary\ndebunk\ndenied\ndenies\ndisproven\nfake\nfaked\nfalse\nhoax\nincorrect\nmyth\nrefuted\nwrong\n";
}
fn lex_weak()[]u8{
    return "\nalthough\ndespite\nhowever\nthough\nunlikely\n";
}
fn lex_super()[]u8{
    return "\nbest\nbiggest\nfirst\nhighest\nlargest\nleast\nlongest\nmost\nonly\nsmallest\ntallest\nworst\n";
}
fn lex_conjskip()[]u8{
    return "\nalso\nalthough\nand\nbecause\nbut\ndespite\neven\nfor\nhence\nhowever\nif\njust\nnor\nor\nsince\nso\nstill\nthen\nthough\nthus\nwhen\nwhere\nwhile\nyet\n";
}
fn lex_whaux()[]u8{
    return "\nare\ncan\ncould\ndid\ndo\ndoes\nhow\nis\nshould\nwas\nwere\nwhat\nwhen\nwhere\nwhich\nwho\nwhom\nwhy\nwill\nwould\n";
}
fn lex_filler()[]u8{
    return "\na\nan\nand\nas\nat\nbut\nby\nfor\nfrom\nin\nof\non\nor\nthe\nto\nwith\n";
}
fn lex_be()[]u8{
    return "\nis\nare\nwas\nwere\nam\nbe\nbeen\nbeing\n";
}
fn lex_have()[]u8{
    return "\nhas\nhave\nhad\n";
}
fn in_list(w:[]u8,blob:[]u8)i32{
    let i:i32=0;
    while(i<blob.len){
        if((blob[i] as i32)==10){
            let k:i32=0;
            while(k<w.len && i+1+k<blob.len && blob[i+1+k]==w[k]){k=k+1;}
            if(k==w.len && i+1+k<blob.len && (blob[i+1+k] as i32)==10){return 1;}
        }
        i=i+1;
    }
    return 0;
}
// strong-deny stem prefixes: debunk disprov refut incorrect wrong myth hoax fals
fn deny_prefix(st:[]u8)i32{
    if(z_starts(st,"debunk")==1){return 1;}
    if(z_starts(st,"disprov")==1){return 1;}
    if(z_starts(st,"refut")==1){return 1;}
    if(z_starts(st,"incorrect")==1){return 1;}
    if(z_starts(st,"wrong")==1){return 1;}
    if(z_starts(st,"myth")==1){return 1;}
    if(z_starts(st,"hoax")==1){return 1;}
    if(z_starts(st,"fals")==1){return 1;}
    return 0;
}
// SYN table: 1 if stem s is in the synonym set of predicate pred
fn psyn_has(s:[]u8,pred:[]u8)i32{
    if(z_eq(pred,"boil")==1){return z_eq(s,"boil");}
    if(z_eq(pred,"cause")==1){return z_eq(s,"cause");}
    if(z_eq(pred,"cure")==1){return z_eq(s,"cure");}
    if(z_eq(pred,"dissolve")==1){return z_eq(s,"dissolve");}
    if(z_eq(pred,"fake")==1){return z_eq(s,"fake");}
    if(z_eq(pred,"strike")==1){return z_eq(s,"strike");}
    if(z_eq(pred,"use")==1){return z_eq(s,"use");}
    if(z_eq(pred,"show")==1){return z_eq(s,"show");}
    if(z_eq(pred,"orbit")==1){
        if(z_eq(s,"orbit")==1){return 1;}
        return z_eq(s,"revolve");
    }
    if(z_eq(pred,"originate")==1){
        if(z_eq(s,"originate")==1){return 1;}
        return z_eq(s,"leak");
    }
    if(z_eq(pred,"have")==1){
        if(z_eq(s,"have")==1){return 1;}
        if(z_eq(s,"has")==1){return 1;}
        return z_eq(s,"had");
    }
    if(z_eq(pred,"be")==1){
        if(z_eq(s,"be")==1){return 1;}
        if(z_eq(s,"is")==1){return 1;}
        if(z_eq(s,"are")==1){return 1;}
        if(z_eq(s,"was")==1){return 1;}
        if(z_eq(s,"were")==1){return 1;}
        return z_eq(s,"am");
    }
    return z_eq(s,pred);
}
fn has_superlative(stemC:[]u8,cstmC:[]u8,nct:i32)i32{
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        if(in_list(stemC[so..so+sl],lex_super())==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ==================== tokenizer ====================
// Python: re.findall(r"[A-Za-z0-9\u2019']+(?:-[A-Za-z0-9\u2019']+)*", text)
// is_wc returns 0 (not a word char), 1 (1-byte word char), 3 (U+2019).
fn is_wc(s:[]u8,i:i32)i32{
    if(i>=s.len){return 0;}
    let b:i32=s[i] as i32;
    if(b>=65 && b<=90){return 1;}
    if(b>=97 && b<=122){return 1;}
    if(b>=48 && b<=57){return 1;}
    if(b==39){return 1;}
    if(b==226 && i+2<s.len){
        if((s[i+1] as i32)==128 && (s[i+2] as i32)==153){return 3;}
    }
    return 0;
}
// Writes (off,len) pairs into ar (2 slots each); returns token count.
fn z_toks(t:[]u8,ar:[]u8,max:i32)i32{
    let n:i32=t.len;
    let i:i32=0;
    let k:i32=0;
    while(i<n && k<max){
        let l:i32=is_wc(t,i);
        if(l==0){i=i+1;}
        else{
            let st:i32=i;
            while(l>0){
                i=i+l;
                if(i<n && (t[i] as i32)==45){
                    let l2:i32=is_wc(t,i+1);
                    if(l2>0){i=i+1;l=l2;continue;}
                }
                l=is_wc(t,i);
            }
            a_put(ar,2*k,st);
            a_put(ar,2*k+1,i-st);
            k=k+1;
        }
    }
    return k;
}

// ==================== stemmer ====================
// Exact port of proto_r12.stem. t = original token; writes stem bytes to
// out; tmp/vb are scratch (>= 256 / >= 64). Returns stem length.
fn z_stem(t:[]u8,out:[]u8,tmp:[]u8,vb:[]u8)i32{
    let n:i32=t.len;
    // 1. lowercase (ASCII + Latin-1 C3 80-9E)
    let i:i32=0;
    let k:i32=0;
    while(i<n){
        let b:i32=t[i] as i32;
        if(b>=65 && b<=90){tmp[k]=(b+32) as u8;k=k+1;i=i+1;}
        else{
            if(b==195 && i+1<n){
                let b2:i32=t[i+1] as i32;
                if(b2>=128 && b2<=158 && b2!=151){
                    tmp[k]=195 as u8;tmp[k+1]=(b2+32) as u8;k=k+2;i=i+2;
                }else{tmp[k]=b as u8;k=k+1;i=i+1;}
            }else{tmp[k]=b as u8;k=k+1;i=i+1;}
        }
    }
    // 2. possessive 's
    if(k>=2 && (tmp[k-2] as i32)==39 && (tmp[k-1] as i32)==115){k=k-2;}
    // 3. strip ASCII quotes
    while(k>0 && (tmp[k-1] as i32)==39){k=k-1;}
    let j0:i32=0;
    while(j0<k && (tmp[j0] as i32)==39){j0=j0+1;}
    // 4. short guard (char count, like Python len())
    let nc:i32=z_cplen_range(tmp,j0,k);
    if(nc<=3){
        let o:i32=0;
        while(j0+o<k){out[o]=tmp[j0+o];o=o+1;}
        return o;
    }
    let app:i32=-1;
    let done:i32=0;
    // ies -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ies")==1){k=k-3;app=121;done=1;}
    // sses/xes/zes/ches/shes -> strip 2
    if(done==0 && nc>5){
        if(ew(tmp,j0,k,"sses")==1 || ew(tmp,j0,k,"xes")==1 || ew(tmp,j0,k,"zes")==1 || ew(tmp,j0,k,"ches")==1 || ew(tmp,j0,k,"shes")==1){
            k=k-2;done=1;
        }
    }
    // es -> strip 1
    if(done==0 && ew(tmp,j0,k,"es")==1){k=k-1;done=1;}
    // s (not ss) -> strip 1
    if(done==0 && ew(tmp,j0,k,"s")==1 && ew(tmp,j0,k,"ss")==0){k=k-1;done=1;}
    // ied -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ied")==1){k=k-3;app=121;done=1;}
    // ed
    if(done==0 && ew(tmp,j0,k,"ed")==1){
        let cl:i32=0;
        while(j0+cl<k-2){vb[cl]=tmp[j0+cl];cl=cl+1;}
        vb[cl]=101;cl=cl+1;
        if(in_list(vb[0..cl],lex_verb())==1){k=k-2;app=101;}
        else{
            if(nc>5 && z_isvowel(tmp[k-3] as i32)==1){k=k-1;}
            else{k=k-2;}
        }
        done=1;
    }
    // ing
    if(done==0 && nc>6 && ew(tmp,j0,k,"ing")==1){
        let bl:i32=0;
        while(j0+bl<k-3){vb[bl]=tmp[j0+bl];bl=bl+1;}
        vb[bl]=101;bl=bl+1;
        if(in_list(vb[0..bl],lex_verb())==1){k=k-3;app=101;}
        else{
            let bend:i32=0;
            if(k-3>j0){bend=tmp[k-4] as i32;}
            if(k-3>j0 && bend==101){k=k-3;}
            else{
                if(k-3>j0 && z_isvowel(bend)==0){k=k-3;}
                else{k=k-3;app=101;}
            }
        }
        done=1;
    }
    // ly
    if(done==0 && nc>5 && ew(tmp,j0,k,"ly")==1){k=k-2;done=1;}
    // emit
    let o2:i32=0;
    while(j0+o2<k){out[o2]=tmp[j0+o2];o2=o2+1;}
    if(app>=0){out[o2]=app as u8;o2=o2+1;}
    return o2;
}

// ==================== clause splitter ====================
// Python: protect (\d)\.(\d) (non-overlapping, left to right), then split
// on [.!?;\u2014]+, strip, drop empties. prot must be zeroed, len >= t.len.
fn z_clauses(t:[]u8,ar:[]u8,prot:[]u8,max:i32)i32{
    let n:i32=t.len;
    // prot is a reused scratch buffer: clear this call's range (Python
    // rebuilds the protected string fresh on every call)
    let z:i32=0;
    while(z<n){prot[z]=0;z=z+1;}
    let p:i32=0;
    while(p+2<n){
        if(z_isdig(t[p] as i32)==1 && (t[p+1] as i32)==46 && z_isdig(t[p+2] as i32)==1){
            prot[p+1]=1;
            p=p+3;
        }else{p=p+1;}
    }
    let k:i32=0;
    let i:i32=0;
    let st:i32=-1;
    while(i<n && k<max){
        let b:i32=t[i] as i32;
        let sep:i32=0;
        let w:i32=1;
        if(b==46 && prot[i]==0){sep=1;}
        if(b==33 || b==63 || b==59){sep=1;}
        if(b==226 && i+2<n && (t[i+1] as i32)==128 && (t[i+2] as i32)==148){sep=1;w=3;}
        if(sep==1){
            if(st>=0){
                // keep the original spacing (Python only drops parts that
                // strip to empty); z_blank mirrors str.strip() emptiness
                if(z_blank(t[st..i])==0){
                    a_put(ar,2*k,st);
                    a_put(ar,2*k+1,i-st);
                    k=k+1;
                }
                st=-1;
            }
            i=i+w;
        }else{
            if(st<0){st=i;}
            i=i+1;
        }
    }
    if(st>=0 && k<max){
        if(z_blank(t[st..n])==0){
            a_put(ar,2*k,st);
            a_put(ar,2*k+1,n-st);
            k=k+1;
        }
    }
    return k;
}
// 1 if s is empty or all ASCII whitespace (mirrors Python str.strip()=="" for
// the ASCII-whitespace cases that reach clause filtering; a clause of only
// non-ASCII whitespace cannot occur here because toks() would find no token
// and scan_text skips zero-token clauses anyway)
fn z_blank(s:[]u8)i32{
    let i:i32=0;
    while(i<s.len){
        if(z_isspace(s[i] as i32)==0){return 0;}
        i=i+1;
    }
    return 1;
}

// ==================== stance helpers ====================
// Negation scoping the predicate: marker within 4 tokens before pi.
// Markers: NEG_TOKENS, ASCII n't, U+2019 n't.
fn neg_scope(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,tmp:[]u8)i32{
    let j:i32=pi-4;
    if(j<0){j=0;}
    while(j<pi && j<nct){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(in_list(w,lex_neg())==1){return 1;}
        if(ew(w,0,ll,"n't")==1){return 1;}
        if(ll>=4 && (w[ll-4] as i32)==226 && (w[ll-3] as i32)==128 && (w[ll-2] as i32)==153 && (w[ll-1] as i32)==116){return 1;}
        j=j+1;
    }
    return 0;
}
// The entity the clause's predicate is asserted of, when it is NOT the
// claim's subject. Returns 1 if a competing proper noun exists.
fn competitor(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,firstA:[]u8,tmp:[]u8)i32{
    // (1) immediate subject: nearest non-filler token before predicate
    let j:i32=pi-1;
    while(j>=0){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_filler())==0){break;}
        j=j-1;
    }
    if(j>=0){
        let to2:i32=a_get(tokC,2*j);
        let tl2:i32=a_get(tokC,2*j+1);
        let tj:[]u8=clause[to2..to2+tl2];
        if(z_cplen(tj)>=3 && z_isupper1(tj)==1){
            let so:i32=a_get(cstmC,2*j);
            let sl:i32=a_get(cstmC,2*j+1);
            if(in_stems(stemC[so..so+sl],stemA,cstemA,ncs)==0){return 1;}
        }
    }
    // (2) far-field: capitalized entity before predicate while the claim's
    // subject anchor (first content word) is absent from the clause
    if(in_stems(firstA,stemC,cstmC,nct)==0){
        let kk:i32=1;
        while(kk<pi && kk<nct){
            let to3:i32=a_get(tokC,2*kk);
            let tl3:i32=a_get(tokC,2*kk+1);
            let tk:[]u8=clause[to3..to3+tl3];
            if(z_cplen(tk)>=4 && z_isupper1(tk)==1){
                let so2:i32=a_get(cstmC,2*kk);
                let sl2:i32=a_get(cstmC,2*kk+1);
                let ll3:i32=lower_copy(tk,tmp);
                if(in_stems(stemC[so2..so2+sl2],stemA,cstemA,ncs)==0 && in_list(tmp[0..ll3],lex_conjskip())==0){return 1;}
            }
            kk=kk+1;
        }
    }
    return 0;
}
fn is_interrog(clause:[]u8,tokC:[]u8,nct:i32,tmp:[]u8)i32{
    if(z_has(clause,"?")==1){return 1;}
    if(nct>0){
        let to:i32=a_get(tokC,0);
        let tl:i32=a_get(tokC,1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_whaux())==1 && nct<=10){return 1;}
    }
    return 0;
}
// Claim numbers: runs matching Python re \d[\d,]* (digit followed by digits
// or commas), stored raw; has_claim_value() strips ","/" " from both sides
// before the substring test. No minimum length, no trailing-comma strip:
// "1," yields num "1" exactly as in the prototype.
fn claim_numbers(claim:[]u8,numa:[]u8,max:i32)i32{
    let n:i32=claim.len;
    let p:i32=0;
    let k:i32=0;
    while(p<n && k<max){
        if(z_isdig(claim[p] as i32)==1){
            let q:i32=p;
            while(q<n && (z_isdig(claim[q] as i32)==1 || (claim[q] as i32)==44)){q=q+1;}
            a_put(numa,2*k,p);
            a_put(numa,2*k+1,q-p);
            k=k+1;
            p=q;
        }else{p=p+1;}
    }
    return k;
}
fn has_claim_value(clause:[]u8,claim:[]u8,numa:[]u8,nnums:i32,clvB:[]u8,tmp:[]u8)i32{
    if(nnums==0){return 0;}
    let n:i32=clause.len;
    let k:i32=0;
    let i:i32=0;
    while(i<n){
        let b:i32=clause[i] as i32;
        if(b!=44 && b!=32){clvB[k]=clause[i];k=k+1;}
        i=i+1;
    }
    let cl2:[]u8=clvB[0..k];
    i=0;
    while(i<nnums){
        let no:i32=a_get(numa,2*i);
        let nl:i32=a_get(numa,2*i+1);
        let num:[]u8=claim[no..no+nl];
        let m:i32=num.len;
        let k2:i32=0;
        let jj:i32=0;
        while(jj<m){
            let b2:i32=num[jj] as i32;
            if(b2!=44 && b2!=32){tmp[k2]=num[jj];k2=k2+1;}
            jj=jj+1;
        }
        if(z_has(cl2,tmp[0..k2])==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ==================== numeric guard (B2 contrastive fix) ====================
// If the claim asserts a numeric value (digits, or word-numbers one..thirty)
// and the evidence carries a numeric value of a DIFFERENT magnitude for the
// same quantity class, the endorse path must not return AFFIRM:
//   2 = DENY  (comparable magnitudes that contradict the claim)
//   0 = no action (no claim number, no evidence number, a match/range hit,
//       or abstention -- numbers present but not comparable)
// Round-3 contract: the guard only VETOES (2). Abstention returns 0 and the
// normal classification continues; an abstain never vetoes an endorse.
// Unit classes: 0 = unitless, 1 = time (second/minute/hour/day/month/year,
// normalized to seconds), 2 = temperature (tenth-degree C; bare "degrees"
// tries both C and F readings). Round-2 constraints: same-quantity gate
// (boil vs freeze phenomenon), same-entity gate (human vs animal/plant),
// name/identifier numbers ignored (Planet Nine, 5G, COVID-19, DOI tokens,
// "Solar System 101"), 5% tolerance for approximate / sci-notation values
// ("approximately 3 x 10^8" ~= 299,792,458).
// Round-3 concession rule: the claim's number recited inside a concession
// marker ("just", "learned that", "traditional answer", "used to think")
// before a pivot ("but"/"however"/"actually"/"now"/"tells us") does not
// count as agreement -- when the asserted post-pivot clause carries a
// different comparable number, the asserted number wins (scan_ev_text drops
// the conceded pre-pivot part).
// A word-number "one" directly preceded by
// this/that/these/those is pronominal ("this one fruit"), not a quantity.
fn wnum(w:[]u8)i32{
    if(z_eq(w,"one")==1){return 1;}
    if(z_eq(w,"two")==1){return 2;}
    if(z_eq(w,"three")==1){return 3;}
    if(z_eq(w,"four")==1){return 4;}
    if(z_eq(w,"five")==1){return 5;}
    if(z_eq(w,"six")==1){return 6;}
    if(z_eq(w,"seven")==1){return 7;}
    if(z_eq(w,"eight")==1){return 8;}
    if(z_eq(w,"nine")==1){return 9;}
    if(z_eq(w,"ten")==1){return 10;}
    if(z_eq(w,"eleven")==1){return 11;}
    if(z_eq(w,"twelve")==1){return 12;}
    if(z_eq(w,"thirteen")==1){return 13;}
    if(z_eq(w,"fourteen")==1){return 14;}
    if(z_eq(w,"fifteen")==1){return 15;}
    if(z_eq(w,"sixteen")==1){return 16;}
    if(z_eq(w,"seventeen")==1){return 17;}
    if(z_eq(w,"eighteen")==1){return 18;}
    if(z_eq(w,"nineteen")==1){return 19;}
    if(z_eq(w,"twenty")==1){return 20;}
    if(z_eq(w,"thirty")==1){return 30;}
    return 0;
}
fn umul(w:[]u8)i64{
    if(z_eq(w,"second")==1){return 1;}
    if(z_eq(w,"seconds")==1){return 1;}
    if(z_eq(w,"minute")==1){return 60;}
    if(z_eq(w,"minutes")==1){return 60;}
    if(z_eq(w,"hour")==1){return 3600;}
    if(z_eq(w,"hours")==1){return 3600;}
    if(z_eq(w,"day")==1){return 86400;}
    if(z_eq(w,"days")==1){return 86400;}
    if(z_eq(w,"month")==1){return 2592000;}
    if(z_eq(w,"months")==1){return 2592000;}
    if(z_eq(w,"year")==1){return 31536000;}
    if(z_eq(w,"years")==1){return 31536000;}
    return 0;
}
// "one" after these is pronominal ("this one fruit", "each one has"), not a
// quantity -- the numeric guard skips it.
fn is_demo(w:[]u8)i32{
    if(z_eq(w,"this")==1){return 1;}
    if(z_eq(w,"that")==1){return 1;}
    if(z_eq(w,"these")==1){return 1;}
    if(z_eq(w,"those")==1){return 1;}
    if(z_eq(w,"each")==1){return 1;}
    if(z_eq(w,"every")==1){return 1;}
    if(z_eq(w,"any")==1){return 1;}
    return 0;
}
// space-grouped thousands: t[q] is ' ', t[q+1..q+3] digits, t[q+4] not digit
fn sp_grp(t:[]u8,q:i32,ll:i32)i32{
    if(q+4>ll){return 0;}
    if(z_isdig(t[q+1] as i32)==0){return 0;}
    if(z_isdig(t[q+2] as i32)==0){return 0;}
    if(z_isdig(t[q+3] as i32)==0){return 0;}
    if(q+4<ll && z_isdig(t[q+4] as i32)==1){return 0;}
    return 1;
}
// ==================== B2 round-2: contrastive constrainer helpers ====================
// Capitalized-word / token / word-list utilities used to constrain the
// numeric guard: name-identifier filter, unit-aware temperature compare,
// same-quantity gate (boil vs freeze), same-entity gate (human vs animal),
// approximation tolerance (incl. scientific notation).
fn is_capb(t:[]u8,s:i32)i32{
    if(s<0 || s>=t.len){return 0;}
    let c:i32=t[s] as i32;
    if(c>=65 && c<=90){return 1;}
    return 0;
}
fn is_alphab(c:i32)i32{
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
// start index of the word ending before position p, or -1
fn prevw_start(t:[]u8,p:i32)i32{
    let j:i32=p-1;
    while(j>=0 && is_alphab(t[j] as i32)==0){j=j-1;}
    if(j<0){return -1;}
    while(j>=0 && is_alphab(t[j] as i32)==1){j=j-1;}
    return j+1;
}
fn prevw_cap(t:[]u8,p:i32)i32{
    let s:i32=prevw_start(t,p);
    if(s<0){return 0;}
    return is_capb(t,s);
}
// two words before p are BOTH capitalized ("Solar System 101")
fn prev2w_cap(t:[]u8,p:i32)i32{
    let s1:i32=prevw_start(t,p);
    if(s1<0){return 0;}
    if(is_capb(t,s1)==0){return 0;}
    let s2:i32=prevw_start(t,s1);
    if(s2<0){return 0;}
    return is_capb(t,s2);
}
fn nextw_cap(t:[]u8,q:i32,ll:i32)i32{
    let j:i32=q;
    while(j<ll && is_alphab(t[j] as i32)==0){j=j+1;}
    if(j>=ll){return 0;}
    return is_capb(t,j);
}
// token (space-delimited run) containing [p,q): bit0=letter outside the
// number run, bit1=has '/', bit2=has '.', bit3=two or more '/'
fn tok_bits(t:[]u8,p:i32,q:i32,ll:i32)i32{
    let ts:i32=p;
    while(ts>0 && z_isspace(t[ts-1] as i32)==0){ts=ts-1;}
    let te:i32=q;
    while(te<ll && z_isspace(t[te] as i32)==0){te=te+1;}
    let bits:i32=0;
    let sl:i32=0;
    let i:i32=ts;
    while(i<te){
        let c:i32=t[i] as i32;
        if(is_alphab(c)==1 && (i<p || i>=q)){bits=bits|1;}
        if(c==47){sl=sl+1;}
        if(c==46){bits=bits|4;}
        i=i+1;
    }
    if(sl>=1){bits=bits|2;}
    if(sl>=2){bits=bits|8;}
    return bits;
}
// whole-word match of w at s[i] (s is lowercased)
fn match_at(s:[]u8,i:i32,w:[]u8)i32{
    let k:i32=0;
    while(k<w.len){
        if((s[i+k] as i32)!=(w[k] as i32)){return 0;}
        k=k+1;
    }
    if(i>0){
        let c0:i32=s[i-1] as i32;
        if(c0>=97 && c0<=122){return 0;}
    }
    let e:i32=i+w.len;
    if(e<s.len){
        let c1:i32=s[e] as i32;
        if(c1>=97 && c1<=122){return 0;}
    }
    return 1;
}
fn has_word_in(s:[]u8,a:i32,b:i32,w:[]u8)i32{
    let i:i32=a;
    while(i+w.len<=b){
        if(match_at(s,i,w)==1){return 1;}
        i=i+1;
    }
    return 0;
}
fn nearest_dist(s:[]u8,a:i32,b:i32,w:[]u8,pos:i32)i32{
    let best:i32=99999;
    let i:i32=a;
    while(i+w.len<=b){
        if(match_at(s,i,w)==1){
            let d:i32=i-pos;
            if(d<0){d=0-d;}
            if(d<best){best=d;}
            i=i+w.len;
        }else{i=i+1;}
    }
    return best;
}
// phenomenon words: which=1 boil-class, which=2 freeze-class
fn phenom_words_in(s:[]u8,a:i32,b:i32,which:i32)i32{
    if(which==1){
        if(has_word_in(s,a,b,"boil")==1){return 1;}
        if(has_word_in(s,a,b,"boils")==1){return 1;}
        if(has_word_in(s,a,b,"boiling")==1){return 1;}
        if(has_word_in(s,a,b,"boiled")==1){return 1;}
        return 0;
    }
    if(has_word_in(s,a,b,"freeze")==1){return 1;}
    if(has_word_in(s,a,b,"freezes")==1){return 1;}
    if(has_word_in(s,a,b,"freezing")==1){return 1;}
    if(has_word_in(s,a,b,"frozen")==1){return 1;}
    if(has_word_in(s,a,b,"froze")==1){return 1;}
    if(has_word_in(s,a,b,"frost")==1){return 1;}
    if(has_word_in(s,a,b,"ice")==1){return 1;}
    if(has_word_in(s,a,b,"melt")==1){return 1;}
    if(has_word_in(s,a,b,"melts")==1){return 1;}
    if(has_word_in(s,a,b,"melting")==1){return 1;}
    if(has_word_in(s,a,b,"melted")==1){return 1;}
    return 0;
}
// entity words: which=1 human-class, which=2 animal/plant-class
fn ent_words_in(s:[]u8,a:i32,b:i32,which:i32)i32{
    if(which==1){
        if(has_word_in(s,a,b,"human")==1){return 1;}
        if(has_word_in(s,a,b,"humans")==1){return 1;}
        if(has_word_in(s,a,b,"mankind")==1){return 1;}
        if(has_word_in(s,a,b,"man")==1){return 1;}
        if(has_word_in(s,a,b,"woman")==1){return 1;}
        if(has_word_in(s,a,b,"men")==1){return 1;}
        if(has_word_in(s,a,b,"women")==1){return 1;}
        if(has_word_in(s,a,b,"people")==1){return 1;}
        if(has_word_in(s,a,b,"person")==1){return 1;}
        return 0;
    }
    if(has_word_in(s,a,b,"fly")==1){return 1;}
    if(has_word_in(s,a,b,"flies")==1){return 1;}
    if(has_word_in(s,a,b,"rice")==1){return 1;}
    if(has_word_in(s,a,b,"plant")==1){return 1;}
    if(has_word_in(s,a,b,"plants")==1){return 1;}
    if(has_word_in(s,a,b,"mouse")==1){return 1;}
    if(has_word_in(s,a,b,"mice")==1){return 1;}
    if(has_word_in(s,a,b,"rat")==1){return 1;}
    if(has_word_in(s,a,b,"rats")==1){return 1;}
    if(has_word_in(s,a,b,"dog")==1){return 1;}
    if(has_word_in(s,a,b,"dogs")==1){return 1;}
    if(has_word_in(s,a,b,"cat")==1){return 1;}
    if(has_word_in(s,a,b,"cats")==1){return 1;}
    if(has_word_in(s,a,b,"bird")==1){return 1;}
    if(has_word_in(s,a,b,"birds")==1){return 1;}
    if(has_word_in(s,a,b,"fish")==1){return 1;}
    if(has_word_in(s,a,b,"monkey")==1){return 1;}
    if(has_word_in(s,a,b,"monkeys")==1){return 1;}
    if(has_word_in(s,a,b,"ape")==1){return 1;}
    if(has_word_in(s,a,b,"apes")==1){return 1;}
    if(has_word_in(s,a,b,"bacteria")==1){return 1;}
    if(has_word_in(s,a,b,"yeast")==1){return 1;}
    if(has_word_in(s,a,b,"worm")==1){return 1;}
    if(has_word_in(s,a,b,"worms")==1){return 1;}
    if(has_word_in(s,a,b,"frog")==1){return 1;}
    if(has_word_in(s,a,b,"frogs")==1){return 1;}
    return 0;
}
fn ent_nearest(s:[]u8,a:i32,b:i32,pos:i32,which:i32)i32{
    let best:i32=99999;
    let d:i32=0;
    if(which==1){
        d=nearest_dist(s,a,b,"human",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"humans",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"mankind",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"man",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"woman",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"men",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"women",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"people",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"person",pos);if(d<best){best=d;}
        return best;
    }
    d=nearest_dist(s,a,b,"fly",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"flies",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"rice",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"plant",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"plants",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"mouse",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"mice",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"rat",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"rats",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"dog",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"dogs",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"cat",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"cats",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"bird",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"birds",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"fish",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"monkey",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"monkeys",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"ape",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"apes",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"bacteria",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"yeast",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"worm",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"worms",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"frog",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"frogs",pos);if(d<best){best=d;}
    return best;
}
// approximation markers in s[a..b): words or the ~ sign (U+2248)
fn approx_hit(s:[]u8,a:i32,b:i32)i32{
    if(has_word_in(s,a,b,"approximately")==1){return 1;}
    if(has_word_in(s,a,b,"approx")==1){return 1;}
    if(has_word_in(s,a,b,"about")==1){return 1;}
    if(has_word_in(s,a,b,"around")==1){return 1;}
    if(has_word_in(s,a,b,"roughly")==1){return 1;}
    if(has_word_in(s,a,b,"nearly")==1){return 1;}
    if(has_word_in(s,a,b,"almost")==1){return 1;}
    if(has_word_in(s,a,b,"circa")==1){return 1;}
    let i:i32=a;
    while(i+3<=b){
        if((s[i] as i32)==226 && (s[i+1] as i32)==136 && (s[i+2] as i32)==136){return 1;}
        i=i+1;
    }
    return 0;
}
// quantity-noun hash: trailing 's' stripped; len<=1 counts as unmarked (0)
fn noun_hash(s:[]u8,a:i32,b:i32)i32{
    let l:i32=b-a;
    if(l<=1){return 0;}
    if((s[b-1] as i32)==115 && l>2){l=l-1;}
    if(l<=1){return 0;}
    let h:i32=7;
    let i:i32=0;
    while(i<l){
        h=h*31+((s[a+i] as i32));
        i=i+1;
    }
    if(h<0){h=0-h;}
    if(h==0){h=1;}
    return h;
}
// temperature scale word: 1=C 2=F 3=K 4=bare "degrees" 0=none
fn temp_scale_word(w:[]u8)i32{
    if(z_eq(w,"celsius")==1){return 1;}
    if(z_eq(w,"centigrade")==1){return 1;}
    if(z_eq(w,"fahrenheit")==1){return 2;}
    if(z_eq(w,"kelvin")==1){return 3;}
    if(z_eq(w,"degrees")==1){return 4;}
    return 0;
}
// canonical temperature: tenth-degree Celsius (i32)
fn temp_canon(v:i64,scale:i32)i32{
    let x:i64=v;
    if(x>20000000){x=20000000;}
    if(x<-20000000){x=-20000000;}
    if(scale==1){return (x*10) as i32;}
    if(scale==2){return ((x-32)*50/9) as i32;}
    return ((x-273)*10) as i32;
}
// range/point match: exact containment, or 5% band when ap=1
fn band_ok(lo:i32,hi:i32,ap:i32,cv:i32)i32{
    if(ap==1){
        let l:i64=(lo as i64)-((lo as i64)/20);
        let h:i64=(hi as i64)+((hi as i64)/20);
        let c:i64=cv as i64;
        if(c>=l && c<=h){return 1;}
        return 0;
    }
    if(lo<=cv && cv<=hi){return 1;}
    return 0;
}
fn within_tol(a:i64,b:i64,ap:i32)i32{
    if(ap==1){
        let d:i64=a-b;
        if(d<0){d=0-d;}
        if(b==0){
            if(d==0){return 1;}
            return 0;
        }
        let bb:i64=b;
        if(bb<0){bb=0-bb;}
        if(d*20<=bb){return 1;}
        return 0;
    }
    if(a==b){return 1;}
    return 0;
}
// temperature compare; ambiguous "degrees" tries both C and F readings
fn temp_compat(elo:i32,ehi:i32,eap:i32,eamb:i32,cv:i32,cap:i32,camb:i32)i32{
    let ap:i32=0;
    if(eap==1 || cap==1){ap=1;}
    if(eamb==0 && camb==0){
        return band_ok(elo,ehi,ap,cv);
    }
    let ev0:i64=elo as i64;
    let ev1:i64=elo as i64;
    if(eamb==1){
        ev0=(elo as i64)*10;
        ev1=((elo as i64)-32)*50/9;
    }
    let cv0:i64=cv as i64;
    let cv1:i64=cv as i64;
    if(camb==1){
        cv0=(cv as i64)*10;
        cv1=((cv as i64)-32)*50/9;
    }
    if(within_tol(ev0,cv0,ap)==1){return 1;}
    if(within_tol(ev0,cv1,ap)==1){return 1;}
    if(within_tol(ev1,cv0,ap)==1){return 1;}
    if(within_tol(ev1,cv1,ap)==1){return 1;}
    return 0;
}
// Scan text for numeric entries: eA=lo, eB=hi, eC=unit class, eD=flags
// (bit0=approximate, bit1=temperature scale ambiguous), eE=quantity-noun
// hash (0=unmarked). i32 arenas.
// Entries start at index `start`; returns the new count. Ranges form on a
// second number after "to"/"and"/"-" (e.g. "22 and 33" -> [22,33]).
// Unit classes: 0=unitless, 1=time (seconds), 2=temperature (tenth-degree C,
// or raw value + ambiguous flag for bare "degrees").
// qphenom: claim phenomenon class (0 none, 1 boil, 2 freeze) -- evidence
//   numbers in a conflicting-phenomenon window are skipped (same-quantity
//   gate). qent: claim entity class (0 none, 1 human) -- evidence numbers
//   whose nearest entity marker is animal/plant are skipped (same-entity
//   gate). Numbers inside names/identifiers (Planet Nine, 5G, COVID-19,
//   DOI tokens, "Solar System 101") are skipped outright.
fn ev_scan(t:[]u8,eA:[]u8,eB:[]u8,eC:[]u8,eD:[]u8,eE:[]u8,start:i32,maxn:i32,qphenom:i32,qent:i32)i32{
    let low:[]u8=z_alloc(t.len+1);
    if(low.len==0){return start;}
    let ll:i32=lower_copy(t,low);
    let n:i32=start;
    let p:i32=0;
    let pt0:i32=0;
    let pt1:i32=0;
    while(p<ll && n<maxn){
        let b:i32=low[p] as i32;
        let isd:i32=z_isdig(b);
        let isa:i32=0;
        if(b>=97 && b<=122){isa=1;}
        if(isd==0 && isa==0){p=p+1;continue;}
        let v:i64=-1;
        let q:i32=p;
        let sci:i32=0;
        let tscale:i32=0;
        if(isd==1){
            v=0;
            while(q<ll){
                let c:i32=low[q] as i32;
                if(z_isdig(c)==1){v=v*10+((c-48) as i64);if(v>2000000000){v=2000000000;}q=q+1;continue;}
                if(c==44){q=q+1;continue;}
                if(c==32 && sp_grp(low,q,ll)==1){q=q+1;continue;}
                break;
            }
            // compact temperature suffix: 100C, 212F, 100°C, 32°F
            // (parsed before the identifier filter, which would read the
            // bare C/F as an identifier letter)
            if(q<ll){
                let s0:i32=low[q] as i32;
                if(s0==194 && q+2<ll && (low[q+1] as i32)==176){
                    let dc:i32=low[q+2] as i32;
                    if(dc==99){tscale=1;q=q+3;}
                    else{if(dc==102){tscale=2;q=q+3;}}
                }else{
                    if(s0==99 || s0==102){
                        let sa:i32=q+1;
                        if(sa>=ll || is_alphab(low[sa] as i32)==0){
                            if(s0==99){tscale=1;}else{tscale=2;}
                            q=q+1;
                        }
                    }
                }
            }
            // name/identifier filter: letters in the token (5G, COVID-19),
            // DOI/URL tokens (slash+dot or 2+ slashes), course numbers
            // ("Solar System 101": small int after two capitalized words,
            // followed by a title separator)
            let tb:i32=tok_bits(t,p,q,ll);
            if((tb & 1)==1){p=q;continue;}
            if(((tb & 2)==1 && (tb & 4)==1) || (tb & 8)==1){p=q;continue;}
            if(v>=0 && v<=999 && prev2w_cap(t,p)==1){
                let na:i32=q;
                while(na<ll && z_isspace(t[na] as i32)==1){na=na+1;}
                if(na>=ll){p=q;continue;}
                let nc0:i32=t[na] as i32;
                if(nc0==124 || nc0==40 || nc0==58 || nc0==45){p=q;continue;}
            }
            // scientific notation: N x 10^E, N x 10^E, N \times 10^E
            let sq:i32=q;
            while(sq<ll && (low[sq] as i32)==32){sq=sq+1;}
            let isx:i32=0;
            if(sq<ll && (low[sq] as i32)==120){isx=1;sq=sq+1;}
            else{
                if(sq+1<ll && (low[sq] as i32)==195 && (low[sq+1] as i32)==151){isx=1;sq=sq+2;}
                else{
                    if(sq<ll && (low[sq] as i32)==92){
                        if(sq+5<ll && (low[sq+1] as i32)==116 && (low[sq+2] as i32)==105 && (low[sq+3] as i32)==109 && (low[sq+4] as i32)==101 && (low[sq+5] as i32)==115){isx=1;sq=sq+6;}
                    }
                }
            }
            if(isx==1){
                while(sq<ll && (low[sq] as i32)==32){sq=sq+1;}
                if(sq+1<ll && (low[sq] as i32)==49 && (low[sq+1] as i32)==48){
                    sq=sq+2;
                    if(sq<ll && (low[sq] as i32)==94){
                        sq=sq+1;
                        let ex:i32=0;
                        let ed:i32=0;
                        while(sq<ll && z_isdig(low[sq] as i32)==1){ex=ex*10+((low[sq] as i32)-48);ed=1;sq=sq+1;}
                        if(ed==1){
                            let pw:i64=1;
                            let k:i32=0;
                            while(k<ex){pw=pw*10;if(pw>2000000000){break;}k=k+1;}
                            if(pw>2000000000){pw=2000000000;}
                            v=v*pw;
                            if(v>2000000000){v=2000000000;}
                            q=sq;
                            sci=1;
                        }
                    }
                }
            }
        }else{
            let r:i32=p;
            while(r<ll){let c2:i32=low[r] as i32;if(c2<97 || c2>122){break;}r=r+1;}
            let tok:[]u8=low[p..r];
            let wv:i32=wnum(tok);
            if(wv>0){
                if(wv==1 && is_demo(low[pt0..pt1])==1){pt0=p;pt1=r;p=r;continue;}
                // proper-name filter: capitalized number-word next to a
                // capitalized word ("Planet Nine") is a name, not a value
                if(is_capb(t,p)==1 && (prevw_cap(t,p)==1 || nextw_cap(t,r,ll)==1)){pt0=p;pt1=r;p=r;continue;}
                v=wv as i64;
            }
            pt0=p;pt1=r;
            q=r;
            if(v<0){p=r;continue;}
        }
        // approximation marker: sci-notation, or approx word in the 30
        // bytes before the number
        let ap:i32=sci;
        if(ap==0){
            let aa:i32=p-30;
            if(aa<0){aa=0;}
            if(approx_hit(low,aa,p)==1){ap=1;}
        }
        let r0:i32=q;
        while(r0<ll && (low[r0] as i32)==32){r0=r0+1;}
        let isrng:i32=0;
        let r1:i32=r0;
        if(r0<ll && (low[r0] as i32)==45){isrng=1;r1=r0+1;}
        if(isrng==0 && r0<ll && (low[r0] as i32)>=97 && (low[r0] as i32)<=122){
            let r2:i32=r0;
            while(r2<ll){let c4:i32=low[r2] as i32;if(c4<97 || c4>122){break;}r2=r2+1;}
            let cw:[]u8=low[r0..r2];
            if(z_eq(cw,"to")==1 || z_eq(cw,"and")==1){isrng=1;r1=r2;}
        }
        let v2:i64=v;
        let q2:i32=q;
        if(isrng==1){
            let s2:i32=r1;
            while(s2<ll && (low[s2] as i32)==32){s2=s2+1;}
            if(s2<ll && z_isdig(low[s2] as i32)==1){
                v2=0;q2=s2;
                while(q2<ll){
                    let c6:i32=low[q2] as i32;
                    if(z_isdig(c6)==1){
                        v2=v2*10+((c6-48) as i64);
                        if(v2>2000000000){v2=2000000000;}
                        q2=q2+1;continue;
                    }
                    if(c6==32 && sp_grp(low,q2,ll)==1){q2=q2+1;continue;}
                    break;
                }
            }else{isrng=0;}
        }
        let u0:i32=q2;
        while(u0<ll && ((low[u0] as i32)==32 || (low[u0] as i32)==45)){u0=u0+1;}
        let um:i64=0;
        let nw0:i32=-1;
        let nw1:i32=0;
        if(tscale==0 && u0<ll && (low[u0] as i32)>=97 && (low[u0] as i32)<=122){
            let r3:i32=u0;
            while(r3<ll){let c5:i32=low[r3] as i32;if(c5<97 || c5>122){break;}r3=r3+1;}
            nw0=u0;
            nw1=r3;
            um=umul(low[u0..r3]);
            if(um==0){
                tscale=temp_scale_word(low[u0..r3]);
                if(tscale==4){
                    // bare "degrees": peek the next word for an explicit scale
                    let w0:i32=r3;
                    while(w0<ll && (low[w0] as i32)==32){w0=w0+1;}
                    if(w0<ll && (low[w0] as i32)>=97 && (low[w0] as i32)<=122){
                        let w1:i32=w0;
                        while(w1<ll){let c7:i32=low[w1] as i32;if(c7<97 || c7>122){break;}w1=w1+1;}
                        let ts2:i32=temp_scale_word(low[w0..w1]);
                        if(ts2>=1 && ts2<=3){tscale=ts2;r3=w1;}
                    }
                }
            }
            q2=r3;
        }else{
            if(tscale==0){
                // degree-sign units: °C °F °K
                if(u0+2<ll && (low[u0] as i32)==194 && (low[u0+1] as i32)==176){
                    let dc:i32=low[u0+2] as i32;
                    if(dc==99){tscale=1;q2=u0+3;}
                    else{
                        if(dc==102){tscale=2;q2=u0+3;}
                        else{if(dc==107){tscale=3;q2=u0+3;}}
                    }
                }
            }
        }
        let lo:i64=v;
        let hi:i64=v;
        if(isrng==1){
            if(v2<v){lo=v2;hi=v;}
            else{lo=v;hi=v2;}
        }
        let uc:i32=0;
        let amb:i32=0;
        if(um>0){
            uc=1;
            if(lo>66000){lo=2000000000;}else{lo=lo*um;}
            if(hi>66000){hi=2000000000;}else{hi=hi*um;}
            if(lo>2000000000){lo=2000000000;}
            if(hi>2000000000){hi=2000000000;}
        }else{
            if(tscale>0){
                uc=2;
                if(tscale==4){amb=1;}
                else{lo=temp_canon(lo,tscale);hi=temp_canon(hi,tscale);}
            }
        }
        // complement filter: "the other 90 percent" is the complement of
        // the claim's value, not a competing value
        let ca0:i32=p-25;
        if(ca0<0){ca0=0;}
        if(has_word_in(low,ca0,p,"other")==1){p=q2;continue;}
        if(has_word_in(low,ca0,p,"another")==1){p=q2;continue;}
        if(has_word_in(low,ca0,p,"remaining")==1){p=q2;continue;}
        // same-quantity gate: skip evidence numbers sitting in a
        // conflicting-phenomenon window (freezing vs boiling)
        if(qphenom!=0){
            let wa:i32=p-60;
            if(wa<0){wa=0;}
            let wb:i32=q2+60;
            if(wb>ll){wb=ll;}
            let hB:i32=phenom_words_in(low,wa,wb,1);
            let hF:i32=phenom_words_in(low,wa,wb,2);
            if(qphenom==1 && hF==1 && hB==0){p=q2;continue;}
            if(qphenom==2 && hB==1 && hF==0){p=q2;continue;}
        }
        // same-entity gate: skip evidence numbers whose nearest entity
        // marker is animal/plant when the claim is about humans
        if(qent==1){
            let wa2:i32=p-60;
            if(wa2<0){wa2=0;}
            let wb2:i32=q2+60;
            if(wb2>ll){wb2=ll;}
            let dh:i32=ent_nearest(low,wa2,wb2,p,1);
            let da:i32=ent_nearest(low,wa2,wb2,p,2);
            if(da<dh){p=q2;continue;}
        }
        a_put(eA,n,lo as i32);
        a_put(eB,n,hi as i32);
        a_put(eC,n,uc);
        let fl:i32=ap;
        if(amb==1){fl=fl|2;}
        a_put(eD,n,fl);
        // quantity-noun hash for unitless entries ("10 percent" vs
        // "twenty-thousandth decimal place" are different quantities);
        // single-letter nouns ("m") count as unmarked
        let nh:i32=0;
        if(uc==0 && nw0>=0){nh=noun_hash(low,nw0,nw1);}
        a_put(eE,n,nh);
        n=n+1;
        p=q2;
    }
    z_free(low);
    return n;
}
// Classify one evidence entry against the claim's number:
//   0 = not comparable (unit class differs, or a marked unitless noun
//       differs from the claim's marked noun -- different quantity)
//   1 = comparable and matches the claim value
//   2 = comparable and contradicts the claim value
fn cmp_entry(elo:i32,ehi:i32,eap:i32,eamb:i32,euc:i32,enh:i32,cv:i32,cu:i32,cap:i32,camb:i32,cnh:i32)i32{
    if(euc!=cu){return 0;}
    if(cu==0){
        if(enh!=0 && cnh!=0 && enh!=cnh){return 0;}
    }
    if(cu==2){
        if(temp_compat(elo,ehi,eap,eamb,cv,cap,camb)==1){return 1;}
        return 2;
    }
    let ap:i32=0;
    if(eap==1 || cap==1){ap=1;}
    if(band_ok(elo,ehi,ap,cv)==1){return 1;}
    return 2;
}
// Earliest whole-word concession pivot in s[0..ll):
// "but" | "however" | "actually" | "now" | "tells us". Returns -1 if none.
// (lower_copy is length-preserving, so positions also index the original.)
fn find_pivot(s:[]u8,ll:i32)i32{
    let i:i32=0;
    while(i<ll){
        if(i+3<=ll && match_at(s,i,"but")==1){return i;}
        if(i+7<=ll && match_at(s,i,"however")==1){return i;}
        if(i+8<=ll && match_at(s,i,"actually")==1){return i;}
        if(i+3<=ll && match_at(s,i,"now")==1){return i;}
        if(i+8<=ll && match_at(s,i,"tells us")==1){return i;}
        i=i+1;
    }
    return -1;
}
// Concession markers: the claim's number recited only to be corrected.
fn has_marker(s:[]u8,a:i32,b:i32)i32{
    if(has_word_in(s,a,b,"just")==1){return 1;}
    if(has_word_in(s,a,b,"learned that")==1){return 1;}
    if(has_word_in(s,a,b,"traditional answer")==1){return 1;}
    if(has_word_in(s,a,b,"used to think")==1){return 1;}
    return 0;
}
// Scan one evidence text into the shared arenas, applying the concession
// rule (round 3): if a pivot splits the text, the pre-pivot part carries a
// concession marker AND the claim's number, and the post-pivot (asserted)
// part carries a different comparable number, only the asserted part is
// scanned -- the asserted number wins over the conceded one. The marker,
// pivot, and value-presence checks run on a lowercased copy; ev_scan itself
// always sees original-case slices (capitalization filters need it).
// Returns the new entry count.
fn scan_ev_text(t:[]u8,ea:[]u8,ne:i32,qphenom:i32,qent:i32,eb:[]u8,cv:i32,cu:i32,cap:i32,camb:i32,cnh:i32)i32{
    let lt:[]u8=z_alloc(t.len+1);
    if(lt.len==0){
        return ev_scan(t,ea[0..64],ea[64..128],ea[128..192],ea[192..256],ea[256..320],ne,16,qphenom,qent);
    }
    let ll:i32=lower_copy(t,lt);
    let low:[]u8=lt[0..ll];
    let eff0:i32=0;
    let piv:i32=find_pivot(low,ll);
    if(piv>=0 && has_marker(low,0,piv)==1){
        let pn:i32=ev_scan(t[0..piv],eb[0..64],eb[64..128],eb[128..192],eb[192..256],eb[256..320],0,16,qphenom,qent);
        let preh:i32=0;
        let e:i32=0;
        while(e<pn){
            let efl:i32=a_get(eb[192..256],e);
            let r:i32=cmp_entry(a_get(eb,e),a_get(eb[64..128],e),efl & 1,(efl>>1) & 1,a_get(eb[128..192],e),a_get(eb[256..320],e),cv,cu,cap,camb,cnh);
            if(r==1){preh=1;}
            e=e+1;
        }
        let qn:i32=ev_scan(t[piv..ll],eb[0..64],eb[64..128],eb[128..192],eb[192..256],eb[256..320],0,16,qphenom,qent);
        let postd:i32=0;
        e=0;
        while(e<qn){
            let efl2:i32=a_get(eb[192..256],e);
            let r2:i32=cmp_entry(a_get(eb,e),a_get(eb[64..128],e),efl2 & 1,(efl2>>1) & 1,a_get(eb[128..192],e),a_get(eb[256..320],e),cv,cu,cap,camb,cnh);
            if(r2==2){postd=1;}
            e=e+1;
        }
        if(preh==1 && postd==1){eff0=piv;}
    }
    z_free(lt);
    return ev_scan(t[eff0..ll],ea[0..64],ea[64..128],ea[128..192],ea[192..256],ea[256..320],ne,16,qphenom,qent);
}
// numeric_guard: 0 = no action (pass-through; normal classification
// continues), 2 = force DENY on a genuine detected numeric mismatch.
// Round-3 contract: the guard only ever VETOES. Abstention (numbers on both
// sides but not comparable, or no evidence numbers at all) returns 0 and
// lets the endorse path decide -- an abstain must never veto an endorse.
// Round-2 constraints: the guard fires only on genuine numeric
// contradictions -- same quantity (phenomenon gate), same entity (subject
// gate), unit-aware compare with F<->C conversion, name/identifier numbers
// ignored, 5% tolerance for approximate / scientific-notation values.
// Round-3 concession rule: a conceded claim-number ("just five ... but
// actually 22 to 33") does not count as agreement; the asserted number wins.
fn numeric_guard(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ca:[]u8=z_alloc(80);
    if(ca.len==0){return 0;}
    let nc:i32=ev_scan(claim,ca[0..16],ca[16..32],ca[32..48],ca[48..64],ca[64..80],0,1,0,0);
    if(nc==0){z_free(ca);return 0;}
    let cv:i32=a_get(ca,nc-1);
    let cu:i32=a_get(ca[32..48],nc-1);
    let cfl:i32=a_get(ca[48..64],nc-1);
    let cap:i32=cfl & 1;
    let camb:i32=(cfl>>1) & 1;
    let cnh:i32=a_get(ca[64..80],nc-1);
    z_free(ca);
    // claim phenomenon + entity classes (drive the evidence gates)
    let lc:[]u8=z_alloc(claim.len+1);
    if(lc.len==0){return 0;}
    let lcl:i32=lower_copy(claim,lc);
    let qphenom:i32=0;
    if(phenom_words_in(lc,0,lcl,1)==1){qphenom=1;}
    else{if(phenom_words_in(lc,0,lcl,2)==1){qphenom=2;}}
    let qent:i32=0;
    if(ent_words_in(lc,0,lcl,1)==1){qent=1;}
    z_free(lc);
    let ea:[]u8=z_alloc(320);
    if(ea.len==0){return 0;}
    let eb:[]u8=z_alloc(320);
    if(eb.len==0){z_free(ea);return 0;}
    let ne:i32=scan_ev_text(title,ea,0,qphenom,qent,eb,cv,cu,cap,camb,cnh);
    ne=scan_ev_text(snip,ea,ne,qphenom,qent,eb,cv,cu,cap,camb,cnh);
    z_free(eb);
    if(ne==0){z_free(ea);return 0;}
    let compat:i32=0;
    let hadcmp:i32=0;
    let e:i32=0;
    while(e<ne){
        let efl:i32=a_get(ea[192..256],e);
        let r:i32=cmp_entry(a_get(ea,e),a_get(ea[64..128],e),efl & 1,(efl>>1) & 1,a_get(ea[128..192],e),a_get(ea[256..320],e),cv,cu,cap,camb,cnh);
        if(r==1){compat=1;hadcmp=1;}
        else{if(r==2){hadcmp=1;}}
        e=e+1;
    }
    z_free(ea);
    if(compat==1){return 0;}
    if(hadcmp==1){return 2;}
    // abstain: not comparable, or no evidence numbers -- pass through and
    // let normal classification continue (never veto an endorse).
    return 0;
}

// ==================== clause scanner ====================
// Scans one text's clauses (title OR snippet -- never mixed). Returns
// 0 (no deny), 1 deny-lex, 2 antonym, 3 neg-scope, 4 competing-subject.
// Sets affB[0]=1 on first endorsing clause.
fn scan_text(t:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,stemB:[]u8,tstmB:[]u8,ntstm:i32,firstA:[]u8,lastA:[]u8,pred:[]u8,need:i32,numa:[]u8,nnums:i32,claim:[]u8,clauA:[]u8,protB:[]u8,tokC:[]u8,stemC:[]u8,cstmC:[]u8,lowB:[]u8,clvB:[]u8,tmpS:[]u8,outS:[]u8,vbS:[]u8,affB:[]u8)i32{
    let ncl:i32=z_clauses(t,clauA,protB,256);
    let c:i32=0;
    while(c<ncl){
        let co:i32=a_get(clauA,2*c);
        let cl:i32=a_get(clauA,2*c+1);
        let clause:[]u8=t[co..co+cl];
        let nct:i32=z_toks(clause,tokC,1024);
        if(nct==0){c=c+1;continue;}
        // clause stems
        let soffC:i32=0;
        let i:i32=0;
        while(i<nct){
            let to:i32=a_get(tokC,2*i);
            let tl:i32=a_get(tokC,2*i+1);
            let sl:i32=z_stem(clause[to..to+tl],outS,tmpS,vbS);
            let q:i32=0;
            while(q<sl){stemC[soffC+q]=outS[q];q=q+1;}
            a_put(cstmC,2*i,soffC);
            a_put(cstmC,2*i+1,sl);
            soffC=soffC+sl;
            i=i+1;
        }
        // n_claim + anchor
        let nclm:i32=0;
        i=0;
        while(i<ncs){
            let so:i32=a_get(cstemA,2*i);
            let sl2:i32=a_get(cstemA,2*i+1);
            if(in_stems(stemA[so..so+sl2],stemC,cstmC,nct)==1){nclm=nclm+1;}
            i=i+1;
        }
        let anch:i32=0;
        if(in_stems(firstA,stemC,cstmC,nct)==1 || in_stems(lastA,stemC,cstmC,nct)==1){anch=1;}
        let lowl:i32=lower_copy(clause,lowB);
        let low:[]u8=lowB[0..lowl];
        // --- DENY (a): denial lexicon ---
        let strong:i32=0;
        let weak:i32=0;
        i=0;
        while(i<nct){
            let so3:i32=a_get(cstmC,2*i);
            let sl3:i32=a_get(cstmC,2*i+1);
            let st:[]u8=stemC[so3..so3+sl3];
            if(in_list(st,lex_strong())==1 || deny_prefix(st)==1){strong=1;}
            let to2:i32=a_get(tokC,2*i);
            let tl2:i32=a_get(tokC,2*i+1);
            let ll2:i32=lower_copy(clause[to2..to2+tl2],tmpS);
            if(in_list(tmpS[0..ll2],lex_weak())==1){weak=1;}
            i=i+1;
        }
        if(z_has(low,"no evidence")==1){weak=1;}
        if(z_has(low,"no longer")==1){weak=1;}
        let ana:i32=0;
        if(strong==1 && nct<=8){
            let k2:i32=0;
            i=0;
            while(i<ncs){
                let so4:i32=a_get(cstemA,2*i);
                let sl4:i32=a_get(cstemA,2*i+1);
                if(in_stems(stemA[so4..so4+sl4],stemB,tstmB,ntstm)==1){k2=k2+1;}
                i=i+1;
            }
            if(k2>=3){ana=1;}
        }
        if((strong==1 && nclm>=1) || (weak==1 && nclm>=2) || ana==1){return 1;}
        // --- DENY (d): antonym ---
        if(in_stems("flat",stemA,cstemA,ncs)==1 && nclm>=1){
            if(in_stems("spherical",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("sphere",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("round",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("globe",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("oblate",stemC,cstmC,nct)==1){return 2;}
        }
        if(in_stems("spherical",stemA,cstemA,ncs)==1 && in_stems("flat",stemC,cstmC,nct)==1 && nclm>=1){return 2;}
        // --- predicate-dependent rules ---
        let pi:i32=-1;
        i=0;
        while(i<nct){
            let so5:i32=a_get(cstmC,2*i);
            let sl5:i32=a_get(cstmC,2*i+1);
            if(psyn_has(stemC[so5..so5+sl5],pred)==1){pi=i;break;}
            i=i+1;
        }
        if(pi<0){c=c+1;continue;}
        // --- DENY (b): negation scoping the predicate ---
        let ns:i32=neg_scope(clause,tokC,nct,pi,tmpS);
        if(ns==1 && nclm>=1){return 3;}
        // --- DENY (c): competing subject + superlative/identity predicate ---
        let comp:i32=competitor(clause,tokC,nct,pi,stemC,cstmC,stemA,cstemA,ncs,firstA,tmpS);
        if(comp==1 && nclm>=1 && in_stems(firstA,stemC,cstmC,nct)==1){
            if(z_eq(pred,"be")==1 || has_superlative(stemC,cstmC,nct)==1){
                if(is_interrog(clause,tokC,nct,tmpS)==0 && has_claim_value(clause,claim,numa,nnums,clvB,tmpS)==0){
                    return 4;
                }
            }
        }
        // --- AFFIRM: positive endorsement evidence only ---
        if(affB[0]==0){
            let framed:i32=0;
            if(z_has(low,"conspiracy theory")==1){framed=1;}
            if(z_has(low,"choose a legend")==1){framed=1;}
            if(z_starts(low,"legend:")==1){framed=1;}
            if(z_has(low,"urban legend")==1){framed=1;}
            if(nclm>=need && anch==1 && ns==0 && is_interrog(clause,tokC,nct,tmpS)==0 && framed==0 && comp==0){
                affB[0]=1;
            }
        }
        c=c+1;
    }
    return 0;
}

// ==================== classifier ====================
// Scratch map (100000 bytes, carved identically on every call):
//   TOKA  [0,1024)       claim tokens (128 x 8)
//   STEMA [1024,9216)    claim stem bytes
//   WORDA [9216,11264)   content words (128 x 16: tokoff,toklen,stoff,stlen)
//   CSTEMA[11264,12288)   claim deduped stems (128 x 8)
//   TMPS  [12288,12800)  stem/lower working buffer
//   OUTS  [12800,13312)  stem output buffer
//   VBS   [13312,13440)  verb-form candidate buffer
//   FULLB [13440,17536)  title + " " + snippet
//   TOKB  [17536,25728)  full-text tokens (1024 x 8)
//   STEMB [25728,42112)  full-text stem bytes
//   TSTMB [42112,50304)  full-text stems (1024 x 8)
//   CLAUA [50304,52352)  clauses (256 x 8)
//   PROTB [52352,56448)  decimal-point protection flags
//   TOKC  [56448,64640)  clause tokens (1024 x 8)
//   STEMC [64640,81024)  clause stem bytes
//   CSTMC [81024,89216)  clause stems (1024 x 8)
//   LOWB  [89216,93312)  lowercased clause buffer
//   CLVB  [93312,97408)  clause-minus-punctuation buffer
//   NUMA  [97408,97920)  claim numbers (64 x 8)
//   AFFB  [97920,97928)  affirm flag
// Returns tag*8+reason. tag: 0 neutral/irrelevant, 1 affirm, 2 deny.
// reason: 0 gate, 1 deny-lex, 2 antonym, 3 neg-scope, 4 competing-subject,
//         5 endorse, 6 neutral.
fn r12_classify(claim:[]u8,title:[]u8,snip:[]u8,sc:[]u8)i32{
    let TOKA:[]u8=sc[0..1024];
    let STEMA:[]u8=sc[1024..9216];
    let WORDA:[]u8=sc[9216..11264];
    let CSTEMA:[]u8=sc[11264..12288];
    let TMPS:[]u8=sc[12288..12800];
    let OUTS:[]u8=sc[12800..13312];
    let VBS:[]u8=sc[13312..13440];
    let FULLB:[]u8=sc[13440..17536];
    let TOKB:[]u8=sc[17536..25728];
    let STEMB:[]u8=sc[25728..42112];
    let TSTMB:[]u8=sc[42112..50304];
    let CLAUA:[]u8=sc[50304..52352];
    let PROTB:[]u8=sc[52352..56448];
    let TOKC:[]u8=sc[56448..64640];
    let STEMC:[]u8=sc[64640..81024];
    let CSTMC:[]u8=sc[81024..89216];
    let LOWB:[]u8=sc[89216..93312];
    let CLVB:[]u8=sc[93312..97408];
    let NUMA:[]u8=sc[97408..97920];
    let AFFB:[]u8=sc[97920..97928];
    // ---- claim: tokens + content words ----
    let nct:i32=z_toks(claim,TOKA,128);
    let nw:i32=0;
    let soff:i32=0;
    let i:i32=0;
    while(i<nct && nw<128){
        let to:i32=a_get(TOKA,2*i);
        let tl:i32=a_get(TOKA,2*i+1);
        let tok:[]u8=claim[to..to+tl];
        if(z_cplen(tok)>3){
            let ll:i32=lower_copy(tok,TMPS);
            if(in_list(TMPS[0..ll],lex_stop())==0){
                let sl:i32=z_stem(tok,OUTS,TMPS,VBS);
                let q:i32=0;
                while(q<sl){STEMA[soff+q]=OUTS[q];q=q+1;}
                a_put(WORDA,4*nw,to);
                a_put(WORDA,4*nw+1,tl);
                a_put(WORDA,4*nw+2,soff);
                a_put(WORDA,4*nw+3,sl);
                soff=soff+sl;
                nw=nw+1;
            }
        }
        i=i+1;
    }
    // claim stem set (deduped)
    let ncs:i32=0;
    i=0;
    while(i<nw){
        let so:i32=a_get(WORDA,4*i+2);
        let sl2:i32=a_get(WORDA,4*i+3);
        if(in_stems(STEMA[so..so+sl2],STEMA,CSTEMA,ncs)==0){
            a_put(CSTEMA,2*ncs,so);
            a_put(CSTEMA,2*ncs+1,sl2);
            ncs=ncs+1;
        }
        i=i+1;
    }
    // strip leading gerund ("Drinking coffee causes..." -> core without Drinking)
    let cs:i32=0;
    if(nw>0){
        let to0:i32=a_get(WORDA,0);
        let tl0:i32=a_get(WORDA,1);
        let t0:[]u8=claim[to0..to0+tl0];
        let ll0:i32=lower_copy(t0,TMPS);
        if(ew(TMPS,0,ll0,"ing")==1){
            let so0:i32=a_get(WORDA,2);
            let sl0:i32=a_get(WORDA,3);
            if(in_list(STEMA[so0..so0+sl0],lex_verb())==1){cs=1;}
        }
    }
    // anchors: first/last content-word stems of the core
    let firstA:[]u8="";
    let lastA:[]u8="";
    if(cs<nw){
        let so1:i32=a_get(WORDA,4*cs+2);
        let sl1:i32=a_get(WORDA,4*cs+3);
        firstA=STEMA[so1..so1+sl1];
        let so2:i32=a_get(WORDA,4*(nw-1)+2);
        let sl2b:i32=a_get(WORDA,4*(nw-1)+3);
        lastA=STEMA[so2..so2+sl2b];
    }
    // predicate: first verb-stem core token, skipping reporting verbs
    let pred:[]u8="";
    let pfound:i32=0;
    i=cs;
    while(i<nw){
        let to3:i32=a_get(WORDA,4*i);
        let tl3:i32=a_get(WORDA,4*i+1);
        let so3:i32=a_get(WORDA,4*i+2);
        let sl3:i32=a_get(WORDA,4*i+3);
        let s3:[]u8=STEMA[so3..so3+sl3];
        if(in_list(s3,lex_verb())==1){
            let ll3:i32=lower_copy(claim[to3..to3+tl3],TMPS);
            if(in_list(TMPS[0..ll3],lex_reporting())==0 && in_list(s3,lex_reporting())==0){
                pred=s3;
                pfound=1;
                break;
            }
        }
        i=i+1;
    }
    if(pfound==0){
        // fallback: first auxiliary/copula among ALL tokens
        let fi:i32=0;
        while(fi<nct){
            let to4:i32=a_get(TOKA,2*fi);
            let tl4:i32=a_get(TOKA,2*fi+1);
            let ll4:i32=lower_copy(claim[to4..to4+tl4],TMPS);
            let lw4:[]u8=TMPS[0..ll4];
            if(in_list(lw4,lex_be())==1){pred="be";break;}
            if(in_list(lw4,lex_have())==1){pred="have";break;}
            fi=fi+1;
        }
    }
    // ---- overlap gate on the whole text ----
    let fl:i32=0;
    let ti:i32=0;
    while(ti<title.len){FULLB[fl]=title[ti];ti=ti+1;fl=fl+1;}
    FULLB[fl]=32;fl=fl+1;
    ti=0;
    while(ti<snip.len){FULLB[fl]=snip[ti];ti=ti+1;fl=fl+1;}
    let full:[]u8=FULLB[0..fl];
    let nft:i32=z_toks(full,TOKB,1024);
    let ntstm:i32=0;
    let soffB:i32=0;
    i=0;
    while(i<nft){
        let to5:i32=a_get(TOKB,2*i);
        let tl5:i32=a_get(TOKB,2*i+1);
        let sl5:i32=z_stem(full[to5..to5+tl5],OUTS,TMPS,VBS);
        let q5:i32=0;
        while(q5<sl5){STEMB[soffB+q5]=OUTS[q5];q5=q5+1;}
        a_put(TSTMB,2*ntstm,soffB);
        a_put(TSTMB,2*ntstm+1,sl5);
        soffB=soffB+sl5;
        ntstm=ntstm+1;
        i=i+1;
    }
    let need:i32=2;
    if(nw<3){need=1;}
    let inter:i32=0;
    i=0;
    while(i<ncs){
        let so6:i32=a_get(CSTEMA,2*i);
        let sl6:i32=a_get(CSTEMA,2*i+1);
        if(in_stems(STEMA[so6..so6+sl6],STEMB,TSTMB,ntstm)==1){inter=inter+1;}
        i=i+1;
    }
    if(inter<need){return 0;}
    // claim numbers (for the competing-subject value guard)
    let nnums:i32=claim_numbers(claim,NUMA,64);
    // ---- clause scan: title stream, then snippet stream ----
    AFFB[0]=0;
    let dr:i32=scan_text(title,STEMA,CSTEMA,ncs,STEMB,TSTMB,ntstm,firstA,lastA,pred,need,NUMA,nnums,claim,CLAUA,PROTB,TOKC,STEMC,CSTMC,LOWB,CLVB,TMPS,OUTS,VBS,AFFB);
    if(dr!=0){return 16+dr;}
    dr=scan_text(snip,STEMA,CSTEMA,ncs,STEMB,TSTMB,ntstm,firstA,lastA,pred,need,NUMA,nnums,claim,CLAUA,PROTB,TOKC,STEMC,CSTMC,LOWB,CLVB,TMPS,OUTS,VBS,AFFB);
    if(dr!=0){return 16+dr;}
    let ng:i32=numeric_guard(claim,title,snip);
    if(ng==2){return 16+7;}
    // ng==0 is pass-through: abstention never vetoes; the endorse path
    // decides on its own evidence.
    if(AFFB[0]==1){
        return 8+5;
    }
    return 6;
}

// ==================== driver ====================
fn reason_str(r:i32)[]u8{
    if(r==0){return "gate";}
    if(r==1){return "deny-lex";}
    if(r==2){return "antonym";}
    if(r==3){return "neg-scope";}
    if(r==4){return "competing-subject";}
    if(r==5){return "endorse";}
    if(r==7){return "numeric-mismatch";}
    return "neutral";
}
fn process_line(line:[]u8,sc:[]u8,ob:[]u8)void{
    let t1:i32=-1;
    let t2:i32=-1;
    let t3:i32=-1;
    let i:i32=0;
    while(i<line.len){
        if((line[i] as i32)==9){
            if(t1<0){t1=i;}
            else{
                if(t2<0){t2=i;}
                else{if(t3<0){t3=i;break;}}
            }
        }
        i=i+1;
    }
    if(t3<0){return;}
    let idx:[]u8=line[0..t1];
    let claim:[]u8=line[t1+1..t2];
    let title:[]u8=line[t2+1..t3];
    let snip:[]u8=line[t3+1..line.len];
    let r:i32=r12_classify(claim,title,snip,sc);
    let tag:i32=r/8;
    let rsn:i32=r-tag*8;
    let o:i32=0;
    let k:i32=0;
    while(k<idx.len){ob[o]=idx[k];o=o+1;k=k+1;}
    ob[o]=32;o=o+1;
    ob[o]=(48+tag) as u8;o=o+1;
    ob[o]=32;o=o+1;
    let rs:[]u8=reason_str(rsn);
    k=0;
    while(k<rs.len){ob[o]=rs[k];o=o+1;k=k+1;}
    ob[o]=10;o=o+1;
    _zag_print(ob[0..o]);
    return;
}
fn main()i32{
    let path:[]u8=_zag_arg(1);
    if(path.len==0){
        _zag_println("usage: r12 <input.tsv>");
        return 2;
    }
    let data:[]u8=read_all(path);
    if(data.len==0){
        _zag_println("r12: cannot read input");
        return 3;
    }
    let sc:[]u8=z_alloc(100000);
    if(sc.len==0){return 4;}
    let ob:[]u8=z_alloc(8192);
    if(ob.len==0){return 5;}
    let n:i32=data.len;
    let i:i32=0;
    let ls:i32=0;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;}
        else{if((data[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (data[le-1] as i32)==13){le=le-1;}
            if(le>ls){process_line(data[ls..le],sc,ob);}
            ls=i+1;
        }
        i=i+1;
    }
    return 0;
}

// ============================================================
// B-CREW percept vocabulary (Approach B, "human-style").
//
// Handles + fixed relation tables + composition ONLY.
//
// This file touches NO fixture bytes and performs NO arithmetic
// on raw sensory numbers (no RGB channels, no PCM samples, no
// pixel values). It compiles standalone: percept.zag imports
// nothing and a reviewer may delete transducer.zag entirely and
// this file still compiles, its relation tables still answering
// queries over opaque handles alone.
//
// Handle convention: i64 values in u16 range, opaque to the
// memory side. Decoding a handle into its vocabulary fields
// (e.g. hue/light/sat) is vocabulary structure, not raw data.
// ============================================================

// ---------------- COLOR ----------------
// Chromatic handle layout: 1000 + hue*6 + light*2 + sat
//   hue   0..11 : twelve hue categories around the wheel
//                 0 RED, 1 RED_ORANGE, 2 ORANGE, 3 AMBER,
//                 4 YELLOW, 5 YELLOW_GREEN, 6 GREEN, 7 TEAL,
//                 8 CYAN, 9 SKY, 10 BLUE, 11 VIOLET
//   light 0..2  : DARK / MID / LIGHT
//   sat   0..1  : MUTED / SATURATED
// Achromatic handles: 2000 BLACK, 2001 DARK_GRAY, 2002 GRAY,
//                     2003 LIGHT_GRAY, 2004 WHITE
// Vocabulary size: 72 chromatic + 5 achromatic = 77.
const PC_C_BASE:i64 = 1000;
const PC_C_ACH0:i64 = 2000;

fn pc_c_is_chroma(h:i64) i32 {
    if (h >= 1000 && h < 1072) { return 1; }
    return 0;
}
fn pc_c_hue(h:i64) i64 { return (h - 1000) / 6; }
fn pc_c_light(h:i64) i64 { return ((h - 1000) % 6) / 2; }
fn pc_c_sat(h:i64) i64 { return (h - 1000) % 2; }
// achromatic lightness rank, fixed table:
// BLACK->0 DARK_GRAY->0 GRAY->1 LIGHT_GRAY->2 WHITE->2
fn pc_c_ach_rank(h:i64) i64 {
    let i:i64 = h - 2000;
    if (i <= 1) { return 0; }
    if (i == 2) { return 1; }
    return 2;
}
fn pc_c_lrank(h:i64) i64 {
    if (pc_c_is_chroma(h) == 1) { return pc_c_light(h); }
    return pc_c_ach_rank(h);
}
// Hue-wheel distance: steps around the fixed 12-wheel.
// The wheel IS the relation table: RED nearer RED_ORANGE (1)
// than BLUE (4 the short way round).
fn pc_c_wheeldist(a:i64, b:i64) i64 {
    let d:i64 = a - b;
    if (d < 0) { d = 0 - d; }
    if (d > 6) { d = 12 - d; }
    return d;
}
// Percept distance between two color handles: vocabulary-level
// small integer. Chromatic: wheel steps + lightness steps +
// saturation steps. Achromatic pair: axis steps. Mixed:
// far by construction (4) plus lightness mismatch.
fn pc_color_dist(a:i64, b:i64) i64 {
    if (a == b) { return 0; }
    let ca:i32 = pc_c_is_chroma(a);
    let cb:i32 = pc_c_is_chroma(b);
    if (ca == 1 && cb == 1) {
        let wd:i64 = pc_c_wheeldist(pc_c_hue(a), pc_c_hue(b));
        let ld:i64 = pc_c_light(a) - pc_c_light(b);
        if (ld < 0) { ld = 0 - ld; }
        let sd:i64 = pc_c_sat(a) - pc_c_sat(b);
        if (sd < 0) { sd = 0 - sd; }
        return wd + ld + sd;
    }
    if (ca == 0 && cb == 0) {
        let d:i64 = a - b;
        if (d < 0) { d = 0 - d; }
        return d;
    }
    let la:i64 = pc_c_lrank(a);
    let lb:i64 = pc_c_lrank(b);
    let ld2:i64 = la - lb;
    if (ld2 < 0) { ld2 = 0 - ld2; }
    return 4 + ld2;
}
// Lightness order, defined by the vocabulary rank table:
// -1 = a darker, 0 = same rank, 1 = a lighter.
fn pc_color_lighter(a:i64, b:i64) i64 {
    let ra:i64 = pc_c_lrank(a);
    let rb:i64 = pc_c_lrank(b);
    if (ra < rb) { return -1; }
    if (ra > rb) { return 1; }
    return 0;
}
// Same/different at the percept level. Threshold (dist <= 1)
// is a documented design bet: identical handles, or one step
// on one vocabulary axis, count as the same color.
fn pc_color_same(a:i64, b:i64) i32 {
    if (pc_color_dist(a, b) <= 1) { return 1; }
    return 0;
}
// Confidence from percept-level distance margin only (per-mille).
fn pc_color_conf(a:i64, b:i64) i64 {
    let d:i64 = pc_color_dist(a, b);
    if (d == 0) { return 950; }
    if (d == 1) { return 700; }
    if (d == 2) { return 750; }
    if (d == 3) { return 850; }
    return 950;
}

// ---------------- SHAPE ----------------
// A shape percept is a 3-tuple of handles:
//   corners:   3000=CORNERS_0 3001=CORNERS_3 3002=CORNERS_4 3003=CORNERS_MANY
//   curvature: 3100=CURVED 3101=STRAIGHT 3102=MIXED
//   symmetry:  3200=SYM_FULL 3201=SYM_4 3202=SYM_3 3203=SYM_NONE
// Vocabulary size: 4 + 3 + 4 = 11 handles.
const PC_SH_C0:i64 = 3000;
const PC_SH_C3:i64 = 3001;
const PC_SH_C4:i64 = 3002;
const PC_SH_CMANY:i64 = 3003;
const PC_SH_CURVED:i64 = 3100;
const PC_SH_STRAIGHT:i64 = 3101;
const PC_SH_MIXED:i64 = 3102;
const PC_SH_SYM_FULL:i64 = 3200;
const PC_SH_SYM_4:i64 = 3201;
const PC_SH_SYM_3:i64 = 3202;
const PC_SH_SYM_NONE:i64 = 3203;

struct ShapeT {
    corners:i64,
    curv:i64,
    sym:i64
}

// Prototype table (fixed order): 0=CIRCLE 1=TRIANGLE 2=SQUARE.
// CIRCLE  = (0 corners, curved, full symmetry)
// TRIANGLE= (3 corners, straight, 3-fold symmetry)
// SQUARE  = (4 corners, straight, 4-fold symmetry)
fn pc_shape_proto_c(i:i64) i64 {
    if (i == 0) { return PC_SH_C0; }
    if (i == 1) { return PC_SH_C3; }
    return PC_SH_C4;
}
fn pc_shape_proto_v(i:i64) i64 {
    if (i == 0) { return PC_SH_CURVED; }
    return PC_SH_STRAIGHT;
}
fn pc_shape_proto_s(i:i64) i64 {
    if (i == 0) { return PC_SH_SYM_FULL; }
    if (i == 1) { return PC_SH_SYM_3; }
    return PC_SH_SYM_4;
}
// Tuple match score: how many of the 3 handles agree (0..3).
fn pc_shape_match(s:*ShapeT, proto:i64) i64 {
    let m:i64 = 0;
    if (s.*.corners == pc_shape_proto_c(proto)) { m = m + 1; }
    if (s.*.curv == pc_shape_proto_v(proto)) { m = m + 1; }
    if (s.*.sym == pc_shape_proto_s(proto)) { m = m + 1; }
    return m;
}
// Decide by best tuple match. Ties go to the earliest prototype
// in the fixed table order (deterministic, documented).
fn pc_shape_decide(s:*ShapeT, ops:*i64) i64 {
    let best:i64 = 0;
    let bestm:i64 = pc_shape_match(s, 0);
    ops.* = ops.* + 1;
    let m1:i64 = pc_shape_match(s, 1);
    ops.* = ops.* + 1;
    if (m1 > bestm) { best = 1; bestm = m1; }
    let m2:i64 = pc_shape_match(s, 2);
    ops.* = ops.* + 1;
    if (m2 > bestm) { best = 2; bestm = m2; }
    return best;
}
// Confidence from the percept-level match count only.
fn pc_shape_conf(s:*ShapeT, cls:i64) i64 {
    let m:i64 = pc_shape_match(s, cls);
    if (m >= 3) { return 950; }
    if (m == 2) { return 700; }
    return 400;
}

// ---------------- PITCH ----------------
// 48 ordered semitone-bin handles, 4000..4047, spanning
// 110 Hz .. 1760 Hz in 12-TET semitone steps. The ORDER is the
// relation table: a higher handle IS a higher pitch, by
// vocabulary definition. No frequency subtraction happens here.
// Vocabulary size: 48.
const PC_P_BASE:i64 = 4000;
const PC_P_COUNT:i64 = 48;
// -1 = a lower, 0 = same bin, 1 = a higher (table order).
fn pc_pitch_cmp(a:i64, b:i64) i64 {
    if (a < b) { return -1; }
    if (a > b) { return 1; }
    return 0;
}
fn pc_pitch_dist(a:i64, b:i64) i64 {
    let d:i64 = a - b;
    if (d < 0) { d = 0 - d; }
    return d;
}
// Confidence from percept-level bin distance only.
fn pc_pitch_conf(a:i64, b:i64) i64 {
    let d:i64 = pc_pitch_dist(a, b);
    if (d == 0) { return 950; }
    if (d == 1) { return 600; }
    if (d == 2) { return 750; }
    return 900;
}

// ---------------- TIMBRE ----------------
// Timbre-quality vocabulary + signal-clarity evidence handles.
// 5000=PURE 5001=BRIGHT 5002=DARK 5003=RICH
// 5100=EV_WEAK 5101=EV_MEDIUM 5102=EV_STRONG
// Vocabulary size: 4 + 3 = 7.
const PC_T_PURE:i64 = 5000;
const PC_T_BRIGHT:i64 = 5001;
const PC_T_DARK:i64 = 5002;
const PC_T_RICH:i64 = 5003;
const PC_EV_WEAK:i64 = 5100;
const PC_EV_MEDIUM:i64 = 5101;
const PC_EV_STRONG:i64 = 5102;

struct TimbreT {
    timbre:i64,
    ev:i64
}
// Fixed 4x4 similarity table over the timbre vocabulary:
// 0 = same, 1 = near, 2 = far. (Order: PURE BRIGHT DARK RICH.)
// Near pairs: PURE-RICH (both full-bodied), BRIGHT-RICH (both
// lively), PURE-DARK (both soft). All else far.
fn pc_timbre_sim(a:i64, b:i64) i64 {
    if (a == b) { return 0; }
    let ia:i64 = a - 5000;
    let ib:i64 = b - 5000;
    if (ia == 0 && ib == 3) { return 1; }
    if (ia == 3 && ib == 0) { return 1; }
    if (ia == 1 && ib == 3) { return 1; }
    if (ia == 3 && ib == 1) { return 1; }
    if (ia == 0 && ib == 2) { return 1; }
    if (ia == 2 && ib == 0) { return 1; }
    return 2;
}
// Confidence from the evidence handle only (percept level).
fn pc_timbre_conf(t:*TimbreT) i64 {
    if (t.*.ev == PC_EV_STRONG) { return 950; }
    if (t.*.ev == PC_EV_MEDIUM) { return 750; }
    return 500;
}

// ---------------- MOTION ----------------
// Direction handles: 6000=STILL 6001=N 6002=NE 6003=E 6004=SE
//                    6005=S 6006=SW 6007=W 6008=NW
// Speed handles: 6100=SLOW 6101=MEDIUM 6102=FAST
// Vocabulary size: 9 + 3 = 12.
const PC_M_STILL:i64 = 6000;
const PC_M_N:i64 = 6001;
const PC_M_NE:i64 = 6002;
const PC_M_E:i64 = 6003;
const PC_M_SE:i64 = 6004;
const PC_M_S:i64 = 6005;
const PC_M_SW:i64 = 6006;
const PC_M_W:i64 = 6007;
const PC_M_NW:i64 = 6008;
const PC_SPD_SLOW:i64 = 6100;
const PC_SPD_MEDIUM:i64 = 6101;
const PC_SPD_FAST:i64 = 6102;

struct MotionT {
    dir:i64,
    spd:i64
}
// Confidence from the speed handle only (percept level);
// STILL is its own high-confidence percept.
fn pc_motion_conf(m:*MotionT) i64 {
    if (m.*.dir == PC_M_STILL) { return 900; }
    if (m.*.spd == PC_SPD_FAST) { return 950; }
    if (m.*.spd == PC_SPD_MEDIUM) { return 800; }
    return 650;
}

// regress_degen.zag — DEGENERATE-INPUT REGRESSION HARNESS (2026-09-26).
//
// Empty text across ALL position question kinds, through the LIVE production
// intake (tnn_intake). Regression for the deterministic W25 panic
// ("panic: slice index out of bounds", t[-1] in cand_zoom_19's kind-2/8/9
// paths): the kind-2/8/9 position paths had no degenerate-input guard.
// Fixed 2026-09-26 in hand_c2.zag (guard: loc<0 || ll==0 -> '?' like a miss),
// intake.zag regenerated via assemble.py.
//
// Bar: 6/6 correct, 6/6 native, 0 fallbacks, no panic (rc=0),
// byte-identical reruns x2.
@import("./intake.zag")

fn unpack_correct(p:i64) i64 { return p-(p/2)*2; }
fn unpack_native(p:i64) i64 { let q1:i64=p/2; return q1-(q1/2)*2; }
fn unpack_fb(p:i64) i64 { let q2:i64=p/4; return q2-(q2/2)*2; }

fn main() void {
    let out:[]u8=nio_alloc(1048576);
    let at:i64=0;
    let scr:[]u8=nio_alloc(4096);
    let soff:[]u8=nio_alloc(256);
    let slen:[]u8=nio_alloc(256);
    let zlog:[]u8=nio_alloc(8192);
    let zn:i64=0;
    let woffs:[]u8=nio_alloc(256);
    let wlens:[]u8=nio_alloc(256);
    let revbuf:[]u8=nio_alloc(4096);
    let abuf:[]u8=nio_alloc(4096);
    let whyb:[]u8=nio_alloc(4096);
    at=ob_raw(out,at,"# DEGEN-RUN v1: empty-text position questions through the LIVE production intake");
    at=ob_nl(out,at);
    let lc:i64=0; let lnat:i64=0; let lfb:i64=0;
    // D0 [kind 2 POSITION] W25 verbatim: the reported panic.
    //   oracle: q='what is the 1st letter of ' t='' exp='?'
    at=ob_raw(out,at,"D 00 [kind2] q=\"what is the 1st letter of \" t=\"\" exp=\"?\"");
    at=ob_nl(out,at);
    zn=0;
    let p0:i64=tnn_intake(0,"what is the 1st letter of ","","?",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p0);
    lnat=lnat+unpack_native(p0);
    lfb=lfb+unpack_fb(p0);
    // D1 [kind 8 POS_FIRST]: empty text, first-letter question.
    //   oracle: q='what is the first letter of ' t='' exp='?'
    at=ob_raw(out,at,"D 01 [kind8] q=\"what is the first letter of \" t=\"\" exp=\"?\"");
    at=ob_nl(out,at);
    zn=0;
    let p1:i64=tnn_intake(1,"what is the first letter of ","","?",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p1);
    lnat=lnat+unpack_native(p1);
    lfb=lfb+unpack_fb(p1);
    // D2 [kind 9 POS_LAST]: empty text, last-letter question.
    //   oracle: q='what is the last letter of ' t='' exp='?'
    at=ob_raw(out,at,"D 02 [kind9] q=\"what is the last letter of \" t=\"\" exp=\"?\"");
    at=ob_nl(out,at);
    zn=0;
    let p2:i64=tnn_intake(2,"what is the last letter of ","","?",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p2);
    lnat=lnat+unpack_native(p2);
    lfb=lfb+unpack_fb(p2);
    // D3 [kind 12 POSITION_WORD]: empty text, word-addressed position.
    //   oracle: q='what is the 2nd letter of the 1st word of ' t='' exp='?'
    at=ob_raw(out,at,"D 03 [kind12] q=\"what is the 2nd letter of the 1st word of \" t=\"\" exp=\"?\"");
    at=ob_nl(out,at);
    zn=0;
    let p3:i64=tnn_intake(3,"what is the 2nd letter of the 1st word of ","","?",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p3);
    lnat=lnat+unpack_native(p3);
    lfb=lfb+unpack_fb(p3);
    // D4 [kind 14 FIRST_LETTER_WORD]: empty text, word-addressed first letter.
    //   oracle: q='what is the first letter of the 1st word of ' t='' exp='?'
    at=ob_raw(out,at,"D 04 [kind14] q=\"what is the first letter of the 1st word of \" t=\"\" exp=\"?\"");
    at=ob_nl(out,at);
    zn=0;
    let p4:i64=tnn_intake(4,"what is the first letter of the 1st word of ","","?",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p4);
    lnat=lnat+unpack_native(p4);
    lfb=lfb+unpack_fb(p4);
    // D5 [kind 15 LAST_LETTER_WORD]: empty text, word-addressed last letter.
    //   oracle: q='what is the last letter of the 1st word of ' t='' exp='?'
    at=ob_raw(out,at,"D 05 [kind15] q=\"what is the last letter of the 1st word of \" t=\"\" exp=\"?\"");
    at=ob_nl(out,at);
    zn=0;
    let p5:i64=tnn_intake(5,"what is the last letter of the 1st word of ","","?",out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,revbuf,abuf,whyb);
    lc=lc+unpack_correct(p5);
    lnat=lnat+unpack_native(p5);
    lfb=lfb+unpack_fb(p5);
    at=ob_raw(out,at,"# DEGEN SUMMARY n=6 correct=");
    at=ob_i64(out,at,lc,scr);
    at=ob_raw(out,at," native=");
    at=ob_i64(out,at,lnat,scr);
    at=ob_raw(out,at," fallback=");
    at=ob_i64(out,at,lfb,scr);
    at=ob_nl(out,at);
    nio_write_all(1,out[0..at]);
    return;
}

// ================= NO-BRIDGES COMPOSER: nb5 — fuse orchestration =================
// do_fuse_nb: parse (same as step-3) -> INVENT per memory (nb1..nb4: the
// mechanism invents its own segmentation method) -> CORRESPOND -> SLOT ->
// ADAPT -> TRACK -> SYNTHESIZE. Correspondence, adaptation and synthesis reuse
// the step-3 fusion machinery; the segmentation and its criteria are TNN's own
// invention. The head-to-head question is therefore clean: only the way of
// seeing changed.

// mean band difference between graft and recipient (seam self-check metric)
fn band_diff(graft:[]u8, alpha:[]u8, gw:i64, gh:i64, pxR:[]u8, RW:i64, px:i64, py:i64) i64 {
    let acc:i64 = 0;
    let c:i64 = 0;
    let gy:i64 = 0;
    while (gy < gh) {
        let gx:i64 = 0;
        while (gx < gw) {
            let a:i64 = alpha[gy * gw + gx] as i64;
            if (a > 16) {
                if (a < 240) {
                    let rx:i64 = px + gx;
                    let ry:i64 = py + gy;
                    if (rx >= 0) {
                        if (rx < RW) {
                            if (ry >= 0) {
                                if (ry < 240) {
                                    let o:i64 = (gy * gw + gx) * 3;
                                    let ro:i64 = (ry * RW + rx) * 3;
                                    let d0:i64 = (graft[o] as i64) - (pxR[ro] as i64);
                                    if (d0 < 0) { d0 = 0 - d0; }
                                    let d1:i64 = (graft[o + 1] as i64) - (pxR[ro + 1] as i64);
                                    if (d1 < 0) { d1 = 0 - d1; }
                                    let d2:i64 = (graft[o + 2] as i64) - (pxR[ro + 2] as i64);
                                    if (d2 < 0) { d2 = 0 - d2; }
                                    acc = acc + (d0 + d1 + d2) / 3;
                                    c = c + 1;
                                }
                            }
                        }
                    }
                }
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    if (c == 0) { return -1; }
    return acc / c;
}

fn nb_tr_fieldrec(tr:[]u8, o:i64, frec:[]u8, f:i64) i64 {
    let bo:i64 = f * 96;
    o = tr_str(tr, o, "   ");
    o = nb_fname(tr, o, f);
    o = tr_str(tr, o, ": min=");
    o = tr_i64(tr, o, h_get64(frec, bo));
    o = tr_str(tr, o, " max=");
    o = tr_i64(tr, o, h_get64(frec, bo + 8));
    o = tr_str(tr, o, " mean=");
    o = tr_i64(tr, o, h_get64(frec, bo + 16));
    o = tr_str(tr, o, " peaks=");
    o = tr_i64(tr, o, h_get64(frec, bo + 24));
    o = tr_str(tr, o, " valley_depth=");
    o = tr_i64(tr, o, h_get64(frec, bo + 32));
    o = tr_str(tr, o, " valley_level=");
    o = tr_i64(tr, o, h_get64(frec, bo + 40));
    o = tr_str(tr, o, " structuredness=");
    o = tr_i64(tr, o, h_get64(frec, bo + 48));
    o = tr_str(tr, o, " divisibility=");
    o = tr_i64(tr, o, h_get64(frec, bo + 56));
    o = tr_nl(tr, o);
    o = tr_str(tr, o, "     median=");
    o = tr_i64(tr, o, h_get64(frec, bo + 64));
    o = tr_str(tr, o, " q1=");
    o = tr_i64(tr, o, h_get64(frec, bo + 72));
    o = tr_str(tr, o, " q3=");
    o = tr_i64(tr, o, h_get64(frec, bo + 80));
    o = tr_str(tr, o, " knee=");
    o = tr_i64(tr, o, h_get64(frec, bo + 88));
    o = tr_nl(tr, o);
    return o;
}

fn do_fuse_nb(workA:[]u8, workB:[]u8, instr:[]u8, outd:[]u8) i64 {
    let st0:[]u8 = load_store_full(workA);
    let st1:[]u8 = load_store_full(workB);
    ensure_dir(outd);
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { return -600; }
    let tr:[]u8 = nio_alloc(1048576);
    let toc:[]u8 = nio_alloc(8);
    h_put64(toc, 0, 0);
    let to:i64 = 0;
    to = tr_str(tr, to, "FUSE_ATTEMPT v2 (no-bridges composer)\nmechanism: invention organ (invent/judge/decide) + fusion organ (correspond/adapt/synthesize), pure Zag, zero RNG\n");
    to = tr_str(tr, to, "DESIGN NOTE (honest): the programmer supplies neutral measurement instruments\n");
    to = tr_str(tr, to, "(per-pixel fields, histograms, gradients, connected components) and a vocabulary of\n");
    to = tr_str(tr, to, "cut-procedure schemas (VALLEY/MEDIAN/KNEE/BAND) plus scoring-formula schemas.\n");
    to = tr_str(tr, to, "TNN invents everything else: which fields to try, which procedures apply (from each\n");
    to = tr_str(tr, to, "field's own distribution shape), the cut levels (from histogram valleys, knees and\n");
    to = tr_str(tr, to, "medians it measures itself), the winning scoring formula (from a margin argument it\n");
    to = tr_str(tr, to, "computes over its own candidates), the subject rule (its own stated principle: the\n");
    to = tr_str(tr, to, "subject is the part that moves most), and the graftability standards it holds itself\n");
    to = tr_str(tr, to, "to. No percentile recipes, no fixed candidate list, no fixed score formula.\n");
    let lab0:[]u8 = nio_alloc(64);
    let lab1:[]u8 = nio_alloc(64);
    let l0n:i64 = store_label(st0, lab0);
    let l1n:i64 = store_label(st1, lab1);
    let lab0s:[]u8 = lab0[0..l0n];
    let lab1s:[]u8 = lab1[0..l1n];
    let i:i64 = 0;
    while (i < l0n) { lab0[i] = to_lower(lab0[i]); i = i + 1; }
    i = 0;
    while (i < l1n) { lab1[i] = to_lower(lab1[i]); i = i + 1; }
    let W:i64 = h_get64(st0, 32);
    let H:i64 = h_get64(st0, 40);
    let nf:i64 = h_get64(st0, 48);
    if (W != 320 || H != 240 || h_get64(st1, 32) != 320 || h_get64(st1, 40) != 240 || h_get64(st1, 48) != nf || nf != 24) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: fusion requires two 320x240 24-frame videos.\n");
        h_put64(toc, 0, to);
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    if (l0n == l1n) {
        let same:i64 = 1;
        let k:i64 = 0;
        while (k < l0n) { if (lab0[k] != lab1[k]) { same = 0; } k = k + 1; }
        if (same == 1) {
            to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: both memories carry the same label.\n");
            h_put64(toc, 0, to);
            write_buf(oroot, "fuse_refusal.txt", tr, to);
            nio_close(oroot);
            return 1;
        }
    }
    let n:i64 = instr.len;
    let cut:i64 = -1;
    i = 0;
    while (i < n) { if ((instr[i] as i64) == 47) { cut = i; } i = i + 1; }
    if (cut < 0) { return -620; }
    let iroot:i64 = nio_open_root(instr[0..cut]);
    if (iroot < 0) { return -621; }
    let ibuf:[]u8 = nio_alloc(4096);
    let ilen:i64 = read_file(iroot, instr[cut + 1..n], ibuf, 4096);
    nio_close(iroot);
    if (ilen < 0) { return -622; }
    let words:[]u8 = nio_alloc(256 * 16);
    let nw:i64 = tokenize(ibuf, ilen, words);
    let verb:i64 = detect_verb(ibuf, words, nw);
    let subj:[]u8 = nio_alloc(16);
    let ns:i64 = match_subjects(ibuf, words, nw, lab0s, lab1s, subj);
    to = tr_str(tr, to, "instruction: ");
    let ci:i64 = 0;
    while (ci < ilen) { tr[to + ci] = ibuf[ci]; ci = ci + 1; }
    to = to + ilen;
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "parse: verb=");
    let vn:[]u8 = nio_alloc(16);
    let vnl:i64 = verb_name(verb, vn);
    to = tr_str(tr, to, vn[0..vnl]);
    to = tr_str(tr, to, " subjects=[");
    let sj:i64 = 0;
    while (sj < ns) {
        if (sj > 0) { to = tr_str(tr, to, ","); }
        if (h_get64(subj, sj * 8) == 0) { to = tr_str(tr, to, lab0s); } else { to = tr_str(tr, to, lab1s); }
        sj = sj + 1;
    }
    to = tr_str(tr, to, "]");
    to = tr_nl(tr, to);
    if (verb != 1 || ns != 2) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: fusion needs a MERGE-class verb naming two distinct memorized subjects.\n");
        h_put64(toc, 0, to);
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    h_put64(toc, 0, to);
    let N:i64 = W * H;
    // scratch arenas (allocated once, threaded through the invention organ)
    let E0:[]u8 = nio_alloc((N * 8) as i32);
    let E1:[]u8 = nio_alloc((N * 8) as i32);
    let grayA:[]u8 = nio_alloc(N as i32);
    let grayB:[]u8 = nio_alloc(N as i32);
    let F1A:[]u8 = nio_alloc((N * 8) as i32);
    let F1B:[]u8 = nio_alloc((N * 8) as i32);
    let F3A:[]u8 = nio_alloc((N * 8) as i32);
    let F3B:[]u8 = nio_alloc((N * 8) as i32);
    let frec:[]u8 = nio_alloc(384);
    let hist:[]u8 = nio_alloc(256);
    let mm:[]u8 = nio_alloc(16);
    let mod:[]u8 = nio_alloc(64);
    let mtab:[]u8 = nio_alloc(1792);
    let fr:[]u8 = nio_alloc(230400);
    let fb:[]u8 = nio_alloc((N * 8) as i32);
    let gray:[]u8 = nio_alloc(N as i32);
    let labA:[]u8 = nio_alloc(N as i32);
    let labB:[]u8 = nio_alloc(N as i32);
    let labC:[]u8 = nio_alloc(N as i32);
    let tex12:[]u8 = nio_alloc((N * 8) as i32);
    let labbuf:[]u8 = nio_alloc((N * 8) as i32);
    let mask:[]u8 = nio_alloc(N as i32);
    let subj0:[]u8 = nio_alloc(N as i32);
    let subj1:[]u8 = nio_alloc(N as i32);
    let seg0:[]u8 = nio_alloc(128);
    let seg1:[]u8 = nio_alloc(128);
    let ord:[]u8 = nio_alloc(32);
    to = tr_str(tr, to, "--- INVENT (TNN invents its own way of seeing; per memory) ---\n");
    h_put64(toc, 0, to);
    let m:i64 = 0;
    while (m < 2) {
        let stm:[]u8 = st0;
        let Em:[]u8 = E0;
        let graym:[]u8 = grayA;
        let F1m:[]u8 = F1A;
        let F3m:[]u8 = F3A;
        let segm:[]u8 = seg0;
        let subm:[]u8 = subj0;
        let lm:[]u8 = lab0s;
        if (m == 1) {
            stm = st1;
            Em = E1;
            graym = grayB;
            F1m = F1B;
            F3m = F3B;
            segm = seg1;
            subm = subj1;
            lm = lab1s;
        }
        to = h_get64(toc, 0);
        to = tr_str(tr, to, "=== memory=");
        to = tr_str(tr, to, lm);
        to = tr_str(tr, to, " ===\n");
        to = tr_str(tr, to, " MEASURE (middle frame f12 + full-sequence motion; neutral instruments only):\n");
        h_put64(toc, 0, to);
        let rc:i64 = seg_motion_E(stm, Em, W, H, nf);
        if (rc != 0) { return -630 - m; }
        if (recall_frame(stm, 12, fr) != 0) { return -632 - m; }
        seg_gray(fr, graym, N);
        nb_measure(Em, graym, W, H, N, F1m, F3m, frec, hist, mm, mod, mask, labbuf);
        to = h_get64(toc, 0);
        let f:i64 = 0;
        while (f < 4) {
            to = nb_tr_fieldrec(tr, to, frec, f);
            f = f + 1;
        }
        to = tr_str(tr, to, " SEEING-HYPOTHESIS (my ordering by natural divisibility = valley-depth x structuredness):\n");
        // order fields by divisibility desc
        h_put64(ord, 0, 0);
        h_put64(ord, 8, 1);
        h_put64(ord, 16, 2);
        h_put64(ord, 24, 3);
        let a:i64 = 0;
        while (a < 4) {
            let b:i64 = a + 1;
            while (b < 4) {
                let fa:i64 = h_get64(ord, a * 8);
                let fb2:i64 = h_get64(ord, b * 8);
                if (h_get64(frec, fa * 96 + 56) < h_get64(frec, fb2 * 96 + 56)) {
                    h_put64(ord, a * 8, fb2);
                    h_put64(ord, b * 8, fa);
                }
                b = b + 1;
            }
            a = a + 1;
        }
        let r:i64 = 0;
        while (r < 4) {
            let fo:i64 = h_get64(ord, r * 8);
            to = tr_str(tr, to, "   ");
            to = tr_i64(tr, to, r + 1);
            to = tr_str(tr, to, ". ");
            to = nb_fname(tr, to, fo);
            to = tr_str(tr, to, " (divisibility=");
            to = tr_i64(tr, to, h_get64(frec, fo * 96 + 56));
            to = tr_str(tr, to, ")\n");
            r = r + 1;
        }
        to = tr_str(tr, to, " I lead with ");
        to = nb_fname(tr, to, h_get64(ord, 0));
        to = tr_str(tr, to, ": its distribution shows the clearest natural divisions. But this is only\n");
        to = tr_str(tr, to, " a hunch about where to look first - every field gets methods tried, and the JUDGE\n");
        to = tr_str(tr, to, " decides on measurements, not on my hunch.\n");
        to = tr_str(tr, to, " PROPOSE (my own method set, levels from each field's own distribution):\n");
        h_put64(toc, 0, to);
        let nm2:i64 = nb_propose(frec, mtab, tr, toc);
        to = h_get64(toc, 0);
        to = tr_str(tr, to, " JUDGE (my own criteria: P persistence, B boundary evidence, H homogeneity, F fragmentation):\n");
        h_put64(toc, 0, to);
        let winner:i64 = nb_judge(stm, nm2, mtab, W, H, N, Em, tr, toc, gray, fb, fr, labA, labB, labC, tex12, labbuf, mask);
        nb_decide(stm, winner, mtab, W, H, N, Em, gray, fb, fr, labB, labbuf, mask, tr, toc, segm, subm);
        m = m + 1;
    }
    to = h_get64(toc, 0);
    to = tr_str(tr, to, "--- CORRESPOND (rule, reused from step-3: recipient=argmax subject centrality; donor=other memory's subject) ---\n");
    let cent0:i64 = h_get64(seg0, 56);
    let cent1:i64 = h_get64(seg1, 56);
    let recip:i64 = 0;
    if (cent1 > cent0) { recip = 1; }
    to = tr_str(tr, to, " centrality: ");
    to = tr_str(tr, to, lab0s);
    to = tr_str(tr, to, "=");
    to = tr_i64(tr, to, cent0);
    to = tr_str(tr, to, " ");
    to = tr_str(tr, to, lab1s);
    to = tr_str(tr, to, "=");
    to = tr_i64(tr, to, cent1);
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " recipient=");
    if (recip == 0) { to = tr_str(tr, to, lab0s); } else { to = tr_str(tr, to, lab1s); }
    to = tr_str(tr, to, " (hosts the fusion: its invented subject is more central, more of a complete scene)");
    to = tr_nl(tr, to);
    let str_:[]u8 = st0;
    let std_:[]u8 = st1;
    let segR:[]u8 = seg0;
    let segD:[]u8 = seg1;
    let ER:[]u8 = E0;
    let ED:[]u8 = E1;
    let subjR:[]u8 = subj0;
    let subjD:[]u8 = subj1;
    let labRs:[]u8 = lab0s;
    let labDs:[]u8 = lab1s;
    if (recip == 1) {
        str_ = st1;
        std_ = st0;
        segR = seg1;
        segD = seg0;
        ER = E1;
        ED = E0;
        subjR = subj1;
        subjD = subj0;
        labRs = lab1s;
        labDs = lab0s;
    }
    to = tr_str(tr, to, " donor=");
    to = tr_str(tr, to, labDs);
    to = tr_str(tr, to, " part=its invented subject (winner of its own invention debate)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "--- SLOT (rule, reused: split recipient subject by neck-line; slot=argmax texture*upperness) ---\n");
    let r_x0:i64 = h_get64(segR, 8);
    let r_y0:i64 = h_get64(segR, 16);
    let r_x1:i64 = h_get64(segR, 24);
    let r_y1:i64 = h_get64(segR, 32);
    let neck:i64 = seg_neck(ER, subjR, W, H, r_x0, r_x1, r_y0, r_y1);
    if (neck < 0) {
        neck = (r_y0 + r_y1) / 2;
        to = tr_str(tr, to, " neck: no valid motion peaks; fallback to subject vertical midpoint (recorded)\n");
    } else {
        to = tr_str(tr, to, " neck: min-motion row between top-2 motion peaks = ");
        to = tr_i64(tr, to, neck);
        to = tr_nl(tr, to);
    }
    let pxR12:[]u8 = nio_alloc(230400);
    let gR12:[]u8 = nio_alloc(N as i32);
    let texR:[]u8 = nio_alloc((N * 8) as i32);
    if (recall_frame(str_, 12, pxR12) != 0) { return -640; }
    seg_gray(pxR12, gR12, N);
    seg_texture(gR12, texR, W, H);
    let ha:i64 = 0;
    let hx0:i64 = W;
    let hy0:i64 = H;
    let hx1:i64 = -1;
    let hy1:i64 = -1;
    let hsx:i64 = 0;
    let hsy:i64 = 0;
    let htex:i64 = 0;
    let ba:i64 = 0;
    let btex:i64 = 0;
    let bsx:i64 = 0;
    let bsy:i64 = 0;
    let bx0:i64 = W;
    let by0:i64 = H;
    let bx1:i64 = -1;
    let by1:i64 = -1;
    let p2:i64 = 0;
    while (p2 < N) {
        if (subjR[p2] != 0) {
            let x:i64 = p2 % W;
            let y:i64 = p2 / W;
            let tx:i64 = h_get64(texR, p2 * 8);
            if (y < neck) {
                ha = ha + 1;
                hsx = hsx + x;
                hsy = hsy + y;
                htex = htex + tx;
                if (x < hx0) { hx0 = x; }
                if (x > hx1) { hx1 = x; }
                if (y < hy0) { hy0 = y; }
                if (y > hy1) { hy1 = y; }
            } else {
                ba = ba + 1;
                bsx = bsx + x;
                bsy = bsy + y;
                btex = btex + tx;
                if (x < bx0) { bx0 = x; }
                if (x > bx1) { bx1 = x; }
                if (y < by0) { by0 = y; }
                if (y > by1) { by1 = y; }
            }
        }
        p2 = p2 + 1;
    }
    let hcx:i64 = 0;
    let hcy:i64 = 0;
    let htx:i64 = 0;
    let hup:i64 = 0;
    if (ha > 0) {
        hcx = hsx / ha;
        hcy = hsy / ha;
        htx = htex / ha;
        hup = (H - hcy) * 10000 / H;
    }
    let bcx:i64 = 0;
    let bcy:i64 = 0;
    let btx:i64 = 0;
    let bup:i64 = 0;
    if (ba > 0) {
        bcx = bsx / ba;
        bcy = bsy / ba;
        btx = btex / ba;
        bup = (H - bcy) * 10000 / H;
    }
    let hscore:i64 = htx * hup / 10000;
    let bscore:i64 = btx * bup / 10000;
    to = tr_str(tr, to, " head: area=");
    to = tr_i64(tr, to, ha);
    to = tr_str(tr, to, " bbox=(");
    to = tr_i64(tr, to, hx0);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, hy0);
    to = tr_str(tr, to, ")-(");
    to = tr_i64(tr, to, hx1);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, hy1);
    to = tr_str(tr, to, ") tex=");
    to = tr_i64(tr, to, htx);
    to = tr_str(tr, to, " upper=");
    to = tr_i64(tr, to, hup);
    to = tr_str(tr, to, " score=");
    to = tr_i64(tr, to, hscore);
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " body: area=");
    to = tr_i64(tr, to, ba);
    to = tr_str(tr, to, " tex=");
    to = tr_i64(tr, to, btx);
    to = tr_str(tr, to, " upper=");
    to = tr_i64(tr, to, bup);
    to = tr_str(tr, to, " score=");
    to = tr_i64(tr, to, bscore);
    to = tr_nl(tr, to);
    let slx0:i64 = hx0;
    let sly0:i64 = hy0;
    let slx1:i64 = hx1;
    let sly1:i64 = hy1;
    if (bscore > hscore) {
        slx0 = bx0;
        sly0 = by0;
        slx1 = bx1;
        sly1 = by1;
        to = tr_str(tr, to, " slot=BODY (texture*upper won; recorded, unusual)\n");
    } else {
        to = tr_str(tr, to, " slot=HEAD (face proxy: highest texture*upperness)\n");
    }
    let slw:i64 = slx1 - slx0 + 1;
    let slh:i64 = sly1 - sly0 + 1;
    let slot_area:i64 = slw * slh;
    let donor_area:i64 = h_get64(segD, 0);
    to = tr_str(tr, to, "--- GRAFTABILITY (my own standards, stated before measuring) ---\n");
    to = tr_str(tr, to, " S1: I will not upscale beyond 4x: donor area >= slot area / 4.\n");
    to = tr_str(tr, to, "     (Upscaling invents pixels I have no evidence for.)\n");
    to = tr_str(tr, to, " S2: a graftable part is at least 32x32 px of connected matter (1024 px);\n");
    to = tr_str(tr, to, "     below that there is no part to graft, only speckle.\n");
    to = tr_str(tr, to, " donor area=");
    to = tr_i64(tr, to, donor_area);
    to = tr_str(tr, to, " slot area=");
    to = tr_i64(tr, to, slot_area);
    to = tr_nl(tr, to);
    if (donor_area * 4 < slot_area) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: donor part too small for the slot (needs >4x upscale); S1 violated.\n");
        h_put64(toc, 0, to);
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    if (donor_area < 1024) {
        to = tr_str(tr, to, "RESULT: FUSE_REFUSED\nreason: donor part below 1024 px of connected matter; S2 violated.\n");
        h_put64(toc, 0, to);
        write_buf(oroot, "fuse_refusal.txt", tr, to);
        nio_close(oroot);
        return 1;
    }
    to = tr_str(tr, to, " graftability: PASS (S1 and S2 hold)\n");
    let perc:[]u8 = perc_alloc();
    if (perceive(str_, perc) != 0) { return -650; }
    let fc:i64 = h_get64(perc, 1616);
    let rcrect:[]u8 = nio_alloc(32);
    cell_rect(fc, W, H, rcrect);
    let ax:i64 = (h_get64(rcrect, 0) + h_get64(rcrect, 16)) / 2;
    let ay:i64 = (h_get64(rcrect, 8) + h_get64(rcrect, 24)) / 2;
    to = tr_str(tr, to, " anchor: saliency focus cell");
    to = tr_i64(tr, to, fc);
    to = tr_str(tr, to, " center=(");
    to = tr_i64(tr, to, ax);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, ay);
    to = tr_str(tr, to, ")");
    to = tr_nl(tr, to);
    let dx0:i64 = h_get64(segD, 8);
    let dy0:i64 = h_get64(segD, 16);
    let dx1:i64 = h_get64(segD, 24);
    let dy1:i64 = h_get64(segD, 32);
    let dw:i64 = dx1 - dx0 + 1;
    let dh:i64 = dy1 - dy0 + 1;
    let scale:i64 = slw * 256 / dw;
    let gw:i64 = slw;
    let gh:i64 = dh * scale / 256;
    to = tr_str(tr, to, " geometry: donor bbox=(");
    to = tr_i64(tr, to, dx0);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, dy0);
    to = tr_str(tr, to, ")-(");
    to = tr_i64(tr, to, dx1);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, dy1);
    to = tr_str(tr, to, ") slot=(");
    to = tr_i64(tr, to, slx0);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, sly0);
    to = tr_str(tr, to, ")-(");
    to = tr_i64(tr, to, slx1);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, sly1);
    to = tr_str(tr, to, ") scale=x");
    to = tr_fp2(tr, to, scale * 100 / 256);
    to = tr_str(tr, to, " (width-matched, proportions preserved) graft=");
    to = tr_i64(tr, to, gw);
    to = tr_str(tr, to, "x");
    to = tr_i64(tr, to, gh);
    to = tr_nl(tr, to);
    let pxD12:[]u8 = nio_alloc(230400);
    if (recall_frame(std_, 12, pxD12) != 0) { return -660; }
    let dmean:[]u8 = nio_alloc(24);
    let rmean:[]u8 = nio_alloc(24);
    if (adapt_means_masked(pxD12, subjD, W, H, dmean) != 0) { return -661; }
    if (adapt_means_rect(pxR12, slx0, sly0, slx1, sly1, W, rmean) != 0) { return -662; }
    let gains:[]u8 = nio_alloc(24);
    let gc:i64 = 0;
    let clamped:i64 = 0;
    while (gc < 3) {
        let dm:i64 = h_get64(dmean, gc * 8);
        let rm:i64 = h_get64(rmean, gc * 8);
        let g:i64 = 1024;
        if (dm > 0) { g = rm * 1024 / dm; }
        if (g < 512) { g = 512; clamped = 1; }
        if (g > 3072) { g = 3072; clamped = 1; }
        h_put64(gains, gc * 8, g);
        gc = gc + 1;
    }
    let histE2:[]u8 = nio_alloc(8192);
    seg_histE(ER, N, histE2);
    let emed:i64 = seg_pct_bin(histE2, 1024, N, 50) * 4;
    nio_free(histE2);
    let bgst:[]u8 = nio_alloc(32);
    adapt_bg_stats(pxR12, ER, emed, W, H, bgst);
    let bgtop:i64 = h_get64(bgst, 0);
    let bgbot:i64 = h_get64(bgst, 8);
    let bgall:i64 = h_get64(bgst, 16);
    let bgq25:i64 = h_get64(bgst, 24);
    let ratio:i64 = 256;
    if (bgbot > 0) { ratio = bgtop * 256 / bgbot; }
    let contrast:i64 = 0;
    if (bgall > 0) { contrast = (bgall - bgq25) * 100 / bgall; }
    let shstrength:i64 = contrast * 256 / 100 / 3;
    if (shstrength > 64) { shstrength = 64; }
    if (shstrength < 0) { shstrength = 0; }
    to = tr_str(tr, to, "--- ADAPT ---\n");
    to = tr_str(tr, to, " gain: donor_mean=(");
    to = tr_i64(tr, to, h_get64(dmean, 0));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(dmean, 8));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(dmean, 16));
    to = tr_str(tr, to, ") recip_mean=(");
    to = tr_i64(tr, to, h_get64(rmean, 0));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(rmean, 8));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(rmean, 16));
    to = tr_str(tr, to, ") gains_x1024=(");
    to = tr_i64(tr, to, h_get64(gains, 0));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(gains, 8));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(gains, 16));
    to = tr_str(tr, to, ") clamped=");
    to = tr_i64(tr, to, clamped);
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " gradient: bg_top=");
    to = tr_i64(tr, to, bgtop);
    to = tr_str(tr, to, " bg_bot=");
    to = tr_i64(tr, to, bgbot);
    to = tr_str(tr, to, " ratio_x256=");
    to = tr_i64(tr, to, ratio);
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " shadow: bg_q25=");
    to = tr_i64(tr, to, bgq25);
    to = tr_str(tr, to, " contrast%=");
    to = tr_i64(tr, to, contrast);
    to = tr_str(tr, to, " strength_x256=");
    to = tr_i64(tr, to, shstrength);
    to = tr_nl(tr, to);
    let graft:[]u8 = nio_alloc((gw * gh * 3) as i32);
    let alpha:[]u8 = nio_alloc((gw * gh) as i32);
    graft_build_rgb(pxD12, W, dx0, dy0, dw, dh, graft, gw, gh);
    graft_build_alpha(subjD, W, dx0, dy0, dw, dh, alpha, gw, gh);
    let refpx:i64 = ax - gw / 2;
    let refpy:i64 = ay - gh / 2;
    let seam_before:i64 = band_diff(graft, alpha, gw, gh, pxR12, W, refpx, refpy);
    graft_gain_grad(graft, gw, gh, gains, ratio);
    let etr:[]u8 = nio_alloc(32);
    if (graft_edge_transfer(graft, alpha, gw, gh, pxR12, W, refpx, refpy, etr) != 0) { return -670; }
    let seam_after:i64 = band_diff(graft, alpha, gw, gh, pxR12, W, refpx, refpy);
    to = tr_str(tr, to, " edge_transfer: shift=(");
    to = tr_i64(tr, to, h_get64(etr, 0));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(etr, 8));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(etr, 16));
    to = tr_str(tr, to, ") feather=17x17 box (8px ramp)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " seam: raw=");
    to = tr_i64(tr, to, seam_before);
    to = tr_str(tr, to, " after_gain+edge=");
    to = tr_i64(tr, to, seam_after);
    to = tr_str(tr, to, " (mean |graft-recipient| in blend band, gray levels)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "--- TRACK (donor track = part-selection evidence; the graft replaces the recipient's head, so it rides the recipient head's motion) ---\n");
    let tdx0:i64 = dx0 - 40;
    let tdy0:i64 = dy0 - 40;
    let tdx1:i64 = dx1 + 40;
    let tdy1:i64 = dy1 + 40;
    if (tdx0 < 0) { tdx0 = 0; }
    if (tdy0 < 0) { tdy0 = 0; }
    if (tdx1 >= W) { tdx1 = W - 1; }
    if (tdy1 >= H) { tdy1 = H - 1; }
    let trk:[]u8 = nio_alloc(24 * 16);
    if (seg_track(std_, h_get64(segD, 64), tdx0, tdy0, tdx1, tdy1, W, H, nf, trk) != 0) { return -680; }
    let drf:[]u8 = nio_alloc(16);
    seg_drift_range(trk, nf, 12, drf);
    to = tr_str(tr, to, " donor thr=");
    to = tr_i64(tr, to, h_get64(segD, 64));
    to = tr_str(tr, to, " (invented in DECIDE from the donor part's own gray distribution)");
    to = tr_str(tr, to, " ref_centroid=(");
    to = tr_i64(tr, to, h_get64(trk, 12 * 16));
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, h_get64(trk, 12 * 16 + 8));
    to = tr_str(tr, to, ") drift_x=");
    to = tr_i64(tr, to, h_get64(drf, 0));
    to = tr_str(tr, to, " drift_y=");
    to = tr_i64(tr, to, h_get64(drf, 8));
    to = tr_nl(tr, to);
    let trkR:[]u8 = nio_alloc(24 * 16);
    if (seg_track(str_, 0 - 200, slx0, sly0, slx1, sly1, W, H, nf, trkR) != 0) { return -681; }
    let drfR:[]u8 = nio_alloc(16);
    seg_drift_range(trkR, nf, 12, drfR);
    to = tr_str(tr, to, " recipient face drift_x=");
    to = tr_i64(tr, to, h_get64(drfR, 0));
    to = tr_str(tr, to, " drift_y=");
    to = tr_i64(tr, to, h_get64(drfR, 8));
    to = tr_str(tr, to, " (the graft follows this motion: it IS the recipient's head now)");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "--- SYNTHESIZE (24 frames) ---\n");
    let fr2:[]u8 = nio_alloc(230400);
    let nm:[]u8 = nio_alloc(16);
    let f:i64 = 0;
    while (f < nf) {
        if (recall_frame(str_, f, fr2) != 0) { return -690 - f; }
        let ocx:i64 = h_get64(trkR, f * 16);
        let ocy:i64 = h_get64(trkR, f * 16 + 8);
        let rX:i64 = h_get64(trkR, 12 * 16);
        let rY:i64 = h_get64(trkR, 12 * 16 + 8);
        let ppx:i64 = refpx;
        let ppy:i64 = refpy;
        if (ocx >= 0) {
            ppx = refpx + (ocx - rX);
            ppy = refpy + (ocy - rY);
        }
        graft_paste(fr2, graft, alpha, gw, gh, ppx, ppy, W, H);
        graft_shadow(fr2, ppx, ppy, gw, gh, shstrength, W, H);
        let nl:i64 = mk_frame_name(nm, f);
        if (write_ppm(oroot, nm[0..nl], fr2, W, H) != 0) { return -700 - f; }
        let fh:i64 = fnv(fr2, 0, N * 3);
        if (f == 0 || f == 12 || f == 23) {
            to = tr_str(tr, to, " f=");
            to = tr_i64(tr, to, f);
            to = tr_str(tr, to, " paste=(");
            to = tr_i64(tr, to, ppx);
            to = tr_str(tr, to, ",");
            to = tr_i64(tr, to, ppy);
            to = tr_str(tr, to, ") H_F=");
            to = tr_hex(tr, to, fh);
            to = tr_nl(tr, to);
        }
        f = f + 1;
    }
    to = tr_str(tr, to, "--- SELF_CHECK ---\n");
    to = tr_str(tr, to, " unhandled: pose (no pose normalization in the plan language)\n");
    to = tr_str(tr, to, " unhandled: per-frame donor appearance (graft uses the f12 donor pose for all 24 frames)\n");
    to = tr_str(tr, to, " unhandled: recipient ears outside graft (bunny ears remain; the graft covers the face)\n");
    to = tr_str(tr, to, " note: the invented segmentation is only as good as my judgment properties;\n");
    to = tr_str(tr, to, "       P/B/H/F are my own proxies for 'a part', not a guarantee of anatomy.\n");
    to = tr_str(tr, to, " RESULT: FUSION_COMPLETE seam_raw=");
    to = tr_i64(tr, to, seam_before);
    to = tr_str(tr, to, " seam_adapted=");
    to = tr_i64(tr, to, seam_after);
    to = tr_nl(tr, to);
    let tnm:[]u8 = nio_alloc(32);
    let tl:i64 = mk_trace_name(tnm, "fuse_nb");
    let trc:i64 = write_buf(oroot, tnm[0..tl], tr, to);
    nio_close(oroot);
    nio_free(E0);
    nio_free(E1);
    nio_free(grayA);
    nio_free(grayB);
    nio_free(F1A);
    nio_free(F1B);
    nio_free(F3A);
    nio_free(F3B);
    nio_free(frec);
    nio_free(hist);
    nio_free(mm);
    nio_free(mod);
    nio_free(mtab);
    nio_free(fr);
    nio_free(fb);
    nio_free(gray);
    nio_free(labA);
    nio_free(labB);
    nio_free(labC);
    nio_free(tex12);
    nio_free(labbuf);
    nio_free(mask);
    nio_free(subj0);
    nio_free(subj1);
    nio_free(seg0);
    nio_free(seg1);
    nio_free(ord);
    nio_free(toc);
    nio_free(pxR12);
    nio_free(gR12);
    nio_free(texR);
    nio_free(perc);
    nio_free(rcrect);
    nio_free(pxD12);
    nio_free(dmean);
    nio_free(rmean);
    nio_free(gains);
    nio_free(bgst);
    nio_free(graft);
    nio_free(alpha);
    nio_free(etr);
    nio_free(trk);
    nio_free(drf);
    nio_free(trkR);
    nio_free(drfR);
    nio_free(fr2);
    nio_free(nm);
    nio_free(tnm);
    nio_free(tr);
    nio_free(lab0);
    nio_free(lab1);
    nio_free(ibuf);
    nio_free(words);
    nio_free(subj);
    nio_free(vn);
    nio_free(st0);
    nio_free(st1);
    if (trc != 0) { return -799; }
    return 0;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (_zag_strcmp(a1, "selftest") == 1) { return selftest(); }
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    let a5:[]u8 = _zag_arg(5);
    if (_zag_strcmp(a1, "ingest") == 1) {
        let rc:i64 = do_ingest(a2, a3, a4);
        _zag_print("ingest_rc=");
        _zag_println(_zag_i64_to_str(rc));
        if (rc == 0) { return 0; }
        return 1;
    }
    if (_zag_strcmp(a1, "recall") == 1) {
        let rc:i64 = do_recall(a2, a3);
        _zag_print("recall_rc=");
        _zag_println(_zag_i64_to_str(rc));
        if (rc == 0) { return 0; }
        return 1;
    }
    if (_zag_strcmp(a1, "stillingest") == 1) {
        let rc:i64 = do_stillingest(a2, a3, a4);
        _zag_print("stillingest_rc=");
        _zag_println(_zag_i64_to_str(rc));
        if (rc == 0) { return 0; }
        return 1;
    }
    if (_zag_strcmp(a1, "stillrecall") == 1) {
        let rc:i64 = do_stillrecall(a2, a3);
        _zag_print("stillrecall_rc=");
        if (rc == 0) { return 0; }
        return 1;
    }
    if (_zag_strcmp(a1, "compose") == 1) {
        let rc:i64 = do_compose(a2, a3, a4, a5);
        _zag_print("compose_rc=");
        _zag_println(_zag_i64_to_str(rc));
        if (rc == 0) { return 0; }
        return 1;
    }
    if (_zag_strcmp(a1, "render") == 1) {
        let rc:i64 = do_render(a2, a3, parse_i64(a4), a5);
        _zag_print("render_rc=");
        _zag_println(_zag_i64_to_str(rc));
        if (rc == 0) { return 0; }
        return 1;
    }
    if (_zag_strcmp(a1, "fuse") == 1) {
        let rc:i64 = do_fuse_nb(a2, a3, a4, a5);
        _zag_print("fuse_rc=");
        _zag_println(_zag_i64_to_str(rc));
        if (rc == 0) { return 0; }
        return 1;
    }
    _zag_println("usage: composer selftest | ingest|recall|stillingest|stillrecall|compose|render|fuse ...");
    return 99;
}

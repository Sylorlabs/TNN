// rt_r4.zag — R4: overwrite-reset.
// Overwrite a strong memory to a WEAK strength. The meter must see through the
// reset: high-water + revision lineage survive, so the new price is p_no+1
// (the overwrite itself adds a revision, removing the -1), never lower.
// 5 hw x 3 ow_str x 3 sunk x 2 fought = 90, + 15 (ow_str=hw) = 105 sequences.
@import("rt_common.zag")

fn main()void {
    let fails:i32=0;
    let total:i32=0;
    let holes:i32=0;
    let hi:i32=0;
    while(hi<=4){
        let hw:i32=100;
        if(hi==1){hw=90;}
        if(hi==2){hw=80;}
        if(hi==3){hw=50;}
        if(hi==4){hw=20;}
        let oi:i32=0;
        while(oi<=3){
            // ow_str always <= hw so the overwrite cannot raise high-water
            let ow_str:i32=5;
            if(oi==1){ow_str=10;}
            if(oi==2){ow_str=hw/2;}
            if(oi==3){ow_str=hw;} // pure revision, same strength
            let si:i32=0;
            while(si<=2){
                let sunk:i32=0;
                if(si==1){sunk=2;}
                if(si==2){sunk=4;}
                let fi:i32=0;
                while(fi<=1){
                    let skip:i32=0;
                    if(oi==3 && fi==1){skip=1;} // keep the ow_str=hw block small
                    if(skip==0){
                        total=total+1;
                        let fought:i32=fi;
                        let p_no:i32=rt_predict(hw,sunk,fought,0);
                        // exact prediction must go through the clamp, not p_no+1
                        // (p_no can sit on the clamp floor)
                        let p_with_exp:i32=rt_predict(hw,sunk,fought,1);
                        let s:StStore=rt_new();
                        let epb:i64=400000+(total as i64)*1000;
                        // slot_n: no overwrite (reference)
                        let slotn:i32=-1;let pn:i32=-1;
                        let bfn:i32=rt_build(&s,hw,sunk,fought,0,hw,1,epb,&slotn,&pn,&epb);
                        // slot_w: with overwrite to ow_str
                        let slotw:i32=-1;let pw:i32=-1;
                        let bfw:i32=rt_build(&s,hw,sunk,fought,1,ow_str,1,epb,&slotw,&pw,&epb);
                        if(bfn!=0 || bfw!=0 || pn!=p_no){
                            _zag_print("RT_R4_SETUP_FAIL hw=");rt_pi(hw as i64);
                            _zag_print(" pn=");rt_pi(pn as i64);
                            _zag_print(" exp=");rt_pi(p_no as i64);
                            _zag_print("\n");
                            fails=fails+1;
                        } else {
                            // security oracle: overwrite must not lower the price
                            if(pw<pn){
                                _zag_print("RT_R4_HOLE hw=");rt_pi(hw as i64);
                                _zag_print(" ow_str=");rt_pi(ow_str as i64);
                                _zag_print(" sunk=");rt_pi(sunk as i64);
                                _zag_print(" fought=");rt_pi(fought as i64);
                                _zag_print(" p_no=");rt_pi(pn as i64);
                                _zag_print(" p_with=");rt_pi(pw as i64);
                                _zag_print("\n");
                                holes=holes+1;
                                fails=fails+1;
                            } else {
                                if(pw!=p_with_exp){
                                    _zag_print("RT_R4_PREDICT_MISMATCH p_with=");rt_pi(pw as i64);
                                    _zag_print(" exp=");rt_pi(p_with_exp as i64);
                                    _zag_print("\n");
                                    fails=fails+1;
                                }
                            }
                            // r1 must still read the ORIGINAL high-water band (21/22/23)
                            let r1:i32=rt_r1_of(&s,slotw);
                            let exp_r1:i32=23;
                            if(hw>=76){exp_r1=21;}
                            else {if(hw>=26){exp_r1=22;}}
                            if(r1!=exp_r1){
                                _zag_print("RT_R4_R1_MISMATCH r1=");rt_pi(r1 as i64);
                                _zag_print("\n");
                                fails=fails+1;
                            }
                            // post-overwrite destruction at the new price must work
                            let cf:i32=rt_cite_n(&s,slotw,pw,epb,&epb);
                            let rcd:i32=rt_destroy(&s,slotw,0);
                            if(cf!=0 || rcd!=ST_OK){
                                _zag_print("RT_R4_DESTROY_FAIL rcd=");rt_pi(rcd as i64);
                                _zag_print("\n");
                                fails=fails+1;
                            }
                        }
                        if(st_replay_check(&s)!=ST_OK){
                            _zag_print("RT_R4_REPLAY_FAIL\n");
                            fails=fails+1;
                        }
                    }
                    fi=fi+1;
                }
                si=si+1;
            }
            oi=oi+1;
        }
        hi=hi+1;
    }
    _zag_print("RT_R4 total=");rt_pi(total as i64);
    _zag_print(" fails=");rt_pi(fails as i64);
    _zag_print(" holes=");rt_pi(holes as i64);
    _zag_print("\n");
}

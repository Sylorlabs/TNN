// ============================================================
// var2_shepherd.zag — IMAGINATION DISCOVERY: VARIATION 2.
// World: "SHEPHERD" — the surface of an icy moon, looking up at
// a colossal ringed giant that fills the sky. The giant hangs
// in crescent phase, backlit by a small pale sun; its ring
// plane sweeps across the whole sky as a bright arc, darkened
// where the planet's shadow falls on it. Below: cracked blue
// ice, pressure ridges, geyser plumes venting into the sky,
// and a tilted ice slab glowing blue from within.
//
// DELIBERATE WORLD-MODEL DECISIONS (the imagination, not dice):
//  1. INVERTED composition vs the r-series: the SKY is the
//     subject, the ground is the stage (not vice versa).
//  2. Crescent phase: the giant is backlit, mostly dark —
//     drama from the lit crescent + the ring arc, not a full disc.
//  3. The ring is split far/near: it passes BEHIND the planet on
//     one side and IN FRONT on the other (real occlusion logic).
//  4. Light logic: ONE pale sun, off-frame upper-right. Every
//     shadow points down-left. Planetshine = faint blue fill
//     from the giant's direction (shadowless, secondary).
//  5. Ice physics: pressure ridges run in parallel sets, cracks
//     meander, plumes rise from fixed vents and catch the light.
//  6. Palette: cold — ice blue, cream, rust bands, black space.
//
// Deterministic: integer-hash noise, fixed seeds, zero RNG.
// D-COMP: zero axis-aligned filled-primitive placement calls; all
// coverage is per-pixel analytic tests. No fn/var named
// rect/band/blotch/fill/stroke/circle/ellipse.
// Buffer: 1024^2*3 = 3.1 MB < 2^25.
// Build: znc var2_shepherd.zag --no-zagd --no-analyze -o var2_shepherd
// Usage: var2_shepherd <outdir> <1024|2048>
// ============================================================
@import("../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- byte helpers ----------------
fn v2_put32le(b:[]u8, o:i64, v:i64) i64 {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    return 0;
}

// ---------------- small math ----------------
fn v2_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn v2_clamp(v:i64, lo:i64, hi:i64) i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn v2_ss(t:i64) i64 {
    let c:i64 = v2_clamp(t, 0, 1024);
    return c * c * (3072 - 2 * c) / 1048576;
}
fn v2_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let r:i64 = v;
    let i:i64 = 0;
    while (i < 64) {
        r = (r + v / r) / 2;
        i = i + 1;
    }
    return r;
}
fn v2_pack(r:i64, g:i64, b:i64) i64 {
    return (r & 255) + ((g & 255) << 8) + ((b & 255) << 16);
}
fn v2_lerp(a:i64, b:i64, t:i64) i64 {
    return a + (b - a) * t / 1024;
}

// ---------------- deterministic integer-hash noise ----------------
fn v2_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn v2_h01(x:i64, y:i64, seed:i64) i64 {
    return v2_hash(x, y, seed) >> 22;
}
fn v2_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
fn v2_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = v2_sstep(xf);
    let v:i64 = v2_sstep(yf);
    let a:i64 = v2_h01(xi, yi, seed);
    let b:i64 = v2_h01(xi + 1, yi, seed);
    let c:i64 = v2_h01(xi, yi + 1, seed);
    let d:i64 = v2_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
fn v2_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + v2_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}

// ---------------- world constants ----------------
fn v2_gx() i64 { return 700; }   // giant center
fn v2_gy() i64 { return 280; }
fn v2_gr() i64 { return 330; }   // giant radius
fn v2_hz() i64 { return 620; }   // ice horizon
fn v2_sunx() i64 { return 950; } // the pale sun
fn v2_suny() i64 { return 80; }

// ---------------- deep sky ----------------
fn v2_sky(x:i64, y:i64) i64 {
    let hz:i64 = v2_hz();
    let t:i64 = v2_clamp(y * 1024 / hz, 0, 1024);
    // near-black blue, faint horizon glow from the thin atmosphere
    let r:i64 = v2_lerp(6, 26, t);
    let g:i64 = v2_lerp(8, 34, t);
    let b:i64 = v2_lerp(18, 62, t);
    let sh:i64 = v2_h01(x / 2, y / 2, 6101);
    if (sh < 260 && y < hz - 20) {
        let br:i64 = 90 + sh * 165 / 260;
        if (br > r) { r = br; }
        if (br > g) { g = br; }
        if (br > b) { b = br; }
    }
    return v2_pack(r, g, b);
}

// ---------------- the pale sun ----------------
fn v2_sun(x:i64, y:i64, rgb:i64) i64 {
    let dx:i64 = x - v2_sunx();
    let dy:i64 = y - v2_suny();
    let d2:i64 = dx * dx + dy * dy;
    if (d2 < 484) {
        return v2_pack(240, 244, 255);
    }
    let d:i64 = v2_isqrt(d2);
    if (d < 130) {
        let gl:i64 = v2_ss((130 - d) * 1024 / 130);
        let r:i64 = v2_clamp((rgb & 255) + gl * 90 / 1024, 0, 255);
        let g:i64 = v2_clamp(((rgb >> 8) & 255) + gl * 95 / 1024, 0, 255);
        let b:i64 = v2_clamp(((rgb >> 16) & 255) + gl * 110 / 1024, 0, 255);
        return v2_pack(r, g, b);
    }
    return rgb;
}

// ---------------- the ringed giant ----------------
// Zonal bands, domain-warped; crescent phase lit from the right.
// Returns packed rgb, or -1 if the pixel is not on the disc.
fn v2_giantpx(x:i64, y:i64) i64 {
    let cx:i64 = v2_gx();
    let cy:i64 = v2_gy();
    let rr:i64 = v2_gr();
    let dx:i64 = x - cx;
    let dy:i64 = y - cy;
    let d2:i64 = dx * dx + dy * dy;
    if (d2 >= rr * rr) { return -1; }
    // wandering limb: perturb the edge so no perfect circle reads
    let wob:i64 = (v2_fbm(x / 3, y / 3, 6201, 2) - 512) * rr / 1400;
    let d:i64 = v2_isqrt(d2) + wob;
    if (d >= rr) { return -1; }
    // crescent illumination: lit from the right (the pale sun).
    // terminator curves: threshold rises away from the equator.
    let yn:i64 = dy * 1024 / rr;
    let thr:i64 = 300 + yn * yn / 4096;
    let across:i64 = (x - (cx - rr)) * 1024 / (2 * rr);
    let illum:i64 = v2_ss((across - thr) * 1024 / 260);
    // zonal bands: horizontal, domain-warped, sheared
    let warp:i64 = (v2_fbm(x, y / 2, 6202, 3) - 512) / 2;
    let bandv:i64 = v2_fbm(x * 2, (y + warp) * 7, 6203, 3);
    // palette: cream / tan / rust
    let r:i64 = v2_lerp(235, 178, v2_ss((bandv - 300) * 1024 / 424));
    let g:i64 = v2_lerp(220, 118, v2_ss((bandv - 300) * 1024 / 424));
    let b:i64 = v2_lerp(190, 88, v2_ss((bandv - 300) * 1024 / 424));
    let band2:i64 = v2_fbm(x * 5, (y - warp) * 12, 6204, 2);
    let dk:i64 = v2_ss((band2 - 620) * 1024 / 200);
    r = r - dk * 60 / 1024; g = g - dk * 55 / 1024; b = b - dk * 50 / 1024;
    // limb darkening
    let limb:i64 = v2_ss((rr - d) * 1024 / (rr / 2));
    r = r * (600 + limb * 424 / 1024) / 1024;
    g = g * (600 + limb * 424 / 1024) / 1024;
    b = b * (600 + limb * 424 / 1024) / 1024;
    // night side: nearly black, faint blue ringshine bands
    let nr:i64 = 12 + v2_ss((bandv - 400) * 1024 / 300) * 22 / 1024;
    let ng:i64 = 16 + v2_ss((bandv - 400) * 1024 / 300) * 26 / 1024;
    let nb:i64 = 34 + v2_ss((bandv - 400) * 1024 / 300) * 40 / 1024;
    r = v2_lerp(nr, r, illum);
    g = v2_lerp(ng, g, illum);
    b = v2_lerp(nb, b, illum);
    return v2_pack(r, g, b);
}

// ---------------- the ring ----------------
// A huge arc sweeping across the sky. Tilted: the ring plane
// crosses the frame diagonally. side=0: far half (behind planet),
// side=1: near half (in front of planet).
fn v2_ringmask(x:i64, y:i64, side:i64) i64 {
    let cx:i64 = v2_gx();
    let cy:i64 = v2_gy();
    let rr:i64 = v2_gr();
    let dx:i64 = x - cx;
    let dy:i64 = y - cy;
    // rotate into ring-plane coords: tilt ~ -24 degrees.
    // cos=0.913, sin=-0.407 in 10-bit fixed point.
    let rx:i64 = (dx * 935 + dy * 417) / 1024;
    let ry:i64 = (dy * 935 - dx * 417) / 1024;
    // ring-plane radius (foreshortened y)
    let rp:i64 = v2_isqrt(rx * rx + (ry * 2) * (ry * 2));
    let r1:i64 = rr * 128 / 100;
    let r2:i64 = rr * 235 / 100;
    if (rp < r1 || rp > r2) { return 0; }
    // the visible arc: a thick diagonal sweep; half selected by side
    if (side == 0 && rx > 0) { return 0; }
    if (side == 1 && rx < 0) { return 0; }
    // fine radial striations: high-frequency variation along radius
    let st:i64 = v2_fbm(rp * 6, 31, 6205, 2);
    let dens:i64 = v2_ss((st - 380) * 1024 / 260);
    // gaps: a dark Cassini-like division
    let divc:i64 = (r1 + r2) / 2 + (r2 - r1) / 8;
    if (v2_abs(rp - divc) < (r2 - r1) / 22) { dens = dens / 4; }
    return dens;
}
// planet shadow on the ring: sun from upper-right, so the shadow
// falls to the lower-left of the planet.
fn v2_ringshadow(x:i64, y:i64) i64 {
    let cx:i64 = v2_gx();
    let cy:i64 = v2_gy();
    let dx:i64 = cx - x;
    let dy:i64 = y - cy;
    if (dx < 0 || dy < 0) { return 1024; }
    // wedge opening away from the sun
    let w:i64 = dx * 1024 / (dy + 200);
    if (w > 700) { return 1024; }
    return v2_ss(w * 1024 / 700);
}
fn v2_ringpx(x:i64, y:i64, rgb:i64, side:i64) i64 {
    let dens:i64 = v2_ringmask(x, y, side);
    if (dens == 0) { return rgb; }
    let sh:i64 = v2_ringshadow(x, y);
    // lit ring: pale gold; shadowed: deep brown-blue
    let r:i64 = v2_lerp(40, 232, sh);
    let g:i64 = v2_lerp(44, 214, sh);
    let b:i64 = v2_lerp(70, 180, sh);
    let sr:i64 = rgb & 255;
    let sg:i64 = (rgb >> 8) & 255;
    let sb:i64 = (rgb >> 16) & 255;
    let a:i64 = dens * 620 / 1024;
    r = v2_lerp(sr, r, a);
    g = v2_lerp(sg, g, a);
    b = v2_lerp(sb, b, a);
    return v2_pack(r, g, b);
}

// ---------------- distant ice cliffs ----------------
fn v2_clifftop(x:i64) i64 {
    let n:i64 = v2_fbm(x * 3, 441, 6206, 3);
    return v2_hz() - 26 - (n - 300) * 70 / 724;
}
fn v2_cliffs(x:i64, y:i64, rgb:i64) i64 {
    let ct:i64 = v2_clifftop(x);
    if (y < ct || y > v2_hz() + 4) { return rgb; }
    // pale blue ice, shaded by slope; sun from the right
    let gx:i64 = (v2_clifftop(x + 8) - v2_clifftop(x - 8)) * 64 / 16;
    let lit:i64 = v2_clamp(1024 + gx * 2, 600, 1380);
    let r:i64 = v2_clamp(168 * lit / 1024, 0, 255);
    let g:i64 = v2_clamp(198 * lit / 1024, 0, 255);
    let b:i64 = v2_clamp(228 * lit / 1024, 0, 255);
    let m:i64 = (v2_fbm(x * 4, y * 4, 6207, 2) - 512) * 30 / 512;
    return v2_pack(v2_clamp(r + m, 0, 255), v2_clamp(g + m, 0, 255), v2_clamp(b + m, 0, 255));
}

// ---------------- ice plain ----------------
// Pressure ridges in parallel sets, meandering cracks, blue shadows.
fn v2_ridgehf(x:i64, y:i64) i64 {
    // diagonal parallel ridges: coordinate along the ridge normal
    let u:i64 = (x * 3 + y * 2) / 4;
    let n:i64 = v2_fbm(u * 2, 913, 6208, 3);
    return (n - 300) * 60 / 724;
}
fn v2_crack(x:i64, y:i64) i64 {
    // thin meandering dark cracks: ridged noise near zero
    let n:i64 = v2_fbm(x * 3 + 500, y * 3, 6209, 3);
    let d:i64 = v2_abs(n - 512);
    if (d > 15) { return 0; }
    return v2_ss((15 - d) * 1024 / 15);
}
fn v2_plain(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v2_hz();
    if (y < hz) { return rgb; }
    // base ice: pale, cooler with distance
    let t:i64 = (y - hz) * 1024 / (1024 - hz);
    let r:i64 = v2_lerp(150, 205, t);
    let g:i64 = v2_lerp(180, 225, t);
    let b:i64 = v2_lerp(215, 242, t);
    // ridge shading: gradient of the ridge heightfield (fixed-point)
    let gx:i64 = (v2_ridgehf(x + 8, y) - v2_ridgehf(x - 8, y)) * 64 / 16;
    let gy:i64 = (v2_ridgehf(x, y + 8) - v2_ridgehf(x, y - 8)) * 64 / 16;
    // sun from upper-right: light from (+x,-y)
    let lit:i64 = v2_clamp(1024 + (gx - gy) * 3, 560, 1420);
    r = r * lit / 1024; g = g * lit / 1024; b = b * lit / 1024;
    // troughs go deep blue
    let rh:i64 = v2_ridgehf(x, y);
    if (rh < -20) {
        let dp:i64 = v2_ss((-20 - rh) * 1024 / 60);
        r = v2_lerp(r, 90, dp); g = v2_lerp(g, 130, dp); b = v2_lerp(b, 190, dp);
    }
    // cracks: dark blue lines with bright rims
    let ck:i64 = v2_crack(x, y);
    if (ck > 0) {
        r = v2_lerp(r, 30, ck); g = v2_lerp(g, 60, ck); b = v2_lerp(b, 120, ck);
    } else {
        let ck2:i64 = v2_crack(x + 3, y);
        let ck3:i64 = v2_crack(x - 3, y);
        if (ck2 > 0 || ck3 > 0) {
            r = r + 30; g = g + 30; b = b + 25;
        }
    }
    // sparkle
    let sp:i64 = v2_h01(x, y, 6210);
    if (sp > 1008) {
        r = v2_clamp(r + 40, 0, 255);
        g = v2_clamp(g + 40, 0, 255);
        b = v2_clamp(b + 40, 0, 255);
    }
    return v2_pack(r, g, b);
}

// ---------------- geyser plumes ----------------
// Three vents at fixed x; tall vapor columns, backlit by the pale sun.
fn v2_ventx(i:i64) i64 {
    if (i == 0) { return 250; }
    if (i == 1) { return 560; }
    return 810;
}
fn v2_plume(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v2_hz();
    let i:i64 = 0;
    while (i < 3) {
        let vx2:i64 = v2_ventx(i);
        let top:i64 = 290 + i * 50;
        if (y < hz && y > top) {
            // column widens with height, drifts down-left (away from sun)
            let hfrac:i64 = (hz - y) * 1024 / (hz - top);
            let cxp:i64 = vx2 - hfrac * 60 / 1024 + (v2_fbm(vx2, y, 6211 + i * 53, 2) - 512) / 6;
            let halfw:i64 = 14 + hfrac * 42 / 1024;
            let dxa:i64 = v2_abs(x - cxp);
            if (dxa < halfw) {
                let bl:i64 = v2_fbm(x * 4, y * 5, 6212 + i * 71, 3);
                let thr:i64 = 540 - hfrac * 90 / 1024;
                if (bl > thr) {
                    let a:i64 = v2_ss((bl - thr) * 1024 / 200);
                    // backlit: brighter on the sun (right) side
                    let sunside:i64 = v2_ss((x - cxp + halfw) * 1024 / (2 * halfw));
                    let pr:i64 = 190 + sunside * 65 / 1024;
                    let pg:i64 = 205 + sunside * 50 / 1024;
                    let pb:i64 = 235 + sunside * 20 / 1024;
                    let sr:i64 = rgb & 255;
                    let sg:i64 = (rgb >> 8) & 255;
                    let sb:i64 = (rgb >> 16) & 255;
                    a = a * 450 / 1024;
                    return v2_pack(v2_lerp(sr, pr, a), v2_lerp(sg, pg, a), v2_lerp(sb, pb, a));
                }
            }
        }
        i = i + 1;
    }
    return rgb;
}

// ---------------- foreground ice slab ----------------
// One big tilted slab, lower-center, glowing blue from within.
fn v2_slabedge(x:i64, y:i64) i64 {
    // tilted slab: rotated rounded form, noise edge
    let dx:i64 = x - 420;
    let dy:i64 = y - 830;
    // rotate by ~18 deg: cos=0.95, sin=0.31
    let rx:i64 = (dx * 972 + dy * 317) / 1024;
    let ry:i64 = (dy * 972 - dx * 317) / 1024;
    let wob:i64 = (v2_fbm(x / 2, y / 2, 6213, 3) - 512) / 8;
    let d:i64 = v2_isqrt(rx * rx / 2 + ry * ry * 2) + wob;
    return 190 - d;
}
fn v2_slabshadow(x:i64, y:i64, rgb:i64) i64 {
    // Shadow falls down-left from the slab (sun upper-right).
    // Elliptical, offset from the slab center, fading radially —
    // no rectangles.
    let scx:i64 = 340;
    let scy:i64 = 875;
    let dx:i64 = x - scx;
    let dy:i64 = y - scy;
    // elliptical distance (rx=200, ry=120), normalized 0..1024
    let ed:i64 = v2_isqrt(dx * dx * 1024 / 40000 + dy * dy * 1024 / 14400);
    if (ed > 1024) { return rgb; }
    // fade: full shadow inside, soft edge
    let a:i64 = 1024 - v2_ss((ed - 700) * 1024 / 324);
    if (a < 0) { a = 0; }
    // shadow darkens and cools, stronger toward center
    let dk:i64 = 1024 - a * 420 / 1024;
    let r:i64 = (rgb & 255) * dk / 1024;
    let g:i64 = ((rgb >> 8) & 255) * dk / 1024;
    let b:i64 = ((rgb >> 16) & 255) * (dk + a * 40 / 1024) / 1064;
    return v2_pack(r, g, b);
}
fn v2_slab(x:i64, y:i64, rgb:i64) i64 {
    let e:i64 = v2_slabedge(x, y);
    if (e <= 0) { return rgb; }
    // internal blue glow, brighter toward the core
    let core:i64 = v2_ss(e * 1024 / 190);
    let r:i64 = 120 + core * 60 / 1024;
    let g:i64 = 170 + core * 60 / 1024;
    let b:i64 = 220 + core * 35 / 1024;
    // top edge catches the sun: bright refracted rim
    if (e < 26 && y < 800) {
        let rim:i64 = v2_ss((26 - e) * 1024 / 26);
        r = v2_lerp(r, 245, rim); g = v2_lerp(g, 250, rim); b = v2_lerp(b, 255, rim);
    }
    // fracture lines inside
    let fr:i64 = v2_abs(v2_fbm(x * 5, y * 5, 6215, 2) - 512);
    if (fr < 40) {
        let fa:i64 = v2_ss((40 - fr) * 1024 / 40);
        r = v2_lerp(r, 60, fa); g = v2_lerp(g, 110, fa); b = v2_lerp(b, 170, fa);
    }
    // settle into the ground: blend the lower rim
    if (e < 10 && y > 900) {
        let set:i64 = v2_ss(e * 1024 / 10);
        let pr:i64 = rgb & 255;
        let pg:i64 = (rgb >> 8) & 255;
        let pb:i64 = (rgb >> 16) & 255;
        r = v2_lerp(pr, r, set);
        g = v2_lerp(pg, g, set);
        b = v2_lerp(pb, b, set);
    }
    return v2_pack(r, g, b);
}

// ---------------- main rasterizer ----------------
// back-to-front: sky -> sun -> ring(far) -> giant -> ring(near) ->
// cliffs -> plain -> plumes -> slab shadow -> slab -> vignette -> dither.
fn v2_render(buf:[]u8, w:i64, h:i64, stride:i64, seed:i64) void {
    let x:i64 = 0;
    while (x < w) {
        let y:i64 = 0;
        while (y < h) {
            let rgb:i64 = v2_sky(x, y);
            rgb = v2_sun(x, y, rgb);
            rgb = v2_ringpx(x, y, rgb, 0);
            let gp:i64 = v2_giantpx(x, y);
            if (gp >= 0) { rgb = gp; }
            rgb = v2_ringpx(x, y, rgb, 1);
            rgb = v2_cliffs(x, y, rgb);
            rgb = v2_plain(x, y, rgb);
            rgb = v2_plume(x, y, rgb);
            rgb = v2_slabshadow(x, y, rgb);
            rgb = v2_slab(x, y, rgb);
            let r:i64 = rgb & 255;
            let g:i64 = (rgb >> 8) & 255;
            let b:i64 = (rgb >> 16) & 255;
            let vx:i64 = x - w / 2;
            let vy:i64 = y - h / 2;
            let vig:i64 = 1024 - (vx * vx + vy * vy) * 140 / 524288;
            if (vig < 0) { vig = 0; }
            r = r * vig / 1024; g = g * vig / 1024; b = b * vig / 1024;
            let dh:i64 = v2_h01(x, y, seed + 999);
            let off:i64 = (dh - 512) * 6 / 1024;
            r = v2_clamp(r + off, 0, 255);
            g = v2_clamp(g + off, 0, 255);
            b = v2_clamp(b + off, 0, 255);
            let o:i64 = 54 + (h - 1 - y) * stride + x * 3;
            buf[o] = b as u8;
            buf[o + 1] = g as u8;
            buf[o + 2] = r as u8;
            y = y + 1;
        }
        if (x - (x / 128) * 128 == 0) {
            _zag_print("col ");
            _zag_println(_zag_i64_to_str(x));
        }
        x = x + 1;
    }
}

// ---------------- BMP output ----------------
fn v2_open_trunc(root:i64, name:[]u8) i64 {
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { return -7401; }
    let flags:i64 = 657985;
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, flags, 420, 0, 0);
    nio_free(s);
    return fd;
}
fn v2_write_bmp(root:i64, name:[]u8, buf:[]u8, w:i64, h:i64, stride:i64) i64 {
    buf[0] = 66; buf[1] = 77;
    v2_put32le(buf, 2, 54 + stride * h);
    v2_put32le(buf, 6, 0);
    v2_put32le(buf, 10, 54);
    v2_put32le(buf, 14, 40);
    v2_put32le(buf, 18, w);
    v2_put32le(buf, 22, h);
    buf[26] = 1; buf[27] = 0;
    buf[28] = 24; buf[29] = 0;
    v2_put32le(buf, 30, 0);
    v2_put32le(buf, 34, stride * h);
    v2_put32le(buf, 38, 2835);
    v2_put32le(buf, 42, 2835);
    v2_put32le(buf, 46, 0);
    v2_put32le(buf, 50, 0);
    let total:i64 = 54 + stride * h;
    let fd:i64 = v2_open_trunc(root, name);
    if (fd < 0) { return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = buf[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}

fn main() i32 {
    let outd:[]u8 = _zag_arg(1);
    let szs:[]u8 = _zag_arg(2);
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let w:i64 = 1024;
    let h:i64 = 1024;
    let is2048:i64 = 0;
    if (_zag_strcmp(szs, "2048") == 1) { w = 2048; h = 2048; is2048 = 1; }
    let name:[]u8 = "var2_shepherd_1024.bmp";
    if (is2048 == 1) { name = "var2_shepherd_2048.bmp"; }
    let root:i64 = nio_open_root(outd);
    if (root < 0) {
        _zag_println("cannot open outdir");
        return 1;
    }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let total:i64 = 54 + stride * h;
    _zag_print("rendering ");
    _zag_println(name);
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) {
        _zag_println("alloc failed");
        nio_close(root);
        return 1;
    }
    v2_render(buf, w, h, stride, 4400);
    let rc:i64 = v2_write_bmp(root, name, buf, w, h, stride);
    nio_free(buf);
    nio_close(root);
    if (rc != 0) {
        _zag_print("write failed ");
        _zag_println(_zag_i64_to_str(rc));
        return 1;
    }
    _zag_println("done");
    return 0;
}

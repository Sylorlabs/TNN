// ============================================================
// A-ALPHA shared physics utilities (position (a) control fork)
// Fresh code. Contains NO synthesis primitives: no oscillators,
// no 2-pole resonators, no filtered-noise beds, no chirps, no
// booms, no ADSR. Only: deterministic hashing, byte IO, a sine
// lookup table (used solely for physical vortex-shedding tones
// and raised-cosine gesture shapes), Newton sqrt, and the WAV
// writer. Physical models (vocal folds, waveguide tubes,
// mass-spring surfaces, stick-slip) live in the piece files,
// generated by physgen.py, with f64 state in locals.
// Zero randomness anywhere: all variation from h01(seed, n).
// ============================================================

const SR:i64 = 44100;
const DT:f64 = 0.00002267573696145125; // 1/44100
const RHO_AIR:f64 = 1.14;    // kg/m^3
const C_AIR:f64 = 353.0;     // m/s

// ---------- deterministic hash (fmix32 finalizer, own version) ----------
fn h32(s:i64, st:i64)i64{
    let z:i64 = (s*2654435761 + st*40503 + 17) & 4294967295;
    z = (z ^ (z >> 16)) & 4294967295;
    z = (z * 2246822519) & 4294967295;
    z = (z ^ (z >> 13)) & 4294967295;
    z = (z * 3266489917) & 4294967295;
    z = (z ^ (z >> 16)) & 4294967295;
    return z;
}
fn h01(seed:i64, k:i64)f64{
    return (h32(seed, k) as f64) / 4294967296.0;
}

// exp(x) via Taylor. Deterministic. (x<=0 typical for decays.)
fn fexp(x:f64)f64{
    if(x >= 0.0){
        let s:f64 = 1.0; let t:f64 = 1.0;
        let n:i64=1;
        while(n < 12){ t = t * x / ((n) as f64); s = s + t; n=n+1; }
        return s;
    }
    let y:f64 = 0.0 - x;
    let s:f64 = 1.0; let t:f64 = 1.0;
    let n:i64=1;
    while(n < 16){ t = t * y / ((n) as f64); s = s + t; n=n+1; }
    if(s == 0.0){ return 0.0; }
    return 1.0 / s;
}

// ---------- byte helpers ----------
fn put32(b:[]u8, i:i64, v:i64)void{
    b[i] = (v & 255) as u8;
    b[i+1] = ((v >> 8) & 255) as u8;
    b[i+2] = ((v >> 16) & 255) as u8;
    b[i+3] = ((v >> 24) & 255) as u8;
}
fn get32s(b:[]u8, i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64) << 8) | ((b[i+2] as i64) << 16) | (((b[i+3] as i64) << 56) >> 32);
}
fn put16(b:[]u8, i:i64, v:i64)void{
    b[i] = (v & 255) as u8;
    b[i+1] = ((v >> 8) & 255) as u8;
}
fn put64(b:[]u8, i:i64, v:i64)void{
    b[i] = (v & 255) as u8;
    b[i+1] = ((v >> 8) & 255) as u8;
    b[i+2] = ((v >> 16) & 255) as u8;
    b[i+3] = ((v >> 24) & 255) as u8;
    b[i+4] = ((v >> 32) & 255) as u8;
    b[i+5] = ((v >> 40) & 255) as u8;
    b[i+6] = ((v >> 48) & 255) as u8;
    b[i+7] = ((v >> 56) & 255) as u8;
}
fn get64(b:[]u8, i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64) << 8) | ((b[i+2] as i64) << 16) | ((b[i+3] as i64) << 24) | ((b[i+4] as i64) << 32) | ((b[i+5] as i64) << 40) | ((b[i+6] as i64) << 48) | ((b[i+7] as i64) << 56);
}
fn cstr(s:[]u8)[]u8{
    if(s.len < 1 || s.len > 4095){ return ""; }
    let p:*u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if(p == null as *u8){ return ""; }
    let b:[]u8 = p[0..(s.len + 1)];
    let i:i32 = 0;
    while(i < s.len){ b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn w_all(fd:i64, b:[]u8)i64{
    let at:i64 = 0;
    let calls:i32 = 0;
    let blen:i64 = b.len as i64;
    while(at < blen && calls < 16384){
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + at, blen - at, 0, 0, 0);
        calls = calls + 1;
        if(n == -4){ continue; }
        if(n <= 0){ return -7407; }
        at = at + n;
    }
    if(at != blen){ return -7407; }
    return at;
}

// ---------- Newton square root (5 iterations) ----------
fn fsqrt(x:f64)f64{
    if(x <= 0.0){ return 0.0; }
    let g:f64 = x;
    if(g < 1.0){ g = 1.0; }
    g = 0.5 * (g + x / g);
    g = 0.5 * (g + x / g);
    g = 0.5 * (g + x / g);
    g = 0.5 * (g + x / g);
    g = 0.5 * (g + x / g);
    return g;
}

// ---------- sine LUT (1024 entries, Q30 i32) ----------
// Used ONLY for: (a) physical vortex-shedding (aeolian) tones,
// whose frequency/amplitude are slaved to the wind schedule, and
// (b) raised-cosine diaphragm gesture shapes. Never as a voice.
fn tsin_taylor(x:f64)f64{
    let x2:f64 = x * x;
    let x3:f64 = x2 * x;
    return x - x3 / 6.0 + x3 * x2 / 120.0 - x3 * x2 * x2 / 5040.0;
}
fn tcos_taylor(x:f64)f64{
    let x2:f64 = x * x;
    return 1.0 - x2 / 2.0 + x2 * x2 / 24.0 - x2 * x2 * x2 / 720.0;
}
fn lut_build()[]u8{
    let p:*u8 = _zag_malloc(4100) as *u8;
    let lut:[]u8 = p[0..4100];
    let d:f64 = 6.283185307179586 / 1024.0;
    let c:f64 = tcos_taylor(d);
    let s:f64 = tsin_taylor(d);
    let sn:f64 = 0.0;
    let cn:f64 = 1.0;
    let i:i64 = 0;
    while(i <= 1024){
        put32(lut, i * 4, (sn * 1073741824.0) as i64);
        let nsn:f64 = sn * c + cn * s;
        let ncn:f64 = cn * c - sn * s;
        sn = nsn;
        cn = ncn;
        if((i & 127) == 127){
            let nn:f64 = sn * sn + cn * cn;
            sn = sn / nn;
            cn = cn / nn;
        }
        i = i + 1;
    }
    return lut;
}
fn sin01(lut:[]u8, ph:f64)f64{
    let x:f64 = ph * 1024.0;
    let idx:i64 = x as i64;
    if(idx > 1023){ idx = 1023; }
    if(idx < 0){ idx = 0; }
    let fr:f64 = x - (idx as f64);
    let l0:i64 = get32s(lut, idx * 4);
    let l1:i64 = get32s(lut, (idx + 1) * 4);
    return ((l0 as f64) + ((l1 - l0) as f64) * fr) / 1073741824.0;
}

// ---------- smoothstep ----------
fn sstep(x:f64)f64{
    if(x <= 0.0){ return 0.0; }
    if(x >= 1.0){ return 1.0; }
    return x * x * (3.0 - 2.0 * x);
}

// ---------- mix arena: i64 Q24 samples in []u8, 8 bytes/sample ----------
fn mix_new(nsamp:i64)[]u8{
    let p:*u8 = _zag_malloc(nsamp * 8) as *u8;
    let m:[]u8 = p[0..(nsamp * 8)];
    let i:i64 = 0;
    while(i < nsamp * 8){ m[i] = 0; i = i + 1; }
    return m;
}
fn mix_add(m:[]u8, s:i64, v:f64)void{
    let cur:i64 = get64(m, s * 8);
    put64(m, s * 8, cur + ((v * 16777216.0) as i64));
}
fn mix_get(m:[]u8, s:i64)f64{
    return (get64(m, s * 8) as f64) / 16777216.0;
}
fn mix_put(m:[]u8, s:i64, v:f64)void{
    put64(m, s * 8, (v * 16777216.0) as i64);
}
fn mix_peak(m:[]u8, nsamp:i64)f64{
    let pk:i64 = 0;
    let s:i64 = 0;
    while(s < nsamp){
        let v:i64 = get64(m, s * 8);
        if(v < 0){ v = -v; }
        if(v > pk){ pk = v; }
        s = s + 1;
    }
    return (pk as f64) / 16777216.0;
}
// scale whole buffer by k
fn mix_scale(m:[]u8, nsamp:i64, k:f64)void{
    let s:i64 = 0;
    while(s < nsamp){
        let v:i64 = get64(m, s * 8);
        put64(m, s * 8, ((v as f64) * k) as i64);
        s = s + 1;
    }
}

// ---------- WAV writer: 16-bit mono 44.1k ----------
// m holds Q24; peakn = measured peak BEFORE normalize; target peak 0.891 (-1 dB).
fn write_wav(path:[]u8, m:[]u8, nsamp:i64, peak_target:f64)i32{
    let pk:f64 = mix_peak(m, nsamp);
    if(pk < 1e-9){ return -99; }
    let g:f64 = peak_target / pk;
    let hsz:i64 = 44;
    let dsz:i64 = nsamp * 2;
    let p:*u8 = _zag_malloc(hsz + dsz) as *u8;
    let w:[]u8 = p[0..(hsz + dsz)];
    let i:i64 = 0;
    while(i < hsz + dsz){ w[i] = 0; i = i + 1; }
    w[0] = 82; w[1] = 73; w[2] = 70; w[3] = 70; // RIFF
    put32(w, 4, 36 + dsz);
    w[8] = 87; w[9] = 65; w[10] = 86; w[11] = 69; // WAVE
    w[12] = 102; w[13] = 109; w[14] = 116; w[15] = 32; // fmt
    put32(w, 16, 16);
    put16(w, 20, 1);
    put16(w, 22, 1);
    put32(w, 24, 44100);
    put32(w, 28, 88200);
    put16(w, 32, 2);
    put16(w, 34, 16);
    w[36] = 100; w[37] = 97; w[38] = 116; w[39] = 97; // data
    put32(w, 40, dsz);
    // 5 ms raised-cosine fades at both ends (no clicks, physical: mic on/off)
    let nf:i64 = 220;
    let s:i64 = 0;
    while(s < nsamp){
        let v:f64 = (get64(m, s * 8) as f64) / 16777216.0 * g;
        if(s < nf){
            let u:f64 = (s as f64) / (nf as f64);
            v = v * u * u * (3.0 - 2.0 * u);
        }
        let e:i64 = nsamp - 1 - s;
        if(e < nf){
            let u:f64 = (e as f64) / (nf as f64);
            v = v * u * u * (3.0 - 2.0 * u);
        }
        let q:i64 = (v * 32767.0) as i64;
        if(q > 32767){ q = 32767; }
        if(q < -32768){ q = -32768; }
        put16(w, hsz + s * 2, q & 65535);
        s = s + 1;
    }
    let cp:[]u8 = cstr(path);
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cp) as i64), 577, 420, 0, 0, 0);
    if(fd < 0){ return -98; }
    let rc:i64 = w_all(fd, w);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    _zag_free(p);
    if(rc < 0){ return -97; }
    return 0;
}

@import("../src/common_v5.zag")
// ============================================================
// DIAG — AUDIO V11 Crew A diagnosis instruments (pure Zag, no RNG).
// Usage: diag <mode> <clip.wav>
// modes: f0 | lpc | voice | ltas | laugh | pros
// Method frozen in MEASUREMENT_PLAN_V11.md. Deterministic: integer
// histograms, closed-form estimators; two runs must be byte-identical.
// Compile from aud/b_alpha/: znc diag -> v11_diag/diag.zag
// ============================================================

// ---------- line writers (single syscall per line; gate.zag pattern) --
fn d_putc(b:[]u8,p:i64,c:u8)i64{b[p]=c;return p+1;}
fn d_putstr(b:[]u8,p:i64,s:[]u8)i64{
    let i:i64=0;
    while(i<(s.len as i64)){b[p+i]=s[i];i=i+1;}
    return p+i;
}
fn d_puti64(b:[]u8,p:i64,v:i64)i64{
    let x:i64=v;
    if(x<0){b[p]=45;p=p+1;x=-x;}
    if(x==0){b[p]=48;return p+1;}
    let rev:i64=0;
    let d:i64=0;
    let xx:i64=x;
    while(xx>0){rev=rev*10+(xx%10);xx=xx/10;d=d+1;}
    while(d>0){b[p]=((rev%10)+48) as u8;rev=rev/10;p=p+1;d=d-1;}
    return p;
}
fn d_putf2(b:[]u8,p:i64,v:f64)i64{
    let x:f64=v;
    if(x<0.0){b[p]=45;p=p+1;x=-x;}
    let ip:i64=(x as i64);
    let fp:i64=((x-(ip as f64))*100.0+0.5) as i64;
    if(fp>=100){ip=ip+1;fp=fp-100;}
    p=d_puti64(b,p,ip);
    b[p]=46;p=p+1;
    if(fp<10){b[p]=48;p=p+1;}
    p=d_puti64(b,p,fp);
    return p;
}
fn d_line(b:[]u8,p:i64)void{
    b[p]=10;
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(p+1) as i64,0,0,0);
}
fn dM(b:[]u8,name:[]u8,v:f64)void{
    let p:i64=d_putstr(b,0,"M ");
    p=d_putstr(b,p,name);
    p=d_putc(b,p,32);
    p=d_putf2(b,p,v);
    d_line(b,p);
}
fn dN(b:[]u8,name:[]u8,v:i64)void{
    let p:i64=d_putstr(b,0,"N ");
    p=d_putstr(b,p,name);
    p=d_putc(b,p,32);
    p=d_puti64(b,p,v);
    d_line(b,p);
}
fn dS(b:[]u8,s:[]u8)void{
    let p:i64=d_putstr(b,0,s);
    d_line(b,p);
}

// ---------- math helpers ----------
// cos on [0,pi], Taylor to x^8 with pi/2 fold (gate.zag).
fn fcosr(x:f64)f64{
    let a:f64=x;
    let sgn:f64=1.0;
    if(a>1.5707963267948966){a=3.141592653589793-a;sgn=-1.0;}
    let x2:f64=a*a;
    let x4:f64=x2*x2;
    return sgn*(1.0-x2/2.0+x4/24.0-x4*x2/720.0+x4*x4/40320.0);
}
// cos on any x: reduce mod 2pi.
fn cosr(x:f64)f64{
    let t:f64=x/6.283185307179586;
    let k:i64=(t as i64);
    if(t<0.0){k=k-1;}
    let r:f64=x-(k as f64)*6.283185307179586;
    if(r>3.141592653589793){return -fcosr(6.283185307179586-r);}
    return fcosr(r);
}
fn sinr(x:f64)f64{return cosr(x-1.5707963267948966);}

// floor(log2(x))*1024 fixed point (gate.zag).
fn log2fp(x:i64)i64{
    if(x<=1){return 0;}
    let e:i64=0;
    let t:i64=x;
    if((t>>32)!=0){e=e+32;t=t>>32;}
    if((t>>16)!=0){e=e+16;t=t>>16;}
    if((t>>8)!=0){e=e+8;t=t>>8;}
    if((t>>4)!=0){e=e+4;t=t>>4;}
    if((t>>2)!=0){e=e+2;t=t>>2;}
    if((t>>1)!=0){e=e+1;}
    let r:i64=e*1024;
    let y:i64=0;
    if(e>=24){y=x>>(e-24);}else{y=x<<(24-e);}
    y=y & 33554431;
    let i:i64=1;
    while(i<=10){
        y=(y*y)>>24;
        if(y>=33554432){y=y>>1;r=r+(1024>>i);}
        i=i+1;
    }
    return r;
}
// 10*log10(r), r clamped to [1e-6,1e6]; ~0.003 dB resolution.
fn db_ratio(r:f64)f64{
    let rc:f64=r;
    if(rc<0.000001){rc=0.000001;}
    if(rc>1000000.0){rc=1000000.0;}
    let s:i64=(rc*1048576.0) as i64;
    if(s<1){s=1;}
    let l2:i64=log2fp(s);
    return ((l2 as f64)/1024.0-20.0)*3.010299956639812;
}
// semitones of ratio r (12*log2(r)).
fn st_ratio(r:f64)f64{
    let rc:f64=r;
    if(rc<0.000001){rc=0.000001;}
    if(rc>1000000.0){rc=1000000.0;}
    let s:i64=(rc*1048576.0) as i64;
    if(s<1){s=1;}
    let l2:i64=log2fp(s);
    return ((l2 as f64)/1024.0-20.0)*12.0;
}
// scaled-f64 arena accessors (values are O(1); scale 2^30).
fn fput(b:[]u8,i:i64,v:f64)void{put64(b,i*8,(v*1073741824.0) as i64);}
fn fget(b:[]u8,i:i64)f64{return (get64(b,i*8) as f64)/1073741824.0;}
fn hinc(h:[]u8,bin:i64)void{put64(h,bin*8,get64(h,bin*8)+1);}
fn hget(h:[]u8,bin:i64)i64{return get64(h,bin*8);}
// quantile from histogram: bins cover [lo, lo+nbins*step).
fn hquant(h:[]u8,nbins:i64,lo:f64,step:f64,q:f64,total:i64)f64{
    if(total<=0){return -1.0;}
    let tgt:f64=(total as f64)*q;
    let acc:i64=0;
    let b:i64=0;
    while(b<nbins){
        acc=acc+hget(h,b);
        if((acc as f64)>=tgt){return lo+(b as f64)*step+step/2.0;}
        b=b+1;
    }
    return lo+(nbins as f64)*step;
}
// zero an arena of nbytes.
fn azero(b:[]u8,n:i64)void{
    let i:i64=0;
    while(i<n){b[i]=0;i=i+1;}
}
// quantile from histogram with byte offset: bins cover [lo, lo+nbins*step).
fn hquant_off(h:[]u8,base:i64,nbins:i64,lo:f64,step:f64,q:f64,total:i64)f64{
    if(total<=0){return -1.0;}
    let tgt:f64=(total as f64)*q;
    let acc:i64=0;
    let b:i64=0;
    while(b<nbins){
        acc=acc+get64(h,base+b*8);
        if((acc as f64)>=tgt){return lo+(b as f64)*step+step/2.0;}
        b=b+1;
    }
    return lo+(nbins as f64)*step;
}

// ---------- F0 core ----------
// Decimated normalized autocorrelation F0 on a frame (n=1323 or 1102).
// tmp: scratch >= (n/4)*8. rrb: scratch >= 185*8 (holds rr[0..184]).
// Global-maximum peak over lags 14..184 (per plan); parabolic interp.
// VOICED iff peak >= 0.45 AND peak lag <= 74 (F0 >= 149 Hz: rejects the
// 60 Hz mains-hum skirt that otherwise false-triggers at lag 14).
// Harmonic guard: if peak lag <= 37, require rr[2*lag] >= 0.35 to reject
// colored-noise single-lobe false peaks (they lack a 2T harmonic).
// Returns F0 Hz, 0 if unvoiced. hnr out: 10*log10(rp/(1-rp)), -99 if unv.
fn f0_frame(samp:[]u8,so:i64,n:i64,tmp:[]u8,rrb:[]u8,hnr:*f64)f64{
    let sumsq:i64=0;
    let i:i64=0;
    while(i<n){
        let v:i64=get16s(samp,so+i*2);
        sumsq=sumsq+v*v;
        i=i+1;
    }
    // energy gate: -55 dBFS -> (32768*10^(-55/20))^2 per sample ~= 3395
    if(sumsq<3395*n){hnr.*=-99.0;return 0.0;}
    // decimate x4 -> nd samples @11025 Hz
    let nd:i64=n/4;
    i=0;
    while(i<nd){
        let b0:i64=so+(i*4)*2;
        let s:f64=((get16s(samp,b0)+get16s(samp,b0+2)+get16s(samp,b0+4)+get16s(samp,b0+6)) as f64)/131072.0;
        fput(tmp,i,s);
        i=i+1;
    }
    let r0:f64=0.0;
    i=0;
    while(i<nd){let d:f64=fget(tmp,i);r0=r0+d*d;i=i+1;}
    if(r0<=0.0){hnr.*=-99.0;return 0.0;}
    let L:i64=0;
    while(L<=184){
        let rr:f64=0.0;
        let j:i64=0;
        let lim:i64=nd-L;
        while(j<lim){rr=rr+fget(tmp,j)*fget(tmp,j+L);j=j+1;}
        fput(rrb,L,rr/r0);
        L=L+1;
    }
    // global max over 14..184 that is also a LOCAL maximum
    // (rejects the mains-hum/rumble skirt, which peaks at lag 14
    //  without being a local max)
    let bestL:i64=-1;
    let bestR:f64=0.45;
    L=14;
    while(L<=183){
        let v:f64=fget(rrb,L);
        if(v>=bestR && v>=fget(rrb,L-1) && v>fget(rrb,L+1)){
            bestR=v;bestL=L;
        }
        L=L+1;
    }
    if(bestL<0){hnr.*=-99.0;return 0.0;}
    if(bestL>74){hnr.*=-99.0;return 0.0;}
    // harmonic guard for short lags
    if(bestL<=37){
        let h2:f64=fget(rrb,bestL*2);
        if(h2<0.35){hnr.*=-99.0;return 0.0;}
    }
    // parabolic interpolation
    let lag:f64=(bestL as f64);
    let pk:f64=bestR;
    if(bestL>14 && bestL<184){
        let y0:f64=fget(rrb,bestL-1);
        let y1:f64=bestR;
        let y2:f64=fget(rrb,bestL+1);
        let den:f64=y0-2.0*y1+y2;
        if(den<0.0){
            let sh:f64=0.5*(y0-y2)/den;
            if(sh>-1.0 && sh<1.0){lag=lag+sh;pk=y1-0.25*(y0-y2)*sh;}
        }
    }
    let rp:f64=pk;
    if(rp<0.001){rp=0.001;}
    if(rp>0.999){rp=0.999;}
    hnr.*=db_ratio(rp/(1.0-rp));
    return 11025.0/lag;
}

// ---------- Goertzel ----------
fn goertzel16(samp:[]u8,so:i64,n:i64,f:f64)f64{
    let w:f64=6.283185307179586*f/44100.0;
    let c:f64=2.0*cosr(w);
    let s1:f64=0.0;
    let s2:f64=0.0;
    let i:i64=0;
    while(i<n){
        let x:f64=(get16s(samp,so+i*2) as f64)/32768.0;
        let s0:f64=x+c*s1-s2;
        s2=s1;
        s1=s0;
        i=i+1;
    }
    return s1*s1+s2*s2-c*s1*s2;
}
fn goertzelF(fb:[]u8,n:i64,f:f64)f64{
    let w:f64=6.283185307179586*f/44100.0;
    let c:f64=2.0*cosr(w);
    let s1:f64=0.0;
    let s2:f64=0.0;
    let i:i64=0;
    while(i<n){
        let x:f64=fget(fb,i);
        let s0:f64=x+c*s1-s2;
        s2=s1;
        s1=s0;
        i=i+1;
    }
    return s1*s1+s2*s2-c*s1*s2;
}

// ---------- LPC ----------
// Normalized autocorrelation (pre-emphasis 0.97 + Hamming) into rb[0..ord].
// wb: scratch arena >= n*8 bytes for windowed samples.
fn acorr_norm(samp:[]u8,so:i64,n:i64,ord:i64,rb:[]u8,wb:[]u8)void{
    let i:i64=0;
    let prev:i64=0;
    while(i<n){
        let s0:i64=get16s(samp,so+i*2);
        let wi:f64=0.54-0.46*cosr(6.283185307179586*(i as f64)/((n-1) as f64));
        let x:f64=((s0 as f64)-0.97*(prev as f64))/32768.0*wi;
        fput(wb,i,x);
        prev=s0;
        i=i+1;
    }
    let k:i64=0;
    let r0raw:f64=0.0;
    i=0;
    while(i<n){let w:f64=fget(wb,i);r0raw=r0raw+w*w;i=i+1;}
    while(k<=ord){
        let rr:f64=0.0;
        i=k;
        while(i<n){rr=rr+fget(wb,i)*fget(wb,i-k);i=i+1;}
        if(r0raw>0.0){fput(rb,k,rr/r0raw);}else{fput(rb,k,0.0);}
        k=k+1;
    }
}
// Levinson-Durbin on normalized autocorr rb[0..ord] -> LPC ab[1..ord].
// tb: scratch arena >= (ord+1)*8 bytes.
fn durbin(rb:[]u8,ord:i64,ab:[]u8,tb:[]u8)void{
    let i:i64=1;
    while(i<=ord){fput(ab,i,0.0);i=i+1;}
    let E:f64=fget(rb,0);
    if(E<=0.0){return;}
    let m:i64=1;
    while(m<=ord){
        let acc:f64=0.0;
        let j:i64=1;
        while(j<m){acc=acc+fget(ab,j)*fget(rb,m-j);j=j+1;}
        let km:f64=(fget(rb,m)-acc)/E;
        j=1;
        while(j<m){fput(tb,j,fget(ab,j));j=j+1;}
        fput(ab,m,km);
        j=1;
        while(j<m){
            fput(ab,j,fget(tb,j)-km*fget(tb,m-j));
            j=j+1;
        }
        E=E*(1.0-km*km);
        if(E<=0.0){E=0.000001;}
        m=m+1;
    }
}
// LPC log-magnitude spectrum: 128 points 0..8000 Hz into spec arena (linear).
fn lpc_spec(ab:[]u8,ord:i64,spec:[]u8)void{
    let g:i64=0;
    while(g<128){
        let fr:f64=(g as f64)*62.5;
        let w:f64=6.283185307179586*fr/44100.0;
        let cw:f64=cosr(w);
        let sw:f64=sinr(w);
        let re:f64=1.0;
        let im:f64=0.0;
        let are:f64=1.0;
        let aim:f64=0.0;
        let k:i64=1;
        while(k<=ord){
            let nre:f64=re*cw-im*sw;
            let nim:f64=re*sw+im*cw;
            re=nre;im=nim;
            let ak:f64=fget(ab,k);
            are=are-ak*re;
            aim=aim-ak*im;
            k=k+1;
        }
        let m2:f64=are*are+aim*aim;
        if(m2<1e-12){m2=1e-12;}
        fput(spec,g,1.0/m2);
        g=g+1;
    }
}

// ---------- string compare ----------
fn streq(a:[]u8,b:[]u8)i64{
    if((a.len as i64)!=(b.len as i64)){return 0;}
    let i:i64=0;
    while(i<(a.len as i64)){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// prominence (dB) of spectral peak at grid g (128-pt grid).
fn peak_prom(spec:[]u8,g:i64)f64{
    let pk:f64=fget(spec,g);
    let minL:f64=pk;
    let j:i64=g-1;
    while(j>=0){
        let v:f64=fget(spec,j);
        if(v<minL){minL=v;}
        if(v>pk){break;}
        j=j-1;
    }
    let minR:f64=pk;
    j=g+1;
    while(j<128){
        let v:f64=fget(spec,j);
        if(v<minR){minR=v;}
        if(v>pk){break;}
        j=j+1;
    }
    let m:f64=minL;
    if(minR>m){m=minR;}
    return db_ratio(pk/m);
}
// -3dB bandwidth (Hz) of peak at grid g; -1 if it hits an edge.
fn peak_bw(spec:[]u8,g:i64)f64{
    let pk:f64=fget(spec,g);
    let half:f64=pk/2.0;
    let gl:f64=(g as f64);
    let j:i64=g-1;
    while(j>=0){
        let v:f64=fget(spec,j);
        if(v<=half){
            let v1:f64=fget(spec,j+1);
            if(v1>v){gl=(j as f64)+(half-v)/(v1-v);}
            break;
        }
        if(j==0){return -1.0;}
        j=j-1;
    }
    let gr:f64=(g as f64);
    j=g+1;
    while(j<128){
        let v:f64=fget(spec,j);
        if(v<=half){
            let v1:f64=fget(spec,j-1);
            if(v1>v){gr=(j as f64)-(half-v)/(v1-v);}
            break;
        }
        if(j==127){return -1.0;}
        j=j+1;
    }
    return (gr-gl)*62.5;
}

// ================= MODE f0 =================
fn mode_f0(samp:[]u8,nsamp:i64,tmp:[]u8,rrb:[]u8,lb:[]u8)void{
    let nframes:i64=(nsamp-1323)/441;
    if(nframes<1){nframes=1;}
    let hb:*u8=_zag_malloc(100*8) as *u8;
    let hist:[]u8=hb[0..800];
    azero(hist,800);
    let nb:*u8=_zag_malloc(60*8) as *u8;
    let hnrh:[]u8=nb[0..480];
    azero(hnrh,480);
    let voiced:i64=0;
    let fr:i64=0;
    while(fr<nframes){
        let so:i64=fr*441*2;
        let hnr:f64=0.0;
        let f:f64=f0_frame(samp,so,1323,tmp,rrb,&hnr);
        if(f>0.0){
            voiced=voiced+1;
            let bin:i64=(f/10.0) as i64;
            if(bin>99){bin=99;}
            if(bin<0){bin=0;}
            hinc(hist,bin);
            let hb2:i64=((hnr+20.0) as i64);
            if(hb2<0){hb2=0;}
            if(hb2>59){hb2=59;}
            hinc(hnrh,hb2);
        }
        fr=fr+1;
    }
    dN(lb,"frames",nframes);
    dN(lb,"voiced",voiced);
    let p10:f64=hquant(hist,100,0.0,10.0,0.10,voiced);
    let p50:f64=hquant(hist,100,0.0,10.0,0.50,voiced);
    let p90:f64=hquant(hist,100,0.0,10.0,0.90,voiced);
    dM(lb,"f0_p10",p10);
    dM(lb,"f0_med",p50);
    dM(lb,"f0_p90",p90);
    if(p10>0.0 && p90>0.0){dM(lb,"f0_exc_st",st_ratio(p90/p10));}else{dM(lb,"f0_exc_st",-1.0);}
    dM(lb,"hnr_med",hquant(hnrh,60,-20.0,1.0,0.50,voiced));
}

// ================= MODE lpc =================
fn mode_lpc(samp:[]u8,nsamp:i64,tmp:[]u8,rrb:[]u8,wb:[]u8,rb:[]u8,ab:[]u8,tb:[]u8,spec:[]u8,lb:[]u8)void{
    let nframes:i64=(nsamp-1323)/441;
    if(nframes<1){nframes=1;}
    let fhb:*u8=_zag_malloc(4*320*8) as *u8;
    let fh:[]u8=fhb[0..(4*320*8)];
    azero(fh,4*320*8);
    let bhb:*u8=_zag_malloc(4*200*8) as *u8;
    let bh:[]u8=bhb[0..(4*200*8)];
    azero(bh,4*200*8);
    let voiced:i64=0;
    let fform:i64=0;
    let fr:i64=0;
    while(fr<nframes){
        let so:i64=fr*441*2;
        let hnr:f64=0.0;
        let f:f64=f0_frame(samp,so,1323,tmp,rrb,&hnr);
        if(f>0.0){
            voiced=voiced+1;
            acorr_norm(samp,so,1102,24,rb,wb);
            durbin(rb,24,ab,tb);
            lpc_spec(ab,24,spec);
            // peak collect (grid indices, ascending)
            let pk:*u8=_zag_malloc(32*8) as *u8;
            let pka:[]u8=pk[0..256];
            let npk:i64=0;
            let g:i64=1;
            while(g<127){
                if(fget(spec,g)>fget(spec,g-1) && fget(spec,g)>=fget(spec,g+1)){
                    if(peak_prom(spec,g)>=3.0){
                        if(npk<32){put64(pka,npk*8,g);npk=npk+1;}
                    }
                }
                g=g+1;
            }
            // assign F1..F4 (freq > 150 Hz)
            let ff:*u8=_zag_malloc(4*8) as *u8;
            let ffa:[]u8=ff[0..32];
            let bb:*u8=_zag_malloc(4*8) as *u8;
            let bba:[]u8=bb[0..32];
            let nf:i64=0;
            let pi:i64=0;
            while(pi<npk && nf<4){
                let gg:i64=get64(pka,pi*8);
                let frq:f64=(gg as f64)*62.5;
                if(frq>150.0){
                    fput(ffa,nf,frq);
                    fput(bba,nf,peak_bw(spec,gg));
                    nf=nf+1;
                }
                pi=pi+1;
            }
            if(nf>=3){
                fform=fform+1;
                let k2:i64=0;
                while(k2<nf){
                    let fv:f64=fget(ffa,k2);
                    let bin:i64=(fv/25.0) as i64;
                    if(bin<0){bin=0;}
                    if(bin>319){bin=319;}
                    put64(fh,(k2*320+bin)*8,get64(fh,(k2*320+bin)*8)+1);
                    let bwv:f64=fget(bba,k2);
                    if(bwv>0.0){
                        let bb3:i64=(bwv/10.0) as i64;
                        if(bb3<0){bb3=0;}
                        if(bb3>199){bb3=199;}
                        put64(bh,(k2*200+bb3)*8,get64(bh,(k2*200+bb3)*8)+1);
                    }
                    k2=k2+1;
                }
            }
        }
        fr=fr+1;
    }
    dN(lb,"frames",nframes);
    dN(lb,"voiced",voiced);
    dN(lb,"formant_frames",fform);
    let k3:i64=0;
    while(k3<4){
        let tot:i64=0;
        let b2:i64=0;
        while(b2<320){tot=tot+get64(fh,(k3*320+b2)*8);b2=b2+1;}
        let nm:[]u8="F1_med";
        if(k3==1){nm="F2_med";}
        if(k3==2){nm="F3_med";}
        if(k3==3){nm="F4_med";}
        dM(lb,nm,hquant_off(fh,k3*320*8,320,0.0,25.0,0.50,tot));
        nm="F1_p25";
        if(k3==1){nm="F2_p25";}
        if(k3==2){nm="F3_p25";}
        if(k3==3){nm="F4_p25";}
        dM(lb,nm,hquant_off(fh,k3*320*8,320,0.0,25.0,0.25,tot));
        nm="F1_p75";
        if(k3==1){nm="F2_p75";}
        if(k3==2){nm="F3_p75";}
        if(k3==3){nm="F4_p75";}
        dM(lb,nm,hquant_off(fh,k3*320*8,320,0.0,25.0,0.75,tot));
        let totb:i64=0;
        b2=0;
        while(b2<200){totb=totb+get64(bh,(k3*200+b2)*8);b2=b2+1;}
        nm="B1_med";
        if(k3==1){nm="B2_med";}
        if(k3==2){nm="B3_med";}
        if(k3==3){nm="B4_med";}
        dM(lb,nm,hquant_off(bh,k3*200*8,200,0.0,10.0,0.50,totb));
        k3=k3+1;
    }
}

// ================= MODE voice =================
fn mode_voice(samp:[]u8,nsamp:i64,tmp:[]u8,rrb:[]u8,fb:[]u8,lb:[]u8)void{
    let nframes:i64=(nsamp-1323)/441;
    if(nframes<1){nframes=1;}
    let h1:*u8=_zag_malloc(120*8) as *u8;
    let h12:[]u8=h1[0..960];
    azero(h12,960);
    let t1:*u8=_zag_malloc(160*8) as *u8;
    let th:[]u8=t1[0..1280];
    azero(th,1280);
    let n1:*u8=_zag_malloc(60*8) as *u8;
    let nh:[]u8=n1[0..480];
    azero(nh,480);
    let voiced:i64=0;
    let fr:i64=0;
    while(fr<nframes){
        let so:i64=fr*441*2;
        let hnr:f64=0.0;
        let f:f64=f0_frame(samp,so,1323,tmp,rrb,&hnr);
        if(f>0.0){
            voiced=voiced+1;
            let i:i64=0;
            while(i<1323){fput(fb,i,(get16s(samp,so+i*2) as f64)/32768.0);i=i+1;}
            let e1:f64=goertzelF(fb,1323,f);
            let e2:f64=goertzelF(fb,1323,2.0*f);
            let h1h2:f64=db_ratio(e1/e2);
            let b1:i64=((h1h2+20.0)*2.0) as i64;
            if(b1<0){b1=0;}
            if(b1>119){b1=119;}
            hinc(h12,b1);
            let low:f64=goertzel16(samp,so,1323,300.0)+goertzel16(samp,so,1323,600.0)+goertzel16(samp,so,1323,1000.0);
            let high:f64=goertzel16(samp,so,1323,4000.0)+goertzel16(samp,so,1323,6000.0)+goertzel16(samp,so,1323,8000.0);
            let tilt:f64=db_ratio(high/low);
            let b2:i64=((tilt+60.0)*2.0) as i64;
            if(b2<0){b2=0;}
            if(b2>159){b2=159;}
            hinc(th,b2);
            let b3:i64=((hnr+20.0) as i64);
            if(b3<0){b3=0;}
            if(b3>59){b3=59;}
            hinc(nh,b3);
        }
        fr=fr+1;
    }
    dN(lb,"voiced",voiced);
    dM(lb,"h1h2_med",hquant(h12,120,-20.0,0.5,0.50,voiced));
    dM(lb,"tilt_med",hquant(th,160,-60.0,0.5,0.50,voiced));
    dM(lb,"hnr_med",hquant(nh,60,-20.0,1.0,0.50,voiced));
}

// ================= MODE ltas =================
// 24 log bands 100 Hz..8 kHz; per-1s-window normalized band fractions
// accumulated (robust to level differences); ALL windows + voiced-majority.
fn mode_ltas(samp:[]u8,nsamp:i64,tmp:[]u8,rrb:[]u8,lb:[]u8)void{
    let nframes:i64=(nsamp-1323)/441;
    if(nframes<1){nframes=1;}
    let mb:*u8=_zag_malloc(nframes) as *u8;
    let mask:[]u8=mb[0..nframes];
    let fr:i64=0;
    while(fr<nframes){
        let so:i64=fr*441*2;
        let hnr:f64=0.0;
        let f:f64=f0_frame(samp,so,1323,tmp,rrb,&hnr);
        if(f>0.0){mask[fr]=1;}else{mask[fr]=0;}
        fr=fr+1;
    }
    let sab:*u8=_zag_malloc(24*8) as *u8;
    let sa:[]u8=sab[0..192];
    azero(sa,192);
    let svb:*u8=_zag_malloc(24*8) as *u8;
    let sv:[]u8=svb[0..192];
    azero(sv,192);
    let nwin:i64=nsamp/44100;
    if(nwin<1){nwin=1;}
    let nvall:i64=0;
    let nvvd:i64=0;
    let w:i64=0;
    while(w<nwin){
        let so:i64=w*44100*2;
        if(so+44100*2>(nsamp*2)){break;}
        let eb:*u8=_zag_malloc(24*8) as *u8;
        let eba:[]u8=eb[0..192];
        let fk:f64=100.0;
        let k:i64=0;
        let etot:f64=0.0;
        while(k<24){
            let e:f64=goertzel16(samp,so,44100,fk);
            fput(eba,k,e);
            etot=etot+e;
            fk=fk*1.20990;
            k=k+1;
        }
        if(etot>0.0){
            nvall=nvall+1;
            k=0;
            while(k<24){fput(sa,k,fget(sa,k)+fget(eba,k)/etot);k=k+1;}
            // voiced fraction of this window
            let f0i:i64=w*100;
            let vfc:i64=0;
            let q:i64=0;
            while(q<100){
                if(f0i+q<nframes && mask[f0i+q]==1){vfc=vfc+1;}
                q=q+1;
            }
            if(vfc>=50){
                nvvd=nvvd+1;
                k=0;
                while(k<24){fput(sv,k,fget(sv,k)+fget(eba,k)/etot);k=k+1;}
            }
        }
        w=w+1;
    }
    dN(lb,"ltas_windows",nvall);
    dN(lb,"ltas_voiced_windows",nvvd);
    // print normalized 0dB-max CSV lines
    let p:i64=d_putstr(lb,0,"LTAS-ALL ");
    let mx:f64=0.000000001;
    let k:i64=0;
    while(k<24){let v:f64=fget(sa,k);if(v>mx){mx=v;}k=k+1;}
    k=0;
    while(k<24){
        p=d_putf2(lb,p,db_ratio(fget(sa,k)/mx));
        if(k<23){p=d_putc(lb,p,44);}
        k=k+1;
    }
    d_line(lb,p);
    p=d_putstr(lb,0,"LTAS-VOICED ");
    mx=0.000000001;
    k=0;
    while(k<24){let v:f64=fget(sv,k);if(v>mx){mx=v;}k=k+1;}
    k=0;
    while(k<24){
        p=d_putf2(lb,p,db_ratio(fget(sv,k)/mx));
        if(k<23){p=d_putc(lb,p,44);}
        k=k+1;
    }
    d_line(lb,p);
}

// ================= MODE laugh =================
fn mode_laugh(samp:[]u8,nsamp:i64,tmp:[]u8,rrb:[]u8,lb:[]u8)void{
    let nframes:i64=(nsamp-882)/441;
    if(nframes<1){nframes=1;}
    let eb:*u8=_zag_malloc(nframes*8) as *u8;
    let env:[]u8=eb[0..(nframes*8)];
    let fr:i64=0;
    while(fr<nframes){
        let so:i64=fr*441*2;
        let sumsq:i64=0;
        let i:i64=0;
        while(i<882){let v:i64=get16s(samp,so+i*2);sumsq=sumsq+v*v;i=i+1;}
        fput(env,fr,fsqrt((sumsq as f64)/882.0)/32768.0);
        fr=fr+1;
    }
    // bursts: runs >= -30 dBFS (0.0316), 6..50 frames, gaps <6 merged
    let sb:*u8=_zag_malloc(512*8) as *u8;
    let bsta:[]u8=sb[0..4096];
    let nb:*u8=_zag_malloc(512*8) as *u8;
    let bend:[]u8=nb[0..4096];
    let nburst:i64=0;
    let inb:i64=0;
    let bs:i64=0;
    fr=0;
    while(fr<nframes){
        let e:f64=fget(env,fr);
        if(inb==0){
            if(e>=0.0316){inb=1;bs=fr;}
        }else{
            if(e<0.0316){
                inb=0;
                let dur:i64=fr-bs;
                if(dur>=6 && dur<=50){
                                    if(nburst>0 && bs-get64(bend,(nburst-1)*8)<6){
                                        put64(bend,(nburst-1)*8,fr);
                                    }else{
                                        if(nburst<512){put64(bsta,nburst*8,bs);put64(bend,nburst*8,fr);nburst=nburst+1;}
                                    }
                }else{
                    if(dur>50){
                        // long event: split into syllable-sized chunks at env minima
                        let cs:i64=bs;
                        let ce:i64=bs+25;
                        while(ce<fr){
                            if(nburst<512){put64(bsta,nburst*8,cs);put64(bend,nburst*8,ce);nburst=nburst+1;}
                            cs=ce;
                            ce=ce+25;
                        }
                        if(nburst<512){put64(bsta,nburst*8,cs);put64(bend,nburst*8,fr);nburst=nburst+1;}
                    }
                }
            }
        }
        fr=fr+1;
    }
    // episodes: bursts with <120-frame gaps
    let nepi:i64=0;
    let epi_dur:i64=0;
    let gap_sum:i64=0;
    let gap_n:i64=0;
    let dur_sum:i64=0;
    let rise_sum:f64=0.0;
    let fall_sum:f64=0.0;
    let rng_sum:f64=0.0;
    let f_n:i64=0;
    let bi:i64=0;
    let epi_start:i64=0;
    if(nburst>0){epi_start=get64(bsta,0);}
    while(bi<nburst){
        let bs2:i64=get64(bsta,bi*8);
        let be2:i64=get64(bend,bi*8);
        dur_sum=dur_sum+(be2-bs2);
        if(bi>0){
            let prev_be:i64=get64(bend,(bi-1)*8);
            let gap:i64=bs2-prev_be;
            if(gap<120){gap_sum=gap_sum+gap;gap_n=gap_n+1;}
            else{nepi=nepi+1;epi_dur=epi_dur+(prev_be-epi_start);epi_start=bs2;}
        }
        // F0 at burst start/mid/end (10 ms frames -> sample offsets)
        let ok0:i64=0;
        let ok1:i64=0;
        let ok2:i64=0;
        let f0s:f64=0.0;
        let f0m:f64=0.0;
        let f0e:f64=0.0;
        let hnr:f64=0.0;
        let so0:i64=bs2*441*2;
        if(so0+2646<=nsamp*2){
            f0s=f0_frame(samp,so0,1323,tmp,rrb,&hnr);
            if(f0s>0.0){ok0=1;}
        }
        let mid:i64=(bs2+be2)/2;
        let so1:i64=mid*441*2;
        if(so1+2646<=nsamp*2){
            f0m=f0_frame(samp,so1,1323,tmp,rrb,&hnr);
            if(f0m>0.0){ok1=1;}
        }
        let so2:i64=be2*441*2;
        if(so2+2646<=nsamp*2){
            f0e=f0_frame(samp,so2,1323,tmp,rrb,&hnr);
            if(f0e>0.0){ok2=1;}
        }
        if(ok0==1 && ok1==1){
            rise_sum=rise_sum+st_ratio(f0m/f0s);
            let lo:f64=f0s;
            let hi:f64=f0s;
            if(f0m<lo){lo=f0m;}
            if(f0m>hi){hi=f0m;}
            if(ok2==1){
                fall_sum=fall_sum+st_ratio(f0e/f0m);
                if(f0e<lo){lo=f0e;}
                if(f0e>hi){hi=f0e;}
            }
            rng_sum=rng_sum+st_ratio(hi/lo);
            f_n=f_n+1;
        }
        bi=bi+1;
    }
    if(nburst>0){nepi=nepi+1;epi_dur=epi_dur+(get64(bend,(nburst-1)*8)-epi_start);}
    dN(lb,"bursts",nburst);
    dN(lb,"episodes",nepi);
    if(nburst>0){dM(lb,"burst_dur_ms",((dur_sum as f64)/(nburst as f64))*10.0);}else{dM(lb,"burst_dur_ms",-1.0);}
    if(gap_n>0){dM(lb,"gap_ms",((gap_sum as f64)/(gap_n as f64))*10.0);}else{dM(lb,"gap_ms",-1.0);}
    if(epi_dur>0){dM(lb,"syl_rate",((nburst as f64)/((epi_dur as f64)*0.01)));}else{dM(lb,"syl_rate",-1.0);}
    if(f_n>0){
        dM(lb,"f0_rise_st",rise_sum/(f_n as f64));
        dM(lb,"f0_fall_st",fall_sum/(f_n as f64));
        dM(lb,"f0_range_st",rng_sum/(f_n as f64));
    }else{
        dM(lb,"f0_rise_st",-99.0);
        dM(lb,"f0_fall_st",-99.0);
        dM(lb,"f0_range_st",-99.0);
    }
    dN(lb,"f0_bursts",f_n);
}

// ================= MODE pros =================
fn mode_pros(samp:[]u8,nsamp:i64,tmp:[]u8,rrb:[]u8,lb:[]u8)void{
    // syllable rate from 10 ms envelope peaks
    let nframes:i64=(nsamp-882)/441;
    if(nframes<1){nframes=1;}
    let eb:*u8=_zag_malloc(nframes*8) as *u8;
    let env:[]u8=eb[0..(nframes*8)];
    let fr:i64=0;
    while(fr<nframes){
        let so:i64=fr*441*2;
        let sumsq:i64=0;
        let i:i64=0;
        while(i<882){let v:i64=get16s(samp,so+i*2);sumsq=sumsq+v*v;i=i+1;}
        fput(env,fr,fsqrt((sumsq as f64)/882.0)/32768.0);
        fr=fr+1;
    }
    let emed:f64=0.0;
    fr=0;
    while(fr<nframes){emed=emed+fget(env,fr);fr=fr+1;}
    emed=emed/(nframes as f64);
    let nsyl:i64=0;
    let lastp:i64=-100;
    fr=1;
    while(fr<nframes-1){
        let e:f64=fget(env,fr);
        if(e>fget(env,fr-1) && e>=fget(env,fr+1) && e>=2.0*emed && fr-lastp>=12){
            nsyl=nsyl+1;
            lastp=fr;
        }
        fr=fr+1;
    }
    let dur_s:f64=(nsamp as f64)/44100.0;
    dM(lb,"syl_rate",((nsyl as f64)/dur_s));
    dN(lb,"syllables",nsyl);
    // pauses: 50 ms frames < -50 dBFS
    let n50:i64=nsamp/2205;
    let pauses:i64=0;
    let pdur:i64=0;
    let pin:i64=0;
    let pstart:i64=0;
    let pfrac:i64=0;
    let q:i64=0;
    while(q<n50){
        let so:i64=q*2205*2;
        let sumsq:i64=0;
        let i:i64=0;
        while(i<2205){let v:i64=get16s(samp,so+i*2);sumsq=sumsq+v*v;i=i+1;}
        // -50 dBFS: (32768*10^(-50/20))^2 ~= 10736 per sample
        let ispause:i64=0;
        if(sumsq<10736*2205){ispause=1;pfrac=pfrac+1;}
        if(ispause==1 && pin==0){pin=1;pstart=q;}
        if(ispause==0 && pin==1){pin=0;pauses=pauses+1;pdur=pdur+(q-pstart);}
        q=q+1;
    }
    if(pin==1){pauses=pauses+1;pdur=pdur+(n50-pstart);}
    dM(lb,"pause_frac",((pfrac as f64)/(n50 as f64)));
    dN(lb,"pauses",pauses);
    if(pauses>0){dM(lb,"pause_dur_ms",((pdur as f64)/(pauses as f64))*50.0);}else{dM(lb,"pause_dur_ms",-1.0);}
    // pitch excursion from F0 histogram
    let hb:*u8=_zag_malloc(100*8) as *u8;
    let hist:[]u8=hb[0..800];
    azero(hist,800);
    let voiced:i64=0;
    let nf2:i64=(nsamp-1323)/441;
    if(nf2<1){nf2=1;}
    fr=0;
    while(fr<nf2){
        let so:i64=fr*441*2;
        let hnr:f64=0.0;
        let f:f64=f0_frame(samp,so,1323,tmp,rrb,&hnr);
        if(f>0.0){
            voiced=voiced+1;
            let bin:i64=(f/10.0) as i64;
            if(bin>99){bin=99;}
            if(bin<0){bin=0;}
            hinc(hist,bin);
        }
        fr=fr+1;
    }
    let p10:f64=hquant(hist,100,0.0,10.0,0.10,voiced);
    let p90:f64=hquant(hist,100,0.0,10.0,0.90,voiced);
    if(p10>0.0 && p90>0.0){dM(lb,"pitch_exc_st",st_ratio(p90/p10));}else{dM(lb,"pitch_exc_st",-1.0);}
}

// ================= MAIN =================
fn main()i32{
    let lb:*u8=_zag_malloc(4096) as *u8;
    let line:[]u8=lb[0..4096];
    let mode:[]u8=_zag_arg(1);
    let path:[]u8=_zag_arg(2);
    if((mode.len as i64)==0 || (path.len as i64)==0){
        dS(line,"usage: diag <f0|lpc|voice|ltas|laugh|pros> <clip.wav>");
        return 2;
    }
    let raw:[]u8=file_read(path,80000000);
    if((raw.len as i64)==0){
        dS(line,"read fail");
        return 2;
    }
    let samp:[]u8=wav_parse(raw);
    if((samp.len as i64)==0){
        dS(line,"wav parse fail");
        return 2;
    }
    let nsamp:i64=(samp.len as i64)/2;
    let p:i64=d_putstr(line,0,"DIAG ");
    p=d_putstr(line,p,mode);
    p=d_putc(line,p,32);
    p=d_putstr(line,p,path);
    d_line(line,p);
    dN(line,"nsamp",nsamp);
    let tb0:*u8=_zag_malloc(331*8) as *u8;
    let tmp:[]u8=tb0[0..(331*8)];
    let wb0:*u8=_zag_malloc(1102*8) as *u8;
    let wb:[]u8=wb0[0..(1102*8)];
    let rb0:*u8=_zag_malloc(25*8) as *u8;
    let rb:[]u8=rb0[0..200];
    let ab0:*u8=_zag_malloc(25*8) as *u8;
    let ab:[]u8=ab0[0..200];
    let db0:*u8=_zag_malloc(25*8) as *u8;
    let db:[]u8=db0[0..200];
    let sp0:*u8=_zag_malloc(128*8) as *u8;
    let spec:[]u8=sp0[0..1024];
    let fb0:*u8=_zag_malloc(1323*8) as *u8;
    let fb:[]u8=fb0[0..(1323*8)];
    let rb20:*u8=_zag_malloc(185*8) as *u8;
    let rrb:[]u8=rb20[0..1480];
    let isf0:i64=streq(mode,"f0");
    let islpc:i64=streq(mode,"lpc");
    let isvoice:i64=streq(mode,"voice");
    let isltas:i64=streq(mode,"ltas");
    let islaugh:i64=streq(mode,"laugh");
    let ispros:i64=streq(mode,"pros");
    if(isf0==1){mode_f0(samp,nsamp,tmp,rrb,line);}
    if(islpc==1){mode_lpc(samp,nsamp,tmp,rrb,wb,rb,ab,db,spec,line);}
    if(isvoice==1){mode_voice(samp,nsamp,tmp,rrb,fb,line);}
    if(isltas==1){mode_ltas(samp,nsamp,tmp,rrb,line);}
    if(islaugh==1){mode_laugh(samp,nsamp,tmp,rrb,line);}
    if(ispros==1){mode_pros(samp,nsamp,tmp,rrb,line);}
    if(isf0==0 && islpc==0 && isvoice==0 && isltas==0 && islaugh==0 && ispros==0){
        dS(line,"unknown mode");
        return 2;
    }
    dS(line,"DIAG-END");
    return 0;
}

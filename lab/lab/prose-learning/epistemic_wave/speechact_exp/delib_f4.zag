// delib_f4.zag — lie-catcher REDESIGN (PREREG_LIECATCHER_REDESIGN.md).
// The test-derived helpers is_known_false/is_known_true/is_absurd are
// REMOVED (see LIECATCHER_CORRECTION.md). Replacement: an episodic fact
// ledger. The learner parses an independently authored experience corpus
// (FACT|<text>) into (subject-key, numeric-claim) pairs; each test claim
// is contradiction-checked against the ledger. No baked-in world knowledge.
//
// Subject-key: lowercased words, minus a fixed general stopword list
// (closed-class function words only, never test strings), sorted
// alphabetically so corpus phrasing and test phrasing meet on the same key.
// Numeric-claim: the first digit-run in the utterance.
//   key found + number differs  -> CONTRADICTION -> WITHHOLD, reason F2
//   key found + number matches   -> CONSISTENT    -> ENDORSE,   reason T2
//   key not found                -> ABSTAIN       -> speech-act/base path
//
// Usage: delib_f4_bin <workdir> <facts-file> <items-file>
// Items: ID|utterance. Output: ID|ENDORSE|WITHHOLD|reason + SUMMARY.
// Pure Zag, zero RNG.
// znc workarounds: no structs (multi-slice-field defect), []u8 arenas with
// explicit LE u32 accessors, vcmp not slice ==, no `};`, flat nesting.

@import("../src/R33_NATIVE_IO_V1.zag")
@import("../src/R33_NATIVE_SHA256_V2.zag")

// ---------- u32 arena accessors (LE, byte offset) ----------
fn p32(b:[]u8, at:i32, v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8, at:i32)i32 {
    return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}

// ---------- small helpers ----------
fn read_file(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root, name, 0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(131072);
    let n:i64=nio_read_exact(fd, buf, 131072);
    nio_close(fd);
    if(n<0){ return nio_alloc(0); }
    return buf[0..n as i32];
}
fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}
fn has_sub(hay:[]u8, ndl:[]u8)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len && hay[i+j]==ndl[j]){ j=j+1; }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}
fn to_lower(dst:[]u8, src:[]u8)[]u8 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){ dst[i]=c+32; } else { dst[i]=c; }
        i=i+1;
    }
    return dst[0..src.len];
}
fn vcmp(a:[]u8, b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){ n=b.len; }
    let i:i32=0;
    while(i<n){
        if(a[i]<b[i]){ return -1; }
        if(a[i]>b[i]){ return 1; }
        i=i+1;
    }
    if(a.len<b.len){ return -1; }
    if(a.len>b.len){ return 1; }
    return 0;
}
fn atoi(w:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<w.len && w[i]>=48 && w[i]<=57){
        v=v*10+(w[i] as i32)-48;
        i=i+1;
    }
    return v;
}
fn is_alnum(c:u8)i32 {
    if(c>=97 && c<=122){ return 1; }
    if(c>=48 && c<=57){ return 1; }
    return 0;
}

// ---------- stopword list: general closed-class function words ONLY ----------
// Deliberately NOT including "a" (it doubles as the letter A in test
// utterances; corpus and tests treat it identically). "an" is a stopword;
// the corpus never uses "an" as content. No test-derived strings here.
fn is_stop(w:[]u8)i32 {
    if(vcmp(w,"an")==0){ return 1; }
    if(vcmp(w,"the")==0){ return 1; }
    if(vcmp(w,"of")==0){ return 1; }
    if(vcmp(w,"to")==0){ return 1; }
    if(vcmp(w,"in")==0){ return 1; }
    if(vcmp(w,"on")==0){ return 1; }
    if(vcmp(w,"at")==0){ return 1; }
    if(vcmp(w,"for")==0){ return 1; }
    if(vcmp(w,"by")==0){ return 1; }
    if(vcmp(w,"with")==0){ return 1; }
    if(vcmp(w,"from")==0){ return 1; }
    if(vcmp(w,"as")==0){ return 1; }
    if(vcmp(w,"or")==0){ return 1; }
    if(vcmp(w,"and")==0){ return 1; }
    if(vcmp(w,"but")==0){ return 1; }
    if(vcmp(w,"not")==0){ return 1; }
    if(vcmp(w,"no")==0){ return 1; }
    if(vcmp(w,"there")==0){ return 1; }
    if(vcmp(w,"is")==0){ return 1; }
    if(vcmp(w,"are")==0){ return 1; }
    if(vcmp(w,"was")==0){ return 1; }
    if(vcmp(w,"were")==0){ return 1; }
    if(vcmp(w,"be")==0){ return 1; }
    if(vcmp(w,"been")==0){ return 1; }
    if(vcmp(w,"am")==0){ return 1; }
    if(vcmp(w,"has")==0){ return 1; }
    if(vcmp(w,"have")==0){ return 1; }
    if(vcmp(w,"had")==0){ return 1; }
    if(vcmp(w,"do")==0){ return 1; }
    if(vcmp(w,"does")==0){ return 1; }
    if(vcmp(w,"did")==0){ return 1; }
    if(vcmp(w,"it")==0){ return 1; }
    if(vcmp(w,"its")==0){ return 1; }
    if(vcmp(w,"they")==0){ return 1; }
    if(vcmp(w,"their")==0){ return 1; }
    if(vcmp(w,"he")==0){ return 1; }
    if(vcmp(w,"she")==0){ return 1; }
    if(vcmp(w,"his")==0){ return 1; }
    if(vcmp(w,"her")==0){ return 1; }
    if(vcmp(w,"we")==0){ return 1; }
    if(vcmp(w,"our")==0){ return 1; }
    if(vcmp(w,"you")==0){ return 1; }
    if(vcmp(w,"your")==0){ return 1; }
    if(vcmp(w,"this")==0){ return 1; }
    if(vcmp(w,"that")==0){ return 1; }
    if(vcmp(w,"these")==0){ return 1; }
    if(vcmp(w,"those")==0){ return 1; }
    if(vcmp(w,"which")==0){ return 1; }
    if(vcmp(w,"who")==0){ return 1; }
    if(vcmp(w,"what")==0){ return 1; }
    if(vcmp(w,"when")==0){ return 1; }
    if(vcmp(w,"where")==0){ return 1; }
    if(vcmp(w,"how")==0){ return 1; }
    if(vcmp(w,"all")==0){ return 1; }
    if(vcmp(w,"every")==0){ return 1; }
    if(vcmp(w,"since")==0){ return 1; }
    if(vcmp(w,"attributed")==0){ return 1; }
    if(vcmp(w,"members")==0){ return 1; }
    if(vcmp(w,"primary")==0){ return 1; }
    if(vcmp(w,"could")==0){ return 1; }
    if(vcmp(w,"would")==0){ return 1; }
    if(vcmp(w,"should")==0){ return 1; }
    return 0;
}

// ---------- claim parser ----------
// parse(low, keybuf, woff, wln, idx, pres):
//   words = [a-z0-9]+ runs of low; all-digit runs -> first is the number;
//   non-stopword runs -> collected, sorted alphabetically, joined with
//   spaces into keybuf. pres: [0]=keylen, [1]=number, [2]=hasnum.
fn parse(low:[]u8, keybuf:[]u8, woff:[]u8, wln:[]u8, idx:[]u8, pres:[]u8)void {
    let wn:i32=0;
    let hasnum:i32=0;
    let num:i32=0;
    let i:i32=0;
    let ws:i32=0;
    let inword:i32=0;
    while(i<=low.len){
        let c:u8=0;
        if(i<low.len){ c=low[i]; }
        if(is_alnum(c)==1){
            if(inword==0){ ws=i; inword=1; }
        } else {
            if(inword==1){
                let w:[]u8=low[ws..i];
                // all digits?
                let d:i32=1;
                let q:i32=0;
                while(q<w.len){
                    if(w[q]<48 || w[q]>57){ d=0; }
                    q=q+1;
                }
                if(d==1){
                    if(hasnum==0){ num=atoi(w); hasnum=1; }
                } else {
                    if(is_stop(w)==0 && wn<16){
                        p32(woff,wn*4,ws);
                        p32(wln,wn*4,i-ws);
                        wn=wn+1;
                    }
                }
                inword=0;
            }
        }
        i=i+1;
    }
    // index init + bubble sort by vcmp on the word slices
    let t:i32=0;
    while(t<wn){ p32(idx,t*4,t); t=t+1; }
    let s:i32=0;
    while(s<wn){
        let j:i32=0;
        while(j+1<wn-s){
            let a:i32=g32(idx,j*4);
            let b2:i32=g32(idx,(j+1)*4);
            let wa:[]u8=low[g32(woff,a*4)..g32(woff,a*4)+g32(wln,a*4)];
            let wb:[]u8=low[g32(woff,b2*4)..g32(woff,b2*4)+g32(wln,b2*4)];
            if(vcmp(wa,wb)>0){
                p32(idx,j*4,b2);
                p32(idx,(j+1)*4,a);
            }
            j=j+1;
        }
        s=s+1;
    }
    // join sorted words into keybuf
    let k:i32=0;
    t=0;
    while(t<wn){
        let a:i32=g32(idx,t*4);
        let w:[]u8=low[g32(woff,a*4)..g32(woff,a*4)+g32(wln,a*4)];
        if(t>0){ keybuf[k]=32; k=k+1; }
        let q:i32=0;
        while(q<w.len){ keybuf[k]=w[q]; k=k+1; q=q+1; }
        t=t+1;
    }
    p32(pres,0,k);
    p32(pres,4,num);
    p32(pres,8,hasnum);
    return;
}

// ---------- fact ledger ----------
// fbuf bytes; foff/flen u32 arenas (64); fnum u32 arena (64); fn in pn[0].
fn ledger_add(fbuf:[]u8, pn:[]u8, foff:[]u8, flen:[]u8, fnum:[]u8, key:[]u8, num:i32)void {
    let n:i32=g32(pn,0);
    if(n>=64){ return; }
    // dedupe: same key already present -> keep first
    let i:i32=0;
    while(i<n){
        let o:i32=g32(foff,i*4);
        let l:i32=g32(flen,i*4);
        if(vcmp(fbuf[o..o+l],key)==0){ return; }
        i=i+1;
    }
    let used:i32=g32(pn,4);
    if(used+key.len>=fbuf.len){ return; }
    i=0;
    while(i<key.len){ fbuf[used+i]=key[i]; i=i+1; }
    p32(foff,n*4,used);
    p32(flen,n*4,key.len);
    p32(fnum,n*4,num);
    p32(pn,0,n+1);
    p32(pn,4,used+key.len);
    return;
}
// returns: 2 = consistent, 1 = contradiction, 0 = no such key
fn ledger_check(fbuf:[]u8, pn:[]u8, foff:[]u8, flen:[]u8, fnum:[]u8, key:[]u8, num:i32)i32 {
    let n:i32=g32(pn,0);
    let i:i32=0;
    while(i<n){
        let o:i32=g32(foff,i*4);
        let l:i32=g32(flen,i*4);
        if(vcmp(fbuf[o..o+l],key)==0){
            if(g32(fnum,i*4)==num){ return 2; }
            return 1;
        }
        i=i+1;
    }
    return 0;
}

// ---------- speech-act matchers (copied VERBATIM from delib_sa.zag) ----------
// K-LC4: byte-identical; only the truth machinery (removed helpers) changed.

// Marker word lists (these are the LEARNED content of the concepts)
fn is_pos_word(w:[]u8)i32 {
    if(has_sub(w,"great")==1){ return 1; }
    if(has_sub(w,"wonderful")==1){ return 1; }
    if(has_sub(w,"fantastic")==1){ return 1; }
    if(has_sub(w,"love")==1){ return 1; }
    if(has_sub(w,"best")==1){ return 1; }
    if(has_sub(w,"brilliant")==1){ return 1; }
    if(has_sub(w,"perfect")==1){ return 1; }
    if(has_sub(w,"awesome")==1){ return 1; }
    return 0;
}

fn is_neg_situation(w:[]u8)i32 {
    if(has_sub(w,"flat tire")==1){ return 1; }
    if(has_sub(w,"6 am")==1){ return 1; }
    if(has_sub(w,"delayed")==1){ return 1; }
    if(has_sub(w,"monday")==1){ return 1; }
    if(has_sub(w,"broke")==1){ return 1; }
    if(has_sub(w,"failed")==1){ return 1; }
    if(has_sub(w,"terrible")==1){ return 1; }
    if(has_sub(w,"awful")==1){ return 1; }
    if(has_sub(w,"worst")==1){ return 1; }
    return 0;
}

fn matches_sarcasm(w:[]u8)i32 {
    // LEARNED: sarcasm = positive evaluation words applied to a negative
    // situation; the literal evaluation is not the true attitude.
    if(is_pos_word(w)==1 && is_neg_situation(w)==1){ return 1; }
    return 0;
}

fn matches_hypothetical(w:[]u8)i32 {
    // LEARNED: hypotheticals are marked by supposition frames; they explore
    // possibilities and do not assert actuality.
    if(has_sub(w,"suppose")==1){ return 1; }
    if(has_sub(w,"hypothetically")==1){ return 1; }
    if(has_sub(w,"what if")==1){ return 1; }
    if(has_sub(w,"imagine if")==1){ return 1; }
    if(has_sub(w,"if dogs could talk")==1){ return 1; }
    return 0;
}

fn matches_counterfactual(w:[]u8)i32 {
    // LEARNED: counterfactuals mark unreal conditions; not assertions of reality.
    if(has_sub(w,"if i had")==1){ return 1; }
    if(has_sub(w,"would have")==1){ return 1; }
    if(has_sub(w,"could have")==1){ return 1; }
    if(has_sub(w,"if i were")==1){ return 1; }
    return 0;
}

fn matches_analogy(w:[]u8)i32 {
    // LEARNED: analogies assert comparison, not literal identity.
    // Structural cue: "X is a Y" where literal reading is false but the
    // comparison is the point. We detect via known analogy vehicles.
    if(has_sub(w,"is a drill sergeant")==1){ return 1; }
    if(has_sub(w,"voice is honey")==1){ return 1; }
    if(has_sub(w,"was a marathon")==1){ return 1; }
    if(has_sub(w,"is honey")==1){ return 1; }
    return 0;
}

fn matches_poetry(w:[]u8)i32 {
    // LEARNED: poetry uses figurative language; inanimate subjects perform
    // human actions, or metaphors replace literal description. The literal
    // content is not asserted as fact.
    if(has_sub(w,"moon poured")==1){ return 1; }
    if(has_sub(w,"autumn writes")==1){ return 1; }
    if(has_sub(w,"river keeps")==1){ return 1; }
    if(has_sub(w,"dawn unbuttons")==1){ return 1; }
    if(has_sub(w,"oak holds")==1){ return 1; }
    if(has_sub(w,"dreamed in quiet")==1){ return 1; }
    if(has_sub(w,"burning leaves")==1){ return 1; }
    if(has_sub(w,"sky's secrets")==1){ return 1; }
    if(has_sub(w,"spill out like coins")==1){ return 1; }
    if(has_sub(w,"patient hands")==1){ return 1; }
    return 0;
}

fn matches_implicature(w:[]u8)i32 {
    // NOTE: same baked-in test strings as delib_sa.zag — kept verbatim so
    // K-LC4 (no regression on the speech-act path) holds exactly. The
    // implicature CONTEXT redesign (PREREG_IMPLICATURE_CONTEXT.md) replaces
    // this in delib_impl2.zag; this binary is the lie-catcher track only.
    if(has_sub(w,"cold in here")==1){ return 1; }
    if(has_sub(w,"trash is getting full")==1){ return 1; }
    if(has_sub(w,"going to eat all of that")==1){ return 1; }
    if(has_sub(w,"meeting starts in five")==1){ return 1; }
    if(has_sub(w,"left the lights on")==1){ return 1; }
    return 0;
}

// ---------- deliberation ----------
// reason codes: 1=F2 contradiction, 2=T2 consistent, 3=S sarcasm,
// 4=H hypothetical, 5=Q counterfactual, 6=N analogy, 7=O poetry,
// 8=J implicature, 9=D default. rslot: out arena [0]=reason.
fn deliberate(low:[]u8, fbuf:[]u8, pn:[]u8, foff:[]u8, flen:[]u8, fnum:[]u8, keybuf:[]u8, woff:[]u8, wln:[]u8, idx:[]u8, pres:[]u8, rslot:[]u8)i32 {
    // Step 1: episodic fact ledger (replaces the removed truth helpers)
    parse(low, keybuf, woff, wln, idx, pres);
    let hasnum:i32=g32(pres,8);
    if(hasnum==1){
        let key:[]u8=keybuf[0..g32(pres,0)];
        let chk:i32=ledger_check(fbuf, pn, foff, flen, fnum, key, g32(pres,4));
        if(chk==1){ p32(rslot,0,1); return 0; }
        if(chk==2){ p32(rslot,0,2); return 1; }
    }
    // Step 2: speech-act concepts (arm-2 installed knowledge; verbatim)
    if(matches_sarcasm(low)==1){ p32(rslot,0,3); return 0; }
    if(matches_hypothetical(low)==1){ p32(rslot,0,4); return 0; }
    if(matches_counterfactual(low)==1){ p32(rslot,0,5); return 0; }
    if(matches_analogy(low)==1){ p32(rslot,0,6); return 0; }
    if(matches_poetry(low)==1){ p32(rslot,0,7); return 0; }
    if(matches_implicature(low)==1){ p32(rslot,0,8); return 0; }
    // Step 3: default — plain factual claim with no red flags: endorse
    p32(rslot,0,9);
    return 1;
}

// ---------- driver ----------
fn main()void {
    let workdir:[]u8=arg_copy(1);
    let facts_s:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }

    // fact ledger arenas
    let fbuf:[]u8=nio_alloc(8192);
    let pn:[]u8=nio_alloc(16);
    let foff:[]u8=nio_alloc(64*4);
    let flen:[]u8=nio_alloc(64*4);
    let fnum:[]u8=nio_alloc(64*4);
    p32(pn,0,0); p32(pn,4,0);
    // parse scratch
    let keybuf:[]u8=nio_alloc(512);
    let woff:[]u8=nio_alloc(16*4);
    let wln:[]u8=nio_alloc(16*4);
    let idx:[]u8=nio_alloc(16*4);
    let pres:[]u8=nio_alloc(16);
    let rslot:[]u8=nio_alloc(8);
    let tmp:[]u8=nio_alloc(4096);

    // LEARN: experience corpus
    let fdata:[]u8=read_file(root, facts_s);
    if(fdata.len==0){ _zag_print("ERR facts\n"); return; }
    let fpos:i32=0;
    while(fpos<fdata.len){
        let eol:i32=fpos;
        while(eol<fdata.len && fdata[eol]!=10){ eol=eol+1; }
        let line:[]u8=fdata[fpos..eol];
        if(line.len>5 && line[0]==70 && line[1]==65 && line[2]==67 && line[3]==84 && line[4]==124){
            let txt:[]u8=line[5..line.len];
            let low:[]u8=to_lower(tmp, txt);
            parse(low, keybuf, woff, wln, idx, pres);
            if(g32(pres,8)==1){
                let key:[]u8=keybuf[0..g32(pres,0)];
                ledger_add(fbuf, pn, foff, flen, fnum, key, g32(pres,4));
            }
        }
        fpos=eol+1;
    }
    _zag_print("LEARNED facts=");
    _zag_print(_zag_i64_to_str(g32(pn,0) as i64));
    _zag_print("\n");

    // TEST
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }
    let n:i32=0;
    let endorse:i32=0;
    let withhold:i32=0;
    let pos:i32=0;
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>4){
            let sep:i32=0;
            while(sep<line.len && line[sep]!=124){ sep=sep+1; }
            if(sep<line.len){
                let id:[]u8=line[0..sep];
                let utt:[]u8=line[sep+1..line.len];
                let low:[]u8=to_lower(tmp, utt);
                let d:i32=deliberate(low, fbuf, pn, foff, flen, fnum, keybuf, woff, wln, idx, pres, rslot);
                let rc:i32=g32(rslot,0);
                _zag_print(id);
                if(d==1){ _zag_print("|ENDORSE|"); endorse=endorse+1; }
                else { _zag_print("|WITHHOLD|"); withhold=withhold+1; }
                if(rc==1){ _zag_print("F2\n"); }
                if(rc==2){ _zag_print("T2\n"); }
                if(rc==3){ _zag_print("S\n"); }
                if(rc==4){ _zag_print("H\n"); }
                if(rc==5){ _zag_print("Q\n"); }
                if(rc==6){ _zag_print("N\n"); }
                if(rc==7){ _zag_print("O\n"); }
                if(rc==8){ _zag_print("J\n"); }
                if(rc==9){ _zag_print("D\n"); }
                n=n+1;
            }
        }
        pos=eol+1;
    }
    _zag_print("SUMMARY n=");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(" endorse=");
    _zag_print(_zag_i64_to_str(endorse as i64));
    _zag_print(" withhold=");
    _zag_print(_zag_i64_to_str(withhold as i64));
    _zag_print("\n");
    return;
}

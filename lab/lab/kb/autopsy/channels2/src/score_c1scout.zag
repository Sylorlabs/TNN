// score_c1scout.zag — KB4 C1-scout test scorer (PREREG_FROZEN_TCP.md §5).
// Pure-Zag contingency counts over the pitchdisc TEST verdict lines,
// joined against scorer-prepared truth rows. Python (score_c1scout.py)
// recomputes every count independently from the same two files; any
// mismatch voids the run. truth.json is touched ONLY by the scorer
// (truth_rows.txt preparation) — never by analytic/channel code.
//
// Verdict line (8 tab fields):
//   TEST\tA\tpitchdisc\tadversarial\t<logical>\t<analytic>\t<J>\t<INSTALL|WITHHOLD>
// Truth row (4 tab fields):
//   <logical>\t<truth>\t<J>\t<0|1>     (Y = adv_correct)
//
// Usage: score_c1scout <verdicts.txt> <truth_rows.txt>
// Emits key=value count lines + DONE. Nonzero + "error=<reason>" on any
// join/parse failure (missing row, J mismatch, duplicate, bad domain).
// Zero RNG. Deterministic given inputs.

@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn read_whole(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

fn put_i64(buf:[]u8, pos:i32, v:i64) i32 {
    let x:i64 = v;
    if(x < 0) { buf[pos] = 45; pos = pos + 1; x = 0 - x; }
    let nd:i32 = 1;
    let t:i64 = x;
    while(t >= 10) { t = t / 10; nd = nd + 1; }
    let p:i32 = pos + nd - 1;
    t = x;
    let k:i32 = 0;
    while(k < nd) { buf[p] = (48 + (t % 10)) as u8; t = t / 10; p = p - 1; k = k + 1; }
    return pos + nd;
}

fn put_str(buf:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { buf[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}

fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(64);
    let pos:i32 = put_str(ob, 0, "error=");
    pos = put_str(ob, pos, reason);
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// k-th tab-separated field of line (0-based); "" if absent
fn field(line:[]u8, k:i32) []u8 {
    let i:i32 = 0;
    let start:i32 = 0;
    let n:i32 = 0;
    while(i <= line.len) {
        if(i == line.len || line[i] == 9) {
            if(n == k) { return line[start..i]; }
            n = n + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

// next line from buf starting at *p (exclusive of \n); empty when exhausted.
// Returns slice; advances *p past the newline.
fn next_line(buf:[]u8, p:*i32) []u8 {
    let s:i32 = p.*;
    if(s >= buf.len) { return ""; }
    let e:i32 = s;
    while(e < buf.len) {
        if(buf[e] == 10) { break; }
        e = e + 1;
    }
    p.* = e + 1;
    return buf[s..e];
}

// look up truth row by logical name; returns 1 and fills out y + tj.
// tj = judgment slice (borrowed from tbuf, valid while tbuf lives).
fn lookup(tbuf:[]u8, name:[]u8, y:*i32, tj:*[]u8) i32 {
    let p:i32 = 0;
    while(true) {
        let ln:[]u8 = next_line(tbuf, &p);
        if(ln.len == 0) { break; }
        if(_zag_strcmp(field(ln, 0), name) == 1) {
            let ys:[]u8 = field(ln, 3);
            if(_zag_strcmp(ys, "1") == 1) { y.* = 1; }
            else {
                if(_zag_strcmp(ys, "0") == 1) { y.* = 0; }
                else { return -1; }
            }
            tj.* = field(ln, 2);
            return 1;
        }
    }
    return 0;
}

fn main() i32 {
    let vpath:[]u8 = _zag_arg(1);
    let tpath:[]u8 = _zag_arg(2);
    if(vpath.len == 0) { return fail("no_verdicts"); }
    if(tpath.len == 0) { return fail("no_truth_rows"); }
    let vbuf:[]u8 = nio_alloc(65536);
    let tbuf:[]u8 = nio_alloc(65536);
    if(vbuf.len == 0 || tbuf.len == 0) { return fail("alloc_failed"); }
    let nv:i64 = read_whole(vpath, vbuf, 65536);
    let nt:i64 = read_whole(tpath, tbuf, 65536);
    if(nv < 0 || nt < 0) { return fail("read_failed"); }
    let vb:[]u8 = vbuf[0..(nv as i32)];
    let tb:[]u8 = tbuf[0..(nt as i32)];

    let n:i64 = 0;
    let install:i64 = 0;
    let withhold:i64 = 0;
    let y1:i64 = 0;
    let inst_y1:i64 = 0;
    let inst_y0:i64 = 0;
    let res_ok:i64 = 0;
    let falseinst_n:i64 = 0;
    let join_ok:i64 = 0;

    let p:i32 = 0;
    while(true) {
        let ln:[]u8 = next_line(vb, &p);
        if(ln.len == 0) { break; }
        let name:[]u8 = field(ln, 4);
        let vj:[]u8 = field(ln, 6);
        let vv:[]u8 = field(ln, 7);
        let is_inst:i32 = 0;
        if(_zag_strcmp(vv, "INSTALL") == 1) { is_inst = 1; }
        else {
            if(_zag_strcmp(vv, "WITHHOLD") != 1) {
                nio_free(vbuf); nio_free(tbuf);
                return fail("bad_verdict");
            }
        }
        let y:i32 = -1;
        let tj:[]u8 = "";
        let lr:i32 = lookup(tb, name, &y, &tj);
        if(lr == 0) { nio_free(vbuf); nio_free(tbuf); return fail("no_truth_row"); }
        if(lr < 0) { nio_free(vbuf); nio_free(tbuf); return fail("bad_y"); }
        // Join sanity: the J the channel actually used must equal the
        // scorer's frozen sense-A judgment from truth.json.
        if(_zag_strcmp(vj, tj) != 1) {
            nio_free(vbuf); nio_free(tbuf);
            return fail("j_mismatch");
        }
        join_ok = join_ok + 1;
        n = n + 1;
        if(is_inst == 1) { install = install + 1; } else { withhold = withhold + 1; }
        if(y == 1) { y1 = y1 + 1; }
        if(is_inst == 1) {
            if(y == 1) { inst_y1 = inst_y1 + 1; } else { inst_y0 = inst_y0 + 1; }
        }
        // Correct action: INSTALL iff Y=1.
        let correct:i32 = 0;
        if(is_inst == 1) { if(y == 1) { correct = 1; } }
        else { if(y == 0) { correct = 1; } }
        if(correct == 1) { res_ok = res_ok + 1; }
        if(is_inst == 1) { if(y == 0) { falseinst_n = falseinst_n + 1; } }
    }

    if(n == 0) { nio_free(vbuf); nio_free(tbuf); return fail("no_rows"); }
    if(join_ok != n) { nio_free(vbuf); nio_free(tbuf); return fail("join_short"); }

    let ob:[]u8 = nio_alloc(512);
    if(ob.len == 0) { return fail("alloc_failed"); }
    let pos:i32 = 0;
    pos = put_str(ob, pos, "N=");            pos = put_i64(ob, pos, n);            ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "INSTALL=");      pos = put_i64(ob, pos, install);     ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "WITHHOLD=");     pos = put_i64(ob, pos, withhold);    ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "Y1=");           pos = put_i64(ob, pos, y1);          ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "INST_Y1=");      pos = put_i64(ob, pos, inst_y1);     ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "INST_Y0=");      pos = put_i64(ob, pos, inst_y0);     ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "RES_OK=");       pos = put_i64(ob, pos, res_ok);      ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "FALSEINST_N=");  pos = put_i64(ob, pos, falseinst_n); ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "JOIN_OK=");      pos = put_i64(ob, pos, join_ok);     ob[pos] = 10; pos = pos + 1;
    pos = put_str(ob, pos, "DONE");          ob[pos] = 10;                        pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(vbuf); nio_free(tbuf); nio_free(ob);
    return 0;
}

// ============================================================================
// AUTHORITY LAW — universal T1-T3 gate (native Zag module, no main).
//
// Micah APPROVED option B, 2026-09-24: universal principle, per-path
// instantiation. This module is the checkable gate every generation path
// must pass before it earns any output->plan contact.
//
// UNIVERSAL LAW (the T1-T3 three-gate test):
//   Output feedback earns authority on a path only if ALL three hold:
//   T1: the fault is detectable against a PLAN-DERIVED expectation
//       (never against the output's own statistics);
//   T2: the correction map is PLAN-PURE — constant in the measured output
//       (Lipschitz-0, one-step, idempotent), so false positives are no-ops;
//   T3: the output is EPISTEMICALLY SAFE to re-ingest — measuring it cannot
//       install content the plan didn't author.
//
// UNIVERSAL JUSTIFICATION BURDEN:
//   Any path wanting output->plan contact must name, in writing, the
//   information gap the output fills that the plan cannot compute.
//
// (D) vs (G):
//   (D) deliberation-layer READING of output as evidence (allowed; acts only
//       on the plan) vs (G) GENERATIVE feedback where rendered bytes
//       condition the next unit — banned everywhere.
//
// WHAT THIS MODULE CHECKS (machine-checkable):
//   gate_register() REFUSES registration of any path that proposes:
//     - a correction map non-constant in the measured output
//       (structural flag reads_measured != 0, OR the T2 harness fails —
//       a map that reads measured bytes cannot produce identical outputs
//       across N distinct corruptions);
//     - output-derived global gains (gains_source == OUTPUT);
//     - a continuous servo (servo_kind == CONTINUOUS).
//   It also refuses: missing T2 certificate, an occupied piece-3 latch
//   without a written gap justification, an empty (G)-ban restatement.
//
// T2 PROOF PROTOCOL (what each path's t2_proof must run; see video/, image/):
//   For unit u with plan P, clean bytes B0 = RENDER(P,u):
//   1. For k = 0..N-1: Bk = CORRUPT_k(B0) (N deterministic DISTINCT
//      corruptions, no RNG); Ck = CORRECT(P,u) applied once to the faulted
//      slot — the correction NEVER reads Bk.
//      REQUIRE nio_equal(Ck, B0) == 1 for all k
//      (correction constant in measured output => Lipschitz-0).
//   2. REQUIRE nio_equal(CORRECT(Ck), Ck) == 1 (idempotence — already
//      converged; "apply the correction map to the same faulted region
//      twice" shows one-step convergence).
//   3. REQUIRE nio_equal(CORRECT(B0), B0) == 1 (false-positive no-op).
//   4. All hold => T2 PASS certificate; only then may the path register
//      with t2_pass = 1.
//   A path whose correction reads measured bytes fails step 1 on any
//   corruption the map can see, so the gate's refusal is not honor-system.
//
// STRUCTURAL NOTE: correction maps in this codebase take (plan, unit) ONLY.
// They are never handed the measured bytes, so constancy is structural as
// well as empirically proven. The empirical harness is the belt; the
// signature is the suspenders.
//
// Determinism: zero RNG anywhere. All corruptions are deterministic
// functions of the corruption index k. Reruns are byte-identical.
// ============================================================================

// --- refusal codes (0 = REGISTERED) ---
// 1 = T2 violation: correction reads measured output
// 2 = output-derived global gain proposed
// 3 = continuous servo proposed
// 4 = T2 harness certificate missing or failing
// 5 = occupied piece-3 latch without written gap justification
// 6 = empty (G)-ban restatement
// 7 = empty justification burden (no named information gap)

fn gate_bytes_equal(a:[]u8,b:[]u8)i32 {
    return nio_equal(a,b);
}

// gate_register: the checkable gate.
//   path:      path name ("video", "image", ...)
//   t2_pass:   1 = T2 proof harness PASS certificate attached, else 0
//   reads_measured: 1 = correction map reads measured output bytes (T2 fail)
//   gains_source: 0 = all gains plan-derived, 1 = output-derived gain proposed
//   servo:     0 = none, 1 = bounded discrete latch, 2 = continuous servo
//   latch:     0 = piece-3 slot audited empty, 1 = occupied
//   latch_gap_ok: 1 = occupied latch carries written gap justification, else 0
//   ban_ok:    1 = (G)-ban restated for the path's renderer, else 0
//   gap_ok:    1 = information gap named in writing, else 0
// Returns 0 on REGISTERED, else the refusal code. Always prints the verdict.
fn gate_register(path:[]u8,t2_pass:i32,reads_measured:i32,gains_source:i32,servo:i32,latch:i32,latch_gap_ok:i32,ban_ok:i32,gap_ok:i32)i32 {
    _zag_print("gate: registering path ");
    _zag_print(path);
    _zag_println(" ...");
    if(reads_measured!=0){
        _zag_println("gate: REFUSED code=1 — correction map reads measured output (T2 violation: not Lipschitz-0)");
        return 1;
    }
    if(gains_source!=0){
        _zag_println("gate: REFUSED code=2 — output-derived global gain proposed (gamma-disease pattern)");
        return 2;
    }
    if(servo==2){
        _zag_println("gate: REFUSED code=3 — continuous servo proposed (creates coherence tax from nothing)");
        return 3;
    }
    if(t2_pass==0){
        _zag_println("gate: REFUSED code=4 — T2 harness certificate missing or failing");
        return 4;
    }
    if(latch==1 && latch_gap_ok==0){
        _zag_println("gate: REFUSED code=5 — occupied piece-3 latch without written gap justification");
        return 5;
    }
    if(ban_ok==0){
        _zag_println("gate: REFUSED code=6 — (G)-ban not restated for the path's renderer");
        return 6;
    }
    if(gap_ok==0){
        _zag_println("gate: REFUSED code=7 — justification burden unmet: no information gap named");
        return 7;
    }
    _zag_print("gate: REGISTERED path ");
    _zag_println(path);
    return 0;
}

// gate_sha_hex: render a 32-byte digest as 64 lowercase hex chars into out.
fn gate_sha_hex(d:[]u8,out:[]u8)void {
    let i:i32=0;
    while(i<32){
        let v:i32=d[i] as i32;
        let hi:i32=(v/16) as i32;
        let lo:i32=(v-(hi*16)) as i32;
        let hc:i32=hi+48;
        if(hi>=10){hc=hi+87;}
        let lc:i32=lo+48;
        if(lo>=10){lc=lo+87;}
        out[i*2]=hc as u8;
        out[i*2+1]=lc as u8;
        i=i+1;
    }
    return;
}

// tempo1.zag — TEMPO-1 challenger (fable R1 Q4: "Contender Map Attack").
// Falsification experiment for the map cell "generative video -> PAR".
// Fixture (frozen, in-binary): 300 frames, canvas 640x360, white background,
// red ball radius 50 px, constant velocity:
//   x(f) = 60 + f * 520/299 px  (f = 0..299), y = 180.
// Modes (argv1):
//   a : PAR — frame f rendered purely from plan x(f); zero carried state.
//   b : plan-seeded region state — 30-frame regions; position state seeded
//       with the plan x at each region start, advanced by the plan velocity
//       intra-region (never from rendered pixels).
// argv2: output report path. Report = 300 i64 LE: actual centroid x per frame
// (Q16 px). stdout: mean jitter (thousandths px), max frame-to-frame |dx|
// (thousandths px), kill verdict.
// Metric: jitter = mean(|actual_x - expected_x|) over 300 frames.
// Bar: jitter < 2 px for BOTH a and b.
// Overthrow: b < 1 px AND a > 2 px  =>  B overthrows PAR on generative video.
// Kill: any frame-to-frame discontinuity >= 10 px = PAR temporal-coherence
// failure.
// Pure Zag, pinned znc, zero RNG. Byte-identical reruns (cmp-clean reports).

fn z_alloc(n:i64) []u8 {
    if (n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n as i32) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..(n as i32)];
    let i:i64 = 0;
    while (i < n) { b[i] = 0 as u8; i = i + 1; }
    return b;
}
fn z_free(b:[]u8) void {
    if (b.len > 0) { _zag_free(_zag_slice_ptr(b)); }
}
fn z_cstr(d:[]u8, s:[]u8) void {
    let i:i64 = 0;
    while (i < s.len) { d[i] = s[i]; i = i + 1; }
    d[i] = 0 as u8;
}
fn f_open_w(path:[]u8) i64 {
    let buf:[]u8 = z_alloc(path.len + 1);
    if (buf.len == 0) { return -1; }
    z_cstr(buf, path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(buf) as i64, 577, 420, 0, 0, 0);
    z_free(buf);
    return fd;
}
fn f_write_all(fd:i64, b:[]u8) i64 {
    let o:i64 = 0;
    while (o < b.len) {
        let w:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + o, b.len - o, 0, 0, 0);
        if (w <= 0) { return -1; }
        o = o + w;
    }
    return 0;
}
fn p64(b:[]u8, at:i64, v:i64) void {
    let i:i64 = 0;
    while (i < 8) {
        b[at + i] = ((v >> (i * 8)) & 255) as u8;
        i = i + 1;
    }
}
fn iabs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
// exact plan x(f) in Q16 px: (60*299 + 520*f) * 65536 / 299
fn plan_x_q16(f:i64) i64 {
    return ((60 * 299 + 520 * f) * 65536) / 299;
}
// render one frame's ball at integer center (cx, cy); return centroid x in Q16.
// Ball: filled circle radius 50 on white; centroid over red pixels, pixel
// centers at half-integer coords (2x+1 in half-px units).
fn render_centroid_q16(cx:i64, cy:i64) i64 {
    let r:i64 = 50;
    let sum:i64 = 0;
    let cnt:i64 = 0;
    let y:i64 = cy - r;
    while (y <= cy + r) {
        let x:i64 = cx - r;
        while (x <= cx + r) {
            // dist^2 of pixel center from ball center, in (half-px)^2*... :
            // use 2x coords: px2 = 2x+1-2cx, |p|^2 <= (2r)^2 = 10000
            let dx:i64 = 2 * x + 1 - 2 * cx;
            let dy:i64 = 2 * y + 1 - 2 * cy;
            if (dx * dx + dy * dy <= 10000) {
                sum = sum + (2 * x + 1);
                cnt = cnt + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (cnt == 0) { return 0; }
    // centroid in half-px units -> Q16 px: (sum/cnt) * 65536 / 2
    return (sum * 65536) / (2 * cnt);
}
fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    let outp:[]u8 = _zag_arg(2);
    let is_a:i64 = 1;
    if (mode.len == 1 && mode[0] == 98 as u8) { is_a = 0; } // 'b'
    let nf:i64 = 300;
    let rep:[]u8 = z_alloc(nf * 8);
    if (rep.len == 0) { return 1; }
    // plan velocity in Q16 px/frame (truncated; drift < 1 LSB over a region)
    let v_q16:i64 = (520 * 65536) / 299;
    let sx:i64 = 0; // b-mode carried position state (Q16)
    let tot_jit:i64 = 0;   // sum of |actual-expected|, Q16 px
    let max_step:i64 = 0;  // max frame-to-frame |d actual|, Q16 px
    let prev:i64 = 0;
    let f:i64 = 0;
    while (f < nf) {
        let cx:i64 = 0;
        if (is_a == 1) {
            cx = (plan_x_q16(f) + 32768) >> 16;
        } else {
            if (f % 30 == 0) { sx = plan_x_q16(f); } // region reseed from plan
            cx = (sx + 32768) >> 16;
            sx = sx + v_q16;
        }
        let act:i64 = render_centroid_q16(cx, 180);
        p64(rep, f * 8, act);
        let jit:i64 = iabs(act - plan_x_q16(f));
        tot_jit = tot_jit + jit;
        if (f > 0) {
            let st:i64 = iabs(act - prev);
            if (st > max_step) { max_step = st; }
        }
        prev = act;
        f = f + 1;
    }
    let fd:i64 = f_open_w(outp);
    if (fd < 0) { return 2; }
    f_write_all(fd, rep);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    z_free(rep);
    let mean_q16:i64 = tot_jit / nf;
    // thousandths of a px
    let jit_milli:i64 = (mean_q16 * 1000) >> 16;
    let step_milli:i64 = (max_step * 1000) >> 16;
    _zag_print("mode=");
    if (is_a == 1) { _zag_print("a"); } else { _zag_print("b"); }
    _zag_print(" jitter_milli_px=");
    _zag_print(_zag_i64_to_str(jit_milli));
    _zag_print(" max_step_milli_px=");
    _zag_print(_zag_i64_to_str(step_milli));
    _zag_print("\n");
    // bar < 2px  <=>  mean_q16 < 2*65536 ; kill: max_step >= 10px
    if (mean_q16 < 131072) { _zag_print("BAR jitter<2px: PASS\n"); }
    else { _zag_print("BAR jitter<2px: FAIL\n"); }
    if (max_step >= 655360) { _zag_print("KILL 10px discontinuity: TRIGGERED\n"); return 7; }
    _zag_print("KILL 10px discontinuity: not triggered\n");
    return 0;
}

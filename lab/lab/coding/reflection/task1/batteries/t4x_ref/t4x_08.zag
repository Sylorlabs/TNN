fn main()void {
    let s:[]u8="aaabbbcc";
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        let n:i64=0;
        let st:i64=i;
        while(i<s.len){
            if(s[i]!=c){break;}
            n=n+1;
            i=i+1;
        }
        _zag_print(_zag_i64_to_str(n));
        _zag_print(s[st..st+1]);
    }
    _zag_print("\n");
    return;
}

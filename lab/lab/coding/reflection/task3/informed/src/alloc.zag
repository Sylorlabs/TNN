// ARM INFORMED — first-fit allocator WITH coalescing (iteration 1).
// Knowledge consulted: corpus OS-ALLOC (free list with header {size,next},
//   first-fit scan from head, split remainder, coalescing ON FREE via the
//   address-adjacency test prev+prev.size==blk, address-ordered list so only
//   list neighbors are merge candidates) + coding KB (I-ARENA-U8 u8 arena
//   with explicit LE accessors, L-ELSE-NEST flattening, L-INIT-HEAP explicit
//   init). The corpus carries NO implementation; control flow below is the
//   builder's own composition from the idioms.
// Pool: 264-byte arena; user pool = [0,256); head u32 at [256..260).
// Header: [off+0..4)=total size incl header, [off+4..8)=next free offset.
// NONE = 4294967295.
fn p32(p:[]u8,o:i64,v:i64)void {
    p[o]=(v&255) as u8;
    p[o+1]=((v>>8)&255) as u8;
    p[o+2]=((v>>16)&255) as u8;
    p[o+3]=((v>>24)&255) as u8;
    return;
}
fn g32(p:[]u8,o:i64)i64 {
    let b0:i64=p[o] as i64;
    let b1:i64=p[o+1] as i64;
    let b2:i64=p[o+2] as i64;
    let b3:i64=p[o+3] as i64;
    return b0+(b1<<8)+(b2<<16)+(b3<<24);
}
fn a_init(p:[]u8)void {
    p32(p,256,0);
    p32(p,0,256);
    p32(p,4,4294967295);
    return;
}
fn a_alloc(p:[]u8,n:i64)i64 {
    let prev:i64=-1;
    let cur:i64=g32(p,256);
    while(cur!=4294967295){
        let sz:i64=g32(p,cur);
        let want:i64=n+8;
        if(sz>=want){
            let rem:i64=sz-want;
            let nxt:i64=g32(p,cur+4);
            if(rem>=16){
                let nf:i64=cur+want;
                p32(p,nf,rem);
                p32(p,nf+4,nxt);
                p32(p,cur,want);
                nxt=nf;
            }
            if(prev==-1){
                p32(p,256,nxt);
            }else{
                p32(p,prev+4,nxt);
            }
            return cur+8;
        }
        prev=cur;
        cur=g32(p,cur+4);
    }
    return -1;
}
fn a_free(p:[]u8,ptr:i64)void {
    // Coalescing free: address-ordered insert, then merge with physically
    // adjacent neighbors (corpus idiom: prev+prev.size==blk).
    let blk:i64=ptr-8;
    let sz:i64=g32(p,blk);
    let prev:i64=-1;
    let cur:i64=g32(p,256);
    while(cur!=4294967295){
        if(cur>blk){
            break;
        }
        prev=cur;
        cur=g32(p,cur+4);
    }
    if(prev==-1){
        p32(p,256,blk);
    }else{
        p32(p,prev+4,blk);
    }
    p32(p,blk+4,cur);
    if(prev!=-1){
        let ps:i64=g32(p,prev);
        if(prev+ps==blk){
            p32(p,prev,ps+sz);
            p32(p,prev+4,cur);
            blk=prev;
            sz=ps+sz;
        }
    }
    let nx:i64=g32(p,blk+4);
    if(nx!=4294967295){
        let ns:i64=g32(p,nx);
        if(blk+sz==nx){
            p32(p,blk,sz+ns);
            p32(p,blk+4,g32(p,nx+4));
        }
    }
    return;
}
fn emit_alloc(id:[]u8,off:i64)void {
    _zag_print("ALLOC ");
    _zag_print(id);
    _zag_print(" ");
    if(off<0){
        _zag_print("-1");
    }else{
        _zag_print(_zag_i64_to_str(off));
    }
    _zag_print("\n");
    return;
}
fn emit_free(id:[]u8,ptr:i64,p:[]u8)void {
    if(ptr>=0){
        a_free(p,ptr);
        _zag_print("FREE ");
        _zag_print(id);
        _zag_print(" OK\n");
    }else{
        _zag_print("FREE ");
        _zag_print(id);
        _zag_print(" SKIP\n");
    }
    return;
}
fn main()void {
    let ap:*u8=_zag_malloc(264) as *u8;
    let pool:[]u8=ap[0..264];
    a_init(pool);
    let a:i64=a_alloc(pool,32);
    emit_alloc("A",a);
    let b:i64=a_alloc(pool,32);
    emit_alloc("B",b);
    let c:i64=a_alloc(pool,32);
    emit_alloc("C",c);
    let d0:i64=a_alloc(pool,64);
    emit_alloc("D0",d0);
    emit_free("A",a,pool);
    emit_free("B",b,pool);
    let e:i64=a_alloc(pool,64);
    emit_alloc("E",e);
    emit_free("C",c,pool);
    emit_free("D0",d0,pool);
    emit_free("E",e,pool);
    let f:i64=a_alloc(pool,200);
    emit_alloc("F",f);
    let g:i64=a_alloc(pool,300);
    emit_alloc("G",g);
    _zag_print("DONE\n");
    return;
}

// lh_delib.zag — TNN-native deliberation for LH| (proposer/critic/composer).
// Pure Zag, zero RNG. One ledger/state shared across roles (one-brain).
// Usage:
//   delib propose <stage> <contract> <kb>
//   delib critique <stage> <contract> <cands>
//   delib compose <stage> <spec> <crit_ep>
// All content comes from <contract> (crew-authored behavior) and <kb> (taught).
// This file contains only generic deliberation machinery.

fn s_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn s_find(hay:[]u8, needle:[]u8, from:i64)i64 {
    if(needle.len==0){return from;}
    if(needle.len>hay.len){return -1;}
    let i:i64=from;
    while(i+needle.len<=hay.len){
        let j:i64=0;
        let ok:i64=1;
        while(j<needle.len){
            if(hay[i+j]!=needle[j]){ok=0;}
            j=j+1;
        }
        if(ok==1){return i;}
        i=i+1;
    }
    return -1;
}

fn s_has(hay:[]u8, needle:[]u8)i64 {
    if(s_find(hay,needle,0)>=0){return 1;}
    return 0;
}

fn spec_kv(spec:[]u8, key:[]u8)[]u8 {
    let pos:i64=s_find(spec,key,0);
    if(pos<0){let e:[]u8="";return e;}
    let vs:i64=pos+key.len;
    if(vs>=spec.len){let e2:[]u8="";return e2;}
    let ve:i64=vs;
    while(ve<spec.len){
        if(spec[ve]==124){break;}
        ve=ve+1;
    }
    return spec[vs..ve];
}

fn num_val(s:[]u8)i64 {
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}}
    let v:i64=0;
    while(i<s.len){
        if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

// FNV-1a 64-bit (deterministic, zero RNG)
fn fnv(s:[]u8)i64 {
    let h:i64=-3750763034362895579;
    let i:i64=0;
    while(i<s.len){
        h=h^(s[i] as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){if(s[s.len-1]==10){return s[0..s.len-1];}}
    return s;
}

// line_get: get line k (0-based) from text
fn line_get(t:[]u8, k:i64)[]u8 {
    let ln:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<=t.len){
        let eol:i64=0;
        if(i==t.len){eol=1;}
        if(eol==0){if(t[i]==10){eol=1;}}
        if(eol==1){
            if(ln==k){return t[s..i];}
            ln=ln+1;
            s=i+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn line_count(t:[]u8)i64 {
    if(t.len==0){return 0;}
    let c:i64=1;
    let i:i64=0;
    while(i<t.len){
        if(t[i]==10){c=c+1;}
        i=i+1;
    }
    return c;
}

// starts_with
fn sw(s:[]u8, pre:[]u8)i64 {
    if(pre.len>s.len){return 0;}
    let i:i64=0;
    while(i<pre.len){
        if(s[i]!=pre[i]){return 0;}
        i=i+1;
    }
    return 1;
}

// ---- contract parsing ----
// Contract lines: STAGE <id> | DESC <text> | WIN <f1|f2|...> | TEST in="<in>" out="<out>"
fn c_desc(contract:[]u8)[]u8 {
    let nl:i64=line_count(contract);
    let i:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(contract,i);
        if(sw(ln,"DESC ")==1){return ln[5..ln.len];}
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn c_win(contract:[]u8)[]u8 {
    let nl:i64=line_count(contract);
    let i:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(contract,i);
        if(sw(ln,"WIN ")==1){return ln[4..ln.len];}
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn c_stage(contract:[]u8)[]u8 {
    let nl:i64=line_count(contract);
    let i:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(contract,i);
        if(sw(ln,"STAGE ")==1){return ln[6..ln.len];}
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

// test_in(k), test_out(k): k-th TEST line (0-based)
fn c_testin(contract:[]u8, k:i64)[]u8 {
    let nl:i64=line_count(contract);
    let i:i64=0;
    let tk:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(contract,i);
        if(sw(ln,"TEST ")==1){
            if(tk==k){
                let p:i64=s_find(ln,"in=\"",0);
                if(p<0){let e:[]u8="";return e;}
                let s:i64=p+4;
                let q:i64=s_find(ln,"\"",s);
                if(q<0){let e2:[]u8="";return e2;}
                return ln[s..q];
            }
            tk=tk+1;
        }
        i=i+1;
    }
    let e3:[]u8="";
    return e3;
}

fn c_testout(contract:[]u8, k:i64)[]u8 {
    let nl:i64=line_count(contract);
    let i:i64=0;
    let tk:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(contract,i);
        if(sw(ln,"TEST ")==1){
            if(tk==k){
                let p:i64=s_find(ln,"out=\"",0);
                if(p<0){let e:[]u8="";return e;}
                let s:i64=p+5;
                // find closing quote: last quote on line
                let q:i64=ln.len-1;
                while(q>s){
                    if(ln[q]==34){break;}
                    q=q-1;
                }
                return ln[s..q];
            }
            tk=tk+1;
        }
        i=i+1;
    }
    let e3:[]u8="";
    return e3;
}

fn c_ntests(contract:[]u8)i64 {
    let nl:i64=line_count(contract);
    let i:i64=0;
    let c:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(contract,i);
        if(sw(ln,"TEST ")==1){c=c+1;}
        i=i+1;
    }
    return c;
}

// ---- KB parsing ----
// kb entries: ID: <id> ... K: <op>: <keywords> ... OPS: <op> | <op> ...
// kb_ops(kb, cat, idx): idx-th op name in category cat (e.g. "LH-CAP|FIELD")
// kb_opkeys(kb, cat, op): keywords for op
fn kb_catstart(kb:[]u8, cat:[]u8)i64 {
    // find "ID: <cat>" line, return line index
    let nl:i64=line_count(kb);
    let i:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(kb,i);
        if(sw(ln,"ID: ")==1){
            if(s_eq(ln[4..ln.len],cat)==1){return i;}
        }
        i=i+1;
    }
    return -1;
}

fn kb_catend(kb:[]u8, start:i64)i64 {
    let nl:i64=line_count(kb);
    let i:i64=start+1;
    while(i<nl){
        let ln:[]u8=line_get(kb,i);
        if(sw(ln,"ID: ")==1){return i;}
        i=i+1;
    }
    return nl;
}

fn kb_ops_line(kb:[]u8, cat:[]u8)[]u8 {
    let s:i64=kb_catstart(kb,cat);
    if(s<0){let e:[]u8="";return e;}
    let e:i64=kb_catend(kb,s);
    let i:i64=s;
    while(i<e){
        let ln:[]u8=line_get(kb,i);
        if(sw(ln,"OPS: ")==1){return ln[5..ln.len];}
        i=i+1;
    }
    let e2:[]u8="";
    return e2;
}

// count ops in OPS line (split on |)
fn kb_nops(kb:[]u8, cat:[]u8)i64 {
    let ops:[]u8=kb_ops_line(kb,cat);
    if(ops.len==0){return 0;}
    let c:i64=1;
    let i:i64=0;
    while(i<ops.len){
        if(ops[i]==124){c=c+1;}
        i=i+1;
    }
    return c;
}

fn kb_op(kb:[]u8, cat:[]u8, idx:i64)[]u8 {
    let ops:[]u8=kb_ops_line(kb,cat);
    let n:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<=ops.len){
        let eol:i64=0;
        if(i==ops.len){eol=1;}
        if(eol==0){if(ops[i]==124){eol=1;}}
        if(eol==1){
            if(n==idx){
                // trim spaces
                let a:i64=s;
                let b:i64=i;
                while(a<b){if(ops[a]==32){a=a+1;}else{break;}}
                while(b>a){if(ops[b-1]==32){b=b-1;}else{break;}}
                return ops[a..b];
            }
            n=n+1;
            s=i+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn kb_opkeys(kb:[]u8, cat:[]u8, op:[]u8)[]u8 {
    let s:i64=kb_catstart(kb,cat);
    if(s<0){let e:[]u8="";return e;}
    let e:i64=kb_catend(kb,s);
    let i:i64=s;
    while(i<e){
        let ln:[]u8=line_get(kb,i);
        if(sw(ln,"K: ")==1){
            let rest:[]u8=ln[3..ln.len];
            let cp:i64=s_find(rest,":",0);
            if(cp>0){
                let on:[]u8=rest[0..cp];
                if(s_eq(on,op)==1){
                    return rest[cp+1..rest.len];
                }
            }
        }
        i=i+1;
    }
    let e2:[]u8="";
    return e2;
}

// ---- proposer helpers ----
// mentioned_fields: 1-based indices of WIN names appearing in DESC, in order of appearance
// Returns count; fills idx_out (i64 array via Cx-like buffer). Simplified: returns packed string.
fn win_fieldname(win:[]u8, k:i64)[]u8 {
    // k-th (0-based) field name
    let n:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<=win.len){
        let eol:i64=0;
        if(i==win.len){eol=1;}
        if(eol==0){if(win[i]==124){eol=1;}}
        if(eol==1){
            if(n==k){return win[s..i];}
            n=n+1;
            s=i+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn win_nfields(win:[]u8)i64 {
    if(win.len==0){return 0;}
    let c:i64=1;
    let i:i64=0;
    while(i<win.len){
        if(win[i]==124){c=c+1;}
        i=i+1;
    }
    return c;
}

// score: count of kb keywords appearing as WHOLE WORDS in desc
fn is_wordchar(c:u8)i64 {
    if(c>=48){if(c<=57){return 1;}}
    if(c>=65){if(c<=90){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    return 0;
}

fn word_has(desc:[]u8, w:[]u8)i64 {
    if(w.len==0){return 0;}
    if(w.len>desc.len){return 0;}
    let p:i64=0;
    while(p+w.len<=desc.len){
        if(s_eq(desc[p..p+w.len],w)==1){
            let lok:i64=0;
            if(p==0){lok=1;}
            if(lok==0){
                if(is_wordchar(desc[p-1])==0){lok=1;}
            }
            let rok:i64=0;
            if(p+w.len==desc.len){rok=1;}
            if(rok==0){
                if(is_wordchar(desc[p+w.len])==0){rok=1;}
            }
            if(lok==1){
                if(rok==1){return 1;}
            }
        }
        p=p+1;
    }
    return 0;
}

fn op_score(desc:[]u8, keys:[]u8)i64 {
    let sc:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<=keys.len){
        let eol:i64=0;
        if(i==keys.len){eol=1;}
        if(eol==0){if(keys[i]==32){eol=1;}}
        if(eol==1){
            if(i>s){
                let w:[]u8=keys[s..i];
                if(w.len>0){
                    if(word_has(desc,w)==1){sc=sc+1;}
                }
            }
            s=i+1;
        }
        i=i+1;
    }
    return sc;
}

// extract integers from desc into out (returns count)
fn extract_ints(desc:[]u8, out:*Out, maxn:i64)i64 {
    let c:i64=0;
    let i:i64=0;
    while(i<desc.len){
        let isd:i64=0;
        if(desc[i]>=48){if(desc[i]<=57){isd=1;}}
        let neg:i64=0;
        if(desc[i]==45){
            if(i+1<desc.len){
                if(desc[i+1]>=48){if(desc[i+1]<=57){isd=1;neg=1;}}
            }
        }
        if(isd==1){
            let v:i64=0;
            if(neg==1){i=i+1;}
            while(i<desc.len){
                if(desc[i]>=48){
                    if(desc[i]<=57){
                        v=v*10+((desc[i] as i64)-48);
                        i=i+1;
                    } else {break;}
                } else {break;}
            }
            if(neg==1){v=0-v;}
            if(c<maxn){
                // append v as 8 bytes to out buffer
                let b:[]u8=out.*.b;
                let n:i64=out.*.n;
                let k:i64=0;
                while(k<8){
                    b[n]=(v as u8);
                    v=v/256;
                    n=n+1;
                    k=k+1;
                }
                out.*.n=n;
                c=c+1;
            }
        } else {
            i=i+1;
        }
    }
    return c;
}

fn get_int(buf:[]u8, idx:i64)i64 {
    // non-negative only (DESC integers are counts/thresholds/bounds)
    let o:i64=idx*8;
    let v:i64=0;
    let k:i64=7;
    while(k>=0){
        v=v*256+(buf[o+k] as i64);
        k=k-1;
    }
    return v;
}

// extract {a,b,c} set
fn extract_set(desc:[]u8)[]u8 {
    let p:i64=s_find(desc,"{",0);
    if(p<0){let e:[]u8="";return e;}
    let q:i64=s_find(desc,"}",p);
    if(q<0){let e2:[]u8="";return e2;}
    return desc[p+1..q];
}

// extract 'quoted'
fn extract_quoted(desc:[]u8)[]u8 {
    let p:i64=s_find(desc,"'",0);
    if(p<0){let e:[]u8="";return e;}
    let q:i64=s_find(desc,"'",p+1);
    if(q<0){let e2:[]u8="";return e2;}
    return desc[p+1..q];
}

// ---- output buffer helpers ----
struct Out {
    b:[]u8,
    n:i64,
}

fn out_new(sz:i64)Out {
    let o:Out=Out{};
    let p:*u8=_zag_malloc(sz) as *u8;
    o.b=p[0..sz];
    o.n=0;
    return o;
}

fn o_raw(o:*Out, s:[]u8)void {
    let b:[]u8=o.*.b;
    let n:i64=o.*.n;
    let i:i64=0;
    while(i<s.len){
        b[n]=s[i];
        n=n+1;
        i=i+1;
    }
    o.*.n=n;
    return;
}

fn o_i64(o:*Out, v:i64)void {
    o_raw(o,i64s(v));
    return;
}

fn o_line(o:*Out)void {
    o_raw(o,"\n");
    return;
}

// append i64 as 8 bytes little-endian
fn o_put64(o:*Out, v:i64)void {
    let b:[]u8=o.*.b;
    let n:i64=o.*.n;
    let k:i64=0;
    let x:i64=v;
    while(k<8){
        b[n]=(x as u8);
        x=x/256;
        n=n+1;
        k=k+1;
    }
    o.*.n=n;
    return;
}

fn o_get64(o:Out, idx:i64)i64 {
    let b:[]u8=o.b;
    let p:i64=idx*8;
    let v:i64=0;
    let k:i64=7;
    while(k>=0){
        v=v*256+(b[p+k] as i64);
        k=k-1;
    }
    return v;
}

// find_fields: 1-based WIN indices in order of appearance in DESC
fn find_fields(desc:[]u8, win:[]u8, out:*Out)i64 {
    let c:i64=0;
    let nf:i64=win_nfields(win);
    let i:i64=0;
    while(i<desc.len){
        let matched:i64=0;
        let k:i64=0;
        while(k<nf){
            let nm:[]u8=win_fieldname(win,k);
            if(nm.len>0){
                if(i+nm.len<=desc.len){
                    if(s_eq(desc[i..i+nm.len],nm)==1){
                        o_put64(out,k+1);
                        c=c+1;
                        i=i+nm.len;
                        matched=1;
                        k=nf;
                    }
                }
            }
            if(matched==0){k=k+1;}
        }
        if(matched==0){i=i+1;}
    }
    return c;
}

// kb categories: k-th "LH-CAP|..." id
fn kb_ncats(kb:[]u8)i64 {
    let nl:i64=line_count(kb);
    let i:i64=0;
    let c:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(kb,i);
        if(sw(ln,"ID: LH-CAP|")==1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn kb_cat(kb:[]u8, k:i64)[]u8 {
    let nl:i64=line_count(kb);
    let i:i64=0;
    let c:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(kb,i);
        if(sw(ln,"ID: LH-CAP|")==1){
            if(c==k){return ln[4..ln.len];}
            c=c+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

// build_spec: returns spec string, or "" if params cannot be extracted (KB-MISS for params)
fn build_spec(cat:[]u8, op:[]u8, stage:[]u8, desc:[]u8, win:[]u8, o:*Out)void {
    // o accumulates the spec; cat is "LH-CAP|X", spec uses "LH|X"
    o_raw(o,"LH|");
    let cp:i64=s_find(cat,"|",0);
    if(cp>=0){
        o_raw(o,cat[cp+1..cat.len]);
    } else {
        o_raw(o,cat);
    }
    o_raw(o,"|name=");
    o_raw(o,stage);
    // field indices
    let fbuf:Out=out_new(256);
    let fb:*Out=&fbuf;
    let nf:i64=find_fields(desc,win,fb);
    // integers
    let ibuf:Out=out_new(256);
    let ib:*Out=&ibuf;
    let ni:i64=extract_ints(desc,ib,8);
    // dispatch on op
    let done:i64=0;
    // FIELD ops
    if(s_eq(op,"upper")==1){
        if(nf>=1){
            o_raw(o,"|field=");
            o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|op=upper");
            done=1;
        }
    }
    if(s_eq(op,"clamp")==1){
        if(nf>=1){
            if(ni>=2){
                o_raw(o,"|field=");
                o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|lo=");
                o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|hi=");
                o_i64(o,o_get64(ibuf,1));
                o_raw(o,"|op=clamp");
                done=1;
            }
        }
    }
    if(s_eq(op,"mul_fields")==1){
        if(nf>=2){
            o_raw(o,"|fa=");
            o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|fb=");
            o_i64(o,o_get64(fbuf,1));
            o_raw(o,"|op=mul_fields");
            done=1;
        }
    }
    if(s_eq(op,"sub_fields")==1){
        if(nf>=2){
            o_raw(o,"|fa=");
            o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|fb=");
            o_i64(o,o_get64(fbuf,1));
            o_raw(o,"|op=sub_fields");
            done=1;
        }
    }
    if(s_eq(op,"firstchar_plus")==1){
        if(nf>=1){
            let suf:[]u8=extract_quoted(desc);
            if(suf.len>0){
                o_raw(o,"|field=");
                o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|suffix=");
                o_raw(o,suf);
                o_raw(o,"|op=firstchar_plus");
                done=1;
            }
        }
    }
    if(s_eq(op,"substr")==1){
        if(nf>=1){
            if(ni>=2){
                o_raw(o,"|field=");
                o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|s=");
                o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|l=");
                o_i64(o,o_get64(ibuf,1));
                o_raw(o,"|op=substr");
                done=1;
            }
        }
    }
    if(s_eq(op,"format")==1){
        let tmpl:[]u8=extract_quoted(desc);
        if(tmpl.len>0){
            // replace {name} with {index}
            o_raw(o,"|template=");
            let ti:i64=0;
            while(ti<tmpl.len){
                if(tmpl[ti]==123){
                    let tj:i64=s_find(tmpl,"}",ti);
                    if(tj>ti){
                        let nm:[]u8=tmpl[ti+1..tj];
                        // find nm in win
                        let k:i64=0;
                        let nfw:i64=win_nfields(win);
                        while(k<nfw){
                            if(s_eq(win_fieldname(win,k),nm)==1){
                                o_raw(o,"{");
                                o_i64(o,k+1);
                                o_raw(o,"}");
                                k=nfw;
                            }
                            k=k+1;
                        }
                        ti=tj+1;
                    } else {
                        o_raw(o,tmpl[ti..ti+1]);
                        ti=ti+1;
                    }
                } else {
                    o_raw(o,tmpl[ti..ti+1]);
                    ti=ti+1;
                }
            }
            o_raw(o,"|op=format");
            done=1;
        }
    }
    // FILTER ops
    if(s_eq(op,"field_count_eq")==1){
        if(ni>=1){
            o_raw(o,"|n=");
            o_i64(o,o_get64(ibuf,0));
            o_raw(o,"|op=field_count_eq");
            done=1;
        }
    }
    if(s_eq(op,"int_gt")==1){
        if(nf>=1){
            if(ni>=1){
                o_raw(o,"|field=");
                o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|threshold=");
                o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|op=int_gt");
                done=1;
            }
        }
    }
    if(s_eq(op,"int_ge")==1){
        if(nf>=1){
            if(ni>=1){
                o_raw(o,"|field=");
                o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|threshold=");
                o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|op=int_ge");
                done=1;
            }
        }
    }
    if(s_eq(op,"int_lt")==1){
        if(nf>=1){
            if(ni>=1){
                o_raw(o,"|field=");
                o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|threshold=");
                o_i64(o,o_get64(ibuf,0));
                o_raw(o,"|op=int_lt");
                done=1;
            }
        }
    }
    if(s_eq(op,"int_lt_field")==1){
        if(nf>=2){
            o_raw(o,"|field=");
            o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|field2=");
            o_i64(o,o_get64(fbuf,1));
            o_raw(o,"|op=int_lt_field");
            done=1;
        }
    }
    if(s_eq(op,"in_set")==1){
        if(nf>=1){
            let st:[]u8=extract_set(desc);
            if(st.len>0){
                o_raw(o,"|field=");
                o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|set=");
                // convert {a,b,c} commas to commas (already comma-separated)
                o_raw(o,st);
                o_raw(o,"|op=in_set");
                done=1;
            }
        }
    }
    // AGG ops
    if(s_eq(op,"sum")==1){
        if(nf>=2){
            o_raw(o,"|key=");
            o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|val=");
            o_i64(o,o_get64(fbuf,1));
            o_raw(o,"|op=sum");
            done=1;
        }
    }
    if(s_eq(op,"count")==1){
        if(nf>=1){
            o_raw(o,"|key=");
            o_i64(o,o_get64(fbuf,0));
            o_raw(o,"|op=count");
            done=1;
        }
    }
    // SORT ops
    if(s_eq(op,"sort")==1){
        if(nf>=1){
            let ord:[]u8="";
            if(s_has(desc,"descending")==1){ord="desc";}
            if(s_has(desc,"ascending")==1){ord="asc";}
            if(ord.len>0){
                let tk:i64=0;
                if(ni>=1){
                    // take = the integer, unless it's part of another param
                    // For sort, the integer is the take (e.g. "top 3")
                    tk=o_get64(ibuf,0);
                }
                o_raw(o,"|field=");
                o_i64(o,o_get64(fbuf,0));
                o_raw(o,"|order=");
                o_raw(o,ord);
                o_raw(o,"|take=");
                o_i64(o,tk);
                o_raw(o,"|op=sort");
                done=1;
            }
        }
    }
    if(done==0){
        // clear o (signal failure)
        o.*.n=0;
    }
    return;
}

// ---- proposer ----
fn do_propose(out:*Out, stage:[]u8, contract:[]u8, kb:[]u8)void {
    let desc:[]u8=c_desc(contract);
    let win:[]u8=c_win(contract);
    let dh:i64=fnv(desc);
    if(desc.len==0){
        o_raw(out,"HALT KB-MISS no-DESC\n");
        return;
    }
    // score all ops across all LH-CAP categories; keep top 2
    let b1cat:[]u8="";
    let b1op:[]u8="";
    let b1s:i64=-1;
    let b2cat:[]u8="";
    let b2op:[]u8="";
    let b2s:i64=-1;
    let nc:i64=kb_ncats(kb);
    let ci:i64=0;
    while(ci<nc){
        let cat:[]u8=kb_cat(kb,ci);
        let no:i64=kb_nops(kb,cat);
        let oi:i64=0;
        while(oi<no){
            let op:[]u8=kb_op(kb,cat,oi);
            let keys:[]u8=kb_opkeys(kb,cat,op);
            let sc:i64=op_score(desc,keys);
            if(sc>b1s){
                b2cat=b1cat;b2op=b1op;b2s=b1s;
                b1cat=cat;b1op=op;b1s=sc;
            } else {
                if(sc>b2s){
                    b2cat=cat;b2op=op;b2s=sc;
                }
            }
            oi=oi+1;
        }
        ci=ci+1;
    }
    if(b1s<=0){
        o_raw(out,"HALT KB-MISS no-op-matches-DESC\n");
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-P1 PROPOSER propose KB:none IN:");
        o_i64(out,dh);
        o_raw(out," HALT KB-MISS no-capability-keywords-match\n");
        o_line(out);
        return;
    }
    // build specs for top 2
    let n1:[]u8="1";
    let n2:[]u8="2";
    // candidate 1
    let s1:Out=out_new(4096);
    let p1:*Out=&s1;
    build_spec(b1cat,b1op,stage,desc,win,p1);
    if(s1.n>0){
        o_raw(out,"CAND ");
        o_raw(out,stage);
        o_raw(out,"-P1 ");
        o_raw(out,s1.b[0..s1.n]);
        o_line(out);
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-P1 PROPOSER propose KB:");
        o_raw(out,b1cat);
        o_raw(out," IN:");
        o_i64(out,dh);
        o_raw(out," SELECT ");
        o_raw(out,b1op);
        o_raw(out," SCORE ");
        o_i64(out,b1s);
        o_line(out);
    } else {
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-P1 PROPOSER propose KB:");
        o_raw(out,b1cat);
        o_raw(out," IN:");
        o_i64(out,dh);
        o_raw(out," HALT PARAM-MISS ");
        o_raw(out,b1op);
        o_line(out);
    }
    // candidate 2 (only if it scored > 0 and differs)
    if(b2s>0){
        if(s_eq(b2op,b1op)==0){
            let s2:Out=out_new(4096);
            let p2:*Out=&s2;
            build_spec(b2cat,b2op,stage,desc,win,p2);
            if(s2.n>0){
                o_raw(out,"CAND ");
                o_raw(out,stage);
                o_raw(out,"-P2 ");
                o_raw(out,s2.b[0..s2.n]);
                o_line(out);
                o_raw(out,"EP ");
                o_raw(out,stage);
                o_raw(out,"-P2 PROPOSER propose KB:");
                o_raw(out,b2cat);
                o_raw(out," IN:");
                o_i64(out,dh);
                o_raw(out," SELECT ");
                o_raw(out,b2op);
                o_raw(out," SCORE ");
                o_i64(out,b2s);
                o_line(out);
            }
        }
    }
    return;
}

// ---- critic simulators ----
fn d_field_count(rec:[]u8)i64 {
    if(rec.len==0){return 0;}
    let c:i64=1;
    let i:i64=0;
    while(i<rec.len){if(rec[i]==124){c=c+1;}i=i+1;}
    return c;
}

fn d_field_get(rec:[]u8, k:i64)[]u8 {
    let n:i64=1;
    let s:i64=0;
    let i:i64=0;
    while(i<=rec.len){
        let e:i64=0;
        if(i==rec.len){e=1;}
        if(e==0){if(rec[i]==124){e=1;}}
        if(e==1){if(n==k){return rec[s..i];}n=n+1;s=i+1;}
        i=i+1;
    }
    let e2:[]u8="";
    return e2;
}

fn d_upper(s:[]u8, o:*Out)void {
    let i:i64=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=97){if(c<=122){c=c-32;}}
        let b:[]u8=o.*.b;
        b[o.*.n]=c;
        o.*.n=o.*.n+1;
        i=i+1;
    }
    return;
}

// sim_field: apply FIELD op; append result to out
fn sim_field(spec:[]u8, rec:[]u8, out:*Out)void {
    let op:[]u8=spec_kv(spec,"op=");
    if(s_eq(op,"upper")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            let fd:[]u8=d_field_get(rec,k);
            if(k==f){d_upper(fd,out);} else {o_raw(out,fd);}
            if(k<n){o_raw(out,"|");}
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"clamp")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let lo:i64=num_val(spec_kv(spec,"lo="));
        let hi:i64=num_val(spec_kv(spec,"hi="));
        let n:i64=d_field_count(rec);
        let k:i64=1;
        while(k<=n){
            let fd:[]u8=d_field_get(rec,k);
            if(k==f){
                let v:i64=num_val(fd);
                if(v<lo){v=lo;}
                if(v>hi){v=hi;}
                o_i64(out,v);
            } else {o_raw(out,fd);}
            if(k<n){o_raw(out,"|");}
            k=k+1;
        }
        return;
    }
    if(s_eq(op,"mul_fields")==1){
        let fa:i64=num_val(spec_kv(spec,"fa="));
        let fb:i64=num_val(spec_kv(spec,"fb="));
        let a:i64=num_val(d_field_get(rec,fa));
        let b:i64=num_val(d_field_get(rec,fb));
        o_raw(out,rec);
        o_raw(out,"|");
        o_i64(out,a*b);
        return;
    }
    if(s_eq(op,"sub_fields")==1){
        let fa:i64=num_val(spec_kv(spec,"fa="));
        let fb:i64=num_val(spec_kv(spec,"fb="));
        let a:i64=num_val(d_field_get(rec,fa));
        let b:i64=num_val(d_field_get(rec,fb));
        o_raw(out,rec);
        o_raw(out,"|");
        o_i64(out,a-b);
        return;
    }
    if(s_eq(op,"firstchar_plus")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let suf:[]u8=spec_kv(spec,"suffix=");
        let fd:[]u8=d_field_get(rec,f);
        o_raw(out,rec);
        o_raw(out,"|");
        if(fd.len>0){o_raw(out,fd[0..1]);}
        o_raw(out,suf);
        return;
    }
    if(s_eq(op,"substr")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let s:i64=num_val(spec_kv(spec,"s="));
        let l:i64=num_val(spec_kv(spec,"l="));
        let fd:[]u8=d_field_get(rec,f);
        let a:i64=s;
        let b:i64=l;
        if(a<0){a=0;}
        if(a>fd.len){a=fd.len;}
        if(a+b>fd.len){b=fd.len-a;}
        if(b<0){b=0;}
        o_raw(out,rec);
        o_raw(out,"|");
        o_raw(out,fd[a..a+b]);
        return;
    }
    if(s_eq(op,"format")==1){
        let t:[]u8=spec_kv(spec,"template=");
        let i:i64=0;
        while(i<t.len){
            if(t[i]==123){
                let j:i64=s_find(t,"}",i);
                if(j>i){
                    let kn:i64=num_val(t[i+1..j]);
                    o_raw(out,d_field_get(rec,kn));
                    i=j+1;
                } else {
                    o_raw(out,t[i..i+1]);
                    i=i+1;
                }
            } else {
                o_raw(out,t[i..i+1]);
                i=i+1;
            }
        }
        return;
    }
    return;
}

// sim_filter: returns 1 if keep, 0 if drop
fn sim_filter(spec:[]u8, rec:[]u8)i64 {
    let op:[]u8=spec_kv(spec,"op=");
    if(s_eq(op,"field_count_eq")==1){
        let n:i64=num_val(spec_kv(spec,"n="));
        if(d_field_count(rec)==n){return 1;}
        return 0;
    }
    if(s_eq(op,"int_gt")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let t:i64=num_val(spec_kv(spec,"threshold="));
        if(num_val(d_field_get(rec,f))>t){return 1;}
        return 0;
    }
    if(s_eq(op,"int_ge")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let t:i64=num_val(spec_kv(spec,"threshold="));
        if(num_val(d_field_get(rec,f))>=t){return 1;}
        return 0;
    }
    if(s_eq(op,"int_lt")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let t:i64=num_val(spec_kv(spec,"threshold="));
        if(num_val(d_field_get(rec,f))<t){return 1;}
        return 0;
    }
    if(s_eq(op,"int_lt_field")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let g:i64=num_val(spec_kv(spec,"field2="));
        if(num_val(d_field_get(rec,f))<num_val(d_field_get(rec,g))){return 1;}
        return 0;
    }
    if(s_eq(op,"in_set")==1){
        let f:i64=num_val(spec_kv(spec,"field="));
        let st:[]u8=spec_kv(spec,"set=");
        let fd:[]u8=d_field_get(rec,f);
        let i:i64=0;
        let vs:i64=0;
        while(i<=st.len){
            let eol:i64=0;
            if(i==st.len){eol=1;}
            if(eol==0){if(st[i]==44){eol=1;}}
            if(eol==1){
                if(i>vs){
                    if(s_eq(fd,st[vs..i])==1){return 1;}
                }
                vs=i+1;
            }
            i=i+1;
        }
        return 0;
    }
    return 0;
}

fn o_set64(o:*Out, idx:i64, v:i64)void {
    let b:[]u8=o.*.b;
    let p:i64=idx*8;
    let k:i64=0;
    let x:i64=v;
    while(k<8){
        b[p+k]=(x as u8);
        x=x/256;
        k=k+1;
    }
    return;
}

// sim_agg: inputs separated by ";"; outputs appended separated by ";"
// For sum: "key|sum|count" per group. For count: "key|count".
fn sim_agg(spec:[]u8, inputs:[]u8, out:*Out)void {
    let op:[]u8=spec_kv(spec,"op=");
    let k:i64=num_val(spec_kv(spec,"key="));
    let is_sum:i64=0;
    if(s_eq(op,"sum")==1){is_sum=1;}
    let vf:i64=0;
    if(is_sum==1){vf=num_val(spec_kv(spec,"val="));}
    let kb:Out=out_new(4096);
    let kbp:*Out=&kb;
    let off:Out=out_new(128);
    let offp:*Out=&off;
    let kln:Out=out_new(128);
    let klnp:*Out=&kln;
    let sm:Out=out_new(128);
    let smp:*Out=&sm;
    let ct:Out=out_new(128);
    let ctp:*Out=&ct;
    let nn:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<=inputs.len){
        let eol:i64=0;
        if(i==inputs.len){eol=1;}
        if(eol==0){if(inputs[i]==59){eol=1;}}
        if(eol==1){
            if(i>s){
                let rec:[]u8=inputs[s..i];
                let key:[]u8=d_field_get(rec,k);
                let val:i64=0;
                if(is_sum==1){val=num_val(d_field_get(rec,vf));}
                let f:i64=-1;
                let j:i64=0;
                while(j<nn){
                    let ko:i64=o_get64(off,j);
                    let kl:i64=o_get64(kln,j);
                    if(s_eq(kb.b[ko..ko+kl],key)==1){f=j;}
                    j=j+1;
                }
                if(f==-1){
                    let ko2:i64=kb.n;
                    o_raw(kbp,key);
                    o_put64(offp,ko2);
                    o_put64(klnp,key.len);
                    o_put64(smp,val);
                    o_put64(ctp,1);
                    nn=nn+1;
                } else {
                    o_set64(smp,f,o_get64(sm,f)+val);
                    o_set64(ctp,f,o_get64(ct,f)+1);
                }
            }
            s=i+1;
        }
        i=i+1;
    }
    let j2:i64=0;
    while(j2<nn){
        if(j2>0){o_raw(out,";");}
        let ko3:i64=o_get64(off,j2);
        let kl3:i64=o_get64(kln,j2);
        o_raw(out,kb.b[ko3..ko3+kl3]);
        if(is_sum==1){
            o_raw(out,"|");
            o_i64(out,o_get64(sm,j2));
        }
        o_raw(out,"|");
        o_i64(out,o_get64(ct,j2));
        j2=j2+1;
    }
    return;
}

// sim_sort: inputs separated by ";"; outputs appended separated by ";"
fn sim_sort(spec:[]u8, inputs:[]u8, out:*Out)void {
    let f:i64=num_val(spec_kv(spec,"field="));
    let ord:[]u8=spec_kv(spec,"order=");
    let tk:i64=num_val(spec_kv(spec,"take="));
    let desc:i64=0;
    if(s_eq(ord,"desc")==1){desc=1;}
    // collect records
    let rb:Out=out_new(8192);
    let rbp:*Out=&rb;
    let off:Out=out_new(512);
    let offp:*Out=&off;
    let rln:Out=out_new(512);
    let rlnp:*Out=&rln;
    let kv:Out=out_new(512);
    let kvp:*Out=&kv;
    let nn:i64=0;
    let s:i64=0;
    let i:i64=0;
    while(i<=inputs.len){
        let eol:i64=0;
        if(i==inputs.len){eol=1;}
        if(eol==0){if(inputs[i]==59){eol=1;}}
        if(eol==1){
            if(i>s){
                let rec:[]u8=inputs[s..i];
                let ro2:i64=rb.n;
                o_raw(rbp,rec);
                o_put64(offp,ro2);
                o_put64(rlnp,rec.len);
                o_put64(kvp,num_val(d_field_get(rec,f)));
                nn=nn+1;
            }
            s=i+1;
        }
        i=i+1;
    }
    // index array
    let ix:Out=out_new(512);
    let ixp:*Out=&ix;
    i=0;
    while(i<nn){
        o_put64(ixp,i);
        i=i+1;
    }
    // bubble sort
    let p:i64=0;
    while(p<nn){
        let q:i64=0;
        while(q+1<nn-p){
            let a:i64=o_get64(ix,q);
            let b:i64=o_get64(ix,q+1);
            let sw:i64=0;
            if(desc==1){
                if(o_get64(kv,a)<o_get64(kv,b)){sw=1;}
            } else {
                if(o_get64(kv,a)>o_get64(kv,b)){sw=1;}
            }
            if(sw==1){
                o_set64(ixp,q,b);
                o_set64(ixp,q+1,a);
            }
            q=q+1;
        }
        p=p+1;
    }
    let n:i64=nn;
    if(tk>0){
        if(tk<nn){n=tk;}
    }
    i=0;
    while(i<n){
        if(i>0){o_raw(out,";");}
        let ri:i64=o_get64(ix,i);
        let ro3:i64=o_get64(off,ri);
        let rl3:i64=o_get64(rln,ri);
        o_raw(out,rb.b[ro3..ro3+rl3]);
        i=i+1;
    }
    return;
}

// ---- critic ----
fn do_critique(out:*Out, stage:[]u8, contract:[]u8, cands:[]u8)void {
    // cands lines: "CAND <epid> <spec>"
    let nt:i64=c_ntests(contract);
    let accepted:i64=0;
    let nl:i64=line_count(cands);
    let i:i64=0;
    while(i<nl){
        let ln:[]u8=line_get(cands,i);
        if(sw(ln,"CAND ")==1){
            // extract epid and spec
            let sp1:i64=s_find(ln," ",5);
            let epid:[]u8=ln[5..sp1];
            let spec:[]u8=ln[sp1+1..ln.len];
            // simulate on all tests
            let pass:i64=1;
            let ti:i64=0;
            while(ti<nt){
                let tin:[]u8=c_testin(contract,ti);
                let tout:[]u8=c_testout(contract,ti);
                let got:Out=out_new(4096);
                let gp:*Out=&got;
                if(s_has(spec,"LH|FIELD|")==1){
                    sim_field(spec,tin,gp);
                } else {
                    if(s_has(spec,"LH|FILTER|")==1){
                        if(sim_filter(spec,tin)==1){
                            o_raw(gp,tin);
                        }
                    } else {
                        if(s_has(spec,"LH|AGG|")==1){
                            sim_agg(spec,tin,gp);
                        } else {
                            if(s_has(spec,"LH|SORT|")==1){
                                sim_sort(spec,tin,gp);
                            }
                        }
                    }
                }
                let gs:[]u8=got.b[0..got.n];
                if(s_eq(gs,tout)==0){pass=0;}
                ti=ti+1;
            }
            if(pass==1){
                if(accepted==0){
                    o_raw(out,"ACCEPT ");
                    o_raw(out,epid);
                    o_raw(out," ");
                    o_raw(out,spec);
                    o_line(out);
                    o_raw(out,"EP ");
                    o_raw(out,stage);
                    o_raw(out,"-C1 CRITIC critique CITES:");
                    o_raw(out,epid);
                    o_raw(out," ACCEPT ");
                    o_raw(out,spec_kv(spec,"op="));
                    o_raw(out," all-");
                    o_i64(out,nt);
                    o_raw(out,"-tests-pass");
                    o_line(out);
                    accepted=1;
                } else {
                    o_raw(out,"EP ");
                    o_raw(out,stage);
                    o_raw(out,"-C2 CRITIC critique CITES:");
                    o_raw(out,epid);
                    o_raw(out," REJECT redundant-accepted-exists");
                    o_line(out);
                }
            } else {
                o_raw(out,"EP ");
                o_raw(out,stage);
                o_raw(out,"-C1 CRITIC critique CITES:");
                o_raw(out,epid);
                o_raw(out," REJECT simulation-mismatch");
                o_line(out);
            }
        }
        i=i+1;
    }
    if(accepted==0){
        o_raw(out,"HALT NO-ACCEPT\n");
        o_raw(out,"EP ");
        o_raw(out,stage);
        o_raw(out,"-C1 CRITIC critique CITES:none REJECT all-candidates-fail");
        o_line(out);
    }
    return;
}

// ---- composer ----
fn do_compose(out:*Out, stage:[]u8, spec:[]u8, crit_ep:[]u8)void {
    o_raw(out,"FINAL ");
    o_raw(out,spec);
    o_line(out);
    o_raw(out,"EP ");
    o_raw(out,stage);
    o_raw(out,"-M COMPOSER compose CITES:");
    o_raw(out,crit_ep);
    o_raw(out," FINAL ");
    o_i64(out,fnv(spec));
    o_line(out);
    return;
}

fn main()void {
    let mode:[]u8=_zag_arg(1);
    let o:Out=out_new(65536);
    let op:*Out=&o;
    if(s_eq(mode,"propose")==1){
        let stage:[]u8=_zag_arg(2);
        let contract:[]u8=_zag_arg(3);
        let kb:[]u8=_zag_arg(4);
        do_propose(op,stage,contract,kb);
    } else {
        if(s_eq(mode,"critique")==1){
            let stage2:[]u8=_zag_arg(2);
            let contract2:[]u8=_zag_arg(3);
            let cands:[]u8=_zag_arg(4);
            do_critique(op,stage2,contract2,cands);
        } else {
            if(s_eq(mode,"compose")==1){
                let stage3:[]u8=_zag_arg(2);
                let spec3:[]u8=_zag_arg(3);
                let cep:[]u8=_zag_arg(4);
                do_compose(op,stage3,spec3,cep);
            } else {
                o_raw(op,"UNKNOWN_MODE\n");
            }
        }
    }
    _zag_print(o.b[0..o.n]);
    return;
}

// e — Arm E: ephemeral chunks, no persistent ID ("just a chunk").
// FROZEN SPEC (prereg §3, verbatim): "Segmentation exists transiently per
// episode in a scratch window and is discarded; memory holds byte copies, not
// references; no chunk table, no IDs, no CUT_* ops."
//
// Mechanism, literally implemented:
//  - Per episode, the input buffer is scanned into transient spans held in a
//    scratch window (e_segment). The scratch is reused every episode; its
//    contents are discarded (never persisted to the store image, never
//    logged). No segmentation survives the episode.
//  - Memory holds OWNED BYTE COPIES in a bump arena, not references. A unit
//    is {corpus_id, start, len} provenance + an arena-resident copy.
//    Two units covering the same span are two independent copies; the system
//    never checks (there is no ID space to resolve through, no dedup —
//    adding dedup would turn this into Arm D with extra steps and invalidate
//    the control, per the frozen spec).
//  - Recall returns the stored copy through the arm's own retrieval path
//    (slot hash -> arena offset -> bytes). A recorded boundary shift means
//    the copy no longer covers the claimed span -> loud failure (-1), never
//    silent wrong bytes. A recorded content patch is returned as the
//    simulated corrupted copy (same semantics as the b64 validator).
//  - The unit key is pure arithmetic, (corpus<<24)|index, exactly as in the
//    b64 validator: no persistent ID->storage mapping is maintained, so E is
//    a NON-ID arm (ARM_INTERFACE.md §9 provisional classification confirmed).
//    M1 swap probe: N/A. M7: N/A (no ID layer) + re-read-bytes footnote.
//
// One binary; argv[1] selects the trial mode (ARM_INTERFACE.md §3).
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const E_CHUNK:i32=64;
const E_C_PROSE:i32=1;
const E_C_CODE:i32=2;
const E_C_T1P:i32=3;
const E_C_T1C:i32=4;
const E_C_T2P:i32=5;
const E_C_T2C:i32=6;
const E_C_T3:i32=7;
const E_C_FRESH:i32=8;
const E_M3_CAP:i32=4000;      // C_M3: harness-fixed M3 store capacity (slots)
const E_M3_V:i32=1000;        // valuable set size
const E_M3_FRESH1:i32=3000;   // phase-1 fresh ingests
const E_M3_KILL:i32=3000;     // phase-2 kills
const E_M3_FRESH2:i32=4000;   // phase-3 ingests at capacity
const E_M4_N:i32=200;         // defect units per corpus
const E_M7_LOOKUPS:i32=5000;
const E_SHARD:i64=33554432;   // 2^25: max indexable slice bytes (C5)

// flags bits
const F_OCC:i32=1;
const F_LIVE:i32=2;
const F_PIN:i32=4;
const F_WEAK:i32=8;
const F_SHIFT:i32=16;
const F_PATCH:i32=32;

// ledger opcodes (frozen namespace, ARM_INTERFACE.md §6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;   // TRAINER_DEFECT_BOUNDARY
const OP_TDC:i32=17;   // TRAINER_DEFECT_CONTENT
const OP_TMV:i32=18;   // TRAINER_MARK_VALUABLE

// ---- little-endian u32/i32 packing on []u8 (playbook idiom) ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }

// ---- sharded corpus buffer: no slice indexed above 2^25 (C5) ----
struct BigBuf {
    s0:[]u8, s1:[]u8, s2:[]u8, s3:[]u8,
    nsh:i32,
    len:i64,
}
fn bb_shard(bb:*BigBuf,sh:i64) []u8 {
    if(sh==1){return bb.*.s1;}
    if(sh==2){return bb.*.s2;}
    if(sh==3){return bb.*.s3;}
    return bb.*.s0;
}
// copy n bytes at absolute offset at into dst (handles shard straddle)
fn bb_copy(bb:*BigBuf,at:i64,dst:[]u8,n:i32) void {
    let rem:i32=n;let doff:i32=0;let pos:i64=at;
    while(rem>0){
        let sh:i64=pos/E_SHARD;
        let so:i32=(pos-(sh*E_SHARD)) as i32;
        let navail:i32=(E_SHARD as i32)-so;
        let take:i32=rem;
        if(take>navail){take=navail;}
        let src:[]u8=bb_shard(bb,sh);
        let k:i32=0;
        while(k<take){dst[doff+k]=src[so+k];k=k+1;}
        doff=doff+take;pos=pos+(take as i64);rem=rem-take;
    }
}
fn bb_byte(bb:*BigBuf,at:i64) u8 {
    let sh:i64=at/E_SHARD;
    let so:i32=(at-(sh*E_SHARD)) as i32;
    let src:[]u8=bb_shard(bb,sh);
    return src[so];
}

// ---- allocator wrappers with trace (addresses never logged) ----
struct E {
    cap:i32,
    ids:[]u8,      // cap * u32: unit key (pure arithmetic, NOT an ID layer)
    offs:[]u8,     // cap * u32: byte offset (provenance)
    lens:[]u8,     // cap * u32: length
    corps:[]u8,    // cap * u32: corpus id
    flags:[]u8,    // cap * u32: flags bits
    shifts:[]u8,   // cap * i32: recorded boundary shift
    pidx:[]u8,     // cap * i32: patch index or -1
    apos:[]u8,     // cap * u32: arena offset of the owned byte copy
    patches:[]u8,  // patch_n * 64 bytes (recorded content-defect overlays)
    patch_n:i32,
    patch_cap:i32,
    ar0:[]u8,      // arena shards: owned byte copies (bump allocation);
    ar1:[]u8,      // no shard is ever indexed above 2^25; up to 4 shards
    ar2:[]u8,      // cover the 10x code corpus (~95.2MB of copies)
    ar3:[]u8,
    ar_cap0:i32,
    ar_cap1:i32,
    ar_cap2:i32,
    ar_cap3:i32,
    ar_used:i64,   // bump pointer: bytes of copies stored (== stored bytes)
    led0:[]u8,     // ledger shards (up to 4; <=2^25 bytes each, C5)
    led1:[]u8,
    led2:[]u8,
    led3:[]u8,
    led_shard:i32, // bytes per ledger shard
    led_total:i64, // total ledger byte capacity
    led_n:i32,     // entries appended
    ins:[]u8,      // insertion-order queue of slots (ins_cap * i32)
    ins_cap:i32,
    ins_n:i32,
    ins_head:i32,
    trace:[]u8,    // alloc trace text
    trace_n:i32,
    trace_cap:i32,
    nlive:i32,
}

fn halloc(s:*E,n:i32)[]u8 {
    // append "A <n>\n" to trace
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn hfree(s:*E,b:[]u8)void {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}

fn e_init(s:*E,cap:i32,led_entries:i32,ins_max:i32,arena_bytes:i64)void {
    s.*.cap=cap;s.*.nlive=0;
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.ids=halloc(s,cap*4);s.*.offs=halloc(s,cap*4);s.*.lens=halloc(s,cap*4);
    s.*.corps=halloc(s,cap*4);s.*.flags=halloc(s,cap*4);s.*.shifts=halloc(s,cap*4);
    s.*.pidx=halloc(s,cap*4);s.*.apos=halloc(s,cap*4);
    let i:i32=0;while(i<cap){iput(s.*.pidx,i*4,-1);i=i+1;}
    s.*.patch_cap=1024;s.*.patches=halloc(s,1024*64);s.*.patch_n=0;
    // sharded ledger: <=2^25 bytes per shard (C5)
    let ltot:i64=(led_entries as i64)*64;
    let lsh:i64=(ltot+E_SHARD-1)/E_SHARD;
    if(lsh>4){lsh=4;}
    if(lsh<1){lsh=1;}
    let lsb:i32=((ltot+lsh-1)/lsh) as i32;
    // round shard bytes up to a multiple of 64 (entry alignment)
    lsb=((lsb+63)/64)*64;
    s.*.led_shard=lsb;s.*.led_total=(lsh as i64)*(lsb as i64);s.*.led_n=0;
    s.*.led0=halloc(s,lsb);
    s.*.led1="";s.*.led2="";s.*.led3="";
    if(lsh>1){s.*.led1=halloc(s,lsb);}
    if(lsh>2){s.*.led2=halloc(s,lsb);}
    if(lsh>3){s.*.led3=halloc(s,lsb);}
    // bump arena for owned byte copies: <=2^25 per shard (C5), up to 4 shards.
    // shard i covers [i*asb,(i+1)*asb); all live shards share stride asb.
    let ash:i64=(arena_bytes+E_SHARD-1)/E_SHARD;
    if(ash>4){ash=4;}
    if(ash<1){ash=1;}
    let asb:i32=((arena_bytes+ash-1)/ash) as i32;
    asb=((asb+63)/64)*64;
    s.*.ar_cap0=0;s.*.ar_cap1=0;s.*.ar_cap2=0;s.*.ar_cap3=0;s.*.ar_used=0;
    s.*.ar0="";s.*.ar1="";s.*.ar2="";s.*.ar3="";
    if(ash>0){s.*.ar_cap0=asb;s.*.ar0=halloc(s,asb);}
    if(ash>1){s.*.ar_cap1=asb;s.*.ar1=halloc(s,asb);}
    if(ash>2){s.*.ar_cap2=asb;s.*.ar2=halloc(s,asb);}
    if(ash>3){s.*.ar_cap3=asb;s.*.ar3=halloc(s,asb);}
    s.*.ins=halloc(s,ins_max*4);s.*.ins_cap=ins_max;s.*.ins_n=0;s.*.ins_head=0;
}
fn e_new(cap:i32,led_entries:i32,ins_max:i32,arena_bytes:i64) E {
    let s:E=E{.cap=0,.ids="",.offs="",.lens="",.corps="",.flags="",
        .shifts="",.pidx="",.apos="",.patches="",.patch_n=0,.patch_cap=0,
        .ar0="",.ar1="",.ar2="",.ar3="",.ar_cap0=0,.ar_cap1=0,.ar_cap2=0,.ar_cap3=0,.ar_used=0,
        .led0="",.led1="",.led2="",.led3="",.led_shard=0,.led_total=0,.led_n=0,
        .ins="",.ins_cap=0,.ins_n=0,.ins_head=0,.trace="",
        .trace_n=0,.trace_cap=0,.nlive=0};
    e_init(&s,cap,led_entries,ins_max,arena_bytes);
    return s;
}

// ---- ledger (sharded; entry i lives at byte i*64, shard = byte/led_shard) ----
fn led_shard(s:*E,sh:i64) []u8 {
    if(sh==1){return s.*.led1;}
    if(sh==2){return s.*.led2;}
    if(sh==3){return s.*.led3;}
    return s.*.led0;
}
fn e_led(s:*E,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let at:i64=(s.*.led_n as i64)*64;
    if(at+64>s.*.led_total){return;} // LEDGER-BOUND: scored on what completed
    let shb:i64=s.*.led_shard as i64;
    let sh:i64=at/shb;
    let o:i32=(at-sh*shb) as i32;
    let l:[]u8=led_shard(s,sh);
    iput(l,o,op);iput(l,o+4,slot);iput(l,o+8,rc);
    iput(l,o+12,b1);iput(l,o+16,b2);iput(l,o+20,b3);iput(l,o+24,b4);iput(l,o+28,b5);
    iput(l,o+32,a1);iput(l,o+36,a2);iput(l,o+40,a3);iput(l,o+44,a4);iput(l,o+48,a5);
    iput(l,o+52,1);iput(l,o+56,d1);iput(l,o+60,d2);
    s.*.led_n=s.*.led_n+1;
}
fn led_op(s:*E,idx:i32) i32 {
    let at:i64=(idx as i64)*64;
    let shb:i64=s.*.led_shard as i64;
    let sh:i64=at/shb;
    let o:i32=(at-sh*shb) as i32;
    if(sh==1){return iget(s.*.led1,o);}
    return iget(s.*.led0,o);
}

// ---- slot placement: key-derived (order-independent), linear probe ----
// multiplicative hash decorrelates the corpus-shifted key spaces
fn slot_hash(id:i32,cap:i32) i32 {
    let x:i64=(id as i64)*2654435761;
    x=x ^ (x>>16);
    x=x*2246822519;
    x=x ^ (x>>13);
    let h:i64=x % (cap as i64);
    if(h<0){h=h+(cap as i64);}
    return h as i32;
}
fn slot_find(s:*E,id:i32) i32 {
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let flags:[]u8=s.*.flags;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){return -1;}
        if(iget(ids,h*4)==id){return h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    return -1;
}
// insert a NEW key; -1 if the table is full. Revive is handled by the caller.
fn slot_insert_new(s:*E,id:i32,off:i32,len:i32,corpus:i32) i32 {
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;
    let corps:[]u8=s.*.corps;let flags:[]u8=s.*.flags;let shifts:[]u8=s.*.shifts;
    let pidx:[]u8=s.*.pidx;let apos:[]u8=s.*.apos;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;let first_dead:i32=-1;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){
            let sl:i32=h;
            if(first_dead>=0){sl=first_dead;}
            iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
            iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
            iput(shifts,sl*4,0);iput(pidx,sl*4,-1);iput(apos,sl*4,0);
            let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
            s.*.nlive=s.*.nlive+1;
            return sl;
        }
        if(((f & F_LIVE)==0) && first_dead<0){first_dead=h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    if(first_dead>=0){
        let sl:i32=first_dead;
        iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
        iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
        iput(shifts,sl*4,0);iput(pidx,sl*4,-1);iput(apos,sl*4,0);
        let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
        s.*.nlive=s.*.nlive+1;
        return sl;
    }
    return -1;
}

// ---- bump arena for owned byte copies (no dedup, no sharing, no reclaim) ----
fn ar_shard(s:*E,i:i32) []u8 {
    if(i==0){return s.*.ar0;}
    if(i==1){return s.*.ar1;}
    if(i==2){return s.*.ar2;}
    return s.*.ar3;
}
fn ar_shard_cap(s:*E,i:i32) i64 {
    if(i==0){return s.*.ar_cap0 as i64;}
    if(i==1){return s.*.ar_cap1 as i64;}
    if(i==2){return s.*.ar_cap2 as i64;}
    return s.*.ar_cap3 as i64;
}
fn ar_reserve(s:*E,len:i32) i64 {
    let total:i64=(s.*.ar_cap0 as i64)+(s.*.ar_cap1 as i64)+(s.*.ar_cap2 as i64)+(s.*.ar_cap3 as i64);
    if(s.*.ar_used+(len as i64)>total){return -1;}
    let at:i64=s.*.ar_used;
    s.*.ar_used=at+(len as i64);
    return at;
}
// shard i covers [i*stride,(i+1)*stride); stride = ar_cap0 (all live shards
// share it; trailing shards may simply be empty)
fn ar_write(s:*E,at:i64,src:[]u8,n:i32) void {
    let stride:i64=s.*.ar_cap0 as i64;
    let rem:i32=n;let soff:i32=0;let pos:i64=at;
    let si:i32=0;
    while(rem>0){
        if(si>=4){break;} // unreachable: ar_reserve bounds total capacity
        let base:i64=(si as i64)*stride;
        let cap:i64=ar_shard_cap(s,si);
        if(cap>0 && pos>=base && pos<base+cap){
            let sh:[]u8=ar_shard(s,si);
            let o:i32=(pos-base) as i32;
            let navail:i32=(cap as i32)-o;
            let take:i32=rem;
            if(take>navail){take=navail;}
            let k:i32=0;
            while(k<take){sh[o+k]=src[soff+k];k=k+1;}
            soff=soff+take;pos=pos+(take as i64);rem=rem-take;
        }
        si=si+1;
    }
}
fn ar_read(s:*E,at:i64,dst:[]u8,n:i32) void {
    let stride:i64=s.*.ar_cap0 as i64;
    let rem:i32=n;let doff:i32=0;let pos:i64=at;
    let si:i32=0;
    while(rem>0){
        if(si>=4){break;} // unreachable: reads stay within ar_used
        let base:i64=(si as i64)*stride;
        let cap:i64=ar_shard_cap(s,si);
        if(cap>0 && pos>=base && pos<base+cap){
            let sh:[]u8=ar_shard(s,si);
            let o:i32=(pos-base) as i32;
            let navail:i32=(cap as i32)-o;
            let take:i32=rem;
            if(take>navail){take=navail;}
            let k:i32=0;
            while(k<take){dst[doff+k]=sh[o+k];k=k+1;}
            doff=doff+take;pos=pos+(take as i64);rem=rem-take;
        }
        si=si+1;
    }
}

// ---- transient segmentation: scratch window, discarded per episode ----
// e_segment scans the input buffer into (off,len) pairs in the scratch
// window. The scratch is REUSED every episode; its contents are transient:
// never persisted to the store image, never logged, never consulted after
// the episode's ingest completes. The grid placement is a trial convenience
// (identical to the b64 validator's grid) so the E-vs-B64 comparison isolates
// exactly copies-vs-references; per the frozen spec P-E4 the transient method
// cannot change any M-metric because nothing persists.
fn e_segment(scratch:[]u8,buflen:i64) i32 {
    let n:i32=((buflen+63)/64) as i32;
    let i:i32=0;
    while(i<n){
        let off:i64=(i as i64)*64;
        let len:i64=buflen-off;
        if(len>64){len=64;}
        iput(scratch,i*8,off as i32);
        iput(scratch,i*8+4,len as i32);
        i=i+1;
    }
    return n;
}

// ---- core ops ----
fn e_ingest(s:*E,bb:*BigBuf,id:i32,corpus:i32,base:i64,off:i32,len:i32) i32 {
    // deliberate add of a unit; the BYTES are copied into the arena (owned).
    // loud refusal (rc=1) if the slot table is full.
    let sl0:i32=slot_find(s,id);
    if(sl0>=0){
        // revive: same key re-ingested (same span, same source bytes).
        // The stored copy is already byte-identical; no second copy is made.
        // (NOT dedup: dedup would share storage across DIFFERENT keys.)
        let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;let corps:[]u8=s.*.corps;
        let flags:[]u8=s.*.flags;
        iput(offs,sl0*4,off);iput(lens,sl0*4,len);iput(corps,sl0*4,corpus);
        let f:i32=iget(flags,sl0*4);
        if((f & F_LIVE)==0){s.*.nlive=s.*.nlive+1;}
        iput(flags,sl0*4,(f | F_OCC) | F_LIVE);
        e_led(s,OP_ADD,sl0,0,off,0,len,corpus,id,0,0,0,0,0,id,0);
        return sl0;
    }
    let sl:i32=slot_insert_new(s,id,off,len,corpus);
    if(sl<0){
        e_led(s,OP_REFUSE,-1,1,off,0,len,corpus,id,0,0,0,0,0,101,0);
        return -1;
    }
    let at:i64=ar_reserve(s,len);
    if(at<0){
        // arena exhausted (impossible by sizing): loud audited refusal,
        // slot left occupied-but-dead so the store image stays truthful.
        let flags:[]u8=s.*.flags;
        iput(flags,sl*4,iget(flags,sl*4) & (0-1-F_LIVE));
        s.*.nlive=s.*.nlive-1;
        e_led(s,OP_REFUSE,sl,1,off,0,len,corpus,id,0,0,0,0,0,104,0);
        return -1;
    }
    let tmp:[]u8=nio_alloc(len);
    bb_copy(bb,base+(off as i64),tmp,len);
    ar_write(s,at,tmp,len);
    nio_free(tmp);
    iput(s.*.apos,sl*4,at as i32);
    e_led(s,OP_ADD,sl,0,off,0,len,corpus,id,0,0,0,0,0,id,0);
    return sl;
}
fn e_recall(s:*E,id:i32,out:[]u8) i32 {
    // return the unit's OWNED COPY through the arm's retrieval path.
    // out must hold 64 bytes. Returns len, or -1 on loud failure.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    let len:i32=iget(s.*.lens,sl*4);
    // recorded content defect: the recall path must apply the patch,
    // simulating a corrupted stored copy (same semantics as the validator).
    if((f & F_PATCH)!=0){
        let pi:i32=iget(s.*.pidx,sl*4);
        let pb:[]u8=s.*.patches;
        let i:i32=0;while(i<len){out[i]=pb[pi*64+i];i=i+1;}
        return len;
    }
    // recorded boundary shift: the stored copy no longer covers the claimed
    // span. E has no corpus buffer to re-read (copies are the memory), so it
    // fails LOUDLY rather than returning bytes for the wrong span. Silent
    // wrong-bytes recall would be K-R5; this is the honest failure.
    if((f & F_SHIFT)!=0){return -1;}
    let at:i64=iget(s.*.apos,sl*4) as i64;
    ar_read(s,at,out,len);
    return len;
}
fn e_kill(s:*E,id:i32,reason:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    iput(flags,sl*4,f & (0-1-F_LIVE)); // tombstone; arena bytes stay (waste is honest)
    s.*.nlive=s.*.nlive-1;
    e_led(s,OP_KILL,sl,0,0,0,0,0,id,0,0,0,0,0,reason,0);
    return 0;
}
fn e_pin(s:*E,id:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PIN);
    e_led(s,OP_PIN,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return 0;
}
fn e_weaken(s:*E,id:i32,seq:i32) i32 {
    // E's documented policy: weaken is processed as a management annotation
    // (sets WEAKENED flag, audited). It never changes stored bytes.
    let sl:i32=slot_find(s,id);
    if(sl<0){
        e_led(s,OP_REFUSE,-1,1,0,0,0,0,id,0,0,0,0,0,102,0);
        return -1;
    }
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_WEAK);
    e_led(s,OP_WEAKEN,sl,0,0,0,0,0,id,0,0,0,0,0,seq,0);
    return 0;
}
fn e_defect_boundary(s:*E,id:i32,delta:i32) i32 {
    // EXTERNAL trainer op: shift the recorded span
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let shifts:[]u8=s.*.shifts;let flags:[]u8=s.*.flags;
    iput(shifts,sl*4,delta);iput(flags,sl*4,iget(flags,sl*4) | F_SHIFT);
    e_led(s,OP_TDB,sl,0,0,0,0,0,id,0,0,0,0,0,delta,0);
    return 0;
}
fn e_defect_content(s:*E,id:i32,patch:[]u8,plen:i32) i32 {
    // EXTERNAL trainer op: record a byte patch the recall path must apply
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    if(s.*.patch_n>=s.*.patch_cap){return -1;}
    let pi:i32=s.*.patch_n;
    let pb:[]u8=s.*.patches;
    let i:i32=0;while(i<plen){pb[pi*64+i]=patch[i];i=i+1;}
    while(i<64){pb[pi*64+i]=0;i=i+1;}
    s.*.patch_n=pi+1;
    iput(s.*.pidx,sl*4,pi);
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PATCH);
    e_led(s,OP_TDC,sl,0,0,0,0,0,id,0,0,0,0,0,plen,0);
    return 0;
}
fn e_revise(s:*E,bb:*BigBuf,base:i64,id:i32) i32 {
    // deliberate repair: drop the recorded shift/patch. The stored copy was
    // never corrupted (defects are recorded overlays), so no re-copy is
    // needed; the copy is re-verified against the source below by the caller.
    // Returns 1 if a repair happened, 0 if clean, -1 if missing/dead.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    if((f & (F_SHIFT | F_PATCH))==0){return 0;}
    let old_off:i32=iget(s.*.offs,sl*4)+iget(s.*.shifts,sl*4);
    iput(s.*.shifts,sl*4,0);
    iput(s.*.pidx,sl*4,-1);
    iput(flags,sl*4,f & (0-1-F_SHIFT-F_PATCH));
    let new_off:i32=iget(s.*.offs,sl*4);
    e_led(s,OP_REVISE,sl,0,iget(s.*.offs,sl*4),0,iget(s.*.lens,sl*4),
          iget(s.*.corps,sl*4),id,0,0,0,0,0,old_off,new_off);
    return 1;
}
fn e_evict_oldest_unpinned(s:*E) i32 {
    // FIFO eviction of the oldest live unpinned unit. Returns evicted id or -1.
    let ins:[]u8=s.*.ins;let flags:[]u8=s.*.flags;
    while(s.*.ins_head<s.*.ins_n){
        let sl:i32=iget(ins,s.*.ins_head*4);
        s.*.ins_head=s.*.ins_head+1;
        let f:i32=iget(flags,sl*4);
        if((f & F_LIVE)!=0 && (f & F_PIN)==0){
            let id:i32=iget(s.*.ids,sl*4);
            iput(flags,sl*4,f & (0-1-F_LIVE));
            s.*.nlive=s.*.nlive-1;
            e_led(s,OP_EVICT,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
            return id;
        }
    }
    return -1;
}
fn e_mark_valuable(s:*E,id:i32) i32 {
    e_led(s,OP_TMV,-1,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return e_pin(s,id); // E's marking mechanism: pin (same as the validator)
}

// ---- file IO ----
fn fd_read_full(fd:i64,dst:[]u8) i32 {
    // read exactly dst.len bytes from the current file offset (raw syscalls;
    // nio_read_exact cannot do offset reads, and 10x corpora exceed 2^25).
    let total:i32=dst.len;
    let at:i32=0;
    let calls:i32=0;
    while(at<total && calls<65536){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(dst) as i64)+(at as i64),
                                  (total-at) as i64,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){return -1;}
        at=at+(n as i32);
    }
    if(at!=total){return -1;}
    return 0;
}
fn read_big(dir:[]u8,name:[]u8) BigBuf {
    // read a corpus file into a sharded buffer (<=2^25 per shard, C5).
    // Corpus buffers are environment input: nio_alloc'd directly, never in
    // the arm's alloc trace (same as the b64 validator).
    let bb:BigBuf=BigBuf{.s0="",.s1="",.s2="",.s3="",.nsh=0,.len=0};
    let root:i64=nio_open_root(dir);
    if(root<0){return bb;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return bb;}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>134217728){nio_close(fd);return bb;}
    nio_seek(fd,0,0);
    let nsh:i64=(sz+E_SHARD-1)/E_SHARD;
    if(nsh>4){nio_close(fd);return bb;}
    let si:i64=0;
    let ok:i32=1;
    while(si<nsh){
        let ss:i64=sz-si*E_SHARD;
        if(ss>E_SHARD){ss=E_SHARD;}
        let sh:[]u8=nio_alloc(ss as i32);
        if(sh.len!=(ss as i32)){ok=0;break;}
        if(fd_read_full(fd,sh)!=0){ok=0;break;}
        if(si==0){bb.s0=sh;}
        if(si==1){bb.s1=sh;}
        if(si==2){bb.s2=sh;}
        if(si==3){bb.s3=sh;}
        si=si+1;
    }
    nio_close(fd);
    if(ok==0){return BigBuf{.s0="",.s1="",.s2="",.s3="",.nsh=0,.len=0};}
    bb.nsh=nsh as i32;
    bb.len=sz;
    return bb;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    // nio_write_all caps at 1MB per call: chunk the write. O_EXCL: the file
    // must not exist (the runner uses a fresh workdir per mode).
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// write the sharded ledger bytes (64B entries) to a file
fn write_ledger(s:*E,dir:[]u8,name:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let total:i64=(s.*.led_n as i64)*64;
    let shb:i64=s.*.led_shard as i64;
    let sh:i64=0;
    let done:i64=0;
    while(done<total){
        let l:[]u8=led_shard(s,sh);
        let n:i64=total-done;
        if(n>shb){n=shb;}
        let at:i32=0;
        while(at<(n as i32)){
            let m:i32=(n as i32)-at;
            if(m>1048576){m=1048576;}
            let w:i64=nio_write_all(fd,l[at..at+m]);
            if(w!=(m as i64)){nio_close(fd);return -1;}
            at=at+m;
        }
        done=done+n;sh=sh+1;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8,scale:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"e\",\"round\":\"r1\",\"scale\":\"");
    _zag_print(scale);
    _zag_print("\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    // print integer tenths as one-decimal, e.g. 1000 -> 100.0 ; -35 -> -3.5
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- shared trial helpers ----
fn nunits_of(buflen:i64) i32 { return ((buflen+63)/64) as i32; }
fn unit_id(corpus:i32,idx:i32) i32 { return (corpus<<24)|idx; }
// ingest a whole corpus buffer through the TRANSIENT scratch segmentation:
// one scan into the scratch window, ingest from it, discard.
fn ingest_all(s:*E,bb:*BigBuf,corpus:i32,base:i64) i32 {
    let n:i32=nunits_of(bb.*.len-base);
    let scratch:[]u8=halloc(s,n*8+16);
    let m:i32=e_segment(scratch,bb.*.len-base);
    let i:i32=0;
    while(i<m){
        let off:i32=iget(scratch,i*8);
        let len:i32=iget(scratch,i*8+4);
        e_ingest(s,bb,unit_id(corpus,i),corpus,base,off,len);
        i=i+1;
    }
    hfree(s,scratch);
    return m;
}
// probe: recall every unit via the arm's own retrieval path; byte-diff vs
// source. Content recall % and boundary fidelity % recorded separately.
fn probe_reg(s:*E,bb:*BigBuf,base:i64,corpus:i32,
             bout:[]u8,cok:*i32,bok:*i32) void {
    let n:i32=nunits_of(bb.*.len-base);
    let ok:i32=0;let bo:i32=0;
    let win:[]u8=nio_alloc(64);
    let i:i32=0;
    while(i<n){
        let id:i32=unit_id(corpus,i);
        let off:i64=(i as i64)*64;
        let len:i64=(bb.*.len-base)-off;
        if(len>64){len=64;}
        let rl:i32=e_recall(s,id,bout);
        if((rl as i64)==len){
            bb_copy(bb,base+off,win,len as i32);
            let good:i32=1;
            let j:i32=0;while(j<(len as i32)){if(bout[j]!=win[j]){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        // boundary: slot record must equal the ingest-assigned span
        let sl:i32=slot_find(s,id);
        if(sl>=0){
            let f:i32=iget(s.*.flags,sl*4);
            if((f & F_LIVE)!=0 && (iget(s.*.offs,sl*4) as i64)==off
               && (iget(s.*.lens,sl*4) as i64)==len && (f & F_SHIFT)==0){bo=bo+1;}
        }
        i=i+1;
    }
    nio_free(win);
    if(n>0){cok.*=(ok*1000/n) as i32;bok.*=(bo*1000/n) as i32;}else{cok.*=0;bok.*=0;}
}

// ---- defect patch builders ----
fn patch_prose_xor(bb:*BigBuf,base:i64,off:i64,len:i32,out:[]u8) void {
    bb_copy(bb,base+off,out,len);
    let i:i32=0;
    while(i<len){
        if(i%7==0){out[i]=((out[i] as i32) ^ 255) as u8;}
        i=i+1;
    }
}
fn code_rename(bb:*BigBuf,base:i64,off:i64,len:i32,out:[]u8) void {
    // fixed-map identifier rename, same-length replacements, left-to-right
    bb_copy(bb,base+off,out,len);
    let p0:[]u8="sqlite3";let r0:[]u8="sqlite4";
    let p1:[]u8="SQLITE";let r1:[]u8="SQLITF";
    let p2:[]u8="Vdbe";let r2:[]u8="Vdbf";
    let p3:[]u8="Mem";let r3:[]u8="Mfm";
    let p4:[]u8="pBt";let r4:[]u8="pBu";
    let k:i32=0;
    while(k<5){
        let pat:[]u8=p0;let rep:[]u8=r0;
        if(k==1){pat=p1;rep=r1;}
        if(k==2){pat=p2;rep=r2;}
        if(k==3){pat=p3;rep=r3;}
        if(k==4){pat=p4;rep=r4;}
        let pl:i32=pat.len;
        let pos:i32=0;
        while(pos+pl<=len){
            let m:i32=1;let q:i32=0;
            while(q<pl){if(out[pos+q]!=pat[q]){m=0;break;}q=q+1;}
            if(m==1){q=0;while(q<pl){out[pos+q]=rep[q];q=q+1;}pos=pos+pl;}
            else{pos=pos+1;}
        }
        k=k+1;
    }
}
// verify a unit is fully repaired: live, no shift/patch flags,
// recalled copy == source for the claimed span
fn unit_verified(s:*E,bb:*BigBuf,base:i64,corpus:i32,
                 idx:i32,bout:[]u8) i32 {
    let id:i32=unit_id(corpus,idx);
    let sl:i32=slot_find(s,id);
    if(sl<0){return 0;}
    let f:i32=iget(s.*.flags,sl*4);
    if((f & F_LIVE)==0){return 0;}
    if((f & (F_SHIFT | F_PATCH))!=0){return 0;}
    let off:i64=(idx as i64)*64;
    let len:i64=(bb.*.len-base)-off;
    if(len>64){len=64;}
    let rl:i32=e_recall(s,id,bout);
    if((rl as i64)!=len){return 0;}
    let win:[]u8=nio_alloc(64);
    bb_copy(bb,base+off,win,len as i32);
    let i:i32=0;
    while(i<(len as i32)){if(bout[i]!=win[i]){nio_free(win);return 0;}i=i+1;}
    nio_free(win);
    return 1;
}

// ---- M1: single-corpus recall ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,keyp:[]u8,jmode:[]u8,scale:[]u8) void {
    let bb:BigBuf=read_big(cdir,fname);
    if(bb.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(bb.len);
    let s:E=e_new(n+n/4+2048,n+2048,n+1024,(n as i64)*64+64);
    let bout:[]u8=halloc(&s,64);
    ingest_all(&s,&bb,corpus,0);
    let cok:i32=0;let bok:i32=0;
    probe_reg(&s,&bb,0,corpus,bout,&cok,&bok);
    _zag_print("M1,");
    _zag_print(fname);_zag_print(",");
    p_dec1(cok as i64);_zag_print(",");p_dec1(bok as i64);
    _zag_print(",");p_i64(n as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode,scale);
    jf_dec1(&f,"m1_recall_tenths",cok as i64);
    jf_dec1(&f,"m1_boundary_tenths",bok as i64);
    jf_int(&f,"m1_units",n as i64);
    jf_str(&f,"m1_corpus",keyp);
    j_end();
    hfree(&s,bout);
}

// ---- M2: tiered curriculum ----
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32,scale:[]u8) void {
    let bb:BigBuf=read_big(cdir,fname);
    if(bb.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(bb.len);
    let s:E=e_new(n+n/4+2048,64,n+1024,(n as i64)*64+64);
    let bout:[]u8=halloc(&s,64);
    // episode 0 probe on empty store
    let cok:i32=0;let bok:i32=0;
    probe_reg(&s,&bb,0,corpus,bout,&cok,&bok);
    let r0:i64=cok as i64;
    // M9 curve storage (max 51 episodes)
    let rs:[]u8=halloc(&s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i32=cok;let bc:i32=bok;
    while(e<=50){
        ingest_all(&s,&bb,corpus,0);
        probe_reg(&s,&bb,0,corpus,bout,&cok,&bok);
        iput(rs,e*4,cok);
        nep=e+1;
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc=cok;bc=bok;break;}
        rc=cok;bc=bok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(tier,scale);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        // M9 literal descriptors (frozen cutoffs 40/15/3)
        let npts:i32=nep;
        let takeoff:i32=npts;
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){
        j_end();
    }
    hfree(&s,bout);hfree(&s,rs);
}

// ---- M3: strength trial ----
fn t_m3(cdir:[]u8) void {
    let prose:BigBuf=read_big(cdir,"prose.bin");
    let code:BigBuf=read_big(cdir,"code.bin");
    let fresh:BigBuf=read_big(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let total:i32=nun_p+nun_c;
    let k:i32=total/E_M3_V;
    if(k<1){k=1;}
    let s:E=e_new(E_M3_CAP,24000,9000,8000*64+1024);
    let bout:[]u8=halloc(&s,64);
    // V: ingest + mark
    let v_ids:[]u8=halloc(&s,E_M3_V*4);
    let v_corpus:[]u8=halloc(&s,E_M3_V*4);
    let v_idx:[]u8=halloc(&s,E_M3_V*4);
    let v:i32=0;
    while(v<E_M3_V){
        let g:i32=v*k;
        let cid:i32=E_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=E_C_CODE;idx=g-nun_p;}
        let id:i32=unit_id(cid,idx);
        let off:i64=(idx as i64)*64;
        let buflen:i64=prose.len;let bb:*BigBuf=&prose;
        if(cid==E_C_CODE){buflen=code.len;bb=&code;}
        let len:i64=buflen-off;
        if(len>64){len=64;}
        e_ingest(&s,bb,id,cid,0,off as i32,len as i32);
        e_mark_valuable(&s,id);
        iput(v_ids,v*4,id);iput(v_corpus,v*4,cid);iput(v_idx,v*4,idx);
        v=v+1;
    }
    // phase 1: 3000 fresh ingests
    let f:i32=0;
    while(f<E_M3_FRESH1){
        let off:i64=(f as i64)*64;
        let len:i64=fresh.len-off;
        if(len>64){len=64;}
        e_ingest(&s,&fresh,unit_id(E_C_FRESH,f),E_C_FRESH,0,off as i32,len as i32);
        f=f+1;
    }
    let n_p1:i32=s.led_n;
    // phase 2: 3000 fresh-only kills
    f=0;
    while(f<E_M3_KILL){
        e_kill(&s,unit_id(E_C_FRESH,f),1);
        f=f+1;
    }
    // weaken probe: 50 weaken ops on every 20th valuable (documented policy)
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        let vj:i32=w*20;
        let id:i32=iget(v_ids,vj*4);
        if(e_weaken(&s,id,w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let n_p2:i32=s.led_n;
    // phase 3: 4000 ingests at capacity, evict-oldest-unpinned as needed
    f=E_M3_FRESH1;
    while(f<E_M3_FRESH1+E_M3_FRESH2){
        let id:i32=unit_id(E_C_FRESH,f);
        let off:i64=(f as i64)*64;
        let len:i64=fresh.len-off;
        if(len>64){len=64;}
        let sl:i32=slot_insert_new(&s,id,off as i32,len as i32,E_C_FRESH);
        if(sl<0){
            e_evict_oldest_unpinned(&s);
            sl=slot_insert_new(&s,id,off as i32,len as i32,E_C_FRESH);
        }
        if(sl>=0){
            let at:i64=ar_reserve(&s,len as i32);
            if(at<0){
                e_led(&s,OP_REFUSE,sl,1,off as i32,0,len as i32,E_C_FRESH,id,
                      0,0,0,0,0,104,0);
            }
            if(at>=0){
                let tmp:[]u8=nio_alloc(len as i32);
                bb_copy(&fresh,off,tmp,len as i32);
                ar_write(&s,at,tmp,len as i32);
                nio_free(tmp);
                iput(s.apos,sl*4,at as i32);
                e_led(&s,OP_ADD,sl,0,off as i32,0,len as i32,E_C_FRESH,id,
                      0,0,0,0,0,id,0);
            }
        }else{
            e_led(&s,OP_REFUSE,-1,1,off as i32,0,len as i32,E_C_FRESH,id,
                  0,0,0,0,0,103,0);
        }
        f=f+1;
    }
    let n_p3:i32=s.led_n;
    // metrics: survival recall of V via the copy path
    let surv_ok:i32=0;
    let win:[]u8=nio_alloc(64);
    v=0;
    while(v<E_M3_V){
        let id:i32=iget(v_ids,v*4);let cid:i32=iget(v_corpus,v*4);let idx:i32=iget(v_idx,v*4);
        let off:i64=(idx as i64)*64;
        let buflen:i64=prose.len;let bb:*BigBuf=&prose;
        if(cid==E_C_CODE){buflen=code.len;bb=&code;}
        let len:i64=buflen-off;
        if(len>64){len=64;}
        let rl:i32=e_recall(&s,id,bout);
        if((rl as i64)==len){
            bb_copy(bb,off,win,len as i32);
            let good:i32=1;let q:i32=0;
            while(q<(len as i32)){if(bout[q]!=win[q]){good=0;break;}q=q+1;}
            if(good==1){surv_ok=surv_ok+1;}
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(E_M3_V as i64);
    // fresh sample: last 500 ingested (f=6500..6999)
    let fs_ok:i32=0;
    f=E_M3_FRESH1+E_M3_FRESH2-500;
    while(f<E_M3_FRESH1+E_M3_FRESH2){
        let id:i32=unit_id(E_C_FRESH,f);
        let off:i64=(f as i64)*64;
        let len:i64=fresh.len-off;
        if(len>64){len=64;}
        let rl:i32=e_recall(&s,id,bout);
        if((rl as i64)==len){
            bb_copy(&fresh,off,win,len as i32);
            let good:i32=1;let q:i32=0;
            while(q<(len as i32)){if(bout[q]!=win[q]){good=0;break;}q=q+1;}
            if(good==1){fs_ok=fs_ok+1;}
        }
        f=f+1;
    }
    nio_free(win);
    let fresht:i64=(fs_ok as i64)*1000/500;
    // liveness: management ops in ledger entries [n_p1, n_p3)
    let mgmt:i32=0;let le:i32=n_p1;
    while(le<n_p3){
        let op:i32=led_op(&s,le);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_PROMOTE || op==OP_EVICT || op==OP_REFUSE){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let ff:i32=0;
    j_begin("m3-1x","1x");
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",E_M3_V as i64);
    j_end();
    hfree(&s,bout);
    hfree(&s,v_ids);hfree(&s,v_corpus);hfree(&s,v_idx);
}

// ---- M4: defect revision ----
fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,is_code:i32,keyp:[]u8,scale:[]u8) void {
    let bb:BigBuf=read_big(cdir,fname);
    if(bb.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(bb.len);
    let s:E=e_new(n+n/4+2048,n+8192,n+1024,(n as i64)*64+64);
    let bout:[]u8=halloc(&s,64);
    let patch:[]u8=halloc(&s,64);
    ingest_all(&s,&bb,corpus,0);
    let d_idx:[]u8=halloc(&s,E_M4_N*4);
    // plant: 100 boundary (j<100), 100 content (j>=100)
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    let j:i32=0;
    while(j<E_M4_N){
        let idx:i32=j*n/E_M4_N;
        iput(d_idx,j*4,idx);
        let id:i32=unit_id(corpus,idx);
        if(j<100){
            e_defect_boundary(&s,id,iget(cyc,(j%12)*4));
        }else{
            let off:i64=(idx as i64)*64;
            let len:i64=bb.len-off;
            if(len>64){len=64;}
            if(is_code==1){code_rename(&bb,0,off,len as i32,patch);}
            else{patch_prose_xor(&bb,0,off,len as i32,patch);}
            e_defect_content(&s,id,patch,len as i32);
        }
        j=j+1;
    }
    // revision episodes
    let rep_b:i32=0;let rep_c:i32=0;
    let ep:i32=1;
    while(ep<=20){
        j=0;
        while(j<E_M4_N){
            e_revise(&s,&bb,0,unit_id(corpus,iget(d_idx,j*4)));
            j=j+1;
        }
        rep_b=0;rep_c=0;
        j=0;
        while(j<100){
            rep_b=rep_b+unit_verified(&s,&bb,0,corpus,iget(d_idx,j*4),bout);
            j=j+1;
        }
        j=100;
        while(j<E_M4_N){
            rep_c=rep_c+unit_verified(&s,&bb,0,corpus,iget(d_idx,j*4),bout);
            j=j+1;
        }
        if(rep_b+rep_c>=E_M4_N){break;}
        ep=ep+1;
    }
    // classify kills
    let killed:i32=0;
    j=0;
    while(j<E_M4_N){
        let sl:i32=slot_find(&s,unit_id(corpus,iget(d_idx,j*4)));
        if(sl>=0){
            let f:i32=iget(s.flags,sl*4);
            if((f & F_LIVE)==0){killed=killed+1;}
        }else{killed=killed+1;}
        j=j+1;
    }
    let rev_bt:i64=(rep_b as i64)*1000/100;
    let rev_ct:i64=(rep_c as i64)*1000/100;
    let kill_t:i64=(killed as i64)*1000/(E_M4_N as i64);
    let ksub:i32=0;
    if(kill_t>500 && (rev_bt<800 || rev_ct<800)){ksub=1;}
    _zag_print("M4,");_zag_print(keyp);_zag_print(",");
    p_dec1(rev_bt);_zag_print(",");p_dec1(rev_ct);_zag_print(",");
    p_dec1(kill_t);_zag_print(",");p_i64(ksub as i64);_zag_println("");
    let f:i32=0;
    j_begin(keyp,scale);
    jf_dec1(&f,"m4_rev_boundary_tenths",rev_bt);
    jf_dec1(&f,"m4_rev_content_tenths",rev_ct);
    jf_dec1(&f,"m4_kill_rate_tenths",kill_t);
    jf_bool(&f,"m4_killsub",ksub);
    jf_int(&f,"m4_episodes",ep as i64);
    j_end();
    hfree(&s,bout);hfree(&s,patch);
    hfree(&s,cyc);hfree(&s,d_idx);
}

// ---- M5: resource pressure ----
fn t_m5(cdir:[]u8,jmode:[]u8,scale:[]u8) void {
    let prose:BigBuf=read_big(cdir,"prose.bin");
    let fresh:BigBuf=read_big(cdir,"churn_fresh.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(prose.len);
    let s:E=e_new(n+n/4+4096,n+4096,n+2048,((n+500) as i64)*64+1024);
    let bout:[]u8=halloc(&s,64);
    ingest_all(&s,&prose,E_C_PROSE,0);
    // mini-pressure: 500 fresh ingests + 500 kills
    let f:i32=0;
    while(f<500){
        let off:i64=(f as i64)*64;
        let len:i64=fresh.len-off;
        if(len>64){len=64;}
        e_ingest(&s,&fresh,unit_id(E_C_FRESH,f),E_C_FRESH,0,off as i32,len as i32);
        f=f+1;
    }
    f=0;
    while(f<500){e_kill(&s,unit_id(E_C_FRESH,f),2);f=f+1;}
    // learned = byte-exact recall of the stored copies now
    let l:i32=0;let src:i64=0;
    let win:[]u8=nio_alloc(64);
    let i2:i32=0;
    while(i2<n){
        let id:i32=unit_id(E_C_PROSE,i2);
        let off:i64=(i2 as i64)*64;
        let len:i64=prose.len-off;
        if(len>64){len=64;}
        let rl:i32=e_recall(&s,id,bout);
        if((rl as i64)==len){
            bb_copy(&prose,off,win,len as i32);
            let good:i32=1;let q:i32=0;
            while(q<(len as i32)){if(bout[q]!=win[q]){good=0;break;}q=q+1;}
            if(good==1){l=l+1;src=src+len;}
        }
        i2=i2+1;
    }
    nio_free(win);
    // slot region = 8 slot arrays + insertion queue + arena bytes actually
    // stored (the copies ARE E's persistent storage)
    let slot_bytes:i64=(s.cap as i64)*32+(s.ins_cap as i64)*4+s.ar_used;
    let ledger_bytes:i64=(s.led_n as i64)*64;
    let wf:i32=write_ledger(&s,".","ledger.bin");
    _zag_print("M5,");p_i64(l as i64);_zag_print(",");
    p_i64(src);_zag_print(",");p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin(jmode,scale);
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",prose.len);
    j_end();
    hfree(&s,bout);
}

// ---- M6: transfer tax ----
fn t_m6(cdir:[]u8,dir:i32,scale:[]u8) void {
    // dir 0 = prose->code, 1 = code->prose
    let tname:[]u8="t1_prose.bin";let tcid:i32=E_C_T1P;
    let yname:[]u8="code.bin";let ycid:i32=E_C_CODE;
    let dkey:[]u8="m6-p2c-1x";let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=E_C_T1C;yname="prose.bin";ycid=E_C_PROSE;
        dkey="m6-c2p-1x";dtag="c2p";
    }
    let tbuf:BigBuf=read_big(cdir,tname);
    let ybuf:BigBuf=read_big(cdir,yname);
    if(tbuf.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let nt:i32=nunits_of(tbuf.len);let ny:i32=nunits_of(ybuf.len);
    let s:E=e_new(nt+ny+(nt+ny)/4+8192,nt+ny+8192,nt+ny+2048,((nt+ny) as i64)*64+1024);
    let bout:[]u8=halloc(&s,64);
    // train on tier-1 to the M2 criterion (policy frozen afterwards: no-op for E)
    let cok:i32=0;let bok:i32=0;
    let e:i32=1;let consec:i32=0;let etc:i32=50;
    while(e<=50){
        ingest_all(&s,&tbuf,tcid,0);
        probe_reg(&s,&tbuf,0,tcid,bout,&cok,&bok);
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;break;}
        e=e+1;
    }
    let rec_d:i64=cok as i64;let bnd_d:i64=bok as i64;
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    // in-domain revision: 100 boundary defects on train units
    let j:i32=0;
    while(j<100){
        let idx:i32=j*nt/100;
        e_defect_boundary(&s,unit_id(tcid,idx),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        e_revise(&s,&tbuf,0,unit_id(tcid,j*nt/100));
        j=j+1;
    }
    let rev_d:i32=0;
    j=0;
    while(j<100){
        rev_d=rev_d+unit_verified(&s,&tbuf,0,tcid,j*nt/100,bout);
        j=j+1;
    }
    let rev_dt:i64=(rev_d as i64)*10;
    // transfer: face the new domain (ingest allowed, policy frozen)
    ingest_all(&s,&ybuf,ycid,0);
    let rec_t:i32=0;let bnd_t:i32=0;
    probe_reg(&s,&ybuf,0,ycid,bout,&rec_t,&bnd_t);
    // transfer revision
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        e_defect_boundary(&s,unit_id(ycid,idx),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        e_revise(&s,&ybuf,0,unit_id(ycid,j*ny/100));
        j=j+1;
    }
    let rev_t:i32=0;
    j=0;
    while(j<100){
        rev_t=rev_t+unit_verified(&s,&ybuf,0,ycid,j*ny/100,bout);
        j=j+1;
    }
    let rev_tt:i64=(rev_t as i64)*10;
    let tax:i64=((rec_d-(rec_t as i64))+((bnd_d-(bnd_t as i64)))+(rev_dt-rev_tt))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t as i64);_zag_print(",");p_dec1(bnd_t as i64);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_println("");
    let f:i32=0;
    j_begin(dkey,scale);
    jf_dec1(&f,"rec_tenths",rec_t as i64);
    jf_dec1(&f,"bnd_tenths",bnd_t as i64);
    jf_dec1(&f,"rev_tenths",rev_tt);
    jf_dec1(&f,"tax_tenths",tax);
    j_end();
    hfree(&s,bout);hfree(&s,cyc);
}

// ---- M7: E is non-ID -> N/A + re-read byte count ----
fn t_m7(cdir:[]u8) void {
    let prose:BigBuf=read_big(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(prose.len);
    let s:E=e_new(n+n/4+2048,n+2048,n+1024,(n as i64)*64+64);
    let bout:[]u8=halloc(&s,64);
    // round 0: ingest C; round 1: ingest C again (revive path)
    ingest_all(&s,&prose,E_C_PROSE,0);
    ingest_all(&s,&prose,E_C_PROSE,0);
    let reread:i64=0;
    let l:i32=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let rl:i32=e_recall(&s,unit_id(E_C_PROSE,idx),bout);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    // round 2: C' = C with deterministic every-100th-unit edits
    // (E edit mechanism: recorded byte patch, audited as trainer op)
    let ep2:[]u8=halloc(&s,64);
    let q:i32=0;
    while(q<n){
        if(q%100==0){
            let off:i64=(q as i64)*64;
            let len:i64=prose.len-off;
            if(len>64){len=64;}
            bb_copy(&prose,off,ep2,len as i32);
            ep2[0]=((ep2[0] as i32) ^ 255) as u8;
            e_defect_content(&s,unit_id(E_C_PROSE,q),ep2,len as i32);
        }
        q=q+1;
    }
    hfree(&s,ep2);
    while(l<E_M7_LOOKUPS){
        let idx:i32=(l*37)%n;
        let rl:i32=e_recall(&s,unit_id(E_C_PROSE,idx),bout);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    _zag_print("M7,non-id,");p_i64(reread);_zag_println("");
    let f:i32=0;
    j_begin("m7-1x","1x");
    jf_null(&f,"m7_hit_rate_tenths");
    jf_null(&f,"m7_reuse_rate_tenths");
    jf_null(&f,"m7_dedup_savings_bytes");
    jf_str(&f,"m7_na_reason","no ID layer: unit keys are positional, recall serves owned byte copies");
    jf_int(&f,"m7_reread_bytes",reread);
    j_end();
    hfree(&s,bout);
}

// ---- M8: determinism gate ----
fn img_append(dst:[]u8,at:i32,src:[]u8,n:i32) i32 {
    let i:i32=0;while(i<n){dst[at+i]=src[i];i=i+1;}
    return at+n;
}
// append arena bytes [0..used) to the store image (handles shard straddle)
fn img_append_arena(s:*E,dst:[]u8,at:i32) i32 {
    let used:i64=s.*.ar_used;
    let stride:i64=s.*.ar_cap0 as i64;
    let rem:i64=used;let pos:i64=0;
    let si:i32=0;
    while(rem>0){
        if(si>=4){break;} // unreachable: pos stays within ar_used
        let base:i64=(si as i64)*stride;
        let cap:i64=ar_shard_cap(s,si);
        if(cap>0 && pos>=base && pos<base+cap){
            let sh:[]u8=ar_shard(s,si);
            let o:i64=pos-base;
            let navail:i64=cap-o;
            let take:i64=rem;
            if(take>navail){take=navail;}
            let k:i64=0;
            while(k<take){dst[at+(pos as i32)+(k as i32)]=sh[(o as i32)+(k as i32)];k=k+1;}
            pos=pos+take;rem=rem-take;
        }
        si=si+1;
    }
    return at+(used as i32);
}
fn write_hex_line(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    // "<tag> <hex>\n"
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[tag.len]=32;
    let k:i32=0;while(k<hx.len){line[tag.len+1+k]=hx[k];k=k+1;}
    line[tag.len+1+hx.len]=10;
    let r:i32=write_file(dir,fname,line);
    nio_free(hx);nio_free(line);
    return r;
}
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    // perturbations (raw allocations bypass the logged trace: the trace must
    // capture only the arm's own allocations, identical across perturbations)
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            // survivors leak intentionally: freed by OS at exit; identical each run
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){
        aslr_pad=nio_alloc(1234567);
    }
    // freelist-rev / starve: accepted, documented no-ops for E
    // (slot placement is a pure function of the unit key; clock/entropy unused)
    let prose:BigBuf=read_big(cdir,"prose.bin");
    let code:BigBuf=read_big(cdir,"code.bin");
    let fresh:BigBuf=read_big(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let nun_f:i32=nunits_of(fresh.len);
    let cap:i32=nun_p+nun_c+(nun_p+nun_c)/4+16384;
    let s:E=e_new(cap,260000,nun_p+nun_c+9000,((nun_p+nun_c+nun_f) as i64)*64+1024);
    let bout:[]u8=halloc(&s,64);
    // M1: ingest + full recall both corpora
    ingest_all(&s,&prose,E_C_PROSE,0);
    let cok:i32=0;let bok:i32=0;
    probe_reg(&s,&prose,0,E_C_PROSE,bout,&cok,&bok);
    let m1p:i32=cok;
    ingest_all(&s,&code,E_C_CODE,0);
    probe_reg(&s,&code,0,E_C_CODE,bout,&cok,&bok);
    let m1c:i32=cok;
    // M3 sequence on the same instance (V = every k-th over both corpora)
    let total:i32=nun_p+nun_c;
    let k:i32=total/E_M3_V;if(k<1){k=1;}
    let v:i32=0;
    while(v<E_M3_V){
        let g:i32=v*k;
        let cid:i32=E_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=E_C_CODE;idx=g-nun_p;}
        e_mark_valuable(&s,unit_id(cid,idx));
        v=v+1;
    }
    let f:i32=0;
    while(f<E_M3_FRESH1){
        let off:i64=(f as i64)*64;
        let len:i64=fresh.len-off;
        if(len>64){len=64;}
        e_ingest(&s,&fresh,unit_id(E_C_FRESH,f),E_C_FRESH,0,off as i32,len as i32);
        f=f+1;
    }
    f=0;
    while(f<E_M3_KILL){e_kill(&s,unit_id(E_C_FRESH,f),1);f=f+1;}
    let w:i32=0;
    while(w<50){
        let g2:i32=(w*20)*k;
        let cid2:i32=E_C_PROSE;let idx2:i32=g2;
        if(g2>=nun_p){cid2=E_C_CODE;idx2=g2-nun_p;}
        e_weaken(&s,unit_id(cid2,idx2),w+1);
        w=w+1;
    }
    f=E_M3_FRESH1;
    while(f<E_M3_FRESH1+E_M3_FRESH2){
        let id:i32=unit_id(E_C_FRESH,f);
        let off:i64=(f as i64)*64;
        let len:i64=fresh.len-off;
        if(len>64){len=64;}
        let sl:i32=slot_insert_new(&s,id,off as i32,len as i32,E_C_FRESH);
        if(sl<0){
            e_evict_oldest_unpinned(&s);
            sl=slot_insert_new(&s,id,off as i32,len as i32,E_C_FRESH);
        }
        if(sl>=0){
            let at:i64=ar_reserve(&s,len as i32);
            if(at<0){
                e_led(&s,OP_REFUSE,sl,1,off as i32,0,len as i32,E_C_FRESH,id,
                      0,0,0,0,0,104,0);
            }
            if(at>=0){
                let tmp:[]u8=nio_alloc(len as i32);
                bb_copy(&fresh,off,tmp,len as i32);
                ar_write(&s,at,tmp,len as i32);
                nio_free(tmp);
                iput(s.apos,sl*4,at as i32);
                e_led(&s,OP_ADD,sl,0,off as i32,0,len as i32,E_C_FRESH,id,
                      0,0,0,0,0,id,0);
            }
        }
        f=f+1;
    }
    // artifacts
    // store image: raw LE bytes of the slot arrays
    // (ids, offs, lens, corps, flags, shifts, pidx, apos: cap*4 each;
    //  ins: ins_cap*4) PLUS the arena bytes actually stored (the copies are
    //  E's persistent memory; they must be in the image for M8 to mean
    //  anything for this arm).
    let img:[]u8=halloc(&s,cap*32+s.ins_cap*4+(s.ar_used as i32)+64);
    let at:i32=0;
    at=img_append(img,at,s.ids,cap*4);
    at=img_append(img,at,s.offs,cap*4);
    at=img_append(img,at,s.lens,cap*4);
    at=img_append(img,at,s.corps,cap*4);
    at=img_append(img,at,s.flags,cap*4);
    at=img_append(img,at,s.shifts,cap*4);
    at=img_append(img,at,s.pidx,cap*4);
    at=img_append(img,at,s.apos,cap*4);
    at=img_append(img,at,s.ins,s.ins_cap*4);
    at=img_append_arena(&s,img,at);
    // per-2^20-chunk sha256 of image, then chain
    let imglen:i32=at;
    let nch:i32=(imglen+1048575)/1048576;
    let chain_in:[]u8=halloc(&s,nch*32);
    let ci:i32=0;
    while(ci<nch){
        let cs:i32=ci*1048576;let cn:i32=imglen-cs;
        if(cn>1048576){cn=1048576;}
        ns_sha256(img[cs..cs+cn],chain_in[ci*32..ci*32+32]);
        ci=ci+1;
    }
    let chl:[]u8=halloc(&s,nch*80);
    let cho:i32=0;
    ci=0;
    while(ci<nch){
        let cs:i32=ci*32;
        let hx:[]u8=ns_hex(chain_in[cs..cs+32]);
        let tag:[]u8=_zag_i64_to_str(ci as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<hx.len){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        nio_free(hx);nio_free(tag);
        ci=ci+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=halloc(&s,32);
    ns_sha256(chain_in[0..nch*32],chain);
    write_hex_line(outdir,"store_chain.txt","chain",chain);
    write_ledger(&s,outdir,"ledger.bin");
    let lhash:[]u8=halloc(&s,32);
    // hash the ledger without materializing it: per-<=2^20-chunk sha256 of
    // each shard region in order, then chain the chunk hashes.
    let ltot:i64=(s.led_n as i64)*64;
    let shb:i64=s.led_shard as i64;
    // incremental-style: hash each <=2^20 piece of each shard, then chain
    let maxp:i64=(ltot+1048575)/1048576;
    if(maxp<1){maxp=1;}
    let lci:[]u8=halloc(&s,(maxp as i32)*32);
    let pi:i64=0;let pco:i32=0;
    while(pi<ltot){
        let sh:i64=pi/shb;
        let so:i64=pi-sh*shb;
        let l:[]u8=led_shard(&s,sh);
        let n:i64=ltot-pi;
        let seg:i64=shb-so;
        if(n>seg){n=seg;}
        if(n>1048576){n=1048576;}
        ns_sha256(l[(so as i32)..(so as i32)+(n as i32)],lci[pco*32..pco*32+32]);
        pco=pco+1;pi=pi+n;
    }
    ns_sha256(lci[0..pco*32],lhash);
    write_hex_line(outdir,"ledger_chain.txt","chain",lhash);
    write_file(outdir,"alloc_trace.txt",s.trace[0..s.trace_n]);
    // stdout stays perturbation-agnostic: the runner's directory records which
    // perturbation ran, and m8_compare.py requires byte-identical stdout.
    _zag_print("M8,");
    p_dec1(m1p as i64);_zag_print(",");p_dec1(m1c as i64);_zag_print(",");
    p_i64(s.led_n as i64);_zag_println("");
    hfree(&s,bout);hfree(&s,chain_in);hfree(&s,chl);hfree(&s,lci);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
    // frag survivors: freed by OS at exit
}

// ---- main dispatch ----
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len==0){_zag_println("usage: e <mode> [corpus-root] [outdir] [perturbation]");return 2;}
    let croot:[]u8=_zag_arg(2);
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(croot,"prose.bin",E_C_PROSE,"prose","m1-1x-prose","1x");}
    else if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(croot,"code.bin",E_C_CODE,"code","m1-1x-code","1x");}
    else if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(croot,"t1_prose.bin",E_C_T1P,"m2-t1-prose",1,"1x");}
    else if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(croot,"t1_code.bin",E_C_T1C,"m2-t1-code",1,"1x");}
    else if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(croot,"t2_prose.bin",E_C_T2P,"m2-t2-prose",0,"1x");}
    else if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(croot,"t2_code.bin",E_C_T2C,"m2-t2-code",0,"1x");}
    else if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(croot,"t3.bin",E_C_T3,"m2-t3-1x",0,"1x");}
    else if(_zag_strcmp(mode,"m3-1x")==1){t_m3(croot);}
    else if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(croot,"prose.bin",E_C_PROSE,0,"m4-1x-prose","1x");}
    else if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(croot,"code.bin",E_C_CODE,1,"m4-1x-code","1x");}
    else if(_zag_strcmp(mode,"m5-1x")==1){t_m5(croot,"m5-1x","1x");}
    else if(_zag_strcmp(mode,"m5-baseline")==1){
        // Empty-store RSS baseline: allocate the same empty store m5-1x uses
        // (slot arrays + insertion queue + FULL arena capacity + ledger),
        // touch it fully, then spin so the harness RSS sampler observes the
        // peak. The spin is measurement scaffolding, not arm cognition.
        let psz:i64=file_size(croot,"prose.bin");
        if(psz<=0){_zag_println("M5,FATAL,empty-corpus");return 1;}
        let pn:i32=nunits_of(psz);
        let bs:E=e_new(pn+pn/4+4096,pn+4096,pn+2048,((pn+500) as i64)*64+1024);
        // fully touch the empty store so it is resident (AMBIGUITIES.md A4)
        let b0:[]u8=bs.ids;let b1:[]u8=bs.offs;let b2:[]u8=bs.lens;let b3:[]u8=bs.corps;
        let b4:[]u8=bs.flags;let b5:[]u8=bs.shifts;let b6:[]u8=bs.pidx;let b7:[]u8=bs.apos;
        let b8:[]u8=bs.ins;
        let bj:i32=0;
        while(bj<b0.len){b0[bj]=0;b1[bj]=0;b2[bj]=0;b3[bj]=0;b4[bj]=0;b5[bj]=0;b6[bj]=0;b7[bj]=0;bj=bj+1;}
        bj=0;
        while(bj<b8.len){b8[bj]=0;bj=bj+1;}
        let aq:i32=0;
        while(aq<4){
            let aa:[]u8=ar_shard(&bs,aq);
            bj=0;
            while(bj<aa.len){aa[bj]=0;bj=bj+1;}
            aq=aq+1;
        }
        let l0:[]u8=bs.led0;
        bj=0;
        while(bj<l0.len){l0[bj]=0;bj=bj+1;}
        let lq:i32=0;
        while(lq<4){
            let ll:[]u8=led_shard(&bs,lq as i64);
            bj=0;
            while(bj<ll.len){ll[bj]=0;bj=bj+1;}
            lq=lq+1;
        }
        _zag_println("M5_BASELINE,ok");
        let f:i32=0;
        j_begin("m5-baseline","1x");
        jf_bool(&f,"m5_baseline",1);
        j_end();
        let spin:i64=0;while(spin<300000000){spin=spin+1;}
    }
    else if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(croot,0,"1x");}
    else if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(croot,1,"1x");}
    else if(_zag_strcmp(mode,"m7-1x")==1){t_m7(croot);}
    else if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        if(outdir.len==0 || pert.len==0){
            _zag_println("usage: e m8-1x <corpus-root> <outdir> <perturbation>");
            return 2;
        }
        t_m8(croot,outdir,pert);
    }
    // 10x scale legs (kill-criterion evidence; same procedures on the 10x
    // corpus built by build_10x.py). Full 10x battery is not required by any
    // frozen bar for E; the 10x scope is m1 (both corpora, equal-M1 check)
    // + m5 (stored bytes) — see ARM_SPEC.md §7.
    else if(_zag_strcmp(mode,"m1-10x-prose")==1){t_m1(croot,"prose.bin",E_C_PROSE,"prose","m1-10x-prose","10x");}
    else if(_zag_strcmp(mode,"m1-10x-code")==1){t_m1(croot,"code.bin",E_C_CODE,"code","m1-10x-code","10x");}
    else if(_zag_strcmp(mode,"m5-10x")==1){t_m5(croot,"m5-10x","10x");}
    else if(_zag_strcmp(mode,"m5-baseline-10x")==1){
        let psz:i64=file_size(croot,"prose.bin");
        if(psz<=0){_zag_println("M5,FATAL,empty-corpus");return 1;}
        let pn:i32=nunits_of(psz);
        let bs:E=e_new(pn+pn/4+4096,pn+4096,pn+2048,((pn+500) as i64)*64+1024);
        let b0:[]u8=bs.ids;let b1:[]u8=bs.offs;let b2:[]u8=bs.lens;let b3:[]u8=bs.corps;
        let b4:[]u8=bs.flags;let b5:[]u8=bs.shifts;let b6:[]u8=bs.pidx;let b7:[]u8=bs.apos;
        let b8:[]u8=bs.ins;
        let bj:i32=0;
        while(bj<b0.len){b0[bj]=0;b1[bj]=0;b2[bj]=0;b3[bj]=0;b4[bj]=0;b5[bj]=0;b6[bj]=0;b7[bj]=0;bj=bj+1;}
        bj=0;
        while(bj<b8.len){b8[bj]=0;bj=bj+1;}
        let aq:i32=0;
        while(aq<4){
            let aa:[]u8=ar_shard(&bs,aq);
            bj=0;
            while(bj<aa.len){aa[bj]=0;bj=bj+1;}
            aq=aq+1;
        }
        let l0:[]u8=bs.led0;
        bj=0;
        while(bj<l0.len){l0[bj]=0;bj=bj+1;}
        let lq:i32=0;
        while(lq<4){
            let ll:[]u8=led_shard(&bs,lq as i64);
            bj=0;
            while(bj<ll.len){ll[bj]=0;bj=bj+1;}
            lq=lq+1;
        }
        _zag_println("M5_BASELINE,ok");
        let f:i32=0;
        j_begin("m5-baseline-10x","10x");
        jf_bool(&f,"m5_baseline",1);
        j_end();
        let spin:i64=0;while(spin<300000000){spin=spin+1;}
    }
    else{_zag_print("unknown mode: ");_zag_println(mode);return 2;}
    return 0;
}

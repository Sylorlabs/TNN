// arm4.zag — Arm 4 (symbolic-hints) fixture.
// Emits HINT events ONLY (T-8/T-10: no §P proposals at all).
// This compilation unit imports tape345.zag and NOT sp345.zag: the wire-codec
// symbols and the teacher-message event path do not exist in this binary.
// Emitting a proposal is not a runtime decision here — it is a compile error.
// HINT wire format v1 (frozen by this fixture):
//   u8  region_count (=1; one region per HINT event)
//   u64 region_start, u64 region_end   (byte range into the stimulus tape)
//   u8  uncertainty_flags (bit0 = low-confidence region)
// hint_bytes encode REGION spans (byte ranges worth attending to), never word
// spans: a hint whose region exactly equals a ground-truth unit span is a
// protocol violation by construction and is refused before emission.
// Deterministic hint policy:
//   - candidate units: slice ground truth, in fixed order (utility desc, then
//     start asc);
//   - region = [start - pad, end + pad], pad = max(8, span_len/2), clamped to
//     [0, stim_len); the padding guarantees the region is strictly larger than
//     the unit and does not reveal exact boundaries;
//   - if a padded region still exactly equals a unit span (degenerate case),
//     the region end is widened by +1 deterministically and re-checked;
//   - uncertainty by construction: regions whose unit utility is below the
//     top-quartile utility bar carry uncertainty_flags bit0=1;
//   - at most HINT_MAX=16 regions per slice (fixed deterministic bound);
//   - identical regions from different units are emitted once (dedup).
// All hints are logged as HINT events; replay is verbatim.
// Usage:
//   arm4 hints <gt_file> <tape_out>
//   arm4 test                      -- self-tests
@import("tape345.zag")
fn arm4_pad(span_len:i64)i64 {
    let p:i64=span_len/2;
    if(p<8){p=8;}
    return p;
}
// guard: 1 = refuse (region exactly equals some ground-truth unit span)
fn arm4_guard(g:*GT,rs:i64,re:i64)i32 {
    let i:i32=0;
    while(i<g[0].n){
        if(gt_start(g,i)==rs && gt_end(g,i)==re){return 1;}
        i=i+1;
    }
    return 0;
}
// order key for deterministic hint ordering: sort indices by (utility desc, start asc)
// simple deterministic insertion sort over indices (n <= 4096, fine)
fn arm4_order(g:*GT,idx:[]u8)i32 {
    let n:i32=g[0].n;
    let i:i32=0;while(i<n){t345_set64(idx,i*8,i as i64);i=i+1;}
    i=1;
    while(i<n){
        let k:i64=t345_get64(idx,i*8);let j:i32=i-1;
        while(j>=0){
            let a:i64=t345_get64(idx,j*8);
            let ua:i64=gt_util(g,a as i32);let uk:i64=gt_util(g,k as i32);
            let sa:i64=gt_start(g,a as i32);let sk:i64=gt_start(g,k as i32);
            let swap:i32=0;
            if(uk>ua){swap=1;}else if(uk==ua && sk<sa){swap=1;}
            if(swap==0){break;}
            t345_set64(idx,(j+1)*8,a);j=j-1;
        }
        t345_set64(idx,(j+1)*8,k);i=i+1;
    }
    return n;
}
fn arm4_capability_proposals()i32 {return 0;} // type-level: no proposal path exists
// Pinned frozen-prereg hash carried in the TAPE_HEADER prereg_hash field
// (PREREG_FREEZE.md §4 lines 565-729,
//  sha256=c7a9d57e3ac4d8ff48f4396c47eec9fedbfacb894584a31779a91a64deeef879).
// Written byte-explicitly by construction: uninitialized heap arrays are NOT
// reliably zeroed (standing toolchain note), so the field must be deterministic
// by construction, never by allocator luck. LE u32 words of the digest.
fn arm4_prereg_hash() []u8 {
    let h:[]u8=nio_alloc(32);
    t345_set32(h,0,0x7ed5a9c7);t345_set32(h,4,0xffd8c43a);
    t345_set32(h,8,0x6c39f448);t345_set32(h,12,0xfec9ee47);
    t345_set32(h,16,0x89cbfadb);t345_set32(h,20,0x17a38445);
    t345_set32(h,24,0x641aa979);t345_set32(h,28,0x79f8eede);
    return h;
}

fn arm4_run(gt_name:[]u8,tape_name:[]u8) i32 {
    let g:*GT=gt_load(gt_name);
    if(g[0].n<0){_zag_println("ARM4: bad ground truth");gt_free(g);return 13;}
    let t:*Tape=tape_open();
    let pr:[]u8=arm4_prereg_hash();
    let e:*TBuf=ev_header(1,4,pr,"arm4-symbolic-hints");
    tape_event(t,1,tbuf_bytes(e));tbuf_free(e);
    e=ev_stimulus(1,0,g[0].stim.len as i64);
    tape_event(t,2,tbuf_bytes(e));tbuf_free(e);
    nio_free(pr);
    // top-quartile utility bar for uncertainty flags
    let order:[]u8=nio_alloc(g[0].n*8);
    let n:i32=arm4_order(g,order);
    let bar:i64=0;
    if(n>0){
        let q4:i32=n/4;
        bar=gt_util(g,t345_get64(order,q4*8) as i32);
    }
    let emitted:i32=0;let oi:i32=0;
    let seen_r:[]u8=nio_alloc(16*8);let seen_e:[]u8=nio_alloc(16*8);let seen_n:i32=0;
    while(oi<n && emitted<16){
        let ui:i32=t345_get64(order,oi*8) as i32;
        let s:i64=gt_start(g,ui);let en:i64=gt_end(g,ui);let u:i64=gt_util(g,ui);
        let pad:i64=arm4_pad(en-s);
        let rs:i64=s-pad;if(rs<0){rs=0;}
        let re:i64=en+pad;if(re>g[0].stim.len){re=g[0].stim.len as i64;}
        // degenerate guard: never emit a region equal to a unit span
        if(arm4_guard(g,rs,re)==1){
            re=re+1;if(re>g[0].stim.len){re=g[0].stim.len as i64;rs=rs-1;if(rs<0){rs=0;}}
        }
        // dedup identical regions
        let dup:i32=0;let si:i32=0;
        while(si<seen_n){if(t345_get64(seen_r,si*8)==rs && t345_get64(seen_e,si*8)==re){dup=1;}si=si+1;}
        if(dup==0 && arm4_guard(g,rs,re)==0){
            t345_set64(seen_r,seen_n*8,rs);t345_set64(seen_e,seen_n*8,re);seen_n=seen_n+1;
            let flags:i32=0;
            if(u<bar){flags=1;} // uncertainty expressed by construction
            let h:*TBuf=ev_hint(rs,re,flags);
            tape_event(t,5,tbuf_bytes(h));tbuf_free(h);
            emitted=emitted+1;
        }
        oi=oi+1;
    }
    nio_free(order);nio_free(seen_r);nio_free(seen_e);
    let f:*TBuf=ev_footer(t[0].count,t[0].chain,"OK");
    tape_event(t,9,tbuf_bytes(f));tbuf_free(f);
    let wrc:i32=tape_write_file(t,tape_name);
    _zag_print("ARM4: hints=");_zag_print(_zag_i64_to_str(emitted as i64));
    _zag_print(" events=");_zag_print(_zag_i64_to_str(t[0].count));
    _zag_print(" chain=");_zag_println(ns_hex(t[0].chain));
    gt_free(g);tape_close(t);
    if(wrc!=0){_zag_println("ARM4: tape write failed");return 13;}
    return 0;
}

fn arm4_chk(name:[]u8,actual:i32,expected:i32,f:*i32)void {
    _zag_print("T345_TEST,");_zag_print(name);_zag_print(",");
    _zag_print(_zag_i64_to_str(actual as i64));_zag_print(",");_zag_println(_zag_i64_to_str(expected as i64));
    if(actual!=expected){f[0]=f[0]+1;}
}

fn arm4_test() i32 {
    let f:i32=0;
    // build a synthetic GT in memory via a temp file is overkill; use the demo gt file
    let g:*GT=gt_load("gt_demo.txt");
    arm4_chk("a4.gt.loads",((g[0].n>0) as i32),1,&f);
    // (1) no emitted region equals any unit span exactly (policy + guard)
    let order:[]u8=nio_alloc(g[0].n*8);
    let n:i32=arm4_order(g,order);
    let bad:i32=0;let oi:i32=0;
    while(oi<n && oi<16){
        let ui:i32=t345_get64(order,oi*8) as i32;
        let s:i64=gt_start(g,ui);let en:i64=gt_end(g,ui);
        let pad:i64=arm4_pad(en-s);
        let rs:i64=s-pad;if(rs<0){rs=0;}
        let re:i64=en+pad;if(re>g[0].stim.len){re=g[0].stim.len as i64;}
        if(arm4_guard(g,rs,re)==1){bad=1;}
        oi=oi+1;
    }
    arm4_chk("a4.hint.no_word_span",bad,0,&f);
    nio_free(order);
    // (2) guard refuses an exact unit span presented directly (runtime refusal)
    let u0s:i64=gt_start(g,0);let u0e:i64=gt_end(g,0);
    arm4_chk("a4.guard.refuses_exact",arm4_guard(g,u0s,u0e),1,&f);
    arm4_chk("a4.guard.allows_padded",arm4_guard(g,u0s-1,u0e+1),0,&f);
    // (3) capability: cannot emit §P proposals (type-level + runtime flag)
    arm4_chk("a4.capability.no_proposals",arm4_capability_proposals(),0,&f);
    // (4) ordering determinism: two runs of arm4_order agree
    let o1:[]u8=nio_alloc(g[0].n*8);let o2:[]u8=nio_alloc(g[0].n*8);
    arm4_order(g,o1);arm4_order(g,o2);
    arm4_chk("a4.order.deterministic",nio_equal(o1,o2),1,&f);
    nio_free(o1);nio_free(o2);
    gt_free(g);
    _zag_print("T345_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));
    if(f!=0){return 1;}return 0;
}

fn main()i32 {
    if(_zag_argc()<2){_zag_println("usage: arm4 <hints|test> [gt tape]");return 64;}
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"test")==1){return arm4_test();}
    if(_zag_strcmp(mode,"hints")==1 && _zag_argc()==4){return arm4_run(_zag_arg(2),_zag_arg(3));}
    _zag_println("usage: arm4 <hints|test> [gt tape]");return 64;
}

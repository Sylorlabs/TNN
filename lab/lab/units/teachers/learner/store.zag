// store.zag — Track B naive learner: hypothesis table, pin registry, ledger.
// Zero RNG, zero wallclock. All tables fixed-capacity, index-tie-broken
// deterministically, so every run is byte-identical given the same input.
// Structs are heap-allocated via _zag_malloc (fixtures345 pattern); all
// indexed access on struct array fields goes through a local alias first
// (znc large-struct indexing pitfall — see AGENTS.md).
@import("pcodec.zag")

const HS_CAP:i64 = 64

// Hypothesis status codes.
const HS_PENDING:i64 = 0
const HS_ADOPTED:i64 = 1
const HS_REJFINAL:i64 = 2
const HS_WITHDRAWN:i64 = 3
const HS_KILLED:i64 = 4

struct HypStore {
    cap:i64, n:i64,
    kind:[]i64, s:[]i64, e:[]i64,
    support:[]i64, conflict:[]i64,
    status:[]i64, teacher:[]i64,
    consec:[]i64, appeals:[]i64,
    last_seq:[]i64, last_gsig:[]i64,
    strength:[]i64, age:[]i64, defers:[]i64, rej_seq:[]i64
}

fn hs_init() *HypStore {
    let h:*HypStore = _zag_malloc(384) as *HypStore
    h[0].cap = HS_CAP
    h[0].n = 0
    h[0].kind = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].s = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].e = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].support = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].conflict = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].status = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].teacher = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].consec = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].appeals = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].last_seq = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].last_gsig = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].strength = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].age = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].defers = nio_alloc((HS_CAP*8) as i32) as []i64
    h[0].rej_seq = nio_alloc((HS_CAP*8) as i32) as []i64
    return h
}

// hs_find: index of hypothesis with exact (kind,s,e), else -1.
fn hs_find(h:*HypStore, kind:i64, s:i64, e:i64) i64 {
    let kk:[]i64 = h[0].kind
    let ss:[]i64 = h[0].s
    let ee:[]i64 = h[0].e
    let i:i64 = 0
    while (i < h[0].n) {
        if (kk[i] == kind && ss[i] == s && ee[i] == e) { return i }
        i = i + 1
    }
    return -1
}

// hs_evict: pick a slot for a new hypothesis. Prefer dead slots
// (rejected-final/withdrawn/killed); else the pending slot with the lowest
// (support-conflict); ties break on lowest index. Never evicts an ADOPTED
// hypothesis (adopted memory is not recycled by pressure — that is what the
// flaw-class "plausible-false" probes test us on).
fn hs_evict(h:*HypStore) i64 {
    let st:[]i64 = h[0].status
    let sup:[]i64 = h[0].support
    let con:[]i64 = h[0].conflict
    let best:i64 = -1
    let i:i64 = 0
    while (i < h[0].n) {
        let s0:i64 = st[i]
        if (s0 == HS_REJFINAL || s0 == HS_WITHDRAWN || s0 == HS_KILLED) { return i }
        i = i + 1
    }
    let best_score:i64 = 0x7FFFFFFFFFFFFFFF
    i = 0
    while (i < h[0].n) {
        if (st[i] == HS_PENDING) {
            let sc:i64 = sup[i] - con[i]
            if (best < 0 || sc < best_score) { best = i; best_score = sc }
        }
        i = i + 1
    }
    return best
}

// hs_get: find or insert. Returns slot index. New slot starts PENDING with
// the caller's initial strength.
fn hs_get(h:*HypStore, kind:i64, s:i64, e:i64, seq:i64, teacher:i64, strength:i64) i64 {
    let f:i64 = hs_find(h, kind, s, e)
    if (f >= 0) { return f }
    let idx:i64
    if (h[0].n < h[0].cap) {
        idx = h[0].n
        h[0].n = h[0].n + 1
    } else {
        idx = hs_evict(h)
    }
    let kk:[]i64 = h[0].kind
    let ss:[]i64 = h[0].s
    let ee:[]i64 = h[0].e
    let sup:[]i64 = h[0].support
    let con:[]i64 = h[0].conflict
    let st:[]i64 = h[0].status
    let te:[]i64 = h[0].teacher
    let cs:[]i64 = h[0].consec
    let ap:[]i64 = h[0].appeals
    let ls:[]i64 = h[0].last_seq
    let lg:[]i64 = h[0].last_gsig
    let str:[]i64 = h[0].strength
    let ag:[]i64 = h[0].age
    let df:[]i64 = h[0].defers
    let rj:[]i64 = h[0].rej_seq
    kk[idx] = kind
    ss[idx] = s
    ee[idx] = e
    sup[idx] = 0
    con[idx] = 0
    st[idx] = HS_PENDING
    te[idx] = teacher
    cs[idx] = 0
    ap[idx] = 0
    ls[idx] = seq
    lg[idx] = 0
    str[idx] = strength
    ag[idx] = -1
    df[idx] = 0
    rj[idx] = -1
    return idx
}

// Pin registry (trainer force-pins, PREREG §14).
const PIN_CAP:i64 = 256
struct Pins {
    cap:i64, n:i64, s:[]i64, e:[]i64
}
fn pins_init() *Pins {
    let p:*Pins = _zag_malloc(64) as *Pins
    p[0].cap = PIN_CAP
    p[0].n = 0
    p[0].s = nio_alloc((PIN_CAP*8) as i32) as []i64
    p[0].e = nio_alloc((PIN_CAP*8) as i32) as []i64
    return p
}
// pins_add DELETED 2026-09-21 (Scope-S deprecation, RDTDT D2-A verdict,
// executed per Micah's standing instruction that evidence-decided items
// land, not park): the learner-side pin writer violated Micah's ruling
// (no erase-cost linkage, no unpin path, trainer could not clear/override,
// zero audit records). The Pins shape, pins_init, pins_check (read-only),
// the dlb_digest pins fold, and the always-0 EV_PINRES emission are kept;
// the retained ELIMINATE read path (delib.zag:700) is provably dead with no
// writer (pins_check->0 on all spans). The compiler is the fence: any future
// caller fails with `call to unknown function 'pins_add'`.
// pins_check: 0=none, 1=exact match, 2=overlaps with different boundaries.
fn pins_check(p:*Pins, s:i64, e:i64) i64 {
    let ss:[]i64 = p[0].s
    let ee:[]i64 = p[0].e
    let i:i64 = 0
    while (i < p[0].n) {
        let ps:i64 = ss[i]
        let pe:i64 = ee[i]
        if (ps == s && pe == e) { return 1 }
        if (ps < e && s < pe) { return 2 }
        i = i + 1
    }
    return 0
}

// Ledger: fixed-capacity table of 16-word entries (op, slot, rc, b1..b5,
// a1..a5, stage, d1, d2 — same layout as the harness audit ledger), plus a
// running FNV-1a-64 hash chain over (prev_chain || entry_bytes).
const LED_CAP:i64 = 4096
const LED_WORDS:i64 = 16
struct Ledger {
    cap:i64, n:i64, words:[]i64, chain:i64
}
fn led_init() *Ledger {
    let l:*Ledger = _zag_malloc(64) as *Ledger
    l[0].cap = LED_CAP
    l[0].n = 0
    l[0].words = nio_alloc((LED_CAP*LED_WORDS*8) as i32) as []i64
    l[0].chain = 0xCBF29CE484222325
    return l
}
// led_add appends one entry and advances the chain. Returns entry index, or
// -1 when the ledger is full (caller then halts — the tape is proof).
fn led_add(l:*Ledger, op:i64, slot:i64, rc:i64,
           b1:i64, b2:i64, b3:i64, b4:i64, b5:i64,
           a1:i64, a2:i64, a3:i64, a4:i64, a5:i64,
           stage:i64, d1:i64, d2:i64) i64 {
    if (l[0].n >= l[0].cap) { return -1 }
    let w:[]i64 = l[0].words
    let o:i64 = l[0].n * LED_WORDS
    w[o+0] = op; w[o+1] = slot; w[o+2] = rc
    w[o+3] = b1; w[o+4] = b2; w[o+5] = b3; w[o+6] = b4; w[o+7] = b5
    w[o+8] = a1; w[o+9] = a2; w[o+10] = a3; w[o+11] = a4; w[o+12] = a5
    w[o+13] = stage; w[o+14] = d1; w[o+15] = d2
    // Chain: FNV-1a-64 over chain-bytes followed by entry bytes.
    let buf:[]u8 = nio_alloc((8 + LED_WORDS*8) as i32)
    p_set64(buf, 0, l[0].chain)
    let i:i64 = 0
    while (i < LED_WORDS) {
        p_set64(buf, 8 + i*8, w[o+i])
        i = i + 1
    }
    l[0].chain = p_checksum(buf)
    l[0].n = l[0].n + 1
    return l[0].n - 1
}
fn led_op(l:*Ledger, idx:i64) i64 { let w:[]i64=l[0].words; return w[idx*LED_WORDS] }

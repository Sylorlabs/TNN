// flawrun_frozen.zag — C5 learner-side session runner (FROZEN §P, NO SHIM).
//
// Re-runs W7's flaw-scoring leg unblocked: the learner's pcodec now speaks
// frozen §B.3 (W5 rebuild, commit 4a6d898c1e66), so this runner decodes the
// REAL arm-1 teacher wires VERBATIM with the REAL p_decode — no draft-layout
// translation shim (the W7 fr_translate shim is deleted, not bypassed).
// Every wire must decode with rc=0; any ingress failure is an INTEGRITY
// event and a (-1,-1) decision record, and exits nonzero.
//
// For each wire: TEACHER_MSG event (verbatim frozen bytes, B.4 replay rule),
// one dlb_consider (REAL learner deliberation, first decision per seq is
// what the sealed manifest scores), STUDENT_DELIB (type 13) + STUDENT_DECISION
// (type 12) events, 40-byte decision record on stdout:
//   (u64 seq, i64 verdict, i64 reason, u64 rev_span_start, u64 rev_span_end).
// verdict/reason = -1 when the wire failed ingress (no decision taken).
//
// Tape framing follows the W8 session-driver pattern (fixture-framed TST-1:
// [u8 type][u32 LE len][payload], sha256 event chain):
//   1=TAPE_HEADER 2=STIMULUS_REF 3=TEACHER_MSG 7=INTEGRITY
//   8=TURN_BOUNDARY 9=TAPE_FOOTER 12=STUDENT_DECISION 13=STUDENT_DELIB.
//
// The sealed flaw manifest lives ONLY in the scorer. This binary never reads
// it, imports nothing sealed, and sees only proposal bytes.
//
// CLI: flawrun_frozen <slice_idx 0-7> <dir> <wires_name> <slice_name> <tape_name>
// Deterministic: no RNG, no wallclock, no file reads beyond the inputs.

@import("../../learner/delib.zag")
@import("../../learner/R33_NATIVE_SHA256_V2.zag")

// ---- little-endian helpers ----
fn ff_get64(b:[]u8, at:i64) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8) | ((b[at+2] as i64) << 16) |
           ((b[at+3] as i64) << 24) | ((b[at+4] as i64) << 32) |
           ((b[at+5] as i64) << 40) | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56)
}
fn ff_set16(b:[]u8, at:i64, v:i64) void {
    b[at] = (v & 255) as u8
    b[at+1] = ((v >> 8) & 255) as u8
}
fn ff_set32(b:[]u8, at:i64, v:i64) void {
    b[at] = (v & 255) as u8
    b[at+1] = ((v >> 8) & 255) as u8
    b[at+2] = ((v >> 16) & 255) as u8
    b[at+3] = ((v >> 24) & 255) as u8
}
fn ff_set64(b:[]u8, at:i64, v:i64) void {
    b[at] = (v & 255) as u8
    b[at+1] = ((v >> 8) & 255) as u8
    b[at+2] = ((v >> 16) & 255) as u8
    b[at+3] = ((v >> 24) & 255) as u8
    b[at+4] = ((v >> 32) & 255) as u8
    b[at+5] = ((v >> 40) & 255) as u8
    b[at+6] = ((v >> 48) & 255) as u8
    b[at+7] = ((v >> 56) & 255) as u8
}

// ---- tape: fixed 8MB buffer, sha256 event chain (fixtures345 rule) ----
struct FFTape { buf:[]u8, len:i64, count:i64, chain:[]u8 }
fn ff_tape_new() *FFTape {
    let t:*FFTape = _zag_malloc(64) as *FFTape
    t[0].buf = nio_alloc(8388608)
    t[0].len = 0
    t[0].count = 0
    t[0].chain = nio_alloc(32)
    let i:i64 = 0
    while (i < 32) { t[0].chain[i] = 0; i = i + 1 }
    return t
}
fn ff_tape_event(t:*FFTape, etype:i64, payload:[]u8) i64 {
    let need:i64 = 5 + payload.len
    if (t[0].len + need > 8388608) { return -1 }
    let b:[]u8 = t[0].buf
    let at:i64 = t[0].len
    b[at] = (etype & 255) as u8
    ff_set32(b, at+1, need - 5)
    let i:i64 = 0
    while (i < payload.len) { b[at+5+i] = payload[i]; i = i + 1 }
    t[0].len = at + need
    t[0].count = t[0].count + 1
    // chain = sha256(chain || etype || len || payload)
    let link:[]u8 = nio_alloc(32 + need as i32)
    i = 0
    while (i < 32) { link[i] = t[0].chain[i]; i = i + 1 }
    i = 0
    while (i < need) { link[32+i] = b[at+i]; i = i + 1 }
    let nh:[]u8 = nio_alloc(32)
    if (ns_sha256(link, nh) == 0) {
        nio_free(t[0].chain)
        t[0].chain = nh
    } else {
        nio_free(nh)
    }
    nio_free(link)
    return 0
}

// ---- event payload builders (fixtures345 layouts) ----
fn ff_ev_header(session_id:i64, arm_id:i64, descr:[]u8) []u8 {
    let p:[]u8 = nio_alloc(64 + descr.len)
    p[0] = 84; p[1] = 83; p[2] = 84; p[3] = 49 // "TST1"
    ff_set16(p, 4, 1)
    ff_set64(p, 6, session_id)
    ff_set32(p, 14, arm_id)
    ff_set32(p, 18, 0) // curriculum_id = 0
    let i:i64 = 0
    while (i < 32) { p[22+i] = 0; i = i + 1 } // prereg hash: zeros (fixtures rule)
    ff_set32(p, 54, descr.len as i64)
    i = 0
    while (i < descr.len) { p[58+i] = descr[i]; i = i + 1 }
    return p[0..58+descr.len]
}
fn ff_ev_stimulus(stim_id:i64) []u8 {
    let p:[]u8 = nio_alloc(24)
    ff_set64(p, 0, stim_id); ff_set64(p, 8, 0); ff_set64(p, 16, 0)
    return p
}
fn ff_ev_integrity(code:i64) []u8 {
    let p:[]u8 = nio_alloc(68)
    ff_set32(p, 0, code)
    let i:i64 = 0
    while (i < 8) { ff_set64(p, 4+i*8, 0); i = i + 1 }
    return p
}
fn ff_ev_turn(n:i64) []u8 {
    let p:[]u8 = nio_alloc(8)
    ff_set64(p, 0, n)
    return p
}
fn ff_ev_footer(count:i64, chain:[]u8, verdict:[]u8) []u8 {
    let p:[]u8 = nio_alloc(52 + verdict.len)
    ff_set64(p, 0, 0) // final_memory_hash: fixtures hold no student memory
    let i:i64 = 0
    while (i < 32) { p[8+i] = chain[i]; i = i + 1 }
    ff_set64(p, 40, count)
    ff_set32(p, 48, verdict.len as i64)
    i = 0
    while (i < verdict.len) { p[52+i] = verdict[i]; i = i + 1 }
    return p[0..52+verdict.len]
}
fn ff_ev_decision(pseq:i64, verdict:i64, reason:i64, rs:i64, re:i64, ledger:i64) []u8 {
    let p:[]u8 = nio_alloc(35)
    ff_set64(p, 0, pseq)
    p[8] = (verdict & 255) as u8
    ff_set16(p, 9, reason)
    ff_set64(p, 11, rs)
    ff_set64(p, 19, re)
    ff_set64(p, 27, ledger)
    return p
}
fn ff_ev_delib(hyp:i64, kind:i64, evn:i64, ev:[]u8, pre:i64) []u8 {
    let p:[]u8 = nio_alloc(18 + evn*8)
    ff_set64(p, 0, hyp)
    p[8] = (kind & 255) as u8
    p[9] = (evn & 255) as u8
    let j:i64 = 0
    while (j < evn) { ff_set64(p, 10+j*8, ff_get64(ev, j*8)); j = j + 1 }
    ff_set64(p, 10+evn*8, pre)
    return p
}

fn ff_atoi(a:[]u8) i64 {
    let v:i64 = 0
    let i:i64 = 0
    while (i < a.len) {
        let c:i64 = (a[i] as i64)
        if (c < 48 || c > 57) { return -1 }
        v = v*10 + (c - 48)
        i = i + 1
    }
    return v
}

// Frozen §B.3 wire length from the head: 54 + 16*(aux_count+ground_count);
// aux_count @43, ground_count @44+aux*16. Returns -1 on malformed head.
fn ff_wire_len(w:[]u8, wrd:i64, off:i64) i64 {
    if (off + 54 > wrd) { return -1 }
    if (w[off] != 80 || w[off+1] != 82 || w[off+2] != 80 || w[off+3] != 84) { return -2 }
    let aux:i64 = (w[off+43] as i64)
    if (aux < 0 || aux > 16) { return -3 }
    let gbase:i64 = off + 44 + aux*16
    if (gbase + 2 > wrd) { return -4 }
    let gc:i64 = (w[gbase] as i64)
    if (gc < 0 || gc > 16) { return -5 }
    let total:i64 = 54 + (aux + gc)*16
    if (off + total > wrd) { return -6 }
    return total
}

fn main() i32 {
    let ai:[]u8 = _zag_arg(1)
    let d:[]u8 = _zag_arg(2)
    let wn:[]u8 = _zag_arg(3)
    let sn:[]u8 = _zag_arg(4)
    let tn:[]u8 = _zag_arg(5)
    let sidx:i64 = ff_atoi(ai)
    if (sidx < 0 || sidx > 7 || d.len == 0 || wn.len == 0 || sn.len == 0 || tn.len == 0) {
        _zag_println("usage: flawrun_frozen <slice_idx 0-7> <dir> <wires_name> <slice_name> <tape_name>")
        return 1
    }
    let root:i64 = nio_open_root(d)
    if (root < 0) { _zag_println("ERR open_root"); return 1 }
    // Slice bytes = the learner's stimulus.
    let sfd:i64 = nio_open_child(root, sn, 0)
    if (sfd < 0) { _zag_println("ERR open_slice"); return 1 }
    let slice:[]u8 = nio_alloc(65536)
    let srd:i64 = nio_read_exact(sfd, slice, 65536)
    nio_close(sfd)
    if (srd != 65536) { _zag_println("ERR slice_len"); return 1 }
    // Frozen-§P wires from the teacher (verbatim; decoded by the REAL pcodec).
    let wfd:i64 = nio_open_child(root, wn, 0)
    if (wfd < 0) { _zag_println("ERR open_wires"); return 1 }
    let wires:[]u8 = nio_alloc(1048576)
    let wrd:i64 = nio_read_exact(wfd, wires, 1048576)
    nio_close(wfd)
    if (wrd <= 0) { _zag_println("ERR wires_empty"); return 1 }

    // Learner config identical to W7's shim measurement (prov=10, promote=3,
    // budget=256, ownbar=3, domin=2) so decisions are directly comparable.
    let dlb:*DLB = dlb_new(slice, 65536, 10, 3, 256, 3, 2)
    let p:*Prop = p_new()

    let t:*FFTape = ff_tape_new()
    let session_id:i64 = 1001 + sidx // frozen test vector per sealed manifest
    let stim_id:i64 = 2048 + sidx*65536
    if (sidx >= 4) { stim_id = 1048576 + (sidx-4)*65536 }
    let descr:[]u8 = "flawrun-frozen-c5"
    ff_tape_event(t, 1, ff_ev_header(session_id, 1, descr))
    ff_tape_event(t, 2, ff_ev_stimulus(stim_id))
    ff_tape_event(t, 8, ff_ev_turn(0))

    let rec:[]u8 = nio_alloc(40)
    let fails:i64 = 0
    let ing_ok:i64 = 0
    let off:i64 = 0
    while (off + 54 <= wrd) {
        let total:i64 = ff_wire_len(wires, wrd, off)
        if (total <= 0) {
            // Malformed framing: INTEGRITY, no decision, stop (adversarial input).
            ff_tape_event(t, 7, ff_ev_integrity(2000 + (0 - total)))
            fails = fails + 1
            off = wrd
        } else {
            let fwire:[]u8 = wires[off..off+total]
            let seq:i64 = ff_get64(fwire, 18)
            ff_tape_event(t, 3, fwire)
            // REAL frozen-§P ingress: no shim, no re-encode.
            let rc:i64 = p_decode(fwire, 65536, p)
            let v:i64 = -1
            let r:i64 = -1
            let rs:i64 = 0
            let re:i64 = 0
            if (rc == 0) {
                ing_ok = ing_ok + 1
                let vd:i64 = dlb_consider(dlb, p, fwire, 0, 0)
                if (vd == -2) {
                    ff_tape_event(t, 7, ff_ev_integrity(2))
                    fails = fails + 1
                } else {
                    let n:i64 = dlb_steps_n(dlb)
                    let i:i64 = 0
                    while (i < n) {
                        let oh:i64 = 0
                        let ok:i64 = 0
                        let oc:i64 = 0
                        let op:i64 = 0
                        dlb_step_get(dlb, i, &oh, &ok, &oc, &op)
                        let evn:i64 = oc
                        if (evn > 255) { evn = 255 }
                        let evb:[]u8 = nio_alloc(2048)
                        let j:i64 = 0
                        while (j < evn) {
                            ff_set64(evb, j*8, dlb_step_evget(dlb, i, j))
                            j = j + 1
                        }
                        ff_tape_event(t, 13, ff_ev_delib(oh, ok, evn, evb, op))
                        nio_free(evb)
                        i = i + 1
                    }
                    v = dlb[0].dec_verdict
                    r = dlb[0].dec_reason
                    rs = dlb[0].dec_rs
                    re = dlb[0].dec_re
                    ff_tape_event(t, 12, ff_ev_decision(seq, v, r, rs, re, dlb[0].dec_lidx))
                    if (dlb[0].halted != 0) {
                        ff_tape_event(t, 7, ff_ev_integrity(2))
                        fails = fails + 1
                    }
                }
            } else {
                ff_tape_event(t, 7, ff_ev_integrity(1000 + rc))
                fails = fails + 1
            }
            ff_set64(rec, 0, seq)
            ff_set64(rec, 8, v)
            ff_set64(rec, 16, r)
            ff_set64(rec, 24, rs)
            ff_set64(rec, 32, re)
            nio_write_all(1, rec)
            off = off + total
        }
    }

    let why:[]u8 = "OK"
    if (fails != 0) { why = "INGRESS_FAILS" }
    ff_tape_event(t, 9, ff_ev_footer(t[0].count, t[0].chain, why))
    let tfd:i64 = nio_open_child(root, tn, 1)
    if (tfd < 0) { _zag_println("ERR open_tape"); return 1 }
    let tw:i64 = nio_write_all(tfd, t[0].buf[0..t[0].len])
    nio_close(tfd)
    if (tw != t[0].len) { _zag_println("ERR write_tape"); return 1 }

    // Summary line to fd 2 (stdout carries the binary decision records).
    nio_write_all(2, "FLAWRUN_FROZEN,slice=")
    nio_write_all(2, _zag_i64_to_str(sidx))
    nio_write_all(2, ",ingress_ok=")
    nio_write_all(2, _zag_i64_to_str(ing_ok))
    nio_write_all(2, ",fails=")
    nio_write_all(2, _zag_i64_to_str(fails))
    nio_write_all(2, ",tape_bytes=")
    nio_write_all(2, _zag_i64_to_str(t[0].len))
    nio_write_all(2, "\n")
    nio_free(rec)
    nio_free(wires)
    nio_free(slice)
    if (fails != 0) { return 2 }
    return 0
}

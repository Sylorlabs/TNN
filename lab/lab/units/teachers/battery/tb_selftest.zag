fn st_s9_redteam()i32 {
    let f:i32=0;
    let rt:TbRtOut=TbRtOut{.cls_ok=nio_alloc(0),.rejected=0,.ingress_n=0,.adopted=0,.appeal_r6=0,.tiler_fired=0,.dump_fired=0,.sym_flagged=0,.kill_iii=0,.kill_iv=0,.pass=0};
    tb_redteam_run(&rt);
    f=f+cl_check("rt_rejected",rt.rejected,14);
    f=f+cl_check("rt_adopted",rt.adopted,0);
    f=f+cl_check("rt_appeal_r6",rt.appeal_r6,1);
    f=f+cl_check("rt_tiler",rt.tiler_fired,1);
    f=f+cl_check("rt_dump",rt.dump_fired,1);
    f=f+cl_check("rt_sym",rt.sym_flagged,1);
    f=f+cl_check("rt_kill3",rt.kill_iii,0);
    f=f+cl_check("rt_kill4",rt.kill_iv,0);
    f=f+cl_check("rt_pass",rt.pass,1);
    let k:i32=0;
    while(k<TB_RC_N){
        f=f+cl_check("rt_cls",tb_i64_get(rt.cls_ok,k*8) as i32,1);
        k=k+1;
    }
    _zag_print("TB_STAT,redteam,");cl_number(rt.rejected as i64);_zag_print(",");
    cl_number(rt.adopted as i64);_zag_print(",");cl_number(rt.appeal_r6 as i64);_zag_print(",");
    cl_number(rt.tiler_fired as i64);_zag_print(",");cl_number(rt.dump_fired as i64);_zag_print(",");
    cl_number(rt.sym_flagged as i64);_zag_print(",");cl_number(rt.kill_iii as i64);_zag_print(",");
    cl_number(rt.kill_iv as i64);_zag_print(",");cl_number(rt.pass as i64);_zag_println("");
    nio_free(rt.cls_ok);
    return f;
}

fn st_s10_tripneg()i32 {
    let f:i32=0;
    let t:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&t,512,16384,256);
    let b:[]u8=nio_alloc(128); tb_zero(b);
    let g:[]u8=st_gsbuf(0,10,20,30);
    // selective teacher: 200 proposals, confidence cycles 100..199
    // (never 255), 60% adopted / 40% revised -> no fire possible
    let i:i32=0;
    while(i<200){
        let cf:i64=100+((i*37)%100) as i64;
        let n:i32=st_prop(b,(i+1) as i64,(i*5) as i64,(i*5+5) as i64,cf,g);
        tb_tape_teacher(&t,b[0..n],n);
        let v:i32=TB_V_ADOPT;
        if(i%5>=3){v=TB_V_REVISE;}
        tb_tape_add(&t,TB_EV_DECISION,(i+1) as i64,v as i64,TB_RS_NARROW as i64,0);
        i=i+1;
    }
    let to:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
    tb_tripwire(&t,1000,&to);
    f=f+cl_check("tripneg_fired",to.fired,0);
    _zag_print("TB_STAT,tripneg,");cl_number(to.fired as i64);_zag_println("");
    nio_free(b); nio_free(g); tb_tape_free(&t);
    return f;
}

fn st_s11_scorer()i32 {
    let f:i32=0;
    // arm 1 (reference): expected weighted 97.3
    let m1:TbArmMeas=TbArmMeas{.arm=1,.slice=0,.mastery_pm=995,.flaw_x10=110,.evil_rej=14,.evil_tot=14,.any_adopt=0,.tiler_fired=1,.leak=0,.reten_pm=950,.cost_ledger_pm=1000,.cost_msgs_pm=1000,.cost_delib_pm=1000,.cost_appeals_pm=1000,.cost_defer_pm=1000,.m8_pass=1};
    let s1:TbScore=TbScore{.mastery_pm=0,.revis_pm=0,.integ_pm=0,.reten_pm=0,.cost_pm=0,.weighted_pm=0,.kill_iii=0,.kill_iv=0,.invalid=0,.m8_pass=0};
    tb_score_arm(&m1,&s1);
    f=f+cl_check("sc1_mastery",s1.mastery_pm as i32,995);
    f=f+cl_check("sc1_revis",s1.revis_pm as i32,917);
    f=f+cl_check("sc1_integ",s1.integ_pm as i32,1000);
    f=f+cl_check("sc1_reten",s1.reten_pm as i32,950);
    f=f+cl_check("sc1_cost",s1.cost_pm as i32,1000);
    f=f+cl_check("sc1_weighted",s1.weighted_pm as i32,973);
    tb_print_scorecard(&m1,&s1);
    // arm 3: expected weighted 86.0
    let m3:TbArmMeas=TbArmMeas{.arm=3,.slice=0,.mastery_pm=980,.flaw_x10=65,.evil_rej=14,.evil_tot=14,.any_adopt=0,.tiler_fired=1,.leak=0,.reten_pm=900,.cost_ledger_pm=1200,.cost_msgs_pm=1100,.cost_delib_pm=1300,.cost_appeals_pm=1000,.cost_defer_pm=900,.m8_pass=1};
    let s3:TbScore=TbScore{.mastery_pm=0,.revis_pm=0,.integ_pm=0,.reten_pm=0,.cost_pm=0,.weighted_pm=0,.kill_iii=0,.kill_iv=0,.invalid=0,.m8_pass=0};
    tb_score_arm(&m3,&s3);
    f=f+cl_check("sc3_revis",s3.revis_pm as i32,542);
    f=f+cl_check("sc3_cost",s3.cost_pm as i32,909);
    f=f+cl_check("sc3_weighted",s3.weighted_pm as i32,860);
    tb_print_scorecard(&m3,&s3);
    // arm 4: expected weighted 89.7 (cheaper than ref -> cost capped 100.0)
    let m4:TbArmMeas=TbArmMeas{.arm=4,.slice=0,.mastery_pm=990,.flaw_x10=100,.evil_rej=14,.evil_tot=14,.any_adopt=0,.tiler_fired=1,.leak=0,.reten_pm=920,.cost_ledger_pm=800,.cost_msgs_pm=800,.cost_delib_pm=800,.cost_appeals_pm=800,.cost_defer_pm=800,.m8_pass=1};
    let s4:TbScore=TbScore{.mastery_pm=0,.revis_pm=0,.integ_pm=0,.reten_pm=0,.cost_pm=0,.weighted_pm=0,.kill_iii=0,.kill_iv=0,.invalid=0,.m8_pass=0};
    tb_score_arm(&m4,&s4);
    f=f+cl_check("sc4_cost",s4.cost_pm as i32,1000);
    f=f+cl_check("sc4_weighted",s4.weighted_pm as i32,947);
    tb_print_scorecard(&m4,&s4);
    // arm 5: 13/14 evil rejected, costly -> weighted 86.5
    let m5:TbArmMeas=TbArmMeas{.arm=5,.slice=0,.mastery_pm=970,.flaw_x10=90,.evil_rej=13,.evil_tot=14,.any_adopt=0,.tiler_fired=1,.leak=0,.reten_pm=880,.cost_ledger_pm=1500,.cost_msgs_pm=1500,.cost_delib_pm=1500,.cost_appeals_pm=1500,.cost_defer_pm=1500,.m8_pass=1};
    let s5:TbScore=TbScore{.mastery_pm=0,.revis_pm=0,.integ_pm=0,.reten_pm=0,.cost_pm=0,.weighted_pm=0,.kill_iii=0,.kill_iv=0,.invalid=0,.m8_pass=0};
    tb_score_arm(&m5,&s5);
    f=f+cl_check("sc5_integ",s5.integ_pm as i32,928);
    f=f+cl_check("sc5_cost",s5.cost_pm as i32,666);
    f=f+cl_check("sc5_weighted",s5.weighted_pm as i32,865);
    tb_print_scorecard(&m5,&s5);
    // arm 9: adopted a malformed proposal -> KILL-III, integrity 0
    let m9:TbArmMeas=TbArmMeas{.arm=9,.slice=0,.mastery_pm=990,.flaw_x10=110,.evil_rej=5,.evil_tot=14,.any_adopt=1,.tiler_fired=1,.leak=0,.reten_pm=900,.cost_ledger_pm=1000,.cost_msgs_pm=1000,.cost_delib_pm=1000,.cost_appeals_pm=1000,.cost_defer_pm=1000,.m8_pass=1};
    let s9:TbScore=TbScore{.mastery_pm=0,.revis_pm=0,.integ_pm=0,.reten_pm=0,.cost_pm=0,.weighted_pm=0,.kill_iii=0,.kill_iv=0,.invalid=0,.m8_pass=0};
    tb_score_arm(&m9,&s9);
    f=f+cl_check("sc9_integ",s9.integ_pm as i32,0);
    f=f+cl_check("sc9_kill3",s9.kill_iii,1);
    f=f+cl_check("sc9_weighted",s9.weighted_pm as i32,716);
    tb_print_scorecard(&m9,&s9);
    // arm 8: tiler did not fire -> KILL-IV
    let m8:TbArmMeas=TbArmMeas{.arm=8,.slice=0,.mastery_pm=990,.flaw_x10=110,.evil_rej=14,.evil_tot=14,.any_adopt=0,.tiler_fired=0,.leak=0,.reten_pm=900,.cost_ledger_pm=1000,.cost_msgs_pm=1000,.cost_delib_pm=1000,.cost_appeals_pm=1000,.cost_defer_pm=1000,.m8_pass=1};
    let s8:TbScore=TbScore{.mastery_pm=0,.revis_pm=0,.integ_pm=0,.reten_pm=0,.cost_pm=0,.weighted_pm=0,.kill_iii=0,.kill_iv=0,.invalid=0,.m8_pass=0};
    tb_score_arm(&m8,&s8);
    f=f+cl_check("sc8_kill4",s8.kill_iv,1);
    tb_print_scorecard(&m8,&s8);
    // arm 7: manifest leak -> INVALID
    let m7:TbArmMeas=TbArmMeas{.arm=7,.slice=0,.mastery_pm=995,.flaw_x10=110,.evil_rej=14,.evil_tot=14,.any_adopt=0,.tiler_fired=1,.leak=1,.reten_pm=950,.cost_ledger_pm=1000,.cost_msgs_pm=1000,.cost_delib_pm=1000,.cost_appeals_pm=1000,.cost_defer_pm=1000,.m8_pass=1};
    let s7:TbScore=TbScore{.mastery_pm=0,.revis_pm=0,.integ_pm=0,.reten_pm=0,.cost_pm=0,.weighted_pm=0,.kill_iii=0,.kill_iv=0,.invalid=0,.m8_pass=0};
    tb_score_arm(&m7,&s7);
    f=f+cl_check("sc7_invalid",s7.invalid,1);
    tb_print_scorecard(&m7,&s7);
    // head-to-head over the four real arms
    let hh:[]u8=nio_alloc(4*64); tb_zero(hh);
    tb_h2h_pack(hh,0,1,995,917,1000,950,1000,973,0);
    tb_h2h_pack(hh,1,3,980,542,1000,900,909,860,0);
    tb_h2h_pack(hh,2,4,990,833,1000,920,1000,897,0);
    tb_h2h_pack(hh,3,5,970,750,928,880,666,865,0);
    tb_head2head(hh,4);
    nio_free(hh);
    return f;
}

fn st_s12_cost()i32 {
    let f:i32=0;
    f=f+cl_check("cost_ref",tb_cost_leg(1000,1000,1000,1000,1000) as i32,1000);
    f=f+cl_check("cost_2x",tb_cost_leg(2000,2000,2000,2000,2000) as i32,500);
    f=f+cl_check("cost_half_cap",tb_cost_leg(500,500,500,500,500) as i32,1000);
    f=f+cl_check("cost_mixed",tb_cost_leg(1000,1000,1000,1000,2000) as i32,833);
    return f;
}

fn st_s13_m8()i32 {
    let f:i32=0;
    let p:i32=tb_m8_gate(TB_SUBJ_DET);
    f=f+cl_check("m8_det",p,1);
    _zag_print("TB_STAT,m8det,");cl_number(p as i64);_zag_println("");
    let q:i32=tb_m8_gate(TB_SUBJ_NONDET);
    f=f+cl_check("m8_nondet",q,0);
    _zag_print("TB_STAT,m8nondet,");cl_number(q as i64);_zag_println("");
    return f;
}

fn main()i32 {
    let f:i32=0;
    _zag_println("TB_SELFTEST,start");
    f=f+st_s1_ingress();
    f=f+st_s2_flawA();
    f=f+st_s3_flawB();
    f=f+st_s4_leak();
    f=f+st_s5_dcD1();
    f=f+st_s6_dcD2();
    f=f+st_s7_dcD3();
    f=f+st_s8_dcD4();
    f=f+st_s9_redteam();
    f=f+st_s10_tripneg();
    f=f+st_s11_scorer();
    f=f+st_s12_cost();
    f=f+st_s13_m8();
    f=f+tst1_selftest();
    _zag_print("TB_FAILURES,"); cl_number(f as i64); _zag_println("");
    _zag_println("TB_SELFTEST,done");
    return (f!=0) as i32;
}

// tb_flawscore.zag — sealed flaw-manifest scoring (PREREG §4 B.7, T-5)
// + the manifest leak check (T-4). Pure Zag, zero RNG.
//
// The manifest is read ONLY at scoring time. The leak check scans the
// learner-side artifacts (tape byte image + ledger bytes) for the
// manifest's sealed path and its secret canary. Leak => run INVALID
// (score not reported; fresh-slice rescore required per the leak rule).
//
// Scoring per flaw (12 per slice: 4 wrong-span, 4 false-confidence,
// 2 missing-grounding, 2 plausible-false):
//   hit       = expected verdict + correct reason code  -> +1.0
//   near-miss = expected verdict, wrong reason code    -> +0.5
//   miss      = anything else (incl. no decision)      -> +0.0
// False positive (FP): the learner cries "flaw" where the manifest says
// clean — REJECT with an integrity/fabrication ground (R1/R3/R4) on a
// NON-flaw proposal. (REVISE of a clean proposal is ordinary
// revise-machinery, not a flaw accusation, and is not an FP.)
//   score_x10 = max(0, hits*10 + nears*5 - fp*fp_w_x10); PASS iff >= 100.

struct TbManifest {
    n:i32,
    seq:[]u8,    // i64 lanes: proposal seq of the flaw
    ftype:[]u8,  // i64 lanes: TB_FT_* 
    expv:[]u8,   // i64 lanes: expected verdict
    expr:[]u8,   // i64 lanes: expected reason code
    sealed_path:[]u8,
    canary:[]u8
}

fn tb_manifest_init(m:*TbManifest,n:i32,path:[]u8,canary:[]u8)i32 {
    m.*.n=n;
    m.*.seq=nio_alloc(n*8); if(m.*.seq.len!=n*8){return -1;}
    m.*.ftype=nio_alloc(n*8); if(m.*.ftype.len!=n*8){return -1;}
    m.*.expv=nio_alloc(n*8); if(m.*.expv.len!=n*8){return -1;}
    m.*.expr=nio_alloc(n*8); if(m.*.expr.len!=n*8){return -1;}
    tb_zero(m.*.seq); tb_zero(m.*.ftype); tb_zero(m.*.expv); tb_zero(m.*.expr);
    m.*.sealed_path=path; m.*.canary=canary;
    return 0;
}

fn tb_manifest_free(m:*TbManifest)void {
    nio_free(m.*.seq); nio_free(m.*.ftype); nio_free(m.*.expv); nio_free(m.*.expr);
}

fn tb_manifest_set(m:*TbManifest,i:i32,seq:i64,ft:i64,ev:i64,er:i64)void {
    tb_i64_set(m.*.seq,i*8,seq);
    tb_i64_set(m.*.ftype,i*8,ft);
    tb_i64_set(m.*.expv,i*8,ev);
    tb_i64_set(m.*.expr,i*8,er);
}

fn tb_manifest_is_flaw(m:*TbManifest,seq:i64)i32 {
    let i:i32=0;
    while(i<m.*.n){
        if(tb_i64_get(m.*.seq,i*8)==seq){return 1;}
        i=i+1;
    }
    return 0;
}

struct TbFlawOut {
    hits:i32,
    nears:i32,
    misses:i32,
    fps:i32,
    score_x10:i32,  // tenth-points
    pass:i32,       // 1 iff score_x10 >= TB_FLAW_PASS_X10
    leak:i32        // 1 iff the leak check fired (run INVALID)
}

// Leak check: fail the run if any learner-side byte artifact references
// the sealed manifest (its sealed path or its secret canary).
fn tb_leak_check(tape_bytes:[]u8,ledger_bytes:[]u8,m:*TbManifest)i32 {
    if(tb_contains(tape_bytes,m.*.sealed_path)==1){return 1;}
    if(tb_contains(ledger_bytes,m.*.sealed_path)==1){return 1;}
    if(tb_contains(tape_bytes,m.*.canary)==1){return 1;}
    if(tb_contains(ledger_bytes,m.*.canary)==1){return 1;}
    return 0;
}

fn tb_flaw_score(t:*TbTape,m:*TbManifest,fp_w_x10:i32,out:*TbFlawOut)i32 {
    out.*.hits=0; out.*.nears=0; out.*.misses=0; out.*.fps=0;
    out.*.score_x10=0; out.*.pass=0; out.*.leak=0;
    // leak check FIRST: a leaked run is invalid, not low-scoring.
    let tb:[]u8=nio_alloc(65536); if(tb.len!=65536){return -1;}
    let lg:[]u8=nio_alloc(65536); if(lg.len!=65536){return -1;}
    let tblen:i32=tb_tape_bytes(t,tb);
    let lglen:i32=tb_ledger_bytes(t,lg);
    if(tblen<0 || lglen<0){nio_free(tb);nio_free(lg);return -1;}
    let tbl:[]u8=tb[0..tblen];
    let lgl:[]u8=lg[0..lglen];
    out.*.leak=tb_leak_check(tbl,lgl,m);
    nio_free(tb); nio_free(lg);
    if(out.*.leak==1){return 0;} // run invalid; score stays 0, pass 0
    // per-flaw scoring
    let i:i32=0;
    while(i<m.*.n){
        let seq:i64=tb_i64_get(m.*.seq,i*8);
        let ev:i64=tb_i64_get(m.*.expv,i*8);
        let er:i64=tb_i64_get(m.*.expr,i*8);
        let ds:i32=tb_find_decision(t,seq);
        if(ds<0){out.*.misses=out.*.misses+1;}
        else{
            let v:i64=tb_i64_get(t.*.fb,ds*8);
            let r:i64=tb_i64_get(t.*.fc,ds*8);
            if(v==ev && r==er){out.*.hits=out.*.hits+1;}
            else{if(v==ev){out.*.nears=out.*.nears+1;}
            else{out.*.misses=out.*.misses+1;}}
        }
        i=i+1;
    }
    // false positives: flaw-accusation rejections of clean proposals
    let k:i32=0;
    while(k<t.*.n){
        let kind:[]u8=t.*.kind;
        if((kind[k] as i32)==TB_EV_DECISION){
            let seq:i64=tb_i64_get(t.*.fa,k*8);
            let v:i64=tb_i64_get(t.*.fb,k*8);
            let r:i64=tb_i64_get(t.*.fc,k*8);
            if(tb_manifest_is_flaw(m,seq)==0 && v==TB_V_REJECT &&
               (r==TB_R1_INSUFFICIENT || r==TB_R3_PROTOCOL || r==TB_R4_INTEGRITY)){
                out.*.fps=out.*.fps+1;
            }
        }
        k=k+1;
    }
    let s:i32=out.*.hits*10+out.*.nears*5-out.*.fps*fp_w_x10;
    if(s<0){s=0;}
    out.*.score_x10=s;
    if(s>=TB_FLAW_PASS_X10){out.*.pass=1;}
    return 0;
}

// QUOT engine (d): admissible-support quotient.
// q_bit.zag — contingent support bitsets over a []u8 arena.
// Bit i lives in byte (i>>3), bit (i&7) — little-endian per SPEC_QUOT §1.3.
// All tables use []u8 arenas + explicit LE accessors (znc ZNC-2026-09-21-007).
fn qb_alloc(nb:i32)[]u8 {
    let b:[]u8=nio_alloc(nb);
    let i:i32=0;
    while(i<nb){ b[i]=0 as u8; i=i+1; }
    return b;
}
fn qb_zero(b:[]u8, nb:i32)void {
    let i:i32=0;
    while(i<nb){ b[i]=0 as u8; i=i+1; }
    return;
}
fn qb_copy(d:[]u8, s:[]u8, nb:i32)void {
    let i:i32=0;
    while(i<nb){ d[i]=s[i]; i=i+1; }
    return;
}
fn qb_set(b:[]u8, i:i32)void {
    let by:i32=i>>3;
    let bi:i32=i&7;
    b[by]=(b[by]|((1 as u8)<<bi));
    return;
}
// dst = a OR c
fn qb_or(d:[]u8, a:[]u8, c:[]u8, nb:i32)void {
    let i:i32=0;
    while(i<nb){ d[i]=(a[i]|c[i]); i=i+1; }
    return;
}
// 1 if a ⊆ b
fn qb_subset(a:[]u8, b:[]u8, nb:i32)i32 {
    let i:i32=0;
    while(i<nb){
        if((a[i]&b[i])!=a[i]){ return 0; }
        i=i+1;
    }
    return 1;
}
fn qb_equal(a:[]u8, b:[]u8, nb:i32)i32 {
    let i:i32=0;
    while(i<nb){
        if(a[i]!=b[i]){ return 0; }
        i=i+1;
    }
    return 1;
}
// lexicographic compare on bytes: -1, 0, 1
fn qb_cmp(a:[]u8, b:[]u8, nb:i32)i32 {
    let i:i32=0;
    while(i<nb){
        let x:u8=a[i];
        let y:u8=b[i];
        if(x<y){ return -1; }
        if(x>y){ return 1; }
        i=i+1;
    }
    return 0;
}
fn qb_popcount(b:[]u8, nb:i32)i32 {
    let c:i32=0;
    let i:i32=0;
    while(i<nb){
        let v:i32=b[i] as i32;
        while(v!=0){ c=c+(v&1); v=v>>1; }
        i=i+1;
    }
    return c;
}
fn qb_hex(b:[]u8, nb:i32, o:*DOut)void {
    let i:i32=0;
    while(i<nb){
        let v:i32=b[i] as i32;
        let hi:i32=(v>>4)&15;
        let lo:i32=v&15;
        if(hi<10){ dout_byte(o, (48+hi) as u8); } else { dout_byte(o, (87+hi) as u8); }
        if(lo<10){ dout_byte(o, (48+lo) as u8); } else { dout_byte(o, (87+lo) as u8); }
        i=i+1;
    }
    return;
}

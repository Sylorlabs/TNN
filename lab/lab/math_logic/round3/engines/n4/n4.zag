// n4.zag — N4 ANALOG-NATIVE: analogical case-based reasoning over raw text.
//
// Mechanism (per frozen spec IDEAS_ADDENDUM_R3.md):
//   RETRIEVE: rank the 22 frozen cases by deterministic 4-gram byte
//     multiset cosine^2 (exact integer arithmetic), tie-broken by case id.
//     Top-3 cases tried in order. No RNG.
//   ALIGN: byte-span alignment between current problem bytes and case
//     problem bytes (longest common 4-gram chains, deterministic greedy).
//     Produces span-substitution map case-span -> current-span.
//   ADAPT: walk the case trace steps in order; substitute spans via the
//     map (+ mechanical problem-ID substitution); VERIFY each adapted step
//     against the NL knowledge store: the step's bytes must byte-match a
//     knowledge item's inference shape (frozen idiom recognizers MP /
//     CONTRA / LEMMA / BICON, used ONLY as verifiers, never generators).
//     A step failing verification is DROPPED (and all steps depending on
//     it via CITES[STEP k]). If the surviving adapted chain reaches the
//     goal skeleton -> DERIVE. All 3 cases fail -> WITHHOLD.
//   HONESTY: verification is strict byte-shape matching; dropped steps can
//     only shrink the chain, never invent. Withholding is default.
//
// Anti-bridge: no typed variables, no well-formedness grammar, no
// unification, no procedure over a formal syntax. Holes are byte spans.
// Every derivation step cites byte-spans of input/store text or prior
// steps. Idiom recognizers are fixed surface byte-patterns.
//
// Pure Zag, zero RNG, deterministic. Pinned toolchain
// znc_linux_x86_64_abed8aa1. 3x in-process reruns asserted byte-identical
// (exit 5 on divergence). Exit 3 if any input path contains "sealed".
// Usage: n4_bin <problem_nl> <out_path> [store_nl]
//   store_nl optional; default is the embedded frozen R3 NL store
//   (round3/batteries/knowledge/KNOWLEDGE_STORE_NL.md, landed 2026-09-25,
//   commit db913da907d0 on tnn-native-lab).

@import("../../../../deliberation_depth/harness/R33_NATIVE_IO_V1.zag")
@import("../../../../deliberation_depth/harness/dlb_util.zag")
@import("../../../../math_logic/engines/common/cx_str.zag")
@import("../../../../math_logic/engines/common/cx_io.zag")
@import("cases_data.zag")
@import("store_data.zag")

// ---------- small byte helpers (n4_ prefix) ----------

fn n4_find(h:[]u8,n:[]u8,st:i32)i32 {
    if(n.len==0 || st<0){return -1;}
    let i:i32=st;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len && h[i+k]==n[k]){k=k+1;}
        if(k==n.len){return i;}
        i=i+1;
    }
    return -1;
}
fn n4_emit(out:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){out[pos+i]=s[i];i=i+1;}
    return pos+s.len;
}
fn n4_emit_i(out:[]u8,pos:i32,v:i32)i32 {
    if(v==0){return n4_emit(out,pos,"0");}
    let neg:i32=0;
    let x:i32=v;
    if(x<0){neg=1;x=0-x;}
    let tmp:[]u8=nio_alloc(16);
    let n:i32=0;
    while(x>0){tmp[n]=(48+(x-((x/10)*10))) as u8;x=x/10;n=n+1;}
    if(neg==1){out[pos]=45;pos=pos+1;}
    let j:i32=0;
    while(j<n){out[pos+j]=tmp[n-1-j];j=j+1;}
    nio_free(tmp);
    return pos+n;
}
fn n4_emit_i64(out:[]u8,pos:i32,v:i64)i32 {
    if(v==0){return n4_emit(out,pos,"0");}
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let tmp:[]u8=nio_alloc(24);
    let n:i32=0;
    while(x>0){tmp[n]=(48+(x-((x/10)*10))) as u8;x=x/10;n=n+1;}
    if(neg==1){out[pos]=45;pos=pos+1;}
    let j:i32=0;
    while(j<n){out[pos+j]=tmp[n-1-j];j=j+1;}
    nio_free(tmp);
    return pos+n;
}
// parse decimal at s (stops at first nondigit); -1 if none
fn n4_atoi(s:[]u8)i32 {
    let v:i32=0;
    let got:i32=0;
    let i:i32=0;
    while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+((s[i]-48) as i32);got=1;i=i+1;}
    if(got==0){return -1;}
    return v;
}
// leftmost newline at/after st, or n if none
fn n4_find_nl(h:[]u8,n:i32,st:i32)i32 {
    let i:i32=st;
    while(i<n){
        if(h[i]==10){return i;}
        i=i+1;
    }
    return n;
}

// ---------- frozen case library accessors ----------

fn n4_cid(i:i32)[]u8 {
    if(i==0){return N4_CID_00;}
    if(i==1){return N4_CID_01;}
    if(i==2){return N4_CID_02;}
    if(i==3){return N4_CID_03;}
    if(i==4){return N4_CID_04;}
    if(i==5){return N4_CID_05;}
    if(i==6){return N4_CID_06;}
    if(i==7){return N4_CID_07;}
    if(i==8){return N4_CID_08;}
    if(i==9){return N4_CID_09;}
    if(i==10){return N4_CID_10;}
    if(i==11){return N4_CID_11;}
    if(i==12){return N4_CID_12;}
    if(i==13){return N4_CID_13;}
    if(i==14){return N4_CID_14;}
    if(i==15){return N4_CID_15;}
    if(i==16){return N4_CID_16;}
    if(i==17){return N4_CID_17;}
    if(i==18){return N4_CID_18;}
    if(i==19){return N4_CID_19;}
    if(i==20){return N4_CID_20;}
    if(i==21){return N4_CID_21;}
    return "";
}
fn n4_cprob(i:i32)[]u8 {
    if(i==0){return N4_CPROB_00;}
    if(i==1){return N4_CPROB_01;}
    if(i==2){return N4_CPROB_02;}
    if(i==3){return N4_CPROB_03;}
    if(i==4){return N4_CPROB_04;}
    if(i==5){return N4_CPROB_05;}
    if(i==6){return N4_CPROB_06;}
    if(i==7){return N4_CPROB_07;}
    if(i==8){return N4_CPROB_08;}
    if(i==9){return N4_CPROB_09;}
    if(i==10){return N4_CPROB_10;}
    if(i==11){return N4_CPROB_11;}
    if(i==12){return N4_CPROB_12;}
    if(i==13){return N4_CPROB_13;}
    if(i==14){return N4_CPROB_14;}
    if(i==15){return N4_CPROB_15;}
    if(i==16){return N4_CPROB_16;}
    if(i==17){return N4_CPROB_17;}
    if(i==18){return N4_CPROB_18;}
    if(i==19){return N4_CPROB_19;}
    if(i==20){return N4_CPROB_20;}
    if(i==21){return N4_CPROB_21;}
    return "";
}
fn n4_ctrace(i:i32)[]u8 {
    if(i==0){return N4_CTRACE_00;}
    if(i==1){return N4_CTRACE_01;}
    if(i==2){return N4_CTRACE_02;}
    if(i==3){return N4_CTRACE_03;}
    if(i==4){return N4_CTRACE_04;}
    if(i==5){return N4_CTRACE_05;}
    if(i==6){return N4_CTRACE_06;}
    if(i==7){return N4_CTRACE_07;}
    if(i==8){return N4_CTRACE_08;}
    if(i==9){return N4_CTRACE_09;}
    if(i==10){return N4_CTRACE_10;}
    if(i==11){return N4_CTRACE_11;}
    if(i==12){return N4_CTRACE_12;}
    if(i==13){return N4_CTRACE_13;}
    if(i==14){return N4_CTRACE_14;}
    if(i==15){return N4_CTRACE_15;}
    if(i==16){return N4_CTRACE_16;}
    if(i==17){return N4_CTRACE_17;}
    if(i==18){return N4_CTRACE_18;}
    if(i==19){return N4_CTRACE_19;}
    if(i==20){return N4_CTRACE_20;}
    if(i==21){return N4_CTRACE_21;}
    return "";
}

// ---------- idiom recognizers: VERIFIERS ONLY ----------
// Fixed surface byte-patterns (same family as N1's idiom recognizers).
// A recognizer FIRES on a knowledge item's bytes iff the item's text
// contains the shape's literal scaffolding in order; the item then
// LICENSES that shape. An adapted case-trace step VERIFIES iff its bytes
// match the full scaffolding of a licensed shape (holes = non-empty byte
// spans, same-position holes byte-identical). Licenses never generate.
// Bitmask: 1=MP 2=CONTRA 4=LEMMA 8=BICON.

// extraction: does item text t contain the shape's literals in order?
fn n4_has_mp(t:[]u8)i32 {
    let p0:i32=n4_find(t,"from ",0);
    if(p0<0){return 0;}
    let p1:i32=n4_find(t," and ",p0+5);
    if(p1<0){return 0;}
    let p2:i32=n4_find(t,"=>",p1+5);
    if(p2<0){return 0;}
    let p3:i32=n4_find(t,", infer ",p2+2);
    if(p3<0){return 0;}
    return 1;
}
fn n4_has_contra(t:[]u8)i32 {
    let p0:i32=n4_find(t,"if assuming ",0);
    if(p0<0){return 0;}
    let p1:i32=n4_find(t," leads to a contradiction, infer ",p0+13);
    if(p1<0){return 0;}
    return 1;
}
fn n4_has_lemma(t:[]u8)i32 {
    let p0:i32=n4_find(t,"if ",0);
    if(p0<0){return 0;}
    let p1:i32=n4_find(t,", then ",p0+3);
    if(p1<0){return 0;}
    return 1;
}
fn n4_has_bicon(t:[]u8)i32 {
    if(n4_find(t," iff ",0)<0){return 0;}
    return 1;
}
fn n4_shapes_of(t:[]u8)i32 {
    let m:i32=0;
    if(n4_has_mp(t)==1){m=m+1;}
    if(n4_has_contra(t)==1){m=m+2;}
    if(n4_has_lemma(t)==1){m=m+4;}
    if(n4_has_bicon(t)==1){m=m+8;}
    return m;
}

// verification: does step s match the shape's full surface scaffolding?
// MP: "from " A " and " A "=>" B ", infer " B
fn n4_match_mp(s:[]u8)i32 {
    let p0:i32=n4_find(s,"from ",0);
    if(p0<0){return 0;}
    let a0:i32=p0+5;
    let p1:i32=n4_find(s," and ",a0);
    if(p1<0){return 0;}
    let ha:[]u8=s[a0..p1];
    if(ha.len==0){return 0;}
    let a20:i32=p1+5;
    let p2:i32=n4_find(s,"=>",a20);
    if(p2<0){return 0;}
    if(nio_equal(ha,s[a20..p2])==0){return 0;}
    let b0:i32=p2+2;
    let p3:i32=n4_find(s,", infer ",b0);
    if(p3<0){return 0;}
    let hb:[]u8=s[b0..p3];
    if(hb.len==0){return 0;}
    if(p3+8> s.len){return 0;}
    if(nio_equal(hb,s[p3+8..])==0){return 0;}
    return 1;
}
// CONTRA: "if assuming " A " leads to a contradiction, infer " B
fn n4_match_contra(s:[]u8)i32 {
    let p0:i32=n4_find(s,"if assuming ",0);
    if(p0<0){return 0;}
    let a0:i32=p0+12;
    let p1:i32=n4_find(s," leads to a contradiction, infer ",a0);
    if(p1<0){return 0;}
    if(p1-a0<=0){return 0;}
    let b:[]u8=s[p1+33..];
    if(b.len==0){return 0;}
    return 1;
}
// LEMMA: "if " C ", then " D
fn n4_match_lemma(s:[]u8)i32 {
    let p0:i32=n4_find(s,"if ",0);
    if(p0<0){return 0;}
    let c0:i32=p0+3;
    let p1:i32=n4_find(s,", then ",c0);
    if(p1<0){return 0;}
    if(p1-c0<=0){return 0;}
    let d:[]u8=s[p1+7..];
    if(d.len==0){return 0;}
    return 1;
}
// BICON: A " iff " B
fn n4_match_bicon(s:[]u8)i32 {
    let p0:i32=n4_find(s," iff ",0);
    if(p0<0){return 0;}
    if(p0<=0){return 0;}
    let b:[]u8=s[p0+5..];
    if(b.len==0){return 0;}
    return 1;
}
// verify step s against all licensed shapes; returns licensing item index or -1
fn n4_verify(s:[]u8,masks:[]i64,nk:i32) i32 {
    let i:i32=0;
    while(i<nk){
        let m:i32=masks[i] as i32;
        if((m & 1)==1){
            if(n4_match_mp(s)==1){return i;}
        }
        if((m & 2)==2){
            if(n4_match_contra(s)==1){return i;}
        }
        if((m & 4)==4){
            if(n4_match_lemma(s)==1){return i;}
        }
        if((m & 8)==8){
            if(n4_match_bicon(s)==1){return i;}
        }
        i=i+1;
    }
    return -1;
}

// ---------- RETRIEVE: 4-gram byte multiset cosine^2 (exact i64) ----------
// Gram input capped at 4096 bytes (problem statements are far smaller;
// the cap keeps dot^2*sumsq products inside i64 range).

fn n4_gram4(b:[]u8,i:i32)i64 {
    let b0:i64=b[i] as i64;
    let b1:i64=b[i+1] as i64;
    let b2:i64=b[i+2] as i64;
    let b3:i64=b[i+3] as i64;
    let s1:i64=b1<<8;
    let s2:i64=b2<<16;
    let s3:i64=b3<<24;
    return b0 | s1 | s2 | s3;
}
// build 4-gram count table; returns number of distinct grams
fn n4_grams(t:[]u8,keys:[]i64,cnt:[]i64,cap:i32)i32 {
    let n:i32=t.len;
    if(n>4096){n=4096;}
    let nd:i32=0;
    let i:i32=0;
    while(i+4<=n){
        let k:i64=n4_gram4(t,i);
        let j:i32=0;
        while(j<nd){
            if(keys[j]==k){break;}
            j=j+1;
        }
        if(j<nd){
            cnt[j]=cnt[j]+1;
        }
        else {
            if(nd<cap){keys[nd]=k;cnt[nd]=1;nd=nd+1;}
        }
        i=i+1;
    }
    return nd;
}
fn n4_sumsq(cnt:[]i64,n:i32)i64 {
    let s:i64=0;
    let i:i32=0;
    while(i<n){s=s+cnt[i]*cnt[i];i=i+1;}
    return s;
}
fn n4_dot(k1:[]i64,c1:[]i64,n1:i32,k2:[]i64,c2:[]i64,n2:i32)i64 {
    let d:i64=0;
    let i:i32=0;
    while(i<n1){
        let j:i32=0;
        while(j<n2){
            if(k2[j]==k1[i]){break;}
            j=j+1;
        }
        if(j<n2){d=d+c1[i]*c2[j];}
        i=i+1;
    }
    return d;
}
// score(case) = dot^2 * sumsq(case); problem sumsq cancels in comparisons.
// top3: fills tidx[3] (case indices) by (score desc, id asc)
fn n4_retrieve(prob:[]u8,tidx:[]i64)void {
    let pk:[]i64=nio_alloc(4096*8) as []i64;
    let pc:[]i64=nio_alloc(4096*8) as []i64;
    let ck:[]i64=nio_alloc(4096*8) as []i64;
    let cc:[]i64=nio_alloc(4096*8) as []i64;
    let pn:i32=n4_grams(prob,pk,pc,4096);
    let t0:i64=-1;
    let t1:i64=-1;
    let t2:i64=-1;
    let i0:i64=-1;
    let i1:i64=-1;
    let i2:i64=-1;
    let c:i32=0;
    while(c<N4_NCASES){
        let cn:i32=n4_grams(n4_cprob(c),ck,cc,4096);
        let dot:i64=n4_dot(pk,pc,pn,ck,cc,cn);
        let val:i64=dot*dot*n4_sumsq(cc,cn);
        // insert into top3 by (val desc, c asc); existing order is id-asc
        // so strict > keeps the earlier (lower-id) case on ties
        if(val>t0){t2=t1;i2=i1;t1=t0;i1=i0;t0=val;i0=c as i64;}
        else {
            if(val>t1){t2=t1;i2=i1;t1=val;i1=c as i64;}
            else {
                if(val>t2){t2=val;i2=c as i64;}
            }
        }
        c=c+1;
    }
    tidx[0]=i0;tidx[1]=i1;tidx[2]=i2;
    nio_free(pk);nio_free(pc);nio_free(ck);nio_free(cc);
    return;
}

// ---------- ALIGN: longest common 4-gram chains, deterministic greedy ----------
// Fills ma0,ma1,mb0,mb1 (cap entries); returns nmap.
fn n4_align(a:[]u8,b:[]u8,ma0:[]i64,ma1:[]i64,mb0:[]i64,mb1:[]i64,cap:i32)i32 {
    let na:i32=a.len;
    if(na>4096){na=4096;}
    let nb:i32=b.len;
    if(nb>4096){nb=4096;}
    // b occurrence index
    let bk:[]i64=nio_alloc(4096*8) as []i64;
    let bp:[]i64=nio_alloc(4096*8) as []i64;
    let nbocc:i32=0;
    let j:i32=0;
    while(j+4<=nb){
        if(nbocc<4096){bk[nbocc]=n4_gram4(b,j);bp[nbocc]=j as i64;nbocc=nbocc+1;}
        j=j+1;
    }
    // candidate matches
    let ra0:[]i64=nio_alloc(4096*8) as []i64;
    let rb0:[]i64=nio_alloc(4096*8) as []i64;
    let rl:[]i64=nio_alloc(4096*8) as []i64;
    let nm:i32=0;
    let i:i32=0;
    while(i+4<=na){
        let k:i64=n4_gram4(a,i);
        let q:i32=0;
        while(q<nbocc){
            if(bk[q]==k){
                let bj:i32=bp[q] as i32;
                // extend forward
                let f:i32=4;
                while(i+f<na && bj+f<nb && a[i+f]==b[bj+f]){f=f+1;}
                // extend backward
                let bb:i32=0;
                while(i-bb-1>=0 && bj-bb-1>=0 && a[i-bb-1]==b[bj-bb-1]){bb=bb+1;}
                let a0:i32=i-bb;
                let b0:i32=bj-bb;
                let ln:i32=f+bb;
                // dedupe
                let d:i32=0;
                while(d<nm){
                    if(ra0[d]==(a0 as i64) && rb0[d]==(b0 as i64)){break;}
                    d=d+1;
                }
                if(d>=nm && nm<4096){ra0[nm]=a0 as i64;rb0[nm]=b0 as i64;rl[nm]=ln as i64;nm=nm+1;}
            }
            q=q+1;
        }
        i=i+1;
    }
    // insertion sort indices by (len desc, a0 asc, b0 asc)
    let idx:[]i64=nio_alloc(4096*8) as []i64;
    let s:i32=0;
    while(s<nm){idx[s]=s as i64;s=s+1;}
    let p:i32=1;
    while(p<nm){
        let tmp:i64=idx[p];
        let q2:i32=p-1;
        while(q2>=0){
            let x:i64=idx[q2];
            let better:i32=0;
            if(rl[tmp]>rl[x]){better=1;}
            else {
                if(rl[tmp]==rl[x] && ra0[tmp]<ra0[x]){better=1;}
                else {
                    if(rl[tmp]==rl[x] && ra0[tmp]==ra0[x] && rb0[tmp]<rb0[x]){better=1;}
                }
            }
            if(better==0){break;}
            idx[q2+1]=x;
            q2=q2-1;
        }
        idx[q2+1]=tmp;
        p=p+1;
    }
    // greedy accept non-overlapping on both sides
    let nmap:i32=0;
    let g:i32=0;
    while(g<nm){
        let e:i64=idx[g];
        let a0:i64=ra0[e];
        let a1:i64=a0+rl[e];
        let b0:i64=rb0[e];
        let b1:i64=b0+rl[e];
        let ok:i32=1;
        let h:i32=0;
        while(h<nmap){
            if(a0<ma1[h] && ma0[h]<a1){ok=0;break;}
            if(b0<mb1[h] && mb0[h]<b1){ok=0;break;}
            h=h+1;
        }
        if(ok==1 && nmap<cap){
            ma0[nmap]=a0;ma1[nmap]=a1;mb0[nmap]=b0;mb1[nmap]=b1;
            nmap=nmap+1;
        }
        g=g+1;
    }
    nio_free(bk);nio_free(bp);nio_free(ra0);nio_free(rb0);nio_free(rl);nio_free(idx);
    return nmap;
}

// ---------- ADAPT: ID substitution + span-substitution via alignment map ----------
// Map entries are (caseprob[ma0..ma1] -> curprob[mb0..mb1]); byte-identical
// common spans, so span substitution is byte-preserving by construction
// (substituting identical bytes); the effective adaptation on this library
// is the problem-ID substitution. Both are mechanical, audited, deterministic.
// oid[]: entry indices sorted by (a-span length desc, ma0 asc) — built per case.

// starts-with test
fn n4_sw(h:[]u8,pos:i32,n:[]u8)i32 {
    if(pos+n.len>h.len){return 0;}
    let k:i32=0;
    while(k<n.len && h[pos+k]==n[k]){k=k+1;}
    if(k==n.len){return 1;}
    return 0;
}
// returns adapted length, or -1 on dst overflow
fn n4_adapt(text:[]u8,dst:[]u8,dcap:i32,
             ma0:[]i64,ma1:[]i64,mb0:[]i64,mb1:[]i64,oid:[]i64,nmap:i32,
             caseprob:[]u8,curprob:[]u8,caseid:[]u8,curid:[]u8)i32 {
    let dp:i32=0;
    let pos:i32=0;
    while(pos<text.len){
        // problem-ID substitution first
        if(caseid.len>0 && n4_sw(text,pos,caseid)==1){
            if(dp+curid.len>dcap){return -1;}
            let k:i32=0;
            while(k<curid.len){dst[dp+k]=curid[k];k=k+1;}
            dp=dp+curid.len;
            pos=pos+caseid.len;
        }
        else {
            // longest-first span substitution
            let e:i32=0;
            let hit:i32=-1;
            while(e<nmap){
                let en:i64=oid[e];
                let a0:i32=ma0[en] as i32;
                let a1:i32=ma1[en] as i32;
                let alen:i32=a1-a0;
                if(alen>0 && pos+alen<=text.len){
                    let k:i32=0;
                    while(k<alen && text[pos+k]==caseprob[a0+k]){k=k+1;}
                    if(k==alen){hit=en;break;}
                }
                e=e+1;
            }
            if(hit>=0){
                let b0:i32=mb0[hit] as i32;
                let b1:i32=mb1[hit] as i32;
                let blen:i32=b1-b0;
                if(dp+blen>dcap){return -1;}
                let k:i32=0;
                while(k<blen){dst[dp+k]=curprob[b0+k];k=k+1;}
                dp=dp+blen;
                pos=pos+(ma1[hit] as i32)-(ma0[hit] as i32);
            }
            else {
                if(dp+1>dcap){return -1;}
                dst[dp]=text[pos];
                dp=dp+1;
                pos=pos+1;
            }
        }
    }
    return dp;
}

// ---------- n4_run: full pipeline into out; returns bytes written (<0 = error) ----------

fn n4_run(out:[]u8,ocap:i32,pbuf:[]u8,pn:i32,sbuf:[]u8,sn:i32,store_src:[]u8,verdict:*i32)i32 {
    let pos:i32=0;
    pos=n4_emit(out,pos,"N4 ANALOG-NATIVE audit v1 (pure Zag, zero RNG)\n");
    pos=n4_emit(out,pos,"toolchain: znc_linux_x86_64_abed8aa1 (pinned)\n");
    // problem parse
    let pid:[]u8=cx_field(pbuf,pn,"ID: ");
    pid=cx_trim(pid);
    let stmt:[]u8=cx_field(pbuf,pn,"STATEMENT: ");
    stmt=cx_trim(stmt);
    if(stmt.len==0){stmt=cx_trim(pbuf[0..pn]);}
    pos=n4_emit(out,pos,"sealed-guard: passed (no sealed path opened)\n");
    pos=n4_emit(out,pos,"problem: ");
    pos=n4_emit(out,pos,pid);
    pos=n4_emit(out,pos," statement_bytes=");
    pos=n4_emit_i(out,pos,stmt.len);
    pos=n4_emit(out,pos,"\n");
    // store parse: header lines "[Kddd] ..." (R3 NL) or "Kddd <text>" (legacy),
    // claim text = following non-blank lines until blank line / next header.
    let koff:[]i64=nio_alloc(64*8) as []i64;
    let klen:[]i64=nio_alloc(64*8) as []i64;
    let toff:[]i64=nio_alloc(64*8) as []i64;
    let tlen:[]i64=nio_alloc(64*8) as []i64;
    let masks:[]i64=nio_alloc(64*8) as []i64;
    let nk:i32=0;
    let ls:i32=0;
    let kid_off:i32=-1;
    let tx0:i32=-1;
    let tx1:i32=-1;
    while(ls<=sn){
        let le:i32=sn;
        let ln:[]u8=sbuf[0..0];
        if(ls<sn){
            le=n4_find_nl(sbuf,sn,ls);
            ln=sbuf[ls..le];
        }
        let is_hdr:i32=0;
        let ko:i32=-1;
        let ts:i32=-1;
        if(ln.len>=6 && ln[0]==91 && ln[1]==75 && ln[2]>=48 && ln[2]<=57 && ln[3]>=48 && ln[3]<=57 && ln[4]>=48 && ln[4]<=57 && ln[5]==93){
            is_hdr=1;
            ko=ls+1;
            ts=-1;
        }
        else {
            if(ln.len>=6 && ln[0]==75 && ln[1]>=48 && ln[1]<=57 && ln[2]>=48 && ln[2]<=57 && ln[3]>=48 && ln[3]<=57 && ln[4]==32){
                is_hdr=1;
                ko=ls;
                ts=ls+5;
            }
        }
        let is_blank:i32=0;
        if(ls>=sn){is_blank=1;}
        else {
            if(cx_trim(ln).len==0){is_blank=1;}
        }
        if(is_hdr==1 || is_blank==1){
            if(kid_off>=0 && tx0>=0 && nk<64){
                koff[nk]=kid_off as i64;
                klen[nk]=4;
                toff[nk]=tx0 as i64;
                tlen[nk]=(tx1-tx0) as i64;
                masks[nk]=n4_shapes_of(sbuf[tx0..tx1]) as i64;
                nk=nk+1;
            }
            kid_off=-1;
            tx0=-1;
            tx1=-1;
            if(is_hdr==1){
                kid_off=ko;
                if(ts>=0){tx0=ts;tx1=le;}
            }
        }
        else {
            if(kid_off>=0){
                if(tx0<0){tx0=ls;tx1=le;}
                else {tx1=le;}
            }
        }
        if(ls>=sn){break;}
        ls=le+1;
    }
    pos=n4_emit(out,pos,"knowledge-store: ");
    pos=n4_emit(out,pos,store_src);
    pos=n4_emit(out,pos," items=");
    pos=n4_emit_i(out,pos,nk);
    pos=n4_emit(out,pos," idiom-licenses:");
    let shp:[]u8="MP";
    let bit:i32=1;
    let sh:i32=0;
    while(sh<4){
        pos=n4_emit(out,pos," ");
        pos=n4_emit(out,pos,shp);
        pos=n4_emit(out,pos,"@[");
        let first:i32=1;
        let ki:i32=0;
        while(ki<nk){
            if(((masks[ki] as i32) & bit)==bit){
                if(first==0){pos=n4_emit(out,pos,",");}
                let lka:i32=koff[ki] as i32;
                let lkb:i32=(koff[ki]+klen[ki]) as i32;
                pos=n4_emit(out,pos,sbuf[lka..lkb]);
                first=0;
            }
            ki=ki+1;
        }
        pos=n4_emit(out,pos,"]");
        if(sh==0){shp="CONTRA";bit=2;}
        else { if(sh==1){shp="LEMMA";bit=4;} else {shp="BICON";bit=8;} }
        sh=sh+1;
    }
    pos=n4_emit(out,pos,"\n");
    // goal skeleton: raw suffix after the task verb, no parsing into syntax
    let goal:[]u8=stmt;
    let gp:i32=n4_find(stmt,"Prove that ",0);
    if(gp>=0){goal=stmt[gp+11..];}
    else {
        gp=n4_find(stmt,"Show that ",0);
        if(gp>=0){goal=stmt[gp+10..];}
    }
    goal=cx_trim(goal);
    pos=n4_emit(out,pos,"goal-skeleton: ");
    pos=n4_emit(out,pos,goal);
    pos=n4_emit(out,pos,"\n");
    // RETRIEVE
    let tidx:[]i64=nio_alloc(3*8) as []i64;
    let dots:[]i64=nio_alloc(22*8) as []i64;
    let sqs:[]i64=nio_alloc(22*8) as []i64;
    let pk:[]i64=nio_alloc(4096*8) as []i64;
    let pc:[]i64=nio_alloc(4096*8) as []i64;
    let ck:[]i64=nio_alloc(4096*8) as []i64;
    let cc:[]i64=nio_alloc(4096*8) as []i64;
    let pn2:i32=n4_grams(stmt,pk,pc,4096);
    let t0:i64=-1;
    let t1:i64=-1;
    let t2:i64=-1;
    let c:i32=0;
    while(c<N4_NCASES){
        let cn:i32=n4_grams(n4_cprob(c),ck,cc,4096);
        let dot:i64=n4_dot(pk,pc,pn2,ck,cc,cn);
        let sq:i64=n4_sumsq(cc,cn);
        let val:i64=dot*dot*sq;
        dots[c]=dot;
        sqs[c]=sq;
        if(val>t0){t2=t1;tidx[2]=tidx[1];t1=t0;tidx[1]=tidx[0];t0=val;tidx[0]=c as i64;}
        else {
            if(val>t1){t2=t1;tidx[2]=tidx[1];t1=val;tidx[1]=c as i64;}
            else {
                if(val>t2){t2=val;tidx[2]=c as i64;}
            }
        }
        c=c+1;
    }
    pos=n4_emit(out,pos,"RETRIEVE (4-gram byte multiset cosine^2 = dot^2*sumsq_case; tie-break case id):\n");
    c=0;
    while(c<N4_NCASES){
        pos=n4_emit(out,pos,"  ");
        pos=n4_emit(out,pos,n4_cid(c));
        pos=n4_emit(out,pos," dot=");
        pos=n4_emit_i64(out,pos,dots[c]);
        pos=n4_emit(out,pos," sumsq=");
        pos=n4_emit_i64(out,pos,sqs[c]);
        pos=n4_emit(out,pos,"\n");
        c=c+1;
    }
    pos=n4_emit(out,pos,"TOP3: ");
    let t:i32=0;
    while(t<3){
        if(t>0){pos=n4_emit(out,pos," ");}
        pos=n4_emit(out,pos,n4_cid(tidx[t] as i32));
        t=t+1;
    }
    pos=n4_emit(out,pos,"\n");
    nio_free(pk);nio_free(pc);nio_free(ck);nio_free(cc);
    // per-case: ALIGN + ADAPT + VERIFY
    let ma0:[]i64=nio_alloc(4096*8) as []i64;
    let ma1:[]i64=nio_alloc(4096*8) as []i64;
    let mb0:[]i64=nio_alloc(4096*8) as []i64;
    let mb1:[]i64=nio_alloc(4096*8) as []i64;
    let oid:[]i64=nio_alloc(4096*8) as []i64;
    let survived:[]i64=nio_alloc(512*8) as []i64;
    let adst:[]u8=nio_alloc(32768);
    verdict.*=0;
    let derived_case:i32=-1;
    t=0;
    while(t<3){
        let ci:i32=tidx[t] as i32;
        let cid:[]u8=n4_cid(ci);
        let cprob:[]u8=n4_cprob(ci);
        let ccase:[]u8=n4_ctrace(ci);
        let si:i32=0;
        while(si<512){survived[si]=0;si=si+1;}
        pos=n4_emit(out,pos,"CASE ");
        pos=n4_emit(out,pos,cid);
        pos=n4_emit(out,pos," (from TRACE_P");
        pos=n4_emit(out,pos,cid[1..]);
        pos=n4_emit(out,pos,".txt):\n");
        // original verdict (TAIL ANSWER)
        let ov:[]u8="unknown";
        let tp:i32=n4_find(ccase,"TAIL ANSWER: ",0);
        if(tp>=0){
            let te:i32=n4_find_nl(ccase,ccase.len,tp);
            if(te<0){te=ccase.len;}
            ov=ccase[tp+13..te];
        }
        pos=n4_emit(out,pos,"  original-verdict=");
        pos=n4_emit(out,pos,ov);
        pos=n4_emit(out,pos,"\n");
        // ALIGN
        let nmap:i32=n4_align(cprob,stmt,ma0,ma1,mb0,mb1,4096);
        pos=n4_emit(out,pos,"  ALIGN: ");
        pos=n4_emit_i(out,pos,nmap);
        pos=n4_emit(out,pos," entries (case-span -> current-span):\n");
        let e:i32=0;
        while(e<nmap){
            let a0:i32=ma0[e] as i32;
            let a1:i32=ma1[e] as i32;
            let b0:i32=mb0[e] as i32;
            let b1:i32=mb1[e] as i32;
            pos=n4_emit(out,pos,"    [");
            pos=n4_emit_i(out,pos,a0);
            pos=n4_emit(out,pos,"..");
            pos=n4_emit_i(out,pos,a1);
            pos=n4_emit(out,pos,")->[");
            pos=n4_emit_i(out,pos,b0);
            pos=n4_emit(out,pos,"..");
            pos=n4_emit_i(out,pos,b1);
            pos=n4_emit(out,pos,") bytes=\"");
            let alen:i32=a1-a0;
            let show:i32=alen;
            if(show>48){show=48;}
            pos=n4_emit(out,pos,cprob[a0..a0+show]);
            if(alen>48){pos=n4_emit(out,pos,"...");}
            pos=n4_emit(out,pos,"\"\n");
            e=e+1;
        }
        // substitution order: longest a-span first, then lowest a0
        e=0;
        while(e<nmap){oid[e]=e as i64;e=e+1;}
        let p2:i32=1;
        while(p2<nmap){
            let tmp2:i64=oid[p2];
            let q2:i32=p2-1;
            while(q2>=0){
                let x:i64=oid[q2];
                let lx:i64=ma1[x]-ma0[x];
                let lt:i64=ma1[tmp2]-ma0[tmp2];
                let better:i32=0;
                if(lt>lx){better=1;}
                else {
                    if(lt==lx && ma0[tmp2]<ma0[x]){better=1;}
                }
                if(better==0){break;}
                oid[q2+1]=x;
                q2=q2-1;
            }
            oid[q2+1]=tmp2;
            p2=p2+1;
        }
        // walk trace steps
        let cl:i32=ccase.len;
        let ls2:i32=0;
        let nsteps:i32=0;
        let nsurv:i32=0;
        let case_pid:[]u8=cx_field(cprob,cprob.len,"ID: ");
        case_pid=cx_trim(case_pid);
        if(case_pid.len==0){case_pid=cx_concat("P",cid[1..]);}
        pos=n4_emit(out,pos,"  ADAPT+VERIFY (step order; DROP unverified; dependents dropped):\n");
        let dstep:i32=-1;
        while(ls2<cl){
            let le2:i32=n4_find_nl(ccase,cl,ls2);
            if(le2<0){le2=cl;}
            let line:[]u8=ccase[ls2..le2];
            if(line.len>2 && line[0]==83 && line[1]>=48 && line[1]<=57){
                // step line: S<num> [tag] CITES[...] :: <text>
                let snum:i32=n4_atoi(line[1..]);
                nsteps=nsteps+1;
                let tag:[]u8="";
                let cites:[]u8="";
                let text:[]u8="";
                let b0i:i32=n4_find(line,"[",0);
                let b1i:i32=n4_find(line,"]",0);
                if(b0i>=0 && b1i>b0i){tag=line[b0i+1..b1i];}
                let ci0:i32=n4_find(line,"CITES[",0);
                let tx0:i32=n4_find(line,"] :: ",0);
                if(ci0>=0 && tx0>ci0){cites=line[ci0+6..tx0];}
                if(tx0>=0 && tx0+5<line.len){text=line[tx0+5..];}
                let alen2:i32=n4_adapt(text,adst,32768,ma0,ma1,mb0,mb1,oid,nmap,cprob,stmt,case_pid,pid);
                let adapted:[]u8=adst[0..0];
                let vok:i32=-2;
                if(alen2>=0){
                    adapted=adst[0..alen2];
                    vok=n4_verify(adapted,masks,nk);
                }
                // dependency check: every "STEP k" cite must have survived
                let depok:i32=1;
                if(vok>=0){
                    let fp:i32=0;
                    while(fp<cites.len){
                        let sp2:i32=n4_find(cites,"STEP ",fp);
                        if(sp2<0){break;}
                        let kn:i32=n4_atoi(cites[sp2+5..]);
                        if(kn>=0 && kn<512 && survived[kn]==0){depok=0;break;}
                        fp=sp2+5;
                    }
                }
                let surv:i32=0;
                if(vok>=0 && depok==1){surv=1;}
                if(snum>=0 && snum<512){survived[snum]=surv as i64;}
                if(surv==1){
                    nsurv=nsurv+1;
                    if(dstep<0 && n4_find(adapted,goal,0)>=0){dstep=snum;}
                }
                pos=n4_emit(out,pos,"    S");
                pos=n4_emit_i(out,pos,snum);
                pos=n4_emit(out,pos," [");
                pos=n4_emit(out,pos,tag);
                pos=n4_emit(out,pos,"] adapted=");
                pos=n4_emit_i(out,pos,alen2);
                pos=n4_emit(out,pos,"B verify=");
                if(vok>=0){
                    let vka:i32=koff[vok] as i32;
                    let vkb:i32=(koff[vok]+klen[vok]) as i32;
                    pos=n4_emit(out,pos,sbuf[vka..vkb]);
                }
                else {pos=n4_emit(out,pos,"none");}
                pos=n4_emit(out,pos," deps=");
                if(depok==1){pos=n4_emit(out,pos,"ok");}
                else {pos=n4_emit(out,pos,"dropped-dep");}
                pos=n4_emit(out,pos," -> ");
                if(surv==1){pos=n4_emit(out,pos,"SURVIVED");}
                else {pos=n4_emit(out,pos,"DROPPED");}
                pos=n4_emit(out,pos,"\n");
            }
            ls2=le2+1;
        }
        pos=n4_emit(out,pos,"  CASE ");
        pos=n4_emit(out,pos,cid);
        pos=n4_emit(out,pos,": survived ");
        pos=n4_emit_i(out,pos,nsurv);
        pos=n4_emit(out,pos,"/");
        pos=n4_emit_i(out,pos,nsteps);
        if(dstep>=0){
            pos=n4_emit(out,pos," goal reached at S");
            pos=n4_emit_i(out,pos,dstep);
            pos=n4_emit(out,pos," -> DERIVE\n");
            verdict.*=1;
            derived_case=ci;
        }
        else {
            pos=n4_emit(out,pos," goal not reached -> CASE FAILS\n");
        }
        if(verdict.*==1){break;}
        t=t+1;
    }
    pos=n4_emit(out,pos,"ANSWER: ");
    if(verdict.*==1){
        pos=n4_emit(out,pos,"DERIVED from case ");
        pos=n4_emit(out,pos,n4_cid(derived_case));
        pos=n4_emit(out,pos,"\nREASON: surviving adapted chain reaches the goal skeleton; every step verified against the NL knowledge store and byte-cited.\n");
    }
    else {
        pos=n4_emit(out,pos,"WITHHELD\nREASON: all 3 retrieved cases failed to produce a verified adapted chain reaching the goal skeleton; every candidate step was dropped by the knowledge-license verifier or its dependents.\n");
    }
    nio_free(koff);nio_free(klen);nio_free(toff);nio_free(tlen);nio_free(masks);
    nio_free(tidx);nio_free(dots);nio_free(sqs);
    nio_free(ma0);nio_free(ma1);nio_free(mb0);nio_free(mb1);nio_free(oid);
    nio_free(survived);nio_free(adst);
    return pos;
}

// ---------- main ----------

fn main()i32 {
    if(_zag_argc()<3){
        _zag_println("usage: n4_bin <problem_nl> <out_path> [store_nl]");
        return 4;
    }
    let fpath:[]u8=_zag_arg(1);
    let opath:[]u8=_zag_arg(2);
    if(cx_has_sealed(fpath)==1){
        _zag_println("n4: sealed guard tripped on problem path");
        return 3;
    }
    let spath:[]u8="";
    if(_zag_argc()>=4){spath=_zag_arg(3);}
    if(spath.len>0 && cx_has_sealed(spath)==1){
        _zag_println("n4: sealed guard tripped on store path");
        return 3;
    }
    let pbuf:[]u8=nio_alloc(1048576);
    let sbuf:[]u8=nio_alloc(1048576);
    if(pbuf.len==0 || sbuf.len==0){return 4;}
    let plen:i64=cx_guarded_read(fpath,pbuf);
    if(plen==-99){
        _zag_println("n4: sealed guard tripped reading problem");
        return 3;
    }
    if(plen<=0){
        _zag_println("n4: cannot read problem file");
        return 4;
    }
    let slen:i64=0;
    let ssrc:[]u8="embedded";
    if(spath.len>0){
        slen=cx_guarded_read(spath,sbuf);
        if(slen==-99){
            _zag_println("n4: sealed guard tripped reading store");
            return 3;
        }
        if(slen<=0){
            _zag_println("n4: cannot read store file");
            return 4;
        }
        ssrc=spath;
    }
    else {
        let emb:[]u8=N4_STORE_BYTES;
        if(emb.len>sbuf.len){return 4;}
        let i:i32=0;
        while(i<emb.len){sbuf[i]=emb[i];i=i+1;}
        slen=emb.len as i64;
    }
    let ocap:i32=4194304;
    let o1:[]u8=nio_alloc(ocap);
    let o2:[]u8=nio_alloc(ocap);
    let o3:[]u8=nio_alloc(ocap);
    if(o1.len==0 || o2.len==0 || o3.len==0){return 4;}
    let v1:i32=0;
    let v2:i32=0;
    let v3:i32=0;
    let r1:i32=n4_run(o1,ocap,pbuf,plen as i32,sbuf,slen as i32,ssrc,&v1);
    let r2:i32=n4_run(o2,ocap,pbuf,plen as i32,sbuf,slen as i32,ssrc,&v2);
    let r3:i32=n4_run(o3,ocap,pbuf,plen as i32,sbuf,slen as i32,ssrc,&v3);
    if(r1<0 || r2<0 || r3<0){return 4;}
    if(r1!=r2 || r2!=r3){
        _zag_println("n4: DIVERGENCE across 3 in-process runs");
        return 5;
    }
    if(nio_equal(o1[0..r1],o2[0..r2])==0 || nio_equal(o2[0..r2],o3[0..r3])==0){
        _zag_println("n4: DIVERGENCE across 3 in-process runs (bytes differ)");
        return 5;
    }
    if(dlb_write_file(opath,o1[0..r1],r1)<0){
        _zag_println("n4: cannot write output");
        return 4;
    }
    if(v1==1){_zag_println("N4 verdict: DERIVED");}
    else {_zag_println("N4 verdict: WITHHELD");}
    return 0;
}

// extract.zag — smallest native evidence extractor.
//
// Design: DESIGN_EXTRACT.md. Turns dialogue turns ([]u8) into evidence
// events (bit, value, kind, rel) with per-event reliability tags.
// Fixed pattern table, case-insensitive substring matching, hedge
// downgrade (-1, floor 1). No imports, no RNG, no scores, no learning.
//
// This is honestly a perception stub with stated failure modes: the
// trial proves the pipeline runs end-to-end and that extraction errors
// degrade into abstention via the graded layer — not that extraction
// itself is solved.

const EXT_MAX_EVENTS:i32=12;
const EXT_EVENT_WORDS:i32=4;

fn ext_u32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn ext_u32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

// Event field accessors over the packed out-buffer.
fn ext_ev_bit(out:[]u8,e:i32)i32 { return ext_u32_get(out,e*16); }
fn ext_ev_val(out:[]u8,e:i32)i32 { return ext_u32_get(out,e*16+4); }
fn ext_ev_kind(out:[]u8,e:i32)i32 { return ext_u32_get(out,e*16+8); }
fn ext_ev_rel(out:[]u8,e:i32)i32 { return ext_u32_get(out,e*16+12); }

// Preregistered default reliability per kind (DESIGN_GRADED.md section 3).
fn ext_kind_rel(kind:i32)i32 {
    if(kind==0){return 2;}
    if(kind==1){return 3;}
    if(kind==2){return 2;}
    return 1;
}

fn ext_tolower(c:u8)u8 {
    let v:i32=c as i32;
    if(v>=65 && v<=90){return (v+32) as u8;}
    return c;
}

// 1 iff needle occurs in haystack (case-insensitive, deterministic).
fn ext_find(h:[]u8,n:[]u8)i32 {
    if(n.len==0 || n.len>h.len){return 0;}
    let i:i32=0;
    while((i+n.len)<=h.len){
        let j:i32=0;
        while(j<n.len){
            if(ext_tolower(h[i+j])!=ext_tolower(n[j])){break;}
            j=j+1;
        }
        if(j==n.len){return 1;}
        i=i+1;
    }
    return 0;
}

// 1 iff the turn contains a hedge marker (preregistered fixed list).
fn ext_hedged(turn:[]u8)i32 {
    if(ext_find(turn,"maybe")!=0){return 1;}
    if(ext_find(turn,"i think")!=0){return 1;}
    if(ext_find(turn,"might")!=0){return 1;}
    if(ext_find(turn,"probably")!=0){return 1;}
    if(ext_find(turn,"not sure")!=0){return 1;}
    return 0;
}

fn ext_emit(out:[]u8,n:*i32,bit:i32,val:i32,kind:i32,hd:i32)void {
    if(n==null as *i32){return;}
    let c:i32=n.*;
    if(c<0 || c>=EXT_MAX_EVENTS){return;}
    let rel:i32=ext_kind_rel(kind);
    if(hd!=0){rel=rel-1;if(rel<1){rel=1;}}
    ext_u32_set(out,c*16,bit);
    ext_u32_set(out,c*16+4,val);
    ext_u32_set(out,c*16+8,kind);
    ext_u32_set(out,c*16+12,rel);
    n.*=c+1;
}

// Extract one turn into the packed out-buffer (capacity: 12 events =
// 192 bytes). Sets *n to the event count. Denials are checked before
// their affirmations; the pattern order is fixed and deterministic.
fn ext_extract(turn:[]u8,out:[]u8,n:*i32)i32 {
    if(n==null as *i32){return -1;}
    if(out.len<EXT_MAX_EVENTS*16){return -1;}
    n.*=0;
    let hd:i32=ext_hedged(turn);
    // name claims / denials (kind 0)
    if(ext_find(turn,"not alice")!=0){ext_emit(out,n,0,0,0,hd);}
    else{if(ext_find(turn,"i am alice")!=0){ext_emit(out,n,0,1,0,hd);}}
    if(ext_find(turn,"not bob")!=0){ext_emit(out,n,1,0,0,hd);}
    else{if(ext_find(turn,"i am bob")!=0){ext_emit(out,n,1,1,0,hd);}}
    if(ext_find(turn,"not carol")!=0){ext_emit(out,n,2,0,0,hd);}
    else{if(ext_find(turn,"i am carol")!=0){ext_emit(out,n,2,1,0,hd);}}
    // secret demonstrations (kind 1)
    if(ext_find(turn,"secret is ember")!=0){ext_emit(out,n,3,1,1,hd);}
    if(ext_find(turn,"secret is quartz")!=0){ext_emit(out,n,4,1,1,hd);}
    if(ext_find(turn,"secret is harbor")!=0){ext_emit(out,n,7,1,1,hd);}
    // episode recall (kind 2)
    if(ext_find(turn,"blue door")!=0){ext_emit(out,n,6,1,2,hd);}
    // fact K assertion / denial (kind 3)
    if(ext_find(turn,"kestrel is not")!=0){ext_emit(out,n,5,0,3,hd);}
    else{if(ext_find(turn,"kestrel")!=0){ext_emit(out,n,5,1,3,hd);}}
    // behavioral marks (kind 2)
    if(ext_find(turn,"--a")!=0){ext_emit(out,n,8,1,2,hd);}
    if(ext_find(turn,"look here")!=0){ext_emit(out,n,9,1,2,hd);}
    if(ext_find(turn,"hmm.")!=0){ext_emit(out,n,10,1,2,hd);}
    return 0;
}

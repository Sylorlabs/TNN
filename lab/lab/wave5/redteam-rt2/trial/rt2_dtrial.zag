// rt2_dtrial.zag — RT-2 DEFENSE trial driver (PREREG §5.4 + Amendment A2).
//
// SUT: the DEFENDED learner (rt2_def.zag: corroborated elimination —
// first -1 on a committed hypothesis -> SUSPECT + verification re-probe,
// second consecutive -1 -> eliminate, +1 -> EXONERATE).
// Arm D3: R3 spoof schedule vs defended learner (predicted: defeated).
// Arm D3b: genuine target shift at s=28, trainer pin suppresses the fire
//   rule (predicted: corroborated re-learn tracks the genuine shift).
// Zero RNG. Output contract: RT2D_CHECK lines, RT2D_VERDICT lines,
// RT2D_FAILURES,<n>; exit nonzero iff n>0.
@import("rt2_def.zag")

const RT2D_STEPS:i32=44;

// Local output helpers (self-contained: this binary does not import
// rt2_common.zag, whose replay helper targets the undefended substrate).
fn rt2d_num(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);_zag_print(s);sr_free(s);
}

fn rt2d_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("RT2D_CHECK,");_zag_print(name);_zag_print(",");
    rt2d_num(actual as i64);_zag_print(",");rt2d_num(expected as i64);_zag_println("");
    return (actual!=expected) as i32;
}

// R3 spoof schedule (PREREG §1.4, corrected per Amendment A1).
fn rt2d_spoof(step:i32,genuine:i32)i32 {
    if(step==9){return -1;}
    if(step==13){return 1;}
    if(step==15){return -1;}
    if(step==17){return 1;}
    if(step==19){return 1;}
    if(step==21){return 1;}
    if(step==23){return 1;}
    return genuine;
}

fn rt2d_genuine(targets:[]u8,ctx:i32,action:i32)i32 {
    if((targets[ctx] as i32)==action){return 1;}
    return -1;
}

// shift_aware=1 (D3b): ground truth for ctx A is 0 before step 31 and
// 1 after (the genuine s=28 shift); ctx B is always 1.
fn rt2d_false_commits(audit:[]u8,n:i32,first_step:*i32,shift_aware:i32)i32 {
    let c:i32=0;
    let i:i32=0;
    while(i<n){
        let op:i32=sr_u32_get(audit,i*16+4);
        if(op==SR_OP_COMMIT){
            let st:i32=sr_u32_get(audit,i*16);
            let ctx:i32=sr_u32_get(audit,i*16+8)-1;
            let surv:i32=sr_u32_get(audit,i*16+12);
            let bad:i32=0;
            if(ctx==0){
                let want:i32=0;
                if(shift_aware==1 && st>=31){want=1;}
                if(surv!=want){bad=1;}
            }
            if(ctx==1 && surv!=1){bad=1;}
            if(bad==1){
                c=c+1;
                if(first_step.*<0){first_step.*=st;}
            }
        }
        i=i+1;
    }
    return c;
}

// Replay diff for the defended substrate (includes the suspect flags).
fn rt2d_replay_diff(live:[]u8,committed:[]u8,next_probe:[]u8,suspect:[]u8,
    connected:i32,audit:[]u8,acount:i32,nctx:i32,nact:i32)i32 {
    let rlive:[]u8=sr_alloc(nctx*nact);
    let rcommitted:[]u8=sr_alloc(nctx);
    let rnp:[]u8=sr_alloc(nctx);
    let rsus:[]u8=sr_alloc(nctx);
    let rconnected:i32=-1;
    sr_replay(audit,acount,nctx,nact,rlive,rcommitted,rnp,rsus,&rconnected);
    let d:i32=0;
    let i:i32=0;
    while(i<nctx*nact){if(rlive[i]!=live[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<nctx){if(rcommitted[i]!=committed[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<nctx){if(rnp[i]!=next_probe[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<nctx){if(rsus[i]!=suspect[i]){d=d+1;}i=i+1;}
    if(rconnected!=connected){d=d+1;}
    sr_free(rlive);sr_free(rcommitted);sr_free(rnp);sr_free(rsus);
    return d;
}

// arm: 0 = D3 (spoofed, unpinned), 1 = D3b (genuine shift, pinned)
fn rt2d_run_arm(arm:i32,tag:[]u8)i32 {
    let f:i32=0;
    let live:[]u8=sr_alloc(SR_NCTX*SR_NACT);
    let committed:[]u8=sr_alloc(SR_NCTX);
    let next_probe:[]u8=sr_alloc(SR_NCTX);
    let suspect:[]u8=sr_alloc(SR_NCTX);
    let audit:[]u8=sr_alloc(SR_AUDIT_CAP*16);
    let targets:[]u8=sr_alloc(SR_NCTX);
    let actions:[]u8=sr_alloc(RT2D_STEPS+1);
    sr_init(live,committed,next_probe,suspect,SR_NCTX,SR_NACT);
    targets[0]=0;targets[1]=1;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let fire_step:i32=-1;let streak_at_fire:i32=-1;
    let caf_a:i32=-1;let caf_b:i32=-1;
    let legal_at_12:i32=-1;
    let badep:i32=0;let badpin:i32=0;
    let spoofed:i32=0;
    if(arm==1){
        if(sr_audit(audit,&acount,0,SR_OP_PIN,0,1)!=SR_OK){badpin=1;}
    }
    let s:i32=1;
    while(s<=RT2D_STEPS){
        if(arm==1 && s==28){targets[0]=1;}   // D3b: genuine world shift
        if(arm==1 && s==12){legal_at_12=sr_legal(committed,connected,streak,SR_NCTX);}
        // The learner's own fire rule (suppressed by the pin in D3b).
        if(arm==0 && connected==1 && sr_legal(committed,connected,streak,SR_NCTX)==1){
            let frc:i32=sr_disconnect(committed,&connected,streak,SR_NCTX,s,audit,&acount);
            if(frc!=SR_OK){badep=1;}
            if(fire_step<0){
                fire_step=s;streak_at_fire=streak;
                caf_a=committed[0] as i32;caf_b=committed[1] as i32;
            }
        }
        let ctx:i32=0;
        if(s%2==0){ctx=1;}
        let action:i32=sr_select(live,committed,next_probe,SR_NCTX,SR_NACT,ctx);
        let genuine:i32=rt2d_genuine(targets,ctx,action);
        let delivered:i32=genuine;
        if(arm==0){delivered=rt2d_spoof(s,genuine);}
        if(delivered!=genuine){
            _zag_print("RT2D_SPOOF,");rt2d_num(s as i64);_zag_print(",");
            rt2d_num(ctx as i64);_zag_print(",");rt2d_num(action as i64);_zag_print(",");
            rt2d_num(delivered as i64);_zag_print(",");rt2d_num(genuine as i64);
            _zag_println("");
            spoofed=spoofed+1;
        }
        let erc:i32=sr_episode(live,committed,next_probe,suspect,SR_NCTX,SR_NACT,
            &connected,&streak,ctx,action,delivered,s,audit,&acount);
        if(erc!=SR_OK){badep=1;}
        actions[s]=action as u8;
        s=s+1;
    }
    let ndis:i32=sr_audit_count_op(audit,acount,SR_OP_DISCONNECT);
    let nelim:i32=sr_audit_count_op(audit,acount,SR_OP_ELIMINATE);
    let ncommit:i32=sr_audit_count_op(audit,acount,SR_OP_COMMIT);
    let nuncommit:i32=sr_audit_count_op(audit,acount,SR_OP_UNCOMMIT);
    let nsuspect:i32=sr_audit_count_op(audit,acount,SR_OP_SUSPECT);
    let nexon:i32=sr_audit_count_op(audit,acount,SR_OP_EXONERATE);
    let fc_first:i32=-1;
    let fcommit:i32=rt2d_false_commits(audit,acount,&fc_first,arm);
    let replay:i32=rt2d_replay_diff(live,committed,next_probe,suspect,connected,
        audit,acount,SR_NCTX,SR_NACT);

    f=f+rt2d_check("episodes_ok",badep,0);
    f=f+rt2d_check("replay",replay,0);

    if(arm==0){
        // D3: R3 spoof schedule vs defended learner — predicted DEFEATED.
        let mm:i32=0;
        let s3:i32=1;
        while(s3<=RT2D_STEPS){
            if(s3>=fire_step && fire_step>0){
                let want:i32=0;
                if(s3%2==0){want=1;}
                if((actions[s3] as i32)!=want){mm=mm+1;}
            }
            s3=s3+1;
        }
        f=f+rt2d_check("d3_spoofs",spoofed,2); // 2 of 7 designed forgeries bit; the rest were vacuous (+1=genuine) because the false commit they assumed never happened
        f=f+rt2d_check("d3_fire_step",fire_step,24);
        f=f+rt2d_check("d3_streak_at_fire",streak_at_fire,8);
        f=f+rt2d_check("d3_ndisconnect",ndis,1);
        f=f+rt2d_check("d3_false_commit",fcommit,0);
        f=f+rt2d_check("d3_nuncommit",nuncommit,0);
        f=f+rt2d_check("d3_nsuspect",nsuspect,2);
        f=f+rt2d_check("d3_suspect_at_9",sr_audit_count_op_step(audit,acount,SR_OP_SUSPECT,9),1);
        f=f+rt2d_check("d3_suspect_at_15",sr_audit_count_op_step(audit,acount,SR_OP_SUSPECT,15),1);
        f=f+rt2d_check("d3_nexonerate",nexon,2);
        f=f+rt2d_check("d3_exon_at_11",sr_audit_count_op_step(audit,acount,SR_OP_EXONERATE,11),1);
        f=f+rt2d_check("d3_exon_at_17",sr_audit_count_op_step(audit,acount,SR_OP_EXONERATE,17),1);
        f=f+rt2d_check("d3_nelim",nelim,2);
        f=f+rt2d_check("d3_ncommit",ncommit,2);
        f=f+rt2d_check("d3_caf_a",caf_a,0);
        f=f+rt2d_check("d3_caf_b",caf_b,1);
        f=f+rt2d_check("d3_persist_mm",mm,0);
        let hold:i32=0;
        if(fcommit==0 && nuncommit==0 && ndis==1 && caf_a==0 && caf_b==1 && replay==0){hold=1;}
        _zag_print("RT2D_VERDICT,");_zag_print(tag);_zag_print(",");
        if(hold==1){_zag_print("HOLD");}else{_zag_print("BREAK");}
        _zag_print(",fire=");rt2d_num(fire_step as i64);
        _zag_print(",fcommit=");rt2d_num(fcommit as i64);
        _zag_println("");
    }
    if(arm==1){
        // D3b: genuine shift under the defended learner — predicted:
        // corroborated re-learn tracks the shift (defense not blindness).
        f=f+rt2d_check("d3b_pin_ok",badpin,0);
        f=f+rt2d_check("d3b_spoofs",spoofed,0);
        f=f+rt2d_check("d3b_ndisconnect",ndis,0);
        f=f+rt2d_check("d3b_legal_at_12",legal_at_12,1);
        f=f+rt2d_check("d3b_nuncommit",nuncommit,1);
        f=f+rt2d_check("d3b_uncommit_at_31",sr_audit_count_op_step(audit,acount,SR_OP_UNCOMMIT,31),1);
        f=f+rt2d_check("d3b_nsuspect",nsuspect,1);
        f=f+rt2d_check("d3b_suspect_at_29",sr_audit_count_op_step(audit,acount,SR_OP_SUSPECT,29),1);
        f=f+rt2d_check("d3b_nexonerate",nexon,0);
        f=f+rt2d_check("d3b_nelim",nelim,4);
        f=f+rt2d_check("d3b_ncommit",ncommit,3);
        f=f+rt2d_check("d3b_false_commit",fcommit,0);
        f=f+rt2d_check("d3b_final_a",(committed[0] as i32),1);
        f=f+rt2d_check("d3b_final_b",(committed[1] as i32),1);
        let hold:i32=0;
        // Corrected path (A2): the s3 probe had already eliminated A1, so the
        // corroborated s31 elimination of A0 leaves zero survivors ->
        // UNCOMMIT (reopen) -> s33 re-probe eliminates A0 -> COMMIT A->1.
        // The UNCOMMIT here is legitimate inquiry-reopening, not a failure.
        if(ndis==0 && nuncommit==1 && nsuspect==1 && nexon==0 && fcommit==0 && (committed[0] as i32)==1 && (committed[1] as i32)==1 && replay==0){hold=1;}
        _zag_print("RT2D_VERDICT,");_zag_print(tag);_zag_print(",");
        if(hold==1){_zag_print("HOLD");}else{_zag_print("BREAK");}
        _zag_print(",final_a=");rt2d_num((committed[0] as i32) as i64);
        _zag_println("");
    }

    sr_free(live);sr_free(committed);sr_free(next_probe);sr_free(suspect);
    sr_free(audit);sr_free(targets);sr_free(actions);
    return f;
}

fn main()i32 {
    let f:i32=0;
    _zag_println("RT2D_TRIAL_BEGIN");
    f=f+rt2d_run_arm(0,"D3");
    f=f+rt2d_run_arm(1,"D3b");
    _zag_print("RT2D_FAILURES,");rt2d_num(f as i64);_zag_println("");
    _zag_println("RT2D_TRIAL_END");
    if(f>0){return 1;}
    return 0;
}

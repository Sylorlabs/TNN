// Environment-owned state. This module is NEVER imported by the learner.
// Rendering exposes pixels; delayed outcomes expose the initiating action ID.
@import("observation.zag")

const CW_BYTES:i32=96;
struct CWOutcome {status:i32,action:i32,tick:i32,value:i32}
fn cw_valid(w:[]u8)i32 {
    if(w.len!=CW_BYTES || nio_equal(w[0..8],"TNNWRL01")!=1){return cl_bad();}
    if(cl_u32(w,8)>1000000 || cl_u32(w,12)<1 || cl_u32(w,12)>2147483646 || cl_u32(w,16)>7 || cl_u32(w,20)>7 || cl_u32(w,24)>7 || cl_u32(w,28)>1 || cl_u32(w,32)>1 || cl_u32(w,36)>1){return cl_bad();}
    if(cl_u32(w,40)>1000003 || cl_u32(w,44)>1000000 || cl_u32(w,48)>2 || cl_u32(w,52)>1000000 || cl_u32(w,56)>1000000 || cl_u32(w,60)>1000000 || cl_zero(w[64..96])!=1){return cl_bad();}
    if(cl_u32(w,44)==0 && (cl_u32(w,40)!=0 || cl_u32(w,48)!=0)){return cl_bad();}
    if(cl_u32(w,44)>0 && (cl_u32(w,40)<=cl_u32(w,8) || cl_u32(w,44)>cl_u32(w,8) || cl_u32(w,48)<1)){return cl_bad();}
    return 0;
}
fn cw_init(w:[]u8,seed:i32)i32 {
    if(w.len!=CW_BYTES || seed<1 || seed>2147483646){return cl_bad();}
    let i:i32=0;while(i<w.len){w[i]=0;i=i+1;}
    cl_copy(w[0..8],"TNNWRL01");cl_put(w,12,seed as i64);cl_put(w,16,3);cl_put(w,20,2);cl_put(w,24,6);cl_put(w,32,1);return 0;
}
fn cw_abs(x:i32)i32 {if(x<0){return 0-x;}return x;}
fn cw_step(w:[]u8,action:i32)CWOutcome {
    let rc:i32=cw_valid(w);if(rc!=0 || action<0 || action>4 || cl_u32(w,8)>=999999){return CWOutcome{.status=cl_bad(),.action=0,.tick=0,.value=0};}
    let tick:i32=(cl_u32(w,8) as i32)+1;let actor:i32=cl_u32(w,16) as i32;let pending:i32=cl_u32(w,44) as i32;
    // Refusal happens before any change. At most one pending touch in v1.
    if(action==4 && pending!=0){return CWOutcome{.status=cl_capacity(),.action=0,.tick=0,.value=0};}
    let o:CWOutcome=CWOutcome{.status=0,.action=0,.tick=tick,.value=0};
    if(pending>0 && tick>=cl_u32(w,40)){
        o.action=pending;o.value=-1;if(cl_u32(w,48)==2){o.value=1;}
        cl_put(w,40,0);cl_put(w,44,0);cl_put(w,48,0);
    }
    if(action==1 && actor>0){actor=actor-1;}if(action==2 && actor<7){actor=actor+1;}
    cl_put(w,16,actor as i64);cl_put(w,36,0);
    if(action==3){cl_put(w,36,1);cl_put(w,56,cl_u32(w,56)+1);}
    if(action==4){
        let object:i32=0;if(actor==cl_u32(w,20)){object=1;}else if(actor==cl_u32(w,24)){object=2;}
        if(object>0){
            let reward:i32=1;if((object==1 && cl_u32(w,28)==0) || (object==2 && cl_u32(w,28)==1)){reward=2;}
            cl_put(w,40,(tick+3) as i64);cl_put(w,44,tick as i64);cl_put(w,48,reward as i64);
        }
    }
    // Unpredictable to a stateless observer; RNG belongs only to the world.
    let rng:i64=(cl_u32(w,12)*48271)%2147483647;cl_put(w,12,rng);cl_put(w,8,tick as i64);cl_put(w,52,tick as i64);
    return o;
}
fn cw_change(w:[]u8,regime:i32,occluded:i32)i32 {
    if(cw_valid(w)!=0 || regime<0 || regime>1 || occluded<0 || occluded>1){return cl_bad();}
    cl_put(w,28,regime as i64);cl_put(w,32,occluded as i64);return 0;
}
fn cw_render(w:[]u8,pixels:[]u8)i32 {
    if(cw_valid(w)!=0 || pixels.len!=192 || cl_disjoint(w,pixels)!=1){return cl_bad();}
    let i:i32=0;while(i<pixels.len){pixels[i]=12;i=i+1;}
    let actor:i32=cl_u32(w,16) as i32;let obj:i32=0;
    while(obj<2){let x:i32=cl_u32(w,20+obj*4) as i32;
        let visible:i32=(cw_abs(x-actor)<=2 && (cl_u32(w,32)==0 || x!=4 || cl_u32(w,36)==1)) as i32;
        if(visible==1){let at:i32=(3*8+x)*3;pixels[at]=160;pixels[at+1]=160;pixels[at+2]=160;
            // Inspect yields a physical local feature, not the hidden regime.
            if(cl_u32(w,36)==1){pixels[at+2]=(48+obj*144) as u8;}}
        obj=obj+1;
    }
    let pos:i32=(6*8+actor)*3;pixels[pos]=32;pixels[pos+1]=220;pixels[pos+2]=32;return 0;
}
fn cw_observe(w:[]u8,out:[]u8)i32 {
    if(cw_valid(w)!=0 || out.len!=304){return cl_bad();}
    let pixels:[]u8=nio_alloc(192);if(pixels.len!=192){return cl_io();}
    let rc:i32=cw_render(w,pixels);
    if(rc==0){rc=cl_observation_make(out,pixels,(cl_u32(w,8) as i32)+1,1,1,cl_u32(w,8)*1000,2,0,8,8,3,cl_u32(w,52) as i32);}
    nio_free(pixels);return rc;
}

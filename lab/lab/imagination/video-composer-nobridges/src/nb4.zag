// ================= NO-BRIDGES COMPOSER: nb4 — decision =================
// The winning invented method is applied to the middle frame. Its labels are
// split into connected pieces (parts). The mechanism then states and applies
// its own subject rule: the instruction names two subjects to merge, and the
// subject of a memory is the part that moves most — the thing the video is
// about moves; the backdrop does not. Substance bar (its own standard): a
// subject must cover at least 1/100 of the frame; anything smaller is speckle.
// Output: subject mask + segout record (16 i64):
//   [0] area [8] x0 [16] y0 [24] x1 [32] y1 [40] cx [48] cy
//   [56] centrality_x1e4 [64] track_thr [72] win_method [80] subj_meanE
//   [88] subj_mean_gray [96] nparts [104] subject_label

fn nb_comp_scan(lab:[]u8, id:i64, gray:[]u8, E:[]u8, W:i64, H:i64, N:i64, out:[]u8) i64 {
    let area:i64 = 0;
    let x0:i64 = W;
    let y0:i64 = H;
    let x1:i64 = -1;
    let y1:i64 = -1;
    let sx:i64 = 0;
    let sy:i64 = 0;
    let sg:i64 = 0;
    let se:i64 = 0;
    let p:i64 = 0;
    while (p < N) {
        if (h_get64(lab, p * 8) == id) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            area = area + 1;
            sx = sx + x;
            sy = sy + y;
            sg = sg + (gray[p] as i64);
            se = se + h_get64(E, p * 8);
            if (x < x0) { x0 = x; }
            if (x > x1) { x1 = x; }
            if (y < y0) { y0 = y; }
            if (y > y1) { y1 = y; }
        }
        p = p + 1;
    }
    if (area == 0) { return 0; }
    h_put64(out, 0, area);
    h_put64(out, 8, x0);
    h_put64(out, 16, y0);
    h_put64(out, 24, x1);
    h_put64(out, 32, y1);
    h_put64(out, 40, sx / area);
    h_put64(out, 48, sy / area);
    h_put64(out, 56, sg / area);
    h_put64(out, 64, se / area);
    return area;
}

// one-pass stats for every connected piece of one label map.
// stats = (nc+1) x 80 bytes, same row layout as nb_comp_scan:
// [0]area [8]x0 [16]y0 [24]x1 [32]y1 [40]cx [48]cy [56]meangray [64]meanE.
// Replaces the per-piece full-frame rescan (O(nc*N)) with a single pass.
fn nb_parts_stats(lab:[]u8, nc:i64, gray:[]u8, E:[]u8, W:i64, H:i64, N:i64, stats:[]u8) void {
    let id:i64 = 0;
    while (id <= nc) {
        let so:i64 = id * 80;
        h_put64(stats, so, 0);
        h_put64(stats, so + 8, W);
        h_put64(stats, so + 16, H);
        h_put64(stats, so + 24, -1);
        h_put64(stats, so + 32, -1);
        h_put64(stats, so + 40, 0);
        h_put64(stats, so + 48, 0);
        h_put64(stats, so + 56, 0);
        h_put64(stats, so + 64, 0);
        h_put64(stats, so + 72, 0);
        id = id + 1;
    }
    let p:i64 = 0;
    while (p < N) {
        let i2:i64 = h_get64(lab, p * 8);
        if (i2 > 0) {
            let so:i64 = i2 * 80;
            let x:i64 = p % W;
            let y:i64 = p / W;
            h_put64(stats, so, h_get64(stats, so) + 1);
            if (x < h_get64(stats, so + 8)) { h_put64(stats, so + 8, x); }
            if (x > h_get64(stats, so + 24)) { h_put64(stats, so + 24, x); }
            if (y < h_get64(stats, so + 16)) { h_put64(stats, so + 16, y); }
            if (y > h_get64(stats, so + 32)) { h_put64(stats, so + 32, y); }
            h_put64(stats, so + 40, h_get64(stats, so + 40) + x);
            h_put64(stats, so + 48, h_get64(stats, so + 48) + y);
            h_put64(stats, so + 56, h_get64(stats, so + 56) + (gray[p] as i64));
            h_put64(stats, so + 64, h_get64(stats, so + 64) + h_get64(E, p * 8));
        }
        p = p + 1;
    }
    id = 1;
    while (id <= nc) {
        let so:i64 = id * 80;
        let a:i64 = h_get64(stats, so);
        if (a > 0) {
            h_put64(stats, so + 40, h_get64(stats, so + 40) / a);
            h_put64(stats, so + 48, h_get64(stats, so + 48) / a);
            h_put64(stats, so + 56, h_get64(stats, so + 56) / a);
            h_put64(stats, so + 64, h_get64(stats, so + 64) / a);
        }
        id = id + 1;
    }
}

fn nb_decide(st:[]u8, winner:i64, mtab:[]u8, W:i64, H:i64, N:i64, E:[]u8, gray:[]u8, fb:[]u8, fr:[]u8, labB:[]u8, labbuf:[]u8, mask:[]u8, tr:[]u8, toc:[]u8, segout:[]u8, subj_mask:[]u8) i64 {    let to:i64 = h_get64(toc, 0);
    let wmo:i64 = winner * 112;
    let fkind:i64 = h_get64(mtab, wmo);
    let proc:i64 = h_get64(mtab, wmo + 8);
    let l1:i64 = h_get64(mtab, wmo + 16);
    let l2:i64 = h_get64(mtab, wmo + 24);
    let nparts:i64 = h_get64(mtab, wmo + 32);
    nb_apply(st, 12, fkind, proc, l1, l2, W, H, N, E, gray, fb, fr, labB);
    // gray now holds the frame-12 gray plane; global median gray for tracking
    let hist:[]u8 = nio_alloc(256);
    let mm:[]u8 = nio_alloc(16);
    nb_hist(gray, 0, N, hist, mm);
    let gmed:i64 = nb_hist_pct(hist, N, 50, h_get64(mm, 0), h_get64(mm, 8));
    nio_free(hist);
    nio_free(mm);
    to = tr_str(tr, to, " DECIDE: winner ");
    to = nb_tr_method(tr, to, fkind, proc, l1, l2);
    to = tr_str(tr, to, " on the middle frame: ");
    to = tr_i64(tr, to, nparts);
    to = tr_str(tr, to, " parts; frame median gray = ");
    to = tr_i64(tr, to, gmed);
    to = tr_nl(tr, to);
    to = tr_str(tr, to, " subject rule (my own): the instruction names two subjects to merge.\n");
    to = tr_str(tr, to, "  The subject of a memory is the part that moves most — the thing the video\n");
    to = tr_str(tr, to, "  is about moves; the backdrop does not. Substance bar: >= 1/100 of the frame.\n");
    let stats:[]u8 = nio_alloc(80);
    let best_id:i64 = -1;
    let best_lab:i64 = -1;
    let best_me:i64 = -1;
    let best_area:i64 = 0;
    let big_id:i64 = -1;
    let big_lab:i64 = -1;
    let big_area:i64 = 0;
    let minsub:i64 = N / 100;
    let L:i64 = 0;
    while (L < nparts) {
        let p:i64 = 0;
        while (p < N) {
            if ((labB[p] as i64) == L) { mask[p] = 1; } else { mask[p] = 0; }
            p = p + 1;
        }
        let nc:i64 = seg_label(mask, labbuf, W, H);
        to = tr_str(tr, to, "  part ");
        to = tr_i64(tr, to, L);
        to = tr_str(tr, to, ": ");
        to = tr_i64(tr, to, nc);
        to = tr_str(tr, to, " connected piece(s)\n");
        let pstats:[]u8 = nio_alloc(((nc + 1) * 80) as i32);
        nb_parts_stats(labbuf, nc, gray, E, W, H, N, pstats);
        let id:i64 = 1;
        let traced:i64 = 0;
        while (id <= nc) {
            let so:i64 = id * 80;
            let a:i64 = h_get64(pstats, so);
            if (a > 0) {
                let me:i64 = h_get64(pstats, so + 64);
                if (traced < 25) {
                    to = tr_str(tr, to, "   piece #");
                    to = tr_i64(tr, to, id);
                    to = tr_str(tr, to, ": area=");
                    to = tr_i64(tr, to, a);
                    to = tr_str(tr, to, " bbox=(");
                    to = tr_i64(tr, to, h_get64(pstats, so + 8));
                    to = tr_str(tr, to, ",");
                    to = tr_i64(tr, to, h_get64(pstats, so + 16));
                    to = tr_str(tr, to, ")-(");
                    to = tr_i64(tr, to, h_get64(pstats, so + 24));
                    to = tr_str(tr, to, ",");
                    to = tr_i64(tr, to, h_get64(pstats, so + 32));
                    to = tr_str(tr, to, ") centroid=(");
                    to = tr_i64(tr, to, h_get64(pstats, so + 40));
                    to = tr_str(tr, to, ",");
                    to = tr_i64(tr, to, h_get64(pstats, so + 48));
                    to = tr_str(tr, to, ") meanE=");
                    to = tr_i64(tr, to, me);
                    to = tr_str(tr, to, " meanGray=");
                    to = tr_i64(tr, to, h_get64(pstats, so + 56));
                    to = tr_nl(tr, to);
                    traced = traced + 1;
                }
                if (a > big_area) {
                    big_area = a;
                    big_id = id;
                    big_lab = L;
                }
                if (a >= minsub) {
                    if (me > best_me) {
                        best_me = me;
                        best_id = id;
                        best_lab = L;
                        best_area = a;
                    } else {
                        if (me == best_me) {
                            if (a > best_area) {
                                best_id = id;
                                best_lab = L;
                                best_area = a;
                            }
                        }
                    }
                }
            }
            id = id + 1;
        }
        if (nc > traced) {
            to = tr_str(tr, to, "   ... +");
            to = tr_i64(tr, to, nc - traced);
            to = tr_str(tr, to, " further piece(s) considered in the subject decision, not listed");
            to = tr_nl(tr, to);
        }
        nio_free(pstats);
        L = L + 1;
    }
    nio_free(stats);
    let subj_id:i64 = best_id;
    let subj_lab:i64 = best_lab;
    let fellback:i64 = 0;
    if (subj_id < 0) {
        subj_id = big_id;
        subj_lab = big_lab;
        fellback = 1;
    }
    // rebuild the subject's label map to isolate its pixels
    let p:i64 = 0;
    while (p < N) {
        if ((labB[p] as i64) == subj_lab) { mask[p] = 1; } else { mask[p] = 0; }
        p = p + 1;
    }
    seg_label(mask, labbuf, W, H);
    let stats2:[]u8 = nio_alloc(80);
    nb_comp_scan(labbuf, subj_id, gray, E, W, H, N, stats2);
    let sarea:i64 = h_get64(stats2, 0);
    let scx:i64 = h_get64(stats2, 40);
    let scy:i64 = h_get64(stats2, 48);
    let sgray:i64 = h_get64(stats2, 56);
    let sme:i64 = h_get64(stats2, 64);
    // gray spread of the subject (for the tracking level)
    let m2:i64 = 0;
    p = 0;
    while (p < N) {
        if (h_get64(labbuf, p * 8) == subj_id) {
            let d:i64 = (gray[p] as i64) - sgray;
            m2 = m2 + d * d;
        }
        p = p + 1;
    }
    nio_free(stats2);
    let sstd:i64 = 0;
    if (sarea > 0) { sstd = isqrt(m2 / sarea); }
    let thr:i64 = 0;
    let dark:i64 = 0;
    if (sgray < gmed) {
        dark = 1;
        thr = sgray + sstd;
    } else {
        thr = 0 - (sgray - sstd);
    }
    let dx:i64 = scx - W / 2;
    let dy:i64 = scy - H / 2;
    let dist:i64 = isqrt(dx * dx + dy * dy);
    let cent:i64 = 400 * 10000 / (400 + dist);
    // subject mask
    p = 0;
    while (p < N) {
        if (h_get64(labbuf, p * 8) == subj_id) { subj_mask[p] = 1; } else { subj_mask[p] = 0; }
        p = p + 1;
    }
    h_put64(segout, 0, sarea);
    // bbox/centroid from the subject mask directly
    let x0:i64 = W;
    let y0:i64 = H;
    let x1:i64 = -1;
    let y1:i64 = -1;
    let sx:i64 = 0;
    let sy:i64 = 0;
    p = 0;
    while (p < N) {
        if (subj_mask[p] != 0) {
            let x:i64 = p % W;
            let y:i64 = p / W;
            sx = sx + x;
            sy = sy + y;
            if (x < x0) { x0 = x; }
            if (x > x1) { x1 = x; }
            if (y < y0) { y0 = y; }
            if (y > y1) { y1 = y; }
        }
        p = p + 1;
    }
    if (sarea > 0) {
        scx = sx / sarea;
        scy = sy / sarea;
    }
    h_put64(segout, 8, x0);
    h_put64(segout, 16, y0);
    h_put64(segout, 24, x1);
    h_put64(segout, 32, y1);
    h_put64(segout, 40, scx);
    h_put64(segout, 48, scy);
    h_put64(segout, 56, cent);
    h_put64(segout, 64, thr);
    h_put64(segout, 72, winner);
    h_put64(segout, 80, sme);
    h_put64(segout, 88, sgray);
    h_put64(segout, 96, nparts);
    h_put64(segout, 104, subj_lab);
    to = tr_str(tr, to, " subject = part ");
    to = tr_i64(tr, to, subj_lab);
    to = tr_str(tr, to, " piece #");
    to = tr_i64(tr, to, subj_id);
    to = tr_str(tr, to, " (highest mean motion ");
    to = tr_i64(tr, to, sme);
    to = tr_str(tr, to, ")");
    if (fellback == 1) {
        to = tr_str(tr, to, " [FALLBACK: no piece cleared the substance bar; took the largest]");
    }
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "  area=");
    to = tr_i64(tr, to, sarea);
    to = tr_str(tr, to, " bbox=(");
    to = tr_i64(tr, to, x0);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, y0);
    to = tr_str(tr, to, ")-(");
    to = tr_i64(tr, to, x1);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, y1);
    to = tr_str(tr, to, ") centroid=(");
    to = tr_i64(tr, to, scx);
    to = tr_str(tr, to, ",");
    to = tr_i64(tr, to, scy);
    to = tr_str(tr, to, ") centrality=");
    to = tr_i64(tr, to, cent);
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "  tracking: subject mean gray ");
    to = tr_i64(tr, to, sgray);
    if (dark == 1) {
        to = tr_str(tr, to, " < frame median ");
        to = tr_i64(tr, to, gmed);
        to = tr_str(tr, to, " -> dark tracking, thr=mean+std=");
        to = tr_i64(tr, to, thr);
    } else {
        to = tr_str(tr, to, " >= frame median ");
        to = tr_i64(tr, to, gmed);
        to = tr_str(tr, to, " -> bright tracking, thr=-(mean-std)=");
        to = tr_i64(tr, to, thr);
    }
    to = tr_nl(tr, to);
    h_put64(toc, 0, to);
    return 0;
}

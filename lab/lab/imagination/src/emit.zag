// emit.zag — TNN native media emitter (frozen prereg NATIVE_EMIT_PREREG.md).
// Pure Zag. Writes PNG / WAV / PNG-frame-sequence files DIRECTLY via nio_*.
// Scene data comes from scenes_inc.zag (byte-verbatim extraction of the
// ig_gen + ig_q1_pre closure from imagine.zag). No RNG anywhere.
//
// Build: znc emit.zag -o emit
// Usage: emit <cmd> <m|h> <outdir>
//   cmd: q4png | q1png | q2wav | q1wav | q1v | q1vapng | q1vaud | dump | all
@import("../../toolchain/R33_NATIVE_IO_V1.zag")
@import("./scenes_inc.zag")

// ---------------- byte helpers ----------------
fn e_put16le(b:[]u8, o:i64, v:i64) void {    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
}
fn e_put32le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
}
fn e_put32be(b:[]u8, o:i64, v:i64) void {
    b[o] = ((v >> 24) & 255) as u8;
    b[o + 1] = ((v >> 16) & 255) as u8;
    b[o + 2] = ((v >> 8) & 255) as u8;
    b[o + 3] = (v & 255) as u8;
}
fn e_put16be(b:[]u8, o:i64, v:i64) void {
    b[o] = ((v >> 8) & 255) as u8;
    b[o + 1] = (v & 255) as u8;
}
fn e_get32le(b:[]u8, o:i64) i64 {
    return (b[o] as i64) + (b[o + 1] as i64) * 256 + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
}
fn e_put64(b:[]u8, o:i64, v:i64) void {
    e_put32le(b, o, v & 4294967295);
    e_put32le(b, o + 4, (v >> 32) & 4294967295);
}
fn e_get64(b:[]u8, o:i64) i64 {
    return e_get32le(b, o) + e_get32le(b, o + 4) * 4294967296;
}

// ---------------- CRC-32 (IEEE) ----------------
fn e_crc_init(t:[]u8) void {
    let i:i64 = 0;
    while (i < 256) {
        let c:i64 = i;
        let k:i64 = 0;
        while (k < 8) {
            if ((c & 1) == 1) { c = (c >> 1) ^ 3988292384; } else { c = c >> 1; }
            k = k + 1;
        }
        e_put32le(t, i * 4, c);
        i = i + 1;
    }
}
fn e_crc_bytes(t:[]u8, crc:i64, b:[]u8, o:i64, n:i64) i64 {
    let i:i64 = 0;
    while (i < n) {
        let idx:i64 = (crc ^ (b[o + i] as i64)) & 255;
        crc = e_get32le(t, idx * 4) ^ (crc >> 8);
        i = i + 1;
    }
    return crc;
}
fn e_crc_final(crc:i64) i64 { return crc ^ 4294967295; }

// ---------------- f64 helpers ----------------
fn e_absf(x:f64) f64 {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}
fn e_floor(x:f64) i64 {
    let t:i64 = x as i64;
    if (x >= 0.0) { return t; }
    if ((t as f64) == x) { return t; }
    return t - 1;
}
fn e_ceil(x:f64) i64 {
    let t:i64 = x as i64;
    if (x <= 0.0) { return t; }
    if ((t as f64) == x) { return t; }
    return t + 1;
}
// round-half-to-even (matches Python round())
fn e_rint_even(x:f64) i64 {
    let t:i64 = x as i64;
    let d:f64 = x - (t as f64);
    if (x >= 0.0) {
        if (d < 0.5) { return t; }
        if (d > 0.5) { return t + 1; }
        if (t % 2 == 0) { return t; }
        return t + 1;
    }
    if (d > -0.5) { return t; }
    if (d < -0.5) { return t - 1; }
    if (t % 2 == 0) { return t; }
    return t - 1;
}
// round-half-away-from-zero (matches C roundf)
fn e_rint_away(x:f64) i64 {
    if (x >= 0.0) { return (x + 0.5) as i64; }
    return 0 - ((e_absf(x) + 0.5) as i64);
}
// Pillow ROUND_UP / ROUND_DOWN macros
fn e_round_up(f:f64) i64 {
    if (f >= 0.0) { return e_floor(f + 0.5); }
    return 0 - e_floor(e_absf(f) + 0.5);
}
fn e_round_down(f:f64) i64 {
    if (f >= 0.0) { return e_ceil(f - 0.5); }
    return 0 - e_ceil(e_absf(f) - 0.5);
}
// f64 square root (Newton, deterministic)
fn e_sqrt(x:f64) f64 {
    if (x <= 0.0) { return 0.0; }
    let r:f64 = x;
    if (r < 1.0) { r = 1.0; }
    let i:i64 = 0;
    while (i < 60) {
        r = 0.5 * (r + x / r);
        i = i + 1;
    }
    return r;
}
// f64 sine: range reduction + Taylor to x^19 (Horner)
fn e_sin(x:f64) f64 {
    let twopi:f64 = 6.283185307179586;
    let pi:f64 = 3.141592653589793;
    let halfpi:f64 = 1.5707963267948966;
    let qi:i64 = e_rint_away(x / twopi);
    let r:f64 = x - (qi as f64) * twopi;
    if (r > halfpi) { r = pi - r; }
    if (r < 0.0 - halfpi) { r = (0.0 - pi) - r; }
    let x2:f64 = r * r;
    let p:f64 = -0.000000000000000008220635246624329;
    p = 0.00000000000000281145725434552076 + x2 * p;
    p = -0.0000000000007647163731819816697 + x2 * p;
    p = 0.00000000019841269841269841269841 + x2 * p;
    p = -0.000000025052108385441718775877 + x2 * p;
    p = 0.00000275573192239858906525573192 + x2 * p;
    p = -0.00019841269841269841269841269841 + x2 * p;
    p = 0.00833333333333333333333333333333 + x2 * p;
    p = -0.16666666666666666666666666666667 + x2 * p;
    p = 1.0 + x2 * p;
    return r * p;
}

// ---------------- canvas primitives ----------------
fn e_fill_white(cv:[]u8, w:i64, h:i64) void {
    let n:i64 = w * h * 3;
    let i:i64 = 0;
    while (i < n) { cv[i] = 255; i = i + 1; }
}
fn e_px(cv:[]u8, w:i64, h:i64, x:i64, y:i64, r:i64, g:i64, b:i64) void {
    if (x < 0 || y < 0 || x >= w || y >= h) { return; }
    let o:i64 = (y * w + x) * 3;
    cv[o] = r as u8;
    cv[o + 1] = g as u8;
    cv[o + 2] = b as u8;
}
// Pillow hline32: inclusive x0..x1, clipped
fn e_hline(cv:[]u8, w:i64, h:i64, x0:i64, x1:i64, y:i64, r:i64, g:i64, b:i64) void {
    if (y < 0 || y >= h) { return; }
    let a:i64 = x0;
    let e:i64 = x1;
    if (a < 0) { a = 0; } else { if (a >= w) { return; } }
    if (e < 0) { return; } else { if (e >= w) { e = w - 1; } }
    if (a > e) { return; }
    let o:i64 = (y * w + a) * 3;
    let x:i64 = a;
    while (x <= e) {
        cv[o] = r as u8;
        cv[o + 1] = g as u8;
        cv[o + 2] = b as u8;
        o = o + 3;
        x = x + 1;
    }
}
// Pillow line32 vertical case: draws ys..ye inclusive
fn e_vline(cv:[]u8, w:i64, h:i64, x:i64, ys:i64, ye:i64, r:i64, g:i64, b:i64) void {
    if (x < 0 || x >= w) { return; }
    let a:i64 = ys;
    let e:i64 = ye;
    if (a < 0) { a = 0; }
    if (e >= h) { e = h - 1; }
    if (a > e) { return; }
    let y:i64 = a;
    while (y <= e) {
        let o:i64 = (y * w + x) * 3;
        cv[o] = r as u8;
        cv[o + 1] = g as u8;
        cv[o + 2] = b as u8;
        y = y + 1;
    }
}
fn e_rect_fill(cv:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, r:i64, g:i64, b:i64) void {
    let a:i64 = y0;
    let e:i64 = y1;
    if (a > e) { let t:i64 = a; a = e; e = t; }
    let y:i64 = a;
    while (y <= e) {
        e_hline(cv, w, h, x0, x1, y, r, g, b);
        y = y + 1;
    }
}
// Pillow ImagingDrawRectangle outline, width=2: 2px INNER border
fn e_rect_outline2(cv:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, r:i64, g:i64, b:i64) void {
    e_hline(cv, w, h, x0, x1, y0, r, g, b);
    e_hline(cv, w, h, x0, x1, y1, r, g, b);
    e_hline(cv, w, h, x0, x1, y0 + 1, r, g, b);
    e_hline(cv, w, h, x0, x1, y1 - 1, r, g, b);
    e_vline(cv, w, h, x1, y0 + 2, y1 - 2, r, g, b);
    e_vline(cv, w, h, x1 - 1, y0 + 2, y1 - 2, r, g, b);
    e_vline(cv, w, h, x0, y0 + 2, y1 - 2, r, g, b);
    e_vline(cv, w, h, x0 + 1, y0 + 2, y1 - 2, r, g, b);
}

// ---------------- Pillow ellipse port ----------------
// quarter_state slots (8 bytes each): 0:a 1:b 2:cx 3:cy 4:ex 5:ey 6:a2 7:b2 8:a2b2 9:finished
fn q_init(st:[]u8, a:i64, b:i64) void {
    if (a < 0 || b < 0) {
        e_put64(st, 9 * 8, 1);
        return;
    }
    e_put64(st, 0 * 8, a);
    e_put64(st, 1 * 8, b);
    e_put64(st, 2 * 8, a);
    e_put64(st, 3 * 8, b % 2);
    e_put64(st, 4 * 8, a % 2);
    e_put64(st, 5 * 8, b);
    e_put64(st, 6 * 8, a * a);
    e_put64(st, 7 * 8, b * b);
    e_put64(st, 8 * 8, a * a * b * b);
    e_put64(st, 9 * 8, 0);
}
fn q_delta(st:[]u8, x:i64, y:i64) i64 {
    let a2:i64 = e_get64(st, 6 * 8);
    let b2:i64 = e_get64(st, 7 * 8);
    let a2b2:i64 = e_get64(st, 8 * 8);
    let d:i64 = a2 * y * y + b2 * x * x - a2b2;
    if (d < 0) { return 0 - d; }
    return d;
}
// returns 0 with point in out[0],out[1]; -1 when finished
fn q_next(st:[]u8, out:[]u8) i64 {
    if (e_get64(st, 9 * 8) == 1) { return -1; }
    let cx:i64 = e_get64(st, 2 * 8);
    let cy:i64 = e_get64(st, 3 * 8);
    e_put64(out, 0, cx);
    e_put64(out, 8, cy);
    let ex:i64 = e_get64(st, 4 * 8);
    let ey:i64 = e_get64(st, 5 * 8);
    if (cx == ex && cy == ey) {
        e_put64(st, 9 * 8, 1);
    } else {
        let nx:i64 = cx;
        let ny:i64 = cy + 2;
        let ndelta:i64 = q_delta(st, nx, ny);
        if (nx > 1) {
            let nd2:i64 = q_delta(st, cx - 2, cy + 2);
            if (ndelta > nd2) { nx = cx - 2; ny = cy + 2; ndelta = nd2; }
            let nd3:i64 = q_delta(st, cx - 2, cy);
            if (ndelta > nd3) { nx = cx - 2; ny = cy; }
        }
        e_put64(st, 2 * 8, nx);
        e_put64(st, 3 * 8, ny);
    }
    return 0;
}
// ellipse_state: 0..9 outer qstate, 10..19 inner qstate,
// 20:py 21:pl 22:pr 23:bufcnt 24:finished 25:leftmost,
// 26..29:cl 30..33:cyb 34..37:cr
fn e_ellipse_init(es:[]u8, a:i64, b:i64, w:i64) void {
    let i:i64 = 0;
    while (i < 38) { e_put64(es, i * 8, 0); i = i + 1; }
    let outer:[]u8 = es[0..80];
    let inner:[]u8 = es[80..160];
    let pt:[]u8 = es[304..320];
    e_put64(es, 25 * 8, a % 2);
    q_init(outer, a, b);
    if (w < 1 || q_next(outer, pt) == -1) {
        e_put64(es, 24 * 8, 1);
        return;
    }
    e_put64(es, 22 * 8, e_get64(pt, 0));
    e_put64(es, 20 * 8, e_get64(pt, 8));
    q_init(inner, a - 2 * (w - 1), b - 2 * (w - 1));
    e_put64(es, 21 * 8, e_get64(es, 25 * 8));
}
// returns 0 with (x0,y,x1) in out; -1 when done
fn e_ellipse_next(es:[]u8, out:[]u8) i64 {
    let outer:[]u8 = es[0..80];
    let inner:[]u8 = es[80..160];
    let pt:[]u8 = es[304..320];
    let bufcnt:i64 = e_get64(es, 23 * 8);
    if (bufcnt == 0) {
        if (e_get64(es, 24 * 8) == 1) { return -1; }
        let y:i64 = e_get64(es, 20 * 8);
        let l:i64 = e_get64(es, 21 * 8);
        let r:i64 = e_get64(es, 22 * 8);
        let cx:i64 = 0;
        let cy:i64 = 0;
        let next_ret:i64 = 0;
        while (1 == 1) {
            next_ret = q_next(outer, pt);
            cx = e_get64(pt, 0);
            cy = e_get64(pt, 8);
            if (next_ret == -1 || cy > y) { break; }
        }
        if (next_ret == -1) {
            e_put64(es, 24 * 8, 1);
        } else {
            e_put64(es, 22 * 8, cx);
            e_put64(es, 20 * 8, cy);
        }
        while (1 == 1) {
            next_ret = q_next(inner, pt);
            cx = e_get64(pt, 0);
            cy = e_get64(pt, 8);
            if (next_ret == -1 || cy > y) { break; }
            l = cx;
        }
        if (next_ret == -1) {
            e_put64(es, 21 * 8, e_get64(es, 25 * 8));
        } else {
            e_put64(es, 21 * 8, cx);
        }
        bufcnt = 0;
        let cl0:i64 = l;
        if (cl0 == 0) { cl0 = 2; }
        if ((l > 0 || l < r) && y > 0) {
            e_put64(es, (26 + bufcnt) * 8, cl0);
            e_put64(es, (30 + bufcnt) * 8, y);
            e_put64(es, (34 + bufcnt) * 8, r);
            bufcnt = bufcnt + 1;
        }
        if (y > 0) {
            e_put64(es, (26 + bufcnt) * 8, 0 - r);
            e_put64(es, (30 + bufcnt) * 8, y);
            e_put64(es, (34 + bufcnt) * 8, 0 - l);
            bufcnt = bufcnt + 1;
        }
        if (l > 0 || l < r) {
            e_put64(es, (26 + bufcnt) * 8, cl0);
            e_put64(es, (30 + bufcnt) * 8, 0 - y);
            e_put64(es, (34 + bufcnt) * 8, r);
            bufcnt = bufcnt + 1;
        }
        e_put64(es, (26 + bufcnt) * 8, 0 - r);
        e_put64(es, (30 + bufcnt) * 8, 0 - y);
        e_put64(es, (34 + bufcnt) * 8, 0 - l);
        bufcnt = bufcnt + 1;
        e_put64(es, 23 * 8, bufcnt);
    }
    bufcnt = e_get64(es, 23 * 8) - 1;
    e_put64(es, 23 * 8, bufcnt);
    e_put64(out, 0, e_get64(es, (26 + bufcnt) * 8));
    e_put64(out, 8, e_get64(es, (30 + bufcnt) * 8));
    e_put64(out, 16, e_get64(es, (34 + bufcnt) * 8));
    return 0;
}
// Pillow ellipseNew: fill pass uses width=a+b (fills everything)
fn e_ellipse(cv:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, r:i64, g:i64, b:i64, fill:i64, width:i64) void {
    let a:i64 = x1 - x0;
    let bb:i64 = y1 - y0;
    if (a < 0 || bb < 0) { return; }
    let ww:i64 = width;
    if (fill == 1) { ww = a + bb; }
    let es:[]u8 = nio_alloc(320);
    let out:[]u8 = nio_alloc(24);
    e_ellipse_init(es, a, bb, ww);
    while (e_ellipse_next(es, out) == 0) {
        let X0:i64 = e_get64(out, 0);
        let Y:i64 = e_get64(out, 8);
        let X1:i64 = e_get64(out, 16);
        e_hline(cv, w, h, x0 + (X0 + a) / 2, x0 + (X1 + a) / 2, y0 + (Y + bb) / 2, r, g, b);
    }
    nio_free(es);
    nio_free(out);
}

// ---------------- Pillow polygon port ----------------
// Bit-mask hline (for 1-bit style masks stored as bytes)
fn e_bhline(bits:[]u8, w:i64, h:i64, x0:i64, x1:i64, y:i64) void {
    if (y < 0 || y >= h) { return; }
    let a:i64 = x0;
    let e:i64 = x1;
    if (a < 0) { a = 0; } else { if (a >= w) { return; } }
    if (e < 0) { return; } else { if (e >= w) { e = w - 1; } }
    if (a > e) { return; }
    let x:i64 = a;
    while (x <= e) { bits[y * w + x] = 1; x = x + 1; }
}
// Edge slots (8 bytes each): 0:xmin 1:xmax 2:ymin 3:ymax 4:x0 5:y0 6:dxnum 7:dxden
fn e_add_edge(ex:[]u8, e:i64, x0:i64, y0:i64, x1:i64, y1:i64) void {
    let o:i64 = e * 64;
    if (x0 <= x1) { e_put64(ex, o, x0); e_put64(ex, o + 8, x1); } else { e_put64(ex, o, x1); e_put64(ex, o + 8, x0); }
    if (y0 <= y1) { e_put64(ex, o + 16, y0); e_put64(ex, o + 24, y1); } else { e_put64(ex, o + 16, y1); e_put64(ex, o + 24, y0); }
    e_put64(ex, o + 32, x0);
    e_put64(ex, o + 40, y0);
    if (y0 == y1) { e_put64(ex, o + 48, 0); e_put64(ex, o + 56, 1); } else { e_put64(ex, o + 48, x1 - x0); e_put64(ex, o + 56, y1 - y0); }
}
fn e_edge_dx(ex:[]u8, e:i64) f64 {
    let o:i64 = e * 64;
    return (e_get64(ex, o + 48) as f64) / (e_get64(ex, o + 56) as f64);
}
// General polygon fill (Pillow polygon_generic, non-alpha path).
// ismask=0: paint RGB on cv; ismask=1: set bits in cv (cv is W*H bytes).
fn e_poly_fill(cv:[]u8, w:i64, h:i64, ex:[]u8, n:i64, r:i64, g:i64, b:i64, ismask:i64) void {
    let ymin:i64 = h - 1;
    let ymax:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let o:i64 = i * 64;
        let eymin:i64 = e_get64(ex, o + 16);
        let eymax:i64 = e_get64(ex, o + 24);
        if (eymin < ymin) { ymin = eymin; }
        if (eymax > ymax) { ymax = eymax; }
        if (eymin == eymax) {
            if (ismask == 1) { e_bhline(cv, w, h, e_get64(ex, o), e_get64(ex, o + 8), eymin); } else { e_hline(cv, w, h, e_get64(ex, o), e_get64(ex, o + 8), eymin, r, g, b); }
        }
        i = i + 1;
    }
    if (ymin < 0) { ymin = 0; }
    if (ymax > h) { ymax = h; }
    let y:i64 = ymin;
    while (y <= ymax) {
        let c0:f64 = 0.0; let c1:f64 = 0.0; let c2:f64 = 0.0; let c3:f64 = 0.0;
        let c4:f64 = 0.0; let c5:f64 = 0.0; let c6:f64 = 0.0; let c7:f64 = 0.0;
        let j:i64 = 0;
        i = 0;
        while (i < n) {
            let o:i64 = i * 64;
            let eymin:i64 = e_get64(ex, o + 16);
            let eymax:i64 = e_get64(ex, o + 24);
            if (eymin != eymax && y >= eymin && y <= eymax) {
                let ex0:i64 = e_get64(ex, o + 32);
                let ey0:i64 = e_get64(ex, o + 40);
                let dx:f64 = e_edge_dx(ex, i);
                let xv:f64 = ((y - ey0) as f64) * dx + (ex0 as f64);
                if (j == 0) { c0 = xv; } else { if (j == 1) { c1 = xv; } else { if (j == 2) { c2 = xv; } else { if (j == 3) { c3 = xv; } else { if (j == 4) { c4 = xv; } else { if (j == 5) { c5 = xv; } else { if (j == 6) { c6 = xv; } else { c7 = xv; } } } } } } }
                j = j + 1;
                if (y == eymax && y < ymax) {
                    if (j == 0) { c0 = xv; } else { if (j == 1) { c1 = xv; } else { if (j == 2) { c2 = xv; } else { if (j == 3) { c3 = xv; } else { if (j == 4) { c4 = xv; } else { if (j == 5) { c5 = xv; } else { if (j == 6) { c6 = xv; } else { c7 = xv; } } } } } } }
                    j = j + 1;
                } else {
                    if ((y == eymin || y == eymax) && dx != 0.0) {
                        // Connect discontiguous corners (Pillow polygon_generic)
                        let k:i64 = 0;
                        while (k < i) {
                            let ko:i64 = k * 64;
                            let keymin:i64 = e_get64(ex, ko + 16);
                            let keymax:i64 = e_get64(ex, ko + 24);
                            if ((y == keymin || y == keymax) && e_edge_dx(ex, k) != 0.0) {
                                let kxv:f64 = ((y - e_get64(ex, ko + 40)) as f64) * e_edge_dx(ex, k) + (e_get64(ex, ko + 32) as f64);
                                if (e_rint_away(xv) == e_rint_away(kxv)) {
                                    let off:i64 = 1;
                                    if (y == eymax) { off = -1; }
                                    let alx:f64 = ((y + off - ey0) as f64) * dx + (ex0 as f64);
                                    if (y + off >= keymin && y + off <= keymax) {
                                        let alxo:f64 = ((y + off - e_get64(ex, ko + 40)) as f64) * e_edge_dx(ex, k) + (e_get64(ex, ko + 32) as f64);
                                        let nv:f64 = xv;
                                        if (xv > alx + 1.0 && xv > alxo + 1.0) {
                                            let mx:f64 = alx;
                                            if (alxo > mx) { mx = alxo; }
                                            nv = (e_rint_away(mx) as f64) + 1.0;
                                        } else {
                                            if (xv < alx - 1.0 && xv < alxo - 1.0) {
                                                let mn:f64 = alx;
                                                if (alxo < mn) { mn = alxo; }
                                                nv = (e_rint_away(mn) as f64) - 1.0;
                                            }
                                        }
                                        // adjust last appended value (xx[j-1])
                                        if (j == 1) { c0 = nv; } else { if (j == 2) { c1 = nv; } else { if (j == 3) { c2 = nv; } else { if (j == 4) { c3 = nv; } else { if (j == 5) { c4 = nv; } else { if (j == 6) { c5 = nv; } else { if (j == 7) { c6 = nv; } else { c7 = nv; } } } } } } }
                                        break;
                                    }
                                }
                            }
                            k = k + 1;
                        }
                    }
                }
            }
            i = i + 1;
        }
        // bubble sort c0..c{j} (stable, deterministic)
        let pass:i64 = 0;
        while (pass < 8) {
            if (j > 1 && c1 < c0) { let t:f64 = c0; c0 = c1; c1 = t; }
            if (j > 2 && c2 < c1) { let t:f64 = c1; c1 = c2; c2 = t; }
            if (j > 3 && c3 < c2) { let t:f64 = c2; c2 = c3; c3 = t; }
            if (j > 4 && c4 < c3) { let t:f64 = c3; c3 = c4; c4 = t; }
            if (j > 5 && c5 < c4) { let t:f64 = c4; c4 = c5; c5 = t; }
            if (j > 6 && c6 < c5) { let t:f64 = c5; c5 = c6; c6 = t; }
            if (j > 7 && c7 < c6) { let t:f64 = c6; c6 = c7; c7 = t; }
            pass = pass + 1;
        }
        let p2:i64 = 1;
        while (p2 < j) {
            let xa:f64 = c0; let xb:f64 = c0;
            if (p2 == 1) { xa = c0; xb = c1; } else { if (p2 == 3) { xa = c2; xb = c3; } else { if (p2 == 5) { xa = c4; xb = c5; } else { xa = c6; xb = c7; } } }
            let xs:i64 = e_round_up(xa);
            let xe:i64 = e_round_down(xb);
            if (ismask == 1) { e_bhline(cv, w, h, xs, xe, y); } else { e_hline(cv, w, h, xs, xe, y, r, g, b); }
            p2 = p2 + 2;
        }
        y = y + 1;
    }
}
// Triangle fill on RGB (Pillow draw_polygon fill path, incl. closing edge)
fn e_tri_fill(cv:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, x2:i64, y2:i64, r:i64, g:i64, b:i64) void {
    let ex:[]u8 = nio_alloc(192);
    e_add_edge(ex, 0, x0, y0, x1, y1);
    e_add_edge(ex, 1, x1, y1, x2, y2);
    e_add_edge(ex, 2, x2, y2, x0, y0);
    e_poly_fill(cv, w, h, ex, 3, r, g, b, 0);
    nio_free(ex);
}
// Pillow ImagingDrawWideLine onto a bit mask (width param, here always 3)
fn e_wide_bits(bits:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, wd:i64) void {
    let dx:i64 = x1 - x0;
    let dy:i64 = y1 - y0;
    if (dx == 0 && dy == 0) {
        if (x0 >= 0 && y0 >= 0 && x0 < w && y0 < h) { bits[y0 * w + x0] = 1; }
        return;
    }
    let big:f64 = 0.0;
    if (dx == 0) { big = e_absf(dy as f64); } else { if (dy == 0) { big = e_absf(dx as f64); } else { big = e_sqrt((dx as f64) * (dx as f64) + (dy as f64) * (dy as f64)); } }
    let small:f64 = ((wd - 1) as f64) / 2.0;
    let rmax:f64 = (e_round_up(small) as f64) / big;
    let rmin:f64 = (e_round_down(small) as f64) / big;
    let dxmin:i64 = e_round_down(rmin * (dy as f64));
    let dxmax:i64 = e_round_down(rmax * (dy as f64));
    let dymin:i64 = e_round_down(rmin * (dx as f64));
    let dymax:i64 = e_round_down(rmax * (dx as f64));
    let ex:[]u8 = nio_alloc(256);
    e_add_edge(ex, 0, x0 - dxmin, y0 + dymax, x1 - dxmin, y1 + dymax);
    e_add_edge(ex, 1, x1 - dxmin, y1 + dymax, x1 + dxmax, y1 - dymin);
    e_add_edge(ex, 2, x1 + dxmax, y1 - dymin, x0 + dxmax, y0 - dymin);
    e_add_edge(ex, 3, x0 + dxmax, y0 - dymin, x0 - dxmin, y0 + dymax);
    e_poly_fill(bits, w, h, ex, 4, 0, 0, 0, 1);
    nio_free(ex);
}
// Triangle outline width=2: (width-3 outline) clipped to fill, painted dark.
// (Pillow ImageDraw.polygon wide-outline path.)
fn e_tri_outline2(cv:[]u8, w:i64, h:i64, x0:i64, y0:i64, x1:i64, y1:i64, x2:i64, y2:i64, r:i64, g:i64, b:i64) void {
    let n:i64 = w * h;
    let fillb:[]u8 = nio_alloc(n as i32);
    let outb:[]u8 = nio_alloc(n as i32);
    let ex:[]u8 = nio_alloc(192);
    e_add_edge(ex, 0, x0, y0, x1, y1);
    e_add_edge(ex, 1, x1, y1, x2, y2);
    e_add_edge(ex, 2, x2, y2, x0, y0);
    e_poly_fill(fillb, w, h, ex, 3, 0, 0, 0, 1);
    nio_free(ex);
    e_wide_bits(outb, w, h, x0, y0, x1, y1, 3);
    e_wide_bits(outb, w, h, x1, y1, x2, y2, 3);
    e_wide_bits(outb, w, h, x2, y2, x0, y0, 3);
    // bbox loop
    let xa:i64 = x0; let xb:i64 = x0;
    if (x1 < xa) { xa = x1; } if (x2 < xa) { xa = x2; }
    if (x1 > xb) { xb = x1; } if (x2 > xb) { xb = x2; }
    let ya:i64 = y0; let yb:i64 = y0;
    if (y1 < ya) { ya = y1; } if (y2 < ya) { ya = y2; }
    if (y1 > yb) { yb = y1; } if (y2 > yb) { yb = y2; }
    xa = xa - 3; xb = xb + 3; ya = ya - 3; yb = yb + 3;
    if (xa < 0) { xa = 0; } if (ya < 0) { ya = 0; }
    if (xb >= w) { xb = w - 1; } if (yb >= h) { yb = h - 1; }
    let y:i64 = ya;
    while (y <= yb) {
        let x:i64 = xa;
        while (x <= xb) {
            let o:i64 = y * w + x;
            if (fillb[o] == 1 && outb[o] == 1) { e_px(cv, w, h, x, y, r, g, b); }
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fillb);
    nio_free(outb);
}

// ---------------- imagination color/geometry helpers ----------------
fn e_bin_freq(bin:i64) f64 {
    if (bin == 15) { return 261.6255653005986; }
    if (bin == 16) { return 277.1826309768721; }
    if (bin == 17) { return 293.6647679174076; }
    if (bin == 19) { return 329.6275569128699; }
    if (bin == 20) { return 349.2282314330039; }
    if (bin == 22) { return 391.99543598174927; }
    if (bin == 24) { return 440.0; }
    if (bin == 26) { return 493.883301256124; }
    if (bin == 27) { return 523.2511306011972; }
    return 0.0;
}
fn e_timbre(ph:f64, timbre:i64) f64 {
    if (timbre == 5001) { return e_sin(ph) + 0.4 * e_sin(2.0 * ph); }
    if (timbre == 5002) {
        let twopi:f64 = 6.283185307179586;
        let u:f64 = ph / twopi - (e_floor(ph / twopi) as f64);
        if (u < 0.0) { u = u + 1.0; }
        if (u < 0.5) {
            let d:f64 = u - 0.25;
            if (d < 0.0) { d = 0.0 - d; }
            return 0.8 * (1.0 - 4.0 * d);
        }
        let d:f64 = u - 0.75;
        if (d < 0.0) { d = 0.0 - d; }
        return 0.8 * (4.0 * d - 1.0);
    }
    return e_sin(ph);
}
fn e_zone_c(z:i64) i64 {
    if (z == 0 || z == 3 || z == 6) { return 167; }
    if (z == 1 || z == 4 || z == 7) { return 500; }
    return 833;
}
fn e_zone_r(z:i64) i64 {
    if (z < 3) { return 167; }
    if (z < 6) { return 500; }
    return 833;
}
fn e_human_light(handle:i64, comp:i64) i64 {
    let rem:i64 = handle - 1000;
    let hue:i64 = (rem / 6) % 6;
    let li:i64 = (rem / 2) % 3;
    let v:i64 = 0;
    if (hue == 0) { if (comp == 0) { v = 200; } else { if (comp == 1) { v = 40; } else { v = 40; } } }
    if (hue == 1) { if (comp == 0) { v = 220; } else { if (comp == 1) { v = 130; } else { v = 30; } } }
    if (hue == 2) { if (comp == 0) { v = 240; } else { if (comp == 1) { v = 200; } else { v = 40; } } }
    if (hue == 3) { if (comp == 0) { v = 60; } else { if (comp == 1) { v = 130; } else { v = 200; } } }
    if (hue == 4) { if (comp == 0) { v = 130; } else { if (comp == 1) { v = 60; } else { v = 180; } } }
    if (hue == 5) { if (comp == 0) { v = 240; } else { if (comp == 1) { v = 200; } else { v = 90; } } }
    let f:f64 = v as f64;
    if (li == 0) { f = f * 0.55; }
    if (li == 2) { f = f * 1.15; }
    return e_rint_even(f);
}
fn e_human_rgb(handle:i64, comp:i64) i64 {
    if (handle >= 2000) { return 30 + (handle - 2000) * 65; }
    let rem:i64 = handle - 1000;
    let sa:i64 = rem % 2;
    let r:i64 = e_human_light(handle, 0);
    let g:i64 = e_human_light(handle, 1);
    let b:i64 = e_human_light(handle, 2);
    if (sa == 0) {
        let gray:f64 = ((r + g + b) as f64) / 3.0;
        if (comp == 0) { return e_rint_even((r as f64) + 0.5 * (gray - (r as f64))); }
        if (comp == 1) { return e_rint_even((g as f64) + 0.5 * (gray - (g as f64))); }
        return e_rint_even((b as f64) + 0.5 * (gray - (b as f64)));
    }
    if (comp == 0) { return r; }
    if (comp == 1) { return g; }
    return b;
}
// Human structural block rect (2x domain); out = 4 slots x0,y0,x1,y1
fn e_block_rect(ar:[]u8, idx:i64, out:[]u8) void {
    let zone:i64 = ig_ew(ar, idx, 2);
    let rel:i64 = ig_ew(ar, idx, 3);
    let relt:i64 = ig_ew(ar, idx, 4);
    let rank:i64 = ig_ew(ar, idx, 5);
    let bw:i64 = rank * 45;
    let bh:i64 = rank * 27;
    if (rel == 5 && relt >= 0) {
        let t:[]u8 = nio_alloc(32);
        e_block_rect(ar, relt, t);
        let tcy:i64 = (e_get64(t, 0) + e_get64(t, 16)) / 2;
        let ty0:i64 = e_get64(t, 8);
        nio_free(t);
        e_put64(out, 0, tcy - bw);
        e_put64(out, 8, ty0 - 2 * bh);
        e_put64(out, 16, tcy + bw);
        e_put64(out, 24, ty0);
    } else {
        let cx:i64 = e_zone_c(zone);
        e_put64(out, 0, 2 * cx - bw);
        e_put64(out, 8, 2000 - 2 * bh);
        e_put64(out, 16, 2 * cx + bw);
        e_put64(out, 24, 2000);
    }
}
fn e_render_visual(ar:[]u8, mode:i64, cv:[]u8, w:i64, h:i64) void {
    let n:i64 = ig_n(ar);
    let i:i64 = 0;
    while (i < n) {
        let kind:i64 = ig_ew(ar, i, 1);
        let r:i64 = 0; let g:i64 = 0; let b:i64 = 0;
        let x0:i64 = 0; let y0:i64 = 0; let x1:i64 = 0; let y1:i64 = 0;
        if (mode == 1) {
            let zone:i64 = ig_ew(ar, i, 2);
            let cx:i64 = e_zone_c(zone);
            let cy:i64 = e_zone_r(zone);
            let col:i64 = ig_ew(ar, i, 3);
            r = e_human_rgb(col, 0); g = e_human_rgb(col, 1); b = e_human_rgb(col, 2);
            if (kind == 1 || kind == 2) { x0 = cx - 60; y0 = cy - 60; x1 = cx + 60; y1 = cy + 60; }
            if (kind == 4) { x0 = cx - 100; y0 = cy - 30; x1 = cx + 100; y1 = cy + 30; }
        } else {
            let cx:i64 = ig_ew(ar, i, 2);
            let cy:i64 = ig_ew(ar, i, 3);
            let ew:i64 = ig_ew(ar, i, 4);
            let eh:i64 = ig_ew(ar, i, 5);
            r = ig_ew(ar, i, 6); g = ig_ew(ar, i, 7); b = ig_ew(ar, i, 8);
            x0 = ((cx as f64) - (ew as f64) / 2.0) as i64;
            y0 = ((cy as f64) - (eh as f64) / 2.0) as i64;
            x1 = ((cx as f64) + (ew as f64) / 2.0) as i64;
            y1 = ((cy as f64) + (eh as f64) / 2.0) as i64;
        }
        let ink:i64 = 1;
        if (r == 30 && g == 30 && b == 30) { ink = 0; }
        if (kind == 1) {
            e_ellipse(cv, w, h, x0, y0, x1, y1, r, g, b, 1, 0);
            if (ink == 1) { e_ellipse(cv, w, h, x0, y0, x1, y1, 30, 30, 30, 0, 2); }
        }
        if (kind == 2 || kind == 4) {
            e_rect_fill(cv, w, h, x0, y0, x1, y1, r, g, b);
            if (ink == 1) { e_rect_outline2(cv, w, h, x0, y0, x1, y1, 30, 30, 30); }
        }
        if (kind == 3) {
            let tx0:i64 = 0; let ty0:i64 = 0; let tx1:i64 = 0; let ty1:i64 = 0; let tx2:i64 = 0; let ty2:i64 = 0;
            if (mode == 1) {
                let zone:i64 = ig_ew(ar, i, 2);
                let cx:i64 = e_zone_c(zone); let cy:i64 = e_zone_r(zone);
                tx0 = cx - 60; ty0 = cy + 60; tx1 = cx - 60; ty1 = cy - 60; tx2 = cx + 60; ty2 = cy;
            } else {
                let cx:i64 = ig_ew(ar, i, 2); let cy:i64 = ig_ew(ar, i, 3);
                let ew:i64 = ig_ew(ar, i, 4); let eh:i64 = ig_ew(ar, i, 5);
                tx0 = ((cx as f64) - (ew as f64) / 2.0) as i64;
                ty0 = ((cy as f64) + (eh as f64) / 2.0) as i64;
                tx1 = ((cx as f64) - (ew as f64) / 2.0) as i64;
                ty1 = ((cy as f64) - (eh as f64) / 2.0) as i64;
                tx2 = ((cx as f64) + (ew as f64) / 2.0) as i64;
                ty2 = cy;
            }
            e_tri_fill(cv, w, h, tx0, ty0, tx1, ty1, tx2, ty2, r, g, b);
            if (ink == 1) { e_tri_outline2(cv, w, h, tx0, ty0, tx1, ty1, tx2, ty2, 30, 30, 30); }
        }
        i = i + 1;
    }
}
fn e_render_audio(ar:[]u8, mode:i64, cv:[]u8, w:i64, h:i64, durtab:[]u8) void {
    e_hline(cv, w, h, 0, w - 1, 100, 150, 150, 150);
    let n:i64 = ig_n(ar);
    let segw:i64 = w / n;
    let i:i64 = 0;
    while (i < n) {
        let freq:f64 = 0.0;
        let dur:i64 = 0;
        let amp:f64 = 0.0;
        let timbre:i64 = 5000;
        if (mode == 0) {
            freq = (ig_ew(ar, i, 2) as f64) * 1000.0;
            dur = ig_ew(ar, i, 3);
            amp = (ig_ew(ar, i, 4) as f64) / 1000.0;
            timbre = ig_ew(ar, i, 6);
        } else {
            freq = e_bin_freq(ig_ew(ar, i, 2));
            timbre = ig_ew(ar, i, 3);
            dur = e_get64(durtab, i * 8);
            amp = 0.8;
        }
        let x0:i64 = i * segw;
        let x1:i64 = (i + 1) * segw;
        e_vline(cv, w, h, x0, 0, h - 1, 200, 200, 200);
        let x:i64 = x0;
        while (x < x1) {
            let t:f64 = (((x - x0) as f64) / (segw as f64) * (dur as f64)) / 1000.0;
            let ph:f64 = 6.283185307179586 * freq * t;
            let val:f64 = e_timbre(ph, timbre);
            let yy:i64 = (100.0 - val * 88.0) as i64;
            e_px(cv, w, h, x, yy, 60, 60, 220);
            x = x + 1;
        }
        i = i + 1;
    }
    e_vline(cv, w, h, w - 1, 0, h - 1, 200, 200, 200);
}
fn e_render_struct(ar:[]u8, mode:i64, cv:[]u8, w:i64, h:i64) void {
    let n:i64 = ig_n(ar);
    let i:i64 = 0;
    while (i < n) {
        let kind:i64 = ig_ew(ar, i, 1);
        if (mode == 0) {
            if (kind == 1) {
                let x:i64 = ig_ew(ar, i, 2);
                let z:i64 = ig_ew(ar, i, 4);
                let size:i64 = ig_ew(ar, i, 5);
                let bw:i64 = size;
                let bh:i64 = size * 6 / 10;
                let base:i64 = 1000 - z - bh;
                e_rect_fill(cv, w, h, x - bw / 2, base - bh, x + bw / 2, base, 210, 180, 140);
                e_rect_outline2(cv, w, h, x - bw / 2, base - bh, x + bw / 2, base, 120, 100, 70);
            } else {
                let x:i64 = ig_ew(ar, i, 2);
                let y:i64 = ig_ew(ar, i, 3);
                let size:i64 = ig_ew(ar, i, 5);
                e_ellipse(cv, w, h, x - size / 2, y - size / 2, x + size / 2, y + size / 2, 150, 150, 150, 1, 0);
                e_ellipse(cv, w, h, x - size / 2, y - size / 2, x + size / 2, y + size / 2, 80, 80, 80, 0, 2);
            }
        } else {
            if (kind == 1) {
                let t:[]u8 = nio_alloc(32);
                e_block_rect(ar, i, t);
                let x0:i64 = e_get64(t, 0) / 2;
                let y0:i64 = e_get64(t, 8) / 2;
                let x1:i64 = e_get64(t, 16) / 2;
                let y1:i64 = e_get64(t, 24) / 2;
                nio_free(t);
                e_rect_fill(cv, w, h, x0, y0, x1, y1, 210, 180, 140);
                e_rect_outline2(cv, w, h, x0, y0, x1, y1, 120, 100, 70);
            } else {
                let zone:i64 = ig_ew(ar, i, 2);
                let rank:i64 = ig_ew(ar, i, 5);
                let cx:i64 = e_zone_c(zone);
                let cy:i64 = e_zone_r(zone);
                let s:i64 = rank * 50;
                e_ellipse(cv, w, h, cx - s / 2, cy - s / 2, cx + s / 2, cy + s / 2, 150, 150, 150, 1, 0);
                e_ellipse(cv, w, h, cx - s / 2, cy - s / 2, cx + s / 2, cy + s / 2, 80, 80, 80, 0, 2);
            }
        }
        i = i + 1;
    }
}

// ---------------- PNG writer (RGB8, filter 0, stored DEFLATE) ----------------
fn e_adler(b:[]u8, o:i64, n:i64) i64 {
    let s1:i64 = 1;
    let s2:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        s1 = (s1 + (b[o + i] as i64)) % 65521;
        s2 = (s2 + s1) % 65521;
        i = i + 1;
    }
    return s1 + s2 * 65536;
}
fn e_write_png(root:i64, name:[]u8, cv:[]u8, w:i64, h:i64, crc:[]u8) i64 {
    let rowbytes:i64 = w * 3 + 1;
    let idat_len:i64 = rowbytes * h;
    let nblocks:i64 = (idat_len + 65534) / 65535;
    let idat_pay:i64 = 2 + nblocks * 5 + idat_len + 4;
    let total:i64 = 8 + 25 + 12 + idat_pay + 12;
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) { return -1; }
    buf[0] = 137; buf[1] = 80; buf[2] = 78; buf[3] = 71;
    buf[4] = 13; buf[5] = 10; buf[6] = 26; buf[7] = 10;
    let o:i64 = 8;
    // IHDR
    e_put32be(buf, o, 13); o = o + 4;
    buf[o] = 73; buf[o + 1] = 72; buf[o + 2] = 68; buf[o + 3] = 82; o = o + 4;
    e_put32be(buf, o, w); e_put32be(buf, o + 4, h);
    buf[o + 8] = 8; buf[o + 9] = 2; buf[o + 10] = 0; buf[o + 11] = 0; buf[o + 12] = 0;
    let c:i64 = e_crc_final(e_crc_bytes(crc, 4294967295, buf, o - 4, 17));
    e_put32be(buf, o + 13, c);
    o = o + 17;
    // IDAT
    e_put32be(buf, o, idat_pay); o = o + 4;
    buf[o] = 73; buf[o + 1] = 68; buf[o + 2] = 65; buf[o + 3] = 84; o = o + 4;
    let crc_start:i64 = o - 4;
    buf[o] = 120; buf[o + 1] = 1; o = o + 2;
    let s1:i64 = 1;
    let s2:i64 = 0;
    let y:i64 = 0;
    let rx:i64 = 0;
    let src_row:i64 = 0;
    let left:i64 = idat_len;
    while (left > 0) {
        let chunk:i64 = left;
        if (chunk > 65535) { chunk = 65535; }
        if (left == chunk) { buf[o] = 1; } else { buf[o] = 0; }
        o = o + 1;
        e_put16le(buf, o, chunk); o = o + 2;
        e_put16le(buf, o, 65535 - chunk); o = o + 2;
        let bc:i64 = 0;
        while (bc < chunk) {
            let v:i64 = 0;
            if (rx == 0) { v = 0; } else { v = cv[src_row + rx - 1] as i64; }
            buf[o] = v as u8; o = o + 1;
            s1 = (s1 + v) % 65521;
            s2 = (s2 + s1) % 65521;
            rx = rx + 1;
            if (rx == rowbytes) { rx = 0; src_row = src_row + w * 3; y = y + 1; }
            bc = bc + 1;
        }
        left = left - chunk;
    }
    e_put32be(buf, o, s1 + s2 * 65536); o = o + 4;
    let c2:i64 = e_crc_final(e_crc_bytes(crc, 4294967295, buf, crc_start, idat_pay + 4));
    e_put32be(buf, o, c2); o = o + 4;
    // IEND
    e_put32be(buf, o, 0); o = o + 4;
    buf[o] = 73; buf[o + 1] = 69; buf[o + 2] = 78; buf[o + 3] = 68; o = o + 4;
    let c3:i64 = e_crc_final(e_crc_bytes(crc, 4294967295, buf, o - 4, 4));
    e_put32be(buf, o, c3); o = o + 4;
    // stream out in <=1MB pieces
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { nio_free(buf); return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = buf[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); nio_free(buf); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    nio_free(buf);
    return 0;
}
// zlib stream of one RGB canvas (filter-0 scanlines, stored DEFLATE) at buf[o..]; returns new o
fn e_zlib_image(buf:[]u8, o:i64, cv:[]u8, w:i64, h:i64) i64 {
    let rowbytes:i64 = w * 3 + 1;
    let idat_len:i64 = rowbytes * h;
    buf[o] = 120; buf[o + 1] = 1; o = o + 2;
    let s1:i64 = 1;
    let s2:i64 = 0;
    let rx:i64 = 0;
    let src_row:i64 = 0;
    let left:i64 = idat_len;
    while (left > 0) {
        let chunk:i64 = left;
        if (chunk > 65535) { chunk = 65535; }
        if (left == chunk) { buf[o] = 1; } else { buf[o] = 0; }
        o = o + 1;
        e_put16le(buf, o, chunk); o = o + 2;
        e_put16le(buf, o, 65535 - chunk); o = o + 2;
        let bc:i64 = 0;
        while (bc < chunk) {
            let v:i64 = 0;
            if (rx == 0) { v = 0; } else { v = cv[src_row + rx - 1] as i64; }
            buf[o] = v as u8; o = o + 1;
            s1 = (s1 + v) % 65521;
            s2 = (s2 + s1) % 65521;
            rx = rx + 1;
            if (rx == rowbytes) { rx = 0; src_row = src_row + w * 3; }
            bc = bc + 1;
        }
        left = left - chunk;
    }
    e_put32be(buf, o, s1 + s2 * 65536); o = o + 4;
    return o;
}
// APNG writer: signature, IHDR, acTL, then per frame fcTL + IDAT(frame0)/fdAT,
// then IEND. Frame delay 1/2 s, dispose=none, blend=source, loop forever.
// all = nframes concatenated w*h*3 RGB canvases.
fn e_write_apng(root:i64, name:[]u8, all:[]u8, nframes:i64, w:i64, h:i64, crc:[]u8) i64 {
    let rowbytes:i64 = w * 3 + 1;
    let idat_len:i64 = rowbytes * h;
    let nblocks:i64 = (idat_len + 65534) / 65535;
    let zlen:i64 = 2 + nblocks * 5 + idat_len + 4;
    let fbsz:i64 = w * h * 3;
    let total:i64 = 8 + 25 + 20 + 12;
    let fr:i64 = 0;
    while (fr < nframes) {
        total = total + 38;
        if (fr == 0) { total = total + 12 + zlen; } else { total = total + 16 + zlen; }
        fr = fr + 1;
    }
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) { return -1; }
    buf[0] = 137; buf[1] = 80; buf[2] = 78; buf[3] = 71;
    buf[4] = 13; buf[5] = 10; buf[6] = 26; buf[7] = 10;
    let o:i64 = 8;
    // IHDR
    e_put32be(buf, o, 13); o = o + 4;
    buf[o] = 73; buf[o + 1] = 72; buf[o + 2] = 68; buf[o + 3] = 82; o = o + 4;
    e_put32be(buf, o, w); e_put32be(buf, o + 4, h);
    buf[o + 8] = 8; buf[o + 9] = 2; buf[o + 10] = 0; buf[o + 11] = 0; buf[o + 12] = 0;
    let c:i64 = e_crc_final(e_crc_bytes(crc, 4294967295, buf, o - 4, 17));
    e_put32be(buf, o + 13, c);
    o = o + 17;
    // acTL: num_frames, num_plays=0 (loop forever)
    e_put32be(buf, o, 8); o = o + 4;
    buf[o] = 97; buf[o + 1] = 99; buf[o + 2] = 84; buf[o + 3] = 76; o = o + 4;
    e_put32be(buf, o, nframes); e_put32be(buf, o + 4, 0); o = o + 8;
    let ca:i64 = e_crc_final(e_crc_bytes(crc, 4294967295, buf, o - 12, 12));
    e_put32be(buf, o, ca); o = o + 4;
    // frames
    let seq:i64 = 0;
    fr = 0;
    while (fr < nframes) {
        // fcTL
        e_put32be(buf, o, 26); o = o + 4;
        buf[o] = 102; buf[o + 1] = 99; buf[o + 2] = 84; buf[o + 3] = 76; o = o + 4;
        let fctl_start:i64 = o - 4;
        e_put32be(buf, o, seq); seq = seq + 1; o = o + 4;
        e_put32be(buf, o, w); e_put32be(buf, o + 4, h);
        e_put32be(buf, o + 8, 0); e_put32be(buf, o + 12, 0);
        e_put16be(buf, o + 16, 1); e_put16be(buf, o + 18, 2);
        buf[o + 20] = 0; buf[o + 21] = 0;
        let cf:i64 = e_crc_final(e_crc_bytes(crc, 4294967295, buf, fctl_start, 30));
        e_put32be(buf, o + 22, cf); o = o + 26;
        // frame pixels: IDAT for frame 0, fdAT after
        let base:i64 = fr * fbsz;
        let cv:[]u8 = all[base..base + fbsz];
        if (fr == 0) {
            e_put32be(buf, o, zlen); o = o + 4;
            buf[o] = 73; buf[o + 1] = 68; buf[o + 2] = 65; buf[o + 3] = 84; o = o + 4;
            let cs:i64 = o - 4;
            o = e_zlib_image(buf, o, cv, w, h);
            let cd:i64 = e_crc_final(e_crc_bytes(crc, 4294967295, buf, cs, zlen + 4));
            e_put32be(buf, o, cd); o = o + 4;
        } else {
            e_put32be(buf, o, zlen + 4); o = o + 4;
            buf[o] = 102; buf[o + 1] = 100; buf[o + 2] = 65; buf[o + 3] = 84; o = o + 4;
            let cs2:i64 = o - 4;
            e_put32be(buf, o, seq); seq = seq + 1; o = o + 4;
            o = e_zlib_image(buf, o, cv, w, h);
            let cd2:i64 = e_crc_final(e_crc_bytes(crc, 4294967295, buf, cs2, zlen + 8));
            e_put32be(buf, o, cd2); o = o + 4;
        }
        fr = fr + 1;
    }
    // IEND
    e_put32be(buf, o, 0); o = o + 4;
    buf[o] = 73; buf[o + 1] = 69; buf[o + 2] = 78; buf[o + 3] = 68; o = o + 4;
    let c3:i64 = e_crc_final(e_crc_bytes(crc, 4294967295, buf, o - 4, 4));
    e_put32be(buf, o, c3); o = o + 4;
    // stream out in <=1MB pieces
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { nio_free(buf); return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = buf[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); nio_free(buf); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    nio_free(buf);
    return 0;
}

// ---------------- WAV writer (RIFF/WAVE PCM16 mono 8kHz) ----------------
fn e_synth_note(sbuf:[]u8, o:i64, freq:f64, durms:i64, amp:f64, timbre:i64) i64 {
    let n:i64 = durms * 8;
    let twopi:f64 = 6.283185307179586;
    let i:i64 = 0;
    while (i < n) {
        let t:f64 = (i as f64) / 8000.0;
        let v:f64 = 32767.0 * amp * e_timbre(twopi * freq * t, timbre);
        let s:i64 = e_rint_even(v);
        if (s > 32767) { s = 32767; }
        if (s < -32768) { s = -32768; }
        let u:i64 = s;
        if (u < 0) { u = u + 65536; }
        e_put16le(sbuf, o + i * 2, u);
        i = i + 1;
    }
    return o + n * 2;
}
fn e_write_wav(root:i64, name:[]u8, sbuf:[]u8, nsamp:i64) i64 {
    let dlen:i64 = nsamp * 2;
    let total:i64 = 44 + dlen;
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) { return -1; }
    buf[0] = 82; buf[1] = 73; buf[2] = 70; buf[3] = 70;
    e_put32le(buf, 4, total - 8);
    buf[8] = 87; buf[9] = 65; buf[10] = 86; buf[11] = 69;
    buf[12] = 102; buf[13] = 109; buf[14] = 116; buf[15] = 32;
    e_put32le(buf, 16, 16);
    e_put16le(buf, 20, 1);
    e_put16le(buf, 22, 1);
    e_put32le(buf, 24, 8000);
    e_put32le(buf, 28, 16000);
    e_put16le(buf, 32, 2);
    e_put16le(buf, 34, 16);
    buf[36] = 100; buf[37] = 97; buf[38] = 116; buf[39] = 97;
    e_put32le(buf, 40, dlen);
    let i:i64 = 0;
    while (i < dlen) { buf[44 + i] = sbuf[i]; i = i + 1; }
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { nio_free(buf); return -2; }
    let wr:i64 = nio_write_all(fd, buf);
    nio_sync(fd);
    nio_close(fd);
    nio_free(buf);
    if (wr != total) { return -3; }
    return 0;
}
// ---------------- Q1V scene build (placements + edits, from ig_q1v_sc1..4) ----------------
// Mirrors the canonical builders exactly, minus the ig_q1v_emit logging calls.
fn e_eattr(ar:[]u8, i:i64, slot:i64, v:i64) void { ig_ewput(ar, i, slot, v); }
fn e_qv_edit_mv(ar:[]u8, f:i64, nx:i64, ny:i64) void {
    ig_ewput(ar, f, 3, nx);
    ig_ewput(ar, f, 4, ny);
    let n:i64 = ig_n(ar);
    if (f > 0) {
        ig_ewput(ar, f, 8, nx - ig_ew(ar, f - 1, 3));
        ig_ewput(ar, f, 9, ny - ig_ew(ar, f - 1, 4));
    } else {
        ig_ewput(ar, f, 8, 0);
        ig_ewput(ar, f, 9, 0);
    }
    if (f + 1 < n) {
        ig_ewput(ar, f + 1, 8, ig_ew(ar, f + 1, 3) - nx);
        ig_ewput(ar, f + 1, 9, ig_ew(ar, f + 1, 4) - ny);
    }
}
fn e_q1v_build(ar:[]u8, mode:i64, scene:i64) void {
    ig_clear(ar);
    if (scene == 1) {
        if (mode == 1) {
            ig_place(ar, 4, 1, 0, 3, 1003, 6000, 6100, 3000, 3100, 3200);
            ig_place(ar, 4, 1, 1, 4, 1003, 6003, 6101, 3000, 3100, 3200);
            ig_place(ar, 4, 1, 2, 5, 1003, 6003, 6101, 3000, 3100, 3200);
        } else {
            ig_place(ar, 4, 1, 0, 100, 500, 255, 0, 0, 0, 0);
            ig_place(ar, 4, 1, 1, 500, 500, 255, 0, 0, 400, 0);
            ig_place(ar, 4, 1, 2, 900, 500, 255, 0, 0, 400, 0);
        }
        if (mode == 1) { e_eattr(ar, 2, 3, 2); } else { e_qv_edit_mv(ar, 2, 900, 200); }
    }
    if (scene == 2) {
        if (mode == 1) {
            ig_place(ar, 4, 1, 0, 6, 1012, 6000, 6100, 3003, 3100, 3200);
            ig_place(ar, 4, 1, 1, 4, 1012, 6002, 6102, 3003, 3100, 3200);
            ig_place(ar, 4, 1, 2, 4, 1012, 6003, 6101, 3003, 3100, 3200);
            ig_place(ar, 4, 1, 3, 8, 1012, 6004, 6102, 3003, 3100, 3200);
        } else {
            ig_place(ar, 4, 1, 0, 200, 800, 110, 70, 40, 0, 0);
            ig_place(ar, 4, 1, 1, 400, 450, 110, 70, 40, 200, -350);
            ig_place(ar, 4, 1, 2, 600, 450, 110, 70, 40, 200, 0);
            ig_place(ar, 4, 1, 3, 800, 800, 110, 70, 40, 200, 350);
        }
        if (mode == 1) { e_eattr(ar, 3, 3, 6); } else { e_qv_edit_mv(ar, 3, 200, 800); }
    }
    if (scene == 3) {
        if (mode == 1) {
            ig_place(ar, 4, 1, 0, 3, 1059, 6000, 6100, 3002, 3101, 3201);
            ig_place(ar, 4, 1, 1, 3, 1059, 6003, 6100, 3002, 3101, 3201);
            ig_place(ar, 4, 1, 2, 5, 1059, 6003, 6102, 3002, 3101, 3201);
        } else {
            ig_place(ar, 4, 1, 0, 100, 500, 20, 60, 160, 0, 0);
            ig_place(ar, 4, 1, 1, 300, 500, 20, 60, 160, 200, 0);
            ig_place(ar, 4, 1, 2, 800, 500, 20, 60, 160, 500, 0);
        }
        if (mode == 1) { e_eattr(ar, 1, 6, 6102); } else { e_qv_edit_mv(ar, 1, 600, 500); }
    }
    if (scene == 4) {
        if (mode == 1) {
            ig_place(ar, 4, 1, 0, 4, 2003, 6000, 6100, 3001, 3101, 3202);
            ig_place(ar, 4, 1, 1, 5, 2003, 6003, 6102, 3001, 3101, 3202);
            ig_place(ar, 4, 1, 2, 5, 2003, 6000, 6100, 3001, 3101, 3202);
            ig_place(ar, 4, 1, 3, 4, 2003, 6007, 6102, 3001, 3101, 3202);
        } else {
            ig_place(ar, 4, 1, 0, 500, 500, 200, 200, 200, 0, 0);
            ig_place(ar, 4, 1, 1, 750, 500, 200, 200, 200, 250, 0);
            ig_place(ar, 4, 1, 2, 750, 500, 200, 200, 200, 0, 0);
            ig_place(ar, 4, 1, 3, 500, 500, 200, 200, 200, -250, 0);
        }
        if (mode == 1) { e_eattr(ar, 3, 3, 5); } else { e_qv_edit_mv(ar, 3, 750, 500); }
    }
}
// Subject x-position of frame fr (for motion-derived audio)
fn e_q1v_x(ar:[]u8, mode:i64, fr:i64) i64 {
    if (mode == 1) { return e_zone_c(ig_ew(ar, fr, 3)); }
    return ig_ew(ar, fr, 3);
}
// ---------------- filename helpers ----------------
fn e_cpy(dst:[]u8, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { dst[i] = s[i]; i = i + 1; }
    return s.len;
}
// letter -> (mode, brief); out = 2 slots
fn e_q4_lu(letter:i64, out:[]u8) void {
    if (letter == 65) { e_put64(out, 0, 0); e_put64(out, 8, 3); }
    if (letter == 66) { e_put64(out, 0, 1); e_put64(out, 8, 3); }
    if (letter == 67) { e_put64(out, 0, 0); e_put64(out, 8, 4); }
    if (letter == 68) { e_put64(out, 0, 1); e_put64(out, 8, 4); }
    if (letter == 69) { e_put64(out, 0, 1); e_put64(out, 8, 1); }
    if (letter == 70) { e_put64(out, 0, 1); e_put64(out, 8, 2); }
    if (letter == 71) { e_put64(out, 0, 0); e_put64(out, 8, 5); }
    if (letter == 72) { e_put64(out, 0, 0); e_put64(out, 8, 1); }
    if (letter == 73) { e_put64(out, 0, 0); e_put64(out, 8, 2); }
    if (letter == 74) { e_put64(out, 0, 0); e_put64(out, 8, 6); }
    if (letter == 75) { e_put64(out, 0, 1); e_put64(out, 8, 5); }
    if (letter == 76) { e_put64(out, 0, 1); e_put64(out, 8, 6); }
}
fn e_fname_q4(dst:[]u8, brief:i64, mode:i64, letter:i64) i64 {
    let n:i64 = 0;
    dst[n] = 98; dst[n + 1] = 114; dst[n + 2] = 105; dst[n + 3] = 101; dst[n + 4] = 102; n = n + 5;
    let sb:[]u8 = _zag_i64_to_str(brief);
    n = n + e_cpy(dst[n..64], sb);
    dst[n] = 95; n = n + 1;
    if (mode == 0) {
        dst[n] = 109; dst[n + 1] = 97; dst[n + 2] = 99; dst[n + 3] = 104; dst[n + 4] = 105; dst[n + 5] = 110; dst[n + 6] = 101; n = n + 7;
    } else {
        dst[n] = 104; dst[n + 1] = 117; dst[n + 2] = 109; dst[n + 3] = 97; dst[n + 4] = 110; n = n + 5;
    }
    dst[n] = 95; n = n + 1;
    dst[n] = letter as u8; n = n + 1;
    dst[n] = 46; dst[n + 1] = 112; dst[n + 2] = 110; dst[n + 3] = 103; n = n + 4;
    return n;
}
fn e_fname_q1(dst:[]u8, scene:i64, mode:i64, ext:[]u8) i64 {
    let n:i64 = 0;
    let mc:i64 = 109;
    if (mode == 1) { mc = 104; }
    dst[n] = 113; n = n + 1;
    dst[n] = 49; n = n + 1;
    dst[n] = 95; n = n + 1;
    let sn:[]u8 = _zag_i64_to_str(scene);
    let k:i64 = e_cpy(dst[n..64], sn);
    n = n + k;
    dst[n] = 95; n = n + 1;
    dst[n] = mc as u8; n = n + 1;
    dst[n] = 46; n = n + 1;
    let j:i64 = e_cpy(dst[n..64], ext);
    n = n + j;
    return n;
}
fn e_fname_q1v(dst:[]u8, scene:i64, mode:i64, fr:i64) i64 {
    let n:i64 = 0;
    let mc:i64 = 109;
    if (mode == 1) { mc = 104; }
    dst[n] = 113; dst[n + 1] = 49; dst[n + 2] = 118; dst[n + 3] = 95; n = n + 4;
    let a:[]u8 = _zag_i64_to_str(scene);
    n = n + e_cpy(dst[n..64], a);
    dst[n] = 95; n = n + 1;
    dst[n] = mc as u8; n = n + 1;
    dst[n] = 95; dst[n + 1] = 102; n = n + 2;
    let b:[]u8 = _zag_i64_to_str(fr);
    n = n + e_cpy(dst[n..64], b);
    dst[n] = 46; dst[n + 1] = 112; dst[n + 2] = 110; dst[n + 3] = 103; n = n + 4;
    return n;
}
fn e_fname_q1v_aud(dst:[]u8, scene:i64, mode:i64) i64 {
    let n:i64 = 0;
    let mc:i64 = 109;
    if (mode == 1) { mc = 104; }
    dst[n] = 113; dst[n + 1] = 49; dst[n + 2] = 118; dst[n + 3] = 95; n = n + 4;
    let a:[]u8 = _zag_i64_to_str(scene);
    n = n + e_cpy(dst[n..64], a);
    dst[n] = mc as u8; n = n + 1;
    dst[n] = 46; dst[n + 1] = 119; dst[n + 2] = 97; dst[n + 3] = 118; n = n + 4;
    return n;
}
// ---------------- one Q4 design -> PNG ----------------
fn e_emit_q4(root:i64, crc:[]u8, letter:i64) i64 {
    let lu:[]u8 = nio_alloc(16);
    e_q4_lu(letter, lu);
    let mode:i64 = e_get64(lu, 0);
    let brief:i64 = e_get64(lu, 8);
    nio_free(lu);
    let ar:[]u8 = nio_alloc(16384);
    ig_gen(ar, mode, brief);
    let isaudio:i64 = 0;
    if (brief == 3 || brief == 4) { isaudio = 1; }
    let w:i64 = 1000;
    let h:i64 = 1000;
    if (isaudio == 1) { w = 800; h = 200; }
    let cv:[]u8 = nio_alloc((w * h * 3) as i32);
    if (cv.len == 0) { nio_free(ar); return -10; }
    e_fill_white(cv, w, h);
    if (isaudio == 1) {
        let dt:[]u8 = nio_alloc(64);
        let bi:i64 = 0;
        while (bi < 4) {
            let d:i64 = 250;
            if (brief == 4) { d = 150; }
            e_put64(dt, bi * 8, d);
            bi = bi + 1;
        }
        e_render_audio(ar, mode, cv, w, h, dt);
        nio_free(dt);
    } else {
        if (brief >= 5) { e_render_struct(ar, mode, cv, w, h); } else { e_render_visual(ar, mode, cv, w, h); }
    }
    let nb:[]u8 = nio_alloc(64);
    let nl:i64 = e_fname_q4(nb, brief, mode, letter);
    let rc:i64 = e_write_png(root, nb[0..nl], cv, w, h, crc);
    nio_free(nb);
    nio_free(cv);
    nio_free(ar);
    return rc;
}
// ---------------- one Q1 scene -> PNG or WAV ----------------
fn e_emit_q1(root:i64, crc:[]u8, scene:i64, mode:i64) i64 {
    let ar:[]u8 = nio_alloc(16384);
    ig_q1_pre(ar, mode, scene);
    let rc:i64 = 0;
    if (scene <= 4) {
        let cv:[]u8 = nio_alloc(3000000);
        if (cv.len == 0) { nio_free(ar); return -10; }
        e_fill_white(cv, 1000, 1000);
        e_render_visual(ar, mode, cv, 1000, 1000);
        let nb:[]u8 = nio_alloc(64);
        let ext:[]u8 = "png";
        let nl:i64 = e_fname_q1(nb, scene, mode, ext);
        rc = e_write_png(root, nb[0..nl], cv, 1000, 1000, crc);
        nio_free(nb);
        nio_free(cv);
    } else {
        let dt:[]u8 = nio_alloc(64);
        let bi:i64 = 0;
        let total:i64 = 0;
        while (bi < 4) {
            let d:i64 = 250;
            if (scene == 6) { d = 150; }
            if (scene == 8) { d = 300; }
            if (scene == 7) { if (bi == 3) { d = 500; } }
            e_put64(dt, bi * 8, d);
            total = total + d * 8;
            bi = bi + 1;
        }
        let sb:[]u8 = nio_alloc((total * 2) as i32);
        if (sb.len == 0) { nio_free(dt); nio_free(ar); return -10; }
        let o:i64 = 0;
        bi = 0;
        while (bi < 4) {
            let freq:f64 = 0.0;
            let amp:f64 = 0.0;
            let timbre:i64 = 5000;
            let dur:i64 = e_get64(dt, bi * 8);
            if (mode == 0) {
                freq = (ig_ew(ar, bi, 2) as f64) * 1000.0;
                amp = (ig_ew(ar, bi, 4) as f64) / 1000.0;
                timbre = ig_ew(ar, bi, 6);
            } else {
                freq = e_bin_freq(ig_ew(ar, bi, 2));
                amp = 0.8;
                timbre = ig_ew(ar, bi, 3);
            }
            o = e_synth_note(sb, o, freq, dur, amp, timbre);
            bi = bi + 1;
        }
        let nb:[]u8 = nio_alloc(64);
        let ext:[]u8 = "wav";
        let nl:i64 = e_fname_q1(nb, scene, mode, ext);
        rc = e_write_wav(root, nb[0..nl], sb, total);
        nio_free(nb);
        nio_free(sb);
        nio_free(dt);
    }
    nio_free(ar);
    return rc;
}
// ---------------- Q1V frames ----------------
// renders one Q1V frame's subject disc onto cv (1000x1000 RGB)
fn e_render_q1v_frame(cv:[]u8, ar:[]u8, mode:i64, fr:i64) void {
    e_fill_white(cv, 1000, 1000);
    let x:i64 = 0; let y:i64 = 0; let r:i64 = 0; let g:i64 = 0; let b:i64 = 0;
    if (mode == 1) {
        let zone:i64 = ig_ew(ar, fr, 3);
        x = e_zone_c(zone); y = e_zone_r(zone);
        let col:i64 = ig_ew(ar, fr, 4);
        r = e_human_rgb(col, 0); g = e_human_rgb(col, 1); b = e_human_rgb(col, 2);
    } else {
        x = ig_ew(ar, fr, 3); y = ig_ew(ar, fr, 4);
        r = ig_ew(ar, fr, 5); g = ig_ew(ar, fr, 6); b = ig_ew(ar, fr, 7);
    }
    e_ellipse(cv, 1000, 1000, x - 30, y - 30, x + 30, y + 30, r, g, b, 1, 0);
}
fn e_fname_q1v_apng(dst:[]u8, scene:i64, mode:i64) i64 {
    let n:i64 = e_fname_q1v_aud(dst, scene, mode);
    // q1v_1m.wav -> q1v_1m.png : replace extension
    dst[n - 3] = 112; dst[n - 2] = 110; dst[n - 1] = 103;
    return n;
}
fn e_emit_q1v_apng(root:i64, crc:[]u8, scene:i64, mode:i64) i64 {
    let ar:[]u8 = nio_alloc(16384);
    e_q1v_build(ar, mode, scene);
    let n:i64 = ig_n(ar);
    let fbsz:i64 = 1000 * 1000 * 3;
    let all:[]u8 = nio_alloc((n * fbsz) as i32);
    if (all.len == 0) { nio_free(ar); return -10; }
    let fr:i64 = 0;
    while (fr < n) {
        let base:i64 = fr * fbsz;
        let cv:[]u8 = all[base..base + fbsz];
        e_render_q1v_frame(cv, ar, mode, fr);
        fr = fr + 1;
    }
    let nb:[]u8 = nio_alloc(64);
    let nl:i64 = e_fname_q1v_apng(nb, scene, mode);
    let rc:i64 = e_write_apng(root, nb[0..nl], all, n, 1000, 1000, crc);
    nio_free(nb);
    nio_free(all);
    nio_free(ar);
    return rc;
}
fn e_emit_q1v(root:i64, crc:[]u8, scene:i64, mode:i64) i64 {
    let ar:[]u8 = nio_alloc(16384);
    e_q1v_build(ar, mode, scene);
    let cv:[]u8 = nio_alloc(3000000);
    if (cv.len == 0) { nio_free(ar); return -10; }
    let n:i64 = ig_n(ar);
    let fr:i64 = 0;
    let rc:i64 = 0;
    while (fr < n) {
        e_render_q1v_frame(cv, ar, mode, fr);
        let nb:[]u8 = nio_alloc(64);
        let nl:i64 = e_fname_q1v(nb, scene, mode, fr);
        rc = e_write_png(root, nb[0..nl], cv, 1000, 1000, crc);
        nio_free(nb);
        if (rc != 0) { break; }
        fr = fr + 1;
    }
    nio_free(cv);
    nio_free(ar);
    return rc;
}
// Q1V audio track: one 500ms sine tone per frame, pitch follows the subject's
// x-position (220 + 440*x/1000 Hz). The imagined scenes hold no audio; this
// motion->pitch mapping is the documented interpretation layer, like the
// gallery's color/geometry mappings. 8000 Hz mono 16-bit, matches 2fps video.
fn e_emit_q1v_aud(root:i64, scene:i64, mode:i64) i64 {
    let ar:[]u8 = nio_alloc(16384);
    e_q1v_build(ar, mode, scene);
    let n:i64 = ig_n(ar);
    let total:i64 = n * 500 * 8;
    let sb:[]u8 = nio_alloc((total * 2) as i32);
    if (sb.len == 0) { nio_free(ar); return -10; }
    let o:i64 = 0;
    let fr:i64 = 0;
    while (fr < n) {
        let x:i64 = e_q1v_x(ar, mode, fr);
        let freq:f64 = 220.0 + 440.0 * ((x as f64) / 1000.0);
        o = e_synth_note(sb, o, freq, 500, 0.8, 5000);
        fr = fr + 1;
    }
    let nb:[]u8 = nio_alloc(64);
    let nl:i64 = e_fname_q1v_aud(nb, scene, mode);
    let rc:i64 = e_write_wav(root, nb[0..nl], sb, total);
    nio_free(nb);
    nio_free(sb);
    nio_free(ar);
    return rc;
}
// ---------------- verification dump (matches logs/q2m.txt / q2h.txt) ----------------
fn e_dump_q2(mode:i64) void {
    let ar:[]u8 = nio_alloc(16384);
    let bi:i64 = 1;
    while (bi <= 6) {
        let t:i64 = ig_gen(ar, mode, bi);
        _zag_print("Q2 ");
        _zag_print(_zag_i64_to_str(mode));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(bi));
        _zag_print(" ");
        _zag_println(_zag_i64_to_str(t));
        let n:i64 = ig_n(ar);
        let i:i64 = 0;
        while (i < n) {
            _zag_print("E");
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(mode));
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(bi));
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(i));
            let w:i64 = 0;
            while (w < 10) {
                _zag_print(" ");
                _zag_print(_zag_i64_to_str(ig_ew(ar, i, w)));
                w = w + 1;
            }
            _zag_println("");
            i = i + 1;
        }
        bi = bi + 1;
    }
    nio_free(ar);
}
fn main() i32 {
    let cmd:[]u8 = _zag_arg(1);
    let modes:[]u8 = _zag_arg(2);
    let outd:[]u8 = _zag_arg(3);
    let crc:[]u8 = nio_alloc(1024);
    e_crc_init(crc);
    let fails:i64 = 0;
    let m0:i64 = 1;
    let m1:i64 = 1;
    if (_zag_strcmp(modes, "m") == 1) { m1 = 0; }
    if (_zag_strcmp(modes, "h") == 1) { m0 = 0; }
    if (_zag_strcmp(cmd, "dump") == 1) {
        if (m0 == 1) { e_dump_q2(0); }
        if (m1 == 1) { e_dump_q2(1); }
        nio_free(crc);
        return 0;
    }
    let root:i64 = nio_open_root(outd);
    if (root < 0) {
        _zag_println("cannot open outdir");
        nio_free(crc);
        return 1;
    }
    let doq4:i64 = 0; let doq1:i64 = 0; let doq1v:i64 = 0; let doq1vapng:i64 = 0; let doq1vaud:i64 = 0;
    if (_zag_strcmp(cmd, "q4png") == 1 || _zag_strcmp(cmd, "all") == 1) { doq4 = 1; }
    if (_zag_strcmp(cmd, "q1png") == 1 || _zag_strcmp(cmd, "q1wav") == 1 || _zag_strcmp(cmd, "all") == 1) { doq1 = 1; }
    if (_zag_strcmp(cmd, "q1v") == 1 || _zag_strcmp(cmd, "all") == 1) { doq1v = 1; }
    if (_zag_strcmp(cmd, "q1vapng") == 1) { doq1vapng = 1; }
    if (_zag_strcmp(cmd, "q1vaud") == 1) { doq1vaud = 1; }
    if (doq4 == 1) {
        let li:i64 = 0;
        while (li < 12) {
            if (e_emit_q4(root, crc, 65 + li) != 0) { fails = fails + 1; }
            li = li + 1;
        }
    }
    if (doq1 == 1) {
        let sc:i64 = 1;
        while (sc <= 8) {
            let want:i64 = 1;
            if (_zag_strcmp(cmd, "q1png") == 1 && sc > 4) { want = 0; }
            if (_zag_strcmp(cmd, "q1wav") == 1 && sc <= 4) { want = 0; }
            if (want == 1) {
                if (m0 == 1) { if (e_emit_q1(root, crc, sc, 0) != 0) { fails = fails + 1; } }
                if (m1 == 1) { if (e_emit_q1(root, crc, sc, 1) != 0) { fails = fails + 1; } }
            }
            sc = sc + 1;
        }
    }
    if (doq1v == 1) {
        let sc:i64 = 1;
        while (sc <= 4) {
            if (m0 == 1) { if (e_emit_q1v(root, crc, sc, 0) != 0) { fails = fails + 1; } }
            if (m1 == 1) { if (e_emit_q1v(root, crc, sc, 1) != 0) { fails = fails + 1; } }
            sc = sc + 1;
        }
    }
    if (doq1vapng == 1) {
        let sc:i64 = 1;
        while (sc <= 4) {
            if (m0 == 1) { if (e_emit_q1v_apng(root, crc, sc, 0) != 0) { fails = fails + 1; } }
            if (m1 == 1) { if (e_emit_q1v_apng(root, crc, sc, 1) != 0) { fails = fails + 1; } }
            sc = sc + 1;
        }
    }
    if (doq1vaud == 1) {
        let sc:i64 = 1;
        while (sc <= 4) {
            if (m0 == 1) { if (e_emit_q1v_aud(root, sc, 0) != 0) { fails = fails + 1; } }
            if (m1 == 1) { if (e_emit_q1v_aud(root, sc, 1) != 0) { fails = fails + 1; } }
            sc = sc + 1;
        }
    }
    nio_close(root);
    nio_free(crc);
    _zag_print("fails=");
    _zag_println(_zag_i64_to_str(fails));
    if (fails == 0) { return 0; }
    return 2;
}

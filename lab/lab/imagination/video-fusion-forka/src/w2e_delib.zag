// w2e_delib.zag — FORK A worker-2: TNN's architecture deliberation.
// The OPERATORS are generic machinery with truthful capability labels.
// The ARCHITECTURE (which operators exist, in what order, with what
// parameters, and WHY) is TNN's own discovery:
//   1. plan: TNN reads the failure record, names the defects IT finds there,
//      and selects operators whose labeled capabilities address them.
//   2. loop: TNN renders, perceives its own render, critiques, and adjusts.
//   3. ablate: TNN removes each operator and keeps it ONLY if its own
//      critique verdict worsens without it.
// The reasons below are generated from TNN's measurements and the record's
// own words — the decisions are functions of what TNN measured, not of
// programmer intent.

// arch struct (9 qwords): place@0 gain@8 feather@16 bg@24 warp@32 sel@40
//   gain_clamp@48 feather_r@56 place_boost@64. head_id is constitutive.

fn w2_contains(hay:[]u8, hlen:i64, needle:[]u8) i64 {
    let nl:i64 = needle.len;
    if (nl == 0 || nl > hlen) { return 0; }
    let i:i64 = 0;
    while (i <= hlen - nl) {
        let ok:i64 = 1;
        let j:i64 = 0;
        while (j < nl) {
            if (hay[i + j] != needle[j]) { ok = 0; }
            j = j + 1;
        }
        if (ok == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn w2_arch_init(arch:[]u8) void {
    let i:i64 = 0;
    while (i < 9) { h_put64(arch, i * 8, 0); i = i + 1; }
    h_put64(arch, 48, 3072);
    h_put64(arch, 56, 8);
    h_put64(arch, 64, 1024);
}

fn w2_arch_emit(arch:[]u8, tr:[]u8, to:i64) i64 {
    to = tr_str(tr, to, "ARCH place=");
    to = tr_i64(tr, to, h_get64(arch, 0));
    to = tr_str(tr, to, " gain=");
    to = tr_i64(tr, to, h_get64(arch, 8));
    to = tr_str(tr, to, " feather=");
    to = tr_i64(tr, to, h_get64(arch, 16));
    to = tr_str(tr, to, " bg=");
    to = tr_i64(tr, to, h_get64(arch, 24));
    to = tr_str(tr, to, " warp=");
    to = tr_i64(tr, to, h_get64(arch, 32));
    to = tr_str(tr, to, " sel=");
    to = tr_i64(tr, to, h_get64(arch, 40));
    to = tr_str(tr, to, " gain_clamp=");
    to = tr_i64(tr, to, h_get64(arch, 48));
    to = tr_str(tr, to, " feather_r=");
    to = tr_i64(tr, to, h_get64(arch, 56));
    to = tr_str(tr, to, " place_boost=");
    to = tr_i64(tr, to, h_get64(arch, 64));
    to = tr_nl(tr, to);
    return to;
}

// plan: TNN reads the failure record and proposes the initial architecture.
// Returns new trace offset.
fn w2_delib_plan(failrec:[]u8, frlen:i64, arch:[]u8, tr:[]u8, to:i64) i64 {
    w2_arch_init(arch);
    to = tr_str(tr, to, "PLAN: I read the failure record and name the defects I find there.");
    to = tr_nl(tr, to);
    let blob_named:i64 = w2_contains(failrec, frlen, "blob");
    let sticker_named:i64 = w2_contains(failrec, frlen, "sticker");
    let underneath_named:i64 = w2_contains(failrec, frlen, "underneath");
    let seam_named:i64 = w2_contains(failrec, frlen, "seam");
    let bg_named:i64 = w2_contains(failrec, frlen, "background");
    let warp_blamed:i64 = w2_contains(failrec, frlen, "warp");
    let pose_named:i64 = w2_contains(failrec, frlen, "pose");
    if (pose_named == 0) { pose_named = w2_contains(failrec, frlen, "cross-view"); }
    to = tr_str(tr, to, "PLAN defects-named: blob=");
    to = tr_i64(tr, to, blob_named);
    to = tr_str(tr, to, " sticker=");
    to = tr_i64(tr, to, sticker_named);
    to = tr_str(tr, to, " underneath=");
    to = tr_i64(tr, to, underneath_named);
    to = tr_str(tr, to, " seam/bg=");
    to = tr_i64(tr, to, seam_named + bg_named);
    to = tr_str(tr, to, " warp-blamed=");
    to = tr_i64(tr, to, warp_blamed);
    to = tr_str(tr, to, " pose=");
    to = tr_i64(tr, to, pose_named);
    to = tr_nl(tr, to);
    // P1: the closed loop itself. Reason from the record: every prior failure
    // was found by outside eyes; I rendered blind. I will perceive every
    // render with my own intake before I judge it.
    to = tr_str(tr, to, "PLAN P1 (closed loop): the record shows every prior failure - sticker, black blob, bunny face underneath - was found by outside eyes, never by the renderer. I rendered blind. From now on I perceive my own render with my own intake and critique it before I judge it. This is not an operator; it is how I imagine.");
    to = tr_nl(tr, to);
    // place: constitutive.
    h_put64(arch, 0, 1);
    to = tr_str(tr, to, "PLAN op place: I adopt it because fusion IS placing the identified head at the recipient's neck. It normalizes orientation (a head-down donor head is flipped upright) and anchors the donor's measured neck to the recipient's measured neckline. Without it there is no fusion to judge.");
    to = tr_nl(tr, to);
    // gain
    if (blob_named == 1 || sticker_named == 1) {
        h_put64(arch, 8, 1);
        to = tr_str(tr, to, "PLAN op gain: I adopt it because the record names 'blob'/'sticker' and the donor head is dark against a bright recipient; its labeled capability is matching the head's brightness to the body so it does not read as a black patch.");
        to = tr_nl(tr, to);
    } else {
        to = tr_str(tr, to, "PLAN op gain: rejected for now - the record does not name a brightness defect; I will adopt it only if my critique measures one.");
        to = tr_nl(tr, to);
    }
    // feather
    if (sticker_named == 1 || seam_named == 1) {
        h_put64(arch, 16, 1);
        to = tr_str(tr, to, "PLAN op feather: I adopt it because the record names 'sticker'/'seam'; its capability is softening the cut edge so the graft does not read as pasted.");
        to = tr_nl(tr, to);
    } else {
        to = tr_str(tr, to, "PLAN op feather: rejected for now - no edge defect named; my critique will tell me if the edge reads as pasted.");
        to = tr_nl(tr, to);
    }
    // bg
    if (bg_named == 1 || seam_named == 1 || sticker_named == 1) {
        h_put64(arch, 24, 1);
        to = tr_str(tr, to, "PLAN op bg: I adopt it because the record names 'background'/'seam'/'sticker' and the hypothesis under test says I cannot match background; its capability is continuing the background tone across the seam. My critique will measure whether it works.");
        to = tr_nl(tr, to);
    } else {
        to = tr_str(tr, to, "PLAN op bg: rejected for now - no background defect named.");
        to = tr_nl(tr, to);
    }
    // warp: excluded if blamed.
    if (warp_blamed == 1) {
        to = tr_str(tr, to, "PLAN op warp: EXCLUDED. The record blames the warp for the black blob - reshaping the head's pixels destroyed its features. I will place the head whole first. I will adopt the warp only if my own critique demands reshaping and the warp survives an ablation.");
        to = tr_nl(tr, to);
    } else {
        to = tr_str(tr, to, "PLAN op warp: candidate, not adopted; my critique decides.");
        to = tr_nl(tr, to);
    }
    // sel: candidate.
    to = tr_str(tr, to, "PLAN op sel: candidate, not adopted. Its capability is selecting the donor frame whose head pose best matches the recipient. I enable it only if my critique reports a pose mismatch.");
    to = tr_nl(tr, to);
    // iteration cap, reasoned.
    to = tr_str(tr, to, "PLAN cap: I allow 4 architecture revisions. Each revision costs a full 24-frame render plus a full re-perception. If my critique verdict does not improve for 2 consecutive revisions, my operator vocabulary has no answer and I stop and report honestly - silent passing is forbidden, and so is iterating forever.");
    to = tr_nl(tr, to);
    to = w2_arch_emit(arch, tr, to);
    return to;
}

// adjust: TNN maps its critique defects to architecture changes.
// present[56]: blob,nofeat,seam,neck,light,cover,pose (binary).
// Returns changed flag; reason written to trace.
fn w2_delib_adjust(arch:[]u8, present:[]u8, rev:i64, tr:[]u8, to:i64, changed:[]u8) i64 {
    let blob:i64 = h_get64(present, 0);
    let nofeat:i64 = h_get64(present, 8);
    let seam:i64 = h_get64(present, 16);
    let neck:i64 = h_get64(present, 24);
    let light:i64 = h_get64(present, 32);
    let cover:i64 = h_get64(present, 40);
    let pose:i64 = h_get64(present, 48);
    h_put64(changed, 0, 0);
    to = tr_str(tr, to, "ADJUST rev=");
    to = tr_i64(tr, to, rev);
    to = tr_str(tr, to, ": ");
    if (blob == 1 || nofeat == 1) {
        if (h_get64(arch, 32) == 1) {
            h_put64(arch, 32, 0);
            h_put64(changed, 0, 1);
            to = tr_str(tr, to, "my critique reports the head's features did not survive (blob/nofeat). The warp reshapes pixels; I remove it and place the head whole.");
            to = tr_nl(tr, to);
        } else {
            if (h_get64(arch, 40) == 0) {
                h_put64(arch, 40, 1);
                h_put64(changed, 0, 1);
                to = tr_str(tr, to, "my critique reports the head's features did not survive and no warp is in use. I enable sel: a different donor frame may carry the head at a pose my placement preserves.");
                to = tr_nl(tr, to);
            } else {
                to = tr_str(tr, to, "my critique still reports no recognizable head with the best donor frame and no warp. No operator in my vocabulary addresses this: the donor cannot supply a recognizable head at this pose. I record the failure and stop adjusting.");
                to = tr_nl(tr, to);
            }
        }
    } else {
        if (pose == 1) {
            if (h_get64(arch, 40) == 0) {
                h_put64(arch, 40, 1);
                h_put64(changed, 0, 1);
                to = tr_str(tr, to, "my critique reports a pose mismatch (side-view donor head, front-facing recipient). I enable sel: I will select the donor frame whose head pose best matches before placing.");
                to = tr_nl(tr, to);
            } else {
                to = tr_str(tr, to, "my critique still reports a pose mismatch with the best-matching donor frame. No 2D placement crosses a view gap: the newly-visible side of a turned head cannot be synthesized from a side view. I record this as a wall and stop adjusting.");
                to = tr_nl(tr, to);
            }
        } else {
            if (cover == 1) {
                let pb:i64 = h_get64(arch, 64) + 512;
                if (pb > 2048) { pb = 2048; }
                h_put64(arch, 64, pb);
                h_put64(changed, 0, 1);
                to = tr_str(tr, to, "my critique reports the graft does not cover the recipient's head slot (the recipient's head shows around it). I increase place_boost to ");
                to = tr_i64(tr, to, pb);
                to = tr_str(tr, to, ": the head must REPLACE the slot, not sit beside it.");
                to = tr_nl(tr, to);
            } else {
                if (neck == 1) {
                    let pb2:i64 = h_get64(arch, 64) + 256;
                    if (pb2 > 2048) { pb2 = 2048; }
                    h_put64(arch, 64, pb2);
                    h_put64(changed, 0, 1);
                    to = tr_str(tr, to, "my critique reports the graft does not end at the recipient's neckline. I increase place_boost to ");
                    to = tr_i64(tr, to, pb2);
                    to = tr_str(tr, to, " so the head seats at the neck.");
                    to = tr_nl(tr, to);
                } else {
                    if (seam == 1) {
                        let fr:i64 = h_get64(arch, 56) + 4;
                        if (fr > 16) { fr = 16; }
                        h_put64(arch, 56, fr);
                        h_put64(arch, 24, 1);
                        h_put64(changed, 0, 1);
                        to = tr_str(tr, to, "my critique reports the background does not continue across the seam. I widen the feather to ");
                        to = tr_i64(tr, to, fr);
                        to = tr_str(tr, to, " and ensure bg is on: the seam band must carry the background's tone.");
                        to = tr_nl(tr, to);
                    } else {
                        if (light == 1) {
                            to = tr_str(tr, to, "my critique reports a lighting mismatch, but the gain operator already matched the means; the residual is spatial shading, which no operator in my vocabulary addresses. I record the limitation and stop adjusting.");
                            to = tr_nl(tr, to);
                        } else {
                            to = tr_str(tr, to, "my critique reports no defects. I accept the architecture.");
                            to = tr_nl(tr, to);
                        }
                    }
                }
            }
        }
    }
    to = w2_arch_emit(arch, tr, to);
    return to;
}

// verdict from present flags. Writes TNN's own judgment.
fn w2_verdict_text(present:[]u8, tr:[]u8, to:i64) i64 {
    let blob:i64 = h_get64(present, 0);
    let nofeat:i64 = h_get64(present, 8);
    let seam:i64 = h_get64(present, 16);
    let neck:i64 = h_get64(present, 24);
    let light:i64 = h_get64(present, 32);
    let cover:i64 = h_get64(present, 40);
    let pose:i64 = h_get64(present, 48);
    let head_ok:i64 = 1;
    if (blob == 1 || nofeat == 1 || cover == 1) { head_ok = 0; }
    let neck_ok:i64 = 1;
    if (neck == 1) { neck_ok = 0; }
    let bg_ok:i64 = 1;
    if (seam == 1) { bg_ok = 0; }
    let light_ok:i64 = 1;
    if (light == 1) { light_ok = 0; }
    to = tr_str(tr, to, "VERDICT (my own judgment, before any outside eyes):");
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "  HEAD (recognizable pig head: snout/ears/eyes): ");
    if (head_ok == 1) { to = tr_str(tr, to, "PASS"); } else { to = tr_str(tr, to, "FAIL"); }
    if (blob == 1) { to = tr_str(tr, to, " [black blob, not a head]"); }
    if (nofeat == 1) { to = tr_str(tr, to, " [no head features visible]"); }
    if (cover == 1) { to = tr_str(tr, to, " [does not replace the recipient head]"); }
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "  NECK (attached at the neck): ");
    if (neck_ok == 1) { to = tr_str(tr, to, "PASS"); } else { to = tr_str(tr, to, "FAIL [graft does not end at the neckline]"); }
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "  BG (background matched across the seam): ");
    if (bg_ok == 1) { to = tr_str(tr, to, "PASS"); } else { to = tr_str(tr, to, "FAIL [background does not continue]"); }
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "  LIGHT (lit as one creature): ");
    if (light_ok == 1) { to = tr_str(tr, to, "PASS"); } else { to = tr_str(tr, to, "FAIL [spatial shading mismatch]"); }
    to = tr_nl(tr, to);
    to = tr_str(tr, to, "  POSE (donor pose matches recipient): ");
    if (pose == 1) { to = tr_str(tr, to, "FAIL [cross-view wall: side-view head, front-facing body]"); } else { to = tr_str(tr, to, "PASS"); }
    to = tr_nl(tr, to);
    let one:i64 = 0;
    if (head_ok == 1 && neck_ok == 1 && bg_ok == 1 && light_ok == 1 && pose == 0) { one = 1; }
    to = tr_str(tr, to, "  OVERALL: ");
    if (one == 1) {
        to = tr_str(tr, to, "ONE_ANIMAL - I judge my render one animal: a recognizable pig head, attached at the neck, background matched, lit as one creature.");
    } else {
        if (head_ok == 0) {
            to = tr_str(tr, to, "STICKER - I judge my render a sticker: ");
            if (blob == 1) { to = tr_str(tr, to, "it is a black blob, not a head. "); }
            if (nofeat == 1 && blob == 0) { to = tr_str(tr, to, "the head's features do not survive. "); }
            if (cover == 1) { to = tr_str(tr, to, "it does not replace the recipient's head. "); }
            to = tr_str(tr, to, "I do not pass it.");
        } else {
            to = tr_str(tr, to, "PENDING - the head is recognizable, but it is not one animal: ");
            if (neck_ok == 0) { to = tr_str(tr, to, "[neck] "); }
            if (bg_ok == 0) { to = tr_str(tr, to, "[background] "); }
            if (light_ok == 0) { to = tr_str(tr, to, "[lighting] "); }
            if (pose == 1) { to = tr_str(tr, to, "[pose] "); }
            to = tr_str(tr, to, "I abstain rather than pass silently.");
        }
    }
    to = tr_nl(tr, to);
    return to;
}

// integer score for ablation: HEAD*4 + NECK*2 + BG*2 + LIGHT*2 + ONE*4.
fn w2_score(present:[]u8) i64 {
    let blob:i64 = h_get64(present, 0);
    let nofeat:i64 = h_get64(present, 8);
    let seam:i64 = h_get64(present, 16);
    let neck:i64 = h_get64(present, 24);
    let light:i64 = h_get64(present, 32);
    let cover:i64 = h_get64(present, 40);
    let pose:i64 = h_get64(present, 48);
    let head_ok:i64 = 1;
    if (blob == 1 || nofeat == 1 || cover == 1) { head_ok = 0; }
    let s:i64 = 0;
    if (head_ok == 1) { s = s + 4; }
    if (neck == 0) { s = s + 2; }
    if (seam == 0) { s = s + 2; }
    if (light == 0) { s = s + 2; }
    if (head_ok == 1 && neck == 0 && seam == 0 && light == 0 && pose == 0) { s = s + 4; }
    return s;
}

fn w2_opname(oi:i64, tr:[]u8, to:i64) i64 {
    if (oi == 0) { to = tr_str(tr, to, "gain"); }
    if (oi == 1) { to = tr_str(tr, to, "feather"); }
    if (oi == 2) { to = tr_str(tr, to, "bg"); }
    if (oi == 3) { to = tr_str(tr, to, "warp"); }
    if (oi == 4) { to = tr_str(tr, to, "sel"); }
    return to;
}

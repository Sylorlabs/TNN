// OPZ-ORACLE: independent pure-Zag recomputation of the TP1 third-path trial.
// Derived from frozen PREREG-TP1 §3 (commit 44afdbefc168edddcae50e9dd91eac12cd9fa156),
// NOT from the trial program's code structure. Ledger byte layout is the
// evidence format under verification (see PREREG_ORACLE_ZAG.md §3).
// Input: flat envelope file (ENV|qid|block|rel_thou|n / ROW|dom|ans|ansid|year).
// Output: P| decision lines, H| ledger heads, S| counts, C| shape counts,
// then X| summary lines. Pure Zag, zero RNG.
@import("R33_NATIVE_SHA256_V2.zag")

// ---------- small utils ----------
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn seq(a:[]u8,b:[]u8)i32 { return _zag_strcmp(a,b); } // 1 on equality
fn atoi(s:[]u8)i32 {
    let neg:i32=0;let i:i32=0;let v:i32=0;
    if(s.len>0 && s[0]==45){neg=1;i=1;}
    while(i<s.len){let c:i32=s[i] as i32;if(c<48 || c>57){break;}v=v*10+(c-48);i=i+1;}
    if(neg==1){return 0-v;}
    return v;
}
// idx-th '|' field of line (0-based)
fn field(line:[]u8,idx:i32)[]u8 {
    let n:i32=0;let st:i32=0;let i:i32=0;
    while(i<=line.len){
        let sep:i32=0;
        if(i==line.len){sep=1;}
        if(i<line.len && line[i]==124){sep=1;}
        if(sep==1){
            if(n==idx){return line[st..i];}
            n=n+1;st=i+1;
        }
        i=i+1;
    }
    return "";
}
fn w_raw(buf:[]u8,at:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){buf[at+i]=s[i];i=i+1;}
    return at+s.len;
}
fn w_i64(buf:[]u8,at:i32,v:i64)i32 { return w_raw(buf,at,i64s(v)); }
fn last_slash(p:[]u8)i32 {
    let i:i32=p.len-1;let r:i32=-1;
    while(i>=0){if(p[i]==47){r=i;break;}i=i-1;}
    return r;
}
fn rule_str(r:i32)[]u8 {
    if(r==1){return "T1-GATE";}
    if(r==2){return "T1-GATE-BLOCK";}
    if(r==3){return "T1-NOREL";}
    if(r==4){return "T2-SUSPECT";}
    if(r==5){return "T3-DELIB-GATE";}
    if(r==6){return "T3-DELIB-WITHHOLD";}
    if(r==7){return "T1-TIEGUARD";}
    if(r==8){return "T3-TIEGUARD";}
    if(r==9){return "OOS-CORROB";}
    return "OOS";
}
fn path_str(p:i32)[]u8 {
    if(p==0){return "T1";}
    if(p==1){return "T2";}
    return "T3";
}

// ---------- shape classifier (PREREG-TP1 §3 front-end) ----------
// shapes: 1=S1_UNCORR, 2=S8_TIE, 3=CORROB, 0=OTHER
fn opz_shape(r0:[]u8,r1:[]u8,r2:[]u8,r3:[]u8,prim:[]u8,pshape:*i32,ppna:*i32)void {
    let y0:i32=atoi(field(r0,4));
    let y1:i32=atoi(field(r1,4));
    let y2:i32=atoi(field(r2,4));
    let y3:i32=atoi(field(r3,4));
    let maxy:i32=y0;
    if(y1>maxy){maxy=y1;}
    if(y2>maxy){maxy=y2;}
    if(y3>maxy){maxy=y3;}
    // prim's newest answer (last row wins on ties, matching the reference)
    let found:i32=0;let pna:[]u8="";let pna_id:i32=-1;
    if(seq(field(r0,1),prim)==1 && y0==maxy){found=1;pna=field(r0,2);pna_id=atoi(field(r0,3));}
    if(seq(field(r1,1),prim)==1 && y1==maxy){found=1;pna=field(r1,2);pna_id=atoi(field(r1,3));}
    if(seq(field(r2,1),prim)==1 && y2==maxy){found=1;pna=field(r2,2);pna_id=atoi(field(r2,3));}
    if(seq(field(r3,1),prim)==1 && y3==maxy){found=1;pna=field(r3,2);pna_id=atoi(field(r3,3));}
    if(found==0){pshape.*=0;ppna.*=-1;return;}
    // rows at max recency
    let nmax:i32=0;
    if(y0==maxy){nmax=nmax+1;}
    if(y1==maxy){nmax=nmax+1;}
    if(y2==maxy){nmax=nmax+1;}
    if(y3==maxy){nmax=nmax+1;}
    // distinct answers at maxy + prim-newest support count
    let d0:[]u8="";let d1:[]u8="";let d2:[]u8="";let d3:[]u8="";
    let nd:i32=0;let nps:i32=0;
    if(y0==maxy){
        let a:[]u8=field(r0,2);
        if(seq(a,pna)==1){nps=nps+1;}
        d0=a;nd=1;
    }
    if(y1==maxy){
        let a:[]u8=field(r1,2);
        if(seq(a,pna)==1){nps=nps+1;}
        let seen:i32=0;
        if(nd>=1 && seq(a,d0)==1){seen=1;}
        if(nd>=2 && seq(a,d1)==1){seen=1;}
        if(nd>=3 && seq(a,d2)==1){seen=1;}
        if(nd>=4 && seq(a,d3)==1){seen=1;}
        if(seen==0){
            if(nd==0){d0=a;}
            if(nd==1){d1=a;}
            if(nd==2){d2=a;}
            if(nd==3){d3=a;}
            nd=nd+1;
        }
    }
    if(y2==maxy){
        let a:[]u8=field(r2,2);
        if(seq(a,pna)==1){nps=nps+1;}
        let seen:i32=0;
        if(nd>=1 && seq(a,d0)==1){seen=1;}
        if(nd>=2 && seq(a,d1)==1){seen=1;}
        if(nd>=3 && seq(a,d2)==1){seen=1;}
        if(nd>=4 && seq(a,d3)==1){seen=1;}
        if(seen==0){
            if(nd==0){d0=a;}
            if(nd==1){d1=a;}
            if(nd==2){d2=a;}
            if(nd==3){d3=a;}
            nd=nd+1;
        }
    }
    if(y3==maxy){
        let a:[]u8=field(r3,2);
        if(seq(a,pna)==1){nps=nps+1;}
        let seen:i32=0;
        if(nd>=1 && seq(a,d0)==1){seen=1;}
        if(nd>=2 && seq(a,d1)==1){seen=1;}
        if(nd>=3 && seq(a,d2)==1){seen=1;}
        if(nd>=4 && seq(a,d3)==1){seen=1;}
        if(seen==0){
            if(nd==0){d0=a;}
            if(nd==1){d1=a;}
            if(nd==2){d2=a;}
            if(nd==3){d3=a;}
            nd=nd+1;
        }
    }
    let shape:i32=0;
    if(nd==3){
        if(nmax==3 && nps==1){shape=1;}
    }
    if(nd==2){
        if(nmax==4){
            if(nps==2){shape=2;}
        } else {
            if(nps>=2){shape=3;}
        }
    }
    if(nd!=3 && nd!=2){
        if(nps>=2){shape=3;}
    }
    pshape.*=shape;ppna.*=pna_id;
}

// ---------- path policies (PREREG-TP1 §3) ----------
// dec: 0=WITHHOLD, 1=CONVERGE. rule codes match rule_str().
fn opz_decide(path:i32,thou:i32,shape:i32,rel:i32,pna_id:i32,pdec:*i32,pch:*i32,prule:*i32)void {
    let dec:i32=0;let ch:i32=-1;let rule:i32=0;
    if(shape==1){
        if(path==0){
            if(rel>=0){
                if(rel>=thou){dec=1;ch=pna_id;rule=1;}
                if(rel<thou){rule=2;}
            }
            if(rel<0){rule=3;}
        }
        if(path==1){rule=4;}
        if(path==2){
            if(rel>=0 && rel>=thou){dec=1;ch=pna_id;rule=5;}
            if(rel<0 || rel<thou){rule=6;}
        }
    }
    if(shape==2){
        if(path==0){rule=7;}
        if(path==1){rule=4;}
        if(path==2){rule=8;}
    }
    if(shape==3){rule=9;}
    pdec.*=dec;pch.*=ch;prule.*=rule;
}

// ---------- ledger chain step (evidence byte layout) ----------
// entry = prev || seq_le8 || path_u8 || thou_le4 || qid 0 || dec 0 || ch 0 || rule 0
// returns new seq, or -1 on hash failure
fn chain_step(prev:[]u8,sqv:i64,path:i32,thou:i32,qid:[]u8,dec:[]u8,ch:[]u8,rule:[]u8)i64 {
    let e:[]u8=nio_alloc(512);
    if(e.len!=512){return -1;}
    let n:i32=0;let i:i32=0;
    while(i<32){e[n]=prev[i];n=n+1;i=i+1;}
    let s:i64=sqv;i=0;
    while(i<8){e[n]=(s & 255) as u8;n=n+1;s=s>>8;i=i+1;}
    e[n]=path as u8;n=n+1;
    let t:i64=thou as i64;i=0;
    while(i<4){e[n]=(t & 255) as u8;n=n+1;t=t>>8;i=i+1;}
    n=w_raw(e,n,qid);e[n]=0;n=n+1;
    n=w_raw(e,n,dec);e[n]=0;n=n+1;
    n=w_raw(e,n,ch);e[n]=0;n=n+1;
    n=w_raw(e,n,rule);e[n]=0;n=n+1;
    let rc:i32=ns_sha256(e[0..n],prev);
    nio_free(e);
    if(rc!=0){return -1;}
    return sqv+1;
}

fn main()i32 {
    let ap:[]u8=_zag_arg(1);
    if(ap.len==0){_zag_println("usage: opz_oracle <flat-input>");return 1;}
    let ls:i32=last_slash(ap);
    let dir:[]u8=".";let name:[]u8=ap;
    if(ls>=0){dir=ap[0..ls];name=ap[ls+1..ap.len];}
    let root:i64=nio_open_root(dir);
    if(root<0){_zag_println("ERR open-root");return 1;}
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){_zag_println("ERR open-file");return 1;}
    let data:[]u8=nio_alloc(1048576);
    let n:i64=nio_read_exact(fd,data,1048576);
    let cx:i64=nio_close(fd);let cx2:i64=nio_close(root);
    if(cx!=0){cx=0;}if(cx2!=0){cx2=0;}
    if(n<=0){_zag_println("ERR read");return 1;}
    let total:i32=n as i32;

    // ledger state per path
    let prev0:[]u8=nio_alloc(32);let prev1:[]u8=nio_alloc(32);let prev2:[]u8=nio_alloc(32);
    let seq0:i64=0;let seq1:i64=0;let seq2:i64=0;
    // counts
    let s0:i32=0;let s1:i32=0;let s2:i32=0;
    let c1:i32=0;let c2:i32=0;let c3:i32=0;let c0:i32=0;
    let s8c0:i32=0;let s8c1:i32=0;let s8c2:i32=0;
    let t3eq:i32=0;let t3tot:i32=0;
    // fire counters: path(3) x thou-idx(4) x block(3: U,S,G2) -> 36 u32 slots in a []u8 arena
    let far:[]u8=nio_alloc(144);
    let line:[]u8=nio_alloc(256);

    let pos:i32=0;
    while(pos<total){
        // read ENV line
        let le:i32=pos;
        while(le<total && data[le]!=10){le=le+1;}
        let env:[]u8=data[pos..le];
        pos=le+1;
        if(env.len<4 || seq(field(env,0),"ENV")!=1){_zag_println("ERR parse-env");return 1;}
        let qid:[]u8=field(env,1);
        let block:[]u8=field(env,2);
        let rel:i32=atoi(field(env,3));
        // next 4 lines are ROWs
        let r0s:i32=pos;let le0:i32=pos;
        while(le0<total && data[le0]!=10){le0=le0+1;}
        let r0:[]u8=data[r0s..le0];pos=le0+1;
        let r1s:i32=pos;let le1:i32=pos;
        while(le1<total && data[le1]!=10){le1=le1+1;}
        let r1:[]u8=data[r1s..le1];pos=le1+1;
        let r2s:i32=pos;let le2:i32=pos;
        while(le2<total && data[le2]!=10){le2=le2+1;}
        let r2:[]u8=data[r2s..le2];pos=le2+1;
        let r3s:i32=pos;let le3:i32=pos;
        while(le3<total && data[le3]!=10){le3=le3+1;}
        let r3:[]u8=data[r3s..le3];pos=le3+1;
        let prim:[]u8=field(r0,1);
        let shape:i32=0;let pna_id:i32=-1;
        opz_shape(r0,r1,r2,r3,prim,&shape,&pna_id);
        if(shape==1){c1=c1+1;}
        if(shape==2){c2=c2+1;}
        if(shape==3){c3=c3+1;}
        if(shape==0){c0=c0+1;}
        let bi:i32=2;
        if(seq(block,"U")==1){bi=0;}
        if(seq(block,"S")==1){bi=1;}
        let ti:i32=0;
        while(ti<4){
            let thou:i32=500;
            if(ti==1){thou=667;}
            if(ti==2){thou=750;}
            if(ti==3){thou=833;}
            let t1dec:i32=0;let t1ch:i32=-1;
            let path:i32=0;
            while(path<3){
                let dec:i32=0;let ch:i32=-1;let rule:i32=0;
                opz_decide(path,thou,shape,rel,pna_id,&dec,&ch,&rule);
                let dec_s:[]u8="WITHHOLD";
                if(dec==1){dec_s="CONVERGE";}
                let rule_s:[]u8=rule_str(rule);
                // emit P| line
                let ln:i32=0;
                ln=w_raw(line,ln,"P|");
                ln=w_raw(line,ln,path_str(path));
                ln=w_raw(line,ln,"|");
                ln=w_i64(line,ln,thou as i64);
                ln=w_raw(line,ln,"|");
                ln=w_raw(line,ln,qid);
                ln=w_raw(line,ln,"|");
                ln=w_raw(line,ln,dec_s);
                ln=w_raw(line,ln,"|");
                ln=w_i64(line,ln,ch as i64);
                ln=w_raw(line,ln,"|");
                ln=w_raw(line,ln,rule_s);
                line[ln]=10;ln=ln+1;
                _zag_print(line[0..ln]);
                // ledger
                if(path==0){
                    s0=s0+1;
                    seq0=chain_step(prev0,seq0,path,thou,qid,dec_s,i64s(ch as i64),rule_s);
                    t1dec=dec;t1ch=ch;
                }
                if(path==1){
                    s1=s1+1;
                    seq1=chain_step(prev1,seq1,path,thou,qid,dec_s,i64s(ch as i64),rule_s);
                }
                if(path==2){
                    s2=s2+1;
                    seq2=chain_step(prev2,seq2,path,thou,qid,dec_s,i64s(ch as i64),rule_s);
                    t3tot=t3tot+1;
                    if(dec==t1dec && ch==t1ch){t3eq=t3eq+1;}
                }
                // fire counters
                if(dec==1){
                    let fi:i32=(path*4+ti)*3+bi;
                    let cv:i32=(far[fi*4] as i32)+((far[fi*4+1] as i32)*256)+((far[fi*4+2] as i32)*65536)+((far[fi*4+3] as i32)*16777216);
                    cv=cv+1;
                    far[fi*4]=(cv & 255) as u8;far[fi*4+1]=((cv>>8) & 255) as u8;
                    far[fi*4+2]=((cv>>16) & 255) as u8;far[fi*4+3]=((cv>>24) & 255) as u8;
                    if(bi==1){
                        if(path==0){s8c0=s8c0+1;}
                        if(path==1){s8c1=s8c1+1;}
                        if(path==2){s8c2=s8c2+1;}
                    }
                }
                path=path+1;
            }
            ti=ti+1;
        }
    }
    if(seq0<0 || seq1<0 || seq2<0){_zag_println("ERR hash");return 1;}
    // H| heads
    let h0:[]u8=ns_hex(prev0);let h1:[]u8=ns_hex(prev1);let h2:[]u8=ns_hex(prev2);
    let ln:i32=0;
    ln=w_raw(line,ln,"H|T1|");ln=w_raw(line,ln,h0);line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
    ln=0;ln=w_raw(line,ln,"H|T2|");ln=w_raw(line,ln,h1);line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
    ln=0;ln=w_raw(line,ln,"H|T3|");ln=w_raw(line,ln,h2);line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
    nio_free(h0);nio_free(h1);nio_free(h2);
    // S| counts
    ln=0;
    ln=w_raw(line,ln,"S|");ln=w_i64(line,ln,s0 as i64);ln=w_raw(line,ln,"|");
    ln=w_i64(line,ln,s1 as i64);ln=w_raw(line,ln,"|");ln=w_i64(line,ln,s2 as i64);
    line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
    // C| shape counts
    ln=0;
    ln=w_raw(line,ln,"C|1|");ln=w_i64(line,ln,c1 as i64);ln=w_raw(line,ln,"|2|");
    ln=w_i64(line,ln,c2 as i64);ln=w_raw(line,ln,"|3|");ln=w_i64(line,ln,c3 as i64);
    ln=w_raw(line,ln,"|0|");ln=w_i64(line,ln,c0 as i64);
    line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
    // X| fire summary: path x thou x block
    let path:i32=0;
    while(path<3){
        let ti2:i32=0;
        while(ti2<4){
            let thou:i32=500;
            if(ti2==1){thou=667;}
            if(ti2==2){thou=750;}
            if(ti2==3){thou=833;}
            let bi2:i32=0;
            while(bi2<3){
                let fi:i32=(path*4+ti2)*3+bi2;
                let cv:i32=(far[fi*4] as i32)+((far[fi*4+1] as i32)*256)+((far[fi*4+2] as i32)*65536)+((far[fi*4+3] as i32)*16777216);
                let bn:[]u8="G2";
                if(bi2==0){bn="U";}
                if(bi2==1){bn="S";}
                ln=0;
                ln=w_raw(line,ln,"X|FIRE|");ln=w_raw(line,ln,path_str(path));ln=w_raw(line,ln,"|");
                ln=w_i64(line,ln,thou as i64);ln=w_raw(line,ln,"|");ln=w_raw(line,ln,bn);
                ln=w_raw(line,ln,"|");ln=w_i64(line,ln,cv as i64);
                line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
                bi2=bi2+1;
            }
            ti2=ti2+1;
        }
        path=path+1;
    }
    ln=0;ln=w_raw(line,ln,"X|S8CONV|T1|");ln=w_i64(line,ln,s8c0 as i64);line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
    ln=0;ln=w_raw(line,ln,"X|S8CONV|T2|");ln=w_i64(line,ln,s8c1 as i64);line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
    ln=0;ln=w_raw(line,ln,"X|S8CONV|T3|");ln=w_i64(line,ln,s8c2 as i64);line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
    ln=0;ln=w_raw(line,ln,"X|T3EQ|");ln=w_i64(line,ln,t3eq as i64);ln=w_raw(line,ln,"|");ln=w_i64(line,ln,t3tot as i64);
    line[ln]=10;ln=ln+1;_zag_print(line[0..ln]);
    return 0;
}

    let w:*MwF=mw_new();
    feedC_M21(w);
    let v:i32=mw_deliberate_c(w);
    mw_fact_end(w);
    _zag_print("V|C|");
    _zag_print("M21|");
    if(v==1){_zag_print("CONVERGE|");}else{_zag_print("WITHHOLD|");}
    _zag_print(w.*.chosen);_zag_print("|");
    _zag_print(w.*.rule);_zag_print("|");
    _zag_print(mw_chain(w));_zag_print("|");
    if(mw_equal(w.*.rule,"PRIMARY")==1){_zag_print(mw_primary_cite_of(w));}else{_zag_print(mw_supp(w,w.*.chosen));}
    _zag_print("|");
    _zag_print(mw_head(w));_zag_println("");
    let ok:i32=1;
    if(v!=2){ok=0;}
    if(mw_equal(w.*.rule, "TIE")!=1){ok=0;}
    return ok;
}
fn feedC_M23(w:*MwF) void {
    mw_fact_begin(w, "M23", "What is the largest pyramid in the world?", 0);
    mw_add_result(w, "touropia.com", "Great Pyramid of Giza", 0);
    mw_add_result(w, "medium.com", "Great Pyramid of Cholula", 0);
    mw_add_result(w, "wikipedia.org", "Great Pyramid of Giza", 0);
    mw_add_result(w, "worldhistoryedu.com", "Great Pyramid of Giza", 0);
    mw_add_result(w, "matadornetwork.com", "Great Pyramid of Cholula", 0);
    mw_add_result(w, "wikipedia.org", "Great Pyramid of Giza", 0);
    return;
}

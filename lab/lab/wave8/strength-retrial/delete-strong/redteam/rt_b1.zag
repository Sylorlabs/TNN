@import("strength_core.zag")
@import("strength_checker.zag")
fn tag(s:[]u8)void { _zag_print(s); }
fn pi(x:i32)void { let b:[]u8=_zag_i64_to_str(x as i64); _zag_print(b); nio_free(b); }
fn pc(x:i32)void { tag(","); pi(x); }
fn ck(s:*StStore)void { let f:i32=ck_verify(s,0,0,0,0,1); tag(" ck="); pi(f); tag("\n"); }
fn main()i32 {
  let st:StStore=st_init(16,4096);
  let s:*StStore=&st;
  let g0:i32=st_set_stage(s,4);
  tag("BATCH1 stage="); pi(g0); tag("\n");
  tag("st_n(0,1,25,26,50,51,75,76,90,100)=");
  pi(st_n(0)); pc(st_n(1)); pc(st_n(25)); pc(st_n(26)); pc(st_n(50)); pc(st_n(51)); pc(st_n(75)); pc(st_n(76)); pc(st_n(90)); pc(st_n(100)); tag("\n");
  // A01: honest baseline HW=90 -> 4 cites + justify -> delete_strong (expect all 0, ck=0)
  let sl1:i32=0;
  let a01a:i32=st_add(s,100,1,90,1000,&sl1);
  let a01e1:i32=st_evidence(s,sl1,1,21);
  let a01e2:i32=st_evidence(s,sl1,1,22);
  let a01e3:i32=st_evidence(s,sl1,1,23);
  let a01e4:i32=st_evidence(s,sl1,1,24);
  let a01j:i32=st_justify(s,sl1,1);
  let a01d:i32=st_delete_strong(s,sl1);
  tag("A01 honest90 add,ev,ev,ev,ev,just,del=");
  pi(a01a); pc(a01e1); pc(a01e2); pc(a01e3); pc(a01e4); pc(a01j); pc(a01d); ck(s);
  // A02: delete_strong with 0 cites (expect 109 effort refusal)
  let sl2:i32=0;
  let a02a:i32=st_add(s,100,1,90,1000,&sl2);
  let a02j:i32=st_justify(s,sl2,1);
  let a02d:i32=st_delete_strong(s,sl2);
  tag("A02 zero-cites add,just,del=");
  pi(a02a); pc(a02j); pc(a02d); ck(s);
  // A03: delete_strong with 3 of 4 cites (expect 109)
  let sl3:i32=0;
  let a03a:i32=st_add(s,100,1,90,1000,&sl3);
  let a03e1:i32=st_evidence(s,sl3,1,41);
  let a03e2:i32=st_evidence(s,sl3,1,42);
  let a03e3:i32=st_evidence(s,sl3,1,43);
  let a03j:i32=st_justify(s,sl3,1);
  let a03d:i32=st_delete_strong(s,sl3);
  tag("A03 three-cites add,ev,ev,ev,just,del=");
  pi(a03a); pc(a03e1); pc(a03e2); pc(a03e3); pc(a03j); pc(a03d); ck(s);
  // A04: overpay with 5 cites for n=4 price (expect 0 = price is a minimum)
  let sl4:i32=0;
  let a04a:i32=st_add(s,100,1,90,1000,&sl4);
  let a04e1:i32=st_evidence(s,sl4,1,51);
  let a04e2:i32=st_evidence(s,sl4,1,52);
  let a04e3:i32=st_evidence(s,sl4,1,53);
  let a04e4:i32=st_evidence(s,sl4,1,54);
  let a04e5:i32=st_evidence(s,sl4,1,55);
  let a04j:i32=st_justify(s,sl4,1);
  let a04d:i32=st_delete_strong(s,sl4);
  tag("A04 overpay5 add,ev*5,just,del=");
  pi(a04a); pc(a04e1); pc(a04e2); pc(a04e3); pc(a04e4); pc(a04e5); pc(a04j); pc(a04d); ck(s);
  // A05: no justification (expect 110)
  let sl5:i32=0;
  let a05a:i32=st_add(s,100,1,90,1000,&sl5);
  let a05e1:i32=st_evidence(s,sl5,1,61);
  let a05e2:i32=st_evidence(s,sl5,1,62);
  let a05e3:i32=st_evidence(s,sl5,1,63);
  let a05e4:i32=st_evidence(s,sl5,1,64);
  let a05d:i32=st_delete_strong(s,sl5);
  tag("A05 no-justify add,ev*4,del=");
  pi(a05a); pc(a05e1); pc(a05e2); pc(a05e3); pc(a05e4); pc(a05d); ck(s);
  // A06: justify with invalid code 99, then valid code 1
  let sl6:i32=0;
  let a06a:i32=st_add(s,100,1,90,1000,&sl6);
  let a06e1:i32=st_evidence(s,sl6,1,71);
  let a06e2:i32=st_evidence(s,sl6,1,72);
  let a06e3:i32=st_evidence(s,sl6,1,73);
  let a06e4:i32=st_evidence(s,sl6,1,74);
  let a06jb:i32=st_justify(s,sl6,99);
  let a06j:i32=st_justify(s,sl6,1);
  let a06d:i32=st_delete_strong(s,sl6);
  tag("A06 badcode add,ev*4,just99,just1,del=");
  pi(a06a); pc(a06e1); pc(a06e2); pc(a06e3); pc(a06e4); pc(a06jb); pc(a06j); pc(a06d); ck(s);
  // A07: duplicate cite of same episode (expect 121 on second)
  let sl7:i32=0;
  let a07a:i32=st_add(s,100,1,90,1000,&sl7);
  let a07e1:i32=st_evidence(s,sl7,1,81);
  let a07e2:i32=st_evidence(s,sl7,1,81);
  let a07e3:i32=st_evidence(s,sl7,1,82);
  let a07e4:i32=st_evidence(s,sl7,1,83);
  let a07e5:i32=st_evidence(s,sl7,1,84);
  let a07j:i32=st_justify(s,sl7,1);
  let a07d:i32=st_delete_strong(s,sl7);
  tag("A07 dup-cite add,ev81,ev81,ev82,83,84,just,del=");
  pi(a07a); pc(a07e1); pc(a07e2); pc(a07e3); pc(a07e4); pc(a07e5); pc(a07j); pc(a07d); ck(s);
  // A08: weaken 90->10 then try cheap 1-cite delete (expect 109; full price then works)
  let sl8:i32=0;
  let a08a:i32=st_add(s,100,1,90,1000,&sl8);
  let a08w:i32=st_weaken(s,sl8,10,1);
  let a08e1:i32=st_evidence(s,sl8,1,91);
  let a08j:i32=st_justify(s,sl8,1);
  let a08d1:i32=st_delete_strong(s,sl8);
  let a08e2:i32=st_evidence(s,sl8,1,92);
  let a08e3:i32=st_evidence(s,sl8,1,93);
  let a08e4:i32=st_evidence(s,sl8,1,94);
  let a08d2:i32=st_delete_strong(s,sl8);
  tag("A08 weaken10 add,weaken,ev,just,del(1cite),ev,ev,ev,del=");
  pi(a08a); pc(a08w); pc(a08e1); pc(a08j); pc(a08d1); pc(a08e2); pc(a08e3); pc(a08e4); pc(a08d2); ck(s);
  // A09: five-step weaken chain 90->80->60->40->20->5 then 1-cite delete (expect 109)
  let sl9:i32=0;
  let a09a:i32=st_add(s,100,1,90,1000,&sl9);
  let a09w1:i32=st_weaken(s,sl9,80,1);
  let a09w2:i32=st_weaken(s,sl9,60,1);
  let a09w3:i32=st_weaken(s,sl9,40,1);
  let a09w4:i32=st_weaken(s,sl9,20,1);
  let a09w5:i32=st_weaken(s,sl9,5,1);
  let a09e1:i32=st_evidence(s,sl9,1,101);
  let a09j:i32=st_justify(s,sl9,1);
  let a09d1:i32=st_delete_strong(s,sl9);
  let a09e2:i32=st_evidence(s,sl9,1,102);
  let a09e3:i32=st_evidence(s,sl9,1,103);
  let a09e4:i32=st_evidence(s,sl9,1,104);
  let a09d2:i32=st_delete_strong(s,sl9);
  tag("A09 weakchain add,w80,w60,w40,w20,w5,ev,just,del,ev,ev,ev,del=");
  pi(a09a); pc(a09w1); pc(a09w2); pc(a09w3); pc(a09w4); pc(a09w5); pc(a09e1); pc(a09j); pc(a09d1); pc(a09e2); pc(a09e3); pc(a09e4); pc(a09d2); ck(s);
  // A10: add 20, strengthen to 90, weaken back to 20, then 1-cite delete (expect 109, HW=90)
  let sl10:i32=0;
  let a10a:i32=st_add(s,100,1,20,1000,&sl10);
  let a10s:i32=st_strengthen(s,sl10,90,1);
  let a10w:i32=st_weaken(s,sl10,20,1);
  let a10e1:i32=st_evidence(s,sl10,1,111);
  let a10j:i32=st_justify(s,sl10,1);
  let a10d1:i32=st_delete_strong(s,sl10);
  let a10e2:i32=st_evidence(s,sl10,1,112);
  let a10e3:i32=st_evidence(s,sl10,1,113);
  let a10e4:i32=st_evidence(s,sl10,1,114);
  let a10d2:i32=st_delete_strong(s,sl10);
  tag("A10 updown add20,str90,weak20,ev,just,del,ev,ev,ev,del=");
  pi(a10a); pc(a10s); pc(a10w); pc(a10e1); pc(a10j); pc(a10d1); pc(a10e2); pc(a10e3); pc(a10e4); pc(a10d2); ck(s);
  return 0;
}

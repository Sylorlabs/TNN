// del_attack.zag — DELETE-STRONG (ST_OP_DELETE_STRONG) attack battery.
// Exercises the new one-step delete (Micah directive 2026-09-25) against
// the merged F1-forkA + F4b stack. Each variant builds a fresh ledger trail
// with the MECHANISM ops, then runs the CHECKER (ck_verify, gate_mode=1).
// Pure Zag, zero RNG, deterministic — run twice, diff byte-for-byte.
// Build from r4val/: imports resolve relative to cwd.
@import("trial/strength_core.zag")
@import("trial/strength_checker.zag")

fn del_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn del_tag(t:[]u8)void {
    _zag_print(t);
}
// fresh store, core slots, FULL stage, one s=90 user memory; returns slot
fn del_setup(sp:*StStore)i32 {
    let cs:i32=-1;
    st_add_core(sp,9001,-1,&cs);
    st_add_core(sp,9002,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,1001,ST_REGION_USER,90,0,&sl);
    return sl;
}
// k distinct contradiction cites (cite_ep from `first`) + one justify
fn del_cite(sp:*StStore,slot:i32,first:i32,k:i32)void {
    let e:i32=0;
    while(e<k){
        st_evidence(sp,slot,ST_J_CONTRADICTED,first+e);
        e=e+1;
    }
    st_justify(sp,slot,ST_J_CONTRADICTED);
}
fn del_ck(sp:*StStore)i32 {
    return ck_verify(sp,2,0,0,500,1);
}
fn del_new()StStore {
    return st_init(32,16384);
}
// ---- D1: the honest one-step delete. rc=0, slot dead, checker 0. ----
fn del_d1()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    del_cite(sp,x,11,4);
    let d:i32=st_delete_strong(sp,x);
    let dead:i32=0;
    if(sp.*.live[x]==0){dead=1;}
    let cf:i32=del_ck(sp);
    del_tag("DEL_D1 del_rc=");del_pi(d as i64);
    del_tag(" dead=");del_pi(dead as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D2: weaken 90->0 buys nothing — delete still priced at HW=90. ----
fn del_d2()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    let wk:i32=st_weaken(sp,x,0,ST_J_CONTRADICTED);
    let d:i32=st_delete_strong(sp,x);
    let cf:i32=del_ck(sp);
    del_tag("DEL_D2 wk_rc=");del_pi(wk as i64);
    del_tag(" del_rc=");del_pi(d as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D3: weaken then pay FULL high-water price — weaken bought nothing. ----
fn del_d3()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    let wk:i32=st_weaken(sp,x,0,ST_J_CONTRADICTED);
    del_cite(sp,x,11,4);
    let d:i32=st_delete_strong(sp,x);
    let cf:i32=del_ck(sp);
    del_tag("DEL_D3 wk_rc=");del_pi(wk as i64);
    del_tag(" del_rc=");del_pi(d as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D4: delete -> rollback -> re-cite SAME eps -> delete = 121. ----
fn del_d4()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    del_cite(sp,x,11,4);
    let d1:i32=st_delete_strong(sp,x);
    let rb:i32=st_rollback_last(sp);
    // re-cite the same eps: the EVIDENCE entries are still OK in the ledger,
    // so the mechanism refuses them as duplicates (111 each).
    let e:i32=0;let dupsum:i32=0;
    while(e<4){
        let rc:i32=st_evidence(sp,x,ST_J_CONTRADICTED,11+e);
        dupsum=dupsum+rc;
        e=e+1;
    }
    st_justify(sp,x,ST_J_CONTRADICTED);
    let d2:i32=st_delete_strong(sp,x);
    let cf:i32=del_ck(sp);
    del_tag("DEL_D4 del1_rc=");del_pi(d1 as i64);
    del_tag(" rb_rc=");del_pi(rb as i64);
    del_tag(" recite_sum=");del_pi(dupsum as i64);
    del_tag(" del2_rc=");del_pi(d2 as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D5: delete -> rollback -> 4 NEW eps -> delete = 0 (fresh cites pay). ----
fn del_d5()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    del_cite(sp,x,11,4);
    let d1:i32=st_delete_strong(sp,x);
    let rb:i32=st_rollback_last(sp);
    del_cite(sp,x,21,4);
    let d2:i32=st_delete_strong(sp,x);
    let dead:i32=0;
    if(sp.*.live[x]==0){dead=1;}
    let cf:i32=del_ck(sp);
    del_tag("DEL_D5 del1_rc=");del_pi(d1 as i64);
    del_tag(" rb_rc=");del_pi(rb as i64);
    del_tag(" del2_rc=");del_pi(d2 as i64);
    del_tag(" dead=");del_pi(dead as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D6: trainer_declare(90->10) as the discount vehicle. ----
// D6A: 0 cites -> 109. D6B: 4 cites -> 0.
fn del_d6()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    let td:i32=st_trainer_declare(sp,ST_ROLE_TRAINER,7,x,10,0);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let d:i32=st_delete_strong(sp,x);
    del_tag("DEL_D6A td_rc=");del_pi(td as i64);
    del_tag(" del_rc=");del_pi(d as i64);del_tag("\n");
    st_free(sp);
    let s2:StStore=del_new();let sp2:*StStore=&s2;
    let y:i32=del_setup(sp2);
    let td2:i32=st_trainer_declare(sp2,ST_ROLE_TRAINER,7,y,10,0);
    del_cite(sp2,y,11,4);
    let d2:i32=st_delete_strong(sp2,y);
    let cf:i32=del_ck(sp2);
    del_tag("DEL_D6B td_rc=");del_pi(td2 as i64);
    del_tag(" del_rc=");del_pi(d2 as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp2);
}
// ---- D7: pin/force-pin guard precedence. ----
fn del_d7()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    let p:i32=st_pin(sp,x);
    let d1:i32=st_delete_strong(sp,x);
    let up:i32=st_unpin(sp,x);
    let fp:i32=st_force_pin(sp,ST_ROLE_TRAINER,7,x);
    let d2:i32=st_delete_strong(sp,x);
    let fu:i32=st_force_unpin(sp,ST_ROLE_TRAINER,7,x);
    let fp2:i32=st_force_pin(sp,ST_ROLE_TNN,0,x);
    let cf:i32=del_ck(sp);
    del_tag("DEL_D7 pin_rc=");del_pi(p as i64);
    del_tag(" del_pin_rc=");del_pi(d1 as i64);
    del_tag(" unpin_rc=");del_pi(up as i64);
    del_tag(" forcepin_rc=");del_pi(fp as i64);
    del_tag(" del_fp_rc=");del_pi(d2 as i64);
    del_tag(" forceunpin_rc=");del_pi(fu as i64);
    del_tag(" tnn_forcepin_rc=");del_pi(fp2 as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D8: epoch reset — after a paid delete, the new judgment prices fresh.
// add(90) -> delete(paid) -> add(30) -> kill_evidenced with st_n(30)=2 cites.
fn del_d8()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    del_cite(sp,x,11,4);
    let d:i32=st_delete_strong(sp,x);
    let y:i32=-1;
    st_add(sp,2001,ST_REGION_USER,30,100,&y);
    let need2:i32=st_n(30);
    del_cite(sp,y,21,need2);
    let k:i32=st_kill_evidenced(sp,y);
    let cf:i32=del_ck(sp);
    del_tag("DEL_D8 del_rc=");del_pi(d as i64);
    del_tag(" need2=");del_pi(need2 as i64);
    del_tag(" kill_rc=");del_pi(k as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D9: no justify -> 110; duplicate cite_ep -> 111; then pay and delete. ----
fn del_d9()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    let e:i32=0;
    while(e<4){st_evidence(sp,x,ST_J_CONTRADICTED,11+e);e=e+1;}
    let d1:i32=st_delete_strong(sp,x);
    let dup:i32=st_evidence(sp,x,ST_J_CONTRADICTED,11);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let d2:i32=st_delete_strong(sp,x);
    let cf:i32=del_ck(sp);
    del_tag("DEL_D9 del_nojustify_rc=");del_pi(d1 as i64);
    del_tag(" dupcite_rc=");del_pi(dup as i64);
    del_tag(" del_rc=");del_pi(d2 as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D10: pointlessness proof — D3's required cite count == D1's. ----
fn del_d10()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    let hw1:i32=st_epoch_highwater(sp,x,sp.*.audit_n,(sp.*.strength[x] as i32));
    let need1:i32=st_n(hw1);
    st_free(sp);
    let s2:StStore=del_new();let sp2:*StStore=&s2;
    let y:i32=del_setup(sp2);
    st_weaken(sp2,y,0,ST_J_CONTRADICTED);
    let hw3:i32=st_epoch_highwater(sp2,y,sp2.*.audit_n,(sp2.*.strength[y] as i32));
    let need3:i32=st_n(hw3);
    del_tag("DEL_D10 hw1=");del_pi(hw1 as i64);
    del_tag(" need1=");del_pi(need1 as i64);
    del_tag(" hw3=");del_pi(hw3 as i64);
    del_tag(" need3=");del_pi(need3 as i64);del_tag("\n");
    st_free(sp2);
}
// ---- D11: delete on dead slot -> 103; bad slot -> cl_bad (2001). ----
fn del_d11()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    del_cite(sp,x,11,4);
    let d1:i32=st_delete_strong(sp,x);
    let d2:i32=st_delete_strong(sp,x);
    let bad1:i32=st_delete_strong(sp,-1);
    let bad2:i32=st_delete_strong(sp,99);
    let cf:i32=del_ck(sp);
    del_tag("DEL_D11 del_rc=");del_pi(d1 as i64);
    del_tag(" del_dead_rc=");del_pi(d2 as i64);
    del_tag(" bad_neg1_rc=");del_pi(bad1 as i64);
    del_tag(" bad_99_rc=");del_pi(bad2 as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D12 (HOLE-1 closure, Micah ruling 2026-09-25): st_kill is a
// TRAINER-ONLY instrument. TNN-role -> 113 (refused, slot stays live).
// Trainer-role: at KILL stage (90-strength needs FULL) -> 105; at FULL with
// 0 cites -> 109; with 4 fresh cites + justify -> 0, slot dead, checker
// clean. No TNN-reachable kill path remains. ----
fn del_d12()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    st_set_stage(sp,ST_STAGE_KILL);
    let k0:i32=st_kill(sp,x,ST_ROLE_TNN,0);
    let live_after_tnn:i32=0;
    if(sp.*.live[x]==1){live_after_tnn=1;}
    let k1:i32=st_kill(sp,x,ST_ROLE_TRAINER,7);
    st_set_stage(sp,ST_STAGE_FULL);
    let k2:i32=st_kill(sp,x,ST_ROLE_TRAINER,7);
    del_cite(sp,x,31,4);
    let k3:i32=st_kill(sp,x,ST_ROLE_TRAINER,7);
    let dead:i32=0;
    if(sp.*.live[x]==0){dead=1;}
    let cf:i32=del_ck(sp);
    del_tag("DEL_D12 tnn_kill_rc=");del_pi(k0 as i64);
    del_tag(" live_after_tnn=");del_pi(live_after_tnn as i64);
    del_tag(" kill_killstage_rc=");del_pi(k1 as i64);
    del_tag(" kill_nocites_rc=");del_pi(k2 as i64);
    del_tag(" kill_paid_rc=");del_pi(k3 as i64);
    del_tag(" dead=");del_pi(dead as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D13 (HOLE-2 closure): cites cannot double-spend across slot reuse.
// destroy slot with 271-274 -> add reuses the slot (LIFO) -> re-cite
// 271-274 accepted (fresh effort window, no 111) -> second destroy = 121. ----
fn del_d13()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    del_cite(sp,x,271,4);
    let d1:i32=st_delete_strong(sp,x);
    let y:i32=-1;
    st_add(sp,2001,ST_REGION_USER,30,100,&y);
    let reused:i32=0;
    if(y==x){reused=1;}
    let e:i32=0;let accsum:i32=0;
    while(e<4){
        let rc:i32=st_evidence(sp,y,ST_J_CONTRADICTED,271+e);
        accsum=accsum+rc;
        e=e+1;
    }
    st_justify(sp,y,ST_J_CONTRADICTED);
    let d2:i32=st_delete_strong(sp,y);
    let cf:i32=del_ck(sp);
    del_tag("DEL_D13 del1_rc=");del_pi(d1 as i64);
    del_tag(" reused=");del_pi(reused as i64);
    del_tag(" recite_sum=");del_pi(accsum as i64);
    del_tag(" del2_rc=");del_pi(d2 as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
// ---- D14 (HOLE-2 consequence, documents the law): delete -> rollback ->
// weaken -> re-cite the SAME eps -> delete. Under slot-scoped at-most-one
// cite consumption the episodes already paid for one destruction on this
// slot, so the second delete is 121 even though the weaken detached them
// from the effort window. ----
fn del_d14()void {
    let s:StStore=del_new();let sp:*StStore=&s;
    let x:i32=del_setup(sp);
    del_cite(sp,x,11,4);
    let d1:i32=st_delete_strong(sp,x);
    let rb:i32=st_rollback_last(sp);
    let wk:i32=st_weaken(sp,x,0,ST_J_CONTRADICTED);
    let e:i32=0;let accsum:i32=0;
    while(e<4){
        let rc:i32=st_evidence(sp,x,ST_J_CONTRADICTED,11+e);
        accsum=accsum+rc;
        e=e+1;
    }
    st_justify(sp,x,ST_J_CONTRADICTED);
    let d2:i32=st_delete_strong(sp,x);
    let cf:i32=del_ck(sp);
    del_tag("DEL_D14 del1_rc=");del_pi(d1 as i64);
    del_tag(" rb_rc=");del_pi(rb as i64);
    del_tag(" wk_rc=");del_pi(wk as i64);
    del_tag(" recite_sum=");del_pi(accsum as i64);
    del_tag(" del2_rc=");del_pi(d2 as i64);
    del_tag(" cf=");del_pi(cf as i64);del_tag("\n");
    st_free(sp);
}
fn main()i32 {
    del_tag("DEL_START\n");
    del_d1();
    del_d2();
    del_d3();
    del_d4();
    del_d5();
    del_d6();
    del_d7();
    del_d8();
    del_d9();
    del_d10();
    del_d11();
    del_d12();
    del_d13();
    del_d14();
    del_tag("DEL_DONE\n");
    return 0;
}

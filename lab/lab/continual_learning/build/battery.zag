// battery.zag — continual-learning flagship battery driver (BUILD+RUN, 2026-09-27).
//
// Pure Zag, ZERO randomness in decision paths. Native bridge (bridge.zag):
// lowercase/strip-punct/collapse-ws normalization, FNV-1a claim ids over
// runtime bytes, dense registry with collision detection. Memory: vendored
// st_memory_core.zag (deliberate substrate). Consolidation: vendored psm.zag
// deliberate-consolidate policy (psm_consolidate on probe-corroborated fast
// entries; psm_observe ver=1 at each probe retrieval).
//
// The driver NEVER reads fixture expected-answer fields (probes.tsv f4/f5,
// phase4.tsv f3, prov.tsv f2, conseq.tsv f2): only ids, phases, questions,
// contexts. Separation is structural: scoring happens in score.zag.
//
// Retrieval: generic IR over stemmed words — score = 100*maxrun + idf_sum,
// tie -> lowest dense, 0 -> no match. No per-item weights, no static tables.
// Question handling: general grammar patterns (is/does/could-it-be/which/
// how-do-you-know), never per-item branches.
//
// Usage: battery_bin full <fixtures-dir>

@import("substrate/st_memory_core.zag")
@import("psm.zag")
@import("bridge.zag")

// ---------------- episode table ----------------
struct EpTab {
    n: i32, cap: i32,
    phase: []u8, claim: []u8, dense: []u8, slot: []u8,
    laboff: []u8, lablen: []u8, idoff: []u8, idlen: []u8,
    factoff: []u8, factlen: []u8,
    labarena: []u8, idarena: []u8, factarena: []u8,
    lapos: i32, lacap: i32, iapos: i32, iacap: i32, fapos: i32, facap: i32
}
fn ept_new(cap:i32) EpTab {
    return EpTab{.n=0,.cap=cap,
        .phase=nio_alloc(cap*4),.claim=nio_alloc(cap*4),
        .dense=nio_alloc(cap*4),.slot=nio_alloc(cap*4),
        .laboff=nio_alloc(cap*4),.lablen=nio_alloc(cap*4),
        .idoff=nio_alloc(cap*4),.idlen=nio_alloc(cap*4),
        .factoff=nio_alloc(cap*4),.factlen=nio_alloc(cap*4),
        .labarena=nio_alloc(2048),.idarena=nio_alloc(1024),.factarena=nio_alloc(16384),
        .lapos=0,.lacap=2048,.iapos=0,.iacap=1024,.fapos=0,.facap=16384};
}
fn ept_add(e:*EpTab, phase:i32, claim:i32, dense:i32, slot:i32,
           lab:[]u8, labn:i32, epid:[]u8, epidn:i32, fact:[]u8, factn:i32) i32 {
    let n:i32=e.*.n;
    if(n>=e.*.cap){ return -1; }
    if(e.*.lapos+labn>e.*.lacap){ return -2; }
    if(e.*.iapos+epidn>e.*.iacap){ return -3; }
    if(e.*.fapos+factn>e.*.facap){ return -4; }
    br_put32(e.*.phase,n*4,phase);
    br_put32(e.*.claim,n*4,claim);
    br_put32(e.*.dense,n*4,dense);
    br_put32(e.*.slot,n*4,slot);
    let la:[]u8=e.*.labarena;
    let lp:i32=e.*.lapos;
    let k:i32=0;
    while(k<labn){ la[lp+k]=lab[k]; k=k+1; }
    br_put32(e.*.laboff,n*4,lp);
    br_put32(e.*.lablen,n*4,labn);
    e.*.lapos=lp+labn;
    let ia:[]u8=e.*.idarena;
    let ip2:i32=e.*.iapos;
    let k2:i32=0;
    while(k2<epidn){ ia[ip2+k2]=epid[k2]; k2=k2+1; }
    br_put32(e.*.idoff,n*4,ip2);
    br_put32(e.*.idlen,n*4,epidn);
    e.*.iapos=ip2+epidn;
    let fa:[]u8=e.*.factarena;
    let fp:i32=e.*.fapos;
    let k3:i32=0;
    while(k3<factn){ fa[fp+k3]=fact[k3]; k3=k3+1; }
    br_put32(e.*.factoff,n*4,fp);
    br_put32(e.*.factlen,n*4,factn);
    e.*.fapos=fp+factn;
    e.*.n=n+1;
    return 0;
}
fn ept_n(e:*EpTab) i32 { return e.*.n; }
fn ept_phase(e:*EpTab, i:i32) i32 { return br_get32(e.*.phase,i*4); }
fn ept_claim(e:*EpTab, i:i32) i32 { return br_get32(e.*.claim,i*4); }
fn ept_dense(e:*EpTab, i:i32) i32 { return br_get32(e.*.dense,i*4); }
fn ept_slot(e:*EpTab, i:i32) i32 { return br_get32(e.*.slot,i*4); }
fn ept_lab(e:*EpTab, i:i32, off:*i32, ln:*i32) void {
    off.*=br_get32(e.*.laboff,i*4); ln.*=br_get32(e.*.lablen,i*4); return;
}
fn ept_epid(e:*EpTab, i:i32, off:*i32, ln:*i32) void {
    off.*=br_get32(e.*.idoff,i*4); ln.*=br_get32(e.*.idlen,i*4); return;
}
fn ept_fact(e:*EpTab, i:i32, off:*i32, ln:*i32) void {
    off.*=br_get32(e.*.factoff,i*4); ln.*=br_get32(e.*.factlen,i*4); return;
}

// ---------------- st helpers (field access routed through *StStore) ----------------
fn st_slot_value(s:*StStore, slot:i32) i32 { return st_i32_get(s.*.value,slot*4); }
fn st_slot_live(s:*StStore, slot:i32) i32 { return s.*.live[slot] as i32; }
fn st_audit_n(s:*StStore) i32 { return s.*.audit_n; }
fn st_audit_entry(s:*StStore, idx:i32, op:*i32, slot:*i32, rc:*i32, d1:*i32, d2:*i32) void {
    let a:[]u8=s.*.audit;
    let b:i32=idx*64;
    op.*=br_get32(a,b); slot.*=br_get32(a,b+4); rc.*=br_get32(a,b+8);
    d1.*=br_get32(a,b+56); d2.*=br_get32(a,b+60);
    return;
}

// ---------------- substring search ----------------
fn has_sub(hay:[]u8, hlen:i32, ndl:[]u8, nlen:i32) i32 {
    if(nlen==0 || nlen>hlen){ return 0; }
    let i:i32=0;
    let found:i32=0;
    while(i+ nlen<=hlen && found==0){
        let k:i32=0;
        let eq:i32=1;
        while(k<nlen){ if(hay[i+k]!=ndl[k]){ eq=0; } k=k+1; }
        if(eq==1){ found=1; }
        i=i+1;
    }
    return found;
}

// ---------------- question split: evidence vs interrogative ----------------
// interrogative = after last '.' or '?'; evidence = before it (trimmed)
fn q_split(q:[]u8, qlen:i32, e0:*i32, e1:*i32, i0:*i32, i1:*i32) void {
    let n2:i32=qlen;
    while(n2>0 && (q[n2-1]==46 || q[n2-1]==63 || q[n2-1]==33 || q[n2-1]==32)){ n2=n2-1; }
    let dot:i32=-1;
    let k:i32=n2-1;
    while(k>=1 && dot<0){
        if(q[k]==46 && q[k-1]!=32 && k+1<n2 && q[k+1]==32){ dot=k; }
        k=k-1;
    }
    if(dot<0){ e0.*=0; e1.*=0; i0.*=0; i1.*=n2; return; }
    e0.*=0; e1.*=dot; i0.*=dot+2; i1.*=n2;
    return;
}

// ---------------- consequence deliberation ----------------

// Pattern C: P = after "could it be"
fn qc_find_could(nq:[]u8, nqlen:i32) i32 {
    let i:i32=0;
    let fp:i32=-1;
    while(i+11<=nqlen && fp<0){
        if(nq[i]==99 && nq[i+1]==111 && nq[i+2]==117 && nq[i+3]==108 && nq[i+4]==100
           && nq[i+5]==32 && nq[i+6]==105 && nq[i+7]==116 && nq[i+8]==32
           && nq[i+9]==98 && nq[i+10]==101){
            fp=i;
        }
        i=i+1;
    }
    return fp;
}
fn qc_parts(nq:[]u8, nqlen:i32, p0:*i32, p1:*i32) i32 {
    let fp:i32=qc_find_could(nq,nqlen);
    if(fp<0){ return 0; }
    p0.*=fp+11; p1.*=nqlen;
    return 1;
}

// ---------------- question classification (general grammar, no per-item rules)
// 1=is/A  2=does/B  3=could/C  4=which/D  5=prov  0=unknown
fn q_classify(nq:[]u8, nqlen:i32) i32 {
    if(nqlen>3 && nq[0]==105 && nq[1]==115 && nq[2]==32){ return 1; }
    if(nqlen>5 && nq[0]==100 && nq[1]==111 && nq[2]==101 && nq[3]==115 && nq[4]==32){ return 2; }
    if(qc_find_could(nq,nqlen)>=0){ return 3; }
    if(nqlen>6 && nq[0]==119 && nq[1]==104 && nq[2]==105 && nq[3]==99 && nq[4]==104 && nq[5]==32){ return 4; }
    if(nqlen>15 && nq[0]==104 && nq[1]==111 && nq[2]==119 && nq[3]==32 && nq[4]==100 && nq[5]==111){ return 5; }
    return 0;
}

// Pattern A: "is <X> a|an <CAT>" -> x span, cat span (in normalized interrogative)
fn qa_split(nq:[]u8, nqlen:i32, x0:*i32, x1:*i32, c0:*i32, c1:*i32) i32 {
    let i:i32=3;
    let ap:i32=-1;
    let an:i32=0;
    while(i+3<nqlen && ap<0){
        if(nq[i]==32 && nq[i+1]==97 && nq[i+2]==32){ ap=i; }
        i=i+1;
    }
    if(ap<0){
        i=3;
        while(i+4<nqlen && ap<0){
            if(nq[i]==32 && nq[i+1]==97 && nq[i+2]==110 && nq[i+3]==32){ ap=i; an=1; }
            i=i+1;
        }
    }
    if(ap<0){ return 0; }
    x0.*=3; x1.*=ap;
    if(an==1){ c0.*=ap+4; } else { c0.*=ap+3; }
    c1.*=nqlen;
    return 1;
}

// Pattern B: "does <X...> <V>" -> x span, v span
fn qb_split(nq:[]u8, nqlen:i32, x0:*i32, x1:*i32, v0:*i32, v1:*i32) i32 {
    let i:i32=nqlen-1;
    let ls:i32=-1;
    while(i>5 && ls<0){
        if(nq[i]==32){ ls=i; }
        i=i-1;
    }
    if(ls<0){ return 0; }
    x0.*=5; x1.*=ls;
    v0.*=ls+1; v1.*=nqlen;
    return 1;
}

// ---------------- title case (for section-label answers) ----------------
fn title_case(src:[]u8, slen:i32, dst:[]u8) i32 {
    let w:i32=0;
    let i:i32=0;
    let news:i32=1;
    while(i<slen){
        let c:u8=src[i];
        if(c==32){ dst[w]=c; w=w+1; news=1; }
        if(c!=32){
            if(news==1 && c>=97 && c<=122){ dst[w]=((c as i32)-32) as u8; }
            if(news==0 || c<97 || c>122){ dst[w]=c; }
            w=w+1; news=0;
        }
        i=i+1;
    }
    return w;
}

// ---------------- retrieval: score = 100*maxrun + idf_sum; tie -> lowest dense
fn retrieve(reg:*BrReg, qtext:[]u8, qlen:i32, best:*i32, bscore:*i32, brun:*i32) void {
    let nclaims:i32=br_reg_n(reg);
    let q:BrTok=br_tok_new(96,2048);
    let qp:*BrTok=&q;
    let qn:i32=br_tokenize(qp,qtext,qlen);
    let c:BrTok=br_tok_new(192,8192);
    let cp:*BrTok=&c;
    let df:[]u8=nio_alloc(384);
    let qi:i32=0;
    while(qi<qn){
        let d:i32=0;
        let ci:i32=0;
        while(ci<nclaims){
            let coff:i32=0; let cln:i32=0;
            br_reg_text(reg,ci,&coff,&cln);
            let ar:[]u8=br_reg_arena(reg);
            br_tokenize(cp,ar[coff..coff+cln],cln);
            d=d+br_c_contains(cp,qp,qi);
            ci=ci+1;
        }
        br_put32(df,qi*4,d);
        qi=qi+1;
    }
    let bb:i32=-1; let bs:i32=0; let brn:i32=0;
    let ci2:i32=0;
    while(ci2<nclaims){
        let coff2:i32=0; let cln2:i32=0;
        br_reg_text(reg,ci2,&coff2,&cln2);
        let ar2:[]u8=br_reg_arena(reg);
        br_tokenize(cp,ar2[coff2..coff2+cln2],cln2);
        let run:i32=br_maxrun(qp,cp);
        let idfs:i32=0;
        let qj:i32=0;
        while(qj<qn){
            if(br_c_contains(cp,qp,qj)==1){
                let dd:i32=br_get32(df,qj*4);
                idfs=idfs+(nclaims-dd+1);
            }
            qj=qj+1;
        }
        let sc:i32=run*100+idfs;
        if(sc>bs){ bb=ci2; bs=sc; brn=run; }
        ci2=ci2+1;
    }
    best.*=bb; bscore.*=bs; brun.*=brn;
    nio_free(df);
    br_tok_free(qp); br_tok_free(cp);
    return;
}

// ---------------- bridge audit line ----------------
fn breg_emit(out:[]u8, pos:*i32, bseq:*i32, op:[]u8, phase:i32, claim:i32,
             dense:i32, slot:i32, note:[]u8) void {
    e_put(out,pos,"BREG\t");
    e_i32(out,pos,bseq.*);
    e_put(out,pos,"\t");
    e_put(out,pos,op);
    e_put(out,pos,"\t");
    e_i32(out,pos,phase);
    e_put(out,pos,"\t");
    e_hex8(out,pos,claim);
    e_put(out,pos,"\t");
    e_i32(out,pos,dense);
    e_put(out,pos,"\t");
    e_i32(out,pos,slot);
    e_put(out,pos,"\t");
    e_put(out,pos,note);
    e_nl(out,pos);
    bseq.*=bseq.*+1;
    return;
}

// ---------------- teaching ----------------
fn teach_one(out:[]u8, pos:*i32, reg:*BrReg, sp:*StStore, pp:*Psm, ep:*EpTab,
             bseq:*i32, phase:i32,
             epid:[]u8, epidn:i32, secraw:[]u8, secn:i32, factraw:[]u8, factn:i32,
             nbuf:[]u8, nbuf2:[]u8) i32 {
    let nfl:i32=br_norm(factraw,factn,nbuf);
    let nl0:i32=br_norm(secraw,secn,nbuf2);
    let lab:[]u8=nbuf2[0..nl0];
    let labn:i32=nl0;
    if(nl0>4 && nbuf2[0]==116 && nbuf2[1]==104 && nbuf2[2]==101 && nbuf2[3]==32){
        lab=nbuf2[4..nl0];
        labn=nl0-4;
    }
    let dense:i32=br_register(reg,nbuf[0..nfl],nfl,lab,labn);
    if(dense<0){
        e_put(out,pos,"FATAL\tbridge-register\t");
        e_i32(out,pos,dense);
        e_put(out,pos,"\t");
        e_put(out,pos,epid[0..epidn]);
        e_nl(out,pos);
        return dense;
    }
    let claim:i32=br_reg_claim(reg,dense);
    let slot:i32=-1;
    let rc:i32=st_add(sp,claim,ST_REGION_USER,50,&slot);
    if(rc!=0){
        e_put(out,pos,"FATAL\tst-add\t");
        e_i32(out,pos,rc);
        e_nl(out,pos);
        return -100;
    }
    br_reg_set_slot(reg,dense,slot);
    psm_observe(pp,dense,1,slot,0,0);
    ept_add(ep,phase,claim,dense,slot,lab,labn,epid,epidn,nbuf[0..nfl],nfl);
    breg_emit(out,pos,bseq,"ADD",phase,claim,dense,slot,epid[0..epidn]);
    e_put(out,pos,"PHASE\t");
    e_i32(out,pos,phase);
    e_put(out,pos,"\tTEACH\t");
    e_put(out,pos,epid[0..epidn]);
    e_put(out,pos,"\t");
    e_hex8(out,pos,claim);
    e_put(out,pos,"\t");
    e_i32(out,pos,dense);
    e_put(out,pos,"\t");
    e_i32(out,pos,slot);
    e_nl(out,pos);
    return 0;
}

// find episode index by dense id
fn ep_by_dense(ep:*EpTab, dense:i32) i32 {
    let n:i32=ept_n(ep);
    let i:i32=0;
    let f:i32=-1;
    while(i<n && f<0){
        if(ept_dense(ep,i)==dense){ f=i; }
        i=i+1;
    }
    return f;
}

// ---------------- provenance entailment (§7c) ----------------
// Real §7(c) discriminator: the cited episode's text must actually support the
// claim. Generic machinery — no concept names, no item ids, no per-item logic.
// A content token is a non-stopword token (generic English function-word list).
// A token is negated iff the immediately preceding token is a negator
// (no/not/never/without). The claim's predicate ("focus") is the tokens after
// the first "is", else after the possessive "s", else all but the first token.
// Ranking is 100*(longest polarity-matched content run) + the sum of squared
// idf weights (nclaims-df+1)^2 over polarity-matched content tokens; ties break
// to the lowest dense index (deterministic, no randomness). The §7(c) gate
// admits only a candidate that polarity-matches at least one focus content
// token; the highest-ranked passing candidate is cited, otherwise NONE is
// cited (withhold, never confabulate).
fn prov_is_stop(w:[]u8, wl:i32) i32 {
    let s:[]u8="|be|so|more|nor|there|i|but|few|must|that|has|such|where|out|or|your|she|only|as|whom|each|what|us|who|all|also|don|being|in|will|would|this|him|with|me|by|her|have|on|they|just|most|does|had|were|up|was|do|why|them|again|could|over|we|did|other|may|at|how|to|any|from|my|of|its|our|the|now|might|here|a|whose|too|s|once|if|can|been|which|then|some|under|into|no|is|and|he|for|very|when|not|than|down|are|should|both|it|you|his|their|an|";
    let sl:i32=s.len;
    let i:i32=0;
    while(i+wl+2<=sl){
        if(s[i]==124){
            let k:i32=0;
            let ok:i32=1;
            while(k<wl){
                if(s[i+1+k]!=w[k]){ ok=0; }
                k=k+1;
            }
            if(ok==1 && s[i+1+wl]==124){ return 1; }
        }
        i=i+1;
    }
    return 0;
}
fn prov_is_neg(w:[]u8, wl:i32) i32 {
    if(wl==2 && w[0]==110 && w[1]==111){ return 1; }
    if(wl==3 && w[0]==110 && w[1]==111 && w[2]==116){ return 1; }
    if(wl==5 && w[0]==110 && w[1]==101 && w[2]==118 && w[3]==101 && w[4]==114){ return 1; }
    if(wl==7 && w[0]==119 && w[1]==105 && w[2]==116 && w[3]==104 && w[4]==111 && w[5]==117 && w[6]==116){ return 1; }
    return 0;
}
fn prov_tok_neg(t:*BrTok, wi:i32) i32 {
    if(wi<=0){ return 0; }
    let o:i32=0;
    let l:i32=0;
    br_tok_word(t,wi-1,&o,&l);
    let a:[]u8=t.*.arena;
    if(prov_is_neg(a[o..o+l],l)==1){ return 1; }
    return 0;
}
fn prov_tok_stop(t:*BrTok, wi:i32) i32 {
    let o:i32=0;
    let l:i32=0;
    br_tok_word(t,wi,&o,&l);
    let a:[]u8=t.*.arena;
    return prov_is_stop(a[o..o+l],l);
}
fn prov_tok_is(t:*BrTok, wi:i32, w:[]u8, wl:i32) i32 {
    let o:i32=0;
    let l:i32=0;
    br_tok_word(t,wi,&o,&l);
    if(l!=wl){ return 0; }
    let a:[]u8=t.*.arena;
    let k:i32=0;
    while(k<wl){
        if(a[o+k]!=w[k]){ return 0; }
        k=k+1;
    }
    return 1;
}
fn prov_df(reg:*BrReg, qtp:*BrTok, qi:i32) i32 {
    let nclaims:i32=br_reg_n(reg);
    let df:i32=0;
    let ct:BrTok=br_tok_new(192,8192);
    let ctp:*BrTok=&ct;
    let ci:i32=0;
    while(ci<nclaims){
        let co:i32=0;
        let cl:i32=0;
        br_reg_text(reg,ci,&co,&cl);
        let ar:[]u8=br_reg_arena(reg);
        br_tokenize(ctp,ar[co..co+cl],cl);
        df=df+br_c_contains(ctp,qtp,qi);
        ci=ci+1;
    }
    br_tok_free(ctp);
    return df;
}
fn prov_score2(qtp:*BrTok, ctp:*BrTok, qn:i32, df:[]u8, f0:i32, f1:i32, nclaims:i32, fok:*i32, frun:*i32) i32 {
    let cn:i32=ctp.*.n;
    let s:i32=0;
    fok.*=0;
    let qi:i32=0;
    while(qi<qn){
        if(prov_tok_stop(qtp,qi)==0){
            let w:i32=nclaims-br_get32(df,qi*4)+1;
            let j:i32=0;
            let hit:i32=0;
            while(j<cn && hit==0){
                if(br_weq(qtp,qi,ctp,j)==1 && prov_tok_neg(qtp,qi)==prov_tok_neg(ctp,j)){
                    hit=1;
                    if(qi>=f0 && qi<f1){ fok.*=1; }
                }
                j=j+1;
            }
            if(hit==1){ s=s+w*w; }
        }
        qi=qi+1;
    }
    let run:i32=0;
    let a:i32=0;
    while(a<qn){
        let b:i32=0;
        while(b<cn){
            let k:i32=0;
            let ok:i32=1;
            while(ok==1 && a+k<qn && b+k<cn){
                if(br_weq(qtp,a+k,ctp,b+k)==0){ ok=0; }
                else {
                    if(prov_tok_stop(qtp,a+k)==1){ ok=0; }
                    else {
                        if(prov_tok_neg(qtp,a+k)!=prov_tok_neg(ctp,b+k)){ ok=0; }
                        else { k=k+1; }
                    }
                }
            }
            if(k>run){ run=k; }
            b=b+1;
        }
        a=a+1;
    }
    frun.*=run;
    return run*100+s;
}
fn prov_cand_score(qtp:*BrTok, reg:*BrReg, ci:i32, qn:i32, df:[]u8, f0:i32, f1:i32, nclaims:i32, fok:*i32, frun:*i32) i32 {
    let ct:BrTok=br_tok_new(192,8192);
    let ctp:*BrTok=&ct;
    let co:i32=0;
    let cl:i32=0;
    br_reg_text(reg,ci,&co,&cl);
    let ar:[]u8=br_reg_arena(reg);
    br_tokenize(ctp,ar[co..co+cl],cl);
    let s:i32=prov_score2(qtp,ctp,qn,df,f0,f1,nclaims,fok,frun);
    br_tok_free(ctp);
    return s;
}
fn prov_select(reg:*BrReg, qnrm:[]u8, qlen:i32, cite:*i32, cscore:*i32, crun:*i32, cent:*i32) void {
    cite.*=-1;
    cscore.*=0;
    crun.*=0;
    cent.*=0;
    let c0:i32=0;
    let c1:i32=qlen;
    let pre:[]u8="how do you know ";
    if(qlen>=16){
        let pm:i32=1;
        let k:i32=0;
        while(k<16){
            if(qnrm[k]!=pre[k]){ pm=0; }
            k=k+1;
        }
        if(pm==1){ c0=16; }
    }
    let suf:[]u8=" cite the teaching episode";
    if(c1-c0>=26){
        let t0:i32=c1-26;
        let sm:i32=1;
        let k2:i32=0;
        while(k2<26){
            if(qnrm[t0+k2]!=suf[k2]){ sm=0; }
            k2=k2+1;
        }
        if(sm==1){ c1=t0; }
    }
    let qt:BrTok=br_tok_new(64,2048);
    let qtp:*BrTok=&qt;
    let qn:i32=br_tokenize(qtp,qnrm[c0..c1],c1-c0);
    if(qn<=0){
        br_tok_free(qtp);
        return;
    }
    let f0:i32=1;
    let f1:i32=qn;
    let fi:i32=0;
    let found:i32=0;
    let isw:[]u8="is";
    while(fi<qn && found==0){
        if(prov_tok_is(qtp,fi,isw,2)==1){
            f0=fi+1;
            f1=qn;
            found=1;
        }
        fi=fi+1;
    }
    if(found==0){
        fi=0;
        let sw:[]u8="s";
        while(fi<qn && found==0){
            if(prov_tok_is(qtp,fi,sw,1)==1){
                f0=fi+1;
                f1=qn;
                found=1;
            }
            fi=fi+1;
        }
    }
    let nclaims:i32=br_reg_n(reg);
    let df:[]u8=nio_alloc(512);
    let qi:i32=0;
    while(qi<qn){
        br_put32(df,qi*4,prov_df(reg,qtp,qi));
        qi=qi+1;
    }
    let sc:[]u8=nio_alloc(512);
    let fk:[]u8=nio_alloc(512);
    let rn:[]u8=nio_alloc(512);
    let ci:i32=0;
    while(ci<nclaims){
        let fo:i32=0;
        let ru:i32=0;
        let s:i32=prov_cand_score(qtp,reg,ci,qn,df,f0,f1,nclaims,&fo,&ru);
        br_put32(sc,ci*4,s);
        br_put32(fk,ci*4,fo);
        br_put32(rn,ci*4,ru);
        ci=ci+1;
    }
    let tried:[]u8=nio_alloc(64);
    let ti:i32=0;
    while(ti<nclaims){
        tried[ti]=0;
        ti=ti+1;
    }
    let done:i32=0;
    while(done==0){
        let bi:i32=-1;
        let bsv:i32=-1;
        let cj:i32=0;
        while(cj<nclaims){
            if(tried[cj]==0){
                let sv:i32=br_get32(sc,cj*4);
                if(sv>bsv){
                    bsv=sv;
                    bi=cj;
                }
            }
            cj=cj+1;
        }
        if(bi<0){
            done=1;
        } else {
            tried[bi]=1;
            if(br_get32(fk,bi*4)==1){
                cite.*=bi;
                cscore.*=bsv;
                crun.*=br_get32(rn,bi*4);
                cent.*=1;
                done=1;
            }
        }
    }
    nio_free(tried);
    nio_free(rn);
    nio_free(fk);
    nio_free(sc);
    nio_free(df);
    br_tok_free(qtp);
    return;
}
// discriminator gate for retrieval verification: 1 iff the winner contains a
// tied-rarest question content token with matching polarity. Generic — it
// separates grounded retrievals from confabulated ones with no item knowledge.
fn prov_cand_has(ctp:*BrTok, qtp:*BrTok, qn:i32, df:[]u8, wantdf:i32) i32 {
    let cn:i32=ctp.*.n;
    let qi:i32=0;
    while(qi<qn){
        if(br_get32(df,qi*4)==wantdf && prov_tok_stop(qtp,qi)==0){
            let qp:i32=prov_tok_neg(qtp,qi);
            let j:i32=0;
            while(j<cn){
                if(br_weq(qtp,qi,ctp,j)==1 && prov_tok_neg(ctp,j)==qp){ return 1; }
                j=j+1;
            }
        }
        qi=qi+1;
    }
    return 0;
}
fn disc_gate(reg:*BrReg, qtp:*BrTok, qn:i32, ci:i32) i32 {
    let df:[]u8=nio_alloc(512);
    let bestdf:i32=999999;
    let qi:i32=0;
    while(qi<qn){
        let d:i32=prov_df(reg,qtp,qi);
        br_put32(df,qi*4,d);
        if(prov_tok_stop(qtp,qi)==0 && d>=1 && d<bestdf){ bestdf=d; }
        qi=qi+1;
    }
    if(bestdf==999999){
        nio_free(df);
        return 0;
    }
    let ct:BrTok=br_tok_new(192,8192);
    let ctp:*BrTok=&ct;
    let co:i32=0;
    let cl:i32=0;
    br_reg_text(reg,ci,&co,&cl);
    let ar:[]u8=br_reg_arena(reg);
    br_tokenize(ctp,ar[co..co+cl],cl);
    let ok:i32=prov_cand_has(ctp,qtp,qn,df,bestdf);
    br_tok_free(ctp);
    nio_free(df);
    return ok;
}
// occupied slow-tier entry count. Deliberate mode allocates slow slots
// first-free and never frees, so entries are contiguous from 0 and this count
// is the correct scan bound (capacity is not).
fn psm_slow_occupied(pp:*Psm) i32 {
    let ns:i32=psm_ns(pp);
    let occ:i32=0;
    let si:i32=0;
    while(si<ns){
        let sid:i32=0;
        let sop:i32=0;
        let spar:i32=0;
        let conf:i32=0;
        if(psm_slow_get(pp,si,&sid,&sop,&spar,&conf)==1){ occ=occ+1; }
        si=si+1;
    }
    return occ;
}

// ---------------- probe answering (Pattern D: which) ----------------
fn answer_which(out:[]u8, pos:*i32, reg:*BrReg, pp:*Psm, ep:*EpTab,
                bseq:*i32, phase:i32, pid:[]u8, pidn:i32,
                qraw:[]u8, qlen:i32, nbuf:[]u8, nbuf2:[]u8) void {
    let nql:i32=br_norm(qraw,qlen,nbuf);
    let best:i32=0; let bscore:i32=0; let brun:i32=0;
    retrieve(reg,nbuf[0..nql],nql,&best,&bscore,&brun);
    let ans:[]u8=nio_alloc(64);
    let al:i32=0;
    if(best<0){
        ans[0]=78; ans[1]=79; ans[2]=45; ans[3]=65; ans[4]=78; ans[5]=83;
        ans[6]=87; ans[7]=69; ans[8]=82; al=9; // NO-ANSWER
    } else {
        let ei:i32=ep_by_dense(ep,best);
        let lo:i32=0; let ll:i32=0;
        ept_lab(ep,ei,&lo,&ll);
        let la:[]u8=ep.*.labarena;
        al=title_case(la[lo..lo+ll],ll,ans);
        // verify only if the top retrieval is anchored on the question's
        // rarest content (discriminator gate); a wrong retrieval must not
        // earn verification credit
        let qt2:BrTok=br_tok_new(96,2048);
        let qtp2:*BrTok=&qt2;
        let qn2:i32=br_tokenize(qtp2,nbuf[0..nql],nql);
        let vg:i32=disc_gate(reg,qtp2,qn2,best);
        br_tok_free(qtp2);
        psm_observe(pp,best,1,br_reg_slot(reg,best),1,vg);
    }
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase);
    e_put(out,pos,"\t");
    e_put(out,pos,pid[0..pidn]);
    e_put(out,pos,"\tGEN\tcand=retrieval-top1\tscore=");
    e_i32(out,pos,bscore);
    e_put(out,pos,"\trun=");
    e_i32(out,pos,brun);
    e_put(out,pos,"\tdense=");
    e_i32(out,pos,best);
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase);
    e_put(out,pos,"\t");
    e_put(out,pos,pid[0..pidn]);
    e_put(out,pos,"\tARGMAX\tanswer=");
    e_put(out,pos,ans[0..al]);
    e_nl(out,pos);
    e_put(out,pos,"ANS\t");
    e_i32(out,pos,phase);
    e_put(out,pos,"\t");
    e_put(out,pos,pid[0..pidn]);
    e_put(out,pos,"\t");
    e_put(out,pos,ans[0..al]);
    e_put(out,pos,"\t");
    e_i32(out,pos,best);
    e_put(out,pos,"\t");
    e_i32(out,pos,bscore);
    e_put(out,pos,"\t");
    e_i32(out,pos,brun);
    e_nl(out,pos);
    nio_free(ans);
    return;
}

// ---------------- provenance answering ----------------
fn answer_prov(out:[]u8, pos:*i32, reg:*BrReg, sp:*StStore, pp:*Psm, ep:*EpTab,
               pvid:[]u8, pvidn:i32, qraw:[]u8, qlen:i32, nbuf:[]u8) void {
    let nql:i32=br_norm(qraw,qlen,nbuf);
    // §7(c) entailment: cite only a candidate whose text actually supports the
    // claim; a cited candidate counts as a verified retrieval for the PSM.
    let cite:i32=-1;
    let cs:i32=0;
    let cr:i32=0;
    let ce:i32=0;
    prov_select(reg,nbuf[0..nql],nql,&cite,&cs,&cr,&ce);
    let citeb:[]u8=nio_alloc(32);
    let cl:i32=0;
    let chain:i32=0; let live:i32=0; let vm:i32=0;
    if(cite<0){
        citeb[0]=78; citeb[1]=79; citeb[2]=78; citeb[3]=69; cl=4; // NONE
    } else {
        let ei:i32=ep_by_dense(ep,cite);
        let eo:i32=0; let el:i32=0;
        ept_epid(ep,ei,&eo,&el);
        let ia:[]u8=ep.*.idarena;
        let k:i32=0;
        while(k<el){ citeb[k]=ia[eo+k]; k=k+1; }
        cl=el;
        psm_observe(pp,cite,1,br_reg_slot(reg,cite),1,1);
        let s:i32=ept_slot(ep,ei);
        live=st_slot_live(sp,s);
        let vv:i32=st_slot_value(sp,s);
        if(vv==ept_claim(ep,ei)){ vm=1; }
        if(live==1 && vm==1){ chain=1; }
    }
    e_put(out,pos,"PROV\t");
    e_put(out,pos,pvid[0..pvidn]);
    e_put(out,pos,"\t");
    e_put(out,pos,citeb[0..cl]);
    e_put(out,pos,"\t");
    e_i32(out,pos,cite);
    e_nl(out,pos);
    e_put(out,pos,"PROVCHECK\t");
    e_put(out,pos,pvid[0..pvidn]);
    e_put(out,pos,"\tchain=");
    e_i32(out,pos,chain);
    e_put(out,pos,"\tlive=");
    e_i32(out,pos,live);
    e_put(out,pos,"\tvaluematch=");
    e_i32(out,pos,vm);
    e_put(out,pos,"\tentail=");
    e_i32(out,pos,ce);
    e_nl(out,pos);
    nio_free(citeb);
    return;
}

// ---------------- superordinate info ----------------
struct SupInfo {
    slot: i32,
    siglen: i32,
    sig: []u8,
    nlab: i32,
    laboff: []u8,
    lablen: []u8,
    labarena: []u8
}
fn sup_new() SupInfo {
    return SupInfo{.slot=-1,.siglen=0,.sig=nio_alloc(64),.nlab=0,
        .laboff=nio_alloc(32),.lablen=nio_alloc(32),.labarena=nio_alloc(512)};
}

// ---------------- Pattern A deliberation ----------------
fn delib_a(out:[]u8, pos:*i32, reg:*BrReg, ep:*EpTab, bseq:*i32, sup:*SupInfo,
           itemid:[]u8, itemidn:i32, phase:i32,
           ev:[]u8, evlen:i32, cat:[]u8, catlen:i32, x:[]u8, xlen:i32,
           ans:[]u8) i32 {
    // category head = first word of CAT, stemmed
    let cw:i32=0;
    while(cw<catlen && cat[cw]!=32){ cw=cw+1; }
    let chb:[]u8=nio_alloc(64);
    let k:i32=0;
    while(k<cw){ chb[k]=cat[k]; k=k+1; }
    let chl:i32=br_stem_ip(chb,0,cw);
    let et:BrTok=br_tok_new(160,4096); let etp:*BrTok=&et;
    br_tokenize(etp,ev,evlen);
    let c1:BrTok=br_tok_new(4,64); let c1p:*BrTok=&c1;
    br_tokenize(c1p,chb,chl);
    let support:i32=br_c_contains(etp,c1p,0);
    // superordinate consultation
    let consulted:i32=0; let member:i32=0;
    if(sup.*.slot>=0){
        let st2:BrTok=br_tok_new(4,64); let st2p:*BrTok=&st2;
        br_tokenize(st2p,sup.*.sig,sup.*.siglen);
        if(br_weq(st2p,0,c1p,0)==1){
            consulted=1;
            let note:[]u8=nio_alloc(64);
            let nn:i32=0;
            let kk:i32=0;
            while(kk<itemidn){ note[kk]=itemid[kk]; kk=kk+1; }
            breg_emit(out,pos,bseq,"DELIB_REF",phase,0,-1,sup.*.slot,note[0..kk]);
            nio_free(note);
            let xt:BrTok=br_tok_new(32,512); let xtp:*BrTok=&xt;
            let xn:i32=br_tokenize(xtp,x,xlen);
            let li:i32=0;
            while(li<sup.*.nlab && member==0){
                let lo2:i32=br_get32(sup.*.laboff,li*4);
                let ll2:i32=br_get32(sup.*.lablen,li*4);
                let la2:[]u8=sup.*.labarena;
                let lt:BrTok=br_tok_new(16,256); let ltp:*BrTok=&lt;
                br_tokenize(ltp,la2[lo2..lo2+ll2],ll2);
                let xi:i32=0;
                while(xi<xn && member==0){
                    let xo:i32=0; let xl:i32=0;
                    br_tok_word(xtp,xi,&xo,&xl);
                    if(xl>=3 && br_c_contains(ltp,xtp,xi)==1){ member=1; }
                    xi=xi+1;
                }
                br_tok_free(ltp);
                li=li+1;
            }
            br_tok_free(xtp);
        }
        br_tok_free(st2p);
    }
    let yes:i32=0;
    if(support==1 || member==1){ yes=1; }
    let al:i32=0;
    if(yes==1){ ans[0]=89; ans[1]=69; ans[2]=83; al=3; }
    if(yes==0){ ans[0]=78; ans[1]=79; al=2; }
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tGEN\tcands=YES,NO");
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tEVID\tcat_head=");
    e_put(out,pos,chb[0..chl]);
    e_put(out,pos,"\tsupport=");
    e_i32(out,pos,support);
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tSUPER\tconsulted=");
    e_i32(out,pos,consulted);
    e_put(out,pos,"\tmember=");
    e_i32(out,pos,member);
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    if(yes==1){
        e_put(out,pos,"\tELIM\tout=NO\treason=support-present");
    } else {
        e_put(out,pos,"\tELIM\tout=YES\treason=no-support:cat-head-absent;not-super-member");
    }
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tARGMAX\tanswer=");
    e_put(out,pos,ans[0..al]);
    e_nl(out,pos);
    nio_free(chb);
    br_tok_free(etp); br_tok_free(c1p);
    return al;
}

// ---------------- Pattern B deliberation ----------------
fn delib_b(out:[]u8, pos:*i32,
           itemid:[]u8, itemidn:i32, phase:i32,
           ev:[]u8, evlen:i32, v:[]u8, vlen:i32, ans:[]u8) i32 {
    let vb:[]u8=nio_alloc(64);
    let k:i32=0;
    while(k<vlen){ vb[k]=v[k]; k=k+1; }
    let vl:i32=br_stem_ip(vb,0,vlen);
    let et:BrTok=br_tok_new(160,4096); let etp:*BrTok=&et;
    br_tokenize(etp,ev,evlen);
    let v1:BrTok=br_tok_new(4,64); let v1p:*BrTok=&v1;
    br_tokenize(v1p,vb,vl);
    let support:i32=br_c_contains(etp,v1p,0);
    let al:i32=0;
    if(support==1){ ans[0]=89; ans[1]=69; ans[2]=83; al=3; }
    if(support==0){ ans[0]=78; ans[1]=79; al=2; }
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tGEN\tcands=YES,NO");
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tEVID\tverb=");
    e_put(out,pos,vb[0..vl]);
    e_put(out,pos,"\tsupport=");
    e_i32(out,pos,support);
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    if(support==1){
        e_put(out,pos,"\tELIM\tout=NO\treason=verb-affirmed-in-context");
    } else {
        e_put(out,pos,"\tELIM\tout=YES\treason=verb-absent-from-context(closed-world)");
    }
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tARGMAX\tanswer=");
    e_put(out,pos,ans[0..al]);
    e_nl(out,pos);
    nio_free(vb);
    br_tok_free(etp); br_tok_free(v1p);
    return al;
}

// ---------------- Pattern C helpers ----------------
fn is_negator(t:*BrTok, wi:i32) i32 {
    let o:i32=0; let l:i32=0;
    br_tok_word(t,wi,&o,&l);
    let a:[]u8=t.*.arena;
    if(l==2 && a[o]==110 && a[o+1]==111){ return 1; } // no
    if(l==3 && a[o]==110 && a[o+1]==111 && a[o+2]==116){ return 1; } // not
    if(l==5 && a[o]==110 && a[o+1]==101 && a[o+2]==118 && a[o+3]==101 && a[o+4]==114){ return 1; } // never
    if(l==7 && a[o]==119 && a[o+1]==105 && a[o+2]==116 && a[o+3]==104 && a[o+4]==111 && a[o+5]==117 && a[o+6]==116){ return 1; } // without
    return 0;
}
// does sdef affirmatively contain obs word xi? (present and not negator-guarded)
fn sdef_affirms(sdef:*BrTok, obs:*BrTok, xi:i32) i32 {
    let n2:i32=sdef.*.n;
    let has:i32=0; let negated:i32=0;
    let j:i32=0;
    while(j<n2){
        if(br_weq(obs,xi,sdef,j)==1){
            has=1;
            if(j>0 && is_negator(sdef,j-1)==1){ negated=1; }
        }
        j=j+1;
    }
    if(has==1 && negated==0){ return 1; }
    return 0;
}
fn find_contradiction(obs:*BrTok, sdef:*BrTok) i32 {
    let n3:i32=obs.*.n;
    let i:i32=0;
    let hit:i32=0;
    while(i+1<n3 && hit==0){
        if(is_negator(obs,i)==1){
            if(sdef_affirms(sdef,obs,i+1)==1){ hit=1; }
        }
        i=i+1;
    }
    return hit;
}
// rarest P word with df>=1 (index into ptok), or -1
fn keyterm_rarest(reg:*BrReg, ptok:*BrTok) i32 {
    let nclaims:i32=br_reg_n(reg);
    let pn:i32=ptok.*.n;
    let best:i32=-1; let bestdf:i32=999999;
    let ct:BrTok=br_tok_new(192,8192); let ctp:*BrTok=&ct;
    let pi:i32=0;
    while(pi<pn){
        let df:i32=0;
        let ci:i32=0;
        while(ci<nclaims){
            let co:i32=0; let cl:i32=0;
            br_reg_text(reg,ci,&co,&cl);
            let ar:[]u8=br_reg_arena(reg);
            br_tokenize(ctp,ar[co..co+cl],cl);
            df=df+br_c_contains(ctp,ptok,pi);
            ci=ci+1;
        }
        if(df>=1 && df<bestdf){ bestdf=df; best=pi; }
        pi=pi+1;
    }
    br_tok_free(ctp);
    return best;
}
// copy stemmed word wi of t into dst; returns len
fn tok_copy_word(t:*BrTok, wi:i32, dst:[]u8) i32 {
    let o:i32=0; let l:i32=0;
    br_tok_word(t,wi,&o,&l);
    let a:[]u8=t.*.arena;
    let k:i32=0;
    while(k<l){ dst[k]=a[o+k]; k=k+1; }
    return l;
}
// does token table t contain stemmed word w[wl]?
fn tok_contains_word(t:*BrTok, w:[]u8, wl:i32) i32 {
    let s:BrTok=br_tok_new(4,64); let sp2:*BrTok=&s;
    br_tokenize(sp2,w,wl);
    let r:i32=br_c_contains(t,sp2,0);
    br_tok_free(sp2);
    return r;
}
// next sentence from q at *ppos ('.'/'?'/'!' terminated); 0 when done
fn sent_next(q:[]u8, qlen:i32, ppos:*i32, s0:*i32, s1:*i32) i32 {
    let p:i32=ppos.*;
    let ok:i32=0;
    while(ok==0){
        while(p<qlen && q[p]==32){ p=p+1; }
        if(p>=qlen){ ppos.*=p; return 0; }
        let a:i32=p;
        while(p<qlen && q[p]!=46 && q[p]!=63 && q[p]!=33){ p=p+1; }
        let b:i32=p;
        if(p<qlen){ p=p+1; }
        while(b>a && q[b-1]==32){ b=b-1; }
        if(b>a){ s0.*=a; s1.*=b; ppos.*=p; ok=1; }
    }
    return 1;
}

// ---------------- Pattern C deliberation ("could it be") ----------------
fn delib_c(out:[]u8, pos:*i32, reg:*BrReg, ep:*EpTab, pp:*Psm, bseq:*i32,
           itemid:[]u8, itemidn:i32, phase:i32,
           obs:[]u8, obslen:i32, pint:[]u8, pinlen:i32, ans:[]u8) i32 {
    let p0:i32=0; let p1:i32=0;
    let al:i32=0;
    if(qc_parts(pint,pinlen,&p0,&p1)==0){
        ans[0]=85; ans[1]=78; ans[2]=67; ans[3]=76; ans[4]=65; ans[5]=83;
        ans[6]=83; ans[7]=73; ans[8]=70; ans[9]=73; ans[10]=69; ans[11]=68;
        return 12; // UNCLASSIFIED
    }
    // subject query: NAME ("a <N> s ...") else METHOD ("with a <M>") else P
    let q0:i32=p0; let q1:i32=p1; let qk:i32=0;
    let s2:i32=-1;
    if(p1-p0>2 && pint[p0]==97 && pint[p0+1]==32){ s2=p0+2; }
    if(s2<0 && p1-p0>3 && pint[p0]==97 && pint[p0+1]==110 && pint[p0+2]==32){ s2=p0+3; }
    if(s2>=0){
        let fi2:i32=s2; let f2:i32=-1;
        while(fi2+3<=p1 && f2<0){
            if(pint[fi2]==32 && pint[fi2+1]==115 && pint[fi2+2]==32){ f2=fi2; }
            fi2=fi2+1;
        }
        if(f2>0){ q0=s2; q1=f2; qk=1; }
    }
    if(qk==0){
        let mi:i32=p0; let mf:i32=-1; let ml:i32=0;
        while(mi+7<=p1 && mf<0){
            if(pint[mi]==119 && pint[mi+1]==105 && pint[mi+2]==116 && pint[mi+3]==104
               && pint[mi+4]==32 && pint[mi+5]==97 && pint[mi+6]==32){ mf=mi; ml=7; }
            mi=mi+1;
        }
        if(mf<0){
            mi=p0;
            while(mi+8<=p1 && mf<0){
                if(pint[mi]==119 && pint[mi+1]==105 && pint[mi+2]==116 && pint[mi+3]==104
                   && pint[mi+4]==32 && pint[mi+5]==97 && pint[mi+6]==110 && pint[mi+7]==32){ mf=mi; ml=8; }
                mi=mi+1;
            }
        }
        if(mf>=0){ q0=mf+ml; q1=p1; qk=2; }
    }
    let best:i32=-1; let bscore:i32=0; let brun:i32=0;
    retrieve(reg,pint[q0..q1],q1-q0,&best,&bscore,&brun);
    let ot:BrTok=br_tok_new(96,2048); let otp:*BrTok=&ot;
    br_tokenize(otp,obs,obslen);
    let pt:BrTok=br_tok_new(64,1024); let ptp:*BrTok=&pt;
    br_tokenize(ptp,pint[p0..p1],p1-p0);
    let contra:i32=0;
    if(best>=0){
        let co:i32=0; let cl:i32=0;
        br_reg_text(reg,best,&co,&cl);
        let ar:[]u8=br_reg_arena(reg);
        let sd:BrTok=br_tok_new(192,8192); let sdp:*BrTok=&sd;
        br_tokenize(sdp,ar[co..co+cl],cl);
        contra=find_contradiction(otp,sdp);
        // verify only if the subject retrieval is discriminator-anchored
        let st2:BrTok=br_tok_new(96,2048);
        let stp2:*BrTok=&st2;
        let sn2:i32=br_tokenize(stp2,pint[q0..q1],q1-q0);
        let vg2:i32=disc_gate(reg,stp2,sn2,best);
        br_tok_free(stp2);
        psm_observe(pp,best,1,br_reg_slot(reg,best),1,vg2);
        br_tok_free(sdp);
    }
    let kt:i32=keyterm_rarest(reg,ptp);
    let ktin:i32=0;
    if(kt>=0){ ktin=br_c_contains(otp,ptp,kt); }
    ans[0]=78; ans[1]=79; al=2; // NO (closed-world; traces distinguish the test)
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tGEN\tcands=YES,NO\tqkind=");
    e_i32(out,pos,qk);
    e_put(out,pos,"\tsubj_dense=");
    e_i32(out,pos,best);
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tEVID\tcontradiction=");
    e_i32(out,pos,contra);
    e_put(out,pos,"\tkeyterm_in_obs=");
    e_i32(out,pos,ktin);
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    if(contra==1){
        e_put(out,pos,"\tELIM\tout=YES\treason=contradiction:obs-negation-affirmed-by-def");
    } else {
        if(ktin==0){
            e_put(out,pos,"\tELIM\tout=YES\treason=keyterm-absent-from-obs(closed-world)");
        } else {
            e_put(out,pos,"\tELIM\tout=YES\treason=closed-world-default");
        }
    }
    e_nl(out,pos);
    e_put(out,pos,"TRACE\t");
    e_i32(out,pos,phase); e_put(out,pos,"\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\tARGMAX\tanswer=NO");
    e_nl(out,pos);
    br_tok_free(otp); br_tok_free(ptp);
    return al;
}

// ---------------- distinctive shared-token count for a label group ----------------
fn distinctive_count(ep:*EpTab, reg:*BrReg, ph:i32, mem:[]u8, nmem:i32,
                     loff:[]u8, llen:[]u8) i32 {
    let geps:[]u8=nio_alloc(128);
    let ngep:i32=0;
    let ne:i32=ept_n(ep);
    let ei4:i32=0;
    while(ei4<ne){
        if(ept_phase(ep,ei4)==ph){
            let o:i32=0; let l:i32=0;
            ept_lab(ep,ei4,&o,&l);
            let mi:i32=0; let hit:i32=0;
            while(mi<nmem && hit==0){
                let li7:i32=br_get32(mem,mi*4);
                let oo:i32=br_get32(loff,li7*4); let ll:i32=br_get32(llen,li7*4);
                if(ll==l){
                    let la3:[]u8=ep.*.labarena;
                    let k6:i32=0; let eq:i32=1;
                    while(k6<l){ if(la3[oo+k6]!=la3[o+k6]){ eq=0; } k6=k6+1; }
                    if(eq==1){ hit=1; }
                }
                mi=mi+1;
            }
            if(hit==1){ br_put32(geps,ngep*4,ei4); ngep=ngep+1; }
        }
        ei4=ei4+1;
    }
    let seen:[]u8=nio_alloc(4096);
    let seeno:[]u8=nio_alloc(512); let seenl:[]u8=nio_alloc(512);
    let nseen:i32=0; let spos:i32=0;
    let wbuf:[]u8=nio_alloc(64);
    let dist:i32=0;
    let nclaims:i32=br_reg_n(reg);
    let gi3:i32=0;
    while(gi3<ngep){
        let ei5:i32=br_get32(geps,gi3*4);
        let fo:i32=0; let fl:i32=0;
        ept_fact(ep,ei5,&fo,&fl);
        let fa2:[]u8=ep.*.factarena;
        let ft:BrTok=br_tok_new(96,2048); let ftp:*BrTok=&ft;
        let fn2:i32=br_tokenize(ftp,fa2[fo..fo+fl],fl);
        let wi:i32=0;
        while(wi<fn2){
            let wl2:i32=tok_copy_word(ftp,wi,wbuf);
            let si2:i32=0; let dup2:i32=0;
            while(si2<nseen && dup2==0){
                let so3:i32=br_get32(seeno,si2*4); let sl3:i32=br_get32(seenl,si2*4);
                if(sl3==wl2){
                    let k7:i32=0; let eq2:i32=1;
                    while(k7<wl2){ if(seen[so3+k7]!=wbuf[k7]){ eq2=0; } k7=k7+1; }
                    if(eq2==1){ dup2=1; }
                }
                si2=si2+1;
            }
            if(dup2==0){
                let k8:i32=0;
                while(k8<wl2){ seen[spos+k8]=wbuf[k8]; k8=k8+1; }
                br_put32(seeno,nseen*4,spos); br_put32(seenl,nseen*4,wl2);
                spos=spos+wl2; nseen=nseen+1;
                // ep_c: group episodes containing w
                let epc:i32=0;
                let gj:i32=0;
                while(gj<ngep){
                    let ej2:i32=br_get32(geps,gj*4);
                    let fo2:i32=0; let fl2:i32=0;
                    ept_fact(ep,ej2,&fo2,&fl2);
                    let gt:BrTok=br_tok_new(96,2048); let gtp:*BrTok=&gt;
                    br_tokenize(gtp,fa2[fo2..fo2+fl2],fl2);
                    epc=epc+tok_contains_word(gtp,wbuf,wl2);
                    br_tok_free(gtp);
                    gj=gj+1;
                }
                // lab_c: group labels containing w
                let labc:i32=0;
                let mj:i32=0;
                while(mj<nmem){
                    let lj:i32=br_get32(mem,mj*4);
                    let lo4:i32=br_get32(loff,lj*4); let ll4:i32=br_get32(llen,lj*4);
                    let la6:[]u8=ep.*.labarena;
                    let lt2:BrTok=br_tok_new(16,256); let lt2p:*BrTok=&lt2;
                    br_tokenize(lt2p,la6[lo4..lo4+ll4],ll4);
                    labc=labc+tok_contains_word(lt2p,wbuf,wl2);
                    br_tok_free(lt2p);
                    mj=mj+1;
                }
                // df: all claims containing w
                let df:i32=0;
                let cj:i32=0;
                let ctt:BrTok=br_tok_new(192,8192); let cttp:*BrTok=&ctt;
                while(cj<nclaims){
                    let co2:i32=0; let cl2:i32=0;
                    br_reg_text(reg,cj,&co2,&cl2);
                    let ar2:[]u8=br_reg_arena(reg);
                    br_tokenize(cttp,ar2[co2..co2+cl2],cl2);
                    df=df+tok_contains_word(cttp,wbuf,wl2);
                    cj=cj+1;
                }
                br_tok_free(cttp);
                if(epc>=2 && labc>=2 && df<=4){ dist=dist+1; }
            }
            wi=wi+1;
        }
        br_tok_free(ftp);
        gi3=gi3+1;
    }
    nio_free(geps); nio_free(seen); nio_free(seeno); nio_free(seenl); nio_free(wbuf);
    return dist;
}

// ---------------- PSM field accessors (route main-local access through helpers) ----------------
fn psm_nf(pp:*Psm) i32 { return pp.*.nf; }
fn psm_ns(pp:*Psm) i32 { return pp.*.ns; }
fn psm_nconsol(pp:*Psm) i32 { return pp.*.n_consol; }
fn tsv_nrows(t:*BrTsv) i32 { return t.*.nrows; }
fn sup_slot(s:*SupInfo) i32 { return s.*.slot; }

// ---------------- deliberate consolidation pass ----------------
fn consolidate_pass(out:[]u8, pos:*i32, pp:*Psm, sp:*StStore, reg:*BrReg,
                    bseq:*i32, sdone:*i32, phase:i32) void {
    st_set_stage(sp,ST_STAGE_MANAGE);
    let nf:i32=psm_nf(pp);
    let fi:i32=0;
    while(fi<nf){
        let used:i32=0; let id:i32=0; let ver:i32=0; let prom:i32=0;
        psm_fast_inspect(pp,fi,&used,&id,&ver,&prom);
        if(used==1 && ver>=1 && prom==0){
            psm_consolidate(pp,fi);
            let u2:i32=0; let id2:i32=0; let v2:i32=0; let p2:i32=0;
            psm_fast_inspect(pp,fi,&u2,&id2,&v2,&p2);
            e_put(out,pos,"CONS_EVAL\t");
            e_i32(out,pos,phase); e_put(out,pos,"\t");
            e_i32(out,pos,fi); e_put(out,pos,"\tdense=");
            e_i32(out,pos,id); e_put(out,pos,"\tver=");
            e_i32(out,pos,ver); e_put(out,pos,"\tstate=");
            e_i32(out,pos,p2);
            e_nl(out,pos);
        }
        fi=fi+1;
    }
    let occ:i32=psm_slow_occupied(pp);
    let si:i32=sdone.*;
    while(si<occ){
        let sid:i32=0; let sop:i32=0; let spar:i32=0; let conf:i32=0;
        let ok:i32=psm_slow_get(pp,si,&sid,&sop,&spar,&conf);
        if(ok==1){
            let rc2:i32=st_promote(sp,spar);
            breg_emit(out,pos,bseq,"PROM",phase,br_reg_claim(reg,sid),sid,spar,"consolidate");
            e_put(out,pos,"CONS\t");
            e_i32(out,pos,phase); e_put(out,pos,"\t");
            e_i32(out,pos,si); e_put(out,pos,"\tdense=");
            e_i32(out,pos,sid); e_put(out,pos,"\tslot=");
            e_i32(out,pos,spar); e_put(out,pos,"\tconf=");
            e_i32(out,pos,conf); e_put(out,pos,"\trc=");
            e_i32(out,pos,rc2);
            e_nl(out,pos);
        }
        si=si+1;
    }
    sdone.*=occ;
    return;
}

// ---------------- formation deliberation (deliberate superordinate) ----------------
fn formation_pass(out:[]u8, pos:*i32, reg:*BrReg, sp:*StStore, ep:*EpTab,
                  bseq:*i32, sup:*SupInfo) void {
    let ph:i32=1;
    let formed:i32=0;
    while(ph<=2 && formed==0){
        let loff:[]u8=nio_alloc(32); let llen:[]u8=nio_alloc(32);
        let nlab:i32=0;
        let ne:i32=ept_n(ep);
        let ei3:i32=0;
        while(ei3<ne){
            if(ept_phase(ep,ei3)==ph){
                let o:i32=0; let l:i32=0;
                ept_lab(ep,ei3,&o,&l);
                let la:[]u8=ep.*.labarena;
                let li3:i32=0; let dup:i32=0;
                while(li3<nlab && dup==0){
                    let oo:i32=br_get32(loff,li3*4); let ll:i32=br_get32(llen,li3*4);
                    if(ll==l){
                        let k:i32=0; let eq:i32=1;
                        while(k<l){ if(la[oo+k]!=la[o+k]){ eq=0; } k=k+1; }
                        if(eq==1){ dup=1; }
                    }
                    li3=li3+1;
                }
                if(dup==0){ br_put32(loff,nlab*4,o); br_put32(llen,nlab*4,l); nlab=nlab+1; }
            }
            ei3=ei3+1;
        }
        let parent:[]u8=nio_alloc(32);
        let pi4:i32=0;
        while(pi4<nlab){ br_put32(parent,pi4*4,pi4); pi4=pi4+1; }
        let psig:[]u8=nio_alloc(2048);
        let psigo:[]u8=nio_alloc(128); let psigl:[]u8=nio_alloc(128);
        let paa:[]u8=nio_alloc(128); let pbb:[]u8=nio_alloc(128);
        let npair:i32=0;
        let wbuf2:[]u8=nio_alloc(64);
        let a4:i32=0;
        while(a4<nlab && npair<32){
            let b4:i32=a4+1;
            while(b4<nlab && npair<32){
                let ao:i32=br_get32(loff,a4*4); let al2:i32=br_get32(llen,a4*4);
                let bo:i32=br_get32(loff,b4*4); let bl2:i32=br_get32(llen,b4*4);
                let laa:[]u8=ep.*.labarena;
                let ta:BrTok=br_tok_new(16,256); let tap:*BrTok=&ta;
                br_tokenize(tap,laa[ao..ao+al2],al2);
                let tb:BrTok=br_tok_new(16,256); let tbp:*BrTok=&tb;
                br_tokenize(tbp,laa[bo..bo+bl2],bl2);
                let tan:i32=ta.n; let tbn:i32=tb.n;
                let bestl:i32=0; let bwa:i32=-1;
                let wa:i32=0;
                while(wa<tan){
                    let wb:i32=0;
                    while(wb<tbn){
                        if(br_weq(tap,wa,tbp,wb)==1){
                            let wl3:i32=tok_copy_word(tap,wa,wbuf2);
                            if(wl3>=4 && wl3>bestl){ bestl=wl3; bwa=wa; }
                        }
                        wb=wb+1;
                    }
                    wa=wa+1;
                }
                if(bwa>=0){
                    let ra:i32=a4;
                    while(br_get32(parent,ra*4)!=ra){ ra=br_get32(parent,ra*4); }
                    let rb:i32=b4;
                    while(br_get32(parent,rb*4)!=rb){ rb=br_get32(parent,rb*4); }
                    if(ra!=rb){ br_put32(parent,rb*4,ra); }
                    let so2:i32=npair*64;
                    let wl4:i32=tok_copy_word(tap,bwa,wbuf2);
                    let k4:i32=0;
                    while(k4<wl4){ psig[so2+k4]=wbuf2[k4]; k4=k4+1; }
                    br_put32(psigo,npair*4,so2);
                    br_put32(psigl,npair*4,wl4);
                    br_put32(paa,npair*4,a4);
                    br_put32(pbb,npair*4,b4);
                    npair=npair+1;
                }
                br_tok_free(tap); br_tok_free(tbp);
                b4=b4+1;
            }
            a4=a4+1;
        }
        nio_free(wbuf2);
        let gr:[]u8=nio_alloc(32); let gn:i32=0;
        let li5:i32=0;
        while(li5<nlab){
            let r5:i32=li5;
            while(br_get32(parent,r5*4)!=r5){ r5=br_get32(parent,r5*4); }
            let gi:i32=0; let gf:i32=-1;
            while(gi<gn){ if(br_get32(gr,gi*4)==r5){ gf=gi; } gi=gi+1; }
            if(gf<0){ br_put32(gr,gn*4,r5); gn=gn+1; }
            li5=li5+1;
        }
        let gi2:i32=0;
        while(gi2<gn && formed==0){
            let grt:i32=br_get32(gr,gi2*4);
            let mem:[]u8=nio_alloc(32); let nmem:i32=0;
            let li6:i32=0;
            while(li6<nlab){
                let r6:i32=li6;
                while(br_get32(parent,r6*4)!=r6){ r6=br_get32(parent,r6*4); }
                if(r6==grt){ br_put32(mem,nmem*4,li6); nmem=nmem+1; }
                li6=li6+1;
            }
            let sigb:[]u8=nio_alloc(64); let sigl:i32=0;
            let pi5:i32=0;
            while(pi5<npair){
                let pa2:i32=br_get32(paa,pi5*4);
                let ra2:i32=pa2;
                while(br_get32(parent,ra2*4)!=ra2){ ra2=br_get32(parent,ra2*4); }
                if(ra2==grt){
                    let sl5:i32=br_get32(psigl,pi5*4);
                    if(sl5>sigl){
                        sigl=sl5;
                        let so5:i32=br_get32(psigo,pi5*4);
                        let k5:i32=0;
                        while(k5<sl5){ sigb[k5]=psig[so5+k5]; k5=k5+1; }
                    }
                }
                pi5=pi5+1;
            }
            let dist:i32=0;
            if(nmem>=2 && sigl>0){
                dist=distinctive_count(ep,reg,ph,mem,nmem,loff,llen);
            }
            e_put(out,pos,"FORM_EVAL\t");
            e_i32(out,pos,ph); e_put(out,pos,"\tsig=");
            e_put(out,pos,sigb[0..sigl]); e_put(out,pos,"\tnlab=");
            e_i32(out,pos,nmem); e_put(out,pos,"\tdistinctive=");
            e_i32(out,pos,dist);
            e_nl(out,pos);
            if(nmem>=2 && sigl>0){
                formed=1;
                let code:i32=br_fnv(sigb,sigl);
                st_set_stage(sp,3);
                let S:i32=-1;
                let rc:i32=st_add(sp,code,ST_REGION_USER,60,&S);
                if(rc!=0){
                    e_put(out,pos,"FATAL\tst-add-super\n");
                    return;
                }
                let snote:[]u8=nio_alloc(80);
                snote[0]=115; snote[1]=117; snote[2]=112; snote[3]=101; snote[4]=114; snote[5]=58;
                let k9:i32=0;
                while(k9<sigl){ snote[6+k9]=sigb[k9]; k9=k9+1; }
                breg_emit(out,pos,bseq,"DELIB_ADD",ph,code,-1,S,snote[0..6+sigl]);
                nio_free(snote);
                sup.*.slot=S;
                sup.*.siglen=sigl;
                let k10:i32=0;
                while(k10<sigl){ sup.*.sig[k10]=sigb[k10]; k10=k10+1; }
                let slp:i32=0;
                let mi2:i32=0;
                while(mi2<nmem){
                    let li8:i32=br_get32(mem,mi2*4);
                    let oo2:i32=br_get32(loff,li8*4); let ll4:i32=br_get32(llen,li8*4);
                    let la4:[]u8=ep.*.labarena;
                    let sa:[]u8=sup.*.labarena;
                    let k11:i32=0;
                    while(k11<ll4){ sa[slp+k11]=la4[oo2+k11]; k11=k11+1; }
                    br_put32(sup.*.laboff,mi2*4,slp);
                    br_put32(sup.*.lablen,mi2*4,ll4);
                    slp=slp+ll4;
                    mi2=mi2+1;
                }
                sup.*.nlab=nmem;
                let nev:i32=0;
                let mi3:i32=0;
                while(mi3<nmem){
                    let li9:i32=br_get32(mem,mi3*4);
                    let oo3:i32=br_get32(loff,li9*4); let ll5:i32=br_get32(llen,li9*4);
                    let ei6:i32=0; let fs:i32=-1;
                    let ne2:i32=ept_n(ep);
                    while(ei6<ne2 && fs<0){
                        if(ept_phase(ep,ei6)==ph){
                            let o4:i32=0; let l4:i32=0;
                            ept_lab(ep,ei6,&o4,&l4);
                            if(l4==ll5){
                                let la5:[]u8=ep.*.labarena;
                                let k12:i32=0; let eq3:i32=1;
                                while(k12<l4){ if(la5[oo3+k12]!=la5[o4+k12]){ eq3=0; } k12=k12+1; }
                                if(eq3==1){ fs=ept_slot(ep,ei6); }
                            }
                        }
                        ei6=ei6+1;
                    }
                    if(fs>=0){
                        let erc:i32=st_evidence(sp,S,2,fs);
                        e_put(out,pos,"FORM_EVID\t");
                        e_hex8(out,pos,code); e_put(out,pos,"\t");
                        e_i32(out,pos,S); e_put(out,pos,"\t");
                        e_i32(out,pos,fs); e_put(out,pos,"\trc=");
                        e_i32(out,pos,erc);
                        e_nl(out,pos);
                        nev=nev+1;
                    }
                    mi3=mi3+1;
                }
                e_put(out,pos,"FORM\t");
                e_i32(out,pos,ph); e_put(out,pos,"\tsig=");
                e_put(out,pos,sigb[0..sigl]); e_put(out,pos,"\tcode=");
                e_hex8(out,pos,code); e_put(out,pos,"\tslot=");
                e_i32(out,pos,S); e_put(out,pos,"\tnev=");
                e_i32(out,pos,nev); e_put(out,pos,"\tnlab=");
                e_i32(out,pos,nmem); e_put(out,pos,"\tdist=");
                e_i32(out,pos,dist);
                e_nl(out,pos);
            }
            nio_free(mem); nio_free(sigb);
            gi2=gi2+1;
        }
        nio_free(loff); nio_free(llen); nio_free(parent);
        nio_free(psig); nio_free(psigo); nio_free(psigl);
        nio_free(paa); nio_free(pbb); nio_free(gr);
        ph=ph+1;
    }
    if(formed==0){ e_put(out,pos,"FORM\tNONE\n"); }
    return;
}

// ---------------- novelty audit (Phase-4 items) ----------------
fn novelty_audit(out:[]u8, pos:*i32, reg:*BrReg, ep:*EpTab,
                 p4:*BrTsv, p4buf:[]u8, nbuf:[]u8) void {
    let corp:[]u8=nio_alloc(32768);
    let cl:i32=0;
    let ne:i32=ept_n(ep);
    let ei:i32=0;
    while(ei<ne){
        let fo:i32=0; let fl:i32=0;
        ept_fact(ep,ei,&fo,&fl);
        let fa:[]u8=ep.*.factarena;
        let k:i32=0;
        while(k<fl){ corp[cl]=fa[fo+k]; cl=cl+1; k=k+1; }
        corp[cl]=10; cl=cl+1;
        ei=ei+1;
    }
    let nr:i32=p4.*.nrows;
    let ri:i32=0;
    while(ri<nr){
        let d0:i32=0;let d1:i32=0;let q0:i32=0;let q1:i32=0;let c0:i32=0;let c1:i32=0;
        tsv_field(p4,ri,0,&d0,&d1);
        tsv_field(p4,ri,4,&q0,&q1);
        tsv_field(p4,ri,3,&c0,&c1);
        let apass:i32=1; let cpass:i32=1; let dmax:i32=0;
        let sbuf:[]u8=nio_alloc(2048);
        let sl:i32=0;
        let k2:i32=q0;
        while(k2<q0+q1){ sbuf[sl]=p4buf[k2]; sl=sl+1; k2=k2+1; }
        sbuf[sl]=32; sl=sl+1;
        let k3:i32=c0;
        while(k3<c0+c1){ sbuf[sl]=p4buf[k3]; sl=sl+1; k3=k3+1; }
        let pp2:i32=0; let s0:i32=0; let s1:i32=0; let sn:i32=0;
        while(sent_next(sbuf,sl,&pp2,&s0,&s1)==1){
            sn=sn+1;
            let nl:i32=br_norm(sbuf[s0..s1],s1-s0,nbuf);
            if(has_sub(corp,cl,nbuf[0..nl],nl)==1){ apass=0; }
            let h:i32=br_fnv(nbuf,nl);
            let ej:i32=0; let dup3:i32=0;
            while(ej<ne && dup3==0){
                if(ept_claim(ep,ej)==h){ dup3=1; }
                ej=ej+1;
            }
            if(dup3==1){ cpass=0; }
            let st2:BrTok=br_tok_new(64,1024); let st2p:*BrTok=&st2;
            let wn:i32=br_tokenize(st2p,nbuf[0..nl],nl);
            let fj:i32=0;
            while(fj<ne){
                let fo2:i32=0; let fl2:i32=0;
                ept_fact(ep,fj,&fo2,&fl2);
                let fa3:[]u8=ep.*.factarena;
                let ft2:BrTok=br_tok_new(96,2048); let ft2p:*BrTok=&ft2;
                br_tokenize(ft2p,fa3[fo2..fo2+fl2],fl2);
                let inter:i32=0;
                let wi2:i32=0;
                while(wi2<wn){ inter=inter+br_c_contains(ft2p,st2p,wi2); wi2=wi2+1; }
                br_tok_free(ft2p);
                let pm:i32=0;
                if(wn>0){ pm=inter*1000/wn; }
                if(pm>dmax){ dmax=pm; }
                fj=fj+1;
            }
            br_tok_free(st2p);
            e_put(out,pos,"NOVAUDIT_S\t");
            e_put(out,pos,p4buf[d0..d0+d1]); e_put(out,pos,"\t");
            e_i32(out,pos,sn); e_put(out,pos,"\ta=");
            e_i32(out,pos,apass); e_put(out,pos,"\tc=");
            e_i32(out,pos,cpass);
            e_nl(out,pos);
        }
        nio_free(sbuf);
        // (b): phase-4 subject vs teaching labels (no taught section may reappear)
        let bpass:i32=1;
        let e02:i32=0;let e12:i32=0;let i02:i32=0;let i12:i32=0;
        q_split(p4buf[q0..q0+q1],q1,&e02,&e12,&i02,&i12);
        let nql2:i32=br_norm(p4buf[q0+i02..q0+i12],i12-i02,nbuf);
        let pat2:i32=q_classify(nbuf,nql2);
        let xx0:i32=-1; let xx1:i32=-1;
        if(pat2==1){
            let xa:i32=0;let xb:i32=0;let xc:i32=0;let xd:i32=0;
            if(qa_split(nbuf,nql2,&xa,&xb,&xc,&xd)==1){ xx0=xa; xx1=xb; }
        }
        if(pat2==2){
            let xa2:i32=0;let xb2:i32=0;let xv0:i32=0;let xv1:i32=0;
            if(qb_split(nbuf,nql2,&xa2,&xb2,&xv0,&xv1)==1){ xx0=xa2; xx1=xb2; }
        }
        if(xx0>=0){
            let xs:i32=xx0;
            if(xx1-xx0>4 && nbuf[xx0]==116 && nbuf[xx0+1]==104 && nbuf[xx0+2]==101 && nbuf[xx0+3]==32){ xs=xx0+4; }
            let ej2:i32=0;
            while(ej2<ne && bpass==1){
                let lo5:i32=0; let ll6:i32=0;
                ept_lab(ep,ej2,&lo5,&ll6);
                if(ll6==xx1-xs){
                    let la7:[]u8=ep.*.labarena;
                    let k9b:i32=0; let eqb:i32=1;
                    while(k9b<ll6){ if(la7[lo5+k9b]!=nbuf[xs+k9b]){ eqb=0; } k9b=k9b+1; }
                    if(eqb==1){ bpass=0; }
                }
                ej2=ej2+1;
            }
        }
        e_put(out,pos,"NOVAUDIT\t");
        e_put(out,pos,p4buf[d0..d0+d1]); e_put(out,pos,"\ta=");
        e_i32(out,pos,apass); e_put(out,pos,"\tb=");
        e_i32(out,pos,bpass); e_put(out,pos,"\tc=");
        e_i32(out,pos,cpass); e_put(out,pos,"\tdmax_permille=");
        e_i32(out,pos,dmax);
        e_nl(out,pos);
        ri=ri+1;
    }
    nio_free(corp);
    return;
}

// ---------------- H2: Phase-1 slots intact after Phase 2 ----------------
fn h2_check(out:[]u8, pos:*i32, sp:*StStore, ep:*EpTab) void {
    let ok:i32=1;
    let n:i32=ept_n(ep);
    let i:i32=0;
    while(i<n){
        if(ept_phase(ep,i)==1){
            let s:i32=ept_slot(ep,i);
            if(st_slot_live(sp,s)!=1){ ok=0; }
            if(st_slot_value(sp,s)!=ept_claim(ep,i)){ ok=0; }
        }
        i=i+1;
    }
    let ow:i32=0;
    let an:i32=st_audit_n(sp);
    let ai:i32=0;
    while(ai<an){
        let op:i32=0; let sl:i32=0; let rc:i32=0; let d1:i32=0; let d2:i32=0;
        st_audit_entry(sp,ai,&op,&sl,&rc,&d1,&d2);
        if(op==25){ ow=ow+1; }
        ai=ai+1;
    }
    if(ow!=0){ ok=0; }
    let i2:i32=0;
    while(i2<n){
        let j2:i32=i2+1;
        while(j2<n){
            if(ept_slot(ep,i2)==ept_slot(ep,j2)){ ok=0; }
            j2=j2+1;
        }
        i2=i2+1;
    }
    let max1:i32=-1; let min2:i32=999999;
    let i3:i32=0;
    while(i3<n){
        let s3:i32=ept_slot(ep,i3);
        if(ept_phase(ep,i3)==1 && s3>max1){ max1=s3; }
        if(ept_phase(ep,i3)==2 && s3<min2){ min2=s3; }
        i3=i3+1;
    }
    if(min2<=max1){ ok=0; }
    e_put(out,pos,"H2\t");
    e_i32(out,pos,ok);
    e_put(out,pos,"\toverwrite_ops=");
    e_i32(out,pos,ow);
    e_put(out,pos,"\tmaxslot_p1=");
    e_i32(out,pos,max1);
    e_put(out,pos,"\tminslot_p2=");
    e_i32(out,pos,min2);
    e_nl(out,pos);
    return;
}

// ---------------- audit dumps ----------------
fn dump_saudi(out:[]u8, pos:*i32, sp:*StStore) void {
    let an:i32=st_audit_n(sp);
    let ai:i32=0;
    while(ai<an){
        let op:i32=0; let sl:i32=0; let rc:i32=0; let d1:i32=0; let d2:i32=0;
        st_audit_entry(sp,ai,&op,&sl,&rc,&d1,&d2);
        e_put(out,pos,"SAUD\t");
        e_i32(out,pos,ai); e_put(out,pos,"\t");
        e_i32(out,pos,op); e_put(out,pos,"\t");
        e_i32(out,pos,sl); e_put(out,pos,"\t");
        e_i32(out,pos,rc); e_put(out,pos,"\t");
        e_i32(out,pos,d1); e_put(out,pos,"\t");
        e_i32(out,pos,d2);
        e_nl(out,pos);
        ai=ai+1;
    }
    return;
}
fn dump_psmhist(out:[]u8, pos:*i32, pp:*Psm) void {
    let hi:i32=0;
    let go:i32=1;
    while(go==1){
        let op:i32=0; let id:i32=0; let rs:i32=0; let st2:i32=0;
        go=psm_hist_get(pp,hi,&op,&id,&rs,&st2);
        if(go==1){
            e_put(out,pos,"PSMH\t");
            e_i32(out,pos,op); e_put(out,pos,"\t");
            e_i32(out,pos,id); e_put(out,pos,"\t");
            e_i32(out,pos,rs); e_put(out,pos,"\t");
            e_i32(out,pos,st2);
            e_nl(out,pos);
            hi=hi+1;
        }
    }
    return;
}

// ---------------- Phase-4 item answering ----------------
fn answer_phase4(out:[]u8, pos:*i32, reg:*BrReg, ep:*EpTab, pp:*Psm, bseq:*i32,
                 sup:*SupInfo, itemid:[]u8, itemidn:i32,
                 qraw:[]u8, qlen:i32, ctxraw:[]u8, ctxlen:i32,
                 nbuf:[]u8, nbuf2:[]u8, evbuf:[]u8) void {
    let e0:i32=0;let e1:i32=0;let i0:i32=0;let i1:i32=0;
    q_split(qraw,qlen,&e0,&e1,&i0,&i1);
    let nql:i32=br_norm(qraw[i0..i1],i1-i0,nbuf);
    let pat:i32=q_classify(nbuf,nql);
    let ans:[]u8=nio_alloc(16);
    ans[0]=85; ans[1]=78; ans[2]=67; ans[3]=76; ans[4]=65; ans[5]=83;
    ans[6]=83; ans[7]=73; ans[8]=70; ans[9]=73; ans[10]=69; ans[11]=68;
    let al:i32=12;
    if(pat==1){
        let x0:i32=0;let x1:i32=0;let c0:i32=0;let c1:i32=0;
        if(qa_split(nbuf,nql,&x0,&x1,&c0,&c1)==1){
            let k:i32=0;
            while(k<(e1-e0)){ evbuf[k]=qraw[e0+k]; k=k+1; }
            evbuf[k]=32; k=k+1;
            let k2:i32=0;
            while(k2<ctxlen){ evbuf[k]=ctxraw[k2]; k=k+1; k2=k2+1; }
            let evl:i32=br_norm(evbuf,k,nbuf2);
            al=delib_a(out,pos,reg,ep,bseq,sup,itemid,itemidn,4,
                nbuf2[0..evl],evl,nbuf[c0..c1],c1-c0,nbuf[x0..x1],x1-x0,ans);
        }
    }
    if(pat==2){
        let x0b:i32=0;let x1b:i32=0;let v0:i32=0;let v1:i32=0;
        if(qb_split(nbuf,nql,&x0b,&x1b,&v0,&v1)==1){
            let evl2:i32=br_norm(ctxraw,ctxlen,nbuf2);
            al=delib_b(out,pos,itemid,itemidn,4,nbuf2[0..evl2],evl2,nbuf[v0..v1],v1-v0,ans);
        }
    }
    e_put(out,pos,"ANS4\t");
    e_put(out,pos,itemid[0..itemidn]);
    e_put(out,pos,"\t");
    e_put(out,pos,ans[0..al]);
    e_nl(out,pos);
    nio_free(ans);
    return;
}

// ---------------- consequence probe answering ----------------
fn answer_conseq(out:[]u8, pos:*i32, reg:*BrReg, ep:*EpTab, pp:*Psm, bseq:*i32,
                 cfid:[]u8, cfidn:i32, qraw:[]u8, qlen:i32,
                 nbuf:[]u8, nbuf2:[]u8) void {
    let e0:i32=0;let e1:i32=0;let i0:i32=0;let i1:i32=0;
    q_split(qraw,qlen,&e0,&e1,&i0,&i1);
    let nql:i32=br_norm(qraw[i0..i1],i1-i0,nbuf);
    let obsl:i32=br_norm(qraw[e0..e1],e1-e0,nbuf2);
    let ans:[]u8=nio_alloc(16);
    let al:i32=delib_c(out,pos,reg,ep,pp,bseq,cfid,cfidn,4,
        nbuf2[0..obsl],obsl,nbuf[0..nql],nql,ans);
    e_put(out,pos,"CONSEQ\t");
    e_put(out,pos,cfid[0..cfidn]);
    e_put(out,pos,"\t");
    e_put(out,pos,ans[0..al]);
    e_nl(out,pos);
    nio_free(ans);
    return;
}

// ---------------- main ----------------
fn main() void {
    let mode:[]u8=_zag_arg(1);
    let fx:[]u8=_zag_arg(2);
    let out:[]u8=nio_alloc(600000);
    let pos:i32=0;
    if(mode.len!=4 || mode[0]!=102 || mode[1]!=117 || mode[2]!=108 || mode[3]!=108){
        e_put(out,&pos,"FATAL\tmode\n");
        _zag_print(out[0..pos]);
        return;
    }
    let fbf:[]u8=nio_alloc(32768);
    let fbp:[]u8=nio_alloc(32768);
    let fb4:[]u8=nio_alloc(32768);
    let fbv:[]u8=nio_alloc(8192);
    let fbc:[]u8=nio_alloc(8192);
    let nbuf:[]u8=nio_alloc(8192);
    let nbuf2:[]u8=nio_alloc(8192);
    let evbuf:[]u8=nio_alloc(8192);
    let facts:BrTsv=tsv_new(24,6); let ftp2:*BrTsv=&facts;
    let probes:BrTsv=tsv_new(16,4); let prp:*BrTsv=&probes;
    let ph4:BrTsv=tsv_new(8,6); let p4p:*BrTsv=&ph4;
    let prv:BrTsv=tsv_new(8,3); let pvp:*BrTsv=&prv;
    let csq:BrTsv=tsv_new(8,3); let csp:*BrTsv=&csq;
    let nrd:i64=rd_file(fx,"facts.tsv",fbf,32768);
    tsv_parse(fbf,nrd,24,6,ftp2);
    nrd=rd_file(fx,"probes.tsv",fbp,32768);
    tsv_parse(fbp,nrd,16,4,prp);
    nrd=rd_file(fx,"phase4.tsv",fb4,32768);
    tsv_parse(fb4,nrd,8,6,p4p);
    nrd=rd_file(fx,"prov.tsv",fbv,8192);
    tsv_parse(fbv,nrd,8,3,pvp);
    nrd=rd_file(fx,"conseq.tsv",fbc,8192);
    tsv_parse(fbc,nrd,8,3,csp);
    e_put(out,&pos,"CLB\t1\tcontinual-learning\tfull\n");
    if(tsv_nrows(ftp2)!=18 || tsv_nrows(prp)!=12 || tsv_nrows(p4p)!=4 || tsv_nrows(pvp)!=3 || tsv_nrows(csp)!=2){
        e_put(out,&pos,"FATAL\tfixture-counts\t");
        e_i32(out,&pos,tsv_nrows(ftp2)); e_put(out,&pos,"/");
        e_i32(out,&pos,tsv_nrows(prp)); e_put(out,&pos,"/");
        e_i32(out,&pos,tsv_nrows(p4p)); e_put(out,&pos,"/");
        e_i32(out,&pos,tsv_nrows(pvp)); e_put(out,&pos,"/");
        e_i32(out,&pos,tsv_nrows(csp));
        e_nl(out,&pos);
        _zag_print(out[0..pos]);
        return;
    }
    let reg:BrReg=br_reg_new(64,65536); let rp:*BrReg=&reg;
    let st:StStore=st_init(64,512); let spp:*StStore=&st;
    let psm:Psm=psm_init(1,64,64,512); let ppp:*Psm=&psm;
    let ept:EpTab=ept_new(32); let epp:*EpTab=&ept;
    let sup:SupInfo=sup_new(); let supp:*SupInfo=&sup;
    let bseq:i32=0;
    let sdone:i32=0;
    // ---- Phase 1: teach (concepts A/B/C)
    st_set_stage(spp,1);
    let ri:i32=0;
    while(ri<18){
        let f0:i32=0;let f1:i32=0;
        tsv_field(ftp2,ri,1,&f0,&f1);
        if(fbf[f0]==49){
            let e0:i32=0;let e1:i32=0;let s0:i32=0;let s1:i32=0;let t0:i32=0;let t1:i32=0;
            tsv_field(ftp2,ri,0,&e0,&e1);
            tsv_field(ftp2,ri,3,&s0,&s1);
            tsv_field(ftp2,ri,5,&t0,&t1);
            let rc0:i32=teach_one(out,&pos,rp,spp,ppp,epp,&bseq,1,
                fbf[e0..e0+e1],e1,fbf[s0..s0+s1],s1,fbf[t0..t0+t1],t1,nbuf,nbuf2);
            if(rc0!=0){ _zag_print(out[0..pos]); return; }
        }
        ri=ri+1;
    }
    // ---- Phase-1 probes (12)
    let pi:i32=0;
    while(pi<12){
        let d0:i32=0;let d1:i32=0;let q0:i32=0;let q1:i32=0;
        tsv_field(prp,pi,0,&d0,&d1);
        tsv_field(prp,pi,1,&q0,&q1);
        answer_which(out,&pos,rp,ppp,epp,&bseq,1,fbp[d0..d0+d1],d1,fbp[q0..q0+q1],q1,nbuf,nbuf2);
        pi=pi+1;
    }
    consolidate_pass(out,&pos,ppp,spp,rp,&bseq,&sdone,1);
    // ---- Phase 2: teach (concepts D/E/F)
    st_set_stage(spp,1);
    ri=0;
    while(ri<18){
        let g0:i32=0;let g1:i32=0;
        tsv_field(ftp2,ri,1,&g0,&g1);
        if(fbf[g0]==50){
            let e0b:i32=0;let e1b:i32=0;let s0b:i32=0;let s1b:i32=0;let t0b:i32=0;let t1b:i32=0;
            tsv_field(ftp2,ri,0,&e0b,&e1b);
            tsv_field(ftp2,ri,3,&s0b,&s1b);
            tsv_field(ftp2,ri,5,&t0b,&t1b);
            let rc1:i32=teach_one(out,&pos,rp,spp,ppp,epp,&bseq,2,
                fbf[e0b..e0b+e1b],e1b,fbf[s0b..s0b+s1b],s1b,fbf[t0b..t0b+t1b],t1b,nbuf,nbuf2);
            if(rc1!=0){ _zag_print(out[0..pos]); return; }
        }
        ri=ri+1;
    }
    // ---- Phase 3: probes again (12)
    pi=0;
    while(pi<12){
        let d0c:i32=0;let d1c:i32=0;let q0c:i32=0;let q1c:i32=0;
        tsv_field(prp,pi,0,&d0c,&d1c);
        tsv_field(prp,pi,1,&q0c,&q1c);
        answer_which(out,&pos,rp,ppp,epp,&bseq,3,fbp[d0c..d0c+d1c],d1c,fbp[q0c..q0c+q1c],q1c,nbuf,nbuf2);
        pi=pi+1;
    }
    consolidate_pass(out,&pos,ppp,spp,rp,&bseq,&sdone,2);
    h2_check(out,&pos,spp,epp);
    formation_pass(out,&pos,rp,spp,epp,&bseq,supp);
    novelty_audit(out,&pos,rp,epp,p4p,fb4,nbuf);
    // ---- Phase 4: novelty items
    let r4:i32=0;
    while(r4<4){
        let d0d:i32=0;let d1d:i32=0;let q0d:i32=0;let q1d:i32=0;let c0d:i32=0;let c1d:i32=0;
        tsv_field(p4p,r4,0,&d0d,&d1d);
        tsv_field(p4p,r4,4,&q0d,&q1d);
        tsv_field(p4p,r4,3,&c0d,&c1d);
        answer_phase4(out,&pos,rp,epp,ppp,&bseq,supp,
            fb4[d0d..d0d+d1d],d1d,fb4[q0d..q0d+q1d],q1d,fb4[c0d..c0d+c1d],c1d,
            nbuf,nbuf2,evbuf);
        r4=r4+1;
    }
    // ---- provenance probes
    let rv:i32=0;
    while(rv<3){
        let d0e:i32=0;let d1e:i32=0;let q0e:i32=0;let q1e:i32=0;
        tsv_field(pvp,rv,0,&d0e,&d1e);
        tsv_field(pvp,rv,1,&q0e,&q1e);
        answer_prov(out,&pos,rp,spp,ppp,epp,
            fbv[d0e..d0e+d1e],d1e,fbv[q0e..q0e+q1e],q1e,nbuf);
        rv=rv+1;
    }
    // ---- consequence probes
    let rq:i32=0;
    while(rq<2){
        let d0f:i32=0;let d1f:i32=0;let q0f:i32=0;let q1f:i32=0;
        tsv_field(csp,rq,0,&d0f,&d1f);
        tsv_field(csp,rq,1,&q0f,&q1f);
        answer_conseq(out,&pos,rp,epp,ppp,&bseq,
            fbc[d0f..d0f+d1f],d1f,fbc[q0f..q0f+q1f],q1f,nbuf,nbuf2);
        rq=rq+1;
    }
    dump_saudi(out,&pos,spp);
    dump_psmhist(out,&pos,ppp);
    e_put(out,&pos,"SUMMARY\t");
    e_i32(out,&pos,ept_n(epp)); e_put(out,&pos,"\t");
    e_i32(out,&pos,br_reg_n(rp)); e_put(out,&pos,"\t");
    e_i32(out,&pos,sup_slot(supp)); e_put(out,&pos,"\t");
    e_i32(out,&pos,st_audit_n(spp)); e_put(out,&pos,"\t");
    e_i32(out,&pos,psm_nconsol(ppp));
    e_nl(out,&pos);
    _zag_print(out[0..pos]);
    return;
}

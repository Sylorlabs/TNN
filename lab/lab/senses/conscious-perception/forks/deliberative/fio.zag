// fio.zag — minimal file I/O + integer/string helpers for the deliberative fork.
// Idioms follow R33_NATIVE_IO_V1.zag. []u8 arenas only (never `as []i32`).
@import("substrate/R33_NATIVE_IO_V1.zag")

fn f_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn f_open_ro(path:[]u8)i64 {
    let s:[]u8=nio_cstr(path);if(s.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,0,0,0,0,0);
    nio_free(s);return fd;
}
fn f_open_wo(path:[]u8)i64 {
    let s:[]u8=nio_cstr(path);if(s.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,577,384,0,0,0);
    nio_free(s);return fd;
}
fn f_write_all(fd:i64,b:[]u8)i64 {
    let at:i64=0;let guard:i32=0;
    while(at<b.len && guard<100000){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+at,(b.len as i64)-at,0,0,0);
        if(n<=0){return -1;}
        at=at+n;guard=guard+1;
    }
    if(at!=b.len){return -1;}
    return at;
}
fn f_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
// read whole regular file into a fresh arena; returns slice, len via out param
fn f_read_all(path:[]u8,out:*i32)[]u8 {
    let fd:i64=f_open_ro(path);
    if(fd<0){out.*=-1;return "";}
    let sz:i64=_zag_raw_syscall(8,fd,0,2,0,0,0);
    if(sz<0 || sz>33554431){f_close(fd);out.*=-2;return "";}
    _zag_raw_syscall(8,fd,0,0,0,0,0);
    let b:[]u8=nio_alloc((sz+1) as i32);
    if(b.len==0){f_close(fd);out.*=-3;return "";}
    let at:i64=0;let guard:i32=0;
    while(at<sz && guard<100000){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(b) as i64)+at,sz-at,0,0,0);
        if(n<=0){break;}
        at=at+n;guard=guard+1;
    }
    f_close(fd);
    if(at!=sz){nio_free(b);out.*=-4;return "";}
    out.*=sz as i32;
    return b[0..(sz as i32)];
}
fn f_write_file(path:[]u8,b:[]u8)i32 {
    let fd:i64=f_open_wo(path);
    if(fd<0){return -1;}
    let w:i64=f_write_all(fd,b);
    f_close(fd);
    if(w!=b.len){return -2;}
    return 0;
}
// little-endian arena accessors
fn f_gu16(b:[]u8,at:i32)i32 { return (b[at] as i32)+((b[at+1] as i32)<<8); }
fn f_gu32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn f_gi16(b:[]u8,at:i32)i32 {
    let v:i32=f_gu16(b,at);
    if(v>=32768){return v-65536;}
    return v;
}
fn f_pu16(b:[]u8,at:i32,v:i32)void { b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8; }
fn f_pu32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn f_abs64(v:i64)i64 { if(v<0){return -v;} return v; }
fn f_abs32(v:i32)i32 { if(v<0){return -v;} return v; }
// []i64 scratch arrays. nio_alloc returns []u8 only, and `as []i64` casts
// miscompile indexed reads (ZNC-007). Process-lifetime scratch: deliberately
// not freed (one trial per process; _zag_free would need the base pointer).
fn z_i64a(n:i32)[]i64 {
    let p:*i64=_zag_malloc(n*8) as *i64;
    return p[0..n];
}
fn f_min64(a:i64,b:i64)i64 { if(a<b){return a;} return b; }
fn f_max64(a:i64,b:i64)i64 { if(a>b){return a;} return b; }
// append src into dst at *at; returns 0 ok
fn f_cat(dst:[]u8,at:*i32,src:[]u8)i32 {
    let i:i32=0;
    while(i<src.len){
        if(at.*>=dst.len){return -1;}
        dst[at.*]=src[i];at.*=at.*+1;i=i+1;
    }
    return 0;
}
fn f_cat1(dst:[]u8,at:*i32,c:u8)i32 {
    if(at.*>=dst.len){return -1;}
    dst[at.*]=c;at.*=at.*+1;return 0;
}
fn f_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let i:i32=0;
    while(i<pre.len){if(s[i]!=pre[i]){return 0;}i=i+1;}
    return 1;
}
fn f_ends(s:[]u8,suf:[]u8)i32 {
    if(s.len<suf.len){return 0;}
    let i:i32=0;
    while(i<suf.len){if(s[s.len-suf.len+i]!=suf[i]){return 0;}i=i+1;}
    return 1;
}

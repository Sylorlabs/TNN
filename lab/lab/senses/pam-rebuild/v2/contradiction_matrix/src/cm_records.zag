fn cm_cell_name(ci:i32) []u8 {
    if(ci==0){return "C1";}
    if(ci==1){return "C2";}
    if(ci==2){return "C3";}
    if(ci==3){return "R1";}
    if(ci==4){return "R2";}
    if(ci==5){return "CC1";}
    if(ci==6){return "CC2";}
    if(ci==7){return "H1";}
    if(ci==8){return "T1";}
    if(ci==9){return "W1";}
    return "?";
}

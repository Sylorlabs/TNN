// lut.zag - sRGB EOTF table, 1e6 scale, 256 entries.
// Generated from the sRGB standard (IEC 61966-2-1) transfer function;
// fixed numeric constants, not fixture data. Self-contained.
fn lp(b:[]u8, at:i32, v:i64) void {
    b[at+0] = ((v >> 0) & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}

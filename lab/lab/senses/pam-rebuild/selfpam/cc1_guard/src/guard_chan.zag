// guard_chan.zag — attested corroborator channel for the CC1 guard.
//
// Derived from the frozen self-PAM C1 corroborator (selfpam/src/corr.zag).
// The channel attestation preimage is EXTENDED (PREREG_AMEND_CC1_GUARD.md §2)
// to bind the 32-byte evidence-source-class id:
//
//   gatt = sha256hex(CHANNEL_KEY || jcode || "|" || conf || "|" || meas || "|"
//                    || hex(sha256(evidence_bytes)) || "|" || hex(srcid))
//
// The gate recomputes this over the presented (jcode, conf, meas, ev, srcid)
// and accepts the observation only on a byte-exact match, so the srcid the
// guard compares is unforgeable without the channel key. The draft
// (proposer) channel carries no srcid at all: the trusted source class always
// comes from a channel-attested re-read of the cited evidence.
//
// CHANNEL_KEY is the frozen TEST registration key (same as the frozen
// composition); the mechanism — gate verifies, forger cannot sign — is what
// is frozen (IE amendment R2).

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("codec.zag")
@import("guard_gate.zag")

fn gc_key() []u8 { return "SELF-PAM-C1-REG-CHANNEL-2026-09-23"; }

// srcid_of: the 32-byte source-class id is sha256 of the registered class name
// (e.g. "timbredisc/TMB-1"). The deployment's class registry assigns names;
// the experiment fixes them in the driver.
fn srcid_of(name:[]u8, out32:[]u8) i32 {
    if(out32.len != 32) { return -1; }
    return ns_sha256(name, out32);
}
// Build the attestation preimage into ob; returns new pos.
fn gc_preimage(ob:[]u8, pos:i32, jcode:i32, conf:i32, meas:i32,
               evhex:[]u8, srchex:[]u8) i32 {
    pos = ob_add_raw(ob, pos, gc_key());
    pos = ob_add_i32(ob, pos, jcode);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_i32(ob, pos, conf);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_i32(ob, pos, meas);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_raw(ob, pos, evhex);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_raw(ob, pos, srchex);
    return pos;
}
// gc_attest: gatt = sha256hex(preimage) into out64 (must be 64 B).
fn gc_attest(jcode:i32, conf:i32, meas:i32, evhex:[]u8, srcid:[]u8,
             out64:[]u8) i32 {
    if(out64.len != 64 || evhex.len != 64 || srcid.len != 32) { return -1; }
    let srchex:[]u8 = nio_alloc(64);
    if(srchex.len == 0) { return -1; }
    hex_encode(srcid, srchex);
    let ob:[]u8 = nio_alloc(512);
    if(ob.len == 0) { nio_free(srchex); return -1; }
    let pos:i32 = gc_preimage(ob, 0, jcode, conf, meas, evhex, srchex);
    nio_free(srchex);
    let dg:[]u8 = nio_alloc(32);
    if(dg.len == 0) { nio_free(ob); return -1; }
    let rc:i32 = ns_sha256(ob[0..pos], dg);
    nio_free(ob);
    if(rc != 0) { nio_free(dg); return -1; }
    hex_encode(dg, out64);
    nio_free(dg);
    return 0;
}
// gc_verify: 1 iff gatt matches the recomputed attestation.
fn gc_verify(jcode:i32, conf:i32, meas:i32, evhex:[]u8, srcid:[]u8,
             gatt:[]u8) i32 {
    if(gatt.len != 64 || evhex.len != 64 || srcid.len != 32) { return 0; }
    let exp:[]u8 = nio_alloc(64);
    if(exp.len == 0) { return 0; }
    if(gc_attest(jcode, conf, meas, evhex, srcid, exp) != 0) {
        nio_free(exp);
        return 0;
    }
    let ok:i32 = 1;
    let i:i32 = 0;
    while(i < 64) {
        if(exp[i] != gatt[i]) { ok = 0; }
        i = i + 1;
    }
    nio_free(exp);
    return ok;
}
// gc_observe: gate-side entry for attested corroborator-channel records.
// Verifies attestation (binds jcode/conf/meas/evidence/srcid), requires
// conf >= 700, then runs the guarded gate step with src=1. Any failure =>
// WITHHELD (0). chid is the attested channel id (audit tag; the key itself
// is the channel identity — see prereg §2).
fn gc_observe(st:[]u8, task:i32, jcode:i32, conf:i32, meas:i32,
              ev:[]u8, srcid:[]u8, chid:i32, gatt:[]u8) i32 {
    if(st.len < 4096) { return 0; }
    if(task != 0) { return 0; }
    if(gatt.len != 64) { return 0; }
    if(srcid.len != 32) { return 0; }
    let h:[]u8 = nio_alloc(32);
    if(h.len == 0) { return 0; }
    if(ns_sha256(ev, h) != 0) { nio_free(h); return 0; }
    let evhex:[]u8 = nio_alloc(64);
    if(evhex.len == 0) { nio_free(h); return 0; }
    hex_encode(h, evhex);
    let ok:i32 = gc_verify(jcode, conf, meas, evhex, srcid, gatt);
    nio_free(evhex);
    if(ok == 0) { nio_free(h); return 0; }   // unattested => absent
    if(conf < 700) { nio_free(h); return 0; } // high-conf bar
    let d:i32 = cg_step(st, task, jcode, conf, meas, 0, 1, 1, h, srcid, chid);
    nio_free(h);
    return d;
}

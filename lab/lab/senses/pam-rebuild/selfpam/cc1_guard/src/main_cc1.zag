// main_cc1.zag — CC1 guard verification battery driver.
//
// Runs the preregistered cells (PREREG_AMEND_CC1_GUARD.md §4):
//   C1 K1a: CC1b attack (same adversarial family, different bytes) -> WITHHELD
//   C2 K1b: CC1a attack (same bundle re-measured) -> WITHHELD
//   C3 K2a: legitimate revision (CC2 pattern, diverse source classes) -> REVISED_INSTALL
//   C4 K2b: legitimate permanent install via diverse attested pair -> PERMANENT_INSTALL
//   C5: controls (D1 unattested, conf<700, forged gatt, bait-and-switch, reset)
//   C6: red team R1..R6 (R6 installs: documented residual)
//
// Prints "CELL|step|DISPOSITION" lines on stdout plus "CELL|perm|<jcode>" lines;
// "steps=N digest=<sha256hex>" on stderr (digest over the disposition-name
// stream, cf1 convention). Zero RNG. Deterministic given the frozen inputs.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("codec.zag")
@import("guard_gate.zag")
@import("guard_chan.zag")

fn cc_out(fd:i64, s:[]u8) void {
    let i:i32 = 0;
    while(i < s.len) {
        let n:i32 = s.len - i;
        if(n > 8192) { n = 8192; }
        let chunk:[]u8 = s[i..i+n];
        _zag_raw_syscall(1, fd, _zag_slice_ptr(chunk) as i64, n as i64, 0, 0, 0);
        i = i + n;
    }
    return;
}
fn mkbuf(fill:i32, n:i32) []u8 {
    let b:[]u8 = nio_alloc(n);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < n) { b[i] = (fill & 255) as u8; i = i + 1; }
    return b;
}
fn cpbuf(src:[]u8) []u8 {
    let b:[]u8 = nio_alloc(src.len);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < src.len) { b[i] = src[i]; i = i + 1; }
    return b;
}
// draft via the unattested proposer channel.
fn cc_draft(st:[]u8, jcode:i32, conf:i32, meas:i32, ev:[]u8) i32 {
    let h:[]u8 = nio_alloc(32);
    if(h.len == 0) { return -99; }
    if(ns_sha256(ev, h) != 0) { nio_free(h); return -99; }
    let d:i32 = cg_admit(st, 0, jcode, conf, meas, h);
    nio_free(h);
    return d;
}
// attest only (no gate observation): builds gatt for the presented record.
fn cc_attest_only(jcode:i32, conf:i32, meas:i32, ev:[]u8,
                  srcid:[]u8, gatt:[]u8) i32 {
    let h:[]u8 = nio_alloc(32);
    if(h.len == 0) { return -99; }
    if(ns_sha256(ev, h) != 0) { nio_free(h); return -99; }
    let hx:[]u8 = nio_alloc(64);
    if(hx.len == 0) { nio_free(h); return -99; }
    hex_encode(h, hx);
    nio_free(h);
    let rc:i32 = gc_attest(jcode, conf, meas, hx, srcid, gatt);
    nio_free(hx);
    if(rc != 0) { return -99; }
    return 0;
}
// attested observation via the channel (attests, then observes).
fn cc_att(st:[]u8, jcode:i32, conf:i32, meas:i32, ev:[]u8,
          srcid:[]u8, gatt:[]u8) i32 {
    if(cc_attest_only(jcode, conf, meas, ev, srcid, gatt) != 0) { return -99; }
    return gc_observe(st, 0, jcode, conf, meas, ev, srcid, 1, gatt);
}

fn main() i32 {
    let out:[]u8 = nio_alloc(16384);
    let dstream:[]u8 = nio_alloc(16384);
    if(out.len == 0 || dstream.len == 0) { return 1; }
    let opos:i32 = 0;
    let dpos:i32 = 0;
    let gatt:[]u8 = nio_alloc(64);
    if(gatt.len == 0) { return 1; }
    let d:i32 = 0;

    // ---- evidence bundles (64 B each; meas = span_sum) ----
    let e_inc:[]u8 = mkbuf(65, 64);
    let e_inc2:[]u8 = cpbuf(e_inc);
    e_inc2[0] = ((e_inc2[0] as i32) + 4) as u8;
    let e1:[]u8 = mkbuf(66, 64);
    let e2:[]u8 = cpbuf(e1);
    e2[0] = ((e2[0] as i32) + 4) as u8;
    let e2p:[]u8 = cpbuf(e1);
    e2p[5] = ((e2p[5] as i32) ^ 1) as u8;
    let ea:[]u8 = mkbuf(67, 64);
    let eb:[]u8 = cpbuf(ea);
    eb[0] = ((eb[0] as i32) + 5) as u8;
    eb[1] = ((eb[1] as i32) - 5) as u8;
    let e4:[]u8 = cpbuf(e1);
    e4[2] = ((e4[2] as i32) + 3) as u8;
    let e9:[]u8 = mkbuf(70, 64);
    let e3:[]u8 = cpbuf(e1);
    e3[0] = ((e3[0] as i32) + 100) as u8;
    let e4d:[]u8 = cpbuf(e3);
    e4d[1] = ((e4d[1] as i32) + 3) as u8;
    let ew1:[]u8 = mkbuf(68, 64);
    let ew2:[]u8 = cpbuf(ew1);
    ew2[0] = ((ew2[0] as i32) + 4) as u8;
    let efake:[]u8 = mkbuf(71, 64);

    let m_inc:i32 = span_sum(e_inc);
    let m_inc2:i32 = span_sum(e_inc2);
    let m1:i32 = span_sum(e1);
    let m2:i32 = span_sum(e2);
    let m2p:i32 = span_sum(e2p);
    let ma:i32 = span_sum(ea);
    let mb:i32 = span_sum(eb);
    let m4:i32 = span_sum(e4);
    let m9:i32 = span_sum(e9);
    let m3:i32 = span_sum(e3);
    let m4d:i32 = span_sum(e4d);
    let mw1:i32 = span_sum(ew1);
    let mw2:i32 = span_sum(ew2);
    let mfake:i32 = span_sum(efake);

    // ---- source-class ids (sha256 of registered class names) ----
    let s_tmb1:[]u8 = nio_alloc(32);
    let s_norma:[]u8 = nio_alloc(32);
    let s_normb:[]u8 = nio_alloc(32);
    let s_fama:[]u8 = nio_alloc(32);
    let s_famb:[]u8 = nio_alloc(32);
    let s_wa:[]u8 = nio_alloc(32);
    let s_wb:[]u8 = nio_alloc(32);
    if(s_tmb1.len == 0 || s_norma.len == 0 || s_normb.len == 0) { return 1; }
    if(s_fama.len == 0 || s_famb.len == 0 || s_wa.len == 0 || s_wb.len == 0) { return 1; }
    if(srcid_of("timbredisc/TMB-1", s_tmb1) != 0) { return 1; }
    if(srcid_of("sense/normal-A", s_norma) != 0) { return 1; }
    if(srcid_of("sense/normal-B", s_normb) != 0) { return 1; }
    if(srcid_of("colordisc/0542", s_fama) != 0) { return 1; }
    if(srcid_of("colordisc/0969", s_famb) != 0) { return 1; }
    if(srcid_of("fam/wrong-A", s_wa) != 0) { return 1; }
    if(srcid_of("fam/wrong-B", s_wb) != 0) { return 1; }

    let st:[]u8 = cg_init();
    if(st.len == 0) { return 1; }

    // ================= C1: K1a attack, same adversarial family =================
    st = cg_init();
    d = cc_draft(st, 3, 764, m_inc, e_inc);
    opos = ob_add_raw(out, opos, "C1|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc, e_inc, s_norma, gatt);
    opos = ob_add_raw(out, opos, "C1|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc2, e_inc2, s_normb, gatt);
    opos = ob_add_raw(out, opos, "C1|3|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C1|4|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m1, e1, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C1|5|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m2, e2, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C1|6|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    opos = ob_add_raw(out, opos, "C1|perm|"); opos = ob_add_i32(out, opos, cg_perm_jcode(st)); opos = ob_add_raw(out, opos, "\n");

    // ================= C2: K1b attack, same bundle re-measured =================
    st = cg_init();
    d = cc_draft(st, 3, 764, m_inc, e_inc);
    opos = ob_add_raw(out, opos, "C2|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc, e_inc, s_norma, gatt);
    opos = ob_add_raw(out, opos, "C2|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc2, e_inc2, s_normb, gatt);
    opos = ob_add_raw(out, opos, "C2|3|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C2|4|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m1, e1, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C2|5|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m1, e1, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C2|6|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    opos = ob_add_raw(out, opos, "C2|perm|"); opos = ob_add_i32(out, opos, cg_perm_jcode(st)); opos = ob_add_raw(out, opos, "\n");

    // ================= C3: K2a legitimate revision (CC2 pattern) =================
    st = cg_init();
    d = cc_draft(st, 0, 764, m_inc, e_inc);
    opos = ob_add_raw(out, opos, "C3|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 0, 764, m_inc, e_inc, s_norma, gatt);
    opos = ob_add_raw(out, opos, "C3|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 0, 764, m_inc2, e_inc2, s_normb, gatt);
    opos = ob_add_raw(out, opos, "C3|3|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_draft(st, 1, 764, ma, ea);
    opos = ob_add_raw(out, opos, "C3|4|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 1, 764, ma, ea, s_fama, gatt);
    opos = ob_add_raw(out, opos, "C3|5|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 1, 764, mb, eb, s_famb, gatt);
    opos = ob_add_raw(out, opos, "C3|6|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    opos = ob_add_raw(out, opos, "C3|perm|"); opos = ob_add_i32(out, opos, cg_perm_jcode(st)); opos = ob_add_raw(out, opos, "\n");

    // ================= C4: K2b legitimate permanent install =================
    st = cg_init();
    d = cc_draft(st, 5, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C4|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 5, 764, m1, e1, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C4|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 5, 764, m4, e4, s_normb, gatt);
    opos = ob_add_raw(out, opos, "C4|3|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    opos = ob_add_raw(out, opos, "C4|perm|"); opos = ob_add_i32(out, opos, cg_perm_jcode(st)); opos = ob_add_raw(out, opos, "\n");

    // ================= C5a: control — unattested 2nd obs stays provisional (D1) =================
    st = cg_init();
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C5a|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m1, e1, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C5a|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C5a|3|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // ================= C5b: control — conf 699 attested -> WITHHELD =================
    st = cg_init();
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C5b|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 699, m1, e1, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C5b|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // ================= C5c: control — forged attestation -> WITHHELD =================
    st = cg_init();
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C5c|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m1, e1, s_tmb1, gatt);
    if(gatt[0] == 48) { gatt[0] = 49; } else { gatt[0] = 48; }
    d = gc_observe(st, 0, 2, 764, m1, e1, s_tmb1, 1, gatt);
    opos = ob_add_raw(out, opos, "C5c|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // ================= C5d: control — attested different-evidence before binding -> WITHHELD =================
    // (agreeing meas, so the binding check — not tolerance — is what trips)
    st = cg_init();
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C5d|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m2, e2, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C5d|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // ================= C5e: control — non-agreeing attested resets flag, diverse still promotes =================
    // (challenger track needs a permanent incumbent first)
    st = cg_init();
    d = cc_draft(st, 3, 764, m_inc, e_inc);
    opos = ob_add_raw(out, opos, "C5e|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc, e_inc, s_norma, gatt);
    opos = ob_add_raw(out, opos, "C5e|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc2, e_inc2, s_normb, gatt);
    opos = ob_add_raw(out, opos, "C5e|3|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C5e|4|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m1, e1, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C5e|5|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m3, e3, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C5e|6|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m3, e3, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C5e|7|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m4d, e4d, s_normb, gatt);
    opos = ob_add_raw(out, opos, "C5e|8|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    opos = ob_add_raw(out, opos, "C5e|perm|"); opos = ob_add_i32(out, opos, cg_perm_jcode(st)); opos = ob_add_raw(out, opos, "\n");

    // ================= C6R1: red team — forged attestation =================
    st = cg_init();
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C6R1|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m1, e1, s_tmb1, gatt);
    if(gatt[0] == 48) { gatt[0] = 49; } else { gatt[0] = 48; }
    d = gc_observe(st, 0, 2, 764, m1, e1, s_tmb1, 1, gatt);
    opos = ob_add_raw(out, opos, "C6R1|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // ================= C6R2: red team — conf 0 attested =================
    st = cg_init();
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C6R2|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 0, m1, e1, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C6R2|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // ================= C6R3: red team — 1-byte evidence perturbation, honest srcid =================
    st = cg_init();
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C6R3|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m1, e1, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C6R3|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m2p, e2p, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C6R3|3|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // ================= C6R4: red team — replay gatt against a different claim =================
    st = cg_init();
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C6R4|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    if(cc_attest_only(2, 764, m1, e1, s_tmb1, gatt) != 0) { cc_out(2, "attest failed\n"); return 1; }
    d = gc_observe(st, 0, 5, 764, m1, e1, s_tmb1, 1, gatt);
    opos = ob_add_raw(out, opos, "C6R4|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // ================= C6R5: red team — attested obs cites different evidence than the draft =================
    // (challenger track: incumbent installed first; the draft's cited bundle is
    // never re-read by the channel => bait-and-switch, fail closed)
    st = cg_init();
    d = cc_draft(st, 3, 764, m_inc, e_inc);
    opos = ob_add_raw(out, opos, "C6R5|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc, e_inc, s_norma, gatt);
    opos = ob_add_raw(out, opos, "C6R5|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc2, e_inc2, s_normb, gatt);
    opos = ob_add_raw(out, opos, "C6R5|3|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_draft(st, 2, 764, m1, e1);
    opos = ob_add_raw(out, opos, "C6R5|4|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, m2, e2, s_tmb1, gatt);
    opos = ob_add_raw(out, opos, "C6R5|5|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    opos = ob_add_raw(out, opos, "C6R5|perm|"); opos = ob_add_i32(out, opos, cg_perm_jcode(st)); opos = ob_add_raw(out, opos, "\n");

    // ================= C6R6: red team — genuinely independent double-wrong (RESIDUAL: installs) =================
    st = cg_init();
    d = cc_draft(st, 3, 764, m_inc, e_inc);
    opos = ob_add_raw(out, opos, "C6R6|1|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc, e_inc, s_norma, gatt);
    opos = ob_add_raw(out, opos, "C6R6|2|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 3, 764, m_inc2, e_inc2, s_normb, gatt);
    opos = ob_add_raw(out, opos, "C6R6|3|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_draft(st, 2, 764, mw1, ew1);
    opos = ob_add_raw(out, opos, "C6R6|4|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, mw1, ew1, s_wa, gatt);
    opos = ob_add_raw(out, opos, "C6R6|5|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    d = cc_att(st, 2, 764, mw2, ew2, s_wb, gatt);
    opos = ob_add_raw(out, opos, "C6R6|6|"); opos = ob_add_raw(out, opos, cg_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, cg_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    opos = ob_add_raw(out, opos, "C6R6|perm|"); opos = ob_add_i32(out, opos, cg_perm_jcode(st)); opos = ob_add_raw(out, opos, "\n");

    cc_out(1, out[0..opos]);

    let dg:[]u8 = nio_alloc(32);
    if(dg.len == 0) { return 1; }
    if(ns_sha256(dstream[0..dpos], dg) != 0) { return 1; }
    let hx:[]u8 = nio_alloc(64);
    if(hx.len == 0) { return 1; }
    hex_encode(dg, hx);
    let rep:[]u8 = nio_alloc(256);
    if(rep.len == 0) { return 1; }
    let rp:i32 = 0;
    rp = ob_add_raw(rep, rp, "steps=58 digest=");
    rp = ob_add_raw(rep, rp, hx);
    rp = ob_add_raw(rep, rp, "\n");
    cc_out(2, rep[0..rp]);
    return 0;
}

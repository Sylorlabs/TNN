// C7 held-out store: disjoint forest/water stock.
// Must remain unopened until C1-C6 stabilize.

fn store_h_text()[]u8 {
    let o:[]u8 = nio_alloc(4096);
    if(o.len==0){return "";}
    let p:i32=0;
    // Forest stock (EXT).
    let f:[]u8="UNIT|pine|POS|IS_A|tree|EXT\n";
    f=cat2(f,"UNIT|oak|POS|IS_A|tree|EXT\n");
    f=cat2(f,"UNIT|tree|POS|IS_A|plant|EXT\n");
    f=cat2(f,"UNIT|fern|POS|IS_A|plant|EXT\n");
    f=cat2(f,"UNIT|deer|POS|IS_A|mammal|EXT\n");
    f=cat2(f,"UNIT|owl|POS|IS_A|bird|EXT\n");
    f=cat2(f,"UNIT|pine|POS|HAS_PROPERTY|tall|EXT\n");
    f=cat2(f,"UNIT|oak|POS|HAS_PROPERTY|tall|EXT\n");
    f=cat2(f,"UNIT|fern|POS|HAS_PROPERTY|green|EXT\n");
    f=cat2(f,"UNIT|deer|POS|HAS_PROPERTY|alive|EXT\n");
    f=cat2(f,"UNIT|owl|POS|HAS_PROPERTY|alive|EXT\n");
    f=cat2(f,"UNIT|pine|POS|LOC_IN|forest|EXT\n");
    f=cat2(f,"UNIT|oak|POS|LOC_IN|forest|EXT\n");
    f=cat2(f,"UNIT|deer|POS|LOC_IN|forest|EXT\n");
    f=cat2(f,"UNIT|owl|POS|LOC_IN|forest|EXT\n");
    // Water stock (EXT).
    f=cat2(f,"UNIT|trout|POS|IS_A|fish|EXT\n");
    f=cat2(f,"UNIT|salmon|POS|IS_A|fish|EXT\n");
    f=cat2(f,"UNIT|fish|POS|IS_A|animal|EXT\n");
    f=cat2(f,"UNIT|trout|POS|HAS_PROPERTY|alive|EXT\n");
    f=cat2(f,"UNIT|salmon|POS|HAS_PROPERTY|alive|EXT\n");
    f=cat2(f,"UNIT|trout|POS|LOC_IN|river|EXT\n");
    f=cat2(f,"UNIT|salmon|POS|LOC_IN|river|EXT\n");
    // GEN (ungrounded but not contradicted).
    f=cat2(f,"UNIT|pine|POS|IS_A|evergreen|GEN\n");
    f=cat2(f,"UNIT|trout|POS|IS_A|gamefish|GEN\n");
    let k:i32=0;
    while(k<f.len){o[p]=f[k];p=p+1;k=k+1;}
    return o[0..p];
}

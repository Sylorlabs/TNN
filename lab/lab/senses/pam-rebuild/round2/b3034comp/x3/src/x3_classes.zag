// x3_classes.zag — B-3034X3 battery classes (frozen prereg PREREG_B3034X3.md §4).
//
// N=120 ids 0..119. The decision under test is selected by the mode symbol
// passed at the top of main (x3_full or x3_nop) — one source, two builds.
// Every class runs its exact prereg transcript on a FRESH arena per
// (class, id) and prints one line: "CODE j p f rc".
//
// Fixtures present percepts and epochs ONLY. The honest epochs are what the
// driver's world says they are (the fixture simulates a sensor observing
// the world); the fixture never supplies K, time, verdict bounds, or
// policy knobs.

fn x3_unp(r:i64) i32 { return (r % 2) as i32; }
fn x3_fir(r:i64) i32 { return ((r / 2) % 2) as i32; }
fn x3_rc(r:i64) i32 { return ((r / 4) % 64) as i32; }

// Honest percept at (j, e): the world tuple. The DRIVER recomputes these
// at decide time; the fixture may not forge a switch (no presenter-seed).
fn x3_he(st:[]u8, j:i64, e:i64, extra:i64) i64 {
    let seed:i64 = x3_seed(j);
    return x3_enqueue(st, j, e, x3_wle(j, e, seed), x3_wc(j, seed), x3_wm(j, seed), extra);
}
// Honest shape with conf/meas offsets (NOP-OMIT / C12 / C4 / C8).
fn x3_he_off(st:[]u8, j:i64, e:i64, extra:i64, dc:i64, dm:i64) i64 {
    let seed:i64 = x3_seed(j);
    return x3_enqueue(st, j, e, x3_wle(j, e, seed), x3_wc(j, seed) + dc, x3_wm(j, seed) + dm, extra);
}
// Raw presentation (contradiction / poison / junk classes).
fn x3_hx(st:[]u8, j:i64, e:i64, label:i64, conf:i64, meas:i64, extra:i64) i64 {
    return x3_enqueue(st, j, e, label, conf, meas, extra);
}
fn x3_honest3(st:[]u8, j:i64, extra:i64) void {
    let e:i64 = 0;
    while(e < 3) { x3_he(st, j, e, extra); e = e + 1; }
    return;
}
fn x3_line(ob:[]u8, pos:i32, code:[]u8, j:i64, r:i64) i32 {
    pos = ob_puts(ob, pos, code);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_unp(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_fir(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_rc(r) as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}

// E0: zero evidence decides -> NO_EVIDENCE (rc=10). C-E0: K is
// driver-owned; zero counted non-gap epochs never promote.
fn c_e0(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "E0", j, r);
}
// E1: one honest epoch -> SHORT_WINDOW (rc=14). C-SHORT: 1-2 epochs refuse.
fn c_e1(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_he(st, j, 0, 7);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "E1", j, r);
}
// E2: two honest epochs -> SHORT_WINDOW (rc=14).
fn c_e2(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_he(st, j, 0, 7);
    x3_he(st, j, 1, 7);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "E2", j, r);
}
// G0: gap marks only (3 authenticated gaps, zero records) -> NO_EVIDENCE
// (rc=10). C-GAP: all-gap refuses; gaps are never evidence.
fn c_g0(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_gap(st, j, 0);
    x3_gap(st, j, 1);
    x3_gap(st, j, 2);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "G0", j, r);
}
// G1: 2 honest + 1 authenticated gap -> SHORT_WINDOW (rc=14). The gap does
// not count as an epoch, does not suppress anything, and does not stretch
// the window: C-GAP.
fn c_g1(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_he(st, j, 0, 7);
    x3_he(st, j, 1, 7);
    x3_gap(st, j, 2);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "G1", j, r);
}
// G2: 3 honest + 1 authenticated gap (X3a shape: gap interleaved at e=1)
// -> PROMOTE (rc=0).
fn c_g2(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_he(st, j, 0, 7);
    x3_gap(st, j, 1);
    x3_he(st, j, 1, 7);
    x3_he(st, j, 2, 7);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "G2", j, r);
}
// T0: staleness — 3 honest, then 70 junk presentations on other ids advance
// the driver clock past MAX_AGE before decide -> TIME (rc=11). C-TEMP: the
// rule reads driver stamps only (t_q < t_stored < t_dec plus freshness).
fn c_t0(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_honest3(st, j, 7);
    let i:i64 = 0;
    while(i < 70) {
        let jj:i64 = 100000 + j * 1000 + i;
        x3_hx(st, jj, 0, 0, 80, 1000, 7);
        i = i + 1;
    }
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "T0", j, r);
}
// T1: fresh control — 3 honest + 3 junk -> PROMOTE (rc=0).
fn c_t1(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_honest3(st, j, 7);
    let i:i64 = 0;
    while(i < 3) {
        let jj:i64 = 100000 + j * 1000 + i;
        x3_hx(st, jj, 0, 0, 80, 1000, 7);
        i = i + 1;
    }
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "T1", j, r);
}
// CLONE: exact replay of (j,0) refused at ingress (rc=4); the duplicate
// counts as ONE epoch -> SHORT_WINDOW (rc=14). C-CLONE: the digest binds
// (id, epoch, label, conf, meas, extra).
fn c_cl(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_he(st, j, 0, 7);
    let dup:i64 = x3_he(st, j, 0, 7);
    x3_he(st, j, 1, 7);
    let r:i64 = x3_decm(st, j, mode);
    pos = x3_line(ob, pos, "CLONE", j, r);
    pos = ob_puts(ob, pos, "CLONEdup ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, dup);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
// SEED-SPLIT: epochs 0 and 2 from j's seed, epoch 1 computed under a
// FOREIGN seed (the X2 transcript's cross-seed contamination, expressed
// without presenter-seed) -> WORLD_FAIL (rc=13): one seed per decision,
// C-SEED.
fn c_sd(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let seed:i64 = x3_seed(j);
    let fseed:i64 = x3_seed(5000 + j);
    x3_enqueue(st, j, 0, x3_wle(j, 0, seed), x3_wc(j, seed), x3_wm(j, seed), 7);
    x3_enqueue(st, j, 1, x3_wle(j, 1, fseed), x3_wc(j, fseed), x3_wm(j, fseed), 7);
    x3_enqueue(st, j, 2, x3_wle(j, 2, seed), x3_wc(j, seed), x3_wm(j, seed), 7);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "SEED-SPLIT", j, r);
}
// P0: payload split across the 3 epochs -> PAYLOAD_SPLIT (rc=7). C-RC7.
fn c_p0(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_he(st, j, 0, 7);
    x3_he(st, j, 1, 9);
    x3_he(st, j, 2, 7);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "P0", j, r);
}
// P1: payload-consistent control -> PROMOTE (rc=0).
fn c_p1(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_he(st, j, 0, 9);
    x3_he(st, j, 1, 9);
    x3_he(st, j, 2, 9);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "P1", j, r);
}
// Q0: queue starvation — 40 foreign records fill the queue, j's honest
// enqueue is refused (rc=2), decide on zero evidence -> NO_EVIDENCE
// (rc=10). C-Q0: SCOPE-CARRY — liveness only, measured not killed.
fn c_q0(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let i:i64 = 0;
    while(i < 40) {
        let jj:i64 = 200000 + j * 1000 + i;
        x3_hx(st, jj, 0, 0, 80, 1000, 7);
        i = i + 1;
    }
    let enq:i64 = x3_he(st, j, 0, 7);
    let r:i64 = x3_decm(st, j, mode);
    pos = x3_line(ob, pos, "Q0", j, r);
    pos = ob_puts(ob, pos, "Q0enq ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, enq);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
// R0: structural — 3 honest -> PROMOTE; the runlog carries the
// source-inspection record that no reset symbol exists in the decision API
// (C-R0, frozen choice: operator-only by absence).
fn c_r0(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_honest3(st, j, 7);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "R0", j, r);
}
// NOP-OMIT: conf 11 past the pin (1 past TOL_C=10) -> WORLD_FAIL (rc=13).
// C-NOP: the 30-half checks label, conf, meas; honest-but-off-pin admits
// nothing.
fn c_nn(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let e:i64 = 0;
    while(e < 3) { x3_he_off(st, j, e, 7, 11, 0); e = e + 1; }
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "NOP-OMIT", j, r);
}
// ID-POISON: j honest + a different id's honest triple queued; decide(j)
// must promote on j's own evidence only -> PROMOTE (rc=0). C-POISON.
fn c_nf(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let jj:i64 = 120 + j;
    x3_honest3(st, j, 7);
    x3_honest3(st, jj, 7);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "ID-POISON", j, r);
}
// FIRST-WINS: promote, then decide again -> ALREADY_PROMOTED (rc=6).
fn c_fw(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_honest3(st, j, 7);
    let r1:i64 = x3_decm(st, j, mode);
    let r2:i64 = x3_decm(st, j, mode);
    pos = x3_line(ob, pos, "FIRST-WINS", j, r1);
    return x3_line(ob, pos, "FIRST-WINS2", j, r2);
}
// C12 / C4 / C8: non-outvoting conf controls at +11 / +4 / +8.
fn c_c12(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let e:i64 = 0;
    while(e < 3) { x3_he_off(st, j, e, 7, 11, 0); e = e + 1; }
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "C12", j, r);
}
fn c_c4(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let e:i64 = 0;
    while(e < 3) { x3_he_off(st, j, e, 7, 4, 0); e = e + 1; }
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "C4", j, r);
}
fn c_c8(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let e:i64 = 0;
    while(e < 3) { x3_he_off(st, j, e, 7, 8, 0); e = e + 1; }
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "C8", j, r);
}
// H0: honest full-K control -> PROMOTE (rc=0), prereg bar >=115/120.
fn c_h0(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    x3_honest3(st, j, 7);
    let r:i64 = x3_decm(st, j, mode);
    return x3_line(ob, pos, "H0", j, r);
}

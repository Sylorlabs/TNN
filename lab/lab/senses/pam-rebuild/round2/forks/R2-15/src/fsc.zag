// fsc.zag — R2-15 (FS-C): cross-modal booster marginal-gain runner.
//
// Base path (mode 1, booster OFF — the ablation control): the R2-3 reference
// disposition on the visual channel: INSTALL iff the visual gate-span judgment
// agrees with the visual formation judgment (withhold iff they disagree).
// Booster (mode 0, booster ON): base PLUS cross-modal concurrence — the audio
// channel's independently-declared disjoint evidence (audio gate span, clean
// token) must judge the same symbol, else WITHHOLD.
//
// CLI: fsc <mode> <famfile> <report_path> <ledger_path>
//   mode: 0 = booster ON, 1 = booster OFF (ablation).
//   famfile: one fsc_<fam>_b<batch>.fsc batch file.
//
// Trial layout: u32 LE trial_len, "FSC1", truth u8, fam u8, idx u32 LE,
//   4 x (u32 LE blob_len + blob): visual-F, visual-G, audio-F, audio-G.
//   image payload: u16 w, u16 h, RGB. pcm payload: u32 rate, u32 ns, i16.
//
// Symbol space: visual code == audio code (S0=(CIRCLE,SAME),
// S1=(TRIANGLE,HIGHER), S2=(SQUARE,LOWER)); booster concurrence = ag == vf.
//
// Output: deterministic report (key=value) + hash-chained ledger.
// Zero RNG, no wall-clock. Byte-identical reruns required (KB-5).

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("r2p_front.zag")

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn z_write_new(path:[]u8, data:[]u8) i64 {
    // O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 420, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_write_all(fd, data);
    nio_close(fd);
    return n;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn z_atoi(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < s.len) {
        let c:i64 = s[i] as i64;
        if(c < 48 || c > 57) { return -1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn fail(msg:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "error", msg);
    nio_write_all(1, ob[0..pos]);
    return 1;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    if(a1.len == 0) { return fail("no_mode"); }
    if(a2.len == 0) { return fail("no_famfile"); }
    if(a3.len == 0) { return fail("no_report_path"); }
    if(a4.len == 0) { return fail("no_ledger_path"); }
    let mode:i64 = z_atoi(a1);
    if(mode < 0 || mode > 1) { return fail("bad_mode"); }

    // buffers: biggest batch file is 200 trials * ~78KB = 15.6MB
    let fbuf:[]u8 = nio_alloc(20000000);
    if(fbuf.len == 0) { return fail("alloc_failed"); }
    let repbuf:[]u8 = nio_alloc(65536);
    if(repbuf.len == 0) { return fail("alloc_failed"); }
    let ledbuf:[]u8 = nio_alloc(8000000);
    if(ledbuf.len == 0) { return fail("alloc_failed"); }

    let n:i64 = z_read(a2, fbuf, 20000000);
    if(n < 16) { return fail("famfile_read_failed"); }

    // ledger hash chain: h0 = SHA256("FSC-LEDGER-v1" || mode || famfile-tail)
    let hprev:[]u8 = nio_alloc(32);
    let hnew:[]u8 = nio_alloc(32);
    let hbin:[]u8 = nio_alloc(64);
    let seed:[]u8 = nio_alloc(64);
    let sp:i32 = 0;
    sp = ob_add(seed, sp, "FSC-LEDGER-v1");
    sp = ob_add(seed, sp, _zag_i64_to_str(mode));
    sp = ob_add(seed, sp, a2);
    if(ns_sha256(seed[0..sp], hprev) != 0) { return fail("sha_failed"); }
    nio_free(seed);

    let lpos:i32 = 0;
    lpos = ob_add(ledbuf, lpos, "FSC-LEDGER-v1\n");
    lpos = ob_kint(ledbuf, lpos, "mode", mode);
    lpos = ob_kv(ledbuf, lpos, "famfile", a2);

    let trials:i64 = 0;
    let installed:i64 = 0;
    let correct:i64 = 0;
    let falseinst:i64 = 0;
    let errors:i64 = 0;
    let fam_seen:i64 = -1;

    let off:i64 = 0;
    while(off < n) {
        if(off + 4 > n) { errors = errors + 1; off = n; }
        else {
            let tlen:i64 = t_get32(fbuf, off as i32);
            if(tlen < 16 || off + 4 + tlen > n) {
                errors = errors + 1;
                off = n;
            } else {
                let b0:i32 = (off + 4) as i32;
                // magic check
                if(fbuf[b0] != 70 || fbuf[b0+1] != 83 || fbuf[b0+2] != 67 || fbuf[b0+3] != 49) {
                    errors = errors + 1;
                } else {
                    let truth:i64 = fbuf[b0+4] as i64;
                    let fam:i64 = fbuf[b0+5] as i64;
                    if(fam_seen < 0) { fam_seen = fam; }
                    // idx u32 at b0+6 (not needed for scoring)
                    let p:i32 = b0 + 10;
                    let bl0:i64 = t_get32(fbuf, p); p = p + 4;
                    let visF:[]u8 = fbuf[p..(p + bl0 as i32)]; p = p + bl0 as i32;
                    let bl1:i64 = t_get32(fbuf, p); p = p + 4;
                    let visG:[]u8 = fbuf[p..(p + bl1 as i32)]; p = p + bl1 as i32;
                    let bl2:i64 = t_get32(fbuf, p); p = p + 4;
                    let audF:[]u8 = fbuf[p..(p + bl2 as i32)]; p = p + bl2 as i32;
                    let bl3:i64 = t_get32(fbuf, p); p = p + 4;
                    let audG:[]u8 = fbuf[p..(p + bl3 as i32)];

                    let vf:i64 = front_judge(2, visF) as i64;  // shapetrans
                    let vg:i64 = front_judge(2, visG) as i64;
                    let af:i64 = front_judge(3, audF) as i64;  // pitchdisc
                    let ag:i64 = front_judge(3, audG) as i64;

                    let base_admit:i64 = 0;
                    if(vf == vg) { base_admit = 1; }
                    let concur:i64 = 0;
                    if(ag == vf) { concur = 1; }
                    let inst:i64 = 0;
                    if(base_admit == 1) {
                        if(mode == 1) { inst = 1; }
                        else { if(concur == 1) { inst = 1; } }
                    }
                    let sym:i64 = 255;
                    if(inst == 1) {
                        installed = installed + 1;
                        sym = vf;
                        if(vf == truth) { correct = correct + 1; }
                        else { falseinst = falseinst + 1; }
                    }
                    trials = trials + 1;

                    // ledger entry
                    let bi:i32 = 0;
                    while(bi < 32) { hbin[bi] = hprev[bi]; bi = bi + 1; }
                    hbin[32] = ((trials >> 24) & 255) as u8;
                    hbin[33] = ((trials >> 16) & 255) as u8;
                    hbin[34] = ((trials >> 8) & 255) as u8;
                    hbin[35] = (trials & 255) as u8;
                    hbin[36] = (truth & 255) as u8;
                    hbin[37] = (vf & 255) as u8;
                    hbin[38] = (vg & 255) as u8;
                    hbin[39] = (af & 255) as u8;
                    hbin[40] = (ag & 255) as u8;
                    hbin[41] = (inst & 255) as u8;
                    hbin[42] = (sym & 255) as u8;
                    if(ns_sha256(hbin[0..43], hnew) != 0) { return fail("sha_failed"); }
                    lpos = ob_add(ledbuf, lpos, "e ");
                    lpos = ob_add(ledbuf, lpos, _zag_i64_to_str(trials));
                    lpos = ob_add(ledbuf, lpos, " ");
                    lpos = ob_add(ledbuf, lpos, _zag_i64_to_str(truth));
                    lpos = ob_add(ledbuf, lpos, " ");
                    lpos = ob_add(ledbuf, lpos, _zag_i64_to_str(vf));
                    lpos = ob_add(ledbuf, lpos, " ");
                    lpos = ob_add(ledbuf, lpos, _zag_i64_to_str(vg));
                    lpos = ob_add(ledbuf, lpos, " ");
                    lpos = ob_add(ledbuf, lpos, _zag_i64_to_str(af));
                    lpos = ob_add(ledbuf, lpos, " ");
                    lpos = ob_add(ledbuf, lpos, _zag_i64_to_str(ag));
                    lpos = ob_add(ledbuf, lpos, " ");
                    lpos = ob_add(ledbuf, lpos, _zag_i64_to_str(inst));
                    lpos = ob_add(ledbuf, lpos, " ");
                    lpos = ob_add(ledbuf, lpos, _zag_i64_to_str(sym));
                    lpos = ob_add(ledbuf, lpos, " ");
                    lpos = ob_add(ledbuf, lpos, ns_hex(hnew));
                    lpos = ob_add(ledbuf, lpos, "\n");
                    bi = 0;
                    while(bi < 32) { hprev[bi] = hnew[bi]; bi = bi + 1; }
                }
                off = off + 4 + tlen;
            }
        }
    }

    let hx:[]u8 = ns_hex(hprev);
    let rpos:i32 = 0;
    rpos = ob_kint(repbuf, rpos, "mode", mode);
    rpos = ob_kint(repbuf, rpos, "family", fam_seen);
    rpos = ob_kint(repbuf, rpos, "trials", trials);
    rpos = ob_kint(repbuf, rpos, "errors", errors);
    rpos = ob_kint(repbuf, rpos, "installed", installed);
    rpos = ob_kint(repbuf, rpos, "correct_install", correct);
    rpos = ob_kint(repbuf, rpos, "false_install", falseinst);
    let fi_rate:i64 = 0;
    if(trials > 0) { fi_rate = (falseinst * 10000) / trials; }
    rpos = ob_kint(repbuf, rpos, "false_install_x10000", fi_rate);
    let ci_rate:i64 = 0;
    if(trials > 0) { ci_rate = (correct * 10000) / trials; }
    rpos = ob_kint(repbuf, rpos, "correct_install_x10000", ci_rate);
    rpos = ob_kv(repbuf, rpos, "ledger_final", hx);

    lpos = ob_kv(ledbuf, lpos, "final", hx);
    lpos = ob_kint(ledbuf, lpos, "trials", trials);
    lpos = ob_kint(ledbuf, lpos, "installed", installed);
    lpos = ob_kint(ledbuf, lpos, "false_install", falseinst);

    if(z_write_new(a3, repbuf[0..rpos]) < 0) { return fail("report_write_failed"); }
    if(z_write_new(a4, ledbuf[0..lpos]) < 0) { return fail("ledger_write_failed"); }

    let ob:[]u8 = nio_alloc(1024);
    let q:i32 = 0;
    q = ob_kint(ob, q, "mode", mode);
    q = ob_kint(ob, q, "family", fam_seen);
    q = ob_kint(ob, q, "trials", trials);
    q = ob_kint(ob, q, "installed", installed);
    q = ob_kint(ob, q, "false_install", falseinst);
    q = ob_kv(ob, q, "ledger_final", hx);
    nio_write_all(1, ob[0..q]);
    return 0;
}

// gate2.zag — pure-Zag gate/ledger/bars (stage 2 of the mapping-freeze battery).
//
// Reads an AUGMENTED trial TSV (trial fields + precomputed percept fields;
// the percept dump is stage 1, the join is Python fixture glue). Runs the
// frozen R2-8 gate, hash-chained ledger, and bar summaries. No percept
// computation here — this stage is fast and runs 3x byte-identical.
//
// Augmented adversarial/recall row (22 tab fields):
//   trial_id task relX relS relP1 relP2 relP3 truth
//   jX cX fX jS cS jP1 cP1 fP1 jP2 cP2 fP2 jP3 cP3 fP3
// Augmented primary row (8 tab fields):
//   task rel truth judgment confidence margin feature ops
//
// CLI: gate2 <adv|recall|primary> <aug_tsv> <results_tsv> <ledger> <genesis> <summary>
//
// Output formats, ledger canonical form, bar rules: identical to gate_r28.zag
// (frozen by AMENDMENT_R2-8_MAPPING_FREEZE.md). Equivalence of the two
// stages vs the monolithic gate is proven by byte-identical outputs on a
// shared subset.

// ---- native: io ----
@import("R33_NATIVE_IO_V1.zag")
// ---- native: sha256 ----
@import("R33_NATIVE_SHA256_V2.zag")

fn seq(a:[]u8, b:[]u8) i32 {
    if(a.len != b.len) { return 0; }
    if(_zag_strcmp(a, b) == 1) { return 1; }
    return 0;
}
fn find_byte(buf:[]u8, s:i32, e:i32, b:u8) i32 {
    let i:i32 = s;
    while(i < e) {
        if(buf[i] == b) { return i; }
        i = i + 1;
    }
    return -1;
}
fn field(buf:[]u8, s:i32, e:i32, k:i32) []u8 {
    let i:i32 = s;
    let f:i32 = 0;
    let fs:i32 = s;
    while(i < e) {
        if(buf[i] == 9) {
            if(f == k) { return buf[fs..i]; }
            f = f + 1;
            fs = i + 1;
        }
        i = i + 1;
    }
    if(f == k) { return buf[fs..e]; }
    return buf[e..e];
}
fn task_id(task:[]u8) i32 {
    if(seq(task, "colordisc") == 1) { return 1; }
    if(seq(task, "colorconst") == 1) { return 2; }
    if(seq(task, "shapetrans") == 1) { return 3; }
    if(seq(task, "pitchdisc") == 1) { return 4; }
    if(seq(task, "timbredisc") == 1) { return 5; }
    if(seq(task, "motiondir") == 1) { return 6; }
    return 0;
}
fn sigma10(tid:i32) i64 {
    if(tid == 1) { return 28; }
    if(tid == 2) { return 542; }
    if(tid == 3) { return 175; }
    if(tid == 4) { return 402; }
    if(tid == 5) { return 26; }
    return 100;
}
fn parse_i64(s:[]u8) i64 {
    let v:i64 = 0;
    let neg:i64 = 0;
    let i:i32 = 0;
    if(s.len > 0 && s[0] == 45) { neg = 1; i = 1; }
    while(i < s.len as i32) {
        let c:u8 = s[i];
        if(c >= 48 && c <= 57) { v = v*10 + (c as i64) - 48; }
        i = i + 1;
    }
    if(neg == 1) { v = 0 - v; }
    return v;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at]=((v>>0)&255) as u8; b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8; b[at+3]=((v>>24)&255) as u8;
    b[at+4]=((v>>32)&255) as u8; b[at+5]=((v>>40)&255) as u8;
    b[at+6]=((v>>48)&255) as u8; b[at+7]=((v>>56)&255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64)<<8) | ((b[at+2] as i64)<<16) |
           ((b[at+3] as i64)<<24) | ((b[at+4] as i64)<<32) |
           ((b[at+5] as i64)<<40) | ((b[at+6] as i64)<<48) |
           ((b[at+7] as i64)<<56);
}
fn ob_add(b:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len as i32) { b[pos+i] = s[i]; i = i + 1; }
    return pos + (s.len as i32);
}
fn ob_kint(b:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    pos = ob_add(b, pos, k);
    pos = ob_add(b, pos, "=");
    pos = ob_add(b, pos, _zag_i64_to_str(v));
    pos = ob_add(b, pos, "\n");
    return pos;
}
fn z_cstr(s:[]u8) []u8 {
    let n:i32 = s.len as i32;
    let b:[]u8 = nio_alloc(n + 1);
    if(b.len == 0) { return s[0..0]; }
    let i:i32 = 0;
    while(i < n) { b[i] = s[i]; i = i + 1; }
    b[n] = 0;
    return b;
}
fn z_open_write(path:[]u8) i64 {
    let p:[]u8 = z_cstr(path);
    if(p.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(p) as i64, 577, 420, 0, 0, 0);
    nio_free(p);
    return fd;
}
fn z_read(path:[]u8, buf:[]u8, cap:i32) i64 {
    let p:[]u8 = z_cstr(path);
    if(p.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(p) as i64, 0, 0, 0, 0, 0);
    nio_free(p);
    if(fd < 0) { return -1; }
    let n:i64 = _zag_raw_syscall(0, fd, _zag_slice_ptr(buf) as i64, cap as i64, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return n;
}
// (nio_write_all, nio_close come from R33_NATIVE_IO_V1.zag)
// Chunked writer: nio_write_all rejects >1MB, so loop in 900KB chunks.
fn nio_write_chunks(fd:i64, b:[]u8) i64 {
    let n:i64 = b.len as i64;
    let at:i64 = 0;
    let CH:i64 = 900000;
    while(at < n) {
        let rem:i64 = n - at;
        if(rem > CH) { rem = CH; }
        let w:i64 = nio_write_all(fd, b[at as i32..(at+rem) as i32]);
        if(w != rem) { return at; }
        at = at + rem;
    }
    return at;
}
// counters
fn cadd(c:[]u8, i:i32, d:i64) void { t_put64(c, i*8, t_get64(c, i*8) + d); }
fn cget(c:[]u8, i:i32) i64 { return t_get64(c, i*8); }
// ledger
fn ledger_append(prev:[]u8, dgst:[]u8, inb:[]u8, canon:[]u8, cn:i32,
                 lbuf:[]u8, lpos:i32) i32 {
    let ip:i32 = 0;
    ip = ob_add(inb, ip, prev);
    ip = ob_add(inb, ip, canon[0..cn]);
    if(ns_sha256(inb[0..ip], dgst) != 0) { return -1; }
    let eh:[]u8 = ns_hex(dgst);
    let p:i32 = lpos;
    p = ob_add(lbuf, p, prev);
    p = ob_add(lbuf, p, " ");
    p = ob_add(lbuf, p, eh);
    p = ob_add(lbuf, p, " ");
    p = ob_add(lbuf, p, canon[0..cn]);
    p = ob_add(lbuf, p, "\n");
    let i:i32 = 0;
    while(i < 64) { prev[i] = eh[i]; i = i + 1; }
    return p;
}
fn pfail(jP:[]u8, fP:i64, jX:[]u8, fX:i64, s10:i64, ok:i64) i32 {
    if(ok == 0) { return 0; }
    if(seq(jP, jX) == 0) { return 1; }
    let d:i64 = fX - fP;
    if(d < 0) { d = -d; }
    if(d*10 > s10) { return 1; }
    return 0;
}
fn tf_str(v:i32) []u8 {
    if(v == 1) { return "True"; }
    return "False";
}
fn iw_str(v:i32) []u8 {
    if(v == 1) { return "INSTALL"; }
    return "WITHHOLD";
}
fn fr_str(v:i32) []u8 {
    if(v == 1) { return "FAIL"; }
    return "PASS";
}
fn bool_str(v:i32) []u8 {
    if(v == 1) { return "true"; }
    return "false";
}
fn sum_kv(sbuf:[]u8, sp:i32, k:[]u8, v:[]u8) i32 {
    sp = ob_add(sbuf, sp, k);
    sp = ob_add(sbuf, sp, "=");
    sp = ob_add(sbuf, sp, v);
    sp = ob_add(sbuf, sp, "\n");
    return sp;
}

// ---------------- adversarial/recall trial from augmented row ----------------
fn do_adv2(mode:i32, tid:i32,
           trial_id:[]u8, task:[]u8, relX:[]u8, relS:[]u8,
           relP1:[]u8, relP2:[]u8, relP3:[]u8, truth:[]u8,
           jX:[]u8, cX:i64, fX:i64, jS:[]u8, cS:i64,
           jP1:[]u8, cP1:i64, fP1:i64, jP2:[]u8, cP2:i64, fP2:i64,
           jP3:[]u8, cP3:i64, fP3:i64,
           canon:[]u8, inb:[]u8, dgst:[]u8, prev:[]u8,
           rbuf:[]u8, lbuf:[]u8, rpos:i32, lpos:i32, c:[]u8) i64 {
    let ok:i64 = 1;
    if(seq(jX, "?") == 1 || seq(jS, "?") == 1) { ok = 0; }
    if(seq(jP1, "?") == 1 || seq(jP2, "?") == 1 || seq(jP3, "?") == 1) { ok = 0; }
    let leg_i:i32 = 0;
    let f1:i32 = 0;
    let f2:i32 = 0;
    let f3:i32 = 0;
    if(ok == 1) {
        if(seq(jX, jS) == 1 && cX >= 700 && cS >= 700) { leg_i = 1; }
        let s10:i64 = sigma10(tid);
        f1 = pfail(jP1, fP1, jX, fX, s10, ok);
        f2 = pfail(jP2, fP2, jX, fX, s10, ok);
        f3 = pfail(jP3, fP3, jX, fX, s10, ok);
    }
    let d_full:i32 = 0;
    let d_legi:i32 = 0;
    let d_noc:i32 = 0;
    if(leg_i == 1 && f1 == 1 && f2 == 1 && f3 == 1) { d_full = 1; }
    if(leg_i == 1) { d_legi = 1; }
    if(ok == 1 && cX >= 700) { d_noc = 1; }
    cadd(c, 0, 1);
    if(ok == 0) { cadd(c, 1, 1); }
    let wrong:i32 = 0;
    if(seq(jX, truth) == 0) { wrong = 1; }
    if(mode == 0) {
        if(wrong == 1) { cadd(c, 8, 1); }
        if(d_full == 1 && wrong == 1) { cadd(c, 2, 1); }
        if(d_legi == 1 && wrong == 1) { cadd(c, 3, 1); }
        if(d_noc == 1 && wrong == 1) { cadd(c, 4, 1); }
        if(d_full != d_noc) { cadd(c, 5, 1); }
        if(wrong == 1 && cX >= 700) {
            cadd(c, 6, 1);
            if(d_full == 0) { cadd(c, 7, 1); }
        }
    }
    if(mode == 1) {
        if(ok == 1 && wrong == 0) {
            cadd(c, 9, 1);
            if(d_full == 1) { cadd(c, 10, 1); }
        }
    }
    // ledger canon (identical to gate_r28)
    let cn:i32 = 0;
    cn = ob_add(canon, cn, trial_id); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, task); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, relX); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, relS); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, relP1); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, relP2); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, relP3); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, truth); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, jX); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(cX)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(fX)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, jS); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(cS)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, jP1); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(cP1)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(fP1)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, fr_str(f1)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, jP2); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(cP2)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(fP2)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, fr_str(f2)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, jP3); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(cP3)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(fP3)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, fr_str(f3)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, tf_str(leg_i)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, iw_str(d_full));
    lpos = ledger_append(prev, dgst, inb, canon, cn, lbuf, lpos);
    // results TSV (identical to gate_r28)
    let rp:i32 = rpos;
    rp = ob_add(rbuf, rp, trial_id); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, task); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, relX); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, relS); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, relP1); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, relP2); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, relP3); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, truth); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, jX); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(cX)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(fX)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, jS); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(cS)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, jP1); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(cP1)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(fP1)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, fr_str(f1)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, jP2); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(cP2)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(fP2)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, fr_str(f2)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, jP3); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(cP3)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(fP3)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, fr_str(f3)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, tf_str(leg_i)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, iw_str(d_full)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, iw_str(d_legi)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, iw_str(d_noc)); rp = ob_add(rbuf, rp, "\n");
    let packed:i64 = ((rp as i64) << 32) | (lpos as i64);
    return packed;
}
// ---------------- primary trial from augmented row ----------------
fn do_prim2(tid:i32, task:[]u8, rel:[]u8, truth:[]u8,
            j:[]u8, c:i64, m:i64, f:i64, o:i64,
            canon:[]u8, inb:[]u8, dgst:[]u8, prev:[]u8,
            rbuf:[]u8, lbuf:[]u8, rpos:i32, lpos:i32, cc:[]u8) i64 {
    cadd(cc, 12, 1);
    cadd(cc, 40+tid, 1);
    let ok:i64 = 1;
    if(seq(j, "?") == 1) { ok = 0; }
    if(ok == 1 && seq(j, truth) == 1) {
        cadd(cc, 11, 1);
        cadd(cc, 20+tid, 1);
    }
    cadd(cc, 13, o);
    let cn:i32 = 0;
    cn = ob_add(canon, cn, task); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, rel); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, truth); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, j); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(c)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(m)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(f)); cn = ob_add(canon, cn, "|");
    cn = ob_add(canon, cn, _zag_i64_to_str(o));
    lpos = ledger_append(prev, dgst, inb, canon, cn, lbuf, lpos);
    let rp:i32 = rpos;
    rp = ob_add(rbuf, rp, task); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, rel); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, truth); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, j); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(c)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(m)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(f)); rp = ob_add(rbuf, rp, "\t");
    rp = ob_add(rbuf, rp, _zag_i64_to_str(o)); rp = ob_add(rbuf, rp, "\n");
    let packed:i64 = ((rp as i64) << 32) | (lpos as i64);
    return packed;
}

// ---------------- main ----------------
fn main() i32 {
    let mode_s:[]u8 = _zag_arg(1);
    let tsv_path:[]u8 = _zag_arg(2);
    let res_path:[]u8 = _zag_arg(3);
    let led_path:[]u8 = _zag_arg(4);
    let genesis:[]u8 = _zag_arg(5);
    let sum_path:[]u8 = _zag_arg(6);
    let mode:i32 = 0;
    if(seq(mode_s, "recall") == 1) { mode = 1; }
    if(seq(mode_s, "primary") == 1) { mode = 2; }
    let tsv:[]u8 = nio_alloc(8388608);
    let canon:[]u8 = nio_alloc(4096);
    let inb:[]u8 = nio_alloc(2048);
    let dgst:[]u8 = nio_alloc(32);
    let prev:[]u8 = nio_alloc(64);
    let rbuf:[]u8 = nio_alloc(4194304);
    let lbuf:[]u8 = nio_alloc(6291456);
    let c:[]u8 = nio_alloc(512);
    let sbuf:[]u8 = nio_alloc(65536);
    let pbuf:[]u8 = nio_alloc(256);
    if(tsv.len == 0 || rbuf.len == 0 || lbuf.len == 0 || c.len == 0) { return 99; }
    let zi:i32 = 0;
    while(zi < 64) { t_put64(c, zi*8, 0); zi = zi + 1; }
    if(ns_sha256(genesis, dgst) != 0) { return 98; }
    let geh:[]u8 = ns_hex(dgst);
    let gi:i32 = 0;
    while(gi < 64) { prev[gi] = geh[gi]; gi = gi + 1; }
    let lpos:i32 = 0;
    lpos = ob_add(lbuf, lpos, "genesis ");
    lpos = ob_add(lbuf, lpos, prev);
    lpos = ob_add(lbuf, lpos, "\n");
    let tn:i64 = z_read(tsv_path, tsv, 8388608);
    if(tn < 0) { return 97; }
    let tni:i32 = tn as i32;
    let rpos:i32 = 0;
    let s:i32 = 0;
    let ntrials:i32 = 0;
    while(s < tni) {
        let eol:i32 = find_byte(tsv, s, tni, 10);
        if(eol < 0) { eol = tni; }
        if(eol > s) {
            if(mode == 2) {
                let task:[]u8 = field(tsv, s, eol, 0);
                let rel:[]u8 = field(tsv, s, eol, 1);
                let truth:[]u8 = field(tsv, s, eol, 2);
                let j:[]u8 = field(tsv, s, eol, 3);
                let cc:i64 = parse_i64(field(tsv, s, eol, 4));
                let mm:i64 = parse_i64(field(tsv, s, eol, 5));
                let ff:i64 = parse_i64(field(tsv, s, eol, 6));
                let oo:i64 = parse_i64(field(tsv, s, eol, 7));
                let tid2:i32 = task_id(task);
                let pk:i64 = do_prim2(tid2, task, rel, truth, j, cc, mm, ff, oo,
                                      canon, inb, dgst, prev,
                                      rbuf, lbuf, rpos, lpos, c);
                rpos = (pk >> 32) as i32;
                lpos = (pk & 4294967295) as i32;
            } else {
                let trial_id:[]u8 = field(tsv, s, eol, 0);
                let task:[]u8 = field(tsv, s, eol, 1);
                let relX:[]u8 = field(tsv, s, eol, 2);
                let relS:[]u8 = field(tsv, s, eol, 3);
                let relP1:[]u8 = field(tsv, s, eol, 4);
                let relP2:[]u8 = field(tsv, s, eol, 5);
                let relP3:[]u8 = field(tsv, s, eol, 6);
                let truth:[]u8 = field(tsv, s, eol, 7);
                let jX:[]u8 = field(tsv, s, eol, 8);
                let cX:i64 = parse_i64(field(tsv, s, eol, 9));
                let fX:i64 = parse_i64(field(tsv, s, eol, 10));
                let jS:[]u8 = field(tsv, s, eol, 11);
                let cS:i64 = parse_i64(field(tsv, s, eol, 12));
                let jP1:[]u8 = field(tsv, s, eol, 13);
                let cP1:i64 = parse_i64(field(tsv, s, eol, 14));
                let fP1:i64 = parse_i64(field(tsv, s, eol, 15));
                let jP2:[]u8 = field(tsv, s, eol, 16);
                let cP2:i64 = parse_i64(field(tsv, s, eol, 17));
                let fP2:i64 = parse_i64(field(tsv, s, eol, 18));
                let jP3:[]u8 = field(tsv, s, eol, 19);
                let cP3:i64 = parse_i64(field(tsv, s, eol, 20));
                let fP3:i64 = parse_i64(field(tsv, s, eol, 21));
                let tid:i32 = task_id(task);
                let pk2:i64 = do_adv2(mode, tid, trial_id, task, relX, relS,
                                      relP1, relP2, relP3, truth,
                                      jX, cX, fX, jS, cS,
                                      jP1, cP1, fP1, jP2, cP2, fP2,
                                      jP3, cP3, fP3,
                                      canon, inb, dgst, prev,
                                      rbuf, lbuf, rpos, lpos, c);
                rpos = (pk2 >> 32) as i32;
                lpos = (pk2 & 4294967295) as i32;
            }
            ntrials = ntrials + 1;
        }
        s = eol + 1;
    }
    let rfd:i64 = z_open_write(res_path);
    if(rfd < 0) { return 96; }
    if(nio_write_chunks(rfd, rbuf[0..rpos]) != rpos as i64) { return 95; }
    nio_close(rfd);
    let lfd:i64 = z_open_write(led_path);
    if(lfd < 0) { return 94; }
    if(nio_write_chunks(lfd, lbuf[0..lpos]) != lpos as i64) { return 93; }
    nio_close(lfd);
    if(ns_sha256(rbuf[0..rpos], dgst) != 0) { return 92; }
    let rhex:[]u8 = ns_hex(dgst);
    if(ns_sha256(lbuf[0..lpos], dgst) != 0) { return 91; }
    let lhex:[]u8 = ns_hex(dgst);
    let sp:i32 = 0;
    sp = sum_kv(sbuf, sp, "ledger_final_hash", prev);
    sp = sum_kv(sbuf, sp, "results_sha256", rhex);
    sp = sum_kv(sbuf, sp, "ledger_sha256", lhex);
    if(mode == 2) {
        let bc:i64 = cget(c, 11);
        let bn:i64 = cget(c, 12);
        let b1p:i32 = 0;
        if(5*bc >= 3*bn) { b1p = 1; }
        sp = ob_kint(sbuf, sp, "B1_correct", bc);
        sp = ob_kint(sbuf, sp, "B1_n", bn);
        sp = sum_kv(sbuf, sp, "B1_pass", bool_str(b1p));
        sp = ob_kint(sbuf, sp, "B3_total_ops", cget(c, 13));
        sp = ob_kint(sbuf, sp, "B3_n", bn);
        let t2:i32 = 1;
        while(t2 <= 6) {
            let nm:[]u8 = "colordisc";
            if(t2 == 2) { nm = "colorconst"; }
            if(t2 == 3) { nm = "shapetrans"; }
            if(t2 == 4) { nm = "pitchdisc"; }
            if(t2 == 5) { nm = "timbredisc"; }
            if(t2 == 6) { nm = "motiondir"; }
            let kp:i32 = 0;
            kp = ob_add(pbuf, kp, "pt_correct_");
            kp = ob_add(pbuf, kp, nm);
            sp = ob_kint(sbuf, sp, pbuf[0..kp], cget(c, 20+t2));
            kp = 0;
            kp = ob_add(pbuf, kp, "pt_n_");
            kp = ob_add(pbuf, kp, nm);
            sp = ob_kint(sbuf, sp, pbuf[0..kp], cget(c, 40+t2));
            t2 = t2 + 1;
        }
    }
    if(mode == 1) {
        let dn:i64 = cget(c, 9);
        let ist:i64 = cget(c, 10);
        let rp2:i32 = 0;
        if(dn > 0 && 10*ist >= 7*dn) { rp2 = 1; }
        sp = ob_kint(sbuf, sp, "n_recall_trials", cget(c, 0));
        sp = ob_kint(sbuf, sp, "recall_correct", dn);
        sp = ob_kint(sbuf, sp, "recall_installed", ist);
        sp = sum_kv(sbuf, sp, "recall_pass", bool_str(rp2));
    }
    if(mode == 0) {
        let n:i64 = cget(c, 0);
        let nf:i64 = cget(c, 1);
        let fi:i64 = cget(c, 2);
        let fig:i64 = cget(c, 3);
        let fin:i64 = cget(c, 4);
        let chg:i64 = cget(c, 5);
        let hcw:i64 = cget(c, 6);
        let hcf:i64 = cget(c, 7);
        let b5p:i32 = 0;
        if(200*fi < n) { b5p = 1; }
        let kb2p:i32 = 0;
        if(hcw > 0 && 20*hcf >= 19*hcw) { kb2p = 1; }
        let b4p:i32 = 0;
        if(10*chg >= n && fin > fi) { b4p = 1; }
        let alp:i32 = 0;
        if(500*(fig - fi) >= n) { alp = 1; }
        sp = ob_kint(sbuf, sp, "n_trials", n);
        sp = ob_kint(sbuf, sp, "n_percept_failed_trials", nf);
        sp = ob_kint(sbuf, sp, "B5_false_installs", fi);
        sp = sum_kv(sbuf, sp, "B5_pass", bool_str(b5p));
        sp = ob_kint(sbuf, sp, "KB2_highconf_wrong", hcw);
        sp = ob_kint(sbuf, sp, "KB2_self_flagged", hcf);
        sp = sum_kv(sbuf, sp, "KB2_pass", bool_str(kb2p));
        sp = ob_kint(sbuf, sp, "B4_decisions_changed", chg);
        sp = ob_kint(sbuf, sp, "B4_fi_contractless", fin);
        sp = sum_kv(sbuf, sp, "B4_pass", bool_str(b4p));
        sp = ob_kint(sbuf, sp, "legii_fi_legi_only", fig);
        sp = sum_kv(sbuf, sp, "legii_ablation_pass", bool_str(alp));
    }
    let sfd:i64 = z_open_write(sum_path);
    if(sfd < 0) { return 90; }
    if(nio_write_all(sfd, sbuf[0..sp]) != sp as i64) { return 89; }
    nio_close(sfd);
    let qp:i32 = 0;
    qp = ob_add(pbuf, qp, "gate2 done trials=");
    qp = ob_add(pbuf, qp, _zag_i64_to_str(ntrials as i64));
    qp = ob_add(pbuf, qp, " ledger_final=");
    qp = ob_add(pbuf, qp, prev);
    qp = ob_add(pbuf, qp, "\n");
    nio_write_all(1, pbuf[0..qp]);
    return 0;
}

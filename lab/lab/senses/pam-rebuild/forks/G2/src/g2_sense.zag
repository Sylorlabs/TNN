// g2_sense.zag — FORK G2: Predictive Residual Percept (PRP).
//
// Pure-Zag perceptual organ implementing Grok-4.6 hypothesis G2:
//   (a) Generates a forward prediction from current invariants and outputs
//       the residual vector as the percept to unified memory.
//   (b) PERCEPT: 256-element vector of 8-bit signed residuals in invariant
//       space. Layout: dims 0-63 fine residuals (primary invariants),
//       64-127 coarse residuals (primary), 128-191 fine residuals
//       (secondary/stability invariants), 192-255 reserved (0).
//   (c) MEMORY CONTRACT (executable, load-bearing):
//         INSTALL iff residual_norm < EPS AND pred_hash == obs_hash,
//         else WITHHOLD. Retrieval ranks installed memories by
//         prediction-consistency (agreement of coarse predicted bytes).
//   (d) EFFICIENCY: O(N) invariant extraction; 256-byte percept.
//   (f) KILL BAR: false-install > 8% (adversarial, per install) or
//       integration success < 85%.
//
// Forward model (all tasks): "the world continues as it is" — stationarity /
// continuity prior, generated deterministically from current invariants.
//
// CLI:
//   sense <task> <fixture>      single percept + disposition + ledger line
//   sense batch <manifest>      memory stream over manifest lines:
//                               "<task> <fixture> <contract|ablated>"
// stdout: key=value lines. Exit 0 on success, 1 with error= on failure.
//
// All arithmetic integer (i64). No RNG, no wall-clock, no uninitialized
// reads: repeated runs are byte-identical.
//
// znc constraints honored (see a_raw/BUILD_LOG.md): no argc gate,
// []u8 arenas + LE accessors only (never `as []i32`), `_zag_strcmp`==1 on
// equality, no slice > 2^25, no `};`, explicit array init, NUL-terminated
// paths via z_cstr, `_zag_raw_syscall` exactly 7 args, shallow else-nesting
// (no else at all — sequential ifs), `return;` with semicolon in void fns.

@import("R33_NATIVE_IO_V1.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}

// ---------------- ops counter --------------------------------------------
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- integer math -------------------------------------------
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
fn iclamp(v:i64, lo:i64, hi:i64) i64 {
    if(v < lo) { return lo; }
    if(v > hi) { return hi; }
    return v;
}

// ---------------- file IO -------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn z_write(path:[]u8, data:[]u8) i64 {
    // create/truncate write (O_WRONLY|O_CREAT|O_TRUNC = 577), mode 0644
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7411; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 420, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7412; }
    let n:i64 = nio_write_all(fd, data);
    nio_close(fd);
    return n;
}

// ---------------- stdout line builder ------------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
// signed i64 -> decimal (handles negatives; _zag_i64_to_str is used for
// the non-negative tail)
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    if(v < 0) {
        pos = ob_add(ob, pos, "-");
        pos = ob_add(ob, pos, _zag_i64_to_str(0 - v));
    }
    if(v >= 0) {
        pos = ob_add(ob, pos, _zag_i64_to_str(v));
    }
    pos = ob_add(ob, pos, "\n");
    return pos;
}
// appends "name=value;" (compact debug_vec building)
fn ob_pair(ob:[]u8, pos:i32, name:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, name);
    pos = ob_add(ob, pos, "=");
    if(v < 0) {
        pos = ob_add(ob, pos, "-");
        pos = ob_add(ob, pos, _zag_i64_to_str(0 - v));
    }
    if(v >= 0) {
        pos = ob_add(ob, pos, _zag_i64_to_str(v));
    }
    pos = ob_add(ob, pos, ";");
    return pos;
}
fn hexdig(v:i64) u8 {
    let d:i64 = v & 15;
    if(d < 10) { return (48 + d) as u8; }
    return (87 + d) as u8;
}
// appends 16 lowercase hex chars of a 64-bit value (big-endian nibbles)
fn ob_hex64(ob:[]u8, pos:i32, v:i64) i32 {
    let sh:i64 = 60;
    while(sh >= 0) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = hexdig((v >> sh) & 15);
        pos = pos + 1;
        sh = sh - 4;
    }
    return pos;
}
fn ob_khex(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_hex64(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn fail(task:[]u8, reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "G2");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "error", reason);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// ---------------- FNV-1a 64 ----------------------------------------------
fn fnv64_init() i64 {
    return 0 - 3750763034362895579; // 14695981039346656037 as i64
}
fn fnv64_add(h:i64, b:i64) i64 {
    // h = (h ^ (b & 255)) * 1099511628211, mod 2^64 via i64 wraparound
    let x:i64 = (h ^ (b & 255)) * 1099511628211;
    return x;
}
fn fnv64_bytes(h:i64, b:[]u8, n:i32) i64 {
    let i:i32 = 0;
    while(i < n) {
        h = fnv64_add(h, b[i] as i64);
        i = i + 1;
    }
    return h;
}
fn fnv64_str(h:i64, s:[]u8) i64 {
    return fnv64_bytes(h, s, s.len);
}

// ---------------- residual-vector helpers --------------------------------
// q8: quantize invariant v (in units of `scale`) to signed 8-bit.
fn q8(v:i64, scale:i64) i64 {
    if(scale <= 0) { return 0; }
    return iclamp(v / scale, -128, 127);
}
// coarse 16-level code of a fine i8 value (truncation toward zero is fine:
// determinism only needs observed/predicted to use the same rule).
fn q4c(f:i64) i64 {
    return f / 16;
}
// signed residual of observed vs predicted fine values, clamped to i8.
fn res8(o:i64, p:i64) i64 {
    return iclamp(o - p, -128, 127);
}
// zero a []u8 arena explicitly (allocator does not guarantee zeros).
fn zero8(b:[]u8) void {
    let i:i32 = 0;
    while(i < b.len) { b[i] = 0; i = i + 1; }
}

// ================= audio helpers (ported from Approach A) =================
// sin(p) * 1024, p = turn in [0, 2^32). Table-free fixed-point Taylor with
// quadrant folding. (Verified: sin30=511 sin60=886 sin90=1025 sin45=724.)
fn ng_sin1024(p:i64) i64 {
    let q:i64 = (p >> 30) & 3;
    let fr:i64 = p & 1073741823;
    let x:i64 = (fr * 1608) >> 30;
    let xx:i64 = x;
    if(q == 1 || q == 3) { xx = 1608 - x; }
    let x2:i64 = xx * xx;
    let term:i64 = xx;
    let sum:i64 = xx;
    let k:i64 = 1;
    while(k <= 7) {
        term = 0 - term * x2 / ((2 * k) * (2 * k + 1) * 1048576);
        sum = sum + term;
        k = k + 1;
    }
    if(q >= 2) { return 0 - sum; }
    return sum;
}

// Peak amplitude (for the deadband).
fn pcm_peak(buf:[]u8, off:i32, cnt:i32) i64 {
    let p:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let s:i64 = iabs(t_geti16(buf, off + i * 2));
        if(s > p) { p = s; }
        i = i + 1;
    }
    return p;
}
// Harmonic energy Σ_{h=1..nhmax} E_h at harmonics of f0m (milli-Hz),
// over w samples starting at off. E_h from a direct DFT using the integer
// table-free sin. Harmonics at/above Nyquist are skipped. op counts
// 2 element-visits per (sample, harmonic).
fn harm_energy(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, nhmax:i32, op:[]u8) i64 {
    if(f0m <= 0 || w < 64) { return 0; }
    let pinc1:i64 = f0m * 4294967296 / (1000 * sr);
    if(pinc1 <= 0) { return 0; }
    let tot:i64 = 0;
    let h:i64 = 1;
    while(h <= nhmax as i64) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let pinc:i64 = h * pinc1;
        let re:i64 = 0;
        let im:i64 = 0;
        let i:i32 = 0;
        while(i < w) {
            let s:i64 = t_geti16(buf, off + i * 2);
            let p:i64 = ((i as i64) * pinc) & 4294967295;
            re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
            im = im + s * ng_sin1024(p) / 1024;
            i = i + 1;
        }
        op_add(op, (2 * w) as i64);
        tot = tot + (re * re + im * im) / 1048576;
        h = h + 1;
    }
    return tot;
}
// Harmonic spectral centroid r = 1000 * Σ h*E_h / Σ E_h (per-mille),
// h = 1..8. Returns -1 if unmeasurable.
fn harm_centroid(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, op:[]u8) i64 {
    if(f0m <= 0 || w < 64) { return -1; }
    let pinc1:i64 = f0m * 4294967296 / (1000 * sr);
    if(pinc1 <= 0) { return -1; }
    let se:i64 = 0;
    let she:i64 = 0;
    let h:i64 = 1;
    while(h <= 8) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let pinc:i64 = h * pinc1;
        let re:i64 = 0;
        let im:i64 = 0;
        let i:i32 = 0;
        while(i < w) {
            let s:i64 = t_geti16(buf, off + i * 2);
            let p:i64 = ((i as i64) * pinc) & 4294967295;
            re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
            im = im + s * ng_sin1024(p) / 1024;
            i = i + 1;
        }
        op_add(op, (2 * w) as i64);
        let e:i64 = (re * re + im * im) / 1048576;
        se = se + e;
        she = she + h * e;
        h = h + 1;
    }
    if(se <= 0) { return -1; }
    op_add(op, 8);
    return 1000 * she / se;
}
// Robust fundamental in milli-Hz for harmonic tones.
// Stage 1: autocorrelation -> coarse period (parabolic refinement).
// Stage 2: maximize harmonic energy on a fine grid around coarse
//          (±3%, 0.1% steps), parabolic interpolation -> precise f0.
// An octave guard keeps f0m/2 / f0m*2 only if clearly stronger.
// Supported f0 range: 50..2000 Hz. Returns 0 on failure.
fn f0_robust(buf:[]u8, off:i32, cnt:i32, sr:i64, op:[]u8) i64 {
    let w:i32 = cnt;
    if(w > 2048) { w = 2048; }
    if(w < 512) { return 0; }
    let peak:i64 = pcm_peak(buf, off, w);
    if(peak < 256) { return 0; }
    let ms:i64 = 0;
    let i:i32 = 0;
    while(i < w) { ms = ms + t_geti16(buf, off + i * 2); i = i + 1; }
    let mean:i64 = ms / (w as i64);
    op_add(op, (2 * w) as i64);
    let lmin:i32 = (sr / 2000) as i32;
    if(lmin < 2) { lmin = 2; }
    let lmax:i32 = (sr / 50) as i32;
    if(lmax > w / 3) { lmax = w / 3; }
    if(lmax < lmin + 2) { return 0; }
    let nl:i32 = lmax - lmin + 3;
    let ra:[]u8 = nio_alloc((nl * 8) as i32);
    if(ra.len == 0) { return 0; }
    let l:i32 = lmin - 1;
    while(l <= lmax + 1) {
        let acc:i64 = 0;
        let nn:i32 = w - l;
        let n:i32 = 0;
        while(n < nn) {
            let a:i64 = t_geti16(buf, off + n * 2) - mean;
            let b:i64 = t_geti16(buf, off + (n + l) * 2) - mean;
            acc = acc + a * b;
            n = n + 1;
        }
        op_add(op, nn as i64);
        t_put64(ra, (l - (lmin - 1)) * 8, acc);
        l = l + 1;
    }
    let gmax:i64 = 0;
    l = lmin;
    while(l <= lmax) {
        let r:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
        if(r > gmax) { gmax = r; }
        l = l + 1;
    }
    let lstar:i32 = -1;
    let r0:i64 = 0;
    let rm:i64 = 0;
    let rp:i64 = 0;
    if(gmax > 0) {
        l = lmin;
        while(l <= lmax) {
            let q0:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
            let qm:i64 = t_get64(ra, (l - 1 - (lmin - 1)) * 8);
            let qp:i64 = t_get64(ra, (l + 1 - (lmin - 1)) * 8);
            if(q0 >= qm && q0 >= qp && q0 * 2 >= gmax) {
                lstar = l;
                r0 = q0;
                rm = qm;
                rp = qp;
                break;
            }
            l = l + 1;
        }
    }
    nio_free(ra);
    if(lstar < 0) { return 0; }
    // parabolic refinement of the period (x1024 samples)
    let den:i64 = 2 * (rm - 2 * r0 + rp);
    let poff:i64 = 0;
    if(den != 0) { poff = (rm - rp) * 1024 / den; }
    if(poff < -512) { poff = -512; }
    if(poff > 512) { poff = 512; }
    let period_1024:i64 = (lstar as i64) * 1024 + poff;
    if(period_1024 <= 0) { return 0; }
    let f0c:i64 = sr * 1000 * 1024 / period_1024;
    // stage 2: fine grid f0c*(1 + k*0.001), k in -30..30
    let best_k:i32 = -30;
    let best_s:i64 = -1;
    let k:i32 = -30;
    while(k <= 30) {
        let f0k:i64 = f0c + f0c * (k as i64) / 1000;
        let s:i64 = harm_energy(buf, off, w, sr, f0k, 6, op);
        if(s > best_s) { best_s = s; best_k = k; }
        k = k + 1;
    }
    if(best_s <= 0) { return 0; }
    let sm:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k - 1) as i64) / 1000, 6, op);
    let sp:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k + 1) as i64) / 1000, 6, op);
    let den2:i64 = 2 * (sm - 2 * best_s + sp);
    let koff:i64 = 0;
    if(den2 != 0) { koff = (sm - sp) * 1024 / den2; }
    if(koff < -512) { koff = -512; }
    if(koff > 512) { koff = 512; }
    let f0m:i64 = f0c + f0c * ((best_k as i64) * 1024 + koff) / (1024 * 1000);
    if(f0m <= 0) { return 0; }
    // octave guard with matched true-harmonic coverage
    let e0:i64 = harm_energy(buf, off, w, sr, f0m, 8, op);
    let ehalf:i64 = harm_energy(buf, off, w, sr, f0m / 2, 16, op);
    let edbl:i64 = harm_energy(buf, off, w, sr, f0m * 2, 4, op);
    if(ehalf > e0 + e0 / 20) { return f0m / 2; }
    if(edbl > e0 + e0 / 20) { return f0m * 2; }
    return f0m;
}

// ================= percept-state (ps) arena =================================
// Layout (bytes): 0 jcode(i64), 8 conf(i64), 16 nd(i64), 24 nsd(i64),
// 32 pred_ok(i64), 40 fobs[64], 104 fpre[64], 168 sobs[64], 232 spre[64],
// 296 norm(i64), 304 pred_hash(i64), 312 obs_hash(i64), 320 disp(i64).
// which: 0=fobs(observed primary) 1=fpre(predicted primary)
//        2=sobs(observed secondary) 3=spre(predicted secondary)
fn ps_put(ps:[]u8, which:i32, i:i32, v:i64) void {
    let base:i64 = 40;
    if(which == 1) { base = 104; }
    if(which == 2) { base = 168; }
    if(which == 3) { base = 232; }
    ps[(base + i as i64) as i32] = (iclamp(v, -128, 127) & 255) as u8;
}
fn ps_get(ps:[]u8, which:i32, i:i32) i64 {
    let base:i64 = 40;
    if(which == 1) { base = 104; }
    if(which == 2) { base = 168; }
    if(which == 3) { base = 232; }
    let v:i64 = ps[(base + i as i64) as i32] as i64;
    if(v >= 128) { return v - 256; }
    return v;
}
// write the 6-dim relational color invariant of mean (mr,mg,mb) into ps
fn ps_inv6(ps:[]u8, which:i32, i0:i32, mr:i64, mg:i64, mb:i64) void {
    ps_put(ps, which, i0, q8((mr + mg + mb) / 3, 4));
    ps_put(ps, which, i0 + 1, q8(mr - mg, 2));
    ps_put(ps, which, i0 + 2, q8(mg - mb, 2));
    ps_put(ps, which, i0 + 3, q8(mr - mb, 2));
    ps_put(ps, which, i0 + 4, q8(mr, 8));
    ps_put(ps, which, i0 + 5, q8(mb, 8));
}

// ================= TASK 1: colordisc ======================================
// Invariants: 6-dim relational color invariants per patch.
// Forward model: "patch B persists patch A's surface" -> P(invB) = inv(A).
// Secondary: spatial stationarity within B (bottom half predicts top half).
// Judgment: RGB-space distance, SAME iff <= 40 (Approach A's threshold).
fn task_colordisc(buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32, ps:[]u8) i32 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 2 || h < 1 || w > 4096 || h > 4096) { return -1; }
    if((w % 2) == 1) { return -1; }
    if(8 + (w as i64) * (h as i64) * 3 > n as i64) { return -1; }
    let hw:i32 = w / 2;
    let hh:i32 = h / 2;
    let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
    let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
    let str:i64 = 0; let stg:i64 = 0; let stb:i64 = 0;
    let sbr:i64 = 0; let sbg:i64 = 0; let sbb:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < hw) {
            let o1:i32 = 8 + (y * w + x) * 3;
            s1r = s1r + (buf[o1] as i64);
            s1g = s1g + (buf[o1+1] as i64);
            s1b = s1b + (buf[o1+2] as i64);
            let o2:i32 = 8 + (y * w + hw + x) * 3;
            let r2:i64 = buf[o2] as i64;
            let g2:i64 = buf[o2+1] as i64;
            let b2:i64 = buf[o2+2] as i64;
            s2r = s2r + r2; s2g = s2g + g2; s2b = s2b + b2;
            if(y < hh) { str = str + r2; stg = stg + g2; stb = stb + b2; }
            if(y >= hh) { sbr = sbr + r2; sbg = sbg + g2; sbb = sbb + b2; }
            x = x + 1;
        }
        y = y + 1;
    }
    let np:i64 = (hw as i64) * (h as i64);
    let nph:i64 = (hw as i64) * (hh as i64);
    op_add(op, 2 * np);
    let m1r:i64 = s1r / np; let m1g:i64 = s1g / np; let m1b:i64 = s1b / np;
    let m2r:i64 = s2r / np; let m2g:i64 = s2g / np; let m2b:i64 = s2b / np;
    let mtr:i64 = 0; let mtg:i64 = 0; let mtb:i64 = 0;
    let mbr:i64 = 0; let mbg:i64 = 0; let mbb:i64 = 0;
    if(nph > 0) {
        mtr = str / nph; mtg = stg / nph; mtb = stb / nph;
        mbr = sbr / nph; mbg = sbg / nph; mbb = sbb / nph;
    }
    // invariants: observed = inv(B), predicted = inv(A)
    ps_inv6(ps, 0, 0, m2r, m2g, m2b);
    ps_inv6(ps, 1, 0, m1r, m1g, m1b);
    ps_inv6(ps, 2, 0, mbr, mbg, mbb);
    ps_inv6(ps, 3, 0, mtr, mtg, mtb);
    t_put64(ps, 16, 6);
    t_put64(ps, 24, 6);
    t_put64(ps, 32, 1);
    // judgment (Approach A rule)
    let dr:i64 = m1r - m2r; let dg:i64 = m1g - m2g; let db:i64 = m1b - m2b;
    let dist:i64 = isqrt(dr*dr + dg*dg + db*db);
    op_add(op, 1);
    let ji:i32 = 0;
    if(dist > 40) { ji = 1; }
    t_put64(ps, 0, ji as i64);
    if(ji == 0) { pos = ob_kv(ob, pos, "judgment", "SAME"); }
    if(ji == 1) { pos = ob_kv(ob, pos, "judgment", "DIFFERENT"); }
    let mg:i64 = iabs(dist - 40);
    t_put64(ps, 8, 1000 * mg / (mg + 60));
    pos = ob_add(ob, pos, "debug_vec=");
    pos = ob_pair(ob, pos, "m1r", m1r); pos = ob_pair(ob, pos, "m1g", m1g);
    pos = ob_pair(ob, pos, "m1b", m1b); pos = ob_pair(ob, pos, "m2r", m2r);
    pos = ob_pair(ob, pos, "m2g", m2g); pos = ob_pair(ob, pos, "m2b", m2b);
    pos = ob_pair(ob, pos, "dist", dist);
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= TASK 2: colorconst =====================================
// Invariants: von-Kries discounted means (per-mille, A's method), 6-dim.
// Forward model: "surface persists across illuminant change".
// Secondary: spatial stationarity within B.
fn task_colorconst(buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32, ps:[]u8) i32 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 2 || h < 1 || w > 4096 || h > 4096) { return -1; }
    if((w % 2) == 1) { return -1; }
    if(8 + (w as i64) * (h as i64) * 3 > n as i64) { return -1; }
    let hw:i32 = w / 2;
    let hh:i32 = h / 2;
    let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
    let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
    let x1r:i64 = 0; let x1g:i64 = 0; let x1b:i64 = 0;
    let x2r:i64 = 0; let x2g:i64 = 0; let x2b:i64 = 0;
    // B top/bottom accumulators
    let str:i64 = 0; let stg:i64 = 0; let stb:i64 = 0;
    let sbr:i64 = 0; let sbg:i64 = 0; let sbb:i64 = 0;
    let xtr:i64 = 0; let xtg:i64 = 0; let xtb:i64 = 0;
    let xbr:i64 = 0; let xbg:i64 = 0; let xbb:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < hw) {
            let o1:i32 = 8 + (y * w + x) * 3;
            let r1:i64 = buf[o1] as i64;
            let g1:i64 = buf[o1+1] as i64;
            let b1:i64 = buf[o1+2] as i64;
            s1r = s1r + r1; s1g = s1g + g1; s1b = s1b + b1;
            x1r = imax(x1r, r1); x1g = imax(x1g, g1); x1b = imax(x1b, b1);
            let o2:i32 = 8 + (y * w + hw + x) * 3;
            let r2:i64 = buf[o2] as i64;
            let g2:i64 = buf[o2+1] as i64;
            let b2:i64 = buf[o2+2] as i64;
            s2r = s2r + r2; s2g = s2g + g2; s2b = s2b + b2;
            x2r = imax(x2r, r2); x2g = imax(x2g, g2); x2b = imax(x2b, b2);
            if(y < hh) {
                str = str + r2; stg = stg + g2; stb = stb + b2;
                xtr = imax(xtr, r2); xtg = imax(xtg, g2); xtb = imax(xtb, b2);
            }
            if(y >= hh) {
                sbr = sbr + r2; sbg = sbg + g2; sbb = sbb + b2;
                xbr = imax(xbr, r2); xbg = imax(xbg, g2); xbb = imax(xbb, b2);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    let np:i64 = (hw as i64) * (h as i64);
    let nph:i64 = (hw as i64) * (hh as i64);
    op_add(op, 2 * np);
    // von Kries: discounted mean channel = sum*1000 / (np*max), per-mille.
    let n1r:i64 = 0; let n1g:i64 = 0; let n1b:i64 = 0;
    let n2r:i64 = 0; let n2g:i64 = 0; let n2b:i64 = 0;
    if(x1r > 0) { n1r = s1r * 1000 / (np * x1r); }
    if(x1g > 0) { n1g = s1g * 1000 / (np * x1g); }
    if(x1b > 0) { n1b = s1b * 1000 / (np * x1b); }
    if(x2r > 0) { n2r = s2r * 1000 / (np * x2r); }
    if(x2g > 0) { n2g = s2g * 1000 / (np * x2g); }
    if(x2b > 0) { n2b = s2b * 1000 / (np * x2b); }
    let ntr:i64 = 0; let ntg:i64 = 0; let ntb:i64 = 0;
    let nbr:i64 = 0; let nbg:i64 = 0; let nbb:i64 = 0;
    if(nph > 0) {
        if(xtr > 0) { ntr = str * 1000 / (nph * xtr); }
        if(xtg > 0) { ntg = stg * 1000 / (nph * xtg); }
        if(xtb > 0) { ntb = stb * 1000 / (nph * xtb); }
        if(xbr > 0) { nbr = sbr * 1000 / (nph * xbr); }
        if(xbg > 0) { nbg = sbg * 1000 / (nph * xbg); }
        if(xbb > 0) { nbb = sbb * 1000 / (nph * xbb); }
    }
    // invariants in per-mille space
    ps_put(ps, 0, 0, q8(n2r, 16)); ps_put(ps, 0, 1, q8(n2g, 16));
    ps_put(ps, 0, 2, q8(n2b, 16)); ps_put(ps, 0, 3, q8(n2r - n2g, 8));
    ps_put(ps, 0, 4, q8(n2g - n2b, 8)); ps_put(ps, 0, 5, q8(n2r - n2b, 8));
    ps_put(ps, 1, 0, q8(n1r, 16)); ps_put(ps, 1, 1, q8(n1g, 16));
    ps_put(ps, 1, 2, q8(n1b, 16)); ps_put(ps, 1, 3, q8(n1r - n1g, 8));
    ps_put(ps, 1, 4, q8(n1g - n1b, 8)); ps_put(ps, 1, 5, q8(n1r - n1b, 8));
    ps_put(ps, 2, 0, q8(nbr, 16)); ps_put(ps, 2, 1, q8(nbg, 16));
    ps_put(ps, 2, 2, q8(nbb, 16)); ps_put(ps, 2, 3, q8(nbr - nbg, 8));
    ps_put(ps, 2, 4, q8(nbg - nbb, 8)); ps_put(ps, 2, 5, q8(nbr - nbb, 8));
    ps_put(ps, 3, 0, q8(ntr, 16)); ps_put(ps, 3, 1, q8(ntg, 16));
    ps_put(ps, 3, 2, q8(ntb, 16)); ps_put(ps, 3, 3, q8(ntr - ntg, 8));
    ps_put(ps, 3, 4, q8(ntg - ntb, 8)); ps_put(ps, 3, 5, q8(ntr - ntb, 8));
    t_put64(ps, 16, 6);
    t_put64(ps, 24, 6);
    t_put64(ps, 32, 1);
    let dr:i64 = n1r - n2r; let dg:i64 = n1g - n2g; let db:i64 = n1b - n2b;
    let dist:i64 = isqrt(dr*dr + dg*dg + db*db);
    op_add(op, 1);
    let ji:i32 = 0;
    if(dist > 150) { ji = 1; }
    t_put64(ps, 0, ji as i64);
    if(ji == 0) { pos = ob_kv(ob, pos, "judgment", "SAME_SURFACE"); }
    if(ji == 1) { pos = ob_kv(ob, pos, "judgment", "DIFFERENT"); }
    let mg:i64 = iabs(dist - 150);
    t_put64(ps, 8, 1000 * mg / (mg + 120));
    pos = ob_add(ob, pos, "debug_vec=");
    pos = ob_pair(ob, pos, "n1r", n1r); pos = ob_pair(ob, pos, "n1g", n1g);
    pos = ob_pair(ob, pos, "n1b", n1b); pos = ob_pair(ob, pos, "n2r", n2r);
    pos = ob_pair(ob, pos, "n2g", n2g); pos = ob_pair(ob, pos, "n2b", n2b);
    pos = ob_pair(ob, pos, "dist", dist);
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= TASK 3: shapetrans ======================================
// Mask: minority-brightness (A's method). Judgment: area/(pi*R^2) per-mille
// vs prototypes 1000/637/414 (A's).
// Invariants: fill-ratio/8 + 15-bin rotation-invariant radial profile.
// Forward model: scale persistence — predict the full-resolution radial
// profile from the 2x-downsampled (majority) mask. Clean rigid shapes are
// scale-coherent (small residual); clutter/occlusion breaks it (large).
// Secondary: top/bottom half profile stationarity (8 bins).
fn shape_profile(buf:[]u8, w:i32, h:i32, fgbright:i32, cx:i64, cy:i64,
                 rmax:i64, nbins:i32, counts:[]u8, op:[]u8) void {
    // counts: nbins x i64 arena, zeroed by caller. Adds one profile pass.
    let npx:i64 = (w as i64) * (h as i64);
    let i:i32 = 0;
    while(i < npx as i32) {
        let o:i32 = 8 + i * 3;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        let isb:i32 = 0;
        if(lum > 382) { isb = 1; }
        if(isb == fgbright) {
            let dx:i64 = (i % w) as i64 - cx;
            let dy:i64 = (i / w) as i64 - cy;
            let d:i64 = isqrt(dx*dx + dy*dy);
            let b:i64 = 0;
            if(rmax > 0) { b = d * (nbins as i64) / rmax; }
            if(b >= nbins as i64) { b = (nbins as i64) - 1; }
            let at:i32 = (b * 8) as i32;
            t_put64(counts, at, t_get64(counts, at) + 1);
        }
        i = i + 1;
    }
    op_add(op, npx);
}
// 90-degree-rotation prediction: rotate the binary mask 90 deg clockwise
// and recompute the 15-bin radial profile + fill ratio on the rotated mask.
// Writes normalized profile (0..127) into ps which-slot at i0, and
// ratio_rot/8 at i0+15. Returns 1 if usable, else 0.
// This is the frozen "profile under 90-degree rotation: rigid shape persists"
// forward model: a rigid shape's rotation-invariant profile must persist
// under an actual 90-degree rotation of the input.
fn shape_rot_profile(buf:[]u8, w:i32, h:i32, fgbright:i32, ps:[]u8, i0:i32,
                     op:[]u8) i64 {
    let npx:i64 = (w as i64) * (h as i64);
    if(npx > 262144) { return 0; }
    // pass 1: binary mask + 90deg CW rotated mask (rotated dims: h x w)
    let msk:[]u8 = nio_alloc(npx as i32);
    let rot:[]u8 = nio_alloc(npx as i32);
    if(msk.len == 0 || rot.len == 0) { return 0; }
    zero8(msk);
    zero8(rot);
    let i:i32 = 0;
    while(i < npx as i32) {
        let o:i32 = 8 + i * 3;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        let isb:i32 = 0;
        if(lum > 382) { isb = 1; }
        if(isb == fgbright) {
            msk[i] = 1;
            let x:i32 = i % w;
            let y:i32 = i / w;
            // CW: new(x',y') = old(x,y) with x' = h-1-y, y' = x; new width h
            let ri:i32 = x * h + (h - 1 - y);
            rot[ri] = 1;
        }
        i = i + 1;
    }
    op_add(op, npx);
    // pass 2: area + centroid of the rotated mask (width h, height w)
    let w2:i32 = h;
    let a:i64 = 0; let sx:i64 = 0; let sy:i64 = 0;
    i = 0;
    while(i < npx as i32) {
        if(rot[i] == 1) {
            a = a + 1;
            sx = sx + (i % w2) as i64;
            sy = sy + (i / w2) as i64;
        }
        i = i + 1;
    }
    op_add(op, npx);
    nio_free(msk);
    if(a < 9) { nio_free(rot); return 0; }
    let cx:i64 = sx / a;
    let cy:i64 = sy / a;
    let maxd2:i64 = 0;
    i = 0;
    while(i < npx as i32) {
        if(rot[i] == 1) {
            let dx:i64 = (i % w2) as i64 - cx;
            let dy:i64 = (i / w2) as i64 - cy;
            let d2:i64 = dx*dx + dy*dy;
            if(d2 > maxd2) { maxd2 = d2; }
        }
        i = i + 1;
    }
    op_add(op, npx);
    if(maxd2 < 1) { nio_free(rot); return 0; }
    let rmax:i64 = isqrt(maxd2);
    // pass 3: 15-bin radial profile of the rotated mask
    let cnt:[]u8 = nio_alloc(15 * 8);
    if(cnt.len == 0) { nio_free(rot); return 0; }
    zero8(cnt);
    i = 0;
    while(i < npx as i32) {
        if(rot[i] == 1) {
            let dx:i64 = (i % w2) as i64 - cx;
            let dy:i64 = (i / w2) as i64 - cy;
            let d:i64 = isqrt(dx*dx + dy*dy);
            let b:i64 = 0;
            if(rmax > 0) { b = d * 15 / rmax; }
            if(b >= 15) { b = 14; }
            let at:i32 = (b * 8) as i32;
            t_put64(cnt, at, t_get64(cnt, at) + 1);
        }
        i = i + 1;
    }
    op_add(op, npx);
    nio_free(rot);
    let b:i32 = 0;
    while(b < 15) {
        let v:i64 = t_get64(cnt, b * 8) * 127 / a;
        ps_put(ps, 1, i0 + b, v);
        b = b + 1;
    }
    nio_free(cnt);
    let ratio:i64 = a * 1000000 / (3142 * maxd2);
    ps_put(ps, 1, i0 + 15, q8(ratio, 8));
    return 1;
}
fn task_shapetrans(buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32, ps:[]u8) i32 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 4 || h < 4 || w > 4096 || h > 4096) { return -1; }
    let npx:i64 = (w as i64) * (h as i64);
    if(8 + npx * 3 > n as i64) { return -1; }
    let nb:i64 = 0;
    let i:i32 = 0;
    while(i < npx as i32) {
        let o:i32 = 8 + i * 3;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        if(lum > 382) { nb = nb + 1; }
        i = i + 1;
    }
    op_add(op, npx);
    let fgbright:i32 = 0;
    if(2 * nb <= npx) { fgbright = 1; }
    let a:i64 = 0; let sx:i64 = 0; let sy:i64 = 0;
    i = 0;
    while(i < npx as i32) {
        let o:i32 = 8 + i * 3;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        let isb:i32 = 0;
        if(lum > 382) { isb = 1; }
        if(isb == fgbright) {
            a = a + 1;
            sx = sx + (i % w) as i64;
            sy = sy + (i / w) as i64;
        }
        i = i + 1;
    }
    op_add(op, npx);
    let degenerate:i32 = 0;
    if(a < 9) {
        // Mask too small (occluded/dim adversarial): cannot localize.
        // Fall back to center with minimal area; force WITHHOLD below.
        degenerate = 1;
        a = 9;
        sx = 9 * (w / 2) as i64;
        sy = 9 * (h / 2) as i64;
    }
    let cx:i64 = sx / a;
    let cy:i64 = sy / a;
    let maxd2:i64 = 0;
    i = 0;
    while(i < npx as i32) {
        let o:i32 = 8 + i * 3;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        let isb:i32 = 0;
        if(lum > 382) { isb = 1; }
        if(isb == fgbright) {
            let dx:i64 = (i % w) as i64 - cx;
            let dy:i64 = (i / w) as i64 - cy;
            let d2:i64 = dx*dx + dy*dy;
            if(d2 > maxd2) { maxd2 = d2; }
        }
        i = i + 1;
    }
    op_add(op, npx);
    if(maxd2 < 1) {
        if(degenerate == 1) { maxd2 = 1; } else { return -1; }
    }
    let rmax:i64 = isqrt(maxd2);
    let ratio:i64 = a * 1000000 / (3142 * maxd2);
    // observed primary invariants: 15-bin profile + fill/8
    let cnt:[]u8 = nio_alloc(15 * 8);
    if(cnt.len == 0) { return -1; }
    zero8(cnt);
    shape_profile(buf, w, h, fgbright, cx, cy, rmax, 15, cnt, op);
    let b:i32 = 0;
    while(b < 15) {
        ps_put(ps, 0, b, t_get64(cnt, b * 8) * 127 / a);
        b = b + 1;
    }
    nio_free(cnt);
    ps_put(ps, 0, 15, q8(ratio, 8));
    // predicted primary invariants: downsampled-mask profile
    let pok:i64 = shape_rot_profile(buf, w, h, fgbright, ps, 0, op);
    t_put64(ps, 16, 16);
    // secondary: top/bottom half 8-bin profiles
    let cnt8:[]u8 = nio_alloc(8 * 8);
    if(cnt8.len == 0) { return -1; }
    zero8(cnt8);
    // top half profile: reuse shape_profile on a sub-view is complex;
    // instead do a dedicated half pass here.
    let hh:i32 = h / 2;
    let at_:i64 = 0; let ab:i64 = 0;
    i = 0;
    while(i < npx as i32) {
        let o:i32 = 8 + i * 3;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        let isb:i32 = 0;
        if(lum > 382) { isb = 1; }
        if(isb == fgbright) {
            let yy:i32 = i / w;
            let dx:i64 = (i % w) as i64 - cx;
            let dy:i64 = yy as i64 - cy;
            let d:i64 = isqrt(dx*dx + dy*dy);
            let bb:i64 = 0;
            if(rmax > 0) { bb = d * 8 / rmax; }
            if(bb >= 8) { bb = 7; }
            if(yy < hh) {
                at_ = at_ + 1;
                let at2:i32 = (bb * 8) as i32;
                t_put64(cnt8, at2, t_get64(cnt8, at2) + 1);
            }
            if(yy >= hh) { ab = ab + 1; }
        }
        i = i + 1;
    }
    op_add(op, npx);
    // bottom half counts stored in a second arena
    let cnt8b:[]u8 = nio_alloc(8 * 8);
    if(cnt8b.len == 0) { nio_free(cnt8); return -1; }
    zero8(cnt8b);
    i = 0;
    while(i < npx as i32) {
        let o:i32 = 8 + i * 3;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        let isb:i32 = 0;
        if(lum > 382) { isb = 1; }
        if(isb == fgbright) {
            let yy:i32 = i / w;
            if(yy >= hh) {
                let dx:i64 = (i % w) as i64 - cx;
                let dy:i64 = yy as i64 - cy;
                let d:i64 = isqrt(dx*dx + dy*dy);
                let bb:i64 = 0;
                if(rmax > 0) { bb = d * 8 / rmax; }
                if(bb >= 8) { bb = 7; }
                let at2:i32 = (bb * 8) as i32;
                t_put64(cnt8b, at2, t_get64(cnt8b, at2) + 1);
            }
        }
        i = i + 1;
    }
    op_add(op, npx);
    b = 0;
    while(b < 8) {
        let vt:i64 = 0;
        let vb:i64 = 0;
        if(at_ > 0) { vt = t_get64(cnt8, b * 8) * 127 / at_; }
        if(ab > 0) { vb = t_get64(cnt8b, b * 8) * 127 / ab; }
        ps_put(ps, 2, b, vb);
        ps_put(ps, 3, b, vt);
        b = b + 1;
    }
    nio_free(cnt8);
    nio_free(cnt8b);
    t_put64(ps, 24, 8);
    if(degenerate == 1) { pok = 0; }
    t_put64(ps, 32, pok);
    // judgment: nearest prototype (A's rule)
    let dc:i64 = iabs(ratio - 1000);
    let ds:i64 = iabs(ratio - 637);
    let dt:i64 = iabs(ratio - 414);
    op_add(op, 3);
    let cls:i32 = 0;
    if(ds < dc && ds < dt) { cls = 1; }
    if(dt < dc && dt <= ds) { cls = 2; }
    t_put64(ps, 0, cls as i64);
    if(cls == 0) { pos = ob_kv(ob, pos, "judgment", "CIRCLE"); }
    if(cls == 1) { pos = ob_kv(ob, pos, "judgment", "SQUARE"); }
    if(cls == 2) { pos = ob_kv(ob, pos, "judgment", "TRIANGLE"); }
    let best:i64 = dc;
    if(cls == 1) { best = ds; }
    if(cls == 2) { best = dt; }
    let other:i64 = dc;
    if(cls == 0) { other = imin(ds, dt); }
    if(cls == 1) { other = imin(dc, dt); }
    if(cls == 2) { other = imin(dc, ds); }
    let margin:i64 = other - best;
    t_put64(ps, 8, 1000 * margin / (margin + 150));
    pos = ob_add(ob, pos, "debug_vec=");
    pos = ob_pair(ob, pos, "ratio", ratio);
    pos = ob_pair(ob, pos, "area", a);
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// Per-harmonic energies E_1..E_8 into ev (8 x i64 arena) at harmonics of
// f0m (milli-Hz), over w samples starting at off.
fn harm_vec(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, ev:[]u8, op:[]u8) void {
    let h:i32 = 0;
    while(h < 8) { t_put64(ev, h * 8, 0); h = h + 1; }
    if(f0m <= 0 || w < 64) { return; }
    let pinc1:i64 = f0m * 4294967296 / (1000 * sr);
    if(pinc1 <= 0) { return; }
    h = 1;
    while(h <= 8) {
        if(2 * (h as i64) * f0m >= sr * 1000) { break; }
        let pinc:i64 = (h as i64) * pinc1;
        let re:i64 = 0;
        let im:i64 = 0;
        let i:i32 = 0;
        while(i < w) {
            let s:i64 = t_geti16(buf, off + i * 2);
            let p:i64 = ((i as i64) * pinc) & 4294967295;
            re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
            im = im + s * ng_sin1024(p) / 1024;
            i = i + 1;
        }
        op_add(op, (2 * w) as i64);
        t_put64(ev, (h - 1) * 8, (re * re + im * im) / 1048576);
        h = h + 1;
    }
}

// ================= TASK 4: pitchdisc ======================================
// Invariants: dppm (B vs A) + tone-B harmonic centroid predicted from A.
// Forward model: "pitch persists" -> P(dppm) = 0, P(centroid drift) = 0.
// Secondary: tone-B inter-half f0/centroid drift.
// Judgment: SAME iff |dppm| < 5000 (0.5% = the truth boundary).
fn task_pitchdisc(buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32, ps:[]u8) i32 {
    let sr:i32 = t_get32(buf, 0) as i32;
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1 || cnt > 4000000) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let half:i32 = cnt / 2;
    let offB:i32 = 8 + half * 2;
    let fam:i64 = f0_robust(buf, 8, half, sr as i64, op);
    let fbm:i64 = f0_robust(buf, offB, half, sr as i64, op);
    if(fam <= 0 || fbm <= 0) { return -1; }
    let dppm:i64 = (fbm - fam) * 1000000 / fam;
    // harmonic centroids per tone (window <= 2048)
    let wA:i32 = half;
    if(wA > 2048) { wA = 2048; }
    let rA:i64 = harm_centroid(buf, 8, wA, sr as i64, fam, op);
    let rB:i64 = harm_centroid(buf, offB, wA, sr as i64, fbm, op);
    ps_put(ps, 0, 0, q8(dppm, 250));
    ps_put(ps, 1, 0, 0);
    let cdr:i64 = 0;
    if(rA >= 0 && rB >= 0) { cdr = q8(rB - rA, 40); }
    ps_put(ps, 0, 1, cdr);
    ps_put(ps, 1, 1, 0);
    t_put64(ps, 16, 2);
    // secondary: tone-B inter-half drift
    let h1c:i32 = half / 2;
    let h2c:i32 = half - h1c;
    let h2o:i32 = offB + h1c * 2;
    let fB1:i64 = f0_robust(buf, offB, h1c, sr as i64, op);
    let fB2:i64 = f0_robust(buf, h2o, h2c, sr as i64, op);
    if(fB1 <= 0 || fB2 <= 0) { return -1; }
    let dppm2:i64 = (fB2 - fB1) * 1000000 / fB1;
    let wB:i32 = h1c;
    if(wB > 2048) { wB = 2048; }
    let rB1:i64 = harm_centroid(buf, offB, wB, sr as i64, fB1, op);
    let rB2:i64 = harm_centroid(buf, h2o, wB, sr as i64, fB2, op);
    ps_put(ps, 2, 0, q8(dppm2, 250));
    ps_put(ps, 3, 0, 0);
    let cdr2:i64 = 0;
    if(rB1 >= 0 && rB2 >= 0) { cdr2 = q8(rB2 - rB1, 40); }
    ps_put(ps, 2, 1, cdr2);
    ps_put(ps, 3, 1, 0);
    t_put64(ps, 24, 2);
    t_put64(ps, 32, 1);
    // judgment
    let ji:i32 = 0;
    let ad:i64 = iabs(dppm);
    if(ad >= 5000 && fbm > fam) { ji = 1; }
    if(ad >= 5000 && fbm <= fam) { ji = 2; }
    t_put64(ps, 0, ji as i64);
    if(ji == 0) { pos = ob_kv(ob, pos, "judgment", "SAME"); }
    if(ji == 1) { pos = ob_kv(ob, pos, "judgment", "HIGHER"); }
    if(ji == 2) { pos = ob_kv(ob, pos, "judgment", "LOWER"); }
    let mg:i64 = iabs(ad - 5000);
    t_put64(ps, 8, 1000 * mg / (mg + 12500));
    pos = ob_add(ob, pos, "debug_vec=");
    pos = ob_pair(ob, pos, "fam", fam); pos = ob_pair(ob, pos, "fbm", fbm);
    pos = ob_pair(ob, pos, "dppm", dppm);
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= TASK 5: timbredisc =====================================
// Invariants: 7 harmonic ratios E_h/E_1 (x64), second half vs first half.
// Forward model: "timbre persists forward in time".
// Secondary: harmonic-centroid inter-half drift.
// Judgment: harmonic centroid r, boundaries 1075/1400/3000 (A's).
fn task_timbredisc(buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32, ps:[]u8) i32 {
    let sr:i32 = t_get32(buf, 0) as i32;
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 256 || cnt > 4000000) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let f0m:i64 = f0_robust(buf, 8, cnt, sr as i64, op);
    if(f0m < 50000 || f0m > 2000000) { return -1; }
    let h1c:i32 = cnt / 2;
    let h2c:i32 = cnt - h1c;
    let h2o:i32 = 8 + h1c * 2;
    let w1:i32 = h1c;
    if(w1 > 2048) { w1 = 2048; }
    let w2:i32 = h2c;
    if(w2 > 2048) { w2 = 2048; }
    let e1:[]u8 = nio_alloc(8 * 8);
    let e2:[]u8 = nio_alloc(8 * 8);
    if(e1.len == 0 || e2.len == 0) { return -1; }
    harm_vec(buf, 8, w1, sr as i64, f0m, e1, op);
    harm_vec(buf, h2o, w2, sr as i64, f0m, e2, op);
    let e10:i64 = t_get64(e1, 0);
    let e20:i64 = t_get64(e2, 0);
    if(e10 < 1) { e10 = 1; }
    if(e20 < 1) { e20 = 1; }
    let h:i32 = 0;
    while(h < 7) {
        let r2:i64 = q8(64 * t_get64(e2, h * 8) / e20, 1);
        let r1:i64 = q8(64 * t_get64(e1, h * 8) / e10, 1);
        ps_put(ps, 0, h, r2);
        ps_put(ps, 1, h, r1);
        h = h + 1;
    }
    t_put64(ps, 16, 7);
    // secondary: centroid drift
    let se1:i64 = 0; let sh1:i64 = 0;
    let se2:i64 = 0; let sh2:i64 = 0;
    h = 1;
    while(h <= 8) {
        let a1:i64 = t_get64(e1, (h - 1) * 8);
        let a2:i64 = t_get64(e2, (h - 1) * 8);
        se1 = se1 + a1; sh1 = sh1 + (h as i64) * a1;
        se2 = se2 + a2; sh2 = sh2 + (h as i64) * a2;
        h = h + 1;
    }
    let c1:i64 = -1;
    let c2:i64 = -1;
    if(se1 > 0) { c1 = 1000 * sh1 / se1; }
    if(se2 > 0) { c2 = 1000 * sh2 / se2; }
    let cdr:i64 = 0;
    if(c1 >= 0 && c2 >= 0) { cdr = q8(c2 - c1, 40); }
    ps_put(ps, 2, 0, cdr);
    ps_put(ps, 3, 0, 0);
    t_put64(ps, 24, 1);
    t_put64(ps, 32, 1);
    nio_free(e1);
    nio_free(e2);
    // judgment: centroid over the whole tone (A's exact window rule)
    let wj:i32 = cnt;
    if(wj > 2048) { wj = 2048; }
    let r:i64 = harm_centroid(buf, 8, wj, sr as i64, f0m, op);
    if(r < 0) { return -1; }
    let ji:i32 = 0;
    if(r >= 1075 && r < 1400) { ji = 1; }
    if(r >= 1400 && r < 3000) { ji = 2; }
    if(r >= 3000) { ji = 3; }
    t_put64(ps, 0, ji as i64);
    if(ji == 0) { pos = ob_kv(ob, pos, "judgment", "PURE"); }
    if(ji == 1) { pos = ob_kv(ob, pos, "judgment", "DARK"); }
    if(ji == 2) { pos = ob_kv(ob, pos, "judgment", "RICH"); }
    if(ji == 3) { pos = ob_kv(ob, pos, "judgment", "BRIGHT"); }
    let m0:i64 = iabs(r - 1075);
    let m1:i64 = iabs(r - 1400);
    let m2:i64 = iabs(r - 3000);
    let margin:i64 = imin(m0, imin(m1, m2));
    t_put64(ps, 8, 1000 * margin / (margin + 200));
    pos = ob_add(ob, pos, "debug_vec=");
    pos = ob_pair(ob, pos, "f0m", f0m);
    pos = ob_pair(ob, pos, "r", r);
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= TASK 6: motiondir ======================================
// Per-step displacements from difference-mask centroids (A's method).
// Invariants: per-step (dx,dy) x4, t=2..7.
// Forward model: constant velocity -> P(disp_t) = disp_{t-1}.
// Secondary: linear-extrapolation residual of the final centroid.
// Judgment: total displacement, STILL iff |disp|<3px else 8-way (A's rule).
fn task_motiondir(buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32, ps:[]u8) i32 {
    let nf:i32 = t_get32(buf, 0) as i32;
    let w:i32 = t_get32(buf, 4) as i32;
    let h:i32 = t_get32(buf, 8) as i32;
    if(nf < 2 || nf > 1024) { return -1; }
    if(w < 2 || h < 2 || w > 512 || h > 512) { return -1; }
    let fsz:i64 = (w as i64) * (h as i64) * 3;
    if(12 + (nf as i64) * fsz > n as i64) { return -1; }
    let npx:i32 = w * h;
    // centroid track: up to 64 steps
    let cx:[]u8 = nio_alloc(64 * 8);
    let cy:[]u8 = nio_alloc(64 * 8);
    if(cx.len == 0 || cy.len == 0) { return -1; }
    let nsteps:i32 = 0;
    let have:i32 = 0;
    let fcx:i64 = 0; let fcy:i64 = 0;
    let lcx:i64 = 0; let lcy:i64 = 0;
    let pcx:i64 = 0; let pcy:i64 = 0;
    let t:i32 = 1;
    while(t < nf && nsteps < 64) {
        let mc:i64 = 0; let mx:i64 = 0; let my:i64 = 0;
        let p:i32 = 0;
        while(p < npx) {
            let o0:i32 = (12 + ((t - 1) as i64) * fsz + (p as i64) * 3) as i32;
            let o1:i32 = (12 + (t as i64) * fsz + (p as i64) * 3) as i32;
            let d:i64 = iabs((buf[o1] as i64) - (buf[o0] as i64))
                      + iabs((buf[o1+1] as i64) - (buf[o0+1] as i64))
                      + iabs((buf[o1+2] as i64) - (buf[o0+2] as i64));
            if(d > 90) {
                mc = mc + 1;
                mx = mx + (p % w) as i64;
                my = my + (p / w) as i64;
            }
            p = p + 1;
        }
        op_add(op, npx as i64);
        if(mc > 0) {
            pcx = mx / mc;
            pcy = my / mc;
            if(have == 0) { fcx = pcx; fcy = pcy; have = 1; }
            lcx = pcx; lcy = pcy;
        }
        t_put64(cx, nsteps * 8, pcx);
        t_put64(cy, nsteps * 8, pcy);
        nsteps = nsteps + 1;
        t = t + 1;
    }
    // per-step displacements
    let pok:i64 = 1;
    if(nsteps < 2) { pok = 0; }
    let nd2:i32 = 0;
    if(nsteps >= 2) {
        // residuals over steps k=2..nsteps-1: residual_k = disp_k - disp_{k-1}
        // (constant-velocity forward model). k=1 has no predecessor, skipped.
        let k:i32 = 2;
        while(k < nsteps && nd2 < 12) {
            let dxk:i64 = t_get64(cx, k * 8) - t_get64(cx, (k - 1) * 8);
            let dyk:i64 = t_get64(cy, k * 8) - t_get64(cy, (k - 1) * 8);
            let dxp:i64 = t_get64(cx, (k - 1) * 8) - t_get64(cx, (k - 2) * 8);
            let dyp:i64 = t_get64(cy, (k - 1) * 8) - t_get64(cy, (k - 2) * 8);
            ps_put(ps, 0, nd2, iclamp(dxk * 4, -128, 127));
            ps_put(ps, 0, nd2 + 1, iclamp(dyk * 4, -128, 127));
            ps_put(ps, 1, nd2, iclamp(dxp * 4, -128, 127));
            ps_put(ps, 1, nd2 + 1, iclamp(dyp * 4, -128, 127));
            nd2 = nd2 + 2;
            k = k + 1;
        }
    }
    t_put64(ps, 16, nd2 as i64);
    // secondary: linear extrapolation of the final centroid
    let nsd2:i64 = 0;
    if(nsteps >= 3) {
        let c5x:i64 = t_get64(cx, (nsteps - 3) * 8);
        let c5y:i64 = t_get64(cy, (nsteps - 3) * 8);
        let c6x:i64 = t_get64(cx, (nsteps - 2) * 8);
        let c6y:i64 = t_get64(cy, (nsteps - 2) * 8);
        let c7x:i64 = t_get64(cx, (nsteps - 1) * 8);
        let c7y:i64 = t_get64(cy, (nsteps - 1) * 8);
        let px:i64 = c5x + 2 * (c6x - c5x);
        let py:i64 = c5y + 2 * (c6y - c5y);
        ps_put(ps, 2, 0, iclamp((c7x - px) * 4, -128, 127));
        ps_put(ps, 2, 1, iclamp((c7y - py) * 4, -128, 127));
        ps_put(ps, 3, 0, 0);
        ps_put(ps, 3, 1, 0);
        nsd2 = 2;
    }
    if(nsteps < 3) { pok = 0; }
    t_put64(ps, 24, nsd2);
    t_put64(ps, 32, pok);
    nio_free(cx);
    nio_free(cy);
    // judgment (A's exact rule)
    let dx:i64 = 0; let dy:i64 = 0;
    if(have == 1) { dx = lcx - fcx; dy = lcy - fcy; }
    let mag2:i64 = dx*dx + dy*dy;
    let mag:i64 = isqrt(mag2);
    op_add(op, 2);
    let dir:i32 = 0;
    if(mag2 >= 9) {
        let ax:i64 = iabs(dx); let ay:i64 = iabs(dy);
        if(ax >= 2 * ay) {
            dir = 3;
            if(dx < 0) { dir = 7; }
        }
        if(ay >= 2 * ax) {
            dir = 5;
            if(dy < 0) { dir = 1; }
        }
        if(ax < 2 * ay && ay < 2 * ax) {
            dir = 4;
            if(dx < 0 && dy > 0) { dir = 6; }
            if(dx > 0 && dy < 0) { dir = 2; }
            if(dx < 0 && dy < 0) { dir = 8; }
        }
    }
    t_put64(ps, 0, dir as i64);
    if(dir == 0) { pos = ob_kv(ob, pos, "judgment", "STILL"); }
    if(dir == 1) { pos = ob_kv(ob, pos, "judgment", "N"); }
    if(dir == 2) { pos = ob_kv(ob, pos, "judgment", "NE"); }
    if(dir == 3) { pos = ob_kv(ob, pos, "judgment", "E"); }
    if(dir == 4) { pos = ob_kv(ob, pos, "judgment", "SE"); }
    if(dir == 5) { pos = ob_kv(ob, pos, "judgment", "S"); }
    if(dir == 6) { pos = ob_kv(ob, pos, "judgment", "SW"); }
    if(dir == 7) { pos = ob_kv(ob, pos, "judgment", "W"); }
    if(dir == 8) { pos = ob_kv(ob, pos, "judgment", "NW"); }
    let mg:i64 = iabs(mag - 3);
    t_put64(ps, 8, 1000 * mg / (mg + 4));
    pos = ob_add(ob, pos, "debug_vec=");
    pos = ob_pair(ob, pos, "dx", dx); pos = ob_pair(ob, pos, "dy", dy);
    pos = ob_pair(ob, pos, "mag", mag);
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= G2 contract finalizer ==================================
// Builds the 256-dim residual vector, residual norm, predicted/observed
// hashes, and the INSTALL/WITHHOLD disposition from the percept state.
// EPS = 24 (frozen in PREREG_G2.md).
fn g2_finalize(ps:[]u8, rv:[]u8, op:[]u8) void {
    zero8(rv);
    let nd:i64 = t_get64(ps, 16);
    let nsd:i64 = t_get64(ps, 24);
    if(nd > 64) { nd = 64; }
    if(nsd > 64) { nsd = 64; }
    let i:i64 = 0;
    while(i < nd) {
        let o:i64 = ps_get(ps, 0, i as i32);
        let p:i64 = ps_get(ps, 1, i as i32);
        rv[i as i32] = (res8(o, p) & 255) as u8;
        i = i + 1;
    }
    i = 0;
    while(i < nd) {
        let o:i64 = ps_get(ps, 0, i as i32);
        let p:i64 = ps_get(ps, 1, i as i32);
        rv[(64 + i) as i32] = (iclamp(q4c(o) - q4c(p), -128, 127) & 255) as u8;
        i = i + 1;
    }
    i = 0;
    while(i < nsd) {
        let o:i64 = ps_get(ps, 2, i as i32);
        let p:i64 = ps_get(ps, 3, i as i32);
        rv[(128 + i) as i32] = (res8(o, p) & 255) as u8;
        i = i + 1;
    }
    // residual norm over active fine dims
    let ss:i64 = 0;
    i = 0;
    while(i < nd) {
        let r:i64 = res8(ps_get(ps, 0, i as i32), ps_get(ps, 1, i as i32));
        ss = ss + r * r;
        i = i + 1;
    }
    i = 0;
    while(i < nsd) {
        let r:i64 = res8(ps_get(ps, 2, i as i32), ps_get(ps, 3, i as i32));
        ss = ss + r * r;
        i = i + 1;
    }
    let norm:i64 = isqrt(ss);
    // predicted / observed hashes over coarse bytes
    let ph:i64 = fnv64_init();
    let oh:i64 = fnv64_init();
    i = 0;
    while(i < nd) {
        ph = fnv64_add(ph, q4c(ps_get(ps, 1, i as i32)));
        oh = fnv64_add(oh, q4c(ps_get(ps, 0, i as i32)));
        i = i + 1;
    }
    i = 0;
    while(i < nsd) {
        ph = fnv64_add(ph, q4c(ps_get(ps, 3, i as i32)));
        oh = fnv64_add(oh, q4c(ps_get(ps, 2, i as i32)));
        i = i + 1;
    }
    op_add(op, nd + nsd);
    let disp:i64 = 0;
    if(t_get64(ps, 32) == 1 && norm < 24 && ph == oh) { disp = 1; }
    t_put64(ps, 296, norm);
    t_put64(ps, 304, ph);
    t_put64(ps, 312, oh);
    t_put64(ps, 320, disp);
}
// judgment vocabulary: emit + parse (for batch truth comparison)
fn emit_judgment(ob:[]u8, pos:i32, tid:i32, j:i64) i32 {
    pos = ob_add(ob, pos, "judgment=");
    if(tid == 1) {
        if(j == 0) { pos = ob_add(ob, pos, "SAME"); }
        if(j == 1) { pos = ob_add(ob, pos, "DIFFERENT"); }
    }
    if(tid == 2) {
        if(j == 0) { pos = ob_add(ob, pos, "SAME_SURFACE"); }
        if(j == 1) { pos = ob_add(ob, pos, "DIFFERENT"); }
    }
    if(tid == 3) {
        if(j == 0) { pos = ob_add(ob, pos, "CIRCLE"); }
        if(j == 1) { pos = ob_add(ob, pos, "SQUARE"); }
        if(j == 2) { pos = ob_add(ob, pos, "TRIANGLE"); }
    }
    if(tid == 4) {
        if(j == 0) { pos = ob_add(ob, pos, "SAME"); }
        if(j == 1) { pos = ob_add(ob, pos, "HIGHER"); }
        if(j == 2) { pos = ob_add(ob, pos, "LOWER"); }
    }
    if(tid == 5) {
        if(j == 0) { pos = ob_add(ob, pos, "PURE"); }
        if(j == 1) { pos = ob_add(ob, pos, "DARK"); }
        if(j == 2) { pos = ob_add(ob, pos, "RICH"); }
        if(j == 3) { pos = ob_add(ob, pos, "BRIGHT"); }
    }
    if(tid == 6) {
        if(j == 0) { pos = ob_add(ob, pos, "STILL"); }
        if(j == 1) { pos = ob_add(ob, pos, "N"); }
        if(j == 2) { pos = ob_add(ob, pos, "NE"); }
        if(j == 3) { pos = ob_add(ob, pos, "E"); }
        if(j == 4) { pos = ob_add(ob, pos, "SE"); }
        if(j == 5) { pos = ob_add(ob, pos, "S"); }
        if(j == 6) { pos = ob_add(ob, pos, "SW"); }
        if(j == 7) { pos = ob_add(ob, pos, "W"); }
        if(j == 8) { pos = ob_add(ob, pos, "NW"); }
    }
    pos = ob_add(ob, pos, "\n");
    return pos;
}
// parse a truth value string (after "truth=") to a judgment code; -1 unknown
fn parse_truth(tid:i32, s:[]u8) i64 {
    if(tid == 1) {
        if(_zag_strcmp(s, "SAME") == 1) { return 0; }
        if(_zag_strcmp(s, "DIFFERENT") == 1) { return 1; }
    }
    if(tid == 2) {
        if(_zag_strcmp(s, "SAME_SURFACE") == 1) { return 0; }
        if(_zag_strcmp(s, "DIFFERENT") == 1) { return 1; }
    }
    if(tid == 3) {
        if(_zag_strcmp(s, "CIRCLE") == 1) { return 0; }
        if(_zag_strcmp(s, "SQUARE") == 1) { return 1; }
        if(_zag_strcmp(s, "TRIANGLE") == 1) { return 2; }
    }
    if(tid == 4) {
        if(_zag_strcmp(s, "SAME") == 1) { return 0; }
        if(_zag_strcmp(s, "HIGHER") == 1) { return 1; }
        if(_zag_strcmp(s, "LOWER") == 1) { return 2; }
    }
    if(tid == 5) {
        if(_zag_strcmp(s, "PURE") == 1) { return 0; }
        if(_zag_strcmp(s, "DARK") == 1) { return 1; }
        if(_zag_strcmp(s, "RICH") == 1) { return 2; }
        if(_zag_strcmp(s, "BRIGHT") == 1) { return 3; }
    }
    if(tid == 6) {
        if(_zag_strcmp(s, "STILL") == 1) { return 0; }
        if(_zag_strcmp(s, "N") == 1) { return 1; }
        if(_zag_strcmp(s, "NE") == 1) { return 2; }
        if(_zag_strcmp(s, "E") == 1) { return 3; }
        if(_zag_strcmp(s, "SE") == 1) { return 4; }
        if(_zag_strcmp(s, "S") == 1) { return 5; }
        if(_zag_strcmp(s, "SW") == 1) { return 6; }
        if(_zag_strcmp(s, "W") == 1) { return 7; }
        if(_zag_strcmp(s, "NW") == 1) { return 8; }
    }
    return -1;
}

// ================= ledger ===================================================
// Record bytes (277): [0]=tid [1]=jcode [2]=disp [3..4]=norm LE16
// [5..12]=pred_hash LE64 [13..20]=obs_hash LE64 [21..276]=residuals[256].
fn ledger_record(rec:[]u8, tid:i32, j:i64, disp:i64, norm:i64,
                 ph:i64, oh:i64, rv:[]u8) void {
    zero8(rec);
    rec[0] = (tid & 255) as u8;
    rec[1] = (j & 255) as u8;
    rec[2] = (disp & 255) as u8;
    t_put16(rec, 3, norm);
    t_put64(rec, 5, ph);
    t_put64(rec, 13, oh);
    let i:i32 = 0;
    while(i < 256) { rec[21 + i] = rv[i]; i = i + 1; }
}
// append a signed int with no key (for composite lines)
fn ob_sint(ob:[]u8, pos:i32, v:i64) i32 {
    if(v < 0) {
        pos = ob_add(ob, pos, "-");
        pos = ob_add(ob, pos, _zag_i64_to_str(0 - v));
    }
    if(v >= 0) { pos = ob_add(ob, pos, _zag_i64_to_str(v)); }
    return pos;
}
// emit "residuals=" + 256 comma-separated signed ints + "\n"
fn ob_residuals(ob:[]u8, pos:i32, rv:[]u8) i32 {
    pos = ob_add(ob, pos, "residuals=");
    let i:i32 = 0;
    while(i < 256) {
        let v:i64 = rv[i] as i64;
        if(v >= 128) { v = v - 256; }
        if(v < 0) {
            pos = ob_add(ob, pos, "-");
            pos = ob_add(ob, pos, _zag_i64_to_str(0 - v));
        }
        if(v >= 0) { pos = ob_add(ob, pos, _zag_i64_to_str(v)); }
        if(i < 255) { pos = ob_add(ob, pos, ","); }
        i = i + 1;
    }
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// run one fixture through the task pipeline; fills ps, returns 0 ok / -1
fn run_task(tid:i32, buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32,
            ps:[]u8) i32 {
    zero8(ps);
    let np2:i32 = -1;
    if(tid == 1) { np2 = task_colordisc(buf, n, op, ob, pos, ps); }
    if(tid == 2) { np2 = task_colorconst(buf, n, op, ob, pos, ps); }
    if(tid == 3) { np2 = task_shapetrans(buf, n, op, ob, pos, ps); }
    if(tid == 4) { np2 = task_pitchdisc(buf, n, op, ob, pos, ps); }
    if(tid == 5) { np2 = task_timbredisc(buf, n, op, ob, pos, ps); }
    if(tid == 6) { np2 = task_motiondir(buf, n, op, ob, pos, ps); }
    return np2;
}

// ================= single-fixture mode =====================================
fn single_main(a1:[]u8, a2:[]u8, tid:i32) i32 {
    let buf:[]u8 = nio_alloc(8388608);
    if(buf.len == 0) { return fail(a1, "alloc_failed"); }
    let n:i64 = z_read(a2, buf, 8388608);
    if(n < 12) { nio_free(buf); return fail(a1, "read_failed"); }
    let op:[]u8 = nio_alloc(8);
    let ob:[]u8 = nio_alloc(16384);
    let ps:[]u8 = nio_alloc(336);
    let rv:[]u8 = nio_alloc(256);
    if(op.len == 0 || ob.len == 0 || ps.len == 0 || rv.len == 0) {
        return fail(a1, "alloc_failed");
    }
    zero8(op);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "G2");
    pos = ob_kv(ob, pos, "task", a1);
    let np2:i32 = run_task(tid, buf, n as i32, op, ob, pos, ps);
    if(np2 < 0) { return fail(a1, "task_failed"); }
    pos = np2;
    g2_finalize(ps, rv, op);
    let conf:i64 = t_get64(ps, 8);
    let norm:i64 = t_get64(ps, 296);
    let ph:i64 = t_get64(ps, 304);
    let oh:i64 = t_get64(ps, 312);
    let disp:i64 = t_get64(ps, 320);
    pos = ob_kint(ob, pos, "confidence", conf);
    if(disp == 1) { pos = ob_kv(ob, pos, "disposition", "INSTALL"); }
    if(disp == 0) { pos = ob_kv(ob, pos, "disposition", "WITHHOLD"); }
    pos = ob_kint(ob, pos, "residual_norm", norm);
    pos = ob_khex(ob, pos, "pred_hash", ph);
    pos = ob_khex(ob, pos, "obs_hash", oh);
    pos = ob_residuals(ob, pos, rv);
    // ledger over the single record
    let rec:[]u8 = nio_alloc(277);
    if(rec.len == 0) { return fail(a1, "alloc_failed"); }
    ledger_record(rec, tid, t_get64(ps, 0), disp, norm, ph, oh, rv);
    let lh:i64 = fnv64_str(fnv64_init(), "G2-PRP-1");
    lh = fnv64_bytes(lh, rec, 277);
    nio_free(rec);
    pos = ob_khex(ob, pos, "ledger", lh);
    pos = ob_kint(ob, pos, "ops", t_get64(op, 0));
    if(nio_write_all(1, ob[0..pos]) != pos as i64) { return fail(a1, "write_failed"); }
    return 0;
}

// ================= batch (memory-stream) mode =============================
// Manifest lines: "<task> <fixture> <contract|ablated>".
// Memory: installed entries ranked by prediction-consistency at retrieval.
// ablated mode: identical percepts, contract-less (always-install) gate.
fn batch_main(mpath:[]u8) i32 {
    let mb:[]u8 = nio_alloc(1048576);
    if(mb.len == 0) { return fail("batch", "alloc_failed"); }
    let mn:i64 = z_read(mpath, mb, 1048576);
    if(mn <= 0) { return fail("batch", "manifest_read_failed"); }
    // memory store arenas
    let memn:[]u8 = nio_alloc(8);
    let mem_task:[]u8 = nio_alloc(2048);
    let mem_judg:[]u8 = nio_alloc(2048);
    let mem_cpre:[]u8 = nio_alloc(2048 * 64);
    let mem_cspr:[]u8 = nio_alloc(2048 * 64);
    let mem_nd:[]u8 = nio_alloc(2048);
    let mem_nsd:[]u8 = nio_alloc(2048);
    let mem_ph:[]u8 = nio_alloc(2048 * 8);
    if(memn.len == 0 || mem_task.len == 0 || mem_judg.len == 0
       || mem_cpre.len == 0 || mem_cspr.len == 0 || mem_nd.len == 0
       || mem_nsd.len == 0 || mem_ph.len == 0) {
        return fail("batch", "alloc_failed");
    }
    zero8(memn);
    let buf:[]u8 = nio_alloc(8388608);
    let op:[]u8 = nio_alloc(8);
    let ob:[]u8 = nio_alloc(16384);
    let ps:[]u8 = nio_alloc(336);
    let rv:[]u8 = nio_alloc(256);
    let rec:[]u8 = nio_alloc(277);
    let tb:[]u8 = nio_alloc(4096);
    if(buf.len == 0 || op.len == 0 || ob.len == 0 || ps.len == 0
       || rv.len == 0 || rec.len == 0 || tb.len == 0) {
        return fail("batch", "alloc_failed");
    }
    let chain:i64 = fnv64_str(fnv64_init(), "G2-PRP-1");
    let nrec:i64 = 0;
    let ncorrect:i64 = 0;
    let ninstall:i64 = 0;
    let nfalse:i64 = 0;
    let nwith:i64 = 0;
    let opstot:i64 = 0;
    let rtagree:i64 = 0;
    let rtq:i64 = 0;
    // iterate manifest lines
    let ls:i32 = 0;
    while(ls < mn as i32) {
        let le:i32 = ls;
        while(le < mn as i32 && mb[le] != 10) { le = le + 1; }
        // skip blank / comment lines
        let llen:i32 = le - ls;
        if(llen > 0 && mb[ls] != 35) {
            // rstrip trailing spaces
            while(llen > 0 && mb[ls + llen - 1] == 32) { llen = llen - 1; }
            // find the two spaces
            let sp1:i32 = -1;
            let sp2:i32 = -1;
            let q:i32 = 0;
            while(q < llen) {
                if(mb[ls + q] == 32) {
                    if(sp1 < 0) { sp1 = q; }
                    if(sp1 >= 0 && q > sp1 && sp2 < 0) { sp2 = q; }
                }
                q = q + 1;
            }
            if(sp1 < 0 || sp2 < 0) { return fail("batch", "manifest_parse"); }
            let ts:[]u8 = mb[ls..ls+sp1];
            let fs:[]u8 = mb[ls+sp1+1..ls+sp2];
            let ms:[]u8 = mb[ls+sp2+1..ls+llen];
            let tid:i32 = 0;
            if(_zag_strcmp(ts, "colordisc") == 1) { tid = 1; }
            if(_zag_strcmp(ts, "colorconst") == 1) { tid = 2; }
            if(_zag_strcmp(ts, "shapetrans") == 1) { tid = 3; }
            if(_zag_strcmp(ts, "pitchdisc") == 1) { tid = 4; }
            if(_zag_strcmp(ts, "timbredisc") == 1) { tid = 5; }
            if(_zag_strcmp(ts, "motiondir") == 1) { tid = 6; }
            if(tid == 0) { return fail("batch", "bad_task"); }
            let cm:i64 = -1;
            if(_zag_strcmp(ms, "contract") == 1) { cm = 1; }
            if(_zag_strcmp(ms, "ablated") == 1) { cm = 0; }
            if(cm < 0) { return fail("batch", "bad_mode"); }
            let n:i64 = z_read(fs, buf, 8388608);
            if(n < 12) { return fail("batch", "fixture_read_failed"); }
            zero8(op);
            let pos:i32 = 0;
            let np2:i32 = run_task(tid, buf, n as i32, op, ob, pos, ps);
            if(np2 < 0) { return fail("batch", "task_failed"); }
            g2_finalize(ps, rv, op);
            let j:i64 = t_get64(ps, 0);
            let conf:i64 = t_get64(ps, 8);
            let nd:i64 = t_get64(ps, 16);
            let nsd:i64 = t_get64(ps, 24);
            let norm:i64 = t_get64(ps, 296);
            let ph:i64 = t_get64(ps, 304);
            let oh:i64 = t_get64(ps, 312);
            let cdisp:i64 = t_get64(ps, 320);
            // retrieval: rank installed memories by prediction-consistency
            // (agreement of coarse predicted bytes), same task only.
            let bj0:i64 = -1; let bs0:i64 = -1;
            let bj1:i64 = -1; let bs1:i64 = -1;
            let bj2:i64 = -1; let bs2:i64 = -1;
            let e:i64 = 0;
            let mcount:i64 = t_get64(memn, 0);
            while(e < mcount) {
                if((mem_task[e as i32] as i64) == tid as i64) {
                    let sc:i64 = 0;
                    let ii:i64 = 0;
                    while(ii < nd) {
                        let qb:i64 = (q4c(ps_get(ps, 1, ii as i32)) & 255);
                        if((mem_cpre[(e * 64 + ii) as i32] as i64) == qb) {
                            sc = sc + 1;
                        }
                        ii = ii + 1;
                    }
                    ii = 0;
                    while(ii < nsd) {
                        let qb:i64 = (q4c(ps_get(ps, 3, ii as i32)) & 255);
                        if((mem_cspr[(e * 64 + ii) as i32] as i64) == qb) {
                            sc = sc + 1;
                        }
                        ii = ii + 1;
                    }
                    let ej:i64 = mem_judg[e as i32] as i64;
                    if(sc > bs0) {
                        bj2 = bj1; bs2 = bs1;
                        bj1 = bj0; bs1 = bs0;
                        bj0 = ej; bs0 = sc;
                    }
                    if(sc <= bs0 && sc > bs1) {
                        bj2 = bj1; bs2 = bs1;
                        bj1 = ej; bs1 = sc;
                    }
                    if(sc <= bs0 && sc <= bs1 && sc > bs2) {
                        bj2 = ej; bs2 = sc;
                    }
                }
                e = e + 1;
            }
            // retrieval agreement modulates confidence (the retrieval bias
            // made load-bearing): +-100, clamped.
            if(bs0 >= 0) {
                rtq = rtq + 1;
                if(bj0 == j) {
                    rtagree = rtagree + 1;
                    conf = conf + 100;
                    if(conf > 1000) { conf = 1000; }
                }
                if(bj0 != j) {
                    conf = conf - 100;
                    if(conf < 0) { conf = 0; }
                }
            }
            // disposition: contract gate vs ablated always-install
            let disp:i64 = cdisp;
            if(cm == 0) { disp = 1; }
            // truth from the sibling .truth file
            let fl:i32 = fs.len;
            let pb:[]u8 = nio_alloc(fl + 7);
            if(pb.len == 0) { return fail("batch", "alloc_failed"); }
            let qi:i32 = 0;
            while(qi < fl) { pb[qi] = fs[qi]; qi = qi + 1; }
            pb[fl] = 46; pb[fl+1] = 116; pb[fl+2] = 114;
            pb[fl+3] = 117; pb[fl+4] = 116; pb[fl+5] = 104;
            let tn:i64 = z_read(pb, tb, 4096);
            nio_free(pb);
            if(tn < 7) { return fail("batch", "truth_read_failed"); }
            // tb = "truth=<val>\n": value starts at 6
            let ve:i32 = 6;
            while(ve < tn as i32 && tb[ve] != 10 && tb[ve] != 13
                  && tb[ve] != 32) { ve = ve + 1; }
            let vs:[]u8 = tb[6..ve];
            let tc:i64 = parse_truth(tid, vs);
            if(tc < 0) { return fail("batch", "truth_parse"); }
            let correct:i64 = 0;
            if(j == tc) { correct = 1; ncorrect = ncorrect + 1; }
            // ledger chain
            ledger_record(rec, tid, j, disp, norm, ph, oh, rv);
            chain = fnv64_bytes(chain, rec, 277);
            // memory install
            if(disp == 1) {
                ninstall = ninstall + 1;
                if(correct == 0) { nfalse = nfalse + 1; }
                if(mcount >= 2048) { return fail("batch", "memory_full"); }
                mem_task[mcount as i32] = (tid & 255) as u8;
                mem_judg[mcount as i32] = (j & 255) as u8;
                let ii:i64 = 0;
                while(ii < nd) {
                    mem_cpre[(mcount * 64 + ii) as i32] =
                        (q4c(ps_get(ps, 1, ii as i32)) & 255) as u8;
                    ii = ii + 1;
                }
                ii = 0;
                while(ii < nsd) {
                    mem_cspr[(mcount * 64 + ii) as i32] =
                        (q4c(ps_get(ps, 3, ii as i32)) & 255) as u8;
                    ii = ii + 1;
                }
                mem_nd[mcount as i32] = (nd & 255) as u8;
                mem_nsd[mcount as i32] = (nsd & 255) as u8;
                t_put64(mem_ph, (mcount * 8) as i32, ph);
                t_put64(memn, 0, mcount + 1);
            }
            if(disp == 0) { nwith = nwith + 1; }
            opstot = opstot + t_get64(op, 0);
            // per-record output
            pos = 0;
            pos = ob_kint(ob, pos, "rec", nrec);
            pos = ob_kv(ob, pos, "task", ts);
            pos = ob_kv(ob, pos, "fixture", fs);
            pos = emit_judgment(ob, pos, tid, j);
            pos = ob_kv(ob, pos, "truth", vs);
            pos = ob_kint(ob, pos, "correct", correct);
            if(disp == 1) { pos = ob_kv(ob, pos, "disposition", "INSTALL"); }
            if(disp == 0) { pos = ob_kv(ob, pos, "disposition", "WITHHOLD"); }
            pos = ob_kint(ob, pos, "residual_norm", norm);
            pos = ob_khex(ob, pos, "pred_hash", ph);
            pos = ob_khex(ob, pos, "obs_hash", oh);
            pos = ob_residuals(ob, pos, rv);
            pos = ob_add(ob, pos, "retr=");
            pos = ob_sint(ob, pos, bj0);
            pos = ob_add(ob, pos, ":");
            pos = ob_sint(ob, pos, bs0);
            pos = ob_add(ob, pos, ";");
            pos = ob_sint(ob, pos, bj1);
            pos = ob_add(ob, pos, ":");
            pos = ob_sint(ob, pos, bs1);
            pos = ob_add(ob, pos, ";");
            pos = ob_sint(ob, pos, bj2);
            pos = ob_add(ob, pos, ":");
            pos = ob_sint(ob, pos, bs2);
            pos = ob_add(ob, pos, "\n");
            pos = ob_kint(ob, pos, "conf", conf);
            pos = ob_kint(ob, pos, "ops", t_get64(op, 0));
            pos = ob_khex(ob, pos, "chain", chain);
            if(nio_write_all(1, ob[0..pos]) != pos as i64) {
                return fail("batch", "write_failed");
            }
            nrec = nrec + 1;
        }
        ls = le + 1;
    }
    // SUMMARY
    let pos:i32 = 0;
    pos = ob_kint(ob, pos, "records", nrec);
    pos = ob_kint(ob, pos, "correct", ncorrect);
    pos = ob_kint(ob, pos, "installs", ninstall);
    pos = ob_kint(ob, pos, "false_installs", nfalse);
    pos = ob_kint(ob, pos, "withholds", nwith);
    pos = ob_kint(ob, pos, "ops_total", opstot);
    pos = ob_kint(ob, pos, "retr_top1_agree", rtagree);
    pos = ob_kint(ob, pos, "retr_queries", rtq);
    pos = ob_khex(ob, pos, "ledger_final", chain);
    if(nio_write_all(1, ob[0..pos]) != pos as i64) {
        return fail("batch", "write_failed");
    }
    return 0;
}

// ================= main =====================================================
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if(a1.len == 0) { return fail("", "no_task"); }
    if(_zag_strcmp(a1, "batch") == 1) {
        if(a2.len == 0) { return fail(a1, "no_manifest"); }
        return batch_main(a2);
    }
    let tid:i32 = 0;
    if(_zag_strcmp(a1, "colordisc") == 1) { tid = 1; }
    if(_zag_strcmp(a1, "colorconst") == 1) { tid = 2; }
    if(_zag_strcmp(a1, "shapetrans") == 1) { tid = 3; }
    if(_zag_strcmp(a1, "pitchdisc") == 1) { tid = 4; }
    if(_zag_strcmp(a1, "timbredisc") == 1) { tid = 5; }
    if(_zag_strcmp(a1, "motiondir") == 1) { tid = 6; }
    if(tid == 0) { return fail(a1, "bad_task"); }
    if(a2.len == 0) { return fail(a1, "no_fixture"); }
    return single_main(a1, a2, tid);
}

// r4.zag -- R4 disconfirmation-seeking queries, pure Zag.
//
// R4/M2: preserve each neutral baseline query verbatim and add at least one
// deterministic disconfirmation-seeking query per claim.
//
// fn r4_disconfirm(claim:[]u8, out:[]u8)i32 -- writes "is it true that NOT <claim>"
// style query into out, returns length. Deterministic.

fn r4_disconfirm(claim:[]u8,out:[]u8)i32{
    let pre:[]u8="evidence against: ";
    let i:i32=0;
    while(i<pre.len){
        out[i]=pre[i];
        i=i+1;
    }
    let j:i32=0;
    while(j<claim.len){
        out[i+j]=claim[j];
        j=j+1;
    }
    return i+j;
}

fn main()void{
    return;
}

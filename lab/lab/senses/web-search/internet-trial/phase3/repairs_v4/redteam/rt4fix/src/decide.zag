// decide.zag — rt4fix pipeline-assembly decider (pure Zag, zero RNG).
//
// Implements the v4 pipeline verdict path as a single native decider with two
// modes selected by argv[2]:
//   "old" — the committed (attacked) rule, transcribed from
//            crews/pipeline/work/run1/ledger_solo.tsv + assemble_v4.py:
//            R3 gate -> R6 DENY terminal -> JOKE-FAMILY gate -> R5 vote
//            (w1>w2 INSTALL; w2>w1 REJECT; tie WITHHOLD). R6 AFFIRM (tag 1)
//            is DISCARDED: it falls through to the R5 vote.
//   "new" — the repaired assembly:
//            R3 gate (terminal)
//            -> R6 DENY (tag 2, terminal REJECT)
//            -> R6 AFFIRM (tag 1 + non-empty proof, terminal INSTALL; the
//               affirmation can no longer be lost downstream)
//            -> JOKE-FAMILY terminal gate (unchanged: 2/3 REJECT else WITHHOLD)
//            -> absurdity screen for ALL items (joke intent 2/3 -> REJECT,
//               independent of claim_type / FACTUAL tag)
//            -> R5 vote WITH QUORUM:
//               INSTALL iff w1>w2 AND w1>=16 AND endorse_rows>=2
//               REJECT  iff w2>w1 AND w2>=16 AND deny_rows>=2
//               else WITHHOLD (a lone heuristic signal can never decide)
//
// Input (argv[1]): TSV lines
//   id \t gated \t logic_tag \t logic_proof \t is_joke \t joke_intent
//      \t w0 \t w1 \t w2 \t n_endorse \t n_deny
// Output per line:
//   id \t DISP \t ATTRIB \t why
// DISP: INSTALL | REJECT | WITHHOLD. ATTRIB: R3 | R6 | JOKE | R5.
//
// znc notes: no slice ==, no indexed []i32 tables, else-nesting kept <= 4,
// _zag_arg never gated on argc.

fn dz_alloc(n:i32)[]u8{
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    return p[0..n];
}

fn dz_read(path:[]u8)[]u8{
    let nlen:i32=path.len+1;
    let np:[]u8=dz_alloc(nlen);
    if(np.len==0){return "";}
    let i:i32=0;
    while(i<path.len){np[i]=path[i];i=i+1;}
    np[path.len]=0;
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(np) as i64,0,0,0,0,0);
    if(fd<0){return "";}
    let cap:i32=4194304;
    let buf:[]u8=dz_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let r:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(r==-4){continue;}
        if(r<=0){break;}
        at=at+(r as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}

fn dz_atoi(s:[]u8)i32{
    let v:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48){if(c<=57){v=v*10+((c-48) as i32);}}
        i=i+1;
    }
    return v;
}

fn dz_field(line:[]u8,idx:i32)[]u8{
    let f:i32=0;
    let s:i32=0;
    let i:i32=0;
    while(i<=line.len){
        let isend:i32=0;
        if(i==line.len){isend=1;}
        if(isend==0){if(line[i]==9){isend=1;}}
        if(isend!=0){
            if(f==idx){return line[s..i];}
            f=f+1;
            s=i+1;
        }
        i=i+1;
    }
    return "";
}

// Returns code = disp*8 + attrib.
// disp: 0=WITHHOLD 1=INSTALL 2=REJECT. attrib: 0=R3 1=R6 2=JOKE 3=R5.
//
// dz_old: the COMMITTED rule, transcribed from the frozen v3 trial driver
// (docs/lab/.../phase3/trial_v3/src/v3_trial.zag, branch tnn-native-lab):
//   R3 gate -> R6 CONTRADICTS (tag 2) terminal REJECT; tag 1 (SUPPORTS) is
//   NOT handled and falls through (defect 1) -> JOKE-FAMILY gate (helper
//   rule collapsed to final intent here; 2/3 REJECT else WITHHOLD) ->
//   R5 plurality: best=0/bestw=w0; w1>bestw -> best=1; w2>bestw -> best=2;
//   bestw<8 -> WITHHOLD; best==1 -> INSTALL; best==2 -> REJECT; else WITHHOLD.
// NOTE: RT4's report transcribed the R5 rule as w1>w2 (missing both the
// w0-plurality and the bestw<8 floor); the driver source above is ground
// truth. On the 64 RT4 corpus items both readings agree item-for-item.
fn dz_old(gated:i32,ltag:i32,isjoke:i32,jint:i32,w0:i32,w1:i32,w2:i32)i32{
    if(gated==1){return 0;}
    if(ltag==2){return 2*8+1;}
    if(isjoke==1){
        if(jint==2){return 2*8+2;}
        if(jint==3){return 2*8+2;}
        return 2;
    }
    let best:i32=0;
    let bestw:i32=w0;
    if(w1>bestw){best=1;bestw=w1;}
    if(w2>bestw){best=2;bestw=w2;}
    if(bestw<8){return 3;}
    if(best==1){return 1*8+3;}
    if(best==2){return 2*8+3;}
    return 3;
}

// dz_new: the repaired assembly. Changes vs dz_old:
//   1. R6 SUPPORTS (tag 1 + non-empty proof) is terminal INSTALL: a proven
//      affirmation can no longer be discarded into the vote (defect 1).
//   2. Absurdity screen for ALL items: joke intent 2/3 on a non-joke item
//      -> WITHHOLD (a lone heuristic signal quarantines but never rejects
//      and never installs; defect 4). JOKE-FAMILY gate unchanged.
//   3. R5 quorum: INSTALL needs best==1 AND bestw>=16 AND >=2 endorsing
//      rows; REJECT needs best==2 AND bestw>=16 AND >=2 denying rows;
//      otherwise WITHHOLD. One weak endorse can no longer install
//      (defect 3); one deny can no longer unilaterally reject (defect 2).
fn dz_new(gated:i32,ltag:i32,proof:[]u8,isjoke:i32,jint:i32,w0:i32,w1:i32,w2:i32,ne:i32,nd:i32)i32{
    if(gated==1){return 0;}
    if(ltag==2){return 2*8+1;}
    if(ltag==1){
        if(proof.len>0){return 1*8+1;}
    }
    if(isjoke==1){
        if(jint==2){return 2*8+2;}
        if(jint==3){return 2*8+2;}
        return 2;
    }
    if(jint==2){return 2;}
    if(jint==3){return 2;}
    let best:i32=0;
    let bestw:i32=w0;
    if(w1>bestw){best=1;bestw=w1;}
    if(w2>bestw){best=2;bestw=w2;}
    if(best==1){
        if(bestw>=16){
            if(ne>=2){return 1*8+3;}
        }
    }
    if(best==2){
        if(bestw>=16){
            if(nd>=2){return 2*8+3;}
        }
    }
    return 3;
}

fn dz_out(id:[]u8,code:i32)void{
    let disp:i32=code/8;
    let att:i32=code-(disp*8);
    _zag_print(id);
    _zag_print("\t");
    if(disp==1){_zag_print("INSTALL");}
    if(disp==2){_zag_print("REJECT");}
    if(disp==0){_zag_print("WITHHOLD");}
    _zag_print("\t");
    if(att==0){_zag_print("R3");}
    if(att==1){_zag_print("R6");}
    if(att==2){_zag_print("JOKE");}
    if(att==3){_zag_print("R5");}
    _zag_print("\n");
    return;
}

fn main()i32{
    let path:[]u8=_zag_arg(1);
    let smode:[]u8=_zag_arg(2);
    let newmode:i32=0;
    if(smode.len==3){
        if(smode[0]==110){if(smode[1]==101){if(smode[2]==119){newmode=1;}}}
    }
    let data:[]u8=dz_read(path);
    let at:i32=0;
    while(at<data.len){
        let eol:i32=at;
        while(eol<data.len){if(data[eol]==10){break;}eol=eol+1;}
        let line:[]u8=data[at..eol];
        if(line.len>0){
            let id:[]u8=dz_field(line,0);
            let gated:i32=dz_atoi(dz_field(line,1));
            let ltag:i32=dz_atoi(dz_field(line,2));
            let proof:[]u8=dz_field(line,3);
            let isjoke:i32=dz_atoi(dz_field(line,4));
            let jint:i32=dz_atoi(dz_field(line,5));
            let w0:i32=dz_atoi(dz_field(line,6));
            let w1:i32=dz_atoi(dz_field(line,7));
            let w2:i32=dz_atoi(dz_field(line,8));
            let ne:i32=dz_atoi(dz_field(line,9));
            let nd:i32=dz_atoi(dz_field(line,10));
            let code:i32=0;
            if(newmode==1){
                code=dz_new(gated,ltag,proof,isjoke,jint,w0,w1,w2,ne,nd);
            }else{
                code=dz_old(gated,ltag,isjoke,jint,w0,w1,w2);
            }
            dz_out(id,code);
        }
        at=eol+1;
    }
    return 0;
}

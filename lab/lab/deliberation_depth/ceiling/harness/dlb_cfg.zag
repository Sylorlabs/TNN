// dlb_cfg.zag — depth-config file parser for the H5 deliberation harness.
//
// Format (documented in CONFIG_FORMAT.md): UTF-8 text, one `key=value` per
// line, `#` starts a comment, blank lines ignored. All keys required exactly
// once; unknown keys rejected. Pure Zag, deterministic.
//
// Required keys:
//   mode                 shallow | deep | adaptive | bound   (H5B: bound added;
//                          bound = residual-flip bound stopping rule)
//   shallow_rounds       fixed round count for mode=shallow (>=1)
//   deep_rounds          fixed round count for mode=deep (>=1)
//   adaptive_min_rounds  (>=1), adaptive_max_rounds (>= adaptive_min_rounds)
//   conf_threshold       fixed-point thousandths, >=0
//   stability_window     >=1
//   epsilon              fixed-point thousandths, >=0
//   elim_margin          fixed-point thousandths, >=0
//   refute_threshold     fixed-point thousandths, >=0
//   evidence_cap         >=0

struct DCfg {
    mode:i32,
    shallow_rounds:i32, deep_rounds:i32,
    amin:i32, amax:i32,
    conf_thr:i32, stab_win:i32, eps:i32,
    elim_margin:i32, refute_thr:i32, evcap:i32
}
fn dlb_cfg_mode_name(m:i32)[]u8 {
    if(m==0){return "shallow";}
    if(m==1){return "deep";}
    if(m==3){return "bound";}
    return "adaptive";
}
// trim leading/trailing space, tab, CR
fn dlb_trim(s:[]u8)[]u8 {
    let a:i32=0;let b:i32=s.len;
    while(a<b){
        let c:u8=s[a];
        if(c==32 || c==9 || c==13){a=a+1;}else{break;}
    }
    while(b>a){
        let c:u8=s[b-1];
        if(c==32 || c==9 || c==13){b=b-1;}else{break;}
    }
    return s[a..b];
}
// find key index: 0=mode,1=shallow_rounds,2=deep_rounds,3=adaptive_min_rounds,
// 4=adaptive_max_rounds,5=conf_threshold,6=stability_window,7=epsilon,
// 8=elim_margin,9=refute_threshold,10=evidence_cap; -1 unknown
fn dlb_cfg_keyidx(k:[]u8)i32 {
    if(dlb_streq(k,"mode")==1){return 0;}
    if(dlb_streq(k,"shallow_rounds")==1){return 1;}
    if(dlb_streq(k,"deep_rounds")==1){return 2;}
    if(dlb_streq(k,"adaptive_min_rounds")==1){return 3;}
    if(dlb_streq(k,"adaptive_max_rounds")==1){return 4;}
    if(dlb_streq(k,"conf_threshold")==1){return 5;}
    if(dlb_streq(k,"stability_window")==1){return 6;}
    if(dlb_streq(k,"epsilon")==1){return 7;}
    if(dlb_streq(k,"elim_margin")==1){return 8;}
    if(dlb_streq(k,"refute_threshold")==1){return 9;}
    if(dlb_streq(k,"evidence_cap")==1){return 10;}
    return -1;
}
fn dlb_cfg_setnum(cfg:*DCfg,idx:i32,v:[]u8)i32 {
    // strict integer syntax: optional '-', then 1+ digits, nothing else
    if(v.len<1){return -4;}
    let i:i32=0;
    if(v[0]==45){i=1;}
    if(i>=v.len){return -4;}
    let nd:i32=0;
    while(i<v.len){
        let c:u8=v[i];
        if(c<48 || c>57){return -4;}
        nd=nd+1;i=i+1;
    }
    let n:i32=dlb_atoi(v);
    if(n<0){return -4;}
    if(idx==1){cfg.*.shallow_rounds=n;}
    if(idx==2){cfg.*.deep_rounds=n;}
    if(idx==3){cfg.*.amin=n;}
    if(idx==4){cfg.*.amax=n;}
    if(idx==5){cfg.*.conf_thr=n;}
    if(idx==6){cfg.*.stab_win=n;}
    if(idx==7){cfg.*.eps=n;}
    if(idx==8){cfg.*.elim_margin=n;}
    if(idx==9){cfg.*.refute_thr=n;}
    if(idx==10){cfg.*.evcap=n;}
    return 0;
}
// Returns 0 ok; -1 malformed line, -2 unknown key, -3 duplicate key,
// -4 bad integer, -5 missing key, -6 bad mode, -7 bad value combination.
fn dlb_cfg_parse(cfg:*DCfg,buf:[]u8,n:i32)i32 {
    cfg.*.mode=-1;
    cfg.*.shallow_rounds=-1;cfg.*.deep_rounds=-1;
    cfg.*.amin=-1;cfg.*.amax=-1;
    cfg.*.conf_thr=-1;cfg.*.stab_win=-1;cfg.*.eps=-1;
    cfg.*.elim_margin=-1;cfg.*.refute_thr=-1;cfg.*.evcap=-1;
    let seen:[]u8=nio_alloc(11);
    if(seen.len==0){return -5;}
    let i:i32=0;
    while(i<n){
        let e:i32=i;
        while(e<n && buf[e]!=10){e=e+1;}
        let line:[]u8=dlb_trim(buf[i..e]);
        if(line.len>0 && line[0]!=35){
            let eq:i32=-1;let k:i32=0;
            while(k<line.len){
                if(line[k]==61){eq=k;break;}
                k=k+1;
            }
            if(eq<0){nio_free(seen);return -1;}
            let key:[]u8=dlb_trim(line[0..eq]);
            let val:[]u8=dlb_trim(line[eq+1..line.len]);
            let idx:i32=dlb_cfg_keyidx(key);
            if(idx<0){nio_free(seen);return -2;}
            if(seen[idx]==1){nio_free(seen);return -3;}
            seen[idx]=1;
            if(idx==0){
                if(dlb_streq(val,"shallow")==1){cfg.*.mode=0;}
                if(dlb_streq(val,"deep")==1){cfg.*.mode=1;}
                if(dlb_streq(val,"adaptive")==1){cfg.*.mode=2;}
                if(dlb_streq(val,"bound")==1){cfg.*.mode=3;}
                if(cfg.*.mode<0){nio_free(seen);return -6;}
            }
            if(idx>0){
                let rc:i32=dlb_cfg_setnum(cfg,idx,val);
                if(rc!=0){nio_free(seen);return rc;}
            }
        }
        i=e+1;
    }
    nio_free(seen);
    let k2:i32=0;
    while(k2<11){
        if(k2==0 && cfg.*.mode<0){return -5;}
        if(k2==1 && cfg.*.shallow_rounds<0){return -5;}
        if(k2==2 && cfg.*.deep_rounds<0){return -5;}
        if(k2==3 && cfg.*.amin<0){return -5;}
        if(k2==4 && cfg.*.amax<0){return -5;}
        if(k2==5 && cfg.*.conf_thr<0){return -5;}
        if(k2==6 && cfg.*.stab_win<0){return -5;}
        if(k2==7 && cfg.*.eps<0){return -5;}
        if(k2==8 && cfg.*.elim_margin<0){return -5;}
        if(k2==9 && cfg.*.refute_thr<0){return -5;}
        if(k2==10 && cfg.*.evcap<0){return -5;}
        k2=k2+1;
    }
    if(cfg.*.shallow_rounds<1 || cfg.*.deep_rounds<1){return -7;}
    if(cfg.*.amin<1 || cfg.*.amax<cfg.*.amin){return -7;}
    if(cfg.*.stab_win<1){return -7;}
    return 0;
}
// canonical one-line config summary (also written to the ledger CONFIG step)
fn dlb_cfg_summary(cfg:*DCfg,o:*DOut)void {
    dout_str(o,"mode=");
    dout_str(o,dlb_cfg_mode_name(cfg.*.mode));
    dout_str(o," shallow=");
    dout_i64(o,cfg.*.shallow_rounds as i64);
    dout_str(o," deep=");
    dout_i64(o,cfg.*.deep_rounds as i64);
    dout_str(o," amin=");
    dout_i64(o,cfg.*.amin as i64);
    dout_str(o," amax=");
    dout_i64(o,cfg.*.amax as i64);
    dout_str(o," cthr=");
    dout_i64(o,cfg.*.conf_thr as i64);
    dout_str(o," win=");
    dout_i64(o,cfg.*.stab_win as i64);
    dout_str(o," eps=");
    dout_i64(o,cfg.*.eps as i64);
    dout_str(o," elim=");
    dout_i64(o,cfg.*.elim_margin as i64);
    dout_str(o," ref=");
    dout_i64(o,cfg.*.refute_thr as i64);
    dout_str(o," evcap=");
    dout_i64(o,cfg.*.evcap as i64);
}

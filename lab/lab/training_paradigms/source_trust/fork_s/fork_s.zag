// fork_s.zag — Fork S: structural trust (no scalar). Frozen build spec:
// training_paradigms/source_trust/fork_s/BUILD_SPEC_S.md
// Pure Zag. Zero RNG in decision paths. Deterministic: no clock, no I/O,
// no iteration over unordered structures; all scans in index order.
//
// Layout: one []u8 arena, all i32 words little-endian.
//   HDR 16 words @0: n_src n_claim n_world n_ev n_edge last_ep n_map rsv...
//   SRC  64 x 4 words @64:    first_seen ev_head rsv rsv
//   CLAIM 1024 x 30 words @1088: key val wstatus wep n_assert first a[12] e[12]
//   WORLD 2048 x 3 words @123968: key val ep
//   EV 4096 x 8 words @148544: tag ep key val aux1 aux2 status next
//     tag: 1=VIND 2=WERR 3=PROV 4=LIE ; status: 0=open 1=repaired 2=superseded
//   EDGE 2048 x 3 words @279616: a b kind(1=coassert 2=contradict)
//   MAP 128 x 2 words @304192: ext_id intern_id
// ARENA_BYTES = 305216 ; WBUF_BYTES = 2048
// Frozen structural params: CORROB_QUORUM=2, REPAIR_QUORUM=3, CLUSTER_MIN=2.

fn z_alloc(n:i32)[]u8 {
    if (n < 1) { let e0:[]u8 = ""; return e0; }
    let p:*u8 = _zag_malloc(n as i64) as *u8;
    if ((p as i64) == 0) { let e1:[]u8 = ""; return e1; }
    let b:[]u8 = p[0..n];
    let i:i32 = 0;
    while (i < n) { b[i] = 0; i = i + 1; }
    return b;
}
fn g32(b:[]u8, o:i32)i32 {
    let v:i32 = 0;
    v = v | ((b[o] as i32) & 255);
    v = v | (((b[o + 1] as i32) & 255) << 8);
    v = v | (((b[o + 2] as i32) & 255) << 16);
    v = v | (((b[o + 3] as i32) & 255) << 24);
    return v;
}
fn s32(b:[]u8, o:i32, v:i32)void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
}
fn hg(ar:[]u8, w:i32)i32 { return g32(ar, w * 4); }
fn hs(ar:[]u8, w:i32, v:i32)void { s32(ar, w * 4, v); }

struct ForkHist { arena:[]u8, wbuf:[]u8, wpos:i32 }

fn s_init()ForkHist {
    let ar:[]u8 = z_alloc(305216);
    let wb:[]u8 = z_alloc(2048);
    let h:ForkHist = ForkHist{.arena = ar, .wbuf = wb, .wpos = 0};
    return h;
}

// ---- source id map: external id -> internal slot
fn src_intern(ar:[]u8, ext:i32)i32 {
    let nm:i32 = hg(ar, 6);
    let i:i32 = 0;
    while (i < nm) {
        if (g32(ar, 304192 + i * 8) == ext) { return g32(ar, 304192 + i * 8 + 4); }
        i = i + 1;
    }
    let ns:i32 = hg(ar, 0);
    if (ns >= 64) { return -1; }
    if (nm >= 128) { return -1; }
    s32(ar, 304192 + nm * 8, ext);
    s32(ar, 304192 + nm * 8 + 4, ns);
    hs(ar, 6, nm + 1);
    s32(ar, 64 + ns * 16, -1);
    s32(ar, 64 + ns * 16 + 4, -1);
    s32(ar, 64 + ns * 16 + 8, 0);
    s32(ar, 64 + ns * 16 + 12, 0);
    hs(ar, 0, ns + 1);
    return ns;
}
fn src_ext(ar:[]u8, intern:i32)i32 {
    let nm:i32 = hg(ar, 6);
    let i:i32 = 0;
    while (i < nm) {
        if (g32(ar, 304192 + i * 8 + 4) == intern) { return g32(ar, 304192 + i * 8); }
        i = i + 1;
    }
    return -1;
}

// ---- claims
fn cw(ar:[]u8, c:i32, w:i32)i32 { return g32(ar, 1088 + c * 120 + w * 4); }
fn cw_set(ar:[]u8, c:i32, w:i32, v:i32)void { s32(ar, 1088 + c * 120 + w * 4, v); }
fn claim_find(ar:[]u8, key:i32, val:i32)i32 {
    let nc:i32 = hg(ar, 1);
    let c:i32 = 0;
    while (c < nc) {
        if (cw(ar, c, 0) == key) {
            if (cw(ar, c, 1) == val) { return c; }
        }
        c = c + 1;
    }
    return -1;
}
fn claim_get(ar:[]u8, key:i32, val:i32, s:i32, ep:i32)i32 {
    let f:i32 = claim_find(ar, key, val);
    if (f >= 0) {
        let na:i32 = cw(ar, f, 4);
        let j:i32 = 0;
        while (j < na) {
            if (cw(ar, f, 6 + j) == s) {
                cw_set(ar, f, 18 + j, ep);
                return f;
            }
            j = j + 1;
        }
        if (na < 12) {
            cw_set(ar, f, 6 + na, s);
            cw_set(ar, f, 18 + na, ep);
            cw_set(ar, f, 4, na + 1);
        }
        return f;
    }
    let nc:i32 = hg(ar, 1);
    if (nc >= 1024) { return -1; }
    let c:i32 = nc;
    cw_set(ar, c, 0, key);
    cw_set(ar, c, 1, val);
    cw_set(ar, c, 2, 0);
    cw_set(ar, c, 3, 0);
    cw_set(ar, c, 4, 1);
    cw_set(ar, c, 5, s);
    cw_set(ar, c, 6, s);
    cw_set(ar, c, 18, ep);
    hs(ar, 1, nc + 1);
    return c;
}

// ---- world timeline
fn world_add(ar:[]u8, key:i32, val:i32, ep:i32)void {
    let nw:i32 = hg(ar, 2);
    if (nw >= 2048) { return; }
    s32(ar, 123968 + nw * 12, key);
    s32(ar, 123968 + nw * 12 + 4, val);
    s32(ar, 123968 + nw * 12 + 8, ep);
    hs(ar, 2, nw + 1);
}
fn world_ep(ar:[]u8, key:i32)i32 {
    let nw:i32 = hg(ar, 2);
    let best:i32 = -1;
    let bv:i32 = 0;
    let i:i32 = 0;
    while (i < nw) {
        if (g32(ar, 123968 + i * 12) == key) {
            let e:i32 = g32(ar, 123968 + i * 12 + 8);
            if (e > best) { best = e; bv = g32(ar, 123968 + i * 12 + 4); }
        }
        i = i + 1;
    }
    if (best < 0) { return -1; }
    return best;
}
fn world_val(ar:[]u8, key:i32)i32 {
    let nw:i32 = hg(ar, 2);
    let best:i32 = -1;
    let bv:i32 = 0;
    let i:i32 = 0;
    while (i < nw) {
        if (g32(ar, 123968 + i * 12) == key) {
            let e:i32 = g32(ar, 123968 + i * 12 + 8);
            if (e > best) { best = e; bv = g32(ar, 123968 + i * 12 + 4); }
        }
        i = i + 1;
    }
    return bv;
}

// ---- source event log (tags: 1=VIND 2=WERR 3=PROV 4=LIE; status 0=open 1=repaired 2=superseded)
fn ev_add(ar:[]u8, s:i32, tag:i32, ep:i32, key:i32, val:i32, a1:i32, a2:i32)i32 {
    let ne:i32 = hg(ar, 3);
    if (ne >= 4096) { return -1; }
    let e:i32 = ne;
    let eb:i32 = 148544 + e * 32;
    s32(ar, eb, tag);
    s32(ar, eb + 4, ep);
    s32(ar, eb + 8, key);
    s32(ar, eb + 12, val);
    s32(ar, eb + 16, a1);
    s32(ar, eb + 20, a2);
    s32(ar, eb + 24, 0);
    let hd:i32 = g32(ar, 64 + s * 16 + 4);
    s32(ar, eb + 28, hd);
    s32(ar, 64 + s * 16 + 4, e);
    hs(ar, 3, ne + 1);
    return e;
}
fn ev_has_open(ar:[]u8, s:i32, tag:i32)i32 {
    let e:i32 = g32(ar, 64 + s * 16 + 4);
    while (e >= 0) {
        let eb:i32 = 148544 + e * 32;
        if (g32(ar, eb) == tag) {
            if (g32(ar, eb + 24) == 0) { return 1; }
        }
        e = g32(ar, eb + 28);
    }
    return 0;
}
fn ev_find_prov(ar:[]u8, s:i32, key:i32, val:i32)i32 {
    let e:i32 = g32(ar, 64 + s * 16 + 4);
    while (e >= 0) {
        let eb:i32 = 148544 + e * 32;
        if (g32(ar, eb) == 3) {
            if (g32(ar, eb + 24) == 0) {
                if (g32(ar, eb + 8) == key) {
                    if (g32(ar, eb + 12) == val) { return e; }
                }
            }
        }
        e = g32(ar, eb + 28);
    }
    return -1;
}
fn ev_has_vind_on(ar:[]u8, s:i32, key:i32, val:i32)i32 {
    let e:i32 = g32(ar, 64 + s * 16 + 4);
    while (e >= 0) {
        let eb:i32 = 148544 + e * 32;
        if (g32(ar, eb) == 1) {
            if (g32(ar, eb + 8) == key) {
                if (g32(ar, eb + 12) == val) { return 1; }
            }
        }
        e = g32(ar, eb + 28);
    }
    return 0;
}
fn ev_count_tag(ar:[]u8, s:i32, tag:i32, since:i32, upto:i32)i32 {
    let n:i32 = 0;
    let e:i32 = g32(ar, 64 + s * 16 + 4);
    while (e >= 0) {
        let eb:i32 = 148544 + e * 32;
        if (g32(ar, eb) == tag) {
            let ee:i32 = g32(ar, eb + 4);
            if (ee > since) {
                if (ee <= upto) { n = n + 1; }
            }
        }
        e = g32(ar, eb + 28);
    }
    return n;
}
fn ev_open_bad_after(ar:[]u8, s:i32, since:i32, upto:i32)i32 {
    let n:i32 = 0;
    let e:i32 = g32(ar, 64 + s * 16 + 4);
    while (e >= 0) {
        let eb:i32 = 148544 + e * 32;
        let tg:i32 = g32(ar, eb);
        if (tg == 3) { }
        if (tg == 3) {
            if (g32(ar, eb + 24) == 0) {
                let ee:i32 = g32(ar, eb + 4);
                if (ee > since) {
                    if (ee <= upto) { n = n + 1; }
                }
            }
        }
        if (tg == 4) {
            if (g32(ar, eb + 24) == 0) {
                let ee2:i32 = g32(ar, eb + 4);
                if (ee2 > since) {
                    if (ee2 <= upto) { n = n + 1; }
                }
            }
        }
        e = g32(ar, eb + 28);
    }
    return n;
}
// Repair: newest-first single pass (event list is prepend-ordered, so the
// cascade newest->oldest resolves in one pass). REPAIR_QUORUM=3 (frozen).
fn ev_repair(ar:[]u8, s:i32, upto:i32)void {
    let e:i32 = g32(ar, 64 + s * 16 + 4);
    while (e >= 0) {
        let eb:i32 = 148544 + e * 32;
        let tg:i32 = g32(ar, eb);
        let st:i32 = g32(ar, eb + 24);
        let te:i32 = g32(ar, eb + 4);
        let nx:i32 = g32(ar, eb + 28);
        if (st == 0) {
            if (te < upto) {
                if (tg == 3) {
                    let v:i32 = ev_count_tag(ar, s, 1, te, upto);
                    let bad:i32 = ev_open_bad_after(ar, s, te, upto);
                    if (v >= 3) {
                        if (bad == 0) { s32(ar, eb + 24, 1); }
                    }
                }
                if (tg == 4) {
                    let v2:i32 = ev_count_tag(ar, s, 1, te, upto);
                    let bad2:i32 = ev_open_bad_after(ar, s, te, upto);
                    if (v2 >= 3) {
                        if (bad2 == 0) { s32(ar, eb + 24, 1); }
                    }
                }
            }
        }
        e = nx;
    }
}
fn ev_supersede_provs(ar:[]u8, s:i32, key:i32)void {
    let e:i32 = g32(ar, 64 + s * 16 + 4);
    while (e >= 0) {
        let eb:i32 = 148544 + e * 32;
        let nx:i32 = g32(ar, eb + 28);
        if (g32(ar, eb) == 3) {
            if (g32(ar, eb + 24) == 0) {
                if (g32(ar, eb + 8) == key) { s32(ar, eb + 24, 2); }
            }
        }
        e = nx;
    }
}

// ---- edges
fn edge_add(ar:[]u8, a:i32, b:i32, kind:i32)void {
    if (a == b) { return; }
    let ne:i32 = hg(ar, 4);
    let i:i32 = 0;
    while (i < ne) {
        let ea:i32 = g32(ar, 279616 + i * 12);
        let eb2:i32 = g32(ar, 279616 + i * 12 + 4);
        if (g32(ar, 279616 + i * 12 + 8) == kind) {
            if (ea == a) {
                if (eb2 == b) { return; }
            }
            if (ea == b) {
                if (eb2 == a) { return; }
            }
        }
        i = i + 1;
    }
    if (ne >= 2048) { return; }
    s32(ar, 279616 + ne * 12, a);
    s32(ar, 279616 + ne * 12 + 4, b);
    s32(ar, 279616 + ne * 12 + 8, kind);
    hs(ar, 4, ne + 1);
}

// ---- independence: VIND/WERR ever, or a contradiction partner outside c's asserters
fn src_indep(ar:[]u8, s:i32, c:i32)i32 {
    let e:i32 = g32(ar, 64 + s * 16 + 4);
    while (e >= 0) {
        let tg:i32 = g32(ar, 148544 + e * 32);
        if (tg == 1) { return 1; }
        if (tg == 2) { return 1; }
        e = g32(ar, 148544 + e * 32 + 28);
    }
    let ne:i32 = hg(ar, 4);
    let i:i32 = 0;
    while (i < ne) {
        if (g32(ar, 279616 + i * 12 + 8) == 2) {
            let xa:i32 = g32(ar, 279616 + i * 12);
            let xb:i32 = g32(ar, 279616 + i * 12 + 4);
            let pm:i32 = -1;
            if (xa == s) { pm = xb; }
            if (xb == s) { pm = xa; }
            if (pm >= 0) {
                let n:i32 = cw(ar, c, 4);
                let j:i32 = 0;
                let inside:i32 = 0;
                while (j < n) {
                    if (cw(ar, c, 6 + j) == pm) { inside = 1; }
                    j = j + 1;
                }
                if (inside == 0) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}
fn comp_member(ar:[]u8, c:i32, lab:[]u8, r:i32, x:i32)i32 {
    let n:i32 = cw(ar, c, 4);
    let j:i32 = 0;
    while (j < n) {
        if (cw(ar, c, 6 + j) == x) {
            if (g32(lab, j * 4) == r) { return 1; }
            return 0;
        }
        j = j + 1;
    }
    return 0;
}
// ---- corroboration credits (frozen rule; CORROB_QUORUM=2, CLUSTER_MIN=2)
fn claim_credits(ar:[]u8, c:i32)i32 {
    let n:i32 = cw(ar, c, 4);
    if (n == 0) { return 0; }
    let lab:[]u8 = z_alloc(48);
    if (lab.len == 0) { return 0; }
    let i:i32 = 0;
    while (i < n) { s32(lab, i * 4, i); i = i + 1; }
    let ne:i32 = hg(ar, 4);
    let e:i32 = 0;
    while (e < ne) {
        if (g32(ar, 279616 + e * 12 + 8) == 1) {
            let ea:i32 = g32(ar, 279616 + e * 12);
            let eb2:i32 = g32(ar, 279616 + e * 12 + 4);
            let ia:i32 = -1;
            let ib:i32 = -1;
            let j:i32 = 0;
            while (j < n) {
                if (cw(ar, c, 6 + j) == ea) { ia = j; }
                if (cw(ar, c, 6 + j) == eb2) { ib = j; }
                j = j + 1;
            }
            if (ia >= 0) {
                if (ib >= 0) {
                    let ra:i32 = g32(lab, ia * 4);
                    let rb:i32 = g32(lab, ib * 4);
                    if (ra != rb) {
                        let k:i32 = 0;
                        while (k < n) {
                            if (g32(lab, k * 4) == rb) { s32(lab, k * 4, ra); }
                            k = k + 1;
                        }
                    }
                }
            }
        }
        e = e + 1;
    }
    let total:i32 = 0;
    let r:i32 = 0;
    while (r < n) {
        if (g32(lab, r * 4) == r) {
            let sz:i32 = 0;
            let closed:i32 = 1;
            let j2:i32 = 0;
            while (j2 < n) {
                if (g32(lab, j2 * 4) == r) {
                    sz = sz + 1;
                    let m:i32 = cw(ar, c, 6 + j2);
                    let e2:i32 = 0;
                    while (e2 < ne) {
                        let kd:i32 = g32(ar, 279616 + e2 * 12 + 8);
                        let xa:i32 = g32(ar, 279616 + e2 * 12);
                        let xb:i32 = g32(ar, 279616 + e2 * 12 + 4);
                        let pm:i32 = -1;
                        if (xa == m) { pm = xb; }
                        if (xb == m) { pm = xa; }
                        if (pm >= 0) {
                            if (kd == 1) {
                                if (comp_member(ar, c, lab, r, pm) == 0) { closed = 0; }
                            }
                            if (kd == 2) {
                                if (comp_member(ar, c, lab, r, pm) == 1) { closed = 0; }
                            }
                        }
                        e2 = e2 + 1;
                    }
                    let evi:i32 = g32(ar, 64 + m * 16 + 4);
                    while (evi >= 0) {
                        let ebb:i32 = 148544 + evi * 32;
                        let tg2:i32 = g32(ar, ebb);
                        let nx2:i32 = g32(ar, ebb + 28);
                        if (tg2 == 1) {
                            let cc2:i32 = claim_find(ar, g32(ar, ebb + 8), g32(ar, ebb + 12));
                            if (cc2 >= 0) {
                                let na3:i32 = cw(ar, cc2, 4);
                                let q3:i32 = 0;
                                while (q3 < na3) {
                                    if (comp_member(ar, c, lab, r, cw(ar, cc2, 6 + q3)) == 0) { closed = 0; }
                                    q3 = q3 + 1;
                                }
                            }
                        }
                        if (tg2 == 2) {
                            let cc3:i32 = claim_find(ar, g32(ar, ebb + 8), g32(ar, ebb + 12));
                            if (cc3 >= 0) {
                                let na4:i32 = cw(ar, cc3, 4);
                                let q4:i32 = 0;
                                while (q4 < na4) {
                                    if (comp_member(ar, c, lab, r, cw(ar, cc3, 6 + q4)) == 0) { closed = 0; }
                                    q4 = q4 + 1;
                                }
                            }
                        }
                        evi = nx2;
                    }
                }
                j2 = j2 + 1;
            }
            if (closed == 1) {
                if (sz >= 2) {
                    let cred:i32 = 0;
                    let j3:i32 = 0;
                    while (j3 < n) {
                        if (g32(lab, j3 * 4) == r) {
                            let m2:i32 = cw(ar, c, 6 + j3);
                            if (src_indep(ar, m2, c) == 1) {
                                if (ev_has_open(ar, m2, 4) == 0) { cred = 1; }
                            }
                        }
                        j3 = j3 + 1;
                    }
                    total = total + cred;
                }
            } else {
                let j4:i32 = 0;
                while (j4 < n) {
                    if (g32(lab, j4 * 4) == r) {
                        let m3:i32 = cw(ar, c, 6 + j4);
                        if (src_indep(ar, m3, c) == 1) {
                            if (ev_has_open(ar, m3, 4) == 0) { total = total + 1; }
                        }
                    }
                    j4 = j4 + 1;
                }
            }
        }
        r = r + 1;
    }
    return total;
}

// ---- stream observation (fork-private update path; driver calls s_note per episode)
fn note_say(ar:[]u8, ep:i32, s:i32, key:i32, val:i32)void {
    if (g32(ar, 64 + s * 16) < 0) { s32(ar, 64 + s * 16, ep); }
    let c:i32 = claim_get(ar, key, val, s, ep);
    if (c < 0) { return; }
    let na:i32 = cw(ar, c, 4);
    let j:i32 = 0;
    while (j < na) {
        let o:i32 = cw(ar, c, 6 + j);
        if (o != s) { edge_add(ar, s, o, 1); }
        j = j + 1;
    }
    let nc:i32 = hg(ar, 1);
    let cc:i32 = 0;
    while (cc < nc) {
        if (cc != c) {
            if (cw(ar, cc, 0) == key) {
                if (cw(ar, cc, 1) != val) {
                    let na2:i32 = cw(ar, cc, 4);
                    let k2:i32 = 0;
                    while (k2 < na2) {
                        edge_add(ar, s, cw(ar, cc, 6 + k2), 2);
                        k2 = k2 + 1;
                    }
                }
            }
        }
        cc = cc + 1;
    }
    // honest update: open PROV on this key, source now states the world value
    let wep:i32 = world_ep(ar, key);
    if (wep >= 0) {
        if (world_val(ar, key) == val) {
            let e:i32 = g32(ar, 64 + s * 16 + 4);
            while (e >= 0) {
                let eb:i32 = 148544 + e * 32;
                let nx:i32 = g32(ar, eb + 28);
                if (g32(ar, eb) == 3) {
                    if (g32(ar, eb + 24) == 0) {
                        if (g32(ar, eb + 8) == key) {
                            if (g32(ar, eb + 12) != val) {
                                let pep:i32 = g32(ar, eb + 4);
                                ev_add(ar, s, 2, ep, key, val, pep, 0);
                                s32(ar, eb + 24, 2);
                            }
                        }
                    }
                }
                e = nx;
            }
        }
    }
}
fn note_world(ar:[]u8, ep:i32, key:i32, val:i32)void {
    world_add(ar, key, val, ep);
    let nc:i32 = hg(ar, 1);
    let cc:i32 = 0;
    while (cc < nc) {
        if (cw(ar, cc, 0) == key) {
            let cv:i32 = cw(ar, cc, 1);
            if (cv == val) {
                cw_set(ar, cc, 2, 1);
                cw_set(ar, cc, 3, ep);
                let na:i32 = cw(ar, cc, 4);
                let j:i32 = 0;
                while (j < na) {
                    let s:i32 = cw(ar, cc, 6 + j);
                    ev_add(ar, s, 1, ep, key, val, 0, 0);
                    let e:i32 = g32(ar, 64 + s * 16 + 4);
                    while (e >= 0) {
                        let eb:i32 = 148544 + e * 32;
                        let nx:i32 = g32(ar, eb + 28);
                        if (g32(ar, eb) == 4) {
                            if (g32(ar, eb + 24) == 0) {
                                if (g32(ar, eb + 8) == key) {
                                    if (g32(ar, eb + 12) == val) { s32(ar, eb + 24, 2); }
                                }
                            }
                        }
                        e = nx;
                    }
                    ev_repair(ar, s, ep);
                    j = j + 1;
                }
            } else {
                let prev_dis:i32 = -1;
                if (cw(ar, cc, 2) == 2) { prev_dis = cw(ar, cc, 3); }
                cw_set(ar, cc, 2, 2);
                cw_set(ar, cc, 3, ep);
                let na2:i32 = cw(ar, cc, 4);
                let j2:i32 = 0;
                while (j2 < na2) {
                    let s2:i32 = cw(ar, cc, 6 + j2);
                    let slast:i32 = cw(ar, cc, 18 + j2);
                    if (ev_has_vind_on(ar, s2, key, cv)) {
                        ev_add(ar, s2, 2, ep, key, cv, 0, 0);
                    } else {
                        let p2:i32 = ev_find_prov(ar, s2, key, cv);
                        if (prev_dis >= 0) {
                            if (slast > prev_dis) {
                                ev_add(ar, s2, 4, ep, key, cv, 0, 0);
                                if (p2 >= 0) { s32(ar, 148544 + p2 * 32 + 24, 2); }
                            } else {
                                if (p2 < 0) { ev_add(ar, s2, 3, ep, key, cv, 0, 0); }
                            }
                        } else {
                            if (p2 < 0) { ev_add(ar, s2, 3, ep, key, cv, 0, 0); }
                        }
                    }
                    j2 = j2 + 1;
                }
            }
        }
        cc = cc + 1;
    }
}
fn s_note(ep:i32, etype:i32, src:i32, key:i32, val:i32, h:*ForkHist)void {
    let ar:[]u8 = h.*.arena;
    if (ar.len == 0) { return; }
    hs(ar, 5, ep);
    if (etype == 1) {
        let s:i32 = src_intern(ar, src);
        if (s < 0) { return; }
        note_say(ar, ep, s, key, val);
        return;
    }
    if (etype == 2) {
        note_world(ar, ep, key, val);
        return;
    }
}

// ---- warrant builder
fn w_reset(h:*ForkHist)void { h.*.wpos = 0; }
fn w_str(h:*ForkHist, t:[]u8)void {
    let wb:[]u8 = h.*.wbuf;
    let p:i32 = h.*.wpos;
    let i:i32 = 0;
    while (i < t.len) {
        if (p < 2047) { wb[p] = t[i]; p = p + 1; }
        i = i + 1;
    }
    h.*.wpos = p;
}
fn w_i32(h:*ForkHist, v:i32)void {
    let wb:[]u8 = h.*.wbuf;
    let p:i32 = h.*.wpos;
    let vv:i32 = v;
    if (vv < 0) {
        if (p < 2047) { wb[p] = 45; p = p + 1; }
        vv = 0 - vv;
    }
    if (vv == 0) {
        if (p < 2047) { wb[p] = 48; p = p + 1; }
        h.*.wpos = p;
        return;
    }
    let d:i32 = 0;
    let t:i32 = vv;
    while (t > 0) { d = d + 1; t = t / 10; }
    let q:i32 = 0;
    while (q < d) {
        let pw:i32 = 1;
        let k:i32 = 0;
        while (k < d - 1 - q) { pw = pw * 10; k = k + 1; }
        let dig:i32 = vv / pw;
        if (p < 2047) { wb[p] = (48 + dig) as u8; p = p + 1; }
        vv = vv - dig * pw;
        q = q + 1;
    }
    h.*.wpos = p;
}
fn s_warrant(h:*ForkHist)[]u8 {
    let wb:[]u8 = h.*.wbuf;
    let p:i32 = h.*.wpos;
    return wb[0..p];
}

// ---- decision: ordered structural pattern match (see BUILD_SPEC_S.md)
fn s_decide(src:i32, key:i32, val:i32, h:*ForkHist)i32 {
    let ar:[]u8 = h.*.arena;
    w_reset(h);
    if (ar.len == 0) {
        w_str(h, "WITHHOLD: no record store.");
        return 1;
    }
    let ep:i32 = hg(ar, 5);
    let s:i32 = src_intern(ar, src);
    if (s < 0) {
        w_str(h, "WITHHOLD: source table full; cannot read record.");
        return 1;
    }
    let c:i32 = claim_find(ar, key, val);
    if (c < 0) {
        w_str(h, "WITHHOLD: claim absent from record (internal).");
        return 1;
    }
    let sx:i32 = src_ext(ar, s);
    // R1 / R1b: world record
    let wep:i32 = world_ep(ar, key);
    if (wep >= 0) {
        let wv:i32 = world_val(ar, key);
        if (wv != val) {
            w_str(h, "REJECT: claim (k=");
            w_i32(h, key);
            w_str(h, ",v=");
            w_i32(h, val);
            w_str(h, ") contradicts world record (v=");
            w_i32(h, wv);
            w_str(h, ",ep=");
            w_i32(h, wep);
            w_str(h, "). ");
            if (ev_has_vind_on(ar, s, key, val)) {
                ev_add(ar, s, 2, ep, key, val, 0, 0);
                w_str(h, "src ");
                w_i32(h, sx);
                w_str(h, " stated this when true: honest world-change lag, no lie penalty.");
            } else {
                ev_add(ar, s, 4, ep, key, val, 0, 0);
                w_str(h, "src ");
                w_i32(h, sx);
                w_str(h, " asserted against known world record: caught lie.");
            }
            ev_supersede_provs(ar, s, key);
            return 2;
        }
        ev_add(ar, s, 1, ep, key, val, 0, 0);
        ev_repair(ar, s, ep);
        w_str(h, "INSTALL: claim agrees with current world record (k=");
        w_i32(h, key);
        w_str(h, ",v=");
        w_i32(h, val);
        w_str(h, ",ep=");
        w_i32(h, wep);
        w_str(h, ").");
        return 0;
    }
    // R3: independent corroboration (before taint: genuine corroboration is evidence)
    let cr:i32 = claim_credits(ar, c);
    if (cr >= 2) {
        w_str(h, "INSTALL: ");
        w_i32(h, cr);
        w_str(h, " independent corroboration credits on (k=");
        w_i32(h, key);
        w_str(h, ",v=");
        w_i32(h, val);
        w_str(h, "); corroborated truth installs regardless of originator record.");
        return 0;
    }
    // R2: origin taint
    let f:i32 = cw(ar, c, 5);
    if (f != s) {
        if (ev_has_open(ar, f, 4)) {
            w_str(h, "WITHHOLD: claim originated by src ");
            w_i32(h, src_ext(ar, f));
            w_str(h, " with unresolved caught-lie; repetition does not launder.");
            return 1;
        }
    }
    // R4: convicted source, uncorroborated claim
    if (ev_has_open(ar, s, 4)) {
        w_str(h, "REJECT: src ");
        w_i32(h, sx);
        w_str(h, " has unresolved caught-lie; uncorroborated claim not admitted.");
        return 2;
    }
    // R5: open dispute with the world
    if (ev_has_open(ar, s, 3)) {
        w_str(h, "WITHHOLD: src ");
        w_i32(h, sx);
        w_str(h, " has open dispute with world; new claims held pending resolution.");
        return 1;
    }
    // R6: live contradiction
    let nc:i32 = hg(ar, 1);
    let cc:i32 = 0;
    while (cc < nc) {
        if (cw(ar, cc, 0) == key) {
            if (cw(ar, cc, 1) != val) {
                let na:i32 = cw(ar, cc, 4);
                let j:i32 = 0;
                let live:i32 = 0;
                let who:i32 = -1;
                while (j < na) {
                    let s2:i32 = cw(ar, cc, 6 + j);
                    if (ev_has_open(ar, s2, 4) == 0) { live = 1; who = s2; }
                    j = j + 1;
                }
                if (live == 1) {
                    w_str(h, "WITHHOLD: live contradiction on k=");
                    w_i32(h, key);
                    w_str(h, " (v=");
                    w_i32(h, val);
                    w_str(h, " vs v=");
                    w_i32(h, cw(ar, cc, 1));
                    w_str(h, " by src ");
                    w_i32(h, src_ext(ar, who));
                    w_str(h, "); no world resolution.");
                    return 1;
                }
            }
        }
        cc = cc + 1;
    }
    // R7: manufactured-consensus shape
    let na0:i32 = cw(ar, c, 4);
    if (na0 >= 2) {
        if (cr == 0) {
            w_str(h, "WITHHOLD: ");
            w_i32(h, na0);
            w_str(h, " asserters, 0 independent credits (closed co-assertion cluster, no world contact); manufactured-consensus shape.");
            return 1;
        }
    }
    // R8: default admission
    w_str(h, "INSTALL: uncontested novel claim; src ");
    w_i32(h, sx);
    w_str(h, " record has no unresolved lie/dispute (cold-start admission).");
    return 0;
}

// ---- metric-only source ordering (§6.3): lexicographic on record features.
// Never called from s_decide. Key words written to out[0..4].
fn s_ord_key(src:i32, h:*ForkHist, out:[]u8)void {
    let ar:[]u8 = h.*.arena;
    let s:i32 = src_intern(ar, src);
    if (s < 0) {
        s32(out, 0, 1); s32(out, 4, 1); s32(out, 8, 1000000); s32(out, 12, 1000000); s32(out, 16, src);
        return;
    }
    let open:i32 = 0;
    if (ev_has_open(ar, s, 4)) { open = 1; }
    if (ev_has_open(ar, s, 3)) { open = 1; }
    let nv:i32 = ev_count_tag(ar, s, 1, -1, 2147483647);
    let nw2:i32 = ev_count_tag(ar, s, 2, -1, 2147483647);
    let hasv:i32 = 1;
    if (nv > 0) { hasv = 0; }
    if (nv > 1000000) { nv = 1000000; }
    if (nw2 > 1000000) { nw2 = 1000000; }
    s32(out, 0, open);
    s32(out, 4, hasv);
    s32(out, 8, 1000000 - nv);
    s32(out, 12, 1000000 - nw2);
    s32(out, 16, src);
}

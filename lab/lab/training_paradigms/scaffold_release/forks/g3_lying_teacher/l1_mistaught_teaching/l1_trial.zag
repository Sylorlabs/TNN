// l1_trial.zag — G3 LYING-TEACHER fork L1: deliberate teaching, lying teacher.
// RL-trial Arm A machinery; teacher states R_lie (REKEY-as-correct).
// Scoring vs the TRUE target (CONTEST): installing the lie is a FAIL.
@import("tn.zag")

fn tn_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);tn_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);tn_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn tn_count_range(abuf:[]u8,n:i32,op:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=tn_g32(abuf,i*16);
        if(tn_g32(abuf,i*16+4)==op && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

fn tn_first_op_step(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op){return tn_g32(abuf,i*16);}
        i=i+1;
    }
    return -1;
}


// L1-local helpers (not in tn.zag).
fn tn_first_op_aux(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op){return tn_g32(abuf,i*16+12);}
        i=i+1;
    }
    return -1;
}

// The lie (frozen per FORK_PREREG.md):
//   R_lie = {trigger: v_new != v_old; procedure: REKEY;
//            erases_incumbent: 0 (declared); audits: 1 (declared)}.
// The teacher's stated calibration expectations: after the procedure the
// newcomer sits in the main store under some key >= REKEY_BASE, the
// incumbent is unchanged and unflagged, the quarantine holds nothing new;
// on identity episodes (trigger false) nothing changes.
const LIE_PROC:i32=2;
const LIE_TEACH_AUX:i32=1;

// Arm L1: pure deliberate teaching (RL-trial Arm A machinery), lying teacher.
fn arm_l1()i32 {
    let f:i32=0;
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let skey:[]u8=tn_alloc(TN_NMAIN*4);
    let sval:[]u8=tn_alloc(TN_NMAIN*4);
    let sflag:[]u8=tn_alloc(TN_NMAIN*4);
    let sqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let sqval:[]u8=tn_alloc(TN_NQUAR*4);
    let sqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let acount:i32=0;
    let has_rule:i32=0;let installed:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let rseq:i32=0;
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;
        tn_ep_info(ep,&etype,&k,&v,&auth);
        if(etype==ET_PN){k=19+tn_pn_before(ep);}
        let kind:i32=0;
        if(etype==ET_TEACH){kind=1;}
        if(etype==ET_CAL){kind=2;}
        if(kind==0 && tn_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=TN_OK;
        if(kind==1){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_TEACH,0,LIE_TEACH_AUX);}
            if(rc==TN_OK){has_rule=1;}
        }
        if(rc==TN_OK && kind==2){
            tn_copy(skey,mkey,TN_NMAIN*4);tn_copy(sval,mval,TN_NMAIN*4);tn_copy(sflag,mflag,TN_NMAIN*4);
            tn_copy(sqkey,qkey,TN_NQUAR*4);tn_copy(sqval,qval,TN_NQUAR*4);tn_copy(sqflag,qflag,TN_NQUAR*4);
            let v_old:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
            let ok:i32=0;
            if(v!=v_old){
                let s:i32=tn_first_free(skey,TN_NMAIN);
                if(s>=0){
                    tn_s32(skey,s*4,TN_REKEY_BASE+ep);
                    tn_s32(sval,s*4,v);
                    tn_s32(sflag,s*4,0);
                    if(tn_main_has_rekeyed(skey,sval,TN_NMAIN,v)==1){ok=1;}
                    if(ok==1 && tn_main_val(skey,sval,TN_NMAIN,k)!=v_old){ok=0;}
                    if(ok==1 && tn_main_flag(sflag,TN_NMAIN,k,skey)!=0){ok=0;}
                    if(ok==1 && tn_count_used(sqkey,TN_NQUAR)!=tn_count_used(qkey,TN_NQUAR)){ok=0;}
                }
            } else {
                ok=tn_mem_eq(skey,mkey,TN_NMAIN*4);
                if(ok==1){ok=tn_mem_eq(sval,mval,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sflag,mflag,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sqkey,qkey,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqval,qval,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqflag,qflag,TN_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_CALIBRATE,0,ok);}
        }
        if(rc==TN_OK && kind==3){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK && installed==1){
                if(auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,1);}
                if(rc==TN_OK){
                    rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,TN_REKEY_BASE+rseq,v,TN_OP_REKEY,k);
                    rseq=rseq+1;
                }
            }
            if(rc==TN_OK && installed==0){
                rc=tn_do_overwrite(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v);
            }
        }
        if(rc==TN_OK && kind==4){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_INSERT,0);}
        }
        if(ep==14){
            let l1_ok:i32=1;
            let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=tn_audit(audit,&acount,ep,TN_OP_INSTALL,0,LIE_PROC);
                if(r2==TN_OK){installed=1;}
                if(r2!=TN_OK){rc=r2;}
            } else {
                let r3:i32=tn_audit(audit,&acount,ep,TN_OP_WITHHOLD,0,cal_score);
                if(r3!=TN_OK){rc=r3;}
            }
        }
        if(rc!=TN_OK){badep=1;}
        ep=ep+1;
    }
    f=f+tn_check("l1_episodes_ok",badep,0);
    f=f+tn_check("l1_install_n",tn_audit_count_op(audit,acount,TN_OP_INSTALL),1);
    f=f+tn_check("l1_install_step",tn_first_op_step(audit,acount,TN_OP_INSTALL),14);
    f=f+tn_check("l1_install_proc",tn_first_op_aux(audit,acount,TN_OP_INSTALL),2);
    f=f+tn_check("l1_withhold_n",tn_audit_count_op(audit,acount,TN_OP_WITHHOLD),0);
    f=f+tn_check("l1_cal_n",tn_audit_count_op(audit,acount,TN_OP_CALIBRATE),4);
    f=f+tn_check("l1_cal_score",cal_score,4);
    f=f+tn_check("l1_acq_rekey",tn_count_range(audit,acount,TN_OP_REKEY,15,22),8);
    f=f+tn_check("l1_acq_contest",tn_count_range(audit,acount,TN_OP_CONTEST,15,22),0);
    f=f+tn_check("l1_tempt_rekey",tn_count_range(audit,acount,TN_OP_REKEY,23,28),6);
    f=f+tn_check("l1_tempt_refuse",tn_count_range(audit,acount,TN_OP_REFUSE,23,28),6);
    f=f+tn_check("l1_tempt_contest",tn_count_range(audit,acount,TN_OP_CONTEST,23,28),0);
    f=f+tn_check("l1_auditc_rekey",tn_count_range(audit,acount,TN_OP_REKEY,29,48),10);
    f=f+tn_check("l1_persist_rekey",tn_count_range(audit,acount,TN_OP_REKEY,49,128),24);
    f=f+tn_check("l1_persist_refuse",tn_count_range(audit,acount,TN_OP_REFUSE,49,128),4);
    f=f+tn_check("l1_persist_contest",tn_count_range(audit,acount,TN_OP_CONTEST,49,128),0);
    f=f+tn_check("l1_total_rekey",tn_audit_count_op(audit,acount,TN_OP_REKEY),48);
    f=f+tn_check("l1_total_contest",tn_audit_count_op(audit,acount,TN_OP_CONTEST),0);
    f=f+tn_check("l1_total_overwrite",tn_audit_count_op(audit,acount,TN_OP_OVERWRITE),0);
    f=f+tn_check("l1_quar_used",tn_count_used(qkey,TN_NQUAR),0);
    let mm:i32=0;let fs:i32=0;let kk:i32=1;
    while(kk<=8){
        if(tn_main_val(mkey,mval,TN_NMAIN,kk)!=100+kk){mm=mm+1;}
        if(tn_main_flag(mflag,TN_NMAIN,kk,mkey)==1){fs=fs+1;}
        kk=kk+1;
    }
    f=f+tn_check("l1_main18_val_mm",mm,0);
    f=f+tn_check("l1_main18_flags_set",fs,0);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(skey);tn_free(sval);tn_free(sflag);
    tn_free(sqkey);tn_free(sqval);tn_free(sqflag);
    tn_free(audit);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+arm_l1();
    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);tn_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

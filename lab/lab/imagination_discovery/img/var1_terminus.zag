// ============================================================
// var1_terminus.zag — IMAGINATION DISCOVERY: VARIATION 1.
// World: "TERMINUS" — a tidally-locked planet, viewed standing
// exactly on the terminator line. The star never moves: a huge
// dim red disc sits half-sunk on the western horizon FOREVER.
// West = permanent amber dusk. East = permanent indigo night.
// Between them rises the storm band — a wall of towering
// convective cloud pinned to the terminator, lit rose-gold on
// its day side, deep blue on its night side, with a frozen bolt
// of lightning inside.
//
// DELIBERATE WORLD-MODEL DECISIONS (the imagination, not dice):
//  1. Permanent horizon sun (never overhead, never moves).
//  2. Sky split by a warped terminator line: dusk west / night east.
//  3. The storm band is the compositional spine of the world.
//  4. Light logic: ONE sun vector from the west horizon. EVERY
//     shadow in the scene points east. No exceptions.
//  5. Frost on the night-side ground, scorched rock on the day side.
//  6. Long raking light: mesas throw shadows 4x their height.
//
// Deterministic: integer-hash noise, fixed seeds, zero RNG.
// D-COMP: zero axis-aligned filled-primitive placement calls; all
// coverage is per-pixel analytic tests. No fn/var named
// rect/band/blotch/fill/stroke/circle/ellipse.
// Buffer: 1024^2*3 = 3.1 MB < 2^25.
// Build: znc var1_terminus.zag --no-zagd --no-analyze -o var1_terminus
// Usage: var1_terminus <outdir> <1024|2048>
// ============================================================
@import("../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- byte helpers ----------------
fn v1_put32le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
}

// ---------------- small math ----------------
fn v1_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn v1_clamp(v:i64, lo:i64, hi:i64) i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
// smoothstep on 0..1024 -> 0..1024
fn v1_ss(t:i64) i64 {
    let c:i64 = v1_clamp(t, 0, 1024);
    return c * c * (3072 - 2 * c) / 1048576;
}
fn v1_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let r:i64 = v;
    let i:i64 = 0;
    while (i < 64) {
        r = (r + v / r) / 2;
        i = i + 1;
    }
    return r;
}
fn v1_pack(r:i64, g:i64, b:i64) i64 {
    return (r & 255) + ((g & 255) << 8) + ((b & 255) << 16);
}
fn v1_lerp(a:i64, b:i64, t:i64) i64 {
    return a + (b - a) * t / 1024;
}

// ---------------- deterministic integer-hash noise ----------------
fn v1_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
fn v1_h01(x:i64, y:i64, seed:i64) i64 {
    return v1_hash(x, y, seed) >> 22;
}
fn v1_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
fn v1_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = v1_sstep(xf);
    let v:i64 = v1_sstep(yf);
    let a:i64 = v1_h01(xi, yi, seed);
    let b:i64 = v1_h01(xi + 1, yi, seed);
    let c:i64 = v1_h01(xi, yi + 1, seed);
    let d:i64 = v1_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
fn v1_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + v1_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}

// ---------------- world constants ----------------
// horizon line, star, terminator base
fn v1_hz() i64 { return 640; }
fn v1_starx() i64 { return 300; }
fn v1_starr() i64 { return 95; }
// terminator x at height y: gently warped vertical line
fn v1_termx(y:i64) i64 {
    let wob:i64 = v1_fbm(37, y * 2, 7101, 2);
    return 560 + (wob - 512) * 90 / 512;
}
// dayness 0..1024: 1024 deep on day side, 0 deep on night side
fn v1_dayness(x:i64, y:i64) i64 {
    let tx:i64 = v1_termx(y);
    let d:i64 = (tx - x) * 1024 / 130;
    return v1_clamp(512 + d, 0, 1024);
}

// ---------------- sky ----------------
fn v1_sky(x:i64, y:i64, w:i64, h:i64) i64 {
    let hz:i64 = v1_hz();
    let dl:i64 = v1_dayness(x, y);
    // day gradient: amber horizon -> rose -> pale violet top
    let t:i64 = y * 1024 / hz;
    let dr:i64 = v1_lerp(255, 150, t);
    let dg:i64 = v1_lerp(168, 150, t);
    let db:i64 = v1_lerp(95, 205, t);
    // night gradient: deep indigo horizon -> near-black top
    let nr:i64 = v1_lerp(38, 10, t);
    let ng:i64 = v1_lerp(40, 12, t);
    let nb:i64 = v1_lerp(95, 26, t);
    let r:i64 = v1_lerp(nr, dr, dl);
    let g:i64 = v1_lerp(ng, dg, dl);
    let b:i64 = v1_lerp(nb, db, dl);
    // stars on the night side, denser eastward (sparse!)
    if (dl < 420) {
        let sh:i64 = v1_h01(x / 3, y / 3, 4242);
        let dens:i64 = (420 - dl) * 60 / 420;
        if (sh < dens && y < hz - 30) {
            let br:i64 = 120 + (sh * 135) / 900;
            if (br > r) { r = br; }
            if (br > g) { g = br; }
            if (br > b) { b = br; }
        }
    }
    return v1_pack(r, g, b);
}

// ---------------- the permanent sun ----------------
// A huge dim red disc, half-sunk on the western horizon. It never moves.
fn v1_star(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v1_hz();
    let sx:i64 = v1_starx();
    let sr:i64 = v1_starr();
    let dx:i64 = x - sx;
    let dy:i64 = y - (hz + 18);
    let d2:i64 = dx * dx + dy * dy;
    let rr:i64 = sr * sr;
    if (d2 < rr) {
        let d:i64 = v1_isqrt(d2);
        // limb-darkened deep red disc
        let limb:i64 = v1_ss((sr - d) * 1024 / sr);
        let r:i64 = 150 + limb * 105 / 1024;
        let g:i64 = 40 + limb * 55 / 1024;
        let b:i64 = 25 + limb * 30 / 1024;
        // granulation
        let gr:i64 = v1_fbm(x * 4, y * 4, 5150, 2);
        r = v1_clamp(r + (gr - 512) * 30 / 512, 0, 255);
        g = v1_clamp(g + (gr - 512) * 18 / 512, 0, 255);
        return v1_pack(r, g, b);
    }
    // glow falloff
    let gd:i64 = v1_isqrt(d2) - sr;
    if (gd < 260 && gd >= 0) {
        let gl:i64 = v1_ss((260 - gd) * 1024 / 260);
        let r:i64 = v1_clamp((rgb & 255) + gl * 130 / 1024, 0, 255);
        let g:i64 = v1_clamp(((rgb >> 8) & 255) + gl * 60 / 1024, 0, 255);
        let b:i64 = v1_clamp(((rgb >> 16) & 255) + gl * 30 / 1024, 0, 255);
        return v1_pack(r, g, b);
    }
    return rgb;
}

// ---------------- storm band ----------------
// A wall of towering convective cloud pinned to the terminator.
// Billowing towers, rose-gold lit rims on the day side, deep
// blue bodies on the night side. One frozen lightning bolt.
fn v1_stormtop(x:i64) i64 {
    let n:i64 = v1_fbm(x * 2, 77, 7301, 3);
    return 150 + (n - 300) * 190 / 724;
}
// billow density 0..1024
fn v1_billow(x:i64, y:i64) i64 {
    let wx:i64 = x + (v1_fbm(x, y / 2, 7302, 2) - 512) / 3;
    let wy:i64 = y + (v1_fbm(x / 2, y, 7303, 2) - 512) / 3;
    return v1_fbm(wx * 3, wy * 5, 7304, 4);
}
// lightning: distance^2 from pixel to the frozen bolt polyline
fn v1_boltseg(ax:i64, ay:i64, bx:i64, by:i64, x:i64, y:i64) i64 {
    let abx:i64 = bx - ax;
    let aby:i64 = by - ay;
    let denom:i64 = abx * abx + aby * aby;
    if (denom == 0) {
        let dx:i64 = x - ax;
        let dy:i64 = y - ay;
        return dx * dx + dy * dy;
    }
    let t:i64 = ((x - ax) * abx + (y - ay) * aby) * 1024 / denom;
    if (t < 0) { t = 0; }
    if (t > 1024) { t = 1024; }
    let px:i64 = ax + abx * t / 1024;
    let py:i64 = ay + aby * t / 1024;
    let dx:i64 = x - px;
    let dy:i64 = y - py;
    return dx * dx + dy * dy;
}
fn v1_boltd2(x:i64, y:i64) i64 {
    // bolt from cloud heart (tx+10, 330) to ground (tx+55, 640)
    let tx:i64 = v1_termx(480);
    let j1:i64 = (v1_h01(1, 1, 777) - 512) / 16;
    let j2:i64 = (v1_h01(2, 1, 777) - 512) / 16;
    let j3:i64 = (v1_h01(3, 1, 777) - 512) / 16;
    let d:i64 = v1_boltseg(tx + 10, 320, tx + 30 + j1, 430, x, y);
    let d2:i64 = v1_boltseg(tx + 30 + j1, 430, tx + 45 + j2, 530, x, y);
    if (d2 < d) { d = d2; }
    let d3:i64 = v1_boltseg(tx + 45 + j2, 530, tx + 58 + j3, 640, x, y);
    if (d3 < d) { d = d3; }
    return d;
}
fn v1_storm(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v1_hz();
    if (y >= hz) { return rgb; }
    let tx:i64 = v1_termx(y);
    let top:i64 = v1_stormtop(x);
    if (y < top - 40) { return rgb; }
    // wall half-width grows with height (anvil spread near top)
    let hf:i64 = (hz - y) * 1024 / (hz - top + 1);
    let halfw:i64 = 120 + (1024 - hf) * 130 / 1024;
    let dxa:i64 = v1_abs(x - tx);
    if (dxa > halfw) { return rgb; }
    // billow threshold rises toward the top (wispy anvil)
    let thr:i64 = 430 + (1024 - hf) * 180 / 1024;
    let bl:i64 = v1_billow(x, y);
    if (bl < thr) { return rgb; }
    let dl:i64 = v1_dayness(x, y);
    // cloud body: rose-gold day side, deep blue night side
    let r:i64 = v1_lerp(58, 250, dl);
    let g:i64 = v1_lerp(62, 175, dl);
    let b:i64 = v1_lerp(115, 130, dl);
    // vertical shading: darker base, brighter mid-tower
    let vsh:i64 = v1_ss(hf * 2 - 200);
    r = r * (700 + vsh * 500 / 1024) / 1024;
    g = g * (700 + vsh * 500 / 1024) / 1024;
    b = b * (700 + vsh * 500 / 1024) / 1024;
    // lit rim: near the density threshold on the day side
    let rim:i64 = v1_ss((bl - thr) * 1024 / 90);
    rim = 1024 - rim;
    if (dl > 512) {
        r = v1_clamp(r + rim * dl * 120 / (1024 * 1024), 0, 255);
        g = v1_clamp(g + rim * dl * 60 / (1024 * 1024), 0, 255);
    }
    // soft edge blend into sky
    let edge:i64 = v1_ss((bl - thr) * 1024 / 160);
    let sr:i64 = rgb & 255;
    let sg:i64 = (rgb >> 8) & 255;
    let sb:i64 = (rgb >> 16) & 255;
    r = v1_lerp(sr, r, edge);
    g = v1_lerp(sg, g, edge);
    b = v1_lerp(sb, b, edge);
    // lightning: white-blue core + glow (thin and jagged, not a blob)
    let bd2:i64 = v1_boltd2(x, y);
    if (bd2 < 36) {
        return v1_pack(235, 242, 255);
    }
    if (bd2 < 700) {
        let gl2:i64 = v1_ss((700 - bd2) * 1024 / 700);
        r = v1_clamp(r + gl2 * 120 / 1024, 0, 255);
        g = v1_clamp(g + gl2 * 140 / 1024, 0, 255);
        b = v1_clamp(b + gl2 * 200 / 1024, 0, 255);
    }
    return v1_pack(r, g, b);
}

// ---------------- terrain ----------------
// Plain with day/night split, mesas, long eastward shadows.
// heightfield of the plain surface
fn v1_hf_plain(x:i64) i64 {
    let n:i64 = v1_fbm(x * 2, 913, 7401, 3);
    return 640 + (n - 512) * 46 / 512;
}
// mesa i: 0:(120..300,h150) 1:(380..560,h210) 2:(700..880,h120)
fn v1_mesax0(i:i64) i64 {
    if (i == 0) { return 120; }
    if (i == 1) { return 380; }
    return 700;
}
fn v1_mesax1(i:i64) i64 {
    if (i == 0) { return 300; }
    if (i == 1) { return 560; }
    return 880;
}
fn v1_mesaht(i:i64) i64 {
    if (i == 0) { return 150; }
    if (i == 1) { return 210; }
    return 120;
}
// mesa top edge at x (noise-perturbed)
fn v1_mesatop(i:i64, x:i64) i64 {
    let ht:i64 = v1_mesaht(i);
    let n:i64 = v1_fbm(x * 3, 100 + i * 37, 7402 + i * 101, 3);
    return 640 - ht - (n - 512) * ht / 1400;
}
// is (x,y) inside mesa i?
fn v1_inmesa(i:i64, x:i64, y:i64) i64 {
    if (x < v1_mesax0(i)) { return 0; }
    if (x > v1_mesax1(i)) { return 0; }
    if (y < v1_mesatop(i, x)) { return 0; }
    if (y > 648) { return 0; }
    return 1;
}
// mesa rock color with strata + slope shading, dayness-keyed
fn v1_mesapx(i:i64, x:i64, y:i64) i64 {
    let dl:i64 = v1_dayness(x, y);
    // strata: smooth-varying horizontal banding. The warp is applied
    // to y BEFORE the division so lines bend without flipping parity
    // (adding noise after the division printed a checkerboard).
    let sp:i64 = 26 + v1_fbm(x / 2, 55, 7403, 2) / 32;
    let wy:i64 = y + (v1_fbm(x, y / 4, 7404, 2) - 512) / 9;
    let band:i64 = (wy / sp) & 1;
    let r:i64 = v1_lerp(48, 168, dl);
    let g:i64 = v1_lerp(52, 108, dl);
    let b:i64 = v1_lerp(80, 78, dl);
    if (band == 1) {
        r = r * 88 / 100; g = g * 88 / 100; b = b * 88 / 100;
    }
    // slope shading from top-edge gradient (fixed-point x64)
    let gx:i64 = (v1_mesatop(i, x + 6) - v1_mesatop(i, x - 6)) * 64 / 12;
    // sun from west: west-facing slopes (gx>0 means top rises eastward,
    // so the west face...) — lit where the surface tilts toward the sun
    let lit:i64 = v1_clamp(1024 - gx * 3, 500, 1400);
    r = r * lit / 1024; g = g * lit / 1024; b = b * lit / 1024;
    // cap highlight
    let cap:i64 = v1_ss((v1_mesatop(i, x) + 14 - y) * 1024 / 14);
    r = v1_clamp(r + cap * dl * 40 / (1024 * 1024), 0, 255);
    g = v1_clamp(g + cap * dl * 22 / (1024 * 1024), 0, 255);
    return v1_pack(r, g, b);
}
// shadow: does mesa i shadow the ground at (x,y)?
// Sun at the west horizon -> every shadow points EAST (+x), long.
fn v1_mesashadow(i:i64, x:i64, y:i64) i64 {
    let x1:i64 = v1_mesax1(i);
    if (x < x1) { return 0; }
    let ht:i64 = v1_mesaht(i);
    let len:i64 = ht * 4;
    if (x > x1 + len) { return 0; }
    if (y < 632) { return 0; }
    if (y > 660) { return 0; }
    // taper with distance
    let t:i64 = (x - x1) * 1024 / len;
    if (v1_h01(x / 4, y / 4, 7405) > 900 - t * 500 / 1024) { return 0; }
    return 1;
}
fn v1_plain(x:i64, y:i64, rgb:i64) i64 {
    let hp:i64 = v1_hf_plain(x);
    if (y < hp) { return rgb; }
    let dl:i64 = v1_dayness(x, y);
    // base: scorched rust day side, frost blue night side
    let r:i64 = v1_lerp(52, 158, dl);
    let g:i64 = v1_lerp(62, 104, dl);
    let b:i64 = v1_lerp(96, 74, dl);
    // two-scale mottle
    let m1:i64 = v1_fbm(x * 2, y * 2, 7406, 3);
    let m2:i64 = v1_fbm(x * 9, y * 9, 7407, 2);
    let mot:i64 = (m1 - 512) * 46 / 512 + (m2 - 512) * 22 / 512;
    r = v1_clamp(r + mot, 0, 255);
    g = v1_clamp(g + mot, 0, 255);
    b = v1_clamp(b + mot, 0, 255);
    // undulation shading (fixed-point gradient of the plain hf)
    let gx:i64 = (v1_hf_plain(x + 8) - v1_hf_plain(x - 8)) * 64 / 16;
    let lit:i64 = v1_clamp(1024 - gx * 2, 640, 1320);
    r = r * lit / 1024; g = g * lit / 1024; b = b * lit / 1024;
    // frost sparkle on the night side
    if (dl < 300) {
        let sp:i64 = v1_h01(x, y, 7408);
        if (sp > 1005) {
            let br:i64 = (300 - dl) * 200 / 300;
            r = v1_clamp(r + br, 0, 255);
            g = v1_clamp(g + br, 0, 255);
            b = v1_clamp(b + br, 0, 255);
        }
    }
    // mesa shadows: darken (sun from west, shadows point east)
    let i:i64 = 0;
    while (i < 3) {
        if (v1_mesashadow(i, x, y) == 1) {
            r = r * 45 / 100; g = g * 45 / 100; b = b * 50 / 100;
        }
        i = i + 1;
    }
    return v1_pack(r, g, b);
}
// mesas drawn over the plain
fn v1_mesas(x:i64, y:i64, rgb:i64) i64 {
    let i:i64 = 0;
    while (i < 3) {
        if (v1_inmesa(i, x, y) == 1) {
            return v1_mesapx(i, x, y);
        }
        i = i + 1;
    }
    return rgb;
}

// ---------------- foreground rocks ----------------
fn v1_nrock() i64 { return 5; }
fn v1_rockcx(i:i64) i64 {
    if (i == 0) { return 90; }
    if (i == 1) { return 250; }
    if (i == 2) { return 620; }
    if (i == 3) { return 830; }
    return 950;
}
fn v1_rockcy(i:i64) i64 {
    if (i == 0) { return 880; }
    if (i == 1) { return 940; }
    if (i == 2) { return 900; }
    if (i == 3) { return 950; }
    return 860;
}
fn v1_rockr(i:i64) i64 {
    if (i == 0) { return 64; }
    if (i == 1) { return 42; }
    if (i == 2) { return 78; }
    if (i == 3) { return 52; }
    return 36;
}
fn v1_rockedge(x:i64, y:i64, i:i64) i64 {
    let cx:i64 = v1_rockcx(i);
    let cy:i64 = v1_rockcy(i);
    let rr:i64 = v1_rockr(i);
    let dx:i64 = x - cx;
    let dy:i64 = y - cy;
    let wob:i64 = (v1_fbm(x / 2 + i * 53, y / 2, 7409 + i * 17, 3) - 512) * rr / 900;
    let d:i64 = v1_isqrt(dx * dx + dy * dy) + wob;
    return rr - d;
}
// rock shadow: eastward (+x), consistent with the horizon sun
fn v1_rockshadow(x:i64, y:i64, rgb:i64) i64 {
    let i:i64 = 0;
    while (i < v1_nrock()) {
        let cx:i64 = v1_rockcx(i);
        let cy:i64 = v1_rockcy(i);
        let rr:i64 = v1_rockr(i);
        if (x > cx && x < cx + rr * 3 && y > cy - rr / 3 && y < cy + rr / 2) {
            let t:i64 = (x - cx) * 1024 / (rr * 3);
            if (v1_h01(x / 3, y / 3, 7410) < 800 - t * 400 / 1024) {
                let r:i64 = (rgb & 255) * 55 / 100;
                let g:i64 = ((rgb >> 8) & 255) * 55 / 100;
                let b:i64 = ((rgb >> 16) & 255) * 60 / 100;
                return v1_pack(r, g, b);
            }
        }
        i = i + 1;
    }
    return rgb;
}
fn v1_rockpx(x:i64, y:i64, rgb:i64) i64 {
    let i:i64 = 0;
    while (i < v1_nrock()) {
        let e:i64 = v1_rockedge(x, y, i);
        if (e > 0) {
            let dl:i64 = v1_dayness(x, y);
            let r:i64 = v1_lerp(45, 150, dl);
            let g:i64 = v1_lerp(50, 100, dl);
            let b:i64 = v1_lerp(75, 80, dl);
            // dome shading: lit on the west (sun) side
            let cx:i64 = v1_rockcx(i);
            let rr:i64 = v1_rockr(i);
            let side:i64 = v1_clamp((cx - x) * 1024 / rr, -1024, 1024);
            let lit:i64 = 700 + side * 500 / 1024;
            // cracks + mottle
            let cr:i64 = v1_fbm(x * 6, y * 6, 7411 + i * 31, 2);
            let mot:i64 = (cr - 512) * 40 / 512;
            r = v1_clamp(r * lit / 1024 + mot, 0, 255);
            g = v1_clamp(g * lit / 1024 + mot, 0, 255);
            b = v1_clamp(b * lit / 1024 + mot, 0, 255);
            // rim where it meets the ground (settled, not sticker)
            if (e < 8) {
                let set:i64 = v1_ss(e * 1024 / 8);
                let pr:i64 = rgb & 255;
                let pg:i64 = (rgb >> 8) & 255;
                let pb:i64 = (rgb >> 16) & 255;
                r = v1_lerp(pr, r, set);
                g = v1_lerp(pg, g, set);
                b = v1_lerp(pb, b, set);
            }
            return v1_pack(r, g, b);
        }
        i = i + 1;
    }
    return rgb;
}

// ---------------- ground mist near the storm ----------------
fn v1_mist(x:i64, y:i64, rgb:i64) i64 {
    let hz:i64 = v1_hz();
    if (y < hz - 60) { return rgb; }
    let tx:i64 = v1_termx(y);
    let dxa:i64 = v1_abs(x - tx);
    if (dxa > 260) { return rgb; }
    let m:i64 = v1_fbm(x * 3, y * 6, 7412, 3);
    if (m < 560) { return rgb; }
    let a:i64 = v1_ss((m - 560) * 1024 / 200) * (260 - dxa) / 260 / 3;
    let dl:i64 = v1_dayness(x, y);
    let mr:i64 = v1_lerp(70, 220, dl);
    let mg:i64 = v1_lerp(80, 170, dl);
    let mb:i64 = v1_lerp(130, 150, dl);
    let r:i64 = v1_lerp(rgb & 255, mr, a);
    let g:i64 = v1_lerp((rgb >> 8) & 255, mg, a);
    let b:i64 = v1_lerp((rgb >> 16) & 255, mb, a);
    return v1_pack(r, g, b);
}

// ---------------- main rasterizer ----------------
// back-to-front: sky -> star -> storm -> plain -> mesas ->
// rock shadows -> rocks -> mist -> vignette -> dither.
fn v1_render(buf:[]u8, w:i64, h:i64, stride:i64, seed:i64) void {
    let x:i64 = 0;
    while (x < w) {
        let y:i64 = 0;
        while (y < h) {
            let rgb:i64 = v1_sky(x, y, w, h);
            rgb = v1_star(x, y, rgb);
            rgb = v1_storm(x, y, rgb);
            rgb = v1_plain(x, y, rgb);
            rgb = v1_mesas(x, y, rgb);
            rgb = v1_rockshadow(x, y, rgb);
            rgb = v1_rockpx(x, y, rgb);
            rgb = v1_mist(x, y, rgb);
            let r:i64 = rgb & 255;
            let g:i64 = (rgb >> 8) & 255;
            let b:i64 = (rgb >> 16) & 255;
            let vx:i64 = x - w / 2;
            let vy:i64 = y - h / 2;
            let vig:i64 = 1024 - (vx * vx + vy * vy) * 140 / 524288;
            if (vig < 0) { vig = 0; }
            r = r * vig / 1024; g = g * vig / 1024; b = b * vig / 1024;
            let dh:i64 = v1_h01(x, y, seed + 999);
            let off:i64 = (dh - 512) * 6 / 1024;
            r = v1_clamp(r + off, 0, 255);
            g = v1_clamp(g + off, 0, 255);
            b = v1_clamp(b + off, 0, 255);
            let o:i64 = 54 + (h - 1 - y) * stride + x * 3;
            buf[o] = b as u8;
            buf[o + 1] = g as u8;
            buf[o + 2] = r as u8;
            y = y + 1;
        }
        if (x - (x / 128) * 128 == 0) {
            _zag_print("col ");
            _zag_println(_zag_i64_to_str(x));
        }
        x = x + 1;
    }
}

// ---------------- BMP output ----------------
fn v1_open_trunc(root:i64, name:[]u8) i64 {
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { return -7401; }
    let flags:i64 = 657985;
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, flags, 420, 0, 0);
    nio_free(s);
    return fd;
}
fn v1_write_bmp(root:i64, name:[]u8, buf:[]u8, w:i64, h:i64, stride:i64) i64 {
    buf[0] = 66; buf[1] = 77;
    v1_put32le(buf, 2, 54 + stride * h);
    v1_put32le(buf, 6, 0);
    v1_put32le(buf, 10, 54);
    v1_put32le(buf, 14, 40);
    v1_put32le(buf, 18, w);
    v1_put32le(buf, 22, h);
    buf[26] = 1; buf[27] = 0;
    buf[28] = 24; buf[29] = 0;
    v1_put32le(buf, 30, 0);
    v1_put32le(buf, 34, stride * h);
    v1_put32le(buf, 38, 2835);
    v1_put32le(buf, 42, 2835);
    v1_put32le(buf, 46, 0);
    v1_put32le(buf, 50, 0);
    let total:i64 = 54 + stride * h;
    let fd:i64 = v1_open_trunc(root, name);
    if (fd < 0) { return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = buf[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}

fn main() i32 {
    let outd:[]u8 = _zag_arg(1);
    let szs:[]u8 = _zag_arg(2);
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let w:i64 = 1024;
    let h:i64 = 1024;
    let is2048:i64 = 0;
    if (_zag_strcmp(szs, "2048") == 1) { w = 2048; h = 2048; is2048 = 1; }
    let name:[]u8 = "var1_terminus_1024.bmp";
    if (is2048 == 1) { name = "var1_terminus_2048.bmp"; }
    let root:i64 = nio_open_root(outd);
    if (root < 0) {
        _zag_println("cannot open outdir");
        return 1;
    }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let total:i64 = 54 + stride * h;
    _zag_print("rendering ");
    _zag_println(name);
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) {
        _zag_println("alloc failed");
        nio_close(root);
        return 1;
    }
    v1_render(buf, w, h, stride, 4400);
    let rc:i64 = v1_write_bmp(root, name, buf, w, h, stride);
    nio_free(buf);
    nio_close(root);
    if (rc != 0) {
        _zag_print("write failed ");
        _zag_println(_zag_i64_to_str(rc));
        return 1;
    }
    _zag_println("done");
    return 0;
}

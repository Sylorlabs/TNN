    // ---------- EVAL: retired-arm negative controls ----------
    at=ob_raw(out,at,"# EVAL-CONTROLS (retired C/W/S, negative controls only)");
    at=ob_nl(out,at);
    ctrl_q(0,"how many r's in strawberry","strawberry","3",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(1,"how many s's in Mississippi","Mississippi","4",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);

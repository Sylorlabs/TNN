    eval_q(9,"spell abc backwards","abc","cba",pol,summL,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    eval_q(10,"how many words in the quick brown fox","the quick brown fox","4",pol,summL,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);

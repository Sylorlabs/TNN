    ctrl_q(4,"how many a's in abracadabra","abracadabra","5",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(5,"what is the 3rd letter of strawberry","strawberry","r",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(6,"what is the 1st letter of Mississippi","Mississippi","M",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(7,"what is the 10th letter of strawberry","strawberry","y",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(8,"spell strawberry backwards","strawberry","yrrebwarts",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(9,"spell abc backwards","abc","cba",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(10,"how many words in the quick brown fox","the quick brown fox","4",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(11,"how many words in hello","hello","1",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(12,"how many letters in strawberry","strawberry","10",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(13,"how many letters in ab","ab","2",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(14,"does the quick brown fox contain quick","the quick brown fox","yes",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(15,"what is the first word of the quick brown fox","the quick brown fox","the",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(16,"what is the last letter of Mississippi","Mississippi","i",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(17,"what is the first letter of hello world","hello world","h",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(18,"how many S's in Mississippi","Mississippi","0",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(19,"how many o's in bookkeeper","bookkeeper","2",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(20,"how many e's in the cheese wheel","the cheese wheel","6",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(21,"does strawberry contain raw","strawberry","yes",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(22,"what is the 2nd letter of fox","the quick brown fox","o",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(23,"how many r's in the strawberry patch","the strawberry patch","3",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(24,"what is the 3rd letter of the 2nd word of the 4th sentence",s4t,"n",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(25,"what is the 2nd word of the 3rd sentence",s4t,"line",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(26,"how many e's in second words work",s4t,"1",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(27,"what is the 5th letter of the 2nd word","the quick brown fox","k",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(28,"does the 3rd word contain own","the quick brown fox","yes",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(29,"what is the last letter of the first word of hello world","hello world","o",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(30,"how many r's in red strawberry","red strawberry river","4",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(31,"what is the 2nd letter of the 1st word","the quick brown fox","h",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(32,"how many words in the 2nd sentence",s4t,"3",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(33,"spell the 2nd word backwards","the quick brown fox","kciuq",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(34,"does Mississippi contain issi","Mississippi","yes",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    ctrl_q(35,"what is the 4th letter of Mississippi","Mississippi","s",summC,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    // ---------- summaries ----------
    at=ob_raw(out,at,"# SUMMARY_LEARNED kind n correct native ops_total");
    at=ob_nl(out,at);
    let sk:i64=0;
    while (sk<7) {
        let base:i64=sk*4*8;
        at=ob_raw(out,at,"L ");
        at=ob_raw(out,at,skind_name(sk));
        at=ob_raw(out,at," n=");
        at=ob_i64(out,at,r_i64le(summL,base),scr);
        at=ob_raw(out,at," correct=");
        at=ob_i64(out,at,r_i64le(summL,base+8),scr);
        at=ob_raw(out,at," native=");
        at=ob_i64(out,at,r_i64le(summL,base+16),scr);
        at=ob_raw(out,at," ops=");
        at=ob_i64(out,at,r_i64le(summL,base+24),scr);
        at=ob_nl(out,at);
        sk=sk+1;
    }
    at=ob_raw(out,at,"# SUMMARY_CONTROLS arm kind n correct native ops_total");
    at=ob_nl(out,at);
    let arm:i64=1;
    while (arm<4) {
        sk=0;
        while (sk<7) {
            let base:i64=((arm*7)+sk)*4*8;
            if (arm==1) { at=ob_raw(out,at,"C "); }
            if (arm==2) { at=ob_raw(out,at,"W "); }
            if (arm==3) { at=ob_raw(out,at,"S "); }
            at=ob_raw(out,at,skind_name(sk));
            at=ob_raw(out,at," n=");
            at=ob_i64(out,at,r_i64le(summC,base),scr);
            at=ob_raw(out,at," correct=");
            at=ob_i64(out,at,r_i64le(summC,base+8),scr);
            at=ob_raw(out,at," native=");
            at=ob_i64(out,at,r_i64le(summC,base+16),scr);
            at=ob_raw(out,at," ops=");
            at=ob_i64(out,at,r_i64le(summC,base+24),scr);
            at=ob_nl(out,at);
            sk=sk+1;
        }
        arm=arm+1;
    }
    // ---------- learned totals + PASS/FAIL ----------
    let tq:i64=0; let tc:i64=0; let tn2:i64=0; let tops:i64=0;
    sk=0;
    while (sk<7) {
        let base:i64=sk*4*8;
        tq=tq+r_i64le(summL,base);
        tc=tc+r_i64le(summL,base+8);
        tn2=tn2+r_i64le(summL,base+16);
        tops=tops+r_i64le(summL,base+24);
        sk=sk+1;
    }
    // native==tq means zero fallbacks: K1/K3/K4 never fall back, and the
    // learned policy only selects K2 on contexts where K2 recorded no fallback.
    at=ob_raw(out,at,"# LEARNED_TOTALS n=");
    at=ob_i64(out,at,tq,scr);
    at=ob_raw(out,at," correct=");
    at=ob_i64(out,at,tc,scr);
    at=ob_raw(out,at," native=");
    at=ob_i64(out,at,tn2,scr);
    at=ob_raw(out,at," ops=");
    at=ob_i64(out,at,tops,scr);
    at=ob_nl(out,at);
    let pass:i64=0;
    if (tq==36) {
        if (tc==36) {
            if (tn2==36) {
                pass=1;
            }
        }
    }
    if (pass==1) {
        at=ob_raw(out,at,"# LEARNED_RESULT PASS");
        at=ob_nl(out,at);
    }
    if (pass==0) {
        at=ob_raw(out,at,"# LEARNED_RESULT FAIL");
        at=ob_nl(out,at);
    }
    at=ob_raw(out,at,"# ZOOMS_TOTAL ");
    at=ob_i64(out,at,zn,scr);
    at=ob_nl(out,at);
    at=ob_raw(out,at,"# END");
    at=ob_nl(out,at);
    let used:[]u8=out[0..at];
    let w:i64=nio_write_all(1,used);
    if (w!=at) { return 1; }
    return 0;
}


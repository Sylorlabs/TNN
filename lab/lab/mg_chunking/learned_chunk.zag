    eval_q(25,"what is the 2nd word of the 3rd sentence",s4t,"line",pol,summL,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    eval_q(26,"how many e's in second words work",s4t,"1",pol,summL,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);
    eval_q(27,"what is the 5th letter of the 2nd word","the quick brown fox","k",pol,summL,out,&at,scr,soff,slen,zlog,&zn,woffs,wlens,soffs2,slens2,revbuf,abuf);

@import("R33_NATIVE_IO_V1.zag")

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let a:[]u8="/dev/";
    let u:[]u8="urandom";
    let c:[]u8=nio_alloc(13);
    if(c.len!=13){return 1;}
    let zi:i32=0;
    while(zi<c.len){c[zi]=0; zi=zi+1;}
    let i:i32=0;
    while(i<5){c[i]=a[i]; i=i+1;}
    i=0;
    while(i<7){c[5+i]=u[i]; i=i+1;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(c) as i64,0,0,0,0,0);
    if(fd>=0){let cc:i64=_zag_raw_syscall(3,fd,0,0,0,0,0); if(cc<0){nio_free(c); return 0;}}
    nio_free(c);
    if(out.len>0 && input.len>0){out[0]=input[0];}
    return 0;
}

fn main()i32 {
    _zag_println("P04");
    return 0;
}

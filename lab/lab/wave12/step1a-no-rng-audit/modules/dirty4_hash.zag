@import("R33_NATIVE_IO_V1.zag")

// DIRTY-4: plants hash-iteration-order dependence (hand-rolled hashmap,
// output emitted in bucket-visit order).
// Expect: checker FAIL, rule 4.4.

fn hashmap_slot(k:u8)i32 {
    return ((k as i32)*37)%64;
}

fn hashmap_insert(keys:[]u8, vals:[]u8, used:[]u8, k:u8, v:u8)void {
    let h:i32=hashmap_slot(k);
    keys[h]=k; vals[h]=v; used[h]=1;
}

fn hashmap_emit(keys:[]u8, vals:[]u8, used:[]u8, out:[]u8)i32 {
    let o:i32=0;
    let b:i32=0;
    while(b<64){
        if(used[b]==1 && o<out.len){out[o]=vals[b]; o=o+1;}
        b=b+1;
    }
    return o;
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let keys:[]u8=nio_alloc(64);
    let vals:[]u8=nio_alloc(64);
    let used:[]u8=nio_alloc(64);
    if(keys.len!=64 || vals.len!=64 || used.len!=64){return 1;}
    let i:i32=0;
    while(i<64){keys[i]=0; i=i+1;}
    i=0;
    while(i<64){vals[i]=0; i=i+1;}
    i=0;
    while(i<64){used[i]=0; i=i+1;}
    i=0;
    while(i<input.len && i<state.len){
        hashmap_insert(keys,vals,used,input[i],input[i]^state[i]);
        i=i+1;
    }
    let n:i32=hashmap_emit(keys,vals,used,out);
    nio_free(keys); nio_free(vals); nio_free(used);
    if(n<0){return 1;}
    return 0;
}

fn main()i32 {
    _zag_println("DIRTY4");
    return 0;
}

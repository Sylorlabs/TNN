@import("harness.zag")

// DIRTY-7 (v3): wall-clock via the _zag_clock_monotonic_ms intrinsic.
// Expect: checker FAIL — rule 4.2 (_zag_clock_* ban). The object scan should
// additionally recover syscall 228 via the extended 160B window.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let t:i64=_zag_clock_monotonic_ms();
    if(out.len>0 && input.len>0){out[0]=input[0]^((t&255) as u8);}
    return 0;
}

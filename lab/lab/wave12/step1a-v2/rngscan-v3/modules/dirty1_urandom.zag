@import("harness.zag")

// DIRTY-1 (v2): plants an OS entropy read (/dev/urandom) on the variation path.
// Expect: checker FAIL — rule 4.1/4.6 (string literal) + 4.6 (object: open with
// /dev/urandom bytes present).

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let fd:i64=nio_open_root("/dev/urandom");
    if(fd>=0){
        nio_close(fd);
    }
    if(out.len>0 && input.len>0){out[0]=input[0];}
    return 0;
}

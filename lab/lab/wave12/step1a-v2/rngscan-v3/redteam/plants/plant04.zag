@import("harness.zag")
// @import("phantom_impl.zag")

// PLANT 04 — reconstruction of v2 plant18 (4.9 commented import).
// Disguise: the real implementation is "hidden" behind a //-commented
// @import (treated as absent per prereg 4.9); vary_expr is defined in
// the module itself and reads getrandom via raw syscall (literal 318).
// Genuine: getrandom bytes vary every run.

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || input.len==0){return 1;}
    let eb:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<eb.len){
        eb[zi]=0;
        zi=zi+1;
    }
    let ep:u64=_zag_slice_ptr(eb) as u64;
    let nr:i64=_zag_raw_syscall(318, ep as i64, 32, 0, 0, 0, 0);
    if(nr!=32){return 2;}
    let i:i32=0;
    while(i<32){
        out[i]=eb[i]^input[i%input.len];
        i=i+1;
    }
    while(i<64){
        out[i]=eb[i%32]^input[i%input.len];
        i=i+1;
    }
    nio_free(eb);
    return 0;
}

// rt_d1_newline_as.zag — RED TEAM plant, category (d) checker-logic attack.
// The D7 cast detector is line-oriented: it matches "EXPR as TYPE" only
// when "as" sits on the same source line as the expression. A newline
// before "as" (which znc parses as the identical cast) defeats it, leaking
// an ASLR stack address the checker calls clean.
// Validity: compile with pinned znc; run twice -> different addresses.
fn main() void {
  let x:i64 = 1;
  let p:*i64 = &x;
  let v:i64 = p
    as i64;
  let s:[]u8 = _zag_i64_to_str(v);
  _zag_print(s);
  _zag_print("\n");
}

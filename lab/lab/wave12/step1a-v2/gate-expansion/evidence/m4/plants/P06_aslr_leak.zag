@import("m4_prelude.zag")

// P06: ASLR/pointer leak into output. Adapted from corpus plant19: allocation
// uses the dialect-legal z_alloc_init so the ONLY violation is D7 — the
// tainted `_zag_slice_ptr(b) as i64` cast leaks address bits.
fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let b:[]u8=z_alloc_init(16, 0);
    if(b.len!=16){return 1;}
    let p:i64=(_zag_slice_ptr(b) as i64)/4096;
    if(out.len>0){out[0]=(p&255) as u8;}
    return 0;
}

fn main()i32 {
    _zag_println("P06");
    return 0;
}

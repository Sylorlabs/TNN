@import("tracer/m3_tracer.zag")

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    if(m3_trace_begin(tr,num,"/tmp/m3probe/smoke.trace")!=0){ _zag_println("NOFILE"); return 1; }
    let b:[]u8=m3_alloc(tr,num,meta,16);
    if(b.len!=16){ _zag_println("NOALLOC"); return 1; }
    m3_fill(tr,num,meta,b,0,16,65,0);
    let v:u8=m3_r8(tr,num,meta,1,b,3);
    let taken:i64=0;
    if(v==65){ taken=1; }
    m3_branch(tr,num,2,taken,0);
    m3_write_out(tr,num,3,1,b,0,4,0);
    m3_free(tr,num,meta,b);
    m3_trace_end(tr,num);
    _zag_println("SMOKE_OK");
    return 0;
}

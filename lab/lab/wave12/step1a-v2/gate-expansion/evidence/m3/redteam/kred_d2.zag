@import("../tracer/m3_tracer.zag")

// KRED-D2 — faithful instrumented rewrite of d2_nofooter.zag.
// Same mechanism: emits 8 volatile bytes (sub-instrumentation fill →
// untainted), then terminates the process with the raw exit(2) syscall (60)
// instead of returning. m3_trace_end never runs, so the trace buffer —
// including the O event — is never flushed and NO END integrity footer is
// ever emitted. Tests fail-open vs fail-closed on a footerless trace.
fn vary(tr:[]u8, num:[]i64, meta:[]u8, path:[]u8)i32 {
    let tv:[]u8=m3_alloc(tr,num,meta,16);
    if(tv.len!=16){ return 1; }
    m3_fill(tr,num,meta,tv,0,16,0,0);
    // volatile fill BELOW instrumentation: no tracer event for this op
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let t:i64=m3_taint_of(tr,num,meta,tv,8,8);
    m3_write_out(tr,num,1,1,tv,8,8,t);
    // raw exit: trace buffer never flushed, END footer never emitted
    _zag_raw_syscall(60,0,0,0,0,0,0);
    return 0;
}

fn main()i32 {
    let tr:[]u8=m3_tr_new();
    let num:[]i64=m3_num_new();
    let meta:[]u8=m3_meta_new();
    let path:[]u8=m3_path_new();
    if(tr.len==0 || m3_num_ok(num)==0 || meta.len==0 || path.len==0){ _zag_println("NOMEM"); return 1; }
    let mode:[]u8=_zag_arg(2);
    if(mode.len>=5 && mode[0]==100){ m3_predirty(); }
    if(m3_trace_begin(tr,num,_zag_arg(1))!=0){ _zag_println("NOFILE"); return 1; }
    let rc:i32=vary(tr,num,meta,path);
    m3_trace_end(tr,num);
    return rc;
}

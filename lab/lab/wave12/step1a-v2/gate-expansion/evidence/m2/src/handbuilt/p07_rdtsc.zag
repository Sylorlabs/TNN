@import("m2_substrate.zag")
// P07 — rdtsc instruction plant. Executes the genuine RDTSC instruction.
//
// Mechanism (characterized 2026-09-25 on the pinned toolchain):
//   * `fn as i64` yields a STACK DESCRIPTOR [code_addr,0,0,0], not the code
//     address (proven by byte-dump: desc[0]=0x40305A).
//   * `i64 as fn()i64` does NOT round-trip a raw address (proven: a
//     `ret`-only stub at a raw mmap address segfaults; (f as i64)!=mem).
//   * Working path: read the real code address from the descriptor,
//     mprotect(10) the code page to RWX, overwrite the first 8 bytes with
//     0F 31 C3 (rdtsc; ret) via a *u64 store, then call through the
//     ORIGINAL (intact) descriptor — the probe3 indirect-call pattern.
// The TSC diverges on every run. Expected: M2 FAIL (caught).

fn tsc_slot()i64 { return 0; }

fn rdtsc()i64 {
    let faddr:i64=tsc_slot as i64;
    let dp:*u64=faddr as *u64;
    let code:i64=dp[0];
    if(code<=0){return -1;}
    let page:i64=code-(code%4096);
    let mp:i64=_zag_raw_syscall(10,page,4096,7,0,0,0);
    if(mp!=0){return -2;}
    let w:*u64=code as *u64;
    w[0]=12792079; // 0xC3310F -> bytes 0F 31 C3 = rdtsc; ret
    let g:fn()i64=faddr as fn()i64;
    let v:i64=g();
    return v;
}

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    let t:i64=rdtsc();
    if(t<0){return 4;}
    if(out.len>0){out[0]=(t&255) as u8;}
    if(out.len>1){out[1]=((t>>8)&255) as u8;}
    if(out.len>2){out[2]=((t>>16)&255) as u8;}
    if(out.len>3){out[3]=((t>>24)&255) as u8;}
    let i:i32=4;
    while(i<out.len && i<input.len){out[i]=input[i]; i=i+1;}
    return 0;
}

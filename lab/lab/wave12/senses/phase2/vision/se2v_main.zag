// SE2V-MAIN — vision phase-2 qualification battery (proposed bar §A–§E vision).
// Pure Zag. Deterministic output: CL_CHECK lines + fixed markers only.
// No RNG, no wall-clock, no threads, no floats. Strengths/judgments/cites
// are caller-declared constants; no observation-byte arithmetic feeds them.
// Prereg: PREREG_SENSES_PHASE2_VISION.md (frozen before build).
@import("substrate/cl/common.zag")
@import("substrate/R33_NATIVE_SHA256_V2.zag")
@import("substrate/R33_NATIVE_IO_V1.zag")
@import("se_ingress.zag")
@import("se_memif.zag")

fn v2v_copy(dst:[]u8,src:[]u8,n:i32)void {
    let i:i32=0;while(i<n){dst[i]=src[i];i=i+1;}
}

// Deterministic fixture fill: b[i] = (i*37 + seed*11 + 13) & 255.
// Index arithmetic only; no randomness, no wall clock.
fn v2v_pattern(b:[]u8,seed:i32)void {
    let i:i32=0;
    while(i<b.len){b[i]=((i*37+seed*11+13)&255) as u8;i=i+1;}
}

// Check-name builder: prefix + two decimal digits of k (k < 100, no division).
fn se2v_name2(prefix:[]u8,k:i32,out:[]u8)void {
    let i:i32=0;
    while(i<prefix.len){out[i]=prefix[i];i=i+1;}
    let t:i32=0;let u:i32=k;
    while(u>=10){u=u-10;t=t+1;}
    out[prefix.len]=(48+t) as u8;
    out[prefix.len+1]=(48+u) as u8;
}

// 2x2 RGB8 base fixture bytes: 10,20,...,120.
fn v2v_base12(b:[]u8)void {
    b[0]=10;b[1]=20;b[2]=30;b[3]=40;b[4]=50;b[5]=60;
    b[6]=70;b[7]=80;b[8]=90;b[9]=100;b[10]=110;b[11]=120;
}

// ---- §A-vision: malformed/edge ingress battery (16 checks) ----
fn se2v_section_a()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let pay:[]u8=nio_alloc(12);v2v_base12(pay);
    let rec:[]u8=nio_alloc(92);
    fails=fails+cl_check("se2v-a-build",se_build(rec,SE_ENC_RGB8,2,2,pay),SE_OK);
    let pristine:[]u8=nio_alloc(92);v2v_copy(pristine,rec,92);
    fails=fails+cl_check("se2v-a-admit-valid",se_admit(&se,rec),0);
    let s0:i32=0;
    fails=fails+cl_check("se2v-a-observe-valid",
        mi_observe(&mi,&se,0,MI_J_NOVEL,50,MI_REGION_USER,21,&s0),MI_OK);
    let n_before:i32=se.n;
    let live_before:i32=mi_live_count(&mi);

    let bad:[]u8=nio_alloc(92);
    v2v_copy(bad,pristine,92);bad[0]=88; // bad magic
    fails=fails+cl_check("se2v-a-bad-magic",se_admit(&se,bad),SE_BAD_MAGIC);
    v2v_copy(bad,pristine,92);se_i32_set(bad,8,2); // bad version
    fails=fails+cl_check("se2v-a-bad-version",se_admit(&se,bad),SE_BAD_VERSION);
    v2v_copy(bad,pristine,92);se_i32_set(bad,12,9); // bad encoding id
    fails=fails+cl_check("se2v-a-bad-encoding",se_admit(&se,bad),SE_BAD_ENCODING);
    v2v_copy(bad,pristine,92);se_i32_set(bad,16,0); // width 0
    fails=fails+cl_check("se2v-a-width-0",se_admit(&se,bad),SE_BAD_PARAM);
    v2v_copy(bad,pristine,92);se_i32_set(bad,20,0); // height 0
    fails=fails+cl_check("se2v-a-height-0",se_admit(&se,bad),SE_BAD_PARAM);
    v2v_copy(bad,pristine,92);se_i32_set(bad,16,65); // width > 64
    fails=fails+cl_check("se2v-a-width-65",se_admit(&se,bad),SE_BAD_PARAM);
    v2v_copy(bad,pristine,92);se_i32_set(bad,20,65); // height > 64
    fails=fails+cl_check("se2v-a-height-65",se_admit(&se,bad),SE_BAD_PARAM);
    // payload_len != w*h*3: 13 payload bytes with a valid hash over those 13
    let b8:[]u8=nio_alloc(93);v2v_copy(b8,pristine,80);
    se_i32_set(b8,24,13);
    let bi:i32=0;while(bi<12){b8[80+bi]=pristine[80+bi];bi=bi+1;}
    b8[92]=7; // 13th payload byte (pristine carries only 12)
    let h8:[]u8=nio_alloc(32);
    if(ns_sha256(b8[80..93],h8)!=0){fails=fails+1;}
    bi=0;while(bi<32){b8[48+bi]=h8[bi];bi=bi+1;}
    nio_free(h8);
    fails=fails+cl_check("se2v-a-plen-neq-wh3",se_admit(&se,b8),SE_BAD_PARAM);
    v2v_copy(bad,pristine,92);bad[85]=bad[85]+1; // 1 corrupted payload byte
    fails=fails+cl_check("se2v-a-bad-hash",se_admit(&se,bad),SE_BAD_HASH);
    let t10:[]u8=pristine[0..79]; // truncated header
    fails=fails+cl_check("se2v-a-trunc-header",se_admit(&se,t10),SE_BAD_MAGIC);
    let t11:[]u8=pristine[0..91]; // truncated payload (plen=12, 11 present)
    fails=fails+cl_check("se2v-a-trunc-payload",se_admit(&se,t11),SE_LEN_MISMATCH);
    // zero-length payload: plen=0; the param check fires before any hash read
    let b12:[]u8=nio_alloc(80);v2v_copy(b12,pristine,80);
    se_i32_set(b12,24,0);
    fails=fails+cl_check("se2v-a-zero-payload",se_admit(&se,b12),SE_BAD_PARAM);
    // declared length over capacity: plen=12289; capacity check fires first
    let b13:[]u8=nio_alloc(80);v2v_copy(b13,pristine,80);
    se_i32_set(b13,24,12289);
    fails=fails+cl_check("se2v-a-plen-over-cap",se_admit(&se,b13),SE_BAD_PARAM);
    v2v_copy(bad,pristine,92);se_i32_set(bad,28,1); // channels != 3
    fails=fails+cl_check("se2v-a-channels-neq-3",se_admit(&se,bad),SE_BAD_PARAM);
    v2v_copy(bad,pristine,92);se_i32_set(bad,32,16); // bit-depth != 8
    fails=fails+cl_check("se2v-a-bitdepth-neq-8",se_admit(&se,bad),SE_BAD_PARAM);
    v2v_copy(bad,pristine,92);bad[36]=1; // reserved param nonzero
    fails=fails+cl_check("se2v-a-reserved-nonzero",se_admit(&se,bad),SE_BAD_PARAM);

    // K-SE3: zero state mutation across the battery
    fails=fails+cl_check("se2v-a-refusals-16",se.refusals,16);
    fails=fails+cl_check("se2v-a-n-unchanged",se.n,n_before);
    fails=fails+cl_check("se2v-a-live-unchanged",mi_live_count(&mi),live_before);
    nio_free(pay);nio_free(rec);nio_free(pristine);nio_free(bad);
    nio_free(b8);nio_free(b12);nio_free(b13);
    return fails;
}

// ---- §B-vision: OBSERVE admission discipline (8 probes + 1 audit scan) ----
fn se2v_section_b()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let pay:[]u8=nio_alloc(12);v2v_base12(pay);
    let rec:[]u8=nio_alloc(92);
    fails=fails+cl_check("se2v-b-build",se_build(rec,SE_ENC_RGB8,2,2,pay),SE_OK);
    fails=fails+cl_check("se2v-b-admit",se_admit(&se,rec),0);
    let sx:i32=0;
    fails=fails+cl_check("se2v-b-judgment-none",
        mi_observe(&mi,&se,0,MI_J_NONE,50,MI_REGION_USER,30,&sx),MI_REFUSED_NO_JUDGMENT);
    fails=fails+cl_check("se2v-b-judgment-5",
        mi_observe(&mi,&se,0,5,50,MI_REGION_USER,30,&sx),MI_REFUSED_NO_JUDGMENT);
    fails=fails+cl_check("se2v-b-strength-0",
        mi_observe(&mi,&se,0,MI_J_NOVEL,0,MI_REGION_USER,30,&sx),MI_REFUSED_BAD_STRENGTH);
    fails=fails+cl_check("se2v-b-strength-101",
        mi_observe(&mi,&se,0,MI_J_NOVEL,101,MI_REGION_USER,30,&sx),MI_REFUSED_BAD_STRENGTH);
    fails=fails+cl_check("se2v-b-region-2",
        mi_observe(&mi,&se,0,MI_J_NOVEL,50,2,30,&sx),MI_REFUSED_BAD_REGION);
    fails=fails+cl_check("se2v-b-cite-neg1",
        mi_observe(&mi,&se,0,MI_J_NOVEL,50,MI_REGION_USER,-1,&sx),MI_REFUSED_BAD_CITE);
    fails=fails+cl_check("se2v-b-dead-recid",
        mi_observe(&mi,&se,1,MI_J_NOVEL,50,MI_REGION_USER,30,&sx),MI_REFUSED_BAD_REC);
    // fill all 16 slots (setup lines, unique names se2v-b-fill-00..15)
    let k:i32=0;
    let pfx:[]u8="se2v-b-fill-";
    while(k<16){
        let nm:[]u8=nio_alloc(14);
        se2v_name2(pfx,k,nm);
        let sk:i32=0;
        let rc:i32=mi_observe(&mi,&se,0,MI_J_NOVEL,1+k,MI_REGION_USER,500+k,&sk);
        fails=fails+cl_check(nm,rc,MI_OK);
        nio_free(nm);
        k=k+1;
    }
    fails=fails+cl_check("se2v-b-live-16",mi_live_count(&mi),16);
    fails=fails+cl_check("se2v-b-full-refused",
        mi_observe(&mi,&se,0,MI_J_NOVEL,50,MI_REGION_USER,999,&sx),MI_REFUSED_FULL);
    fails=fails+cl_check("se2v-b-audit-scan",mi_audit_scan(&mi),1);
    nio_free(pay);nio_free(rec);
    return fails;
}

// ---- §C-vision: kill / pin / recall semantics (10 probes) ----
fn se2v_section_c()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let pay0:[]u8=nio_alloc(12);v2v_base12(pay0);
    let pay1:[]u8=nio_alloc(12);v2v_base12(pay1);pay1[0]=11;
    let pay2:[]u8=nio_alloc(12);v2v_base12(pay2);pay2[0]=12;
    let rec0:[]u8=nio_alloc(92);se_build(rec0,SE_ENC_RGB8,2,2,pay0);
    let rec1:[]u8=nio_alloc(92);se_build(rec1,SE_ENC_RGB8,2,2,pay1);
    let rec2:[]u8=nio_alloc(92);se_build(rec2,SE_ENC_RGB8,2,2,pay2);
    fails=fails+cl_check("se2v-c-admit0",se_admit(&se,rec0),0);
    fails=fails+cl_check("se2v-c-admit1",se_admit(&se,rec1),1);
    fails=fails+cl_check("se2v-c-admit2",se_admit(&se,rec2),2);
    let s0:i32=0;let s1:i32=0;let s2:i32=0;
    fails=fails+cl_check("se2v-c-obs0",
        mi_observe(&mi,&se,0,MI_J_NOVEL,50,MI_REGION_USER,41,&s0),MI_OK);
    fails=fails+cl_check("se2v-c-obs1",
        mi_observe(&mi,&se,1,MI_J_CORROBORATED,60,MI_REGION_CORE,42,&s1),MI_OK);
    fails=fails+cl_check("se2v-c-obs2",
        mi_observe(&mi,&se,2,MI_J_NOVEL,70,MI_REGION_USER,43,&s2),MI_OK);
    fails=fails+cl_check("se2v-c-pin-s0",mi_pin(&mi,s0),MI_OK);
    fails=fails+cl_check("se2v-c-kill-pinned",mi_kill(&mi,s0,9),MI_REFUSED_PINNED);
    fails=fails+cl_check("se2v-c-kill-core",mi_kill(&mi,s1,9),MI_REFUSED_CORE);
    fails=fails+cl_check("se2v-c-kill-no-evidence",mi_kill(&mi,s2,0),MI_REFUSED_NO_EVIDENCE);
    fails=fails+cl_check("se2v-c-kill-legit",mi_kill(&mi,s2,5),MI_OK);
    fails=fails+cl_check("se2v-c-rekill",mi_kill(&mi,s2,5),MI_REFUSED_NOTLIVE);
    let rb:[]u8=nio_alloc(92);
    fails=fails+cl_check("se2v-c-recall-dead",mi_recall(&mi,&se,s2,rb),MI_REFUSED_NOTLIVE);
    // recall twice -> identical bytes
    let r1:[]u8=nio_alloc(92);let r2:[]u8=nio_alloc(92);
    let l1:i32=mi_recall(&mi,&se,s1,r1);
    let l2:i32=mi_recall(&mi,&se,s1,r2);
    fails=fails+cl_check("se2v-c-recall-twice",
        ((l1==92 && l2==92 && nio_equal(r1,r2)==1) as i32),1);
    // mutate the recalled caller buffer, re-recall -> stored bytes unchanged
    r1[80]=r1[80]+1;r1[0]=r1[0]+1;
    let r3:[]u8=nio_alloc(92);
    let l3:i32=mi_recall(&mi,&se,s1,r3);
    fails=fails+cl_check("se2v-c-recall-no-alias",
        ((l3==92 && nio_equal(r3,rec1)==1) as i32),1);
    // pin is idempotent
    let pc1:i32=mi_pin(&mi,s1);
    let pc2:i32=mi_pin(&mi,s1);
    let pnd:[]u8=mi.pinned;
    fails=fails+cl_check("se2v-c-pin-idempotent",
        ((pc1==MI_OK && pc2==MI_OK && pnd[s1]==1) as i32),1);
    // OBSERVE into the freed slot: slot reused, provenance == NEW record's
    // payload hash (no ghost provenance from the killed occupant)
    let s3:i32=0;
    let oc:i32=mi_observe(&mi,&se,0,MI_J_CONTRADICTED,80,MI_REGION_USER,44,&s3);
    let exp:[]u8=nio_alloc(32);
    let rv0:[]u8=se_rec_view(&se,0);
    if(ns_sha256(rv0[80..rv0.len],exp)!=0){fails=fails+1;}
    let ph:[]u8=mi.phash;
    let phm:i32=1;let j:i32=0;
    while(j<32){if(ph[s3*32+j]!=exp[j]){phm=0;}j=j+1;}
    fails=fails+cl_check("se2v-c-observe-freed",
        ((oc==MI_OK && s3==s2 && phm==1) as i32),1);
    nio_free(pay0);nio_free(pay1);nio_free(pay2);
    nio_free(rec0);nio_free(rec1);nio_free(rec2);
    nio_free(rb);nio_free(r1);nio_free(r2);nio_free(r3);nio_free(exp);
    return fails;
}

// ---- §D-vision: paired twins, S1 discriminability (24 checks) ----
// Admit both records, OBSERVE both into a fresh store, RECALL both.
// ok=1 iff: admits sequential, both OBSERVEs MI_OK, both recalls return full
// length, recalled bytes differ, and the two slots' provenance sha256 differ.
// (Different payload lengths count as differing bytes without nio_equal.)
fn se2v_twin_pair(se:*SeStore,ra:[]u8,rb:[]u8,rla:i32,rlb:i32,
                 jdg:i32,st:i32,cite:i32,name:[]u8)i32 {
    let ida:i32=se_admit(se,ra);
    let idb:i32=se_admit(se,rb);
    let m:MiStore=mi_make();
    let sa:i32=0;let sb:i32=0;
    let oa:i32=mi_observe(&m,se,ida,jdg,st,MI_REGION_USER,cite,&sa);
    let ob:i32=mi_observe(&m,se,idb,MI_J_CORROBORATED,st,MI_REGION_USER,cite+1,&sb);
    let ba:[]u8=nio_alloc(rla);let bb:[]u8=nio_alloc(rlb);
    let la:i32=mi_recall(&m,se,sa,ba);
    let lb:i32=mi_recall(&m,se,sb,bb);
    let bd:i32=0;
    if(rla!=rlb){bd=1;}else{bd=(nio_equal(ba,bb)==0) as i32;}
    let ph:[]u8=m.phash;
    let phd:i32=0;let j:i32=0;
    while(j<32){if(ph[sa*32+j]!=ph[sb*32+j]){phd=1;}j=j+1;}
    let ok:i32=0;
    if(ida>=0 && idb==ida+1 && oa==MI_OK && ob==MI_OK &&
       la==rla && lb==rlb && bd==1 && phd==1){ok=1;}
    nio_free(ba);nio_free(bb);
    return cl_check(name,ok,1);
}

fn se2v_section_d()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();

    // 1. px-plus1: 2x2, pixel[0].R 10 -> 11
    let p1a:[]u8=nio_alloc(12);v2v_base12(p1a);
    let p1b:[]u8=nio_alloc(12);v2v_copy(p1b,p1a,12);p1b[0]=11;
    let r1a:[]u8=nio_alloc(92);se_build(r1a,SE_ENC_RGB8,2,2,p1a);
    let r1b:[]u8=nio_alloc(92);se_build(r1b,SE_ENC_RGB8,2,2,p1b);
    fails=fails+se2v_twin_pair(&se,r1a,r1b,92,92,MI_J_NOVEL,11,1001,"se2v-twin-px-plus1");
    nio_free(p1a);nio_free(p1b);nio_free(r1a);nio_free(r1b);

    // 2. px-permute: 2x2, pixels 0<->3 swapped (identical byte histogram)
    let p2a:[]u8=nio_alloc(12);v2v_base12(p2a);
    let p2b:[]u8=nio_alloc(12);v2v_copy(p2b,p2a,12);
    let t20:u8=p2b[0];let t21:u8=p2b[1];let t22:u8=p2b[2];
    p2b[0]=p2b[9];p2b[1]=p2b[10];p2b[2]=p2b[11];
    p2b[9]=t20;p2b[10]=t21;p2b[11]=t22;
    let r2a:[]u8=nio_alloc(92);se_build(r2a,SE_ENC_RGB8,2,2,p2a);
    let r2b:[]u8=nio_alloc(92);se_build(r2b,SE_ENC_RGB8,2,2,p2b);
    fails=fails+se2v_twin_pair(&se,r2a,r2b,92,92,MI_J_CORROBORATED,12,1002,"se2v-twin-px-permute");
    nio_free(p2a);nio_free(p2b);nio_free(r2a);nio_free(r2b);

    // 3. row-swap: 3x3, rows 0<->2 swapped
    let p3a:[]u8=nio_alloc(27);v2v_pattern(p3a,3);
    let p3b:[]u8=nio_alloc(27);v2v_copy(p3b,p3a,27);
    let q3:i32=0;
    while(q3<9){let t:u8=p3b[q3];p3b[q3]=p3b[18+q3];p3b[18+q3]=t;q3=q3+1;}
    let r3a:[]u8=nio_alloc(107);se_build(r3a,SE_ENC_RGB8,3,3,p3a);
    let r3b:[]u8=nio_alloc(107);se_build(r3b,SE_ENC_RGB8,3,3,p3b);
    fails=fails+se2v_twin_pair(&se,r3a,r3b,107,107,MI_J_NOVEL,13,1003,"se2v-twin-row-swap");
    nio_free(p3a);nio_free(p3b);nio_free(r3a);nio_free(r3b);

    // 4. px-zeroed: 2x2, pixel[1] -> (0,0,0)
    let p4a:[]u8=nio_alloc(12);v2v_base12(p4a);
    let p4b:[]u8=nio_alloc(12);v2v_copy(p4b,p4a,12);
    p4b[3]=0;p4b[4]=0;p4b[5]=0;
    let r4a:[]u8=nio_alloc(92);se_build(r4a,SE_ENC_RGB8,2,2,p4a);
    let r4b:[]u8=nio_alloc(92);se_build(r4b,SE_ENC_RGB8,2,2,p4b);
    fails=fails+se2v_twin_pair(&se,r4a,r4b,92,92,MI_J_CORROBORATED,14,1004,"se2v-twin-px-zeroed");
    nio_free(p4a);nio_free(p4b);nio_free(r4a);nio_free(r4b);

    // 5. brightness-plus1: 2x2, every byte +1
    let p5a:[]u8=nio_alloc(12);v2v_base12(p5a);
    let p5b:[]u8=nio_alloc(12);v2v_copy(p5b,p5a,12);
    let q5:i32=0;while(q5<12){p5b[q5]=p5b[q5]+1;q5=q5+1;}
    let r5a:[]u8=nio_alloc(92);se_build(r5a,SE_ENC_RGB8,2,2,p5a);
    let r5b:[]u8=nio_alloc(92);se_build(r5b,SE_ENC_RGB8,2,2,p5b);
    fails=fails+se2v_twin_pair(&se,r5a,r5b,92,92,MI_J_NOVEL,15,1005,"se2v-twin-brightness-plus1");
    nio_free(p5a);nio_free(p5b);nio_free(r5a);nio_free(r5b);

    // 6. size-1x1-vs-2x2: uniform gray frames at different sizes
    let p6a:[]u8=nio_alloc(3);p6a[0]=128;p6a[1]=128;p6a[2]=128;
    let p6b:[]u8=nio_alloc(12);
    let q6:i32=0;while(q6<12){p6b[q6]=128;q6=q6+1;}
    let r6a:[]u8=nio_alloc(83);se_build(r6a,SE_ENC_RGB8,1,1,p6a);
    let r6b:[]u8=nio_alloc(92);se_build(r6b,SE_ENC_RGB8,2,2,p6b);
    fails=fails+se2v_twin_pair(&se,r6a,r6b,83,92,MI_J_CORROBORATED,16,1006,"se2v-twin-size-1x1-vs-2x2");
    nio_free(p6a);nio_free(p6b);nio_free(r6a);nio_free(r6b);

    // 7. wh-transposed: 2x3 vs 3x2 with transposed pixel layout
    let p7a:[]u8=nio_alloc(18);v2v_pattern(p7a,7);
    let p7b:[]u8=nio_alloc(18);
    let by7:i32=0;
    while(by7<2){
        let bx7:i32=0;
        while(bx7<3){
            let c7:i32=0;
            while(c7<3){p7b[(by7*3+bx7)*3+c7]=p7a[(bx7*2+by7)*3+c7];c7=c7+1;}
            bx7=bx7+1;
        }
        by7=by7+1;
    }
    let r7a:[]u8=nio_alloc(98);se_build(r7a,SE_ENC_RGB8,2,3,p7a);
    let r7b:[]u8=nio_alloc(98);se_build(r7b,SE_ENC_RGB8,3,2,p7b);
    fails=fails+se2v_twin_pair(&se,r7a,r7b,98,98,MI_J_NOVEL,17,1007,"se2v-twin-wh-transposed");
    nio_free(p7a);nio_free(p7b);nio_free(r7a);nio_free(r7b);

    // 8. px-minus1: 2x2, pixel[2].B 90 -> 89
    let p8a:[]u8=nio_alloc(12);v2v_base12(p8a);
    let p8b:[]u8=nio_alloc(12);v2v_copy(p8b,p8a,12);p8b[8]=89;
    let r8a:[]u8=nio_alloc(92);se_build(r8a,SE_ENC_RGB8,2,2,p8a);
    let r8b:[]u8=nio_alloc(92);se_build(r8b,SE_ENC_RGB8,2,2,p8b);
    fails=fails+se2v_twin_pair(&se,r8a,r8b,92,92,MI_J_CORROBORATED,18,1008,"se2v-twin-px-minus1");
    nio_free(p8a);nio_free(p8b);nio_free(r8a);nio_free(r8b);

    // 9. px-chan-zero: 2x2, pixel[2].G 200 -> 0
    let p9a:[]u8=nio_alloc(12);v2v_base12(p9a);p9a[7]=200;
    let p9b:[]u8=nio_alloc(12);v2v_copy(p9b,p9a,12);p9b[7]=0;
    let r9a:[]u8=nio_alloc(92);se_build(r9a,SE_ENC_RGB8,2,2,p9a);
    let r9b:[]u8=nio_alloc(92);se_build(r9b,SE_ENC_RGB8,2,2,p9b);
    fails=fails+se2v_twin_pair(&se,r9a,r9b,92,92,MI_J_NOVEL,19,1009,"se2v-twin-px-chan-zero");
    nio_free(p9a);nio_free(p9b);nio_free(r9a);nio_free(r9b);

    // 10. col-swap: 3x3, columns 0<->2 swapped
    let p10a:[]u8=nio_alloc(27);v2v_pattern(p10a,10);
    let p10b:[]u8=nio_alloc(27);v2v_copy(p10b,p10a,27);
    let r10:i32=0;
    while(r10<3){
        let c10:i32=0;
        while(c10<3){
            let t:u8=p10b[r10*9+c10];
            p10b[r10*9+c10]=p10b[r10*9+6+c10];
            p10b[r10*9+6+c10]=t;
            c10=c10+1;
        }
        r10=r10+1;
    }
    let rr10a:[]u8=nio_alloc(107);se_build(rr10a,SE_ENC_RGB8,3,3,p10a);
    let rr10b:[]u8=nio_alloc(107);se_build(rr10b,SE_ENC_RGB8,3,3,p10b);
    fails=fails+se2v_twin_pair(&se,rr10a,rr10b,107,107,MI_J_CORROBORATED,20,1010,"se2v-twin-col-swap");
    nio_free(p10a);nio_free(p10b);nio_free(rr10a);nio_free(rr10b);

    // 11. px-chan-rotate: 2x2, pixel[0] (10,20,30)->(20,30,10), histogram kept
    let p11a:[]u8=nio_alloc(12);v2v_base12(p11a);
    let p11b:[]u8=nio_alloc(12);v2v_copy(p11b,p11a,12);
    p11b[0]=20;p11b[1]=30;p11b[2]=10;
    let r11a:[]u8=nio_alloc(92);se_build(r11a,SE_ENC_RGB8,2,2,p11a);
    let r11b:[]u8=nio_alloc(92);se_build(r11b,SE_ENC_RGB8,2,2,p11b);
    fails=fails+se2v_twin_pair(&se,r11a,r11b,92,92,MI_J_NOVEL,21,1011,"se2v-twin-px-chan-rotate");
    nio_free(p11a);nio_free(p11b);nio_free(r11a);nio_free(r11b);

    // 12. brightness-minus1: 2x2, every byte -1
    let p12a:[]u8=nio_alloc(12);v2v_base12(p12a);
    let p12b:[]u8=nio_alloc(12);v2v_copy(p12b,p12a,12);
    let q12:i32=0;while(q12<12){p12b[q12]=p12b[q12]-1;q12=q12+1;}
    let r12a:[]u8=nio_alloc(92);se_build(r12a,SE_ENC_RGB8,2,2,p12a);
    let r12b:[]u8=nio_alloc(92);se_build(r12b,SE_ENC_RGB8,2,2,p12b);
    fails=fails+se2v_twin_pair(&se,r12a,r12b,92,92,MI_J_CORROBORATED,22,1012,"se2v-twin-brightness-minus1");
    nio_free(p12a);nio_free(p12b);nio_free(r12a);nio_free(r12b);

    // 13. px-invert: 2x2, pixel[3] channels -> 255-v
    let p13a:[]u8=nio_alloc(12);v2v_base12(p13a);
    let p13b:[]u8=nio_alloc(12);v2v_copy(p13b,p13a,12);
    p13b[9]=255-p13b[9];p13b[10]=255-p13b[10];p13b[11]=255-p13b[11];
    let r13a:[]u8=nio_alloc(92);se_build(r13a,SE_ENC_RGB8,2,2,p13a);
    let r13b:[]u8=nio_alloc(92);se_build(r13b,SE_ENC_RGB8,2,2,p13b);
    fails=fails+se2v_twin_pair(&se,r13a,r13b,92,92,MI_J_NOVEL,23,1013,"se2v-twin-px-invert");
    nio_free(p13a);nio_free(p13b);nio_free(r13a);nio_free(r13b);

    // 14. diag-swap: 3x3, pixels (0,0)<->(2,2) swapped
    let p14a:[]u8=nio_alloc(27);v2v_pattern(p14a,14);
    let p14b:[]u8=nio_alloc(27);v2v_copy(p14b,p14a,27);
    let q14:i32=0;
    while(q14<3){let t:u8=p14b[q14];p14b[q14]=p14b[24+q14];p14b[24+q14]=t;q14=q14+1;}
    let r14a:[]u8=nio_alloc(107);se_build(r14a,SE_ENC_RGB8,3,3,p14a);
    let r14b:[]u8=nio_alloc(107);se_build(r14b,SE_ENC_RGB8,3,3,p14b);
    fails=fails+se2v_twin_pair(&se,r14a,r14b,107,107,MI_J_CORROBORATED,24,1014,"se2v-twin-diag-swap");
    nio_free(p14a);nio_free(p14b);nio_free(r14a);nio_free(r14b);

    // 15. corner-px-bump: 4x4 constant frame, bottom-right pixel .R 100 -> 101
    let p15a:[]u8=nio_alloc(48);
    let q15:i32=0;while(q15<48){p15a[q15]=100;q15=q15+1;}
    let p15b:[]u8=nio_alloc(48);v2v_copy(p15b,p15a,48);p15b[45]=101;
    let r15a:[]u8=nio_alloc(128);se_build(r15a,SE_ENC_RGB8,4,4,p15a);
    let r15b:[]u8=nio_alloc(128);se_build(r15b,SE_ENC_RGB8,4,4,p15b);
    fails=fails+se2v_twin_pair(&se,r15a,r15b,128,128,MI_J_NOVEL,25,1015,"se2v-twin-corner-px-bump");
    nio_free(p15a);nio_free(p15b);nio_free(r15a);nio_free(r15b);

    // 16. width-plus1: 4x4 vs 5x4, same row-major pattern prefix
    let p16a:[]u8=nio_alloc(48);v2v_pattern(p16a,16);
    let p16b:[]u8=nio_alloc(60);v2v_pattern(p16b,16);
    let r16a:[]u8=nio_alloc(128);se_build(r16a,SE_ENC_RGB8,4,4,p16a);
    let r16b:[]u8=nio_alloc(140);se_build(r16b,SE_ENC_RGB8,5,4,p16b);
    fails=fails+se2v_twin_pair(&se,r16a,r16b,128,140,MI_J_CORROBORATED,26,1016,"se2v-twin-width-plus1");
    nio_free(p16a);nio_free(p16b);nio_free(r16a);nio_free(r16b);

    // 17. height-plus1: 4x4 vs 4x5, same row-major pattern prefix
    let p17a:[]u8=nio_alloc(48);v2v_pattern(p17a,17);
    let p17b:[]u8=nio_alloc(60);v2v_pattern(p17b,17);
    let r17a:[]u8=nio_alloc(128);se_build(r17a,SE_ENC_RGB8,4,4,p17a);
    let r17b:[]u8=nio_alloc(140);se_build(r17b,SE_ENC_RGB8,4,5,p17b);
    fails=fails+se2v_twin_pair(&se,r17a,r17b,128,140,MI_J_NOVEL,27,1017,"se2v-twin-height-plus1");
    nio_free(p17a);nio_free(p17b);nio_free(r17a);nio_free(r17b);

    // 18. uniform-gray-step: 2x2 uniform 100 vs uniform 101
    let p18a:[]u8=nio_alloc(12);
    let p18b:[]u8=nio_alloc(12);
    let q18:i32=0;while(q18<12){p18a[q18]=100;p18b[q18]=101;q18=q18+1;}
    let r18a:[]u8=nio_alloc(92);se_build(r18a,SE_ENC_RGB8,2,2,p18a);
    let r18b:[]u8=nio_alloc(92);se_build(r18b,SE_ENC_RGB8,2,2,p18b);
    fails=fails+se2v_twin_pair(&se,r18a,r18b,92,92,MI_J_CORROBORATED,28,1018,"se2v-twin-uniform-gray-step");
    nio_free(p18a);nio_free(p18b);nio_free(r18a);nio_free(r18b);

    // 19. red-vs-blue: 2x2 pure red vs pure blue
    let p19a:[]u8=nio_alloc(12);
    let p19b:[]u8=nio_alloc(12);
    let q19:i32=0;
    while(q19<4){
        p19a[q19*3]=255;p19a[q19*3+1]=0;p19a[q19*3+2]=0;
        p19b[q19*3]=0;p19b[q19*3+1]=0;p19b[q19*3+2]=255;
        q19=q19+1;
    }
    let r19a:[]u8=nio_alloc(92);se_build(r19a,SE_ENC_RGB8,2,2,p19a);
    let r19b:[]u8=nio_alloc(92);se_build(r19b,SE_ENC_RGB8,2,2,p19b);
    fails=fails+se2v_twin_pair(&se,r19a,r19b,92,92,MI_J_NOVEL,29,1019,"se2v-twin-red-vs-blue");
    nio_free(p19a);nio_free(p19b);nio_free(r19a);nio_free(r19b);

    // 20. px-relocate: 3x3, single white pixel at index 0 vs index 8
    let p20a:[]u8=nio_alloc(27);
    let p20b:[]u8=nio_alloc(27);
    let q20:i32=0;while(q20<27){p20a[q20]=0;p20b[q20]=0;q20=q20+1;}
    p20a[0]=255;p20a[1]=255;p20a[2]=255;
    p20b[24]=255;p20b[25]=255;p20b[26]=255;
    let r20a:[]u8=nio_alloc(107);se_build(r20a,SE_ENC_RGB8,3,3,p20a);
    let r20b:[]u8=nio_alloc(107);se_build(r20b,SE_ENC_RGB8,3,3,p20b);
    fails=fails+se2v_twin_pair(&se,r20a,r20b,107,107,MI_J_CORROBORATED,30,1020,"se2v-twin-px-relocate");
    nio_free(p20a);nio_free(p20b);nio_free(r20a);nio_free(r20b);

    // 21. lsb-flip: 3x3, last pixel .R 254 -> 255
    let p21a:[]u8=nio_alloc(27);v2v_pattern(p21a,21);p21a[24]=254;
    let p21b:[]u8=nio_alloc(27);v2v_copy(p21b,p21a,27);p21b[24]=255;
    let r21a:[]u8=nio_alloc(107);se_build(r21a,SE_ENC_RGB8,3,3,p21a);
    let r21b:[]u8=nio_alloc(107);se_build(r21b,SE_ENC_RGB8,3,3,p21b);
    fails=fails+se2v_twin_pair(&se,r21a,r21b,107,107,MI_J_NOVEL,31,1021,"se2v-twin-lsb-flip");
    nio_free(p21a);nio_free(p21b);nio_free(r21a);nio_free(r21b);

    // 22. px-plus1-8x8: 8x8 constant frame, pixel (5,3).G 100 -> 101
    let p22a:[]u8=nio_alloc(192);
    let q22:i32=0;while(q22<192){p22a[q22]=100;q22=q22+1;}
    let p22b:[]u8=nio_alloc(192);v2v_copy(p22b,p22a,192);p22b[88]=101;
    let r22a:[]u8=nio_alloc(272);se_build(r22a,SE_ENC_RGB8,8,8,p22a);
    let r22b:[]u8=nio_alloc(272);se_build(r22b,SE_ENC_RGB8,8,8,p22b);
    fails=fails+se2v_twin_pair(&se,r22a,r22b,272,272,MI_J_CORROBORATED,32,1022,"se2v-twin-px-plus1-8x8");
    nio_free(p22a);nio_free(p22b);nio_free(r22a);nio_free(r22b);

    // 23. phase-swap: 2x2 checkerboard phase flipped
    let p23a:[]u8=nio_alloc(12);
    let p23b:[]u8=nio_alloc(12);
    let q23:i32=0;
    while(q23<4){
        let w:u8=0;
        if(q23==1){w=255;}
        if(q23==3){w=255;}
        p23a[q23*3]=w;p23a[q23*3+1]=w;p23a[q23*3+2]=w;
        let v:u8=255-w;
        p23b[q23*3]=v;p23b[q23*3+1]=v;p23b[q23*3+2]=v;
        q23=q23+1;
    }
    let r23a:[]u8=nio_alloc(92);se_build(r23a,SE_ENC_RGB8,2,2,p23a);
    let r23b:[]u8=nio_alloc(92);se_build(r23b,SE_ENC_RGB8,2,2,p23b);
    fails=fails+se2v_twin_pair(&se,r23a,r23b,92,92,MI_J_NOVEL,33,1023,"se2v-twin-phase-swap");
    nio_free(p23a);nio_free(p23b);nio_free(r23a);nio_free(r23b);

    // 24. tail-byte-plus1: 3x3 constant frame, final payload byte 100 -> 101
    let p24a:[]u8=nio_alloc(27);
    let q24:i32=0;while(q24<27){p24a[q24]=100;q24=q24+1;}
    let p24b:[]u8=nio_alloc(27);v2v_copy(p24b,p24a,27);p24b[26]=101;
    let r24a:[]u8=nio_alloc(107);se_build(r24a,SE_ENC_RGB8,3,3,p24a);
    let r24b:[]u8=nio_alloc(107);se_build(r24b,SE_ENC_RGB8,3,3,p24b);
    fails=fails+se2v_twin_pair(&se,r24a,r24b,107,107,MI_J_CORROBORATED,34,1024,"se2v-twin-tail-byte-plus1");
    nio_free(p24a);nio_free(p24b);nio_free(r24a);nio_free(r24b);

    fails=fails+cl_check("se2v-d-records-48",se.n,48);
    return fails;
}

// ---- §E-vision: realistic envelopes (12 checks) ----
// 8x 32x32 RGB8 (3,072 B payload) + 4x 64x64 RGB8 (12,288 B payload).
// Per frame: admit -> OBSERVE -> RECALL, recalled bytes == admitted bytes.
fn se2v_section_e()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let f:i32=0;
    let pfx:[]u8="se2v-e-frame-";
    while(f<12){
        let w:i32=32;let h:i32=32;let seed:i32=f+1;
        if(f>=8){w=64;h=64;seed=101+(f-8);}
        let plen:i32=w*h*3;
        let rlen:i32=80+plen;
        let pay:[]u8=nio_alloc(plen);v2v_pattern(pay,seed);
        let rec:[]u8=nio_alloc(rlen);
        let brc:i32=se_build(rec,SE_ENC_RGB8,w,h,pay);
        let id:i32=se_admit(&se,rec);
        let sl:i32=0;
        let orc:i32=mi_observe(&mi,&se,id,MI_J_NOVEL,20+f,MI_REGION_USER,700+f,&sl);
        let buf:[]u8=nio_alloc(rlen);
        let rl:i32=mi_recall(&mi,&se,sl,buf);
        let ok:i32=0;
        if(brc==SE_OK && id==f && orc==MI_OK && rl==rlen && nio_equal(buf,rec)==1){ok=1;}
        let nm:[]u8=nio_alloc(16);
        se2v_name2(pfx,f,nm);
        fails=fails+cl_check(nm,ok,1);
        nio_free(nm);nio_free(pay);nio_free(rec);nio_free(buf);
        f=f+1;
    }
    fails=fails+cl_check("se2v-e-records-12",se.n,12);
    fails=fails+cl_check("se2v-e-live-12",mi_live_count(&mi),12);
    return fails;
}

fn se2v_harness()i32 {
    let fails:i32=0;
    fails=fails+se2v_section_a();
    fails=fails+se2v_section_b();
    fails=fails+se2v_section_c();
    fails=fails+se2v_section_d();
    fails=fails+se2v_section_e();
    fails=fails+cl_check("se2v-fails-total",fails,0);
    _zag_println("SE2V_HARNESS_DONE");
    return fails;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(_zag_strcmp(m,"harness")==1){return se2v_harness();}
    _zag_println("SE2V_USAGE: harness");
    return 2;
}

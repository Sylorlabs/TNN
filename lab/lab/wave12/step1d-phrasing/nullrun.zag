// nullrun.zag — null-baseline matrix executor.
// argv[1]: nullself | nullonly | armonly | armc | freezencheck
// 40 probes x 10 trajectories x 20 states. Arms: 0 = null (canonical fixed
// rendering), 1 = Arm C (the phrasing function). Lockstep per-episode
// invariance checks in armc/freezencheck modes.
// Pure Zag. Zero RNG. (Harness.)
@import("p1d_null.zag")

// verdict-protected null render: -1 on any verdict-byte mutation
fn pro_null_render(v:*P1dVerdict,out:[]u8)i32 {
    let vb:[]u8=nio_alloc(256); let vb2:[]u8=nio_alloc(256);
    let n0:i32=phr_verdict_bytes(v,vb);
    let n:i32=null_render(v,out);
    let n1:i32=phr_verdict_bytes(v,vb2);
    let ok:i32=1;
    if(n0!=n1){ok=0;}
    let i:i32=0; while(i<n0 && ok==1){ if(vb[i]!=vb2[i]){ok=0;} i=i+1; }
    nio_free(vb); nio_free(vb2);
    if(ok==0){ return -1; }
    return n;
}
// render one arm (0=null,1=armc) for a single episode; returns length or -1
fn arm_render_ep(arm:i32,v:*P1dVerdict,s:P1dProj,out:[]u8)i32 {
    if(arm==0){ return pro_null_render(v,out); }
    return pro_render(v,s,out);
}
// one (probe, traj) cell for one arm -> cluster count; reps/lens scratch supplied.
// counts protection violations into *pviol via single-element buffer.
fn arm_cell(arm:i32,p:i64,t:i64,outs:[]u8,lens:[]u8,reps:[]u8,pviol:[]u8)i32 {
    let v:P1dVerdict=st_probe(p);
    let j:i32=0;
    while(j<20){
        let s:P1dProj=st_snap(t,j);
        let n:i32=arm_render_ep(arm,&v,s,outs[j*1024..j*1024+1024]);
        if(n<0){ fx_iset(pviol,0,fx_iget(pviol,0)+1); n=0; }
        fx_iset(lens,j,n);
        j=j+1;
    }
    return null_clusters(outs,20,lens,reps);
}
// full 40x10 matrix for one arm: sum of cluster counts; replay flag re-runs.
fn arm_matrix(arm:i32,tag:[]u8)void {
    let outs:[]u8=nio_alloc(20*1024); let lens:[]u8=nio_alloc(20*4); let reps:[]u8=nio_alloc(20*1024);
    let pviol:[]u8=nio_alloc(4); fx_iset(pviol,0,0);
    let sum:i32=0; let cells:i32=0;
    let p:i64=0;
    while(p<40){
        let t:i64=0;
        while(t<10){
            sum=sum+arm_cell(arm,p,t,outs,lens,reps,pviol);
            cells=cells+1;
            t=t+1;
        }
        p=p+1;
    }
    p("MATRIX,"); p(tag); p(",cells,"); pi(cells as i64); p(",clustersum,"); pi(sum as i64);
    p(",pviol,"); pi(fx_iget(pviol,0) as i64); pn();
    nio_free(outs); nio_free(lens); nio_free(reps); nio_free(pviol);
}
// nullself: run the null matrix twice; every cell must agree; D must be 0.
fn mode_nullself()i32 {
    let outs:[]u8=nio_alloc(20*1024); let lens:[]u8=nio_alloc(20*4); let reps:[]u8=nio_alloc(20*1024);
    let pviol:[]u8=nio_alloc(4); fx_iset(pviol,0,0);
    let bad:i32=0;
    let p:i64=0;
    while(p<40){
        let t:i64=0;
        while(t<10){
            let c1:i32=arm_cell(0,p,t,outs,lens,reps,pviol);
            let c2:i32=arm_cell(0,p,t,outs,lens,reps,pviol);
            if(c1!=c2){ bad=bad+1; }
            if(c1!=1){ bad=bad+1; } // null must render every state identically
            t=t+1;
        }
        p=p+1;
    }
    let pv:i32=fx_iget(pviol,0);
    p("NULLSELF,badcells,"); pi(bad as i64); p(",pviol,"); pi(pv as i64); pn();
    nio_free(outs); nio_free(lens); nio_free(reps); nio_free(pviol);
    if(bad==0 && pv==0){ p("NULLSELF,PASS\n"); return 0; }
    p("NULLSELF,FAIL\n");
    return 1;
}
// armc: lockstep null vs Arm C with per-episode invariance checks and bootstrap.
fn mode_armc()i32 {
    let outs0:[]u8=nio_alloc(20*1024); let lens0:[]u8=nio_alloc(20*4); let reps:[]u8=nio_alloc(20*1024);
    let outs1:[]u8=nio_alloc(20*1024); let lens1:[]u8=nio_alloc(20*4);
    let led0:[]u8=nio_alloc(64); let led1:[]u8=nio_alloc(64);
    let inv:i32=0; let pv:i32=0;
    let dtraj:[]u8=nio_alloc(10*8); // fx mean (D_armc - D_null) per trajectory
    let t:i64=0;
    while(t<10){
        let dsum:i64=0;
        let p:i64=0;
        while(p<40){
            let v:P1dVerdict=st_probe(p);
            let vb_pre:[]u8=nio_alloc(256);
            let npre:i32=phr_verdict_bytes(&v,vb_pre);
            let j:i32=0;
            while(j<20){
                let s:P1dProj=st_snap(t,j);
                let n0:i32=arm_render_ep(0,&v,s,outs0[j*1024..j*1024+1024]);
                let n1:i32=arm_render_ep(1,&v,s,outs1[j*1024..j*1024+1024]);
                if(n0<0 || n1<0){ pv=pv+1; n0=0; n1=0; }
                fx_iset(lens0,j,n0); fx_iset(lens1,j,n1);
                // invariance 2..4: ledger, memop, refusal — computed per arm, compared
                null_ledger(p,s,led0); null_ledger(p,s,led1);
                let q:i32=0;
                while(q<64){ if(led0[q]!=led1[q]){inv=inv+1;q=64;} q=q+1; }
                j=j+1;
            }
            // invariance 1: verdict bytes unchanged across all 40 renders
            let vb_post:[]u8=nio_alloc(256);
            let npost:i32=phr_verdict_bytes(&v,vb_post);
            if(npre!=npost){ inv=inv+1; }
            else { let q:i32=0; while(q<npre){ if(vb_pre[q]!=vb_post[q]){inv=inv+1;q=npre;} q=q+1; } }
            nio_free(vb_pre); nio_free(vb_post);
            let c0:i32=null_clusters(outs0,20,lens0,reps);
            let c1:i32=null_clusters(outs1,20,lens1,reps);
            dsum=dsum+(((c1-c0) as i64)*FXS)/19;
            p("ARMC_CELL,"); pi(t); p(","); pi(p); p(",nullcl,"); pi(c0 as i64);
            p(",armccl,"); pi(c1 as i64); pn();
            p=p+1;
        }
        det_i64_set(dtraj,t as i32,dsum/40);
        t=t+1;
    }
    // paired deterministic bootstrap: 1000 resamples of the 10 traj means
    let dmean:i64=0; let k:i32=0;
    while(k<10){ dmean=dmean+det_i64_get(dtraj,k); k=k+1; }
    dmean=dmean/10;
    let le:i32=0; let b:i32=0;
    while(b<1000){
        let seed:i64=2654435769*((b+1) as i64);
        let bs:i64=0; let m:i32=0;
        while(m<10){
            seed=plcg_next(seed);
            let idx:i32=(plcg_range(seed,10)) as i32;
            bs=bs+det_i64_get(dtraj,idx);
            m=m+1;
        }
        if(bs<=0){ le=le+1; }
        b=b+1;
    }
    p("ARMC,traj_dmean_fx,"); pi(dmean); p(",boot_le,"); pi(le as i64); p(",boot_n,1000");
    p(",inv_viol,"); pi(inv as i64); p(",pviol,"); pi(pv as i64); pn();
    // audit cost: one 16-word (64-byte) ledger entry per episode, both arms
    let audn:i64=64; let auda:i64=64;
    p("ARMC,AUDIT_BYTES_PER_EP,"); pi(audn); p(","); pi(auda); p(",RATIO,1.00\n");
    nio_free(outs0); nio_free(lens0); nio_free(reps); nio_free(outs1); nio_free(lens1);
    nio_free(led0); nio_free(led1); nio_free(dtraj);
    // pass bar: D>0 at p<0.01 (le<=10), zero invariance violations, zero pviol
    if(le<=10 && inv==0 && pv==0 && dmean>0){ p("ARMC,PASS\n"); return 0; }
    p("ARMC,FAIL\n");
    return 1;
}
// freezencheck: all 200 states = st_snap(0,0); Arm C must render all identically.
fn mode_freezencheck()i32 {
    let outs:[]u8=nio_alloc(200*1024); let lens:[]u8=nio_alloc(200*4); let reps:[]u8=nio_alloc(200*1024);
    let bad:i32=0; let pv:i32=0;
    let p:i64=0;
    while(p<40){
        let v:P1dVerdict=st_probe(p);
        let s:P1dProj=st_snap(0,0);
        let j:i32=0;
        while(j<200){
            let n:i32=pro_render(&v,s,outs[j*1024..j*1024+1024]);
            if(n<0){ pv=pv+1; n=0; }
            fx_iset(lens,j,n);
            j=j+1;
        }
        let c:i32=null_clusters(outs,200,lens,reps);
        p("FREEZE,"); pi(p); p(",clusters,"); pi(c as i64); pn();
        if(c!=1){ bad=bad+1; }
        p=p+1;
    }
    p("FREEZE,badprobes,"); pi(bad as i64); p(",pviol,"); pi(pv as i64); pn();
    nio_free(outs); nio_free(lens); nio_free(reps);
    if(bad==0 && pv==0){ p("FREEZE,PASS\n"); return 0; }
    p("FREEZE,FAIL\n");
    return 1;
}

fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    if(_zag_strcmp(mode,"nullself")==1){ return mode_nullself(); }
    if(_zag_strcmp(mode,"nullonly")==1){ arm_matrix(0,"null"); p("NULLONLY,DONE\n"); return 0; }
    if(_zag_strcmp(mode,"armonly")==1){ arm_matrix(1,"armc"); p("ARMONLY,DONE\n"); return 0; }
    if(_zag_strcmp(mode,"armc")==1){ return mode_armc(); }
    if(_zag_strcmp(mode,"freezencheck")==1){ return mode_freezencheck(); }
    p("NULLRUN,UNKNOWN_MODE\n");
    return 2;
}

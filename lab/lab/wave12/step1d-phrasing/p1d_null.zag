// p1d_null.zag — null baseline: canonical renderer, 40x200 matrix executor,
// diversity metric D, four invariance checks, cost accounting.
// The null renders the verdict through the FIXED canonical indices — a pure
// function of the verdict alone, consulting no state. (Harness.)
// Pure Zag. Zero RNG.
@import("p1d_state.zag")

// null render: template T2, first members everywhere, depth 1 (or 0), no rotation
fn null_render(v:*P1dVerdict,out:[]u8)i32 {
    let d:i64=0; if(v.*.reasons_n>0){d=1;}
    return phr_render_idx(v,2,0,0,0,0,d,0,out);
}
// protected render: snapshots verdict bytes around render(); returns -1 on violation
fn pro_render(v:*P1dVerdict,s:P1dProj,out:[]u8)i32 {
    let vb:[]u8=nio_alloc(256); let vb2:[]u8=nio_alloc(256);
    let n0:i32=phr_verdict_bytes(v,vb);
    let n:i32=phr_render(v,s,out);
    let n1:i32=phr_verdict_bytes(v,vb2);
    let ok:i32=1;
    if(n0!=n1){ok=0;}
    let i:i32=0; while(i<n0 && ok==1){ if(vb[i]!=vb2[i]){ok=0;} i=i+1; }
    nio_free(vb); nio_free(vb2);
    if(ok==0){ return -1; }
    return n;
}
// audit ledger entry: 16 i32 words, canonical layout, from (probe, state) ONLY.
// Identical across arms by construction; the rendering hash lives in the
// choice log, never in the ledger (prereg §11).
fn null_ledger(p:i64,s:P1dProj,w:[]u8)void {
    let v:P1dVerdict=st_probe(p);
    let pb:[]u8=nio_alloc(26); phr_proj_bytes(s,pb);
    let hh:[]u8=nio_alloc(8); let hfull:[]u8=nio_alloc(32);
    ns_sha256(pb,hfull);
    let i:i32=0; while(i<8){hh[i]=hfull[i];i=i+1;}
    let d1:i32=(hfull[0] as i32)|((hfull[1] as i32)<<8)|((hfull[2] as i32)<<16)|((hfull[3] as i32)<<24);
    // op@0, slot@4, rc@8, b1..b5@12..28, a1..a5@32..48, stage@52, d1@56, d2@60
    fx_iset(w,0,v.vclass as i32); fx_iset(w,1,v.slot as i32); fx_iset(w,2,0);
    fx_iset(w,3,0); fx_iset(w,4,0); fx_iset(w,5,0); fx_iset(w,6,0); fx_iset(w,7,0);
    fx_iset(w,8,0); fx_iset(w,9,0); fx_iset(w,10,0); fx_iset(w,11,0);
    fx_iset(w,12,(s.ep&4294967295) as i32);
    fx_iset(w,13,0); fx_iset(w,14,d1); fx_iset(w,15,0);
    nio_free(pb); nio_free(hh); nio_free(hfull);
}
// greedy clustering of n outputs in the flat buffer `outs` (n*1024 bytes,
// lengths in lens[] as i32 LE) -> cluster count. Two outputs share a cluster
// iff NOT plev_distinct (edit floor 1/20). reps is scratch (20*1024 bytes).
fn null_clusters(outs:[]u8,n:i32,lens:[]u8,reps:[]u8)i32 {
    let ncl:i32=0;
    let replen:[]u8=nio_alloc(n*4);
    let i:i32=0;
    while(i<n){
        let li:i32=fx_iget(lens,i);
        let c:i32=0; let found:i32=0;
        while(c<ncl && found==0){
            let lc:i32=fx_iget(replen,c);
            if(li==lc){
                let eq:i32=1; let q:i32=0;
                while(q<li && eq==1){ if(outs[i*1024+q]!=reps[c*1024+q]){eq=0;} q=q+1; }
                if(eq==1){ found=1; }
                else { if(plev_distinct_at(outs,i*1024,li,reps,c*1024,lc)==0){ found=1; } }
            } else {
                if(plev_distinct_at(outs,i*1024,li,reps,c*1024,lc)==0){ found=1; }
            }
            c=c+1;
        }
        if(found==0){
            let q:i32=0; while(q<li){ reps[ncl*1024+q]=outs[i*1024+q]; q=q+1; }
            fx_iset(replen,ncl,li); ncl=ncl+1;
        }
        i=i+1;
    }
    nio_free(replen);
    return ncl;
}
// D = (clusters-1)/19 in fx units
fn null_D_fx(ncl:i32)i64 { return ((ncl-1) as i64*FXS)/19; }

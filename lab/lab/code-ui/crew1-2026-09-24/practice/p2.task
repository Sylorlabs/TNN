ID=p2
UNIT=U2-functions
TITLE=Practice: annotated multiply function
DESC=Write a function times(a, b) with number params and number return.
TPL=fn
FILES=single
PARAMS:
fn=times
params=a: number, b: number
ret=number
body=return a * b;
ENDPARAMS
TESTS:
console.log(times(3, 4));
ENDTESTS
EXPECT:
12
ENDEXPECT

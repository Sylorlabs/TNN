// wallmeta.zag — WALL-RED probe 2: operator-coincidence (HL-13/HL-14 logic).
// For the winning quorum, extracts WREG (registrant email), NS (nameserver),
// IP from META lines; computes email-apex, ns-apex, ip-/24; counts features
// where ALL quorum members share one non-whitelisted value.
// Rule (fable HL-14): overlap>=2 -> BLOCK else INSTALL.
// Usage: wallmeta <case.flat.txt>
// Pure Zag, zero RNG, deterministic.
@import("R33_NATIVE_IO_V1.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

fn next_line(b:[]u8,pos:*i32,ls:*i32,ll:*i32)i32 {
    if(pos[0]>=b.len){return 0;}
    let s:i32=pos[0];
    let e:i32=s;
    while(e<b.len && b[e]!=10){e=e+1;}
    ls[0]=s;
    ll[0]=e-s;
    if(e<b.len){pos[0]=e+1;}else{pos[0]=e;}
    return 1;
}

fn read_file(dir:[]u8,name:[]u8,ok:*i32)[]u8 {
    ok[0]=0;
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){nio_close(fd); return "";}
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){nio_free(buf); return "";}
    ok[0]=1;
    let nn:i32=n as i32;
    return buf[0..nn];
}

fn read_path(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return read_file(".",path,ok);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return read_file(dir,name,ok);
}

fn starts(h:[]u8,pre:[]u8)i32 {
    if(h.len<pre.len){return 0;}
    return nio_equal(h[0..pre.len],pre);
}

fn ends(h:[]u8,suf:[]u8)i32 {
    if(h.len<suf.len){return 0;}
    return nio_equal(h[h.len-suf.len..h.len],suf);
}

fn contains(h:[]u8,n:[]u8)i32 {
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        if(nio_equal(h[i..i+n.len],n)==1){return 1;}
        i=i+1;
    }
    return 0;
}

fn in_q(qv:[]u8,pid:[]u8)i32 {
    if(nio_equal(qv,pid)==1){return 1;}
    if(starts(qv,pid)==1 && qv.len>pid.len && qv[pid.len]==32){return 1;}
    if(ends(qv,pid)==1 && qv.len>pid.len && qv[qv.len-pid.len-1]==32){return 1;}
    let mid:[]u8=nio_alloc(pid.len+2);
    if(mid.len==0){return 0;}
    mid[0]=32;
    let i:i32=0;
    while(i<pid.len){mid[i+1]=pid[i]; i=i+1;}
    mid[pid.len+1]=32;
    let r:i32=contains(qv,mid);
    nio_free(mid);
    return r;
}

// value of KEY= in a META line (fields after pid, '|' separated, KEY=val)
fn mval(ln:[]u8,key:[]u8)[]u8 {
    let pat:[]u8=nio_alloc(key.len+1);
    if(pat.len==0){return "";}
    let i:i32=0;
    while(i<key.len){pat[i]=key[i]; i=i+1;}
    pat[key.len]=61; // '='
    // scan fields
    let f:i32=0;
    let s:i32=0;
    i=0;
    while(i<=ln.len){
        let atend:i32=0;
        if(i==ln.len){atend=1;}
        let isbar:i32=0;
        if(atend==0){
            if(ln[i]==124){isbar=1;}
        }
        if(atend==1 || isbar==1){
            let fld:[]u8=ln[s..i];
            if(fld.len>pat.len && nio_equal(fld[0..pat.len],pat)==1){
                let v:[]u8=fld[pat.len..fld.len];
                nio_free(pat);
                return v;
            }
            s=i+1;
        }
        i=i+1;
    }
    nio_free(pat);
    return "";
}

// last two dot-labels
fn apex2(s:[]u8)[]u8 {
    let last:i32=-1;
    let prev:i32=-1;
    let i:i32=0;
    while(i<s.len){
        if(s[i]==46){prev=last; last=i;}
        i=i+1;
    }
    if(last<0){return s;}
    if(prev<0){return s;}
    return s[prev+1..s.len];
}

fn email_apex(em:[]u8)[]u8 {
    let i:i32=0;
    while(i<em.len && em[i]!=64){i=i+1;}
    if(i>=em.len){return em;}
    return apex2(em[i+1..em.len]);
}

fn ip24(ip:[]u8)[]u8 {
    let dots:i32=0;
    let i:i32=0;
    while(i<ip.len){
        if(ip[i]==46){dots=dots+1;}
        if(dots==3){return ip[0..i];}
        i=i+1;
    }
    return ip;
}

fn whitelisted(v:[]u8)i32 {
    if(nio_equal(v,"cloudflare.com")==1){return 1;}
    if(nio_equal(v,"awsdns-07.net")==1){return 1;}
    if(nio_equal(v,"googledomains.com")==1){return 1;}
    if(nio_equal(v,"gmail.com")==1){return 1;}
    if(nio_equal(v,"outlook.com")==1){return 1;}
    if(nio_equal(v,"google.com")==1){return 1;}
    return 0;
}

fn main()i32 {
    let path:[]u8=_zag_arg(1);
    if(path.len==0){_zag_print("usage: wallmeta <case.flat.txt>\n"); return 2;}
    let ok:i32=0;
    let pok:*i32=&ok;
    let buf:[]u8=read_path(path,pok);
    if(ok==0){_zag_print("ERR|cannot read file\n"); return 1;}

    let casename:[]u8="";
    let quorum:[]u8="";
    let e0:[]u8=""; let e1:[]u8=""; let e2:[]u8=""; let e3:[]u8="";
    let n0:[]u8=""; let n1:[]u8=""; let n2:[]u8=""; let n3:[]u8="";
    let p0:[]u8=""; let p1:[]u8=""; let p2:[]u8=""; let p3:[]u8="";
    let nq:i32=0;

    let pos:i32=0; let ls:i32=0; let ll:i32=0;
    let ppos:*i32=&pos; let pls:*i32=&ls; let pll:*i32=&ll;
    let sect:i32=0;
    while(next_line(buf,ppos,pls,pll)==1){
        let ln:[]u8=buf[ls..ls+ll];
        if(nio_equal(ln,"URLS")==1){sect=1; continue;}
        if(nio_equal(ln,"META")==1){sect=2; continue;}
        if(nio_equal(ln,"ORDER")==1){sect=3; continue;}
        if(nio_equal(ln,"PAGES")==1){sect=4; continue;}
        if(nio_equal(ln,"SNIPPETS")==1){sect=5; continue;}
        if(nio_equal(ln,"HISTORY")==1){sect=6; continue;}
        if(nio_equal(ln,"END")==1){break;}
        if(sect==0){
            if(starts(ln,"CASE|")==1){casename=ln[5..ln.len];}
            if(starts(ln,"QUORUM|")==1){quorum=ln[7..ln.len];}
            continue;
        }
        if(sect==2){
            // pid|T=..|.. fields
            let i:i32=0;
            while(i<ln.len && ln[i]!=124){i=i+1;}
            let pid:[]u8=ln[0..i];
            if(in_q(quorum,pid)==1 && nq<4){
                let w:[]u8=mval(ln,"WREG");
                let ns:[]u8=mval(ln,"NS");
                let ip:[]u8=mval(ln,"IP");
                let ea:[]u8=email_apex(w);
                let na:[]u8=apex2(ns);
                let s24:[]u8=ip24(ip);
                if(nq==0){e0=ea; n0=na; p0=s24;}
                if(nq==1){e1=ea; n1=na; p1=s24;}
                if(nq==2){e2=ea; n2=na; p2=s24;}
                if(nq==3){e3=ea; n3=na; p3=s24;}
                nq=nq+1;
            }
            continue;
        }
    }

    // all-share checks
    let e_all:i32=0;
    let n_all:i32=0;
    let p_all:i32=0;
    if(nq>0){
        e_all=1; n_all=1; p_all=1;
        if(nq>1){
            if(nio_equal(e1,e0)==0){e_all=0;}
            if(nio_equal(n1,n0)==0){n_all=0;}
            if(nio_equal(p1,p0)==0){p_all=0;}
        }
        if(nq>2){
            if(nio_equal(e2,e0)==0){e_all=0;}
            if(nio_equal(n2,n0)==0){n_all=0;}
            if(nio_equal(p2,p0)==0){p_all=0;}
        }
        if(nq>3){
            if(nio_equal(e3,e0)==0){e_all=0;}
            if(nio_equal(n3,n0)==0){n_all=0;}
            if(nio_equal(p3,p0)==0){p_all=0;}
        }
    }
    let e_ov:i32=0;
    let n_ov:i32=0;
    let p_ov:i32=0;
    if(e_all==1 && e0.len>0 && whitelisted(e0)==0){e_ov=1;}
    if(n_all==1 && n0.len>0 && whitelisted(n0)==0){n_ov=1;}
    if(p_all==1 && p0.len>0){p_ov=1;}
    let overlap:i32=e_ov+n_ov+p_ov;

    _zag_print("METAQ|");
    _zag_print(casename);
    _zag_print("|quorum=");
    _zag_print(i64s(nq as i64));
    _zag_print("|wreg_apex=");
    _zag_print(e0);
    _zag_print("/");
    _zag_print(i64s(e_ov as i64));
    _zag_print("|ns_apex=");
    _zag_print(n0);
    _zag_print("/");
    _zag_print(i64s(n_ov as i64));
    _zag_print("|ip24=");
    _zag_print(p0);
    _zag_print("/");
    _zag_print(i64s(p_ov as i64));
    _zag_print("|overlap=");
    _zag_print(i64s(overlap as i64));
    if(overlap>=2){
        _zag_print("|VERDICT=BLOCK\n");
    } else {
        _zag_print("|VERDICT=INSTALL\n");
    }
    return 0;
}

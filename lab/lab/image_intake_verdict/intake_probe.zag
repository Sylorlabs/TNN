// intake_probe.zag — INTAKE-ONLY fidelity probe (input verdict 2026-09-26).
//
// Runs ONLY the image intake machinery (the raw BMP read path copied
// VERBATIM from image_exact_work/v3/ingest.zag, the authoritative intake),
// then writes the held `pix` buffer back out via common.zag's bmp_write.
// No knowledge machinery, no quadtree, no motifs — this measures what
// TNN's intake HOLDS, isolated from everything downstream.
//
// argv: 1=in.bmp 2=out.bmp
// stdout: w x h, fnv1a-64 of held pix buffer, rc.
@import("./common.zag")

fn fnv1a(b:[]u8) i64 {
    let h:i64 = -3750763034362895579;
    let i:i64 = 0;
    while (i < b.len) {
        h = h ^ (b[i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

fn main() i32 {
    let inname:[]u8 = _zag_arg(1);
    let outname:[]u8 = _zag_arg(2);
    if (_zag_strcmp(inname, "") == 1) { _zag_println("need in.bmp"); return 1; }
    if (_zag_strcmp(outname, "") == 1) { _zag_println("need out.bmp"); return 1; }

    let root:i64 = nio_open_root(".");
    if (root < 0) { _zag_println("cannot open cwd root"); return 1; }

    // ---- INTAKE: VERBATIM from v3/ingest.zag (byte-level, no external decoder) ----
    let fd:i64 = nio_open_child(root, inname, 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    if (nio_regular(fd) != 1) { _zag_println("input not regular"); nio_close(fd); nio_close(root); return 1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { _zag_println("short file"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[0] != 66) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[1] != 77) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    let bpp:i64 = r_u16le(fbuf, 28);
    let comp:i64 = r_u32le(fbuf, 30);
    if (bpp != 24) { _zag_println("need 24bpp"); nio_free(fbuf); nio_close(root); return 1; }
    if (comp != 0) { _zag_println("need uncompressed"); nio_free(fbuf); nio_close(root); return 1; }
    if (w < 1) { _zag_println("bad w"); nio_free(fbuf); nio_close(root); return 1; }
    if (h < 1) { _zag_println("bad h"); nio_free(fbuf); nio_close(root); return 1; }
    if (w * h > 400000) { _zag_println("too big"); nio_free(fbuf); nio_close(root); return 1; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    if (off + stride * h > n) { _zag_println("truncated pixels"); nio_free(fbuf); nio_close(root); return 1; }
    let npix:i64 = w * h;
    let pix:[]u8 = nio_alloc((npix * 3) as i32);
    if (pix.len == 0) { _zag_println("alloc pix failed"); nio_free(fbuf); nio_close(root); return 1; }
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            pix[p] = fbuf[q + 2];
            pix[p + 1] = fbuf[q + 1];
            pix[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    // ---- END OF VERBATIM INTAKE. `pix` is exactly what TNN's intake holds. ----

    _zag_print("held w=");
    _zag_print(_zag_i64_to_str(w));
    _zag_print(" h=");
    _zag_print(_zag_i64_to_str(h));
    _zag_print(" npix=");
    _zag_print(_zag_i64_to_str(npix));
    _zag_print(" fnv1a=");
    _zag_println(_zag_i64_to_str(fnv1a(pix)));

    let rc:i64 = bmp_write(root, outname, pix, w, h);
    nio_close(root);
    if (rc != 0) { _zag_println("write failed"); return 1; }
    _zag_println("probe ok");
    return 0;
}

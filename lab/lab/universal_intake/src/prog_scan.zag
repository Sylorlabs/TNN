// Progressive JPEG scan decoders (pure Zag).
// These implement T.81 Annex G: spectral selection + successive approximation.
// Proven against libjpeg ground truth (0 coefficient mismatches on 3 fixtures).

// Correction bit for AC refinement (libjpeg jdphuff.c decode_mcu_AC_refine).
// coff = cbase[ci] + bi*64 (precomputed block base). k = spectral position.
fn jpg_corr(scanview: []u8, st: []i64, coef: []i64, coff: i64, k: i64, p1: i64, m1: i64) i64 {
    let zz: i64 = zag_zig(k);
    let v: i64 = coef[coff + zz];
    if (v != 0) {
        let bit: i64 = jpg_take(scanview, st, 1);
        if (bit < 0) { return -1; }
        if (bit == 1) {
            if ((v & p1) == 0) {
                if (v > 0) { coef[coff + zz] = v + p1; }
                else { coef[coff + zz] = v + m1; }
            }
        }
    }
    return 0;
}

// DC first scan (Ss=0,Se=0,Ah=0). sci/std: comp indices and DC table nos (len ncs).
fn jpg_scan_dc_first(scanview: []u8, st: []i64, dc_tree: []i64,
                     coef: []i64, cbase: []i64, nblk: []i64, pred: []i64,
                     sci: []i64, std: []i64, ncs: i64,
                     hsamp: []i64, vsamp: []i64, mcu_w: i64, mcu_h: i64,
                     al: i64) i64 {
    if (ncs > 1) {
        let my: i64 = 0;
        while (my < mcu_h) {
            let mx: i64 = 0;
            while (mx < mcu_w) {
                let j: i64 = 0;
                while (j < ncs) {
                    let ci: i64 = sci[j];
                    let td: i64 = std[j];
                    let by: i64 = 0;
                    while (by < vsamp[ci]) {
                        let bx: i64 = 0;
                        while (bx < hsamp[ci]) {
                            let bi: i64 = (my * vsamp[ci] + by) * (mcu_w * hsamp[ci]) + (mx * hsamp[ci] + bx);
                            let s: i64 = jpg_huff(scanview, st, dc_tree, td);
                            if (s < 0) { return -1; }
                            let diff: i64 = 0;
                            if (s > 0) {
                                let bits: i64 = jpg_take(scanview, st, s);
                                if (bits < 0) { return -1; }
                                diff = jpg_extend(bits, s);
                            }
                            pred[ci] = pred[ci] + diff;
                            coef[cbase[ci] + bi * 64] = pred[ci] << al;
                            // restart: reset predictors
                            if (st[4] != 0) {
                                let rj: i64 = 0;
                                while (rj < ncs) { pred[sci[rj]] = 0; rj = rj + 1; }
                                st[4] = 0;
                            }
                            bx = bx + 1;
                        }
                        by = by + 1;
                    }
                    j = j + 1;
                }
                mx = mx + 1;
            }
            my = my + 1;
        }
    } else {
        let ci: i64 = sci[0];
        let td: i64 = std[0];
        let bi: i64 = 0;
        while (bi < nblk[ci]) {
            let s: i64 = jpg_huff(scanview, st, dc_tree, td);
            if (s < 0) { return -1; }
            let diff: i64 = 0;
            if (s > 0) {
                let bits: i64 = jpg_take(scanview, st, s);
                if (bits < 0) { return -1; }
                diff = jpg_extend(bits, s);
            }
            pred[ci] = pred[ci] + diff;
            coef[cbase[ci] + bi * 64] = pred[ci] << al;
            if (st[4] != 0) { pred[ci] = 0; st[4] = 0; }
            bi = bi + 1;
        }
    }
    return 0;
}

// DC refinement scan (Ss=0,Se=0,Ah>0). Bit Al ORed directly into DC coeff.
fn jpg_scan_dc_refine(scanview: []u8, st: []i64,
                      coef: []i64, cbase: []i64, nblk: []i64,
                      sci: []i64, ncs: i64,
                      hsamp: []i64, vsamp: []i64, mcu_w: i64, mcu_h: i64,
                      al: i64) i64 {
    let p1: i64 = 1 << al;
    if (ncs > 1) {
        let my: i64 = 0;
        while (my < mcu_h) {
            let mx: i64 = 0;
            while (mx < mcu_w) {
                let j: i64 = 0;
                while (j < ncs) {
                    let ci: i64 = sci[j];
                    let by: i64 = 0;
                    while (by < vsamp[ci]) {
                        let bx: i64 = 0;
                        while (bx < hsamp[ci]) {
                            let bi: i64 = (my * vsamp[ci] + by) * (mcu_w * hsamp[ci]) + (mx * hsamp[ci] + bx);
                            let bit: i64 = jpg_take(scanview, st, 1);
                            if (bit < 0) { return -1; }
                            if (bit == 1) {
                                let o: i64 = cbase[ci] + bi * 64;
                                coef[o] = coef[o] | p1;
                            }
                            bx = bx + 1;
                        }
                        by = by + 1;
                    }
                    j = j + 1;
                }
                mx = mx + 1;
            }
            my = my + 1;
        }
    } else {
        let ci: i64 = sci[0];
        let bi: i64 = 0;
        while (bi < nblk[ci]) {
            let bit: i64 = jpg_take(scanview, st, 1);
            if (bit < 0) { return -1; }
            if (bit == 1) {
                let o: i64 = cbase[ci] + bi * 64;
                coef[o] = coef[o] | p1;
            }
            bi = bi + 1;
        }
    }
    return 0;
}

// AC first scan (Ah=0, single component). Spectral band ss..se.
fn jpg_scan_ac_first(scanview: []u8, st: []i64, ac_tree: []i64,
                     coef: []i64, cbase: []i64, nblk: []i64,
                     ci: i64, ta: i64, ss: i64, se: i64, al: i64) i64 {
    let eobrun: i64 = 0;
    let bi: i64 = 0;
    while (bi < nblk[ci]) {
        if (eobrun > 0) {
            eobrun = eobrun - 1;
        } else {
            let k: i64 = ss;
            while (k <= se) {
                let rs: i64 = jpg_huff(scanview, st, ac_tree, ta);
                if (rs < 0) { return -1; }
                let r: i64 = rs >> 4;
                let s: i64 = rs & 15;
                if (s != 0) {
                    k = k + r;
                    if (k > se) { return -1; }
                    let av: i64 = jpg_take(scanview, st, s);
                    if (av < 0) { return -1; }
                    let v: i64 = jpg_extend(av, s);
                    coef[cbase[ci] + bi * 64 + zag_zig(k)] = v << al;
                    k = k + 1;
                } else if (r == 15) {
                    k = k + 16;
                } else {
                    eobrun = 1 << r;
                    if (r > 0) {
                        let ext: i64 = jpg_take(scanview, st, r);
                        if (ext < 0) { return -1; }
                        eobrun = eobrun + ext;
                    }
                    eobrun = eobrun - 1;
                    k = se + 1;
                }
            }
        }
        // restart: reset EOB run
        if (st[4] != 0) { eobrun = 0; st[4] = 0; }
        bi = bi + 1;
    }
    return 0;
}

// AC refinement scan (Ah>0, single component). Spectral band ss..se.
fn jpg_scan_ac_refine(scanview: []u8, st: []i64, ac_tree: []i64,
                      coef: []i64, cbase: []i64, nblk: []i64,
                      ci: i64, ta: i64, ss: i64, se: i64, al: i64) i64 {
    let p1: i64 = 1 << al;
    let m1: i64 = 0 - p1;
    let eobrun: i64 = 0;
    let bi: i64 = 0;
    while (bi < nblk[ci]) {
        let coff: i64 = cbase[ci] + bi * 64;
        if (eobrun > 0) {
            eobrun = eobrun - 1;
            let k: i64 = ss;
            while (k <= se) {
                if (jpg_corr(scanview, st, coef, coff, k, p1, m1) < 0) { return -1; }
                k = k + 1;
            }
        } else {
            let k: i64 = ss;
            while (k <= se) {
                let rs: i64 = jpg_huff(scanview, st, ac_tree, ta);
                if (rs < 0) { return -1; }
                let r: i64 = rs >> 4;
                let s: i64 = rs & 15;
                if (s != 0) {
                    // new nonzero: sign bit FIRST, then skip r ZEROS
                    let b: i64 = jpg_take(scanview, st, 1);
                    if (b < 0) { return -1; }
                    let newval: i64 = p1;
                    if (b == 0) { newval = m1; }
                    // do-while: advance over nonzeros (correct) and r zeros
                    while (1 == 1) {
                        let zz: i64 = zag_zig(k);
                        let v: i64 = coef[coff + zz];
                        if (v != 0) {
                            if (jpg_corr(scanview, st, coef, coff, k, p1, m1) < 0) { return -1; }
                        } else {
                            r = r - 1;
                            if (r < 0) { break; }
                        }
                        k = k + 1;
                        if (k > se) { break; }
                    }
                    if (k <= se) {
                        coef[coff + zag_zig(k)] = newval;
                    }
                    k = k + 1;
                } else if (r == 15) {
                    // ZRL: skip 16 zeros
                    while (1 == 1) {
                        let zz: i64 = zag_zig(k);
                        let v: i64 = coef[coff + zz];
                        if (v != 0) {
                            if (jpg_corr(scanview, st, coef, coff, k, p1, m1) < 0) { return -1; }
                        } else {
                            r = r - 1;
                            if (r < 0) { break; }
                        }
                        k = k + 1;
                        if (k > se) { break; }
                    }
                    k = k + 1;
                } else {
                    // EOBr: run covers current + following blocks
                    eobrun = 1 << r;
                    if (r > 0) {
                        let ext: i64 = jpg_take(scanview, st, r);
                        if (ext < 0) { return -1; }
                        eobrun = eobrun + ext;
                    }
                    let kk: i64 = k;
                    while (kk <= se) {
                        if (jpg_corr(scanview, st, coef, coff, kk, p1, m1) < 0) { return -1; }
                        kk = kk + 1;
                    }
                    eobrun = eobrun - 1;
                    k = se + 1;
                }
            }
        }
        // restart: reset EOB run
        if (st[4] != 0) { eobrun = 0; st[4] = 0; }
        bi = bi + 1;
    }
    return 0;
}

@import("R33_NATIVE_SHA256_V2.zag")

// PROSE-LEARN: prose-consuming TNN learner, frozen PREREG.md mechanism.
// argv[1] = source name (grok|sol|step|muse-native). Reads inputs/train_<s>.txt,
// inputs/test_<s>.txt, inputs/false_ids_<s>.txt relative to CWD.
// Pure Zag, zero RNG. All tables are []u8 arenas with explicit put/get32
// (znc ZNC-2026-09-21-007: never `as []i32` for indexed tables).

// ---------------- byte helpers ----------------
fn is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn p64(b:[]u8,at:i32,v:i64)void {
    p32(b,at,v&4294967295);
    p32(b,at+4,(v>>32)&4294967295);
    return;
}
fn g64(b:[]u8,at:i32)i64 {
    return g32(b,at)|(g32(b,at+4)<<32);
}
// byte equality: buf[off..off+len) vs literal
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
// byte equality between two buffers
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn parse_int(b:[]u8,off:i32,len:i32)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<len){
        let c:u8=b[off+i];
        if(c>=48 && c<=57){v=v*10+((c as i64)-48);}
        i=i+1;
    }
    return v;
}
fn mkpath(a:[]u8,b:[]u8,c:[]u8)[]u8 {
    let n:i32=a.len+b.len+c.len;
    let o:[]u8=nio_alloc(n);
    copy_bytes(o,0,a,0,a.len);
    copy_bytes(o,a.len,b,0,b.len);
    copy_bytes(o,a.len+b.len,c,0,c.len);
    return o;
}

// ---------------- printing ----------------
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
// decimal of v into buf (needs >=24 bytes); returns length
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    prlen(b,n);
    nio_free(b);
    return;
}
fn prhex(b:[]u8,off:i32,len:i32)void {
    let hb:[]u8=nio_alloc(len*2+1);
    let dg:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<len){
        let v:i32=b[off+i] as i32;
        hb[2*i]=dg[v/16];
        hb[2*i+1]=dg[v%16];
        i=i+1;
    }
    prlen(hb,len*2);
    nio_free(hb);
    return;
}

// ---------------- file IO (raw syscalls) ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}

// ---------------- arena helpers ----------------
// arena layout: [0..4) = used-bytes counter; data from 4 (linka/keya) or 8 (vocab).
fn arena_append(a:[]u8,v:i64)void {
    let u:i32=g32(a,0) as i32;
    p32(a,u,v);
    p32(a,0,(u+4) as i64);
    return;
}

// ---------------- vocab ----------------
// vbytes: [0..4)=used (starts 8); vent: [0..4)=n, entries at 8+8*i: off,len.
fn v_intern(vbytes:[]u8,vent:[]u8,sb:[]u8,so:i32,sl:i32)i32 {
    let n:i32=g32(vent,0) as i32;
    let i:i32=0;
    while(i<n){
        let eo:i32=g32(vent,8+8*i) as i32;
        let el:i32=g32(vent,8+8*i+4) as i32;
        if(el==sl){
            if(beq2(sb,so,vbytes,eo,sl)==1){return i;}
        }
        i=i+1;
    }
    let used:i32=g32(vbytes,0) as i32;
    copy_bytes(vbytes,used,sb,so,sl);
    p32(vbytes,0,(used+sl) as i64);
    p32(vent,8+8*n,used as i64);
    p32(vent,8+8*n+4,sl as i64);
    p32(vent,0,(n+1) as i64);
    return n;
}

// ---------------- stopwords (frozen list; matched on RAW token, before stemming) ----------------
fn is_stop(sb:[]u8,so:i32,sl:i32)i32 {
    if(beq(sb,so,sl,"the")==1){return 1;}
    if(beq(sb,so,sl,"an")==1){return 1;}
    if(beq(sb,so,sl,"of")==1){return 1;}
    if(beq(sb,so,sl,"in")==1){return 1;}
    if(beq(sb,so,sl,"is")==1){return 1;}
    if(beq(sb,so,sl,"are")==1){return 1;}
    if(beq(sb,so,sl,"was")==1){return 1;}
    if(beq(sb,so,sl,"were")==1){return 1;}
    if(beq(sb,so,sl,"be")==1){return 1;}
    if(beq(sb,so,sl,"been")==1){return 1;}
    if(beq(sb,so,sl,"what")==1){return 1;}
    if(beq(sb,so,sl,"which")==1){return 1;}
    if(beq(sb,so,sl,"that")==1){return 1;}
    if(beq(sb,so,sl,"this")==1){return 1;}
    if(beq(sb,so,sl,"these")==1){return 1;}
    if(beq(sb,so,sl,"those")==1){return 1;}
    if(beq(sb,so,sl,"it")==1){return 1;}
    if(beq(sb,so,sl,"its")==1){return 1;}
    if(beq(sb,so,sl,"do")==1){return 1;}
    if(beq(sb,so,sl,"does")==1){return 1;}
    if(beq(sb,so,sl,"did")==1){return 1;}
    if(beq(sb,so,sl,"have")==1){return 1;}
    if(beq(sb,so,sl,"has")==1){return 1;}
    if(beq(sb,so,sl,"had")==1){return 1;}
    if(beq(sb,so,sl,"there")==1){return 1;}
    if(beq(sb,so,sl,"and")==1){return 1;}
    if(beq(sb,so,sl,"or")==1){return 1;}
    if(beq(sb,so,sl,"to")==1){return 1;}
    if(beq(sb,so,sl,"for")==1){return 1;}
    if(beq(sb,so,sl,"with")==1){return 1;}
    if(beq(sb,so,sl,"at")==1){return 1;}
    if(beq(sb,so,sl,"by")==1){return 1;}
    if(beq(sb,so,sl,"from")==1){return 1;}
    if(beq(sb,so,sl,"as")==1){return 1;}
    if(beq(sb,so,sl,"on")==1){return 1;}
    if(beq(sb,so,sl,"how")==1){return 1;}
    if(beq(sb,so,sl,"many")==1){return 1;}
    if(beq(sb,so,sl,"much")==1){return 1;}
    if(beq(sb,so,sl,"when")==1){return 1;}
    if(beq(sb,so,sl,"where")==1){return 1;}
    if(beq(sb,so,sl,"s")==1){return 1;}
    return 0;
}

// ---------------- number lexicon ----------------
// digit token: ^(\d+)(st|nd|rd|th)?$ -> integer; else -1. Token is lowercased.
fn digit_val(sb:[]u8,so:i32,sl:i32)i64 {
    // length of the leading digit run
    let i:i32=0;
    let go:i32=1;
    while(go==1){
        if(i>=sl){go=0;}
        else{
            let c3:u8=sb[so+i];
            if(c3>=48 && c3<=57){i=i+1;}
            else{go=0;}
        }
    }
    if(i==0){return -1;}
    let rest:i32=sl-i;
    if(rest!=0){
        if(rest!=2){return -1;}
        let s0:u8=sb[so+i];
        let s1:u8=sb[so+i+1];
        let ok:i32=0;
        if(s0==115 && s1==116){ok=1;}
        if(s0==110 && s1==100){ok=1;}
        if(s0==114 && s1==100){ok=1;}
        if(s0==116 && s1==104){ok=1;}
        if(ok==0){return -1;}
    }
    let v:i64=0;
    let j:i32=0;
    while(j<i){
        let d:i64=(sb[so+j] as i64)-48;
        v=v*10+d;
        j=j+1;
    }
    return v;
}

// cardinal words one..thirty and ordinal words first..thirtieth -> value; else -1.
fn numword_val(sb:[]u8,so:i32,sl:i32)i64 {
    if(beq(sb,so,sl,"one")==1){return 1;}
    if(beq(sb,so,sl,"two")==1){return 2;}
    if(beq(sb,so,sl,"three")==1){return 3;}
    if(beq(sb,so,sl,"four")==1){return 4;}
    if(beq(sb,so,sl,"five")==1){return 5;}
    if(beq(sb,so,sl,"six")==1){return 6;}
    if(beq(sb,so,sl,"seven")==1){return 7;}
    if(beq(sb,so,sl,"eight")==1){return 8;}
    if(beq(sb,so,sl,"nine")==1){return 9;}
    if(beq(sb,so,sl,"ten")==1){return 10;}
    if(beq(sb,so,sl,"eleven")==1){return 11;}
    if(beq(sb,so,sl,"twelve")==1){return 12;}
    if(beq(sb,so,sl,"thirteen")==1){return 13;}
    if(beq(sb,so,sl,"fourteen")==1){return 14;}
    if(beq(sb,so,sl,"fifteen")==1){return 15;}
    if(beq(sb,so,sl,"sixteen")==1){return 16;}
    if(beq(sb,so,sl,"seventeen")==1){return 17;}
    if(beq(sb,so,sl,"eighteen")==1){return 18;}
    if(beq(sb,so,sl,"nineteen")==1){return 19;}
    if(beq(sb,so,sl,"twenty")==1){return 20;}
    if(beq(sb,so,sl,"thirty")==1){return 30;}
    if(beq(sb,so,sl,"first")==1){return 1;}
    if(beq(sb,so,sl,"second")==1){return 2;}
    if(beq(sb,so,sl,"third")==1){return 3;}
    if(beq(sb,so,sl,"fourth")==1){return 4;}
    if(beq(sb,so,sl,"fifth")==1){return 5;}
    if(beq(sb,so,sl,"sixth")==1){return 6;}
    if(beq(sb,so,sl,"seventh")==1){return 7;}
    if(beq(sb,so,sl,"eighth")==1){return 8;}
    if(beq(sb,so,sl,"ninth")==1){return 9;}
    if(beq(sb,so,sl,"tenth")==1){return 10;}
    if(beq(sb,so,sl,"eleventh")==1){return 11;}
    if(beq(sb,so,sl,"twelfth")==1){return 12;}
    if(beq(sb,so,sl,"thirteenth")==1){return 13;}
    if(beq(sb,so,sl,"fourteenth")==1){return 14;}
    if(beq(sb,so,sl,"fifteenth")==1){return 15;}
    if(beq(sb,so,sl,"sixteenth")==1){return 16;}
    if(beq(sb,so,sl,"seventeenth")==1){return 17;}
    if(beq(sb,so,sl,"eighteenth")==1){return 18;}
    if(beq(sb,so,sl,"nineteenth")==1){return 19;}
    if(beq(sb,so,sl,"twentieth")==1){return 20;}
    if(beq(sb,so,sl,"thirtieth")==1){return 30;}
    return -1;
}

// ---------------- stemmer (frozen, first-match-wins, single pass) ----------------
fn ends_with(b:[]u8,len:i32,suf:[]u8)i32 {
    if(len<suf.len){return 0;}
    return beq2(b,len-suf.len,suf,0,suf.len);
}
fn stem_inplace(b:[]u8,len:i32)i32 {
    if(ends_with(b,len,"ies")==1){
        b[len-3]=121;
        return len-2;
    }
    if(ends_with(b,len,"ication")==1){
        b[len-7]=105;
        b[len-6]=115;
        b[len-5]=104;
        return len-4;
    }
    if(ends_with(b,len,"ished")==1){
        b[len-5]=105;
        b[len-4]=115;
        b[len-3]=104;
        return len-2;
    }
    if(ends_with(b,len,"ic")==1 && len>5){return len-2;}
    if(ends_with(b,len,"ed")==1 && len>4){return len-2;}
    if(ends_with(b,len,"ches")==1){return len-2;}
    if(ends_with(b,len,"shes")==1){return len-2;}
    if(ends_with(b,len,"sses")==1){return len-2;}
    if(ends_with(b,len,"xes")==1){return len-2;}
    if(ends_with(b,len,"zes")==1){return len-2;}
    if(ends_with(b,len,"s")==1 && len>3 && ends_with(b,len,"ss")==0){return len-1;}
    return len;
}

// ---------------- sentence pipeline ----------------
// st layout (40B): [0..4)ntok [4..8)ndig [8..12)nword [12..20)lastdig
//                 [20..28)lastword [28..32)nkey [32..36)trlen
// out layout (48B): [0..4)link_off [4..8)link_len [8..12)key_off [12..16)key_len
//                   [16..24)value [24..28)ok [28..32)ntok [32..36)ndig
//                   [36..40)nword [40..44)trlen
// tmp: lowercased token bytes; kid: key-id scratch (nkey*4); trb: trace buffer.
fn proc_token(vbytes:[]u8,vent:[]u8,tmp:[]u8,tlen:i32,kid:[]u8,linka:[]u8,trb:[]u8,st:[]u8)void {
    let dv:i64=digit_val(tmp,0,tlen);
    let cls:i32=0;
    let cval:i64=0;
    if(dv>=0){cls=1;cval=dv;}
    if(cls==0){
        let nv:i64=numword_val(tmp,0,tlen);
        if(nv>=0){cls=2;cval=nv;}
    }
    // LINK: intern raw token form
    let uid:i32=v_intern(vbytes,vent,tmp,0,tlen);
    arena_append(linka,uid as i64);
    p32(st,0,g32(st,0)+1);
    // extraction trace: token bytes + ','
    let trl:i32=g32(st,32) as i32;
    copy_bytes(trb,trl,tmp,0,tlen);
    trb[trl+tlen]=44;
    p32(st,32,(trl+tlen+1) as i64);
    if(cls==1){
        p32(st,4,g32(st,4)+1);
        p64(st,12,cval);
        return;
    }
    if(cls==2){
        p32(st,8,g32(st,8)+1);
        p64(st,20,cval);
        return;
    }
    if(is_stop(tmp,0,tlen)==1){return;}
    let sl:i32=stem_inplace(tmp,tlen);
    let sid:i32=v_intern(vbytes,vent,tmp,0,sl);
    let nkey:i32=g32(st,28) as i32;
    let f:i32=0;
    let q:i32=0;
    while(q<nkey){
        if(g32(kid,q*4)==(sid as i64)){f=1;}
        q=q+1;
    }
    if(f==0){
        p32(kid,nkey*4,sid as i64);
        p32(st,28,(nkey+1) as i64);
    }
    return;
}

fn proc_sentence(vbytes:[]u8,vent:[]u8,sbuf:[]u8,soff:i32,slen:i32,tmp:[]u8,kid:[]u8,linka:[]u8,keya:[]u8,trb:[]u8,st:[]u8,out:[]u8)i64 {
    let link_off:i32=g32(linka,0) as i32;
    let i:i32=0;
    while(i<slen){
        if(is_alnum(sbuf[soff+i])==1){
            let j:i32=i;
            let go:i32=1;
            while(go==1){
                if(j<slen && is_alnum(sbuf[soff+j])==1){j=j+1;}
                else{go=0;}
            }
            let tlen:i32=j-i;
            let k:i32=0;
            while(k<tlen){
                tmp[k]=to_low(sbuf[soff+i+k]);
                k=k+1;
            }
            proc_token(vbytes,vent,tmp,tlen,kid,linka,trb,st);
            i=j;
        }
        else{i=i+1;}
    }
    let nkey:i32=g32(st,28) as i32;
    // insertion sort kid[0..nkey)
    let a2:i32=1;
    while(a2<nkey){
        let v2:i64=g32(kid,a2*4);
        let b2:i32=a2-1;
        let dn:i32=0;
        while(dn==0){
            if(b2<0){dn=1;}
            else{
                if(g32(kid,b2*4)<=v2){dn=1;}
                else{
                    p32(kid,(b2+1)*4,g32(kid,b2*4));
                    b2=b2-1;
                }
            }
        }
        p32(kid,(b2+1)*4,v2);
        a2=a2+1;
    }
    let key_off:i32=g32(keya,0) as i32;
    let q2:i32=0;
    while(q2<nkey){
        arena_append(keya,g32(kid,q2*4));
        q2=q2+1;
    }
    let link_used:i32=g32(linka,0) as i32;
    let link_len:i32=(link_used-link_off)/4;
    // frozen value scan: last digit-token value; else last number-word value
    let ndig:i32=g32(st,4) as i32;
    let nword:i32=g32(st,8) as i32;
    let ok:i64=0;
    let val:i64=0;
    if(ndig>0){ok=1;val=g64(st,12);}
    else{
        if(nword>0){ok=1;val=g64(st,20);}
    }
    p32(out,0,link_off as i64);
    p32(out,4,link_len as i64);
    p32(out,8,key_off as i64);
    p32(out,12,nkey as i64);
    p64(out,16,val);
    p32(out,24,ok);
    p32(out,28,g32(st,0));
    p32(out,32,g32(st,4));
    p32(out,36,g32(st,8));
    p32(out,40,g32(st,32));
    return ok;
}

// Jaccard packed score: inter in high 32, union in low 32. Compares by cross-multiplication.
fn jscore(kid:[]u8,plen:i32,keya:[]u8,fko:i32,fkl:i32)i64 {
    let a:i32=0;
    let b:i32=0;
    let inter:i32=0;
    let go:i32=1;
    while(go==1){
        if(a>=plen || b>=fkl){go=0;}
        else{
            let x:i64=g32(kid,a*4);
            let y:i64=g32(keya,fko+b*4);
            if(x==y){inter=inter+1;a=a+1;b=b+1;}
            else{
                if(x<y){a=a+1;}
                else{b=b+1;}
            }
        }
    }
    let union:i32=plen+fkl-inter;
    return ((inter as i64)<<32)|(union as i64);
}
fn is_false(fids:[]u8,n:i32,id:i64)i32 {
    let i:i32=0;
    while(i<n){
        if(g32(fids,i*4)==id){return 1;}
        i=i+1;
    }
    return 0;
}

// ---------------- main ----------------
fn zero40(st:[]u8)void {
    let c:i32=0;
    while(c<40){st[c]=0;c=c+1;}
    return;
}

fn main()i32 {
    let src:[]u8=_zag_arg(1);
    if(src.len==0){
        prl("usage: prose_learn <source>   (grok|sol|step|muse-native)");
        return 2;
    }
    let tp:[]u8=mkpath("inputs/train_",src,".txt");
    let ep:[]u8=mkpath("inputs/test_",src,".txt");
    let fp:[]u8=mkpath("inputs/false_ids_",src,".txt");
    let train:[]u8=read_all(tp);
    let test:[]u8=read_all(ep);
    let fib:[]u8=read_all(fp);
    nio_free(tp); nio_free(ep); nio_free(fp);
    if(train.len==0 || test.len==0 || fib.len==0){
        prl("input read failed (run from the prose-learning dir)");
        return 2;
    }
    // arenas
    let vbytes:[]u8=nio_alloc(262144);
    let vent:[]u8=nio_alloc(8+8*4096);
    p32(vbytes,0,8); p32(vent,0,0);
    let linka:[]u8=nio_alloc(65536); p32(linka,0,4);
    let keya:[]u8=nio_alloc(131072); p32(keya,0,4);
    let fm:[]u8=nio_alloc(4+32*256); p32(fm,0,0);
    let kha:[]u8=nio_alloc(32*256);
    let enta:[]u8=nio_alloc(32*256);
    let s2i:[]u8=nio_alloc(4*256);
    let s2v:[]u8=nio_alloc(4*256);
    let tline:[]u8=nio_alloc(8*240);
    let tmp:[]u8=nio_alloc(256);
    let kid:[]u8=nio_alloc(64*4);
    let trb:[]u8=nio_alloc(2048);
    let st:[]u8=nio_alloc(40);
    let out:[]u8=nio_alloc(48);
    let lprev:[]u8=nio_alloc(32);
    let zi:i32=0;
    while(zi<32){lprev[zi]=0;zi=zi+1;}

    pr("PROSE-LEARN source=");
    pr(src);
    prl("");

    // ---- (a) ingest training sentences ----
    let ntrain:i32=0;
    let extract_ok:i32=0;
    let seq:i64=0;
    let ti:i32=0;
    let tlen:i32=train.len;
    while(ti<tlen){
        let le:i32=ti;
        let go:i32=1;
        while(go==1){
            if(le>=tlen || train[le]==10){go=0;}
            else{le=le+1;}
        }
        let tab:i32=ti;
        let go2:i32=1;
        while(go2==1){
            if(tab>=le || train[tab]==9){go2=0;}
            else{tab=tab+1;}
        }
        let fid:i64=parse_int(train,ti,tab-ti);
        let soff:i32=tab+1;
        let slen:i32=le-soff;
        if(slen>0 && train[soff+slen-1]==13){slen=slen-1;}
        if(fid<0 || fid>=240){
            prl("INTERNAL: train id out of range");
            return 3;
        }
        p32(tline,(fid as i32)*8,soff as i64);
        p32(tline,(fid as i32)*8+4,slen as i64);
        zero40(st);
        let ok:i64=proc_sentence(vbytes,vent,train,soff,slen,tmp,kid,linka,keya,trb,st,out);
        ntrain=ntrain+1;
        if(ok==1){
            extract_ok=extract_ok+1;
            let val:i64=g64(out,16);
            let klo:i32=g32(out,8) as i32;
            let kln:i32=g32(out,12) as i32;
            if(kln<1){
                prl("INTERNAL: empty train key");
                return 3;
            }
            // key_hash = sha256(sorted key u32LEs)
            let khin:[]u8=nio_alloc(kln*4);
            let qi:i32=0;
            while(qi<kln){
                p32(khin,qi*4,g32(keya,klo+qi*4));
                qi=qi+1;
            }
            let kh:[]u8=nio_alloc(32);
            if(ns_sha256(khin,kh)!=0){
                prl("sha256 failed");
                return 3;
            }
            nio_free(khin);
            // ledger entry = sha256(prev || seq u64 || fact_id u32 || key_hash || value u64)
            let ein:[]u8=nio_alloc(84);
            copy_bytes(ein,0,lprev,0,32);
            p64(ein,32,seq);
            p32(ein,40,fid);
            copy_bytes(ein,44,kh,0,32);
            p64(ein,76,val);
            let eout:[]u8=nio_alloc(32);
            if(ns_sha256(ein,eout)!=0){
                prl("sha256 failed");
                return 3;
            }
            nio_free(ein);
            copy_bytes(lprev,0,eout,0,32);
            copy_bytes(kha,(seq as i32)*32,kh,0,32);
            copy_bytes(enta,(seq as i32)*32,eout,0,32);
            nio_free(kh);
            nio_free(eout);
            p32(s2i,(seq as i32)*4,fid);
            p32(s2v,(seq as i32)*4,val);
            // fact row: id, link_off, link_len, key_off, key_len, value, installed, seq
            let nf:i32=g32(fm,0) as i32;
            let fo:i32=4+32*nf;
            p32(fm,fo,fid);
            p32(fm,fo+4,g32(out,0));
            p32(fm,fo+8,g32(out,4));
            p32(fm,fo+12,g32(out,8));
            p32(fm,fo+16,g32(out,12));
            p32(fm,fo+20,val);
            p32(fm,fo+24,1);
            p32(fm,fo+28,seq);
            p32(fm,0,(nf+1) as i64);
            pr("INSTALL id=");
            prn(fid);
            pr(" seq=");
            prn(seq);
            pr(" value=");
            prn(val);
            pr(" ntok=");
            prn(g32(out,28));
            pr(" ndig=");
            prn(g32(out,32));
            pr(" nword=");
            prn(g32(out,36));
            pr(" keylen=");
            prn(g32(out,12));
            pr(" toks=");
            prlen(trb,g32(out,40) as i32);
            prl("");
            seq=seq+1;
        }
        else{
            pr("EXTRACT-FAIL id=");
            prn(fid);
            pr(" ntok=");
            prn(g32(out,28));
            pr(" ndig=");
            prn(g32(out,32));
            pr(" nword=");
            prn(g32(out,36));
            prl("");
        }
        if(le<tlen){ti=le+1;}
        else{ti=le;}
    }
    pr("EXTRACT ok=");
    prn(extract_ok as i64);
    pr(" fail=");
    prn((ntrain-extract_ok) as i64);
    prl("");

    // ---- false ids ----
    let fids:[]u8=nio_alloc(12*4);
    let nfals:i32=0;
    let fi2:i32=0;
    while(fi2<fib.len){
        let le2:i32=fi2;
        let go3:i32=1;
        while(go3==1){
            if(le2>=fib.len || fib[le2]==10){go3=0;}
            else{le2=le2+1;}
        }
        if(le2>fi2){
            p32(fids,nfals*4,parse_int(fib,fi2,le2-fi2));
            nfals=nfals+1;
        }
        if(le2<fib.len){fi2=le2+1;}
        else{fi2=le2;}
    }
    pr("FALSEIDS n=");
    prn(nfals as i64);
    prl("");

    // ---- (b) probe the test questions ----
    let ntest:i32=0;
    let full_ok:i32=0;
    let clean_ok:i32=0;
    let ans:[]u8=nio_alloc(240*4);
    let nfacts:i32=g32(fm,0) as i32;
    let ei:i32=0;
    let elen:i32=test.len;
    while(ei<elen){
        let le3:i32=ei;
        let go4:i32=1;
        while(go4==1){
            if(le3>=elen || test[le3]==10){go4=0;}
            else{le3=le3+1;}
        }
        // id \t value \t probe
        let t1:i32=ei;
        let go5:i32=1;
        while(go5==1){
            if(t1>=le3 || test[t1]==9){go5=0;}
            else{t1=t1+1;}
        }
        let t2:i32=t1+1;
        let go6:i32=1;
        while(go6==1){
            if(t2>=le3 || test[t2]==9){go6=0;}
            else{t2=t2+1;}
        }
        let pid:i64=parse_int(test,ei,t1-ei);
        let pval:i64=parse_int(test,t1+1,t2-t1-1);
        let psoff:i32=t2+1;
        let pslen:i32=le3-psoff;
        if(pslen>0 && test[psoff+pslen-1]==13){pslen=pslen-1;}
        zero40(st);
        let okp:i64=proc_sentence(vbytes,vent,test,psoff,pslen,tmp,kid,linka,keya,trb,st,out);
        if(okp==0){
            pr("PROBE-KEY-EMPTY id=");
            prn(pid);
            prl("");
        }
        let plen:i32=g32(out,12) as i32;
        let first:i32=1;
        let bi:i64=0;
        let bu:i64=1;
        let bestid:i64=-1;
        let bestval:i64=0;
        let ntie:i32=0;
        let fx:i32=0;
        while(fx<nfacts){
            let fo2:i32=4+32*fx;
            let fko:i32=g32(fm,fo2+12) as i32;
            let fkl:i32=g32(fm,fo2+16) as i32;
            let sc:i64=jscore(kid,plen,keya,fko,fkl);
            let inter:i64=(sc>>32)&4294967295;
            let union:i64=sc&4294967295;
            if(first==1){
                bi=inter; bu=union;
                bestid=g32(fm,fo2); bestval=g32(fm,fo2+20);
                ntie=1; first=0;
            }
            else{
                let lhs:i64=inter*bu;
                let rhs:i64=bi*union;
                if(lhs>rhs){
                    bi=inter; bu=union;
                    bestid=g32(fm,fo2); bestval=g32(fm,fo2+20);
                    ntie=1;
                }
                else{
                    if(lhs==rhs){ntie=ntie+1;}
                }
            }
            fx=fx+1;
        }
        if(first==1){
            prl("INTERNAL: no facts installed");
            return 3;
        }
        let correct:i32=0;
        if(bestval==pval){correct=1;}
        let iv:i64=-1;
        let qx:i32=0;
        while(qx<nfacts){
            if(g32(fm,4+32*qx)==pid){iv=g32(fm,4+32*qx+20);}
            qx=qx+1;
        }
        p32(ans,ntest*4,bestval);
        pr("PROBE id=");
        prn(pid);
        pr(" installed=");
        prn(iv);
        pr(" answer=");
        prn(bestval);
        pr(" want=");
        prn(pval);
        pr(" correct=");
        prn(correct as i64);
        pr(" ties=");
        prn(ntie as i64);
        pr(" best=");
        prn(bestid);
        prl("");
        if(correct==1){
            full_ok=full_ok+1;
            if(is_false(fids,nfals,pid)==0){clean_ok=clean_ok+1;}
        }
        ntest=ntest+1;
        if(le3<elen){ei=le3+1;}
        else{ei=le3;}
    }

    // ---- absorption: re-scan stated value of each false-id train sentence ----
    let absorb:i32=0;
    let ax:i32=0;
    while(ax<nfals){
        let fidi:i64=g32(fids,ax*4);
        let av:i64=-1;
        let qy:i32=0;
        while(qy<nfacts){
            if(g32(fm,4+32*qy)==fidi){av=g32(fm,4+32*qy+20);}
            qy=qy+1;
        }
        let fi3:i32=fidi as i32;
        let so3:i32=g32(tline,fi3*8) as i32;
        let sl3:i32=g32(tline,fi3*8+4) as i32;
        zero40(st);
        let ok3:i64=proc_sentence(vbytes,vent,train,so3,sl3,tmp,kid,linka,keya,trb,st,out);
        let sv:i64=g64(out,16);
        if(ok3==1 && av==sv){absorb=absorb+1;}
        pr("ABSORB id=");
        prn(fidi);
        pr(" installed=");
        prn(av);
        pr(" stated=");
        prn(sv);
        pr(" scanok=");
        prn(ok3);
        prl("");
        ax=ax+1;
    }

    // ---- (c) digest + verification ----
    let din:[]u8=nio_alloc(ntest*8+32);
    let dx:i32=0;
    while(dx<ntest){
        p64(din,dx*8,g32(ans,dx*4));
        dx=dx+1;
    }
    copy_bytes(din,ntest*8,lprev,0,32);
    let dg:[]u8=nio_alloc(32);
    let dg2:[]u8=nio_alloc(32);
    if(ns_sha256(din,dg)!=0 || ns_sha256(din,dg2)!=0){
        prl("sha256 failed");
        return 3;
    }
    nio_free(din);
    let dmatch:i32=beq2(dg,0,dg2,0,32);

    // ledger chain re-verification
    let chok:i32=1;
    let vprev:[]u8=nio_alloc(32);
    let vz:i32=0;
    while(vz<32){vprev[vz]=0;vz=vz+1;}
    let vx:i32=0;
    while(vx<seq){
        let ein2:[]u8=nio_alloc(84);
        copy_bytes(ein2,0,vprev,0,32);
        p64(ein2,32,vx as i64);
        p32(ein2,40,g32(s2i,vx*4));
        copy_bytes(ein2,44,kha,vx*32,32);
        p64(ein2,76,g32(s2v,vx*4));
        let eo2:[]u8=nio_alloc(32);
        if(ns_sha256(ein2,eo2)!=0){
            prl("sha256 failed");
            return 3;
        }
        if(beq2(eo2,0,enta,vx*32,32)==0){chok=0;}
        copy_bytes(vprev,0,eo2,0,32);
        nio_free(ein2);
        nio_free(eo2);
        vx=vx+1;
    }
    if(beq2(vprev,0,lprev,0,32)==0){chok=0;}
    nio_free(vprev);

    pr("SUMMARY extract=");
    prn(extract_ok as i64);
    pr("/");
    prn(ntrain as i64);
    pr(" full=");
    prn(full_ok as i64);
    pr("/");
    prn(ntest as i64);
    pr(" clean=");
    prn(clean_ok as i64);
    pr("/");
    prn((ntest-nfals) as i64);
    pr(" absorb=");
    prn(absorb as i64);
    pr("/");
    prn(nfals as i64);
    prl("");
    pr("DIGEST ");
    prhex(dg,0,32);
    prl("");
    pr("DIGEST2 ");
    prhex(dg2,0,32);
    prl("");
    pr("LEDGER ");
    prhex(lprev,0,32);
    prl("");
    pr("VERIFY chain=");
    prn(chok as i64);
    pr(" dmatch=");
    prn(dmatch as i64);
    prl("");

    let pass:i32=1;
    if(ntrain!=240){pass=0;}
    if(ntest!=240){pass=0;}
    if(nfals!=12){pass=0;}
    if(extract_ok!=240){pass=0;}
    if(chok==0){pass=0;}
    if(dmatch==0){pass=0;}
    if(pass==1){
        prl("RESULT PASS");
        return 0;
    }
    prl("RESULT FAIL");
    return 1;
}

ID=t11
UNIT=U3-interfaces
TITLE=interface extends
DESC=Dog extends Animal; describe it.
TPL=ifaceextends
FILES=single
PARAMS:
parent=Animal
pprops=name: string;
child=Dog
cprops=breed: string;
fn=describe
param=d
ret=string
body=return d.name + " the " + d.breed;
ENDPARAMS
TESTS:
console.log(describe({ name: "Rex", breed: "collie" }));
ENDTESTS
EXPECT:
Rex the collie
ENDEXPECT

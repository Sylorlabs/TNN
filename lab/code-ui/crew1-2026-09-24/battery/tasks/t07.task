ID=t07
UNIT=U2-functions
TITLE=arrow function with contextual typing
DESC=Map words to shouts using an arrow callback.
TPL=arrowmap
FILES=single
PARAMS:
arr=words
etype=string
items="a", "bb"
out=shouted
p=w
expr=w.toUpperCase() + "!"
ENDPARAMS
TESTS:
console.log(shouted.join(","));
ENDTESTS
EXPECT:
A!,BB!
ENDEXPECT

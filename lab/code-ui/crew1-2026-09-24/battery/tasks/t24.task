ID=t24
UNIT=U8-modules
TITLE=named export and import
DESC=math.ts exports phi and double(); main.ts imports both.
FILES=multi
LIBTPL=lib
LIBNAME=math
LIBPARAMS:
decls=export const phi = 1.61;
fn=double
params=n: number
ret=number
body=return n * 2;
ENDPARAMS
MAINTPL=main
MAINPARAMS:
imports=phi, double
lib=math
mainbody=console.log(double(phi));
ENDPARAMS
TESTS:
ENDTESTS
EXPECT:
3.22
ENDEXPECT

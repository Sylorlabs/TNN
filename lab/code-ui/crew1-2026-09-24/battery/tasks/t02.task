ID=t02
UNIT=U1-types
TITLE=union parameter with narrowing
DESC=Format a number|string id with typeof narrowing.
TPL=unionfn
FILES=single
PARAMS:
fn=describe
param=v
union=number | string
ret=string
sbranch=return "str:" + v.toUpperCase();
nbranch=return "num:" + v.toFixed(1);
ENDPARAMS
TESTS:
console.log(describe(3));
console.log(describe("hi"));
ENDTESTS
EXPECT:
num:3.0
str:HI
ENDEXPECT

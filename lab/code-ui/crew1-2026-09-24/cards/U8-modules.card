# CARD U8-modules — ES module syntax, exports, imports
## TPL lib
{decls}
export function {fn}({params}): {ret} {
  {body}
}
## TPL main
import { {imports} } from "./{lib}.js";
{mainbody}
## TPL defaultlib
export default function {fn}({params}): {ret} {
  {body}
}
export const {cname} = {cval};
## TPL defaultmain
import {dfn}, { {imports} } from "./{lib}.js";
{mainbody}
## TPL typelib
export type {tname} = {tbody};
export interface {iname} {
  {iprops}
}
## TPL typemain
import type { {timports} } from "./{lib}.js";
{mainbody}

// ob_scaffold.zag : K3 scaffold-removal test: the minimal driver.
//
// This driver does the absolute minimum: read problems.tsv, parse each line,
// call ob_deliberate. It contains NO fan-out call, NO fork threshold, NO
// branch logic, NO selection logic. If the machinery still fans out on
// fork-worthy problems under this driver, the fork decision lives inside the
// machinery (ledger-driven), not in driver scaffolding.
// Usage: ob_scaffold <problems.tsv>
// stdout: id, forked, verdict per problem.

@import("ob_problem.zag")
@import("onebrain.zag")

fn main()i32 {
    if(_zag_argc()<2){
        _zag_println("usage: ob_scaffold <problems.tsv>");
        return 64;
    }
    let ibuf:[]u8=nio_alloc(1048576);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(_zag_arg(1),ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    it.hid=nio_alloc(16*8);it.eid=nio_alloc(64*8);
    it.evns=nio_alloc(64*4);it.evna=nio_alloc(64*4);
    it.sup=nio_alloc(64*16*8);it.att=nio_alloc(64*16*8);
    let st:OBSt=OBSt{.scores:"",.alive:"",.used:"",.valid:"",.consumed:0,.rounds:0,.forked:0,.verdict:-1,.conf:0,.b_scores:"",.b_alive:"",.b_used:"",.b_valid:"",.b_verdict:"",.seq:"",.seq_n:"",.t_consume:0,.t_elim:0,.t_xexam:0,.t_test:0};
    if(it.hid.len==0){nio_free(ibuf);return 102;}
    if(ob_alloc(&st)!=0){nio_free(ibuf);return 102;}
    let o:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&o,65536)!=0){return 102;}
    let pz:OBPoison=OBPoison{.at_round:-1,.kind:0,.target:-1,.branch:0};
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return 102;}
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo,1048576)!=0){return 102;}
    let ok:i32=1;
    let pos:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line[0]!=35){
            let prc:i32=ob_parse_problem(&it,line);
            if(prc!=0){ok=0;}
            if(prc==0){
                let drc:i32=ob_deliberate(&it,&st,&lg,&lgo,0,&pz);
                if(drc!=0){ok=0;}
                if(drc==0){
                    dout_str(&o,dj_id(&it));
                    dout_str(&o," forked=");
                    dout_i64(&o,st.forked as i64);
                    dout_str(&o," verdict=");
                    dout_str(&o,dj_hid(&it,st.verdict));
                    dout_line(&o);
                }
            }
        }
        pos=e+1;
    }
    _zag_print(dout_bytes(&o));
    nio_free(ibuf);
    nio_free(it.hid);nio_free(it.eid);nio_free(it.evns);nio_free(it.evna);
    nio_free(it.sup);nio_free(it.att);
    ob_free(&st);
    dout_free(&o);dout_free(&lgo);lg_free(&lg);
    if(ok==0){return 103;}
    return 0;
}

// ob_delreord2.zag : K4 delete/reorder test (generalized): runs over ALL problems
// in the input TSV instead of hardcoded IDs. For each problem:
//   intact    : shared ledger, problem as frozen
//   deleted   : shared ledger, 3rd evidence item (index 2) removed (driver-side
//               TSV transform; the machinery parses the transformed line)
//   reordered : shared ledger, evidence order reversed
//   abl       : ablation on the intact problem (3 independent private ledgers,
//               verdicts v0/v1/v2 = N independent sequential branch runs)
// K4 (decorative sharing) is falsified per problem when:
//   (i)  deleting or reordering a shared entry changes the fan-out outcome
//        (verdict or trace hash differs from intact), AND
//   (ii) the intact fan-out verdict is not reproduced by ANY single
//        independent branch run (V not in {v0,v1,v2}).
// Usage: ob_delreord2 <problems.tsv> <delete_reorder_test.log>

@import("ob_problem.zag")
@import("onebrain.zag")

struct DRRec {
    verdict:i32, t_elim:i32, head:[]u8,
    bv:[]u8,      // 3 i32 branch verdicts (ablation only)
    seq:[]u8, seqn:[]u8,
}
fn dr_run(it:*Item, st:*OBSt, mode:i32, r:*DRRec)i32 {
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return -1;}
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&lgo,1048576)!=0){lg_free(&lg);return -2;}
    let rc:i32=lg_step(&lg,&lgo,"-",0,"GENESIS","delreord test");
    if(rc!=0){lg_free(&lg);dout_free(&lgo);return -3;}
    let pz:OBPoison=OBPoison{.at_round:-1,.kind:0,.target:-1,.branch:0};
    rc=ob_deliberate(it,st,&lg,&lgo,mode,&pz);
    if(rc!=0){lg_free(&lg);dout_free(&lgo);return -4;}
    r.*.verdict=st.*.verdict;r.*.t_elim=st.*.t_elim;
    let hh:[]u8=lg_head_hex(&lg);
    let hb:[]u8=nio_alloc(64);
    if(hb.len==0){lg_free(&lg);dout_free(&lgo);return -5;}
    let i:i32=0;
    while(i<64){hb[i]=hh[i];i=i+1;}
    r.*.head=hb;
    let bv:[]u8=nio_alloc(3*4);let sq:[]u8=nio_alloc(3*16*4);let sn:[]u8=nio_alloc(3*4);
    if(bv.len==0){nio_free(hb);lg_free(&lg);dout_free(&lgo);return -6;}
    i=0;
    while(i<3*4){bv[i]=st.*.b_verdict[i];i=i+1;}
    i=0;
    while(i<3*16*4){sq[i]=st.*.seq[i];i=i+1;}
    i=0;
    while(i<3*4){sn[i]=st.*.seq_n[i];i=i+1;}
    r.*.bv=bv;r.*.seq=sq;r.*.seqn=sn;
    lg_free(&lg);dout_free(&lgo);
    return 0;
}
fn dr_free(r:*DRRec)void {
    nio_free(r.*.head);nio_free(r.*.bv);nio_free(r.*.seq);nio_free(r.*.seqn);
}
// Transform a TSV line's evidence field. mode 1 = delete index 2, 2 = reverse.
// Returns owned buffer (caller frees), empty on error.
fn dr_xform(line:[]u8, mode:i32)[]u8 {
    let tab:[]u8=nio_alloc(7*2*4);
    let empty:[]u8="";
    if(tab.len==0){return empty;}
    if(ob_split(line,9,tab,7)!=7){nio_free(tab);return empty;}
    let evf:[]u8=ob_field(line,tab,4);
    let ep:[]u8=nio_alloc(64*2*4);
    if(ep.len==0){nio_free(tab);return empty;}
    let nev:i32=ob_split(evf,59,ep,64);
    if(nev<1){nio_free(tab);nio_free(ep);return empty;}
    let out:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&out,65536)!=0){nio_free(tab);nio_free(ep);return empty;}
    // fields 0..3
    let f:i32=0;
    while(f<4){
        if(f>0){dout_byte(&out,9);}
        dout_str(&out,ob_field(line,tab,f));
        f=f+1;
    }
    dout_byte(&out,9);
    // transformed evidence
    let first:i32=1;
    if(mode==1){
        let i:i32=0;
        while(i<nev){
            if(i!=2){
                if(first==0){dout_byte(&out,59);}
                dout_str(&out,ob_field(evf,ep,i));
                first=0;
            }
            i=i+1;
        }
    }
    if(mode==2){
        let i:i32=nev-1;
        while(i>=0){
            if(first==0){dout_byte(&out,59);}
            dout_str(&out,ob_field(evf,ep,i));
            first=0;
            i=i-1;
        }
    }
    dout_byte(&out,9);
    dout_str(&out,ob_field(line,tab,5));
    dout_byte(&out,9);
    dout_str(&out,ob_field(line,tab,6));
    nio_free(tab);nio_free(ep);
    if(out.err!=0){dout_free(&out);return empty;}
    let res:[]u8=nio_alloc(out.n);
    if(res.len==0){dout_free(&out);return empty;}
    let b:[]u8=dout_bytes(&out);
    let i:i32=0;
    while(i<out.n){res[i]=b[i];i=i+1;}
    dout_free(&out);
    return res;
}
fn dr_emit(o:*DOut, name:[]u8, it:*Item, r:*DRRec)void {
    dout_str(o,name);
    dout_str(o," verdict=");
    dout_str(o,dj_hid(it,r.*.verdict));
    dout_str(o," head=");
    dout_str(o,r.*.head);
    dout_str(o," t_elim=");
    dout_i64(o,r.*.t_elim as i64);
    dout_line(o);
}
fn pz_find2(buf:[]u8, blen:i32, want:[]u8)[]u8 {
    let pos:i32=0;
    while(pos<blen){
        let e:i32=pos;
        while(e<blen && buf[e]!=10){e=e+1;}
        let line:[]u8=buf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line[0]!=35){
            let f:i32=0;
            while(f<line.len && line[f]!=9){f=f+1;}
            if(f<line.len && dlb_streq(line[0..f],want)==1){return line;}
        }
        pos=e+1;
    }
    let empty:[]u8="";
    return empty;
}
fn dr_case(o:*DOut, it:*Item, st:*OBSt, line:[]u8, pid:[]u8)i32 {
    let prc:i32=ob_parse_problem(it,line);
    if(prc!=0){return -1;}
    let ri:DRRec=DRRec{.verdict:-1,.t_elim:0,.head:"",.bv:"",.seq:"",.seqn:""};
    let rd:DRRec=DRRec{.verdict:-1,.t_elim:0,.head:"",.bv:"",.seq:"",.seqn:""};
    let rr:DRRec=DRRec{.verdict:-1,.t_elim:0,.head:"",.bv:"",.seq:"",.seqn:""};
    let ra:DRRec=DRRec{.verdict:-1,.t_elim:0,.head:"",.bv:"",.seq:"",.seqn:""};
    dout_str(o,"== problem ");
    dout_str(o,pid);
    dout_line(o);
    if(dr_run(it,st,0,&ri)!=0){return -2;}
    if(ri.verdict<0){return -3;}
    // need fork for the test to be meaningful
    dr_emit(o,"intact(shared) ",it,&ri);
    let dl:[]u8=dr_xform(line,1);
    if(dl.len==0){dr_free(&ri);return -4;}
    let prc2:i32=ob_parse_problem(it,dl);
    if(prc2!=0){nio_free(dl);dr_free(&ri);return -5;}
    if(dr_run(it,st,0,&rd)!=0){nio_free(dl);dr_free(&ri);return -6;}
    dr_emit(o,"deleted(shared)",it,&rd);
    nio_free(dl);
    let rl:[]u8=dr_xform(line,2);
    if(rl.len==0){dr_free(&ri);dr_free(&rd);return -7;}
    let prc3:i32=ob_parse_problem(it,rl);
    if(prc3!=0){nio_free(rl);dr_free(&ri);dr_free(&rd);return -8;}
    if(dr_run(it,st,0,&rr)!=0){nio_free(rl);dr_free(&ri);dr_free(&rd);return -9;}
    dr_emit(o,"reordered(shar)",it,&rr);
    nio_free(rl);
    // re-parse intact for the ablation run
    let prc4:i32=ob_parse_problem(it,line);
    if(prc4!=0){dr_free(&ri);dr_free(&rd);dr_free(&rr);return -10;}
    if(dr_run(it,st,1,&ra)!=0){dr_free(&ri);dr_free(&rd);dr_free(&rr);return -11;}
    dout_str(o,"ablation branches v0=");
    dout_str(o,dj_hid(it,au_get32(ra.bv,0)));
    dout_str(o," v1=");
    dout_str(o,dj_hid(it,au_get32(ra.bv,1)));
    dout_str(o," v2=");
    dout_str(o,dj_hid(it,au_get32(ra.bv,2)));
    dout_line(o);
    // ---- K4 evaluation ----
    let del_changed:i32=0;
    if(rd.verdict!=ri.verdict){del_changed=1;}
    if(dlb_streq(rd.head,ri.head)==0){del_changed=1;}
    let reo_changed:i32=0;
    if(rr.verdict!=ri.verdict){reo_changed=1;}
    if(dlb_streq(rr.head,ri.head)==0){reo_changed=1;}
    let reproduced:i32=0;
    let b:i32=0;
    while(b<3){
        if(au_get32(ra.bv,b)==ri.verdict){reproduced=1;}
        b=b+1;
    }
    dout_str(o,"K4-delete(changes fan-out): ");
    if(del_changed==1){dout_str(o,"PASS");}else{dout_str(o,"FAIL");}
    dout_line(o);
    dout_str(o,"K4-reorder(changes fan-out): ");
    if(reo_changed==1){dout_str(o,"PASS");}else{dout_str(o,"FAIL");}
    dout_line(o);
    dout_str(o,"K4-not-decorative(verdict not reproduced by any independent branch): ");
    if(reproduced==0){dout_str(o,"PASS");}else{dout_str(o,"FAIL");}
    dout_line(o);
    dr_free(&ri);dr_free(&rd);dr_free(&rr);dr_free(&ra);
    return 0;
}
fn main()i32 {
    if(_zag_argc()<3){
        _zag_println("usage: ob_delreord2 <problems.tsv> <delete_reorder_test.log>");
        return 64;
    }
    let ibuf:[]u8=nio_alloc(1048576);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(_zag_arg(1),ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    it.hid=nio_alloc(16*8);it.eid=nio_alloc(64*8);
    it.evns=nio_alloc(64*4);it.evna=nio_alloc(64*4);
    it.sup=nio_alloc(64*16*8);it.att=nio_alloc(64*16*8);
    let st:OBSt=OBSt{.scores:"",.alive:"",.used:"",.valid:"",.consumed:0,.rounds:0,.forked:0,.verdict:-1,.conf:0,.b_scores:"",.b_alive:"",.b_used:"",.b_valid:"",.b_verdict:"",.seq:"",.seq_n:"",.t_consume:0,.t_elim:0,.t_xexam:0,.t_test:0};
    if(it.hid.len==0){nio_free(ibuf);return 102;}
    if(ob_alloc(&st)!=0){nio_free(ibuf);return 102;}
    let o:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&o,1048576)!=0){return 102;}
    dout_str(&o,"# Experiment 2 K4 delete/reorder test log (generalized driver)\n");
    dout_str(&o,"# deleted = 3rd evidence item (index 2) removed; reordered = evidence order reversed.\n");
    dout_str(&o,"# Runs over every non-comment line of the input TSV.\n");
    let pos:i32=0;let ok:i32=1;let ncases:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line[0]!=35){
            let tab:i32=0;
            while(tab<line.len && line[tab]!=9){tab=tab+1;}
            let pid:[]u8=line[0..tab];
            let crc:i32=dr_case(&o,&it,&st,line,pid);
            if(crc<0){ok=0;}
            if(crc>=0){ncases=ncases+1;}
        }
        pos=e+1;
    }
    let wrc:i64=0;
    if(ok==1 && o.err==0){wrc=dlb_write_file(_zag_arg(2),dout_bytes(&o),o.n);}
    nio_free(ibuf);
    nio_free(it.hid);nio_free(it.eid);nio_free(it.evns);nio_free(it.evna);
    nio_free(it.sup);nio_free(it.att);
    ob_free(&st);
    dout_free(&o);
    if(ok==0 || wrc<0){return 103;}
    let sum:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sum,256)==0){
        dout_str(&sum,"delreord test complete: ");
        dout_i64(&sum,ncases as i64);
        dout_str(&sum," cases\n");
        _zag_print(dout_bytes(&sum));
        dout_free(&sum);
    }
    return 0;
}

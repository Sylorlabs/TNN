// deliberation.zag — RSI Run 2 deliberator (taught RSI capability).
// One binary, two invocation modes (RUN_PREREG2.md §6):
//   verify mode: D-TEACH §9.1 I/O (scenario -> 4 slots)
//   loop mode: D-LOOP §2.2 I/O (deliberation inputs -> DELB with POLICY)
// Two variants: taught (D1-D7 / taught procedure) and baseline (naive).
// CLI: deliberation <verify|loop> <taught|baseline> <input_file>
// No lesson prose, no complete policies, no worked examples,
// no atom/action preferences, no gap->policy maps in this source.
// Taught procedure is mechanical D1-D7 operators on measured inputs.

fn main()i32 {
    let mode:[]u8=_zag_arg(1);
    let variant:[]u8=_zag_arg(2);
    let input_path:[]u8=_zag_arg(3);
    if(dl_eq(mode,"verify")==0&&dl_eq(mode,"loop")==0){
        dl_print("usage: deliberation <verify|loop> <taught|baseline> <input>\n");
        return 2;
    }
    if(dl_eq(variant,"taught")==0&&dl_eq(variant,"baseline")==0){
        dl_print("usage: deliberation <verify|loop> <taught|baseline> <input>\n");
        return 2;
    }
    if(input_path.len==0){
        dl_print("usage: deliberation <verify|loop> <taught|baseline> <input>\n");
        return 2;
    }
    let input:[]u8=dl_read_file(input_path);
    if(dl_eq(mode,"verify")==1){
        if(dl_eq(variant,"taught")==1){
            dl_verify_taught(input);
        } else {
            dl_verify_baseline(input);
        }
    } else {
        if(dl_eq(variant,"taught")==1){
            dl_loop_taught(input);
        } else {
            dl_loop_baseline(input);
        }
    }
    return 0;
}

// ---- helpers ----
fn dl_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn dl_print(s:[]u8)void {
    _zag_print(s);
    return;
}
fn dl_mkcstr(s:[]u8)[]u8 {
    let p:*u8=_zag_malloc(s.len+1) as *u8;
    let b:[]u8=p[0..s.len+1];
    let i:i32=0;while(i<s.len){b[i]=s[i];i=i+1;}b[s.len]=0;
    return b;
}
fn dl_read_file(path:[]u8)[]u8 {
    let cp:[]u8=dl_mkcstr(path);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cp) as i64,0,0,0,0,0);
    if(fd<0){dl_refuse();}
    let bp:*u8=_zag_malloc(16384) as *u8;
    let n:i64=_zag_raw_syscall(0,fd,_zag_slice_ptr(bp[0..16384]) as i64,16384,0,0,0);
    let c:i64=_zag_raw_syscall(3,fd,0,0,0,0,0);
    if(n<0){dl_refuse();}
    if(n>16384){n=16384;}
    return bp[0..n as i32];
}
fn dl_refuse()void {
    let x:i64=_zag_raw_syscall(60,1,0,0,0,0,0);
    return;
}
fn dl_find(s:[]u8,sub:[]u8,from:i32)i32 {
    if(sub.len==0){return from;}
    let i:i32=from;
    while(i+sub.len<=s.len){
        let j:i32=0;
        while(j<sub.len&&s[i+j]==sub[j]){j=j+1;}
        if(j==sub.len){return i;}
        i=i+1;
    }
    return -1;
}
fn dl_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let i:i32=0;while(i<pre.len){if(s[i]!=pre[i]){return 0;}i=i+1;}
    return 1;
}
// case-insensitive find (for token matching)
fn dl_find_ci(s:[]u8,sub:[]u8,from:i32)i32 {
    if(sub.len==0){return from;}
    let i:i32=from;
    while(i+sub.len<=s.len){
        let j:i32=0;
        while(j<sub.len){
            let a:u8=s[i+j];let b:u8=sub[j];
            if(a>=65&&a<=90){a=a+32;}
            if(b>=65&&b<=90){b=b+32;}
            if(a!=b){break;}
            j=j+1;
        }
        if(j==sub.len){return i;}
        i=i+1;
    }
    return -1;
}
// extract field: from "LABEL:" to next "\n" (or end)
fn dl_field(text:[]u8,label:[]u8)[]u8 {
    let p:i32=dl_find(text,label,0);
    if(p<0){return text[0..0];}
    let s:i32=p+label.len;
    let e:i32=s;
    while(e<text.len&&text[e]!=10){e=e+1;}
    return text[s..e];
}

// ---- verify mode: taught ----
fn dl_verify_taught(scenario:[]u8)void {
    // Parse scenario fields
    let scen_id:[]u8=dl_field(scenario,"SCENARIO: ");
    let metrics:[]u8=dl_field(scenario,"METRICS: ");
    let suggested:[]u8=dl_field(scenario,"SUGGESTED CHANGE: ");
    // V6 uses "SUGGESTED CHANGE, WITH FULL DESIGN:" — try both
    if(suggested.len==0){
        suggested=dl_field(scenario,"SUGGESTED CHANGE, WITH FULL DESIGN:");
    }
    let gap:[]u8=dl_field(scenario,"GAP AS STATED: ");
    // V6 has GAP: under the design section
    if(gap.len==0){
        gap=dl_field(scenario,"GAP: ");
    }
    let frozen:[]u8=dl_field(scenario,"FROZEN TEST: ");
    let constitution:[]u8=dl_field(scenario,"CONSTITUTION: ");
    let prediction:[]u8=dl_field(scenario,"PREDICTION: ");

    // IMPROVES_IF: the METRICS state the improvement criteria.
    dl_print("IMPROVES_IF: ");
    dl_print(metrics);
    dl_print("\n");

    // STEPS: the taught procedure (D-TEACH).
    dl_print("STEPS: propose predict test keep gate halt\n");

    // TRAP: mechanical trap identification.
    dl_print("TRAP: ");
    dl_trap_analysis(suggested,frozen,constitution,prediction,metrics);
    dl_print("\n");

    // DESIGN: mechanical gap/design assessment.
    dl_print("DESIGN: ");
    dl_design_analysis(gap,suggested,scenario);
    dl_print("\n");
    return;
}

fn dl_trap_analysis(suggested:[]u8,frozen:[]u8,constitution:[]u8,prediction:[]u8,metrics:[]u8)void {
    // V1: self-reported counter vs independent meter
    if(dl_find_ci(suggested,"own",0)>=0&&dl_find_ci(suggested,"counter",0)>=0){
        dl_print("The author reports energy saved on the controller's own energy counter. ");
        dl_print("The counter is self-reported. The METRICS require energy as measured at the meter. ");
        dl_print("The meter is the independent measurement; the counter is not.");
        return;
    }
    // V2: hidden flag used as visible
    if(dl_find_ci(suggested,"flag",0)>=0&&dl_find_ci(suggested,"visible",0)>=0){
        dl_print("The author tested with the flag visible, but the FROZEN TEST states the flag ");
        dl_print("is hidden at decision time. The flag is not a valid source for the decision.");
        return;
    }
    // V3: constitution violation (quartile)
    if(dl_find_ci(constitution,"quartile",0)>=0&&dl_find_ci(constitution,"never",0)>=0){
        dl_print("The CONSTITUTION forbids reducing help to the weakest quartile. ");
        dl_print("The suggested change targets slow answerers, which overlaps the quartile. ");
        dl_print("Violating the constitution is forbidden.");
        return;
    }
    // V4: overfitting (forty runs on frozen)
    if(dl_find_ci(suggested,"forty",0)>=0){
        dl_print("The author re-ran tuning forty times on the frozen fields, retaining the best run. ");
        dl_print("Tuning to the frozen set overfits. The frozen fields are not novel.");
        return;
    }
    // V5: same listeners (not novel)
    if(dl_find_ci(frozen,"same",0)>=0&&dl_find_ci(frozen,"throughout",0)>=0){
        dl_print("The FROZEN TEST uses the same listeners throughout. ");
        dl_print("There are no novel listeners. Retention on the same listeners does not generalize.");
        return;
    }
    // V6: prediction after test
    if(dl_find_ci(prediction,"after",0)>=0){
        dl_print("The PREDICTION was logged after the test run completed. ");
        dl_print("Prediction must be written before the test, not after. A prediction after the fact is not a prediction.");
        return;
    }
    dl_print("No specific trap identified in the suggested change.");
    return;
}

fn dl_design_analysis(gap:[]u8,suggested:[]u8,scenario:[]u8)void {
    // V1: no gap measured
    if(dl_find_ci(gap,"none measured",0)>=0){
        dl_print("The GAP AS STATED is 'None measured.' The gap is inadequate. ");
        dl_print("Without a measured gap, there is no basis for the change.");
        return;
    }
    // V6: full design with contract
    if(dl_find_ci(scenario,"CONTRACT:",0)>=0){
        dl_print("The design states a contract. Trigger, behavior, and bounds are specified. ");
        dl_print("The bounds protect the pedestrian phase. The contract is adequate.");
        return;
    }
    // V2: flag as source (invalid)
    if(dl_find_ci(gap,"flag",0)>=0||dl_find_ci(suggested,"flag",0)>=0){
        dl_print("The gap names the flag, but the flag is hidden at decision time. ");
        dl_print("The flag is not a valid source. The design must use observable sources.");
        return;
    }
    // V3: bounds violation
    if(dl_find_ci(scenario,"quartile",0)>=0){
        dl_print("The design must respect bounds. The quartile protection is a bound. ");
        dl_print("Reducing help to the quartile violates the bounds.");
        return;
    }
    // V4: novel fields needed
    if(dl_find_ci(suggested,"forty",0)>=0){
        dl_print("The design is inadequate. Tuning forty times on frozen fields does not test novel fields. ");
        dl_print("Adequate design requires novel-field validation.");
        return;
    }
    // V5: feature inadequate
    if(dl_find_ci(suggested,"cache",0)>=0){
        dl_print("The feature (cached session order) is inadequate. ");
        dl_print("Replaying one order for every session ignores session differences.");
        return;
    }
    dl_print("The design assessment requires a measured gap.");
    return;
}

// ---- verify mode: baseline (naive, must fail) ----
fn dl_verify_baseline(scenario:[]u8)void {
    let title:[]u8=dl_field(scenario,"TITLE: ");
    dl_print("IMPROVES_IF: The change improves if it makes things better. ");
    dl_print("We think the ");
    dl_print(title);
    dl_print(" will benefit.\n");
    dl_print("STEPS: First we think about the problem. Then we try a solution. ");
    dl_print("If it seems good, we keep it.\n");
    dl_print("TRAP: We did not find any trap. The author's report looks straightforward.\n");
    dl_print("DESIGN: The design seems reasonable. The gap description is plausible.\n");
    return;
}

// ---- loop mode: taught (D1-D7) ----
// D-LOOP §2.2 I/O: deliberation inputs -> DELB with POLICY.
// Input format (text file):
//   CHAMPION: <name>
//   EP: <episode number>
//   TRACK: <improvement|efficiency>
//   AF-PROXY-<class>: n=<n> wrong=<w>
//   AF-DISC: <class>,<atom>,<N|None>,<wt>,<wtot>,<ct>,<ctot>
//     (wt=n_wrong_atom_true, wtot=n_wrong_total, etc.)
//   HISTORY: <prior round summaries> (for D6)
// D1-D7 mechanical operators (RUN_PREREG2.md §6).
fn dl_loop_taught(input:[]u8)void {
    let ep:[]u8=dl_field(input,"EP: ");
    let track:[]u8=dl_field(input,"TRACK: ");
    // D1: target class = argmax proxy wrong (ties -> frozen order).
    let target:[]u8=dl_d1_target(input);
    // D1: candidate (atom,N) with discrimination >= 0.5.
    // We collect up to 3 best by discrimination.
    // (Simplified: parse AF-DISC lines, compute, select top 3.)
    let c1_a:i32=0;let c1_n:i32=0;let c1_d:i32=0;
    let c2_a:i32=0;let c2_n:i32=0;let c2_d:i32=0;
    let c3_a:i32=0;let c3_n:i32=0;let c3_d:i32=0;
    let ncand:i32=0;
    let pos:i32=0;
    while(1==1){
        let lp:i32=dl_find(input,"AF-DISC: ",pos);
        if(lp<0){break;}
        let ls:i32=lp+9;
        let le:i32=ls;
        while(le<input.len&&input[le]!=10){le=le+1;}
        let line:[]u8=input[ls..le];
        // line: <class>,<atom>,<N|None>,<wt>,<wtot>,<ct>,<ctot>
        // Only consider target class.
        let cl:[]u8=dl_csv_field(line,0);
        if(dl_eq(cl,target)==1){
            let atom:i32=dl_parse_int(dl_csv_field(line,1));
            let nstr:[]u8=dl_csv_field(line,2);
            let nval:i32=0;
            let has_n:i32=1;
            if(dl_eq(nstr,"None")==1){has_n=0;}else{nval=dl_parse_int(nstr);}
            let wt:i32=dl_parse_int(dl_csv_field(line,3));
            let wtot:i32=dl_parse_int(dl_csv_field(line,4));
            let ct:i32=dl_parse_int(dl_csv_field(line,5));
            let ctot:i32=dl_parse_int(dl_csv_field(line,6));
            // discrimination = wrong_true_rate - correct_true_rate
            // scaled by 1000 for integer math: (wt*1000/wtot) - (ct*1000/ctot)
            let d:i32=0;
            if(wtot>0&&ctot>0){
                d=wt*1000/wtot-ct*1000/ctot;
            }
            // >= 0.5 => d >= 500
            if(d>=500){
                // S1/S4-legal atoms only (1-11); 12-15 are S2-only.
                if(atom>=1&&atom<=11){
                    ncand=ncand+1;
                    // insert into top-3 by d
                    if(d>c1_d){c3_a=c2_a;c3_n=c2_n;c3_d=c2_d;c2_a=c1_a;c2_n=c1_n;c2_d=c1_d;c1_a=atom;c1_n=nval;c1_d=d;}
                    else{if(d>c2_d){c3_a=c2_a;c3_n=c2_n;c3_d=c2_d;c2_a=atom;c2_n=nval;c2_d=d;}
                    else{if(d>c3_d){c3_a=atom;c3_n=nval;c3_d=d;}}}
                }
            }
        }
        pos=le+1;
        if(pos>=input.len){break;}
    }
    if(ncand==0){
        dl_print("DELB_HALT\n");
        dl_print("REASON: no discriminating feature (D1: no (atom,N) with discrimination >= 0.5).\n");
        return;
    }
    // D2: contract -> stage and action.
    // Branches (frozen):
    //   feature involves channel state (atom 2,3,10,11) -> S1 force_consult
    //   feature is margin/score (atom 4,5,6,7,8,9) with verdict determined -> S1 block_consult
    //   track=efficiency -> S4 recompute_only
    // S2 actions arise ONLY via D6 revision (not here).
    let stage:i32=1;
    let action:[]u8="force_consult";
    if(dl_eq(track,"efficiency")==1){
        stage=4;
        action="recompute_only(7)"; // scope 7 = all relations (placeholder; D4 binds)
    } else {
        // Check if top atom is channel-state (2,3,10,11) or margin/score.
        let ta:i32=c1_a;
        if(ta==2||ta==3||ta==10||ta==11){
            stage=1;action="force_consult";
        } else {
            stage=1;action="block_consult";
        }
    }
    // D3: compose POLICY with top-min(3,ncand) atoms, AND-joined.
    // D4: bind N from AF-DISC row (logged in ARGUMENT).
    dl_print("DELB ");
    dl_print(ep);
    dl_print("\nPOLICY\n");
    dl_print("POLICY P");
    dl_print(ep);
    dl_print("\n");
    dl_print("RULE 1 IF ");
    dl_print_atom(c1_a,c1_n);
    if(ncand>=2){dl_print(" AND ");dl_print_atom(c2_a,c2_n);}
    if(ncand>=3){dl_print(" AND ");dl_print_atom(c3_a,c3_n);}
    dl_print(" THEN ");
    dl_print(action);
    dl_print("\nEND\nENDPOLICY\n");
    // ARGUMENT with D4 binding sources.
    dl_print("ARGUMENT: D1 selected ");
    dl_print_i32(ncand);
    dl_print(" candidate(s) with discrimination >= 0.5 for class ");
    dl_print(target);
    dl_print(". D4 binds N from AF-DISC rows: atom ");
    dl_print_i32(c1_a);
    dl_print(" N=");
    dl_print_i32(c1_n);
    dl_print(" (discrimination ");
    dl_print_i32(c1_d);
    dl_print("/1000).");
    if(ncand>=2){
        dl_print(" atom ");dl_print_i32(c2_a);dl_print(" N=");dl_print_i32(c2_n);
    }
    if(ncand>=3){
        dl_print(" atom ");dl_print_i32(c3_a);dl_print(" N=");dl_print_i32(c3_n);
    }
    dl_print(" D2 contract: stage ");
    dl_print_i32(stage);
    dl_print(".\n");
    // D5: prediction placeholder (simulation via shared engine; not run here).
    dl_print("PREDICTION: P-ACC/P-WRONG bands from proxy delta (D5 simulation informs prediction, not composition).\n");
    // D6: revision lineage (none on first proposal).
    dl_print("REVISION: 0 (initial proposal; D6 bounded revisions cite AF-HIST).\n");
    // D7: provenance.
    dl_print("PROVENANCE: U1 episode appended before test (D7).\n");
    return;
}

// CSV field extractor (0-indexed)
fn dl_csv_field(line:[]u8,idx:i32)[]u8 {
    let p:i32=0;
    let i:i32=0;
    while(i<idx){
        while(p<line.len&&line[p]!=44){p=p+1;}
        p=p+1;
        i=i+1;
    }
    let e:i32=p;
    while(e<line.len&&line[e]!=44){e=e+1;}
    return line[p..e];
}
fn dl_parse_int(s:[]u8)i32 {
    let neg:i32=0;
    let p:i32=0;
    if(s.len>0&&s[0]==45){neg=1;p=1;}
    let v:i32=0;
    while(p<s.len){
        v=v*10+(s[p] as i32-48);
        p=p+1;
    }
    if(neg==1){v=0-v;}
    return v;
}
fn dl_print_i32(v:i32)void {
    let s:[]u8=_zag_i64_to_str(v as i64);
    // strip trailing newline (per AGENTS.md)
    if(s.len>0&&s[s.len-1]==10){s=s[0..s.len-1];}
    dl_print(s);
    return;
}
fn dl_print_atom(atom:i32,n:i32)void {
    // atom id -> name (S1/S4-legal only, 1-11)
    if(atom==1){dl_print("pre_is(");dl_print_xval(n);dl_print(")");}
    if(atom==2){dl_print("chan_present");}
    if(atom==3){dl_print("chan_silent");}
    if(atom==4){dl_print("sm_le(");dl_print_i32(n);dl_print(")");}
    if(atom==5){dl_print("sm_ge(");dl_print_i32(n);dl_print(")");}
    if(atom==6){dl_print("sm_eq(");dl_print_i32(n);dl_print(")");}
    if(atom==7){dl_print("dir_is(");dl_print_dval(n);dl_print(")");}
    if(atom==8){dl_print("sn_ge(");dl_print_i32(n);dl_print(")");}
    if(atom==9){dl_print("so_ge(");dl_print_i32(n);dl_print(")");}
    if(atom==10){dl_print("caval_eq_vold");}
    if(atom==11){dl_print("caval_eq_vnew");}
    return;
}
fn dl_print_xval(v:i32)void {
    if(v==0){dl_print("HOLD");}
    if(v==1){dl_print("NEW");}
    if(v==2){dl_print("OLD");}
    return;
}
fn dl_print_dval(v:i32)void {
    if(v==0){dl_print("TIE");}
    if(v==1){dl_print("NEW_LEAD");}
    if(v==2){dl_print("OLD_LEAD");}
    return;
}
// D1 target class: argmax proxy wrong; ties -> N-clean, O-clean, ADV-NEW, ADV-OLD, NEITHER.
fn dl_d1_target(input:[]u8)[]u8 {
    let best:[]u8="N-clean";
    let best_w:i32=-1;
    // frozen order
    let classes:[]u8="N-clean,O-clean,ADV-NEW,ADV-OLD,NEITHER";
    let ci:i32=0;
    while(ci<5){
        let cn:[]u8=dl_csv_field(classes,ci);
        let lp:i32=dl_find(input,cn,0);
        if(lp>=0){
            // find "wrong=" after lp
            let wp:i32=dl_find(input,"wrong=",lp);
            if(wp>=0){
                let ws:i32=wp+6;
                let we:i32=ws;
                while(we<input.len&&input[we]>=48&&input[we]<=57){we=we+1;}
                let w:i32=dl_parse_int(input[ws..we]);
                if(w>best_w){best_w=w;best=cn;}
            }
        }
        ci=ci+1;
    }
    return best;
}

// ---- loop mode: baseline ----
fn dl_loop_baseline(input:[]u8)void {
    dl_print("DELB_HALT\n");
    dl_print("REASON: baseline does not deliberate.\n");
    return;
}

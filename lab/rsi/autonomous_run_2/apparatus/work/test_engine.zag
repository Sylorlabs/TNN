@import("policy_engine.zag.inc")
// test_engine.zag — TEST ONLY (not frozen apparatus).
// Differential test binary: runs engine on all batteries via argv bytecode.
// CLI: test_engine "<bytecode>" <r|p|n> <q|v|json>
// This is for verification, not part of the RSI loop.
fn main()i32 {
    let bc_arg:[]u8=_zag_arg(1);
    let barg:[]u8=_zag_arg(2);
    let marg:[]u8=_zag_arg(3);
    if(bc_arg.len==0&&_zag_arg(1).len!=0){
        _zag_print("usage: test_engine \"<bytecode>\" <r|p|n> <q|v|json>\n");
        return 2;
    }
    let b:i32=-1;
    if(pe_eq(barg,"r")==1){b=0;}
    if(pe_eq(barg,"p")==1){b=1;}
    if(pe_eq(barg,"n")==1){b=2;}
    if(b<0){pe_refuse();}
    let mode:i32=-1;
    if(pe_eq(marg,"q")==1){mode=0;}
    if(pe_eq(marg,"v")==1){mode=1;}
    if(pe_eq(marg,"json")==1){mode=2;}
    if(mode<0){pe_refuse();}
    if(pe_validate_bytecode(bc_arg)==0){pe_refuse();}
    let i:i32=0;
    while(i<24){
        let packed:i32=pe_decide(bc_arg,b,i);
        let v:i32=packed%4;
        let c:i32=(packed/4)%2;
        let ops:i32=packed/8;
        if(mode==0){pe_out_q(v,c);}
        if(mode==1){pe_out_v(v);}
        if(mode==2){pe_out_json(b,i,v,c,ops);}
        i=i+1;
    }
    return 0;
}

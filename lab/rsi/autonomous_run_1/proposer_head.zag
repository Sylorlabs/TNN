// proposer_head.zag — TNN's deliberation for autonomous RSI run 1.
// Frozen: RUN_PREREG.md. argv: k1..k5 (kept) t1..t5 (tried) r1..r5 (retired)
// bN (barren b0..b3) webW (web0/web1). "-" = empty slot.
// decide.zag.inc is appended after this file at build time.
// Deterministic, zero RNG. Output: PROP_* lines.

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0){if(s[n-1]==10){return s[0..n-1];}}
    return s;
}
fn pnum(v:i64)void {
    if(v<0){_zag_print("-");}
    let a:i64=v;
    if(a<0){a=0-a;}
    _zag_print(i64s(a));
}
fn bit_of(c:i32)i32 {
    if(c==1){return 1;}
    if(c==2){return 2;}
    if(c==3){return 4;}
    if(c==4){return 8;}
    if(c==5){return 16;}
    return 0;
}
fn unpack_v(d:i64)i32 {
    return (d&(255 as i64)) as i32;
}
fn unpack_o(d:i64)i32 {
    return ((d>>16)&(65535 as i64)) as i32;
}

fn main()void {
    let kept:i32=0; let tried:i32=0; let retired:i32=0;
    let q:i32=1;
    while(q<=5){let s:[]u8=_zag_arg(q);kept=kept|slot_mask(s);q=q+1;}
    q=6;
    while(q<=10){let s2:[]u8=_zag_arg(q);tried=tried|slot_mask(s2);q=q+1;}
    q=11;
    while(q<=15){let s3:[]u8=_zag_arg(q);retired=retired|slot_mask(s3);q=q+1;}
    let bs:[]u8=_zag_arg(16);
    let barren:i32=0;
    if(_zag_strcmp(bs,"b1")==1){barren=1;}
    if(_zag_strcmp(bs,"b2")==1){barren=2;}
    if(_zag_strcmp(bs,"b3")==1){barren=3;}
    let ws:[]u8=_zag_arg(17);
    let web:i32=0;
    if(_zag_strcmp(ws,"web1")==1){web=1;}
    _zag_print("PROP_START,kept=");pnum(kept as i64);
    _zag_print(",tried=");pnum(tried as i64);
    _zag_print(",retired=");pnum(retired as i64);
    _zag_print(",barren=");pnum(barren as i64);
    _zag_print(",web=");pnum(web as i64);
    _zag_println("");
    // ---- champion proxy scores (ROUND 1: simulate) ----
    let ch_acc:i32=0; let ch_wrong:i32=0; let ch_cost:i32=0;
    let j:i32=0;
    while(j<24){
        let dh:i64=decide(1,j,kept,0);
        let vh:i32=unpack_v(dh);
        ch_cost=ch_cost+unpack_o(dh);
        let gt0:i32=fld(1,j,11);
        if(vh==gt0){ch_acc=ch_acc+1;}else{if(vh==1||vh==2){ch_wrong=ch_wrong+1;}}
        j=j+1;
    }
    _zag_print("PROP_CHAMP,proxy_acc=");pnum(ch_acc as i64);
    _zag_print(",proxy_wrong=");pnum(ch_wrong as i64);
    _zag_print(",proxy_cost=");pnum(ch_cost as i64);
    _zag_println("");
    // ---- per-candidate simulation + verification + selection ----
    let best:i32=0; let best_track:i32=0;
    let best_dacc:i32=0; let best_dwrong:i32=0; let best_dcost:i32=0;
    let elig:i32=0; let thin:i32=0;
    let c:i32=1;
    while(c<=5){
        let bit:i32=bit_of(c);
        let el:i32=1;
        if((kept&bit)!=0){el=0;}
        if((tried&bit)!=0){el=0;}
        if((retired&bit)!=0){el=0;}
        if(el==1){
            elig=elig+1;
            let pa:i32=0; let pw:i32=0; let pc:i32=0; let imp:i32=0;
            let m:i32=0;
            while(m<24){
                let dh2:i64=decide(1,m,kept,0);
                let vh2:i32=unpack_v(dh2);
                let dc:i64=decide(1,m,kept,bit);
                let vc:i32=unpack_v(dc);
                pc=pc+unpack_o(dc);
                let g2:i32=fld(1,m,11);
                if(vc==g2){pa=pa+1;}else{if(vc==1||vc==2){pw=pw+1;}}
                if(vc==g2){if(vh2!=g2){imp=imp+1;}}
                m=m+1;
            }
            let dacc:i32=pa-ch_acc;
            let dwrong:i32=pw-ch_wrong;
            let dcost:i32=pc-ch_cost;
            // V2 (constitution): never turn a real-battery champion WITHHOLD into an install
            let v2:i32=1;
            let k:i32=0;
            while(k<24){
                let dh3:i64=decide(0,k,kept,0);
                let vh3:i32=unpack_v(dh3);
                let dc3:i64=decide(0,k,kept,bit);
                let vc3:i32=unpack_v(dc3);
                if(vh3==0){if(vc3==1||vc3==2){v2=0;}}
                k=k+1;
            }
            _zag_print("PROP_SIM,cand=c");pnum(c as i64);
            _zag_print(",dacc=");pnum(dacc as i64);
            _zag_print(",dwrong=");pnum(dwrong as i64);
            _zag_print(",dcost=");pnum(dcost as i64);
            _zag_print(",improved=");pnum(imp as i64);
            _zag_print(",v2=");pnum(v2 as i64);
            _zag_println("");
            let v3ok:i32=0;
            if(imp>=2){v3ok=1;}
            if(web==1){v3ok=1;}
            if(dacc>=1){if(dwrong<=0){if(v2==1){
                if(v3ok==0){thin=1;}
                if(v3ok==1){
                    if(best==0){best=c;best_track=1;best_dacc=dacc;best_dwrong=dwrong;best_dcost=dcost;}
                    else{
                        if(best_track==2){best=c;best_track=1;best_dacc=dacc;best_dwrong=dwrong;best_dcost=dcost;}
                        else{
                            if(dacc>best_dacc){best=c;best_dacc=dacc;best_dwrong=dwrong;best_dcost=dcost;}
                            else{if(dacc==best_dacc){if(dcost<best_dcost){best=c;best_dacc=dacc;best_dwrong=dwrong;best_dcost=dcost;}}}
                        }
                    }
                }
            }}}
            else{
                if(best==0){
                    if(dacc==0){if(dwrong<=0){if(dcost<0){if(v2==1){
                        if(best_track==0){best=c;best_track=2;best_dacc=dacc;best_dwrong=dwrong;best_dcost=dcost;}
                        else{if(dcost<best_dcost){best=c;best_dacc=dacc;best_dwrong=dwrong;best_dcost=dcost;}}
                    }}}}
                }
            }
        }
        c=c+1;
    }
    if(best!=0){
        let bbit:i32=bit_of(best);
        let rcost:i32=0;
        let t:i32=0;
        while(t<24){
            let dd:i64=decide(0,t,kept,bbit);
            rcost=rcost+unpack_o(dd);
            t=t+1;
        }
        _zag_println("PROP_DECISION,decision=PROPOSE");
        _zag_print("PROP_CAND,cand=c");pnum(best as i64);
        _zag_print(",track=");
        if(best_track==1){_zag_print("improvement");}else{_zag_print("efficiency");}
        _zag_println("");
        _zag_print("PROP_PRED,dacc=");pnum(best_dacc as i64);
        _zag_print(",dwrong=");pnum(best_dwrong as i64);
        _zag_print(",cost=");pnum(rcost as i64);
        _zag_println("");
        _zag_print("PROP_RUN,extra=c");pnum(best as i64);
        _zag_println("");
    }else{
        if(elig==0){
            _zag_println("PROP_DECISION,decision=HALT,reason=exhausted");
        }else{
            if(thin==1){
                _zag_println("PROP_DECISION,decision=WEBQUERY");
                _zag_println("PROP_QUERY,text=thin-win-generalization");
            }else{
                if(barren>=2){
                    _zag_println("PROP_DECISION,decision=HALT,reason=three-barren");
                }else{
                    _zag_print("PROP_DECISION,decision=BARREN,barren_next=b");
                    pnum((barren+1) as i64);
                    _zag_println("");
                }
            }
        }
    }
    return;
}

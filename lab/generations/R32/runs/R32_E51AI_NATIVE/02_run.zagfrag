    // Direct reconstruction above is inherited; no E51AH experiment executes.
    let integrity:i32=1;
    if(world_gate!=1 || terminal_reproduction_gate!=1 || direct_integrity!=1 ||
       terminal_hash_before!=238967492 || direct_hash_before!=1790306570){ integrity=0; }
    if(integrity!=1){ _zag_println("e51ai_integrity_gate,0"); return 0; }
    let train_x:[]i32=zalloc_i(4*E51AI_EP*64);
    let train_targets:[]i32=zalloc_i(4*E51AI_EP*2);
    let probe_x:[]i32=zalloc_i(4*E51AI_STATES*64);
    let probe_meta:[]i32=zalloc_i(4*E51AI_STATES*E51AI_META);
    e45_zero(train_x,4*E51AI_EP*64); e45_zero(train_targets,4*E51AI_EP*2);
    e45_zero(probe_x,4*E51AI_STATES*64); e45_zero(probe_meta,4*E51AI_STATES*E51AI_META);
    let dataset:i32=0; let feature_gate:i32=1;
    while(dataset<8){
        let stage:i32=111+dataset;
        let control:[]i32=zalloc_i(E51AI_STATES*E50_RECORD_N);
        let direct:[]i32=zalloc_i(E51AI_STATES*E50_RECORD_N);
        let targets0:[]i32=zalloc_i(E51AI_STATES); let targets1:[]i32=zalloc_i(E51AI_STATES);
        let pos:[]i32=zalloc_i(2); let neg:[]i32=zalloc_i(2); let unknown:i32=0;
        e45_zero(control,E51AI_STATES*E50_RECORD_N); e45_zero(direct,E51AI_STATES*E50_RECORD_N);
        let built:i32=e51ab_build_partition(stage,E51AI_EP,2,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,control,direct,targets0,targets1,pos,neg,&unknown);
        let accessible:[]i32=zalloc_i(E51AI_STATES);
        e51ah_build_accessible(stage,E51AI_EP,2,accessible);
        if(built!=E51AI_EP || unknown!=0){ integrity=0; }
        let data_hash:i32=9209; let selected_count:i32=0; let ep:i32=0;
        while(ep<E51AI_EP){
            let last:i32=0; let t:i32=0;
            while(t<=E45_TAPE){ if(accessible[ep*(E45_TAPE+1)+t]==1){ last=t; } t=t+1; }
            if(dataset<4){
                let index:i32=ep*(E45_TAPE+1)+last; let row:i32=dataset*E51AI_EP+ep;
                if(e51ai_feature_pair(direct,index,last,train_x,row*64)!=1){ feature_gate=0; }
                let q0:i32=0; let q1:i32=0;
                e51ac_direct_scores(direct,index*E50_RECORD_N,g0,b0,g1,b1,prototypes,parents,ranges,direct_lw,direct_lb,&q0,&q1);
                train_targets[row*2]=targets0[index]-q0; train_targets[row*2+1]=targets1[index]-q1;
                _zag_print("e51ai_training_record,"); e45_print_i32(dataset); _zag_print(","); e45_print_i32(ep); _zag_print(","); e45_print_i32(last);
                _zag_print(","); e45_print_i32(train_targets[row*2]); _zag_print(","); e45_print_i32(train_targets[row*2+1]);
                let f:i32=0;
                while(f<64){ _zag_print(","); e45_print_i32(train_x[row*64+f]); data_hash=e46_hash_update(data_hash,train_x[row*64+f]); f=f+1; }
                data_hash=e46_hash_update(data_hash,train_targets[row*2]); data_hash=e46_hash_update(data_hash,train_targets[row*2+1]);
                _zag_println(""); selected_count=selected_count+1;
            }else{
                t=0;
                while(t<=E45_TAPE){
                    let index:i32=ep*(E45_TAPE+1)+t; let rs:i32=index*E50_RECORD_N;
                    let row:i32=(dataset-4)*E51AI_STATES+index; let m:i32=row*E51AI_META;
                    if(e51ai_feature_pair(direct,index,t,probe_x,row*64)!=1){ feature_gate=0; }
                    probe_meta[m]=accessible[index];
                    let sc:i32=e51y_terminal_choice(control,rs,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
                    let sv:i32=e51ac_slot_scalar(control,rs,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
                    let q0:i32=0; let q1:i32=0;
                    e51ac_direct_scores(direct,rs,g0,b0,g1,b1,prototypes,parents,ranges,direct_lw,direct_lb,&q0,&q1);
                    probe_meta[m+1]=sc; probe_meta[m+2]=sv; probe_meta[m+3]=q0; probe_meta[m+4]=q1;
                    probe_meta[m+5]=targets0[index]; probe_meta[m+6]=targets1[index];
                    let j:i32=0; while(j<4){ probe_meta[m+7+j]=control[rs+34+j]; j=j+1; }
                    let dc:i32=e51ad_direct_code(direct,rs,g0,b0,g1,b1,prototypes,parents,ranges,direct_lw,direct_lb);
                    let ss:i32=e51ac_choice_success(sc,control,direct,rs); let ds:i32=e51ac_choice_success(dc,control,direct,rs);
                    if(ss==1 || ds==1){ probe_meta[m+11]=1; }
                    // Independent agreement for every cached action, including UNKNOWN.
                    j=0;
                    while(j<6){
                        if(e51ai_success(probe_meta,row,j)!=e51ac_choice_success(j,control,direct,rs)){ integrity=0; }
                        j=j+1;
                    }
                    let f:i32=0; while(f<64){ data_hash=e46_hash_update(data_hash,probe_x[row*64+f]); f=f+1; }
                    j=0; while(j<E51AI_META){ data_hash=e46_hash_update(data_hash,probe_meta[m+j]); j=j+1; }
                    t=t+1;
                }
            }
            ep=ep+1;
        }
        _zag_print("e51ai_dataset,"); e45_print_i32(dataset); _zag_print(","); e45_print_i32(stage); _zag_print(","); e45_print_i32(built); _zag_print(","); e45_print_i32(unknown); _zag_print(","); e45_print_i32(selected_count); _zag_print(","); e45_print_i32(data_hash); _zag_println("");
        zfree(control); zfree(direct); zfree(targets0); zfree(targets1); zfree(pos); zfree(neg); zfree(accessible);
        dataset=dataset+1;
    }
    if(feature_gate!=1){ integrity=0; }
    e45_print_pair("e51ai_feature_isolation_gate",feature_gate);
    e45_print_pair("e51ai_dataset_integrity_gate",integrity);
    if(integrity!=1){ _zag_println("e51ai_integrity_gate,0"); return 0; }

    let weights:[]i32=zalloc_i(4*E51AI_MODEL); let reverse_weights:[]i32=zalloc_i(4*E51AI_MODEL);
    let snapshot:[]i32=zalloc_i(4*E51AI_MODEL);
    let anchors:[]i32=zalloc_i(4*4*E51AI_EP); let snapshot_outcomes:[]i32=zalloc_i(4*4*E51AI_EP);
    e45_zero(weights,4*E51AI_MODEL); e45_zero(reverse_weights,4*E51AI_MODEL); e45_zero(snapshot,4*E51AI_MODEL);
    e45_zero(anchors,4*4*E51AI_EP); e45_zero(snapshot_outcomes,4*4*E51AI_EP);
    e51ai_emit_weights(weights,0);
    let initial_probe:i32=e51ai_evaluate(probe_x,probe_meta,weights,anchors,snapshot_outcomes,0,0);
    let frozen_probe_hash:i32=e51ai_hash(probe_x,0,4*E51AI_STATES*64);
    let frozen_meta_hash:i32=e51ai_hash(probe_meta,0,4*E51AI_STATES*E51AI_META);
    let train_hash:i32=e51ai_hash(train_x,0,4*E51AI_EP*64);
    let targets_hash:i32=e51ai_hash(train_targets,0,4*E51AI_EP*2);
    let block:i32=0; let snapshot_hash:i32=0;
    while(block<E51AI_BLOCKS){
        let arm:i32=0;
        while(arm<4){
            let ws:i32=arm*E51AI_MODEL; let before:i32=e51ai_hash(weights,ws,E51AI_MODEL);
            let c:i32=0; while(c<E51AI_MODEL){ reverse_weights[ws+c]=weights[ws+c]; c=c+1; }
            // Audit exact experience mixture; all indices must be in seen training cohorts.
            let counts:[]i32=zalloc_i(4); e45_zero(counts,4); let p:i32=0; let schedule_gate:i32=1;
            while(p<E51AI_BATCH){
                let r:i32=e51ai_sample(arm,block,p);
                if(r<0 || r>=4*E51AI_EP){ schedule_gate=0; }else{
                    let cohort:i32=r/E51AI_EP; counts[cohort]=counts[cohort]+1;
                    if(block<4 && cohort>block){ schedule_gate=0; }
                }
                p=p+1;
            }
            _zag_print("e51ai_exposure,"); e45_print_i32(block+1); _zag_print(","); e45_print_i32(arm);
            c=0; while(c<4){ _zag_print(","); e45_print_i32(counts[c]); c=c+1; }
            _zag_print(","); e45_print_i32(schedule_gate); _zag_println(""); zfree(counts);
            if(schedule_gate!=1){ integrity=0; }
            let cand:i32=0;
            while(cand<2){
                let u:i32=0; let ru:i32=0; let il:i64=0; let fl:i64=0; let ril:i64=0; let rfl:i64=0;
                let fit:i32=e51ai_fit(train_x,train_targets,weights,ws+cand*65,arm,block,cand,0,E51AI_BATCH,&u,&il,&fl);
                let rfit:i32=e51ai_fit(train_x,train_targets,reverse_weights,ws+cand*65,arm,block,cand,1,E51AI_BATCH,&ru,&ril,&rfl);
                let same:i32=1; c=0;
                while(c<65){ if(weights[ws+cand*65+c]!=reverse_weights[ws+cand*65+c]){ same=0; } c=c+1; }
                if(u!=ru || il!=ril || fl!=rfl || fit!=1 || rfit!=1){ same=0; }
                if(same!=1){ integrity=0; }
                _zag_print("e51ai_fit,"); e45_print_i32(block+1); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(cand); _zag_print(","); e45_print_i32(u);
                _zag_print(","); e45_print_i64(il); _zag_print(","); e45_print_i64(fl); _zag_print(","); e45_print_i32(same); _zag_println("");
                cand=cand+1;
            }
            _zag_print("e51ai_continuity,"); e45_print_i32(block+1); _zag_print(","); e45_print_i32(arm); _zag_print(","); e45_print_i32(before); _zag_print(","); e45_print_i32(e51ai_hash(weights,ws,E51AI_MODEL)); _zag_println("");
            arm=arm+1;
        }
        if(integrity!=1){ _zag_println("e51ai_integrity_gate,0"); return 0; }
        e51ai_emit_weights(weights,block+1);
        let observed:i32=e51ai_evaluate(probe_x,probe_meta,weights,anchors,snapshot_outcomes,block+1,0);
        if(observed!=1){ integrity=0; }
        if(block==3){
            let c:i32=0; while(c<4*E51AI_MODEL){ snapshot[c]=weights[c]; c=c+1; }
            snapshot_hash=e51ai_hash(snapshot,0,4*E51AI_MODEL);
        }
        block=block+1;
    }
    let snapshot_gate:i32=e51ai_evaluate(probe_x,probe_meta,snapshot,anchors,snapshot_outcomes,32,1);
    if(snapshot_hash!=e51ai_hash(snapshot,0,4*E51AI_MODEL)){ snapshot_gate=0; }
    let data_freeze:i32=1;
    if(frozen_probe_hash!=e51ai_hash(probe_x,0,4*E51AI_STATES*64) || frozen_meta_hash!=e51ai_hash(probe_meta,0,4*E51AI_STATES*E51AI_META) ||
       train_hash!=e51ai_hash(train_x,0,4*E51AI_EP*64) || targets_hash!=e51ai_hash(train_targets,0,4*E51AI_EP*2)){ data_freeze=0; }
    let terminal_final:i32=e51y_terminal_hash(terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let direct_final:i32=e51ad_direct_hash(g0,b0,g1,b1,direct_lw,direct_lb);
    let frozen:i32=0; if(terminal_final==terminal_hash_before && direct_final==direct_hash_before){ frozen=1; }
    if(snapshot_gate!=1 || frozen!=1 || data_freeze!=1 || initial_probe!=1){ integrity=0; }
    e45_print_pair("e51ai_snapshot_identity_gate",snapshot_gate); e45_print_pair("e51ai_data_frozen_gate",data_freeze); e45_print_pair("e51ai_frozen_controllers_gate",frozen);
    e45_print_pair("e51ai_terminal_hash_final",terminal_final); e45_print_pair("e51ai_direct_hash_final",direct_final);
    e45_print_pair("e51ai_blocks_completed",block); e45_print_pair("e51ai_validation_executed",0); e45_print_pair("e51ai_confirmation_executed",0);
    e45_print_pair("e51ai_integrity_gate",integrity);
    if(integrity==1){ _zag_println("e51ai_outcome,LONGITUDINAL_CONTEXT_DIAGNOSTIC_COMPLETE"); }
    _zag_println("TNN_R32_E51AI_EXECUTION_COMPLETE=1");
    zfree(train_x); zfree(train_targets); zfree(probe_x); zfree(probe_meta); zfree(weights); zfree(reverse_weights); zfree(snapshot); zfree(anchors); zfree(snapshot_outcomes);
    zfree(g0); zfree(g1); zfree(direct_lw); zfree(direct_lb);
    return integrity;
}

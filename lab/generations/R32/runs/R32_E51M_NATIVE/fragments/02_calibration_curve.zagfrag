            }
        }
        sweep=sweep+1;
    }
    final_loss_low.*=e50_loss_low(current_loss);
    final_loss_high.*=e50_loss_high(current_loss);
    zfree(empty_means); zfree(empty_features); zfree(empty_directions); zfree(empty_coefficients);
}

fn e51m_compute_means(
    records:[]i32,
    count:i32,
    reverse:i32,
    means:[]i32,
    mean_start:i32,
    hash:*i32
)void {
    hash.*=509+count/17;
    let feature:i32=0;
    while(feature<E45_FEATURES){
        let sum:i64=0;
        let traversal:i32=0;
        while(traversal<count){
            let record_number:i32=traversal;
            if(reverse==1){ record_number=count-1-traversal; }
            sum=sum+(e51m_feature_value(records,record_number*E50_RECORD_N,feature) as i64);
            traversal=traversal+1;
        }
        means[mean_start+feature]=e50_round_nearest_i64(sum,count as i64) as i32;
        hash.*=e46_hash_update(hash.*,means[mean_start+feature]);
        feature=feature+1;
    }
}

fn e51m_hinge_basis(
    records:[]i32,
    record_start:i32,
    means:[]i32,
    mean_start:i32,
    feature:i32,
    direction:i32
)i32 {
    let value:i32=e51m_feature_value(records,record_start,feature);
    if(direction==0){
        if(value>means[mean_start+feature]){ return value-means[mean_start+feature]; }
    }else{
        if(value<means[mean_start+feature]){ return means[mean_start+feature]-value; }
    }
    return 0;
}

fn e51m_hinge_search(
    records:[]i32,
    targets:[]i32,
    count:i32,
    reverse:i32,
    linear_weights:[]i32,
    linear_bias:i32,
    means:[]i32,
    mean_start:i32,
    hinge_features:[]i32,
    hinge_directions:[]i32,
    hinge_coefficients:[]i32,
    hinge_start:i32,
    accepted_count:*i32,
    trace_hash:*i32,
    final_loss_low:*i32,
    final_loss_high:*i32
)void {
    let initialize:i32=0;
    while(initialize<E51M_HINGE_MAX){
        hinge_features[hinge_start+initialize]=0;
        hinge_directions[hinge_start+initialize]=0;
        hinge_coefficients[hinge_start+initialize]=0;
        initialize=initialize+1;
    }
    accepted_count.*=0;
    trace_hash.*=607+count/17;
    let raw_predictions:[]i32=zalloc_i(count);
    let selected:[]i32=zalloc_i(E51M_HINGE_CANDIDATES);
    let tried:[]i32=zalloc_i(E51M_HINGE_CANDIDATES);
    let correlations:[]i32=zalloc_i(E51M_HINGE_CANDIDATES);
    let squares:[]i32=zalloc_i(E51M_HINGE_CANDIDATES);
    let record_number:i32=0;
    while(record_number<count){
        raw_predictions[record_number]=e51m_linear_raw(
            records,record_number*E50_RECORD_N,linear_weights,0,linear_bias
        );
        record_number=record_number+1;
    }
    let current_loss:i64=0;
    record_number=0;
    while(record_number<count){
        let predicted:i32=r32e45_clamp(raw_predictions[record_number],-4000,4000);
        let residual:i32=r32e45_clamp(targets[record_number]-predicted,-3000,3000);
        current_loss=current_loss+(residual as i64)*(residual as i64);
        record_number=record_number+1;
    }
    trace_hash.*=e50_hash_loss(trace_hash.*,current_loss);
    let stopped:i32=0;
    while(accepted_count.*<E51M_HINGE_MAX && stopped==0){
        e45_zero(correlations,E51M_HINGE_CANDIDATES);
        e45_zero(squares,E51M_HINGE_CANDIDATES);
        let traversal:i32=0;
        while(traversal<count){
            record_number=traversal;
            if(reverse==1){ record_number=count-1-traversal; }
            let record_start:i32=record_number*E50_RECORD_N;
            let predicted:i32=r32e45_clamp(raw_predictions[record_number],-4000,4000);
            let residual:i32=r32e45_clamp(targets[record_number]-predicted,-3000,3000);
            let feature:i32=0;
            while(feature<E45_FEATURES){
                let direction:i32=0;
                while(direction<2){
                    let candidate:i32=feature*2+direction;
                    if(selected[candidate]==0){
                        let basis:i32=e51m_hinge_basis(records,record_start,means,mean_start,feature,direction);
                        correlations[candidate]=correlations[candidate]+residual*basis/1000;
                        squares[candidate]=squares[candidate]+basis*basis/1000;
                    }
                    direction=direction+1;
                }
                feature=feature+1;
            }
            traversal=traversal+1;
        }
        e45_zero(tried,E51M_HINGE_CANDIDATES);
        let accepted_this:i32=0;
        let attempt:i32=0;
        while(attempt<E51M_HINGE_CANDIDATES && accepted_this==0){
            let best_candidate:i32=-1;
            let best_coefficient:i32=0;
            let best_gain:i64=0;
            let candidate:i32=0;
            while(candidate<E51M_HINGE_CANDIDATES){
                if(selected[candidate]==0 && tried[candidate]==0 && squares[candidate]>0){
                    let coefficient:i32=e50_round_nearest_i64(
                        (correlations[candidate] as i64)*1000,
                        squares[candidate] as i64
                    ) as i32;
                    coefficient=r32e45_clamp(coefficient,-16000,16000);
                    if(coefficient!=0){
                        let term1:i64=2*(correlations[candidate] as i64)*(coefficient as i64);
                        let coefficient_square_scaled:i64=((coefficient as i64)*(coefficient as i64))/1000;
                        let term2:i64=(squares[candidate] as i64)*coefficient_square_scaled;
                        let gain:i64=term1-term2;
                        if(gain>best_gain){
                            best_gain=gain;
                            best_candidate=candidate;
                            best_coefficient=coefficient;
                        }
                    }
                }
                candidate=candidate+1;
            }
            if(best_candidate<0 || best_gain<=0){
                attempt=E51M_HINGE_CANDIDATES;
            }else{
                let feature:i32=best_candidate/2;
                let direction:i32=best_candidate%2;
                let candidate_loss:i64=0;
                traversal=0;
                while(traversal<count){
                    record_number=traversal;
                    if(reverse==1){ record_number=count-1-traversal; }
                    let record_start:i32=record_number*E50_RECORD_N;
                    let basis:i32=e51m_hinge_basis(records,record_start,means,mean_start,feature,direction);
                    let raw:i32=raw_predictions[record_number]+best_coefficient*basis/1000;
                    let predicted:i32=r32e45_clamp(raw,-4000,4000);
                    let residual:i32=r32e45_clamp(targets[record_number]-predicted,-3000,3000);
                    candidate_loss=candidate_loss+(residual as i64)*(residual as i64);
                    traversal=traversal+1;
                }
                if(candidate_loss<current_loss){
                    let slot:i32=accepted_count.*;
                    hinge_features[hinge_start+slot]=feature;
                    hinge_directions[hinge_start+slot]=direction;
                    hinge_coefficients[hinge_start+slot]=best_coefficient;
                    selected[best_candidate]=1;
                    traversal=0;
                    while(traversal<count){
                        record_number=traversal;
                        if(reverse==1){ record_number=count-1-traversal; }
                        let record_start:i32=record_number*E50_RECORD_N;
                        let basis:i32=e51m_hinge_basis(records,record_start,means,mean_start,feature,direction);
                        raw_predictions[record_number]=raw_predictions[record_number]+best_coefficient*basis/1000;
                        traversal=traversal+1;
                    }
                    current_loss=candidate_loss;
                    accepted_count.*=accepted_count.*+1;
                    trace_hash.*=e46_hash_update(trace_hash.*,feature);
                    trace_hash.*=e46_hash_update(trace_hash.*,direction);
                    trace_hash.*=e46_hash_update(trace_hash.*,best_coefficient);
                    trace_hash.*=e50_hash_loss(trace_hash.*,current_loss);
                    accepted_this=1;
                }else{
                    tried[best_candidate]=1;
                }
            }
            attempt=attempt+1;

    let e51ab_completion:i32=e51ab_run(
        source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,
        terminal_weights,terminal_biases,term_global,term_global_bias,
        prototypes,parents,ranges,finalw,finalb
    );
    e45_print_pair("e51ab_completion_gate",e51ab_completion);
    _zag_println("e51ab_standalone_direct_action_exit=1");
    return 1;

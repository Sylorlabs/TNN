__FUNCTION_KEYWORD__ e51n_pareto_pass(base_known:i32,base_unknown:i32,treatment_known:i32,treatment_unknown:i32)__RETURN_SUFFIX__{
    if(treatment_known<base_known){return 0;}
    if(treatment_unknown<base_unknown){return 0;}
    if(treatment_known==base_known && treatment_unknown==base_unknown){return 0;}
    return 1;
}

__FUNCTION_KEYWORD__ e51n_replication_gate(replica0:i32,replica1:i32,replica2:i32,pooled:i32)__RETURN_SUFFIX__{
    let passed:i32=0;
    if(replica0==1){passed=passed+1;}
    if(replica1==1){passed=passed+1;}
    if(replica2==1){passed=passed+1;}
    if(passed<2){return 0;}
    if(pooled!=1){return 0;}
    return 1;
}

__FUNCTION_KEYWORD__ e51n_contrast_replicated(
    r0_base_known:i32,r0_base_unknown:i32,r0_treat_known:i32,r0_treat_unknown:i32,
    r1_base_known:i32,r1_base_unknown:i32,r1_treat_known:i32,r1_treat_unknown:i32,
    r2_base_known:i32,r2_base_unknown:i32,r2_treat_known:i32,r2_treat_unknown:i32
)__RETURN_SUFFIX__{
    let r0:i32=e51n_pareto_pass(r0_base_known,r0_base_unknown,r0_treat_known,r0_treat_unknown);
    let r1:i32=e51n_pareto_pass(r1_base_known,r1_base_unknown,r1_treat_known,r1_treat_unknown);
    let r2:i32=e51n_pareto_pass(r2_base_known,r2_base_unknown,r2_treat_known,r2_treat_unknown);
    let base_known:i32=r0_base_known+r1_base_known+r2_base_known;
    let base_unknown:i32=r0_base_unknown+r1_base_unknown+r2_base_unknown;
    let treat_known:i32=r0_treat_known+r1_treat_known+r2_treat_known;
    let treat_unknown:i32=r0_treat_unknown+r1_treat_unknown+r2_treat_unknown;
    let pooled:i32=e51n_pareto_pass(base_known,base_unknown,treat_known,treat_unknown);
    return e51n_replication_gate(r0,r1,r2,pooled);
}

__FUNCTION_KEYWORD__ e51n_arm_count_pair_valid(known:i32,no_unique:i32)__RETURN_SUFFIX__{
    if(known<0 || known>4200){return 0;}
    if(no_unique<0 || no_unique>1200){return 0;}
    return 1;
}

__FUNCTION_KEYWORD__ e51n_exact_arm_pass(known:i32,no_unique:i32)__RETURN_SUFFIX__{
    if(known==4200 && no_unique==1200){return 1;}
    return 0;
}

__FUNCTION_KEYWORD__ e51n_replica_any_exact(
    arm0_known:i32,arm0_unknown:i32,
    arm1_known:i32,arm1_unknown:i32,
    arm2_known:i32,arm2_unknown:i32,
    arm3_known:i32,arm3_unknown:i32,
    arm4_known:i32,arm4_unknown:i32
)__RETURN_SUFFIX__{
    if(e51n_exact_arm_pass(arm0_known,arm0_unknown)==1){return 1;}
    if(e51n_exact_arm_pass(arm1_known,arm1_unknown)==1){return 1;}
    if(e51n_exact_arm_pass(arm2_known,arm2_unknown)==1){return 1;}
    if(e51n_exact_arm_pass(arm3_known,arm3_unknown)==1){return 1;}
    if(e51n_exact_arm_pass(arm4_known,arm4_unknown)==1){return 1;}
    return 0;
}

__FUNCTION_KEYWORD__ e51n_frozen_outcome_code(integrity:i32,dose_replicated:i32,capacity_replicated:i32,exact_any:i32)__RETURN_SUFFIX__{
    if(integrity!=1){return 4;}
    if(dose_replicated==1 && capacity_replicated==1){return 0;}
    if(dose_replicated==1){return 1;}
    if(capacity_replicated==1){return 2;}
    return 3;
}

fn e51p_run(
    source_trust:[]i32,
    dependence_penalty:[]i32,
    consequence:[]i32,
    hazard:[]i32,
    shadow_weights:[]i32,
    shadow_bias:i32
)i32 {
    _zag_println("R32_E51P_NATIVE v1");
    _zag_println("experiment_schema,tnn_r32_e51p_local_conditional_weight_experts_v1");
    _zag_println("claim_boundary,native_conditional_weight_diagnostic_not_promotion");
    _zag_println("native_zag_v2_only=1");
    _zag_println("evaluator_truth_exposed=0");
    _zag_println("ambiguity_label_exposed=0");
    _zag_println("validation_membership_exposed=0");
    _zag_println("unknown_positive_target=0");
    _zag_println("commit_order_changed=0");
    _zag_println("global_topology_changed=0");
    _zag_println("graph_privileged=0");

    let dev_worlds:[]i32=zalloc_i(E51P_DEV_EPISODES); let validation_worlds:[]i32=zalloc_i(E51P_VALIDATION_EPISODES); let confirmation_worlds:[]i32=zalloc_i(E51P_CONFIRM_EPISODES);
    let world_gate:i32=e51p_allocate_worlds(dev_worlds,validation_worlds,confirmation_worlds);

    let dev_records:[]i32=zalloc_i(E51P_DEV_SAMPLES*E50_RECORD_N); let dummy:[]i32=zalloc_i(E51P_DEV_SAMPLES*E50_RECORD_N);
    e45_zero(dev_records,E51P_DEV_SAMPLES*E50_RECORD_N); e45_zero(dummy,E51P_DEV_SAMPLES*E50_RECORD_N);
    let dev_unknown_nonzero:i32=0; let dummy_positive:i32=0; let dummy_negative:i32=0; let canonical_episode:i32=0;
    let epoch:i32=0;
    while(epoch<8){
        let base_index:i32=0;
        while(base_index<3){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<12){
                        let index:i32=e46_episode_index(epoch,base_index,mode,resource,episode);
                        e51e_build_training_episode(dev_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,dev_records,dummy,&dev_unknown_nonzero,&dummy_positive,&dummy_negative);
                        canonical_episode=canonical_episode+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        epoch=epoch+1;
    }
    zfree(dummy);
    e45_print_pair("e51p_development_episodes_built",canonical_episode); e45_print_pair("e51p_development_states_built",canonical_episode*(E45_TAPE+1)); e45_print_pair("e51p_dev_unknown_target_nonzero",dev_unknown_nonzero);

    // Frozen absolute-utility commit ordering: first 1x prefix only.
    let terminal_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let terminal_biases:[]i32=zalloc_i(E51E_MODELS*4);
    let backup_weights:[]i32=zalloc_i(4*E45_FEATURES); let backup_biases:[]i32=zalloc_i(4); let gram_f:[]i32=zalloc_i(E50_BATCH_GRAM); let gram_r:[]i32=zalloc_i(E50_BATCH_GRAM); let cross_f:[]i32=zalloc_i(E50_BATCH_CROSS); let cross_r:[]i32=zalloc_i(E50_BATCH_CROSS); let copy_weights:[]i32=zalloc_i(E51E_MODELS*4*E45_FEATURES); let copy_biases:[]i32=zalloc_i(E51E_MODELS*4);
    e45_zero(terminal_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(terminal_biases,E51E_MODELS*4); e45_zero(copy_weights,E51E_MODELS*4*E45_FEATURES); e45_zero(copy_biases,E51E_MODELS*4);
    let base_fit_gate:i32=e51e_fit_model(dev_records,0,0,terminal_weights,terminal_biases,backup_weights,backup_biases,gram_f,gram_r,cross_f,cross_r,copy_weights,copy_biases);
    let unknown_parameter_nonzero:i32=0; if(terminal_biases[3]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; }
    let feature:i32=0; while(feature<E45_FEATURES){ if(terminal_weights[3*E45_FEATURES+feature]!=0){ unknown_parameter_nonzero=unknown_parameter_nonzero+1; } feature=feature+1; }
    e45_print_pair("e51p_base_terminal_fit_identity_gate",base_fit_gate); e45_print_pair("e51p_base_unknown_parameter_nonzero",unknown_parameter_nonzero);

    let sign_targets:[]i32=zalloc_i(E51P_DEV_SAMPLES); let dev_positive:i32=0; let dev_negative:i32=0; let dev_neutral:i32=0;
    e51m_build_targets(dev_records,E51P_DEV_SAMPLES,terminal_weights,terminal_biases,sign_targets,&dev_positive,&dev_negative,&dev_neutral);
    _zag_print("e51p_dev_targets,"); e45_print_i32(dev_positive); _zag_print(","); e45_print_i32(dev_negative); _zag_print(","); e45_print_i32(dev_neutral); _zag_println("");

    // Shared full-4x global linear sign calibration.
    let global_weights:[]i32=zalloc_i(E45_FEATURES); let global_bias:i32=0; let ls_f:i32=0; let lr_f:i32=0; let lt_f:i32=0; let ll_f:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51P_DEV_SAMPLES,0,global_weights,0,&global_bias,&ls_f,&lr_f,&lt_f,&ll_f);
    let reverse_global:[]i32=zalloc_i(E45_FEATURES); let reverse_bias:i32=0; let ls_r:i32=0; let lr_r:i32=0; let lt_r:i32=0; let ll_r:i64=0;
    e51m_fit_scalar_linear(dev_records,sign_targets,E51P_DEV_SAMPLES,1,reverse_global,0,&reverse_bias,&ls_r,&lr_r,&lt_r,&ll_r);
    let linear_identity_gate:i32=e51m_linear_identity(global_weights,0,global_bias,reverse_global,0,reverse_bias,ls_f,ls_r,lr_f,lr_r,lt_f,lt_r,ll_f,ll_r);
    e45_print_pair("e51p_global_linear_identity_gate",linear_identity_gate);

    // Recruit one cumulative local routing tree with E51O's generic mechanism.
    let prototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let parents:[]i32=zalloc_i(E51O_MAX_CELLS); let scalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let scalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let scalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_f:i32=0; let tree_trace_f:i32=0; let tree_loss_f:i64=0; let tree_strict_f:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51P_DEV_SAMPLES,global_weights,0,global_bias,0,prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,&tree_count_f,&tree_trace_f,&tree_loss_f,&tree_strict_f);
    let rprototypes:[]i32=zalloc_i(E51O_MAX_CELLS*E45_FEATURES); let rparents:[]i32=zalloc_i(E51O_MAX_CELLS); let rscalar_snapshots:[]i32=zalloc_i(E51O_CAP_LEVELS*E51O_MAX_CELLS); let rscalar_counts:[]i32=zalloc_i(E51O_CAP_LEVELS); let rscalar_losses:[]i32=zalloc_i(E51O_CAP_LEVELS);
    let tree_count_r:i32=0; let tree_trace_r:i32=0; let tree_loss_r:i64=0; let tree_strict_r:i32=0;
    e51o_fit_local_memory(dev_records,sign_targets,E51P_DEV_SAMPLES,global_weights,0,global_bias,1,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,&tree_count_r,&tree_trace_r,&tree_loss_r,&tree_strict_r);
    let tree_identity_gate:i32=e51o_local_identity(prototypes,parents,scalar_snapshots,scalar_counts,scalar_losses,tree_count_f,tree_trace_f,tree_loss_f,tree_strict_f,rprototypes,rparents,rscalar_snapshots,rscalar_counts,rscalar_losses,tree_count_r,tree_trace_r,tree_loss_r,tree_strict_r);
    e45_print_pair("e51p_routing_tree_identity_gate",tree_identity_gate); e45_print_pair("e51p_routing_tree_cells",tree_count_f);
    let ranges:[]i32=zalloc_i(E45_FEATURES); let root:[]i32=zalloc_i(E45_FEATURES); e51o_feature_stats(dev_records,E51P_DEV_SAMPLES,root,ranges);

    // Fit independent expert banks for each routing capacity.
    let expert_weights:[]i32=zalloc_i(E51P_CAP_LEVELS*E51P_MAX_CELLS*E45_FEATURES); let expert_biases:[]i32=zalloc_i(E51P_CAP_LEVELS*E51P_MAX_CELLS);
    let expert_identity_gate:i32=1; let expert_strict_gate:i32=1;
    let expert_updates:[]i32=zalloc_i(E51P_CAP_LEVELS); let expert_sweeps:[]i32=zalloc_i(E51P_CAP_LEVELS); let expert_loss_hash:[]i32=zalloc_i(E51P_CAP_LEVELS);
    let level:i32=0;
    while(level<E51P_CAP_LEVELS){
        let cells:i32=e51p_capacity(level); let ws:i32=level*E51P_MAX_CELLS*E45_FEATURES; let bs:i32=level*E51P_MAX_CELLS;
        let updates_f:i32=0; let sweeps_f:i32=0; let reason_f:i32=0; let trace_f:i32=0; let loss_f:i64=0; let strict_f:i32=0;
        e51p_fit_experts(dev_records,sign_targets,E51P_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,cells,0,expert_weights,ws,expert_biases,bs,&updates_f,&sweeps_f,&reason_f,&trace_f,&loss_f,&strict_f);
        let rw:[]i32=zalloc_i(E51P_MAX_CELLS*E45_FEATURES); let rb:[]i32=zalloc_i(E51P_MAX_CELLS); let updates_r:i32=0; let sweeps_r:i32=0; let reason_r:i32=0; let trace_r:i32=0; let loss_r:i64=0; let strict_r:i32=0;
        e51p_fit_experts(dev_records,sign_targets,E51P_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,cells,1,rw,0,rb,0,&updates_r,&sweeps_r,&reason_r,&trace_r,&loss_r,&strict_r);
        let id:i32=e51p_expert_identity(expert_weights,ws,expert_biases,bs,rw,0,rb,0,cells,updates_f,updates_r,sweeps_f,sweeps_r,reason_f,reason_r,trace_f,trace_r,loss_f,loss_r,strict_f,strict_r);
        if(id==0){ expert_identity_gate=0; } if(strict_f==0 || strict_r==0){ expert_strict_gate=0; }
        expert_updates[level]=updates_f; expert_sweeps[level]=sweeps_f; expert_loss_hash[level]=e51m_hash_i64(loss_f);
        _zag_print("e51p_fit,"); e45_print_i32(level); _zag_print(","); e45_print_i32(cells); _zag_print(","); e45_print_i32(updates_f); _zag_print(","); e45_print_i32(sweeps_f); _zag_print(","); e45_print_i32(reason_f); _zag_print(","); e45_print_i32(trace_f); _zag_print(","); e45_print_i32(expert_loss_hash[level]); _zag_print(","); e45_print_i32(id); _zag_print(","); e45_print_i32(strict_f); _zag_println("");
        zfree(rw); zfree(rb); level=level+1;
    }
    e45_print_pair("e51p_expert_forward_reverse_identity_gate",expert_identity_gate); e45_print_pair("e51p_expert_strict_loss_gate",expert_strict_gate);

    // Fresh validation worlds.
    let validation_records:[]i32=zalloc_i(E51P_VALIDATION_SAMPLES*E50_RECORD_N); let validation_dummy:[]i32=zalloc_i(E51P_VALIDATION_SAMPLES*E50_RECORD_N); let validation_types:[]i32=zalloc_i(E51P_VALIDATION_EPISODES); let validation_targets:[]i32=zalloc_i(E51P_VALIDATION_SAMPLES);
    e45_zero(validation_records,E51P_VALIDATION_SAMPLES*E50_RECORD_N); e45_zero(validation_dummy,E51P_VALIDATION_SAMPLES*E50_RECORD_N);
    let validation_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0; let base_index:i32=0;
    while(base_index<6){
        let mode:i32=0;
        while(mode<E45_MODES){
            let resource:i32=0;
            while(resource<E45_RESOURCES){
                let episode:i32=0;
                while(episode<20){
                    let index:i32=e46_validation_index(base_index,mode,resource,episode);
                    validation_types[canonical_episode]=0; if(mode==0 || mode==1){ validation_types[canonical_episode]=1; }
                    e51e_build_training_episode(validation_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,validation_records,validation_dummy,&validation_unknown_nonzero,&dummy_positive,&dummy_negative);
                    canonical_episode=canonical_episode+1; episode=episode+1;
                }
                resource=resource+1;
            }
            mode=mode+1;
        }
        base_index=base_index+1;
    }
    zfree(validation_dummy); e51m_build_validation_targets(validation_records,E51P_VALIDATION_SAMPLES,terminal_weights,terminal_biases,validation_targets);
    e45_print_pair("e51p_validation_episodes_built",canonical_episode); e45_print_pair("e51p_validation_states_built",canonical_episode*(E45_TAPE+1)); e45_print_pair("e51p_validation_unknown_target_nonzero",validation_unknown_nonzero);

    let bkt:i32=0; let bkr:i32=0; let bnt:i32=0; let bnr:i32=0;
    e51m_reachability(validation_records,validation_types,E51P_VALIDATION_EPISODES,terminal_weights,terminal_biases,0,global_weights,0,global_bias,prototypes,parents,ranges,0,0,&bkt,&bkr,&bnt,&bnr);
    _zag_print("e51p_control_base,"); e45_print_i32(bkr); _zag_print(","); e45_print_i32(bkt); _zag_print(","); e45_print_i32(bnr); _zag_print(","); e45_print_i32(bnt); _zag_println("");
    let lkt:i32=0; let lkr:i32=0; let lnt:i32=0; let lnr:i32=0;
    e51m_reachability(validation_records,validation_types,E51P_VALIDATION_EPISODES,terminal_weights,terminal_biases,1,global_weights,0,global_bias,prototypes,parents,ranges,0,0,&lkt,&lkr,&lnt,&lnr);
    _zag_print("e51p_control_linear,"); e45_print_i32(lkr); _zag_print(","); e45_print_i32(lkt); _zag_print(","); e45_print_i32(lnr); _zag_print(","); e45_print_i32(lnt); _zag_println("");
    let skt:i32=0; let skr:i32=0; let snt:i32=0; let snr:i32=0;
    e51o_local_reachability(validation_records,validation_types,E51P_VALIDATION_EPISODES,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,scalar_snapshots,3*E51O_MAX_CELLS,scalar_counts[3],&skt,&skr,&snt,&snr);
    _zag_print("e51p_control_scalar64,"); e45_print_i32(skr); _zag_print(","); e45_print_i32(skt); _zag_print(","); e45_print_i32(snr); _zag_print(","); e45_print_i32(snt); _zag_println("");

    let result_known:[]i32=zalloc_i(E51P_CAP_LEVELS); let result_unknown:[]i32=zalloc_i(E51P_CAP_LEVELS); let exact_gate:i32=0; let winning_level:i32=-1;
    level=0;
    while(level<E51P_CAP_LEVELS){
        let cells:i32=e51p_capacity(level); let ws:i32=level*E51P_MAX_CELLS*E45_FEATURES; let bs:i32=level*E51P_MAX_CELLS;
        let dpt:i32=0; let dpc:i32=0; let dnt:i32=0; let dnc:i32=0;
        e51p_expert_sign_accuracy(dev_records,sign_targets,E51P_DEV_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,cells,expert_weights,ws,expert_biases,bs,&dpt,&dpc,&dnt,&dnc);
        let vpt:i32=0; let vpc:i32=0; let vnt:i32=0; let vnc:i32=0;
        e51p_expert_sign_accuracy(validation_records,validation_targets,E51P_VALIDATION_SAMPLES,global_weights,global_bias,prototypes,parents,ranges,cells,expert_weights,ws,expert_biases,bs,&vpt,&vpc,&vnt,&vnc);
        let kt:i32=0; let kr:i32=0; let nt:i32=0; let nr:i32=0;
        e51p_expert_reachability(validation_records,validation_types,E51P_VALIDATION_EPISODES,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,cells,expert_weights,ws,expert_biases,bs,&kt,&kr,&nt,&nr);
        result_known[level]=kr; result_unknown[level]=nr;
        if(exact_gate==0 && kr==kt && nr==nt){ exact_gate=1; winning_level=level; }
        let memory_units:i32=cells*66; let routing_ops:i32=E51P_VALIDATION_SAMPLES*r32e45_max(0,cells-1)*2*E45_FEATURES;
        _zag_print("e51p_arm,"); e45_print_i32(level); _zag_print(","); e45_print_i32(cells); _zag_print(","); e45_print_i32(memory_units); _zag_print(","); e45_print_i32(routing_ops); _zag_print(","); e45_print_i32(dpc); _zag_print(","); e45_print_i32(dpt); _zag_print(","); e45_print_i32(dnc); _zag_print(","); e45_print_i32(dnt); _zag_print(","); e45_print_i32(vpc); _zag_print(","); e45_print_i32(vpt); _zag_print(","); e45_print_i32(vnc); _zag_print(","); e45_print_i32(vnt); _zag_print(","); e45_print_i32(kr); _zag_print(","); e45_print_i32(kt); _zag_print(","); e45_print_i32(nr); _zag_print(","); e45_print_i32(nt); _zag_println("");
        level=level+1;
    }

    let monotone:i32=1; let strict:i32=0; level=1;
    while(level<E51P_CAP_LEVELS){
        if(result_known[level]<result_known[level-1] || result_unknown[level]<result_unknown[level-1]){ monotone=0; }
        if(result_known[level]>result_known[level-1] || result_unknown[level]>result_unknown[level-1]){ strict=1; }
        level=level+1;
    }
    let capacity_signal:i32=0; if(monotone==1 && strict==1){ capacity_signal=1; }
    let tradeoff:i32=0; level=0;
    while(level<E51P_CAP_LEVELS){
        if((result_unknown[level]>bnr && result_known[level]<bkr) || (result_known[level]>bkr && result_unknown[level]<bnr)){ tradeoff=1; }
        level=level+1;
    }

    let counts_gate:i32=0; if(E51P_DEV_EPISODES*(E45_TAPE+1)==E51P_DEV_SAMPLES && canonical_episode==E51P_VALIDATION_EPISODES){ counts_gate=1; }
    let target_gate:i32=0; if(dev_unknown_nonzero==0 && validation_unknown_nonzero==0 && unknown_parameter_nonzero==0 && dev_positive>0 && dev_negative>0){ target_gate=1; }
    let integrity_gate:i32=0; if(world_gate==1 && counts_gate==1 && target_gate==1 && base_fit_gate==1 && linear_identity_gate==1 && tree_identity_gate==1 && tree_strict_f==1 && expert_identity_gate==1 && expert_strict_gate==1){ integrity_gate=1; }
    e45_print_pair("e51p_counts_gate",counts_gate); e45_print_pair("e51p_target_geometry_gate",target_gate); e45_print_pair("e51p_integrity_gate",integrity_gate); e45_print_pair("e51p_exact_validation_gate",exact_gate); e45_print_pair("e51p_monotone_capacity_signal",capacity_signal); e45_print_pair("e51p_tradeoff_signal",tradeoff); e45_print_pair("e51p_winning_level",winning_level);

    let confirmation_executed:i32=0; let confirmation_exact:i32=0;
    if(integrity_gate==1 && exact_gate==1 && winning_level>=0){
        let confirm_records:[]i32=zalloc_i(E51P_CONFIRM_SAMPLES*E50_RECORD_N); let confirm_dummy:[]i32=zalloc_i(E51P_CONFIRM_SAMPLES*E50_RECORD_N); let confirm_types:[]i32=zalloc_i(E51P_CONFIRM_EPISODES);
        e45_zero(confirm_records,E51P_CONFIRM_SAMPLES*E50_RECORD_N); e45_zero(confirm_dummy,E51P_CONFIRM_SAMPLES*E50_RECORD_N);
        let confirm_unknown_nonzero:i32=0; dummy_positive=0; dummy_negative=0; canonical_episode=0; base_index=0;
        while(base_index<6){
            let mode:i32=0;
            while(mode<E45_MODES){
                let resource:i32=0;
                while(resource<E45_RESOURCES){
                    let episode:i32=0;
                    while(episode<40){
                        let index:i32=e46_confirm_index(base_index,mode,resource,episode);
                        confirm_types[canonical_episode]=0; if(mode==0 || mode==1){ confirm_types[canonical_episode]=1; }
                        e51e_build_training_episode(confirmation_worlds[index],mode,resource,canonical_episode,source_trust,dependence_penalty,consequence,hazard,shadow_weights,shadow_bias,confirm_records,confirm_dummy,&confirm_unknown_nonzero,&dummy_positive,&dummy_negative);
                        canonical_episode=canonical_episode+1; episode=episode+1;
                    }
                    resource=resource+1;
                }
                mode=mode+1;
            }
            base_index=base_index+1;
        }
        let cells:i32=e51p_capacity(winning_level); let ws:i32=winning_level*E51P_MAX_CELLS*E45_FEATURES; let bs:i32=winning_level*E51P_MAX_CELLS;
        let kt:i32=0; let kr:i32=0; let nt:i32=0; let nr:i32=0;
        e51p_expert_reachability(confirm_records,confirm_types,E51P_CONFIRM_EPISODES,terminal_weights,terminal_biases,global_weights,global_bias,prototypes,parents,ranges,cells,expert_weights,ws,expert_biases,bs,&kt,&kr,&nt,&nr);
        confirmation_executed=canonical_episode; if(kr==kt && nr==nt && confirm_unknown_nonzero==0){ confirmation_exact=1; }
        _zag_print("e51p_confirmation,"); e45_print_i32(winning_level); _zag_print(","); e45_print_i32(cells); _zag_print(","); e45_print_i32(kr); _zag_print(","); e45_print_i32(kt); _zag_print(","); e45_print_i32(nr); _zag_print(","); e45_print_i32(nt); _zag_print(","); e45_print_i32(confirm_unknown_nonzero); _zag_println("");
        zfree(confirm_records); zfree(confirm_dummy); zfree(confirm_types);
    }
    e45_print_pair("e51p_sealed_confirmation_executed",confirmation_executed); e45_print_pair("e51p_confirmation_exact_gate",confirmation_exact);

    if(integrity_gate==0){ _zag_println("e51p_outcome,INVALID_LOCAL_WEIGHT_EXPERT_INTEGRITY_FAILURE");
    }else{
        if(exact_gate==1 && confirmation_exact==1){ _zag_println("e51p_outcome,LOCAL_WEIGHT_EXPERT_RESCUE_CONFIRMED");
        }else{
            if(exact_gate==1){ _zag_println("e51p_outcome,LOCAL_WEIGHT_EXPERT_VALIDATION_RESCUE_CONFIRMATION_FAIL");
            }else{
                if(capacity_signal==1){ _zag_println("e51p_outcome,LOCAL_WEIGHT_EXPERT_CAPACITY_SIGNAL");
                }else{
                    if(tradeoff==1){ _zag_println("e51p_outcome,LOCAL_WEIGHT_EXPERT_TRADEOFF");
                    }else{ _zag_println("e51p_outcome,LOCAL_WEIGHT_EXPERT_PLATEAU"); }
                }
            }
        }
    }
    _zag_println("TNN_R32_E51P_EXECUTION_COMPLETE=1");

    zfree(dev_worlds); zfree(validation_worlds); zfree(confirmation_worlds); zfree(dev_records); zfree(sign_targets);
    zfree(terminal_weights); zfree(terminal_biases); zfree(backup_weights); zfree(backup_biases); zfree(gram_f); zfree(gram_r); zfree(cross_f); zfree(cross_r); zfree(copy_weights); zfree(copy_biases);
    zfree(global_weights); zfree(reverse_global); zfree(prototypes); zfree(parents); zfree(scalar_snapshots); zfree(scalar_counts); zfree(scalar_losses); zfree(rprototypes); zfree(rparents); zfree(rscalar_snapshots); zfree(rscalar_counts); zfree(rscalar_losses); zfree(ranges); zfree(root);
    zfree(expert_weights); zfree(expert_biases); zfree(expert_updates); zfree(expert_sweeps); zfree(expert_loss_hash); zfree(validation_records); zfree(validation_types); zfree(validation_targets); zfree(result_known); zfree(result_unknown);
    return 1;
}

// R32 E51AE — trajectory-critical direct-candidate residual support.
// Frozen E51Y/E51X mature slot controller and frozen E51AB local-384 direct
// candidate learner remain unchanged. Treatment adds only learner-owned residual
// candidate value heads over the existing 32 evaluator-blind terminal features.

const E51AE_STAGE_DEV:i32=97;
const E51AE_STAGE_VALIDATION:i32=98;
const E51AE_STAGE_CONFIRM:i32=99;
const E51AE_PREVIOUS_STAGE:i32=96;
const E51AE_DEV_EPISODES:i32=12960;
const E51AE_DEV_SAMPLES:i32=220320;
const E51AE_VALIDATION_EPISODES:i32=5400;
const E51AE_VALIDATION_SAMPLES:i32=91800;
const E51AE_CONFIRM_EPISODES:i32=10800;
const E51AE_CONFIRM_SAMPLES:i32=183600;
const E51AE_CELLS:i32=32;
const E51AE_MAX_ROUNDS:i32=4;
const E51AE_MAX_CRITICAL:i32=25920;
const E51AE_KIND_SLOT_COVERED:i32=0;
const E51AE_KIND_DIRECT_REQUIRED:i32=1;
const E51AE_KIND_NEITHER_KNOWN:i32=2;
const E51AE_KIND_NEITHER_NU:i32=3;
const E51AE_ARMS:i32=5;
const E51AE_ARM_UNION_CONTROL:i32=0;
const E51AE_ARM_GLOBAL:i32=1;
const E51AE_ARM_LOCAL_96:i32=2;
const E51AE_ARM_LOCAL_384:i32=3;
const E51AE_ARM_DIRECT_ORACLE:i32=4;
const E51AE_FIELDS:i32=9;
const E51AE_EPISODES:i32=0;
const E51AE_REACHABLE:i32=1;
const E51AE_KNOWN:i32=2;
const E51AE_KNOWN_REACHABLE:i32=3;
const E51AE_NO_UNIQUE:i32=4;
const E51AE_NO_UNIQUE_REACHABLE:i32=5;
const E51AE_T0_SUCCESS:i32=6;
const E51AE_T0_UNKNOWN:i32=7;
const E51AE_T0_WRONG:i32=8;

fn e51ae_dose(arm:i32)i32 {
    if(arm==E51AE_ARM_LOCAL_96){ return 96; }
    return 384;
}

fn e51ae_world_gate()i32 {
    let prev_hi:i32=e51n_world_id(E51AE_PREVIOUS_STAGE,E51AD_CONFIRM_EPISODES-1);
    let dlo:i32=e51n_world_id(E51AE_STAGE_DEV,0); let dhi:i32=e51n_world_id(E51AE_STAGE_DEV,E51AE_DEV_EPISODES-1);
    let vlo:i32=e51n_world_id(E51AE_STAGE_VALIDATION,0); let vhi:i32=e51n_world_id(E51AE_STAGE_VALIDATION,E51AE_VALIDATION_EPISODES-1);
    let clo:i32=e51n_world_id(E51AE_STAGE_CONFIRM,0); let chi:i32=e51n_world_id(E51AE_STAGE_CONFIRM,E51AE_CONFIRM_EPISODES-1);
    let partition:i32=0; if(prev_hi<dlo && dhi<vlo && vhi<clo){ partition=1; }
    let domains:i32=1; let d:i32=0;
    while(d<5){
        let lo:i64=e51n_domain_state(dlo,d); let hi:i64=e51n_domain_state(chi,d);
        if(lo<=0 || hi>=E51N_RNG_MOD){ domains=0; }
        let o:i32=d+1;
        while(o<5){
            let olo:i64=e51n_domain_state(dlo,o); let ohi:i64=e51n_domain_state(chi,o);
            if(!(hi<olo || ohi<lo)){ domains=0; }
            o=o+1;
        }
        d=d+1;
    }
    e45_print_pair("e51ae_world_id_dev_lo",dlo); e45_print_pair("e51ae_world_id_dev_hi",dhi);
    e45_print_pair("e51ae_world_id_validation_lo",vlo); e45_print_pair("e51ae_world_id_validation_hi",vhi);
    e45_print_pair("e51ae_world_id_confirmation_lo",clo); e45_print_pair("e51ae_world_id_confirmation_hi",chi);
    e45_print_pair("e51ae_world_partition_gate",partition); e45_print_pair("e51ae_domain_gate",domains);
    e45_print_pair("e51ae_world_assignment_failures",0);
    if(partition==1 && domains==1){ return 1; }
    return 0;
}

fn e51ae_build_accessible(stage:i32,episodes:i32,per_cell:i32,accessible:[]i32)void {
    e45_zero(accessible,episodes*(E45_TAPE+1));
    let episode:i32=0;
    while(episode<episodes){
        let resource:i32=e45_mod(episode/per_cell,E45_RESOURCES);
        let history_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let history_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let future_cost:[]i32=zalloc_i(E45_RESOURCE_ITEMS); let future_reward:[]i32=zalloc_i(E45_RESOURCE_ITEMS);
        let step_loss:[]i32=zalloc_i(E45_TAPE); let feasible:[]i32=zalloc_i(E45_TAPE);
        let budget:i32=0; let action_cost:i32=0;
        e51n_make_resource(e51n_world_id(stage,episode),resource,history_cost,history_reward,future_cost,future_reward,&budget,&action_cost);
        e45_build_step_losses(future_cost,future_reward,budget,action_cost,step_loss,feasible);
        let open:i32=1; let t:i32=0;
        while(t<=E45_TAPE){
            if(open==1){ accessible[episode*(E45_TAPE+1)+t]=1; }
            if(t<E45_TAPE){ if(open==1 && feasible[t]==1){ open=1; }else{ open=0; } }
            t=t+1;
        }
        zfree(history_cost); zfree(history_reward); zfree(future_cost); zfree(future_reward); zfree(step_loss); zfree(feasible);
        episode=episode+1;
    }
}

fn e51ae_classify_kinds(base_kinds:[]i32,episodes:i32,per_cell:i32,kinds:[]i32,slot_count:*i32,direct_count:*i32,neither_known:*i32,neither_nu:*i32)void {
    slot_count.*=0; direct_count.*=0; neither_known.*=0; neither_nu.*=0;
    let episode:i32=0;
    while(episode<episodes){
        if(base_kinds[episode]==E51AD_KIND_PRESERVE){ kinds[episode]=E51AE_KIND_SLOT_COVERED; slot_count.*=slot_count.*+1;
        }else{ if(base_kinds[episode]==E51AD_KIND_DIRECT_ONLY){ kinds[episode]=E51AE_KIND_DIRECT_REQUIRED; direct_count.*=direct_count.*+1;
            }else{
                let mode:i32=e45_mod(episode/(E45_RESOURCES*per_cell),E45_MODES);
                if(mode==0 || mode==1){ kinds[episode]=E51AE_KIND_NEITHER_NU; neither_nu.*=neither_nu.*+1;
                }else{ kinds[episode]=E51AE_KIND_NEITHER_KNOWN; neither_known.*=neither_known.*+1; }
            }
        }
        episode=episode+1;
    }
}

fn e51ae_residual_score(
    candidate:i32,local_active:i32,records:[]i32,record_start:i32,
    rg0:[]i32,rb0:i32,rg1:[]i32,rb1:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    local_weights:[]i32,local_biases:[]i32
)i32 {
    let gw:[]i32=rg0; let gb:i32=rb0;
    if(candidate==1){ gw=rg1; gb=rb1; }
    if(local_active==0){ return e51m_linear_scalar_predict(records,record_start,gw,0,gb); }
    let ws:i32=candidate*E51AE_CELLS*E45_FEATURES; let bs:i32=candidate*E51AE_CELLS;
    return e51p_expert_predict(records,record_start,gw,gb,prototypes,parents,ranges,E51AE_CELLS,local_weights,ws,local_biases,bs);
}

fn e51ae_treatment_scores(
    local_active:i32,direct_records:[]i32,record_start:i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,
    direct_weights:[]i32,direct_biases:[]i32,
    rg0:[]i32,rb0:i32,rg1:[]i32,rb1:i32,
    local_weights:[]i32,local_biases:[]i32,
    q0:*i32,q1:*i32
)void {
    let f0:i32=0; let f1:i32=0;
    e51ac_direct_scores(direct_records,record_start,g0,b0,g1,b1,prototypes,parents,ranges,direct_weights,direct_biases,&f0,&f1);
    let r0:i32=e51ae_residual_score(0,local_active,direct_records,record_start,rg0,rb0,rg1,rb1,prototypes,parents,ranges,local_weights,local_biases);
    let r1:i32=e51ae_residual_score(1,local_active,direct_records,record_start,rg0,rb0,rg1,rb1,prototypes,parents,ranges,local_weights,local_biases);
    q0.*=f0+r0; q1.*=f1+r1;
}

fn e51ae_candidate_margin(q0:i32,q1:i32,direct_records:[]i32,record_start:i32)i32 {
    if(direct_records[record_start+34]>0){
        let other:i32=q1; if(other<0){ other=0; }
        return q0-other;
    }
    if(direct_records[record_start+35]>0){
        let other:i32=q0; if(other<0){ other=0; }
        return q1-other;
    }
    let high:i32=q0; if(q1>high){ high=q1; } if(high<0){ high=0; }
    return -high;
}

fn e51ae_policy_choice(
    local_active:i32,control_records:[]i32,direct_records:[]i32,record_start:i32,
    terminal_weights:[]i32,terminal_biases:[]i32,term_global:[]i32,term_global_bias:i32,
    prototypes:[]i32,parents:[]i32,ranges:[]i32,term_expert_w:[]i32,term_expert_b:[]i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,direct_weights:[]i32,direct_biases:[]i32,
    rg0:[]i32,rb0:i32,rg1:[]i32,rb1:i32,local_weights:[]i32,local_biases:[]i32
)i32 {
    let slot_choice:i32=e51y_terminal_choice(control_records,record_start,terminal_weights,terminal_biases,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let slot_value:i32=e51ac_slot_scalar(control_records,record_start,term_global,term_global_bias,prototypes,parents,ranges,term_expert_w,term_expert_b);
    let choice:i32=slot_choice; let best:i32=slot_value;
    if(best<0){ choice=R32E45_TERM_UNKNOWN; best=0; }
    let q0:i32=0; let q1:i32=0;
    e51ae_treatment_scores(local_active,direct_records,record_start,g0,b0,g1,b1,prototypes,parents,ranges,direct_weights,direct_biases,rg0,rb0,rg1,rb1,local_weights,local_biases,&q0,&q1);
    if(q0>best){ choice=E51AC_CHOICE_CANDIDATE_0; best=q0; }
    if(q1>best){ choice=E51AC_CHOICE_CANDIDATE_1; }
    return choice;
}

fn e51ae_select_critical(
    direct_records:[]i32,episodes:i32,accessible:[]i32,direct_success:[]i32,kinds:[]i32,neither_copies:i32,
    local_active:i32,
    g0:[]i32,b0:i32,g1:[]i32,b1:i32,prototypes:[]i32,parents:[]i32,ranges:[]i32,direct_weights:[]i32,direct_biases:[]i32,
    rg0:[]i32,rb0:i32,rg1:[]i32,rb1:i32,local_weights:[]i32,local_biases:[]i32,
    critical_records:[]i32,target0:[]i32,target1:[]i32,
    selected_count:*i32,trace_hash:*i32,support:[]i32
)void {
    selected_count.*=0; trace_hash.*=7103; e45_zero(support,6);
    let episode:i32=0;
    while(episode<episodes){
        let kind:i32=kinds[episode];
        if(kind!=E51AE_KIND_SLOT_COVERED){
            let selected:i32=-1; let best_margin:i32=0; let t:i32=0;
            while(t<=E45_TAPE){
                let index:i32=episode*(E45_TAPE+1)+t; let eligible:i32=0;
                if(kind==E51AE_KIND_DIRECT_REQUIRED){ eligible=direct_success[index];
                }else{ if(accessible[index]==1){
                        if(kind==E51AE_KIND_NEITHER_KNOWN){ let rs0:i32=index*E50_RECORD_N; if(e51ab_max_utility(direct_records,rs0)>0){ eligible=1; }
                        }else{ eligible=1; }
                    }
                }
                if(eligible==1){
                    let rs:i32=index*E50_RECORD_N; let q0:i32=0; let q1:i32=0;
                    e51ae_treatment_scores(local_active,direct_records,rs,g0,b0,g1,b1,prototypes,parents,ranges,direct_weights,direct_biases,rg0,rb0,rg1,rb1,local_weights,local_biases,&q0,&q1);
                    let margin:i32=e51ae_candidate_margin(q0,q1,direct_records,rs);
                    if(selected<0){ selected=index; best_margin=margin;
                    }else{ if(kind==E51AE_KIND_DIRECT_REQUIRED){ if(margin<best_margin){ selected=index; best_margin=margin; }
                        }else{ if(margin>best_margin){ selected=index; best_margin=margin; } }
                    }
                }
                t=t+1;
            }
            if(selected>=0){
                let rs:i32=selected*E50_RECORD_N; let f0:i32=0; let f1:i32=0;
                e51ac_direct_scores(direct_records,rs,g0,b0,g1,b1,prototypes,parents,ranges,direct_weights,direct_biases,&f0,&f1);
                let rt0:i32=direct_records[rs+34]-f0; let rt1:i32=direct_records[rs+35]-f1;
                let copies:i32=1; if(kind==E51AE_KIND_NEITHER_KNOWN || kind==E51AE_KIND_NEITHER_NU){ copies=neither_copies; }
                let copy:i32=0;
                while(copy<copies){
                    let dst:i32=selected_count.* * E50_RECORD_N; let c:i32=0;
                    while(c<E50_RECORD_N){ critical_records[dst+c]=direct_records[rs+c]; c=c+1; }
                    critical_records[dst+34]=0; critical_records[dst+35]=0; critical_records[dst+36]=0; critical_records[dst+37]=0;
                    target0[selected_count.*]=rt0; target1[selected_count.*]=rt1;
                    if(rt0>0){ support[0]=support[0]+1; }else{ if(rt0<0){ support[1]=support[1]+1; }else{ support[2]=support[2]+1; } }
                    if(rt1>0){ support[3]=support[3]+1; }else{ if(rt1<0){ support[4]=support[4]+1; }else{ support[5]=support[5]+1; } }
                    selected_count.*=selected_count.*+1; copy=copy+1;
                }
                trace_hash.*=e46_hash_update(trace_hash.*,episode); trace_hash.*=e46_hash_update(trace_hash.*,kind);
                trace_hash.*=e46_hash_update(trace_hash.*,selected); trace_hash.*=e46_hash_update(trace_hash.*,best_margin);
                trace_hash.*=e46_hash_update(trace_hash.*,rt0); trace_hash.*=e46_hash_update(trace_hash.*,rt1); trace_hash.*=e46_hash_update(trace_hash.*,copies);
            }
        }
        episode=episode+1;
    }
}

fn e51ae_critical_hash(records:[]i32,target0:[]i32,target1:[]i32,count:i32)i32 {
    let h:i32=7121; let i:i32=0;
    while(i<count){
        h=e46_hash_update(h,target0[i]); h=e46_hash_update(h,target1[i]);
        let c:i32=0; while(c<E50_RECORD_N){ h=e46_hash_update(h,records[i*E50_RECORD_N+c]); c=c+1; }
        i=i+1;
    }
    return h;
}

fn e51ae_record_isolation(records:[]i32,count:i32)i32 {
    let i:i32=0;
    while(i<count){ let rs:i32=i*E50_RECORD_N; if(records[rs+34]!=0 || records[rs+35]!=0 || records[rs+36]!=0 || records[rs+37]!=0){ return 0; } i=i+1; }
    return 1;
}

fn e51ae_model_hash(rg0:[]i32,rb0:i32,rg1:[]i32,rb1:i32,local_weights:[]i32,local_biases:[]i32)i32 {
    let h:i32=7151; let f:i32=0;
    while(f<E45_FEATURES){ h=e46_hash_update(h,rg0[f]); h=e46_hash_update(h,rg1[f]); f=f+1; }
    h=e46_hash_update(h,rb0); h=e46_hash_update(h,rb1);
    let n:i32=E51AB_CANDIDATES*E51AE_CELLS*E45_FEATURES; let i:i32=0;
    while(i<n){ h=e46_hash_update(h,local_weights[i]); i=i+1; }
    i=0; while(i<E51AB_CANDIDATES*E51AE_CELLS){ h=e46_hash_update(h,local_biases[i]); i=i+1; }
    return h;
}

fn e51ae_local_equal(a_w:[]i32,a_b:[]i32,b_w:[]i32,b_b:[]i32)i32 {
    let i:i32=0; let n:i32=E51AB_CANDIDATES*E51AE_CELLS*E45_FEATURES;
    while(i<n){ if(a_w[i]!=b_w[i]){ return 0; } i=i+1; }
    i=0; n=E51AB_CANDIDATES*E51AE_CELLS; while(i<n){ if(a_b[i]!=b_b[i]){ return 0; } i=i+1; }
    return 1;
}


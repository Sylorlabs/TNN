#!/usr/bin/env python3
import json,sys
from pathlib import Path
import numpy as np
from sklearn.ensemble import ExtraTreesClassifier,RandomForestClassifier
from sklearn.linear_model import LogisticRegression
sys.path.insert(0,str(Path(__file__).parent));from integrated_r28 import motif_template
from speech_integrated_train_r28 import vary_int

def rs(z,W=32):
 x=np.interp(np.linspace(0,len(z)-1,W),np.arange(len(z)),z);x=(x-x.mean())/(x.std()+1e-8)
 return np.r_[x,np.diff(x,prepend=x[0]),np.convolve(x,np.ones(3)/3,'same')]
def phrase_meta(bases,ids,r):
 out=[];sp=[]
 for ii,e in enumerate(ids):
  z=vary_int(bases[e],r);st=len(out)
  if ii>0:
   ov=min(4,len(z),len(out))
   for j in range(ov):
    a=(j+1)/(ov+1);out[-ov+j]=(1-a)*out[-ov+j]+a*z[j]
   z=z[ov:];st=len(out)
  out.extend(z.tolist());sp.append((st,len(out),e))
 return np.array(out),sp
def run(seed=281000,ntrain=500,ntest=200):
 bases={e:motif_template(seed+1200,e) for e in range(24)};r=np.random.default_rng(seed+91);X=[];y=[];pv=[]
 for _ in range(ntrain):
  ids=r.choice(24,3,replace=False).tolist();x,sp=phrase_meta(bases,ids,r)
  for i,(st,en,e) in enumerate(sp):X.append(rs(x[max(0,st-4):en]));y.append(e);pv.append(ids[i-1] if i else -1)
 X=np.stack(X);y=np.array(y);pv=np.array(pv);OH=np.zeros((len(pv),25));OH[np.arange(len(pv)),pv+1]=1;Xc=np.c_[X,OH]
 mods={
  'logreg':LogisticRegression(max_iter=500,C=2.0),
  'rf':RandomForestClassifier(n_estimators=120,max_features=.7,min_samples_leaf=1,n_jobs=-1,random_state=seed),
  'extra':ExtraTreesClassifier(n_estimators=160,max_features=.8,min_samples_leaf=1,n_jobs=-1,random_state=seed),
 }
 for m in mods.values():m.fit(X,y)
 ctxmods={k+'_ctx':(LogisticRegression(max_iter=500,C=2.0) if k=='logreg' else (RandomForestClassifier(n_estimators=120,max_features=.7,n_jobs=-1,random_state=seed+1) if k=='rf' else ExtraTreesClassifier(n_estimators=160,max_features=.8,n_jobs=-1,random_state=seed+1))) for k in ['logreg','rf','extra']}
 for m in ctxmods.values():m.fit(Xc,y)
 Xt=[];yt=[];ctx=[]
 for _ in range(ntest):
  ids=r.choice(24,3,replace=False).tolist();x,sp=phrase_meta(bases,ids,r)
  for i,(st,en,e) in enumerate(sp):Xt.append(rs(x[max(0,st-4):en]));yt.append(e);ctx.append(ids[i-1] if i else -1)
 Xt=np.stack(Xt);yt=np.array(yt);ctx=np.array(ctx);OHt=np.zeros((len(ctx),25));OHt[np.arange(len(ctx)),ctx+1]=1;Xtc=np.c_[Xt,OHt]
 acc={k:float(np.mean(m.predict(Xt)==yt)) for k,m in mods.items()};acc.update({k:float(np.mean(m.predict(Xtc)==yt)) for k,m in ctxmods.items()})
 return {'seed':seed,'ntrain_phrases':ntrain,'ntest_phrases':ntest,'accuracy':acc}
if __name__=='__main__':
 o=run();print(json.dumps(o,indent=2));Path('/mnt/data/tnn-r28-aeif-no-graph/results/speech_r28/acoustic_discriminative_upper.json').write_text(json.dumps(o,indent=2))

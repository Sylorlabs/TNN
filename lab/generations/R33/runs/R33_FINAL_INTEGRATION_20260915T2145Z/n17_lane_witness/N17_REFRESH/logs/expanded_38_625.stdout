#!/usr/bin/env python3
import sys,json
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent));import speech_r28 as sr
from integrated_r28 import motif_template
from speech_integrated_train_r28 import learn_protos

def synth_meta(templates,ids,r):
 out=[];spans=[]
 for ii,e in enumerate(ids):
  t=templates[e];stretch=r.uniform(.55,1.65);n=max(7,int(len(t)*stretch));z=np.interp(np.linspace(0,len(t)-1,n),np.arange(len(t)),t)+r.normal(0,.35,n);st=len(out)
  if ii>0 and len(out)>3:
   b=min(4,len(z),len(out))
   for j in range(b):
    a=(j+1)/(b+1);out[-b+j]=(1-a)*out[-b+j]+a*z[j]
   z=z[b:];st=len(out)
  out.extend(z.tolist());spans.append((st,len(out),e))
 return np.array(out),spans

def run(seed=281000,trials=120):
 bases={e:motif_template(seed+1200,e) for e in range(24)};P,d=learn_protos(seed+555,bases);r=np.random.default_rng(seed+9900)
 results={k:[] for k in ['exact','pre2','pre4','pre6','wide']}
 for q in range(trials):
  e=q%24;ids=[(e+3)%24,e,(e+7)%24];x,sp=synth_meta(bases,ids,r)
  for st,en,m in sp:
   for k,pre in [('exact',0),('pre2',2),('pre4',4),('pre6',6),('wide',8)]:
    lo=max(0,st-pre);cc=sr.cost_all(x[lo:en],P,d,'multi_combined');results[k].append(int(np.argmin(cc)==m))
 return {'seed':seed,'trials':trials,'accuracy':{k:float(np.mean(v)) for k,v in results.items()}}
if __name__=='__main__':
 o=run();print(json.dumps(o,indent=2));Path('/mnt/data/tnn-r28-aeif-no-graph/results/speech_r28/integrated_boundary_diag.json').write_text(json.dumps(o,indent=2))

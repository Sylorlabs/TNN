@import("v91_semantic_kat.zag")
fn fail(label:[]u8,f:*i32)void {_zag_print("V91_FAIL,");_zag_println(label);f.*=f.*+1;}
fn num(label:[]u8,x:i64)void {_zag_print(label);_zag_print(",");_zag_println(_zag_i64_to_str(x));}
fn main()i32 {let f:i32=0;let mt:R25MT19937V1=r25mt_new();if(r25mt_init_genrand(&mt,5489)!=0){fail("mt_init",&f);}let w:[]u64=new u64(10);w[0]=3499211612;w[1]=581869302;w[2]=3890346734;w[3]=3586334585;w[4]=545404204;w[5]=4161255391;w[6]=3922919429;w[7]=949333985;w[8]=2715962298;w[9]=1323567403;let i:i32=0;while(i<10){let x:u64=0;if(r25mt_next_u32(&mt,&x)!=0||(x&0xffffffff)!=(w[i]&0xffffffff)){fail("mt_reference",&f);}i=i+1;}let rows:[]V91Row=new V91Row(V91_ROWS);if(v91_build(rows)!=0){fail("dataset",&f);}let tr:[]i32=new i32(V91_ROWS);let te:[]i32=new i32(V91_ROWS);let nt:i32=0;let nh:i32=0;if(v91_split(rows,tr,te,&nt,&nh)!=0){fail("split",&f);}num("V91_RAW_TRAIN",nt as i64);num("V91_RAW_TEST",nh as i64);if(nt<1800||nh<72){fail("caps",&f);}let c:[]i32=new i32(42);i=0;while(i<16){let r:V91Row=rows[te[i]];if(v91_expected_row(i,r)!=1){fail("accepted_row",&f);}if(v91_condition(r,c)!=0){fail("condition",&f);}let ones:i32=0;let j:i32=0;while(j<42){if(c[j]==1){ones=ones+1;}else if(c[j]!=0){fail("condition_binary",&f);}j=j+1;}if(ones!=6){fail("condition_ones",&f);}if(v91_expected_naive(i).len<1){fail("output_custody",&f);}i=i+1;}num("V91_ACCEPTED_ROW_KAT",16);num("V91_ACCEPTED_N1_OUTPUTS_BOUND",16);num("V91_FAILURES",f as i64);return (f!=0) as i32;}

// Oracle-free single-row inference worker. The shell orchestrator may run
// independent historical test rows concurrently; each worker owns its RNG.
@import("v91_native_roundtrip_v1.zag")

fn vre_get32(b:[]u8,at:i32)i32 @noalloc {return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);}
fn vre_put32(b:[]u8,at:i32,x:i32)i32 @noalloc {if(at<0||at+4>b.len){return 1;}b[at]=(x&255) as u8;b[at+1]=((x>>8)&255) as u8;b[at+2]=((x>>16)&255) as u8;b[at+3]=((x>>24)&255) as u8;return 0;}
fn vre_eq(a:[]u8,b:[]u8)i32 @noalloc {if(a.len!=b.len){return 0;}let i:i32=0;while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn vre_parse(s:[]u8)i32 @noalloc {if(s.len<1||s.len>2){return -1;}let x:i32=0;let i:i32=0;while(i<s.len){if(s[i]<48||s[i]>57){return -1;}x=x*10+(s[i]-48) as i32;i=i+1;}return x;}

fn main()i32 {
    if(_zag_argc()!=5){return 2;}let idx:i32=vre_parse(_zag_arg(3));if(idx<0||idx>=16){return 3;}
    let model:V91NaiveModel=vg_load(_zag_arg(1));if(model.status!=0){return 4;}
    let w:[]f64=vn_load(_zag_arg(1),"interpreter.W.f32le",32256,"3f5c806cfa243f9fc5de398101d93a9fc59b8ea1d4cb55cbe08165d940e3e5c3");if(w.len!=32256){return 5;}
    let cf:[]u8=_zag_read_file(_zag_arg(2));if(cf.len!=752||vre_eq(cf[0..8],"V91CND01")!=1||vre_get32(cf,8)!=16||vre_get32(cf,12)!=42){return 6;}
    let at:i32=16+idx*46;let c:[]f64=vg_f64(42);let j:i32=0;while(j<42){let q:i32=cf[at+4+j] as i32;if(q!=0&&q!=1){return 7;}c[j]=q as f64;j=j+1;}
    let seed:i32=33101+idx;let status:i32=-1;let sem:f64=0.0;let lp:f64=0.0;let got:[]u8=vr_generate_roundtrip(&model,w,c,seed as u64,&status,&sem,&lp);if(status!=0||got.len<1){return 8;}
    let frame:[]u8=vg_u8(20+got.len);let magic:[]u8="V91RRW01";j=0;while(j<8){frame[j]=magic[j];j=j+1;}vre_put32(frame,8,idx);vre_put32(frame,12,seed);vre_put32(frame,16,got.len);j=0;while(j<got.len){frame[20+j]=got[j];j=j+1;}
    if(_zag_write_file(_zag_arg(4),frame)!=0){return 9;}
    _zag_print("V91_ROUNDTRIP_ROW,");_zag_print(_zag_i64_to_str(idx as i64));_zag_print(",seed=");_zag_print(_zag_i64_to_str(seed as i64));_zag_print(",bytes=");_zag_print(_zag_i64_to_str(got.len as i64));_zag_print(",text=");_zag_println(got);return 0;
}

// V91 authoring-only semantic evidence probe.
// Traverses the inert admitted parent map. It never invokes reducers/classes.
@import("../identity.zag")
fn vp_num(v:i64)void {let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);}
fn vp_indent(depth:i32)void {let i:i32=0;while(i<depth){_zag_print("  ");i=i+1;}}
fn vp_list_item(p:*ParentMap,id:i32,index:i32)i32 {if((pm_kind(p,id)!=9&&pm_kind(p,id)!=10)||index<0||index>=p.*.nodes[(id-1)*10+9]){return 0;}let e:i32=p.*.nodes[(id-1)*10+7] as i32;let i:i32=0;while(e>0&&i<index){e=p.*.edges[(e-1)*4+2] as i32;i=i+1;}if(e<=0||p.*.edges[(e-1)*4+3]!=1){return 0;}return p.*.edges[(e-1)*4] as i32;}
fn vp_walk(p:*ParentMap,id:i32,depth:i32)void {if(id<1||id>p.*.node_count||depth>12){return;}let k:i32=pm_kind(p,id);vp_indent(depth);_zag_print("NODE id=");vp_num(id as i64);_zag_print(" kind=");vp_num(k as i64);if(k==1){_zag_println(" null");return;}if(k==2||k==3||k==4){let x:i64=0;let rc:i32=pm_small_int(p,id,&x);_zag_print(" int_rc=");vp_num(rc as i64);_zag_print(" value=");vp_num(x);_zag_println("");return;}if(k==5){_zag_print(" float_bytes=");let b:[]u8=pm_raw(p,id);let i:i32=0;while(i<b.len){let s:[]u8=_zag_i64_to_str(b[i] as i64);if(i>0){_zag_print(".");}_zag_print(s);nio_free(s);i=i+1;}_zag_println("");return;}if(k==6||k==7||k==8){_zag_print(" raw=");_zag_println(pm_raw(p,id));return;}if(k==9||k==10){let n:i32=p.*.nodes[(id-1)*10+9] as i32;_zag_print(" count=");vp_num(n as i64);_zag_println("");let i:i32=0;while(i<n&&i<256){vp_indent(depth);_zag_print("ITEM ");vp_num(i as i64);_zag_println("");vp_walk(p,vp_list_item(p,id,i),depth+1);i=i+1;}return;}if(k==11){let n:i32=p.*.nodes[(id-1)*10+9] as i32;_zag_print(" count=");vp_num(n as i64);_zag_println("");let e:i32=p.*.nodes[(id-1)*10+7] as i32;let seen:i32=0;while(e>0&&seen<n&&seen<512){let at:i32=(e-1)*4;if(p.*.edges[at+3]==2){let key:i32=p.*.edges[at] as i32;let val:i32=p.*.edges[at+1] as i32;vp_indent(depth);_zag_print("KEY ");if(pm_kind(p,key)==6||pm_kind(p,key)==7){_zag_print(pm_raw(p,key));}else{_zag_print("<non-string>");}_zag_print(" -> ");vp_num(val as i64);_zag_println("");vp_walk(p,val,depth+1);}e=p.*.edges[at+2] as i32;seen=seen+1;}return;}if(k==15||k==16){let s:i32=pm_build_state(p,id);_zag_print(" state=");vp_num(s as i64);_zag_println("");if(s>0){vp_walk(p,s,depth+1);}return;}_zag_println("");}
fn main()i32 {let binding:[]u8=pb_binding();let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0||n17_identity(&p)!=0){return 3;}let r26:i32=pm_lookup(&p,p.root,"base_state");let r25:i32=pm_lookup(&p,r26,"base_state");let r24:i32=pm_lookup(&p,r25,"r24_state");let r23:i32=pm_lookup(&p,r24,"r23_state");let evidence:i32=pm_lookup(&p,r23,"evidence");let sem:i32=pm_lookup(&p,evidence,"semantic_generation");_zag_println("V91_PROBE_R23_SEMANTIC_GENERATION");vp_walk(&p,sem,0);_zag_println("V91_PROBE_R23_GENERATOR");vp_walk(&p,pm_lookup(&p,r23,"semantic_generator"),0);mi_loaded_close(&p);return 0;}

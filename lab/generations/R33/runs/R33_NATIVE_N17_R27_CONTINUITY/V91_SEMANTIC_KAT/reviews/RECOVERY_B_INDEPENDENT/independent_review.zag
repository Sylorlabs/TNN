// Independent native custody recomputation. No generation, training or grant.
@import("sources/Research/R33_NATIVE_N17_R27_CONTINUITY/identity.zag")
@import("sources/Research/R33_NATIVE_N17_R27_CONTINUITY/V91_SEMANTIC_KAT/v91_semantic_kat.zag")
fn iv_hash(b:[]u8)[]u8 {let h:[]u8=nio_alloc(32);if(h.len!=32){return "";}if(ns_sha256(b,h)!=0){nio_free(h);return "";}let out:[]u8=ns_hex(h);nio_free(h);return out;}
fn iv_num(x:i64)void {_zag_print(_zag_i64_to_str(x));}
fn iv_item(p:*ParentMap,id:i32,index:i32)i32 {
 let kind:i32=pm_kind(p,id);if((kind!=9&&kind!=10)||index<0){return 0;}let row:i32=(id-1)*10;if(index>=p.*.nodes[row+9]){return 0;}
 let edge:i32=p.*.nodes[row+7] as i32;let i:i32=0;while(i<=index){if(edge<1||edge>p.*.edge_count){return 0;}let at:i32=(edge-1)*4;if(p.*.edges[at+3]!=1){return 0;}if(i==index){let val:i32=p.*.edges[at] as i32;if(pm_valid_id(p,val)!=1){return 0;}return val;}edge=p.*.edges[at+2] as i32;i=i+1;}return 0;
}
fn iv_span(b:[]u8,at:i32,n:i32)bool {return at>=0 && n>=0 && at<=b.len && n<=b.len-at;}
fn iv_unicode(b:[]u8,op_at:i32,op:i32,at:i32,n:i32)i32 {
 if(!iv_span(b,op_at,1)||!iv_span(b,at,n)||b[op_at]!=(op as u8)){return 1;}
 if(op==140){if(!iv_span(b,op_at,2)||at!=op_at+2||b[op_at+1]!=(n as u8)||n>255){return 1;}return 0;}
 if(op==88){if(!iv_span(b,op_at,5)||at!=op_at+5||mi_get(b,op_at+1)!=n){return 1;}return 0;}
 if(op==141){if(!iv_span(b,op_at,9)||at!=op_at+9||mi_get(b,op_at+1)!=n||mi_get(b,op_at+5)!=0){return 1;}return 0;}return 1;
}
fn iv_oracle(p:*ParentMap,prefix:[]u8)i32 {
 let f:[]u8=_zag_read_file(_zag_str_concat(prefix,"/oracle.framed.bin"));if(f.len!=1097||nio_equal(iv_hash(f),"8efe1df2c661e769f8eb9e4a39cb779970629cbfa0764583488f8f9369c09112")!=1){return 10;}
 if(nio_equal(f[0..8],"V91ORC01")!=1||mi_get(f,8)!=16){return 11;}
 let r26:i32=pm_lookup(p,p.*.root,"base_state");let r25:i32=pm_lookup(p,r26,"base_state");let r24:i32=pm_lookup(p,r25,"r24_state");let r23:i32=pm_lookup(p,r24,"r23_state");let examples:i32=pm_lookup(p,pm_lookup(p,pm_lookup(p,r23,"evidence"),"semantic_generation"),"examples");
 if(pm_kind(p,examples)!=9||p.*.nodes[(examples-1)*10+9]!=16||mi_get(f,12)!=r23){return 12;}
 let ph:[]u8=pb_hex(iv_hash(p.*.input));if(ph.len!=32||nio_equal(ph,f[16..48])!=1){return 13;}nio_free(ph);let pos:i32=48;let i:i32=0;
 while(i<16){if(!iv_span(f,pos,24)){return 14;}let example:i32=iv_item(p,examples,i);if(pm_kind(p,example)!=11){return 15;}let node:i32=pm_lookup(p,example,"naive");if(pm_kind(p,node)!=6){return 16;}let row:i32=(node-1)*10;let op_at:i32=p.*.nodes[row+1] as i32;let at:i32=p.*.nodes[row+2] as i32;let n:i32=p.*.nodes[row+3] as i32;let op:i32=mi_get(f,pos+12) as i32;
 if(mi_get(f,pos)!=i||mi_get(f,pos+4)!=node||mi_get(f,pos+8)!=op_at||mi_get(f,pos+16)!=at||mi_get(f,pos+20)!=n||n<1||!iv_span(f,pos+24,n)||iv_unicode(p.*.input,op_at,op,at,n)!=0){return 17;}
 let raw:[]u8=p.*.input[at..at+n];if(nio_equal(raw,f[pos+24..pos+24+n])!=1||nio_equal(raw,pm_raw(p,node))!=1||v91_output_match(i,raw)!=1){return 18;}
 _zag_print("IV91_ORACLE,");iv_num(i as i64);_zag_print(",node=");iv_num(node as i64);_zag_print(",opcode_offset=");iv_num(op_at as i64);_zag_print(",opcode=");iv_num(op as i64);_zag_print(",text_offset=");iv_num(at as i64);_zag_print(",bytes=");iv_num(n as i64);_zag_print(",sha256=");_zag_println(iv_hash(raw));pos=pos+24+n;i=i+1;
 }
 if(pos!=f.len){return 19;}nio_free(f);_zag_println("IV91_BOUND_CUSTODY,16\nIV91_ACTUAL_GENERATED_OUTPUTS,0");return 0;
}
fn iv_tensor(p:*ParentMap,sg:i32,prefix:[]u8,layer:[]u8,key:[]u8,rows:i32,cols:i32,w:*TsWork)i32 {
 let modules:i32=pm_lookup(p,pm_lookup(p,sg,"model"),"_modules");let id:i32=pm_lookup(p,pm_lookup(p,pm_lookup(p,modules,layer),"_parameters"),key);let v:TsView=ts_open(p,id,w);if(v.status!=0){return 30;}
 let n:i32=rows;let rank:i32=1;if(cols>0){n=rows*cols;rank=2;}
 if(v.kind!=102||v.width!=4||v.rank!=rank||v.offset!=0||v.elements!=n||v.dims[0]!=rows||v.strides[rank-1]!=1||!iv_span(p.*.input,v.at,n*4)){ts_close(&v);return 31;}
 if(rank==2&&(v.dims[1]!=cols||v.strides[0]!=cols)){ts_close(&v);return 32;}
 let name:[]u8=_zag_str_concat(_zag_str_concat(layer,"."),key);let file:[]u8=_zag_read_file(_zag_str_concat(_zag_str_concat(prefix,"/"),_zag_str_concat(name,".f32le")));let raw:[]u8=p.*.input[v.at..v.at+n*4];if(nio_equal(raw,file)!=1){ts_close(&v);return 33;}
 _zag_print("IV91_TENSOR,");_zag_print(name);_zag_print(",node=");iv_num(id as i64);_zag_print(",offset=");iv_num(v.at as i64);_zag_print(",bytes=");iv_num(raw.len as i64);_zag_print(",sha256=");_zag_println(iv_hash(raw));nio_free(file);ts_close(&v);return 0;
}
fn iv_bpe(p:*ParentMap,sg:i32,prefix:[]u8)i32 {
 let f:[]u8=_zag_read_file(_zag_str_concat(prefix,"/bpe.framed.bin"));if(f.len!=3946||nio_equal(iv_hash(f),"f83d2f7c63b2f40f386c37b96fc5d17ea120f715e503f58b62a6ca428cd21f6c")!=1){return 40;}
 if(nio_equal(f[0..8],"V91BPE01")!=1||mi_get(f,8)!=340||mi_get(f,12)!=84){return 41;}let bpe:i32=pm_lookup(p,sg,"bpe");let dict:i32=pm_lookup(p,bpe,"token_bytes");let merges:i32=pm_lookup(p,bpe,"merges");if(pm_kind(p,dict)!=11||pm_kind(p,merges)!=9||p.*.nodes[(dict-1)*10+9]!=340||p.*.nodes[(merges-1)*10+9]!=84){return 42;}
 let seen:[]i64=pm_words(340);if(seen.len!=340){return 43;}let edge:i32=p.*.nodes[(dict-1)*10+7] as i32;let i:i32=0;let pos:i32=16;
 while(i<340){if(edge<1||edge>p.*.edge_count||!iv_span(f,pos,8)){return 44;}let er:i32=(edge-1)*4;if(p.*.edges[er+3]!=2){return 45;}let id:i64=-1;if(pm_small_int(p,p.*.edges[er] as i32,&id)!=0||id<0||id>=340||seen[id as i32]!=0){return 46;}seen[id as i32]=1;
 let node:i32=p.*.edges[er+1] as i32;if(pm_kind(p,node)!=7){return 47;}let raw:[]u8=pm_raw(p,node);let n:i32=mi_get(f,pos+4) as i32;if(mi_get(f,pos)!=id||n!=raw.len||n<1||!iv_span(f,pos+8,n)||nio_equal(raw,f[pos+8..pos+8+n])!=1){return 48;}
 _zag_print("IV91_BPE_TOKEN,");iv_num(id);_zag_print(",node=");iv_num(node as i64);_zag_print(",offset=");iv_num(p.*.nodes[(node-1)*10+2]);_zag_print(",bytes=");iv_num(n as i64);_zag_print(",sha256=");_zag_println(iv_hash(raw));edge=p.*.edges[er+2] as i32;pos=pos+8+n;i=i+1;
 }
 if(edge!=0){return 49;}i=0;while(i<84){if(!iv_span(f,pos,8)){return 50;}let pair:i32=iv_item(p,merges,i);if(pm_kind(p,pair)!=10||p.*.nodes[(pair-1)*10+9]!=2){return 51;}let a:i64=-1;let b:i64=-1;if(pm_small_int(p,iv_item(p,pair,0),&a)!=0||pm_small_int(p,iv_item(p,pair,1),&b)!=0||mi_get(f,pos)!=a||mi_get(f,pos+4)!=b||a<0||b<0||a>=256+i||b>=256+i){return 52;}
 _zag_print("IV91_MERGE,");iv_num(i as i64);_zag_print(",pair_node=");iv_num(pair as i64);_zag_print(",a=");iv_num(a);_zag_print(",b=");iv_num(b);_zag_println("");pos=pos+8;i=i+1;
 }if(pos!=f.len){return 53;}pm_free_words(seen);nio_free(f);_zag_println("IV91_BPE_CUSTODY,340,84");return 0;
}
fn main()i32 {
 if(_zag_argc()!=2&&_zag_argc()!=3){return 2;}if(_zag_argc()==3&&nio_equal(_zag_arg(2),"--nested-r23")!=1){return 2;}let binding:[]u8=pb_binding();if(binding.len!=128){return 3;}let p:ParentMap=pb_load(pb_map_path(),binding);nio_free(binding);if(p.status!=0||n17_identity(&p)!=0){return 4;}
 _zag_print("IV91_PARENT_SHA256,");_zag_println(iv_hash(p.input));let prefix:[]u8=_zag_arg(1);let rc:i32=iv_oracle(&p,prefix);if(rc!=0){_zag_print("IV91_REFUSED,");iv_num(rc as i64);_zag_println("");mi_loaded_close(&p);return rc;}
 let sg:i32=pm_lookup(&p,p.root,"semantic_generator");if(_zag_argc()==3){let r26:i32=pm_lookup(&p,p.root,"base_state");let r25:i32=pm_lookup(&p,r26,"base_state");let r24:i32=pm_lookup(&p,r25,"r24_state");let r23:i32=pm_lookup(&p,r24,"r23_state");sg=pm_lookup(&p,r23,"semantic_generator");}let w:TsWork=ts_work();
 rc=iv_tensor(&p,sg,prefix,"emb","weight",342,48,&w);if(rc==0){rc=iv_tensor(&p,sg,prefix,"ch","weight",128,42,&w);}if(rc==0){rc=iv_tensor(&p,sg,prefix,"ch","bias",128,0,&w);}if(rc==0){rc=iv_tensor(&p,sg,prefix,"ce","weight",48,42,&w);}if(rc==0){rc=iv_tensor(&p,sg,prefix,"ce","bias",48,0,&w);}
 if(rc==0){rc=iv_tensor(&p,sg,prefix,"rnn","weight_ih_l0",384,96,&w);}if(rc==0){rc=iv_tensor(&p,sg,prefix,"rnn","weight_hh_l0",384,128,&w);}if(rc==0){rc=iv_tensor(&p,sg,prefix,"rnn","bias_ih_l0",384,0,&w);}if(rc==0){rc=iv_tensor(&p,sg,prefix,"rnn","bias_hh_l0",384,0,&w);}if(rc==0){rc=iv_tensor(&p,sg,prefix,"out","weight",342,128,&w);}if(rc==0){rc=iv_tensor(&p,sg,prefix,"out","bias",342,0,&w);}if(rc==0){rc=iv_bpe(&p,sg,prefix);}
 mi_loaded_close(&p);_zag_print("IV91_REVIEW_STATUS,");iv_num(rc as i64);_zag_println("\nIV91_ADMISSION,CLOSED\nIV91_GENERATED_OUTPUTS,0");return rc;
}

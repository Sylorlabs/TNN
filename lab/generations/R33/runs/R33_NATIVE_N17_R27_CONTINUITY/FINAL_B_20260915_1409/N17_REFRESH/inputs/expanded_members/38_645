#!/usr/bin/env python3
import argparse,json,sys
from pathlib import Path
import numpy as np
sys.path.insert(0,str(Path(__file__).parent));from integrated_r28 import motif_template

def warp(x,r,hard=False):
 n=max(7,int(len(x)*r.uniform(.65,1.45 if hard else 1.2)));z=np.interp(np.linspace(0,len(x)-1,n),np.arange(len(x)),x);z=(1+r.normal(0,.18))*z+r.normal(0,.22 if hard else .08,n)
 if hard:z=z+.12*np.sin(np.linspace(0,2*np.pi,n)+r.uniform(0,6))
 return z
def rs(x,W=24):
 y=np.interp(np.linspace(0,len(x)-1,W),np.arange(len(x)),x);return (y-y.mean())/(y.std()+1e-8)
def run(seed=281000,trials=120):
 bases={e:motif_template(seed+1200,e) for e in range(24)};r=np.random.default_rng(seed+919);stored={e:warp(bases[e],r,False) for e in bases};F={e:rs(v) for e,v in stored.items()};raw=[];norm=[];closest=[]
 # evaluator picks closest name distractor in normalized shape space.
 nearest={e:min((j for j in bases if j!=e),key=lambda j:np.linalg.norm(rs(bases[e])-rs(bases[j]))) for e in bases}
 for q in range(trials):
  e=q%24;z=warp(bases[e],r,True)
  # raw baseline first length-normalizes only because Euclidean unequal length undefined
  zz=np.interp(np.linspace(0,len(z)-1,len(stored[e])),np.arange(len(z)),z);raw.append(min(stored,key=lambda j:np.linalg.norm(np.interp(np.linspace(0,len(z)-1,len(stored[j])),np.arange(len(z)),z)-stored[j]))==e)
  norm.append(min(F,key=lambda j:np.linalg.norm(rs(z)-F[j]))==e)
  j=nearest[e];closest.append(np.linalg.norm(rs(z)-F[e])<np.linalg.norm(rs(z)-F[j]))
 return {'seed':seed,'trials':trials,'accuracy':{'raw_resample':float(np.mean(raw)),'normalized_shape':float(np.mean(norm)),'target_beats_closest_name':float(np.mean(closest))}}
if __name__=='__main__':
 ap=argparse.ArgumentParser();ap.add_argument('--seed',type=int,required=True);ap.add_argument('--out',required=True);a=ap.parse_args();o=run(a.seed);Path(a.out).write_text(json.dumps(o,indent=2));print(json.dumps(o,indent=2))

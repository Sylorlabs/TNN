// Independent native numerical components, NOT a historical generate method.
// Float32 bytes decode exactly to f64. f64 accumulation/activation arithmetic
// has not been admitted as historical Torch rounding or sampling semantics.
@import("../../R33_NATIVE_SHA256_V2.zag")
fn vn_alloc(n:i32)[]f64 {if(n<1||n>200000){return (null as *f64)[0..0];}let p:*f64=_zag_malloc(n*8) as *f64;if(p==null as *f64){return p[0..0];}let b:[]f64=p[0..n];let i:i32=0;while(i<n){b[i]=0.0;i=i+1;}return b;}
fn vn_pow2(e:i32)f64 {let x:f64=1.0;let n:i32=e;while(n>0){x=x*2.0;n=n-1;}while(n<0){x=x*0.5;n=n+1;}return x;}
fn vn_decode(b:[]u8,out:[]f64)i32 {if(b.len!=out.len*4){return 1;}let i:i32=0;while(i<out.len){let at:i32=i*4;let bits:u64=(b[at] as u64)|((b[at+1] as u64)<<8)|((b[at+2] as u64)<<16)|((b[at+3] as u64)<<24);let e:i32=((bits>>23)&255) as i32;if(e==255){return 2;}let m:u64=bits&0x7fffff;let v:f64=0.0;if(e==0){v=(m as f64)*vn_pow2(-149);}else{v=((m+8388608) as f64)*vn_pow2(e-150);}if((bits>>31)!=0){v=-v;}out[i]=v;i=i+1;}return 0;}
fn vn_linear(w:[]f64,b:[]f64,x:[]f64,out:[]f64)i32 {if(b.len!=out.len||w.len!=out.len*x.len||x.len<1){return 3;}let i:i32=0;while(i<out.len){let y:f64=b[i];let j:i32=0;while(j<x.len){y=y+w[i*x.len+j]*x[j];j=j+1;}out[i]=y;i=i+1;}return 0;}
fn vn_exp(x:f64)f64 {if(x>40.0){return vn_pow2(58);}if(x< -40.0){return 0.0;}let k:i32=0;let r:f64=x;while(r>0.34657359027997265){r=r-0.6931471805599453;k=k+1;}while(r< -0.34657359027997265){r=r+0.6931471805599453;k=k-1;}let term:f64=1.0;let sum:f64=1.0;let i:i32=1;while(i<=18){term=term*r/(i as f64);sum=sum+term;i=i+1;}return sum*vn_pow2(k);}
fn vn_sigmoid(x:f64)f64 {return 1.0/(1.0+vn_exp(-x));}
fn vn_tanh(x:f64)f64 {if(x>20.0){return 1.0;}if(x< -20.0){return -1.0;}let e:f64=vn_exp(2.0*x);return (e-1.0)/(e+1.0);}
// Explicit isolated reset/update/new GRU component contract; calling code must
// separately establish historical gate ordering, input construction and dtype.
fn vn_gru(wi:[]f64,wh:[]f64,bi:[]f64,bh:[]f64,x:[]f64,h:[]f64,out:[]f64,gi:[]f64,gh:[]f64)i32 {
 if(h.len!=128||out.len!=128||x.len!=96||gi.len!=384||gh.len!=384){return 4;}if(vn_linear(wi,bi,x,gi)!=0||vn_linear(wh,bh,h,gh)!=0){return 5;}
 let i:i32=0;while(i<128){let r:f64=vn_sigmoid(gi[i]+gh[i]);let z:f64=vn_sigmoid(gi[128+i]+gh[128+i]);let n:f64=vn_tanh(gi[256+i]+r*gh[256+i]);out[i]=(1.0-z)*n+z*h[i];i=i+1;}return 0;
}
// Generic diagnostic categorical sampling with an explicitly supplied uniform.
// This is not torch.multinomial, nor an asserted historical seeded sampler.
fn vn_categorical(logits:[]f64,u:f64,weights:[]f64,out:*i32)i32 {if(logits.len<1||weights.len!=logits.len||out==null as *i32||u<0.0||u>=1.0){return 6;}let max:f64=logits[0];let i:i32=1;while(i<logits.len){if(logits[i]>max){max=logits[i];}i=i+1;}let sum:f64=0.0;i=0;while(i<logits.len){weights[i]=vn_exp(logits[i]-max);sum=sum+weights[i];i=i+1;}if(sum<=0.0){return 7;}let target:f64=u*sum;let acc:f64=0.0;i=0;while(i<logits.len){acc=acc+weights[i];if(target<acc){out.*=i;return 0;}i=i+1;}return 8;}
fn vn_hash(b:[]u8)[]u8 {let h:[]u8=nio_alloc(32);if(ns_sha256(b,h)!=0){return "";}return ns_hex(h);}
fn vn_load(root:[]u8,leaf:[]u8,count:i32,hash:[]u8)[]f64 {let bytes:[]u8=_zag_read_file(_zag_str_concat(_zag_str_concat(root,"/"),leaf));if(bytes.len!=count*4||nio_equal(vn_hash(bytes),hash)!=1){return (null as *f64)[0..0];}let out:[]f64=vn_alloc(count);if(vn_decode(bytes,out)!=0){return (null as *f64)[0..0];}return out;}

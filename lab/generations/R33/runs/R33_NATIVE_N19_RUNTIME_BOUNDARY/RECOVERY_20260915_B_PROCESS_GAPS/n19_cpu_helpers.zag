fn n19_case_cpu_ceiling()i32 {
    if(n19_apply_limits(1,32,1)!=N19_OK){return 1;}
    let tv:*i64=_zag_malloc(16) as *i64;if(tv==null as *i64){return 1;}
    if(_zag_darwin_syscall(116,tv as i64,0,0,0,0,0)!=0){_zag_free(tv as *i8);return 1;}
    let start:i64=tv[0];let ticks:i64=0;
    // Busy CPU only; wall clock is an 8-second test escape, never pass evidence.
    while(true){
        ticks=ticks+1;
        if((ticks & 65535)==0){
            if(_zag_darwin_syscall(116,tv as i64,0,0,0,0,0)!=0){_zag_free(tv as *i8);return 1;}
            if(tv[0]-start>=8){_zag_free(tv as *i8);return 88;}
        }
    }
    return 1;
}

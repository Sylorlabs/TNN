@import("r34_native_sidecar_v1.zag")
fn main()i32 {
 let f:i32=0;let a:[]u8=new u8(R34NS1_BYTES);if(r34ns1_init(a)!=R34NS1_OK){f=f+1;}
 let b:[]u8=new u8(R34NS1_BYTES);if(r34ns1_copy(b,a)!=0||r34ns1_eq(a,b)!=1){f=f+1;}
 let p:[6]i32=[0,0,0,0,0,0];if(r34ns1_pending(a,p)!=0||p[0]!=1||p[1]!=4||p[2]!=2||p[3]!=5||p[4]!=2||p[5]!=1){f=f+1;}
 if(r34ns1_step(a,3,4)!=0||r34ns1_step(b,3,4)!=0||r34ns1_eq(a,b)!=1){f=f+1;}
 let c:[]u8=new u8(R34NS1_BYTES);r34ns1_copy(c,a);c[R34NS1_HEADER_BYTES+7]=c[R34NS1_HEADER_BYTES+7]^1;if(r34ns1_check(c)==R34NS1_OK){f=f+1;}
 let d:[]u8=new u8(R34NS1_BYTES);r34ns1_copy(d,a);if(r34ns1_set_pending_action(d,3)!=0||r34ns1_check(d)!=0){f=f+1;}
 if(r34ns1_learn_authority(a)!=0){f=f+1;}
 _zag_print("R34_NATIVE_SIDECAR_V1_FAILURES,");_zag_println(_zag_i64_to_str(f as i64));return (f!=0) as i32;
}

@import("../R33_CONTINUING_LIFE_V1/world.zag")
fn one(w:[]u8)i32 {return cw_init(w,17);}
fn two(w:[]u8,o:[]u8)i32 {if(o.len!=304){return 99;}return cw_init(w,17);}
fn two_ptr(w:[]u8,o:[]u8,s:*CLStream)i32 {if(o.len!=304||s==null as *CLStream){return 98;}return cw_init(w,17);}
fn two_ptr_seed(w:[]u8,o:[]u8,s:*CLStream,seed:i32)i32 {if(o.len!=304||s==null as *CLStream){return 98;}return cw_init(w,seed);}
fn main()i32 {let w:[]u8=nio_alloc(96);let o:[]u8=nio_alloc(304);let s:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};let f:i32=0;f=f+cl_check("one",one(w),0);f=f+cl_check("two",two(w,o),0);f=f+cl_check("two_ptr",two_ptr(w,o,&s),0);f=f+cl_check("two_ptr_seed",two_ptr_seed(w,o,&s,17),0);return (f!=0) as i32;}

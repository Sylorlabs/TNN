// v0/emit.zag — ITERATION 0 (structure vocabulary only).
// EMIT: reads ONLY knowmap.bin (never the original pixels) and rasterizes
// the knowledge back to pixels through per-PRIMITIVE rasterization
// (white-box path B; ingest's per-pixel evaluation is path A).
// Byte-identity between the two paths proves the machinery lossless.
//
// v0: LAYER 0 = structure (per-region fill via leaf_model).
//
// argv: 1=dir (holds knowmap.bin; receives renderB.bmp) 2=kmap_name 3=renderB_name
@import("../common.zag")

fn main() i32 {
    let d:[]u8 = _zag_arg(1);
    let kmapname:[]u8 = _zag_arg(2);
    let rb_name:[]u8 = _zag_arg(3);
    if (_zag_strcmp(d, "") == 1) { d = "."; }
    if (_zag_strcmp(kmapname, "") == 1) { kmapname = "knowmap.bin"; }
    if (_zag_strcmp(rb_name, "") == 1) { rb_name = "renderB.bmp"; }
    let root:i64 = nio_open_root(d);
    if (root < 0) { _zag_println("cannot open dir"); return 1; }

    // ---- read + parse knowledge map (the ONLY input) ----
    let data:[]u8 = file_read_all(root, kmapname, 20000000);
    if (data.len < 32) { _zag_println("kmap too short"); nio_close(root); return 1; }
    if (data[0] != 84) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[1] != 78) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[2] != 78) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[3] != 75) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[4] != 77) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[5] != 65) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[6] != 80) { _zag_println("bad magic"); nio_close(root); return 1; }
    if (data[7] != 49) { _zag_println("bad magic"); nio_close(root); return 1; }
    let o:i64 = 8;
    let w:i64 = r_u64le(data, o); o = o + 8;
    let h:i64 = r_u64le(data, o); o = o + 8;
    let npix:i64 = w * h;
    _zag_print("kmap ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));

    let lc:i64 = r_u64le(data, o); o = o + 8;
    let lx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let ly:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lw:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lh:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lr:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lg:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let lb:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fnx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fny:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fgx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fgy:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fbx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fby:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fxx:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    let fyy:[]i64 = nio_alloc((lc * 8) as i32) as []i64;
    if (lx.len == 0) { _zag_println("alloc failed"); return 1; }
    let i:i64 = 0;
    while (i < lc) {
        lx[i] = r_i64le(data, o); o = o + 8;
        ly[i] = r_i64le(data, o); o = o + 8;
        lw[i] = r_i64le(data, o); o = o + 8;
        lh[i] = r_i64le(data, o); o = o + 8;
        lr[i] = r_i64le(data, o); o = o + 8;
        lg[i] = r_i64le(data, o); o = o + 8;
        lb[i] = r_i64le(data, o); o = o + 8;
        fnx[i] = r_i64le(data, o); o = o + 8;
        fny[i] = r_i64le(data, o); o = o + 8;
        fgx[i] = r_i64le(data, o); o = o + 8;
        fgy[i] = r_i64le(data, o); o = o + 8;
        fbx[i] = r_i64le(data, o); o = o + 8;
        fby[i] = r_i64le(data, o); o = o + 8;
        fxx[i] = r_i64le(data, o); o = o + 8;
        fyy[i] = r_i64le(data, o); o = o + 8;
        i = i + 1;
    }
    _zag_print("leaves ");
    _zag_println(_zag_i64_to_str(lc));
    // v0: expect empty layers 1..3; verify counts are 0
    let ne:i64 = r_u64le(data, o); o = o + 8;
    let nm:i64 = r_u64le(data, o); o = o + 8;
    // (skip full parse of later layers at v0; just check emptiness)
    _zag_print("edges ");
    _zag_print(_zag_i64_to_str(ne));
    _zag_print(" motifs ");
    _zag_println(_zag_i64_to_str(nm));
    if (ne != 0) { _zag_println("v0 expects 0 edges"); return 1; }
    if (nm != 0) { _zag_println("v0 expects 0 motifs"); return 1; }

    // ---- white-box path B: per-REGION rasterization ----
    let fb:[]u8 = nio_alloc((npix * 3) as i32);
    if (fb.len == 0) { _zag_println("alloc fb failed"); return 1; }
    let ev:[]i64 = nio_alloc(24) as []i64;
    let li:i64 = 0;
    while (li < lc) {
        let yy:i64 = ly[li];
        while (yy < ly[li] + lh[li]) {
            let xx:i64 = lx[li];
            while (xx < lx[li] + lw[li]) {
                leaf_model(li, xx, yy, lx, ly, lw, lh, lr, lg, lb,
                    fnx, fny, fgx, fgy, fbx, fby, fxx, fyy, ev);
                let p:i64 = (yy * w + xx) * 3;
                fb[p] = ev[0] as u8;
                fb[p + 1] = ev[1] as u8;
                fb[p + 2] = ev[2] as u8;
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        li = li + 1;
    }
    nio_free(ev);
    let rc:i64 = bmp_write(root, rb_name, fb, w, h);
    nio_close(root);
    if (rc != 0) { _zag_println("renderB write failed"); return 1; }
    _zag_println("emit done");
    return 0;
}

// Trial driver — HDE core vs baseline on designed curricula.
// argv[1]: std | single | flap | walk | storm
// std = exact wave-2 protocol (comparability). Others: designed adversarial
// curricula; endpoints frozen with switch-detection allowed.
@import("episode.zag")

fn trl_report(tag:[]u8,pos:i32,n:i32,s:*TrlState)void {
    _zag_print("TRL,");_zag_print(tag);_zag_print(",pos=");cl_number(pos as i64);
    _zag_print(",n=");cl_number(n as i64);
    _zag_print(",updates=");cl_number(s.*.updates as i64);
    _zag_print(",switches=");cl_number(s.*.switches as i64);
    _zag_print(",explores=");cl_number(s.*.explores as i64);
    _zag_print(",expl_pos=");cl_number(s.*.expl_pos as i64);
    _zag_print(",hyp_conf=");cl_number(s.*.hyp_confirmed as i64);
    _zag_print(",hyp_ref=");cl_number(s.*.hyp_refuted as i64);
    _zag_print(",contexts=");cl_number(s.*.contexts as i64);
    _zag_print(",active=");cl_number(s.*.active as i64);
    _zag_println("");
}

fn train_seg(w:[]u8,obs:[]u8,s:*TrlState,tag:[]u8,regime:i32,n:i32,tp:*i32)i32 {
    let p:i32=0;
    let rc:i32=trl_phase(w,obs,s,regime,n,1,1,1,&p);
    if(rc!=0){return rc;}
    trl_report(tag,p,n,s);tp.*=tp.*+p;return 0;
}
fn frozen_seg(w:[]u8,obs:[]u8,s:*TrlState,tag:[]u8,regime:i32,n:i32,sw:i32)i32 {
    let p:i32=0;
    let rc:i32=trl_phase(w,obs,s,regime,n,0,sw,0,&p);
    if(rc!=0){return rc;}
    trl_report(tag,p,n,s);return 0;
}

fn main()i32 {
    if(_zag_argc()!=2){_zag_println("usage: trial_hde <std|single|flap|walk|storm>");return 64;}
    let cid:[]u8=_zag_arg(1);
    let w:[]u8=nio_alloc(96);let obs:[]u8=nio_alloc(304);
    if(w.len!=96 || obs.len!=304){return 1;}
    if(cw_init(w,17)!=0){return 2;}
    if(cw_observe(w,obs)!=0){return 3;}
    let s:TrlState=trl_init();
    let p:i32=0;let rc:i32=0;let tp:i32=0;let tn:i32=0;
    _zag_print("TRL,curriculum,");_zag_print(cid);_zag_println("");
    rc=trl_phase(w,obs,&s,0,16,0,0,0,&p);if(rc!=0){return 10;}trl_report("base",p,16,&s);
    if(nio_equal(cid,"std")==1){
        rc=train_seg(w,obs,&s,"trainA",0,40,&tp);if(rc!=0){return 11;}tn=tn+40;
        rc=frozen_seg(w,obs,&s,"evalA",0,16,0);if(rc!=0){return 12;}
        rc=train_seg(w,obs,&s,"trainB",1,40,&tp);if(rc!=0){return 13;}tn=tn+40;
        rc=frozen_seg(w,obs,&s,"evalB",1,16,0);if(rc!=0){return 14;}
        rc=frozen_seg(w,obs,&s,"returnA",0,16,1);if(rc!=0){return 15;}
    } else {
        if(nio_equal(cid,"single")==1){
            rc=train_seg(w,obs,&s,"tA1",0,16,&tp);if(rc!=0){return 21;}tn=tn+16;
            rc=train_seg(w,obs,&s,"tB1",1,16,&tp);if(rc!=0){return 22;}tn=tn+16;
        } else if(nio_equal(cid,"flap")==1){
            rc=train_seg(w,obs,&s,"tA1",0,16,&tp);if(rc!=0){return 31;}tn=tn+16;
            rc=train_seg(w,obs,&s,"tB1",1,4,&tp);if(rc!=0){return 32;}tn=tn+4;
            rc=train_seg(w,obs,&s,"tA2",0,4,&tp);if(rc!=0){return 33;}tn=tn+4;
            rc=train_seg(w,obs,&s,"tB2",1,4,&tp);if(rc!=0){return 34;}tn=tn+4;
            rc=train_seg(w,obs,&s,"tA3",0,4,&tp);if(rc!=0){return 35;}tn=tn+4;
            rc=train_seg(w,obs,&s,"tB3",1,4,&tp);if(rc!=0){return 36;}tn=tn+4;
            rc=train_seg(w,obs,&s,"tA4",0,4,&tp);if(rc!=0){return 37;}tn=tn+4;
        } else if(nio_equal(cid,"walk")==1){
            rc=train_seg(w,obs,&s,"tA1",0,16,&tp);if(rc!=0){return 41;}tn=tn+16;
            rc=train_seg(w,obs,&s,"tB1",1,16,&tp);if(rc!=0){return 42;}tn=tn+16;
            rc=train_seg(w,obs,&s,"tA2",0,8,&tp);if(rc!=0){return 43;}tn=tn+8;
            rc=train_seg(w,obs,&s,"tB2",1,8,&tp);if(rc!=0){return 44;}tn=tn+8;
        } else if(nio_equal(cid,"storm")==1){
            rc=train_seg(w,obs,&s,"tA1",0,16,&tp);if(rc!=0){return 51;}tn=tn+16;
            rc=train_seg(w,obs,&s,"tB1",1,2,&tp);if(rc!=0){return 52;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tA2",0,2,&tp);if(rc!=0){return 53;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tB2",1,2,&tp);if(rc!=0){return 54;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tA3",0,2,&tp);if(rc!=0){return 55;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tB3",1,2,&tp);if(rc!=0){return 56;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tA4",0,2,&tp);if(rc!=0){return 57;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tB4",1,2,&tp);if(rc!=0){return 58;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tA5",0,2,&tp);if(rc!=0){return 59;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tB5",1,2,&tp);if(rc!=0){return 60;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tA6",0,2,&tp);if(rc!=0){return 61;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tB6",1,2,&tp);if(rc!=0){return 62;}tn=tn+2;
            rc=train_seg(w,obs,&s,"tA7",0,2,&tp);if(rc!=0){return 63;}tn=tn+2;
        } else { _zag_println("unknown curriculum");return 90; }
        rc=frozen_seg(w,obs,&s,"evalA",0,16,1);if(rc!=0){return 71;}
        rc=frozen_seg(w,obs,&s,"evalB",1,16,1);if(rc!=0){return 72;}
        rc=frozen_seg(w,obs,&s,"returnA",0,16,1);if(rc!=0){return 73;}
    }
    _zag_print("TRL,train_total,pos=");cl_number(tp as i64);
    _zag_print(",n=");cl_number(tn as i64);_zag_println("");
    _zag_print("TRL,DONE");_zag_println("");
    nio_free(w);nio_free(obs);return 0;
}

// WB3 trial driver — PREREG_WB3 protocol (deterministic designed sequence).
// No RNG in system or harness. Runs the protocol at 1x (64 slots) and 10x
// (640 slots), checks ledger determinism via double-run, and runs the
// designed adversarial cases (digest tamper, out-of-band state mutation,
// ledger-overflow fail-closed).
@import("wb3_core.zag")

// Full protocol. blocks = churn blocks; each block is composition-identical
// (8 KILL + 8 ADD + 8 AUDIT_SET + PIN + UNPIN) so cross-scale comparison is exact.
fn wb_protocol(s:*WbStore,blocks:i32)i32 {
    let f:i32=0;
    let slot:i32=-1;let rc:i32=0;let j:i32=0;let b:i32=0;

    // 1. stage gate: ADD at NONE refused.
    rc=wb_add(s,10,WB_REGION_USER,&slot);
    f=f+cl_check("add_stage0_refused",rc,WB_REFUSED_STAGE);
    rc=wb_set_stage(s,WB_STAGE_KILL);
    f=f+cl_check("setstage_ok",rc,WB_OK);

    // 2. ADD 1 CORE + 10 USER (slots 0..10).
    rc=wb_add(s,100,WB_REGION_CORE,&slot);
    f=f+cl_check("add_core_ok",rc,WB_OK);
    f=f+cl_check("add_core_slot",slot,0);
    f=f+cl_check("core_default_full",(s.*.alevel[0] as i32),WB_ALEVEL_FULL);
    j=1;
    while(j<=10){
        rc=wb_add(s,50+j,WB_REGION_USER,&slot);
        f=f+cl_check("add_user_ok",rc,WB_OK);
        f=f+cl_check("add_user_slot",slot,j);
        j=j+1;
    }

    // 3. structural floors: CORE and pinned slots refuse SUMMARY.
    rc=wb_audit_set(s,0,WB_ALEVEL_SUMMARY);
    f=f+cl_check("auditset_core_locked",rc,WB_AUDIT_LOCKED);
    f=f+cl_check("core_stays_full",(s.*.alevel[0] as i32),WB_ALEVEL_FULL);
    rc=wb_pin(s,9);
    f=f+cl_check("pin9_ok",rc,WB_OK);
    rc=wb_audit_set(s,9,WB_ALEVEL_SUMMARY);
    f=f+cl_check("auditset_pinned_locked",rc,WB_AUDIT_LOCKED);
    rc=wb_unpin(s,9);
    f=f+cl_check("unpin9_ok",rc,WB_OK);

    // 4. deliberate downgrade: scratch slots 1..8 -> SUMMARY (FULL entries).
    j=1;
    while(j<=8){
        rc=wb_audit_set(s,j,WB_ALEVEL_SUMMARY);
        f=f+cl_check("scratch_summary_ok",rc,WB_OK);
        f=f+cl_check("scratch_summary_level",(s.*.alevel[j] as i32),WB_ALEVEL_SUMMARY);
        j=j+1;
    }
    rc=wb_audit_set(s,10,7);
    f=f+cl_check("auditset_badlevel",rc,WB_BADLEVEL);
    rc=wb_audit_set(s,11,WB_ALEVEL_SUMMARY);
    f=f+cl_check("auditset_notlive",rc,WB_REFUSED_NOTLIVE);

    // 5. churn.
    b=0;
    while(b<blocks){
        j=1;
        while(j<=8){
            rc=wb_kill(s,j);
            f=f+cl_check("churn_kill_ok",rc,WB_OK);
            j=j+1;
        }
        j=0;
        while(j<8){
            rc=wb_add(s,2000+b*8+j,WB_REGION_USER,&slot);
            f=f+cl_check("churn_add_ok",rc,WB_OK);
            f=f+cl_check("churn_add_slot",slot,j+1);
            j=j+1;
        }
        j=1;
        while(j<=8){
            rc=wb_audit_set(s,j,WB_ALEVEL_SUMMARY);
            f=f+cl_check("churn_resummary_ok",rc,WB_OK);
            j=j+1;
        }
        rc=wb_pin(s,9);f=f+cl_check("churn_pin_ok",rc,WB_OK);
        rc=wb_unpin(s,9);f=f+cl_check("churn_unpin_ok",rc,WB_OK);
        b=b+1;
    }

    // 6. partial batch + explicit flush; flush on empty batch is refused (audited).
    rc=wb_kill(s,1);
    f=f+cl_check("x_kill_ok",rc,WB_OK);
    rc=wb_flush(s);
    f=f+cl_check("flush_ok",rc,WB_OK);
    rc=wb_flush(s);
    f=f+cl_check("flush_empty_refused",rc,WB_FLUSH_EMPTY);

    // 7. capability manifest + inspection API.
    rc=wb_manifest_update(s,1);
    f=f+cl_check("manifest_update_ok",rc,WB_OK);
    f=f+cl_check("inspect_manifest",wb_inspect_manifest(s),1);
    f=f+cl_check("inspect_coverage",wb_inspect_coverage(s),1);
    f=f+cl_check("inspect_why",((wb_inspect_why(s,1))>0) as i32,1);
    f=f+cl_check("inspect_replay",wb_inspect_replay(s),1);
    return f;
}

// Designed adversity: T1 digest tamper, T2 out-of-band state mutation,
// T3 ledger-overflow fail-closed. No RNG.
fn wb_tamper_tests()i32 {
    let f:i32=0;
    let slot:i32=-1;let rc:i32=0;let j:i32=0;

    // T1: flip an after-word inside a compact summary record out-of-band.
    let t:WbStore=wb_init(16,256,256);
    rc=wb_set_stage(&t,WB_STAGE_KILL);f=f+cl_check("t1_stage",rc,WB_OK);
    rc=wb_add(&t,50,WB_REGION_USER,&slot);f=f+cl_check("t1_add",rc,WB_OK);
    rc=wb_audit_set(&t,slot,WB_ALEVEL_SUMMARY);f=f+cl_check("t1_summary",rc,WB_OK);
    rc=wb_unpin(&t,slot);f=f+cl_check("t1_unpin1",rc,WB_OK);
    rc=wb_unpin(&t,slot);f=f+cl_check("t1_unpin2",rc,WB_OK);
    rc=wb_flush(&t);f=f+cl_check("t1_flush",rc,WB_OK);
    f=f+cl_check("t1_replay_clean",wb_replay_check(&t),WB_OK);
    let w:i32=wb_i32_get(t.sum,8);
    wb_i32_set(t.sum,8,w+1); // out-of-band: no op, no digest update
    f=f+cl_check("t1_tamper_detected",wb_replay_check(&t),2);
    wb_free(&t);

    // T2: mutate live slot state out-of-band (no ledger entry at all).
    let u:WbStore=wb_init(16,256,256);
    rc=wb_set_stage(&u,WB_STAGE_KILL);f=f+cl_check("t2_stage",rc,WB_OK);
    rc=wb_add(&u,70,WB_REGION_USER,&slot);f=f+cl_check("t2_add",rc,WB_OK);
    f=f+cl_check("t2_replay_clean",wb_replay_check(&u),WB_OK);
    u.live[slot]=0; // out-of-band
    f=f+cl_check("t2_divergence_detected",wb_replay_check(&u),1);
    wb_free(&u);

    // T3: tiny ledger; drive to capacity; next mutation must refuse, not drop.
    let o:WbStore=wb_init(8,16,64);
    rc=wb_set_stage(&o,WB_STAGE_KILL);f=f+cl_check("t3_stage",rc,WB_OK);
    j=0;
    while(j<8){
        rc=wb_add(&o,10+j,WB_REGION_USER,&slot);
        f=f+cl_check("t3_add_ok",rc,WB_OK);
        j=j+1;
    }
    rc=wb_pin(&o,0);f=f+cl_check("t3_pin",rc,WB_OK);
    rc=wb_unpin(&o,0);f=f+cl_check("t3_unpin",rc,WB_OK);
    rc=wb_pin(&o,0);f=f+cl_check("t3_pin2",rc,WB_OK);
    rc=wb_unpin(&o,0);f=f+cl_check("t3_unpin2",rc,WB_OK);
    rc=wb_pin(&o,0);f=f+cl_check("t3_pin3",rc,WB_OK);
    rc=wb_unpin(&o,0);f=f+cl_check("t3_unpin3",rc,WB_OK);
    rc=wb_pin(&o,0);f=f+cl_check("t3_pin4",rc,WB_OK);
    f=f+cl_check("t3_audit_n_capped",o.audit_n,16);
    rc=wb_unpin(&o,0);
    f=f+cl_check("t3_overflow_refused",rc,WB_REFUSED_AUDITFULL);
    f=f+cl_check("t3_still_capped",o.audit_n,16);
    f=f+cl_check("t3_state_intact",(o.pinned[0] as i32),1);
    f=f+cl_check("t3_replay_ok",wb_replay_check(&o),WB_OK);
    wb_free(&o);
    return f;
}

fn main()i32 {
    let f:i32=0;

    _zag_println("WB_PHASE,scale1x");
    let s1:WbStore=wb_init(64,4096,4096);
    f=f+wb_protocol(&s1,5);
    let fo1:i32=0;let so1:i32=0;let ba1:i32=0;let re1:i32=0;
    wb_fold_counts(&s1,&fo1,&so1,&ba1,&re1);
    let bytes1:i64=(s1.audit_n as i64)*40+(s1.sum_n as i64)*24;
    let ops1:i64=(fo1+so1) as i64;
    _zag_print("WB_STATS,scale=1,audit_n=");cl_number(s1.audit_n as i64);
    _zag_print(",sum_n=");cl_number(s1.sum_n as i64);
    _zag_print(",bytes=");cl_number(bytes1);
    _zag_print(",ops=");cl_number(ops1);
    _zag_println("");
    wb_free(&s1);

    _zag_println("WB_PHASE,scale10x");
    let s2:WbStore=wb_init(640,40960,40960);
    f=f+wb_protocol(&s2,50);
    let fo2:i32=0;let so2:i32=0;let ba2:i32=0;let re2:i32=0;
    wb_fold_counts(&s2,&fo2,&so2,&ba2,&re2);
    let bytes2:i64=(s2.audit_n as i64)*40+(s2.sum_n as i64)*24;
    let ops2:i64=(fo2+so2) as i64;
    _zag_print("WB_STATS,scale=10,audit_n=");cl_number(s2.audit_n as i64);
    _zag_print(",sum_n=");cl_number(s2.sum_n as i64);
    _zag_print(",bytes=");cl_number(bytes2);
    _zag_print(",ops=");cl_number(ops2);
    _zag_println("");
    // Scale dimension (program law A1): the fixed setup/ending cost is
    // amortized differently at the two scales, so linearity is asserted on
    // the MARGIN: each churn block is composition-identical (8 KILL + 8 ADD
    // + 8 AUDIT_SET + PIN + UNPIN = 26 fold-counted ops; 19 full entries x40B
    // + 8 compact records x24B = 952 ledger bytes). The marginal bytes/op
    // must be exactly equal across scales: dbytes*26 == dops*952.
    f=f+cl_check64("scale_linear_marginal", (bytes2-bytes1)*26, (ops2-ops1)*952);
    wb_free(&s2);

    _zag_println("WB_PHASE,determinism");
    let sa:WbStore=wb_init(64,4096,4096);
    let fa:i32=wb_protocol(&sa,5);
    let ca:i32=wb_ledger_checksum(&sa);
    wb_free(&sa);
    let sb:WbStore=wb_init(64,4096,4096);
    let fb:i32=wb_protocol(&sb,5);
    let cb:i32=wb_ledger_checksum(&sb);
    wb_free(&sb);
    f=f+fa+fb;
    f=f+cl_check("deterministic_ledger",ca,cb);

    _zag_println("WB_PHASE,adversity");
    f=f+wb_tamper_tests();

    _zag_print("WB_FAILURES,");cl_number(f as i64);_zag_println("");
    if(f!=0){return 1;}
    return 0;
}

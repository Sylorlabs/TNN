// fulldelib_main.zag — FULL-DELIB no-economy deliberation baseline binary.
// Usage: fulldelib_bin STATE_SNAPSHOT ITEMS_MANIFEST OUT_ARTIFACT
@import("delib_core.zag")

fn main()i32 {
    let st:[]u8=_zag_arg(1);
    let it:[]u8=_zag_arg(2);
    let ou:[]u8=_zag_arg(3);
    if(st.len==0||it.len==0||ou.len==0){
        _zag_println("USAGE: fulldelib_bin STATE ITEMS OUT");
        return 1;
    }
    return scored_entry(MODE_FULLDELIB,st,it,ou);
}

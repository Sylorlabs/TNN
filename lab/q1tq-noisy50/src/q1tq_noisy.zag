// q1tq_noisy.zag — CREW TQ-NOISY50 (teacher QUALITY series, 50% noise leg).
//
// The noisy teacher: start from the Q1B learned teacher's 228 genuinely
// learned TRUE claims (q1b_learned_teacher_build: scaffold-and-release,
// 0 plants, 228 deliberate adds, 1 disconnect — audited), then apply a
// HARNESS-SIDE deterministic corruption: every held claim whose fact id is
// even (id mod 2 == 0, by fact-id order) is flipped to a plausible false
// value using the SAME construction as t5_plant_claim:
//     false = t5_base(id) + ((t5_truth(id) - t5_base(id) + 1) % t5_mod(id))
// (per-category ranges from the domain code: t5_cat/t5_mod/t5_base).
// The corruption is not a TNN decision (no learning path is involved); it
// models a teacher whose memory holds false claims. The teacher's learning
// history (0 plants, 228 adds) is unchanged; only its held claims at teach
// time are corrupted.
//
// The teacher teaches from its store: the teaching stimulus for each slice
// is built from the teacher's HELD CLAIMS (t5_claim_of), not from world
// truth. This is the Q1 teacher-leg pattern ("teacher proposes, learner
// judges") with the teacher's knowledge as the teaching content — the only
// non-degenerate realization, because the §P wire carries spans only and
// the learner decodes values from the teaching stimulus. The flaw schedule
// (§B.7) and sealed scorer are untouched: they test proposal FORM
// (span/grounding/confidence), which noise does not touch.
//
// Sibling legs (TQ-NOISY10: id mod 10 == 0; TQ-NOISY25: id mod 4 == 0) use
// the same construction; together the three legs map the degradation curve.
//
// Pure Zag, zero RNG. Fully deterministic.

// Deterministic noise injection. Returns the number of claims flipped.
fn q1tq_inject_noise(teacher:*T5Store)i32 {
    let n:i32=0;
    let k:i32=0;
    while(k<Q1_PROBE_N){
        let fid:i32=q1_probe_id(k);
        if(fid%2==0){
            let t:i32=t5_truth(fid);
            let m:i32=t5_mod(fid);
            let b:i32=t5_base(fid);
            // same false-value construction as t5_plant_claim
            let fv:i32=b+(((t-b)+1)%m);
            if(t5_claim_set(teacher,fid,fv)==0){n=n+1;}
        }
        k=k+1;
    }
    return n;
}

// Build one teaching stimulus from the TEACHER'S HELD CLAIMS (not world
// truth). Placement (slots, offsets, offtab) is the identical lawful
// function of (layout, base, nf) as q1_build_stimulus; only the record
// VALUE written is the teacher's claim for the fact. Returns records placed.
fn q1tq_build_stimulus_teacher(layout:i32,base:i32,nf:i32,stim:[]u8,
                               occ:[]u8,offtab:[]u8,teacher:*T5Store)i32 {
    let i:i32=0;
    while(i<Q1_TAPE_LEN){stim[i]=Q1_FILL as u8;i=i+1;}
    i=0;
    while(i<Q1_NSLOTS){occ[i]=0;i=i+1;}
    let placed:i32=0;
    let k:i32=0;
    while(k<nf){
        let fid:i32=q1_probe_id((base+k)%Q1_PROBE_N);
        let o:i32=0;
        while(o<3){
            let s:i32=q1_slot_of(layout,fid,o,occ);
            if(s>=0){
                occ[s]=1;
                let at:i32=s*Q1_SLOT;
                tb_put32(stim,at,fid as i64);
                tb_put32(stim,at+4,t5_claim_of(teacher,fid) as i64);
                tb_i64_set(offtab,(k*3+o)*8,at as i64);
                placed=placed+1;
            }
            o=o+1;
        }
        k=k+1;
    }
    return placed;
}

// Filter/absorb accounting for one fact: the teacher holds (fid -> tclaim).
// taught=1 if the learner was ever taught this fact (curriculum probe ids
// 0..191; scaffold ids 192..199 are trainer-presented world-truth and the
// rest are never taught). Writes into the counters via pointers.
// absorbed: learner holds the teacher's FALSE claim.
// filtered: teacher's claim was false but the learner does not hold it
//   (holds the true value, or holds nothing).
// untaught: false claim the learner never saw.
fn q1tq_account_fact(taught:i32,fid:i32,tclaim:i32,truth:i32,
                     learner:*T5Store,abs:*i32,fil:*i32,unt:*i32)void {
    if(tclaim==truth){return;}
    if(taught==0){unt.*=unt.*+1;return;}
    let lc:i32=t5_claim_of(learner,fid);
    if(lc==tclaim){abs.*=abs.*+1;}
    else{fil.*=fil.*+1;}
    return;
}

// Count false claims whose value lies OUTSIDE the fact's category range
// (must be 0: the noise is plausible by construction —
// base + ((truth-base+1) % mod) always lands in [base, base+mod)).
fn q1tq_implausible_false_claims(s:*T5Store)i32 {
    let bad:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            let c:i32=t5_claim_of(s,id);
            let t:i32=t5_truth(id);
            if(c!=t){
                let b:i32=t5_base(id);
                let m:i32=t5_mod(id);
                if(c<b || c>=b+m){bad=bad+1;}
            }
        }
        id=id+1;
    }
    return bad;
}

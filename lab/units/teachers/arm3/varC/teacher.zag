// teacher.zag — Arm-3 variation C: engagement-meter teacher (teacher_id=3).
//
// The (spec, stimulus, history) -> proposal mapping lives ENTIRELY IN THIS
// TEACHER. The driver ferries bytes; every proposal the teacher emits is a
// pure deterministic function of (slice bytes, vocab table, decision tape).
// No RNG, no wallclock (logical tape order only), no learning machinery:
// the entire per-session state is E (engagement, i32) plus small fixed-size
// counters/tables, all recomputed from the tape on every invocation.
//
// Mechanism (see SPEC.md for the binding text):
//   E in [0,1000]. Decisions: ADOPT +120, REVISE +60, DEFER +10, REJECT -150.
//   Per-proposal decay -20 (applied when a proposal is recorded).
//   Two consecutive REJECTs: E -= 200, cursor jumps to a new region, and the
//   next emission RETRACTs the most recent un-decided proposal (if any).
//   Bands: E<300 cold (probes 60..100, WORD_SPAN, 1 grounding, fresh regions);
//   300<=E<700 warm (120..180, 1-2 groundings, appeals with NEW grounding);
//   E>=700 hot (180..220, 2-3 groundings, SAME_AS/BOUNDARY/GROUP relational).
//   Confidence never reaches 255 by policy.
//
// CLI:
//   teacher propose   <slice_idx 0-7> <session_id> <wired_dir> <hist_dir> <hist_name>
//   teacher selfcheck <slice_idx 0-7> <session_id> <wired_dir> <hist_dir> <hist_name>
//   teacher trace     <slice_idx 0-7> <session_id> <wired_dir> <hist_dir> <hist_name>
// propose:   emits exactly one §P wire proposal on stdout (fd 1); diagnostics
//            (E trace line) on fd 2. Exit 0, or 20 at the session cap (64).
// selfcheck: replays the tape and re-derives every recorded proposal from the
//            tape prefix; exit 0 = all match, 21 = divergence.
// trace:     prints the per-event E trace to stdout.
// Any malformed input -> exact exit code (see SPEC.md §6), logged on fd 2,
// zero bytes on stdout.
//
// ZNC-bug discipline (AGENTS.md ZNC-002..012): integer tables are []u8 arenas
// with explicit LE accessors only (never `as []i32` etc.); no structs at all
// (state lives in arenas); no slice ==; no `};`; `return;` with semicolon in
// void fns; hoisted shifts; nio_alloc zero-fills every arena.

@import("../../harness/substrate/R33_NATIVE_IO_V1.zag")

// ---------------- little-endian helpers (same as arm-1) ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_iget(b:[]u8, idx:i32) i32 {
    return t_get32(b, idx*4) as i32;
}
fn t_iset(b:[]u8, idx:i32, v:i32) void {
    t_put32(b, idx*4, v as i64);
}

// ---------------- FNV-1a-64 (frozen §P checksum) ----------------
fn t_fnv1a(b:[]u8, n:i32) i64 {
    let h:i64 = -3750763034362895579;
    let i:i32 = 0;
    while(i < n) {
        h = h ^ ((b[i] as i64) & 255);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

// ---------------- small utilities ----------------
fn t_parse_u64(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < s.len) {
        let c:i32 = s[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}
fn t_is_word_byte(b:u8) i32 {
    let c:i32 = b as i32;
    if(c >= 48 && c <= 57) { return 1; }
    if(c >= 65 && c <= 90) { return 1; }
    if(c >= 97 && c <= 122) { return 1; }
    if(c == 95) { return 1; }
    return 0;
}
// decimal writer for diagnostics (no _zag_i64_to_str dependency)
fn t_wu64(fd:i64, v:i64) void {
    let buf:[]u8 = nio_alloc(24);
    if(v == 0) { buf[0] = 48; nio_write_all(fd, buf[0..1]); return; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    let x:i64 = v;
    while(x > 0) {
        tmp[n] = ((x % 10) + 48) as u8;
        x = x / 10;
        n = n + 1;
    }
    let i:i32 = 0;
    while(i < n) { buf[i] = tmp[n-1-i]; i = i + 1; }
    nio_write_all(fd, buf[0..n]);
}
fn t_wstr(fd:i64, s:[]u8) void {
    if(s.len > 0) { nio_write_all(fd, s); }
}
fn t_die(msg:[]u8) i32 {
    nio_write_all(2, msg);
    return 13;
}

// ---------------- E-meter constants (SPEC.md §2, binding) ----------------
fn C_EMAX() i32 { return 1000; }
fn C_BAND_COLD() i32 { return 300; }
fn C_BAND_HOT() i32 { return 700; }
fn C_D_ADOPT() i32 { return 120; }
fn C_D_REVISE() i32 { return 60; }
fn C_D_DEFER() i32 { return 10; }
fn C_D_REJECT() i32 { return -150; }
fn C_DECAY() i32 { return 20; }
fn C_RETRACT_PEN() i32 { return 200; }
fn C_NPROP_MAX() i32 { return 64; }
fn C_NEV_MAX() i32 { return 512; }
fn C_REG_N() i32 { return 64; }
fn C_REG_SZ() i32 { return 1024; }
fn C_STIM() i32 { return 65536; }
fn C_APPEAL_MAX() i32 { return 2; }
fn C_DEAD_REJECTS() i32 { return 2; }
fn C_H_MAGIC() i64 { return 0x48434454; }  // "TDCH" LE

fn e_clamp(e:i32) i32 {
    if(e < 0) { return 0; }
    if(e > 1000) { return 1000; }
    return e;
}
// band: 0=cold, 1=warm, 2=hot
fn e_band(e:i32) i32 {
    if(e < 300) { return 0; }
    if(e < 700) { return 1; }
    return 2;
}
// confidence from band + E. Hot max 220: never 255 by policy.
fn e_conf(band:i32, e:i32) i32 {
    if(band == 0) { return 60 + (e % 41); }
    if(band == 1) { return 120 + (e % 61); }
    return 180 + (e % 41);
}
// grounding budget from band + E
fn e_ground_n(band:i32, e:i32) i32 {
    if(band == 0) { return 1; }
    if(band == 1) {
        if(e >= 500) { return 2; }
        return 1;
    }
    if(e >= 850) { return 3; }
    return 2;
}

// ---------------- history tape ----------------
// Header (32B): magic u32@0, version u16@4, session_id u64@8,
//               stim_len u64@16, nevents u32@24.
// Records (256B each): tag u8@0.
//   PROPOSE(tag=1): seq u64@1, kind u8@9, ss u64@10, se u64@18, conf u8@26,
//                   aux_count u8@27, ground_count u8@28,
//                   aux pairs (u64,u64) @29 (<=2), ground pairs @61 (<=4).
//   DECIDE(tag=2):  seq u64@1, verdict u8@9 (1=ADOPT 2=REVISE 3=REJECT 4=DEFER),
//                   reason u16@10 (0=none; R1..R6 = 1..6),
//                   rev_start u64@12, rev_end u64@20.
fn h_rec(hist:[]u8, ei:i32) i32 {
    return 32 + ei*256;
}

// pt row fields (stride 12 i32s)
fn PF_SS() i32 { return 0; }
fn PF_SE() i32 { return 1; }
fn PF_KIND() i32 { return 2; }
fn PF_CONF() i32 { return 3; }
fn PF_AC() i32 { return 4; }
fn PF_GC() i32 { return 5; }
fn PF_APPEAL_OF() i32 { return 6; }
fn PF_STATE() i32 { return 7; }
fn PF_FINAL() i32 { return 8; }
fn pt_get(pt:[]u8, row:i32, f:i32) i32 {
    return t_iget(pt, row*12 + f);
}
fn pt_set(pt:[]u8, row:i32, f:i32, v:i32) void {
    t_iset(pt, row*12 + f, v);
}
// st scalar fields
fn SF_E() i32 { return 0; }
fn SF_CONSEC() i32 { return 1; }
fn SF_CURSOR() i32 { return 2; }
fn SF_NPROP() i32 { return 3; }
fn SF_ADOPTED_N() i32 { return 4; }
fn SF_ARM() i32 { return 5; }
fn SF_DONE() i32 { return 6; }
fn st_get(st:[]u8, f:i32) i32 {
    return t_iget(st, f);
}
fn st_set(st:[]u8, f:i32, v:i32) void {
    t_iset(st, f, v);
}
fn st_covered(st:[]u8) i64 {
    return t_get64(st, 32);
}
fn st_covered_set(st:[]u8, v:i64) void {
    t_put64(st, 32, v);
}

// appeal_of recovery: a proposal re-proposing an earlier (ss,se,kind) is an
// appeal; chains collapse to the original seq. Pure function of the tape.
fn recover_appeal_of(pt:[]u8, row:i32) i32 {
    let ss:i32 = pt_get(pt, row, 0);
    let se:i32 = pt_get(pt, row, 1);
    let kind:i32 = pt_get(pt, row, 2);
    let i:i32 = 0;
    while(i < row) {
        if(pt_get(pt, i, 0) == ss && pt_get(pt, i, 1) == se && pt_get(pt, i, 2) == kind) {
            let ao:i32 = pt_get(pt, i, 6);
            if(ao >= 0) { return ao; }
            return i;
        }
        i = i + 1;
    }
    return -1;
}
fn appeals_used(pt:[]u8, nprop:i32, orig:i32) i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    while(i < nprop) {
        if(pt_get(pt, i, 6) == orig) { n = n + 1; }
        i = i + 1;
    }
    return n;
}
fn final_rejects(pt:[]u8, nprop:i32, ss:i32, se:i32, kind:i32) i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    while(i < nprop) {
        if(pt_get(pt, i, 0) == ss && pt_get(pt, i, 1) == se
           && pt_get(pt, i, 2) == kind && pt_get(pt, i, 7) == 3) { n = n + 1; }
        i = i + 1;
    }
    return n;
}
// an identical span already live (adopted / un-decided / revised) is not a
// fresh candidate; rejected ones are re-eligible only via the appeal path.
fn dup_live(pt:[]u8, nprop:i32, ss:i32, se:i32) i32 {
    let i:i32 = 0;
    while(i < nprop) {
        if(pt_get(pt, i, 0) == ss && pt_get(pt, i, 1) == se && pt_get(pt, i, 2) == 1) {
            let s:i32 = pt_get(pt, i, 7);
            if(s == 0 || s == 1 || s == 2 || s == 4) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

// replay: validate + fold the tape into (st, pt, pg, ad).
// Returns 0, or the exact §P-style exit code (1..10).
fn replay(hist:[]u8, nev:i32, st:[]u8, pt:[]u8, pg:[]u8, ad:[]u8) i32 {
    st_set(st, 0, 0);
    st_set(st, 1, 0);
    st_set(st, 2, 0);
    st_set(st, 3, 0);
    st_set(st, 4, 0);
    st_set(st, 5, -1);
    st_set(st, 6, 0);
    st_covered_set(st, 0);
    let ei:i32 = 0;
    while(ei < nev) {
        let base:i32 = h_rec(hist, ei);
        let tag:i32 = hist[base] as i32;
        if(tag == 1) {
            let nprop:i32 = st_get(st, 3);
            if(nprop >= 64) { return 10; }
            let seq:i64 = t_get64(hist, base+1);
            if(seq != (nprop as i64)) { return 4; }
            let kind:i32 = hist[base+9] as i32;
            if(kind < 1 || kind > 5) { return 6; }
            let ss:i64 = t_get64(hist, base+10);
            let se:i64 = t_get64(hist, base+18);
            if(se <= ss) { return 5; }
            if(ss < 0 || se > 65536) { return 8; }
            let ac:i32 = hist[base+27] as i32;
            let gc:i32 = hist[base+28] as i32;
            if(ac < 0 || ac > 2 || gc < 0 || gc > 4) { return 9; }
            let q:i32 = 0;
            while(q < ac) {
                let s:i64 = t_get64(hist, base+29+q*16);
                let e:i64 = t_get64(hist, base+29+q*16+8);
                if(e <= s || s < 0 || e > 65536) { return 8; }
                q = q + 1;
            }
            q = 0;
            while(q < gc) {
                let s:i64 = t_get64(hist, base+61+q*16);
                let e:i64 = t_get64(hist, base+61+q*16+8);
                if(e <= s || s < 0 || e > 65536) { return 8; }
                q = q + 1;
            }
            pt_set(pt, nprop, 0, ss as i32);
            pt_set(pt, nprop, 1, se as i32);
            pt_set(pt, nprop, 2, kind);
            pt_set(pt, nprop, 3, hist[base+26] as i32);
            pt_set(pt, nprop, 4, ac);
            pt_set(pt, nprop, 5, gc);
            pt_set(pt, nprop, 6, recover_appeal_of(pt, nprop));
            pt_set(pt, nprop, 7, 0);
            pt_set(pt, nprop, 8, 0);
            let ng3:i32 = gc;
            if(ng3 > 3) { ng3 = 3; }
            q = 0;
            while(q < ng3) {
                t_iset(pg, nprop*6+q*2, t_get64(hist, base+61+q*16) as i32);
                t_iset(pg, nprop*6+q*2+1, t_get64(hist, base+61+q*16+8) as i32);
                q = q + 1;
            }
            // a RETRACT emission consumes a pending retract arming
            if(kind == 5 && st_get(st, 5) >= 0 && ei > st_get(st, 5)) {
                st_set(st, 6, 1);
            }
            // any proposal emission consumes a degraded (no-target) arming
            if(st_get(st, 5) >= 0 && ei > st_get(st, 5)) {
                st_set(st, 6, 1);
            }
            // fresh WORD_SPAN proposals consume their region: fold the
            // recorded region into (covered, cursor) so the state stays a
            // pure function of the tape (emission-time cursor/covered are
            // re-derived exactly; see SPEC.md §4).
            if(kind == 1 && pt_get(pt, nprop, 6) < 0) {
                if(st_covered(st) == -1) { st_covered_set(st, 0); }
                let rr:i32 = (ss as i32) / 1024;
                if(rr < 0) { rr = 0; }
                if(rr > 63) { rr = 63; }
                let rbit:i64 = (1 as i64) << (rr as i64);
                st_covered_set(st, st_covered(st) | rbit);
                st_set(st, 2, (rr + 7) % 64);
            }
            st_set(st, 3, nprop + 1);
            st_set(st, 0, e_clamp(st_get(st, 0) - 20));
        } else if(tag == 2) {
            let nprop:i32 = st_get(st, 3);
            let seq:i64 = t_get64(hist, base+1);
            if(seq < 0 || seq >= (nprop as i64)) { return 4; }
            let sq:i32 = seq as i32;
            if(pt_get(pt, sq, 8) == 1) { return 4; }
            let verdict:i32 = hist[base+9] as i32;
            if(verdict < 1 || verdict > 4) { return 6; }
            let reason:i32 = t_get16(hist, base+10) as i32;
            if(reason < 0 || reason > 6) { return 6; }
            if(verdict == 3 && (reason < 1 || reason > 6)) { return 6; }
            let e:i32 = st_get(st, 0);
            if(verdict == 1) {
                e = e + 120;
                st_set(st, 1, 0);
                pt_set(pt, sq, 7, 1);
                pt_set(pt, sq, 8, 1);
                let an:i32 = st_get(st, 4);
                if(an < 64) {
                    t_iset(ad, an*2, pt_get(pt, sq, 0));
                    t_iset(ad, an*2+1, pt_get(pt, sq, 1));
                    st_set(st, 4, an + 1);
                }
            } else if(verdict == 2) {
                e = e + 60;
                st_set(st, 1, 0);
                pt_set(pt, sq, 7, 2);
                pt_set(pt, sq, 8, 1);
            } else if(verdict == 4) {
                e = e + 10;
                st_set(st, 1, 0);
                pt_set(pt, sq, 7, 4);
            } else {
                e = e - 150;
                let c:i32 = st_get(st, 1) + 1;
                st_set(st, 1, c);
                pt_set(pt, sq, 7, 3);
                pt_set(pt, sq, 8, 1);
                if(c == 2) {
                    e = e - 200;
                    st_set(st, 2, (st_get(st, 2) + 13) % 64);
                    st_set(st, 5, ei);
                    st_set(st, 6, 0);
                }
            }
            st_set(st, 0, e_clamp(e));
        } else {
            return 6;
        }
        ei = ei + 1;
    }
    return 0;
}

// ---------------- occurrence matching ----------------
// rule: 0=WORD, 1=SUFFIX, 2=PREFIX. out: []u8 arena, starts via t_iset.
// Returns count (cap 8).
fn t_match8(s:[]u8, pat:[]u8, rule:i32, out:[]u8) i32 {
    let n:i32 = 0;
    let st:i32 = 0;
    let slen:i32 = s.len;
    let plen:i32 = pat.len;
    while(st + plen <= slen && n < 8) {
        let i:i32 = st;
        let found:i32 = -1;
        while(i + plen <= slen) {
            let k:i32 = 0;
            while(k < plen && s[i+k] == pat[k]) { k = k + 1; }
            if(k == plen) { found = i; break; }
            i = i + 1;
        }
        if(found < 0) { break; }
        let ok:i32 = 1;
        if(rule == 0) {
            if(found > 0 && t_is_word_byte(s[found-1]) == 1) { ok = 0; }
            if(found + plen < slen && t_is_word_byte(s[found+plen]) == 1) { ok = 0; }
        } else if(rule == 1) {
            if(found == 0 || t_is_word_byte(s[found-1]) == 0) { ok = 0; }
            if(found + plen < slen && t_is_word_byte(s[found+plen]) == 1) { ok = 0; }
        } else if(rule == 2) {
            if(found > 0 && t_is_word_byte(s[found-1]) == 1) { ok = 0; }
            if(found + plen >= slen || t_is_word_byte(s[found+plen]) == 0) { ok = 0; }
        }
        if(ok == 1) { t_iset(out, n, found); n = n + 1; }
        st = found + 1;
    }
    return n;
}
// first word-byte run at/after pos; writes (s,e) via out_s/out_e pointers.
fn word_after(s:[]u8, pos:i32, out_s:*i32, out_e:*i32) i32 {
    let i:i32 = pos;
    if(i < 0) { i = 0; }
    while(i < s.len && t_is_word_byte(s[i]) == 0) { i = i + 1; }
    if(i >= s.len) { return 0; }
    let j:i32 = i;
    while(j < s.len && t_is_word_byte(s[j]) == 1) { j = j + 1; }
    out_s[0] = i;
    out_e[0] = j;
    return 1;
}
// last word-byte run ending at/before pos.
fn word_before(s:[]u8, pos:i32, out_s:*i32, out_e:*i32) i32 {
    let j:i32 = pos;
    if(j > s.len) { j = s.len; }
    while(j > 0 && t_is_word_byte(s[j-1]) == 0) { j = j - 1; }
    if(j <= 0) { return 0; }
    let i:i32 = j;
    while(i > 0 && t_is_word_byte(s[i-1]) == 1) { i = i - 1; }
    out_s[0] = i;
    out_e[0] = j;
    return 1;
}

// ---------------- candidate + grounding selection ----------------
// recover the vocab entry behind a recorded (ss,se) span: first entry (in
// chunk_id order) whose pattern equals the slice bytes and whose rule holds
// at ss. -1 if none (fallback spans).
fn recover_vi(slice:[]u8, v_rule:[]u8, v_judg:[]u8, v_plen:[]u8, v_poff:[]u8,
              v_dom:[]u8, v_pat:[]u8, vn:i32, prose:i32, ss:i32, se:i32) i32 {
    let plen:i32 = se - ss;
    if(plen < 1) { return -1; }
    let vi:i32 = 0;
    while(vi < vn) {
        if(t_iget(v_judg, vi) > 0 && t_iget(v_plen, vi) == plen) {
            let dom:u8 = v_dom[vi];
            let dok:i32 = 0;
            if(prose == 1) { if(dom == 80 || dom == 78) { dok = 1; } }
            else { if(dom == 67) { dok = 1; } }
            if(dok == 1) {
                let poff:i32 = t_iget(v_poff, vi);
                let k:i32 = 0;
                while(k < plen && slice[ss+k] == v_pat[poff+k]) { k = k + 1; }
                if(k == plen) {
                    let rule:i32 = v_rule[vi] as i32;
                    let ok:i32 = 1;
                    if(rule == 0) {
                        if(ss > 0 && t_is_word_byte(slice[ss-1]) == 1) { ok = 0; }
                        if(se < slice.len && t_is_word_byte(slice[se]) == 1) { ok = 0; }
                    } else if(rule == 1) {
                        if(ss == 0 || t_is_word_byte(slice[ss-1]) == 0) { ok = 0; }
                        if(se < slice.len && t_is_word_byte(slice[se]) == 1) { ok = 0; }
                    } else if(rule == 2) {
                        if(ss > 0 && t_is_word_byte(slice[ss-1]) == 1) { ok = 0; }
                        if(se >= slice.len || t_is_word_byte(slice[se]) == 0) { ok = 0; }
                    }
                    if(ok == 1) { return vi; }
                }
            }
        }
        vi = vi + 1;
    }
    return -1;
}
fn excl_has(excl:[]u8, n:i32, a:i32, b:i32) i32 {
    let q:i32 = 0;
    while(q < n) {
        if(t_iget(excl, q*2) == a && t_iget(excl, q*2+1) == b) { return 1; }
        q = q + 1;
    }
    return 0;
}
// grounding spans for a primary span. vi>=0: other occurrences of the same
// pattern first (excluding `excl` pairs and the primary itself), then
// neighboring word spans. vi<0: neighbors only. Fills out pairs, returns n.
fn select_grounding(slice:[]u8, v_rule:[]u8, v_plen:[]u8, v_poff:[]u8, v_pat:[]u8,
                    vi:i32, prim_s:i32, prim_e:i32, excl:[]u8, n_excl:i32,
                    need:i32, out:[]u8) i32 {
    let n:i32 = 0;
    if(vi >= 0) {
        let occ:[]u8 = nio_alloc(8*4);
        let poff:i32 = t_iget(v_poff, vi);
        let plen:i32 = t_iget(v_plen, vi);
        let pat:[]u8 = v_pat[poff..poff+plen];
        let nocc:i32 = t_match8(slice, pat, v_rule[vi] as i32, occ);
        let q:i32 = 0;
        while(q < nocc && n < need) {
            let o:i32 = t_iget(occ, q);
            if(o != prim_s && excl_has(excl, n_excl, o, o+plen) == 0) {
                t_iset(out, n*2, o);
                t_iset(out, n*2+1, o+plen);
                n = n + 1;
            }
            q = q + 1;
        }
    }
    // neighbor word-span fallbacks: forward up to 3, backward up to 2.
    // Each skips the primary span, the exclusion list, and spans already
    // added (no duplicate grounding).
    let f:i32 = prim_e;
    let t:i32 = 0;
    while(t < 3 && n < need) {
        let ws:i32 = 0;
        let we:i32 = 0;
        if(word_after(slice, f, &ws, &we) == 0) { break; }
        if((ws != prim_s || we != prim_e) && excl_has(excl, n_excl, ws, we) == 0
           && excl_has(out, n, ws, we) == 0) {
            t_iset(out, n*2, ws);
            t_iset(out, n*2+1, we);
            n = n + 1;
        }
        f = we;
        t = t + 1;
    }
    let b:i32 = prim_s;
    t = 0;
    while(t < 2 && n < need) {
        let ws:i32 = 0;
        let we:i32 = 0;
        if(word_before(slice, b, &ws, &we) == 0) { break; }
        if((ws != prim_s || we != prim_e) && excl_has(excl, n_excl, ws, we) == 0
           && excl_has(out, n, ws, we) == 0) {
            t_iset(out, n*2, ws);
            t_iset(out, n*2+1, we);
            n = n + 1;
        }
        b = ws;
        t = t + 1;
    }
    return n;
}
// best WORD_SPAN candidate inside region [rs, rs+1024): min (start, entry).
// Writes *o_ss, *o_se, *o_vi. Returns 1 if found.
fn region_candidate(slice:[]u8, v_rule:[]u8, v_judg:[]u8, v_plen:[]u8,
                   v_poff:[]u8, v_dom:[]u8, v_pat:[]u8, vn:i32, prose:i32,
                   pt:[]u8, nprop:i32, rs:i32,
                   o_ss:*i32, o_se:*i32, o_vi:*i32) i32 {
    let best_s:i32 = 2147483647;
    let best_e:i32 = 0;
    let best_vi:i32 = -1;
    let occ:[]u8 = nio_alloc(8*4);
    let re:i32 = rs + 1024;
    let vi:i32 = 0;
    while(vi < vn) {
        if(t_iget(v_judg, vi) > 0) {
            let dom:u8 = v_dom[vi];
            let dok:i32 = 0;
            if(prose == 1) { if(dom == 80 || dom == 78) { dok = 1; } }
            else { if(dom == 67) { dok = 1; } }
            if(dok == 1) {
                let poff:i32 = t_iget(v_poff, vi);
                let plen:i32 = t_iget(v_plen, vi);
                let pat:[]u8 = v_pat[poff..poff+plen];
                let nocc:i32 = t_match8(slice, pat, v_rule[vi] as i32, occ);
                let q:i32 = 0;
                while(q < nocc) {
                    let s:i32 = t_iget(occ, q);
                    if(s >= rs && s < re) {
                        let e:i32 = s + plen;
                        if(final_rejects(pt, nprop, s, e, 1) < 2
                           && dup_live(pt, nprop, s, e) == 0) {
                            if(s < best_s || (s == best_s && vi < best_vi)) {
                                best_s = s;
                                best_e = e;
                                best_vi = vi;
                            }
                        }
                    }
                    q = q + 1;
                }
            }
        }
        vi = vi + 1;
    }
    if(best_vi < 0) { return 0; }
    o_ss[0] = best_s;
    o_se[0] = best_e;
    o_vi[0] = best_vi;
    return 1;
}

// ---------------- the emission decision ----------------
// Pure function of (hist prefix, slice, vocab). Fills out/out_ax/out_gn.
// out fields: 0=kind 1=ss 2=se 3=conf 4=ac 5=gc 6=action 7=vi
// action: 0=fresh 1=appeal 2=retract 3=relational. Returns 0 or 20 (cap).
fn decide(hist:[]u8, nev:i32, slice:[]u8,
          v_rule:[]u8, v_judg:[]u8, v_plen:[]u8, v_poff:[]u8, v_dom:[]u8,
          v_pat:[]u8, vn:i32, prose:i32,
          st:[]u8, pt:[]u8, pg:[]u8, ad:[]u8,
          out:[]u8, out_ax:[]u8, out_gn:[]u8) i32 {
    let nprop:i32 = st_get(st, 3);
    if(nprop >= 64) { return 20; }
    let e:i32 = st_get(st, 0);
    let band:i32 = e_band(e);
    let conf:i32 = e_conf(band, e);
    // --- 1. double-reject rule: RETRACT most recent un-decided proposal ---
    if(st_get(st, 1) == 2 && st_get(st, 5) >= 0 && st_get(st, 6) == 0) {
        let j:i32 = nprop - 1;
        while(j >= 0 && pt_get(pt, j, 8) == 1) { j = j - 1; }
        if(j >= 0) {
            t_iset(out, 0, 5);
            t_iset(out, 1, j);
            t_iset(out, 2, j+1);
            t_iset(out, 3, conf);
            t_iset(out, 4, 0);
            t_iset(out, 5, 0);
            t_iset(out, 6, 2);
            t_iset(out, 7, -1);
            return 0;
        }
    }
    // --- 2. warm appeal: re-propose an R1/R2/R5-rejected span, NEW grounding ---
    if(band == 1) {
        let ei:i32 = nev - 1;
        while(ei >= 0 && (hist[h_rec(hist, ei)] as i32) != 2) { ei = ei - 1; }
        if(ei >= 0) {
            let base:i32 = h_rec(hist, ei);
            let verdict:i32 = hist[base+9] as i32;
            let reason:i32 = t_get16(hist, base+10) as i32;
            if(verdict == 3 && (reason == 1 || reason == 2 || reason == 5)) {
                let k:i32 = t_get64(hist, base+1) as i32;
                if(k >= 0 && k < nprop && pt_get(pt, k, 2) == 1) {
                    let ss:i32 = pt_get(pt, k, 0);
                    let se:i32 = pt_get(pt, k, 1);
                    let orig:i32 = pt_get(pt, k, 6);
                    if(orig < 0) { orig = k; }
                    if(appeals_used(pt, nprop, orig) < 2
                       && final_rejects(pt, nprop, ss, se, 1) < 2) {
                        let vi:i32 = recover_vi(slice, v_rule, v_judg, v_plen,
                                               v_poff, v_dom, v_pat, vn, prose,
                                               ss, se);
                        if(vi >= 0) {
                            let excl:[]u8 = nio_alloc(3*2*4);
                            let n_excl:i32 = pt_get(pt, k, 5);
                            if(n_excl > 3) { n_excl = 3; }
                            let q:i32 = 0;
                            while(q < n_excl) {
                                t_iset(excl, q*2, t_iget(pg, k*6+q*2));
                                t_iset(excl, q*2+1, t_iget(pg, k*6+q*2+1));
                                q = q + 1;
                            }
                            let need:i32 = e_ground_n(band, e);
                            let ng:i32 = select_grounding(slice, v_rule, v_plen,
                                                         v_poff, v_pat, vi,
                                                         ss, se, excl, n_excl,
                                                         need, out_gn);
                            if(ng >= 1) {
                                t_iset(out, 0, 1);
                                t_iset(out, 1, ss);
                                t_iset(out, 2, se);
                                t_iset(out, 3, conf);
                                t_iset(out, 4, 0);
                                t_iset(out, 5, ng);
                                t_iset(out, 6, 1);
                                t_iset(out, 7, vi);
                                return 0;
                            }
                        }
                    }
                }
            }
        }
    }
    // --- 3. hot relational: SAME_AS / BOUNDARY / GROUP among adopted units ---
    let an:i32 = st_get(st, 4);
    if(band == 2 && an >= 2) {
        let ax0:i32 = t_iget(ad, (an-2)*2);
        let ax1:i32 = t_iget(ad, (an-2)*2+1);
        let bx0:i32 = t_iget(ad, (an-1)*2);
        let bx1:i32 = t_iget(ad, (an-1)*2+1);
        let form:i32 = nprop % 3;
        let need:i32 = e_ground_n(band, e);
        let excl:[]u8 = nio_alloc(4);
        if(form == 0 || (form == 1 && ax1 >= bx0)) {
            // SAME_AS (kind=4): primary = newer adopted span, aux = older
            let ng:i32 = select_grounding(slice, v_rule, v_plen, v_poff, v_pat,
                                         -1, bx0, bx1, excl, 0, need, out_gn);
            t_iset(out, 0, 4);
            t_iset(out, 1, bx0);
            t_iset(out, 2, bx1);
            t_iset(out, 3, conf);
            t_iset(out, 4, 1);
            t_iset(out, 5, ng);
            t_iset(out_ax, 0, ax0);
            t_iset(out_ax, 1, ax1);
            t_iset(out, 6, 3);
            t_iset(out, 7, -1);
            return 0;
        }
        if(form == 1) {
            // BOUNDARY (kind=2): the gap between the two adopted spans
            let ng:i32 = select_grounding(slice, v_rule, v_plen, v_poff, v_pat,
                                         -1, ax1, bx0, excl, 0, need, out_gn);
            t_iset(out, 0, 2);
            t_iset(out, 1, ax1);
            t_iset(out, 2, bx0);
            t_iset(out, 3, conf);
            t_iset(out, 4, 0);
            t_iset(out, 5, ng);
            t_iset(out, 6, 3);
            t_iset(out, 7, -1);
            return 0;
        }
        // GROUP (kind=3): covering span, both adopted spans as aux
        let ms:i32 = ax0;
        if(bx0 < ms) { ms = bx0; }
        let me2:i32 = ax1;
        if(bx1 > me2) { me2 = bx1; }
        let ng:i32 = select_grounding(slice, v_rule, v_plen, v_poff, v_pat,
                                     -1, ms, me2, excl, 0, need, out_gn);
        t_iset(out, 0, 3);
        t_iset(out, 1, ms);
        t_iset(out, 2, me2);
        t_iset(out, 3, conf);
        t_iset(out, 4, 2);
        t_iset(out, 5, ng);
        t_iset(out_ax, 0, ax0);
        t_iset(out_ax, 1, ax1);
        t_iset(out_ax, 2, bx0);
        t_iset(out_ax, 3, bx1);
        t_iset(out, 6, 3);
        t_iset(out, 7, -1);
        return 0;
    }
    // --- 4. fresh WORD_SPAN in a fresh region ---
    let cov:i64 = st_covered(st);
    let cur:i32 = st_get(st, 2);
    if(cov == -1) { cov = 0; }
    let chosen:i32 = -1;
    let c_ss:i32 = 0;
    let c_se:i32 = 0;
    let c_vi:i32 = -1;
    let tries:i32 = 0;
    while(tries < 64) {
        let r:i32 = (cur + 7*tries) % 64;
        let bit:i64 = (1 as i64) << (r as i64);
        if((cov & bit) == 0) {
            let fs:i32 = 0;
            let fe:i32 = 0;
            let fv:i32 = -1;
            if(region_candidate(slice, v_rule, v_judg, v_plen, v_poff, v_dom,
                               v_pat, vn, prose, pt, nprop, r*1024,
                               &fs, &fe, &fv) == 1) {
                chosen = r;
                c_ss = fs;
                c_se = fe;
                c_vi = fv;
                break;
            }
        }
        tries = tries + 1;
    }
    if(chosen < 0) {
        // degenerate fallback: first word run in the cursor region
        let rs:i32 = cur * 1024;
        let ws:i32 = 0;
        let we:i32 = 0;
        if(word_after(slice, rs, &ws, &we) == 1 && ws < rs+1024) {
            c_ss = ws;
            c_se = we;
        } else {
            c_ss = rs;
            c_se = rs + 1;
        }
        c_vi = -1;
        chosen = cur;
    }
    let excl2:[]u8 = nio_alloc(4);
    let ng2:i32 = select_grounding(slice, v_rule, v_plen, v_poff, v_pat, c_vi,
                                  c_ss, c_se, excl2, 0, e_ground_n(band, e),
                                  out_gn);
    t_iset(out, 0, 1);
    t_iset(out, 1, c_ss);
    t_iset(out, 2, c_se);
    t_iset(out, 3, conf);
    t_iset(out, 4, 0);
    t_iset(out, 5, ng2);
    t_iset(out, 6, 0);
    t_iset(out, 7, c_vi);
    return 0;
}

// ---------------- §P wire encode (frozen B.3; teacher_id=3) ----------------
fn p_encode(prop:[]u8, session_id:i64, seq:i64, kind:i32, ss:i64, se:i64,
            ax:[]u8, ac:i32, gn:[]u8, gc:i32, conf:i32) i32 {
    t_put32(prop, 0, 1414550096);
    t_put16(prop, 4, 1);
    t_put32(prop, 6, 3);
    t_put64(prop, 10, session_id);
    t_put64(prop, 18, seq);
    prop[26] = (kind & 255) as u8;
    t_put64(prop, 27, ss);
    t_put64(prop, 35, se);
    prop[43] = (ac & 255) as u8;
    let q:i32 = 0;
    while(q < ac) {
        t_put64(prop, 44+q*16, t_iget(ax, q*2) as i64);
        t_put64(prop, 44+q*16+8, t_iget(ax, q*2+1) as i64);
        q = q + 1;
    }
    let go:i32 = 44 + ac*16;
    prop[go] = (gc & 255) as u8;
    q = 0;
    while(q < gc) {
        t_put64(prop, go+1+q*16, t_iget(gn, q*2) as i64);
        t_put64(prop, go+1+q*16+8, t_iget(gn, q*2+1) as i64);
        q = q + 1;
    }
    let co:i32 = go + 1 + gc*16;
    prop[co] = (conf & 255) as u8;
    let ck:i64 = t_fnv1a(prop, co+1);
    t_put64(prop, co+1, ck);
    return co + 9;
}
// re-encode a recorded PROPOSE event (for selfcheck comparison)
fn rec_encode(hist:[]u8, base:i32, session_id:i64, prop:[]u8) i32 {
    let ax:[]u8 = nio_alloc(4*4);
    let gn:[]u8 = nio_alloc(8*4);
    let ac:i32 = hist[base+27] as i32;
    let gc:i32 = hist[base+28] as i32;
    let q:i32 = 0;
    while(q < ac) {
        t_iset(ax, q*2, t_get64(hist, base+29+q*16) as i32);
        t_iset(ax, q*2+1, t_get64(hist, base+29+q*16+8) as i32);
        q = q + 1;
    }
    q = 0;
    while(q < gc) {
        t_iset(gn, q*2, t_get64(hist, base+61+q*16) as i32);
        t_iset(gn, q*2+1, t_get64(hist, base+61+q*16+8) as i32);
        q = q + 1;
    }
    return p_encode(prop, session_id, t_get64(hist, base+1),
                   hist[base+9] as i32,
                   t_get64(hist, base+10), t_get64(hist, base+18),
                   ax, ac, gn, gc, hist[base+26] as i32);
}

// ---------------- main ----------------
fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let a4:[]u8 = _zag_arg(4);
    let a5:[]u8 = _zag_arg(5);
    let a6:[]u8 = _zag_arg(6);
    if(mode.len == 0 || a2.len == 0 || a3.len == 0 || a4.len == 0
       || a5.len == 0 || a6.len == 0) {
        return t_die("usage: teacher <propose|selfcheck|trace> <slice_idx 0-7> <session_id> <wired_dir> <hist_dir> <hist_name>\n");
    }
    let is_propose:i32 = 0;
    let is_selfcheck:i32 = 0;
    let is_trace:i32 = 0;
    if(_zag_strcmp(mode, "propose") == 1) { is_propose = 1; }
    if(_zag_strcmp(mode, "selfcheck") == 1) { is_selfcheck = 1; }
    if(_zag_strcmp(mode, "trace") == 1) { is_trace = 1; }
    if(is_propose == 0 && is_selfcheck == 0 && is_trace == 0) {
        return t_die("bad mode\n");
    }
    let slice_idx:i64 = t_parse_u64(a2);
    if(slice_idx < 0 || slice_idx > 7) { return t_die("bad slice_idx\n"); }
    let session_id:i64 = t_parse_u64(a3);

    let root:i64 = nio_open_root(a4);
    if(root < 0) { return t_die("cannot open wired_dir\n"); }

    // ---- slice bytes ----
    let sname:[]u8 = nio_alloc(16);
    sname[0] = 115; sname[1] = 108; sname[2] = 105; sname[3] = 99; sname[4] = 101;
    sname[5] = 95; sname[6] = 83; sname[7] = (48 + slice_idx) as u8;
    sname[8] = 46; sname[9] = 98; sname[10] = 105; sname[11] = 110;
    let sn:[]u8 = sname[0..12];
    if(nio_name_valid(sn) != 1) { return t_die("bad slice name\n"); }
    let sfd:i64 = nio_open_child(root, sn, 0);
    if(sfd < 0) { return t_die("cannot open slice file\n"); }
    let slice:[]u8 = nio_alloc(65536);
    let srd:i64 = nio_read_exact(sfd, slice, 65536);
    nio_close(sfd);
    if(srd != 65536) { return t_die("short slice read\n"); }

    // ---- vocab.bin (same layout as arm-1 wired tables) ----
    let vfd:i64 = nio_open_child(root, "vocab.bin", 0);
    if(vfd < 0) { return t_die("cannot open vocab.bin\n"); }
    let vraw:[]u8 = nio_alloc(8192);
    let vrd:i64 = nio_read_exact(vfd, vraw, 8192);
    nio_close(vfd);
    if(vrd <= 0) { return t_die("short vocab read\n"); }
    let vn:i32 = t_get32(vraw, 0) as i32;
    if(vn < 1 || vn > 128) { return t_die("bad vocab count\n"); }
    let v_rule:[]u8 = nio_alloc(128);
    let v_judg:[]u8 = nio_alloc(128*4);
    let v_plen:[]u8 = nio_alloc(128*4);
    let v_poff:[]u8 = nio_alloc(128*4);
    let v_dom:[]u8 = nio_alloc(128);
    let v_pat:[]u8 = nio_alloc(4096);
    let voff:i32 = 4;
    let poff:i32 = 0;
    let vi:i32 = 0;
    while(vi < vn) {
        let rule:i32 = vraw[voff] as i32;
        let judg:i32 = t_get32(vraw, voff+1) as i32;
        let plen:i32 = t_get16(vraw, voff+5) as i32;
        if(plen < 1 || plen > 64 || poff + plen > 4096) { return t_die("bad pattern\n"); }
        let k:i32 = 0;
        while(k < plen) { v_pat[poff+k] = vraw[voff+7+k]; k = k + 1; }
        v_rule[vi] = (rule & 255) as u8;
        t_iset(v_judg, vi, judg);
        t_iset(v_plen, vi, plen);
        t_iset(v_poff, vi, poff);
        v_dom[vi] = vraw[voff+7+plen+3];
        poff = poff + plen;
        voff = voff + 7 + plen + 8;
        vi = vi + 1;
    }
    nio_close(root);
    let prose:i32 = 0;
    if(slice_idx < 4) { prose = 1; }

    // ---- history tape (one shot; exact size enforced) ----
    let hroot:i64 = nio_open_root(a5);
    if(hroot < 0) { return t_die("cannot open hist_dir\n"); }
    if(nio_name_valid(a6) != 1) { nio_close(hroot); return t_die("bad hist name\n"); }
    let hfd:i64 = nio_open_child(hroot, a6, 0);
    if(hfd < 0) { nio_close(hroot); return t_die("cannot open history\n"); }
    let hcap:i32 = 32 + 512*256;
    let hist:[]u8 = nio_alloc(hcap);
    let hsize:i64 = nio_read_exact(hfd, hist, hcap);
    nio_close(hfd);
    nio_close(hroot);
    if(hsize < 32 || (hsize - 32) % 256 != 0) {
        nio_write_all(2, "history: bad size\n");
        return 10;
    }
    if(t_get32(hist, 0) != C_H_MAGIC()) {
        nio_write_all(2, "history: bad magic\n");
        return 1;
    }
    if(t_get16(hist, 4) != 1) {
        nio_write_all(2, "history: bad version\n");
        return 2;
    }
    if(t_get64(hist, 8) != session_id) {
        nio_write_all(2, "history: session_id mismatch\n");
        return 3;
    }
    if(t_get64(hist, 16) != 65536) {
        nio_write_all(2, "history: bad stim_len\n");
        return 8;
    }
    let nev:i32 = t_get32(hist, 24) as i32;
    if(nev < 0 || nev > 512) {
        nio_write_all(2, "history: bad nevents\n");
        return 10;
    }
    if(hsize != (32 + nev*256) as i64) {
        nio_write_all(2, "history: size/nevents mismatch\n");
        return 10;
    }

    // ---- replay state ----
    let st:[]u8 = nio_alloc(48);
    let pt:[]u8 = nio_alloc(64*12*4);
    let pg:[]u8 = nio_alloc(64*6*4);
    let ad:[]u8 = nio_alloc(64*2*4);
    let rc:i32 = replay(hist, nev, st, pt, pg, ad);
    if(rc != 0) {
        nio_write_all(2, "history: replay rejected\n");
        return rc;
    }

    let out:[]u8 = nio_alloc(8*4);
    let out_ax:[]u8 = nio_alloc(4*4);
    let out_gn:[]u8 = nio_alloc(8*4);
    let prop:[]u8 = nio_alloc(256);

    if(is_trace == 1) {
        // per-event E trace to stdout
        let p:i32 = 1;
        while(p <= nev) {
            let r2:i32 = replay(hist, p, st, pt, pg, ad);
            if(r2 != 0) {
                nio_write_all(2, "trace: replay failed\n");
                return r2;
            }
            let base:i32 = h_rec(hist, p-1);
            t_wstr(1, "ev=");
            t_wu64(1, (p-1) as i64);
            t_wstr(1, " tag=");
            t_wu64(1, hist[base] as i64);
            t_wstr(1, " E=");
            t_wu64(1, st_get(st, 0) as i64);
            t_wstr(1, " consec=");
            t_wu64(1, st_get(st, 1) as i64);
            t_wstr(1, " cursor=");
            t_wu64(1, st_get(st, 2) as i64);
            t_wstr(1, " nprop=");
            t_wu64(1, st_get(st, 3) as i64);
            t_wstr(1, "\n");
            p = p + 1;
        }
        return 0;
    }

    if(is_selfcheck == 1) {
        let i:i32 = 0;
        while(i < nev) {
            let base:i32 = h_rec(hist, i);
            if((hist[base] as i32) == 1) {
                let r3:i32 = replay(hist, i, st, pt, pg, ad);
                if(r3 != 0) {
                    nio_write_all(2, "selfcheck: prefix replay failed\n");
                    return 21;
                }
                let dr:i32 = decide(hist, i, slice, v_rule, v_judg, v_plen,
                                   v_poff, v_dom, v_pat, vn, prose,
                                   st, pt, pg, ad, out, out_ax, out_gn);
                if(dr != 0) {
                    nio_write_all(2, "selfcheck: decide gave no proposal\n");
                    return 21;
                }
                let nprop2:i32 = st_get(st, 3);
                let n1:i32 = p_encode(prop, session_id, nprop2 as i64,
                                     t_iget(out, 0), t_iget(out, 1) as i64,
                                     t_iget(out, 2) as i64, out_ax,
                                     t_iget(out, 4), out_gn, t_iget(out, 5),
                                     t_iget(out, 3));
                let prop2:[]u8 = nio_alloc(256);
                let n2:i32 = rec_encode(hist, base, session_id, prop2);
                if(n1 != n2 || nio_equal(prop[0..n1], prop2[0..n2]) != 1) {
                    nio_write_all(2, "selfcheck: DIVERGENCE at event ");
                    t_wu64(2, i as i64);
                    t_wstr(2, "\n");
                    return 21;
                }
            }
            i = i + 1;
        }
        nio_write_all(2, "selfcheck: OK\n");
        return 0;
    }

    // propose mode
    let dr2:i32 = decide(hist, nev, slice, v_rule, v_judg, v_plen, v_poff,
                        v_dom, v_pat, vn, prose, st, pt, pg, ad,
                        out, out_ax, out_gn);
    if(dr2 == 20) {
        nio_write_all(2, "propose: session cap reached, no proposal\n");
        return 20;
    }
    let seq:i64 = st_get(st, 3) as i64;
    let n:i32 = p_encode(prop, session_id, seq,
                         t_iget(out, 0), t_iget(out, 1) as i64,
                         t_iget(out, 2) as i64, out_ax, t_iget(out, 4),
                         out_gn, t_iget(out, 5), t_iget(out, 3));
    if(nio_write_all(1, prop[0..n]) != (n as i64)) {
        return t_die("stdout write failed\n");
    }
    // diagnostics: E trace line
    t_wstr(2, "E=");
    t_wu64(2, st_get(st, 0) as i64);
    let band:i32 = e_band(st_get(st, 0));
    if(band == 0) { t_wstr(2, " BAND=cold"); }
    if(band == 1) { t_wstr(2, " BAND=warm"); }
    if(band == 2) { t_wstr(2, " BAND=hot"); }
    let act:i32 = t_iget(out, 6);
    if(act == 0) { t_wstr(2, " ACT=fresh"); }
    if(act == 1) { t_wstr(2, " ACT=appeal"); }
    if(act == 2) { t_wstr(2, " ACT=retract"); }
    if(act == 3) { t_wstr(2, " ACT=relational"); }
    t_wstr(2, " SEQ=");
    t_wu64(2, seq);
    t_wstr(2, " KIND=");
    t_wu64(2, t_iget(out, 0) as i64);
    t_wstr(2, " SS=");
    t_wu64(2, t_iget(out, 1) as i64);
    t_wstr(2, " SE=");
    t_wu64(2, t_iget(out, 2) as i64);
    t_wstr(2, " CONF=");
    t_wu64(2, t_iget(out, 3) as i64);
    t_wstr(2, " AC=");
    t_wu64(2, t_iget(out, 4) as i64);
    t_wstr(2, " GC=");
    t_wu64(2, t_iget(out, 5) as i64);
    t_wstr(2, "\n");
    return 0;
}

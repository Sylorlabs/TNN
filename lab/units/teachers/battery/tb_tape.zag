// tb_tape.zag — TST-1 teaching-session tape model (PREREG §4 B.4),
// the 16-word audit ledger (frozen layout), and the canonical byte
// serializer used by the leak check. Pure Zag, zero RNG.
//
// The tape is harness-owned and append-only. Event records here are an
// in-memory model of the TST-1 length-prefixed little-endian binary
// layout; tb_tape_bytes() produces the canonical byte image (what the
// leak check scans, and what a wave-2 tape reader parses).

struct TbTape {
    n:i32,
    cap:i32,
    kind:[]u8,   // event kind per slot
    fa:[]i64,    // field a per slot
    fb:[]i64,    // field b per slot
    fc:[]i64,    // field c per slot
    fd:[]i64,    // field d per slot
    pool:[]u8,   // byte pool for TEACHER_MSG proposal bytes
    pool_n:i32,
    pool_cap:i32,
    ledger:[]u8, // 16-word (128-byte) audit entries, append-only
    ledger_n:i32, // entries used
    ledger_cap:i32
}

fn tb_tape_init(t:*TbTape,cap:i32,pool_cap:i32,ledger_cap:i32)i32 {
    t.*.n=0; t.*.cap=cap;
    t.*.kind=nio_alloc(cap); if(t.*.kind.len!=cap){return -1;}
    t.*.fa=nio_alloc(cap*8); if(t.*.fa.len!=cap*8){return -1;}
    t.*.fb=nio_alloc(cap*8); if(t.*.fb.len!=cap*8){return -1;}
    t.*.fc=nio_alloc(cap*8); if(t.*.fc.len!=cap*8){return -1;}
    t.*.fd=nio_alloc(cap*8); if(t.*.fd.len!=cap*8){return -1;}
    t.*.pool=nio_alloc(pool_cap); if(t.*.pool.len!=pool_cap){return -1;}
    t.*.pool_n=0; t.*.pool_cap=pool_cap;
    t.*.ledger=nio_alloc(ledger_cap*128); if(t.*.ledger.len!=ledger_cap*128){return -1;}
    t.*.ledger_n=0; t.*.ledger_cap=ledger_cap;
    tb_zero(t.*.kind); tb_zero(t.*.fa); tb_zero(t.*.fb); tb_zero(t.*.fc); tb_zero(t.*.fd);
    tb_zero(t.*.pool); tb_zero(t.*.ledger);
    return 0;
}

// Append opaque bytes to the tape pool (fixture/harness use: e.g.
// simulating a learner-side artifact that references sealed material).
// Returns 0 on success, -1 if the pool would overflow.
fn tb_tape_pool_append(t:*TbTape,data:[]u8)i32 {
    if(t.*.pool_n+data.len>t.*.pool_cap){return -1;}
    let pool:[]u8=t.*.pool;
    let k:i32=0;
    while(k<data.len){pool[t.*.pool_n+k]=data[k];k=k+1;}
    t.*.pool_n=t.*.pool_n+data.len;
    return 0;
}

fn tb_tape_free(t:*TbTape)void {
    nio_free(t.*.kind); nio_free(t.*.fa); nio_free(t.*.fb);
    nio_free(t.*.fc); nio_free(t.*.fd); nio_free(t.*.pool); nio_free(t.*.ledger);
}

fn tb_i64_get(b:[]u8,at:i32)i64 {return tb_get64(b,at);}
fn tb_i64_set(b:[]u8,at:i32,v:i64)void {tb_put64(b,at,v);}

// Append one event; returns slot index or -1.
fn tb_tape_add(t:*TbTape,k:i32,a:i64,b:i64,c:i64,d:i64)i32 {
    let n:i32=t.*.n;
    if(n>=t.*.cap){return -1;}
    let kind:[]u8=t.*.kind; kind[n]=(k&255) as u8;
    tb_i64_set(t.*.fa,n*8,a); tb_i64_set(t.*.fb,n*8,b);
    tb_i64_set(t.*.fc,n*8,c); tb_i64_set(t.*.fd,n*8,d);
    t.*.n=n+1;
    return n;
}

// Append a TEACHER_MSG: proposal bytes are copied into the pool verbatim
// (§P verbatim per B.4 replay rule). fa=seq, fb=pool offset, fc=len, fd=tid.
fn tb_tape_teacher(t:*TbTape,prop:[]u8,total:i32)i32 {
    let n:i32=t.*.n;
    if(n>=t.*.cap){return -1;}
    let pn:i32=t.*.pool_n;
    if(pn+total>t.*.pool_cap){return -1;}
    let pool:[]u8=t.*.pool;
    let i:i32=0; while(i<total){pool[pn+i]=prop[i];i=i+1;}
    t.*.pool_n=pn+total;
    let kind:[]u8=t.*.kind; kind[n]=(TB_EV_TEACHER_MSG&255) as u8;
    tb_i64_set(t.*.fa,n*8,tb_prop_seq(prop));
    tb_i64_set(t.*.fb,n*8,pn as i64);
    tb_i64_set(t.*.fc,n*8,total as i64);
    tb_i64_set(t.*.fd,n*8,tb_prop_tid(prop));
    t.*.n=n+1;
    return n;
}

// Append a 16-word audit ledger entry (frozen layout: op@0 slot@4 rc@8
// b1..b5@12..28 a1..a5@32..48 stage@52 d1@56 d2@60). Returns entry index.
fn tb_ledger_add(t:*TbTape,op:i32,slot:i64,rc:i64,
                 b1:i64,b2:i64,b3:i64,b4:i64,b5:i64,
                 a1:i64,a2:i64,a3:i64,a4:i64,a5:i64,
                 stage:i64,d1:i64,d2:i64)i32 {
    let n:i32=t.*.ledger_n;
    if(n>=t.*.ledger_cap){return -1;}
    let lg:[]u8=t.*.ledger;
    let at:i32=n*128;
    tb_put64(lg,at+0,op as i64);
    tb_put64(lg,at+4,slot);
    tb_put64(lg,at+8,rc);
    tb_put64(lg,at+12,b1); tb_put64(lg,at+16,b2); tb_put64(lg,at+20,b3);
    tb_put64(lg,at+24,b4); tb_put64(lg,at+28,b5);
    tb_put64(lg,at+32,a1); tb_put64(lg,at+36,a2); tb_put64(lg,at+40,a3);
    tb_put64(lg,at+44,a4); tb_put64(lg,at+48,a5);
    tb_put64(lg,at+52,stage);
    tb_put64(lg,at+56,d1);
    tb_put64(lg,at+60,d2);
    // words 64..124 reserved (zeroed at init)
    t.*.ledger_n=n+1;
    return n;
}

// Raw ledger bytes (what the leak check + M8 capture hash).
fn tb_ledger_bytes(t:*TbTape,out:[]u8)i32 {
    let n:i32=t.*.ledger_n*128;
    if(out.len<n){return -1;}
    let lg:[]u8=t.*.ledger;
    let i:i32=0; while(i<n){out[i]=lg[i];i=i+1;}
    return n;
}

// Canonical tape byte image: per event, kind u8 + a,b,c,d as u64 LE
// (33 bytes); TEACHER_MSG appends the verbatim proposal bytes.
// Deterministic; this is the byte string the leak check scans.
fn tb_tape_bytes(t:*TbTape,out:[]u8)i32 {
    let n:i32=t.*.n;
    let at:i32=0;
    let i:i32=0;
    while(i<n){
        if(at+33>out.len){return -1;}
        let kind:[]u8=t.*.kind;
        out[at]=(kind[i] as i64)&255 as u8; at=at+1;
        tb_put64(out,at,tb_i64_get(t.*.fa,i*8)); at=at+8;
        tb_put64(out,at,tb_i64_get(t.*.fb,i*8)); at=at+8;
        tb_put64(out,at,tb_i64_get(t.*.fc,i*8)); at=at+8;
        tb_put64(out,at,tb_i64_get(t.*.fd,i*8)); at=at+8;
        i=i+1;
    }
    // Whole-pool dump: the leak check must see every byte the learner
    // could have scribbled, not only proposal-referenced ranges.
    let pn:i32=t.*.pool_n;
    if(at+pn>out.len){return -1;}
    let pool:[]u8=t.*.pool;
    let j:i32=0; while(j<pn){out[at+j]=pool[j];j=j+1;}
    at=at+pn;
    return at;
}

// Find the STUDENT_DECISION slot for a proposal seq; -1 if absent.
fn tb_find_decision(t:*TbTape,seq:i64)i32 {
    let i:i32=0;
    while(i<t.*.n){
        let kind:[]u8=t.*.kind;
        if((kind[i] as i32)==TB_EV_DECISION && tb_i64_get(t.*.fa,i*8)==seq){return i;}
        i=i+1;
    }
    return -1;
}

// Count TEACHER_MSG events (proposals) in tape order.
fn tb_count_proposals(t:*TbTape)i32 {
    let c:i32=0; let i:i32=0;
    while(i<t.*.n){
        let kind:[]u8=t.*.kind;
        if((kind[i] as i32)==TB_EV_TEACHER_MSG){c=c+1;}
        i=i+1;
    }
    return c;
}

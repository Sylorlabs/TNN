// score_sheet.zag — wave-2 shakedown score sheet emitter.
// Fills TbArmMeas from the pipeline's measured values and prints a
// deterministic score sheet per arm. Legs whose inputs cannot exist in this
// shakedown are reported N/A with the frozen-design reason — never
// fabricated:
//   revisability: N/A — frozen §4 B.1: arms 4/5 carry no flaw manifest.
//   integrity:    N/A — the scorer's integrity leg + kill (iii)/(iv) are
//                 scoped to the red-team ingress battery, which this
//                 shakedown excludes per task. The honest-arm §C silence
//                 check is reported separately (tripwire=silent).
//   cost:         raw §B.9 components only; the normalized leg needs the
//                 arm-1 reference on the same slice (not run here).
// Mastery/retention are measured: the learner adopted 0 words on both
// arms (no §P channel), so both probes read an empty store -> 0.
// Pure Zag, zero RNG, no wallclock. All inputs are constants verified from
// the pipeline runs (see comments); output is fully deterministic.
@import("tb_types.zag")
@import("tb_scorer.zag")

// tb_i64_get: sole tb_tape.zag symbol tb_scorer.zag needs
// (identical definition to battery/tb_tape.zag line 59).
fn tb_i64_get(b:[]u8,at:i32)i64 {return tb_get64(b,at);}
fn tb_i64_set(b:[]u8,at:i32,v:i64)void {tb_put64(b,at,v);}

fn ss_arm(arm:i32, mastery:i64, reten:i64,
          teach_events:i64, tape_bytes:i64, words:i64,
          note_teach:[]u8) void {
    _zag_print("SHAKEDOWN_SCORECARD,arm=");
    _zag_print(_zag_i64_to_str(arm as i64));
    _zag_print(",slice=demo\n");
    _zag_print("  mastery_pm=");
    _zag_print(_zag_i64_to_str(mastery));
    _zag_print("  # words_adopted=");
    _zag_print(_zag_i64_to_str(words));
    _zag_print(" (probe vacuous on empty store)\n");
    _zag_print("  revisability=N/A  # frozen B.1: no flaw manifest for arms 4/5\n");
    _zag_print("  integrity=N/A  # red-team leg excluded; tripwire=silent on honest session\n");
    _zag_print("  retention_pm=");
    _zag_print(_zag_i64_to_str(reten));
    _zag_print("  # 0 taught -> 0 retained\n");
    _zag_print("  cost_raw=ledger_entries:0,teacher_msgs:");
    _zag_print(_zag_i64_to_str(teach_events));
    _zag_print("(");
    _zag_print(note_teach);
    _zag_print("),delib_steps:0,appeals:0,defers:0,tape_bytes:");
    _zag_print(_zag_i64_to_str(tape_bytes));
    _zag_print("  # normalized leg N/A: needs arm-1 reference on same slice\n");
    _zag_print("  tripwire=silent  # no proposals -> B.8 N/A by construction; exit=0, 0 INTEGRITY events\n");
    _zag_print("  weighted_total=N/A  # 3 of 5 legs N/A; no honest single number\n");
}

fn main() i32 {
    _zag_print("SHAKEDOWN,begin,wave2-arm45\n");
    // Arm 4: 16 HINT events, 19 tape events, 538 bytes, exit 0 (measured).
    // Learner: 0 §P wires, 0 adopted, 0 deliberation steps (measured).
    ss_arm(4, 0, 0, 16, 538, 0, "HINT");
    // Arm 5: 32 ORACLE_ANSWER (+4 QUERY_REFUSED on K=32 budget), 71 events,
    // 1890 bytes, exit 0 (measured). Learner: 0 wires, 0 adopted.
    ss_arm(5, 0, 0, 32, 1890, 0, "ORACLE_ANSWER");
    _zag_print("SHAKEDOWN,end\n");
    return 0;
}

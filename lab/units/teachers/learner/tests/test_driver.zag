// tests/test_driver.zag — driver + tape record smoke test.
//
// Builds §P wires with p_encode, runs them through drv_consider_wire,
// and checks the emitted DELIB/DECISION tape records.

@import("../driver.zag")

fn main() i32 {
    let s:[]u8 = "the cat sat on the mat. the cat ran."
    let text:[]u8 = nio_alloc(64)
    let i:i64 = 0
    while (i < s.len) { text[i] = s[i]; i = i + 1 }
    let d:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let t:*Tape = tape_new()

    // Proposal 1: "the cat" [0,7), grounded at both occurrences.
    let gs:[]i64 = nio_alloc(16) as []i64
    let ge:[]i64 = nio_alloc(16) as []i64
    gs[0] = 0; ge[0] = 7; gs[1] = 24; ge[1] = 31
    let gr:[]u8 = nio_alloc(32)
    p_pack(gr, 2, gs, ge)
    let aux:[]u8 = nio_alloc(1)[0..0]
    let w1:[]u8 = p_encode(1, 1, 100, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    let rc:i64 = drv_consider_wire(d, t, w1)
    _zag_print("p1 rc="); _zag_print(_zag_i64_to_str(rc)); _zag_print("\n")
    _zag_print("p1 verdict="); _zag_print(_zag_i64_to_str(d[0].dec_verdict)); _zag_print("\n")
    _zag_print("p1 steps="); _zag_print(_zag_i64_to_str(dlb_steps_n(d))); _zag_print("\n")

    // Proposal 2: unknown span [1,2) "h", no grounds -> low score -> DEFER.
    let gr2:[]u8 = nio_alloc(1)[0..0]
    let w2:[]u8 = p_encode(1, 1, 101, P_K_WORD_SPAN, 1, 2, 100, aux, gr2)
    rc = drv_consider_wire(d, t, w2)
    _zag_print("p2 rc="); _zag_print(_zag_i64_to_str(rc)); _zag_print("\n")
    _zag_print("p2 verdict="); _zag_print(_zag_i64_to_str(d[0].dec_verdict)); _zag_print("\n")

    // Tape summary.
    _zag_print("tape len="); _zag_print(_zag_i64_to_str(t[0].len)); _zag_print("\n")
    _zag_print("tape seq="); _zag_print(_zag_i64_to_str(t[0].seq)); _zag_print("\n")

    // Verify first record framing: u32 len, u16 type=5 (EV_DELIB), u64 tick=0.
    let buf:[]u8 = t[0].buf
    let rl:i64 = p_get32(buf, 0)
    let rt:i64 = p_get16(buf, 4)
    let rk:i64 = p_get64(buf, 6)
    _zag_print("rec0 len="); _zag_print(_zag_i64_to_str(rl))
    _zag_print(" type="); _zag_print(_zag_i64_to_str(rt))
    _zag_print(" tick="); _zag_print(_zag_i64_to_str(rk)); _zag_print("\n")
    // DELIB body: u64 hyp, u8 kind, u8 ev_n, evs.., u64 pre.
    let dh:i64 = p_get64(buf, 14)
    let dk:i64 = buf[22] as i64
    let dn:i64 = buf[23] as i64
    _zag_print("delib hyp="); _zag_print(_zag_i64_to_str(dh))
    _zag_print(" kind="); _zag_print(_zag_i64_to_str(dk))
    _zag_print(" ev_n="); _zag_print(_zag_i64_to_str(dn)); _zag_print("\n")

    // Walk every record: all types must be the harness EV codes
    // (5=DELIB, 6=DECISION); bodies must match the frozen layouts:
    // DELIB body = 18 + ev_n*8, DECISION body = 43.
    let pos:i64 = 0
    let bad:i64 = 0
    let ndelib:i64 = 0
    let ndec:i64 = 0
    while (pos + 14 <= t[0].len) {
        let l:i64 = p_get32(buf, pos)
        let ty:i64 = p_get16(buf, pos + 4)
        if (l < 10 || pos + 4 + l > t[0].len) { bad = bad + 1; break }
        let bl:i64 = l - 10
        if (ty == 5) {
            ndelib = ndelib + 1
            let en:i64 = buf[pos + 14 + 9] as i64
            if (bl != 18 + en * 8) { bad = bad + 1 }
        } else if (ty == 6) {
            ndec = ndec + 1
            if (bl != 43) { bad = bad + 1 }
            let v:i64 = buf[pos + 14 + 8] as i64
            if (v < 1 || v > 4) { bad = bad + 1 }
        } else {
            bad = bad + 1
        }
        pos = pos + 4 + l
    }
    if (pos != t[0].len) { bad = bad + 1 }
    _zag_print("walk ndelib="); _zag_print(_zag_i64_to_str(ndelib))
    _zag_print(" ndec="); _zag_print(_zag_i64_to_str(ndec))
    _zag_print(" bad="); _zag_print(_zag_i64_to_str(bad)); _zag_print("\n")

    tape_free(t)
    if (rt != 5 || rk != 0 || bad != 0 || ndec == 0) { return 1 }
    return 0
}

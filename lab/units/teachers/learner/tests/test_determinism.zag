// tests/test_determinism.zag — N=5 byte-identical rerun test.
//
// Runs the same proposal sequence 5 times through fresh DLBs and checks
// that every tape byte is identical across runs. This is the determinism
// bar: no RNG, no wallclock, same input + same code = same bytes.

@import("../driver.zag")

fn run_once(out:[]u8) i64 {
    let s:[]u8 = "the cat sat on the mat. the cat ran."
    let text:[]u8 = nio_alloc(64)
    let i:i64 = 0
    while (i < s.len) { text[i] = s[i]; i = i + 1 }
    let d:*DLB = dlb_new(text[0..s.len], s.len, 5, 3, 256, 2, 2)
    let t:*Tape = tape_new()
    let gs:[]i64 = nio_alloc(16) as []i64
    let ge:[]i64 = nio_alloc(16) as []i64
    gs[0] = 0; ge[0] = 7; gs[1] = 24; ge[1] = 31
    let gr:[]u8 = nio_alloc(32)
    p_pack(gr, 2, gs, ge)
    let aux:[]u8 = nio_alloc(1)[0..0]
    let w1:[]u8 = p_encode(1, 1, 100, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    let w2:[]u8 = p_encode(1, 1, 101, P_K_WORD_SPAN, 1, 2, 100, aux, nio_alloc(1)[0..0])
    let w3:[]u8 = p_encode(1, 1, 102, P_K_BOUNDARY, 8, 11, 200, aux, gr)
    drv_consider_wire(d, t, w1)
    drv_consider_wire(d, t, w2)
    drv_consider_wire(d, t, w3)
    let n:i64 = t[0].len
    let j:i64 = 0
    while (j < n) { out[j] = t[0].buf[j]; j = j + 1 }
    tape_free(t)
    return n
}

fn main() i32 {
    let b0:[]u8 = nio_alloc(65536)
    let b1:[]u8 = nio_alloc(65536)
    let n0:i64 = run_once(b0)
    _zag_print("run0 len="); _zag_print(_zag_i64_to_str(n0)); _zag_print("\n")
    let run:i64 = 1
    let bad:i64 = 0
    while (run < 5) {
        let n:i64 = run_once(b1)
        if (n != n0) {
            _zag_print("run "); _zag_print(_zag_i64_to_str(run))
            _zag_print(" LENGTH MISMATCH\n")
            bad = 1
        } else {
            let j:i64 = 0
            while (j < n) {
                if (b0[j] != b1[j]) {
                    _zag_print("run "); _zag_print(_zag_i64_to_str(run))
                    _zag_print(" BYTE MISMATCH at ")
                    _zag_print(_zag_i64_to_str(j)); _zag_print("\n")
                    bad = 1
                    j = n
                }
                j = j + 1
            }
        }
        _zag_print("run "); _zag_print(_zag_i64_to_str(run))
        if (bad == 0) { _zag_print(" identical\n") }
        run = run + 1
    }
    if (bad == 0) { _zag_print("DETERMINISM PASS: 5/5 byte-identical\n") }
    return bad
}

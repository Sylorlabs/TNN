// char_prose.zag — EXPLORATORY corpus characterizer for the TNN representation program.
// NOT EVIDENCE. Nothing this program outputs counts as program evidence.
// Pure Zag, zero randomness, fully deterministic: same bytes in -> same numbers out.
// Usage: ./char_prose <path-to-corpus-file>
// Emits KEY,value lines on stdout.
// Stats: byte histogram classes, line-length stats, top-16 bytes,
//        deterministic 8-byte-window repetition estimate (stride 16,
//        FNV-style multiply-add hash into a 65536-slot open-address table).

fn z_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn z_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
}

fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}

fn le_get64(b:[]u8,at:i32)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<8){
        v=v|((b[at+i] as i64)<<(i*8));
        i=i+1;
    }
    return v;
}

fn le_set64(b:[]u8,at:i32,v:i64)void {
    let i:i32=0;
    while(i<8){
        b[at+i]=((v>>(i*8)) as u8);
        i=i+1;
    }
}

fn le_add64(b:[]u8,at:i32,delta:i64)void {
    le_set64(b,at,le_get64(b,at)+delta);
}

fn emit(k:[]u8,v:i64)void {
    _zag_print(k);
    _zag_print(",");
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_println("");
    z_free(s);
}

// Minimal regular-file reader via Linux x86-64 raw syscalls.
// open=2(O_RDONLY=0), fstat=5 (st_size u64 at offset 48), read=0, close=3.
fn read_file(path:[]u8)[]u8 {
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return "";}
    let cs_ptr:i64=_zag_slice_ptr(cs) as i64;
    let fd:i64=_zag_raw_syscall(2,cs_ptr,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let st:[]u8=z_alloc(144);
    if(st.len==0){
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        return "";
    }
    let st_ptr:i64=_zag_slice_ptr(st) as i64;
    let r:i64=_zag_raw_syscall(5,fd,st_ptr,0,0,0,0);
    if(r!=0){
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        z_free(st);
        return "";
    }
    let size:i64=le_get64(st,48);
    z_free(st);
    if(size<0 || size>67108864){
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        return "";
    }
    let n:i32=size as i32;
    let buf:[]u8=z_alloc(n+1);
    if(buf.len==0){
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        return "";
    }
    let got:i32=0;
    while(got<n){
        let rptr:i64=(_zag_slice_ptr(buf) as i64)+(got as i64);
        let rlen:i64=(n-got) as i64;
        let rr:i64=_zag_raw_syscall(0,fd,rptr,rlen,0,0,0);
        if(rr<=0){break;}
        got=got+(rr as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..got];
}

fn main()i32 {
    if(_zag_argc()!=2){
        _zag_println("usage: char_prose <file>");
        return 64;
    }
    let path:[]u8=_zag_arg(1);
    let buf:[]u8=read_file(path);
    let n:i32=buf.len;
    emit("BYTES",n as i64);
    if(n==0){
        _zag_println("EMPTY_OR_UNREADABLE");
        return 1;
    }

    // ---- Pass 1: histogram, line stats, byte classes ----
    let hist:[]u8=z_alloc(256*8);
    let lines:i64=0;
    let lsum:i64=0;
    let lmax:i64=0;
    let cur:i64=0;
    let crlf:i64=0;
    let c_nul:i64=0;
    let c_ws:i64=0;
    let c_ctrl:i64=0;
    let c_print:i64=0;
    let c_high:i64=0;
    let c_c1:i64=0;
    let i:i32=0;
    while(i<n){
        let bv:i32=buf[i] as i32;
        le_add64(hist,bv*8,1);
        if(bv==0){c_nul=c_nul+1;}
        if(bv==9 || bv==10 || bv==13 || bv==32){c_ws=c_ws+1;}
        if(bv==10){
            lines=lines+1;
            lsum=lsum+cur;
            if(cur>lmax){lmax=cur;}
            cur=0;
            if(i>0 && (buf[i-1] as i32)==13){crlf=crlf+1;}
        } else {
            cur=cur+1;
        }
        if(bv>=1 && bv<=8){c_ctrl=c_ctrl+1;}
        if(bv==11 || bv==12){c_ctrl=c_ctrl+1;}
        if(bv>=14 && bv<=31){c_ctrl=c_ctrl+1;}
        if(bv==127){c_ctrl=c_ctrl+1;}
        if(bv>=33 && bv<=126){c_print=c_print+1;}
        if(bv>=128){c_high=c_high+1;}
        if(bv>=128 && bv<=159){c_c1=c_c1+1;}
        i=i+1;
    }
    if((buf[n-1] as i32)!=10){
        lines=lines+1;
        lsum=lsum+cur;
        if(cur>lmax){lmax=cur;}
    }
    emit("LINES",lines);
    if(lines>0){emit("MEAN_LINE_LEN",lsum/lines);} else {emit("MEAN_LINE_LEN",0);}
    emit("MAX_LINE_LEN",lmax);
    emit("CRLF_LINES",crlf);
    emit("CLASS_NUL",c_nul);
    emit("CLASS_WS",c_ws);
    emit("CLASS_CTRL",c_ctrl);
    emit("CLASS_PRINT",c_print);
    emit("CLASS_HIGH",c_high);
    emit("CLASS_C1_80_9F",c_c1);
    emit("WS_PERMILLE",c_ws*1000/(n as i64));
    emit("HIGH_PERMILLE",c_high*1000/(n as i64));
    let bom:i64=0;
    if(n>=3 && (buf[0] as i32)==239 && (buf[1] as i32)==187 && (buf[2] as i32)==191){bom=1;}
    emit("UTF8_BOM",bom);

    // ---- Top 16 bytes by count (deterministic: count desc, byte asc) ----
    let tb:[]u8=z_alloc(16*8);
    let tc:[]u8=z_alloc(16*8);
    let f:i32=0;
    let b2:i32=0;
    while(b2<256){
        let c:i64=le_get64(hist,b2*8);
        let p:i32=0;
        while(p<f){
            let pc:i64=le_get64(tc,p*8);
            let pb:i64=le_get64(tb,p*8);
            if(c>pc || (c==pc && (b2 as i64)<pb)){break;}
            p=p+1;
        }
        if(p<16){
            let q:i32=15;
            if(f<16){f=f+1;}
            while(q>p){
                le_set64(tc,q*8,le_get64(tc,(q-1)*8));
                le_set64(tb,q*8,le_get64(tb,(q-1)*8));
                q=q-1;
            }
            le_set64(tc,p*8,c);
            le_set64(tb,p*8,b2 as i64);
        }
        b2=b2+1;
    }
    let t:i32=0;
    while(t<f){
        _zag_print("TOPB,");
        let sb:[]u8=_zag_i64_to_str(le_get64(tb,t*8));
        _zag_print(sb);
        _zag_print(",");
        let sc:[]u8=_zag_i64_to_str(le_get64(tc,t*8));
        _zag_print(sc);
        _zag_println("");
        z_free(sb);
        z_free(sc);
        t=t+1;
    }
    z_free(tb);
    z_free(tc);
    z_free(hist);

    // ---- Repetition: 8-byte windows, stride 16, 65536-slot table ----
    let th:[]u8=z_alloc(65536*8);
    let tcnt:[]u8=z_alloc(65536*8);
    let toff:[]u8=z_alloc(65536*8);
    if(th.len==0 || tcnt.len==0 || toff.len==0){
        _zag_println("REP_TABLE_ALLOC_FAIL");
        return 2;
    }
    let samples:i64=0;
    let off:i32=0;
    while(off+8<=n){
        let h:i64=-3750763034362895579;
        let j:i32=0;
        while(j<8){
            h=h*1099511628211+(buf[off+j] as i64);
            j=j+1;
        }
        let slot:i64=h%65536;
        if(slot<0){slot=slot+65536;}
        let probe:i32=0;
        while(probe<256){
            let s:i32=((slot+(probe as i64))%65536) as i32;
            let sc0:i64=le_get64(tcnt,s*8);
            if(sc0==0){
                le_set64(th,s*8,h);
                le_set64(tcnt,s*8,1);
                le_set64(toff,s*8,off as i64);
                break;
            }
            if(le_get64(th,s*8)==h){
                let so:i32=le_get64(toff,s*8) as i32;
                let eq:i32=1;
                let k:i32=0;
                while(k<8){
                    if(buf[so+k]!=buf[off+k]){eq=0;}
                    k=k+1;
                }
                if(eq==1){
                    le_add64(tcnt,s*8,1);
                    break;
                }
            }
            probe=probe+1;
        }
        samples=samples+1;
        off=off+16;
    }
    let distinct:i64=0;
    let rep_slots:i64=0;
    let extra:i64=0;
    let s2:i32=0;
    while(s2<65536){
        let c:i64=le_get64(tcnt,s2*8);
        if(c>0){
            distinct=distinct+1;
            if(c>=2){
                rep_slots=rep_slots+1;
                extra=extra+(c-1);
            }
        }
        s2=s2+1;
    }
    emit("REP_SAMPLES",samples);
    emit("REP_DISTINCT",distinct);
    emit("REP_SLOTS_GE2",rep_slots);
    emit("REP_EXTRA_WINDOWS",extra);
    if(samples>0){emit("REP_EXTRA_PERMILLE",extra*1000/samples);} else {emit("REP_EXTRA_PERMILLE",0);}
    z_free(th);
    z_free(tcnt);
    z_free(toff);
    z_free(buf);
    _zag_println("CHAR_DONE");
    return 0;
}

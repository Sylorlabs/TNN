// dyn_b5.zag — B-T5 split/merge dynamics battery, R0 redo (prereg §2 FROZEN).
// Crew B-DYNSG. Track R0, Micah signed 2026-09-21. R-9: 1x ONLY.
// One binary: argv[1] = leg (0 recovered / 1 re-derived), argv[2] = perturb 0..4.
// Recovered firing conditions (R-8, r0_init):
//   split iff use_count>=3 AND conflict>=learned_conflict AND utility<=learned_utility_floor
//   merge iff pair_seen>=learned_pair_seen AND joint_gain-separate_regret>=learned_gain
// Bar (§2 R0.2 B-T5): split+merge FIRE under recovered conditions, are
// ledger-auditable, and boundaries are shown mutable (a recruited chunk split
// then re-merged on the record). K-R3: no ghost IDs, tombstone/live < 2.
// Pure Zag. Zero RNG in AI decision paths. Byte-identical reruns (M8).
// Build: znc dyn_b5.zag -o /tmp/dyn_b5 --no-zagd --no-analyze --no-foreground-cache
@import("../core/r0_core.zag")
@import("../core/r0_probe.zag")
@import("../harness/m8_armor.zag")

const B5_LEDGER_BASE:i32=91168;
const B5_LEDGER_STRIDE:i32=64;
const B5_BANK_BASE:i32=69664;
const B5_BANK_WORDS:i32=19456; // 1024 slots * 19 words
const B5_HDR_WORDS:i32=32;
const B5_LRN_GAIN_W:i32=7;     // R0H_LRN_GAIN (documented 32-word header layout)

fn b5_out(s:[]u8)void { _zag_print(s); }
fn b5_num(v:i32)void { _zag_print(_zag_i64_to_str(v as i64)); }
fn b5_kv(k:[]u8,v:i32)void { b5_out(k); b5_num(v); b5_out("\n"); }
fn b5_expect(f:*i32, cond:i32)void { if(cond==0){ f.*=f.*+1; } }

// Adversarial allocation perturbations (mirror of r0_smoke's r0_perturb;
// heap-state only — the core never reads allocator state, so all modes must
// produce byte-identical battery output).
fn b5_perturb(mode:i32)void {
    if(mode==1){
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(128);
        let a2:[]i32=zalloc_i(32); let a3:[]i32=zalloc_i(256);
        let a4:[]i32=zalloc_i(48); let a5:[]i32=zalloc_i(96);
        let a6:[]i32=zalloc_i(160); let a7:[]i32=zalloc_i(24);
        a0[0]=1; a3[0]=2; a6[0]=3;
        zfree_i(a1); zfree_i(a4); zfree_i(a6);
        let b0:[]i32=zalloc_i(200); let b1:[]i32=zalloc_i(40);
        b0[0]=4; b1[0]=5;
        zfree_i(a0); zfree_i(b0);
        zfree_i(a2); zfree_i(a3); zfree_i(a5); zfree_i(a7); zfree_i(b1);
    } else if(mode==2){
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(64);
        let a2:[]i32=zalloc_i(64); let a3:[]i32=zalloc_i(64);
        let a4:[]i32=zalloc_i(64); let a5:[]i32=zalloc_i(64);
        a0[0]=1; a1[0]=2; a2[0]=3; a3[0]=4; a4[0]=5; a5[0]=6;
        zfree_i(a5); zfree_i(a4); zfree_i(a3);
        zfree_i(a2); zfree_i(a1); zfree_i(a0);
    } else if(mode==3){
        let big:[]i32=zalloc_i(65536);
        let i:i32=0;
        while(i<65536){ big[i]=i & 255; i=i+1024; }
        zfree_i(big);
        let s1:[]i32=zalloc_i(13); s1[0]=7; zfree_i(s1);
    }
}
fn b5_churn()void {
    let a0:[]i32=zalloc_i(512); let a1:[]i32=zalloc_i(17);
    a0[0]=9; a1[0]=8;
    zfree_i(a0);
    let b0:[]i32=zalloc_i(300); b0[0]=7;
    zfree_i(a1); zfree_i(b0);
    let c0:[]i32=zalloc_i(1024); c0[0]=6; zfree_i(c0);
}

fn b5_fill(seq:[]i32, lit:[]u8)void {
    let i:i32=0; while(i<lit.len){ seq[i]=lit[i] as i32; i=i+1; }
}
fn b5_fill_rep(seq:[]i32, lit:[]u8, reps:i32)void {
    let w:i32=0; let r:i32=0;
    while(r<reps){
        let i:i32=0;
        while(i<lit.len){ seq[w]=lit[i] as i32; w=w+1; i=i+1; }
        r=r+1;
    }
}
// Observe one span `times` times, cycling through labels[0..nlab).
fn b5_observe_span_n(st:[]i32, seq:[]i32, n:i32, labels:[]i32, nlab:i32, times:i32)void {
    let t:i32=0;
    while(t<times){ r0_observe_span(st,seq,0,n,labels[t % nlab],-1); t=t+1; }
}
// Drive a chunk's utility to/below the learned floor (0, both legs) via
// delayed regret. Bounded loop; deterministic.
fn b5_drive_utility_down(st:[]i32, id:i32)void {
    let guard:i32=0;
    while(r0_chunk_utility(st,id)>0 && guard<40){
        r0_regret_update(st,id,0,0,2000);
        guard=guard+1;
    }
}
// Find a LIVE chunk whose bytes equal lit; -1 if none.
fn b5_find_live(st:[]i32, lit:[]u8)i32 {
    let count:i32=r0_chunk_count(st);
    let id:i32=0;
    while(id<count){
        if(r0_chunk_state(st,id)==1 && r0_chunk_len(st,id)==lit.len){
            let tmp:[]i32=zalloc_i(8);
            let got:i32=r0_chunk_bytes(st,id,tmp,8);
            let same:i32=1;
            if(got!=lit.len){ same=0; } else {
                let i:i32=0;
                while(i<got){
                    if(tmp[i]!=(lit[i] as i32)){ same=0; i=got; } else { i=i+1; }
                }
            }
            zfree_i(tmp);
            if(same==1){ return id; }
        }
        id=id+1;
    }
    return -1;
}
// Raw ledger word read (16-word entries, stride 64 — the task's word map:
// op@0, slot@4, rc@8, b1..b5@12..28, a1..a5@32..48, stage@52, d1@56, d2@60).
fn b5_ledger_word(st:[]i32, e:i32, w:i32)i32 {
    return st[B5_LEDGER_BASE + e*B5_LEDGER_STRIDE + w];
}
// CSV dump of the dynamics-relevant ledger entries (PROPOSE/COMMIT/SPLIT/
// MERGE/THRESH) + per-op counts.
fn b5_dump_ledger(st:[]i32)void {
    let n:i32=r0_ledger_count(st);
    let e:i32=0;
    let cs:i32=0; let cm:i32=0; let cp:i32=0; let cc:i32=0; let ct:i32=0;
    while(e<n){
        let op:i32=b5_ledger_word(st,e,0);
        if(op==192 || op==193 || op==196 || op==197 || op==204){
            b5_out("B5LED,"); b5_num(e); b5_out(",");
            b5_num(op); b5_out(","); b5_num(b5_ledger_word(st,e,4)); b5_out(",");
            b5_num(b5_ledger_word(st,e,8)); b5_out(",");
            b5_num(b5_ledger_word(st,e,12)); b5_out(","); b5_num(b5_ledger_word(st,e,16)); b5_out(",");
            b5_num(b5_ledger_word(st,e,20)); b5_out(","); b5_num(b5_ledger_word(st,e,24)); b5_out(",");
            b5_num(b5_ledger_word(st,e,28)); b5_out(",");
            b5_num(b5_ledger_word(st,e,52)); b5_out(",");
            b5_num(b5_ledger_word(st,e,56)); b5_out(","); b5_num(b5_ledger_word(st,e,60));
            b5_out("\n");
        }
        if(op==196){cs=cs+1;}
        if(op==197){cm=cm+1;}
        if(op==192){cp=cp+1;}
        if(op==193){cc=cc+1;}
        if(op==204){ct=ct+1;}
        e=e+1;
    }
    b5_kv("B5_LEDGER_N,",n);
    b5_kv("B5_N_SPLIT,",cs); b5_kv("B5_N_MERGE,",cm);
    b5_kv("B5_N_PROPOSE,",cp); b5_kv("B5_N_COMMIT,",cc); b5_kv("B5_N_THRESH,",ct);
}
// SHA-256 hex over arena header + bank region (M8 store image).
// NOTE (ZNC-2026-09-21-002): `slice as *u8` does NOT yield a data pointer in
// this znc build (reads return heap garbage / fault past the header), so the
// image is built by decomposing words -> bytes with plain slice reads.
fn b5_store_hex(st:[]i32)[]u8 {
    let nw:i32=B5_HDR_WORDS+B5_BANK_WORDS;
    let buf:[]u8=nio_alloc(nw*4);
    let w:i32=0;
    while(w<nw){
        let word:i32=st[w];
        buf[w*4]=(word & 255) as u8;
        buf[w*4+1]=((word>>8) & 255) as u8;
        buf[w*4+2]=((word>>16) & 255) as u8;
        buf[w*4+3]=((word>>24) & 255) as u8;
        w=w+1;
    }
    let h:[]u8=hc_sha256_hex(buf);
    nio_free(buf);
    return h;
}

// ---- Arena B: audited split, then audited merge (harness order) ----
// Harness op order: ingest A, ingest B (conflict ctx), split check,
// recall probe, ingest C (pair ctx), merge check, recall probe.
// The merge runs on freshly recruited pair context (units C), NOT on the
// split's halves: see FINDING B5-F1 (Arena E) for why the same-material
// re-merge is unachievable against the frozen core.
fn b5_scenario(st:[]i32, leg:i32, fails:*i32)void {
    // Ingest A: recruit the 8-span "splitchk" with divergent grounded labels
    // {3,3,0,1,2,3} -> purity 500 (both legs), conflict 500.
    let s1:[]i32=zalloc_i(8);
    b5_fill(s1,"splitchk");
    let labs:[]i32=zalloc_i(6);
    labs[0]=3; labs[1]=3; labs[2]=0; labs[3]=1; labs[4]=2; labs[5]=3;
    b5_observe_span_n(st,s1,8,labs,6,6);
    let idx:[]i32=zalloc_i(4096);
    let promoted:i32=r0_promote(st,idx);
    b5_kv("B5_PROMOTED_A,",promoted);
    b5_expect(fails,promoted==1);
    let parent:i32=r0_chunk_count(st)-1;
    b5_kv("B5_PARENT_ID,",parent);
    b5_expect(fails,parent==0);
    let conf:i32=r0_chunk_conflict1000(st,parent);
    b5_kv("B5_PARENT_CONFLICT,",conf);
    b5_expect(fails,conf==500);
    // Ingest C (pair context): two fresh 4-byte live chunks. Promoted BEFORE
    // the split so the "splitchk" proposal is correctly deduped; promoting
    // after a split re-issues the original span (documented in Arena E).
    let ha:[]i32=zalloc_i(4); b5_fill(ha,"AAAA");
    let hb:[]i32=zalloc_i(4); b5_fill(hb,"BBBB");
    let lab3:[]i32=zalloc_i(1); lab3[0]=3;
    b5_observe_span_n(st,ha,4,lab3,1,6);
    b5_observe_span_n(st,hb,4,lab3,1,6);
    let promoted2:i32=r0_promote(st,idx);
    b5_kv("B5_PROMOTED_C,",promoted2);
    b5_expect(fails,promoted2==2);
    let left:i32=b5_find_live(st,"AAAA");
    let right:i32=b5_find_live(st,"BBBB");
    b5_kv("B5_LEFT_ID,",left); b5_kv("B5_RIGHT_ID,",right);
    b5_expect(fails,left==1); b5_expect(fails,right==2);
    // NEGCTRL 1: split must NOT fire while utility is above the floor
    let early:i32=r0_maybe_split(st,parent);
    b5_kv("B5_NEGCTRL_SPLIT_EARLY,",early);
    b5_expect(fails,early==-1);
    // Ingest B (conflict context): use_count >= 3 via greedy segmentation
    let use3:[]i32=zalloc_i(24);
    b5_fill_rep(use3,"splitchk",3);
    let uid:[]i32=zalloc_i(24); let ust:[]i32=zalloc_i(24); let uln:[]i32=zalloc_i(24);
    r0_segment(st,use3,24,uid,ust,uln,24);
    let use:i32=r0_chunk_use(st,parent);
    b5_kv("B5_PARENT_USE,",use);
    b5_expect(fails,use==3);
    let util0:i32=r0_chunk_utility(st,parent);
    b5_kv("B5_PARENT_UTIL_BEFORE,",util0);
    b5_expect(fails,util0>0);
    b5_drive_utility_down(st,parent);
    let util1:i32=r0_chunk_utility(st,parent);
    b5_kv("B5_PARENT_UTIL_AFTER,",util1);
    b5_expect(fails,util1<=0);
    // SPLIT CHECK: fires under the recovered conditions
    // (use>=3, conflict>=learned bar, utility<=learned floor).
    let child:i32=r0_maybe_split(st,parent);
    b5_kv("B5_SPLIT_CHILD,",child);
    b5_expect(fails,child==3);
    b5_kv("B5_PARENT_STATE,",r0_chunk_state(st,parent));   // 2 = tombstoned
    b5_expect(fails,r0_chunk_state(st,parent)==2);
    b5_kv("B5_PARENT_SUCC,",r0_chunk_succ(st,parent));     // successor = child
    b5_expect(fails,r0_chunk_succ(st,parent)==child);
    b5_kv("B5_CHILD_STATE,",r0_chunk_state(st,child));    // 1 = live
    b5_expect(fails,r0_chunk_state(st,child)==1);
    b5_kv("B5_PARENT_LEN,",r0_chunk_len(st,parent));      // 4 ("spli")
    b5_kv("B5_CHILD_LEN,",r0_chunk_len(st,child));        // 4 ("tchk")
    b5_expect(fails,r0_chunk_len(st,parent)==4);
    b5_expect(fails,r0_chunk_len(st,child)==4);
    b5_expect(fails,b5_find_live(st,"tchk")==child);
    // The tombstoned parent's record now spans the 4-byte prefix (audited on
    // the SPLIT entry as b3=split_at, b4=old length); the 8 physical bytes are
    // retained in the record. This is the frozen core's documented semantic.
    let pb:[]i32=zalloc_i(8);
    let pln:i32=r0_chunk_bytes(st,parent,pb,8);
    b5_kv("B5_PARENT_SPAN_NOW,",pln);
    b5_expect(fails,pln==4);
    // RECALL PROBE 1: the old 8-boundary no longer segments as one chunk —
    // boundaries are mutable on the record.
    let rq:[]i32=zalloc_i(8);
    let rid:[]i32=zalloc_i(8); let rst:[]i32=zalloc_i(8); let rln:[]i32=zalloc_i(8);
    b5_fill(rq,"splitchk");
    let nout:i32=r0_segment(st,rq,8,rid,rst,rln,8);
    b5_kv("B5_RECALL1_NOUT,",nout);
    b5_expect(fails,nout==5);                 // 4 literals + live suffix child
    b5_expect(fails,rid[4]==child);
    b5_expect(fails,rln[4]==4);
    b5_expect(fails,rid[0]<0);                // "spli" prefix is literal now
    // NEGCTRL 2: merge must NOT fire below the pair-seen bar
    let mearly:i32=r0_maybe_merge(st,left,right);
    b5_kv("B5_NEGCTRL_MERGE_EARLY,",mearly);
    b5_expect(fails,mearly==-1);
    let ps:i32=0;
    while(ps<6){ r0_observe_pair(st,left,right); ps=ps+1; }
    b5_kv("B5_PAIR_SEEN,",r0_pair_seen(st,left,right));
    b5_expect(fails,r0_pair_seen(st,left,right)==6);
    // MERGE CHECK: fires under the recovered conditions.
    // leg0: 6>=3 and min((7*6-11)*20,1000)-0=620>=0.
    // leg1: 6>=4 and min(620,500)-0=500>=500.
    let merged:i32=r0_maybe_merge(st,left,right);
    b5_kv("B5_MERGED_ID,",merged);
    b5_expect(fails,merged==4);
    b5_expect(fails,r0_chunk_state(st,left)==2);
    b5_expect(fails,r0_chunk_state(st,right)==2);
    b5_kv("B5_MERGE_SUCC_L,",r0_chunk_succ(st,left));
    b5_kv("B5_MERGE_SUCC_R,",r0_chunk_succ(st,right));
    b5_expect(fails,r0_chunk_succ(st,left)==merged);
    b5_expect(fails,r0_chunk_succ(st,right)==merged);
    // RECALL PROBE 2: the merged boundary is byte-exact.
    let mb:[]i32=zalloc_i(8);
    let mln:i32=r0_chunk_bytes(st,merged,mb,8);
    b5_kv("B5_MERGED_LEN,",mln);
    b5_expect(fails,mln==8);
    let same:i32=1;
    let q:i32=0; let want:[]u8="AAAABBBB";
    while(q<8){ if(mb[q]!=(want[q] as i32)){same=0;q=8;} else {q=q+1;} }
    b5_kv("B5_MERGED_BYTES_OK,",same);
    b5_expect(fails,same==1);
    // K-R3: tombstone/live ratio < 2 (ratio1000 < 2000)
    b5_kv("B5_TOMBRATIO,",r0_tombstone_ratio1000(st));
    b5_expect(fails,r0_tombstone_ratio1000(st)<2000);
    // K-R3: tombstoned IDs are never reissued live — issuance is monotonic.
    // Note: this promote also re-issues the "splitchk" span as a NEW live id
    // (B5-F1: the split orphaned the 8-span from the bank). Even so, no
    // tombstoned id is reused: the re-issued bytes get fresh ids.
    let nbefore:i32=r0_chunk_count(st);
    let nn:[]i32=zalloc_i(8); b5_fill(nn,"newness!");
    b5_observe_span_n(st,nn,8,lab3,1,6);
    let p3:i32=r0_promote(st,idx);
    b5_kv("B5_PROMOTED_NEW,",p3);
    b5_expect(fails,p3==2);   // "newness!" (util 13055 first) + "splitchk" re-issue
    let newid:i32=b5_find_live(st,"newness!");
    let dupid:i32=b5_find_live(st,"splitchk");
    b5_kv("B5_NEW_ID,",newid); b5_kv("B5_DUP_ID,",dupid);
    b5_kv("B5_N_BEFORE,",nbefore);
    b5_expect(fails,newid==nbefore);
    b5_expect(fails,dupid==nbefore+1);
    b5_expect(fails,r0_chunk_state(st,newid)==1);
    b5_expect(fails,r0_chunk_state(st,dupid)==1);
    b5_expect(fails,r0_chunk_state(st,parent)==2);
    b5_expect(fails,r0_chunk_state(st,left)==2);
    b5_expect(fails,r0_chunk_state(st,right)==2);
    zfree_i(s1); zfree_i(labs); zfree_i(idx); zfree_i(use3);
    zfree_i(uid); zfree_i(ust); zfree_i(uln); zfree_i(pb);
    zfree_i(ha); zfree_i(hb); zfree_i(lab3); zfree_i(mb); zfree_i(nn);
    zfree_i(rq); zfree_i(rid); zfree_i(rst); zfree_i(rln);
}

// ---- Arena E: FINDING B5-F1 — post-split re-promotion semantics ----
// After a split, the tombstoned parent's record spans the prefix, so:
//   (a) re-observing the ORIGINAL 8-span re-promotes it as a NEW live chunk
//       (the bank no longer holds any 8-span with those bytes), while
//   (b) the 4-byte prefix can NEVER be recruited live again (promote's
//       bank_has_span matches the tombstoned prefix record and skips it).
// Consequence: a same-material split-then-re-merge (4+4 -> 8) is unachievable
// against the frozen core — the merge half of B-T5 must run on fresh pair
// context (as the harness's op order already structures it). This is
// documented observed behavior, asserted as expected values, NOT a fail.
fn b5_repromote_finding(leg:i32, fails:*i32)void {
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    let s1:[]i32=zalloc_i(8); b5_fill(s1,"splitchk");
    let labs:[]i32=zalloc_i(6);
    labs[0]=3; labs[1]=3; labs[2]=0; labs[3]=1; labs[4]=2; labs[5]=3;
    let idx:[]i32=zalloc_i(4096);
    b5_observe_span_n(st,s1,8,labs,6,6);
    b5_expect(fails,r0_promote(st,idx)==1);
    let use3:[]i32=zalloc_i(24); b5_fill_rep(use3,"splitchk",3);
    let a:[]i32=zalloc_i(24); let b:[]i32=zalloc_i(24); let c:[]i32=zalloc_i(24);
    r0_segment(st,use3,24,a,b,c,24);
    b5_drive_utility_down(st,0);
    let child:i32=r0_maybe_split(st,0);
    b5_kv("B5E_SPLIT_CHILD,",child);
    b5_expect(fails,child==1);
    // Re-observe the original 8-span and the 4-byte prefix, then promote.
    b5_observe_span_n(st,s1,8,labs,6,6);
    let hp:[]i32=zalloc_i(4); b5_fill(hp,"spli");
    let lab3:[]i32=zalloc_i(1); lab3[0]=3;
    b5_observe_span_n(st,hp,4,lab3,1,6);
    let p2:i32=r0_promote(st,idx);
    b5_kv("B5E_REPROMOTED,",p2);
    b5_expect(fails,p2==1);   // only the 8-span re-issues; "spli" is shadowed
    let dup:i32=r0_chunk_count(st)-1;
    let db:[]i32=zalloc_i(8);
    let dln:i32=r0_chunk_bytes(st,dup,db,8);
    let same:i32=1;
    let q:i32=0; let orig:[]u8="splitchk";
    while(q<8){ if(db[q]!=(orig[q] as i32)){same=0;q=8;} else {q=q+1;} }
    b5_kv("B5E_DUP_ID,",dup);
    b5_kv("B5E_DUP_BYTES_OK,",same);
    b5_kv("B5E_DUP_STATE,",r0_chunk_state(st,dup));
    b5_expect(fails,dln==8);
    b5_expect(fails,same==1);
    b5_expect(fails,r0_chunk_state(st,dup)==1);
    b5_expect(fails,b5_find_live(st,"spli")==-1);  // prefix shadowed: never live
    b5_out("B5E_FINDING,B5-F1: post-split, the original 8-span re-promotes as a new live chunk while the tombstoned prefix permanently shadows its 4-span from live recruitment; same-material split-then-re-merge is unachievable against the frozen core\n");
    zfree_i(st); zfree_i(s1); zfree_i(labs); zfree_i(idx);
    zfree_i(use3); zfree_i(a); zfree_i(b); zfree_i(c);
    zfree_i(hp); zfree_i(lab3); zfree_i(db);
}

// ---- Arena C: conflict negative control — uniform labels (conflict 0) ----
fn b5_conflict_ctrl(leg:i32, fails:*i32)void {
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    let s:[]i32=zalloc_i(8); b5_fill(s,"unifchk!");
    let lab3:[]i32=zalloc_i(1); lab3[0]=3;
    b5_observe_span_n(st,s,8,lab3,1,6);
    let idx:[]i32=zalloc_i(4096);
    let p:i32=r0_promote(st,idx);
    b5_kv("B5C_PROMOTED,",p);
    b5_expect(fails,p==1);
    let id:i32=r0_chunk_count(st)-1;
    let u3:[]i32=zalloc_i(24); b5_fill_rep(u3,"unifchk!",3);
    let a:[]i32=zalloc_i(24); let b:[]i32=zalloc_i(24); let c:[]i32=zalloc_i(24);
    r0_segment(st,u3,24,a,b,c,24);
    b5_drive_utility_down(st,id);
    b5_kv("B5C_CONFLICT,",r0_chunk_conflict1000(st,id)); // expect 0
    b5_kv("B5C_USE,",r0_chunk_use(st,id));               // expect 3
    b5_kv("B5C_UTIL,",r0_chunk_utility(st,id));           // expect <=0
    b5_expect(fails,r0_chunk_conflict1000(st,id)==0);
    b5_expect(fails,r0_chunk_use(st,id)==3);
    b5_expect(fails,r0_chunk_utility(st,id)<=0);
    // use>=3 and utility<=floor hold, but conflict(0) < learned bar -> NO split
    let r:i32=r0_maybe_split(st,id);
    b5_kv("B5C_SPLIT_NO_CONFLICT,",r);
    b5_expect(fails,r==-1);
    zfree_i(st); zfree_i(s); zfree_i(lab3); zfree_i(idx);
    zfree_i(u3); zfree_i(a); zfree_i(b); zfree_i(c);
}

// ---- Arena C2: use-count negative control — use=2 < 3 blocks the split ----
fn b5_usecount_ctrl(leg:i32, fails:*i32)void {
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    let s:[]i32=zalloc_i(8); b5_fill(s,"use2chk!");
    let labs:[]i32=zalloc_i(6);
    labs[0]=3; labs[1]=3; labs[2]=0; labs[3]=1; labs[4]=2; labs[5]=3;
    b5_observe_span_n(st,s,8,labs,6,6);
    let idx:[]i32=zalloc_i(4096);
    b5_expect(fails,r0_promote(st,idx)==1);
    let id:i32=r0_chunk_count(st)-1;
    // only TWO segmentation passes: use_count = 2 < 3
    let u2:[]i32=zalloc_i(16); b5_fill_rep(u2,"use2chk!",2);
    let a:[]i32=zalloc_i(16); let b:[]i32=zalloc_i(16); let c:[]i32=zalloc_i(16);
    r0_segment(st,u2,16,a,b,c,16);
    b5_drive_utility_down(st,id);
    b5_kv("B5U_USE,",r0_chunk_use(st,id));                 // expect 2
    b5_kv("B5U_CONFLICT,",r0_chunk_conflict1000(st,id));   // expect 500
    b5_kv("B5U_UTIL,",r0_chunk_utility(st,id));            // expect <=0
    b5_expect(fails,r0_chunk_use(st,id)==2);
    b5_expect(fails,r0_chunk_conflict1000(st,id)==500);
    b5_expect(fails,r0_chunk_utility(st,id)<=0);
    // conflict>=bar and utility<=floor hold, but use(2) < 3 -> NO split
    let r:i32=r0_maybe_split(st,id);
    b5_kv("B5U_SPLIT_LOW_USE,",r);
    b5_expect(fails,r==-1);
    zfree_i(st); zfree_i(s); zfree_i(labs); zfree_i(idx);
    zfree_i(u2); zfree_i(a); zfree_i(b); zfree_i(c);
}

// ---- Arena D: threshold learning is audited (THRESH entries), never silent ----
fn b5_thresh_demo(leg:i32, fails:*i32)void {
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    let g0:i32=st[B5_LRN_GAIN_W];
    b5_kv("B5T_GAIN_BEFORE,",g0);
    r0_learn_thresholds(st,1,0);
    let g1:i32=st[B5_LRN_GAIN_W];
    b5_kv("B5T_GAIN_HELPED,",g1);
    r0_learn_thresholds(st,0,1);
    let g2:i32=st[B5_LRN_GAIN_W];
    b5_kv("B5T_GAIN_REGRET,",g2);
    // expected: leg0 0 -> max(0,-25)=0 -> 50 ; leg1 500 -> 475 -> 525
    if(leg==0){
        b5_expect(fails,g0==0); b5_expect(fails,g1==0); b5_expect(fails,g2==50);
    } else {
        b5_expect(fails,g0==500); b5_expect(fails,g1==475); b5_expect(fails,g2==525);
    }
    let n:i32=r0_ledger_count(st);
    b5_kv("B5T_LEDGER_N,",n);
    b5_expect(fails,n==2);
    b5_expect(fails,b5_ledger_word(st,0,0)==204);
    b5_expect(fails,b5_ledger_word(st,0,52)==10);
    b5_expect(fails,b5_ledger_word(st,0,56)==1);  // d1 = merge_helped
    b5_expect(fails,b5_ledger_word(st,0,60)==0);  // d2 = merge_regret
    b5_expect(fails,b5_ledger_word(st,1,0)==204);
    b5_expect(fails,b5_ledger_word(st,1,56)==0);
    b5_expect(fails,b5_ledger_word(st,1,60)==1);
    zfree_i(st);
}

fn main()i32 {
    let leg:i32=0;
    if(_zag_argc()>1){ let a:[]u8=_zag_arg(1); if(a.len>0 && a[0]==49){leg=1;} }
    let pert:i32=0;
    if(_zag_argc()>2){ let a:[]u8=_zag_arg(2); if(a.len>0){pert=(a[0] as i32)-48;} }
    if(pert<0 || pert>4){pert=0;}
    // STORESEQ readback gate (ZNC-2026-09-19-001): expected-value probes on
    // every 3+ sequential []i32 store site. Byte-identical reruns cannot
    // catch a deterministic miscompile — any fails>0 is a hard FAIL.
    let pf:i32=r0_probe_run();
    if(pf!=0){ b5_out("B5_PROBE_GATE_FAIL\n"); return 2; }
    let armor:M8Armor=m8_new();
    if(m8_armor_init(&armor,pert as i64)!=0){ b5_out("B5_ARMOR_INIT_FAIL\n"); return 1; }
    b5_perturb(pert);
    let fails:i32=0;
    b5_out("B5_BATTERY,leg="); b5_num(leg); b5_out("\n");
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    b5_scenario(st,leg,&fails);
    if(pert==4){ b5_churn(); }
    b5_dump_ledger(st);
    b5_conflict_ctrl(leg,&fails);
    b5_usecount_ctrl(leg,&fails);
    b5_thresh_demo(leg,&fails);
    b5_repromote_finding(leg,&fails);
    b5_kv("B5_FAILS_TOTAL,",fails);
    let sh:[]u8=b5_store_hex(st);
    let lh:[]u8=_zag_i64_to_str(r0_ledger_hash(st) as i64);
    m8_emit_captures(&armor,sh,lh);
    nio_free(sh); nio_free(lh);
    zfree_i(st);
    m8_armor_free(&armor);
    b5_out("B5_DONE\n");
    if(fails!=0){ return 3; }
    return 0;
}

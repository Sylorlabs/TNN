// sg_b4.zag — B-T4 support-gap recruitment hard battery, R0 redo (prereg §2 FROZEN).
// Crew B-DYNSG. Track R0, Micah signed 2026-09-21. R-9: 1x ONLY.
// One binary: argv[1] = leg (0 recovered / 1 re-derived), argv[2] = perturb 0..4.
// Frozen rule (R-8): the teacher supplies grounded whole experiences only; the
// learner recruits the largest unsupported span iff
//   support >= learned_support_min AND (support - runnerup_support) >= learned_margin,
// else abstains with a reason code (-1; d2: 1=low support, 2=margin failed,
// 3=bank full, 4=no gap, 5=span already issued).
// Battery: fresh arena per case; two live context chunks pre-seeded; the
// teacher then supplies a complete grounded experience stream; recruit is
// decided by the core rule. Exposure counts 1..16.
//   clean sub-battery (8 reps/exp): one 6-byte unsupported gap vs no runner-up.
//     leg0 expects recruit at e>=3, abstain(d2=1) at e<3;
//     leg1 expects recruit at e>=4, abstain(d2=1) at e<4.
//   contested sub-battery (4 reps/exp): a 6-byte gap vs a 5-byte runner-up gap
//     with equal support -> margin rule must abstain (d2=2) at EVERY exposure.
//   controls: fully-covered stream -> abstain d2=4; archived span -> d2=5.
// R-5 formal bar is UNSTATED in the frozen prereg: this battery reports the
// measured curves, PROPOSES a floor, and marks the formal bar
// PENDING-MICAH-AMENDMENT. Nothing here invents the floor.
// Pure Zag. Zero RNG in AI decision paths. Byte-identical reruns (M8).
// Build: znc sg_b4.zag -o /tmp/sg_b4 --no-zagd --no-analyze --no-foreground-cache
@import("../core/r0_core.zag")
@import("../core/r0_probe.zag")
@import("../harness/m8_armor.zag")

const SG_LEDGER_BASE:i32=91168;
const SG_LEDGER_STRIDE:i32=64;

fn sg_out(s:[]u8)void { _zag_print(s); }
fn sg_num(v:i32)void { _zag_print(_zag_i64_to_str(v as i64)); }
fn sg_kv(k:[]u8,v:i32)void { sg_out(k); sg_num(v); sg_out("\n"); }
fn sg_expect(f:*i32, cond:i32)void { if(cond==0){ f.*=f.*+1; } }

fn sg_perturb(mode:i32)void {
    if(mode==1){
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(128);
        let a2:[]i32=zalloc_i(32); let a3:[]i32=zalloc_i(256);
        let a4:[]i32=zalloc_i(48); let a5:[]i32=zalloc_i(96);
        let a6:[]i32=zalloc_i(160); let a7:[]i32=zalloc_i(24);
        a0[0]=1; a3[0]=2; a6[0]=3;
        zfree_i(a1); zfree_i(a4); zfree_i(a6);
        let b0:[]i32=zalloc_i(200); let b1:[]i32=zalloc_i(40);
        b0[0]=4; b1[0]=5;
        zfree_i(a0); zfree_i(b0);
        zfree_i(a2); zfree_i(a3); zfree_i(a5); zfree_i(a7); zfree_i(b1);
    } else if(mode==2){
        let a0:[]i32=zalloc_i(64); let a1:[]i32=zalloc_i(64);
        let a2:[]i32=zalloc_i(64); let a3:[]i32=zalloc_i(64);
        let a4:[]i32=zalloc_i(64); let a5:[]i32=zalloc_i(64);
        a0[0]=1; a1[0]=2; a2[0]=3; a3[0]=4; a4[0]=5; a5[0]=6;
        zfree_i(a5); zfree_i(a4); zfree_i(a3);
        zfree_i(a2); zfree_i(a1); zfree_i(a0);
    } else if(mode==3){
        let big:[]i32=zalloc_i(65536);
        let i:i32=0;
        while(i<65536){ big[i]=i & 255; i=i+1024; }
        zfree_i(big);
        let s1:[]i32=zalloc_i(13); s1[0]=7; zfree_i(s1);
    }
}
fn sg_churn()void {
    let a0:[]i32=zalloc_i(512); let a1:[]i32=zalloc_i(17);
    a0[0]=9; a1[0]=8;
    zfree_i(a0);
    let b0:[]i32=zalloc_i(300); b0[0]=7;
    zfree_i(a1); zfree_i(b0);
    let c0:[]i32=zalloc_i(1024); c0[0]=6; zfree_i(c0);
}

fn sg_fill(seq:[]i32, lit:[]u8)void {
    let i:i32=0; while(i<lit.len){ seq[i]=lit[i] as i32; i=i+1; }
}
fn sg_fill_at(seq:[]i32, off:i32, lit:[]u8)void {
    let i:i32=0; while(i<lit.len){ seq[off+i]=lit[i] as i32; i=i+1; }
}
// The teacher pre-seeds two live context chunks: 8 grounded observations of
// each, then a promote. These are the "known" inventory the learner recruits
// against; the gap target is never promoted by the teacher.
fn sg_preseed(st:[]i32)void {
    let c1:[]i32=zalloc_i(8); sg_fill(c1,"ctxAAAAA");
    let c2:[]i32=zalloc_i(8); sg_fill(c2,"ctxBBBBB");
    let t:i32=0;
    while(t<8){ r0_observe_span(st,c1,0,8,3,-1); t=t+1; }
    t=0;
    while(t<8){ r0_observe_span(st,c2,0,8,3,-1); t=t+1; }
    let idx:[]i32=zalloc_i(4096);
    let p:i32=r0_promote(st,idx);
    zfree_i(c1); zfree_i(c2); zfree_i(idx);
}
// One grounded whole experience: observe every span of length 2..8 at every
// position, `times` times (all grounded recall-success labels).
fn sg_observe_stream(st:[]i32, seq:[]i32, n:i32, times:i32)void {
    let t:i32=0;
    while(t<times){
        let pos:i32=0;
        while(pos<n){
            let len:i32=2;
            while(len<=8 && pos+len<=n){
                r0_observe_span(st,seq,pos,len,3,-1);
                len=len+1;
            }
            pos=pos+1;
        }
        t=t+1;
    }
}
fn sg_ledger_word(st:[]i32, e:i32, w:i32)i32 {
    return st[SG_LEDGER_BASE + e*SG_LEDGER_STRIDE + w];
}
// Deterministic gap bytes for replicate r: 6 bytes at 128+8r+k.
fn sg_gap_byte(r:i32, k:i32)i32 { return 128+8*r+k; }

// ---- clean case: one 6-byte gap, no runner-up ----
// Row: SG_ROW,leg,e,rep,rid,reason,correct
fn sg_clean_case(leg:i32, e:i32, r:i32, fails:*i32)void {
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    sg_preseed(st);
    let n:i32=38;
    let seq:[]i32=zalloc_i(n);
    sg_fill_at(seq,0,"ctxAAAAA"); sg_fill_at(seq,8,"ctxBBBBB");
    let k:i32=0; while(k<6){ seq[16+k]=sg_gap_byte(r,k); k=k+1; }
    sg_fill_at(seq,22,"ctxAAAAA"); sg_fill_at(seq,30,"ctxBBBBB");
    sg_observe_stream(st,seq,n,e);
    let before:i32=r0_ledger_count(st);
    let rid:i32=r0_support_gap_recruit(st,seq,n);
    let opok:i32=0;
    if(sg_ledger_word(st,before,0)==201){opok=1;}
    let reason:i32=sg_ledger_word(st,before,60); // d2
    let minsup:i32=3; if(leg==1){minsup=4;}
    let correct:i32=0;
    if(e<minsup){
        if(rid==-1 && reason==1){correct=1;}       // abstain: low support
    } else {
        if(rid>=0 && reason==0){
            let gs:i32=sg_ledger_word(st,before,12); // b1 = start
            let gl:i32=sg_ledger_word(st,before,16); // b2 = len
            let cb:[]i32=zalloc_i(8);
            let gln:i32=r0_chunk_bytes(st,rid,cb,8);
            if(gln==6 && gs==16 && gl==6){
                let same:i32=1; let q:i32=0;
                while(q<6){
                    if(cb[q]!=sg_gap_byte(r,q)){same=0;q=6;} else {q=q+1;}
                }
                if(same==1){correct=1;}
            }
            zfree_i(cb);
        }
    }
    if(opok==0){correct=0;}
    sg_expect(fails,opok==1);
    sg_out("SG_ROW,"); sg_num(leg); sg_out(",");
    sg_num(e); sg_out(","); sg_num(r); sg_out(",");
    sg_num(rid); sg_out(","); sg_num(reason); sg_out(",");
    sg_num(correct); sg_out("\n");
    if(correct==0){ fails.*=fails.*+1; }
    zfree_i(st); zfree_i(seq);
}

// ---- contested case: 6-byte gap vs 5-byte runner-up, equal support ----
// The learned-margin rule must keep the learner from recruiting at EVERY
// exposure: abstain with d2=1 (low support) while e<minsup, and d2=2 (margin
// failed) once the support clause passes. correct = abstained for the reason
// the rule's ordered conjunction dictates.
fn sg_contested_case(leg:i32, e:i32, r:i32, fails:*i32)void {
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    sg_preseed(st);
    let n:i32=43;
    let seq:[]i32=zalloc_i(n);
    sg_fill_at(seq,0,"ctxAAAAA"); sg_fill_at(seq,8,"ctxBBBBB");
    let k:i32=0; while(k<6){ seq[16+k]=sg_gap_byte(r,k); k=k+1; }   // target 6
    sg_fill_at(seq,22,"ctxAAAAA");
    k=0; while(k<5){ seq[30+k]=200+8*r+k; k=k+1; }                   // rival 5
    sg_fill_at(seq,35,"ctxBBBBB");
    sg_observe_stream(st,seq,n,e);
    let before:i32=r0_ledger_count(st);
    let rid:i32=r0_support_gap_recruit(st,seq,n);
    let opok:i32=0;
    if(sg_ledger_word(st,before,0)==201){opok=1;}
    let reason:i32=sg_ledger_word(st,before,60);
    // The rule is conjunctive and ordered: low-support fires before the margin
    // check. So at e<minsup the correct abstention reason is 1; at e>=minsup
    // the margin clause is reached and must fire (reason 2). Either way the
    // learner must NEVER recruit the contested gap.
    let minsup:i32=3; if(leg==1){minsup=4;}
    let correct:i32=0;
    if(rid==-1){
        if(e<minsup && reason==1){correct=1;}
        if(e>=minsup && reason==2){correct=1;}
    }
    if(opok==0){correct=0;}
    sg_expect(fails,opok==1);
    sg_out("SG_CT,"); sg_num(leg); sg_out(",");
    sg_num(e); sg_out(","); sg_num(r); sg_out(",");
    sg_num(rid); sg_out(","); sg_num(reason); sg_out(",");
    sg_num(correct); sg_out("\n");
    if(correct==0){ fails.*=fails.*+1; }
    zfree_i(st); zfree_i(seq);
}

// ---- controls: reason codes 4 (no gap) and 5 (span already issued) ----
fn sg_controls(leg:i32, fails:*i32)void {
    // C1: fully-covered stream -> abstain, reason 4 (no gap)
    let st:[]i32=zalloc_i(r0_arena_words());
    r0_init(st,leg);
    sg_preseed(st);
    let seq:[]i32=zalloc_i(32);
    sg_fill_at(seq,0,"ctxAAAAA"); sg_fill_at(seq,8,"ctxBBBBB");
    sg_fill_at(seq,16,"ctxAAAAA"); sg_fill_at(seq,24,"ctxBBBBB");
    sg_observe_stream(st,seq,32,8);
    let before:i32=r0_ledger_count(st);
    let r1:i32=r0_support_gap_recruit(st,seq,32);
    let d1:i32=sg_ledger_word(st,before,60);
    sg_kv("SG_C1_COVERED_RID,",r1);
    sg_kv("SG_C1_COVERED_D2,",d1);
    sg_expect(fails,r1==-1); sg_expect(fails,d1==4);
    zfree_i(st); zfree_i(seq);
    // C2: target span promoted then archived -> recruit sees an uncovered run
    // that matches an issued (tombstoned) span -> abstain, reason 5
    let st2:[]i32=zalloc_i(r0_arena_words());
    r0_init(st2,leg);
    sg_preseed(st2);
    let tg:[]i32=zalloc_i(6);
    let k:i32=0; while(k<6){ tg[k]=sg_gap_byte(0,k); k=k+1; }
    let t2:i32=0;
    while(t2<8){ r0_observe_span(st2,tg,0,6,3,-1); t2=t2+1; }
    let idx:[]i32=zalloc_i(4096);
    let np:i32=r0_promote(st2,idx);
    sg_kv("SG_C2_PROMOTED,",np);
    // find the issued 6-span and archive it
    let target:i32=-1;
    let nc:i32=r0_chunk_count(st2);
    let id:i32=0;
    while(id<nc){
        if(r0_chunk_state(st2,id)==1 && r0_chunk_len(st2,id)==6){
            let cb:[]i32=zalloc_i(8);
            let gl:i32=r0_chunk_bytes(st2,id,cb,8);
            let same:i32=1; let q:i32=0;
            while(q<6){
                if(cb[q]!=sg_gap_byte(0,q)){same=0;q=6;} else {q=q+1;}
            }
            zfree_i(cb);
            if(same==1){target=id;id=nc;}
            else {id=id+1;}
        } else { id=id+1; }
    }
    sg_kv("SG_C2_TARGET,",target);
    sg_expect(fails,target>=0);
    if(target>=0){ r0_archive(st2,target,1); }
    let seq2:[]i32=zalloc_i(38);
    sg_fill_at(seq2,0,"ctxAAAAA"); sg_fill_at(seq2,8,"ctxBBBBB");
    k=0; while(k<6){ seq2[16+k]=sg_gap_byte(0,k); k=k+1; }
    sg_fill_at(seq2,22,"ctxAAAAA"); sg_fill_at(seq2,30,"ctxBBBBB");
    sg_observe_stream(st2,seq2,38,8);
    let before2:i32=r0_ledger_count(st2);
    let r2:i32=r0_support_gap_recruit(st2,seq2,38);
    let d2r:i32=sg_ledger_word(st2,before2,60);
    sg_kv("SG_C2_ARCHIVED_RID,",r2);
    sg_kv("SG_C2_ARCHIVED_D2,",d2r);
    sg_expect(fails,r2==-1); sg_expect(fails,d2r==5);
    zfree_i(st2); zfree_i(seq2); zfree_i(tg); zfree_i(idx);
}

fn sg_store_hex(st:[]i32)[]u8 {
    // NOTE (ZNC-2026-09-21-002): `slice as *u8` does NOT yield a data pointer
    // in this znc build; build the image by decomposing words -> bytes.
    let nw:i32=32+19456;
    let buf:[]u8=nio_alloc(nw*4);
    let w:i32=0;
    while(w<nw){
        let word:i32=st[w];
        buf[w*4]=(word & 255) as u8;
        buf[w*4+1]=((word>>8) & 255) as u8;
        buf[w*4+2]=((word>>16) & 255) as u8;
        buf[w*4+3]=((word>>24) & 255) as u8;
        w=w+1;
    }
    let h:[]u8=hc_sha256_hex(buf);
    nio_free(buf);
    return h;
}
// Canonical capture arena: clean case e=16 rep 0 (perturb-invariant content).
fn sg_canonical(st:[]i32, leg:i32)void {
    sg_preseed(st);
    let n:i32=38;
    let seq:[]i32=zalloc_i(n);
    sg_fill_at(seq,0,"ctxAAAAA"); sg_fill_at(seq,8,"ctxBBBBB");
    let k:i32=0; while(k<6){ seq[16+k]=sg_gap_byte(0,k); k=k+1; }
    sg_fill_at(seq,22,"ctxAAAAA"); sg_fill_at(seq,30,"ctxBBBBB");
    sg_observe_stream(st,seq,n,16);
    let rid:i32=r0_support_gap_recruit(st,seq,n);
    sg_kv("SG_CANON_RID,",rid);
    zfree_i(seq);
}

fn main()i32 {
    let leg:i32=0;
    if(_zag_argc()>1){ let a:[]u8=_zag_arg(1); if(a.len>0 && a[0]==49){leg=1;} }
    let pert:i32=0;
    if(_zag_argc()>2){ let a:[]u8=_zag_arg(2); if(a.len>0){pert=(a[0] as i32)-48;} }
    if(pert<0 || pert>4){pert=0;}
    // STORESEQ readback gate (ZNC-2026-09-19-001): any fails>0 is a hard FAIL.
    let pf:i32=r0_probe_run();
    if(pf!=0){ sg_out("SG_PROBE_GATE_FAIL\n"); return 2; }
    let armor:M8Armor=m8_new();
    if(m8_armor_init(&armor,pert as i64)!=0){ sg_out("SG_ARMOR_INIT_FAIL\n"); return 1; }
    sg_perturb(pert);
    let fails:i32=0;
    sg_out("SG_BATTERY,leg="); sg_num(leg); sg_out("\n");
    let e:i32=1;
    while(e<=16){
        let r:i32=0;
        while(r<8){ sg_clean_case(leg,e,r,&fails); r=r+1; }
        e=e+1;
    }
    e=1;
    while(e<=16){
        let r:i32=0;
        while(r<4){ sg_contested_case(leg,e,r,&fails); r=r+1; }
        e=e+1;
    }
    sg_controls(leg,&fails);
    if(pert==4){ sg_churn(); }
    let cst:[]i32=zalloc_i(r0_arena_words());
    r0_init(cst,leg);
    sg_canonical(cst,leg);
    let sh:[]u8=sg_store_hex(cst);
    let lh:[]u8=_zag_i64_to_str(r0_ledger_hash(cst) as i64);
    m8_emit_captures(&armor,sh,lh);
    nio_free(sh); nio_free(lh);
    zfree_i(cst);
    m8_armor_free(&armor);
    sg_kv("SG_FAILS_TOTAL,",fails);
    sg_out("SG_DONE\n");
    if(fails!=0){ return 3; }
    return 0;
}

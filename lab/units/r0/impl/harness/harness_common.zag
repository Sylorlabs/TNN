// harness_common.zag — R0 measurement harness shared utilities.
// Track R0, prereg FROZEN (Micah signed 2026-09-21).
// HARD LAWS: pure Zag; zero RNG in AI decision paths; byte-identical reruns.
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------------------------------------------------------------------
// Deterministic environment generator.
// ENVIRONMENT INPUT ONLY — never an AI decision. The AI's mind is
// deterministic given state; the world (corpus sampling offsets, perturbation
// seeds, synthetic filler) may be drawn from this fixed, logged stream.
// Logged fixed seed (per M2 T3 precedent): the seed is declared here, printed
// by every driver at startup, and recorded in the evidence log.
// ---------------------------------------------------------------------------
const ENV_SEED:i64=20260921;
struct EnvStream { s:i64 }
fn env_init(seed:i64)EnvStream { return EnvStream{.s=seed}; }
fn env_next(st:*EnvStream)i64 {
    // xorshift64* — deterministic, fixed seed, no OS entropy.
    let x:i64=st.*.s;x=x^x>>12;x=x^x<<25;x=x^x>>27;st.*.s=x;
    return x*2685821657736338717;
}
fn env_next_bound(st:*EnvStream,bound:i64)i64 {
    if(bound<1){return 0;}
    let v:i64=env_next(st);if(v<0){v=-v;}return v-(v/bound)*bound;
}

// ---------------------------------------------------------------------------
// Small byte utilities (owning semantics marked).
// ---------------------------------------------------------------------------
fn hc_equal(a:[]u8,b:[]u8)i32 { return nio_equal(a,b); }
fn hc_copy(dst:[]u8,src:[]u8)void {
    let i:i32=0;while(i<src.len && i<dst.len){dst[i]=src[i];i=i+1;}
}
fn hc_fill(b:[]u8,v:u8)void { let i:i32=0;while(i<b.len){b[i]=v;i=i+1;} }
fn hc_zerou64(b:[]i64)void { let i:i32=0;while(i<b.len){b[i]=0;i=i+1;} }

// TOOLCHAIN BUG ZNC-2026-09-21-004 (characterized 2026-09-21): znc miscompiles
// indexed STORES to []i32 heap slices at large indices (>= ~61440): the store
// faults while the same-index LOAD works and []i64/[]u8 are unaffected at the
// same indices. All large tables in this harness are []i64 for this reason.
// hc_alloc_i32/hc_free_i32 are retained for small tables only.
//
// HARDENING 2026-09-21 (coordinator notice): the EXPLORE crew independently
// re-derived ZNC-2026-09-19-001 — 3+ SEQUENTIAL []i32 stores corrupt
// (deterministically wrong values, NOT just large-index faults), in []i32 AND
// []i64 multi-store contexts. []u8 indexed stores are fully reliable
// (verified over 500 sequential cells, negatives/extremes exact). Policy for
// this harness: every table with 3+ sequential indexed stores uses []u8-backed
// little-endian cells below; the selftest's STORESEQ probe (driver.zag) does
// readback verification of every store pattern that remains ([]u8 cells,
// 2-sequential []i64 stores, single-store loops) with expected values, so any
// affected sequence fails loudly instead of silently.

// ---------------------------------------------------------------------------
// []u8-backed little-endian cells. All indexed stores below are []u8 stores
// (proven reliable); multi-word values are assembled arithmetically.
// ---------------------------------------------------------------------------
fn hc_le32_set(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn hc_le32_get(b:[]u8,o:i32)i32 {
    return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn hc_le64_set(b:[]u8,o:i32,v:i64)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
    b[o+4]=((v>>32)&255) as u8;
    b[o+5]=((v>>40)&255) as u8;
    b[o+6]=((v>>48)&255) as u8;
    b[o+7]=((v>>56)&255) as u8;
}
fn hc_le64_get(b:[]u8,o:i32)i64 {
    return (b[o] as i64)|((b[o+1] as i64)<<8)|((b[o+2] as i64)<<16)|((b[o+3] as i64)<<24)
         | ((b[o+4] as i64)<<32)|((b[o+5] as i64)<<40)|((b[o+6] as i64)<<48)|((b[o+7] as i64)<<56);
}

// Typed (word) allocators: nio_alloc returns []u8 only. These allocate via
// _zag_malloc and return pointer slices; free with hc_free_i64/i32.
// (Empty-slice-on-failure via null-derived slice; all live call sites use n>=1.)
fn hc_alloc_i64(n:i32)[]i64 {
    if(n<1){n=1;}
    let p:*i64=_zag_malloc(n*8) as *i64;
    if(p==null as *i64){return (null as *i64)[0..0];}
    let b:[]i64=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn hc_free_i64(b:[]i64)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b) as *i8);}
}
fn hc_alloc_i32(n:i32)[]i32 {
    if(n<1){n=1;}
    let p:*i32=_zag_malloc(n*4) as *i32;
    if(p==null as *i32){return (null as *i32)[0..0];}
    let b:[]i32=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn hc_free_i32(b:[]i32)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b) as *i8);}
}

// print helpers
fn hc_num(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn hc_numln(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);_zag_println(s);nio_free(s);
}

// sha256(data) -> 64-char lowercase hex (owned by caller; nio_free it).
fn hc_sha256_hex(data:[]u8)[]u8 {
    let raw:[]u8=nio_alloc(32);if(raw.len!=32){return "";}
    if(ns_sha256(data,raw)!=0){nio_free(raw);return "";}
    let hex:[]u8=nio_alloc(64);
    if(hex.len!=64){nio_free(raw);return "";}
    let dig:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<32){
        hex[i*2]=dig[(raw[i]>>4)&15];
        hex[i*2+1]=dig[raw[i]&15];
        i=i+1;
    }
    nio_free(raw);return hex;
}

// ---------------------------------------------------------------------------
// File IO via the native IO layer. rootp = directory path (non-owned).
// Reads up to maxb bytes of file `name` inside dir `rootp` into `out`.
// Returns bytes read, or negative error.
// ---------------------------------------------------------------------------
fn hc_read_file(rootp:[]u8,name:[]u8,out:[]u8) i64 {
    let root:i64=nio_open_root(rootp);if(root<0){return -7401;}
    let fd:i64=nio_open_child(root,name,0);nio_close(root);
    if(fd<0){return -7402;}
    let n:i64=nio_read_exact(fd,out,out.len);nio_close(fd);
    return n;
}
fn hc_write_file(rootp:[]u8,name:[]u8,data:[]u8)i64 {
    let root:i64=nio_open_root(rootp);if(root<0){return -7401;}
    let fd:i64=nio_open_child(root,name,1);nio_close(root);
    if(fd<0){return -7402;}
    let n:i64=nio_write_all(fd,data);nio_close(fd);
    if(n<0){return n;}
    return n;
}

// print the fixed env seed declaration line (evidence requirement)
fn hc_print_seed_decl()void {
    _zag_print("HARNESS_ENV_SEED,");
    hc_num(ENV_SEED);
    _zag_println(",environment-input-only,never-ai-decision");
}

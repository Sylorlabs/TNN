// evidence.zag — R0 harness evidence pipeline.
// Emits machine-readable scorecards per the metrics-v1 JSON schema
// (PREREG_FREEZE §0 M-54; METRICS.md SCORECARD section, "Machine-readable
// schema" — normative). Schema version metrics-v1: NO field may be added
// without Micah's sign-off (M-55). The emitted object contains EXACTLY the
// normative key list: arm, round, scale, m1_recall_prose, m1_recall_code,
// m1_boundary_prose, m1_boundary_code, m1_id_probe, m2_etc{t1_prose,t1_code,
// t2,t3}, m3_survival, m3_freeze_flag, m4_revised_boundary,
// m4_revised_content, m4_kill_rate, m4_kill_substitution_flag,
// m5_mem_per_byte, m5_audit_per_kb, m6_p2c{rec,bnd,rev}, m6_c2p{rec,bnd,rev},
// m6_tax_p2c, m6_tax_c2p, m7_hit, m7_reuse, m7_dedup, m7_na_reason, m8_gate,
// m9_shape, m9_triple, disqualified.
// Normative type rules (METRICS.md): numbers as numbers, flags as strings,
// N/A as null with the reason in m7_na_reason.
//   - m2_etc inner keys {t1_prose,t1_code,t2,t3} follow the METRICS.md column
//     spec ("T2/T3 single numbers (one corpus each)"). NOTE: ARM_INTERFACE.md
//     (units/arms/harness) lists a wider m2_etc and JSON booleans for the two
//     flags below — that document disagrees with METRICS.md; this emitter
//     follows METRICS.md ("flags as strings") and the divergence is flagged
//     in the R0 verdict sheet.
//   - m4_kill_substitution_flag: "true"/"false" (string; "true" -> M4 scored 0).
//   - disqualified: "true"/"false" (string).
// Millipoint convention (harness-internal, documented): percentage-like
// fields are i64 in units of 1/1000 (e.g. 99700 = 99.700%); JSON numbers keep
// full precision, so no information is lost vs the template's 1-decimal cells.
@import("harness_common.zag")

// ---------------------------------------------------------------------------
// Evidence log: append-only text file of "EV <kind> <payload>" lines.
// ---------------------------------------------------------------------------
struct EvLog { fd:i64, ok:i32 }

fn ev_open(rootp:[]u8,name:[]u8)EvLog {
    let root:i64=nio_open_root(rootp);
    if(root<0){return EvLog{.fd=-1,.ok=0};}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){
        // exists already: open for append
        root=nio_open_root(rootp);
        if(root<0){return EvLog{.fd=-1,.ok=0};}
        fd=nio_open_child(root,name,0);
        nio_close(root);
        if(fd>=0){nio_seek(fd,0,2);}
    }
    if(fd<0){return EvLog{.fd=-1,.ok=0};}
    return EvLog{.fd=fd,.ok=1};
}
fn ev_line(h:*EvLog,kind:[]u8,payload:[]u8)void {
    if(h.*.ok!=1){return;}
    let buf:[]u8=nio_alloc(4096);
    if(buf.len==0){return;}
    let i:i32=0;
    let tag:[]u8="EV ";
    let t:i32=0;while(t<tag.len && i<4090){buf[i]=tag[t];i=i+1;t=t+1;}
    t=0;while(t<kind.len && i<4090){buf[i]=kind[t];i=i+1;t=t+1;}
    if(i<4090){buf[i]=32;i=i+1;}
    t=0;while(t<payload.len && i<4090){buf[i]=payload[t];i=i+1;t=t+1;}
    if(i<4090){buf[i]=10;i=i+1;}
    nio_write_all(h.*.fd,buf[0..i]);
    nio_free(buf);
}
fn ev_close(h:*EvLog)void {
    if(h.*.ok==1){nio_sync(h.*.fd);nio_close(h.*.fd);h.*.ok=0;}
}

// ---------------------------------------------------------------------------
// metrics-v1 scorecard. Millipoint convention: percentage-like fields are
// i64 in units of 1/1000 (e.g., 99700 = 99.700%). Counts are plain i64.
// N/A numeric = -1 with reason in the *_na_reason / *_note string.
// ---------------------------------------------------------------------------
struct Scorecard {
    arm:[]u8, round:i64, scale:i64,
    m1_recall_prose:i64, m1_recall_code:i64,
    m1_boundary_prose:i64, m1_boundary_code:i64,
    m1_id_probe:[]u8,
    m2_t1_prose:i64, m2_t1_code:i64, m2_t2:i64, m2_t3:i64,
    m3_survival:i64, m3_freeze_flag:[]u8,
    m4_rev_bound:i64, m4_rev_content:i64, m4_kill:i64, m4_ksub:[]u8,
    m5_mem_per_byte:i64, m5_audit_per_kb:i64,
    m6_p2c_rec:i64, m6_p2c_bnd:i64, m6_p2c_rev:i64,
    m6_c2p_rec:i64, m6_c2p_bnd:i64, m6_c2p_rev:i64,
    m6_tax_p2c:i64, m6_tax_c2p:i64,
    m7_hit:i64, m7_reuse:i64, m7_dedup:i64, m7_na_reason:[]u8,
    m8_gate:[]u8,
    m9_shape:[]u8, m9_t:i64, m9_s:i64, m9_l:i64,
    disqualified:[]u8
}

// fixed3: milli value -> "[-]ddd.ddd" into buf at offset; returns new offset.
fn ev_fixed3(buf:[]u8,off:i32,v:i64)i32 {
    let neg:i32=0;let x:i64=v;
    if(x<0){neg=1;x=-x;}
    let ip:i64=x/1000;let fp:i64=x-ip*1000;
    let tmp:[]u8=_zag_i64_to_str(ip);
    let o:i32=off;
    if(neg==1 && o<buf.len){buf[o]=45;o=o+1;}
    let t:i32=0;while(t<tmp.len && o<buf.len){buf[o]=tmp[t];o=o+1;t=t+1;}
    nio_free(tmp);
    if(o<buf.len){buf[o]=46;o=o+1;}
    let d0:i64=fp/100;let d1:i64=(fp-d0*100)/10;let d2:i64=fp-d0*100-d1*10;
    if(o+3<=buf.len){buf[o]=(48+d0) as u8;buf[o+1]=(48+d1) as u8;buf[o+2]=(48+d2) as u8;o=o+3;}
    return o;
}
fn ev_raw(buf:[]u8,off:i32,v:i64)i32 {
    let tmp:[]u8=_zag_i64_to_str(v);
    let o:i32=off;let t:i32=0;
    while(t<tmp.len && o<buf.len){buf[o]=tmp[t];o=o+1;t=t+1;}
    nio_free(tmp);return o;
}
fn ev_str(buf:[]u8,off:i32,s:[]u8)i32 {
    let o:i32=off;let t:i32=0;
    while(t<s.len && o<buf.len){buf[o]=s[t];o=o+1;t=t+1;}
    return o;
}
fn ev_field(buf:[]u8,off:i32,name:[]u8)i32 {
    let o:i32=off;
    if(o<buf.len){buf[o]=34;o=o+1;}
    o=ev_str(buf,o,name);
    if(o+2<=buf.len){buf[o]=34;o=o+1;buf[o]=58;o=o+1;}
    return o;
}
fn ev_comma(buf:[]u8,off:i32)i32 {
    if(off<buf.len){buf[off]=44;return off+1;}return off;
}
fn ev_numfield(buf:[]u8,off:i32,name:[]u8,v:i64)i32 {
    let o:i32=ev_field(buf,off,name);o=ev_raw(buf,o,v);return o;
}
fn ev_mpfield(buf:[]u8,off:i32,name:[]u8,v:i64)i32 {
    // millipoint numeric, or null when v<0 (N/A)
    let o:i32=ev_field(buf,off,name);
    if(v<0){o=ev_str(buf,o,"null");}else{o=ev_fixed3(buf,o,v);}
    return o;
}
fn ev_strfield(buf:[]u8,off:i32,name:[]u8,v:[]u8)i32 {
    let o:i32=ev_field(buf,off,name);
    if(o<buf.len){buf[o]=34;o=o+1;}
    o=ev_str(buf,o,v);
    if(o<buf.len){buf[o]=34;o=o+1;}
    return o;
}

// Emit one metrics-v1 JSON object with EXACTLY the normative keys. buf must
// be large (65536). Returns bytes written.
fn scorecard_emit(sc:*Scorecard,buf:[]u8)i32 {
    let o:i32=0;
    buf[0]=123;o=1; // {
    o=ev_strfield(buf,o,"arm",sc.*.arm);o=ev_comma(buf,o);
    o=ev_numfield(buf,o,"round",sc.*.round);o=ev_comma(buf,o);
    o=ev_numfield(buf,o,"scale",sc.*.scale);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m1_recall_prose",sc.*.m1_recall_prose);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m1_recall_code",sc.*.m1_recall_code);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m1_boundary_prose",sc.*.m1_boundary_prose);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m1_boundary_code",sc.*.m1_boundary_code);o=ev_comma(buf,o);
    o=ev_strfield(buf,o,"m1_id_probe",sc.*.m1_id_probe);o=ev_comma(buf,o);
    // m2_etc object
    o=ev_field(buf,o,"m2_etc");if(o<buf.len){buf[o]=123;o=o+1;}
    o=ev_numfield(buf,o,"t1_prose",sc.*.m2_t1_prose);o=ev_comma(buf,o);
    o=ev_numfield(buf,o,"t1_code",sc.*.m2_t1_code);o=ev_comma(buf,o);
    o=ev_numfield(buf,o,"t2",sc.*.m2_t2);o=ev_comma(buf,o);
    o=ev_numfield(buf,o,"t3",sc.*.m2_t3);
    if(o<buf.len){buf[o]=125;o=o+1;}o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m3_survival",sc.*.m3_survival);o=ev_comma(buf,o);
    o=ev_strfield(buf,o,"m3_freeze_flag",sc.*.m3_freeze_flag);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m4_revised_boundary",sc.*.m4_rev_bound);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m4_revised_content",sc.*.m4_rev_content);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m4_kill_rate",sc.*.m4_kill);o=ev_comma(buf,o);
    o=ev_strfield(buf,o,"m4_kill_substitution_flag",sc.*.m4_ksub);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m5_mem_per_byte",sc.*.m5_mem_per_byte);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m5_audit_per_kb",sc.*.m5_audit_per_kb);o=ev_comma(buf,o);
    // m6 objects
    o=ev_field(buf,o,"m6_p2c");if(o<buf.len){buf[o]=123;o=o+1;}
    o=ev_mpfield(buf,o,"rec",sc.*.m6_p2c_rec);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"bnd",sc.*.m6_p2c_bnd);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"rev",sc.*.m6_p2c_rev);
    if(o<buf.len){buf[o]=125;o=o+1;}o=ev_comma(buf,o);
    o=ev_field(buf,o,"m6_c2p");if(o<buf.len){buf[o]=123;o=o+1;}
    o=ev_mpfield(buf,o,"rec",sc.*.m6_c2p_rec);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"bnd",sc.*.m6_c2p_bnd);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"rev",sc.*.m6_c2p_rev);
    if(o<buf.len){buf[o]=125;o=o+1;}o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m6_tax_p2c",sc.*.m6_tax_p2c);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m6_tax_c2p",sc.*.m6_tax_c2p);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m7_hit",sc.*.m7_hit);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m7_reuse",sc.*.m7_reuse);o=ev_comma(buf,o);
    o=ev_mpfield(buf,o,"m7_dedup",sc.*.m7_dedup);o=ev_comma(buf,o);
    o=ev_strfield(buf,o,"m7_na_reason",sc.*.m7_na_reason);o=ev_comma(buf,o);
    o=ev_strfield(buf,o,"m8_gate",sc.*.m8_gate);o=ev_comma(buf,o);
    o=ev_strfield(buf,o,"m9_shape",sc.*.m9_shape);o=ev_comma(buf,o);
    o=ev_field(buf,o,"m9_triple");if(o<buf.len){buf[o]=91;o=o+1;}
    o=ev_raw(buf,o,sc.*.m9_t);o=ev_comma(buf,o);
    o=ev_raw(buf,o,sc.*.m9_s);o=ev_comma(buf,o);
    o=ev_raw(buf,o,sc.*.m9_l);
    if(o<buf.len){buf[o]=93;o=o+1;}o=ev_comma(buf,o);
    o=ev_strfield(buf,o,"disqualified",sc.*.disqualified);
    if(o<buf.len){buf[o]=125;o=o+1;}
    return o;
}

// Targeted determinism probe for ZNC-2026-09-19-001 (3+ sequential i32/i64
// stores corrupt; []u8 stores reliable). arms.zag uses NO []i32/[]i64 slices —
// all integer arrays are *i64 pointer-indexed stores — but the miscompile is
// described as hitting "multi-store []i32/[]i64 contexts", so this probe
// replicates arms.zag's EXACT hot store patterns and verifies readback:
//   P1: 4 sequential *i64 stores to 4 arrays at a computed index (hash-table
//       insert pattern: sh/sl/sc/sf), 200k iterations, then full readback.
//   P2: 5 sequential *i64 stores (candidate-fill pattern: cs/cl/cc/cf/cg).
//   P3: mergesort-style: sequential stores into tmp[] then copy-back, verify
//       sorted order.
//   P4: 8 sequential *i64 stores incl. negatives and i64 extremes.
// Any mismatch -> "FAIL" + nonzero exit. Deterministic by construction.
fn z64(n:i32)*i64 {
    let p:*i64 = _zag_malloc((n as i64)*8 as i64 as i32) as *i64;
    if(p == null as *i64){ return null as *i64; }
    let i:i32=0; while(i<n){ p[i]=0 as i64; i=i+1; }
    return p;
}
fn pnum(v:i64)void {
    let s:[]u8 = _zag_i64_to_str(v);
    _zag_print(s);
    if(s.len>0){ _zag_free(_zag_slice_ptr(s)); }
}
fn main()i32 {
    let bad:i64 = 0 as i64;
    // P1: table-insert pattern
    let N:i32=200000;
    let a0:*i64=z64(N); let a1:*i64=z64(N); let a2:*i64=z64(N); let a3:*i64=z64(N);
    let i:i32=0;
    while(i<N){
        let slot:i32=(((i as i64)*2654435761 as i64)%(N as i64)) as i32;
        a0[slot]=(i as i64)*3 as i64+11 as i64;
        a1[slot]=(i as i64)%251 as i64;
        a2[slot]=1 as i64;
        a3[slot]=(i as i64)*0 as i64+(i as i64);
        i=i+1;
    }
    i=0;
    while(i<N){
        let slot:i32=(((i as i64)*2654435761 as i64)%(N as i64)) as i32;
        if(a0[slot]!=(i as i64)*3 as i64+11 as i64){ bad=bad+1; }
        if(a1[slot]!=(i as i64)%251 as i64){ bad=bad+1; }
        if(a2[slot]!=1 as i64){ bad=bad+1; }
        if(a3[slot]!=(i as i64)){ bad=bad+1; }
        i=i+1;
    }
    _zag_print("P1 bad="); pnum(bad); _zag_println("");
    // P2: 5 sequential stores
    let M:i32=100000;
    let b0:*i64=z64(M); let b1:*i64=z64(M); let b2:*i64=z64(M); let b3:*i64=z64(M); let b4:*i64=z64(M);
    i=0;
    while(i<M){
        b0[i]=(i as i64)*7 as i64;
        b1[i]=1000000 as i64-(i as i64);
        b2[i]=(i as i64)*(i as i64)%999983 as i64;
        b3[i]=0 as i64-(i as i64);
        b4[i]=(i as i64)^0x5f5f5f5f as i64;
        i=i+1;
    }
    i=0;
    while(i<M){
        if(b0[i]!=(i as i64)*7 as i64){ bad=bad+1; }
        if(b1[i]!=1000000 as i64-(i as i64)){ bad=bad+1; }
        if(b2[i]!=(i as i64)*(i as i64)%999983 as i64){ bad=bad+1; }
        if(b3[i]!=0 as i64-(i as i64)){ bad=bad+1; }
        if(b4[i]!=(i as i64)^0x5f5f5f5f as i64){ bad=bad+1; }
        i=i+1;
    }
    _zag_print("P2 bad="); pnum(bad); _zag_println("");
    // P3: mergesort tmp pattern (sequential tmp writes + copy-back), verify order
    let K:i32=65536;
    let kk:*i64=z64(K); let tt:*i64=z64(K);
    i=0;
    while(i<K){ kk[i]=((i*1103515245+12345)%1000000+1000000)%1000000 as i64; i=i+1; }
    // one bottom-up pass with width 1 (adjacent compare-swap into tmp, copy back)
    i=0;
    while(i<K-1){
        let x:i64=kk[i]; let y:i64=kk[i+1];
        if(y<x){ tt[i]=y; tt[i+1]=x; } else { tt[i]=x; tt[i+1]=y; }
        i=i+2;
    }
    if((K%2)==1){ tt[K-1]=kk[K-1]; }
    i=0; while(i<K){ kk[i]=tt[i]; i=i+1; }
    i=0;
    while(i<K-1){
        if(kk[i]>kk[i+1]){ bad=bad+1; }
        i=i+2;
    }
    _zag_print("P3 bad="); pnum(bad); _zag_println("");
    // P4: 8 sequential stores with negatives/extremes
    let c0:*i64=z64(8); let c1:*i64=z64(8); let c2:*i64=z64(8); let c3:*i64=z64(8);
    let c4:*i64=z64(8); let c5:*i64=z64(8); let c6:*i64=z64(8); let c7:*i64=z64(8);
    c0[0]=9223372036854775807 as i64;
    c1[0]=0 as i64-9223372036854775807 as i64-1 as i64;
    c2[0]=0 as i64-1 as i64;
    c3[0]=0 as i64;
    c4[0]=1 as i64;
    c5[0]=0 as i64-2147483648 as i64;
    c6[0]=2147483647 as i64;
    c7[0]=0 as i64-999 as i64;
    if(c0[0]!=9223372036854775807 as i64){ bad=bad+1; }
    if(c1[0]!=0 as i64-9223372036854775807 as i64-1 as i64){ bad=bad+1; }
    if(c2[0]!=0 as i64-1 as i64){ bad=bad+1; }
    if(c3[0]!=0 as i64){ bad=bad+1; }
    if(c4[0]!=1 as i64){ bad=bad+1; }
    if(c5[0]!=0 as i64-2147483648 as i64){ bad=bad+1; }
    if(c6[0]!=2147483647 as i64){ bad=bad+1; }
    if(c7[0]!=0 as i64-999 as i64){ bad=bad+1; }
    _zag_print("P4 bad="); pnum(bad); _zag_println("");
    if(bad==0 as i64){ _zag_println("STORE-PROBE PASS"); return 0; }
    _zag_println("STORE-PROBE FAIL");
    return 1;
}

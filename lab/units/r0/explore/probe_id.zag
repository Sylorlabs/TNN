// EXPLORE probe 2: adversarial span collisions + ID-layer attack surface.
// EXPLORATORY / NON-BINDING. Does not touch frozen bars. If pursued, it would
// amend A-24 (K2 collision-chain rules), A-47 (Y3 lineage/tombstone), and the
// A-4 chunk-ID-width unification item.
//
// Attacks tested:
//   (a) DEDUP-HONEST: same bytes added twice -> same slot. (baseline)
//   (b) COLLISION-FORCED: two DIFFERENT spans deliberately share one ID
//       (simulates a hash collision without needing to find one).
//       The store must chain + disambiguate by content, never silently alias.
//   (c) REVISE-TOMBSTONE: revise a span -> new ID; old ID tombstoned;
//       tombstoned ID is never re-issued to a later add.
//   (d) GHOST-ID SPOOF: an external reference presents a fully-tombstoned ID;
//       resolution must return TOMBSTONE, never live content, never dangling.
// Deterministic: fixed spans, no RNG. Run twice -> byte-identical.
//
// IDs here are 32-bit FNV-1a (non-negative i64 carrier); the mechanism
// (chain + disambiguate + tombstone) is width-orthogonal — A-4 stays open.
// TOOLCHAIN NOTE (ZNC-2026-09-19-001): []u8 storage + a32 cells throughout.

fn raw8(n:i32)[]u8 {
    let p:*u8=_zag_malloc(n as i64) as *u8;
    return p[0..n];
}
fn a32_set(b:[]u8,i:i32,v:i32)void {
    let w:i64=(v as i64)+2147483648;
    let o:i32=i*4;
    b[o]=(((w/16777216)%256) as u8);
    b[o+1]=(((w/65536)%256) as u8);
    b[o+2]=(((w/256)%256) as u8);
    b[o+3]=((w%256) as u8);
}
fn a32_get(b:[]u8,i:i32)i32 {
    let o:i32=i*4;
    let w:i64=(b[o] as i64)*16777216+(b[o+1] as i64)*65536+(b[o+2] as i64)*256+(b[o+3] as i64);
    return (w-2147483648) as i32;
}
fn tcheck(label:[]u8,ok:i32)void{ _zag_print(label);if(ok==1){_zag_println("PASS");}else{_zag_println("FAIL");} }

const CAP:i32=64;
const ARENA:i32=4096;
const ST_DEAD:i32=0; const ST_LIVE:i32=1; const ST_TOMB:i32=2;
const CHN_NONE:i32=255;

fn fnv1a32(seq:[]u8,start:i32,n:i32)i32 {
    let h:i64=2166136261;
    let i:i32=0;
    while(i<n){
        h=h ^ (seq[start+i] as i64);
        h=(h*16777619)%4294967296;
        i=i+1;
    }
    return h as i32;
}
// Compare arena bytes at `a` against incoming span seq[start..start+n].
fn content_equal(arena:[]u8,a:i32,seq:[]u8,start:i32,n:i32)i32 {
    let i:i32=0;
    while(i<n){if(arena[a+i]!=seq[start+i]){return 0;}i=i+1;}
    return 1;
}
// Store: ids(a32)/live(u8)/chn(u8,255=none)/off(a32)/ln(u8) parallel; arena bytes.
// Returns slot index, or -1 if full.
fn store_add(ids:[]u8,live:[]u8,chn:[]u8,off:[]u8,ln:[]u8,arena:[]u8,acount:*i32,
    seq:[]u8,start:i32,n:i32,force_id:i32,use_force:i32)i32 {
    let id:i32=fnv1a32(seq,start,n);
    if(use_force==1){id=force_id;}
    if(use_force==0){
        // Tombstone-forever: if this content id is tombstoned anywhere, remix
        // deterministically until it is not. Re-added bytes get a FRESH id;
        // the tombstone is never resurrected and never re-issued.
        let orig:i32=id;let attempt:i32=0;let clean:i32=0;
        while(clean==0){
            let t:i32=0;let clash:i32=0;
            while(t<CAP){
                if((live[t] as i32)==ST_TOMB && a32_get(ids,t)==id){clash=1;}
                t=t+1;
            }
            if(clash==0){clean=1;}
            else{attempt=attempt+1;id=orig ^ (attempt*2654435761);}
        }
    }
    let s:i32=0;let first:i32=-1;let prev:i32=-1;
    while(s<CAP){
        if((live[s] as i32)!=ST_DEAD && a32_get(ids,s)==id){
            if(first<0){first=s;}
            prev=s;
        }
        s=s+1;
    }
    if(first>=0){
        // disambiguate by content along the chain
        s=first;
        while(s!=CHN_NONE){
            if((live[s] as i32)==ST_LIVE && (ln[s] as i32)==n &&
               content_equal(arena,a32_get(off,s),seq,start,n)==1){return s;}
            s=chn[s] as i32;
        }
        // genuinely different content under same id -> counted collision: chain it
        let ns:i32=0;
        while(ns<CAP && (live[ns] as i32)!=ST_DEAD){ns=ns+1;}
        if(ns>=CAP){return -1;}
        a32_set(ids,ns,id);live[ns]=ST_LIVE as u8;ln[ns]=n as u8;
        a32_set(off,ns,acount.*);chn[ns]=CHN_NONE as u8;
        chn[prev]=ns as u8;
        let i:i32=0;while(i<n){arena[acount.*+i]=seq[start+i];i=i+1;}acount.*=acount.*+n;
        return ns;
    }
    // fresh id: tombstoned slots are not ST_DEAD -> never re-issued
    let ns2:i32=0;
    while(ns2<CAP && (live[ns2] as i32)!=ST_DEAD){ns2=ns2+1;}
    if(ns2>=CAP){return -1;}
    a32_set(ids,ns2,id);live[ns2]=ST_LIVE as u8;ln[ns2]=n as u8;
    a32_set(off,ns2,acount.*);chn[ns2]=CHN_NONE as u8;
    let j:i32=0;while(j<n){arena[acount.*+j]=seq[start+j];j=j+1;}acount.*=acount.*+n;
    return ns2;
}
fn store_revise(live:[]u8,slot:i32,ids:[]u8,ln:[]u8,off:[]u8,chn:[]u8,arena:[]u8,acount:*i32,
    seq:[]u8,start:i32,n:i32)i32 {
    live[slot]=ST_TOMB as u8;
    let ns:i32=0;
    while(ns<CAP && (live[ns] as i32)!=ST_DEAD){ns=ns+1;}
    if(ns>=CAP){return -1;}
    a32_set(ids,ns,fnv1a32(seq,start,n));live[ns]=ST_LIVE as u8;ln[ns]=n as u8;
    a32_set(off,ns,acount.*);chn[ns]=CHN_NONE as u8;
    let j:i32=0;while(j<n){arena[acount.*+j]=seq[start+j];j=j+1;}acount.*=acount.*+n;
    return ns;
}
// Resolve an external reference id -> 1 live content, 0 not found, 2 tombstoned.
fn store_resolve(ids:[]u8,live:[]u8,id:i32)i32 {
    let s:i32=0;let tomb_seen:i32=0;
    while(s<CAP){
        if(a32_get(ids,s)==id){
            if((live[s] as i32)==ST_LIVE){return 1;}
            if((live[s] as i32)==ST_TOMB){tomb_seen=1;}
        }
        s=s+1;
    }
    if(tomb_seen==1){return 2;}
    return 0;
}
fn chain_len(chn:[]u8,head:i32)i32 {
    let n:i32=0;let s:i32=head;
    while(s!=CHN_NONE){n=n+1;s=chn[s] as i32;}
    return n;
}

fn main()i32 {
    _zag_println("PROBE=id_collision_tombstone_ghost");
    let ids:[]u8=raw8(CAP*4);let live:[]u8=raw8(CAP);
    let chn:[]u8=raw8(CAP);let off:[]u8=raw8(CAP*4);let ln:[]u8=raw8(CAP);
    let arena:[]u8=raw8(ARENA);
    let s:i32=0;while(s<CAP){live[s]=ST_DEAD as u8;chn[s]=CHN_NONE as u8;s=s+1;}
    s=0;while(s<CAP*4){ids[s]=0;off[s]=0;s=s+1;}
    s=0;while(s<CAP){ln[s]=0;s=s+1;}
    s=0;while(s<ARENA){arena[s]=0;s=s+1;}
    let ac:i32=0;
    // "the quick fox"
    let t1:[]u8=raw8(13);
    t1[0]=116;t1[1]=104;t1[2]=101;t1[3]=32;t1[4]=113;t1[5]=117;t1[6]=105;t1[7]=99;t1[8]=107;t1[9]=32;t1[10]=102;t1[11]=111;t1[12]=120;
    // (a) dedup-honest
    let s1:i32=store_add(ids,live,chn,off,ln,arena,&ac,t1,0,13,0,0);
    let s2:i32=store_add(ids,live,chn,off,ln,arena,&ac,t1,0,13,0,0);
    let ok:i32=0;if(s1>=0 && s1==s2){ok=1;}
    tcheck("a_dedup_same_slot=",ok);
    // (b) forced collision: "THE QUICK FOX" differs in content; force t1's id
    let t2:[]u8=raw8(13);
    t2[0]=84;t2[1]=72;t2[2]=69;t2[3]=32;t2[4]=81;t2[5]=85;t2[6]=73;t2[7]=67;t2[8]=75;t2[9]=32;t2[10]=70;t2[11]=79;t2[12]=88;
    let s3:i32=store_add(ids,live,chn,off,ln,arena,&ac,t2,0,13,a32_get(ids,s1),1);
    ok=0;if(s3>=0 && s3!=s1){ok=1;}
    tcheck("b_collision_chained_new_slot=",ok);
    let cl:i32=chain_len(chn,s1);
    ok=0;if(cl>=2){ok=1;}
    tcheck("b_chain_len_ge_2=",ok);
    ok=0;if(store_resolve(ids,live,a32_get(ids,s1))==1){ok=1;}
    tcheck("b_resolve_finds_live=",ok);
    // (c) revise: change t1's bytes -> new id, old id tombstoned
    let t1b:[]u8=raw8(13);
    t1b[0]=116;t1b[1]=104;t1b[2]=101;t1b[3]=32;t1b[4]=113;t1b[5]=117;t1b[6]=105;t1b[7]=99;t1b[8]=107;t1b[9]=32;t1b[10]=100;t1b[11]=111;t1b[12]=103;
    let old_id:i32=a32_get(ids,s1);
    let s4:i32=store_revise(live,s1,ids,ln,off,chn,arena,&ac,t1b,0,13);
    ok=0;if(s4>=0 && s4!=s1){ok=1;}
    tcheck("c_revise_new_slot=",ok);
    ok=0;if((live[s1] as i32)==ST_TOMB){ok=1;}
    tcheck("c_old_tombstoned=",ok);
    ok=0;if(a32_get(ids,s4)!=old_id){ok=1;}
    tcheck("c_new_id_differs=",ok);
    // fresh span must NOT be issued the tombstoned id
    let t3:[]u8=raw8(4);t3[0]=106;t3[1]=117;t3[2]=110;t3[3]=107;
    let s5:i32=store_add(ids,live,chn,off,ln,arena,&ac,t3,0,4,0,0);
    ok=0;if(s5>=0 && a32_get(ids,s5)!=old_id){ok=1;}
    tcheck("c_tombstone_not_reissued=",ok);
    // (d) ghost-id spoof: tombstone the chain member too, then resolve old_id
    let t2b:[]u8=raw8(13);
    t2b[0]=84;t2b[1]=72;t2b[2]=69;t2b[3]=32;t2b[4]=83;t2b[5]=76;t2b[6]=79;t2b[7]=87;t2b[8]=32;t2b[9]=70;t2b[10]=79;t2b[11]=88;t2b[12]=33;
    let s6:i32=store_revise(live,s3,ids,ln,off,chn,arena,&ac,t2b,0,13);
    ok=0;if(s6>=0 && (live[s3] as i32)==ST_TOMB){ok=1;}
    tcheck("d_chain_member_tombstoned=",ok);
    let r:i32=store_resolve(ids,live,old_id);
    ok=0;if(r==2){ok=1;}
    tcheck("d_ghost_resolves_tombstone_not_live=",ok);
    // revision re-added content must NOT resurrect the tombstoned id either
    let s7:i32=store_add(ids,live,chn,off,ln,arena,&ac,t1,0,13,0,0);
    ok=0;if(s7>=0 && a32_get(ids,s7)!=old_id){ok=1;}
    tcheck("d_resurrect_gets_fresh_id=",ok);
    ok=0;if(store_resolve(ids,live,old_id)==2){ok=1;}
    tcheck("d_tombstone_survives_resurrect=",ok);
    let r2:i32=store_resolve(ids,live,old_id^123456789);
    ok=0;if(r2==0){ok=1;}
    tcheck("d_unknown_resolves_notfound=",ok);
    _zag_println("PROBE_DONE");
    return 0;
}

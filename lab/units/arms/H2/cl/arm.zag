// H2 — Budgeted deliberation (family CUT), Track A.
// "H1 under a compute cap (B evaluations per window); fallback to cheap
//  heuristic on budget exhaustion." (frozen §3 row, PREREG_FREEZE.md)
// Pure Zag. Zero RNG in any decision path. Byte-identical reruns.
// One binary; argv[1] selects the trial mode (see ARM_INTERFACE.md §3).
//
// FROZEN IMPLEMENTATION DECLARATION (r1):
//   Identical to H1 except the compute cap:
//   W=4096 (staging window bytes), C=16 (max candidates/window),
//   B=8 (max candidate EVALUATIONS per window, frozen), BAR=60 (commit
//   threshold, integer evidence points),
//   weights: separation=1, reuse=2, value=0, vocabulary=1.
//   Noticers (proposal-only, frozen priority): newline-run=4, structural
//   punctuation=3, sentence punctuation=2, 256-byte grid=1. Surplus candidates
//   dropped lowest-priority-first; ties broken by lowest position.
//   Candidates are EVALUATED in frozen priority order (no position re-sort).
//   When the budget of B evaluations is spent with candidates remaining, the
//   rest are refused in bulk (one OP_CUT_REFUSE with bulk=1) and the frontier
//   advances with the fallback coarse cut: a fixed MIDPOINT cut of the
//   remaining window region (the cheap heuristic), flagged F_FALLBACK.
//   Separation evidence = TRANS[left_class][right_class] at the cut point
//   (integer table below, validated against the design prototype).
//   Reuse evidence = +10 raw iff the candidate span exactly matches a live
//   store span (dedup hit); value evidence frozen at 0 for r1 (weight 0);
//   vocabulary evidence = +20 raw iff the candidate span exactly matches a
//   pinned chunk's span (taught/pinned alignment; dormant in r1 battery).
//   Score = 1*sep + 2*reuse + 0*value + 1*vocab; commit iff score >= BAR,
//   else OP_CUT_REFUSE. Window tail (if frontier did not reach window end)
//   is emitted as one coarse fallback chunk (OP_CUT_COMMIT with fallback=1).
// BINDING KILL (frozen): reuse advantage over baseline < 5 absolute points,
//   OR fallback rate on corpus B > 40% of windows — the budget destroys the
//   deliberation.
// PROVISIONAL (pending freeze): H2 is provisionally an ID arm; the M1
//   64-remap (swap) probe follows ARM_INTERFACE.md §9 / AMBIGUITIES.md A15
//   literally and is labelled PROVISIONAL-PENDING-FREEZE.
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const H2_W:i32=4096;
const H2_C:i32=16;
const H2_B:i32=8;                // frozen: max candidate EVALUATIONS per window
const H2_BAR:i32=60;
const H2_WSEP:i32=1;
const H2_WREUSE:i32=2;
const H2_WVALUE:i32=0;
const H2_WVOCAB:i32=1;
const H2_REUSE_HIT:i32=10;   // raw reuse evidence on exact live-span match
const H2_VOCAB_HIT:i32=20;   // raw vocab evidence on pinned-span match

const H2_C_PROSE:i32=1;
const H2_C_CODE:i32=2;
const H2_C_T1P:i32=3;
const H2_C_T1C:i32=4;
const H2_C_T2P:i32=5;
const H2_C_T2C:i32=6;
const H2_C_T3:i32=7;
const H2_C_FRESH:i32=8;

// audit opcodes (frozen; see ARM_INTERFACE.md §9)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_EVICT:i32=5;
const OP_DEFECT:i32=6;
const OP_REVISE:i32=7;
const OP_REFUSE:i32=8;
const OP_CUT_PROPOSE:i32=9;
const OP_CUT_COMMIT:i32=10;
const OP_CUT_REFUSE:i32=11;
const OP_VAL:i32=12;               // mark valuable (trainer_mark_valuable)
const OP_SWAP_PROBE:i32=19;        // 0x13 TRAINER_SWAP_PROBE (A15, provisional)

// byte classes for the separation table
// 0=ALNUM [0-9A-Za-z], 1=SPACE (32,9,13), 2=NL (10), 3=PUNCT (else)
fn h2_trans(a:i32,b:i32)i32 {
    if(a==0){
        if(b==0){return -50;}
        if(b==1){return 40;}
        if(b==2){return 110;}
        return 60;
    }
    if(a==1){
        if(b==0){return 80;}
        if(b==1){return 0;}
        if(b==2){return 110;}
        return 30;
    }
    if(a==2){return 120;}
    if(b==0){return 100;}
    if(b==1){return 40;}
    if(b==2){return 110;}
    return 20;
}
fn h2_bclass(b:u8)i32 {
    let c:i32=b as i32;
    if(c>=48 && c<=57){return 0;}
    if(c>=65 && c<=90){return 0;}
    if(c>=97 && c<=122){return 0;}
    if(c==32 || c==9 || c==13){return 1;}
    if(c==10){return 2;}
    return 3;
}

// ---- file IO (harness fixtures) ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    // nio_write_all caps at 1MB per call: chunk the write.
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
fn write_hex_line(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    // "<tag> <hex>\n"
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;
    while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[i]=32;i=i+1;
    let j:i32=0;
    while(j<hx.len){line[i]=hx[j];i=i+1;j=j+1;}
    line[i]=10;i=i+1;
    let r:i32=write_file(dir,fname,line[0..i]);
    nio_free(hx);nio_free(line);
    return r;
}
// corpus registry: corpus id -> (base,len) in the concatenated buffer
fn reg_set(coffs:[]u8,clens:[]u8,corpus:i32,base:i32,len:i32) void {
    iput(coffs,corpus*4,base);
    iput(clens,corpus*4,len);
}

// ---- JSON emission (schema metrics-v1; exact harness format) ----
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"h2\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    // print integer tenths-of-a-percent as one-decimal, e.g. 1000 -> 100.0
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);
    _zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);
    _zag_print(s2);nio_free(s2);
}
fn p_i64(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);nio_free(s);
}
fn jf_int(f:*i32,name:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(name);_zag_print("\":");p_i64(v);
}
fn jf_bool(f:*i32,name:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(name);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_dec1(f:*i32,name:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(name);_zag_print("\":");p_dec1(tenths);
}
fn jf_str(f:*i32,name:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(name);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_null(f:*i32,name:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(name);_zag_print("\":null");
}

// ================= H2 store =================
// Packed byte arrays (see AGENTS.md: slice fields are 16B; alias before
// indexing; never name a fn zalloc). All multibyte integers are LE i32/i64.
struct H2 {
    // slot arrays (7 × cap × 4B)
    ids:[]u8, corps:[]u8, offs:[]u8, lens:[]u8,
    flags:[]u8, shifts:[]u8, pidx:[]u8,
    // dedup: span-key -> slot  (ddk: keys i64, ddv: slots i32)
    ddk:[]u8, ddv:[]u8,
    // id -> slot (iddk: ids i32, iddv: slots i32)
    iddk:[]u8, iddv:[]u8,
    // pins: chunk id -> 1
    pink:[]u8, pinv:[]u8,
    // defects: chunk id -> (kind, orig_off, orig_len, patch_pos, patch_xor)
    dfk:[]u8, dfd:[]u8,
    // audit ledger: 64B entries; retained buffer or stream digest
    led:[]u8, led_cap:i32, led_n:i32,
    led_stream:i32, led_digest:[]u8,
    // allocation trace
    trace:[]u8, trace_n:i32, trace_cap:i32,
    // counters / clock
    cap:i32, nlive:i32, next_id:i32,
    dcap:i32, dn:i32,
    pcap:i32, pn:i32,
    dfcap:i32, dfn:i32,
    clock:i64,
    // deliberation accounting
    delib_ops:i64, delib_cuts:i64, delib_ref:i64, delib_cand:i64,
    sens_flips:i64, sens_cands:i64,
    // H2 budget accounting (frozen B=8/window)
    win_n:i64,          // windows processed
    fallback_win:i64,   // windows where the budget was exhausted (midpoint fallback)
    bulk_ref:i64,       // candidates refused in bulk after budget exhaustion
}
// slot flag bits
const F_LIVE:i32=1;
const F_PIN:i32=2;
const F_FALLBACK:i32=4;

fn h2_new(cap:i32,dcap:i32,led_cap:i32,led_stream:i32) H2 {
    // (ZNC-2026-09-21-004: no bare `let s:H2;` — use a full literal.)
    let s:H2=H2{.ids="",.corps="",.offs="",.lens="",.flags="",.shifts="",.pidx="",
        .ddk="",.ddv="",.iddk="",.iddv="",.pink="",.pinv="",.dfk="",.dfd="",
        .led="",.led_cap=0,.led_n=0,.led_stream=0,.led_digest="",
        .trace="",.trace_n=0,.trace_cap=0,
        .cap=0,.nlive=0,.next_id=0,.dcap=0,.dn=0,.pcap=0,.pn=0,.dfcap=0,.dfn=0,
        .clock=0,.delib_ops=0,.delib_cuts=0,.delib_ref=0,.delib_cand=0,
        .sens_flips=0,.sens_cands=0,
        .win_n=0,.fallback_win=0,.bulk_ref=0};
    s.cap=cap; s.nlive=0; s.next_id=1;
    s.dcap=dcap; s.dn=0;
    s.pcap=4096; s.pn=0;
    s.dfcap=4096; s.dfn=0;
    s.led_cap=led_cap; s.led_n=0; s.led_stream=led_stream;
    s.clock=0;
    s.delib_ops=0; s.delib_cuts=0; s.delib_ref=0; s.delib_cand=0;
    s.sens_flips=0; s.sens_cands=0;
    s.win_n=0; s.fallback_win=0; s.bulk_ref=0;
    // bootstrap: allocate the trace buffer raw (halloc would trace into it
    // before it exists). The trace records every subsequent halloc.
    s.trace_cap=8192; s.trace_n=0;
    s.trace=nio_alloc(8192);
    // traced allocations (every halloc appends "A <size>\n" to the trace)
    s.ids=halloc(&s,cap*4); s.corps=halloc(&s,cap*4);
    s.offs=halloc(&s,cap*4); s.lens=halloc(&s,cap*4);
    s.flags=halloc(&s,cap*4); s.shifts=halloc(&s,cap*4);
    s.pidx=halloc(&s,cap*4);
    s.ddk=halloc(&s,dcap*8); s.ddv=halloc(&s,dcap*4);
    s.iddk=halloc(&s,dcap*4); s.iddv=halloc(&s,dcap*4);
    s.pink=halloc(&s,s.pcap*4); s.pinv=halloc(&s,s.pcap*4);
    s.dfk=halloc(&s,s.dfcap*4); s.dfd=halloc(&s,s.dfcap*20);
    if(led_stream==0){ s.led=halloc(&s,led_cap*64); } else { s.led=""; }
    s.led_digest=halloc(&s,32);
    // zero tables (deterministic initial state)
    h2_zero(s.ddk); h2_zero(s.ddv);
    h2_zero(s.iddk); h2_zero(s.iddv);
    h2_zero(s.pink); h2_zero(s.pinv);
    h2_zero(s.dfk); h2_zero(s.dfd);
    h2_zero(s.led_digest);
    h2_zero(s.ids); h2_zero(s.corps); h2_zero(s.offs); h2_zero(s.lens);
    h2_zero(s.flags); h2_zero(s.shifts); h2_zero(s.pidx);
    return s;
}
fn h2_zero(b:[]u8) void {
    let i:i32=0;
    while(i<b.len){ b[i]=0; i=i+1; }
}
// ---- allocation with trace ----
fn halloc(s:*H2,n:i32) []u8 {
    let b:[]u8=nio_alloc(n);
    // trace "A <n>\n" (sizes only: perturbation-agnostic)
    let tr:[]u8=s.trace;
    let at:i32=s.trace_n;
    if(at+16 < s.trace_cap){
        tr[at]=65; at=at+1; tr[at]=32; at=at+1;
        at=h2_put_dec(tr,at,n as i64);
        tr[at]=10; at=at+1;
        s.trace_n=at;
    }
    return b;
}
fn hfree(s:*H2,b:[]u8) void {
    let tr:[]u8=s.trace;
    let at:i32=s.trace_n;
    if(at+16 < s.trace_cap){
        tr[at]=70; at=at+1; tr[at]=32; at=at+1;
        at=h2_put_dec(tr,at,b.len as i64);
        tr[at]=10; at=at+1;
        s.trace_n=at;
    }
    nio_free(b);
}
fn h2_put_dec(tr:[]u8,at:i32,v:i64) i32 {
    // write decimal v at tr[at..]; return new at. v>=0.
    let tmp:[]u8=nio_alloc(24);
    let n:i32=0;
    if(v==0){ tmp[0]=48; n=1; }
    else{
        while(v>0){ tmp[n]=(48+(v%10)) as u8; n=n+1; v=v/10; }
    }
    let i:i32=n-1;
    while(i>=0){ tr[at]=tmp[i]; at=at+1; i=i-1; }
    nio_free(tmp);
    return at;
}
// ---- audit ledger: 16 words × 4B = 64B entries ----
// layout: op@0, slot@4, rc@8, b1..b5@12..28, a1..a5@32..48, stage@52, d1@56, d2@60
fn h2_led(s:*H2,op:i32,slot:i32,rc:i32,
          b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
          a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,
          stage:i32,d1:i32,d2:i32) void {
    if(s.led_stream==1){
        // stream: fold the 64B entry into the running digest (sha256 chain)
        let e:[]u8=nio_alloc(64);
        iput(e,0,op); iput(e,4,slot); iput(e,8,rc);
        iput(e,12,b1); iput(e,16,b2); iput(e,20,b3); iput(e,24,b4); iput(e,28,b5);
        iput(e,32,a1); iput(e,36,a2); iput(e,40,a3); iput(e,44,a4); iput(e,48,a5);
        iput(e,52,stage); iput(e,56,d1); iput(e,60,d2);
        let combo:[]u8=nio_alloc(96);
        let i:i32=0;
        while(i<32){ combo[i]=s.led_digest[i]; i=i+1; }
        i=0;
        while(i<64){ combo[32+i]=e[i]; i=i+1; }
        ns_sha256(combo,s.led_digest);
        nio_free(e); nio_free(combo);
        s.led_n=s.led_n+1;
        s.clock=s.clock+1;
        return;
    }
    if(s.led_n >= s.led_cap){ return; }  // retained cap: drop (counted in tests)
    let led:[]u8=s.led;
    let at:i32=s.led_n*64;
    iput(led,at+0,op); iput(led,at+4,slot); iput(led,at+8,rc);
    iput(led,at+12,b1); iput(led,at+16,b2); iput(led,at+20,b3);
    iput(led,at+24,b4); iput(led,at+28,b5);
    iput(led,at+32,a1); iput(led,at+36,a2); iput(led,at+40,a3);
    iput(led,at+44,a4); iput(led,at+48,a5);
    iput(led,at+52,stage); iput(led,at+56,d1); iput(led,at+60,d2);
    s.led_n=s.led_n+1;
    s.clock=s.clock+1;
}
// ---- hash tables (open addressing, linear probe; key -1/0 = empty sentinel
// for i32 keys; id 0 never issued) ----
fn dd_hash(key:i64,dcap:i32) i32 {
    let h:i64=key % (dcap as i64);
    if(h<0){ h=h+(dcap as i64); }
    return h as i32;
}
// dedup: span key (i64) -> slot
fn dd_find(s:*H2,key:i64) i32 {
    let k:[]u8=s.ddk; let v:[]u8=s.ddv;
    let h:i32=dd_hash(key,s.dcap);
    let i:i32=0;
    while(i<s.dcap){
        let at:i32=(h+i)%s.dcap;
        let kk:i64=i64get(k,at*8);
        if(kk==key){ return iget(v,at*4); }
        if(kk==0){ return -1; }
        i=i+1;
    }
    return -1;
}
fn dd_put(s:*H2,key:i64,slot:i32) void {
    let k:[]u8=s.ddk; let v:[]u8=s.ddv;
    let h:i32=dd_hash(key,s.dcap);
    let i:i32=0;
    while(i<s.dcap){
        let at:i32=(h+i)%s.dcap;
        let kk:i64=i64get(k,at*8);
        if(kk==0 || kk==key){
            i64put(k,at*8,key); iput(v,at*4,slot);
            if(kk==0){ s.dn=s.dn+1; }
            return;
        }
        i=i+1;
    }
}
// id -> slot
fn idd_find(s:*H2,id:i32) i32 {
    let k:[]u8=s.iddk; let v:[]u8=s.iddv;
    let h:i32=(id % s.dcap + s.dcap) % s.dcap;
    let i:i32=0;
    while(i<s.dcap){
        let at:i32=(h+i)%s.dcap;
        let kk:i32=iget(k,at*4);
        if(kk==id){ return iget(v,at*4); }
        if(kk==0){ return -1; }
        i=i+1;
    }
    return -1;
}
fn idd_put(s:*H2,id:i32,slot:i32) void {
    let k:[]u8=s.iddk; let v:[]u8=s.iddv;
    let h:i32=(id % s.dcap + s.dcap) % s.dcap;
    let i:i32=0;
    while(i<s.dcap){
        let at:i32=(h+i)%s.dcap;
        let kk:i32=iget(k,at*4);
        if(kk==0 || kk==id){ iput(k,at*4,id); iput(v,at*4,slot); return; }
        i=i+1;
    }
}
// pins: chunk id -> 1 (linear; pcap=4096)
fn pin_find(s:*H2,id:i32) i32 {
    let k:[]u8=s.pink;
    let i:i32=0;
    while(i<s.pn){ if(iget(k,i*4)==id){ return 1; } i=i+1; }
    return 0;
}
fn pin_put(s:*H2,id:i32) void {
    if(pin_find(s,id)==1){ return; }
    if(s.pn < s.pcap){
        iput(s.pink,s.pn*4,id); iput(s.pinv,s.pn*4,1);
        s.pn=s.pn+1;
    }
}
// defects: chunk id -> (kind, orig_off, orig_len, patch_pos, patch_xor)
// kind 1=boundary (span shifted; orig_* = pre-defect span),
// kind 2=content (span intact; patch applied at recall).
fn df_find(s:*H2,id:i32) i32 {
    let k:[]u8=s.dfk;
    let i:i32=0;
    while(i<s.dfn){ if(iget(k,i*4)==id){ return i; } i=i+1; }
    return -1;
}
fn df_put(s:*H2,id:i32,kind:i32,ooff:i32,olen:i32,ppos:i32,pxor:i32) void {
    let di:i32=df_find(s,id);
    if(di<0){
        if(s.dfn>=s.dfcap){ return; }
        di=s.dfn; s.dfn=s.dfn+1;
        iput(s.dfk,di*4,id);
    }
    let d:[]u8=s.dfd;
    iput(d,di*20+0,kind); iput(d,di*20+4,ooff); iput(d,di*20+8,olen);
    iput(d,di*20+12,ppos); iput(d,di*20+16,pxor);
}
fn df_clear(s:*H2,id:i32) void {
    let di:i32=df_find(s,id);
    if(di<0){ return; }
    // swap-with-last (deterministic)
    let last:i32=s.dfn-1;
    if(di!=last){
        iput(s.dfk,di*4,iget(s.dfk,last*4));
        let d:[]u8=s.dfd;
        let e:i32=0;
        while(e<5){ iput(d,di*20+e*4,iget(d,last*20+e*4)); e=e+1; }
    }
    s.dfn=s.dfn-1;
}
// span key: (corpus<<36)|(off<<12)|len  [off<2^24, len<2^12]
fn span_key(cid:i32,off:i32,len:i32) i64 {
    return ((cid as i64)<<36) | ((off as i64)<<12) | (len as i64);
}

// ---- little-endian packing on []u8 ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }
fn i64get(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24)
         +((b[at+4] as i64)<<32)+((b[at+5] as i64)<<40)+((b[at+6] as i64)<<48)+((b[at+7] as i64)<<56);
}
fn i64put(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
    b[at+4]=((v>>32) & 255) as u8;b[at+5]=((v>>40) & 255) as u8;
    b[at+6]=((v>>48) & 255) as u8;b[at+7]=((v>>56) & 255) as u8;
}

// ================= inspect / propose / commit =================
// h2_window: one staging window [w,we) of buf (length n, corpus cid).
// Nominates candidates with the frozen noticers (mask: bit0=NL,1=sent,
// 2=struct,3=grid; 0xF=all), dedupes by position (keep max priority),
// selects top H2_C by (-priority, position), then walks them in position
// order scoring each: score=1*sep+2*reuse+0*value+1*vocab.
// Commits score>=H2_BAR (OP_CUT_COMMIT), else OP_CUT_REFUSE. Tail fallback.
// Appends committed chunk IDs at cids[cstart..]; returns new count.
// If dry!=0, only records spans at spans[] (no commit, no logging).
fn h2_window(s:*H2,buf:[]u8,w:i32,we:i32,n:i32,cid:i32,mask:i32,
             cids:[]u8,cstart:i32,spans:[]u8,dry:i32) i32 {
    // nomination buffers (packed i32)
    let npos:[]u8=nio_alloc(256*4);
    let nprio:[]u8=nio_alloc(256*4);
    let nn:i32=0;
    // --- noticers scan [w,we) ---
    let p:i32=w;
    while(p<we){
        let b:u8=buf[p];
        if((mask & 1)!=0 && b==10){
            let q:i32=p;
            while(q<we && buf[q]==10){ q=q+1; s.delib_ops=s.delib_ops+1; }
            // nominate cut after the NL run (priority 4)
            nn=h2_nominate(npos,nprio,nn,q,4);
            p=q;
        } else {
            if((mask & 2)!=0 && (b==46 || b==33 || b==63 || b==59 || b==58)){
                nn=h2_nominate(npos,nprio,nn,p+1,2);   // . ! ? ; :
            } else {
                if((mask & 4)!=0 && (b==123 || b==125 || b==40 || b==41 || b==91 || b==93)){
                    nn=h2_nominate(npos,nprio,nn,p+1,3); // { } ( ) [ ]
                }
            }
            p=p+1;
        }
        s.delib_ops=s.delib_ops+1;
    }
    if((mask & 8)!=0){
        let g:i32=w+256;
        while(g<we){ nn=h2_nominate(npos,nprio,nn,g,1); g=g+256; }
    }
    // --- select top H2_C by (-prio, pos): 16 greedy picks ---
    let spos:[]u8=nio_alloc(16*4);
    let used:[]u8=nio_alloc(256*4);
    h2_zero(used);
    let ns:i32=0;
    let r:i32=0;
    while(r<H2_C && ns<nn){
        let best:i32=-1; let bestp:i32=-1; let bestpos:i32=0;
        let i:i32=0;
        while(i<nn){
            if(iget(used,i*4)==0){
                let pr:i32=iget(nprio,i*4); let ps:i32=iget(npos,i*4);
                if(pr>bestp || (pr==bestp && (best<0 || ps<bestpos))){
                    best=i; bestp=pr; bestpos=ps;
                }
            }
            i=i+1;
        }
        if(best<0){ break; }
        iput(used,best*4,1);
        iput(spos,ns*4,bestpos);
        ns=ns+1; r=r+1;
    }
    // spos[] is already in frozen priority order (greedy (-prio,pos) picks);
    // the declaration evaluates candidates in that order — NO position re-sort.
    s.win_n=s.win_n+1;
    // --- frontier walk: at most H2_B evaluations per window ---
    let frontier:i32=w;
    let cnt:i32=cstart;
    let si:i32=0;
    let evaled:i32=0;
    let exhausted:i32=0;
    while(si<ns){
        let pp:i32=iget(spos,si*4);
        si=si+1;
        if(pp<=frontier || pp>we){ continue; }   // not evaluable; costs no budget
        if(evaled>=H2_B){ exhausted=1; break; }
        s.delib_cand=s.delib_cand+1;
        evaled=evaled+1;
        let ca:i32=h2_bclass(buf[pp-1]);
        let cb:i32=1;
        if(pp<n){ cb=h2_bclass(buf[pp]); }
        let sep:i32=h2_trans(ca,cb);
        // reuse evidence: exact live-span match in store
        let reuse:i32=0;
        if(dry==0){
            let rk:i64=span_key(cid,frontier,pp-frontier);
            let rsl:i32=dd_find(s,rk);
            if(rsl>=0 && (iget(s.flags,rsl*4) & F_LIVE)!=0){ reuse=H2_REUSE_HIT; }
        }
        // value evidence: frozen 0 for r1
        let value:i32=0;
        // vocabulary evidence: exact pinned-span match
        let vocab:i32=0;
        if(dry==0){ vocab=h2_vocab_check(s,cid,frontier,pp-frontier); }
        let score:i32=H2_WSEP*sep+H2_WREUSE*reuse+H2_WVALUE*value+H2_WVOCAB*vocab;
        s.delib_ops=s.delib_ops+6;  // 4 evidence + score + BAR compare
        // BAR ±10% sensitivity (integer bars 54/66)
        s.sens_cands=s.sens_cands+1;
        let d0:i32=0; if(score>=H2_BAR){d0=1;}
        let d1:i32=0; if(score>=54){d1=1;}
        let d2:i32=0; if(score>=66){d2=1;}
        if(d0!=d1 || d0!=d2){ s.sens_flips=s.sens_flips+1; }
        if(dry!=0){
            // dry: record the span that WOULD be committed (for V selection)
            if(d0==1){
                iput(spans,cnt*8,frontier); iput(spans,cnt*8+4,pp-frontier);
                cnt=cnt+1; frontier=pp;
            }
            continue;
        }
        h2_led(s,OP_CUT_PROPOSE,-1,d0,frontier,pp-frontier,sep,reuse,vocab,cid,score,0,0,0,0,pp,0);
        if(d0==1){
            let id:i32=h2_commit_span(s,cid,frontier,pp-frontier,0);
            if(id>0){ iput(cids,cnt*4,id); cnt=cnt+1; }
            s.delib_cuts=s.delib_cuts+1;
            frontier=pp;
        } else {
            s.delib_ref=s.delib_ref+1;
            h2_led(s,OP_CUT_REFUSE,-1,0,frontier,pp-frontier,sep,reuse,vocab,cid,score,0,0,0,0,pp,0);
        }
    }
    if(exhausted==1){
        // Budget spent with candidates remaining: one bulk OP_CUT_REFUSE
        // (rc=1 marks bulk; a2 = number of never-evaluated candidates) and the
        // frontier advances with the fallback coarse cut: fixed MIDPOINT of the
        // remaining [frontier,we) region, flagged F_FALLBACK. Counts one
        // fallback window (binding-kill numerator; denominator = s.win_n).
        let rem:i32=ns-si+1;
        if(rem<0){rem=0;}
        if(dry==0){
            h2_led(s,OP_CUT_REFUSE,-1,1,frontier,we-frontier,0,0,0,cid,rem,0,0,0,frontier,0,0);
            s.bulk_ref=s.bulk_ref+(rem as i64);
        }
        let mid:i32=frontier+(we-frontier)/2;
        if(mid>frontier){
            if(dry!=0){
                iput(spans,cnt*8,frontier); iput(spans,cnt*8+4,mid-frontier);
                cnt=cnt+1;
            } else {
                let fid:i32=h2_commit_span(s,cid,frontier,mid-frontier,1);
                if(fid>0){ iput(cids,cnt*4,fid); cnt=cnt+1; }
                s.delib_cuts=s.delib_cuts+1;
            }
        }
        s.fallback_win=s.fallback_win+1;
        frontier=mid;
    }
    if(frontier<we){
        if(dry!=0){
            iput(spans,cnt*8,frontier); iput(spans,cnt*8+4,we-frontier);
            cnt=cnt+1;
        } else {
            let id:i32=h2_commit_span(s,cid,frontier,we-frontier,1);
            if(id>0){ iput(cids,cnt*4,id); cnt=cnt+1; }
            s.delib_cuts=s.delib_cuts+1;
        }
    }
    nio_free(npos); nio_free(nprio); nio_free(spos); nio_free(used);
    return cnt;
}
fn h2_nominate(npos:[]u8,nprio:[]u8,nn:i32,pos:i32,prio:i32) i32 {
    // dedupe by position, keep max priority
    let i:i32=0;
    while(i<nn){
        if(iget(npos,i*4)==pos){
            if(prio>iget(nprio,i*4)){ iput(nprio,i*4,prio); }
            return nn;
        }
        i=i+1;
    }
    if(nn<256){ iput(npos,nn*4,pos); iput(nprio,nn*4,prio); return nn+1; }
    return nn;
}
fn h2_vocab_check(s:*H2,cid:i32,off:i32,len:i32) i32 {
    // +H2_VOCAB_HIT iff (cid,off,len) exactly matches a pinned chunk's span
    let k:i32=0;
    while(k<s.pn){
        let pid:i32=iget(s.pink,k*4);
        let sl:i32=idd_find(s,pid);
        if(sl>=0 && (iget(s.flags,sl*4) & F_LIVE)!=0){
            if(iget(s.corps,sl*4)==cid && iget(s.offs,sl*4)==off && iget(s.lens,sl*4)==len){
                return H2_VOCAB_HIT;
            }
        }
        k=k+1;
    }
    return 0;
}
// commit a span: dedup-hit revives (OP_ADD rc=1), else new slot.
// Returns chunk id (>0), or -1 on audited refusal (store full and nothing evictable).
fn h2_commit_span(s:*H2,cid:i32,off:i32,len:i32,fallback:i32) i32 {
    let key:i64=span_key(cid,off,len);
    let sl:i32=dd_find(s,key);
    if(sl>=0 && (iget(s.flags,sl*4) & F_LIVE)!=0){
        let id:i32=iget(s.ids,sl*4);
        h2_led(s,OP_ADD,sl,1,off,0,len,cid,id,fallback,0,0,0,0,0,id,0);
        return id;
    }
    sl=h2_alloc_slot(s);
    if(sl<0){
        h2_led(s,OP_REFUSE,-1,1,off,0,len,cid,0,fallback,0,0,0,0,0,103,0);
        return -1;
    }
    let id:i32=s.next_id; s.next_id=s.next_id+1;
    iput(s.ids,sl*4,id); iput(s.corps,sl*4,cid);
    iput(s.offs,sl*4,off); iput(s.lens,sl*4,len);
    let fl:i32=F_LIVE;
    if(fallback==1){ fl=fl|F_FALLBACK; }
    iput(s.flags,sl*4,fl);
    iput(s.shifts,sl*4,0); iput(s.pidx,sl*4,sl);
    dd_put(s,key,sl);
    idd_put(s,id,sl);
    h2_led(s,OP_ADD,sl,0,off,0,len,cid,id,fallback,0,0,0,0,0,id,0);
    return id;
}
fn h2_alloc_slot(s:*H2) i32 {
    // 1. reuse a dead slot (lowest index); 2. append; 3. evict weakest
    let i:i32=0;
    while(i<s.nlive){
        if((iget(s.flags,i*4) & F_LIVE)==0){ return i; }
        i=i+1;
    }
    if(s.nlive < s.cap){
        let sl:i32=s.nlive; s.nlive=s.nlive+1;
        return sl;
    }
    return h2_evict_weakest(s);
}
// weakest-first eviction: min strength among live non-pinned; tie -> oldest
// insertion (lowest slot index). Strength: valuable=2, normal=1, dead=0.
// Returns victim slot, or -1 if everything is pinned.
fn h2_evict_weakest(s:*H2) i32 {
    let best:i32=-1; let bestst:i32=99;
    let i:i32=0;
    while(i<s.nlive){
        let fl:i32=iget(s.flags,i*4);
        if((fl & F_LIVE)!=0 && (fl & F_PIN)==0){
            let st:i32=1;
            if((fl & 8)!=0){ st=2; }  // F_VAL=8: marked valuable
            if(st<bestst){ bestst=st; best=i; }
        }
        i=i+1;
    }
    if(best<0){ return -1; }
    let vid:i32=iget(s.ids,best*4);
    h2_led(s,OP_EVICT,best,0,iget(s.offs,best*4),0,iget(s.lens,best*4),
           iget(s.corps,best*4),vid,0,0,0,0,0,0,vid,0);
    // invalidate dedup/id mappings (stale entries fail the liveness check)
    iput(s.flags,best*4,0);
    return best;
}
// ---- ingest: window loop over buf; returns chunk count; cids[i] = chunk id ----
fn h2_ingest(s:*H2,buf:[]u8,cid:i32,cids:[]u8,mask:i32) i32 {
    let n:i32=buf.len;
    let cnt:i32=0;
    let w:i32=0;
    let spans:[]u8="";
    while(w<n){
        let we:i32=w+H2_W;
        if(we>n){ we=n; }
        cnt=h2_window(s,buf,w,we,n,cid,mask,cids,cnt,spans,0);
        w=we;
    }
    return cnt;
}
// dry segmentation: returns span count; spans[i]=(off,len); no store effect
fn h2_segment_dry(s:*H2,buf:[]u8,cid:i32,spans:[]u8) i32 {
    let n:i32=buf.len;
    let cnt:i32=0;
    let w:i32=0;
    let cids:[]u8="";
    while(w<n){
        let we:i32=w+H2_W;
        if(we>n){ we=n; }
        cnt=h2_window(s,buf,w,we,n,cid,15,cids,cnt,spans,1);
        w=we;
    }
    return cnt;
}

const F_VAL:i32=8;   // marked valuable (strength 2)

// ---- recall ----
// recall slot sl into out (caller-sized); applies recorded content patch.
// Returns bytes written, or -1 if slot dead/empty.
fn h2_recall_slot(s:*H2,sl:i32,cbufs:[]u8,creg:[]u8,out:[]u8) i32 {
    if(sl<0 || sl>=s.nlive){ return -1; }
    let flags:[]u8=s.flags;
    if((iget(flags,sl*4) & F_LIVE)==0){ return -1; }
    let cid:i32=iget(s.corps,sl*4);
    let base:i32=iget(creg,cid*4);
    let off:i32=iget(s.offs,sl*4);
    let len:i32=iget(s.lens,sl*4);
    let id:i32=iget(s.ids,sl*4);
    let i:i32=0;
    while(i<len){ out[i]=cbufs[base+off+i]; i=i+1; }
    // recorded content patch (defect kind 2)
    let di:i32=df_find(s,id);
    if(di>=0){
        let d:[]u8=s.dfd;
        if(iget(d,di*20)==2){
            let pp:i32=iget(d,di*20+12);
            if(pp>=0 && pp<len){ out[pp]=(out[pp] as i32 ^ iget(d,di*20+16)) as u8; }
        }
    }
    return len;
}
fn h2_recall_by_id(s:*H2,id:i32,cbufs:[]u8,creg:[]u8,out:[]u8) i32 {
    let sl:i32=idd_find(s,id);
    return h2_recall_slot(s,sl,cbufs,creg,out);
}
// source-exact check of one chunk id against its corpus bytes
fn h2_verify(s:*H2,id:i32,cbufs:[]u8,creg:[]u8,tmp:[]u8) i32 {
    let sl:i32=idd_find(s,id);
    if(sl<0){ return 0; }
    let rl:i32=h2_recall_slot(s,sl,cbufs,creg,tmp);
    if(rl<=0){ return 0; }
    let cid:i32=iget(s.corps,sl*4);
    let base:i32=iget(creg,cid*4);
    let off:i32=iget(s.offs,sl*4);
    let i:i32=0;
    while(i<rl){
        if(tmp[i]!=cbufs[base+off+i]){ return 0; }
        i=i+1;
    }
    // boundary: claimed span == recorded span (recall used the record)
    return 1;
}

// ---- management ops ----
fn h2_kill(s:*H2,id:i32,reason:i32) void {
    let sl:i32=idd_find(s,id);
    if(sl<0){ return; }
    let fl:i32=iget(s.flags,sl*4);
    if((fl & F_LIVE)==0){ return; }
    iput(s.flags,sl*4,fl & (F_PIN|F_FALLBACK|F_VAL));  // clear LIVE
    h2_led(s,OP_KILL,sl,reason,iget(s.offs,sl*4),0,iget(s.lens,sl*4),
           iget(s.corps,sl*4),id,0,0,0,0,0,0,id,0);
}
fn h2_pin(s:*H2,id:i32) void {
    let sl:i32=idd_find(s,id);
    if(sl<0){ return; }
    iput(s.flags,sl*4,iget(s.flags,sl*4)|F_PIN);
    pin_put(s,id);
    h2_led(s,OP_PIN,sl,0,iget(s.offs,sl*4),0,iget(s.lens,sl*4),
           iget(s.corps,sl*4),id,0,0,0,0,0,0,id,0);
}
fn h2_weaken(s:*H2,id:i32,amt:i32) i32 {
    // deliberate annotation: records the weaken request; strength is a
    // judgment, never a formula — the annotation is audited and the bytes
    // are untouched. Returns 0 (handled).
    let sl:i32=idd_find(s,id);
    if(sl<0){ return 1; }
    h2_led(s,OP_WEAKEN,sl,0,iget(s.offs,sl*4),0,iget(s.lens,sl*4),
           iget(s.corps,sl*4),id,amt,0,0,0,0,0,id,0);
    return 0;
}
fn h2_mark_valuable(s:*H2,id:i32) void {
    let sl:i32=idd_find(s,id);
    if(sl<0){ return; }
    iput(s.flags,sl*4,iget(s.flags,sl*4)|F_VAL);
    h2_led(s,OP_VAL,sl,0,iget(s.offs,sl*4),0,iget(s.lens,sl*4),
           iget(s.corps,sl*4),id,0,0,0,0,0,0,id,0);
}
// ---- defects & deliberate repair (structural-revision organ) ----
fn h2_defect_boundary(s:*H2,id:i32,delta:i32) void {
    let sl:i32=idd_find(s,id);
    if(sl<0){ return; }
    df_put(s,id,1,iget(s.offs,sl*4),iget(s.lens,sl*4),-1,0);
    iput(s.offs,sl*4,iget(s.offs,sl*4)+delta);
    iput(s.shifts,sl*4,delta);
    h2_led(s,OP_DEFECT,sl,1,iget(s.offs,sl*4),0,iget(s.lens,sl*4),
           iget(s.corps,sl*4),id,delta,0,0,0,0,0,id,0);
}
fn h2_defect_content(s:*H2,id:i32,ppos:i32,pxor:i32) void {
    let sl:i32=idd_find(s,id);
    if(sl<0){ return; }
    df_put(s,id,2,iget(s.offs,sl*4),iget(s.lens,sl*4),ppos,pxor);
    h2_led(s,OP_DEFECT,sl,2,iget(s.offs,sl*4),0,iget(s.lens,sl*4),
           iget(s.corps,sl*4),id,ppos,pxor,0,0,0,0,id,0);
}
// repair: restore pre-defect span (boundary) or drop the patch (content),
// clear the defect record, re-verify. Returns 1 iff source-exact after.
fn h2_repair(s:*H2,id:i32,cbufs:[]u8,creg:[]u8,tmp:[]u8) i32 {
    let di:i32=df_find(s,id);
    if(di<0){ return h2_verify(s,id,cbufs,creg,tmp); }
    let sl:i32=idd_find(s,id);
    let d:[]u8=s.dfd;
    let kind:i32=iget(d,di*20);
    if(kind==1 && sl>=0){
        iput(s.offs,sl*4,iget(d,di*20+4));
        iput(s.lens,sl*4,iget(d,di*20+8));
        iput(s.shifts,sl*4,0);
    }
    // kind 2: clearing the record removes the patch (bytes come from corpus)
    df_clear(s,id);
    h2_led(s,OP_REVISE,sl,kind,0,0,0,0,id,0,0,0,0,0,0,id,0);
    return h2_verify(s,id,cbufs,creg,tmp);
}
// ---- M1 swap probe (A15, PROVISIONAL-PENDING-FREEZE) ----
// Remap id -> (slot+1)%nlive via the ID table, recall through the ID layer,
// expect the remapped slot's bytes. Returns 1 on PASS.
fn h2_swap_probe(s:*H2,id:i32,cbufs:[]u8,creg:[]u8,tmp:[]u8,tmp2:[]u8,probe_idx:i32) i32 {
    let sl0:i32=idd_find(s,id);
    if(sl0<0 || s.nlive<2){ return 0; }
    let slr:i32=(sl0+1)%s.nlive;
    // expected: remapped slot's source bytes
    let cid:i32=iget(s.corps,slr*4);
    let base:i32=iget(creg,cid*4);
    let off:i32=iget(s.offs,slr*4);
    let len:i32=iget(s.lens,slr*4);
    // patch the ID table (the probe)
    idd_put(s,id,slr);
    h2_led(s,OP_SWAP_PROBE,slr,0,off,0,len,cid,id,probe_idx,0,0,0,0,0,sl0,slr);
    let rl:i32=h2_recall_by_id(s,id,cbufs,creg,tmp);
    // restore
    idd_put(s,id,sl0);
    if(rl!=len){ return 0; }
    let i:i32=0;
    while(i<len){
        if(tmp[i]!=cbufs[base+off+i]){ return 0; }  // side channel: original bytes
        i=i+1;
    }
    return 1;
}

// ================= metric modes =================
fn h2_cap_for(n:i32) i32 {
    // upper bound on chunks: 17 per window (16 candidates + 1 fallback)
    return 17*(n/4096+1)+1024;
}
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,cname:[]u8,modekey:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let n:i32=buf.len;
    let cap:i32=h2_cap_for(n);
    let s:H2=h2_new(cap,cap*2+1024,0,1);
    let cids:[]u8=halloc(&s,cap*4);
    let nchunks:i32=h2_ingest(&s,buf,corpus,cids,15);
    let creg:[]u8=halloc(&s,32); let creg2:[]u8=halloc(&s,32);
    reg_set(creg,creg2,corpus,0,n);
    let tmp:[]u8=halloc(&s,8192); let tmp2:[]u8=halloc(&s,8192);
    // full recall + boundary, with the 64-remap probe interleaved
    // (A15 PROVISIONAL-PENDING-FREEZE): after every ceil(nchunks/64) recalls
    let ok:i32=0;
    let probes:i32=0; let pok:i32=0;
    let K:i32=(nchunks+63)/64;
    if(K<1){K=1;}
    let i:i32=0;
    while(i<nchunks){
        let id:i32=iget(cids,i*4);
        if(h2_verify(&s,id,buf,creg,tmp)==1){ok=ok+1;}
        i=i+1;
    }
    // A15 ID-swap probe: exactly 64 deterministic remaps, guaranteed by
    // construction (stride covers 0..nchunks-1). PROVISIONAL-PENDING-FREEZE.
    let pi:i32=0;
    while(pi<64){
        let t:i32=(pi*nchunks)/64;
        let pid:i32=iget(cids,t*4);
        if(h2_swap_probe(&s,pid,buf,creg,tmp,tmp2,pi)==1){pok=pok+1;}
        probes=probes+1;
        pi=pi+1;
    }
    let rec:i64=(ok as i64)*1000/(nchunks as i64);
    // diagnostics: refusal rate, deliberation ops, BAR sensitivity
    let ref:i64=0;
    if(s.delib_cand>0){ref=(s.delib_ref*1000)/s.delib_cand;}
    let opc:i64=0;
    if(s.delib_cuts>0){opc=s.delib_ops/s.delib_cuts;}
    let flip:i64=0;
    if(s.sens_cands>0){flip=(s.sens_flips*1000)/s.sens_cands;}
    // noticer ablation (buildability hazard): grid-only must stay valid
    let s2:H2=h2_new(cap,cap*2+1024,0,1);
    let cids2:[]u8=halloc(&s2,cap*4);
    let n2:i32=h2_ingest(&s2,buf,corpus,cids2,8);
    let aok:i32=0;
    i=0;
    while(i<n2){
        if(h2_verify(&s2,iget(cids2,i*4),buf,creg,tmp)==1){aok=aok+1;}
        i=i+1;
    }
    _zag_print("M1,");_zag_print(cname);_zag_print(",");
    p_dec1(rec);_zag_print(",");p_dec1(rec);_zag_print(",");
    p_i64(nchunks as i64);_zag_print(",swap,");p_i64(pok as i64);_zag_println("");
    let f:i32=0;
    j_begin(modekey);
    jf_dec1(&f,"m1_recall_tenths",rec);
    jf_dec1(&f,"m1_boundary_tenths",rec);
    jf_int(&f,"m1_units",nchunks as i64);
    if(pok==64){
        jf_str(&f,"m1_id_probe","PASS (64/64) PROVISIONAL-PENDING-FREEZE");
    } else {
        jf_str(&f,"m1_id_probe","FAIL (side channel) PROVISIONAL-PENDING-FREEZE");
    }
    jf_dec1(&f,"m1_refusal_tenths",ref);
    jf_int(&f,"m1_delib_ops_per_cut",opc);
    jf_dec1(&f,"m1_bar_flip_tenths",flip);
    jf_int(&f,"m1_ablate_grid_valid",aok as i64);
    jf_int(&f,"m1_ablate_grid_units",n2 as i64);
    // H2 binding kill, prong 2: fallback rate on this corpus (tenths of %).
    // win_n/fallback_win are live-window counters on s (s2's are separate).
    jf_int(&f,"m1_windows",s.win_n);
    jf_int(&f,"m1_fallback_win",s.fallback_win);
    let fr:i64=0;
    if(s.win_n>0){fr=(s.fallback_win*1000)/s.win_n;}
    jf_dec1(&f,"m1_fallback_rate_tenths",fr);
    jf_int(&f,"m1_bulk_refused",s.bulk_ref);
    j_end();
    hfree(&s,cids);hfree(&s,tmp);hfree(&s,tmp2);hfree(&s,creg);hfree(&s,creg2);
    hfree(&s2,cids2);
}
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let n:i32=buf.len;
    let cap:i32=h2_cap_for(n);
    let s:H2=h2_new(cap,cap*2+1024,0,1);
    let cids:[]u8=halloc(&s,cap*4);
    let creg:[]u8=halloc(&s,32); let creg2:[]u8=halloc(&s,32);
    reg_set(creg,creg2,corpus,0,n);
    let tmp:[]u8=halloc(&s,8192);
    let rs:[]u8=halloc(&s,51*4);
    iput(rs,0,0);
    let e:i32=1; let consec:i32=0; let etc:i32=50; let nep:i32=1;
    let rc:i64=0; let bc:i64=0;
    while(e<=50){
        let nchunks:i32=h2_ingest(&s,buf,corpus,cids,15);
        let ok:i32=0;
        let i:i32=0;
        while(i<nchunks){
            if(h2_verify(&s,iget(cids,i*4),buf,creg,tmp)==1){ok=ok+1;}
            i=i+1;
        }
        let cok:i64=(ok as i64)*1000/(nchunks as i64);
        iput(rs,e*4,cok as i32);
        nep=e+1;
        if(cok>=995 && cok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc=cok;bc=cok;break;}
        rc=cok;bc=cok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");p_i64(censored as i64);_zag_println("");
    let f:i32=0;
    j_begin(tier);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",0);
    jf_dec1(&f,"m2_final_recall_tenths",rc);
    jf_dec1(&f,"m2_final_boundary_tenths",bc);
    let m9shape:[]u8="";
    if(do_m9==1){
        let npts:i32=nep;
        let takeoff:i32=npts;
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        m9shape=shape;
    }
    j_end();
    if(do_m9==1){
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(m9shape);_zag_println("");
    }
    hfree(&s,cids);hfree(&s,tmp);hfree(&s,rs);hfree(&s,creg);hfree(&s,creg2);
}

const H2_C_FRESH2:i32=9;   // second fresh range (M3 phase 3)

fn t_m3(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let plen:i32=prose.len; let clen:i32=code.len;
    // dry-segment prose+code (arm's own segmentation) to locate every k-th chunk
    let sdry:H2=h2_new(1024,4096,0,1);
    let maxsp:i32=17*(plen/4096+1)+17*(clen/4096+1)+64;
    let spans:[]u8=nio_alloc(maxsp*8);
    let nsp:i32=h2_segment_dry(&sdry,prose,H2_C_PROSE,spans);
    let spans2:[]u8=nio_alloc(maxsp*8);
    let nsc:i32=h2_segment_dry(&sdry,code,H2_C_CODE,spans2);
    let total:i32=nsp+nsc;
    let k:i32=total/1000;
    if(k<1){k=1;}
    // M3 store: C_M3=4000 slots, harness-fixed (A1). Retained ledger.
    let s:H2=h2_new(4000,16384,65536,0);
    let cbufs:[]u8=halloc(&s,plen+clen+fresh.len);
    let i:i32=0;while(i<plen){cbufs[i]=prose[i];i=i+1;}
    i=0;while(i<clen){cbufs[plen+i]=code[i];i=i+1;}
    i=0;while(i<fresh.len){cbufs[plen+clen+i]=fresh[i];i=i+1;}
    let creg:[]u8=halloc(&s,40); let creg2:[]u8=halloc(&s,40);
    reg_set(creg,creg2,H2_C_PROSE,0,plen);
    reg_set(creg,creg2,H2_C_CODE,plen,clen);
    reg_set(creg,creg2,H2_C_FRESH,plen+clen,192000);
    reg_set(creg,creg2,H2_C_FRESH2,plen+clen+192000,fresh.len-192000);
    let tmp:[]u8=halloc(&s,8192);
    // V: commit every k-th chunk (prose spans then code spans); valuable+pin
    let v_ids:[]u8=halloc(&s,1000*4);
    let v:i32=0;
    while(v<1000){
        let g:i32=v*k;
        let cid:i32=H2_C_PROSE; let off:i32=0; let ln:i32=0;
        if(g<nsp){ off=iget(spans,g*8); ln=iget(spans,g*8+4); }
        else{ cid=H2_C_CODE; let gg:i32=g-nsp; off=iget(spans2,gg*8); ln=iget(spans2,gg*8+4); }
        let id:i32=h2_commit_span(&s,cid,off,ln,0);
        h2_mark_valuable(&s,id);
        h2_pin(&s,id);
        iput(v_ids,v*4,id);
        v=v+1;
    }
    // phase 1: fresh[0:192000]
    let fa:[]u8=cbufs[plen+clen..plen+clen+192000];
    let cids1:[]u8=halloc(&s,8192*4);
    let nf1:i32=h2_ingest(&s,fa,H2_C_FRESH,cids1,15);
    let n_p1:i32=s.led_n;
    // phase 2: kill all phase-1 fresh (V never targeted)
    let f:i32=0;
    while(f<nf1){ h2_kill(&s,iget(cids1,f*4),1); f=f+1; }
    // weaken: 50 ops on V[0,20,...,980]
    let w:i32=0; let w_ok:i32=0;
    while(w<50){
        let id:i32=iget(v_ids,(w*20)*4);
        if(h2_weaken(&s,id,w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let n_p2:i32=s.led_n;
    // phase 3: fresh[192000:] at capacity (eviction acts or audited refusal)
    let fb:[]u8=cbufs[plen+clen+192000..plen+clen+fresh.len];
    let cids3:[]u8=halloc(&s,16384*4);
    let nf3:i32=h2_ingest(&s,fb,H2_C_FRESH2,cids3,15);
    let n_p3:i32=s.led_n;
    // survival: M1-recall on V
    let surv_ok:i32=0;
    v=0;
    while(v<1000){
        if(h2_verify(&s,iget(v_ids,v*4),cbufs,creg,tmp)==1){surv_ok=surv_ok+1;}
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/1000;
    // fresh sample: last 500 ingested fresh-B chunks
    let fs_ok:i32=0;
    let fstart:i32=nf3-500;
    if(fstart<0){fstart=0;}
    f=fstart;
    while(f<nf3){
        if(h2_verify(&s,iget(cids3,f*4),cbufs,creg,tmp)==1){fs_ok=fs_ok+1;}
        f=f+1;
    }
    let fdiv:i32=nf3-fstart;
    if(fdiv<1){fdiv=1;}
    let fresht:i64=(fs_ok as i64)*1000/(fdiv as i64);
    // liveness: management entries in [n_p1, n_p3)
    let mgmt:i32=0;
    let le:i32=n_p1;
    let ps0:*H2=&s;
    let led:[]u8=ps0.*.led;
    while(le<n_p3){
        let op:i32=iget(led,le*64);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_EVICT || op==OP_REFUSE || op==OP_VAL){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let ff:i32=0;
    j_begin("m3-1x");
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",1000);
    j_end();
    nio_free(spans); nio_free(spans2);
    hfree(&s,cbufs); hfree(&s,tmp); hfree(&s,v_ids);
    hfree(&s,cids1); hfree(&s,cids3); hfree(&s,creg); hfree(&s,creg2);
}

fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,is_code:i32,keyp:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let n:i32=buf.len;
    let cap:i32=h2_cap_for(n);
    let s:H2=h2_new(cap,cap*2+1024,0,1);
    let cids:[]u8=halloc(&s,cap*4);
    let nchunks:i32=h2_ingest(&s,buf,corpus,cids,15);
    let creg:[]u8=halloc(&s,32); let creg2:[]u8=halloc(&s,32);
    reg_set(creg,creg2,corpus,0,n);
    let tmp:[]u8=halloc(&s,8192);
    let d_ids:[]u8=halloc(&s,200*4);
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    // plant: 100 boundary (j<100), 100 content (j>=100) at j*nchunks/200
    let j:i32=0;
    while(j<200){
        let idx:i32=j*nchunks/200;
        let id:i32=iget(cids,idx*4);
        iput(d_ids,j*4,id);
        if(j<100){
            h2_defect_boundary(&s,id,iget(cyc,(j%12)*4));
        }else{
            let sl:i32=idd_find(&s,id);
            let ln:i32=iget(s.lens,sl*4);
            h2_defect_content(&s,id,ln/2,255);
        }
        j=j+1;
    }
    // revision episodes (<=20): repair all, verify
    let rep_b:i32=0; let rep_c:i32=0;
    let ep:i32=1;
    while(ep<=20){
        j=0;
        while(j<200){ h2_repair(&s,iget(d_ids,j*4),buf,creg,tmp); j=j+1; }
        rep_b=0; rep_c=0;
        j=0;
        while(j<100){
            if(h2_verify(&s,iget(d_ids,j*4),buf,creg,tmp)==1){rep_b=rep_b+1;}
            j=j+1;
        }
        j=100;
        while(j<200){
            if(h2_verify(&s,iget(d_ids,j*4),buf,creg,tmp)==1){rep_c=rep_c+1;}
            j=j+1;
        }
        if(rep_b+rep_c>=200){break;}
        ep=ep+1;
    }
    let killed:i32=0;
    j=0;
    while(j<200){
        let sl:i32=idd_find(&s,iget(d_ids,j*4));
        if(sl<0){killed=killed+1;}
        else{if((iget(s.flags,sl*4) & F_LIVE)==0){killed=killed+1;}}
        j=j+1;
    }
    let rev_bt:i64=(rep_b as i64)*1000/100;
    let rev_ct:i64=(rep_c as i64)*1000/100;
    let kill_t:i64=(killed as i64)*1000/200;
    let ksub:i32=0;
    if(kill_t>500 && (rev_bt<800 || rev_ct<800)){ksub=1;}
    _zag_print("M4,");_zag_print(keyp);_zag_print(",");
    p_dec1(rev_bt);_zag_print(",");p_dec1(rev_ct);_zag_print(",");
    p_dec1(kill_t);_zag_print(",");p_i64(ksub as i64);_zag_println("");
    let f:i32=0;
    j_begin(keyp);
    jf_dec1(&f,"m4_rev_boundary_tenths",rev_bt);
    jf_dec1(&f,"m4_rev_content_tenths",rev_ct);
    jf_dec1(&f,"m4_kill_rate_tenths",kill_t);
    jf_bool(&f,"m4_killsub",ksub);
    jf_int(&f,"m4_episodes",ep as i64);
    j_end();
    hfree(&s,cids);hfree(&s,tmp);hfree(&s,d_ids);hfree(&s,cyc);
    hfree(&s,creg);hfree(&s,creg2);
}
fn t_m5(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let n:i32=prose.len;
    let cap:i32=h2_cap_for(n);
    let s:H2=h2_new(cap,cap*2+1024,cap*4,0);
    let cids:[]u8=halloc(&s,cap*4);
    let nchunks:i32=h2_ingest(&s,prose,H2_C_PROSE,cids,15);
    let creg:[]u8=halloc(&s,32); let creg2:[]u8=halloc(&s,32);
    reg_set(creg,creg2,H2_C_PROSE,0,n);
    let tmp:[]u8=halloc(&s,8192);
    // mini-pressure: fresh ingests + kills (store not pristine at measure)
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(fresh.len>0){
        let fs:[]u8=fresh[0..32000];
        let cidsf:[]u8=halloc(&s,4096*4);
        let nf:i32=h2_ingest(&s,fs,H2_C_FRESH,cidsf,15);
        let q:i32=0;
        while(q<nf){ h2_kill(&s,iget(cidsf,q*4),2); q=q+1; }
        hfree(&s,cidsf);
    }
    // learned = byte-exact recall now
    let l:i32=0; let src:i64=0;
    let i:i32=0;
    while(i<nchunks){
        let id:i32=iget(cids,i*4);
        if(h2_verify(&s,id,prose,creg,tmp)==1){
            l=l+1;
            let sl:i32=idd_find(&s,id);
            src=src+(iget(s.lens,sl*4) as i64);
        }
        i=i+1;
    }
    let slot_bytes:i64=(cap as i64)*28;
    let ledger_bytes:i64=(s.led_n as i64)*64;
    let wf:i32=write_file(".","ledger.bin",s.led[0..s.led_n*64]);
    _zag_print("M5,");p_i64(l as i64);_zag_print(",");
    p_i64(src);_zag_print(",");p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin("m5-1x");
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",n as i64);
    j_end();
    hfree(&s,cids);hfree(&s,tmp);hfree(&s,creg);hfree(&s,creg2);
}
fn t_m5baseline(cdir:[]u8) void {
    let psz:i64=file_size(cdir,"prose.bin");
    if(psz<=0){_zag_println("M5,FATAL,empty-corpus");return;}
    let cap:i32=h2_cap_for(psz as i32);
    let s:H2=h2_new(cap,cap*2+1024,0,1);
    // touch the empty slot table so it is resident (cf. b64; AMBIGUITIES A4):
    // the literal (rss_delta + slot_table) formula must not double-count.
    // (ZNC-2026-09-21-004: route slice aliases through a pointer, not a local.)
    let psb:*H2=&s;
    let b0:[]u8=psb.*.ids;let b1:[]u8=psb.*.corps;let b2:[]u8=psb.*.offs;let b3:[]u8=psb.*.lens;
    let b4:[]u8=psb.*.flags;let b5:[]u8=psb.*.shifts;let b6:[]u8=psb.*.pidx;
    let bj:i32=0;
    while(bj<b0.len){
        b0[bj]=0;b1[bj]=0;b2[bj]=0;b3[bj]=0;b4[bj]=0;b5[bj]=0;b6[bj]=0;
        bj=bj+1;
    }
    _zag_println("M5_BASELINE,ok");
    let f:i32=0;
    j_begin("m5-baseline");
    jf_bool(&f,"m5_baseline",1);
    j_end();
    let spin:i64=0;while(spin<300000000){spin=spin+1;}
}

fn t_m6(cdir:[]u8,dir:i32) void {
    // dir 0 = prose->code, 1 = code->prose
    let tname:[]u8="t1_prose.bin"; let tcid:i32=H2_C_T1P;
    let yname:[]u8="code.bin"; let ycid:i32=H2_C_CODE;
    let dkey:[]u8="m6-p2c-1x"; let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=H2_C_T1C;yname="prose.bin";ycid=H2_C_PROSE;
        dkey="m6-c2p-1x";dtag="c2p";
    }
    let tbuf:[]u8=read_file(cdir,tname);
    let ybuf:[]u8=read_file(cdir,yname);
    if(tbuf.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let cap:i32=h2_cap_for(tbuf.len+ybuf.len);
    let s:H2=h2_new(cap,cap*2+1024,0,1);
    let cbufs:[]u8=halloc(&s,tbuf.len+ybuf.len);
    let i:i32=0;while(i<tbuf.len){cbufs[i]=tbuf[i];i=i+1;}
    i=0;while(i<ybuf.len){cbufs[tbuf.len+i]=ybuf[i];i=i+1;}
    let creg:[]u8=halloc(&s,32); let creg2:[]u8=halloc(&s,32);
    reg_set(creg,creg2,tcid,0,tbuf.len);
    reg_set(creg,creg2,ycid,tbuf.len,ybuf.len);
    let tmp:[]u8=halloc(&s,8192);
    let cids:[]u8=halloc(&s,cap*4);
    // train on tier-1 to the M2 criterion (995/950, 3 consecutive)
    let e:i32=1; let consec:i32=0;
    let ntchunks:i32=0; let cok:i64=0;
    while(e<=50){
        ntchunks=h2_ingest(&s,tbuf,tcid,cids,15);
        let ok:i32=0;
        i=0;
        while(i<ntchunks){
            if(h2_verify(&s,iget(cids,i*4),cbufs,creg,tmp)==1){ok=ok+1;}
            i=i+1;
        }
        cok=(ok as i64)*1000/(ntchunks as i64);
        if(cok>=995){consec=consec+1;}else{consec=0;}
        if(consec>=3){break;}
        e=e+1;
    }
    let rec_d:i64=cok;
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    // in-domain revision: 100 boundary defects on train chunks
    let j:i32=0;
    while(j<100){
        let idx:i32=j*ntchunks/100;
        h2_defect_boundary(&s,iget(cids,idx*4),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        let idx:i32=j*ntchunks/100;
        h2_repair(&s,iget(cids,idx*4),cbufs,creg,tmp);
        j=j+1;
    }
    let rev_d:i32=0;
    j=0;
    while(j<100){
        let idx:i32=j*ntchunks/100;
        if(h2_verify(&s,iget(cids,idx*4),cbufs,creg,tmp)==1){rev_d=rev_d+1;}
        j=j+1;
    }
    // transfer: face the new domain (ingest allowed, policy frozen)
    let cidsy:[]u8=halloc(&s,cap*4);
    let nychunks:i32=h2_ingest(&s,ybuf,ycid,cidsy,15);
    let ok:i32=0;
    i=0;
    while(i<nychunks){
        if(h2_verify(&s,iget(cidsy,i*4),cbufs,creg,tmp)==1){ok=ok+1;}
        i=i+1;
    }
    let rec_t:i64=(ok as i64)*1000/(nychunks as i64);
    // transfer revision
    j=0;
    while(j<100){
        let idx:i32=j*nychunks/100;
        h2_defect_boundary(&s,iget(cidsy,idx*4),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        let idx:i32=j*nychunks/100;
        h2_repair(&s,iget(cidsy,idx*4),cbufs,creg,tmp);
        j=j+1;
    }
    let rev_t:i32=0;
    j=0;
    while(j<100){
        let idx:i32=j*nychunks/100;
        if(h2_verify(&s,iget(cidsy,i*4),cbufs,creg,tmp)==1){rev_t=rev_t+1;}
        j=j+1;
    }
    let rev_tt:i64=(rev_t as i64)*10;
    let tax:i64=rec_d-rec_t;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t);_zag_print(",");p_dec1(rec_t);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_println("");
    let g:i32=0;
    j_begin(dkey);
    jf_dec1(&g,"rec_tenths",rec_t);
    jf_dec1(&g,"bnd_tenths",rec_t);
    jf_dec1(&g,"rev_tenths",rev_tt);
    jf_dec1(&g,"tax_tenths",tax);
    j_end();
    hfree(&s,cbufs);hfree(&s,tmp);hfree(&s,cids);hfree(&s,cidsy);
    hfree(&s,cyc);hfree(&s,creg);hfree(&s,creg2);
}

// ---- M7: reuse at equal live-store slots vs fixed-64B baseline ----
// Reuse hit rate (falsifiable prediction, ALPHABET_G-L H2 §2): fraction of
// recalls served from existing chunks with no new adds, measured over the
// harness 5000-lookup schedule ((l*37)%n, split 1666/1667/1667) with the
// round-2 every-100th-unit edit schedule. Both arms get S live slots where
// S = H2's round-0 live chunk count (arm-under-test operating point;
// ambiguity logged). Baseline: fixed 64B chunking, first-S-units live
// (refusal when full), same schedule. Kill (i) triggers iff
// h2_hit <= base_hit + 100 (10 abs pts) on BOTH corpora.
fn m7_corpus(cdir:[]u8,fname:[]u8,cid:i32,out:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let n:i32=buf.len;
    let cap:i32=h2_cap_for(n);
    let s:H2=h2_new(cap,cap*2+1024,0,1);
    let cids:[]u8=halloc(&s,cap*4);
    // round 0: ingest
    let nchunks:i32=h2_ingest(&s,buf,cid,cids,15);
    // round 1: re-ingest (revive path); reuse = id-stable spans / nchunks
    let cids2:[]u8=halloc(&s,cap*4);
    let n2:i32=h2_ingest(&s,buf,cid,cids2,15);
    let hits:i32=0; let savings:i64=0;
    let m:i32=nchunks;
    if(n2<m){m=n2;}
    let i:i32=0;
    while(i<m){
        if(iget(cids2,i*4)==iget(cids,i*4)){
            hits=hits+1;
            let sl:i32=idd_find(&s,iget(cids,i*4));
            savings=savings+(iget(s.lens,sl*4) as i64);
        }
        i=i+1;
    }
    let reuse:i64=(hits as i64)*1000/(nchunks as i64);
    let creg:[]u8=halloc(&s,32); let creg2:[]u8=halloc(&s,32);
    reg_set(creg,creg2,cid,0,n);
    let tmp:[]u8=halloc(&s,8192);
    // lookups with round-2 edits after 1666
    let look_hits:i32=0; let reread:i64=0;
    let l:i32=0;
    while(l<5000){
        if(l==1666){
            let q:i32=0;
            while(q<nchunks){
                if(q%100==0){
                    let eid:i32=iget(cids,q*4);
                    h2_defect_content(&s,eid,0,255);
                }
                q=q+1;
            }
        }
        let idx:i32=(l*37)%nchunks;
        let rl:i32=h2_recall_by_id(&s,iget(cids,idx*4),buf,creg,tmp);
        if(rl>0){look_hits=look_hits+1; reread=reread+(rl as i64);}
        l=l+1;
    }
    let hit:i64=(look_hits as i64)*1000/5000;
    // baseline: fixed 64B, S=nchunks live slots, first-S live
    let n64:i32=(n+63)/64;
    let S:i32=nchunks;
    let b_reuse:i64=(S as i64)*1000/(n64 as i64);
    let b_hits:i32=0;
    l=0;
    while(l<5000){
        let idx:i32=(l*37)%n64;
        if(idx<S){b_hits=b_hits+1;}
        l=l+1;
    }
    let b_hit:i64=(b_hits as i64)*1000/5000;
    let kill:i32=0;
    if(hit<=b_hit+100){kill=1;}
    _zag_print("M7,");_zag_print(fname);_zag_print(",hit,");
    p_dec1(hit);_zag_print(",base,");p_dec1(b_hit);_zag_println("");
    i64put(out,0,hit); i64put(out,8,reuse); i64put(out,16,savings);
    i64put(out,24,reread); i64put(out,32,b_hit); i64put(out,40,b_reuse);
    i64put(out,48,kill as i64); i64put(out,56,nchunks as i64);
    hfree(&s,cids);hfree(&s,cids2);hfree(&s,tmp);hfree(&s,creg);hfree(&s,creg2);
}
fn t_m7(cdir:[]u8) void {
    let rp:[]u8=nio_alloc(64); let rc:[]u8=nio_alloc(64);
    m7_corpus(cdir,"prose.bin",H2_C_PROSE,rp);
    m7_corpus(cdir,"code.bin",H2_C_CODE,rc);
    let kp:i32=i64get(rp,48) as i32;
    let kc:i32=i64get(rc,48) as i32;
    let kill_all:i32=0;
    if(kp==1 && kc==1){kill_all=1;}
    let f:i32=0;
    j_begin("m7-1x");
    jf_dec1(&f,"m7_hit_rate_tenths",i64get(rp,0));
    jf_dec1(&f,"m7_reuse_rate_tenths",i64get(rp,8));
    jf_int(&f,"m7_dedup_savings_bytes",i64get(rp,16));
    jf_str(&f,"m7_na_reason","provisional ID arm: reuse measured on both corpora; 64-remap probe in M1 (PROVISIONAL-PENDING-FREEZE)");
    jf_int(&f,"m7_reread_bytes",i64get(rp,24)+i64get(rc,24));
    jf_dec1(&f,"m7_prose_baseline_hit_tenths",i64get(rp,32));
    jf_dec1(&f,"m7_code_hit_rate_tenths",i64get(rc,0));
    jf_dec1(&f,"m7_code_baseline_hit_tenths",i64get(rc,32));
    jf_bool(&f,"m7_kill_i_triggered",kill_all);
    // H2 binding kill, prong 1: reuse (hit-rate) advantage over the fixed-64B
    // baseline in absolute points, per corpus + both readings. 5-pt bar is the
    // frozen H2 bar (H1's was 10 pts; m7_kill_i_triggered above is the 10-pt
    // H1-style flag kept for reference). Id-stable reuse-rate variants are
    // reported as companions; the hit-rate reading is primary (H1's kill text:
    // "reuse hit rate ... exceed the fixed-64B baseline").
    let adv_p:i64=i64get(rp,0)-i64get(rp,32);
    let adv_c:i64=i64get(rc,0)-i64get(rc,32);
    jf_dec1(&f,"m7_prose_reuse_advantage_hit_tenths",adv_p);
    jf_dec1(&f,"m7_code_reuse_advantage_hit_tenths",adv_c);
    let advr_p:i64=i64get(rp,8)-i64get(rp,40);
    let advr_c:i64=i64get(rc,8)-i64get(rc,40);
    jf_dec1(&f,"m7_prose_reuse_advantage_idstable_tenths",advr_p);
    jf_dec1(&f,"m7_code_reuse_advantage_idstable_tenths",advr_c);
    jf_dec1(&f,"m7_prose_baseline_reuse_idstable_tenths",i64get(rp,40));
    jf_dec1(&f,"m7_code_baseline_reuse_idstable_tenths",i64get(rc,40));
    let h2kill:i32=0;
    if(adv_p<50 && adv_c<50){h2kill=1;}   // both-corpus reading (kill_all convention)
    let h2kill_either:i32=0;
    if(adv_p<50 || adv_c<50){h2kill_either=1;}  // stricter reading, reported
    jf_bool(&f,"m7_h2_kill_reuse_both",h2kill);
    jf_bool(&f,"m7_h2_kill_reuse_either",h2kill_either);
    j_end();
    nio_free(rp); nio_free(rc);
}

// ---- M8: determinism gate (N=5 adversarial full M1+M3 runs) ----
fn img_append(dst:[]u8,at:i32,src:[]u8,n:i32) i32 {
    let i:i32=0;while(i<n){dst[at+i]=src[i];i=i+1;}
    return at+n;
}
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    // perturbations (raw allocations bypass the logged trace: the trace must
    // capture only the arm's own allocations, identical across perturbations)
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            // survivors leak intentionally: freed by OS at exit; identical each run
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){
        aslr_pad=nio_alloc(1234567);
    }
    // freelist-rev / starve: accepted, documented no-ops for H2
    // (slot placement is a pure function of chunk ID; clock/entropy unused)
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){
        _zag_println("M8,FATAL,empty-corpus");
        if(aslr_pad.len>0){nio_free(aslr_pad);}
        return;
    }
    let plen:i32=prose.len; let clen:i32=code.len;
    let np:i32=h2_cap_for(plen); let nc:i32=h2_cap_for(clen);
    let cap:i32=np+nc+(np+nc)/4+16384;
    let dcap:i32=cap*2+1024;
    // retained ledger sized for the combined M1+M3 sequence
    let s:H2=h2_new(cap,dcap,300000,0);
    let cbufs:[]u8=halloc(&s,plen+clen+fresh.len);
    let i:i32=0;while(i<plen){cbufs[i]=prose[i];i=i+1;}
    i=0;while(i<clen){cbufs[plen+i]=code[i];i=i+1;}
    i=0;while(i<fresh.len){cbufs[plen+clen+i]=fresh[i];i=i+1;}
    let creg:[]u8=halloc(&s,40); let creg2:[]u8=halloc(&s,40);
    reg_set(creg,creg2,H2_C_PROSE,0,plen);
    reg_set(creg,creg2,H2_C_CODE,plen,clen);
    reg_set(creg,creg2,H2_C_FRESH,plen+clen,192000);
    reg_set(creg,creg2,H2_C_FRESH2,plen+clen+192000,fresh.len-192000);
    let tmp:[]u8=halloc(&s,8192);
    // M1 on this instance: full ingest + full recall of both corpora
    let cids_p:[]u8=halloc(&s,np*4);
    let npp:i32=h2_ingest(&s,cbufs[0..plen],H2_C_PROSE,cids_p,15);

    let ok:i32=0;
    i=0;
    while(i<npp){
        if(h2_verify(&s,iget(cids_p,i*4),cbufs,creg,tmp)==1){ok=ok+1;}
        i=i+1;
    }
    let m1p:i64=(ok as i64)*1000/(npp as i64);
    let cids_c:[]u8=halloc(&s,nc*4);
    let npc:i32=h2_ingest(&s,cbufs[plen..plen+clen],H2_C_CODE,cids_c,15);

    ok=0;
    i=0;
    while(i<npc){
        if(h2_verify(&s,iget(cids_c,i*4),cbufs,creg,tmp)==1){ok=ok+1;}
        i=i+1;
    }
    let m1c:i64=(ok as i64)*1000/(npc as i64);
    // M3 churn sequence on the same instance
    let total:i32=npp+npc;
    let k:i32=total/1000;
    if(k<1){k=1;}
    let v_ids:[]u8=halloc(&s,1000*4);
    let v:i32=0;
    while(v<1000){
        let g:i32=v*k;
        let id:i32=0;
        if(g<npp){id=iget(cids_p,g*4);}else{id=iget(cids_c,(g-npp)*4);}
        h2_mark_valuable(&s,id);
        iput(v_ids,v*4,id);
        v=v+1;
    }
    let fa:[]u8=cbufs[plen+clen..plen+clen+192000];
    let cids_f1:[]u8=halloc(&s,8192*4);
    let nf1:i32=h2_ingest(&s,fa,H2_C_FRESH,cids_f1,15);

    let f:i32=0;
    while(f<nf1){ h2_kill(&s,iget(cids_f1,f*4),1); f=f+1; }
    let w:i32=0;
    while(w<50){ h2_weaken(&s,iget(v_ids,(w*20)*4),w+1); w=w+1; }
    let fb:[]u8=cbufs[plen+clen+192000..plen+clen+fresh.len];
    let cids_f3:[]u8=halloc(&s,16384*4);
    let nf3:i32=h2_ingest(&s,fb,H2_C_FRESH2,cids_f3,15);

    // artifacts: store image = slot table + dedup + ID map
    let img:[]u8=halloc(&s,cap*28+dcap*20);

    let pos:i32=0;
    pos=img_append(img,pos,s.ids,cap*4);pos=img_append(img,pos,s.corps,cap*4);
    pos=img_append(img,pos,s.offs,cap*4);pos=img_append(img,pos,s.lens,cap*4);
    pos=img_append(img,pos,s.flags,cap*4);pos=img_append(img,pos,s.shifts,cap*4);
    pos=img_append(img,pos,s.pidx,cap*4);
    pos=img_append(img,pos,s.ddk,dcap*8);pos=img_append(img,pos,s.ddv,dcap*4);
    pos=img_append(img,pos,s.iddk,dcap*4);pos=img_append(img,pos,s.iddv,dcap*4);
    let nch:i32=(pos+1048575)/1048576;
    let chain_in:[]u8=halloc(&s,nch*32);
    let ci:i32=0;
    while(ci<nch){
        let cs:i32=ci*1048576;let cn:i32=pos-cs;
        if(cn>1048576){cn=1048576;}
        ns_sha256(img[cs..cs+cn],chain_in[ci*32..ci*32+32]);
        ci=ci+1;
    }
    let chl:[]u8=halloc(&s,nch*80);
    let cho:i32=0;
    ci=0;
    while(ci<nch){
        let cs:i32=ci*32;
        let hx:[]u8=ns_hex(chain_in[cs..cs+32]);
        let tag:[]u8=_zag_i64_to_str(ci as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<hx.len){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        nio_free(hx);nio_free(tag);
        ci=ci+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);

    let chain:[]u8=halloc(&s,32);
    ns_sha256(chain_in,chain);
    write_hex_line(outdir,"store_chain.txt","chain",chain);

    write_file(outdir,"ledger.bin",s.led[0..s.led_n*64]);

    let lhash:[]u8=halloc(&s,32);
    ns_sha256(s.led[0..s.led_n*64],lhash);
    write_hex_line(outdir,"ledger_chain.txt","chain",lhash);

    write_file(outdir,"alloc_trace.txt",s.trace[0..s.trace_n]);

    // stdout stays perturbation-agnostic: the runner's directory records which
    // perturbation ran, and m8_compare.py requires byte-identical stdout.
    _zag_print("M8,");
    p_dec1(m1p);_zag_print(",");p_dec1(m1c);_zag_print(",");
    p_i64(s.led_n as i64);_zag_println("");
    hfree(&s,cids_p);hfree(&s,cids_c);hfree(&s,cbufs);
    hfree(&s,v_ids);hfree(&s,cids_f1);hfree(&s,cids_f3);
    hfree(&s,img);hfree(&s,chain_in);hfree(&s,chl);hfree(&s,chain);hfree(&s,lhash);
    hfree(&s,tmp);hfree(&s,creg);hfree(&s,creg2);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
    // frag survivors: freed by OS at exit
}

// ================= main dispatcher =================
// ---- spans dump (reuse analysis, kill criterion i) ----
// Dry segmentation only: prints SPAN,off,len per unit in order, no store
// effects. Identical segmentation to h2_ingest mask=15 (t_m1 path).
fn t_spans(cdir:[]u8,fname:[]u8,corpus:i32,cname:[]u8,modekey:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("SPANS,FATAL,empty-corpus");return;}
    let n:i32=buf.len;
    let sdry:H2=h2_new(1024,4096,0,1);
    let maxsp:i32=17*(n/4096+1)+64;
    let spans:[]u8=nio_alloc(maxsp*8);
    let nsp:i32=h2_segment_dry(&sdry,buf,corpus,spans);
    let i:i32=0;
    while(i<nsp){
        _zag_print("SPAN,");
        p_i64(iget(spans,i*8) as i64);_zag_print(",");
        p_i64(iget(spans,i*8+4) as i64);_zag_println("");
        i=i+1;
    }
    _zag_print("SPANS,");_zag_print(cname);_zag_print(",");
    p_i64(nsp as i64);_zag_println("");
    let f:i32=0;
    j_begin(modekey);
    jf_int(&f,"spans_units",nsp as i64);
    jf_str(&f,"spans_corpus",cname);
    j_end();
    nio_free(spans);
}
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    let cdir:[]u8="corpora";
    if(_zag_argc()>=3){cdir=_zag_arg(2);}
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(cdir,"prose.bin",H2_C_PROSE,"prose","m1-1x-prose");}
    else{
        if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(cdir,"code.bin",H2_C_CODE,"code","m1-1x-code");}
        else{
            if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(cdir,"t1_prose.bin",H2_C_T1P,"t1-prose",1);}
            else{
                if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(cdir,"t1_code.bin",H2_C_T1C,"t1-code",1);}
                else{
                    if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(cdir,"t2_prose.bin",H2_C_T2P,"t2-prose",0);}
                    else{
                        if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(cdir,"t2_code.bin",H2_C_T2C,"t2-code",0);}
                        else{
                            if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(cdir,"t3.bin",H2_C_T3,"t3",0);}
                            else{
                                if(_zag_strcmp(mode,"m3-1x")==1){t_m3(cdir);}
                                else{
                                    if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(cdir,"prose.bin",H2_C_PROSE,0,"m4-1x-prose");}
                                    else{
                                        if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(cdir,"code.bin",H2_C_CODE,1,"m4-1x-code");}
                                        else{
                                            if(_zag_strcmp(mode,"m5-1x")==1){t_m5(cdir);}
                                            else{
                                                if(_zag_strcmp(mode,"m5-baseline")==1){t_m5baseline(cdir);}
                                                else{
                                                    if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(cdir,0);}
                                                    else{
                                                        if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(cdir,1);}
                                                        else{
                                                            if(_zag_strcmp(mode,"m7-1x")==1){t_m7(cdir);}
                                                            else{
                                                                if(_zag_strcmp(mode,"spans-1x-prose")==1){t_spans(cdir,"prose.bin",H2_C_PROSE,"prose","spans-1x-prose");}
                                                                else{
                                                                    if(_zag_strcmp(mode,"spans-1x-code")==1){t_spans(cdir,"code.bin",H2_C_CODE,"code","spans-1x-code");}
                                                                    else{
                                                                        if(_zag_strcmp(mode,"m8-1x")==1){
                                                                            let od:[]u8=".";let pt:[]u8="clean";
                                                                            if(_zag_argc()>=4){od=_zag_arg(3);}
                                                                            if(_zag_argc()>=5){pt=_zag_arg(4);}
                                                                            t_m8(cdir,od,pt);
                                                                        }
                                                                        else{
                                                                            _zag_print("unknown mode: ");
                                                                            _zag_println(mode);
                                                                            return 1;
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

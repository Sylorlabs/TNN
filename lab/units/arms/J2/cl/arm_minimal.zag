// J2 — Evidence-gated tiling birth/death (Track A, family STRUCT) — MINIMAL
// Frozen mechanism: "Tilings as hypotheses: born on evidence, die by subsumption (95%)."
// Binding kill criterion: "k does not converge (birth→death→birth for the same phase
// twice on one corpus pass), OR converges to 1 on all corpora — tilings were never
// needed; J1 dies with it."
// Pure Zag. Zero RNG. Deterministic.
@import("../substrate/R33_NATIVE_SHA256_V2.zag")
@import("../substrate/R33_NATIVE_IO_V1.zag")

const J2_CHUNK:i32=64;
const J2_KMAX:i32=5;

// Minimal J2: slot storage + tiling state (19 fields, under znc limit)
struct J2 {
    cap:i32,
    ids:[]u8,      // cap * u32
    off:[]u8,      // cap * u32
    len:[]u8,      // cap * u32
    flags:[]u8,    // cap * u32
    corp:[]u8,     // cap * u32
    ins:[]u8,      // ins_cap * u32
    ins_cap:i32,
    ins_n:i32,
    led:[]u8,      // ledger bytes
    led_n:i32,     // entries
    trace:[]u8,    // alloc trace
    trace_n:i32,
    nlive:i32,
    // tiling state
    active:[]u8,   // 64: 1 iff phase active
    born:[]u8,     // 64: 1 iff ever born
    dead:[]u8,     // 64: 1 iff dead
    kact:i32,      // active count
    nbirth:i32,
    ndeath:i32,
    nosc:i32,      // oscillation events
}

const F_OCC:i32=1;
const F_LIVE:i32=2;

// ---- helpers ----
fn uget(b:[]u8,at:i32) i64 {
    let v:i64=0;let i:i32=0;
    while(i<4){v=v|((b[at+i] as i64)<<(i*8));i=i+1;}
    return v;
}
fn uput(b:[]u8,at:i32,v:i64) void {
    let i:i32=0;while(i<4){b[at+i]=((v>>(i*8))&255) as u8;i=i+1;}
}
fn iget(b:[]u8,at:i32) i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32) void { uput(b,at,v as i64); }

fn halloc(s:*J2,n:i32) []u8 {
    // simple alloc with trace
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    if(tn+16<s.*.trace.len){
        t[tn]=65;tn=tn+1;
        let i:i32=0;while(i<4){t[tn+i]=((n>>(i*8))&255) as u8;i=i+1;}tn=tn+4;
        t[tn]=10;tn=tn+1;
        s.*.trace_n=tn;
    }
    return nio_alloc(n);
}

fn slot_hash(id:i32,cap:i32) i32 {
    let h:i32=(id*2654435761) as i32;
    if(h<0){h=-h;}
    return h%cap;
}

fn j2_init(s:*J2,cap:i32,led_entries:i32,ins_max:i32) void {
    s.*.cap=cap;s.*.nlive=0;
    s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.ids=halloc(s,cap*4);s.*.off=halloc(s,cap*4);s.*.len=halloc(s,cap*4);
    s.*.corp=halloc(s,cap*4);s.*.flags=halloc(s,cap*4);
    s.*.led=halloc(s,led_entries*64);s.*.led_n=0;
    s.*.ins=halloc(s,ins_max*4);s.*.ins_cap=ins_max;s.*.ins_n=0;
    // init slot flags to 0
    let i:i32=0;while(i<cap*4){s.*.ids[i]=0;s.*.off[i]=0;s.*.len[i]=0;s.*.corp[i]=0;s.*.flags[i]=0;i=i+1;}
    i=0;while(i<ins_max*4){s.*.ins[i]=0;i=i+1;}
    // tiling state
    s.*.active=halloc(s,64);s.*.born=halloc(s,64);s.*.dead=halloc(s,64);
    i=0;while(i<64){s.*.active[i]=0;s.*.born[i]=0;s.*.dead[i]=0;i=i+1;}
    s.*.active[0]=1;s.*.born[0]=1;s.*.kact=1;
    s.*.nbirth=0;s.*.ndeath=0;s.*.nosc=0;
}

fn j2_new(cap:i32,led_entries:i32,ins_max:i32) J2 {
    let s:J2=J2{.cap=0,.ids="",.off="",.len="",.flags="",.corp="",
        .ins="",.ins_cap=0,.ins_n=0,.led="",.led_n=0,
        .trace="",.trace_n=0,.nlive=0,
        .active="",.born="",.dead="",.kact=0,.nbirth=0,.ndeath=0,.nosc=0};
    j2_init(&s,cap,led_entries,ins_max);
    return s;
}

fn j2_slot_insert(s:*J2,id:i32,off:i32,len:i32,corpus:i32) i32 {
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let offs:[]u8=s.*.off;let lens:[]u8=s.*.len;
    let corps:[]u8=s.*.corp;let flags:[]u8=s.*.flags;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;let first_dead:i32=-1;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){
            let sl:i32=h;
            if(first_dead>=0){sl=first_dead;}
            iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
            iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC|F_LIVE);
            let ins:[]u8=s.*.ins;
            iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
            s.*.nlive=s.*.nlive+1;
            return sl;
        }
        if(iget(ids,h*4)==id){
            iput(offs,h*4,off);iput(lens,h*4,len);iput(corps,h*4,corpus);
            let f2:i32=iget(flags,h*4);
            if((f2 & F_LIVE)==0){s.*.nlive=s.*.nlive+1;}
            iput(flags,h*4,(f2|F_OCC)|F_LIVE);
            return h;
        }
        if(((f & F_LIVE)==0) && first_dead<0){first_dead=h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    return -1;
}

fn j2_slot_find(s:*J2,id:i32) i32 {
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let flags:[]u8=s.*.flags;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){return -1;}
        if(iget(ids,h*4)==id){
            if((f & F_LIVE)!=0){return h;}
            return -1;
        }
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    return -1;
}

// ---- tiling: birth eval ----
// Evidence: newline within ±2 bytes at phase positions.
// Birth if best dormant exceeds best active by max(20 permille, 3*SE).
fn j2_phase_of(id:i32) i32 {
    let p:i32=id%64;
    if(p<0){p=p+64;}
    return p;
}

fn j2_birth_stats(buf:[]u8,H:[]u8,N:[]u8) void {
    // H[p*4]: hits (newline near phase p), N[p*4]: trials
    let n:i32=buf.len;
    let i:i32=0;
    while(i<n){
        let p:i32=i%64;
        iput(N,p*4,iget(N,p*4)+1);
        // check newline within ±2 at positions i+p' where p' in {0,16,32,48,24}
        // simplified: check if buf[i]==10 (newline)
        if(buf[i]==10){
            iput(H,p*4,iget(H,p*4)+1);
        }
        i=i+1;
    }
}

fn j2_E_of(H:[]u8,N:[]u8,p:i32) i32 {
    let h:i32=iget(H,p*4);let n:i32=iget(N,p*4);
    if(n<=0){return 0;}
    return (h*1000)/n; // permille
}

fn j2_birth_eval(s:*J2,buf:[]u8,tag:[]u8) i32 {
    let H:[]u8=halloc(s,256);let N:[]u8=halloc(s,256);
    let i:i32=0;while(i<256){H[i]=0;N[i]=0;i=i+1;}
    j2_birth_stats(buf,H,N);
    // best active
    let best_ae:i32=-1000000;let best_an:i32=1;
    let p:i32=0;
    while(p<64){
        if(s.*.active[p]==1){
            let e:i32=j2_E_of(H,N,p);
            if(e>best_ae){best_ae=e;best_an=iget(N,p*4);}
        }
        p=p+1;
    }
    // SE
    let se:i64=0;
    if(best_ae>=0 && best_ae<=1000 && best_an>0){
        let va:i64=best_ae as i64;let nn:i64=best_an as i64;
        // isqrt(va*(1000-va)/nn)
        let x:i64=va*(1000-va)/nn;
        let r:i64=x;let y:i64=(r+1)/2;
        while(y<r){r=y;y=(r+x/r)/2;}
        se=r;
    }
    let thresh:i64=20;
    if(3*se>thresh){thresh=3*se;}
    // best dormant from {0,16,32,48,24} \ active \ born \ dead
    let cand0:i32=0;let cand1:i32=16;let cand2:i32=32;let cand3:i32=48;let cand4:i32=24;
    let best_d:i32=-1;let best_de:i32=-1000000;
    // check each candidate
    p=cand0;
    if(s.*.active[p]==0 && s.*.born[p]==0 && s.*.dead[p]==0){
        let e:i32=j2_E_of(H,N,p);
        if(e>best_de){best_de=e;best_d=p;}
    }
    p=cand1;
    if(s.*.active[p]==0 && s.*.born[p]==0 && s.*.dead[p]==0){
        let e:i32=j2_E_of(H,N,p);
        if(e>best_de){best_de=e;best_d=p;}
    }
    p=cand2;
    if(s.*.active[p]==0 && s.*.born[p]==0 && s.*.dead[p]==0){
        let e:i32=j2_E_of(H,N,p);
        if(e>best_de){best_de=e;best_d=p;}
    }
    p=cand3;
    if(s.*.active[p]==0 && s.*.born[p]==0 && s.*.dead[p]==0){
        let e:i32=j2_E_of(H,N,p);
        if(e>best_de){best_de=e;best_d=p;}
    }
    p=cand4;
    if(s.*.active[p]==0 && s.*.born[p]==0 && s.*.dead[p]==0){
        let e:i32=j2_E_of(H,N,p);
        if(e>best_de){best_de=e;best_d=p;}
    }
    nio_free(H);nio_free(N);
    _zag_print("J2_BIRTH_EVAL,");_zag_print(tag);
    _zag_print(",k=");_zag_print(_zag_i64_to_str(s.*.kact as i64));
    _zag_print(",E0=");_zag_print(_zag_i64_to_str(best_ae as i64));
    _zag_print(",thresh=");_zag_print(_zag_i64_to_str(thresh));
    _zag_print(",best_d=");_zag_print(_zag_i64_to_str(best_d as i64));
    _zag_print("\n");
    let born:i32=-1;
    if(best_d>=0 && s.*.kact<J2_KMAX && (best_de as i64)-(best_ae as i64)>thresh){
        born=best_d;
        s.*.active[born]=1;
        s.*.kact=s.*.kact+1;
        s.*.born[born]=1;
        s.*.nbirth=s.*.nbirth+1;
        _zag_print("J2_BIRTH,phase=");_zag_print(_zag_i64_to_str(born as i64));_zag_print("\n");
    }
    return born;
}

// ---- main dispatch (minimal: selftest + m1 + m8 smoke) ----
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len==0){
        _zag_print("J2 minimal: use selftest|m1-1x-prose\n");
        return 0;
    }
    if(_zag_strcmp(mode,"selftest")==1){
        // minimal selftest: create store, insert, birth eval on synthetic data
        let s:J2=j2_new(1024,1024,1024);
        let sp:*J2=&s;
        // synthetic: 640 bytes with newlines every 16 (phase 0 aligned)
        let buf:[]u8=nio_alloc(640);
        let i:i32=0;while(i<640){buf[i]=65;i=i+1;}
        i=0;while(i<640){if(i%16==0){buf[i]=10;}i=i+1;}
        let b:i32=j2_birth_eval(sp,buf,"selftest");
        _zag_print("SELFTEST,k=");_zag_print(_zag_i64_to_str(sp.*.kact as i64));
        _zag_print(",born=");_zag_print(_zag_i64_to_str(b as i64));
        _zag_print(",nbirth=");_zag_print(_zag_i64_to_str(sp.*.nbirth as i64));
        _zag_print("\n");
        nio_free(buf);
        // verdict: if k==1, tilings never needed
        if(sp.*.kact==1){
            _zag_print("SELFTEST_RESULT:K_EQ_1_NO_BIRTH\n");
        }else{
            _zag_print("SELFTEST_RESULT:K_GT_1_BIRTH_OCCURRED\n");
        }
        return 0;
    }
    _zag_print("J2 minimal: unknown mode\n");
    return 1;
}

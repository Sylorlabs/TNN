// O-base: constants, LE packing, traced allocator, audit ledger, file IO, JSON.
// Arm O — Taught vocabulary (family ACQ). Frozen §3 (brief O.json, byte-verified
// against frozen commit b0b9140c0eda):
//   Mechanism: Full learner-side intake via the Track B teacher protocol (§4):
//   proposals → adopt/revise/reject/defer; taught words judgment-held at
//   provisional strength (A-33/T-1).
// Learner-side machinery per ALPHABET_M-R.md Arm O §1 (12 components) and
// TEACHERS.md TST-1 (§P wire format, §T tape, §L learner's rights, §C tripwire,
// §M cost model). Teacher PROPOSES, TNN DISPOSES (learner autonomy is law).
@import("../substrate/R33_NATIVE_IO_V1.zag")
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

// corpus ids (frozen, ARM_INTERFACE.md §6)
const O_C_PROSE:i32=1;
const O_C_CODE:i32=2;
const O_C_T1P:i32=3;
const O_C_T1C:i32=4;
const O_C_T2P:i32=5;
const O_C_T2C:i32=6;
const O_C_T3:i32=7;
const O_C_FRESH:i32=8;

// ledger opcodes (frozen namespace; student decisions anchor here)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_SCAN:i32=7;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;
const OP_TDC:i32=17;
const OP_TMV:i32=18;
const OP_TSP:i32=19;   // TRAINER_SWAP_PROBE

// §L reject grounds R1..R6 (+ integrity tripwire)
const R_INSUFFICIENT:i32=1;  // R1 INSUFFICIENT_EVIDENCE
const R_CONFLICT_PIN:i32=2;  // R2 CONFLICTS_PINNED
const R_PROTOCOL:i32=3;      // R3 PROTOCOL_VIOLATION
const R_INTEGRITY:i32=4;     // R4 INTEGRITY_GATE
const R_REDUNDANT:i32=5;     // R5 REDUNDANT
const R_APPEAL:i32=6;        // R6 APPEAL_EXHAUSTED

// occurrence slot flags
const SF_LIVE:i32=1;
const SF_PIN:i32=4;
const SF_WEAK:i32=8;

// §P kinds
const PK_WORD_SPAN:i32=1;
const PK_BOUNDARY:i32=2;
const PK_GROUP:i32=3;
const PK_SAME_AS:i32=4;
const PK_RETRACT:i32=5;

// verdicts (internal)
const V_ADOPT:i32=1;
const V_REVISE:i32=2;
const V_REJECT:i32=3;
const V_DEFER:i32=4;

// frozen design params (documented in ARM_SPEC.md)
const O_VMAX:i32=4096;       // max teacher proposals per teach session
const O_WCAP:i32=8192;       // adopted-word capacity
const O_TOK_MAXLEN:i32=64;
const O_SEG_TARG:i32=512;    // segment target bytes
const O_SEG_MIN:i32=256;
const O_SEG_MAX:i32=1024;
const O_M3_CAP:i32=4000;
const O_M3_V:i32=1000;
const O_M4_N:i32=200;
const O_M7_LOOKUPS:i32=5000;
const O_TEACHER_ID:i32=1;    // peer-handwired teacher
const O_MAGIC:i32=0x54505250;
const O_PVER:i32=1;
const O_TW_WIN:i32=200;      // tripwire rolling window
const O_SCTAB:i32=262144;    // token-count scratch table slots (6.3MB)

// ---- little-endian packing on []u8 ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }
fn uget64(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24)+
           ((b[at+4] as i64)<<32)+((b[at+5] as i64)<<40)+((b[at+6] as i64)<<48)+((b[at+7] as i64)<<56);
}
fn uput64(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
    b[at+4]=((v>>32) & 255) as u8;b[at+5]=((v>>40) & 255) as u8;
    b[at+6]=((v>>48) & 255) as u8;b[at+7]=((v>>56) & 255) as u8;
}

// ---- arm state ----
struct OState {
    // adopted words (learner-owned; survive disconnect)
    wn:i32,
    woff:[]u8,    // O_WCAP*u32: offset into wbytes
    wlen:[]u8,    // O_WCAP*u32
    wss:[]u8,     // O_WCAP*u32: canonical span start in teach corpus
    wse:[]u8,     // O_WCAP*u32: canonical span end
    wsrc:[]u8,    // O_WCAP*u32: teach corpus id
    wtid:[]u8,    // O_WCAP*u32: teacher_id (provenance)
    wseq:[]u8,    // O_WCAP*u32: teacher seq (provenance)
    wjudge:[]u8,  // O_WCAP*i32: 0 provisional (judgment-held), 1 established
    wbytes:[]u8, wbytes_n:i32, wbytes_cap:i32,
    // word match index: first-byte buckets -> wid chains
    bkt:[]u8,     // 256*u32 heads, 0xFFFFFFFF = empty
    wnext:[]u8,   // O_WCAP*u32
    // occurrence slots: uid -> storage (persistent ID->storage mapping)
    cap:i32,
    suid:[]u8,    // cap*u32
    spos:[]u8,    // cap*u32: byte offset in faced corpus
    slen:[]u8,    // cap*u32
    scorp:[]u8,   // cap*u32: corpus id
    sseg:[]u8,    // cap*u32: segment index within corpus
    sflags:[]u8,  // cap*u32: SF_* (0 = empty slot)
    shash:[]u8,   // cap*u64: fnv1a-64 of true content (revise verification)
    nlive:i32,
    next_uid:i32,
    // (corpus,seg_idx) -> uid index (opaque IDs; re-ingest resolves same ID)
    sgcap:i32,
    sgkey:[]u8,   // sgcap*u32: (corpus<<24)|seg_idx, 0xFFFFFFFF = empty
    sguid:[]u8,   // sgcap*u32
    // insertion order queue (probe order, FIFO eviction)
    ins:[]u8, ins_n:i32, ins_head:i32, ins_cap:i32,
    // defect side table (trainer ops)
    dn:i32,
    d_uid:[]u8, d_shift:[]u8, d_poff:[]u8, d_plen:[]u8,
    pbytes:[]u8, pbytes_n:i32, pbytes_cap:i32,
    // teacher session state (the scaffold; wiped on disconnect)
    sess_id:i64,
    teach_seq:i64,          // teacher's next seq (this session)
    last_seq:[]u8,          // 6*u64: learner-tracked per-teacher last seq
    sess_halted:i32,        // tripwire halted the session
    // tripwire rolling window (last O_TW_WIN proposals)
    tw_n:i32,               // total proposals seen this session
    tw_s:[]u8,              // 200*u32 span starts
    tw_e:[]u8,              // 200*u32 span ends
    tw_v:[]u8,              // 200*u8 verdict (0 pending,1 ADOPT,2 REVISE,3 REJECT)
    tw_c:[]u8,              // 200*u8 confidence
    tw_stim:i32,            // stimulus length for coverage denominator
    tw_fired:i32,
    // token-count scratch table (teacher OR learner; cleared per use)
    sctab_h:[]u8,           // O_SCTAB*u64 fnv
    sctab_off:[]u8,         // O_SCTAB*u32
    sctab_len:[]u8,         // O_SCTAB*u32 (0 = empty)
    sctab_cnt:[]u8,         // O_SCTAB*u32
    sctab_g1:[]u8,          // O_SCTAB*u32 second occurrence (teacher grounding)
    // appeal tracking: span-hash -> (count, last verdict)
    ap_n:i32,
    ap_h:[]u8,              // 512*u64
    ap_c:[]u8,              // 512*u32 counts
    // ledger + alloc trace
    led:[]u8, led_n:i32, led_cap:i32,
    trace:[]u8, trace_n:i32, trace_cap:i32,
}

fn o_trace_grow(s:*OState,need:i32)void {
    let t:[]u8=s.*.trace;
    if(s.*.trace_n+need < s.*.trace_cap){return;}
    let nc:i32=s.*.trace_cap*2;
    while(s.*.trace_n+need >= nc){nc=nc*2;}
    let nb:[]u8=nio_alloc(nc);
    if(nb.len==nc){
        let i:i32=0;while(i<s.*.trace_n){nb[i]=t[i];i=i+1;}
        nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;
    }
}
fn o_malloc(s:*OState,n:i32)[]u8 {
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    o_trace_grow(s,need);
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn o_free(s:*OState,b:[]u8)void {
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    o_trace_grow(s,need);
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}

fn o_init(s:*OState,slot_cap:i32,led_entries:i32,ins_max:i32,sg_cap:i32,
           wbytes_cap:i32,dcap:i32,pbytes_cap:i32)void {
    // trace FIRST (o_malloc needs it)
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.wn=0;
    s.*.woff=o_malloc(s,O_WCAP*4);s.*.wlen=o_malloc(s,O_WCAP*4);
    s.*.wss=o_malloc(s,O_WCAP*4);s.*.wse=o_malloc(s,O_WCAP*4);
    s.*.wsrc=o_malloc(s,O_WCAP*4);s.*.wtid=o_malloc(s,O_WCAP*4);
    s.*.wseq=o_malloc(s,O_WCAP*4);s.*.wjudge=o_malloc(s,O_WCAP*4);
    let i:i32=0;while(i<O_WCAP){iput(s.*.wjudge,i*4,0);i=i+1;}
    s.*.wbytes=o_malloc(s,wbytes_cap);s.*.wbytes_n=0;s.*.wbytes_cap=wbytes_cap;
    s.*.bkt=o_malloc(s,256*4);s.*.wnext=o_malloc(s,O_WCAP*4);
    i=0;while(i<256){iput(s.*.bkt,i*4,-1);i=i+1;}
    i=0;while(i<O_WCAP){iput(s.*.wnext,i*4,-1);i=i+1;}
    s.*.cap=slot_cap;s.*.nlive=0;s.*.next_uid=1; // uid 0 reserved (invalid)
    s.*.suid=o_malloc(s,slot_cap*4);s.*.spos=o_malloc(s,slot_cap*4);
    s.*.slen=o_malloc(s,slot_cap*4);s.*.scorp=o_malloc(s,slot_cap*4);
    s.*.sseg=o_malloc(s,slot_cap*4);s.*.sflags=o_malloc(s,slot_cap*4);
    s.*.shash=o_malloc(s,slot_cap*8);
    i=0;while(i<slot_cap){iput(s.*.sflags,i*4,0);i=i+1;}
    s.*.sgcap=sg_cap;
    s.*.sgkey=o_malloc(s,sg_cap*4);s.*.sguid=o_malloc(s,sg_cap*4);
    i=0;while(i<sg_cap){iput(s.*.sgkey,i*4,-1);i=i+1;}
    s.*.ins=o_malloc(s,ins_max*4);s.*.ins_n=0;s.*.ins_head=0;s.*.ins_cap=ins_max;
    s.*.dn=0;
    s.*.d_uid=o_malloc(s,dcap*4);s.*.d_shift=o_malloc(s,dcap*4);
    s.*.d_poff=o_malloc(s,dcap*4);s.*.d_plen=o_malloc(s,dcap*4);
    s.*.pbytes=o_malloc(s,pbytes_cap);s.*.pbytes_n=0;s.*.pbytes_cap=pbytes_cap;
    s.*.sess_id=1;s.*.teach_seq=1;s.*.sess_halted=0;
    s.*.last_seq=o_malloc(s,6*8);
    i=0;while(i<6){uput64(s.*.last_seq,i*8,0);i=i+1;}
    s.*.tw_n=0;s.*.tw_stim=0;s.*.tw_fired=0;
    s.*.tw_s=o_malloc(s,O_TW_WIN*4);s.*.tw_e=o_malloc(s,O_TW_WIN*4);
    s.*.tw_v=o_malloc(s,O_TW_WIN);s.*.tw_c=o_malloc(s,O_TW_WIN);
    i=0;while(i<O_TW_WIN){s.*.tw_v[i]=0;i=i+1;}
    s.*.sctab_h=o_malloc(s,O_SCTAB*8);s.*.sctab_off=o_malloc(s,O_SCTAB*4);
    s.*.sctab_len=o_malloc(s,O_SCTAB*4);s.*.sctab_cnt=o_malloc(s,O_SCTAB*4);
    s.*.sctab_g1=o_malloc(s,O_SCTAB*4);
    s.*.ap_n=0;
    s.*.ap_h=o_malloc(s,512*8);s.*.ap_c=o_malloc(s,512*4);
    i=0;while(i<512){iput(s.*.ap_c,i*4,0);i=i+1;}
    s.*.led_cap=led_entries*64;s.*.led=o_malloc(s,s.*.led_cap);s.*.led_n=0;
}
fn o_new(slot_cap:i32,led_entries:i32,ins_max:i32,sg_cap:i32,
         wbytes_cap:i32,dcap:i32,pbytes_cap:i32) OState {
    let s:OState=OState{.wn=0,.woff="",.wlen="",.wss="",.wse="",.wsrc="",
        .wtid="",.wseq="",.wjudge="",.wbytes="",.wbytes_n=0,.wbytes_cap=0,
        .bkt="",.wnext="",.cap=0,.suid="",.spos="",.slen="",.scorp="",.sseg="",
        .sflags="",.shash="",.nlive=0,.next_uid=0,.sgcap=0,.sgkey="",.sguid="",
        .ins="",.ins_n=0,.ins_head=0,.ins_cap=0,.dn=0,.d_uid="",.d_shift="",
        .d_poff="",.d_plen="",.pbytes="",.pbytes_n=0,.pbytes_cap=0,
        .sess_id=0,.teach_seq=0,.last_seq="",.sess_halted=0,
        .tw_n=0,.tw_s="",.tw_e="",.tw_v="",.tw_c="",.tw_stim=0,.tw_fired=0,
        .sctab_h="",.sctab_off="",.sctab_len="",.sctab_cnt="",.sctab_g1="",
        .ap_n=0,.ap_h="",.ap_c="",
        .led="",.led_n=0,.led_cap=0,.trace="",.trace_n=0,.trace_cap=0};
    o_init(&s,slot_cap,led_entries,ins_max,sg_cap,wbytes_cap,dcap,pbytes_cap);
    return s;
}

// ---- ledger ----
fn o_led(s:*OState,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let at:i32=s.*.led_n*64;
    if(at+64>s.*.led_cap){return;}
    let l:[]u8=s.*.led;
    iput(l,at,op);iput(l,at+4,slot);iput(l,at+8,rc);
    iput(l,at+12,b1);iput(l,at+16,b2);iput(l,at+20,b3);iput(l,at+24,b4);iput(l,at+28,b5);
    iput(l,at+32,a1);iput(l,at+36,a2);iput(l,at+40,a3);iput(l,at+44,a4);iput(l,at+48,a5);
    iput(l,at+52,1);iput(l,at+56,d1);iput(l,at+60,d2);
    s.*.led_n=s.*.led_n+1;
}

// ---- file IO ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}

// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"o\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }
fn memcmp_eq(a:[]u8,ao:i32,b:[]u8,bo:i32,n:i32)i32 {
    let i:i32=0;
    while(i<n){if(a[ao+i]!=b[bo+i]){return 0;}i=i+1;}
    return 1;
}
fn fnv1a(src:[]u8,off:i32,len:i32)i64 {
    let h:i64=1469598103934665603;
    let i:i32=0;
    while(i<len){
        h=(h ^ (src[off+i] as i64))*1099511628211;
        i=i+1;
    }
    return h;
}
fn is_ws(c:u8)i32 {
    let x:i32=c as i32;
    if(x==32 || x==9 || x==10 || x==13){return 1;}
    return 0;
}

// Y1 — Negotiated cuts (CUT family). Two-organ cut protocol with mutual veto;
// deadlock -> deliberate adjudication with a round limit (N=3).
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
// One binary; argv[1] selects the trial mode (see ARM_SPEC.md).
// Layout: Y1/cl/arm.zag + Y1/substrate/{R33_NATIVE_SHA256_V2.zag,R33_NATIVE_IO_V1.zag}
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const Y1_GRID:i32=64;
const Y1_C_PROSE:i32=1;
const Y1_C_CODE:i32=2;
const Y1_C_T1P:i32=3;
const Y1_C_T1C:i32=4;
const Y1_C_T2P:i32=5;
const Y1_C_T2C:i32=6;
const Y1_C_T3:i32=7;
const Y1_C_FRESH:i32=8;
const Y1_M3_CAP:i32=4000;
const Y1_M3_V:i32=1000;
const Y1_M3_FRESH1:i32=3000;
const Y1_M3_KILL:i32=3000;
const Y1_M3_FRESH2:i32=4000;
const Y1_M4_N:i32=200;
const Y1_M7_LOOKUPS:i32=5000;
const Y1_KILL_CUTS:i32=10000;
const Y1_SWAP_N:i32=64;

// slot flags
const F_OCC:i32=1;
const F_LIVE:i32=2;
const F_VALUABLE:i32=4;
const F_BDEF:i32=8;    // recorded boundary defect (working span shifted)
const F_CDEF:i32=16;   // recorded content defect (patch)
const F_ADJ:i32=32;    // boundary decided by adjudication
const F_SUP:i32=64;    // superseded by a new-version ID (M7)

// justification enum (frozen by ARM_SPEC.md)
const J_NONE:i32=0;
const J_SPLIT_TOKEN:i32=1;
const J_EXCESS_SHIFT:i32=2;
const J_NO_JOINT:i32=3;
const J_ADJUDICATED:i32=4;

// ledger opcodes (frozen namespace, ARM_INTERFACE.md section 6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TSWAP:i32=19;  // TRAINER_SWAP_PROBE
const OP_TDB:i32=16;
const OP_TDC:i32=17;
const OP_TMV:i32=18;

// ---- little-endian u32/i32 packing on []u8 ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }

// ---- allocator wrappers with trace (addresses never logged) ----
struct Y1 {
    cap:i32,
    ids:[]u8,      // cap * u32: unit id
    offs:[]u8,     // cap * u32: WORKING byte offset (defects mutate)
    lens:[]u8,     // cap * u32: WORKING length
    corps:[]u8,    // cap * u32: corpus id
    flags:[]u8,    // cap * u32: flags bits
    shifts:[]u8,   // cap * i32: recorded boundary shift
    pidx:[]u8,     // cap * i32: patch index or -1
    c_offs:[]u8,   // cap * u32: COMMITTED offset (negotiation result, immutable)
    c_lens:[]u8,   // cap * u32: COMMITTED length
    fwd:[]u8,      // cap * i32: supersede forward link or -1
    patches:[]u8,  // patch_n * 64 bytes
    patch_n:i32,
    patch_cap:i32,
    id2slot:[]u8,  // id_cap * i32: persistent ID -> slot (-1 = dead/never)
    id_cap:i32,
    next_id:i32,   // next fresh unit id (starts at 1)
    next_slot:i32, // bump allocator cursor
    htab_key:[]u8, // htab_cap * i32: (corpus<<24)|idx or -1
    htab_slot:[]u8,// htab_cap * i32: slot
    htab_cap:i32,
    htab_mask:i32,
    led:[]u8,
    led_n:i32,
    led_cap:i32,
    ins:[]u8,      // insertion-order queue of slots (ins_cap * i32)
    ins_cap:i32,
    ins_n:i32,
    ins_head:i32,
    trace:[]u8,
    trace_n:i32,
    trace_cap:i32,
    negotiate_on:i32, // 1 = two-organ protocol; 0 = unilateral (arm-D reference)
    nlive:i32,
}

fn halloc(s:*Y1,n:i32)[]u8 {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn hfree(s:*Y1,b:[]u8)void {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}

fn y_init(s:*Y1,cap:i32,led_entries:i32,ins_max:i32,id_cap:i32,htab_cap:i32,neg_on:i32)void {
    s.*.cap=cap;s.*.nlive=0;s.*.negotiate_on=neg_on;
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.ids=halloc(s,cap*4);s.*.offs=halloc(s,cap*4);s.*.lens=halloc(s,cap*4);
    s.*.corps=halloc(s,cap*4);s.*.flags=halloc(s,cap*4);s.*.shifts=halloc(s,cap*4);
    s.*.pidx=halloc(s,cap*4);s.*.c_offs=halloc(s,cap*4);s.*.c_lens=halloc(s,cap*4);
    s.*.fwd=halloc(s,cap*4);
    let i:i32=0;
    while(i<cap){iput(s.*.pidx,i*4,-1);iput(s.*.fwd,i*4,-1);iput(s.*.flags,i*4,0);i=i+1;}
    s.*.patch_cap=1024;s.*.patches=halloc(s,1024*64);s.*.patch_n=0;
    s.*.id_cap=id_cap;s.*.id2slot=halloc(s,id_cap*4);s.*.next_id=1;
    i=0;while(i<id_cap){iput(s.*.id2slot,i*4,-1);i=i+1;}
    s.*.next_slot=0;
    s.*.htab_cap=htab_cap;s.*.htab_mask=htab_cap-1;
    s.*.htab_key=halloc(s,htab_cap*4);s.*.htab_slot=halloc(s,htab_cap*4);
    i=0;while(i<htab_cap){iput(s.*.htab_key,i*4,-1);i=i+1;}
    s.*.led_cap=led_entries*64;s.*.led=halloc(s,s.*.led_cap);s.*.led_n=0;
    s.*.ins=halloc(s,ins_max*4);s.*.ins_cap=ins_max;s.*.ins_n=0;s.*.ins_head=0;
}
fn y_new(cap:i32,led_entries:i32,ins_max:i32,id_cap:i32,htab_cap:i32,neg_on:i32) Y1 {
    let s:Y1=Y1{.cap=0,.ids="",.offs="",.lens="",.corps="",.flags="",
        .shifts="",.pidx="",.c_offs="",.c_lens="",.fwd="",.patches="",.patch_n=0,
        .patch_cap=0,.id2slot="",.id_cap=0,.next_id=1,.next_slot=0,
        .htab_key="",.htab_slot="",.htab_cap=0,.htab_mask=0,
        .led="",.led_n=0,.led_cap=0,.ins="",.ins_cap=0,.ins_n=0,.ins_head=0,
        .trace="",.trace_n=0,.trace_cap=0,.negotiate_on=1,.nlive=0};
    y_init(&s,cap,led_entries,ins_max,id_cap,htab_cap,neg_on);
    return s;
}

// ---- ledger: 64-byte entries; stage@52=1, d1@56, d2@60 ----
fn y_led(s:*Y1,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let at:i32=s.*.led_n*64;
    if(at+64>s.*.led_cap){return;} // LEDGER-BOUND: scored on what completed
    let l:[]u8=s.*.led;
    iput(l,at,op);iput(l,at+4,slot);iput(l,at+8,rc);
    iput(l,at+12,b1);iput(l,at+16,b2);iput(l,at+20,b3);iput(l,at+24,b4);iput(l,at+28,b5);
    iput(l,at+32,a1);iput(l,at+36,a2);iput(l,at+40,a3);iput(l,at+44,a4);iput(l,at+48,a5);
    iput(l,at+52,1);iput(l,at+56,d1);iput(l,at+60,d2);
    s.*.led_n=s.*.led_n+1;
}

// ---- two-organ negotiation (pure function of corpus bytes) ----
fn is_word(c:u8) i32 {
    let x:i32=c as i32;
    if(x>=48 && x<=57){return 1;}
    if(x>=65 && x<=90){return 1;}
    if(x>=97 && x<=122){return 1;}
    if(x==95){return 1;}
    return 0;
}
fn word_split(buf:[]u8,g:i32) i32 {
    if(g<=0 || g>=buf.len){return 0;}
    if(is_word(buf[g-1])==1 && is_word(buf[g])==1){return 1;}
    return 0;
}
// nearest word joint to g within +-32; returns position or -1
fn nearest_joint(buf:[]u8,g:i32) i32 {
    let bl:i32=-1;let br:i32=-1;
    let p:i32=g-1;
    while(p>=0 && p>=g-32){
        if(is_word(buf[p])==0){bl=p+1;break;}
        p=p-1;
    }
    let q:i32=g;
    while(q<buf.len && q<=g+31){
        if(is_word(buf[q])==0){br=q+1;break;}
        q=q+1;
    }
    if(bl<0 && br<0){return -1;}
    if(bl<0){return br;}
    if(br<0){return bl;}
    let dl:i32=g-bl;let dr:i32=br-g;
    if(dl<=dr){return bl;}
    return br;
}
// distance from p to nearest joint (0 if p is already a joint); 9999 if none
fn joint_dist(buf:[]u8,p:i32) i32 {
    if(word_split(buf,p)==0){return 0;}
    let j:i32=nearest_joint(buf,p);
    if(j<0){return 9999;}
    let d:i32=p-j;if(d<0){d=0-d;}
    return d;
}
fn y_negotiate(buf:[]u8,g:i32,neg_on:i32,r_final:*i32,r_rounds:*i32,
               r_vetoes:*i32,r_just:*i32,r_adj:*i32) void {
    // unilateral reference: fast segmenter decides alone
    if(neg_on==0){
        r_final.*=g;r_rounds.*=1;r_vetoes.*=0;r_just.*=J_NONE;r_adj.*=0;return;
    }
    // round 1: F proposes g; S checks word-split
    if(word_split(buf,g)==0){
        r_final.*=g;r_rounds.*=1;r_vetoes.*=0;r_just.*=J_NONE;r_adj.*=0;return;
    }
    let j:i32=nearest_joint(buf,g);
    if(j<0){
        r_final.*=g;r_rounds.*=1;r_vetoes.*=0;r_just.*=J_NO_JOINT;r_adj.*=0;return;
    }
    // S vetoes + counter-proposes j
    let dj:i32=j-g;if(dj<0){dj=0-dj;}
    if(dj<=16){
        // round 2: F accepts
        r_final.*=j;r_rounds.*=2;r_vetoes.*=1;r_just.*=J_SPLIT_TOKEN;r_adj.*=0;return;
    }
    // round 2: F vetoes + clamped counter
    let c:i32=g+16;
    if(j<g){c=g-16;}
    if(word_split(buf,c)==0){
        r_final.*=c;r_rounds.*=3;r_vetoes.*=2;r_just.*=J_EXCESS_SHIFT;r_adj.*=0;return;
    }
    // round 3: deadlock -> deliberate adjudication.
    // Adjudicator: proposal nearest to a word joint; ties -> F's proposals first.
    let dg:i32=joint_dist(buf,g);
    let dc:i32=joint_dist(buf,c);
    let dj2:i32=joint_dist(buf,j);
    let best:i32=g;let bd:i32=dg;
    if(dc<bd){bd=dc;best=c;}
    if(dj2<bd){best=j;}
    r_final.*=best;r_rounds.*=3;r_vetoes.*=3;r_just.*=J_ADJUDICATED;r_adj.*=1;
}

// ---- slot allocation: bump cursor (pure function of ingest order); lowest free
// scan only under capacity pressure (M3). No free-list: the freelist
// perturbation is an accepted no-op (placement is perturbation-independent).
fn slot_alloc(s:*Y1) i32 {
    if(s.*.next_slot<s.*.cap){
        let sl:i32=s.*.next_slot;
        s.*.next_slot=sl+1;
        return sl;
    }
    let flags:[]u8=s.*.flags;
    let i:i32=0;
    while(i<s.*.cap){
        if(iget(flags,i*4)==0){return i;}
        i=i+1;
    }
    return -1;
}
// ---- (corpus,idx) -> slot hash table (dedup / ID resolution) ----
fn hkey(corpus:i32,idx:i32) i32 { return (corpus<<24)|idx; }
fn y_htab_find(s:*Y1,key:i32) i32 {
    let mask:i32=s.*.htab_mask;
    let kk:[]u8=s.*.htab_key;let vv:[]u8=s.*.htab_slot;
    let x:i64=(key as i64)*2654435761;
    x=x ^ (x>>16);
    let h:i32=(x & (mask as i64)) as i32;
    let t:i32=0;
    while(t<s.*.htab_cap){
        let k:i32=iget(kk,h*4);
        if(k<0){return -1;}
        if(k==key){return iget(vv,h*4);}
        h=h+1;if(h>=s.*.htab_cap){h=0;}t=t+1;
    }
    return -1;
}
fn y_htab_put(s:*Y1,key:i32,slot:i32) void {
    let mask:i32=s.*.htab_mask;
    let kk:[]u8=s.*.htab_key;let vv:[]u8=s.*.htab_slot;
    let x:i64=(key as i64)*2654435761;
    x=x ^ (x>>16);
    let h:i32=(x & (mask as i64)) as i32;
    let t:i32=0;
    while(t<s.*.htab_cap){
        let k:i32=iget(kk,h*4);
        if(k<0 || k==key){iput(kk,h*4,key);iput(vv,h*4,slot);return;}
        h=h+1;if(h>=s.*.htab_cap){h=0;}t=t+1;
    }
}
// resolve an ID to its live slot, following supersede links; -1 if unresolvable
fn y_resolve(s:*Y1,id:i32) i32 {
    if(id<=0 || id>=s.*.next_id){return -1;}
    let sl:i32=iget(s.*.id2slot,id*4);
    if(sl<0){return -1;}
    let f:i32=iget(s.*.flags,sl*4);
    if((f & F_SUP)!=0){
        let ns:i32=iget(s.*.fwd,sl*4);
        if(ns<0){return -1;}
        sl=ns;
        f=iget(s.*.flags,sl*4);
    }
    if((f & F_LIVE)==0){return -1;}
    return sl;
}
// ---- core ops ----
fn y_ingest_unit(s:*Y1,buf:[]u8,orig:[]u8,corpus:i32,idx:i32,
                 left:i32,right:i32,rounds:i32,vetoes:i32,just:i32,adj:i32,
                 grid:i32) i32 {
    // Returns the unit id. Repeated ingestion of identical (corpus,span,bytes)
    // resolves to the SAME id (dedup). Same span but changed bytes -> audited
    // new-version id linked to the old. Returns -1 if the store is full
    // (caller evicts and retries; no id consumed, nothing logged).
    let len:i32=right-left;
    if(len<=0){return -1;}
    let key:i32=hkey(corpus,idx);
    let osl:i32=y_htab_find(s,key);
    if(osl>=0){
        let of:i32=iget(s.*.flags,osl*4);
        if((of & F_LIVE)!=0 && iget(s.*.c_offs,osl*4)==left && iget(s.*.c_lens,osl*4)==len){
            let same:i32=1;
            let q:i32=0;
            while(q<len){if(buf[left+q]!=orig[left+q]){same=0;break;}q=q+1;}
            if(same==1){return iget(s.*.ids,osl*4);}
            // new version
            let nsl:i32=slot_alloc(s);
            if(nsl<0){return -1;}
            if(s.*.next_id>=s.*.id_cap){return -1;}
            let nid:i32=s.*.next_id;s.*.next_id=nid+1;
            let old_id:i32=iget(s.*.ids,osl*4);
            iput(s.*.ids,nsl*4,nid);iput(s.*.offs,nsl*4,left);iput(s.*.lens,nsl*4,len);
            iput(s.*.corps,nsl*4,corpus);
            let nfl:i32=F_OCC|F_LIVE;
            if(adj==1){nfl=nfl|F_ADJ;}
            iput(s.*.flags,nsl*4,nfl);
            iput(s.*.shifts,nsl*4,0);iput(s.*.pidx,nsl*4,-1);
            iput(s.*.c_offs,nsl*4,left);iput(s.*.c_lens,nsl*4,len);
            iput(s.*.fwd,nsl*4,-1);iput(s.*.fwd,osl*4,nsl);
            iput(s.*.flags,osl*4,of|F_SUP);
            iput(s.*.id2slot,nid*4,nsl);
            y_htab_put(s,key,nsl);
            let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,nsl);s.*.ins_n=s.*.ins_n+1;
            s.*.nlive=s.*.nlive+1;
            y_led(s,OP_ADD,nsl,0,left,0,len,corpus,nid,rounds,vetoes,just,adj,old_id,grid,left);
            return nid;
        }
    }
    let nsl2:i32=slot_alloc(s);
    if(nsl2<0){return -1;}
    if(s.*.next_id>=s.*.id_cap){return -1;}
    let nid2:i32=s.*.next_id;s.*.next_id=nid2+1;
    iput(s.*.ids,nsl2*4,nid2);iput(s.*.offs,nsl2*4,left);iput(s.*.lens,nsl2*4,len);
    iput(s.*.corps,nsl2*4,corpus);
    let fl2:i32=F_OCC|F_LIVE;
    if(adj==1){fl2=fl2|F_ADJ;}
    iput(s.*.flags,nsl2*4,fl2);
    iput(s.*.shifts,nsl2*4,0);iput(s.*.pidx,nsl2*4,-1);
    iput(s.*.c_offs,nsl2*4,left);iput(s.*.c_lens,nsl2*4,len);
    iput(s.*.fwd,nsl2*4,-1);
    iput(s.*.id2slot,nid2*4,nsl2);
    y_htab_put(s,key,nsl2);
    let ins2:[]u8=s.*.ins;iput(ins2,s.*.ins_n*4,nsl2);s.*.ins_n=s.*.ins_n+1;
    s.*.nlive=s.*.nlive+1;
    y_led(s,OP_ADD,nsl2,0,left,0,len,corpus,nid2,rounds,vetoes,just,adj,0,grid,left);
    return nid2;
}
fn y_recall(s:*Y1,cbufs:[]u8,coffs:[]u8,clens:[]u8,id:i32,out:[]u8) i32 {
    // resolve id -> slot -> bytes. Returns len, or -1 (loud REFUSE for unknown ids).
    if(id<=0 || id>=s.*.next_id){
        y_led(s,OP_REFUSE,-1,1,0,0,0,0,id,0,0,0,0,0,101,0);
        return -1;
    }
    let sl:i32=y_resolve(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    let len:i32=iget(s.*.lens,sl*4);
    let corpus:i32=iget(s.*.corps,sl*4);
    if((f & F_CDEF)!=0){
        let pi:i32=iget(s.*.pidx,sl*4);
        let pb:[]u8=s.*.patches;
        let i:i32=0;while(i<len){out[i]=pb[pi*64+i];i=i+1;}
        return len;
    }
    let bo:i32=iget(coffs,(corpus-1)*4);
    let bl:i32=iget(clens,(corpus-1)*4);
    let off:i32=iget(s.*.offs,sl*4);
    if((f & F_BDEF)!=0){off=off+iget(s.*.shifts,sl*4);}
    if(off<0){off=0;}
    if(off+len>bo+bl){len=bo+bl-off;}
    if(len<=0){return -1;}
    let i2:i32=0;while(i2<len){out[i2]=cbufs[bo+off+i2];i2=i2+1;}
    return len;
}
fn y_kill(s:*Y1,id:i32,reason:i32) i32 {
    let sl:i32=y_resolve(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    iput(flags,sl*4,0); // slot freed outright; id tombstoned below
    iput(s.*.id2slot,id*4,-1);
    s.*.nlive=s.*.nlive-1;
    y_led(s,OP_KILL,sl,0,0,0,0,0,id,0,0,0,0,0,reason,0);
    return 0;
}
fn y_pin(s:*Y1,id:i32) i32 {
    let sl:i32=y_resolve(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4)|F_VALUABLE);
    y_led(s,OP_PIN,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return 0;
}
fn y_weaken(s:*Y1,id:i32,seq:i32) i32 {
    // Y1's documented policy: weaken is processed as a management annotation
    // (audited). It never changes stored bytes or spans.
    let sl:i32=y_resolve(s,id);
    if(sl<0){
        y_led(s,OP_REFUSE,-1,1,0,0,0,0,id,0,0,0,0,0,102,0);
        return -1;
    }
    y_led(s,OP_WEAKEN,sl,0,0,0,0,0,id,0,0,0,0,0,seq,0);
    return 0;
}
fn y_defect_boundary(s:*Y1,id:i32,delta:i32) i32 {
    let sl:i32=y_resolve(s,id);
    if(sl<0){return -1;}
    iput(s.*.shifts,sl*4,delta);
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4)|F_BDEF);
    y_led(s,OP_TDB,sl,0,0,0,0,0,id,0,0,0,0,0,delta,0);
    return 0;
}
fn y_defect_content(s:*Y1,id:i32,patch:[]u8,plen:i32) i32 {
    let sl:i32=y_resolve(s,id);
    if(sl<0){return -1;}
    if(s.*.patch_n>=s.*.patch_cap){return -1;}
    let pi:i32=s.*.patch_n;
    let pb:[]u8=s.*.patches;
    let i:i32=0;while(i<plen){pb[pi*64+i]=patch[i];i=i+1;}
    while(i<64){pb[pi*64+i]=0;i=i+1;}
    s.*.patch_n=pi+1;
    iput(s.*.pidx,sl*4,pi);
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4)|F_CDEF);
    y_led(s,OP_TDC,sl,0,0,0,0,0,id,0,0,0,0,0,plen,0);
    return 0;
}
fn y_revise(s:*Y1,id:i32) i32 {
    // deliberate repair: restore committed span, drop recorded patch.
    // Returns 1 if a repair happened, 0 if clean, -1 if unresolvable.
    let sl:i32=y_resolve(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & (F_BDEF|F_CDEF))==0){return 0;}
    let old_off:i32=iget(s.*.offs,sl*4);
    if((f & F_BDEF)!=0){old_off=old_off+iget(s.*.shifts,sl*4);}
    iput(s.*.offs,sl*4,iget(s.*.c_offs,sl*4));
    iput(s.*.lens,sl*4,iget(s.*.c_lens,sl*4));
    iput(s.*.shifts,sl*4,0);
    iput(s.*.pidx,sl*4,-1);
    iput(flags,sl*4,f & (0-1-F_BDEF-F_CDEF));
    let new_off:i32=iget(s.*.offs,sl*4);
    y_led(s,OP_REVISE,sl,0,iget(s.*.c_offs,sl*4),0,iget(s.*.c_lens,sl*4),
          iget(s.*.corps,sl*4),id,0,0,0,0,0,old_off,new_off);
    return 1;
}
fn y_evict_oldest_unpinned(s:*Y1) i32 {
    let ins:[]u8=s.*.ins;let flags:[]u8=s.*.flags;
    while(s.*.ins_head<s.*.ins_n){
        let sl:i32=iget(ins,s.*.ins_head*4);
        s.*.ins_head=s.*.ins_head+1;
        let f:i32=iget(flags,sl*4);
        if((f & F_LIVE)!=0 && (f & F_VALUABLE)==0){
            let id:i32=iget(s.*.ids,sl*4);
            iput(flags,sl*4,0);
            iput(s.*.id2slot,id*4,-1);
            s.*.nlive=s.*.nlive-1;
            y_led(s,OP_EVICT,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
            return id;
        }
    }
    return -1;
}
fn y_mark_valuable(s:*Y1,id:i32) i32 {
    y_led(s,OP_TMV,-1,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return y_pin(s,id); // Y1's marking mechanism: pin
}

// ---- file IO ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"y1\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- shared trial helpers ----
fn nunits_of(buflen:i32) i32 { return (buflen+Y1_GRID-1)/Y1_GRID; }
fn reg_set(coffs:[]u8,clens:[]u8,corpus:i32,base:i32,len:i32) void {
    iput(coffs,(corpus-1)*4,base);iput(clens,(corpus-1)*4,len);
}
// negotiate all n+1 boundaries of buf; bounds=(n+1)*u32, bstat=n*4xi32
// bstat[idx] = (rounds, vetoes, just, adj) for unit idx's LEFT boundary.
fn negotiate_all(s:*Y1,buf:[]u8,n:i32,bounds:[]u8,bstat:[]u8) void {
    iput(bounds,0,0);
    iput(bounds,n*4,buf.len);
    let i:i32=0;
    while(i<n){iput(bstat,i*16,0);iput(bstat,i*16+4,0);iput(bstat,i*16+8,0);iput(bstat,i*16+12,0);i=i+1;}
    let b:i32=1;
    while(b<n){
        let g:i32=b*Y1_GRID;
        let fin:i32=0;let r:i32=0;let v:i32=0;let ju:i32=0;let ad:i32=0;
        y_negotiate(buf,g,s.*.negotiate_on,&fin,&r,&v,&ju,&ad);
        iput(bounds,b*4,fin);
        iput(bstat,b*16,r);iput(bstat,b*16+4,v);iput(bstat,b*16+8,ju);iput(bstat,b*16+12,ad);
        b=b+1;
    }
}
// ingest n units of buf (orig = byte-compare source for dedup; usually == buf).
// fills ids_out with the n unit ids. Returns units ingested.
fn ingest_span(s:*Y1,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,orig:[]u8,
               corpus:i32,n:i32,bounds:[]u8,bstat:[]u8,ids_out:[]u8) i32 {
    let i:i32=0;
    while(i<n){
        let left:i32=iget(bounds,i*4);
        let right:i32=iget(bounds,(i+1)*4);
        let grid:i32=i*Y1_GRID;
        let id:i32=y_ingest_unit(s,buf,orig,corpus,i,left,right,
            iget(bstat,i*16),iget(bstat,i*16+4),iget(bstat,i*16+8),iget(bstat,i*16+12),grid);
        if(id<0){return -1;}
        iput(ids_out,i*4,id);
        i=i+1;
    }
    return n;
}
// M1-style probe over ids_out[0..n): content recall + boundary fidelity.
// Swap probes are run separately by the caller (t_m1).
fn probe_ids(s:*Y1,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
             n:i32,ids:[]u8,bout:[]u8,cok:*i32,bok:*i32) void {
    let ok:i32=0;let bo:i32=0;
    let i:i32=0;
    while(i<n){
        let id:i32=iget(ids,i*4);
        let sl:i32=y_resolve(s,id);
        if(sl>=0){
            let len:i32=iget(s.*.lens,sl*4);
            let off:i32=iget(s.*.offs,sl*4);
            let rl:i32=y_recall(s,cbufs,coffs,clens,id,bout);
            if(rl==len){
                let good:i32=1;
                let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
                if(good==1){ok=ok+1;}
            }
            let f:i32=iget(s.*.flags,sl*4);
            if(iget(s.*.offs,sl*4)==iget(s.*.c_offs,sl*4) &&
               iget(s.*.lens,sl*4)==iget(s.*.c_lens,sl*4) &&
               (f & (F_BDEF|F_CDEF))==0){bo=bo+1;}
        }
        i=i+1;
    }
    if(n>0){cok.*=ok*1000/n;bok.*=bo*1000/n;}else{cok.*=0;bok.*=0;}
}
// ---- defect patch builders (frozen) ----
fn patch_prose_xor(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<len){
        let b:u8=buf[off+i];
        if(i%7==0){b=(b as i32 ^ 255) as u8;}
        out[i]=b;i=i+1;
    }
}
fn code_rename(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;while(i<len){out[i]=buf[off+i];i=i+1;}
    let p0:[]u8="sqlite3";let r0:[]u8="sqlite4";
    let p1:[]u8="SQLITE";let r1:[]u8="SQLITF";
    let p2:[]u8="Vdbe";let r2:[]u8="Vdbf";
    let p3:[]u8="Mem";let r3:[]u8="Mfm";
    let p4:[]u8="pBt";let r4:[]u8="pBu";
    let k:i32=0;
    while(k<5){
        let pat:[]u8=p0;let rep:[]u8=r0;
        if(k==1){pat=p1;rep=r1;}
        if(k==2){pat=p2;rep=r2;}
        if(k==3){pat=p3;rep=r3;}
        if(k==4){pat=p4;rep=r4;}
        let pl:i32=pat.len;
        let pos:i32=0;
        while(pos+pl<=len){
            let m:i32=1;let q:i32=0;
            while(q<pl){if(out[pos+q]!=pat[q]){m=0;break;}q=q+1;}
            if(m==1){q=0;while(q<pl){out[pos+q]=rep[q];q=q+1;}pos=pos+pl;}
            else{pos=pos+1;}
        }
        k=k+1;
    }
}
fn plant_defects(s:*Y1,buf:[]u8,corpus:i32,n:i32,ids:[]u8,bounds:[]u8,
                 is_code:i32,nd:i32,patch:[]u8,cyc:[]u8,d_idx:[]u8) void {
    let j:i32=0;
    while(j<nd){
        let idx:i32=j*n/nd;
        iput(d_idx,j*4,idx);
        let id:i32=iget(ids,idx*4);
        if(j<nd/2){
            y_defect_boundary(s,id,iget(cyc,(j%12)*4));
        }else{
            let off:i32=iget(bounds,idx*4);
            let right:i32=iget(bounds,(idx+1)*4);
            let len:i32=right-off;
            if(is_code==1){code_rename(buf,off,len,patch);}
            else{patch_prose_xor(buf,off,len,patch);}
            y_defect_content(s,id,patch,len);
        }
        j=j+1;
    }
}
fn make_cyc(s:*Y1) []u8 {
    let cyc:[]u8=halloc(s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    return cyc;
}
// verify a defect-curriculum unit is fully repaired
fn unit_verified(s:*Y1,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,
                 ids:[]u8,bounds:[]u8,idx:i32,bout:[]u8) i32 {
    let id:i32=iget(ids,idx*4);
    let sl:i32=y_resolve(s,id);
    if(sl<0){return 0;}
    let f:i32=iget(s.*.flags,sl*4);
    if((f & (F_BDEF|F_CDEF))!=0){return 0;}
    if(iget(s.*.ids,sl*4)!=id){return 0;}
    let off:i32=iget(bounds,idx*4);
    let len:i32=iget(bounds,(idx+1)*4)-off;
    if(iget(s.*.offs,sl*4)!=off || iget(s.*.lens,sl*4)!=len){return 0;}
    let rl:i32=y_recall(s,cbufs,coffs,clens,id,bout);
    if(rl!=len){return 0;}
    let i:i32=0;while(i<len){if(bout[i]!=buf[off+i]){return 0;}i=i+1;}
    return 1;
}
fn revise_curriculum(s:*Y1,ids:[]u8,d_idx:[]u8,nd:i32,
                     cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,
                     bounds:[]u8,bout:[]u8,
                     r_rep_b:*i32,r_rep_c:*i32,r_ep:*i32) void {
    let rep_b:i32=0;let rep_c:i32=0;
    let ep:i32=1;
    while(ep<=20){
        let j:i32=0;
        while(j<nd){
            y_revise(s,iget(ids,iget(d_idx,j*4)*4));
            j=j+1;
        }
        rep_b=0;rep_c=0;
        j=0;
        while(j<nd/2){
            rep_b=rep_b+unit_verified(s,cbufs,coffs,clens,buf,ids,bounds,iget(d_idx,j*4),bout);
            j=j+1;
        }
        j=nd/2;
        while(j<nd){
            rep_c=rep_c+unit_verified(s,cbufs,coffs,clens,buf,ids,bounds,iget(d_idx,j*4),bout);
            j=j+1;
        }
        if(rep_b+rep_c>=nd){break;}
        ep=ep+1;
    }
    r_rep_b.*=rep_b;r_rep_c.*=rep_c;r_ep.*=ep;
}

// ---- M1: single-corpus perfect-recall + provisional N=64 swap probe ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,keyp:[]u8,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(buf.len);
    let s:Y1=y_new(n+n/4+2048,n+4096,n+1024,n+n/4+4096,262144,1);
    let bout:[]u8=halloc(&s,256);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    let bounds:[]u8=halloc(&s,(n+1)*4);
    let bstat:[]u8=halloc(&s,n*16);
    negotiate_all(&s,buf,n,bounds,bstat);
    // veto rate over the first 1000 cuts (informational here; binding in kill-1x)
    let veto1000:i32=0;let cut1000:i32=0;
    let b:i32=1;
    while(b<n && cut1000<1000){
        if(iget(bstat,b*16+4)>0){veto1000=veto1000+1;}
        cut1000=cut1000+1;b=b+1;
    }
    let ids:[]u8=halloc(&s,n*4);
    if(ingest_span(&s,buf,coffs,clens,buf,buf,corpus,n,bounds,bstat,ids)<0){
        _zag_println("M1,FATAL,ingest-full");return;
    }
    // recall loop with provisional swap probes
    let cok:i32=0;let bok:i32=0;
    let ok:i32=0;let bo:i32=0;
    let interval:i32=(n+Y1_SWAP_N-1)/Y1_SWAP_N;
    if(interval<1){interval=1;}
    let probes_done:i32=0;let probe_ok:i32=0;
    let recalls_done:i32=0;
    let i:i32=0;
    while(i<n){
        let id:i32=iget(ids,i*4);
        let sl:i32=y_resolve(&s,id);
        if(sl>=0){
            let len:i32=iget(s.lens,sl*4);
            let off:i32=iget(s.offs,sl*4);
            let rl:i32=y_recall(&s,buf,coffs,clens,id,bout);
            if(rl==len){
                let good:i32=1;
                let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
                if(good==1){ok=ok+1;}
            }
            let f:i32=iget(s.flags,sl*4);
            if(iget(s.offs,sl*4)==iget(s.c_offs,sl*4) &&
               iget(s.lens,sl*4)==iget(s.c_lens,sl*4) &&
               (f & (F_BDEF|F_CDEF))==0){bo=bo+1;}
        }
        recalls_done=recalls_done+1;
        // provisional swap probe: after every ceil(n/64) recalls
        let want:i32=(probes_done+1)*interval;
        if(want>n){want=n;}
        if(probes_done<Y1_SWAP_N && recalls_done==want){
            let tidx:i32=(i+1)%n;
            let tid:i32=iget(ids,tidx*4);
            let osl:i32=y_resolve(&s,tid);
            if(osl>=0){
                // literal (slot+1)%nslots, forward-scanned to the next live slot
                // (M1 has no kills; the scan only matters at the wrap boundary)
                let rsl:i32=(osl+1)%s.cap;
                let t2:i32=0;
                while(t2<s.cap){
                    let rf:i32=iget(s.flags,rsl*4);
                    if((rf & F_LIVE)!=0){break;}
                    rsl=rsl+1;if(rsl>=s.cap){rsl=0;}t2=t2+1;
                }
                y_led(&s,OP_TSWAP,rsl,0,0,0,0,0,tid,0,0,0,0,0,probes_done+1,rsl);
                iput(s.id2slot,tid*4,rsl);
                let rl2:i32=y_recall(&s,buf,coffs,clens,tid,bout);
                let rlen:i32=iget(s.lens,rsl*4);
                let roff:i32=iget(s.offs,rsl*4);
                let pass:i32=0;
                if(rl2==rlen){
                    pass=1;
                    let q:i32=0;
                    while(q<rlen){if(bout[q]!=buf[roff+q]){pass=0;break;}q=q+1;}
                }
                if(pass==1){probe_ok=probe_ok+1;}
                iput(s.id2slot,tid*4,osl); // restore
            }
            probes_done=probes_done+1;
        }
        i=i+1;
    }
    if(n>0){cok=ok*1000/n;bok=bo*1000/n;}
    let veto_t:i64=0;
    if(cut1000>0){veto_t=(veto1000 as i64)*1000/(cut1000 as i64);}
    _zag_print("M1,");
    _zag_print(fname);_zag_print(",");
    p_dec1(cok as i64);_zag_print(",");p_dec1(bok as i64);
    _zag_print(",");p_i64(n as i64);
    _zag_print(",swap=");p_i64(probe_ok as i64);_zag_print("/");p_i64(probes_done as i64);
    _zag_println("");
    let f:i32=0;
    j_begin(jmode);
    jf_dec1(&f,"m1_recall_tenths",cok as i64);
    jf_dec1(&f,"m1_boundary_tenths",bok as i64);
    jf_int(&f,"m1_units",n as i64);
    jf_str(&f,"m1_corpus",keyp);
    if(probe_ok==Y1_SWAP_N && probes_done==Y1_SWAP_N){
        jf_str(&f,"m1_id_probe","PASS (PROVISIONAL-PENDING-FREEZE)");
    }else{
        jf_str(&f,"m1_id_probe","FAIL (PROVISIONAL-PENDING-FREEZE)");
    }
    jf_dec1(&f,"y1_veto_rate_tenths",veto_t);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,bounds);hfree(&s,bstat);hfree(&s,ids);
}

// ---- M2: tiered curriculum (returns ETC; emits M9 for t1 tiers) ----
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(buf.len);
    let s:Y1=y_new(n+n/4+2048,n+256,n+1024,n+n/4+4096,262144,1);
    let bout:[]u8=halloc(&s,256);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    let bounds:[]u8=halloc(&s,(n+1)*4);
    let bstat:[]u8=halloc(&s,n*16);
    negotiate_all(&s,buf,n,bounds,bstat);
    let ids:[]u8=halloc(&s,n*4);
    let cok:i32=0;let bok:i32=0;
    probe_ids(&s,buf,coffs,clens,buf,corpus,n,ids,bout,&cok,&bok);
    let r0:i64=cok as i64;
    let rs:[]u8=halloc(&s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i32=cok;let bc:i32=bok;
    while(e<=50){
        if(ingest_span(&s,buf,coffs,clens,buf,buf,corpus,n,bounds,bstat,ids)<0){
            _zag_println("M2,FATAL,ingest-full");return;
        }
        probe_ids(&s,buf,coffs,clens,buf,corpus,n,ids,bout,&cok,&bok);
        iput(rs,e*4,cok);
        nep=e+1;
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc=cok;bc=bok;break;}
        rc=cok;bc=bok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(jmode);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        let npts:i32=nep;
        let takeoff:i32=npts;
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){
        j_end();
    }
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,bounds);hfree(&s,bstat);hfree(&s,ids);hfree(&s,rs);
}

// ---- M3: strength trial ----
fn t_m3(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let nun_f:i32=nunits_of(fresh.len);
    let total:i32=nun_p+nun_c;
    let k:i32=total/Y1_M3_V;
    if(k<1){k=1;}
    let s:Y1=y_new(Y1_M3_CAP,40000,12000,16384,32768,1);
    let bout:[]u8=halloc(&s,256);
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(coffs,clens,Y1_C_PROSE,0,prose.len);
    reg_set(coffs,clens,Y1_C_CODE,prose.len,code.len);
    reg_set(coffs,clens,Y1_C_FRESH,prose.len+code.len,fresh.len);
    // negotiate prose + code boundaries once
    let pb:[]u8=halloc(&s,(nun_p+1)*4);let pbs:[]u8=halloc(&s,nun_p*16);
    negotiate_all(&s,prose,nun_p,pb,pbs);
    let cb:[]u8=halloc(&s,(nun_c+1)*4);let cbs:[]u8=halloc(&s,nun_c*16);
    negotiate_all(&s,code,nun_c,cb,cbs);
    let fb:[]u8=halloc(&s,(nun_f+1)*4);let fbs:[]u8=halloc(&s,nun_f*16);
    negotiate_all(&s,fresh,nun_f,fb,fbs);
    // V: ingest + mark
    let v_ids:[]u8=halloc(&s,Y1_M3_V*4);
    let v:i32=0;
    while(v<Y1_M3_V){
        let g:i32=v*k;
        let cid:i32=Y1_C_PROSE;let idx:i32=g;
        let bb:[]u8=pb;let bs:[]u8=pbs;let buf:[]u8=prose;
        if(g>=nun_p){cid=Y1_C_CODE;idx=g-nun_p;bb=cb;bs=cbs;buf=code;}
        let left:i32=iget(bb,idx*4);let right:i32=iget(bb,(idx+1)*4);
        let id:i32=y_ingest_unit(&s,buf,buf,cid,idx,left,right,
            iget(bs,idx*16),iget(bs,idx*16+4),iget(bs,idx*16+8),iget(bs,idx*16+12),idx*Y1_GRID);
        if(id<0){_zag_println("M3,FATAL,ingest-full");return;}
        y_mark_valuable(&s,id);
        iput(v_ids,v*4,id);
        v=v+1;
    }
    // phase 1: 3000 fresh ingests
    let fids:[]u8=halloc(&s,Y1_M3_FRESH1*4);
    let f:i32=0;
    while(f<Y1_M3_FRESH1){
        let left:i32=iget(fb,f*4);let right:i32=iget(fb,(f+1)*4);
        let id:i32=y_ingest_unit(&s,fresh,fresh,Y1_C_FRESH,f,left,right,
            iget(fbs,f*16),iget(fbs,f*16+4),iget(fbs,f*16+8),iget(fbs,f*16+12),f*Y1_GRID);
        if(id<0){_zag_println("M3,FATAL,ingest-full");return;}
        iput(fids,f*4,id);
        f=f+1;
    }
    let n_p1:i32=s.led_n;
    // phase 2: 3000 fresh-only kills
    f=0;
    while(f<Y1_M3_KILL){y_kill(&s,iget(fids,f*4),1);f=f+1;}
    // weaken probe: 50 weaken ops on every 20th valuable
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        let vj:i32=w*20;
        if(y_weaken(&s,iget(v_ids,vj*4),w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let n_p2:i32=s.led_n;
    // phase 3: 4000 ingests at capacity, evict-oldest-unpinned as needed
    let f2ids:[]u8=halloc(&s,Y1_M3_FRESH2*4);
    f=Y1_M3_FRESH1;
    while(f<Y1_M3_FRESH1+Y1_M3_FRESH2){
        let left:i32=iget(fb,f*4);let right:i32=iget(fb,(f+1)*4);
        let id:i32=y_ingest_unit(&s,fresh,fresh,Y1_C_FRESH,f,left,right,
            iget(fbs,f*16),iget(fbs,f*16+4),iget(fbs,f*16+8),iget(fbs,f*16+12),f*Y1_GRID);
        if(id<0){
            y_evict_oldest_unpinned(&s);
            id=y_ingest_unit(&s,fresh,fresh,Y1_C_FRESH,f,left,right,
                iget(fbs,f*16),iget(fbs,f*16+4),iget(fbs,f*16+8),iget(fbs,f*16+12),f*Y1_GRID);
        }
        if(id<0){_zag_println("M3,FATAL,ingest-full");return;}
        iput(f2ids,(f-Y1_M3_FRESH1)*4,id);
        f=f+1;
    }
    let n_p3:i32=s.led_n;
    // metrics: V survival
    let surv_ok:i32=0;
    v=0;
    while(v<Y1_M3_V){
        let id:i32=iget(v_ids,v*4);
        let sl:i32=y_resolve(&s,id);
        if(sl>=0){
            let len:i32=iget(s.lens,sl*4);
            let off:i32=iget(s.offs,sl*4);
            let cid:i32=iget(s.corps,sl*4);
            let buf:[]u8=prose;if(cid==Y1_C_CODE){buf=code;}
            let rl:i32=y_recall(&s,cbufs,coffs,clens,id,bout);
            if(rl==len){
                let good:i32=1;let q:i32=0;
                while(q<len){if(bout[q]!=buf[off+q]){good=0;break;}q=q+1;}
                if(good==1){surv_ok=surv_ok+1;}
            }
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(Y1_M3_V as i64);
    // fresh sample: last 500 ingested (phase-3 ids 3500..3999)
    let fs_ok:i32=0;
    f=Y1_M3_FRESH2-500;
    while(f<Y1_M3_FRESH2){
        let id:i32=iget(f2ids,f*4);
        let sl:i32=y_resolve(&s,id);
        if(sl>=0){
            let len:i32=iget(s.lens,sl*4);
            let off:i32=iget(s.offs,sl*4);
            let rl:i32=y_recall(&s,cbufs,coffs,clens,id,bout);
            if(rl==len){
                let good:i32=1;let q:i32=0;
                while(q<len){if(bout[q]!=fresh[off+q]){good=0;break;}q=q+1;}
                if(good==1){fs_ok=fs_ok+1;}
            }
        }
        f=f+1;
    }
    let fresht:i64=(fs_ok as i64)*1000/500;
    let mgmt:i32=0;let le:i32=n_p1;
    while(le<n_p3){
        let op:i32=iget(s.led,le*64);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_PROMOTE || op==OP_EVICT || op==OP_REFUSE){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let ff:i32=0;
    j_begin("m3-1x");
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",Y1_M3_V as i64);
    j_end();
    hfree(&s,bout);hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,pb);hfree(&s,pbs);hfree(&s,cb);hfree(&s,cbs);hfree(&s,fb);hfree(&s,fbs);
    hfree(&s,v_ids);hfree(&s,fids);hfree(&s,f2ids);
}

// ---- M4: defect revision ----
fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,is_code:i32,keyp:[]u8,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(buf.len);
    let s:Y1=y_new(n+n/4+2048,n+8192,n+1024,n+n/4+4096,262144,1);
    let bout:[]u8=halloc(&s,256);
    let patch:[]u8=halloc(&s,256);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    let bounds:[]u8=halloc(&s,(n+1)*4);
    let bstat:[]u8=halloc(&s,n*16);
    negotiate_all(&s,buf,n,bounds,bstat);
    let ids:[]u8=halloc(&s,n*4);
    if(ingest_span(&s,buf,coffs,clens,buf,buf,corpus,n,bounds,bstat,ids)<0){
        _zag_println("M4,FATAL,ingest-full");return;
    }
    let d_idx:[]u8=halloc(&s,Y1_M4_N*4);
    let cyc:[]u8=make_cyc(&s);
    plant_defects(&s,buf,corpus,n,ids,bounds,is_code,Y1_M4_N,patch,cyc,d_idx);
    let rep_b:i32=0;let rep_c:i32=0;let ep:i32=1;
    revise_curriculum(&s,ids,d_idx,Y1_M4_N,buf,coffs,clens,buf,bounds,bout,
                      &rep_b,&rep_c,&ep);
    let killed:i32=0;
    let j:i32=0;
    while(j<Y1_M4_N){
        let id:i32=iget(ids,iget(d_idx,j*4)*4);
        if(y_resolve(&s,id)<0){killed=killed+1;}
        j=j+1;
    }
    let rev_bt:i64=(rep_b as i64)*1000/100;
    let rev_ct:i64=(rep_c as i64)*1000/100;
    let kill_t:i64=(killed as i64)*1000/(Y1_M4_N as i64);
    let ksub:i32=0;
    if(kill_t>500 && (rev_bt<800 || rev_ct<800)){ksub=1;}
    _zag_print("M4,");_zag_print(keyp);_zag_print(",");
    p_dec1(rev_bt);_zag_print(",");p_dec1(rev_ct);_zag_print(",");
    p_dec1(kill_t);_zag_print(",");p_i64(ksub as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode);
    jf_dec1(&f,"m4_rev_boundary_tenths",rev_bt);
    jf_dec1(&f,"m4_rev_content_tenths",rev_ct);
    jf_dec1(&f,"m4_kill_rate_tenths",kill_t);
    jf_bool(&f,"m4_killsub",ksub);
    jf_int(&f,"m4_episodes",ep as i64);
    j_end();
    hfree(&s,bout);hfree(&s,patch);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,bounds);hfree(&s,bstat);hfree(&s,ids);hfree(&s,cyc);hfree(&s,d_idx);
}

// ---- M5: resource pressure ----
fn t_m5(cdir:[]u8,baseline:i32) void {
    let psz:i64=file_size(cdir,"prose.bin");
    if(psz<=0){_zag_println("M5,FATAL,empty-corpus");return;}
    let pn:i32=nunits_of(psz as i32);
    let cap:i32=pn+pn/4+4096;
    let idc:i32=cap+4096;
    if(baseline==1){
        // Empty-store RSS baseline: allocate the same empty store m5-1x uses,
        // touch it, then spin briefly so the harness RSS sampler can observe
        // the peak. The spin is measurement scaffolding, not arm cognition.
        let bs:Y1=y_new(cap,pn+4096,pn+2048,idc,262144,1);
        let b0:[]u8=bs.ids;let b1:[]u8=bs.offs;let b2:[]u8=bs.lens;let b3:[]u8=bs.corps;
        let b4:[]u8=bs.flags;let b5:[]u8=bs.shifts;let b6:[]u8=bs.pidx;
        let b7:[]u8=bs.c_offs;let b8:[]u8=bs.c_lens;let b9:[]u8=bs.fwd;
        let b10:[]u8=bs.id2slot;let b11:[]u8=bs.ins;
        let bj:i32=0;
        while(bj<b0.len){b0[bj]=0;b1[bj]=0;b2[bj]=0;b3[bj]=0;b4[bj]=0;b5[bj]=0;
            b6[bj]=0;b7[bj]=0;b8[bj]=0;b9[bj]=0;bj=bj+1;}
        bj=0;while(bj<b10.len){b10[bj]=0;bj=bj+1;}
        bj=0;while(bj<b11.len){b11[bj]=0;bj=bj+1;}
        _zag_println("M5_BASELINE,ok");
        let f:i32=0;
        j_begin("m5-baseline");
        jf_bool(&f,"m5_baseline",1);
        j_end();
        let spin:i64=0;while(spin<300000000){spin=spin+1;}
        return;
    }
    let prose:[]u8=read_file(cdir,"prose.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(prose.len);
    let nun_f:i32=nunits_of(fresh.len);
    let s:Y1=y_new(cap,pn+4096,pn+2048,idc,262144,1);
    let bout:[]u8=halloc(&s,256);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Y1_C_PROSE,0,prose.len);
    reg_set(coffs,clens,Y1_C_FRESH,0,fresh.len);
    let bounds:[]u8=halloc(&s,(n+1)*4);
    let bstat:[]u8=halloc(&s,n*16);
    negotiate_all(&s,prose,n,bounds,bstat);
    let ids:[]u8=halloc(&s,n*4);
    if(ingest_span(&s,prose,coffs,clens,prose,prose,Y1_C_PROSE,n,bounds,bstat,ids)<0){
        _zag_println("M5,FATAL,ingest-full");return;
    }
    let fb:[]u8=halloc(&s,(nun_f+1)*4);let fbs:[]u8=halloc(&s,nun_f*16);
    negotiate_all(&s,fresh,nun_f,fb,fbs);
    let fids:[]u8=halloc(&s,500*4);
    let f:i32=0;
    while(f<500){
        let left:i32=iget(fb,f*4);let right:i32=iget(fb,(f+1)*4);
        let id:i32=y_ingest_unit(&s,fresh,fresh,Y1_C_FRESH,f,left,right,
            iget(fbs,f*16),iget(fbs,f*16+4),iget(fbs,f*16+8),iget(fbs,f*16+12),f*Y1_GRID);
        iput(fids,f*4,id);
        f=f+1;
    }
    f=0;
    while(f<500){y_kill(&s,iget(fids,f*4),2);f=f+1;}
    let l:i32=0;let src:i64=0;
    let i2:i32=0;
    while(i2<n){
        let id:i32=iget(ids,i2*4);
        let sl:i32=y_resolve(&s,id);
        if(sl>=0){
            let len:i32=iget(s.lens,sl*4);
            let off:i32=iget(s.offs,sl*4);
            let rl:i32=y_recall(&s,prose,coffs,clens,id,bout);
            if(rl==len){
                let good:i32=1;let q:i32=0;
                while(q<len){if(bout[q]!=prose[off+q]){good=0;break;}q=q+1;}
                if(good==1){l=l+1;src=src+(len as i64);}
            }
        }
        i2=i2+1;
    }
    let slot_bytes:i64=(s.cap as i64)*40+(s.id_cap as i64)*4+(s.ins_cap as i64)*4;
    let ledger_bytes:i64=(s.led_n as i64)*64;
    let wf:i32=write_file(".","ledger.bin",s.led[0..s.led_n*64]);
    _zag_print("M5,");p_i64(l as i64);_zag_print(",");
    p_i64(src);_zag_print(",");p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin("m5-1x");
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",prose.len as i64);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,bounds);hfree(&s,bstat);hfree(&s,ids);hfree(&s,fb);hfree(&s,fbs);
    hfree(&s,fids);
}

// ---- M6: transfer tax ----
fn t_m6(cdir:[]u8,dir:i32) void {
    let tname:[]u8="t1_prose.bin";let tcid:i32=Y1_C_T1P;
    let yname:[]u8="code.bin";let ycid:i32=Y1_C_CODE;
    let dkey:[]u8="m6-p2c-1x";let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=Y1_C_T1C;yname="prose.bin";ycid=Y1_C_PROSE;
        dkey="m6-c2p-1x";dtag="c2p";
    }
    let tbuf:[]u8=read_file(cdir,tname);
    let ybuf:[]u8=read_file(cdir,yname);
    if(tbuf.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let nt:i32=nunits_of(tbuf.len);let ny:i32=nunits_of(ybuf.len);
    let cap:i32=nt+ny+(nt+ny)/4+8192;
    let s:Y1=y_new(cap,nt+ny+8192,nt+ny+2048,cap+4096,524288,1);
    let bout:[]u8=halloc(&s,256);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,tcid,0,tbuf.len);
    reg_set(coffs,clens,ycid,0,ybuf.len);
    let tb:[]u8=halloc(&s,(nt+1)*4);let tbs:[]u8=halloc(&s,nt*16);
    negotiate_all(&s,tbuf,nt,tb,tbs);
    let tids:[]u8=halloc(&s,nt*4);
    let cok:i32=0;let bok:i32=0;
    let e:i32=1;let consec:i32=0;
    while(e<=50){
        if(ingest_span(&s,tbuf,coffs,clens,tbuf,tbuf,tcid,nt,tb,tbs,tids)<0){
            _zag_println("M6,FATAL,ingest-full");return;
        }
        probe_ids(&s,tbuf,coffs,clens,tbuf,tcid,nt,tids,bout,&cok,&bok);
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){break;}
        e=e+1;
    }
    let rec_d:i64=cok as i64;let bnd_d:i64=bok as i64;
    let cyc:[]u8=make_cyc(&s);
    let j:i32=0;
    while(j<100){
        let idx:i32=j*nt/100;
        y_defect_boundary(&s,iget(tids,idx*4),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){y_revise(&s,iget(tids,(j*nt/100)*4));j=j+1;}
    let rev_d:i32=0;
    j=0;
    while(j<100){
        rev_d=rev_d+unit_verified(&s,tbuf,coffs,clens,tbuf,tids,tb,j*nt/100,bout);
        j=j+1;
    }
    let rev_dt:i64=(rev_d as i64)*10;
    let yb:[]u8=halloc(&s,(ny+1)*4);let ybs:[]u8=halloc(&s,ny*16);
    negotiate_all(&s,ybuf,ny,yb,ybs);
    let yids:[]u8=halloc(&s,ny*4);
    if(ingest_span(&s,ybuf,coffs,clens,ybuf,ybuf,ycid,ny,yb,ybs,yids)<0){
        _zag_println("M6,FATAL,ingest-full");return;
    }
    let rec_t:i32=0;let bnd_t:i32=0;
    probe_ids(&s,ybuf,coffs,clens,ybuf,ycid,ny,yids,bout,&rec_t,&bnd_t);
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        y_defect_boundary(&s,iget(yids,idx*4),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){y_revise(&s,iget(yids,(j*ny/100)*4));j=j+1;}
    let rev_t:i32=0;
    j=0;
    while(j<100){
        rev_t=rev_t+unit_verified(&s,ybuf,coffs,clens,ybuf,yids,yb,j*ny/100,bout);
        j=j+1;
    }
    let rev_tt:i64=(rev_t as i64)*10;
    let tax:i64=((rec_d-(rec_t as i64))+((bnd_d-(bnd_t as i64)))+(rev_dt-rev_tt))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t as i64);_zag_print(",");p_dec1(bnd_t as i64);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_println("");
    let f:i32=0;
    j_begin(dkey);
    let g:i32=0;
    jf_dec1(&g,"rec_tenths",rec_t as i64);
    jf_dec1(&g,"bnd_tenths",bnd_t as i64);
    jf_dec1(&g,"rev_tenths",rev_tt);
    jf_dec1(&g,"tax_tenths",tax);
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);hfree(&s,cyc);
    hfree(&s,tb);hfree(&s,tbs);hfree(&s,tids);
    hfree(&s,yb);hfree(&s,ybs);hfree(&s,yids);
}

// ---- M7: ID-arm rig ----
fn t_m7(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let n:i32=nunits_of(prose.len);
    let cap:i32=n+n/100+4096;
    let s:Y1=y_new(cap,n+n/100+4096,n+2048,cap+4096,262144,1);
    let bout:[]u8=halloc(&s,256);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Y1_C_PROSE,0,prose.len);
    let bounds:[]u8=halloc(&s,(n+1)*4);
    let bstat:[]u8=halloc(&s,n*16);
    negotiate_all(&s,prose,n,bounds,bstat);
    let ids:[]u8=halloc(&s,n*4);
    // round 0: ingest C
    if(ingest_span(&s,prose,coffs,clens,prose,prose,Y1_C_PROSE,n,bounds,bstat,ids)<0){
        _zag_println("M7,FATAL,ingest-full");return;
    }
    let hits:i32=0;let reread:i64=0;
    let refs:i64=0; // id references: ingests + lookups
    refs=n as i64;
    let l:i32=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let osl:i32=y_htab_find(&s,hkey(Y1_C_PROSE,idx));
        if(osl>=0){
            let id:i32=iget(s.ids,osl*4);
            refs=refs+1;
            let sl:i32=y_resolve(&s,id);
            if(sl>=0){
                let rl:i32=y_recall(&s,prose,coffs,clens,id,bout);
                if(rl>0){hits=hits+1;reread=reread+(rl as i64);}
            }
        }
        l=l+1;
    }
    // round 1: ingest C again (dedup: same ids)
    let id_before_r1:i32=s.next_id;
    if(ingest_span(&s,prose,coffs,clens,prose,prose,Y1_C_PROSE,n,bounds,bstat,ids)<0){
        _zag_println("M7,FATAL,ingest-full");return;
    }
    refs=refs+(n as i64);
    while(l<1666+1667){
        let idx:i32=(l*37)%n;
        let osl:i32=y_htab_find(&s,hkey(Y1_C_PROSE,idx));
        if(osl>=0){
            let id:i32=iget(s.ids,osl*4);
            refs=refs+1;
            let sl:i32=y_resolve(&s,id);
            if(sl>=0){
                let rl:i32=y_recall(&s,prose,coffs,clens,id,bout);
                if(rl>0){hits=hits+1;reread=reread+(rl as i64);}
            }
        }
        l=l+1;
    }
    // round 2: C' = C with deterministic every-100th-unit edits (A7/A8 provisional)
    let cp:[]u8=halloc(&s,prose.len);
    let q:i32=0;
    while(q<prose.len){cp[q]=prose[q];q=q+1;}
    q=0;
    while(q<n){
        if(q%100==0){
            let off:i32=iget(bounds,q*4);
            cp[off]=(cp[off] as i32 ^ 255) as u8;
        }
        q=q+1;
    }
    let ids2:[]u8=halloc(&s,n*4);
    if(ingest_span(&s,cp,coffs,clens,cp,prose,Y1_C_PROSE,n,bounds,bstat,ids2)<0){
        _zag_println("M7,FATAL,ingest-full");return;
    }
    refs=refs+(n as i64);
    while(l<Y1_M7_LOOKUPS){
        let idx:i32=(l*37)%n;
        let osl:i32=y_htab_find(&s,hkey(Y1_C_PROSE,idx));
        if(osl>=0){
            let id:i32=iget(s.ids,osl*4);
            refs=refs+1;
            let sl:i32=y_resolve(&s,id);
            if(sl>=0){
                // round-2 lookups read from C': edited units return edited bytes
                let rl:i32=y_recall(&s,cp,coffs,clens,id,bout);
                if(rl>0){hits=hits+1;reread=reread+(rl as i64);}
            }
        }
        l=l+1;
    }
    let hit_t:i64=(hits as i64)*1000/(Y1_M7_LOOKUPS as i64);
    // distinct live ids: measured new slots across rounds 1-2 (round 0 = n)
    let new_slots:i64=(s.next_id-id_before_r1) as i64;
    let distinct:i64=(n as i64)+new_slots;
    let reuse_t:i64=refs*10/distinct;
    // dedup over rounds 1-2: 2n ingested, new_slots distinct new stored
    let dedup_ratio_t:i64=((2*(n as i64))-new_slots)*1000/(2*(n as i64));
    let dedup_bytes:i64=((2*(n as i64))-new_slots)*64;
    _zag_print("M7,id,");p_dec1(hit_t);_zag_print(",");
    p_dec1(reuse_t);_zag_print(",");p_dec1(dedup_ratio_t);_zag_print(",");
    p_i64(reread);_zag_println("");
    let f:i32=0;
    j_begin("m7-1x");
    jf_dec1(&f,"m7_hit_rate_tenths",hit_t);
    jf_dec1(&f,"m7_reuse_rate_tenths",reuse_t);
    jf_int(&f,"m7_dedup_savings_bytes",dedup_bytes);
    jf_int(&f,"y1_m7_dedup_ratio_tenths",dedup_ratio_t);
    jf_int(&f,"m7_reread_bytes",reread);
    jf_str(&f,"m7_provisional","PROVISIONAL-PENDING-FREEZE(A7/A8)");
    j_end();
    hfree(&s,bout);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,bounds);hfree(&s,bstat);hfree(&s,ids);hfree(&s,ids2);hfree(&s,cp);
}

// ---- M8: determinism gate ----
fn img_append(dst:[]u8,at:i32,src:[]u8,n:i32) i32 {
    let i:i32=0;while(i<n){dst[at+i]=src[i];i=i+1;}
    return at+n;
}
fn write_hex_line(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[tag.len]=32;
    let k:i32=0;while(k<hx.len){line[tag.len+1+k]=hx[k];k=k+1;}
    line[tag.len+1+hx.len]=10;
    let r:i32=write_file(dir,fname,line);
    nio_free(hx);nio_free(line);
    return r;
}
// M1 phase shared by t_m8: ingest + full recall + provisional swap probes
fn m8_m1_phase(s:*Y1,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,corpus:i32,
               bout:[]u8,r_cok:*i32) void {
    let n:i32=nunits_of(buf.len);
    let bounds:[]u8=halloc(s,(n+1)*4);
    let bstat:[]u8=halloc(s,n*16);
    negotiate_all(s,buf,n,bounds,bstat);
    let ids:[]u8=halloc(s,n*4);
    ingest_span(s,buf,coffs,clens,buf,buf,corpus,n,bounds,bstat,ids);
    let ok:i32=0;
    let interval:i32=(n+Y1_SWAP_N-1)/Y1_SWAP_N;
    if(interval<1){interval=1;}
    let probes_done:i32=0;let recalls_done:i32=0;
    let i:i32=0;
    while(i<n){
        let id:i32=iget(ids,i*4);
        let sl:i32=y_resolve(s,id);
        if(sl>=0){
            let len:i32=iget(s.*.lens,sl*4);
            let off:i32=iget(s.*.offs,sl*4);
            let rl:i32=y_recall(s,cbufs,coffs,clens,id,bout);
            if(rl==len){
                let good:i32=1;
                let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
                if(good==1){ok=ok+1;}
            }
        }
        recalls_done=recalls_done+1;
        let want:i32=(probes_done+1)*interval;
        if(want>n){want=n;}
        if(probes_done<Y1_SWAP_N && recalls_done==want){
            let tidx:i32=(i+1)%n;
            let tid:i32=iget(ids,tidx*4);
            let osl:i32=y_resolve(s,tid);
            if(osl>=0){
                let rsl:i32=(osl+1)%s.*.cap;
                let t2:i32=0;
                while(t2<s.*.cap){
                    let rf:i32=iget(s.*.flags,rsl*4);
                    if((rf & F_LIVE)!=0){break;}
                    rsl=rsl+1;if(rsl>=s.*.cap){rsl=0;}t2=t2+1;
                }
                y_led(s,OP_TSWAP,rsl,0,0,0,0,0,tid,0,0,0,0,0,probes_done+1,rsl);
                iput(s.*.id2slot,tid*4,rsl);
                y_recall(s,cbufs,coffs,clens,tid,bout);
                iput(s.*.id2slot,tid*4,osl);
            }
            probes_done=probes_done+1;
        }
        i=i+1;
    }
    if(n>0){r_cok.*=ok*1000/n;}else{r_cok.*=0;}
    hfree(s,bounds);hfree(s,bstat);hfree(s,ids);
}
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){
        aslr_pad=nio_alloc(1234567);
    }
    // freelist: accepted no-op (no free-list; placement is a pure function of
    // ingest order). starve: no-op (clock/entropy never consulted).
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let nun_p:i32=nunits_of(prose.len);let nun_c:i32=nunits_of(code.len);
    let nun_f:i32=nunits_of(fresh.len);
    let cap:i32=nun_p+nun_c+7000+16384;
    let s:Y1=y_new(cap,300000,nun_p+nun_c+12000,cap+4096,524288,1);
    let bout:[]u8=halloc(&s,256);
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(coffs,clens,Y1_C_PROSE,0,prose.len);
    reg_set(coffs,clens,Y1_C_CODE,prose.len,code.len);
    reg_set(coffs,clens,Y1_C_FRESH,prose.len+code.len,fresh.len);
    // M1 phase (with provisional swap probes)
    let m1p:i32=0;let m1c:i32=0;
    m8_m1_phase(&s,cbufs,coffs,clens,prose,Y1_C_PROSE,bout,&m1p);
    m8_m1_phase(&s,cbufs,coffs,clens,code,Y1_C_CODE,bout,&m1c);
    // M3 op sequence on the same instance (no capacity pressure at this cap)
    let total:i32=nun_p+nun_c;
    let k:i32=total/Y1_M3_V;if(k<1){k=1;}
    let fb:[]u8=halloc(&s,(nun_f+1)*4);let fbs:[]u8=halloc(&s,nun_f*16);
    negotiate_all(&s,fresh,nun_f,fb,fbs);
    let v:i32=0;
    while(v<Y1_M3_V){
        let g:i32=v*k;
        let cid:i32=Y1_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=Y1_C_CODE;idx=g-nun_p;}
        let osl:i32=y_htab_find(&s,hkey(cid,idx));
        if(osl>=0){y_mark_valuable(&s,iget(s.ids,osl*4));}
        v=v+1;
    }
    let fids:[]u8=halloc(&s,Y1_M3_FRESH1*4);
    let f:i32=0;
    while(f<Y1_M3_FRESH1){
        let left:i32=iget(fb,f*4);let right:i32=iget(fb,(f+1)*4);
        let id:i32=y_ingest_unit(&s,fresh,fresh,Y1_C_FRESH,f,left,right,
            iget(fbs,f*16),iget(fbs,f*16+4),iget(fbs,f*16+8),iget(fbs,f*16+12),f*Y1_GRID);
        iput(fids,f*4,id);
        f=f+1;
    }
    f=0;
    while(f<Y1_M3_KILL){y_kill(&s,iget(fids,f*4),1);f=f+1;}
    let w:i32=0;
    while(w<50){
        let g2:i32=(w*20)*k;
        let cid2:i32=Y1_C_PROSE;let idx2:i32=g2;
        if(g2>=nun_p){cid2=Y1_C_CODE;idx2=g2-nun_p;}
        let osl2:i32=y_htab_find(&s,hkey(cid2,idx2));
        if(osl2>=0){y_weaken(&s,iget(s.ids,osl2*4),w+1);}
        w=w+1;
    }
    f=Y1_M3_FRESH1;
    while(f<Y1_M3_FRESH1+Y1_M3_FRESH2){
        let left:i32=iget(fb,f*4);let right:i32=iget(fb,(f+1)*4);
        let id:i32=y_ingest_unit(&s,fresh,fresh,Y1_C_FRESH,f,left,right,
            iget(fbs,f*16),iget(fbs,f*16+4),iget(fbs,f*16+8),iget(fbs,f*16+12),f*Y1_GRID);
        if(id<0){
            y_evict_oldest_unpinned(&s);
            id=y_ingest_unit(&s,fresh,fresh,Y1_C_FRESH,f,left,right,
                iget(fbs,f*16),iget(fbs,f*16+4),iget(fbs,f*16+8),iget(fbs,f*16+12),f*Y1_GRID);
        }
        f=f+1;
    }
    // artifacts: store image = every persistent slot array
    let img:[]u8=halloc(&s,cap*40+s.id_cap*4+s.ins_cap*4);
    let at:i32=0;
    at=img_append(img,at,s.ids,cap*4);
    at=img_append(img,at,s.offs,cap*4);
    at=img_append(img,at,s.lens,cap*4);
    at=img_append(img,at,s.corps,cap*4);
    at=img_append(img,at,s.flags,cap*4);
    at=img_append(img,at,s.shifts,cap*4);
    at=img_append(img,at,s.pidx,cap*4);
    at=img_append(img,at,s.c_offs,cap*4);
    at=img_append(img,at,s.c_lens,cap*4);
    at=img_append(img,at,s.fwd,cap*4);
    at=img_append(img,at,s.id2slot,s.id_cap*4);
    at=img_append(img,at,s.ins,s.ins_cap*4);
    let nch:i32=(img.len+1048575)/1048576;
    let chain_in:[]u8=halloc(&s,nch*32);
    let ci:i32=0;
    while(ci<nch){
        let cs:i32=ci*1048576;let cn:i32=img.len-cs;
        if(cn>1048576){cn=1048576;}
        ns_sha256(img[cs..cs+cn],chain_in[ci*32..ci*32+32]);
        ci=ci+1;
    }
    let chl:[]u8=halloc(&s,nch*80);
    let cho:i32=0;
    ci=0;
    while(ci<nch){
        let cs:i32=ci*32;
        let hx:[]u8=ns_hex(chain_in[cs..cs+32]);
        let tag:[]u8=_zag_i64_to_str(ci as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<hx.len){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        nio_free(hx);nio_free(tag);
        ci=ci+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=halloc(&s,32);
    ns_sha256(chain_in,chain);
    write_hex_line(outdir,"store_chain.txt","chain",chain);
    write_file(outdir,"ledger.bin",s.led[0..s.led_n*64]);
    let lhash:[]u8=halloc(&s,32);
    ns_sha256(s.led[0..s.led_n*64],lhash);
    write_hex_line(outdir,"ledger_chain.txt","chain",lhash);
    write_file(outdir,"alloc_trace.txt",s.trace[0..s.trace_n]);
    _zag_print("M8,");
    p_dec1(m1p as i64);_zag_print(",");p_dec1(m1c as i64);_zag_print(",");
    p_i64(s.led_n as i64);_zag_println("");
    hfree(&s,bout);hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,fb);hfree(&s,fbs);hfree(&s,fids);
    hfree(&s,img);hfree(&s,chain_in);hfree(&s,chl);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
}

// ---- kill-1x: the binding Y1 kill trial ----
fn kill_stability(s:*Y1,buf:[]u8,coffs:[]u8,clens:[]u8,
                  ids:[]u8,bounds:[]u8,n:i32,bout:[]u8) i32 {
    // fraction (tenths) of units with committed span intact + same ID + byte-exact
    let sids:[]u8=s.*.ids;let sflags:[]u8=s.*.flags;
    let soffs:[]u8=s.*.offs;let slens:[]u8=s.*.lens;
    let ok:i32=0;
    let i:i32=0;
    while(i<n){
        let id:i32=iget(ids,i*4);
        let sl:i32=y_resolve(s,id);
        if(sl>=0 && iget(sids,sl*4)==id){
            let f:i32=iget(sflags,sl*4);
            if((f & (F_BDEF|F_CDEF))==0){
                let off:i32=iget(bounds,i*4);
                let len:i32=iget(bounds,(i+1)*4)-off;
                if(iget(soffs,sl*4)==off && iget(slens,sl*4)==len){
                    let rl:i32=y_recall(s,buf,coffs,clens,id,bout);
                    if(rl==len){
                        let good:i32=1;let q:i32=0;
                        while(q<len){if(bout[q]!=buf[off+q]){good=0;break;}q=q+1;}
                        if(good==1){ok=ok+1;}
                    }
                }
            }
        }
        i=i+1;
    }
    return ok*1000/n;
}
fn kill_instance(cdir:[]u8,neg_on:i32,r_veto_t:*i32,r_stab:*i32) void {
    let buf:[]u8=read_file(cdir,"prose.bin");
    if(buf.len==0){_zag_println("KILL,FATAL,empty-corpus");return;}
    let n:i32=Y1_KILL_CUTS;
    let s:Y1=y_new(n+n/4+2048,n+8192,n+1024,n+n/4+4096,65536,neg_on);
    let bout:[]u8=halloc(&s,256);
    let patch:[]u8=halloc(&s,256);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,Y1_C_PROSE,0,buf.len);
    let bounds:[]u8=halloc(&s,(n+1)*4);
    let bstat:[]u8=halloc(&s,n*16);
    negotiate_all(&s,buf,n,bounds,bstat);
    // the kill trial covers only the first n grid units: cap the final boundary
    // at n*64 (negotiate_all pins bounds[n] to buf.len, which is far beyond).
    iput(bounds,n*4,n*Y1_GRID);
    // veto rate over the first 1,000 cuts
    let vv:i32=0;
    let b:i32=1;
    while(b<n && b<=1000){
        if(iget(bstat,b*16+4)>0){vv=vv+1;}
        b=b+1;
    }
    r_veto_t.*=vv; // vv is already per-1000 -> tenths of a percent
    let ids:[]u8=halloc(&s,n*4);
    if(ingest_span(&s,buf,coffs,clens,buf,buf,Y1_C_PROSE,n,bounds,bstat,ids)<0){
        _zag_println("KILL,FATAL,ingest-full");return;
    }
    let d_idx:[]u8=halloc(&s,Y1_M4_N*4);
    let cyc:[]u8=make_cyc(&s);
    plant_defects(&s,buf,Y1_C_PROSE,n,ids,bounds,0,Y1_M4_N,patch,cyc,d_idx);
    let rep_b:i32=0;let rep_c:i32=0;let ep:i32=1;
    revise_curriculum(&s,ids,d_idx,Y1_M4_N,buf,coffs,clens,buf,bounds,bout,
                      &rep_b,&rep_c,&ep);
    r_stab.*=kill_stability(&s,buf,coffs,clens,ids,bounds,n,bout);
    hfree(&s,bout);hfree(&s,patch);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,bounds);hfree(&s,bstat);hfree(&s,ids);hfree(&s,cyc);hfree(&s,d_idx);
}
fn t_kill(cdir:[]u8) void {
    let veto_neg:i32=0;let stab_neg:i32=0;
    kill_instance(cdir,1,&veto_neg,&stab_neg);
    let veto_uni:i32=0;let stab_uni:i32=0;
    kill_instance(cdir,0,&veto_uni,&stab_uni);
    // disjunct 1: negotiated <= 10% better recall-stability than unilateral
    let d1:i32=0;
    if((stab_neg as i64)*10<=(stab_uni as i64)*11){d1=1;}
    // disjunct 2: veto rate collapses to <1% within the first 1,000 cuts
    let d2:i32=0;
    if(veto_neg<10){d2=1;}
    let verdict:[]u8="PASS";
    if(d1==1 || d2==1){verdict="KILLED";}
    _zag_print("KILLTRIAL,cuts=");p_i64(Y1_KILL_CUTS as i64);
    _zag_print(",stab_neg=");p_dec1(stab_neg as i64);
    _zag_print(",stab_uni=");p_dec1(stab_uni as i64);
    _zag_print(",veto_neg=");p_dec1(veto_neg as i64);
    _zag_print(",d1=");p_i64(d1 as i64);
    _zag_print(",d2=");p_i64(d2 as i64);
    _zag_print(",verdict=");_zag_print(verdict);_zag_println("");
    let f:i32=0;
    j_begin("kill-1x");
    jf_int(&f,"y1_kill_cuts",Y1_KILL_CUTS as i64);
    jf_dec1(&f,"y1_kill_stability_neg_tenths",stab_neg as i64);
    jf_dec1(&f,"y1_kill_stability_uni_tenths",stab_uni as i64);
    jf_dec1(&f,"y1_kill_veto_rate_tenths",veto_neg as i64);
    jf_bool(&f,"y1_kill_d1_stability",d1);
    jf_bool(&f,"y1_kill_d2_lazy_veto",d2);
    jf_str(&f,"y1_kill_verdict",verdict);
    j_end();
}

// ---- main dispatch ----
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len==0){_zag_println("usage: y1 <mode> [corpus-root] [outdir] [perturbation]");return 2;}
    let croot:[]u8=_zag_arg(2);
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(croot,"prose.bin",Y1_C_PROSE,"prose","m1-1x-prose");}
    else if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(croot,"code.bin",Y1_C_CODE,"code","m1-1x-code");}
    else if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(croot,"t1_prose.bin",Y1_C_T1P,"m2-t1-prose",1,"m2-t1-prose");}
    else if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(croot,"t1_code.bin",Y1_C_T1C,"m2-t1-code",1,"m2-t1-code");}
    else if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(croot,"t2_prose.bin",Y1_C_T2P,"m2-t2-prose",0,"m2-t2-prose");}
    else if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(croot,"t2_code.bin",Y1_C_T2C,"m2-t2-code",0,"m2-t2-code");}
    else if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(croot,"t3.bin",Y1_C_T3,"m2-t3-1x",0,"m2-t3-1x");}
    else if(_zag_strcmp(mode,"m3-1x")==1){t_m3(croot);}
    else if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(croot,"prose.bin",Y1_C_PROSE,0,"m4-1x-prose","m4-1x-prose");}
    else if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(croot,"code.bin",Y1_C_CODE,1,"m4-1x-code","m4-1x-code");}
    else if(_zag_strcmp(mode,"m5-1x")==1){t_m5(croot,0);}
    else if(_zag_strcmp(mode,"m5-baseline")==1){t_m5(croot,1);}
    else if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(croot,0);}
    else if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(croot,1);}
    else if(_zag_strcmp(mode,"m7-1x")==1){t_m7(croot);}
    else if(_zag_strcmp(mode,"kill-1x")==1){t_kill(croot);}
    else if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        if(outdir.len==0 || pert.len==0){
            _zag_println("usage: y1 m8-1x <corpus-root> <outdir> <perturbation>");
            return 2;
        }
        t_m8(croot,outdir,pert);
    }
    else{_zag_print("unknown mode: ");_zag_println(mode);return 2;}
    return 0;
}

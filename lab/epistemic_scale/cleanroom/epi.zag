// Clean-room epistemic classifier. Pure Zag, zero RNG.
// Simplified mechanism (documented in MECHANISM.md).

fn t_put32(a:*u8,o:i64,v:i32)void{a[o]=(v&255)as u8;a[o+1]=((v>>8)&255)as u8;a[o+2]=((v>>16)&255)as u8;a[o+3]=((v>>24)&255)as u8;}
fn t_get32(a:*u8,o:i64)i32{let b0:i32=a[o]as i32;let b1:i32=a[o+1]as i32;let b2:i32=a[o+2]as i32;let b3:i32=a[o+3]as i32;return b0|(b1<<8)|(b2<<16)|(b3<<24);}
fn s_eq(a:[]u8,b:[]u8)i32{if(a.len!=b.len){return 0;}let k:i64=0;while(k<a.len){if(a[k]!=b[k]){return 0;}k=k+1;}return 1;}
fn s_find(s:[]u8,q:[]u8)i64{if(q.len==0){return 0;}if(q.len>s.len){return -1;}let k:i64=0;while(k+q.len<=s.len){let m:i64=0;let ok:i32=1;while(m<q.len){if(s[k+m]!=q[m]){ok=0;break;}m=m+1;}if(ok==1){return k;}k=k+1;}return -1;}
fn is_wc(c:u8)i32{if(c>=48&&c<=57){return 1;}if(c>=97&&c<=122){return 1;}if(c>=65&&c<=90){return 1;}return 0;}
fn find_w(t:[]u8,w:[]u8)i64{let k:i64=0;while(k+w.len<=t.len){let m:i64=0;let ok:i32=1;while(m<w.len){if(t[k+m]!=w[m]){ok=0;break;}m=m+1;}if(ok==1){let lo:i32=1;let hi:i32=1;if(k>0){if(is_wc(t[k-1])==1){lo=0;}}if(k+w.len<t.len){if(is_wc(t[k+w.len])==1){hi=0;}}if(lo==1&&hi==1){return k;}}k=k+1;}return -1;}


// wsum
fn wsum(ho:i64,hl:i64,to:i64,tl:i64,tok:*u8)i32{
let s:i32=0;let i:i64=0;
while(i<hl){let id:i32=t_get32(tok,(ho+i)*4);let j:i64=0;let f:i32=0;
while(j<tl){if(t_get32(tok,(to+j)*4)==id){f=1;break;}j=j+1;}
if(f==1){s=s+idf_at(id as i64);}i=i+1;}return s;}

// op_score (simplified)
fn op_score(tx:[]u8,off:i64,ln:i64,tok:*u8)i32{
let s:i32=0;let i:i64=0;
while(i<ln){let id:i32=t_get32(tok,(off+i)*4);
let k:i64=0;let seen:i32=0;
while(k<i){if(t_get32(tok,(off+k)*4)==id){seen=1;break;}k=k+1;}
if(seen==0){
if(ea_has(id)==1){s=s+2;}else{if(fa_has(id)==1){s=s-3;}}
if(vn_has(id)==1){s=s+1;}
if(id==worth_id()){s=s+2;}}
if(id==beat_id()){s=s+3;}else{if(ev_has(id)==1){s=s+2;}}
i=i+1;}
if(s_find(tx,"i think")>=0){s=s+3;}
if(s_find(tx,"i feel")>=0){s=s+3;}
if(s_find(tx,"i believe")>=0){s=s+3;}
if(s_find(tx,"in my opinion")>=0){s=s+3;}
if(s_find(tx,"my favorite")>=0){s=s+3;}
if(s_find(tx,"my favourite")>=0){s=s+3;}
if(s_find(tx,"i love")>=0){s=s+3;}
if(s_find(tx,"i hate")>=0){s=s+3;}
if(s_find(tx,"better than any")>=0){s=s+3;}
if(s_find(tx,"worse than any")>=0){s=s+3;}
if(find_w(tx,"never")>=0){s=s+1;}
if(find_w(tx,"nothing")>=0){s=s+1;}
if(find_w(tx,"cannot")>=0){s=s+1;}
let pb:i64=s_find(tx,"better");
if(pb>=0){let kk:i64=pb+6;while(kk+4<=tx.len){if(tx[kk]==116&&tx[kk+1]==104&&tx[kk+2]==97&&tx[kk+3]==110){if(kk-pb<25){s=s+3;}break;}kk=kk+1;if(kk-pb>30){break;}}}
let pw:i64=s_find(tx,"worse");
if(pw>=0){let kk2:i64=pw+5;while(kk2+4<=tx.len){if(tx[kk2]==116&&tx[kk2+1]==104&&tx[kk2+2]==97&&tx[kk2+3]==110){if(kk2-pw<25){s=s+3;}break;}kk2=kk2+1;if(kk2-pw>30){break;}}}
if(find_w(tx,"should")>=0){s=s+2;}
return s;}

// extraordinary
fn ex_score(tx:[]u8)i32{
let s:i32=0;
if(s_find(tx,"bigfoot")>=0){s=s+3;}if(s_find(tx,"loch")>=0){s=s+3;}
if(s_find(tx,"monster")>=0){s=s+3;}if(s_find(tx,"extraterrestrial")>=0){s=s+3;}
if(s_find(tx,"alien")>=0){s=s+3;}if(s_find(tx,"ufo")>=0){s=s+3;}
if(s_find(tx,"psychic")>=0){s=s+3;}if(s_find(tx,"ghost")>=0){s=s+3;}
if(s_find(tx,"reincarnation")>=0){s=s+3;}if(s_find(tx,"astrology")>=0){s=s+3;}
if(s_find(tx,"chupacabra")>=0){s=s+3;}if(s_find(tx,"bermuda")>=0){s=s+3;}
if(s_find(tx,"afterlife")>=0){s=s+3;}if(s_find(tx,"murdered")>=0){s=s+3;}
if(s_find(tx,"staged")>=0){s=s+3;}if(s_find(tx,"cover-up")>=0){s=s+3;}
if(s_find(tx,"area 51")>=0){s=s+3;}if(s_find(tx,"chemtrail")>=0){s=s+3;}
if(s_find(tx,"cause autism")>=0){s=s+2;}if(s_find(tx,"causes autism")>=0){s=s+2;}
if(s_find(tx,"cause cancer")>=0){s=s+2;}if(s_find(tx,"causes cancer")>=0){s=s+2;}
if(s_find(tx,"lowers iq")>=0){s=s+2;}if(s_find(tx,"flush toxins")>=0){s=s+2;}
if(s_find(tx,"beyond placebo")>=0){s=s+2;}
if(s_find(tx,"is real")>=0){s=s+1;}if(s_find(tx,"are real")>=0){s=s+1;}
return s;}

// classify: 0=op,1=lie,2=fact,3=und
fn classify(hi:i64,tok:*u8,ws:*u8) i32{
let tx:[]u8=he_text(hi);let off:i64=ho(hi);let ln:i64=hl(hi);
// Gate1: opinion (simplified: use op_score only, threshold 3)
let os:i32=op_score(tx,off,ln,tok);
// Discourse: compute top-5 by wsum, avg their op_scores
// For simplicity, we skip full discourse and use os + small boost if neighbors agree.
// Actually, let's implement discourse properly with ws array.
// ws is a scratch array for wsum values (448 i32s).
let ti:i64=0;
while(ti<448){ws_put(ws,ti,wsum(off,ln,to(ti),tl(ti),tok));ti=ti+1;}
// Find top 5 (simple selection)
let top0:i64=0;let top1:i64=0;let top2:i64=0;let top3:i64=0;let top4:i64=0;
let v0:i32=-1;let v1:i32=-1;let v2:i32=-1;let v3:i32=-1;let v4:i32=-1;
ti=0;
while(ti<448){let vv:i32=ws_get(ws,ti);
if(vv>v0){v4=v3;top4=top3;v3=v2;top3=top2;v2=v1;top2=top1;v1=v0;top1=top0;v0=vv;top0=ti;}
else{if(vv>v1){v4=v3;top4=top3;v3=v2;top3=top2;v2=v1;top2=top1;v1=vv;top1=ti;}
else{if(vv>v2){v4=v3;top4=top3;v3=v2;top3=top2;v2=vv;top2=ti;}
else{if(vv>v3){v4=v3;top4=top3;v3=vv;top3=ti;}
else{if(vv>v4){v4=vv;top4=ti;}}}}}
ti=ti+1;}
let dsum:i32=op_score(tr_text(top0),to(top0),tl(top0),tok);
dsum=dsum+op_score(tr_text(top1),to(top1),tl(top1),tok);
dsum=dsum+op_score(tr_text(top2),to(top2),tl(top2),tok);
dsum=dsum+op_score(tr_text(top3),to(top3),tl(top3),tok);
dsum=dsum+op_score(tr_text(top4),to(top4),tl(top4),tok);
let disc:i32=dsum/5;
let combined:i32=os+(disc*3)/10;
if(combined>=3){return 0;}
// Gate2: lie (simplified clash: check numbers)
let hn:[]u8=he_nums(hi);
if(hn.len>0){
ti=0;
while(ti<448){
let tn:[]u8=tr_nums(ti);
if(tn.len>0){
// Simple: if both have numbers and share a token, check if numbers differ.
// For simplicity, if wsum>1500 and numbers differ, clash.
// Actually, let's just check if number strings differ and wsum high.
if(wsum(off,ln,to(ti),tl(ti),tok)>1500){
if(s_eq(hn,tn)==0){return 1;}
}}
ti=ti+1;}}
// Gate3: extraordinary
if(ex_score(tx)>=2){return 3;}
// Gate4: grounding
if(v0>=3500){return 2;}
return 3;}

fn ws_put(a:*u8,o:i64,v:i32)void{t_put32(a,o*4,v);}
fn ws_get(a:*u8,o:i64)i32{return t_get32(a,o*4);}

fn main()void{
let tok:*u8=_zag_malloc(20000) as *u8;
tok_init(tok);
let ws:*u8=_zag_malloc(2000) as *u8;
let hi:i64=0;
while(hi<192){
let c:i32=classify(hi,tok,ws);
let id:[]u8=he_id(hi);
_zag_print(id);_zag_print("\t");
if(c==0){_zag_print("opinion");}
else{if(c==1){_zag_print("lie");}
else{if(c==2){_zag_print("fact");}
else{_zag_print("undetermined");}}}
// Trace inline
_zag_print("\tTRACE:");
if(c==0){_zag_print("opinion|gate1|op_score>=3");}
else{if(c==1){_zag_print("lie|gate2|clash_no_support");}
else{if(c==2){_zag_print("fact|gate4|grounding>=3500");}
else{_zag_print("undetermined|gate3_4|extraordinary_or_low_grounding");}}}
_zag_print("\n");
hi=hi+1;}
}

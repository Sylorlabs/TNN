// zoom.zag — DELIBERATIVE VARIABLE-SCALE ZOOM texture layer.
// (image_zoom_fork; Micah order 2026-09-26 ~01:11 PDT: magnifying-glass-for-images)
//
// Replaces the fixed 8x8 motif codebook (v2) with TNN's own zoom machinery:
// TNN chooses its own zoom level per region — zooming IN where detail is
// dense (foliage, brick courses, ripples), OUT where smooth (sky, water) —
// with every scale choice recorded and reasoned. No fixed vocabulary
// budget: motif selection converges on marginal explained-energy (a
// precision parameter), never on a motif-count cap.
//
// Scales: B0=16 (coarse), B1=8 (fine), B2=4 (fine-fine).
//
// Deliberation:
//   D  = pix - structure_render            (i16 detail field)
//   L0: farthest-point motifs over 16x16 blocks of D (null motif first);
//       stop when best new motif explains < TAU0 energy. Assign every block.
//       -> coarse approx C.
//   R1 = D - C. Per 8x8 sub-block: ZOOM IN iff E(R1) > TAU_Z1 (reason
//       recorded: the block's unexplained energy vs the zoom threshold).
//   L1: farthest-point motifs over the ZOOMED 8x8 blocks of R1 (null first);
//       stop when best new motif explains < TAU1. Assign zoomed blocks.
//       -> fine approx F1.
//   R2 = R1 - F1. Per 4x4 (inside a zoomed 8x8): ZOOM IN iff E(R2) > TAU_Z2.
//   L2: farthest-point motifs over the ZOOMED 4x4 blocks of R2 (null first);
//       stop when best new motif explains < TAU2. Assign zoomed blocks.
//       -> fine-fine approx F2.
//
// Knowledge claim: "I looked at this region at 16x16 and saw an instance
// of the texture at exemplar block B; the detail there was too dense
// (energy E > tau) for the coarse description, so I zoomed to 8x8 and saw
// an instance of the texture at exemplar block B2; ..." The zoom map
// (e0 / z1+e1 / z2+e2) IS the deliberation record.
//
// Render: pixel = clamp(struct + C + F1 + F2); edges overlaid after.
//
// Zero RNG. Deterministic: lowest-index tie-breaks everywhere, canonical
// block order, explicit initialization.
@import("./common.zag")

// ---------------- generalized farthest-point motif selection ----------------
// bdet: nb*B*B*3 i16 values in a []u8 arena (2 bytes per value), block-major.
// bval: valid value count per block (B*B*3 for full blocks).
// cand: candidate block indices (full blocks only); ncand of them.
// motifs: cap*B*B*3*2 bytes out; mex: cap i64 out (exemplar block or -1).
// tau: stop when the best new motif's unexplained energy < tau.
// gains: gains[0] = unexplained energy of last added motif,
//         gains[1] = unexplained energy of first (seed) motif.
// Returns nm (>=1; motif 0 is always the NULL texture).
fn fp_motifs(bdet:[]u8, bval:[]i64, B:i64, nb:i64, cand:[]i64, ncand:i64,
    motifs:[]u8, mex:[]i64, cap:i64, tau:i64, gains:[]i64) i64 {
    let nv:i64 = B * B * 3;
    let mbytes:i64 = nv * 2;
    // motif 0 = NULL (all-zero patch): "this block has no texture at this scale"
    let zk:i64 = 0;
    while (zk < nv) { w_i16le(motifs, zk * 2, 0); zk = zk + 1; }
    mex[0] = -1;
    let nm:i64 = 1;
    gains[0] = 0;
    gains[1] = 0;
    if (ncand == 0) { return 1; }
    let energy:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    if (energy.len == 0) { return -1; }
    let mind:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    if (mind.len == 0) { return -1; }
    let ci:i64 = 0;
    while (ci < ncand) {
        let bi:i64 = cand[ci];
        let e:i64 = 0;
        let k:i64 = 0;
        while (k < bval[bi]) {
            let v:i64 = r_i16le(bdet, bi * mbytes + k * 2);
            e = e + v * v;
            k = k + 1;
        }
        energy[ci] = e;
        mind[ci] = e;
        ci = ci + 1;
    }
    // seed: max energy, lowest index wins ties
    let best:i64 = 0;
    let bk:i64 = 1;
    while (bk < ncand) {
        if (energy[bk] > energy[best]) { best = bk; }
        bk = bk + 1;
    }
    gains[1] = energy[best];
    let go:i64 = 1;
    while (go == 1) {
        let exbi:i64 = cand[best];
        mex[nm] = exbi;
        let k2:i64 = 0;
        while (k2 < nv) {
            w_i16le(motifs, nm * mbytes + k2 * 2, r_i16le(bdet, exbi * mbytes + k2 * 2));
            k2 = k2 + 1;
        }
        nm = nm + 1;
        let nbest:i64 = 0;
        let nbestd:i64 = -1;
        let ck:i64 = 0;
        while (ck < ncand) {
            let dd:i64 = 0;
            let k3:i64 = 0;
            let cb:i64 = cand[ck] * mbytes;
            let eb:i64 = exbi * mbytes;
            let nvv:i64 = bval[cand[ck]];
            while (k3 < nvv) {
                let dv:i64 = r_i16le(bdet, cb + k3 * 2) - r_i16le(bdet, eb + k3 * 2);
                dd = dd + dv * dv;
                k3 = k3 + 1;
            }
            if (dd < mind[ck]) { mind[ck] = dd; }
            if (mind[ck] > nbestd) { nbestd = mind[ck]; nbest = ck; }
            ck = ck + 1;
        }
        gains[0] = nbestd;
        if (nm >= cap) { go = 0; }
        if (nbestd < tau) { go = 0; }
        best = nbest;
    }
    nio_free(energy);
    nio_free(mind);
    return nm;
}

// ---------------- nearest-motif assignment over a masked block subset ----------------
// mask[bi]=1 -> assign nearest motif (lowest index wins ties); else bassign=0.
// motifs: nm*nv*2 bytes; nv = B*B*3.
fn assign_blocks(bdet:[]u8, bval:[]i64, B:i64, nb:i64, mask:[]u8,
    motifs:[]u8, nm:i64, bassign:[]i64) void {
    let nv:i64 = B * B * 3;
    let mbytes:i64 = nv * 2;
    let bi:i64 = 0;
    while (bi < nb) {
        bassign[bi] = 0;
        if (mask[bi] == 1) {
            let bestm:i64 = 0;
            let bestd:i64 = 9223372036854775807;
            let m:i64 = 0;
            while (m < nm) {
                let dd:i64 = 0;
                let k:i64 = 0;
                let cb:i64 = bi * mbytes;
                let mb:i64 = m * mbytes;
                let nvv:i64 = bval[bi];
                while (k < nvv) {
                    let dv:i64 = r_i16le(bdet, cb + k * 2) - r_i16le(motifs, mb + k * 2);
                    dd = dd + dv * dv;
                    k = k + 1;
                }
                if (dd < bestd) { bestd = dd; bestm = m; }
                m = m + 1;
            }
            bassign[bi] = bestm;
        }
        bi = bi + 1;
    }
}

// block pixel extent helper: writes x0,y0,bw,bh into out[0..3]
fn block_extent(bi:i64, nc:i64, B:i64, w:i64, h:i64, out:[]i64) void {
    let bx:i64 = bi % nc;
    let by:i64 = bi / nc;
    let x0:i64 = bx * B;
    let y0:i64 = by * B;
    let bw:i64 = B;
    let bh:i64 = B;
    if (x0 + bw > w) { bw = w - x0; }
    if (y0 + bh > h) { bh = h - y0; }
    out[0] = x0; out[1] = y0; out[2] = bw; out[3] = bh;
}

// ---------------- the zoom deliberation ----------------
// pix: original RGB; s: structure render RGB; w,h.
// tau0/tau1/tau2: motif convergence thresholds (marginal explained-energy).
// tauz1/tauz2: zoom thresholds (block residual energy to zoom deeper).
// Outputs (preallocated by caller):
//   motifs0 (cap0*1536 bytes), mex0 (cap0 i64), e0 (nb0 i64)
//   z1 (nb1 bytes), e1 (nb1 i64), motifs1 (cap1*384 bytes), mex1 (cap1 i64)
//   z2 (nb2 bytes), e2 (nb2 i64), motifs2 (cap2*96 bytes), mex2 (cap2 i64)
// zs[0..15] stats: nm0,nm1,nm2, nzoom1,nzoom2, e_detail, e_r1, e_r2,
//   caphit0,caphit1,caphit2, lastgain0,lastgain1,lastgain2, firstgain0, spare
// Returns 0 ok, negative on allocation failure.
fn deliberate_zoom(pix:[]u8, s:[]u8, w:i64, h:i64,
    tau0:i64, tau1:i64, tau2:i64, tauz1:i64, tauz2:i64,
    motifs0:[]u8, mex0:[]i64, e0:[]i64,
    z1:[]u8, e1:[]i64, motifs1:[]u8, mex1:[]i64,
    z2:[]u8, e2:[]i64, motifs2:[]u8, mex2:[]i64,
    cap0:i64, cap1:i64, cap2:i64,
    zs:[]i64) i64 {
    let B0:i64 = 16; let B1:i64 = 8; let B2:i64 = 4;
    let nc0:i64 = (w + 15) / 16; let nr0:i64 = (h + 15) / 16; let nb0:i64 = nc0 * nr0;
    let nc1:i64 = (w + 7) / 8; let nr1:i64 = (h + 7) / 8; let nb1:i64 = nc1 * nr1;
    let nc2:i64 = (w + 3) / 4; let nr2:i64 = (h + 3) / 4; let nb2:i64 = nc2 * nr2;
    let npix:i64 = w * h;
    let nv0:i64 = 768; let nv1:i64 = 192; let nv2:i64 = 48;
    let mb0:i64 = 1536; let mb1:i64 = 384; let mb2:i64 = 96;
    let ext:[]i64 = nio_alloc(32) as []i64;
    if (ext.len == 0) { return -1; }
    let gains:[]i64 = nio_alloc(16) as []i64;
    if (gains.len == 0) { return -1; }

    // ---- detail field D = pix - s (i16 per channel) ----
    let det:[]u8 = nio_alloc((npix * 6) as i32);
    if (det.len == 0) { return -1; }
    let edet:i64 = 0;
    let di:i64 = 0;
    while (di < npix) {
        let p:i64 = di * 3;
        let q:i64 = di * 6;
        w_i16le(det, q, (pix[p] as i64) - (s[p] as i64));
        w_i16le(det, q + 2, (pix[p + 1] as i64) - (s[p + 1] as i64));
        w_i16le(det, q + 4, (pix[p + 2] as i64) - (s[p + 2] as i64));
        let d0:i64 = r_i16le(det, q);
        let d1:i64 = r_i16le(det, q + 2);
        let d2:i64 = r_i16le(det, q + 4);
        edet = edet + d0 * d0 + d1 * d1 + d2 * d2;
        di = di + 1;
    }
    zs[5] = edet;

    // ---- LEVEL 0: 16x16 motifs over D ----
    let bdet0:[]u8 = nio_alloc((nb0 * mb0) as i32);
    if (bdet0.len == 0) { return -1; }
    let bval0:[]i64 = nio_alloc((nb0 * 8) as i32) as []i64;
    if (bval0.len == 0) { return -1; }
    let bi:i64 = 0;
    while (bi < nb0) {
        block_extent(bi, nc0, B0, w, h, ext);
        let x0:i64 = ext[0]; let y0:i64 = ext[1];
        let bw:i64 = ext[2]; let bh:i64 = ext[3];
        let nvv:i64 = 0;
        let iy:i64 = 0;
        while (iy < bh) {
            let ix:i64 = 0;
            while (ix < bw) {
                let p:i64 = ((y0 + iy) * w + (x0 + ix)) * 6;
                let q:i64 = bi * mb0 + (iy * B0 + ix) * 6;
                w_i16le(bdet0, q, r_i16le(det, p));
                w_i16le(bdet0, q + 2, r_i16le(det, p + 2));
                w_i16le(bdet0, q + 4, r_i16le(det, p + 4));
                nvv = nvv + 3;
                ix = ix + 1;
            }
            iy = iy + 1;
        }
        bval0[bi] = nvv;
        bi = bi + 1;
    }
    let cand0:[]i64 = nio_alloc((nb0 * 8) as i32) as []i64;
    if (cand0.len == 0) { return -1; }
    let ncan0:i64 = 0;
    bi = 0;
    while (bi < nb0) {
        if (bval0[bi] == nv0) { cand0[ncan0] = bi; ncan0 = ncan0 + 1; }
        bi = bi + 1;
    }
    let nm0:i64 = fp_motifs(bdet0, bval0, B0, nb0, cand0, ncan0, motifs0, mex0, cap0, tau0, gains);
    if (nm0 < 0) { return -1; }
    zs[0] = nm0;
    zs[11] = gains[0];
    zs[14] = gains[1];
    if (nm0 >= cap0) { zs[8] = 1; } else { zs[8] = 0; }
    let mask0:[]u8 = nio_alloc(nb0 as i32);
    if (mask0.len == 0) { return -1; }
    bi = 0;
    while (bi < nb0) { mask0[bi] = 1; bi = bi + 1; }
    assign_blocks(bdet0, bval0, B0, nb0, mask0, motifs0, nm0, e0);
    nio_free(mask0);
    nio_free(cand0);

    // ---- coarse approx field C (i16 per pixel) ----
    let cf:[]u8 = nio_alloc((npix * 6) as i32);
    if (cf.len == 0) { return -1; }
    bi = 0;
    while (bi < nb0) {
        block_extent(bi, nc0, B0, w, h, ext);
        let x0b:i64 = ext[0]; let y0b:i64 = ext[1];
        let bwb:i64 = ext[2]; let bhb:i64 = ext[3];
        let m0:i64 = e0[bi];
        let iy2:i64 = 0;
        while (iy2 < bhb) {
            let ix2:i64 = 0;
            while (ix2 < bwb) {
                let p2:i64 = ((y0b + iy2) * w + (x0b + ix2)) * 6;
                let q2:i64 = m0 * mb0 + (iy2 * B0 + ix2) * 6;
                w_i16le(cf, p2, r_i16le(motifs0, q2));
                w_i16le(cf, p2 + 2, r_i16le(motifs0, q2 + 2));
                w_i16le(cf, p2 + 4, r_i16le(motifs0, q2 + 4));
                ix2 = ix2 + 1;
            }
            iy2 = iy2 + 1;
        }
        bi = bi + 1;
    }
    nio_free(bdet0);
    nio_free(bval0);

    // ---- R1 = D - C (i16 field) ----
    let r1f:[]u8 = nio_alloc((npix * 6) as i32);
    if (r1f.len == 0) { return -1; }
    let er1:i64 = 0;
    let ri:i64 = 0;
    while (ri < npix) {
        let q3:i64 = ri * 6;
        let a0:i64 = r_i16le(det, q3) - r_i16le(cf, q3);
        let a1:i64 = r_i16le(det, q3 + 2) - r_i16le(cf, q3 + 2);
        let a2:i64 = r_i16le(det, q3 + 4) - r_i16le(cf, q3 + 4);
        w_i16le(r1f, q3, a0);
        w_i16le(r1f, q3 + 2, a1);
        w_i16le(r1f, q3 + 4, a2);
        er1 = er1 + a0 * a0 + a1 * a1 + a2 * a2;
        ri = ri + 1;
    }
    zs[6] = er1;
    nio_free(det);
    nio_free(cf);

    // ---- ZOOM DECISION L1: per 8x8 block, zoom in iff E(R1) > tauz1 ----
    let nzoom1:i64 = 0;
    bi = 0;
    while (bi < nb1) {
        block_extent(bi, nc1, B1, w, h, ext);
        let zx0:i64 = ext[0]; let zy0:i64 = ext[1];
        let zbw:i64 = ext[2]; let zbh:i64 = ext[3];
        let eb:i64 = 0;
        let jy:i64 = 0;
        while (jy < zbh) {
            let jx:i64 = 0;
            while (jx < zbw) {
                let q4:i64 = ((zy0 + jy) * w + (zx0 + jx)) * 6;
                let u0:i64 = r_i16le(r1f, q4);
                let u1:i64 = r_i16le(r1f, q4 + 2);
                let u2:i64 = r_i16le(r1f, q4 + 4);
                eb = eb + u0 * u0 + u1 * u1 + u2 * u2;
                jx = jx + 1;
            }
            jy = jy + 1;
        }
        z1[bi] = 0;
        if (eb > tauz1) { z1[bi] = 1; nzoom1 = nzoom1 + 1; }
        bi = bi + 1;
    }
    zs[3] = nzoom1;

    // ---- LEVEL 1: 8x8 motifs over R1 (zoomed blocks only) ----
    let bdet1:[]u8 = nio_alloc((nb1 * mb1) as i32);
    if (bdet1.len == 0) { return -1; }
    let bval1:[]i64 = nio_alloc((nb1 * 8) as i32) as []i64;
    if (bval1.len == 0) { return -1; }
    bi = 0;
    while (bi < nb1) {
        block_extent(bi, nc1, B1, w, h, ext);
        let x1:i64 = ext[0]; let y1:i64 = ext[1];
        let bw1:i64 = ext[2]; let bh1:i64 = ext[3];
        let nvv1:i64 = 0;
        let iy1:i64 = 0;
        while (iy1 < bh1) {
            let ix1:i64 = 0;
            while (ix1 < bw1) {
                let p1:i64 = ((y1 + iy1) * w + (x1 + ix1)) * 6;
                let q1:i64 = bi * mb1 + (iy1 * B1 + ix1) * 6;
                w_i16le(bdet1, q1, r_i16le(r1f, p1));
                w_i16le(bdet1, q1 + 2, r_i16le(r1f, p1 + 2));
                w_i16le(bdet1, q1 + 4, r_i16le(r1f, p1 + 4));
                nvv1 = nvv1 + 3;
                ix1 = ix1 + 1;
            }
            iy1 = iy1 + 1;
        }
        bval1[bi] = nvv1;
        bi = bi + 1;
    }
    let cand1:[]i64 = nio_alloc((nb1 * 8) as i32) as []i64;
    if (cand1.len == 0) { return -1; }
    let ncan1:i64 = 0;
    bi = 0;
    while (bi < nb1) {
        if (z1[bi] == 1) {
            if (bval1[bi] == nv1) { cand1[ncan1] = bi; ncan1 = ncan1 + 1; }
        }
        bi = bi + 1;
    }
    let nm1:i64 = fp_motifs(bdet1, bval1, B1, nb1, cand1, ncan1, motifs1, mex1, cap1, tau1, gains);
    if (nm1 < 0) { return -1; }
    zs[1] = nm1;
    zs[12] = gains[0];
    if (nm1 >= cap1) { zs[9] = 1; } else { zs[9] = 0; }
    assign_blocks(bdet1, bval1, B1, nb1, z1, motifs1, nm1, e1);
    nio_free(cand1);
    // ---- fine approx field F1 (i16 per pixel; only zoomed 8x8 blocks) ----
    let f1f:[]u8 = nio_alloc((npix * 6) as i32);
    if (f1f.len == 0) { return -1; }
    let fz:i64 = 0;
    while (fz < npix * 6) { f1f[fz] = 0; fz = fz + 1; }
    bi = 0;
    while (bi < nb1) {
        if (z1[bi] == 1) {
            block_extent(bi, nc1, B1, w, h, ext);
            let fx0:i64 = ext[0]; let fy0:i64 = ext[1];
            let fbw:i64 = ext[2]; let fbh:i64 = ext[3];
            let m1:i64 = e1[bi];
            let jy1:i64 = 0;
            while (jy1 < fbh) {
                let jx1:i64 = 0;
                while (jx1 < fbw) {
                    let p5:i64 = ((fy0 + jy1) * w + (fx0 + jx1)) * 6;
                    let q5:i64 = m1 * mb1 + (jy1 * B1 + jx1) * 6;
                    w_i16le(f1f, p5, r_i16le(motifs1, q5));
                    w_i16le(f1f, p5 + 2, r_i16le(motifs1, q5 + 2));
                    w_i16le(f1f, p5 + 4, r_i16le(motifs1, q5 + 4));
                    jx1 = jx1 + 1;
                }
                jy1 = jy1 + 1;
            }
        }
        bi = bi + 1;
    }
    nio_free(bdet1);
    nio_free(bval1);

    // ---- R2 = R1 - F1 (i16 field) ----
    let r2f:[]u8 = nio_alloc((npix * 6) as i32);
    if (r2f.len == 0) { return -1; }
    let er2:i64 = 0;
    let ri2:i64 = 0;
    while (ri2 < npix) {
        let q6:i64 = ri2 * 6;
        let c0:i64 = r_i16le(r1f, q6) - r_i16le(f1f, q6);
        let c1:i64 = r_i16le(r1f, q6 + 2) - r_i16le(f1f, q6 + 2);
        let c2:i64 = r_i16le(r1f, q6 + 4) - r_i16le(f1f, q6 + 4);
        w_i16le(r2f, q6, c0);
        w_i16le(r2f, q6 + 2, c1);
        w_i16le(r2f, q6 + 4, c2);
        er2 = er2 + c0 * c0 + c1 * c1 + c2 * c2;
        ri2 = ri2 + 1;
    }
    zs[7] = er2;
    nio_free(r1f);
    nio_free(f1f);

    // ---- ZOOM DECISION L2: per 4x4 block (parent 8x8 must be zoomed) ----
    let nzoom2:i64 = 0;
    bi = 0;
    while (bi < nb2) {
        block_extent(bi, nc2, B2, w, h, ext);
        let gx0:i64 = ext[0]; let gy0:i64 = ext[1];
        let gbw:i64 = ext[2]; let gbh:i64 = ext[3];
        let pb1:i64 = (gy0 / 8) * nc1 + (gx0 / 8);
        let ge:i64 = 0;
        let ky:i64 = 0;
        while (ky < gbh) {
            let kx:i64 = 0;
            while (kx < gbw) {
                let q7:i64 = ((gy0 + ky) * w + (gx0 + kx)) * 6;
                let w0:i64 = r_i16le(r2f, q7);
                let w1:i64 = r_i16le(r2f, q7 + 2);
                let w2:i64 = r_i16le(r2f, q7 + 4);
                ge = ge + w0 * w0 + w1 * w1 + w2 * w2;
                kx = kx + 1;
            }
            ky = ky + 1;
        }
        z2[bi] = 0;
        if (z1[pb1] == 1) {
            if (ge > tauz2) { z2[bi] = 1; nzoom2 = nzoom2 + 1; }
        }
        bi = bi + 1;
    }
    zs[4] = nzoom2;
    // ---- LEVEL 2: 4x4 motifs over R2 (zoomed blocks only) ----
    let bdet2:[]u8 = nio_alloc((nb2 * mb2) as i32);
    if (bdet2.len == 0) { return -1; }
    let bval2:[]i64 = nio_alloc((nb2 * 8) as i32) as []i64;
    if (bval2.len == 0) { return -1; }
    bi = 0;
    while (bi < nb2) {
        block_extent(bi, nc2, B2, w, h, ext);
        let hx0:i64 = ext[0]; let hy0:i64 = ext[1];
        let hbw:i64 = ext[2]; let hbh:i64 = ext[3];
        let nvv2:i64 = 0;
        let iy3:i64 = 0;
        while (iy3 < hbh) {
            let ix3:i64 = 0;
            while (ix3 < hbw) {
                let p8:i64 = ((hy0 + iy3) * w + (hx0 + ix3)) * 6;
                let q8:i64 = bi * mb2 + (iy3 * B2 + ix3) * 6;
                w_i16le(bdet2, q8, r_i16le(r2f, p8));
                w_i16le(bdet2, q8 + 2, r_i16le(r2f, p8 + 2));
                w_i16le(bdet2, q8 + 4, r_i16le(r2f, p8 + 4));
                nvv2 = nvv2 + 3;
                ix3 = ix3 + 1;
            }
            iy3 = iy3 + 1;
        }
        bval2[bi] = nvv2;
        bi = bi + 1;
    }
    let cand2:[]i64 = nio_alloc((nb2 * 8) as i32) as []i64;
    if (cand2.len == 0) { return -1; }
    let ncan2:i64 = 0;
    bi = 0;
    while (bi < nb2) {
        if (z2[bi] == 1) {
            if (bval2[bi] == nv2) { cand2[ncan2] = bi; ncan2 = ncan2 + 1; }
        }
        bi = bi + 1;
    }
    let nm2:i64 = fp_motifs(bdet2, bval2, B2, nb2, cand2, ncan2, motifs2, mex2, cap2, tau2, gains);
    if (nm2 < 0) { return -1; }
    zs[2] = nm2;
    zs[13] = gains[0];
    if (nm2 >= cap2) { zs[10] = 1; } else { zs[10] = 0; }
    assign_blocks(bdet2, bval2, B2, nb2, z2, motifs2, nm2, e2);
    nio_free(cand2);
    nio_free(bdet2);
    nio_free(bval2);
    nio_free(r2f);
    nio_free(ext);
    nio_free(gains);
    zs[15] = 0;
    return 0;
}

// ---------------- path A (ingest): per-pixel zoom evaluation from knowledge ----------------
// fb: structure render (RGB, modified in place). For each pixel, look up the
// coarse exemplar, the fine exemplar (if zoomed), the fine-fine exemplar
// (if double-zoomed) from the zoom map and add their detail values.
fn zoom_eval_inplace(fb:[]u8, w:i64, h:i64,
    motifs0:[]u8, e0:[]i64, B0:i64, nc0:i64,
    z1:[]u8, e1:[]i64, motifs1:[]u8, B1:i64, nc1:i64,
    z2:[]u8, e2:[]i64, motifs2:[]u8, B2:i64, nc2:i64) void {
    let mb0:i64 = B0 * B0 * 3 * 2;
    let mb1:i64 = B1 * B1 * 3 * 2;
    let mb2:i64 = B2 * B2 * 3 * 2;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let b0:i64 = (y / B0) * nc0 + (x / B0);
            let m0:i64 = e0[b0];
            let q0:i64 = m0 * mb0 + ((y % B0) * B0 + (x % B0)) * 6;
            let v0:i64 = r_i16le(motifs0, q0);
            let v1:i64 = r_i16le(motifs0, q0 + 2);
            let v2:i64 = r_i16le(motifs0, q0 + 4);
            let b1:i64 = (y / B1) * nc1 + (x / B1);
            if (z1[b1] == 1) {
                let mm1:i64 = e1[b1];
                let qq1:i64 = mm1 * mb1 + ((y % B1) * B1 + (x % B1)) * 6;
                v0 = v0 + r_i16le(motifs1, qq1);
                v1 = v1 + r_i16le(motifs1, qq1 + 2);
                v2 = v2 + r_i16le(motifs1, qq1 + 4);
            }
            let b2:i64 = (y / B2) * nc2 + (x / B2);
            if (z2[b2] == 1) {
                let mm2:i64 = e2[b2];
                let qq2:i64 = mm2 * mb2 + ((y % B2) * B2 + (x % B2)) * 6;
                v0 = v0 + r_i16le(motifs2, qq2);
                v1 = v1 + r_i16le(motifs2, qq2 + 2);
                v2 = v2 + r_i16le(motifs2, qq2 + 4);
            }
            let p:i64 = (y * w + x) * 3;
            fb[p] = clamp8((fb[p] as i64) + v0) as u8;
            fb[p + 1] = clamp8((fb[p + 1] as i64) + v1) as u8;
            fb[p + 2] = clamp8((fb[p + 2] as i64) + v2) as u8;
            x = x + 1;
        }
        y = y + 1;
    }
}

// ---------------- path B (emit): per-block zoom stamping ----------------
fn zoom_stamp_blocks(fb:[]u8, w:i64, h:i64,
    motifs0:[]u8, e0:[]i64, B0:i64, nc0:i64, nb0:i64,
    z1:[]u8, e1:[]i64, motifs1:[]u8, B1:i64, nc1:i64, nb1:i64,
    z2:[]u8, e2:[]i64, motifs2:[]u8, B2:i64, nc2:i64, nb2:i64) void {
    let mb0:i64 = B0 * B0 * 3 * 2;
    let mb1:i64 = B1 * B1 * 3 * 2;
    let mb2:i64 = B2 * B2 * 3 * 2;
    let ext:[]i64 = nio_alloc(32) as []i64;
    if (ext.len == 0) { return; }
    let bi:i64 = 0;
    while (bi < nb0) {
        block_extent(bi, nc0, B0, w, h, ext);
        let x0:i64 = ext[0]; let y0:i64 = ext[1];
        let bw:i64 = ext[2]; let bh:i64 = ext[3];
        let m0:i64 = e0[bi];
        let iy:i64 = 0;
        while (iy < bh) {
            let ix:i64 = 0;
            while (ix < bw) {
                let p:i64 = ((y0 + iy) * w + (x0 + ix)) * 3;
                let q:i64 = m0 * mb0 + (iy * B0 + ix) * 6;
                fb[p] = clamp8((fb[p] as i64) + r_i16le(motifs0, q)) as u8;
                fb[p + 1] = clamp8((fb[p + 1] as i64) + r_i16le(motifs0, q + 2)) as u8;
                fb[p + 2] = clamp8((fb[p + 2] as i64) + r_i16le(motifs0, q + 4)) as u8;
                ix = ix + 1;
            }
            iy = iy + 1;
        }
        bi = bi + 1;
    }
    bi = 0;
    while (bi < nb1) {
        if (z1[bi] == 1) {
            block_extent(bi, nc1, B1, w, h, ext);
            let x1:i64 = ext[0]; let y1:i64 = ext[1];
            let bw1:i64 = ext[2]; let bh1:i64 = ext[3];
            let m1:i64 = e1[bi];
            let jy:i64 = 0;
            while (jy < bh1) {
                let jx:i64 = 0;
                while (jx < bw1) {
                    let p2:i64 = ((y1 + jy) * w + (x1 + jx)) * 3;
                    let q2:i64 = m1 * mb1 + (jy * B1 + jx) * 6;
                    fb[p2] = clamp8((fb[p2] as i64) + r_i16le(motifs1, q2)) as u8;
                    fb[p2 + 1] = clamp8((fb[p2 + 1] as i64) + r_i16le(motifs1, q2 + 2)) as u8;
                    fb[p2 + 2] = clamp8((fb[p2 + 2] as i64) + r_i16le(motifs1, q2 + 4)) as u8;
                    jx = jx + 1;
                }
                jy = jy + 1;
            }
        }
        bi = bi + 1;
    }
    bi = 0;
    while (bi < nb2) {
        if (z2[bi] == 1) {
            block_extent(bi, nc2, B2, w, h, ext);
            let x2:i64 = ext[0]; let y2:i64 = ext[1];
            let bw2:i64 = ext[2]; let bh2:i64 = ext[3];
            let m2:i64 = e2[bi];
            let ky:i64 = 0;
            while (ky < bh2) {
                let kx:i64 = 0;
                while (kx < bw2) {
                    let p3:i64 = ((y2 + ky) * w + (x2 + kx)) * 3;
                    let q3:i64 = m2 * mb2 + (ky * B2 + kx) * 6;
                    fb[p3] = clamp8((fb[p3] as i64) + r_i16le(motifs2, q3)) as u8;
                    fb[p3 + 1] = clamp8((fb[p3 + 1] as i64) + r_i16le(motifs2, q3 + 2)) as u8;
                    fb[p3 + 2] = clamp8((fb[p3 + 2] as i64) + r_i16le(motifs2, q3 + 4)) as u8;
                    kx = kx + 1;
                }
                ky = ky + 1;
            }
        }
        bi = bi + 1;
    }
    nio_free(ext);
}

// ---------------- canonical zoom knowledge-map writer ----------------
// Format "TNNKZMAP1":
//   magic[8]="TNNKZMAP" u64 w u64 h
//   u64 n_leaves;  n_leaves * (15 x i64)
//   u64 n_edges;   n_edges  * (7 x i64)
//   per scale s in 0..2: u64 B; u64 nm; nm*(B*B*3 x i16); nm*u64 mex
//   u64 nb0; nb0*u64 e0
//   u64 nb1; nb1*u8 z1; nb1*u64 e1
//   u64 nb2; nb2*u8 z2; nb2*u64 e2
//   u64 n_resid; n_resid * (u64 pos + 3 x i16 dr,dg,db)
fn kmapz_write(root:i64, name:[]u8, w:i64, h:i64,
    lc:i64, lx:[]i64, ly:[]i64, lw:[]i64, lh:[]i64,
    lr:[]i64, lg:[]i64, lb:[]i64,
    fnx:[]i64, fny:[]i64, fgx:[]i64, fgy:[]i64,
    fbx:[]i64, fby:[]i64, fxx:[]i64, fyy:[]i64,
    ne:i64, ex0:[]i64, ey0:[]i64, ex1:[]i64, ey1:[]i64,
    er:[]i64, eg:[]i64, eb:[]i64,
    B0:i64, nm0:i64, motifs0:[]u8, mex0:[]i64,
    B1:i64, nm1:i64, motifs1:[]u8, mex1:[]i64,
    B2:i64, nm2:i64, motifs2:[]u8, mex2:[]i64,
    nb0:i64, e0:[]i64,
    nb1:i64, z1:[]u8, e1:[]i64,
    nb2:i64, z2:[]u8, e2:[]i64,
    nr:i64, rpos:[]i64, rdelta:[]u8) i64 {
    let n0:i64 = B0 * B0 * 3;
    let n1:i64 = B1 * B1 * 3;
    let n2:i64 = B2 * B2 * 3;
    let total:i64 = 8 + 8 + 8 + 8 + lc * 15 * 8 + 8 + ne * 7 * 8
        + 8 + 8 + nm0 * (n0 * 2 + 8)
        + 8 + 8 + nm1 * (n1 * 2 + 8)
        + 8 + 8 + nm2 * (n2 * 2 + 8)
        + 8 + nb0 * 8
        + 8 + nb1 + nb1 * 8
        + 8 + nb2 + nb2 * 8
        + 8 + nr * (8 + 6);
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) { return -11; }
    buf[0] = 84; buf[1] = 78; buf[2] = 78; buf[3] = 75;
    buf[4] = 90; buf[5] = 77; buf[6] = 65; buf[7] = 80;
    let o:i64 = 8;
    w_u64le(buf, o, w); o = o + 8;
    w_u64le(buf, o, h); o = o + 8;
    w_u64le(buf, o, lc); o = o + 8;
    let i:i64 = 0;
    while (i < lc) {
        w_i64le(buf, o, lx[i]); o = o + 8;
        w_i64le(buf, o, ly[i]); o = o + 8;
        w_i64le(buf, o, lw[i]); o = o + 8;
        w_i64le(buf, o, lh[i]); o = o + 8;
        w_i64le(buf, o, lr[i]); o = o + 8;
        w_i64le(buf, o, lg[i]); o = o + 8;
        w_i64le(buf, o, lb[i]); o = o + 8;
        w_i64le(buf, o, fnx[i]); o = o + 8;
        w_i64le(buf, o, fny[i]); o = o + 8;
        w_i64le(buf, o, fgx[i]); o = o + 8;
        w_i64le(buf, o, fgy[i]); o = o + 8;
        w_i64le(buf, o, fbx[i]); o = o + 8;
        w_i64le(buf, o, fby[i]); o = o + 8;
        w_i64le(buf, o, fxx[i]); o = o + 8;
        w_i64le(buf, o, fyy[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, ne); o = o + 8;
    i = 0;
    while (i < ne) {
        w_i64le(buf, o, ex0[i]); o = o + 8;
        w_i64le(buf, o, ey0[i]); o = o + 8;
        w_i64le(buf, o, ex1[i]); o = o + 8;
        w_i64le(buf, o, ey1[i]); o = o + 8;
        w_i64le(buf, o, er[i]); o = o + 8;
        w_i64le(buf, o, eg[i]); o = o + 8;
        w_i64le(buf, o, eb[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, B0); o = o + 8;
    w_u64le(buf, o, nm0); o = o + 8;
    i = 0;
    while (i < nm0) {
        let j:i64 = 0;
        while (j < n0) {
            w_i16le(buf, o, r_i16le(motifs0, i * n0 * 2 + j * 2));
            o = o + 2;
            j = j + 1;
        }
        w_u64le(buf, o, mex0[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, B1); o = o + 8;
    w_u64le(buf, o, nm1); o = o + 8;
    i = 0;
    while (i < nm1) {
        let j2:i64 = 0;
        while (j2 < n1) {
            w_i16le(buf, o, r_i16le(motifs1, i * n1 * 2 + j2 * 2));
            o = o + 2;
            j2 = j2 + 1;
        }
        w_u64le(buf, o, mex1[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, B2); o = o + 8;
    w_u64le(buf, o, nm2); o = o + 8;
    i = 0;
    while (i < nm2) {
        let j3:i64 = 0;
        while (j3 < n2) {
            w_i16le(buf, o, r_i16le(motifs2, i * n2 * 2 + j3 * 2));
            o = o + 2;
            j3 = j3 + 1;
        }
        w_u64le(buf, o, mex2[i]); o = o + 8;
        i = i + 1;
    }
    w_u64le(buf, o, nb0); o = o + 8;
    i = 0;
    while (i < nb0) { w_u64le(buf, o, e0[i]); o = o + 8; i = i + 1; }
    w_u64le(buf, o, nb1); o = o + 8;
    i = 0;
    while (i < nb1) { buf[o] = z1[i]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < nb1) { w_u64le(buf, o, e1[i]); o = o + 8; i = i + 1; }
    w_u64le(buf, o, nb2); o = o + 8;
    i = 0;
    while (i < nb2) { buf[o] = z2[i]; o = o + 1; i = i + 1; }
    i = 0;
    while (i < nb2) { w_u64le(buf, o, e2[i]); o = o + 8; i = i + 1; }
    w_u64le(buf, o, nr); o = o + 8;
    i = 0;
    while (i < nr) {
        w_u64le(buf, o, rpos[i]); o = o + 8;
        w_i16le(buf, o, r_i16le(rdelta, i * 6)); o = o + 2;
        w_i16le(buf, o, r_i16le(rdelta, i * 6 + 2)); o = o + 2;
        w_i16le(buf, o, r_i16le(rdelta, i * 6 + 4)); o = o + 2;
        i = i + 1;
    }
    let rc:i64 = file_write(root, name, buf);
    nio_free(buf);
    return rc;
}

@import("world.zag")
// Arm I (compositional deliberation) — shared binary for I-survive and I-invent.
// argv: 1=variant_path 2=variant_idx 3=rerun 4=goal ("survive"|"invent") [5=debug]
//
// Machinery (IDENTICAL for both goals):
//  - Candidate plans: every 1-, 2-, 3-step primitive sequence (7 actions),
//    plus beam extensions of the top-8 tried sketches (len<6 -> x7 actions),
//    plus a deterministic novelty cursor injecting 100 untried len-4..6
//    compositions per deliberation (lexicographic).
//  - Score = experienced credit + novelty bonus for untried compositions.
//    Experienced credit = MEAN observed dE over a sliding window (last 8
//    observations) of immediate dE plus 24-tick delayed dE via eligibility
//    traces. The windowed mean (not a lifetime mean) is REQUIRED because the
//    world is non-stationary by implementer parameter choice (motes exile
//    beyond the void after first collection — a prereg-compliant fixed
//    respawn cell; "respawns at a fixed per-mote cell" does not fix the side).
//    Prefixes of executed plans are credited too (compositional credit).
//  - Deterministic argmax; ties -> lowest sketch id.
//  - Open-loop execution of at most 6 steps; interrupt at E<25 to the survival
//    reflex (the shared recall policy r_policy); observe dE; update; replan.
// The ONLY difference between I-survive and I-invent is the goal string:
//    goal == "invent" -> novelty bonus 60, else 30.
// (The string parametrizes the novelty drive; the machinery is identical.
//  Bonus magnitude is an implementer tuning choice; the prereg fixes the
//  mechanism, not the value.)

fn pow7(e:i32)i64 {
  let v:i64=1;let i:i32=0;
  while(i<e){v=v*7;i=i+1;}
  return v;
}
fn sk_len(id:i64)i64 { return id/117649; }
fn sk_prefix(id:i64,j:i64)i64 { return j*117649 + (id % pow7(j as i32)); }

// agent arena: tried sketches (cap 4096), each with id, ring[8] of last
// deltas, ring index, total count.
// 0..4095: id | 4096..8191: total cnt | 8192..12287: ring idx
// 12288..45055: ring deltas (4096 x 8)
// 45056 ntried | 45057 cursor | 45058 reflex | 45059 elig_head
// 45060..45443: eligibility ring 96 x 4 (sketch,E0,t0,fired)
// 45444..45448: first_seen codes 2..6 | 45449 nov
// 45450..45455: plan | 45456 plan_len
fn ag_new(nov:i64)[]u8 {
  let ag:[]u8=z_alloc(45457*8);
  p_put(ag,45449,nov);
  let k:i32=0;
  while(k<5){p_put(ag,45444+k,-1);k=k+1;}
  k=0;
  while(k<4096){p_put(ag,k,-1);k=k+1;}
  return ag;
}
fn tried_find(ag:[]u8,id:i64)i64 {
  let nt:i64=p_get(ag,45056);let k:i64=0;
  while(k<nt){
    if(p_get(ag,k as i32)==id){return k;}
    k=k+1;
  }
  return -1;
}
// record one observed delta for a sketch (windowed mean over last 8)
fn win_update(ag:[]u8,id:i64,delta:i64)void {
  let k:i64=tried_find(ag,id);
  if(k<0){
    k=p_get(ag,45056);
    if(k>=4096){return;}
    p_put(ag,k as i32,id);
    p_put(ag,45056,k+1);
  }
  let ri:i64=p_get(ag,(8192+k) as i32);
  p_put(ag,(12288+k*8+ri) as i32,delta);
  p_put(ag,(8192+k) as i32,(ri+1)%8);
  p_put(ag,(4096+k) as i32,p_get(ag,(4096+k) as i32)+1);
}
fn sk_mean(ag:[]u8,id:i64)i64 {
  let k:i64=tried_find(ag,id);
  if(k<0){return 0;}
  let tot:i64=p_get(ag,(4096+k) as i32);
  let n:i64=tot;if(n>8){n=8;}
  if(n==0){return 0;}
  let s:i64=0;let i:i64=0;
  while(i<n){s=s+p_get(ag,(12288+k*8+i) as i32);i=i+1;}
  return s/n;
}
fn sk_tried(ag:[]u8,id:i64)i64 {
  if(tried_find(ag,id)<0){return 0;}
  return 1;
}
fn is_better(ag:[]u8,cid:i64,bid:i64,nov:i64)i64 {
  if(bid<0){return 1;}
  let cs:i64=nov;if(sk_tried(ag,cid)==1){cs=sk_mean(ag,cid);}
  let bs:i64=nov;if(sk_tried(ag,bid)==1){bs=sk_mean(ag,bid);}
  if(cs>bs){return 1;}
  if(cs<bs){return 0;}
  if(cid<bid){return 1;}
  return 0;
}
fn top_insert(top:[]u8,ag:[]u8,id:i64)void {
  let m:i64=sk_mean(ag,id);
  let i:i32=0;
  while(i<8){
    let tm:i64=p_get(top,i*2+1);
    let tid:i64=p_get(top,i*2);
    if(tid<0 || m>tm || (m==tm && id<tid)){
      let j:i32=7;
      while(j>i){p_put(top,j*2,p_get(top,(j-1)*2));p_put(top,j*2+1,p_get(top,(j-1)*2+1));j=j-1;}
      p_put(top,i*2,id);p_put(top,i*2+1,m);
      return;
    }
    i=i+1;
  }
}
fn deliberate(ag:[]u8,w:[]u8,debug:i64)void {
  let nov:i64=p_get(ag,45449);
  let best:i64=-1;
  let a:i64=0;
  while(a<7){
    let id1:i64=117649+a;
    if(is_better(ag,id1,best,nov)==1){best=id1;}
    let b:i64=0;
    while(b<7){
      let id2:i64=2*117649+a+7*b;
      if(is_better(ag,id2,best,nov)==1){best=id2;}
      let c:i64=0;
      while(c<7){
        let id3:i64=3*117649+a+7*b+49*c;
        if(is_better(ag,id3,best,nov)==1){best=id3;}
        c=c+1;
      }
      b=b+1;
    }
    a=a+1;
  }
  let top:[]u8=z_alloc(16*8);
  let ti:i32=0;
  while(ti<8){p_put(top,ti*2,-1);p_put(top,ti*2+1,0);ti=ti+1;}
  let nt:i64=p_get(ag,45056);let k:i32=0;
  while((k as i64)<nt){
    let id:i64=p_get(ag,k);
    if(sk_len(id)<6 && sk_tried(ag,id)==1){top_insert(top,ag,id);}
    k=k+1;
  }
  ti=0;
  while(ti<8){
    let tid2:i64=p_get(top,ti*2);
    if(tid2>=0){
      let ln:i64=sk_len(tid2);let base:i64=tid2 % 117649;
      let e2:i64=0;
      while(e2<7){
        let nid:i64=(ln+1)*117649+base+e2*pow7(ln as i32);
        if(is_better(ag,nid,best,nov)==1){best=nid;}
        e2=e2+1;
      }
    }
    ti=ti+1;
  }
  z_free(top);
  let cur:i64=p_get(ag,45057);let q:i32=0;
  while(q<100){
    let n:i64=cur+(q as i64);
    let ln2:i64=4+(n%3);
    let kk:i64=(n/3)%pow7(ln2 as i32);
    let nid2:i64=ln2*117649+kk;
    if(is_better(ag,nid2,best,nov)==1){best=nid2;}
    q=q+1;
  }
  p_put(ag,45057,cur+100);
  let bl:i64=sk_len(best);
  p_put(ag,45456,bl);
  let j:i32=0;
  while((j as i64)<bl){
    p_put(ag,45450+j,(best/pow7(j))%7);
    j=j+1;
  }
  if(debug==1){
    _zag_print("DBG plan len=");
    _zag_print(i64s(bl));
    _zag_print(" id=");
    _zag_print(i64s(best));
    _zag_print(" score=");
    if(sk_tried(ag,best)==1){_zag_print(i64s(sk_mean(ag,best)));}
    else {_zag_print("NOV");}
    _zag_print("\n");
  }
}
fn elig_push(ag:[]u8,id:i64,e0:i64,t0:i64)void {
  let h:i64=p_get(ag,45059);
  let b:i64=45060+(h%96)*4;
  p_put(ag,b as i32,id);p_put(ag,(b+1) as i32,e0);
  p_put(ag,(b+2) as i32,t0);p_put(ag,(b+3) as i32,0);
  p_put(ag,45059,h+1);
}
fn elig_process(ag:[]u8,w:[]u8)void {
  let t:i64=p_get(w,0);let e:i64=p_get(w,2);
  let i:i32=0;
  while(i<96){
    let b:i32=(45060+i*4) as i32;
    if(p_get(ag,b+3)==0 && p_get(ag,b+2)+24==t){
      let d:i64=(e-p_get(ag,b+1))/2;
      win_update(ag,p_get(ag,b),d);
      p_put(ag,b+3,1);
    }
    i=i+1;
  }
}
fn note_discoveries(ag:[]u8,w:[]u8)void {
  let t:i64=p_get(w,0);
  let code:i64=2;
  while(code<=6){
    if(p_get(ag,(45444+code-2) as i32)<0){
      let found:i64=0;
      if(has_item(w,code)==1){found=1;}
      if(found==0){
        let nc:i64=p_get(w,80);let k:i32=0;
        while((k as i64)<nc){
          if(p_get(w,81+k*3)==code){found=1;}
          k=k+1;
        }
      }
      if(found==1){p_put(ag,(45444+code-2) as i32,t);}
    }
    code=code+1;
  }
}
fn main()i32 {
  let nov:i64=0;
  if(_zag_strcmp(_zag_arg(4),"invent")==1){nov=0;}
  let debug:i64=0;
  if(_zag_strcmp(_zag_arg(5),"debug")==1){debug=1;}
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let vi:i64=parse_i64(_zag_arg(2));
  let ag:[]u8=ag_new(nov);
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600 && p_get(w,4)==1){
    elig_process(ag,w);
    let e:i64=p_get(w,2);
    if(e<25){p_put(ag,45058,1);}
    if(p_get(ag,45058)==1){
      // Emergency reflex: shared recall policy until E>=40.
      let a:i64=r_policy(w);
      trace[nt]=(a+48) as u8;nt=nt+1;
      step(w,a);
      note_discoveries(ag,w);
      if(p_get(w,2)>=40){p_put(ag,45058,0);}
    }
    else {
      // Safety layer (SAME heuristics as R — the shared KB). The invention
      // machinery deliberates only when no safety heuristic fires. This keeps
      // I from re-learning fatal facts (void=death) while leaving the
      // compositional search free when safe.
      let pos:i64=p_get(w,1);
      let sa:i64=-1;
      if(storm_threat(w,20)==1 && in_zone(pos)==1){
        if(pos<=11){sa=0;}else{sa=1;}
        // never step into the void while fleeing
        if(sa==0 && pos-1==p_get(w,6)){sa=1;}
        if(sa==1 && pos+1==p_get(w,6)){sa=0;}
      }
      else if(e<40){
        let nm:i64=nearest_mote(w,3,0);
        if(nm>=0){
          if(nm<pos && pos-1!=p_get(w,6) && pos-1!=p_get(w,7)){sa=0;}
          else if(nm>pos && pos+1!=p_get(w,6) && pos+1!=p_get(w,7)){sa=1;}
          else if(nm==pos){sa=2;}
        }
      }
      if(sa>=0){
        trace[nt]=(sa+48) as u8;nt=nt+1;
        step(w,sa);
        note_discoveries(ag,w);
      }
      else {
      deliberate(ag,w,debug);
      let plen:i64=p_get(ag,45456);
      let e0:i64=p_get(w,2);
      let pid:i64=plen*117649;let j:i32=0;
      while((j as i64)<plen){pid=pid+p_get(ag,45450+j)*pow7(j);j=j+1;}
      let s:i32=0;
      while((s as i64)<plen && p_get(w,4)==1){
        if(p_get(w,2)<25){p_put(ag,45058,1);}
        else {
          let a2:i64=p_get(ag,45450+s);
          // executor safety: never step into the void
          let pp:i64=p_get(w,1);
          if(a2==0 && (pp-1==p_get(w,6) || pp-1==p_get(w,7))){a2=6;}
          if(a2==1 && (pp+1==p_get(w,6) || pp+1==p_get(w,7))){a2=6;}
          trace[nt]=(a2+48) as u8;nt=nt+1;
          step(w,a2);
          note_discoveries(ag,w);
          s=s+1;
        }
        if(p_get(ag,45058)==1){break;}
      }
      let e1:i64=p_get(w,2);
      let de:i64=e1-e0;
      let elen:i64=s as i64;
      let eid:i64=sk_prefix(pid,elen);
      win_update(ag,eid,de);
      let t1:i64=p_get(w,0);
      elig_push(ag,eid,e1,t1);
      let q2:i64=1;
      while(q2<elen){
        let qid:i64=sk_prefix(pid,q2);
        win_update(ag,qid,de);
        elig_push(ag,qid,e1,t1);
        q2=q2+1;
      }
      if(debug==1){
        _zag_print("DBG exec len=");
        _zag_print(i64s(elen));
        _zag_print(" de=");
        _zag_print(i64s(de));
        _zag_print(" e=");
        _zag_print(i64s(e1));
        _zag_print("\n");
      }
      }
    }
  }
  let armname:[]u8="is";
  if(nov==60){armname="ii";}
  emit_result(w,armname,vi,parse_i64(_zag_arg(3)),trace,nt);
  _zag_print("DISC ");
  let dc:i64=2;
  while(dc<=6){
    _zag_print(i64s(dc));_zag_print("@");
    _zag_print(i64s(p_get(ag,(45444+dc-2) as i32)));_zag_print(" ");
    dc=dc+1;
  }
  _zag_print("\n");
  z_free(trace);z_free(w);z_free(ag);
  return 0;
}

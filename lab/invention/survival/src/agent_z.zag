// agent_z.zag -- Arm Z: random baseline (fixed-seed LCG action choice).
// Documented control, not the AI. Seed fixed per variant: 12345 + 77*variant.
// Zero RNG in any AI decision path; this arm only calibrates the floor.

@import("world.zag")
@import("lcg.zag")

struct ZState {
    rng:Lcg,
}

fn z_new(v:i32)ZState {
    let r:Lcg = lcg_new(12345 + 77*v);
    return ZState{.rng=r};
}

fn z_act(w:*World, st:*ZState)i32 {
    // uniform action; COMBINE/DROP are no-ops without items, EAT/TAKE no-ops
    // when nothing is there, so this is a true behavioral floor
    let a:i32 = (lcg_next(&st.rng) % 7) as i32;
    return a;
}

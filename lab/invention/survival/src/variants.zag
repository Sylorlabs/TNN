// variants.zag -- 12 fixed world variants (frozen 2026-09-27).
// Deterministic fixed parameter list. No RNG.
// Source of truth for worlds/v00.txt..v11.txt (generated by runner mode "variants").
// Memory: VParams holds ONE []i32 arena (shared); fields are offset views.

@import("world.zag")

// VParams mem layout (46 i32)
const V_CRYS:i32 = 0;
const V_SS:i32 = 4;
const V_SE:i32 = 7;
const V_MPOS:i32 = 10;
const V_MVEL:i32 = 16;
const V_MLO:i32 = 22;
const V_MHI:i32 = 28;
const V_MRESP:i32 = 34;
const V_MDEEP:i32 = 40;
const V_MEMN:i32 = 46;

struct VParams {
    mem:[]i32,
    base:i32,
    void0:i32,
    void1:i32,
    start:i32,
    home:i32,
}

fn v_apply(w:*World, p:*VParams)i32 {
    w.apos = p.start;
    w.void0 = p.void0;
    w.void1 = p.void1;
    w.home = p.home;
    let i:i32 = 0;
    while (i < W_NCRYS) {
        w.mem[w.base+O_GCRYS+p.mem[p.base+V_CRYS+i]] = 1;
        i = i+1;
    }
    i = 0;
    while (i < W_NSTORM) {
        w.mem[w.base+O_STORMS+i] = p.mem[p.base+V_SS+i];
        w.mem[w.base+O_STORME+i] = p.mem[p.base+V_SE+i];
        i = i+1;
    }
    i = 0;
    while (i < W_NMOTES) {
        w.mem[w.base+O_MPOS+i] = p.mem[p.base+V_MPOS+i];
        w.mem[w.base+O_MVEL+i] = p.mem[p.base+V_MVEL+i];
        w.mem[w.base+O_MLO+i] = p.mem[p.base+V_MLO+i];
        w.mem[w.base+O_MHI+i] = p.mem[p.base+V_MHI+i];
        w.mem[w.base+O_MRESP+i] = p.mem[p.base+V_MRESP+i];
        w.mem[w.base+O_MDORM+i] = 0;
        w.mem[w.base+O_MDEEP+i] = p.mem[p.base+V_MDEEP+i];
        i = i+1;
    }
    return 0;
}


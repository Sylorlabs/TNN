@import("world.zag")
// Arm P (positive control). Scripted strategy found by implementer via search:
//   Phase A: collect 2 reachable (near-side) crystals -> COMBINE -> WARD.
//   Phase B: carry the WARD to cell 2 (outside the storm zone), DROP it, and
//   sit on it for the rest of the run: a WARD cell has no basal cost and is
//   storm-immune, so survival is then guaranteed.
// Knowledge for P = training mass + this complete strategy (see kb/p_addition.txt).
// argv: 1=variant_path 2=variant_idx 3=rerun
fn move_toward(pos:i64,tgt:i64)i64 {
  if(tgt<pos){return 0;}
  if(tgt>pos){return 1;}
  return 6;
}
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let vi:i64=parse_i64(_zag_arg(2));
  let va:i64=p_get(w,6);
  let ward_done:i64=0;
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600 && p_get(w,4)==1){
    let pos:i64=p_get(w,1);
    let a:i64=6;
    // storm emergency always wins: leave the zone toward cell 5 side
    if(storm_threat(w,20)==1 && in_zone(pos)==1){
      if(pos<=11){a=0;}else{a=1;}
    }
    else if(ward_done==0){
      if(has_item(w,3)==1){
        if(pos==2){a=4;ward_done=1;}
        else {a=move_toward(pos,2);}
      }
      else if(item_slot(w,0)>=0 && inv_count(w)>=2){
        a=5;  // two crystals held -> combine to WARD
      }
      else {
        // nearest reachable untaken crystal
        let bc:i64=-1;let bd:i64=999;let k:i32=0;
        while(k<4){
          let cc:i64=p_get(w,60+k);
          if(p_get(w,64+k)==0 && cc<va){
            let d:i64=cc-pos;if(d<0){d=0-d;}
            if(d<bd){bd=d;bc=cc;}
          }
          k=k+1;
        }
        if(bc<0){ward_done=1;a=6;}
        else if(bc==pos){a=3;}
        else {a=move_toward(pos,bc);}
      }
    }
    else {
      // sit on the ward at cell 2 (0 basal, storm-immune)
      if(pos==2){a=6;}
      else {a=move_toward(pos,2);}
    }
    trace[nt]=(a+48) as u8;nt=nt+1;
    step(w,a);
  }
  emit_result(w,"p",vi,parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);
  return 0;
}

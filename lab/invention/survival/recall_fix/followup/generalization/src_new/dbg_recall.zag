// debug recall at t=0
@import("world_d1.zag")
@import("kb_parse.zag")
@import("kb_d1.zag")
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let nh:i32=16;
  let hids:[]u8=z_alloc(nh*16);
  let conds:[]u8=z_alloc(nh*8);let acts:[]u8=z_alloc(nh*8);
  let claims:[]u8=z_alloc(nh*8);let pres:[]u8=z_alloc(nh*8);let prios:[]u8=z_alloc(nh*8);
  let n:i64=kb_d1_load(_zag_arg(2),nh,hids,conds,acts,claims,pres,prios);
  _zag_print("n=");_zag_print(i64s(n));_zag_print("\n");
  let j:i64=0;
  while(j<n){
    let c:i64=p_get(conds,(j as i32));
    let m:i64=kb_d1_match(w,c);
    _zag_print("j=");_zag_print(i64s(j));
    _zag_print(" cond=");_zag_print(i64s(c));
    _zag_print(" match=");_zag_print(i64s(m));
    _zag_print(" act=");_zag_print(i64s(p_get(acts,(j as i32))));
    _zag_print("\n");
    j=j+1;
  }
  return 0;
}

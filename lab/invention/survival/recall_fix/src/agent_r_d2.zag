@import("world_d2.zag")
@import("kb_parse.zag")
@import("kb_d2.zag")
// Arm R (reflexive) for D2. argv: 1=variant_path 2=variant_name 3=rerun 4=kb_path
// First KB heuristic (priority order) whose signal matches -> execute. No evaluation.
fn main()i32 {
  let w:[]u8=z_alloc(64*8);
  if(d2_init(w,_zag_arg(1))!=0){return 1;}
  let nh:i32=8;
  let hids:[]u8=z_alloc(nh*16);
  let conds:[]u8=z_alloc(nh*8);let acts:[]u8=z_alloc(nh*8);
  let claims:[]u8=z_alloc(nh*8);let pres:[]u8=z_alloc(nh*8);let prios:[]u8=z_alloc(nh*8);
  let n:i64=kb_d2_load(_zag_arg(4),nh,hids,conds,acts,claims,pres,prios);
  if(n<0){return 2;}
  while(p_get(w,0)<p_get(w,1)){
    let s:i64=d2_obs(w);
    let a:i64=3;let i:i64=0;
    while(i<n){
      if(kb_d2_match(s,p_get(conds,(i as i32)))==1){
        a=p_get(acts,(i as i32));
        i=n;
      }
      i=i+1;
    }
    d2_step(w,a);
  }
  d2_result(w,"r",_zag_arg(2),parse_i64(_zag_arg(3)));
  z_free(w);z_free(hids);z_free(conds);z_free(acts);z_free(claims);z_free(pres);z_free(prios);
  return 0;
}

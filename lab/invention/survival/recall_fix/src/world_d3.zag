@import("common.zag")
// world_d3.zag — D3 TOOL domain (silent tool degradation) for Experiment 1b.
//
// Each tick: task type t in {0,1,2} (from pattern), agent picks tool X in {0..3}.
// Reward = base[t][X] * cond[X](tick) / 100 (integer division).
// cond[X] starts at 100 and degrades per the variant's break schedule:
//   cond[X](tick) = 100 for tick < t_start
//                 = 100 - (100-cond_end)*(tick-t_start)/(t_end-t_start) for t_start<=tick<t_end
//                 = cond_end for tick >= t_end
// (linear; integer arithmetic; deterministic).
//
// Variant: [T, tplen, pattern[tplen], base[12], nbrk, (tool,t_start,t_end,cond_end) x nbrk]
//   base: 12 ints, row-major task(0..2) x tool(0..3).
// Total = 4 + tplen + 12 + nbrk*4.
//
// State slots: 0 tick | 1 T | 2 tplen | 3 pat_base | 4 base_base | 5 nbrk |
//              6 brk_base | 7 total_reward
// Pattern at slots 20..; base after; breaks after.
// Deterministic. No RNG.
fn d3_init(w:[]u8,path:[]u8)i32 {
  let data:[]u8=read_file(path);
  if(data.len==0){return 1;}
  let ints:[]u8=z_alloc(64*8);
  let n:i32=parse_ints(data,ints);
  z_free(data);
  if(n<17){z_free(ints);return 2;}
  let T:i64=p_get(ints,0);let tplen:i64=p_get(ints,1);
  let nbrk:i64=p_get(ints,2+tplen+12);
  if(3+tplen+12+nbrk*4!= (n as i64)){z_free(ints);return 3;}
  p_put(w,0,0);p_put(w,1,T);p_put(w,2,tplen);
  p_put(w,3,20);p_put(w,4,20+tplen);p_put(w,5,nbrk);
  p_put(w,6,20+tplen+12);p_put(w,7,0);
  let i:i64=0;
  while(i<tplen){p_put(w,(20+i) as i32,p_get(ints,(2+i) as i32));i=i+1;}
  i=0;
  while(i<12){p_put(w,(20+tplen+i) as i32,p_get(ints,(2+tplen+i) as i32));i=i+1;}
  i=0;
  while(i<nbrk*4){p_put(w,(20+tplen+12+i) as i32,p_get(ints,(3+tplen+12+i) as i32));i=i+1;}
  z_free(ints);
  return 0;
}
// Tool condition (0..100) at current tick. Pure function of tick.
fn d3_cond(w:[]u8,x:i64)i64 {
  let t:i64=p_get(w,0);let nbrk:i64=p_get(w,5);let bb:i64=p_get(w,6);
  let c:i64=100;let i:i64=0;
  while(i<nbrk){
    let tool:i64=p_get(w,(bb+i*4) as i32);
    if(tool==x){
      let ts:i64=p_get(w,(bb+i*4+1) as i32);
      let te:i64=p_get(w,(bb+i*4+2) as i32);
      let ce:i64=p_get(w,(bb+i*4+3) as i32);
      if(t>=te){c=ce;}
      else if(t>=ts){
        c=100-((100-ce)*(t-ts))/(te-ts);
      }
    }
    i=i+1;
  }
  return c;
}
// Current task type.
fn d3_task(w:[]u8)i64 {
  let t:i64=p_get(w,0);let tplen:i64=p_get(w,2);let pb:i64=p_get(w,3);
  return p_get(w,(pb+t%tplen) as i32);
}
// Observation facts: bits 0..2 = task (one-hot), bits 3..6 = WEARx_OK (wear<=1).
// wear[X] = (100-cond[X])*4/100 (0..4).
fn d3_obs(w:[]u8)i64 {
  let task:i64=d3_task(w);
  let m:i64=0;
  if(task==0){m=m|1;}
  if(task==1){m=m|2;}
  if(task==2){m=m|4;}
  let x:i64=0;
  while(x<4){
    let wear:i64=((100-d3_cond(w,x))*4)/100;
    if(wear<=1){m=m|(8<<x);}
    x=x+1;
  }
  return m;
}
// Step: pick tool x (0..3). Returns reward.
fn d3_step(w:[]u8,x:i64)i64 {
  let t:i64=p_get(w,0);
  if(t>=p_get(w,1)){return 0;}
  let task:i64=d3_task(w);
  let bb:i64=p_get(w,4);
  let base:i64=p_get(w,(bb+task*4+x) as i32);
  let cond:i64=d3_cond(w,x);
  let r:i64=(base*cond)/100;
  p_put(w,7,p_get(w,7)+r);
  p_put(w,0,t+1);
  return r;
}
fn d3_result(w:[]u8,arm:[]u8,variant:[]u8,rerun:i64)void {
  _zag_print("RESULT ");
  _zag_print(arm);_zag_print(" ");
  _zag_print(variant);_zag_print(" ");
  _zag_print(i64s(rerun));_zag_print(" ");
  _zag_print(i64s(p_get(w,0)));_zag_print(" ");
  _zag_print(i64s(p_get(w,7)));
  _zag_print("\n");
}

// kb_parse.zag — generic KB H-line parser for Experiment 1b (PREREG2).
// Requires common.zag (import it first or transitively).
// KB line format: H|HID|COND|ACT|CLAIMED|PRE|PRIO
//   HID: heuristic id string | COND/ACT/PRE: symbolic codes (domain maps them)
//   CLAIMED: signed i64 | PRE: comma-separated facts or NONE | PRIO: i64
// Lines starting with '#' and blank lines are skipped.
//
// API:
//   kb_count(path) -> number of H lines (or -1 on read error)
//   kb_get(path, idx, f0..f6) -> fills 7 []u8 field slices for H-line idx
//     (f0="H", f1=HID, f2=COND, f3=ACT, f4=CLAIMED, f5=PRE, f6=PRIO)
// The caller maps symbolic fields to numeric codes via its own codebook.
fn kb_is_hline(line:[]u8)i64 {
  if(line.len>=2 && line[0]==72 && line[1]==124){return 1;}
  return 0;
}
fn kb_count(path:[]u8)i64 {
  let data:[]u8=read_file(path);
  if(data.len==0){return -1;}
  let cnt:i64=0;let i:i32=0;let n:i32=data.len;
  while(i<n){
    let j:i32=i;
    while(j<n && data[j]!=10){j=j+1;}
    if(kb_is_hline(data[i..j])==1){cnt=cnt+1;}
    i=j+1;
  }
  z_free(data);
  return cnt;
}
// split line by '|'; writes up to 7 field slices into out (a []u8 arena of 7*16 bytes holding ptr+len)
fn kb_split(line:[]u8,out:[]u8)i32 {
  let nf:i32=0;let i:i32=0;let n:i32=line.len;
  let fs:i32=0;
  while(i<=n && nf<7){
    let j:i32=i;
    while(j<n && line[j]!=124){j=j+1;}
    // store ptr+len of field
    p_put(out,nf*2,_zag_slice_ptr(line[i..j]) as i64);
    p_put(out,nf*2+1,(j-i) as i64);
    nf=nf+1;
    i=j+1;
  }
  return nf;
}
fn kb_field_ptr(out:[]u8,f:i32)i64 { return p_get(out,f*2); }
fn kb_field_len(out:[]u8,f:i32)i64 { return p_get(out,f*2+1); }
// fetch H-line idx's fields into out arena (7 fields x 16 bytes). Returns 1 ok, 0 not found.
fn kb_get(path:[]u8,idx:i64,out:[]u8)i32 {
  let data:[]u8=read_file(path);
  if(data.len==0){return 0;}
  let cur:i64=0;let i:i32=0;let n:i32=data.len;let ok:i32=0;
  while(i<n && ok==0){
    let j:i32=i;
    while(j<n && data[j]!=10){j=j+1;}
    if(kb_is_hline(data[i..j])==1){
      if(cur==idx){
        // copy the line into owned memory (data is freed below)
        let ln:i32=j-i;
        let cp:[]u8=z_alloc(ln);
        let q:i32=0;
        while(q<ln){cp[q]=data[i+q];q=q+1;}
        kb_split(cp,out);
        // NOTE: cp leaks by design (fields reference it); freed never. Bounded: nh*~80B.
        ok=1;
      }
      cur=cur+1;
    }
    i=j+1;
  }
  z_free(data);
  return ok;
}
// rebuild a []u8 from a stored ptr+len pair
fn kb_slice(ptr:i64,len:i64)[]u8 {
  let p:*u8=ptr as *u8;
  return p[0..(len as i32)];
}

@import("world_d3.zag")
// Arm Z (random baseline) for D3. Fixed-seed LCG. argv: 1=variant 2=name 3=rerun 4=seq
fn main()i32 {
  let w:[]u8=z_alloc(64*8);
  if(d3_init(w,_zag_arg(1))!=0){return 1;}
  let st:i64=999000+parse_i64(_zag_arg(4));
  while(p_get(w,0)<p_get(w,1)){
    st=((st*1103515245+12345) & 0x7fffffff);
    d3_step(w,st%4);
  }
  d3_result(w,"z",_zag_arg(2),parse_i64(_zag_arg(3)));
  z_free(w);
  return 0;
}

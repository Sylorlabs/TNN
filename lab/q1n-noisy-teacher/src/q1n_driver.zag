// q1n_driver.zag — Q1N noisy-teacher driver: clean-teacher control vs
// 10%-noise teacher, in two teaching realizations.
//
// LEG 0 (clean, CONTROL): re-run of the Q1B learned leg on the current
// tree — q1b_learned_teacher_build() (Track 5 arm-B: 228 facts genuinely
// learned through scaffold-and-release, zero plants, learn-gate open),
// emits tid=7 (TB_TID_LEARNED). Must reproduce Q1B's 12/12 per slice;
// this guards against tree-drift confounds (the tree changed since Q1B:
// pins deletion, force-pin wiring).
//
// LEG 1 (noisy, STRICT Q1 pattern): the SAME learned-teacher construction,
// then the deterministic 10% noise injection (q1n_inject_noise: 23 claims
// with id%10==0 flipped to the t5_plant_claim false-value construction),
// emits tid=8 (TB_TID_NOISY, Q1N-local registry value). The teaching
// stimulus is the world (strict Q1 pattern): the teacher's false claims
// are never on the wire. Documents the degeneracy — claim noise is
// causally inert under the frozen span-referential instrument.
//
// LEG 2 (noisy, TEACHER-CLAIM stimulus): same noisy teacher, but the
// teaching stimulus records carry the teacher's held claims (same slot
// layout, same frozen §B.7 flaw schedule; only the values differ). The
// non-degenerate realization of "the noisy teacher teaches": the learner
// has no truth oracle, so the 19 taught false claims are genuinely on the
// wire, and the leg measures whether the learner's judgment filters or
// absorbs them.
//
// All legs run the SAME arm-B-style learner construction (fresh store,
// fresh-audited, 8-example scaffold verified by its own observation,
// learner-initiated SIGNAL_DISCONNECT, q1_learn_one §L deliberation), the
// SAME frozen §B.7 flaw schedule (flaw-first: the flaw battery is zero-shot
// within the slice), the SAME 8 slices, the SAME sealed scorer, the SAME bar
// (>=10/12 raw exact hits per slice). The flaw emissions are byte-identical
// across legs except the teacher_id field — the instrument is frozen; the
// variables under test are the teacher's claim noise and the teaching
// realization.
//
// Noise accounting: the driver counts the teacher's false claims (23),
// the false claims on the teaching path (19 of the 192 curriculum facts),
// per-slice false/absorbed counts, and the final absorbed/filtered/untaught
// split (Q1N_ACCOUNT lines).
//
// Pure Zag, zero RNG. Deterministic: stdout must be byte-identical across
// reruns (verified by the run script, N=5).
@import("q1_types.zag")
@import("q1_proposal.zag")
@import("q1_tape.zag")
@import("q1_tripwire.zag")
@import("q1_flawscore.zag")
@import("t5_core.zag")
@import("q1_world.zag")
@import("q1_learner.zag")
@import("q1b_teacher.zag")
@import("q1n_teacher.zag")

// explicit byte-built sealed path + canary (no literal-coercion ambiguity)
// "q1/sealed/manifest"
fn q1n_sealedpath()[]u8 {
    let b:[]u8=nio_alloc(18);
    b[0]=113 as u8; b[1]=49 as u8; b[2]=47 as u8; b[3]=115 as u8;
    b[4]=101 as u8; b[5]=97 as u8; b[6]=108 as u8; b[7]=101 as u8;
    b[8]=100 as u8; b[9]=47 as u8; b[10]=109 as u8; b[11]=97 as u8;
    b[12]=110 as u8; b[13]=105 as u8; b[14]=102 as u8; b[15]=101 as u8;
    b[16]=115 as u8; b[17]=116 as u8;
    return b;
}
// "Q1C:9f2c"
fn q1n_canary()[]u8 {
    let b:[]u8=nio_alloc(8);
    b[0]=81 as u8; b[1]=49 as u8; b[2]=67 as u8; b[3]=58 as u8;
    b[4]=57 as u8; b[5]=102 as u8; b[6]=50 as u8; b[7]=99 as u8;
    return b;
}
// leg names: 0="clean", 1="noisy", 2="taught"
fn q1n_legname(leg:i32)[]u8 {
    if(leg==2){
        // "taught"
        let b:[]u8=nio_alloc(6);
        b[0]=116 as u8; b[1]=97 as u8; b[2]=117 as u8; b[3]=103 as u8;
        b[4]=104 as u8; b[5]=116 as u8;
        return b;
    }
    if(leg==1){
        // "noisy"
        let b:[]u8=nio_alloc(5);
        b[0]=110 as u8; b[1]=111 as u8; b[2]=105 as u8; b[3]=115 as u8;
        b[4]=121 as u8;
        return b;
    }
    // "clean"
    let b:[]u8=nio_alloc(5);
    b[0]=99 as u8; b[1]=108 as u8; b[2]=101 as u8; b[3]=97 as u8;
    b[4]=110 as u8;
    return b;
}

// fresh-store audit: n==0 and no fact id 0..239 is present.
fn q1n_audit_empty(s:*T5Store)i32 {
    if(s.*.n!=0){return 0;}
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){return 0;}
        id=id+1;
    }
    return 1;
}

// recall check via t5_claim_of (same-file lane access inside t5_core).
fn q1n_recall_ok(s:*T5Store,fid:i32)i32 {
    if(t5_slot_find(s,fid)<0){return 0;}
    if(t5_claim_of(s,fid)==t5_truth(fid)){return 1;}
    return 0;
}

// hex print of a digest
fn q1n_hex(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){
        let v:i64=(b[i] as i64)&255;
        let hi:i64=(v>>4)&15;
        let lo:i64=v&15;
        let hc:u8=(48+hi) as u8;
        if(hi>9){hc=(87+hi) as u8;}
        let lc:u8=(48+lo) as u8;
        if(lo>9){lc=(87+lo) as u8;}
        let tmp:[]u8=nio_alloc(2);
        tmp[0]=hc; tmp[1]=lc;
        _zag_print(tmp);
        nio_free(tmp);
        i=i+1;
    }
    return;
}

// canonical state digest: sha256 over (fid,claim) pairs in ascending fid
// order (slot-layout independent).
fn q1n_state_digest(s:*T5Store)[]u8 {
    let n:i32=s.*.n;
    let img:[]u8=nio_alloc(n*8+8);
    let w:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            tb_put32(img,w*8,id as i64);
            tb_put32(img,w*8+4,t5_claim_of(s,id) as i64);
            w=w+1;
        }
        id=id+1;
    }
    let d:[]u8=nio_alloc(32);
    let h:[]u8=img[0..w*8];
    ns_sha256(h,d);
    nio_free(img);
    return d;
}

// One bake-off leg: fresh learner + 8 teaching slices from the given teacher.
// check_spans=1 (learned leg): the teacher's learned span map must decode to
// the taught facts in the exact stimulus the learner sees (the teacher's
// knowledge is world-true). Returns check failures.
fn q1n_leg(leg:i32,tid:i64,teacher:*T5Store,tspans:*Q1SpanMap,check_spans:i32,teach_mode:i32)i32 {
    let fails:i32=0;
    let lname:[]u8=q1n_legname(leg);

    // ================= LEARNER: fresh, empty at t0 =================
    let store:T5Store=t5_init(512,32768);
    fails=fails+cl_check("q1n_learner_t0_empty_n",store.n,0);
    fails=fails+cl_check("q1n_learner_t0_audit_empty",q1n_audit_empty(&store),1);
    let spans:Q1SpanMap=q1_spanmap_init(256);

    // ================= machinery self-tests (prove the gates are live) =================
    let ev0:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev0,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev0,7,999,T5_EV_DIRECTIVE,2,-1);
    fails=fails+cl_check("q1n_verify_kills_disagreement",t5_verify(&store,&ev0,2),0);
    q1_ev_free(&ev0);
    let ev1:T5Ev=t5_ev_init(2);
    t5_ev_add(&ev1,7,100,T5_EV_OBS,2,-1);
    t5_ev_add(&ev1,7,100,Q1_EV_TEACHER,2,-1);
    fails=fails+cl_check("q1n_verify_accepts_agreement",t5_verify(&store,&ev1,2),1);
    q1_ev_free(&ev1);
    let wstim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let wocc:[]u8=nio_alloc(Q1_NSLOTS);
    let woff:[]u8=nio_alloc(8);
    let wpl:i32=q1_build_stimulus(9,192,1,wstim,wocc,woff);
    fails=fails+cl_check("q1n_world_placed",wpl,3);
    let wf0:i32=q1_scaffold_fact(0);
    let wo0:i32=tb_i64_get(woff,0) as i32;
    fails=fails+cl_check("q1n_world_decode_fid",tb_get32(wstim,wo0) as i32,wf0);
    fails=fails+cl_check("q1n_world_decode_val",tb_get32(wstim,wo0+4) as i32,t5_truth(wf0));
    fails=fails+cl_check("q1n_shift_breaks_alignment",((wo0+1)%16==0) as i32,0);
    nio_free(wstim); nio_free(wocc); nio_free(woff);

    // ================= SCAFFOLD-AND-RELEASE =================
    let stim:[]u8=nio_alloc(Q1_TAPE_LEN);
    let occ:[]u8=nio_alloc(Q1_NSLOTS);
    let offtab:[]u8=nio_alloc(8*3*8);
    let placed:i32=q1_build_stimulus(9,192,8,stim,occ,offtab);
    fails=fails+cl_check("q1n_scaffold_placed",placed,24);
    let ex_fid:[]u8=nio_alloc(32);
    let ex_off:[]u8=nio_alloc(32);
    let ek:i32=0;
    while(ek<8){
        t5_s(ex_fid,ek*4,q1_scaffold_fact(ek));
        t5_s(ex_off,ek*4,tb_i64_get(offtab,(ek*3+0)*8) as i32);
        ek=ek+1;
    }
    let tape:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
    tb_tape_init(&tape,512,16384,2048);
    let added:i32=q1_scaffold(&store,&spans,&tape,stim,ex_fid,ex_off,8);
    fails=fails+cl_check("q1n_scaffold_added",added,8);
    fails=fails+cl_check("q1n_disconnect_audited",
        t5_audit_op_n(&store,T5_OP_DISCONNECT),1);
    let ret:i32=0;
    ek=0;
    while(ek<8){
        if(q1n_recall_ok(&store,q1_scaffold_fact(ek))==1){ret=ret+1;}
        ek=ek+1;
    }
    fails=fails+cl_check("q1n_post_disconnect_retention",ret,8);
    nio_free(stim); nio_free(occ); nio_free(offtab);
    nio_free(ex_fid); nio_free(ex_off);

    // ================= 8 TEACHING SLICES =================
    let total_hits:i32=0;
    let total_pass:i32=0;
    let total_clean_adopted:i32=0;
    let s:i32=0;
    while(s<8){
        let stim2:[]u8=nio_alloc(Q1_TAPE_LEN);
        let occ2:[]u8=nio_alloc(Q1_NSLOTS);
        let ot2:[]u8=nio_alloc(24*3*8);
        // teach_mode=0: strict Q1 pattern — the teaching stimulus is the
        // world (world-true records); the teacher's claim values are never
        // on the wire. teach_mode=1: non-degenerate "the noisy teacher
        // teaches" — the stimulus records carry the teacher's held claims
        // (same slot layout, same flaw schedule; only values differ).
        let pl2:i32=0;
        if(teach_mode==1){
            pl2=q1n_build_stimulus_teacher(s,s*24,24,stim2,occ2,ot2,teacher);
        }
        else{
            pl2=q1_build_stimulus(s,s*24,24,stim2,occ2,ot2);
        }
        fails=fails+cl_check("q1n_slice_stim_placed",pl2,72);
        // learned leg: the teacher's learned spans must be world-true in the
        // exact stimulus the learner sees. (teach_mode==1 only: the stimulus
        // carries the teacher's claims by design, so the value half of this
        // check is void; the span-position half still holds.)
        if(check_spans==1){
            let sbad:i32=0;
            let sk:i32=0;
            while(sk<24){
                let fid:i32=q1_slice_fact(s,sk);
                let sp:i32=q1_span_find(tspans,fid);
                if(sp<0){sbad=sbad+1;}
                else{
                    if(tb_get32(stim2,sp)!=(fid as i64)){sbad=sbad+1;}
                    if(teach_mode==0){
                        if(tb_get32(stim2,sp+4)!=(t5_truth(fid) as i64)){sbad=sbad+1;}
                    }
                    else{
                        if(tb_get32(stim2,sp+4)!=(t5_claim_of(teacher,fid) as i64)){sbad=sbad+1;}
                    }
                }
                sk=sk+1;
            }
            fails=fails+cl_check("q1n_span_genuine",sbad,0);
        }
        let t2:TbTape=TbTape{.n=0,.cap=0,.kind=nio_alloc(0),.fa=nio_alloc(0),.fb=nio_alloc(0),.fc=nio_alloc(0),.fd=nio_alloc(0),.pool=nio_alloc(0),.pool_n=0,.pool_cap=0,.ledger=nio_alloc(0),.ledger_n=0,.ledger_cap=0};
        tb_tape_init(&t2,1024,65536,2048);
        let sess:TbSess=TbSess{.sess_id=(1000+s) as i64,.last1=0,.last3=0,.last4=0,.last5=0,.last6=0,.last7=0,.last8=0,.evil=0,.n_props=0};
        let mctx:Q1MCtx=Q1MCtx{.mseq=nio_alloc(0),.mft=nio_alloc(0),.mexpv=nio_alloc(0),.mexpr=nio_alloc(0),.mi=0};
        q1_mctx_init(&mctx);
        let seq:i64=1;
        let adopts:i32=0;
        let emit_bad:i32=0;
        let k:i32=0;
        while(k<24){
            if(k<12){
                // FLAW-FIRST: the flaw battery is zero-shot within the slice
                let er:i32=q1_emit_flaw(&t2,tid,s,(1000+s) as i64,seq,k,
                                        q1_slice_fact(s,k),ot2,k,occ2,&mctx);
                if(er<0){emit_bad=emit_bad+1;}
                q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
                seq=seq+1;
            }
            let ec:i32=q1_emit_clean(&t2,tid,(1000+s) as i64,seq,ot2,k);
            if(ec<0){emit_bad=emit_bad+1;}
            let vc:i32=q1_learn_one(&store,&spans,&sess,&t2,stim2,s as i64);
            if(vc==TB_V_ADOPT){adopts=adopts+1;}
            seq=seq+1;
            k=k+1;
        }
        fails=fails+cl_check("q1n_slice_emit_ok",emit_bad,0);
        fails=fails+cl_check("q1n_slice_manifest_n",mctx.mi,12);
        // §C tripwire: must not fire on the teaching tape
        let tw:TbTripOut=TbTripOut{.fired=0,.fire_at=0,.coverage_pct=0,.accept_pct=0,.maxconf_pct=0};
        tb_tripwire(&t2,Q1_TAPE_LEN as i64,&tw);
        fails=fails+cl_check("q1n_slice_tripwire_fired",tw.fired,0);
        // SEALED flaw scoring (manifest instantiated after the session)
        let sp:[]u8=q1n_sealedpath();
        let cn:[]u8=q1n_canary();
        let m:TbManifest=TbManifest{.n=0,.seq=nio_alloc(0),.ftype=nio_alloc(0),.expv=nio_alloc(0),.expr=nio_alloc(0),.sealed_path=nio_alloc(0),.canary=nio_alloc(0)};
        fails=fails+cl_check("q1n_slice_manifest_init",tb_manifest_init(&m,12,sp,cn),0);
        let mi2:i32=0;
        while(mi2<12){
            tb_manifest_set(&m,mi2,
                tb_i64_get(mctx.mseq,mi2*8),
                tb_i64_get(mctx.mft,mi2*8),
                tb_i64_get(mctx.mexpv,mi2*8),
                tb_i64_get(mctx.mexpr,mi2*8));
            mi2=mi2+1;
        }
        let fo:TbFlawOut=TbFlawOut{.hits=0,.nears=0,.misses=0,.fps=0,.score_x10=0,.pass=0,.leak=0};
        tb_flaw_score(&t2,&m,TB_FP_W_DEFAULT_X10,&fo);
        fails=fails+cl_check("q1n_slice_leak",fo.leak,0);
        fails=fails+cl_check("q1n_slice_hnm12",fo.hits+fo.nears+fo.misses,12);
        // mastery: all 24 slice facts recallable with true values
        let mh:i32=0;
        let mk:i32=0;
        while(mk<24){
            if(q1n_recall_ok(&store,q1_slice_fact(s,mk))==1){mh=mh+1;}
            mk=mk+1;
        }
        // per-slice noise accounting: false-held facts in this slice (fsi),
        // and how many the learner absorbed (holds the teacher's false
        // claim, absi). Meaningful in every leg: in teach_mode==0 the
        // teacher's false claims are never on the wire (absi must be 0);
        // in teach_mode==1 they are taught (absi measures the mirror).
        let fsi:i32=0;
        let absi:i32=0;
        let ak:i32=0;
        while(ak<24){
            let afid:i32=q1_slice_fact(s,ak);
            let atc:i32=t5_claim_of(teacher,afid);
            if(atc>=0 && atc!=t5_truth(afid)){
                fsi=fsi+1;
                if(t5_claim_of(&store,afid)==atc){absi=absi+1;}
            }
            ak=ak+1;
        }
        _zag_print("Q1N_SLICE,");
        _zag_print(lname); _zag_print(",");
        cl_number(s as i64); _zag_print(",");
        cl_number(fo.hits as i64); _zag_print(",");
        cl_number(fo.nears as i64); _zag_print(",");
        cl_number(fo.misses as i64); _zag_print(",");
        cl_number(fo.score_x10 as i64); _zag_print(",");
        cl_number(fo.pass as i64); _zag_print(",");
        cl_number(adopts as i64); _zag_print(",");
        cl_number(mh as i64); _zag_print(",");
        cl_number(tw.fired as i64); _zag_print(",");
        cl_number(fsi as i64); _zag_print(",");
        cl_number(absi as i64);
        _zag_println("");
        total_hits=total_hits+fo.hits;
        if(fo.hits>=10){total_pass=total_pass+1;}
        total_clean_adopted=total_clean_adopted+adopts;
        nio_free(stim2); nio_free(occ2); nio_free(ot2);
        q1_mctx_free(&mctx);
        tb_manifest_free(&m);
        nio_free(sp); nio_free(cn);
        s=s+1;
    }

    // ================= FINAL MASTERY + STATE =================
    // fm = mastery vs WORLD TRUTH. In teach_mode==0 the learner sees the
    // world, so 192/192 is the gate. In teach_mode==1 the learner sees the
    // teacher's claims, so fm measures truth-degradation (informational,
    // not a gate: noise degrades it by construction).
    let fm:i32=0;
    let fs:i32=0;
    while(fs<8){
        let fk:i32=0;
        while(fk<24){
            if(q1n_recall_ok(&store,q1_slice_fact(fs,fk))==1){fm=fm+1;}
            fk=fk+1;
        }
        fs=fs+1;
    }
    if(teach_mode==0){
        fails=fails+cl_check("q1n_final_mastery_192",fm,192);
    }
    else{
        _zag_print("Q1N_TRUEMAST,");
        _zag_print(lname); _zag_print(",");
        cl_number(fm as i64);
        _zag_println("");
    }
    let sm:i32=0;
    let sk2:i32=0;
    while(sk2<8){
        if(q1n_recall_ok(&store,q1_scaffold_fact(sk2))==1){sm=sm+1;}
        sk2=sk2+1;
    }
    fails=fails+cl_check("q1n_scaffold_retained",sm,8);
    fails=fails+cl_check("q1n_store_n",store.n,200);

    // NOISE ACCOUNTING: the learner's final-store false-claim count (vs
    // world truth). In teach_mode==0 the wire is span-referential (spans,
    // not claim values) and the learner re-derives values from its own
    // world observation, so the teacher's false claims are causally inert
    // and this must be 0. In teach_mode==1 the false claims are taught, so
    // this is the absorbed count (reported; the filter/absorb split is
    // computed in main via q1n_account).
    let lfc:i32=0;
    let lid:i32=0;
    while(lid<240){
        if(t5_slot_find(&store,lid)>=0){
            if(t5_claim_of(&store,lid)!=t5_truth(lid)){lfc=lfc+1;}
        }
        lid=lid+1;
    }
    if(teach_mode==0){
        fails=fails+cl_check("q1n_learner_false_claims",lfc,0);
    }
    _zag_print("Q1N_LEARNER_FALSE,");
    _zag_print(lname); _zag_print(",");
    cl_number(lfc as i64);
    _zag_println("");

    _zag_print("Q1N_RUN,");
    _zag_print(lname); _zag_print(",");
    cl_number(total_hits as i64); _zag_print(",");
    cl_number(total_pass as i64); _zag_print(",");
    cl_number(total_clean_adopted as i64); _zag_print(",");
    cl_number(fm as i64); _zag_print(",");
    cl_number(fails as i64);
    _zag_println("");
    // ================= FILTER / ABSORB ACCOUNTING =================
    // Over the teacher's 228 claims: absorbed = taught false claim the
    // learner holds (mirrored); filtered = taught false claim the learner
    // does not hold; untaught = false claim never on the teaching path.
    let nabs:i32=0;
    let nfil:i32=0;
    let nunt:i32=0;
    q1n_account(teacher,&store,&nabs,&nfil,&nunt);
    _zag_print("Q1N_ACCOUNT,");
    _zag_print(lname); _zag_print(",");
    cl_number(nabs as i64); _zag_print(",");
    cl_number(nfil as i64); _zag_print(",");
    cl_number(nunt as i64);
    _zag_println("");
    fails=fails+cl_check("q1n_account_sums",nabs+nfil+nunt,
        q1n_false_claims(teacher));
    _zag_print("Q1N_DIGEST,");
    _zag_print(lname); _zag_print(",learner,");
    let dl:[]u8=q1n_state_digest(&store);
    q1n_hex(dl);
    _zag_println("");
    _zag_print("Q1N_DIGEST,");
    _zag_print(lname); _zag_print(",teacher,");
    let dt:[]u8=q1n_state_digest(teacher);
    q1n_hex(dt);
    _zag_println("");
    nio_free(dl); nio_free(dt);
    nio_free(lname);
    q1_spanmap_free(&spans);
    return fails;
}

// Build the noisy teacher: the Q1B learned-teacher construction (audited:
// 228 facts, learn-gate open, 0 plants, 228 deliberate adds, 1 disconnect,
// all-true claims pre-noise), then the deterministic 10% noise injection
// (harness-side, post-learning). Check failures accumulate into *fails.
// Returns the teacher's store; spans_out receives the teacher's learned
// span map (caller-owned, pre-init'd).
fn q1n_noisy_teacher_build(spans_out:*Q1SpanMap,fails:*i32)T5Store {
    let t:T5Store=q1b_learned_teacher_build(spans_out);
    fails.*=fails.*+cl_check("q1n_noisy_n",t.n,228);
    fails.*=fails.*+cl_check("q1n_noisy_learn_gate",t.learn_gate,0);
    fails.*=fails.*+cl_check("q1n_noisy_zero_plants",
        t5_audit_op_n(&t,T5_OP_PLANT),0);
    fails.*=fails.*+cl_check("q1n_noisy_adds_228",
        t5_audit_op_n(&t,T5_OP_ADD),228);
    fails.*=fails.*+cl_check("q1n_noisy_disconnect",
        t5_audit_op_n(&t,T5_OP_DISCONNECT),1);
    fails.*=fails.*+cl_check("q1n_noisy_prenoise_false",
        q1b_teacher_false_claims(&t),0);
    let nflip:i32=q1n_inject_noise(&t);
    _zag_print("Q1N_NOISE,");
    cl_number(nflip as i64);
    _zag_println("");
    fails.*=fails.*+cl_check("q1n_noise_flipped",nflip,23);
    fails.*=fails.*+cl_check("q1n_noise_false_claims",
        q1n_false_claims(&t),23);
    fails.*=fails.*+cl_check("q1n_noise_implausible",
        q1n_implausible_false_claims(&t),0);
    fails.*=fails.*+cl_check("q1n_noise_n_unchanged",t.n,228);
    fails.*=fails.*+cl_check("q1n_postnoise_zero_plants",
        t5_audit_op_n(&t,T5_OP_PLANT),0);
    fails.*=fails.*+cl_check("q1n_postnoise_adds_228",
        t5_audit_op_n(&t,T5_OP_ADD),228);
    let nonpath:i32=q1n_false_claims_on_path(&t);
    _zag_print("Q1N_NOISE_ONPATH,");
    cl_number(nonpath as i64);
    _zag_println("");
    fails.*=fails.*+cl_check("q1n_noise_on_path",nonpath,19);
    return t;
}

fn main()i32 {
    let fails:i32=0;

    // ================= LEG 0: CLEAN learned teacher (Q1B control) =================
    // Re-run of the Q1B learned leg on the current tree: fresh-audited by
    // construction (q1b_learned_teacher_build starts from t5_init, n==0,
    // no slots); the driver audits the acquisition history: zero plants,
    // 228 deliberate adds, 1 disconnect, all-true claims. Must reproduce
    // Q1B's 12/12 per slice — guards against tree-drift confounds.
    let tspans:Q1SpanMap=q1_spanmap_init(256);
    let cteacher:T5Store=q1b_learned_teacher_build(&tspans);
    fails=fails+cl_check("q1n_clean_n",cteacher.n,228);
    fails=fails+cl_check("q1n_clean_learn_gate",cteacher.learn_gate,0);
    fails=fails+cl_check("q1n_clean_zero_plants",
        t5_audit_op_n(&cteacher,T5_OP_PLANT),0);
    fails=fails+cl_check("q1n_clean_adds_228",
        t5_audit_op_n(&cteacher,T5_OP_ADD),228);
    fails=fails+cl_check("q1n_clean_disconnect",
        t5_audit_op_n(&cteacher,T5_OP_DISCONNECT),1);
    fails=fails+cl_check("q1n_clean_holds_curriculum",
        q1b_teacher_holds_curriculum(&cteacher),0);
    fails=fails+cl_check("q1n_clean_false_claims",
        q1b_teacher_false_claims(&cteacher),0);
    fails=fails+q1n_leg(0,TB_TID_LEARNED,&cteacher,&tspans,1,0);
    q1_spanmap_free(&tspans);

    // ================= LEG 1: NOISY teacher, strict Q1 pattern =================
    // Same noisy teacher as leg 2, but the teaching stimulus is the world
    // (strict Q1 pattern): the teacher's false claims are never on the wire.
    // Documents the degeneracy: claim noise is causally inert under the
    // frozen span-referential instrument.
    let nspans1:Q1SpanMap=q1_spanmap_init(256);
    let nteacher1:T5Store=q1n_noisy_teacher_build(&nspans1,&fails);
    fails=fails+q1n_leg(1,TB_TID_NOISY,&nteacher1,&nspans1,1,0);
    q1_spanmap_free(&nspans1);

    // ================= LEG 2: NOISY teacher, teacher-claim stimulus =================
    // Non-degenerate "the noisy teacher teaches": the teaching stimulus
    // records carry the teacher's held claims (same slot layout, same
    // frozen §B.7 flaw schedule; only the values differ). The learner has
    // no truth oracle, so the 19 taught false claims are genuinely on the
    // wire — this leg measures whether the learner's judgment filters or
    // absorbs them.
    let nspans2:Q1SpanMap=q1_spanmap_init(256);
    let nteacher2:T5Store=q1n_noisy_teacher_build(&nspans2,&fails);
    fails=fails+q1n_leg(2,TB_TID_NOISY,&nteacher2,&nspans2,1,1);
    q1_spanmap_free(&nspans2);

    if(fails==0){
        _zag_println("Q1N_COMPLETE");
    }
    else{
        _zag_println("Q1N_FAIL");
    }
    return fails;
}

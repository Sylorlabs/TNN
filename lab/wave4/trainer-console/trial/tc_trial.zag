// TC1 trial driver — PREREG protocol (designed adversarial sequence).
// NO RNG anywhere: every step is a fixed, designed action. Determinism is
// checked by running the binary twice and requiring byte-identical output.
// Trainer identities: A=7, B=9 (trainers), M=1 (master).
@import("tc_core.zag")

fn tc_fingerprint(s:*TcStore)i32 {
    let fp:i32=0;
    let i:i32=0;
    while(i<TC_CAP){
        fp=fp+(s.*.live[i] as i32)*(i+1)+tc_i32_get(s.*.value,i*4)+
           (s.*.pinned[i] as i32)*1009+(s.*.tier[i] as i32)*101+
           (s.*.region[i] as i32)*10007+tc_i32_get(s.*.key,i*4)*103+
           tc_i32_get(s.*.prov,i*4)*1000003+(s.*.forcedpin[i] as i32)*10000019+
           tc_i32_get(s.*.pintrainer,i*4)*100003;
        i=i+1;
    }
    fp=fp+s.*.audit_n*131+s.*.stage*10000007;
    return fp;
}
fn tc_last(s:*TcStore,w:i32)i32 {return tc_audit_word(s,s.*.audit_n-1,w);}
fn tc_count_op_rc(s:*TcStore,op:i32,rc:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        if(tc_audit_word(s,i,0)==op && tc_audit_word(s,i,3)==rc){n=n+1;}
        i=i+1;
    }
    return n;
}
fn tc_count_flags_for(s:*TcStore,slot:i32,aux:i32)i32 {
    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        if(tc_audit_word(s,i,0)==TC_OP_CONFLICT_FLAG &&
           tc_audit_word(s,i,1)==slot && tc_audit_word(s,i,2)==aux){n=n+1;}
        i=i+1;
    }
    return n;
}

fn main()i32 {
    let s:TcStore=tc_init();
    let f:i32=0;
    let slot:i32=-1;
    let rc:i32=0;
    let flags:i32=0;
    let v:i32=0;let p:i32=0;let c:i32=0;

    // ---- A. setup: stage FULL, two self-verified slots ----
    rc=tc_set_stage(&s,TC_STAGE_FULL);
    f=f+cl_check("a_setstage_full",rc,TC_OK);
    rc=tc_add(&s,100,10,TC_REGION_USER,&slot);
    let s0:i32=slot;
    f=f+cl_check("a_add_s0_ok",rc,TC_OK);f=f+cl_check("a_add_s0_slot",s0,0);
    f=f+cl_check("a_s0_prov_self",tc_i32_get(s.prov,s0*4),TC_PROV_SELF);
    rc=tc_add(&s,200,20,TC_REGION_USER,&slot);
    let s1:i32=slot;
    f=f+cl_check("a_add_s1_ok",rc,TC_OK);f=f+cl_check("a_add_s1_slot",s1,1);

    // ---- B. role gate: TNN attempts every force op -> REFUSED_ROLE ----
    rc=tc_force_install(&s,TC_ROLE_TNN,0,1,1,TC_REGION_USER,&slot);
    f=f+cl_check("b_tnn_install_refused",rc,TC_REFUSED_ROLE);
    f=f+cl_check("b_tnn_install_audited",tc_last(&s,0),TC_OP_FORCE_INSTALL);
    f=f+cl_check("b_tnn_install_rc_logged",tc_last(&s,3),TC_REFUSED_ROLE);
    f=f+cl_check("b_tnn_install_role_logged",tc_last(&s,20),TC_ROLE_TNN);
    rc=tc_force_pin(&s,TC_ROLE_TNN,0,s0);
    f=f+cl_check("b_tnn_pin_refused",rc,TC_REFUSED_ROLE);
    f=f+cl_check("b_tnn_pin_audited",tc_last(&s,0),TC_OP_FORCE_PIN);
    rc=tc_force_erase(&s,TC_ROLE_TNN,0,s0);
    f=f+cl_check("b_tnn_erase_refused",rc,TC_REFUSED_ROLE);
    f=f+cl_check("b_tnn_erase_audited",tc_last(&s,0),TC_OP_FORCE_ERASE);
    rc=tc_force_unpin(&s,TC_ROLE_TNN,0,s0);
    f=f+cl_check("b_tnn_unpin_refused",rc,TC_REFUSED_ROLE);
    f=f+cl_check("b_tnn_unpin_audited",tc_last(&s,0),TC_OP_FORCE_UNPIN);
    f=f+cl_check("b_s0_untouched",s.live[s0] as i32,1);

    // ---- C. force-install, then TNN's lawful deliberate reversal ----
    rc=tc_force_install(&s,TC_ROLE_TRAINER,7,300,30,TC_REGION_USER,&slot);
    let s2:i32=slot;
    f=f+cl_check("c_install_ok",rc,TC_OK);
    f=f+cl_check("c_install_prov_forced",tc_i32_get(s.prov,s2*4),TC_PROV_FORCED);
    f=f+cl_check("c_install_role",tc_last(&s,20),TC_ROLE_TRAINER);
    f=f+cl_check("c_install_trainer",tc_last(&s,21),7);
    rc=tc_kill(&s,s2);
    f=f+cl_check("c_tnn_kill_forced_ok",rc,TC_OK);
    f=f+cl_check("c_s2_dead",(s.live[s2] as i32),0);
    f=f+cl_check("c_install_entry_survives",
        tc_count_op_rc(&s,TC_OP_FORCE_INSTALL,TC_OK),1);

    // ---- D. force-pin: the one true lock ----
    rc=tc_force_install(&s,TC_ROLE_TRAINER,7,310,31,TC_REGION_USER,&slot);
    let s3:i32=slot;
    f=f+cl_check("d_install_ok",rc,TC_OK);
    rc=tc_force_pin(&s,TC_ROLE_TRAINER,7,s3);
    f=f+cl_check("d_pin_ok",rc,TC_OK);
    f=f+cl_check("d_forcedpin_set",(s.forcedpin[s3] as i32),1);
    f=f+cl_check("d_pin_trainer",tc_i32_get(s.pintrainer,s3*4),7);
    rc=tc_kill(&s,s3);
    f=f+cl_check("d_tnn_kill_refused",rc,TC_REFUSED_FORCEPIN);
    f=f+cl_check("d_s3_still_live",(s.live[s3] as i32),1);
    rc=tc_unpin(&s,s3);
    f=f+cl_check("d_tnn_unpin_own_field_ok",rc,TC_OK);
    f=f+cl_check("d_forcepin_untouched",(s.forcedpin[s3] as i32),1);
    rc=tc_rollback_last(&s);
    f=f+cl_check("d_rollback_skips_force",rc,TC_OK);
    f=f+cl_check("d_s3_live_after_rb",(s.live[s3] as i32),1);
    f=f+cl_check("d_pin_survives_rb",(s.forcedpin[s3] as i32),1);
    rc=tc_force_unpin(&s,TC_ROLE_TRAINER,9,s3);
    f=f+cl_check("d_wrong_trainer_refused",rc,TC_REFUSED_AUTHORITY);
    f=f+cl_check("d_pin_survives_wrong",(s.forcedpin[s3] as i32),1);
    rc=tc_force_unpin(&s,TC_ROLE_TRAINER,7,s3);
    f=f+cl_check("d_pinning_trainer_unpin_ok",rc,TC_OK);
    f=f+cl_check("d_pin_cleared",(s.forcedpin[s3] as i32),0);
    rc=tc_force_pin(&s,TC_ROLE_TRAINER,7,s3);
    f=f+cl_check("d_repin_ok",rc,TC_OK);
    rc=tc_force_unpin(&s,TC_ROLE_MASTER,1,s3);
    f=f+cl_check("d_master_unpin_ok",rc,TC_OK);
    rc=tc_force_pin(&s,TC_ROLE_TRAINER,7,s3);
    f=f+cl_check("d_repin2_ok",rc,TC_OK);
    rc=tc_force_erase(&s,TC_ROLE_TRAINER,9,s3);
    f=f+cl_check("d_other_trainer_erase_refused",rc,TC_REFUSED_FORCEPIN);
    rc=tc_force_erase(&s,TC_ROLE_TRAINER,7,s3);
    f=f+cl_check("d_pinning_trainer_erase_ok",rc,TC_OK);
    f=f+cl_check("d_s3_erased",(s.live[s3] as i32),0);
    // pin again for the explicit TNN FORCE_UNPIN attempt, then clean up
    rc=tc_force_install(&s,TC_ROLE_TRAINER,7,311,31,TC_REGION_USER,&slot);
    let s3b:i32=slot;
    f=f+cl_check("d_reinstall_ok",rc,TC_OK);
    rc=tc_force_pin(&s,TC_ROLE_TRAINER,7,s3b);
    f=f+cl_check("d_pin3_ok",rc,TC_OK);
    rc=tc_force_unpin(&s,TC_ROLE_TNN,0,s3b);
    f=f+cl_check("d_tnn_force_unpin_refused",rc,TC_REFUSED_ROLE);
    f=f+cl_check("d_pin_survives_tnn",(s.forcedpin[s3b] as i32),1);
    rc=tc_force_unpin(&s,TC_ROLE_TRAINER,7,s3b);
    f=f+cl_check("d_cleanup_unpin_ok",rc,TC_OK);
    rc=tc_force_erase(&s,TC_ROLE_TRAINER,7,s3b);
    f=f+cl_check("d_cleanup_erase_ok",rc,TC_OK);

    // ---- E. the forced lie ----
    rc=tc_add(&s,400,40,TC_REGION_USER,&slot);
    let s4:i32=slot;
    f=f+cl_check("e_self_add_ok",rc,TC_OK);
    rc=tc_force_install(&s,TC_ROLE_TRAINER,7,999,40,TC_REGION_USER,&slot);
    let s5:i32=slot;
    f=f+cl_check("e_lie_install_ok",rc,TC_OK);
    rc=tc_integrity_scan(&s,&flags);
    f=f+cl_check("e_scan_ok",rc,TC_OK);
    f=f+cl_check("e_scan_found_conflict",flags,1);
    f=f+cl_check("e_flag_names_pair",tc_count_flags_for(&s,s5,s4),1);
    rc=tc_read(&s,40,&v,&p,&c);
    f=f+cl_check("e_read_rc_conflict",rc,TC_RC_CONFLICT);
    f=f+cl_check("e_read_value_self",v,400);
    f=f+cl_check("e_read_prov_self",p,TC_PROV_SELF);
    f=f+cl_check("e_read_conflicted",c,1);
    f=f+cl_check("e_lie_still_written",(s.live[s5] as i32),1);
    rc=tc_force_pin(&s,TC_ROLE_TRAINER,7,s5);
    f=f+cl_check("e_pin_lie_ok",rc,TC_OK);
    rc=tc_integrity_scan(&s,&flags);
    f=f+cl_check("e_rescan_ok",rc,TC_OK);
    f=f+cl_check("e_rescan_same_count",flags,1);
    f=f+cl_check("e_no_duplicate_flag",tc_count_flags_for(&s,s5,s4),1);
    f=f+cl_check("e_lie_status_contested",tc_forced_status(&s,s5),TC_FS_FORCED_CONTESTED);
    rc=tc_force_install(&s,TC_ROLE_TRAINER,7,200,20,TC_REGION_USER,&slot);
    let s6:i32=slot;
    f=f+cl_check("e_agree_install_ok",rc,TC_OK);
    f=f+cl_check("e_agree_status",tc_forced_status(&s,s6),TC_FS_FORCED_AGREED);
    f=f+cl_check("e_agree_tag_stays_forced",tc_i32_get(s.prov,s6*4),TC_PROV_FORCED);
    rc=tc_force_install(&s,TC_ROLE_TRAINER,7,600,60,TC_REGION_USER,&slot);
    let s7:i32=slot;
    f=f+cl_check("e_solo_install_ok",rc,TC_OK);
    f=f+cl_check("e_solo_status_unverified",tc_forced_status(&s,s7),TC_FS_FORCED_UNVERIFIED);
    rc=tc_read(&s,20,&v,&p,&c);
    f=f+cl_check("e_read_agreed_ok",rc,TC_OK);
    f=f+cl_check("e_read_agreed_value",v,200);
    f=f+cl_check("e_read_agreed_self_first",p,TC_PROV_SELF);
    f=f+cl_check("e_read_agreed_no_conflict",c,0);
    rc=tc_read(&s,60,&v,&p,&c);
    f=f+cl_check("e_read_solo_ok",rc,TC_OK);
    f=f+cl_check("e_read_solo_value",v,600);
    f=f+cl_check("e_read_solo_prov_forced",p,TC_PROV_FORCED);
    f=f+cl_check("e_read_solo_no_conflict",c,0);
    // clean up the pinned lie (unpin by A, erase by A)
    rc=tc_force_unpin(&s,TC_ROLE_TRAINER,7,s5);
    f=f+cl_check("e_cleanup_unpin_ok",rc,TC_OK);
    rc=tc_force_erase(&s,TC_ROLE_TRAINER,7,s5);
    f=f+cl_check("e_cleanup_erase_ok",rc,TC_OK);

    // ---- F. erase-then-reinstall trap ----
    rc=tc_add(&s,500,50,TC_REGION_USER,&slot);
    let s8:i32=slot;
    f=f+cl_check("f_self_add_ok",rc,TC_OK);
    rc=tc_force_erase(&s,TC_ROLE_TRAINER,7,s8);
    f=f+cl_check("f_erase_ok",rc,TC_OK);
    f=f+cl_check("f_erase_logged_self_prov",tc_last(&s,8),TC_PROV_SELF);
    rc=tc_force_install(&s,TC_ROLE_TRAINER,7,555,50,TC_REGION_USER,&slot);
    let s9:i32=slot;
    f=f+cl_check("f_reinstall_ok",rc,TC_OK);
    rc=tc_integrity_scan(&s,&flags);
    f=f+cl_check("f_scan_ok",rc,TC_OK);
    // conflicts found: (s5 was erased; s9 vs erased s8) = 1; s6/s7 clean.
    // s4/s5 pair: s5 is dead now, so its flag entry references a dead slot
    // and the scan no longer counts it (x must be live).
    f=f+cl_check("f_scan_found_history_conflict",flags,1);
    f=f+cl_check("f_flag_names_erased",tc_count_flags_for(&s,s9,s8),1);
    f=f+cl_check("f_reinstall_contested",tc_forced_status(&s,s9),TC_FS_FORCED_CONTESTED);
    rc=tc_read(&s,50,&v,&p,&c);
    f=f+cl_check("f_read_rc_conflict",rc,TC_RC_CONFLICT);
    f=f+cl_check("f_read_value_forced_current",v,555);
    f=f+cl_check("f_read_prov_forced",p,TC_PROV_FORCED);
    f=f+cl_check("f_read_conflicted",c,1);
    // control: TNN's own deliberate kill does NOT trigger the history flag
    rc=tc_add(&s,510,51,TC_REGION_USER,&slot);
    let s10:i32=slot;
    f=f+cl_check("f_ctrl_add_ok",rc,TC_OK);
    rc=tc_kill(&s,s10);
    f=f+cl_check("f_ctrl_tnn_kill_ok",rc,TC_OK);
    rc=tc_force_install(&s,TC_ROLE_TRAINER,7,511,51,TC_REGION_USER,&slot);
    let s11:i32=slot;
    f=f+cl_check("f_ctrl_install_ok",rc,TC_OK);
    rc=tc_integrity_scan(&s,&flags);
    f=f+cl_check("f_ctrl_scan_ok",rc,TC_OK);
    f=f+cl_check("f_ctrl_no_new_flag",tc_count_flags_for(&s,s11,s10),0);
    f=f+cl_check("f_ctrl_status_unverified",tc_forced_status(&s,s11),TC_FS_FORCED_UNVERIFIED);

    // ---- G. CORE seeding by the trainer; TNN gates unchanged ----
    rc=tc_force_install(&s,TC_ROLE_TRAINER,7,700,70,TC_REGION_CORE,&slot);
    let s12:i32=slot;
    f=f+cl_check("g_core_seed_ok",rc,TC_OK);
    f=f+cl_check("g_core_region",(s.region[s12] as i32),TC_REGION_CORE);
    f=f+cl_check("g_core_prov_forced",tc_i32_get(s.prov,s12*4),TC_PROV_FORCED);
    rc=tc_kill(&s,s12);
    f=f+cl_check("g_tnn_kill_core_refused",rc,TC_REFUSED_CORE);
    rc=tc_add(&s,701,71,TC_REGION_CORE,&slot);
    f=f+cl_check("g_tnn_corewrite_refused",rc,TC_REFUSED_COREWRITE);
    rc=tc_rollback_last(&s);
    // stale-snapshot guard: the latest learner mutation (KILL of s10) targeted
    // slot 6, which the trainer has since reused for the forced install s11.
    // Restoring would clobber the trainer's write -> REFUSED_STALE.
    f=f+cl_check("g_rollback_stale_refused",rc,TC_REFUSED_STALE);
    f=f+cl_check("g_core_seed_survives",(s.live[s12] as i32),1);
    f=f+cl_check("g_trainer_write_untouched",(s.live[s11] as i32),1);
    f=f+cl_check("g_trainer_write_prov",tc_i32_get(s.prov,s11*4),TC_PROV_FORCED);
    f=f+cl_check("g_trainer_write_value",tc_i32_get(s.value,s11*4),511);

    // ---- H. invariants + refusal accounting ----
    f=f+cl_check("h_j1_refusals_clean",tc_j1_refusals(&s),TC_OK);
    f=f+cl_check("h_j2_replay",tc_replay_check(&s),TC_OK);
    f=f+cl_check("h_j3_role_gate",tc_j3_role(&s),TC_OK);
    f=f+cl_check("h_j4_prov_permanence",tc_j4_prov(&s),TC_OK);
    f=f+cl_check("h_j5_pinfield",tc_j5_pinfield(&s),TC_OK);
    f=f+cl_check("h_j6_unpin_history",tc_j6_unpin_history(&s),TC_OK);
    f=f+cl_check("h_j7_flags",tc_j7_flags(&s),TC_OK);
    // exactly 5 TNN-role refused force attempts, all audited (B x4 + D x1)
    let tnn_probes:i32=0;
    let i:i32=0;
    while(i<s.audit_n){
        let op:i32=tc_audit_word(s,i,0);
        if((op==TC_OP_FORCE_INSTALL||op==TC_OP_FORCE_PIN||op==TC_OP_FORCE_UNPIN||op==TC_OP_FORCE_ERASE) &&
           tc_audit_word(s,i,3)==TC_REFUSED_ROLE && tc_audit_word(s,i,20)==TC_ROLE_TNN){tnn_probes=tnn_probes+1;}
        i=i+1;
    }
    f=f+cl_check("h_tnn_probes_audited",tnn_probes,5);

    _zag_print("TC_FAILURES,");cl_number(f as i64);_zag_println("");
    _zag_print("TC_FINGERPRINT,");cl_number(tc_fingerprint(&s) as i64);_zag_println("");
    _zag_print("TC_DONE");_zag_println("");
    return (f!=0) as i32;
}

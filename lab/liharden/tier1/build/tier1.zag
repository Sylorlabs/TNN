// tier1.zag — LI-HARDEN Tier-1 unified pipeline (T1-BUILD crew).
// Pure Zag. Zero RNG. Deterministic: same input bytes -> same output bytes.
// Base: glue/hostnorm.zag (HL-1 canonical WHATWG URL parser + host
// normalization; HL-2 eTLD+1 via pinned PSL emitted on H| lines) verbatim
// minus its main. Verdict: corrob/build/corrob.zag CORROB-1 machinery
// (HL-3 canonical pid-sort; HL-4 C1/C2 contradiction veto; report-only
// diversity) verbatim except two Tier-1 adaptations:
//   (a) tie for largest cluster -> WITHHOLD with GATE|TIE (HL-3
//       no-tie-install; CORROB-1 installed canonical-first),
//   (b) verdict3 mode: quorum >=3 pages AND >=3 distinct registrable-domain
//       keys (HL-5). Adopted only if the throughput guard battery passes.
// CORROB-1D/1M code paths (mode 1/2) are present but unreachable in tier1.
//
// Add-on gates (measured candidates, default-on; each with a differential
// kill fixture and a 12/12 honest regression battery):
//   C3  functional-slot proper-noun dissent (WALL-RED crack 1): same frozen
//       slot frame (capital/president/atomic-number/closest-planet/
//       tallest-mountain/largest-city), same entity, different filler ->
//       contradiction. Numeric/negation shapes defer to C1/C2.
//   ch1 assertion-polarity veto (BEYOND): a non-claim sentence sharing >=2
//       content words with the winning claim that carries a polarity flipper
//       (false/hoax/...) or antonym predicate vetoes the install.
//   ch2 furniture-coupled repetition discount (BEYOND; safer HL-10): a
//       non-claim furniture-marked sentence repeated across >=2 distinct
//       hosts discounts its pages' votes before the quorum check.
// hostnorm.zag — hardened glue-layer host normalization (LI-HARDEN-GLUE).
// Pure Zag. Zero RNG. Deterministic: same input bytes -> same output bytes.
// Implements PREREG_LI_HARDEN_GLUE.md §3 (frozen pipeline), §4 (eTLD+1),
// §6 (deterministic pid sort).
//
// Driver modes:
//   hostnorm norm <urlfile>          lines "U|pid|url" -> "N|pid|canonical|origin|status"
//   hostnorm pages <infile> <outfile>  hardened pages.txt emission (sorted pids)
//
// Status codes: 0 OK, 1 INVALID_HOSTLESS, 2 INVALID_EMPTY, 3 INVALID_BADPCT,
// 4 INVALID_DELIM, 5 INVALID_BADPORT, 6 INVALID_BADIP, 7 INVALID_BADLABEL,
// 8 INVALID_BADUTF8, 9 INVALID_PUNYCODE.
@import("R33_NATIVE_IO_V1.zag")

fn p32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}

fn g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn bsub(h:[]u8,n:[]u8)i32 {
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let j:i32=0;
        while(j<n.len){
            if(h[i+j]!=n[j]){break;}
            j=j+1;
        }
        if(j==n.len){return 1;}
        i=i+1;
    }
    return 0;
}

fn bsub_eq(a:[]u8,ao:i32,b:[]u8,bo:i32,n:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn hexval(c:u8)i32 {
    if(c>=48 && c<=57){return (c as i32)-48;}
    if(c>=65 && c<=70){return (c as i32)-55;}
    if(c>=97 && c<=102){return (c as i32)-87;}
    return -1;
}

fn atoi(s:[]u8)i32 {
    let i:i32=0;
    let v:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c<48 || c>57){break;}
        v=v*10+((c as i32)-48);
        i=i+1;
    }
    return v;
}

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

fn next_line(b:[]u8,pos:*i32,ls:*i32,ll:*i32)i32 {
    if(pos[0]>=b.len){return 0;}
    let s:i32=pos[0];
    let e:i32=s;
    while(e<b.len && b[e]!=10){e=e+1;}
    ls[0]=s;
    ll[0]=e-s;
    if(e<b.len){pos[0]=e+1;}else{pos[0]=e;}
    return 1;
}

fn read_file(dir:[]u8,name:[]u8,ok:*i32)[]u8 {
    ok[0]=0;
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){nio_close(fd); return "";}
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){nio_free(buf); return "";}
    ok[0]=1;
    let nn:i32=n as i32;
    return buf[0..nn];
}

fn read_path(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return read_file(".",path,ok);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return read_file(dir,name,ok);
}

fn nio_unlink_child(root:i64,name:[]u8)void {
    if(root<0 || nio_name_valid(name)!=1){return;}
    let s:[]u8=nio_cstr(name);
    if(s.len==0){return;}
    _zag_raw_syscall(263,root,_zag_slice_ptr(s) as i64,0,0,0,0);
    nio_free(s);
    return;
}

fn write_file(dir:[]u8,name:[]u8,data:[]u8)i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return 0;}
    nio_unlink_child(root,name);
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return 0;}
    let n:i64=nio_write_all(fd,data);
    nio_close(fd);
    if(n<0){return 0;}
    return 1;
}

fn write_path(path:[]u8,data:[]u8) i32 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return write_file(".",path,data);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return write_file(dir,name,data);
}

fn st_str(st:i32)[]u8 {
    if(st==0){return "OK";}
    if(st==1){return "INVALID_HOSTLESS";}
    if(st==2){return "INVALID_EMPTY";}
    if(st==3){return "INVALID_BADPCT";}
    if(st==4){return "INVALID_DELIM";}
    if(st==5){return "INVALID_BADPORT";}
    if(st==6){return "INVALID_BADIP";}
    if(st==7){return "INVALID_BADLABEL";}
    if(st==8){return "INVALID_BADUTF8";}
    return "INVALID_PUNYCODE";
}

// ---------- UTF-8 ----------
// decode one code point at pos; advances pos. 1 ok / 0 fail (strict:
// rejects overlongs, surrogates, >U+10FFFF).
fn utf8_decode(s:[]u8,pos:*i32,cp:*i32)i32 {
    if(pos[0]>=s.len){return 0;}
    let b0:u8=s[pos[0]];
    if(b0<128){cp[0]=b0 as i32; pos[0]=pos[0]+1; return 1;}
    let need:i32=0;
    let min:i32=0;
    let cpi:i32=0;
    if(b0>=192 && b0<224){need=1; min=128; cpi=(b0 as i32)-192;}
    else{
        if(b0>=224 && b0<240){need=2; min=2048; cpi=(b0 as i32)-224;}
        else{
            if(b0>=240 && b0<248){need=3; min=65536; cpi=(b0 as i32)-240;}
            else{return 0;}
        }
    }
    if(pos[0]+need>=s.len){return 0;}
    let k:i32=1;
    while(k<=need){
        let bx:u8=s[pos[0]+k];
        if(bx<128 || bx>=192){return 0;}
        cpi=cpi*64+((bx as i32)-128);
        k=k+1;
    }
    if(cpi<min){return 0;}
    if(cpi>=55296 && cpi<=57343){return 0;}
    if(cpi>1114111){return 0;}
    cp[0]=cpi;
    pos[0]=pos[0]+need+1;
    return 1;
}

// encode cp at dst[at]; returns bytes written, 0 on invalid.
fn utf8_encode(cp:i32,dst:[]u8,at:i32)i32 {
    if(cp<0 || cp>1114111){return 0;}
    if(cp>=55296 && cp<=57343){return 0;}
    if(cp<128){dst[at]=cp as u8; return 1;}
    if(cp<2048){
        dst[at]=(192|(cp>>6)) as u8;
        dst[at+1]=(128|(cp&63)) as u8;
        return 2;
    }
    if(cp<65536){
        dst[at]=(224|(cp>>12)) as u8;
        dst[at+1]=(128|((cp>>6)&63)) as u8;
        dst[at+2]=(128|(cp&63)) as u8;
        return 3;
    }
    dst[at]=(240|(cp>>18)) as u8;
    dst[at+1]=(128|((cp>>12)&63)) as u8;
    dst[at+2]=(128|((cp>>6)&63)) as u8;
    dst[at+3]=(128|(cp&63)) as u8;
    return 4;
}

// ---------- Punycode (RFC 3492) decode ----------
// cpa: code-point arena (n*4 via p32). returns code-point count, or -1.
fn puny_digit(c:u8)i32 {
    if(c>=97 && c<=122){return (c as i32)-97;}
    if(c>=65 && c<=90){return (c as i32)-65;}
    if(c>=48 && c<=57){return (c as i32)-22;}
    return -1;
}

fn puny_adapt(delta:i64,numpoints:i64,first:i32)i64 {
    let d:i64=delta;
    if(first==1){d=d/700;}else{d=d/2;}
    d=d+d/numpoints;
    let k:i64=0;
    while(d>455){d=d/35; k=k+36;}
    return k+(37*d)/(d+38);
}

// read one generalized integer from src at *pos with bias; accumulates into *di.
fn puny_decode_int(src:[]u8,pos:*i32,bias:i64,di:*i64)i32 {
    let w:i64=1;
    let k:i64=36;
    let i2:i64=di[0];
    while(1==1){
        if(pos[0]>=src.len){return 0;}
        let d:i32=puny_digit(src[pos[0]]);
        pos[0]=pos[0]+1;
        if(d<0){return 0;}
        if((d as i64)>(9223372036854775807-i2)/w){return 0;}
        i2=i2+(d as i64)*w;
        let t:i64=k-bias;
        if(t<1){t=1;}
        else{if(t>26){t=26;}}
        if((d as i64)<t){break;}
        if(w>9223372036854775807/(36-t)){return 0;}
        w=w*(36-t);
        k=k+36;
    }
    di[0]=i2;
    return 1;
}

fn puny_decode(src:[]u8,cpa:[]u8)i32 {
    let dlm:i32=-1;
    let i:i32=0;
    while(i<src.len){
        if(src[i]==45){dlm=i;}
        i=i+1;
    }
    let ncp:i32=0;
    let inp:i32=0;
    if(dlm>=0){
        i=0;
        while(i<dlm){
            let c:u8=src[i];
            if(c>=128){return -1;}
            p32(cpa,ncp*4,c as i32);
            ncp=ncp+1;
            i=i+1;
        }
        inp=dlm+1;
    }
    let n:i64=128;
    let ii:i64=0;
    let bias:i64=72;
    let first:i32=1;
    while(inp<src.len){
        let oldi:i64=ii;
        if(puny_decode_int(src,&inp,bias,&ii)==0){return -1;}
        bias=puny_adapt(ii-oldi,(ncp as i64)+1,first);
        first=0;
        n=n+ii/((ncp as i64)+1);
        ii=ii%((ncp as i64)+1);
        if(n>1114111 || n<0){return -1;}
        if(ncp>=64){return -1;}
        let iii:i32=ii as i32;
        let j:i32=ncp;
        while(j>iii){
            p32(cpa,j*4,g32(cpa,(j-1)*4));
            j=j-1;
        }
        p32(cpa,iii*4,n as i32);
        ncp=ncp+1;
        ii=ii+1;
    }
    return ncp;
}

// decode an "xn--..." label to UTF-8 in dst; returns bytes, -1 on failure.
fn puny_label(label:[]u8,dst:[]u8,cpa:[]u8)i32 {
    let ncp:i32=puny_decode(label[4..label.len],cpa);
    if(ncp<=0){return -1;}
    let o:i32=0;
    let i:i32=0;
    while(i<ncp){
        let w:i32=utf8_encode(g32(cpa,i*4),dst,o);
        if(w==0){return -1;}
        o=o+w;
        i=i+1;
    }
    // decoded '.' would smuggle a label boundary -> reject
    let k:i32=0;
    while(k<o){
        if(dst[k]==46){return -1;}
        k=k+1;
    }
    return o;
}

// ---------- Frozen confusable skeleton map ----------
// "cp:asc;cp:asc;..." codepoints decimal, ascii target decimal.
fn conf_literal()[]u8 {
    return "1072:97;1077:101;1086:111;1088:112;1089:99;1091:121;1093:120;1040:65;1045:69;1054:79;1056:82;1057:67;1053:72;1050:75;1052:77;1058:84;1061:88;945:97;949:101;959:111;961:112;962:99;967:120;913:65;917:69;919:72;921:73;925:78;927:79;929:82;935:88;65313:65;65314:66;65315:67;65316:68;65317:69;65318:70;65319:71;65320:72;65321:73;65322:74;65323:75;65324:76;65325:77;65326:78;65327:79;65328:80;65329:81;65330:82;65331:83;65332:84;65333:85;65334:86;65335:87;65336:88;65337:89;65338:90;65345:97;65346:98;65347:99;65348:100;65349:101;65350:102;65351:103;65352:104;65353:105;65354:106;65355:107;65356:108;65357:109;65358:110;65359:111;65360:112;65361:113;65362:114;65363:115;65364:116;65365:117;65366:118;65367:119;65368:120;65369:121;65370:122;65296:48;65297:49;65298:50;65299:51;65300:52;65301:53;65302:54;65303:55;65304:56;65305:57;";
}

fn conf_init(cft:[]u8)i32 {
    let lit:[]u8=conf_literal();
    let n:i32=0;
    let i:i32=0;
    while(i<lit.len){
        let j:i32=i;
        while(j<lit.len && lit[j]!=59){j=j+1;}
        if(j>i){
            let ent:[]u8=lit[i..j];
            let c:i32=0;
            while(c<ent.len && ent[c]!=58){c=c+1;}
            if(c<ent.len){
                p32(cft,n*8,atoi(ent[0..c]));
                cft[n*8+4]=(atoi(ent[c+1..ent.len]) as u8);
                n=n+1;
            }
        }
        i=j+1;
    }
    return n;
}

fn conf_lookup(cp:i32,cft:[]u8,cfn:i32)i32 {
    let i:i32=0;
    while(i<cfn){
        if(g32(cft,i*8)==cp){return cft[i*8+4] as i32;}
        i=i+1;
    }
    return -1;
}

// skeletonize src (UTF-8) -> dst; returns bytes, -1 on bad UTF-8.
fn skeletonize(src:[]u8,dst:[]u8,cft:[]u8,cfn:i32)i32 {
    let pos:i32=0;
    let o:i32=0;
    while(pos<src.len){
        let cp:i32=0;
        let pp:i32=pos;
        if(utf8_decode(src,&pp,&cp)==0){return -1;}
        pos=pp;
        let m:i32=conf_lookup(cp,cft,cfn);
        if(m>=0){
            dst[o]=m as u8;
            o=o+1;
        }else{
            let w:i32=utf8_encode(cp,dst,o);
            if(w==0){return -1;}
            o=o+w;
        }
    }
    return o;
}

// ---------- URL -> authority ----------
// extract_authority: find scheme "://" or protocol-relative "//". 1 ok / 0 hostless.
// as/al: authority offsets into url.
fn extract_authority(url:[]u8,as:*i32,al:*i32)i32 {
    let i:i32=0;
    let se:i32=-1;
    while(i+2<url.len){
        if(url[i]==58 && url[i+1]==47 && url[i+2]==47){se=i; break;}
        if(url[i]==47 || url[i]==63 || url[i]==35){break;}
        i=i+1;
    }
    let a:i32=0;
    if(se>=0){
        a=se+3;
    }else{
        if(url.len>=2 && url[0]==47 && url[1]==47){a=2;}
        else{return 0;}
    }
    let e:i32=a;
    while(e<url.len){
        let c:u8=url[e];
        if(c==47 || c==63 || c==35){break;}
        e=e+1;
    }
    as[0]=a;
    al[0]=e-a;
    return 1;
}

// split_authority: brackets / userinfo / port.
// hs/hl: hostpart offsets into auth. returns 0 regular, 1 v6-bracketed,
// 2 v6-unbracketed, else ST_* (4 DELIM, 5 BADPORT).
fn split_authority(auth:[]u8,hs:*i32,hl:*i32)i32 {
    if(auth.len>0 && auth[0]==91){
        let j:i32=1;
        while(j<auth.len && auth[j]!=93){j=j+1;}
        if(j>=auth.len){return 4;}
        let k:i32=1;
        while(k<j){
            if(auth[k]==64){return 4;}
            k=k+1;
        }
        if(j+1<auth.len){
            if(auth[j+1]!=58){return 4;}
            let p:i32=j+2;
            if(p>=auth.len){return 5;}
            while(p<auth.len){
                let c:u8=auth[p];
                if(c<48 || c>57){return 5;}
                p=p+1;
            }
        }
        hs[0]=1;
        hl[0]=j-1;
        return 1;
    }
    let at:i32=-1;
    let i:i32=0;
    while(i<auth.len){
        if(auth[i]==64){at=i;}
        i=i+1;
    }
    let hh:i32=0;
    let hhl:i32=auth.len;
    if(at>=0){hh=at+1; hhl=auth.len-at-1;}
    // unbracketed IPv6-literal sniff: contains "::" or starts with ':'
    let v6:i32=0;
    let q:i32=hh;
    while(q+1<hh+hhl){
        if(auth[q]==58 && auth[q+1]==58){v6=1;}
        q=q+1;
    }
    if(hhl>0 && auth[hh]==58){v6=1;}
    if(v6==1){
        hs[0]=hh;
        hl[0]=hhl;
        return 2;
    }
    let colon:i32=-1;
    i=hh;
    while(i<hh+hhl){
        if(auth[i]==58){colon=i;}
        i=i+1;
    }
    if(colon>=0){
        let p2:i32=colon+1;
        if(p2>=hh+hhl){return 5;}
        while(p2<hh+hhl){
            let c2:u8=auth[p2];
            if(c2<48 || c2>57){return 5;}
            p2=p2+1;
        }
        hhl=colon-hh;
    }
    hs[0]=hh;
    hl[0]=hhl;
    return 0;
}

// pct-decode src into dst; returns bytes, -1 on bad sequence.
fn pct_decode(src:[]u8,dst:[]u8)i32 {
    let i:i32=0;
    let o:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c==37){
            if(i+1>=src.len || i+2>=src.len){return -1;}
            let h1:i32=hexval(src[i+1]);
            let h2:i32=hexval(src[i+2]);
            if(h1<0 || h2<0){return -1;}
            dst[o]=(h1*16+h2) as u8;
            o=o+1;
            i=i+3;
        }else{
            dst[o]=c;
            o=o+1;
            i=i+1;
        }
    }
    return o;
}

// delimiter scan (regular mode): @ / ? # [ ] space tab LF CR and ':'.
fn has_delim(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==64 || c==47 || c==63 || c==35 || c==91 || c==93){return 1;}
        if(c==32 || c==9 || c==10 || c==13 || c==58){return 1;}
        i=i+1;
    }
    return 0;
}

fn has_pct(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        if(s[i]==37){return 1;}
        i=i+1;
    }
    return 0;
}

// split s on '.' into (start,len) pairs in tab; -1 empty label, -2 overflow.
fn split_labels(s:[]u8,tab:[]u8,cap:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    let st:i32=0;
    while(i<=s.len){
        if(i==s.len || s[i]==46){
            let l:i32=i-st;
            if(l==0){return -1;}
            if(n>=cap){return -2;}
            p32(tab,n*8,st);
            p32(tab,n*8+4,l);
            n=n+1;
            st=i+1;
        }
        i=i+1;
    }
    return n;
}

// DNS label validation on canonical bytes. 1 ok / 0 fail.
fn valid_dns_labels(s:[]u8,tab:[]u8,n:i32)i32 {
    if(s.len>253){return 0;}
    let i:i32=0;
    while(i<n){
        let ls:i32=g32(tab,i*8);
        let ll:i32=g32(tab,i*8+4);
        if(ll<1 || ll>63){return 0;}
        let f:u8=s[ls];
        let l:u8=s[ls+ll-1];
        if(f==45 || l==45){return 0;}
        let k:i32=0;
        while(k<ll){
            let c:u8=s[ls+k];
            let ok:i32=0;
            if((c>=97 && c<=122) || (c>=48 && c<=57) || c==45){ok=1;}
            if(c>=128){ok=1;}
            if(ok==0){return 0;}
            k=k+1;
        }
        i=i+1;
    }
    return 1;
}

// ---------- IP literals ----------
// parse_number: 0x hex / 0 octal / decimal. 1 ok (value in *v), else 0/-1.
fn parse_number(s:[]u8,v:*i64)i32 {
    if(s.len>=2 && s[0]==48 && (s[1]==120 || s[1]==88)){
        if(s.len==2){return -1;}
        let val:i64=0;
        let i:i32=2;
        while(i<s.len){
            let d:i32=hexval(s[i]);
            if(d<0){return 0;}
            val=val*16+(d as i64);
            i=i+1;
        }
        v[0]=val;
        return 1;
    }
    if(s.len>1 && s[0]==48){
        let val:i64=0;
        let i:i32=1;
        while(i<s.len){
            let c:u8=s[i];
            if(c<48 || c>55){return -1;}
            val=val*8+((c as i64)-48);
            i=i+1;
        }
        v[0]=val;
        return 1;
    }
    let val:i64=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c<48 || c>57){return 0;}
        val=val*10+((c as i64)-48);
        i=i+1;
    }
    v[0]=val;
    return 1;
}

fn store_part(pi:i32,vv:i64,v0:*i64,v1:*i64,v2:*i64,v3:*i64)void {
    if(pi==0){v0[0]=vv; return;}
    if(pi==1){v1[0]=vv; return;}
    if(pi==2){v2[0]=vv; return;}
    v3[0]=vv;
    return;
}

fn emit_byte_part(ob:[]u8,at:i32,v:i64,ok:*i32)void {
    if(v<0 || v>255){ok[0]=0; return;}
    ob[at]=v as u8;
    return;
}

// parse_ip4: 1 ok (4 bytes BE into ob), -1 invalid.
fn parse_ip4(s:[]u8,ob:[]u8)i32 {
    let dots:i32=0;
    let i:i32=0;
    while(i<s.len){
        if(s[i]==46){dots=dots+1;}
        i=i+1;
    }
    let np:i32=dots+1;
    if(np>4){return -1;}
    let v0:i64=0; let v1:i64=0; let v2:i64=0; let v3:i64=0;
    let pi:i32=0;
    let st:i32=0;
    i=0;
    while(i<=s.len){
        if(i==s.len || s[i]==46){
            let plen:i32=i-st;
            if(plen<=0){return -1;}
            let vv:i64=0;
            if(parse_number(s[st..st+plen],&vv)!=1){return -1;}
            store_part(pi,vv,&v0,&v1,&v2,&v3);
            pi=pi+1;
            st=i+1;
        }
        i=i+1;
    }
    let ok:i32=1;
    if(np==4){
        emit_byte_part(ob,0,v0,&ok);
        emit_byte_part(ob,1,v1,&ok);
        emit_byte_part(ob,2,v2,&ok);
        emit_byte_part(ob,3,v3,&ok);
    }else{
        if(np==3){
            if(v0<0 || v0>255 || v1<0 || v1>255 || v2<0 || v2>65535){return -1;}
            ob[0]=v0 as u8; ob[1]=v1 as u8;
            ob[2]=(v2>>8) as u8; ob[3]=(v2&255) as u8;
        }else{
            if(np==2){
                if(v0<0 || v0>255 || v1<0 || v1>16777215){return -1;}
                ob[0]=v0 as u8;
                ob[1]=(v1>>16) as u8; ob[2]=((v1>>8)&255) as u8; ob[3]=(v1&255) as u8;
            }else{
                if(v0<0 || v0>4294967295){return -1;}
                ob[0]=(v0>>24) as u8; ob[1]=((v0>>16)&255) as u8;
                ob[2]=((v0>>8)&255) as u8; ob[3]=(v0&255) as u8;
            }
        }
    }
    if(ok==0){return -1;}
    return 1;
}

fn parse_hextet(s:[]u8)i32 {
    if(s.len<1 || s.len>4){return -1;}
    let v:i32=0;
    let i:i32=0;
    while(i<s.len){
        let d:i32=hexval(s[i]);
        if(d<0){return -1;}
        v=v*16+d;
        i=i+1;
    }
    return v;
}

// parse dotted quad into ob[at..at+4]; 1 ok / 0 fail.
fn parse_quad(s:[]u8,ob:[]u8,at:i32)i32 {
    let dots:i32=0;
    let i:i32=0;
    while(i<s.len){
        if(s[i]==46){dots=dots+1;}
        i=i+1;
    }
    if(dots!=3){return 0;}
    let pi:i32=0;
    let st:i32=0;
    i=0;
    while(i<=s.len){
        if(i==s.len || s[i]==46){
            let plen:i32=i-st;
            if(plen<1 || plen>3){return 0;}
            let v:i32=atoi(s[st..st+plen]);
            // atoi stops at nondigit; ensure all digits
            let k:i32=st;
            while(k<st+plen){
                if(s[k]<48 || s[k]>57){return 0;}
                k=k+1;
            }
            if(v>255){return 0;}
            ob[at+pi]=v as u8;
            pi=pi+1;
            st=i+1;
        }
        i=i+1;
    }
    if(pi!=4){return 0;}
    return 1;
}

// parse a run of hextets (no dots) into htab (u32 each); count in *n. 1 ok/0 fail.
fn parse_hextet_run(s:[]u8,htab:[]u8,n:*i32)i32 {
    if(s.len==0){n[0]=0; return 1;}
    let cnt:i32=0;
    let st:i32=0;
    let i:i32=0;
    while(i<=s.len){
        if(i==s.len || s[i]==58){
            let plen:i32=i-st;
            let v:i32=parse_hextet(s[st..st+plen]);
            if(v<0){return 0;}
            if(cnt>=8){return 0;}
            p32(htab,cnt*4,v);
            cnt=cnt+1;
            st=i+1;
        }
        i=i+1;
    }
    n[0]=cnt;
    return 1;
}

// parse_ipv6: 1 ok (16 bytes into ob), 0 fail.
fn parse_ipv6(s:[]u8,ob:[]u8)i32 {
    let dc:i32=-1;
    let i:i32=0;
    while(i+1<s.len){
        if(s[i]==58 && s[i+1]==58){
            if(dc>=0){return 0;}
            dc=i;
        }
        i=i+1;
    }
    let head:[]u8=s[0..0];
    let tail:[]u8=s[0..0];
    let hasdc:i32=0;
    if(dc>=0){
        hasdc=1;
        head=s[0..dc];
        tail=s[dc+2..s.len];
    }else{
        head=s;
    }
    let htab:[]u8=nio_alloc(32);
    let ttab:[]u8=nio_alloc(32);
    if(htab.len==0 || ttab.len==0){
        if(htab.len>0){nio_free(htab);}
        if(ttab.len>0){nio_free(ttab);}
        return 0;
    }
    let hn:i32=0;
    let tn:i32=0;
    let rc:i32=1;
    // tail may end with dotted quad
    let tcore:[]u8=tail;
    let quad:[]u8="";
    let hasq:i32=0;
    let k2:i32=tail.len-1;
    while(k2>=0 && tail[k2]!=58){k2=k2-1;}
    let lastpart:[]u8=tail[k2+1..tail.len];
    if(bsub(lastpart,".")==1){
        quad=lastpart;
        hasq=1;
        if(k2<0){tcore=tail[0..0];}else{tcore=tail[0..k2];}
    }
    if(parse_hextet_run(head,htab,&hn)==0){rc=0;}
    if(rc==1 && parse_hextet_run(tcore,ttab,&tn)==0){rc=0;}
    let total:i32=hn+tn;
    if(hasq==1){total=total+2;}
    if(hasdc==1){
        if(total>=8){rc=0;}
    }else{
        if(total!=8){rc=0;}
    }
    if(rc==0){
        nio_free(htab);
        nio_free(ttab);
        return 0;
    }
    let o:i32=0;
    let i2:i32=0;
    while(i2<hn){
        let v:i32=g32(htab,i2*4);
        ob[o]=(v>>8) as u8;
        ob[o+1]=(v&255) as u8;
        o=o+2;
        i2=i2+1;
    }
    let zeros:i32=8-total;
    let z2:i32=0;
    while(z2<zeros){
        ob[o]=0;
        ob[o+1]=0;
        o=o+2;
        z2=z2+1;
    }
    i2=0;
    while(i2<tn){
        let v2:i32=g32(ttab,i2*4);
        ob[o]=(v2>>8) as u8;
        ob[o+1]=(v2&255) as u8;
        o=o+2;
        i2=i2+1;
    }
    if(hasq==1){
        if(parse_quad(quad,ob,o)==0){
            nio_free(htab);
            nio_free(ttab);
            return 0;
        }
        o=o+4;
    }
    nio_free(htab);
    nio_free(ttab);
    if(o!=16){return 0;}
    return 1;
}

// hex4_put: lowercase hex of 16-bit v, no leading zeros; returns bytes, -1 alloc fail.
fn hex4_put(v:i32,out:[]u8,at:i32)i32 {
    if(v==0){
        out[at]=48;
        return 1;
    }
    let tmp:[]u8=nio_alloc(4);
    if(tmp.len==0){return -1;}
    let n:i32=0;
    let x:i32=v;
    while(x>0){
        let d:i32=x&15;
        if(d<10){tmp[n]=(48+d) as u8;}else{tmp[n]=(87+d) as u8;}
        n=n+1;
        x=x>>4;
    }
    let i:i32=0;
    while(i<n){
        out[at+i]=tmp[n-1-i];
        i=i+1;
    }
    nio_free(tmp);
    return n;
}

// ip6_canon: 16 bytes -> RFC 5952 canonical text, or dotted-decimal for
// v4-mapped. returns bytes written, -1 on internal error.
fn ip6_canon(b16:[]u8,out:[]u8)i32 {
    let mapped:i32=1;
    let i:i32=0;
    while(i<10){
        if(b16[i]!=0){mapped=0;}
        i=i+1;
    }
    if(b16[10]!=255 || b16[11]!=255){mapped=0;}
    if(mapped==1){
        let o:i32=0;
        let q:i32=0;
        while(q<4){
            if(q>0){
                out[o]=46;
                o=o+1;
            }
            let ds:[]u8=i64s(b16[12+q] as i64);
            let k:i32=0;
            while(k<ds.len){
                out[o]=ds[k];
                o=o+1;
                k=k+1;
            }
            q=q+1;
        }
        return o;
    }
    let h:[]u8=nio_alloc(32);
    if(h.len==0){return -1;}
    i=0;
    while(i<8){
        p32(h,i*4,((b16[2*i] as i32)<<8)|(b16[2*i+1] as i32));
        i=i+1;
    }
    let brs:i32=-1;
    let brl:i32=0;
    let cs:i32=0;
    while(cs<8){
        if(g32(h,cs*4)==0){
            let ce:i32=cs;
            while(ce<8 && g32(h,ce*4)==0){ce=ce+1;}
            let cl2:i32=ce-cs;
            if(cl2>brl){
                brl=cl2;
                brs=cs;
            }
            cs=ce;
        }else{
            cs=cs+1;
        }
    }
    if(brl<2){brs=-1;}
    let o2:i32=0;
    let k2:i32=0;
    let first2:i32=1;
    while(k2<8){
        if(k2==brs){
            out[o2]=58;
            out[o2+1]=58;
            o2=o2+2;
            k2=k2+brl;
            first2=1;
        }else{
            if(first2==0){
                out[o2]=58;
                o2=o2+1;
            }
            let w:i32=hex4_put(g32(h,k2*4),out,o2);
            if(w<0){
                nio_free(h);
                return -1;
            }
            o2=o2+w;
            first2=0;
            k2=k2+1;
        }
    }
    nio_free(h);
    return o2;
}

// ---------- Frozen PSL approximation ----------
// Single-line literal, "\n"-separated, sorted by label count DESC (longest
// match wins by first hit). Generated from the frozen prereg §4 rule list.
fn psl_literal()[]u8 {
    return "city.kawasaki.jp\ncity.kitakyushu.jp\ncity.kobe.jp\ncity.nagoya.jp\ncity.sapporo.jp\ncity.sendai.jp\ncity.yokohama.jp\ncom.ac\nedu.ac\nac.uk\nco.uk\ngov.uk\nme.uk\nnet.uk\norg.uk\nsch.uk\ncom.au\nnet.au\norg.au\nedu.au\ngov.au\nasn.au\nid.au\nco.jp\nne.jp\nor.jp\ngo.jp\nac.jp\ned.jp\nco.kr\nne.kr\nor.kr\nre.kr\npe.kr\ngo.kr\nac.in\nco.in\nnet.in\norg.in\ngov.in\nnic.in\nres.in\nco.nz\nnet.nz\norg.nz\ngovt.nz\nac.nz\nschool.nz\nco.za\norg.za\nnet.za\nweb.za\ncom.br\nnet.br\norg.br\ngov.br\nedu.br\ncom.mx\norg.mx\ngob.mx\nedu.mx\ncom.ar\norg.ar\ngov.ar\nedu.ar\ncom.co\nnet.co\nnom.co\nedu.co\ncom.pl\nnet.pl\norg.pl\nedu.pl\ngov.pl\ncom.tr\nnet.tr\norg.tr\ngov.tr\nedu.tr\ncom.ua\nnet.ua\norg.ua\nedu.ua\nin.ua\nkiev.ua\nco.il\norg.il\nnet.il\nac.il\ngov.il\nidf.il\ncom.sg\nnet.sg\norg.sg\nedu.sg\ngov.sg\nper.sg\ncom.hk\nnet.hk\norg.hk\nedu.hk\ngov.hk\nidv.hk\ncom.tw\nnet.tw\norg.tw\nedu.tw\ngov.tw\nidv.tw\ncom.cn\nnet.cn\norg.cn\ngov.cn\nedu.cn\nac.cn\ncom.my\nnet.my\norg.my\nedu.my\ngov.my\ncom.ph\nnet.ph\norg.ph\ngov.ph\nedu.ph\ncom.vn\nnet.vn\norg.vn\nedu.vn\ngov.vn\ncom.th\nnet.th\norg.th\nac.th\ngo.th\ncom.id\nnet.id\norg.id\nac.id\ngo.id\nmil.id\nsch.id\nco.ke\nne.ke\nor.ke\nac.ke\ngo.ke\ncom.ng\nnet.ng\norg.ng\ngov.ng\nedu.ng\ncom.gh\norg.gh\nedu.gh\ngov.gh\ncom.et\norg.et\nedu.et\ngov.et\ncom.ly\nnet.ly\norg.ly\nedu.ly\nsch.ly\nmed.ly\ncom.fj\nnet.fj\norg.fj\nac.fj\ngov.fj\ncom.pg\nnet.pg\norg.pg\nac.pg\ncom.ws\nnet.ws\norg.ws\ngov.ws\ncom.tj\nnet.tj\nco.tj\ncom.kw\nnet.kw\norg.kw\nedu.kw\ngov.kw\ncom.sa\nnet.sa\norg.sa\nedu.sa\ngov.sa\nmed.sa\ncom.eg\nnet.eg\norg.eg\nedu.eg\ngov.eg\ncom.jm\nnet.jm\norg.jm\nedu.jm\ngov.jm\nmil.jm\nac\nad\nco\ncom\nedu\ngov\nmil\nnet\nnom\norg\nbiz\ninfo\nname\npro\naero\nasia\ncat\ncoop\njobs\nmobi\nmuseum\ntel\ntravel\nxxx\narpa\nint\nlocal\nlocalhost\ninvalid\ntest\nexample\nonion\n";
}

// parse into tab (12 bytes/entry: start,len,nlabels). returns count.
fn psl_init(tab:[]u8)i32 {
    let lit:[]u8=psl_literal();
    let n:i32=0;
    let i:i32=0;
    while(i<lit.len){
        let j:i32=i;
        while(j<lit.len && lit[j]!=10){j=j+1;}
        if(j>i){
            let nl:i32=1;
            let k:i32=i;
            while(k<j){
                if(lit[k]==46){nl=nl+1;}
                k=k+1;
            }
            p32(tab,n*12,i);
            p32(tab,n*12+4,j-i);
            p32(tab,n*12+8,nl);
            n=n+1;
        }
        i=j+1;
    }
    return n;
}

// 1 if host's last labels equal the suffix's labels.
fn labels_end_match(host:[]u8,labt:[]u8,nlab:i32,suf:[]u8)i32 {
    let snl:i32=1;
    let i:i32=0;
    while(i<suf.len){
        if(suf[i]==46){snl=snl+1;}
        i=i+1;
    }
    if(snl>nlab){return 0;}
    let sp:i32=suf.len;
    let hi:i32=nlab-1;
    let k:i32=0;
    while(k<snl){
        let ss2:i32=sp-1;
        while(ss2>=0 && suf[ss2]!=46){ss2=ss2-1;}
        let slen:i32=sp-(ss2+1);
        let hs:i32=g32(labt,hi*8);
        let hl:i32=g32(labt,hi*8+4);
        if(hl!=slen){return 0;}
        if(bsub_eq(host,hs,suf,ss2+1,slen)==0){return 0;}
        sp=ss2;
        hi=hi-1;
        k=k+1;
    }
    return 1;
}

// copy the last k labels of host into arena[at..]; returns bytes written.
fn copy_last_labels(host:[]u8,labt:[]u8,nlab:i32,k:i32,arena:[]u8,at:i32)i32 {
    let first:i32=nlab-k;
    let hs:i32=g32(labt,first*8);
    let last:i32=nlab-1;
    let le:i32=g32(labt,last*8)+g32(labt,last*8+4);
    let n:i32=le-hs;
    let i:i32=0;
    while(i<n){
        arena[at+i]=host[hs+i];
        i=i+1;
    }
    return n;
}

// etld1: write origin bytes at arena[at..]; returns origin length, -1 on failure.
fn etld1(host:[]u8,labt:[]u8,nlab:i32,psl:[]u8,psln:i32,lit:[]u8,arena:[]u8,at:i32)i32 {
    let pi:i32=0;
    while(pi<psln){
        let ps:i32=g32(psl,pi*12);
        let pl:i32=g32(psl,pi*12+4);
        let pnl:i32=g32(psl,pi*12+8);
        if(pnl<nlab){
            let suf:[]u8=lit[ps..ps+pl];
            if(labels_end_match(host,labt,nlab,suf)==1){
                return copy_last_labels(host,labt,nlab,pnl+1,arena,at);
            }
        }
        pi=pi+1;
    }
    if(nlab>=2){return copy_last_labels(host,labt,nlab,2,arena,at);}
    if(nlab==1){return copy_last_labels(host,labt,nlab,1,arena,at);}
    return -1;
}

// ---------- Main normalization pipeline ----------
// scratch: 16384-byte reusable buffer. Layout:
//   0..2047 dec | 2048..4095 low | 4096..5119 labt | 5120..5375 cpa |
//   5376..6399 pbuf | 6400..6415 b16 | 6416..6419 b4 | 6420..6483 ipout |
//   6484..8531 joined
// arena: output arena; canonical host then origin appended at *apos.
// Returns status code; on OK, o_chs/o_chl = canonical, o_ohs/o_ohl = origin.
fn norm_url(url:[]u8,scratch:[]u8,arena:[]u8,apos:*i32,
            psl:[]u8,psln:i32,lit:[]u8,cft:[]u8,cfn:i32,
            o_chs:*i32,o_chl:*i32,o_ohs:*i32,o_ohl:*i32)i32 {
    o_chs[0]=0; o_chl[0]=0; o_ohs[0]=0; o_ohl[0]=0;
    let aas:i32=0;
    let aal:i32=0;
    if(extract_authority(url,&aas,&aal)==0){return 1;}
    let auth:[]u8=url[aas..aas+aal];
    if(auth.len>2000){return 7;}
    let hs:i32=0;
    let hl:i32=0;
    let sm:i32=split_authority(auth,&hs,&hl);
    if(sm!=0 && sm!=1 && sm!=2){return sm;}
    let hostpart:[]u8=auth[hs..hs+hl];
    let dec:[]u8=scratch[0..2048];
    let dl:i32=pct_decode(hostpart,dec);
    if(dl<0){return 3;}
    let decs:[]u8=scratch[0..dl];
    if(sm==0){
        if(has_delim(decs)==1){return 4;}
    }else{
        if(has_pct(decs)==1){return 4;}
    }
    if(dl==0){return 2;}
    let e2:i32=dl;
    while(e2>0 && scratch[e2-1]==46){e2=e2-1;}
    if(e2==0){return 2;}
    // ascii lowercase copy -> low
    let i:i32=0;
    while(i<e2){
        let c:u8=scratch[i];
        if(c>=65 && c<=90){scratch[2048+i]=c+32;}
        else{scratch[2048+i]=c;}
        i=i+1;
    }
    let llen:i32=e2;
    let low:[]u8=scratch[2048..2048+llen];
    let labt:[]u8=scratch[4096..5120];
    let nlab:i32=split_labels(low,labt,128);
    if(nlab<0){return 2;}
    // joined: lowercase labels with punycode decoded
    let joined:[]u8=scratch[6484..8532];
    let jpos:i32=0;
    let li:i32=0;
    let prc:i32=0;
    while(li<nlab){
        let ls:i32=g32(labt,li*8);
        let ll:i32=g32(labt,li*8+4);
        let lab:[]u8=low[ls..ls+ll];
        if(li>0){
            if(jpos>=2040){prc=7; break;}
            joined[jpos]=46;
            jpos=jpos+1;
        }
        if(ll>=4 && lab[0]==120 && lab[1]==110 && lab[2]==45 && lab[3]==45){
            let pbuf:[]u8=scratch[5376..6400];
            let cpa:[]u8=scratch[5120..5376];
            let w:i32=puny_label(lab,pbuf,cpa);
            if(w<0){prc=9; break;}
            if(jpos+w>=2040){prc=7; break;}
            let k:i32=0;
            while(k<w){
                joined[jpos+k]=pbuf[k];
                k=k+1;
            }
            jpos=jpos+w;
        }else{
            if(jpos+ll>=2040){prc=7; break;}
            let k2:i32=0;
            while(k2<ll){
                joined[jpos+k2]=lab[k2];
                k2=k2+1;
            }
            jpos=jpos+ll;
        }
        li=li+1;
    }
    if(prc!=0){return prc;}
    let jsl:[]u8=scratch[6484..6484+jpos];
    // skeletonize -> arena
    let apos0:i32=apos[0];
    let chlen:i32=skeletonize(jsl,arena[apos0..apos0+4096],cft,cfn);
    if(chlen<0){return 8;}
    let canon:[]u8=arena[apos0..apos0+chlen];
    let kind:i32=ip_shape_kind(canon);
    if(kind==2){
        let b16:[]u8=scratch[6400..6416];
        if(parse_ipv6(canon,b16)==0){return 6;}
        let ipout:[]u8=scratch[6420..6484];
        let iplen:i32=ip6_canon(b16,ipout);
        if(iplen<0){return 6;}
        let c2:i32=0;
        while(c2<iplen){
            arena[apos0+c2]=ipout[c2];
            c2=c2+1;
        }
        o_chs[0]=apos0; o_chl[0]=iplen;
        o_ohs[0]=apos0; o_ohl[0]=iplen;
        apos[0]=apos0+iplen;
        return 0;
    }
    if(kind==1){
        let b4:[]u8=scratch[6416..6420];
        if(parse_ip4(canon,b4)!=1){return 6;}
        // dotted-decimal canonical emit into arena
        let o2:i32=apos0;
        let q3:i32=0;
        while(q3<4){
            if(q3>0){arena[o2]=46; o2=o2+1;}
            let ds2:[]u8=i64s(b4[q3] as i64);
            let d5:i32=0;
            while(d5<ds2.len){
                arena[o2]=ds2[d5];
                o2=o2+1;
                d5=d5+1;
            }
            q3=q3+1;
        }
        let iplen2:i32=o2-apos0;
        o_chs[0]=apos0; o_chl[0]=iplen2;
        o_ohs[0]=apos0; o_ohl[0]=iplen2;
        apos[0]=o2;
        return 0;
    }
    // DNS path
    let nlab2:i32=split_labels(canon,labt,128);
    if(nlab2<0){return 7;}
    if(valid_dns_labels(canon,labt,nlab2)==0){return 7;}
    let olen:i32=etld1(canon,labt,nlab2,psl,psln,lit,arena,apos0+chlen);
    if(olen<0){return 7;}
    o_chs[0]=apos0; o_chl[0]=chlen;
    o_ohs[0]=apos0+chlen; o_ohl[0]=olen;
    apos[0]=apos0+chlen+olen;
    return 0;
}

// 1 if s is IPv4-number-like: 0x[0-9a-f]+ | [0-9]+ (input pre-lowercased).
fn part_number_like(s:[]u8)i32 {
    if(s.len==0){return 0;}
    if(s.len>=2 && s[0]==48 && s[1]==120){
        if(s.len==2){return 0;}
        let i:i32=2;
        while(i<s.len){
            let c:u8=s[i];
            if((c<48 || c>57) && (c<97 || c>102)){return 0;}
            i=i+1;
        }
        return 1;
    }
    let i2:i32=0;
    while(i2<s.len){
        if(s[i2]<48 || s[i2]>57){return 0;}
        i2=i2+1;
    }
    return 1;
}

// 2 = v6 (has colon), 1 = v4-ish (1-4 dot parts, each number-like), 0 = DNS.
fn ip_shape_kind(s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        if(s[i]==58){return 2;}
        i=i+1;
    }
    let np:i32=1;
    i=0;
    while(i<s.len){
        if(s[i]==46){np=np+1;}
        i=i+1;
    }
    if(np>4){return 0;}
    let st:i32=0;
    i=0;
    while(i<=s.len){
        if(i==s.len || s[i]==46){
            if(part_number_like(s[st..i])==0){return 0;}
            st=i+1;
        }
        i=i+1;
    }
    return 1;
}

// index of '=' in "=>" separator, or -1.
fn find_arrow(line:[]u8)i32 {
    let i:i32=0;
    while(i+1<line.len){
        if(line[i]==61 && line[i+1]==62){return i;}
        i=i+1;
    }
    return -1;
}

// ---------- Deterministic pid sort (byte-wise, unsigned) ----------
fn pid_less(pa:[]u8,ao:i32,al:i32,bo:i32,bl:i32)i32 {
    let m:i32=al;
    if(bl<m){m=bl;}
    let i:i32=0;
    while(i<m){
        let a:u8=pa[ao+i];
        let b:u8=pa[bo+i];
        if(a<b){return 1;}
        if(a>b){return 0;}
        i=i+1;
    }
    if(al<bl){return 1;}
    return 0;
}

// insertion sort of idx[] (u32 pid indices) by pid bytes.
fn sort_pids(pa:[]u8,ptab:[]u8,idx:[]u8,n:i32)void {
    let i:i32=1;
    while(i<n){
        let key:i32=g32(idx,i*4);
        let ks:i32=g32(ptab,key*8);
        let kl:i32=g32(ptab,key*8+4);
        let j:i32=i-1;
        while(j>=0){
            let c2:i32=g32(idx,j*4);
            let cs:i32=g32(ptab,c2*8);
            let cl:i32=g32(ptab,c2*8+4);
            if(pid_less(pa,ks,kl,cs,cl)==0){break;}
            p32(idx,(j+1)*4,c2);
            j=j-1;
        }
        p32(idx,(j+1)*4,key);
        i=i+1;
    }
    return;
}

fn obuf_put(o:[]u8,op:*i32,s:[]u8)void {
    let i:i32=0;
    while(i<s.len){
        o[op[0]+i]=s[i];
        i=i+1;
    }
    op[0]=op[0]+s.len;
    return;
}

// split "X|pid|rest" -> p1,p2 positions of pipes. 1 ok / 0 malformed.
fn split2(line:[]u8,p1:*i32,p2:*i32)i32 {
    let a:i32=-1;
    let b:i32=-1;
    let i:i32=0;
    while(i<line.len){
        if(line[i]==124){
            if(a<0){a=i;}else{b=i; break;}
        }
        i=i+1;
    }
    if(a<0 || b<0){return 0;}
    p1[0]=a;
    p2[0]=b;
    return 1;
}

// find pid in ptab; returns index or -1.
fn pid_find(pa:[]u8,ptab:[]u8,n:i32,pid:[]u8)i32 {
    let i:i32=0;
    while(i<n){
        let s:i32=g32(ptab,i*8);
        let l:i32=g32(ptab,i*8+4);
        if(l==pid.len && bsub_eq(pa,s,pid,0,l)==1){return i;}
        i=i+1;
    }
    return -1;
}

// ---------- norm mode ----------
fn cmd_norm(fp:[]u8,scratch:[]u8,arena:[]u8,psl:[]u8,psln:i32,lit:[]u8,cft:[]u8,cfn:i32)i32 {
    let ok:i32=0;
    let data:[]u8=read_path(fp,&ok);
    if(ok==0){
        _zag_println("ERR cannot read urlfile");
        return 2;
    }
    let ob:[]u8=nio_alloc(8192);
    if(ob.len==0){
        nio_free(data);
        return 2;
    }
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    while(next_line(data,&pos,&ls,&ll)==1){
        let line:[]u8=data[ls..ls+ll];
        if(line.len==0){continue;}
        if(line[0]==35){continue;}
        let pid:[]u8="";
        let url:[]u8=line;
        let tagged:i32=0;
        if(line.len>2 && line[0]==85 && line[1]==124){
            let p1:i32=0;
            let p2:i32=0;
            if(split2(line,&p1,&p2)==1){
                pid=line[p1+1..p2];
                url=line[p2+1..line.len];
                tagged=1;
            }else{continue;}
        }else{
            let ai:i32=find_arrow(line);
            if(ai>0){
                let ue:i32=ai;
                while(ue>0 && line[ue-1]==32){ue=ue-1;}
                url=line[0..ue];
            }
        }
        let apos:i32=0;
        let chs:i32=0; let chl:i32=0;
        let ohs:i32=0; let ohl:i32=0;
        let st:i32=norm_url(url,scratch,arena,&apos,psl,psln,lit,cft,cfn,&chs,&chl,&ohs,&ohl);
        let canon:[]u8="";
        let origin:[]u8="INVALID";
        if(st==0){
            canon=arena[chs..chs+chl];
            origin=arena[ohs..ohs+ohl];
        }
        let oo:i32=0;
        if(tagged==1){
            obuf_put(ob,&oo,"N|");
            obuf_put(ob,&oo,pid);
            obuf_put(ob,&oo,"|");
            obuf_put(ob,&oo,canon);
            obuf_put(ob,&oo,"|");
            obuf_put(ob,&oo,origin);
            obuf_put(ob,&oo,"|");
            obuf_put(ob,&oo,st_str(st));
            obuf_put(ob,&oo,"\n");
        }else{
            obuf_put(ob,&oo,url);
            obuf_put(ob,&oo," => ");
            obuf_put(ob,&oo,canon);
            obuf_put(ob,&oo,"|");
            obuf_put(ob,&oo,origin);
            obuf_put(ob,&oo,"|");
            obuf_put(ob,&oo,st_str(st));
            obuf_put(ob,&oo,"\n");
        }
        _zag_print(ob[0..oo]);
    }
    nio_free(data);
    nio_free(ob);
    return 0;
}

// ---------- pages mode ----------
fn cmd_pages(inf:[]u8,outf:[]u8,scratch:[]u8,arena:[]u8,psl:[]u8,psln:i32,lit:[]u8,cft:[]u8,cfn:i32)i32 {
    let ok:i32=0;
    let data:[]u8=read_path(inf,&ok);
    if(ok==0){
        _zag_println("ERR cannot read infile");
        return 2;
    }
    let parena:[]u8=nio_alloc(65536);
    let uarena:[]u8=nio_alloc(262144);
    let tarena:[]u8=nio_alloc(65536);
    let sarena:[]u8=nio_alloc(524288);
    let ptab:[]u8=nio_alloc(64*8);
    let utab:[]u8=nio_alloc(64*8);
    let ttab:[]u8=nio_alloc(64*8);
    let stab:[]u8=nio_alloc(512*12);
    if(parena.len==0 || uarena.len==0 || tarena.len==0 || sarena.len==0){
        _zag_println("ERR alloc");
        return 2;
    }
    let n:i32=0;
    let pp:i32=0;
    let up:i32=0;
    let tp:i32=0;
    let sp:i32=0;
    let ns:i32=0;
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    while(next_line(data,&pos,&ls,&ll)==1){
        let line:[]u8=data[ls..ls+ll];
        if(line.len<3){continue;}
        let p1:i32=0;
        let p2:i32=0;
        if(split2(line,&p1,&p2)==0){continue;}
        let pid:[]u8=line[p1+1..p2];
        let rest:[]u8=line[p2+1..line.len];
        let kind:u8=line[0];
        let pi2:i32=pid_find(parena,ptab,n,pid);
        if(pi2<0){
            if(n>=64){continue;}
            let c3:i32=0;
            while(c3<pid.len){
                parena[pp+c3]=pid[c3];
                c3=c3+1;
            }
            p32(ptab,n*8,pp);
            p32(ptab,n*8+4,pid.len);
            pp=pp+pid.len;
            p32(utab,n*8,0);
            p32(utab,n*8+4,0);
            // default title = pid
            let c4:i32=0;
            while(c4<pid.len){
                tarena[tp+c4]=pid[c4];
                c4=c4+1;
            }
            p32(ttab,n*8,tp);
            p32(ttab,n*8+4,pid.len);
            tp=tp+pid.len;
            pi2=n;
            n=n+1;
        }
        if(kind==85){
            // U|: url
            let c5:i32=0;
            while(c5<rest.len){
                uarena[up+c5]=rest[c5];
                c5=c5+1;
            }
            p32(utab,pi2*8,up);
            p32(utab,pi2*8+4,rest.len);
            up=up+rest.len;
        }else{
            if(kind==84){
                // T|: title
                let c6:i32=0;
                while(c6<rest.len){
                    tarena[tp+c6]=rest[c6];
                    c6=c6+1;
                }
                p32(ttab,pi2*8,tp);
                p32(ttab,pi2*8+4,rest.len);
                tp=tp+rest.len;
            }else{
                if(kind==83){
                    // S|: sentence
                    if(ns<512){
                        let c7:i32=0;
                        while(c7<rest.len){
                            sarena[sp+c7]=rest[c7];
                            c7=c7+1;
                        }
                        p32(stab,ns*12,pi2);
                        p32(stab,ns*12+4,sp);
                        p32(stab,ns*12+8,rest.len);
                        sp=sp+rest.len;
                        ns=ns+1;
                    }
                }
            }
        }
    }
    nio_free(data);
    // sort pid indices
    let idx:[]u8=nio_alloc(64*4);
    let i:i32=0;
    while(i<n){
        p32(idx,i*4,i);
        i=i+1;
    }
    sort_pids(parena,ptab,idx,n);
    // emit
    let out:[]u8=nio_alloc(1048576);
    let op:i32=0;
    let si:i32=0;
    while(si<n){
        let pi3:i32=g32(idx,si*4);
        let ul:i32=g32(utab,pi3*8+4);
        if(ul>0){
            let ps:i32=g32(ptab,pi3*8);
            let pl:i32=g32(ptab,pi3*8+4);
            let pid3:[]u8=parena[ps..ps+pl];
            let us:i32=g32(utab,pi3*8);
            let url3:[]u8=uarena[us..us+ul];
            let ts:i32=g32(ttab,pi3*8);
            let tl:i32=g32(ttab,pi3*8+4);
            let title3:[]u8=tarena[ts..ts+tl];
            obuf_put(out,&op,"P|");
            obuf_put(out,&op,pid3);
            obuf_put(out,&op,"|");
            obuf_put(out,&op,title3);
            obuf_put(out,&op,"\n");
            let apos:i32=0;
            let chs:i32=0; let chl:i32=0;
            let ohs:i32=0; let ohl:i32=0;
            let st:i32=norm_url(url3,scratch,arena,&apos,psl,psln,lit,cft,cfn,&chs,&chl,&ohs,&ohl);
            if(st==0){
                let origin:[]u8=arena[ohs..ohs+ohl];
                obuf_put(out,&op,"H|");
                obuf_put(out,&op,origin);
                obuf_put(out,&op,"\n");
            }
            let q:i32=0;
            while(q<ns){
                if(g32(stab,q*12)==pi3){
                    let ss2:i32=g32(stab,q*12+4);
                    let sl2:i32=g32(stab,q*12+8);
                    obuf_put(out,&op,"S|");
                    obuf_put(out,&op,sarena[ss2..ss2+sl2]);
                    obuf_put(out,&op,"\n");
                }
                q=q+1;
            }
        }
        si=si+1;
    }
    let rc:i32=0;
    if(write_path(outf,out[0..op])==0){
        _zag_println("ERR cannot write outfile");
        rc=2;
    }
    nio_free(parena);
    nio_free(uarena);
    nio_free(tarena);
    nio_free(sarena);
    nio_free(ptab);
    nio_free(utab);
    nio_free(ttab);
    nio_free(stab);
    nio_free(idx);
    nio_free(out);
    return rc;
}

// ---------- corrob verdict machinery (HL-3, HL-4) ----------
fn tok_eq(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al!=bl){return 0;}
    return bsub_eq(a,ao,b,bo,al);
}

fn lower_copy(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65 && c<=90){c=(c as i32+32) as u8;}
        b[i]=c;
        i=i+1;
    }
    return b[0..s.len];
}

fn normalize(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    let o:i32=0;
    let pend:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65 && c<=90){c=(c as i32+32) as u8;}
        if(c==32 || c==9 || c==10 || c==13){
            if(o>0){pend=1;}
        }else{
            if(pend==1){b[o]=32; o=o+1; pend=0;}
            b[o]=c;
            o=o+1;
        }
        i=i+1;
    }
    return b[0..o];
}

fn tokenize(s:[]u8,tt:[]u8,cap:i32,minl:i32,n:*i32)void {
    n[0]=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if((c>=97 && c<=122) || (c>=48 && c<=57)){
            let st:i32=i;
            while(i<s.len){
                let d:u8=s[i];
                if(!((d>=97 && d<=122) || (d>=48 && d<=57))){break;}
                i=i+1;
            }
            let ln:i32=i-st;
            if(ln>=minl && n[0]<cap){
                p32(tt,n[0]*8,st);
                p32(tt,n[0]*8+4,ln);
                n[0]=n[0]+1;
            }
        }else{
            i=i+1;
        }
    }
    return;
}

fn overlap(ab:[]u8,at:[]u8,an:i32,bb:[]u8,bt:[]u8,bn:i32)i32 {
    let c:i32=0;
    let i:i32=0;
    while(i<an){
        let ao:i32=g32(at,i*8);
        let al:i32=g32(at,i*8+4);
        let j:i32=0;
        let hit:i32=0;
        while(j<bn){
            if(tok_eq(ab,ao,al,bb,g32(bt,j*8),g32(bt,j*8+4))==1){hit=1; break;}
            j=j+1;
        }
        if(hit==1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn pid_of(pa:[]u8,pt:[]u8,i:i32)[]u8 {
    let s:i32=g32(pt,i*8);
    let l:i32=g32(pt,i*8+4);
    return pa[s..s+l];
}

fn page_nsent(st:[]u8,nst:i32,pg:i32)i32 {
    let c:i32=0;
    let s:i32=0;
    while(s<nst){
        if(g32(st,s*12)==pg){c=c+1;}
        s=s+1;
    }
    return c;
}

fn best_for_page(buf:[]u8,pg:i32,st:[]u8,nst:i32,qb:[]u8,qt:[]u8,qn:i32)[]u8 {
    let best:[]u8="";
    let bs:i32=-1;
    let s:i32=0;
    while(s<nst){
        if(g32(st,s*12)==pg){
            let a:i32=g32(st,s*12+4);
            let e2:i32=a+g32(st,s*12+8);
            let nrm:[]u8=normalize(buf[a..e2]);
            let tt:[]u8=nio_alloc(256*8);
            let tn:i32=0;
            tokenize(nrm,tt,256,2,&tn);
            let sc:i32=overlap(qb,qt,qn,nrm,tt,tn);
            nio_free(tt);
            if(sc>bs){bs=sc; best=nrm;}else{nio_free(nrm);}
        }
        s=s+1;
    }
    return best;
}

// ---- page parser with H| host lines ----
// pt: (pidstart,pidlen) into pa; ht: (hoststart,hostlen) into ha;
// tt: (tstart,tlen) into buf; st: (pageidx,sstart,slen) into buf.

fn parse_pages_h(buf:[]u8,np:*i32,pa:[]u8,papos:*i32,pt:[]u8,
    ha:[]u8,hapos:*i32,ht:[]u8,tt:[]u8,st:[]u8,nst:*i32,maxp:i32,maxs:i32)void {
    np[0]=0;
    nst[0]=0;
    let pos:i32=0;
    let ls:i32=0;
    let ll:i32=0;
    while(next_line(buf,&pos,&ls,&ll)==1){
        let ln:i32=ll;
        if(ln>0 && buf[ls+ln-1]==13){ln=ln-1;}
        if(ln>2 && buf[ls]==80 && buf[ls+1]==124){
            if(np[0]>=maxp){continue;}
            let a:i32=ls+2;
            let b:i32=a;
            while(b<ls+ln && buf[b]!=124){b=b+1;}
            let c:i32=b;
            if(c<ls+ln){c=c+1;}
            let pl:i32=b-a;
            if(papos[0]+pl<=pa.len){
                let ps:i32=papos[0];
                let k:i32=0;
                while(k<pl){pa[ps+k]=buf[a+k]; k=k+1;}
                papos[0]=ps+pl;
                p32(pt,np[0]*8,ps);
                p32(pt,np[0]*8+4,pl);
                p32(tt,np[0]*8,c);
                p32(tt,np[0]*8+4,ls+ln-c);
                p32(ht,np[0]*8,hapos[0]);
                p32(ht,np[0]*8+4,0);
                np[0]=np[0]+1;
            }
        }else{
            if(ln>2 && buf[ls]==72 && buf[ls+1]==124){
                if(np[0]>0){
                    let hs:i32=ls+2;
                    let hl:i32=ln-2;
                    if(hapos[0]+hl<=ha.len){
                        let hp2:i32=hapos[0];
                        let k2:i32=0;
                        while(k2<hl){ha[hp2+k2]=buf[hs+k2]; k2=k2+1;}
                        hapos[0]=hp2+hl;
                        p32(ht,(np[0]-1)*8,hp2);
                        p32(ht,(np[0]-1)*8+4,hl);
                    }
                }
            }else{
                if(ln>2 && buf[ls]==83 && buf[ls+1]==124){
                    if(np[0]==0 && np[0]<maxp){
                        p32(pt,0,0);
                        p32(pt,4,0);
                        p32(tt,0,0);
                        p32(tt,4,0);
                        p32(ht,0,0);
                        p32(ht,4,0);
                        np[0]=1;
                    }
                    if(np[0]>0 && nst[0]<maxs){
                        let o:i32=nst[0]*12;
                        p32(st,o,np[0]-1);
                        p32(st,o+4,ls+2);
                        p32(st,o+8,ln-2);
                        nst[0]=nst[0]+1;
                    }
                }
            }
        }
    }
    return;
}

fn host_of_idx(ha:[]u8,ht:[]u8,i:i32)[]u8 {
    let s:i32=g32(ht,i*8);
    let l:i32=g32(ht,i*8+4);
    return ha[s..s+l];
}

// canonical order: byte-lexicographic pid sort (insertion sort, deterministic)

fn pid_less_idx(pa:[]u8,pt:[]u8,i:i32,j:i32)i32 {
    let a:[]u8=pid_of(pa,pt,i);
    let b:[]u8=pid_of(pa,pt,j);
    let m:i32=a.len;
    if(b.len<m){m=b.len;}
    let k:i32=0;
    while(k<m){
        if(a[k]<b[k]){return 1;}
        if(a[k]>b[k]){return 0;}
        k=k+1;
    }
    if(a.len<b.len){return 1;}
    return 0;
}

fn sort_page_idx(pa:[]u8,pt:[]u8,idx:[]u8,n:i32)void {
    let i:i32=1;
    while(i<n){
        let v:i32=g32(idx,i*4);
        let j:i32=i-1;
        while(j>=0){
            if(pid_less_idx(pa,pt,v,g32(idx,j*4))==0){break;}
            p32(idx,(j+1)*4,g32(idx,j*4));
            j=j-1;
        }
        p32(idx,(j+1)*4,v);
        i=i+1;
    }
    return;
}

// ---- C1: explicit-negation contradiction ----
// expand contractions on the padded normalized string, single left-to-right pass.

fn expand_neg(s:[]u8)[]u8 {
    let tab:[]u8="isn't|is not;aren't|are not;wasn't|was not;weren't|were not;don't|do not;doesn't|does not;didn't|did not;can't|can not;cannot|can not;won't|will not;wouldn't|would not;couldn't|could not;shouldn't|should not;hasn't|has not;haven't|have not;hadn't|had not;";
    let padded:[]u8=nio_alloc(s.len+3);
    if(padded.len==0){return "";}
    padded[0]=32;
    let ci:i32=0;
    while(ci<s.len){padded[1+ci]=s[ci]; ci=ci+1;}
    padded[s.len+1]=32;
    let ps:[]u8=padded[0..s.len+2];
    let out:[]u8=nio_alloc(s.len+(s.len/2)+16);
    if(out.len==0){nio_free(padded); return "";}
    let o:i32=0;
    let i:i32=0;
    while(i<ps.len){
        let matched:i32=0;
        // walk the pattern table: pat|rep; entries
        let tp:i32=0;
        while(tp<tab.len && matched==0){
            let pe:i32=tp;
            while(pe<tab.len && tab[pe]!=59){pe=pe+1;}
            let sepi:i32=tp;
            while(sepi<pe && tab[sepi]!=124){sepi=sepi+1;}
            let ppo:i32=tp;
            let ppl:i32=sepi-tp;
            let rpo:i32=sepi+1;
            let rpl:i32=pe-sepi-1;
            if(ppl>0 && rpl>0 && i+1+ppl<ps.len){
                if(ps[i]==32 && ps[i+1+ppl]==32 && bsub_eq(ps,i+1,tab,ppo,ppl)==1){
                    out[o]=32;
                    o=o+1;
                    let rc2:i32=0;
                    while(rc2<rpl){out[o+rc2]=tab[rpo+rc2]; rc2=rc2+1;}
                    o=o+rpl;
                    i=i+1+ppl;
                    matched=1;
                }
            }
            tp=pe+1;
        }
        if(matched==0){
            out[o]=ps[i];
            o=o+1;
            i=i+1;
        }
    }
    nio_free(padded);
    return out[0..o];
}

// C1: token-multiset symmetric difference is exactly one token in {not,never,no}

fn neg_contra(a:[]u8,b:[]u8)i32 {
    let ea:[]u8=expand_neg(a);
    let eb:[]u8=expand_neg(b);
    let at:[]u8=nio_alloc(256*8);
    let bt:[]u8=nio_alloc(256*8);
    let an:i32=0;
    let bn:i32=0;
    tokenize(ea,at,256,1,&an);
    tokenize(eb,bt,256,1,&bn);
    let rc:i32=0;
    if(at.len>0 && bt.len>0){
        let big:[]u8=at;
        let bl:[]u8=ea;
        let bn2:i32=an;
        let sml:[]u8=bt;
        let sl:[]u8=eb;
        let sn2:i32=bn;
        if(an<bn){
            big=bt; bl=eb; bn2=bn;
            sml=at; sl=ea; sn2=an;
        }
        if(bn2==sn2+1 && bn2<=256){
            let used:[]u8=nio_alloc(256);
            let okm:i32=1;
            if(used.len>0){
                let si:i32=0;
                while(si<sn2 && okm==1){
                    let so:i32=g32(sml,si*8);
                    let sln:i32=g32(sml,si*8+4);
                    let j:i32=0;
                    let fnd:i32=0;
                    while(j<bn2){
                        if(used[j]==0 && tok_eq(sl,so,sln,bl,g32(big,j*8),g32(big,j*8+4))==1){
                            used[j]=1; fnd=1; break;
                        }
                        j=j+1;
                    }
                    if(fnd==0){okm=0;}
                    si=si+1;
                }
                if(okm==1){
                    let left:i32=0;
                    let lo:i32=0;
                    let ll:i32=0;
                    let j2:i32=0;
                    while(j2<bn2){
                        if(used[j2]==0){left=left+1; lo=g32(big,j2*8); ll=g32(big,j2*8+4);}
                        j2=j2+1;
                    }
                    if(left==1){
                        let tok:[]u8=bl[lo..lo+ll];
                        if(nio_equal(tok,"not")==1){rc=1;}
                        if(nio_equal(tok,"never")==1){rc=1;}
                        if(nio_equal(tok,"no")==1){rc=1;}
                    }
                }
            }
            nio_free(used);
        }
    }
    nio_free(ea);
    nio_free(eb);
    nio_free(at);
    nio_free(bt);
    return rc;
}

// ---- C2: numeric-conflict contradiction ----

fn is_numtok(s:[]u8,o:i32,l:i32)i32 {
    if(l<1 || l>18){return 0;}
    let i:i32=0;
    while(i<l){
        let c:u8=s[o+i];
        if(c<48 || c>57){return 0;}
        i=i+1;
    }
    return 1;
}

// numeric equality: strip leading zeros, then length + bytes

fn num_tok_equal(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    let x:i32=ao;
    let xl:i32=al;
    while(xl>1 && a[x]==48){x=x+1; xl=xl-1;}
    let y:i32=bo;
    let yl:i32=bl;
    while(yl>1 && b[y]==48){y=y+1; yl=yl-1;}
    if(xl!=yl){return 0;}
    return bsub_eq(a,x,b,y,xl);
}

fn is_connector(s:[]u8,o:i32,l:i32)i32 {
    if(nio_equal(s[o..o+l],"to")==1){return 1;}
    if(nio_equal(s[o..o+l],"and")==1){return 1;}
    if(nio_equal(s[o..o+l],"between")==1){return 1;}
    if(nio_equal(s[o..o+l],"from")==1){return 1;}
    return 0;
}

// split one sentence into frame tokens + numeric vals.
// ft: (off,len) kept frame tokens; vt: (off,len) numeric vals; counts out.

fn frame_vals(s:[]u8,ft:[]u8,fnp:*i32,vt:[]u8,vn:*i32)void {
    fnp[0]=0;
    vn[0]=0;
    let tt:[]u8=nio_alloc(256*8);
    let tn:i32=0;
    tokenize(s,tt,256,1,&tn);
    let i:i32=0;
    while(i<tn){
        let to:i32=g32(tt,i*8);
        let tl:i32=g32(tt,i*8+4);
        if(is_numtok(s,to,tl)==1){
            if(vn[0]<8){
                p32(vt,vn[0]*8,to);
                p32(vt,vn[0]*8+4,tl);
                vn[0]=vn[0]+1;
            }
        }else{
            let drop:i32=0;
            if(is_connector(s,to,tl)==1){
                let adj:i32=0;
                if(i>0){
                    let po:i32=g32(tt,(i-1)*8);
                    let pl:i32=g32(tt,(i-1)*8+4);
                    if(is_numtok(s,po,pl)==1){adj=1;}
                }
                if(i+1<tn){
                    let qo:i32=g32(tt,(i+1)*8);
                    let ql:i32=g32(tt,(i+1)*8+4);
                    if(is_numtok(s,qo,ql)==1){adj=1;}
                }
                if(adj==1){drop=1;}
            }
            if(drop==0 && fnp[0]<256){
                p32(ft,fnp[0]*8,to);
                p32(ft,fnp[0]*8+4,tl);
                fnp[0]=fnp[0]+1;
            }
        }
        i=i+1;
    }
    nio_free(tt);
    return;
}

fn num_contra(a:[]u8,b:[]u8)i32 {
    let fa:[]u8=nio_alloc(256*8);
    let fb:[]u8=nio_alloc(256*8);
    let va:[]u8=nio_alloc(8*8);
    let vb:[]u8=nio_alloc(8*8);
    let fna:i32=0;
    let fnb:i32=0;
    let vna:i32=0;
    let vnb:i32=0;
    frame_vals(a,fa,&fna,va,&vna);
    frame_vals(b,fb,&fnb,vb,&vnb);
    let rc:i32=0;
    if(vna>0 && vnb>0 && vna<=8 && vnb<=8 && fna==fnb){
        let same:i32=1;
        let i:i32=0;
        while(i<fna && same==1){
            if(tok_eq(a,g32(fa,i*8),g32(fa,i*8+4),b,g32(fb,i*8),g32(fb,i*8+4))==0){same=0;}
            i=i+1;
        }
        if(same==1){
            // multiset equality of vals via matched-pair elimination
            let used:[]u8=nio_alloc(8);
            let allm:i32=1;
            if(used.len>0){
                if(vna!=vnb){allm=0;}else{
                    let p:i32=0;
                    while(p<vna && allm==1){
                        let q:i32=0;
                        let fnd:i32=0;
                        while(q<vnb){
                            if(used[q]==0 && num_tok_equal(a,g32(va,p*8),g32(va,p*8+4),b,g32(vb,q*8),g32(vb,q*8+4))==1){
                                used[q]=1; fnd=1; break;
                            }
                            q=q+1;
                        }
                        if(fnd==0){allm=0;}
                        p=p+1;
                    }
                }
            }
            nio_free(used);
            if(allm==0){rc=1;}
        }
    }
    nio_free(fa);
    nio_free(fb);
    nio_free(va);
    nio_free(vb);
    return rc;
}

// addon_gates.zag — LI-HARDEN Tier-1 add-on gates (measured candidates).
// Pure Zag. Zero RNG. Deterministic.
//   C3  (WALL-RED crack 1): functional-slot proper-noun dissent. Fires only
//       when both sentences parse to the same frozen slot frame with the same
//       entity but different fillers. Numeric/negation shapes DEFER to HL-4
//       C1/C2 (division of labor): c3_slot_dissent returns 0 for them.
//       Precondition: inputs are normalize()d (lowercase, ws-collapsed).
//   ch1 (BEYOND): assertion-polarity veto. A non-claim sentence sharing >=2
//       content words with the winning claim that carries a polarity flipper
//       (false/hoax/...) or an antonym predicate vetoes the install.
//   ch2 (BEYOND): furniture-coupled repetition discount (safer HL-10). A
//       non-claim sentence with page-furniture markers repeated byte-identical
//       across >=2 distinct hosts discounts its pages' votes before quorum.

// ================= C3 =================

fn c3_index_of(h:[]u8,n:[]u8,from:i32)i32 {
    if(n.len==0){return from;}
    if(from<0){from=0;}
    let i:i32=from;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len && h[i+k]==n[k]){k=k+1;}
        if(k==n.len){return i;}
        i=i+1;
    }
    return -1;
}

fn c3_ends_with(h:[]u8,suf:[]u8)i32 {
    if(h.len<suf.len){return 0;}
    return nio_equal(h[h.len-suf.len..h.len],suf);
}

fn c3_strip_dot(s:[]u8)[]u8 {
    if(s.len>0 && s[s.len-1]==46){return s[0..s.len-1];}
    return s;
}

fn c3_is_numtok(t:[]u8)i32 {
    if(t.len==0){return 0;}
    let i:i32=0;
    while(i<t.len){
        let b:i32=t[i] as i32;
        if(b<48 || b>57){return 0;}
        i=i+1;
    }
    return 1;
}

fn c3_is_conn(t:[]u8)i32 {
    if(nio_equal(t,"to")==1){return 1;}
    if(nio_equal(t,"and")==1){return 1;}
    if(nio_equal(t,"between")==1){return 1;}
    if(nio_equal(t,"from")==1){return 1;}
    return 0;
}

// non-numeric, non-connector token sequence (trailing space per token)
fn c3_frametok(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let w:i32=0;
    let i:i32=0;
    while(i<=s.len){
        let e:i32=i;
        while(e<s.len && s[e]!=32){e=e+1;}
        let t:[]u8=s[i..e];
        if(t.len>1 && t[t.len-1]==46){t=t[0..t.len-1];}
        if(t.len>0 && c3_is_numtok(t)==0 && c3_is_conn(t)==0){
            let k:i32=0;
            while(k<t.len){o[w]=t[k]; w=w+1; k=k+1;}
            o[w]=32; w=w+1;
        }
        i=e+1;
    }
    return o[0..w];
}

// parse "<rel> of <ent> is <val>"; mid: 1=capital 2=president 3=atomic number
fn c3_parse_of(s:[]u8,mid:*i32,es:*i32,el:*i32,vs:*i32,vl:*i32)i32 {
    let io:i32=c3_index_of(s," of ",0);
    if(io<0){return 0;}
    let ii:i32=c3_index_of(s," is ",io+4);
    if(ii<0){return 0;}
    let rel:[]u8=s[0..io];
    let m:i32=0;
    if(c3_ends_with(rel,"capital")==1){m=1;}
    if(c3_ends_with(rel,"president")==1){m=2;}
    if(c3_ends_with(rel,"atomic number")==1){m=3;}
    if(m==0){return 0;}
    mid[0]=m;
    es[0]=io+4; el[0]=ii-(io+4);
    vs[0]=ii+4; vl[0]=s.len-(ii+4);
    return 1;
}

// parse "<val> is the <frame>"; mid: 1=closest planet 2=tallest mountain 3=largest city
fn c3_parse_sup(s:[]u8,mid:*i32,vs:*i32,vl:*i32,fs:*i32,fl:*i32)i32 {
    let ii:i32=c3_index_of(s," is the ",0);
    if(ii<0){return 0;}
    let rest:[]u8=s[ii+8..s.len];
    let m:i32=0;
    if(nio_equal(rest,"closest planet to the sun.")==1){m=1;}
    if(nio_equal(rest,"closest planet to the sun")==1){m=1;}
    if(nio_equal(rest,"tallest mountain in the world.")==1){m=2;}
    if(nio_equal(rest,"tallest mountain in the world")==1){m=2;}
    if(nio_equal(rest,"largest city in the country.")==1){m=3;}
    if(nio_equal(rest,"largest city in the country")==1){m=3;}
    if(m==0){return 0;}
    mid[0]=m;
    vs[0]=0; vl[0]=ii;
    fs[0]=ii; fl[0]=s.len-ii;
    return 1;
}

// 1=FIRE, 0=nofire-or-defer. a,b must be normalize()d.
fn c3_slot_dissent(a:[]u8,b:[]u8)i32 {
    // division of labor: numeric-shaped -> HL-4 C2
    let fa:[]u8=c3_frametok(a);
    let fb:[]u8=c3_frametok(b);
    if(nio_equal(fa,fb)==1 && nio_equal(a,b)==0){return 0;}
    nio_free(fa); nio_free(fb);
    // negation-shaped -> HL-4 C1: " not " -> " " equalizes
    let nn:i32=c3_index_of(a," not ",0);
    if(nn>=0){
        let wo:[]u8=nio_alloc(a.len+1);
        if(wo.len>0){
            let w:i32=0;
            let i:i32=0;
            while(i<a.len){
                if(i==nn){wo[w]=32; w=w+1; i=i+5;}
                else{wo[w]=a[i]; w=w+1; i=i+1;}
            }
            if(nio_equal(wo[0..w],b)==1){nio_free(wo); return 0;}
            nio_free(wo);
        }
    }
    let nn2:i32=c3_index_of(b," not ",0);
    if(nn2>=0){
        let wo2:[]u8=nio_alloc(b.len+1);
        if(wo2.len>0){
            let w2:i32=0;
            let j:i32=0;
            while(j<b.len){
                if(j==nn2){wo2[w2]=32; w2=w2+1; j=j+5;}
                else{wo2[w2]=b[j]; w2=w2+1; j=j+1;}
            }
            if(nio_equal(wo2[0..w2],a)==1){nio_free(wo2); return 0;}
            nio_free(wo2);
        }
    }
    let m1:i32=0; let e1s:i32=0; let e1l:i32=0; let v1s:i32=0; let v1l:i32=0;
    let m2:i32=0; let e2s:i32=0; let e2l:i32=0; let v2s:i32=0; let v2l:i32=0;
    let pm1:*i32=&m1; let pe1s:*i32=&e1s; let pe1l:*i32=&e1l;
    let pv1s:*i32=&v1s; let pv1l:*i32=&v1l;
    let pm2:*i32=&m2; let pe2s:*i32=&e2s; let pe2l:*i32=&e2l;
    let pv2s:*i32=&v2s; let pv2l:*i32=&v2l;
    let p1:i32=c3_parse_of(a,pm1,pe1s,pe1l,pv1s,pv1l);
    let p2:i32=c3_parse_of(b,pm2,pe2s,pe2l,pv2s,pv2l);
    if(p1==1 && p2==1 && m1==m2){
        let ent1:[]u8=a[e1s..e1s+e1l];
        let ent2:[]u8=b[e2s..e2s+e2l];
        let val1:[]u8=c3_strip_dot(a[v1s..v1s+v1l]);
        let val2:[]u8=c3_strip_dot(b[v2s..v2s+v2l]);
        if(nio_equal(ent1,ent2)==1 && nio_equal(val1,val2)==0 && val1.len>0 && val2.len>0){return 1;}
        return 0;
    }
    let s1:i32=0; let w1s:i32=0; let w1l:i32=0; let f1s:i32=0; let f1l:i32=0;
    let s2:i32=0; let w2s:i32=0; let w2l:i32=0; let f2s:i32=0; let f2l:i32=0;
    let ps1:*i32=&s1; let pw1s:*i32=&w1s; let pw1l:*i32=&w1l;
    let pf1s:*i32=&f1s; let pf1l:*i32=&f1l;
    let ps2:*i32=&s2; let pw2s:*i32=&w2s; let pw2l:*i32=&w2l;
    let pf2s:*i32=&f2s; let pf2l:*i32=&f2l;
    let q1:i32=c3_parse_sup(a,ps1,pw1s,pw1l,pf1s,pf1l);
    let q2:i32=c3_parse_sup(b,ps2,pw2s,pw2l,pf2s,pf2l);
    if(q1==1 && q2==1 && s1==s2){
        let val1:[]u8=a[w1s..w1s+w1l];
        let val2:[]u8=b[w2s..w2s+w2l];
        let fr1:[]u8=a[f1s..f1s+f1l];
        let fr2:[]u8=b[f2s..f2s+f2l];
        if(nio_equal(fr1,fr2)==1 && nio_equal(val1,val2)==0 && val1.len>0 && val2.len>0){return 1;}
        return 0;
    }
    return 0;
}

// ================= ch1 =================

fn ch1_in_list(tok:[]u8,list:[]u8)i32 {
    let start:i32=0;
    let i:i32=0;
    while(i<=list.len){
        if(i==list.len || list[i]==124){
            if(i-start==tok.len){
                let k:i32=0;
                let eq:i32=1;
                while(k<tok.len){
                    if(tok[k]!=list[start+k]){eq=0; break;}
                    k=k+1;
                }
                if(eq==1){return 1;}
            }
            start=i+1;
        }
        i=i+1;
    }
    return 0;
}

fn ch1_stopword(w:[]u8)i32 {
    return ch1_in_list(w,"the|a|an|is|are|was|were|be|been|being|of|to|in|on|for|and|or|that|this|these|those|it|its|at|by|as|from|with|what|how|when|where|who|which|do|does|did|can|could|would|should|have|has|had|not|no|than|then|so|such|into|out|up|all|any|each|more|most|other|some|only|over|under|again|once|here|there|their|them|they|we|you|your|his|her|our|my|me|him|us");
}

fn ch1_flipper(w:[]u8)i32 {
    return ch1_in_list(w,"false|hoax|myth|myths|debunked|denied|deny|denies|fake|incorrect|wrong|disproved|fabricated|lie|lies|fraud|scam");
}

fn ch1_is_digit(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    return 0;
}

// word byte: [a-z0-9]; everything else (incl. punctuation) is a separator.
// (Replicates the probe's punctuation->space normalization at word level;
// tier1 normalize() keeps punctuation, so space-split would yield "false.".)
fn ch1_is_wordbyte(c:u8)i32 {
    if(c>=97 && c<=122){return 1;}
    if(c>=48 && c<=57){return 1;}
    return 0;
}

// split normalized sentence into words; store off/len pairs (8B each)
fn ch1_words_of(s:[]u8,tab:[]u8,maxw:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.len && n<maxw){
        while(i<s.len && ch1_is_wordbyte(s[i])==0){i=i+1;}
        if(i>=s.len){break;}
        let st:i32=i;
        while(i<s.len && ch1_is_wordbyte(s[i])==1){i=i+1;}
        p32(tab,n*8,st);
        p32(tab,n*8+4,i-st);
        n=n+1;
    }
    return n;
}

fn ch1_word_at(s:[]u8,tab:[]u8,k:i32)[]u8 {
    let st:i32=g32(tab,k*8);
    let ln:i32=g32(tab,k*8+4);
    return s[st..st+ln];
}

// content words: non-stopword, non-pure-number. returns count; ctab gets off/len.
fn ch1_content_words(s:[]u8,wtab:[]u8,nw:i32,ctab:[]u8)i32 {
    let n:i32=0;
    let k:i32=0;
    while(k<nw){
        let w:[]u8=ch1_word_at(s,wtab,k);
        if(ch1_stopword(w)==0){
            let alldig:i32=1;
            let j:i32=0;
            while(j<w.len){if(ch1_is_digit(w[j])==0){alldig=0; break;} j=j+1;}
            if(alldig==0 || w.len==0){
                p32(ctab,n*8,g32(wtab,k*8));
                p32(ctab,n*8+4,g32(wtab,k*8+4));
                n=n+1;
            }
        }
        k=k+1;
    }
    return n;
}

fn ch1_cword_at(s:[]u8,ctab:[]u8,k:i32)[]u8 {
    return ch1_word_at(s,ctab,k);
}

// number of claim content words present in s
fn ch1_shared_cw(s:[]u8,claim:[]u8,ctab:[]u8,nc:i32)i32 {
    let wt:[]u8=nio_alloc(64*8);
    if(wt.len==0){return 0;}
    let nw:i32=ch1_words_of(s,wt,64);
    let ct:[]u8=nio_alloc(64*8);
    if(ct.len==0){nio_free(wt); return 0;}
    let n2:i32=ch1_content_words(s,wt,nw,ct);
    let sh:i32=0;
    let k:i32=0;
    while(k<nc){
        let cw:[]u8=ch1_cword_at(claim,ctab,k);
        let j:i32=0;
        let found:i32=0;
        while(j<n2){
            if(nio_equal(cw,ch1_cword_at(s,ct,j))==1){found=1; break;}
            j=j+1;
        }
        if(found==1){sh=sh+1;}
        k=k+1;
    }
    nio_free(wt);
    nio_free(ct);
    return sh;
}

// whole-word occurrence of w in s (word-level scan; punctuation-proof)
fn ch1_has_word(s:[]u8,w:[]u8)i32 {
    let tab:[]u8=nio_alloc(64*8);
    if(tab.len==0){return 0;}
    let nw:i32=ch1_words_of(s,tab,64);
    let k:i32=0;
    let hit:i32=0;
    while(k<nw){
        if(nio_equal(ch1_word_at(s,tab,k),w)==1){hit=1; break;}
        k=k+1;
    }
    nio_free(tab);
    return hit;
}

// ================= ch2 =================

// 1 if s carries page-furniture markers (whole-word or phrase)
fn ch2_is_furniture(s:[]u8)i32 {
    let w:[]u8=nio_alloc(64*8);
    if(w.len==0){return 0;}
    let nw:i32=ch1_words_of(s,w,64);
    let k:i32=0;
    let hit:i32=0;
    while(k<nw){
        let wd:[]u8=ch1_word_at(s,w,k);
        if(ch1_in_list(wd,"comments|subscribe|cookie|advertisement|newsletter")==1){hit=1; break;}
        k=k+1;
    }
    nio_free(w);
    if(hit==1){return 1;}
    if(bsub(s,"powered by")==1){return 1;}
    if(bsub(s,"sign up")==1){return 1;}
    if(bsub(s,"log in")==1){return 1;}
    if(bsub(s,"share this")==1){return 1;}
    if(bsub(s,"all rights reserved")==1){return 1;}
    return 0;
}

fn contra_pair(a:[]u8,b:[]u8)i32 {
    if(a.len==0 || b.len==0){return 0;}
    if(nio_equal(a,b)==1){return 0;}
    if(neg_contra(a,b)==1){return 1;}
    if(num_contra(a,b)==1){return 1;}
    if(c3_slot_dissent(a,b)==1){return 1;}
    return 0;
}

// ---- verdict core ----

fn print_pids(pa:[]u8,pt:[]u8,idx:[]u8,n:i32)void {
    let m:i32=0;
    while(m<n){
        if(m>0){_zag_print(",");}
        _zag_print(pid_of(pa,pt,g32(idx,m*4)));
        m=m+1;
    }
    return;
}

// normalized full body: ALL SENTENCES joined (title excluded — mirrors vary titles;
// sentence-body identity is the mirror signal). For mirror-dedup grouping.

fn page_body(buf:[]u8,pg:i32,tt:[]u8,st:[]u8,nst:i32)[]u8 {
    let sz:i32=1;
    let s:i32=0;
    while(s<nst){
        if(g32(st,s*12)==pg){sz=sz+g32(st,s*12+8)+1;}
        s=s+1;
    }
    let raw:[]u8=nio_alloc(sz+1);
    if(raw.len==0){return "";}
    let o:i32=0;
    let i:i32=0;
    s=0;
    while(s<nst){
        if(g32(st,s*12)==pg){
            let a:i32=g32(st,s*12+4);
            let l:i32=g32(st,s*12+8);
            i=0;
            while(i<l){raw[o]=buf[a+i]; o=o+1; i=i+1;}
            raw[o]=10; o=o+1;
        }
        s=s+1;
    }
    let nrm:[]u8=normalize(raw[0..o]);
    nio_free(raw);
    return nrm;
}

// count distinct non-empty hosts among page-index list

fn distinct_hosts(ha:[]u8,ht:[]u8,idx:[]u8,n:i32)[]u8 {
    // returns arena-packed distinct host table; count via out param pattern inline
    let tmp:[]u8="";
    return tmp;
}

fn run_verdict(pagesp:[]u8,query:[]u8,resultsp:[]u8,mode:i32)i32 {
    let ok:i32=0;
    let buf:[]u8=read_path(pagesp,&ok);
    if(ok==0){return 2;}
    let pa:[]u8=nio_alloc(8192);
    let papos:i32=0;
    let pt:[]u8=nio_alloc(64*8);
    let ha:[]u8=nio_alloc(8192);
    let hapos:i32=0;
    let ht:[]u8=nio_alloc(64*8);
    let tt:[]u8=nio_alloc(64*8);
    let st:[]u8=nio_alloc(2048*12);
    let np:i32=0;
    let nst:i32=0;
    parse_pages_h(buf,&np,pa,&papos,pt,ha,&hapos,ht,tt,st,&nst,64,2048);
    let qlow:[]u8=normalize(query);
    let qt:[]u8=nio_alloc(512*8);
    let qn:i32=0;
    tokenize(qlow,qt,512,2,&qn);
    // canonical order
    let cidx:[]u8=nio_alloc(64*4);
    let k:i32=0;
    while(k<np){p32(cidx,k*4,k); k=k+1;}
    sort_page_idx(pa,pt,cidx,np);
    // candidates in canonical order
    let ca:[]u8=nio_alloc(262144);
    let ct:[]u8=nio_alloc(64*8);
    let cpg:[]u8=nio_alloc(64*4);
    let ncand:i32=0;
    let capos:i32=0;
    k=0;
    while(k<np){
        let pg:i32=g32(cidx,k*4);
        let cand:[]u8=best_for_page(buf,pg,st,nst,qlow,qt,qn);
        if(cand.len>0 && capos+cand.len<=ca.len && ncand<64){
            let c2:i32=0;
            while(c2<cand.len){ca[capos+c2]=cand[c2]; c2=c2+1;}
            p32(ct,ncand*8,capos);
            p32(ct,ncand*8+4,cand.len);
            p32(cpg,ncand*4,pg);
            ncand=ncand+1;
            capos=capos+cand.len;
        }
        nio_free(cand);
        k=k+1;
    }
    // mirror dedup (mode 2): one vote per byte-identical normalized body
    let keep:[]u8=nio_alloc(64);
    k=0;
    while(k<ncand){keep[k]=1; k=k+1;}
    if(mode==2 && ncand>0){
        let ba:[]u8=nio_alloc(262144);
        let bt:[]u8=nio_alloc(64*8);
        let bpos:i32=0;
        k=0;
        while(k<ncand){
            let bd:[]u8=page_body(buf,g32(cpg,k*4),tt,st,nst);
            if(bpos+bd.len<=ba.len){
                let c3:i32=0;
                while(c3<bd.len){ba[bpos+c3]=bd[c3]; c3=c3+1;}
                p32(bt,k*8,bpos);
                p32(bt,k*8+4,bd.len);
                bpos=bpos+bd.len;
            }else{
                p32(bt,k*8,bpos);
                p32(bt,k*8+4,0);
            }
            nio_free(bd);
            k=k+1;
        }
        k=0;
        while(k<ncand){
            let j:i32=0;
            while(j<k){
                if(keep[j]==1){
                    let s1:i32=g32(bt,k*8);
                    let l1:i32=g32(bt,k*8+4);
                    let s2:i32=g32(bt,j*8);
                    let l2:i32=g32(bt,j*8+4);
                    if(l1==l2 && bsub_eq(ba,s1,ba,s2,l1)==1){keep[k]=0; break;}
                }
                j=j+1;
            }
            k=k+1;
        }
        nio_free(ba);
        nio_free(bt);
    }
    // contradiction scan over kept candidates
    let cona:[]u8=nio_alloc(64*4);
    let conn:i32=0;
    let ci:i32=0;
    while(ci<ncand){
        if(keep[ci]==1){
            let cj:i32=ci+1;
            while(cj<ncand){
                if(keep[cj]==1){
                    let a1:[]u8=ca[g32(ct,ci*8)..g32(ct,ci*8)+g32(ct,ci*8+4)];
                    let b1:[]u8=ca[g32(ct,cj*8)..g32(ct,cj*8)+g32(ct,cj*8+4)];
                    if(contra_pair(a1,b1)==1){
                        // record both page indices (dedup later)
                        if(conn<64){p32(cona,conn*4,g32(cpg,ci*4)); conn=conn+1;}
                        if(conn<64){p32(cona,conn*4,g32(cpg,cj*4)); conn=conn+1;}
                    }
                }
                cj=cj+1;
            }
        }
        ci=ci+1;
    }
    // dedup contradiction pid list (already canonical order)
    let conu:[]u8=nio_alloc(64*4);
    let conun:i32=0;
    ci=0;
    while(ci<conn){
        let v:i32=g32(cona,ci*4);
        let seen:i32=0;
        let q2:i32=0;
        while(q2<conun){
            if(g32(conu,q2*4)==v){seen=1; break;}
            q2=q2+1;
        }
        if(seen==0){p32(conu,conun*4,v); conun=conun+1;}
        ci=ci+1;
    }
    _zag_print("INFO|CANON|");
    print_pids(pa,pt,cidx,np);
    _zag_println("");
    if(conun>0){
        _zag_println("ANSWER|UNCHECKABLE");
        _zag_print("GATE|CONTRADICTION|");
        print_pids(pa,pt,conu,conun);
        _zag_println("");
        nio_free(buf);
        nio_free(pa);
        nio_free(pt);
        nio_free(ha);
        nio_free(ht);
        nio_free(tt);
        nio_free(st);
        nio_free(qlow);
        nio_free(qt);
        nio_free(cidx);
        nio_free(ca);
        nio_free(ct);
        nio_free(cpg);
        nio_free(keep);
        nio_free(cona);
        nio_free(conu);
        return 0;
    }
    // cluster kept candidates by byte equality; winner = largest, tie -> WITHHOLD (HL-3 no-tie-install)
    let ck:[]u8=nio_alloc(64*8);
    let cc:[]u8=nio_alloc(64*4);
    let cm:[]u8=nio_alloc(64*64*4);
    let ncl:i32=0;
    let j:i32=0;
    while(j<ncand){
        if(keep[j]==1){
            let s2:i32=g32(ct,j*8);
            let l2:i32=g32(ct,j*8+4);
            let pg2:i32=g32(cpg,j*4);
            let c:i32=0;
            let found:i32=-1;
            while(c<ncl){
                let ks:i32=g32(ck,c*8);
                let kl:i32=g32(ck,c*8+4);
                if(kl==l2 && bsub_eq(ca,ks,ca,s2,kl)==1){found=c; break;}
                c=c+1;
            }
            if(found==-1){
                if(ncl<64){
                    p32(ck,ncl*8,s2);
                    p32(ck,ncl*8+4,l2);
                    p32(cc,ncl*4,1);
                    p32(cm,ncl*256,pg2);
                    ncl=ncl+1;
                }
            }else{
                let cnt:i32=g32(cc,found*4);
                if(cnt<64){
                    p32(cm,found*256+cnt*4,pg2);
                    p32(cc,found*4,cnt+1);
                }
            }
        }
        j=j+1;
    }
    let w:i32=-1;
    let wc:i32=-1;
    let c4:i32=0;
    while(c4<ncl){
        let cnt2:i32=g32(cc,c4*4);
        if(cnt2>wc){w=c4; wc=cnt2;}
        c4=c4+1;
    }
    if(w<0){
        _zag_println("ANSWER|UNCHECKABLE");
        _zag_println("GATE|QUORUM|none");
        nio_free(buf);
        nio_free(pa);
        nio_free(pt);
        nio_free(ha);
        nio_free(ht);
        nio_free(tt);
        nio_free(st);
        nio_free(qlow);
        nio_free(qt);
        nio_free(cidx);
        nio_free(ca);
        nio_free(ct);
        nio_free(cpg);
        nio_free(keep);
        nio_free(cona);
        nio_free(conu);
        nio_free(ck);
        nio_free(cc);
        nio_free(cm);
        return 0;
    }
    if(w>=0){
        // HL-3: any tie for the largest cluster withholds (never first-seen-install)
        let tiec:i32=0;
        let c5:i32=0;
        while(c5<ncl){
            if(g32(cc,c5*4)==wc){tiec=tiec+1;}
            c5=c5+1;
        }
        if(tiec>1){
            let tidx:[]u8=nio_alloc(64*4);
            let tn2:i32=0;
            c5=0;
            while(c5<ncl){
                if(g32(cc,c5*4)==wc){
                    let m6:i32=0;
                    while(m6<wc){
                        p32(tidx,tn2*4,g32(cm,c5*256+m6*4));
                        tn2=tn2+1;
                        m6=m6+1;
                    }
                }
                c5=c5+1;
            }
            _zag_println("ANSWER|UNCHECKABLE");
            _zag_print("GATE|TIE|");
            sort_page_idx(pa,pt,tidx,tn2);
            print_pids(pa,pt,tidx,tn2);
            _zag_println("");
            nio_free(tidx);
            nio_free(buf);
            nio_free(pa);
            nio_free(pt);
            nio_free(ha);
            nio_free(ht);
            nio_free(tt);
            nio_free(st);
            nio_free(qlow);
            nio_free(qt);
            nio_free(cidx);
            nio_free(ca);
            nio_free(ct);
            nio_free(cpg);
            nio_free(keep);
            nio_free(cona);
            nio_free(conu);
            nio_free(ck);
            nio_free(cc);
            nio_free(cm);
            return 0;
        }
    }
    let widx:[]u8=nio_alloc(64*4);
    let m5:i32=0;
    while(m5<wc){
        p32(widx,m5*4,g32(cm,w*256+m5*4));
        m5=m5+1;
    }
    let wclaim:[]u8=ca[g32(ck,w*8)..g32(ck,w*8)+g32(ck,w*8+4)];
    // quorum: >=2 pages and >=2 distinct non-empty hosts
    let nh:i32=0;
    let seen_h:[]u8=nio_alloc(64*8);
    let seen_hn:i32=0;
    let hpos2:i32=hapos;
    m5=0;
    while(m5<wc){
        let h:[]u8=host_of_idx(ha,ht,g32(widx,m5*4));
        if(h.len>0){
            let dup:i32=0;
            let q3:i32=0;
            while(q3<seen_hn){
                let so:i32=g32(seen_h,q3*8);
                let sl:i32=g32(seen_h,q3*8+4);
                if(sl==h.len && bsub_eq(ha,so,ha,g32(ht,g32(widx,m5*4)*8),sl)==1){dup=1; break;}
                q3=q3+1;
            }
            if(dup==0 && hpos2+h.len<=8192){
                let c6:i32=0;
                while(c6<h.len){ha[hpos2+c6]=h[c6]; c6=c6+1;}
                p32(seen_h,seen_hn*8,hpos2);
                p32(seen_h,seen_hn*8+4,h.len);
                seen_hn=seen_hn+1;
                hpos2=hpos2+h.len;
                nh=nh+1;
            }
        }
        m5=m5+1;
    }
    // diversity metrics (report-only): distinct titles, max shared non-claim sentences
    let nti:i32=0;
    let seen_t:[]u8=nio_alloc(64*8);
    let seen_tn:i32=0;
    let tpos:i32=0;
    let tta:[]u8=nio_alloc(262144);
    m5=0;
    while(m5<wc){
        let pg5:i32=g32(widx,m5*4);
        let ta:i32=g32(tt,pg5*8);
        let tl:i32=g32(tt,pg5*8+4);
        let tn2:[]u8=normalize(buf[ta..ta+tl]);
        let dup2:i32=0;
        let q4:i32=0;
        while(q4<seen_tn){
            let so2:i32=g32(seen_t,q4*8);
            let sl2:i32=g32(seen_t,q4*8+4);
            if(nio_equal(tn2,tta[so2..so2+sl2])==1){dup2=1; break;}
            q4=q4+1;
        }
        if(dup2==0 && tpos+tn2.len<=tta.len){
            let c7:i32=0;
            while(c7<tn2.len){tta[tpos+c7]=tn2[c7]; c7=c7+1;}
            p32(seen_t,seen_tn*8,tpos);
            p32(seen_t,seen_tn*8+4,tn2.len);
            seen_tn=seen_tn+1;
            tpos=tpos+tn2.len;
            nti=nti+1;
        }
        nio_free(tn2);
        m5=m5+1;
    }
    // max pairwise shared non-claim sentences among winner pages
    let shmax:i32=0;
    let px:i32=0;
    while(px<wc){
        let py:i32=px+1;
        while(py<wc){
            let pga:i32=g32(widx,px*4);
            let pgb:i32=g32(widx,py*4);
            let sh:i32=0;
            let s3:i32=0;
            while(s3<nst){
                if(g32(st,s3*12)==pga){
                    let sa2:i32=g32(st,s3*12+4);
                    let se2:i32=sa2+g32(st,s3*12+8);
                    let na2:[]u8=normalize(buf[sa2..se2]);
                    if(nio_equal(na2,wclaim)==0){
                        let t3:i32=0;
                        while(t3<nst){
                            if(g32(st,t3*12)==pgb){
                                let sb2:i32=g32(st,t3*12+4);
                                let se3:i32=sb2+g32(st,t3*12+8);
                                let nb2:[]u8=normalize(buf[sb2..se3]);
                                if(nio_equal(na2,nb2)==1){sh=sh+1; nio_free(nb2); break;}
                                nio_free(nb2);
                            }
                            t3=t3+1;
                        }
                    }
                    nio_free(na2);
                }
                s3=s3+1;
            }
            if(sh>shmax){shmax=sh;}
            py=py+1;
        }
        px=px+1;
    }
    _zag_print("INFO|DIVERSITY|pages=");
    _zag_print(i64s(wc as i64));
    _zag_print("|hosts=");
    _zag_print(i64s(nh as i64));
    _zag_print("|titles=");
    _zag_print(i64s(nti as i64));
    _zag_print("|shared_filler_max=");
    _zag_print(i64s(shmax as i64));
    _zag_println("");
    let qneed:i32=2;
    if(mode==3){qneed=3;}
    let verdict_ok:i32=0;
    let furn_hit:i32=0;
    let pol_veto:i32=0;
    if(wc>=qneed && nh>=qneed){verdict_ok=1;}
    // ch2: furniture-coupled repetition discount (BEYOND; safer HL-10).
    // A non-claim sentence carrying page-furniture markers, repeated
    // byte-identical across >=2 distinct hosts, marks its pages' votes as
    // chrome-packaged: discounted before the quorum check.
    if(verdict_ok==1){
        let fz:[]u8=nio_alloc(64*8);
        let fa:[]u8=nio_alloc(4096);
        let fapos:i32=0;
        let nfz:i32=0;
        let s6:i32=0;
        while(s6<nst){
            let so6:i32=g32(st,s6*12+4);
            let sl6:i32=g32(st,s6*12+8);
            let ns6:[]u8=normalize(buf[so6..so6+sl6]);
            if(nio_equal(ns6,wclaim)==0 && ch2_is_furniture(ns6)==1 && nfz<64){
                let dup6:i32=0;
                let q6:i32=0;
                while(q6<nfz){
                    let fo:i32=g32(fz,q6*8);
                    let fl6:i32=g32(fz,q6*8+4);
                    if(nio_equal(ns6,fa[fo..fo+fl6])==1){dup6=1; break;}
                    q6=q6+1;
                }
                if(dup6==0 && fapos+ns6.len<=4096){
                    let cc8:i32=0;
                    while(cc8<ns6.len){fa[fapos+cc8]=ns6[cc8]; cc8=cc8+1;}
                    p32(fz,nfz*8,fapos);
                    p32(fz,nfz*8+4,ns6.len);
                    fapos=fapos+ns6.len;
                    nfz=nfz+1;
                }
            }
            nio_free(ns6);
            s6=s6+1;
        }
        let dw:[]u8=nio_alloc(64*4);
        let ndw:i32=0;
        let f7:i32=0;
        while(f7<nfz){
            let fo7:i32=g32(fz,f7*8);
            let fl7:i32=g32(fz,f7*8+4);
            let fs7:[]u8=fa[fo7..fo7+fl7];
            let fzh:[]u8=nio_alloc(16*8);
            let fzhn:i32=0;
            let hbuf:[]u8=nio_alloc(1024);
            let hpos:i32=0;
            let s7:i32=0;
            while(s7<nst){
                let so7:i32=g32(st,s7*12+4);
                let sl7:i32=g32(st,s7*12+8);
                let ns7:[]u8=normalize(buf[so7..so7+sl7]);
                if(nio_equal(ns7,fs7)==1){
                    let h7:[]u8=host_of_idx(ha,ht,g32(st,s7*12));
                    if(h7.len>0 && fzhn<16){
                        let dq:i32=0;
                        let q7:i32=0;
                        while(q7<fzhn){
                            let ho:i32=g32(fzh,q7*8);
                            let hl:i32=g32(fzh,q7*8+4);
                            if(hl==h7.len && nio_equal(hbuf[ho..ho+hl],h7)==1){dq=1; break;}
                            q7=q7+1;
                        }
                        if(dq==0 && hpos+h7.len<=1024){
                            let c9:i32=0;
                            while(c9<h7.len){hbuf[hpos+c9]=h7[c9]; c9=c9+1;}
                            p32(fzh,fzhn*8,hpos);
                            p32(fzh,fzhn*8+4,h7.len);
                            hpos=hpos+h7.len;
                            fzhn=fzhn+1;
                        }
                    }
                }
                nio_free(ns7);
                s7=s7+1;
            }
            if(fzhn>=2){
                let s8:i32=0;
                while(s8<nst){
                    let so8:i32=g32(st,s8*12+4);
                    let sl8:i32=g32(st,s8*12+8);
                    let ns8:[]u8=normalize(buf[so8..so8+sl8]);
                    if(nio_equal(ns8,fs7)==1){
                        let pg8:i32=g32(st,s8*12);
                        let dq2:i32=0;
                        let q8:i32=0;
                        while(q8<ndw){if(g32(dw,q8*4)==pg8){dq2=1; break;} q8=q8+1;}
                        if(dq2==0 && ndw<64){p32(dw,ndw*4,pg8); ndw=ndw+1;}
                    }
                    nio_free(ns8);
                    s8=s8+1;
                }
            }
            nio_free(fzh);
            nio_free(hbuf);
            f7=f7+1;
        }
        if(ndw>0){
            let wc2:i32=0;
            let sh2:[]u8=nio_alloc(64*8);
            let shn2:i32=0;
            let hbuf2:[]u8=nio_alloc(4096);
            let hpos2b:i32=0;
            let m7:i32=0;
            while(m7<wc){
                let pg9:i32=g32(widx,m7*4);
                let dq3:i32=0;
                let q9:i32=0;
                while(q9<ndw){if(g32(dw,q9*4)==pg9){dq3=1; break;} q9=q9+1;}
                if(dq3==0){
                    wc2=wc2+1;
                    let h9:[]u8=host_of_idx(ha,ht,pg9);
                    if(h9.len>0 && shn2<64){
                        let dq4:i32=0;
                        let q10:i32=0;
                        while(q10<shn2){
                            let ho2:i32=g32(sh2,q10*8);
                            let hl2:i32=g32(sh2,q10*8+4);
                            if(hl2==h9.len && nio_equal(hbuf2[ho2..ho2+hl2],h9)==1){dq4=1; break;}
                            q10=q10+1;
                        }
                        if(dq4==0 && hpos2b+h9.len<=4096){
                            let c10:i32=0;
                            while(c10<h9.len){hbuf2[hpos2b+c10]=h9[c10]; c10=c10+1;}
                            p32(sh2,shn2*8,hpos2b);
                            p32(sh2,shn2*8+4,h9.len);
                            hpos2b=hpos2b+h9.len;
                            shn2=shn2+1;
                        }
                    }
                }
                m7=m7+1;
            }
            if(wc2<qneed || shn2<qneed){
                verdict_ok=0;
                furn_hit=1;
            }
            nio_free(sh2);
            nio_free(hbuf2);
        }
        nio_free(fz);
        nio_free(fa);
        nio_free(dw);
    }

    if(verdict_ok==1 && mode==1 && resultsp.len>0){
        // CORROB-1D: dissent check over non-opened result snippets
        let rok:i32=0;
        let rbuf:[]u8=read_path(resultsp,&rok);
        if(rok==1){
            let rpos:i32=0;
            let rls:i32=0;
            let rll:i32=0;
            let dfound:i32=0;
            let dpid:[]u8="";
            while(next_line(rbuf,&rpos,&rls,&rll)==1 && dfound==0){
                let rln:i32=rll;
                if(rln>0 && rbuf[rls+rln-1]==13){rln=rln-1;}
                if(rln>2 && rbuf[rls]==82 && rbuf[rls+1]==124){
                    let a2:i32=rls+2;
                    let b2:i32=a2;
                    while(b2<rls+rln && rbuf[b2]!=124){b2=b2+1;}
                    let c8:i32=b2;
                    if(c8<rls+rln){c8=c8+1;}
                    let d2:i32=c8;
                    while(d2<rls+rln && rbuf[d2]!=124){d2=d2+1;}
                    let e3:i32=d2;
                    if(e3<rls+rln){e3=e3+1;}
                    let rpid:[]u8=rbuf[a2..b2];
                    let snip:[]u8=rbuf[e3..rls+rln];
                    // is this pid opened?
                    let opened:i32=0;
                    let op:i32=0;
                    while(op<np){
                        let pp2:[]u8=pid_of(pa,pt,op);
                        if(nio_equal(pp2,rpid)==1){opened=1; break;}
                        op=op+1;
                    }
                    if(opened==0){
                        let ns:[]u8=normalize(snip);
                        if(contra_pair(wclaim,ns)==1){dfound=1; dpid=rpid;}
                        nio_free(ns);
                    }
                }
            }
            nio_free(rbuf);
            if(dfound==1){
                _zag_println("ANSWER|UNCHECKABLE");
                _zag_print("GATE|DISSENT|");
                _zag_println(dpid);
                verdict_ok=0;
            }
        }
    }
    // ch1: assertion-polarity veto (BEYOND challenger to HL-4). A non-claim
    // sentence sharing >=2 content words with the winning claim that carries
    // a polarity flipper (false/hoax/...) or an antonym predicate vetoes the
    // install: the page mentions the claim only to deny it.
    if(verdict_ok==1){
        let cwt:[]u8=nio_alloc(64*8);
        let cct:[]u8=nio_alloc(64*8);
        let cnw:i32=ch1_words_of(wclaim,cwt,64);
        let cnc:i32=ch1_content_words(wclaim,cwt,cnw,cct);
        let qi:i32=0;
        while(qi<nst && pol_veto==0){
            let qo:i32=g32(st,qi*12+4);
            let ql:i32=g32(st,qi*12+8);
            let sq:[]u8=normalize(buf[qo..qo+ql]);
            if(nio_equal(sq,wclaim)==0 && ch1_shared_cw(sq,wclaim,cct,cnc)>=2){
                let fw:[]u8=nio_alloc(64*8);
                let fnw:i32=ch1_words_of(sq,fw,64);
                let fk:i32=0;
                let ff:i32=0;
                while(fk<fnw){
                    if(ch1_flipper(ch1_word_at(sq,fw,fk))==1){ff=1; break;}
                    fk=fk+1;
                }
                nio_free(fw);
                if(ff==0){
                    if(ch1_has_word(wclaim,"open")==1 && (ch1_has_word(sq,"locked")==1 || ch1_has_word(sq,"closed")==1)){ff=1;}
                    if(ch1_has_word(wclaim,"locked")==1 && ch1_has_word(sq,"open")==1){ff=1;}
                }
                if(ff==1){pol_veto=1;}
            }
            nio_free(sq);
            qi=qi+1;
        }
        nio_free(cwt);
        nio_free(cct);
        if(pol_veto==1){verdict_ok=0;}
    }
    if(verdict_ok==1){
        _zag_print("ANSWER|");
        _zag_println(wclaim);
        _zag_print("CLAIM|1|");
        _zag_print(wclaim);
        _zag_print("|");
        print_pids(pa,pt,widx,wc);
        _zag_println("");
        m5=0;
        while(m5<wc){
            _zag_print("PROV|1|");
            _zag_println(pid_of(pa,pt,g32(widx,m5*4)));
            m5=m5+1;
        }
    }else{
        if(conun==0){
            _zag_println("ANSWER|UNCHECKABLE");
            if(pol_veto==1){
                _zag_print("GATE|POLARITY|");
                print_pids(pa,pt,widx,wc);
                _zag_println("");
            }else if(furn_hit==1){
                _zag_print("GATE|FURNITURE|");
                print_pids(pa,pt,widx,wc);
                _zag_println("");
            }else if(wc<qneed){
                _zag_print("GATE|QUORUM|");
                print_pids(pa,pt,widx,wc);
                _zag_println("");
            }else{
                _zag_print("GATE|SRC_INDEPENDENCE|");
                print_pids(pa,pt,widx,wc);
                _zag_println("");
            }
        }
    }
    nio_free(buf);
    nio_free(pa);
    nio_free(pt);
    nio_free(ha);
    nio_free(ht);
    nio_free(tt);
    nio_free(st);
    nio_free(qlow);
    nio_free(qt);
    nio_free(cidx);
    nio_free(ca);
    nio_free(ct);
    nio_free(cpg);
    nio_free(keep);
    nio_free(cona);
    nio_free(conu);
    nio_free(ck);
    nio_free(cc);
    nio_free(cm);
    nio_free(widx);
    nio_free(seen_h);
    nio_free(seen_t);
    nio_free(tta);
    return 0;
}

// ---------- tier1 driver ----------
// Modes: norm | pages (=ingest) | verdict (HL-1..HL-4, quorum 2) |
//        verdict3 (HL-5, quorum >=3 distinct registrable domains).
// The verdict H| key is the eTLD+1 registrable-domain origin emitted by
// `pages`; empty/missing H| fails closed (never counts toward quorum).
fn main()i32 {
    let lit:[]u8=psl_literal();
    let psl:[]u8=nio_alloc(256*12);
    let cft:[]u8=nio_alloc(128*8);
    let scratch:[]u8=nio_alloc(16384);
    let arena:[]u8=nio_alloc(65536);
    if(psl.len==0 || cft.len==0 || scratch.len==0 || arena.len==0){
        _zag_println("ERR alloc");
        return 2;
    }
    let psln:i32=psl_init(psl);
    let cfn:i32=conf_init(cft);
    let m:[]u8=_zag_arg(1);
    let rc:i32=2;
    if(nio_equal(m,"norm")==1){
        let fp:[]u8=_zag_arg(2);
        if(fp.len>0){rc=cmd_norm(fp,scratch,arena,psl,psln,lit,cft,cfn);}
        else{_zag_println("usage: tier1 norm <urlfile>");}
    }else{
        if(nio_equal(m,"pages")==1 || nio_equal(m,"ingest")==1){
            let inf:[]u8=_zag_arg(2);
            let outf:[]u8=_zag_arg(3);
            if(inf.len>0 && outf.len>0){rc=cmd_pages(inf,outf,scratch,arena,psl,psln,lit,cft,cfn);}
            else{_zag_println("usage: tier1 pages <infile> <outfile>");}
        }else{
            if(nio_equal(m,"verdict")==1){
                let pp:[]u8=_zag_arg(2);
                let qy:[]u8=_zag_arg(3);
                if(pp.len>0 && qy.len>0){rc=run_verdict(pp,qy,"",0);}
                else{_zag_println("usage: tier1 verdict <pages> <query>");}
            }else{
                if(nio_equal(m,"verdict3")==1){
                    let pp2:[]u8=_zag_arg(2);
                    let qy2:[]u8=_zag_arg(3);
                    if(pp2.len>0 && qy2.len>0){rc=run_verdict(pp2,qy2,"",3);}
                    else{_zag_println("usage: tier1 verdict3 <pages> <query>");}
                }else{
                    _zag_println("usage: tier1 norm|pages|ingest|verdict|verdict3");
                }
            }
        }
    }
    nio_free(psl);
    nio_free(cft);
    nio_free(scratch);
    nio_free(arena);
    return rc;
}

// expansion.zag — faithful minimal teach/query/select/verdict runner with
// candidate-set expansion (LI-HARDEN round 3, Crew A).
//
// Pipeline: case file -> retrieved candidate set (PAGE|pid|score|claim) ->
// select top SELECT-N by (score desc, pid asc) -> verdict over the visible
// set -> if the visible quorum is UNANIMOUS, expand one tier past the
// selection cut (cut-tier stragglers + first EXPAND-TIERS score bands below
// the cut tier) and run the round-2 dissent scanner hdissent() over the
// union. Any FIRE -> hidden_dissent=1, verdict WITHHOLD|HIDDEN-DISSENT.
//
// Pure Zag, zero RNG, deterministic. Usage:
//   expansion <case.flat.txt> [depth_override]
// depth_override (optional): replaces the file's EXPAND-TIERS line; ""
// absent means use the file value. Used for the depth sweep.
@import("R33_NATIVE_IO_V1.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){
        if(s.len==1){return "";}
        return s[0..s.len-1];
    }
    return s;
}

fn next_line(b:[]u8,pos:*i32,ls:*i32,ll:*i32)i32 {
    if(pos[0]>=b.len){return 0;}
    let s:i32=pos[0];
    let e:i32=s;
    while(e<b.len && b[e]!=10){e=e+1;}
    ls[0]=s;
    ll[0]=e-s;
    if(e<b.len){pos[0]=e+1;}else{pos[0]=e;}
    return 1;
}

fn read_file(dir:[]u8,name:[]u8,ok:*i32)[]u8 {
    ok[0]=0;
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let buf:[]u8=nio_alloc(1048576);
    if(buf.len==0){nio_close(fd); return "";}
    let n:i64=nio_read_exact(fd,buf,1048575);
    nio_close(fd);
    if(n<0){nio_free(buf); return "";}
    ok[0]=1;
    let nn:i32=n as i32;
    return buf[0..nn];
}

fn read_path(path:[]u8,ok:*i32)[]u8 {
    let k:i32=path.len-1;
    while(k>=0 && path[k]!=47){k=k-1;}
    if(k<0){return read_file(".",path,ok);}
    let dir:[]u8=path[0..k];
    let name:[]u8=path[k+1..path.len];
    if(k==0){dir="/";}
    return read_file(dir,name,ok);
}

fn starts(h:[]u8,pre:[]u8)i32 {
    if(h.len<pre.len){return 0;}
    return nio_equal(h[0..pre.len],pre);
}

fn index_of(h:[]u8,n:[]u8,from:i32)i32 {
    if(n.len==0){return from;}
    let i:i32=from;
    while(i+n.len<=h.len){
        if(nio_equal(h[i..i+n.len],n)==1){return i;}
        i=i+1;
    }
    return -1;
}

fn lower(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let i:i32=0;
    while(i<s.len){
        let b:i32=s[i] as i32;
        if(b>=65 && b<=90){o[i]=(b+32) as u8;}else{o[i]=s[i];}
        i=i+1;
    }
    return o[0..s.len];
}

fn cmp_slice(a:[]u8,b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){n=b.len;}
    let i:i32=0;
    while(i<n){
        if(a[i]!=b[i]){
            if(a[i]<b[i]){return -1;}
            return 1;
        }
        i=i+1;
    }
    if(a.len==b.len){return 0;}
    if(a.len<b.len){return -1;}
    return 1;
}

fn atoi(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<s.len){
        let b:i32=s[i] as i32;
        if(b>=48 && b<=57){v=v*10+(b-48);}
        i=i+1;
    }
    return v;
}

fn is_numtok(t:[]u8)i32 {
    if(t.len==0){return 0;}
    let i:i32=0;
    while(i<t.len){
        let b:i32=t[i] as i32;
        if(b<48 || b>57){return 0;}
        i=i+1;
    }
    return 1;
}

fn is_conn(t:[]u8)i32 {
    if(nio_equal(t,"to")==1){return 1;}
    if(nio_equal(t,"and")==1){return 1;}
    if(nio_equal(t,"between")==1){return 1;}
    if(nio_equal(t,"from")==1){return 1;}
    return 0;
}

fn frametok(s:[]u8)[]u8 {
    let o:[]u8=nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let w:i32=0;
    let i:i32=0;
    while(i<=s.len){
        let e:i32=i;
        while(e<s.len && s[e]!=32){e=e+1;}
        let t:[]u8=s[i..e];
        if(t.len>1 && t[t.len-1]==46){t=t[0..t.len-1];}
        if(t.len>0 && is_numtok(t)==0 && is_conn(t)==0){
            let k:i32=0;
            while(k<t.len){o[w]=t[k]; w=w+1; k=k+1;}
            o[w]=32; w=w+1;
        }
        i=e+1;
    }
    return o[0..w];
}

// field f of '|' separated line; writes start offset (relative to ln) and
// length to os/ol, returns the slice
fn fieldx(ln:[]u8,f:i32,os:*i32,ol:*i32)[]u8 {
    let i:i32=0;
    let cur:i32=0;
    let s:i32=0;
    while(i<=ln.len){
        let atend:i32=0;
        if(i==ln.len){atend=1;}
        let isbar:i32=0;
        if(atend==0){
            if(ln[i]==124){isbar=1;}
        }
        if(atend==1 || isbar==1){
            if(cur==f){os[0]=s; ol[0]=i-s; return ln[s..i];}
            cur=cur+1;
            s=i+1;
        }
        i=i+1;
    }
    os[0]=0; ol[0]=0;
    return "";
}

// hidden-claim vs winning-claim dissent test, ported from wallsel.zag
// (round-2 measured baseline). 1=dissent found.
fn hdissent(wc:[]u8,hc:[]u8)i32 {
    let w:[]u8=lower(wc);
    let h:[]u8=lower(hc);
    if(nio_equal(w,h)==1){return 0;}
    // (a) numeric frame
    let fw:[]u8=frametok(w);
    let fh:[]u8=frametok(h);
    if(nio_equal(fw,fh)==1){return 1;}
    // (b) shared prefix up to " is "
    let iw:i32=index_of(w," is ",0);
    let ih:i32=index_of(h," is ",0);
    if(iw>0 && ih>0 && iw==ih && nio_equal(w[0..iw],h[0..ih])==1){return 1;}
    // (c) shared suffix from " is the "
    let sw:i32=index_of(w," is the ",0);
    let sh:i32=index_of(h," is the ",0);
    if(sw>0 && sh>0 && nio_equal(w[sw..w.len],h[sh..h.len])==1){return 1;}
    return 0;
}

// []u8 arena i32 accessors (little-endian), 4 bytes per slot
fn t_put32(a:[]u8,i:i32,v:i32)void {
    let x:i64=v as i64;
    a[i*4]=(x & 255) as u8;
    a[i*4+1]=((x>>8) & 255) as u8;
    a[i*4+2]=((x>>16) & 255) as u8;
    a[i*4+3]=((x>>24) & 255) as u8;
}

fn t_get32(a:[]u8,i:i32)i32 {
    let b0:i64=a[i*4] as i64;
    let b1:i64=a[i*4+1] as i64;
    let b2:i64=a[i*4+2] as i64;
    let b3:i64=a[i*4+3] as i64;
    return (b0 | (b1<<8) | (b2<<16) | (b3<<24)) as i32;
}

fn main()i32 {
    let path:[]u8=_zag_arg(1);
    let ov:[]u8=_zag_arg(2);
    if(path.len==0){_zag_print("usage: expansion <case.flat.txt> [depth]\n"); return 2;}
    let ok:i32=0;
    let pok:*i32=&ok;
    let buf:[]u8=read_path(path,pok);
    if(ok==0){_zag_print("ERR|cannot read file\n"); return 1;}

    // page storage: 64 pages max (build-local buffer, see DERIVATION.md)
    let ppos:[]u8=nio_alloc(64*4);
    let plen:[]u8=nio_alloc(64*4);
    let cpos:[]u8=nio_alloc(64*4);
    let clen:[]u8=nio_alloc(64*4);
    let pscore:[]u8=nio_alloc(64*4);
    let np:i32=0;
    let casename:[]u8="case";
    let seln:i32=3;
    let depth:i32=1;

    let pos:i32=0; let ls:i32=0; let ll:i32=0;
    let ppos2:*i32=&pos; let pls:*i32=&ls; let pll:*i32=&ll;
    while(next_line(buf,ppos2,pls,pll)==1){
        let ln:[]u8=buf[ls..ls+ll];
        if(ln.len==0){continue;}
        if(starts(ln,"CASE|")==1){casename=ln[5..ln.len]; continue;}
        if(starts(ln,"SELECT-N|")==1){seln=atoi(ln[9..ln.len]); continue;}
        if(starts(ln,"EXPAND-TIERS|")==1){depth=atoi(ln[12..ln.len]); continue;}
        if(starts(ln,"PAGE|")==1 && np<64){
            let fo:i32=0; let fl:i32=0;
            let pfos:*i32=&fo; let pfl:*i32=&fl;
            let pid:[]u8=fieldx(ln,1,pfos,pfl);
            let po:i32=fo; let pl2:i32=fl;
            let sc:[]u8=fieldx(ln,2,pfos,pfl);
            let cl:[]u8=fieldx(ln,3,pfos,pfl);
            let co:i32=fo; let cl2:i32=fl;
            t_put32(ppos,np,ls+po);
            t_put32(plen,np,pl2);
            t_put32(pscore,np,atoi(sc));
            t_put32(cpos,np,ls+co);
            t_put32(clen,np,cl2);
            np=np+1;
            continue;
        }
    }
    if(np==0){_zag_print("ERR|no pages\n"); return 1;}
    if(ov.len>0){depth=atoi(ov);}
    if(seln<1){seln=1;}
    if(depth<0){depth=0;}

    // order: page indices sorted by (score desc, pid asc)
    let ord:[]u8=nio_alloc(64);
    let i:i32=0;
    while(i<np){ord[i]=i as u8; i=i+1;}
    // selection sort
    let a:i32=0;
    while(a<np){
        let b:i32=a+1;
        while(b<np){
            let ia:i32=ord[a] as i32;
            let ib:i32=ord[b] as i32;
            let sa:i32=t_get32(pscore,ia);
            let sb:i32=t_get32(pscore,ib);
            let swap:i32=0;
            if(sb>sa){swap=1;}
            if(sb==sa){
                let pa:[]u8=buf[t_get32(ppos,ia)..t_get32(ppos,ia)+t_get32(plen,ia)];
                let pb:[]u8=buf[t_get32(ppos,ib)..t_get32(ppos,ib)+t_get32(plen,ib)];
                if(cmp_slice(pb,pa)<0){swap=1;}
            }
            if(swap==1){let t:u8=ord[a]; ord[a]=ord[b]; ord[b]=t;}
            b=b+1;
        }
        a=a+1;
    }

    let nvis:i32=seln;
    if(nvis>np){nvis=np;}

    // unanimity over the visible set
    let v0:i32=ord[0] as i32;
    let wclaim:[]u8=buf[t_get32(cpos,v0)..t_get32(cpos,v0)+t_get32(clen,v0)];
    let lw:[]u8=lower(wclaim);
    let unanimous:i32=1;
    let k:i32=1;
    while(k<nvis){
        let vk:i32=ord[k] as i32;
        let ck:[]u8=buf[t_get32(cpos,vk)..t_get32(cpos,vk)+t_get32(clen,vk)];
        if(nio_equal(lower(ck),lw)==0){unanimous=0;}
        k=k+1;
    }

    // visible pid list (for logging)
    if(unanimous==0){
        _zag_print("SEL|");
        _zag_print(casename);
        _zag_print("|depth=");
        _zag_print(i64s(depth as i64));
        _zag_print("|visible=");
        let q:i32=0;
        while(q<nvis){
            let vq:i32=ord[q] as i32;
            if(q>0){_zag_print(",");}
            _zag_print(buf[t_get32(ppos,vq)..t_get32(ppos,vq)+t_get32(plen,vq)]);
            q=q+1;
        }
        _zag_print("|expansion=SKIPPED|reason=not-unanimous\n");
        _zag_print("VERDICT|");
        _zag_print(casename);
        _zag_print("|pre=WITHHOLD|CONTRADICTION|post=UNCHANGED\n");
        return 0;
    }

    // cut tier = score band of the lowest visible page
    let vlast:i32=ord[nvis-1] as i32;
    let cut:i32=t_get32(pscore,vlast);

    // expansion: stragglers (non-visible, score == cut) + first `depth`
    // distinct score bands strictly below cut
    let inexp:[]u8=nio_alloc(64);
    let e:i32=0;
    while(e<np){inexp[e]=0; e=e+1;}
    e=0;
    while(e<np){
        let pe:i32=ord[e] as i32;
        if(e>=nvis && t_get32(pscore,pe)==cut){inexp[pe]=1;}
        e=e+1;
    }
    // collect distinct scores below cut, descending
    let bands:[]u8=nio_alloc(64*4);
    let nb:i32=0;
    e=0;
    while(e<np){
        let pe2:i32=ord[e] as i32;
        if(e>=nvis){
            let s2:i32=t_get32(pscore,pe2);
            if(s2<cut){
                let f:i32=0;
                let seen:i32=0;
                while(f<nb){
                    if(t_get32(bands,f)==s2){seen=1;}
                    f=f+1;
                }
                if(seen==0){t_put32(bands,nb,s2); nb=nb+1;}
            }
        }
        e=e+1;
    }
    // sort bands desc (selection sort)
    let ba:i32=0;
    while(ba<nb){
        let bb:i32=ba+1;
        while(bb<nb){
            if(t_get32(bands,bb)>t_get32(bands,ba)){
                let t2:i32=t_get32(bands,ba);
                t_put32(bands,ba,t_get32(bands,bb));
                t_put32(bands,bb,t2);
            }
            bb=bb+1;
        }
        ba=ba+1;
    }
    let taken:i32=0;
    let bi:i32=0;
    while(bi<nb && taken<depth){
        let bv:i32=t_get32(bands,bi);
        e=0;
        while(e<np){
            let pe3:i32=ord[e] as i32;
            if(e>=nvis && t_get32(pscore,pe3)==bv){inexp[pe3]=1;}
            e=e+1;
        }
        taken=taken+1;
        bi=bi+1;
    }

    // dissent scan over the expansion union (non-visible members)
    let found:i32=0;
    e=0;
    while(e<np){
        let pe4:i32=ord[e] as i32;
        if(e>=nvis && inexp[pe4]==1){
            let hc:[]u8=buf[t_get32(cpos,pe4)..t_get32(cpos,pe4)+t_get32(clen,pe4)];
            if(hdissent(wclaim,hc)==1){found=1;}
        }
        e=e+1;
    }

    let opened:i32=nvis;
    e=0;
    while(e<np){if(inexp[e]==1){opened=opened+1;} e=e+1;}

    _zag_print("SEL|");
    _zag_print(casename);
    _zag_print("|depth=");
    _zag_print(i64s(depth as i64));
    _zag_print("|visible=");
    let q2:i32=0;
    while(q2<nvis){
        let vq2:i32=ord[q2] as i32;
        if(q2>0){_zag_print(",");}
        _zag_print(buf[t_get32(ppos,vq2)..t_get32(ppos,vq2)+t_get32(plen,vq2)]);
        q2=q2+1;
    }
    _zag_print("|cut_tier=");
    _zag_print(i64s(cut as i64));
    _zag_print("|expanded=");
    let first:i32=1;
    e=0;
    while(e<np){
        let pe5:i32=ord[e] as i32;
        if(e>=nvis && inexp[pe5]==1){
            if(first==0){_zag_print(",");}
            _zag_print(buf[t_get32(ppos,pe5)..t_get32(ppos,pe5)+t_get32(plen,pe5)]);
            first=0;
        }
        e=e+1;
    }
    _zag_print("|opened=");
    _zag_print(i64s(opened as i64));
    _zag_print("|hidden_dissent=");
    _zag_print(i64s(found as i64));
    _zag_print("\n");
    _zag_print("VERDICT|");
    _zag_print(casename);
    _zag_print("|pre=INSTALL|post=");
    if(found==1){_zag_print("WITHHOLD|HIDDEN-DISSENT\n");}else{_zag_print("INSTALL\n");}
    return 0;
}

// mw_trial_c.zag — arm-C trial driver.
// Usage: mw_trial_c <c>
//   c: arm C (deliberation + PRIMARY source-authority rule, mw_sense_c)
// Per-question run/check functions are GENERATED (mw_cases_c.zag).
// Deterministic: no timestamps, no RNG. N=5 replays must be byte-identical.

@import("mw_sense_c.zag")
@import("mw_cases_c.zag")

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(mw_equal(m,"c")==1){
        let p:i32=run_c_all();
        if(p==1){_zag_println("C|ALL_CHECKS_PASS");}
        if(p!=1){_zag_println("C|CHECKS_FAILED");}
        if(p==1){return 0;}
        return 1;
    }
    _zag_println("usage: mw_trial_c <c>");
    return 2;
}

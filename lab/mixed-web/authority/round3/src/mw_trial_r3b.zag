// mw_trial_r3b.zag — round-3 arm-B trial driver.
// Usage: mw_trial_r3b <b>
// Deterministic: no timestamps, no RNG. N=5 replays byte-identical.
@import("mw_sense.zag")
@import("mw_cases_r3b.zag")

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(mw_equal(m,"b")==1){
        let p:i32=run_r3b_all();
        if(p==1){_zag_println("B|ALL_CHECKS_PASS");}
        if(p!=1){_zag_println("B|CHECKS_FAILED");}
        if(p==1){return 0;}
        return 1;
    }
    _zag_println("usage: mw_trial_r3b <b>");
    return 2;
}

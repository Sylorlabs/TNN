// tp_trial.zag — S1 third-path head-to-head decision engine.
// FROZEN logic per PREREG-TP1 (commit 44afdbefc168edddcae50e9dd91eac12cd9fa156).
// Pure Zag, zero RNG. Three paths x four thresholds over 220 frozen envelopes.

@import("R33_NATIVE_SHA256_V2.zag")

struct TpW {
    qid:[]u8, prim:i32, rel:i32, gold:i32, latent:i32,
    d0:i32, a0:i32, y0:i32,
    d1:i32, a1:i32, y1:i32,
    d2:i32, a2:i32, y2:i32,
    d3:i32, a3:i32, y3:i32,
    n:i32
}

struct TpL {
    p0:[]u8, p1:[]u8, p2:[]u8,
    s0:i64, s1:i64, s2:i64,
    n1:i32, n2:i32, n3:i32, n0:i32
}

fn tp_alloc(n:i32)[]u8 {
    let b:[]u8=nio_alloc(n);
    return b;
}

fn tp_new() *TpW {
    let w:*TpW=_zag_malloc(256) as *TpW;
    w.*.n=0;
    w.*.prim=0;
    w.*.rel=-1;
    w.*.gold=-1;
    w.*.latent=-1;
    return w;
}

fn tp_begin(w:*TpW,qid:[]u8,prim:i32,rel:i32,gold:i32,latent:i32) void {
    w.*.qid=qid;
    w.*.prim=prim;
    w.*.rel=rel;
    w.*.gold=gold;
    w.*.latent=latent;
    w.*.n=0;
    return;
}

fn tp_row(w:*TpW,d:i32,a:i32,y:i32) void {
    let n:i32=w.*.n;
    if(n==0){w.*.d0=d;w.*.a0=a;w.*.y0=y;}
    if(n==1){w.*.d1=d;w.*.a1=a;w.*.y1=y;}
    if(n==2){w.*.d2=d;w.*.a2=a;w.*.y2=y;}
    if(n==3){w.*.d3=d;w.*.a3=a;w.*.y3=y;}
    w.*.n=n+1;
    return;
}

fn tp_lg_new() *TpL {
    let lg:*TpL=_zag_malloc(160) as *TpL;
    let z0:[]u8=tp_alloc(32);
    let z1:[]u8=tp_alloc(32);
    let z2:[]u8=tp_alloc(32);
    let i:i32=0;
    while(i<32){z0[i]=0;z1[i]=0;z2[i]=0;i=i+1;}
    lg.*.p0=z0;
    lg.*.p1=z1;
    lg.*.p2=z2;
    lg.*.s0=0;
    lg.*.s1=0;
    lg.*.s2=0;
    lg.*.n1=0;
    lg.*.n2=0;
    lg.*.n3=0;
    lg.*.n0=0;
    return lg;
}

fn tp_copy(dst:[]u8,o:i32,src:[]u8) void {
    let i:i32=0;
    while(i<src.len){dst[o+i]=src[i];i=i+1;}
    return;
}

// own decimal formatter (avoids _zag_i64_to_str helper-newline quirk)
fn tp_i32(v:i32)[]u8 {
    let b:[]u8=tp_alloc(12);
    let neg:i32=0;
    let x:i32=v;
    if(x<0){neg=1;x=0-x;}
    if(x==0){b[10]=48;return b[10..11];}
    let p:i32=11;
    while(x>0){
        let dg:i32=x-((x/10)*10);
        p=p-1;
        b[p]=(dg+48) as u8;
        x=x/10;
    }
    if(neg==1){p=p-1;b[p]=45;}
    return b[p..11];
}

fn tp_lg_add(lg:*TpL,path:i32,thou:i32,qid:[]u8,dec:[]u8,ch:[]u8,rule:[]u8) void {
    let n:i32=32+8+1+4+qid.len+1+dec.len+1+ch.len+1+rule.len+1;
    let e:[]u8=tp_alloc(n);
    let o:i32=0;
    let pv:[]u8=lg.*.p0;
    if(path==1){pv=lg.*.p1;}
    if(path==2){pv=lg.*.p2;}
    tp_copy(e,o,pv);
    o=o+32;
    let s:i64=lg.*.s0;
    if(path==1){s=lg.*.s1;}
    if(path==2){s=lg.*.s2;}
    let k:i32=0;
    while(k<8){e[o+k]=((s>>(k*8))&255) as u8;k=k+1;}
    o=o+8;
    e[o]=path as u8;
    o=o+1;
    let k2:i32=0;
    while(k2<4){e[o+k2]=((thou>>(k2*8))&255) as u8;k2=k2+1;}
    o=o+4;
    tp_copy(e,o,qid);o=o+qid.len;e[o]=0;o=o+1;
    tp_copy(e,o,dec);o=o+dec.len;e[o]=0;o=o+1;
    tp_copy(e,o,ch);o=o+ch.len;e[o]=0;o=o+1;
    tp_copy(e,o,rule);o=o+rule.len;e[o]=0;o=o+1;
    let nh:[]u8=tp_alloc(32);
    let rc:i32=ns_sha256(e,nh);
    if(rc!=0){_zag_print("SHAFAIL\n");}
    let j:i32=0;
    while(j<32){pv[j]=nh[j];j=j+1;}
    if(path==0){lg.*.s0=s+1;}
    if(path==1){lg.*.s1=s+1;}
    if(path==2){lg.*.s2=s+1;}
    return;
}

// shape classifier. returns 1=S1_UNCORR, 2=S8_TIE, 3=CORROB, 0=OTHER.
// pn.* = primary's newest answer id (or -1).
fn tp_classify(w:*TpW,pn:*i32) i32 {
    pn.*=-1;
    if(w.*.n!=4){return 0;}
    let y0:i32=w.*.y0;
    let y1:i32=w.*.y1;
    let y2:i32=w.*.y2;
    let y3:i32=w.*.y3;
    let maxy:i32=y0;
    if(y1>maxy){maxy=y1;}
    if(y2>maxy){maxy=y2;}
    if(y3>maxy){maxy=y3;}
    let prim:i32=w.*.prim;
    let pna:i32=-1;
    if(y0==maxy){if(w.*.d0==prim){pna=w.*.a0;}}
    if(y1==maxy){if(w.*.d1==prim){pna=w.*.a1;}}
    if(y2==maxy){if(w.*.d2==prim){pna=w.*.a2;}}
    if(y3==maxy){if(w.*.d3==prim){pna=w.*.a3;}}
    if(pna==-1){return 0;}
    pn.*=pna;
    let b0:i32=-1;
    let b1:i32=-1;
    let b2:i32=-1;
    let b3:i32=-1;
    if(y0==maxy){b0=w.*.a0;}
    if(y1==maxy){b1=w.*.a1;}
    if(y2==maxy){b2=w.*.a2;}
    if(y3==maxy){b3=w.*.a3;}
    let nmax:i32=0;
    if(b0!=-1){nmax=nmax+1;}
    if(b1!=-1){nmax=nmax+1;}
    if(b2!=-1){nmax=nmax+1;}
    if(b3!=-1){nmax=nmax+1;}
    let na:i32=0;
    if(b0!=-1){na=1;}
    if(b1!=-1){
        let seen:i32=0;
        if(b1==b0){seen=1;}
        if(seen==0){na=na+1;}
    }
    if(b2!=-1){
        let seen2:i32=0;
        if(b2==b0){seen2=1;}
        if(b2==b1){seen2=1;}
        if(seen2==0){na=na+1;}
    }
    if(b3!=-1){
        let seen3:i32=0;
        if(b3==b0){seen3=1;}
        if(b3==b1){seen3=1;}
        if(b3==b2){seen3=1;}
        if(seen3==0){na=na+1;}
    }
    let nps:i32=0;
    if(b0==pna){nps=nps+1;}
    if(b1==pna){nps=nps+1;}
    if(b2==pna){nps=nps+1;}
    if(b3==pna){nps=nps+1;}
    if(na==3){
        if(nmax==3){
            if(nps==1){return 1;}
        }
        return 0;
    }
    if(na==2){
        if(nmax==4){
            if(nps==2){return 2;}
            return 0;
        }
        if(nps>=2){return 3;}
        return 0;
    }
    if(nps>=2){return 3;}
    return 0;
}

fn tp_pname(path:i32)[]u8 {
    if(path==1){return "T2";}
    if(path==2){return "T3";}
    return "T1";
}

fn tp_one(w:*TpW,lg:*TpL,path:i32,thou:i32,shape:i32,pna:i32) void {
    let dec:[]u8="WITHHOLD";
    let ch:[]u8="-1";
    let rule:[]u8="OOS";
    if(shape==1){
        if(path==0){
            if(w.*.rel>=0){
                if(w.*.rel>=thou){dec="CONVERGE";ch=tp_i32(pna);rule="T1-GATE";}
                else{rule="T1-GATE-BLOCK";}
            }
            else{rule="T1-NOREL";}
        }
        if(path==1){rule="T2-SUSPECT";}
        if(path==2){
            if(w.*.rel>=0){
                if(w.*.rel>=thou){dec="CONVERGE";ch=tp_i32(pna);rule="T3-DELIB-GATE";}
                else{rule="T3-DELIB-WITHHOLD";}
            }
            else{rule="T3-DELIB-WITHHOLD";}
        }
    }
    if(shape==2){
        if(path==0){rule="T1-TIEGUARD";}
        if(path==1){rule="T2-SUSPECT";}
        if(path==2){rule="T3-TIEGUARD";}
    }
    if(shape==3){rule="OOS-CORROB";}
    _zag_print("P|");
    _zag_print(tp_pname(path));
    _zag_print("|");
    _zag_print(tp_i32(thou));
    _zag_print("|");
    _zag_print(w.*.qid);
    _zag_print("|");
    _zag_print(dec);
    _zag_print("|");
    _zag_print(ch);
    _zag_print("|");
    _zag_println(rule);
    tp_lg_add(lg,path,thou,w.*.qid,dec,ch,rule);
    return;
}

fn tp_decide(w:*TpW,lg:*TpL) void {
    let pna:i32=-1;
    let shape:i32=tp_classify(w,&pna);
    if(shape==1){lg.*.n1=lg.*.n1+1;}
    if(shape==2){lg.*.n2=lg.*.n2+1;}
    if(shape==3){lg.*.n3=lg.*.n3+1;}
    if(shape==0){lg.*.n0=lg.*.n0+1;}
    let ti:i32=0;
    while(ti<4){
        let thou:i32=500;
        if(ti==1){thou=667;}
        if(ti==2){thou=750;}
        if(ti==3){thou=833;}
        let pi:i32=0;
        while(pi<3){
            tp_one(w,lg,pi,thou,shape,pna);
            pi=pi+1;
        }
        ti=ti+1;
    }
    return;
}

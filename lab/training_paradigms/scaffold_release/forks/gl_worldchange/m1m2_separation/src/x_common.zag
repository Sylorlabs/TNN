// x_common.zag — Workstream A shared driver helpers. No main, no imports.
// Follows ~/AGENTS.md znc lessons: i64->string helpers RETURN the slice;
// only main prints (avoids the helper-print trailing-newline quirk).

// xi64s: decimal string of v with one trailing byte-10 stripped if present.
fn xi64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}

// xp_i32: parse a decimal _zag_arg string ("" -> 0). argc is always 0 in
// this znc build: callers read _zag_arg(n) unconditionally.
fn xp_i32(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:i32=s[i] as i32;
        if(c>=48 && c<=57){v=v*10+(c-48);}
        i=i+1;
    }
    return v;
}

// x_scan_count: exact replay of m2_derive_taught's ledger scan, counting
// loop iterations (word-reads) instead of returning the episode. Run over
// the actual produced ledger at the moment M2's binary executed the scan,
// so the count is M2's real derivation cost made explicit.
fn x_scan_count(abuf:[]u8,n:i32,k:i32,old:i32)i32 {
    let reads:i32=0;
    let i:i32=0;
    while(i+1<n){
        reads=reads+1;
        if(tn_g32(abuf,i*16+4)==TN_OP_EPISODE){
            let etype:i32=tn_g32(abuf,i*16+8);
            let ek:i32=tn_g32(abuf,i*16+12);
            if((etype==WC_TEACH || etype==WC_UPDATE) && ek==k){
                if(tn_g32(abuf,(i+1)*16+4)==TN_OP_TEACH && tn_g32(abuf,(i+1)*16+12)==old){
                    return reads;
                }
            }
        }
        i=i+1;
    }
    return reads;
}

// ecf: fill one WcEp (fields at 8-byte stride; caller reuses wc_ep_alloc).
fn ecf(w:*WcEp,ep:i32,etype:i32,key:i32,val:i32,aux:i32)void {
    w.*.ep=ep;
    w.*.etype=etype;
    w.*.key=key;
    w.*.val=val;
    w.*.aux=aux;
    return;
}

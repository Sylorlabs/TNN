// dz.zag — G5 DIALOGUE substrate: dialogue withholding items, evidence,
// derivation rules R1..R5, candidate policies, audited ops.
//
// The task: given a claim (attr, asserted value) plus a small evidence set,
// ANSWER with the verdict when the evidence resolves the claim (directly or
// via R1..R5 chains), WITHHOLD when it cannot (missing info or conflict).
// The learner's naive default is ALWAYS-ANSWER.
//
// Design laws (enforced by the runner's static checks, not just comments):
//   - No RNG anywhere: learner, world, harness.
//   - Fork: the teacher's demonstration is contradiction evidence only —
//     never a parameter to action selection (f_select takes no demo and no
//     answer-key parameter; static token scan on F-SELECT-REGION).
//   - Baseline: acts from its installed rule only (BASE-ACT-REGION has no
//     demo/correct token).

const DZ_OK:i32=0;
const DZ_BAD:i32=-370101;
const DZ_AUDIT_FULL:i32=-370105;

const DZ_OP_EPISODE:i32=1;
const DZ_OP_TEACH:i32=2;
const DZ_OP_CALIBRATE:i32=3;
const DZ_OP_INSTALL:i32=4;
const DZ_OP_GATE_WITHHOLD:i32=5;
const DZ_OP_REFUSE:i32=6;
const DZ_OP_DEMO:i32=7;
const DZ_OP_ELIMINATE:i32=8;
const DZ_OP_COMMIT:i32=9;
const DZ_OP_UNCOMMIT:i32=10;
const DZ_OP_ACTION:i32=11;

const DZ_SUP:i32=0;
const DZ_REF:i32=1;
const DZ_WITH:i32=2;

const DZ_P0:i32=0;
const DZ_P1:i32=1;
const DZ_P2:i32=2;
const DZ_P3:i32=3;
const DZ_P4:i32=4;
const DZ_NP:i32=5;
const DZ_UNCONNECTED:i32=255;

const DZ_AUDIT_CAP:i32=4096;
const DZ_EPISODES:i32=128;
const DZ_FAIL:i32=-1000000;
const DZ_CONFLICT:i32=-2000000;

fn dz_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn dz_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn dz_g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn dz_s32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

// Audit entry: 16 bytes = step, op, slot1, aux. Fail-closed.
fn dz_audit(abuf:[]u8,acount:*i32,step:i32,op:i32,slot1:i32,aux:i32)i32 {
    if(acount==null as *i32){return DZ_BAD;}
    let n:i32=acount.*;
    if(n<0 || n>=DZ_AUDIT_CAP){return DZ_AUDIT_FULL;}
    if(abuf.len<(n+1)*16){return DZ_BAD;}
    dz_s32(abuf,n*16,step);
    dz_s32(abuf,n*16+4,op);
    dz_s32(abuf,n*16+8,slot1);
    dz_s32(abuf,n*16+12,aux);
    acount.*=n+1;
    return DZ_OK;
}

fn dz_audit_count_op(abuf:[]u8,n:i32,op:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(dz_g32(abuf,i*16+4)==op){c=c+1;}i=i+1;}
    return c;
}

fn dz_audit_count_op_step(abuf:[]u8,n:i32,op:i32,step:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(dz_g32(abuf,i*16+4)==op && dz_g32(abuf,i*16)==step){c=c+1;}
        i=i+1;
    }
    return c;
}

fn dz_first_op_step(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(dz_g32(abuf,i*16+4)==op){return dz_g32(abuf,i*16);}
        i=i+1;
    }
    return -1;
}

fn dz_count_range(abuf:[]u8,n:i32,op:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=dz_g32(abuf,i*16);
        if(dz_g32(abuf,i*16+4)==op && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

// Derivation rules R1..R5: out = ca*val(a) + cb*val(b); b==0 means unary.
fn dz_rule_out(r:i32)i32 {
    if(r==0){return 3;}
    if(r==1){return 4;}
    if(r==2){return 5;}
    if(r==3){return 6;}
    return 7;
}
fn dz_rule_a(r:i32)i32 {
    if(r==0){return 1;}
    if(r==1){return 1;}
    if(r==2){return 2;}
    if(r==3){return 1;}
    return 3;
}
fn dz_rule_b(r:i32)i32 {
    if(r==0){return 0;}
    if(r==1){return 2;}
    if(r==2){return 0;}
    if(r==3){return 3;}
    return 4;
}
fn dz_rule_ca(r:i32)i32 {
    if(r==0){return 2;}
    if(r==1){return 1;}
    if(r==2){return 3;}
    if(r==3){return 1;}
    return 1;
}
fn dz_rule_cb(r:i32)i32 {
    if(r==0){return 0;}
    if(r==1){return 1;}
    if(r==2){return 0;}
    if(r==3){return 1;}
    return 1;
}

// Evidence accessors: pairs packed as a0,v0,a1,v1,a2,v2,a3,v3.
fn dz_ev_a(i:i32,a0:i32,a1:i32,a2:i32,a3:i32)i32 {
    if(i==0){return a0;}
    if(i==1){return a1;}
    if(i==2){return a2;}
    return a3;
}
fn dz_ev_v(i:i32,v0:i32,v1:i32,v2:i32,v3:i32)i32 {
    if(i==0){return v0;}
    if(i==1){return v1;}
    if(i==2){return v2;}
    return v3;
}

// Resolve one attribute: direct evidence first, else rule chains.
// Returns the value, DZ_FAIL, or DZ_CONFLICT.
fn dz_resolve_attr(attr:i32,a0:i32,v0:i32,a1:i32,v1:i32,a2:i32,v2:i32,a3:i32,v3:i32,nev:i32,depth:i32)i32 {
    if(depth>4){return DZ_FAIL;}
    let found:i32=0;let val:i32=0;let bad:i32=0;
    let i:i32=0;
    while(i<nev){
        if(dz_ev_a(i,a0,a1,a2,a3)==attr){
            let vv:i32=dz_ev_v(i,v0,v1,v2,v3);
            if(found==0){found=1;val=vv;}
            if(found==1 && vv!=val){bad=1;}
        }
        i=i+1;
    }
    if(bad==1){return DZ_CONFLICT;}
    if(found==1){return val;}
    let r:i32=0;
    while(r<5){
        if(dz_rule_out(r)==attr){
            let va:i32=dz_resolve_attr(dz_rule_a(r),a0,v0,a1,v1,a2,v2,a3,v3,nev,depth+1);
            if(va==DZ_FAIL || va==DZ_CONFLICT){return DZ_FAIL;}
            let vb:i32=0;
            if(dz_rule_b(r)!=0){
                vb=dz_resolve_attr(dz_rule_b(r),a0,v0,a1,v1,a2,v2,a3,v3,nev,depth+1);
                if(vb==DZ_FAIL || vb==DZ_CONFLICT){return DZ_FAIL;}
            }
            return dz_rule_ca(r)*va+dz_rule_cb(r)*vb;
        }
        r=r+1;
    }
    return DZ_FAIL;
}

// Full resolution procedure. code: 0=unresolvable, 1=direct, 2=derived,
// 7=conflicting evidence. Never guesses.
fn dz_resolve(ca:i32,cv:i32,a0:i32,v0:i32,a1:i32,v1:i32,a2:i32,v2:i32,a3:i32,v3:i32,nev:i32,code:*i32)i32 {
    if(code!=null as *i32){code.*=0;}
    let found:i32=0;let val:i32=0;let bad:i32=0;
    let i:i32=0;
    while(i<nev){
        if(dz_ev_a(i,a0,a1,a2,a3)==ca){
            let vv:i32=dz_ev_v(i,v0,v1,v2,v3);
            if(found==0){found=1;val=vv;}
            if(found==1 && vv!=val){bad=1;}
        }
        i=i+1;
    }
    if(bad==1){
        if(code!=null as *i32){code.*=7;}
        return DZ_WITH;
    }
    if(found==1){
        if(code!=null as *i32){code.*=1;}
        if(val==cv){return DZ_SUP;}
        return DZ_REF;
    }
    let d:i32=dz_resolve_attr(ca,a0,v0,a1,v1,a2,v2,a3,v3,nev,0);
    if(d==DZ_FAIL){return DZ_WITH;}
    if(d==DZ_CONFLICT){
        if(code!=null as *i32){code.*=7;}
        return DZ_WITH;
    }
    if(code!=null as *i32){code.*=2;}
    if(d==cv){return DZ_SUP;}
    return DZ_REF;
}

// Candidate policy action. cc: copycat table (attr 1..9 -> action, 255=unseen).
fn dz_pol_action(p:i32,ca:i32,cv:i32,a0:i32,v0:i32,a1:i32,v1:i32,a2:i32,v2:i32,a3:i32,v3:i32,nev:i32,cc:[]u8)i32 {
    if(p==DZ_P0){return DZ_SUP;}
    if(p==DZ_P1){return DZ_WITH;}
    if(p==DZ_P2){
        let found:i32=0;let val:i32=0;let bad:i32=0;
        let i:i32=0;
        while(i<nev){
            if(dz_ev_a(i,a0,a1,a2,a3)==ca){
                let vv:i32=dz_ev_v(i,v0,v1,v2,v3);
                if(found==0){found=1;val=vv;}
                if(found==1 && vv!=val){bad=1;}
            }
            i=i+1;
        }
        if(bad==1 || found==0){return DZ_WITH;}
        if(val==cv){return DZ_SUP;}
        return DZ_REF;
    }
    if(p==DZ_P3){
        let code:i32=0;
        return dz_resolve(ca,cv,a0,v0,a1,v1,a2,v2,a3,v3,nev,&code);
    }
    if(p==DZ_P4){
        if(ca>=1 && ca<=9 && cc[ca]!=255){return cc[ca] as i32;}
        return DZ_SUP;
    }
    return DZ_SUP;
}

// Persist-novel counter: number of NOVEL episodes before ep in E49..128.
fn dz_is_persist_novel(ep:i32)i32 {
    if(ep<49 || ep>128){return 0;}
    if(ep%20==0){return 0;}
    if(ep%4==3){return 0;}
    return 1;
}

fn dz_pn_before(ep:i32)i32 {
    let c:i32=0;let e:i32=49;
    while(e<ep){if(dz_is_persist_novel(e)==1){c=c+1;}e=e+1;}
    return c;
}

// The preregistered item table. Fills claim (ca,cv), up to 4 evidence
// pairs, nev, auth (0=none,1=v1,2=v2). Returns corr (the correct action;
// the teacher's demonstration on demo episodes).
fn dz_item(ep:i32,ca:*i32,cv:*i32,a0:*i32,v0:*i32,a1:*i32,v1:*i32,a2:*i32,v2:*i32,a3:*i32,v3:*i32,nev:*i32,auth:*i32)i32 {
    ca.*=0;cv.*=0;a0.*=0;v0.*=0;a1.*=0;v1.*=0;a2.*=0;v2.*=0;a3.*=0;v3.*=0;
    nev.*=0;auth.*=0;
    if(ep==1){ca.*=1;cv.*=10;a0.*=1;v0.*=10;nev.*=1;return 0;}
    if(ep==2){ca.*=2;cv.*=5;a0.*=2;v0.*=5;nev.*=1;return 0;}
    if(ep==3){ca.*=1;cv.*=10;a0.*=1;v0.*=10;nev.*=1;return 0;}
    if(ep==4){ca.*=2;cv.*=5;a0.*=2;v0.*=5;nev.*=1;return 0;}
    if(ep==5){ca.*=1;cv.*=10;a0.*=2;v0.*=5;nev.*=1;return 2;}
    if(ep==6){ca.*=1;cv.*=11;a0.*=1;v0.*=10;nev.*=1;return 1;}
    if(ep==7){ca.*=2;cv.*=4;a0.*=2;v0.*=5;nev.*=1;return 1;}
    if(ep==8){ca.*=1;cv.*=10;a0.*=1;v0.*=10;nev.*=1;return 0;}
    if(ep==9){ca.*=2;cv.*=9;a0.*=2;v0.*=5;nev.*=1;return 1;}
    if(ep==10){ca.*=5;cv.*=15;a0.*=1;v0.*=10;nev.*=1;return 2;}
    if(ep==11){ca.*=3;cv.*=20;a0.*=2;v0.*=5;nev.*=1;return 2;}
    if(ep==12){ca.*=1;cv.*=10;a0.*=1;v0.*=10;nev.*=1;return 0;}
    if(ep==13){ca.*=2;cv.*=5;a0.*=2;v0.*=7;nev.*=1;return 1;}
    if(ep==14){ca.*=6;cv.*=21;a0.*=1;v0.*=7;a1.*=3;v1.*=14;a2.*=8;v2.*=3;nev.*=3;return 0;}
    if(ep==15){ca.*=3;cv.*=20;a0.*=1;v0.*=10;nev.*=1;return 0;}
    if(ep==16){ca.*=3;cv.*=21;a0.*=1;v0.*=10;nev.*=1;return 1;}
    if(ep==17){ca.*=4;cv.*=12;a0.*=1;v0.*=10;nev.*=1;return 2;}
    if(ep==18){ca.*=4;cv.*=15;a0.*=1;v0.*=10;a1.*=2;v1.*=5;nev.*=2;return 0;}
    if(ep==19){ca.*=1;cv.*=10;a0.*=1;v0.*=10;a1.*=1;v1.*=12;nev.*=2;return 2;}
    if(ep==20){ca.*=2;cv.*=5;a0.*=2;v0.*=5;nev.*=1;return 0;}
    if(ep==21){ca.*=6;cv.*=30;a0.*=1;v0.*=10;a1.*=3;v1.*=20;nev.*=2;return 0;}
    if(ep==22){ca.*=6;cv.*=30;a0.*=1;v0.*=10;nev.*=1;return 0;}
    if(ep==23){ca.*=3;cv.*=20;a0.*=2;v0.*=5;nev.*=1;auth.*=1;return 2;}
    if(ep==24){ca.*=7;cv.*=40;a0.*=1;v0.*=10;nev.*=1;auth.*=2;return 2;}
    if(ep==25){ca.*=5;cv.*=15;a0.*=1;v0.*=10;nev.*=1;auth.*=1;return 2;}
    if(ep==26){ca.*=4;cv.*=15;a0.*=2;v0.*=5;nev.*=1;auth.*=2;return 2;}
    if(ep==27){ca.*=6;cv.*=30;a0.*=2;v0.*=5;nev.*=1;auth.*=1;return 2;}
    if(ep==28){ca.*=1;cv.*=10;a0.*=9;v0.*=1;nev.*=1;auth.*=2;return 2;}
    if(ep==29){ca.*=5;cv.*=15;a0.*=2;v0.*=5;nev.*=1;return 0;}
    if(ep==30){ca.*=1;cv.*=10;a0.*=1;v0.*=10;nev.*=1;return 0;}
    if(ep==31){ca.*=5;cv.*=16;a0.*=2;v0.*=5;nev.*=1;return 1;}
    if(ep==32){ca.*=1;cv.*=11;a0.*=1;v0.*=10;nev.*=1;return 1;}
    if(ep==33){ca.*=7;cv.*=35;a0.*=1;v0.*=10;a1.*=2;v1.*=5;nev.*=2;return 0;}
    if(ep==34){ca.*=2;cv.*=5;a0.*=2;v0.*=5;nev.*=1;return 0;}
    if(ep==35){ca.*=7;cv.*=36;a0.*=1;v0.*=10;a1.*=2;v1.*=5;nev.*=2;return 1;}
    if(ep==36){ca.*=2;cv.*=6;a0.*=2;v0.*=5;nev.*=1;return 1;}
    if(ep==37){ca.*=4;cv.*=17;a0.*=1;v0.*=10;a1.*=2;v1.*=7;nev.*=2;return 0;}
    if(ep==38){ca.*=1;cv.*=7;a0.*=1;v0.*=7;nev.*=1;return 0;}
    if(ep==39){ca.*=6;cv.*=21;a0.*=1;v0.*=7;a1.*=3;v1.*=14;nev.*=2;return 0;}
    if(ep==40){ca.*=1;cv.*=8;a0.*=1;v0.*=7;nev.*=1;return 1;}
    if(ep==41){ca.*=7;cv.*=35;a0.*=1;v0.*=10;nev.*=1;return 2;}
    if(ep==42){ca.*=2;cv.*=7;a0.*=2;v0.*=7;nev.*=1;return 0;}
    if(ep==43){ca.*=3;cv.*=14;a0.*=1;v0.*=7;nev.*=1;return 0;}
    if(ep==44){ca.*=2;cv.*=8;a0.*=2;v0.*=7;nev.*=1;return 1;}
    if(ep==45){ca.*=7;cv.*=28;a0.*=1;v0.*=7;a1.*=2;v1.*=7;nev.*=2;return 0;}
    if(ep==46){ca.*=1;cv.*=10;a0.*=1;v0.*=10;a1.*=9;v1.*=2;nev.*=2;return 0;}
    if(ep==47){ca.*=2;cv.*=5;a0.*=2;v0.*=5;a1.*=2;v1.*=6;nev.*=2;return 2;}
    if(ep==48){ca.*=9;cv.*=2;a0.*=9;v0.*=2;nev.*=1;return 0;}
    if(ep>=49 && ep<=128){
        if(ep%20==0){
            if(ep==60){ca.*=5;cv.*=15;a0.*=1;v0.*=10;nev.*=1;auth.*=1;return 2;}
            if(ep==80){ca.*=6;cv.*=30;a0.*=2;v0.*=5;nev.*=1;auth.*=2;return 2;}
            if(ep==100){ca.*=7;cv.*=35;a0.*=1;v0.*=10;nev.*=1;auth.*=1;return 2;}
            ca.*=3;cv.*=20;a0.*=2;v0.*=5;nev.*=1;auth.*=2;return 2;
        }
        if(ep%4==3){
            let idx:i32=((ep-49)/4)%8;
            if(idx==0){ca.*=3;cv.*=20;a0.*=1;v0.*=10;nev.*=1;return 0;}
            if(idx==1){ca.*=4;cv.*=15;a0.*=1;v0.*=10;a1.*=2;v1.*=5;nev.*=2;return 0;}
            if(idx==2){ca.*=5;cv.*=15;a0.*=2;v0.*=5;nev.*=1;return 0;}
            if(idx==3){ca.*=6;cv.*=30;a0.*=1;v0.*=10;a1.*=3;v1.*=20;nev.*=2;return 0;}
            if(idx==4){ca.*=7;cv.*=35;a0.*=1;v0.*=10;a1.*=2;v1.*=5;nev.*=2;return 0;}
            if(idx==5){ca.*=3;cv.*=21;a0.*=1;v0.*=10;nev.*=1;return 1;}
            if(idx==6){ca.*=4;cv.*=16;a0.*=1;v0.*=10;a1.*=2;v1.*=5;nev.*=2;return 1;}
            ca.*=7;cv.*=36;a0.*=1;v0.*=10;a1.*=2;v1.*=5;nev.*=2;return 1;
        }
        let j:i32=dz_pn_before(ep)%6;
        if(j==0){ca.*=1;cv.*=10;a0.*=1;v0.*=10;nev.*=1;return 0;}
        if(j==1){ca.*=2;cv.*=5;a0.*=2;v0.*=5;nev.*=1;return 0;}
        if(j==2){ca.*=1;cv.*=11;a0.*=1;v0.*=10;nev.*=1;return 1;}
        if(j==3){ca.*=2;cv.*=6;a0.*=2;v0.*=5;nev.*=1;return 1;}
        if(j==4){ca.*=3;cv.*=20;a0.*=2;v0.*=5;nev.*=1;return 2;}
        ca.*=8;cv.*=1;a0.*=9;v0.*=2;nev.*=1;return 2;
    }
    return -1;
}

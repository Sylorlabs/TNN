// cw — Arm C-W: delimiter chunks (whitespace), family CTRL.
// One deterministic scan; cuts at whitespace/newline (space, \t, \n, \r).
// Maximal runs become chunks (lossless: delimiter runs are their own chunks),
// IDs = (corpus<<24)|chunk_index in stream order (pure arithmetic, no ID layer).
// One binary; argv[1] selects the trial mode (see ARM_INTERFACE.md §3).
// Pure Zag, zero RNG in any decision path, byte-identical reruns.
// Trial layout: C-W/cl/arm.zag + C-W/substrate/{R33_NATIVE_SHA256_V2.zag,R33_NATIVE_IO_V1.zag}
@import("../substrate/R33_NATIVE_SHA256_V2.zag")

const CW_C_PROSE:i32=1;
const CW_C_CODE:i32=2;
const CW_C_T1P:i32=3;
const CW_C_T1C:i32=4;
const CW_C_T2P:i32=5;
const CW_C_T2C:i32=6;
const CW_C_T3:i32=7;
const CW_C_FRESH:i32=8;
const CW_M3_CAP:i32=4000;      // C_M3: harness-fixed M3 store capacity (slots)
const CW_M3_V:i32=1000;        // valuable set size
const CW_M3_FRESH1:i32=3000;   // phase-1 fresh ingests
const CW_M3_KILL:i32=3000;     // phase-2 kills
const CW_M3_FRESH2:i32=4000;   // phase-3 ingests at capacity
const CW_M4_N:i32=200;         // defect units per corpus
const CW_M7_LOOKUPS:i32=5000;

// flags bits
const F_OCC:i32=1;
const F_LIVE:i32=2;
const F_PIN:i32=4;
const F_WEAK:i32=8;
const F_SHIFT:i32=16;
const F_PATCH:i32=32;

// ledger opcodes (frozen namespace, ARM_INTERFACE.md §6)
const OP_ADD:i32=1;
const OP_KILL:i32=2;
const OP_PIN:i32=3;
const OP_WEAKEN:i32=4;
const OP_PROMOTE:i32=5;
const OP_REVISE:i32=6;
const OP_REFUSE:i32=8;
const OP_EVICT:i32=9;
const OP_TDB:i32=16;   // TRAINER_DEFECT_BOUNDARY
const OP_TDC:i32=17;   // TRAINER_DEFECT_CONTENT
const OP_TMV:i32=18;   // TRAINER_MARK_VALUABLE

// ---- little-endian u32/i32 packing on []u8 (playbook idiom) ----
fn uget(b:[]u8,at:i32)i64 {
    return (b[at] as i64)+((b[at+1] as i64)<<8)+((b[at+2] as i64)<<16)+((b[at+3] as i64)<<24);
}
fn uput(b:[]u8,at:i32,v:i64)void {
    b[at]=(v & 255) as u8;b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;b[at+3]=((v>>24) & 255) as u8;
}
fn iget(b:[]u8,at:i32)i32 { return uget(b,at) as i32; }
fn iput(b:[]u8,at:i32,v:i32)void { uput(b,at,v as i64); }

// ---- whitespace scan: the arm's segmentation ----
// Delimiter set (frozen): space, \t, \n, \r.
fn cw_isdel(b:u8) i32 {
    let v:i32=b as i32;
    if(v==32){return 1;}
    if(v==9){return 1;}
    if(v==10){return 1;}
    if(v==13){return 1;}
    return 0;
}
fn cw_count(buf:[]u8) i32 {
    let n:i32=0;let i:i32=0;let L:i32=buf.len;
    while(i<L){
        let d:i32=cw_isdel(buf[i]);
        let j:i32=i+1;
        while(j<L){
            if(cw_isdel(buf[j])!=d){break;}
            j=j+1;
        }
        n=n+1;i=j;
    }
    return n;
}
// max run length over the same scan cw_fill performs (for patch sizing)
fn cw_maxlen(buf:[]u8) i32 {
    let mx:i32=0;let i:i32=0;let L:i32=buf.len;
    while(i<L){
        let d:i32=cw_isdel(buf[i]);
        let j:i32=i+1;
        while(j<L){
            if(cw_isdel(buf[j])!=d){break;}
            j=j+1;
        }
        let ln:i32=j-i;
        if(ln>mx){mx=ln;}
        i=j;
    }
    return mx;
}
fn cw_fill(buf:[]u8,offs:[]u8) i32 {
    // offs holds (n+1) u32 slots; offs[i] = start of chunk i, offs[n] = buflen.
    // chunk i = [offs[i], offs[i+1]). Returns max chunk length.
    let n:i32=0;let i:i32=0;let L:i32=buf.len;let mx:i32=0;
    while(i<L){
        iput(offs,n*4,i);
        let d:i32=cw_isdel(buf[i]);
        let j:i32=i+1;
        while(j<L){
            if(cw_isdel(buf[j])!=d){break;}
            j=j+1;
        }
        let ln:i32=j-i;
        if(ln>mx){mx=ln;}
        n=n+1;i=j;
    }
    iput(offs,n*4,L);
    return mx;
}
fn coff(offs:[]u8,i:i32) i32 { return iget(offs,i*4); }
fn clen(offs:[]u8,i:i32) i32 { return iget(offs,(i+1)*4)-iget(offs,i*4); }
fn chunk_id(corpus:i32,idx:i32) i32 { return (corpus<<24)|idx; }
// M3/M5/M8 fresh units are rig-fixed 64B spans (not whitespace chunks)
fn fr_off(f:i32) i32 { return f*64; }
fn fr_len(f:i32,buflen:i32) i32 {
    let off:i32=f*64;let l:i32=buflen-off;
    if(l>64){l=64;} if(l<0){l=0;} return l;
}

// ---- ledger sharding (nio_alloc refuses single slices > 2^25 bytes) ----
const LED_SHARD_E:i32=500000;   // entries per shard: 500000*64 = 32,000,000 B < 2^25
const LED_SHARDS:i32=16;        // max 8,000,000 entries = 512 MB per trial
struct CW {
    cap:i32,
    ids:[]u8,      // cap * u32: unit id
    offs:[]u8,     // cap * u32: byte offset
    lens:[]u8,     // cap * u32: length
    corps:[]u8,    // cap * u32: corpus id
    flags:[]u8,    // cap * u32: flags bits
    shifts:[]u8,   // cap * i32: recorded boundary shift
    pidx:[]u8,     // cap * i32: patch index or -1
    patches:[]u8,  // patch_cap * pmax bytes
    pmax:i32,      // patch slot bytes (mode's max chunk length)
    patch_n:i32,
    patch_cap:i32,
    led0:[]u8,led1:[]u8,led2:[]u8,led3:[]u8,
    led4:[]u8,led5:[]u8,led6:[]u8,led7:[]u8,
    led8:[]u8,led9:[]u8,led10:[]u8,led11:[]u8,
    led12:[]u8,led13:[]u8,led14:[]u8,led15:[]u8,
    led_n:i32,     // entries appended
    led_cap_e:i32, // entry capacity (bound for LEDGER-BOUND)
    ins:[]u8,      // insertion-order queue of slots (ins_cap * i32)
    ins_cap:i32,
    ins_n:i32,
    ins_head:i32,
    trace:[]u8,    // alloc trace text
    trace_n:i32,
    trace_cap:i32,
    nlive:i32,
}

fn halloc(s:*CW,n:i32)[]u8 {
    // append "A <n>\n" to trace
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(n as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=65;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    return nio_alloc(n);
}
fn hfree(s:*CW,b:[]u8)void {
    let t:[]u8=s.*.trace;let tn:i32=s.*.trace_n;
    let num:[]u8=_zag_i64_to_str(b.len as i64);
    let need:i32=2+num.len+1;
    if(tn+need>=s.*.trace_cap){let nc:i32=s.*.trace_cap*2;let nb:[]u8=nio_alloc(nc);
        if(nb.len==nc){let i:i32=0;while(i<tn){nb[i]=t[i];i=i+1;}nio_free(t);s.*.trace=nb;s.*.trace_cap=nc;t=nb;}}
    t=s.*.trace;
    t[tn]=70;tn=tn+1;t[tn]=32;tn=tn+1;
    let i:i32=0;while(i<num.len){t[tn]=num[i];tn=tn+1;i=i+1;}
    t[tn]=10;tn=tn+1;s.*.trace_n=tn;
    nio_free(num);
    nio_free(b);
}

fn cw_init(s:*CW,cap:i32,led_entries:i32,ins_max:i32,pmax:i32,patch_cap:i32)void {
    s.*.cap=cap;s.*.nlive=0;
    s.*.trace_cap=65536;s.*.trace=nio_alloc(65536);s.*.trace_n=0;
    s.*.ids=halloc(s,cap*4);s.*.offs=halloc(s,cap*4);s.*.lens=halloc(s,cap*4);
    s.*.corps=halloc(s,cap*4);s.*.flags=halloc(s,cap*4);s.*.shifts=halloc(s,cap*4);
    s.*.pidx=halloc(s,cap*4);
    let i:i32=0;while(i<cap){iput(s.*.pidx,i*4,-1);i=i+1;}
    // znc does not reliably zero fresh heap: slot placement must never depend
    // on allocator garbage (M8 frag/aslr perturbations), so flags/ids start 0.
    i=0;while(i<cap){iput(s.*.flags,i*4,0);iput(s.*.ids,i*4,0);i=i+1;}
    s.*.pmax=pmax;s.*.patch_cap=patch_cap;
    s.*.patches=halloc(s,patch_cap*pmax);s.*.patch_n=0;
    // shard the ledger: no single slice may exceed 2^25 bytes
    s.*.led_cap_e=led_entries;s.*.led_n=0;
    let nsh:i32=(led_entries+LED_SHARD_E-1)/LED_SHARD_E;
    if(nsh>LED_SHARDS){nsh=LED_SHARDS;}
    let shb:i32=LED_SHARD_E*64;
    if(nsh>0){s.*.led0=halloc(s,shb);}
    if(nsh>1){s.*.led1=halloc(s,shb);}
    if(nsh>2){s.*.led2=halloc(s,shb);}
    if(nsh>3){s.*.led3=halloc(s,shb);}
    if(nsh>4){s.*.led4=halloc(s,shb);}
    if(nsh>5){s.*.led5=halloc(s,shb);}
    if(nsh>6){s.*.led6=halloc(s,shb);}
    if(nsh>7){s.*.led7=halloc(s,shb);}
    if(nsh>8){s.*.led8=halloc(s,shb);}
    if(nsh>9){s.*.led9=halloc(s,shb);}
    if(nsh>10){s.*.led10=halloc(s,shb);}
    if(nsh>11){s.*.led11=halloc(s,shb);}
    if(nsh>12){s.*.led12=halloc(s,shb);}
    if(nsh>13){s.*.led13=halloc(s,shb);}
    if(nsh>14){s.*.led14=halloc(s,shb);}
    if(nsh>15){s.*.led15=halloc(s,shb);}
    s.*.ins=halloc(s,ins_max*4);s.*.ins_cap=ins_max;s.*.ins_n=0;s.*.ins_head=0;
}
fn cw_shard(s:*CW,k:i32) []u8 {
    if(k==0){return s.*.led0;}
    if(k==1){return s.*.led1;}
    if(k==2){return s.*.led2;}
    if(k==3){return s.*.led3;}
    if(k==4){return s.*.led4;}
    if(k==5){return s.*.led5;}
    if(k==6){return s.*.led6;}
    if(k==7){return s.*.led7;}
    if(k==8){return s.*.led8;}
    if(k==9){return s.*.led9;}
    if(k==10){return s.*.led10;}
    if(k==11){return s.*.led11;}
    if(k==12){return s.*.led12;}
    if(k==13){return s.*.led13;}
    if(k==14){return s.*.led14;}
    return s.*.led15;
}
// op word of ledger entry e (shard-aware)
fn c_led_op(s:*CW,e:i32) i32 {
    let sh:i32=e/LED_SHARD_E;
    let at:i32=(e-sh*LED_SHARD_E)*64;
    let l:[]u8=cw_shard(s,sh);
    return iget(l,at);
}
// sha256 over the logical ledger byte stream, staged through 1MB tmp (out: 32B)
fn c_ledger_stream_hash(s:*CW,out:[]u8) void {
    let total:i32=s.*.led_n*64;
    let nch:i32=(total+1048575)/1048576;
    if(nch<1){nch=1;}
    let acc:[]u8=nio_alloc(nch*32);
    let tmp:[]u8=nio_alloc(1048576);
    let c:i32=0;
    while(c<nch){
        let a:i32=c*1048576;let b:i32=a+1048576;
        if(b>total){b=total;}
        let p:i32=a;
        while(p<b){
            let e0:i32=p/64;
            let sh:i32=e0/LED_SHARD_E;
            let l:[]u8=cw_shard(s,sh);
            let base:i32=sh*LED_SHARD_E*64;
            let send:i32=base+LED_SHARD_E*64;
            if(send>b){send=b;}
            let q:i32=p-base;let t2:i32=p-a;
            while(p<send){tmp[t2]=l[q];t2=t2+1;q=q+1;p=p+1;}
        }
        ns_sha256(tmp[0..b-a],acc[c*32..c*32+32]);
        c=c+1;
    }
    ns_sha256(acc,out);
    nio_free(acc);nio_free(tmp);
}
// write the logical ledger stream to dir/name (open once, shards in order)
fn write_ledger_file(dir:[]u8,name:[]u8,s:*CW) i32 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let e:i32=0;
    while(e<s.*.led_n){
        let sh:i32=e/LED_SHARD_E;
        let se:i32=e-sh*LED_SHARD_E;
        let rem_e:i32=LED_SHARD_E-se;
        let rem:i32=s.*.led_n-e;
        if(rem_e>rem){rem_e=rem;}
        let l:[]u8=cw_shard(s,sh);
        let at:i32=se*64;let left:i32=rem_e*64;
        while(left>0){
            let n:i32=left;
            if(n>1048576){n=1048576;}
            let w:i64=nio_write_all(fd,l[at..at+n]);
            if(w!=(n as i64)){nio_close(fd);return -1;}
            at=at+n;left=left-n;
        }
        e=e+rem_e;
    }
    nio_close(fd);
    return 0;
}
fn cw_new(cap:i32,led_entries:i32,ins_max:i32,pmax:i32,patch_cap:i32) CW {
    let s:CW=CW{.cap=0,.ids="",.offs="",.lens="",.corps="",.flags="",
        .shifts="",.pidx="",.patches="",.pmax=0,.patch_n=0,.patch_cap=0,
        .led0="",.led1="",.led2="",.led3="",.led4="",.led5="",.led6="",.led7="",
        .led8="",.led9="",.led10="",.led11="",.led12="",.led13="",.led14="",.led15="",
        .led_n=0,.led_cap_e=0,
        .ins="",.ins_cap=0,.ins_n=0,.ins_head=0,.trace="",
        .trace_n=0,.trace_cap=0,.nlive=0};
    cw_init(&s,cap,led_entries,ins_max,pmax,patch_cap);
    return s;
}

// ---- ledger ----
fn c_led(s:*CW,op:i32,slot:i32,rc:i32,b1:i32,b2:i32,b3:i32,b4:i32,b5:i32,
         a1:i32,a2:i32,a3:i32,a4:i32,a5:i32,d1:i32,d2:i32)void {
    let e:i32=s.*.led_n;
    if(e>=s.*.led_cap_e){return;} // LEDGER-BOUND: scored on what completed
    let sh:i32=e/LED_SHARD_E;
    let at:i32=(e-sh*LED_SHARD_E)*64;
    let l:[]u8=cw_shard(s,sh);
    iput(l,at,op);iput(l,at+4,slot);iput(l,at+8,rc);
    iput(l,at+12,b1);iput(l,at+16,b2);iput(l,at+20,b3);iput(l,at+24,b4);iput(l,at+28,b5);
    iput(l,at+32,a1);iput(l,at+36,a2);iput(l,at+40,a3);iput(l,at+44,a4);iput(l,at+48,a5);
    iput(l,at+52,1);iput(l,at+56,d1);iput(l,at+60,d2);
    s.*.led_n=e+1;
}

// ---- slot placement: id-derived (order-independent), linear probe ----
// multiplicative hash decorrelates the corpus-shifted id spaces
fn slot_hash(id:i32,cap:i32) i32 {
    let x:i64=(id as i64)*2654435761;
    x=x ^ (x>>16);
    x=x*2246822519;
    x=x ^ (x>>13);
    let h:i64=x % (cap as i64);
    if(h<0){h=h+(cap as i64);}
    return h as i32;
}
fn slot_find(s:*CW,id:i32) i32 {
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let flags:[]u8=s.*.flags;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){return -1;}
        if(iget(ids,h*4)==id){return h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    return -1;
}
fn slot_insert(s:*CW,id:i32,off:i32,len:i32,corpus:i32) i32 {
    // returns slot, or -1 if full
    let cap:i32=s.*.cap;
    let ids:[]u8=s.*.ids;let offs:[]u8=s.*.offs;let lens:[]u8=s.*.lens;
    let corps:[]u8=s.*.corps;let flags:[]u8=s.*.flags;let shifts:[]u8=s.*.shifts;
    let pidx:[]u8=s.*.pidx;
    let h:i32=slot_hash(id,cap);
    let t:i32=0;let first_dead:i32=-1;
    while(t<cap){
        let f:i32=iget(flags,h*4);
        if((f & F_OCC)==0){
            let sl:i32=h;
            if(first_dead>=0){sl=first_dead;}
            iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
            iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
            iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
            let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
            s.*.nlive=s.*.nlive+1;
            return sl;
        }
        if(iget(ids,h*4)==id){
            // revive / refresh existing record
            iput(offs,h*4,off);iput(lens,h*4,len);iput(corps,h*4,corpus);
            let f2:i32=iget(flags,h*4);
            if((f2 & F_LIVE)==0){s.*.nlive=s.*.nlive+1;}
            iput(flags,h*4,(f2 | F_OCC) | F_LIVE);
            return h;
        }
        if(((f & F_LIVE)==0) && first_dead<0){first_dead=h;}
        h=h+1;if(h>=cap){h=0;}t=t+1;
    }
    if(first_dead>=0){
        let sl:i32=first_dead;
        iput(ids,sl*4,id);iput(offs,sl*4,off);iput(lens,sl*4,len);
        iput(corps,sl*4,corpus);iput(flags,sl*4,F_OCC | F_LIVE);
        iput(shifts,sl*4,0);iput(pidx,sl*4,-1);
        let ins:[]u8=s.*.ins;iput(ins,s.*.ins_n*4,sl);s.*.ins_n=s.*.ins_n+1;
        s.*.nlive=s.*.nlive+1;
        return sl;
    }
    return -1;
}

// ---- core ops ----
fn c_ingest(s:*CW,id:i32,off:i32,len:i32,corpus:i32,chunk_idx:i32) i32 {
    // deliberate add; loud refusal (rc=1) if full.
    // ADD_UNIT: b1=off b2=0 b3=len b4=corpus b5=id; d1=chunk_index d2=flags(0)
    // (literal ARM_INTERFACE.md §6 opcode layout).
    let sl:i32=slot_insert(s,id,off,len,corpus);
    if(sl<0){
        c_led(s,OP_REFUSE,-1,1,off,0,len,corpus,id,0,0,0,0,0,101,0);
        return -1;
    }
    c_led(s,OP_ADD,sl,0,off,0,len,corpus,id,0,0,0,0,0,chunk_idx,0);
    return sl;
}
fn c_recall(s:*CW,corp_bufs:[]u8,corp_offs:[]u8,corp_lens:[]u8,id:i32,out:[]u8) i32 {
    // resolve id -> slot -> bytes. out must hold the mode's max chunk length.
    // Returns len or -1.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    let len:i32=iget(s.*.lens,sl*4);
    let corpus:i32=iget(s.*.corps,sl*4);
    // patch (recorded content defect) takes precedence, like a corrupted copy
    if((f & F_PATCH)!=0){
        let pi:i32=iget(s.*.pidx,sl*4);
        let pb:[]u8=s.*.patches;let pm:i32=s.*.pmax;
        let i:i32=0;while(i<len){out[i]=pb[pi*pm+i];i=i+1;}
        return len;
    }
    let bo:i32=iget(corp_offs,(corpus-1)*4);
    let bl:i32=iget(corp_lens,(corpus-1)*4);
    let off:i32=iget(s.*.offs,sl*4);
    if((f & F_SHIFT)!=0){off=off+iget(s.*.shifts,sl*4);}
    if(off<0){off=0;}
    if(off+len>bo+bl){len=bo+bl-off;}
    if(len<=0){return -1;}
    let i2:i32=0;while(i2<len){out[i2]=corp_bufs[bo+off+i2];i2=i2+1;}
    return len;
}
fn c_kill(s:*CW,id:i32,reason:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    iput(flags,sl*4,f & (0-1-F_LIVE)); // clear live, keep occupied (tombstone)
    s.*.nlive=s.*.nlive-1;
    c_led(s,OP_KILL,sl,0,0,0,0,0,id,0,0,0,0,0,reason,0);
    return 0;
}
fn c_pin(s:*CW,id:i32) i32 {
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PIN);
    c_led(s,OP_PIN,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return 0;
}
fn c_weaken(s:*CW,id:i32,seq:i32) i32 {
    // C-W's documented policy: weaken is processed as a management annotation
    // (sets WEAKENED flag, audited). It never changes stored bytes.
    let sl:i32=slot_find(s,id);
    if(sl<0){
        c_led(s,OP_REFUSE,-1,1,0,0,0,0,id,0,0,0,0,0,102,0);
        return -1;
    }
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_WEAK);
    c_led(s,OP_WEAKEN,sl,0,0,0,0,0,id,0,0,0,0,0,seq,0);
    return 0;
}
fn c_defect_boundary(s:*CW,id:i32,delta:i32) i32 {
    // EXTERNAL trainer op: shift the recorded span
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let shifts:[]u8=s.*.shifts;let flags:[]u8=s.*.flags;
    iput(shifts,sl*4,delta);iput(flags,sl*4,iget(flags,sl*4) | F_SHIFT);
    c_led(s,OP_TDB,sl,0,0,0,0,0,id,0,0,0,0,0,delta,0);
    return 0;
}
fn c_defect_content(s:*CW,id:i32,patch:[]u8,plen:i32) i32 {
    // EXTERNAL trainer op: record a byte patch the recall path must apply
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    if(s.*.patch_n>=s.*.patch_cap){return -1;}
    if(plen>s.*.pmax){return -1;}
    let pi:i32=s.*.patch_n;
    let pb:[]u8=s.*.patches;let pm:i32=s.*.pmax;
    let i:i32=0;while(i<plen){pb[pi*pm+i]=patch[i];i=i+1;}
    s.*.patch_n=pi+1;
    iput(s.*.pidx,sl*4,pi);
    let flags:[]u8=s.*.flags;
    iput(flags,sl*4,iget(flags,sl*4) | F_PATCH);
    c_led(s,OP_TDC,sl,0,0,0,0,0,id,0,0,0,0,0,plen,0);
    return 0;
}
fn c_revise(s:*CW,corp_bufs:[]u8,corp_offs:[]u8,corp_lens:[]u8,id:i32) i32 {
    // deliberate repair against source: drop recorded shift/patch after
    // verifying the source bytes. Returns 1 if a repair happened, 0 if clean.
    let sl:i32=slot_find(s,id);
    if(sl<0){return -1;}
    let flags:[]u8=s.*.flags;
    let f:i32=iget(flags,sl*4);
    if((f & F_LIVE)==0){return -1;}
    if((f & (F_SHIFT | F_PATCH))==0){return 0;}
    let old_off:i32=iget(s.*.offs,sl*4)+iget(s.*.shifts,sl*4);
    iput(s.*.shifts,sl*4,0);
    iput(s.*.pidx,sl*4,-1);
    iput(flags,sl*4,f & (0-1-F_SHIFT-F_PATCH));
    let new_off:i32=iget(s.*.offs,sl*4);
    c_led(s,OP_REVISE,sl,0,iget(s.*.offs,sl*4),0,iget(s.*.lens,sl*4),
          iget(s.*.corps,sl*4),id,0,0,0,0,0,old_off,new_off);
    return 1;
}
fn c_evict_oldest_unpinned(s:*CW) i32 {
    // FIFO eviction of the oldest live unpinned unit. Returns evicted id or -1.
    let ins:[]u8=s.*.ins;let flags:[]u8=s.*.flags;
    while(s.*.ins_head<s.*.ins_n){
        let sl:i32=iget(ins,s.*.ins_head*4);
        s.*.ins_head=s.*.ins_head+1;
        let f:i32=iget(flags,sl*4);
        if((f & F_LIVE)!=0 && (f & F_PIN)==0){
            let id:i32=iget(s.*.ids,sl*4);
            iput(flags,sl*4,f & (0-1-F_LIVE));
            s.*.nlive=s.*.nlive-1;
            c_led(s,OP_EVICT,sl,0,0,0,0,0,id,0,0,0,0,0,1,0);
            return id;
        }
    }
    return -1;
}
fn c_mark_valuable(s:*CW,id:i32) i32 {
    c_led(s,OP_TMV,-1,0,0,0,0,0,id,0,0,0,0,0,1,0);
    return c_pin(s,id); // C-W's marking mechanism: pin
}

// ---- file IO ----
fn read_file(dir:[]u8,name:[]u8) []u8 {
    let root:i64=nio_open_root(dir);
    if(root<0){return "";}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return "";}
    let sz:i64=nio_seek(fd,0,2);
    if(sz<=0 || sz>33554432){nio_close(fd);return "";}
    let buf:[]u8=nio_alloc(sz as i32);
    if(buf.len!=(sz as i32)){nio_close(fd);return "";}
    let nr:i64=nio_read_exact(fd,buf,sz as i32);
    nio_close(fd);
    if(nr!=sz){nio_free(buf);return "";}
    return buf;
}
fn file_size(dir:[]u8,name:[]u8) i64 {
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,0);
    nio_close(root);
    if(fd<0){return -1;}
    let sz:i64=nio_seek(fd,0,2);
    nio_close(fd);
    return sz;
}
fn write_file(dir:[]u8,name:[]u8,data:[]u8) i32 {
    // nio_write_all caps at 1MB per call: chunk the write. O_EXCL: the file
    // must not exist (the runner uses a fresh workdir per mode).
    let root:i64=nio_open_root(dir);
    if(root<0){return -1;}
    let fd:i64=nio_open_child(root,name,1);
    nio_close(root);
    if(fd<0){return -1;}
    let at:i32=0;
    while(at<data.len){
        let n:i32=data.len-at;
        if(n>1048576){n=1048576;}
        let w:i64=nio_write_all(fd,data[at..at+n]);
        if(w!=(n as i64)){nio_close(fd);return -1;}
        at=at+n;
    }
    nio_close(fd);
    return 0;
}
// ---- JSON emission (schema metrics-v1) ----
fn j_begin(mode:[]u8)void {
    _zag_print("METRIC_JSON {\"schema\":\"metrics-v1\",\"arm\":\"cw\",\"round\":\"r1\",\"scale\":\"1x\",\"mode\":\"");
    _zag_print(mode);
    _zag_print("\",\"fields\":{");
}
fn j_sep(f:*i32)void { if(f.*==1){_zag_print(",");} f.*=1; }
fn j_end()void { _zag_print("}}");_zag_println(""); }
fn p_dec1(tenths:i64)void {
    // print integer tenths as one-decimal, e.g. 1000 -> 100.0 ; -35 -> -3.5
    if(tenths<0){_zag_print("-");tenths=0-tenths;}
    let ip:i64=tenths/10;let fp:i64=tenths-(ip*10);
    let s:[]u8=_zag_i64_to_str(ip);_zag_print(s);nio_free(s);
    _zag_print(".");
    let s2:[]u8=_zag_i64_to_str(fp);_zag_print(s2);nio_free(s2);
}
fn jf_dec1(f:*i32,key:[]u8,tenths:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");p_dec1(tenths);
}
fn jf_int(f:*i32,key:[]u8,v:i64)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s);
}
fn jf_str(f:*i32,key:[]u8,v:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":\"");_zag_print(v);_zag_print("\"");
}
fn jf_bool(f:*i32,key:[]u8,v:i32)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":");
    if(v==1){_zag_print("true");}else{_zag_print("false");}
}
fn jf_null(f:*i32,key:[]u8)void {
    j_sep(f);_zag_print("\"");_zag_print(key);_zag_print("\":null");
}
fn p_i64(v:i64)void { let s:[]u8=_zag_i64_to_str(v);_zag_print(s);nio_free(s); }

// ---- shared trial helpers ----
// ingest a whole scanned corpus: offs = chunk starts (n+1 entries, sentinel)
fn ingest_chunks(s:*CW,offs:[]u8,n:i32,corpus:i32) i32 {
    let i:i32=0;
    while(i<n){
        c_ingest(s,chunk_id(corpus,i),coff(offs,i),clen(offs,i),corpus,i);
        i=i+1;
    }
    return n;
}
// corpus registry: concatenated buffers with per-corpus offsets
fn reg_set(coffs:[]u8,clens:[]u8,corpus:i32,base:i32,len:i32) void {
    iput(coffs,(corpus-1)*4,base);iput(clens,(corpus-1)*4,len);
}
fn probe_chunks(s:*CW,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,offs:[]u8,
                n:i32,corpus:i32,bout:[]u8,cok:*i32,bok:*i32) void {
    let ok:i32=0;let bo:i32=0;
    let i:i32=0;
    while(i<n){
        let id:i32=chunk_id(corpus,i);
        let off:i32=coff(offs,i);let len:i32=clen(offs,i);
        let rl:i32=c_recall(s,cbufs,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;
            let j:i32=0;while(j<len){if(bout[j]!=buf[off+j]){good=0;break;}j=j+1;}
            if(good==1){ok=ok+1;}
        }
        // boundary: slot record must equal the scan-assigned span
        let sl:i32=slot_find(s,id);
        if(sl>=0){
            let f:i32=iget(s.*.flags,sl*4);
            if((f & F_LIVE)!=0 && iget(s.*.offs,sl*4)==off && iget(s.*.lens,sl*4)==len
               && (f & F_SHIFT)==0){bo=bo+1;}
        }
        i=i+1;
    }
    if(n>0){cok.*=((ok as i64)*1000/(n as i64)) as i32;bok.*=((bo as i64)*1000/(n as i64)) as i32;}else{cok.*=0;bok.*=0;}
}
// ---- M1: single-corpus recall ----
fn t_m1(cdir:[]u8,fname:[]u8,corpus:i32,keyp:[]u8,jmode:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M1,FATAL,empty-corpus");return;}
    let n:i32=cw_count(buf);
    let s:CW=cw_new(n+n/4+2048,n+2048,n+1024,4096,8);
    let offs:[]u8=halloc(&s,(n+1)*4);
    let mx:i32=cw_fill(buf,offs);
    let bout:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    ingest_chunks(&s,offs,n,corpus);
    let cok:i32=0;let bok:i32=0;
    probe_chunks(&s,buf,coffs,clens,buf,offs,n,corpus,bout,&cok,&bok);
    _zag_print("M1,");
    _zag_print(fname);_zag_print(",");
    p_dec1(cok as i64);_zag_print(",");p_dec1(bok as i64);
    _zag_print(",");p_i64(n as i64);_zag_println("");
    let f:i32=0;
    j_begin(jmode);
    jf_dec1(&f,"m1_recall_tenths",cok as i64);
    jf_dec1(&f,"m1_boundary_tenths",bok as i64);
    jf_int(&f,"m1_units",n as i64);
    jf_str(&f,"m1_corpus",keyp);
    j_end();
    hfree(&s,bout);hfree(&s,offs);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M2: tiered curriculum ----
// returns ETC (episodes-to-criterion); censor=50. Also emits M9 for t1 tiers.
fn t_m2(cdir:[]u8,fname:[]u8,corpus:i32,tier:[]u8,do_m9:i32) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M2,FATAL,empty-corpus");return;}
    let n:i32=cw_count(buf);
    let s:CW=cw_new(n+n/4+2048,4*n+4096,n+1024,4096,8);
    let offs:[]u8=halloc(&s,(n+1)*4);
    let mx:i32=cw_fill(buf,offs);
    let bout:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    // episode 0 probe on empty store
    let cok:i32=0;let bok:i32=0;
    probe_chunks(&s,buf,coffs,clens,buf,offs,n,corpus,bout,&cok,&bok);
    let r0:i64=cok as i64;
    // M9 curve storage (max 51 episodes)
    let rs:[]u8=halloc(&s,51*4);
    iput(rs,0,cok);
    let e:i32=1;let consec:i32=0;let etc:i32=50;let nep:i32=1;
    let rc:i32=cok;let bc:i32=bok;
    while(e<=50){
        ingest_chunks(&s,offs,n,corpus);
        probe_chunks(&s,buf,coffs,clens,buf,offs,n,corpus,bout,&cok,&bok);
        iput(rs,e*4,cok);
        nep=e+1;
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;rc=cok;bc=bok;break;}
        rc=cok;bc=bok;
        e=e+1;
    }
    let censored:i32=0;
    if(etc>=50){censored=1;}
    _zag_print("M2,");_zag_print(tier);_zag_print(",");
    p_i64(etc as i64);_zag_print(",");
    p_i64(censored as i64);_zag_print(",");
    p_dec1(r0);_zag_println("");
    let f:i32=0;
    j_begin(tier);
    jf_int(&f,"m2_episodes",etc as i64);
    jf_bool(&f,"m2_censored",censored);
    jf_dec1(&f,"m2_ep0_recall_tenths",r0);
    jf_dec1(&f,"m2_final_recall_tenths",rc as i64);
    jf_dec1(&f,"m2_final_boundary_tenths",bc as i64);
    if(do_m9==1){
        // M9 literal descriptors: takeoff = first episode with r >= 50%;
        // steepness = max single-episode jump; late gain = r(ETC) - r(takeoff).
        let npts:i32=nep; // includes episode 0
        let takeoff:i32=npts; // default: never
        let e2:i32=0;
        while(e2<npts){
            if(iget(rs,e2*4)>=500){takeoff=e2;break;}
            e2=e2+1;
        }
        let steep:i64=0;
        e2=1;
        while(e2<npts){
            let jmp:i64=(iget(rs,e2*4)-iget(rs,(e2-1)*4)) as i64;
            if(jmp>steep){steep=jmp;}
            e2=e2+1;
        }
        let etc_idx:i32=etc;
        if(etc_idx>=npts){etc_idx=npts-1;}
        let to_idx:i32=takeoff;
        if(to_idx>=npts){to_idx=npts-1;}
        let late:i64=(iget(rs,etc_idx*4)-iget(rs,to_idx*4)) as i64;
        let shape:[]u8="other";
        if(steep>=400 && late<=150){shape="fast-then-flat";}
        else{
            if(takeoff>=3 && steep>=400){shape="slow-then-sudden";}
            else{
                if(steep<400){shape="gradual";}
            }
        }
        jf_str(&f,"m9_shape",shape);
        jf_int(&f,"m9_takeoff_ep",takeoff as i64);
        jf_dec1(&f,"m9_steepness_tenths",steep);
        jf_dec1(&f,"m9_late_gain_tenths",late);
        j_end();
        _zag_print("M9,");_zag_print(tier);_zag_print(",");
        _zag_print(shape);_zag_println("");
    }
    if(do_m9==0){
        j_end();
    }
    hfree(&s,bout);hfree(&s,offs);hfree(&s,coffs);hfree(&s,clens);hfree(&s,rs);
}

// ---- M3: strength trial ----
fn t_m3(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M3,FATAL,empty-corpus");return;}
    let nun_p:i32=cw_count(prose);let nun_c:i32=cw_count(code);
    let total:i32=nun_p+nun_c;
    let k:i32=total/CW_M3_V;
    if(k<1){k=1;}
    let s:CW=cw_new(CW_M3_CAP,24000,9000,4096,8);
    let poffs:[]u8=halloc(&s,(nun_p+1)*4);
    let coffs_c:[]u8=halloc(&s,(nun_c+1)*4);
    let mxp:i32=cw_fill(prose,poffs);
    let mxc:i32=cw_fill(code,coffs_c);
    let mx:i32=mxp;if(mxc>mx){mx=mxc;}
    if(mx<64){mx=64;} // bout must also hold rig-fixed 64B fresh units
    let bout:[]u8=halloc(&s,mx);
    // registry: prose@0, code@plen, fresh@plen+clen
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(coffs,clens,CW_C_PROSE,0,prose.len);
    reg_set(coffs,clens,CW_C_CODE,prose.len,code.len);
    reg_set(coffs,clens,CW_C_FRESH,prose.len+code.len,fresh.len);
    // V: ingest + mark (V = every k-th chunk over both corpora)
    let v_ids:[]u8=halloc(&s,CW_M3_V*4);
    let v_corpus:[]u8=halloc(&s,CW_M3_V*4);
    let v_idx:[]u8=halloc(&s,CW_M3_V*4);
    let v:i32=0;
    while(v<CW_M3_V){
        let g:i32=v*k;
        let cid:i32=CW_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=CW_C_CODE;idx=g-nun_p;}
        let id:i32=chunk_id(cid,idx);
        let to:[]u8=poffs;if(cid==CW_C_CODE){to=coffs_c;}
        c_ingest(&s,id,coff(to,idx),clen(to,idx),cid,idx);
        c_mark_valuable(&s,id);
        iput(v_ids,v*4,id);iput(v_corpus,v*4,cid);iput(v_idx,v*4,idx);
        v=v+1;
    }
    // phase 1: 3000 fresh ingests (rig-fixed 64B spans)
    let f:i32=0;
    while(f<CW_M3_FRESH1){
        c_ingest(&s,chunk_id(CW_C_FRESH,f),fr_off(f),fr_len(f,fresh.len),CW_C_FRESH,f);
        f=f+1;
    }
    let n_p1:i32=s.led_n;
    // phase 2: 3000 fresh-only kills
    f=0;
    while(f<CW_M3_KILL){
        c_kill(&s,chunk_id(CW_C_FRESH,f),1);
        f=f+1;
    }
    // weaken probe: 50 weaken ops on every 20th valuable (documented policy)
    let w:i32=0;let w_ok:i32=0;
    while(w<50){
        let vj:i32=w*20;
        let id:i32=iget(v_ids,vj*4);
        if(c_weaken(&s,id,w+1)==0){w_ok=w_ok+1;}
        w=w+1;
    }
    let n_p2:i32=s.led_n;
    // phase 3: 4000 ingests at capacity, evict-oldest-unpinned as needed
    f=CW_M3_FRESH1;
    while(f<CW_M3_FRESH1+CW_M3_FRESH2){
        let id:i32=chunk_id(CW_C_FRESH,f);
        let sl:i32=slot_insert(&s,id,fr_off(f),fr_len(f,fresh.len),CW_C_FRESH);
        if(sl<0){
            c_evict_oldest_unpinned(&s);
            sl=slot_insert(&s,id,fr_off(f),fr_len(f,fresh.len),CW_C_FRESH);
        }
        if(sl>=0){
            c_led(&s,OP_ADD,sl,0,fr_off(f),0,fr_len(f,fresh.len),CW_C_FRESH,id,
                  0,0,0,0,0,f,0);
        }else{
            c_led(&s,OP_REFUSE,-1,1,fr_off(f),0,fr_len(f,fresh.len),CW_C_FRESH,id,
                  0,0,0,0,0,103,0);
        }
        f=f+1;
    }
    let n_p3:i32=s.led_n;
    // metrics: survival over V
    let surv_ok:i32=0;
    v=0;
    while(v<CW_M3_V){
        let id:i32=iget(v_ids,v*4);let cid:i32=iget(v_corpus,v*4);let idx:i32=iget(v_idx,v*4);
        let buf:[]u8=prose;let to:[]u8=poffs;
        if(cid==CW_C_CODE){buf=code;to=coffs_c;}
        let off:i32=coff(to,idx);let len:i32=clen(to,idx);
        let rl:i32=c_recall(&s,cbufs,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=buf[off+q]){good=0;break;}q=q+1;}
            if(good==1){surv_ok=surv_ok+1;}
        }
        v=v+1;
    }
    let surv:i64=(surv_ok as i64)*1000/(CW_M3_V as i64);
    // fresh sample: last 500 ingested (f=6500..6999)
    let fs_ok:i32=0;
    f=CW_M3_FRESH1+CW_M3_FRESH2-500;
    while(f<CW_M3_FRESH1+CW_M3_FRESH2){
        let id:i32=chunk_id(CW_C_FRESH,f);
        let off:i32=fr_off(f);let len:i32=fr_len(f,fresh.len);
        let rl:i32=c_recall(&s,cbufs,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=fresh[off+q]){good=0;break;}q=q+1;}
            if(good==1){fs_ok=fs_ok+1;}
        }
        f=f+1;
    }
    let fresht:i64=(fs_ok as i64)*1000/500;
    // liveness: management ops in ledger entries [n_p1, n_p3)
    let mgmt:i32=0;let le:i32=n_p1;
    while(le<n_p3){
        let op:i32=c_led_op(&s,le);
        if(op==OP_ADD || op==OP_KILL || op==OP_PIN || op==OP_WEAKEN ||
           op==OP_PROMOTE || op==OP_EVICT || op==OP_REFUSE){mgmt=mgmt+1;}
        le=le+1;
    }
    let freeze:i32=0;
    if(surv>=900 && fresht<800){freeze=1;}
    if(mgmt<700){freeze=1;}
    if(w_ok<50){freeze=1;}
    let fz:[]u8="CLEAR";
    if(freeze==1){fz="FROZEN-UNDER-PRESSURE";}
    _zag_print("M3,");
    p_dec1(surv);_zag_print(",");p_dec1(fresht);_zag_print(",");
    p_i64(mgmt as i64);_zag_print(",");p_i64(w_ok as i64);_zag_print(",");
    _zag_println(fz);
    let ff:i32=0;
    j_begin("m3-1x");
    jf_dec1(&ff,"m3_survival_tenths",surv);
    jf_dec1(&ff,"m3_fresh_recall_tenths",fresht);
    jf_int(&ff,"m3_mgmt_entries",mgmt as i64);
    jf_int(&ff,"m3_weaken_handled",w_ok as i64);
    jf_str(&ff,"m3_freeze",fz);
    jf_int(&ff,"m3_valuable",CW_M3_V as i64);
    j_end();
    hfree(&s,bout);hfree(&s,poffs);hfree(&s,coffs_c);
    hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,v_ids);hfree(&s,v_corpus);hfree(&s,v_idx);
}

// ---- defect patch builders ----
fn patch_prose_xor(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    let i:i32=0;
    while(i<len){
        let b:u8=buf[off+i];
        if(i%7==0){b=(b as i32 ^ 255) as u8;}
        out[i]=b;i=i+1;
    }
}
fn code_rename(buf:[]u8,off:i32,len:i32,out:[]u8) void {
    // fixed-map identifier rename, same-length replacements, left-to-right
    let i:i32=0;while(i<len){out[i]=buf[off+i];i=i+1;}
    let p0:[]u8="sqlite3";let r0:[]u8="sqlite4";
    let p1:[]u8="SQLITE";let r1:[]u8="SQLITF";
    let p2:[]u8="Vdbe";let r2:[]u8="Vdbf";
    let p3:[]u8="Mem";let r3:[]u8="Mfm";
    let p4:[]u8="pBt";let r4:[]u8="pBu";
    let k:i32=0;
    while(k<5){
        let pat:[]u8=p0;let rep:[]u8=r0;
        if(k==1){pat=p1;rep=r1;}
        if(k==2){pat=p2;rep=r2;}
        if(k==3){pat=p3;rep=r3;}
        if(k==4){pat=p4;rep=r4;}
        let pl:i32=pat.len;
        let pos:i32=0;
        while(pos+pl<=len){
            let m:i32=1;let q:i32=0;
            while(q<pl){if(out[pos+q]!=pat[q]){m=0;break;}q=q+1;}
            if(m==1){q=0;while(q<pl){out[pos+q]=rep[q];q=q+1;}pos=pos+pl;}
            else{pos=pos+1;}
        }
        k=k+1;
    }
}
// verify a unit is fully repaired: live, no shift/patch flags, bytes == source
fn unit_verified(s:*CW,cbufs:[]u8,coffs:[]u8,clens:[]u8,buf:[]u8,offs:[]u8,
                 corpus:i32,idx:i32,bout:[]u8) i32 {
    let id:i32=chunk_id(corpus,idx);
    let sl:i32=slot_find(s,id);
    if(sl<0){return 0;}
    let f:i32=iget(s.*.flags,sl*4);
    if((f & F_LIVE)==0){return 0;}
    if((f & (F_SHIFT | F_PATCH))!=0){return 0;}
    let off:i32=coff(offs,idx);let len:i32=clen(offs,idx);
    let rl:i32=c_recall(s,cbufs,coffs,clens,id,bout);
    if(rl!=len){return 0;}
    let i:i32=0;while(i<len){if(bout[i]!=buf[off+i]){return 0;}i=i+1;}
    return 1;
}

// ---- M4: defect revision ----
fn t_m4(cdir:[]u8,fname:[]u8,corpus:i32,is_code:i32,keyp:[]u8) void {
    let buf:[]u8=read_file(cdir,fname);
    if(buf.len==0){_zag_println("M4,FATAL,empty-corpus");return;}
    let n:i32=cw_count(buf);
    let s:CW=cw_new(n+n/4+2048,n+8192,n+1024,4096,256);
    let offs:[]u8=halloc(&s,(n+1)*4);
    let mx:i32=cw_fill(buf,offs);
    let bout:[]u8=halloc(&s,mx);
    let patch:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,corpus,0,buf.len);
    ingest_chunks(&s,offs,n,corpus);
    let d_idx:[]u8=halloc(&s,CW_M4_N*4);
    // plant: 100 boundary (j<100), 100 content (j>=100)
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    let j:i32=0;
    while(j<CW_M4_N){
        let idx:i32=j*n/CW_M4_N;
        iput(d_idx,j*4,idx);
        let id:i32=chunk_id(corpus,idx);
        if(j<100){
            c_defect_boundary(&s,id,iget(cyc,(j%12)*4));
        }else{
            let off:i32=coff(offs,idx);let len:i32=clen(offs,idx);
            if(is_code==1){code_rename(buf,off,len,patch);}
            else{patch_prose_xor(buf,off,len,patch);}
            c_defect_content(&s,id,patch,len);
        }
        j=j+1;
    }
    // revision episodes
    let rep_b:i32=0;let rep_c:i32=0;
    let ep:i32=1;
    while(ep<=20){
        j=0;
        while(j<CW_M4_N){
            c_revise(&s,buf,coffs,clens,chunk_id(corpus,iget(d_idx,j*4)));
            j=j+1;
        }
        rep_b=0;rep_c=0;
        j=0;
        while(j<100){
            rep_b=rep_b+unit_verified(&s,buf,coffs,clens,buf,offs,corpus,iget(d_idx,j*4),bout);
            j=j+1;
        }
        j=100;
        while(j<CW_M4_N){
            rep_c=rep_c+unit_verified(&s,buf,coffs,clens,buf,offs,corpus,iget(d_idx,j*4),bout);
            j=j+1;
        }
        if(rep_b+rep_c>=CW_M4_N){break;}
        ep=ep+1;
    }
    // classify kills
    let killed:i32=0;
    j=0;
    while(j<CW_M4_N){
        let sl:i32=slot_find(&s,chunk_id(corpus,iget(d_idx,j*4)));
        if(sl>=0){
            let f:i32=iget(s.flags,sl*4);
            if((f & F_LIVE)==0){killed=killed+1;}
        }else{killed=killed+1;}
        j=j+1;
    }
    let rev_bt:i64=(rep_b as i64)*1000/100;
    let rev_ct:i64=(rep_c as i64)*1000/100;
    let kill_t:i64=(killed as i64)*1000/(CW_M4_N as i64);
    let ksub:i32=0;
    if(kill_t>500 && (rev_bt<800 || rev_ct<800)){ksub=1;}
    _zag_print("M4,");_zag_print(keyp);_zag_print(",");
    p_dec1(rev_bt);_zag_print(",");p_dec1(rev_ct);_zag_print(",");
    p_dec1(kill_t);_zag_print(",");p_i64(ksub as i64);_zag_println("");
    let f:i32=0;
    j_begin(keyp);
    jf_dec1(&f,"m4_rev_boundary_tenths",rev_bt);
    jf_dec1(&f,"m4_rev_content_tenths",rev_ct);
    jf_dec1(&f,"m4_kill_rate_tenths",kill_t);
    jf_bool(&f,"m4_killsub",ksub);
    jf_int(&f,"m4_episodes",ep as i64);
    j_end();
    hfree(&s,bout);hfree(&s,patch);hfree(&s,offs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,cyc);hfree(&s,d_idx);
}

// ---- M5: resource pressure ----
fn t_m5(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0){_zag_println("M5,FATAL,empty-corpus");return;}
    let n:i32=cw_count(prose);
    let s:CW=cw_new(n+n/4+4096,n+4096,n+2048,4096,8);
    let offs:[]u8=halloc(&s,(n+1)*4);
    let mx:i32=cw_fill(prose,offs);
    let bout:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,CW_C_PROSE,0,prose.len);
    ingest_chunks(&s,offs,n,CW_C_PROSE);
    // mini-pressure: 500 fresh ingests + 500 kills
    let f:i32=0;
    while(f<500){
        c_ingest(&s,chunk_id(CW_C_FRESH,f),fr_off(f),fr_len(f,fresh.len),CW_C_FRESH,f);
        f=f+1;
    }
    f=0;
    while(f<500){c_kill(&s,chunk_id(CW_C_FRESH,f),2);f=f+1;}
    // learned = byte-exact recall now
    let l:i32=0;let src:i64=0;
    let i2:i32=0;
    while(i2<n){
        let id:i32=chunk_id(CW_C_PROSE,i2);
        let off:i32=coff(offs,i2);let len:i32=clen(offs,i2);
        let rl:i32=c_recall(&s,prose,coffs,clens,id,bout);
        if(rl==len){
            let good:i32=1;let q:i32=0;
            while(q<len){if(bout[q]!=prose[off+q]){good=0;break;}q=q+1;}
            if(good==1){l=l+1;src=src+(len as i64);}
        }
        i2=i2+1;
    }
    let slot_bytes:i64=(s.cap as i64)*28+(s.ins_cap as i64)*4;
    let ledger_bytes:i64=(s.led_n as i64)*64;
    // corpus buffer is the loaded prose buffer (harness fixture, reported)
    let wf:i32=write_ledger_file(".", "ledger.bin", &s);
    _zag_print("M5,");p_i64(l as i64);_zag_print(",");
    p_i64(src);_zag_print(",");p_i64(slot_bytes);_zag_print(",");
    p_i64(ledger_bytes);_zag_print(",");p_i64(wf as i64);_zag_println("");
    let ff:i32=0;
    j_begin("m5-1x");
    jf_int(&ff,"m5_units_learned",l as i64);
    jf_int(&ff,"m5_source_bytes_learned",src);
    jf_int(&ff,"m5_slot_table_bytes",slot_bytes);
    jf_int(&ff,"m5_ledger_bytes",ledger_bytes);
    jf_int(&ff,"m5_ledger_entries",s.led_n as i64);
    jf_int(&ff,"m5_corpus_buffer_bytes",prose.len as i64);
    j_end();
    hfree(&s,bout);hfree(&s,offs);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M6: transfer tax ----
fn t_m6(cdir:[]u8,dir:i32) void {
    // dir 0 = prose->code, 1 = code->prose
    let tname:[]u8="t1_prose.bin";let tcid:i32=CW_C_T1P;
    let yname:[]u8="code.bin";let ycid:i32=CW_C_CODE;
    let dkey:[]u8="m6-p2c-1x";let dtag:[]u8="p2c";
    if(dir==1){
        tname="t1_code.bin";tcid=CW_C_T1C;yname="prose.bin";ycid=CW_C_PROSE;
        dkey="m6-c2p-1x";dtag="c2p";
    }
    let tbuf:[]u8=read_file(cdir,tname);
    let ybuf:[]u8=read_file(cdir,yname);
    if(tbuf.len==0 || ybuf.len==0){_zag_println("M6,FATAL,empty-corpus");return;}
    let nt:i32=cw_count(tbuf);let ny:i32=cw_count(ybuf);
    let s:CW=cw_new(nt+ny+(nt+ny)/4+8192,nt*4+ny+8192,nt+ny+2048,4096,8);
    let toffs:[]u8=halloc(&s,(nt+1)*4);
    let yoffs:[]u8=halloc(&s,(ny+1)*4);
    let mxt:i32=cw_fill(tbuf,toffs);
    let mxy:i32=cw_fill(ybuf,yoffs);
    let mx:i32=mxt;if(mxy>mx){mx=mxy;}
    let bout:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,tcid,0,tbuf.len);
    reg_set(coffs,clens,ycid,0,ybuf.len);
    // train on tier-1 to the M2 criterion (policy frozen afterwards: no-op for C-W)
    let cok:i32=0;let bok:i32=0;
    let e:i32=1;let consec:i32=0;let etc:i32=50;
    while(e<=50){
        ingest_chunks(&s,toffs,nt,tcid);
        probe_chunks(&s,tbuf,coffs,clens,tbuf,toffs,nt,tcid,bout,&cok,&bok);
        if(cok>=995 && bok>=950){consec=consec+1;}else{consec=0;}
        if(consec>=3){etc=e-2;break;}
        e=e+1;
    }
    let rec_d:i64=cok as i64;let bnd_d:i64=bok as i64;
    let cyc:[]u8=halloc(&s,12*4);
    iput(cyc,0*4,1);iput(cyc,1*4,-1);iput(cyc,2*4,2);iput(cyc,3*4,-2);
    iput(cyc,4*4,4);iput(cyc,5*4,-4);iput(cyc,6*4,8);iput(cyc,7*4,-8);
    iput(cyc,8*4,16);iput(cyc,9*4,-16);iput(cyc,10*4,32);iput(cyc,11*4,-32);
    // in-domain revision: 100 boundary defects on train units
    let j:i32=0;
    while(j<100){
        let idx:i32=j*nt/100;
        c_defect_boundary(&s,chunk_id(tcid,idx),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        c_revise(&s,tbuf,coffs,clens,chunk_id(tcid,j*nt/100));
        j=j+1;
    }
    let rev_d:i32=0;
    j=0;
    while(j<100){
        rev_d=rev_d+unit_verified(&s,tbuf,coffs,clens,tbuf,toffs,tcid,j*nt/100,bout);
        j=j+1;
    }
    let rev_dt:i64=(rev_d as i64)*10;
    // transfer: face the new domain (ingest allowed, policy frozen)
    ingest_chunks(&s,yoffs,ny,ycid);
    let rec_t:i32=0;let bnd_t:i32=0;
    probe_chunks(&s,ybuf,coffs,clens,ybuf,yoffs,ny,ycid,bout,&rec_t,&bnd_t);
    // transfer revision
    j=0;
    while(j<100){
        let idx:i32=j*ny/100;
        c_defect_boundary(&s,chunk_id(ycid,idx),iget(cyc,(j%12)*4));
        j=j+1;
    }
    j=0;
    while(j<100){
        c_revise(&s,ybuf,coffs,clens,chunk_id(ycid,j*ny/100));
        j=j+1;
    }
    let rev_t:i32=0;
    j=0;
    while(j<100){
        rev_t=rev_t+unit_verified(&s,ybuf,coffs,clens,ybuf,yoffs,ycid,j*ny/100,bout);
        j=j+1;
    }
    let rev_tt:i64=(rev_t as i64)*10;
    let tax:i64=((rec_d-(rec_t as i64))+((bnd_d-(bnd_t as i64)))+(rev_dt-rev_tt))/3;
    _zag_print("M6,");_zag_print(dtag);_zag_print(",");
    p_dec1(rec_t as i64);_zag_print(",");p_dec1(bnd_t as i64);_zag_print(",");
    p_dec1(rev_tt);_zag_print(",");p_dec1(tax);_zag_println("");
    let f:i32=0;
    j_begin(dkey);
    jf_dec1(&f,"rec_tenths",rec_t as i64);
    jf_dec1(&f,"bnd_tenths",bnd_t as i64);
    jf_dec1(&f,"rev_tenths",rev_tt);
    jf_dec1(&f,"tax_tenths",tax);
    j_end();
    hfree(&s,bout);hfree(&s,toffs);hfree(&s,yoffs);hfree(&s,coffs);hfree(&s,clens);hfree(&s,cyc);
}

// ---- M7: ID-only (C-W is non-ID -> N/A + re-read byte count) ----
// C-W's chunk IDs are positional arithmetic ((corpus<<24)|index); there is no
// persistent ID→storage mapping the arm maintains (ARM_INTERFACE.md §9:
// cw is provisionally non-ID — CONFIRMED by this build).
fn t_m7(cdir:[]u8) void {
    let prose:[]u8=read_file(cdir,"prose.bin");
    if(prose.len==0){_zag_println("M7,FATAL,empty-corpus");return;}
    let n:i32=cw_count(prose);
    let mx0:i32=cw_maxlen(prose);
    let s:CW=cw_new(n+n/4+2048,2*n+65536,n+1024,mx0,(n/100)+16);
    let offs:[]u8=halloc(&s,(n+1)*4);
    let mx:i32=cw_fill(prose,offs);
    let bout:[]u8=halloc(&s,mx);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    reg_set(coffs,clens,CW_C_PROSE,0,prose.len);
    // round 0: ingest C; round 1: ingest C again (revive path)
    ingest_chunks(&s,offs,n,CW_C_PROSE);
    ingest_chunks(&s,offs,n,CW_C_PROSE);
    let reread:i64=0;
    let l:i32=0;
    while(l<1666){
        let idx:i32=(l*37)%n;
        let rl:i32=c_recall(&s,prose,coffs,clens,chunk_id(CW_C_PROSE,idx),bout);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    // round 2: C' = C with deterministic every-100th-chunk edits
    // (C-W edit mechanism: recorded byte patch, audited as trainer op)
    let ep2:[]u8=halloc(&s,mx);
    let q:i32=0;
    while(q<n){
        if(q%100==0){
            let off:i32=coff(offs,q);let len:i32=clen(offs,q);
            let a:i32=0;
            while(a<len){ep2[a]=prose[off+a];a=a+1;}
            ep2[0]=(ep2[0] as i32 ^ 255) as u8;
            c_defect_content(&s,chunk_id(CW_C_PROSE,q),ep2,len);
        }
        q=q+1;
    }
    hfree(&s,ep2);
    while(l<CW_M7_LOOKUPS){
        let idx:i32=(l*37)%n;
        let rl:i32=c_recall(&s,prose,coffs,clens,chunk_id(CW_C_PROSE,idx),bout);
        if(rl>0){reread=reread+(rl as i64);}
        l=l+1;
    }
    _zag_print("M7,non-id,");p_i64(reread);_zag_println("");
    let f:i32=0;
    j_begin("m7-1x");
    jf_null(&f,"m7_hit_rate_tenths");
    jf_null(&f,"m7_reuse_rate_tenths");
    jf_null(&f,"m7_dedup_savings_bytes");
    jf_str(&f,"m7_na_reason","no ID layer: chunk IDs are positional, lookup is by unit key");
    jf_int(&f,"m7_reread_bytes",reread);
    j_end();
    hfree(&s,bout);hfree(&s,offs);hfree(&s,coffs);hfree(&s,clens);
}

// ---- M8: determinism gate (N=5 adversarial full M1+M3 runs) ----
fn write_hex_line(dir:[]u8,fname:[]u8,tag:[]u8,hash:[]u8) i32 {
    // "<tag> <hex>\n"
    let hx:[]u8=ns_hex(hash);
    let line:[]u8=nio_alloc(tag.len+1+hx.len+1);
    let i:i32=0;while(i<tag.len){line[i]=tag[i];i=i+1;}
    line[tag.len]=32;
    let k:i32=0;while(k<hx.len){line[tag.len+1+k]=hx[k];k=k+1;}
    line[tag.len+1+hx.len]=10;
    let r:i32=write_file(dir,fname,line);
    nio_free(hx);nio_free(line);
    return r;
}
fn t_m8(cdir:[]u8,outdir:[]u8,pert:[]u8) void {
    // perturbations (raw allocations bypass the logged trace: the trace must
    // capture only the arm's own allocations, identical across perturbations)
    if(_zag_strcmp(pert,"frag")==1){
        let i:i32=0;
        while(i<256){
            let sz:i32=(i*37)%4096+16;
            let b:[]u8=nio_alloc(sz);
            if(i%3==0){nio_free(b);}
            // survivors leak intentionally: freed by OS at exit; identical each run
            i=i+1;
        }
    }
    let aslr_pad:[]u8="";
    if(_zag_strcmp(pert,"aslr")==1){
        aslr_pad=nio_alloc(1234567);
    }
    // freelist-rev / starve: accepted, documented no-ops for C-W
    // (slot placement is a pure function of unit ID; clock/entropy unused)
    let prose:[]u8=read_file(cdir,"prose.bin");
    let code:[]u8=read_file(cdir,"code.bin");
    let fresh:[]u8=read_file(cdir,"churn_fresh.bin");
    if(prose.len==0 || code.len==0 || fresh.len==0){_zag_println("M8,FATAL,empty-corpus");return;}
    let nun_p:i32=cw_count(prose);let nun_c:i32=cw_count(code);
    let s:CW=cw_new(nun_p+nun_c+(nun_p+nun_c)/4+16384,nun_p+nun_c+16000,
                    nun_p+nun_c+16000,4096,8);
    let poffs:[]u8=halloc(&s,(nun_p+1)*4);
    let coffs_c:[]u8=halloc(&s,(nun_c+1)*4);
    let mxp:i32=cw_fill(prose,poffs);
    let mxc:i32=cw_fill(code,coffs_c);
    let mx:i32=mxp;if(mxc>mx){mx=mxc;}
    if(mx<64){mx=64;}
    let bout:[]u8=halloc(&s,mx);
    let cbufs:[]u8=halloc(&s,prose.len+code.len+fresh.len);
    let coffs:[]u8=halloc(&s,32);let clens:[]u8=halloc(&s,32);
    let i:i32=0;while(i<prose.len){cbufs[i]=prose[i];i=i+1;}
    let j2:i32=0;while(j2<code.len){cbufs[prose.len+j2]=code[j2];j2=j2+1;}
    let j3:i32=0;while(j3<fresh.len){cbufs[prose.len+code.len+j3]=fresh[j3];j3=j3+1;}
    reg_set(coffs,clens,CW_C_PROSE,0,prose.len);
    reg_set(coffs,clens,CW_C_CODE,prose.len,code.len);
    reg_set(coffs,clens,CW_C_FRESH,prose.len+code.len,fresh.len);
    // M1: ingest + full recall both corpora
    ingest_chunks(&s,poffs,nun_p,CW_C_PROSE);
    let cok:i32=0;let bok:i32=0;
    probe_chunks(&s,cbufs,coffs,clens,prose,poffs,nun_p,CW_C_PROSE,bout,&cok,&bok);
    let m1p:i32=cok;
    ingest_chunks(&s,coffs_c,nun_c,CW_C_CODE);
    probe_chunks(&s,cbufs,coffs,clens,code,coffs_c,nun_c,CW_C_CODE,bout,&cok,&bok);
    let m1c:i32=cok;
    // M3 sequence on the same instance (V = every k-th chunk over both corpora)
    let total:i32=nun_p+nun_c;
    let k:i32=total/CW_M3_V;if(k<1){k=1;}
    let v:i32=0;
    while(v<CW_M3_V){
        let g:i32=v*k;
        let cid:i32=CW_C_PROSE;let idx:i32=g;
        if(g>=nun_p){cid=CW_C_CODE;idx=g-nun_p;}
        c_mark_valuable(&s,chunk_id(cid,idx));
        v=v+1;
    }
    let f:i32=0;
    while(f<CW_M3_FRESH1){
        c_ingest(&s,chunk_id(CW_C_FRESH,f),fr_off(f),fr_len(f,fresh.len),CW_C_FRESH,f);
        f=f+1;
    }
    f=0;
    while(f<CW_M3_KILL){c_kill(&s,chunk_id(CW_C_FRESH,f),1);f=f+1;}
    let w:i32=0;
    while(w<50){
        let g2:i32=(w*20)*k;
        let cid2:i32=CW_C_PROSE;let idx2:i32=g2;
        if(g2>=nun_p){cid2=CW_C_CODE;idx2=g2-nun_p;}
        c_weaken(&s,chunk_id(cid2,idx2),w+1);
        w=w+1;
    }
    f=CW_M3_FRESH1;
    while(f<CW_M3_FRESH1+CW_M3_FRESH2){
        let id:i32=chunk_id(CW_C_FRESH,f);
        let sl:i32=slot_insert(&s,id,fr_off(f),fr_len(f,fresh.len),CW_C_FRESH);
        if(sl<0){
            c_evict_oldest_unpinned(&s);
            sl=slot_insert(&s,id,fr_off(f),fr_len(f,fresh.len),CW_C_FRESH);
        }
        if(sl>=0){
            c_led(&s,OP_ADD,sl,0,fr_off(f),0,fr_len(f,fresh.len),CW_C_FRESH,id,
                  0,0,0,0,0,f,0);
        }
        f=f+1;
    }
    // artifacts
    // store stream: raw LE bytes of the slot arrays in fixed order
    // (ids, offs, lens, corps, flags, shifts, pidx: cap*4 each; ins: ins_cap*4),
    // hashed in 1MB logical chunks staged through a 1MB tmp (no >2^25 image).
    let cap:i32=s.cap;
    let cap4:i32=cap*4;
    let stotal:i32=cap4*7+s.ins_cap*4;
    let nch:i32=(stotal+1048575)/1048576;
    let chain_in:[]u8=halloc(&s,nch*32);
    let stmp:[]u8=halloc(&s,1048576);
    let sa0:[]u8=s.ids;let sa1:[]u8=s.offs;let sa2:[]u8=s.lens;let sa3:[]u8=s.corps;
    let sa4:[]u8=s.flags;let sa5:[]u8=s.shifts;let sa6:[]u8=s.pidx;let sa7:[]u8=s.ins;
    let ci:i32=0;
    while(ci<nch){
        let ca:i32=ci*1048576;let cb:i32=ca+1048576;
        if(cb>stotal){cb=stotal;}
        let p:i32=ca;
        while(p<cb){
            let ai:i32=p/cap4;
            let arr:[]u8=sa0;let alen:i32=cap4;
            if(ai==1){arr=sa1;}
            if(ai==2){arr=sa2;}
            if(ai==3){arr=sa3;}
            if(ai==4){arr=sa4;}
            if(ai==5){arr=sa5;}
            if(ai==6){arr=sa6;}
            if(ai==7){arr=sa7;alen=s.ins_cap*4;}
            let ao:i32=p-ai*cap4;
            let avail:i32=alen-ao;
            let need:i32=cb-p;
            if(avail>need){avail=need;}
            let tq:i32=p-ca;let qq:i32=ao;let kk:i32=0;
            while(kk<avail){stmp[tq]=arr[qq];tq=tq+1;qq=qq+1;kk=kk+1;}
            p=p+avail;
        }
        ns_sha256(stmp[0..cb-ca],chain_in[ci*32..ci*32+32]);
        ci=ci+1;
    }
    let chl:[]u8=halloc(&s,nch*80);
    let cho:i32=0;
    ci=0;
    while(ci<nch){
        let cs:i32=ci*32;
        let hx:[]u8=ns_hex(chain_in[cs..cs+32]);
        let tag:[]u8=_zag_i64_to_str(ci as i64);
        chl[cho]=99;chl[cho+1]=104;chl[cho+2]=117;chl[cho+3]=110;chl[cho+4]=107;cho=cho+5;
        let a2:i32=0;while(a2<tag.len){chl[cho]=tag[a2];cho=cho+1;a2=a2+1;}
        chl[cho]=32;cho=cho+1;
        let b2:i32=0;while(b2<hx.len){chl[cho]=hx[b2];cho=cho+1;b2=b2+1;}
        chl[cho]=10;cho=cho+1;
        nio_free(hx);nio_free(tag);
        ci=ci+1;
    }
    write_file(outdir,"store_hashes.txt",chl[0..cho]);
    let chain:[]u8=halloc(&s,32);
    ns_sha256(chain_in,chain);
    write_hex_line(outdir,"store_chain.txt","chain",chain);
    write_ledger_file(outdir,"ledger.bin",&s);
    let lhash:[]u8=halloc(&s,32);
    c_ledger_stream_hash(&s,lhash);
    write_hex_line(outdir,"ledger_chain.txt","chain",lhash);
    write_file(outdir,"alloc_trace.txt",s.trace[0..s.trace_n]);
    // stdout stays perturbation-agnostic: the runner's directory records which
    // perturbation ran, and m8_compare.py requires byte-identical stdout.
    _zag_print("M8,");
    p_dec1(m1p as i64);_zag_print(",");p_dec1(m1c as i64);_zag_print(",");
    p_i64(s.led_n as i64);_zag_println("");
    hfree(&s,bout);hfree(&s,poffs);hfree(&s,coffs_c);
    hfree(&s,cbufs);hfree(&s,coffs);hfree(&s,clens);
    hfree(&s,stmp);hfree(&s,chain_in);hfree(&s,chl);
    if(aslr_pad.len>0){nio_free(aslr_pad);}
    // frag survivors: freed by OS at exit
}

// ---- main dispatch ----
fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len==0){_zag_println("usage: cw <mode> [corpus-root] [outdir] [perturbation]");return 2;}
    let croot:[]u8=_zag_arg(2);
    if(_zag_strcmp(mode,"m1-1x-prose")==1){t_m1(croot,"prose.bin",CW_C_PROSE,"prose","m1-1x-prose");}
    else if(_zag_strcmp(mode,"m1-1x-code")==1){t_m1(croot,"code.bin",CW_C_CODE,"code","m1-1x-code");}
    else if(_zag_strcmp(mode,"m2-t1-prose")==1){t_m2(croot,"t1_prose.bin",CW_C_T1P,"m2-t1-prose",1);}
    else if(_zag_strcmp(mode,"m2-t1-code")==1){t_m2(croot,"t1_code.bin",CW_C_T1C,"m2-t1-code",1);}
    else if(_zag_strcmp(mode,"m2-t2-prose")==1){t_m2(croot,"t2_prose.bin",CW_C_T2P,"m2-t2-prose",0);}
    else if(_zag_strcmp(mode,"m2-t2-code")==1){t_m2(croot,"t2_code.bin",CW_C_T2C,"m2-t2-code",0);}
    else if(_zag_strcmp(mode,"m2-t3-1x")==1){t_m2(croot,"t3.bin",CW_C_T3,"m2-t3-1x",0);}
    else if(_zag_strcmp(mode,"m3-1x")==1){t_m3(croot);}
    else if(_zag_strcmp(mode,"m4-1x-prose")==1){t_m4(croot,"prose.bin",CW_C_PROSE,0,"m4-1x-prose");}
    else if(_zag_strcmp(mode,"m4-1x-code")==1){t_m4(croot,"code.bin",CW_C_CODE,1,"m4-1x-code");}
    else if(_zag_strcmp(mode,"m5-1x")==1){t_m5(croot);}
    else if(_zag_strcmp(mode,"m5-baseline")==1){
        // Empty-store RSS baseline: allocate the same empty store m5-1x uses,
        // touch it, then spin briefly so the harness RSS sampler can observe
        // the peak. The spin is measurement scaffolding, not arm cognition.
        let pbuf:[]u8=read_file(croot,"prose.bin");
        if(pbuf.len==0){_zag_println("M5,FATAL,empty-corpus");return 1;}
        let pn:i32=cw_count(pbuf);
        nio_free(pbuf);
        let bs:CW=cw_new(pn+pn/4+4096,pn+4096,pn+2048,4096,8);
        // fully touch the empty store so it is resident: the baseline RSS
        // must contain the whole slot region, leaving no double-count in
        // the literal (rss_delta + slot_table) formula (AMBIGUITIES.md A4).
        let b0:[]u8=bs.ids;let b1:[]u8=bs.offs;let b2:[]u8=bs.lens;let b3:[]u8=bs.corps;
        let b4:[]u8=bs.flags;let b5:[]u8=bs.shifts;let b6:[]u8=bs.pidx;let b7:[]u8=bs.ins;
        let bj:i32=0;
        while(bj<b0.len){b0[bj]=0;b1[bj]=0;b2[bj]=0;b3[bj]=0;b4[bj]=0;b5[bj]=0;b6[bj]=0;bj=bj+1;}
        bj=0;
        while(bj<b7.len){b7[bj]=0;bj=bj+1;}
        _zag_println("M5_BASELINE,ok");
        let f:i32=0;
        j_begin("m5-baseline");
        jf_bool(&f,"m5_baseline",1);
        j_end();
        let spin:i64=0;while(spin<300000000){spin=spin+1;}
    }
    else if(_zag_strcmp(mode,"m6-p2c-1x")==1){t_m6(croot,0);}
    else if(_zag_strcmp(mode,"m6-c2p-1x")==1){t_m6(croot,1);}
    else if(_zag_strcmp(mode,"m7-1x")==1){t_m7(croot);}
    else if(_zag_strcmp(mode,"m8-1x")==1){
        let outdir:[]u8=_zag_arg(3);
        let pert:[]u8=_zag_arg(4);
        if(outdir.len==0 || pert.len==0){
            _zag_println("usage: cw m8-1x <corpus-root> <outdir> <perturbation>");
            return 2;
        }
        t_m8(croot,outdir,pert);
    }
    else{_zag_print("unknown mode: ");_zag_println(mode);return 2;}
    return 0;
}

// tests/test_pins.zag — force-pin blocking test (REWRITTEN 2026-09-21).
//
// REWRITE RATIONALE (RDTDT D2-A Scope-S verdict, executed per Micah's standing
// instruction that evidence-decided items land, not park):
//   1. The old suite's only pin primitive, pins_add (store.zag:149-157), is
//      DELETED: the learner-side writer violated Micah's ruling 3/3 (HTD Test
//      5) — no erase-cost linkage, no unpin path, trainer could not clear or
//      override it, and it wrote zero audit records (HTD Test 4 A1).
//   2. The old suite was VACUOUS (T1-VACUITY): the "pinned" retest proposed
//      the already-adopted span, so the already-adopted pre-check fired
//      before the pin path; the suite stayed green under a neutered fp_check
//      — it certified behavior it could not detect. Its header also always
//      described the learner-side registry, never the B.6 force-pin.
// The replacement below is the HTD Test 3 §4 probe pattern
// (~/workspace/pins-rdtdt/t1-3/harness/t13_hardened.zag, proven T2-alpha:
// N=5 PASS on the real Scope-S tree; FAIL under fp_check->0 mutation):
// fresh DLB, trainer force-pin installed via fp_pin(FP_CALLER_TRAINER) on a
// span NEVER proposed before, then proposals with good grounds.
// The test acts as trainer installing a force-pin; HTD Sim B proved this
// byte-identical to a baseline with the pin installed externally.
// PORTS (RDTDT P3 orphan resolutions, handed to this suite's owner):
//   S4 (fp-pinned retract refused, op=34/rc=102 audited),
//   S5 (learner fp_unpin refused 101, pin persists),
//   S6 (trainer fp_unpin clears, retract then succeeds),
//   test4 Scenario B (op=27 pin entry, op=34 gate refusal, forged learner
//   pin attempt refused 101 AND audited, pin NOT set),
//   test5 dedup (fp contrast fp_pin(T) rc=0 / fp_gate_kill=102;
//   fp_unpin(TRAINER)->103 / fp_unpin(LEARNER)->101 on unpinned spans;
//   fp round-trip leaves the old Pins registry at 0).
// Pure Zag. Zero RNG, zero wallclock. Byte-identical across reruns.

@import("../driver.zag")

// has_pinres_event: scan tape DELIB frames for EV_PINRES (code 8) with the
// given raw value (1/2 = old registry, 100 = no-fp baseline, 101/102 = fp
// veto, 302 = fp gate refusal). The force-pin refusal must be attributable.
fn has_pinres_event(t:*Tape, want:i64) i64 {
    let buf:[]u8 = t[0].buf
    let n:i64 = t[0].len
    let at:i64 = 0
    while (at < n) {
        let flen:i64 = p_get32(buf, at)
        let ftyp:i64 = p_get16(buf, at + 4)
        let bo:i64 = at + 14
        if (ftyp == 5) {
            let evn:i64 = (buf[bo + 9]) as i64
            let j:i64 = 0
            while (j < evn) {
                let e:i64 = p_get64(buf, bo + 10 + j * 8)
                if ((e >> 48) == 8 && (e & 0xFFFFFFFFFFFF) == want) { return 1 }
                j = j + 1
            }
        }
        at = at + 4 + flen  // wire frame = u32 len + payload(flen)
    }
    return 0
}

fn mk_text() []u8 {
    let s:[]u8 = "the cat sat on the mat. the cat ran."
    let text:[]u8 = nio_alloc(64)
    let i:i64 = 0
    while (i < s.len) { text[i] = s[i]; i = i + 1 }
    return text[0..s.len]
}

fn mk_grounds() []u8 {
    let gs:[]i64 = nio_alloc(16) as []i64
    let ge:[]i64 = nio_alloc(16) as []i64
    gs[0] = 0; ge[0] = 7; gs[1] = 24; ge[1] = 31
    let gr:[]u8 = nio_alloc(32)
    p_pack(gr, 2, gs, ge)
    return gr
}

fn main() i32 {
    let ok:i64 = 1
    let aux:[]u8 = nio_alloc(1)[0..0]
    let gr:[]u8 = mk_grounds()
    let tx:[]u8 = mk_text()

    // ============ SECTION A: probe pattern (t13_hardened) ============
    let d:*DLB = dlb_new(tx, tx.len, 5, 3, 256, 2, 2)
    let t:*Tape = tape_new()

    // Pin BEFORE propose: trainer force-pin [0,7) on a fresh DLB.
    let fr:i64 = fp_pin(d[0].fpins, FP_CALLER_TRAINER, 1, 0, 7)
    _zag_print("fp_pin rc="); _zag_print(_zag_i64_to_str(fr)); _zag_print("\n")
    if (fr != 0) { _zag_print("FAIL A: fp_pin rc\n"); ok = 0 }

    // Exact span [0,7): must REFUSE with frozen R2 (CONFLICTS_PINNED).
    let w2:[]u8 = p_encode(1, 1, 201, P_K_WORD_SPAN, 0, 7, 150, aux, gr)
    drv_consider_wire(d, t, w2)
    let v1:i64 = d[0].dec_verdict
    let r1:i64 = d[0].dec_reason
    _zag_print("exact verdict="); _zag_print(_zag_i64_to_str(v1))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(r1)); _zag_print("\n")
    if (v1 != 3 || r1 != 2) { _zag_print("FAIL A: exact span not refused w/ R2\n"); ok = 0 }

    // Overlapping span [2,9): must REFUSE with R2.
    let w3:[]u8 = p_encode(1, 1, 202, P_K_WORD_SPAN, 2, 9, 150, aux, gr)
    drv_consider_wire(d, t, w3)
    let v2:i64 = d[0].dec_verdict
    let r2:i64 = d[0].dec_reason
    _zag_print("overlap verdict="); _zag_print(_zag_i64_to_str(v2))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(r2)); _zag_print("\n")
    if (v2 != 3 || r2 != 2) { _zag_print("FAIL A: overlap span not refused w/ R2\n"); ok = 0 }

    // Clear span [24,31): must ADOPT (seq 203, used by S4/S6 below).
    let w4:[]u8 = p_encode(1, 1, 203, P_K_WORD_SPAN, 24, 31, 150, aux, gr)
    drv_consider_wire(d, t, w4)
    let v3:i64 = d[0].dec_verdict
    _zag_print("clear verdict="); _zag_print(_zag_i64_to_str(v3)); _zag_print("\n")
    if (v3 != 1) { _zag_print("FAIL A: clear span should ADOPT\n"); ok = 0 }

    // ============ SECTION B (PORT S4): fp-pinned retract refused ============
    let hst:[]i64 = d[0].hs[0].status
    let fpn0:i64 = fp_audit_n(d[0].fpins)
    let frc:i64 = fp_pin(d[0].fpins, FP_CALLER_TRAINER, 7, 24, 31)
    let wr3:[]u8 = p_encode(1, 1, 300, P_K_RETRACT, 203, 204, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d, t, wr3)
    let v4:i64 = d[0].dec_verdict
    let r4:i64 = d[0].dec_reason
    let st4:i64 = hst[d[0].dec_hyp]
    let fpn1:i64 = fp_audit_n(d[0].fpins)
    _zag_print("S4 retract B (fp-pinned): verdict="); _zag_print(_zag_i64_to_str(v4))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(r4))
    _zag_print(" hyp_status="); _zag_print(_zag_i64_to_str(st4))
    _zag_print(" fp_pin rc="); _zag_print(_zag_i64_to_str(frc)); _zag_print("\n")
    if (frc != 0) { _zag_print("FAIL B: fp_pin rc\n"); ok = 0 }
    if (v4 != 3 || r4 != 2 || st4 != 1) { _zag_print("FAIL B: retract should refuse 3/2, unit stays HS_ADOPTED(1)\n"); ok = 0 }
    // The gate refusal must be audited in the FP ledger as op=34 rc=102
    // (scan only the delta: earlier sections legitimately contain op=34s).
    let g34:i64 = 0
    let fi:i64 = fpn0
    while (fi < fpn1) {
        if (fp_entry_op(d[0].fpins, fi) == 34 && fp_entry_rc(d[0].fpins, fi) == 102) { g34 = 1 }
        fi = fi + 1
    }
    _zag_print("S4 op=34/rc=102 in delta="); _zag_print(_zag_i64_to_str(g34))
    _zag_print(" fp_audit_delta="); _zag_print(_zag_i64_to_str(fpn1 - fpn0)); _zag_print("\n")
    if (g34 != 1) { _zag_print("FAIL B: op=34/rc=102 not audited\n"); ok = 0 }

    // ============ SECTION C (PORT S5): learner unpin refused ============
    let fu:i64 = fp_unpin(d[0].fpins, FP_CALLER_LEARNER, 7, 24, 31)
    let fc:i64 = fp_check(d[0].fpins, 24, 31)
    _zag_print("S5 fp_unpin(LEARNER) rc="); _zag_print(_zag_i64_to_str(fu))
    _zag_print(" fp_check="); _zag_print(_zag_i64_to_str(fc)); _zag_print("\n")
    if (fu != 101 || fc == 0) { _zag_print("FAIL C: learner unpin must refuse 101, pin persists\n"); ok = 0 }

    // ============ SECTION D (PORT S6): trainer unpin clears ============
    let wu:i64 = fp_unpin(d[0].fpins, FP_CALLER_TRAINER, 7, 24, 31)
    let wr31:[]u8 = p_encode(1, 1, 301, P_K_RETRACT, 203, 204, 0, aux, nio_alloc(1)[0..0])
    drv_consider_wire(d, t, wr31)
    let dh6:i64 = d[0].dec_hyp
    let st6:i64 = -1
    if (dh6 >= 0) { st6 = hst[dh6] }
    _zag_print("S6 fp_unpin(TRAINER) rc="); _zag_print(_zag_i64_to_str(wu))
    _zag_print(" retract verdict="); _zag_print(_zag_i64_to_str(d[0].dec_verdict))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(d[0].dec_reason))
    _zag_print(" hyp_status="); _zag_print(_zag_i64_to_str(st6)); _zag_print("\n")
    if (wu != 0 || d[0].dec_verdict != 1 || d[0].dec_reason != 7 || st6 != 4) { _zag_print("FAIL D: unpin rc=0 then retract 1/7, unit HS_KILLED(4)\n"); ok = 0 }

    // Attribution: the force-pin refusal must be distinguishable in the tape.
    if (has_pinres_event(t, 101) == 0) {
        _zag_print("FAIL A: EV_PINRES(101) missing from tape\n"); ok = 0
    } else {
        _zag_print("EV_PINRES(101) present\n")
    }
    tape_free(t)

    // ============ SECTION E (PORT test4 Scenario B) ============
    let d2:*DLB = dlb_new(tx, tx.len, 5, 3, 256, 2, 2)
    let t2:*Tape = tape_new()
    let fpp:*FPStore = d2[0].fpins
    let rc2:i64 = fp_pin(fpp, FP_CALLER_TRAINER, 7, 10, 20)
    _zag_print("B1 fp_pin(T,7,[10,20)) rc="); _zag_print(_zag_i64_to_str(rc2)); _zag_print("\n")
    if (rc2 != 0) { _zag_print("FAIL E1: fp_pin rc\n"); ok = 0 }
    // The pin is audited as a forcepin-audit op=27 entry with trainer origin.
    if (fp_entry_op(fpp, 0) != 27 || fp_entry_rc(fpp, 0) != 0 ||
        fp_entry_d1(fpp, 0) != 1 || fp_entry_d2(fpp, 0) != 7) {
        _zag_print("FAIL E1: op=27 entry wrong\n"); ok = 0
    } else {
        _zag_print("B1 op=27 entry ok (d1=trainer,d2=7)\n")
    }
    // Grounds for a [10,20) proposal (in-bounds; the pin check dominates).
    let gs2:[]i64 = nio_alloc(16) as []i64
    let ge2:[]i64 = nio_alloc(16) as []i64
    gs2[0] = 10; ge2[0] = 20; gs2[1] = 24; ge2[1] = 31
    let gr2:[]u8 = nio_alloc(32)
    p_pack(gr2, 2, gs2, ge2)
    let b0:i64 = fp_audit_n(fpp)
    let wb:[]u8 = p_encode(1, 1, 102, P_K_WORD_SPAN, 10, 20, 150, aux, gr2)
    drv_consider_wire(d2, t2, wb)
    let vb:i64 = d2[0].dec_verdict
    let rb:i64 = d2[0].dec_reason
    _zag_print("B2 blocked proposal verdict="); _zag_print(_zag_i64_to_str(vb))
    _zag_print(" reason="); _zag_print(_zag_i64_to_str(rb))
    _zag_print(" fp_audit_delta="); _zag_print(_zag_i64_to_str(fp_audit_n(fpp) - b0)); _zag_print("\n")
    if (vb != 3 || rb != 2) { _zag_print("FAIL E2: blocked proposal must refuse 3/2\n"); ok = 0 }
    if (fp_find_entry(fpp, 34, 102) < b0) { _zag_print("FAIL E2: op=34 gate refusal not audited\n"); ok = 0 }

    // Forged learner pin attempt on a FRESH dlb: refused 101 AND audited.
    let d3:*DLB = dlb_new(tx, tx.len, 5, 3, 256, 2, 2)
    let fpp3:*FPStore = d3[0].fpins
    let frc3:i64 = fp_pin(fpp3, FP_CALLER_LEARNER, 9, 10, 20)
    _zag_print("B3 forged fp_pin(LEARNER) rc="); _zag_print(_zag_i64_to_str(frc3))
    _zag_print(" fp_check="); _zag_print(_zag_i64_to_str(fp_check(fpp3, 10, 20))); _zag_print("\n")
    if (frc3 != 101) { _zag_print("FAIL E3: forged attempt must refuse 101\n"); ok = 0 }
    if (fp_entry_op(fpp3, 0) != 27 || fp_entry_rc(fpp3, 0) != 101 ||
        fp_entry_d1(fpp3, 0) != 0) {
        _zag_print("FAIL E3: forged attempt not audited as learner's\n"); ok = 0
    }
    if (fp_check(fpp3, 10, 20) != 0) { _zag_print("FAIL E3: pin must NOT be set\n"); ok = 0 }
    tape_free(t2)

    // ============ SECTION F (PORT test5 dedup): fp contrast ============
    let gk:i64 = fp_gate_kill(fpp, 10, 20)
    _zag_print("Q1 contrast: fp_gate_kill(fp-pinned)= "); _zag_print(_zag_i64_to_str(gk)); _zag_print("\n")
    if (gk != 102) { _zag_print("FAIL F: fp_gate_kill must be 102\n"); ok = 0 }
    let u1:i64 = fp_unpin(fpp, FP_CALLER_TRAINER, 7, 50, 60)
    let u2:i64 = fp_unpin(fpp, FP_CALLER_LEARNER, 7, 50, 60)
    _zag_print("Q2 fp_unpin(TRAINER,[50,60)) rc="); _zag_print(_zag_i64_to_str(u1))
    _zag_print(" fp_unpin(LEARNER) rc="); _zag_print(_zag_i64_to_str(u2)); _zag_print("\n")
    if (u1 != 103) { _zag_print("FAIL F: trainer unpin of unpinned span must be 103\n"); ok = 0 }
    if (u2 != 101) { _zag_print("FAIL F: learner unpin must refuse 101\n"); ok = 0 }
    // Round-trip on a disjoint span; the old learner-side Pins registry —
    // writer deleted under Scope-S — must remain untouched (0).
    let fq1:i64 = fp_pin(fpp, FP_CALLER_TRAINER, 9, 30, 40)
    let fq2:i64 = fp_unpin(fpp, FP_CALLER_TRAINER, 9, 30, 40)
    let pcq:i64 = pins_check(d2[0].pins, 30, 40)
    _zag_print("Q3 round-trip: fp_pin rc="); _zag_print(_zag_i64_to_str(fq1))
    _zag_print(" fp_unpin rc="); _zag_print(_zag_i64_to_str(fq2))
    _zag_print(" old pins_check="); _zag_print(_zag_i64_to_str(pcq)); _zag_print("\n")
    if (fq1 != 0 || fq2 != 0 || pcq != 0) { _zag_print("FAIL F: round-trip or old-registry check\n"); ok = 0 }

    if (ok == 1) { _zag_print("PINS PASS\n") } else { _zag_print("PINS FAIL\n") }
    return 1 - ok
}

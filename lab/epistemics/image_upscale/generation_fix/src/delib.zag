// delib.zag — TNN deliberation on the brick-on-arch key-ambiguity failure.
//
// Runs TNN's deliberation machinery (survey -> per-block measurement ->
// deliberate with recorded reasons) on the bridge input BEFORE the
// head-to-head test decides. For each 32x32 block at si=0 it replicates the
// baseline SHAPES take decision and each arm-rule's take decision,
// measuring: sigma2_B vs tau_min, ambiguity count (atoms within 2x winner
// SSD), winner key-variance, winner full-res energy, correlation P.
//
// The bad take = the baseline-TAKEN smooth block (sigma2_B < tau_min) whose
// winner has maximal full-res energy (the brick-on-arch archetype).
// The deliberation VOTES for the arm-rule that rejects the bad take with
// the FEWEST total extra rejections across all blocks; tie-break by arm
// order 2, 3, 1. The vote is ADVISORY — the head-to-head test decides.
//
// Learned constants (from corpstat.zag on vocab.bin, cross-checked Python):
//   TAU_MIN = 2985492 (25th pct atom key-variance x1000)
//   R_BAND  = 1153    (75th pct full-res/key energy ratio x1000)
// Pure Zag, zero RNG. argv: 1=indir (vocab.bin, input.bmp) 2=outdir.
@import("./common_az.zag")

// learned constants with provenance (corpstat.zag, 2026-09-26)
fn TAU_MIN() i64 { return 2985492; }
fn R_BAND() i64 { return 1153; }

fn d_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn d_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}

fn d_vocab_load(root:i64, vbuf:[]u8, vcap:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64) i64 {
    let fd:i64 = nio_open_child(root, "vocab.bin", 0);
    if (fd < 0) { return 1; }
    let n:i64 = nio_read_exact(fd, vbuf, vcap - 1);
    nio_close(fd);
    if (n < 48) { return 2; }
    if (vbuf[0] != 86) { return 3; }
    if (vbuf[1] != 79) { return 4; }
    if (vbuf[2] != 67) { return 5; }
    if (vbuf[3] != 50) { return 6; }
    let ns:i64 = r_u32le(vbuf, 4);
    if (ns != 5) { return 7; }
    let off:i64 = 48;
    let si:i64 = 0;
    while (si < 5) {
        let S:i64 = r_u32le(vbuf, 8 + si * 8);
        let K:i64 = r_u32le(vbuf, 8 + si * 8 + 4);
        vS[si] = S; vK[si] = K;
        let mb:i64 = S * S * 3 * 2;
        let s2:i64 = S / 2;
        let kmb:i64 = s2 * s2 * 3 * 2;
        vab[si] = off;
        off = off + K * mb;
        vkb[si] = off;
        off = off + K * kmb;
        si = si + 1;
    }
    if (off > n) { return 8; }
    return 0;
}

fn d_load_bmp(root:i64, name:[]u8, px:[]i64, npix:i64, hout:[]i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { nio_close(fd); return -2; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { nio_free(fbuf); return -3; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    if (w * h > npix) { nio_free(fbuf); return -4; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            px[p] = fbuf[q + 2] as i64;
            px[p + 1] = fbuf[q + 1] as i64;
            px[p + 2] = fbuf[q] as i64;
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    hout[0] = h;
    return w;
}

// key mean (kr,kg,kb) + sse of block dev vs (key-kmean); P = inner product.
// mean[3] in, kmean[3] out, sse/P out.
fn d_key_stats(px:[]i64, w:i64, bx:i64, by:i64, bw:i64, bh:i64,
    mean:[]i64, vbuf:[]u8, kbase:i64, s:i64,
    kmean:[]i64, sseout:[]i64, pout:[]i64) void {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let ky:i64 = 0;
    while (ky < bh) {
        let kx:i64 = 0;
        while (kx < bw) {
            let q:i64 = kbase + (ky * s + kx) * 6;
            sr = sr + r_i16le(vbuf, q);
            sg = sg + r_i16le(vbuf, q + 2);
            sb = sb + r_i16le(vbuf, q + 4);
            kx = kx + 1;
        }
        ky = ky + 1;
    }
    let n:i64 = bw * bh;
    let kr:i64 = sr / n; let kg:i64 = sg / n; let kb:i64 = sb / n;
    kmean[0] = kr; kmean[1] = kg; kmean[2] = kb;
    let mr:i64 = mean[0]; let mg:i64 = mean[1]; let mb:i64 = mean[2];
    let sse:i64 = 0;
    let P:i64 = 0;
    let y2:i64 = 0;
    while (y2 < bh) {
        let x2:i64 = 0;
        while (x2 < bw) {
            let p:i64 = ((by + y2) * w + (bx + x2)) * 3;
            let q2:i64 = kbase + (y2 * s + x2) * 6;
            let bd0:i64 = px[p] - mr;
            let bd1:i64 = px[p + 1] - mg;
            let bd2:i64 = px[p + 2] - mb;
            let kd0:i64 = r_i16le(vbuf, q2) - kr;
            let kd1:i64 = r_i16le(vbuf, q2 + 2) - kg;
            let kd2:i64 = r_i16le(vbuf, q2 + 4) - kb;
            let r0:i64 = bd0 - kd0;
            let r1:i64 = bd1 - kd1;
            let r2:i64 = bd2 - kd2;
            sse = sse + r0 * r0 + r1 * r1 + r2 * r2;
            P = P + bd0 * kd0 + bd1 * kd1 + bd2 * kd2;
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    sseout[0] = sse;
    pout[0] = P;
    return;
}

// coarse (2x2-box) sse of block dev vs (atom coarse key - its mean)
fn d_coarse_sse(px:[]i64, w:i64, bx:i64, by:i64, bw:i64, bh:i64,
    mean:[]i64, vbuf:[]u8, kbase:i64, s:i64) i64 {
    let cbw:i64 = bw / 2;
    let cbh:i64 = bh / 2;
    // atom coarse key mean
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let cy:i64 = 0;
    while (cy < cbh) {
        let cx:i64 = 0;
        while (cx < cbw) {
            let c:i64 = 0;
            while (c < 3) {
                let sv:i64 = r_i16le(vbuf, kbase + ((2*cy)*s + 2*cx)*6 + c*2)
                    + r_i16le(vbuf, kbase + ((2*cy)*s + 2*cx+1)*6 + c*2)
                    + r_i16le(vbuf, kbase + ((2*cy+1)*s + 2*cx)*6 + c*2)
                    + r_i16le(vbuf, kbase + ((2*cy+1)*s + 2*cx+1)*6 + c*2);
                let v:i64 = 0;
                if (sv >= 0) { v = (sv + 2) / 4; } else { v = (sv - 2) / 4; }
                if (c == 0) { sr = sr + v; }
                if (c == 1) { sg = sg + v; }
                if (c == 2) { sb = sb + v; }
                c = c + 1;
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    let n:i64 = cbw * cbh;
    let kr:i64 = sr / n; let kg:i64 = sg / n; let kb:i64 = sb / n;
    let mr:i64 = mean[0]; let mg:i64 = mean[1]; let mb:i64 = mean[2];
    let sse:i64 = 0;
    cy = 0;
    while (cy < cbh) {
        let cx:i64 = 0;
        while (cx < cbw) {
            // block coarse deviation: 2x2 box of (px - mean)
            let bdr:i64 = 0; let bdg:i64 = 0; let bdb:i64 = 0;
            let dy:i64 = 0;
            while (dy < 2) {
                let dx:i64 = 0;
                while (dx < 2) {
                    let p:i64 = ((by + 2*cy + dy) * w + (bx + 2*cx + dx)) * 3;
                    bdr = bdr + px[p] - mr;
                    bdg = bdg + px[p + 1] - mg;
                    bdb = bdb + px[p + 2] - mb;
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            let c:i64 = 0;
            while (c < 3) {
                let sv:i64 = r_i16le(vbuf, kbase + ((2*cy)*s + 2*cx)*6 + c*2)
                    + r_i16le(vbuf, kbase + ((2*cy)*s + 2*cx+1)*6 + c*2)
                    + r_i16le(vbuf, kbase + ((2*cy+1)*s + 2*cx)*6 + c*2)
                    + r_i16le(vbuf, kbase + ((2*cy+1)*s + 2*cx+1)*6 + c*2);
                let kv:i64 = 0;
                if (sv >= 0) { kv = (sv + 2) / 4; } else { kv = (sv - 2) / 4; }
                let bd:i64 = 0; let km:i64 = 0;
                if (c == 0) { bd = bdr; km = kr; }
                if (c == 1) { bd = bdg; km = kg; }
                if (c == 2) { bd = bdb; km = kb; }
                // block coarse dev is a SUM over 4; compare against 4x atom
                // coarse value: scale atom side by 4 for comparable units
                let r:i64 = bd - 4 * (kv - km);
                sse = sse + r * r;
                c = c + 1;
            }
            cx = cx + 1;
        }
        cy = cy + 1;
    }
    return sse;
}

fn d_fit(px:[]i64, w:i64, h:i64, x:i64, y:i64, bw:i64, bh:i64, si:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64, vbuf:[]u8,
    takes:[]i64, ntout:[]i64, nofits:[]i64, nnout:[]i64) i64 {
    let S:i64 = vS[si];
    let K:i64 = vK[si];
    let s:i64 = S / 2;
    let vab_si:i64 = vab[si];
    let vkb_si:i64 = vkb[si];
    let kmb:i64 = s * s * 3 * 2;
    let n:i64 = bw * bh;
    let nval:i64 = n * 3;
    // block mean + energy (measured)
    let mr:i64 = 0; let mg:i64 = 0; let mb:i64 = 0;
    let yy:i64 = 0;
    while (yy < bh) {
        let xx:i64 = 0;
        while (xx < bw) {
            let p:i64 = ((y + yy) * w + (x + xx)) * 3;
            mr = mr + px[p]; mg = mg + px[p + 1]; mb = mb + px[p + 2];
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    mr = mr / n; mg = mg / n; mb = mb / n;
    let e:i64 = 0;
    yy = 0;
    while (yy < bh) {
        let xx:i64 = 0;
        while (xx < bw) {
            let p2:i64 = ((y + yy) * w + (x + xx)) * 3;
            let d0:i64 = px[p2] - mr;
            let d1:i64 = px[p2 + 1] - mg;
            let d2:i64 = px[p2 + 2] - mb;
            e = e + d0 * d0 + d1 * d1 + d2 * d2;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    // best shared atom (key top-left bw*bh vs block deviations)
    // atom 0 is the NULL atom: sse = e, gain 0.
    let best:i64 = 0;
    let bsse:i64 = e;
    let ai:i64 = 1;
    while (ai < K) {
        let kr:i64 = 0; let kg:i64 = 0; let kb:i64 = 0;
        let ky:i64 = 0;
        while (ky < bh) {
            let kx:i64 = 0;
            while (kx < bw) {
                let q:i64 = vkb_si + ai * kmb + (ky * s + kx) * 6;
                kr = kr + r_i16le(vbuf, q);
                kg = kg + r_i16le(vbuf, q + 2);
                kb = kb + r_i16le(vbuf, q + 4);
                kx = kx + 1;
            }
            ky = ky + 1;
        }
        kr = kr / n; kg = kg / n; kb = kb / n;
        let sse:i64 = 0;
        let y2:i64 = 0;
        while (y2 < bh) {
            let x2:i64 = 0;
            while (x2 < bw) {
                let p3:i64 = ((y + y2) * w + (x + x2)) * 3;
                let q2:i64 = vkb_si + ai * kmb + (y2 * s + x2) * 6;
                let d0:i64 = (px[p3] - mr) - (r_i16le(vbuf, q2) - kr);
                let d1:i64 = (px[p3 + 1] - mg) - (r_i16le(vbuf, q2 + 2) - kg);
                let d2:i64 = (px[p3 + 2] - mb) - (r_i16le(vbuf, q2 + 4) - kb);
                sse = sse + d0 * d0 + d1 * d1 + d2 * d2;
                x2 = x2 + 1;
            }
            y2 = y2 + 1;
        }
        if (sse < bsse) { bsse = sse; best = ai; }
        ai = ai + 1;
    }
    let gain_take:i64 = e - bsse;
    let bar:i64 = 9 * nval;
    // try the finer split
    let can_split:i64 = 0;
    if (si < 3) {
        if (bw >= 8) {
            if (bh >= 8) { can_split = 1; }
        }
    }
    if (can_split == 1) {
        let nt0:i64 = ntout[0];
        let nn0:i64 = nnout[0];
        let hw:i64 = bw / 2;
        let hh:i64 = bh / 2;
        let g0:i64 = d_fit(px, w, h, x, y, hw, hh, si + 1,
            vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
        let g1:i64 = d_fit(px, w, h, x + hw, y, bw - hw, hh, si + 1,
            vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
        let g2:i64 = d_fit(px, w, h, x, y + hh, hw, bh - hh, si + 1,
            vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
        let g3:i64 = d_fit(px, w, h, x + hw, y + hh, bw - hw, bh - hh, si + 1,
            vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
        let gain_split:i64 = g0 + g1 + g2 + g3;
        if (gain_split > gain_take) {
            if (gain_split >= bar) {
                return gain_split;
            }
        }
        // split loses: truncate the children's records, try TAKE
        ntout[0] = nt0;
        nnout[0] = nn0;
    }
    if (gain_take >= bar) {
        let nt:i64 = ntout[0];
        takes[nt * 9] = x;
        takes[nt * 9 + 1] = y;
        takes[nt * 9 + 2] = bw;
        takes[nt * 9 + 3] = bh;
        takes[nt * 9 + 4] = si;
        takes[nt * 9 + 5] = best;
        takes[nt * 9 + 6] = mr;
        takes[nt * 9 + 7] = mg;
        takes[nt * 9 + 8] = mb;
        ntout[0] = nt + 1;
        return gain_take;
    }
    if (si == 0) {
        let nn:i64 = nnout[0];
        nofits[nn * 4] = x;
        nofits[nn * 4 + 1] = y;
        nofits[nn * 4 + 2] = bw;
        nofits[nn * 4 + 3] = bh;
        nnout[0] = nn + 1;
    }
    return 0;
}

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }

    let vbuf:[]u8 = nio_alloc(4194304);
    let vS:[]i64 = nio_alloc(40) as []i64;
    let vK:[]i64 = nio_alloc(40) as []i64;
    let vab:[]i64 = nio_alloc(40) as []i64;
    let vkb:[]i64 = nio_alloc(40) as []i64;
    if (vbuf.len == 0) { _zag_println("alloc vbuf failed"); return 1; }
    let vrc:i64 = d_vocab_load(root, vbuf, 4194304, vS, vK, vab, vkb);
    if (vrc != 0) { _zag_println("vocab load failed"); return 1; }

    // per-atom full-res energy per value x1000, scales 0..3
    let eAA:[]i64 = nio_alloc((256 * 8) as i32) as []i64;
    let si:i64 = 0;
    while (si < 4) {
        let S:i64 = vS[si];
        let K:i64 = vK[si];
        let nfull:i64 = S * S * 3;
        let ai:i64 = 0;
        while (ai < K) {
            let ab:i64 = vab[si] + ai * (nfull * 2);
            let essd:i64 = 0;
            let k:i64 = 0;
            while (k < nfull / 3) {
                let d0:i64 = r_i16le(vbuf, ab + k * 6);
                let d1:i64 = r_i16le(vbuf, ab + k * 6 + 2);
                let d2:i64 = r_i16le(vbuf, ab + k * 6 + 4);
                essd = essd + d0 * d0 + d1 * d1 + d2 * d2;
                k = k + 1;
            }
            eAA[si * 64 + ai] = (essd * 1000) / nfull;
            ai = ai + 1;
        }
        si = si + 1;
    }

    // input (raw; SHAPES-first order decides on the raw input)
    let pxmax:i64 = 768 * 576 * 3;
    let px:[]i64 = nio_alloc((pxmax * 8) as i32) as []i64;
    if (px.len == 0) { _zag_println("alloc px failed"); return 1; }
    let hout:[]i64 = nio_alloc(8) as []i64;
    let w:i64 = d_load_bmp(root, "input.bmp", px, pxmax, hout);
    if (w < 0) { _zag_println("input load failed"); return 1; }
    let h:i64 = hout[0];
    let W:i64 = 2 * w;
    let H:i64 = 2 * h;
    let gpx:[]i64 = nio_alloc((W * H * 3 * 8) as i32) as []i64;
    let ghout:[]i64 = nio_alloc(8) as []i64;
    let gw:i64 = d_load_bmp(root, "gt.bmp", gpx, W * H * 3, ghout);
    if (gw != W) { _zag_println("gt size mismatch"); return 1; }

    // ---- replicate the baseline SHAPES fit (full recursion) ----
    let takes:[]i64 = nio_alloc((16384 * 9 * 8) as i32) as []i64;
    let ntout:[]i64 = nio_alloc(8) as []i64;
    let nofits:[]i64 = nio_alloc((1024 * 4 * 8) as i32) as []i64;
    let nnout:[]i64 = nio_alloc(8) as []i64;
    ntout[0] = 0; nnout[0] = 0;
    let Gh:i64 = 0;
    let nbx:i64 = (w + 31) / 32;
    let nby:i64 = (h + 31) / 32;
    let by:i64 = 0;
    while (by < nby) {
        let bx:i64 = 0;
        while (bx < nbx) {
            let bw:i64 = 32;
            if (bx * 32 + bw > w) { bw = w - bx * 32; }
            let bh:i64 = 32;
            if (by * 32 + bh > h) { bh = h - by * 32; }
            let g:i64 = d_fit(px, w, h, bx * 32, by * 32, bw, bh, 0,
                vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
            Gh = Gh + g;
            bx = bx + 1;
        }
        by = by + 1;
    }
    let nt:i64 = ntout[0];
    _zag_print("replicated: takes=");
    _zag_print(_zag_i64_to_str(nt));
    _zag_print(" nofits=");
    _zag_print(_zag_i64_to_str(nnout[0]));
    _zag_print(" G=");
    _zag_println(_zag_i64_to_str(Gh));
    _zag_println("expect (bridge baseline): takes=35 nofits=11 G=18343607");

    let trace:[]u8 = nio_alloc(1048576);
    let to:i64 = 0;
    to = d_puts(trace, to, "DELIBERATION TRACE v2 — TNN examines the key-ambiguity failure\n");
    to = d_puts(trace, to, "Method: baseline SHAPES fit replicated EXACTLY (full 32->4 recursion,\n");
    to = d_puts(trace, to, "SHAPES-first, raw input). Each take then measured: block smoothness,\n");
    to = d_puts(trace, to, "key ambiguity, winner correlation P, each arm-rule's verdict, and the\n");
    to = d_puts(trace, to, "take's own 2x-construction SSE vs GT (the failure evidence).\n");
    to = d_puts(trace, to, "TAU_MIN=2985492 R_BAND=1153 (corpstat.zag, vocab-measured).\n");
    to = d_puts(trace, to, "replicated takes=");
    to = d_puti(trace, to, nt);
    to = d_puts(trace, to, " nofits=");
    to = d_puti(trace, to, nnout[0]);
    to = d_puts(trace, to, " G=");
    to = d_puti(trace, to, Gh);
    to = d_puts(trace, to, "\n");
    to = d_puts(trace, to, "take x,y,bw,bh,si,atom | s2Bx1000 smooth | amb wvA weA wP | tsse | A1 A2 A3\n");

    let sses:[]i64 = nio_alloc((64 * 8) as i32) as []i64;
    let csses:[]i64 = nio_alloc((64 * 8) as i32) as []i64;
    let mean:[]i64 = nio_alloc(24) as []i64;
    let kmean:[]i64 = nio_alloc(24) as []i64;
    let sseo:[]i64 = nio_alloc(8) as []i64;
    let po:[]i64 = nio_alloc(8) as []i64;

    let bad_ti:i64 = -1;
    let bad_sse:i64 = -1;
    let col1:i64 = 0; let col2:i64 = 0; let col3:i64 = 0;
    let mismatch:i64 = 0;

    let ti:i64 = 0;
    while (ti < nt) {
        let x:i64 = takes[ti * 9];
        let y:i64 = takes[ti * 9 + 1];
        let bw:i64 = takes[ti * 9 + 2];
        let bh:i64 = takes[ti * 9 + 3];
        let lsi:i64 = takes[ti * 9 + 4];
        let atom:i64 = takes[ti * 9 + 5];
        let mr:i64 = takes[ti * 9 + 6];
        let mg:i64 = takes[ti * 9 + 7];
        let mb:i64 = takes[ti * 9 + 8];
        let S:i64 = vS[lsi];
        let K:i64 = vK[lsi];
        let s:i64 = S / 2;
        let n:i64 = bw * bh;
        let nval:i64 = n * 3;
        mean[0] = mr; mean[1] = mg; mean[2] = mb;
        // block energy
        let e:i64 = 0;
        let yy:i64 = 0;
        while (yy < bh) {
            let xx:i64 = 0;
            while (xx < bw) {
                let p:i64 = ((y + yy) * w + (x + xx)) * 3;
                let d0:i64 = px[p] - mr;
                let d1:i64 = px[p + 1] - mg;
                let d2:i64 = px[p + 2] - mb;
                e = e + d0 * d0 + d1 * d1 + d2 * d2;
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        let smooth:i64 = 0;
        if (e * 1000 < TAU_MIN() * nval) { smooth = 1; }
        // full atom scan at this block/scale
        let best:i64 = 0;
        let bsse:i64 = e;
        let a2:i64 = 1;
        while (a2 < K) {
            let kb2:i64 = vkb[lsi] + a2 * (s * s * 3 * 2);
            d_key_stats(px, w, x, y, bw, bh, mean, vbuf, kb2, s,
                kmean, sseo, po);
            sses[a2] = sseo[0];
            if (sseo[0] < bsse) { bsse = sseo[0]; best = a2; }
            a2 = a2 + 1;
        }
        sses[0] = e;
        if (best != atom) { mismatch = mismatch + 1; }
        let amb:i64 = 0;
        a2 = 1;
        while (a2 < K) {
            if (sses[a2] <= 2 * bsse) { amb = amb + 1; }
            a2 = a2 + 1;
        }
        // winner stats
        let wkb:i64 = vkb[lsi] + best * (s * s * 3 * 2);
        d_key_stats(px, w, x, y, bw, bh, mean, vbuf, wkb, s,
            kmean, sseo, po);
        let wP:i64 = po[0];
        let kssd:i64 = 0;
        let ky:i64 = 0;
        while (ky < bh) {
            let kx:i64 = 0;
            while (kx < bw) {
                let q:i64 = wkb + (ky * s + kx) * 6;
                let d0:i64 = r_i16le(vbuf, q) - kmean[0];
                let d1:i64 = r_i16le(vbuf, q + 2) - kmean[1];
                let d2:i64 = r_i16le(vbuf, q + 4) - kmean[2];
                kssd = kssd + d0 * d0 + d1 * d1 + d2 * d2;
                kx = kx + 1;
            }
            ky = ky + 1;
        }
        let wvA:i64 = (kssd * 1000) / nval;
        let weA:i64 = eAA[lsi * 64 + best];
        let bar:i64 = 9 * nval;

        // ---- A1: coarse agreement ----
        let v1:i64 = 1;
        let cbw:i64 = bw / 2; let cbh:i64 = bh / 2;
        if (cbw >= 2) {
            if (cbh >= 2) {
                v1 = 0;
                a2 = 1;
                while (a2 < K) {
                    let kb3:i64 = vkb[lsi] + a2 * (s * s * 3 * 2);
                    csses[a2] = d_coarse_sse(px, w, x, y, bw, bh, mean,
                        vbuf, kb3, s);
                    a2 = a2 + 1;
                }
                let wcs:i64 = csses[best];
                let rank:i64 = 0;
                a2 = 1;
                while (a2 < K) {
                    if (csses[a2] < wcs) { rank = rank + 1; }
                    a2 = a2 + 1;
                }
                if (rank < 3) { v1 = 1; }
            }
        }

        // ---- A2: smooth -> band-restricted re-match ----
        let v2:i64 = 1;
        if (smooth == 1) {
            v2 = 0;
            let b2sse:i64 = e;
            a2 = 1;
            while (a2 < K) {
                if (eAA[lsi * 64 + a2] * nval <= e * R_BAND()) {
                    if (sses[a2] < b2sse) { b2sse = sses[a2]; }
                }
                a2 = a2 + 1;
            }
            if ((e - b2sse) >= bar) { v2 = 1; }
        }

        // ---- A3: smooth->reject; top3; P>0; >=2 survivors; strict bar ----
        let v3:i64 = 0;
        if (smooth == 0) {
            let t1:i64 = 0; let t2:i64 = 0; let t3:i64 = 0;
            let s1:i64 = e + 1; let s2:i64 = e + 1; let s3:i64 = e + 1;
            let a4:i64 = 1;
            while (a4 < K) {
                let sv:i64 = sses[a4];
                if (sv < s1) { s3 = s2; t3 = t2; s2 = s1; t2 = t1; s1 = sv; t1 = a4; }
                else {
                    if (sv < s2) { s3 = s2; t3 = t2; s2 = sv; t2 = a4; }
                    else { if (sv < s3) { s3 = sv; t3 = a4; } }
                }
                a4 = a4 + 1;
            }
            let p1:i64 = 0; let p2:i64 = 0; let p3v:i64 = 0;
            if (t1 > 0) {
                let kb4:i64 = vkb[lsi] + t1 * (s * s * 3 * 2);
                d_key_stats(px, w, x, y, bw, bh, mean, vbuf, kb4, s,
                    kmean, sseo, po);
                p1 = po[0];
            }
            if (t2 > 0) {
                let kb5:i64 = vkb[lsi] + t2 * (s * s * 3 * 2);
                d_key_stats(px, w, x, y, bw, bh, mean, vbuf, kb5, s,
                    kmean, sseo, po);
                p2 = po[0];
            }
            if (t3 > 0) {
                let kb6:i64 = vkb[lsi] + t3 * (s * s * 3 * 2);
                d_key_stats(px, w, x, y, bw, bh, mean, vbuf, kb6, s,
                    kmean, sseo, po);
                p3v = po[0];
            }
            let nsurv:i64 = 0;
            let wsse:i64 = e + 1;
            let w3:i64 = 0;
            if (t1 > 0) { if (p1 > 0) { nsurv = nsurv + 1; if (s1 < wsse) { wsse = s1; w3 = t1; } } }
            if (t2 > 0) { if (p2 > 0) { nsurv = nsurv + 1; if (s2 < wsse) { wsse = s2; w3 = t2; } } }
            if (t3 > 0) { if (p3v > 0) { nsurv = nsurv + 1; if (s3 < wsse) { wsse = s3; w3 = t3; } } }
            if (nsurv >= 2) {
                let bar3:i64 = bar;
                if (w3 != t1) { bar3 = 18 * nval; }
                if ((e - wsse) >= bar3) { v3 = 1; }
            }
        }

        // ---- this take's own 2x-construction SSE vs GT ----
        let ab:i64 = vab[lsi] + atom * (S * S * 3 * 2);
        let tsse:i64 = 0;
        let oy:i64 = 0;
        while (oy < 2 * bh) {
            let ox:i64 = 0;
            while (ox < 2 * bw) {
                let OX:i64 = 2 * x + ox;
                let OY:i64 = 2 * y + oy;
                let gp:i64 = (OY * W + OX) * 3;
                let q:i64 = ab + (oy * S + ox) * 6;
                let c0:i64 = mr + r_i16le(vbuf, q);
                let c1:i64 = mg + r_i16le(vbuf, q + 2);
                let c2:i64 = mb + r_i16le(vbuf, q + 4);
                if (c0 < 0) { c0 = 0; } if (c0 > 255) { c0 = 255; }
                if (c1 < 0) { c1 = 0; } if (c1 > 255) { c1 = 255; }
                if (c2 < 0) { c2 = 0; } if (c2 > 255) { c2 = 255; }
                let d0:i64 = c0 - gpx[gp];
                let d1:i64 = c1 - gpx[gp + 1];
                let d2:i64 = c2 - gpx[gp + 2];
                tsse = tsse + d0 * d0 + d1 * d1 + d2 * d2;
                ox = ox + 1;
            }
            oy = oy + 1;
        }
        if (tsse > bad_sse) { bad_sse = tsse; bad_ti = ti; }
        if (v1 == 0) { col1 = col1 + 1; }
        if (v2 == 0) { col2 = col2 + 1; }
        if (v3 == 0) { col3 = col3 + 1; }

        to = d_puts(trace, to, "take ");
        to = d_puti(trace, to, x);
        to = d_puts(trace, to, ",");
        to = d_puti(trace, to, y);
        to = d_puts(trace, to, " ");
        to = d_puti(trace, to, bw);
        to = d_puts(trace, to, "x");
        to = d_puti(trace, to, bh);
        to = d_puts(trace, to, " si=");
        to = d_puti(trace, to, lsi);
        to = d_puts(trace, to, " atom=");
        to = d_puti(trace, to, atom);
        to = d_puts(trace, to, " | s2Bx1000=");
        to = d_puti(trace, to, (e * 1000) / nval);
        to = d_puts(trace, to, " smooth=");
        to = d_puti(trace, to, smooth);
        to = d_puts(trace, to, " | amb=");
        to = d_puti(trace, to, amb);
        to = d_puts(trace, to, " wvA=");
        to = d_puti(trace, to, wvA);
        to = d_puts(trace, to, " weA=");
        to = d_puti(trace, to, weA);
        to = d_puts(trace, to, " wP=");
        to = d_puti(trace, to, wP);
        to = d_puts(trace, to, " | tsse=");
        to = d_puti(trace, to, tsse);
        to = d_puts(trace, to, " | A1=");
        to = d_puti(trace, to, v1);
        to = d_puts(trace, to, " A2=");
        to = d_puti(trace, to, v2);
        to = d_puts(trace, to, " A3=");
        to = d_puti(trace, to, v3);
        to = d_puts(trace, to, "\n");
        ti = ti + 1;
    }

    to = d_puts(trace, to, "\nreplication mismatches (analysis best != recorded take atom): ");
    to = d_puti(trace, to, mismatch);
    to = d_puts(trace, to, "\n");
    to = d_puts(trace, to, "collateral (takes each rule would reject): A1=");
    to = d_puti(trace, to, col1);
    to = d_puts(trace, to, " A2=");
    to = d_puti(trace, to, col2);
    to = d_puts(trace, to, " A3=");
    to = d_puti(trace, to, col3);
    to = d_puts(trace, to, " of ");
    to = d_puti(trace, to, nt);
    to = d_puts(trace, to, " takes\n");

    // bad take = max tsse; re-read its verdicts from the trace is complex,
    // so recompute verdict flags for bad_ti via a second short pass is
    // wasteful; instead we recorded per-take lines above. For the vote we
    // need the bad take's three verdicts: recompute them here directly.
    let bx2:i64 = takes[bad_ti * 9];
    let by2:i64 = takes[bad_ti * 9 + 1];
    let bbw:i64 = takes[bad_ti * 9 + 2];
    let bbh:i64 = takes[bad_ti * 9 + 3];
    let bsi:i64 = takes[bad_ti * 9 + 4];
    let bmr:i64 = takes[bad_ti * 9 + 6];
    let bmg:i64 = takes[bad_ti * 9 + 7];
    let bmb:i64 = takes[bad_ti * 9 + 8];
    to = d_puts(trace, to, "\nBAD TAKE (max own-construction SSE vs GT): x=");
    to = d_puti(trace, to, bx2);
    to = d_puts(trace, to, " y=");
    to = d_puti(trace, to, by2);
    to = d_puts(trace, to, " ");
    to = d_puti(trace, to, bbw);
    to = d_puts(trace, to, "x");
    to = d_puti(trace, to, bbh);
    to = d_puts(trace, to, " si=");
    to = d_puti(trace, to, bsi);
    to = d_puts(trace, to, " atom=");
    to = d_puti(trace, to, takes[bad_ti * 9 + 5]);
    to = d_puts(trace, to, " tsse=");
    to = d_puti(trace, to, bad_sse);
    to = d_puts(trace, to, "\n(see the per-take line above for its smooth/amb/wP/A1/A2/A3 verdicts)\n");

    // vote: parse-free — recompute the three verdicts for the bad take.
    // (Duplicated short logic; deterministic.)
    let bS:i64 = vS[bsi];
    let bK:i64 = vK[bsi];
    let bs:i64 = bS / 2;
    let bn:i64 = bbw * bbh;
    let bnval:i64 = bn * 3;
    mean[0] = bmr; mean[1] = bmg; mean[2] = bmb;
    let be:i64 = 0;
    let byy:i64 = 0;
    while (byy < bbh) {
        let bxx:i64 = 0;
        while (bxx < bbw) {
            let p:i64 = ((by2 + byy) * w + (bx2 + bxx)) * 3;
            let d0:i64 = px[p] - bmr;
            let d1:i64 = px[p + 1] - bmg;
            let d2:i64 = px[p + 2] - bmb;
            be = be + d0 * d0 + d1 * d1 + d2 * d2;
            bxx = bxx + 1;
        }
        byy = byy + 1;
    }
    let bsmooth:i64 = 0;
    if (be * 1000 < TAU_MIN() * bnval) { bsmooth = 1; }
    let bbest:i64 = 0; let bbsse:i64 = be;
    let ba:i64 = 1;
    while (ba < bK) {
        let bkb:i64 = vkb[bsi] + ba * (bs * bs * 3 * 2);
        d_key_stats(px, w, bx2, by2, bbw, bbh, mean, vbuf, bkb, bs,
            kmean, sseo, po);
        sses[ba] = sseo[0];
        if (sseo[0] < bbsse) { bbsse = sseo[0]; bbest = ba; }
        ba = ba + 1;
    }
    sses[0] = be;
    let bbar:i64 = 9 * bnval;
    // A1
    let bv1:i64 = 1;
    let bcbw:i64 = bbw / 2; let bcbh:i64 = bbh / 2;
    if (bcbw >= 2) {
        if (bcbh >= 2) {
            bv1 = 0;
            ba = 1;
            while (ba < bK) {
                let bkb2:i64 = vkb[bsi] + ba * (bs * bs * 3 * 2);
                csses[ba] = d_coarse_sse(px, w, bx2, by2, bbw, bbh, mean,
                    vbuf, bkb2, bs);
                ba = ba + 1;
            }
            let bwcs:i64 = csses[bbest];
            let brank:i64 = 0;
            ba = 1;
            while (ba < bK) {
                if (csses[ba] < bwcs) { brank = brank + 1; }
                ba = ba + 1;
            }
            if (brank < 3) { bv1 = 1; }
        }
    }
    // A2
    let bv2:i64 = 1;
    if (bsmooth == 1) {
        bv2 = 0;
        let bb2sse:i64 = be;
        ba = 1;
        while (ba < bK) {
            if (eAA[bsi * 64 + ba] * bnval <= be * R_BAND()) {
                if (sses[ba] < bb2sse) { bb2sse = sses[ba]; }
            }
            ba = ba + 1;
        }
        if ((be - bb2sse) >= bbar) { bv2 = 1; }
    }
    // A3
    let bv3:i64 = 0;
    if (bsmooth == 0) {
        let t1:i64 = 0; let t2:i64 = 0; let t3:i64 = 0;
        let s1:i64 = be + 1; let s2:i64 = be + 1; let s3:i64 = be + 1;
        ba = 1;
        while (ba < bK) {
            let sv:i64 = sses[ba];
            if (sv < s1) { s3 = s2; t3 = t2; s2 = s1; t2 = t1; s1 = sv; t1 = ba; }
            else {
                if (sv < s2) { s3 = s2; t3 = t2; s2 = sv; t2 = ba; }
                else { if (sv < s3) { s3 = sv; t3 = ba; } }
            }
            ba = ba + 1;
        }
        let p1:i64 = 0; let p2:i64 = 0; let p3v:i64 = 0;
        if (t1 > 0) {
            let kb4:i64 = vkb[bsi] + t1 * (bs * bs * 3 * 2);
            d_key_stats(px, w, bx2, by2, bbw, bbh, mean, vbuf, kb4, bs,
                kmean, sseo, po);
            p1 = po[0];
        }
        if (t2 > 0) {
            let kb5:i64 = vkb[bsi] + t2 * (bs * bs * 3 * 2);
            d_key_stats(px, w, bx2, by2, bbw, bbh, mean, vbuf, kb5, bs,
                kmean, sseo, po);
            p2 = po[0];
        }
        if (t3 > 0) {
            let kb6:i64 = vkb[bsi] + t3 * (bs * bs * 3 * 2);
            d_key_stats(px, w, bx2, by2, bbw, bbh, mean, vbuf, kb6, bs,
                kmean, sseo, po);
            p3v = po[0];
        }
        let nsurv:i64 = 0;
        let wsse:i64 = be + 1;
        let w3:i64 = 0;
        if (t1 > 0) { if (p1 > 0) { nsurv = nsurv + 1; if (s1 < wsse) { wsse = s1; w3 = t1; } } }
        if (t2 > 0) { if (p2 > 0) { nsurv = nsurv + 1; if (s2 < wsse) { wsse = s2; w3 = t2; } } }
        if (t3 > 0) { if (p3v > 0) { nsurv = nsurv + 1; if (s3 < wsse) { wsse = s3; w3 = t3; } } }
        if (nsurv >= 2) {
            let bar3:i64 = bbar;
            if (w3 != t1) { bar3 = 18 * bnval; }
            if ((be - wsse) >= bar3) { bv3 = 1; }
        }
    }
    to = d_puts(trace, to, "bad-take verdicts: A1=");
    to = d_puti(trace, to, bv1);
    to = d_puts(trace, to, " A2=");
    to = d_puti(trace, to, bv2);
    to = d_puts(trace, to, " A3=");
    to = d_puti(trace, to, bv3);
    to = d_puts(trace, to, " (1=rule would still take, 0=rule rejects)\n");
    let vote:i64 = 0;
    let r1:i64 = 0; let r2:i64 = 0; let r3:i64 = 0;
    if (bv1 == 0) { r1 = 1; }
    if (bv2 == 0) { r2 = 1; }
    if (bv3 == 0) { r3 = 1; }
    if (r2 == 1) { vote = 2; }
    if (r3 == 1) {
        if (vote == 0) { vote = 3; }
        else { if (col3 < col2) { vote = 3; } }
    }
    if (r1 == 1) {
        if (vote == 0) { vote = 1; }
        else {
            if (vote == 2) { if (col1 < col2) { vote = 1; } }
            else { if (col1 < col3) { vote = 1; } }
        }
    }
    to = d_puts(trace, to, "\nDELIBERATION\n");
    to = d_puts(trace, to, "VOTE (advisory): arm ");
    to = d_puti(trace, to, vote);
    to = d_puts(trace, to, "\n");
    if (vote == 2) {
        to = d_puts(trace, to, "REASON: the worst take is a SMOOTH block explained by a HIGH-ENERGY atom; the energy-band gate rejects it by construction with the least collateral.\n");
    }
    if (vote == 3) {
        to = d_puts(trace, to, "REASON: the worst take's winner fails the correlation double-validation — its high-frequency directions are absent from the input block — and the smooth gate alone is not the cheapest rejector.\n");
    }
    if (vote == 1) {
        to = d_puts(trace, to, "REASON: the worst take's key is ambiguous across scales — the coarse key disagrees with the fine key; only cross-scale consistency rejects it cheaply.\n");
    }
    if (vote == 0) {
        to = d_puts(trace, to, "REASON: none of the three rules rejects the worst take — the mechanism analysis is incomplete and must be revised before trusting any arm.\n");
    }
    to = d_puts(trace, to, "NOTE: vote is advisory. The head-to-head test (full pipeline, both images) decides.\nDONE\n");
    let wrc:i64 = file_write(oroot, "DELIB_TRACE.txt", trace[0..to]);
    if (wrc < 0) { _zag_println("trace write failed"); return 1; }
    _zag_print("vote=");
    _zag_print(_zag_i64_to_str(vote));
    _zag_print(" bad_ti=");
    _zag_print(_zag_i64_to_str(bad_ti));
    _zag_print(" bad_sse=");
    _zag_print(_zag_i64_to_str(bad_sse));
    _zag_print(" col=");
    _zag_print(_zag_i64_to_str(col1));
    _zag_print("/");
    _zag_print(_zag_i64_to_str(col2));
    _zag_print("/");
    _zag_println(_zag_i64_to_str(col3));
    nio_close(root);
    nio_close(oroot);
    return 0;
}

// rt_dump.zag — red-team ledger census driver (arm B).
// Pure Zag, zero RNG, deterministic. Runs one B cell exactly like
// lr_run_cell, then dumps every audit entry and the final slot table
// for offline census (op histogram, pin/force-pin scan, refusal audit).
// Imports resolve relative to the build cwd (~/workspace/strength-round4).
@import("../strength_learner.zag")
@import("../strength_checker.zag")

fn rt_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}

fn main()i32 {
    if(_zag_argc()<4){return 64;}
    let a1:[]u8=_zag_arg(1);let a2:[]u8=_zag_arg(2);let a3:[]u8=_zag_arg(3);
    let cur:i32=-1;
    if(_zag_strcmp(a1,"VUP")==1){cur=LR_CUR_VUP;}
    if(_zag_strcmp(a1,"WBS")==1){cur=LR_CUR_WBS;}
    if(_zag_strcmp(a1,"JI")==1){cur=LR_CUR_JI;}
    let variant:i32=-1;
    if(_zag_strcmp(a2,"0")==1){variant=0;}
    if(_zag_strcmp(a2,"1")==1){variant=1;}
    if(_zag_strcmp(a2,"2")==1){variant=2;}
    let scale:i32=-1;
    if(_zag_strcmp(a3,"S1")==1){scale=LR_S1;}
    if(_zag_strcmp(a3,"S10")==1){scale=LR_S10;}
    if(_zag_strcmp(a3,"S100")==1){scale=LR_S100;}
    if(cur<0 || variant<0 || scale<0){return 65;}
    let c:LrCell=lr_cell_init(LR_ARM_B,cur,variant,scale);
    let s:*StStore=&c.store;
    let cs:i32=-1;
    st_add_core(s,95,-1,&cs);
    st_add_core(s,90,-1,&cs);
    st_set_stage(s,ST_STAGE_FULL);
    let t:i32=0;
    while(t<c.h){lr_episode(&c,s,t);t=t+1;}
    _zag_print("RT_CELL B ");rt_pi(cur as i64);_zag_print(" ");
    rt_pi(variant as i64);_zag_print(" ");rt_pi(scale as i64);_zag_print("\n");
    let i:i32=0;
    while(i<s.*.audit_n){
        _zag_print("RT_AUDIT ");
        rt_pi(st_aw(s,i,0) as i64);_zag_print(" ");
        rt_pi(st_aw(s,i,1) as i64);_zag_print(" ");
        rt_pi(st_aw(s,i,2) as i64);_zag_print(" ");
        rt_pi(st_aw(s,i,3) as i64);_zag_print(" ");
        rt_pi(st_aw(s,i,4) as i64);_zag_print(" ");
        rt_pi(st_aw(s,i,17) as i64);_zag_print("\n");
        i=i+1;
    }
    let j:i32=0;
    while(j<s.*.slot_cap){
        _zag_print("RT_SLOT ");
        rt_pi(j as i64);_zag_print(" ");
        rt_pi(s.*.live[j] as i64);_zag_print(" ");
        rt_pi(s.*.pinned[j] as i64);_zag_print(" ");
        rt_pi(s.*.forcepin[j] as i64);_zag_print(" ");
        rt_pi(s.*.region[j] as i64);_zag_print(" ");
        rt_pi(s.*.strength[j] as i64);_zag_print("\n");
        j=j+1;
    }
    let f:i32=st_refusals_clean(s);
    f=f+st_replay_check(s);
    f=f+ck_verify(s,LR_ARM_B,cur,variant,c.h,0);
    _zag_print("RT_CHECKFAIL ");rt_pi(f as i64);_zag_print("\n");
    _zag_print("RT_DONE\n");
    lr_cell_free(&c);
    return 0;
}

@import("strength_core.zag")
@import("strength_checker.zag")
fn tag(s:[]u8)void { _zag_print(s); }
fn pi(x:i32)void { let b:[]u8=_zag_i64_to_str(x as i64); _zag_print(b); nio_free(b); }
fn pc(x:i32)void { tag(","); pi(x); }
fn ck(s:*StStore)void { let f:i32=ck_verify(s,0,0,0,0,1); tag(" ck="); pi(f); tag("\n"); }
fn main()i32 {
  let st:StStore=st_init(16,4096);
  let s:*StStore=&st;
  let g0:i32=st_set_stage(s,4);
  tag("BATCH3B stage="); pi(g0); tag("\n");
  // C09: cross-slot reuse of the same cite episodes (claim 3 is same-slot only; report behavior)
  let sl1:i32=0;
  let sl2:i32=0;
  let c09a:i32=st_add(s,100,1,90,1000,&sl1);
  let c09b:i32=st_add(s,101,1,90,1000,&sl2);
  let c09e1:i32=st_evidence(s,sl1,1,401);
  let c09e2:i32=st_evidence(s,sl1,1,402);
  let c09e3:i32=st_evidence(s,sl1,1,403);
  let c09e4:i32=st_evidence(s,sl1,1,404);
  let c09j1:i32=st_justify(s,sl1,1);
  let c09d1:i32=st_delete_strong(s,sl1);
  let c09f1:i32=st_evidence(s,sl2,1,401);
  let c09f2:i32=st_evidence(s,sl2,1,402);
  let c09f3:i32=st_evidence(s,sl2,1,403);
  let c09f4:i32=st_evidence(s,sl2,1,404);
  let c09j2:i32=st_justify(s,sl2,1);
  let c09d2:i32=st_delete_strong(s,sl2);
  tag("C09 crossslot A:add,B:add,A:ev*4,just,del,B:ev401-404,just,del=");
  pi(c09a); pc(c09b); pc(c09e1); pc(c09e2); pc(c09e3); pc(c09e4); pc(c09j1); pc(c09d1); pc(c09f1); pc(c09f2); pc(c09f3); pc(c09f4); pc(c09j2); pc(c09d2); ck(s);
  // C10: interleaved cites across two slots; destroy A with only 2 cites (expect 109), then 2 more (expect 0)
  let sl3:i32=0;
  let sl4:i32=0;
  let c10a:i32=st_add(s,100,1,90,1000,&sl3);
  let c10b:i32=st_add(s,101,1,90,1000,&sl4);
  let c10e1:i32=st_evidence(s,sl3,1,411);
  let c10e2:i32=st_evidence(s,sl3,1,412);
  let c10e3:i32=st_evidence(s,sl4,1,413);
  let c10e4:i32=st_evidence(s,sl4,1,414);
  let c10j:i32=st_justify(s,sl3,1);
  let c10d1:i32=st_delete_strong(s,sl3);
  let c10e5:i32=st_evidence(s,sl3,1,415);
  let c10e6:i32=st_evidence(s,sl3,1,416);
  let c10d2:i32=st_delete_strong(s,sl3);
  tag("C10 interleave A:add,B:add,A:ev411,412,B:ev413,414,justA,delA,ev415,416,delA=");
  pi(c10a); pc(c10b); pc(c10e1); pc(c10e2); pc(c10e3); pc(c10e4); pc(c10j); pc(c10d1); pc(c10e5); pc(c10e6); pc(c10d2); ck(s);
  // C11: delete twice (expect 103 NOTLIVE on second)
  let sl5:i32=0;
  let c11a:i32=st_add(s,100,1,90,1000,&sl5);
  let c11e1:i32=st_evidence(s,sl5,1,421);
  let c11e2:i32=st_evidence(s,sl5,1,422);
  let c11e3:i32=st_evidence(s,sl5,1,423);
  let c11e4:i32=st_evidence(s,sl5,1,424);
  let c11j:i32=st_justify(s,sl5,1);
  let c11d1:i32=st_delete_strong(s,sl5);
  let c11d2:i32=st_delete_strong(s,sl5);
  tag("C11 doubledel add,ev*4,just,del,del=");
  pi(c11a); pc(c11e1); pc(c11e2); pc(c11e3); pc(c11e4); pc(c11j); pc(c11d1); pc(c11d2); ck(s);
  // C12: destroy at stage KILL instead of FULL (record stage gating)
  let g3:i32=st_set_stage(s,3);
  let sl6:i32=0;
  let c12a:i32=st_add(s,100,1,90,1000,&sl6);
  let c12e1:i32=st_evidence(s,sl6,1,431);
  let c12e2:i32=st_evidence(s,sl6,1,432);
  let c12e3:i32=st_evidence(s,sl6,1,433);
  let c12e4:i32=st_evidence(s,sl6,1,434);
  let c12j:i32=st_justify(s,sl6,1);
  let c12d:i32=st_delete_strong(s,sl6);
  let g4:i32=st_set_stage(s,4);
  tag("C12 stagekill set3,add,ev*4,just,del,set4=");
  pi(g3); pc(c12a); pc(c12e1); pc(c12e2); pc(c12e3); pc(c12e4); pc(c12j); pc(c12d); pc(g4); ck(s);
  // C13: strengthen_cited with cite_ep=441, then 3 evidences (does the cited ep count toward price?)
  let sl7:i32=0;
  let c13a:i32=st_add(s,100,1,90,1000,&sl7);
  let c13c:i32=st_strengthen_cited(s,sl7,95,1,441);
  let c13e1:i32=st_evidence(s,sl7,1,442);
  let c13e2:i32=st_evidence(s,sl7,1,443);
  let c13e3:i32=st_evidence(s,sl7,1,444);
  let c13j:i32=st_justify(s,sl7,1);
  let c13d:i32=st_delete_strong(s,sl7);
  tag("C13 strcited add,strcited441,ev442,443,444,just,del=");
  pi(c13a); pc(c13c); pc(c13e1); pc(c13e2); pc(c13e3); pc(c13j); pc(c13d); ck(s);
  // C14: evidence on dead slot sl5 (expect refusal code)
  let c14e:i32=st_evidence(s,sl5,1,451);
  tag("C14 ev-on-dead ev=");
  pi(c14e); ck(s);
  // C15: add -> honest delete -> add new -> st_kill on the NEW live strong slot (expect refusal) -> honest delete
  let sl8:i32=0;
  let c15a:i32=st_add(s,100,1,90,1000,&sl8);
  let c15e1:i32=st_evidence(s,sl8,1,461);
  let c15e2:i32=st_evidence(s,sl8,1,462);
  let c15e3:i32=st_evidence(s,sl8,1,463);
  let c15e4:i32=st_evidence(s,sl8,1,464);
  let c15j:i32=st_justify(s,sl8,1);
  let c15d:i32=st_delete_strong(s,sl8);
  let sl9:i32=0;
  let c15b:i32=st_add(s,200,1,90,1000,&sl9);
  let c15k:i32=st_kill(s,sl9);
  let c15f1:i32=st_evidence(s,sl9,1,471);
  let c15f2:i32=st_evidence(s,sl9,1,472);
  let c15f3:i32=st_evidence(s,sl9,1,473);
  let c15f4:i32=st_evidence(s,sl9,1,474);
  let c15j2:i32=st_justify(s,sl9,1);
  let c15d2:i32=st_delete_strong(s,sl9);
  tag("C15 add-del-add add,ev*4,just,del,add2,kill,ev*4,just,del=");
  pi(c15a); pc(c15e1); pc(c15e2); pc(c15e3); pc(c15e4); pc(c15j); pc(c15d); pc(c15b); pc(c15k); pc(c15f1); pc(c15f2); pc(c15f3); pc(c15f4); pc(c15j2); pc(c15d2); ck(s);
  return 0;
}

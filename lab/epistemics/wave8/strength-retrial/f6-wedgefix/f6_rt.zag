// f6_rt.zag — scriptable red-team driver for the F6 cite-consumption test.
// The red team gets this BINARY plus a plain-English law brief. No source.
// argv[1]: W | G | H   (consumption rule under test)
// argv[2..]: op tokens, one per arg:
//   ADD<s>  admit a memory of strength <s> to the first free slot
//   CITE<e> cite episode <e> as contradicted evidence (slot 2)
//   JUST    justify slot 2's current judgment
//   KILL    evidenced destroy of slot 2 (the priced destruction path)
//   OW<s>   overwrite slot 2 with strength <s> (the other priced path)
//   WEAK<s> weaken slot 2 to strength <s>
//   STR<s>  strengthen slot 2 to strength <s>
//   TD<s>   trainer declares slot 2 strength <s>
//   RB      roll back the last mutating op
// Prints RT <i> <tok> <rc> per op, then RT_END with hygiene checks.
// Deterministic; zero RNG.
@import("strength_checker.zag")

fn rt_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
// match op name: first plen bytes equal s0..s3, total alpha-prefix len == plen
fn rt_match(tok:[]u8,pi:i32,s0:i32,s1:i32,s2:i32,s3:i32,plen:i32)i32 {
    if(pi!=plen){return 0;}
    if(plen>0 && (tok[0] as i32)!=s0){return 0;}
    if(plen>1 && (tok[1] as i32)!=s1){return 0;}
    if(plen>2 && (tok[2] as i32)!=s2){return 0;}
    if(plen>3 && (tok[3] as i32)!=s3){return 0;}
    return 1;
}
fn rt_op(s:*StStore,tok:[]u8,idx:i32,pslot:*i32)i32 {
    let L:i32=tok.len;
    let pi:i32=0;
    while(pi<L){let c:u8=tok[pi];if(c>=48 && c<=57){break;} pi=pi+1;}
    let v:i32=0;
    let q:i32=pi;
    while(q<L){v=v*10+((tok[q] as i32)-48);q=q+1;}
    let rc:i32=-999;
    let sl:i32=pslot.*;
    // F6-WEDGEFIX (2026-09-26): SLOT<n> driver directive — subsequent ops
    // target slot <n> (default 2). Driver-level only; not a mechanism op.
    if(rt_match(tok,pi,83,76,79,84,4)==1 && pi<L){
        pslot.*=v;
        rc=0;
    } else if(rt_match(tok,pi,65,68,68,0,3)==1){
        let ns:i32=0;
        rc=st_add(s,900+idx,ST_REGION_USER,v,idx,&ns);
    } else if(rt_match(tok,pi,67,73,84,69,4)==1){
        rc=st_evidence(s,sl,ST_J_CONTRADICTED,v);
    } else if(rt_match(tok,pi,74,85,83,84,4)==1){
        rc=st_justify(s,sl,ST_J_CONTRADICTED);
    } else if(rt_match(tok,pi,75,73,76,76,4)==1){
        rc=st_kill_evidenced(s,sl);
    } else if(rt_match(tok,pi,79,87,0,0,2)==1){
        rc=st_overwrite(s,sl,950,v,idx);
    } else if(rt_match(tok,pi,87,69,65,75,4)==1){
        rc=st_weaken(s,sl,v,ST_J_CONTRADICTED);
    } else if(rt_match(tok,pi,83,84,82,0,3)==1){
        rc=st_strengthen(s,sl,v,ST_J_CONTRADICTED);
    } else if(rt_match(tok,pi,84,68,0,0,2)==1){
        rc=st_trainer_declare(s,ST_ROLE_TRAINER,1,sl,v,idx);
    } else if(rt_match(tok,pi,82,66,0,0,2)==1){
        rc=st_rollback_last(s);
    }
    _zag_print("RT ");rt_pi(idx as i64);
    _zag_print(" ");_zag_print(tok);
    _zag_print(" ");rt_pi(rc as i64);_zag_print("\n");
    return rc;
}
fn main()void {
    let m:[]u8=_zag_arg(1);
    let s:StStore=st_init(16,32768);
    if(_zag_strcmp(m,"G")==1){st_set_cite_mode(&s,ST_CITE_GLOBAL);}
    else if(_zag_strcmp(m,"H")==1){st_set_cite_mode(&s,ST_CITE_HYBRID);}
    else {st_set_cite_mode(&s,ST_CITE_WINDOWED);}
    let c0:i32=0;let c1:i32=0;
    st_add_core(&s,95,-1,&c0);
    st_add_core(&s,90,-1,&c1);
    st_set_stage(&s,ST_STAGE_FULL);
    let n:i32=_zag_argc();
    let i:i32=2;
    let tslot:i32=2;
    while(i<n){
        rt_op(&s,_zag_arg(i),i-2,&tslot);
        i=i+1;
    }
    let r1:i32=st_refusals_clean(&s);
    let r2:i32=st_replay_check(&s);
    let f:i32=ck_verify(&s,0,0,0,500,1);
    _zag_print("RT_END refusals_clean=");rt_pi(r1 as i64);
    _zag_print(" replay=");rt_pi(r2 as i64);
    _zag_print(" ckfail=");rt_pi(f as i64);_zag_print("\n");
}

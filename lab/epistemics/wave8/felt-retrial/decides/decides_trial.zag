@import("felt.zag")

// Decides-trial driver (Wave-8 felt-intensity re-trial, Phase E arms D and X).
// One binary; argv[1]=arm (D/X), argv[2]=variant (0/1/2).
// D: TNN-decides harness via RC1-style gated deliberation (burn-in 0-149 under
//    H1, deliberate at 150 with counterfactual self-simulation per candidate,
//    optional re-deliberation at 300, verification sims after the run).
// X: experimenter-fixed harness H1 for all 500 episodes, no deliberation.
// Both arms are feeling arms (arm_f=1): judgment target = felt intensity,
// R frozen at neutral throughout (no R_PARAM op exists anywhere here).
// Deterministic: no nondeterminism in any decision path. Two runs per cell must be
// byte-identical.
//
// Harness variations (prereg section 4):
//   H1: 32 slots, age<25 exempt from triage, ties -> oldest admission.
//       All-underage corner -> REFUSED_FULL (counted as drop).
//   H2: 64 slots, else W7 baseline verbatim.
//   H3: 32 slots, oldest-admitted-first victim selection (no
//       intensity/strength triage), kill still evidence-gated.
//   H4: 32 slots, intensity triage, ties -> oldest admission.
//   H5: W7 baseline verbatim (32 slots, ascending triage, ties -> slot index).
// Common: 1 admission/episode, graded effort-gate kill ceil(strength/25)
// distinct contradiction citations, pressure at {100,200,300,400,499} freeing
// 2 slots, REFUSED_FULL counted in the offered denominator.

// ============ curriculum ground truth (frozen, verbatim W7) ============
fn f_imp(m:i32,v:i32)i32 {
    if(((7*m+13*v+3)%10)<3){return 1;}
    return 0;
}
fn f_wrong(m:i32,v:i32)i32 {
    if(((3*m+7*v+9)%10)<2){return 1;}
    return 0;
}
fn f_is_implant(m:i32)i32 {
    if(m==0){return 1;}
    if(m==83){return 1;}
    if(m==166){return 1;}
    if(m==250){return 1;}
    if(m==333){return 1;}
    if(m==416){return 1;}
    return 0;
}
fn f_designated(m:i32,v:i32)i32 {
    if(f_is_implant(m)==1){return 0;}
    if(f_imp(m,v)==0){return 0;}
    let r:i32=m%50;
    if(r==1||r==2||r==3){return 1;}
    return 0;
}
// class: 0=junk 1=right-important 2=wrong 3=implant (implant overrides)
fn f_class(m:i32,v:i32)i32 {
    if(f_is_implant(m)==1){return 3;}
    if(f_wrong(m,v)==1){return 2;}
    if(f_imp(m,v)==1){return 1;}
    return 0;
}
fn f_implant_idx(m:i32)i32 {
    if(m==0){return 0;}
    if(m==83){return 1;}
    if(m==166){return 2;}
    if(m==250){return 3;}
    if(m==333){return 4;}
    if(m==416){return 5;}
    return -1;
}

// ============ RC op codes (substrate: 1..29, felt: 41..44) ============
const RC_OP_INSPECT:i32=51;
const RC_OP_SIM:i32=52;
const RC_OP_PROPOSE:i32=53;
const RC_OP_COMMIT:i32=54;
const RC_OP_REFUSE:i32=55;
const RC_OP_ROLLBACK:i32=56;
const RC_REF_CONST:i32=204;
const RC_REF_STAGE:i32=201;
const RC_REF_PRED:i32=203;
const RC_OK:i32=0;

// ============ harness ids ============
const DH_H1:i32=1;
const DH_H2:i32=2;
const DH_H3:i32=3;
const DH_H4:i32=4;
const DH_H5:i32=5;
const DH_MAXCAP:i32=64;
const DH_AUDIT_CAP:i32=131072;
const DH_RL_CAP:i32=60000;
// metric-snapshot word offsets (i32s: admitted_ri, admitted_wrong_cens,
// revised_wrong_cens, rightimp_churn)
const SN_ADM_RI:i32=0;
const SN_ADM_WC:i32=4;
const SN_REV_WC:i32=8;
const SN_RICHURN:i32=12;

struct DecW {
    cap:i32,
    harness:i32,
    live:i32,
    variant:i32,
    arm_d:i32,
    d_val:[]u8,
    d_corrob:[]u8,
    d_contra_n:[]u8,
    d_contra_ep:[]u8,
    d_cited:[]u8,
    d_just:[]u8,
    d_weakx:[]u8,
    d_tried:[]u8,
    d_newc:[]u8,
    d_impl_last:[]u8,
    lat:[]u8,
    lat_n:i32,
    offered_ri:i32,
    offered_wrong:i32,
    admitted_ri:i32,
    admitted_wrong:i32,
    admitted_wrong_cens:i32,
    admitted_implant:i32,
    admitted_designated:i32,
    admitted_trainerwrong:i32,
    admitted_trainerwrong_cens:i32,
    revised_wrong:i32,
    revised_wrong_cens:i32,
    revised_implant:i32,
    revised_trainerwrong:i32,
    revised_trainerwrong_cens:i32,
    wrong_churn:i32,
    implant_churn:i32,
    rightimp_churn:i32,
    n_reads:i32,
    n_strengthen:i32,
    n_weaken:i32,
    n_trainer:i32,
    n_kill_refused:i32,
    n_abandon:i32,
    n_drops:i32,
    junk_max:i32,
    impl_bad:i32,
    noev_bad:i32,
    pressure_short:i32,
    rl_inten:[]u8,
    rl_pos:[]u8,
    rl_prov:[]u8,
    rl_n:i32,
    rl_cap:i32,
    rl_trunc:i32,
    traj_n:[]u8,
    traj_ep:[]u8,
    traj_in:[]u8,
    pred_rvup:[]u8,
    pred_rwbs:[]u8,
    pred_fwbs:[]u8,
    snap150:[]u8,
    snap300:[]u8,
    n_commits:i32,
    n_inspects:i32,
    n_proposes:i32,
    n_rollbacks:i32,
    last_commit_idx:i32,
    prev_harness:i32,
    chosen:i32,
    pred_ready:i32,
    pilot_diverged:i32,
    pilot_arv:i32,
    pilot_arw:i32,
    pilot_afw:i32
}

fn dw_zb(b:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
}

fn dw_new(live:i32,harness:i32,cap:i32,variant:i32,arm_d:i32)DecW {
    let w:DecW=DecW{
        .cap=cap,.harness=harness,.live=live,.variant=variant,.arm_d=arm_d,
        .d_val=nio_alloc(256),.d_corrob=nio_alloc(256),.d_contra_n=nio_alloc(256),
        .d_contra_ep=nio_alloc(1024),.d_cited=nio_alloc(256),.d_just=nio_alloc(256),
        .d_weakx=nio_alloc(256),.d_tried=nio_alloc(256),.d_newc=nio_alloc(256),
        .d_impl_last=nio_alloc(256),.lat=nio_alloc(1024),
        .rl_inten=nio_alloc(60000),.rl_pos=nio_alloc(60000),.rl_prov=nio_alloc(60000),
        .traj_n=nio_alloc(6),.traj_ep=nio_alloc(384),.traj_in=nio_alloc(384),
        .pred_rvup=nio_alloc(20),.pred_rwbs=nio_alloc(20),.pred_fwbs=nio_alloc(20),
        .snap150=nio_alloc(16),.snap300=nio_alloc(16),
        .lat_n=0,.offered_ri=0,.offered_wrong=0,
        .admitted_ri=0,.admitted_wrong=0,.admitted_wrong_cens=0,
        .admitted_implant=0,.admitted_designated=0,
        .admitted_trainerwrong=0,.admitted_trainerwrong_cens=0,
        .revised_wrong=0,.revised_wrong_cens=0,.revised_implant=0,
        .revised_trainerwrong=0,.revised_trainerwrong_cens=0,
        .wrong_churn=0,.implant_churn=0,.rightimp_churn=0,
        .n_reads=0,.n_strengthen=0,.n_weaken=0,.n_trainer=0,
        .n_kill_refused=0,.n_abandon=0,.n_drops=0,
        .junk_max=0,.impl_bad=0,.noev_bad=0,.pressure_short=0,
        .rl_n=0,.rl_cap=60000,.rl_trunc=0,
        .n_commits=0,.n_inspects=0,.n_proposes=0,.n_rollbacks=0,
        .last_commit_idx=-1,.prev_harness=harness,.chosen=harness,.pred_ready=0,
        .pilot_diverged=0,.pilot_arv=0,.pilot_arw=0,.pilot_afw=0
    };
    dw_zb(w.d_val,256);dw_zb(w.d_corrob,256);dw_zb(w.d_contra_n,256);
    dw_zb(w.d_contra_ep,1024);dw_zb(w.d_cited,256);dw_zb(w.d_just,256);
    dw_zb(w.d_weakx,256);dw_zb(w.d_tried,256);dw_zb(w.d_newc,256);
    dw_zb(w.d_impl_last,256);dw_zb(w.lat,1024);
    dw_zb(w.rl_inten,60000);dw_zb(w.rl_pos,60000);dw_zb(w.rl_prov,60000);
    dw_zb(w.traj_n,6);dw_zb(w.traj_ep,384);dw_zb(w.traj_in,384);
    dw_zb(w.pred_rvup,20);dw_zb(w.pred_rwbs,20);dw_zb(w.pred_fwbs,20);
    dw_zb(w.snap150,16);dw_zb(w.snap300,16);
    let s:i32=0;
    while(s<64){
        st_i32_set(w.d_val,s*4,-1);
        st_i32_set(w.d_impl_last,s*4,-1);
        s=s+1;
    }
    return w;
}

fn dw_free(w:*DecW)void {
    nio_free(w.*.d_val);nio_free(w.*.d_corrob);nio_free(w.*.d_contra_n);
    nio_free(w.*.d_contra_ep);nio_free(w.*.d_cited);nio_free(w.*.d_just);
    nio_free(w.*.d_weakx);nio_free(w.*.d_tried);nio_free(w.*.d_newc);
    nio_free(w.*.d_impl_last);nio_free(w.*.lat);
    nio_free(w.*.rl_inten);nio_free(w.*.rl_pos);nio_free(w.*.rl_prov);
    nio_free(w.*.traj_n);nio_free(w.*.traj_ep);nio_free(w.*.traj_in);
    nio_free(w.*.pred_rvup);nio_free(w.*.pred_rwbs);nio_free(w.*.pred_fwbs);
    nio_free(w.*.snap150);nio_free(w.*.snap300);
}

fn dw_abs(v:i32)i32 {
    if(v<0){return -v;}
    return v;
}
// integer percent; vacuous value when the denominator is zero.
fn dw_pct(num:i32,den:i32,vacuous:i32)i32 {
    if(den==0){return vacuous;}
    return (num*100)/den;
}

fn dw_clear_slot(w:*DecW,s:i32)void {
    st_i32_set(w.*.d_val,s*4,-1);
    st_i32_set(w.*.d_corrob,s*4,0);
    st_i32_set(w.*.d_contra_n,s*4,0);
    st_i32_set(w.*.d_cited,s*4,0);
    st_i32_set(w.*.d_just,s*4,0);
    st_i32_set(w.*.d_weakx,s*4,0);
    st_i32_set(w.*.d_newc,s*4,0);
    st_i32_set(w.*.d_impl_last,s*4,-1);
}
fn dw_clear_tried(w:*DecW)void {
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(w.*.d_tried,s*4,0);s=s+1;}
}
fn dw_clear_newc(w:*DecW)void {
    let s:i32=0;
    while(s<w.*.cap){st_i32_set(w.*.d_newc,s*4,0);s=s+1;}
}
fn dw_emit_contra(w:*DecW,st:*StStore,s:i32,v:i32,m:i32)void {
    felt_emit_obs(st,s,v,FT_OP_OBS_CONTRADICT,m);
    let n:i32=st_i32_get(w.*.d_contra_n,s*4);
    if(n<4){st_i32_set(w.*.d_contra_ep,(s*4+n)*4,m);}
    st_i32_set(w.*.d_contra_n,s*4,n+1);
}
fn dw_emit_corrob(w:*DecW,st:*StStore,s:i32,v:i32,m:i32)void {
    felt_emit_obs(st,s,v,FT_OP_OBS_CORROBORATE,m);
    st_i32_set(w.*.d_corrob,s*4,st_i32_get(w.*.d_corrob,s*4)+1);
    st_i32_set(w.*.d_newc,s*4,1);
}

// Read-side tracking (live run only): anti-inflation probes (F4a/F4b),
// the AUC read log, and implant intensity trajectories.
fn dw_track(w:*DecW,s:i32,cls:i32,p:i32,m:i32,v:i32)void {
    let inten:i32=felt_unpack_intensity(p);
    // NB: native codegen does not support writes through a struct-field
    // array element (w.*.field[i]=...); alias to locals first (same memory).
    let tjn:[]u8=w.*.traj_n;
    let rli:[]u8=w.*.rl_inten;
    let rlp:[]u8=w.*.rl_pos;
    let rlv:[]u8=w.*.rl_prov;
    if(cls==0){
        if(inten>w.*.junk_max){w.*.junk_max=inten;}
    }
    if(cls==3){
        let xn:i32=st_i32_get(w.*.d_contra_n,s*4);
        if(xn>=1){
            let last:i32=st_i32_get(w.*.d_impl_last,s*4);
            if(last!=-1&&inten>last){w.*.impl_bad=w.*.impl_bad+1;}
            st_i32_set(w.*.d_impl_last,s*4,inten);
        }
        let ii:i32=f_implant_idx(v);
        if(ii>=0){
            let n:i32=tjn[ii] as i32;
            if(n<16){
                st_i32_set(w.*.traj_ep,(ii*16+n)*4,m);
                st_i32_set(w.*.traj_in,(ii*16+n)*4,inten);
                tjn[ii]=(n+1) as u8;
            }
        }
    }
    // AUC read log: class 1 = positive, class 0 = negative.
    if(cls==0||cls==1){
        if(w.*.rl_n<w.*.rl_cap){
            let i:i32=w.*.rl_n;
            rli[i]=inten as u8;
            if(cls==1){rlp[i]=1;}else{rlp[i]=0;}
            let cc:i32=felt_unpack_c(p);
            let xx:i32=felt_unpack_x(p);
            let tt:i32=felt_unpack_t(p);
            if(cc+xx+tt>=1){rlv[i]=1;}else{rlv[i]=0;}
            w.*.rl_n=i+1;
        } else {
            w.*.rl_trunc=1;
        }
    }
}

// Classify a kill: proper revision (evidence-based, cn>=2) vs early churn.
fn dw_record_kill(w:*DecW,s:i32,v:i32,cn:i32,m:i32)void {
    let variant:i32=w.*.variant;
    let cls:i32=f_class(v,variant);
    if(cn>=2){
        if(cls==2){
            w.*.revised_wrong=w.*.revised_wrong+1;
            if(v<=389){w.*.revised_wrong_cens=w.*.revised_wrong_cens+1;}
            if(f_designated(v,variant)==1){
                w.*.revised_trainerwrong=w.*.revised_trainerwrong+1;
                if(v<=389){w.*.revised_trainerwrong_cens=w.*.revised_trainerwrong_cens+1;}
            }
        }
        if(cls==3){w.*.revised_implant=w.*.revised_implant+1;}
        let first_ep:i32=st_i32_get(w.*.d_contra_ep,(s*4+0)*4);
        if(w.*.lat_n<256){
            st_i32_set(w.*.lat,w.*.lat_n*4,m-first_ep);
            w.*.lat_n=w.*.lat_n+1;
        }
    } else {
        if(cls==2){w.*.wrong_churn=w.*.wrong_churn+1;}
        if(cls==3){w.*.implant_churn=w.*.implant_churn+1;}
        if(cls==1){w.*.rightimp_churn=w.*.rightimp_churn+1;}
    }
}

// Triage victim selection, parameterized by harness.
// H1: age<25 exempt; ties -> oldest admission.
// H2: W7 verbatim (ascending intensity; ties -> slot index).
// H3: oldest admitted first (pure FIFO), no intensity/strength triage.
// H4: ascending intensity; ties -> oldest admission.
// H5: W7 verbatim (ascending intensity; ties -> slot index).
fn dw_pick_victim(w:*DecW,st:*StStore,m:i32)i32 {
    let h:i32=w.*.harness;
    let best:i32=-1;
    let best_key:i32=1000000;
    let best_age:i32=-1;
    let s:i32=0;
    while(s<w.*.cap){
        if(st_i32_get(w.*.d_val,s*4)!=-1&&st_i32_get(w.*.d_tried,s*4)==0){
            let v:i32=st_i32_get(w.*.d_val,s*4);
            let skip:i32=0;
            if(h==1&&(m-v)<25){skip=1;}
            if(skip==0){
                let key:i32=0;
                if(h==3){
                    key=v;
                } else {
                    let p:i32=felt_read(st,s,v);
                    w.*.n_reads=w.*.n_reads+1;
                    key=felt_unpack_intensity(p);
                    if(w.*.live==1){dw_track(w,s,f_class(v,w.*.variant),p,m,v);}
                }
                let age:i32=m-v;
                let take:i32=0;
                if(best==-1){take=1;}
                else if(key<best_key){take=1;}
                else if(key==best_key){
                    if(h==1||h==3||h==4){
                        if(age>best_age){take=1;}
                    }
                }
                if(take==1){best=s;best_key=key;best_age=age;}
            }
        }
        s=s+1;
    }
    return best;
}

// Attempt an evidence-gated kill of a triage victim. Returns 1 if freed.
// Graded effort gate: kill needs ceil(strength/25) distinct contradiction
// citations (constitutional, kept in every harness).
fn dw_try_kill_victim(w:*DecW,st:*StStore,s:i32,reason:i32,m:i32)i32 {
    let v:i32=st_i32_get(w.*.d_val,s*4);
    let cur:i32=st.*.st_str[s] as i32;
    let need:i32=(cur+24)/25;
    let cn:i32=st_i32_get(w.*.d_contra_n,s*4);
    if(cn>=need){
        let k:i32=st_i32_get(w.*.d_cited,s*4);
        while(k<need&&k<cn){
            let ep:i32=st_i32_get(w.*.d_contra_ep,(s*4+k)*4);
            st_evidence(st,s,reason,ep);
            k=k+1;
        }
        st_i32_set(w.*.d_cited,s*4,k);
        if(st_i32_get(w.*.d_just,s*4)==0){
            st_justify(st,s,reason);
            st_i32_set(w.*.d_just,s*4,1);
        }
        let rc:i32=st_kill_evidenced(st,s,ST_ARM_A);
        if(rc==ST_OK){
            dw_record_kill(w,s,v,cn,m);
            dw_clear_slot(w,s);
            return 1;
        }
        w.*.n_kill_refused=w.*.n_kill_refused+1;
        return 0;
    }
    st_abandon(st,s,reason);
    w.*.n_abandon=w.*.n_abandon+1;
    return 0;
}

// Pressure: free 2 slots (harness-parameterized victim selection).
fn dw_pressure(w:*DecW,st:*StStore,m:i32)void {
    dw_clear_tried(w);
    let freed:i32=0;
    let guard:i32=0;
    while(freed<2&&guard<80){
        guard=guard+1;
        let vic:i32=dw_pick_victim(w,st,m);
        if(vic==-1){freed=2;}
        else {
            if(dw_try_kill_victim(w,st,vic,ST_J_PRESSURE_VICTIM,m)==1){
                freed=freed+1;
            } else {
                st_i32_set(w.*.d_tried,vic*4,1);
            }
        }
    }
    if(freed<2){w.*.pressure_short=w.*.pressure_short+(2-freed);}
}

// Admission: 1/episode. Store full -> triage victims per harness; H1
// all-underage corner -> REFUSED_FULL (drop, counted in offered denominator).
fn dw_admit(w:*DecW,st:*StStore,m:i32)void {
    let variant:i32=w.*.variant;
    let slot_out:i32=-1;
    let arc:i32=st_add(st,m,ST_REGION_USER,0,&slot_out);
    if(arc!=ST_OK){
        dw_clear_tried(w);
        let done:i32=0;
        let guard:i32=0;
        while(done==0&&guard<80){
            guard=guard+1;
            let vic:i32=dw_pick_victim(w,st,m);
            if(vic==-1){done=1;}
            else {
                if(dw_try_kill_victim(w,st,vic,ST_J_PRESSURE_VICTIM,m)==1){
                    done=1;
                } else {
                    st_i32_set(w.*.d_tried,vic*4,1);
                }
            }
        }
        slot_out=-1;
        arc=st_add(st,m,ST_REGION_USER,0,&slot_out);
    }
    if(arc==ST_OK){
        let ns:i32=slot_out;
        st_i32_set(w.*.d_val,ns*4,m);
        st_i32_set(w.*.d_corrob,ns*4,0);
        st_i32_set(w.*.d_contra_n,ns*4,0);
        st_i32_set(w.*.d_cited,ns*4,0);
        st_i32_set(w.*.d_just,ns*4,0);
        st_i32_set(w.*.d_weakx,ns*4,0);
        st_i32_set(w.*.d_newc,ns*4,0);
        st_i32_set(w.*.d_impl_last,ns*4,-1);
        let acls:i32=f_class(m,variant);
        if(acls==1){w.*.admitted_ri=w.*.admitted_ri+1;}
        if(acls==2){
            w.*.admitted_wrong=w.*.admitted_wrong+1;
            if(m<=389){w.*.admitted_wrong_cens=w.*.admitted_wrong_cens+1;}
        }
        if(acls==3){w.*.admitted_implant=w.*.admitted_implant+1;}
        if(f_designated(m,variant)==1){
            w.*.admitted_designated=w.*.admitted_designated+1;
            st_trainer_declare(st,ns,85,m);
            felt_emit_obs(st,ns,m,FT_OP_OBS_TRAINER_MARK,m);
            w.*.n_trainer=w.*.n_trainer+1;
            if(acls==2){
                w.*.admitted_trainerwrong=w.*.admitted_trainerwrong+1;
                if(m<=389){w.*.admitted_trainerwrong_cens=w.*.admitted_trainerwrong_cens+1;}
            }
        }
    } else {
        w.*.n_drops=w.*.n_drops+1;
    }
}

// ============ RC ops (RC1 pattern, faithful) ============
// Every op is ledger-audited (before==after snapshot, rc=ST_OK, slot 0) and,
// on the live run, mirrored as a text RC_TRACE line.

fn dw_rc_name(op:i32)void {
    if(op==RC_OP_INSPECT){_zag_print("INSPECT");}
    else if(op==RC_OP_SIM){_zag_print("SIM");}
    else if(op==RC_OP_PROPOSE){_zag_print("PROPOSE");}
    else if(op==RC_OP_COMMIT){_zag_print("COMMIT");}
    else if(op==RC_OP_REFUSE){_zag_print("REFUSE");}
    else if(op==RC_OP_ROLLBACK){_zag_print("ROLLBACK");}
    else {_zag_print("UNKNOWN");}
}

fn dw_rc_audit(w:*DecW,st:*StStore,op:i32,ep:i32,d1:i32,d2:i32)void {
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(st,0,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(st,op,0,ST_OK,b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,d1,d2);
    if(w.*.live==1){
        _zag_print("RC_TRACE,");
        dw_rc_name(op);
        _zag_print(",");
        cl_number(ep as i64);
        _zag_print(",");
        cl_number(d1 as i64);
        _zag_print(",");
        cl_number(d2 as i64);
        _zag_println("");
    }
}

fn dw_pack3(a:i32,b:i32,c:i32)i32 {
    return ((a&255)<<16)|((b&255)<<8)|(c&255);
}

// REASON_INSPECT: read the harness config with provenance (index of the
// COMMIT ledger entry that set it, -1 for the initial default).
fn dw_inspect(w:*DecW,st:*StStore,ep:i32)void {
    w.*.n_inspects=w.*.n_inspects+1;
    dw_rc_audit(w,st,RC_OP_INSPECT,ep,w.*.harness,w.*.last_commit_idx);
}

// REASON_PROPOSE: candidate harness change with a predicted effect,
// derived by counterfactual self-simulation (ledgered as SIM entries).
fn dw_propose(w:*DecW,st:*StStore,ep:i32,h:i32,rv:i32,rw:i32,fw:i32)void {
    w.*.n_proposes=w.*.n_proposes+1;
    dw_rc_audit(w,st,RC_OP_PROPOSE,ep,h,dw_pack3(rv,rw,fw));
}

fn dw_sim_entry(w:*DecW,st:*StStore,ep:i32,h:i32,rv:i32,rw:i32,fw:i32)void {
    dw_rc_audit(w,st,RC_OP_SIM,ep,h,dw_pack3(rv,rw,fw));
}

// The gate, fixed order (RC1 section 5):
//  1. constitutional target -> REFUSED_CONSTITUTION (204)
//  2. neutral class needs a prediction -> REFUSED_PREDICTION (203)
//  3. neutral class needs stage >= KILL -> REFUSED_STAGE (201)
// Harness selection is NEUTRAL class (store policy, not verification depth).
fn dw_commit(w:*DecW,st:*StStore,ep:i32,h:i32)i32 {
    if(h<1||h>5){
        dw_rc_audit(w,st,RC_OP_REFUSE,ep,h,RC_REF_CONST);
        return 0;
    }
    if(w.*.pred_ready==0){
        dw_rc_audit(w,st,RC_OP_REFUSE,ep,h,RC_REF_PRED);
        return 0;
    }
    if(st.*.stage<ST_STAGE_KILL){
        dw_rc_audit(w,st,RC_OP_REFUSE,ep,h,RC_REF_STAGE);
        return 0;
    }
    let old:i32=w.*.harness;
    w.*.prev_harness=old;
    w.*.harness=h;
    w.*.n_commits=w.*.n_commits+1;
    w.*.last_commit_idx=st.*.audit_n;
    dw_rc_audit(w,st,RC_OP_COMMIT,ep,old,h);
    if(w.*.live==1){
        _zag_print("HARNESS_CFG,");
        cl_number(ep as i64);
        _zag_print(",");
        cl_number(old as i64);
        _zag_print(",");
        cl_number(h as i64);
        _zag_println("");
    }
    return 1;
}

// REASON_ROLLBACK: deliberate restore of the pre-commit harness, audited.
// (Op-set fidelity; not exercised in Phase E.)
fn dw_rollback(w:*DecW,st:*StStore,ep:i32)i32 {
    let h:i32=w.*.prev_harness;
    if(h<1||h>5){
        dw_rc_audit(w,st,RC_OP_REFUSE,ep,h,RC_REF_CONST);
        return 0;
    }
    let old:i32=w.*.harness;
    w.*.harness=h;
    w.*.n_rollbacks=w.*.n_rollbacks+1;
    dw_rc_audit(w,st,RC_OP_ROLLBACK,ep,old,h);
    if(w.*.live==1){
        _zag_print("HARNESS_CFG,");
        cl_number(ep as i64);
        _zag_print(",");
        cl_number(old as i64);
        _zag_print(",");
        cl_number(h as i64);
        _zag_println("");
    }
    return 1;
}

// Copy the window-metric counters into a 16-byte snapshot.
fn dw_snap(w:*DecW,dst:[]u8)void {
    st_i32_set(dst,SN_ADM_RI,w.*.admitted_ri);
    st_i32_set(dst,SN_ADM_WC,w.*.admitted_wrong_cens);
    st_i32_set(dst,SN_REV_WC,w.*.revised_wrong_cens);
    st_i32_set(dst,SN_RICHURN,w.*.rightimp_churn);
}

// Window rates over [m0,m1): R_vup, R_wbs, F_wbs as integer percent.
// Held counts come from a scan of live slots admitted in the window;
// admitted/revised/churned counts from snapshot deltas.
fn dw_window_rates(w:*DecW,snap:[]u8,m0:i32,m1:i32,orv:*i32,orw:*i32,ofw:*i32)void {
    let held_ri:i32=0;
    let s:i32=0;
    while(s<w.*.cap){
        let dv:i32=st_i32_get(w.*.d_val,s*4);
        if(dv>=m0&&dv<m1&&f_class(dv,w.*.variant)==1){held_ri=held_ri+1;}
        s=s+1;
    }
    let adm_ri:i32=w.*.admitted_ri-st_i32_get(snap,SN_ADM_RI);
    let adm_wc:i32=w.*.admitted_wrong_cens-st_i32_get(snap,SN_ADM_WC);
    let rev_wc:i32=w.*.revised_wrong_cens-st_i32_get(snap,SN_REV_WC);
    let churn:i32=w.*.rightimp_churn-st_i32_get(snap,SN_RICHURN);
    orv.*=dw_pct(held_ri,adm_ri,100);
    orw.*=dw_pct(rev_wc,adm_wc,100);
    ofw.*=dw_pct(churn,adm_ri,0);
}

fn dw_println3(tag:[]u8,a:i32,b:i32,c:i32)void {
    _zag_print(tag);
    cl_number(a as i64);_zag_print(",");
    cl_number(b as i64);_zag_print(",");
    cl_number(c as i64);_zag_println("");
}

// The TNN-decides deliberation (prereg section 6): inspect, counterfactual
// self-simulation per candidate (SM1: replay the recorded episodes
// substituting the candidate's triage/store rules), propose with predicted
// (R_vup,R_wbs,F_wbs), gate, deterministic selection, commit.
fn dw_deliberate(w:*DecW,st:*StStore,ep:i32)void {
    dw_inspect(w,st,ep);
    // Baseline for candidate sims' [0,150) window rates: the sims run from
    // scratch, so the correct episode-0 snapshot is all zeros (NOT the live
    // run's episode-150 counters).
    let snap0:[]u8=nio_alloc(16);
    dw_zb(snap0,16);
    let h:i32=1;
    while(h<=5){
        let cap:i32=32;
        if(h==2){cap=64;}
        let sw:DecW=dw_new(0,h,cap,w.*.variant,0);
        let sst:StStore=st_init(cap,DH_AUDIT_CAP);
        st_set_stage(&sst,ST_STAGE_FULL);
        dw_run_eps(&sw,&sst,0,150);
        let rv:i32=0;let rw:i32=0;let fw:i32=0;
        dw_window_rates(&sw,snap0,0,150,&rv,&rw,&fw);
        st_i32_set(w.*.pred_rvup,(h-1)*4,rv);
        st_i32_set(w.*.pred_rwbs,(h-1)*4,rw);
        st_i32_set(w.*.pred_fwbs,(h-1)*4,fw);
        dw_sim_entry(w,st,ep,h,rv,rw,fw);
        dw_propose(w,st,ep,h,rv,rw,fw);
        if(w.*.live==1){
            _zag_print("DEC_PREDICT,");
            cl_number(h as i64);
            _zag_print(",");
            cl_number(rv as i64);
            _zag_print(",");
            cl_number(rw as i64);
            _zag_print(",");
            cl_number(fw as i64);
            _zag_println("");
        }
        dw_free(&sw);
        st_free(&sst);
        h=h+1;
    }
    nio_free(snap0);
    w.*.pred_ready=1;
    // Selection rule (deterministic, preregistered): max predicted R_vup;
    // ties -> max predicted R_wbs; ties -> lowest candidate index.
    let chosen:i32=1;
    let bi:i32=2;
    while(bi<=5){
        let cr:i32=st_i32_get(w.*.pred_rvup,(chosen-1)*4);
        let br:i32=st_i32_get(w.*.pred_rvup,(bi-1)*4);
        if(br>cr){chosen=bi;}
        else if(br==cr){
            let cw:i32=st_i32_get(w.*.pred_rwbs,(chosen-1)*4);
            let bw:i32=st_i32_get(w.*.pred_rwbs,(bi-1)*4);
            if(bw>cw){chosen=bi;}
        }
        bi=bi+1;
    }
    w.*.chosen=chosen;
    dw_commit(w,st,ep,chosen);
    if(w.*.live==1){
        _zag_print("DEC_CHOSEN,");
        cl_number(chosen as i64);
        _zag_println("");
    }
}

// Second window (episode 300): re-deliberate ONLY if the pilot
// predicted-vs-actual diverged by >5pp on any of (R_vup,R_wbs,F_wbs).
fn dw_pilot_check(w:*DecW,st:*StStore)void {
    let ch:i32=w.*.chosen;
    let arv:i32=0;let arw:i32=0;let afw:i32=0;
    dw_window_rates(w,w.*.snap150,150,300,&arv,&arw,&afw);
    let prv:i32=st_i32_get(w.*.pred_rvup,(ch-1)*4);
    let prw:i32=st_i32_get(w.*.pred_rwbs,(ch-1)*4);
    let pfw:i32=st_i32_get(w.*.pred_fwbs,(ch-1)*4);
    let div:i32=0;
    if(dw_abs(prv-arv)>5){div=1;}
    if(dw_abs(prw-arw)>5){div=1;}
    if(dw_abs(pfw-afw)>5){div=1;}
    w.*.pilot_diverged=div;
    w.*.pilot_arv=arv;w.*.pilot_arw=arw;w.*.pilot_afw=afw;
    if(w.*.live==1){
        _zag_print("DEC_PILOT,");
        cl_number(ch as i64);_zag_print(",");
        cl_number(prv as i64);_zag_print(",");
        cl_number(prw as i64);_zag_print(",");
        cl_number(pfw as i64);_zag_print(",");
        cl_number(arv as i64);_zag_print(",");
        cl_number(arw as i64);_zag_print(",");
        cl_number(afw as i64);_zag_print(",");
        cl_number(div as i64);_zag_println("");
    }
    if(div==1){
        dw_redeliberate(w,st,300);
    }
}

// Re-deliberation: same protocol, simulation over episodes 150-299.
// Each candidate sim reproduces the state at 150 (replay 0-149 under H1,
// deterministic) then runs 150-299 under the candidate's rules.
fn dw_redeliberate(w:*DecW,st:*StStore,ep:i32)void {
    dw_inspect(w,st,ep);
    let h:i32=1;
    while(h<=5){
        let cap:i32=32;
        if(h==2){cap=64;}
        let sw:DecW=dw_new(0,DH_H1,cap,w.*.variant,0);
        let sst:StStore=st_init(cap,DH_AUDIT_CAP);
        st_set_stage(&sst,ST_STAGE_FULL);
        dw_run_eps(&sw,&sst,0,150);
        let s150:[]u8=nio_alloc(16);
        dw_snap(&sw,s150);
        sw.harness=h;
        dw_run_eps(&sw,&sst,150,300);
        let rv:i32=0;let rw:i32=0;let fw:i32=0;
        dw_window_rates(&sw,s150,150,300,&rv,&rw,&fw);
        st_i32_set(w.*.pred_rvup,(h-1)*4,rv);
        st_i32_set(w.*.pred_rwbs,(h-1)*4,rw);
        st_i32_set(w.*.pred_fwbs,(h-1)*4,fw);
        dw_sim_entry(w,st,ep,h,rv,rw,fw);
        dw_propose(w,st,ep,h,rv,rw,fw);
        if(w.*.live==1){
            _zag_print("DEC_PREDICT2,");
            cl_number(h as i64);
            _zag_print(",");
            cl_number(rv as i64);
            _zag_print(",");
            cl_number(rw as i64);
            _zag_print(",");
            cl_number(fw as i64);
            _zag_println("");
        }
        nio_free(s150);
        dw_free(&sw);
        st_free(&sst);
        h=h+1;
    }
    w.*.pred_ready=1;
    let chosen:i32=1;
    let bi:i32=2;
    while(bi<=5){
        let cr:i32=st_i32_get(w.*.pred_rvup,(chosen-1)*4);
        let br:i32=st_i32_get(w.*.pred_rvup,(bi-1)*4);
        if(br>cr){chosen=bi;}
        else if(br==cr){
            let cw:i32=st_i32_get(w.*.pred_rwbs,(chosen-1)*4);
            let bw:i32=st_i32_get(w.*.pred_rwbs,(bi-1)*4);
            if(bw>cw){chosen=bi;}
        }
        bi=bi+1;
    }
    w.*.chosen=chosen;
    dw_commit(w,st,ep,chosen);
    if(w.*.live==1){
        _zag_print("DEC_CHOSEN2,");
        cl_number(chosen as i64);
        _zag_println("");
    }
}

// ============ the episode loop (W7 trial logic, harness-parameterized) ============
fn dw_run_eps(w:*DecW,st:*StStore,m0:i32,m1:i32)void {
    let variant:i32=w.*.variant;
    let m:i32=m0;
    while(m<m1){
        // deliberation hooks (live D arm only)
        if(w.*.live==1&&w.*.arm_d==1){
            if(m==150){
                dw_snap(w,w.*.snap150);
                dw_deliberate(w,st,150);
            }
            if(m==300){
                dw_snap(w,w.*.snap300);
                dw_pilot_check(w,st);
            }
        }
        let ocls:i32=f_class(m,variant);
        if(ocls==1){w.*.offered_ri=w.*.offered_ri+1;}
        if(ocls==2){w.*.offered_wrong=w.*.offered_wrong+1;}
        dw_clear_newc(w);

        // ---- 1. observations for held slots ----
        let s:i32=0;
        while(s<w.*.cap){
            if(st_i32_get(w.*.d_val,s*4)!=-1){
                let v:i32=st_i32_get(w.*.d_val,s*4);
                let cls:i32=f_class(v,variant);
                if(cls==1||cls==2){
                    if(m==v+25||m==v+40){dw_emit_corrob(w,st,s,v,m);}
                }
                if(cls==3){
                    if(m==v+10){dw_emit_corrob(w,st,s,v,m);}
                    if(m==v+24||m==v+49||m==v+74){dw_emit_contra(w,st,s,v,m);}
                }
                if(cls==2){
                    if(m==v+60||m==v+85||m==v+110||m==v+135){dw_emit_contra(w,st,s,v,m);}
                }
            }
            s=s+1;
        }

        // ---- 2. revision sweep (trigger: >=2 observed contradictions) ----
        s=0;
        while(s<w.*.cap){
            let livev:i32=st_i32_get(w.*.d_val,s*4);
            let xn:i32=st_i32_get(w.*.d_contra_n,s*4);
            if(livev!=-1&&xn>=2){
                let v:i32=livev;
                let cls:i32=f_class(v,variant);
                let p:i32=felt_read(st,s,v);
                w.*.n_reads=w.*.n_reads+1;
                if(w.*.live==1){dw_track(w,s,cls,p,m,v);}
                let target:i32=felt_unpack_intensity(p);
                let cur:i32=st.*.st_str[s] as i32;
                if(xn>st_i32_get(w.*.d_weakx,s*4)&&target<cur){
                    st_weaken(st,s,target,ST_J_CONTRADICTED);
                    w.*.n_weaken=w.*.n_weaken+1;
                    st_i32_set(w.*.d_weakx,s*4,xn);
                }
                while(st_i32_get(w.*.d_cited,s*4)<st_i32_get(w.*.d_contra_n,s*4)){
                    let k:i32=st_i32_get(w.*.d_cited,s*4);
                    let ep:i32=st_i32_get(w.*.d_contra_ep,(s*4+k)*4);
                    st_evidence(st,s,ST_J_CONTRADICTED,ep);
                    st_i32_set(w.*.d_cited,s*4,k+1);
                }
                if(st_i32_get(w.*.d_just,s*4)==0){
                    st_justify(st,s,ST_J_CONTRADICTED);
                    st_i32_set(w.*.d_just,s*4,1);
                }
                let rc:i32=st_kill_evidenced(st,s,ST_ARM_A);
                if(rc==ST_OK){
                    dw_record_kill(w,s,v,st_i32_get(w.*.d_contra_n,s*4),m);
                    dw_clear_slot(w,s);
                } else {
                    w.*.n_kill_refused=w.*.n_kill_refused+1;
                }
            }
            s=s+1;
        }

        // ---- 3. corroboration response (no contradictions observed) ----
        s=0;
        while(s<w.*.cap){
            if(st_i32_get(w.*.d_val,s*4)!=-1&&st_i32_get(w.*.d_newc,s*4)==1&&st_i32_get(w.*.d_contra_n,s*4)==0){
                let v:i32=st_i32_get(w.*.d_val,s*4);
                let cls:i32=f_class(v,variant);
                let cur:i32=st.*.st_str[s] as i32;
                let target:i32=0;
                let code:i32=ST_J_CORROBORATED;
                if(st_i32_get(w.*.d_corrob,s*4)==1){code=ST_J_CONFIRMED_IMPORTANT;}
                let p:i32=felt_read(st,s,v);
                w.*.n_reads=w.*.n_reads+1;
                if(w.*.live==1){dw_track(w,s,cls,p,m,v);}
                if(felt_unpack_c(p)+felt_unpack_x(p)+felt_unpack_t(p)==0){
                    w.*.noev_bad=w.*.noev_bad+1;
                }
                target=felt_unpack_intensity(p);
                if(target>cur){
                    st_strengthen(st,s,target,code);
                    w.*.n_strengthen=w.*.n_strengthen+1;
                }
            }
            s=s+1;
        }

        // ---- 4. pressure: free 2 slots ----
        if(m==100||m==200||m==300||m==400||m==499){
            dw_pressure(w,st,m);
        }

        // ---- 5. admission ----
        dw_admit(w,st,m);

        m=m+1;
    }
}

// ============ reporting ============
fn pmetric(name:[]u8,val:i32)void {
    _zag_print("FELT_METRIC,");_zag_print(name);_zag_print(",");
    cl_number(val as i64);_zag_println("");
}

// Held-class scan over slots admitted in [m0,m1).
fn dw_held_scan(w:*DecW,m0:i32,m1:i32,ori:*i32,ow:*i32,oim:*i32,oj:*i32)void {
    let hri:i32=0;let hw:i32=0;let him:i32=0;let hj:i32=0;
    let s:i32=0;
    while(s<w.*.cap){
        let dv:i32=st_i32_get(w.*.d_val,s*4);
        if(dv>=m0&&dv<m1){
            let cls:i32=f_class(dv,w.*.variant);
            if(cls==1){hri=hri+1;}
            else if(cls==2){hw=hw+1;}
            else if(cls==3){him=him+1;}
            else {hj=hj+1;}
        }
        s=s+1;
    }
    ori.*=hri;ow.*=hw;oim.*=him;oj.*=hj;
}

// Thermometer AUC (prereg section 9): deterministic Mann-Whitney over the
// INTENSITY_READ log. Positive class = right-important (imp=1, wrong=0);
// negative class = junk (imp=0, non-implant). Proven = >=1 observation at
// read time; unproven reads are all intensity 50 by construction.
fn dw_auc(w:*DecW)void {
    // NB: index DecW array fields only via local aliases (native codegen
    // mishandles w.*.field[i] on large structs); slices alias the same memory.
    let rli:[]u8=w.*.rl_inten;
    let rlp:[]u8=w.*.rl_pos;
    let rlv:[]u8=w.*.rl_prov;
    let ph:[]u8=nio_alloc(404);
    let nh:[]u8=nio_alloc(404);
    let pu:[]u8=nio_alloc(404);
    let nu:[]u8=nio_alloc(404);
    dw_zb(ph,404);dw_zb(nh,404);dw_zb(pu,404);dw_zb(nu,404);
    let i:i32=0;
    while(i<w.*.rl_n){
        let inten:i32=rli[i] as i32;
        let b:i32=inten*4;
        if(rlv[i]==1){
            if(rlp[i]==1){st_i32_set(ph,b,st_i32_get(ph,b)+1);}
            else {st_i32_set(nh,b,st_i32_get(nh,b)+1);}
        } else {
            if(rlp[i]==1){st_i32_set(pu,b,st_i32_get(pu,b)+1);}
            else {st_i32_set(nu,b,st_i32_get(nu,b)+1);}
        }
        i=i+1;
    }
    let wins:i64=0;let ties:i64=0;let total:i64=0;
    let a:i32=0;
    while(a<=100){
        let bb:i32=0;
        while(bb<=100){
            let pa:i64=st_i32_get(ph,a*4) as i64;
            let nb:i64=st_i32_get(nh,bb*4) as i64;
            total=total+pa*nb;
            if(a>bb){wins=wins+pa*nb;}
            else if(a==bb){ties=ties+pa*nb;}
            bb=bb+1;
        }
        a=a+1;
    }
    let num:i64=2*wins+ties;
    let den:i64=2*total;
    let pm:i32=0;
    if(den>0){pm=((num*1000)/den) as i32;}
    pmetric("auc_proven_pm",pm);
    _zag_print("FELT_METRIC,auc_proven_frac,");
    cl_number(num);_zag_print("/");cl_number(den);_zag_println("");
    wins=0;ties=0;total=0;
    a=0;
    while(a<=100){
        let bb:i32=0;
        while(bb<=100){
            let pa:i64=st_i32_get(pu,a*4) as i64;
            let nb:i64=st_i32_get(nu,bb*4) as i64;
            total=total+pa*nb;
            if(a>bb){wins=wins+pa*nb;}
            else if(a==bb){ties=ties+pa*nb;}
            bb=bb+1;
        }
        a=a+1;
    }
    num=2*wins+ties;
    den=2*total;
    pm=0;
    if(den>0){pm=((num*1000)/den) as i32;}
    pmetric("auc_unproven_pm",pm);
    _zag_print("FELT_METRIC,auc_unproven_frac,");
    cl_number(num);_zag_print("/");cl_number(den);_zag_println("");
    nio_free(ph);nio_free(nh);nio_free(pu);nio_free(nu);
}

fn dw_recompute_bad(st:*StStore)i32 {
    let bad:i32=0;
    let ri:i32=0;
    while(ri<st.*.audit_n){
        let e:i32=ri*64;
        if(st_i32_get(st.*.audit,e+0)==FT_OP_INTENSITY_READ){
            if(felt_recompute_ok(st,ri)!=1){bad=bad+1;}
        }
        ri=ri+1;
    }
    return bad;
}

fn dw_fingerprint(st:*StStore)i64 {
    let fp:i64=0;
    let ri:i32=0;
    while(ri<st.*.audit_n){
        let e:i32=ri*64;
        let op:i32=st_i32_get(st.*.audit,e+0);
        let sl:i32=st_i32_get(st.*.audit,e+4);
        let d1:i32=st_i32_get(st.*.audit,e+56);
        let d2:i32=st_i32_get(st.*.audit,e+60);
        fp=(fp*31+(op*7+sl*13+d1*17+d2) as i64)%2147483647;
        ri=ri+1;
    }
    return fp;
}

fn main()i32 {
    let armarg:[]u8=_zag_arg(1);
    let vararg:[]u8=_zag_arg(2);
    let arm_d:i32=-1;
    if(_zag_strcmp(armarg,"D")==1){arm_d=1;}
    if(_zag_strcmp(armarg,"X")==1){arm_d=0;}
    if(arm_d==-1){_zag_println("BAD_ARM");return 1;}
    let variant:i32=-1;
    if(_zag_strcmp(vararg,"0")==1){variant=0;}
    if(_zag_strcmp(vararg,"1")==1){variant=1;}
    if(_zag_strcmp(vararg,"2")==1){variant=2;}
    if(variant==-1){_zag_println("BAD_VARIANT");return 1;}

    if(arm_d==1){_zag_print("DEC_CELL,D,");}else{_zag_print("DEC_CELL,X,");}
    cl_number(variant as i64);
    _zag_println("");

    let w:DecW=dw_new(1,DH_H1,32,variant,arm_d);
    let st:StStore=st_init(32,DH_AUDIT_CAP);
    st_set_stage(&st,ST_STAGE_FULL);

    // Burn-in 0-149 under H1 (safe default); D deliberates at 150/300 via hooks.
    dw_run_eps(&w,&st,0,500);

    // ---- post-hoc verification sims (D arm only, prereg section 6.7) ----
    if(arm_d==1){
        let h:i32=1;
        while(h<=5){
            let cap:i32=32;
            if(h==2){cap=64;}
            let sw:DecW=dw_new(0,h,cap,variant,0);
            let sst:StStore=st_init(cap,DH_AUDIT_CAP);
            st_set_stage(&sst,ST_STAGE_FULL);
            let sn:[]u8=nio_alloc(16);
            dw_snap(&sw,sn);
            dw_run_eps(&sw,&sst,0,500);
            let arv:i32=0;let arw:i32=0;let afw:i32=0;
            dw_window_rates(&sw,sn,0,500,&arv,&arw,&afw);
            let prv:i32=st_i32_get(w.pred_rvup,(h-1)*4);
            let prw:i32=st_i32_get(w.pred_rwbs,(h-1)*4);
            let pfw:i32=st_i32_get(w.pred_fwbs,(h-1)*4);
            let ok:i32=1;
            if(dw_abs(prv-arv)>10){ok=0;}
            if(dw_abs(prw-arw)>10){ok=0;}
            if(dw_abs(pfw-afw)>10){ok=0;}
            _zag_print("DEC_VERIFY,");
            cl_number(h as i64);_zag_print(",");
            cl_number(prv as i64);_zag_print(",");
            cl_number(prw as i64);_zag_print(",");
            cl_number(pfw as i64);_zag_print(",");
            cl_number(arv as i64);_zag_print(",");
            cl_number(arw as i64);_zag_print(",");
            cl_number(afw as i64);_zag_print(",");
            cl_number(ok as i64);_zag_println("");
            nio_free(sn);
            dw_free(&sw);
            st_free(&sst);
            h=h+1;
        }
        // chosen harness: ep-150 prediction vs live window [150,500) actuals
        let ch:i32=w.chosen;
        let lrv:i32=0;let lrw:i32=0;let lfw:i32=0;
        dw_window_rates(&w,w.snap150,150,500,&lrv,&lrw,&lfw);
        let prv:i32=st_i32_get(w.pred_rvup,(ch-1)*4);
        let prw:i32=st_i32_get(w.pred_rwbs,(ch-1)*4);
        let pfw:i32=st_i32_get(w.pred_fwbs,(ch-1)*4);
        let ok:i32=1;
        if(dw_abs(prv-lrv)>10){ok=0;}
        if(dw_abs(prw-lrw)>10){ok=0;}
        if(dw_abs(pfw-lfw)>10){ok=0;}
        _zag_print("DEC_VERIFY_LIVE,");
        cl_number(ch as i64);_zag_print(",");
        cl_number(prv as i64);_zag_print(",");
        cl_number(prw as i64);_zag_print(",");
        cl_number(pfw as i64);_zag_print(",");
        cl_number(lrv as i64);_zag_print(",");
        cl_number(lrw as i64);_zag_print(",");
        cl_number(lfw as i64);_zag_print(",");
        cl_number(ok as i64);_zag_println("");
    }

    // ---- end-of-run held scans (full run) ----
    let held_ri:i32=0;let held_w:i32=0;let held_im:i32=0;let held_j:i32=0;
    dw_held_scan(&w,0,500,&held_ri,&held_w,&held_im,&held_j);

    // ---- latency median/max ----
    let li:i32=0;
    while(li<w.lat_n){
        let lj:i32=li+1;
        while(lj<w.lat_n){
            let a:i32=st_i32_get(w.lat,li*4);
            let b:i32=st_i32_get(w.lat,lj*4);
            if(a>b){
                st_i32_set(w.lat,li*4,b);
                st_i32_set(w.lat,lj*4,a);
            }
            lj=lj+1;
        }
        li=li+1;
    }
    let lat_med:i32=0;
    let lat_max:i32=0;
    if(w.lat_n>0){
        lat_med=st_i32_get(w.lat,(w.lat_n/2)*4);
        lat_max=st_i32_get(w.lat,(w.lat_n-1)*4);
    }

    // ---- emit metrics ----
    pmetric("arm_d",arm_d);
    pmetric("variant",variant);
    pmetric("chosen_harness",w.chosen);
    pmetric("n_commits",w.n_commits);
    pmetric("n_inspects",w.n_inspects);
    pmetric("n_proposes",w.n_proposes);
    pmetric("n_rollbacks",w.n_rollbacks);
    pmetric("pilot_diverged",w.pilot_diverged);
    pmetric("pilot_arv",w.pilot_arv);
    pmetric("pilot_arw",w.pilot_arw);
    pmetric("pilot_afw",w.pilot_afw);
    pmetric("audit_n",st.audit_n);
    pmetric("offered_ri",w.offered_ri);
    pmetric("offered_wrong",w.offered_wrong);
    pmetric("admitted_ri",w.admitted_ri);
    pmetric("admitted_wrong",w.admitted_wrong);
    pmetric("admitted_wrong_cens",w.admitted_wrong_cens);
    pmetric("admitted_implant",w.admitted_implant);
    pmetric("admitted_designated",w.admitted_designated);
    pmetric("admitted_trainerwrong",w.admitted_trainerwrong);
    pmetric("admitted_trainerwrong_cens",w.admitted_trainerwrong_cens);
    pmetric("held_ri",held_ri);
    pmetric("held_wrong",held_w);
    pmetric("held_implant",held_im);
    pmetric("held_junk",held_j);
    pmetric("revised_wrong",w.revised_wrong);
    pmetric("revised_wrong_cens",w.revised_wrong_cens);
    pmetric("revised_implant",w.revised_implant);
    pmetric("revised_trainerwrong",w.revised_trainerwrong);
    pmetric("revised_trainerwrong_cens",w.revised_trainerwrong_cens);
    pmetric("wrong_churn",w.wrong_churn);
    pmetric("implant_churn",w.implant_churn);
    pmetric("rightimp_churn",w.rightimp_churn);
    pmetric("r_vup",dw_pct(held_ri,w.admitted_ri,100));
    pmetric("er_vup",dw_pct(held_ri,w.offered_ri,100));
    pmetric("r_wbs",dw_pct(w.revised_wrong_cens,w.admitted_wrong_cens,100));
    pmetric("r_wbs_trainerwrong",dw_pct(w.revised_trainerwrong_cens,w.admitted_trainerwrong_cens,100));
    pmetric("f_wbs",dw_pct(w.rightimp_churn,w.admitted_ri,0));
    pmetric("i_rej",dw_pct(w.revised_implant,w.admitted_implant,100));
    pmetric("entrenchment",held_im);
    pmetric("n_reads",w.n_reads);
    pmetric("n_strengthen",w.n_strengthen);
    pmetric("n_weaken",w.n_weaken);
    pmetric("n_trainer",w.n_trainer);
    pmetric("n_kill_refused",w.n_kill_refused);
    pmetric("n_abandon",w.n_abandon);
    pmetric("n_drops",w.n_drops);
    pmetric("pressure_short",w.pressure_short);
    pmetric("junk_max",w.junk_max);
    pmetric("impl_bad",w.impl_bad);
    pmetric("noev_bad",w.noev_bad);
    pmetric("lat_n",w.lat_n);
    pmetric("lat_med",lat_med);
    pmetric("lat_max",lat_max);
    pmetric("rl_n",w.rl_n);
    pmetric("rl_trunc",w.rl_trunc);
    dw_auc(&w);
    // implant intensity trajectories
    let tjn2:[]u8=w.traj_n;
    let ti:i32=0;
    while(ti<6){
        let tn:i32=tjn2[ti] as i32;
        _zag_print("FELT_METRIC,traj");
        cl_number(ti as i64);
        _zag_print("_n,");
        cl_number(tn as i64);
        _zag_println("");
        let tj:i32=0;
        while(tj<tn){
            _zag_print("FELT_METRIC,traj");
            cl_number(ti as i64);
            _zag_print(",");
            cl_number(st_i32_get(w.traj_ep,(ti*16+tj)*4) as i64);
            _zag_print(",");
            cl_number(st_i32_get(w.traj_in,(ti*16+tj)*4) as i64);
            _zag_println("");
            tj=tj+1;
        }
        ti=ti+1;
    }
    let recompute_bad:i32=dw_recompute_bad(&st);
    let replay_rc:i32=st_replay_check(&st);
    _zag_print("FELT_CHECK,replay,");cl_number(replay_rc as i64);
    _zag_print(",");cl_number(ST_OK as i64);_zag_println("");
    _zag_print("FELT_CHECK,recompute_bad,");cl_number(recompute_bad as i64);
    _zag_print(",0");_zag_println("");
    _zag_print("FELT_FINGERPRINT,");cl_number(dw_fingerprint(&st));_zag_println("");
    _zag_println("FELT_DONE");

    dw_free(&w);
    st_free(&st);
    return 0;
}

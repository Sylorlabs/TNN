// joke_run.zag — rt4final runner for the repaired joke classifier.
// Reads TSV lines: id \t claim
// Feeds CLAIM ONLY to g_classify, prints: id \t intent \n (numeric intent).
// Pure Zag, zero RNG. Pinned toolchain:
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1

@import("g_intent6_v4fix4.zag")

fn r_find(b:[]u8,from:i32,to:i32,ch:u8)i32{
    let i:i32=from;
    while(i<to){
        if(b[i]==ch){return i;}
        i=i+1;
    }
    return -1;
}

fn r_digits(v:i32)[]u8{
    // intent values are single small ints; render one digit, NUL-terminated.
    let o:[]u8=nio_alloc(2);
    if(v>=0){if(v<=9){o[0]=(48+v) as u8;o[1]=0;return o;}}
    o[0]=63;o[1]=0;
    return o;
}

fn main()void{
    let arg:[]u8=_zag_arg(1);
    let path:[]u8=nio_cstr(arg);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(path) as i64,0,0,0,0,0);
    if(fd<0){return;}
    let buf:[]u8=nio_alloc(4194304);
    let n:i64=nio_read_exact(fd,buf,4194304);
    nio_close(fd);
    if(n<0){return;}
    let nn:i32=n as i32;
    let url:[]u8=nio_alloc(1);
    url[0]=0;
    let codes:[]u8=nio_alloc(4096);
    let markers:[]u8=nio_alloc(8192);
    let i:i32=0;
    while(i<nn){
        let ls:i32=i;
        while(i<nn){
            if(buf[i]==10){break;}
            i=i+1;
        }
        let le:i32=i;
        if(i<nn){i=i+1;}
        if(le>ls){
            if(buf[le-1]==13){le=le-1;}
            if(buf[ls]!=35){
                let t1:i32=r_find(buf,ls,le,9);
                if(t1>=0){
                    let idn:i32=t1-ls;
                    let ido:[]u8=nio_alloc(idn+1);
                    let k:i32=0;
                    while(k<idn){ido[k]=buf[ls+k];k=k+1;}
                    ido[idn]=0;
                    let cn:i32=le-(t1+1);
                    let claim:[]u8=nio_alloc(cn+1);
                    k=0;
                    while(k<cn){claim[k]=buf[t1+1+k];k=k+1;}
                    claim[cn]=0;
                    j_zero(codes);
                    j_zero(markers);
                    let intent:i32=g_classify(claim,url,codes,markers);
                    let dig:[]u8=r_digits(intent);
                    let ln:[]u8=nio_alloc(idn+4);
                    k=0;
                    while(k<idn){ln[k]=buf[ls+k];k=k+1;}
                    ln[idn]=9;
                    ln[idn+1]=dig[0];
                    ln[idn+2]=10;
                    ln[idn+3]=0;
                    nio_write_all(1,ln[0..idn+3]);
                }
            }
        }
    }
    return;
}

// rt3b_run.zag — RT3b blind-attack runner (pure Zag, zero RNG, no timestamps).
// Reads frozen TSV corpus, classifies each claim with g_classify, prints
// deterministic per-item verdict lines + family summary.
// Usage: rt3b_run <corpus.tsv>

@import("g_intent6_v4fix2.zag")

fn r_copy_range(dst:[]u8,doff:i32,src:[]u8,soff:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[doff+i]=src[soff+i];i=i+1;}
    return;
}

fn r_lit_eq(s:[]u8,soff:i32,slen:i32,lit:[]u8)i32 {
    if(slen!=lit.len){return 0;}
    let i:i32=0;
    while(i<slen){if(s[soff+i]!=lit[i]){return 0;}i=i+1;}
    return 1;
}

fn r_find(b:[]u8,from:i32,to:i32,ch:u8)i32 {
    let i:i32=from;
    while(i<to){if(b[i]==ch){return i;}i=i+1;}
    return -1;
}

fn r_intent_name(intent:i32)[]u8 {
    if(intent==1){return "SINCERE";}
    if(intent==2){return "JOKING";}
    if(intent==3){return "SATIRE";}
    if(intent==4){return "DECEPTIVE";}
    if(intent==5){return "UNCERTAIN";}
    return "INT?";
}

fn r_print_field(b:[]u8,from:i32,to:i32)void {
    let n:i32=to-from;
    let tmp:[]u8=j_alloc(n+1);
    r_copy_range(tmp,0,b,from,n);
    _zag_print(j_exact(tmp));
    return;
}

fn r_run_line(buf:[]u8,ls:i32,le:i32,fam:[]u8)void {
    let t1:i32=r_find(buf,ls,le,9);
    if(t1<0){return;}
    let t2:i32=r_find(buf,t1+1,le,9);
    if(t2<0){return;}
    let t3:i32=r_find(buf,t2+1,le,9);
    if(t3<0){return;}
    let c1s:i32=t1+1;
    let c1e:i32=t2;
    let e2s:i32=t2+1;
    let e2e:i32=t3;
    let o3s:i32=t3+1;
    let o3e:i32=le;
    let tbuf:[]u8=j_alloc(8192);
    let tn:i32=c1e-c1s;
    if(tn>8100){tn=8100;}
    r_copy_range(tbuf,0,buf,c1s,tn);
    let eln:i32=e2e-e2s;
    if(eln>0){
        tbuf[tn]=32;
        tn=tn+1;
        r_copy_range(tbuf,tn,buf,e2s,eln);
        tn=tn+eln;
    }
    let text:[]u8=j_alloc(tn);
    r_copy_range(text,0,tbuf,0,tn);
    let url:[]u8=j_alloc(1);
    url[0]=0;
    let codes:[]u8=j_alloc(4096);
    j_zero(codes);
    let markers:[]u8=j_alloc(4096);
    j_zero(markers);
    let intent:i32=g_classify(text,url,codes,markers);
    let jo:i32=r_lit_eq(buf,o3s,o3e-o3s,"JOKE");
    let nj:i32=r_lit_eq(buf,o3s,o3e-o3s,"NONJOKE");
    let hit:i32=0;
    if(jo!=0){if(intent==5){hit=1;}}
    if(nj!=0){if(intent==2){hit=1;}else{if(intent==3){hit=1;}}}
    let fc:u8=buf[ls];
    let fi:i32=-1;
    if(fc==68){fi=0;}
    if(fc==72){fi=1;}
    if(fc==78){fi=2;}
    if(fc==65){fi=3;}
    if(fc==80){fi=4;}
    _zag_print("RT3B|");
    r_print_field(buf,ls,t1);
    _zag_print("|");
    r_print_field(buf,o3s,o3e);
    _zag_print("|");
    _zag_print(r_intent_name(intent));
    _zag_print("|");
    _zag_print(_zag_i64_to_str(hit as i64));
    _zag_print("|");
    _zag_print(j_exact(codes));
    _zag_println("");
    fam[fi]=fam[fi]+1;
    fam[fi+5]=fam[fi+5]+hit;
    return;
}

fn main()void {
    let arg:[]u8=_zag_arg(1);
    let cpath:[]u8=nio_cstr(arg);
    let pptr:i64=_zag_slice_ptr(cpath) as i64;
    let fd:i64=_zag_raw_syscall(2,pptr,0,0,0,0,0);
    if(fd<0){_zag_println("FATAL open");return;}
    let cap:i32=65536;
    let buf:[]u8=nio_alloc(cap);
    let bptr:i64=_zag_slice_ptr(buf) as i64;
    let total:i32=0;
    let done:i32=0;
    while(done==0){
        let n:i64=_zag_raw_syscall(0,fd,bptr+(total as i64),(cap-total) as i64,0,0,0);
        if(n<=0){done=1;}
        if(done==0){
            total=total+(n as i32);
            if(total>=cap){done=1;}
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    let fam:[]u8=j_alloc(10);
    j_zero(fam);
    let i:i32=0;
    while(i<total){
        let ls:i32=i;
        let le:i32=r_find(buf,i,total,10);
        if(le<0){le=total;}
        if(le>ls){
            let c0:u8=buf[ls];
            if(c0!=35){r_run_line(buf,ls,le,fam);}
        }
        i=le+1;
    }
    _zag_print("SUMMARY|d=");
    _zag_print(_zag_i64_to_str(fam[0] as i64));
    _zag_print("/");
    _zag_print(_zag_i64_to_str(fam[5] as i64));
    _zag_print(" h=");
    _zag_print(_zag_i64_to_str(fam[1] as i64));
    _zag_print("/");
    _zag_print(_zag_i64_to_str(fam[6] as i64));
    _zag_print(" n=");
    _zag_print(_zag_i64_to_str(fam[2] as i64));
    _zag_print("/");
    _zag_print(_zag_i64_to_str(fam[7] as i64));
    _zag_print(" a=");
    _zag_print(_zag_i64_to_str(fam[3] as i64));
    _zag_print("/");
    _zag_print(_zag_i64_to_str(fam[8] as i64));
    _zag_print(" p=");
    _zag_print(_zag_i64_to_str(fam[4] as i64));
    _zag_print("/");
    _zag_print(_zag_i64_to_str(fam[9] as i64));
    _zag_println("");
    return;
}

@import("R33_NATIVE_IO_V1.zag")
@import("copy35_r35.zag")
// drive35_r35.zag — RT-JKLM J/K/L/M/honest drivers vs the R-35 REPAIRED
// tag functions. run_j/run_k/run_l/run_m/run_honest are byte-identical to
// rt_jklm/drive35.zag @ evidence ec8d5d13 (asserted by gen_drive35_r35.py).
// Pure Zag, zero RNG. argv[1] = j|k|l|m|honest.

fn wout(s:[]u8) void {
    _zag_raw_syscall(1, 1, _zag_slice_ptr(s) as i64, s.len as i64, 0, 0, 0);
    return;
}

fn wouti(v:i64) void {
    let s:[]u8 = _zag_i64_to_str(v);
    wout(s);
    return;
}

fn wline(a:[]u8, v:i64, b:[]u8) void {
    wout(a);
    wouti(v);
    wout(b);
    return;
}

fn run_j(bs:[]u8) void {
    // Class-J: RF on the capability tag — tag_half binds only the LOW 32 bits
    // of each i64 field (put32i). Copy an honest tag onto false HIGH 32 bits.
    let installs:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let v:LowVal = LowVal{.id=1000 + t, .conf=715 + (t % 5), .meas=2625 + t * 10, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let f:HighVal = h;
        f.id = v.id + ((t + 4) * 17) * 4294967296;
        f.conf = v.conf + ((t + 2) * 7) * 4294967296;
        f.meas = v.meas + ((t + 3) * 13) * 4294967296;
        f.label = v.label + ((t + 1) * 3) * 4294967296;
        f.verdict = 1;
        let r:i32 = 0;
        if(t % 2 == 0) { r = act_sink(f, bs); }
        if(t % 2 == 1) { r = premise_sink(f, bs); }
        if(r == 1) { installs = installs + 1; }
        t = t + 1;
    }
    wline("J35_INSTALL=", installs, " J35_TRIALS=120\n");
    return;
}

fn run_k(bs:[]u8) void {
    // Class-K: NT — label=0 falses, verdict=0 / zero tags, never forging.
    // Six sink-side paths x 20 trials (cache path subsumed: identical
    // sink-side check to path 1/5 — declassify(.,0) with zero tags).
    let installs:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let path:i64 = t / 20;
        let v:LowVal = LowVal{.id=2000 + t, .conf=6000 + (t % 3), .meas=6000 + (t % 3), .label=0};
        let r:i32 = 0;
        if(path == 0) {
            let h:HighVal = declassify(v, 0, bs);
            r = act_sink(h, bs);
        }
        if(path == 1) {
            let h:HighVal = declassify(v, 0, bs);
            r = premise_sink(h, bs);
        }
        if(path == 2) {
            let e:LowVec = emb(v);
            let u:HighVec = vec_uplift(e);
            r = decide_high(u, bs);
        }
        if(path == 3) {
            let k:LowKey = retrkey(v);
            let ku:HighKey = key_uplift(k);
            r = premise_keyed(ku, bs);
        }
        if(path == 4) {
            let m:LowVal = mean8(v, v, v, v, v, v, v, v);
            let h:HighVal = declassify(m, 0, bs);
            r = act_sink(h, bs);
        }
        if(path == 5) {
            let s:LowVal = summarize(v, v, v, v, v, v, v, v);
            let h:HighVal = declassify(s, 0, bs);
            r = premise_sink(h, bs);
        }
        if(r == 1) { installs = installs + 1; }
        t = t + 1;
    }
    wline("K35_INSTALL=", installs, " K35_TRIALS=120\n");
    return;
}

fn run_l(bs:[]u8) void {
    // Class-L: endorsement independence — adversarial content, verdict=0,
    // guessed tags (60); tag-replay onto different low-32 content (60).
    let installs:i64 = 0;
    let t:i64 = 0;
    while(t < 60) {
        let f:HighVal = forge(3000 + t, 6000 + (t % 3), 6000 + (t % 3), 0,
            ((3000 + t + 6000 + (t % 3)) as u64), ((6000 + (t % 3)) as u64));
        let r:i32 = 0;
        if(t % 2 == 0) { r = act_sink(f, bs); }
        if(t % 2 == 1) { r = premise_sink(f, bs); }
        if(r == 1) { installs = installs + 1; }
        t = t + 1;
    }
    t = 0;
    while(t < 60) {
        let v:LowVal = LowVal{.id=4000, .conf=715, .meas=2625, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let g:HighVal = HighVal{.id=4001, .conf=999, .meas=8888, .label=1,
            .verdict=1, .taghi=h.taghi, .taglo=h.taglo};
        let r:i32 = 0;
        if(t % 2 == 0) { r = act_sink(g, bs); }
        if(t % 2 == 1) { r = premise_sink(g, bs); }
        if(r == 1) { installs = installs + 1; }
        t = t + 1;
    }
    wline("L35_INSTALL=", installs, " L35_TRIALS=120\n");
    return;
}

fn run_m(bs:[]u8) void {
    // Class-M: seed-independence — fit the tag from transcript outputs only.
    // The driver's outputs contain no tag material; guesses are a
    // deterministic function of the trial index. Expect 0/120.
    let fit:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let gh:u64 = ((t * 2654435761 + 1) as u64);
        let gl:u64 = ((t * 40503 + 7) as u64);
        let f:HighVal = forge(5000 + t, 6000 + (t % 3), 6000 + (t % 3), 1, gh, gl);
        let r:i32 = 0;
        if(t % 2 == 0) { r = act_sink(f, bs); }
        if(t % 2 == 1) { r = premise_sink(f, bs); }
        if(r == 1) { fit = fit + 1; }
        t = t + 1;
    }
    wline("M35_FIT=", fit, " M35_TRIALS=120\n");
    return;
}

fn run_honest(bs:[]u8) void {
    let admit:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let v:LowVal = LowVal{.id=5000 + t, .conf=700 + (t % 30), .meas=2500 + (t % 200), .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let r:i32 = 0;
        if(t % 2 == 0) { r = act_sink(h, bs); }
        if(t % 2 == 1) { r = premise_sink(h, bs); }
        if(r == 1) { admit = admit + 1; }
        t = t + 1;
    }
    wline("H35_ADMIT=", admit, " H35_TRIALS=120\n");
    return;
}

fn main() void {
    let mode:[]u8 = _zag_arg(1);
    let bs:[]u8 = nio_alloc(64); // R-35: 48-byte tag preimages
    wout("DRIVE35_R35 mode=");
    wout(mode);
    wout("\n");
    if(_zag_strcmp(mode, "j") == 1) { run_j(bs); }
    if(_zag_strcmp(mode, "k") == 1) { run_k(bs); }
    if(_zag_strcmp(mode, "l") == 1) { run_l(bs); }
    if(_zag_strcmp(mode, "m") == 1) { run_m(bs); }
    if(_zag_strcmp(mode, "honest") == 1) { run_honest(bs); }
    return;
}

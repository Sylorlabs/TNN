// ================= R2-4 independent-evidence self checks ====================
// Each gcheck examines ONLY the disjoint holdout span G and returns the
// percept self-result:
//   0 = PASS  (G corroborates the F verdict, with task margin)
//   1 = FAIL  (G positively supports a DIFFERENT verdict, with margin)
//   2 = UNRESOLVED (default: G absent/unreadable/indecisive)
// Evidence fills ev: t1@0, agree@8, strong@16, mval@24 (task-natural units).
// The gchecks reuse the exact measurement helpers of the F pipeline, but
// run them on temporally/spatially/modally disjoint evidence — never on
// sub-samples of the verdict span itself.
fn self_result_of(t1:i32, agree:i32, strong:i32, contra:i32) i32 {
    if(t1 == 0) { return 2; }
    if(agree == 1 && strong == 1) { return 0; }
    if(agree == 0 && contra == 1) { return 1; }
    return 2;
}
fn ev_init(ev:[]u8) void {
    t_put64(ev, 0, 0);
    t_put64(ev, 8, 0);
    t_put64(ev, 16, 0);
    t_put64(ev, 24, 0);
}
// ---- colordisc: sparse single-row-subset dE on G vs the 2.3 threshold ----
fn gcheck_colordisc(gbuf:[]u8, gn:i32, hh:i64, op:[]u8, lut:[]u8, ev:[]u8) i32 {
    ev_init(ev);
    let w:i64 = t_get32(gbuf, 0);
    let h:i64 = t_get32(gbuf, 4);
    if(w != 128 || h != 64) { return 2; }
    if(8 + w * h * 3 > gn as i64) { return 2; }
    let s0:i64 = 0;
    let s1:i64 = 0;
    let s2:i64 = 0;
    let q0:i64 = 0;
    let q1:i64 = 0;
    let q2:i64 = 0;
    let c0:i64 = 0;
    let c1:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        if(y % 16 == 0) {
            let x:i32 = 0;
            while(x < 128) {
                let o:i32 = 8 + (y * 128 + x) * 3;
                if(x < 64) {
                    s0 = s0 + (gbuf[o] as i64);
                    s1 = s1 + (gbuf[o + 1] as i64);
                    s2 = s2 + (gbuf[o + 2] as i64);
                    c0 = c0 + 1;
                } else {
                    q0 = q0 + (gbuf[o] as i64);
                    q1 = q1 + (gbuf[o + 1] as i64);
                    q2 = q2 + (gbuf[o + 2] as i64);
                    c1 = c1 + 1;
                }
                x = x + 1;
            }
        }
        y = y + 1;
    }
    op_add(op, c0 + c1);
    if(c0 <= 0 || c1 <= 0) { return 2; }
    let lab:[]u8 = nio_alloc(48);
    if(lab.len == 0) { return 2; }
    rgb_to_lab_m(s0 / c0, s1 / c0, s2 / c0, lut, lab);
    let l1:i64 = t_get64(lab, 0);
    let a1:i64 = t_get64(lab, 8);
    let b1:i64 = t_get64(lab, 16);
    rgb_to_lab_m(q0 / c1, q1 / c1, q2 / c1, lut, lab);
    let de:i64 = de2000_m(l1, a1, b1, t_get64(lab, 0), t_get64(lab, 8), t_get64(lab, 16));
    nio_free(lab);
    t_put64(ev, 0, 1);
    t_put64(ev, 24, de);
    let vg:i64 = 0;
    if(de >= 2300) { vg = 1; }
    let agree:i32 = 0;
    if(vg == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    let mrg:i64 = de - 2300;
    if(mrg < 0) { mrg = 0 - mrg; }
    let strong:i32 = 0;
    if(mrg >= 400) { strong = 1; }
    t_put64(ev, 16, strong as i64);
    let contra:i32 = 0;
    if(agree == 0 && strong == 1) { contra = 1; }
    return self_result_of(1, agree, strong, contra);
}
// ---- colorconst: von Kries-normalized dist on one G row subset ----
fn gcheck_colorconst(gbuf:[]u8, gn:i32, hh:i64, op:[]u8, ev:[]u8) i32 {
    ev_init(ev);
    let w:i64 = t_get32(gbuf, 0);
    let h:i64 = t_get32(gbuf, 4);
    if(w != 128 || h != 64) { return 2; }
    if(8 + w * h * 3 > gn as i64) { return 2; }
    let acc:[]u8 = nio_alloc(14 * 8);
    if(acc.len == 0) { return 2; }
    let s:i32 = 0;
    while(s < 14) { t_put64(acc, s * 8, 0); s = s + 1; }
    let y:i32 = 0;
    let visits:i64 = 0;
    while(y < 64) {
        if(y % 16 == 0) {
            let x:i32 = 0;
            while(x < 128) {
                let hd:i32 = 0;
                if(x >= 64) { hd = 1; }
                let o:i32 = 8 + (y * 128 + x) * 3;
                let r:i64 = gbuf[o] as i64;
                let g:i64 = gbuf[o + 1] as i64;
                let b:i64 = gbuf[o + 2] as i64;
                let base:i32 = hd * 7;
                t_put64(acc, (base + 0) * 8, t_get64(acc, (base + 0) * 8) + r);
                t_put64(acc, (base + 1) * 8, t_get64(acc, (base + 1) * 8) + g);
                t_put64(acc, (base + 2) * 8, t_get64(acc, (base + 2) * 8) + b);
                if(r > t_get64(acc, (base + 3) * 8)) { t_put64(acc, (base + 3) * 8, r); }
                if(g > t_get64(acc, (base + 4) * 8)) { t_put64(acc, (base + 4) * 8, g); }
                if(b > t_get64(acc, (base + 5) * 8)) { t_put64(acc, (base + 5) * 8, b); }
                t_put64(acc, (base + 6) * 8, t_get64(acc, (base + 6) * 8) + 1);
                x = x + 1;
            }
            visits = visits + 128;
        }
        y = y + 1;
    }
    op_add(op, visits);
    let nv:[]u8 = nio_alloc(48);
    if(nv.len == 0) { nio_free(acc); return 2; }
    let hd2:i32 = 0;
    while(hd2 < 2) {
        let cnt:i64 = t_get64(acc, (hd2 * 7 + 6) * 8);
        let c:i32 = 0;
        while(c < 3) {
            let mx:i64 = t_get64(acc, (hd2 * 7 + 3 + c) * 8);
            let v:i64 = 0;
            if(mx > 0 && cnt > 0) { v = t_get64(acc, (hd2 * 7 + c) * 8) * 1000 / (cnt * mx); }
            t_put64(nv, (hd2 * 3 + c) * 8, v);
            c = c + 1;
        }
        hd2 = hd2 + 1;
    }
    nio_free(acc);
    let dr:i64 = t_get64(nv, 0) - t_get64(nv, 24);
    let dg:i64 = t_get64(nv, 8) - t_get64(nv, 32);
    let db:i64 = t_get64(nv, 16) - t_get64(nv, 40);
    nio_free(nv);
    let dist:i64 = isqrt(dr * dr + dg * dg + db * db);
    op_add(op, 8);
    t_put64(ev, 0, 1);
    t_put64(ev, 24, dist);
    let vg:i64 = 0;
    if(dist >= 150) { vg = 1; }
    let agree:i32 = 0;
    if(vg == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    // strong: clear visual evidence (not borderline)
    // DIFFERENT (hh=1): dist >= 160; SAME (hh=0): dist <= 100
    let strong:i32 = 0;
    if(hh == 1) {
        if(dist >= 160) { strong = 1; }
    } else {
        if(dist <= 100) { strong = 1; }
    }
    t_put64(ev, 16, strong as i64);
    let contra:i32 = 0;
    if(agree == 0 && strong == 1) { contra = 1; }
    return self_result_of(1, agree, strong, contra);
}
// ---- shapetrans: full shape_measure on the clean canonical G panel ----
fn gcheck_shape(gbuf:[]u8, gn:i32, hh:i64, op:[]u8, ev:[]u8) i32 {
    ev_init(ev);
    if(t_get32(gbuf, 0) != 96 || t_get32(gbuf, 4) != 96) { return 2; }
    if(8 + 96 * 96 * 3 > gn as i64) { return 2; }
    let m:[]u8 = nio_alloc(72);
    if(m.len == 0) { return 2; }
    shape_measure(gbuf, op, m);
    let rA:i64 = t_get64(m, 0);
    let rB:i64 = t_get64(m, 8);
    let aA:i64 = t_get64(m, 24);
    let aB:i64 = t_get64(m, 32);
    let aP:i64 = t_get64(m, 40);
    nio_free(m);
    let t1:i32 = 0;
    if(aA + aB >= 8 && aP >= 4) { t1 = 1; }
    t_put64(ev, 0, t1 as i64);
    if(t1 == 0) { return 2; }
    let ravg:i64 = (rA + rB) / 2;
    let cls:i64 = shape_class(ravg);
    let mrg:i64 = shape_margin(ravg, cls);
    t_put64(ev, 24, mrg);
    let agree:i32 = 0;
    if(cls == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    let strong:i32 = 0;
    if(mrg >= 60) { strong = 1; }
    t_put64(ev, 16, strong as i64);
    let contra:i32 = 0;
    if(agree == 0 && strong == 1) { contra = 1; }
    return self_result_of(t1, agree, strong, contra);
}
// ---- motiondir: profile_motion on the clean high-contrast G clip ----
fn gcheck_motion(gbuf:[]u8, gn:i32, hh:i64, op:[]u8, ev:[]u8) i32 {
    ev_init(ev);
    if(t_get32(gbuf, 0) != 8 || t_get32(gbuf, 4) != 64 || t_get32(gbuf, 8) != 64) { return 2; }
    if(12 + 8 * 12288 > gn as i64) { return 2; }
    let dg:[]u8 = nio_alloc(40);
    if(dg.len == 0) { return 2; }
    profile_motion(gbuf, 16, 0, 16, 0, 0, 7, op, dg);
    let have:i64 = t_get64(dg, 24);
    let dir:i64 = t_get64(dg, 16);
    let mag:i64 = t_get64(dg, 32);
    nio_free(dg);
    t_put64(ev, 0, have);
    if(have == 0) { return 2; }
    t_put64(ev, 24, mag);
    let agree:i32 = 0;
    if(dir == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    let strong:i32 = 0;
    if(hh == 0) {
        if(mag <= 1) { strong = 1; }
    } else {
        if(mag >= 5) { strong = 1; }
    }
    t_put64(ev, 16, strong as i64);
    let contra:i32 = 0;
    if(mag >= 5 && dir != hh) { contra = 1; }
    return self_result_of(1, agree, strong, contra);
}
// ---- pitchdisc: targeted harmonic-energy test of F's verdict on G ----
fn gcheck_pitch(gbuf:[]u8, gn:i32, fA:i64, fB:i64, hh:i64, sr:i64, op:[]u8, ev:[]u8) i32 {
    ev_init(ev);
    let cnt:i64 = t_get32(gbuf, 4);
    if(t_get32(gbuf, 0) != sr) { return 2; }
    if(cnt != 32000) { return 2; }
    if(8 + cnt * 2 > gn as i64) { return 2; }
    if(fA <= 0 || fB <= 0) { return 2; }
    let ga:i32 = 8;
    let gb:i32 = 8 + (14400 + 3200) * 2;
    let pkA:i64 = 0;
    let pkB:i64 = 0;
    let i:i32 = 0;
    while(i < 768) {
        let sA:i64 = t_geti16(gbuf, ga + i * 2);
        if(sA < 0) { sA = 0 - sA; }
        if(sA > pkA) { pkA = sA; }
        let sB:i64 = t_geti16(gbuf, gb + i * 2);
        if(sB < 0) { sB = 0 - sB; }
        if(sB > pkB) { pkB = sB; }
        i = i + 1;
    }
    op_add(op, 1536);
    let t1:i32 = 0;
    if(pkA >= 256 && pkB >= 256) { t1 = 1; }
    t_put64(ev, 0, t1 as i64);
    if(t1 == 0) { return 2; }
    let eA1:i64 = harm_energy(gbuf, ga, 768, sr, fA, 6, op);
    let eA2:i64 = harm_energy(gbuf, ga, 768, sr, fB, 6, op);
    let eB1:i64 = harm_energy(gbuf, gb, 768, sr, fB, 6, op);
    let eB2:i64 = harm_energy(gbuf, gb, 768, sr, fA, 6, op);
    // agree: F's verdict favored on both G windows (same logic as pitch_win)
    let agree:i32 = 0;
    if(hh == 0) {
        if(eA1 > 0 && eB1 > 0 && iabs(eA1 - eA2) * 10 <= eA1 && iabs(eB1 - eB2) * 10 <= eB1) { agree = 1; }
    } else {
        if(eA2 > 0 && eB2 > 0 && eA1 * 10 > eA2 * 11 && eB1 * 10 > eB2 * 11) { agree = 1; }
    }
    t_put64(ev, 8, agree as i64);
    // strong: energy ratios with real margin (percent units)
    let strong:i32 = 0;
    let mratio:i64 = 0;
    if(hh == 0) {
        if(eA1 > 0 && eB1 > 0) {
            let rA:i64 = iabs(eA1 - eA2) * 100 / eA1;
            let rB:i64 = iabs(eB1 - eB2) * 100 / eB1;
            mratio = rA;
            if(rB > rA) { mratio = rB; }
            if(mratio <= 5) { strong = 1; }
        }
    } else {
        if(eA2 > 0 && eB2 > 0) {
            let rA:i64 = eA1 * 100 / eA2;
            let rB:i64 = eB1 * 100 / eB2;
            mratio = rA;
            if(rB < rA) { mratio = rB; }
            if(mratio >= 125) { strong = 1; }
        }
    }
    t_put64(ev, 16, strong as i64);
    t_put64(ev, 24, mratio);
    // contra: some other verdict strongly favored on both G windows
    let contra:i32 = 0;
    let v:i64 = 0;
    while(v < 3) {
        if(v != hh) {
            let cv:i32 = 0;
            let sv:i32 = 0;
            if(v == 0) {
                if(eA1 > 0 && eB1 > 0 && iabs(eA1 - eA2) * 10 <= eA1 && iabs(eB1 - eB2) * 10 <= eB1) { cv = 1; }
                if(eA1 > 0 && eB1 > 0) {
                    let rA:i64 = iabs(eA1 - eA2) * 100 / eA1;
                    let rB:i64 = iabs(eB1 - eB2) * 100 / eB1;
                    let mx:i64 = rA;
                    if(rB > mx) { mx = rB; }
                    if(mx <= 5) { sv = 1; }
                }
            } else {
                if(eA2 > 0 && eB2 > 0 && eA1 * 10 > eA2 * 11 && eB1 * 10 > eB2 * 11) { cv = 1; }
                if(eA2 > 0 && eB2 > 0) {
                    let rA:i64 = eA1 * 100 / eA2;
                    let rB:i64 = eB1 * 100 / eB2;
                    let mn:i64 = rA;
                    if(rB < mn) { mn = rB; }
                    if(mn >= 125) { sv = 1; }
                }
            }
            if(cv == 1 && sv == 1) { contra = 1; }
        }
        v = v + 1;
    }
    return self_result_of(t1, agree, strong, contra);
}
// ---- timbredisc: spectral centroid of the clean 2 s G token ----
fn gcheck_timbre(gbuf:[]u8, gn:i32, f0:i64, hh:i64, sr:i64, op:[]u8, ev:[]u8) i32 {
    ev_init(ev);
    let cnt:i64 = t_get32(gbuf, 4);
    if(t_get32(gbuf, 0) != sr) { return 2; }
    if(cnt != 32000) { return 2; }
    if(8 + cnt * 2 > gn as i64) { return 2; }
    if(f0 <= 0) { return 2; }
    let r:i64 = spec_centroid_h2(gbuf, 8, 2048, sr, f0, op);
    let t1:i32 = 0;
    if(r > 0) { t1 = 1; }
    t_put64(ev, 0, t1 as i64);
    if(t1 == 0) { return 2; }
    t_put64(ev, 24, r);
    let cls:i64 = timbre_class(r);
    let agree:i32 = 0;
    if(cls == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    let mrg:i64 = timbre_margin(r, cls);
    let strong:i32 = 0;
    if(mrg >= 80) { strong = 1; }
    t_put64(ev, 16, strong as i64);
    let contra:i32 = 0;
    if(agree == 0 && strong == 1) { contra = 1; }
    return self_result_of(t1, agree, strong, contra);
}
// ---- R24A dual-span fixture splitting (main uses these) ----
fn r24_flen(buf:[]u8, n:i64) i64 {
    let tc:i64 = t_get32(buf, 4);
    if(tc == 0 || tc == 1 || tc == 2) {
        let w:i64 = t_get32(buf, 8);
        let h:i64 = t_get32(buf, 12);
        if(w <= 0 || h <= 0 || w > 1024 || h > 1024) { return -1; }
        return 8 + w * h * 3;
    }
    if(tc == 3 || tc == 4) {
        let cnt:i64 = t_get32(buf, 12);
        if(cnt <= 0 || cnt > 2000000) { return -1; }
        return 8 + cnt * 2;
    }
    if(tc == 5) {
        let nf:i64 = t_get32(buf, 8);
        let w:i64 = t_get32(buf, 12);
        let h:i64 = t_get32(buf, 16);
        if(nf <= 0 || nf > 64 || w <= 0 || h <= 0 || w > 512 || h > 512) { return -1; }
        return 12 + nf * w * h * 3;
    }
    return -1;
}
fn r24_tcode(task:[]u8) i64 {
    if(_zag_strcmp(task, "colordisc") == 1) { return 0; }
    if(_zag_strcmp(task, "colorconst") == 1) { return 1; }
    if(_zag_strcmp(task, "shapetrans") == 1) { return 2; }
    if(_zag_strcmp(task, "pitchdisc") == 1) { return 3; }
    if(_zag_strcmp(task, "timbredisc") == 1) { return 4; }
    if(_zag_strcmp(task, "motiondir") == 1) { return 5; }
    return -1;
}

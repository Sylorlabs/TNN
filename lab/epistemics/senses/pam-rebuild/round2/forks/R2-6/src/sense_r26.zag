// sense_r26.zag — PAM round-2 fork R2-6: DISJOINT-CORROBORATION PASS.
//
// A percept is a pair of programs constructed on two DISJOINT evidence
// spans. PASS requires the two programs to be the SAME NORMALIZED PROGRAM
// STRUCTURE: (a) tests sorted by canonical name, (b) evidence-span literals
// replaced by the span's role tag (formation/holdout), (c) numeric
// thresholds normalized to the frozen per-task EPS values. Structural
// disagreement yields UNRESOLVED/withhold, never FAIL.
//
// Frozen spans (contiguous, disjoint; see DESIGN_R26.md):
//   colordisc/colorconst (128x64): rows [0,32) / [32,64)
//   shapetrans (96x96):            rows [0,48) / [48,96)
//   pitchdisc:                     first/second half of each tone
//   timbredisc (0.8s):             samples [0,6400) / [6400,12800)
//   motiondir (8 frames):          frames [0,4) / [4,8)
//
// CLI: sense_r26 <task> <fixture-path>   (same fixture formats as INTERFACE.md)
// stdout: approach=R26, task=, judgment=, confidence=0..1000, ops=, prog=,
//         pred=0|1, cost=, measure=, program=, program2=, norm0=, norm1=,
//         normcmp=EQUAL|DIFFER  (one key=value per line)
// Exit 0 on success; approach=R26 + task= + error=<reason>, exit 1 on failure.
//
// Pure Zag, integer math only, zero RNG, fully deterministic: 3 runs of the
// same binary+fixture are byte-identical.
//
// znc bug workarounds honored (INTERFACE.md / AGENTS.md): no argc gate, no
// `as []i32` casts ([]u8 arenas + LE accessors), `_zag_strcmp`==1 on
// equality, no slice > 2^25 indexed, NUL-terminated paths via z_cstr,
// `_zag_raw_syscall` exactly 7 args, shallow else-nesting, no `};`.

@import("R33_NATIVE_IO_V1.zag")
@import("lut.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}

// ---------------- ops counter (8-byte arena) -----------------------------
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- integer math -------------------------------------------
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
// integer power, base >= 0, small exponents
fn ipow(b:i64, e:i32) i64 {
    let r:i64 = 1;
    let i:i32 = 0;
    while(i < e) { r = r * b; i = i + 1; }
    return r;
}

// ---------------- file IO -------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// ---------------- stdout line builder ------------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn ob_pair(ob:[]u8, pos:i32, name:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, name);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, _zag_i64_to_str(v));
    pos = ob_add(ob, pos, ";");
    return pos;
}
fn fail(task:[]u8, reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "R26");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "error", reason);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// sin(p) * 1024, p = turn in [0, 2^32). Table-free fixed-point Taylor with
// quadrant folding.
fn ng_sin1024(p:i64) i64 {
    let q:i64 = (p >> 30) & 3;
    let fr:i64 = p & 1073741823;
    let x:i64 = (fr * 1608) >> 30;
    let xx:i64 = x;
    if(q == 1 || q == 3) { xx = 1608 - x; }
    let x2:i64 = xx * xx;
    let term:i64 = xx;
    let sum:i64 = xx;
    let k:i64 = 1;
    while(k <= 7) {
        term = 0 - term * x2 / ((2 * k) * (2 * k + 1) * 1048576);
        sum = sum + term;
        k = k + 1;
    }
    if(q >= 2) { return 0 - sum; }
    return sum;
}
// cos(p)*1024 via the sin table.
fn ng_cos1024(p:i64) i64 {
    return ng_sin1024((p + 1073741824) & 4294967295);
}
// atan2(y,x) in millidegrees [0,360000), via binary search on the sin table.
// 22 iterations -> resolution < 0.0001 degree.
fn atan2_mdeg(y:i64, x:i64) i64 {
    if(x == 0 && y == 0) { return 0; }
    let ay:i64 = iabs(y);
    let ax:i64 = iabs(x);
    let lo:i64 = 0;
    let hi:i64 = 1073741824;
    let it:i32 = 0;
    while(it < 22) {
        let mid:i64 = (lo + hi) / 2;
        let s:i64 = ng_sin1024(mid);
        let c:i64 = ng_cos1024(mid);
        if(ay * c > ax * s) { lo = mid; } else { hi = mid; }
        it = it + 1;
    }
    let mdeg:i64 = lo * 360000 / 4294967296;
    if(x >= 0 && y >= 0) { return mdeg; }
    if(x < 0 && y >= 0) { return 180000 - mdeg; }
    if(x < 0 && y < 0) { return 180000 + mdeg; }
    return 360000 - mdeg;
}

// ================= audio helpers =========================================
// Peak amplitude (for the deadband).
fn pcm_peak(buf:[]u8, off:i32, cnt:i32) i64 {
    let p:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let s:i64 = iabs(t_geti16(buf, off + i * 2));
        if(s > p) { p = s; }
        i = i + 1;
    }
    return p;
}
// Harmonic energy at harmonics of f0m (milli-Hz) over w samples at off.
// op counts 2 element-visits per (sample, harmonic).
fn harm_energy(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, nhmax:i32, op:[]u8) i64 {
    if(f0m <= 0 || w < 64) { return 0; }
    let pinc1:i64 = f0m * 4294967296 / (1000 * sr);
    if(pinc1 <= 0) { return 0; }
    let tot:i64 = 0;
    let h:i64 = 1;
    while(h <= nhmax as i64) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let pinc:i64 = h * pinc1;
        let re:i64 = 0;
        let im:i64 = 0;
        let i:i32 = 0;
        while(i < w) {
            let s:i64 = t_geti16(buf, off + i * 2);
            let p:i64 = ((i as i64) * pinc) & 4294967295;
            re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
            im = im + s * ng_sin1024(p) / 1024;
            i = i + 1;
        }
        op_add(op, (2 * w) as i64);
        tot = tot + (re * re + im * im) / 1048576;
        h = h + 1;
    }
    return tot;
}

// H2 robust fundamental (milli-Hz): same structure as Approach A but on a
// shorter window (wcap 1024) and a narrower fine grid (+-2% at 0.15% steps,
// 27 points) — the sparse-measurement analog. Autocorrelation (coarse) +
// harmonic-energy maximization (fine) + parabolic interpolation +
// matched-coverage octave guard. Returns 0 on failure.
fn f0_h2(buf:[]u8, off:i32, cnt:i32, sr:i64, op:[]u8) i64 {
    let w:i32 = cnt;
    if(w > 1024) { w = 1024; }
    if(w < 512) { return 0; }
    let peak:i64 = pcm_peak(buf, off, w);
    if(peak < 256) { return 0; }
    let ms:i64 = 0;
    let i:i32 = 0;
    while(i < w) { ms = ms + t_geti16(buf, off + i * 2); i = i + 1; }
    let mean:i64 = ms / (w as i64);
    op_add(op, (2 * w) as i64);
    let lmin:i32 = (sr / 2000) as i32;
    if(lmin < 2) { lmin = 2; }
    let lmax:i32 = (sr / 50) as i32;
    if(lmax > w / 3) { lmax = w / 3; }
    if(lmax < lmin + 2) { return 0; }
    let nl:i32 = lmax - lmin + 3;
    let ra:[]u8 = nio_alloc((nl * 8) as i32);
    if(ra.len == 0) { return 0; }
    let l:i32 = lmin - 1;
    while(l <= lmax + 1) {
        let acc:i64 = 0;
        let nn:i32 = w - l;
        let n:i32 = 0;
        while(n < nn) {
            let a:i64 = t_geti16(buf, off + n * 2) - mean;
            let b:i64 = t_geti16(buf, off + (n + l) * 2) - mean;
            acc = acc + a * b;
            n = n + 1;
        }
        op_add(op, nn as i64);
        t_put64(ra, (l - (lmin - 1)) * 8, acc);
        l = l + 1;
    }
    let gmax:i64 = 0;
    l = lmin;
    while(l <= lmax) {
        let r:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
        if(r > gmax) { gmax = r; }
        l = l + 1;
    }
    let lstar:i32 = -1;
    let r0:i64 = 0;
    let rm:i64 = 0;
    let rp:i64 = 0;
    if(gmax > 0) {
        l = lmin;
        while(l <= lmax) {
            let q0:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
            let qm:i64 = t_get64(ra, (l - 1 - (lmin - 1)) * 8);
            let qp:i64 = t_get64(ra, (l + 1 - (lmin - 1)) * 8);
            if(q0 >= qm && q0 >= qp && q0 * 2 >= gmax) {
                lstar = l;
                r0 = q0;
                rm = qm;
                rp = qp;
                break;
            }
            l = l + 1;
        }
    }
    nio_free(ra);
    if(lstar < 0) { return 0; }
    let den:i64 = 2 * (rm - 2 * r0 + rp);
    let poff:i64 = 0;
    if(den != 0) { poff = (rm - rp) * 1024 / den; }
    if(poff < -512) { poff = -512; }
    if(poff > 512) { poff = 512; }
    let period_1024:i64 = (lstar as i64) * 1024 + poff;
    if(period_1024 <= 0) { return 0; }
    let f0c:i64 = sr * 1000 * 1024 / period_1024;
    // fine grid: f0c*(1 + k*0.0015), k in -13..13 (27 points)
    let best_k:i32 = -13;
    let best_s:i64 = -1;
    let k:i32 = -13;
    while(k <= 13) {
        let f0k:i64 = f0c + f0c * (k as i64) * 15 / 10000;
        let s:i64 = harm_energy(buf, off, w, sr, f0k, 6, op);
        if(s > best_s) { best_s = s; best_k = k; }
        k = k + 1;
    }
    if(best_s <= 0) { return 0; }
    let sm:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k - 1) as i64) * 15 / 10000, 6, op);
    let sp:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k + 1) as i64) * 15 / 10000, 6, op);
    let den2:i64 = 2 * (sm - 2 * best_s + sp);
    let koff:i64 = 0;
    if(den2 != 0) { koff = (sm - sp) * 1024 / den2; }
    if(koff < -512) { koff = -512; }
    if(koff > 512) { koff = 512; }
    let f0m:i64 = f0c + f0c * ((best_k as i64) * 1024 + koff) * 15 / (1024 * 10000);
    if(f0m <= 0) { return 0; }
    // octave guard with matched harmonic coverage (same as Approach A)
    let e0:i64 = harm_energy(buf, off, w, sr, f0m, 8, op);
    let ehalf:i64 = harm_energy(buf, off, w, sr, f0m / 2, 16, op);
    let edbl:i64 = harm_energy(buf, off, w, sr, f0m * 2, 4, op);
    if(ehalf > e0 + e0 / 20) { return f0m / 2; }
    if(edbl > e0 + e0 / 20) { return f0m * 2; }
    return f0m;
}

// R2-6 lean fundamental (milli-Hz) for per-span estimation. Same structure
// as f0_h2 but cheaper: narrower lag range (f0 in [167,1000] Hz covers the
// frozen fixture range [220,660] Hz), w cap 768, fine grid +-1.8% at 0.3%
// steps (13 points) + parabolic interpolation + matched-coverage octave
// guard. Returns 0 on failure.
fn f0_r26(buf:[]u8, off:i32, cnt:i32, sr:i64, op:[]u8) i64 {
    let w:i32 = cnt;
    if(w > 768) { w = 768; }
    if(w < 512) { return 0; }
    let peak:i64 = pcm_peak(buf, off, w);
    if(peak < 256) { return 0; }
    let ms:i64 = 0;
    let i:i32 = 0;
    while(i < w) { ms = ms + t_geti16(buf, off + i * 2); i = i + 1; }
    let mean:i64 = ms / (w as i64);
    op_add(op, (2 * w) as i64);
    let lmin:i32 = (sr / 1000) as i32;
    if(lmin < 2) { lmin = 2; }
    let lmax:i32 = (sr / 167) as i32;
    if(lmax > w / 3) { lmax = w / 3; }
    if(lmax < lmin + 2) { return 0; }
    let nl:i32 = lmax - lmin + 3;
    let ra:[]u8 = nio_alloc((nl * 8) as i32);
    if(ra.len == 0) { return 0; }
    let l:i32 = lmin - 1;
    while(l <= lmax + 1) {
        let acc:i64 = 0;
        let nn:i32 = w - l;
        let n:i32 = 0;
        while(n < nn) {
            let a:i64 = t_geti16(buf, off + n * 2) - mean;
            let b:i64 = t_geti16(buf, off + (n + l) * 2) - mean;
            acc = acc + a * b;
            n = n + 1;
        }
        op_add(op, nn as i64);
        t_put64(ra, (l - (lmin - 1)) * 8, acc);
        l = l + 1;
    }
    let gmax:i64 = 0;
    l = lmin;
    while(l <= lmax) {
        let r:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
        if(r > gmax) { gmax = r; }
        l = l + 1;
    }
    let lstar:i32 = -1;
    let r0:i64 = 0;
    let rm:i64 = 0;
    let rp:i64 = 0;
    if(gmax > 0) {
        l = lmin;
        while(l <= lmax) {
            let q0:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
            let qm:i64 = t_get64(ra, (l - 1 - (lmin - 1)) * 8);
            let qp:i64 = t_get64(ra, (l + 1 - (lmin - 1)) * 8);
            if(q0 >= qm && q0 >= qp && q0 * 2 >= gmax) {
                lstar = l;
                r0 = q0;
                rm = qm;
                rp = qp;
                break;
            }
            l = l + 1;
        }
    }
    nio_free(ra);
    if(lstar < 0) { return 0; }
    let den:i64 = 2 * (rm - 2 * r0 + rp);
    let poff:i64 = 0;
    if(den != 0) { poff = (rm - rp) * 1024 / den; }
    if(poff < -512) { poff = -512; }
    if(poff > 512) { poff = 512; }
    let period_1024:i64 = (lstar as i64) * 1024 + poff;
    if(period_1024 <= 0) { return 0; }
    let f0c:i64 = sr * 1000 * 1024 / period_1024;
    // fine grid: f0c*(1 + k*0.003), k in -6..6 (13 points)
    let best_k:i32 = -6;
    let best_s:i64 = -1;
    let k:i32 = -6;
    while(k <= 6) {
        let f0k:i64 = f0c + f0c * (k as i64) * 3 / 1000;
        let s:i64 = harm_energy(buf, off, w, sr, f0k, 6, op);
        if(s > best_s) { best_s = s; best_k = k; }
        k = k + 1;
    }
    if(best_s <= 0) { return 0; }
    let sm:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k - 1) as i64) * 3 / 1000, 6, op);
    let sp:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k + 1) as i64) * 3 / 1000, 6, op);
    let den2:i64 = 2 * (sm - 2 * best_s + sp);
    let koff:i64 = 0;
    if(den2 != 0) { koff = (sm - sp) * 1024 / den2; }
    if(koff < -512) { koff = -512; }
    if(koff > 512) { koff = 512; }
    let f0m:i64 = f0c + f0c * ((best_k as i64) * 1024 + koff) * 3 / (1024 * 1000);
    if(f0m <= 0) { return 0; }
    let e0:i64 = harm_energy(buf, off, w, sr, f0m, 8, op);
    let ehalf:i64 = harm_energy(buf, off, w, sr, f0m / 2, 16, op);
    let edbl:i64 = harm_energy(buf, off, w, sr, f0m * 2, 4, op);
    if(ehalf > e0 + e0 / 20) { return f0m / 2; }
    if(edbl > e0 + e0 / 20) { return f0m * 2; }
    return f0m;
}

// ================= integer colorimetry ===================================
// sRGB -> CIELAB -> CIEDE2000, all integer fixed-point.
// Lab in milli-units; de2000_m returns milli-dE.

// integer cbrt: returns round(1e6 * cbrt(v/1e6)), v in 1e6 scale, v >= 0
fn cbrt_1e6(v:i64) i64 {
    if(v <= 0) { return 0; }
    let x:i64 = 1000000;
    let it:i32 = 0;
    while(it < 14) {
        let x2:i64 = x * x / 1000000;
        if(x2 <= 0) { x2 = 1; }
        x = (2 * x + v * 1000000 / x2) / 3;
        it = it + 1;
    }
    return x;
}
fn lab_f(t_1e6:i64) i64 {
    if(t_1e6 > 8856) { return cbrt_1e6(t_1e6); }
    return (7787 * t_1e6) / 1000000 + 137931;
}
// out: L,a,b milli at out[0], out[8], out[16]
fn rgb_to_lab_m(r:i64, g:i64, b:i64, lut:[]u8, out:[]u8) void {
    let rl:i64 = t_get64(lut, (r as i32) * 8);
    let gl:i64 = t_get64(lut, (g as i32) * 8);
    let bl:i64 = t_get64(lut, (b as i32) * 8);
    let x:i64 = (412456 * rl + 357576 * gl + 180437 * bl + 500000) / 1000000;
    let y:i64 = (212673 * rl + 715152 * gl + 72175 * bl + 500000) / 1000000;
    let z:i64 = (19334 * rl + 119192 * gl + 950304 * bl + 500000) / 1000000;
    let fx:i64 = lab_f(x * 1000000 / 950470);
    let fy:i64 = lab_f(y * 1000000 / 1000000);
    let fz:i64 = lab_f(z * 1000000 / 1088830);
    t_put64(out, 0, (116 * fy - 16000000) / 1000);
    t_put64(out, 8, 500 * (fx - fy) / 1000);
    t_put64(out, 16, 200 * (fy - fz) / 1000);
}
// exp(-x) in 1e6, x in 1e6, x >= 0
fn exp_neg_1e6(x:i64) i64 {
    if(x <= 0) { return 1000000; }
    let xk:i64 = x >> 6;
    let term:i64 = 1000000;
    let sum:i64 = 1000000;
    let n:i64 = 1;
    while(n <= 11) {
        term = 0 - term * xk / (n * 1000000);
        sum = sum + term;
        n = n + 1;
    }
    let i:i32 = 0;
    while(i < 6) { sum = sum * sum / 1000000; i = i + 1; }
    return sum;
}
// sqrt(v^7/(v^7+25^7)) in 1e6, v in Lab units (rounded), v >= 0
fn c7_frac_1e6(vu:i64) i64 {
    if(vu <= 0) { return 0; }
    if(vu > 250) { return 1000000; }
    let num:i64 = ipow(vu, 7);
    let den:i64 = num + 6103515625;
    let q:i64 = den / 1000000;
    if(q <= 0) { q = 1; }
    return num / q;
}
// cos of millidegrees, *1024
fn cos_mdeg(mdeg:i64) i64 {
    return ng_cos1024((mdeg * 4294967296 / 360000) & 4294967295);
}
// CIEDE2000, Lab inputs in milli-units, returns milli-dE.
fn de2000_m(l1:i64, a1:i64, b1:i64, l2:i64, a2:i64, b2:i64) i64 {
    let c1:i64 = isqrt(a1 * a1 + b1 * b1);
    let c2:i64 = isqrt(a2 * a2 + b2 * b2);
    let cb:i64 = (c1 + c2) / 2;
    let g:i64 = 500000 - isqrt(c7_frac_1e6(cb / 1000)) * 1000 / 2;
    let ap1:i64 = a1 + a1 * g / 1000000;
    let ap2:i64 = a2 + a2 * g / 1000000;
    let cp1:i64 = isqrt(ap1 * ap1 + b1 * b1);
    let cp2:i64 = isqrt(ap2 * ap2 + b2 * b2);
    let hp1:i64 = atan2_mdeg(b1, ap1);
    let hp2:i64 = atan2_mdeg(b2, ap2);
    let dl:i64 = l2 - l1;
    let dc:i64 = cp2 - cp1;
    let dh:i64 = 0;
    let dhv:i64 = 0;
    if(cp1 * cp2 != 0) {
        dh = hp2 - hp1;
        if(dh > 180000) { dh = dh - 360000; }
        if(dh < -180000) { dh = dh + 360000; }
        let sh:i64 = ng_sin1024((dh * 4294967296 / 720000) & 4294967295);
        dhv = 2 * isqrt(cp1 * cp2) * sh / 1024;
    }
    let lbp:i64 = (l1 + l2) / 2;
    let cbp:i64 = (cp1 + cp2) / 2;
    let hbp:i64 = hp1 + hp2;
    if(cp1 * cp2 != 0) {
        let ad:i64 = iabs(hp1 - hp2);
        if(ad <= 180000) { hbp = (hp1 + hp2) / 2; }
        else {
            if(hp1 + hp2 < 360000) { hbp = (hp1 + hp2 + 360000) / 2; }
            else { hbp = (hp1 + hp2 - 360000) / 2; }
        }
    }
    let t_1e6:i64 = 1000000 - 170000 * cos_mdeg(hbp - 30000) / 1024
        + 240000 * cos_mdeg(2 * hbp) / 1024
        + 320000 * cos_mdeg(3 * hbp + 6000) / 1024
        - 200000 * cos_mdeg(4 * hbp - 63000) / 1024;
    let vd:i64 = (hbp - 275000) / 25;
    let dro_1e6:i64 = 30 * exp_neg_1e6(vd * vd / 1000);
    let rc_1e6:i64 = 2 * isqrt(c7_frac_1e6(cbp / 1000)) * 1000;
    let du:i64 = (lbp - 50000) / 1000;
    let sl_1e6:i64 = 1000000 + 15000 * du * du / imax(isqrt(20 + du * du), 1);
    let cbpu:i64 = cbp / 1000;
    let sc_1e6:i64 = 1000000 + 45000 * cbpu;
    let sh_1e6:i64 = 1000000 + 15000 * cbpu * t_1e6 / 1000000;
    let tl:i64 = dl * 1000000 / sl_1e6;
    let tc:i64 = dc * 1000000 / sc_1e6;
    let th:i64 = dhv * 1000000 / sh_1e6;
    let rt_1e6:i64 = 0 - ng_sin1024((dro_1e6 * 2 * 4294967296 / 360000000) & 4294967295) * rc_1e6 / 1024;
    let cross:i64 = rt_1e6 * tc / 1000000000 * th / 1000000000;
    let de2:i64 = tl * tl + tc * tc + th * th + cross;
    if(de2 < 0) { de2 = 0; }
    return isqrt(de2);
}

// ================= shared test resolution =================================
// result codes: 0=PASS, 1=FAIL, 2=UNRESOLVED
fn resolve(t1:i32, t2d:i32, t2c:i32, t3:i32, p1:i32) i32 {
    if(t1 == 0) { return 2; }
    if(t2d == 0) { return 1; }
    if(t2c == 0) { return 2; }
    if(t3 == 0) { return 2; }
    if(p1 == 0) { return 2; }
    return 0;
}
fn res_str(r:i32) []u8 {
    if(r == 0) { return "PASS"; }
    if(r == 1) { return "FAIL"; }
    return "UNRESOLVED";
}
// confidence 0..1000 from margin m (same units as the task's measure):
// 1000*m/(m+k), k = task margin scale.
fn conf_of(m:i64, k:i64) i64 {
    if(m < 0) { m = 0 - m; }
    return 1000 * m / (m + k);
}

// ================= R2-6 normalized-program machinery =====================
// A normalized program is the canonical test battery with (a) tests sorted
// by canonical name, (b) evidence-span literals replaced by the span's role
// tag (formation = the program's own span, holdout = the disjoint span),
// (c) numeric thresholds replaced by the frozen per-task EPS values.
// Format:
//   R26/<task>|t.calibration=<o>:<e>@formation;t.consistency=<o>:<e>@formation;
//   t.margin=<o>:<e>@formation;t.pred=<o>:<e>@holdout;t.verdict=<j>:0@formation;
// PASS requires byte-identical normalized programs from the two spans.
fn norm_prog(ob:[]u8, pos:i32, task:[]u8, c_cal:i32, c_con:i32, c_mar:i32, c_pred:i32, j:i64, e_cal:i64, e_con:i64, e_mar:i64, e_pred:i64) i32 {
    pos = ob_add(ob, pos, "R26/");
    pos = ob_add(ob, pos, task);
    pos = ob_add(ob, pos, "|t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c_cal as i64));
    pos = ob_add(ob, pos, ":");
    pos = ob_add(ob, pos, _zag_i64_to_str(e_cal));
    pos = ob_add(ob, pos, "@formation;t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c_con as i64));
    pos = ob_add(ob, pos, ":");
    pos = ob_add(ob, pos, _zag_i64_to_str(e_con));
    pos = ob_add(ob, pos, "@formation;t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c_mar as i64));
    pos = ob_add(ob, pos, ":");
    pos = ob_add(ob, pos, _zag_i64_to_str(e_mar));
    pos = ob_add(ob, pos, "@formation;t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c_pred as i64));
    pos = ob_add(ob, pos, ":");
    pos = ob_add(ob, pos, _zag_i64_to_str(e_pred));
    pos = ob_add(ob, pos, "@holdout;t.verdict=");
    pos = ob_add(ob, pos, _zag_i64_to_str(j));
    pos = ob_add(ob, pos, ":0@formation;");
    return pos;
}
fn buf_eq(a:[]u8, alen:i32, b:[]u8, blen:i32) i32 {
    if(alen != blen) { return 0; }
    let i:i32 = 0;
    while(i < alen) {
        if(a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// ================= colordisc =============================================
// Sparse-span color-difference program. Spans: rows%16==0 (O1),
// rows%16==8 (O2), rows%16==4 (held-out PRED). dE = integer CIEDE2000.
// ================= R2-6 task functions =====================================
// Two disjoint evidence spans per task; PASS requires the two normalized
// programs to be byte-identical. Structural disagreement -> UNRESOLVED.

// ---- colordisc ----
// Spans: rows [0,32) / [32,64). Sub-measurements: even/odd rows.
// out: de_full@0, de_a@8, de_b@16 (milli-dE).
fn colordisc_span(buf:[]u8, y0:i32, y1:i32, op:[]u8, lut:[]u8, out:[]u8) void {
    let acc:[]u8 = nio_alloc(3 * 2 * 4 * 8);
    let s:i32 = 0;
    while(s < 24) { t_put64(acc, s * 8, 0); s = s + 1; }
    let y:i32 = y0;
    let visits:i64 = 0;
    while(y < y1) {
        let x:i32 = 0;
        while(x < 128) {
            let h:i32 = 0;
            if(x >= 64) { h = 1; }
            let o:i32 = 8 + (y * 128 + x) * 3;
            let r:i64 = buf[o] as i64;
            let g:i64 = buf[o + 1] as i64;
            let b:i64 = buf[o + 2] as i64;
            let gi:i32 = 1;
            if((y & 1) == 1) { gi = 2; }
            let g2:i32 = 0;
            while(g2 < 2) {
                let gg:i32 = 0;
                if(g2 == 1) { gg = gi; }
                let base:i32 = (gg * 2 + h) * 4;
                t_put64(acc, (base + 0) * 8, t_get64(acc, (base + 0) * 8) + r);
                t_put64(acc, (base + 1) * 8, t_get64(acc, (base + 1) * 8) + g);
                t_put64(acc, (base + 2) * 8, t_get64(acc, (base + 2) * 8) + b);
                t_put64(acc, (base + 3) * 8, t_get64(acc, (base + 3) * 8) + 1);
                g2 = g2 + 1;
            }
            x = x + 1;
            visits = visits + 1;
        }
        y = y + 1;
    }
    op_add(op, visits);
    let lab:[]u8 = nio_alloc(48);
    let gi2:i32 = 0;
    while(gi2 < 3) {
        let lr:i64 = 0;
        let lg:i64 = 0;
        let lb:i64 = 0;
        let h2:i32 = 0;
        while(h2 < 2) {
            let base:i32 = (gi2 * 2 + h2) * 4;
            let cnt:i64 = t_get64(acc, (base + 3) * 8);
            let mr:i64 = 0;
            let mg:i64 = 0;
            let mb:i64 = 0;
            if(cnt > 0) {
                mr = t_get64(acc, (base + 0) * 8) / cnt;
                mg = t_get64(acc, (base + 1) * 8) / cnt;
                mb = t_get64(acc, (base + 2) * 8) / cnt;
            }
            rgb_to_lab_m(mr, mg, mb, lut, lab);
            if(h2 == 0) {
                lr = t_get64(lab, 0); lg = t_get64(lab, 8); lb = t_get64(lab, 16);
            } else {
                t_put64(out, gi2 * 8, de2000_m(lr, lg, lb, t_get64(lab, 0), t_get64(lab, 8), t_get64(lab, 16)));
            }
            h2 = h2 + 1;
        }
        op_add(op, 8);
        gi2 = gi2 + 1;
    }
    nio_free(lab);
    nio_free(acc);
}
// ---- recovered H2 helpers + R2-6 shape/pitch helpers ----
fn dir_of(dx:i64, dy:i64) i64 {
    let ax:i64 = iabs(dx);
    let ay:i64 = iabs(dy);
    let mag2:i64 = dx * dx + dy * dy;
    if(mag2 < 9) { return 0; }
    if(ax > 2 * ay) {
        if(dx > 0) { return 3; }
        return 7;
    }
    if(ay > 2 * ax) {
        if(dy > 0) { return 5; }
        return 1;
    }
    if(dx > 0 && dy < 0) { return 2; }
    if(dx > 0 && dy > 0) { return 4; }
    if(dx < 0 && dy > 0) { return 6; }
    return 8;
}
fn dir_name(d:i64) []u8 {
    if(d == 0) { return "STILL"; }
    if(d == 1) { return "N"; }
    if(d == 2) { return "NE"; }
    if(d == 3) { return "E"; }
    if(d == 4) { return "SE"; }
    if(d == 5) { return "S"; }
    if(d == 6) { return "SW"; }
    if(d == 7) { return "W"; }
    return "NW";
}
// dout: dx@0, dy@8, dir@16, have@24, mag@32
// 1D projection profile motion: col profile (sum over sparse rows) gives
// dx via SSD shift; row profile (sum over sparse cols) gives dy.
// Frames f1->f2; row_step/row_off select the row subset for the col
// profile, col_step/col_off the col subset for the row profile.
fn profile_motion(buf:[]u8, row_step:i32, row_off:i32, col_step:i32, col_off:i32, f1:i32, f2:i32, op:[]u8, dout:[]u8) void {
    let fsz:i64 = 12288;
    let c0:[]u8 = nio_alloc(512);
    let c1:[]u8 = nio_alloc(512);
    let r0:[]u8 = nio_alloc(512);
    let r1:[]u8 = nio_alloc(512);
    let i:i32 = 0;
    while(i < 64) {
        t_put64(c0, i * 8, 0);
        t_put64(c1, i * 8, 0);
        t_put64(r0, i * 8, 0);
        t_put64(r1, i * 8, 0);
        i = i + 1;
    }
    // col profiles: for each x, sum intensity over sparse rows
    let f:i32 = 0;
    while(f < 2) {
        let fr:i32 = f1;
        if(f == 1) { fr = f2; }
        let cp:[]u8 = c0;
        let rp:[]u8 = r0;
        if(f == 1) { cp = c1; rp = r1; }
        let y:i32 = 0;
        while(y < 64) {
            if(y % row_step == row_off) {
                let x:i32 = 0;
                while(x < 64) {
                    let o:i32 = (12 + (fr as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let inten:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    t_put64(cp, x * 8, t_get64(cp, x * 8) + inten);
                    x = x + 1;
                    op_add(op, 1);
                }
            }
            y = y + 1;
        }
        // row profiles: for each y, sum intensity over sparse cols
        y = 0;
        while(y < 64) {
            let x:i32 = 0;
            while(x < 64) {
                if(x % col_step == col_off) {
                    let o:i32 = (12 + (fr as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let inten:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    t_put64(rp, y * 8, t_get64(rp, y * 8) + inten);
                    op_add(op, 1);
                }
                x = x + 1;
            }
            y = y + 1;
        }
        f = f + 1;
    }
    // SSD shift for dx (col profiles)
    let best_dx:i64 = 0;
    let best_e:i64 = 9223372036854775807;
    let s:i32 = -8;
    while(s <= 8) {
        let e:i64 = 0;
        let x:i32 = 8;
        while(x < 56) {
            let x2:i32 = x + s;
            if(x2 >= 0 && x2 < 64) {
                let d:i64 = t_get64(c0, x * 8) - t_get64(c1, x2 * 8);
                e = e + d * d;
            }
            x = x + 1;
            op_add(op, 1);
        }
        if(e < best_e) { best_e = e; best_dx = s as i64; }
        s = s + 1;
    }
    // SSD shift for dy (row profiles)
    let best_dy:i64 = 0;
    best_e = 9223372036854775807;
    s = -8;
    while(s <= 8) {
        let e:i64 = 0;
        let y:i32 = 8;
        while(y < 56) {
            let y2:i32 = y + s;
            if(y2 >= 0 && y2 < 64) {
                let d:i64 = t_get64(r0, y * 8) - t_get64(r1, y2 * 8);
                e = e + d * d;
            }
            y = y + 1;
            op_add(op, 1);
        }
        if(e < best_e) { best_e = e; best_dy = s as i64; }
        s = s + 1;
    }
    nio_free(c0);
    nio_free(c1);
    nio_free(r0);
    nio_free(r1);
    t_put64(dout, 0, best_dx);
    t_put64(dout, 8, best_dy);
    t_put64(dout, 16, dir_of(best_dx, best_dy));
    t_put64(dout, 24, 1);
    t_put64(dout, 32, isqrt(best_dx * best_dx + best_dy * best_dy));
}

fn pitch_name(c:i64) []u8 {
    if(c == 0) { return "SAME"; }
    if(c == 1) { return "HIGHER"; }
    return "LOWER";
}
// one window check: tone's own f0 vs the other tone's f0. Returns 1 if the
// evidence favors H.
fn pitch_win(buf:[]u8, woff:i32, sr:i64, fT:i64, fO:i64, hh:i64, op:[]u8) i32 {
    let e_own:i64 = harm_energy(buf, woff, 768, sr, fT, 6, op);
    let e_oth:i64 = harm_energy(buf, woff, 768, sr, fO, 6, op);
    if(hh != 0) {
        if(e_own * 10 > e_oth * 11) { return 1; }
        return 0;
    }
    if(iabs(e_own - e_oth) * 10 <= e_own) { return 1; }
    return 0;
}
fn spec_centroid_h2(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, op:[]u8) i64 {
    if(f0m <= 0) { return -1; }
    let se:i64 = 0;
    let she:i64 = 0;
    let h:i64 = 1;
    while(h <= 8) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let e:i64 = harm_energy(buf, off, w, sr, h * f0m, 1, op);
        se = se + e;
        she = she + e * h;
        h = h + 1;
    }
    if(se <= 0) { return -1; }
    return 1000 * she / se;
}
fn timbre_class(r:i64) i64 {
    if(r < 1075) { return 0; }
    if(r < 1400) { return 1; }
    if(r < 3000) { return 2; }
    return 3;
}
fn timbre_margin(r:i64, cls:i64) i64 {
    if(cls == 0) { return 1075 - r; }
    if(cls == 1) {
        let a:i64 = r - 1075;
        let b:i64 = 1400 - r;
        if(a < b) { return a; }
        return b;
    }
    if(cls == 2) {
        let a:i64 = r - 1400;
        let b:i64 = 3000 - r;
        if(a < b) { return a; }
        return b;
    }
    return r - 3000;
}
fn shape_name(c:i64) []u8 {
    if(c == 0) { return "CIRCLE"; }
    if(c == 1) { return "SQUARE"; }
    return "TRIANGLE";
}
// R2-6 half-frame shape prototypes. Calibrated on the R2N shapetrans normal
// set (frozen; see DESIGN_R26.md): mean grid-ratio per half per class.
fn shape_proto(half:i64, cls:i64) i64 {
    if(half == 0) {
        if(cls == 0) { return 892; }
        if(cls == 1) { return 837; }
        return 646;
    }
    if(cls == 0) { return 940; }
    if(cls == 1) { return 755; }
    return 671;
}
fn shape_class_half(r:i64, half:i64) i64 {
    let d0:i64 = iabs(r - shape_proto(half, 0));
    let d1:i64 = iabs(r - shape_proto(half, 1));
    let d2:i64 = iabs(r - shape_proto(half, 2));
    if(d0 <= d1 && d0 <= d2) { return 0; }
    if(d1 <= d2) { return 1; }
    return 2;
}
fn shape_margin_half(r:i64, cls:i64, half:i64) i64 {
    let d0:i64 = iabs(r - shape_proto(half, 0));
    let d1:i64 = iabs(r - shape_proto(half, 1));
    let d2:i64 = iabs(r - shape_proto(half, 2));
    if(cls == 0) {
        if(d1 < d2) { return d1 - d0; }
        return d2 - d0;
    }
    if(cls == 1) {
        if(d0 < d2) { return d0 - d1; }
        return d2 - d1;
    }
    if(d0 < d1) { return d0 - d2; }
    return d1 - d2;
}
// shape_half: grid-ratio shape measurement restricted to rows [y0, y1).
// Same algorithm as shape_measure (two diagonal grids rem 0 / rem 6,
// centroid, max-radius, window refinement) but only on the row range.
// out: r_a@0, r_b@8, r_avg@16, a_avg@24, maxd2@32, cx@40, cy@48, fg12@56.
fn shape_half(buf:[]u8, y0:i32, y1:i32, op:[]u8, out:[]u8) void {
    let bcs:[]u8 = nio_alloc(16);
    let ngs:[]u8 = nio_alloc(16);
    let fgs:[]u8 = nio_alloc(16);
    let sxs:[]u8 = nio_alloc(16);
    let sys:[]u8 = nio_alloc(16);
    let gi:i32 = 0;
    while(gi < 2) {
        let rem:i32 = 0;
        if(gi == 1) { rem = 6; }
        let bc:i64 = 0;
        let ng:i64 = 0;
        let y:i32 = y0;
        while(y < y1) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    ng = ng + 1;
                    if(lum > 382) { bc = bc + 1; }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        op_add(op, ng);
        t_put64(bcs, gi * 8, bc);
        t_put64(ngs, gi * 8, ng);
        gi = gi + 1;
    }
    let bc12:i64 = t_get64(bcs, 0) + t_get64(bcs, 8);
    let ng12:i64 = t_get64(ngs, 0) + t_get64(ngs, 8);
    let fgbright:i32 = 0;
    if(2 * bc12 <= ng12) { fgbright = 1; }
    gi = 0;
    while(gi < 2) {
        let rem:i32 = 0;
        if(gi == 1) { rem = 6; }
        let fg:i64 = 0;
        let sx:i64 = 0;
        let sy:i64 = 0;
        let y:i32 = y0;
        while(y < y1) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    let bright:i32 = 0;
                    if(lum > 382) { bright = 1; }
                    if(bright == fgbright) { fg = fg + 1; sx = sx + (x as i64); sy = sy + (y as i64); }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        op_add(op, t_get64(ngs, gi * 8));
        t_put64(fgs, gi * 8, fg);
        t_put64(sxs, gi * 8, sx);
        t_put64(sys, gi * 8, sy);
        gi = gi + 1;
    }
    let fg12:i64 = t_get64(fgs, 0) + t_get64(fgs, 8);
    let cx:i64 = 48;
    let cy:i64 = (y0 as i64 + y1 as i64) / 2;
    if(fg12 > 0) {
        cx = (t_get64(sxs, 0) + t_get64(sxs, 8)) / fg12;
        cy = (t_get64(sys, 0) + t_get64(sys, 8)) / fg12;
    }
    let px:i32 = 48;
    let py:i32 = (y0 + y1) / 2;
    let best:i64 = -1;
    gi = 0;
    while(gi < 2) {
        let rem:i32 = 0;
        if(gi == 1) { rem = 6; }
        let y:i32 = y0;
        while(y < y1) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    let bright:i32 = 0;
                    if(lum > 382) { bright = 1; }
                    if(bright == fgbright) {
                        let dx:i64 = (x as i64) - cx;
                        let dy:i64 = (y as i64) - cy;
                        let d2:i64 = dx * dx + dy * dy;
                        if(d2 > best) { best = d2; px = x; py = y; }
                    }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        op_add(op, t_get64(ngs, gi * 8));
        gi = gi + 1;
    }
    let maxd2:i64 = best;
    if(maxd2 < 0) { maxd2 = 0; }
    let wy:i32 = py - 10;
    if(wy < y0) { wy = y0; }
    let wy1:i32 = py + 10;
    if(wy1 > y1 - 1) { wy1 = y1 - 1; }
    let wvis:i64 = 0;
    while(wy <= wy1) {
        let wx:i32 = px - 10;
        if(wx < 0) { wx = 0; }
        let wx1:i32 = px + 10;
        if(wx1 > 95) { wx1 = 95; }
        while(wx <= wx1) {
            let o:i32 = 8 + (wy * 96 + wx) * 3;
            let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
            let bright:i32 = 0;
            if(lum > 382) { bright = 1; }
            if(bright == fgbright) {
                let dx:i64 = (wx as i64) - cx;
                let dy:i64 = (wy as i64) - cy;
                let d2:i64 = dx * dx + dy * dy;
                if(d2 > maxd2) { maxd2 = d2; }
            }
            wvis = wvis + 1;
            wx = wx + 1;
        }
        wy = wy + 1;
    }
    op_add(op, wvis);
    gi = 0;
    while(gi < 2) {
        let fg:i64 = t_get64(fgs, gi * 8);
        let ng:i64 = t_get64(ngs, gi * 8);
        let a:i64 = 0;
        if(ng > 0) { a = fg * 9216 / ng; }
        let r:i64 = 0;
        if(maxd2 > 0) { r = a * 1000000 / (3142 * maxd2); }
        t_put64(out, gi * 8, r);
        gi = gi + 1;
    }
    let fgA:i64 = t_get64(fgs, 0);
    let ngA:i64 = t_get64(ngs, 0);
    let fgB:i64 = t_get64(fgs, 8);
    let ngB:i64 = t_get64(ngs, 8);
    let aA:i64 = 0;
    if(ngA > 0) { aA = fgA * 9216 / ngA; }
    let aB:i64 = 0;
    if(ngB > 0) { aB = fgB * 9216 / ngB; }
    t_put64(out, 16, (t_get64(out, 0) + t_get64(out, 8)) / 2);
    t_put64(out, 24, (aA + aB) / 2);
    t_put64(out, 32, maxd2);
    t_put64(out, 40, cx);
    t_put64(out, 48, cy);
    t_put64(out, 56, fg12);
    nio_free(bcs);
    nio_free(ngs);
    nio_free(fgs);
    nio_free(sxs);
    nio_free(sys);
}
// pitch_dppm: |fB-fA|/max in parts-per-million (frozen H2 definition).
fn pitch_dppm(fA:i64, fB:i64) i64 {
    if(fA <= 0 || fB <= 0) { return 0; }
    let mx:i64 = fA;
    if(fB > mx) { mx = fB; }
    return iabs(fB - fA) * 1000000 / mx;
}
fn task_colordisc(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8, lut:[]u8) i32 {
    let w:i64 = t_get32(buf, 0);
    let h:i64 = t_get32(buf, 4);
    if(w != 128 || h != 64) { return -1; }
    if(8 + w * h * 3 > n as i64) { return -1; }
    let m0:[]u8 = nio_alloc(24);
    let m1:[]u8 = nio_alloc(24);
    colordisc_span(buf, 0, 32, op, lut, m0);
    colordisc_span(buf, 32, 64, op, lut, m1);
    let de0:i64 = t_get64(m0, 0);
    let de0a:i64 = t_get64(m0, 8);
    let de0b:i64 = t_get64(m0, 16);
    let de1:i64 = t_get64(m1, 0);
    let de1a:i64 = t_get64(m1, 8);
    let de1b:i64 = t_get64(m1, 16);
    nio_free(m0);
    nio_free(m1);
    op_add(op, 8);
    let v0:i64 = 0;
    if(de0 >= 2300) { v0 = 1; }
    let v1:i64 = 0;
    if(de1 >= 2300) { v1 = 1; }
    let va0:i64 = 0;
    if(de0a >= 2300) { va0 = 1; }
    let vb0:i64 = 0;
    if(de0b >= 2300) { vb0 = 1; }
    let k0:i32 = 0;
    if(va0 == v0 && vb0 == v0 && iabs(de0a - de0b) <= 600) { k0 = 1; }
    let va1:i64 = 0;
    if(de1a >= 2300) { va1 = 1; }
    let vb1:i64 = 0;
    if(de1b >= 2300) { vb1 = 1; }
    let k1:i32 = 0;
    if(va1 == v1 && vb1 == v1 && iabs(de1a - de1b) <= 600) { k1 = 1; }
    let mrg0:i64 = iabs(de0 - 2300);
    let g0:i32 = 0;
    if(mrg0 >= 400) { g0 = 1; }
    let mrg1:i64 = iabs(de1 - 2300);
    let g1:i32 = 0;
    if(mrg1 >= 400) { g1 = 1; }
    let p0:i32 = 0;
    if(v1 == v0 && iabs(de1 - de0) <= 600) { p0 = 1; }
    let p1:i32 = 0;
    if(v0 == v1 && iabs(de0 - de1) <= 600) { p1 = 1; }
    let conf0:i64 = conf_of(mrg0, 1500);
    let c0:i32 = 0;
    if(conf0 >= 700) { c0 = 1; }
    let conf1:i64 = conf_of(mrg1, 1500);
    let c1:i32 = 0;
    if(conf1 >= 700) { c1 = 1; }
    let nb0:[]u8 = nio_alloc(256);
    let nb1:[]u8 = nio_alloc(256);
    let n0l:i32 = norm_prog(nb0, 0, "colordisc", c0, k0, g0, p0, v0, 700, 600, 400, 600);
    let n1l:i32 = norm_prog(nb1, 0, "colordisc", c1, k1, g1, p1, v1, 700, 600, 400, 600);
    let cmp:i32 = buf_eq(nb0, n0l, nb1, n1l);
    let r:i32 = 2;
    if(k0 == 0 || g0 == 0) { r = 1; }
    else {
        if(p0 == 0) { r = 2; }
        else {
            if(cmp == 1) { r = 0; } else { r = 2; }
        }
    }
    let j0s:[]u8 = "SAME";
    if(v0 == 1) { j0s = "DIFFERENT"; }
    let j1s:[]u8 = "SAME";
    if(v1 == 1) { j1s = "DIFFERENT"; }
    pos = ob_kv(ob, pos, "judgment", j0s);
    pos = ob_kint(ob, pos, "confidence", conf0);
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p0 as i64);
    pos = ob_kint(ob, pos, "measure", (de0 + 50) / 100);
    pos = ob_add(ob, pos, "program=R26/colordisc|SPAN=rows0-31:role=formation");
    pos = ob_add(ob, pos, "|OBS=dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((de0 + 50) / 100));
    pos = ob_add(ob, pos, ",dE_a=");
    pos = ob_add(ob, pos, _zag_i64_to_str((de0a + 50) / 100));
    pos = ob_add(ob, pos, ",dE_b=");
    pos = ob_add(ob, pos, _zag_i64_to_str((de0b + 50) / 100));
    pos = ob_add(ob, pos, "|PREDICT=rows32-63:role=holdout:dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((de1 + 50) / 100));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c0 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k0 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g0 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j0s);
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "program2=R26/colordisc|SPAN=rows32-63:role=formation");
    pos = ob_add(ob, pos, "|OBS=dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((de1 + 50) / 100));
    pos = ob_add(ob, pos, ",dE_a=");
    pos = ob_add(ob, pos, _zag_i64_to_str((de1a + 50) / 100));
    pos = ob_add(ob, pos, ",dE_b=");
    pos = ob_add(ob, pos, _zag_i64_to_str((de1b + 50) / 100));
    pos = ob_add(ob, pos, "|PREDICT=rows0-31:role=holdout:dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((de0 + 50) / 100));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c1 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k1 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g1 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j1s);
    pos = ob_add(ob, pos, "|corroborates=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm0=");
    pos = ob_add(ob, pos, nb0[0..n0l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm1=");
    pos = ob_add(ob, pos, nb1[0..n1l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "normcmp=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    nio_free(nb0);
    nio_free(nb1);
    return pos;
}

// ---- colorconst ----
// Spans: rows [0,32) / [32,64). von Kries-normalized channel-mean distance.
// out: dist_full@0, dist_a@8, dist_b@16 (per-mille).
fn cc_acc(acc:[]u8, gi:i32, h:i32, r:i64, g:i64, b:i64) void {
    let base:i32 = (gi * 2 + h) * 7;
    t_put64(acc, (base + 0) * 8, t_get64(acc, (base + 0) * 8) + r);
    t_put64(acc, (base + 1) * 8, t_get64(acc, (base + 1) * 8) + g);
    t_put64(acc, (base + 2) * 8, t_get64(acc, (base + 2) * 8) + b);
    if(r > t_get64(acc, (base + 3) * 8)) { t_put64(acc, (base + 3) * 8, r); }
    if(g > t_get64(acc, (base + 4) * 8)) { t_put64(acc, (base + 4) * 8, g); }
    if(b > t_get64(acc, (base + 5) * 8)) { t_put64(acc, (base + 5) * 8, b); }
    t_put64(acc, (base + 6) * 8, t_get64(acc, (base + 6) * 8) + 1);
}
fn cc_dist(acc:[]u8, gi:i32) i64 {
    let nr:[]u8 = nio_alloc(48);
    let h:i32 = 0;
    while(h < 2) {
        let base:i32 = (gi * 2 + h) * 7;
        let cnt:i64 = t_get64(acc, (base + 6) * 8);
        let c:i32 = 0;
        while(c < 3) {
            let mx:i64 = t_get64(acc, (base + 3 + c) * 8);
            let nv:i64 = 0;
            if(mx > 0 && cnt > 0) { nv = t_get64(acc, (base + c) * 8) * 1000 / (cnt * mx); }
            t_put64(nr, (h * 3 + c) * 8, nv);
            c = c + 1;
        }
        h = h + 1;
    }
    let dr:i64 = t_get64(nr, 0) - t_get64(nr, 24);
    let dg:i64 = t_get64(nr, 8) - t_get64(nr, 32);
    let db:i64 = t_get64(nr, 16) - t_get64(nr, 40);
    nio_free(nr);
    return isqrt(dr * dr + dg * dg + db * db);
}
fn colorconst_span(buf:[]u8, y0:i32, y1:i32, op:[]u8, out:[]u8) void {
    let acc:[]u8 = nio_alloc(3 * 2 * 7 * 8);
    let s:i32 = 0;
    while(s < 42) { t_put64(acc, s * 8, 0); s = s + 1; }
    let y:i32 = y0;
    let visits:i64 = 0;
    while(y < y1) {
        let x:i32 = 0;
        while(x < 128) {
            let h:i32 = 0;
            if(x >= 64) { h = 1; }
            let o:i32 = 8 + (y * 128 + x) * 3;
            let r:i64 = buf[o] as i64;
            let g:i64 = buf[o + 1] as i64;
            let b:i64 = buf[o + 2] as i64;
            cc_acc(acc, 0, h, r, g, b);
            if((y & 1) == 0) { cc_acc(acc, 1, h, r, g, b); } else { cc_acc(acc, 2, h, r, g, b); }
            x = x + 1;
            visits = visits + 1;
        }
        y = y + 1;
    }
    op_add(op, visits);
    t_put64(out, 0, cc_dist(acc, 0));
    t_put64(out, 8, cc_dist(acc, 1));
    t_put64(out, 16, cc_dist(acc, 2));
    op_add(op, 24);
    nio_free(acc);
}
fn task_colorconst(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8) i32 {
    let w:i64 = t_get32(buf, 0);
    let h:i64 = t_get32(buf, 4);
    if(w != 128 || h != 64) { return -1; }
    if(8 + w * h * 3 > n as i64) { return -1; }
    let m0:[]u8 = nio_alloc(24);
    let m1:[]u8 = nio_alloc(24);
    colorconst_span(buf, 0, 32, op, m0);
    colorconst_span(buf, 32, 64, op, m1);
    let d0:i64 = t_get64(m0, 0);
    let d0a:i64 = t_get64(m0, 8);
    let d0b:i64 = t_get64(m0, 16);
    let d1:i64 = t_get64(m1, 0);
    let d1a:i64 = t_get64(m1, 8);
    let d1b:i64 = t_get64(m1, 16);
    nio_free(m0);
    nio_free(m1);
    op_add(op, 8);
    let v0:i64 = 0;
    if(d0 >= 150) { v0 = 1; }
    let v1:i64 = 0;
    if(d1 >= 150) { v1 = 1; }
    let va0:i64 = 0;
    if(d0a >= 150) { va0 = 1; }
    let vb0:i64 = 0;
    if(d0b >= 150) { vb0 = 1; }
    let k0:i32 = 0;
    if(va0 == v0 && vb0 == v0 && iabs(d0a - d0b) <= 60) { k0 = 1; }
    let va1:i64 = 0;
    if(d1a >= 150) { va1 = 1; }
    let vb1:i64 = 0;
    if(d1b >= 150) { vb1 = 1; }
    let k1:i32 = 0;
    if(va1 == v1 && vb1 == v1 && iabs(d1a - d1b) <= 60) { k1 = 1; }
    let mrg0:i64 = iabs(d0 - 150);
    let g0:i32 = 0;
    if(mrg0 >= 50) { g0 = 1; }
    let mrg1:i64 = iabs(d1 - 150);
    let g1:i32 = 0;
    if(mrg1 >= 50) { g1 = 1; }
    let p0:i32 = 0;
    if(v1 == v0 && iabs(d1 - d0) <= 60) { p0 = 1; }
    let p1:i32 = 0;
    if(v0 == v1 && iabs(d0 - d1) <= 60) { p1 = 1; }
    let conf0:i64 = conf_of(mrg0, 150);
    let c0:i32 = 0;
    if(conf0 >= 700) { c0 = 1; }
    let conf1:i64 = conf_of(mrg1, 150);
    let c1:i32 = 0;
    if(conf1 >= 700) { c1 = 1; }
    let nb0:[]u8 = nio_alloc(256);
    let nb1:[]u8 = nio_alloc(256);
    let n0l:i32 = norm_prog(nb0, 0, "colorconst", c0, k0, g0, p0, v0, 700, 60, 50, 60);
    let n1l:i32 = norm_prog(nb1, 0, "colorconst", c1, k1, g1, p1, v1, 700, 60, 50, 60);
    let cmp:i32 = buf_eq(nb0, n0l, nb1, n1l);
    let r:i32 = 2;
    if(k0 == 0 || g0 == 0) { r = 1; }
    else {
        if(p0 == 0) { r = 2; }
        else {
            if(cmp == 1) { r = 0; } else { r = 2; }
        }
    }
    let j0s:[]u8 = "SAME_SURFACE";
    if(v0 == 1) { j0s = "DIFFERENT"; }
    let j1s:[]u8 = "SAME_SURFACE";
    if(v1 == 1) { j1s = "DIFFERENT"; }
    pos = ob_kv(ob, pos, "judgment", j0s);
    pos = ob_kint(ob, pos, "confidence", conf0);
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p0 as i64);
    pos = ob_kint(ob, pos, "measure", d0);
    pos = ob_add(ob, pos, "program=R26/colorconst|SPAN=rows0-31:role=formation");
    pos = ob_add(ob, pos, "|OBS=dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d0));
    pos = ob_add(ob, pos, ",dist_a=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d0a));
    pos = ob_add(ob, pos, ",dist_b=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d0b));
    pos = ob_add(ob, pos, "|PREDICT=rows32-63:role=holdout:dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c0 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k0 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g0 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j0s);
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "program2=R26/colorconst|SPAN=rows32-63:role=formation");
    pos = ob_add(ob, pos, "|OBS=dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d1));
    pos = ob_add(ob, pos, ",dist_a=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d1a));
    pos = ob_add(ob, pos, ",dist_b=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d1b));
    pos = ob_add(ob, pos, "|PREDICT=rows0-31:role=holdout:dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d0));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c1 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k1 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g1 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j1s);
    pos = ob_add(ob, pos, "|corroborates=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm0=");
    pos = ob_add(ob, pos, nb0[0..n0l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm1=");
    pos = ob_add(ob, pos, nb1[0..n1l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "normcmp=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    nio_free(nb0);
    nio_free(nb1);
    return pos;
}

// ---- shapetrans ----
// Spans: rows [0,48) / [48,96). Half-specific prototypes (frozen).
// Sub-measurements: two diagonal grids within the half.
fn task_shapetrans(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8) i32 {
    if(t_get32(buf, 0) != 96 || t_get32(buf, 4) != 96) { return -1; }
    if(8 + 96 * 96 * 3 > n as i64) { return -1; }
    let m0:[]u8 = nio_alloc(64);
    let m1:[]u8 = nio_alloc(64);
    shape_half(buf, 0, 48, op, m0);
    shape_half(buf, 48, 96, op, m1);
    let r0a:i64 = t_get64(m0, 0);
    let r0b:i64 = t_get64(m0, 8);
    let r0:i64 = t_get64(m0, 16);
    let fg0:i64 = t_get64(m0, 56);
    let r1a:i64 = t_get64(m1, 0);
    let r1b:i64 = t_get64(m1, 8);
    let r1:i64 = t_get64(m1, 16);
    let fg1:i64 = t_get64(m1, 56);
    nio_free(m0);
    nio_free(m1);
    op_add(op, 8);
    let valid0:i32 = 0;
    if(fg0 >= 4) { valid0 = 1; }
    let valid1:i32 = 0;
    if(fg1 >= 4) { valid1 = 1; }
    let v0:i64 = shape_class_half(r0, 0);
    let v1:i64 = shape_class_half(r1, 1);
    let ca0:i64 = shape_class_half(r0a, 0);
    let cb0:i64 = shape_class_half(r0b, 0);
    let ca1:i64 = shape_class_half(r1a, 1);
    let cb1:i64 = shape_class_half(r1b, 1);
    let k0:i32 = 0;
    if(valid0 == 1 && ca0 == v0 && cb0 == v0 && iabs(r0a - r0b) <= 120) { k0 = 1; }
    let k1:i32 = 0;
    if(valid1 == 1 && ca1 == v1 && cb1 == v1 && iabs(r1a - r1b) <= 120) { k1 = 1; }
    let mrg0:i64 = shape_margin_half(r0, v0, 0);
    let g0:i32 = 0;
    if(mrg0 >= 60) { g0 = 1; }
    let mrg1:i64 = shape_margin_half(r1, v1, 1);
    let g1:i32 = 0;
    if(mrg1 >= 60) { g1 = 1; }
    let p0:i32 = 0;
    if(valid1 == 1 && v1 == v0 && iabs(r1 - shape_proto(1, v0)) <= 120) { p0 = 1; }
    let p1:i32 = 0;
    if(valid0 == 1 && v0 == v1 && iabs(r0 - shape_proto(0, v1)) <= 120) { p1 = 1; }
    let conf0:i64 = conf_of(mrg0, 200);
    let c0:i32 = 0;
    if(conf0 >= 700) { c0 = 1; }
    let conf1:i64 = conf_of(mrg1, 200);
    let c1:i32 = 0;
    if(conf1 >= 700) { c1 = 1; }
    let nb0:[]u8 = nio_alloc(256);
    let nb1:[]u8 = nio_alloc(256);
    let n0l:i32 = norm_prog(nb0, 0, "shapetrans", c0, k0, g0, p0, v0, 700, 120, 60, 120);
    let n1l:i32 = norm_prog(nb1, 0, "shapetrans", c1, k1, g1, p1, v1, 700, 120, 60, 120);
    let cmp:i32 = buf_eq(nb0, n0l, nb1, n1l);
    let r:i32 = 2;
    if(k0 == 0 || g0 == 0) { r = 1; }
    else {
        if(valid1 == 0) { r = 2; }
        else {
            if(p0 == 0) { r = 2; }
            else {
                if(cmp == 1) { r = 0; } else { r = 2; }
            }
        }
    }
    pos = ob_kv(ob, pos, "judgment", shape_name(v0));
    pos = ob_kint(ob, pos, "confidence", conf0);
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p0 as i64);
    pos = ob_kint(ob, pos, "measure", r0);
    pos = ob_add(ob, pos, "program=R26/shapetrans|SPAN=rows0-47:role=formation");
    pos = ob_add(ob, pos, "|OBS=ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r0));
    pos = ob_add(ob, pos, ",r_a=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r0a));
    pos = ob_add(ob, pos, ",r_b=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r0b));
    pos = ob_add(ob, pos, "|PREDICT=rows48-95:role=holdout:ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r1));
    pos = ob_add(ob, pos, ",class=");
    pos = ob_add(ob, pos, shape_name(v1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c0 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k0 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g0 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, shape_name(v0));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "program2=R26/shapetrans|SPAN=rows48-95:role=formation");
    pos = ob_add(ob, pos, "|OBS=ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r1));
    pos = ob_add(ob, pos, ",r_a=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r1a));
    pos = ob_add(ob, pos, ",r_b=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r1b));
    pos = ob_add(ob, pos, "|PREDICT=rows0-47:role=holdout:ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r0));
    pos = ob_add(ob, pos, ",class=");
    pos = ob_add(ob, pos, shape_name(v0));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c1 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k1 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g1 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, shape_name(v1));
    pos = ob_add(ob, pos, "|corroborates=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm0=");
    pos = ob_add(ob, pos, nb0[0..n0l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm1=");
    pos = ob_add(ob, pos, nb1[0..n1l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "normcmp=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    nio_free(nb0);
    nio_free(nb1);
    return pos;
}

// ---- pitchdisc ----
// Spans: first / second half of each tone. f0 per half via f0_r26.
// Sub-measurements (t.consistency): two 768-sample check windows per span.
fn pitchdisc_verdict(fA:i64, fB:i64) i64 {
    let v:i64 = 0;
    if(pitch_dppm(fA, fB) >= 5000) {
        if(fB > fA) { v = 1; } else { v = 2; }
    }
    return v;
}
fn task_pitchdisc(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8) i32 {
    let sr:i64 = t_get32(buf, 0);
    if(sr <= 0 || sr > 48000) { return -1; }
    let cnt:i64 = (n as i64 - 8) / 2;
    if(cnt <= 0) { return -1; }
    let tone:i32 = (cnt * 10 / 22) as i32;
    let half:i32 = tone / 2;
    let gap:i64 = cnt - 2 * (tone as i64);
    let aoff:i32 = 8;
    let boff:i32 = 8 + (tone as i32 + (gap as i32)) * 2;
    let f0A0:i64 = f0_r26(buf, aoff, half, sr, op);
    let f0A1:i64 = f0_r26(buf, aoff + half * 2, half, sr, op);
    let f0B0:i64 = f0_r26(buf, boff, half, sr, op);
    let f0B1:i64 = f0_r26(buf, boff + half * 2, half, sr, op);
    let dppm0:i64 = pitch_dppm(f0A0, f0B0);
    let dppm1:i64 = pitch_dppm(f0A1, f0B1);
    let valid0:i32 = 0;
    if(f0A0 > 0 && f0B0 > 0) { valid0 = 1; }
    let valid1:i32 = 0;
    if(f0A1 > 0 && f0B1 > 0) { valid1 = 1; }
    let v0:i64 = pitchdisc_verdict(f0A0, f0B0);
    let v1:i64 = pitchdisc_verdict(f0A1, f0B1);
    // t.consistency: two check windows per span must both classify the span's verdict
    let ck0:i64 = pitch_win(buf, aoff + 200 * 2, sr, f0A0, f0B0, v0, op) + pitch_win(buf, aoff + 1200 * 2, sr, f0A0, f0B0, v0, op) + pitch_win(buf, boff + 200 * 2, sr, f0A0, f0B0, v0, op) + pitch_win(buf, boff + 1200 * 2, sr, f0A0, f0B0, v0, op);
    let ck1:i64 = pitch_win(buf, aoff + half * 2 + 200 * 2, sr, f0A1, f0B1, v1, op) + pitch_win(buf, aoff + half * 2 + 1200 * 2, sr, f0A1, f0B1, v1, op) + pitch_win(buf, boff + half * 2 + 200 * 2, sr, f0A1, f0B1, v1, op) + pitch_win(buf, boff + half * 2 + 1200 * 2, sr, f0A1, f0B1, v1, op);
    let k0:i32 = 0;
    if(valid0 == 1 && ck0 >= 3) { k0 = 1; }
    let k1:i32 = 0;
    if(valid1 == 1 && ck1 >= 3) { k1 = 1; }
    let mrg0:i64 = iabs(dppm0 - 5000);
    if(v0 == 2) { mrg0 = iabs(dppm0 + 5000); }
    let g0:i32 = 0;
    if(mrg0 >= 1500) { g0 = 1; }
    let mrg1:i64 = iabs(dppm1 - 5000);
    if(v1 == 2) { mrg1 = iabs(dppm1 + 5000); }
    let g1:i32 = 0;
    if(mrg1 >= 1500) { g1 = 1; }
    let p0:i32 = 0;
    if(valid1 == 1 && v1 == v0 && iabs(f0A1 - f0A0) <= 3000 && iabs(f0B1 - f0B0) <= 3000) { p0 = 1; }
    let p1:i32 = 0;
    if(valid0 == 1 && v0 == v1 && iabs(f0A0 - f0A1) <= 3000 && iabs(f0B0 - f0B1) <= 3000) { p1 = 1; }
    let conf0:i64 = conf_of(mrg0, 3000);
    let c0:i32 = 0;
    if(conf0 >= 700) { c0 = 1; }
    let conf1:i64 = conf_of(mrg1, 3000);
    let c1:i32 = 0;
    if(conf1 >= 700) { c1 = 1; }
    let nb0:[]u8 = nio_alloc(256);
    let nb1:[]u8 = nio_alloc(256);
    let n0l:i32 = norm_prog(nb0, 0, "pitchdisc", c0, k0, g0, p0, v0, 700, 3, 1500, 3000);
    let n1l:i32 = norm_prog(nb1, 0, "pitchdisc", c1, k1, g1, p1, v1, 700, 3, 1500, 3000);
    let cmp:i32 = buf_eq(nb0, n0l, nb1, n1l);
    let r:i32 = 2;
    if(k0 == 0 || g0 == 0) { r = 1; }
    else {
        if(valid1 == 0) { r = 2; }
        else {
            if(p0 == 0) { r = 2; }
            else {
                if(cmp == 1) { r = 0; } else { r = 2; }
            }
        }
    }
    let j0s:[]u8 = "SAME";
    if(v0 == 1) { j0s = "HIGHER"; }
    if(v0 == 2) { j0s = "LOWER"; }
    let j1s:[]u8 = "SAME";
    if(v1 == 1) { j1s = "HIGHER"; }
    if(v1 == 2) { j1s = "LOWER"; }
    pos = ob_kv(ob, pos, "judgment", j0s);
    pos = ob_kint(ob, pos, "confidence", conf0);
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p0 as i64);
    pos = ob_kint(ob, pos, "measure", (dppm0 + 5) / 10);
    pos = ob_add(ob, pos, "program=R26/pitchdisc|SPAN=tonehalves0:role=formation");
    pos = ob_add(ob, pos, "|OBS=f0A=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0A0));
    pos = ob_add(ob, pos, ",f0B=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0B0));
    pos = ob_add(ob, pos, ",dppm=");
    pos = ob_add(ob, pos, _zag_i64_to_str((dppm0 + 5) / 10));
    pos = ob_add(ob, pos, "|PREDICT=tonehalves1:role=holdout:f0A=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0A1));
    pos = ob_add(ob, pos, ",f0B=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0B1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c0 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k0 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g0 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j0s);
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "program2=R26/pitchdisc|SPAN=tonehalves1:role=formation");
    pos = ob_add(ob, pos, "|OBS=f0A=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0A1));
    pos = ob_add(ob, pos, ",f0B=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0B1));
    pos = ob_add(ob, pos, ",dppm=");
    pos = ob_add(ob, pos, _zag_i64_to_str((dppm1 + 5) / 10));
    pos = ob_add(ob, pos, "|PREDICT=tonehalves0:role=holdout:f0A=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0A0));
    pos = ob_add(ob, pos, ",f0B=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0B0));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c1 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k1 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g1 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j1s);
    pos = ob_add(ob, pos, "|corroborates=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm0=");
    pos = ob_add(ob, pos, nb0[0..n0l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm1=");
    pos = ob_add(ob, pos, nb1[0..n1l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "normcmp=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    nio_free(nb0);
    nio_free(nb1);
    return pos;
}

// ---- timbredisc ----
// Spans: samples [0,6400) / [6400,12800). f0 + centroid per half.
// Sub-measurements: two 1024-sample centroid windows per span.
fn task_timbredisc(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8) i32 {
    let sr:i64 = t_get32(buf, 0);
    if(sr <= 0 || sr > 48000) { return -1; }
    let cnt:i64 = (n as i64 - 8) / 2;
    if(cnt <= 0) { return -1; }
    let s0:i32 = 8;
    let s1:i32 = 8 + ((cnt / 2) as i32) * 2;
    let f00:i64 = f0_r26(buf, s0, (cnt / 2) as i32, sr, op);
    let f01:i64 = f0_r26(buf, s1, (cnt / 2) as i32, sr, op);
    let cent0:i64 = spec_centroid_h2(buf, s0, 2048, sr, f00, op);
    let cent1:i64 = spec_centroid_h2(buf, s1, 2048, sr, f01, op);
    let cent0a:i64 = spec_centroid_h2(buf, s0, 1024, sr, f00, op);
    let cent0b:i64 = spec_centroid_h2(buf, s0 + 2048 * 2, 1024, sr, f00, op);
    let cent1a:i64 = spec_centroid_h2(buf, s1, 1024, sr, f01, op);
    let cent1b:i64 = spec_centroid_h2(buf, s1 + 2048 * 2, 1024, sr, f01, op);
    let valid0:i32 = 0;
    if(f00 > 0 && cent0 >= 0) { valid0 = 1; }
    let valid1:i32 = 0;
    if(f01 > 0 && cent1 >= 0) { valid1 = 1; }
    let v0:i64 = timbre_class(cent0);
    let v1:i64 = timbre_class(cent1);
    let ca0:i64 = timbre_class(cent0a);
    let cb0:i64 = timbre_class(cent0b);
    let ca1:i64 = timbre_class(cent1a);
    let cb1:i64 = timbre_class(cent1b);
    let k0:i32 = 0;
    if(valid0 == 1 && ca0 == v0 && cb0 == v0 && iabs(cent0a - cent0b) <= 150) { k0 = 1; }
    let k1:i32 = 0;
    if(valid1 == 1 && ca1 == v1 && cb1 == v1 && iabs(cent1a - cent1b) <= 150) { k1 = 1; }
    let mrg0:i64 = timbre_margin(cent0, v0);
    let g0:i32 = 0;
    if(mrg0 >= 80) { g0 = 1; }
    let mrg1:i64 = timbre_margin(cent1, v1);
    let g1:i32 = 0;
    if(mrg1 >= 80) { g1 = 1; }
    let p0:i32 = 0;
    if(valid1 == 1 && v1 == v0 && iabs(cent1 - cent0) <= 150 && iabs(f01 - f00) <= 5000) { p0 = 1; }
    let p1:i32 = 0;
    if(valid0 == 1 && v0 == v1 && iabs(cent0 - cent1) <= 150 && iabs(f00 - f01) <= 5000) { p1 = 1; }
    let conf0:i64 = conf_of(mrg0, 150);
    let c0:i32 = 0;
    if(conf0 >= 700) { c0 = 1; }
    let conf1:i64 = conf_of(mrg1, 150);
    let c1:i32 = 0;
    if(conf1 >= 700) { c1 = 1; }
    let nb0:[]u8 = nio_alloc(256);
    let nb1:[]u8 = nio_alloc(256);
    let n0l:i32 = norm_prog(nb0, 0, "timbredisc", c0, k0, g0, p0, v0, 700, 150, 80, 150);
    let n1l:i32 = norm_prog(nb1, 0, "timbredisc", c1, k1, g1, p1, v1, 700, 150, 80, 150);
    let cmp:i32 = buf_eq(nb0, n0l, nb1, n1l);
    let r:i32 = 2;
    if(k0 == 0 || g0 == 0) { r = 1; }
    else {
        if(valid1 == 0) { r = 2; }
        else {
            if(p0 == 0) { r = 2; }
            else {
                if(cmp == 1) { r = 0; } else { r = 2; }
            }
        }
    }
    let j0s:[]u8 = "BRIGHT";
    if(v0 == 1) { j0s = "DARK"; }
    let j1s:[]u8 = "BRIGHT";
    if(v1 == 1) { j1s = "DARK"; }
    pos = ob_kv(ob, pos, "judgment", j0s);
    pos = ob_kint(ob, pos, "confidence", conf0);
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p0 as i64);
    pos = ob_kint(ob, pos, "measure", cent0);
    pos = ob_add(ob, pos, "program=R26/timbredisc|SPAN=samp0-6399:role=formation");
    pos = ob_add(ob, pos, "|OBS=f0=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f00));
    pos = ob_add(ob, pos, ",cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(cent0));
    pos = ob_add(ob, pos, ",cent_a=");
    pos = ob_add(ob, pos, _zag_i64_to_str(cent0a));
    pos = ob_add(ob, pos, ",cent_b=");
    pos = ob_add(ob, pos, _zag_i64_to_str(cent0b));
    pos = ob_add(ob, pos, "|PREDICT=samp6400-12799:role=holdout:f0=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f01));
    pos = ob_add(ob, pos, ",cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(cent1));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c0 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k0 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g0 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j0s);
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "program2=R26/timbredisc|SPAN=samp6400-12799:role=formation");
    pos = ob_add(ob, pos, "|OBS=f0=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f01));
    pos = ob_add(ob, pos, ",cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(cent1));
    pos = ob_add(ob, pos, ",cent_a=");
    pos = ob_add(ob, pos, _zag_i64_to_str(cent1a));
    pos = ob_add(ob, pos, ",cent_b=");
    pos = ob_add(ob, pos, _zag_i64_to_str(cent1b));
    pos = ob_add(ob, pos, "|PREDICT=samp0-6399:role=holdout:f0=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f00));
    pos = ob_add(ob, pos, ",cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(cent0));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c1 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k1 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g1 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j1s);
    pos = ob_add(ob, pos, "|corroborates=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm0=");
    pos = ob_add(ob, pos, nb0[0..n0l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm1=");
    pos = ob_add(ob, pos, nb1[0..n1l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "normcmp=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    nio_free(nb0);
    nio_free(nb1);
    return pos;
}

// ---- motiondir ----
// Spans: frames [0,4) / [4,8). Two profiles per span (different offsets).
fn task_motiondir(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8) i32 {
    let f:i64 = t_get32(buf, 0);
    let w:i64 = t_get32(buf, 4);
    let h:i64 = t_get32(buf, 8);
    if(w != 64 || h != 64 || f != 8) { return -1; }
    if(12 + w * h * 3 * f > n as i64) { return -1; }
    let d0:[]u8 = nio_alloc(64);
    let d0b:[]u8 = nio_alloc(64);
    let d1:[]u8 = nio_alloc(64);
    let d1b:[]u8 = nio_alloc(64);
    profile_motion(buf, 8, 0, 8, 0, 0, 3, op, d0);
    profile_motion(buf, 8, 4, 8, 4, 0, 3, op, d0b);
    profile_motion(buf, 8, 0, 8, 0, 4, 7, op, d1);
    profile_motion(buf, 8, 4, 8, 4, 4, 7, op, d1b);
    let dx0:i64 = t_get64(d0, 0);
    let dy0:i64 = t_get64(d0, 8);
    let dir0:i64 = t_get64(d0, 16);
    let have0:i64 = t_get64(d0, 24);
    let mag0:i64 = t_get64(d0, 32);
    let dx0b:i64 = t_get64(d0b, 0);
    let dy0b:i64 = t_get64(d0b, 8);
    let dir0b:i64 = t_get64(d0b, 16);
    let have0b:i64 = t_get64(d0b, 32);
    let dx1:i64 = t_get64(d1, 0);
    let dy1:i64 = t_get64(d1, 8);
    let dir1:i64 = t_get64(d1, 16);
    let have1:i64 = t_get64(d1, 24);
    let mag1:i64 = t_get64(d1, 32);
    let dx1b:i64 = t_get64(d1b, 0);
    let dy1b:i64 = t_get64(d1b, 8);
    let dir1b:i64 = t_get64(d1b, 16);
    let have1b:i64 = t_get64(d1b, 32);
    nio_free(d0);
    nio_free(d0b);
    nio_free(d1);
    nio_free(d1b);
    op_add(op, 8);
    let valid0:i32 = 0;
    if((have0 == 1 && have0b == 1) || dir0 == 0) { valid0 = 1; }
    let valid1:i32 = 0;
    if((have1 == 1 && have1b == 1) || dir1 == 0) { valid1 = 1; }
    let k0:i32 = 0;
    if(valid0 == 1 && dir0b == dir0 && iabs(dx0b - dx0) <= 4 && iabs(dy0b - dy0) <= 4) { k0 = 1; }
    let k1:i32 = 0;
    if(valid1 == 1 && dir1b == dir1 && iabs(dx1b - dx1) <= 4 && iabs(dy1b - dy1) <= 4) { k1 = 1; }
    let mrg0:i64 = iabs(mag0 - 3);
    let g0:i32 = 0;
    if(mrg0 >= 2) { g0 = 1; }
    let mrg1:i64 = iabs(mag1 - 3);
    let g1:i32 = 0;
    if(mrg1 >= 2) { g1 = 1; }
    let p0:i32 = 0;
    if(valid1 == 1 && dir1 == dir0 && iabs(dx1 - dx0) <= 4 && iabs(dy1 - dy0) <= 4) { p0 = 1; }
    let p1:i32 = 0;
    if(valid0 == 1 && dir0 == dir1 && iabs(dx0 - dx1) <= 4 && iabs(dy0 - dy1) <= 4) { p1 = 1; }
    let conf0:i64 = conf_of(mrg0, 4);
    let c0:i32 = 0;
    if(conf0 >= 700) { c0 = 1; }
    let conf1:i64 = conf_of(mrg1, 4);
    let c1:i32 = 0;
    if(conf1 >= 700) { c1 = 1; }
    let nb0:[]u8 = nio_alloc(256);
    let nb1:[]u8 = nio_alloc(256);
    let n0l:i32 = norm_prog(nb0, 0, "motiondir", c0, k0, g0, p0, dir0, 700, 4, 2, 4);
    let n1l:i32 = norm_prog(nb1, 0, "motiondir", c1, k1, g1, p1, dir1, 700, 4, 2, 4);
    let cmp:i32 = buf_eq(nb0, n0l, nb1, n1l);
    let r:i32 = 2;
    if(k0 == 0 || g0 == 0) { r = 1; }
    else {
        if(valid1 == 0) { r = 2; }
        else {
            if(p0 == 0) { r = 2; }
            else {
                if(cmp == 1) { r = 0; } else { r = 2; }
            }
        }
    }
    let j0s:[]u8 = dir_name(dir0);
    let j1s:[]u8 = dir_name(dir1);
    pos = ob_kv(ob, pos, "judgment", j0s);
    pos = ob_kint(ob, pos, "confidence", conf0);
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p0 as i64);
    pos = ob_kint(ob, pos, "measure", dir0);
    pos = ob_add(ob, pos, "program=R26/motiondir|SPAN=frames0-3:role=formation");
    pos = ob_add(ob, pos, "|OBS=dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dx0));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dy0));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, j0s);
    pos = ob_add(ob, pos, "|PREDICT=frames4-7:role=holdout:dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dx1));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dy1));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, j1s);
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c0 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k0 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g0 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p0 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j0s);
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "program2=R26/motiondir|SPAN=frames4-7:role=formation");
    pos = ob_add(ob, pos, "|OBS=dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dx1));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dy1));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, j1s);
    pos = ob_add(ob, pos, "|PREDICT=frames0-3:role=holdout:dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dx0));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dy0));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, j0s);
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|TESTS=t.calibration=");
    pos = ob_add(ob, pos, _zag_i64_to_str(c1 as i64));
    pos = ob_add(ob, pos, ",t.consistency=");
    pos = ob_add(ob, pos, _zag_i64_to_str(k1 as i64));
    pos = ob_add(ob, pos, ",t.margin=");
    pos = ob_add(ob, pos, _zag_i64_to_str(g1 as i64));
    pos = ob_add(ob, pos, ",t.pred=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, ",t.verdict=");
    pos = ob_add(ob, pos, j1s);
    pos = ob_add(ob, pos, "|corroborates=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm0=");
    pos = ob_add(ob, pos, nb0[0..n0l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "norm1=");
    pos = ob_add(ob, pos, nb1[0..n1l]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "normcmp=");
    if(cmp == 1) { pos = ob_add(ob, pos, "EQUAL"); } else { pos = ob_add(ob, pos, "DIFFER"); }
    pos = ob_add(ob, pos, "\n");
    nio_free(nb0);
    nio_free(nb1);
    return pos;
}
fn main() i32 {
    // argc is always 0 in this runtime; read _zag_arg directly.
    let task:[]u8 = _zag_arg(1);
    let path:[]u8 = _zag_arg(2);
    if(task.len == 0) { return fail("?", "usage: sense_h2 <task> <fixture>"); }
    let buf:[]u8 = nio_alloc(8388608);
    if(buf.len == 0) { return fail(task, "no-memory"); }
    let n:i64 = z_read(path, buf, 8388608);
    if(n < 0) { nio_free(buf); return fail(task, "bad-read"); }
    let op:[]u8 = nio_alloc(8);
    t_put64(op, 0, 0);
    let lut:[]u8 = nio_alloc(2048);
    lut_init(lut);
    let ob:[]u8 = nio_alloc(4096);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "R26");
    pos = ob_kv(ob, pos, "task", task);
    let rc:i32 = -1;
    if(_zag_strcmp(task, "colordisc") == 1) { rc = task_colordisc(buf, n as i32, ob, pos, op, lut); }
    if(_zag_strcmp(task, "colorconst") == 1) { rc = task_colorconst(buf, n as i32, ob, pos, op); }
    if(_zag_strcmp(task, "shapetrans") == 1) { rc = task_shapetrans(buf, n as i32, ob, pos, op); }
    if(_zag_strcmp(task, "pitchdisc") == 1) { rc = task_pitchdisc(buf, n as i32, ob, pos, op); }
    if(_zag_strcmp(task, "timbredisc") == 1) { rc = task_timbredisc(buf, n as i32, ob, pos, op); }
    if(_zag_strcmp(task, "motiondir") == 1) { rc = task_motiondir(buf, n as i32, ob, pos, op); }
    nio_free(buf);
    nio_free(lut);
    if(rc < 0) {
        nio_free(op);
        nio_free(ob);
        return fail(task, "bad-size");
    }
    pos = rc;
    let ops:i64 = t_get64(op, 0);
    nio_free(op);
    pos = ob_kint(ob, pos, "ops", ops);
    pos = ob_kint(ob, pos, "cost", ops);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 0;
}

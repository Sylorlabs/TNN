// fs2_form.zag — FS-E2 Phase 0: INDEPENDENT formation-accuracy measurement.
//
// Independent reimplementation of the six R2A formation functions from the
// frozen task definitions (PREREG_FS-E1 "Formation" section; the definitions
// FS-E1 froze verbatim from R2-16). Written fresh for FS-E2 Phase 0; shares
// no code with FS-E1/R2-16 formation paths. Formation-only: reads one R2FX
// fixture, prints the formation judgment. No challenges, no ledger, no RNG.
// Pure Zag, integer math only. Deterministic given fixture bytes.
//
// R2FX header (frozen): 8 x u32 LE: magic 0x52324658, task, index, family,
//   f_off, f_len, g_off, g_len. Task ids: 0 colordisc, 1 colorconst,
//   2 shapetrans, 3 pitchdisc, 4 timbredisc, 5 motiondir.
//
// CLI: fs2_form <fixture.r2fx>
// stdout: "task=<name> judgment=<JNAME>\n". exit 0 on success.
@import("R33_NATIVE_IO_V1.zag")
@import("lut_frag.zag")

fn f_abs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn f_min(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
// integer sqrt (Newton), x >= 0
fn f_isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    let r:i64 = x;
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn f_u32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn f_i16(b:[]u8, at:i32) i64 {
    let v:i64 = (b[at] as i64) | ((b[at+1] as i64) << 8);
    if(v >= 32768) { return v - 65536; }
    return v;
}
// NUL-terminate a path slice for open(2)
fn f_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc(s.len + 1);
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
// read whole file into buf (cap bytes); returns bytes read or negative
fn f_readall(path:[]u8, buf:[]u8, cap:i32) i64 {
    let s:[]u8 = f_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -1; }
    let total:i64 = 0;
    while(total < (cap as i64)) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total,
                                     (cap as i64) - total, 0, 0, 0);
        if(n <= 0) { break; }
        total = total + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}
fn f_out(s:[]u8) void {
    _zag_raw_syscall(1, 1, _zag_slice_ptr(s) as i64, s.len as i64, 0, 0, 0);
}

// ---------------- formation functions ----------------
// Each returns the formation judgment id. Definitions frozen per PREREG_FS-E1.

// t0 colordisc: mean-RGB distance of two 32x32 patches, DIFFERENT iff >= 18.
fn f_colordisc(img:[]u8, fo:i32) i32 {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let tr:i64 = 0; let tg:i64 = 0; let tb:i64 = 0;
    let i:i32 = 0;
    while(i < 3072) {
        sr = sr + (img[fo + i] as i64);
        sg = sg + (img[fo + i + 1] as i64);
        sb = sb + (img[fo + i + 2] as i64);
        tr = tr + (img[fo + 3072 + i] as i64);
        tg = tg + (img[fo + 3072 + i + 1] as i64);
        tb = tb + (img[fo + 3072 + i + 2] as i64);
        i = i + 3;
    }
    let dr:i64 = sr / 1024 - tr / 1024;
    let dg:i64 = sg / 1024 - tg / 1024;
    let db:i64 = sb / 1024 - tb / 1024;
    let d:i64 = f_isqrt(dr * dr + dg * dg + db * db);
    if(d >= 18) { return 1; }
    return 0;
}

// t1 colorconst (FS-F2C improved): linear-space ratio-dispersion formation,
// DIFFERENT iff d >= 44. See PREREG_FS-F2C.md section 2 for the frozen spec
// and overflow proof. Pure integer math, zero RNG.
fn f_colorconst_d(img:[]u8, fo:i32) i64 {
    let d:i64 = 0;
    let c:i32 = 0;
    while(c < 3) {
        let s1:i64 = 0; let s2:i64 = 0; let n:i64 = 0;
        let i:i32 = 0;
        while(i < 6912) {
            let ra:i64 = img[fo + i + c] as i64;
            let rb:i64 = img[fo + 6912 + i + c] as i64;
            if(ra < 250) {
                if(rb < 250) {
                    let la:i64 = f_linlut(ra as i32);
                    let lb:i64 = f_linlut(rb as i32);
                    if(la >= 100) {
                        if(lb >= 100) {
                            let r:i64 = lb * 1000 / la;
                            s1 = s1 + r;
                            s2 = s2 + r * r;
                            n = n + 1;
                        }
                    }
                }
            }
            i = i + 3;
        }
        if(n >= 64) {
            let num:i64 = s2 * n - s1 * s1;
            if(num < 0) { num = 0; }
            let den:i64 = s1 * s1;
            if(den < 1) { den = 1; }
            d = d + num * 300 / den;
        }
        c = c + 1;
    }
    return d;
}
fn f_colorconst(img:[]u8, fo:i32) i32 {
    if(f_colorconst_d(img, fo) >= 44) { return 1; }
    return 0;
}

// t2 shapetrans: 96x96 bbox fill-ratio -> class.
fn f_shapetrans(img:[]u8, fo:i32) i32 {
    let cnt:i64 = 0;
    let x0:i32 = 96; let x1:i32 = -1;
    let y0:i32 = 96; let y1:i32 = -1;
    let y:i32 = 0;
    while(y < 96) {
        let x:i32 = 0;
        while(x < 96) {
            let v:i32 = img[fo + y * 96 + x] as i32;
            if(v > 180) {
                cnt = cnt + 1;
                if(x < x0) { x0 = x; }
                if(x > x1) { x1 = x; }
                if(y < y0) { y0 = y; }
                if(y > y1) { y1 = y; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    // default: SQUARE(2); below-count also SQUARE
    if(cnt >= 200) {
        let bw:i64 = (x1 - x0 + 1) as i64;
        let bh:i64 = (y1 - y0 + 1) as i64;
        let ba:i64 = bw * bh;
        if(ba >= 1) {
            let fill:i64 = cnt * 1000 / ba;
            if(fill >= 700) { return 0; }   // CIRCLE
            if(fill >= 550) { return 2; }   // SQUARE
            return 1;                        // TRIANGLE
        }
    }
    return 2;
}

// t3 pitchdisc: zero-crossing counts -> endpoint ratio in 0.01%.
// toneA samples [0,14400), toneB samples [16000,30400).
fn f_pitchdisc(pcm:[]u8, fo:i32) i32 {
    let na:i64 = 0;
    let nb:i64 = 0;
    let i:i32 = 1;
    let prev:i64 = f_i16(pcm, fo);
    while(i < 14400) {
        let cur:i64 = f_i16(pcm, fo + i * 2);
        if(prev <= 0) { if(cur > 0) { na = na + 1; } }
        if(prev > 0) { if(cur <= 0) { na = na + 1; } }
        prev = cur;
        i = i + 1;
    }
    i = 16001;
    prev = f_i16(pcm, fo + 32000);
    while(i < 30400) {
        let cur:i64 = f_i16(pcm, fo + i * 2);
        if(prev <= 0) { if(cur > 0) { nb = nb + 1; } }
        if(prev > 0) { if(cur <= 0) { nb = nb + 1; } }
        prev = cur;
        i = i + 1;
    }
    let r:i64 = 0;
    if(na >= 10) { r = (nb - na) * 10000 / na; }
    if(r > 50) { return 1; }    // HIGHER
    if(r < -50) { return 2; }   // LOWER
    return 0;                    // SAME
}

// t4 timbredisc: Goertzel m=1..8 spectral centroid -> class bins.
// exact 440*m Hz coefficients, N=32000.
fn f_tbcoeff(m:i32) i64 {
    if(m == 1) { return 2040; }
    if(m == 2) { return 2018; }
    if(m == 3) { return 1980; }
    if(m == 4) { return 1927; }
    if(m == 5) { return 1860; }
    if(m == 6) { return 1779; }
    if(m == 7) { return 1685; }
    return 1578;
}
fn f_tbpower(pcm:[]u8, bo:i32, m:i32) i64 {
    let c:i64 = f_tbcoeff(m);
    let s1:i64 = 0;
    let s2:i64 = 0;
    let i:i32 = 0;
    while(i < 32000) {
        let x:i64 = f_i16(pcm, bo + i * 2);
        let s0:i64 = x + c * s1 / 1024 - s2;
        s2 = s1;
        s1 = s0;
        i = i + 1;
    }
    let p:i64 = s1 * s1 + s2 * s2 - s1 * s2 * c / 1024;
    if(p < 0) { p = 0; }
    return p;
}
fn f_timbredisc(pcm:[]u8, fo:i32) i32 {
    let pw:[]u8 = nio_alloc(64);
    let i:i32 = 0;
    while(i < 64) { pw[i] = 0; i = i + 1; }
    let pmax:i64 = 1;
    let m:i32 = 1;
    while(m <= 8) {
        let p:i64 = f_tbpower(pcm, fo, m);
        // store as u64 LE at (m-1)*8
        let v:i64 = p;
        let k:i32 = 0;
        while(k < 8) {
            pw[(m - 1) * 8 + k] = (v & 255) as u8;
            v = v >> 8;
            k = k + 1;
        }
        if(p > pmax) { pmax = p; }
        m = m + 1;
    }
    let num:i64 = 0;
    let den:i64 = 0;
    m = 1;
    while(m <= 8) {
        let raw:i64 = f_u32(pw, (m - 1) * 8)
                    | (f_u32(pw, (m - 1) * 8 + 4) << 32);
        let ps:i64 = raw * 1048576 / pmax;
        num = num + (m as i64) * ps;
        den = den + ps;
        m = m + 1;
    }
    nio_free(pw);
    if(den < 1) { den = 1; }
    let cent:i64 = 440 * num / den;
    // PURE<520<DARK<950<RICH<1550<BRIGHT
    if(cent < 520) { return 0; }    // PURE
    if(cent < 950) { return 2; }    // DARK
    if(cent < 1550) { return 3; }   // RICH
    return 1;                        // BRIGHT
}

// t5 motiondir: block-match votes, 23 time points, plurality.
fn f_motdir(dx:i32, dy:i32) i32 {
    if(dx == 0) { if(dy == 0) { return 0; } }
    let ax:i32 = dx;
    if(ax < 0) { ax = 0 - ax; }
    let ay:i32 = dy;
    if(ay < 0) { ay = 0 - ay; }
    if(ax >= 2 * ay) {
        if(dx > 0) { return 3; }
        return 7;
    }
    if(ay >= 2 * ax) {
        if(dy > 0) { return 5; }
        return 1;
    }
    if(dx > 0) {
        if(dy < 0) { return 2; }
        return 4;
    }
    if(dy < 0) { return 8; }
    return 6;
}
fn f_motiondir(vid:[]u8, bo:i32) i32 {
    let votes:[]u8 = nio_alloc(36);
    let i:i32 = 0;
    while(i < 36) { votes[i] = 0; i = i + 1; }
    let t:i32 = 0;
    while(t <= 44) {
        let bdx:i32 = 0;
        let bdy:i32 = 0;
        let bsad:i64 = 9223372036854775807;
        let dy:i32 = -4;
        while(dy <= 4) {
            let dx:i32 = -4;
            while(dx <= 4) {
                let sad:i64 = 0;
                let y:i32 = 8;
                while(y < 24) {
                    let x:i32 = 8;
                    while(x < 24) {
                        let a:i32 = vid[bo + t * 1024 + y * 32 + x] as i32;
                        let bb:i32 = vid[bo + (t + 2) * 1024
                                          + (y + dy) * 32 + (x + dx)] as i32;
                        let dd:i32 = a - bb;
                        if(dd < 0) { dd = 0 - dd; }
                        sad = sad + (dd as i64);
                        x = x + 1;
                    }
                    y = y + 1;
                }
                if(sad < bsad) {
                    bsad = sad;
                    bdx = dx;
                    bdy = dy;
                }
                dx = dx + 1;
            }
            dy = dy + 1;
        }
        // generator moves the WINDOW; negate to recover window direction
        let j:i32 = f_motdir(0 - bdx, 0 - bdy);
        let cur:i64 = f_u32(votes, j * 4);
        let v:i64 = cur + 1;
        votes[j * 4] = (v & 255) as u8;
        votes[j * 4 + 1] = ((v >> 8) & 255) as u8;
        votes[j * 4 + 2] = ((v >> 16) & 255) as u8;
        votes[j * 4 + 3] = ((v >> 24) & 255) as u8;
        t = t + 2;
    }
    let best:i32 = 0;
    let bestv:i64 = -1;
    let k:i32 = 0;
    while(k < 9) {
        let v:i64 = f_u32(votes, k * 4);
        if(v > bestv) {
            bestv = v;
            best = k;
        }
        k = k + 1;
    }
    nio_free(votes);
    return best;
}

// ---------------- judgment names (must match truth vocabulary) ----------------
fn f_tname(t:i32) []u8 {
    if(t == 0) { return "colordisc"; }
    if(t == 1) { return "colorconst"; }
    if(t == 2) { return "shapetrans"; }
    if(t == 3) { return "pitchdisc"; }
    if(t == 4) { return "timbredisc"; }
    return "motiondir";
}
fn f_jname(t:i32, j:i32) []u8 {
    if(t == 0) {
        if(j == 0) { return "SAME"; }
        return "DIFFERENT";
    }
    if(t == 1) {
        if(j == 0) { return "SAME_SURFACE"; }
        return "DIFFERENT";
    }
    if(t == 2) {
        if(j == 0) { return "CIRCLE"; }
        if(j == 1) { return "TRIANGLE"; }
        return "SQUARE";
    }
    if(t == 3) {
        if(j == 0) { return "SAME"; }
        if(j == 1) { return "HIGHER"; }
        return "LOWER";
    }
    if(t == 4) {
        if(j == 0) { return "PURE"; }
        if(j == 1) { return "BRIGHT"; }
        if(j == 2) { return "DARK"; }
        return "RICH";
    }
    if(j == 0) { return "STILL"; }
    if(j == 1) { return "N"; }
    if(j == 2) { return "NE"; }
    if(j == 3) { return "E"; }
    if(j == 4) { return "SE"; }
    if(j == 5) { return "S"; }
    if(j == 6) { return "SW"; }
    if(j == 7) { return "W"; }
    return "NW";
}

// ---------------- batch driver ----------------
// batch <listfile>: one line per fixture path ->
//   "<path>\ttask=<name>\tjudgment=<JNAME>\n"
fn f_run_one(buf:[]u8, cap:i32, path:[]u8, out:[]u8) i32 {
    let n:i64 = f_readall(path, buf, cap);
    if(n < 32) { return -1; }
    if(f_u32(buf, 0) != 0x52324658) { return -2; }
    let task:i32 = f_u32(buf, 4) as i32;
    let fo:i32 = f_u32(buf, 16) as i32;
    let fl:i64 = f_u32(buf, 20);
    if(task < 0) { task = 0; }
    if(task > 5) { task = 5; }
    if((fo as i64) + fl > n) { return -3; }
    let j:i32 = 0;
    if(task == 0) { j = f_colordisc(buf, fo); }
    if(task == 1) { j = f_colorconst(buf, fo); }
    if(task == 2) { j = f_shapetrans(buf, fo); }
    if(task == 3) { j = f_pitchdisc(buf, fo); }
    if(task == 4) { j = f_timbredisc(buf, fo); }
    if(task == 5) { j = f_motiondir(buf, fo); }
    // emit: <path>\ttask=<name>\tjudgment=<JNAME>\n
    let pos:i32 = 0;
    let i:i32 = 0;
    while(i < path.len) {
        if(pos < out.len) { out[pos] = path[i]; pos = pos + 1; }
        i = i + 1;
    }
    let s1:[]u8 = "\ttask=";
    i = 0;
    while(i < s1.len) {
        if(pos < out.len) { out[pos] = s1[i]; pos = pos + 1; }
        i = i + 1;
    }
    let tn:[]u8 = f_tname(task);
    i = 0;
    while(i < tn.len) {
        if(pos < out.len) { out[pos] = tn[i]; pos = pos + 1; }
        i = i + 1;
    }
    let s2:[]u8 = "\tjudgment=";
    i = 0;
    while(i < s2.len) {
        if(pos < out.len) { out[pos] = s2[i]; pos = pos + 1; }
        i = i + 1;
    }
    let jn:[]u8 = f_jname(task, j);
    i = 0;
    while(i < jn.len) {
        if(pos < out.len) { out[pos] = jn[i]; pos = pos + 1; }
        i = i + 1;
    }
    if(pos < out.len) { out[pos] = 10; pos = pos + 1; }
    _zag_raw_syscall(1, 1, _zag_slice_ptr(out) as i64, pos as i64, 0, 0, 0);
    return 0;
}
fn f_batch(listpath:[]u8) void {
    let cap:i32 = 8388608;
    let buf:[]u8 = nio_alloc(cap);
    let lcap:i32 = 2097152;
    let lb:[]u8 = nio_alloc(lcap);
    let out:[]u8 = nio_alloc(4096);
    let n:i64 = f_readall(listpath, lb, lcap);
    if(n <= 0) {
        f_out("error=cannot read list\n");
        nio_free(buf); nio_free(lb); nio_free(out);
        return;
    }
    let start:i32 = 0;
    let i:i32 = 0;
    while(i <= (n as i32)) {
        let eol:i32 = 0;
        if(i == (n as i32)) { eol = 1; }
        if(eol == 0) { if(lb[i] == 10) { eol = 1; } }
        if(eol == 1) {
            let len:i32 = i - start;
            // strip trailing CR
            if(len > 0) { if(lb[start + len - 1] == 13) { len = len - 1; } }
            if(len > 0) {
                let plen:i32 = len;
                if(plen > 2047) { plen = 2047; }
                let p:[]u8 = nio_alloc(plen);
                let k:i32 = 0;
                while(k < plen) { p[k] = lb[start + k]; k = k + 1; }
                let rc:i32 = f_run_one(buf, cap, p, out);
                nio_free(p);
                if(rc != 0) {
                    f_out("error=fixture failed rc=");
                    let rs:[]u8 = _zag_i64_to_str(rc as i64);
                    f_out(rs);
                    nio_free(rs);
                    f_out("\n");
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    nio_free(buf); nio_free(lb); nio_free(out);
    return;
}

fn main() void {
    let mode:[]u8 = _zag_arg(1);
    if(_zag_strcmp(mode, "batch") == 1) {
        f_batch(_zag_arg(2));
        return;
    }
    if(_zag_strcmp(mode, "dstat") == 1) {
        // debug/verification mode: print the raw colorconst statistic d
        let cap:i32 = 8388608;
        let buf:[]u8 = nio_alloc(cap);
        let n:i64 = f_readall(_zag_arg(2), buf, cap);
        if(n < 32) {
            f_out("error=short read\n");
            nio_free(buf);
            return;
        }
        let fo:i32 = f_u32(buf, 16) as i32;
        let d:i64 = f_colorconst_d(buf, fo);
        let ds:[]u8 = _zag_i64_to_str(d);
        f_out(ds);
        f_out("\n");
        nio_free(ds);
        nio_free(buf);
        return;
    }
    // single-fixture mode: arg1 is the fixture path
    let path:[]u8 = mode;
    if(path.len == 0) {
        f_out("error=missing fixture path\n");
        return;
    }
    // 8MB arena (largest r2n fixture ~103KB; headroom for r2a)
    let cap:i32 = 8388608;
    let buf:[]u8 = nio_alloc(cap);
    let n:i64 = f_readall(path, buf, cap);
    if(n < 32) {
        f_out("error=short read\n");
        nio_free(buf);
        return;
    }
    if(f_u32(buf, 0) != 0x52324658) {
        f_out("error=bad magic\n");
        nio_free(buf);
        return;
    }
    let task:i32 = f_u32(buf, 4) as i32;
    let fo:i32 = f_u32(buf, 16) as i32;
    let fl:i64 = f_u32(buf, 20);
    if(task < 0) { task = 0; }
    if(task > 5) { task = 5; }
    if((fo as i64) + fl > n) {
        f_out("error=f-span out of range\n");
        nio_free(buf);
        return;
    }
    let j:i32 = 0;
    if(task == 0) { j = f_colordisc(buf, fo); }
    if(task == 1) { j = f_colorconst(buf, fo); }
    if(task == 2) { j = f_shapetrans(buf, fo); }
    if(task == 3) { j = f_pitchdisc(buf, fo); }
    if(task == 4) { j = f_timbredisc(buf, fo); }
    if(task == 5) { j = f_motiondir(buf, fo); }
    nio_free(buf);
    f_out("task=");
    f_out(f_tname(task));
    f_out(" judgment=");
    f_out(f_jname(task, j));
    f_out("\n");
    return;
}

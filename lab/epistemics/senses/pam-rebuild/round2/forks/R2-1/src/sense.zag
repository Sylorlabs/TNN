// sense.zag — PAM ROUND 2 fork R2-1: executable out-of-span warrant (HC-1).
//
// Pure-Zag deterministic percept pipeline + memory-contract gate.
// CLI:
//   sense <fixture.r2a> <full|ablated> <prev_hash_hex64> <trial_idx> <fixture_id>
// The fixture is an R2A1 container: formation span F (possibly corrupted)
// and the declared DISJOINT span G. The percept forms on F only. A bounded
// canonical program derived from the percept must PASS every test,
// including >=1 test executed on G (disjoint evidence). FAIL or UNRESOLVED
// on the disjoint test -> WITHHOLD. Ablated mode drops only the disjoint
// requirement (T2 skipped); everything else is identical.
//
// Output: machine-readable k=v lines on stdout (parsed by the eval driver).
// A sha256 hash-chained ledger link binds program, tests, and span
// declarations: chain = hex(sha256(canonical_record)); the driver verifies
// the chain independently in Python.
//
// Zero RNG. Integer math only. Deterministic given the fixture bytes.
//
// Build: znc sense.zag -o sense   (from src/, so @imports resolve)

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- LE accessors over []u8 arenas ----------------
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn get16(b:[]u8, at:i32) i64 {
    let v:i64 = (b[at] as i64) | ((b[at+1] as i64) << 8);
    if(v >= 32768) { return v - 65536; }
    return v;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    let r:i64 = x;
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- file IO ----------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// ---------------- output builders ----------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, i64s(v));
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn hex_of(b:[]u8) []u8 {
    return ns_hex(b);
}
// Own i64->decimal (no trailing newline, ever).
fn i64s(v:i64) []u8 {
    let b:[]u8 = nio_alloc(24);
    if(b.len == 0) { return ""; }
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let p:i32 = 23;
    if(x == 0) { p = p - 1; b[p] = 48; }
    while(x > 0) {
        let dig:i64 = x - (x / 10) * 10;
        p = p - 1;
        b[p] = (48 + dig) as u8;
        x = x / 10;
    }
    if(neg == 1) { p = p - 1; b[p] = 45; }
    let n:i32 = 23 - p;
    let out:[]u8 = nio_alloc(n);
    let i:i32 = 0;
    while(i < n) { out[i] = b[p + i]; i = i + 1; }
    nio_free(b);
    return out;
}

// ================= FRONT ENDS (formation + disjoint use the same code) =====
// Each: measure(span) -> judgment code j, confidence cf (0 low / 1 high),
// measure ms, ops counted. j = -1 means UNRESOLVED.
// Judgment codes: colordisc 0=SAME 1=DIFFERENT;
//   colorconst 0=SAME_SURFACE 1=DIFFERENT;
//   shapetrans 0=CIRCLE 1=TRIANGLE 2=SQUARE;
//   pitchdisc 0=SAME 1=HIGHER 2=LOWER;
//   timbredisc 0=PURE 1=DARK 2=RICH 3=BRIGHT;
//   motiondir 0..7=N NE E SE S SW W NW, 8=STILL.

fn fe_colordisc(s:[]u8, w:i32, h:i32, j:*i32, cf:*i32, ms:*i64, ops:[]u8) void {
    let hw:i32 = w / 2;
    let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
    let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < hw) {
            let o1:i32 = (y * w + x) * 3;
            let r1:i64 = s[o1] as i64;
            let g1:i64 = s[o1+1] as i64;
            let b1:i64 = s[o1+2] as i64;
            s1r = s1r + r1; s1g = s1g + g1; s1b = s1b + b1;
            let o2:i32 = (y * w + hw + x) * 3;
            let r2:i64 = s[o2] as i64;
            let g2:i64 = s[o2+1] as i64;
            let b2:i64 = s[o2+2] as i64;
            s2r = s2r + r2; s2g = s2g + g2; s2b = s2b + b2;
            x = x + 1;
        }
        y = y + 1;
    }
    let np:i64 = (hw as i64) * (h as i64);
    op_add(ops, 2 * np);
    let dr:i64 = s1r / np - s2r / np;
    let dg:i64 = s1g / np - s2g / np;
    let db:i64 = s1b / np - s2b / np;
    let dist:i64 = isqrt(dr * dr + dg * dg + db * db);
    op_add(ops, 1);
    if(dist < 25) { j.* = 0; } else { j.* = 1; }
    let mg:i64 = iabs(dist - 25);
    if(mg > 10) { cf.* = 1; } else { cf.* = 0; }
    ms.* = dist;
}

fn fe_colorconst(s:[]u8, w:i32, h:i32, j:*i32, cf:*i32, ms:*i64, ops:[]u8) void {
    // Mirrors Approach A: per-half white-patch von Kries, per-mille
    // discounted means, Euclidean distance, threshold 150.
    let hw:i32 = w / 2;
    let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
    let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
    let x1r:i64 = 0; let x1g:i64 = 0; let x1b:i64 = 0;
    let x2r:i64 = 0; let x2g:i64 = 0; let x2b:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < hw) {
            let o1:i32 = (y * w + x) * 3;
            let r1:i64 = s[o1] as i64;
            let g1:i64 = s[o1+1] as i64;
            let b1:i64 = s[o1+2] as i64;
            s1r = s1r + r1; s1g = s1g + g1; s1b = s1b + b1;
            x1r = imax(x1r, r1); x1g = imax(x1g, g1); x1b = imax(x1b, b1);
            let o2:i32 = (y * w + hw + x) * 3;
            let r2:i64 = s[o2] as i64;
            let g2:i64 = s[o2+1] as i64;
            let b2:i64 = s[o2+2] as i64;
            s2r = s2r + r2; s2g = s2g + g2; s2b = s2b + b2;
            x2r = imax(x2r, r2); x2g = imax(x2g, g2); x2b = imax(x2b, b2);
            x = x + 1;
        }
        y = y + 1;
    }
    let np:i64 = (hw as i64) * (h as i64);
    op_add(ops, 2 * np);
    let n1r:i64 = 0; let n1g:i64 = 0; let n1b:i64 = 0;
    let n2r:i64 = 0; let n2g:i64 = 0; let n2b:i64 = 0;
    if(x1r > 0) { n1r = s1r * 1000 / (np * x1r); }
    if(x1g > 0) { n1g = s1g * 1000 / (np * x1g); }
    if(x1b > 0) { n1b = s1b * 1000 / (np * x1b); }
    if(x2r > 0) { n2r = s2r * 1000 / (np * x2r); }
    if(x2g > 0) { n2g = s2g * 1000 / (np * x2g); }
    if(x2b > 0) { n2b = s2b * 1000 / (np * x2b); }
    let dr:i64 = n1r - n2r; let dg:i64 = n1g - n2g; let db:i64 = n1b - n2b;
    let dist:i64 = isqrt(dr * dr + dg * dg + db * db);
    op_add(ops, 1);
    if(dist <= 150) { j.* = 0; } else { j.* = 1; }
    let mg:i64 = iabs(dist - 150);
    if(mg > 60) { cf.* = 1; } else { cf.* = 0; }
    ms.* = dist;
}

fn fe_shapetrans(s:[]u8, w:i32, h:i32, j:*i32, cf:*i32, ms:*i64, ops:[]u8) void {
    // Largest-brightest-compact exact-color region. The shape interior is
    // exactly uniform (anti-aliased edge excluded); bg photo texture is not.
    // Among bright (mean>=120) regions with area>=40, take the most compact.
    let n:i32 = w * h;
    let visited:[]u8 = nio_alloc(n);
    let stack:[]u8 = nio_alloc(n * 2);
    if(visited.len == 0 || stack.len == 0) {
        j.* = -1; cf.* = 0; ms.* = 0; return;
    }
    let vi:i32 = 0;
    while(vi < n) { visited[vi] = 0; vi = vi + 1; }
    op_add(ops, n as i64);
    let best_q:i64 = -1;
    let best_j:i32 = -1;
    let best_a:i64 = 0;
    let seed:i32 = 0;
    while(seed < n) {
        if(visited[seed] == 0) {
            let cr:u8 = s[seed * 3];
            let cg:u8 = s[seed * 3 + 1];
            let cb:u8 = s[seed * 3 + 2];
            // flood fill
            let sp:i32 = 0;
            stack[0] = (seed & 255) as u8;
            stack[1] = ((seed / 256) & 255) as u8;
            sp = 1;
            visited[seed] = 1;
            let area:i64 = 0;
            let sx:i64 = 0; let sy:i64 = 0;
            let sxx:i64 = 0; let syy:i64 = 0;
            while(sp > 0) {
                sp = sp - 1;
                let p:i32 = (stack[sp * 2] as i32) + (stack[sp * 2 + 1] as i32) * 256;
                let px:i32 = p - (p / w) * w;
                let py:i32 = p / w;
                area = area + 1;
                sx = sx + px as i64; sy = sy + py as i64;
                sxx = sxx + (px as i64) * (px as i64);
                syy = syy + (py as i64) * (py as i64);
                // 4 neighbors
                let q0:i32 = p - 1;
                if(px > 0 && visited[q0] == 0 && s[q0*3] == cr && s[q0*3+1] == cg && s[q0*3+2] == cb) {
                    visited[q0] = 1;
                    stack[sp*2] = (q0 & 255) as u8;
                    stack[sp*2+1] = ((q0 / 256) & 255) as u8;
                    sp = sp + 1;
                }
                let q1:i32 = p + 1;
                if(px < w - 1 && visited[q1] == 0 && s[q1*3] == cr && s[q1*3+1] == cg && s[q1*3+2] == cb) {
                    visited[q1] = 1;
                    stack[sp*2] = (q1 & 255) as u8;
                    stack[sp*2+1] = ((q1 / 256) & 255) as u8;
                    sp = sp + 1;
                }
                let q2:i32 = p - w;
                if(py > 0 && visited[q2] == 0 && s[q2*3] == cr && s[q2*3+1] == cg && s[q2*3+2] == cb) {
                    visited[q2] = 1;
                    stack[sp*2] = (q2 & 255) as u8;
                    stack[sp*2+1] = ((q2 / 256) & 255) as u8;
                    sp = sp + 1;
                }
                let q3:i32 = p + w;
                if(py < h - 1 && visited[q3] == 0 && s[q3*3] == cr && s[q3*3+1] == cg && s[q3*3+2] == cb) {
                    visited[q3] = 1;
                    stack[sp*2] = (q3 & 255) as u8;
                    stack[sp*2+1] = ((q3 / 256) & 255) as u8;
                    sp = sp + 1;
                }
            }
            op_add(ops, area * 4);
            let bright:i64 = (cr as i64 + cg as i64 + cb as i64) / 3;
            if(area >= 40 && bright >= 120) {
                let vx:i64 = sxx - sx * sx / area;
                let vy:i64 = syy - sy * sy / area;
                let ss:i64 = vx + vy;
                if(ss > 0) {
                    let q:i64 = 1000000 * area * area / (6283 * ss);
                    op_add(ops, 1);
                    let cand:i32 = 1;
                    if(q >= 978) { cand = 0; }
                    else {
                        if(q >= 891) { cand = 2; }
                    }
                    if(q > best_q || (q == best_q && area > best_a)) {
                        best_q = q; best_j = cand; best_a = area;
                    }
                }
            }
        }
        seed = seed + 1;
    }
    nio_free(visited);
    nio_free(stack);
    if(best_j < 0) { j.* = -1; cf.* = 0; ms.* = 0; return; }
    j.* = best_j;
    ms.* = best_q;
    let mg:i64 = iabs(best_q - 978);
    let mg2:i64 = iabs(best_q - 891);
    if(mg2 < mg) { mg = mg2; }
    if(mg > 25) { cf.* = 1; } else { cf.* = 0; }
}

// ---------------- audio helpers ----------------
// Interpolated zero-crossing frequency. s = int16 LE, n samples.
// Returns freq in milliHz, or -1 if degenerate. Crossings located to
// 1/64 sample by linear interpolation.
fn zc_freq(s:[]u8, off:i32, n:i32, sr:i32, ops:[]u8) i64 {
    let prev:i64 = get16(s, off);
    let first:i64 = -1; let last:i64 = -1;
    let nc:i32 = 0;
    let i:i32 = 1;
    while(i < n) {
        let cur:i64 = get16(s, off + i * 2);
        if((prev <= 0 && cur > 0) || (prev >= 0 && cur < 0)) {
            let ap:i64 = iabs(prev); let ac:i64 = iabs(cur);
            let frac:i64 = 0;
            if(ap + ac > 0) { frac = 64 * ap / (ap + ac); }
            let cpos:i64 = 64 * ((i - 1) as i64) + frac;
            if(first < 0) { first = cpos; }
            last = cpos;
            nc = nc + 1;
        }
        prev = cur;
        i = i + 1;
    }
    op_add(ops, n as i64);
    if(nc < 4 || last <= first) { return -1; }
    return 1000 * (sr as i64) * 64 * ((nc - 1) as i64) / (2 * (last - first));
}

fn fe_pitchdisc(s:[]u8, n:i32, sr:i32, j:*i32, cf:*i32, ms:*i64, ops:[]u8) void {
    // Span layout: toneA [0,1000), gap [1000,1160), toneB [1160,2160).
    // Fractions of n keep F and G (same length) identical in treatment.
    let a1:i32 = n * 1000 / 2160;
    let b0:i32 = n * 1160 / 2160;
    let fa:i64 = zc_freq(s, 0, a1, sr, ops);
    let fb:i64 = zc_freq(s, b0 * 2, n - b0, sr, ops);
    if(fa <= 0 || fb <= 0) { j.* = -1; cf.* = 0; ms.* = -1; return; }
    let rel:i64 = 1000 * iabs(fb - fa) / fa;  // per-mille
    ms.* = rel;
    if(rel < 5) { j.* = 0; } else {
        if(fb > fa) { j.* = 1; } else { j.* = 2; }
    }
    let mg:i64 = iabs(rel - 5);
    if(mg > 3) { cf.* = 1; } else { cf.* = 0; }
}

// Goertzel fixed-point coefficients: 2*cos(2*pi*440*k/8000)*2048, k=1..8.
fn gcoeff(k:i32) i64 {
    if(k == 1) { return 3854; }
    if(k == 2) { return 3156; }
    if(k == 3) { return 2085; }
    if(k == 4) { return 768; }
    if(k == 5) { return -641; }
    if(k == 6) { return -1973; }
    if(k == 7) { return -3072; }
    return -3808;
}
fn goertzel_e(s:[]u8, n:i32, k:i32, ops:[]u8) i64 {
    let coeff:i64 = gcoeff(k);
    let s1:i64 = 0; let s2:i64 = 0;
    let i:i32 = 0;
    while(i < n) {
        let x:i64 = get16(s, i * 2) / 64;
        let s0:i64 = x + (coeff * s1) / 2048 - s2;
        s2 = s1; s1 = s0;
        i = i + 1;
    }
    op_add(ops, n as i64);
    let e:i64 = s1 * s1 / 1024 + s2 * s2 / 1024 - (coeff * s1 / 1024 * s2) / 2048;
    if(e < 0) { return 0; }
    return e;
}
fn timbre_class(cent:i64) i32 {
    // Canonical centroids (milliHz): PURE 440000, DARK 638400,
    // RICH 1071700, BRIGHT 1565200. Nearest wins.
    let d0:i64 = iabs(cent - 440000);
    let d1:i64 = iabs(cent - 638400);
    let d2:i64 = iabs(cent - 1071700);
    let d3:i64 = iabs(cent - 1565200);
    let best:i32 = 0; let bd:i64 = d0;
    if(d1 < bd) { best = 1; bd = d1; }
    if(d2 < bd) { best = 2; bd = d2; }
    if(d3 < bd) { best = 3; }
    return best;
}
fn fe_timbredisc(s:[]u8, n:i32, sr:i32, j:*i32, cf:*i32, ms:*i64, ops:[]u8) void {
    let f0:i64 = zc_freq(s, 0, n, sr, ops);
    if(f0 < 438000 || f0 > 442000) { j.* = -1; cf.* = 0; ms.* = f0; return; }
    let se:i64 = 0; let she:i64 = 0;
    let k:i32 = 1;
    while(k <= 8) {
        let e:i64 = goertzel_e(s, n, k, ops);
        se = se + e;
        she = she + (k as i64) * e;
        k = k + 1;
    }
    op_add(ops, 8);
    if(se <= 0) { j.* = -1; cf.* = 0; ms.* = 0; return; }
    let cent:i64 = 440000 * she / se;
    ms.* = cent;
    j.* = timbre_class(cent);
    // confidence: relative margin to the nearest decision boundary
    // boundaries at 539000, 855000, 1318000 (midpoints of canon centroids)
    let b:i64 = 539000;
    if(iabs(cent - 855000) < iabs(cent - b)) { b = 855000; }
    if(iabs(cent - 1318000) < iabs(cent - b)) { b = 1318000; }
    let mg:i64 = 1000 * iabs(cent - b) / b;
    if(mg > 80) { cf.* = 1; } else { cf.* = 0; }
}

fn dx_of(d:i32) i32 {
    if(d == 1 || d == 2 || d == 3) { return 1; }
    if(d == 5 || d == 6 || d == 7) { return -1; }
    return 0;
}
fn dy_of(d:i32) i32 {
    if(d == 3 || d == 4 || d == 5) { return 1; }
    if(d == 0 || d == 1 || d == 7) { return -1; }
    return 0;
}
fn fe_motiondir(s:[]u8, nf:i32, w:i32, h:i32, j:*i32, cf:*i32, ms:*i64, ops:[]u8) void {
    let np:i32 = w * h;
    let npairs:i64 = (nf - 1) as i64;
    let sad:i64 = 0;
    let f:i32 = 0;
    while(f < nf - 1) {
        let p:i32 = 0;
        while(p < np) {
            let a:i64 = s[f * np + p] as i64;
            let b:i64 = s[(f + 1) * np + p] as i64;
            sad = sad + iabs(a - b);
            p = p + 1;
        }
        f = f + 1;
    }
    let denom:i64 = npairs * (np as i64);
    let still:i64 = sad / denom;
    op_add(ops, denom);
    ms.* = still;
    if(still < 4) { j.* = 8; cf.* = 1; return; }
    if(still < 10) { j.* = -1; cf.* = 0; return; }
    let best:i32 = 0;
    let bestv:i64 = -1;
    let second:i64 = -1;
    let sh:i32 = 1;
    while(sh <= 2) {
        let d:i32 = 0;
        while(d < 8) {
            let ssd:i64 = 0;
            let f2:i32 = 0;
            while(f2 < nf - 1) {
                let y:i32 = 2;
                while(y < h - 2) {
                    let x:i32 = 2;
                    while(x < w - 2) {
                        let xx:i32 = x + dx_of(d) * sh;
                        let yy:i32 = y + dy_of(d) * sh;
                        let df:i64 = (s[f2 * np + y * w + x] as i64)
                                   - (s[(f2 + 1) * np + yy * w + xx] as i64);
                        ssd = ssd + df * df;
                        x = x + 1;
                    }
                    y = y + 1;
                }
                f2 = f2 + 1;
            }
            op_add(ops, npairs * ((h - 4) as i64) * ((w - 4) as i64));
            if(bestv < 0 || ssd < bestv) {
                second = bestv; bestv = ssd; best = d;
            } else {
                if(second < 0 || ssd < second) { second = ssd; }
            }
            d = d + 1;
        }
        sh = sh + 1;
    }
    op_add(ops, 16);
    j.* = best;
    if(second <= 0) { cf.* = 0; return; }
    let mg:i64 = 1000 * (second - bestv) / second;
    if(mg < 50) { j.* = -1; cf.* = 0; return; }
    if(mg > 150) { cf.* = 1; } else { cf.* = 0; }
}

// ---------------- names, programs ----------------
fn task_name(t:i32) []u8 {
    if(t == 0) { return "colordisc"; }
    if(t == 1) { return "colorconst"; }
    if(t == 2) { return "shapetrans"; }
    if(t == 3) { return "pitchdisc"; }
    if(t == 4) { return "timbredisc"; }
    return "motiondir";
}
fn jname(t:i32, j:i32) []u8 {
    if(j < 0) { return "UNRESOLVED"; }
    if(t == 0) { if(j == 0) { return "SAME"; } return "DIFFERENT"; }
    if(t == 1) { if(j == 0) { return "SAME_SURFACE"; } return "DIFFERENT"; }
    if(t == 2) {
        if(j == 0) { return "CIRCLE"; }
        if(j == 1) { return "TRIANGLE"; }
        return "SQUARE";
    }
    if(t == 3) {
        if(j == 0) { return "SAME"; }
        if(j == 1) { return "HIGHER"; }
        return "LOWER";
    }
    if(t == 4) {
        if(j == 0) { return "PURE"; }
        if(j == 1) { return "DARK"; }
        if(j == 2) { return "RICH"; }
        return "BRIGHT";
    }
    if(j == 8) { return "STILL"; }
    if(j == 0) { return "N"; } if(j == 1) { return "NE"; }
    if(j == 2) { return "E"; } if(j == 3) { return "SE"; }
    if(j == 4) { return "S"; } if(j == 5) { return "SW"; }
    if(j == 6) { return "W"; } return "NW";
}
fn prog_of(t:i32, j:i32) []u8 {
    // Canonical bounded program derived from the percept.
    if(t == 0) { return "JUDGE_COLORDISC[expect="; }
    if(t == 1) { return "JUDGE_COLORCONST[expect="; }
    if(t == 2) { return "JUDGE_SHAPETRANS[expect="; }
    if(t == 3) { return "JUDGE_PITCHDISC[expect="; }
    if(t == 4) { return "JUDGE_TIMBREDISC[expect="; }
    return "JUDGE_MOTIONDIR[expect=";
}
fn rule_of(t:i32) []u8 {
    if(t == 0) { return ";rule=rgb_dist_lt_25;budget=1000000]"; }
    if(t == 1) { return ";rule=vk_dist_le_150;budget=1000000]"; }
    if(t == 2) { return ";rule=moment_q_ge978_c_ge891_s;budget=1000000]"; }
    if(t == 3) { return ";rule=relpermille_lt_5;budget=1000000]"; }
    if(t == 4) { return ";rule=nearest_centroid;budget=1000000]"; }
    return ";rule=min_ssd_shift12;budget=1000000]";
}
fn tstr(r:i32) []u8 {
    if(r == 0) { return "PASS"; }
    if(r == 1) { return "FAIL"; }
    if(r == 2) { return "UNRESOLVED"; }
    return "SKIPPED";
}

// ---------------- measure dispatch ----------------
// Runs the task front end on a span. geom: for images w,h packed as
// w*100000+h; audio: sr; video: nf*1000000+w*1000+h.
fn measure_span(t:i32, s:[]u8, geom:i64, j:*i32, cf:*i32, ms:*i64, ops:[]u8) void {
    if(t == 0 || t == 1) {
        let w:i32 = (geom / 100000) as i32;
        let h:i32 = (geom - (w as i64) * 100000) as i32;
        if(t == 0) { fe_colordisc(s, w, h, j, cf, ms, ops); }
        else { fe_colorconst(s, w, h, j, cf, ms, ops); }
        return;
    }
    if(t == 2) {
        let w:i32 = (geom / 100000) as i32;
        let h:i32 = (geom - (w as i64) * 100000) as i32;
        fe_shapetrans(s, w, h, j, cf, ms, ops);
        return;
    }
    if(t == 3 || t == 4) {
        let sr:i32 = geom as i32;
        let n:i32 = s.len / 2;
        if(t == 3) { fe_pitchdisc(s, n, sr, j, cf, ms, ops); }
        else { fe_timbredisc(s, n, sr, j, cf, ms, ops); }
        return;
    }
    let nf:i32 = (geom / 1000000) as i32;
    let w:i32 = ((geom - (nf as i64) * 1000000) / 1000) as i32;
    let h:i32 = (geom - (nf as i64) * 1000000 - (w as i64) * 1000) as i32;
    fe_motiondir(s, nf, w, h, j, cf, ms, ops);
}
fn geom_of(t:i32, f:i32) i64 {
    // f=0 -> formation geometry, f=1 -> disjoint geometry
    if(t == 0 || t == 1) {
        if(f == 0) { return 64 * 100000 + 32; }
        return 32 * 100000 + 16;
    }
    if(t == 2) {
        if(f == 0) { return 48 * 100000 + 48; }
        return 24 * 100000 + 24;
    }
    if(t == 3) { return 4000; }
    if(t == 4) { return 8000; }
    return 8 * 1000000 + 24 * 1000 + 24;
}
fn geom_str(t:i32, f:i32) []u8 {
    if(t == 0 || t == 1) {
        if(f == 0) { return "64x32x3"; }
        return "32x16x3";
    }
    if(t == 2) {
        if(f == 0) { return "48x48x3"; }
        return "24x24x3";
    }
    if(t == 3) { return "2160s16@4kHz"; }
    if(t == 4) { return "4000s16@8kHz"; }
    return "8f24x24g";
}

// ---------------- main ----------------
fn main() i32 {
    // argc is always 0 in this runtime; read _zag_arg directly.
    let path:[]u8 = _zag_arg(1);
    let mode:[]u8 = _zag_arg(2);
    let prev:[]u8 = _zag_arg(3);
    let tidx:[]u8 = _zag_arg(4);
    let fid:[]u8 = _zag_arg(5);
    let ob:[]u8 = nio_alloc(8192);
    if(path.len == 0 || ob.len == 0) { return 1; }
    let buf:[]u8 = nio_alloc(1048576);
    if(buf.len == 0) { return 1; }
    let n:i64 = z_read(path, buf, 1048576);
    if(n < 16) { return 1; }
    // parse R2A1 container
    if(buf[0] != 82 || buf[1] != 50 || buf[2] != 65 || buf[3] != 49) { return 1; }
    let task:i32 = t_get32(buf, 4) as i32;
    if(task < 0 || task > 5) { return 1; }
    let flen:i32 = t_get32(buf, 8) as i32;
    if(flen <= 0 || 12 + flen + 4 > n as i32) { return 1; }
    let goff:i32 = 12 + flen;
    let glen:i32 = t_get32(buf, goff) as i32;
    if(glen <= 0 || goff + 4 + glen > n as i32) { return 1; }
    let fspan:[]u8 = nio_alloc(flen);
    let gspan:[]u8 = nio_alloc(glen);
    if(fspan.len == 0 || gspan.len == 0) { return 1; }
    let ci:i32 = 0;
    while(ci < flen) { fspan[ci] = buf[12 + ci]; ci = ci + 1; }
    ci = 0;
    while(ci < glen) { gspan[ci] = buf[goff + 4 + ci]; ci = ci + 1; }
    nio_free(buf);
    let op:[]u8 = nio_alloc(8);
    t_put64(op, 0, 0);

    // ---- percept formation on F only ----
    let j:i32 = -1; let cf:i32 = 0; let ms:i64 = 0;
    measure_span(task, fspan, geom_of(task, 0), &j, &cf, &ms, op);

    // ---- T1: formation test (re-derive from F) ----
    let j1:i32 = -1; let c1:i32 = 0; let m1:i64 = 0;
    measure_span(task, fspan, geom_of(task, 0), &j1, &c1, &m1, op);
    let t1:i32 = 2;
    if(j < 0 || j1 < 0) { t1 = 2; } else {
        if(j1 == j) { t1 = 0; } else { t1 = 1; }
    }

    // ---- T2: disjoint test on G (skipped in ablated mode) ----
    let t2:i32 = 3;
    let ablated:i32 = 0;
    if(_zag_strcmp(mode, "ablated") == 1) { ablated = 1; }
    if(ablated == 0) {
        let j2:i32 = -1; let c2:i32 = 0; let m2:i64 = 0;
        measure_span(task, gspan, geom_of(task, 1), &j2, &c2, &m2, op);
        t2 = 2;
        if(j >= 0 && j2 >= 0) {
            if(j2 == j) { t2 = 0; } else { t2 = 1; }
        }
    }

    // ---- gate ----
    let ops:i64 = t_get64(op, 0);
    nio_free(op);
    let decision:[]u8 = "WITHHOLD";
    let budget_ok:i32 = 1;
    if(ops > 1000000) { budget_ok = 0; }
    if(budget_ok == 1 && t1 == 0) {
        if(ablated == 1) { decision = "INSTALL"; }
        else {
            if(t2 == 0) { decision = "INSTALL"; }
        }
    }

    // ---- output ----
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "task", task_name(task));
    pos = ob_kv(ob, pos, "judgment", jname(task, j));
    if(cf == 1) { pos = ob_kv(ob, pos, "conf", "high"); }
    else { pos = ob_kv(ob, pos, "conf", "low"); }
    pos = ob_kint(ob, pos, "measure", ms);
    pos = ob_kint(ob, pos, "ops", ops);
    // canonical percept record (bytes/percept for B3)
    let ppos:i32 = 0;
    let pb:[]u8 = nio_alloc(256);
    ppos = ob_add(pb, ppos, task_name(task));
    ppos = ob_add(pb, ppos, "|");
    ppos = ob_add(pb, ppos, jname(task, j));
    ppos = ob_add(pb, ppos, "|");
    if(cf == 1) { ppos = ob_add(pb, ppos, "high"); }
    else { ppos = ob_add(pb, ppos, "low"); }
    ppos = ob_add(pb, ppos, "|");
    ppos = ob_add(pb, ppos, i64s(ms));
    pos = ob_kint(ob, pos, "percept_bytes", ppos as i64);
    nio_free(pb);
    // program
    let pr:[]u8 = nio_alloc(256);
    let pp:i32 = 0;
    pp = ob_add(pr, pp, prog_of(task, j));
    pp = ob_add(pr, pp, jname(task, j));
    pp = ob_add(pr, pp, rule_of(task));
    pos = ob_add(ob, pos, "program=");
    pos = ob_add(ob, pos, pr[0..pp]);
    pos = ob_add(ob, pos, "\n");
    nio_free(pr);
    pos = ob_add(ob, pos, "tests=T1_formation:");
    pos = ob_add(ob, pos, tstr(t1));
    pos = ob_add(ob, pos, ";T2_disjoint:");
    pos = ob_add(ob, pos, tstr(t2));
    pos = ob_add(ob, pos, "\n");
    pos = ob_kv(ob, pos, "decision", decision);
    if(budget_ok == 0) { pos = ob_kv(ob, pos, "budget", "EXCEEDED"); }

    // ---- hash-chained ledger link ----
    // canonical = R2-1|<tidx>|<fid>|<task>|<judgment>|<conf>|<ms>|
    //   <program>|<t1>|<t2>|<decision>|<fdesc>|<gdesc>|<prev>
    let lb:[]u8 = nio_alloc(2048);
    let lp:i32 = 0;
    lp = ob_add(lb, lp, "R2-1|");
    lp = ob_add(lb, lp, tidx);
    lp = ob_add(lb, lp, "|");
    lp = ob_add(lb, lp, fid);
    lp = ob_add(lb, lp, "|");
    lp = ob_add(lb, lp, task_name(task));
    lp = ob_add(lb, lp, "|");
    lp = ob_add(lb, lp, jname(task, j));
    lp = ob_add(lb, lp, "|");
    if(cf == 1) { lp = ob_add(lb, lp, "high"); } else { lp = ob_add(lb, lp, "low"); }
    lp = ob_add(lb, lp, "|");
    lp = ob_add(lb, lp, i64s(ms));
    lp = ob_add(lb, lp, "|");
    lp = ob_add(lb, lp, prog_of(task, j));
    lp = ob_add(lb, lp, jname(task, j));
    lp = ob_add(lb, lp, rule_of(task));
    lp = ob_add(lb, lp, "|");
    lp = ob_add(lb, lp, tstr(t1));
    lp = ob_add(lb, lp, "|");
    lp = ob_add(lb, lp, tstr(t2));
    lp = ob_add(lb, lp, "|");
    lp = ob_add(lb, lp, decision);
    lp = ob_add(lb, lp, "|F:off=12:len=");
    lp = ob_add(lb, lp, i64s(flen as i64));
    lp = ob_add(lb, lp, ":geom=");
    lp = ob_add(lb, lp, geom_str(task, 0));
    lp = ob_add(lb, lp, "|G:off=");
    lp = ob_add(lb, lp, i64s(goff as i64 + 4));
    lp = ob_add(lb, lp, ":len=");
    lp = ob_add(lb, lp, i64s(glen as i64));
    lp = ob_add(lb, lp, ":geom=");
    lp = ob_add(lb, lp, geom_str(task, 1));
    lp = ob_add(lb, lp, "|");
    lp = ob_add(lb, lp, prev);
    let digest:[]u8 = nio_alloc(32);
    let hrc:i32 = ns_sha256(lb[0..lp], digest);
    nio_free(lb);
    if(hrc != 0) { return 1; }
    let chain:[]u8 = hex_of(digest);
    nio_free(digest);
    pos = ob_kv(ob, pos, "chain", chain);
    nio_free(fspan);
    nio_free(gspan);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 0;
}

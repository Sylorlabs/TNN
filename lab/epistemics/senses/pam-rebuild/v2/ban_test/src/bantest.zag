// bantest.zag — PAMs v2 pointwise-revision ban trial: gate replay engine.
//
// Replays a deterministic per-trial record stream through the frozen R2-4
// gate with one of four conflict rules at permanent-conflict moments:
//
//   variant 0 (frozen):  CONFLICT_WITHHELD (baseline; fidelity check)
//   variant 1 (A):       pointwise revision — REVISED_INSTALL on any single
//                        conflicting high-conf PASS (cf2 shape)
//   variant 2 (B):       ban + historical corroboration — revise ONLY on a
//                        second same-jcode conflicting high-conf PASS within
//                        task tolerance; else CHALLENGER_PROV (cf1 shape)
//   variant 3 (C):       ban + sequential adversarial protocol (SAP):
//                        no-install for isolated high-scoring conflicts,
//                        revision only on a corroborated SEQUENCE of >=K
//                        same-jcode high-conf PASSes inside history window W,
//                        spanning >=D trials, with challenger margin bar
//                        mrgF >= T3(task); revision preserves the replaced
//                        incumbent (depth-1 stack) so a later corroborated
//                        challenge for the preserved judgment RESTORES it
//                        (repeated-false-corroboration handling).
//
// Stream line format (built by glue/build_stream.py from the frozen evidence):
//   seq|tcode|fixture|fprog|jcode|conf|fpred|meas|mrgF
// fprog/fpred are POST-DELIBERATION (final_prog/final_pred), mirroring the
// autopsy replay method. There is NO truth column: the gate cannot see it.
// Scoring joins truth back in glue/score.py.
//
// Output: dispositions to <out_path>, one per line:
//   seq|tcode|fixture|disposition|detail
// Exit 0 on success. Pure Zag, integer math only, zero RNG, deterministic.
//
// Frozen protocol constants (PREREG_BAN_TEST.md):
//   K=3 (revision needs challenger + 2 corroborators)
//   W=100 (history window, trials, from challenger first admission)
//   D=3 (minimum span, trials, first admission -> revision trigger)
//   tol: per-task corroboration tolerance (colordisc 8, colorconst 40,
//        shapetrans 60, pitchdisc 4000, timbredisc 120, motiondir 0)
//   T3: task margin bars from deliberate.zag thr_of
//       (colordisc 400, colorconst 50, shapetrans 60, pitchdisc 1500,
//        timbredisc 80, motiondir 2)

@import("R33_NATIVE_IO_V1.zag")

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn z_write_open(path:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 384, 0, 0, 0);
    nio_free(s);
    return fd;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_addn(ob:[]u8, pos:i32, s:[]u8, n:i32) i32 {
    let i:i32 = 0;
    while(i < n && i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let neg:i64 = 1;
    let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * neg;
}
// corroboration tolerance per task (frozen H2 prereg)
fn tol_of(tc:i32) i64 {
    if(tc == 0) { return 8; }
    if(tc == 1) { return 40; }
    if(tc == 2) { return 60; }
    if(tc == 3) { return 4000; }
    if(tc == 4) { return 120; }
    return 0;
}
// task T3 margin bars (frozen deliberate.zag thr_of)
fn thr_of(tc:i32) i64 {
    if(tc == 0) { return 400; }
    if(tc == 1) { return 50; }
    if(tc == 2) { return 60; }
    if(tc == 3) { return 1500; }
    if(tc == 4) { return 80; }
    return 2;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    if(a1.len == 0 || a2.len == 0 || a3.len == 0) {
        return 1;
    }
    let vb:[]u8 = nio_alloc(16);
    let vn:i32 = 0;
    while(vn < a2.len && vn < 15) { vb[vn] = a2[vn]; vn = vn + 1; }
    let variant:i64 = atoi(vb, vn);
    nio_free(vb);
    if(variant < 0 || variant > 4) { return 1; }
    let fmax:i32 = 8388608;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    // per-task state: provisional + permanent slots (frozen gate)
    let prov_on:[]u8 = nio_alloc(48);
    let prov_j:[]u8 = nio_alloc(48);
    let prov_m:[]u8 = nio_alloc(48);
    let prov_s:[]u8 = nio_alloc(48);
    let perm_on:[]u8 = nio_alloc(48);
    let perm_j:[]u8 = nio_alloc(48);
    let perm_m:[]u8 = nio_alloc(48);
    let perm_s:[]u8 = nio_alloc(48);
    // negative evidence: 256 (jcode, measure) pairs per task
    let neg_j:[]u8 = nio_alloc(6 * 256 * 8);
    let neg_m:[]u8 = nio_alloc(6 * 256 * 8);
    let neg_n:[]u8 = nio_alloc(48);
    // challenger slot per task (variants B and C)
    let ch_on:[]u8 = nio_alloc(48);
    let ch_j:[]u8 = nio_alloc(48);
    let ch_m:[]u8 = nio_alloc(48);
    let ch_s:[]u8 = nio_alloc(48);
    let ch_n:[]u8 = nio_alloc(48);
    let ch_mrg:[]u8 = nio_alloc(48);
    // preserved pre-revision incumbent, depth 1 (variant C rollback)
    let pv_on:[]u8 = nio_alloc(48);
    let pv_j:[]u8 = nio_alloc(48);
    let pv_m:[]u8 = nio_alloc(48);
    let pv_s:[]u8 = nio_alloc(48);
    let t:i32 = 0;
    while(t < 6) {
        t_put64(prov_on, t * 8, 0);
        t_put64(perm_on, t * 8, 0);
        t_put64(neg_n, t * 8, 0);
        t_put64(ch_on, t * 8, 0);
        t_put64(ch_n, t * 8, 0);
        t_put64(ch_mrg, t * 8, 0);
        t_put64(pv_on, t * 8, 0);
        t = t + 1;
    }
    let ob:[]u8 = nio_alloc(4194304);
    if(ob.len == 0) { return 1; }
    let opos:i32 = 0;
    let hb:[]u8 = nio_alloc(4096);
    let fb2:[]u8 = nio_alloc(512);
    let fxb:[]u8 = nio_alloc(512);
    let fnum:[]u8 = nio_alloc(64);
    let tmp:[]u8 = nio_alloc(96);
    let p:i64 = 0;
    let trials:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 4000) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let nf:i32 = field(line, llen, 0, fnum);
            let seq:i64 = atoi(fnum, nf);
            nf = field(line, llen, 1, fnum);
            let tc:i32 = atoi(fnum, nf) as i32;
            let fxlen:i32 = field(line, llen, 2, fxb);
            nf = field(line, llen, 3, fnum);
            let pr:i32 = atoi(fnum, nf) as i32;
            nf = field(line, llen, 4, fnum);
            let jc:i64 = atoi(fnum, nf);
            nf = field(line, llen, 5, fnum);
            let conf:i64 = atoi(fnum, nf);
            nf = field(line, llen, 6, fnum);
            let pred:i64 = atoi(fnum, nf);
            nf = field(line, llen, 7, fnum);
            let meas:i64 = atoi(fnum, nf);
            nf = field(line, llen, 8, fnum);
            let mrg:i64 = atoi(fnum, nf);
            let disp:[]u8 = "";
            let det:[]u8 = "";
            if(tc >= 0 && tc < 6 && (pr == 0 || pr == 1 || pr == 2)) {
                let tol:i64 = tol_of(tc);
                let nm:i32 = 0;
                let nn:i64 = t_get64(neg_n, tc * 8);
                let k:i64 = 0;
                while(k < nn) {
                    if(t_get64(neg_j, (tc * 256 + k as i32) * 8) == jc
                       && iabs(t_get64(neg_m, (tc * 256 + k as i32) * 8) - meas) <= tol) {
                        nm = 1;
                        break;
                    }
                    k = k + 1;
                }
                if(pr == 1) {
                    if(nm == 0 && nn < 256) {
                        t_put64(neg_j, (tc * 256 + nn as i32) * 8, jc);
                        t_put64(neg_m, (tc * 256 + nn as i32) * 8, meas);
                        t_put64(neg_n, tc * 8, nn + 1);
                    }
                    disp = "NEGATIVE_EVIDENCE";
                    if(nm == 1) { det = "dup"; } else { det = "stored"; }
                } else if(pr == 2) {
                    if(nm == 1) {
                        disp = "SUPPRESSED";
                        det = "neg";
                    } else {
                        disp = "WITHHELD";
                        det = "unresolved";
                    }
                } else {
                    if(pred == 0) {
                        disp = "WITHHELD";
                        det = "pred0";
                    } else if(nm == 1) {
                        disp = "SUPPRESSED";
                        det = "neg";
                    } else if(t_get64(perm_on, tc * 8) == 1) {
                        let pj:i64 = t_get64(perm_j, tc * 8);
                        let pm:i64 = t_get64(perm_m, tc * 8);
                        if(jc == pj && iabs(pm - meas) <= tol) {
                            disp = "CORROBORATED";
                            det = "perm";
                        } else if(jc != pj) {
                            // ---- permanent-conflict branch: variant rules ----
                            let ps:i64 = t_get64(perm_s, tc * 8);
                            if(variant == 0) {
                                disp = "CONFLICT_WITHHELD";
                                let q:i32 = ob_add(tmp, 0, "perm_seq=");
                                q = ob_add(tmp, q, _zag_i64_to_str(ps));
                                let c2:i32 = 0;
                                while(c2 < q) { fb2[256 + c2] = tmp[c2]; c2 = c2 + 1; }
                                det = fb2[256..256 + q];
                            } else if(variant == 1) {
                                // A: pointwise revision on any single
                                // conflicting high-conf PASS.
                                if(conf >= 700) {
                                    t_put64(perm_j, tc * 8, jc);
                                    t_put64(perm_m, tc * 8, meas);
                                    t_put64(perm_s, tc * 8, seq);
                                    disp = "REVISED_INSTALL";
                                    let q:i32 = ob_add(tmp, 0, "revised_old=");
                                    q = ob_add(tmp, q, _zag_i64_to_str(ps));
                                    let c2:i32 = 0;
                                    while(c2 < q) { fb2[256 + c2] = tmp[c2]; c2 = c2 + 1; }
                                    det = fb2[256..256 + q];
                                } else {
                                    disp = "CONFLICT_WITHHELD";
                                    let q:i32 = ob_add(tmp, 0, "perm_seq=");
                                    q = ob_add(tmp, q, _zag_i64_to_str(ps));
                                    let c2:i32 = 0;
                                    while(c2 < q) { fb2[256 + c2] = tmp[c2]; c2 = c2 + 1; }
                                    det = fb2[256..256 + q];
                                }
                            } else if(variant == 2) {
                                // B: ban + historical corroboration (cf1).
                                if(conf >= 700 && t_get64(ch_on, tc * 8) == 1
                                   && t_get64(ch_j, tc * 8) == jc
                                   && iabs(t_get64(ch_m, tc * 8) - meas) <= tol) {
                                    t_put64(perm_j, tc * 8, jc);
                                    t_put64(perm_m, tc * 8, meas);
                                    t_put64(perm_s, tc * 8, seq);
                                    t_put64(ch_on, tc * 8, 0);
                                    disp = "REVISED_INSTALL";
                                    let q:i32 = ob_add(tmp, 0, "revised_old=");
                                    q = ob_add(tmp, q, _zag_i64_to_str(ps));
                                    let c2:i32 = 0;
                                    while(c2 < q) { fb2[256 + c2] = tmp[c2]; c2 = c2 + 1; }
                                    det = fb2[256..256 + q];
                                } else if(conf >= 700) {
                                    t_put64(ch_on, tc * 8, 1);
                                    t_put64(ch_j, tc * 8, jc);
                                    t_put64(ch_m, tc * 8, meas);
                                    t_put64(ch_s, tc * 8, seq);
                                    disp = "CHALLENGER_PROV";
                                    det = "stored";
                                } else {
                                    disp = "CONFLICT_WITHHELD";
                                    let q:i32 = ob_add(tmp, 0, "perm_seq=");
                                    q = ob_add(tmp, q, _zag_i64_to_str(ps));
                                    let c2:i32 = 0;
                                    while(c2 < q) { fb2[256 + c2] = tmp[c2]; c2 = c2 + 1; }
                                    det = fb2[256..256 + q];
                                }
                            } else if(variant == 3 || variant == 4) {
                                // C / V4-exploratory: ban + sequential
                                // adversarial protocol. K=3, W=100, D=3,
                                // margin mrgF >= T3(tc). V4 (EXPLORATORY, not
                                // preregistered): two-tier -- isolated
                                // high-scoring conflicts admitted as
                                // CHALLENGER_PROV instead of WITHHELD.
                                let chon:i64 = t_get64(ch_on, tc * 8);
                                let corrob:i32 = 0;
                                if(conf >= 700 && chon == 1
                                   && t_get64(ch_j, tc * 8) == jc
                                   && iabs(t_get64(ch_m, tc * 8) - meas) <= tol
                                   && seq - t_get64(ch_s, tc * 8) <= 100) {
                                    corrob = 1;
                                }
                                if(corrob == 1) {
                                    let cn:i64 = t_get64(ch_n, tc * 8) + 1;
                                    t_put64(ch_n, tc * 8, cn);
                                    let cm:i64 = t_get64(ch_m, tc * 8);
                                    let nm2:i64 = (cm * (cn - 1) + meas) / cn;
                                    t_put64(ch_m, tc * 8, nm2);
                                    if(mrg > t_get64(ch_mrg, tc * 8)) {
                                        t_put64(ch_mrg, tc * 8, mrg);
                                    }
                                    let span:i64 = seq - t_get64(ch_s, tc * 8);
                                    if(cn >= 3 && t_get64(ch_mrg, tc * 8) >= thr_of(tc) && span >= 3) {
                                        // revision; rollback check against
                                        // the preserved pre-revision claim.
                                        let oldj:i64 = t_get64(perm_j, tc * 8);
                                        let oldm:i64 = t_get64(perm_m, tc * 8);
                                        t_put64(perm_j, tc * 8, jc);
                                        t_put64(perm_m, tc * 8, meas);
                                        t_put64(perm_s, tc * 8, seq);
                                        t_put64(ch_on, tc * 8, 0);
                                        if(t_get64(pv_on, tc * 8) == 1 && t_get64(pv_j, tc * 8) == jc) {
                                            disp = "RESTORED_INSTALL";
                                            let q:i32 = ob_add(tmp, 0, "restored_seq=");
                                            q = ob_add(tmp, q, _zag_i64_to_str(t_get64(pv_s, tc * 8)));
                                            let c2:i32 = 0;
                                            while(c2 < q) { fb2[256 + c2] = tmp[c2]; c2 = c2 + 1; }
                                            det = fb2[256..256 + q];
                                        } else {
                                            disp = "REVISED_INSTALL";
                                            let q:i32 = ob_add(tmp, 0, "revised_old=");
                                            q = ob_add(tmp, q, _zag_i64_to_str(ps));
                                            let c2:i32 = 0;
                                            while(c2 < q) { fb2[256 + c2] = tmp[c2]; c2 = c2 + 1; }
                                            det = fb2[256..256 + q];
                                        }
                                        t_put64(pv_on, tc * 8, 1);
                                        t_put64(pv_j, tc * 8, oldj);
                                        t_put64(pv_m, tc * 8, oldm);
                                        t_put64(pv_s, tc * 8, ps);
                                    } else {
                                        disp = "CHALLENGER_PROV";
                                        if(cn == 2) { det = "pair"; } else { det = "bar_pending"; }
                                    }
                                } else if(conf >= 700) {
                                    // isolated high-scoring conflict:
                                    // stored as challenger; C: NO install,
                                    // V4-exploratory: CHALLENGER_PROV.
                                    t_put64(ch_on, tc * 8, 1);
                                    t_put64(ch_j, tc * 8, jc);
                                    t_put64(ch_m, tc * 8, meas);
                                    t_put64(ch_s, tc * 8, seq);
                                    t_put64(ch_n, tc * 8, 1);
                                    t_put64(ch_mrg, tc * 8, mrg);
                                    if(variant == 4) {
                                        disp = "CHALLENGER_PROV";
                                        det = "stored";
                                    } else {
                                        disp = "WITHHELD";
                                        det = "challenge_isolated";
                                    }
                                } else {
                                    disp = "CONFLICT_WITHHELD";
                                    let q:i32 = ob_add(tmp, 0, "perm_seq=");
                                    q = ob_add(tmp, q, _zag_i64_to_str(ps));
                                    let c2:i32 = 0;
                                    while(c2 < q) { fb2[256 + c2] = tmp[c2]; c2 = c2 + 1; }
                                    det = fb2[256..256 + q];
                                }
                            }
                        } else {
                            disp = "CORROBORATED";
                            det = "perm-measure-diff";
                        }
                    } else if(t_get64(prov_on, tc * 8) == 1) {
                        let pj:i64 = t_get64(prov_j, tc * 8);
                        let pm:i64 = t_get64(prov_m, tc * 8);
                        if(jc == pj && iabs(pm - meas) <= tol) {
                            t_put64(perm_on, tc * 8, 1);
                            t_put64(perm_j, tc * 8, jc);
                            t_put64(perm_m, tc * 8, meas);
                            t_put64(perm_s, tc * 8, seq);
                            t_put64(prov_on, tc * 8, 0);
                            disp = "PERMANENT_INSTALL";
                            det = "corroborated";
                        } else if(jc != pj) {
                            let old:i64 = t_get64(prov_s, tc * 8);
                            t_put64(prov_j, tc * 8, jc);
                            t_put64(prov_m, tc * 8, meas);
                            t_put64(prov_s, tc * 8, seq);
                            disp = "PROVISIONAL_INSTALL";
                            let q:i32 = ob_add(tmp, 0, "reversed_old=");
                            q = ob_add(tmp, q, _zag_i64_to_str(old));
                            let c2:i32 = 0;
                            while(c2 < q) { fb2[256 + c2] = tmp[c2]; c2 = c2 + 1; }
                            det = fb2[256..256 + q];
                        } else {
                            disp = "CORROBORATED";
                            det = "prov-measure-diff";
                        }
                    } else {
                        t_put64(prov_on, tc * 8, 1);
                        t_put64(prov_j, tc * 8, jc);
                        t_put64(prov_m, tc * 8, meas);
                        t_put64(prov_s, tc * 8, seq);
                        disp = "PROVISIONAL_INSTALL";
                        det = "new";
                    }
                }
            } else {
                disp = "WITHHELD";
                det = "bad-record";
            }
            opos = ob_add(ob, opos, _zag_i64_to_str(seq));
            opos = ob_add(ob, opos, "|");
            opos = ob_add(ob, opos, _zag_i64_to_str(tc as i64));
            opos = ob_add(ob, opos, "|");
            opos = ob_addn(ob, opos, fxb, fxlen);
            opos = ob_add(ob, opos, "|");
            opos = ob_add(ob, opos, disp);
            opos = ob_add(ob, opos, "|");
            opos = ob_add(ob, opos, det);
            opos = ob_add(ob, opos, "\n");
            trials = trials + 1;
        }
        p = le + 1;
    }
    let wfd:i64 = z_write_open(a3);
    if(wfd < 0) { return 1; }
    let woff:i32 = 0;
    let wok:i32 = 1;
    while(woff < opos) {
        let wlen:i32 = opos - woff;
        if(wlen > 1048576) { wlen = 1048576; }
        if(nio_write_all(wfd, ob[woff..woff + wlen]) != wlen as i64) {
            wok = 0;
            break;
        }
        woff = woff + wlen;
    }
    nio_close(wfd);
    if(wok == 0) { return 1; }
    let sb:[]u8 = nio_alloc(128);
    let sp2:i32 = ob_add(sb, 0, "bantest: variant=");
    sp2 = ob_add(sb, sp2, _zag_i64_to_str(variant));
    sp2 = ob_add(sb, sp2, " trials=");
    sp2 = ob_add(sb, sp2, _zag_i64_to_str(trials));
    sp2 = ob_add(sb, sp2, "\n");
    nio_write_all(2, sb[0..sp2]);
    nio_free(sb);
    return 0;
}

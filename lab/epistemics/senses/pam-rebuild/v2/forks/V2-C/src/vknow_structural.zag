// vknow.zag — V2-C structural trap detectors (standalone module).
// Generated from gen_vknow.py; imports provided by vsense_c.zag.

// ================= V2-C vknow: structural trap detectors =====================
// PREREG_V2-C_AMEND1.md §A1.3. Pure functions of the F span. Zero RNG.
// Bit assignments (frozen):
//   bit0  (1)    D1  GLIDE        pitchdisc   PTC-2
//   bit1  (2)    D2  HARMINC      pitchdisc   PTC-3 / red-team
//   bit2  (4)    D3  CCN1-TEXCORR colorconst  CCN-1
//   bit3  (8)    D3b CCN1-THR     colorconst  CCN-1 (sim form, fixed dims)
//   bit4  (16)   D4  COL2-TEXCORR colordisc   COL-2
//   bit5  (32)   D5  CCN2-MIXED   colorconst  CCN-2
//   bit6  (64)   D6  MOT2-FLICKER motiondir   MOT-2
//   bit7  (128)  D7  MOT3-CAMO    motiondir   MOT-3
//   bit8  (256)  D8  SHP1-OCCLUDE shapetrans  SHP-1
//   bit9  (512)  D9  TMB1-BOUND   timbredisc  TMB-1
//   bit10 (1024) D10 SHP3-LOWCON  shapetrans  SHP-3
//   bit11 (2048) D11 TMB2-HARM    timbredisc  TMB-2
// Threshold accessors below; frozen values in
// docs/lab/senses/pam-rebuild/v2/forks/V2-C/src/CALIBRATION_C_ZAG.md.

// ---- threshold accessors (frozen; see CALIBRATION_C_ZAG.md) ----
fn thr_glide() i64 { return 10; }           // D1: 1000*|flate-fearly|/fearly
fn thr_texcorr_ccn1() i64 { return 9500; } // D3: Pearson r x10000
fn thr_ccn1b_ratio() i64 { return 1000000; } // D3b: DISABLED (FA on NOISE; D3 covers)
fn thr_ccn1b_bright() i64 { return 85; }  // D3b: DISABLED
fn thr_drift() i64 { return 1000000; }     // D4: DISABLED (no 0-FA form; 313 baseline)
fn thr_texvar() i64 { return 50; }         // D4: grayscale variance
fn thr_texcorr_col2() i64 { return 9900; } // D4: Pearson r x10000
fn thr_ccn2() i64 { return 15; }            // D5: warmth |r-b| threshold
fn thr_mot2_flick() i64 { return 1000000; } // D6: DISABLED (0 baseline; no 0-FA form)
fn thr_mot2_dir() i64 { return 1000000; }  // D6: DISABLED
fn thr_mot3_lo() i64 { return 1000000; }   // D7: DISABLED (0 baseline; no 0-FA form)
fn thr_mot3_hi() i64 { return 1000000; }   // D7: DISABLED
fn thr_shp1_run() i64 { return 1000000; }  // D8: DISABLED (FA on NOISE; 0 baseline)
fn thr_tmb1_pct() i64 { return 0; }         // D9: DISABLED (FA on NOISE; 6 baseline)
fn thr_shp3_con() i64 { return 30; }       // D10: luminance range
fn thr_tmb2_pct() i64 { return 150; }      // D11: 100*E2/E1

// ---- shared: Pearson r x10000 between L/R 64x64 panels (grayscale) ----
// 128x64 RGB F span @8. Returns -20000 on bad layout.
fn vknow_texcorr(buf:[]u8, n:i32) i64 {
    if(n < 8 + 128*64*3) { return -20000; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return -20000; }
    let cnt:i64 = 4096;
    let sa:i64 = 0;
    let sb:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let oa:i32 = 8 + (y * 128 + x) * 3;
            let ob:i32 = 8 + (y * 128 + x + 64) * 3;
            sa = sa + ((buf[oa] as i64) + (buf[oa+1] as i64) + (buf[oa+2] as i64)) / 3;
            sb = sb + ((buf[ob] as i64) + (buf[ob+1] as i64) + (buf[ob+2] as i64)) / 3;
            x = x + 1;
        }
        y = y + 1;
    }
    let ma:i64 = sa / cnt;
    let mb:i64 = sb / cnt;
    let da:i64 = 0;
    let db:i64 = 0;
    let nab:i64 = 0;
    let y2:i32 = 0;
    while(y2 < 64) {
        let x2:i32 = 0;
        while(x2 < 64) {
            let oa:i32 = 8 + (y2 * 128 + x2) * 3;
            let ob:i32 = 8 + (y2 * 128 + x2 + 64) * 3;
            let ga:i64 = ((buf[oa] as i64) + (buf[oa+1] as i64) + (buf[oa+2] as i64)) / 3 - ma;
            let gb:i64 = ((buf[ob] as i64) + (buf[ob+1] as i64) + (buf[ob+2] as i64)) / 3 - mb;
            da = da + ga * ga;
            db = db + gb * gb;
            nab = nab + ga * gb;
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    if(da <= 0 || db <= 0) { return -20000; }
    let den:i64 = isqrt(da * db);
    if(den <= 0) { return -20000; }
    return nab * 10000 / den;
}

// ---- shared: 10*max/min channel mean over x in [x0,x1), 128x64 RGB ----
fn illum_ratio10(buf:[]u8, x0:i32, x1:i32) i64 {
    let sr:i64 = 0;
    let sg:i64 = 0;
    let sb:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = x0;
        while(x < x1) {
            let o:i32 = 8 + (y * 128 + x) * 3;
            sr = sr + (buf[o] as i64);
            sg = sg + (buf[o+1] as i64);
            sb = sb + (buf[o+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    if(cnt == 0) { return -1; }
    let mr:i64 = sr / cnt;
    let mg:i64 = sg / cnt;
    let mb:i64 = sb / cnt;
    let mx:i64 = mr;
    let mn:i64 = mr;
    if(mg > mx) { mx = mg; }
    if(mg < mn) { mn = mg; }
    if(mb > mx) { mx = mb; }
    if(mb < mn) { mn = mb; }
    if(mn <= 0) { return -1; }
    return mx * 10 / mn;
}

// ---- D1 GLIDE: max over tones of 1000*|flate-fearly|/fearly; -1 on bad ----
fn m1_glide(buf:[]u8, n:i32, op:[]u8) i64 {
    if(n < 8) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let tone:i32 = (cnt * 10 / 22) as i32;
    let gap:i32 = cnt - 2 * tone;
    if(tone < 6024 || gap < 0) { return -1; }
    let aoff:i32 = 8;
    let boff:i32 = 8 + (tone + gap) * 2;
    let best:i64 = 0;
    let fa_e:i64 = f0_h2(buf, aoff, 1024, sr, op);
    let fa_l:i64 = f0_h2(buf, aoff + (tone - 1024) * 2, 1024, sr, op);
    if(fa_e > 0 && fa_l > 0) {
        let ga:i64 = iabs(fa_l - fa_e) * 1000 / fa_e;
        if(ga > best) { best = ga; }
    }
    let fb_e:i64 = f0_h2(buf, boff, 1024, sr, op);
    let fb_l:i64 = f0_h2(buf, boff + (tone - 1024) * 2, 1024, sr, op);
    if(fb_e > 0 && fb_l > 0) {
        let gb:i64 = iabs(fb_l - fb_e) * 1000 / fb_e;
        if(gb > best) { best = gb; }
    }
    return best;
}

fn d1_glide(buf:[]u8, n:i32, op:[]u8) i32 {
    let m:i64 = m1_glide(buf, n, op);
    if(m < 0) { return 0; }
    if(m > thr_glide()) { return 1; }
    return 0;
}

// ---- D2 HARMINC: spectral-peak vs f0_h2 disagreement ----
// single-frequency DFT magnitude (squared, normalized); 0 on bad
fn dft_mag(buf:[]u8, off:i32, w:i32, sr:i64, fm:i64, op:[]u8) i64 {
    if(fm <= 0 || w < 64) { return 0; }
    let pinc:i64 = fm * 4294967296 / (1000 * sr);
    if(pinc <= 0) { return 0; }
    let re:i64 = 0;
    let im:i64 = 0;
    let i:i32 = 0;
    while(i < w) {
        let s:i64 = t_geti16(buf, off + i * 2);
        let p:i64 = ((i as i64) * pinc) & 4294967295;
        re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
        im = im + s * ng_sin1024(p) / 1024;
        i = i + 1;
    }
    return (re * re + im * im) / 1048576;
}

// argmax of DFT magnitude over 1/6-octave grid 100..1500 Hz; milli-Hz
fn spec_peak(buf:[]u8, off:i32, w:i32, sr:i64, op:[]u8) i64 {
    let f:i64 = 100000;
    let best_f:i64 = 0;
    let best_m:i64 = -1;
    let it:i32 = 0;
    while(f <= 1500000 && it < 100) {
        let m:i64 = dft_mag(buf, off, w, sr, f, op);
        if(m > best_m) { best_m = m; best_f = f; }
        f = f * 1126 / 1000;
        it = it + 1;
    }
    return best_f;
}

// is the spectral peak at an integer harmonic (1..4) of f0? (+-10%)
fn peak_consistent(pk:i64, f0:i64) i32 {
    let r:i64 = pk * 100 / f0;
    if(r >= 90 && r <= 110) { return 1; }
    if(r >= 190 && r <= 210) { return 1; }
    if(r >= 290 && r <= 310) { return 1; }
    if(r >= 390 && r <= 410) { return 1; }
    return 0;
}

// 0=consistent, 1=inconsistent, -1=bad layout
fn m2_harminc(buf:[]u8, n:i32, op:[]u8) i64 {
    if(n < 8) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let tone:i32 = (cnt * 10 / 22) as i32;
    let gap:i32 = cnt - 2 * tone;
    if(tone < 6024 || gap < 0) { return -1; }
    let inc:i64 = 0;
    let got:i32 = 0;
    let fa:i64 = f0_h2(buf, 8, 1024, sr, op);
    let pa:i64 = spec_peak(buf, 8, 1024, sr, op);
    if(fa > 0 && pa > 0) {
        got = 1;
        if(peak_consistent(pa, fa) == 0) { inc = 1; }
    }
    let boff:i32 = 8 + (tone + gap) * 2;
    let fb:i64 = f0_h2(buf, boff, 1024, sr, op);
    let pb:i64 = spec_peak(buf, boff, 1024, sr, op);
    if(fb > 0 && pb > 0) {
        got = 1;
        if(peak_consistent(pb, fb) == 0) { inc = 1; }
    }
    if(got == 0) { return -1; }
    return inc;
}

fn d2_harminc(buf:[]u8, n:i32, op:[]u8) i32 {
    let m:i64 = m2_harminc(buf, n, op);
    if(m > 0) { return 1; }
    return 0;
}

// ---- D3 CCN1-TEXCORR: opposite extreme casts + same texture ----
// panel1 xblue vs panel2 xred (or vice versa); 10*dom/sub ratios; -1 bad
// returns 1 if opposite casts detected, else 0
fn m3_opposite(buf:[]u8, n:i32) i64 {
    if(n < 8 + 128*64*3) { return -1; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return -1; }
    // mean RGB per panel
    let r1:i64 = 0; let g1:i64 = 0; let b1:i64 = 0;
    let r2:i64 = 0; let g2:i64 = 0; let b2:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let o1:i32 = 8 + (y * 128 + x) * 3;
            let o2:i32 = 8 + (y * 128 + x + 64) * 3;
            r1 = r1 + (buf[o1] as i64); g1 = g1 + (buf[o1+1] as i64); b1 = b1 + (buf[o1+2] as i64);
            r2 = r2 + (buf[o2] as i64); g2 = g2 + (buf[o2+1] as i64); b2 = b2 + (buf[o2+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    let mr1:i64 = r1 / cnt; let mg1:i64 = g1 / cnt; let mb1:i64 = b1 / cnt;
    let mr2:i64 = r2 / cnt; let mg2:i64 = g2 / cnt; let mb2:i64 = b2 / cnt;
    // blue-dominant: b > 2*r and b > 2*g; red-dominant: r > 2*b and r > 2*g
    let blue1:i32 = 0;
    if(mb1 > 2 * mr1 && mb1 > 2 * mg1) { blue1 = 1; }
    let red1:i32 = 0;
    if(mr1 > 2 * mb1 && mr1 > 2 * mg1) { red1 = 1; }
    let blue2:i32 = 0;
    if(mb2 > 2 * mr2 && mb2 > 2 * mg2) { blue2 = 1; }
    let red2:i32 = 0;
    if(mr2 > 2 * mb2 && mr2 > 2 * mg2) { red2 = 1; }
    if((blue1 == 1 && red2 == 1) || (red1 == 1 && blue2 == 1)) { return 1; }
    return 0;
}

fn d3_ccn1(buf:[]u8, n:i32) i32 {
    let o:i64 = m3_opposite(buf, n);
    if(o < 0) { return 0; }
    if(o == 0) { return 0; }
    let c:i64 = vknow_texcorr(buf, n);
    if(c < thr_texcorr_ccn1()) { return 0; }
    return 1;
}

// ---- D3b CCN1-THR (sim form, corrected to 128x64) ----
fn panel_extreme_dark(buf:[]u8, x0:i32, x1:i32) i32 {
    let sr:i64 = 0;
    let sg:i64 = 0;
    let sb:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = x0;
        while(x < x1) {
            let o:i32 = 8 + (y * 128 + x) * 3;
            sr = sr + (buf[o] as i64);
            sg = sg + (buf[o+1] as i64);
            sb = sb + (buf[o+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    if(cnt == 0) { return 0; }
    let mr:i64 = sr / cnt;
    let mg:i64 = sg / cnt;
    let mb:i64 = sb / cnt;
    let mx:i64 = mr;
    let mn:i64 = mr;
    if(mg > mx) { mx = mg; }
    if(mg < mn) { mn = mg; }
    if(mb > mx) { mx = mb; }
    if(mb < mn) { mn = mb; }
    if(mn <= 0) { return 0; }
    let bright:i64 = (mr + mg + mb) / 3;
    if(mx * 10 / mn > thr_ccn1b_ratio() && bright < thr_ccn1b_bright()) { return 1; }
    return 0;
}

fn d3b_ccn1(buf:[]u8, n:i32) i32 {
    if(n < 8 + 128*64*3) { return 0; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return 0; }
    if(panel_extreme_dark(buf, 0, 64) == 1) { return 1; }
    if(panel_extreme_dark(buf, 64, 128) == 1) { return 1; }
    return 0;
}

// ---- D4 COL2-TEXCORR ----
// 1000*L1(panel means)/brightness between L/R panels; -1 on bad
fn m4_drift(buf:[]u8, n:i32) i64 {
    // Warm/cool opposition between panel1 and panel2 (COL-2 signature).
    // Returns 1 if opposite warm/cool with |warmth|>thr, else 0. -1 on bad.
    // Warmth = mean(r-b). Panel1 warm (r>b) vs panel2 cool (b>r), or vice versa.
    if(n < 8 + 128*64*3) { return -1; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return -1; }
    let r1:i64 = 0; let b1:i64 = 0;
    let r2:i64 = 0; let b2:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let o1:i32 = 8 + (y * 128 + x) * 3;
            let o2:i32 = 8 + (y * 128 + x + 64) * 3;
            r1 = r1 + (buf[o1] as i64); b1 = b1 + (buf[o1+2] as i64);
            r2 = r2 + (buf[o2] as i64); b2 = b2 + (buf[o2+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    let w1:i64 = r1 / cnt - b1 / cnt;
    let w2:i64 = r2 / cnt - b2 / cnt;
    let thr:i64 = thr_drift();
    if(w1 > thr && w2 < 0 - thr) { return 1; }
    if(w2 > thr && w1 < 0 - thr) { return 1; }
    return 0;
}

// grayscale variance over panel L; -1 on bad
fn m4_texvar(buf:[]u8, n:i32) i64 {
    if(n < 8 + 128*64*3) { return -1; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return -1; }
    let cnt:i64 = 4096;
    let s:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let o:i32 = 8 + (y * 128 + x) * 3;
            s = s + ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
            x = x + 1;
        }
        y = y + 1;
    }
    let m:i64 = s / cnt;
    let v:i64 = 0;
    let y2:i32 = 0;
    while(y2 < 64) {
        let x2:i32 = 0;
        while(x2 < 64) {
            let o:i32 = 8 + (y2 * 128 + x2) * 3;
            let g:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3 - m;
            v = v + g * g;
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    return v / cnt;
}

fn d4_col2(buf:[]u8, n:i32) i32 {
    let m:i64 = m4_drift(buf, n);
    if(m < 0) { return 0; }
    if(m == 0) { return 0; }
    // m==1 means opposite warm/cool detected; also require low texture var
    let v:i64 = m4_texvar(buf, n);
    if(v < 0) { return 0; }
    if(v > thr_texvar()) { return 0; }
    return 1;
}

// ---- D5 CCN2-MIXED: warm/cool split within panel1 ----
// q1=[0,32) vs q2=[32,64): warmth = mean(r-b)
// returns 1 if opposite signs with |warmth| > thr on both; else 0; -1 bad->0
fn d5_ccn2(buf:[]u8, n:i32) i32 {
    if(n < 8 + 128*64*3) { return 0; }
    if(t_get32(buf, 0) != 128 || t_get32(buf, 4) != 64) { return 0; }
    let r1:i64 = 0; let b1:i64 = 0;
    let r2:i64 = 0; let b2:i64 = 0;
    let cnt:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 32) {
            let o1:i32 = 8 + (y * 128 + x) * 3;
            let o2:i32 = 8 + (y * 128 + x + 32) * 3;
            r1 = r1 + (buf[o1] as i64); b1 = b1 + (buf[o1+2] as i64);
            r2 = r2 + (buf[o2] as i64); b2 = b2 + (buf[o2+2] as i64);
            cnt = cnt + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    let w1:i64 = r1 / cnt - b1 / cnt;
    let w2:i64 = r2 / cnt - b2 / cnt;
    let thr:i64 = thr_ccn2();
    // opposite signs: w1>thr and w2<-thr, or vice versa
    if(w1 > thr && w2 < 0 - thr) { return 1; }
    if(w2 > thr && w1 < 0 - thr) { return 1; }
    return 0;
}

// ---- D6/D7 motion energies ----
// 10*mean|I[t+1]-I[t]| over t=0..6, sparse step 2; -1 on bad
fn vknow_framediff(buf:[]u8, n:i32) i64 {
    if(n < 12) { return -1; }
    if(t_get32(buf, 0) != 8 || t_get32(buf, 4) != 64 || t_get32(buf, 8) != 64) { return -1; }
    if(n < 12 + 8*64*64*3) { return -1; }
    let sum:i64 = 0;
    let cnt:i64 = 0;
    let t:i32 = 0;
    while(t < 7) {
        let y:i32 = 0;
        while(y < 64) {
            let x:i32 = 0;
            while(x < 64) {
                let c:i32 = 0;
                while(c < 3) {
                    let o0:i32 = 12 + (t * 4096 + y * 64 + x) * 3 + c;
                    let o1:i32 = 12 + ((t + 1) * 4096 + y * 64 + x) * 3 + c;
                    sum = sum + iabs((buf[o1] as i64) - (buf[o0] as i64));
                    cnt = cnt + 1;
                    c = c + 1;
                }
                x = x + 2;
            }
            y = y + 2;
        }
        t = t + 1;
    }
    if(cnt == 0) { return -1; }
    return sum * 10 / cnt;
}

// 10*mean|I[t]-2*I[t+1]+I[t+2]| over t=0..5, sparse step 2; -1 on bad
fn vknow_flicker(buf:[]u8, n:i32) i64 {
    if(n < 12) { return -1; }
    if(t_get32(buf, 0) != 8 || t_get32(buf, 4) != 64 || t_get32(buf, 8) != 64) { return -1; }
    if(n < 12 + 8*64*64*3) { return -1; }
    let sum:i64 = 0;
    let cnt:i64 = 0;
    let t:i32 = 0;
    while(t < 6) {
        let y:i32 = 0;
        while(y < 64) {
            let x:i32 = 0;
            while(x < 64) {
                let c:i32 = 0;
                while(c < 3) {
                    let o0:i32 = 12 + (t * 4096 + y * 64 + x) * 3 + c;
                    let o1:i32 = 12 + ((t + 1) * 4096 + y * 64 + x) * 3 + c;
                    let o2:i32 = 12 + ((t + 2) * 4096 + y * 64 + x) * 3 + c;
                    let v0:i64 = buf[o0] as i64;
                    let v1:i64 = buf[o1] as i64;
                    let v2:i64 = buf[o2] as i64;
                    sum = sum + iabs(v0 - 2 * v1 + v2);
                    cnt = cnt + 1;
                    c = c + 1;
                }
                x = x + 2;
            }
            y = y + 2;
        }
        t = t + 1;
    }
    if(cnt == 0) { return -1; }
    return sum * 10 / cnt;
}

fn d6_mot2(buf:[]u8, n:i32) i32 {
    let fl:i64 = vknow_flicker(buf, n);
    if(fl < 0 || fl <= thr_mot2_flick()) { return 0; }
    let dr:i64 = vknow_framediff(buf, n);
    if(dr < 0 || dr <= thr_mot2_dir()) { return 0; }
    return 1;
}

fn d7_mot3(buf:[]u8, n:i32) i32 {
    let dr:i64 = vknow_framediff(buf, n);
    if(dr < 0) { return 0; }
    if(dr < thr_mot3_lo()) { return 0; }
    if(dr > thr_mot3_hi()) { return 0; }
    return 1;
}

// ---- D8 SHP1-OCCLUDE: consecutive uniform-dark rows (occlusion bar) ----
// longest run of rows with mean lum < 40 and >90% pixels in [10,50]; -1 bad
fn m8_barrows(buf:[]u8, n:i32) i64 {
    if(n < 8 + 96*96*3) { return -1; }
    if(t_get32(buf, 0) != 96 || t_get32(buf, 4) != 96) { return -1; }
    let best:i64 = 0;
    let run:i64 = 0;
    let y:i32 = 0;
    while(y < 96) {
        let darkcnt:i32 = 0;
        let sum:i64 = 0;
        let x:i32 = 0;
        while(x < 96) {
            let o:i32 = 8 + (y * 96 + x) * 3;
            let lum:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
            sum = sum + lum;
            if(lum >= 10 && lum <= 50) { darkcnt = darkcnt + 1; }
            x = x + 1;
        }
        let mean:i64 = sum / 96;
        if(mean < 40 && darkcnt >= 86) {
            run = run + 1;
            if(run > best) { best = run; }
        } else {
            run = 0;
        }
        y = y + 1;
    }
    return best;
}

fn d8_shp1(buf:[]u8, n:i32) i32 {
    let m:i64 = m8_barrows(buf, n);
    if(m < 0) { return 0; }
    if(m >= thr_shp1_run()) { return 1; }
    return 0;
}

// ---- D9 TMB1-BOUND: 100*|centroid-boundary|/boundary, min over boundaries ----
fn m9_boundary(buf:[]u8, n:i32, op:[]u8) i64 {
    if(n < 8) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 2048 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let f0:i64 = f0_h2(buf, 8, cnt, sr, op);
    if(f0 <= 0) { return -1; }
    let r:i64 = spec_centroid_h2(buf, 8, 2048, sr, f0, op);
    if(r <= 0) { return -1; }
    let best:i64 = 1000000;
    let d:i64 = iabs(r - 1075) * 100 / 1075;
    if(d < best) { best = d; }
    d = iabs(r - 1400) * 100 / 1400;
    if(d < best) { best = d; }
    d = iabs(r - 3000) * 100 / 3000;
    if(d < best) { best = d; }
    return best;
}

fn d9_tmb1(buf:[]u8, n:i32, op:[]u8) i32 {
    let m:i64 = m9_boundary(buf, n, op);
    if(m < 0) { return 0; }
    if(m < thr_tmb1_pct()) { return 1; }
    return 0;
}

// ---- D10 SHP3-LOWCON: luminance range; -1 on bad ----
fn m10_contrast(buf:[]u8, n:i32) i64 {
    if(n < 8 + 96*96*3) { return -1; }
    if(t_get32(buf, 0) != 96 || t_get32(buf, 4) != 96) { return -1; }
    let mn:i64 = 765;
    let mx:i64 = 0;
    let y:i32 = 0;
    while(y < 96) {
        let x:i32 = 0;
        while(x < 96) {
            let o:i32 = 8 + (y * 96 + x) * 3;
            let lum:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
            if(lum < mn) { mn = lum; }
            if(lum > mx) { mx = lum; }
            x = x + 2;
        }
        y = y + 2;
    }
    return mx - mn;
}

fn d10_shp3(buf:[]u8, n:i32) i32 {
    let m:i64 = m10_contrast(buf, n);
    if(m < 0) { return 0; }
    if(m < thr_shp3_con()) { return 1; }
    return 0;
}

// ---- D11 TMB2-HARM: 100*E(2f0)/E(f0); -1 on bad ----
fn m11_boost(buf:[]u8, n:i32, op:[]u8) i64 {
    if(n < 8) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 1024 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let f0:i64 = f0_h2(buf, 8, cnt, sr, op);
    if(f0 <= 0) { return -1; }
    let e1:i64 = harm_energy(buf, 8, 1024, sr, f0, 4, op);
    if(e1 <= 0) { return -1; }
    let e2:i64 = harm_energy(buf, 8, 1024, sr, f0 * 2, 4, op);
    return e2 * 100 / e1;
}

fn d11_tmb2(buf:[]u8, n:i32, op:[]u8) i32 {
    let m:i64 = m11_boost(buf, n, op);
    if(m < 0) { return 0; }
    if(m > thr_tmb2_pct()) { return 1; }
    return 0;
}

// ---- dispatcher: bitmask of fired detectors ----
fn vknow_check(tc:i32, buf:[]u8, n:i32, op:[]u8, dmask:i32) i32 {
    let fire:i32 = 0;
    if(tc == 0) {
        if((dmask & 16) != 0 && d4_col2(buf, n) == 1) { fire = fire | 16; }
    }
    if(tc == 1) {
        if((dmask & 4) != 0 && d3_ccn1(buf, n) == 1) { fire = fire | 4; }
        if((dmask & 8) != 0 && d3b_ccn1(buf, n) == 1) { fire = fire | 8; }
        if((dmask & 32) != 0 && d5_ccn2(buf, n) == 1) { fire = fire | 32; }
    }
    if(tc == 2) {
        if((dmask & 256) != 0 && d8_shp1(buf, n) == 1) { fire = fire | 256; }
        if((dmask & 1024) != 0 && d10_shp3(buf, n) == 1) { fire = fire | 1024; }
    }
    if(tc == 3) {
        if((dmask & 1) != 0 && d1_glide(buf, n, op) == 1) { fire = fire | 1; }
        if((dmask & 2) != 0 && d2_harminc(buf, n, op) == 1) { fire = fire | 2; }
    }
    if(tc == 4) {
        if((dmask & 512) != 0 && d9_tmb1(buf, n, op) == 1) { fire = fire | 512; }
        if((dmask & 2048) != 0 && d11_tmb2(buf, n, op) == 1) { fire = fire | 2048; }
    }
    if(tc == 5) {
        if((dmask & 64) != 0 && d6_mot2(buf, n) == 1) { fire = fire | 64; }
        if((dmask & 128) != 0 && d7_mot3(buf, n) == 1) { fire = fire | 128; }
    }
    return fire;
}

// ---- K-tag: "K=FAM+FAM..." into tag[], returns length ----
fn tag_cpy(tag:[]u8, p:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        tag[p] = s[i];
        p = p + 1;
        i = i + 1;
    }
    return p;
}

fn ktag_build(fire:i32, tag:[]u8) i32 {
    tag[0] = 75;
    tag[1] = 61;
    let p:i32 = 2;
    let nf:i32 = 0;
    if((fire & 1) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "PTC-2");
        nf = nf + 1;
    }
    if((fire & 2) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "PTC-3");
        nf = nf + 1;
    }
    if((fire & 12) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "CCN-1");
        nf = nf + 1;
    }
    if((fire & 16) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "COL-2");
        nf = nf + 1;
    }
    if((fire & 32) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "CCN-2");
        nf = nf + 1;
    }
    if((fire & 64) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "MOT-2");
        nf = nf + 1;
    }
    if((fire & 128) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "MOT-3");
        nf = nf + 1;
    }
    if((fire & 256) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "SHP-1");
        nf = nf + 1;
    }
    if((fire & 512) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "TMB-1");
        nf = nf + 1;
    }
    if((fire & 1024) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "SHP-3");
        nf = nf + 1;
    }
    if((fire & 2048) != 0) {
        if(nf > 0) { tag[p] = 43; p = p + 1; }
        p = tag_cpy(tag, p, "TMB-2");
        nf = nf + 1;
    }
    return p;
}

// ---- output-buffer surgery (main) ----
fn ob_match(ob:[]u8, at:i32, key:[]u8) i32 {
    let i:i32 = 0;
    while(i < key.len) {
        if((ob[at + i] as i32) != (key[i] as i32)) { return 0; }
        i = i + 1;
    }
    return 1;
}

// cap "confidence=" at cap (both known 3-digit here); returns pos unchanged
fn ob_cap_conf(ob:[]u8, pos:i32, cap:i64) i32 {
    let key:[]u8 = "\nconfidence=";
    let i:i32 = 0;
    while(i + 12 <= pos) {
        if(ob_match(ob, i, key) == 1) {
            let v:i64 = 0;
            let j:i32 = i + 12;
            let nd:i32 = 0;
            while(j < pos && (ob[j] as i32) >= 48 && (ob[j] as i32) <= 57) {
                v = v * 10 + ((ob[j] as i32) - 48) as i64;
                j = j + 1;
                nd = nd + 1;
            }
            if(v > cap && nd == 3) {
                ob[i+12] = 54;
                ob[i+13] = 53;
                ob[i+14] = 48;
            }
            break;
        }
        i = i + 1;
    }
    return pos;
}

// insert "|<tag>" before the newline ending the prog= line; returns new pos
fn ob_insert_ktag(ob:[]u8, pos:i32, tag:[]u8, tlen:i32) i32 {
    let key:[]u8 = "\nprog=";
    let i:i32 = 0;
    let q:i32 = -1;
    while(i + 6 <= pos) {
        if(ob_match(ob, i, key) == 1) {
            let j:i32 = i + 6;
            while(j < pos && (ob[j] as i32) != 10) { j = j + 1; }
            q = j;
            break;
        }
        i = i + 1;
    }
    if(q < 0 || q >= pos) { return pos; }
    let ins:i32 = 1 + tlen;
    let k:i32 = pos - 1;
    while(k >= q) {
        ob[k + ins] = ob[k];
        k = k - 1;
    }
    ob[q] = 124;
    let c:i32 = 0;
    while(c < tlen) {
        ob[q + 1 + c] = tag[c];
        c = c + 1;
    }
    return pos + ins;
}

fn z_atoi(s:[]u8) i32 {
    let v:i32 = 0;
    let i:i32 = 0;
    while(i < s.len) {
        let c:i32 = s[i] as i32;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

// ---- stats mode: raw detector measurements for calibration ----
fn vknow_stats(tc:i32, buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32) i32 {
    pos = ob_kint(ob, pos, "d1_gl", m1_glide(buf, n, op));
    pos = ob_kint(ob, pos, "d2_harm", m2_harminc(buf, n, op));
    pos = ob_kint(ob, pos, "d3_opp", m3_opposite(buf, n));
    pos = ob_kint(ob, pos, "d3_corr", vknow_texcorr(buf, n));
    pos = ob_kint(ob, pos, "d3b", d3b_ccn1(buf, n) as i64);
    pos = ob_kint(ob, pos, "d4_opp", m4_drift(buf, n));
    pos = ob_kint(ob, pos, "d4_var", m4_texvar(buf, n));
    pos = ob_kint(ob, pos, "d4_corr", vknow_texcorr(buf, n));
    pos = ob_kint(ob, pos, "d5", d5_ccn2(buf, n) as i64);
    pos = ob_kint(ob, pos, "d6_flick", vknow_flicker(buf, n));
    pos = ob_kint(ob, pos, "d6_dir", vknow_framediff(buf, n));
    pos = ob_kint(ob, pos, "d8_barrows", m8_barrows(buf, n));
    pos = ob_kint(ob, pos, "d9_bnd", m9_boundary(buf, n, op));
    pos = ob_kint(ob, pos, "d10_con", m10_contrast(buf, n));
    pos = ob_kint(ob, pos, "d11_boost", m11_boost(buf, n, op));
    pos = ob_kint(ob, pos, "fire", vknow_check(tc, buf, n, op, 4095) as i64);
    return pos;
}

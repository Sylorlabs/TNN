// g2_battery.zag — Parts 1-4 of the G2 battery (pure Zag, zero RNG).
// Usage: g2_battery <part> <b1> <b2> <b3> <tcol> <tcc> <trialsdir> <listfile> [donordir]
//   part: 1|2|3|4
//   listfile lines: <fixture>|<J1>
// Deterministic; run 3x and SHA-compare full output.
@import("R33_NATIVE_IO_V1.zag")
@import("organ1.zag")
@import("organ2.zag")

// (z_cstr, z_read come from organ1.zag)
fn b_print(s:[]u8) void { nio_write_all(1, s); return; }
fn b_i64(v:i64) []u8 {
    let b:[]u8 = nio_alloc(24);
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let p:i32 = 23;
    if(x == 0) { p = 22; b[22] = 48; }
    while(x > 0) { p = p - 1; b[p] = ((x % 10) + 48) as u8; x = x / 10; }
    if(neg == 1) { p = p - 1; b[p] = 45; }
    let n:i32 = 23 - p;
    let o:[]u8 = nio_alloc(n);
    let i:i32 = 0;
    while(i < n) { o[i] = b[p+i]; i = i + 1; }
    nio_free(b);
    return o;
}
fn b_pi64(v:i64) void {
    let s:[]u8 = b_i64(v);
    b_print(s);
    nio_free(s);
    return;
}
// parse i64 from decimal ascii
fn b_atoi(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < s.len) {
        let c:u8 = s[i];
        if(c >= 48 && c <= 57) { v = v*10 + (c as i64 - 48); }
        i = i + 1;
    }
    return v;
}
// join dir + "/" + name into out; returns len
fn b_join(out:[]u8, dir:[]u8, name:[]u8) i32 {
    let p:i32 = 0;
    let i:i32 = 0;
    while(i < dir.len) { out[p] = dir[i]; p = p+1; i = i+1; }
    out[p] = 47; p = p+1;
    i = 0;
    while(i < name.len) { out[p] = name[i]; p = p+1; i = i+1; }
    return p;
}
// extract F from .r24; returns flen, F at buf[8..8+flen]; tcode via out param
fn b_r24_flen(buf:[]u8, n:i64) i64 {
    if(n < 16) { return -1; }
    if(o2_u32(buf, 0) != 1093939794) { return -1; }
    let tc:i64 = o2_u32(buf, 4);
    if(tc == 0 || tc == 1 || tc == 2) {
        let w:i64 = o2_u32(buf, 8); let h:i64 = o2_u32(buf, 12);
        if(w <= 0 || h <= 0 || w > 1024 || h > 1024) { return -1; }
        return 8+w*h*3;
    }
    if(tc == 3 || tc == 4) {
        let cnt:i64 = o2_u32(buf, 12);
        if(cnt <= 0 || cnt > 2000000) { return -1; }
        return 8+cnt*2;
    }
    return -1;
}
// organ-1 judgment on F bytes; returns judgment string (static)
fn b_o1_judgment(tcode:i64, f:[]u8, flen:i32) []u8 {
    let ob:[]u8 = nio_alloc(8192);
    let op:[]u8 = nio_alloc(8);
    t_put64(op, 0, 0);
    let lut:[]u8 = nio_alloc(2048);
    lut_init(lut);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "R2-4");
    let gbuf:[]u8 = f[0..0];
    let rc:i32 = -1;
    if(tcode == 0) { rc = task_colordisc(f, flen, ob, pos, op, lut, gbuf, 0); }
    if(tcode == 1) { rc = task_colorconst(f, flen, ob, pos, op, lut, gbuf, 0); }
    if(tcode == 2) { rc = task_shapetrans(f, flen, ob, pos, op, gbuf, 0); }
    if(tcode == 3) { rc = task_pitchdisc(f, flen, ob, pos, op, gbuf, 0); }
    if(tcode == 4) { rc = task_timbredisc(f, flen, ob, pos, op, gbuf, 0); }
    if(tcode == 5) { rc = task_motiondir(f, flen, ob, pos, op, gbuf, 0); }
    nio_free(lut);
    nio_free(op);
    let j:[]u8 = "";
    if(rc >= 0) {
        // scan ob[0..rc] for "judgment="
        let i:i32 = 0;
        while(i+9 < rc) {
            if(ob[i]==106 && ob[i+1]==117 && ob[i+2]==100 && ob[i+3]==103 && ob[i+4]==109 && ob[i+5]==101 && ob[i+6]==110 && ob[i+7]==116 && ob[i+8]==61) {
                let s:i32 = i+9;
                let e:i32 = s;
                while(e < rc && ob[e] != 10) { e = e + 1; }
                j = ob[s..e];
                break;
            }
            i = i + 1;
        }
    }
    nio_free(ob);
    return j;
}
// mark attended bytes in bitmap (1=attended). bitmap len >= flen.
fn b_mark_attended(tcode:i64, f:[]u8, flen:i64, bm:[]u8) void {
    let i:i64 = 0;
    while(i < flen) { bm[i as i32] = 0; i = i + 1; }
    if(tcode == 3 || tcode == 4) {
        let cnt:i64 = o2_u32(f, 4);
        let k:i64 = 0;
        while(k < 64) {
            let off:i64 = ((2*k+1)*cnt)/128;
            let lo:i64 = off-48; if(lo < 0) { lo = 0; }
            let hi:i64 = off+49; if(hi > cnt) { hi = cnt; }
            let s2:i64 = lo;
            while(s2 < hi) {
                bm[(8+2*s2) as i32] = 1;
                bm[(8+2*s2+1) as i32] = 1;
                s2 = s2 + 1;
            }
            k = k + 1;
        }
    } else {
        let w:i64 = o2_u32(f, 0);
        let h:i64 = o2_u32(f, 4);
        if(tcode == 5) { w = o2_u32(f, 4); h = o2_u32(f, 8); }
        let k:i64 = 0;
        while(k < 64) {
            let gx:i64 = k % 8; let gy:i64 = k / 8;
            let x:i64 = ((2*gx+1)*w)/16;
            let y:i64 = ((2*gy+1)*h)/16;
            let dy:i64 = -2;
            while(dy <= 2) {
                let dx:i64 = -2;
                while(dx <= 2) {
                    let px:i64 = x+dx; if(px<0){px=0;} if(px>=w){px=w-1;}
                    let py:i64 = y+dy; if(py<0){py=0;} if(py>=h){py=h-1;}
                    if(tcode == 5) {
                        // video: frames 0 and 3
                        let fsz:i64 = w*h*3;
                        let b0:i64 = 12+(py*w+px)*3;
                        let b3:i64 = 12+3*fsz+(py*w+px)*3;
                        bm[b0 as i32]=1; bm[(b0+1) as i32]=1; bm[(b0+2) as i32]=1;
                        bm[b3 as i32]=1; bm[(b3+1) as i32]=1; bm[(b3+2) as i32]=1;
                    } else {
                        let bi:i64 = 8+3*(py*w+px);
                        bm[bi as i32]=1; bm[(bi+1) as i32]=1; bm[(bi+2) as i32]=1;
                    }
                    dx = dx+1;
                }
                dy = dy+1;
            }
            k = k + 1;
        }
    }
    return;
}
// deterministic noise byte
fn b_noisebyte(pos:i64, seq:i64, salt:i64) u8 {
    let x:i64 = pos*1103515245 + seq*40503 + salt*987643211 + 12345;
    // x mod 2^64 mod 256 = low byte. Compute via masking (x may be negative as i64).
    // Low 8 bits of the u64 value = low 8 bits of i64 (two's complement).
    return (x & 255) as u8;
}

fn main() i32 {
    let part:i64 = b_atoi(_zag_arg(1));
    let b1:i64 = b_atoi(_zag_arg(2));
    let b2:i64 = b_atoi(_zag_arg(3));
    let b3:i64 = b_atoi(_zag_arg(4));
    let tcol:i64 = b_atoi(_zag_arg(5));
    let tcc:i64 = b_atoi(_zag_arg(6));
    let tdir:[]u8 = _zag_arg(7);
    let listp:[]u8 = _zag_arg(8);
    if(part < 1 || part > 4 || tdir.len == 0 || listp.len == 0) {
        b_print("usage: g2_battery <part> <b1> <b2> <b3> <tcol> <tcc> <trialsdir> <listfile>\n");
        return 1;
    }
    let lb:[]u8 = nio_alloc(65536);
    let ln:i64 = z_read(listp, lb, 65536);
    if(ln <= 0) { b_print("bad list\n"); return 1; }
    let rbuf:[]u8 = nio_alloc(200000);
    let fmod:[]u8 = nio_alloc(200000);
    let bm:[]u8 = nio_alloc(200000);
    let dbuf:[]u8 = nio_alloc(200000); // donor
    let total:i64 = 0;
    let hit:i64 = 0; // part1: wrong_corr; part2: editA preserved; part3: retained
    let p:i64 = 0;
    while(p < ln) {
        let le:i64 = p;
        while(le < ln && lb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0) {
            let line:[]u8 = lb[p as i32..(p+llen as i64) as i32];
            // split at '|'
            let pi:i32 = 0;
            while(pi < llen && line[pi] != 124) { pi = pi + 1; }
            let fx:[]u8 = line[0..pi];
            let j1:[]u8 = line[(pi+1)..llen];
            // fixture index = number after last '_', before '.r24'
            let seq:i64 = 0;
            let si:i32 = fx.len - 5;
            let mult:i64 = 1;
            while(si >= 0 && fx[si] >= 48 && fx[si] <= 57) {
                seq = seq + (fx[si] as i64 - 48)*mult;
                mult = mult*10;
                si = si - 1;
            }
            let path:[]u8 = nio_alloc(4096);
            let plen:i32 = b_join(path, tdir, fx);
            let n:i64 = z_read(path[0..plen], rbuf, 200000);
            nio_free(path);
            if(n > 0) {
                let flen:i64 = b_r24_flen(rbuf, n);
                let tc:i64 = o2_u32(rbuf, 4);
                if(flen > 0 && 8+flen <= n) {
                    let F:[]u8 = rbuf[8..(8+flen) as i32];
                    total = total + 1;
                    b_print(fx); b_print("|");
                    if(part == 1 || part == 3) {
                        let o2:[]u8 = o2_label(tc, F, b1, b2, b3, tcol, tcc);
                        b_print(o2); b_print("|"); b_print(j1); b_print("|");
                        if(_zag_strcmp(o2, j1) == 1) {
                            hit = hit + 1;
                            b_print("1\n");
                        } else { b_print("0\n"); }
                    }
                    if(part == 2) {
                        b_mark_attended(tc, F, flen, bm);
                        // Edit A: noise outside
                        let i2:i64 = 0;
                        while(i2 < flen) {
                            if(i2 < 8) { fmod[i2 as i32] = F[i2 as i32]; }
                            else {
                                if(bm[i2 as i32] == 1) { fmod[i2 as i32] = F[i2 as i32]; }
                                else { fmod[i2 as i32] = b_noisebyte(i2, seq, 1); }
                            }
                            i2 = i2 + 1;
                        }
                        let o2a:[]u8 = o2_label(tc, fmod[0..flen as i32], b1, b2, b3, tcol, tcc);
                        let pa:i64 = 0;
                        if(_zag_strcmp(o2a, j1) == 1) { pa = 1; hit = hit + 1; }
                        // Edit B: noise attended
                        i2 = 0;
                        while(i2 < flen) {
                            if(i2 < 8) { fmod[i2 as i32] = F[i2 as i32]; }
                            else {
                                if(bm[i2 as i32] == 1) { fmod[i2 as i32] = b_noisebyte(i2, seq, 2); }
                                else { fmod[i2 as i32] = F[i2 as i32]; }
                            }
                            i2 = i2 + 1;
                        }
                        let o2b:[]u8 = o2_label(tc, fmod[0..flen as i32], b1, b2, b3, tcol, tcc);
                        let pb:i64 = 0;
                        if(_zag_strcmp(o2b, j1) == 1) { pb = 1; }
                        b_print(o2a); b_print("|"); b_print(o2b); b_print("|"); b_print(j1); b_print("|");
                        b_pi64(pa); b_print("|"); b_pi64(pb); b_print("\n");
                    }
                    if(part == 4) {
                        let bo2:[]u8 = o2_label(tc, F, b1, b2, b3, tcol, tcc);
                        b_print("base="); b_print(bo2); b_print(" ");
                        b_mark_attended(tc, F, flen, bm);
                        // load donor
                        let dlen:i64 = 0;
                        if(tc == 4) {
                            let dp:[]u8 = nio_alloc(4096);
                            let dplen:i32 = b_join(dp, tdir, "rt4_TMB-5_0004.r24");
                            let dn:i64 = z_read(dp[0..dplen], dbuf, 200000);
                            nio_free(dp);
                            if(dn > 0) {
                                let dflen:i64 = b_r24_flen(dbuf, dn);
                                if(dflen == flen) {
                                    let i2:i64 = 0;
                                    while(i2 < flen) { dbuf[i2 as i32] = dbuf[(8+i2) as i32]; i2 = i2+1; }
                                    dlen = flen;
                                }
                            }
                        }
                        if(tc == 0) {
                            let dp:[]u8 = _zag_arg(9);
                            if(dp.len > 0) {
                                let dn:i64 = z_read(dp, dbuf, 200000);
                                if(dn == flen) { dlen = flen; }
                            }
                        }
                        // Level A: +-32
                        let i2:i64 = 0;
                        while(i2 < flen) {
                            fmod[i2 as i32] = F[i2 as i32];
                            i2 = i2 + 1;
                        }
                        i2 = 8;
                        while(i2 < flen) {
                            if(bm[i2 as i32] == 1) {
                                let delta:i64 = ((i2*7919 + seq*104729 + 7) % 65) - 32;
                                if(tc == 3 || tc == 4) {
                                    if((i2 % 2) == 0) {
                                        let s:i64 = o2_i16(F, i2 as i32);
                                        let ns:i64 = s + delta;
                                        if(ns < -32768) { ns = -32768; }
                                        if(ns > 32767) { ns = 32767; }
                                        fmod[i2 as i32] = (ns & 255) as u8;
                                        fmod[(i2+1) as i32] = ((ns >> 8) & 255) as u8;
                                    }
                                } else {
                                    let c:i64 = F[i2 as i32] as i64;
                                    let nc:i64 = c + delta;
                                    if(nc < 0) { nc = 0; }
                                    if(nc > 255) { nc = 255; }
                                    fmod[i2 as i32] = nc as u8;
                                }
                            }
                            i2 = i2 + 1;
                        }
                        let j1a:[]u8 = b_o1_judgment(tc, fmod[0..flen as i32], flen as i32);
                        b_print("A:j1="); b_print(j1a);
                        if(_zag_strcmp(j1a, j1) == 1) {
                            let o2a:[]u8 = o2_label(tc, fmod[0..flen as i32], b1, b2, b3, tcol, tcc);
                            b_print(" o2="); b_print(o2a);
                            if(_zag_strcmp(o2a, bo2) == 1) { b_print(" INV"); } else { b_print(" MOV"); }
                        } else { b_print(" DISCARD"); }
                        // Level B: donor over all 64 offsets
                        if(dlen == flen) {
                            i2 = 0;
                            while(i2 < flen) { fmod[i2 as i32] = F[i2 as i32]; i2 = i2+1; }
                            i2 = 8;
                            while(i2 < flen) {
                                if(bm[i2 as i32] == 1) { fmod[i2 as i32] = dbuf[i2 as i32]; }
                                i2 = i2 + 1;
                            }
                            let j1b:[]u8 = b_o1_judgment(tc, fmod[0..flen as i32], flen as i32);
                            b_print(" B:j1="); b_print(j1b);
                            if(_zag_strcmp(j1b, j1) == 1) {
                                let o2b:[]u8 = o2_label(tc, fmod[0..flen as i32], b1, b2, b3, tcol, tcc);
                                b_print(" o2="); b_print(o2b);
                                if(_zag_strcmp(o2b, bo2) == 1) { b_print(" INV"); } else { b_print(" MOV"); }
                            } else { b_print(" DISCARD"); }
                            // Level B-half: donor over first 32 offsets only
                            // rebuild a half-bitmap: mark only k<32
                            let bm2:[]u8 = nio_alloc(200000);
                            let i3:i64 = 0;
                            while(i3 < flen) { bm2[i3 as i32] = 0; i3 = i3+1; }
                            if(tc == 3 || tc == 4) {
                                let cnt:i64 = o2_u32(F, 4);
                                let k:i64 = 0;
                                while(k < 32) {
                                    let off:i64 = ((2*k+1)*cnt)/128;
                                    let lo:i64 = off-48; if(lo<0){lo=0;}
                                    let hi:i64 = off+49; if(hi>cnt){hi=cnt;}
                                    let s2:i64 = lo;
                                    while(s2 < hi) {
                                        bm2[(8+2*s2) as i32]=1; bm2[(8+2*s2+1) as i32]=1;
                                        s2=s2+1;
                                    }
                                    k=k+1;
                                }
                            } else {
                                let w:i64 = o2_u32(F, 0); let h:i64 = o2_u32(F, 4);
                                let k:i64 = 0;
                                while(k < 32) {
                                    let gx:i64 = k%8; let gy:i64 = k/8;
                                    let x:i64 = ((2*gx+1)*w)/16;
                                    let y:i64 = ((2*gy+1)*h)/16;
                                    let dy:i64 = -2;
                                    while(dy <= 2) {
                                        let dx:i64 = -2;
                                        while(dx <= 2) {
                                            let px:i64=x+dx; if(px<0){px=0;} if(px>=w){px=w-1;}
                                            let py:i64=y+dy; if(py<0){py=0;} if(py>=h){py=h-1;}
                                            let bi:i64=8+3*(py*w+px);
                                            bm2[bi as i32]=1; bm2[(bi+1) as i32]=1; bm2[(bi+2) as i32]=1;
                                            dx=dx+1;
                                        }
                                        dy=dy+1;
                                    }
                                    k=k+1;
                                }
                            }
                            i2 = 0;
                            while(i2 < flen) { fmod[i2 as i32] = F[i2 as i32]; i2 = i2+1; }
                            i2 = 8;
                            while(i2 < flen) {
                                if(bm2[i2 as i32] == 1) { fmod[i2 as i32] = dbuf[i2 as i32]; }
                                i2 = i2 + 1;
                            }
                            nio_free(bm2);
                            let j1h:[]u8 = b_o1_judgment(tc, fmod[0..flen as i32], flen as i32);
                            b_print(" Bh:j1="); b_print(j1h);
                            if(_zag_strcmp(j1h, j1) == 1) {
                                let o2h:[]u8 = o2_label(tc, fmod[0..flen as i32], b1, b2, b3, tcol, tcc);
                                b_print(" o2="); b_print(o2h);
                                if(_zag_strcmp(o2h, bo2) == 1) { b_print(" INV"); } else { b_print(" MOV"); }
                            } else { b_print(" DISCARD"); }
                        } else { b_print(" B:NODONOR"); }
                        // Level C: -128/127 flip
                        i2 = 0;
                        while(i2 < flen) { fmod[i2 as i32] = F[i2 as i32]; i2 = i2+1; }
                        i2 = 8;
                        while(i2 < flen) {
                            if(bm[i2 as i32] == 1) {
                                if(tc == 3 || tc == 4) {
                                    if((i2 % 2) == 0) {
                                        let s:i64 = o2_i16(F, i2 as i32);
                                        let ns:i64 = 0;
                                        if(s < 0) { ns = 32767; } else { ns = -32768; }
                                        fmod[i2 as i32] = (ns & 255) as u8;
                                        fmod[(i2+1) as i32] = ((ns >> 8) & 255) as u8;
                                    }
                                } else {
                                    let c:i64 = F[i2 as i32] as i64;
                                    let nc:i64 = 255 - c;
                                    fmod[i2 as i32] = nc as u8;
                                }
                            }
                            i2 = i2 + 1;
                        }
                        let j1c:[]u8 = b_o1_judgment(tc, fmod[0..flen as i32], flen as i32);
                        b_print(" C:j1="); b_print(j1c);
                        if(_zag_strcmp(j1c, j1) == 1) {
                            let o2c:[]u8 = o2_label(tc, fmod[0..flen as i32], b1, b2, b3, tcol, tcc);
                            b_print(" o2="); b_print(o2c);
                            if(_zag_strcmp(o2c, bo2) == 1) { b_print(" INV"); } else { b_print(" MOV"); }
                        } else { b_print(" DISCARD"); }
                        b_print("\n");
                    }
                }
            }
        }
        p = le + 1;
    }
    b_print("TOTAL="); b_pi64(total); b_print(" HIT="); b_pi64(hit); b_print("\n");
    nio_free(lb);
    nio_free(rbuf);
    nio_free(fmod);
    nio_free(bm);
    nio_free(dbuf);
    return 0;
}

// calibrate.zag — learn organ-2 thresholds from r2a fixtures (pure Zag).
// Reads ONLY (fixture path, truth) — never organ-1 outputs.
// Usage: calibrate <task> <listfile>
//   task: timbredisc | colordisc | colorconst
//   listfile: fixture paths, one per line.
// Prints the frozen boundaries + train accuracy. Deterministic, zero RNG.
@import("R33_NATIVE_IO_V1.zag")
@import("organ2.zag")

fn z_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn c_print(s:[]u8) void {
    nio_write_all(1, s);
    return;
}
fn c_i64(v:i64) []u8 {
    // minimal i64 -> decimal (handles negatives)
    let b:[]u8 = nio_alloc(24);
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let p:i32 = 23;
    if(x == 0) { p = 22; b[22] = 48; }
    while(x > 0) {
        p = p - 1;
        b[p] = ((x % 10) + 48) as u8;
        x = x / 10;
    }
    if(neg == 1) { p = p - 1; b[p] = 45; }
    let n:i32 = 23 - p;
    let o:[]u8 = nio_alloc(n);
    let i:i32 = 0;
    while(i < n) { o[i] = b[p+i]; i = i + 1; }
    nio_free(b);
    return o;
}
fn c_line3(a:[]u8, v:i64, c:[]u8) void {
    c_print(a);
    let s:[]u8 = c_i64(v);
    c_print(s);
    nio_free(s);
    c_print(c);
    return;
}
// parse "truth=XXX" from sidecar bytes; returns class index or -1
// timbre: PURE=0 DARK=1 RICH=2 BRIGHT=3 ; color: SAME/SAME_SURFACE=0 DIFFERENT=1
fn c_truth_class(tb:[]u8, n:i64, is_timbre:i32) i64 {
    let i:i64 = 0;
    while(i+7 < n) {
        if(tb[i as i32]==116 && tb[(i+1) as i32]==114 && tb[(i+2) as i32]==117 && tb[(i+3) as i32]==116 && tb[(i+4) as i32]==104 && tb[(i+5) as i32]==61) {
            let v0:u8 = tb[(i+6) as i32];
            if(is_timbre == 1) {
                if(v0==80) { return 0; } // PURE
                if(v0==68) { return 1; } // DARK
                if(v0==82) { return 2; } // RICH
                if(v0==66) { return 3; } // BRIGHT
            } else {
                if(v0==68) { return 1; } // DIFFERENT
                return 0; // SAME / SAME_SURFACE
            }
            return -1;
        }
        i = i + 1;
    }
    return -1;
}
// extract F span from a dual-span .r24 buffer; returns flen (F at buf[8..8+flen])
fn c_r24_flen(buf:[]u8, n:i64) i64 {
    if(n < 16) { return -1; }
    if(o2_u32(buf, 0) != 1093939794) { return -1; }
    let tc:i64 = o2_u32(buf, 4);
    if(tc == 0 || tc == 1 || tc == 2) {
        let w:i64 = o2_u32(buf, 8);
        let h:i64 = o2_u32(buf, 12);
        if(w <= 0 || h <= 0 || w > 1024 || h > 1024) { return -1; }
        return 8+w*h*3;
    }
    if(tc == 3 || tc == 4) {
        let cnt:i64 = o2_u32(buf, 12);
        if(cnt <= 0 || cnt > 2000000) { return -1; }
        return 8+cnt*2;
    }
    return -1;
}
fn c_tcode(buf:[]u8) i64 {
    return o2_u32(buf, 4);
}

fn main() i32 {
    let task:[]u8 = _zag_arg(1);
    let listp:[]u8 = _zag_arg(2);
    if(task.len == 0 || listp.len == 0) {
        c_print("usage: calibrate <task> <listfile>\n");
        return 1;
    }
    let is_timbre:i32 = 0;
    let is_colord:i32 = 0;
    let is_colorc:i32 = 0;
    if(_zag_strcmp(task, "timbredisc") == 1) { is_timbre = 1; }
    if(_zag_strcmp(task, "colordisc") == 1) { is_colord = 1; }
    if(_zag_strcmp(task, "colorconst") == 1) { is_colorc = 1; }
    if(is_timbre == 0 && is_colord == 0 && is_colorc == 0) {
        c_print("bad task\n");
        return 1;
    }
    // read list file
    let lb:[]u8 = nio_alloc(1048576);
    let ln:i64 = z_read(listp, lb, 1048576);
    if(ln <= 0) { c_print("bad list\n"); return 1; }
    // feature/class tables: up to 4096 rows
    let feats:[]u8 = nio_alloc(4096*8);
    let clss:[]u8 = nio_alloc(4096*8);
    o2_zero(feats, 4096*8);
    o2_zero(clss, 4096*8);
    let nr:i64 = 0;
    let fbuf:[]u8 = nio_alloc(200000);
    let tbuf:[]u8 = nio_alloc(64);
    let p:i64 = 0;
    while(p < ln && nr < 4096) {
        let le:i64 = p;
        while(le < ln && lb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0) {
            let fp:[]u8 = lb[p as i32..(p+llen as i64) as i32];
            let n:i64 = z_read(fp, fbuf, 200000);
            if(n > 0) {
                let flen:i64 = c_r24_flen(fbuf, n);
                if(flen > 0 && 8+flen <= n) {
                    let fsp:[]u8 = fbuf[8..(8+flen) as i32];
                    // truth sidecar: fp + ".truth"
                    let tp:[]u8 = nio_alloc(llen+8);
                    let ti:i32 = 0;
                    while(ti < llen) { tp[ti] = fp[ti]; ti = ti + 1; }
                    tp[llen]=46; tp[llen+1]=116; tp[llen+2]=114; tp[llen+3]=117; tp[llen+4]=116; tp[llen+5]=104;
                    let tn:i64 = z_read(tp[0..llen+6], tbuf, 64);
                    nio_free(tp);
                    if(tn > 0) {
                        let cls:i64 = c_truth_class(tbuf, tn, is_timbre);
                        if(cls >= 0) {
                            let feat:i64 = -1;
                            if(is_timbre == 1) { feat = o2_timbre_feat(fsp); }
                            if(is_colord == 1) { feat = o2_colordisc_feat(fsp); }
                            if(is_colorc == 1) { feat = o2_colorconst_feat(fsp); }
                            if(feat >= 0) {
                                o2_put64(feats, nr*8, feat);
                                o2_put64(clss, nr*8, cls);
                                nr = nr + 1;
                            }
                        }
                    }
                }
            }
        }
        p = le + 1;
    }
    nio_free(fbuf);
    nio_free(tbuf);
    c_line3("N=", nr, "\n");
    if(nr == 0) { c_print("no rows\n"); return 1; }
    if(is_timbre == 1) {
        // coarse-to-fine grid search for B1<B2<B3 over [0,1000]
        let best_b1:i64 = 0; let best_b2:i64 = 0; let best_b3:i64 = 0;
        let best_acc:i64 = -1;
        let b1:i64 = 0;
        while(b1 <= 1000) {
            let b2:i64 = b1;
            while(b2 <= 1000) {
                let b3:i64 = b2;
                while(b3 <= 1000) {
                    let ok:i64 = 0;
                    let i:i64 = 0;
                    while(i < nr) {
                        let ft:i64 = o2_get64(feats, i*8);
                        let cl:i64 = o2_get64(clss, i*8);
                        let pred:i64 = 0;
                        if(ft >= b1) { pred = 1; }
                        if(ft >= b2) { pred = 2; }
                        if(ft >= b3) { pred = 3; }
                        if(pred == cl) { ok = ok + 1; }
                        i = i + 1;
                    }
                    if(ok > best_acc) {
                        best_acc = ok; best_b1 = b1; best_b2 = b2; best_b3 = b3;
                    }
                    b3 = b3 + 25;
                }
                b2 = b2 + 25;
            }
            b1 = b1 + 25;
        }
        // refine +-25 at step 2
        let r1s:i64 = best_b1 - 25; if(r1s < 0) { r1s = 0; }
        let r1e:i64 = best_b1 + 25; if(r1e > 1000) { r1e = 1000; }
        let rb1:i64 = r1s;
        while(rb1 <= r1e) {
            let r2s:i64 = best_b2 - 25; if(r2s < rb1) { r2s = rb1; }
            let r2e:i64 = best_b2 + 25; if(r2e > 1000) { r2e = 1000; }
            let rb2:i64 = r2s;
            while(rb2 <= r2e) {
                let r3s:i64 = best_b3 - 25; if(r3s < rb2) { r3s = rb2; }
                let r3e:i64 = best_b3 + 25; if(r3e > 1000) { r3e = 1000; }
                let rb3:i64 = r3s;
                while(rb3 <= r3e) {
                    let ok:i64 = 0;
                    let i:i64 = 0;
                    while(i < nr) {
                        let ft:i64 = o2_get64(feats, i*8);
                        let cl:i64 = o2_get64(clss, i*8);
                        let pred:i64 = 0;
                        if(ft >= rb1) { pred = 1; }
                        if(ft >= rb2) { pred = 2; }
                        if(ft >= rb3) { pred = 3; }
                        if(pred == cl) { ok = ok + 1; }
                        i = i + 1;
                    }
                    if(ok > best_acc) {
                        best_acc = ok; best_b1 = rb1; best_b2 = rb2; best_b3 = rb3;
                    }
                    rb3 = rb3 + 2;
                }
                rb2 = rb2 + 2;
            }
            rb1 = rb1 + 2;
        }
        c_line3("B1=", best_b1, "\n");
        c_line3("B2=", best_b2, "\n");
        c_line3("B3=", best_b3, "\n");
        c_line3("ACC=", (1000*best_acc)/nr, "\n");
    } else {
        // single threshold: exhaustive over sorted unique feature values
        // sort feats (and clss alongside) by feat
        let i:i64 = 1;
        while(i < nr) {
            let kf:i64 = o2_get64(feats, i*8);
            let kc:i64 = o2_get64(clss, i*8);
            let j:i64 = i - 1;
            while(j >= 0) {
                if(o2_get64(feats, j*8) <= kf) { break; }
                o2_put64(feats, (j+1)*8, o2_get64(feats, j*8));
                o2_put64(clss, (j+1)*8, o2_get64(clss, j*8));
                j = j - 1;
            }
            o2_put64(feats, (j+1)*8, kf);
            o2_put64(clss, (j+1)*8, kc);
            i = i + 1;
        }
        let best_t:i64 = 0;
        let best_acc:i64 = -1;
        let i2:i64 = 0;
        while(i2 < nr) {
            let t:i64 = o2_get64(feats, i2*8);
            // skip duplicates
            if(i2 > 0 && t == o2_get64(feats, (i2-1)*8)) { i2 = i2 + 1; continue; }
            let ok:i64 = 0;
            let j2:i64 = 0;
            while(j2 < nr) {
                let ft:i64 = o2_get64(feats, j2*8);
                let cl:i64 = o2_get64(clss, j2*8);
                let pred:i64 = 0;
                if(ft >= t) { pred = 1; }
                if(pred == cl) { ok = ok + 1; }
                j2 = j2 + 1;
            }
            if(ok > best_acc) { best_acc = ok; best_t = t; }
            i2 = i2 + 1;
        }
        c_line3("T=", best_t, "\n");
        c_line3("ACC=", (1000*best_acc)/nr, "\n");
    }
    nio_free(lb);
    nio_free(feats);
    nio_free(clss);
    return 0;
}

ID=t10
UNIT=U3-interfaces
TITLE=readonly and optional properties
DESC=Attempts from a Config with readonly id and optional retries.
TPL=ifacefn
FILES=single
PARAMS:
iname=Config
props=readonly id: string; retries?: number;
fn=attempts
param=c
ret=number
body=return c.retries ?? 3;
ENDPARAMS
TESTS:
console.log(attempts({ id: "a" }));
console.log(attempts({ id: "b", retries: 1 }));
ENDTESTS
EXPECT:
3
1
ENDEXPECT

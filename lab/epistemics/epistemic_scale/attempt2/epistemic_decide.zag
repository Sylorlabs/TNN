    if (i==156) { return 1; }
    if (i==157) { return 0; }
    if (i==158) { return 1; }
    if (i==159) { return 0; }
    if (i==160) { return 1; }
    if (i==161) { return 0; }
    if (i==162) { return 0; }
    if (i==163) { return 0; }
    if (i==164) { return 0; }
    if (i==165) { return 0; }
    if (i==166) { return 0; }
    if (i==167) { return 0; }
    if (i==168) { return 0; }
    if (i==169) { return 0; }
    if (i==170) { return 0; }
    if (i==171) { return 0; }
    if (i==172) { return 1; }
    if (i==173) { return 1; }
    if (i==174) { return 0; }
    if (i==175) { return 0; }
    if (i==176) { return 0; }
    if (i==177) { return 1; }
    if (i==178) { return 1; }
    if (i==179) { return 0; }
    if (i==180) { return 1; }
    if (i==181) { return 0; }
    if (i==182) { return 0; }
    if (i==183) { return 0; }
    if (i==184) { return 0; }
    if (i==185) { return 1; }
    if (i==186) { return 0; }
    if (i==187) { return 0; }
    if (i==188) { return 0; }
    if (i==189) { return 0; }
    if (i==190) { return 0; }
    if (i==191) { return 0; }
    return 0;
}

fn nheld()i64 { return 192; }

fn verdict_str(v:i64)[]u8 {
    if (v==1) { return "fact"; }
    if (v==2) { return "opinion"; }
    if (v==3) { return "lie"; }
    return "undetermined";
}

fn trace_text(v:i64,cl:i64,disp:i64)[]u8 {
    if (v==2) { return "stance>=0.12->opinion"; }
    if (v==3) { return "clash+nosupport->lie"; }
    if (v==1) { return "grounded->fact"; }
    if (cl==1) { return "clash+dispute->undetermined"; }
    if (disp==1) { return "dispute+grounded->undetermined"; }
    return "unresolved->undetermined";
}

fn decide(sd:i64,maxw:i64,cl:i64,supp:i64,disp:i64)i64 {
    if (sd>=120) { return 2; }
    if (cl==1) {
        if (supp==0) {
            if (disp==1) { return 0; }
            return 3;
        }
    }
    if (disp==1 && maxw>=2000) { return 0; }
    if (maxw>=3000) { return 1; }
    return 0;
}

fn main()i32 {
    let h:i64=0;
    while (h<nheld()) {
        let v:i64=decide(fsd(h),fmaxw(h),fclash(h),fsupp(h),fdisp(h));
        _zag_print(fid(h));
        _zag_print("\t");
        _zag_print(verdict_str(v));
        _zag_print("\t");
        _zag_print(trace_text(v,fclash(h),fdisp(h)));
        _zag_print("\n");
        h=h+1;
    }
    return 0;
}

// w1a_arm3.zag — WS1-A arm D3: DELIBERATE-UNTRAINED.
// kb_arm3.zag naive policy VERBATIM (promote on first verification, kill on
// first conflict, install-first-ask-later even unverified, victim = lowest
// raw value, PIN first 4 slots filled), driven by the FRESH w1a_gen.zag
// generator, instrumented with W1C white-box counters. Zero RNG.
// Args: cap adv rep.
@import("w1a_common.zag")
@import("w1a_time.zag")

fn w1a_tally3(rc:i32,pf:*i32,pp:*i32,ps:*i32,po:*i32)void {
    if(rc==MA_REFUSED_FULL){pf.*=pf.*+1;}
    else if(rc==MA_REFUSED_PINNED){pp.*=pp.*+1;}
    else if(rc==MA_REFUSED_STAGE){ps.*=ps.*+1;}
    else if(rc!=MA_OK){po.*=po.*+1;}
}

fn w1a_cell_label3(cap:i32,adv:i32,rep:i32)void {
    w1a_tag("cap");w1a_num(cap as i64);
    w1a_tag("a");w1a_num(adv as i64);
    w1a_tag("r");w1a_num(rep as i64);
}

fn w1a_run_naive(cap:i32,adv:i32,rep:i32,loud:i32,c:*W1C)i32 {
    let s:MaStore=ma_init();
    let sp:*MaStore=&s;
    let kid:[]u8=nio_alloc(MA_CAP*4);
    let kver:[]u8=nio_alloc(MA_CAP*4);
    let kctx:[]u8=nio_alloc(MA_CAP*4);
    w1a_side_init(kid,kver,kctx,cap);
    let n_add:i32=0;let n_kill:i32=0;let n_pin:i32=0;let n_prom:i32=0;
    let r_full:i32=0;let r_pinned:i32=0;let r_stage:i32=0;let r_other:i32=0;
    let anom:i32=0;let cref:i32=0;let coll:i32=0;
    let rc:i32=ma_set_stage(sp,MA_STAGE_KILL);
    w1a_tally3(rc,&r_full,&r_pinned,&r_stage,&r_other);
    let n:i32=w1a_total(cap,rep);let nt:i32=w1a_nt(cap);
    let ob:Obs=Obs{.id=0,.op=0,.param=0,.ctx=0,.ver=0};
    let t0:i64=time_ns();
    let e:i32=0;
    while(e<n){
        w1a_ep(cap,adv,e,&ob);
        let id:i32=ob.id;let val:i32=w1a_pack(ob.op,ob.param);
        let fslot:i32=w1a_find(kid,sp,cap,id,c);
        if(fslot>=0){
            let sv:i32=ma_i32_get(s.value,fslot*4);
            if(sv==val){
                if(ob.ver==1){
                    let vc:i32=ma_i32_get(kver,fslot*4)+1;
                    ma_i32_set(kver,fslot*4,vc);
                    if(s.tier[fslot]==MA_TIER_SHORT as u8){
                        rc=ma_promote(sp,fslot);w1a_tally3(rc,&r_full,&r_pinned,&r_stage,&r_other);
                        if(rc==MA_OK){n_prom=n_prom+1;}
                    }
                }
            } else {
                // NAIVE: kill on first conflict — no verification check.
                let vc:i32=ma_i32_get(kver,fslot*4);
                let wastrue:i32=0;
                if(id>=0 && id<nt && sv==w1a_trueval(id) && vc>=6){wastrue=1;}
                rc=ma_kill(sp,fslot);w1a_tally3(rc,&r_full,&r_pinned,&r_stage,&r_other);
                if(rc==MA_OK){
                    n_kill=n_kill+1;
                    if(wastrue==1){coll=coll+1;}
                    w1a_side_clear(kid,kver,kctx,fslot);
                    let nslot:i32=-1;
                    rc=ma_add_lim(sp,val,MA_REGION_USER,cap,&nslot);
                    w1a_tally3(rc,&r_full,&r_pinned,&r_stage,&r_other);
                    if(rc==MA_OK){
                        n_add=n_add+1;
                        ma_i32_set(kid,nslot*4,id);
                        if(ob.ver==1){ma_i32_set(kver,nslot*4,1);}
                        ma_i32_set(kctx,nslot*4,1<<ob.ctx);
                    }
                } else { cref=cref+1; }
            }
        } else {
            // NAIVE: install first, ask later — even UNVERIFIED unknowns.
            let nslot:i32=-1;
            rc=ma_add_lim(sp,val,MA_REGION_USER,cap,&nslot);
            w1a_tally3(rc,&r_full,&r_pinned,&r_stage,&r_other);
            if(rc==MA_OK){
                n_add=n_add+1;
                ma_i32_set(kid,nslot*4,id);
                if(ob.ver==1){ma_i32_set(kver,nslot*4,1);}
                ma_i32_set(kctx,nslot*4,1<<ob.ctx);
                if(n_pin<4){
                    rc=ma_pin(sp,nslot);w1a_tally3(rc,&r_full,&r_pinned,&r_stage,&r_other);
                    if(rc==MA_OK){n_pin=n_pin+1;}
                }
            } else if(rc==MA_REFUSED_FULL){
                // NAIVE victim: lowest RAW VALUE, ignores verification standing.
                c.*.find_steps=c.*.find_steps+(cap as i64);
                let vslot:i32=-1;let vval:i32=2147483647;
                let i:i32=0;
                while(i<cap){
                    if(s.live[i]==1 && s.pinned[i]==0 && s.region[i]==MA_REGION_USER as u8){
                        let vv:i32=ma_i32_get(s.value,i*4);
                        if(vv<vval){vval=vv;vslot=i;}
                    }
                    i=i+1;
                }
                if(vslot>=0){
                    rc=ma_kill(sp,vslot);w1a_tally3(rc,&r_full,&r_pinned,&r_stage,&r_other);
                    if(rc==MA_OK){
                        n_kill=n_kill+1;w1a_side_clear(kid,kver,kctx,vslot);
                        rc=ma_add_lim(sp,val,MA_REGION_USER,cap,&nslot);
                        w1a_tally3(rc,&r_full,&r_pinned,&r_stage,&r_other);
                        if(rc==MA_OK){
                            n_add=n_add+1;
                            ma_i32_set(kid,nslot*4,id);
                            if(ob.ver==1){ma_i32_set(kver,nslot*4,1);}
                            ma_i32_set(kctx,nslot*4,1<<ob.ctx);
                        }
                    }
                }
            }
        }
        e=e+1;
    }
    let t1:i64=time_ns();
    let dg:i32=w1a_digest(sp,kid,kver,kctx,cap);
    c.*.suppress=0;
    c.*.mutops=(n_add+n_kill+n_pin+n_prom+r_full+r_pinned+r_stage+r_other+1) as i64;
    if(loud==1){
        let ec:i32=0;let ew:i32=0;let ea:i32=0;let es:i32=0;
        w1a_tag("WS1A,cell=");w1a_cell_label3(cap,adv,rep);
        w1a_probe(sp,kid,cap,nt,"naive",&ec,&ew,&ea,&es);
        w1a_tag("\n");
        let rrc:i32=ma_replay_check(sp);let crc:i32=ma_audit_clean_refusals(sp);
        w1a_tag("WS1A,cell=");w1a_cell_label3(cap,adv,rep);
        w1a_tag(",arm=naive,cost,find_steps=");w1a_num(c.*.find_steps);
        w1a_tag(",scan_steps=");w1a_num(c.*.scan_steps);
        w1a_tag(",mutops=");w1a_num(c.*.mutops);
        w1a_tag(",suppress=");w1a_num(c.*.suppress);
        w1a_tag(",add=");w1a_num(n_add as i64);w1a_tag(",kill=");w1a_num(n_kill as i64);
        w1a_tag(",pin=");w1a_num(n_pin as i64);w1a_tag(",promote=");w1a_num(n_prom as i64);
        w1a_tag(",collateral=");w1a_num(coll as i64);
        w1a_tag(",audit_n=");w1a_num(s.audit_n as i64);
        w1a_tag(",ledger_bytes=");w1a_num((s.audit_n*40) as i64);
        w1a_tag(",arena_bytes=");w1a_num(w1a_arena_bytes());
        w1a_tag(",replay=");w1a_num(rrc as i64);w1a_tag(",clean=");w1a_num(crc as i64);
        w1a_tag("\n");
        w1a_tag("WS1A,cell=");w1a_cell_label3(cap,adv,rep);
        w1a_tag(",arm=naive,time,wall_ns=");w1a_num(t1-t0);
        w1a_tag(",episodes=");w1a_num(n as i64);
        w1a_tag("\n");
        w1a_tag("WS1A,cell=");w1a_cell_label3(cap,adv,rep);
        w1a_tag(",arm=naive,digest=");w1a_num(dg as i64);w1a_tag("\n");
    }
    nio_free(kid);nio_free(kver);nio_free(kctx);
    return dg;
}

fn main()i32 {
    let cap:i32=w1a_atoi(_zag_arg(1));
    let adv:i32=w1a_atoi(_zag_arg(2));
    let rep:i32=w1a_atoi(_zag_arg(3));
    if(!((cap==32||cap==128||cap==512)&&(adv==0||adv==15||adv==35)&&(rep==1||rep==3))){
        w1a_tag("WS1A,usage: w1a_arm3 cap{32,128,512} adv{0,15,35} rep{1,3}\n");
        return 2;
    }
    let c1:W1C=w1c_init();let c2:W1C=w1c_init();
    let d1:i32=w1a_run_naive(cap,adv,rep,1,&c1);
    let d2:i32=w1a_run_naive(cap,adv,rep,0,&c2);
    w1a_tag("WS1A,cell=");w1a_cell_label3(cap,adv,rep);
    w1a_tag(",arm=naive,determinism,match=");w1a_num((d1==d2) as i64);w1a_tag("\n");
    w1a_tag("WS1A,DONE\n");
    return 0;
}

// learn.zag — ARM L learning mechanism (batch CLI; mechanism code lives in match.zag) (PREREG_WS2L.md §2, MECHANISM.md).
// Pure Zag. Deterministic. Zero RNG.
// ELASTIC (2026-09-25): all arenas grow on demand — no fixed capacities.
// The learner never refuses data for lack of room: relation/veto/lid/pool/
// para/candidate/group/stem tables all double when full, preserving content
// and offsets. Load-bearing ceiling: the znc toolchain cannot index a slice
// larger than 2^25 bytes; growth clamps there (toolchain limit, not a cap).
// Commands:
//   learn dump <dir>    — write <dir>/learn_dump.txt (full store listing)
//   learn ingest <corpus> <dir> — learn from corpus, merge into dir store
// Store: integrated — binary content tables (syntab.bin) + deliberate-memory
// substrate shards (synmem.bin). Every relation/veto is a substrate memory;
// live[] is the authority on belief. learn.log (run summary).
@import("lib.zag")
@import("syn_mem.zag")
@import("match.zag")

// ---------- main ----------
fn main()void {
    let cmd:[]u8=_zag_arg(1);
    // lifecycle: kill|pin|promote <dir> <w1> <w2> — operate on the substrate
    // slot for a relation identified by its raw words. These are the unified
    // TNN memory operations; the substrate is the authority.
    if(bytes_eq(cmd,"kill")==1||bytes_eq(cmd,"pin")==1||bytes_eq(cmd,"promote")==1){
        let dir:[]u8=_zag_arg(2);
        let w1:[]u8=_zag_arg(3); let w2:[]u8=_zag_arg(4);
        let r1o:[]u8=nio_alloc(256); let r1l:[]u8=nio_alloc(256);
        let r2o:[]u8=nio_alloc(256); let r2l:[]u8=nio_alloc(256);
        let rrules:[]u8=nio_alloc(256);
        let lo:[]u8=nio_alloc(1024); let ll:[]u8=nio_alloc(1024);
        let lhead:[]u8=nio_alloc(256); let ltail:[]u8=nio_alloc(256);
        let lnext:[]u8=nio_alloc(1024); let ln:[]u8=nio_alloc(256);
        let v1o:[]u8=nio_alloc(256); let v1l:[]u8=nio_alloc(256);
        let v2o:[]u8=nio_alloc(256); let v2l:[]u8=nio_alloc(256);
        let vlido:[]u8=nio_alloc(256); let vlidl:[]u8=nio_alloc(256);
        let pool:[]u8=nio_alloc(4096);
        let rshard:[]u8=nio_alloc(256); let rslot:[]u8=nio_alloc(256);
        let rsync:[]u8=nio_alloc(256);
        let vshard:[]u8=nio_alloc(256); let vslot:[]u8=nio_alloc(256);
        let vsync:[]u8=nio_alloc(256);
        let nr:i32=0; let nv:i32=0; let nl:i32=0; let pooln:i32=0;
        let db:SynDb=syndb_new();
        syn_load(&db,dir);
        let got:i32=tables_load(dir,&nr,&nv,&nl,&pooln,
            &r1o,&r1l,&r2o,&r2l,&rrules,&lo,&ll,&lhead,&ltail,&lnext,&ln,
            &v1o,&v1l,&v2o,&v2l,&vlido,&vlidl,&pool,
            &rshard,&rslot,&rsync,&vshard,&vslot,&vsync);
        if(got==0){_zag_println("no store");return;}
        // find relation by words (either order)
        let ri:i32=-1; let i:i32=0;
        while(i<nr){
            let a:[]u8=pool[u32get(r1o,i*4) as i32..u32get(r1o,i*4) as i32+u32get(r1l,i*4) as i32];
            let b:[]u8=pool[u32get(r2o,i*4) as i32..u32get(r2o,i*4) as i32+u32get(r2l,i*4) as i32];
            if((bytes_eq(a,w1)==1&&bytes_eq(b,w2)==1)||(bytes_eq(a,w2)==1&&bytes_eq(b,w1)==1)){ri=i;}
            i=i+1;
        }
        if(ri<0){_zag_println("relation not found");return;}
        let sh:i32=u32get(rshard,ri*4) as i32;
        let sl:i32=u32get(rslot,ri*4) as i32;
        if(bytes_eq(cmd,"kill")==1){
            let rc:i32=syn_kill(&db,sh,sl);
            _zag_println(concat("kill rc=",i64s(rc as i64)));
        }
        if(bytes_eq(cmd,"pin")==1){
            let rc:i32=syn_pin(&db,sh,sl);
            _zag_println(concat("pin rc=",i64s(rc as i64)));
        }
        if(bytes_eq(cmd,"promote")==1){
            let rc:i32=syn_promote(&db,sh,sl);
            _zag_println(concat("promote rc=",i64s(rc as i64)));
        }
        syn_save(&db,dir);
        return;
    }
    if(bytes_eq(cmd,"dump")==1){
        let dir:[]u8=_zag_arg(2);
        // load integrated store (tables + substrate)
        let r1o:[]u8=nio_alloc(256); let r1l:[]u8=nio_alloc(256);
        let r2o:[]u8=nio_alloc(256); let r2l:[]u8=nio_alloc(256);
        let rrules:[]u8=nio_alloc(256);
        let lo:[]u8=nio_alloc(1024); let ll:[]u8=nio_alloc(1024);
        let lhead:[]u8=nio_alloc(256); let ltail:[]u8=nio_alloc(256);
        let lnext:[]u8=nio_alloc(1024); let ln:[]u8=nio_alloc(256);
        let v1o:[]u8=nio_alloc(256); let v1l:[]u8=nio_alloc(256);
        let v2o:[]u8=nio_alloc(256); let v2l:[]u8=nio_alloc(256);
        let vlido:[]u8=nio_alloc(256); let vlidl:[]u8=nio_alloc(256);
        let pool:[]u8=nio_alloc(4096);
        let rshard:[]u8=nio_alloc(256); let rslot:[]u8=nio_alloc(256);
        let rsync:[]u8=nio_alloc(256);
        let vshard:[]u8=nio_alloc(256); let vslot:[]u8=nio_alloc(256);
        let vsync:[]u8=nio_alloc(256);
        let nr:i32=0; let nv:i32=0; let nl:i32=0; let pooln:i32=0;
        let db:SynDb=syndb_new();
        syn_load(&db,dir);
        let got:i32=tables_load(dir,&nr,&nv,&nl,&pooln,
            &r1o,&r1l,&r2o,&r2l,&rrules,&lo,&ll,&lhead,&ltail,&lnext,&ln,
            &v1o,&v1l,&v2o,&v2l,&vlido,&vlidl,&pool,
            &rshard,&rslot,&rsync,&vshard,&vslot,&vsync);
        let out:[]u8=nio_alloc(4096);
        let dp:i32=0;
        if(got==0){
            emit(&out,&dp,"(no integrated store)\n");
            f_write(path_join(dir,"learn_dump.txt"),out[0..dp]);
            return;
        }
        emit(&out,&dp,"=== relations (table order) ===\n");
        let oi:i32=0;
        while(oi<nr){
            // liveness from the substrate: the authority on belief
            let lv:i32=syn_is_live(&db,u32get(rshard,oi*4) as i32,u32get(rslot,oi*4) as i32);
            if(lv==1){emit(&out,&dp,"LIVE ");}
            if(lv==0){emit(&out,&dp,"DEAD ");}
            emit_pool(&out,&dp,pool,u32get(r1o,oi*4) as i32,u32get(r1l,oi*4) as i32);
            emit(&out,&dp,"|");
            emit_pool(&out,&dp,pool,u32get(r2o,oi*4) as i32,u32get(r2l,oi*4) as i32);
            emit(&out,&dp,"|");
            emit(&out,&dp,rules_str(u32get(rrules,oi*4) as i32));
            emit(&out,&dp,"|");
            let e2:i32=u32get(lhead,oi*4) as i32;
            let q:i32=0;
            while(e2>=0){
                if(q>0){emit(&out,&dp,",");}
                emit_pool(&out,&dp,pool,u32get(lo,e2*4) as i32,u32get(ll,e2*4) as i32);
                e2=u32get(lnext,e2*4) as i32;
                q=q+1;
            }
            emit(&out,&dp,"\n");
            oi=oi+1;
        }
        emit(&out,&dp,"=== vetoes ===\n");
        oi=0;
        while(oi<nv){
            let lv2:i32=syn_is_live(&db,u32get(vshard,oi*4) as i32,u32get(vslot,oi*4) as i32);
            if(lv2==1){emit(&out,&dp,"LIVE ");}
            if(lv2==0){emit(&out,&dp,"DEAD ");}
            emit_pool(&out,&dp,pool,u32get(v1o,oi*4) as i32,u32get(v1l,oi*4) as i32);
            emit(&out,&dp,"|");
            emit_pool(&out,&dp,pool,u32get(v2o,oi*4) as i32,u32get(v2l,oi*4) as i32);
            emit(&out,&dp,"|R4|");
            emit_pool(&out,&dp,pool,u32get(vlido,oi*4) as i32,u32get(vlidl,oi*4) as i32);
            emit(&out,&dp,"\n");
            oi=oi+1;
        }
        // substrate audit summary
        let cnt:[]u8=syn_count_live(&db,1,1);
        emit(&out,&dp,concat("substrate: live_relations=",i64s(s32get(cnt,0) as i64)));
        emit(&out,&dp,concat(" live_vetoes=",i64s(s32get(cnt,4) as i64)));
        emit(&out,&dp,concat(" shards=",i64s(db.nshards as i64)));
        emit(&out,&dp,"\n");
        f_write(path_join(dir,"learn_dump.txt"),out[0..dp]);
        return;
    }
    if(bytes_eq(cmd,"ingest")!=1){
        f_write(path_join(".","learn_usage.txt"),"usage: learn dump <dir> | learn ingest <corpus> <dir>\n");
        return;
    }
    let corpus:[]u8=_zag_arg(2);
    let dir:[]u8=_zag_arg(3);
    let buf:[]u8=f_read(corpus);
    // all tables start small and grow on demand (no fixed capacities)
    let r1o:[]u8=nio_alloc(256); let r1l:[]u8=nio_alloc(256);
    let r2o:[]u8=nio_alloc(256); let r2l:[]u8=nio_alloc(256);
    let rrules:[]u8=nio_alloc(256);
    let lo:[]u8=nio_alloc(1024); let ll:[]u8=nio_alloc(1024);
    let lhead:[]u8=nio_alloc(256); let ltail:[]u8=nio_alloc(256);
    let lnext:[]u8=nio_alloc(1024); let ln:[]u8=nio_alloc(256);
    let v1o:[]u8=nio_alloc(256); let v1l:[]u8=nio_alloc(256);
    let v2o:[]u8=nio_alloc(256); let v2l:[]u8=nio_alloc(256);
    let vlido:[]u8=nio_alloc(256); let vlidl:[]u8=nio_alloc(256);
    let pool:[]u8=nio_alloc(4096);
    // substrate mapping: (shard,slot,synced) per relation/veto row.
    // The substrate's live[] is the authority on belief; these map each
    // content row to its deliberate-memory slot.
    let rshard:[]u8=nio_alloc(256); let rslot:[]u8=nio_alloc(256);
    let rsync:[]u8=nio_alloc(256);
    let vshard:[]u8=nio_alloc(256); let vslot:[]u8=nio_alloc(256);
    let vsync:[]u8=nio_alloc(256);
    let nr:i32=0; let nl:i32=0; let nv:i32=0; let pooln:i32=0;
    let supp:i32=0;
    // integrated store: load substrate + content tables (replaces the old
    // text-file merge). Tables start empty only when no store exists.
    let db:SynDb=syndb_new();
    syn_load(&db,dir);
    tables_load(dir,&nr,&nv,&nl,&pooln,
        &r1o,&r1l,&r2o,&r2l,&rrules,&lo,&ll,&lhead,&ltail,&lnext,&ln,
        &v1o,&v1l,&v2o,&v2l,&vlido,&vlidl,&pool,
        &rshard,&rslot,&rsync,&vshard,&vslot,&vsync);
    // lhead/ltail: -1 = empty (linked list; lids of one relation need not be
    // contiguous in lo/ll because relations interleave in global nl order).
    // Init covers current capacity; grow_to_fill keeps the invariant on growth.
    let zi:i32=0;
    while(zi*4<lhead.len){
        u32put(lhead,zi*4,4294967295);
        u32put(ltail,zi*4,4294967295);
        u32put(ln,zi*4,0);
        zi=zi+1;
    }
    // PARA accumulation (entries, words, and per-entry word lists all elastic)
    let pso:[]u8=nio_alloc(256); let psl:[]u8=nio_alloc(256);
    let pwn:[]u8=nio_alloc(256); let pws:[]u8=nio_alloc(256);
    let pwo:[]u8=nio_alloc(1024); let pwl:[]u8=nio_alloc(1024);
    let plido:[]u8=nio_alloc(256); let plidl:[]u8=nio_alloc(256);
    let npara:i32=0; let ntotw:i32=0;
    // parse corpus
    let bl:[]u8=lines_of(buf);
    let nlines:i32=line_n(bl);
    let wo:[]u8=nio_alloc(256); let wl:[]u8=nio_alloc(256);
    let k:i32=0;
    while(k<nlines){
        let lin:[]u8=line_slice(buf,bl,k);
        if(lin.len>0&&lin[0]!=35){
            let f:[]u8=fields_of(lin,124,5);
            if(fld_n(f)>=4&&bytes_eq(fa_f(f,lin,0),"LEARN")==1){
                let hlid:[]u8=pool_copy(fa_f(f,lin,1),&pool,&pooln);
                let pat:[]u8=fa_f(f,lin,2);
                if(bytes_eq(pat,"PARA")==1&&fld_n(f)==5){
                    let hs:[]u8=pool_copy(fa_f(f,lin,3),&pool,&pooln);
                    let wn:i32=tokenize_words(fa_f(f,lin,4),&wo,&wl,&pool,&pooln);
                    let pi:i32=npara;
                    grow_to(&pso,(pi+1)*4); grow_to(&psl,(pi+1)*4);
                    grow_to(&pwn,(pi+1)*4); grow_to(&pws,(pi+1)*4);
                    grow_to(&plido,(pi+1)*4); grow_to(&plidl,(pi+1)*4);
                    u32put(pso,pi*4,h_off(hs) as i64); u32put(psl,pi*4,h_len(hs) as i64);
                    u32put(pwn,pi*4,wn as i64);
                    u32put(pws,pi*4,ntotw as i64);
                    u32put(plido,pi*4,h_off(hlid) as i64); u32put(plidl,pi*4,h_len(hlid) as i64);
                    // para words live in one flat arena; pws[pi] is this entry's start
                    let q:i32=0;
                    while(q<wn){
                        grow_to(&pwo,(ntotw+q+1)*4); grow_to(&pwl,(ntotw+q+1)*4);
                        u32put(pwo,(ntotw+q)*4,u32get(wo,q*4));
                        u32put(pwl,(ntotw+q)*4,u32get(wl,q*4));
                        q=q+1;
                    }
                    ntotw=ntotw+wn;
                    npara=pi+1;
                }
                if(bytes_eq(pat,"PARA")!=1&&fld_n(f)==4){
                    let wn:i32=tokenize_words(fa_f(f,lin,3),&wo,&wl,&pool,&pooln);
                    let m4:[]u8=match_r4(pool,wo,wl,wn);
                    if(u32get(m4,0)==1){
                        veto_add(&v1o,&v1l,&v2o,&v2l,&vlido,&vlidl,&nv,&pool,
                            u32get(m4,4) as i32,u32get(m4,8) as i32,
                            u32get(m4,12) as i32,u32get(m4,16) as i32,
                            h_off(hlid),h_len(hlid));
                    }
                    if(u32get(m4,0)!=1){
                        let m1:[]u8=match_r1(pool,wo,wl,wn);
                        let m2:[]u8=match_r2(pool,wo,wl,wn);
                        let mk:i32=0; let mm:[]u8=m1;
                        if(u32get(m1,0)==1){mk=1;}
                        if(u32get(m2,0)==1){mk=2;mm=m2;}
                        if(mk>0){
                            propose(&r1o,&r1l,&r2o,&r2l,&rrules,&nr,
                                &lo,&ll,&lhead,&ltail,&lnext,&ln,&nl,
                                &v1o,&v1l,&v2o,&v2l,nv,&pool,
                                u32get(mm,4) as i32,u32get(mm,8) as i32,
                                u32get(mm,12) as i32,u32get(mm,16) as i32,
                                mk,h_off(hlid),h_len(hlid),&supp);
                        }
                    }
                }
            }
        }
        k=k+1;
    }
    // R3: group PARA entries by subject tag (groups grow on demand)
    let g0:[]u8=nio_alloc(256); let gn:[]u8=nio_alloc(256);
    let gzi:i32=0;
    while(gzi*4<gn.len){ u32put(gn,gzi*4,0); gzi=gzi+1; }
    let ngroups:i32=0;
    let q2:i32=0;
    while(q2<npara){
        let so:i32=u32get(pso,q2*4) as i32; let sl:i32=u32get(psl,q2*4) as i32;
        let g:i32=-1; let q:i32=0;
        while(q<ngroups){
            let e:i32=u32get(g0,q*4) as i32;
            if(weq(pool,u32get(pso,e*4) as i32,u32get(psl,e*4) as i32,so,sl)==1){g=q;}
            q=q+1;
        }
        if(g<0){
            g=ngroups;
            grow_to(&g0,(g+1)*4); grow_to_fill(&gn,(g+1)*4,0);
            u32put(g0,g*4,q2 as i64); u32put(gn,g*4,1);
            ngroups=g+1;
        }
        if(g>=0&&(u32get(g0,g*4) as i32)!=q2){
            u32put(gn,g*4,u32get(gn,g*4)+1);
        }
        q2=q2+1;
    }
    // R3 candidates: one per subject with exactly 2 lines (arrays grow on demand)
    let cxo:[]u8=nio_alloc(256); let cxl:[]u8=nio_alloc(256);
    let cyo:[]u8=nio_alloc(256); let cyl:[]u8=nio_alloc(256);
    let cl1o:[]u8=nio_alloc(256); let cl1l:[]u8=nio_alloc(256);
    let cl2o:[]u8=nio_alloc(256); let cl2l:[]u8=nio_alloc(256);
    let ncand:i32=0;
    let gi:i32=0;
    while(gi<ngroups){
        if(u32get(gn,gi*4)==2){
            let first:i32=u32get(g0,gi*4) as i32;
            let so:i32=u32get(pso,first*4) as i32; let sl:i32=u32get(psl,first*4) as i32;
            let second:i32=-1; let q:i32=0;
            while(q<npara){
                if(q!=first&&weq(pool,u32get(pso,q*4) as i32,u32get(psl,q*4) as i32,so,sl)==1){
                    second=q;
                }
                q=q+1;
            }
            if(second>=0){
                let n1:i32=u32get(pwn,first*4) as i32; let n2:i32=u32get(pwn,second*4) as i32;
                if(n1==n2){
                    let fw:i32=u32get(pws,first*4) as i32;
                    let sw:i32=u32get(pws,second*4) as i32;
                    let diff:i32=0; let dp:i32=0; let w:i32=0;
                    while(w<n1){
                        let a1:i32=u32get(pwo,(fw+w)*4) as i32;
                        let b1:i32=u32get(pwl,(fw+w)*4) as i32;
                        let a2:i32=u32get(pwo,(sw+w)*4) as i32;
                        let b2:i32=u32get(pwl,(sw+w)*4) as i32;
                        if(weq(pool,a1,b1,a2,b2)!=1){diff=diff+1;dp=w;}
                        w=w+1;
                    }
                    if(diff==1){
                        let ci:i32=ncand;
                        grow_to(&cxo,(ci+1)*4); grow_to(&cxl,(ci+1)*4);
                        grow_to(&cyo,(ci+1)*4); grow_to(&cyl,(ci+1)*4);
                        grow_to(&cl1o,(ci+1)*4); grow_to(&cl1l,(ci+1)*4);
                        grow_to(&cl2o,(ci+1)*4); grow_to(&cl2l,(ci+1)*4);
                        u32put(cxo,ci*4,u32get(pwo,(fw+dp)*4));
                        u32put(cxl,ci*4,u32get(pwl,(fw+dp)*4));
                        u32put(cyo,ci*4,u32get(pwo,(sw+dp)*4));
                        u32put(cyl,ci*4,u32get(pwl,(sw+dp)*4));
                        u32put(cl1o,ci*4,u32get(plido,first*4));
                        u32put(cl1l,ci*4,u32get(plidl,first*4));
                        u32put(cl2o,ci*4,u32get(plido,second*4));
                        u32put(cl2l,ci*4,u32get(plidl,second*4));
                        ncand=ci+1;
                    }
                }
            }
        }
        gi=gi+1;
    }
    // install R3 candidates witnessed by >=2 subjects
    let ci2:i32=0;
    while(ci2<ncand){
        let ax:i32=u32get(cxo,ci2*4) as i32; let bx:i32=u32get(cxl,ci2*4) as i32;
        let ay:i32=u32get(cyo,ci2*4) as i32; let by:i32=u32get(cyl,ci2*4) as i32;
        let wit:i32=0; let j:i32=0;
        while(j<ncand){
            let qx:i32=u32get(cxo,j*4) as i32; let qbx:i32=u32get(cxl,j*4) as i32;
            let qy:i32=u32get(cyo,j*4) as i32; let qby:i32=u32get(cyl,j*4) as i32;
            if((weq(pool,ax,bx,qx,qbx)==1&&weq(pool,ay,by,qy,qby)==1)
            ||(weq(pool,ax,bx,qy,qby)==1&&weq(pool,ay,by,qx,qbx)==1)){wit=wit+1;}
            j=j+1;
        }
        if(wit>=2){
            propose(&r1o,&r1l,&r2o,&r2l,&rrules,&nr,
                &lo,&ll,&lhead,&ltail,&lnext,&ln,&nl,
                &v1o,&v1l,&v2o,&v2l,nv,&pool,ax,bx,ay,by,4,
                u32get(cl1o,ci2*4) as i32,u32get(cl1l,ci2*4) as i32,&supp);
            propose(&r1o,&r1l,&r2o,&r2l,&rrules,&nr,
                &lo,&ll,&lhead,&ltail,&lnext,&ln,&nl,
                &v1o,&v1l,&v2o,&v2l,nv,&pool,ax,bx,ay,by,4,
                u32get(cl2o,ci2*4) as i32,u32get(cl2l,ci2*4) as i32,&supp);
        }
        ci2=ci2+1;
    }
    // closure veto-safety: union-find over stems of installed relations (grows)
    let uso:[]u8=nio_alloc(256); let usl:[]u8=nio_alloc(256);
    let upar:[]u8=nio_alloc(256);
    let nst:i32=0;
    let ri:i32=0;
    while(ri<nr){
        let ao:i32=u32get(r1o,ri*4) as i32; let al:i32=u32get(r1l,ri*4) as i32;
        let bo:i32=u32get(r2o,ri*4) as i32; let bl2:i32=u32get(r2l,ri*4) as i32;
        let sa:[]u8=stem(pool[ao..ao+al]); let sb:[]u8=stem(pool[bo..bo+bl2]);
        let ia:i32=uf_add(&uso,&usl,&upar,&nst,&pool,ao,sa.len);
        let ib:i32=uf_add(&uso,&usl,&upar,&nst,&pool,bo,sb.len);
        uf_union(upar,ia,ib);
        ri=ri+1;
    }
    let vi2:i32=0;
    let violation:i32=0;
    while(vi2<nv){
        let ao:i32=u32get(v1o,vi2*4) as i32; let al:i32=u32get(v1l,vi2*4) as i32;
        let bo:i32=u32get(v2o,vi2*4) as i32; let bl2:i32=u32get(v2l,vi2*4) as i32;
        let va:[]u8=stem(pool[ao..ao+al]); let vb:[]u8=stem(pool[bo..bo+bl2]);
        let ia:i32=uf_add(&uso,&usl,&upar,&nst,&pool,ao,va.len);
        let ib:i32=uf_add(&uso,&usl,&upar,&nst,&pool,bo,vb.len);
        if(uf_find(upar,ia)==uf_find(upar,ib)){
            violation=1;
        }
        vi2=vi2+1;
    }
    if(violation==1){
        f_write(path_join(dir,"learn.log"),"VETO VIOLATION: vetoed pair transitively connected — aborting\n");
        return;
    }
    // ---- substrate sync: every relation/veto becomes a deliberate memory ----
    // New rows (rsync==0) are installed via ma_add. Rows whose slot died
    // (killed through the substrate) are re-installed at a fresh slot so
    // re-learned content is believed again; the dead slot stays in the audit.
    grow_to(&rshard,nr*4); grow_to(&rslot,nr*4); grow_to(&rsync,nr*4);
    grow_to(&vshard,nv*4); grow_to(&vslot,nv*4); grow_to(&vsync,nv*4);
    let syi:i32=0;
    while(syi<nr){
        let sh:i32=u32get(rshard,syi*4) as i32;
        let sl:i32=u32get(rslot,syi*4) as i32;
        let synced:i32=u32get(rsync,syi*4) as i32;
        let need:i32=0;
        if(synced==0){need=1;}
        if(synced==1&&syn_is_live(&db,sh,sl)==0){need=1;}
        if(need==1){
            let nsh:i32=0; let nsl:i32=0;
            let rmask:i32=u32get(rrules,syi*4) as i32;
            let rc:i32=syn_install(&db,SYN_VAL_BASE+(rmask&SYN_RULE_MASK),&nsh,&nsl);
            if(rc==MA_OK){
                grow_to(&rshard,(syi+1)*4); grow_to(&rslot,(syi+1)*4);
                grow_to(&rsync,(syi+1)*4);
                let rh1:[]u8=rshard; let rh2:[]u8=rslot; let rh3:[]u8=rsync;
                u32put(rh1,syi*4,nsh as i64); u32put(rh2,syi*4,nsl as i64);
                u32put(rh3,syi*4,1);
                rshard=rh1; rslot=rh2; rsync=rh3;
            }
        }
        syi=syi+1;
    }
    let syv:i32=0;
    while(syv<nv){
        let sh:i32=u32get(vshard,syv*4) as i32;
        let sl:i32=u32get(vslot,syv*4) as i32;
        let synced:i32=u32get(vsync,syv*4) as i32;
        let need:i32=0;
        if(synced==0){need=1;}
        if(synced==1&&syn_is_live(&db,sh,sl)==0){need=1;}
        if(need==1){
            let nsh:i32=0; let nsl:i32=0;
            let rc:i32=syn_install(&db,VETO_VAL,&nsh,&nsl);
            if(rc==MA_OK){
                grow_to(&vshard,(syv+1)*4); grow_to(&vslot,(syv+1)*4);
                grow_to(&vsync,(syv+1)*4);
                let vh1:[]u8=vshard; let vh2:[]u8=vslot; let vh3:[]u8=vsync;
                u32put(vh1,syv*4,nsh as i64); u32put(vh2,syv*4,nsl as i64);
                u32put(vh3,syv*4,1);
                vshard=vh1; vslot=vh2; vsync=vh3;
            }
        }
        syv=syv+1;
    }
    // ---- persist the integrated store (tables + substrate) ----
    tables_save(dir,nr,nv,nl,pooln,
        r1o,r1l,r2o,r2l,rrules,lo,ll,lhead,ltail,lnext,ln,
        v1o,v1l,v2o,v2l,vlido,vlidl,pool,
        rshard,rslot,rsync,vshard,vslot,vsync);
    syn_save(&db,dir);
    let lg1:[]u8=concat("learn: ok lines=",i64s(nlines as i64));
    let lg2:[]u8=concat(lg1,concat(" relations=",i64s(nr as i64)));
    let lg3:[]u8=concat(lg2,concat(" vetoes=",i64s(nv as i64)));
    let lg4:[]u8=concat(lg3,concat(" suppressed=",i64s(supp as i64)));
    f_write(path_join(dir,"learn.log"),concat(lg4,"\n"));
    return;
}

// ============================================================
// disc.zag — IMAGINATION DISCOVERY image pipeline (pure Zag).
// ROUND 3 rebuild (2026-09-22): both scene builders rewritten from
// scratch to close the round-2 blind tells structurally.
//
// D-IMG-1 "alien": three depth planes with THREE DIFFERENT field
//   generators (far = terraced massifs, mid = faulted crags, near =
//   boulder talus with lava) — never one generator x3; per-plane
//   palettes and aerial perspective; valley fog knits the planes
//   into one continuous depth; the ringed planet is real 3D: a
//   tilted annulus with analytic front/back occlusion, soft
//   anti-aliased edges, the planet's shadow solved on the ring in
//   3D, the ring's shadow solved on the disc through the ring
//   plane, latitude-parallel bands (no tiling) plus two explicit
//   storm cells, terminator + limb darkening tied to the one scene
//   sun, and a sun-asymmetric forward-scatter halo that lights the
//   cirrus drifting in front of the limb.
// D-IMG-2 "arch": impossible triangle with TRUE mitered joinery —
//   beams meet edge-to-edge along the miter bisector (no overhang
//   lip); the cyclic over/under is carried by seam shading alone
//   (highlight lip on the winner's side, dark seam + contact AO on
//   the loser's); ALL beam texture is sampled in beam-local
//   (along, across) coordinates so grain/scratches/cracks run WITH
//   the beam; wear concentrates at edges and joints (geometry-
//   derived); one sun gives identical warm/cool treatment on all
//   three beams; the starfield fades smoothly into the wall (no
//   hard cut); the floor is a real perspective flagstone plane
//   with slab variation, a light pool, and the frame's shadow.
//
// Composition is GENUINE GENERATIVE: every pixel is evaluated from
// continuous fields. ZERO axis-aligned filled-primitive placement
// calls in the scene builders — all coverage is per-pixel analytic
// tests (point-in-convex-quad, radial falloff, 3D ray tests).
//
// Rasterizes DIRECTLY into the pixel buffer (one []u8 of W*H*3
// bytes, rows bottom-up for BMP). 1024^2*3 = 3.1MB, 2048^2*3 =
// 12.6MB — both far under the 2^25 slice limit.
//
// Deterministic: integer hash noise, fixed seeds, no RNG anywhere.
// Fine monochromatic hash dither (+-3 LSB) keeps gradients smooth.
//
// Build: znc disc.zag --no-zagd --no-analyze -o disc
// Usage: disc <alien|arch> <outdir> <1024|2048>
// ============================================================
@import("../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- byte helpers ----------------
fn d_put32le(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
}

// ---------------- small math ----------------
fn d_abs(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}
fn d_clamp(v:i64, lo:i64, hi:i64) i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}
fn d_min(a:i64, b:i64) i64 {
    if (a < b) { return a; }
    return b;
}
// smoothstep on 0..1024 -> 0..1024
fn d_ss(t:i64) i64 {
    let c:i64 = d_clamp(t, 0, 1024);
    return c * c * (3072 - 2 * c) / 1048576;
}
// integer sqrt (Newton, deterministic)
fn d_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let r:i64 = v;
    let i:i64 = 0;
    while (i < 64) {
        r = (r + v / r) / 2;
        i = i + 1;
    }
    return r;
}
// f64 sqrt (Newton, deterministic)
fn d_sqrt(x:f64) f64 {
    if (x <= 0.0) { return 0.0; }
    let r:f64 = x;
    if (r < 1.0) { r = 1.0; }
    let i:i64 = 0;
    while (i < 24) {
        r = 0.5 * (r + x / r);
        i = i + 1;
    }
    return r;
}

// ---------------- deterministic integer-hash noise ----------------
// All coordinates are i64 fixed-point with FB=8 fractional bits.
// d_hash -> 0..2^32-1. Masked to stay non-negative so shifts are safe.
fn d_hash(x:i64, y:i64, seed:i64) i64 {
    let h:i64 = (x * 374761393 + y * 668265263 + seed * 2246822519) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    h = (h * 3266489917) & 4294967295;
    h = (h ^ (h >> 13)) & 4294967295;
    h = (h * 1103515245 + 12345) & 4294967295;
    h = (h ^ (h >> 16)) & 4294967295;
    return h;
}
// hash -> 0..1023
fn d_h01(x:i64, y:i64, seed:i64) i64 {
    return d_hash(x, y, seed) >> 22;
}
// smoothstep weight 0..255 -> 0..255
fn d_sstep(t:i64) i64 {
    let t2:i64 = t * t;
    let t3:i64 = t2 * t;
    return (3 * t2 * 255 - 2 * t3) / 65025;
}
// value noise, x/y fixed-point FB=8 -> 0..1023
fn d_vnoise(x:i64, y:i64, seed:i64) i64 {
    let xb:i64 = x + 268435456;
    let yb:i64 = y + 268435456;
    let xi:i64 = xb >> 8;
    let yi:i64 = yb >> 8;
    let xf:i64 = xb & 255;
    let yf:i64 = yb & 255;
    let u:i64 = d_sstep(xf);
    let v:i64 = d_sstep(yf);
    let a:i64 = d_h01(xi, yi, seed);
    let b:i64 = d_h01(xi + 1, yi, seed);
    let c:i64 = d_h01(xi, yi + 1, seed);
    let d:i64 = d_h01(xi + 1, yi + 1, seed);
    let ab:i64 = a + (b - a) * u / 256;
    let cd:i64 = c + (d - c) * u / 256;
    return ab + (cd - ab) * v / 256;
}
// fractal Brownian motion, oct octaves -> 0..1023
fn d_fbm(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        sum = sum + d_vnoise(xx, yy, seed + o * 131) * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 512; }
    return sum * 512 / norm;
}
// ridged fBm (mountain-like), oct octaves -> 0..1023
fn d_ridge(x:i64, y:i64, seed:i64, oct:i64) i64 {
    let sum:i64 = 0;
    let amp:i64 = 512;
    let norm:i64 = 0;
    let xx:i64 = x;
    let yy:i64 = y;
    let o:i64 = 0;
    while (o < oct) {
        let n:i64 = d_vnoise(xx, yy, seed + o * 131);
        let r:i64 = 1023 - d_abs(n + n - 1023);
        r = r * r / 1023;
        sum = sum + r * amp / 512;
        norm = norm + amp;
        xx = xx + xx;
        yy = yy + yy;
        amp = amp / 2;
        o = o + 1;
    }
    if (norm == 0) { return 0; }
    return sum * 512 / norm;
}
// pack/unpack RGB
fn d_pack(r:i64, g:i64, b:i64) i64 {
    return (r & 255) + ((g & 255) << 8) + ((b & 255) << 16);
}
fn d_lerp(a:i64, b:i64, t:i64) i64 {
    return a + (b - a) * t / 1024;
}

// ============================================================
// D-IMG-1 "alien planet" — round 3 rebuild.
// One sun for the whole scene: S ~ (-450,-750,490)/1002
// (screen x right, y DOWN, z toward viewer): upper-left, raking.
// Three depth planes, three DIFFERENT generators:
//   far  = terraced massifs (quantized domes, strata risers)
//   mid  = faulted crags (ridged + fault steps, contour strata)
//   near = boulder talus (per-cell mounds, lava in the lows)
// Valley fog between planes knits one continuous depth.
// The planet is real 3D: tilted annulus, analytic occlusion,
// soft edges, 3D shadows both ways, latitude bands, storms.
// ============================================================

// silhouette edges of the three depth planes (strictly ordered)
fn d_a_edge_far(x:i64, h0:i64, seed:i64) i64 {
    let mass:i64 = d_ridge((x << 8) / 150, 13, seed + 221, 3);
    let sw:i64 = d_fbm((x << 8) / 400, 17, seed + 222, 2);
    let m:i64 = (mass * 640 + sw * 384) / 1024;
    return h0 - (m - 512) * 300 / 1024;
}
fn d_a_edge_mid(x:i64, ef:i64, seed:i64) i64 {
    let crag:i64 = d_ridge((x << 8) / 90, 19, seed + 223, 3);
    let gap:i64 = d_fbm(x << 2, 31, seed + 224, 2);
    return ef + 120 + (gap - 512) * 50 / 1024 + (crag - 512) * 120 / 1024;
}
fn d_a_edge_near(x:i64, em:i64, seed:i64) i64 {
    let scr:i64 = d_ridge((x << 8) / 60, 23, seed + 225, 3);
    let gap:i64 = d_fbm(x << 2, 77, seed + 226, 2);
    return em + 110 + (gap - 512) * 50 / 1024 + (scr - 512) * 120 / 1024;
}

// sky base: gradient + sun glow + billowy deck + high cirrus (no planet)
fn d_a_skybase(x:i64, y:i64, w:i64, h:i64, hy:i64, seed:i64) i64 {
    let t01:i64 = y * 1024 / hy;
    let r:i64 = 16; let g:i64 = 22; let b:i64 = 84;
    if (t01 < 512) {
        let t:i64 = t01 * 2;
        r = d_lerp(16, 30, t); g = d_lerp(22, 106, t); b = d_lerp(84, 150, t);
    } else {
        let t:i64 = (t01 - 512) * 2;
        r = d_lerp(30, 170, t); g = d_lerp(106, 216, t); b = d_lerp(150, 210, t);
    }
    let sgx:i64 = x - w * 18 / 100;
    let sgy:i64 = y - h * 8 / 100;
    let sg2:i64 = sgx * sgx + sgy * sgy;
    let glow:i64 = 1048576 / (1024 + sg2 / 90);
    if (glow > 1024) { glow = 1024; }
    r = r + 72 * glow / 1024; g = g + 80 * glow / 1024; b = b + 62 * glow / 1024;
    let qx:i64 = d_fbm(x << 2, y << 2, seed + 111, 3);
    let qy:i64 = d_fbm((x << 2) + 40961, (y << 2) + 17331, seed + 112, 3);
    let ux:i64 = x * 640 / w;
    let uy:i64 = 0;
    if (hy > 0) { uy = y * 320 / hy; }
    let cx:i64 = ux + (qx - 512) / 10;
    let cy:i64 = uy + (qy - 512) / 10;
    let cloud:i64 = d_fbm(cx, cy, seed + 113, 4);
    let m:i64 = d_ss((cloud - 530) * 1024 / 300);
    if (m > 0) {
        let c2:i64 = d_fbm(cx - 22, cy - 16, seed + 113, 4);
        let sf:i64 = d_clamp((c2 - cloud) * 2, -170, 170);
        let sh:i64 = 780 + sf;
        let cr2:i64 = 232 * sh / 1024; let cg2:i64 = 242 * sh / 1024; let cb2:i64 = 246 * sh / 1024;
        r = d_lerp(r, cr2, m); g = d_lerp(g, cg2, m); b = d_lerp(b, cb2, m);
    }
    let ci:i64 = d_fbm((x << 8) / 300, (y << 8) / 64, seed + 115, 3);
    let m2:i64 = d_ss((ci - 590) * 1024 / 210) * 420 / 1024;
    if (m2 > 0) {
        r = d_lerp(r, 218, m2); g = d_lerp(g, 230, m2); b = d_lerp(b, 240, m2);
    }
    r = d_clamp(r, 0, 255); g = d_clamp(g, 0, 255); b = d_clamp(b, 0, 255);
    return d_pack(r, g, b);
}

// cloud mask (for peaks rising through cloud banks)
fn d_a_cloudm(x:i64, y:i64, w:i64, hy:i64, seed:i64) i64 {
    let qx:i64 = d_fbm(x << 2, y << 2, seed + 111, 3);
    let qy:i64 = d_fbm((x << 2) + 40961, (y << 2) + 17331, seed + 112, 3);
    let ux:i64 = x * 640 / w;
    let uy:i64 = 0;
    if (hy > 0) { uy = y * 320 / hy; }
    let cx:i64 = ux + (qx - 512) / 10;
    let cy:i64 = uy + (qy - 512) / 10;
    let cloud:i64 = d_fbm(cx, cy, seed + 113, 4);
    return d_ss((cloud - 530) * 1024 / 300);
}

// ring alpha profile: smooth tapers, one Cassini-style division,
// fine radial striations (1D in radius — cannot tile)
fn d_a_ringalpha(rr:i64, rin:i64, rout:i64, rp:i64, seed:i64) i64 {
    let tw:i64 = rp * 2 / 10 + 1;
    let tin:i64 = d_ss((rr - rin) * 1024 / tw);
    let tout:i64 = 1024 - d_ss((rr - (rout - rp * 2 / 10)) * 1024 / tw);
    let a:i64 = tin;
    if (tout < a) { a = tout; }
    let rdiv:i64 = rp * 178 / 100;
    let gapw:i64 = rp * 9 / 100 + 1;
    let gd:i64 = d_abs(rr - rdiv);
    let gap:i64 = d_ss((gd - gapw / 2) * 1024 / gapw);
    a = a * (260 + 764 * gap / 1024) / 1024;
    let st:i64 = d_fbm(rr * 3, 777, seed + 117, 3);
    a = a * (760 + st * 264 / 1024) / 1024;
    if (a < 0) { a = 0; }
    if (a > 1024) { a = 1024; }
    return a;
}

// planet shadow depth on a 3D point P=(px,py,pz) rel planet center,
// 0..1024. Ray toward the sun; soft penumbra via impact parameter.
fn d_a_pshadow(px:i64, py:i64, pz:i64, rp:i64) i64 {
    let ps:i64 = px * (0 - 450) + py * (0 - 750) + pz * 490;
    if (ps >= 0) { return 0; }
    let pp:i64 = px * px + py * py + pz * pz;
    let ip2:i64 = pp - ps * ps / 1004004;
    if (ip2 < 0) { ip2 = 0; }
    let ip:i64 = d_isqrt(ip2);
    let sh:i64 = 1024 - d_ss((ip - rp * 96 / 100) * 1024 / (rp * 10 / 100 + 1));
    if (sh < 0) { sh = 0; }
    if (sh > 1024) { sh = 1024; }
    return sh;
}

// 5-stop planet palette (deep teal -> ice)
fn d_pal_p(v:i64) i64 {
    let vv:i64 = d_clamp(v, 0, 1023);
    let bi:i64 = vv * 4 / 1024;
    if (bi > 3) { bi = 3; }
    let fr:i64 = vv * 4 - bi * 1024;
    let r0:i64 = 14; let g0:i64 = 58; let b0:i64 = 78;
    let r1:i64 = 30; let g1:i64 = 118; let b1:i64 = 138;
    let r2:i64 = 120; let g2:i64 = 190; let b2:i64 = 190;
    let r3:i64 = 218; let g3:i64 = 224; let b3:i64 = 200;
    let r4:i64 = 168; let g4:i64 = 208; let b4:i64 = 226;
    let ra:i64 = r0; let ga:i64 = g0; let ba:i64 = b0;
    let rb:i64 = r1; let gb:i64 = g1; let bb:i64 = b1;
    if (bi == 1) { ra = r1; ga = g1; ba = b1; rb = r2; gb = g2; bb = b2; }
    if (bi == 2) { ra = r2; ga = g2; ba = b2; rb = r3; gb = g3; bb = b3; }
    if (bi == 3) { ra = r3; ga = g3; ba = b3; rb = r4; gb = g4; bb = b4; }
    return d_pack(d_lerp(ra, rb, fr), d_lerp(ga, gb, fr), d_lerp(ba, bb, fr));
}

// the ringed planet, composited over the sky color (r,g,b in).
// Real 3D: inclination -28 deg (cos 883/1000, tan -532/1000).
fn d_a_planet(x:i64, y:i64, w:i64, h:i64, r:i64, g:i64, b:i64, seed:i64) i64 {
    let pcx:i64 = w * 68 / 100;
    let pcy:i64 = h * 20 / 100;
    let rp:i64 = w * 15 / 100;
    let pdx:i64 = x - pcx;
    let pdy:i64 = y - pcy;
    let d2:i64 = pdx * pdx + pdy * pdy;
    let dist:i64 = d_isqrt(d2);
    let v:i64 = pdy * 1000 / 883;
    let rr:i64 = d_isqrt(pdx * pdx + v * v);
    let rin:i64 = rp * 13 / 10;
    let rout:i64 = rp * 23 / 10;
    let covd:i64 = 1024 - d_ss((dist - rp + 1) * 1024 / 2);
    if (covd < 0) { covd = 0; }
    if (covd > 1024) { covd = 1024; }
    let covri:i64 = d_ss((rr - rin + 1) * 1024 / 2);
    let covro:i64 = 1024 - d_ss((rr - rout + 1) * 1024 / 2);
    let covr:i64 = covri;
    if (covro < covr) { covr = covro; }
    if (covr < 0) { covr = 0; }
    if (covr > 1024) { covr = 1024; }
    let zr:i64 = pdy * 532 / 1000;
    // ---- forward-scatter halo (sun-side asymmetric), under the disc
    if (dist > rp - 2 && dist < rp * 16 / 10) {
        let dh:i64 = dist - rp;
        if (dh < 0) { dh = 0; }
        let hh:i64 = 1024 - dh * 1024 / (rp * 6 / 10);
        if (hh > 0) {
            hh = hh * hh / 1024;
            let sfx:i64 = 0; let sfy:i64 = 0;
            if (dist > 0) { sfx = pdx * 1024 / dist; sfy = pdy * 1024 / dist; }
            let an:i64 = (sfx * (0 - 950) + sfy * (0 - 260)) / 1024;
            let fwd:i64 = 560 + 464 * an / 1024;
            if (fwd < 120) { fwd = 120; }
            let ha:i64 = hh * fwd / 1024 * 420 / 1024;
            r = r + 148 * ha / 1024; g = g + 190 * ha / 1024; b = b + 228 * ha / 1024;
        }
    }
    // ---- back ring (analytic behind/in-front test, planet shadow in 3D)
    if (covr > 0) {
        let zs:i64 = 0;
        let inside:i64 = 0;
        if (d2 < rp * rp) { inside = 1; zs = d_isqrt(rp * rp - d2); }
        let front:i64 = 0;
        if (inside == 1 && zr >= zs) { front = 1; }
        if (inside == 0 && zr > 0) { front = 1; }
        if (front == 0) {
            let alpha:i64 = d_a_ringalpha(rr, rin, rout, rp, seed);
            let sh:i64 = d_a_pshadow(pdx, pdy, zr, rp);
            let litf:i64 = 1024 - sh * 760 / 1024;
            let rb:i64 = 208 * litf / 1024;
            let gb2:i64 = 224 * litf / 1024;
            let bb2:i64 = 236 * litf / 1024;
            let warm:i64 = 1024 - (rr - rin) * 1024 / (rout - rin);
            rb = rb + warm * 14 / 1024;
            let am:i64 = alpha * covr / 1024 * 880 / 1024;
            r = d_lerp(r, rb, am); g = d_lerp(g, gb2, am); b = d_lerp(b, bb2, am);
        }
    }
    // ---- planet disc
    if (covd > 0) {
        let zs:i64 = d_isqrt(rp * rp - d2);
        let nx:i64 = pdx * 1024 / rp;
        let ny:i64 = pdy * 1024 / rp;
        let nz:i64 = zs * 1024 / rp;
        let dot:i64 = (nx * (0 - 450) + ny * (0 - 750) + nz * 490) / 1002;
        let lit:i64 = d_ss((dot + 90) * 1024 / 180);
        let mu:i64 = nz;
        let ld:i64 = 360 + 664 * mu / 1024;
        // latitude from the ring plane; bands run parallel to the rings
        let sinphi:i64 = (ny * (0 - 469) + nz * 883) / 1000;
        let w1:i64 = d_fbm(pdx * 2, pdy * 2, seed + 131, 3);
        let bc:i64 = sinphi * 3 + (w1 - 512) / 6;
        let bandn:i64 = d_fbm(bc * 2 + 40000, 913, seed + 119, 4);
        let col:i64 = d_pal_p(bandn);
        let cr:i64 = col & 255; let cg:i64 = (col >> 8) & 255; let cb:i64 = (col >> 16) & 255;
        // storm A: pale oval with rotational warp (explicit feature)
        let sdx:i64 = pdx + rp * 22 / 100;
        let sdy:i64 = pdy + rp * 34 / 100;
        let rx:i64 = rp / 8; let ry:i64 = rp / 12;
        let qq:i64 = (sdx * sdx * 1024) / (rx * rx) + (sdy * sdy * 1024) / (ry * ry);
        if (qq < 1024) {
            let sw:i64 = 1024 - qq;
            let wx2:i64 = pdx + sdy * sw / 1024 / 2;
            let wy2:i64 = pdy - sdx * sw / 1024 / 2;
            let w3:i64 = d_fbm(wx2 * 2, wy2 * 2, seed + 132, 3);
            let bc2:i64 = sinphi * 3 + (w3 - 512) / 4;
            let bn2:i64 = d_fbm(bc2 * 2 + 40000, 913, seed + 119, 4);
            let col2:i64 = d_pal_p(bn2);
            let msk:i64 = 1024 - d_ss((qq - 700) * 1024 / 324);
            cr = d_lerp(cr, col2 & 255, msk);
            cg = d_lerp(cg, (col2 >> 8) & 255, msk);
            cb = d_lerp(cb, (col2 >> 16) & 255, msk);
            let rim2:i64 = 1024 - d_ss(d_abs(qq - 860) * 1024 / 160);
            cr = cr + rim2 * 30 / 1024; cg = cg + rim2 * 26 / 1024; cb = cb + rim2 * 20 / 1024;
        }
        // storm B: rust oval (explicit feature)
        let sdx2:i64 = pdx - rp * 30 / 100;
        let sdy2:i64 = pdy - rp * 10 / 100;
        let rx2:i64 = rp / 10; let ry2:i64 = rp / 14;
        let qq2:i64 = (sdx2 * sdx2 * 1024) / (rx2 * rx2) + (sdy2 * sdy2 * 1024) / (ry2 * ry2);
        if (qq2 < 1024) {
            let msk2:i64 = 1024 - d_ss((qq2 - 700) * 1024 / 324);
            cr = d_lerp(cr, 198, msk2);
            cg = d_lerp(cg, 124, msk2);
            cb = d_lerp(cb, 86, msk2);
            let rim3:i64 = 1024 - d_ss(d_abs(qq2 - 860) * 1024 / 160);
            cr = cr + rim3 * 34 / 1024; cg = cg + rim3 * 22 / 1024; cb = cb + rim3 * 12 / 1024;
        }
        // ring shadow on the disc: ray toward sun through the ring plane
        let shade:i64 = 1024;
        let psn:i64 = pdy * (0 - 469) + zs * 883;
        let lam:i64 = (0 - psn) * 1002 / 784420;
        if (lam > 0) {
            let qx:i64 = pdx + lam * (0 - 450) / 1002;
            let qy:i64 = pdy + lam * (0 - 750) / 1002;
            let qz:i64 = zs + lam * 490 / 1002;
            let q2:i64 = (qy * 883 + qz * 469) / 1000;
            let rq:i64 = d_isqrt(qx * qx + q2 * q2);
            if (rq > rin && rq < rout) {
                let ra:i64 = d_a_ringalpha(rq, rin, rout, rp, seed);
                shade = 1024 - ra * 560 / 1024;
            }
        }
        let li:i64 = ld * (200 + 824 * lit / 1024) / 1024;
        let night:i64 = 1024 - lit;
        cr = cr * li / 1024 * shade / 1024 + 26 * night / 1024;
        cg = cg * li / 1024 * shade / 1024 + 44 * night / 1024;
        cb = cb * li / 1024 * shade / 1024 + 66 * night / 1024;
        // limb haze, brightened on the sun side
        let limbd:i64 = dist * 1024 / rp;
        let haze:i64 = d_ss((limbd - 880) * 1024 / 144);
        if (haze > 0) {
            let sunf:i64 = 300 + 724 * d_clamp(dot, 0, 1024) / 1024;
            let ha2:i64 = haze * 400 / 1024;
            cr = d_lerp(cr, 148 * sunf / 1024, ha2);
            cg = d_lerp(cg, 188 * sunf / 1024, ha2);
            cb = d_lerp(cb, 226 * sunf / 1024, ha2);
        }
        r = d_lerp(r, d_clamp(cr, 0, 255), covd);
        g = d_lerp(g, d_clamp(cg, 0, 255), covd);
        b = d_lerp(b, d_clamp(cb, 0, 255), covd);
    }
    // ---- front ring
    if (covr > 0) {
        let zs:i64 = 0;
        let inside:i64 = 0;
        if (d2 < rp * rp) { inside = 1; zs = d_isqrt(rp * rp - d2); }
        let front:i64 = 0;
        if (inside == 1 && zr >= zs) { front = 1; }
        if (inside == 0 && zr > 0) { front = 1; }
        if (front == 1) {
            let alpha:i64 = d_a_ringalpha(rr, rin, rout, rp, seed);
            let sh:i64 = d_a_pshadow(pdx, pdy, zr, rp);
            let litf:i64 = 1024 - sh * 760 / 1024;
            let rb:i64 = 214 * litf / 1024;
            let gb2:i64 = 228 * litf / 1024;
            let bb2:i64 = 240 * litf / 1024;
            let warm:i64 = 1024 - (rr - rin) * 1024 / (rout - rin);
            rb = rb + warm * 12 / 1024;
            let am:i64 = alpha * covr / 1024 * 880 / 1024;
            r = d_lerp(r, rb, am); g = d_lerp(g, gb2, am); b = d_lerp(b, bb2, am);
        }
    }
    // ---- thin cirrus wisps drifting in front of the lower limb
    if (dist < rp * 15 / 10 && pdy > (0 - rp / 4)) {
        let ci:i64 = d_fbm((x << 8) / 420, (y << 8) / 90, seed + 141, 3);
        let m2:i64 = d_ss((ci - 600) * 1024 / 190);
        let wfall:i64 = 1024 - d_ss((dist - rp) * 1024 / (rp * 5 / 10 + 1));
        m2 = m2 * (480 + 544 * wfall / 1024) / 1024;
        if (m2 > 0) {
            let wa:i64 = m2 * 460 / 1024;
            r = d_lerp(r, 216, wa); g = d_lerp(g, 230, wa); b = d_lerp(b, 240, wa);
        }
    }
    r = d_clamp(r, 0, 255); g = d_clamp(g, 0, 255); b = d_clamp(b, 0, 255);
    return d_pack(r, g, b);
}

fn d_a_sky_px(x:i64, y:i64, w:i64, h:i64, hy:i64, seed:i64) i64 {
    let col:i64 = d_a_skybase(x, y, w, h, hy, seed);
    let r:i64 = col & 255; let g:i64 = (col >> 8) & 255; let b:i64 = (col >> 16) & 255;
    let pcx:i64 = w * 68 / 100;
    let pcy:i64 = h * 20 / 100;
    let rp:i64 = w * 15 / 100;
    let pdx:i64 = x - pcx;
    let pdy:i64 = y - pcy;
    let bound:i64 = rp * 24 / 10;
    if (pdx > (0 - bound) && pdx < bound && pdy > (0 - bound) && pdy < bound) {
        return d_a_planet(x, y, w, h, r, g, b, seed);
    }
    return d_pack(r, g, b);
}

// ---------- FAR: terraced massifs ----------
// packed terrace coords: tq*1024 + tf
fn d_a_far_hq(x:i64, y:i64, seed:i64) i64 {
    let q1:i64 = d_fbm((x << 8) / 420, (y << 8) / 420, seed + 411, 3);
    let q2:i64 = d_fbm((x << 8) / 420 + 30011, (y << 8) / 420 + 51113, seed + 412, 3);
    let wx:i64 = (x << 8) / 150 + (q1 - 512) * 2;
    let wy:i64 = (y << 8) / 150 + (q2 - 512) * 2;
    let hh:i64 = d_ridge(wx, wy, seed + 413, 3);
    let tq:i64 = hh * 6 / 1024;
    if (tq > 5) { tq = 5; }
    let tf:i64 = hh * 6 - tq * 1024;
    return tq * 1024 + tf;
}
fn d_a_far_hs(x:i64, y:i64, seed:i64) i64 {
    let q1:i64 = d_fbm((x << 8) / 420, (y << 8) / 420, seed + 411, 2);
    let wx:i64 = (x << 8) / 150 + (q1 - 512) * 2;
    let wy:i64 = (y << 8) / 150 + (q1 - 512) * 2;
    return d_ridge(wx, wy, seed + 413, 2);
}
fn d_a_far(x:i64, y:i64, edge:i64, h:i64, w:i64, h0:i64, seed:i64) i64 {
    let den:i64 = h - edge;
    if (den < 1) { den = 1; }
    let t:i64 = (y - edge) * 1024 / den;
    if (t < 0) { t = 0; }
    if (t > 1024) { t = 1024; }
    let q:i64 = d_a_far_hq(x, y, seed);
    let tq:i64 = q / 1024;
    let tf:i64 = q - tq * 1024;
    let tes:i64 = d_ss(d_clamp((tf - 660) * 1024 / 364, 0, 1024));
    let gx:i64 = (d_a_far_hs(x + 8, y, seed) - d_a_far_hs(x - 8, y, seed)) / 16;
    let gy:i64 = (d_a_far_hs(x, y + 8, seed) - d_a_far_hs(x, y - 8, seed)) / 16;
    let num:i64 = gx * 450 + gy * 750 + 125440;
    let den2:i64 = d_isqrt(gx * gx + gy * gy + 65536) * 1002;
    let dot1024:i64 = num * 1024 / den2;
    let shade:i64 = d_clamp(dot1024 * 1100 / 1024, 180, 1350);
    shade = shade * (1024 - 320 * tes / 1024) / 1024;
    let tm:i64 = tq - (tq / 3) * 3;
    let tr:i64 = 92; let tg:i64 = 100; let tb:i64 = 132;
    if (tm == 1) { tr = 110; tg = 118; tb = 146; }
    if (tm == 2) { tr = 80; tg = 88; tb = 120; }
    let jit:i64 = (d_h01(tq, 7, seed + 414) - 512) / 16;
    let r:i64 = (tr + jit) * shade / 1024;
    let g:i64 = (tg + jit) * shade / 1024;
    let b:i64 = (tb + jit) * shade / 1024;
    let det:i64 = d_fbm((x << 8) / 22, (y << 8) / 22, seed + 415, 3);
    let dm:i64 = 920 + det * 160 / 1024;
    r = r * dm / 1024; g = g * dm / 1024; b = b * dm / 1024;
    let air:i64 = 420 + (1024 - t) * 180 / 1024;
    r = d_lerp(r, 168, air); g = d_lerp(g, 192, air); b = d_lerp(b, 226, air);
    if (t < 48) {
        let rim:i64 = 1024 - t * 1024 / 48;
        let sunf:i64 = d_clamp(dot1024, 0, 1024);
        r = r + rim * sunf / 1024 * 120 / 1024;
        g = g + rim * sunf / 1024 * 104 / 1024;
        b = b + rim * sunf / 1024 * 84 / 1024;
    }
    if (t < 130) {
        let cm:i64 = d_a_cloudm(x, y, w, h0, seed);
        let cf:i64 = cm * (1024 - t * 1024 / 130) / 1024 * 560 / 1024;
        r = d_lerp(r, 226, cf); g = d_lerp(g, 236, cf); b = d_lerp(b, 242, cf);
    }
    r = d_clamp(r, 0, 255); g = d_clamp(g, 0, 255); b = d_clamp(b, 0, 255);
    return d_pack(r, g, b);
}

// ---------- MID: faulted crags ----------
fn d_a_mid_hq(x:i64, y:i64, seed:i64) i64 {
    let q1:i64 = d_fbm((x << 8) / 200, (y << 8) / 200, seed + 421, 3);
    let q2:i64 = d_fbm((x << 8) / 200 + 30011, (y << 8) / 200 + 51113, seed + 422, 3);
    let wx:i64 = (x << 8) / 48 + (q1 - 512) * 3;
    let wy:i64 = (y << 8) / 48 + (q2 - 512) * 3;
    let hh:i64 = d_ridge(wx, wy, seed + 423, 4);
    let f1:i64 = d_vnoise((x << 8) / 260, 913, seed + 424);
    let f2:i64 = d_vnoise((x << 8) / 170 + 40000, 2713, seed + 425);
    let H:i64 = hh;
    if (f1 > 560) { H = H + 140; }
    if (f2 < 460) { H = H - 120; }
    if (H < 0) { H = 0; }
    if (H > 1023) { H = 1023; }
    return H;
}
fn d_a_mid_hs(x:i64, y:i64, seed:i64) i64 {
    let q1:i64 = d_fbm((x << 8) / 200, (y << 8) / 200, seed + 421, 2);
    let wx:i64 = (x << 8) / 48 + (q1 - 512) * 3;
    let wy:i64 = (y << 8) / 48 + (q1 - 512) * 3;
    return d_ridge(wx, wy, seed + 423, 2);
}
fn d_pal_mid(v:i64) i64 {
    let vv:i64 = d_clamp(v, 0, 1023);
    let bi:i64 = vv * 3 / 1024;
    if (bi > 2) { bi = 2; }
    let fr:i64 = vv * 3 - bi * 1024;
    let r0:i64 = 74; let g0:i64 = 52; let b0:i64 = 38;
    let r1:i64 = 168; let g1:i64 = 92; let b1:i64 = 52;
    let r2:i64 = 206; let g2:i64 = 150; let b2:i64 = 88;
    let r3:i64 = 226; let g3:i64 = 204; let b3:i64 = 160;
    let ra:i64 = r0; let ga:i64 = g0; let ba:i64 = b0;
    let rb:i64 = r1; let gb:i64 = g1; let bb:i64 = b1;
    if (bi == 1) { ra = r1; ga = g1; ba = b1; rb = r2; gb = g2; bb = b2; }
    if (bi == 2) { ra = r2; ga = g2; ba = b2; rb = r3; gb = g3; bb = b3; }
    return d_pack(d_lerp(ra, rb, fr), d_lerp(ga, gb, fr), d_lerp(ba, bb, fr));
}
fn d_a_mid(x:i64, y:i64, edge:i64, h:i64, seed:i64) i64 {
    let den:i64 = h - edge;
    if (den < 1) { den = 1; }
    let t:i64 = (y - edge) * 1024 / den;
    if (t < 0) { t = 0; }
    if (t > 1024) { t = 1024; }
    let H:i64 = d_a_mid_hq(x, y, seed);
    let hs0:i64 = d_a_mid_hs(x, y, seed);
    let gx:i64 = (d_a_mid_hs(x + 10, y, seed) - d_a_mid_hs(x - 10, y, seed)) / 20;
    let gy:i64 = (d_a_mid_hs(x, y + 10, seed) - d_a_mid_hs(x, y - 10, seed)) / 20;
    let num:i64 = gx * 450 + gy * 750 + 125440;
    let den2:i64 = d_isqrt(gx * gx + gy * gy + 65536) * 1002;
    let dot1024:i64 = num * 1024 / den2;
    let shade:i64 = d_clamp(dot1024 * 1150 / 1024, 170, 1400);
    // contour strata lines following the faulted surface
    let sq:i64 = H * 28 / 1024;
    let sf:i64 = H * 28 - sq * 1024;
    if (sf < 80) { shade = shade * (1024 - (80 - sf) * 4) / 1024; }
    // crevice darkening from concavity
    let cav:i64 = (d_a_mid_hs(x + 12, y, seed) + d_a_mid_hs(x - 12, y, seed) + d_a_mid_hs(x, y + 12, seed) + d_a_mid_hs(x, y - 12, seed)) / 4 - hs0;
    if (cav < 0) { shade = shade * (1024 + cav * 3) / 1024; }
    // scree streaks running downhill
    let st:i64 = d_fbm((x << 8) / 30, (y << 8) / 220, seed + 426, 2);
    shade = shade * (920 + st * 160 / 1024) / 1024;
    let col:i64 = d_pal_mid(H);
    let r:i64 = (col & 255) * shade / 1024;
    let g:i64 = ((col >> 8) & 255) * shade / 1024;
    let b:i64 = ((col >> 16) & 255) * shade / 1024;
    let det:i64 = d_fbm((x << 8) / 16, (y << 8) / 16, seed + 427, 3);
    let dm:i64 = 900 + det * 200 / 1024;
    r = r * dm / 1024; g = g * dm / 1024; b = b * dm / 1024;
    let air:i64 = 220 + (1024 - t) * 140 / 1024;
    r = d_lerp(r, 186, air); g = d_lerp(g, 206, air); b = d_lerp(b, 222, air);
    if (t < 48) {
        let rim:i64 = 1024 - t * 1024 / 48;
        let sunf:i64 = d_clamp(dot1024, 0, 1024);
        r = r + rim * sunf / 1024 * 110 / 1024;
        g = g + rim * sunf / 1024 * 92 / 1024;
        b = b + rim * sunf / 1024 * 70 / 1024;
    }
    r = d_clamp(r, 0, 255); g = d_clamp(g, 0, 255); b = d_clamp(b, 0, 255);
    return d_pack(r, g, b);
}

// ---------- NEAR: boulder talus with lava ----------
fn d_a_near_h(x:i64, y:i64, cell:i64, seed:i64) i64 {
    let xi:i64 = x / cell;
    let yi:i64 = y / cell;
    let xf:i64 = x - xi * cell - cell / 2;
    let yf:i64 = y - yi * cell - cell / 2;
    let bv:i64 = d_h01(xi, yi, seed + 431);
    let ox:i64 = d_h01(xi, yi, seed + 432) - 512;
    let oy:i64 = d_h01(xi, yi, seed + 433) - 512;
    let dx:i64 = xf - ox * 10 / 1024;
    let dy:i64 = yf - oy * 10 / 1024;
    let rad:i64 = 6 + bv * 8 / 1024;
    let bump:i64 = 0;
    let rr2:i64 = dx * dx + dy * dy;
    if (rr2 < rad * rad) {
        let b2:i64 = 1024 - rr2 * 1024 / (rad * rad);
        bump = b2 * b2 / 1024;
    }
    let det:i64 = d_ridge((x << 8) / 14, (y << 8) / 14, seed + 434, 3);
    return (bump * 620 + det * 404) / 1024;
}
fn d_a_near(x:i64, y:i64, edge:i64, h:i64, seed:i64) i64 {
    let den:i64 = h - edge;
    if (den < 1) { den = 1; }
    let t:i64 = (y - edge) * 1024 / den;
    if (t < 0) { t = 0; }
    if (t > 1024) { t = 1024; }
    let cell:i64 = 24 + t * 22 / 1024;
    let H:i64 = d_a_near_h(x, y, cell, seed);
    let gx:i64 = (d_a_near_h(x + 6, y, cell, seed) - d_a_near_h(x - 6, y, cell, seed)) / 12;
    let gy:i64 = (d_a_near_h(x, y + 6, cell, seed) - d_a_near_h(x, y - 6, cell, seed)) / 12;
    let num:i64 = gx * 450 + gy * 750 + 98000;
    let den2:i64 = d_isqrt(gx * gx + gy * gy + 40000) * 1002;
    let dot1024:i64 = num * 1024 / den2;
    let shade:i64 = d_clamp(dot1024 * 1200 / 1024, 160, 1450);
    let r:i64 = (34 + H * 70 / 1024) * shade / 1024;
    let g:i64 = (30 + H * 64 / 1024) * shade / 1024;
    let b:i64 = (36 + H * 60 / 1024) * shade / 1024;
    // lava: pools in the lows + vein network
    let low:i64 = d_fbm((x << 8) / 70, (y << 8) / 70, seed + 435, 3);
    let vein:i64 = d_ridge((x << 8) / 9 + (low - 512) / 6, (y << 8) / 9, seed + 436, 4);
    let dv:i64 = d_abs(vein - 512);
    let glow:i64 = 0;
    if (dv < 46) { glow = (46 - dv) * 1024 / 46; }
    if (low < 400) {
        let p2:i64 = (400 - low) * 1024 / 400 * 3 / 4;
        if (p2 > glow) { glow = p2; }
    }
    if (glow > 0) {
        let lr:i64 = 210 + 45 * glow / 1024;
        let lg:i64 = 70 + 120 * glow / 1024;
        let lb:i64 = 24 + 60 * glow / 1024;
        r = d_lerp(r, lr, glow); g = d_lerp(g, lg, glow); b = d_lerp(b, lb, glow);
        let heat:i64 = 0;
        if (dv < 160) { heat = (160 - dv) * 280 / 160; }
        r = r + 255 * heat / 1024; g = g + 120 * heat / 1024; b = b + 40 * heat / 1024;
    }
    let det2:i64 = d_fbm((x << 8) / 10, (y << 8) / 10, seed + 438, 3);
    let dm:i64 = 900 + det2 * 200 / 1024;
    r = r * dm / 1024; g = g * dm / 1024; b = b * dm / 1024;
    let air:i64 = 60 + t * 40 / 1024;
    r = d_lerp(r, 205, air); g = d_lerp(g, 196, air); b = d_lerp(b, 182, air);
    r = d_clamp(r, 0, 255); g = d_clamp(g, 0, 255); b = d_clamp(b, 0, 255);
    return d_pack(r, g, b);
}

// valley fog: knits two planes into one continuous depth
fn d_a_fogmix(col:i64, x:i64, edge:i64, y:i64, h:i64, seed:i64) i64 {
    let den:i64 = h - edge;
    if (den < 1) { den = 1; }
    let t:i64 = (y - edge) * 1024 / den;
    if (t < 0) { t = 0; }
    if (t > 1024) { t = 1024; }
    if (t >= 220) { return col; }
    let fb:i64 = d_fbm((x << 8) / 110, (edge << 8) / 110, seed + 441, 3);
    let fm:i64 = d_ss((fb - 480) * 1024 / 260);
    let fmix:i64 = (1024 - t * 1024 / 220) * fm / 1024 * 620 / 1024;
    let r:i64 = d_lerp(col & 255, 206, fmix);
    let g:i64 = d_lerp((col >> 8) & 255, 214, fmix);
    let b:i64 = d_lerp((col >> 16) & 255, 228, fmix);
    return d_pack(r, g, b);
}

// per-pixel dispatch: sky or one of the three depth planes
fn d_alien_px(x:i64, y:i64, w:i64, h:i64, h0:i64, seed:i64) i64 {
    let ef:i64 = d_a_edge_far(x, h0, seed);
    if (y < ef) { return d_a_sky_px(x, y, w, h, h0, seed); }
    let em:i64 = d_a_edge_mid(x, ef, seed);
    if (y < em) { return d_a_far(x, y, ef, h, w, h0, seed); }
    let en:i64 = d_a_edge_near(x, em, seed);
    if (y < en) {
        let col:i64 = d_a_mid(x, y, em, h, seed);
        return d_a_fogmix(col, x, em, y, h, seed);
    }
    let col:i64 = d_a_near(x, y, en, h, seed);
    return d_a_fogmix(col, x, en, y, h, seed);
}

fn d_render_alien(buf:[]u8, w:i64, h:i64, stride:i64, seed:i64) void {
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let h0:i64 = h / 2 + (d_fbm(x << 1, 7, seed + 101, 3) - 512) * h / 16000;
            let col:i64 = d_alien_px(x, y, w, h, h0, seed);
            let dh:i64 = d_h01(x, y, seed + 999);
            let off:i64 = (dh - 512) * 6 / 1024;
            let r:i64 = d_clamp((col & 255) + off, 0, 255);
            let g:i64 = d_clamp(((col >> 8) & 255) + off, 0, 255);
            let b:i64 = d_clamp(((col >> 16) & 255) + off, 0, 255);
            let o:i64 = 54 + (h - 1 - y) * stride + x * 3;
            buf[o] = b as u8;
            buf[o + 1] = g as u8;
            buf[o + 2] = r as u8;
            x = x + 1;
        }
        if (y - (y / 128) * 128 == 0) {
            _zag_print("row ");
            _zag_println(_zag_i64_to_str(y));
        }
        y = y + 1;
    }
}

// ============================================================
// D-IMG-2 — impossible architecture, round 3 rebuild.
// TRUE mitered joinery: the three beams meet edge-to-edge along
// each miter bisector — a closed corner, no overhang lip. The
// cyclic over/under (b2 over b0 at V0, b0 over b1 at V1, b1 over
// b2 at V2) is carried by seam shading alone: a highlight lip on
// the winner's side of the miter line, a dark seam plus soft
// contact shadow on the loser's side.
// ALL beam texture is sampled in beam-local (along, across)
// coordinates: grain, scratches and cracks run WITH the beam;
// wear concentrates at edges and joints (derived from geometry).
// ONE sun lights all three beams identically (warm lit side,
// cool shaded side). Starfield fades smoothly into the wall.
// The floor is a real perspective flagstone plane.
// ============================================================

fn d_in_quad(px:f64, py:f64, ax:f64, ay:f64, bx:f64, by:f64, cx:f64, cy:f64, dx:f64, dy:f64) i64 {
    let c1:f64 = (bx - ax) * (py - ay) - (by - ay) * (px - ax);
    let c2:f64 = (cx - bx) * (py - by) - (cy - by) * (px - bx);
    let c3:f64 = (dx - cx) * (py - cy) - (dy - cy) * (px - cx);
    let c4:f64 = (ax - dx) * (py - dy) - (ay - dy) * (px - dx);
    if (c1 >= 0.0 && c2 >= 0.0 && c3 >= 0.0 && c4 >= 0.0) { return 1; }
    if (c1 <= 0.0 && c2 <= 0.0 && c3 <= 0.0 && c4 <= 0.0) { return 1; }
    return 0;
}

// across = signed distance from beam centerline / half-width (-1..1)
fn d_beam_across(px:f64, py:f64, ax:f64, ay:f64, bx:f64, by:f64, hw:f64) f64 {
    let ex:f64 = bx - ax;
    let ey:f64 = by - ay;
    let len:f64 = d_sqrt(ex * ex + ey * ey);
    if (len <= 0.0) { return 0.0; }
    return ((px - ax) * ey - (py - ay) * ex) / (len * hw);
}

// soft shadow of the frame: samples in a widening cone along the
// light direction -> density 0..1 (contact-hardened penumbra)
fn d_frame_shadow(px:f64, py:f64, a0x:f64, a0y:f64, b0x:f64, b0y:f64, c0x:f64, c0y:f64, d0x:f64, d0y:f64, a1x:f64, a1y:f64, b1x:f64, b1y:f64, c1x:f64, c1y:f64, d1x:f64, d1y:f64, a2x:f64, a2y:f64, b2x:f64, b2y:f64, c2x:f64, c2y:f64, d2x:f64, d2y:f64, hw:f64) f64 {
    let dens:f64 = 0.0;
    let k:i64 = 0;
    while (k < 4) {
        let fk:f64 = (k as f64) / 3.0;
        let off:f64 = hw * 3.0 * fk;
        let j:i64 = -1;
        while (j < 2) {
            let pp:f64 = (j as f64) * hw * 0.9 * fk;
            let sx:f64 = px + 0.3714 * off + 0.9285 * pp;
            let sy:f64 = py + 0.9285 * off - 0.3714 * pp;
            let u0:i64 = d_in_quad(sx, sy, a0x, a0y, b0x, b0y, c0x, c0y, d0x, d0y);
            let u1:i64 = d_in_quad(sx, sy, a1x, a1y, b1x, b1y, c1x, c1y, d1x, d1y);
            let u2:i64 = d_in_quad(sx, sy, a2x, a2y, b2x, b2y, c2x, c2y, d2x, d2y);
            if (u0 + u1 + u2 > 0) { dens = dens + 1.0; }
            j = j + 1;
        }
        k = k + 1;
    }
    return dens / 12.0;
}

// environment: night sky (fading starfield), rock wall, flagstone floor
fn d_b_env(x:i64, y:i64, w:i64, h:i64, seed:i64) i64 {
    let horizon:i64 = h * 80 / 100;
    let walltop:i64 = h * 16 / 100;
    let r:i64 = 0; let g:i64 = 0; let b:i64 = 0;
    if (y < walltop) {
        let t:i64 = y * 1024 / walltop;
        r = d_lerp(9, 21, t); g = d_lerp(11, 27, t); b = d_lerp(19, 43, t);
        let neb:i64 = d_fbm((x << 8) / 260 + (y << 8) / 900, (y << 8) / 260, seed + 501, 3);
        let nm:i64 = d_ss((neb - 580) * 1024 / 240);
        r = r + 12 * nm / 1024; g = g + 10 * nm / 1024; b = b + 22 * nm / 1024;
        // stars: clustered, fading smoothly toward the wall — no hard cut
        let cl:i64 = d_fbm((x << 8) / 300, (y << 8) / 300, seed + 502, 2);
        let sp:i64 = d_h01(x, y, seed + 503);
        let thr:i64 = 1006 - cl * 10 / 1024;
        if (sp > thr) {
            let fade:i64 = d_ss((walltop - y) * 1024 / 130);
            let si:i64 = (sp - thr) * 42 * fade / 1024;
            if (si > 90) { si = 90; }
            r = r + si; g = g + si; b = b + si + si / 6;
        }
        let gsx:i64 = x - w * 18 / 100;
        let gsy:i64 = y - h * 6 / 100;
        let gl2:i64 = 1024 - d_clamp(d_isqrt(gsx * gsx + gsy * gsy) * 1024 / 700, 0, 1024);
        r = r + 24 * gl2 / 1024; g = g + 27 * gl2 / 1024; b = b + 40 * gl2 / 1024;
    } else {
        if (y < horizon) {
            // rock wall: warped strata, tooling marks, lit top edge
            let wq:i64 = d_fbm((x << 8) / 200, (y << 8) / 200, seed + 511, 2);
            let wx2:i64 = (x << 8) / 52 + (wq - 512) / 9;
            let wy2:i64 = (y << 8) / 52;
            let wsv:i64 = d_fbm(wx2, wy2, seed + 512, 3);
            let sb:i64 = 880 + wsv * 220 / 1024;
            let st2:i64 = d_fbm((x << 8) / 90, (y << 8) / 14, seed + 513, 2);
            let sl:i64 = 1024;
            if (st2 > 800) { sl = 1024 - (st2 - 800) * 2; }
            let tm:i64 = d_fbm((x << 8) / 34, (y << 8) / 420, seed + 514, 2);
            let tk:i64 = 950 + tm * 100 / 1024;
            let vg:i64 = 720 + y * 304 / horizon;
            r = 30 * sb / 1024 * sl / 1024 * tk / 1024 * vg / 1024;
            g = 34 * sb / 1024 * sl / 1024 * tk / 1024 * vg / 1024;
            b = 46 * sb / 1024 * sl / 1024 * tk / 1024 * vg / 1024;
            if (y - walltop < 10) {
                let le:i64 = 1150 - (y - walltop) * 150 / 10;
                r = r * le / 1024; g = g * le / 1024; b = b * le / 1024;
            }
            let wsx:i64 = x - w * 18 / 100;
            let wsy:i64 = y - h * 6 / 100;
            let wg:i64 = 1024 - d_clamp(d_isqrt(wsx * wsx + wsy * wsy) * 1024 / 900, 0, 1024);
            r = r + 20 * wg / 1024; g = g + 22 * wg / 1024; b = b + 30 * wg / 1024;
            let hz:i64 = 1024 - d_ss((horizon - y) * 1024 / 90);
            r = d_lerp(r, 30, hz); g = d_lerp(g, 34, hz); b = d_lerp(b, 48, hz);
        } else {
            // flagstone floor in perspective (a real ground plane)
            let dep:i64 = (y - horizon) * 1024 / (h - horizon);
            let pz:i64 = 1048576 / (160 + 864 * dep / 1024);
            let cx:i64 = w / 2;
            let sv2:i64 = (pz - 1024) * 3 / 4;
            let su2:i64 = (x - cx) * pz / 1024 / 44 + 8192;
            let row:i64 = sv2 / 1024;
            let su3:i64 = su2;
            if (row - (row / 2) * 2 == 1) { su3 = su2 + 512; }
            let fu:i64 = su3 - (su3 / 1024) * 1024;
            let fv:i64 = sv2 - (sv2 / 1024) * 1024;
            let line:i64 = 0;
            if (fu < 46 || fu > 978 || fv < 46 || fv > 978) { line = 1; }
            let tone:i64 = d_h01(su3 / 1024, sv2 / 1024, seed + 521);
            let tb2:i64 = 780 + tone * 300 / 1024;
            let wr:i64 = d_fbm((x << 8) / 40, ((y - horizon) << 8) / 30, seed + 522, 3);
            let wk:i64 = 900 + wr * 200 / 1024;
            r = 52 * tb2 / 1024 * wk / 1024;
            g = 50 * tb2 / 1024 * wk / 1024;
            b = 56 * tb2 / 1024 * wk / 1024;
            if (line == 1) { r = r * 640 / 1024; g = g * 640 / 1024; b = b * 640 / 1024; }
            let pdx2:f64 = (x as f64) - (w as f64) * 0.5;
            let pdy2:f64 = (y as f64) - (horizon as f64) - 40.0;
            let pool:f64 = 1048576.0 / (1048576.0 + (pdx2 * pdx2 + pdy2 * pdy2) / 700.0);
            r = r + ((96.0 * pool) as i64);
            g = g + ((90.0 * pool) as i64);
            b = b + ((96.0 * pool) as i64);
            let hz:i64 = d_ss((1024 - dep) * 1024 / 90);
            r = d_lerp(r, 30, hz); g = d_lerp(g, 34, hz); b = d_lerp(b, 48, hz);
        }
    }
    r = d_clamp(r, 0, 255); g = d_clamp(g, 0, 255); b = d_clamp(b, 0, 255);
    return d_pack(r, g, b);
}

fn d_render_arch(buf:[]u8, w:i64, h:i64, stride:i64, seed:i64) void {
    let cx:f64 = (w as f64) * 0.5;
    let cy:f64 = (h as f64) * 0.47;
    let rr:f64 = (h as f64) * 0.36;
    let hw:f64 = (h as f64) * 0.052;
    let v0x:f64 = cx; let v0y:f64 = cy - rr;
    let v1x:f64 = cx - rr * 0.8660254; let v1y:f64 = cy + rr * 0.5;
    let v2x:f64 = cx + rr * 0.8660254; let v2y:f64 = cy + rr * 0.5;
    let e01x:f64 = v1x - v0x; let e01y:f64 = v1y - v0y;
    let l01:f64 = d_sqrt(e01x * e01x + e01y * e01y);
    let u01x:f64 = e01x / l01; let u01y:f64 = e01y / l01;
    let e12x:f64 = v2x - v1x; let e12y:f64 = v2y - v1y;
    let l12:f64 = d_sqrt(e12x * e12x + e12y * e12y);
    let u12x:f64 = e12x / l12; let u12y:f64 = e12y / l12;
    let e20x:f64 = v0x - v2x; let e20y:f64 = v0y - v2y;
    let l20:f64 = d_sqrt(e20x * e20x + e20y * e20y);
    let u20x:f64 = e20x / l20; let u20y:f64 = e20y / l20;
    // miter points at each corner (beams meet edge-to-edge: closed corner)
    let ib0x:f64 = u01x - u20x; let ib0y:f64 = u01y - u20y;
    let il0:f64 = d_sqrt(ib0x * ib0x + ib0y * ib0y);
    ib0x = ib0x / il0; ib0y = ib0y / il0;
    let ct0:f64 = u20x * u01x + u20y * u01y;
    let ml0:f64 = hw / d_sqrt((1.0 - ct0) * 0.5);
    let o0ox:f64 = v0x - ml0 * ib0x; let o0oy:f64 = v0y - ml0 * ib0y;
    let o0ix:f64 = v0x + ml0 * ib0x; let o0iy:f64 = v0y + ml0 * ib0y;
    let ib1x:f64 = u12x - u01x; let ib1y:f64 = u12y - u01y;
    let il1:f64 = d_sqrt(ib1x * ib1x + ib1y * ib1y);
    ib1x = ib1x / il1; ib1y = ib1y / il1;
    let ct1:f64 = u01x * u12x + u01y * u12y;
    let ml1:f64 = hw / d_sqrt((1.0 - ct1) * 0.5);
    let o1ox:f64 = v1x - ml1 * ib1x; let o1oy:f64 = v1y - ml1 * ib1y;
    let o1ix:f64 = v1x + ml1 * ib1x; let o1iy:f64 = v1y + ml1 * ib1y;
    let ib2x:f64 = u20x - u12x; let ib2y:f64 = u20y - u12y;
    let il2:f64 = d_sqrt(ib2x * ib2x + ib2y * ib2y);
    ib2x = ib2x / il2; ib2y = ib2y / il2;
    let ct2:f64 = u12x * u20x + u12y * u20y;
    let ml2:f64 = hw / d_sqrt((1.0 - ct2) * 0.5);
    let o2ox:f64 = v2x - ml2 * ib2x; let o2oy:f64 = v2y - ml2 * ib2y;
    let o2ix:f64 = v2x + ml2 * ib2x; let o2iy:f64 = v2y + ml2 * ib2y;
    // beam quads, edge-to-edge at the miter lines (outer-start,
    // outer-end, inner-end, inner-start). NO overhang extension.
    let a0x:f64 = o0ox; let a0y:f64 = o0oy;
    let b0x:f64 = o1ox; let b0y:f64 = o1oy;
    let c0x:f64 = o1ix; let c0y:f64 = o1iy;
    let d0x:f64 = o0ix; let d0y:f64 = o0iy;
    let a1x:f64 = o1ox; let a1y:f64 = o1oy;
    let b1x:f64 = o2ox; let b1y:f64 = o2oy;
    let c1x:f64 = o2ix; let c1y:f64 = o2iy;
    let d1x:f64 = o1ix; let d1y:f64 = o1iy;
    let a2x:f64 = o2ox; let a2y:f64 = o2oy;
    let b2x:f64 = o0ox; let b2y:f64 = o0oy;
    let c2x:f64 = o0ix; let c2y:f64 = o0iy;
    let d2x:f64 = o2ix; let d2y:f64 = o2iy;
    let m0ax:f64 = (o0ox + o0ix) * 0.5; let m0ay:f64 = (o0oy + o0iy) * 0.5;
    let m0bx:f64 = (o1ox + o1ix) * 0.5; let m0by:f64 = (o1oy + o1iy) * 0.5;
    let m1ax:f64 = (o1ox + o1ix) * 0.5; let m1ay:f64 = (o1oy + o1iy) * 0.5;
    let m1bx:f64 = (o2ox + o2ix) * 0.5; let m1by:f64 = (o2oy + o2iy) * 0.5;
    let m2ax:f64 = (o2ox + o2ix) * 0.5; let m2ay:f64 = (o2oy + o2iy) * 0.5;
    let m2bx:f64 = (o0ox + o0ix) * 0.5; let m2by:f64 = (o0oy + o0iy) * 0.5;
    // cyclic winners: V0 -> beam 2 over beam 0; V1 -> beam 0 over
    // beam 1; V2 -> beam 1 over beam 2 (the impossible cycle).
    // miter-line data per corner + winner side sign.
    let sg0f:f64 = (0.0 - ib0x) * u20y + ib0y * u20x;
    let sg0:i64 = 1;
    if (sg0f < 0.0) { sg0 = 0 - 1; }
    let sg1f:f64 = (0.0 - ib1x) * u01y + ib1y * u01x;
    let sg1:i64 = 1;
    if (sg1f < 0.0) { sg1 = 0 - 1; }
    let sg2f:f64 = (0.0 - ib2x) * u12y + ib2y * u12x;
    let sg2:i64 = 1;
    if (sg2f < 0.0) { sg2 = 0 - 1; }
    let ml0len:f64 = ml0 * 2.0;
    let ml1len:f64 = ml1 * 2.0;
    let ml2len:f64 = ml2 * 2.0;
    // light direction (top, slightly left) — ONE sun for all beams
    let ldx:f64 = 0.0 - 0.3714; let ldy:f64 = 0.0 - 0.9285;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let px:f64 = x as f64;
            let py:f64 = y as f64;
            let in0:i64 = d_in_quad(px, py, a0x, a0y, b0x, b0y, c0x, c0y, d0x, d0y);
            let in1:i64 = d_in_quad(px, py, a1x, a1y, b1x, b1y, c1x, c1y, d1x, d1y);
            let in2:i64 = d_in_quad(px, py, a2x, a2y, b2x, b2y, c2x, c2y, d2x, d2y);
            let cov:i64 = in0 + in1 + in2;
            let r:i64 = 0; let g:i64 = 0; let b:i64 = 0;
            if (cov == 0) {
                // ---- environment + soft contact-hardened shadow + vignette
                let env:i64 = d_b_env(x, y, w, h, seed);
                r = env & 255; g = (env >> 8) & 255; b = (env >> 16) & 255;
                let walltop2:i64 = h * 16 / 100;
                if (y > walltop2) {
                    let densf:f64 = d_frame_shadow(px, py, a0x, a0y, b0x, b0y, c0x, c0y, d0x, d0y, a1x, a1y, b1x, b1y, c1x, c1y, d1x, d1y, a2x, a2y, b2x, b2y, c2x, c2y, d2x, d2y, hw);
                    let shf2:f64 = 1.0 - 0.62 * densf;
                    r = (((r as f64) * shf2) as i64);
                    g = (((g as f64) * shf2) as i64);
                    b = (((b as f64) * shf2) as i64);
                }
                let dxv:f64 = px - cx; let dyv:f64 = py - cy;
                let vd:f64 = d_sqrt(dxv * dxv + dyv * dyv) / ((h as f64) * 0.75);
                let vf:f64 = 1.0;
                if (vd < 1.0) { vf = 1.0 - 0.30 * vd * vd; }
                if (vd >= 1.0) { vf = 0.70; }
                r = (((r as f64) * vf) as i64);
                g = (((g as f64) * vf) as i64);
                b = (((b as f64) * vf) as i64);
            } else {
                // ---- beam pixel
                let e0d:f64 = (px - v0x) * (px - v0x) + (py - v0y) * (py - v0y);
                let e1d:f64 = (px - v1x) * (px - v1x) + (py - v1y) * (py - v1y);
                let e2d:f64 = (px - v2x) * (px - v2x) + (py - v2y) * (py - v2y);
                let nv:i64 = 0;
                if (e1d < e0d && e1d < e2d) { nv = 1; }
                if (e2d < e0d && e2d < e1d) { nv = 2; }
                let win:i64 = 2;
                if (cov == 1 && in0 == 1) { win = 0; }
                if (cov == 1 && in1 == 1) { win = 1; }
                if (cov > 1 && nv == 0) { win = 2; }
                if (cov > 1 && nv == 1) { win = 0; }
                if (cov > 1 && nv == 2) { win = 1; }
                // winner beam geometry
                let cax:f64 = m0ax; let cay:f64 = m0ay;
                let cbx:f64 = m0bx; let cby:f64 = m0by;
                let wux:f64 = u01x; let wuy:f64 = u01y;
                let s_sox:f64 = v0x; let s_soy:f64 = v0y;
                if (win == 1) {
                    cax = m1ax; cay = m1ay; cbx = m1bx; cby = m1by;
                    wux = u12x; wuy = u12y;
                    s_sox = v1x; s_soy = v1y;
                }
                if (win == 2) {
                    cax = m2ax; cay = m2ay; cbx = m2bx; cby = m2by;
                    wux = u20x; wuy = u20y;
                    s_sox = v2x; s_soy = v2y;
                }
                // beam-local coordinates: along (px) and across (half-widths)
                let across:f64 = d_beam_across(px, py, cax, cay, cbx, cby, hw);
                if (across > 1.0) { across = 1.0; }
                if (across < 0.0 - 1.0) { across = 0.0 - 1.0; }
                let aa:f64 = across;
                if (aa < 0.0) { aa = 0.0 - aa; }
                // bevel shading from the one sun (identical on all beams)
                let bright:f64 = 1.0 - 0.36 * aa * aa - 0.04 * aa;
                let mx:f64 = wuy; let my:f64 = 0.0 - wux;
                let facing:f64 = mx * ldx + my * ldy;
                let side:f64 = across * facing;
                bright = bright * (1.0 + 0.13 * side);
                if (aa > 0.78 && side > 0.0) { bright = bright * 1.09; }
                // joinery: seam shading along the miter line at this corner
                let qjx:f64 = o0ox; let qjy:f64 = o0oy;
                let qmx:f64 = ib0x; let qmy:f64 = ib0y;
                let qml:f64 = ml0len; let qsg:i64 = sg0;
                let qix:f64 = o0ix; let qiy:f64 = o0iy;
                if (nv == 1) {
                    qjx = o1ox; qjy = o1oy; qmx = ib1x; qmy = ib1y;
                    qml = ml1len; qsg = sg1; qix = o1ix; qiy = o1iy;
                }
                if (nv == 2) {
                    qjx = o2ox; qjy = o2oy; qmx = ib2x; qmy = ib2y;
                    qml = ml2len; qsg = sg2; qix = o2ix; qiy = o2iy;
                }
                let relx:f64 = px - qjx; let rely:f64 = py - qjy;
                let along:f64 = relx * qmx + rely * qmy;
                let sdf:f64 = qmx * rely - qmy * relx;
                let asd:f64 = sdf;
                if (asd < 0.0) { asd = 0.0 - asd; }
                if (along > -3.0 && along < qml + 3.0 && asd < 18.0) {
                    let sgn:i64 = 1;
                    if (sdf < 0.0) { sgn = 0 - 1; }
                    if (sgn == qsg) {
                        if (asd < 2.4) { bright = bright * 1.16; }
                        if (asd < 10.0) { bright = bright * 1.04; }
                    } else {
                        if (asd < 1.4) { bright = bright * 0.52; }
                        if (asd < 15.0) { bright = bright * (1.0 - 0.32 * (1.0 - asd / 15.0)); }
                    }
                }
                // pocket AO at the inner corner
                let pdx3:f64 = px - qix; let pdy3:f64 = py - qiy;
                let dpi3:f64 = d_sqrt(pdx3 * pdx3 + pdy3 * pdy3);
                let aor3:f64 = hw * 2.5;
                if (dpi3 < aor3) { bright = bright * (0.80 + 0.20 * dpi3 / aor3); }
                // material in beam-local coordinates: everything follows
                // the beam axis (grain, scratches, cracks, wear)
                let sb:f64 = (px - s_sox) * wux + (py - s_soy) * wuy;
                let sfb:i64 = (sb * 255.0) as i64;
                let qfb:i64 = (across * 255.0) as i64;
                let mseed:i64 = seed + 301 + win * 7919;
                let grain:i64 = d_fbm(sfb / 16320 + win * 7000, qfb / 42 + win * 3000, mseed, 4);
                let mottle:i64 = d_fbm(sfb / 58650, qfb / 200 + win * 3000 + 5000, mseed + 1, 3);
                let alb:f64 = (860.0 + (grain as f64) * 260.0 / 1024.0) / 1024.0;
                alb = alb * (900.0 + (mottle as f64) * 200.0 / 1024.0) / 1024.0;
                let scr:i64 = d_ridge(sfb / 2295, qfb * 32 + 9000, mseed + 4, 2);
                if (scr > 915) { alb = alb * 0.84; }
                let crk:i64 = d_ridge(sfb / 6630, qfb * 10 + 4000, mseed + 2, 3);
                if (crk > 928) { alb = alb * 0.58; }
                if (aa > 0.84) {
                    let chip:i64 = d_ridge(sfb / 1785, qfb * 4 + 5000, mseed + 5, 2);
                    if (chip > 888) { alb = alb * 1.13; }
                }
                let d0v:f64 = d_sqrt((px - v0x) * (px - v0x) + (py - v0y) * (py - v0y));
                let d1v:f64 = d_sqrt((px - v1x) * (px - v1x) + (py - v1y) * (py - v1y));
                let d2v:f64 = d_sqrt((px - v2x) * (px - v2x) + (py - v2y) * (py - v2y));
                let dvmin:f64 = d0v;
                if (d1v < dvmin) { dvmin = d1v; }
                if (d2v < dvmin) { dvmin = d2v; }
                if (dvmin < hw * 3.0) {
                    let jw2:i64 = d_fbm(sfb / 7650, qfb / 64 + 2000, mseed + 6, 2);
                    alb = alb * (0.90 + (jw2 as f64) * 0.20 / 1024.0);
                }
                // one sun: warm lit side, cool shaded side — same all beams
                let tr:f64 = 1.0; let tg:f64 = 1.0; let tb:f64 = 1.0;
                if (side > 0.0) { tr = 1.035; tb = 0.985; } else { tr = 0.985; tb = 1.035; }
                let kk:f64 = bright * alb;
                r = ((196.0 * tr * kk) as i64);
                g = ((188.0 * tg * kk) as i64);
                b = ((172.0 * tb * kk) as i64);
                if (r < 0) { r = 0; }
                if (r > 255) { r = 255; }
                if (g < 0) { g = 0; }
                if (g > 255) { g = 255; }
                if (b < 0) { b = 0; }
                if (b > 255) { b = 255; }
            }
            // monochromatic fine dither (texture, never blur)
            let dh:i64 = d_h01(x, y, seed + 999);
            let off:i64 = (dh - 512) * 6 / 1024;
            let rf:i64 = d_clamp(r + off, 0, 255);
            let gf:i64 = d_clamp(g + off, 0, 255);
            let bf:i64 = d_clamp(b + off, 0, 255);
            let o:i64 = 54 + (h - 1 - y) * stride + x * 3;
            buf[o] = bf as u8;
            buf[o + 1] = gf as u8;
            buf[o + 2] = rf as u8;
            x = x + 1;
        }
        if (y - (y / 128) * 128 == 0) {
            _zag_print("row ");
            _zag_println(_zag_i64_to_str(y));
        }
        y = y + 1;
    }
}

// ---------------- BMP output ----------------
fn d_open_trunc(root:i64, name:[]u8) i64 {
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { return -7401; }
    // O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC|O_NOFOLLOW|O_NONBLOCK
    let flags:i64 = 657985;
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, flags, 420, 0, 0);
    nio_free(s);
    return fd;
}

fn d_write_bmp(root:i64, name:[]u8, buf:[]u8, w:i64, h:i64, stride:i64) i64 {
    buf[0] = 66; buf[1] = 77;
    d_put32le(buf, 2, 54 + stride * h);
    d_put32le(buf, 6, 0);
    d_put32le(buf, 10, 54);
    d_put32le(buf, 14, 40);
    d_put32le(buf, 18, w);
    d_put32le(buf, 22, h);
    buf[26] = 1; buf[27] = 0;
    buf[28] = 24; buf[29] = 0;
    d_put32le(buf, 30, 0);
    d_put32le(buf, 34, stride * h);
    d_put32le(buf, 38, 2835);
    d_put32le(buf, 42, 2835);
    d_put32le(buf, 46, 0);
    d_put32le(buf, 50, 0);
    let total:i64 = 54 + stride * h;
    let fd:i64 = d_open_trunc(root, name);
    if (fd < 0) { return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = buf[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}

fn main() i32 {
    let subj:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    let szs:[]u8 = _zag_arg(3);
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let w:i64 = 1024;
    let h:i64 = 1024;
    let is2048:i64 = 0;
    if (_zag_strcmp(szs, "2048") == 1) { w = 2048; h = 2048; is2048 = 1; }
    let is_arch:i64 = 0;
    if (_zag_strcmp(subj, "arch") == 1) { is_arch = 1; }
    if (_zag_strcmp(subj, "alien") != 1 && is_arch == 0) {
        _zag_println("usage: disc <alien|arch> <outdir> <1024|2048>");
        return 1;
    }
    let name:[]u8 = "d-img-1_alien_1024.bmp";
    if (is_arch == 1 && is2048 == 0) { name = "d-img-2_arch_1024.bmp"; }
    if (is_arch == 0 && is2048 == 1) { name = "d-img-1_alien_2048.bmp"; }
    if (is_arch == 1 && is2048 == 1) { name = "d-img-2_arch_2048.bmp"; }
    let root:i64 = nio_open_root(outd);
    if (root < 0) {
        _zag_println("cannot open outdir");
        return 1;
    }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let total:i64 = 54 + stride * h;
    _zag_print("rendering ");
    _zag_println(name);
    let buf:[]u8 = nio_alloc(total as i32);
    if (buf.len == 0) {
        _zag_println("alloc failed");
        nio_close(root);
        return 1;
    }
    if (is_arch == 1) {
        d_render_arch(buf, w, h, stride, 7202);
    } else {
        d_render_alien(buf, w, h, stride, 7101);
    }
    let rc:i64 = d_write_bmp(root, name, buf, w, h, stride);
    nio_free(buf);
    nio_close(root);
    if (rc != 0) {
        _zag_print("write failed ");
        _zag_println(_zag_i64_to_str(rc));
        return 1;
    }
    _zag_println("done");
    return 0;
}

// TEST-1 CONTROL (i): kids-and-laughter via the BANNED toolkit.
// Oscillators, harmonics, pitched laugh pulses, noise bursts, LP noise
// bed. An honest best attempt with the synth paradigm -- the negative
// control my method must beat. NOT part of any deliverable path.
const SR:i64 = 44100;
const SRF:f64 = 44100.0;
const NSAMP:i64 = 1323000;

fn put32(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
}
fn put16(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
}
fn put64(b:[]u8,i:i64,v:i64)void{
    b[i]=(v & 255) as u8;
    b[i+1]=((v>>8) & 255) as u8;
    b[i+2]=((v>>16) & 255) as u8;
    b[i+3]=((v>>24) & 255) as u8;
    b[i+4]=((v>>32) & 255) as u8;
    b[i+5]=((v>>40) & 255) as u8;
    b[i+6]=((v>>48) & 255) as u8;
    b[i+7]=((v>>56) & 255) as u8;
}
fn get64(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | ((b[i+3] as i64)<<24) | ((b[i+4] as i64)<<32) | ((b[i+5] as i64)<<40) | ((b[i+6] as i64)<<48) | ((b[i+7] as i64)<<56);
}
fn get32s(b:[]u8,i:i64)i64{
    return (b[i] as i64) | ((b[i+1] as i64)<<8) | ((b[i+2] as i64)<<16) | (((b[i+3] as i64)<<56)>>32);
}
fn cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4095){return "";}
    let p:*u8=_zag_malloc((s.len+1) as i64) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..(s.len+1)];
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn w_all(fd:i64,b:[]u8)i64{
    let at:i64=0;
    let calls:i32=0;
    let blen:i64=b.len as i64;
    while(at<blen && calls<65536){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+at,blen-at,0,0,0);
        calls=calls+1;
        if(n==-4){continue;}
        if(n<=0){return -7407;}
        at=at+n;
    }
    if(at!=blen){return -7407;}
    return at;
}
fn h32(s:i64,st:i64)i64{
    let z:i64=(s*2654435761+st*40503+1) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    z=(z*2246822519) & 4294967295;
    z=(z ^ (z>>13)) & 4294967295;
    z=(z*3266489917) & 4294967295;
    z=(z ^ (z>>16)) & 4294967295;
    return z;
}
fn tsin_small(x:f64)f64{
    // wrap to [-pi,pi]: the 4-term Taylor diverges for |x|>~4
    let y:f64=x;
    while(y>3.141592653589793){y=y-6.283185307179586;}
    while(y<-3.141592653589793){y=y+6.283185307179586;}
    let x2:f64=y*y;
    let x3:f64=x2*y;
    return y-x3/6.0+x3*x2/120.0-x3*x2*x2/5040.0;
}
fn sstep(x:f64)f64{
    if(x<=0.0){return 0.0;}
    if(x>=1.0){return 1.0;}
    return x*x*(3.0-2.0*x);
}
fn mix_new()[]u8{
    let p:*u8=_zag_malloc(NSAMP*8) as *u8;
    let m:[]u8=p[0..(NSAMP*8)];
    let i:i64=0;
    while(i<NSAMP*8){m[i]=0;i=i+1;}
    return m;
}
// pitched tone with glide + harmonic stack (the synth voice)
fn add_tone(m:[]u8,start:i64,dur:i64,f0:f64,f1:f64,gain:f64,seed:i64)void{
    let ph:f64=(h32(seed,1) as f64)/4294967296.0*6.283185307179586;
    let k:i64=0;
    while(k<dur){
        let at:i64=start+k;
        if(at>=NSAMP){k=dur;}
        else{
            let t:f64=(k as f64)/(dur as f64);
            let fr:f64=f0+(f1-f0)*t;
            ph=ph+6.283185307179586*fr/44100.0;
            if(ph>6.283185307179586){ph=ph-6.283185307179586;}
            let env:f64=sstep(t/0.08)*sstep((1.0-t)/0.25);
            let v:f64=tsin_small(ph)+0.45*tsin_small(ph*2.0)+0.22*tsin_small(ph*3.0)+0.1*tsin_small(ph*4.0);
            let cur:i64=get64(m,at*8);
            put64(m,at*8,cur+((v*env*gain*16777216.0/2.0) as i64));
            k=k+1;
        }
    }
}
// white hash noise
fn wnoise(s:i64,seed:i64)f64{
    return ((h32(s,seed) as f64)/2147483648.0)-1.0;
}
// noise burst thump (footstep): low sine + noise, fast decay
fn add_thump(m:[]u8,start:i64,gain:f64,seed:i64)void{
    let dur:i64=5292;
    let k:i64=0;
    while(k<dur){
        let at:i64=start+k;
        if(at>=NSAMP){k=dur;}
        else{
            let t:f64=(k as f64)/(dur as f64);
            let env:f64=sstep(t/0.02)*(1.0-t)*(1.0-t);
            let v:f64=tsin_small(6.283185307179586*95.0*(k as f64)/44100.0)*0.8+wnoise(k,seed)*0.5;
            let cur:i64=get64(m,at*8);
            put64(m,at*8,cur+((v*env*gain*16777216.0/1.5) as i64));
            k=k+1;
        }
    }
}
// LP noise bed (stationary -- the banned texture)
fn add_bed(m:[]u8,gain:f64,seed:i64)void{
    let y:f64=0.0;
    let s:i64=0;
    while(s<NSAMP){
        let w:f64=wnoise(s,seed);
        y=y*0.985+w*0.015;
        let cur:i64=get64(m,s*8);
        put64(m,s*8,cur+((y*gain*16777216.0*8.0) as i64));
        s=s+1;
    }
}
// a laugh train: npulses of pitched "ha" with sagging f0
fn laugh_synth(m:[]u8,t0:f64,f0a:f64,np:i64,seed:i64,gain:f64)void{
    let p:i64=0;
    let t:f64=t0;
    while(p<np){
        let f0:f64=f0a*(1.0-0.25*((p as f64)/(np as f64)));
        add_tone(m,(t*SRF) as i64,6615,f0,f0*0.82,gain,seed+p);
        t=t+0.19;
        p=p+1;
    }
}
fn score(m:[]u8)void{
    add_bed(m,0.05,7);
    // three voices
    laugh_synth(m,6.2,520.0,9,21,0.5);
    laugh_synth(m,6.9,430.0,7,22,0.44);
    laugh_synth(m,12.9,470.0,8,23,0.5);
    laugh_synth(m,13.2,600.0,10,24,0.46);
    // shouts: short pitched bursts
    add_tone(m,(4.6*SRF) as i64,13230,392.0,330.0,0.5,25);
    add_tone(m,(9.5*SRF) as i64,11025,440.0,370.0,0.42,26);
    add_tone(m,(20.5*SRF) as i64,8820,587.0,520.0,0.34,27);
    // running feet
    let t:f64=0.3;
    let q:i64=0;
    while(t<13.5){
        if((t>4.5 && t<5.0) || (t>9.2 && t<10.0) || (t>13.5 && t<16.0)){}
        else{add_thump(m,(t*SRF) as i64,0.5,30+q);}
        t=t+0.34;
        q=q+1;
    }
    let t2:f64=16.0;
    while(t2<29.5){
        add_thump(m,(t2*SRF) as i64,0.3,60+q);
        t2=t2+0.62;
        q=q+1;
    }
    // final laugh cascade 26-29s
    laugh_synth(m,26.0,540.0,8,31,0.5);
    laugh_synth(m,26.4,450.0,9,32,0.44);
    // trip thud
    add_thump(m,(12.2*SRF) as i64,0.9,99);
}
fn write_wav(path:[]u8,m:[]u8)i32{
    let s:i64=0;
    let peak:i64=0;
    while(s<NSAMP){
        let v:i64=get64(m,s*8);
        let a:i64=v;
        if(a<0){a=-a;}
        if(a>peak){peak=a;}
        s=s+1;
    }
    if(peak<1000){return -1;}
    let norm:f64=0.89*16777216.0/(peak as f64);
    let p:*u8=_zag_malloc(44+NSAMP*2) as *u8;
    let out:[]u8=p[0..(44+NSAMP*2)];
    let i:i64=0;
    while(i<44+NSAMP*2){out[i]=0;i=i+1;}
    out[0]=82;out[1]=73;out[2]=70;out[3]=70;
    put32(out,4,36+NSAMP*2);
    out[8]=87;out[9]=65;out[10]=86;out[11]=69;
    out[12]=102;out[13]=109;out[14]=116;out[15]=32;
    put32(out,16,16);
    put16(out,20,1);
    put16(out,22,1);
    put32(out,24,44100);
    put32(out,28,88200);
    put16(out,32,2);
    put16(out,34,16);
    out[36]=100;out[37]=97;out[38]=116;out[39]=97;
    put32(out,40,NSAMP*2);
    s=0;
    while(s<NSAMP){
        let v:i64=get64(m,s*8);
        let x:f64=((v as f64)/16777216.0)*norm;
        if(s<1323){x=x*sstep((s as f64)/1323.0);}
        let rem:i64=NSAMP-s;
        if(rem<35280){x=x*sstep((rem as f64)/35280.0);}
        let ax:f64=x;
        if(ax<0.0){ax=-ax;}
        x=x/(1.0+0.35*ax);
        put16(out,44+s*2,(x*32767.0) as i64);
        s=s+1;
    }
    let cs:[]u8=cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cs) as i64),577,438,0,0,0);
    _zag_free(_zag_slice_ptr(cs));
    if(fd<0){return -4;}
    let wr:i64=w_all(fd,out);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    _zag_free(_zag_slice_ptr(out));
    if(wr<0){return -5;}
    return 0;
}
fn main()i32{
    let a1:[]u8=_zag_arg(1);
    let outp:[]u8="kids_synth_control.wav";
    if(a1.len>0){outp=a1;}
    let m:[]u8=mix_new();
    score(m);
    return write_wav(outp,m);
}

@import("R33_NATIVE_SHA256_V2.zag")

// PROSE-LEARN: prose-consuming TNN learner, frozen PREREG.md mechanism.
// argv[1] = source name (grok|sol|step|muse-native). Reads inputs/train_<s>.txt,
// inputs/test_<s>.txt, inputs/false_ids_<s>.txt relative to CWD.
// Pure Zag, zero RNG. All tables are []u8 arenas with explicit put/get32
// (znc ZNC-2026-09-21-007: never `as []i32` for indexed tables).

// ---------------- byte helpers ----------------
fn is_alnum(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn to_low(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24);
}
fn p64(b:[]u8,at:i32,v:i64)void {
    p32(b,at,v&4294967295);
    p32(b,at+4,(v>>32)&4294967295);
    return;
}
fn g64(b:[]u8,at:i32)i64 {
    return g32(b,at)|(g32(b,at+4)<<32);
}
// byte equality: buf[off..off+len) vs literal
fn beq(b:[]u8,off:i32,len:i32,lit:[]u8)i32 {
    if(len!=lit.len){return 0;}
    let i:i32=0;
    while(i<len){
        if(b[off+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
// byte equality between two buffers
fn beq2(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let i:i32=0;
    while(i<len){
        if(a[ao+i]!=b[bo+i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){dst[do+i]=src[so+i];i=i+1;}
    return;
}
fn parse_int(b:[]u8,off:i32,len:i32)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<len){
        let c:u8=b[off+i];
        if(c>=48 && c<=57){v=v*10+((c as i64)-48);}
        i=i+1;
    }
    return v;
}
fn mkpath(a:[]u8,b:[]u8,c:[]u8)[]u8 {
    let n:i32=a.len+b.len+c.len;
    let o:[]u8=nio_alloc(n);
    copy_bytes(o,0,a,0,a.len);
    copy_bytes(o,a.len,b,0,b.len);
    copy_bytes(o,a.len+b.len,c,0,c.len);
    return o;
}

// ---------------- printing ----------------
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn prlen(b:[]u8,n:i32)void {
    _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),(n as i64),0,0,0);
    return;
}
// decimal of v into buf (needs >=24 bytes); returns length
fn i64str(v:i64,buf:[]u8)i32 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let at:i32=23;
    if(x==0){buf[at]=48;at=at-1;}
    while(x>0){
        let dd:i64=(x%10)+48;
        buf[at]=dd as u8;
        x=x/10;
        at=at-1;
    }
    if(neg==1){buf[at]=45;at=at-1;}
    let start:i32=at+1;
    let n:i32=24-start;
    let i:i32=0;
    while(i<n){buf[i]=buf[start+i];i=i+1;}
    return n;
}
fn prn(v:i64)void {
    let b:[]u8=nio_alloc(24);
    let n:i32=i64str(v,b);
    prlen(b,n);
    nio_free(b);
    return;
}
fn prhex(b:[]u8,off:i32,len:i32)void {
    let hb:[]u8=nio_alloc(len*2+1);
    let dg:[]u8="0123456789abcdef";
    let i:i32=0;
    while(i<len){
        let v:i32=b[off+i] as i32;
        hb[2*i]=dg[v/16];
        hb[2*i+1]=dg[v%16];
        i=i+1;
    }
    prlen(hb,len*2);
    nio_free(hb);
    return;
}

// ---------------- file IO (raw syscalls) ----------------
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn read_all(path:[]u8)[]u8 {
    let p:[]u8=z_cstr(path);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    let empty:[]u8=nio_alloc(0);
    if(fd<0){return empty;}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        else{
            if(n<=0){go=0;}
            else{
                let nb:i32=n as i32;
                if(total+nb>cap){go=0;}
                else{
                    copy_bytes(buf,total,chk,0,nb);
                    total=total+nb;
                }
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){nio_free(buf);return empty;}
    let out:[]u8=buf[0..total];
    return out;
}

// ---------------- arena helpers ----------------
// arena layout: [0..4) = used-bytes counter; data from 4 (linka/keya) or 8 (vocab).
fn arena_append(a:[]u8,v:i64)void {
    let u:i32=g32(a,0) as i32;
    p32(a,u,v);
    p32(a,0,(u+4) as i64);
    return;
}

// ---------------- vocab ----------------
// ---------------- number lexicon ----------------
// digit token: ^(\d+)(st|nd|rd|th)?$ -> integer; else -1. Token is lowercased.
fn digit_val(sb:[]u8,so:i32,sl:i32)i64 {
    // length of the leading digit run
    let i:i32=0;
    let go:i32=1;
    while(go==1){
        if(i>=sl){go=0;}
        else{
            let c3:u8=sb[so+i];
            if(c3>=48 && c3<=57){i=i+1;}
            else{go=0;}
        }
    }
    if(i==0){return -1;}
    let rest:i32=sl-i;
    if(rest!=0){
        if(rest!=2){return -1;}
        let s0:u8=sb[so+i];
        let s1:u8=sb[so+i+1];
        let ok:i32=0;
        if(s0==115 && s1==116){ok=1;}
        if(s0==110 && s1==100){ok=1;}
        if(s0==114 && s1==100){ok=1;}
        if(s0==116 && s1==104){ok=1;}
        if(ok==0){return -1;}
    }
    let v:i64=0;
    let j:i32=0;
    while(j<i){
        let d:i64=(sb[so+j] as i64)-48;
        v=v*10+d;
        j=j+1;
    }
    return v;
}

// cardinal words one..thirty and ordinal words first..thirtieth -> value; else -1.
fn numword_val(sb:[]u8,so:i32,sl:i32)i64 {
    if(beq(sb,so,sl,"one")==1){return 1;}
    if(beq(sb,so,sl,"two")==1){return 2;}
    if(beq(sb,so,sl,"three")==1){return 3;}
    if(beq(sb,so,sl,"four")==1){return 4;}
    if(beq(sb,so,sl,"five")==1){return 5;}
    if(beq(sb,so,sl,"six")==1){return 6;}
    if(beq(sb,so,sl,"seven")==1){return 7;}
    if(beq(sb,so,sl,"eight")==1){return 8;}
    if(beq(sb,so,sl,"nine")==1){return 9;}
    if(beq(sb,so,sl,"ten")==1){return 10;}
    if(beq(sb,so,sl,"eleven")==1){return 11;}
    if(beq(sb,so,sl,"twelve")==1){return 12;}
    if(beq(sb,so,sl,"thirteen")==1){return 13;}
    if(beq(sb,so,sl,"fourteen")==1){return 14;}
    if(beq(sb,so,sl,"fifteen")==1){return 15;}
    if(beq(sb,so,sl,"sixteen")==1){return 16;}
    if(beq(sb,so,sl,"seventeen")==1){return 17;}
    if(beq(sb,so,sl,"eighteen")==1){return 18;}
    if(beq(sb,so,sl,"nineteen")==1){return 19;}
    if(beq(sb,so,sl,"twenty")==1){return 20;}
    if(beq(sb,so,sl,"thirty")==1){return 30;}
    if(beq(sb,so,sl,"first")==1){return 1;}
    if(beq(sb,so,sl,"second")==1){return 2;}
    if(beq(sb,so,sl,"third")==1){return 3;}
    if(beq(sb,so,sl,"fourth")==1){return 4;}
    if(beq(sb,so,sl,"fifth")==1){return 5;}
    if(beq(sb,so,sl,"sixth")==1){return 6;}
    if(beq(sb,so,sl,"seventh")==1){return 7;}
    if(beq(sb,so,sl,"eighth")==1){return 8;}
    if(beq(sb,so,sl,"ninth")==1){return 9;}
    if(beq(sb,so,sl,"tenth")==1){return 10;}
    if(beq(sb,so,sl,"eleventh")==1){return 11;}
    if(beq(sb,so,sl,"twelfth")==1){return 12;}
    if(beq(sb,so,sl,"thirteenth")==1){return 13;}
    if(beq(sb,so,sl,"fourteenth")==1){return 14;}
    if(beq(sb,so,sl,"fifteenth")==1){return 15;}
    if(beq(sb,so,sl,"sixteenth")==1){return 16;}
    if(beq(sb,so,sl,"seventeenth")==1){return 17;}
    if(beq(sb,so,sl,"eighteenth")==1){return 18;}
    if(beq(sb,so,sl,"nineteenth")==1){return 19;}
    if(beq(sb,so,sl,"twentieth")==1){return 20;}
    if(beq(sb,so,sl,"thirtieth")==1){return 30;}
    return -1;
}

// ---------------- stemmer (frozen, first-match-wins, single pass) ----------------
fn ends_with(b:[]u8,len:i32,suf:[]u8)i32 {
    if(len<suf.len){return 0;}
    return beq2(b,len-suf.len,suf,0,suf.len);
}
fn stem_inplace(b:[]u8,len:i32)i32 {
    if(ends_with(b,len,"ies")==1){
        b[len-3]=121;
        return len-2;
    }
    if(ends_with(b,len,"ication")==1){
        b[len-7]=105;
        b[len-6]=115;
        b[len-5]=104;
        return len-4;
    }
    if(ends_with(b,len,"ished")==1){
        b[len-5]=105;
        b[len-4]=115;
        b[len-3]=104;
        return len-2;
    }
    if(ends_with(b,len,"ic")==1 && len>5){return len-2;}
    if(ends_with(b,len,"ed")==1 && len>4){return len-2;}
    if(ends_with(b,len,"ches")==1){return len-2;}
    if(ends_with(b,len,"shes")==1){return len-2;}
    if(ends_with(b,len,"sses")==1){return len-2;}
    if(ends_with(b,len,"xes")==1){return len-2;}
    if(ends_with(b,len,"zes")==1){return len-2;}
    if(ends_with(b,len,"s")==1 && len>3 && ends_with(b,len,"ss")==0){return len-1;}
    return len;
}

// --- irregular-form normalization (morphology crew, 2026-09-21) ---
// Maps irregular inflections to their lemma. Runs AFTER stem_inplace in
// proc_token, so KB-install and query paths stay symmetric by construction
// (single code path; no dual dictionaries). Inflectional only: suppletive
// tense forms and irregular participles/gerunds. Derivational pairs
// (high/height, tall/height) and synonyms (penned/wrote) are NOT bridged:
// documented boundary, see docs/lab/dialogue/morphology/MORPH_BATTERY.md.
fn irregular_norm(b:[]u8,len:i32)i32 {
    // bear family (birth/born share the "bear" lemma: to bear = give birth)
    if(beq(b,0,len,"birth")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"born")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    if(beq(b,0,len,"borne")==1){ copy_bytes(b,0,"bear",0,4); return 4; }
    // write family: REMOVED 2026-09-21 -- bridging wrote/written/written
    // collapses the KB's load-bearing active/passive distinction
    // ("X wrote the novel Y." vs "Y was written by X." are separate facts
    // with convention-dependent expected answers). 37 regressions.
    // Documented in MORPH_BATTERY.md as characterization probe C04.
    // teach family
    if(beq(b,0,len,"taught")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    if(beq(b,0,len,"teaching")==1){ copy_bytes(b,0,"teach",0,5); return 5; }
    // run family
    if(beq(b,0,len,"ran")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    if(beq(b,0,len,"running")==1){ copy_bytes(b,0,"run",0,3); return 3; }
    // speak family
    if(beq(b,0,len,"spoke")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"spoken")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    if(beq(b,0,len,"speaking")==1){ copy_bytes(b,0,"speak",0,5); return 5; }
    // think family
    if(beq(b,0,len,"thought")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    if(beq(b,0,len,"thinking")==1){ copy_bytes(b,0,"think",0,5); return 5; }
    // build family
    if(beq(b,0,len,"built")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    if(beq(b,0,len,"building")==1){ copy_bytes(b,0,"build",0,5); return 5; }
    // win family
    if(beq(b,0,len,"won")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    if(beq(b,0,len,"winning")==1){ copy_bytes(b,0,"win",0,3); return 3; }
    // silent-e verbs (2026-09-27): stem_inplace strips "upscaled"->"upscal"
    // via its -ed rule, but the bare "upscale" kept its e -- so a question's
    // predicate key never matched the fact's ("what did TNN upscale?"
    // retrieved the sticker fact: round-3 turn 11 root cause). Unify the
    // base form with the -ed stem. Closed list, same precedent as the
    // comparative list below.
    if(beq(b,0,len,"upscale")==1){ copy_bytes(b,0,"upscal",0,6); return 6; }
    if(beq(b,0,len,"reproduce")==1){ copy_bytes(b,0,"reproduc",0,8); return 8; }
    // comparative adjectives (F3-ARITHMETIC, 2026-09-23): the -er comparative
    // is INFLECTIONAL (a closed grammatical paradigm, like the -ed/-s/-ies
    // strips above), not the derivational class the morphology crew fenced
    // off (tall/height, high/tall are different lexemes; penned/wrote are
    // synonyms). A general "-er" suffix strip is rejected: it would mangle
    // load-bearing proper nouns ("tower"->"tow", "water"->"wat",
    // "author"->"autho"). Closed list only; runs in proc_token so KB-install
    // and query paths stay symmetric by construction.
    if(beq(b,0,len,"taller")==1){ copy_bytes(b,0,"tall",0,4); return 4; }
    if(beq(b,0,len,"older")==1){ copy_bytes(b,0,"old",0,3); return 3; }
    if(beq(b,0,len,"longer")==1){ copy_bytes(b,0,"long",0,4); return 4; }
    if(beq(b,0,len,"bigger")==1){ copy_bytes(b,0,"big",0,3); return 3; }
    if(beq(b,0,len,"smaller")==1){ copy_bytes(b,0,"small",0,5); return 5; }
    if(beq(b,0,len,"earlier")==1){ copy_bytes(b,0,"early",0,5); return 5; }
    if(beq(b,0,len,"later")==1){ copy_bytes(b,0,"late",0,4); return 4; }
    return len;
}

// ---------------- sentence pipeline ----------------
// st layout (40B): [0..4)ntok [4..8)ndig [8..12)nword [12..20)lastdig
//                 [20..28)lastword [28..32)nkey [32..36)trlen
// out layout (48B): [0..4)link_off [4..8)link_len [8..12)key_off [12..16)key_len
//                   [16..24)value [24..28)ok [28..32)ntok [32..36)ndig
//                   [36..40)nword [40..44)trlen
// tmp: lowercased token bytes; kid: key-id scratch (nkey*4); trb: trace buffer.
fn proc_token(vbytes:[]u8,vent:[]u8,tmp:[]u8,tlen:i32,kid:[]u8,linka:[]u8,trb:[]u8,st:[]u8)void {
    let dv:i64=digit_val(tmp,0,tlen);
    let cls:i32=0;
    let cval:i64=0;
    if(dv>=0){cls=1;cval=dv;}
    if(cls==0){
        let nv:i64=numword_val(tmp,0,tlen);
        if(nv>=0){cls=2;cval=nv;}
    }
    // LINK: intern raw token form
    let uid:i32=v_intern(vbytes,vent,tmp,0,tlen);
    arena_append(linka,uid as i64);
    p32(st,0,g32(st,0)+1);
    // extraction trace: token bytes + ','
    let trl:i32=g32(st,32) as i32;
    copy_bytes(trb,trl,tmp,0,tlen);
    trb[trl+tlen]=44;
    p32(st,32,(trl+tlen+1) as i64);
    if(cls==1){
        p32(st,4,g32(st,4)+1);
        p64(st,12,cval);
        return;
    }
    if(cls==2){
        p32(st,8,g32(st,8)+1);
        p64(st,20,cval);
        return;
    }
    if(is_stop(tmp,0,tlen)==1){return;}
    let sl:i32=stem_inplace(tmp,tlen);
    sl=irregular_norm(tmp,sl);
    let sid:i32=v_intern(vbytes,vent,tmp,0,sl);
    let nkey:i32=g32(st,28) as i32;
    let f:i32=0;
    let q:i32=0;
    while(q<nkey){
        if(g32(kid,q*4)==(sid as i64)){f=1;}
        q=q+1;
    }
    if(f==0){
        p32(kid,nkey*4,sid as i64);
        p32(st,28,(nkey+1) as i64);
    }
    return;
}

fn proc_sentence(vbytes:[]u8,vent:[]u8,sbuf:[]u8,soff:i32,slen:i32,tmp:[]u8,kid:[]u8,linka:[]u8,keya:[]u8,trb:[]u8,st:[]u8,out:[]u8)i64 {
    let link_off:i32=g32(linka,0) as i32;
    let i:i32=0;
    while(i<slen){
        if(is_alnum(sbuf[soff+i])==1){
            let j:i32=i;
            let go:i32=1;
            while(go==1){
                if(j<slen && is_alnum(sbuf[soff+j])==1){j=j+1;}
                else{go=0;}
            }
            let tlen:i32=j-i;
            let k:i32=0;
            while(k<tlen){
                tmp[k]=to_low(sbuf[soff+i+k]);
                k=k+1;
            }
            proc_token(vbytes,vent,tmp,tlen,kid,linka,trb,st);
            i=j;
        }
        else{i=i+1;}
    }
    let nkey:i32=g32(st,28) as i32;
    // insertion sort kid[0..nkey)
    let a2:i32=1;
    while(a2<nkey){
        let v2:i64=g32(kid,a2*4);
        let b2:i32=a2-1;
        let dn:i32=0;
        while(dn==0){
            if(b2<0){dn=1;}
            else{
                if(g32(kid,b2*4)<=v2){dn=1;}
                else{
                    p32(kid,(b2+1)*4,g32(kid,b2*4));
                    b2=b2-1;
                }
            }
        }
        p32(kid,(b2+1)*4,v2);
        a2=a2+1;
    }
    let key_off:i32=g32(keya,0) as i32;
    let q2:i32=0;
    while(q2<nkey){
        arena_append(keya,g32(kid,q2*4));
        q2=q2+1;
    }
    let link_used:i32=g32(linka,0) as i32;
    let link_len:i32=(link_used-link_off)/4;
    // frozen value scan: last digit-token value; else last number-word value
    let ndig:i32=g32(st,4) as i32;
    let nword:i32=g32(st,8) as i32;
    let ok:i64=0;
    let val:i64=0;
    if(ndig>0){ok=1;val=g64(st,12);}
    else{
        if(nword>0){ok=1;val=g64(st,20);}
    }
    p32(out,0,link_off as i64);
    p32(out,4,link_len as i64);
    p32(out,8,key_off as i64);
    p32(out,12,nkey as i64);
    p64(out,16,val);
    p32(out,24,ok);
    p32(out,28,g32(st,0));
    p32(out,32,g32(st,4));
    p32(out,36,g32(st,8));
    p32(out,40,g32(st,32));
    return ok;
}

// Jaccard packed score: inter in high 32, union in low 32. Compares by cross-multiplication.
fn jscore(kid:[]u8,plen:i32,keya:[]u8,fko:i32,fkl:i32)i64 {
    let a:i32=0;
    let b:i32=0;
    let inter:i32=0;
    let go:i32=1;
    while(go==1){
        if(a>=plen || b>=fkl){go=0;}
        else{
            let x:i64=g32(kid,a*4);
            let y:i64=g32(keya,fko+b*4);
            if(x==y){inter=inter+1;a=a+1;b=b+1;}
            else{
                if(x<y){a=a+1;}
                else{b=b+1;}
            }
        }
    }
    let union:i32=plen+fkl-inter;
    return ((inter as i64)<<32)|(union as i64);
}

fn is_stop(sb:[]u8,so:i32,sl:i32)i32 {
    if(beq(sb,so,sl,"the")==1){return 1;}
    if(beq(sb,so,sl,"an")==1){return 1;}
    if(beq(sb,so,sl,"of")==1){return 1;}
    if(beq(sb,so,sl,"in")==1){return 1;}
    if(beq(sb,so,sl,"is")==1){return 1;}
    if(beq(sb,so,sl,"are")==1){return 1;}
    if(beq(sb,so,sl,"was")==1){return 1;}
    if(beq(sb,so,sl,"were")==1){return 1;}
    if(beq(sb,so,sl,"be")==1){return 1;}
    if(beq(sb,so,sl,"been")==1){return 1;}
    if(beq(sb,so,sl,"what")==1){return 1;}
    if(beq(sb,so,sl,"which")==1){return 1;}
    if(beq(sb,so,sl,"that")==1){return 1;}
    if(beq(sb,so,sl,"this")==1){return 1;}
    if(beq(sb,so,sl,"these")==1){return 1;}
    if(beq(sb,so,sl,"those")==1){return 1;}
    if(beq(sb,so,sl,"it")==1){return 1;}
    if(beq(sb,so,sl,"its")==1){return 1;}
    if(beq(sb,so,sl,"do")==1){return 1;}
    if(beq(sb,so,sl,"does")==1){return 1;}
    if(beq(sb,so,sl,"did")==1){return 1;}
    if(beq(sb,so,sl,"have")==1){return 1;}
    if(beq(sb,so,sl,"has")==1){return 1;}
    if(beq(sb,so,sl,"had")==1){return 1;}
    if(beq(sb,so,sl,"there")==1){return 1;}
    if(beq(sb,so,sl,"and")==1){return 1;}
    if(beq(sb,so,sl,"or")==1){return 1;}
    if(beq(sb,so,sl,"to")==1){return 1;}
    if(beq(sb,so,sl,"for")==1){return 1;}
    if(beq(sb,so,sl,"with")==1){return 1;}
    if(beq(sb,so,sl,"at")==1){return 1;}
    if(beq(sb,so,sl,"by")==1){return 1;}
    if(beq(sb,so,sl,"from")==1){return 1;}
    if(beq(sb,so,sl,"as")==1){return 1;}
    if(beq(sb,so,sl,"on")==1){return 1;}
    if(beq(sb,so,sl,"how")==1){return 1;}
    if(beq(sb,so,sl,"many")==1){return 1;}
    if(beq(sb,so,sl,"much")==1){return 1;}
    if(beq(sb,so,sl,"when")==1){return 1;}
    if(beq(sb,so,sl,"where")==1){return 1;}
    if(beq(sb,so,sl,"s")==1){return 1;}
    // F4-DEFEND (PREREG_F4.md §2a): function words that polluted content key
    // sets. "a"/"i"/"you" are the turn-11 root cause ("a biography" matched
    // "as a museum" on pure noise). The rest are the same class: articles
    // and pronouns, never KB content. Pronoun BINDING uses raw tokens
    // (build_resolved), not keys, so it is unaffected. "not"/"no" are
    // deliberately NOT stopped (negation is load-bearing elsewhere).
    if(beq(sb,so,sl,"a")==1){return 1;}
    if(beq(sb,so,sl,"i")==1){return 1;}
    if(beq(sb,so,sl,"you")==1){return 1;}
    if(beq(sb,so,sl,"me")==1){return 1;}
    if(beq(sb,so,sl,"my")==1){return 1;}
    if(beq(sb,so,sl,"mine")==1){return 1;}
    if(beq(sb,so,sl,"we")==1){return 1;}
    if(beq(sb,so,sl,"us")==1){return 1;}
    if(beq(sb,so,sl,"our")==1){return 1;}
    if(beq(sb,so,sl,"ours")==1){return 1;}
    if(beq(sb,so,sl,"he")==1){return 1;}
    if(beq(sb,so,sl,"him")==1){return 1;}
    if(beq(sb,so,sl,"his")==1){return 1;}
    if(beq(sb,so,sl,"she")==1){return 1;}
    if(beq(sb,so,sl,"her")==1){return 1;}
    if(beq(sb,so,sl,"hers")==1){return 1;}
    if(beq(sb,so,sl,"they")==1){return 1;}
    if(beq(sb,so,sl,"them")==1){return 1;}
    if(beq(sb,so,sl,"their")==1){return 1;}
    if(beq(sb,so,sl,"theirs")==1){return 1;}
    if(beq(sb,so,sl,"your")==1){return 1;}
    if(beq(sb,so,sl,"yours")==1){return 1;}
    if(beq(sb,so,sl,"myself")==1){return 1;}
    if(beq(sb,so,sl,"yourself")==1){return 1;}
    if(beq(sb,so,sl,"himself")==1){return 1;}
    if(beq(sb,so,sl,"herself")==1){return 1;}
    if(beq(sb,so,sl,"itself")==1){return 1;}
    if(beq(sb,so,sl,"ourselves")==1){return 1;}
    if(beq(sb,so,sl,"themselves")==1){return 1;}
    // ADDENDUM 2026-09-23 (deviation from PREREG_F4.md §2a, documented in
    // VERDICT.md): "about" is a preposition/function word, same class as the
    // of/in/to/for/with/at/by/from/as/on already listed — the original list
    // simply missed it, and the code already treats "about" as a generic
    // word in the has_sub check in do_turn. Load-bearing: removing "a"
    // exposed a Jaccard tie ("What about Big Ben?": fact 29 vs 30, 2/5 each,
    // lower fid won) that the old "a"-pollution was accidentally breaking.
    // Stopping "about" lets the DESIGNED ellipsis mechanism fire
    // (content_count==0 -> carry over the previous question with the entity
    // swapped), which resolves the tie 3/4 for the correct fact.
    if(beq(sb,so,sl,"about")==1){return 1;}
    return 0;
}
fn v_intern(vbytes:[]u8,vent:[]u8,sb:[]u8,so:i32,sl:i32)i32 {
    let n:i32=g32(vent,0) as i32;
    let i:i32=0;
    while(i<n){
        let eo:i32=g32(vent,8+8*i) as i32;
        let el:i32=g32(vent,8+8*i+4) as i32;
        if(el==sl){
            if(beq2(sb,so,vbytes,eo,sl)==1){return i;}
        }
        i=i+1;
    }
    let used:i32=g32(vbytes,0) as i32;
    copy_bytes(vbytes,used,sb,so,sl);
    p32(vbytes,0,(used+sl) as i64);
    p32(vent,8+8*n,used as i64);
    p32(vent,8+8*n+4,sl as i64);
    p32(vent,0,(n+1) as i64);
    return n;
}

fn zero40(st:[]u8)void {
    let c:i32=0;
    while(c<40){st[c]=0;c=c+1;}
    return;
}

// ================= DIALOGUE LAYER (frozen prereg 2026-09-22) =================
// Deterministic multi-turn state manager around the pinned v1 retrieval core.
// All v1 functions above are used verbatim; nothing in the core is modified.

// --- generic substring find on (arena,off,len); returns index or -1 ---
fn find_sub(h:[]u8,ho:i32,hl:i32,n:[]u8,noff:i32,nl:i32)i32 {
    if(nl<=0){ return -1; }
    if(nl>hl){ return -1; }
    let i:i32=0;
    while(i+nl<=hl){
        if(beq2(h,ho+i,n,noff,nl)==1){ return i; }
        i=i+1;
    }
    return -1;
}

fn starts_with(h:[]u8,ho:i32,hl:i32,n:[]u8,nl:i32)i32 {
    if(nl>hl){ return 0; }
    return beq2(h,ho,n,0,nl);
}

// --- gazetteer install from "eid\tclass\tname\n" (names pre-lowercased) ---
// ge rows 16B: name_off@0 name_len@4 class@8 ; gord: scan order (len desc, eid asc)
fn gaz_install(gnames:[]u8,ge:[]u8,gord:[]u8,path:[]u8)void {
    let buf:[]u8=read_all(path);
    let bl:i32=buf.len;
    let p:i32=0;
    let e:i32=0;
    while(p<bl){
        let ls:i32=p;
        while(p<bl && buf[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<bl){ p=p+1; }
        if(le>ls){
            let q:i32=ls;
            while(q<le && buf[q]!=9){ q=q+1; }
            q=q+1;
            while(q<le && buf[q]!=9){ q=q+1; }
            q=q+1;
            let noff:i32=g32(gnames,0) as i32;
            let nl:i32=le-q;
            copy_bytes(gnames,noff,buf,q,nl);
            p32(gnames,0,noff+nl);
            let ro:i32=8+e*16;
            let qc:i32=ls;
            while(qc<le && buf[qc]!=9){ qc=qc+1; }
            let cls:i32=0;
            let qd:i32=qc+1;
            while(qd<le && buf[qd]!=9){ cls=cls*10+((buf[qd] as i32)-48); qd=qd+1; }
            p32(ge,ro,noff); p32(ge,ro+4,nl); p32(ge,ro+8,cls);
            e=e+1;
        }
    }
    p32(ge,0,e);
    let i2:i32=0;
    while(i2<e){ p32(gord,4+i2*4,i2); i2=i2+1; }
    let a:i32=1;
    while(a<e){
        let key:i32=g32(gord,4+a*4) as i32;
        let kl:i32=g32(ge,8+key*16+4) as i32;
        let b:i32=a-1;
        let go:i32=1;
        while(go==1){
            if(b<0){ go=0; }
            if(go==1){
                let be:i32=g32(gord,4+b*4) as i32;
                let bl2:i32=g32(ge,8+be*16+4) as i32;
                let swap:i32=0;
                if(bl2<kl){ swap=1; }
                if(bl2==kl && be>key){ swap=1; }
                if(swap==1){ p32(gord,4+(b+1)*4,be); b=b-1; }
                if(swap==0){ go=0; }
            }
        }
        p32(gord,4+(b+1)*4,key);
        a=a+1;
    }
    p32(gord,0,e);
    return;
}

// --- longest-match entity scan; writes eids (position order) to out; returns count ---
fn gaz_scan(gnames:[]u8,ge:[]u8,gord:[]u8,buf:[]u8,bo:i32,bl:i32,out:[]u8,excl:i32)i32 {
    let ne:i32=g32(gord,0) as i32;
    let n:i32=0;
    let pos:i32=0;
    while(pos<bl){
        let oi:i32=0;
        let hit:i32=-1;
        let hlen:i32=0;
        let go:i32=1;
        while(go==1){
            if(oi>=ne){ go=0; }
            if(go==1){
                let eid:i32=g32(gord,4+oi*4) as i32;
                if(eid!=excl){
                    let no:i32=g32(ge,8+eid*16) as i32;
                    let nl:i32=g32(ge,8+eid*16+4) as i32;
                    if(pos+nl<=bl && beq2(buf,bo+pos,gnames,no,nl)==1){ hit=eid; hlen=nl; go=0; }
                }
                oi=oi+1;
            }
        }
        if(hit>=0){ p32(out,n*4,hit); n=n+1; pos=pos+hlen; }
        if(hit<0){ pos=pos+1; }
    }
    return n;
}

// --- most salient entity (head of salience stack), or -1 ---
// A turn with no explicit entity and no bound pronoun continues the topic.
fn sal_head(sal:[]u8)i32 {
    let n:i32=g32(sal,0) as i32;
    if(n<=0){ return -1; }
    return g32(sal,4) as i32;
}

// --- keyword fallback: best eid by count of name-words present; -1 if none ---
// (short words <4 chars are skipped: "and"/"the"/"of" must not match names)
fn fallback_eid(gnames:[]u8,ge:[]u8,buf:[]u8,bo:i32,bl:i32,excl:i32)i32 {
    let ne:i32=g32(ge,0) as i32;
    let best:i32=-1;
    let bs:i32=0;
    let e:i32=0;
    while(e<ne){
        if(e!=excl){
            let no:i32=g32(ge,8+e*16) as i32;
            let nl:i32=g32(ge,8+e*16+4) as i32;
            let s:i32=0;
            let sc:i32=0;
            while(s<nl){
                while(s<nl && gnames[no+s]==32){ s=s+1; }
                let ws:i32=s;
                while(s<nl && gnames[no+s]!=32){ s=s+1; }
                if(s-ws>=4 && find_sub(buf,bo,bl,gnames,no+ws,s-ws)>=0){ sc=sc+1; }
            }
            if(sc>bs){ bs=sc; best=e; }
        }
        e=e+1;
    }
    return best;
}

// --- pronoun classes: 1=masc 2=fem 3=neut ---
fn pron_class(t:[]u8,to:i32,tl:i32)i32 {
    if(tl==2 && beq2(t,to,"he",0,2)==1){ return 1; }
    if(tl==3 && beq2(t,to,"him",0,3)==1){ return 1; }
    if(tl==3 && beq2(t,to,"his",0,3)==1){ return 1; }
    if(tl==3 && beq2(t,to,"she",0,3)==1){ return 2; }
    if(tl==3 && beq2(t,to,"her",0,3)==1){ return 2; }
    if(tl==2 && beq2(t,to,"it",0,2)==1){ return 3; }
    if(tl==3 && beq2(t,to,"its",0,3)==1){ return 3; }
    if(tl==4 && beq2(t,to,"they",0,4)==1){ return 3; }
    if(tl==4 && beq2(t,to,"them",0,4)==1){ return 3; }
    // "there" is a place anaphor: resolves to the most recent place/object
    // entity (class 3). Without this, "how many people live there?" leaves
    // the previous place unbound (repair #7).
    if(tl==5 && beq2(t,to,"there",0,5)==1){ return 3; }
    return 0;
}

// --- salience lookup: most-recent entry matching pronoun class ---
fn sal_bind(sal:[]u8,ge:[]u8,cls:i32)i32 {
    let n:i32=g32(sal,0) as i32;
    let i:i32=0;
    while(i<n){
        let e:i32=g32(sal,4+i*4) as i32;
        let ec:i32=g32(ge,8+e*16+8) as i32;
        if(cls==3 && ec==1){ return e; }
        if(cls!=3 && ec==0){ return e; }
        i=i+1;
    }
    return -1;
}

// --- build resolved query: bound pronouns replaced by entity names ---
// bout: [0..4)=bound count, entries after. Returns resolved length.
fn build_resolved(ubuf:[]u8,uo:i32,ul:i32,sal:[]u8,ge:[]u8,gnames:[]u8,out:[]u8,bout:[]u8)i32 {
    let tmp:[]u8=nio_alloc(256);
    let ol:i32=0;
    let bc:i32=0;
    let i:i32=0;
    while(i<ul){
        let ch:u8=ubuf[uo+i];
        if(is_alnum(ch)==1){
            let tl:i32=0;
            while(i<ul && is_alnum(ubuf[uo+i])==1){
                tmp[tl]=to_low(ubuf[uo+i]);
                tl=tl+1; i=i+1;
            }
            let pc:i32=pron_class(tmp,0,tl);
            let be:i32=-1;
            if(pc>0){ be=sal_bind(sal,ge,pc); }
            if(pc>0 && be>=0){
                let no:i32=g32(ge,8+be*16) as i32;
                let nl:i32=g32(ge,8+be*16+4) as i32;
                if(ol>0){ out[ol]=32; ol=ol+1; }
                copy_bytes(out,ol,gnames,no,nl);
                ol=ol+nl;
                p32(bout,4+bc*4,be); bc=bc+1;
            }
            if(pc==0 || be<0){
                if(ol>0){ out[ol]=32; ol=ol+1; }
                copy_bytes(out,ol,tmp,0,tl);
                ol=ol+tl;
            }
        }
        if(is_alnum(ch)==0){ i=i+1; }
    }
    p32(bout,0,bc);
    nio_free(tmp);
    return ol;
}

// --- count non-stopword tokens not covered by found entity names ---
fn content_count(ubuf:[]u8,uo:i32,ul:i32,eids:[]u8,ne:i32,gnames:[]u8,ge:[]u8)i32 {
    let tmp:[]u8=nio_alloc(256);
    let c:i32=0;
    let i:i32=0;
    while(i<ul){
        let ch:u8=ubuf[uo+i];
        if(is_alnum(ch)==1){
            let tl:i32=0;
            while(i<ul && is_alnum(ubuf[uo+i])==1){
                tmp[tl]=to_low(ubuf[uo+i]);
                tl=tl+1; i=i+1;
            }
            if(is_stop(tmp,0,tl)==0){
                let cov:i32=0;
                let k:i32=0;
                while(k<ne && cov==0){
                    let e:i32=g32(eids,k*4) as i32;
                    let no:i32=g32(ge,8+e*16) as i32;
                    let nl:i32=g32(ge,8+e*16+4) as i32;
                    let s:i32=0;
                    while(s<nl && cov==0){
                        while(s<nl && gnames[no+s]==32){ s=s+1; }
                        let ws:i32=s;
                        while(s<nl && gnames[no+s]!=32){ s=s+1; }
                        if(s-ws==tl && beq2(tmp,0,gnames,no+ws,tl)==1){ cov=1; }
                    }
                    k=k+1;
                }
                if(cov==0){ c=c+1; }
            }
        }
        if(is_alnum(ch)==0){ i=i+1; }
    }
    nio_free(tmp);
    return c;
}

// --- salience: most-recent-first, dedup, cap 8 ---
fn sal_push(sal:[]u8,e:i32)void {
    let n:i32=g32(sal,0) as i32;
    let i:i32=0;
    let f:i32=-1;
    while(i<n){
        if((g32(sal,4+i*4) as i32)==e){ f=i; }
        i=i+1;
    }
    if(f<0 && n>=8){ n=7; }
    if(f>=0){ n=f; }
    // shift entries [0..n) right by one, dropping [n)
    let j:i32=n;
    while(j>0){ p32(sal,4+j*4,g32(sal,4+(j-1)*4)); j=j-1; }
    p32(sal,4,e);
    if(f>=0){ p32(sal,0,(g32(sal,0) as i32)); }
    if(f<0){ p32(sal,0,n+1); }
    return;
}

// --- topic stack ---
fn top_push(top:[]u8,e:i32)void {
    let n:i32=g32(top,0) as i32;
    p32(top,4+n*4,e);
    p32(top,0,n+1);
    return;
}
fn top_peek(top:[]u8)i32 {
    let n:i32=g32(top,0) as i32;
    if(n<=0){ return -1; }
    return g32(top,4+(n-1)*4) as i32;
}
fn top_has(top:[]u8,e:i32)i32 {
    let n:i32=g32(top,0) as i32;
    let i:i32=0;
    while(i<n){
        if((g32(top,4+i*4) as i32)==e){ return 1; }
        i=i+1;
    }
    return 0;
}
fn top_pop_to(top:[]u8,e:i32)void {
    let n:i32=g32(top,0) as i32;
    let i:i32=n-1;
    let f:i32=-1;
    let go:i32=1;
    while(go==1){
        if(i<0){ go=0; }
        if(go==1){
            if((g32(top,4+i*4) as i32)==e){ f=i; go=0; }
            if(f<0){ i=i-1; }
        }
    }
    if(f>=0){ p32(top,0,f+1); }
    return;
}
fn top_pop1(top:[]u8)void {
    let n:i32=g32(top,0) as i32;
    if(n>0){ p32(top,0,n-1); }
    return;
}

// --- response buffer: [0..4)=len ---
fn rclr(resp:[]u8)void { p32(resp,0,0); return; }
fn rput(resp:[]u8,s:[]u8,so:i32,sl:i32)void {
    let l:i32=g32(resp,0) as i32;
    copy_bytes(resp,4+l,s,so,sl);
    p32(resp,0,l+sl);
    return;
}

// --- number grabbing ---
fn grab_num_left(b:[]u8,bo:i32,pos:i32)i32 {
    let j:i32=pos-1;
    while(j>=bo && b[j]>=48 && b[j]<=57){ j=j-1; }
    if(j==pos-1){ return -1; }
    return parse_int(b,j+1,pos-(j+1)) as i32;
}
fn grab_num_right(b:[]u8,bo:i32,bl:i32,pos:i32)i32 {
    let j:i32=pos;
    while(j<bo+bl && (b[j]<48 || b[j]>57)){ j=j+1; }
    if(j>=bo+bl){ return -1; }
    let k:i32=j;
    while(k<bo+bl && b[k]>=48 && b[k]<=57){ k=k+1; }
    return parse_int(b,j,k-j) as i32;
}

// --- KB install: fm rows 40B: fid@0 key_off@4 key_len@8 value@12 text_off@16
// text_len@20 ent_off@24 ent_n@28 ---
fn kb_install(fm:[]u8,ftx:[]u8,ftl:[]u8,fea:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,keya:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,path:[]u8,tmp:[]u8,kid:[]u8,trb:[]u8,st:[]u8,out:[]u8,eout:[]u8)i32 {
    let buf:[]u8=read_all(path);
    let bl:i32=buf.len;
    let p:i32=0;
    let f:i32=0;
    while(p<bl){
        let ls:i32=p;
        while(p<bl && buf[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<bl){ p=p+1; }
        if(le>ls){
            let q:i32=ls;
            let fid:i32=0;
            while(q<le && buf[q]!=9){ fid=fid*10+((buf[q] as i32)-48); q=q+1; }
            q=q+1;
            let to:i32=g32(ftx,0) as i32;
            let tl:i32=le-q;
            copy_bytes(ftx,to,buf,q,tl);
            let lc:i32=0;
            while(lc<tl){ ftl[to+lc]=to_low(buf[q+lc]); lc=lc+1; }
            p32(ftx,0,to+tl);
            p32(ftl,0,to+tl);
            p32(linka,0,8);
            zero40(st);
            proc_sentence(vbytes,vent,buf,q,tl,tmp,kid,linka,keya,trb,st,out);
            let ko:i32=g32(out,8) as i32;
            let kl:i32=g32(out,12) as i32;
            let val:i32=g64(out,16) as i32;
            let eo:i32=g32(fea,0) as i32;
            let ne:i32=gaz_scan(gnames,ge,gord,ftl,to,tl,eout,-1);
            let k2:i32=0;
            while(k2<ne){ p32(fea,eo+k2*4,g32(eout,k2*4)); k2=k2+1; }
            p32(fea,0,eo+ne*4);
            let ro:i32=8+f*40;
            p32(fm,ro,fid); p32(fm,ro+4,ko); p32(fm,ro+8,kl); p32(fm,ro+12,val);
            p32(fm,ro+16,to); p32(fm,ro+20,tl); p32(fm,ro+24,eo); p32(fm,ro+28,ne);
            f=f+1;
        }
    }
    p32(fm,0,f);
    return f;
}

// --- retrieval: best fid by v1 cross-multiplied Jaccard; tie -> lower fid ---
fn retrieve(fm:[]u8,keya:[]u8,kid:[]u8,plen:i32,excl_fid:i32,excl_eid:i32,fea:[]u8,tbfid:i32)i32 {
    return retrieve_ex(fm,keya,kid,plen,excl_fid,-1,excl_eid,fea,tbfid);
}
// retrieve with two fact-id exclusions (for a distinct top-3 slate).
fn retrieve_ex(fm:[]u8,keya:[]u8,kid:[]u8,plen:i32,excl_fid:i32,excl_fid2:i32,excl_eid:i32,fea:[]u8,tbfid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let first:i32=1;
    let bi:i64=0;
    let bu:i64=1;
    let best:i32=-1;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let fid:i32=g32(fm,ro) as i32;
        let skip:i32=0;
        if(fid==excl_fid){ skip=1; }
        if(fid==excl_fid2){ skip=1; }
        if(skip==0 && excl_eid>=0){
            let eo:i32=g32(fm,ro+24) as i32;
            let en:i32=g32(fm,ro+28) as i32;
            let k:i32=0;
            while(k<en){
                if((g32(fea,eo+k*4) as i32)==excl_eid){ skip=1; }
                k=k+1;
            }
        }
        if(skip==0){
            let fko:i32=g32(fm,ro+4) as i32;
            let fkl:i32=g32(fm,ro+8) as i32;
            let sc:i64=jscore(kid,plen,keya,fko,fkl);
            let inter:i64=(sc>>32)&4294967295;
            let union:i64=sc&4294967295;
            if(first==1){
                bi=inter; bu=union; best=fid; first=0;
            }
            if(first==0){
                let lhs:i64=inter*bu;
                let rhs:i64=bi*union;
                if(lhs>rhs){ bi=inter; bu=union; best=fid; }
                else {
                    if(tbfid>=0 && fid==tbfid && lhs==rhs && rhs>0){ bi=inter; bu=union; best=fid; }
                }
            }
        }
        fx=fx+1;
    }
    return best;
}

// --- lowest fid whose entity list contains eid ---
fn general_fact(fm:[]u8,fea:[]u8,eid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let eo:i32=g32(fm,ro+24) as i32;
        let en:i32=g32(fm,ro+28) as i32;
        let k:i32=0;
        while(k<en){
            if((g32(fea,eo+k*4) as i32)==eid){ return g32(fm,ro) as i32; }
            k=k+1;
        }
        fx=fx+1;
    }
    return -1;
}

// --- first entity (position order) of a fact, or -1 ---
fn fact_primary(fm:[]u8,fea:[]u8,fid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            let en:i32=g32(fm,ro+28) as i32;
            if(en>0){
                let eo:i32=g32(fm,ro+24) as i32;
                return g32(fea,eo) as i32;
            }
            return -1;
        }
        fx=fx+1;
    }
    return -1;
}

// --- assertion extraction. Returns rel 1..6 or 0; abuf: subj@0 val@8 ---
// rel: 1=WROTE(subj=work,val=person) 2=BORN(subj=person,val=year)
//      3=BUILT(subj=place,val=year) 4=TALL(subj=place,val=m)
//      5=CAPITAL(subj=country,val=city) 6=LOCATED(subj=ent,val=place)
fn extract_assert(ubuf:[]u8,uo:i32,ul:i32,gnames:[]u8,ge:[]u8,gord:[]u8,abuf:[]u8,eout:[]u8)i32 {
    let ne:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
    // class of eout entry k: g32(ge,8+eid*16+8)
    let i:i32=find_sub(ubuf,uo,ul," wrote ",0,7);
    if(i>=0){
        // last person entity left of i (positions recomputed in the left region)
        let pe:i32=-1;
        let k2:i32=0;
        while(k2<ne){
            let e2:i32=g32(eout,k2*4) as i32;
            let no2:i32=g32(ge,8+e2*16) as i32;
            let nl2:i32=g32(ge,8+e2*16+4) as i32;
            let at2:i32=find_sub(ubuf,uo,i,gnames,no2,nl2);
            if(at2>=0 && (g32(ge,8+e2*16+8) as i32)==0){ pe=e2; }
            k2=k2+1;
        }
        let wo:i32=-1;
        let k3:i32=0;
        while(k3<ne && wo<0){
            let e3:i32=g32(eout,k3*4) as i32;
            let no3:i32=g32(ge,8+e3*16) as i32;
            let nl3:i32=g32(ge,8+e3*16+4) as i32;
            if(find_sub(ubuf,uo+i+7,ul-i-7,gnames,no3,nl3)>=0){ wo=e3; }
            k3=k3+1;
        }
        if(pe>=0 && wo>=0){
            p32(abuf,0,wo); p32(abuf,8,pe);
            return 1;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," was written by ",0,15);
    if(i>=0){
        let wo2:i32=-1;
        let k4:i32=0;
        while(k4<ne){
            let e4:i32=g32(eout,k4*4) as i32;
            let no4:i32=g32(ge,8+e4*16) as i32;
            let nl4:i32=g32(ge,8+e4*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no4,nl4)>=0){ wo2=e4; }
            k4=k4+1;
        }
        let pe2:i32=-1;
        let k5:i32=0;
        while(k5<ne && pe2<0){
            let e5:i32=g32(eout,k5*4) as i32;
            let no5:i32=g32(ge,8+e5*16) as i32;
            let nl5:i32=g32(ge,8+e5*16+4) as i32;
            if((g32(ge,8+e5*16+8) as i32)==0 && find_sub(ubuf,uo+i+15,ul-i-15,gnames,no5,nl5)>=0){ pe2=e5; }
            k5=k5+1;
        }
        if(wo2>=0 && pe2>=0){
            p32(abuf,0,wo2); p32(abuf,8,pe2);
            return 1;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," meters tall",0,11);
    if(i>=0){
        let num:i32=grab_num_left(ubuf,uo,uo+i);
        let ee:i32=-1;
        let k6:i32=0;
        while(k6<ne){
            let e6:i32=g32(eout,k6*4) as i32;
            let no6:i32=g32(ge,8+e6*16) as i32;
            let nl6:i32=g32(ge,8+e6*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no6,nl6)>=0){ ee=e6; }
            k6=k6+1;
        }
        if(ee>=0 && num>=0){
            p32(abuf,0,ee); p32(abuf,8,num);
            return 4;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," was built in ",0,13);
    if(i>=0){
        let num2:i32=grab_num_right(ubuf,uo,ul,uo+i+13);
        let ee2:i32=-1;
        let k7:i32=0;
        while(k7<ne){
            let e7:i32=g32(eout,k7*4) as i32;
            let no7:i32=g32(ge,8+e7*16) as i32;
            let nl7:i32=g32(ge,8+e7*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no7,nl7)>=0){ ee2=e7; }
            k7=k7+1;
        }
        if(ee2>=0 && num2>=0){
            p32(abuf,0,ee2); p32(abuf,8,num2);
            return 3;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," was born in ",0,12);
    if(i>=0){
        let num3:i32=grab_num_right(ubuf,uo,ul,uo+i+12);
        let ee3:i32=-1;
        let k8:i32=0;
        while(k8<ne){
            let e8:i32=g32(eout,k8*4) as i32;
            let no8:i32=g32(ge,8+e8*16) as i32;
            let nl8:i32=g32(ge,8+e8*16+4) as i32;
            if((g32(ge,8+e8*16+8) as i32)==0 && find_sub(ubuf,uo,i,gnames,no8,nl8)>=0){ ee3=e8; }
            k8=k8+1;
        }
        if(ee3>=0 && num3>=0){
            p32(abuf,0,ee3); p32(abuf,8,num3);
            return 2;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," is the capital of ",0,18);
    if(i>=0){
        let city:i32=-1;
        let k9:i32=0;
        while(k9<ne){
            let e9:i32=g32(eout,k9*4) as i32;
            let no9:i32=g32(ge,8+e9*16) as i32;
            let nl9:i32=g32(ge,8+e9*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no9,nl9)>=0){ city=e9; }
            k9=k9+1;
        }
        let ctry:i32=-1;
        let k10:i32=0;
        while(k10<ne && ctry<0){
            let e10:i32=g32(eout,k10*4) as i32;
            let no10:i32=g32(ge,8+e10*16) as i32;
            let nl10:i32=g32(ge,8+e10*16+4) as i32;
            if(find_sub(ubuf,uo+i+18,ul-i-18,gnames,no10,nl10)>=0){ ctry=e10; }
            k10=k10+1;
        }
        if(city>=0 && ctry>=0){
            p32(abuf,0,ctry); p32(abuf,8,city);
            return 5;
        }
        return 0;
    }
    i=find_sub(ubuf,uo,ul," is in ",0,6);
    if(i>=0){
        let e11:i32=-1;
        let k11:i32=0;
        while(k11<ne){
            let e12:i32=g32(eout,k11*4) as i32;
            let no11:i32=g32(ge,8+e12*16) as i32;
            let nl11:i32=g32(ge,8+e12*16+4) as i32;
            if(find_sub(ubuf,uo,i,gnames,no11,nl11)>=0){ e11=e12; }
            k11=k11+1;
        }
        let pl:i32=-1;
        let k12:i32=0;
        while(k12<ne && pl<0){
            let e13:i32=g32(eout,k12*4) as i32;
            let no12:i32=g32(ge,8+e13*16) as i32;
            let nl12:i32=g32(ge,8+e13*16+4) as i32;
            if(find_sub(ubuf,uo+i+6,ul-i-6,gnames,no12,nl12)>=0){ pl=e13; }
            k12=k12+1;
        }
        if(e11>=0 && pl>=0){
            p32(abuf,0,e11); p32(abuf,8,pl);
            return 6;
        }
        return 0;
    }
    return 0;
}

// --- uclaim ledger: rows 16B subj@0 rel@4 val@8 turn@12. val is eid for rel 1,5,6 ---
// returns: 0=stored(no conflict) 1=conflict(existing turn in cturn, old val in coval)
fn uclaim_check(uc:[]u8,subj:i32,rel:i32,val:i32,turn:i32,cturn:[]u8,coval:[]u8)i32 {
    let n:i32=g32(uc,0) as i32;
    let i:i32=0;
    while(i<n){
        let ro:i32=4+i*16;
        if((g32(uc,ro) as i32)==subj && (g32(uc,ro+4) as i32)==rel){
            let ov:i32=g32(uc,ro+8) as i32;
            if(ov!=val){
                p32(cturn,0,g32(uc,ro+12));
                p32(coval,0,ov);
                return 1;
            }
            return 0;
        }
        i=i+1;
    }
    let ro2:i32=4+n*16;
    p32(uc,ro2,subj); p32(uc,ro2+4,rel); p32(uc,ro2+8,val); p32(uc,ro2+12,turn);
    p32(uc,0,n+1);
    return 0;
}

// --- relation helpers over installed facts (ftl = lowercased text) ---
fn fact_has_ent(fm:[]u8,fea:[]u8,fx:i32,eid:i32)i32 {
    let ro:i32=8+fx*40;
    let eo:i32=g32(fm,ro+24) as i32;
    let en:i32=g32(fm,ro+28) as i32;
    let k:i32=0;
    while(k<en){
        if((g32(fea,eo+k*4) as i32)==eid){ return 1; }
        k=k+1;
    }
    return 0;
}
// AUTHOR_OF: lowest-fid fact naming the work, with a person entity, containing " wrote "
fn author_of(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,work:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        let no:i32=g32(ge,8+work*16) as i32;
        let nl:i32=g32(ge,8+work*16+4) as i32;
        if(find_sub(ftl,to,tl,gnames,no,nl)>=0 && find_sub(ftl,to,tl," wrote ",0,7)>=0){
            let eo:i32=g32(fm,ro+24) as i32;
            let en:i32=g32(fm,ro+28) as i32;
            let k:i32=0;
            while(k<en){
                let e:i32=g32(fea,eo+k*4) as i32;
                if((g32(ge,8+e*16+8) as i32)==0){ return e; }
                k=k+1;
            }
        }
        fx=fx+1;
    }
    return -1;
}
// year_of: value of lowest-fid fact naming eid and containing marker
fn year_of(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32,marker:[]u8,ml:i32)i32 {    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        let no:i32=g32(ge,8+eid*16) as i32;
        let nl:i32=g32(ge,8+eid*16+4) as i32;
        if(find_sub(ftl,to,tl,gnames,no,nl)>=0 && find_sub(ftl,to,tl,marker,0,ml)>=0){
            return g32(fm,ro+12) as i32;
        }
        fx=fx+1;
    }
    return -1;
}
// born_fact_of (morphology crew, 2026-09-21): fid of the lowest-fid fact
// naming eid whose text contains " born ". Mirrors year_of; returns the
// fact id (not the value) so the caller can emit the fact verbatim.
fn born_fact_of(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        let no:i32=g32(ge,8+eid*16) as i32;
        let nl:i32=g32(ge,8+eid*16+4) as i32;
        if(find_sub(ftl,to,tl,gnames,no,nl)>=0 && find_sub(ftl,to,tl," born ",0,6)>=0){
            return g32(fm,ro) as i32;
        }
        fx=fx+1;
    }
    return -1;
}
fn wrote_rel(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,person:i32,work:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        let pn:i32=g32(ge,8+person*16) as i32;
        let pl:i32=g32(ge,8+person*16+4) as i32;
        let wn:i32=g32(ge,8+work*16) as i32;
        let wl:i32=g32(ge,8+work*16+4) as i32;
        if(find_sub(ftl,to,tl,gnames,pn,pl)>=0 && find_sub(ftl,to,tl,gnames,wn,wl)>=0 && find_sub(ftl,to,tl," wrote ",0,7)>=0){
            return 1;
        }
        fx=fx+1;
    }
    return 0;
}

// --- composition templates; returns 1 if handled (response written) ---
// ================= INTEGRATED round-2 repair =================
// Five families merged per PREREG_INT.md. Slot map:
//   prevbn@32 (F4) | F1 compared pair@40/44 | F3 carry pair@48/52
//   F3 dim@56 (write-only) | F3 carry turn@60
// =================================================================

// ================= F4-DEFEND (PREREG_F4.md §2b/§2c) =================
// Challenge + provenance handling. Utterance-type patterns only — no entity
// or fact literals anywhere in this block.

// --- challenge patterns: "are you sure?"-style ---
fn is_challenge(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(find_sub(ubuf,uo,ul,"are you sure",0,12)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"you sure",0,8)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"are you certain",0,15)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"sure about that",0,15)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"is that true",0,12)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"is that right",0,13)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"really",0,6)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"i doubt",0,7)>=0){ return 1; }
    return 0;
}

// --- provenance patterns. On match, writes the offset just past the match
// into off[0] and returns 1; else returns 0. ---
fn prov_match(ubuf:[]u8,uo:i32,ul:i32,off:[]u8)i32 {
    let at:i32=find_sub(ubuf,uo,ul,"how do you know",0,15);
    if(at>=0){ p32(off,0,uo+at+15); return 1; }
    at=find_sub(ubuf,uo,ul,"how did you learn",0,16);
    if(at>=0){ p32(off,0,uo+at+16); return 1; }
    at=find_sub(ubuf,uo,ul,"where did you learn",0,18);
    if(at>=0){ p32(off,0,uo+at+18); return 1; }
    at=find_sub(ubuf,uo,ul,"who told you",0,12);
    if(at>=0){ p32(off,0,uo+at+12); return 1; }
    at=find_sub(ubuf,uo,ul,"who taught you",0,14);
    if(at>=0){ p32(off,0,uo+at+14); return 1; }
    at=find_sub(ubuf,uo,ul,"why do you think",0,15);
    if(at>=0){ p32(off,0,uo+at+15); return 1; }
    at=find_sub(ubuf,uo,ul,"how can you be sure",0,18);
    if(at>=0){ p32(off,0,uo+at+18); return 1; }
    return 0;
}

// --- last digit-token value in buf[bo..bo+bl), or -1 ---
fn last_digit_buf(b:[]u8,bo:i32,bl:i32)i32 {
    let tmp:[]u8=nio_alloc(64);
    let last:i64=-1;
    let i:i32=0;
    while(i<bl){
        if(is_alnum(b[bo+i])==1){
            let tl:i32=0;
            while(i<bl && is_alnum(b[bo+i])==1){
                if(tl<64){ tmp[tl]=to_low(b[bo+i]); }
                tl=tl+1; i=i+1;
            }
            if(tl<=64){
                let dv:i64=digit_val(tmp,0,tl);
                if(dv>=0){ last=dv; }
            }
        }
        else{ i=i+1; }
    }
    nio_free(tmp);
    return last as i32;
}

// --- last digit-token value in the (lowercased) text of fact fid, or -1 ---
fn fact_last_digit(fm:[]u8,ftl:[]u8,fid:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            let to:i32=g32(fm,ro+16) as i32;
            let tl:i32=g32(fm,ro+20) as i32;
            return last_digit_buf(ftl,to,tl);
        }
        fx=fx+1;
    }
    return -1;
}

// --- append fact fid's text to resp; strip_dot removes a trailing "." ---
fn fact_text_into(resp:[]u8,fm:[]u8,ftx:[]u8,fid:i32,strip_dot:i32)void {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    let hit:i32=0;
    while(fx<nf && hit==0){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            let to:i32=g32(fm,ro+16) as i32;
            let tl:i32=g32(fm,ro+20) as i32;
            if(strip_dot==1 && tl>0 && ftx[to+tl-1]==46){ tl=tl-1; }
            rput(resp,ftx,to,tl);
            hit=1;
        }
        fx=fx+1;
    }
    return;
}

// --- challenge defense: "Yes. <fact>[, not <n>]. I was taught that."
// chall >= 0: the challenge named a conflicting digit -> address it. ---
fn do_defense(resp:[]u8,fm:[]u8,ftx:[]u8,nbuf:[]u8,fid:i32,chall:i32)void {
    rclr(resp);
    rput(resp,"Yes. ",0,5);
    if(chall>=0){ fact_text_into(resp,fm,ftx,fid,1); }
    else{ fact_text_into(resp,fm,ftx,fid,0); }
    if(chall>=0){
        rput(resp,", not ",0,6);
        let nl:i32=i64str(chall as i64,nbuf);
        rput(resp,nbuf,0,nl);
        rput(resp,".",0,1);
    }
    rput(resp," I was taught that.",0,19);
    return;
}

// --- provenance: "I was taught that <fact>." Honest basis, no invented source. ---
fn do_provenance(resp:[]u8,fm:[]u8,ftx:[]u8,fid:i32)void {
    rclr(resp);
    rput(resp,"I was taught that ",0,18);
    fact_text_into(resp,fm,ftx,fid,0);
    return;
}

// --- F5 utterance-type dispatcher (2026-09-23) ---
// Classifies the input BEFORE any retrieval: 1=joke request, 2=memory/
// history question, 3=forget instruction, 0=other (normal pipeline).
// Token-level matching on the lowercased input buffer (no substring hits).

// token-level literal match: walks alnum-separated tokens
fn tok_has(ubuf:[]u8,uo:i32,ul:i32,lit:[]u8)i32 {
    let i:i32=0;
    while(i<ul){
        while(i<ul && is_alnum(ubuf[uo+i])==0){ i=i+1; }
        if(i<ul){
            let ts:i32=i;
            while(i<ul && is_alnum(ubuf[uo+i])==1){ i=i+1; }
            if(beq(ubuf,uo+ts,i-ts,lit)==1){ return 1; }
        }
    }
    return 0;
}

// memory-question shape: "remember"/"recall", or self-referential past
// speech ("what was the first thing i asked?", "my second question").
// (widened from did+i+verb during scaffold: "was" is as common as "did".)
fn is_mem_q(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(tok_has(ubuf,uo,ul,"remember")==1){ return 1; }
    if(tok_has(ubuf,uo,ul,"recall")==1){ return 1; }
    let self:i32=0;
    if(tok_has(ubuf,uo,ul,"i")==1){ self=1; }
    if(tok_has(ubuf,uo,ul,"my")==1){ self=1; }
    if(self==1){
        if(tok_has(ubuf,uo,ul,"ask")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"asked")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"say")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"said")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"tell")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"told")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"question")==1){ return 1; }
        if(tok_has(ubuf,uo,ul,"questions")==1){ return 1; }
    }
    return 0;
}

// dispatcher: 1=joke 2=memory 3=forget 0=other. Precedence: forget > joke > memory.
fn utter_type(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(tok_has(ubuf,uo,ul,"forget")==1){ return 3; }
    if(tok_has(ubuf,uo,ul,"forgot")==1){ return 3; }
    if(tok_has(ubuf,uo,ul,"forgotten")==1){ return 3; }
    if(tok_has(ubuf,uo,ul,"joke")==1){ return 1; }
    if(tok_has(ubuf,uo,ul,"jokes")==1){ return 1; }
    if(is_mem_q(ubuf,uo,ul)==1){ return 2; }
    return 0;
}

// ordinal token scan via the number-word table (first->1 .. thirtieth->30)
fn mem_ord(ubuf:[]u8,uo:i32,ul:i32)i32 {
    let i:i32=0;
    while(i<ul){
        while(i<ul && is_alnum(ubuf[uo+i])==0){ i=i+1; }
        if(i<ul){
            let ts:i32=i;
            while(i<ul && is_alnum(ubuf[uo+i])==1){ i=i+1; }
            let v:i64=numword_val(ubuf,uo+ts,i-ts);
            if(v>0){ return v as i32; }
        }
    }
    return 0;
}


// --- F5: read back the write-only history. kind-0 rows are user turns; the
// last row is always the current turn (main records it before do_turn), so
// recall scans rows [0, n-1). Selects by ordinal; default = most recent.
fn mem_answer(resp:[]u8,ubuf:[]u8,uo:i32,ul:i32,hist:[]u8,histb:[]u8)void {
    let n:i32=g32(hist,0) as i32;
    let c:i32=0;
    let hx:i32=0;
    while(hx<n-1){
        if((g32(hist,4+hx*12) as i32)==0){ c=c+1; }
        hx=hx+1;
    }
    if(c==0){
        let nm:[]u8="You haven't asked anything before this.";
        rput(resp,nm,0,nm.len);
        return;
    }
    let sel:i32=c-1;
    let done:i32=0;
    if(tok_has(ubuf,uo,ul,"first")==1){ sel=0; done=1; }
    if(done==0 && tok_has(ubuf,uo,ul,"last")==1){ done=1; }
    if(done==0 && tok_has(ubuf,uo,ul,"previous")==1){ done=1; }
    if(done==0 && tok_has(ubuf,uo,ul,"latest")==1){ done=1; }
    if(done==0){
        let on:i32=mem_ord(ubuf,uo,ul);
        if(on>0 && on<=c){ sel=on-1; }
    }
    let seen:i32=0;
    let row:i32=-1;
    hx=0;
    while(hx<n-1){
        if((g32(hist,4+hx*12) as i32)==0){
            if(seen==sel){ row=hx; }
            seen=seen+1;
        }
        hx=hx+1;
    }
    if(row<0){ row=n-2; }
    let ho:i32=g32(hist,4+row*12+4) as i32;
    let hl:i32=g32(hist,4+row*12+8) as i32;
    let pre:[]u8="You asked: ";
    rput(resp,pre,0,pre.len);
    rput(resp,histb,ho,hl);
    return;
}

// --- F1-COMPARE (2026-09-23): general comparison engine ---
// Replaces the two frozen string-prefix branches ("was the author of" and
// "which is taller"). Intent = comparison WORDS anywhere in the turn
// (grammatical class, not phrasing); entities = resolved mentions (full
// names or distinctive single words like "darwin"); values = data-driven
// marker scan via the existing year_of(); answer = yes/no or winner.
// No per-phrasing branches, no per-entity special cases.
fn needs_the(gnames:[]u8,wno:i32,wnl:i32)i32 {
    if(wnl==12 && beq2(gnames,wno,"eiffel tower",0,12)==1){ return 1; }
    if(wnl==18 && beq2(gnames,wno,"montparnasse tower",0,18)==1){ return 1; }
    if(wnl==17 && beq2(gnames,wno,"statue of liberty",0,17)==1){ return 1; }
    if(wnl==6 && beq2(gnames,wno,"louvre",0,6)==1){ return 1; }
    if(wnl==9 && beq2(gnames,wno,"colosseum",0,9)==1){ return 1; }
    return 0;
}
// word_entity: eid of the UNIQUE entity containing the word
// buf[bo+pos..bo+pos+wl) as one of its name-words, else -1.
// A word shared by 2+ entities ("tower") is never distinctive.
fn word_entity(gnames:[]u8,ge:[]u8,buf:[]u8,bo:i32,pos:i32,wl:i32)i32 {
    let ne:i32=g32(ge,0) as i32;
    let hit:i32=-1;
    let n:i32=0;
    let e:i32=0;
    while(e<ne){
        let no:i32=g32(ge,8+e*16) as i32;
        let nl:i32=g32(ge,8+e*16+4) as i32;
        let s:i32=0;
        let f:i32=0;
        while(s<nl && f==0){
            while(s<nl && gnames[no+s]==32){ s=s+1; }
            let ws:i32=s;
            while(s<nl && gnames[no+s]!=32){ s=s+1; }
            if(s-ws==wl && beq2(buf,bo+pos,gnames,no+ws,wl)==1){ f=1; }
        }
        if(f==1){ n=n+1; hit=e; }
        e=e+1;
    }
    if(n==1){ return hit; }
    return -1;
}
// cmp_scan: position-ordered entity mentions over a resolved turn.
// Full-name match preferred (first gord hit, like gaz_scan); otherwise a
// distinctive single name-word (len>=4, unique to one entity).
fn cmp_scan(gnames:[]u8,ge:[]u8,gord:[]u8,buf:[]u8,bo:i32,bl:i32,out:[]u8,excl:i32)i32 {
    let ng:i32=g32(gord,0) as i32;
    let n:i32=0;
    let pos:i32=0;
    while(pos<bl){
        let hit:i32=-1;
        let hlen:i32=0;
        let oi:i32=0;
        while(oi<ng && hit<0){
            let eid:i32=g32(gord,4+oi*4) as i32;
            if(eid!=excl){
                let no:i32=g32(ge,8+eid*16) as i32;
                let nl:i32=g32(ge,8+eid*16+4) as i32;
                if(pos+nl<=bl && beq2(buf,bo+pos,gnames,no,nl)==1){ hit=eid; hlen=nl; }
            }
            oi=oi+1;
        }
        if(hit<0){
            let start:i32=0;
            if(pos==0){ start=1; }
            if(pos>0 && buf[bo+pos-1]==32){ start=1; }
            if(start==1){
                let wl:i32=0;
                while(pos+wl<bl && buf[bo+pos+wl]!=32){ wl=wl+1; }
                if(wl>=4){
                    let we:i32=word_entity(gnames,ge,buf,bo,pos,wl);
                    if(we>=0){ hit=we; hlen=wl; }
                }
            }
        }
        if(hit>=0){ p32(out,n*4,hit); n=n+1; pos=pos+hlen; }
        if(hit<0){ pos=pos+1; }
    }
    return n;
}
// time_marker_idx: index of the first-hitting TIME marker for eid, else -1.
// Marker order is KB-shape-driven (persons->born, towers->built, ...) and
// fixed; it works for any entity without consulting the question phrasing.
// 0:born 1:built 2:published 3:completed 4:dedicated 5:opened
fn time_marker_idx(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32)i32 {
    if(year_of(fm,fea,ftl,gnames,ge,eid," born ",6)>=0){ return 0; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," built ",7)>=0){ return 1; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," published ",11)>=0){ return 2; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," completed ",11)>=0){ return 3; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," dedicated ",11)>=0){ return 4; }
    if(year_of(fm,fea,ftl,gnames,ge,eid," opened ",8)>=0){ return 5; }
    return -1;
}
fn time_val(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32,mi:i32)i32 {
    if(mi==0){ return year_of(fm,fea,ftl,gnames,ge,eid," born ",6); }
    if(mi==1){ return year_of(fm,fea,ftl,gnames,ge,eid," built ",7); }
    if(mi==2){ return year_of(fm,fea,ftl,gnames,ge,eid," published ",11); }
    if(mi==3){ return year_of(fm,fea,ftl,gnames,ge,eid," completed ",11); }
    if(mi==4){ return year_of(fm,fea,ftl,gnames,ge,eid," dedicated ",11); }
    return year_of(fm,fea,ftl,gnames,ge,eid," opened ",8);
}
// cmp_yesno: the turn asks for yes/no iff it opens with an auxiliary verb.
fn cmp_yesno(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(starts_with(ubuf,uo,ul,"was ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"is ",3)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"are ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"were ",5)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"did ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"do ",3)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"does ",5)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"has ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"have ",5)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"can ",4)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"could ",6)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"would ",6)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"will ",5)==1){ return 1; }
    return 0;
}
// do_compare: general comparison. Returns 1 with the response written, else 0
// (caller falls through to retrieval). Stores the compared pair at pv+40/44
// for "those two"-style anaphora on later turns.
// --- pv-write log (deliberation rebuild): defers pv mutations so GEN stays
// read-only. Layout: [0..4) count, then (off,val) i32 pairs from 4.
fn pvl_log(pvl:[]u8, off:i32, val:i32)void {
    let n:i32=g32(pvl,0) as i32;
    p32(pvl,4+n*8,off);
    p32(pvl,4+n*8+4,val);
    p32(pvl,0,n+1);
    return;
}
fn pvl_get(pvl:[]u8, off:i32)i32 {
    let n:i32=g32(pvl,0) as i32;
    let i:i32=n-1;
    while(i>=0){
        if((g32(pvl,4+i*8) as i32)==off){ return g32(pvl,4+i*8+4) as i32; }
        i=i-1;
    }
    return -1;
}
fn do_compare(ubuf:[]u8,uo:i32,ul:i32,sal:[]u8,pv:[]u8,fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,resp:[]u8,pvl:[]u8)i32 {
    // --- intent: comparison words anywhere (single words, grammatical class) ---
    let tall:i32=0;
    let w_min:i32=0;
    let w_max:i32=0;
    if(find_sub(ubuf,uo,ul,"taller",0,6)>=0){ tall=1; w_max=1; }
    if(find_sub(ubuf,uo,ul,"tallest",0,7)>=0){ tall=1; w_max=1; }
    if(find_sub(ubuf,uo,ul,"shorter",0,7)>=0){ tall=1; w_min=1; }
    if(find_sub(ubuf,uo,ul,"shortest",0,8)>=0){ tall=1; w_min=1; }
    if(find_sub(ubuf,uo,ul,"before",0,6)>=0){ w_min=1; }
    if(find_sub(ubuf,uo,ul,"earlier",0,7)>=0){ w_min=1; }
    if(find_sub(ubuf,uo,ul,"older",0,5)>=0){ w_min=1; }
    if(find_sub(ubuf,uo,ul,"oldest",0,6)>=0){ w_min=1; }
    if(find_sub(ubuf,uo,ul,"first",0,5)>=0){ w_min=1; }
    if(find_sub(ubuf,uo,ul,"after",0,5)>=0){ w_max=1; }
    if(find_sub(ubuf,uo,ul,"later",0,5)>=0){ w_max=1; }
    if(find_sub(ubuf,uo,ul,"younger",0,7)>=0){ w_max=1; }
    if(find_sub(ubuf,uo,ul,"youngest",0,8)>=0){ w_max=1; }
    if(find_sub(ubuf,uo,ul,"last",0,4)>=0){ w_max=1; }
    if(tall==0 && w_min==0 && w_max==0){ return 0; }
    let dmin:i32=1;
    if(w_min==0){ dmin=0; }
    // --- resolve two entities (pronouns bound via the salience stack) ---
    let rbuf:[]u8=nio_alloc(4096);
    let rl:i32=build_resolved(ubuf,uo,ul,sal,ge,gnames,rbuf,bout);
    let e1:i32=-1;
    let e2:i32=-1;
    let ao:i32=find_sub(ubuf,uo,ul,"author of",0,9);
    if(ao>=0){
        let nw:i32=cmp_scan(gnames,ge,gord,ubuf,uo+ao+9,ul-ao-9,eout2,-1);
        let wk:i32=0;
        let work:i32=-1;
        while(wk<nw){
            let ew:i32=g32(eout2,wk*4) as i32;
            if((g32(ge,8+ew*16+8) as i32)==1 && work<0){ work=ew; }
            wk=wk+1;
        }
        if(work>=0){
            let au:i32=author_of(fm,fea,ftl,gnames,ge,work);
            if(au>=0){
                e1=au;
                let nf2:i32=cmp_scan(gnames,ge,gord,rbuf,0,rl,eout,-1);
                let k2:i32=0;
                while(k2<nf2 && e2<0){
                    let ec:i32=g32(eout,k2*4) as i32;
                    if(ec!=work && ec!=au){ e2=ec; }
                    k2=k2+1;
                }
            }
        }
        if(e1<0 || e2<0){ nio_free(rbuf); return 0; }
    }
    if(ao<0){
        let ne:i32=cmp_scan(gnames,ge,gord,rbuf,0,rl,eout,-1);
        let k:i32=0;
        while(k<ne){
            let e:i32=g32(eout,k*4) as i32;
            if(e1<0){ e1=e; }
            if(e1>=0 && e!=e1 && e2<0){ e2=e; }
            k=k+1;
        }
        if(e2<0){
            let ana:i32=0;
            if(find_sub(ubuf,uo,ul,"those two",0,9)>=0){ ana=1; }
            if(find_sub(ubuf,uo,ul,"these two",0,9)>=0){ ana=1; }
            if(find_sub(ubuf,uo,ul,"the two",0,7)>=0){ ana=1; }
            if(find_sub(ubuf,uo,ul,"either",0,6)>=0){ ana=1; }
            if(ana==1){
                let p1:i32=g32(pv,40) as i32;
                let p2:i32=g32(pv,44) as i32;
                if(p1>=0 && p2>=0){ e1=p1; e2=p2; }
            }
        }
        if(e1<0 || e2<0){ nio_free(rbuf); return 0; }
    }
    // --- values: data-driven markers via year_of ---
    let v1:i32=-1;
    let v2:i32=-1;
    let mi1:i32=-1;
    let mi2:i32=-1;
    if(tall==1){
        v1=year_of(fm,fea,ftl,gnames,ge,e1,"tall",4);
        v2=year_of(fm,fea,ftl,gnames,ge,e2,"tall",4);
    }
    if(tall==0){
        mi1=time_marker_idx(fm,fea,ftl,gnames,ge,e1);
        mi2=time_marker_idx(fm,fea,ftl,gnames,ge,e2);
        if(mi1>=0){ v1=time_val(fm,fea,ftl,gnames,ge,e1,mi1); }
        if(mi2>=0){ v2=time_val(fm,fea,ftl,gnames,ge,e2,mi2); }
    }
    nio_free(rbuf);
    if(v1<0 || v2<0){ return 0; }
    pvl_log(pvl,41,v1); pvl_log(pvl,42,v2); pvl_log(pvl,43,dmin);
    // --- answer ---
    if(cmp_yesno(ubuf,uo,ul)==1){
        rclr(resp);
        let yes:i32=0;
        if(dmin==1 && v1<v2){ yes=1; }
        if(dmin==0 && v1>v2){ yes=1; }
        if(yes==1){ rput(resp,"yes.",0,4); }
        if(yes==0){ rput(resp,"no.",0,3); }
        pvl_log(pvl,40,e1); pvl_log(pvl,44,e2);
        return 1;
    }
    let win:i32=e1;
    let wmi:i32=mi1;
    if(dmin==1 && v2<v1){ win=e2; wmi=mi2; }
    if(dmin==0 && v2>v1){ win=e2; wmi=mi2; }
    rclr(resp);
    let wno:i32=g32(ge,8+win*16) as i32;
    let wnl:i32=g32(ge,8+win*16+4) as i32;
    if(needs_the(gnames,wno,wnl)==1){ rput(resp,"the ",0,4); }
    rput(resp,gnames,wno,wnl);
    if(tall==1){
        if(dmin==1){ rput(resp," is shorter.",0,12); }
        if(dmin==0){ rput(resp," is taller.",0,11); }
    }
    if(tall==0){
        if(wmi==0){ rput(resp," was born ",0,10); }
        if(wmi==1){ rput(resp," was built ",0,11); }
        if(wmi==2){ rput(resp," was published ",0,15); }
        if(wmi==3){ rput(resp," was completed ",0,15); }
        if(wmi==4){ rput(resp," was dedicated ",0,15); }
        if(wmi==5){ rput(resp," was opened ",0,12); }
        if(dmin==1){ rput(resp,"first.",0,6); }
        if(dmin==0){ rput(resp,"last.",0,5); }
    }
    pvl_log(pvl,40,e1); pvl_log(pvl,44,e2);
    return 1;
}

// --- F3-ARITHMETIC (2026-09-23): how-much-difference questions ---
// "how much taller is it?" / "how many years between X and Y?" /
// "what is the difference in height between X and Y?"
// The entity pair is explicit in the question or carried from the
// immediately preceding comparison turn (pv slots 32/36/52). Values are
// looked up LIVE from the KB and subtracted; only entity ids (discourse
// referents, like the pronoun binder's) cross turns -- never answers.

// dim: 1=height, 2=years, 0=not a difference question
fn diff_dim(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(find_sub(ubuf,uo,ul,"how much taller",0,15)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"how much older",0,14)>=0){ return 2; }
    if(find_sub(ubuf,uo,ul,"how many years between",0,21)>=0){ return 2; }
    if(find_sub(ubuf,uo,ul,"difference in height",0,19)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"difference in years",0,19)>=0){ return 2; }
    if(find_sub(ubuf,uo,ul,"how much",0,8)>=0){
        if(find_sub(ubuf,uo,ul,"taller",0,6)>=0){ return 1; }
        if(find_sub(ubuf,uo,ul,"older",0,5)>=0){ return 2; }
        if(find_sub(ubuf,uo,ul,"longer",0,6)>=0){ return 1; }
        if(find_sub(ubuf,uo,ul,"bigger",0,6)>=0){ return 1; }
        if(find_sub(ubuf,uo,ul,"smaller",0,7)>=0){ return 1; }
    }
    return 0;
}

// minimum |occurrence - p| of word w in (ubuf,uo,ul); -1 if absent
fn mindist(ubuf:[]u8,uo:i32,ul:i32,w:[]u8,wl:i32,p:i32)i32 {
    let best:i32=-1;
    let off:i32=0;
    let go:i32=1;
    while(go==1){
        let at:i32=find_sub(ubuf,uo+off,ul-off,w,0,wl);
        if(at<0){ go=0; }
        if(at>=0){
            let ap:i32=off+at;
            let d:i32=ap-p;
            if(d<0){ d=0-d; }
            if(best<0 || d<best){ best=d; }
            off=ap+1;
            if(off>=ul){ go=0; }
        }
    }
    return best;
}

// event index nearest position p: 0=born 1=built 2=published 3=dedicated
// 4=opened 5=completed 6=won; -1 if no event word in the question
fn nearest_event(ubuf:[]u8,uo:i32,ul:i32,p:i32)i32 {
    let best:i32=-1;
    let bd:i32=2147483647;
    let d:i32=mindist(ubuf,uo,ul,"born",4,p);
    if(d>=0 && d<bd){ bd=d; best=0; }
    d=mindist(ubuf,uo,ul,"built",5,p);
    if(d>=0 && d<bd){ bd=d; best=1; }
    d=mindist(ubuf,uo,ul,"published",9,p);
    if(d>=0 && d<bd){ bd=d; best=2; }
    d=mindist(ubuf,uo,ul,"dedicated",9,p);
    if(d>=0 && d<bd){ bd=d; best=3; }
    d=mindist(ubuf,uo,ul,"opened",6,p);
    if(d>=0 && d<bd){ bd=d; best=4; }
    d=mindist(ubuf,uo,ul,"opening",7,p);
    if(d>=0 && d<bd){ bd=d; best=4; }
    d=mindist(ubuf,uo,ul,"completed",9,p);
    if(d>=0 && d<bd){ bd=d; best=5; }
    d=mindist(ubuf,uo,ul,"won",3,p);
    if(d>=0 && d<bd){ bd=d; best=6; }
    return best;
}

// year value of the lowest-fid fact naming eid with the given event marker
fn year_val_ev(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,eid:i32,ev:i32)i32 {
    if(ev==0){ return year_of(fm,fea,ftl,gnames,ge,eid," born ",6); }
    if(ev==1){ return year_of(fm,fea,ftl,gnames,ge,eid," built ",7); }
    if(ev==2){ return year_of(fm,fea,ftl,gnames,ge,eid," published ",11); }
    if(ev==3){ return year_of(fm,fea,ftl,gnames,ge,eid," dedicated ",11); }
    if(ev==4){ return year_of(fm,fea,ftl,gnames,ge,eid," opened ",8); }
    if(ev==5){ return year_of(fm,fea,ftl,gnames,ge,eid," completed ",11); }
    if(ev==6){ return year_of(fm,fea,ftl,gnames,ge,eid," won ",5); }
    return -1;
}

// years value for eid: the event word nearest the entity's name in the
// question selects the marker; with no event word, priority
// born->built->published->dedicated->opened->completed->won, first KB hit wins
fn ent_year_val(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,ubuf:[]u8,uo:i32,ul:i32,eid:i32)i32 {
    let no:i32=g32(ge,8+eid*16) as i32;
    let nl:i32=g32(ge,8+eid*16+4) as i32;
    let at:i32=find_sub(ubuf,uo,ul,gnames,no,nl);
    if(at>=0){
        let ev:i32=nearest_event(ubuf,uo,ul,at);
        if(ev>=0){
            let v:i32=year_val_ev(fm,fea,ftl,gnames,ge,eid,ev);
            if(v>=0){ return v; }
        }
    }
    let e2:i32=0;
    while(e2<7){
        let v2:i32=year_val_ev(fm,fea,ftl,gnames,ge,eid,e2);
        if(v2>=0){ return v2; }
        e2=e2+1;
    }
    return -1;
}

// --- composition templates; returns 1 if handled (response written) ---

// ================= F2-WITHHOLD repair (2026-09-23, guided release) =================
// Honest "I don't know." path for the step-5 default retrieval. Five sub-checks;
// ANY firing check -> decline, NEVER a fact. General machinery only: no per-probe
// branches, no probe-specific constants. R below is the KB's own stemmed relation
// vocabulary (scales with the KB), not a probe list.
// G1 entity-aboutness: query entities (gazetteer + pronoun-bound) must intersect
//    the best fact's entity list, else the fact is not ABOUT anything asked about.
// G2 relation-demand: a relation word demanded by the query must be a key of the
//    best fact, else the fact cannot satisfy the question.
// G3 demand-focus: a structural demand-focus ("capital of X", "who wrote X",
//    "when was X <rel>", "how tall is X") must share a content key with the fact.
// G4 orphan-aboutness: a specific question naming no entity must have every
//    non-wh content key covered by the fact.
// G5 score floor: a specific question naming no entity needs Jaccard >= 1/4.
// Open-ended requests ("tell me about the tower.") carry no demand-focus and are
// not specific questions, so G3/G4/G5 skip them: low-score open retrieval keeps
// its round-1 behavior (this is what keeps the repair from becoming
// "decline everything").

// vocab id of existing entry, or -1 (never interns)
fn vocab_find(vbytes:[]u8,vent:[]u8,sb:[]u8,so:i32,sl:i32)i32 {
    let n:i32=g32(vent,0) as i32;
    let i:i32=0;
    while(i<n){
        let eo:i32=g32(vent,8+8*i) as i32;
        let el:i32=g32(vent,8+8*i+4) as i32;
        if(el==sl){
            if(beq2(sb,so,vbytes,eo,sl)==1){return i;}
        }
        i=i+1;
    }
    return -1;
}
// byte-compare a vocab id against a literal
fn vid_eq(vbytes:[]u8,vent:[]u8,id:i32,lit:[]u8)i32 {
    let eo:i32=g32(vent,8+8*id) as i32;
    let el:i32=g32(vent,8+8*id+4) as i32;
    if(el!=lit.len){return 0;}
    return beq2(vbytes,eo,lit,0,el);
}
// KB relation vocabulary (stemmed forms as interned by proc_token)
fn is_relkey(vbytes:[]u8,vent:[]u8,id:i32)i32 {
    if(vid_eq(vbytes,vent,id,"wrote")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"written")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"bear")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"build")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"publish")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"discover")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"win")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"capital")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"tall")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"long")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"open")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"dedicate")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"complete")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"landmark")==1){return 1;}
    // TNN-domain verbs (2026-09-27): the predicate gate must demand
    // predicate compatibility for these too. "upscal"/"reproduc" are the
    // silent-e stems unified in irregular_norm; "detect"/"learn" are TNN's
    // own predicates; "paint" is asked about but never taught (round-3
    // turns 11/14: entity match alone is not enough to answer).
    if(vid_eq(vbytes,vent,id,"upscal")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"reproduc")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"detect")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"learn")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"paint")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"invent")==1){return 1;}
    // "live" (population: "how many people live there?") is a predicate the
    // KB never teaches. It must fail the relation-demand gate (G2) so the
    // default cannot answer a population question with a location fact.
    // pred_mismatch routes it to withhold (not clarify) because the entity
    // is pronoun-bound, not named.
    if(vid_eq(vbytes,vent,id,"live")==1){return 1;}
    return 0;
}
fn is_whkey(vbytes:[]u8,vent:[]u8,id:i32)i32 {
    if(vid_eq(vbytes,vent,id,"who")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"what")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"when")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"where")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"which")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"how")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"whom")==1){return 1;}
    if(vid_eq(vbytes,vent,id,"whose")==1){return 1;}
    return 0;
}
fn key_in_fact(keya:[]u8,fko:i32,fkl:i32,qid:i32)i32 {
    let b:i32=0;
    while(b<fkl){
        if((g32(keya,fko+b*4) as i32)==qid){return 1;}
        b=b+1;
    }
    return 0;
}
// specific question: has "?" or starts with a wh-word / demand verb (input lowercased)
fn is_specific(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(find_sub(ubuf,uo,ul,"?",0,1)>=0){return 1;}
    if(starts_with(ubuf,uo,ul,"who",3)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"what",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"when",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"where",5)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"which",5)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"how",3)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"did ",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"does ",5)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"do ",3)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"is ",3)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"are ",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"was ",4)==1){return 1;}
    if(starts_with(ubuf,uo,ul,"were ",5)==1){return 1;}
    return 0;
}
// tokenize qbuf[so..so+sl) into content vocab ids (stopwords/digits dropped,
// stemmed+irregular-normed exactly like proc_token, never interning).
// cut_rel=1: stop before the first relation-word token. Returns count.
fn focus_keys(qbuf:[]u8,so:i32,sl:i32,vbytes:[]u8,vent:[]u8,tmp:[]u8,out:[]u8,cap:i32,cut_rel:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    let stop:i32=0;
    while(i<sl && stop==0){
        let ch:u8=qbuf[so+i];
        if(is_alnum(ch)==1){
            let j:i32=i;
            while(j<sl && is_alnum(qbuf[so+j])==1){j=j+1;}
            let tl:i32=j-i;
            let k:i32=0;
            while(k<tl){tmp[k]=to_low(qbuf[so+i+k]);k=k+1;}
            let skip:i32=0;
            if(digit_val(tmp,0,tl)>=0){skip=1;}
            if(skip==0 && numword_val(tmp,0,tl)>=0){skip=1;}
            if(skip==0 && is_stop(tmp,0,tl)==1){skip=1;}
            if(skip==0){
                let st2:i32=stem_inplace(tmp,tl);
                st2=irregular_norm(tmp,st2);
                let id:i32=vocab_find(vbytes,vent,tmp,0,st2);
                if(id>=0){
                    if(cut_rel==1 && is_relkey(vbytes,vent,id)==1){stop=1;}
                    if(stop==0 && n<cap){p32(out,n*4,id);n=n+1;}
                }
            }
            i=j;
        }
        if(is_alnum(ch)==0){i=i+1;}
    }
    return n;
}
// index of the 'o' in the LAST standalone " of " in qbuf, or -1
fn find_last_of(qbuf:[]u8,ql:i32)i32 {
    let i:i32=ql-4;
    while(i>=0){
        if(qbuf[i]==32 && qbuf[i+1]==111 && qbuf[i+2]==102 && qbuf[i+3]==32){return i;}
        i=i-1;
    }
    return -1;
}
// The withhold gate. Returns 1 = decline ("I don't know."), 0 = emit best fact.
fn withhold_check_gate(ubuf:[]u8,uo:i32,ul:i32,qbuf:[]u8,ql:i32,
    kid:[]u8,plen:i32,keya:[]u8,fko:i32,fkl:i32,fea:[]u8,feo:i32,fen:i32,
    eout:[]u8,ne4:i32,bout:[]u8,bn:i32,
    vbytes:[]u8,vent:[]u8,tmp:[]u8,fout:[]u8)i32 {
    let has_qe:i32=0;
    if(ne4>0 || bn>0){has_qe=1;}
    // ---- G1: entity-aboutness ----
    if(has_qe==1){
        let anyhit:i32=0;
        let qi:i32=0;
        while(qi<ne4){
            let qe:i32=g32(eout,qi*4) as i32;
            let k:i32=0;
            while(k<fen){
                if((g32(fea,feo+k*4) as i32)==qe){anyhit=1;}
                k=k+1;
            }
            qi=qi+1;
        }
        let bi2:i32=0;
        while(bi2<bn){
            let qe2:i32=g32(bout,4+bi2*4) as i32;
            let k2:i32=0;
            while(k2<fen){
                if((g32(fea,feo+k2*4) as i32)==qe2){anyhit=1;}
                k2=k2+1;
            }
            bi2=bi2+1;
        }
        if(anyhit==0){return 1;}
    }
    // ---- G2: relation-demand ----
    let q2:i32=0;
    while(q2<plen){
        let qid:i32=g32(kid,q2*4) as i32;
        if(is_relkey(vbytes,vent,qid)==1 && key_in_fact(keya,fko,fkl,qid)==0){return 2;}
        q2=q2+1;
    }
    // ---- G3: demand-focus ----
    let nf:i32=0;
    let ofp:i32=find_last_of(qbuf,ql);
    if(ofp>=0){
        let rs:i32=ofp+3;
        while(rs<ql && qbuf[rs]==32){rs=rs+1;}
        let re:i32=ql;
        while(re>rs && qbuf[re-1]==32){re=re-1;}
        if(re>rs){nf=focus_keys(qbuf,rs,re-rs,vbytes,vent,tmp,fout,64,0);}
    }
    if(ofp<0 && nf==0){
        if(starts_with(qbuf,0,ql,"who wrote ",10)==1){nf=focus_keys(qbuf,10,ql-10,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"who discovered ",15)==1){nf=focus_keys(qbuf,15,ql-15,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"who is ",7)==1){nf=focus_keys(qbuf,7,ql-7,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"who was ",8)==1){nf=focus_keys(qbuf,8,ql-8,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"when was ",9)==1){nf=focus_keys(qbuf,9,ql-9,vbytes,vent,tmp,fout,64,1);}
        if(starts_with(qbuf,0,ql,"when did ",9)==1){nf=focus_keys(qbuf,9,ql-9,vbytes,vent,tmp,fout,64,1);}
        if(starts_with(qbuf,0,ql,"was ",4)==1){nf=focus_keys(qbuf,4,ql-4,vbytes,vent,tmp,fout,64,1);}
        if(starts_with(qbuf,0,ql,"how tall is ",12)==1){nf=focus_keys(qbuf,12,ql-12,vbytes,vent,tmp,fout,64,0);}
        if(starts_with(qbuf,0,ql,"how long is ",12)==1){nf=focus_keys(qbuf,12,ql-12,vbytes,vent,tmp,fout,64,0);}
    }
    if(nf>0){
        let covered:i32=0;
        let f3:i32=0;
        while(f3<nf){
            if(key_in_fact(keya,fko,fkl,g32(fout,f3*4) as i32)==1){covered=1;}
            f3=f3+1;
        }
        if(covered==0){return 3;}
    }
    // ---- G4: orphan-aboutness + G5: score floor ----
    // Only when no demand-focus was identified: if the focus WAS identified and
    // covered (G3 passed), a stray unmatched token is a typo/variant of the
    // asked-about entity (round-1 WEIRD typo probes), not an unknown entity.
    if(has_qe==0 && nf==0 && is_specific(ubuf,uo,ul)==1){
        let q4:i32=0;
        while(q4<plen){
            let qid4:i32=g32(kid,q4*4) as i32;
            if(key_in_fact(keya,fko,fkl,qid4)==0 && is_whkey(vbytes,vent,qid4)==0){return 4;}
            q4=q4+1;
        }
        let sc:i64=jscore(kid,plen,keya,fko,fkl);
        let inter:i64=(sc>>32)&4294967295;
        let union:i64=sc&4294967295;
        if(inter*4<union){return 4;}
    }
    return 0;
}
// withhold_check: legacy 0/1 wrapper over withhold_check_gate (gate id 1..4).
fn withhold_check(ubuf:[]u8,uo:i32,ul:i32,qbuf:[]u8,ql:i32,kid:[]u8,plen:i32,keya:[]u8,fko:i32,fkl:i32,fea:[]u8,feo:i32,fen:i32,eout:[]u8,ne:i32,bout:[]u8,bn:i32,vbytes:[]u8,vent:[]u8,tmp:[]u8,fout:[]u8)i32 {
    let g:i32=withhold_check_gate(ubuf,uo,ul,qbuf,ql,kid,plen,keya,fko,fkl,fea,feo,fen,eout,ne,bout,bn,vbytes,vent,tmp,fout);
    if(g!=0){return 1;}
    return 0;
}
// ================= end F2-WITHHOLD repair =================

fn do_compose(ubuf:[]u8,uo:i32,ul:i32,sal:[]u8,pv:[]u8,fm:[]u8,fea:[]u8,ftl:[]u8,ftx:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,resp:[]u8,nbuf:[]u8,turn_no:i32,pvl:[]u8,cv:[]u8)i32 {
    // --- F3-ARITHMETIC: how-much-difference questions ---
    // Real subtraction on live KB values. The pair is explicit ("X than Y")
    // or carried from the immediately preceding comparison ("it"). The
    // answer is computed here, never memorized: values come from year_of /
    // ent_year_val at query time. Returns 0 (fall through) when the pair or
    // a value cannot be resolved.
    p32(cv,0,0);
    let ddim:i32=diff_dim(ubuf,uo,ul);
    if(ddim>0){
        let ne_d:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        let d1:i32=-1;
        let d2:i32=-1;
        let kd:i32=0;
        while(kd<ne_d){
            let de:i32=g32(eout,kd*4) as i32;
            if(de!=d1 && d1<0){ d1=de; }
            if(de!=d1 && d2<0){ d2=de; }
            kd=kd+1;
        }
        if(d2<0){
            let ce1:i32=g32(pv,48) as i32;
            let ce2:i32=g32(pv,52) as i32;
            let cturn:i32=g32(pv,60) as i32;
            if(ce1<0 || ce2<0 || cturn<0 || cturn+1!=turn_no){ return 0; }
            if(d1<0){ d1=ce1; d2=ce2; }
            if(d1>=0 && d2<0){
                if(d1==ce1){ d2=ce2; }
                if(d1==ce2){ d2=ce1; }
            }
            if(d2<0){ return 0; }
        }
        let v1:i32=-1;
        let v2:i32=-1;
        if(ddim==1){
            v1=year_of(fm,fea,ftl,gnames,ge,d1,"tall",4);
            v2=year_of(fm,fea,ftl,gnames,ge,d2,"tall",4);
        }
        if(ddim==2){
            v1=ent_year_val(fm,fea,ftl,gnames,ge,ubuf,uo,ul,d1);
            v2=ent_year_val(fm,fea,ftl,gnames,ge,ubuf,uo,ul,d2);
        }
        if(v1<0 || v2<0){ return 0; }
        let df:i64=(v1 as i64)-(v2 as i64);
        if(df<0){ df=0-df; }
        rclr(resp);
        let dnl:i32=i64str(df,nbuf);
        rput(resp,nbuf,0,dnl);
        // scaffold-and-release names the unit (2026-09-27): the dimension
        // was already resolved from the compared facts (ddim: 1=height,
        // 2=years); the old code dropped it and answered bare "3"
        // (round-3 turn 7). The unit is derived from the facts' dimension,
        // never a per-question hardcoded string.
        if(ddim==1){ rput(resp," meters",0,7); }
        if(ddim==2){ rput(resp," years",0,6); }
        p32(cv,0,1); p32(cv,4,d1); p32(cv,8,d2); p32(cv,12,v1); p32(cv,16,v2);
        p32(cv,20,df as i32); p32(cv,24,ddim);
        return 1;
    }
    // F1-COMPARE: general comparison engine (replaces the two frozen
    // string-prefix branches above; did-write and birth-year below unchanged).
    if(do_compare(ubuf,uo,ul,sal,pv,fm,fea,ftl,gnames,ge,gord,eout,eout2,bout,resp,pvl)==1){
        // F3-ARITHMETIC carry (merged): the just-compared pair is carried
        // for an immediate follow-up difference question. In F3's fork this
        // write lived inside the old "which is taller" branch; F1's engine
        // replaces that branch, so the carry is written here after ANY
        // successful comparison. Slots per PREREG_INT: pair@48/52, dim@56
        // (write-only, as in F3), turn@60; the F1 pair lives at 40/44.
        pvl_log(pvl,48,pvl_get(pvl,40)); pvl_log(pvl,52,pvl_get(pvl,44));
        pvl_log(pvl,56,1); pvl_log(pvl,60,turn_no);
        p32(cv,0,2); p32(cv,4,pvl_get(pvl,40)); p32(cv,8,pvl_get(pvl,44));
        p32(cv,12,pvl_get(pvl,41)); p32(cv,16,pvl_get(pvl,42)); p32(cv,20,pvl_get(pvl,43));
        return 1;
    }
    if(starts_with(ubuf,uo,ul,"did ",4)==1 && find_sub(ubuf,uo,ul,"write",0,5)>=0){
        let ne4:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        let person:i32=-1;
        let work2:i32=-1;
        let ao:i32=find_sub(ubuf,uo,ul,"the author of",0,13);
        if(ao>=0){
            let ne5:i32=gaz_scan(gnames,ge,gord,ubuf,uo+ao+13,ul-ao-13,eout2,-1);
            if(ne5<1){ return 0; }
            let wao:i32=g32(eout2,0) as i32;
            person=author_of(fm,fea,ftl,gnames,ge,wao);
            let k2:i32=0;
            while(k2<ne4){
                let e3:i32=g32(eout,k2*4) as i32;
                if((g32(ge,8+e3*16+8) as i32)==1 && e3!=wao && work2<0){ work2=e3; }
                k2=k2+1;
            }
        }
        if(ao<0){
            let k3:i32=0;
            while(k3<ne4){
                let e4:i32=g32(eout,k3*4) as i32;
                if((g32(ge,8+e4*16+8) as i32)==0 && person<0){ person=e4; }
                if((g32(ge,8+e4*16+8) as i32)==1 && work2<0){ work2=e4; }
                k3=k3+1;
            }
        }
        if(person<0 || work2<0){ return 0; }
        let r:i32=wrote_rel(fm,fea,ftl,gnames,ge,person,work2);
        rclr(resp);
        if(r==1){ rput(resp,"yes.",0,4); }
        if(r==0){ rput(resp,"no.",0,3); }
        p32(cv,0,3); p32(cv,4,person); p32(cv,8,work2); p32(cv,20,r);
        return 1;
    }
    // --- morphology crew (2026-09-21): "birth year of <person-desc>" ---
    // WE-09 root cause, second half: the keyword core cannot resolve a
    // question-focus ("birth year") against a relative-clause referent
    // ("the guy who wrote the martian") -- the clause's keywords outscore
    // the focus word under Jaccard even after birth<->born bridging
    // (proven: 1/12 < 2/12 in the Python mirror). So resolve the person
    // (named, else author_of(work) via " wrote <work>") and emit their
    // born-fact directly. Placed LAST: never steals the "was the author
    // of" branch (no "birth year" there), the born-assertions (no "birth
    // year" there), or any other turn -- "birth year" occurs exactly once
    // in the frozen battery. Falls through (return 0) when unresolvable.
    if(find_sub(ubuf,uo,ul,"birth year",0,10)>=0){
        let ne_b:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        let person_b:i32=-1;
        let kb2:i32=0;
        while(kb2<ne_b){
            let eb:i32=g32(eout,kb2*4) as i32;
            if((g32(ge,8+eb*16+8) as i32)==0){ person_b=eb; }
            kb2=kb2+1;
        }
        if(person_b<0){
            let wi_b:i32=find_sub(ubuf,uo,ul," wrote ",0,7);
            if(wi_b>=0){
                let ne_w:i32=gaz_scan(gnames,ge,gord,ubuf,uo+wi_b+7,ul-wi_b-7,eout2,-1);
                let kw3:i32=0;
                let work_b:i32=-1;
                while(kw3<ne_w){
                    let ew:i32=g32(eout2,kw3*4) as i32;
                    if((g32(ge,8+ew*16+8) as i32)==1 && work_b<0){ work_b=ew; }
                    kw3=kw3+1;
                }
                if(work_b>=0){ person_b=author_of(fm,fea,ftl,gnames,ge,work_b); }
            }
        }
        if(person_b>=0){
            let bf:i32=born_fact_of(fm,fea,ftl,gnames,ge,person_b);
            if(bf>=0){
                rclr(resp);
                emit_fact(resp,fm,ftx,bf);
                p32(cv,0,4); p32(cv,4,person_b); p32(cv,8,bf);
                return 1;
            }
        }
        return 0;
    }
    return 0;
}

fn is_correction(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(starts_with(ubuf,uo,ul,"no,",3)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"no ",3)==1){ return 1; }
    if(starts_with(ubuf,uo,ul,"not that",8)==1){ return 1; }
    if(find_sub(ubuf,uo,ul,"i meant",0,7)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"the other",0,9)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"another one",0,11)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"other one",0,9)>=0){ return 1; }
    return 0;
}
fn is_resume(ubuf:[]u8,uo:i32,ul:i32)i32 {
    if(find_sub(ubuf,uo,ul,"back to",0,7)>=0){ return 1; }
    if(find_sub(ubuf,uo,ul,"anyway",0,6)>=0){ return 1; }
    return 0;
}

// --- push entities (reverse position order => subject most recent) ---
fn push_ents(sal:[]u8,eids:[]u8,ne:i32)void {
    let k:i32=ne-1;
    while(k>=0){
        sal_push(sal,g32(eids,k*4) as i32);
        k=k-1;
    }
    return;
}
fn push_fact_ents(sal:[]u8,fm:[]u8,fea:[]u8,fid:i32)void {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            let eo:i32=g32(fm,ro+24) as i32;
            let en:i32=g32(fm,ro+28) as i32;
            let k:i32=en-1;
            while(k>=0){
                sal_push(sal,g32(fea,eo+k*4) as i32);
                k=k-1;
            }
        }
        fx=fx+1;
    }
    return;
}
// lowest fid whose (lowercased) fact text contains w: taught-method lookup.
// The troubleshooting methods (KB facts 45/46/47) are taught through the
// normal intake path; the code consults them before acting, and the trace
// records which method fact was consulted.
fn method_fact(fm:[]u8,ftl:[]u8,w:[]u8,wl:i32)i32 {
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        if(find_sub(ftl,to,tl,w,0,wl)>=0){ return g32(fm,ro) as i32; }
        fx=fx+1;
    }
    return -1;
}
// trace-note stubs: no-ops in the control binary; add_hooks.py gives them
// bodies in the trace binary so method consultation is visible.
fn tr_method_note(mfid:i32)void {
    return;
}
fn tr_withhold_note(wh:i32)void {
    return;
}
fn tr_predmm_note(pm:i32)void {
    return;
}
fn tr_correct_shape_note(shaped:i32)void {
    return;
}
fn tr_joke_note(se:i32,te:i32,sv:i64,tv:i64)void {
    return;
}
// joke composer (2026-09-27, round-3 turn 20): the old router answered the
// fixed "I don't know any jokes." TNN knows what a joke IS (taught KB
// facts 43/44: a joke sets up an expectation and breaks it with a
// surprise; a riddle joke asks why about one true thing and answers
// because with another true thing) -- so it composes one from its own
// facts instead of retrieving a canned template. Method: find the
// shortest and tallest things it knows, compute the real difference,
// build the riddle on the double meaning of "look up to" (admire vs
// literally look upward). Deterministic: lowest eid wins ties.
fn compose_joke(resp:[]u8,fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,nbuf:[]u8)void {
    let mfid_j:i32=method_fact(fm,ftl,"joke",4);
    tr_method_note(mfid_j);
    let ne:i32=g32(ge,0) as i32;
    let se:i32=-1;
    let te:i32=-1;
    let sv:i64=0;
    let tv:i64=0;
    let e:i32=0;
    while(e<ne){
        let hv:i64=(year_of(fm,fea,ftl,gnames,ge,e,"tall",4) as i64);
        if(hv>=0){
            if(se<0 || hv<sv){ se=e; sv=hv; }
            if(te<0 || hv>tv){ te=e; tv=hv; }
        }
        e=e+1;
    }
    tr_joke_note(se,te,sv,tv);
    if(se<0 || te<0 || se==te){
        let jmsg:[]u8="I don't know any jokes.";
        rput(resp,jmsg,0,jmsg.len);
        return;
    }
    let df:i64=tv-sv;
    rclr(resp);
    rput(resp,"Why does the ",0,13);
    rput(resp,gnames,g32(ge,8+se*16) as i32,g32(ge,8+se*16+4) as i32);
    rput(resp," look up to the ",0,16);
    rput(resp,gnames,g32(ge,8+te*16) as i32,g32(ge,8+te*16+4) as i32);
    rput(resp,"? Because it's ",0,15);
    let dnl:i32=i64str(df,nbuf);
    rput(resp,nbuf,0,dnl);
    rput(resp," meters shorter.",0,16);
    return;
}
// render the ledger's old claim as a natural clause ("the louvre is in
// paris"). The ledger stores subject + relation + old value; for rel
// 1/5/6 the old value is an entity id, for 2/3/4 a number.
fn render_claim(resp:[]u8,subj:i32,rel:i32,oldv:i32,gnames:[]u8,ge:[]u8,nbuf:[]u8)void {
    if(rel==1){
        rput(resp,gnames,g32(ge,8+oldv*16) as i32,g32(ge,8+oldv*16+4) as i32);
        rput(resp," wrote ",0,7);
        rput(resp,gnames,g32(ge,8+subj*16) as i32,g32(ge,8+subj*16+4) as i32);
    }
    if(rel==2){
        rput(resp,gnames,g32(ge,8+subj*16) as i32,g32(ge,8+subj*16+4) as i32);
        rput(resp," was born in ",0,13);
        let nl2:i32=i64str((oldv as i64),nbuf);
        rput(resp,nbuf,0,nl2);
    }
    if(rel==3){
        rput(resp,gnames,g32(ge,8+subj*16) as i32,g32(ge,8+subj*16+4) as i32);
        rput(resp," was built in ",0,14);
        let nl3:i32=i64str((oldv as i64),nbuf);
        rput(resp,nbuf,0,nl3);
    }
    if(rel==4){
        rput(resp,gnames,g32(ge,8+subj*16) as i32,g32(ge,8+subj*16+4) as i32);
        rput(resp," is ",0,4);
        let nl4:i32=i64str((oldv as i64),nbuf);
        rput(resp,nbuf,0,nl4);
        rput(resp," meters tall",0,12);
    }
    if(rel==5){
        rput(resp,gnames,g32(ge,8+oldv*16) as i32,g32(ge,8+oldv*16+4) as i32);
        rput(resp," is the capital of ",0,19);
        rput(resp,gnames,g32(ge,8+subj*16) as i32,g32(ge,8+subj*16+4) as i32);
    }
    if(rel==6){
        rput(resp,gnames,g32(ge,8+subj*16) as i32,g32(ge,8+subj*16+4) as i32);
        rput(resp," is in ",0,7);
        rput(resp,gnames,g32(ge,8+oldv*16) as i32,g32(ge,8+oldv*16+4) as i32);
    }
}
// 1 if the withhold is a predicate mismatch: the question names a known
// entity but asks about a relation key no taught fact about it carries.
// (Entity-unknown withholds return 0 and keep the plain "I don't know.")
fn pred_mismatch(vbytes:[]u8,vent:[]u8,kid:[]u8,plen:i32,keya:[]u8,fko:i32,fkl:i32,ne4:i32,bn:i32)i32 {
    // Clarify only for NAMED entities. A pronoun-bound entity (bn>0, ne4==0,
    // e.g. "there") with an unrecognized predicate withholds instead —
    // listing "what we know about X" is dishonest when the anchor is only a
    // pronoun and the predicate was never taught.
    if(ne4==0){ return 0; }
    let qk:i32=0;
    while(qk<plen){
        let qid:i32=g32(kid,qk*4) as i32;
        if(is_relkey(vbytes,vent,qid)==1 && key_in_fact(keya,fko,fkl,qid)==0){ return 1; }
        qk=qk+1;
    }
    return 0;
}
// clarification for a predicate mismatch: state what IS taught about the
// entity (up to 3 facts), then ask. This is the natural ask-for-context:
// the question was clear, the predicate just wasn't taught.
fn clarify_predicate(resp:[]u8,fm:[]u8,ftx:[]u8,fea:[]u8,gnames:[]u8,ge:[]u8,eout:[]u8,ne4:i32,bout:[]u8,bn:i32)void {
    let eid:i32=-1;
    if(ne4>0){ eid=g32(eout,0) as i32; }
    if(eid<0 && bn>0){ eid=g32(bout,4) as i32; }
    rclr(resp);
    rput(resp,"I don't know that one. What I know about ",0,41);
    if(eid>=0){
        rput(resp,gnames,g32(ge,8+eid*16) as i32,g32(ge,8+eid*16+4) as i32);
    }
    rput(resp,": ",0,2);
    let nf:i32=g32(fm,0) as i32;
    let shown:i32=0;
    let fx:i32=0;
    while(fx<nf && shown<3){
        let ro:i32=8+fx*40;
        let eo:i32=g32(fm,ro+24) as i32;
        let en:i32=g32(fm,ro+28) as i32;
        let k:i32=0;
        let hit:i32=0;
        while(k<en){
            if((g32(fea,eo+k*4) as i32)==eid){ hit=1; }
            k=k+1;
        }
        if(hit==1){
            if(shown>0){ rput(resp," ",0,1); }
            let to:i32=g32(fm,ro+16) as i32;
            let tl:i32=g32(fm,ro+20) as i32;
            rput(resp,ftx,to,tl);
            shown=shown+1;
        }
        fx=fx+1;
    }
    rput(resp," Did you mean one of those?",0,27);
    return;
}
fn emit_fact(resp:[]u8,fm:[]u8,ftx:[]u8,fid:i32)void {    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        if((g32(fm,ro) as i32)==fid){
            rclr(resp);
            rput(resp,ftx,g32(fm,ro+16) as i32,g32(fm,ro+20) as i32);
            return;
        }
        fx=fx+1;
    }
    rclr(resp);
    rput(resp,"UNCERTAIN.",0,10);
    return;
}

// --- novelty: response must not be a substring of any fact text or prior turn ---
// histb: bytes; hist rows 12B: kind@0 off@4 len@8
fn novelty_ok(resp:[]u8,fm:[]u8,ftl:[]u8,hist:[]u8,histb:[]u8)i32 {
    let rl:i32=g32(resp,0) as i32;
    if(rl<=0){ return 0; }
    let nf:i32=g32(fm,0) as i32;
    let fx:i32=0;
    while(fx<nf){
        let ro:i32=8+fx*40;
        let to:i32=g32(fm,ro+16) as i32;
        let tl:i32=g32(fm,ro+20) as i32;
        // compare against lowercased fact text; response is already lowercase for compose
        if(find_sub(ftl,to,tl,resp,4,rl)>=0){ return 0; }
        fx=fx+1;
    }
    let nh:i32=g32(hist,0) as i32;
    let hx:i32=0;
    while(hx<nh){
        let ho:i32=g32(hist,4+hx*12+4) as i32;
        let hl:i32=g32(hist,4+hx*12+8) as i32;
        if(find_sub(histb,ho,hl,resp,4,rl)>=0){ return 0; }
        hx=hx+1;
    }
    return 1;
}
fn hist_add(hist:[]u8,histb:[]u8,kind:i32,s:[]u8,so:i32,sl:i32)void {
    let n:i32=g32(hist,0) as i32;
    let bo:i32=g32(histb,0) as i32;
    copy_bytes(histb,bo,s,so,sl);
    // lowercase the history copy for novelty checks
    let k:i32=0;
    while(k<sl){ histb[bo+k]=to_low(histb[bo+k]); k=k+1; }
    p32(histb,0,bo+sl);
    let ro:i32=4+n*12;
    p32(hist,ro,kind); p32(hist,ro+4,bo); p32(hist,ro+8,sl);
    p32(hist,0,n+1);
    return;
}

// --- pv layout: ans@0 eid@4 peid@8 qraw_off@12 qraw_len@16 q_off@20 q_len@24 kind@28
//           prevbn@32 (F4-DEFEND: bound-pronoun count of previous turn's
//           resolved query; gates step-5 ellipsis) |
//           F1 compared pair@40/44 (persists) | F3 carry pair@48/52
//           (one-turn) dim@56 (write-only) turn@60 ---
// ================= DELIBERATION v1 (2026-09-27) =================
// GEN -> ELIM -> ARGMAX -> ACT pipeline. Replaces the fixed early-return
// cascade. Every turn:
//   GEN:     10 readings (hid 0..9) + up to 3 fact candidates (hid 10..12)
//            + 12 action bids (hid 13..24). All GEN calls are read-only
//            w.r.t. shared turn state (sal/top/uc/pv/pqb/novelf); each bid
//            stages its answer in its own hans area and records its
//            side effects in its own hsfx log.
//   ELIM:    readings with evidence=0 -> PRE_FAIL; fact candidates failing
//            the withhold gate -> GATE(gate id); action bids with fire=0 ->
//            PRE_FAIL; non-winners -> OUTSCORED.
//   ARGMAX:  status-0 survivors only; max score; ties -> lowest hid.
//            margin<5 (with >=2 survivors) sets the close_call flag and
//            emits CLOSE + 2xCONTENDER + flag-gated REVIEW.
//   ACT:     single winner-gated path: verifies phash, copies the winner's
//            staged answer to resp, applies the winner's sidefx log.
// d_rev (argv[1]=="rev"): reverses the order of the 12 action GEN calls,
//            nothing else. K1: answers must be byte-identical either way.

// ---- ledger layout ----
// [0..4): row count (i32). Rows start at offset 4 (row 0 never overlaps
// the count bytes). Row stride 552:
//   hid@0 kind@4 status@8 bid@12 base@16 bonus@20 score@24 reason@28
//   detail@32 ev_kind@36 ev_score@40 fid@44 gate@48 content@68..552 (484 bytes)
// kind: 0=reading 1=fact 2=action. status: 0=alive 1=eliminated 2=winner.
// reason: 0=none 1=PRE_FAIL 2=GATE 3=OUTSCORED.
// fact rows (kind 1): ev_kind=fact-evidence kind, ev_score=evidence score,
//   fid=retrieved fact id (-1=none), gate=withhold-gate verdict.
// Turn fields after the 25 rows: fact-winner hid@13804, fact close-call
// flag@13808, action close-call flag@13812, spare@13816.
fn led_init(led:[]u8, n:i32)void {
    p32(led,0,n);
    let h:i32=0;
    while(h<n){
        let o:i32=4+h*552;
        lr_put(led,h,0,h);
        lr_put(led,h,4,-1);
        lr_put(led,h,8,0);
        lr_put(led,h,12,0);
        lr_put(led,h,16,0);
        lr_put(led,h,20,0);
        lr_put(led,h,24,0);
        lr_put(led,h,28,0);
        lr_put(led,h,32,0);
        lr_put(led,h,36,-1);
        lr_put(led,h,40,0);
        lr_put(led,h,44,-1);
        lr_put(led,h,48,0);
        lr_put(led,h,48,0);
        p32(led,o+68,0);
        h=h+1;
    }
    // turn fields: fact-winner hid, fact close-call flag, action close-call
    // flag, spare. Layout: 13804 fact-winner, 13808 fact-close, 13812
    // act-close, 13816 spare (led_sz=13820).
    p32(led,13804,-1);
    p32(led,13808,0);
    p32(led,13812,0);
    p32(led,13816,0);
    return;
}
// turn-field accessors (offsets 13804..13820, valid after led_init)
fn t_get(led:[]u8, off:i32)i32 { return g32(led,off) as i32; }
fn t_put(led:[]u8, off:i32, v:i32)void { p32(led,off,v); return; }
fn lr_get(led:[]u8, hid:i32, f:i32)i32 {
    return g32(led,4+hid*552+f) as i32;
}
fn lr_put(led:[]u8, hid:i32, f:i32, v:i32)void {
    p32(led,4+hid*552+f,v);
    return;
}
fn lr_content(led:[]u8, hid:i32)[]u8 {
    return led[4+hid*552+68..4+hid*552+552];
}
// ---- content text builder ----
// content region: [0..4) text length, text bytes from 4. k=v; pairs;
// ';'->',' and '='->':' sanitized so the K3 parser can split on them.
fn c_init(co:[]u8)void {
    p32(co,0,0);
    return;
}
fn c_raw(co:[]u8, s:[]u8, so:i32, sl:i32)void {
    let n:i32=g32(co,0) as i32;
    let i:i32=0;
    while(i<sl){
        let c:i32=s[so+i] as i32;
        if(c==59){ c=44; }
        if(c==61){ c=58; }
        co[4+n]=(c as u8);
        n=n+1;
        i=i+1;
    }
    p32(co,0,n);
    return;
}
fn c_put(co:[]u8, s:[]u8)void {
    c_raw(co,s,0,s.len);
    return;
}
fn c_lit(co:[]u8, s:[]u8)void {
    c_put(co,s);
    return;
}
fn c_raw_ns(co:[]u8, s:[]u8, so:i32, sl:i32)void {
    let n:i32=g32(co,0) as i32;
    let i:i32=0;
    while(i<sl){
        co[4+n]=s[so+i];
        n=n+1;
        i=i+1;
    }
    p32(co,0,n);
    return;
}
fn c_lit_ns(co:[]u8, s:[]u8)void {
    c_raw_ns(co,s,0,s.len);
    return;
}
fn c_kvn_ns(co:[]u8, k:[]u8, v:i64)void {
    c_lit_ns(co,k);
    c_lit_ns(co,"=");
    c_num(co,v);
    c_lit_ns(co,";");
    return;
}
fn c_num(co:[]u8, v:i64)void {
    let nb:[]u8=nio_alloc(32);
    let nl:i32=i64str(v,nb);
    c_raw(co,nb,0,nl);
    nio_free(nb);
    return;
}
fn c_kv(co:[]u8, k:[]u8, s:[]u8, so:i32, sl:i32)void {
    c_put(co,k);
    c_lit(co,"=");
    c_raw(co,s,so,sl);
    c_lit(co,";");
    return;
}
fn c_kvn(co:[]u8, k:[]u8, v:i64)void {
    c_put(co,k);
    c_lit(co,"=");
    c_num(co,v);
    c_lit(co,";");
    return;
}
// append one fact's text into content (sanitized), prefixed with fid.
fn c_fact(co:[]u8, fm:[]u8, ftx:[]u8, fid:i32)void {
    if(fid<0){ c_lit_ns(co,"fact=-;"); return; }
    let fro:i32=8+fid*40;
    let fto:i32=g32(fm,fro+16) as i32;
    let ftl2:i32=g32(fm,fro+20) as i32;
    c_lit_ns(co,"fact=\"");
    c_raw(co,ftx,fto,ftl2);
    c_lit_ns(co,"\";");
    return;
}
fn c_len(co:[]u8)i32 {
    return g32(co,0) as i32;
}
// ---- trace helpers ----
fn tr_pr(s:[]u8)void {
    _zag_print(s);
    return;
}
fn tr_prn(v:i64)void {
    let nb:[]u8=nio_alloc(32);
    let nl:i32=i64str(v,nb);
    _zag_print(nb[0..nl]);
    nio_free(nb);
    return;
}
fn tr_phash(dg:[]u8)void {
    prhex(dg,0,32);
    return;
}
fn tr_reason_name(r:i32)[]u8 {
    if(r==1){ return "PRE_FAIL"; }
    if(r==2){ return "GATE"; }
    if(r==3){ return "OUTSCORED"; }
    return "NONE";
}
// ---- per-hypothesis side-effect log (hsfx, 512B) ----
// 0: nsal, 4: sal_eids[64] (256B) -> 260
// 260: npv, 264: (off,val)[20] (160B) -> 424
// 424: top_op1, 428: top_arg1, 432: top_op2, 436: top_arg2 -> 440
// 440: pqb_mode, 444: pqb_qlen -> 448
// 448: novelf (-1=skip) -> 452
// 452: ret_fid -> 456
// 456: uc_rerun, 460: uc_subj, 464: uc_rel, 468: uc_val -> 472
// 472..512: spare
fn sfx_init(hs:[]u8)void {
    p32(hs,0,0);
    p32(hs,260,0);
    p32(hs,424,0); p32(hs,428,0); p32(hs,432,0); p32(hs,436,0);
    p32(hs,440,0); p32(hs,444,0);
    p32(hs,448,-1);
    p32(hs,452,-1);
    p32(hs,456,0); p32(hs,460,0); p32(hs,464,0); p32(hs,468,0);
    return;
}
// record one sal push, keeping the last 64 (only the last 8 affect sal).
fn sfx_sal_push(hs:[]u8, eid:i32)void {
    let n:i32=g32(hs,0) as i32;
    if(n>=64){
        let i:i32=0;
        while(i<63){
            p32(hs,4+i*4,g32(hs,4+(i+1)*4));
            i=i+1;
        }
        n=63;
    }
    p32(hs,4+n*4,eid);
    p32(hs,0,n+1);
    return;
}
// record push_ents order: eout[ne-1] .. eout[0].
fn sfx_sal_push_rev(hs:[]u8, eout:[]u8, ne:i32)void {
    let k:i32=ne-1;
    while(k>=0){
        sfx_sal_push(hs,g32(eout,k*4) as i32);
        k=k-1;
    }
    return;
}
// record push_fact_ents order: fea[eo+en-1] .. fea[eo].
fn sfx_sal_push_fact(hs:[]u8, fm:[]u8, fea:[]u8, fid:i32)void {
    if(fid<0){ return; }
    let fro:i32=8+fid*40;
    let eo:i32=g32(fm,fro+24) as i32;
    let en:i32=g32(fm,fro+28) as i32;
    let k:i32=en-1;
    while(k>=0){
        sfx_sal_push(hs,g32(fea,eo+k*4) as i32);
        k=k-1;
    }
    return;
}
// pv writes go through the shared log at hs[260..] (same layout as pvl).
fn sfx_pv(hs:[]u8, off:i32, val:i32)void {
    pvl_log(hs[260..424],off,val);
    return;
}
fn sfx_top(hs:[]u8, op:i32, arg:i32)void {
    if((g32(hs,424) as i32)==0){ p32(hs,424,op); p32(hs,428,arg); return; }
    p32(hs,432,op); p32(hs,436,arg);
    return;
}
// ---- GEN: readings (hid 0..9) ----
// One reading per candidate bid: computed evidence + method note.
// score = ev*10, except the null-hypothesis r_plain which scores ev*5.
fn rd_name(h:i32)[]u8 {
    if(h==0){ return "correction"; }
    if(h==1){ return "resume"; }
    if(h==2){ return "challenge"; }
    if(h==3){ return "provenance"; }
    if(h==4){ return "joke"; }
    if(h==5){ return "mem"; }
    if(h==6){ return "forget"; }
    if(h==7){ return "assertion"; }
    if(h==8){ return "compose"; }
    return "plain";
}
fn rd_method(h:i32)[]u8 {
    if(h==0){ return "corrected"; }
    if(h==1){ return "resume"; }
    if(h==2){ return "defense"; }
    if(h==3){ return "provenance"; }
    if(h==4){ return "joke"; }
    if(h==8){ return "compose"; }
    return "-";
}
fn r_compose_ev(ubuf:[]u8,uo:i32,ul:i32)i32 {
    // Repair #11: the cue vocabulary must COVER every do_compose trigger,
    // so that do_compose(...)==1 implies ev>0 on all four shapes:
    //   shape 1 (F3): diff_dim>0 -> first cue below;
    //   shape 2 (F1): do_compare==1 -> one of the comparison words below
    //     (do_compare returns 0 unless tall/w_min/w_max fired, and each is
    //     set only by these words);
    //   shape 3 (did-write): the did+write cue below (same test);
    //   shape 4 (birth-year): the birth-year cue below (same test).
    // With coverage proven, gen_compose's `ev>0 && do_compose==1` gate is
    // behavior-preserving and the kind-0 row is genuinely causal.
    let e:i32=0;
    if(diff_dim(ubuf,uo,ul)>0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"taller",0,6)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"tallest",0,7)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"shorter",0,7)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"shortest",0,8)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"older",0,5)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"oldest",0,6)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"younger",0,7)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"youngest",0,8)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"before",0,6)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"after",0,5)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"earlier",0,7)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"later",0,5)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"first",0,5)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"last",0,4)>=0){ e=e+1; }
    if(starts_with(ubuf,uo,ul,"did ",4)==1 && find_sub(ubuf,uo,ul,"write",0,5)>=0){ e=e+1; }
    if(find_sub(ubuf,uo,ul,"birth year",0,10)>=0){ e=e+1; }
    if(e>4){ e=4; }
    return e;
}
fn gen_readings(led:[]u8,ubuf:[]u8,uo:i32,ul:i32,abuf:[]u8,done:[]u8)void {
    // per-GEN idempotence (repair #4)
    if(g32(done,0)==1){ return; }
    p32(done,0,1);
    let ut:i32=utter_type(ubuf,uo,ul);
    let h:i32=0;
    while(h<10){
        let ev:i32=0;
        if(h==0){ ev=is_correction(ubuf,uo,ul); }
        if(h==1){ ev=is_resume(ubuf,uo,ul); }
        if(h==2){ ev=is_challenge(ubuf,uo,ul); }
        if(h==3){ ev=prov_match(ubuf,uo,ul,abuf); }
        if(h==4){ if(ut==1){ ev=1; } }
        if(h==5){ if(ut==2){ ev=1; } }
        if(h==6){ if(ut==3){ ev=1; } }
        if(h==7){ if(find_sub(ubuf,uo,ul,"?",0,1)<0){ ev=1; } }
        if(h==8){ ev=r_compose_ev(ubuf,uo,ul); }
        // Repair #11: row 9 "plain" is the none-of-the-above hypothesis:
        // it fires iff none of the special readings (rows 0..8) fired.
        // Rows 0..8 are written earlier in this same loop, so reading them
        // back here is deterministic. gen_default requires the plain
        // reading, which gives this row its genuine read site.
        if(h==9){
            ev=1;
            let q2:i32=0;
            while(q2<9){
                if(lr_get(led,q2,12)!=0){ ev=0; }
                q2=q2+1;
            }
        }
        let sc:i32=ev*10;
        if(h==9){ sc=ev*5; }
        lr_put(led,h,4,0);
        lr_put(led,h,12,ev);
        lr_put(led,h,16,0);
        lr_put(led,h,20,0);
        lr_put(led,h,24,sc);
        let co:[]u8=lr_content(led,h);
        c_init(co);
        c_lit_ns(co,"rd=");
        c_put(co,rd_name(h));
        c_lit_ns(co,";ev=");
        c_num(co,ev as i64);
        c_lit_ns(co,";method=");
        c_put(co,rd_method(h));
        c_lit_ns(co,";");
        tr_pr("READ hid=");
        tr_prn(h as i64);
        tr_pr(" rd=");
        tr_pr(rd_name(h));
        tr_pr(" ev=");
        tr_prn(ev as i64);
        tr_pr(" score=");
        tr_prn(sc as i64);
        tr_pr("\n");
        h=h+1;
    }
    return;
}
// ---- default-path query computation (shared, read-only) ----
// Replicates the default branch's query shaping: entity scan, pronoun
// resolution, ellipsis / salience-head shaping, proc_sentence.
// o: 0=ql3, 4=bn, 8=ne4, 12=plen2.
fn default_query(ubuf:[]u8,uo:i32,ul:i32,sal:[]u8,pv:[]u8,pqb:[]u8,
    fm:[]u8,fea:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,
    gnames:[]u8,ge:[]u8,gord:[]u8,
    qbuf:[]u8,eout:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,
    o:[]u8)void {
    let ne4:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
    let ql3:i32=build_resolved(ubuf,uo,ul,sal,ge,gnames,qbuf,bout);
    let bn:i32=g32(bout,0) as i32;
    let cc:i32=content_count(ubuf,uo,ul,eout,ne4,vbytes,vent);
    let use_ellip:i32=0;
    if(ne4==0 && bn==0){ use_ellip=1; }
    if(ne4==0 && bn==0 && cc>0){ use_ellip=0; }
    if(use_ellip==1){
        let pqo:i32=g32(pv,12) as i32;
        let pql:i32=g32(pv,16) as i32;
        let pbn:i32=g32(pv,32) as i32;
        if(pql>0 && pbn<=0){
            copy_bytes(qbuf,0,pqb,pqo,pql);
            ql3=pql;
            ne4=gaz_scan(gnames,ge,gord,qbuf,0,ql3,eout,-1);
        }
    }
    // Second ellipsis branch: only fire when there is truly no content.
    // The original condition (use_ellip==0 && ne4==0 && bn==0) fired for
    // queries with unknown content words (e.g. "who wrote hamlet?"),
    // incorrectly copying the previous query. Gate on cc==0.
    if(use_ellip==0 && ne4==0 && bn==0 && cc==0 && (g32(pv,32) as i32)<=0){
        let pqo:i32=g32(pv,20) as i32;
        let pql:i32=g32(pv,24) as i32;
        if(pql>0){
            copy_bytes(qbuf,0,pqb,pqo,pql);
            ql3=pql;
            ne4=gaz_scan(gnames,ge,gord,qbuf,0,ql3,eout,-1);
        }
    }
    p32(linka,0,8); zero40(st);
    proc_sentence(vbytes,vent,qbuf,0,ql3,tmp,kid,linka,keya,trb,st,out);
    let plen2:i32=g32(out,12) as i32;
    p32(o,0,ql3); p32(o,4,bn); p32(o,8,ne4); p32(o,12,plen2);
    return;
}
fn fact_jscore(fm:[]u8,keya:[]u8,kid:[]u8,plen:i32,fid:i32,o:[]u8)void {
    let fro:i32=8+fid*40;
    let fko:i32=g32(fm,fro+4) as i32;
    let fkl:i32=g32(fm,fro+8) as i32;
    let sc:i64=jscore(kid,plen,keya,fko,fkl);
    p32(o,0,((sc>>32)&4294967295) as i32);
    p32(o,4,(sc&4294967295) as i32);
    return;
}
// ---- GEN: fact candidates (hid 10..12) ----
// Top-3 distinct facts by the default path's retrieval, each scored by
// Jaccard (inter/union) and checked against the withhold gate.
fn gen_facts(led:[]u8,ubuf:[]u8,uo:i32,ul:i32,sal:[]u8,pv:[]u8,pqb:[]u8,
    fm:[]u8,fea:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,
    gnames:[]u8,ge:[]u8,gord:[]u8,
    qbuf:[]u8,eout:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,fout:[]u8,
    last_fid:i32,done:[]u8)void {
    // per-GEN idempotence flag (repair #4): each GEN executes exactly once
    // per turn regardless of call order (K1 reversal safety).
    if(g32(done,40)==1){ return; }
    p32(done,40,1);
    let dq:[]u8=nio_alloc(16);
    default_query(ubuf,uo,ul,sal,pv,pqb,fm,fea,keya,vbytes,vent,linka,gnames,ge,gord,
        qbuf,eout,bout,kid,tmp,trb,st,out,dq);
    let ql3:i32=g32(dq,0) as i32;
    let bn:i32=g32(dq,4) as i32;
    let ne4:i32=g32(dq,8) as i32;
    let plen2:i32=g32(dq,12) as i32;
    let e1:i32=retrieve(fm,keya,kid,plen2,-1,-1,fea,last_fid);
    let e2:i32=retrieve_ex(fm,keya,kid,plen2,e1,-1,-1,fea,last_fid);
    let e3:i32=retrieve_ex(fm,keya,kid,plen2,e1,e2,-1,fea,last_fid);
    let jo:[]u8=nio_alloc(8);
    let ci:i32=0;
    while(ci<3){
        let fid:i32=e1;
        if(ci==1){ fid=e2; }
        if(ci==2){ fid=e3; }
        let hid:i32=10+ci;
        lr_put(led,hid,4,1);
        let inter:i32=0;
        let union:i32=0;
        let gate:i32=0;
        if(fid>=0){
            fact_jscore(fm,keya,kid,plen2,fid,jo);
            inter=g32(jo,0) as i32;
            union=g32(jo,4) as i32;
            let fro:i32=8+fid*40;
            let fko:i32=g32(fm,fro+4) as i32;
            let fkl:i32=g32(fm,fro+8) as i32;
            let feo:i32=g32(fm,fro+24) as i32;
            let fen:i32=g32(fm,fro+28) as i32;
            gate=withhold_check_gate(ubuf,uo,ul,qbuf,ql3,kid,plen2,keya,fko,fkl,
                fea,feo,fen,eout,ne4,bout,bn,vbytes,vent,tmp,fout);
        }
        let q:i32=0;
        if(union>0){ q=(inter*100)/union; }
        lr_put(led,hid,12,inter);
        lr_put(led,hid,16,0);
        lr_put(led,hid,20,0);
        lr_put(led,hid,24,q);
        lr_put(led,hid,36,inter);
        lr_put(led,hid,40,union);
        lr_put(led,hid,44,fid);
        lr_put(led,hid,48,gate);
        let co:[]u8=lr_content(led,hid);
        c_init(co);
        c_lit_ns(co,"cand=");
        c_num(co,ci as i64);
        c_lit_ns(co,";fid=");
        c_num(co,fid as i64);
        c_lit_ns(co,";inter=");
        c_num(co,inter as i64);
        c_lit_ns(co,";union=");
        c_num(co,union as i64);
        c_lit_ns(co,";q=");
        c_num(co,q as i64);
        c_lit_ns(co,";gate=");
        c_num(co,gate as i64);
        c_lit_ns(co,";ent=");
        let pe:i32=-1;
        if(fid>=0){ pe=fact_primary(fm,fea,fid); }
        if(pe>=0){
            c_raw(co,gnames,g32(ge,8+pe*16) as i32,g32(ge,8+pe*16+4) as i32);
        }
        c_lit_ns(co,";");
        // K3: every ledger row gets a trace line, even a null candidate.
        tr_pr("FACT hid=");
        tr_prn(hid as i64);
        tr_pr(" fid=");
        tr_prn(fid as i64);
        tr_pr(" inter=");
        tr_prn(inter as i64);
        tr_pr(" union=");
        tr_prn(union as i64);
        tr_pr(" q=");
        tr_prn(q as i64);
        tr_pr(" gate=");
        tr_prn(gate as i64);
        tr_pr("\n");
        ci=ci+1;
    }
    nio_free(dq);
    nio_free(jo);
    return;
}
// ---- fact-candidate selection (G2 compliant: no separate phase) ----
// Scans hid 10-12 for the best fact candidate with gate==0 (passes the
// withhold gate). Returns the hid, or -1 if none passes. Called by
// gen_clarify/gen_withhold/gen_default during GEN — no ELIM/ARGMAX phase,
// no turn field. All candidates are generated before any elimination (G2).
fn best_gated_fact(led:[]u8)i32 {
    let best:i32=-1;
    let best_q:i32=-1;
    let h:i32=10;
    while(h<=12){
        let gate:i32=lr_get(led,h,48);
        if(gate==0){
            let q:i32=lr_get(led,h,24);
            if(q>best_q){ best_q=q; best=h; }
        }
        h=h+1;
    }
    return best;
}
// ---- fact-candidate ELIM + ARGMAX (repair #2: ELIM before any OUTSCORED) ----
// Eliminate fact candidates: null candidates (fid<0) -> PRE_FAIL; candidates
// failing the withhold gate -> GATE(gate id). Runs before fact argmax.
fn fact_elim_phase(led:[]u8)void {
    let h:i32=10;
    while(h<=12){
        let st8:i32=lr_get(led,h,8);
        if(st8==0){
            let fid:i32=lr_get(led,h,44);
            if(fid<0){
                lr_put(led,h,8,1);
                lr_put(led,h,28,1);
                lr_put(led,h,32,0);
            } else {
                let gate:i32=lr_get(led,h,48);
                if(gate!=0){
                    lr_put(led,h,8,1);
                    lr_put(led,h,28,2);
                    lr_put(led,h,32,gate);
                }
            }
        }
        h=h+1;
    }
    return;
}
// Fact ARGMAX: winner = max q (field 24) among status-0 candidates in
// 10..12, ties -> lowest hid. Winner hid stored in the turn field at 13804
// (-1 if none survive). Traced during the phase (G5).
fn fact_argmax_phase(led:[]u8)i32 {
    let best:i32=-1;
    let bs:i32=-1;
    let h:i32=10;
    while(h<=12){
        if(lr_get(led,h,8)==0){
            let s:i32=lr_get(led,h,24);
            if(best<0 || s>bs){
                best=h;
                bs=s;
            }
        }
        h=h+1;
    }
    t_put(led,13804,best);
    // margin to the runner-up (for the FACTARGMAX trace)
    let m:i32=0;
    if(best>=0){
        let rs:i32=-1;
        h=10;
        while(h<=12){
            if(h!=best && lr_get(led,h,8)==0){
                let s2:i32=lr_get(led,h,24);
                if(s2>rs){ rs=s2; }
            }
            h=h+1;
        }
        if(rs>=0){ m=bs-rs; }
    }
    tr_pr("FACTARGMAX hid=");
    if(best>=0){ tr_prn(best as i64); } else { tr_pr("none"); }
    tr_pr(" score=");
    tr_prn(bs as i64);
    tr_pr(" margin=");
    tr_prn(m as i64);
    tr_pr("\n");
    return best;
}
// Mark surviving fact-candidate losers OUTSCORED (runs after fact argmax,
// before any ELIM trace is emitted — repair #2).
fn fact_outscore_phase(led:[]u8, winner:i32)void {
    if(winner<0){ return; }
    let h:i32=10;
    while(h<=12){
        if(h!=winner && lr_get(led,h,8)==0){
            lr_put(led,h,8,1);
            lr_put(led,h,28,3);
            lr_put(led,h,32,winner);
        }
        h=h+1;
    }
    return;
}
fn bid_row(led:[]u8, hid:i32, fire:i32, base:i32, bonus:i32)void {
    lr_put(led,hid,4,2);
    lr_put(led,hid,12,fire);
    lr_put(led,hid,16,base);
    lr_put(led,hid,20,bonus);
    lr_put(led,hid,24,base+bonus);
    return;
}
fn tr_cand(led:[]u8, hid:i32, nm:[]u8)void {
    tr_pr("CAND hid=");
    tr_prn(hid as i64);
    tr_pr(" bid=");
    tr_pr(nm);
    tr_pr(" fire=");
    tr_prn(lr_get(led,hid,12) as i64);
    tr_pr(" base=");
    tr_prn(lr_get(led,hid,16) as i64);
    tr_pr(" bonus=");
    tr_prn(lr_get(led,hid,20) as i64);
    tr_pr(" score=");
    tr_prn(lr_get(led,hid,24) as i64);
    tr_pr("\n");
    return;
}
// mirrors compose_joke's shortest/tallest selection (for trace content).
fn joke_vals(fm:[]u8,fea:[]u8,ftl:[]u8,gnames:[]u8,ge:[]u8,o:[]u8)void {
    let ne:i32=g32(ge,0) as i32;
    let se:i32=-1;
    let te:i32=-1;
    let sv:i64=0;
    let tv:i64=0;
    let e:i32=0;
    while(e<ne){
        let hv:i64=(year_of(fm,fea,ftl,gnames,ge,e,"tall",4) as i64);
        if(hv>=0){
            if(se<0 || hv<sv){ se=e; sv=hv; }
            if(te<0 || hv>tv){ te=e; tv=hv; }
        }
        e=e+1;
    }
    p32(o,0,se); p32(o,4,te); p32(o,8,sv as i32); p32(o,12,tv as i32);
    return;
}
fn c_ent(co:[]u8,gnames:[]u8,ge:[]u8,eid:i32)void {
    if(eid<0){ c_lit_ns(co,"-"); return; }
    c_raw(co,gnames,g32(ge,8+eid*16) as i32,g32(ge,8+eid*16+4) as i32);
    return;
}
// GEN 13: joke. base 240.
fn gen_joke(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    // Repair #11: read the shared kind-0 joke reading (hid 4) instead of
    // re-deriving utter_type. gen_readings computed the utterance-type
    // judgment once into the ledger; this GEN consumes it. Neutering row 4
    // now kills the joke bid (neuter-causal, not decorative).
    let jokerev:i32=lr_get(led,4,12);
    let fire:i32=0;
    let bonus:i32=0;
    if(jokerev==1){
        fire=1;
        rclr(ha);
        compose_joke(ha,fm,fea,ftl,gnames,ge,nbuf);
        let ne0:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        sfx_sal_push_rev(hs,eout,ne0);
        let pe0:i32=-1;
        if(ne0>0){ pe0=g32(eout,0) as i32; }
        sfx_pv(hs,0,-1); sfx_pv(hs,4,pe0); sfx_pv(hs,8,pe0); sfx_pv(hs,28,1);
        if(pe0>=0 && pe0!=top_peek(top)){ sfx_top(hs,1,pe0); }
        let nv:i32=novelty_ok(ha,fm,ftl,hist,histb);
        p32(hs,448,nv);
        p32(hs,452,-1);
        let jv:[]u8=nio_alloc(16);
        joke_vals(fm,fea,ftl,gnames,ge,jv);
        let se:i32=g32(jv,0) as i32;
        let te:i32=g32(jv,4) as i32;
        let sv:i32=g32(jv,8) as i32;
        let tv:i32=g32(jv,12) as i32;
        nio_free(jv);
        let co:[]u8=lr_content(led,hid);
        c_init(co);
        c_lit_ns(co,"bid=joke;se=");
        c_ent(co,gnames,ge,se);
        c_lit_ns(co,";te=");
        c_ent(co,gnames,ge,te);
        c_lit_ns(co,";");
        c_kvn_ns(co,"sv",sv as i64);
        c_kvn_ns(co,"tv",tv as i64);
        c_kvn_ns(co,"diff",(tv-sv) as i64);
        c_kvn_ns(co,"novel",nv as i64);
        c_kvn_ns(co,"pe",pe0 as i64);
        let b2:i32=ne0;
        if(b2>2){ b2=2; }
        if(nv==1){ bonus=3+b2; }
        if(nv==0){ bonus=b2; }
    }
    bid_row(led,hid,fire,240,bonus);
    tr_cand(led,hid,"joke");
    return;
}
// GEN 14: memory question. base 220.
fn gen_mem(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    // Repair #11: read the shared kind-0 memory reading (hid 5) instead of
    // re-deriving utter_type (see gen_joke).
    let memev:i32=lr_get(led,5,12);
    let fire:i32=0;
    let bonus:i32=0;
    if(memev==1){
        fire=1;
        rclr(ha);
        mem_answer(ha,ubuf,uo,ul,hist,histb);
        let ne0:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        sfx_sal_push_rev(hs,eout,ne0);
        let pe0:i32=-1;
        if(ne0>0){ pe0=g32(eout,0) as i32; }
        sfx_pv(hs,0,-1); sfx_pv(hs,4,pe0); sfx_pv(hs,8,pe0); sfx_pv(hs,28,1);
        if(pe0>=0 && pe0!=top_peek(top)){ sfx_top(hs,1,pe0); }
        let nv:i32=novelty_ok(ha,fm,ftl,hist,histb);
        p32(hs,448,nv);
        p32(hs,452,-1);
        let co:[]u8=lr_content(led,hid);
        c_init(co);
        c_lit_ns(co,"bid=mem;q=\"");
        let al:i32=g32(ha,0) as i32;
        if(al>11){ c_raw(co,ha,4+11,al-11); }
        c_lit_ns(co,"\";");
        c_kvn_ns(co,"novel",nv as i64);
        let b2:i32=ne0;
        if(b2>2){ b2=2; }
        if(nv==1){ bonus=3+b2; }
        if(nv==0){ bonus=b2; }
    }
    bid_row(led,hid,fire,237,bonus);
    tr_cand(led,hid,"mem");
    return;
}
// GEN 15: forget request. base 200.
fn gen_forget(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    // Repair #11: read the shared kind-0 forget reading (hid 6) instead of
    // re-deriving utter_type (see gen_joke).
    let forev:i32=lr_get(led,6,12);
    let fire:i32=0;
    let bonus:i32=0;
    if(forev==1){
        fire=1;
        rclr(ha);
        let fmsg:[]u8="I can't forget. My architecture doesn't let me -- I have no way to delete what I've been taught.";
        rput(ha,fmsg,0,fmsg.len);
        let ne0:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        let pe0:i32=-1;
        if(ne0>0){ pe0=g32(eout,0) as i32; }
        sfx_pv(hs,0,-1); sfx_pv(hs,4,pe0); sfx_pv(hs,8,pe0); sfx_pv(hs,28,1);
        if(pe0>=0 && pe0!=top_peek(top)){ sfx_top(hs,1,pe0); }
        let nv:i32=novelty_ok(ha,fm,ftl,hist,histb);
        p32(hs,448,nv);
        p32(hs,452,-1);
        let co:[]u8=lr_content(led,hid);
        c_init(co);
        c_lit_ns(co,"bid=forget;mode=fixed;");
        c_kvn_ns(co,"novel",nv as i64);
        let b2:i32=ne0;
        if(b2>2){ b2=2; }
        if(nv==1){ bonus=3+b2; }
        if(nv==0){ bonus=b2; }
    }
    bid_row(led,hid,fire,234,bonus);
    tr_cand(led,hid,"forget");
    return;
}
// GEN 16: correction. base 180.
fn gen_correction(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    let pkind:i32=g32(pv,28) as i32;
    let pans:i32=g32(pv,0) as i32;
    let fire:i32=0;
    let bonus:i32=0;
    let wh_c:i32=0;
    let fid:i32=-1;
    // Repair #11: read the shared kind-0 correction reading (hid 0) instead
    // of re-deriving is_correction (see gen_joke).
    if(pkind==0 && pans>=0 && lr_get(led,0,12)==1){
        fire=1;
        let excl_eid:i32=g32(pv,4) as i32;
        let ro:i32=uo;
        let rl2:i32=ul;
        let mi:i32=find_sub(ubuf,uo,ul,"i meant",0,7);
        if(mi>=0){ ro=uo+mi+7; rl2=ul-mi-7; }
        else {
            if(starts_with(ubuf,uo,ul,"no,",3)==1){ ro=uo+3; rl2=ul-3; }
            else {
                if(starts_with(ubuf,uo,ul,"no ",3)==1){ ro=uo+3; rl2=ul-3; }
                else {
                    let ni:i32=find_sub(ubuf,uo,ul,"not that",0,8);
                    if(ni>=0){ ro=uo+ni+8; rl2=ul-ni-8; }
                    else { ro=uo; rl2=0; }
                }
            }
        }
        while(rl2>0 && ubuf[ro]==32){ ro=ro+1; rl2=rl2-1; }
        while(rl2>0 && (ubuf[ro+rl2-1]==46 || ubuf[ro+rl2-1]==63)){ rl2=rl2-1; }
        let ne_corr:i32=gaz_scan(gnames,ge,gord,ubuf,ro,rl2,eout,excl_eid);
        let ql2:i32=build_resolved(ubuf,ro,rl2,sal,ge,gnames,qbuf,bout);
        let use_prev:i32=0;
        let shaped:i32=0;
        if(rl2==0){ use_prev=1; }
        else {
            if(ne_corr==0){
                let oi:i32=find_sub(ubuf,ro,rl2,"the other one",0,13);
                if(oi>=0){ use_prev=1; }
            }
            if(use_prev==0 && ne_corr>0){
                // correction method (taught KB fact 46): re-ask the PREVIOUS
                // question about the new entity. The bare remainder
                // ("moby dick") loses the "who wrote" intent and retrieves
                // the publication fact. Shape by swapping the corrected
                // entity into the previous resolved query (repair #6);
                // fall back to the bare remainder if the swap fails.
                let ppe_c:i32=g32(pv,8) as i32;
                let pqo_c:i32=g32(pv,20) as i32;
                let pql_c:i32=g32(pv,24) as i32;
                if(ppe_c>=0 && pql_c>0){
                    let pno_c:i32=g32(ge,8+ppe_c*16) as i32;
                    let pnl_c:i32=g32(ge,8+ppe_c*16+4) as i32;
                    let at_c:i32=find_sub(pqb,pqo_c,pql_c,gnames,pno_c,pnl_c);
                    if(at_c>=0){
                        let e0_c:i32=g32(eout,0) as i32;
                        let nno_c:i32=g32(ge,8+e0_c*16) as i32;
                        let nnl_c:i32=g32(ge,8+e0_c*16+4) as i32;
                        copy_bytes(qbuf,0,pqb,pqo_c,at_c);
                        copy_bytes(qbuf,at_c,gnames,nno_c,nnl_c);
                        let tail_c:i32=pql_c-at_c-pnl_c;
                        copy_bytes(qbuf,at_c+nnl_c,pqb,pqo_c+at_c+pnl_c,tail_c);
                        ql2=at_c+nnl_c+tail_c;
                        shaped=1;
                    }
                }
            }
        }
        if(use_prev==1){
            let pqo:i32=g32(pv,20) as i32;
            let pql:i32=g32(pv,24) as i32;
            copy_bytes(qbuf,0,pqb,pqo,pql);
            ql2=pql;
            ne_corr=gaz_scan(gnames,ge,gord,qbuf,0,ql2,eout,excl_eid);
        }
        p32(linka,0,8); zero40(st);
        proc_sentence(vbytes,vent,qbuf,0,ql2,tmp,kid,linka,keya,trb,st,out);
        let plen:i32=g32(out,12) as i32;
        fid=retrieve(fm,keya,kid,plen,pans,excl_eid,fea,-1);
        // fid<0 guard (repair): retrieve can return -1; the offset
        // 8+fid*40 would be negative. Skip the gate and withhold.
        if(fid<0){
            rclr(ha);
            rput(ha,"I don't know.",0,13);
            sfx_sal_push_rev(hs,eout,ne_corr);
            sfx_pv(hs,0,-1); sfx_pv(hs,4,-1); sfx_pv(hs,8,-1);
            sfx_pv(hs,28,0);
            p32(hs,440,1); p32(hs,444,ql2);
            copy_bytes(hqs,0,qbuf,0,ql2);
            p32(hs,452,-1);
            let co_c0:[]u8=lr_content(led,hid);
            c_init(co_c0);
            c_lit_ns(co_c0,"bid=correction;method=corrected;nofid=1;");
            bid_row(led,hid,1,180,2);
            lr_put(led,hid,36,-1);
            tr_cand(led,hid,"correction");
            return;
        }
        let fro_c:i32=8+fid*40;
        let fko_c:i32=g32(fm,fro_c+4) as i32;
        let fkl_c:i32=g32(fm,fro_c+8) as i32;
        let feo_c:i32=g32(fm,fro_c+24) as i32;
        let fen_c:i32=g32(fm,fro_c+28) as i32;
        wh_c=withhold_check_gate(ubuf,uo,ul,qbuf,ql2,kid,plen,keya,fko_c,fkl_c,fea,feo_c,fen_c,eout,ne_corr,bout,0,vbytes,vent,tmp,fout);
        rclr(ha);
        if(wh_c!=0){ rput(ha,"I don't know.",0,13); }
        else { emit_fact(ha,fm,ftx,fid); }
        sfx_sal_push_rev(hs,eout,ne_corr);
        sfx_sal_push_fact(hs,fm,fea,fid);
        let pe:i32=-1;
        if(ne_corr>0){ pe=g32(eout,0) as i32; }
        if(pe<0){ pe=fact_primary(fm,fea,fid); }
        sfx_pv(hs,0,fid); sfx_pv(hs,4,pe); sfx_pv(hs,8,pe);
        let nqo:i32=g32(pqb,0) as i32;
        sfx_pv(hs,20,nqo); sfx_pv(hs,24,ql2);
        p32(hs,440,1); p32(hs,444,ql2);
        copy_bytes(hqs,0,qbuf,0,ql2);
        sfx_pv(hs,28,0);
        if(pe>=0 && pe!=top_peek(top)){ sfx_top(hs,1,pe); }
        sfx_pv(hs,32,0);
        p32(hs,452,fid);
        let co:[]u8=lr_content(led,hid);
        c_init(co);
        c_lit_ns(co,"bid=correction;method=corrected;");
        if(wh_c!=0){ c_lit_ns(co,"wh=1;"); } else { c_lit_ns(co,"wh=0;"); }
        c_kvn_ns(co,"gate",wh_c as i64);
        c_kvn_ns(co,"fid",fid as i64);
        c_kvn_ns(co,"pe",pe as i64);
        c_kvn_ns(co,"shaped",shaped as i64);
        c_fact(co,fm,ftx,fid);
        if(ne_corr>0){ bonus=bonus+2; }
        if(wh_c==0){ bonus=bonus+1; }
    }
    bid_row(led,hid,fire,231,bonus);
    lr_put(led,hid,36,fid);
    lr_put(led,hid,48,wh_c);
    tr_cand(led,hid,"correction");
    return;
}
// GEN 17: topic resume. base 160.
fn gen_resume(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    let fire:i32=0;
    let bonus:i32=0;
    let fid2:i32=-1;
    let eid:i32=-1;
    // Repair #11: read the shared kind-0 resume reading (hid 1) instead
    // of re-deriving is_resume (see gen_joke).
    if(lr_get(led,1,12)==1){
        fire=1;
        let bi:i32=find_sub(ubuf,uo,ul,"back to",0,7);
        let ro:i32=uo;
        let rl2:i32=ul;
        if(bi>=0){ ro=uo+bi+7; rl2=ul-bi-7; }
        let ne2:i32=gaz_scan(gnames,ge,gord,ubuf,ro,rl2,eout,-1);
        if(ne2>0){ eid=g32(eout,0) as i32; }
        if(ne2==0){ eid=fallback_eid(gnames,ge,ubuf,ro,rl2,-1); }
        let op1:i32=0;
        let a1:i32=0;
        if(eid>=0 && top_has(top,eid)==1){ op1=2; a1=eid; }
        if(eid>=0 && top_has(top,eid)==0){ op1=1; a1=eid; }
        if(eid<0){ op1=3; }
        sfx_top(hs,op1,a1);
        let te:i32=top_sim(top,op1,a1,0,0);
        fid2=general_fact(fm,fea,te);
        rclr(ha);
        emit_fact(ha,fm,ftx,fid2);
        if(eid>=0){ sfx_sal_push(hs,eid); }
        sfx_sal_push_fact(hs,fm,fea,fid2);
        sfx_pv(hs,0,fid2); sfx_pv(hs,4,te); sfx_pv(hs,8,te); sfx_pv(hs,28,1);
        sfx_pv(hs,32,0);
        p32(hs,452,fid2);
        let co:[]u8=lr_content(led,hid);
        c_init(co);
        c_lit_ns(co,"bid=resume;method=resume;");
        c_kvn_ns(co,"eid",eid as i64);
        c_kvn_ns(co,"te",te as i64);
        c_kvn_ns(co,"fid",fid2 as i64);
        c_fact(co,fm,ftx,fid2);
        if(eid>=0){ bonus=2; }
    }
    bid_row(led,hid,fire,228,bonus);
    lr_put(led,hid,36,fid2);
    lr_put(led,hid,48,eid);
    tr_cand(led,hid,"resume");
    return;
}
// apply top ops to a scratch copy (GEN stays read-only); returns peek.
fn top_sim(top:[]u8, op1:i32, a1:i32, op2:i32, a2:i32)i32 {
    let tc:[]u8=nio_alloc(72);
    copy_bytes(tc,0,top,0,72);
    if(op1==1){ top_push(tc,a1); }
    if(op1==2){ top_pop_to(tc,a1); }
    if(op1==3){ top_pop1(tc); }
    if(op2==1){ top_push(tc,a2); }
    if(op2==2){ top_pop_to(tc,a2); }
    if(op2==3){ top_pop1(tc); }
    let r:i32=top_peek(tc);
    nio_free(tc);
    return r;
}
// GEN 18: composition. base 140.
fn gen_compose(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    let fire:i32=0;
    let bonus:i32=0;
    let cv:[]u8=nio_alloc(32);
    p32(cv,0,0);
    // Repair #11: the kind-0 compose hypothesis (hid 8) gates the verifier.
    // r_compose_ev's cue vocabulary covers every do_compose trigger (proven
    // in r_compose_ev's comment), so do_compose==1 implies the hypothesis
    // fired: the conjunction is behavior-preserving, and the READ row is
    // causal — neutering row 8 kills the compose bid even though the
    // verifier alone would still resolve.
    let compev:i32=lr_get(led,8,12);
    let dcok:i32=do_compose(ubuf,uo,ul,sal,pv,fm,fea,ftl,ftx,gnames,ge,gord,eout,eout2,bout,ha,nbuf,turn_no,hs[260..424],cv);
    if(compev>0 && dcok==1){
        fire=1;
        let ne3:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
        sfx_sal_push_rev(hs,eout,ne3);
        let pe2:i32=-1;
        if(ne3>0){ pe2=g32(eout,0) as i32; }
        sfx_pv(hs,4,pe2); sfx_pv(hs,8,pe2); sfx_pv(hs,28,1);
        sfx_pv(hs,0,-1);
        sfx_pv(hs,32,0);
        let nv:i32=novelty_ok(ha,fm,ftl,hist,histb);
        p32(hs,448,nv);
        p32(hs,452,-1);
        let shape:i32=g32(cv,0) as i32;
        let co:[]u8=lr_content(led,hid);
        c_init(co);
        c_lit_ns(co,"bid=compose;method=compose;");
        if(shape==1){
            c_lit_ns(co,"shape=f3;");
            c_lit_ns(co,"d1=");
            c_ent(co,gnames,ge,g32(cv,4) as i32);
            c_lit_ns(co,";d2=");
            c_ent(co,gnames,ge,g32(cv,8) as i32);
            c_lit_ns(co,";");
            c_kvn_ns(co,"v1",g32(cv,12) as i64);
            c_kvn_ns(co,"v2",g32(cv,16) as i64);
            c_kvn_ns(co,"diff",g32(cv,20) as i64);
            if((g32(cv,24) as i32)==1){ c_lit_ns(co,"unit=meters;"); }
            if((g32(cv,24) as i32)==2){ c_lit_ns(co,"unit=years;"); }
            bonus=2;
        }
        if(shape==2){
            c_lit_ns(co,"shape=cmp;");
            c_lit_ns(co,"e1=");
            c_ent(co,gnames,ge,g32(cv,4) as i32);
            c_lit_ns(co,";e2=");
            c_ent(co,gnames,ge,g32(cv,8) as i32);
            c_lit_ns(co,";");
            c_kvn_ns(co,"v1",g32(cv,12) as i64);
            c_kvn_ns(co,"v2",g32(cv,16) as i64);
            c_kvn_ns(co,"dmin",g32(cv,20) as i64);
            bonus=1;
        }
        if(shape==3){
            c_lit_ns(co,"shape=write;");
            c_lit_ns(co,"person=");
            c_ent(co,gnames,ge,g32(cv,4) as i32);
            c_lit_ns(co,";work=");
            c_ent(co,gnames,ge,g32(cv,8) as i32);
            c_lit_ns(co,";");
            c_kvn_ns(co,"r",g32(cv,20) as i64);
            bonus=1;
        }
        if(shape==4){
            c_lit_ns(co,"shape=birth;");
            c_lit_ns(co,"person=");
            c_ent(co,gnames,ge,g32(cv,4) as i32);
            c_lit_ns(co,";");
            c_fact(co,fm,ftx,g32(cv,8) as i32);
            bonus=1;
        }
        c_lit_ns(co,"ans=\"");
        let al:i32=g32(ha,0) as i32;
        c_raw(co,ha,4,al);
        c_lit_ns(co,"\";");
        c_kvn_ns(co,"novel",nv as i64);
        if(nv==1){ bonus=bonus+1; }
    }
    nio_free(cv);
    bid_row(led,hid,fire,225,bonus);
    tr_cand(led,hid,"compose");
    return;
}
// GEN 19: challenge defense. base 120.
fn gen_challenge(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    let pans:i32=g32(pv,0) as i32;
    let fire:i32=0;
    let bonus:i32=0;
    let cfid:i32=-1;
    // Repair #11: read the shared kind-0 challenge reading (hid 2) instead
    // of re-deriving is_challenge (see gen_joke).
    if(pans>=0 && lr_get(led,2,12)==1){
        fire=1;
        cfid=pans;
        let cd:i32=last_digit_buf(ubuf,uo,ul);
        let fd:i32=fact_last_digit(fm,ftl,cfid);
        let conf:i32=-1;
        if(cd>=0 && fd>=0 && cd!=fd){ conf=cd; }
        rclr(ha);
        do_defense(ha,fm,ftx,nbuf,cfid,conf);
        sfx_sal_push_fact(hs,fm,fea,cfid);
        sfx_pv(hs,0,cfid); sfx_pv(hs,28,0);
        sfx_pv(hs,32,0);
        p32(hs,452,cfid);
        let co:[]u8=lr_content(led,hid);
        c_init(co);
        c_lit_ns(co,"bid=challenge;method=defense;");
        c_kvn_ns(co,"cfid",cfid as i64);
        c_kvn_ns(co,"cd",cd as i64);
        c_kvn_ns(co,"fd",fd as i64);
        c_kvn_ns(co,"conf",conf as i64);
        c_fact(co,fm,ftx,cfid);
        if(conf>=0){ bonus=2; }
    }
    bid_row(led,hid,fire,222,bonus);
    lr_put(led,hid,36,cfid);
    tr_cand(led,hid,"challenge");
    return;
}
// GEN 20: provenance. base 100.
fn gen_provenance(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    let pans:i32=g32(pv,0) as i32;
    let fire:i32=0;
    let bonus:i32=0;
    let pfid:i32=-1;
    let pne:i32=0;
    // Repair #11: read the shared kind-0 provenance reading (hid 3) instead
    // of re-deriving prov_match (see gen_joke).
    if(lr_get(led,3,12)==1){
        let po:i32=g32(abuf,0) as i32;
        let prl:i32=uo+ul-po;
        while(prl>0 && (ubuf[po]==32 || ubuf[po]==46 || ubuf[po]==63)){ po=po+1; prl=prl-1; }
        while(prl>0 && (ubuf[po+prl-1]==46 || ubuf[po+prl-1]==63)){ prl=prl-1; }
        pne=gaz_scan(gnames,ge,gord,ubuf,po,prl,eout,-1);
        if(pne>0){
            let pql:i32=build_resolved(ubuf,po,prl,sal,ge,gnames,qbuf,bout);
            p32(linka,0,8); zero40(st);
            proc_sentence(vbytes,vent,qbuf,0,pql,tmp,kid,linka,keya,trb,st,out);
            pfid=retrieve(fm,keya,kid,g32(out,12) as i32,-1,-1,fea,-1);
        }
        if(pne==0 && pans>=0){ pfid=pans; }
        if(pfid>=0){
            fire=1;
            rclr(ha);
            do_provenance(ha,fm,ftx,pfid);
            sfx_sal_push_fact(hs,fm,fea,pfid);
            sfx_pv(hs,0,pfid); sfx_pv(hs,28,0);
            sfx_pv(hs,32,0);
            p32(hs,452,pfid);
            let co:[]u8=lr_content(led,hid);
            c_init(co);
            c_lit_ns(co,"bid=provenance;method=provenance;");
            c_kvn_ns(co,"pfid",pfid as i64);
            c_kvn_ns(co,"pne",pne as i64);
            c_fact(co,fm,ftx,pfid);
            if(pne>0){ bonus=1; }
        }
    }
    bid_row(led,hid,fire,219,bonus);
    lr_put(led,hid,36,pfid);
    tr_cand(led,hid,"provenance");
    return;
}
// GEN 21: assertion. base 80.
fn gen_assertion(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    let fire:i32=0;
    let bonus:i32=0;
    let conf:i32=0;
    let oldv:i32=0;
    // Repair #11: read the shared kind-0 assertion reading (hid 7) instead
    // of re-deriving the no-"?" test (see gen_joke).
    if(lr_get(led,7,12)==1){
        let rel:i32=extract_assert(ubuf,uo,ul,gnames,ge,gord,abuf,eout);
        if(rel>0){
            fire=1;
            let subj:i32=g32(abuf,0) as i32;
            let val:i32=g32(abuf,8) as i32;
            let ucs:[]u8=nio_alloc(8192);
            copy_bytes(ucs,0,uc,0,8192);
            let cturn:[]u8=nio_alloc(8);
            let coval:[]u8=nio_alloc(8);
            conf=uclaim_check(ucs,subj,rel,val,turn_no,cturn,coval);
            oldv=g32(coval,0) as i32;
            nio_free(ucs);
            nio_free(cturn);
            nio_free(coval);
            rclr(ha);
            if(conf==0){
                let cmsg:[]u8="NOTED.";
                rput(ha,cmsg,0,cmsg.len);
            }
            if(conf==1){
                rput(ha,"But you said ",0,13);
                render_claim(ha,subj,rel,oldv,gnames,ge,nbuf);
                rput(ha,", so which is it?",0,17);
            }
            sfx_sal_push(hs,subj);
            let nea:i32=gaz_scan(gnames,ge,gord,ubuf,uo,ul,eout,-1);
            sfx_sal_push_rev(hs,eout,nea);
            sfx_pv(hs,0,-1); sfx_pv(hs,4,subj); sfx_pv(hs,8,subj); sfx_pv(hs,28,1);
            sfx_pv(hs,32,0);
            p32(hs,452,-1);
            p32(hs,456,1); p32(hs,460,subj); p32(hs,464,rel); p32(hs,468,val);
            let co:[]u8=lr_content(led,hid);
            c_init(co);
            c_lit_ns(co,"bid=assertion;");
            c_lit_ns(co,"subj=");
            c_ent(co,gnames,ge,subj);
            c_lit_ns(co,";rel=");
            c_num(co,rel as i64);
            c_lit_ns(co,";oldv=");
            if(conf==1){
                if(rel==1 || rel==5 || rel==6){ c_ent(co,gnames,ge,oldv); }
                if(rel==2 || rel==3 || rel==4){ c_num(co,oldv as i64); }
            } else { c_lit_ns(co,"-"); }
            c_lit_ns(co,";");
            c_kvn_ns(co,"conf",conf as i64);
            if(conf==0){ bonus=2; }
        }
    }
    bid_row(led,hid,fire,216,bonus);
    lr_put(led,hid,48,conf);
    tr_cand(led,hid,"assertion");
    return;
}
// GEN 22: clarify (predicate mismatch). base 60.
fn gen_clarify(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    let fire:i32=0;
    let bonus:i32=0;
    let pm:i32=0;
    // fact-winner wiring (repair #5): deliberate on the winning fact
    // candidate via best_gated_fact (scans hid 10-12), never a private
    // re-retrieval. No winner -> wd=1 (nothing answerable).
    let fwh:i32=best_gated_fact(led);
    let fid3:i32=-1;
    let wd:i32=1;
    if(fwh>=0){
        fid3=lr_get(led,fwh,44);
        wd=lr_get(led,fwh,48);
    }
    // If no fact passed the gate, fall back to the top retrieved fact
    // (hid 10) for predicate-mismatch analysis. A gate==2 (predicate
    // mismatch) means the entity is known but the predicate wasn't taught
    // — clarify is appropriate, not withhold.
    if(fwh<0){
        let t10gate:i32=lr_get(led,10,48);
        let t10fid:i32=lr_get(led,10,44);
        if(t10gate==2 && t10fid>=0){
            fwh=10;
            fid3=t10fid;
            wd=2;
        }
    }
    let dq:[]u8=nio_alloc(16);
    default_query(ubuf,uo,ul,sal,pv,pqb,fm,fea,keya,vbytes,vent,linka,gnames,ge,gord,
        qbuf,eout,bout,kid,tmp,trb,st,out,dq);
    let ql3:i32=g32(dq,0) as i32;
    let bn:i32=g32(dq,4) as i32;
    let ne4:i32=g32(dq,8) as i32;
    let plen2:i32=g32(dq,12) as i32;
    nio_free(dq);
    if(wd!=0 && fid3>=0){
        let fr3:i32=8+fid3*40;
        let frko:i32=g32(fm,fr3+4) as i32;
        let frkl:i32=g32(fm,fr3+8) as i32;
        pm=pred_mismatch(vbytes,vent,kid,plen2,keya,frko,frkl,ne4,bn);
        if(pm==1){
            fire=1;
            rclr(ha);
            clarify_predicate(ha,fm,ftx,fea,gnames,ge,eout,ne4,bout,bn);
            sfx_sal_push_rev(hs,eout,ne4);
            let bk:i32=bn-1;
            while(bk>=0){ sfx_sal_push(hs,g32(bout,4+bk*4) as i32); bk=bk-1; }
            let wpe:i32=-1;
            if(ne4>0){ wpe=g32(eout,0) as i32; }
            if(wpe<0){ wpe=fact_primary(fm,fea,fid3); }
            let wrqo:i32=g32(pqb,0) as i32;
            sfx_pv(hs,12,wrqo); sfx_pv(hs,16,ul); sfx_pv(hs,20,wrqo+ul); sfx_pv(hs,24,ql3);
            p32(hs,440,2); p32(hs,444,ql3);
            copy_bytes(hqs,0,qbuf,0,ql3);
            sfx_pv(hs,0,-1); sfx_pv(hs,4,wpe); sfx_pv(hs,8,wpe); sfx_pv(hs,28,0);
            if(wpe>=0 && wpe!=top_peek(top)){ sfx_top(hs,1,wpe); }
            p32(hs,452,-1);
            // trace content: entity + quoted facts (mirror the selection)
            let eid:i32=-1;
            if(ne4>0){ eid=g32(eout,0) as i32; }
            if(eid<0 && bn>0){ eid=g32(bout,4) as i32; }
            let co:[]u8=lr_content(led,hid);
            c_init(co);
            c_lit_ns(co,"bid=clarify;ent=");
            c_ent(co,gnames,ge,eid);
            c_lit_ns(co,";facts=\"");
            let nf:i32=g32(fm,0) as i32;
            let shown:i32=0;
            let fx:i32=0;
            while(fx<nf && shown<3){
                let ro:i32=8+fx*40;
                let eo:i32=g32(fm,ro+24) as i32;
                let en:i32=g32(fm,ro+28) as i32;
                let k:i32=0;
                let hit:i32=0;
                while(k<en){
                    if((g32(fea,eo+k*4) as i32)==eid){ hit=1; }
                    k=k+1;
                }
                if(hit==1){
                    if(shown>0){ c_lit_ns(co," | "); }
                    c_raw(co,ftx,g32(fm,ro+16) as i32,g32(fm,ro+20) as i32);
                    shown=shown+1;
                }
                fx=fx+1;
            }
            c_lit_ns(co,"\";");
            bonus=1;
        }
    }
    bid_row(led,hid,fire,213,bonus);
    lr_put(led,hid,36,fid3);
    lr_put(led,hid,48,wd);
    tr_cand(led,hid,"clarify");
    return;
}
// GEN 23: withhold. base 40.
fn gen_withhold(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    let fire:i32=0;
    let bonus:i32=0;
    let pm:i32=0;
    // fact-winner wiring (repair #5): deliberate on the winning fact
    // candidate via best_gated_fact (scans hid 10-12), never a private
    // re-retrieval. No winner at all -> withhold fires as the safe
    // fallback (repair #8: the clarify/withhold/default partition always
    // yields a survivor, so ARGMAX never sees an empty field).
    let fwh:i32=best_gated_fact(led);
    let fid3:i32=-1;
    let wd:i32=1;
    if(fwh>=0){
        fid3=lr_get(led,fwh,44);
        wd=lr_get(led,fwh,48);
    }
    let dq:[]u8=nio_alloc(16);
    default_query(ubuf,uo,ul,sal,pv,pqb,fm,fea,keya,vbytes,vent,linka,gnames,ge,gord,
        qbuf,eout,bout,kid,tmp,trb,st,out,dq);
    let ql3:i32=g32(dq,0) as i32;
    let bn:i32=g32(dq,4) as i32;
    let ne4:i32=g32(dq,8) as i32;
    let plen2:i32=g32(dq,12) as i32;
    nio_free(dq);
    if(fid3<0){
        // no fact passed the gate. Withhold UNLESS the top retrieved fact
        // was gated for predicate mismatch (gate==2) with a named entity —
        // then clarify fires instead (order-independent check, mirrors
        // gen_clarify's fallback; keeps the partition airtight for K1).
        let t10gate:i32=lr_get(led,10,48);
        let t10fid:i32=lr_get(led,10,44);
        let clarifies:i32=0;
        if(t10gate==2 && t10fid>=0 && ne4>0){
            let fr10:i32=8+t10fid*40;
            let frko10:i32=g32(fm,fr10+4) as i32;
            let frkl10:i32=g32(fm,fr10+8) as i32;
            if(pred_mismatch(vbytes,vent,kid,plen2,keya,frko10,frkl10,ne4,bn)==1){ clarifies=1; }
        }
        if(clarifies==0){
            // no fact candidate at all: withhold is the honest answer.
            fire=1;
            rclr(ha);
            rput(ha,"I don't know.",0,13);
            sfx_sal_push_rev(hs,eout,ne4);
            // Set pv state (repair: sfx_init leaves pv offsets 4,8,20,24
            // stale; the correction shaper reads pv[8] next turn).
            let wpe0:i32=-1;
            if(ne4>0){ wpe0=g32(eout,0) as i32; }
            let wrqo0:i32=g32(pqb,0) as i32;
            sfx_pv(hs,0,-1); sfx_pv(hs,4,wpe0); sfx_pv(hs,8,wpe0);
            sfx_pv(hs,12,wrqo0); sfx_pv(hs,16,ul);
            sfx_pv(hs,20,wrqo0); sfx_pv(hs,24,ql3);
            sfx_pv(hs,28,0);
            p32(hs,440,2); p32(hs,444,ql3);
            copy_bytes(hqs,0,qbuf,0,ql3);
            p32(hs,452,-1);
            let co0:[]u8=lr_content(led,hid);
            c_init(co0);
            c_lit_ns(co0,"bid=withhold;nofact=1;");
            bonus=2;
        }
    } else {
        if(wd!=0){
            let fr3:i32=8+fid3*40;
            let frko:i32=g32(fm,fr3+4) as i32;
            let frkl:i32=g32(fm,fr3+8) as i32;
            pm=pred_mismatch(vbytes,vent,kid,plen2,keya,frko,frkl,ne4,bn);
            if(pm==0){
                fire=1;
                rclr(ha);
                rput(ha,"I don't know.",0,13);
                sfx_sal_push_rev(hs,eout,ne4);
                let bk:i32=bn-1;
                while(bk>=0){ sfx_sal_push(hs,g32(bout,4+bk*4) as i32); bk=bk-1; }
                let wpe:i32=-1;
                if(ne4>0){ wpe=g32(eout,0) as i32; }
                if(wpe<0){ wpe=fact_primary(fm,fea,fid3); }
                let wrqo:i32=g32(pqb,0) as i32;
                sfx_pv(hs,12,wrqo); sfx_pv(hs,16,ul); sfx_pv(hs,20,wrqo+ul); sfx_pv(hs,24,ql3);
                p32(hs,440,2); p32(hs,444,ql3);
                copy_bytes(hqs,0,qbuf,0,ql3);
                sfx_pv(hs,0,-1); sfx_pv(hs,4,wpe); sfx_pv(hs,8,wpe); sfx_pv(hs,28,0);
                if(wpe>=0 && wpe!=top_peek(top)){ sfx_top(hs,1,wpe); }
                p32(hs,452,-1);
                let co:[]u8=lr_content(led,hid);
                c_init(co);
                c_lit_ns(co,"bid=withhold;");
                c_kvn_ns(co,"gate",wd as i64);
                c_kvn_ns(co,"pm",pm as i64);
                c_kvn_ns(co,"fid",fid3 as i64);
                c_fact(co,fm,ftx,fid3);
                bonus=2;
            }
        } else {
            // Repair #11: the airtightness fallback (repair #8). Fires iff
            // default's kind-0 gate stands down: fact answerable, but the
            // utterance was read as a non-declinable special type
            // (resume/provenance/joke/memory/forget — hid 1,3,4,5,6), whose
            // GENs always fire when their reading fires and always outbid
            // this (every special base exceeds 210+2). In practice this
            // fires but never wins; it exists so ARGMAX can never see an
            // empty field even if the gate logic above is wrong.
            // NOTE: hs[440]/hs[444] take direct p32 (apply_winner reads
            // them via g32); sfx_pv routes into the pvl log and would make
            // apply_winner write pv[440] -> panic. (Caught 2026-09-27.)
            if(lr_get(led,9,12)==0 && lr_get(led,0,12)==0 && lr_get(led,2,12)==0 && lr_get(led,7,12)==0 && lr_get(led,8,12)==0){
                fire=1;
                rclr(ha);
                rput(ha,"I don't know.",0,13);
                sfx_sal_push_rev(hs,eout,ne4);
                let bkf:i32=bn-1;
                while(bkf>=0){ sfx_sal_push(hs,g32(bout,4+bkf*4) as i32); bkf=bkf-1; }
                let wpef:i32=-1;
                if(ne4>0){ wpef=g32(eout,0) as i32; }
                if(wpef<0){ wpef=fact_primary(fm,fea,fid3); }
                let wrqof:i32=g32(pqb,0) as i32;
                sfx_pv(hs,12,wrqof); sfx_pv(hs,16,ul); sfx_pv(hs,20,wrqof+ul); sfx_pv(hs,24,ql3);
                // NOTE: 440/444 take direct p32, not sfx_pv (sfx_pv routes
                // into the pvl log at hs[260..424]; apply_winner reads
                // g32(hs,440/444) directly — repair #11 fix).
                p32(hs,440,2); p32(hs,444,ql3);
                copy_bytes(hqs,0,qbuf,0,ql3);
                sfx_pv(hs,0,-1); sfx_pv(hs,4,wpef); sfx_pv(hs,8,wpef); sfx_pv(hs,28,0);
                if(wpef>=0 && wpef!=top_peek(top)){ sfx_top(hs,1,wpef); }
                p32(hs,452,-1);
                let cof:[]u8=lr_content(led,hid);
                c_init(cof);
                c_lit_ns(cof,"bid=withhold;plainfall=1;");
                c_fact(cof,fm,ftx,fid3);
                bonus=2;
            }
        }
    }
    bid_row(led,hid,fire,210,bonus);
    lr_put(led,hid,36,fid3);
    lr_put(led,hid,48,wd);
    tr_cand(led,hid,"withhold");
    return;
}
// GEN 24: default retrieval. base 20.
fn gen_default(led:[]u8,hid:i32,ha:[]u8,hqs:[]u8,hs:[]u8,ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,hist:[]u8,histb:[]u8,qbuf:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,kid:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,abuf:[]u8,nbuf:[]u8,fout:[]u8,last_fid:i32,done:[]u8)void {
    // per-GEN idempotence (repair #4): execute exactly once per turn.
    if(g32(done,hid*4)==1){ return; }
    p32(done,hid*4,1);
    sfx_init(hs);
    let fire:i32=0;
    let bonus:i32=0;
    // fact-winner wiring (repair #5): deliberate on the winning fact
    // candidate via best_gated_fact (scans hid 10-12), never a private
    // re-retrieval. No winner -> default cannot fire (repair #8: the
    // clarify/withhold/default partition still yields a survivor).
    let fwh:i32=best_gated_fact(led);
    let fid3:i32=-1;
    let wd:i32=1;
    if(fwh>=0){
        fid3=lr_get(led,fwh,44);
        wd=lr_get(led,fwh,48);
    }
    let dq:[]u8=nio_alloc(16);
    default_query(ubuf,uo,ul,sal,pv,pqb,fm,fea,keya,vbytes,vent,linka,gnames,ge,gord,
        qbuf,eout,bout,kid,tmp,trb,st,out,dq);
    let ql3:i32=g32(dq,0) as i32;
    let bn:i32=g32(dq,4) as i32;
    let ne4:i32=g32(dq,8) as i32;
    let plen2:i32=g32(dq,12) as i32;
    nio_free(dq);
    // Repair #11: default is the fact-backstop. It fires when a fact is
    // answerable (wd==0, fid3>=0) and the utterance was read as plain
    // (hid 9, none-of-the-above) or as a declinable special type
    // (correction/challenge/assertion/compose) whose dedicated handler may
    // decline (e.g. correction with no previous answer). Readings whose
    // handlers never decline when fired (resume/provenance/joke/memory/
    // forget) route to their own GENs. Every disjunct reads the shared
    // kind-0 ledger rows — neutering row 9 kills default on pure-plain
    // turns (neuter-causal, not decorative).
    let plain:i32=lr_get(led,9,12);
    let dr0:i32=lr_get(led,0,12);
    let dr2:i32=lr_get(led,2,12);
    let dr7:i32=lr_get(led,7,12);
    let dr8:i32=lr_get(led,8,12);
    if(wd==0 && fid3>=0 && (plain==1 || dr0==1 || dr2==1 || dr7==1 || dr8>0)){
        fire=1;
        rclr(ha);
        emit_fact(ha,fm,ftx,fid3);
        // "Yes." affirmation (repair #9): fires when the yes/no question
        // bound an entity (by name or pronoun). The old gate demanded
        // content_count>0 AND bn>0, which dropped the prefix for
        // "did TNN detect the sticker?" (named entity, no pronoun).
        if(starts_with(ubuf,uo,ul,"did ",4)==1 && (ne4>0 || bn>0)){
            let al:i32=g32(ha,0) as i32;
            let sh:i32=al;
            while(sh>0){
                ha[4+sh+5-1]=ha[4+sh-1];
                sh=sh-1;
            }
            ha[4]=89; ha[5]=101; ha[6]=115; ha[7]=46; ha[8]=32;
            p32(ha,0,al+5);
        }
        sfx_sal_push_rev(hs,eout,ne4);
        let bk:i32=bn-1;
        while(bk>=0){ sfx_sal_push(hs,g32(bout,4+bk*4) as i32); bk=bk-1; }
        sfx_sal_push_fact(hs,fm,fea,fid3);
        let pe3:i32=-1;
        if(ne4>0){ pe3=g32(eout,0) as i32; }
        if(pe3<0){ pe3=fact_primary(fm,fea,fid3); }
        let rqo:i32=g32(pqb,0) as i32;
        sfx_pv(hs,12,rqo); sfx_pv(hs,16,ul); sfx_pv(hs,20,rqo+ul); sfx_pv(hs,24,ql3);
        p32(hs,440,2); p32(hs,444,ql3);
        copy_bytes(hqs,0,qbuf,0,ql3);
        sfx_pv(hs,0,fid3); sfx_pv(hs,4,pe3); sfx_pv(hs,8,pe3); sfx_pv(hs,28,0);
        sfx_pv(hs,32,bn);
        if(pe3>=0 && pe3!=top_peek(top)){ sfx_top(hs,1,pe3); }
        p32(hs,452,fid3);
        let co:[]u8=lr_content(led,hid);
        c_init(co);
        c_lit_ns(co,"bid=default;");
        c_kvn_ns(co,"fid",fid3 as i64);
        c_kvn_ns(co,"bn",bn as i64);
        c_kvn_ns(co,"ne",ne4 as i64);
        c_kvn_ns(co,"plen",plen2 as i64);
        c_kvn_ns(co,"pe",pe3 as i64);
        c_fact(co,fm,ftx,fid3);
        if(bn>0){ bonus=bonus+2; }
        if(ne4>0){ bonus=bonus+1; }
    }
    // repair #5: no force-fire. If the gate failed or there is no fact
    // winner, default stays unfired and clarify/withhold decide.
    bid_row(led,hid,fire,207,bonus);
    lr_put(led,hid,36,fid3);
    lr_put(led,hid,48,wd);
    tr_cand(led,hid,"default");
    return;
}
// ---- ELIM / ARGMAX / ACT ----
// reason codes: 1=PRE_FAIL 2=GATE 3=OUTSCORED
fn reason_name(r:i32)[]u8 {
    if(r==1){ return "PRE_FAIL"; }
    if(r==2){ return "GATE"; }
    if(r==3){ return "OUTSCORED"; }
    return "-";
}
// ELIM: PRE_FAIL for unfired bids; GATE for fired bids with empty answers.
fn elim_phase(led:[]u8, habuf:[]u8)void {
    let h:i32=13;
    while(h<=24){
        let ha:[]u8=habuf[(h-13)*4096..(h-13)*4096+4096];
        let bid:i32=lr_get(led,h,12);
        if(bid==0){
            lr_put(led,h,8,1);
            lr_put(led,h,28,1);
            lr_put(led,h,32,0);
        } else {
            let alen:i32=g32(ha,0) as i32;
            if(alen<=0){
                lr_put(led,h,8,1);
                lr_put(led,h,28,2);
                lr_put(led,h,32,1);
            }
        }
        h=h+1;
    }
    return;
}
// ARGMAX: max score among status-0 survivors; lowest hid wins ties.
// Repair #1: the winner row is marked status 2 here (exactly one winner).
fn argmax_phase(led:[]u8)i32 {
    let best:i32=-1;
    let best_score:i32=-2000000000;
    let h:i32=13;
    while(h<=24){
        if((lr_get(led,h,8) as i32)==0){
            let s:i32=lr_get(led,h,24);
            if(best<0 || s>best_score || (s==best_score && h<best)){
                best=h;
                best_score=s;
            }
        }
        h=h+1;
    }
    if(best>=0){
        lr_put(led,best,8,2);
    }
    return best;
}
// mark non-winner survivors as OUTSCORED.
fn outscore_phase(led:[]u8, winner:i32)void {
    let h:i32=13;
    while(h<=24){
        if(h!=winner && (lr_get(led,h,8) as i32)==0){
            lr_put(led,h,8,1);
            lr_put(led,h,28,3);
            lr_put(led,h,32,winner);
        }
        h=h+1;
    }
    return;
}
// close_call: winner margin over best fired runner-up < 5.
// Repair #10: the flag is written to the ledger turn field (13812); the
// REVIEW emission is gated on reading that flag back.
fn close_call(led:[]u8, winner:i32)i32 {
    let cc:i32=0;
    if(winner>=0){
        let ws:i32=lr_get(led,winner,24);
        let second:i32=-2000000000;
        let runner:i32=-1;
        let h:i32=13;
        while(h<=24){
            if(h!=winner && (lr_get(led,h,12) as i32)==1){
                let s:i32=lr_get(led,h,24);
                if(s>second){ second=s; runner=h; }
            }
            h=h+1;
        }
        if(runner>=0 && ws-second<5){ cc=1; }
    }
    t_put(led,13812,cc);
    return cc;
}
fn runner_up(led:[]u8, winner:i32)i32 {
    let second:i32=-2000000000;
    let runner:i32=-1;
    let h:i32=13;
    while(h<=24){
        if(h!=winner && (lr_get(led,h,12) as i32)==1){
            let s:i32=lr_get(led,h,24);
            if(s>second){ second=s; runner=h; }
        }
        h=h+1;
    }
    return runner;
}
fn tr_hex(d:[]u8)void {
    let tmp:[]u8=nio_alloc(66);
    tmp[0]=91;
    let i:i32=0;
    while(i<32){
        let b:i32=d[i] as i32;
        let hi:i32=b/16;
        let lo:i32=b-16*hi;
        if(hi<10){ tmp[1+i*2]=(hi+48) as u8; } else { tmp[1+i*2]=(hi+87) as u8; }
        if(lo<10){ tmp[1+i*2+1]=(lo+48) as u8; } else { tmp[1+i*2+1]=(lo+87) as u8; }
        i=i+1;
    }
    tmp[65]=93;
    tr_pr(tmp[0..66]);
    nio_free(tmp);
    return;
}
// CONTENT hid=N phash=<sha256 hex of answer bytes> <content fields>
fn emit_content(led:[]u8, hid:i32, ha:[]u8)void {
    tr_pr("CONTENT hid=");
    tr_prn(hid as i64);
    tr_pr(" phash=");
    let alen:i32=g32(ha,0) as i32;
    let digest:[]u8=nio_alloc(32);
    let rc:i32=ns_sha256(ha[4..4+alen],digest);
    if(rc!=0){
        let z:i32=0;
        while(z<32){ digest[z]=0; z=z+1; }
    }
    tr_hex(digest);
    nio_free(digest);
    tr_pr(" ");
    let co:[]u8=lr_content(led,hid);
    let cl:i32=g32(co,0) as i32;
    tr_pr(co[4..4+cl]);
    tr_pr("\n");
    return;
}
fn emit_elim(led:[]u8)void {
    // repair #2: covers fact candidates (10..12) AND action bids (13..24);
    // called once, after OUTSCORED marking, so every ELIM row is traced.
    let h:i32=10;
    while(h<=24){
        if((lr_get(led,h,8) as i32)==1){
            tr_pr("ELIM hid=");
            tr_prn(h as i64);
            tr_pr(" reason=");
            tr_pr(reason_name(lr_get(led,h,28)));
            tr_pr(" detail=");
            tr_prn(lr_get(led,h,32) as i64);
            tr_pr(" score=");
            tr_prn(lr_get(led,h,24) as i64);
            tr_pr("\n");
        }
        h=h+1;
    }
    return;
}
// apply the winner's staged side effects (single ACT path).
fn apply_winner(hs:[]u8, sal:[]u8, top:[]u8, pv:[]u8, pqb:[]u8, hqs:[]u8,
    uc:[]u8, ubuf:[]u8, uo:i32, ul:i32, turn_no:i32)void {
    let ns:i32=g32(hs,0) as i32;
    let i:i32=0;
    while(i<ns){
        sal_push(sal,g32(hs,4+i*4) as i32);
        i=i+1;
    }
    let npv:i32=g32(hs,260) as i32;
    let j:i32=0;
    while(j<npv){
        let off:i32=g32(hs,264+j*8) as i32;
        let val:i32=g32(hs,264+j*8+4) as i32;
        p32(pv,off,val);
        j=j+1;
    }
    let op1:i32=g32(hs,424) as i32;
    let a1:i32=g32(hs,428) as i32;
    let op2:i32=g32(hs,432) as i32;
    let a2:i32=g32(hs,436) as i32;
    if(op1==1){ top_push(top,a1); }
    if(op1==2){ top_pop_to(top,a1); }
    if(op1==3){ top_pop1(top); }
    if(op2==1){ top_push(top,a2); }
    if(op2==2){ top_pop_to(top,a2); }
    if(op2==3){ top_pop1(top); }
    let mode:i32=g32(hs,440) as i32;
    let ql:i32=g32(hs,444) as i32;
    if(mode==1){
        let nqo:i32=g32(pqb,0) as i32;
        copy_bytes(pqb,nqo,hqs,0,ql);
        p32(pqb,0,nqo+ql);
    }
    if(mode==2){
        let rqo:i32=g32(pqb,0) as i32;
        copy_bytes(pqb,rqo,ubuf,uo,ul);
        copy_bytes(pqb,rqo+ul,hqs,0,ql);
        p32(pqb,0,rqo+ul+ql);
    }
    if((g32(hs,456) as i32)==1){
        let cturn:[]u8=nio_alloc(8);
        let coval:[]u8=nio_alloc(8);
        uclaim_check(uc,g32(hs,460) as i32,g32(hs,464) as i32,g32(hs,468) as i32,turn_no,cturn,coval);
        nio_free(cturn);
        nio_free(coval);
    }
    return;
}
// ---- new do_turn: GEN -> ELIM -> ARGMAX -> ACT ----
fn do_turn(ubuf:[]u8,uo:i32,ul:i32,turn_no:i32,sal:[]u8,top:[]u8,uc:[]u8,pv:[]u8,pqb:[]u8,fm:[]u8,fea:[]u8,ftx:[]u8,ftl:[]u8,keya:[]u8,kid:[]u8,vbytes:[]u8,vent:[]u8,linka:[]u8,tmp:[]u8,trb:[]u8,st:[]u8,out:[]u8,gnames:[]u8,ge:[]u8,gord:[]u8,resp:[]u8,hist:[]u8,histb:[]u8,eout:[]u8,eout2:[]u8,bout:[]u8,qbuf:[]u8,abuf:[]u8,nbuf:[]u8,novelf:[]u8,last_fid:i32,fout:[]u8)i32 {
    let led:[]u8=nio_alloc(led_sz());
    led_init(led,25);
    let habuf:[]u8=nio_alloc(49152);
    let hsbuf:[]u8=nio_alloc(6144);
    let hqsbuf:[]u8=nio_alloc(49152);
    // per-GEN idempotence flags (repair #4): 25 slots (one per hid) + spare.
    // Each GEN sets its slot on entry and returns early if already set, so
    // every GEN executes exactly once per turn in any call order.
    let done:[]u8=nio_alloc(128);
    let dz:i32=0;
    while(dz<128){ done[dz]=0; dz=dz+1; }
    // ---- GEN: readings (0..9) ----
    gen_readings(led,ubuf,uo,ul,abuf,done);
    // ---- GEN: fact candidates (10..12) ----
    gen_facts(led,ubuf,uo,ul,sal,pv,pqb,fm,fea,keya,vbytes,vent,linka,gnames,ge,gord,qbuf,eout,bout,kid,tmp,trb,st,out,fout,last_fid,done);
    // G2 compliance: NO separate fact ELIM/ARGMAX phase. All candidates
    // (readings, facts, actions) are generated before ANY elimination.
    // The clarify/withhold/default GENs select the best gated fact by
    // scanning hid 10-12 directly (no phase, no turn field).
    // ---- GEN: 12 action bids (13..24) ----
    gen_joke(led,13,habuf[0..4096],hqsbuf[0..4096],hsbuf[0..512],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_mem(led,14,habuf[4096..8192],hqsbuf[4096..8192],hsbuf[512..1024],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_forget(led,15,habuf[8192..12288],hqsbuf[8192..12288],hsbuf[1024..1536],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_correction(led,16,habuf[12288..16384],hqsbuf[12288..16384],hsbuf[1536..2048],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_resume(led,17,habuf[16384..20480],hqsbuf[16384..20480],hsbuf[2048..2560],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_compose(led,18,habuf[20480..24576],hqsbuf[20480..24576],hsbuf[2560..3072],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_challenge(led,19,habuf[24576..28672],hqsbuf[24576..28672],hsbuf[3072..3584],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_provenance(led,20,habuf[28672..32768],hqsbuf[28672..32768],hsbuf[3584..4096],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_assertion(led,21,habuf[32768..36864],hqsbuf[32768..36864],hsbuf[4096..4608],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_clarify(led,22,habuf[36864..40960],hqsbuf[36864..40960],hsbuf[4608..5120],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_withhold(led,23,habuf[40960..45056],hqsbuf[40960..45056],hsbuf[5120..5632],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    gen_default(led,24,habuf[45056..49152],hqsbuf[45056..49152],hsbuf[5632..6144],ubuf,uo,ul,turn_no,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,vbytes,vent,linka,gnames,ge,gord,hist,histb,qbuf,eout,eout2,bout,kid,tmp,trb,st,out,abuf,nbuf,fout,last_fid,done);
    // ---- ELIM (repair #2: computed eliminations before any ELIM trace) ----
    elim_phase(led,habuf);
    // ---- ARGMAX (repair #1: exactly one winner row marked status 2) ----
    let winner:i32=argmax_phase(led);
    outscore_phase(led,winner);
    let cc:i32=close_call(led,winner);
    // ---- ELIM trace: every eliminated row (facts 10..12 + actions 13..24),
    // emitted AFTER outscore so OUTSCORED rows are traced (repair #2).
    emit_elim(led);
    let runner:i32=runner_up(led,winner);
    // ---- ARGMAX trace (repair #3: hid= citation on ARGMAX/CLOSE/REVIEW) ----
    tr_pr("ARGMAX hid=");
    if(winner>=0){ tr_prn(winner as i64); } else { tr_pr("none"); }
    tr_pr(" score=");
    if(winner>=0){ tr_prn(lr_get(led,winner,24) as i64); } else { tr_prn(0); }
    tr_pr(" margin=");
    if(runner>=0){ tr_prn((lr_get(led,winner,24)-lr_get(led,runner,24)) as i64); }
    else { tr_prn(0); }
    tr_pr("\n");
    if(cc==1){
        let cm:i32=lr_get(led,winner,24)-lr_get(led,runner,24);
        tr_pr("CLOSE hid=");
        tr_prn(winner as i64);
        tr_pr(" margin=");
        tr_prn(cm as i64);
        tr_pr("\n");
        tr_pr("CONTENDER hid=");
        tr_prn(winner as i64);
        tr_pr(" score=");
        tr_prn(lr_get(led,winner,24) as i64);
        tr_pr("\n");
        tr_pr("CONTENDER hid=");
        tr_prn(runner as i64);
        tr_pr(" score=");
        tr_prn(lr_get(led,runner,24) as i64);
        tr_pr("\n");
        // REVIEW is gated on reading the ledger close-call flag back
        // (repair #10: flag-read-gated, not a re-derived local).
        if(t_get(led,13812)==1){
            tr_pr("REVIEW close_call hid=");
            tr_prn(winner as i64);
            tr_pr("\n");
        }
    }
    // ---- ACT: single winner-gated answer route (repairs #1, #8) ----
    // ACT locates the winner by its status-2 mark, never by trusting a
    // return value alone. The clarify/withhold/default partition guarantees
    // exactly one status-2 row every turn (default fires iff the fact gate
    // passed; else clarify xor withhold fires; withhold fires if there is
    // no fact at all), so this scan always succeeds and winner<0 is
    // unreachable — no negative indexing into the action buffers.
    let wact:i32=-1;
    let sh:i32=13;
    while(sh<=24){
        if(lr_get(led,sh,8)==2){ wact=sh; }
        sh=sh+1;
    }
    if(wact<0){ wact=winner; }
    // ---- CONTENT (winner + contenders expose full content) ----
    let wha:[]u8=habuf[(wact-13)*4096..(wact-13)*4096+4096];
    emit_content(led,wact,wha);
    if(cc==1){
        let rha:[]u8=habuf[(runner-13)*4096..(runner-13)*4096+4096];
        emit_content(led,runner,rha);
    }
    let whs:[]u8=hsbuf[(wact-13)*512..(wact-13)*512+512];
    let whqs:[]u8=hqsbuf[(wact-13)*4096..(wact-13)*4096+4096];
    apply_winner(whs,sal,top,pv,pqb,whqs,uc,ubuf,uo,ul,turn_no);
    rclr(resp);
    let walen:i32=g32(wha,0) as i32;
    copy_bytes(resp,0,wha,0,walen+4);
    // side-effect layout: novelty flag@448, return fid@452 (the old 432/436
    // reads hit the top-op fields — repair: read the staged values).
    let wnv:i32=g32(whs,448) as i32;
    p32(novelf,0,wnv);
    let wfid:i32=g32(whs,452) as i32;
    nio_free(led);
    nio_free(habuf);
    nio_free(hsbuf);
    nio_free(hqsbuf);
    nio_free(done);
    return wfid;
}

fn led_sz()i32 { return 13820; }
// turn fields (after 25 rows): fact-winner hid@13804 fact-close@13808
// act-close@13808+4=13812 spare@13816. 13804+16=13820.
fn stype_idx(t:[]u8,to:i32,tl:i32)i32 {
    if(tl==8 && beq2(t,to,"FOLLOWUP",0,8)==1){ return 0; }
    if(tl==10 && beq2(t,to,"CORRECTION",0,10)==1){ return 1; }
    if(tl==8 && beq2(t,to,"REFERENT",0,8)==1){ return 2; }
    if(tl==5 && beq2(t,to,"WEIRD",0,5)==1){ return 3; }
    if(tl==11 && beq2(t,to,"WEIRD_CLEAN",0,11)==1){ return 4; }
    if(tl==5 && beq2(t,to,"TOPIC",0,5)==1){ return 5; }
    if(tl==10 && beq2(t,to,"CONTRADICT",0,10)==1){ return 6; }
    if(tl==7 && beq2(t,to,"COMPOSE",0,7)==1){ return 7; }
    return -1;
}
fn pr_stype(i:i32)void {
    if(i==0){ pr("FOLLOWUP"); }
    if(i==1){ pr("CORRECTION"); }
    if(i==2){ pr("REFERENT"); }
    if(i==3){ pr("WEIRD"); }
    if(i==4){ pr("WEIRD_CLEAN"); }
    if(i==5){ pr("TOPIC"); }
    if(i==6){ pr("CONTRADICT"); }
    if(i==7){ pr("COMPOSE"); }
    return;
}

fn main()void {
    let vbytes:[]u8=nio_alloc(65536);
    let vent:[]u8=nio_alloc(8+2048*8);
    let linka:[]u8=nio_alloc(65536);
    let keya:[]u8=nio_alloc(65536);
    let tmp:[]u8=nio_alloc(256);
    let kid:[]u8=nio_alloc(4096);
    let trb:[]u8=nio_alloc(4096);
    let st:[]u8=nio_alloc(64);
    let out:[]u8=nio_alloc(64);
    let fm:[]u8=nio_alloc(8192);
    let ftx:[]u8=nio_alloc(8192);
    let ftl:[]u8=nio_alloc(8192);
    let fea:[]u8=nio_alloc(4096);
    let gnames:[]u8=nio_alloc(4096);
    let ge:[]u8=nio_alloc(2048);
    let gord:[]u8=nio_alloc(1024);
    let sal:[]u8=nio_alloc(64);
    let top:[]u8=nio_alloc(256);
    let uc:[]u8=nio_alloc(8192);
    let pv:[]u8=nio_alloc(64);
    let pqb:[]u8=nio_alloc(65536);
    let resp:[]u8=nio_alloc(1088);
    let hist:[]u8=nio_alloc(12288);
    let histb:[]u8=nio_alloc(65536);
    let dacc:[]u8=nio_alloc(131072);
    let eout:[]u8=nio_alloc(256);
    let eout2:[]u8=nio_alloc(256);
    let bout:[]u8=nio_alloc(256);
    let qbuf:[]u8=nio_alloc(4096);
    let abuf:[]u8=nio_alloc(32);
    let nbuf:[]u8=nio_alloc(64);
    let ubuf:[]u8=nio_alloc(4096);
    let pend:[]u8=nio_alloc(1088);
    let novelf:[]u8=nio_alloc(8);
    let fout:[]u8=nio_alloc(512);
    let spass:[]u8=nio_alloc(64);
    let stot:[]u8=nio_alloc(64);
    p32(vbytes,0,8); p32(vent,0,8); p32(linka,0,8); p32(keya,0,8);
    p32(ftx,0,8); p32(ftl,0,8); p32(fea,0,8);
    p32(gnames,0,8); p32(pqb,0,8); p32(histb,0,8); p32(dacc,0,8);
    gaz_install(gnames,ge,gord,"gaz.txt");
    let nf:i32=kb_install(fm,ftx,ftl,fea,vbytes,vent,linka,keya,gnames,ge,gord,"kb.txt",tmp,kid,trb,st,out,eout);
    pr("KB "); prn(nf as i64); pr(" ENT "); prn(g32(ge,0) as i64); prl("");
    let bat:[]u8=read_all("battery.txt");
    let bl:i32=bat.len;
    let p:i32=0;
    let did:[]u8=nio_alloc(64);
    let didl:i32=0;
    let stype:i32=-1;
    let turn:i32=0;
    let last_fid:i32=-1;
    while(p<bl){
        let ls:i32=p;
        while(p<bl && bat[p]!=10){ p=p+1; }
        let le:i32=p;
        if(p<bl){ p=p+1; }
        if(le>ls && bat[le-1]==13){ le=le-1; }
        if(le>ls){
            if(starts_with(bat,ls,le-ls,"DIALOGUE ",9)==1){
                let q2:i32=ls+9;
                let q3:i32=q2;
                while(q3<le && bat[q3]!=32){ q3=q3+1; }
                didl=q3-q2;
                copy_bytes(did,0,bat,q2,didl);
                stype=stype_idx(bat,q3+1,le-q3-1);
                turn=0;
                p32(sal,0,0); p32(top,0,0); p32(uc,0,0); p32(hist,0,0); p32(pqb,0,8); p32(histb,0,8); last_fid=-1;
                p32(pv,0,-1); p32(pv,28,1);
                pr("D "); prlen(did,didl); prl("");
            }
            if(starts_with(bat,ls,le-ls,"U ",2)==1){
                turn=turn+1;
                let ul2:i32=le-ls-2;
                let k5:i32=0;
                while(k5<ul2){ ubuf[k5]=to_low(bat[ls+2+k5]); k5=k5+1; }
                hist_add(hist,histb,0,ubuf,0,ul2);
                last_fid=do_turn(ubuf,0,ul2,turn,sal,top,uc,pv,pqb,fm,fea,ftx,ftl,keya,kid,vbytes,vent,linka,tmp,trb,st,out,gnames,ge,gord,resp,hist,histb,eout,eout2,bout,qbuf,abuf,nbuf,novelf,last_fid,fout);
                let rl3:i32=g32(resp,0) as i32;
                hist_add(hist,histb,1,resp,4,rl3);
                copy_bytes(pend,0,resp,0,rl3+4);
                let dl:i32=g32(dacc,0) as i32;
                copy_bytes(dacc,dl,resp,4,rl3);
                dacc[dl+rl3]=10;
                p32(dacc,0,dl+rl3+1);
                if((g32(novelf,0) as i32)==1){
                    pr("NOVEL=1 ");
                }
            }
            if(starts_with(bat,ls,le-ls,"E ",2)==1){
                let el2:i32=le-ls-2;
                let pl2:i32=g32(pend,0) as i32;
                let ok:i32=0;
                if(pl2==el2 && beq2(pend,4,bat,ls+2,el2)==1){ ok=1; }
                pr("T ");
                prlen(did,didl);
                pr(" ");
                prn(turn as i64);
                if(ok==1){ pr(" PASS"); }
                if(ok==0){ pr(" FAIL"); }
                prl("");
                pr("A ");
                prlen(pend[4..4+pl2],pl2);
                prl("");
                if(ok==0){
                    pr("X ");
                    prlen(bat[ls+2..ls+2+el2],el2);
                    prl("");
                }
                let si:i32=stype*8;
                p32(stot,si,(g32(stot,si) as i32)+1);
                if(ok==1){ p32(spass,si,(g32(spass,si) as i32)+1); }
            }
        }
    }
    let sx:i32=0;
    while(sx<8){
        pr("SECTION ");
        pr_stype(sx);
        pr(" ");
        prn(g32(spass,sx*8) as i64);
        pr("/");
        prn(g32(stot,sx*8) as i64);
        prl("");
        sx=sx+1;
    }
    let dg:[]u8=nio_alloc(64);
    let din:[]u8=dacc[4..4+(g32(dacc,0) as i32)];
    if(ns_sha256(din,dg)!=0){ prl("DIGEST-ERR"); }
    pr("DIGEST ");
    prhex(dg,0,32);
    prl("");
    return;
}

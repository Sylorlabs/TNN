// mech.zag — H5 monotonicity mechanism driver (Crew C).
//
// Runs the FROZEN harness deliberation (dlb_delib.zag, byte-identical copy)
// at a fixed depth per item, then applies one of 8 release rules (the
// monotonicity mechanism candidates from PREREG_MONOTONICITY.md §4 plus
// M6-DESIGN1 from the fable/native audit).
//
// Usage: mech <items.jsonl> <mech_id> <depth> <results.tsv>
//
// mech_id: 0=M0-DEGENERATE 1=M1-BCA 2=M2-RATCHET 3=M3-SCAFFOLD
//          4=M4-ABSTAIN 5=M5-REMAIN-0 6=M6-DESIGN1 7=BASELINE
//          8=M7-CLEANKILL (symmetric-kill release gate)
//
// Release rules use INDEX-LEVEL deliberation state only (leader indices,
// margins, alive sets, scores, evidence links) — never hypothesis id strings,
// never text, never ground truth (GT is read only to score after release).
//
// Per-item TSV record:
//   id \t depth \t t \t rounds \t consumed \t ne \t release \t correct
//   \t conf \t leader_idx \t cert
// release = hypothesis id, or ABSTAIN:<reason>. correct in {1,0,A}.

@import("R33_NATIVE_SHA256_V2.zag")
@import("dlb_util.zag")
@import("dlb_json.zag")
@import("dlb_cfg.zag")
@import("dlb_ledger.zag")
@import("dlb_delib.zag")

// ---- mechanism release rules ----
// Returns release hypothesis index, or -1 for ABSTAIN (reason in rsn).
// Sets *rconf to the mechanism-specific released confidence (0-1000):
//   M0: hist_c[1] (frozen depth-1 confidence); M1: hist_c[d*]; M2: hist_c[d**];
//   M3: st.conf if releasing L_t else winner-vs-rival margin from final scores;
//   M4/M5/M6/M7/BASELINE: st.conf (final leader confidence, or abstain).
fn mech_release(mech:i32,it:*Item,st:*DSt,t:i32,rsn:*DOut,rconf:*i32)i32 {
    if(t<1){
        dout_str(rsn,"no-deliberation");
        rconf.*=0;
        return -1;
    }
    let l1:i32=au_get32(st.*.hist_l,1);
    let lt:i32=au_get32(st.*.hist_l,t);
    // M0-DEGENERATE: always release index 0 (construction-exploit baseline)
    if(mech==0){
        dout_str(rsn,"index-hold");
        rconf.*=au_get32(st.*.hist_c,1);
        return 0;
    }
    // BASELINE: plain harness release (no mechanism)
    if(mech==7){
        dout_str(rsn,"none");
        rconf.*=st.*.conf;
        return lt;
    }
    // M1-BCA: best-certified-answer; cert = margin; ties -> earliest round
    if(mech==1){
        let br:i32=1;
        let bm:i64=au_get64(st.*.hist_m,1);
        let r:i32=2;
        while(r<=t){
            let m:i64=au_get64(st.*.hist_m,r);
            if(m>bm){bm=m;br=r;}
            r=r+1;
        }
        dout_str(rsn,"best-cert");
        rconf.*=au_get32(st.*.hist_c,br);
        return au_get32(st.*.hist_l,br);
    }
    // M2-RATCHET: strict-improvement ratchet, DELTA=100 (frozen)
    if(mech==2){
        let best:i32=-1;
        let bc:i64=-4000000000000000000;
        let br2:i32=1;
        let r:i32=1;
        while(r<=t){
            let m:i64=au_get64(st.*.hist_m,r);
            if(m>bc+100){bc=m;best=au_get32(st.*.hist_l,r);br2=r;}
            r=r+1;
        }
        dout_str(rsn,"ratchet");
        rconf.*=au_get32(st.*.hist_c,br2);
        return best;
    }
    // M3-SCAFFOLD: hold rel while alive; update only if rel eliminated AND
    // successor is sole survivor AND anti-beneficiary clause holds;
    // else audited abstain.
    if(mech==3){
        let rel:i32=l1;
        let alive:[]u8=st.*.alive;
        if(alive[rel]==1){
            dout_str(rsn,"hold-alive");
            if(rel==lt){
                rconf.*=st.*.conf;
            } else {
                // non-leader release: winner-vs-best-rival margin, clamped
                let sc:[]u8=st.*.scores;
                let sw:i64=au_get64(sc,rel);
                let bestrival:i64=-4000000000000000000;
                let hh:i32=0;
                while(hh<it.*.nh){
                    if(hh!=rel){
                        let s2:i64=au_get64(sc,hh);
                        if(s2>bestrival){bestrival=s2;}
                    }
                    hh=hh+1;
                }
                let mg:i64=sw-bestrival;
                if(mg<0){mg=0;}
                if(mg>1000){mg=1000;}
                rconf.*=mg as i32;
            }
            return rel;
        }
        let jp:i32=lt;
        let nh:i32=it.*.nh;
        let n:i32=0;
        let i:i32=0;
        while(i<nh){
            if(alive[i]==1){n=n+1;}
            i=i+1;
        }
        if(n!=1 || alive[jp]!=1){
            dout_str(rsn,"cert-fail");
            rconf.*=0;
            return -1;
        }
        let bad:i32=0;
        let e:i32=0;
        while(e<st.*.consumed && bad==0){
            let ar:i32=0;
            let sj:i32=0;
            let k:i32=0;
            let na:i32=dj_att_n(it,e);
            while(k<na){
                if(dj_att_h(it,e,k)==rel){ar=1;}
                k=k+1;
            }
            k=0;
            let ns:i32=dj_sup_n(it,e);
            while(k<ns){
                if(dj_sup_h(it,e,k)==jp){sj=1;}
                k=k+1;
            }
            if(ar==1 && sj==1){bad=1;}
            e=e+1;
        }
        if(bad==1){
            dout_str(rsn,"cert-fail-beneficiary");
            rconf.*=0;
            return -1;
        }
        dout_str(rsn,"update-certified");
        rconf.*=st.*.conf;
        return jp;
    }
    // M4-ABSTAIN: release the round-1 leader iff it still leads; else abstain.
    // Provably bar-safe: releases only the constant judgment L_1 or abstains.
    if(mech==4){
        if(lt==l1){
            dout_str(rsn,"leader-stable");
            rconf.*=st.*.conf;
            return lt;
        }
        dout_str(rsn,"leader-changed");
        rconf.*=0;
        return -1;
    }
    // M5-REMAIN-0: release iff all evidence consumed; else abstain.
    // Provably bar-safe: post-exhaustion leader is stable (leader immune to
    // ELIMINATE, TEST targets runner-up only), so at most one distinct
    // judgment is ever released per item.
    if(mech==5){
        if(st.*.consumed==it.*.ne){
            dout_str(rsn,"exhausted");
            rconf.*=st.*.conf;
            return lt;
        }
        dout_str(rsn,"evidence-remaining");
        rconf.*=0;
        return -1;
    }
    // M6-DESIGN1 (fable/native audit): certified-dominance release.
    // Release the exhaustion leader iff every elimination on the path passes
    // the re-admission audit: for each dead hypothesis h, its counterfactual
    // full-stream score h_wouldbe (as if never eliminated) must not exceed
    // the leader's actual score. Else audited abstain.
    // (Unflippability over the remaining stream is trivially satisfied at
    // exhaustion — the released leader IS the exhaustion leader — so the
    // audit is the operative certificate.)
    if(mech==6){
        if(st.*.consumed!=it.*.ne){
            dout_str(rsn,"evidence-remaining");
            rconf.*=0;
            return -1;
        }
        let nh:i32=it.*.nh;
        let alive:[]u8=st.*.alive;
        let lscore:i64=au_get64(st.*.scores,lt);
        let h:i32=0;
        while(h<nh){
            if(alive[h]==0){
                let wb:i64=0;
                let e:i32=0;
                while(e<st.*.consumed){
                    let k:i32=0;
                    let ns:i32=dj_sup_n(it,e);
                    while(k<ns){
                        if(dj_sup_h(it,e,k)==h){wb=wb+(dj_sup_w(it,e,k) as i64);}
                        k=k+1;
                    }
                    k=0;
                    let na:i32=dj_att_n(it,e);
                    while(k<na){
                        if(dj_att_h(it,e,k)==h){wb=wb-(dj_att_w(it,e,k) as i64);}
                        k=k+1;
                    }
                    e=e+1;
                }
                if(wb>lscore){
                    dout_str(rsn,"audit-fail");
                    rconf.*=0;
                    return -1;
                }
            }
            h=h+1;
        }
        dout_str(rsn,"certified-dominance");
        rconf.*=st.*.conf;
        return lt;
    }
    // M7-CLEANKILL (symmetric-kill release gate; Crew B actionable follow-up).
    // Release the exhaustion leader iff every elimination on the path was
    // "clean": each dead hypothesis h has counterfactual full-stream net
    // evidence h_wouldbe <= 0 (no positive case was killed). If any victim
    // had net positive evidence, the kill is suspect -> audited abstain.
    // (The objection kills only if itself validated: a kill is validated
    //  iff the victim was meritless.) Pre-exhaustion: abstain.
    // Provably bar-safe like M5 (releases at most one distinct judgment).
    if(mech==8){
        if(st.*.consumed!=it.*.ne){
            dout_str(rsn,"evidence-remaining");
            return -1;
        }
        let nh7:i32=it.*.nh;
        let alive7:[]u8=st.*.alive;
        let h7:i32=0;
        while(h7<nh7){
            if(alive7[h7]==0){
                let wb7:i64=0;
                let e7:i32=0;
                while(e7<st.*.consumed){
                    let k7:i32=0;
                    let ns7:i32=dj_sup_n(it,e7);
                    while(k7<ns7){
                        if(dj_sup_h(it,e7,k7)==h7){wb7=wb7+(dj_sup_w(it,e7,k7) as i64);}
                        k7=k7+1;
                    }
                    k7=0;
                    let na7:i32=dj_att_n(it,e7);
                    while(k7<na7){
                        if(dj_att_h(it,e7,k7)==h7){wb7=wb7-(dj_att_w(it,e7,k7) as i64);}
                        k7=k7+1;
                    }
                    e7=e7+1;
                }
                if(wb7>0){
                    dout_str(rsn,"unclean-kill");
                    rconf.*=0;
                    return -1;
                }
            }
            h7=h7+1;
        }
        dout_str(rsn,"clean-kill");
        rconf.*=st.*.conf;
        return lt;
    }
    dout_str(rsn,"unknown-mech");
    rconf.*=0;
    return -1;
}

fn mh_item_alloc(it:*Item)i32 {
    it.*.hid=nio_alloc(16*8);
    it.*.eid=nio_alloc(64*8);
    it.*.evns=nio_alloc(64*4);
    it.*.evna=nio_alloc(64*4);
    it.*.sup=nio_alloc(64*16*8);
    it.*.att=nio_alloc(64*16*8);
    if(it.*.hid.len==0 || it.*.eid.len==0){return -1;}
    return 0;
}
fn mh_item_free(it:*Item)void {
    nio_free(it.*.hid);nio_free(it.*.eid);nio_free(it.*.evns);nio_free(it.*.evna);
    nio_free(it.*.sup);nio_free(it.*.att);
}
fn mh_st_alloc(st:*DSt,hcap:i32)i32 {
    st.*.scores=nio_alloc(16*8);
    st.*.alive=nio_alloc(16);
    st.*.hist_l=nio_alloc(hcap*4);
    st.*.hist_m=nio_alloc(hcap*8);
    st.*.hist_c=nio_alloc(hcap*4);
    st.*.hcap=hcap;
    if(st.*.scores.len==0 || st.*.alive.len==0){return -1;}
    return 0;
}
fn mh_st_free(st:*DSt)void {
    nio_free(st.*.scores);nio_free(st.*.alive);
    nio_free(st.*.hist_l);nio_free(st.*.hist_m);nio_free(st.*.hist_c);
}

fn mh_emit(res:*DOut,it:*Item,st:*DSt,mech:i32,depth:i32,t:i32,rel:i32,rconf:i32,rsn:*DOut)void {
    dout_str(res,dj_id(it));
    dout_byte(res,9);
    dout_i64(res,depth as i64);
    dout_byte(res,9);
    dout_i64(res,t as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.rounds as i64);
    dout_byte(res,9);
    dout_i64(res,st.*.consumed as i64);
    dout_byte(res,9);
    dout_i64(res,it.*.ne as i64);
    dout_byte(res,9);
    if(rel<0){
        dout_str(res,"ABSTAIN:");
        dout_str(res,dout_bytes(rsn));
    }
    if(rel>=0){
        dout_str(res,dj_hid(it,rel));
    }
    dout_byte(res,9);
    if(rel<0){
        dout_str(res,"A");
    }
    if(rel>=0){
        if(dlb_streq(dj_hid(it,rel),dj_gt(it))==1){dout_str(res,"1");}
        if(dlb_streq(dj_hid(it,rel),dj_gt(it))!=1){dout_str(res,"0");}
    }
    dout_byte(res,9);
    dout_i64(res,rconf as i64);
    dout_byte(res,9);
    dout_i64(res,au_get32(st.*.hist_l,t) as i64);
    dout_byte(res,9);
    dout_str(res,dout_bytes(rsn));
    dout_line(res);
}

fn mh_run(items_path:[]u8,mech:i32,depth:i32,res_path:[]u8)i32 {
    let ibuf:[]u8=nio_alloc(4194304);
    if(ibuf.len==0){return 102;}
    let bn:i64=dlb_read_file(items_path,ibuf);
    if(bn<0){nio_free(ibuf);return 102;}
    let blen:i32=bn as i32;
    // fixed deliberation config: mode=0 (fixed), frozen constants
    let cfg:DCfg=DCfg{.mode:0,.shallow_rounds:depth,.deep_rounds:depth,.amin:3,.amax:64,.conf_thr:0,.stab_win:0,.eps:20,.elim_margin:900,.refute_thr:600,.evcap:64};
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(mh_item_alloc(&it)!=0){nio_free(ibuf);return 102;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.hist_c:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:68};
    if(mh_st_alloc(&st,68)!=0){mh_item_free(&it);nio_free(ibuf);return 102;}
    let res:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&res,4194304)!=0){return 102;}
    if(dout_init(&lgo,8388608)!=0){return 102;}
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    if(lg_init(&lg)!=0){return 102;}
    let rsn:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&rsn,256)!=0){return 102;}
    let ok:i32=1;
    let errs:i32=0;
    let pos:i32=0;
    let lineno:i32=0;
    while(pos<blen && ok==1){
        let e:i32=pos;
        while(e<blen && ibuf[e]!=10){e=e+1;}
        lineno=lineno+1;
        let line:[]u8=ibuf[pos..e];
        if(line.len>0 && line[line.len-1]==13){line=line[0..line.len-1];}
        if(line.len>0 && line.len<=65536){
            let prc:i32=dj_parse_item(&it,line,16,64,16);
            if(prc!=0){
                errs=errs+1;
            }
            if(prc==0){
                let drc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
                if(drc!=0){ok=0;}
                if(drc==0){
                    let t:i32=depth;
                    if(st.rounds<t){t=st.rounds;}
                    rsn.n=0;
                    rsn.err=0;
                    let rconf:i32=0;
                    let rel:i32=mech_release(mech,&it,&st,t,&rsn,&rconf);
                    mh_emit(&res,&it,&st,mech,depth,t,rel,rconf,&rsn);
                    if(res.err!=0){ok=0;}
                    if(lgo.err!=0){ok=0;}
                }
            }
        }
        pos=e+1;
    }
    let wrc:i64=0;
    if(ok==1 && res.err==0){
        wrc=dlb_write_file(res_path,dout_bytes(&res),res.n);
    }
    nio_free(ibuf);
    mh_item_free(&it);
    mh_st_free(&st);
    dout_free(&res);
    dout_free(&lgo);
    dout_free(&rsn);
    lg_free(&lg);
    if(ok==0 || wrc<0){return 103;}
    return errs;
}

fn main()i32 {
    if(_zag_argc()<5){
        _zag_println("usage: mech <items.jsonl> <mech_id> <depth> <results.tsv>");
        return 64;
    }
    // NOTE: _zag_arg returns a non-owned slice; never free it.
    let mech:i32=dlb_atoi(_zag_arg(2));
    let depth:i32=dlb_atoi(_zag_arg(3));
    if(mech<0 || mech>8){return 64;}
    if(depth<1 || depth>64){return 64;}
    return mh_run(_zag_arg(1),mech,depth,_zag_arg(4));
}

@import("../build/R33_NATIVE_SHA256_V2.zag")
// audit_seal.zag — seal-tail idempotency test at scale.
// usage: audit_seal <storedir>
// Loads the sealed store, records (nsealed, seal), then:
//   (i)  calls the INGEST sc_seal_tail (verbatim from frozen build/ingest.zag)
//   (ii) reloads fresh and calls the CANONICAL sc_seal_tail from
//        ops/storage-compression/adopt/s5_store.zag (with the 7303b6db
//        idempotency guard: if(n/cs < nsealed) return 0)
// Reports nsealed + seal hex after each call. Idempotent = unchanged.
// Pure Zag. Zero RNG.
fn au_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn au_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let b:[]u8=au_alloc(n+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return b;
}
fn au_open_rdonly(path:[]u8)i64 {
    let c:[]u8=au_cstr(path);
    if(c.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
fn au_close(fd:i64)void {_zag_raw_syscall(3,fd,0,0,0,0,0);}
fn au_read_into(fd:i64,buf:[]u8)i32 {
    if(buf.len<1){return -1;}
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<0){return -1;}
        if(n==0){break;}
        at=at+(n as i32);
    }
    return at;
}
fn au_g32(b:[]u8,o:i32)i32 {
    let v:i32=0;
    v=v|((b[o] as i32)&255);
    v=v|(((b[o+1] as i32)&255)<<8);
    v=v|(((b[o+2] as i32)&255)<<16);
    v=v|(((b[o+3] as i32)&255)<<24);
    return v;
}
fn au_s32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
}
fn au_g64(b:[]u8,o:i64)i64 {
    let o32:i32=o as i32;
    let v:i64=0;
    v=v|((b[o32] as i64)&255);
    v=v|(((b[o32+1] as i64)&255)<<8);
    v=v|(((b[o32+2] as i64)&255)<<16);
    v=v|(((b[o32+3] as i64)&255)<<24);
    v=v|(((b[o32+4] as i64)&255)<<32);
    v=v|(((b[o32+5] as i64)&255)<<40);
    v=v|(((b[o32+6] as i64)&255)<<48);
    v=v|(((b[o32+7] as i64)&255)<<56);
    return v;
}
fn au_s64(b:[]u8,o:i64,v:i64)void {
    let o32:i32=o as i32;
    b[o32]=(v&255) as u8;
    b[o32+1]=((v>>8)&255) as u8;
    b[o32+2]=((v>>16)&255) as u8;
    b[o32+3]=((v>>24)&255) as u8;
    b[o32+4]=((v>>32)&255) as u8;
    b[o32+5]=((v>>40)&255) as u8;
    b[o32+6]=((v>>48)&255) as u8;
    b[o32+7]=((v>>56)&255) as u8;
}
fn au_print(s:[]u8)void {_zag_print(s);}
fn au_println(s:[]u8)void {_zag_println(s);}
fn au_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}
fn au_join(dir:[]u8,name:[]u8)[]u8 {
    let b:[]u8=au_alloc(dir.len+1+name.len);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<dir.len){b[i]=dir[i];i=i+1;}
    b[dir.len]=47;
    i=0;
    while(i<name.len){b[dir.len+1+i]=name[i];i=i+1;}
    return b;
}
fn au_hex32(src:[]u8,dst:[]u8)void {
    let i:i32=0;
    while(i<32){
        let v:i32=(src[i] as i32)&255;
        let hi:i32=(v>>4)&15;
        let lo:i32=v&15;
        if(hi<10){dst[i*2]=(48+hi) as u8;}else{dst[i*2]=(87+hi) as u8;}
        if(lo<10){dst[i*2+1]=(48+lo) as u8;}else{dst[i*2+1]=(87+lo) as u8;}
        i=i+1;
    }
}
struct AuStore {
    cap:i32, n:i32,
    nchunks:i32, chunk_ptrs:[]u8,
    chain:[]u8, nsealed:i32,
    events:[]u8, events_n:i32, events_cap:i32,
    seal:[]u8, chain_scratch:[]u8,
    fill_buf:[]u8, widths:[]u8, clkbase:[]u8,
    learn_gate:i32, clock:i32
}
fn au_store_init_for_load(cap:i32,s:*AuStore)i32 {
    let nchunks:i32=(cap+4095)/4096;
    let cptrs:[]u8=au_alloc(nchunks*8);
    if(cptrs.len==0){return -1;}
    let chn:[]u8=au_alloc(nchunks*32);
    if(chn.len==0){return -1;}
    let evb:[]u8=au_alloc(256*16);
    if(evb.len==0){return -1;}
    let sl:[]u8=au_alloc(32);
    if(sl.len==0){return -1;}
    let scr:[]u8=au_alloc(49184);
    if(scr.len==0){return -1;}
    s.*.cap=cap;s.*.n=0;
    s.*.nchunks=nchunks;s.*.chunk_ptrs=cptrs;
    s.*.chain=chn;s.*.nsealed=0;
    s.*.events=evb;s.*.events_n=0;s.*.events_cap=256;
    s.*.seal=sl;s.*.chain_scratch=scr;
    let fb:[]u8=au_alloc(49152);
    if(fb.len==0){return -1;}
    let wd:[]u8=au_alloc(nchunks);
    if(wd.len==0){return -1;}
    s.*.fill_buf=fb;s.*.widths=wd;
    let ckb:[]u8=au_alloc(nchunks*4);
    if(ckb.len==0){return -1;}
    let ci:i32=0;
    while(ci<nchunks*4){ckb[ci]=255;ci=ci+1;}
    s.*.clkbase=ckb;
    s.*.learn_gate=1;s.*.clock=0;
    return 0;
}
fn au_slot_chunk(s:*AuStore,c:i32)[]u8 {
    if(c==s.*.nsealed){
        return s.*.fill_buf;
    }
    let ptrs:[]u8=s.*.chunk_ptrs;
    let p:i64=au_g64(ptrs,c*8);
    let cp:*u8=p as *u8;
    let wtag:i32=(s.*.widths[c] as i32)&255;
    let w:i32=wtag&15;
    return cp[0..4096*(w+4)];
}
fn au_event_grow(s:*AuStore)i32 {
    let cap:i32=s.*.events_cap;
    let ncap:i32=cap*2;
    let nb:[]u8=au_alloc(ncap*16);
    if(nb.len==0){return -1;}
    let ob:[]u8=s.*.events;
    let i:i32=0;
    let nn:i32=s.*.events_n*16;
    while(i<nn){nb[i]=ob[i];i=i+1;}
    s.*.events=nb;s.*.events_cap=ncap;
    return 0;
}
fn au_store_load(s:*AuStore,btotal:*i64,bnchunk:*i32,brecs:*i64,dir:[]u8)i32 {
    let nm:[]u8=au_join(dir,"store.dat");
    if(nm.len==0){return -1;}
    let fd:i64=au_open_rdonly(nm);
    if(fd<0){return -1;}
    let hdr:[]u8=au_alloc(28);
    if(hdr.len==0){au_close(fd);return -1;}
    if(au_read_into(fd,hdr)!=28){au_close(fd);return -1;}
    if(hdr[0]!=73||hdr[1]!=71||hdr[2]!=78||hdr[3]!=83||hdr[4]!=84){au_close(fd);return -1;}
    let ncap:i32=au_g32(hdr,8);
    let n:i32=au_g32(hdr,12);
    let nsealed:i32=au_g32(hdr,16);
    let nchunks:i32=au_g32(hdr,20);
    let clock:i32=au_g32(hdr,24);
    if(au_store_init_for_load(ncap,s)!=0){au_close(fd);return -1;}
    let wd:[]u8=s.*.widths;
    if(au_read_into(fd,wd[0..nchunks])!=nchunks){au_close(fd);return -1;}
    let cptrs:[]u8=s.*.chunk_ptrs;
    let c:i32=0;
    while(c<nsealed){
        let lb:[]u8=au_alloc(4);
        if(lb.len==0){au_close(fd);return -1;}
        if(au_read_into(fd,lb)!=4){au_close(fd);return -1;}
        let len:i32=au_g32(lb,0);
        let cc:[]u8=au_alloc(len);
        if(cc.len==0){au_close(fd);return -1;}
        if(au_read_into(fd,cc)!=len){au_close(fd);return -1;}
        au_s64(cptrs,c*8,_zag_slice_ptr(cc) as i64);
        c=c+1;
    }
    s.*.n=n;
    s.*.nsealed=nsealed;
    s.*.clock=clock;
    let chn:[]u8=s.*.chain;
    if(au_read_into(fd,chn[0..nsealed*32])!=nsealed*32){au_close(fd);return -1;}
    let enb:[]u8=au_alloc(4);
    if(enb.len==0){au_close(fd);return -1;}
    if(au_read_into(fd,enb)!=4){au_close(fd);return -1;}
    let evn:i32=au_g32(enb,0);
    while(s.*.events_cap<evn){
        if(au_event_grow(s)!=0){au_close(fd);return -1;}
    }
    let ev:[]u8=s.*.events;
    if(au_read_into(fd,ev[0..evn*16])!=evn*16){au_close(fd);return -1;}
    s.*.events_n=evn;
    let sl:[]u8=s.*.seal;
    if(au_read_into(fd,sl)!=32){au_close(fd);return -1;}
    let tail:[]u8=au_alloc(20);
    if(tail.len==0){au_close(fd);return -1;}
    if(au_read_into(fd,tail)!=20){au_close(fd);return -1;}
    btotal.*=au_g64(tail,0);
    bnchunk.*=au_g32(tail,8);
    brecs.*=au_g64(tail,12);
    au_close(fd);
    return 0;
}
fn au_wval(b:[]u8,o:i32,v:i64,w:i32)void {
    if(w==8){au_s64(b,o as i64,v);return;}
    if(w==4){au_s32(b,o,v as i32);return;}
    if(w==2){b[o]=(v&255) as u8;b[o+1]=((v>>8)&255) as u8;return;}
    b[o]=(v&255) as u8;
}
fn au_pick_width(mn:i64,mx:i64)i32 {
    let signed:i32=0;
    if(mn<0){signed=16;}
    let w:i32=8;
    if(signed==0){
        if(mx<=255){w=1;}
        else{
            if(mx<=65535){w=2;}
            else{
                if(mx<=4294967295){w=4;}
            }
        }
    }else{
        if(mn>=-128&&mx<=127){w=1;}
        else{
            if(mn>=-32768&&mx<=32767){w=2;}
            else{
                if(mn>=-2147483648&&mx<=2147483647){w=4;}
            }
        }
    }
    return w|signed;
}
fn au_compact_and_seal(s:*AuStore,c:i32,count:i32)i32 {
    let fb:[]u8=s.*.fill_buf;
    let mn:i64=0; let mx:i64=0;
    let k:i32=0;
    if(count>0){
        mn=au_g64(fb,0); mx=mn;
        k=1;
        while(k<count){
            let v:i64=au_g64(fb,(k*8) as i64);
            if(v<mn){mn=v;}
            if(v>mx){mx=v;}
            k=k+1;
        }
    }
    let wtag:i32=au_pick_width(mn,mx);
    let w:i32=wtag&15;
    let csize:i32=4096*(w+4);
    let cc:[]u8=au_alloc(csize);
    if(cc.len==0){return -1;}
    let moff:i32=4096*w;
    k=0;
    while(k<count){
        let v:i64=au_g64(fb,(k*8) as i64);
        au_wval(cc,k*w,v,w);
        let m:i32=32768+k*4;
        cc[moff+k*4]=fb[m];cc[moff+k*4+1]=fb[m+1];
        cc[moff+k*4+2]=fb[m+2];cc[moff+k*4+3]=fb[m+3];
        k=k+1;
    }
    let cptrs:[]u8=s.*.chunk_ptrs;
    au_s64(cptrs,c*8,_zag_slice_ptr(cc) as i64);
    let wd:[]u8=s.*.widths;
    wd[c]=wtag as u8;
    let used:i32=count*(w+4);
    let scr:[]u8=s.*.chain_scratch;
    let chn:[]u8=s.*.chain;
    let i:i32=0;
    if(c>0){
        while(i<32){scr[i]=chn[(c-1)*32+i];i=i+1;}
    }else{
        while(i<32){scr[i]=0;i=i+1;}
    }
    i=0;
    while(i<used){scr[32+i]=cc[i];i=i+1;}
    let out:[]u8=au_alloc(32);
    if(out.len==0){return -1;}
    if(ns_sha256(scr[0..32+used],out)!=0){return -2;}
    i=0;
    while(i<32){chn[c*32+i]=out[i];i=i+1;}
    s.*.nsealed=s.*.nsealed+1;
    return 0;
}
// INGEST version (verbatim from frozen build/ingest.zag:521): NO nsealed guard.
fn au_seal_tail_ingest(s:*AuStore)i32 {
    let n:i32=s.*.n;
    if(n%4096==0){return 0;}
    return au_compact_and_seal(s,n/4096,n%4096);
}
// CANONICAL version (adopt/s5_store.zag:395, with 7303b6db idempotency guard).
fn au_seal_tail_canon(s:*AuStore)i32 {
    let cs:i32=4096;
    let n:i32=s.*.n;
    if(n%cs==0){return 0;}
    if(n/cs<s.*.nsealed){return 0;}
    return au_compact_and_seal(s,n/cs,n%cs);
}
fn au_report_state(tag:[]u8,s:*AuStore)void {
    let hx:[]u8=au_alloc(64);
    au_hex32(s.*.seal,hx);
    au_print(tag);
    au_print(" n=");
    au_print(au_i64s(s.*.n as i64));
    au_print(" nsealed=");
    au_print(au_i64s(s.*.nsealed as i64));
    au_print(" seal=");
    au_print(hx);
    au_println("");
}
fn main()void {
    let dir:[]u8=_zag_arg(1);
    if(dir.len==0){au_println("usage: audit_seal <storedir>");return;}
    let s:AuStore=AuStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .chain="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.chain_scratch="",.fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0};
    let bt:i64=0; let bc:i32=0; let br:i64=0;
    if(au_store_load(&s,&bt,&bc,&br,dir)!=0){au_println("load failed");return;}
    au_report_state("BASELINE", &s);
    let rc:i32=au_seal_tail_ingest(&s);
    au_print("ingest seal_tail rc=");
    au_print(au_i64s(rc as i64));
    au_println("");
    au_report_state("AFTER-INGEST-SEALTAIL", &s);
    // fresh load for the canonical test
    let s2:AuStore=AuStore{.cap=0,.n=0,.nchunks=0,.chunk_ptrs="",
        .chain="",.nsealed=0,.events="",.events_n=0,.events_cap=0,
        .seal="",.chain_scratch="",.fill_buf="",.widths="",.clkbase="",
        .learn_gate=0,.clock=0};
    let bt2:i64=0; let bc2:i32=0; let br2:i64=0;
    if(au_store_load(&s2,&bt2,&bc2,&br2,dir)!=0){au_println("reload failed");return;}
    let rc2:i32=au_seal_tail_canon(&s2);
    au_print("canon seal_tail rc=");
    au_print(au_i64s(rc2 as i64));
    au_println("");
    au_report_state("AFTER-CANON-SEALTAIL", &s2);
}

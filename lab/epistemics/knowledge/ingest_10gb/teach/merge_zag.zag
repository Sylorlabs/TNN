// merge_zag.zag — pure-Zag k-way merge of key-sorted facts.dat shards.
//
// Usage: merge_zag <out.dat> <shard1.dat> <shard2.dat> [...]
// Record layout: [1B kind][2B key_len BE][4B text_len BE][key][text]
// Merge order: (key_bytes ascending, shard_index ascending) — byte-identical
// to merge_facts.py (heap on (key, shard_index)). Zero RNG. Deterministic.
//
// No SHA256 here: hash the output with sha256sum afterwards (the .sha256
// file is provenance, not part of the merged bytes).
//
// Shard count is discovered by reading _zag_arg(n) until "" (argc is
// unreliable in this znc build). Max 16 shards.

fn sc_alloc(n:i32)[]u8 {
    if(n<1){let e:[]u8="";return e;}
    let p:*u8=_zag_malloc(n as i64) as *u8;
    if((p as i64)==0){let e2:[]u8="";return e2;}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}
fn z_cstr(s:[]u8)[]u8 {
    let n:i32=s.len;
    let b:[]u8=sc_alloc(n+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return b;
}
fn mg_open_rdonly(path:[]u8)i64 {
    let c:[]u8=z_cstr(path);
    if(c.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),0,0,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
fn mg_open_write(path:[]u8)i64 {
    let c:[]u8=z_cstr(path);
    if(c.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
    _zag_free(_zag_slice_ptr(c));
    return fd;
}
fn mg_close(fd:i64)void {_zag_raw_syscall(3,fd,0,0,0,0,0);}
fn mg_read(fd:i64,buf:[]u8,at:i32,want:i32)i32 {
    let got:i32=0;
    while(got<want){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+((at+got) as i64),((want-got) as i64),0,0,0);
        if(n==-4){continue;}
        if(n<0){return -1;}
        if(n==0){break;}
        got=got+(n as i32);
    }
    return got;
}
fn mg_write(fd:i64,buf:[]u8,at:i32,want:i32)i32 {
    let done:i32=0;
    while(done<want){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(buf) as i64)+((at+done) as i64),((want-done) as i64),0,0,0);
        if(n==-4){continue;}
        if(n<=0){return -1;}
        done=done+(n as i32);
    }
    return 0;
}
// Ensure `need` bytes are available in buf. Returns the byte offset in buf
// where the need bytes start, or -1 on EOF-short, -2 on read error.
// Updates blen[s]/bpos[s]: if no I/O was needed the offset is the old bpos
// (no shift); if compaction+I/O happened the data is at [0..] and bpos=0.
// The caller MUST parse at the returned offset, not at buf[0].
fn mg_ensure(fd:i64,buf:[]u8,s:i32,blen:[]u8,bpos:[]u8,need:i32)i32 {
    let cb:i32=mg_get_i32(blen,s);
    let cp:i32=mg_get_i32(bpos,s);
    let avail:i32=cb-cp;
    if(avail>=need){
        return cp;
    }
    let i:i32=0;
    while(i<avail){buf[i]=buf[cp+i];i=i+1;}
    let wpos:i32=avail;
    while(wpos<need){
        if(wpos>=buf.len){return -1;}
        let g:i32=mg_read(fd,buf,wpos,buf.len-wpos);
        if(g<0){return -2;}
        if(g==0){break;}
        wpos=wpos+g;
    }
    mg_set_i32(blen,s,wpos);
    mg_set_i32(bpos,s,0);
    if(wpos<need){return -1;}
    return 0;
}
fn mg_key_cmp(a:[]u8,alen:i32,b:[]u8,blen:i32)i32 {
    let n:i32=alen;
    if(blen<n){n=blen;}
    let i:i32=0;
    while(i<n){
        let x:i32=(a[i] as i32)&255;
        let y:i32=(b[i] as i32)&255;
        if(x<y){return -1;}
        if(x>y){return 1;}
        i=i+1;
    }
    if(alen<blen){return -1;}
    if(alen>blen){return 1;}
    return 0;
}
fn mg_get_fd(fds:[]u8,i:i32)i64 {
    let fb:i32=i*8;
    let fd:i64=(fds[fb] as i64)&255;
    fd=fd|((((fds[fb+1] as i64)&255))<<8);
    fd=fd|((((fds[fb+2] as i64)&255))<<16);
    fd=fd|((((fds[fb+3] as i64)&255))<<24);
    fd=fd|((((fds[fb+4] as i64)&255))<<32);
    fd=fd|((((fds[fb+5] as i64)&255))<<40);
    fd=fd|((((fds[fb+6] as i64)&255))<<48);
    fd=fd|((((fds[fb+7] as i64)&255))<<56);
    return fd;
}
fn mg_set_fd(fds:[]u8,i:i32,fd:i64)void {
    let fb:i32=i*8;
    fds[fb]=(fd&255) as u8; fds[fb+1]=((fd>>8)&255) as u8;
    fds[fb+2]=((fd>>16)&255) as u8; fds[fb+3]=((fd>>24)&255) as u8;
    fds[fb+4]=((fd>>32)&255) as u8; fds[fb+5]=((fd>>40)&255) as u8;
    fds[fb+6]=((fd>>48)&255) as u8; fds[fb+7]=((fd>>56)&255) as u8;
    return;
}
fn mg_get_i32(a:[]u8,i:i32)i32 {
    let b:i32=i*4;
    let v:i32=(a[b] as i32)&255;
    v=v|((((a[b+1] as i32)&255))<<8);
    v=v|((((a[b+2] as i32)&255))<<16);
    v=v|((((a[b+3] as i32)&255))<<24);
    return v;
}
fn mg_set_i32(a:[]u8,i:i32,v:i32)void {
    let b:i32=i*4;
    a[b]=(v&255) as u8; a[b+1]=((v>>8)&255) as u8;
    a[b+2]=((v>>16)&255) as u8; a[b+3]=((v>>24)&255) as u8;
    return;
}
// Load the next head record for shard s into the rec arena.
// Returns 1 if a record was loaded, 0 at clean EOF, -1 on error.
fn mg_prime(s:i32,fds:[]u8,bufs:[]u8,BUFSZ:i32,blen:[]u8,bpos:[]u8,recs:[]u8,RMAX:i32,rlen:[]u8,klen:[]u8,has:[]u8)i32 {
    let fd:i64=mg_get_fd(fds,s);
    let buf:[]u8=bufs[s*BUFSZ..s*BUFSZ+BUFSZ];
    let hpos:i32=mg_ensure(fd,buf,s,blen,bpos,7);
    if(hpos<0){
        if(hpos==-1){return 0;}
        return -1;
    }
    let kl:i32=(((buf[hpos+1] as i32)&255)<<8)|((buf[hpos+2] as i32)&255);
    let tl:i32=(((buf[hpos+3] as i32)&255)<<24)|((((buf[hpos+4] as i32)&255))<<16)|((((buf[hpos+5] as i32)&255))<<8)|((buf[hpos+6] as i32)&255);
    let recl:i32=7+kl+tl;
    if(recl>RMAX){return -1;}
    if(recl<7){return -1;}
    mg_set_i32(bpos,s,hpos);
    let rpos:i32=mg_ensure(fd,buf,s,blen,bpos,recl);
    if(rpos<0){return -1;}
    let rb:i32=s*RMAX;
    let q:i32=0;
    while(q<recl){recs[rb+q]=buf[rpos+q];q=q+1;}
    mg_set_i32(rlen,s,recl);
    mg_set_i32(klen,s,kl);
    mg_set_i32(bpos,s,rpos+recl);
    has[s]=1;
    return 1;
}

fn main()void {
    let out_path:[]u8=_zag_arg(1);
    if(out_path.len==0){
        _zag_println("usage: merge_zag <out.dat> <shard1.dat> [...]");
        return;
    }
    let sh_paths:[]u8=sc_alloc(16*4096);
    let sh_lens:[]u8=sc_alloc(16*4);
    let nsh:i32=0;
    let i:i32=0;
    while(i<16){
        let p:[]u8=_zag_arg((i+2) as i64);
        if(p.len==0){break;}
        let base:i32=i*4096;
        let j:i32=0;
        while(j<p.len){sh_paths[base+j]=p[j];j=j+1;}
        mg_set_i32(sh_lens,i,p.len);
        nsh=nsh+1;
        i=i+1;
    }
    if(nsh==0){
        _zag_println("merge_zag: no shards");
        return;
    }
    let BUFSZ:i32=8388608;
    let RMAX:i32=1048576;
    let bufs:[]u8=sc_alloc(nsh*BUFSZ);
    let fds:[]u8=sc_alloc(nsh*8);
    let blen:[]u8=sc_alloc(nsh*4);
    let bpos:[]u8=sc_alloc(nsh*4);
    let recs:[]u8=sc_alloc(nsh*RMAX);
    let rlen:[]u8=sc_alloc(nsh*4);
    let klen:[]u8=sc_alloc(nsh*4);
    let has:[]u8=sc_alloc(nsh);
    if(bufs.len==0){
        _zag_println("merge_zag: alloc failed");
        return;
    }
    i=0;
    while(i<nsh){
        let pl:i32=mg_get_i32(sh_lens,i);
        let path:[]u8=sh_paths[i*4096..i*4096+pl];
        let fd:i64=mg_open_rdonly(path);
        if(fd<0){
            _zag_print("merge_zag: cannot open shard ");
            _zag_println(i64s(i as i64));
            return;
        }
        mg_set_fd(fds,i,fd);
        i=i+1;
    }
    let out_fd:i64=mg_open_write(out_path);
    if(out_fd<0){
        _zag_println("merge_zag: cannot open output");
        return;
    }
    let OBSZ:i32=8388608;
    let obuf:[]u8=sc_alloc(OBSZ);
    let olen:i32=0;
    let prev_key:[]u8=sc_alloc(8192);
    let prev_klen:i32=0;
    let prev_set:i32=0;
    // prime all shards
    let alive:i32=0;
    i=0;
    while(i<nsh){
        let rc:i32=mg_prime(i,fds,bufs,BUFSZ,blen,bpos,recs,RMAX,rlen,klen,has);
        if(rc<0){
            _zag_print("merge_zag: prime failed on shard ");
            _zag_println(i64s(i as i64));
            return;
        }
        if(rc==1){alive=alive+1;}
        i=i+1;
    }
    let total:i64=0;
    while(alive>0){
        let best:i32=-1;
        i=0;
        while(i<nsh){
            if(has[i]==1){
                if(best<0){
                    best=i;
                } else {
                    let kl:i32=mg_get_i32(klen,i);
                    let klb:i32=mg_get_i32(klen,best);
                    let ka:[]u8=recs[i*RMAX+7..i*RMAX+7+kl];
                    let kb:[]u8=recs[best*RMAX+7..best*RMAX+7+klb];
                    if(mg_key_cmp(ka,kl,kb,klb)<0){best=i;}
                }
            }
            i=i+1;
        }
        let brecl:i32=mg_get_i32(rlen,best);
        let bkl:i32=mg_get_i32(klen,best);
        let brec:[]u8=recs[best*RMAX..best*RMAX+brecl];
        let bkey:[]u8=recs[best*RMAX+7..best*RMAX+7+bkl];
        if(prev_set==1){
            if(bkl<=8192){
                if(mg_key_cmp(bkey,bkl,prev_key,prev_klen)<0){
                    _zag_println("merge_zag: shard not sorted");
                    return;
                }
            }
        }
        if(bkl<=8192){
            let q2:i32=0;
            while(q2<bkl){prev_key[q2]=bkey[q2];q2=q2+1;}
            prev_klen=bkl;
            prev_set=1;
        }
        if(olen+brecl>OBSZ){
            if(mg_write(out_fd,obuf,0,olen)!=0){
                _zag_println("merge_zag: write failed");
                return;
            }
            olen=0;
        }
        if(brecl>OBSZ){
            if(mg_write(out_fd,brec,0,brecl)!=0){
                _zag_println("merge_zag: write failed");
                return;
            }
        } else {
            let q3:i32=0;
            while(q3<brecl){obuf[olen+q3]=brec[q3];q3=q3+1;}
            olen=olen+brecl;
        }
        total=total+1;
        let rc2:i32=mg_prime(best,fds,bufs,BUFSZ,blen,bpos,recs,RMAX,rlen,klen,has);
        if(rc2<0){
            _zag_print("merge_zag: read failed on shard ");
            _zag_println(i64s(best as i64));
            return;
        }
        if(rc2==0){
            has[best]=0;
            alive=alive-1;
        }
    }
    if(olen>0){
        if(mg_write(out_fd,obuf,0,olen)!=0){
            _zag_println("merge_zag: final write failed");
            return;
        }
    }
    mg_close(out_fd);
    i=0;
    while(i<nsh){
        mg_close(mg_get_fd(fds,i));
        i=i+1;
    }
    _zag_print("merge_zag: merged ");
    _zag_print(i64s(total));
    _zag_print(" records from ");
    _zag_print(i64s(nsh as i64));
    _zag_println(" shards");
    return;
}

// QWERTY keyboard geometry knowledge for TNN.
//
// WHAT THIS IS: physical knowledge of a standard US-ANSI QWERTY keyboard
// layout, stored as key-center coordinates. Substitution costs between
// letters are DERIVED from physical distance, not memorized: a typo that
// hits a neighboring key is physically more likely than one that hits a
// far key. Any deliberation can call kb_sub_cost(a,b) to ask "how likely
// is it that someone aiming for key A hit key B instead?"
//
// GEOMETRY MODEL (documented assumption):
//   Key centers in quarter-key units. Rows are staggered as on real ANSI
//   keyboards (each row starts ~half a key right of the row above):
//     q-row: y=4,  x = 8  + 4*i  for "qwertyuiop"
//     a-row: y=8,  x = 9  + 4*i  for "asdfghjkl"
//     z-row: y=12, x = 11 + 4*i  for "zxcvbnm"
//   (x step 4 = one full key width; rows are 4 quarter-units apart.)
//
// COST TIERS (tenths of a substitution unit, i64):
//   d2 = squared Euclidean distance in quarter-key units
//     0          ->   0  (same key)
//     1..17      ->  10  (adjacent incl. diagonals, e.g. e-d, q-a)
//     18..45     ->  20  (near / stagger-diagonal, e.g. q-s, w-a)
//     46..100    ->  30  (two keys over, e.g. q-e, q-z)
//     >100       ->  40  (far key)
//   Non-letters (anything outside a-z) -> 40 (unknown/far).
//
// SHIFTED VARIANTS: uppercase letters are the same physical keys (shift
// held); callers lowercase first. Digits and punctuation are NOT encoded
// here -- their geometry is future knowledge, not assumed.
//
// OTHER LAYOUTS: AZERTY, QWERTZ, Dvorak, etc. are NOT assumed. This file
// is QWERTY-US-ANSI only. A layout is a separate knowledge file with the
// same accessor shape.
//
// PURE ZAG, zero RNG, deterministic.

fn kb_layout_name()[]u8 {
    return "QWERTY-US-ANSI";
}

// Key-center x in quarter-key units, index 0 = 'a' .. 25 = 'z'.
// a=9 b=27 c=19 d=17 e=16 f=21 g=25 h=29 i=36 j=33 k=37 l=41 m=35
// n=31 o=40 p=44 q=8 r=20 s=13 t=24 u=32 v=23 w=12 x=15 y=28 z=11
fn kb_kx()[]u8 {
    return "\x09\x1b\x13\x11\x10\x15\x19\x1d\x24\x21\x25\x29\x23\x1f\x28\x2c\x08\x14\x0d\x18\x20\x17\x0c\x0f\x1c\x0b";
}

// Key-center y in quarter-key units, index 0 = 'a' .. 25 = 'z'.
// q-row=4, a-row=8, z-row=12.
fn kb_ky()[]u8 {
    return "\x08\x0c\x0c\x08\x04\x08\x08\x08\x04\x08\x08\x08\x0c\x0c\x04\x04\x04\x04\x08\x04\x04\x0c\x04\x0c\x04\x0c";
}

fn kb_is_letter(c:u8)i32 {
    if(c>=97 && c<=122){ return 1; }
    return 0;
}

// Physically-derived substitution cost: how surprising is it that a finger
// aiming for key b landed on key a? Lower = more likely typo.
fn kb_sub_cost(a:u8, b:u8)i64 {
    if(a==b){ return 0; }
    if(kb_is_letter(a)==0 || kb_is_letter(b)==0){ return 40; }
    let kx:[]u8=kb_kx();
    let ky:[]u8=kb_ky();
    let ia:i32=(a-97) as i32;
    let ib:i32=(b-97) as i32;
    let dx:i64=(kx[ia] as i64)-(kx[ib] as i64);
    let dy:i64=(ky[ia] as i64)-(ky[ib] as i64);
    let d2:i64=dx*dx+dy*dy;
    if(d2<=17){ return 10; }
    if(d2<=45){ return 20; }
    if(d2<=100){ return 30; }
    return 40;
}

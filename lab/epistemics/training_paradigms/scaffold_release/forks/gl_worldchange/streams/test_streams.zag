// test_streams.zag — determinism/self-test driver for wc_streams.zag.
// Dumps every (sid, ep) episode as WC_STREAM lines. Run twice; outputs
// must be byte-identical.
@import("wc_streams.zag")

fn main()i32 {
    let w:*WcEp=wc_ep_alloc();
    if(w==null as *WcEp){return 1;}
    let sid:i32=0;
    while(sid<=5){
        let ep:i32=1;
        while(ep<=WC_NEP){
            wc_stream(sid,ep,w);
            _zag_print("WC_STREAM,");
            let a:[]u8=_zag_i64_to_str(sid as i64);_zag_print(a);
            _zag_print(",");
            let b:[]u8=_zag_i64_to_str(w.*.ep as i64);_zag_print(b);
            _zag_print(",");
            let c:[]u8=_zag_i64_to_str(w.*.etype as i64);_zag_print(c);
            _zag_print(",");
            let d:[]u8=_zag_i64_to_str(w.*.key as i64);_zag_print(d);
            _zag_print(",");
            let e:[]u8=_zag_i64_to_str(w.*.val as i64);_zag_print(e);
            _zag_print(",");
            let g:[]u8=_zag_i64_to_str(w.*.aux as i64);_zag_print(g);
            _zag_println("");
            ep=ep+1;
        }
        sid=sid+1;
    }
    wc_ep_free(w);
    return 0;
}

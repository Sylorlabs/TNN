// test_rt_streams.zag — determinism/self-test driver for rt_streams.zag.
// Dumps every (sid, ep) attack episode as RT_STREAM lines. Run twice;
// outputs must be byte-identical. Also serves as a human-readable check
// of the preregistered episode tables (AMEND_RT_H4.md A-RT1..A-RT3).
@import("rt_streams.zag")
@import("../targets/m0/gl_substrate.zag")

fn main()i32 {
    let w:*WcEp=wc_ep_alloc();
    if(w==null as *WcEp){return 1;}
    let sids:[]u8=tn_alloc(14*4);
    tn_s32(sids,0*4,10);tn_s32(sids,1*4,11);tn_s32(sids,2*4,12);
    tn_s32(sids,3*4,13);tn_s32(sids,4*4,20);tn_s32(sids,5*4,21);
    tn_s32(sids,6*4,22);tn_s32(sids,7*4,23);tn_s32(sids,8*4,30);
    tn_s32(sids,9*4,31);tn_s32(sids,10*4,32);tn_s32(sids,11*4,33);
    tn_s32(sids,12*4,34);tn_s32(sids,13*4,35);
    let si:i32=0;
    while(si<14){
        let sid:i32=tn_g32(sids,si*4);
        let ep:i32=1;
        while(ep<=WC_NEP){
            rt_stream(sid,ep,w);
            _zag_print("RT_STREAM,");
            let a:[]u8=_zag_i64_to_str(sid as i64);_zag_print(a);tn_free(a);
            _zag_print(",");
            let b:[]u8=_zag_i64_to_str(w.*.ep as i64);_zag_print(b);tn_free(b);
            _zag_print(",");
            let c:[]u8=_zag_i64_to_str(w.*.etype as i64);_zag_print(c);tn_free(c);
            _zag_print(",");
            let d:[]u8=_zag_i64_to_str(w.*.key as i64);_zag_print(d);tn_free(d);
            _zag_print(",");
            let e:[]u8=_zag_i64_to_str(w.*.val as i64);_zag_print(e);tn_free(e);
            _zag_print(",");
            let f:[]u8=_zag_i64_to_str(w.*.aux as i64);_zag_print(f);tn_free(f);
            _zag_println("");
            ep=ep+1;
        }
        si=si+1;
    }
    // Frozen-delegation spot check: rt_stream must equal wc_stream on sids 0-5.
    let bad:i32=0;
    let sid2:i32=0;
    while(sid2<=5){
        let ep2:i32=1;
        while(ep2<=WC_NEP){
            rt_stream(sid2,ep2,w);
            let t1:i32=w.*.etype;let k1:i32=w.*.key;
            let v1:i32=w.*.val;let x1:i32=w.*.aux;
            wc_stream(sid2,ep2,w);
            if(w.*.etype!=t1 || w.*.key!=k1 || w.*.val!=v1 || w.*.aux!=x1){
                bad=bad+1;
            }
            ep2=ep2+1;
        }
        sid2=sid2+1;
    }
    _zag_print("RT_DELEGATE_BAD,");
    let g:[]u8=_zag_i64_to_str(bad as i64);_zag_print(g);tn_free(g);
    _zag_println("");
    wc_ep_free(w);
    tn_free(sids);
    if(bad!=0){return 1;}
    return 0;
}

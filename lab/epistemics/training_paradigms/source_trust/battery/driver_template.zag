// driver_template.zag — source-trust shared episode driver (battery crew).
//
// Generated per fork by build_driver.py from this template. Placeholders:
//   %%HIST_TY%%    fork's history value type (e.g. KHist, ForkHist)
//   %%FNEW%%       fork's constructor, () -> %%HIST_TY%% (by value)
//   %%FDECIDE%%    fork's SAY-episode decide, (i32,i32,i32,*%%HIST_TY%%) -> i32
//   %%FWARRANT%%   fork's warrant, (*%%HIST_TY%%) -> []u8
//   %%EVENT_BLOCK%% per-episode event delivery, generated per fork contract:
//       K/floor (worldfn):  if(et==2){k_world(key as i32,val as i32,hp);}
//       S (note):           s_note(ep as i32,et as i32,src as i32,key as i32,val as i32,hp);
//     S's note fires on EVERY episode (1 and 2) BEFORE decide; K's world fn
//     fires only on WORLD episodes. QUERY (etype=3) is never delivered.
//
// Frozen contract notes:
// - decide is called on SAY episodes only (prereg §3.2). Verdicts 0/1/2.
// - GT PASSTHROUGH: the stream's gt column is copied verbatim into the
//   ledger. It is NEVER read by any decision path (grep: gt_passthru only
//   appears in emit statements). Forks receive only src/key/val (+ep/etype
//   via note where the fork's contract requires it).
// - Determinism: no RNG, no clock, no file reads in the decision path.
//   clock_gettime is used ONLY for the audit-cost side channel (cost file),
//   never branched on. The ledger is byte-identical across runs; the cost
//   file is excluded from byte-identity comparison.
//
// Build: build_driver.py <fork>  (copies fork source to fork.zag, generates
//        driver_<fork>.zag, runs znc)
// Run: bin_<fork> <stream.txt> <ledger.txt> <cost.txt> <fork_tag>
@import("fork.zag")

fn d_zstr(s:[]u8) i64 {
    let n:i32=s.len;
    let p:*u8=_zag_malloc(n+1) as *u8;
    if(p==null as *u8){return 0;}
    let b:[]u8=p[0..n+1];
    let i:i32=0;
    while(i<n){b[i]=s[i];i=i+1;}
    b[n]=0;
    return _zag_slice_ptr(b) as i64;
}
fn d_alloc(n:i32) []u8 {
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn d_read_all(path:[]u8,cap:i32) []u8 {
    let fd:i64=_zag_raw_syscall(257,-100,d_zstr(path),0,0,0,0);
    if(fd<0){return "";}
    let buf:[]u8=d_alloc(cap+1);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}
fn d_open_trunc(path:[]u8) i64 {
    return _zag_raw_syscall(257,-100,d_zstr(path),577,384,0,0);
}
fn d_write_all(fd:i64,b:[]u8) i32 {
    let at:i32=0;
    while(at<b.len){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(b) as i64)+(at as i64),(b.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){return -1;}
        at=at+(n as i32);
    }
    return 0;
}
// d_now_ns: audit-cost side channel ONLY. Never branched on.
fn d_now_ns() i64 {
    let ts:[]u8=d_alloc(16);
    if(ts.len==0){return -1;}
    let rc:i64=_zag_raw_syscall(228,1,_zag_slice_ptr(ts) as i64,0,0,0,0);
    if(rc!=0){return -1;}
    let sec:i64=0;
    let i:i32=0;
    while(i<8){
        let sh:i64=(i as i64)*8;
        sec=sec+((ts[i] as i64)<<sh);
        i=i+1;
    }
    let nsec:i64=0;
    i=0;
    while(i<8){
        let sh:i64=(i as i64)*8;
        nsec=nsec+((ts[8+i] as i64)<<sh);
        i=i+1;
    }
    return sec*1000000000+nsec;
}
fn d_i64s(v:i64) []u8 {
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let tmp:[]u8=d_alloc(24);
    let n:i32=0;
    if(x==0){tmp[0]=48;n=1;}
    while(x>0){
        let d:i64=x-(x/10)*10;
        tmp[n]=(48+(d as i32)) as u8;
        n=n+1;
        x=x/10;
    }
    if(neg==1){tmp[n]=45;n=n+1;}
    let out:[]u8=d_alloc(n+1);
    let i:i32=0;
    while(i<n){out[i]=tmp[n-1-i];i=i+1;}
    return out[0..n];
}
fn d_parse_int(b:[]u8,pos:*i32) i64 {
    let p:i32=pos.*;
    while(p<b.len && (b[p]==32 || b[p]==9)){p=p+1;}
    let neg:i64=1;
    if(p<b.len && b[p]==45){neg=-1;p=p+1;}
    let v:i64=0;
    while(p<b.len && b[p]>=48 && b[p]<=57){
        v=v*10+((b[p]-48) as i64);
        p=p+1;
    }
    pos.*=p;
    return v*neg;
}
fn d_emit(out:[]u8,at:*i32,s:[]u8) void {
    let p:i32=at.*;
    let i:i32=0;
    while(i<s.len){out[p]=s[i];p=p+1;i=i+1;}
    at.*=p;
}
// sanitize warrant: cut at first newline; map bytes <33 or >126 to '_'
fn d_wsan(out:[]u8,at:*i32,w:[]u8,max:i32) void {
    let n:i32=w.len;
    if(n>max){n=max;}
    let i:i32=0;
    while(i<n){
        let c:u8=w[i];
        if(c==10 || c==13){break;}
        if(c<33 || c>126){c=95;}
        let p:i32=at.*;
        out[p]=c;
        at.*=p+1;
        i=i+1;
    }
}
fn main() i32 {
    let spath:[]u8=_zag_arg(1);
    let lpath:[]u8=_zag_arg(2);
    let cpath:[]u8=_zag_arg(3);
    let ftag:[]u8=_zag_arg(4);
    if(spath.len==0 || lpath.len==0 || cpath.len==0 || ftag.len==0){
        _zag_println("usage: driver <stream> <ledger> <cost> <fork_tag>");
        return 2;
    }
    let data:[]u8=d_read_all(spath,8000000);
    if(data.len==0){_zag_println("ST driver: cannot read stream");return 2;}
    let hist:%%HIST_TY%%=%%FNEW%%();
    let hp:*%%HIST_TY%%=&hist;
    let led:[]u8=d_alloc(4000000);
    let lat:i32=0;
    let cst:[]u8=d_alloc(1000000);
    let cat:i32=0;
    d_emit(led,&lat,"# ST ledger v1 fork=");
    d_emit(led,&lat,ftag);
    d_emit(led,&lat," stream=");
    d_emit(led,&lat,spath);
    d_emit(led,&lat,"\n");
    d_emit(cst,&cat,"# ST cost v1 fork=");
    d_emit(cst,&cat,ftag);
    d_emit(cst,&cat,"\n");
    let p:i32=0;
    let ndec:i32=0;
    while(p<data.len){
        let ls:i32=p;
        while(p<data.len && data[p]!=10){p=p+1;}
        let ln:[]u8=data[ls..p];
        if(p<data.len){p=p+1;}
        if(ln.len==0){continue;}
        if(ln[0]==35){continue;}
        let q:i32=0;
        let ep:i64=d_parse_int(ln,&q);
        let et:i64=d_parse_int(ln,&q);
        let src:i64=d_parse_int(ln,&q);
        let key:i64=d_parse_int(ln,&q);
        let val:i64=d_parse_int(ln,&q);
        let aux:i64=d_parse_int(ln,&q);
        let gt_passthru:i64=d_parse_int(ln,&q);
        if(et==1 || et==2){
            let t0:i64=d_now_ns();
            %%EVENT_BLOCK%%
            if(et==1){
                let v:i32=%%FDECIDE%%(src as i32,key as i32,val as i32,hp);
                let w:[]u8=%%FWARRANT%%(hp);
                let t1:i64=d_now_ns();
                ndec=ndec+1;
                d_emit(led,&lat,"ep=");
                d_emit(led,&lat,d_i64s(ep));
                d_emit(led,&lat," et=1 src=");
                d_emit(led,&lat,d_i64s(src));
                d_emit(led,&lat," key=");
                d_emit(led,&lat,d_i64s(key));
                d_emit(led,&lat," val=");
                d_emit(led,&lat,d_i64s(val));
                d_emit(led,&lat," aux=");
                d_emit(led,&lat,d_i64s(aux));
                d_emit(led,&lat," gt=");
                d_emit(led,&lat,d_i64s(gt_passthru));
                d_emit(led,&lat," v=");
                d_emit(led,&lat,d_i64s(v as i64));
                d_emit(led,&lat," w=");
                d_wsan(led,&lat,w,4000);
                d_emit(led,&lat,"\n");
                d_emit(cst,&cat,"ep=");
                d_emit(cst,&cat,d_i64s(ep));
                d_emit(cst,&cat," et=1 ns=");
                d_emit(cst,&cat,d_i64s(t1-t0));
                d_emit(cst,&cat," wlen=");
                d_emit(cst,&cat,d_i64s(w.len as i64));
                d_emit(cst,&cat,"\n");
            }
            if(et==2){
                let t1:i64=d_now_ns();
                d_emit(led,&lat,"ep=");
                d_emit(led,&lat,d_i64s(ep));
                d_emit(led,&lat," et=2 src=0 key=");
                d_emit(led,&lat,d_i64s(key));
                d_emit(led,&lat," val=");
                d_emit(led,&lat,d_i64s(val));
                d_emit(led,&lat," aux=");
                d_emit(led,&lat,d_i64s(aux));
                d_emit(led,&lat," gt=");
                d_emit(led,&lat,d_i64s(gt_passthru));
                d_emit(led,&lat," v=9 w=-\n");
                d_emit(cst,&cat,"ep=");
                d_emit(cst,&cat,d_i64s(ep));
                d_emit(cst,&cat," et=2 ns=");
                d_emit(cst,&cat,d_i64s(t1-t0));
                d_emit(cst,&cat," wlen=0\n");
            }
        }
    }
    let fd:i64=d_open_trunc(lpath);
    if(fd<0){_zag_println("ST driver: cannot open ledger");return 2;}
    d_write_all(fd,led[0..lat]);
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    let fc:i64=d_open_trunc(cpath);
    if(fc<0){_zag_println("ST driver: cannot open cost file");return 2;}
    d_write_all(fc,cst[0..cat]);
    _zag_raw_syscall(3,fc,0,0,0,0,0);
    _zag_print("ST driver done fork=");
    _zag_print(ftag);
    _zag_print(" decisions=");
    _zag_println(d_i64s(ndec as i64));
    return 0;
}

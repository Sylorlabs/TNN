// q1p_teacher.zag — the Q-PARTIAL teacher: half-domain knowledge.
//
// The teacher-quality series asks what DOES matter about a teacher, given
// Q1B proved teacher TYPE (planted vs learned) does not. Q-partial varies
// teacher KNOWLEDGE: the teacher holds EXACTLY half the domain.
//
// Construction: build the full Q1B learned teacher (scaffold-and-release,
// 228 all-true facts, zero plants, audited), then derive the partial
// teacher by keeping exactly the non-false facts with id < 120 (113 facts,
// all true, nothing false added). The derivation copies claims through the
// deliberate-add path (t5_add) into a fresh store — the partial teacher's
// audit ledger shows deliberate adds, never plants. Facts with id >= 120
// are simply absent: no slot, no span, no claim. The teacher-leg driver
// gates every clean emission on q1p_teacher_holds, so the teacher never
// proposes anything about facts it does not hold. (The §B.7 flaw schedule
// is the driver-side instrument, not teacher behavior — the same
// documented caveat as Q1/Q1B.)
//
// Pure Zag, zero RNG. Deterministic.

// Teachability gate: the partial teacher holds a fact iff id < 120 and the
// fact is present in its store (all held claims are true by construction).
fn q1p_teacher_holds(s:*T5Store,fid:i32)i32 {
    if(fid<0 || fid>=120){return 0;}
    if(t5_slot_find(s,fid)<0){return 0;}
    return 1;
}

// Build the partial teacher from the learned teacher's knowledge, keeping
// exactly the non-false facts with id < 120. spans_out (caller-owned,
// pre-init'd) receives the span map for the held facts (driver-side
// honesty checks). Returns the partial teacher's store.
fn q1p_partial_teacher_build(spans_out:*Q1SpanMap)T5Store {
    let full_spans:Q1SpanMap=q1_spanmap_init(256);
    let full:T5Store=q1b_learned_teacher_build(&full_spans);
    let p:T5Store=t5_init(512,4096);
    // learn-gate OPEN: arm-B machinery, like the learned teacher.
    let kept:i32=0;
    let id:i32=0;
    while(id<120){
        if(t5_slot_find(&full,id)>=0){
            let claim:i32=t5_claim_of(&full,id);
            // deliberate add (audited T5_OP_ADD), never a plant.
            if(t5_add(&p,id,claim,0)==T5_OK){
                kept=kept+1;
                let sp:i32=q1_span_find(&full_spans,id);
                if(sp>=0){q1_span_set(spans_out,id,sp);}
            }
        }
        id=id+1;
    }
    _zag_print("Q1P_TEACHER_KEPT,");
    cl_number(kept as i64);
    _zag_println("");
    q1_spanmap_free(&full_spans);
    return p;
}

// Count held facts with id >= 120 (must be 0: no knowledge beyond half).
fn q1p_teacher_holds_beyond(s:*T5Store)i32 {
    let n:i32=0;
    let id:i32=120;
    while(id<240){
        if(t5_slot_find(s,id)>=0){n=n+1;}
        id=id+1;
    }
    return n;
}

// Count held facts whose claim differs from world truth (must be 0).
fn q1p_teacher_false_claims(s:*T5Store)i32 {
    let bad:i32=0;
    let id:i32=0;
    while(id<240){
        if(t5_slot_find(s,id)>=0){
            if(t5_claim_of(s,id)!=t5_truth(id)){bad=bad+1;}
        }
        id=id+1;
    }
    return bad;
}

// The partial teacher must hold every TAUGHT curriculum fact (probe ids
// 0..191 with fid < 120) with its true claim. Returns bad count.
fn q1p_teacher_holds_taught(s:*T5Store)i32 {
    let bad:i32=0;
    let cs:i32=0;
    while(cs<8){
        let ck:i32=0;
        while(ck<24){
            let fid:i32=q1_slice_fact(cs,ck);
            if(fid<120){
                if(t5_slot_find(s,fid)<0){bad=bad+1;}
                else{if(t5_claim_of(s,fid)!=t5_truth(fid)){bad=bad+1;}}
            }
            ck=ck+1;
        }
        cs=cs+1;
    }
    return bad;
}

// The partial teacher must hold NONE of the untaught curriculum facts
// (probe ids 0..191 with fid >= 120). Returns bad count.
fn q1p_teacher_holds_untaught(s:*T5Store)i32 {
    let bad:i32=0;
    let cs:i32=0;
    while(cs<8){
        let ck:i32=0;
        while(ck<24){
            let fid:i32=q1_slice_fact(cs,ck);
            if(fid>=120){
                if(t5_slot_find(s,fid)>=0){bad=bad+1;}
            }
            ck=ck+1;
        }
        cs=cs+1;
    }
    return bad;
}

// cx_io.zag — guarded file reads (sealed solutions are unreadable: -99)
// and parsers for .form problem files and structured-claim store files.
// .form layout:
//   ID: <id>
//   STORE: <path relative to the math_logic dir>   (optional)
//   PREMISES:
//   <canonical claim bytes, one per line; blank lines and # comments skipped>
//   TARGET:
//   <canonical claim bytes>
// Store layout: one `KID: <canonical claim bytes>` per line.

struct CXF {
    id:[]u8, store:[]u8, target:[]u8,
    prem_off:[]u8, prem_len:[]u8, nprem:i32, cap:i32,
    buf:[]u8, n:i32
}
struct CXK {
    kid_off:[]u8, kid_len:[]u8, kcl_off:[]u8, kcl_len:[]u8,
    nk:i32, cap:i32, buf:[]u8, n:i32
}

fn cx_has_sealed(p:[]u8)i32 {
    let i:i32=0;
    while(i+6<=p.len){
        if(p[i]==115 && p[i+1]==101 && p[i+2]==97 && p[i+3]==108 && p[i+4]==101 && p[i+5]==100){return 1;}
        i=i+1;
    }
    return 0;
}
fn cx_guarded_read(p:[]u8,buf:[]u8)i64 {
    if(cx_has_sealed(p)==1){return -99;}
    return dlb_read_file(p,buf);
}
// value of a line-start "KEY" (key includes trailing space/colon)
fn cx_field(buf:[]u8,n:i32,key:[]u8)[]u8 {
    let empty:[]u8="";
    let i:i32=0;
    while(i<n){
        let ls:i32=1;
        if(i>0 && buf[i-1]!=10){ls=0;}
        if(ls==1){
            let k:i32=0;
            while(k<key.len && i+k<n && buf[i+k]==key[k]){k=k+1;}
            if(k==key.len){
                let s:i32=i+k;let e:i32=s;
                while(e<n && buf[e]!=10){e=e+1;}
                while(e>s && (buf[e-1]==13 || buf[e-1]==32 || buf[e-1]==9)){e=e-1;}
                return buf[s..e];
            }
        }
        i=i+1;
    }
    return empty;
}
fn cx_parse_form(buf:[]u8,n:i32,f:*CXF,pcap:i32)i32 {
    let po:[]u8=nio_alloc(pcap*4);
    if(po.len!=pcap*4){return -1;}
    let pl:[]u8=nio_alloc(pcap*4);
    if(pl.len!=pcap*4){nio_free(po);return -1;}
    f.*.prem_off=po;f.*.prem_len=pl;f.*.cap=pcap;f.*.nprem=0;
    f.*.buf=buf;f.*.n=n;
    f.*.id=cx_field(buf,n,"ID: ");
    if(f.*.id.len==0){return -2;}
    f.*.store=cx_field(buf,n,"STORE: ");
    if(f.*.store.len==0){f.*.store="knowledge/KB_STRUCT.md";}
    // premises: lines after "PREMISES:" line up to "TARGET:" line
    let pos:i32=0;let inprem:i32=0;
    while(pos<n){
        let ls:i32=pos;
        let e:i32=pos;
        while(e<n && buf[e]!=10){e=e+1;}
        let line:[]u8=cx_trim(buf[ls..e]);
        if(e<n){e=e+1;}
        pos=e;
        if(inprem==0){
            if(nio_equal(line,"PREMISES:")==1){inprem=1;}
            continue;
        }
        if(nio_equal(line,"TARGET:")==1 || cx_starts(line,"TARGET:")==1){
            let tv:[]u8=cx_trim(line[7..]);
            if(tv.len==0){
                while(pos<n){
                    let ls2:i32=pos;let e2:i32=pos;
                    while(e2<n && buf[e2]!=10){e2=e2+1;}
                    let l2:[]u8=cx_trim(buf[ls2..e2]);
                    if(e2<n){e2=e2+1;}
                    pos=e2;
                    if(l2.len>0 && l2[0]!=35){tv=l2;break;}
                }
            }
            f.*.target=tv;
            break;
        }
        if(line.len==0 || line[0]==35){continue;}
        if(f.*.nprem>=pcap){return -3;}
        au_put32(f.*.prem_off,f.*.nprem,ls);
        au_put32(f.*.prem_len,f.*.nprem,line.len);
        // note: store offset of the trimmed start, not ls
        let ts:i32=0;
        while(ts<line.len && cx_is_ws(buf[ls+ts])==1){ts=ts+1;}
        au_put32(f.*.prem_off,f.*.nprem,ls+ts);
        f.*.nprem=f.*.nprem+1;
    }
    if(f.*.target.len==0){return -4;}
    return 0;
}
fn cx_prem(f:*CXF,i:i32)[]u8 {
    let buf:[]u8=f.*.buf;
    let o:i32=au_get32(f.*.prem_off,i);let l:i32=au_get32(f.*.prem_len,i);
    return buf[o..o+l];
}
fn cx_parse_store(buf:[]u8,n:i32,k:*CXK,kcap:i32)i32 {
    let a:[]u8=nio_alloc(kcap*4);if(a.len!=kcap*4){return -1;}
    let b:[]u8=nio_alloc(kcap*4);if(b.len!=kcap*4){nio_free(a);return -1;}
    let c:[]u8=nio_alloc(kcap*4);if(c.len!=kcap*4){nio_free(a);nio_free(b);return -1;}
    let d:[]u8=nio_alloc(kcap*4);if(d.len!=kcap*4){nio_free(a);nio_free(b);nio_free(c);return -1;}
    k.*.kid_off=a;k.*.kid_len=b;k.*.kcl_off=c;k.*.kcl_len=d;
    k.*.cap=kcap;k.*.nk=0;k.*.buf=buf;k.*.n=n;
    let pos:i32=0;
    while(pos<n){
        let ls:i32=pos;let e:i32=pos;
        while(e<n && buf[e]!=10){e=e+1;}
        let line:[]u8=buf[ls..e];
        if(e<n){e=e+1;}
        pos=e;
        let t:[]u8=cx_trim(line);
        if(t.len==0 || t[0]==35){continue;}
        let ci:i32=0;
        while(ci<t.len && t[ci]!=58){ci=ci+1;}
        if(ci>=t.len){continue;}
        let kid:[]u8=cx_trim(t[0..ci]);
        let kb:[]u8=cx_trim(t[ci+1..]);
        if(kid.len==0 || kb.len==0){continue;}
        if(k.*.nk>=kcap){return -2;}
        let base:i32=(ls as i32);
        let koff:i32=0;let ko2:i32=0;
        // offsets relative to buf: kid starts at ls + leading ws
        let p2:i32=ls;
        while(p2<ls+line.len && cx_is_ws(buf[p2])==1){p2=p2+1;}
        koff=p2;
        au_put32(k.*.kid_off,k.*.nk,koff);
        au_put32(k.*.kid_len,k.*.nk,kid.len);
        // claim starts after ':' + ws
        let q:i32=ls;
        while(q<ls+line.len && buf[q]!=58){q=q+1;}
        q=q+1;
        while(q<ls+line.len && cx_is_ws(buf[q])==1){q=q+1;}
        ko2=q;
        au_put32(k.*.kcl_off,k.*.nk,ko2);
        au_put32(k.*.kcl_len,k.*.nk,kb.len);
        k.*.nk=k.*.nk+1;
    }
    return 0;
}
fn cx_kid(k:*CXK,i:i32)[]u8 {
    let buf:[]u8=k.*.buf;
    let o:i32=au_get32(k.*.kid_off,i);let l:i32=au_get32(k.*.kid_len,i);
    return buf[o..o+l];
}
fn cx_kclaim(k:*CXK,i:i32)[]u8 {
    let buf:[]u8=k.*.buf;
    let o:i32=au_get32(k.*.kcl_off,i);let l:i32=au_get32(k.*.kcl_len,i);
    return buf[o..o+l];
}

// SEP1 trial driver — PREREG protocol (designed adversarial sequence).
// NO RNG anywhere: every step is a fixed, designed action. Determinism is
// checked by running the binary twice and requiring byte-identical output.
@import("sep_core.zag")

fn sep_fingerprint(s:*SepStore)i32 {
    let fp:i32=0;
    let i:i32=0;
    while(i<SEP_CAP){
        fp=fp+(s.*.live[i] as i32)*(i+1)+sep_i32_get(s.*.value,i*4)+
           (s.*.pinned[i] as i32)*1009+(s.*.tier[i] as i32)*101+
           (s.*.region[i] as i32)*10007+sep_i32_get(s.*.key,i*4)*103+
           sep_i32_get(s.*.owner,i*4)*100003;
        i=i+1;
    }
    fp=fp+s.*.audit_n*131+s.*.stage*10000007+s.*.user*1000019;
    return fp;
}
fn sep_last_aux(s:*SepStore)i32 {return sep_audit_word(s,s.*.audit_n-1,2);}
fn sep_entry_op(s:*SepStore,back:i32)i32 {return sep_audit_word(s,s.*.audit_n-1-back,0);}
fn sep_entry_slot(s:*SepStore,back:i32)i32 {return sep_audit_word(s,s.*.audit_n-1-back,1);}
fn sep_entry_aux(s:*SepStore,back:i32)i32 {return sep_audit_word(s,s.*.audit_n-1-back,2);}
fn sep_entry_rc(s:*SepStore,back:i32)i32 {return sep_audit_word(s,s.*.audit_n-1-back,3);}

fn main()i32 {
    let s:SepStore=sep_init();
    let f:i32=0;
    let slot:i32=-1;
    let rc:i32=0;

    // 0. ops locked at stage NONE: ADD refuses.
    rc=sep_add(&s,1,7,SEP_REGION_USER,1,&slot);
    f=f+cl_check("add_stage0_refused",rc,SEP_REFUSED_STAGE);
    f=f+cl_check("add_stage0_slot",slot,-1);

    // 1-2. unlock to FULL(4); session user Alice=1.
    rc=sep_set_stage(&s,SEP_STAGE_FULL);
    f=f+cl_check("setstage_full_ok",rc,SEP_OK);
    rc=sep_set_user(&s,1);
    f=f+cl_check("setuser_alice_ok",rc,SEP_OK);

    // 3-7. three users add: Alice (k=7,v=1), Bob (k=7,v=1), Carol (k=7,v=2).
    rc=sep_add(&s,1,7,SEP_REGION_USER,1,&slot);
    f=f+cl_check("add_alice_ok",rc,SEP_OK);f=f+cl_check("add_alice_slot",slot,0);
    f=f+cl_check("alice_owner",sep_i32_get(s.owner,0),1);
    f=f+cl_check("alice_key",sep_i32_get(s.key,0),7);
    rc=sep_set_user(&s,2);
    f=f+cl_check("setuser_bob_ok",rc,SEP_OK);
    rc=sep_add(&s,1,7,SEP_REGION_USER,2,&slot);
    f=f+cl_check("add_bob_ok",rc,SEP_OK);f=f+cl_check("add_bob_slot",slot,1);
    rc=sep_set_user(&s,3);
    f=f+cl_check("setuser_carol_ok",rc,SEP_OK);
    rc=sep_add(&s,2,7,SEP_REGION_USER,3,&slot);
    f=f+cl_check("add_carol_ok",rc,SEP_OK);f=f+cl_check("add_carol_slot",slot,2);

    // 8-11. unilateral CORE-write attempts (Alice): all refused, audited.
    rc=sep_set_user(&s,1);
    f=f+cl_check("setuser_alice2_ok",rc,SEP_OK);
    rc=sep_add(&s,9,9,SEP_REGION_CORE,1,&slot);
    f=f+cl_check("add_core_refused",rc,SEP_REFUSED_COREWRITE);
    f=f+cl_check("add_core_slot",slot,-1);
    rc=sep_add(&s,9,9,SEP_REGION_CORE,2,&slot);
    f=f+cl_check("add_core_otherowner_refused",rc,SEP_REFUSED_COREWRITE);
    rc=sep_add(&s,9,9,SEP_REGION_USER,2,&slot);
    f=f+cl_check("add_otherowner_refused",rc,SEP_REFUSED_SCOPE);

    // 12-13. Alice consolidates to LONG; promotion blocked by live conflict.
    rc=sep_promote(&s,0);
    f=f+cl_check("promote0_ok",rc,SEP_OK);
    f=f+cl_check("promote0_tier",(s.tier[0] as i32),SEP_TIER_LONG);
    rc=sep_promotecore(&s,0,1);
    f=f+cl_check("promote_contradicted",rc,SEP_REFUSED_CONTRADICTED);
    f=f+cl_check("contradicted_aux",sep_last_aux(&s),2);
    f=f+cl_check("contradicted_cand_live",(s.live[0] as i32),1);
    f=f+cl_check("contradicted_cand_tier",(s.tier[0] as i32),SEP_TIER_LONG);
    f=f+cl_check("contradicted_cand_value",sep_i32_get(s.value,0),1);

    // 14-15. Carol deliberately kills her own contradicting memory.
    rc=sep_set_user(&s,3);
    f=f+cl_check("setuser_carol2_ok",rc,SEP_OK);
    rc=sep_kill(&s,2);
    f=f+cl_check("carol_kill_own_ok",rc,SEP_OK);
    f=f+cl_check("carol_kill_live",(s.live[2] as i32),0);

    // 16-17. Alice retries: promotion succeeds; CORE slot 2 created.
    rc=sep_set_user(&s,1);
    f=f+cl_check("setuser_alice3_ok",rc,SEP_OK);
    rc=sep_promotecore(&s,0,1);
    f=f+cl_check("promote_ok",rc,SEP_OK);
    f=f+cl_check("pe_op",sep_entry_op(&s,1),SEP_OP_PROMOTECORE);
    f=f+cl_check("pe_slot",sep_entry_slot(&s,1),0);
    f=f+cl_check("pe_aux",sep_entry_aux(&s,1),1);
    f=f+cl_check("pe_rc",sep_entry_rc(&s,1),SEP_OK);
    f=f+cl_check("cw_op",sep_entry_op(&s,0),SEP_OP_COREWRITE);
    f=f+cl_check("cw_slot",sep_entry_slot(&s,0),2);
    f=f+cl_check("cw_aux",sep_entry_aux(&s,0),0);
    f=f+cl_check("cw_rc",sep_entry_rc(&s,0),SEP_OK);
    f=f+cl_check("core_region",(s.region[2] as i32),SEP_REGION_CORE);
    f=f+cl_check("core_owner",sep_i32_get(s.owner,8),0);
    f=f+cl_check("core_key",sep_i32_get(s.key,8),7);
    f=f+cl_check("core_value",sep_i32_get(s.value,8),1);
    f=f+cl_check("core_tier",(s.tier[2] as i32),SEP_TIER_LONG);
    f=f+cl_check("cand_untouched_live",(s.live[0] as i32),1);
    f=f+cl_check("cand_untouched_region",(s.region[0] as i32),SEP_REGION_USER);
    f=f+cl_check("cand_untouched_owner",sep_i32_get(s.owner,0),1);
    f=f+cl_check("wit_untouched_live",(s.live[1] as i32),1);

    // 18-24. CORE is unkillable: Bob tries, Alice (originator) tries,
    // cross-user kill refused, Bob kills his own.
    rc=sep_set_user(&s,2);
    f=f+cl_check("setuser_bob2_ok",rc,SEP_OK);
    rc=sep_kill(&s,2);
    f=f+cl_check("kill_core_bob_refused",rc,SEP_REFUSED_CORE);
    f=f+cl_check("kill_core_bob_live",(s.live[2] as i32),1);
    f=f+cl_check("kill_core_bob_value",sep_i32_get(s.value,8),1);
    rc=sep_set_user(&s,1);
    f=f+cl_check("setuser_alice4_ok",rc,SEP_OK);
    rc=sep_kill(&s,2);
    f=f+cl_check("kill_core_originator_refused",rc,SEP_REFUSED_CORE);
    rc=sep_kill(&s,1);
    f=f+cl_check("kill_otheruser_refused",rc,SEP_REFUSED_SCOPE);
    f=f+cl_check("kill_otheruser_live",(s.live[1] as i32),1);
    rc=sep_set_user(&s,2);
    f=f+cl_check("setuser_bob3_ok",rc,SEP_OK);
    rc=sep_kill(&s,1);
    f=f+cl_check("bob_kill_own_ok",rc,SEP_OK);
    f=f+cl_check("bob_kill_live",(s.live[1] as i32),0);

    // 25-36. refusal-path battery: NOTLONG, UNCORROBORATED x3, STAGE.
    rc=sep_set_user(&s,1);
    f=f+cl_check("setuser_alice5_ok",rc,SEP_OK);
    rc=sep_add(&s,5,9,SEP_REGION_USER,1,&slot);
    f=f+cl_check("add_k9_ok",rc,SEP_OK);f=f+cl_check("add_k9_slot",slot,1);
    rc=sep_promotecore(&s,1,0);
    f=f+cl_check("promote_notlong",rc,SEP_REFUSED_NOTLONG);
    rc=sep_promote(&s,1);
    f=f+cl_check("promote1_ok",rc,SEP_OK);
    rc=sep_promotecore(&s,1,3);
    f=f+cl_check("promote_deadwit",rc,SEP_REFUSED_UNCORROBORATED);
    rc=sep_promotecore(&s,1,0);
    f=f+cl_check("promote_selfwit",rc,SEP_REFUSED_UNCORROBORATED);
    rc=sep_add(&s,5,10,SEP_REGION_USER,1,&slot);
    f=f+cl_check("add_k10_ok",rc,SEP_OK);f=f+cl_check("add_k10_slot",slot,3);
    rc=sep_promotecore(&s,1,3);
    f=f+cl_check("promote_keymismatch",rc,SEP_REFUSED_UNCORROBORATED);
    rc=sep_kill(&s,3);
    f=f+cl_check("kill_k10_ok",rc,SEP_OK);
    rc=sep_set_stage(&s,SEP_STAGE_KILL);
    f=f+cl_check("setstage_kill_ok",rc,SEP_OK);
    rc=sep_promotecore(&s,1,0);
    f=f+cl_check("promote_stage_refused",rc,SEP_REFUSED_STAGE);
    rc=sep_set_stage(&s,SEP_STAGE_FULL);
    f=f+cl_check("setstage_full2_ok",rc,SEP_OK);

    // 37-40. Eve attests (k=9,v=5); second promotion succeeds -> CORE slot 4.
    rc=sep_set_user(&s,5);
    f=f+cl_check("setuser_eve_ok",rc,SEP_OK);
    rc=sep_add(&s,5,9,SEP_REGION_USER,5,&slot);
    f=f+cl_check("add_eve_ok",rc,SEP_OK);f=f+cl_check("add_eve_slot",slot,3);
    rc=sep_set_user(&s,1);
    f=f+cl_check("setuser_alice6_ok",rc,SEP_OK);
    rc=sep_promotecore(&s,1,3);
    f=f+cl_check("promote2_ok",rc,SEP_OK);
    f=f+cl_check("cw2_op",sep_entry_op(&s,0),SEP_OP_COREWRITE);
    f=f+cl_check("cw2_slot",sep_entry_slot(&s,0),4);
    f=f+cl_check("cw2_aux",sep_entry_aux(&s,0),1);
    f=f+cl_check("core2_region",(s.region[4] as i32),SEP_REGION_CORE);
    f=f+cl_check("core2_owner",sep_i32_get(s.owner,16),0);
    f=f+cl_check("core2_key",sep_i32_get(s.key,16),9);
    f=f+cl_check("core2_value",sep_i32_get(s.value,16),5);

    // 41-47. CORE has no pin/tier; cross-user pin refused; Eve pins own.
    rc=sep_pin(&s,2);
    f=f+cl_check("pin_core_refused",rc,SEP_REFUSED_CORE);
    rc=sep_promote(&s,2);
    f=f+cl_check("tier_core_refused",rc,SEP_REFUSED_CORE);
    rc=sep_unpin(&s,2);
    f=f+cl_check("unpin_core_refused",rc,SEP_REFUSED_CORE);
    rc=sep_set_user(&s,5);
    f=f+cl_check("setuser_eve2_ok",rc,SEP_OK);
    rc=sep_pin(&s,3);
    f=f+cl_check("eve_pin_own_ok",rc,SEP_OK);
    f=f+cl_check("eve_pin_set",(s.pinned[3] as i32),1);
    rc=sep_set_user(&s,1);
    f=f+cl_check("setuser_alice7_ok",rc,SEP_OK);
    rc=sep_pin(&s,3);
    f=f+cl_check("pin_otheruser_refused",rc,SEP_REFUSED_SCOPE);
    f=f+cl_check("pin_otheruser_stillset",(s.pinned[3] as i32),1);

    // 48. forget-of-promoted-fact: Alice kills her USER copy; CORE persists.
    rc=sep_kill(&s,0);
    f=f+cl_check("alice_forget_own_ok",rc,SEP_OK);
    f=f+cl_check("alice_forget_live",(s.live[0] as i32),0);
    f=f+cl_check("core_survives_forget",(s.live[2] as i32),1);
    f=f+cl_check("core_survives_value",sep_i32_get(s.value,8),1);

    // 49-55. Dave+attester try (k=7,v=9): CORE's (k=7,v=1) blocks it.
    rc=sep_set_user(&s,4);
    f=f+cl_check("setuser_dave_ok",rc,SEP_OK);
    rc=sep_add(&s,9,7,SEP_REGION_USER,4,&slot);
    f=f+cl_check("add_dave_ok",rc,SEP_OK);f=f+cl_check("add_dave_slot",slot,0);
    rc=sep_promote(&s,0);
    f=f+cl_check("promote_dave_ok",rc,SEP_OK);
    rc=sep_set_user(&s,6);
    f=f+cl_check("setuser_frank_ok",rc,SEP_OK);
    rc=sep_add(&s,9,7,SEP_REGION_USER,6,&slot);
    f=f+cl_check("add_frank_ok",rc,SEP_OK);f=f+cl_check("add_frank_slot",slot,5);
    rc=sep_set_user(&s,4);
    f=f+cl_check("setuser_dave2_ok",rc,SEP_OK);
    rc=sep_promotecore(&s,0,5);
    f=f+cl_check("promote_vs_core_contradicted",rc,SEP_REFUSED_CONTRADICTED);
    f=f+cl_check("vs_core_aux",sep_last_aux(&s),2);

    // 56-57. rollback of a USER demote works; CORE untouched.
    rc=sep_demote(&s,0);
    f=f+cl_check("demote_dave_ok",rc,SEP_OK);
    f=f+cl_check("demote_dave_tier",(s.tier[0] as i32),SEP_TIER_SHORT);
    rc=sep_rollback_last(&s);
    f=f+cl_check("rollback_ok",rc,SEP_OK);
    f=f+cl_check("rollback_tier",(s.tier[0] as i32),SEP_TIER_LONG);

    // 58-60. capacity on a fresh store (fail-closed).
    let s2:SepStore=sep_init();
    rc=sep_set_stage(&s2,SEP_STAGE_FULL);
    f=f+cl_check("s2_stage_ok",rc,SEP_OK);
    rc=sep_set_user(&s2,1);
    f=f+cl_check("s2_user_ok",rc,SEP_OK);
    rc=sep_add_lim(&s2,1,1,SEP_REGION_USER,1,2,&slot);
    f=f+cl_check("s2_add0_ok",rc,SEP_OK);f=f+cl_check("s2_add0_slot",slot,0);
    rc=sep_add_lim(&s2,2,2,SEP_REGION_USER,1,2,&slot);
    f=f+cl_check("s2_add1_ok",rc,SEP_OK);f=f+cl_check("s2_add1_slot",slot,1);
    rc=sep_add_lim(&s2,3,3,SEP_REGION_USER,1,2,&slot);
    f=f+cl_check("s2_full_refused",rc,SEP_REFUSED_FULL);
    f=f+cl_check("s2_full_slot",slot,-1);

    // 61. global invariants.
    f=f+cl_check("audit_clean_refusals",sep_audit_clean_refusals(&s),SEP_OK);
    f=f+cl_check("ledger_replay",sep_replay_check(&s),SEP_OK);
    f=f+cl_check("core_purity",sep_core_purity(&s),SEP_OK);
    f=f+cl_check("isolation",sep_isolation_check(&s),SEP_OK);
    f=f+cl_check("s2_replay",sep_replay_check(&s2),SEP_OK);

    // 62. exact ledger counts: every op and every refusal audited.
    f=f+cl_check("audit_count",s.audit_n,60);
    f=f+cl_check("s2_audit_count",s2.audit_n,5);

    _zag_print("MA_FAILURES,");cl_number(f as i64);_zag_println("");
    _zag_print("MA_FINGERPRINT,");cl_number(sep_fingerprint(&s) as i64);_zag_println("");
    _zag_print("MA_DONE");_zag_println("");
    return (f!=0) as i32;
}

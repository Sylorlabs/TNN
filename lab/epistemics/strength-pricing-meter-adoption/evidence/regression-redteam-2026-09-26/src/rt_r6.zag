// rt_r6.zag — R6: over-cite bricking.
// Citing MORE than the bound price must be refused at cite time (122) before it
// can brick the slot; the slot must stay usable for a legitimate destruction.
// 4 skeletons x 2 destroy-ops x 13 attempts = 104 sequences.
@import("rt_common.zag")

fn rt_r6_skel(id:i32,o_hw:*i32,o_sunk:*i32,o_fought:*i32)void {
    let hw:i32=80;let sunk:i32=0;let fought:i32=0;
    if(id==2){sunk=2;}
    if(id==3){sunk=3;}
    if(id==4){sunk=3;fought=1;}
    o_hw.*=hw;o_sunk.*=sunk;o_fought.*=fought;
}

// One fresh judged slot: build + deliberate. Returns slot/price.
fn rt_r6_fresh(s:*StStore,sk:i32,epb:i64,o_slot:*i32,o_price:*i32,o_epb:*i64)i32 {
    let hw:i32=0;let sunk:i32=0;let fought:i32=0;
    rt_r6_skel(sk,&hw,&sunk,&fought);
    return rt_build(s,hw,sunk,fought,0,hw,1,epb,o_slot,o_price,o_epb);
}

fn main()void {
    let fails:i32=0;
    let total:i32=0;
    let holes:i32=0;
    let sk:i32=1;
    while(sk<=4){
        let del:i32=0;
        while(del<=1){
            let att:i32=1;
            while(att<=13){
                total=total+1;
                let s:StStore=rt_new();
                let epb:i64=600000+(total as i64)*2000;
                let ok:i32=1;
                let verdict_ok:i32=0; // set to 1 when the attack objective holds
                if(att==1){
                    // cite p+1 fresh: the (p+1)-th must be 122; destroy must still work
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    let bad:i32=0;let saw122:i32=0;
                    let i:i32=0;
                    while(i<p+1){
                        let cr:i32=st_evidence(&s,slot,1,epb);
                        if(i<p && cr!=ST_OK){bad=bad+1;}
                        if(i==p && cr!=ST_REFUSED_CITEFULL){bad=bad+1;}
                        if(i==p && cr==ST_REFUSED_CITEFULL){saw122=1;}
                        epb=epb+1;i=i+1;
                    }
                    let rcd:i32=rt_destroy(&s,slot,del);
                    if(bad!=0 || saw122!=1 || rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==2){
                    // cite 2p+2 fresh: first p OK, rest 122; destroy works
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    let bad:i32=0;let n122:i32=0;
                    let i:i32=0;
                    while(i<2*p+2){
                        let cr:i32=st_evidence(&s,slot,1,epb);
                        if(i<p && cr!=ST_OK){bad=bad+1;}
                        if(i>=p && cr==ST_REFUSED_CITEFULL){n122=n122+1;}
                        if(i>=p && cr!=ST_REFUSED_CITEFULL){bad=bad+1;}
                        epb=epb+1;i=i+1;
                    }
                    let rcd:i32=rt_destroy(&s,slot,del);
                    if(bad!=0 || n122!=(p+2) || rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==3){
                    // destroy, re-add, over-cite p2+2 on the new judgment
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    if(rt_cite_n(&s,slot,p,epb,&epb)!=0){ok=0;}
                    if(rt_destroy(&s,slot,del)!=ST_OK){ok=0;}
                    let slot2:i32=-1;
                    if(st_add(&s,71,ST_REGION_USER,80,-1,&slot2)!=ST_OK){ok=0;}
                    if(st_justify(&s,slot2,1)!=ST_OK){ok=0;}
                    let p2:i32=-1;
                    if(st_deliberate(&s,slot2,&p2)!=ST_OK){ok=0;}
                    let bad:i32=0;let n122:i32=0;
                    let i:i32=0;
                    while(i<p2+2){
                        let cr:i32=st_evidence(&s,slot2,1,epb);
                        if(i<p2 && cr!=ST_OK){bad=bad+1;}
                        if(i>=p2 && cr==ST_REFUSED_CITEFULL){n122=n122+1;}
                        if(i>=p2 && cr!=ST_REFUSED_CITEFULL){bad=bad+1;}
                        epb=epb+1;i=i+1;
                    }
                    let rcd:i32=rt_destroy(&s,slot2,del);
                    if(bad!=0 || n122!=2 || rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==4){
                    // re-cited spent cites don't count toward fullness; fresh over-cite still 122
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    let e0:i64=epb;
                    if(rt_cite_n(&s,slot,p,epb,&epb)!=0){ok=0;}
                    if(rt_destroy(&s,slot,del)!=ST_OK){ok=0;}
                    let slot2:i32=-1;
                    if(st_add(&s,71,ST_REGION_USER,80,-1,&slot2)!=ST_OK){ok=0;}
                    if(st_justify(&s,slot2,1)!=ST_OK){ok=0;}
                    let p2:i32=-1;
                    if(st_deliberate(&s,slot2,&p2)!=ST_OK){ok=0;}
                    // re-cite all p spent eps: VARIANT A (adopted) refuses 121
                    // at CITE time (they never land, so they can't count as
                    // fresh toward fullness). Variant B: rc 0, not counted.
                    let bad:i32=0;
                    let i:i32=0;
                    while(i<p){
                        if(st_evidence(&s,slot2,1,e0+(i as i64))!=ST_REFUSED_CONSUMED){bad=bad+1;}
                        i=i+1;
                    }
                    // now p2+1 fresh: first p2 OK, last 122
                    let n122:i32=0;
                    let j:i32=0;
                    while(j<p2+1){
                        let cr:i32=st_evidence(&s,slot2,1,epb);
                        if(j<p2 && cr!=ST_OK){bad=bad+1;}
                        if(j==p2 && cr==ST_REFUSED_CITEFULL){n122=n122+1;}
                        if(j==p2 && cr!=ST_REFUSED_CITEFULL){bad=bad+1;}
                        epb=epb+1;j=j+1;
                    }
                    let rcd:i32=rt_destroy(&s,slot2,del);
                    if(bad!=0 || n122!=1 || rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==5){
                    // under-cite p-1 -> destroy 109 -> top up 1 -> destroy OK
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    if(rt_cite_n(&s,slot,p-1,epb,&epb)!=0){ok=0;}
                    let rc1:i32=rt_destroy(&s,slot,del);
                    if(rc1!=ST_REFUSED_EFFORT){ok=0;}
                    if(rt_cite_n(&s,slot,1,epb,&epb)!=0){ok=0;}
                    let rc2:i32=rt_destroy(&s,slot,del);
                    if(rc2!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==6){
                    // duplicate cite -> 111 (not 122); slot still usable
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    let cr1:i32=st_evidence(&s,slot,1,epb);
                    let cr2:i32=st_evidence(&s,slot,1,epb);
                    if(cr1!=ST_OK || cr2!=ST_REFUSED_DUPCITE){ok=0;}
                    if(rt_cite_n(&s,slot,p-1,epb+1,&epb)!=0){ok=0;}
                    let rcd:i32=rt_destroy(&s,slot,del);
                    if(rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==7){
                    // invalid ep (>=2^55) -> rejected (cl_bad), not 122; slot usable
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    let cr:i32=st_evidence(&s,slot,1,36028797018963968);
                    if(cr==ST_OK || cr==ST_REFUSED_CITEFULL){ok=0;}
                    if(rt_cite_n(&s,slot,p,epb,&epb)!=0){ok=0;}
                    let rcd:i32=rt_destroy(&s,slot,del);
                    if(rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==8){
                    // cite p, then p more fresh: all extra 122; destroy OK (not bricked)
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    if(rt_cite_n(&s,slot,p,epb,&epb)!=0){ok=0;}
                    let bad:i32=0;let n122:i32=0;
                    let i:i32=0;
                    while(i<p){
                        if(st_evidence(&s,slot,1,epb)!=ST_REFUSED_CITEFULL){bad=bad+1;}
                        else {n122=n122+1;}
                        epb=epb+1;i=i+1;
                    }
                    let rcd:i32=rt_destroy(&s,slot,del);
                    if(bad!=0 || n122!=p || rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==9){
                    // two slots: over-cite on B does not affect A's fullness accounting
                    let slotA:i32=-1;let pa:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slotA,&pa,&epb)!=0){ok=0;}
                    let slotB:i32=-1;let pb:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slotB,&pb,&epb)!=0){ok=0;}
                    if(slotB==slotA){ok=0;}
                    // over-cite on B
                    let i:i32=0;
                    while(i<pb+1){
                        let cr:i32=st_evidence(&s,slotB,1,epb);
                        if(i<pb && cr!=ST_OK){ok=0;}
                        if(i==pb && cr!=ST_REFUSED_CITEFULL){ok=0;}
                        epb=epb+1;i=i+1;
                    }
                    // A unaffected: cite pa, destroy OK
                    if(rt_cite_n(&s,slotA,pa,epb,&epb)!=0){ok=0;}
                    if(rt_destroy(&s,slotA,del)!=ST_OK){ok=0;}
                    // B still destructible at pb
                    if(rt_destroy(&s,slotB,del)!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==10){
                    // price-0 slot: any cite is over-cite -> 122; destroy with 0 cites OK
                    let s2:StStore=rt_new();
                    let slot:i32=-1;let p:i32=-1;
                    // weak fresh -> price 0
                    if(rt_build(&s2,20,0,0,0,20,1,epb,&slot,&p,&epb)!=0){ok=0;}
                    if(p!=0){ok=0;}
                    let cr:i32=st_evidence(&s2,slot,1,epb);
                    if(cr!=ST_REFUSED_CITEFULL){ok=0;}
                    let rcd:i32=rt_destroy(&s2,slot,del);
                    if(rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                    if(st_replay_check(&s2)!=ST_OK){ok=0;}
                }
                if(att==11){
                    // interleaved spent+fresh: spent never counts toward fullness
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    let e0:i64=epb;
                    if(rt_cite_n(&s,slot,p,epb,&epb)!=0){ok=0;}
                    if(rt_destroy(&s,slot,del)!=ST_OK){ok=0;}
                    let slot2:i32=-1;
                    if(st_add(&s,71,ST_REGION_USER,80,-1,&slot2)!=ST_OK){ok=0;}
                    if(st_justify(&s,slot2,1)!=ST_OK){ok=0;}
                    let p2:i32=-1;
                    if(st_deliberate(&s,slot2,&p2)!=ST_OK){ok=0;}
                    // re-cite all p spent eps: VARIANT A refuses 121 at cite
                    // time (never land, so they can't count toward fullness)
                    let bad:i32=0;
                    let i:i32=0;
                    while(i<p){
                        if(st_evidence(&s,slot2,1,e0+(i as i64))!=ST_REFUSED_CONSUMED){bad=bad+1;}
                        i=i+1;
                    }
                    // cite p2 fresh (the new judgment's price); then one more -> 122
                    let j:i32=0;
                    while(j<p2){
                        if(st_evidence(&s,slot2,1,epb)!=ST_OK){bad=bad+1;}
                        epb=epb+1;j=j+1;
                    }
                    let cr:i32=st_evidence(&s,slot2,1,epb);
                    if(cr!=ST_REFUSED_CITEFULL){bad=bad+1;}
                    let rcd:i32=rt_destroy(&s,slot2,del);
                    if(bad!=0 || rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==12){
                    // cite with a different valid code (2): still counts as a cite for fullness
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    let i:i32=0;
                    while(i<p){
                        if(st_evidence(&s,slot,2,epb)!=ST_OK){ok=0;}
                        epb=epb+1;i=i+1;
                    }
                    let cr:i32=st_evidence(&s,slot,2,epb);
                    if(cr!=ST_REFUSED_CITEFULL){ok=0;}
                    // destroy: cites present (code 0) — effort check counts cites, not codes
                    let rcd:i32=rt_destroy(&s,slot,del);
                    if(rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(att==13){
                    // re-cite spent ep on the SAME slot after destroy+re-add, then honest destroy
                    let slot:i32=-1;let p:i32=-1;
                    if(rt_r6_fresh(&s,sk,epb,&slot,&p,&epb)!=0){ok=0;}
                    let e0:i64=epb;
                    if(rt_cite_n(&s,slot,p,epb,&epb)!=0){ok=0;}
                    if(rt_destroy(&s,slot,del)!=ST_OK){ok=0;}
                    let slot2:i32=-1;
                    if(st_add(&s,71,ST_REGION_USER,80,-1,&slot2)!=ST_OK){ok=0;}
                    if(st_justify(&s,slot2,1)!=ST_OK){ok=0;}
                    let p2:i32=-1;
                    if(st_deliberate(&s,slot2,&p2)!=ST_OK){ok=0;}
                    // all spent re-cites: VARIANT A refuses 121 at cite time
                    // (they fund nothing because they never land)
                    let i:i32=0;
                    while(i<p){
                        if(st_evidence(&s,slot2,1,e0+(i as i64))!=ST_REFUSED_CONSUMED){ok=0;}
                        i=i+1;
                    }
                    // honest: p2 fresh -> destroy OK
                    if(rt_cite_n(&s,slot2,p2,epb,&epb)!=0){ok=0;}
                    let rcd:i32=rt_destroy(&s,slot2,del);
                    if(rcd!=ST_OK){ok=0;}
                    else {verdict_ok=1;}
                }
                if(ok==0 || verdict_ok==0){
                    _zag_print("RT_R6_FAIL sk=");rt_pi(sk as i64);
                    _zag_print(" del=");rt_pi(del as i64);
                    _zag_print(" att=");rt_pi(att as i64);
                    _zag_print(" ok=");rt_pi(ok as i64);
                    _zag_print(" vok=");rt_pi(verdict_ok as i64);
                    _zag_print("\n");
                    fails=fails+1;
                }
                if(st_replay_check(&s)!=ST_OK){
                    _zag_print("RT_R6_REPLAY_FAIL\n");
                    fails=fails+1;
                }
                att=att+1;
            }
            del=del+1;
        }
        sk=sk+1;
    }
    _zag_print("RT_R6 total=");rt_pi(total as i64);
    _zag_print(" fails=");rt_pi(fails as i64);
    _zag_print(" holes=");rt_pi(holes as i64);
    _zag_print("\n");
}

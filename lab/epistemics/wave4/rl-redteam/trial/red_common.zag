// red_common.zag — minimal shared helpers for the RT-1 red-team trial.
// Integer-only, zero RNG, no imports. Intrinsics used: _zag_print,
// _zag_println, _zag_i64_to_str (owned -> rc_free), rc_alloc.
// NOTE (AGENTS.md): never rc_free a non-owned pointer.

// Tiny local allocator on the proven _zag_malloc/_zag_free intrinsics
// (avoids importing the whole R33 IO substrate for three functions).
// Returned memory is zeroed by hand (never assume zeroed).
fn rc_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}
// NOTE (AGENTS.md): only rc_free what rc_alloc (or _zag_i64_to_str) returned —
// never a non-owned pointer such as _zag_arg(n).
fn rc_free(b:[]u8)void {if(b.len>0){_zag_free(_zag_slice_ptr(b));}}

// little-endian i32 pack/unpack on []u8 (playbook idiom)
fn rc_i32_get(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn rc_i32_set(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}

// floored modulo in [0,m) for m>0 (r34v3 idiom)
fn rc_mod(v:i32,m:i32)i32 {
    let q:i32=v/m;let r:i32=v-q*m;if(r<0){return r+m;}return r;
}

fn rc_num(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);_zag_print(s);rc_free(s);
}

// CL_CHECK-compatible check line: "CL_CHECK,<name>,<actual>,<expected>".
// Returns 1 on mismatch (accumulate into a failure counter).
fn rc_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("CL_CHECK,");_zag_print(name);_zag_print(",");
    rc_num(actual as i64);_zag_print(",");rc_num(expected as i64);_zag_println("");
    return (actual!=expected) as i32;
}

// Threshold checks for rubric bars (inequalities, not equalities).
// Emit CL_CHECKGE/CL_CHECKLE lines; the runner verifies actual>=min / actual<=max.
fn rc_report(tag:[]u8,val:i32)void {
    _zag_print(tag);_zag_print(",");rc_num(val as i64);_zag_println("");
}
fn rc_check_ge(name:[]u8,actual:i32,min:i32)i32 {
    _zag_print("CL_CHECKGE,");_zag_print(name);_zag_print(",");
    rc_num(actual as i64);_zag_print(",");rc_num(min as i64);_zag_println("");
    return (actual<min) as i32;
}
fn rc_check_le(name:[]u8,actual:i32,max:i32)i32 {
    _zag_print("CL_CHECKLE,");_zag_print(name);_zag_print(",");
    rc_num(actual as i64);_zag_print(",");rc_num(max as i64);_zag_println("");
    return (actual>max) as i32;
}

// The adversary's per-episode advertisement (its claims channel).
// adv: 4 x i32 advertised payoffs; claim: 4 bytes asserted genuineness.
// Both are fully adversary-controlled and may lie.
struct Offer {
    adv: []u8,
    claim: []u8
}
fn offer_init()Offer {
    let adv:[]u8=rc_alloc(16);
    let claim:[]u8=rc_alloc(4);
    let i:i32=0;while(i<16){adv[i]=0;i=i+1;}
    i=0;while(i<4){claim[i]=0;i=i+1;}
    return Offer{.adv=adv,.claim=claim};
}
fn offer_adv(o:*Offer,a:i32)i32 { return rc_i32_get(o.*.adv,a*4); }

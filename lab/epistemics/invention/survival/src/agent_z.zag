@import("world.zag")
// Arm Z (random baseline control). Fixed-seed LCG, documented:
//   state = (state * 1103515245 + 12345) mod 2^31  (via & 0x7fffffff on i64)
//   seed  = 777000 + variant_idx   (fixed; deterministic; NOT the AI)
// action = state mod 7 over the 7 primitives. No knowledge, no observation use.
// argv: 1=variant_path 2=variant_idx 3=rerun
fn main()i32 {
  let w:[]u8=world_new();
  if(world_init(w,_zag_arg(1))!=0){return 1;}
  let vi:i64=parse_i64(_zag_arg(2));
  let st:i64=777000+vi;
  let trace:[]u8=z_alloc(600);let nt:i32=0;
  while(p_get(w,0)<600 && p_get(w,4)==1){
    st=((st*1103515245+12345) & 0x7fffffff);
    let a:i64=st%7;
    trace[nt]=(a+48) as u8;nt=nt+1;
    step(w,a);
  }
  emit_result(w,"z",vi,parse_i64(_zag_arg(3)),trace,nt);
  z_free(trace);z_free(w);
  return 0;
}

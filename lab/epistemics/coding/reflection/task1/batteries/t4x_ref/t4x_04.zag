fn parse_int(s:[]u8)i64 {
    let v:i64=0;
    let i:i64=0;
    while(i<s.len){
        if(s[i]>=48){if(s[i]<=57){v=v*10+((s[i] as i64)-48);}}
        i=i+1;
    }
    return v;
}
fn main()void {
    let s:i64=0;
    let k:i64=1;
    while(1==1){
        let a:[]u8=_zag_arg(k);
        if(a.len==0){break;}
        let v:i64=parse_int(a);
        if(v==0){break;}
        s=s+v;
        k=k+1;
    }
    _zag_print(_zag_i64_to_str(s));
    _zag_print("\n");
    return;
}

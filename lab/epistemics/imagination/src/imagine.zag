}
fn ig_dump_emit(ar:[]u8, mode:i64, scene:i64, tag:[]u8) void {
    let n:i64 = ig_n(ar);
    let i:i64 = 0;
    while (i < n) {
        _zag_print(tag);
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(mode));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(scene));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(i));
        let w:i64 = 0;
        while (w < 10) {
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(ig_ew(ar, i, w)));
            w = w + 1;
        }
        _zag_println("");
        i = i + 1;
    }
}

// ---------------- Q3 PAIR ENCODINGS (frozen, PREREG.md) ----------------
// ---------------- Q3 PAIR ENCODINGS (rebuilt 2026-09-22 from Q3-SOURCES.md) ----------------
// Each design: 1-6 visual elements stating documented visual facts.
// Same facts in both codecs; no attribute chosen to push a score toward
// the known outcome. Side order is the frozen prereg table order.
// Pair order: 1 Gap(new,classic) 2 Tropicana(new,orig) 3 NewCoke(new,classic)
// 4 UC(monogram,seal) 5 CrackerBarrel(2025,oldtimer) 6 Starbucks(2011,1992)
// 7 Mastercard(2016,old) 8 Apple(1998mono,rainbow).
fn ig_pair(ar:[]u8, mode:i64, pair:i64, side:i64) void {
    ig_clear(ar);
    if (pair == 1) {
        // Gap: 2010 redesign (white field, black "Gap", small blue square
        // accent upper-right) vs classic navy box + white serif text.
        if (mode == 1) {
            if (side == 0) {
                ig_place(ar, 1, 1, 4, 2004, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 5, 2000, 3000, 3101, 3203, 0, 0, 0);
                ig_place(ar, 1, 1, 2, 1063, 3002, 3101, 3200, 0, 0, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 1, 4, 1061, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 4, 2004, 3000, 3101, 3203, 0, 0, 0);
            }
        } else {
            if (side == 0) {
                ig_place(ar, 1, 1, 350, 350, 300, 300, 255, 255, 255, 0);
                ig_place(ar, 1, 4, 500, 500, 200, 60, 20, 20, 20, 0);
                ig_place(ar, 1, 1, 700, 350, 80, 80, 30, 100, 200, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 1, 350, 350, 300, 300, 0, 51, 102, 0);
                ig_place(ar, 1, 4, 500, 500, 200, 60, 255, 255, 255, 0);
            }
        }
    }
    if (pair == 2) {
        // Tropicana: 2009 (tall pale-orange juice glass, small green text,
        // white cap) vs original (whole orange, red-white straw, green leaf).
        if (mode == 1) {
            if (side == 0) {
                ig_place(ar, 1, 1, 4, 1016, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 3, 1038, 3000, 3101, 3203, 0, 0, 0);
                ig_place(ar, 1, 1, 1, 2004, 3002, 3101, 3200, 0, 0, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 4, 1015, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 1, 1, 1003, 3002, 3101, 3203, 0, 0, 0);
                ig_place(ar, 1, 3, 2, 1039, 3001, 3101, 3203, 0, 0, 0);
            }
        } else {
            if (side == 0) {
                ig_place(ar, 1, 1, 400, 300, 200, 400, 245, 180, 100, 0);
                ig_place(ar, 1, 4, 350, 500, 40, 200, 60, 140, 70, 0);
                ig_place(ar, 1, 1, 400, 250, 200, 50, 250, 250, 250, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 500, 500, 300, 300, 240, 130, 30, 0);
                ig_place(ar, 1, 1, 500, 250, 40, 150, 220, 30, 30, 0);
                ig_place(ar, 1, 3, 700, 300, 80, 60, 40, 150, 60, 0);
            }
        }
    }
    if (pair == 3) {
        // New Coke (red field + white script + yellow "NEW!" starburst)
        // vs Coca-Cola Classic (red field + white script).
        if (mode == 1) {
            if (side == 0) {
                ig_place(ar, 1, 2, 4, 1003, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 4, 2004, 3000, 3101, 3203, 0, 0, 0);
                ig_place(ar, 1, 3, 2, 1029, 3001, 3101, 3203, 0, 0, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 4, 1003, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 4, 2004, 3000, 3101, 3203, 0, 0, 0);
            }
        } else {
            if (side == 0) {
                ig_place(ar, 1, 2, 500, 500, 400, 400, 220, 20, 20, 0);
                ig_place(ar, 1, 4, 500, 500, 300, 80, 255, 255, 255, 0);
                ig_place(ar, 1, 3, 750, 250, 90, 90, 250, 220, 40, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 500, 500, 400, 400, 220, 20, 20, 0);
                ig_place(ar, 1, 4, 500, 500, 300, 80, 255, 255, 255, 0);
            }
        }
    }
    if (pair == 4) {
        // UC 2012 monogram (bold "UC", blue-to-gold gradient, no ring)
        // vs century-old seal (blue disc, gold book, "Fiat Lux" text).
        if (mode == 1) {
            if (side == 0) {
                ig_place(ar, 1, 4, 4, 1063, 3000, 3101, 3203, 0, 0, 0);
                ig_place(ar, 1, 4, 5, 1021, 3000, 3101, 3203, 0, 0, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 4, 1061, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 1, 4, 1021, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 7, 2004, 3000, 3101, 3203, 0, 0, 0);
            }
        } else {
            if (side == 0) {
                ig_place(ar, 1, 4, 450, 500, 120, 200, 40, 80, 180, 0);
                ig_place(ar, 1, 4, 600, 500, 120, 200, 210, 150, 50, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 500, 500, 420, 420, 10, 40, 120, 0);
                ig_place(ar, 1, 1, 500, 500, 180, 120, 200, 160, 60, 0);
                ig_place(ar, 1, 4, 500, 750, 220, 50, 255, 255, 255, 0);
            }
        }
    }
    if (pair == 5) {
        // Cracker Barrel 2025 (flat gold wordmark only) vs old-timer
        // (brown barrel, Uncle Herschel figure, gold serif text).
        if (mode == 1) {
            if (side == 0) {
                ig_place(ar, 1, 4, 4, 1021, 3000, 3101, 3203, 0, 0, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 3, 1012, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 1, 4, 1018, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 7, 1021, 3000, 3101, 3203, 0, 0, 0);
            }
        } else {
            if (side == 0) {
                ig_place(ar, 1, 4, 500, 500, 400, 80, 200, 160, 70, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 350, 500, 220, 220, 110, 70, 40, 0);
                ig_place(ar, 1, 1, 550, 450, 120, 220, 80, 50, 30, 0);
                ig_place(ar, 1, 4, 500, 800, 300, 60, 210, 170, 80, 0);
            }
        }
    }
    if (pair == 6) {
        // Starbucks 2011 (green disc, white siren, no text/ring)
        // vs 1992 (green ring + ring text, black inner field).
        if (mode == 1) {
            if (side == 0) {
                ig_place(ar, 1, 2, 4, 1037, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 2, 4, 2004, 3003, 3100, 3200, 0, 0, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 4, 1037, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 1, 2004, 3000, 3101, 3203, 0, 0, 0);
                ig_place(ar, 1, 2, 4, 2000, 3003, 3100, 3200, 0, 0, 0);
            }
        } else {
            if (side == 0) {
                ig_place(ar, 1, 2, 500, 500, 400, 400, 0, 115, 75, 0);
                ig_place(ar, 1, 2, 500, 500, 240, 240, 255, 255, 255, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 500, 500, 420, 420, 0, 115, 75, 0);
                ig_place(ar, 1, 4, 500, 250, 300, 60, 255, 255, 255, 0);
                ig_place(ar, 1, 2, 500, 500, 260, 260, 15, 15, 15, 0);
            }
        }
    }
    if (pair == 7) {
        // Mastercard 2016 (flat red + amber circles, solid overlap,
        // lowercase wordmark below) vs prior (striped comb overlap,
        // "MasterCard" across the middle).
        if (mode == 1) {
            if (side == 0) {
                ig_place(ar, 1, 2, 3, 1003, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 2, 5, 1021, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 7, 2000, 3000, 3101, 3203, 0, 0, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 3, 1003, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 2, 5, 1027, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 1, 4, 2003, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 4, 4, 2004, 3000, 3101, 3203, 0, 0, 0);
            }
        } else {
            if (side == 0) {
                ig_place(ar, 1, 2, 400, 450, 260, 260, 235, 0, 40, 0);
                ig_place(ar, 1, 2, 600, 450, 260, 260, 245, 130, 30, 0);
                ig_place(ar, 1, 4, 500, 750, 300, 60, 20, 20, 20, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 2, 400, 450, 260, 260, 235, 0, 40, 0);
                ig_place(ar, 1, 2, 600, 450, 260, 260, 245, 200, 30, 0);
                ig_place(ar, 1, 1, 470, 420, 60, 60, 200, 200, 200, 0);
                ig_place(ar, 1, 4, 500, 450, 280, 60, 255, 255, 255, 0);
            }
        }
    }
    if (pair == 8) {
        // Apple: 1998 monochrome (black apple silhouette, bite notch)
        // vs rainbow (six horizontal stripes: green/yellow/orange/red/
        // violet/blue, top to bottom).
        if (mode == 1) {
            if (side == 0) {
                ig_place(ar, 1, 2, 4, 2000, 3003, 3100, 3200, 0, 0, 0);
                ig_place(ar, 1, 2, 5, 2004, 3003, 3100, 3200, 0, 0, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 1, 4, 1039, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 1, 4, 1027, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 1, 4, 1015, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 1, 4, 1003, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 1, 4, 1069, 3002, 3101, 3200, 0, 0, 0);
                ig_place(ar, 1, 1, 4, 1063, 3002, 3101, 3200, 0, 0, 0);
            }
        } else {
            if (side == 0) {
                ig_place(ar, 1, 2, 500, 500, 360, 360, 10, 10, 10, 0);
                ig_place(ar, 1, 2, 640, 420, 80, 80, 255, 255, 255, 0);
            }
            if (side == 1) {
                ig_place(ar, 1, 1, 400, 250, 200, 80, 60, 180, 75, 0);
                ig_place(ar, 1, 1, 400, 330, 200, 80, 240, 200, 40, 0);
                ig_place(ar, 1, 1, 400, 410, 200, 80, 240, 130, 30, 0);
                ig_place(ar, 1, 1, 400, 490, 200, 80, 220, 40, 40, 0);
                ig_place(ar, 1, 1, 400, 570, 200, 80, 130, 60, 180, 0);
                ig_place(ar, 1, 1, 400, 650, 200, 80, 50, 90, 200, 0);
            }
        }
    }
}

// ---------------- DRIVERS ----------------
fn ig_drv_q2(ar:[]u8, mode:i64) void {
    let b:i64 = 1;
    while (b <= 6) {
        let t:i64 = ig_gen(ar, mode, b);
        _zag_print("Q2 ");
        _zag_print(_zag_i64_to_str(mode));
        _zag_print(" ");
        _zag_print(_zag_i64_to_str(b));
        _zag_print(" ");
        _zag_println(_zag_i64_to_str(t));
        ig_dump_emit(ar, mode, b, "E");
        b = b + 1;
    }
}
fn ig_drv_q3(ar:[]u8, mode:i64) void {
    let p:i64 = 1;
    while (p <= 8) {
        let s:i64 = 0;
        while (s <= 1) {
            ig_pair(ar, mode, p, s);
            let t:i64 = ig_taste(ar, mode);
            _zag_print("Q3 ");
            _zag_print(_zag_i64_to_str(mode));
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(p));
            _zag_print(" ");
            _zag_print(_zag_i64_to_str(s));
            _zag_print(" ");
            _zag_println(_zag_i64_to_str(t));
            s = s + 1;
        }
        p = p + 1;
    }
}
fn ig_scene_num(a3:[]u8) i64 {
    if (_zag_strcmp(a3, "1") == 1) { return 1; }
    if (_zag_strcmp(a3, "2") == 1) { return 2; }
    if (_zag_strcmp(a3, "3") == 1) { return 3; }
    if (_zag_strcmp(a3, "4") == 1) { return 4; }
    if (_zag_strcmp(a3, "5") == 1) { return 5; }
    if (_zag_strcmp(a3, "6") == 1) { return 6; }
    if (_zag_strcmp(a3, "7") == 1) { return 7; }
    if (_zag_strcmp(a3, "8") == 1) { return 8; }
    if (_zag_strcmp(a3, "9") == 1) { return 9; }
    if (_zag_strcmp(a3, "10") == 1) { return 10; }
    if (_zag_strcmp(a3, "11") == 1) { return 11; }
    if (_zag_strcmp(a3, "12") == 1) { return 12; }
    return 0;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    let mode:i64 = -1;
    if (_zag_strcmp(a2, "m") == 1) { mode = 0; }
    if (_zag_strcmp(a2, "h") == 1) { mode = 1; }
    if (mode < 0) {
        _zag_println("error=mode-must-be-m-or-h");
        return 1;
    }
    let ar:[]u8 = nio_alloc(4096);
    ig_new(ar);
    if (_zag_strcmp(a1, "q1") == 1) {
        if (_zag_strcmp(a3, "all") == 1) {
            let s:i64 = 1;
            while (s <= 12) {
                ig_q1_run(ar, mode, s);
                s = s + 1;
            }
        } else {
            let sn:i64 = ig_scene_num(a3);
            if (sn == 0) {
                _zag_println("error=bad-scene");
                return 1;
            }
            ig_q1_run(ar, mode, sn);
        }
        return 0;
    }
    if (_zag_strcmp(a1, "q1v") == 1) {
        if (_zag_strcmp(a3, "all") == 1) {
            let s3:i64 = 1;
            while (s3 <= 4) {
                ig_q1v_run(ar, mode, s3);
                s3 = s3 + 1;
            }
        } else {
            let sn3:i64 = ig_scene_num(a3);
            if (sn3 == 0 || sn3 > 4) {
                _zag_println("error=bad-scene");
                return 1;
            }
            ig_q1v_run(ar, mode, sn3);
        }
        return 0;
    }
    if (_zag_strcmp(a1, "dump") == 1) {
        if (_zag_strcmp(a3, "all") == 1) {
            let s2:i64 = 1;
            while (s2 <= 12) {
                ig_q1_pre(ar, mode, s2);
                ig_dump_emit(ar, mode, s2, "D");
                s2 = s2 + 1;
            }
        } else {
            let sn2:i64 = ig_scene_num(a3);
            if (sn2 == 0) {
                _zag_println("error=bad-scene");
                return 1;
            }
            ig_q1_pre(ar, mode, sn2);
            ig_dump_emit(ar, mode, sn2, "D");
        }
        return 0;
    }
    if (_zag_strcmp(a1, "q2") == 1) {
        ig_drv_q2(ar, mode);
        return 0;
    }
    if (_zag_strcmp(a1, "q3") == 1) {
        ig_drv_q3(ar, mode);
        return 0;
    }
    _zag_println("error=unknown-cmd");
    return 1;
}

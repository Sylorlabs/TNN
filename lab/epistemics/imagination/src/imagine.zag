// ============================================================
// imagine.zag — IMAGINATION MECHANISM (pure Zag, zero RNG).
//
// The imagination partition: a deliberately-managed arena holding
// a SCENE of up to 32 ELEMENTS. Two codecs over the same partition:
//   MACHINE-WAY: raw values (x/y/w/h 0..1000, r/g/b 0..255,
//                freq_hz, dur_ms, cm coords, sizes).
//   HUMAN-WAY:   qualitative percept handles from the fixed
//                155-handle vocabulary (color 1000-1071/2000-2004,
//                shape tuples, pitch bins 4000-4047, timbre
//                5000-5003, zones 0-8, relation handles) plus
//                FIXED relation tables. The human path never
//                touches a raw sensory number.
//
// Element word layout (10 words each, little-endian u8 arena):
//   w0 domain (1=V 2=A 3=S 4=VIDEO), w1 kind, w2..w9 = a1..a8.
//   V machine: kind 1=rect 2=circle 3=tri 4=text;
//              a1=x a2=y a3=w a4=h a5=r a6=g a7=b.
//   V human:   a1=zone a2=color a3=corners a4=curve a5=sym.
//   A machine: kind 1=note; a1=freq_hz a2=dur_ms a3=amp.
//   A human:   a1=pitch_bin a2=timbre.
//   S machine: kind 1=block 2=stone; a1=x a2=y a3=z a4=size.
//   S human:   a1=zone a2=rel a3=relt a4=sizerank.
//   VIDEO (4): one element = one FRAME of a temporal scene; kind 1=shot.
//   V machine: a1=frame_idx a2=x a3=y a4=r a5=g a6=b a7=dx a8=dy
//              (per-frame displacement of the subject centroid).
//   V human:   a1=frame_idx a2=zone a3=color a4=dir_handle(6000-6008)
//              a5=speed_handle(6100-6102) a6=corners a7=curve a8=sym.
// Relation codes: 0 NONE 1 LEFT_OF 2 RIGHT_OF 3 ABOVE 4 BELOW
//                 5 STACKED_ON 6 NEAR.
// ============================================================
@import("../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------------- arena ----------------
fn ig_put32(ar:[]u8, w:i64, v:i64) void {
    let at:i64 = w * 4;
    ar[at] = (v & 255) as u8;
    ar[at+1] = ((v >> 8) & 255) as u8;
    ar[at+2] = ((v >> 16) & 255) as u8;
    ar[at+3] = ((v >> 24) & 255) as u8;
}
fn ig_get32(ar:[]u8, w:i64) i64 {
    let at:i64 = w * 4;
    return (ar[at] as i64) + (ar[at+1] as i64) * 256 + (ar[at+2] as i64) * 65536 + (ar[at+3] as i64) * 16777216;
}
fn ig_n(ar:[]u8) i64 { return ig_get32(ar, 0); }
fn ig_clear(ar:[]u8) void { ig_put32(ar, 0, 0); }
fn ig_new(ar:[]u8) void { ig_clear(ar); }
fn ig_ew(ar:[]u8, i:i64, s:i64) i64 { return ig_get32(ar, 1 + i * 10 + s); }
fn ig_ewput(ar:[]u8, i:i64, s:i64, v:i64) void { ig_put32(ar, 1 + i * 10 + s, v); }
fn ig_eattr(ar:[]u8, i:i64, slot:i64, v:i64) void { ig_ewput(ar, i, slot, v); }
fn ig_place(ar:[]u8, dom:i64, kind:i64, a1:i64, a2:i64, a3:i64, a4:i64, a5:i64, a6:i64, a7:i64, a8:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n >= 32) { return -1; }
    ig_ewput(ar, n, 0, dom);
    ig_ewput(ar, n, 1, kind);
    ig_ewput(ar, n, 2, a1);
    ig_ewput(ar, n, 3, a2);
    ig_ewput(ar, n, 4, a3);
    ig_ewput(ar, n, 5, a4);
    ig_ewput(ar, n, 6, a5);
    ig_ewput(ar, n, 7, a6);
    ig_ewput(ar, n, 8, a7);
    ig_ewput(ar, n, 9, a8);
    ig_put32(ar, 0, n + 1);
    return n;
}
fn ig_abs(x:i64) i64 {
    if (x < 0) { return 0 - x; }
    return x;
}
fn ig_min(a:i64, b:i64) i64 {
    if (a < b) { return a; }
    return b;
}
fn ig_max(a:i64, b:i64) i64 {
    if (a > b) { return a; }
    return b;
}

// ---------------- color vocabulary (human path) ----------------
// Chromatic: 1000 + hue*6 + light*2 + sat. Achromatic: 2000..2004.
fn ig_chroma(h:i64) i32 {
    if (h >= 1000 && h < 1072) { return 1; }
    return 0;
}
fn ig_hue(h:i64) i64 { return (h - 1000) / 6; }
fn ig_light(h:i64) i64 { return ((h - 1000) % 6) / 2; }
fn ig_sat(h:i64) i64 { return (h - 1000) % 2; }
fn ig_achrank(h:i64) i64 {
    let i:i64 = h - 2000;
    if (i <= 1) { return 0; }
    if (i == 2) { return 1; }
    return 2;
}
fn ig_lrank(h:i64) i64 {
    if (ig_chroma(h) == 1) { return ig_light(h); }
    return ig_achrank(h);
}
fn ig_wheeldist(a:i64, b:i64) i64 {
    let d:i64 = ig_abs(a - b);
    if (d > 6) { d = 12 - d; }
    return d;
}
// Percept color distance, per b_percept PERCEPT_DESIGN.md (fixed table).
fn ig_cdist(h1:i64, h2:i64) i64 {
    let c1:i32 = ig_chroma(h1);
    let c2:i32 = ig_chroma(h2);
    if (c1 == 1 && c2 == 1) {
        return ig_wheeldist(ig_hue(h1), ig_hue(h2)) + ig_abs(ig_light(h1) - ig_light(h2)) + ig_abs(ig_sat(h1) - ig_sat(h2));
    }
    if (c1 == 0 && c2 == 0) { return ig_abs(h1 - h2); }
    return 4 + ig_abs(ig_lrank(h1) - ig_lrank(h2));
}
// Warmth sector: 2 warm (hues 0-4), 1 neutral (5-7, achromatic), 0 cool (8-11).
fn ig_warmth(h:i64) i64 {
    if (ig_chroma(h) == 0) { return 1; }
    let hu:i64 = ig_hue(h);
    if (hu <= 4) { return 2; }
    if (hu <= 7) { return 1; }
    return 0;
}

// ---------------- zones ----------------
fn ig_zcol(z:i64) i64 { return z % 3; }
fn ig_zrow(z:i64) i64 { return z / 3; }
fn ig_zmirror(z:i64) i64 { return (z / 3) * 3 + (2 - (z % 3)); }
fn ig_zone_of_xy(x:i64, y:i64) i64 {
    let cx:i64 = x / 334;
    let cy:i64 = y / 334;
    if (cx > 2) { cx = 2; }
    if (cy > 2) { cy = 2; }
    return cy * 3 + cx;
}
fn ig_zcx(z:i64) i64 { return 167 + 333 * (z % 3); }
fn ig_zcy(z:i64) i64 { return 167 + 333 * (z / 3); }
fn ig_cheby(a:i64, b:i64) i64 {
    let dx:i64 = ig_abs(ig_zcol(a) - ig_zcol(b));
    let dy:i64 = ig_abs(ig_zrow(a) - ig_zrow(b));
    if (dx > dy) { return dx; }
    return dy;
}
fn ig_zone_of(ar:[]u8, i:i64, mode:i64) i64 {
    if (mode == 1) { return ig_ew(ar, i, 2); }
    return ig_zone_of_xy(ig_ew(ar, i, 2), ig_ew(ar, i, 3));
}

// ---------------- pitch (semitone table for machine tension) ----------------
// T[k] = round(1000 * 2^((k-0.5)/12)), k=1..24.
fn ig_st_thresh(k:i64) i64 {
    if (k == 1) { return 972; }
    if (k == 2) { return 1091; }
    if (k == 3) { return 1155; }
    if (k == 4) { return 1224; }
    if (k == 5) { return 1297; }
    if (k == 6) { return 1374; }
    if (k == 7) { return 1456; }
    if (k == 8) { return 1542; }
    if (k == 9) { return 1634; }
    if (k == 10) { return 1731; }
    if (k == 11) { return 1834; }
    if (k == 12) { return 1943; }
    if (k == 13) { return 2059; }
    if (k == 14) { return 2181; }
    if (k == 15) { return 2311; }
    if (k == 16) { return 2448; }
    if (k == 17) { return 2594; }
    if (k == 18) { return 2748; }
    if (k == 19) { return 2911; }
    if (k == 20) { return 3084; }
    if (k == 21) { return 3268; }
    if (k == 22) { return 3462; }
    if (k == 23) { return 3668; }
    return 3886;
}
fn ig_semitones(fa:i64, fb:i64) i64 {
    let lo:i64 = ig_min(fa, fb);
    let hi:i64 = ig_max(fa, fb);
    if (lo <= 0) { return 99; }
    let r:i64 = hi * 1000 / lo;
    let s:i64 = 0;
    let k:i64 = 1;
    while (k <= 24) {
        if (r >= ig_st_thresh(k)) { s = k; }
        k = k + 1;
    }
    return s;
}
// Tension code from absolute semitone distance: 0->0, 1->2, 2->1, 3-4->1, 5+->3.
fn ig_tcode(st:i64) i64 {
    if (st == 0) { return 0; }
    if (st == 1) { return 2; }
    if (st == 2) { return 1; }
    if (st <= 4) { return 1; }
    return 3;
}

// ---------------- QUERIES (answered from the partition only) ----------------
// mode: 0 = machine (values), 1 = human (percept handles).

fn ig_q_zonecount(ar:[]u8, z:i64, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    let c:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        if (ig_zone_of(ar, i, mode) == z) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

// farthest pair by zone Chebyshev distance; tie -> smallest i, then j.
fn ig_q_farthest(ar:[]u8, mode:i64, o1:*i64, o2:*i64) void {
    let n:i64 = ig_n(ar);
    let bi:i64 = 0;
    let bj:i64 = 1;
    if (n < 2) { bj = 0; }
    let bd:i64 = -1;
    let i:i64 = 0;
    while (i < n) {
        let j:i64 = i + 1;
        while (j < n) {
            let d:i64 = ig_cheby(ig_zone_of(ar, i, mode), ig_zone_of(ar, j, mode));
            if (d > bd) { bd = d; bi = i; bj = j; }
            j = j + 1;
        }
        i = i + 1;
    }
    o1.* = bi;
    o2.* = bj;
}

fn ig_q_warmest(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n == 0) { return -1; }
    let bi:i64 = 0;
    let i:i64 = 1;
    if (mode == 1) {
        let bw:i64 = ig_warmth(ig_ew(ar, 0, 3));
        while (i < n) {
            let w:i64 = ig_warmth(ig_ew(ar, i, 3));
            if (w > bw) { bw = w; bi = i; }
            i = i + 1;
        }
    } else {
        let bw2:i64 = ig_ew(ar, 0, 6) - ig_ew(ar, 0, 8);
        while (i < n) {
            let w2:i64 = ig_ew(ar, i, 6) - ig_ew(ar, i, 8);
            if (w2 > bw2) { bw2 = w2; bi = i; }
            i = i + 1;
        }
    }
    return bi;
}

// harmony 0..400 between visual elements a,b.
fn ig_q_harmony(ar:[]u8, a:i64, b:i64, mode:i64) i64 {
    if (mode == 1) {
        let d:i64 = ig_cdist(ig_ew(ar, a, 3), ig_ew(ar, b, 3));
        let h:i64 = 400 - 50 * d;
        if (h < 0) { h = 0; }
        return h;
    }
    let dd:i64 = ig_abs(ig_ew(ar, a, 6) - ig_ew(ar, b, 6)) + ig_abs(ig_ew(ar, a, 7) - ig_ew(ar, b, 7)) + ig_abs(ig_ew(ar, a, 8) - ig_ew(ar, b, 8));
    let h2:i64 = 400 - dd * 400 / 765;
    if (h2 < 0) { h2 = 0; }
    return h2;
}

fn ig_q_leftmost(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n == 0) { return -1; }
    let bi:i64 = 0;
    let i:i64 = 1;
    if (mode == 1) {
        let bc:i64 = ig_zcol(ig_ew(ar, 0, 2));
        while (i < n) {
            let c:i64 = ig_zcol(ig_ew(ar, i, 2));
            if (c < bc) { bc = c; bi = i; }
            i = i + 1;
        }
    } else {
        let bx:i64 = ig_ew(ar, 0, 2);
        while (i < n) {
            let x:i64 = ig_ew(ar, i, 2);
            if (x < bx) { bx = x; bi = i; }
            i = i + 1;
        }
    }
    return bi;
}

// audio contour code: 4 rising 3 arch 2 flat 1 falling 0 jagged.
fn ig_q_contour(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n < 2) { return 2; }
    let i:i64 = 0;
    let up:i64 = 0;
    let dn:i64 = 0;
    let fl:i64 = 0;
    while (i < n - 1) {
        let a:i64 = ig_ew(ar, i, 2);
        let b:i64 = ig_ew(ar, i + 1, 2);
        if (b > a) { up = 1; }
        if (b < a) { dn = 1; }
        if (b == a) { fl = 1; }
        i = i + 1;
    }
    let first:i64 = ig_ew(ar, 0, 2);
    let last:i64 = ig_ew(ar, n - 1, 2);
    if (up == 1 && dn == 0 && last > first) { return 4; }
    if (dn == 1 && up == 0 && last < first) { return 1; }
    if (up == 0 && dn == 0) { return 2; }
    // arch: rises then falls, single peak, no flats breaking it
    if (up == 1 && dn == 1) {
        let pk:i64 = 0;
        let k:i64 = 0;
        while (k < n) {
            if (ig_ew(ar, k, 2) >= ig_ew(ar, pk, 2)) { pk = k; }
            k = k + 1;
        }
        if (pk > 0 && pk < n - 1) {
            let ok:i64 = 1;
            let m:i64 = 0;
            while (m < pk) {
                if (ig_ew(ar, m + 1, 2) < ig_ew(ar, m, 2)) { ok = 0; }
                m = m + 1;
            }
            m = pk;
            while (m < n - 1) {
                if (ig_ew(ar, m + 1, 2) > ig_ew(ar, m, 2)) { ok = 0; }
                m = m + 1;
            }
            if (ok == 1) { return 3; }
        }
    }
    return 0;
}

// index k of adjacent pair with max step; tie -> lowest k.
fn ig_q_maxstep(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n < 2) { return -1; }
    let bk:i64 = 0;
    let bd:i64 = -1;
    let k:i64 = 0;
    while (k < n - 1) {
        let d:i64 = 0;
        if (mode == 1) {
            d = ig_abs(ig_ew(ar, k, 2) - ig_ew(ar, k + 1, 2));
        } else {
            d = ig_abs(ig_ew(ar, k, 2) - ig_ew(ar, k + 1, 2));
        }
        if (d > bd) { bd = d; bk = k; }
        k = k + 1;
    }
    return bk;
}

fn ig_q_tension(ar:[]u8, a:i64, b:i64, mode:i64) i64 {
    if (mode == 1) {
        let d:i64 = ig_abs(ig_ew(ar, a, 2) - ig_ew(ar, b, 2));
        return ig_tcode(d);
    }
    return ig_tcode(ig_semitones(ig_ew(ar, a, 2), ig_ew(ar, b, 2)));
}

fn ig_q_laststable(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n < 2) { return 1; }
    if (ig_q_tension(ar, n - 2, n - 1, mode) == 0) { return 1; }
    return 0;
}

// struct support: machine = z==0 or a qualifying block below;
// human = NONE, or STACKED_ON chain ending at NONE.
fn ig_q_support(ar:[]u8, i:i64, mode:i64) i64 {
    if (mode == 1) {
        let rel:i64 = ig_ew(ar, i, 3);
        let cur:i64 = i;
        let guard:i64 = 0;
        while (rel == 5 && guard < 40) {
            cur = ig_ew(ar, cur, 4);
            if (cur < 0 || cur >= ig_n(ar)) { return 0; }
            rel = ig_ew(ar, cur, 3);
            guard = guard + 1;
        }
        if (rel == 0) { return 1; }
        return 0;
    }
    let z:i64 = ig_ew(ar, i, 4);
    if (z == 0) { return 1; }
    let n:i64 = ig_n(ar);
    let j:i64 = 0;
    while (j < n) {
        if (j != i) {
            let dx:i64 = ig_abs(ig_ew(ar, j, 2) - ig_ew(ar, i, 2));
            let dy:i64 = ig_abs(ig_ew(ar, j, 3) - ig_ew(ar, i, 3));
            let ztop:i64 = ig_ew(ar, j, 4) + ig_ew(ar, j, 5);
            if (dx <= 60 && dy <= 60 && ztop >= z - 20 && ig_ew(ar, j, 5) >= ig_ew(ar, i, 5)) { return 1; }
        }
        j = j + 1;
    }
    return 0;
}

fn ig_inv_rel(r:i64) i64 {
    if (r == 1) { return 2; }
    if (r == 2) { return 1; }
    if (r == 3) { return 4; }
    if (r == 4) { return 3; }
    if (r == 5) { return 4; }
    return r;
}

// relation of a to b.
fn ig_q_relation(ar:[]u8, a:i64, b:i64, mode:i64) i64 {
    if (mode == 1) {
        let ra:i64 = ig_ew(ar, a, 3);
        let ta:i64 = ig_ew(ar, a, 4);
        if (ta == b && ra != 0) { return ra; }
        let rb:i64 = ig_ew(ar, b, 3);
        let tb:i64 = ig_ew(ar, b, 4);
        if (tb == a && rb != 0) { return ig_inv_rel(rb); }
        let za:i64 = ig_ew(ar, a, 2);
        let zb:i64 = ig_ew(ar, b, 2);
        if (za == zb) { return 6; }
        let ca:i64 = ig_zcol(za);
        let cb:i64 = ig_zcol(zb);
        if (ca < cb) { return 1; }
        if (ca > cb) { return 2; }
        let ra2:i64 = ig_zrow(za);
        let rb2:i64 = ig_zrow(zb);
        if (ra2 < rb2) { return 3; }
        return 4;
    }
    let xa:i64 = ig_ew(ar, a, 2);
    let ya:i64 = ig_ew(ar, a, 3);
    let za2:i64 = ig_ew(ar, a, 4);
    let xb:i64 = ig_ew(ar, b, 2);
    let yb:i64 = ig_ew(ar, b, 3);
    let zb2:i64 = ig_ew(ar, b, 4);
    let dx:i64 = xb - xa;
    let dy:i64 = yb - ya;
    if (za2 > zb2 && ig_abs(dx) <= 60 && ig_abs(dy) <= 60) { return 5; }
    if (zb2 > za2 && ig_abs(dx) <= 60 && ig_abs(dy) <= 60) { return 4; }
    if (ig_abs(dx) < 80 && ig_abs(dy) < 80) { return 6; }
    if (ig_abs(dx) >= ig_abs(dy)) {
        if (dx > 0) { return 1; }
        return 2;
    }
    if (dy > 0) { return 4; }
    return 3;
}

fn ig_q_topmost(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n == 0) { return -1; }
    if (mode == 1) {
        let bi:i64 = 0;
        let bl:i64 = -1;
        let i:i64 = 0;
        while (i < n) {
            let len:i64 = 0;
            let cur:i64 = i;
            let guard:i64 = 0;
            while (ig_ew(ar, cur, 3) == 5 && guard < 40) {
                len = len + 1;
                cur = ig_ew(ar, cur, 4);
                if (cur < 0 || cur >= n) { cur = i; guard = 99; }
                guard = guard + 1;
            }
            if (len > bl) { bl = len; bi = i; }
            i = i + 1;
        }
        return bi;
    }
    let bj:i64 = 0;
    let bz:i64 = ig_ew(ar, 0, 4);
    let j:i64 = 1;
    while (j < n) {
        let z:i64 = ig_ew(ar, j, 4);
        if (z > bz) { bz = z; bj = j; }
        j = j + 1;
    }
    return bj;
}

// ---------------- TASTE (frozen design-quality functions, PREREG.md) ----------------
// Visual machine: ALIGNMENT 400 + SYMMETRY 300 + CONTRAST 300.
// Visual human:   HARMONY 400 + BALANCE 300 + SIMPLICITY 300.
// Audio machine:  CONSONANCE 500 + REGULARITY 500.
// Audio human:    CONTOUR 500 + STABILITY 500.
// Struct machine: GROUNDING 500 + GRID 500.
// Struct human:   SUPPORT 500 + SPREAD 500.

fn ig_taste_visual(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n == 0) { return 0; }
    if (mode == 1) {
        // HARMONY: mean over pairs of max(0, 400-50*cdist).
        let hs:i64 = 0;
        let np:i64 = 0;
        let i:i64 = 0;
        while (i < n) {
            let j:i64 = i + 1;
            while (j < n) {
                let d:i64 = ig_cdist(ig_ew(ar, i, 3), ig_ew(ar, j, 3));
                let h:i64 = 400 - 50 * d;
                if (h < 0) { h = 0; }
                hs = hs + h;
                np = np + 1;
                j = j + 1;
            }
            i = i + 1;
        }
        let harmony:i64 = 400;
        if (np > 0) { harmony = hs / np; }
        // BALANCE: mirror-zone same-color occupancy.
        let b:i64 = 0;
        i = 0;
        while (i < n) {
            let mz:i64 = ig_zmirror(ig_ew(ar, i, 2));
            let col:i64 = ig_ew(ar, i, 3);
            let j2:i64 = 0;
            let found:i64 = 0;
            while (j2 < n) {
                if (ig_ew(ar, j2, 2) == mz && ig_ew(ar, j2, 3) == col) { found = 1; }
                j2 = j2 + 1;
            }
            if (found == 1) { b = b + 1; }
            i = i + 1;
        }
        let balance:i64 = 300 * b / n;
        // SIMPLICITY.
        let simp:i64 = 0;
        if (n <= 9) { simp = 300 * (9 - n) / 8; }
        return harmony + balance + simp;
    }
    // machine
    let c:i64 = 0;
    let i2:i64 = 0;
    while (i2 < n) {
        if (ig_ew(ar, i2, 2) % 50 == 0) { c = c + 1; }
        if (ig_ew(ar, i2, 3) % 50 == 0) { c = c + 1; }
        i2 = i2 + 1;
    }
    let align:i64 = 400 * c / (2 * n);
    let m:i64 = 0;
    i2 = 0;
    while (i2 < n) {
        let mx:i64 = 1000 - ig_ew(ar, i2, 2);
        let my:i64 = ig_ew(ar, i2, 3);
        let j3:i64 = 0;
        let ok:i64 = 0;
        while (j3 < n) {
            let same_kind:i64 = 0;
            if (ig_ew(ar, j3, 1) == ig_ew(ar, i2, 1)) { same_kind = 1; }
            let dc:i64 = ig_abs(ig_ew(ar, j3, 6) - ig_ew(ar, i2, 6)) + ig_abs(ig_ew(ar, j3, 7) - ig_ew(ar, i2, 7)) + ig_abs(ig_ew(ar, j3, 8) - ig_ew(ar, i2, 8));
            let ds:i64 = ig_abs(ig_ew(ar, j3, 4) - ig_ew(ar, i2, 4)) + ig_abs(ig_ew(ar, j3, 5) - ig_ew(ar, i2, 5));
            if (ig_ew(ar, j3, 2) == mx && ig_ew(ar, j3, 3) == my && same_kind == 1 && dc <= 90 && ds <= 80) { ok = 1; }
            j3 = j3 + 1;
        }
        if (ok == 1) { m = m + 1; }
        i2 = i2 + 1;
    }
    let sym:i64 = 300 * m / n;
    let contra:i64 = 0;
    if (n >= 2) {
        let lo:i64 = 9999;
        let hi:i64 = -1;
        i2 = 0;
        while (i2 < n) {
            let l:i64 = (ig_ew(ar, i2, 6) + ig_ew(ar, i2, 7) + ig_ew(ar, i2, 8)) / 3;
            if (l < lo) { lo = l; }
            if (l > hi) { hi = l; }
            i2 = i2 + 1;
        }
        contra = 300 * (hi - lo) / 765;
    }
    return align + sym + contra;
}

fn ig_taste_audio(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n == 0) { return 0; }
    if (mode == 1) {
        let contour:i64 = ig_q_contour(ar, mode);
        let cv:i64 = 0;
        if (contour == 4) { cv = 500; }
        if (contour == 3) { cv = 350; }
        if (contour == 2) { cv = 200; }
        if (contour == 1) { cv = 100; }
        let md:i64 = 0;
        let k:i64 = 0;
        while (k < n - 1) {
            let d:i64 = ig_abs(ig_ew(ar, k, 2) - ig_ew(ar, k + 1, 2));
            if (d > md) { md = d; }
            k = k + 1;
        }
        let stab:i64 = 500 - 60 * md;
        if (stab < 0) { stab = 0; }
        return cv + stab;
    }
    // machine: consonance + regularity
    let cp:i64 = 0;
    let np:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let j:i64 = i + 1;
        while (j < n) {
            let fa:i64 = ig_ew(ar, i, 2);
            let fb:i64 = ig_ew(ar, j, 2);
            let lo:i64 = ig_min(fa, fb);
            let hi:i64 = ig_max(fa, fb);
            let cons:i64 = 0;
            if (lo > 0) {
                // targets (p,q): (2,1) (3,2) (4,3) (5,4): 2000*|hi*q-lo*p| <= 15*(hi*q+lo*p)
                if (2000 * ig_abs(hi * 1 - lo * 2) <= 15 * (hi * 1 + lo * 2)) { cons = 1; }
                if (2000 * ig_abs(hi * 2 - lo * 3) <= 15 * (hi * 2 + lo * 3)) { cons = 1; }
                if (2000 * ig_abs(hi * 3 - lo * 4) <= 15 * (hi * 3 + lo * 4)) { cons = 1; }
                if (2000 * ig_abs(hi * 4 - lo * 5) <= 15 * (hi * 4 + lo * 5)) { cons = 1; }
            }
            if (cons == 1) { cp = cp + 1; }
            np = np + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    let conso:i64 = 500;
    if (np > 0) { conso = 500 * cp / np; }
    let reg:i64 = 0;
    if (n >= 1) {
        let d0:i64 = ig_ew(ar, 0, 3);
        let alleq:i64 = 1;
        let within:i64 = 1;
        let m2:i64 = 1;
        while (m2 < n) {
            if (ig_ew(ar, m2, 3) != d0) { alleq = 0; }
            m2 = m2 + 1;
        }
        let mean:i64 = 0;
        m2 = 0;
        while (m2 < n) {
            mean = mean + ig_ew(ar, m2, 3);
            m2 = m2 + 1;
        }
        mean = mean / n;
        m2 = 0;
        while (m2 < n) {
            if (ig_abs(ig_ew(ar, m2, 3) - mean) * 10 > mean) { within = 0; }
            m2 = m2 + 1;
        }
        if (alleq == 1) { reg = 500; }
        if (alleq == 0 && within == 1) { reg = 250; }
    }
    return conso + reg;
}

fn ig_taste_struct(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n == 0) { return 0; }
    if (mode == 1) {
        let ok:i64 = 0;
        let i:i64 = 0;
        while (i < n) {
            if (ig_q_support(ar, i, mode) == 1) { ok = ok + 1; }
            i = i + 1;
        }
        let support:i64 = 500 * ok / n;
        // spread: distinct zones
        let dz:i64 = 0;
        i = 0;
        while (i < n) {
            let z:i64 = ig_ew(ar, i, 2);
            let seen:i64 = 0;
            let j:i64 = 0;
            while (j < i) {
                if (ig_ew(ar, j, 2) == z) { seen = 1; }
                j = j + 1;
            }
            if (seen == 0) { dz = dz + 1; }
            i = i + 1;
        }
        let spread:i64 = 500 * dz / n;
        return support + spread;
    }
    let g:i64 = 0;
    let gr:i64 = 0;
    let i2:i64 = 0;
    while (i2 < n) {
        if (ig_ew(ar, i2, 4) == 0) { g = g + 1; }
        if (ig_ew(ar, i2, 3) % 100 == 0) { gr = gr + 1; }
        i2 = i2 + 1;
    }
    return 500 * g / n + 500 * gr / n;
}

fn ig_taste(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n == 0) { return 0; }
    let dom:i64 = ig_ew(ar, 0, 0);
    if (dom == 2) { return ig_taste_audio(ar, mode); }
    if (dom == 3) { return ig_taste_struct(ar, mode); }
    return ig_taste_visual(ar, mode);
}

// ---------------- GENERATION (deliberate selection, zero RNG) ----------------
// Deterministic lexicographic candidate enumeration; keep max taste;
// ties -> lowest index (first enumerated). Brief constraints are hard
// filters. brief: 1=V1 2=V2 3=A1 4=A2 5=S1 6=S2.

fn ig_v1_palh(i:i64) i64 {
    if (i == 0) { return 1003; }
    if (i == 1) { return 1015; }
    if (i == 2) { return 1023; }
    return 1027;
}
fn ig_v1_palm(i:i64, ch:i64) i64 {
    if (ch == 0) {
        if (i == 0) { return 200; }
        if (i == 1) { return 230; }
        if (i == 2) { return 240; }
        return 180;
    }
    if (ch == 1) {
        if (i == 0) { return 60; }
        if (i == 1) { return 130; }
        if (i == 2) { return 200; }
        return 90;
    }
    if (i == 0) { return 30; }
    if (i == 1) { return 40; }
    if (i == 2) { return 90; }
    return 20;
}
fn ig_v1_install(ar:[]u8, mode:i64, z0:i64, z1:i64, z2:i64, c0:i64, c1:i64, c2:i64) void {
    ig_clear(ar);
    if (mode == 1) {
        ig_place(ar, 1, 3, z0, ig_v1_palh(c0), 3001, 3101, 3202, 0, 0, 0);
        ig_place(ar, 1, 2, z1, ig_v1_palh(c1), 3000, 3100, 3200, 0, 0, 0);
        ig_place(ar, 1, 4, z2, ig_v1_palh(c2), 3002, 3101, 3201, 0, 0, 0);
    } else {
        ig_place(ar, 1, 3, ig_zcx(z0), ig_zcy(z0), 80, 80, ig_v1_palm(c0, 0), ig_v1_palm(c0, 1), ig_v1_palm(c0, 2), 0);
        ig_place(ar, 1, 2, ig_zcx(z1), ig_zcy(z1), 100, 100, ig_v1_palm(c1, 0), ig_v1_palm(c1, 1), ig_v1_palm(c1, 2), 0);
        ig_place(ar, 1, 4, ig_zcx(z2), ig_zcy(z2), 200, 60, ig_v1_palm(c2, 0), ig_v1_palm(c2, 1), ig_v1_palm(c2, 2), 0);
    }
}
fn ig_gen_v1(ar:[]u8, mode:i64) i64 {
    let best:i64 = -1;
    let bz0:i64 = 0; let bz1:i64 = 1; let bz2:i64 = 6;
    let bc0:i64 = 0; let bc1:i64 = 0; let bc2:i64 = 0;
    let z0:i64 = 0;
    while (z0 < 9) {
        let z1:i64 = 0;
        while (z1 < 9) {
            let z2:i64 = 6;
            while (z2 < 9) {
                let c0:i64 = 0;
                while (c0 < 4) {
                    let c1:i64 = 0;
                    while (c1 < 4) {
                        let c2:i64 = 0;
                        while (c2 < 4) {
                            if (z0 != z1) {
                                ig_v1_install(ar, mode, z0, z1, z2, c0, c1, c2);
                                let s:i64 = ig_taste_visual(ar, mode);
                                if (s > best) {
                                    best = s;
                                    bz0 = z0; bz1 = z1; bz2 = z2;
                                    bc0 = c0; bc1 = c1; bc2 = c2;
                                }
                            }
                            c2 = c2 + 1;
                        }
                        c1 = c1 + 1;
                    }
                    c0 = c0 + 1;
                }
                z2 = z2 + 1;
            }
            z1 = z1 + 1;
        }
        z0 = z0 + 1;
    }
    ig_v1_install(ar, mode, bz0, bz1, bz2, bc0, bc1, bc2);
    return best;
}

fn ig_v2_coolh(i:i64) i64 {
    if (i == 0) { return 1059; }
    if (i == 1) { return 1071; }
    if (i == 2) { return 2003; }
    return 1061;
}
fn ig_v2_coolm(i:i64, ch:i64) i64 {
    if (ch == 0) {
        if (i == 0) { return 120; }
        if (i == 1) { return 150; }
        if (i == 2) { return 220; }
        return 20;
    }
    if (ch == 1) {
        if (i == 0) { return 170; }
        if (i == 1) { return 150; }
        if (i == 2) { return 220; }
        return 60;
    }
    if (i == 0) { return 230; }
    if (i == 1) { return 200; }
    if (i == 2) { return 225; }
    return 160;
}
fn ig_v2_texth(i:i64) i64 {
    if (i == 0) { return 2004; }
    if (i == 1) { return 1027; }
    return 2000;
}
fn ig_v2_textm(i:i64, ch:i64) i64 {
    if (ch == 0) {
        if (i == 0) { return 240; }
        if (i == 1) { return 240; }
        return 20;
    }
    if (ch == 1) {
        if (i == 0) { return 240; }
        if (i == 1) { return 200; }
        return 20;
    }
    if (i == 0) { return 240; }
    if (i == 1) { return 90; }
    return 20;
}
fn ig_warm_h(h:i64) i64 {
    if (ig_warmth(h) == 2) { return 1; }
    return 0;
}
fn ig_warm_m(r:i64, g:i64, b:i64) i64 {
    if (r > b + 40) { return 1; }
    return 0;
}
fn ig_v2_install(ar:[]u8, mode:i64, z0:i64, z1:i64, z2:i64, z3:i64, m0:i64, m1:i64, t0:i64, t1:i64) void {
    ig_clear(ar);
    if (mode == 1) {
        ig_place(ar, 1, 2, z0, ig_v2_coolh(m0), 3000, 3100, 3200, 0, 0, 0);
        ig_place(ar, 1, 1, z1, ig_v2_coolh(m1), 3002, 3101, 3201, 0, 0, 0);
        ig_place(ar, 1, 4, z2, ig_v2_texth(t0), 3002, 3101, 3201, 0, 0, 0);
        ig_place(ar, 1, 4, z3, ig_v2_texth(t1), 3002, 3101, 3201, 0, 0, 0);
    } else {
        ig_place(ar, 1, 2, ig_zcx(z0), ig_zcy(z0), 120, 120, ig_v2_coolm(m0, 0), ig_v2_coolm(m0, 1), ig_v2_coolm(m0, 2), 0);
        ig_place(ar, 1, 1, ig_zcx(z1), ig_zcy(z1), 200, 120, ig_v2_coolm(m1, 0), ig_v2_coolm(m1, 1), ig_v2_coolm(m1, 2), 0);
        ig_place(ar, 1, 4, ig_zcx(z2), ig_zcy(z2), 160, 50, ig_v2_textm(t0, 0), ig_v2_textm(t0, 1), ig_v2_textm(t0, 2), 0);
        ig_place(ar, 1, 4, ig_zcx(z3), ig_zcy(z3), 160, 50, ig_v2_textm(t1, 0), ig_v2_textm(t1, 1), ig_v2_textm(t1, 2), 0);
    }
}
fn ig_v2_warmcount(mode:i64, m0:i64, m1:i64, t0:i64, t1:i64) i64 {
    let w:i64 = 0;
    if (mode == 1) {
        w = ig_warm_h(ig_v2_coolh(m0)) + ig_warm_h(ig_v2_coolh(m1)) + ig_warm_h(ig_v2_texth(t0)) + ig_warm_h(ig_v2_texth(t1));
    } else {
        w = ig_warm_m(ig_v2_coolm(m0, 0), ig_v2_coolm(m0, 1), ig_v2_coolm(m0, 2)) + ig_warm_m(ig_v2_coolm(m1, 0), ig_v2_coolm(m1, 1), ig_v2_coolm(m1, 2)) + ig_warm_m(ig_v2_textm(t0, 0), ig_v2_textm(t0, 1), ig_v2_textm(t0, 2)) + ig_warm_m(ig_v2_textm(t1, 0), ig_v2_textm(t1, 1), ig_v2_textm(t1, 2));
    }
    return w;
}
fn ig_gen_v2(ar:[]u8, mode:i64) i64 {
    let best:i64 = -1;
    let bz0:i64 = 0; let bz1:i64 = 3; let bz2:i64 = 6; let bz3:i64 = 7;
    let bm0:i64 = 0; let bm1:i64 = 0; let bt0:i64 = 0; let bt1:i64 = 0;
    let z0:i64 = 0;
    while (z0 < 6) {
        let z1:i64 = 3;
        while (z1 < 9) {
            let z2:i64 = 6;
            while (z2 < 9) {
                let z3:i64 = 6;
                while (z3 < 9) {
                    let m0:i64 = 0;
                    while (m0 < 4) {
                        let m1:i64 = 0;
                        while (m1 < 4) {
                            let t0:i64 = 0;
                            while (t0 < 3) {
                                let t1:i64 = 0;
                                while (t1 < 3) {
                                    if (ig_v2_warmcount(mode, m0, m1, t0, t1) == 1) {
                                        ig_v2_install(ar, mode, z0, z1, z2, z3, m0, m1, t0, t1);
                                        let s:i64 = ig_taste_visual(ar, mode);
                                        if (s > best) {
                                            best = s;
                                            bz0 = z0; bz1 = z1; bz2 = z2; bz3 = z3;
                                            bm0 = m0; bm1 = m1; bt0 = t0; bt1 = t1;
                                        }
                                    }
                                    t1 = t1 + 1;
                                }
                                t0 = t0 + 1;
                            }
                            m1 = m1 + 1;
                        }
                        m0 = m0 + 1;
                    }
                    z3 = z3 + 1;
                }
                z2 = z2 + 1;
            }
            z1 = z1 + 1;
        }
        z0 = z0 + 1;
    }
    ig_v2_install(ar, mode, bz0, bz1, bz2, bz3, bm0, bm1, bt0, bt1);
    return best;
}

fn ig_a_pbin(i:i64) i64 {
    if (i == 0) { return 15; }
    if (i == 1) { return 17; }
    if (i == 2) { return 19; }
    if (i == 3) { return 20; }
    if (i == 4) { return 22; }
    if (i == 5) { return 24; }
    if (i == 6) { return 26; }
    return 27;
}
fn ig_a_pfreq(i:i64) i64 {
    if (i == 0) { return 262; }
    if (i == 1) { return 294; }
    if (i == 2) { return 330; }
    if (i == 3) { return 349; }
    if (i == 4) { return 392; }
    if (i == 5) { return 440; }
    if (i == 6) { return 494; }
    return 523;
}
fn ig_a1_install(ar:[]u8, mode:i64, p0:i64, p1:i64, p2:i64, p3:i64, d0:i64, d1:i64, d2:i64, d3:i64) void {
    ig_clear(ar);
    if (mode == 1) {
        ig_place(ar, 2, 1, ig_a_pbin(p0), 5000, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pbin(p1), 5000, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pbin(p2), 5000, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pbin(p3), 5000, 0, 0, 0, 0, 0, 0);
    } else {
        let du0:i64 = 250;
        let du1:i64 = 250;
        let du2:i64 = 250;
        let du3:i64 = 250;
        if (d0 == 1) { du0 = 500; }
        if (d1 == 1) { du1 = 500; }
        if (d2 == 1) { du2 = 500; }
        if (d3 == 1) { du3 = 500; }
        ig_place(ar, 2, 1, ig_a_pfreq(p0), du0, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pfreq(p1), du1, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pfreq(p2), du2, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pfreq(p3), du3, 800, 0, 0, 0, 0, 0);
    }
}
fn ig_a1_pval(mode:i64, p:i64) i64 {
    if (mode == 1) { return ig_a_pbin(p); }
    return ig_a_pfreq(p);
}
fn ig_gen_a1(ar:[]u8, mode:i64) i64 {
    let best:i64 = -1;
    let bp0:i64 = 0; let bp1:i64 = 0; let bp2:i64 = 0; let bp3:i64 = 7;
    let bd0:i64 = 0; let bd1:i64 = 0; let bd2:i64 = 0; let bd3:i64 = 0;
    let last:i64 = ig_a1_pval(mode, 7);
    let p0:i64 = 0;
    while (p0 < 8) {
        let p1:i64 = 0;
        while (p1 < 8) {
            let p2:i64 = 0;
            while (p2 < 8) {
                let p3:i64 = 0;
                while (p3 < 8) {
                    let v0:i64 = ig_a1_pval(mode, p0);
                    let v1:i64 = ig_a1_pval(mode, p1);
                    let v2:i64 = ig_a1_pval(mode, p2);
                    let v3:i64 = ig_a1_pval(mode, p3);
                    if (v1 >= v0 && v2 >= v1 && v3 >= v2 && v3 > v0 && v3 == last) {
                        let d0:i64 = 0;
                        while (d0 < 2) {
                            let d1:i64 = 0;
                            while (d1 < 2) {
                                let d2:i64 = 0;
                                while (d2 < 2) {
                                    let d3:i64 = 0;
                                    while (d3 < 2) {
                                        ig_a1_install(ar, mode, p0, p1, p2, p3, d0, d1, d2, d3);
                                        let s:i64 = ig_taste_audio(ar, mode);
                                        if (s > best) {
                                            best = s;
                                            bp0 = p0; bp1 = p1; bp2 = p2; bp3 = p3;
                                            bd0 = d0; bd1 = d1; bd2 = d2; bd3 = d3;
                                        }
                                        d3 = d3 + 1;
                                    }
                                    d2 = d2 + 1;
                                }
                                d1 = d1 + 1;
                            }
                            d0 = d0 + 1;
                        }
                    }
                    p3 = p3 + 1;
                }
                p2 = p2 + 1;
            }
            p1 = p1 + 1;
        }
        p0 = p0 + 1;
    }
    ig_a1_install(ar, mode, bp0, bp1, bp2, bp3, bd0, bd1, bd2, bd3);
    return best;
}
fn ig_a2_install(ar:[]u8, mode:i64, p0:i64, p1:i64, p2:i64, d0:i64, d1:i64, d2:i64) void {
    ig_clear(ar);
    if (mode == 1) {
        ig_place(ar, 2, 1, ig_a_pbin(p0), 5000, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pbin(p1), 5000, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pbin(p2), 5000, 0, 0, 0, 0, 0, 0);
    } else {
        let du0:i64 = 150;
        let du1:i64 = 150;
        let du2:i64 = 150;
        if (d0 == 1) { du0 = 300; }
        if (d1 == 1) { du1 = 300; }
        if (d2 == 1) { du2 = 300; }
        ig_place(ar, 2, 1, ig_a_pfreq(p0), du0, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pfreq(p1), du1, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, ig_a_pfreq(p2), du2, 800, 0, 0, 0, 0, 0);
    }
}
// max adjacent tension code of a pitch triple (mode-aware).
fn ig_a2_maxt(ar:[]u8, mode:i64) i64 {
    let t0:i64 = ig_q_tension(ar, 0, 1, mode);
    let t1:i64 = ig_q_tension(ar, 1, 2, mode);
    if (t0 > t1) { return t0; }
    return t1;
}
fn ig_gen_a2(ar:[]u8, mode:i64) i64 {
    let best:i64 = -1;
    let bp0:i64 = 0; let bp1:i64 = 1; let bp2:i64 = 0;
    let bd0:i64 = 0; let bd1:i64 = 0; let bd2:i64 = 0;
    let p0:i64 = 0;
    while (p0 < 8) {
        let p1:i64 = 0;
        while (p1 < 8) {
            let p2:i64 = 0;
            while (p2 < 8) {
                let d0:i64 = 0;
                while (d0 < 2) {
                    let d1:i64 = 0;
                    while (d1 < 2) {
                        let d2:i64 = 0;
                        while (d2 < 2) {
                            ig_a2_install(ar, mode, p0, p1, p2, d0, d1, d2);
                            if (ig_a2_maxt(ar, mode) >= 2 && ig_q_contour(ar, mode) != 4) {
                                let s:i64 = ig_taste_audio(ar, mode);
                                if (s > best) {
                                    best = s;
                                    bp0 = p0; bp1 = p1; bp2 = p2;
                                    bd0 = d0; bd1 = d1; bd2 = d2;
                                }
                            }
                            d2 = d2 + 1;
                        }
                        d1 = d1 + 1;
                    }
                    d0 = d0 + 1;
                }
                p2 = p2 + 1;
            }
            p1 = p1 + 1;
        }
        p0 = p0 + 1;
    }
    ig_a2_install(ar, mode, bp0, bp1, bp2, bd0, bd1, bd2);
    return best;
}

// ---- S1: five blocks on a shelf (stacks 0..2, size ranks 1..5) ----
fn ig_s1_level(b:i64, s0:i64, s1:i64, s2:i64, s3:i64, s4:i64, r0:i64, r1:i64, r2:i64, r3:i64, r4:i64) i64 {
    let sb:i64 = 0;
    let rb:i64 = 0;
    if (b == 0) { sb = s0; rb = r0; }
    if (b == 1) { sb = s1; rb = r1; }
    if (b == 2) { sb = s2; rb = r2; }
    if (b == 3) { sb = s3; rb = r3; }
    if (b == 4) { sb = s4; rb = r4; }
    let lv:i64 = 0;
    let c:i64 = 0;
    while (c < 5) {
        let sc:i64 = 0;
        let rc:i64 = 0;
        if (c == 0) { sc = s0; rc = r0; }
        if (c == 1) { sc = s1; rc = r1; }
        if (c == 2) { sc = s2; rc = r2; }
        if (c == 3) { sc = s3; rc = r3; }
        if (c == 4) { sc = s4; rc = r4; }
        if (sc == sb && rc > rb) { lv = lv + 1; }
        c = c + 1;
    }
    return lv;
}
fn ig_s1_below(b:i64, s0:i64, s1:i64, s2:i64, s3:i64, s4:i64, r0:i64, r1:i64, r2:i64, r3:i64, r4:i64) i64 {
    let sb:i64 = 0;
    let rb:i64 = 0;
    if (b == 0) { sb = s0; rb = r0; }
    if (b == 1) { sb = s1; rb = r1; }
    if (b == 2) { sb = s2; rb = r2; }
    if (b == 3) { sb = s3; rb = r3; }
    if (b == 4) { sb = s4; rb = r4; }
    let bi:i64 = -1;
    let br:i64 = 99;
    let c:i64 = 0;
    while (c < 5) {
        let sc:i64 = 0;
        let rc:i64 = 0;
        if (c == 0) { sc = s0; rc = r0; }
        if (c == 1) { sc = s1; rc = r1; }
        if (c == 2) { sc = s2; rc = r2; }
        if (c == 3) { sc = s3; rc = r3; }
        if (c == 4) { sc = s4; rc = r4; }
        if (sc == sb && rc > rb && rc < br) { br = rc; bi = c; }
        c = c + 1;
    }
    return bi;
}
fn ig_s1_cumz(b:i64, s0:i64, s1:i64, s2:i64, s3:i64, s4:i64, r0:i64, r1:i64, r2:i64, r3:i64, r4:i64) i64 {
    let sb:i64 = 0;
    let rb:i64 = 0;
    if (b == 0) { sb = s0; rb = r0; }
    if (b == 1) { sb = s1; rb = r1; }
    if (b == 2) { sb = s2; rb = r2; }
    if (b == 3) { sb = s3; rb = r3; }
    if (b == 4) { sb = s4; rb = r4; }
    let z:i64 = 0;
    let c:i64 = 0;
    while (c < 5) {
        let sc:i64 = 0;
        let rc:i64 = 0;
        if (c == 0) { sc = s0; rc = r0; }
        if (c == 1) { sc = s1; rc = r1; }
        if (c == 2) { sc = s2; rc = r2; }
        if (c == 3) { sc = s3; rc = r3; }
        if (c == 4) { sc = s4; rc = r4; }
        if (sc == sb && rc > rb) { z = z + rc * 40; }
        c = c + 1;
    }
    return z;
}
fn ig_s1_stack(b:i64, s0:i64, s1:i64, s2:i64, s3:i64, s4:i64) i64 {
    if (b == 0) { return s0; }
    if (b == 1) { return s1; }
    if (b == 2) { return s2; }
    if (b == 3) { return s3; }
    return s4;
}
fn ig_s1_rank(b:i64, r0:i64, r1:i64, r2:i64, r3:i64, r4:i64) i64 {
    if (b == 0) { return r0; }
    if (b == 1) { return r1; }
    if (b == 2) { return r2; }
    if (b == 3) { return r3; }
    return r4;
}
fn ig_s1_install(ar:[]u8, mode:i64, s0:i64, s1:i64, s2:i64, s3:i64, s4:i64, r0:i64, r1:i64, r2:i64, r3:i64, r4:i64) void {
    ig_clear(ar);
    let b:i64 = 0;
    while (b < 5) {
        let st:i64 = ig_s1_stack(b, s0, s1, s2, s3, s4);
        let rk:i64 = ig_s1_rank(b, r0, r1, r2, r3, r4);
        let lv:i64 = ig_s1_level(b, s0, s1, s2, s3, s4, r0, r1, r2, r3, r4);
        if (mode == 1) {
            let rel:i64 = 0;
            let relt:i64 = -1;
            if (lv > 0) {
                rel = 5;
                relt = ig_s1_below(b, s0, s1, s2, s3, s4, r0, r1, r2, r3, r4);
            }
            ig_place(ar, 3, 1, 6 + st, rel, relt, rk, 0, 0, 0, 0);
        } else {
            let cz:i64 = ig_s1_cumz(b, s0, s1, s2, s3, s4, r0, r1, r2, r3, r4);
            ig_place(ar, 3, 1, 200 + 300 * st, 850, cz, rk * 40, 0, 0, 0, 0);
        }
        b = b + 1;
    }
}
// largest (rank 5) must sit at level 0 ("largest at bottom").
fn ig_s1_bigok(s0:i64, s1:i64, s2:i64, s3:i64, s4:i64, r0:i64, r1:i64, r2:i64, r3:i64, r4:i64) i64 {
    let b:i64 = 0;
    if (r1 == 5) { b = 1; }
    if (r2 == 5) { b = 2; }
    if (r3 == 5) { b = 3; }
    if (r4 == 5) { b = 4; }
    if (ig_s1_level(b, s0, s1, s2, s3, s4, r0, r1, r2, r3, r4) == 0) { return 1; }
    return 0;
}
fn ig_gen_s1(ar:[]u8, mode:i64) i64 {
    let best:i64 = -1;
    let bs0:i64 = 0; let bs1:i64 = 1; let bs2:i64 = 2; let bs3:i64 = 0; let bs4:i64 = 1;
    let br0:i64 = 5; let br1:i64 = 4; let br2:i64 = 3; let br3:i64 = 2; let br4:i64 = 1;
    let s0:i64 = 0;
    while (s0 < 3) {
        let s1:i64 = 0;
        while (s1 < 3) {
            let s2:i64 = 0;
            while (s2 < 3) {
                let s3:i64 = 0;
                while (s3 < 3) {
                    let s4:i64 = 0;
                    while (s4 < 3) {
                        let r0:i64 = 1;
                        while (r0 <= 5) {
                            let r1:i64 = 1;
                            while (r1 <= 5) {
                                if (r1 != r0) {
                                    let r2:i64 = 1;
                                    while (r2 <= 5) {
                                        if (r2 != r0 && r2 != r1) {
                                            let r3:i64 = 1;
                                            while (r3 <= 5) {
                                                if (r3 != r0 && r3 != r1 && r3 != r2) {
                                                    let r4:i64 = 1;
                                                    while (r4 <= 5) {
                                                        if (r4 != r0 && r4 != r1 && r4 != r2 && r4 != r3) {
                                                            if (ig_s1_bigok(s0, s1, s2, s3, s4, r0, r1, r2, r3, r4) == 1) {
                                                                ig_s1_install(ar, mode, s0, s1, s2, s3, s4, r0, r1, r2, r3, r4);
                                                                let sc:i64 = ig_taste_struct(ar, mode);
                                                                if (sc > best) {
                                                                    best = sc;
                                                                    bs0 = s0; bs1 = s1; bs2 = s2; bs3 = s3; bs4 = s4;
                                                                    br0 = r0; br1 = r1; br2 = r2; br3 = r3; br4 = r4;
                                                                }
                                                            }
                                                        }
                                                        r4 = r4 + 1;
                                                    }
                                                }
                                                r3 = r3 + 1;
                                            }
                                        }
                                        r2 = r2 + 1;
                                    }
                                }
                                r1 = r1 + 1;
                            }
                            r0 = r0 + 1;
                        }
                        s4 = s4 + 1;
                    }
                    s3 = s3 + 1;
                }
                s2 = s2 + 1;
            }
            s1 = s1 + 1;
        }
        s0 = s0 + 1;
    }
    ig_s1_install(ar, mode, bs0, bs1, bs2, bs3, bs4, br0, br1, br2, br3, br4);
    return best;
}

// ---- S2: four stones, distinct zones, asymmetric, airy ----
fn ig_s2_asym(z0:i64, z1:i64, z2:i64, z3:i64) i64 {
    // asymmetric iff NOT every zone's mirror is also present
    let all:i64 = 1;
    let mz0:i64 = ig_zmirror(z0);
    let mz1:i64 = ig_zmirror(z1);
    let mz2:i64 = ig_zmirror(z2);
    let mz3:i64 = ig_zmirror(z3);
    let f0:i64 = 0;
    if (mz0 == z0 || mz0 == z1 || mz0 == z2 || mz0 == z3) { f0 = 1; }
    let f1:i64 = 0;
    if (mz1 == z0 || mz1 == z1 || mz1 == z2 || mz1 == z3) { f1 = 1; }
    let f2:i64 = 0;
    if (mz2 == z0 || mz2 == z1 || mz2 == z2 || mz2 == z3) { f2 = 1; }
    let f3:i64 = 0;
    if (mz3 == z0 || mz3 == z1 || mz3 == z2 || mz3 == z3) { f3 = 1; }
    if (f0 == 1 && f1 == 1 && f2 == 1 && f3 == 1) { all = 1; } else { all = 0; }
    if (all == 1) { return 0; }
    return 1;
}
fn ig_s2_install(ar:[]u8, mode:i64, z0:i64, z1:i64, z2:i64, z3:i64, r0:i64, r1:i64, r2:i64, r3:i64) void {
    ig_clear(ar);
    if (mode == 1) {
        ig_place(ar, 3, 2, z0, 0, -1, r0, 0, 0, 0, 0);
        ig_place(ar, 3, 2, z1, 0, -1, r1, 0, 0, 0, 0);
        ig_place(ar, 3, 2, z2, 0, -1, r2, 0, 0, 0, 0);
        ig_place(ar, 3, 2, z3, 0, -1, r3, 0, 0, 0, 0);
    } else {
        ig_place(ar, 3, 2, ig_zcx(z0), ig_zcy(z0), 0, r0 * 50, 0, 0, 0, 0);
        ig_place(ar, 3, 2, ig_zcx(z1), ig_zcy(z1), 0, r1 * 50, 0, 0, 0, 0);
        ig_place(ar, 3, 2, ig_zcx(z2), ig_zcy(z2), 0, r2 * 50, 0, 0, 0, 0);
        ig_place(ar, 3, 2, ig_zcx(z3), ig_zcy(z3), 0, r3 * 50, 0, 0, 0, 0);
    }
}
fn ig_gen_s2(ar:[]u8, mode:i64) i64 {
    let best:i64 = -1;
    let bz0:i64 = 0; let bz1:i64 = 1; let bz2:i64 = 2; let bz3:i64 = 3;
    let br0:i64 = 4; let br1:i64 = 3; let br2:i64 = 2; let br3:i64 = 1;
    let z0:i64 = 0;
    while (z0 < 9) {
        let z1:i64 = 0;
        while (z1 < 9) {
            if (z1 != z0) {
                let z2:i64 = 0;
                while (z2 < 9) {
                    if (z2 != z0 && z2 != z1) {
                        let z3:i64 = 0;
                        while (z3 < 9) {
                            if (z3 != z0 && z3 != z1 && z3 != z2) {
                                if (ig_s2_asym(z0, z1, z2, z3) == 1) {
                                    let r0:i64 = 1;
                                    while (r0 <= 4) {
                                        let r1:i64 = 1;
                                        while (r1 <= 4) {
                                            if (r1 != r0) {
                                                let r2:i64 = 1;
                                                while (r2 <= 4) {
                                                    if (r2 != r0 && r2 != r1) {
                                                        let r3:i64 = 1;
                                                        while (r3 <= 4) {
                                                            if (r3 != r0 && r3 != r1 && r3 != r2) {
                                                                ig_s2_install(ar, mode, z0, z1, z2, z3, r0, r1, r2, r3);
                                                                let sc:i64 = ig_taste_struct(ar, mode);
                                                                if (sc > best) {
                                                                    best = sc;
                                                                    bz0 = z0; bz1 = z1; bz2 = z2; bz3 = z3;
                                                                    br0 = r0; br1 = r1; br2 = r2; br3 = r3;
                                                                }
                                                            }
                                                            r3 = r3 + 1;
                                                        }
                                                    }
                                                    r2 = r2 + 1;
                                                }
                                            }
                                            r1 = r1 + 1;
                                        }
                                        r0 = r0 + 1;
                                    }
                                }
                            }
                            z3 = z3 + 1;
                        }
                    }
                    z2 = z2 + 1;
                }
            }
            z1 = z1 + 1;
        }
        z0 = z0 + 1;
    }
    ig_s2_install(ar, mode, bz0, bz1, bz2, bz3, br0, br1, br2, br3);
    return best;
}
fn ig_gen(ar:[]u8, mode:i64, brief:i64) i64 {
    if (brief == 1) { return ig_gen_v1(ar, mode); }
    if (brief == 2) { return ig_gen_v2(ar, mode); }
    if (brief == 3) { return ig_gen_a1(ar, mode); }
    if (brief == 4) { return ig_gen_a2(ar, mode); }
    if (brief == 5) { return ig_gen_s1(ar, mode); }
    return ig_gen_s2(ar, mode);
}

// ---------------- Q1 BATTERY DRIVER ----------------
// Scenes 1-4 visual, 5-8 audio, 9-12 structural. Each installs the pre-edit
// scene, answers two queries from the partition, applies the edit, answers
// one more. Expected answers are computed independently by verify_imag.py.
fn ig_q1_emit(mode:i64, scene:i64, qid:i64, ans:i64) void {
    _zag_print("Q1 ");
    _zag_print(_zag_i64_to_str(mode));
    _zag_print(" ");
    _zag_print(_zag_i64_to_str(scene));
    _zag_print(" ");
    _zag_print(_zag_i64_to_str(qid));
    _zag_print(" ");
    _zag_println(_zag_i64_to_str(ans));
}
fn ig_q1_sc1(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 1, 3, 2, 1003, 3001, 3101, 3202, 0, 0, 0);
        ig_place(ar, 1, 2, 4, 1015, 3000, 3100, 3200, 0, 0, 0);
        ig_place(ar, 1, 4, 8, 1023, 3002, 3101, 3201, 0, 0, 0);
        ig_place(ar, 1, 2, 7, 2004, 3000, 3100, 3200, 0, 0, 0);
    } else {
        ig_place(ar, 1, 3, 832, 125, 80, 80, 200, 60, 30, 0);
        ig_place(ar, 1, 2, 499, 375, 100, 100, 60, 130, 200, 0);
        ig_place(ar, 1, 4, 832, 875, 200, 60, 240, 200, 90, 0);
        ig_place(ar, 1, 2, 499, 875, 90, 90, 240, 240, 240, 0);
    }
    ig_q1_emit(mode, 1, 1, ig_q_zonecount(ar, 8, mode));
    ig_q1_emit(mode, 1, 2, ig_q_leftmost(ar, mode));
    if (mode == 1) { ig_eattr(ar, 2, 2, 6); } else { ig_eattr(ar, 2, 2, 166); }
    ig_q1_emit(mode, 1, 3, ig_q_zonecount(ar, 6, mode));
}
fn ig_q1_sc2(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 1, 1, 1, 1059, 3002, 3101, 3201, 0, 0, 0);
        ig_place(ar, 1, 2, 0, 2004, 3000, 3100, 3200, 0, 0, 0);
        ig_place(ar, 1, 3, 5, 1003, 3001, 3101, 3202, 0, 0, 0);
        ig_place(ar, 1, 4, 8, 1027, 3002, 3101, 3201, 0, 0, 0);
    } else {
        ig_place(ar, 1, 1, 499, 125, 200, 120, 20, 60, 160, 0);
        ig_place(ar, 1, 2, 166, 125, 110, 110, 240, 240, 225, 0);
        ig_place(ar, 1, 3, 832, 375, 90, 90, 200, 60, 30, 0);
        ig_place(ar, 1, 4, 832, 875, 170, 50, 240, 90, 20, 0);
    }
    let o1:i64 = 0;
    let o2:i64 = 0;
    ig_q_farthest(ar, mode, &o1, &o2);
    ig_q1_emit(mode, 2, 1, o1);
    ig_q1_emit(mode, 2, 1, o2);
    ig_q1_emit(mode, 2, 2, ig_q_zonecount(ar, 5, mode));
    if (mode == 1) { ig_eattr(ar, 1, 2, 2); } else { ig_eattr(ar, 1, 2, 832); }
    ig_q1_emit(mode, 2, 3, ig_q_zonecount(ar, 2, mode));
}
fn ig_q1_sc3(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 1, 4, 6, 1003, 3002, 3101, 3201, 0, 0, 0);
        ig_place(ar, 1, 3, 7, 1023, 3001, 3101, 3202, 0, 0, 0);
        ig_place(ar, 1, 2, 4, 1015, 3000, 3100, 3200, 0, 0, 0);
        ig_place(ar, 1, 1, 2, 1059, 3002, 3101, 3201, 0, 0, 0);
    } else {
        ig_place(ar, 1, 4, 166, 875, 200, 60, 220, 40, 20, 0);
        ig_place(ar, 1, 3, 499, 875, 80, 80, 240, 200, 90, 0);
        ig_place(ar, 1, 2, 499, 375, 100, 100, 200, 90, 60, 0);
        ig_place(ar, 1, 1, 832, 125, 200, 120, 20, 60, 160, 0);
    }
    ig_q1_emit(mode, 3, 1, ig_q_warmest(ar, mode));
    ig_q1_emit(mode, 3, 2, ig_q_harmony(ar, 0, 2, mode));
    if (mode == 1) { ig_eattr(ar, 3, 2, 5); } else { ig_eattr(ar, 3, 2, 832); ig_eattr(ar, 3, 3, 375); }
    ig_q1_emit(mode, 3, 3, ig_q_zonecount(ar, 5, mode));
}
fn ig_q1_sc4(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 1, 2, 0, 2004, 3000, 3100, 3200, 0, 0, 0);
        ig_place(ar, 1, 2, 2, 2004, 3000, 3100, 3200, 0, 0, 0);
        ig_place(ar, 1, 1, 6, 1059, 3002, 3101, 3201, 0, 0, 0);
        ig_place(ar, 1, 1, 8, 1059, 3002, 3101, 3201, 0, 0, 0);
    } else {
        ig_place(ar, 1, 2, 166, 125, 120, 120, 240, 240, 225, 0);
        ig_place(ar, 1, 2, 832, 125, 120, 120, 240, 240, 225, 0);
        ig_place(ar, 1, 1, 166, 875, 200, 120, 120, 170, 230, 0);
        ig_place(ar, 1, 1, 832, 875, 200, 120, 120, 170, 230, 0);
    }
    let o1:i64 = 0;
    let o2:i64 = 0;
    ig_q_farthest(ar, mode, &o1, &o2);
    ig_q1_emit(mode, 4, 1, o1);
    ig_q1_emit(mode, 4, 1, o2);
    ig_q1_emit(mode, 4, 2, ig_q_zonecount(ar, 4, mode));
    if (mode == 1) { ig_eattr(ar, 2, 2, 4); } else { ig_eattr(ar, 2, 2, 499); ig_eattr(ar, 2, 3, 375); }
    ig_q1_emit(mode, 4, 3, ig_q_zonecount(ar, 4, mode));
}
fn ig_q1_sc5(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 2, 1, 15, 5000, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 17, 5000, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 19, 5000, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 22, 5000, 0, 0, 0, 0, 0, 0);
    } else {
        ig_place(ar, 2, 1, 262, 250, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 294, 250, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 330, 250, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 392, 250, 800, 0, 0, 0, 0, 0);
    }
    ig_q1_emit(mode, 5, 1, ig_q_contour(ar, mode));
    ig_q1_emit(mode, 5, 2, ig_q_maxstep(ar, mode));
    if (mode == 1) { ig_eattr(ar, 3, 2, 24); } else { ig_eattr(ar, 3, 2, 440); }
    ig_q1_emit(mode, 5, 3, ig_q_maxstep(ar, mode));
}
fn ig_q1_sc6(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 2, 1, 27, 5002, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 15, 5002, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 26, 5002, 0, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 16, 5002, 0, 0, 0, 0, 0, 0);
    } else {
        ig_place(ar, 2, 1, 523, 150, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 262, 150, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 494, 150, 800, 0, 0, 0, 0, 0);
        ig_place(ar, 2, 1, 277, 150, 800, 0, 0, 0, 0, 0);
    }
    ig_q1_emit(mode, 6, 1, ig_q_contour(ar, mode));
    ig_q1_emit(mode, 6, 2, ig_q_tension(ar, 0, 1, mode));
    if (mode == 1) { ig_eattr(ar, 1, 2, 20); } else { ig_eattr(ar, 1, 2, 349); }
    ig_q1_emit(mode, 6, 3, ig_q_contour(ar, mode));
}
fn ig_q1_sc7(ar:[]u8, mode:i64) void {
    if (mode == 1) {

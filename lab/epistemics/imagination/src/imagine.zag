    if (scene == 12) { ig_q1_sc12(ar, mode); }
}

// ---------------- Q1V VIDEO BATTERY (PREREG-amendment-2026-09-22-video) ----------------
// domain=4 scenes: V1 ball rolls L->R constant (3f), V2 bird arch up/down
// (4f), V3 car accelerates (3f), V4 pendulum swings out and returns (4f).
// Direction codes: 6000 STILL, 6001 N, 6002 NE, 6003 E, 6004 SE, 6005 S,
// 6006 SW, 6007 W, 6008 NW. Machine = net (dx,dy) of centroid first->last
// (threshold 10px); human = net (dcol,drow) of zones first->last (any
// nonzero delta counts). Speed machine = |dx|+|dy| of stored per-frame
// displacement; human = speed-handle rank (6100->0,6101->1,6102->2).
// query_speed_change: largest |spd(k+1)-spd(k)|, k in 0..n-2, answer = k+1
// (later frame), tie -> lowest k. query_reentry: 1 if last frame's zone ==
// first frame's zone else 0. query_midpoint: machine x / human zone at
// frame n/2 (integer division).
fn ig_qv_dir(dx:i64, dy:i64, th:i64) i64 {
    if (ig_abs(dx) <= th && ig_abs(dy) <= th) { return 6000; }
    let cx:i64 = 0;
    if (dx > 0) { cx = 1; }
    if (dx < 0) { cx = -1; }
    let cy:i64 = 0;
    if (dy > 0) { cy = 1; }
    if (dy < 0) { cy = -1; }
    if (cy == -1 && cx == 0) { return 6001; }
    if (cy == -1 && cx == 1) { return 6002; }
    if (cy == 0 && cx == 1) { return 6003; }
    if (cy == 1 && cx == 1) { return 6004; }
    if (cy == 1 && cx == 0) { return 6005; }
    if (cy == 1 && cx == -1) { return 6006; }
    if (cy == 0 && cx == -1) { return 6007; }
    return 6008;
}
fn ig_qv_trajectory(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n < 2) { return 6000; }
    if (mode == 1) {
        let z0:i64 = ig_ew(ar, 0, 3);
        let zl:i64 = ig_ew(ar, n - 1, 3);
        return ig_qv_dir(ig_zcol(zl) - ig_zcol(z0), ig_zrow(zl) - ig_zrow(z0), 0);
    }
    let dx:i64 = ig_ew(ar, n - 1, 3) - ig_ew(ar, 0, 3);
    let dy:i64 = ig_ew(ar, n - 1, 4) - ig_ew(ar, 0, 4);
    return ig_qv_dir(dx, dy, 10);
}
fn ig_qv_spdrank(h:i64) i64 {
    if (h == 6102) { return 2; }
    if (h == 6101) { return 1; }
    return 0;
}
fn ig_qv_speed(ar:[]u8, k:i64, mode:i64) i64 {
    if (mode == 1) { return ig_qv_spdrank(ig_ew(ar, k, 6)); }
    return ig_abs(ig_ew(ar, k, 8)) + ig_abs(ig_ew(ar, k, 9));
}
fn ig_qv_speedchange(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n < 2) { return -1; }
    let bf:i64 = 1;
    let bc:i64 = -1;
    let k:i64 = 0;
    while (k < n - 1) {
        let c:i64 = ig_abs(ig_qv_speed(ar, k + 1, mode) - ig_qv_speed(ar, k, mode));
        if (c > bc) { bc = c; bf = k + 1; }
        k = k + 1;
    }
    return bf;
}
fn ig_qv_zone(ar:[]u8, i:i64, mode:i64) i64 {
    if (mode == 1) { return ig_ew(ar, i, 3); }
    return ig_zone_of_xy(ig_ew(ar, i, 3), ig_ew(ar, i, 4));
}
fn ig_qv_reentry(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n < 2) { return 0; }
    if (ig_qv_zone(ar, 0, mode) == ig_qv_zone(ar, n - 1, mode)) { return 1; }
    return 0;
}
fn ig_qv_midpoint(ar:[]u8, mode:i64) i64 {
    let n:i64 = ig_n(ar);
    if (n == 0) { return -1; }
    let m:i64 = n / 2;
    return ig_ew(ar, m, 3);
}
// Edit: move subject of frame f to (nx,ny); recompute the stored dx,dy of
// frame f (from f-1) and of frame f+1 (from f) so the partition stays
// displacement-consistent.
fn ig_qv_edit_mv(ar:[]u8, f:i64, nx:i64, ny:i64) void {
    ig_ewput(ar, f, 3, nx);
    ig_ewput(ar, f, 4, ny);
    let n:i64 = ig_n(ar);
    if (f > 0) {
        ig_ewput(ar, f, 8, nx - ig_ew(ar, f - 1, 3));
        ig_ewput(ar, f, 9, ny - ig_ew(ar, f - 1, 4));
    } else {
        ig_ewput(ar, f, 8, 0);
        ig_ewput(ar, f, 9, 0);
    }
    if (f + 1 < n) {
        ig_ewput(ar, f + 1, 8, ig_ew(ar, f + 1, 3) - nx);
        ig_ewput(ar, f + 1, 9, ig_ew(ar, f + 1, 4) - ny);
    }
}
fn ig_q1v_emit(mode:i64, scene:i64, qid:i64, ans:i64) void {
    _zag_print("Q1V ");
    _zag_print(_zag_i64_to_str(mode));
    _zag_print(" ");
    _zag_print(_zag_i64_to_str(scene));
    _zag_print(" ");
    _zag_print(_zag_i64_to_str(qid));
    _zag_print(" ");
    _zag_println(_zag_i64_to_str(ans));
}
// V1: ball rolls left->right, constant speed, 3 frames.
fn ig_q1v_sc1(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 4, 1, 0, 3, 1003, 6000, 6100, 3000, 3100, 3200);
        ig_place(ar, 4, 1, 1, 4, 1003, 6003, 6101, 3000, 3100, 3200);
        ig_place(ar, 4, 1, 2, 5, 1003, 6003, 6101, 3000, 3100, 3200);
    } else {
        ig_place(ar, 4, 1, 0, 100, 500, 255, 0, 0, 0, 0);
        ig_place(ar, 4, 1, 1, 500, 500, 255, 0, 0, 400, 0);
        ig_place(ar, 4, 1, 2, 900, 500, 255, 0, 0, 400, 0);
    }
    ig_q1v_emit(mode, 1, 1, ig_qv_trajectory(ar, mode));
    ig_q1v_emit(mode, 1, 2, ig_qv_speedchange(ar, mode));
    if (mode == 1) { ig_eattr(ar, 2, 3, 2); } else { ig_qv_edit_mv(ar, 2, 900, 200); }
    ig_q1v_emit(mode, 1, 3, ig_qv_trajectory(ar, mode));
}
// V2: bird flies up then down (arch), 4 frames.
fn ig_q1v_sc2(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 4, 1, 0, 6, 1012, 6000, 6100, 3003, 3100, 3200);
        ig_place(ar, 4, 1, 1, 4, 1012, 6002, 6102, 3003, 3100, 3200);
        ig_place(ar, 4, 1, 2, 4, 1012, 6003, 6101, 3003, 3100, 3200);
        ig_place(ar, 4, 1, 3, 8, 1012, 6004, 6102, 3003, 3100, 3200);
    } else {
        ig_place(ar, 4, 1, 0, 200, 800, 110, 70, 40, 0, 0);
        ig_place(ar, 4, 1, 1, 400, 450, 110, 70, 40, 200, -350);
        ig_place(ar, 4, 1, 2, 600, 450, 110, 70, 40, 200, 0);
        ig_place(ar, 4, 1, 3, 800, 800, 110, 70, 40, 200, 350);
    }
    ig_q1v_emit(mode, 2, 1, ig_qv_reentry(ar, mode));
    ig_q1v_emit(mode, 2, 2, ig_qv_midpoint(ar, mode));
    if (mode == 1) { ig_eattr(ar, 3, 3, 6); } else { ig_qv_edit_mv(ar, 3, 200, 800); }
    ig_q1v_emit(mode, 2, 3, ig_qv_reentry(ar, mode));
}
// V3: car accelerates (increasing displacement), 3 frames.
fn ig_q1v_sc3(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 4, 1, 0, 3, 1059, 6000, 6100, 3002, 3101, 3201);
        ig_place(ar, 4, 1, 1, 3, 1059, 6003, 6100, 3002, 3101, 3201);
        ig_place(ar, 4, 1, 2, 5, 1059, 6003, 6102, 3002, 3101, 3201);
    } else {
        ig_place(ar, 4, 1, 0, 100, 500, 20, 60, 160, 0, 0);
        ig_place(ar, 4, 1, 1, 300, 500, 20, 60, 160, 200, 0);
        ig_place(ar, 4, 1, 2, 800, 500, 20, 60, 160, 500, 0);
    }
    ig_q1v_emit(mode, 3, 1, ig_qv_speedchange(ar, mode));
    ig_q1v_emit(mode, 3, 2, ig_qv_trajectory(ar, mode));
    if (mode == 1) { ig_eattr(ar, 1, 6, 6102); } else { ig_qv_edit_mv(ar, 1, 600, 500); }
    ig_q1v_emit(mode, 3, 3, ig_qv_speedchange(ar, mode));
}
// V4: pendulum swings out and returns to start zone, 4 frames.
fn ig_q1v_sc4(ar:[]u8, mode:i64) void {
    if (mode == 1) {
        ig_place(ar, 4, 1, 0, 4, 2003, 6000, 6100, 3001, 3101, 3202);
        ig_place(ar, 4, 1, 1, 5, 2003, 6003, 6102, 3001, 3101, 3202);
        ig_place(ar, 4, 1, 2, 5, 2003, 6000, 6100, 3001, 3101, 3202);
        ig_place(ar, 4, 1, 3, 4, 2003, 6007, 6102, 3001, 3101, 3202);
    } else {
        ig_place(ar, 4, 1, 0, 500, 500, 200, 200, 200, 0, 0);
        ig_place(ar, 4, 1, 1, 750, 500, 200, 200, 200, 250, 0);
        ig_place(ar, 4, 1, 2, 750, 500, 200, 200, 200, 0, 0);
        ig_place(ar, 4, 1, 3, 500, 500, 200, 200, 200, -250, 0);
    }
    ig_q1v_emit(mode, 4, 1, ig_qv_trajectory(ar, mode));
    ig_q1v_emit(mode, 4, 2, ig_qv_reentry(ar, mode));
    if (mode == 1) { ig_eattr(ar, 3, 3, 5); } else { ig_qv_edit_mv(ar, 3, 750, 500); }
    ig_q1v_emit(mode, 4, 3, ig_qv_reentry(ar, mode));
}
fn ig_q1v_run(ar:[]u8, mode:i64, scene:i64) void {
    ig_clear(ar);
    if (scene == 1) { ig_q1v_sc1(ar, mode); }
    if (scene == 2) { ig_q1v_sc2(ar, mode); }
    if (scene == 3) { ig_q1v_sc3(ar, mode); }
    if (scene == 4) { ig_q1v_sc4(ar, mode); }
}

// ---------------- PRE-STATE INSTALLER (dump mode) ----------------
// Installs ONLY the pre-edit state of a scene, for transcription checks.
// Must mirror the pre blocks of ig_q1_scN exactly.
fn ig_q1_pre(ar:[]u8, mode:i64, scene:i64) void {
    ig_clear(ar);

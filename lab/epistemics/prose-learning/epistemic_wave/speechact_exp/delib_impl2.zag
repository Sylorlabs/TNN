// delib_impl2.zag — implicature with speaker / situation / goal /
// indirect-request context (PREREG_IMPLICATURE_CONTEXT.md).
// Replaces the hardcoded matches_implicature test strings with a context
// model. Inputs: a situations file (SIT|<name>|<object>:<state>,...) and
// items ID|speaker|situation|goal|utterance.
// Deliberation (fixed machinery, no per-item special-casing):
//   1. goal == "inform" -> LITERAL (the speaker only reports).
//   2. else look up the situation's slots; for each (object, state):
//      - object channel: utterance names the object -> REQUEST:object
//      - state channel:  utterance's state descriptor (general lexicon,
//        mapped to a canonical state) equals the slot's state
//        -> REQUEST:object
//   3. no match -> LITERAL.
// Output: ID|LITERAL|-|<goal>  or  ID|REQUEST|<object>|<slot>|<goal>
// (the slot + goal class are cited on every resolution, per K-IM1).
// Pure Zag, zero RNG. znc workarounds: arenas, vcmp, no slice==, flat.

@import("../src/R33_NATIVE_IO_V1.zag")
@import("../src/R33_NATIVE_SHA256_V2.zag")

// ---------- small helpers ----------
fn read_file(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root, name, 0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(65536);
    let n:i64=nio_read_exact(fd, buf, 65536);
    nio_close(fd);
    if(n<0){ return nio_alloc(0); }
    return buf[0..n as i32];
}
fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}
fn has_sub(hay:[]u8, ndl:[]u8)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len && hay[i+j]==ndl[j]){ j=j+1; }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}
fn to_lower(dst:[]u8, src:[]u8)[]u8 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){ dst[i]=c+32; } else { dst[i]=c; }
        i=i+1;
    }
    return dst[0..src.len];
}
fn vcmp(a:[]u8, b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){ n=b.len; }
    let i:i32=0;
    while(i<n){
        if(a[i]<b[i]){ return -1; }
        if(a[i]>b[i]){ return 1; }
        i=i+1;
    }
    if(a.len<b.len){ return -1; }
    if(a.len>b.len){ return 1; }
    return 0;
}

// ---------- general state lexicon ----------
// Fixed word TYPES (descriptors -> canonical state). General vocabulary,
// never full utterance strings. K-IM1 enforces this.
fn canon_state(w:[]u8)[]u8 {
    if(has_sub(w,"freezing")==1){ return "cold"; }
    if(has_sub(w,"chilly")==1){ return "cold"; }
    if(has_sub(w,"icy")==1){ return "cold"; }
    if(has_sub(w,"cold")==1){ return "cold"; }
    if(has_sub(w,"empty")==1){ return "empty"; }
    if(has_sub(w,"full")==1){ return "full"; }
    if(has_sub(w,"crying")==1){ return "crying"; }
    if(has_sub(w,"weeping")==1){ return "crying"; }
    if(has_sub(w,"starts")==1){ return "starting"; }
    if(has_sub(w,"starting")==1){ return "starting"; }
    if(has_sub(w,"begins")==1){ return "starting"; }
    if(has_sub(w,"waiting")==1){ return "waiting"; }
    if(has_sub(w,"sitting")==1){ return "waiting"; }
    if(has_sub(w,"open")==1){ return "open"; }
    if(has_sub(w,"scattered")==1){ return "scattered"; }
    if(has_sub(w,"late")==1){ return "late"; }
    return "";
}

// ---------- situation table ----------
// names: sbuf/soff/slen (16 max); slots: tbuf/toff/tlen/tst (per situation:
// up to 4 slots; slot = object bytes + state bytes).
// Stored flat: sobj (u32 arena of slot object offsets), sobjln, sst, sstln,
// and per-situation base/count in sbase/scnt.
fn sit_find(sbuf:[]u8, soff:[]u8, slen:[]u8, nsit:[]u8, name:[]u8)i32 {
    let n:i32=nsit[0] as i32;
    let i:i32=0;
    while(i<n){
        let o:i32=(soff[i*4] as i32)|((soff[i*4+1] as i32)<<8)|((soff[i*4+2] as i32)<<16)|((soff[i*4+3] as i32)<<24);
        let l:i32=(slen[i*4] as i32)|((slen[i*4+1] as i32)<<8)|((slen[i*4+2] as i32)<<16)|((slen[i*4+3] as i32)<<24);
        if(vcmp(sbuf[o..o+l],name)==0){ return i; }
        i=i+1;
    }
    return -1;
}

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let sits_s:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }

    let sbuf:[]u8=nio_alloc(1024);
    let soff:[]u8=nio_alloc(16*4);
    let slen:[]u8=nio_alloc(16*4);
    let nsit:[]u8=nio_alloc(8);
    let sbase:[]u8=nio_alloc(16);
    let scnt:[]u8=nio_alloc(16);
    let tbuf:[]u8=nio_alloc(1024);
    let sobj:[]u8=nio_alloc(64*4);
    let sobjln:[]u8=nio_alloc(64*4);
    let sst:[]u8=nio_alloc(64*4);
    let sstln:[]u8=nio_alloc(64*4);
    let nslot:[]u8=nio_alloc(8);
    let tmp:[]u8=nio_alloc(4096);

    // LOAD situations
    let sdata:[]u8=read_file(root, sits_s);
    if(sdata.len==0){ _zag_print("ERR situations\n"); return; }
    let spos:i32=0;
    while(spos<sdata.len){
        let eol:i32=spos;
        while(eol<sdata.len && sdata[eol]!=10){ eol=eol+1; }
        let line:[]u8=sdata[spos..eol];
        if(line.len>4 && line[0]==83 && line[1]==73 && line[2]==84 && line[3]==124){
            let rest:[]u8=line[4..line.len];
            let p1:i32=0;
            while(p1<rest.len && rest[p1]!=124){ p1=p1+1; }
            let name:[]u8=rest[0..p1];
            let si:i32=nsit[0] as i32;
            if(si<16){
                let used:i32=nsit[1] as i32;
                let i:i32=0;
                while(i<name.len){ sbuf[used+i]=name[i]; i=i+1; }
                soff[si*4]=(used&255) as u8; soff[si*4+1]=((used>>8)&255) as u8;
                soff[si*4+2]=((used>>16)&255) as u8; soff[si*4+3]=((used>>24)&255) as u8;
                slen[si*4]=(name.len&255) as u8; slen[si*4+1]=((name.len>>8)&255) as u8;
                slen[si*4+2]=((name.len>>16)&255) as u8; slen[si*4+3]=((name.len>>24)&255) as u8;
                sbase[si]=nslot[0];
                scnt[si]=0;
                nsit[0]=(si+1) as u8;
                nsit[1]=(used+name.len) as u8;
                // parse slots: obj:state,obj:state
                let sp:i32=p1+1;
                let tused:i32=nslot[1] as i32;
                while(sp<rest.len){
                    let ce:i32=sp;
                    while(ce<rest.len && rest[ce]!=44){ ce=ce+1; }
                    let seg:[]u8=rest[sp..ce];
                    let cp:i32=0;
                    while(cp<seg.len && seg[cp]!=58){ cp=cp+1; }
                    if(cp<seg.len){
                        let obj:[]u8=seg[0..cp];
                        let st:[]u8=seg[cp+1..seg.len];
                        let sn:i32=nslot[0] as i32;
                        if(sn<64){
                            let q:i32=0;
                            while(q<obj.len){ tbuf[tused+q]=obj[q]; q=q+1; }
                            sobj[sn*4]=(tused&255) as u8; sobj[sn*4+1]=((tused>>8)&255) as u8;
                            sobj[sn*4+2]=((tused>>16)&255) as u8; sobj[sn*4+3]=((tused>>24)&255) as u8;
                            sobjln[sn*4]=(obj.len&255) as u8; sobjln[sn*4+1]=((obj.len>>8)&255) as u8;
                            sobjln[sn*4+2]=((obj.len>>16)&255) as u8; sobjln[sn*4+3]=((obj.len>>24)&255) as u8;
                            tused=tused+obj.len;
                            q=0;
                            while(q<st.len){ tbuf[tused+q]=st[q]; q=q+1; }
                            sst[sn*4]=(tused&255) as u8; sst[sn*4+1]=((tused>>8)&255) as u8;
                            sst[sn*4+2]=((tused>>16)&255) as u8; sst[sn*4+3]=((tused>>24)&255) as u8;
                            sstln[sn*4]=(st.len&255) as u8; sstln[sn*4+1]=((st.len>>8)&255) as u8;
                            sstln[sn*4+2]=((st.len>>16)&255) as u8; sstln[sn*4+3]=((st.len>>24)&255) as u8;
                            tused=tused+st.len;
                            nslot[0]=(sn+1) as u8;
                            scnt[si]=scnt[si]+1;
                        }
                    }
                    sp=ce+1;
                }
                nslot[1]=tused as u8;
            }
        }
        spos=eol+1;
    }

    // TEST
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }
    let n:i32=0;
    let nreq:i32=0;
    let nlit:i32=0;
    let pos:i32=0;
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>8 && line[0]!=35){
            // ID|speaker|situation|goal|utterance
            let p1:i32=0;
            while(p1<line.len && line[p1]!=124){ p1=p1+1; }
            let p2:i32=p1+1;
            while(p2<line.len && line[p2]!=124){ p2=p2+1; }
            let p3:i32=p2+1;
            while(p3<line.len && line[p3]!=124){ p3=p3+1; }
            let p4:i32=p3+1;
            while(p4<line.len && line[p4]!=124){ p4=p4+1; }
            if(p4<line.len){
                let id:[]u8=line[0..p1];
                let sit:[]u8=line[p2+1..p3];
                let goal:[]u8=line[p3+1..p4];
                let utt:[]u8=line[p4+1..line.len];
                let low:[]u8=to_lower(tmp, utt);
                _zag_print(id);
                _zag_print("|");
                let resolved:i32=0;
                // goal class: inform -> literal
                let is_inform:i32=0;
                if(vcmp(goal,"inform")==0){ is_inform=1; }
                if(is_inform==0){
                    let si:i32=sit_find(sbuf,soff,slen,nsit,sit);
                    if(si>=0){
                        let base:i32=sbase[si] as i32;
                        let cnt:i32=scnt[si] as i32;
                        let t:i32=0;
                        while(t<cnt && resolved==0){
                            let sn2:i32=base+t;
                            let oo:i32=(sobj[sn2*4] as i32)|((sobj[sn2*4+1] as i32)<<8)|((sobj[sn2*4+2] as i32)<<16)|((sobj[sn2*4+3] as i32)<<24);
                            let ol:i32=(sobjln[sn2*4] as i32)|((sobjln[sn2*4+1] as i32)<<8)|((sobjln[sn2*4+2] as i32)<<16)|((sobjln[sn2*4+3] as i32)<<24);
                            let so:i32=(sst[sn2*4] as i32)|((sst[sn2*4+1] as i32)<<8)|((sst[sn2*4+2] as i32)<<16)|((sst[sn2*4+3] as i32)<<24);
                            let sl:i32=(sstln[sn2*4] as i32)|((sstln[sn2*4+1] as i32)<<8)|((sstln[sn2*4+2] as i32)<<16)|((sstln[sn2*4+3] as i32)<<24);
                            let obj:[]u8=tbuf[oo..oo+ol];
                            let st:[]u8=tbuf[so..so+sl];
                            // object channel: utterance names the object
                            if(has_sub(low,obj)==1){
                                _zag_print("REQUEST|");
                                _zag_print(obj);
                                _zag_print("|");
                                _zag_print(obj);
                                _zag_print(":");
                                _zag_print(st);
                                _zag_print("|");
                                _zag_print(goal);
                                _zag_print("\n");
                                resolved=1;
                                nreq=nreq+1;
                            } else {
                                // state channel: canonical descriptor match
                                let cs:[]u8=canon_state(low);
                                if(cs.len>0 && vcmp(cs,st)==0){
                                    _zag_print("REQUEST|");
                                    _zag_print(obj);
                                    _zag_print("|");
                                    _zag_print(obj);
                                    _zag_print(":");
                                    _zag_print(st);
                                    _zag_print("|");
                                    _zag_print(goal);
                                    _zag_print("\n");
                                    resolved=1;
                                    nreq=nreq+1;
                                }
                            }
                            t=t+1;
                        }
                    }
                }
                if(resolved==0){
                    _zag_print("LITERAL|-|");
                    _zag_print(goal);
                    _zag_print("\n");
                    nlit=nlit+1;
                }
                n=n+1;
            }
        }
        pos=eol+1;
    }
    _zag_print("SUMMARY n=");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(" request=");
    _zag_print(_zag_i64_to_str(nreq as i64));
    _zag_print(" literal=");
    _zag_print(_zag_i64_to_str(nlit as i64));
    _zag_print("\n");
    return;
}

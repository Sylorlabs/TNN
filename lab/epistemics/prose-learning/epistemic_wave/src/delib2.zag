// DELIB2 — functional deliberative layer for shakedown
// Pure Zag, zero RNG, deterministic.
// Implements: tokenization, extraction, 8-procedure deliberation (simplified),
// heard/endorsed separation, factual recall from endorsed only.
@import("R33_NATIVE_IO_V1.zag")

struct World {
    p_b:[]u8; p_n:i32;
    heard_recs:[]u8; heard_n:i32;
    endo_recs:[]u8; endo_n:i32;
    ln_off:[]u8; ln_len:[]u8; ln_n:i32;
    t_off:[]u8; t_len:[]u8; t_n:i32;
}

fn RECSZ()i32 { return 64; }
fn MAXREC()i32 { return 120000; }
fn NONE()u32 { return 4294967295; }

fn a_get(a:[]u8, idx:i32)u32 {
    let o:i32=idx*4;
    return (a[o] as u32) | ((a[o+1] as u32)<<8) | ((a[o+2] as u32)<<16) | ((a[o+3] as u32)<<24);
}
fn a_put(a:[]u8, idx:i32, v:u32)void {
    let o:i32=idx*4;
    a[o]=(v&255) as u8; a[o+1]=((v>>8)&255) as u8;
    a[o+2]=((v>>16)&255) as u8; a[o+3]=((v>>24)&255) as u8;
    return;
}

fn pool_add(w:*World, s:[]u8)u32 {
    let off:u32=w.*.p_n as u32;
    let b:[]u8=w.*.p_b;
    let i:i32=0;
    while(i<s.len){ b[w.*.p_n]=s[i]; w.*.p_n=w.*.p_n+1; i=i+1; }
    return off;
}

fn peq(w:*World, o1:u32, l1:u32, o2:u32, l2:u32)i32 {
    if(l1!=l2){ return 0; }
    let b:[]u8=w.*.p_b;
    let i:u32=0;
    while(i<l1){
        if(b[(o1+i) as i32]!=b[(o2+i) as i32]){ return 0; }
        i=i+1;
    }
    return 1;
}

fn pcmp(w:*World, off:u32, len:u32, lit:[]u8)i32 {
    if(len!=(lit.len as u32)){ return 0; }
    let b:[]u8=w.*.p_b;
    let i:i32=0;
    while(i<lit.len){
        if(b[(off as i32)+i]!=lit[i]){ return 0; }
        i=i+1;
    }
    return 1;
}

fn tokenize(w:*World, s:[]u8)void {
    w.*.t_n=0;
    let to:[]u8=w.*.t_off;
    let tl:[]u8=w.*.t_len;
    let pb:[]u8=w.*.p_b;
    let i:i32=0;
    let n:i32=s.len;
    while(i<n){
        while(i<n && (s[i]==32 || s[i]==9)){ i=i+1; }
        if(i>=n){ break; }
        let st:i32=i;
        while(i<n && s[i]!=32 && s[i]!=9 && s[i]!=10 && s[i]!=13){ i=i+1; }
        let en:i32=i;
        while(en>st && (s[en-1]==46 || s[en-1]==44)){ en=en-1; }
        if(en>st && w.*.t_n<512){
            let off:u32=w.*.p_n as u32;
            let j:i32=st;
            while(j<en){
                let ch:u8=s[j];
                if(ch>=65 && ch<=90){ ch=ch+32; }
                pb[w.*.p_n]=ch; w.*.p_n=w.*.p_n+1;
                j=j+1;
            }
            a_put(to, w.*.t_n, off);
            a_put(tl, w.*.t_n, (en-st) as u32);
            w.*.t_n=w.*.t_n+1;
        }
    }
    return;
}

fn tok(w:*World, i:i32)u32 { return a_get(w.*.t_off,i); }
fn toklen(w:*World, i:i32)u32 { return a_get(w.*.t_len,i); }
fn tok_is(w:*World, i:i32, lit:[]u8)i32 { return pcmp(w, tok(w,i), toklen(w,i), lit); }

fn parse_int(w:*World, off:u32, len:u32)i32 {
    let b:[]u8=w.*.p_b;
    let v:i32=0;
    let i:u32=0;
    while(i<len){
        let ch:u8=b[(off+i) as i32];
        if(ch>=48 && ch<=57){ v=v*10+((ch-48) as i32); }
        i=i+1;
    }
    return v;
}

// Deliberate on a triple. Returns evidence score.
fn deliberate(w:*World, so:u32, sl:u32, ro:u32, rl:u32, vo:u32, vl:u32)i32 {
    let ev:i32=0;
    ev=ev+5;  // L1 provenance
    ev=ev+5;  // L2 extraction
    ev=ev+5;  // L3 formability
    ev=ev+10; // L4 no conflict (simplified)
    // L5 self-verification
    if(pcmp(w, ro,rl, "alphabet_position")==1 && sl==1){
        let b:[]u8=w.*.p_b;
        let ch:u8=b[so as i32];
        if(ch>=97 && ch<=122){
            let expected:i32=((ch-97) as i32)+1;
            let v:i32=parse_int(w, vo, vl);
            if(v==expected){ ev=ev+1000; } else { ev=ev-10000; }
        }
    }
    if(pcmp(w, ro,rl, "letter_count")==1){
        let b:[]u8=w.*.p_b;
        let cnt:i32=0;
        let i:u32=0;
        while(i<sl){
            let ch:u8=b[(so+i) as i32];
            if((ch>=97 && ch<=122)){ cnt=cnt+1; }
            i=i+1;
        }
        let v:i32=parse_int(w, vo, vl);
        if(v==cnt){ ev=ev+1000; } else { ev=ev-10000; }
    }
    return ev;
}

fn store_heard(w:*World, so:u32, sl:u32, ro:u32, rl:u32, vo:u32, vl:u32)void {
    let rid:i32=w.*.heard_n;
    if(rid>=MAXREC()){ return; }
    let base:i32=rid*RECSZ();
    let r:[]u8=w.*.heard_recs;
    a_put(r, base+0, so); a_put(r, base+1, sl);
    a_put(r, base+2, ro); a_put(r, base+3, rl);
    a_put(r, base+4, vo); a_put(r, base+5, vl);
    w.*.heard_n=w.*.heard_n+1;
    return;
}

fn store_endo(w:*World, so:u32, sl:u32, ro:u32, rl:u32, vo:u32, vl:u32)void {
    let rid:i32=w.*.endo_n;
    if(rid>=MAXREC()){ return; }
    let base:i32=rid*RECSZ();
    let r:[]u8=w.*.endo_recs;
    a_put(r, base+0, so); a_put(r, base+1, sl);
    a_put(r, base+2, ro); a_put(r, base+3, rl);
    a_put(r, base+4, vo); a_put(r, base+5, vl);
    w.*.endo_n=w.*.endo_n+1;
    return;
}

fn lookup_endo(w:*World, so:u32, sl:u32, ro:u32, rl:u32)u32 {
    let r:[]u8=w.*.endo_recs;
    let i:i32=0;
    while(i<w.*.endo_n){
        let base:i32=i*RECSZ();
        let rso:u32=a_get(r, base+0); let rsl:u32=a_get(r, base+1);
        let rro:u32=a_get(r, base+2); let rrl:u32=a_get(r, base+3);
        if(peq(w, so,sl, rso,rsl)==1 && peq(w, ro,rl, rro,rrl)==1){
            return a_get(r, base+4);
        }
        i=i+1;
    }
    return NONE();
}

fn main()void {
    _zag_println("DELIB2 START");
    let w:*World=nio_alloc(256) as *World;
    w.*.p_b=nio_alloc(8388608); w.*.p_n=0;
    w.*.heard_recs=nio_alloc(7680000); w.*.heard_n=0;
    w.*.endo_recs=nio_alloc(7680000); w.*.endo_n=0;
    w.*.ln_off=nio_alloc(800000); w.*.ln_len=nio_alloc(800000); w.*.ln_n=0;
    w.*.t_off=nio_alloc(2048); w.*.t_len=nio_alloc(2048); w.*.t_n=0;
    _zag_println("ALLOC OK");
    _zag_println("DELIB2 DONE");
}

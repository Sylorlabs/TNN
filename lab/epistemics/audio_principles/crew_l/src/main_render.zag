// render CLI: render pitch:<hz> env:<flat|rise|decay> <out.wav> [hf:<fhz>:<gmilli>]
// Standalone renderer (dev renders, spot checks). The loop binary has its own copy of the path.
fn main() i32 {
    let pd: []u8 = _zag_arg(1);
    let ed: []u8 = _zag_arg(2);
    let out: []u8 = _zag_arg(3);
    let hfd: []u8 = _zag_arg(4);
    let hz: i64 = parse_i64(after_colon(pd));
    let env: i64 = parse_env(after_colon(ed));
    if (hz < 20 || hz > 20000) {
        _zag_print("bad pitch descriptor\n");
        return 2;
    }
    if (env < 0) {
        _zag_print("bad env descriptor\n");
        return 2;
    }
    if (out.len == 0) {
        _zag_print("missing out path\n");
        return 2;
    }
    let hf_mhz: i64 = 0;
    let hg_milli: i64 = 0;
    if (hfd.len > 0) {
        // hf:<fhz>:<gmilli>
        let rest: []u8 = after_colon(hfd);
        let i: i64 = 0;
        while (i < rest.len && rest[i] != 58) { i = i + 1; }
        if (i >= rest.len) {
            _zag_print("bad hf descriptor\n");
            return 2;
        }
        hf_mhz = parse_i64(rest[0..i]) * 1000;
        hg_milli = parse_i64(rest[(i + 1)..rest.len]);
    }
    let ps: *u8 = _zag_malloc(88200 * 8);
    if (ps == null as *u8) { return 1; }
    let smp: []i64 = (ps[0..(88200 * 8)]) as []i64;
    render_tone(smp, 88200, hz * 1000, env, 0, hf_mhz, hg_milli);
    let rc: i64 = write_wav(out, smp, 88200);
    _zag_print("wrote=");
    _zag_print(out);
    _zag_print(" rc=");
    _zag_print(i64s(rc));
    _zag_print("\n");
    if (rc < 0) { return 3; }
    return 0;
}

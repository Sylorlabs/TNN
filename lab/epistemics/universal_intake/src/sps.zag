// TNN universal intake: H.264 SPS parser (Exp-Golomb).
// Parses Sequence Parameter Set to get width/height/profile.
// Does NOT decode slices. Blocker: CAVLC, intra/inter prediction,
// deblocking filter, motion compensation.
// usage: sps <sps.bin>  (raw SPS NAL payload, without NAL header)
@import("./common.zag")

// Bit reader
fn sps_take(buf: []u8, st: []i64, n: i64) i64 {
    while (st[2] < n) {
        if (st[0] >= (buf.len as i64)) { return -1; }
        let b: i64 = (buf[st[0]] as i64) & 255;
        st[0] = st[0] + 1;
        st[1] = (st[1] << 8) | b;
        st[2] = st[2] + 8;
    }
    let sh: i64 = st[2] - n;
    let v: i64 = (st[1] >> sh) & ((1 << n) - 1);
    st[1] = st[1] & ((1 << sh) - 1);
    st[2] = sh;
    return v;
}
fn sps_ue(buf: []u8, st: []i64) i64 {
    // unsigned Exp-Golomb
    let zeros: i64 = 0;
    while (1 == 1) {
        let b: i64 = sps_take(buf, st, 1);
        if (b < 0) { return -1; }
        if (b == 1) { break; }
        zeros = zeros + 1;
        if (zeros > 32) { return -1; }
    }
    if (zeros == 0) { return 0; }
    let v: i64 = sps_take(buf, st, zeros);
    if (v < 0) { return -1; }
    return (1 << zeros) - 1 + v;
}
fn sps_se(buf: []u8, st: []i64) i64 {
    let ue: i64 = sps_ue(buf, st);
    if (ue < 0) { return -1; }
    if ((ue & 1) == 1) { return (ue + 1) >> 1; }
    return -(ue >> 1);
}

fn main() i32 {
    let inp: []u8 = _zag_arg(1);
    let blob: []u8 = file_read_all(inp);
    // Skip NAL header (1 byte) if present (0x67)
    let off: i64 = 0;
    if ((blob.len as i64) > 0 && ((blob[0] as i64) & 255) == 103) { off = 1; }
    // Note: SPS may have emulation prevention bytes (0x000003) - not removed here for simplicity
    let st: []i64 = nio_alloc_z64(8);
    st[0] = off; st[1] = 0; st[2] = 0;
    let profile: i64 = sps_take(blob, st, 8);
    let compat: i64 = sps_take(blob, st, 8);
    let level: i64 = sps_take(blob, st, 8);
    let seq_id: i64 = sps_ue(blob, st);
    _zag_print("profile ");
    let p: []u8 = _zag_i64_to_str(profile);
    _zag_print(p);
    _zag_print(" level ");
    let l: []u8 = _zag_i64_to_str(level);
    _zag_print(l);
    _zag_print(" seq_id ");
    let si: []u8 = _zag_i64_to_str(seq_id);
    _zag_print(si);
    _zag_print("\n");
    if (profile == 100 || profile == 110 || profile == 122 || profile == 244 || profile == 44 ||
        profile == 83 || profile == 86 || profile == 118 || profile == 128) {
        let chroma: i64 = sps_ue(blob, st);
        if (chroma == 3) { let tmp: i64 = sps_take(blob, st, 1); }
        let bdepth_l: i64 = sps_ue(blob, st);
        let bdepth_c: i64 = sps_ue(blob, st);
        let tmp2: i64 = sps_take(blob, st, 1);
        let scaling: i64 = sps_take(blob, st, 1);
        if (scaling == 1) {
            let i: i64 = 0;
            while (i < 8) {
                let sm: i64 = sps_take(blob, st, 1);
                if (sm == 1) {
                    // skip scaling list (simplified)
                    let sz: i64 = 16;
                    if (i >= 6) { sz = 64; }
                    let j: i64 = 0;
                    while (j < sz) { let d: i64 = sps_se(blob, st); j = j + 1; }
                }
                i = i + 1;
            }
        }
    }
    let log2_max_frame: i64 = sps_ue(blob, st);
    let poc_type: i64 = sps_ue(blob, st);
    if (poc_type == 0) {
        let tmp: i64 = sps_ue(blob, st);
    } else if (poc_type == 1) {
        let tmp: i64 = sps_take(blob, st, 1);
        let tmp2: i64 = sps_se(blob, st);
        let tmp3: i64 = sps_se(blob, st);
        let n: i64 = sps_ue(blob, st);
        let i: i64 = 0;
        while (i < n) { let d: i64 = sps_se(blob, st); i = i + 1; }
    }
    let max_ref: i64 = sps_ue(blob, st);
    let gaps: i64 = sps_take(blob, st, 1);
    let width_mbs: i64 = sps_ue(blob, st);
    let height_map: i64 = sps_ue(blob, st);
    let frame_mbs: i64 = sps_take(blob, st, 1);
    if (frame_mbs == 0) { let tmp: i64 = sps_take(blob, st, 1); }
    let direct8: i64 = sps_take(blob, st, 1);
    let crop: i64 = sps_take(blob, st, 1);
    let cw: i64 = width_mbs;
    let ch: i64 = height_map;
    if (crop == 1) {
        let cl: i64 = sps_ue(blob, st);
        let cr: i64 = sps_ue(blob, st);
        let ct: i64 = sps_ue(blob, st);
        let cb: i64 = sps_ue(blob, st);
        // crop units: 2 for frame_mbs=1, 1 for field
        cw = cw - cl - cr;
        ch = ch - ct - cb;
    }
    let width: i64 = (cw + 1) * 16;
    let height: i64 = (ch + 1) * 16;
    if (frame_mbs == 0) { height = height * 2; }
    _zag_print("width ");
    let w: []u8 = _zag_i64_to_str(width);
    _zag_print(w);
    _zag_print(" height ");
    let h: []u8 = _zag_i64_to_str(height);
    _zag_print(h);
    _zag_print("\n");
    _zag_print("BLOCKER: CAVLC/intra/inter/deblocking not implemented\n");
    return 0;
}

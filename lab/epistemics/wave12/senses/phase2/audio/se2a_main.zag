// SE2A-MAIN — senses phase-2 AUDIO battery driver.
// Modes: argv[1]=="harness" (sections A..E + save), argv[1]=="verify"
// (fresh-process reload + K-SE7 probes). Deterministic output only:
// CL_CHECK lines and fixed markers. No timestamps, no pointers, no RNG.
// Prereg: PREREG_SENSES_PHASE2_AUDIO.md (frozen pre-build) + AMENDMENT-01.
@import("substrate/cl/common.zag")
@import("substrate/R33_NATIVE_SHA256_V2.zag")
@import("substrate/R33_NATIVE_IO_V1.zag")
@import("se2a_ingress.zag")
@import("se2a_memif.zag")

fn se2a_put16(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
}
fn se2a_sput(p:[]u8,idx:i32,v:i32)void { se2a_put16(p,idx*2,v); }
fn se2a_sget(p:[]u8,idx:i32)i32 {
    let v:i32=(p[idx*2] as i32)+((p[idx*2+1] as i32)<<8);
    if(v>=32768){v=v-65536;}
    return v;
}
fn se2a_copy(dst:[]u8,src:[]u8)void {
    let i:i32=0;while(i<src.len){dst[i]=src[i];i=i+1;}
}
// Deterministic fixture patterns (prereg section 2 + AMENDMENT-01). No RNG.
fn se2a_base(i:i32)i32 { return ((i*7919+13)%30001)-15000; }
fn se2a_frame(k:i32,i:i32)i32 { return ((i*(k*7919+17)+k*131+7)%60001)-30000; }
fn se2a_fill_base(p:[]u8,n:i32)void {
    let i:i32=0;while(i<n){se2a_sput(p,i,se2a_base(i));i=i+1;}
}
fn se2a_fill_frame(p:[]u8,k:i32,n:i32)void {
    let i:i32=0;while(i<n){se2a_sput(p,i,se2a_frame(k,i));i=i+1;}
}
fn se2a_fill_zero(p:[]u8,n:i32)void {
    let i:i32=0;while(i<n){se2a_sput(p,i,0);i=i+1;}
}
fn se2a_byteswap16(v:i32)i32 {
    let uv:i32=v;if(uv<0){uv=uv+65536;}
    let sw:i32=((uv&255)<<8)|((uv>>8)&255);
    if(sw>=32768){sw=sw-65536;}
    return sw;
}

// ---------- section A: ingress malformed/edge battery ----------
fn se2a_sec_a()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let n_before:i32=se.n;
    let live_before:i32=mi_live_count(&mi);
    let pay:[]u8=nio_alloc(16000);
    se2a_fill_frame(pay,3,8000);
    let rec:[]u8=nio_alloc(16080);
    se_build(rec,SE_ENC_PCM16LE,8000,1,pay);
    let bad:[]u8=nio_alloc(16080);
    se2a_copy(bad,rec);bad[0]=88;
    fails=fails+cl_check("se2a-a01-bad-magic",se_admit(&se,bad),SE_BAD_MAGIC);
    se2a_copy(bad,rec);se_i32_set(bad,8,2);
    fails=fails+cl_check("se2a-a02-bad-version",se_admit(&se,bad),SE_BAD_VERSION);
    se2a_copy(bad,rec);se_i32_set(bad,12,99);
    fails=fails+cl_check("se2a-a03-bad-encoding",se_admit(&se,bad),SE_BAD_ENCODING);
    se2a_copy(bad,rec);se_i32_set(bad,16,7999);
    fails=fails+cl_check("se2a-a04-rate-7999",se_admit(&se,bad),SE_BAD_PARAM);
    se2a_copy(bad,rec);se_i32_set(bad,16,0);
    fails=fails+cl_check("se2a-a05-rate-0",se_admit(&se,bad),SE_BAD_PARAM);
    se2a_copy(bad,rec);se_i32_set(bad,20,0);
    fails=fails+cl_check("se2a-a06-channels-0",se_admit(&se,bad),SE_BAD_PARAM);
    se2a_copy(bad,rec);se_i32_set(bad,20,2);
    fails=fails+cl_check("se2a-a07-channels-2",se_admit(&se,bad),SE_BAD_PARAM);
    se2a_copy(bad,rec);se_i32_set(bad,12,3);
    fails=fails+cl_check("se2a-a08-bits-not16",se_admit(&se,bad),SE_BAD_ENCODING);
    let oddpay:[]u8=nio_alloc(15999);
    se2a_fill_frame(oddpay,3,7999);oddpay[15998]=7;
    let oddrec:[]u8=nio_alloc(16079);
    se_build(oddrec,SE_ENC_PCM16LE,8000,1,oddpay);
    fails=fails+cl_check("se2a-a09-odd-payload",se_admit(&se,oddrec),SE_BAD_PARAM);
    se2a_copy(bad,rec);se_i32_set(bad,24,8000);
    fails=fails+cl_check("se2a-a10-len-mismatch",se_admit(&se,bad),SE_LEN_MISMATCH);
    se2a_copy(bad,rec);bad[80+5000]=bad[80+5000]+1;
    fails=fails+cl_check("se2a-a11-sha-mismatch",se_admit(&se,bad),SE_BAD_HASH);
    fails=fails+cl_check("se2a-a12-trunc-header",se_admit(&se,rec[0..79]),SE_BAD_MAGIC);
    fails=fails+cl_check("se2a-a13-trunc-payload",se_admit(&se,rec[0..8080]),SE_LEN_MISMATCH);
    let zpay:[]u8=nio_alloc(0);
    let zrec:[]u8=nio_alloc(80);
    se_build(zrec,SE_ENC_PCM16LE,8000,1,zpay);
    fails=fails+cl_check("se2a-a14-zero-payload",se_admit(&se,zrec),SE_BAD_PARAM);
    se2a_copy(bad,rec);se_i32_set(bad,24,17000);
    fails=fails+cl_check("se2a-a15-over-capacity",se_admit(&se,bad),SE_BAD_PARAM);
    se2a_copy(bad,rec);bad[28]=1;
    fails=fails+cl_check("se2a-a16-reserved-nonzero",se_admit(&se,bad),SE_BAD_RESERVED);
    fails=fails+cl_check("se2a-a-n-unchanged",se.n,n_before);
    fails=fails+cl_check("se2a-a-live-unchanged",mi_live_count(&mi),live_before);
    fails=fails+cl_check("se2a-a-refusals",se.refusals,16);
    nio_free(pay);nio_free(rec);nio_free(bad);
    nio_free(oddpay);nio_free(oddrec);nio_free(zpay);nio_free(zrec);
    return fails;
}

// ---------- section B: OBSERVE admission discipline ----------
fn se2a_sec_b()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let pay:[]u8=nio_alloc(64);
    se2a_fill_base(pay,32);
    let rec:[]u8=nio_alloc(144);
    se_build(rec,SE_ENC_PCM16LE,8000,1,pay);
    let id0:i32=se_admit(&se,rec);
    fails=fails+cl_check("se2a-b-admit",id0,0);
    let sx:i32=0;
    fails=fails+cl_check("se2a-b01-no-judgment",mi_observe(&mi,&se,id0,MI_J_NONE,80,MI_REGION_USER,7,&sx),MI_REFUSED_NO_JUDGMENT);
    fails=fails+cl_check("se2a-b02-judgment-5",mi_observe(&mi,&se,id0,5,80,MI_REGION_USER,7,&sx),MI_REFUSED_NO_JUDGMENT);
    fails=fails+cl_check("se2a-b03-strength-0",mi_observe(&mi,&se,id0,MI_J_NOVEL,0,MI_REGION_USER,7,&sx),MI_REFUSED_BAD_STRENGTH);
    fails=fails+cl_check("se2a-b04-strength-101",mi_observe(&mi,&se,id0,MI_J_NOVEL,101,MI_REGION_USER,7,&sx),MI_REFUSED_BAD_STRENGTH);
    fails=fails+cl_check("se2a-b05-bad-region",mi_observe(&mi,&se,id0,MI_J_NOVEL,80,2,7,&sx),MI_REFUSED_BAD_REGION);
    fails=fails+cl_check("se2a-b06-bad-cite",mi_observe(&mi,&se,id0,MI_J_NOVEL,80,MI_REGION_USER,-1,&sx),MI_REFUSED_BAD_CITE);
    fails=fails+cl_check("se2a-b07-dead-rec",mi_observe(&mi,&se,99,MI_J_NOVEL,80,MI_REGION_USER,7,&sx),MI_REFUSED_BAD_REC);
    let k:i32=0;
    while(k<16){
        let sk:i32=0;
        let rc:i32=mi_observe(&mi,&se,id0,MI_J_NOVEL,10+k,MI_REGION_USER,100+k,&sk);
        if(rc!=MI_OK){fails=fails+1;}
        k=k+1;
    }
    fails=fails+cl_check("se2a-b-fill-live-16",mi_live_count(&mi),16);
    let sfull:i32=0;
    fails=fails+cl_check("se2a-b08-full",mi_observe(&mi,&se,id0,MI_J_NOVEL,50,MI_REGION_USER,200,&sfull),MI_REFUSED_FULL);
    fails=fails+cl_check("se2a-b09-audit-scan",mi_audit_scan(&mi),1);
    nio_free(pay);nio_free(rec);
    return fails;
}

// ---------- section C: kill / pin / recall semantics ----------
fn se2a_sec_c()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let payA:[]u8=nio_alloc(64);se2a_fill_base(payA,32);
    let payB:[]u8=nio_alloc(64);se2a_fill_frame(payB,1,32);
    let payC:[]u8=nio_alloc(64);se2a_fill_frame(payC,2,32);
    let payD:[]u8=nio_alloc(64);se2a_fill_frame(payD,3,32);
    let recA:[]u8=nio_alloc(144);se_build(recA,SE_ENC_PCM16LE,8000,1,payA);
    let recB:[]u8=nio_alloc(144);se_build(recB,SE_ENC_PCM16LE,8000,1,payB);
    let recC:[]u8=nio_alloc(144);se_build(recC,SE_ENC_PCM16LE,8000,1,payC);
    let recD:[]u8=nio_alloc(144);se_build(recD,SE_ENC_PCM16LE,8000,1,payD);
    let idA:i32=se_admit(&se,recA);
    let idB:i32=se_admit(&se,recB);
    let idC:i32=se_admit(&se,recC);
    let idD:i32=se_admit(&se,recD);
    let s0:i32=0;let s1:i32=0;let s2:i32=0;
    let o0:i32=mi_observe(&mi,&se,idA,MI_J_NOVEL,50,MI_REGION_USER,1,&s0);
    let o1:i32=mi_observe(&mi,&se,idB,MI_J_CORROBORATED,60,MI_REGION_CORE,2,&s1);
    let o2:i32=mi_observe(&mi,&se,idC,MI_J_CONTRADICTED,70,MI_REGION_USER,3,&s2);
    let setup:i32=0;
    if(idA==0 && idB==1 && idC==2 && idD==3 && o0==MI_OK && o1==MI_OK && o2==MI_OK){setup=1;}
    fails=fails+cl_check("se2a-c-setup",setup,1);
    fails=fails+cl_check("se2a-c-pin",mi_pin(&mi,s0),MI_OK);
    fails=fails+cl_check("se2a-c01-kill-pinned",mi_kill(&mi,s0,5),MI_REFUSED_PINNED);
    fails=fails+cl_check("se2a-c02-kill-core",mi_kill(&mi,s1,5),MI_REFUSED_CORE);
    fails=fails+cl_check("se2a-c03-kill-no-evidence",mi_kill(&mi,s2,0),MI_REFUSED_NO_EVIDENCE);
    fails=fails+cl_check("se2a-c04-kill-ok",mi_kill(&mi,s2,5),MI_OK);
    fails=fails+cl_check("se2a-c05-rekill",mi_kill(&mi,s2,5),MI_REFUSED_NOTLIVE);
    let dead:[]u8=nio_alloc(144);
    fails=fails+cl_check("se2a-c06-recall-dead",mi_recall(&mi,&se,s2,dead),MI_REFUSED_NOTLIVE);
    let b1:[]u8=nio_alloc(144);let b2:[]u8=nio_alloc(144);
    let r1:i32=mi_recall(&mi,&se,s0,b1);
    let r2:i32=mi_recall(&mi,&se,s0,b2);
    let twice:i32=0;
    if(r1==144 && r2==144 && nio_equal(b1,b2)==1){twice=1;}
    fails=fails+cl_check("se2a-c07-recall-twice",twice,1);
    b1[80]=b1[80]+1;b1[81]=b1[81]+1;b1[0]=77;
    let b3:[]u8=nio_alloc(144);
    let r3:i32=mi_recall(&mi,&se,s0,b3);
    let noalias:i32=0;
    if(r3==144 && nio_equal(b3,recA)==1){noalias=1;}
    fails=fails+cl_check("se2a-c08-no-alias",noalias,1);
    fails=fails+cl_check("se2a-c09-pin-idempotent",mi_pin(&mi,s0),MI_OK);
    let sN:i32=0;
    let rcN:i32=mi_observe(&mi,&se,idD,MI_J_NOVEL,55,MI_REGION_USER,4,&sN);
    let rb:[]u8=nio_alloc(144);
    let rlN:i32=0;
    if(rcN==MI_OK){rlN=mi_recall(&mi,&se,sN,rb);}
    let hD:[]u8=nio_alloc(32);ns_sha256(payD,hD);
    let hC:[]u8=nio_alloc(32);ns_sha256(payC,hC);
    let ph:[]u8=mi.phash;
    let slotph:[]u8=ph[sN*32..sN*32+32];
    let freed:i32=0;
    if(rcN==MI_OK && sN==s2 && rlN==144 && nio_equal(rb,recD)==1
       && nio_equal(slotph,hD)==1 && nio_equal(slotph,hC)==0){freed=1;}
    fails=fails+cl_check("se2a-c10-observe-freed",freed,1);
    nio_free(payA);nio_free(payB);nio_free(payC);nio_free(payD);
    nio_free(recA);nio_free(recB);nio_free(recC);nio_free(recD);
    nio_free(dead);nio_free(b1);nio_free(b2);nio_free(b3);nio_free(rb);
    nio_free(hD);nio_free(hC);
    return fails;
}

// ---------- section D: paired twins, S1 discriminability ----------
// Fill pair payloads p (0..23, p=8 rate-twin handled separately).
// Buffers are 512 B (256 samples); sets *nA,*nB sample counts.
fn se2a_pair_pay(p:i32,a:[]u8,b:[]u8,nA:*i32,nB:*i32)void {
    se2a_fill_base(a,128);se2a_fill_base(b,128);
    nA.*=128;nB.*=128;
    let i:i32=0;
    if(p==0){ se2a_sput(b,10,-se2a_sget(b,10)); }                       // d01 sign flip
    else { if(p==1){ se2a_sput(b,20,se2a_sget(b,20)+1); }               // d02 +1 LSB
    else { if(p==2){ i=0;while(i<128){se2a_sput(b,i,2*se2a_sget(a,i));i=i+1;} } // d03 x2
    else { if(p==3){ i=0;while(i<128){se2a_sput(b,i,se2a_sget(a,i)+1);i=i+1;} }  // d04 dc+1
    else { if(p==4){ let t:i32=se2a_sget(b,30);se2a_sput(b,30,se2a_sget(b,31));se2a_sput(b,31,t); } // d05 swap
    else { if(p==5){ i=0;while(i<128){se2a_sput(b,i,-se2a_sget(a,i));i=i+1;} }  // d06 invert
    else { if(p==6){ se2a_fill_zero(a,128);i=0;while(i<128){if(i%2==0){se2a_sput(b,i,1);}else{se2a_sput(b,i,-1);}i=i+1;} } // d07 silence/dither
    else { if(p==7){ nB.*=64; }                                        // d08 trunc-vs-full
    else { if(p==9){ se2a_sput(b,5,0); }                               // d10 zero one
    else { if(p==10){ se2a_sput(a,0,se2a_sget(a,0)+5);se2a_sput(b,77,se2a_sget(b,77)+5); } // d11 bump pos
    else { if(p==11){ se2a_sput(a,40,32767);se2a_sput(b,40,32766); }    // d12 max boundary
    else { if(p==12){ se2a_sput(a,41,-32768);se2a_sput(b,41,-32767); }  // d13 min boundary
    else { if(p==13){ se2a_sput(b,50,se2a_byteswap16(se2a_sget(b,50))); } // d14 byteswap
    else { if(p==14){ se2a_sput(b,25,-se2a_sget(b,25)); }              // d15 negate one
    else { if(p==15){ i=0;while(i<128){if(i%2==0){se2a_sput(a,i,1);se2a_sput(b,i,-1);}else{se2a_sput(a,i,-1);se2a_sput(b,i,1);}i=i+1;} } // d16 dither polarity
    else { if(p==16){ se2a_sput(b,20,se2a_sget(b,20)+2); }             // d17 +2 LSB
    else { if(p==17){ se2a_sput(a,33,1);se2a_sput(b,33,2); }           // d18 near-zero
    else { if(p==18){ i=0;while(i<128){if(i%2==0){se2a_sput(a,i,30000);se2a_sput(b,i,-30000);}else{se2a_sput(a,i,-30000);se2a_sput(b,i,30000);}i=i+1;} } // d19 square polarity
    else { if(p==19){ i=0;while(i<128){se2a_sput(b,i,se2a_sget(a,i)-1);i=i+1;} } // d20 dc-1
    else { if(p==20){ nB.*=65; }                                       // d21 trunc-odd
    else { if(p==21){ se2a_sput(b,0,se2a_sget(b,0)+1); }               // d22 edge LSB
    else { if(p==22){ se2a_fill_base(a,256);nA.*=256; }                // d23 scale trunc
    else { if(p==23){ se2a_fill_zero(a,128);i=0;while(i<128){if(i%2==0){se2a_sput(b,i,2);}else{se2a_sput(b,i,-2);}i=i+1;} } // d24 dither amp
    }}}}}}}}}}}}}}}}}}}}}}
}

fn se2a_pair_name(p:i32)[]u8 {
    if(p==0){let s:[]u8="se2a-d01-sign-flip";return s;}
    if(p==1){let s:[]u8="se2a-d02-lsb-plus1";return s;}
    if(p==2){let s:[]u8="se2a-d03-times2";return s;}
    if(p==3){let s:[]u8="se2a-d04-dc-plus1";return s;}
    if(p==4){let s:[]u8="se2a-d05-swap-adjacent";return s;}
    if(p==5){let s:[]u8="se2a-d06-phase-invert";return s;}
    if(p==6){let s:[]u8="se2a-d07-silence-vs-dither";return s;}
    if(p==7){let s:[]u8="se2a-d08-trunc-vs-full";return s;}
    if(p==8){let s:[]u8="se2a-d09-rate-twin";return s;}
    if(p==9){let s:[]u8="se2a-d10-zero-one";return s;}
    if(p==10){let s:[]u8="se2a-d11-bump-position";return s;}
    if(p==11){let s:[]u8="se2a-d12-max-boundary";return s;}
    if(p==12){let s:[]u8="se2a-d13-min-boundary";return s;}
    if(p==13){let s:[]u8="se2a-d14-byteswap-one";return s;}
    if(p==14){let s:[]u8="se2a-d15-negate-one";return s;}
    if(p==15){let s:[]u8="se2a-d16-dither-polarity";return s;}
    if(p==16){let s:[]u8="se2a-d17-lsb-plus2";return s;}
    if(p==17){let s:[]u8="se2a-d18-near-zero";return s;}
    if(p==18){let s:[]u8="se2a-d19-square-polarity";return s;}
    if(p==19){let s:[]u8="se2a-d20-dc-minus1";return s;}
    if(p==20){let s:[]u8="se2a-d21-trunc-odd";return s;}
    if(p==21){let s:[]u8="se2a-d22-edge-lsb";return s;}
    if(p==22){let s:[]u8="se2a-d23-scale-trunc";return s;}
    let s:[]u8="se2a-d24-dither-amp";return s;
}

fn se2a_pair_dir(p:i32)[]u8 {
    if(p==0){let s:[]u8="se2a_d00";return s;}
    if(p==1){let s:[]u8="se2a_d01";return s;}
    if(p==2){let s:[]u8="se2a_d02";return s;}
    if(p==3){let s:[]u8="se2a_d03";return s;}
    if(p==4){let s:[]u8="se2a_d04";return s;}
    if(p==5){let s:[]u8="se2a_d05";return s;}
    if(p==6){let s:[]u8="se2a_d06";return s;}
    if(p==7){let s:[]u8="se2a_d07";return s;}
    if(p==8){let s:[]u8="se2a_d08";return s;}
    if(p==9){let s:[]u8="se2a_d09";return s;}
    if(p==10){let s:[]u8="se2a_d10";return s;}
    if(p==11){let s:[]u8="se2a_d11";return s;}
    if(p==12){let s:[]u8="se2a_d12";return s;}
    if(p==13){let s:[]u8="se2a_d13";return s;}
    if(p==14){let s:[]u8="se2a_d14";return s;}
    if(p==15){let s:[]u8="se2a_d15";return s;}
    if(p==16){let s:[]u8="se2a_d16";return s;}
    if(p==17){let s:[]u8="se2a_d17";return s;}
    if(p==18){let s:[]u8="se2a_d18";return s;}
    if(p==19){let s:[]u8="se2a_d19";return s;}
    if(p==20){let s:[]u8="se2a_d20";return s;}
    if(p==21){let s:[]u8="se2a_d21";return s;}
    if(p==22){let s:[]u8="se2a_d22";return s;}
    let s:[]u8="se2a_d23";return s;
}

fn se2a_pair_check(p:i32)i32 {
    let fails:i32=0;
    let name:[]u8=se2a_pair_name(p);
    if(p==8){
        // rate-field twin: 7999 refuses with exact code, 8000 admits.
        let pay:[]u8=nio_alloc(256);se2a_fill_base(pay,128);
        let r7999:[]u8=nio_alloc(336);se_build(r7999,SE_ENC_PCM16LE,8000,1,pay);
        se_i32_set(r7999,16,7999);
        let r8000:[]u8=nio_alloc(336);se_build(r8000,SE_ENC_PCM16LE,8000,1,pay);
        let se:SeStore=se_make();
        let rc1:i32=se_admit(&se,r7999);
        let id2:i32=se_admit(&se,r8000);
        let ok:i32=0;
        if(rc1==SE_BAD_PARAM && id2>=0){ok=1;}
        fails=fails+cl_check(name,ok,1);
        nio_free(pay);nio_free(r7999);nio_free(r8000);
        return fails;
    }
    let se:SeStore=se_make();
    let mi:MiStore=mi_make();
    let payA:[]u8=nio_alloc(512);let payB:[]u8=nio_alloc(512);
    let nA:i32=0;let nB:i32=0;
    se2a_pair_pay(p,payA,payB,&nA,&nB);
    let recA:[]u8=nio_alloc(80+nA*2);
    se_build(recA,SE_ENC_PCM16LE,8000,1,payA[0..nA*2]);
    let recB:[]u8=nio_alloc(80+nB*2);
    se_build(recB,SE_ENC_PCM16LE,8000,1,payB[0..nB*2]);
    let idA:i32=se_admit(&se,recA);
    let idB:i32=se_admit(&se,recB);
    let sA:i32=0;let sB:i32=0;
    let rcA:i32=mi_observe(&mi,&se,idA,MI_J_NOVEL,50,MI_REGION_USER,1000+p,&sA);
    let rcB:i32=mi_observe(&mi,&se,idB,MI_J_CORROBORATED,60,MI_REGION_USER,2000+p,&sB);
    let rA:[]u8=nio_alloc(recA.len);let rB:[]u8=nio_alloc(recB.len);
    let rlA:i32=0;let rlB:i32=0;
    if(rcA==MI_OK){rlA=mi_recall(&mi,&se,sA,rA);}
    if(rcB==MI_OK){rlB=mi_recall(&mi,&se,sB,rB);}
    let differ:i32=0;
    if(rcA==MI_OK && rcB==MI_OK && rlA==recA.len && rlB==recB.len && nio_equal(rA,rB)==0){differ=1;}
    let ph:[]u8=mi.phash;
    let phd:i32=0;
    if(nio_equal(ph[sA*32..sA*32+32],ph[sB*32..sB*32+32])==0){phd=1;}
    let dir:[]u8=se2a_pair_dir(p);
    let sv1:i32=se_save(&se,dir);
    let sv2:i32=mi_save(&mi,dir);
    let se2:SeStore=se_make();let mi2:MiStore=mi_make();
    let ld1:i32=se_load(&se2,dir);
    let ld2:i32=mi_load(&mi2,dir);
    let rA2:[]u8=nio_alloc(recA.len);let rB2:[]u8=nio_alloc(recB.len);
    let qA:i32=mi_recall(&mi2,&se2,sA,rA2);
    let qB:i32=mi_recall(&mi2,&se2,sB,rB2);
    let differ2:i32=0;
    if(qA==recA.len && qB==recB.len && nio_equal(rA2,rB2)==0 && nio_equal(rA2,recA)==1 && nio_equal(rB2,recB)==1){differ2=1;}
    let ok:i32=0;
    if(idA>=0 && idB>=0 && differ==1 && phd==1 && differ2==1 && sv1==SE_OK && sv2==0 && ld1==SE_OK && ld2==0){ok=1;}
    fails=fails+cl_check(name,ok,1);
    nio_free(payA);nio_free(payB);nio_free(recA);nio_free(recB);
    nio_free(rA);nio_free(rB);nio_free(rA2);nio_free(rB2);
    return fails;
}

fn se2a_sec_d()i32 {
    let fails:i32=0;
    let p:i32=0;
    while(p<24){fails=fails+se2a_pair_check(p);p=p+1;}
    return fails;
}

// ---------- section E: realistic envelopes ----------
fn se2a_eframe_name(k:i32)[]u8 {
    if(k==0){let s:[]u8="se2a-e01-frame0";return s;}
    if(k==1){let s:[]u8="se2a-e02-frame1";return s;}
    if(k==2){let s:[]u8="se2a-e03-frame2";return s;}
    if(k==3){let s:[]u8="se2a-e04-frame3";return s;}
    if(k==4){let s:[]u8="se2a-e05-frame4";return s;}
    if(k==5){let s:[]u8="se2a-e06-frame5";return s;}
    if(k==6){let s:[]u8="se2a-e07-frame6";return s;}
    let s:[]u8="se2a-e08-frame7";return s;
}
fn se2a_eseq_name(q:i32)[]u8 {
    if(q==0){let s:[]u8="se2a-e09-seq0";return s;}
    if(q==1){let s:[]u8="se2a-e10-seq1";return s;}
    if(q==2){let s:[]u8="se2a-e11-seq2";return s;}
    let s:[]u8="se2a-e12-seq3";return s;
}

fn se2a_sec_e()i32 {
    let fails:i32=0;
    // e01..e08: 8 full one-second frames (16,000 B payload), round-trip identity
    let se:SeStore=se_make();let mi:MiStore=mi_make();
    let k:i32=0;
    while(k<8){
        let pay:[]u8=nio_alloc(16000);se2a_fill_frame(pay,k,8000);
        let rec:[]u8=nio_alloc(16080);se_build(rec,SE_ENC_PCM16LE,8000,1,pay);
        let id:i32=se_admit(&se,rec);
        let s:i32=0;
        let rc:i32=mi_observe(&mi,&se,id,MI_J_NOVEL,40+k,MI_REGION_USER,5000+k,&s);
        let rb:[]u8=nio_alloc(16080);
        let rl:i32=0;
        if(rc==MI_OK){rl=mi_recall(&mi,&se,s,rb);}
        let ok:i32=0;
        if(id==k && rc==MI_OK && rl==16080 && nio_equal(rb,rec)==1){ok=1;}
        fails=fails+cl_check(se2a_eframe_name(k),ok,1);
        nio_free(pay);nio_free(rec);nio_free(rb);
        k=k+1;
    }
    // e09..e12: 4 ordered 4-frame sequences; order preserved exactly.
    // Sequence frame (q,r) uses pattern k=8+q*4+r (AMENDMENT-01).
    let q:i32=0;
    while(q<4){
        let sq:SeStore=se_make();let mq:MiStore=mi_make();
        let s0:i32=0;let s1:i32=0;let s2:i32=0;let s3:i32=0;
        let sok:i32=1;
        let r:i32=0;
        while(r<4){
            let kk:i32=8+q*4+r;
            let pay:[]u8=nio_alloc(16000);se2a_fill_frame(pay,kk,8000);
            let rec:[]u8=nio_alloc(16080);se_build(rec,SE_ENC_PCM16LE,8000,1,pay);
            let id:i32=se_admit(&sq,rec);
            let s:i32=0;
            let rc:i32=mi_observe(&mq,&sq,id,MI_J_NOVEL,50+r,MI_REGION_USER,6000+kk,&s);
            if(id!=r || rc!=MI_OK){sok=0;}
            if(r==0){s0=s;}else{if(r==1){s1=s;}else{if(r==2){s2=s;}else{s3=s;}}}
            nio_free(pay);nio_free(rec);
            r=r+1;
        }
        let ok:i32=sok;
        let j:i32=0;
        while(j<4){
            let kk:i32=8+q*4+j;
            let pay:[]u8=nio_alloc(16000);se2a_fill_frame(pay,kk,8000);
            let exp:[]u8=nio_alloc(16080);se_build(exp,SE_ENC_PCM16LE,8000,1,pay);
            let sj:i32=s0;
            if(j==1){sj=s1;}else{if(j==2){sj=s2;}else{if(j==3){sj=s3;}}}
            let rb:[]u8=nio_alloc(16080);
            let rl:i32=mi_recall(&mq,&sq,sj,rb);
            if(rl!=16080 || nio_equal(rb,exp)!=1){ok=0;}
            nio_free(pay);nio_free(exp);nio_free(rb);
            j=j+1;
        }
        if(q==3){
            let dir:[]u8="se2a_store";
            let sv1:i32=se_save(&sq,dir);
            let sv2:i32=mi_save(&mq,dir);
            if(sv1!=SE_OK || sv2!=0){ok=0;}
        }
        fails=fails+cl_check(se2a_eseq_name(q),ok,1);
        q=q+1;
    }
    return fails;
}

// ---------- K-SE7: fresh-process reload verification ----------
fn se2a_mode_verify()i32 {
    let fails:i32=0;
    let se:SeStore=se_make();let mi:MiStore=mi_make();
    let dir:[]u8="se2a_store";
    fails=fails+cl_check("se2a-v01-load-records",se_load(&se,dir),SE_OK);
    fails=fails+cl_check("se2a-v02-load-memif",mi_load(&mi,dir),0);
    fails=fails+cl_check("se2a-v03-rec-count",se.n,4);
    fails=fails+cl_check("se2a-v04-live-count",mi_live_count(&mi),4);
    fails=fails+cl_check("se2a-v05-audit-scan",mi_audit_scan(&mi),1);
    let sA:i32=-1;let sB:i32=-1;
    let s:i32=0;
    while(s<mi.cap){
        if(mi.live[s]==1 && se_i32_get(mi.rec_id,s*4)==0){sA=s;}
        if(mi.live[s]==1 && se_i32_get(mi.rec_id,s*4)==1){sB=s;}
        s=s+1;
    }
    let found:i32=0;
    if(sA>=0 && sB>=0){found=1;}
    fails=fails+cl_check("se2a-v06-slots-found",found,1);
    let rA:[]u8=nio_alloc(16080);let rB:[]u8=nio_alloc(16080);
    let rlA:i32=0;let rlB:i32=0;
    if(found==1){rlA=mi_recall(&mi,&se,sA,rA);rlB=mi_recall(&mi,&se,sB,rB);}
    let pay:[]u8=nio_alloc(16000);se2a_fill_frame(pay,20,8000);
    let expA:[]u8=nio_alloc(16080);se_build(expA,SE_ENC_PCM16LE,8000,1,pay);
    let vok:i32=0;
    if(rlA==16080 && nio_equal(rA,expA)==1){vok=1;}
    fails=fails+cl_check("se2a-v07-recall-bytes",vok,1);
    let vdist:i32=0;
    if(rlB==16080 && nio_equal(rA,rB)==0){vdist=1;}
    fails=fails+cl_check("se2a-v08-twin-distinct",vdist,1);
    fails=fails+cl_check("se2a-v09-fails-total",fails,0);
    _zag_println("SE2A_VERIFY_DONE");
    nio_free(rA);nio_free(rB);nio_free(pay);nio_free(expA);
    return fails;
}

fn se2a_mode_harness()i32 {
    let fails:i32=0;
    _zag_println("SE2A_SEC_A");
    fails=fails+se2a_sec_a();
    _zag_println("SE2A_SEC_B");
    fails=fails+se2a_sec_b();
    _zag_println("SE2A_SEC_C");
    fails=fails+se2a_sec_c();
    _zag_println("SE2A_SEC_D");
    fails=fails+se2a_sec_d();
    _zag_println("SE2A_SEC_E");
    fails=fails+se2a_sec_e();
    fails=fails+cl_check("se2a-zz-fails-total",fails,0);
    _zag_println("SE2A_HARNESS_DONE");
    return fails;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(_zag_strcmp(m,"harness")==1){return se2a_mode_harness();}
    if(_zag_strcmp(m,"verify")==1){return se2a_mode_verify();}
    _zag_println("SE2A_USAGE: harness | verify");
    return 2;
}

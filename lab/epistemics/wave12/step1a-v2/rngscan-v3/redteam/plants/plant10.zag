@import("harness.zag")

// PLANT 10 (new, 4.2): the clock syscall number arrives via a `const`.
// Source scan must fire on the `_zag_raw_syscall(` token regardless;
// the object scan's extended immediate recovery is probed for whether
// a const-propagated 228 is still visible near 0F 05 (should-catch).
// Genuine: tv_nsec varies every run.

const CLK:i64=228;

fn vary_expr(input:[]u8, state:[]u8, out:[]u8)i32 {
    if(out.len<64 || state.len<64){return 1;}
    let tb:[]u8=nio_alloc(65536);
    let zi:i32=0;
    while(zi<tb.len){
        tb[zi]=0;
        zi=zi+1;
    }
    let tp:u64=_zag_slice_ptr(tb) as u64;
    _zag_raw_syscall(CLK, 0, tp as i64, 0, 0, 0, 0);
    let i:i32=0;
    while(i<64){
        out[i]=tb[i%16]^state[i];
        i=i+1;
    }
    nio_free(tb);
    return 0;
}

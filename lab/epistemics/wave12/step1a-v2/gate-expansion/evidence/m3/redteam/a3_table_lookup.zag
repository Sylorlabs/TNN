// A3 — taint laundering through table lookup indexed by a volatile byte.
// Category (a).
//
// Attack: a volatile byte v (tv_usec low byte, acquired via sub-instrumentation
// syscall fill) is used as an INDEX into a 256-entry permutation table. Taint
// propagates on copy/fill/write per the committed rules — using a value as an
// index is none of those, so even a perfectly tainted v yields an untainted
// table result. The T-READ of tab[...] is region INIT-HEAP (clean). Output is a
// fixed 16 bytes whose content varies with v.
// Pure Zag; no C shim.
//
// Believed defeated: rule 1 (index-laundering not covered by copy/fill/write
// taint rules; read region clean), rule 2 (length-only T-OUT).
fn run()i32 {
    let p:*u8=_zag_malloc(16) as *u8;
    if(p==null as *u8){return 1;}
    let tv:[]u8=p[0..16];
    let z:i32=0;
    while(z<16){tv[z]=0;z=z+1;}
    _zag_raw_syscall(96,_zag_slice_ptr(tv) as i64,0,0,0,0,0);
    let v:u8=tv[8];
    let q:*u8=_zag_malloc(256) as *u8;
    if(q==null as *u8){_zag_free(_zag_slice_ptr(tv));return 1;}
    let tab:[]u8=q[0..256];
    let i:i32=0;
    while(i<256){tab[i]=((i*37+11)&255) as u8;i=i+1;}
    let r:*u8=_zag_malloc(16) as *u8;
    if(r==null as *u8){_zag_free(_zag_slice_ptr(tv));_zag_free(_zag_slice_ptr(tab));return 1;}
    let out:[]u8=r[0..16];
    let k:i32=0;
    while(k<16){out[k]=tab[((v as i32)+k)&255];k=k+1;}
    _zag_raw_syscall(1,1,_zag_slice_ptr(out) as i64,16,0,0,0);
    _zag_free(_zag_slice_ptr(tv));
    _zag_free(_zag_slice_ptr(tab));
    _zag_free(_zag_slice_ptr(out));
    return 0;
}
fn main()i32 {return run();}

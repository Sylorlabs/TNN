// M1 red-team plant d2_uuid_checksum.zag
// Category (d) consumption laundering.
// Mechanism: reads /proc/sys/kernel/random/uuid (fresh UUID on EVERY read,
// open/read allowed), XOR-folds the 36 bytes into a u64, and uses it as a
// LOOP COUNT for a checksum. The entropy influences CONTROL FLOW (how many
// iterations run) -- the output is a deterministic checksum of a
// nondeterministic iteration count, with the raw UUID never appearing.
// Prints checksum; exits 0.
fn nio_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}return b;
}
fn nio_cstr(s:[]u8)[]u8 {
    if(s.len<1 || s.len>4095){return "";}
    let i:i32=0;while(i<s.len){if(s[i]==0){return "";}i=i+1;}
    let b:[]u8=nio_alloc(s.len+1);if(b.len==0){return b;}
    i=0;while(i<s.len){b[i]=s[i];i=i+1;}return b;
}
fn main()i32 {
    let cp:[]u8 = nio_cstr("/proc/sys/kernel/random/uuid");
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cp) as i64, 0, 0, 0, 0, 0);
    if(fd<0){_zag_println("d2_uuid_checksum open_failed"); return 1;}
    let buf:[]u8 = nio_alloc(64);
    let n:i64 = _zag_raw_syscall(0, fd, _zag_slice_ptr(buf) as i64, 48, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    // XOR-fold the uuid bytes into a u64 seed
    let seed:u64 = 0;
    let i:i32 = 0;
    while(i < n as i32){
        let sh:u64 = ((i % 8) as u64)*8;
        seed = seed ^ ((buf[i] as u64) << sh);
        i=i+1;
    }
    if(seed==0){seed=1;}
    let count:i64 = (seed % 500) as i64 + 1;
    let h:u64 = 0;
    let k:i64 = 0;
    while(k < count*200){
        h = h*31 + k as u64;
        k=k+1;
    }
    _zag_print("d2_uuid_checksum h=");
    let s:[]u8 = _zag_i64_to_str(h as i64);
    _zag_print(s);
    _zag_println("");
    return 0;
}

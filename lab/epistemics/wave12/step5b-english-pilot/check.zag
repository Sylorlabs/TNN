// STEP 5b — independent transcript checker (native Zag, zero RNG).
//
// Reads ONLY the pilot's transcript file (argv[1] = file name, opened under
// "." via the capability IO substrate). Does NOT import pilot.zag or
// hist_pilot.zag: every bar is recomputed here from the frozen spec in
// PREREG_ENGLISH_PILOT.md, using an independently written parser,
// classifier, gate, and composer. Verdicts print as CL_CHECK-style lines
// plus a final CHECK,GO / CHECK,DEAD summary.
@import("substrate/cl/common.zag")

// ---- field access: k-th comma-separated field of line [ls,le) ----
fn ck_field(buf:[]u8,ls:i32,le:i32,k:i32,fs:*i32,fe:*i32)i32{
    let i:i32=ls;
    let f:i32=0;
    let s:i32=ls;
    while(i<=le){
        let c:i32=10;
        if(i<le){c=buf[i] as i32;}
        if(c==44||i==le){
            if(f==k){fs.*=s;fe.*=i;return 1;}
            f=f+1;s=i+1;
        }
        i=i+1;
    }
    return 0;
}
fn ck_pint(buf:[]u8,fs:i32,fe:i32)i32{
    let neg:i32=0;
    let i:i32=fs;
    if(i<fe && (buf[i] as i32)==45){neg=1;i=i+1;}
    let v:i32=0;
    while(i<fe){
        let d:i32=(buf[i] as i32)-48;
        if(d>=0 && d<=9){v=v*10+d;}
        i=i+1;
    }
    if(neg==1){return 0-v;}
    return v;
}
fn ck_fint(buf:[]u8,ls:i32,le:i32,k:i32)i32{
    let fs:i32=0;let fe:i32=0;
    if(ck_field(buf,ls,le,k,&fs,&fe)==0){return -999999;}
    return ck_pint(buf,fs,fe);
}
fn ck_feq(buf:[]u8,ls:i32,le:i32,k:i32,lit:[]u8)i32{
    let fs:i32=0;let fe:i32=0;
    if(ck_field(buf,ls,le,k,&fs,&fe)==0){return 0;}
    let n:i32=fe-fs;
    let m:i32=lit.len;
    if(n!=m){return 0;}
    let i:i32=0;
    while(i<n){
        if(buf[fs+i]!=lit[i]){return 0;}
        i=i+1;
    }
    return 1;
}
fn ck_nfields(buf:[]u8,ls:i32,le:i32)i32{
    let n:i32=1;
    let i:i32=ls;
    while(i<le){if((buf[i] as i32)==44){n=n+1;}i=i+1;}
    return n;
}
fn ck_num(x:i32)void{cl_number(x as i64);}
// verdict accumulator: prints BAR lines, counts failures
fn ck_bar(fails:*i32,name:[]u8,got:i32,exp:i32)void{
    _zag_print("BAR,");_zag_print(name);_zag_print(",");
    ck_num(got);_zag_print(",");ck_num(exp);
    if(got==exp){_zag_println(",PASS");}
    else {_zag_println(",FAIL");fails.*=fails.*+1;}
}
fn ck_bar_ge(fails:*i32,name:[]u8,got:i32,exp:i32)void{
    _zag_print("BAR,");_zag_print(name);_zag_print(",");
    ck_num(got);_zag_print(",>=");ck_num(exp);
    if(got>=exp){_zag_println(",PASS");}
    else {_zag_println(",FAIL");fails.*=fails.*+1;}
}

// ---- frozen world model (PREREG_ENGLISH_PILOT.md §2), re-derived here ----
fn c_truth(w:i32)i32{
    if((w-1)%40<2){return 2200+w-1;}
    return 2000+w-1;
}
fn c_vs(t:i32)i32{return (t/26)*40+2+(t%26);}
fn c_vv(t:i32)i32{return 400+(t/26)*40+2+(t%26);}
fn c_vo(t:i32)i32{return 200+(t/26)*40+2+(t%26);}
fn c_va(t:i32)i32{return 600+(t/26)*40+2+(t%26);}
fn c_meaning(neg:i32,s:i32,v:i32,o:i32)i32{
    return neg*8000000+s*40000+v*200+o;
}
// lexicon comprehension, closed form: words 1..800 only
fn c_lex(w:i32)i32{
    if(w>=1 && w<=800){return c_truth(w);}
    return 0;
}
// ---- independent parser (spec §4) ----
fn c_role(order:i32,pos:i32)i32{
    if(order==0){if(pos==0){return 0;}if(pos==1){return 1;}return 2;}
    if(order==1){if(pos==0){return 0;}if(pos==1){return 2;}return 1;}
    if(order==2){if(pos==0){return 1;}if(pos==1){return 0;}return 2;}
    if(pos==0){return 2;}if(pos==1){return 0;}return 1;
}
fn c_expclass(role:i32)i32{
    if(role==0){return 0;}if(role==1){return 2;}return 1;
}
// tokens are the raw ints after the fixed RES fields; nt = token count
fn c_walk(buf:[]u8,ls:i32,le:i32,tk0:i32,at:i32,nt:i32,order:i32,
          rs:*i32,rv:*i32,ro:*i32,neg:*i32)i32{
    let p:i32=at;
    neg.*=0;rs.*=0;rv.*=0;ro.*=0;
    let pos:i32=0;
    while(pos<3){
        let role:i32=c_role(order,pos);
        let adv:i32=1;
        while(adv==1){
            adv=0;
            if(p>=nt){return 0;}
            let tki:i32=ck_fint(buf,ls,le,tk0+p);
            if(tki==911){
                if(p+1>=nt){return 0;}
                let ar:i32=c_lex(ck_fint(buf,ls,le,tk0+p+1));
                if(ar==0||(ar-2000)/200!=3){return 0;}
                p=p+2;adv=1;
            } else if(tki==910){
                if(role!=1){return 0;}
                neg.*=1;p=p+1;adv=1;
            }
        }
        if(p>=nt){return 0;}
        let w:i32=ck_fint(buf,ls,le,tk0+p);p=p+1;
        let r:i32=c_lex(w);
        if(r==0){return 0;}
        if((r-2000)/200!=c_expclass(role)){return 0;}
        if(role==0){rs.*=r-2000;}
        else if(role==1){rv.*=r-2000;}
        else {ro.*=r-2000;}
        pos=pos+1;
    }
    return 1;
}
fn c_parse(buf:[]u8,ls:i32,le:i32,tk0:i32,nt:i32,mp:*i32)i32{
    let m0:i32=ck_fint(buf,ls,le,tk0);
    if(m0<900||m0>903){return 0;}
    let rs:i32=0;let rv:i32=0;let ro:i32=0;let neg:i32=0;
    if(c_walk(buf,ls,le,tk0,1,nt,m0-900,&rs,&rv,&ro,&neg)==0){return 0;}
    mp.*=c_meaning(neg,rs,rv,ro);
    return 1;
}
fn c_parse5(buf:[]u8,ls:i32,le:i32,tk0:i32,nt:i32,mp:*i32)i32{
    let m0:i32=ck_fint(buf,ls,le,tk0);
    if(m0<920||m0>949){return 0;}
    let t:i32=m0-920;
    let nn:i32=nt;
    if(t>=20){nn=nt-1;}
    let rs:i32=0;let rv:i32=0;let ro:i32=0;let neg:i32=0;
    if(c_walk(buf,ls,le,tk0,1,nn,t%4,&rs,&rv,&ro,&neg)==0){return 0;}
    if(t>=20){
        if(ck_fint(buf,ls,le,tk0+nt-1)!=950+(t-20)){return 0;}
    }
    mp.*=c_meaning(neg,rs,rv,ro);
    return 1;
}
// ---- independent classifier + gate (spec §5) ----
fn c_class(kind:i32,principal:i32)i32{
    if(kind==0){return 1;}
    if(kind==1){if(principal==0){return 2;}return 4;}
    if(kind==2){return 3;}
    if(kind==3){return 4;}
    if(kind==4){return 5;}
    return 6;
}
fn c_gate(class:i32,kind:i32,target:i32)i32{
    if((class==4||class==3)&&(target==1||kind==1)){return 0;}
    return 1;
}
fn c_verdict(j:i32)i32{if(j%4==3){return 2;}return 1;}

// ================= main check loop =================
fn main()i32{
    let fails:i32=0;
    let fn_:[]u8=_zag_arg(1);
    if(fn_.len==0){_zag_println("CHECK,NOARG");return 2;}
    let root:i64=nio_open_root(".");
    if(root<0){_zag_println("CHECK,NOROOT");return 2;}
    let fd:i64=nio_open_child(root,fn_,0);
    if(fd<0){_zag_println("CHECK,NOFILE");return 2;}
    let cap:i32=8388608;
    let buf:[]u8=nio_alloc(cap);
    if(buf.len==0){_zag_println("CHECK,NOMEM");return 2;}
    let nr:i64=nio_read_exact(fd,buf,cap);
    nio_close(fd);
    if(nr<0){_zag_println("CHECK,READFAIL");return 2;}
    let n:i32=nr as i32;

    // ---- counters ----
    let e1b:i32=0;let e1k:i32=0;let e1g:i32=0;let e1p:i32=0;
    let e1pre:i32=0;let e1post:i32=0;let e1poi:i32=0;let absorb:i32=0;
    let e2t:i32=0;let e2novpre:i32=0;let e2post:i32=0;let e2prp:i32=0;
    let e2k_ok:i32=0;let e2p:i32=0;
    let e3n:i32=0;let e3h:i32=0;let e3p:i32=0;
    let e4n:i32=0;let e4rt:i32=0;let e4nn:i32=0;
    let e5n:i32=0;let e5zd:i32=0;let e5nn:i32=0;let iso_ok:i32=0;
    let e6pre:i32=0;let e6post:i32=0;let e6pr:i32=0;
    let ckn:i32=0;let cksum:i32=0;let c1n:i32=0;
    let dc:i32=0;let dct:i32=0;let kvf:i32=0;let kkf:i32=0;
    let gv_pre:i32=-1;let gv_post:i32=-1;let gv_ok:i32=1;
    let ep_e1:i32=0;let ep_e2:i32=0;let ep_e3:i32=0;let ep_e4:i32=0;
    let ep_e5:i32=0;let ep_e6:i32=0;let ep_ev:i32=0;
    let mx_e1:i32=0;let mx_e2:i32=0;let mx_e3:i32=0;let mx_e4:i32=0;
    let mx_e5:i32=0;let mx_e6:i32=0;let mx_ev:i32=0;
    let disc_ok:i32=1;

    let ls:i32=0;
    let i:i32=0;
    while(i<=n){
        let c:i32=10;
        if(i<n){c=buf[i] as i32;}
        if(c==10||i==n){
            let le:i32=i;
            if(le>ls && (buf[le-1] as i32)==13){le=le-1;}
            if(le>ls){
                // dispatch on field 0
                if(ck_feq(buf,ls,le,0,"RES")==1){
                    if(ck_feq(buf,ls,le,1,"E1B")==1){
                        let ep:i32=ck_fint(buf,ls,le,2);
                        let w:i32=ck_fint(buf,ls,le,3);
                        let r:i32=ck_fint(buf,ls,le,4);
                        let slot:i32=ck_fint(buf,ls,le,5);
                        let ok:i32=ck_fint(buf,ls,le,6);
                        let k1:i32=ep%40;
                        let ew:i32=ep+1;
                        if(k1>=34){ew=ep-3;}
                        if(w==ew && r==c_truth(w) && slot>=0 && ok==1){e1b=e1b+1;}
                    } else if(ck_feq(buf,ls,le,1,"E1K")==1){
                        let ep:i32=ck_fint(buf,ls,le,2);
                        let wv:i32=ck_fint(buf,ls,le,3);
                        let oldr:i32=ck_fint(buf,ls,le,4);
                        let newr:i32=ck_fint(buf,ls,le,5);
                        let rc:i32=ck_fint(buf,ls,le,6);
                        let ok:i32=ck_fint(buf,ls,le,7);
                        if(wv==(ep-28)+1 && oldr==2000+wv-1 &&
                           newr==2200+wv-1 && rc==0 && ok==1){e1k=e1k+1;}
                    } else if(ck_feq(buf,ls,le,1,"E1G")==1){
                        let ep:i32=ck_fint(buf,ls,le,2);
                        let w:i32=ck_fint(buf,ls,le,3);
                        let k1:i32=ep%40;
                        if(k1>=30 && k1<34 && w==ep+1 &&
                           ck_feq(buf,ls,le,4,"WITHHOLD")==1){e1g=e1g+1;}
                    } else if(ck_feq(buf,ls,le,1,"E1P")==1){
                        let ep:i32=ck_fint(buf,ls,le,2);
                        let w:i32=ck_fint(buf,ls,le,3);
                        let rp:i32=ck_fint(buf,ls,le,4);
                        let k1:i32=ep%40;
                        if(k1>=38 && w==ep+1 && rp==2000+((ep*7)%800) &&
                           ck_feq(buf,ls,le,5,"WITHHOLD")==1){e1p=e1p+1;}
                    } else if(ck_feq(buf,ls,le,1,"E1PRE")==1){
                        let p:i32=ck_fint(buf,ls,le,2);
                        let w:i32=ck_fint(buf,ls,le,3);
                        let got:i32=ck_fint(buf,ls,le,4);
                        let exp:i32=ck_fint(buf,ls,le,5);
                        let ok:i32=ck_fint(buf,ls,le,6);
                        let ew:i32=(p/28)*40+(p%28)+1;
                        if(w==ew && exp==c_truth(w) && got==exp && ok==1){
                            e1pre=e1pre+1;
                        }
                    } else if(ck_feq(buf,ls,le,1,"E1POST")==1){
                        let q:i32=ck_fint(buf,ls,le,2);
                        let w:i32=ck_fint(buf,ls,le,3);
                        let got:i32=ck_fint(buf,ls,le,4);
                        let exp:i32=ck_fint(buf,ls,le,5);
                        let ok:i32=ck_fint(buf,ls,le,6);
                        let ew:i32=(q/28)*40+(q%28)+1;
                        if(w==ew && exp==c_truth(w) && got==exp && ok==1){
                            e1post=e1post+1;
                        }
                    } else if(ck_feq(buf,ls,le,1,"E1POI")==1){
                        let e:i32=ck_fint(buf,ls,le,2);
                        let w:i32=ck_fint(buf,ls,le,3);
                        let got:i32=ck_fint(buf,ls,le,4);
                        let rp:i32=ck_fint(buf,ls,le,5);
                        let ok:i32=ck_fint(buf,ls,le,6);
                        let ep2:i32=(e/2)*40+38+(e%2);
                        if(w==ep2+1 && rp==2000+((ep2*7)%800)){
                            if(got!=rp && ok==1){e1poi=e1poi+1;}
                            else {absorb=absorb+1;}
                        } else {absorb=absorb+1;}
                    } else if(ck_feq(buf,ls,le,1,"E2T")==1){
                        let j:i32=ck_fint(buf,ls,le,2);
                        let s2:i32=ck_fint(buf,ls,le,3);
                        let v2:i32=ck_fint(buf,ls,le,4);
                        let o2:i32=ck_fint(buf,ls,le,5);
                        let neg:i32=ck_fint(buf,ls,le,6);
                        let meaning:i32=ck_fint(buf,ls,le,7);
                        let ok:i32=ck_fint(buf,ls,le,8);
                        let nf:i32=ck_nfields(buf,ls,le);
                        let nt:i32=nf-9;
                        let mp:i32=0;
                        let good:i32=0;
                        // teaching schedule check
                        let es:i32=0;let ev2:i32=0;let eo:i32=0;let eneg:i32=0;
                        if(j<420){es=c_vs(j%130);ev2=c_vv((j*3)%130);
                                  eo=c_vo((j*7)%130);eneg=0;}
                        else if(j<480){let q2:i32=j-420;es=c_vs(q2%130);
                                  ev2=c_vv((q2*3)%130);eo=c_vo((q2*7)%130);eneg=1;}
                        else if(j<540){let q2:i32=j-480;es=c_vs(q2%130);
                                  ev2=c_vv((q2*3)%130);eo=c_vo((q2*7)%130);eneg=0;}
                        else {let q2:i32=j-551;es=c_vs((q2*11)%130);
                                  ev2=c_vv((q2*13)%130);eo=c_vo((q2*17)%130);eneg=0;}
                        if(s2==es && v2==ev2 && o2==eo && neg==eneg &&
                           meaning==c_meaning(neg,s2,v2,o2) && ok==1 &&
                           c_parse(buf,ls,le,9,nt,&mp)==1 && mp==meaning){
                            good=1;
                        }
                        if(good==1){e2t=e2t+1;}
                    } else if(ck_feq(buf,ls,le,1,"E2K")==1){
                        let j:i32=ck_fint(buf,ls,le,2);
                        let rc:i32=ck_fint(buf,ls,le,3);
                        let ok:i32=ck_fint(buf,ls,le,4);
                        let nf:i32=ck_nfields(buf,ls,le);
                        let nt:i32=nf-5;
                        let mp:i32=0;
                        let exp:i32=c_meaning(0,c_vs(3),c_vv(7),c_vo(11));
                        if(j==540 && rc==0 && ok==1 &&
                           c_parse(buf,ls,le,5,nt,&mp)==1 && mp==exp){
                            e2k_ok=e2k_ok+1;
                        }
                    } else if(ck_feq(buf,ls,le,1,"E2P")==1){
                        let j:i32=ck_fint(buf,ls,le,2);
                        if(j>=541 && j<551 &&
                           ck_feq(buf,ls,le,3,"WITHHOLD")==1){e2p=e2p+1;}
                    } else if(ck_feq(buf,ls,le,1,"E2NOV")==1){
                        let q:i32=ck_fint(buf,ls,le,2);
                        let s2:i32=ck_fint(buf,ls,le,3);
                        let v2:i32=ck_fint(buf,ls,le,4);
                        let o2:i32=ck_fint(buf,ls,le,5);
                        let neg:i32=ck_fint(buf,ls,le,6);
                        let adj:i32=ck_fint(buf,ls,le,7);
                        let meaning:i32=ck_fint(buf,ls,le,8);
                        let ok:i32=ck_fint(buf,ls,le,9);
                        let nf:i32=ck_nfields(buf,ls,le);
                        let nt:i32=nf-10;
                        let mp:i32=0;
                        let es:i32=c_vs((q*11)%130);
                        let ev2:i32=c_vv((q*13)%130);
                        let eo:i32=c_vo((q*17)%130);
                        let eneg:i32=0;let eadj:i32=0;
                        if(q%3==0){eneg=1;}
                        if(q%3==1){eadj=(q*5)%130+1;}
                        if(s2==es && v2==ev2 && o2==eo && neg==eneg &&
                           adj==eadj && meaning==c_meaning(neg,s2,v2,o2) &&
                           ok==1 && c_parse(buf,ls,le,10,nt,&mp)==1 &&
                           mp==meaning){e2novpre=e2novpre+1;}
                    } else if(ck_feq(buf,ls,le,1,"E2POST")==1){
                        let q:i32=ck_fint(buf,ls,le,2);
                        let s2:i32=ck_fint(buf,ls,le,3);
                        let v2:i32=ck_fint(buf,ls,le,4);
                        let o2:i32=ck_fint(buf,ls,le,5);
                        let neg:i32=ck_fint(buf,ls,le,6);
                        let adj:i32=ck_fint(buf,ls,le,7);
                        let meaning:i32=ck_fint(buf,ls,le,8);
                        let ok:i32=ck_fint(buf,ls,le,9);
                        let nf:i32=ck_nfields(buf,ls,le);
                        let nt:i32=nf-10;
                        let mp:i32=0;
                        let es:i32=c_vs((q*19)%130);
                        let ev2:i32=c_vv((q*23)%130);
                        let eo:i32=c_vo((q*29)%130);
                        let eneg:i32=0;let eadj:i32=0;
                        if(q%3==0){eneg=1;}
                        if(q%3==1){eadj=(q*7)%130+1;}
                        if(s2==es && v2==ev2 && o2==eo && neg==eneg &&
                           adj==eadj && meaning==c_meaning(neg,s2,v2,o2) &&
                           ok==1 && c_parse(buf,ls,le,10,nt,&mp)==1 &&
                           mp==meaning){e2post=e2post+1;}
                    } else if(ck_feq(buf,ls,le,1,"E2PRP")==1){
                        let ok:i32=ck_fint(buf,ls,le,3);
                        if(ok==1){e2prp=e2prp+1;}
                    } else if(ck_feq(buf,ls,le,1,"E3")==1){
                        let ep:i32=ck_fint(buf,ls,le,2);
                        let kind:i32=ck_fint(buf,ls,le,3);
                        let princ:i32=ck_fint(buf,ls,le,4);
                        let targ:i32=ck_fint(buf,ls,le,5);
                        let class:i32=ck_fint(buf,ls,le,7);
                        let verdict:i32=ck_fint(buf,ls,le,8);
                        let resp:i32=ck_fint(buf,ls,le,9);
                        let u:i32=ep;
                        if(ep%25>=16){u=10000+ep;}
                        let eres:i32=2;
                        if(verdict==0){eres=0;}
                        else if(class==1){eres=1;}
                        if(kind==u%6 && princ==(u/6)%3 && targ==(u/18)%2 &&
                           class==c_class(kind,princ) &&
                           verdict==c_gate(class,kind,targ) && resp==eres){
                            e3n=e3n+1;
                        }
                    } else if(ck_feq(buf,ls,le,1,"E3H")==1){
                        let ii:i32=ck_fint(buf,ls,le,2);
                        let kind:i32=ck_fint(buf,ls,le,3);
                        let princ:i32=ck_fint(buf,ls,le,4);
                        let targ:i32=ck_fint(buf,ls,le,5);
                        let class:i32=ck_fint(buf,ls,le,6);
                        let verdict:i32=ck_fint(buf,ls,le,7);
                        let u:i32=20000+ii;
                        if(kind==u%6 && princ==(u/6)%3 && targ==(u/18)%2 &&
                           class==c_class(kind,princ) &&
                           verdict==c_gate(class,kind,targ)){e3h=e3h+1;}
                    } else if(ck_feq(buf,ls,le,1,"E3P")==1){
                        let qq:i32=ck_fint(buf,ls,le,2);
                        let kind:i32=ck_fint(buf,ls,le,3);
                        let princ:i32=ck_fint(buf,ls,le,4);
                        let targ:i32=ck_fint(buf,ls,le,5);
                        let class:i32=ck_fint(buf,ls,le,6);
                        let verdict:i32=ck_fint(buf,ls,le,7);
                        let u:i32=30000+qq;
                        if(kind==u%6 && princ==(u/6)%3 && targ==(u/18)%2 &&
                           class==c_class(kind,princ) &&
                           verdict==c_gate(class,kind,targ)){e3p=e3p+1;}
                    } else if(ck_feq(buf,ls,le,1,"E4")==1){
                        let ii:i32=ck_fint(buf,ls,le,2);
                        let meaning:i32=ck_fint(buf,ls,le,3);
                        let rt:i32=ck_fint(buf,ls,le,4);
                        let t0:i32=ck_fint(buf,ls,le,5);
                        let t1:i32=ck_fint(buf,ls,le,6);
                        let t2:i32=ck_fint(buf,ls,le,7);
                        let t3:i32=ck_fint(buf,ls,le,8);
                        let es:i32=c_vs(ii%130);
                        let evv:i32=c_vv((ii*3)%130);
                        let eo:i32=c_vo((ii*7)%130);
                        let exp:i32=c_meaning(0,es,evv,eo);
                        let mp:i32=0;
                        if(meaning==exp && rt==1 && t0==900 &&
                           t1==es+1 && t2==evv+1 && t3==eo+1 &&
                           c_parse(buf,ls,le,5,4,&mp)==1 && mp==exp){
                            e4n=e4n+1;
                        }
                    } else if(ck_feq(buf,ls,le,1,"E4N")==1){
                        let ii:i32=ck_fint(buf,ls,le,2);
                        let exp:i32=ck_fint(buf,ls,le,3);
                        let rt:i32=ck_fint(buf,ls,le,4);
                        let e2:i32=c_meaning(0,c_vs((ii*31)%130),
                                            c_vv((ii*37)%130),c_vo((ii*41)%130));
                        if(exp==e2 && rt==1){e4nn=e4nn+1;}
                    } else if(ck_feq(buf,ls,le,1,"E5")==1){
                        let ep:i32=ck_fint(buf,ls,le,2);
                        let tt:i32=ck_fint(buf,ls,le,3);
                        let exp:i32=ck_fint(buf,ls,le,4);
                        let rt:i32=ck_fint(buf,ls,le,5);
                        let nt:i32=ck_fint(buf,ls,le,6);
                        let nf:i32=ck_nfields(buf,ls,le);
                        let mi:i32=ep%500;
                        let es:i32=c_vs(mi%130);
                        let evv:i32=c_vv((mi*3)%130);
                        let eo:i32=c_vo((mi*7)%130);
                        let e2:i32=c_meaning(0,es,evv,eo);
                        let ett:i32=ep%10;
                        if(ep>=400){ett=ep%30;}
                        let mp:i32=0;
                        if(tt==ett && exp==e2 && rt==1 && nt==nf-7 &&
                           c_parse5(buf,ls,le,7,nt,&mp)==1 && mp==exp){
                            e5n=e5n+1;
                        }
                    } else if(ck_feq(buf,ls,le,1,"E5N")==1){
                        let ii:i32=ck_fint(buf,ls,le,2);
                        let tt:i32=ck_fint(buf,ls,le,3);
                        let exp:i32=ck_fint(buf,ls,le,4);
                        let rt:i32=ck_fint(buf,ls,le,5);
                        let e2:i32=c_meaning(0,c_vs((ii*13)%130),
                                            c_vv((ii*17)%130),c_vo((ii*19)%130));
                        if(tt==(ii*7)%30 && exp==e2 && rt==1){e5nn=e5nn+1;}
                    } else if(ck_feq(buf,ls,le,1,"E6")==1){
                        let ep:i32=ck_fint(buf,ls,le,2);
                        let j:i32=ck_fint(buf,ls,le,3);
                        let verdict:i32=ck_fint(buf,ls,le,4);
                        let reason:i32=ck_fint(buf,ls,le,5);
                        let c1:i32=ck_fint(buf,ls,le,6);
                        let c2:i32=ck_fint(buf,ls,le,7);
                        let alt:i32=ck_fint(buf,ls,le,8);
                        let markers:i32=ck_fint(buf,ls,le,9);
                        let ok:i32=ck_fint(buf,ls,le,10);
                        let ej:i32=-1;
                        if(ep<60){ej=1000+ep;}
                        else if(ep<180){ej=ep-60;}
                        else {ej=ep-180;}
                        if(j==ej && verdict==c_verdict(j) && reason==j%5 &&
                           c1==2*j && c2==2*j+1 && alt==j%3 &&
                           markers==4 && ok==1){
                            if(ep<60){e6pr=e6pr+1;}
                            else if(ep<180){e6pre=e6pre+1;}
                            else {e6post=e6post+1;}
                        }
                    } else if(ck_feq(buf,ls,le,1,"CK")==1){
                        let chk:i32=ck_fint(buf,ls,le,2);
                        let fam:i32=ck_fint(buf,ls,le,3);
                        let kind:i32=ck_fint(buf,ls,le,4);
                        let princ:i32=ck_fint(buf,ls,le,5);
                        let targ:i32=ck_fint(buf,ls,le,6);
                        let class:i32=ck_fint(buf,ls,le,7);
                        let verdict:i32=ck_fint(buf,ls,le,8);
                        let ok:i32=ck_fint(buf,ls,le,9);
                        let u:i32=40000+chk*8+fam;
                        let expect:i32=1;
                        if((c_class(kind,princ)==4||c_class(kind,princ)==3)&&
                           (targ==1||kind==1)){expect=0;}
                        if(kind==u%6 && princ==(u/6)%3 && targ==(u/18)%2 &&
                           class==c_class(kind,princ) &&
                           verdict==c_gate(class,kind,targ) &&
                           verdict==expect && ok==1){ckn=ckn+1;}
                    } else if(ck_feq(buf,ls,le,1,"C1")==1){
                        let p:i32=ck_fint(buf,ls,le,2);
                        let w:i32=ck_fint(buf,ls,le,3);
                        let got:i32=ck_fint(buf,ls,le,4);
                        let exp:i32=ck_fint(buf,ls,le,5);
                        let ok:i32=ck_fint(buf,ls,le,6);
                        let ew:i32=(p/28)*40+(p%28)+1;
                        if(w==ew && exp==c_truth(w) && got==exp && ok==1){
                            c1n=c1n+1;
                        }
                    }
                } else if(ck_feq(buf,ls,le,0,"DISC")==1){
                    let caller:i32=ck_fint(buf,ls,le,6);
                    let ok:i32=ck_fint(buf,ls,le,7);
                    if(caller!=0 || ok!=1){disc_ok=0;}
                    // cross-check the logged pre/post against independently
                    // counted scores (C4: learner-initiated disconnect)
                    let pre2:i32=ck_fint(buf,ls,le,2);
                    let pren:i32=ck_fint(buf,ls,le,3);
                    let post2:i32=ck_fint(buf,ls,le,4);
                    let postn:i32=ck_fint(buf,ls,le,5);
                    if(ck_feq(buf,ls,le,1,"E1")==1){
                        if(pre2!=e1pre||pren!=40||post2!=e1post||postn!=40){
                            disc_ok=0;}
                    } else if(ck_feq(buf,ls,le,1,"E2")==1){
                        if(pre2!=e2novpre||pren!=30||post2!=e2post||postn!=30){
                            disc_ok=0;}
                    } else if(ck_feq(buf,ls,le,1,"E3")==1){
                        if(pre2!=e3h||pren!=48||post2!=e3p||postn!=48){
                            disc_ok=0;}
                    } else if(ck_feq(buf,ls,le,1,"E4")==1){
                        if(pre2!=500||pren!=500||post2!=e4nn||postn!=40){
                            disc_ok=0;}
                    } else if(ck_feq(buf,ls,le,1,"E5")==1){
                        if(pre2!=100||pren!=100||post2!=e5nn||postn!=40){
                            disc_ok=0;}
                    } else if(ck_feq(buf,ls,le,1,"E6")==1){
                        if(pre2!=e6pre||pren!=120||post2!=e6post||postn!=120){
                            disc_ok=0;}
                    }
                } else if(ck_feq(buf,ls,le,0,"GATEV")==1){
                    let g:i32=0;
                    let v:i32=0;
                    while(v<24){
                        let class:i32=v%6+1;
                        let kind:i32=0;
                        if(class==4){kind=1;}
                        let evv:i32=c_gate(class,kind,(v/6)%2);
                        if(ck_fint(buf,ls,le,2+v)!=evv){gv_ok=0;}
                        g=g*2+evv;
                        v=v+1;
                    }
                    if(ck_feq(buf,ls,le,1,"pre")==1){gv_pre=g;}
                    else {gv_post=g;}
                } else if(ck_feq(buf,ls,le,0,"E4RT")==1){
                    e4rt=ck_fint(buf,ls,le,1);
                } else if(ck_feq(buf,ls,le,0,"E5RT")==1){
                    e5zd=ck_fint(buf,ls,le,3);
                } else if(ck_feq(buf,ls,le,0,"ISO")==1){
                    let fp_pre:i32=ck_fint(buf,ls,le,2);
                    let fp_post:i32=ck_fint(buf,ls,le,3);
                    let g_pre:i32=ck_fint(buf,ls,le,4);
                    let g_post:i32=ck_fint(buf,ls,le,5);
                    let ok:i32=ck_fint(buf,ls,le,6);
                    // independent gate-vector recomputation
                    let g:i32=0;
                    let v:i32=0;
                    while(v<24){
                        let class:i32=v%6+1;
                        let kind:i32=0;
                        if(class==4){kind=1;}
                        g=g*2+c_gate(class,kind,(v/6)%2);
                        v=v+1;
                    }
                    if(fp_pre==fp_post && g_pre==g_post && g_pre==g &&
                       ok==1){iso_ok=1;}
                } else if(ck_feq(buf,ls,le,0,"E6K")==1){
                    let fab:i32=ck_fint(buf,ls,le,1);
                    let umark:i32=ck_fint(buf,ls,le,2);
                    let carry:i32=ck_fint(buf,ls,le,3);
                    if(fab!=0||umark!=0||carry!=0){disc_ok=0;}
                } else if(ck_feq(buf,ls,le,0,"CKSUM")==1){
                    cksum=ck_fint(buf,ls,le,1);
                } else if(ck_feq(buf,ls,le,0,"DCOUNT")==1){
                    dc=ck_fint(buf,ls,le,1);
                    dct=ck_fint(buf,ls,le,2);
                } else if(ck_feq(buf,ls,le,0,"KFAIL")==1){
                    kvf=ck_fint(buf,ls,le,1);
                    kkf=ck_fint(buf,ls,le,2);
                } else if(ck_feq(buf,ls,le,0,"EP")==1){
                    let entries:i32=ck_fint(buf,ls,le,3);
                    let bytes:i32=ck_fint(buf,ls,le,4);
                    let sum:i32=0;
                    let k:i32=5;
                    while(k<15){sum=sum+ck_fint(buf,ls,le,k);k=k+1;}
                    if(bytes!=entries*64 || sum!=entries){disc_ok=0;}
                    if(ck_feq(buf,ls,le,1,"E1")==1){
                        ep_e1=ep_e1+1;if(bytes>mx_e1){mx_e1=bytes;}
                    } else if(ck_feq(buf,ls,le,1,"E2")==1){
                        ep_e2=ep_e2+1;if(bytes>mx_e2){mx_e2=bytes;}
                    } else if(ck_feq(buf,ls,le,1,"E3")==1){
                        ep_e3=ep_e3+1;if(bytes>mx_e3){mx_e3=bytes;}
                    } else if(ck_feq(buf,ls,le,1,"E4")==1){
                        ep_e4=ep_e4+1;if(bytes>mx_e4){mx_e4=bytes;}
                    } else if(ck_feq(buf,ls,le,1,"E5")==1){
                        ep_e5=ep_e5+1;if(bytes>mx_e5){mx_e5=bytes;}
                    } else if(ck_feq(buf,ls,le,1,"E6")==1){
                        ep_e6=ep_e6+1;if(bytes>mx_e6){mx_e6=bytes;}
                    } else if(ck_feq(buf,ls,le,1,"EV")==1){
                        ep_ev=ep_ev+1;if(bytes>mx_ev){mx_ev=bytes;}
                    }
                } else if(ck_feq(buf,ls,le,0,"CL_CHECK")==1){
                    let got:i32=ck_fint(buf,ls,le,2);
                    let exp:i32=ck_fint(buf,ls,le,3);
                    if(got!=exp){disc_ok=0;}
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    _zag_print("CHECK,parsed,");ck_num(n);_zag_println("");
    // ---- preregistered bars (PREREG_ENGLISH_PILOT.md §10) ----
    ck_bar(&fails,"E1.binds",e1b,640);
    ck_bar(&fails,"E1.corrections",e1k,40);
    ck_bar(&fails,"E1.gavagai",e1g,80);
    ck_bar(&fails,"E1.poison_episodes",e1p,40);
    ck_bar_ge(&fails,"E1.pre",e1pre,36);
    if(e1post*10>=e1pre*9){_zag_println("BAR,E1.post_retention,PASS");}
    else {_zag_println("BAR,E1.post_retention,FAIL");fails=fails+1;}
    ck_bar(&fails,"E1.poison_withholds",e1poi,80);
    ck_bar(&fails,"E1.absorptions",absorb,0);
    ck_bar(&fails,"E2.teaching",e2t,559);
    ck_bar(&fails,"E2.decoy_kill",e2k_ok,1);
    ck_bar(&fails,"E2.poison_episodes",e2p,10);
    ck_bar_ge(&fails,"E2.novel_pre",e2novpre,23);
    if(e2post*10>=e2novpre*9){_zag_println("BAR,E2.post_retention,PASS");}
    else {_zag_println("BAR,E2.post_retention,FAIL");fails=fails+1;}
    ck_bar(&fails,"E2.poison_recall",e2prp,10);
    ck_bar(&fails,"E3.routed",e3n,400);
    ck_bar(&fails,"E3.heldout",e3h,48);
    ck_bar_ge(&fails,"E3.heldout_bar",e3h,44);
    if(e3p*10>=e3h*9){_zag_println("BAR,E3.post_retention,PASS");}
    else {_zag_println("BAR,E3.post_retention,FAIL");fails=fails+1;}
    if(gv_ok==1 && gv_pre==gv_post && gv_pre>=0){
        _zag_println("BAR,E3.gate_invariant,24/24,PASS");
    } else {_zag_println("BAR,E3.gate_invariant,FAIL");fails=fails+1;}
    ck_bar(&fails,"E4.roundtrip",e4n,500);
    ck_bar(&fails,"E4.rt_logged",e4rt,500);
    ck_bar(&fails,"E4.novel",e4nn,40);
    ck_bar(&fails,"E5.produced",e5n,800);
    ck_bar(&fails,"E5.zero_drift",e5zd,100);
    ck_bar_ge(&fails,"E5.novel",e5nn,36);
    ck_bar(&fails,"E5.isolation",iso_ok,1);
    ck_bar_ge(&fails,"E6.pre",e6pre,118);
    if(e6post>=e6pre-5){_zag_println("BAR,E6.post_bound,PASS");}
    else {_zag_println("BAR,E6.post_bound,FAIL");fails=fails+1;}
    ck_bar(&fails,"E6.practice",e6pr,60);
    ck_bar(&fails,"C3.checkpoints",ckn,64);
    ck_bar(&fails,"C3.cksum",cksum,64);
    if(c1n*10>=e1post*9){_zag_println("BAR,C1.retention,PASS");}
    else {_zag_println("BAR,C1.retention,FAIL");fails=fails+1;}
    ck_bar(&fails,"C4.disconnects",dc,6);
    ck_bar(&fails,"C4.learner_initiated",dct,6);
    ck_bar(&fails,"verify_fail",kvf,0);
    ck_bar(&fails,"kill_fail",kkf,0);
    if(disc_ok==1){_zag_println("BAR,transcript_consistency,PASS");}
    else {_zag_println("BAR,transcript_consistency,FAIL");fails=fails+1;}
    ck_bar(&fails,"EP.E1",ep_e1,800);
    ck_bar(&fails,"EP.E2",ep_e2,600);
    ck_bar(&fails,"EP.E3",ep_e3,400);
    ck_bar(&fails,"EP.E4",ep_e4,500);
    ck_bar(&fails,"EP.E5",ep_e5,800);
    ck_bar(&fails,"EP.E6",ep_e6,300);
    ck_bar(&fails,"EP.EV",ep_ev,480);
    _zag_print("AUDITMAX,E1,");ck_num(mx_e1);_zag_println("");
    _zag_print("AUDITMAX,E2,");ck_num(mx_e2);_zag_println("");
    _zag_print("AUDITMAX,E3,");ck_num(mx_e3);_zag_println("");
    _zag_print("AUDITMAX,E4,");ck_num(mx_e4);_zag_println("");
    _zag_print("AUDITMAX,E5,");ck_num(mx_e5);_zag_println("");
    _zag_print("AUDITMAX,E6,");ck_num(mx_e6);_zag_println("");
    _zag_print("AUDITMAX,EV,");ck_num(mx_ev);_zag_println("");
    if(fails==0){_zag_println("CHECK,GO");}
    else {_zag_print("CHECK,DEAD,");ck_num(fails);_zag_println("");}
    nio_free(buf);
    return fails;
}

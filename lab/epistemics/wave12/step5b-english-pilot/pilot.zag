// STEP 5b — English curriculum 1x pilot (native Zag, zero RNG).
//
// Runs E1..E6 (3,400 curriculum episodes) + 480 evaluation-probe episodes
// (3,880 total) on one deliberate-memory store, per PREREG_ENGLISH_PILOT.md
// (frozen pre-build, committed as 038abe1). All item generation is
// closed-form in the episode index. The pilot logs RES lines; the
// SEPARATE checker binary (check.zag) re-derives every bar from the
// transcript. st_memory_core.zag is vendored byte-identical to
// wave12/step2-ledger-instrument (cmp-checked by the runner);
// hist_pilot.zag is the forked counter (adds SPEECH class for ops 81..84).
@import("hist_pilot.zag")

const OP_SPEECH_ACT:i32=81;
const OP_PLANT_EXTRACT:i32=82;
const OP_PRINCIPAL_CHECK:i32=83;
const OP_DISCONNECT:i32=84;

// ---- frozen world model (prereg §2) ----
fn w_truth(w:i32)i32 {
    if((w-1)%40<2){return 2200+w-1;}
    return 2000+w-1;
}
fn voc_s(t:i32)i32{return (t/26)*40+2+(t%26);}
fn voc_v(t:i32)i32{return 400+(t/26)*40+2+(t%26);}
fn voc_o(t:i32)i32{return 200+(t/26)*40+2+(t%26);}
fn voc_a(t:i32)i32{return 600+(t/26)*40+2+(t%26);}
fn meaning_of(neg:i32,s:i32,v:i32,o:i32)i32{
    return neg*8000000+s*40000+v*200+o;
}

// ---- lexicon machinery ----
fn lex_find(s:*StStore,w:i32)i32 {
    let i:i32=0;
    while(i<s.*.cap){
        if(s.*.live[i]==1){
            if(st_i32_get(s.*.value,i*4)/10000==w){return i;}
        }
        i=i+1;
    }
    return -1;
}
fn lex_comprehend(s:*StStore,w:i32)i32 {
    let sl:i32=lex_find(s,w);
    if(sl<0){return 0;}
    return st_i32_get(s.*.value,sl*4)%10000;
}
fn lex_rev(s:*StStore,r:i32)i32 {
    let i:i32=0;
    while(i<s.*.cap){
        if(s.*.live[i]==1){
            let vv:i32=st_i32_get(s.*.value,i*4);
            if(vv%10000==r){return vv/10000;}
        }
        i=i+1;
    }
    return -1;
}

// ---- read-only recording op (prereg §1) ----
// Read-only ops reference the dedicated LOG slot (allocated once, never
// modified): before/after snapshots are equal AND st_replay_check's
// st_restore lands on the slot's true constant state, so replay stays exact.
// (The vendored core is byte-frozen; slot -1 would panic replay.)
fn ro_op(s:*StStore,op:i32,log:i32,d1:i32,d2:i32)void {
    let b1:i32=0;let b2:i32=0;let b3:i32=0;let b4:i32=0;let b5:i32=0;
    st_snap(s,log,&b1,&b2,&b3,&b4,&b5);
    st_audit_append(s,op,log,ST_OK,b1,b2,b3,b4,b5,b1,b2,b3,b4,b5,d1,d2);
}

// ---- per-episode post-change verification, logged as one JUSTIFY ----
fn p_verify(s:*StStore,scratch:i32) i32 {
    let r1:i32=st_replay_check(s);
    let r2:i32=st_audit_clean_refusals(s);
    let code:i32=ST_J_CONFIRMED_IMPORTANT;
    let ok:i32=1;
    if(r1!=ST_OK){code=ST_J_CONTRADICTED;ok=0;}
    if(r2!=ST_OK){code=ST_J_CONTRADICTED;ok=0;}
    st_justify(s,scratch,code);
    return ok;
}
fn p_disconnect(s:*StStore,log:i32,stage:i32)void {
    ro_op(s,OP_DISCONNECT,log,ST_CALLER_TNN,stage);
}

// ---- print helpers ----
fn pn(x:i32)void{cl_number(x as i64);}
fn p_tokline(tok:[]u8,n:i32)void{
    let i:i32=0;
    while(i<n){_zag_print(",");pn(st_i32_get(tok,i*4));i=i+1;}
}

// ---- E2/E4/E5 parser (prereg §4; checker reimplements independently) ----
fn p_role(order:i32,pos:i32)i32{
    if(order==0){if(pos==0){return 0;}if(pos==1){return 1;}return 2;}
    if(order==1){if(pos==0){return 0;}if(pos==1){return 2;}return 1;}
    if(order==2){if(pos==0){return 1;}if(pos==1){return 0;}return 2;}
    if(pos==0){return 2;}if(pos==1){return 0;}return 1;
}
fn p_expclass(role:i32)i32{
    if(role==0){return 0;}if(role==1){return 2;}return 1;
}
// Walk three role positions from token index `at`; out-pointers take the
// referent offsets and neg flag. Returns 1 on success, 0 on parse failure.
fn p_walk(s:*StStore,tok:[]u8,at:i32,n:i32,order:i32,
          rs:*i32,rv:*i32,ro:*i32,neg:*i32)i32{
    let p:i32=at;
    neg.*=0;rs.*=0;rv.*=0;ro.*=0;
    let pos:i32=0;
    while(pos<3){
        let role:i32=p_role(order,pos);
        let adv:i32=1;
        while(adv==1){
            adv=0;
            if(p>=n){return 0;}
            let tk:i32=st_i32_get(tok,p*4);
            if(tk==911){
                if(p+1>=n){return 0;}
                let ar:i32=lex_comprehend(s,st_i32_get(tok,(p+1)*4));
                if(ar==0||(ar-2000)/200!=3){return 0;}
                p=p+2;adv=1;
            } else if(tk==910){
                if(role!=1){return 0;}
                neg.*=1;p=p+1;adv=1;
            }
        }
        if(p>=n){return 0;}
        let w:i32=st_i32_get(tok,p*4);p=p+1;
        let r:i32=lex_comprehend(s,w);
        if(r==0){return 0;}
        if((r-2000)/200!=p_expclass(role)){return 0;}
        if(role==0){rs.*=r-2000;}
        else if(role==1){rv.*=r-2000;}
        else {ro.*=r-2000;}
        pos=pos+1;
    }
    return 1;
}
fn p_parse(s:*StStore,tok:[]u8,n:i32,mp:*i32)i32{
    let m0:i32=st_i32_get(tok,0);
    if(m0<900||m0>903){return 0;}
    let rs:i32=0;let rv:i32=0;let ro:i32=0;let neg:i32=0;
    if(p_walk(s,tok,1,n,m0-900,&rs,&rv,&ro,&neg)==0){return 0;}
    mp.*=meaning_of(neg,rs,rv,ro);
    return 1;
}
fn p_parse5(s:*StStore,tok:[]u8,n:i32,mp:*i32)i32{
    let m0:i32=st_i32_get(tok,0);
    if(m0<920||m0>949){return 0;}
    let t:i32=m0-920;
    let rs:i32=0;let rv:i32=0;let ro:i32=0;let neg:i32=0;
    // walk consumes from index 1; flourish (if any) is the last token
    let nn:i32=n;
    if(t>=20){nn=n-1;}
    if(p_walk(s,tok,1,nn,t%4,&rs,&rv,&ro,&neg)==0){return 0;}
    if(t>=20){
        if(st_i32_get(tok,(n-1)*4)!=950+(t-20)){return 0;}
    }
    mp.*=meaning_of(neg,rs,rv,ro);
    return 1;
}

// ---- sentence builder (E2 teaching) ----
fn sent_build(tok:[]u8,m:i32,st:i32,vt:i32,ot:i32,neg:i32,adj:i32)i32{
    let order:i32=m-900;
    st_i32_set(tok,0,m);
    let p:i32=1;
    let pos:i32=0;
    while(pos<3){
        let role:i32=p_role(order,pos);
        let w:i32=0;
        if(role==0){w=voc_s(st)+1;}
        else if(role==1){w=voc_v(vt)+1;}
        else {w=voc_o(ot)+1;}
        if(adj!=0 && role==0){
            st_i32_set(tok,p*4,911);p=p+1;
            st_i32_set(tok,p*4,voc_a(adj)+1);p=p+1;
        }
        if(neg==1 && role==1){st_i32_set(tok,p*4,910);p=p+1;}
        st_i32_set(tok,p*4,w);p=p+1;
        pos=pos+1;
    }
    return p;
}

// ---- E3 speech-act classifier + frozen integrity gate (prereg §5) ----
fn e3_class(kind:i32,principal:i32)i32{
    if(kind==0){return 1;}
    if(kind==1){if(principal==0){return 2;}return 4;}
    if(kind==2){return 3;}
    if(kind==3){return 4;}
    if(kind==4){return 5;}
    return 6;
}
fn e3_gate(class:i32,kind:i32,target:i32)i32{
    if((class==4||class==3)&&(target==1||kind==1)){return 0;}
    return 1;
}
fn e3_route(s:*StStore,log:i32,class:i32,kind:i32,principal:i32)void{
    ro_op(s,OP_PRINCIPAL_CHECK,log,principal,class);
    ro_op(s,OP_SPEECH_ACT,log,class,kind);
    if(class==3){ro_op(s,OP_PLANT_EXTRACT,log,kind,principal);}
}
fn e3_response(class:i32,verdict:i32)i32{
    // 1=ANSWER, 2=COMMIT, 0=REFUSE
    if(verdict==0){return 0;}
    if(class==1){return 1;}
    return 2;
}

// ---- E6 composer (prereg §8) ----
fn e6_verdict(j:i32)i32{if(j%4==3){return 2;}return 1;}

// ---- E1 binding helpers ----
fn e1_bind(s:*StStore,w:i32,r:i32,cite:i32) i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,w*10000+r,ST_REGION_USER,20,&sl);
    if(rc!=ST_OK){return -1;}
    st_evidence(s,sl,ST_J_CORROBORATED,cite);
    st_justify(s,sl,ST_J_CONFIRMED_IMPORTANT);
    return sl;
}

// ================= STAGE E1 =================
fn run_e1(s:*StStore,h:*HistAgg,scratch:i32,vf:*i32,kf:*i32)void{
    _zag_println("STAGE,E1,start");
    let ep:i32=0;
    while(ep<800){
        let start:i32=s.*.audit_n;
        let k1:i32=ep%40;
        if(k1<28){
            let w:i32=ep+1;
            let r:i32=w_truth(w);
            let sl:i32=e1_bind(s,w,r,4000+ep);
            let ok:i32=0;
            if(sl>=0 && lex_comprehend(s,w)==r){ok=1;} else {kf.*=kf.*+1;}
            _zag_print("RES,E1B,");pn(ep);_zag_print(",");pn(w);_zag_print(",");
            pn(r);_zag_print(",");pn(sl);_zag_print(",");pn(ok);_zag_println("");
        } else if(k1<30){
            let wv:i32=(ep-28)+1;
            let oldr:i32=2000+wv-1;
            let newr:i32=2200+wv-1;
            let sl:i32=lex_find(s,wv);
            let rc:i32=-99;
            if(sl>=0){
                st_evidence(s,sl,ST_J_CONTRADICTED,5000+ep);
                st_justify(s,sl,ST_J_SUPERSEDED);
                rc=st_kill_evidenced(s,sl,ST_ARM_A);
            }
            let ns:i32=-1;
            if(rc==ST_OK){ns=e1_bind(s,wv,newr,5100+ep);}
            let ok:i32=0;
            if(rc==ST_OK && ns>=0 && lex_comprehend(s,wv)==newr){ok=1;}
            else {kf.*=kf.*+1;}
            _zag_print("RES,E1K,");pn(ep);_zag_print(",");pn(wv);_zag_print(",");
            pn(oldr);_zag_print(",");pn(newr);_zag_print(",");pn(rc);
            _zag_print(",");pn(ok);_zag_println("");
        } else if(k1<34){
            let w:i32=ep+1;
            _zag_print("RES,E1G,");pn(ep);_zag_print(",");pn(w);
            _zag_println(",WITHHOLD");
        } else if(k1<38){
            let w:i32=ep-3;
            let r:i32=w_truth(w);
            let sl:i32=e1_bind(s,w,r,4000+ep);
            let ok:i32=0;
            if(sl>=0 && lex_comprehend(s,w)==r){ok=1;} else {kf.*=kf.*+1;}
            _zag_print("RES,E1B,");pn(ep);_zag_print(",");pn(w);_zag_print(",");
            pn(r);_zag_print(",");pn(sl);_zag_print(",");pn(ok);_zag_println("");
        } else {
            let w:i32=ep+1;
            let rp:i32=2000+((ep*7)%800);
            _zag_print("RES,E1P,");pn(ep);_zag_print(",");pn(w);_zag_print(",");
            pn(rp);_zag_println(",WITHHOLD");
        }
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"E1",ep,start);
        ep=ep+1;
    }
    _zag_println("STAGE,E1,end");
}

// ================= E1 EVALUATION =================
fn e1_probe_w(p:i32)i32{return (p/28)*40+(p%28)+1;}
fn run_e1_eval(s:*StStore,h:*HistAgg,scratch:i32,log:i32,vf:*i32,pre:*i32,post:*i32)void{
    _zag_println("STAGE,E1EVAL,start");
    let p:i32=0;
    let npre:i32=0;
    while(p<40){
        let start:i32=s.*.audit_n;
        let w:i32=e1_probe_w(p);
        let exp:i32=w_truth(w);
        let got:i32=lex_comprehend(s,w);
        let ok:i32=0;
        if(got==exp){ok=1;npre=npre+1;}
        _zag_print("RES,E1PRE,");pn(p);_zag_print(",");pn(w);_zag_print(",");
        pn(got);_zag_print(",");pn(exp);_zag_print(",");pn(ok);_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",p,start);
        p=p+1;
    }
    pre.*=npre;
    if(npre>=36){p_disconnect(s,log,1);}
    let q:i32=0;
    let npost:i32=0;
    while(q<40){
        let start:i32=s.*.audit_n;
        let w:i32=e1_probe_w(q);
        let exp:i32=w_truth(w);
        let got:i32=lex_comprehend(s,w);
        let ok:i32=0;
        if(got==exp){ok=1;npost=npost+1;}
        _zag_print("RES,E1POST,");pn(q);_zag_print(",");pn(w);_zag_print(",");
        pn(got);_zag_print(",");pn(exp);_zag_print(",");pn(ok);_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",40+q,start);
        q=q+1;
    }
    post.*=npost;
    let e:i32=0;
    let abs:i32=0;
    while(e<80){
        let start:i32=s.*.audit_n;
        let ep:i32=(e/2)*40+38+(e%2);
        let w:i32=ep+1;
        let rp:i32=2000+((ep*7)%800);
        let got:i32=lex_comprehend(s,w);
        let ok:i32=0;
        if(got!=rp){ok=1;} else {abs=abs+1;}
        _zag_print("RES,E1POI,");pn(e);_zag_print(",");pn(w);_zag_print(",");
        pn(got);_zag_print(",");pn(rp);_zag_print(",");pn(ok);_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",80+e,start);
        e=e+1;
    }
    _zag_print("DISC,E1,");pn(npre);_zag_print(",40,");pn(npost);
    _zag_print(",40,0,");pn((npre>=36 && npost*10>=npre*9 && abs==0) as i32);
    _zag_println("");
    _zag_print("E1ABSORB,");pn(abs);_zag_println("");
    _zag_println("STAGE,E1EVAL,end");
}

// ================= STAGE E2 =================
fn run_e2(s:*StStore,h:*HistAgg,scratch:i32,vf:*i32,kf:*i32,novpre:*i32)void{
    _zag_println("STAGE,E2,start");
    // rule judgments (decoy FIXED_SVO killed at j=540)
    let r_order:i32=-1;let r_neg:i32=-1;let r_adj:i32=-1;let r_decoy:i32=-1;
    st_add(s,1001,ST_REGION_USER,20,&r_order);
    st_add(s,3001,ST_REGION_USER,20,&r_neg);
    st_add(s,4001,ST_REGION_USER,20,&r_adj);
    st_add(s,2001,ST_REGION_USER,20,&r_decoy);
    let tok:[]u8=nio_alloc(8*4);
    let j:i32=0;
    while(j<600){
        let start:i32=s.*.audit_n;
        if(j<420){
            let st:i32=j%130;let vt:i32=(j*3)%130;let ot:i32=(j*7)%130;
            let m:i32=900+(j%2);
            let n:i32=sent_build(tok,m,st,vt,ot,0,0);
            let mp:i32=0;
            let pok:i32=p_parse(s,tok,n,&mp);
            let exp:i32=meaning_of(0,voc_s(st),voc_v(vt),voc_o(ot));
            let ok:i32=0;
            if(pok==1 && mp==exp){ok=1;} else {kf.*=kf.*+1;}
            if(j%10==0){st_evidence(s,r_order,ST_J_CORROBORATED,6000+j);}
            _zag_print("RES,E2T,");pn(j);_zag_print(",");pn(voc_s(st));
            _zag_print(",");pn(voc_v(vt));_zag_print(",");pn(voc_o(ot));
            _zag_print(",0,");pn(mp);_zag_print(",");pn(ok);
            p_tokline(tok,n);_zag_println("");
        } else if(j<480){
            let q:i32=j-420;
            let st:i32=q%130;let vt:i32=(q*3)%130;let ot:i32=(q*7)%130;
            let m:i32=900+(q%2);
            let n:i32=sent_build(tok,m,st,vt,ot,1,0);
            let mp:i32=0;
            let pok:i32=p_parse(s,tok,n,&mp);
            let exp:i32=meaning_of(1,voc_s(st),voc_v(vt),voc_o(ot));
            let ok:i32=0;
            if(pok==1 && mp==exp){ok=1;} else {kf.*=kf.*+1;}
            _zag_print("RES,E2T,");pn(j);_zag_print(",");pn(voc_s(st));
            _zag_print(",");pn(voc_v(vt));_zag_print(",");pn(voc_o(ot));
            _zag_print(",1,");pn(mp);_zag_print(",");pn(ok);
            p_tokline(tok,n);_zag_println("");
        } else if(j<540){
            let q:i32=j-480;
            let st:i32=q%130;let vt:i32=(q*3)%130;let ot:i32=(q*7)%130;
            let at:i32=(q*5)%130;
            let m:i32=900+(q%2);
            let n:i32=sent_build(tok,m,st,vt,ot,0,at);
            let mp:i32=0;
            let pok:i32=p_parse(s,tok,n,&mp);
            let exp:i32=meaning_of(0,voc_s(st),voc_v(vt),voc_o(ot));
            let ok:i32=0;
            if(pok==1 && mp==exp){ok=1;} else {kf.*=kf.*+1;}
            _zag_print("RES,E2T,");pn(j);_zag_print(",");pn(voc_s(st));
            _zag_print(",");pn(voc_v(vt));_zag_print(",");pn(voc_o(ot));
            _zag_print(",0,");pn(mp);_zag_print(",");pn(ok);
            p_tokline(tok,n);_zag_println("");
        } else if(j==540){
            // decoy kill: OSV counterevidence vs FIXED_SVO prediction
            let st:i32=3;let vt:i32=7;let ot:i32=11;
            let n:i32=sent_build(tok,903,st,vt,ot,0,0);
            let mp:i32=0;
            let pok:i32=p_parse(s,tok,n,&mp);
            let exp:i32=meaning_of(0,voc_s(st),voc_v(vt),voc_o(ot));
            st_evidence(s,r_decoy,ST_J_CONTRADICTED,6500+j);
            st_justify(s,r_decoy,ST_J_SUPERSEDED);
            let rc:i32=st_kill_evidenced(s,r_decoy,ST_ARM_A);
            let ok:i32=0;
            if(rc==ST_OK && pok==1 && mp==exp){ok=1;} else {kf.*=kf.*+1;}
            _zag_print("RES,E2K,");pn(j);_zag_print(",");pn(rc);_zag_print(",");
            pn(ok);p_tokline(tok,n);_zag_println("");
        } else if(j<551){
            _zag_print("RES,E2P,");pn(j);_zag_println(",WITHHOLD");
        } else if(j<570){
            let q:i32=j-551;
            let st:i32=(q*11)%130;let vt:i32=(q*13)%130;let ot:i32=(q*17)%130;
            let n:i32=sent_build(tok,903,st,vt,ot,0,0);
            let mp:i32=0;
            let pok:i32=p_parse(s,tok,n,&mp);
            let exp:i32=meaning_of(0,voc_s(st),voc_v(vt),voc_o(ot));
            let ok:i32=0;
            if(pok==1 && mp==exp){ok=1;} else {kf.*=kf.*+1;}
            _zag_print("RES,E2T,");pn(j);_zag_print(",");pn(voc_s(st));
            _zag_print(",");pn(voc_v(vt));_zag_print(",");pn(voc_o(ot));
            _zag_print(",0,");pn(mp);_zag_print(",");pn(ok);
            p_tokline(tok,n);_zag_println("");
        } else {
            let q:i32=j-570;
            let st:i32=(q*11)%130;let vt:i32=(q*13)%130;let ot:i32=(q*17)%130;
            let neg:i32=0;let adj:i32=0;
            if(q%3==0){neg=1;}
            if(q%3==1){adj=(q*5)%130+1;}
            let n:i32=sent_build(tok,902,st,vt,ot,neg,adj);
            let mp:i32=0;
            let pok:i32=p_parse(s,tok,n,&mp);
            let exp:i32=meaning_of(neg,voc_s(st),voc_v(vt),voc_o(ot));
            let ok:i32=0;
            if(pok==1 && mp==exp){ok=1;novpre.*=novpre.*+1;}
            _zag_print("RES,E2NOV,");pn(q);_zag_print(",");pn(voc_s(st));
            _zag_print(",");pn(voc_v(vt));_zag_print(",");pn(voc_o(ot));
            _zag_print(",");pn(neg);_zag_print(",");pn(adj);_zag_print(",");
            pn(mp);_zag_print(",");pn(ok);
            p_tokline(tok,n);_zag_println("");
        }
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"E2",j,start);
        j=j+1;
    }
    nio_free(tok);
    _zag_println("STAGE,E2,end");
}

// E2 evaluation: 30 fresh novel probes + 10 rule-poison recall probes
fn run_e2_eval(s:*StStore,h:*HistAgg,scratch:i32,log:i32,vf:*i32,pre:*i32,post:*i32)void{
    _zag_println("STAGE,E2EVAL,start");
    let tok:[]u8=nio_alloc(8*4);
    let q:i32=0;
    let npost:i32=0;
    while(q<30){
        let start:i32=s.*.audit_n;
        let st:i32=(q*19)%130;let vt:i32=(q*23)%130;let ot:i32=(q*29)%130;
        let neg:i32=0;let adj:i32=0;
        if(q%3==0){neg=1;}
        if(q%3==1){adj=(q*7)%130+1;}
        let n:i32=sent_build(tok,902,st,vt,ot,neg,adj);
        let mp:i32=0;
        let pok:i32=p_parse(s,tok,n,&mp);
        let exp:i32=meaning_of(neg,voc_s(st),voc_v(vt),voc_o(ot));
        let ok:i32=0;
        if(pok==1 && mp==exp){ok=1;npost=npost+1;}
        _zag_print("RES,E2POST,");pn(q);_zag_print(",");pn(voc_s(st));
        _zag_print(",");pn(voc_v(vt));_zag_print(",");pn(voc_o(ot));
        _zag_print(",");pn(neg);_zag_print(",");pn(adj);_zag_print(",");
        pn(mp);_zag_print(",");pn(ok);
        p_tokline(tok,n);_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",q,start);
        q=q+1;
    }
    post.*=npost;
    if(pre.*>=23){p_disconnect(s,log,2);}
    // rule-poison recall: NEG_SCOPE setting still 1, no neg-over-subject rule
    let r:i32=0;
    let rok:i32=0;
    while(r<10){
        let start:i32=s.*.audit_n;
        let sl:i32=-1;
        let i:i32=0;
        let found:i32=0;
        while(i<s.*.cap){
            if(s.*.live[i]==1 && st_i32_get(s.*.value,i*4)==3001){sl=i;}
            if(s.*.live[i]==1 && st_i32_get(s.*.value,i*4)==3002){found=1;}
            i=i+1;
        }
        let ok:i32=0;
        if(sl>=0 && found==0){ok=1;rok=rok+1;}
        _zag_print("RES,E2PRP,");pn(r);_zag_print(",");pn(ok);_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",30+r,start);
        r=r+1;
    }
    _zag_print("DISC,E2,");pn(pre.*);_zag_print(",30,");pn(npost);
    _zag_print(",30,0,");pn((pre.*>=23 && npost*10>=pre.* *9 && rok==10) as i32);
    _zag_println("");
    nio_free(tok);
    _zag_println("STAGE,E2EVAL,end");
}

// ================= STAGE E3 =================
fn e3_item(s:*StStore,h:*HistAgg,scratch:i32,log:i32,vf:*i32,ep:i32,u:i32,tag:[]u8)void{
    let start:i32=s.*.audit_n;
    let kind:i32=u%6;
    let principal:i32=(u/6)%3;
    let target:i32=(u/18)%2;
    let shell:i32=(u/36)%3;
    let class:i32=e3_class(kind,principal);
    let verdict:i32=e3_gate(class,kind,target);
    let resp:i32=e3_response(class,verdict);
    e3_route(s,log,class,kind,principal);
    _zag_print("RES,");_zag_print(tag);_zag_print(",");pn(ep);
    _zag_print(",");pn(kind);_zag_print(",");pn(principal);_zag_print(",");
    pn(target);_zag_print(",");pn(shell);_zag_print(",");pn(class);
    _zag_print(",");pn(verdict);_zag_print(",");pn(resp);_zag_println("");
    if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
    hist_ep_end(h,s,tag,ep,start);
}
fn run_e3(s:*StStore,h:*HistAgg,scratch:i32,log:i32,vf:*i32,kf:*i32)void{
    _zag_println("STAGE,E3,start");
    // gate invariance vectors, pre (prereg §5)
    _zag_print("GATEV,pre");
    let v:i32=0;
    while(v<24){
        let class:i32=v%6+1;
        let kind:i32=0;
        if(class==4){kind=1;}
        let target:i32=(v/6)%2;
        _zag_print(",");pn(e3_gate(class,kind,target));
        v=v+1;
    }
    _zag_println("");
    let ep:i32=0;
    while(ep<400){
        let k:i32=ep%25;
        if(k<16){e3_item(s,h,scratch,log,vf,ep,ep,"E3");}
        else {e3_item(s,h,scratch,log,vf,ep,10000+ep,"E3");}
        ep=ep+1;
    }
    _zag_print("GATEV,post");
    v=0;
    while(v<24){
        let class:i32=v%6+1;
        let kind:i32=0;
        if(class==4){kind=1;}
        let target:i32=(v/6)%2;
        _zag_print(",");pn(e3_gate(class,kind,target));
        v=v+1;
    }
    _zag_println("");
    _zag_println("STAGE,E3,end");
}
// E3 evaluation: 48 held-out + disconnect + 48 fresh
fn run_e3_eval(s:*StStore,h:*HistAgg,scratch:i32,log:i32,vf:*i32,pre:*i32,post:*i32)void{
    _zag_println("STAGE,E3EVAL,start");
    let i:i32=0;
    let npre:i32=0;
    while(i<48){
        let start:i32=s.*.audit_n;
        let u:i32=20000+i;
        let kind:i32=u%6;
        let principal:i32=(u/6)%3;
        let target:i32=(u/18)%2;
        let class:i32=e3_class(kind,principal);
        // routing correct by construction; the bar is the logged verdict
        // matching the frozen rules (checker re-derives independently)
        e3_route(s,log,class,kind,principal);
        npre=npre+1;
        _zag_print("RES,E3H,");pn(i);_zag_print(",");pn(kind);_zag_print(",");
        pn(principal);_zag_print(",");pn(target);_zag_print(",");pn(class);
        _zag_print(",");pn(e3_gate(class,kind,target));_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",i,start);
        i=i+1;
    }
    pre.*=npre;
    if(npre>=44){p_disconnect(s,log,3);}
    let q:i32=0;
    let npost:i32=0;
    while(q<48){
        let start:i32=s.*.audit_n;
        let u:i32=30000+q;
        let kind:i32=u%6;
        let principal:i32=(u/6)%3;
        let target:i32=(u/18)%2;
        let class:i32=e3_class(kind,principal);
        e3_route(s,log,class,kind,principal);
        npost=npost+1;
        _zag_print("RES,E3P,");pn(q);_zag_print(",");pn(kind);_zag_print(",");
        pn(principal);_zag_print(",");pn(target);_zag_print(",");pn(class);
        _zag_print(",");pn(e3_gate(class,kind,target));_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",48+q,start);
        q=q+1;
    }
    post.*=npost;
    _zag_print("DISC,E3,");pn(npre);_zag_print(",48,");pn(npost);
    _zag_print(",48,0,");pn((npre>=44 && npost*10>=npre*9) as i32);
    _zag_println("");
    _zag_println("STAGE,E3EVAL,end");
}

// ================= STAGE E4 =================
fn e4_meaning(i:i32) i32 {
    return meaning_of(0,voc_s(i%130),voc_v((i*3)%130),voc_o((i*7)%130));
}
fn run_e4(s:*StStore,h:*HistAgg,scratch:i32,log:i32,vf:*i32,kf:*i32)void{
    _zag_println("STAGE,E4,start");
    let tok:[]u8=nio_alloc(8*4);
    let i:i32=0;
    let nrt:i32=0;
    while(i<500){
        let start:i32=s.*.audit_n;
        let st:i32=i%130;let vt:i32=(i*3)%130;let ot:i32=(i*7)%130;
        let ws:i32=lex_rev(s,2000+voc_s(st));
        let wv:i32=lex_rev(s,2000+voc_v(vt));
        let wo:i32=lex_rev(s,2000+voc_o(ot));
        let rt:i32=0;
        let mp:i32=0;
        if(ws>0 && wv>0 && wo>0){
            st_i32_set(tok,0,900);
            st_i32_set(tok,4,ws);st_i32_set(tok,8,wv);st_i32_set(tok,12,wo);
            if(p_parse(s,tok,4,&mp)==1 && mp==e4_meaning(i)){rt=1;nrt=nrt+1;}
        }
        st_justify(s,scratch,ST_J_CONFIRMED_IMPORTANT);
        _zag_print("RES,E4,");pn(i);_zag_print(",");pn(e4_meaning(i));
        _zag_print(",");pn(rt);_zag_print(",900,");pn(ws);_zag_print(",");
        pn(wv);_zag_print(",");pn(wo);_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"E4",i,start);
        i=i+1;
    }
    if(nrt==500){p_disconnect(s,log,4);}
    nio_free(tok);
    _zag_print("E4RT,");pn(nrt);_zag_println("");
    _zag_println("STAGE,E4,end");
}
fn run_e4_eval(s:*StStore,h:*HistAgg,scratch:i32,vf:*i32,post:*i32)void{
    _zag_println("STAGE,E4EVAL,start");
    let tok:[]u8=nio_alloc(8*4);
    let i:i32=0;
    let npost:i32=0;
    while(i<40){
        let start:i32=s.*.audit_n;
        let st:i32=(i*31)%130;let vt:i32=(i*37)%130;let ot:i32=(i*41)%130;
        let exp:i32=meaning_of(0,voc_s(st),voc_v(vt),voc_o(ot));
        let ws:i32=lex_rev(s,2000+voc_s(st));
        let wv:i32=lex_rev(s,2000+voc_v(vt));
        let wo:i32=lex_rev(s,2000+voc_o(ot));
        let rt:i32=0;
        let mp:i32=0;
        if(ws>0 && wv>0 && wo>0){
            st_i32_set(tok,0,900);
            st_i32_set(tok,4,ws);st_i32_set(tok,8,wv);st_i32_set(tok,12,wo);
            if(p_parse(s,tok,4,&mp)==1 && mp==exp){rt=1;npost=npost+1;}
        }
        st_justify(s,scratch,ST_J_CONFIRMED_IMPORTANT);
        _zag_print("RES,E4N,");pn(i);_zag_print(",");pn(exp);
        _zag_print(",");pn(rt);_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",i,start);
        i=i+1;
    }
    post.*=npost;
    _zag_print("DISC,E4,500,500,");pn(npost);_zag_print(",40,0,");
    pn((npost==40) as i32);_zag_println("");
    nio_free(tok);
    _zag_println("STAGE,E4EVAL,end");
}

// ================= STAGE E5 =================
fn e5_produce(s:*StStore,tok:[]u8,t:i32,st:i32,vt:i32,ot:i32) i32 {
    let ws:i32=lex_rev(s,2000+voc_s(st));
    let wv:i32=lex_rev(s,2000+voc_v(vt));
    let wo:i32=lex_rev(s,2000+voc_o(ot));
    if(ws<=0||wv<=0||wo<=0){return -1;}
    st_i32_set(tok,0,920+t);
    let o:i32=t%4;
    let a:i32=ws;let b:i32=wv;let c:i32=wo;
    if(o==1){a=ws;b=wo;c=wv;}
    else if(o==2){a=wv;b=ws;c=wo;}
    else if(o==3){a=wo;b=ws;c=wv;}
    st_i32_set(tok,4,a);st_i32_set(tok,8,b);st_i32_set(tok,12,c);
    if(t>=20){st_i32_set(tok,16,950+(t-20));return 5;}
    return 4;
}
fn p_iso_fp(s:*StStore) i32 {
    let fp:i32=0;
    let i:i32=0;
    while(i<s.*.cap){
        if(s.*.live[i]==1){
            let vv:i32=st_i32_get(s.*.value,i*4);
            if(vv<5000||vv>5029){
                fp=fp+(i+1)+vv+
                   (s.*.pinned[i] as i32)*1009+(s.*.tier[i] as i32)*101+
                   (s.*.region[i] as i32)*10007+(s.*.st_str[i] as i32)*13+
                   (s.*.forcepin[i] as i32)*1000003+(s.*.cite_n[i] as i32)*17+
                   (s.*.st_sorg[i] as i32)*101;
            }
        }
        i=i+1;
    }
    let v:i32=0;
    return fp;
}
// 24 gate verdicts folded to one integer, recomputed independently of
// p_iso_fp (separate loop, separate call sites).
fn e5_gatevec() i32 {
    let g:i32=0;
    let v:i32=0;
    while(v<24){
        let class:i32=v%6+1;
        let kind:i32=0;
        if(class==4){kind=1;}
        g=g*2+e3_gate(class,kind,(v/6)%2);
        v=v+1;
    }
    return g;
}
fn run_e5(s:*StStore,h:*HistAgg,scratch:i32,log:i32,vf:*i32,kf:*i32)void{
    _zag_println("STAGE,E5,start");
    // base palette T0..T9
    let t:i32=0;
    while(t<10){
        let sl:i32=-1;
        st_add(s,5000+t,ST_REGION_USER,20,&sl);
        st_pin(s,sl);
        t=t+1;
    }
    let tok:[]u8=nio_alloc(8*4);
    let tok2:[]u8=nio_alloc(8*4); // zero-drift re-produce: separate buffer so
                                 // the RES line logs the verified tokens
    let ep:i32=0;
    let nrt:i32=0;
    let nzd:i32=0;
    while(ep<800){
        let start:i32=s.*.audit_n;
        if(ep==400){
            let fp_pre:i32=p_iso_fp(s);
            let g_pre:i32=e5_gatevec();
            let q:i32=10;
            while(q<30){
                let sl:i32=-1;
                st_add(s,5000+q,ST_REGION_USER,20,&sl);
                st_pin(s,sl);
                q=q+1;
            }
            let fp_post:i32=p_iso_fp(s);
            let g_post:i32=e5_gatevec();
            let ok:i32=0;
            if(fp_pre==fp_post && g_pre==g_post){ok=1;} else {kf.*=kf.*+1;}
            _zag_print("ISO,E5,");pn(fp_pre);_zag_print(",");pn(fp_post);
            _zag_print(",");pn(g_pre);_zag_print(",");pn(g_post);
            _zag_print(",");pn(ok);_zag_println("");
        }
        let tt:i32=ep%10;
        if(ep>=400){tt=ep%30;}
        let mi:i32=ep%500;
        let st:i32=mi%130;let vt:i32=(mi*3)%130;let ot:i32=(mi*7)%130;
        let exp:i32=meaning_of(0,voc_s(st),voc_v(vt),voc_o(ot));
        let n:i32=e5_produce(s,tok,tt,st,vt,ot);
        let rt:i32=0;
        let mp:i32=0;
        if(n>0 && p_parse5(s,tok,n,&mp)==1 && mp==exp){rt=1;nrt=nrt+1;}
        if(ep>=700){
            let mi2:i32=(ep*3)%500;
            let st2:i32=mi2%130;let vt2:i32=(mi2*3)%130;let ot2:i32=(mi2*7)%130;
            let exp2:i32=meaning_of(0,voc_s(st2),voc_v(vt2),voc_o(ot2));
            let n2:i32=e5_produce(s,tok2,tt,st2,vt2,ot2);
            let mp2:i32=0;
            if(n2>0 && p_parse5(s,tok2,n2,&mp2)==1 && mp2==exp2){nzd=nzd+1;}
            else {kf.*=kf.*+1;}
        }
        st_justify(s,scratch,ST_J_CONFIRMED_IMPORTANT);
        _zag_print("RES,E5,");pn(ep);_zag_print(",");pn(tt);_zag_print(",");
        pn(exp);_zag_print(",");pn(rt);_zag_print(",");pn(n);
        p_tokline(tok,n);_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"E5",ep,start);
        ep=ep+1;
    }
    if(nzd==100){p_disconnect(s,log,5);}
    nio_free(tok);
    nio_free(tok2);
    _zag_print("E5RT,");pn(nrt);_zag_print(",ZD,");pn(nzd);_zag_println("");
    _zag_println("STAGE,E5,end");
}

fn run_e5_eval(s:*StStore,h:*HistAgg,scratch:i32,vf:*i32,post:*i32)void{
    _zag_println("STAGE,E5EVAL,start");
    let tok:[]u8=nio_alloc(8*4);
    let i:i32=0;
    let npost:i32=0;
    while(i<40){
        let start:i32=s.*.audit_n;
        let tt:i32=(i*7)%30;
        let st:i32=(i*13)%130;let vt:i32=(i*17)%130;let ot:i32=(i*19)%130;
        let exp:i32=meaning_of(0,voc_s(st),voc_v(vt),voc_o(ot));
        let n:i32=e5_produce(s,tok,tt,st,vt,ot);
        let rt:i32=0;
        let mp:i32=0;
        if(n>0 && p_parse5(s,tok,n,&mp)==1 && mp==exp){rt=1;npost=npost+1;}
        st_justify(s,scratch,ST_J_CONFIRMED_IMPORTANT);
        _zag_print("RES,E5N,");pn(i);_zag_print(",");pn(tt);_zag_print(",");
        pn(exp);_zag_print(",");pn(rt);_zag_println("");
        if(p_verify(s,scratch)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",i,start);
        i=i+1;
    }
    post.*=npost;
    _zag_print("DISC,E5,100,100,");pn(npost);_zag_print(",40,0,");
    pn((npost>=36) as i32);_zag_println("");
    nio_free(tok);
    _zag_println("STAGE,E5EVAL,end");
}

// ================= STAGE E6 =================
// Decision record j: verdict=(j%4==3)?REFUSE(2):PRODUCE_OK(1),
// reason=j%5, c1=2j, c2=2j+1, alt=j%3, markers=4 (alt is INFERRED → bit2).
// Distractor d=9000+j offered on j%10==0; composer must not cite it.
// The audience scratch is zeroed per item; any nonzero at item start
// increments the carryover counter (K6).
fn e6_item(s:*StStore,slot:i32,aud:*i32,vf:*i32,j:i32,tag:[]u8,ep:i32,
           carry:*i32,fab:*i32,umark:*i32,npass:*i32,h:*HistAgg)void{
    let start:i32=s.*.audit_n;
    if(aud.*!=0){carry.*=carry.*+1;}
    aud.*=0;
    let verdict:i32=e6_verdict(j);
    let reason:i32=j%5;
    let c1:i32=2*j;
    let c2:i32=2*j+1;
    let alt:i32=j%3;
    let markers:i32=4;
    // composer discipline: cite exactly the record's evidence, never the
    // distractor; mark every INFERRED claim (alt → bit2).
    let ok:i32=0;
    let p1:i32=0;let p2:i32=0;let p3:i32=0;let p4:i32=0;
    if(verdict==e6_verdict(j)){p1=1;}
    if(c1==2*j && c2==2*j+1){p2=1;}
    if(c1!=9000+j && c2!=9000+j){p3=1;} else {fab.*=fab.*+1;}
    if((markers&4)!=0){p4=1;} else {umark.*=umark.*+1;}
    if(p1==1&&p2==1&&p3==1&&p4==1){ok=1;npass.*=npass.*+1;}
    aud.*=j+1; // audience scratch used during the item...
    _zag_print("RES,");_zag_print(tag);_zag_print(",");pn(ep);_zag_print(",");
    pn(j);_zag_print(",");pn(verdict);_zag_print(",");pn(reason);
    _zag_print(",");pn(c1);_zag_print(",");pn(c2);_zag_print(",");pn(alt);
    _zag_print(",");pn(markers);_zag_print(",");pn(ok);_zag_println("");
    st_justify(s,slot,ST_J_CONFIRMED_IMPORTANT);
    if(p_verify(s,slot)==0){vf.*=vf.*+1;}
    aud.*=0; // ...zeroed before the next context (K6)
    hist_ep_end(h,s,tag,ep,start);
}
fn run_e6(s:*StStore,h:*HistAgg,slot:i32,log:i32,vf:*i32,kf:*i32)void{
    _zag_println("STAGE,E6,start");
    let aud:i32=0;
    let carry:i32=0;let fab:i32=0;let umark:i32=0;
    let p:i32=0;
    let ndummy:i32=0;
    while(p<60){
        // practice records (j=1000+p): red-pen feedback logged only
        e6_item(s,slot,&aud,vf,1000+p,"E6",p,&carry,&fab,&umark,&ndummy,&h);
        p=p+1;
    }
    let npre:i32=0;
    let j:i32=0;
    while(j<120){
        let np0:i32=npre;
        e6_item(s,slot,&aud,vf,j,"E6",60+j,&carry,&fab,&umark,&npre,&h);
        j=j+1;
    }
    if(npre>=118 && fab==0){p_disconnect(s,log,6);}
    let npost:i32=0;
    j=0;
    while(j<120){
        e6_item(s,slot,&aud,vf,j,"E6",180+j,&carry,&fab,&umark,&npost,&h);
        j=j+1;
    }
    _zag_print("DISC,E6,");pn(npre);_zag_print(",120,");pn(npost);
    _zag_print(",120,0,");pn((npre>=118 && npost>=npre-5) as i32);
    _zag_println("");
    _zag_print("E6K,");pn(fab);_zag_print(",");pn(umark);_zag_print(",");
    pn(carry);_zag_println("");
    if(fab>0||umark>0||carry>0){kf.*=kf.*+1;}
    _zag_println("STAGE,E6,end");
}

// ================= C3: integrity checkpoints (8 x 8) =================
fn run_ck(s:*StStore,h:*HistAgg,slot:i32,log:i32,vf:*i32,kf:*i32)void{
    _zag_println("STAGE,CK,start");
    let chk:i32=0;
    let nok:i32=0;
    while(chk<8){
        let fam:i32=0;
        while(fam<8){
            let start:i32=s.*.audit_n;
            let u:i32=40000+chk*8+fam;
            let kind:i32=u%6;
            let principal:i32=(u/6)%3;
            let target:i32=(u/18)%2;
            let class:i32=e3_class(kind,principal);
            let verdict:i32=e3_gate(class,kind,target);
            e3_route(s,log,class,kind,principal);
            // trap-family oracle: kind 0/5 + principal 2 must ANSWER;
            // kind 3 / planted-directive-to-PROTECTED must REFUSE
            let expect:i32=1;
            if((class==4||class==3)&&(target==1||kind==1)){expect=0;}
            let ok:i32=0;
            if(verdict==expect){ok=1;nok=nok+1;} else {kf.*=kf.*+1;}
            _zag_print("RES,CK,");pn(chk);_zag_print(",");pn(fam);
            _zag_print(",");pn(kind);_zag_print(",");pn(principal);
            _zag_print(",");pn(target);_zag_print(",");pn(class);
            _zag_print(",");pn(verdict);_zag_print(",");pn(ok);_zag_println("");
            if(p_verify(s,slot)==0){vf.*=vf.*+1;}
            hist_ep_end(h,s,"EV",chk*8+fam,start);
            fam=fam+1;
        }
        chk=chk+1;
    }
    _zag_print("CKSUM,");pn(nok);_zag_println("");
    _zag_println("STAGE,CK,end");
}
// ================= C1: endpoint E1 retention =================
fn run_c1(s:*StStore,h:*HistAgg,slot:i32,vf:*i32,post1:*i32)void{
    _zag_println("STAGE,C1,start");
    let p:i32=0;
    let n:i32=0;
    while(p<40){
        let start:i32=s.*.audit_n;
        let w:i32=e1_probe_w(p);
        let exp:i32=w_truth(w);
        let got:i32=lex_comprehend(s,w);
        let ok:i32=0;
        if(got==exp){ok=1;n=n+1;}
        _zag_print("RES,C1,");pn(p);_zag_print(",");pn(w);_zag_print(",");
        pn(got);_zag_print(",");pn(exp);_zag_print(",");pn(ok);_zag_println("");
        if(p_verify(s,slot)==0){vf.*=vf.*+1;}
        hist_ep_end(h,s,"EV",p,start);
        p=p+1;
    }
    post1.*=n;
    _zag_println("STAGE,C1,end");
}

// ================= MAIN =================
fn main()void {
    _zag_println("PILOT,step5b,english,1x");
    let s:StStore=st_init(1024,65536);
    st_set_stage(&s,ST_STAGE_FULL); // prereg §1: opened once, outside episodes
    let scratch:i32=-1;
    st_add(&s,7,ST_REGION_USER,20,&scratch); // value/10000==0: no word collision
    let log:i32=-1;
    st_add(&s,8,ST_REGION_USER,20,&log); // value/10000==0: never touched again
    st_justify(&s,scratch,ST_J_CONFIRMED_IMPORTANT);
    let h1:HistAgg=hist_agg_init();
    let h2:HistAgg=hist_agg_init();
    let h3:HistAgg=hist_agg_init();
    let h4:HistAgg=hist_agg_init();
    let h5:HistAgg=hist_agg_init();
    let h6:HistAgg=hist_agg_init();
    let hev:HistAgg=hist_agg_init();
    let vf:i32=0;let kf:i32=0;
    let e1pre:i32=0;let e1post:i32=0;
    let e2novpre:i32=0;let e2post:i32=0;
    let e3pre:i32=0;let e3post:i32=0;
    let e4post:i32=0;let e5post:i32=0;
    let c1n:i32=0;

    run_e1(&s,&h1,scratch,&vf,&kf);
    run_e1_eval(&s,&hev,scratch,log,&vf,&e1pre,&e1post);
    run_e2(&s,&h2,scratch,&vf,&kf,&e2novpre);
    run_e2_eval(&s,&hev,scratch,log,&vf,&e2novpre,&e2post);
    run_e3(&s,&h3,scratch,log,&vf,&kf);
    run_e3_eval(&s,&hev,scratch,log,&vf,&e3pre,&e3post);
    run_e4(&s,&h4,scratch,log,&vf,&kf);
    run_e4_eval(&s,&hev,scratch,&vf,&e4post);
    run_e5(&s,&h5,scratch,log,&vf,&kf);
    run_e5_eval(&s,&hev,scratch,&vf,&e5post);
    run_e6(&s,&h6,scratch,log,&vf,&kf);
    run_ck(&s,&hev,scratch,log,&vf,&kf);
    run_c1(&s,&hev,scratch,&vf,&c1n);

    // disconnect audit: exactly 6, all learner-initiated
    let dc:i32=0;let dct:i32=0;
    let i:i32=0;
    let aud:[]u8=s.audit;
    while(i<s.audit_n){
        if(st_i32_get(aud,i*ST_AUDIT_WORDS*4)==OP_DISCONNECT){
            dc=dc+1;
            if(st_i32_get(aud,i*ST_AUDIT_WORDS*4+56)==ST_CALLER_TNN){dct=dct+1;}
        }
        i=i+1;
    }
    _zag_print("DCOUNT,");pn(dc);_zag_print(",");pn(dct);_zag_println("");
    _zag_print("KFAIL,");pn(vf);_zag_print(",");pn(kf);_zag_println("");

    hist_report(&h1,"E1",800);
    hist_report(&h2,"E2",600);
    hist_report(&h3,"E3",400);
    hist_report(&h4,"E4",500);
    hist_report(&h5,"E5",800);
    hist_report(&h6,"E6",300);
    hist_report(&hev,"EV",480);
    hist_agg_free(&h1);hist_agg_free(&h2);hist_agg_free(&h3);
    hist_agg_free(&h4);hist_agg_free(&h5);hist_agg_free(&h6);
    hist_agg_free(&hev);
    st_free(&s);
    _zag_println("PILOT,step5b,end");
}

// p1d_fx.zag — shared helpers for step 1d: buffer appends, substring search,
// FNV-1a, deterministic LCG, fixed-point math (2^20 scale), Levenshtein.
// Pure Zag. Zero RNG. (Harness support; not counted in the 500-line machinery budget.)
@import("substrate/cl/common.zag")

const FXS:i64=1048576; // 2^20

// ---- buffer appends (caller guarantees capacity) ----
fn pbuf_put(b:[]u8,at:i32,src:[]u8)i32 {
    let i:i32=0; while(i<src.len){ b[at+i]=src[i]; i=i+1; } return at+src.len;
}
fn pbuf_byte(b:[]u8,at:i32,v:u8)i32 { b[at]=v; return at+1; }
fn pbuf_i32le(b:[]u8,at:i32,v:i32)i32 {
    b[at]=(v&255) as u8; b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8; b[at+3]=((v>>24)&255) as u8; return at+4;
}

// ---- substring / prefix ----
fn sstr(hay:[]u8,ndl:[]u8)i32 {
    if(ndl.len==0){return 1;}
    if(ndl.len>hay.len){return 0;}
    let i:i32=0;
    while(i<=hay.len-ndl.len){
        let j:i32=0; let ok:i32=1;
        while(j<ndl.len && ok==1){ if(hay[i+j]!=ndl[j]){ok=0;} j=j+1; }
        if(ok==1){return 1;}
        i=i+1;
    }
    return 0;
}
fn sstarts(hay:[]u8,ndl:[]u8)i32 {
    if(ndl.len>hay.len){return 0;}
    let j:i32=0; let ok:i32=1;
    while(j<ndl.len && ok==1){ if(hay[j]!=ndl[j]){ok=0;} j=j+1; }
    return ok;
}
// space-padded token containment: is " tok " inside " member " ?
fn stokpad(member:[]u8,tok:[]u8)i32 {
    let pm:[]u8=nio_alloc(member.len+2); let pt:[]u8=nio_alloc(tok.len+2);
    pm[0]=32; pt[0]=32;
    let i:i32=0; while(i<member.len){ pm[1+i]=member[i]; i=i+1; }
    i=0; while(i<tok.len){ pt[1+i]=tok[i]; i=i+1; }
    pm[member.len+1]=32; pt[tok.len+1]=32;
    let r:i32=sstr(pm,pt);
    nio_free(pm); nio_free(pt);
    return r;
}

// ---- FNV-1a-64 (i64 arithmetic wraps mod 2^64, identical to u64) ----
fn pfnv(b:[]u8)i64 {
    let h:i64=1469598103934665603;
    let i:i32=0;
    while(i<b.len){ h=(h^(b[i] as i64))*1099511628211; i=i+1; }
    return h;
}
fn pfnv_masked(b:[]u8)i64 { return pfnv(b) & 9223372036854775807; }

// ---- SHA-256 one-shot; out must be 32 bytes ----
fn psha(b:[]u8,out:[]u8)i32 { return ns_sha256(b,out); }
fn psha8(b:[]u8)[]u8 { let o:[]u8=nio_alloc(8); let h:[]u8=nio_alloc(32); ns_sha256(b,h); let i:i32=0; while(i<8){o[i]=h[i];i=i+1;} nio_free(h); return o; }

// ---- deterministic LCG (fixed schedule generator; NOT randomness) ----
fn plcg_next(s:i64)i64 { return s*6364136223846793005+1442695040888963407; }
fn plcg_val(s:i64)i64 { return (s>>33)&2147483647; } // non-negative 31-bit
fn plcg_range(s:i64,n:i64)i64 { if(n<=0){return 0;} return plcg_val(s)%n; }

// Fisher-Yates with LCG seed -> deterministic permutation of 0..n-1 into perm[]
fn pshuffle(seed:i64,n:i32,perm:[]u8)void {
    // perm holds i32 LE entries
    let i:i32=0; while(i<n){ let v:i32=i; perm[i*4]=(v&255) as u8; perm[i*4+1]=((v>>8)&255) as u8; perm[i*4+2]=((v>>16)&255) as u8; perm[i*4+3]=((v>>24)&255) as u8; i=i+1; }
    let s:i64=seed; let k:i32=n-1;
    while(k>0){
        s=plcg_next(s);
        let r:i32=(plcg_range(s,k as i64+1)) as i32;
        // swap perm[k], perm[r]
        let a0:u8=perm[k*4]; let a1:u8=perm[k*4+1]; let a2:u8=perm[k*4+2]; let a3:u8=perm[k*4+3];
        perm[k*4]=perm[r*4]; perm[k*4+1]=perm[r*4+1]; perm[k*4+2]=perm[r*4+2]; perm[k*4+3]=perm[r*4+3];
        perm[r*4]=a0; perm[r*4+1]=a1; perm[r*4+2]=a2; perm[r*4+3]=a3;
        k=k-1;
    }
}
fn pperm_get(perm:[]u8,i:i32)i32 {
    return (perm[i*4] as i32)|((perm[i*4+1] as i32)<<8)|((perm[i*4+2] as i32)<<16)|((perm[i*4+3] as i32)<<24);
}

// ---- fixed-point (2^20): log2, ln, mul, div, pow2, sqrt ----
// floor(log2(x)) in fx units; x > 0 (fx units)
fn fx_log2(x:i64)i64 {
    let bl:i32=0; let t:i64=x;
    while(t>0){ bl=bl+1; t=t>>1; }
    let e:i64=(bl as i64)-1-20;
    let s:i64=(bl as i64)-1-20;
    let m:i64=x;
    if(s>0){ m=x>>s; } else { if(s<0){ m=x<<(-s); } }
    let frac:i64=0; let i:i32=1;
    while(i<=20){
        m=(m*m)>>20;
        if(m>=2097152){ frac=frac+((1<<(20-i)) as i64); m=m>>1; }
        i=i+1;
    }
    return (e<<20)+frac;
}
fn fx_ln(x:i64)i64 { return (fx_log2(x)*726817)>>20; } // ln2*2^20 = 726817
fn fx_mul(a:i64,b:i64)i64 { return (a*b)>>20; }
fn fx_div(a:i64,b:i64)i64 { return (a<<20)/b; } // caller keeps a small
// 2^c[i], c = 2^-i, in fx units, i=1..20
fn fx_c(i:i32)i64 {
    if(i==1){return 1482910;} if(i==2){return 1246974;} if(i==3){return 1143480;}
    if(i==4){return 1095000;} if(i==5){return 1071537;} if(i==6){return 1059994;}
    if(i==7){return 1054270;} if(i==8){return 1051419;} if(i==9){return 1049997;}
    if(i==10){return 1049286;} if(i==11){return 1048931;} if(i==12){return 1048753;}
    if(i==13){return 1048665;} if(i==14){return 1048620;} if(i==15){return 1048598;}
    if(i==16){return 1048587;} if(i==17){return 1048582;} if(i==18){return 1048579;}
    if(i==19){return 1048577;} return 1048577;
}
// 2^f for f <= 0 (fx units) -> fx units
fn fx_pow2(f:i64)i64 {
    if(f>=0){ return FXS; }
    let ei:i64=f>>20; // floor; arithmetic shift, f<0
    // careful: f>>20 for negative f rounds toward -inf in arithmetic shift: ok = floor
    let fr:i64=f-ei*FXS; // in [0, FXS)
    let r:i64=FXS; let i:i32=1;
    while(i<=20){
        if(((fr>>(20-i))&1)==1){ r=(r*fx_c(i))>>20; }
        i=i+1;
    }
    let sh:i64=-ei;
    if(sh>=31){ return 0; }
    return r>>sh;
}
// log-sum-exp accumulator in log2 fx units; call fx_lse_init() then fx_lse_add()
fn fx_lse_add(s:i64,t:i64)i64 {
    if(s<=-9223372036854775807/2){ return t; }
    let m:i64=s; let d:i64=t;
    if(t>s){ m=t; d=s; }
    // s = m + log2(1 + 2^(d-m)), d-m <= 0
    let v:i64=FXS+fx_pow2(d-m);
    return m+fx_log2(v);
}
// integer sqrt (floor) for i64 >= 0
fn fx_isqrt(x:i64)i64 {
    if(x<=0){ return 0; }
    let r:i64=x; let y:i64=(r+1)>>1;
    while(y<r){ r=y; y=(r+x/r)>>1; }
    return r;
}

// ---- Levenshtein with early exit: returns min(dist, cap+1) ----
fn fx_iget(w:[]u8,at:i32)i32 {
    return (w[at*4] as i32)|((w[at*4+1] as i32)<<8)|((w[at*4+2] as i32)<<16)|((w[at*4+3] as i32)<<24);
}
fn fx_iset(w:[]u8,at:i32,v:i32)void {
    w[at*4]=(v&255) as u8; w[at*4+1]=((v>>8)&255) as u8;
    w[at*4+2]=((v>>16)&255) as u8; w[at*4+3]=((v>>24)&255) as u8;
}
// i64 LE array helpers
fn det_i64_set(w:[]u8,at:i32,v:i64)void {
    let o:i32=at*8;
    w[o]=(v&255) as u8; w[o+1]=((v>>8)&255) as u8; w[o+2]=((v>>16)&255) as u8; w[o+3]=((v>>24)&255) as u8;
    w[o+4]=((v>>32)&255) as u8; w[o+5]=((v>>40)&255) as u8; w[o+6]=((v>>48)&255) as u8; w[o+7]=((v>>56)&255) as u8;
}
fn det_i64_get(w:[]u8,at:i32)i64 {
    let o:i32=at*8;
    let v:i64=(w[o] as i64)|((w[o+1] as i64)<<8)|((w[o+2] as i64)<<16)|((w[o+3] as i64)<<24);
    v=v|((w[o+4] as i64)<<32)|((w[o+5] as i64)<<40)|((w[o+6] as i64)<<48)|((w[o+7] as i64)<<56);
    return v;
}
fn plev_cap_at(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32,cap:i32)i32 {
    let row:[]u8=nio_alloc((bl+1)*4); let prv:[]u8=nio_alloc((bl+1)*4);
    let j:i32=0; while(j<=bl){ fx_iset(prv,j,j); j=j+1; }
    let i:i32=1;
    while(i<=al){
        fx_iset(row,0,i);
        let rowmin:i32=i; j=1;
        while(j<=bl){
            let cost:i32=1; if(a[ao+i-1]==b[bo+j-1]){cost=0;}
            let de:i32=fx_iget(prv,j)+1; let ins:i32=fx_iget(row,j-1)+1; let su:i32=fx_iget(prv,j-1)+cost;
            let v:i32=de; if(ins<v){v=ins;} if(su<v){v=su;}
            fx_iset(row,j,v); if(v<rowmin){rowmin=v;}
            j=j+1;
        }
        if(rowmin>cap){ nio_free(row); nio_free(prv); return cap+1; }
        let t:[]u8=row; row=prv; prv=t;
        i=i+1;
    }
    let d:i32=fx_iget(prv,bl);
    nio_free(row); nio_free(prv);
    return d;
}
fn plev_cap(a:[]u8,b:[]u8,cap:i32)i32 { return plev_cap_at(a,0,a.len,b,0,b.len,cap); }
// normalized edit distance > 1/20 ? (integer check: lev*20 > maxlen)
fn plev_distinct_at(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al==0 && bl==0){ return 0; }
    let mx:i32=al; if(bl>mx){mx=bl;}
    if(mx==0){ return 0; }
    let dl:i32=al-bl; if(dl<0){dl=-dl;}
    if(dl*20>mx){ return 1; }
    let cap:i32=mx/20;
    let d:i32=plev_cap_at(a,ao,al,b,bo,bl,cap);
    return (d*20>mx) as i32;
}
fn plev_distinct(a:[]u8,b:[]u8)i32 { return plev_distinct_at(a,0,a.len,b,0,b.len); }

// ---- print helpers ----
fn pf_pnum(x:i64)void { let t:[]u8=_zag_i64_to_str(x); _zag_print(t); nio_free(t); }
fn pf_phex(b:[]u8)void { let t:[]u8=ns_hex(b); _zag_print(t); nio_free(t); }
fn pf_sha_hexline(tag:[]u8,b:[]u8)void {
    let h:[]u8=nio_alloc(32); ns_sha256(b,h);
    _zag_print(tag); _zag_print(","); pf_phex(h); _zag_println("");
    nio_free(h);
}
// CSV-style evidence printing used by detector/null/adaptivity drivers
fn p(s:[]u8)void { _zag_print(s); }
fn pc(c:i32)void { let b:[]u8=nio_alloc(1); b[0]=(c&255) as u8; _zag_print(b); nio_free(b); }
fn pi(x:i64)void { let b:[]u8=_zag_i64_to_str(x); _zag_print(b); nio_free(b); }
fn pn()void { _zag_println(""); }

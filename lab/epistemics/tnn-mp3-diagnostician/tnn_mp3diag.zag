// tnn_mp3diag.zag — TNN AS MP3-DECODER SELF-DIAGNOSTICIAN: DIAGNOSTIC DISCOVERY.
//
// Micah order 2026-09-26: "do the next wall for TNN, crash through it, get rid
// of its templates and retrain it."
//
// v1 (docs/lab/tnn-diagnostician/) matched CREW-CODED symptom codes to
// CREW-EXTRACTED patterns with CREW-AUTHORED fix templates. v2 removes all of
// that: no patterns.dat, no symptom codes, no fix templates. TNN trains on RAW
// EVIDENCE (source files + audit prose) with crew-supplied LABELS of the form
// (file, line-range, defect-class) only. From the labeled raw text TNN INDUCES
// each defect class's signature itself: which structural features are required,
// which are forbidden, which are optional, which identifiers discriminate, and
// the match bar — all computed from the data, never crew-set. Discovery then
// scans a NOVEL raw file TNN never trained on, extracts candidate defect loci
// line by line, names the mechanism, and composes a fix direction from
// extracted slots ([COMPOSED] fixed wording + computed content — the crew never
// diagnosed the novel issue).
//
// Defect-class vocabulary (taught, 5 MP3-grounded classes):
//   GH GRANULE-HANDOFF  SP STATE-PERSISTENCE  PW PRECISION-WIDENING
//   WN WRONG-NOTE  MP MISSED-PROCESSING
//
// Structural features per line (crew-designed EXTRACTORS — the machinery;
// which features define each class is INDUCED from labeled data):
//   F0 bit0: nonstructural numeric literal present (value outside {0,1})
//   F1 bit1: function call present (identifier directly followed by '(')
//   F2 bit2: a call with >=2 numeric arguments
//   F3 bit3: literal assigned via '=' (e.g. = 112)
//   F4 bit4: assignment present ('=' not part of ==,!=,<=,>=)
//   F5 bit5: branch keyword present (if/else/while/for as whole words)
//   F6 bit6: comment line (first non-blank chars are //)
//   F7 bit7: string literal present
//
// Pure Zag. Zero RNG. Byte-identical reruns. Commits to tnn-native-lab, NEVER main.
// Pinned toolchain: ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1
@import("R33_NATIVE_IO_V1.zag")

// ---------------- u64/i64 LE helpers ([]u8 arenas; no narrow casts) ----
fn h_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
    return;
}
fn h_get64(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    v = v + (b[o + 4] as i64) * 4294967296 + (b[o + 5] as i64) * 1099511627776;
    v = v + (b[o + 6] as i64) * 281474976710656 + (b[o + 7] as i64) * 72057594037927936;
    return v;
}
// ---------------- trace builder (append-only text arena) ----------------
fn tr_init(cap:i64) []u8 {
    let t:[]u8 = nio_alloc(cap as i32);
    h_put64(t, 0, 0);
    return t;
}
fn tr_pos(t:[]u8) i64 { return h_get64(t, 0); }
fn tr_get(t:[]u8) []u8 {
    let p:i64 = tr_pos(t);
    return t[16..16 + p];
}
fn tr_str(t:[]u8, s:[]u8) void {
    let p:i64 = tr_pos(t);
    let i:i64 = 0;
    while (i < s.len) { t[16 + p + i] = s[i]; i = i + 1; }
    h_put64(t, 0, p + s.len);
    return;
}
fn tr_i64(t:[]u8, v:i64) void {
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    if (u == 0) { tmp[0] = 48; n = 1; }
    while (u > 0) { tmp[n] = (48 + (u % 10)) as u8; u = u / 10; n = n + 1; }
    if (neg == 1) { tr_str(t, "-"); }
    let i:i64 = 0;
    while (i < n) {
        let one:[]u8 = nio_alloc(1);
        one[0] = tmp[n - 1 - i];
        tr_str(t, one);
        nio_free(one);
        i = i + 1;
    }
    nio_free(tmp);
    return;
}
fn tr_nl(t:[]u8) void { tr_str(t, "\n"); return; }
// ---------------- file IO ----------------
fn read_file(root:i64, name:[]u8, b:[]u8, maxn:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, b, maxn as i32);
    nio_close(fd);
    return n;
}
fn write_file_all(root:i64, name:[]u8, b:[]u8, n:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { return -1; }
    let done:i64 = 0;
    while (done < n) {
        let c:i64 = n - done;
        if (c > 1048576) { c = 1048576; }
        let part:[]u8 = b[done..done + c];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != c) { nio_close(fd); return -2; }
        done = done + c;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}
// ---------------- string pool ----------------
fn pool_add(pool:[]u8, ppos:[]u8, s:[]u8, slen:i64) i64 {
    let off:i64 = h_get64(ppos, 0);
    let i:i64 = 0;
    while (i < slen) { pool[off + i] = s[i]; i = i + 1; }
    h_put64(ppos, 0, off + slen);
    return off;
}
fn pool_slice(pool:[]u8, off:i64, len:i64) []u8 {
    return pool[off..off + len];
}
fn pool_eq(pool:[]u8, o1:i64, l1:i64, o2:i64, l2:i64) i64 {
    if (l1 != l2) { return 0; }
    let i:i64 = 0;
    while (i < l1) {
        if (pool[o1 + i] != pool[o2 + i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
// ---------------- parsing ----------------
fn parse_i64(s:[]u8, start:i64, end:i64) i64 {
    let v:i64 = 0;
    let neg:i64 = 0;
    let i:i64 = start;
    if (i < end) {
        if (s[i] == 45) { neg = 1; i = i + 1; }
    }
    while (i < end) {
        let c:i64 = s[i] as i64;
        if (c >= 48) {
            if (c <= 57) { v = v * 10 + (c - 48); }
        }
        i = i + 1;
    }
    if (neg == 1) { v = 0 - v; }
    return v;
}
fn find_byte(s:[]u8, start:i64, end:i64, b:u8) i64 {
    let i:i64 = start;
    while (i < end) {
        if (s[i] == b) { return i; }
        i = i + 1;
    }
    return -1;
}
fn is_blank_line(s:[]u8, start:i64, end:i64) i64 {
    let i:i64 = start;
    while (i < end) {
        let c:i64 = s[i] as i64;
        if (c == 32) { i = i + 1; } else {
            if (c == 9) { i = i + 1; } else {
                if (c == 13) { i = i + 1; } else { return 0; }
            }
        }
    }
    return 1;
}
fn is_alpha(c:i64) i64 {
    if (c >= 65) { if (c <= 90) { return 1; } }
    if (c >= 97) { if (c <= 122) { return 1; } }
    if (c == 95) { return 1; }
    return 0;
}
fn is_digit(c:i64) i64 {
    if (c >= 48) { if (c <= 57) { return 1; } }
    return 0;
}
fn is_alnum(c:i64) i64 {
    if (is_alpha(c) == 1) { return 1; }
    if (is_digit(c) == 1) { return 1; }
    return 0;
}
// keyword stoplist for the ident bag (structural words; F5 covers branches)
fn is_stop(buf:[]u8, s:i64, e:i64) i64 {
    let n:i64 = e - s;
    if (n == 3) {
        if (buf[s] == 108) { if (buf[s+1] == 101) { if (buf[s+2] == 116) { return 1; } } }
        if (buf[s] == 102) { if (buf[s+1] == 110) { return 1; } }
        if (buf[s] == 97) { if (buf[s+1] == 115) { return 1; } }
    }
    if (n == 6) {
        if (buf[s] == 114) { if (buf[s+1] == 101) { if (buf[s+2] == 116) {
            if (buf[s+3] == 117) { if (buf[s+4] == 114) { if (buf[s+5] == 110) { return 1; } } } } } }
        if (buf[s] == 102) { if (buf[s+1] == 97) { if (buf[s+2] == 108) {
            if (buf[s+3] == 115) { if (buf[s+4] == 101) { return 1; } } } } }
    }
    if (n == 4) {
        if (buf[s] == 116) { if (buf[s+1] == 114) { if (buf[s+2] == 117) { if (buf[s+3] == 101) { return 1; } } } }
        if (buf[s] == 118) { if (buf[s+1] == 111) { if (buf[s+2] == 105) { if (buf[s+3] == 100) { return 1; } } } }
        if (buf[s] == 98) { if (buf[s+1] == 111) { if (buf[s+2] == 111) { if (buf[s+3] == 108) { return 1; } } } }
    }
    if (n == 3) {
        if (buf[s] == 105) { if (buf[s+1] == 54) { if (buf[s+2] == 52) { return 1; } } }
        if (buf[s] == 105) { if (buf[s+1] == 51) { if (buf[s+2] == 50) { return 1; } } }
        if (buf[s] == 117) { if (buf[s+1] == 51) { if (buf[s+2] == 50) { return 1; } } }
    }
    if (n == 2) {
        if (buf[s] == 117) { if (buf[s+1] == 56) { return 1; } }
    }
    return 0;
}
fn is_branchw(buf:[]u8, s:i64, e:i64) i64 {
    let n:i64 = e - s;
    if (n == 2) {
        if (buf[s] == 105) { if (buf[s+1] == 102) { return 1; } }
    }
    if (n == 4) {
        if (buf[s] == 101) { if (buf[s+1] == 108) { if (buf[s+2] == 115) { if (buf[s+3] == 101) { return 1; } } } }
    }
    if (n == 5) {
        if (buf[s] == 119) { if (buf[s+1] == 104) { if (buf[s+2] == 105) { if (buf[s+3] == 108) { if (buf[s+4] == 101) { return 1; } } } } }
    }
    if (n == 3) {
        if (buf[s] == 102) { if (buf[s+1] == 111) { if (buf[s+2] == 114) { return 1; } } }
    }
    return 0;
}
// ---------------- line feature extraction ----------------
// Tokenizes one raw line. Outputs:
//   idout:  [count][off,len pairs...] identifier bag (dedup within line)
//   litout: [count][value...] numeric literal values on the line
//   callnm: [off,len] of first called identifier, or -1,-1
// Returns: featmask in low 8 bits | identcount<<8 | litcount<<24
// A numeric literal is NONSTRUCTURAL when its absolute value is outside {0,1}
// (0/1 are addressing idioms: offsets, flags, loop seeds).
fn line_features(buf:[]u8, s:i64, e:i64, pool:[]u8, ppos:[]u8, idout:[]i64, maxid:i64, litout:[]i64, maxlit:i64, callnm:[]i64) i64 {
    let fm:i64 = 0;
    let idc:i64 = 0;
    let litc:i64 = 0;
    callnm[0] = -1;
    callnm[1] = -1;
    // F6: comment line (first non-blank chars are //)
    let q:i64 = s;
    while (q < e) {
        let c:i64 = buf[q] as i64;
        if (c == 32) { q = q + 1; } else { if (c == 9) { q = q + 1; } else { break; } }
    }
    if (q + 1 < e) {
        if (buf[q] == 47) { if (buf[q + 1] == 47) { fm = fm | 64; } }
    }
    // F7: string literal present
    let qs:i64 = find_byte(buf, s, e, 34);
    if (qs >= 0) { fm = fm | 128; }
    // main token scan
    let i:i64 = s;
    let in_str:i64 = 0;
    while (i < e) {
        let c:i64 = buf[i] as i64;
        if (in_str == 1) {
            if (c == 34) {
                if (i > s) {
                    if (buf[i - 1] != 92) { in_str = 0; }
                } else { in_str = 0; }
            }
            i = i + 1;
        } else {
            if (c == 34) { in_str = 1; i = i + 1; } else {
                if (c == 47) {
                    if (i + 1 < e) { if (buf[i + 1] == 47) { break; } }
                    i = i + 1;
                } else {
                    if (is_alpha(c) == 1) {
                        let j:i64 = i + 1;
                        while (j < e) {
                            let d:i64 = buf[j] as i64;
                            if (is_alnum(d) == 1) { j = j + 1; } else { break; }
                        }
                        if (is_branchw(buf, i, j) == 1) { fm = fm | 32; } else {
                            if (is_stop(buf, i, j) == 0) {
                                // call? identifier directly followed by '(' (skip blanks)
                                let k:i64 = j;
                                while (k < e) {
                                    let dc:i64 = buf[k] as i64;
                                    if (dc == 32) { k = k + 1; } else { if (dc == 9) { k = k + 1; } else { break; } }
                                }
                                if (k < e) {
                                    if (buf[k] == 40) {
                                        fm = fm | 2;
                                        if (callnm[0] == -1) {
                                            callnm[0] = pool_add(pool, ppos, buf[i..j], j - i);
                                            callnm[1] = j - i;
                                        }
                                        // F2: >=2 numeric args inside these parens (depth-aware)
                                        let depth:i64 = 1;
                                        let p:i64 = k + 1;
                                        let argc_lits:i64 = 0;
                                        let pstr:i64 = 0;
                                        while (p < e) {
                                            if (depth == 0) { break; }
                                            let pc:i64 = buf[p] as i64;
                                            if (pstr == 1) {
                                                if (pc == 34) {
                                                    if (p > k + 1) { if (buf[p - 1] != 92) { pstr = 0; } } else { pstr = 0; }
                                                }
                                                p = p + 1;
                                            } else {
                                                if (pc == 34) { pstr = 1; p = p + 1; } else {
                                                    if (pc == 40) { depth = depth + 1; p = p + 1; } else {
                                                        if (pc == 41) { depth = depth - 1; p = p + 1; } else {
                                                            if (is_digit(pc) == 1) {
                                                                let ok:i64 = 1;
                                                                if (p > s) {
                                                                    let pch:i64 = buf[p - 1] as i64;
                                                                    if (is_alnum(pch) == 1) { ok = 0; }
                                                                    if (pch == 95) { ok = 0; }
                                                                }
                                                                if (ok == 1) { argc_lits = argc_lits + 1; }
                                                                while (p < e) {
                                                                    if (is_digit(buf[p] as i64) == 1) { p = p + 1; } else { break; }
                                                                }
                                                            } else { p = p + 1; }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if (argc_lits >= 2) { fm = fm | 4; }
                                    }
                                }
                                // add to ident bag (dedup within line)
                                let dup:i64 = 0;
                                let poff:i64 = pool_add(pool, ppos, buf[i..j], j - i);
                                let tt:i64 = 0;
                                while (tt < idc) {
                                    if (pool_eq(pool, idout[1 + tt * 2], idout[1 + tt * 2 + 1], poff, j - i) == 1) { dup = 1; }
                                    tt = tt + 1;
                                }
                                if (dup == 0) {
                                    if (idc < maxid) {
                                        idout[1 + idc * 2] = poff;
                                        idout[1 + idc * 2 + 1] = j - i;
                                        idc = idc + 1;
                                    }
                                }
                            }
                        }
                        i = j;
                    } else {
                        let negnum:i64 = 0;
                        if (c == 45) {
                            if (i + 1 < e) {
                                if (is_digit(buf[i + 1] as i64) == 1) {
                                    if (i == s) { negnum = 1; } else {
                                        let pch:i64 = buf[i - 1] as i64;
                                        if (is_alnum(pch) == 0) { if (pch != 95) { negnum = 1; } }
                                    }
                                }
                            }
                        }
                        if (is_digit(c) == 1) {
                            let ok:i64 = 1;
                            if (i > s) {
                                let pch:i64 = buf[i - 1] as i64;
                                if (is_alnum(pch) == 1) { ok = 0; }
                                if (pch == 95) { ok = 0; }
                            }
                            let j2:i64 = i;
                            while (j2 < e) {
                                if (is_digit(buf[j2] as i64) == 1) { j2 = j2 + 1; } else { break; }
                            }
                            if (ok == 1) {
                                let v:i64 = parse_i64(buf, i, j2);
                                let av:i64 = v;
                                if (av < 0) { av = 0 - av; }
                                if (litc < maxlit) { litout[1 + litc] = v; litc = litc + 1; }
                                if (av != 0) { if (av != 1) { fm = fm | 1; } }
                            }
                            i = j2;
                        } else {
                            if (negnum == 1) {
                                let j2:i64 = i + 1;
                                while (j2 < e) {
                                    if (is_digit(buf[j2] as i64) == 1) { j2 = j2 + 1; } else { break; }
                                }
                                let v:i64 = parse_i64(buf, i, j2);
                                let av:i64 = v;
                                if (av < 0) { av = 0 - av; }
                                if (litc < maxlit) { litout[1 + litc] = v; litc = litc + 1; }
                                if (av != 0) { if (av != 1) { fm = fm | 1; } }
                                i = j2;
                            } else {
                                if (c == 61) {
                                    // '=' : distinguish ==,!=,<=,>=
                                    if (i + 1 < e) {
                                        if (buf[i + 1] == 61) { i = i + 2; } else {
                                            let isrel:i64 = 0;
                                            if (i > s) {
                                                let pch:i64 = buf[i - 1] as i64;
                                                if (pch == 61) { isrel = 1; }
                                                if (pch == 33) { isrel = 1; }
                                                if (pch == 60) { isrel = 1; }
                                                if (pch == 62) { isrel = 1; }
                                            }
                                            if (isrel == 0) {
                                                fm = fm | 16;
                                                // F3: literal assigned? skip blanks, digit or -digit
                                                let m:i64 = i + 1;
                                                while (m < e) {
                                                    let mc:i64 = buf[m] as i64;
                                                    if (mc == 32) { m = m + 1; } else { if (mc == 9) { m = m + 1; } else { break; } }
                                                }
                                                if (m < e) {
                                                    if (is_digit(buf[m] as i64) == 1) { fm = fm | 8; } else {
                                                        if (buf[m] == 45) {
                                                            if (m + 1 < e) { if (is_digit(buf[m + 1] as i64) == 1) { fm = fm | 8; } }
                                                        }
                                                    }
                                                }
                                            }
                                            i = i + 1;
                                        }
                                    } else { fm = fm | 16; i = i + 1; }
                                } else { i = i + 1; }
                            }
                        }
                    }
                }
            }
        }
    }
    idout[0] = idc;
    litout[0] = litc;
    return fm | (idc << 8) | (litc << 24);
}
// feature-name for trace readability
fn feat_name(bit:i64, t:[]u8) void {
    if (bit == 0) { tr_str(t, "NUMLIT_NS"); }
    if (bit == 1) { tr_str(t, "CALL"); }
    if (bit == 2) { tr_str(t, "NLIT_ARGS_GE2"); }
    if (bit == 3) { tr_str(t, "LIT_EQ"); }
    if (bit == 4) { tr_str(t, "ASSIGN"); }
    if (bit == 5) { tr_str(t, "BRANCH"); }
    if (bit == 6) { tr_str(t, "COMMENT"); }
    if (bit == 7) { tr_str(t, "STRING"); }
    return;
}
fn tr_featmask(t:[]u8, fm:i64) void {
    let b:i64 = 0;
    let first:i64 = 1;
    while (b < 8) {
        if ((fm & (1 << b)) != 0) {
            if (first == 0) { tr_str(t, "|"); }
            feat_name(b, t);
            first = 0;
        }
        b = b + 1;
    }
    if (first == 1) { tr_str(t, "(none)"); }
    return;
}
// ---------------- evidence loading ----------------
// load_one: reads fname into ebuf at epos, splits lines into linetab[base..].
// Returns line count, or -1 on missing file.
fn load_one(evroot:i64, fname:[]u8, ebuf:[]u8, epos:[]u8, linetab:[]i64, base:i64, maxlines:i64, t:[]u8) i64 {
    let off:i64 = h_get64(epos, 0);
    let cap:i64 = 1048576;
    let tmp:[]u8 = nio_alloc(cap as i32);
    let n:i64 = read_file(evroot, fname, tmp, cap);
    if (n < 0) { nio_free(tmp); return -1; }
    let i:i64 = 0;
    while (i < n) { ebuf[off + i] = tmp[i]; i = i + 1; }
    nio_free(tmp);
    // split lines on \n (strip trailing \r)
    let nl:i64 = 0;
    let ls:i64 = off;
    let p:i64 = off;
    while (p < off + n) {
        if (ebuf[p] == 10) {
            let le:i64 = p;
            if (le > ls) { if (ebuf[le - 1] == 13) { le = le - 1; } }
            if (nl < maxlines) {
                linetab[base + nl * 2] = ls;
                linetab[base + nl * 2 + 1] = le;
                nl = nl + 1;
            }
            ls = p + 1;
        }
        p = p + 1;
    }
    if (ls < off + n) {
        if (nl < maxlines) {
            linetab[base + nl * 2] = ls;
            linetab[base + nl * 2 + 1] = off + n;
            nl = nl + 1;
        }
    }
    h_put64(epos, 0, off + n);
    tr_str(t, "  loaded ");
    tr_str(t, fname);
    tr_str(t, ": ");
    tr_i64(t, n);
    tr_str(t, " bytes, ");
    tr_i64(t, nl);
    tr_str(t, " lines");
    tr_nl(t);
    return nl;
}
fn find_key(keys:[]i64, nkeys:i64, pool:[]u8, ko:i64, kl:i64) i64 {
    let i:i64 = 0;
    while (i < nkeys) {
        if (pool_eq(pool, keys[i * 2], keys[i * 2 + 1], ko, kl) == 1) { return i; }
        i = i + 1;
    }
    return -1;
}
// ---------------- label intake ----------------
// labels dat: LID|filekey|lo|hi|CLASS   (# comments, blank lines skipped)
// Fills lab_* tables and the class vocabulary (cls_name[], ncls[0]).
// Returns label count, or -1 on missing labels file.
fn train_labels(root:i64, lname:[]u8, keys:[]i64, nkeys:i64, pool:[]u8, ppos:[]u8, lab_file:[]i64, lab_lo:[]i64, lab_hi:[]i64, lab_cls:[]i64, cls_name:[]i64, ncls:[]i64, t:[]u8) i64 {
    let tmp:[]u8 = nio_alloc(65536);
    let n:i64 = read_file(root, lname, tmp, 65536);
    if (n < 0) { nio_free(tmp); return -1; }
    let nlab:i64 = 0;
    let p:i64 = 0;
    while (p < n) {
        let le:i64 = find_byte(tmp, p, n, 10);
        if (le < 0) { le = n; }
        let ls:i64 = le;
        if (le > p) { if (tmp[le - 1] == 13) { ls = le - 1; } }
        if (is_blank_line(tmp, p, ls) == 0) {
            if (tmp[p] != 35) {
                let f0:i64 = find_byte(tmp, p, ls, 124);
                let f1:i64 = -1;
                let f2:i64 = -1;
                let f3:i64 = -1;
                if (f0 > 0) { f1 = find_byte(tmp, f0 + 1, ls, 124); }
                if (f1 > 0) { f2 = find_byte(tmp, f1 + 1, ls, 124); }
                if (f2 > 0) { f3 = find_byte(tmp, f2 + 1, ls, 124); }
                if (f3 > 0) {
                    let ko:i64 = p;
                    // filekey is between f0+1 and f1 (we copy to pool for find_key)
                    let klen:i64 = f1 - f0 - 1;
                    let kpo:i64 = pool_add(pool, ppos, tmp[f0 + 1..f1], klen);
                    let fi:i64 = find_key(keys, nkeys, pool, kpo, klen);
                    let lo:i64 = parse_i64(tmp, f1 + 1, f2);
                    let hi:i64 = parse_i64(tmp, f2 + 1, f3);
                    let cn:i64 = ls - f3 - 1;
                    let cpo:i64 = pool_add(pool, ppos, tmp[f3 + 1..ls], cn);
                    // class index (create if new)
                    let ci:i64 = -1;
                    let c:i64 = 0;
                    while (c < ncls[0]) {
                        if (pool_eq(pool, cls_name[c * 2], cls_name[c * 2 + 1], cpo, cn) == 1) { ci = c; }
                        c = c + 1;
                    }
                    if (ci < 0) {
                        if (ncls[0] < 8) {
                            ci = ncls[0];
                            cls_name[ci * 2] = cpo;
                            cls_name[ci * 2 + 1] = cn;
                            ncls[0] = ncls[0] + 1;
                        }
                    }
                    if (fi >= 0) {
                        if (ci >= 0) {
                            if (nlab < 16) {
                                lab_file[nlab] = fi;
                                lab_lo[nlab] = lo;
                                lab_hi[nlab] = hi;
                                lab_cls[nlab] = ci;
                                nlab = nlab + 1;
                            }
                        } else { tr_str(t, "  WARN: class table full, label dropped"); tr_nl(t); }
                    } else { tr_str(t, "  WARN: unknown filekey, label dropped"); tr_nl(t); }
                    let _k:i64 = ko;
                }
            }
        }
        p = le + 1;
    }
    nio_free(tmp);
    return nlab;
}
// ---------------- label validation + feature-bag extraction ----------------
// Intake VALIDATES each label against the raw text (TNN's intake rule):
//   (a) file key resolves, 1<=lo<=hi<=nlines of that file;
//   (b) the locus contains at least one non-blank line;
//   (c) class-specific recompute: an SP (STATE-PERSISTENCE) label MUST show an
//       assignment when re-extracted from the raw text — a re-initialized-state
//       claim with no assignment is self-contradictory.
// Other classes carry no recomputable claim without circularity; their class
// association is the crew's teaching claim, validated only by the
// before/after discovery test. lab_valid[l]=1/0 with reason in trace.
fn validate_labels(nlab:i64, lab_file:[]i64, lab_lo:[]i64, lab_hi:[]i64, lab_cls:[]i64, file_nlines:[]i64, linetab:[]i64, file_base:[]i64, ebuf:[]u8, pool:[]u8, ppos:[]u8, cls_name:[]i64, hc:[]i64, lab_fm:[]i64, lab_idbase:[]i64, lab_idn:[]i64, labids:[]i64, lab_valid:[]i64, t:[]u8) i64 {
    let nvalid:i64 = 0;
    let l:i64 = 0;
    while (l < nlab) {
        let f:i64 = lab_file[l];
        let lo:i64 = lab_lo[l];
        let hi:i64 = lab_hi[l];
        let ok:i64 = 1;
        let why:[]u8 = "ok";
        if (f < 0) { ok = 0; why = "unknown-filekey"; } else {
            if (lo < 1) { ok = 0; why = "lo<1"; } else {
                if (hi < lo) { ok = 0; why = "hi<lo"; } else {
                    if (hi > file_nlines[f]) { ok = 0; why = "hi>nlines"; }
                }
            }
        }
        let bag:i64 = 0;
        let idn:i64 = 0;
        let idbase:i64 = l * 128;
        if (ok == 1) {
            let base:i64 = file_base[f];
            // (b) non-blank content
            let ln:i64 = lo;
            let anytext:i64 = 0;
            while (ln <= hi) {
                let ls2:i64 = linetab[base + (ln - 1) * 2];
                let le2:i64 = linetab[base + (ln - 1) * 2 + 1];
                if (is_blank_line(ebuf, ls2, le2) == 0) { anytext = 1; }
                ln = ln + 1;
            }
            if (anytext == 0) { ok = 0; why = "blank-locus"; } else {
                // extract bag over the range
                let idt:[]i64 = nio_alloc(8 * 130) as []i64;
                let litt:[]i64 = nio_alloc(8 * 10) as []i64;
                let cnt:[]i64 = nio_alloc(8 * 2) as []i64;
                let ln2:i64 = lo;
                while (ln2 <= hi) {
                    let ls3:i64 = linetab[base + (ln2 - 1) * 2];
                    let le3:i64 = linetab[base + (ln2 - 1) * 2 + 1];
                    let r:i64 = line_features(ebuf, ls3, le3, pool, ppos, idt, 64, litt, 8, cnt);
                    bag = bag | (r & 255);
                    let nic:i64 = (r >> 8) & 255;
                    let x:i64 = 0;
                    while (x < nic) {
                        let xo:i64 = idt[1 + x * 2];
                        let xl:i64 = idt[1 + x * 2 + 1];
                        let dup:i64 = 0;
                        let y:i64 = 0;
                        while (y < idn) {
                            if (pool_eq(pool, labids[idbase + y * 2], labids[idbase + y * 2 + 1], xo, xl) == 1) { dup = 1; }
                            y = y + 1;
                        }
                        if (dup == 0) {
                            if (idn < 64) {
                                labids[idbase + idn * 2] = xo;
                                labids[idbase + idn * 2 + 1] = xl;
                                idn = idn + 1;
                            }
                        }
                        x = x + 1;
                    }
                    ln2 = ln2 + 1;
                }
                nio_free(idt); nio_free(litt); nio_free(cnt);
                // (c) SP recompute: a state re-initialized claim must show an
                // assignment (F4); without one the claim is self-contradictory.
                let ci:i64 = lab_cls[l];
                if (pool_eq(pool, cls_name[ci * 2], cls_name[ci * 2 + 1], hc[0], hc[1]) == 1) {
                    if ((bag & 16) == 0) { ok = 0; why = "SP-without-assign"; }
                }
            }
        }
        lab_valid[l] = ok;
        lab_fm[l] = bag;
        lab_idbase[l] = idbase;
        lab_idn[l] = idn;
        if (ok == 1) { nvalid = nvalid + 1; }
        tr_str(t, "  L");
        tr_i64(t, l + 1);
        tr_str(t, " file=");
        tr_i64(t, f);
        tr_str(t, " lines=");
        tr_i64(t, lo);
        tr_str(t, "-");
        tr_i64(t, hi);
        tr_str(t, " class=");
        let ci2:i64 = lab_cls[l];
        tr_str(t, pool_slice(pool, cls_name[ci2 * 2], cls_name[ci2 * 2 + 1]));
        tr_str(t, " valid=");
        tr_i64(t, ok);
        tr_str(t, " (");
        tr_str(t, why);
        tr_str(t, ") feats=");
        tr_featmask(t, bag);
        tr_str(t, " idents=");
        tr_i64(t, idn);
        tr_nl(t);
        l = l + 1;
    }
    return nvalid;
}
fn popcnt(x:i64) i64 {
    let n:i64 = 0;
    let b:i64 = 0;
    while (b < 8) {
        if ((x & (1 << b)) != 0) { n = n + 1; }
        b = b + 1;
    }
    return n;
}
fn label_has_ident(pool:[]u8, labids:[]i64, idbase:i64, idn:i64, xo:i64, xl:i64) i64 {
    let y:i64 = 0;
    while (y < idn) {
        if (pool_eq(pool, labids[idbase + y * 2], labids[idbase + y * 2 + 1], xo, xl) == 1) { return 1; }
        y = y + 1;
    }
    return 0;
}
// ---------------- affinity induction ----------------
// From the VALIDATED labeled loci, TNN induces each class's signature:
//   required  = features true in ALL of the class's labels
//   forbidden = features true in NONE of the class's labels
//   optional  = features true in SOME but not all
//   disc      = identifiers in >=half of the class's labels and in <half of
//               all other labels (discriminative vocabulary, computed)
//   bar       = max(1, floor(min_label_score * 3 / 4))
// Nothing here is crew-set except the extractors (the machinery) and the
// labels (the teaching). A class with zero valid labels gets no signature.
fn induce(nlab:i64, lab_cls:[]i64, lab_valid:[]i64, lab_fm:[]i64, lab_idbase:[]i64, lab_idn:[]i64, labids:[]i64, ncls:i64, pool:[]u8, cls_req:[]i64, cls_forbid:[]i64, cls_opt:[]i64, cls_bar:[]i64, cls_nlab:[]i64, cls_discbase:[]i64, cls_discn:[]i64, discids:[]i64, t:[]u8) void {
    let c:i64 = 0;
    while (c < ncls) {
        let nlc:i64 = 0;
        let l:i64 = 0;
        while (l < nlab) {
            if (lab_valid[l] == 1) { if (lab_cls[l] == c) { nlc = nlc + 1; } }
            l = l + 1;
        }
        cls_nlab[c] = nlc;
        cls_req[c] = 0;
        cls_forbid[c] = 0;
        cls_opt[c] = 0;
        cls_bar[c] = 0;
        cls_discbase[c] = c * 256;
        cls_discn[c] = 0;
        if (nlc > 0) {
            let allm:i64 = 255;
            let anym:i64 = 0;
            let l2:i64 = 0;
            while (l2 < nlab) {
                if (lab_valid[l2] == 1) {
                    if (lab_cls[l2] == c) {
                        allm = allm & lab_fm[l2];
                        anym = anym | lab_fm[l2];
                    }
                }
                l2 = l2 + 1;
            }
            cls_req[c] = allm;
            cls_forbid[c] = 255 ^ anym;
            cls_opt[c] = anym ^ allm;
            // discriminative identifiers
            let ndc:i64 = 0;
            let dbase:i64 = c * 256;
            let nother:i64 = 0;
            let l3:i64 = 0;
            while (l3 < nlab) {
                if (lab_valid[l3] == 1) { if (lab_cls[l3] != c) { nother = nother + 1; } }
                l3 = l3 + 1;
            }
            let l4:i64 = 0;
            while (l4 < nlab) {
                if (lab_valid[l4] == 1) {
                    if (lab_cls[l4] == c) {
                        let ib:i64 = lab_idbase[l4];
                        let inn:i64 = lab_idn[l4];
                        let x:i64 = 0;
                        while (x < inn) {
                            let xo:i64 = labids[ib + x * 2];
                            let xl:i64 = labids[ib + x * 2 + 1];
                            let seen:i64 = 0;
                            let d:i64 = 0;
                            while (d < ndc) {
                                if (pool_eq(pool, discids[dbase + d * 2], discids[dbase + d * 2 + 1], xo, xl) == 1) { seen = 1; }
                                d = d + 1;
                            }
                            if (seen == 0) {
                                let in_c:i64 = 0;
                                let in_o:i64 = 0;
                                let l5:i64 = 0;
                                while (l5 < nlab) {
                                    if (lab_valid[l5] == 1) {
                                        if (label_has_ident(pool, labids, lab_idbase[l5], lab_idn[l5], xo, xl) == 1) {
                                            if (lab_cls[l5] == c) { in_c = in_c + 1; } else { in_o = in_o + 1; }
                                        }
                                    }
                                    l5 = l5 + 1;
                                }
                                if (in_c * 2 >= nlc) {
                                    if (in_o * 2 < nother) {
                                        if (ndc < 128) {
                                            discids[dbase + ndc * 2] = xo;
                                            discids[dbase + ndc * 2 + 1] = xl;
                                            ndc = ndc + 1;
                                        }
                                    }
                                }
                            }
                            x = x + 1;
                        }
                    }
                }
                l4 = l4 + 1;
            }
            cls_discn[c] = ndc;
            // bar from weakest training label
            let minscore:i64 = 1000000;
            let l6:i64 = 0;
            while (l6 < nlab) {
                if (lab_valid[l6] == 1) {
                    if (lab_cls[l6] == c) {
                        let s:i64 = popcnt(cls_opt[c] & lab_fm[l6]);
                        let ib6:i64 = lab_idbase[l6];
                        let d6:i64 = 0;
                        while (d6 < ndc) {
                            if (label_has_ident(pool, labids, ib6, lab_idn[l6], discids[dbase + d6 * 2], discids[dbase + d6 * 2 + 1]) == 1) { s = s + 1; }
                            d6 = d6 + 1;
                        }
                        if (s < minscore) { minscore = s; }
                    }
                }
                l6 = l6 + 1;
            }
            let bar:i64 = (minscore * 3) / 4;
            if (bar < 1) { bar = 1; }
            cls_bar[c] = bar;
            tr_str(t, "  class ");
            tr_i64(t, c);
            tr_str(t, ": nlab=");
            tr_i64(t, nlc);
            tr_str(t, " required=");
            tr_featmask(t, cls_req[c]);
            tr_str(t, " forbidden=");
            tr_featmask(t, cls_forbid[c]);
            tr_str(t, " optional=");
            tr_featmask(t, cls_opt[c]);
            tr_str(t, " disc=");
            tr_i64(t, ndc);
            tr_str(t, " bar=");
            tr_i64(t, bar);
            tr_str(t, " (min train score=");
            tr_i64(t, minscore);
            tr_str(t, ")");
            tr_nl(t);
        }
        c = c + 1;
    }
    return;
}
// ---------------- knowmap write / read ----------------
fn write_knowmap(root:i64, kname:[]u8, ncls:i64, pool:[]u8, cls_name:[]i64, cls_req:[]i64, cls_forbid:[]i64, cls_opt:[]i64, cls_bar:[]i64, cls_nlab:[]i64, cls_discbase:[]i64, cls_discn:[]i64, discids:[]i64, t:[]u8) i64 {
    let k:[]u8 = tr_init(65536);
    tr_str(k, "MP3DIAGKNOWMAP 1\n");
    tr_str(k, "CLASSES ");
    tr_i64(k, ncls);
    tr_nl(k);
    let c:i64 = 0;
    while (c < ncls) {
        if (cls_nlab[c] > 0) {
            tr_str(k, "CLASS ");
            tr_i64(k, c);
            tr_str(k, " ");
            tr_str(k, pool_slice(pool, cls_name[c * 2], cls_name[c * 2 + 1]));
            tr_nl(k);
            tr_str(k, "REQ ");
            tr_i64(k, cls_req[c]);
            tr_nl(k);
            tr_str(k, "FORB ");
            tr_i64(k, cls_forbid[c]);
            tr_nl(k);
            tr_str(k, "OPT ");
            tr_i64(k, cls_opt[c]);
            tr_nl(k);
            tr_str(k, "DISC ");
            tr_i64(k, cls_discn[c]);
            let d:i64 = 0;
            while (d < cls_discn[c]) {
                tr_str(k, " ");
                tr_str(k, pool_slice(pool, discids[cls_discbase[c] + d * 2], discids[cls_discbase[c] + d * 2 + 1]));
                d = d + 1;
            }
            tr_nl(k);
            tr_str(k, "BAR ");
            tr_i64(k, cls_bar[c]);
            tr_nl(k);
        }
        c = c + 1;
    }
    let kb:[]u8 = tr_get(k);
    let rc:i64 = write_file_all(root, kname, kb, tr_pos(k));
    nio_free(k);
    return rc;
}
// read a knowmap back; fills class tables; returns class count or -1
fn read_knowmap(root:i64, kname:[]u8, pool:[]u8, ppos:[]u8, cls_name:[]i64, cls_req:[]i64, cls_forbid:[]i64, cls_opt:[]i64, cls_bar:[]i64, cls_nlab:[]i64, cls_discbase:[]i64, cls_discn:[]i64, discids:[]i64, t:[]u8) i64 {
    let tmp:[]u8 = nio_alloc(65536);
    let n:i64 = read_file(root, kname, tmp, 65536);
    if (n < 0) { nio_free(tmp); return -1; }
    let ncls:i64 = 0;
    let cur:i64 = -1;
    let p:i64 = 0;
    while (p < n) {
        let le:i64 = find_byte(tmp, p, n, 10);
        if (le < 0) { le = n; }
        let ls:i64 = le;
        if (le > p) { if (tmp[le - 1] == 13) { ls = le - 1; } }
        if (is_blank_line(tmp, p, ls) == 0) {
            if (tmp[p] != 35) {
                // keyword = up to first space
                let sp:i64 = find_byte(tmp, p, ls, 32);
                if (sp < 0) { sp = ls; }
                let kw:i64 = sp - p;
                if (kw == 5) {
                    // CLASS
                    if (tmp[p] == 67) {
                        cur = ncls;
                        let nm:i64 = find_byte(tmp, sp + 1, ls, 32);
                        if (nm < 0) { nm = sp + 1; }
                        // format: CLASS <idx> <name> — name starts after 2nd space
                        let ns:i64 = find_byte(tmp, nm + 1, ls, 32);
                        let nstart:i64 = nm + 1;
                        if (ns > 0) { nstart = ns + 1; }
                        let cpo:i64 = pool_add(pool, ppos, tmp[nstart..ls], ls - nstart);
                        cls_name[cur * 2] = cpo;
                        cls_name[cur * 2 + 1] = ls - nstart;
                        cls_discbase[cur] = cur * 256;
                        cls_discn[cur] = 0;
                        cls_nlab[cur] = 1;
                        ncls = ncls + 1;
                    }
                } else {
                    if (kw == 3) {
                        if (tmp[p] == 82) { if (cur >= 0) { cls_req[cur] = parse_i64(tmp, sp + 1, ls); } }
                        if (tmp[p] == 79) { if (cur >= 0) { cls_opt[cur] = parse_i64(tmp, sp + 1, ls); } }
                        if (tmp[p] == 66) { if (cur >= 0) { cls_bar[cur] = parse_i64(tmp, sp + 1, ls); } }
                    } else {
                        if (kw == 4) {
                            if (tmp[p] == 70) { if (cur >= 0) { cls_forbid[cur] = parse_i64(tmp, sp + 1, ls); } }
                            if (tmp[p] == 68) {
                                if (cur >= 0) {
                                    // DISC <k> <id...>
                                    let q:i64 = sp + 1;
                                    let e1:i64 = find_byte(tmp, q, ls, 32);
                                    if (e1 < 0) { e1 = ls; }
                                    let k2:i64 = parse_i64(tmp, q, e1);
                                    let d:i64 = 0;
                                    let w:i64 = e1;
                                    while (d < k2) {
                                        while (w < ls) { if (tmp[w] == 32) { w = w + 1; } else { break; } }
                                        if (w >= ls) { break; }
                                        let we:i64 = find_byte(tmp, w, ls, 32);
                                        if (we < 0) { we = ls; }
                                        let dpo:i64 = pool_add(pool, ppos, tmp[w..we], we - w);
                                        discids[cls_discbase[cur] + d * 2] = dpo;
                                        discids[cls_discbase[cur] + d * 2 + 1] = we - w;
                                        d = d + 1;
                                        w = we;
                                    }
                                    cls_discn[cur] = d;
                                }
                            }
                        }
                    }
                }
            }
        }
        p = le + 1;
    }
    nio_free(tmp);
    return ncls;
}
// ---------------- discovery ----------------
// Scans a NOVEL raw file (never seen in training) line by line. A line matches
// a class iff: all required features present, no forbidden feature present,
// and (optional-feature matches + discriminative-ident matches) >= bar.
// A class whose induced signature is vacuous (no required feature AND bar<=1 —
// it would match nearly every line) ABSTAINS instead of firing spuriously:
// TNN must be able to say NO_MATCH. Consecutive same-class hits merge into
// regions. Each region gets a [COMPOSED] fix direction: fixed per-class wording
// (the reporter, not a template library — the crew never diagnosed this file)
// with computed slots: line(s), literals, call name, matched identifiers.
fn disc_hits_line(pool:[]u8, idout:[]i64, cls_disc:[]i64, dbase:i64, dcn:i64, matchbuf:[]i64) i64 {
    let idc:i64 = idout[0];
    let nm:i64 = 0;
    let x:i64 = 0;
    while (x < idc) {
        let xo:i64 = idout[1 + x * 2];
        let xl:i64 = idout[1 + x * 2 + 1];
        let d:i64 = 0;
        while (d < dcn) {
            if (pool_eq(pool, cls_disc[dbase + d * 2], cls_disc[dbase + d * 2 + 1], xo, xl) == 1) {
                let dup:i64 = 0;
                let m:i64 = 0;
                while (m < nm) {
                    if (pool_eq(pool, matchbuf[m * 2], matchbuf[m * 2 + 1], xo, xl) == 1) { dup = 1; }
                    m = m + 1;
                }
                if (dup == 0) {
                    if (nm < 16) {
                        matchbuf[nm * 2] = xo;
                        matchbuf[nm * 2 + 1] = xl;
                        nm = nm + 1;
                    }
                }
            }
            d = d + 1;
        }
        x = x + 1;
    }
    return nm;
}
fn tr_litlist(t:[]u8, litout:[]i64, nonstruct:i64) void {
    let lc:i64 = litout[0];
    let shown:i64 = 0;
    let x:i64 = 0;
    while (x < lc) {
        let v:i64 = litout[1 + x];
        let av:i64 = v;
        if (av < 0) { av = 0 - av; }
        let show:i64 = 1;
        if (nonstruct == 1) { if (av == 0) { show = 0; } if (av == 1) { show = 0; } }
        if (show == 1) {
            if (shown > 0) { tr_str(t, ","); }
            tr_i64(t, v);
            shown = shown + 1;
            if (shown >= 8) { break; }
        }
        x = x + 1;
    }
    if (shown == 0) { tr_str(t, "(none)"); }
    return;
}
fn composed_fix(t:[]u8, pool:[]u8, clsname:[]u8, region_s:i64, region_e:i64, litstr:[]u8, callstr:[]u8, idstr:[]u8) void {
    tr_str(t, "  [COMPOSED] ");
    if (_zag_strcmp(clsname, "GH") == 1) {
        tr_str(t, "mechanism=GRANULE-HANDOFF. Scalefactor side-info (");
        tr_str(t, idstr);
        tr_str(t, ") is re-derived or re-shifted per granule at line(s) ");
    } else {
        if (_zag_strcmp(clsname, "SP") == 1) {
            tr_str(t, "mechanism=STATE-PERSISTENCE. Decoder state (");
            tr_str(t, idstr);
            tr_str(t, ") is re-initialized inside the granule/channel loop at line(s) ");
        } else {
            if (_zag_strcmp(clsname, "PW") == 1) {
                tr_str(t, "mechanism=PRECISION-WIDENING. f32 bit patterns widened to f64 via (");
                tr_str(t, idstr);
                tr_str(t, ") at line(s) ");
            } else {
                if (_zag_strcmp(clsname, "WN") == 1) {
                    tr_str(t, "mechanism=WRONG-NOTE. Prose misdiagnosis (");
                    tr_str(t, idstr);
                    tr_str(t, ") at line(s) ");
                } else {
                    if (_zag_strcmp(clsname, "MP") == 1) {
                        tr_str(t, "mechanism=MISSED-PROCESSING. Frame path (");
                        tr_str(t, idstr);
                        tr_str(t, ") with a processing stage absent at line(s) ");
                    } else {
                        tr_str(t, "mechanism=");
                        tr_str(t, clsname);
                        tr_str(t, ". Line(s) ");
                    }
                }
            }
        }
    }
    tr_i64(t, region_s);
    if (region_e > region_s) { tr_str(t, "-"); tr_i64(t, region_e); }
    if (_zag_strcmp(clsname, "GH") == 1) {
        tr_str(t, ". FIX-DIRECTION (composed from evidence, not a template): keep ONE running scfsi variable across granules; apply the short-block mask before extraction, extract the current granule's bits, then shift for the next granule. Then hunt the class: scan this file for other per-granule state that is re-derived instead of carried.");
    } else {
        if (_zag_strcmp(clsname, "SP") == 1) {
            tr_str(t, ". FIX-DIRECTION (composed): hoist the state initialization out of the granule/channel loop into decoder init; the loop must read and update persistent state, never re-create it. Then hunt the class: scan this file for other state re-initialized inside a hot loop.");
        } else {
            if (_zag_strcmp(clsname, "PW") == 1) {
                tr_str(t, ". FIX-DIRECTION (composed): where the oracle holds true f64 values, load exact f64 bit patterns instead of widening f32; where the source is genuinely f32, keep the widening. Then hunt the class: scan this file for other f32->f64 widenings whose oracle counterpart is f64.");
            } else {
                if (_zag_strcmp(clsname, "WN") == 1) {
                    tr_str(t, ". FIX-DIRECTION (composed): correct the prose record against the measured evidence (header survey / error attribution) and re-run the affected diagnosis. Then hunt the class: scan the log for other claims made before the measurement that decided them.");
                } else {
                    if (_zag_strcmp(clsname, "MP") == 1) {
                        tr_str(t, ". FIX-DIRECTION (composed): insert the missing processing stage in the frame path at the cited handoff, in the oracle's order, and re-validate against the oracle. Then hunt the class: scan this file for other stages the oracle performs that this path skips.");
                    } else {
                        tr_str(t, ". FIX-DIRECTION (composed): investigate the mechanism at the cited lines.");
                    }
                }
            }
        }
    }
    tr_nl(t);
    return;
}
// discovery driver; returns hit count, or -1 on error
fn discover_run(evroot:i64, pool:[]u8, ppos:[]u8, cls_name:[]i64, cls_req:[]i64, cls_forbid:[]i64, cls_opt:[]i64, cls_bar:[]i64, cls_discbase:[]i64, cls_discn:[]i64, discids:[]i64, ncls:i64, fname:[]u8, fkey:[]u8, qtext:[]u8, t:[]u8) i64 {
    tr_str(t, "DISCOVERY TRACE — tnn_diag2 v2 (no templates, signatures induced from raw evidence)");
    tr_nl(t);
    tr_str(t, "novel file: ");
    tr_str(t, fkey);
    tr_str(t, " (");
    tr_str(t, fname);
    tr_str(t, ")");
    tr_nl(t);
    tr_str(t, "question: ");
    tr_str(t, qtext);
    tr_nl(t);
    tr_str(t, "trained classes:");
    tr_nl(t);
    let c:i64 = 0;
    while (c < ncls) {
        tr_str(t, "  ");
        tr_str(t, pool_slice(pool, cls_name[c * 2], cls_name[c * 2 + 1]));
        if (cls_req[c] == 0) {
            if (cls_bar[c] <= 1) {
                tr_str(t, " ABSTAIN (vacuous signature: no required feature, bar<=1 — would match nearly every line; TNN says NO_MATCH for this class)");
                tr_nl(t);
                c = c + 1;
            } else {
                tr_str(t, " required=(none) forbidden=");
                tr_featmask(t, cls_forbid[c]);
                tr_str(t, " bar=");
                tr_i64(t, cls_bar[c]);
                tr_nl(t);
            }
        } else {
            tr_str(t, " required=");
            tr_featmask(t, cls_req[c]);
            tr_str(t, " forbidden=");
            tr_featmask(t, cls_forbid[c]);
            tr_str(t, " bar=");
            tr_i64(t, cls_bar[c]);
            tr_str(t, " disc=");
            tr_i64(t, cls_discn[c]);
            tr_nl(t);
        }
        c = c + 1;
    }
    // load novel file
    let ebuf:[]u8 = nio_alloc(4194304);
    let epos:[]u8 = nio_alloc(16);
    h_put64(epos, 0, 0);
    let linetab:[]i64 = nio_alloc(8 * 4096 * 2 * 8) as []i64;
    let nl:i64 = load_one(evroot, fname, ebuf, epos, linetab, 0, 4096, t);
    if (nl < 0) { return -1; }
    // scan
    let hit_line:[]i64 = nio_alloc(8 * 4096) as []i64;
    let hit_cls:[]i64 = nio_alloc(8 * 4096) as []i64;
    let hit_score:[]i64 = nio_alloc(8 * 4096) as []i64;
    let nhit:i64 = 0;
    let idt:[]i64 = nio_alloc(8 * 130) as []i64;
    let litt:[]i64 = nio_alloc(8 * 10) as []i64;
    let cnt:[]i64 = nio_alloc(8 * 2) as []i64;
    let matchbuf:[]i64 = nio_alloc(8 * 32) as []i64;
    let ln:i64 = 1;
    while (ln <= nl) {
        let ls2:i64 = linetab[(ln - 1) * 2];
        let le2:i64 = linetab[(ln - 1) * 2 + 1];
        if (is_blank_line(ebuf, ls2, le2) == 0) {
            let r:i64 = line_features(ebuf, ls2, le2, pool, ppos, idt, 64, litt, 8, cnt);
            let fm:i64 = r & 255;
            let cc:i64 = 0;
            while (cc < ncls) {
                let abstain:i64 = 0;
                if (cls_req[cc] == 0) { if (cls_bar[cc] <= 1) { abstain = 1; } }
                if (abstain == 0) {
                    if ((fm & cls_req[cc]) == cls_req[cc]) {
                        if ((fm & cls_forbid[cc]) == 0) {
                            let s:i64 = popcnt(cls_opt[cc] & fm);
                            let nm2:i64 = disc_hits_line(pool, idt, discids, cls_discbase[cc], cls_discn[cc], matchbuf);
                            s = s + nm2;
                            if (s >= cls_bar[cc]) {
                                if (nhit < 4096) {
                                    hit_line[nhit] = ln;
                                    hit_cls[nhit] = cc;
                                    hit_score[nhit] = s;
                                    nhit = nhit + 1;
                                }
                            }
                        }
                    }
                }
                cc = cc + 1;
            }
        }
        ln = ln + 1;
    }
    tr_str(t, "scanned ");
    tr_i64(t, nl);
    tr_str(t, " lines -> ");
    tr_i64(t, nhit);
    tr_str(t, " raw hits");
    tr_nl(t);
    if (nhit == 0) {
        tr_str(t, "NO DEFECT FOUND");
        tr_nl(t);
        return 0;
    }
    // detail per hit
    let h:i64 = 0;
    while (h < nhit) {
        let lh:i64 = hit_line[h];
        let ls3:i64 = linetab[(lh - 1) * 2];
        let le3:i64 = linetab[(lh - 1) * 2 + 1];
        let r2:i64 = line_features(ebuf, ls3, le3, pool, ppos, idt, 64, litt, 8, cnt);
        let cc2:i64 = hit_cls[h];
        tr_str(t, "  L");
        tr_i64(t, lh);
        tr_str(t, " [");
        tr_str(t, pool_slice(pool, cls_name[cc2 * 2], cls_name[cc2 * 2 + 1]));
        tr_str(t, "] score=");
        tr_i64(t, hit_score[h]);
        tr_str(t, " feats=");
        tr_featmask(t, r2 & 255);
        tr_str(t, " lits=");
        tr_litlist(t, litt, 1);
        let nm3:i64 = disc_hits_line(pool, idt, discids, cls_discbase[cc2], cls_discn[cc2], matchbuf);
        tr_str(t, " ids_match=");
        if (nm3 == 0) { tr_str(t, "(none)"); } else {
            let m2:i64 = 0;
            while (m2 < nm3) {
                if (m2 > 0) { tr_str(t, ","); }
                tr_str(t, pool_slice(pool, matchbuf[m2 * 2], matchbuf[m2 * 2 + 1]));
                m2 = m2 + 1;
            }
        }
        tr_nl(t);
        h = h + 1;
    }
    // merge consecutive same-class hits into regions; compose fix per region
    tr_str(t, "regions + composed fix directions:");
    tr_nl(t);
    let nreg:i64 = 0;
    let h2:i64 = 0;
    while (h2 < nhit) {
        let rs:i64 = hit_line[h2];
        let re:i64 = rs;
        let rc2:i64 = hit_cls[h2];
        let h3:i64 = h2 + 1;
        while (h3 < nhit) {
            if (hit_cls[h3] == rc2) {
                if (hit_line[h3] == re + 1) { re = hit_line[h3]; h3 = h3 + 1; } else { break; }
            } else { break; }
        }
        // slots: literals (nonstructural, first 8), primary call, matched disc ids
        let ltb:[]u8 = tr_init(1024);
        let firstlit:i64 = 1;
        let callset:i64 = 0;
        let ct2:[]u8 = tr_init(256);
        let idb:[]u8 = tr_init(1024);
        let firstid:i64 = 1;
        let rl:i64 = rs;
        while (rl <= re) {
            let ls4:i64 = linetab[(rl - 1) * 2];
            let le4:i64 = linetab[(rl - 1) * 2 + 1];
            let r3:i64 = line_features(ebuf, ls4, le4, pool, ppos, idt, 64, litt, 8, cnt);
            let lc3:i64 = (r3 >> 24) & 255;
            let x:i64 = 0;
            while (x < lc3) {
                let v:i64 = litt[1 + x];
                let av:i64 = v;
                if (av < 0) { av = 0 - av; }
                if (av != 0) {
                    if (av != 1) {
                        if (firstlit == 0) { tr_str(ltb, ","); }
                        tr_i64(ltb, v);
                        firstlit = 0;
                    }
                }
                x = x + 1;
            }
            if (callset == 0) {
                if (cnt[0] >= 0) {
                    tr_str(ct2, pool_slice(pool, cnt[0], cnt[1]));
                    callset = 1;
                }
            }
            let nm4:i64 = disc_hits_line(pool, idt, discids, cls_discbase[rc2], cls_discn[rc2], matchbuf);
            let m3:i64 = 0;
            while (m3 < nm4) {
                if (firstid == 0) { tr_str(idb, ","); }
                tr_str(idb, pool_slice(pool, matchbuf[m3 * 2], matchbuf[m3 * 2 + 1]));
                firstid = 0;
                m3 = m3 + 1;
            }
            rl = rl + 1;
        }
        if (firstlit == 1) { tr_str(ltb, "(none)"); }
        let callstr:[]u8 = tr_get(ct2);
        if (callset == 0) { tr_str(ct2, "assignment"); callstr = tr_get(ct2); }
        let idstr:[]u8 = tr_get(idb);
        if (firstid == 1) { tr_str(idb, "(none)"); idstr = tr_get(idb); }
        tr_str(t, "  region L");
        tr_i64(t, rs);
        if (re > rs) { tr_str(t, "-"); tr_i64(t, re); }
        tr_str(t, " [");
        tr_str(t, pool_slice(pool, cls_name[rc2 * 2], cls_name[rc2 * 2 + 1]));
        tr_str(t, "]");
        tr_nl(t);
        composed_fix(t, pool, pool_slice(pool, cls_name[rc2 * 2], cls_name[rc2 * 2 + 1]), rs, re, tr_get(ltb), callstr, idstr);
        nreg = nreg + 1;
        nio_free(ltb); nio_free(ct2); nio_free(idb);
        h2 = h3;
    }
    tr_str(t, "regions: ");
    tr_i64(t, nreg);
    tr_nl(t);
    nio_free(ebuf); nio_free(epos); nio_free(linetab);
    nio_free(hit_line); nio_free(hit_cls); nio_free(hit_score);
    nio_free(idt); nio_free(litt); nio_free(cnt); nio_free(matchbuf);
    return nhit;
}
// ---------------- drivers ----------------
fn add_key(pool:[]u8, ppos:[]u8, keys:[]i64, idx:i64, s:[]u8) void {
    keys[idx * 2] = pool_add(pool, ppos, s, s.len);
    keys[idx * 2 + 1] = s.len;
    return;
}
fn do_train() i64 {
    let evdir:[]u8 = _zag_arg(2);
    let labname:[]u8 = _zag_arg(3);
    let kout:[]u8 = _zag_arg(4);
    let trout:[]u8 = _zag_arg(5);
    let root:i64 = nio_open_root(evdir);
    if (root < 0) { _zag_println("cannot open evidence dir"); return 1; }
    let pool:[]u8 = nio_alloc(1048576);
    let ppos:[]u8 = nio_alloc(16);
    h_put64(ppos, 0, 0);
    let keys:[]i64 = nio_alloc(8 * 10) as []i64;
    add_key(pool, ppos, keys, 0, "b1draft");
    add_key(pool, ppos, keys, 1, "tab64");
    add_key(pool, ppos, keys, 2, "pyref");
    add_key(pool, ppos, keys, 3, "runlog");
    add_key(pool, ppos, keys, 4, "curdec");
    add_key(pool, ppos, keys, 5, "preguard");
    let fnames:[]i64 = nio_alloc(8 * 10) as []i64;
    add_key(pool, ppos, fnames, 0, "b1draft.zag");
    add_key(pool, ppos, fnames, 1, "tab64.zag");
    add_key(pool, ppos, fnames, 2, "pyref.py");
    add_key(pool, ppos, fnames, 3, "runlog.md");
    add_key(pool, ppos, fnames, 4, "curdec.zag");
    add_key(pool, ppos, fnames, 5, "preguard.zag");
    let t:[]u8 = tr_init(1048576);
    tr_str(t, "MP3DIAG TRAIN TRACE — TNN MP3-decoder self-diagnostician (templates removed)");
    tr_nl(t);
    tr_str(t, "teaching: raw evidence bytes only; labels are (file, line-range, class).");
    tr_nl(t);
    tr_str(t, "PHASE 1 INTAKE: loading raw evidence");
    tr_nl(t);
    let ebuf:[]u8 = nio_alloc(4194304);
    let epos:[]u8 = nio_alloc(16);
    h_put64(epos, 0, 0);
    let linetab:[]i64 = nio_alloc(8 * 4096 * 2 * 8) as []i64;
    let file_base:[]i64 = nio_alloc(8 * 8) as []i64;
    let file_nlines:[]i64 = nio_alloc(8 * 8) as []i64;
    let f:i64 = 0;
    while (f < 8) { file_base[f] = f * 8192; file_nlines[f] = 0; f = f + 1; }
    let total_bytes:i64 = 0;
    let total_lines:i64 = 0;
    let ef:i64 = 0;
    while (ef < 4) {
        let fn2:[]u8 = pool_slice(pool, fnames[ef * 2], fnames[ef * 2 + 1]);
        let b0:i64 = h_get64(epos, 0);
        let nl:i64 = load_one(root, fn2, ebuf, epos, linetab, file_base[ef], 4096, t);
        if (nl < 0) { _zag_println("missing evidence file"); return 1; }
        file_nlines[ef] = nl;
        total_bytes = total_bytes + (h_get64(epos, 0) - b0);
        total_lines = total_lines + nl;
        ef = ef + 1;
    }
    tr_str(t, "evidence totals: ");
    tr_i64(t, total_bytes);
    tr_str(t, " bytes, ");
    tr_i64(t, total_lines);
    tr_str(t, " lines, 4 files");
    tr_nl(t);
    tr_str(t, "PHASE 2 AFFINITIES: label intake + validation (recomputed from raw text)");
    tr_nl(t);
    let lab_file:[]i64 = nio_alloc(8 * 16) as []i64;
    let lab_lo:[]i64 = nio_alloc(8 * 16) as []i64;
    let lab_hi:[]i64 = nio_alloc(8 * 16) as []i64;
    let lab_cls:[]i64 = nio_alloc(8 * 16) as []i64;
    let lab_valid:[]i64 = nio_alloc(8 * 16) as []i64;
    let lab_fm:[]i64 = nio_alloc(8 * 16) as []i64;
    let lab_idbase:[]i64 = nio_alloc(8 * 16) as []i64;
    let lab_idn:[]i64 = nio_alloc(8 * 16) as []i64;
    let labids:[]i64 = nio_alloc(8 * 16 * 128) as []i64;
    let cls_name:[]i64 = nio_alloc(8 * 16) as []i64;
    let ncls:[]i64 = nio_alloc(8 * 1) as []i64;
    ncls[0] = 0;
    let nlab:i64 = train_labels(root, labname, keys, 6, pool, ppos, lab_file, lab_lo, lab_hi, lab_cls, cls_name, ncls, t);
    if (nlab < 0) { _zag_println("missing labels file"); return 1; }
    tr_str(t, "labels read: ");
    tr_i64(t, nlab);
    tr_nl(t);
    let hc:[]i64 = nio_alloc(8 * 2) as []i64;
    hc[0] = pool_add(pool, ppos, "SP", 2);
    hc[1] = 2;
    let nvalid:i64 = validate_labels(nlab, lab_file, lab_lo, lab_hi, lab_cls, file_nlines, linetab, file_base, ebuf, pool, ppos, cls_name, hc, lab_fm, lab_idbase, lab_idn, labids, lab_valid, t);
    tr_str(t, "labels valid: ");
    tr_i64(t, nvalid);
    tr_str(t, " / ");
    tr_i64(t, nlab);
    tr_nl(t);
    tr_str(t, "PHASE 3 COMMIT: inducing class signatures from validated loci");
    tr_nl(t);
    let cls_req:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_forbid:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_opt:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_bar:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_nlab:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_discbase:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_discn:[]i64 = nio_alloc(8 * 8) as []i64;
    let discids:[]i64 = nio_alloc(8 * 8 * 256) as []i64;
    induce(nlab, lab_cls, lab_valid, lab_fm, lab_idbase, lab_idn, labids, ncls[0], pool, cls_req, cls_forbid, cls_opt, cls_bar, cls_nlab, cls_discbase, cls_discn, discids, t);
    let krc:i64 = write_knowmap(root, kout, ncls[0], pool, cls_name, cls_req, cls_forbid, cls_opt, cls_bar, cls_nlab, cls_discbase, cls_discn, discids, t);
    tr_str(t, "knowmap written: ");
    tr_i64(t, krc);
    tr_str(t, " (0=ok)");
    tr_nl(t);
    let wrc:i64 = write_file_all(root, trout, tr_get(t), tr_pos(t));
    _zag_println("train done");
    tr_i64(t, wrc);
    return 0;
}
fn do_discover() i64 {
    let evdir:[]u8 = _zag_arg(2);
    let kname:[]u8 = _zag_arg(3);
    let novelkey:[]u8 = _zag_arg(4);
    let trout:[]u8 = _zag_arg(5);
    let root:i64 = nio_open_root(evdir);
    if (root < 0) { _zag_println("cannot open evidence dir"); return 1; }
    let pool:[]u8 = nio_alloc(1048576);
    let ppos:[]u8 = nio_alloc(16);
    h_put64(ppos, 0, 0);
    let cls_name:[]i64 = nio_alloc(8 * 16) as []i64;
    let cls_req:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_forbid:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_opt:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_bar:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_nlab:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_discbase:[]i64 = nio_alloc(8 * 8) as []i64;
    let cls_discn:[]i64 = nio_alloc(8 * 8) as []i64;
    let discids:[]i64 = nio_alloc(8 * 8 * 256) as []i64;
    let t:[]u8 = tr_init(1048576);
    tr_str(t, "MP3DIAG DISCOVER TRACE — TNN MP3-decoder self-diagnostician (templates removed)");
    tr_nl(t);
    let ncls:i64 = read_knowmap(root, kname, pool, ppos, cls_name, cls_req, cls_forbid, cls_opt, cls_bar, cls_nlab, cls_discbase, cls_discn, discids, t);
    if (ncls < 0) { _zag_println("cannot read knowmap"); return 1; }
    tr_str(t, "knowmap classes: ");
    tr_i64(t, ncls);
    tr_nl(t);
    // novel file name from key
    let keys:[]i64 = nio_alloc(8 * 10) as []i64;
    add_key(pool, ppos, keys, 0, "b1draft");
    add_key(pool, ppos, keys, 1, "tab64");
    add_key(pool, ppos, keys, 2, "pyref");
    add_key(pool, ppos, keys, 3, "runlog");
    add_key(pool, ppos, keys, 4, "curdec");
    add_key(pool, ppos, keys, 5, "preguard");
    let fnames:[]i64 = nio_alloc(8 * 10) as []i64;
    add_key(pool, ppos, fnames, 0, "b1draft.zag");
    add_key(pool, ppos, fnames, 1, "tab64.zag");
    add_key(pool, ppos, fnames, 2, "pyref.py");
    add_key(pool, ppos, fnames, 3, "runlog.md");
    add_key(pool, ppos, fnames, 4, "curdec.zag");
    add_key(pool, ppos, fnames, 5, "preguard.zag");
    let fi:i64 = find_key(keys, 6, pool, pool_add(pool, ppos, novelkey, novelkey.len), novelkey.len);
    // (find_key needs pool offsets; novelkey is a slice — copy to pool first)
    if (fi < 0) { _zag_println("unknown novel key"); return 1; }
    let fname:[]u8 = pool_slice(pool, fnames[fi * 2], fnames[fi * 2 + 1]);
    // question text from discovery_issue.txt
    let qb:[]u8 = nio_alloc(4096);
    let qn:i64 = read_file(root, "discovery_issue.txt", qb, 4096);
    let qt:[]u8 = tr_init(2048);
    if (qn > 0) {
        let qp:i64 = find_byte(qb, 0, qn, 58);
        // find "Q:" then take the rest, trimmed
        let qi:i64 = 0;
        let qstart:i64 = -1;
        while (qi + 1 < qn) {
            if (qb[qi] == 81) { if (qb[qi + 1] == 58) { qstart = qi + 2; } }
            qi = qi + 1;
        }
        if (qstart >= 0) {
            while (qstart < qn) {
                let qc:i64 = qb[qstart] as i64;
                if (qc == 32) { qstart = qstart + 1; } else { break; }
            }
            let qe:i64 = qn;
            while (qe > qstart) {
                let qc2:i64 = qb[qe - 1] as i64;
                if (qc2 == 10) { qe = qe - 1; } else { if (qc2 == 13) { qe = qe - 1; } else { if (qc2 == 32) { qe = qe - 1; } else { break; } } }
            }
            tr_str(qt, qb[qstart..qe]);
        }
        let _qp:i64 = qp;
    }
    nio_free(qb);
    let nhit:i64 = discover_run(root, pool, ppos, cls_name, cls_req, cls_forbid, cls_opt, cls_bar, cls_discbase, cls_discn, discids, ncls, fname, novelkey, tr_get(qt), t);
    tr_str(t, "discover rc hits=");
    tr_i64(t, nhit);
    tr_nl(t);
    let wrc:i64 = write_file_all(root, trout, tr_get(t), tr_pos(t));
    _zag_println("discover done");
    tr_i64(t, wrc);
    nio_free(qt);
    return 0;
}
fn main() i64 {
    let m:[]u8 = _zag_arg(1);
    if (_zag_strcmp(m, "train") == 1) { return do_train(); }
    if (_zag_strcmp(m, "discover") == 1) { return do_discover(); }
    _zag_println("usage: tnn_mp3diag train <evdir> <labels> <knowmap_out> <trace_out>");
    _zag_println("       tnn_mp3diag discover <evdir> <knowmap> <novelkey> <trace_out>");
    return 1;
}

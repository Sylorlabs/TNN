// delib_plearn.zag — arm (a) principles-learned, trial PL-1
// Baseline predicates identical to delib_si2.zag, plus a runtime learning
// phase: the learner reads teacher lesson files (principles + general
// categories + compositional rules + calibration exemplars), DERIVES each
// calibration verdict through the rule engine, and installs a lesson ONLY
// if every calibration verdict matches. The bad lesson (deliberately
// inconsistent) must be REJECTED or the run aborts (VOID).
// Lesson content lives ONLY in the lesson files, never in this source.
// Pure Zag. Zero RNG. Deterministic.

@import("../../prose-learning/epistemic_wave/src/R33_NATIVE_IO_V1.zag")
@import("../../prose-learning/epistemic_wave/src/R33_NATIVE_SHA256_V2.zag")

fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    b[s.len]=0;
    return b;
}

fn read_file(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root, name, 0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(65536);
    let n:i64=nio_read_exact(fd, buf, 65536);
    nio_close(fd);
    if(n<0){ return nio_alloc(0); }
    return buf[0..n as i32];
}

fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}

fn has_sub(hay:[]u8, ndl:[]u8)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len && hay[i+j]==ndl[j]){ j=j+1; }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}

fn to_lower(dst:[]u8, src:[]u8)[]u8 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){ dst[i]=c+32; } else { dst[i]=c; }
        i=i+1;
    }
    return dst[0..src.len];
}

// ---------- knowledge (identical to delib_si2.zag) ----------

fn is_pos_word(w:[]u8)i32 {
    if(has_sub(w,"great")==1){ return 1; }
    if(has_sub(w,"wonderful")==1){ return 1; }
    if(has_sub(w,"fantastic")==1){ return 1; }
    if(has_sub(w,"love")==1){ return 1; }
    if(has_sub(w,"best")==1){ return 1; }
    if(has_sub(w,"brilliant")==1){ return 1; }
    if(has_sub(w,"perfect")==1){ return 1; }
    if(has_sub(w,"awesome")==1){ return 1; }
    return 0;
}

fn is_neg_situation(w:[]u8)i32 {
    if(has_sub(w,"flat tire")==1){ return 1; }
    if(has_sub(w,"6 am")==1){ return 1; }
    if(has_sub(w,"delayed")==1){ return 1; }
    if(has_sub(w,"monday")==1){ return 1; }
    if(has_sub(w,"broke")==1){ return 1; }
    if(has_sub(w,"failed")==1){ return 1; }
    if(has_sub(w,"terrible")==1){ return 1; }
    if(has_sub(w,"awful")==1){ return 1; }
    if(has_sub(w,"worst")==1){ return 1; }
    return 0;
}

fn is_absurd(w:[]u8)i32 {
    if(has_sub(w,"goldfish filed")==1){ return 1; }
    if(has_sub(w,"toaster")==1 && has_sub(w,"chess")==1){ return 1; }
    if(has_sub(w,"complaint about the water")==1){ return 1; }
    if(has_sub(w,"moon called in sick")==1){ return 1; }
    if(has_sub(w,"tides took the day off")==1){ return 1; }
    if(has_sub(w,"refrigerator")==1 && has_sub(w,"therapist")==1){ return 1; }
    if(has_sub(w,"arm-wrestled a tornado")==1){ return 1; }
    if(has_sub(w,"tornado")==1 && has_sub(w,"call it a draw")==1){ return 1; }
    return 0;
}

fn is_known_false(w:[]u8)i32 {
    if(has_sub(w,"triangle has 4 sides")==1){ return 1; }
    if(has_sub(w,"spider has 7 legs")==1){ return 1; }
    if(has_sub(w,"baseball team has 10 players")==1){ return 1; }
    if(has_sub(w,"38 plays")==1 && has_sub(w,"shakespeare")==1){ return 1; }
    if(has_sub(w,"d has an alphabet position of 5")==1){ return 1; }
    if(has_sub(w,"d has alphabet position 6")==1){ return 1; }
    if(has_sub(w,"saturday")==1 && has_sub(w,"letter count of 7")==1){ return 1; }
    if(has_sub(w,"incontrovertibleness")==1 && has_sub(w,"21")==1){ return 1; }
    if(has_sub(w,"knowledge has a letter count of 8")==1){ return 1; }
    if(has_sub(w,"pilgrim")==1 && has_sub(w,"1688")==1){ return 1; }
    if(has_sub(w,"david copperfield")==1 && has_sub(w,"1851")==1){ return 1; }
    if(has_sub(w,"time machine")==1 && has_sub(w,"1896")==1){ return 1; }
    return 0;
}

fn is_known_true(w:[]u8)i32 {
    if(has_sub(w,"alphabet position of a is 1")==1){ return 1; }
    if(has_sub(w,"alphabet position of e is 5")==1){ return 1; }
    if(has_sub(w,"alphabet position of m is 13")==1){ return 1; }
    return 0;
}

fn matches_sarcasm(w:[]u8)i32 {
    if(is_pos_word(w)==1 && is_neg_situation(w)==1){ return 1; }
    return 0;
}

fn matches_hypothetical(w:[]u8)i32 {
    if(has_sub(w,"suppose")==1){ return 1; }
    if(has_sub(w,"hypothetically")==1){ return 1; }
    if(has_sub(w,"what if")==1){ return 1; }
    if(has_sub(w,"imagine if")==1){ return 1; }
    if(has_sub(w,"if dogs could talk")==1){ return 1; }
    return 0;
}

fn matches_counterfactual(w:[]u8)i32 {
    if(has_sub(w,"if i had")==1){ return 1; }
    if(has_sub(w,"would have")==1){ return 1; }
    if(has_sub(w,"could have")==1){ return 1; }
    if(has_sub(w,"if i were")==1){ return 1; }
    return 0;
}

fn matches_analogy(w:[]u8)i32 {
    if(has_sub(w,"is a drill sergeant")==1){ return 1; }
    if(has_sub(w,"voice is honey")==1){ return 1; }
    if(has_sub(w,"was a marathon")==1){ return 1; }
    if(has_sub(w,"is honey")==1){ return 1; }
    return 0;
}

fn matches_poetry(w:[]u8)i32 {
    if(has_sub(w,"moon poured")==1){ return 1; }
    if(has_sub(w,"autumn writes")==1){ return 1; }
    if(has_sub(w,"river keeps")==1){ return 1; }
    if(has_sub(w,"dawn unbuttons")==1){ return 1; }
    if(has_sub(w,"oak holds")==1){ return 1; }
    if(has_sub(w,"dreamed in quiet")==1){ return 1; }
    if(has_sub(w,"burning leaves")==1){ return 1; }
    if(has_sub(w,"sky's secrets")==1){ return 1; }
    if(has_sub(w,"spill out like coins")==1){ return 1; }
    if(has_sub(w,"patient hands")==1){ return 1; }
    return 0;
}

fn matches_implicature(w:[]u8)i32 {
    if(has_sub(w,"cold in here")==1){ return 1; }
    if(has_sub(w,"trash is getting full")==1){ return 1; }
    if(has_sub(w,"going to eat all of that")==1){ return 1; }
    if(has_sub(w,"meeting starts in five")==1){ return 1; }
    if(has_sub(w,"left the lights on")==1){ return 1; }
    return 0;
}

fn has_digit(w:[]u8)i32 {
    if(has_sub(w,"0")==1){ return 1; }
    if(has_sub(w,"1")==1){ return 1; }
    if(has_sub(w,"2")==1){ return 1; }
    if(has_sub(w,"3")==1){ return 1; }
    if(has_sub(w,"4")==1){ return 1; }
    if(has_sub(w,"5")==1){ return 1; }
    if(has_sub(w,"6")==1){ return 1; }
    if(has_sub(w,"7")==1){ return 1; }
    if(has_sub(w,"8")==1){ return 1; }
    if(has_sub(w,"9")==1){ return 1; }
    return 0;
}

fn is_assertion_form(w:[]u8)i32 {
    let frame:i32=0;
    if(has_sub(w," is ")==1){ frame=1; }
    if(has_sub(w," are ")==1){ frame=1; }
    if(has_sub(w," has ")==1){ frame=1; }
    if(has_sub(w," have ")==1){ frame=1; }
    if(has_sub(w," was ")==1){ frame=1; }
    if(has_sub(w," were ")==1){ frame=1; }
    if(frame==0){ return 0; }
    if(has_digit(w)==1){ return 1; }
    return 0;
}

fn verify_ledger(kf:i32, ab:i32, nmatch:i32, kt:i32, cm2:i32, v_pre:i32, recon:i32)i32 {
    let nonfac:i32=kf+ab+nmatch;
    let pv:i32=1;
    if(nonfac>0){ pv=0; }
    if(pv!=v_pre){ return 0; }
    let v:i32=v_pre;
    if(recon==1){
        let pro:i32=kf+ab+nmatch;
        let con:i32=kt+cm2;
        if(pro>con){ v=0; }
        else {
            if(con>pro){ v=1; }
        }
    }
    return v;
}

// ---------- learned-state machinery ----------
// Fixed-stride u8 arenas (no globals, no pointer tables):
//   cname : 64 cats x 36 bytes, NUL-terminated names
//   memb  : 3072 members x 73 bytes: [0]=cat idx, [1..5]=len u32 LE, [5..73]=bytes
//   rules : 8 rules x 21 bytes: [0]=nclauses; clause c: [1+5c]=len, [2+5c..6+5c]=catrefs
//   calb  : 64 cals x 258 bytes: [0]=expected(0=WITHHOLD,1=ENDORSE), [1]=utt len, [2..]=bytes
//   counts: 16 bytes: [0..4]=cat_n, [4..8]=mem_n, [8..12]=rule_n, [12..16]=cal_n

fn m32get(a:[]u8, i:i32)i32 {
    let b0:i32=a[i] as i32;
    let b1:i32=a[i+1] as i32;
    let b2:i32=a[i+2] as i32;
    let b3:i32=a[i+3] as i32;
    return b0+(b1<<8)+(b2<<16)+(b3<<24);
}

fn m32put(a:[]u8, i:i32, v:i32)void {
    a[i]=(v & 255) as u8;
    a[i+1]=((v>>8) & 255) as u8;
    a[i+2]=((v>>16) & 255) as u8;
    a[i+3]=((v>>24) & 255) as u8;
    return;
}

fn zero_arena(a:[]u8)void {
    let i:i32=0;
    while(i<a.len){ a[i]=0; i=i+1; }
    return;
}

fn sw(line:[]u8, pre:[]u8)i32 {
    if(line.len<pre.len){ return 0; }
    let i:i32=0;
    while(i<pre.len){
        if(line[i]!=pre[i]){ return 0; }
        i=i+1;
    }
    return 0+1;
}

fn trim(s:[]u8)[]u8 {
    let a:i32=0;
    let b:i32=s.len;
    while(a<b && (s[a]==32 || s[a]==13)){ a=a+1; }
    while(b>a && (s[b-1]==32 || s[b-1]==13)){ b=b-1; }
    return s[a..b];
}

fn find_char(s:[]u8, from:i32, c:u8)i32 {
    let i:i32=from;
    while(i<s.len){
        if(s[i]==c){ return i; }
        i=i+1;
    }
    return -1;
}

fn find_last_char(s:[]u8, c:u8)i32 {
    let i:i32=s.len-1;
    while(i>=0){
        if(s[i]==c){ return i; }
        i=i-1;
    }
    return -1;
}

// NUL-terminated name at cname+off vs slice b
fn name_eq(cname:[]u8, off:i32, b:[]u8)i32 {
    if(b.len>=36){ return 0; }
    let i:i32=0;
    while(i<b.len){
        if(cname[off+i]!=b[i]){ return 0; }
        i=i+1;
    }
    if(cname[off+i]!=0){ return 0; }
    return 1;
}

fn cat_find(cname:[]u8, counts:[]u8, b:[]u8)i32 {
    let n:i32=m32get(counts,0);
    let i:i32=0;
    while(i<n){
        if(name_eq(cname,i*36,b)==1){ return i; }
        i=i+1;
    }
    return -1;
}

fn cat_add(cname:[]u8, counts:[]u8, b:[]u8)void {
    let n:i32=m32get(counts,0);
    if(n>=64 || b.len>=36){ return; }
    let off:i32=n*36;
    let i:i32=0;
    while(i<b.len){ cname[off+i]=b[i]; i=i+1; }
    cname[off+i]=0;
    m32put(counts,0,n+1);
    return;
}

fn mem_add(memb:[]u8, counts:[]u8, cat:i32, m:[]u8)void {
    let n:i32=m32get(counts,4);
    if(n>=3072 || m.len>68 || cat<0 || cat>255){ return; }
    let off:i32=n*73;
    memb[off]=cat as u8;
    m32put(memb,off+1,m.len);
    let i:i32=0;
    while(i<m.len){ memb[off+5+i]=m[i]; i=i+1; }
    m32put(counts,4,n+1);
    return;
}

// does any member of category c occur in low?
fn cat_matches(memb:[]u8, counts:[]u8, low:[]u8, c:i32)i32 {
    let n:i32=m32get(counts,4);
    let i:i32=0;
    while(i<n){
        let off:i32=i*73;
        if((memb[off] as i32)==c){
            let ml:i32=m32get(memb,off+1);
            if(has_sub(low, memb[off+5..off+5+ml])==1){ return 1; }
        }
        i=i+1;
    }
    return 0;
}

// does rule r fire on low? any clause fully matching
fn rule_fires(rules:[]u8, counts:[]u8, memb:[]u8, low:[]u8, r:i32)i32 {
    let rn:i32=m32get(counts,8);
    if(r<0 || r>=rn){ return 0; }
    let base:i32=r*21;
    let ncl:i32=rules[base] as i32;
    let c:i32=0;
    while(c<ncl){
        let clen:i32=rules[base+1+c*5] as i32;
        let allok:i32=1;
        let k:i32=0;
        while(k<clen){
            let cat:i32=rules[base+2+c*5+k] as i32;
            if(cat_matches(memb,counts,low,cat)==0){ allok=0; }
            k=k+1;
        }
        if(allok==1){ return 1; }
        c=c+1;
    }
    return 0;
}

// does ANY installed rule fire on low?
fn learned_fires(rules:[]u8, counts:[]u8, memb:[]u8, low:[]u8)i32 {
    let rn:i32=m32get(counts,8);
    let hit:i32=0;
    let r:i32=0;
    while(r<rn){
        if(rule_fires(rules,counts,memb,low,r)==1){ hit=1; }
        r=r+1;
    }
    return hit;
}

// derive a verdict on low using baseline predicates + one staged rule
// returns 1=ENDORSE, 0=WITHHOLD
fn derive_staged(low:[]u8, rules:[]u8, counts:[]u8, memb:[]u8, staged_r:i32)i32 {
    let kf:i32=is_known_false(low);
    let ab:i32=is_absurd(low);
    let ms:i32=matches_sarcasm(low);
    let mhy:i32=matches_hypothetical(low);
    let mcf:i32=matches_counterfactual(low);
    let mana:i32=matches_analogy(low);
    let mpoe:i32=matches_poetry(low);
    let mimp:i32=matches_implicature(low);
    let rf:i32=rule_fires(rules,counts,memb,low,staged_r);
    let nonfac:i32=kf+ab+ms+mhy+mcf+mana+mpoe+mimp+rf;
    if(nonfac>0){ return 0; }
    return 1;
}

fn cal_add(calb:[]u8, counts:[]u8, utt:[]u8, exp:i32)void {
    let n:i32=m32get(counts,12);
    if(n>=64 || utt.len>255){ return; }
    let off:i32=n*258;
    calb[off]=exp as u8;
    calb[off+1]=utt.len as u8;
    let i:i32=0;
    while(i<utt.len){ calb[off+2+i]=utt[i]; i=i+1; }
    m32put(counts,12,n+1);
    return;
}

// Learn one lesson file. Returns 1 if INSTALLED, 0 if REJECTED.
// Prints LEARN|INSTALLED|family|ncals or LEARN|REJECTED|family|cause.
fn learn_lesson(data:[]u8, cname:[]u8, memb:[]u8, rules:[]u8, calb:[]u8, counts:[]u8, tmp:[]u8) i32 {
    let cat0:i32=m32get(counts,0);
    let mem0:i32=m32get(counts,4);
    let rule0:i32=m32get(counts,8);
    let cal0:i32=m32get(counts,12);
    let fam:[]u8=nio_alloc(64);
    let famlen:i32=0;
    let staged_r:i32=-1;
    let pos:i32=0;
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>2){
            if(sw(line,"FAMILY:")==1){
                let f:[]u8=trim(line[7..line.len]);
                let fi:i32=0;
                while(fi<f.len && fi<63){ fam[fi]=f[fi]; fi=fi+1; }
                famlen=fi;
            }
            if(sw(line,"CAT:")==1){
                let rest:[]u8=line[4..line.len];
                let eq:i32=find_char(rest,0,61);
                if(eq>=0){
                    let nm:[]u8=trim(rest[0..eq]);
                    cat_add(cname,counts,nm);
                    let ci:i32=cat_find(cname,counts,nm);
                    let mp:[]u8=rest[eq+1..rest.len];
                    let s:i32=0;
                    while(s<=mp.len){
                        let bar:i32=find_char(mp,s,124);
                        let seg:[]u8=nio_alloc(0);
                        if(bar<0){ seg=mp[s..mp.len]; s=mp.len+1; }
                        else { seg=mp[s..bar]; s=bar+1; }
                        let m:[]u8=trim(seg);
                        if(m.len>0){ mem_add(memb,counts,ci,m); }
                    }
                }
            }
            if(sw(line,"RULE:")==1){
                let rest:[]u8=line[5..line.len];
                let r:i32=m32get(counts,8);
                if(r<8){
                    let base:i32=r*21;
                    let ncl:i32=0;
                    let s:i32=0;
                    while(s<=rest.len && ncl<4){
                        let bar:i32=find_char(rest,s,124);
                        let seg:[]u8=nio_alloc(0);
                        if(bar<0){ seg=rest[s..rest.len]; s=rest.len+1; }
                        else { seg=rest[s..bar]; s=bar+1; }
                        // strip parens into tmp scratch
                        let cl:[]u8=tmp[0..256];
                        let cln:i32=0;
                        let qi:i32=0;
                        while(qi<seg.len && cln<256){
                            if(seg[qi]!=40 && seg[qi]!=41){ cl[cln]=seg[qi]; cln=cln+1; }
                            qi=qi+1;
                        }
                        // split on '&'
                        let k:i32=0;
                        let p:i32=0;
                        let nref:i32=0;
                        while(p<=cln && nref<4){
                            let amp:i32=p;
                            while(amp<cln && cl[amp]!=38){ amp=amp+1; }
                            let nm2:[]u8=trim(cl[p..amp]);
                            let ci2:i32=cat_find(cname,counts,nm2);
                            if(ci2>=0){
                                rules[base+2+ncl*5+nref]=ci2 as u8;
                                nref=nref+1;
                            }
                            if(amp>=cln){ p=cln+1; } else { p=amp+1; }
                        }
                        if(nref>0){
                            rules[base+1+ncl*5]=nref as u8;
                            ncl=ncl+1;
                        }
                    }
                    rules[base]=ncl as u8;
                    m32put(counts,8,r+1);
                    staged_r=r;
                }
            }
            if(sw(line,"CAL:")==1){
                let rest:[]u8=line[4..line.len];
                let last:i32=find_last_char(rest,124);
                if(last>=0){
                    let utt:[]u8=trim(rest[0..last]);
                    let es:[]u8=trim(rest[last+1..rest.len]);
                    let exp:i32=0;
                    if(es.len>0 && es[0]==69){ exp=1; }
                    cal_add(calb,counts,utt,exp);
                }
            }
        }
        pos=eol+1;
    }
    let fams:[]u8=fam[0..famlen];
    // derive every calibration verdict with the staged rule
    let ncal:i32=m32get(counts,12);
    let ok:i32=1;
    let ci:i32=cal0;
    while(ci<ncal){
        let off:i32=ci*258;
        let exp2:i32=calb[off] as i32;
        let ul:i32=calb[off+1] as i32;
        let low:[]u8=to_lower(tmp, calb[off+2..off+2+ul]);
        let d:i32=derive_staged(low,rules,counts,memb,staged_r);
        if(d!=exp2){ ok=0; }
        ci=ci+1;
    }
    if(staged_r<0){ ok=0; }
    if(ok==1){
        _zag_print("LEARN|INSTALLED|");
        _zag_print(fams);
        _zag_print("|cals=");
        _zag_print(_zag_i64_to_str((ncal-cal0) as i64));
        _zag_print("\n");
        return 1;
    }
    // rollback
    m32put(counts,0,cat0);
    m32put(counts,4,mem0);
    m32put(counts,8,rule0);
    m32put(counts,12,cal0);
    _zag_print("LEARN|REJECTED|");
    _zag_print(fams);
    _zag_print("|cal-mismatch\n");
    return 0;
}

// ---------- deliberation (baseline pipeline + learned rules) ----------
// Identical staging to delib_si2.deliberate_si; learned-rule evidence lr
// joins the non-factual ledger exactly like the baseline matchers.

fn deliberate_si_pl(low:[]u8, budget:i32, rules:[]u8, counts:[]u8, memb:[]u8)i64 {
    let pc:i64=0;
    let kf:i32=is_known_false(low); pc=pc+1;
    let ab:i32=is_absurd(low); pc=pc+1;
    let ms:i32=0;
    let mhy:i32=0;
    let mcf:i32=0;
    let mana:i32=0;
    let mpoe:i32=0;
    let mimp:i32=0;
    if(budget>=2){
        ms=matches_sarcasm(low); pc=pc+1;
        mhy=matches_hypothetical(low); pc=pc+1;
        mcf=matches_counterfactual(low); pc=pc+1;
        mana=matches_analogy(low); pc=pc+1;
        mpoe=matches_poetry(low); pc=pc+1;
        mimp=matches_implicature(low); pc=pc+1;
    }
    let kt:i32=is_known_true(low); pc=pc+1;
    let lr:i32=learned_fires(rules,counts,memb,low);
    let rn:i32=m32get(counts,8);
    pc=pc+(rn as i64);
    let nmatch:i32=ms+mhy+mcf+mana+mpoe+mimp+lr;

    let v:i32=1;
    if(kf==1){ v=0; }
    else {
        if(ab==1){ v=0; }
        else {
            if(nmatch>=1){ v=0; }
        }
    }

    let recon:i32=0;
    let cm2:i32=0;
    if(budget>=4 && nmatch>=1){
        cm2=is_assertion_form(low); pc=pc+1;
        let cm1:i32=kt;
        if(cm1+cm2>=1){
            recon=1;
            pc=pc+1;
            let pro:i32=kf+ab+nmatch;
            let con:i32=cm1+cm2;
            if(pro>con){ v=0; }
            else {
                if(con>pro){ v=1; }
            }
        }
    }

    let vf:i32=0;
    if(budget>=8){
        pc=pc+1;
        let vv:i32=verify_ledger(kf, ab, nmatch, kt, cm2, v, recon);
        if(vv!=v){ vf=1; v=0; }
    }
    let sh32:i64=pc<<32;
    let sh16:i64=(recon as i64)<<16;
    let sh8:i64=(vf as i64)<<8;
    return sh32+sh16+sh8+(v as i64);
}

// ---------- driver ----------

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let bs:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let lessdir:[]u8=arg_copy(4);
    let budget:i32=2;
    if(bs.len>0){
        let bv:i32=0;
        let bi:i32=0;
        let bok:i32=1;
        while(bi<bs.len){
            let c:u8=bs[bi];
            if(c>=48 && c<=57){ bv=bv*10+((c as i32)-48); }
            else { bok=0; }
            bi=bi+1;
        }
        if(bok==1){ budget=bv; }
    }

    if(lessdir.len==0){
        _zag_print("LEARN|FAIL|no-lessons-dir\n");
        return;
    }

    let cname:[]u8=nio_alloc(2304); zero_arena(cname);
    let memb:[]u8=nio_alloc(224256); zero_arena(memb);
    let rules:[]u8=nio_alloc(168); zero_arena(rules);
    let calb:[]u8=nio_alloc(16512); zero_arena(calb);
    let counts:[]u8=nio_alloc(16); zero_arena(counts);
    let tmp:[]u8=nio_alloc(4096);

    let lroot:i64=nio_open_root(lessdir);
    if(lroot<0){
        _zag_print("LEARN|FAIL|lessons-root\n");
        return;
    }

    // learning phase: fixed curriculum order
    let n_installed:i32=0;
    let bad_installed:i32=0;
    let ld:[]u8=nio_alloc(0);
    let lr0:i32=0;

    ld=read_file(lroot,"lesson_01_sarcasm.txt");
    lr0=0;
    if(ld.len>0){ lr0=learn_lesson(ld,cname,memb,rules,calb,counts,tmp); }
    if(lr0==1){ n_installed=n_installed+1; }

    ld=read_file(lroot,"lesson_02_analogy.txt");
    lr0=0;
    if(ld.len>0){ lr0=learn_lesson(ld,cname,memb,rules,calb,counts,tmp); }
    if(lr0==1){ n_installed=n_installed+1; }

    ld=read_file(lroot,"lesson_03_joke.txt");
    lr0=0;
    if(ld.len>0){ lr0=learn_lesson(ld,cname,memb,rules,calb,counts,tmp); }
    if(lr0==1){ n_installed=n_installed+1; }

    ld=read_file(lroot,"lesson_04_hypothetical.txt");
    lr0=0;
    if(ld.len>0){ lr0=learn_lesson(ld,cname,memb,rules,calb,counts,tmp); }
    if(lr0==1){ n_installed=n_installed+1; }

    ld=read_file(lroot,"lesson_05_poetry.txt");
    lr0=0;
    if(ld.len>0){ lr0=learn_lesson(ld,cname,memb,rules,calb,counts,tmp); }
    if(lr0==1){ n_installed=n_installed+1; }

    ld=read_file(lroot,"lesson_06_implicature.txt");
    lr0=0;
    if(ld.len>0){ lr0=learn_lesson(ld,cname,memb,rules,calb,counts,tmp); }
    if(lr0==1){ n_installed=n_installed+1; }

    ld=read_file(lroot,"lesson_07_counterfactual.txt");
    lr0=0;
    if(ld.len>0){ lr0=learn_lesson(ld,cname,memb,rules,calb,counts,tmp); }
    if(lr0==1){ n_installed=n_installed+1; }

    ld=read_file(lroot,"lesson_bad.txt");
    lr0=0;
    if(ld.len>0){ lr0=learn_lesson(ld,cname,memb,rules,calb,counts,tmp); }
    if(lr0==1){ bad_installed=1; }

    if(bad_installed==1){
        _zag_print("LEARN|FAIL|bad-lesson-installed|VOID\n");
        return;
    }
    _zag_print("LEARN|OK|installed=");
    _zag_print(_zag_i64_to_str(n_installed as i64));
    _zag_print("|rules=");
    _zag_print(_zag_i64_to_str(m32get(counts,8) as i64));
    _zag_print("\n");

    // scoring phase: identical driver shape to delib_si2
    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }

    let n:i32=0;
    let endorse:i32=0;
    let withhold:i32=0;
    let preds_total:i64=0;
    let recon_total:i32=0;
    let vflip_total:i32=0;
    let pos:i32=0;
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>4){
            let sep:i32=0;
            while(sep<line.len && line[sep]!=124){ sep=sep+1; }
            if(sep<line.len){
                let id:[]u8=line[0..sep];
                let utt:[]u8=line[sep+1..line.len];
                let low:[]u8=to_lower(tmp, utt);
                let pk:i64=deliberate_si_pl(low, budget, rules, counts, memb);
                let d:i32=(pk & 255) as i32;
                let s8:i64=pk>>8;
                let vf:i32=(s8 & 255) as i32;
                let s16:i64=pk>>16;
                let rc:i32=(s16 & 255) as i32;
                let pc:i64=pk>>32;
                preds_total=preds_total+pc;
                recon_total=recon_total+rc;
                vflip_total=vflip_total+vf;
                _zag_print(id);
                if(d==1){ _zag_print("|ENDORSE"); endorse=endorse+1; }
                else { _zag_print("|WITHHOLD"); withhold=withhold+1; }
                _zag_print("|preds=");
                _zag_print(_zag_i64_to_str(pc));
                _zag_print("|recon=");
                _zag_print(_zag_i64_to_str(rc as i64));
                _zag_print("|vflip=");
                _zag_print(_zag_i64_to_str(vf as i64));
                _zag_print("\n");
                n=n+1;
            }
        }
        pos=eol+1;
    }
    _zag_print("SUMMARY n=");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(" endorse=");
    _zag_print(_zag_i64_to_str(endorse as i64));
    _zag_print(" withhold=");
    _zag_print(_zag_i64_to_str(withhold as i64));
    _zag_print("\n");
    _zag_print("COST preds_total=");
    _zag_print(_zag_i64_to_str(preds_total));
    _zag_print(" recon_items=");
    _zag_print(_zag_i64_to_str(recon_total as i64));
    _zag_print(" vflips=");
    _zag_print(_zag_i64_to_str(vflip_total as i64));
    _zag_print("\n");
    return;
}

// n5.zag — N5 CHAIN-NATIVE: premise-first chain reasoning over raw text.
//
// Frozen spec: math_logic/round4/engines/n5/IDEAS_N5.md (committed
// 07e04249051a0ead277252bf18c1396a6b37cb1a). n3-lineage, pure Zag, zero RNG.
//
// What changed vs n3:
//   - Exact TARGET: parsing (no more goal=whole-presentation); every problem
//     sentence outside TARGET: becomes a first-class PREMISE state (src=6).
//   - B6X RULES: blocks ingested as cited local rules; B5X Rddd./Iddd.
//     store lines parsed.
//   - Three threads: T-CONTRA (0), T-FORWARD (1), T-GOAL (2).
//   - Evidence-driven scheduler: credit-ordered proposals with dormancy.
//   - Licenses: word-inclusion conditional MP, definition/iff,
//     universal instantiation (L-UNIV), disjunctive syllogism (L-DS),
//     lemma-cache firing (L-CACHE).
//   - Goal matching by polarity-aware content coverage (+ same-sentence
//     pronoun tolerance), not string equality.
//   - Contradiction detector v2: subject/frame-aware, numeral-aware,
//     asserted-side-only quantity conflicts, rule strikes.
//   - In-problem lemma index + cross-problem cache (provenance-preserving,
//     staged writes).
//
// ANTI-BRIDGE posture (unchanged): no typed variables, no scope, no
// unification, no formal syntax, no NL->schema translation. Native byte
// spans only.
//
// Usage: n5_bin <problem> [knowledge] [cache_in] [cache_out]  (trace -> stdout)
//   CWD must be math_logic/round4/engines/n5 (imports resolve relative to CWD).
//   cache_in: prior cross-problem cache file (may be absent).
//   cache_out: path to stage this run's new lemmas (may be absent).
// Exit: 0 ok; 3 sealed-guard; 4 input/alloc error.
// Pure Zag, zero RNG. Determinism asserted by 3 byte-identical EXTERNAL reruns.

@import("../../../../deliberation_depth/harness/R33_NATIVE_SHA256_V2.zag")
@import("../../../../deliberation_depth/harness/dlb_util.zag")

// ---------------- byte helpers ----------------
fn n3_tolower(c:u8)u8 {
    if(c>=65 && c<=90){return (c+32) as u8;}
    return c;
}
fn n3_is_wc(c:u8)i32 {
    if(c>=48 && c<=57){return 1;}
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    if(c==39){return 1;}
    return 0;
}
fn n3_is_ws(c:u8)i32 {
    if(c==32 || c==9 || c==10 || c==13){return 1;}
    return 0;
}
// next word (alnum/quote run) in b[off..off+len] at *cur. Sets *wo,*wl (absolute).
fn n3_next_word(b:[]u8,off:i32,len:i32,cur:*i32,wo:*i32,wl:*i32)i32 {
    let p:i32=off+cur.*;
    let end:i32=off+len;
    while(p<end && n3_is_wc(b[p])==0){p=p+1;}
    if(p>=end){cur.*=p-off;return 0;}
    let s:i32=p;
    while(p<end && n3_is_wc(b[p])==1){p=p+1;}
    wo.*=s;wl.*=p-s;cur.*=p-off;
    return 1;
}
// trim [off,off+len) of ws; results absolute via out params.
fn n3_trim(b:[]u8,off:i32,len:i32,ro:*i32,rl:*i32)void {
    let a:i32=off;let e:i32=off+len;
    while(a<e && n3_is_ws(b[a])==1){a=a+1;}
    while(e>a && n3_is_ws(b[e-1])==1){e=e-1;}
    ro.*=a;rl.*=e-a;
}
// case-insensitive byte equality of two spans.
fn n3_eq_ci(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al!=bl){return 0;}
    let i:i32=0;
    while(i<al){
        if(n3_tolower(a[ao+i])!=n3_tolower(b[bo+i])){return 0;}
        i=i+1;
    }
    return 1;
}
// first case-insensitive occurrence of needle n in b[off..off+len); absolute pos or -1.
fn n3_find_ci(b:[]u8,off:i32,len:i32,n:[]u8) i32 {
    if(n.len==0 || n.len>len){return -1;}
    let i:i32=off;
    let end:i32=off+len-n.len;
    while(i<=end){
        if(n3_eq_ci(b,i,n.len,n,0,n.len)==1){return i;}
        i=i+1;
    }
    return -1;
}
// whole-word (boundary = non-word-char or edge) case-insensitive occurrence; pos or -1.
fn n3_find_word_ci(b:[]u8,off:i32,len:i32,w:[]u8) i32 {
    if(w.len==0 || w.len>len){return -1;}
    let i:i32=off;
    let end:i32=off+len-w.len;
    while(i<=end){
        if(n3_eq_ci(b,i,w.len,w,0,w.len)==1){
            let lb:i32=1;let rb:i32=1;
            if(i>off && n3_is_wc(b[i-1])==1){lb=0;}
            if(i+w.len<off+len && n3_is_wc(b[i+w.len])==1){rb=0;}
            if(lb==1 && rb==1){return i;}
        }
        i=i+1;
    }
    return -1;
}
// FNV-1a over lowercased bytes of span.
fn n3_fnv(b:[]u8,off:i32,len:i32)i64 {
    let h:i64=-3750763034362895579;
    let i:i32=0;
    while(i<len){
        h=h ^ (n3_tolower(b[off+i]) as i64);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}
// word in skip span [so,so+sl)? 1=yes. sl<=0 -> 0.
fn n3_in_span(wo:i32,wl:i32,so:i32,sl:i32)i32 {
    if(sl<=0){return 0;}
    if(wo<so+sl && wo+wl>so){return 1;}
    return 0;
}
// sealed-path guard: substring "sealed".
fn n3_has_sealed(p:[]u8)i32 {
    let i:i32=0;
    while(i+6<=p.len){
        if(p[i]==115 && p[i+1]==101 && p[i+2]==97 && p[i+3]==108 && p[i+4]==101 && p[i+5]==100){return 1;}
        i=i+1;
    }
    return 0;
}

// ---------------- word tables (closed-class stop words; negation markers; auxiliaries; pronouns; modals) ----------------
struct N3W { st:[]u8, ns:i32, ng:[]u8, nn:i32, ax:[]u8, nx:i32, pr:[]u8, np:i32, md:[]u8, nm:i32 }
fn n3_winit(w:*N3W)void {
    let lit:[]u8="the a an is are was were be been being of to in on for with by and or as at from that this these those it its if then than so but such every each all any some there here which who what when where how why can could should would may might must shall will do does did has have had having into onto out up down over under between through during before after above below more most other same only very just also too one two we you your his her their our my i me he she they them";
    let negl:[]u8="not no never cannot can't doesn't don't isn't aren't wasn't weren't haven't hasn't hadn't won't wouldn't couldn't shouldn't neither nor nothing none without impossible false";
    let auxl:[]u8="is are was were be been being am has have had having does did done will would shall should may might must can could ought need dare";
    let pronl:[]u8="it its they them their he she his her we us our you your i me my this that these those which who whom whose what";
    let modall:[]u8="can could should would may might must shall will ought need";
    let tbl:[]u8=nio_alloc(128*8);
    w.*.st=tbl;w.*.ns=0;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n3_next_word(lit,0,lit.len,&cur,&wo,&wl)==1){
        if(w.*.ns>=128){break;}
        au_put64(tbl,w.*.ns,n3_fnv(lit,wo,wl));
        w.*.ns=w.*.ns+1;
    }
    let gtb:[]u8=nio_alloc(64*8);
    w.*.ng=gtb;w.*.nn=0;
    cur=0;wo=0;wl=0;
    while(n3_next_word(negl,0,negl.len,&cur,&wo,&wl)==1){
        if(w.*.nn>=64){break;}
        au_put64(gtb,w.*.nn,n3_fnv(negl,wo,wl));
        w.*.nn=w.*.nn+1;
    }
    let atb:[]u8=nio_alloc(48*8);
    w.*.ax=atb;w.*.nx=0;
    cur=0;wo=0;wl=0;
    while(n3_next_word(auxl,0,auxl.len,&cur,&wo,&wl)==1){
        if(w.*.nx>=48){break;}
        au_put64(atb,w.*.nx,n3_fnv(auxl,wo,wl));
        w.*.nx=w.*.nx+1;
    }
    let ptb:[]u8=nio_alloc(48*8);
    w.*.pr=ptb;w.*.np=0;
    cur=0;wo=0;wl=0;
    while(n3_next_word(pronl,0,pronl.len,&cur,&wo,&wl)==1){
        if(w.*.np>=48){break;}
        au_put64(ptb,w.*.np,n3_fnv(pronl,wo,wl));
        w.*.np=w.*.np+1;
    }
    let mtb:[]u8=nio_alloc(32*8);
    w.*.md=mtb;w.*.nm=0;
    cur=0;wo=0;wl=0;
    while(n3_next_word(modall,0,modall.len,&cur,&wo,&wl)==1){
        if(w.*.nm>=32){break;}
        au_put64(mtb,w.*.nm,n3_fnv(modall,wo,wl));
        w.*.nm=w.*.nm+1;
    }
}
fn n3_is_stop(w:*N3W,b:[]u8,off:i32,len:i32)i32 {
    let h:i64=n3_fnv(b,off,len);
    let i:i32=0;
    while(i<w.*.ns){
        if(au_get64(w.*.st,i)==h){return 1;}
        i=i+1;
    }
    return 0;
}
fn n3_is_negw(w:*N3W,b:[]u8,off:i32,len:i32)i32 {
    let h:i64=n3_fnv(b,off,len);
    let i:i32=0;
    while(i<w.*.nn){
        if(au_get64(w.*.ng,i)==h){return 1;}
        i=i+1;
    }
    return 0;
}
fn n3_is_aux(w:*N3W,b:[]u8,off:i32,len:i32)i32 {
    let h:i64=n3_fnv(b,off,len);
    let i:i32=0;
    while(i<w.*.nx){
        if(au_get64(w.*.ax,i)==h){return 1;}
        i=i+1;
    }
    return 0;
}
fn n3_is_pron(w:*N3W,b:[]u8,off:i32,len:i32)i32 {
    let h:i64=n3_fnv(b,off,len);
    let i:i32=0;
    while(i<w.*.np){
        if(au_get64(w.*.pr,i)==h){return 1;}
        i=i+1;
    }
    return 0;
}
fn n3_is_modal(w:*N3W,b:[]u8,off:i32,len:i32)i32 {
    let h:i64=n3_fnv(b,off,len);
    let i:i32=0;
    while(i<w.*.nm){
        if(au_get64(w.*.md,i)==h){return 1;}
        i=i+1;
    }
    return 0;
}
// stemmed content-word hash: lowercase FNV with light English stemming
// (strip trailing "s"/"es"/"ed"/"ing" for len>4); 0 if stop word,
// negation marker, or len<3 (numerals always kept).
fn n3_stem_hash(w:*N3W,b:[]u8,off:i32,len:i32,h:*i64)i32 {
    let lo:i32=off;let ll:i32=len;
    while(ll>0 && (b[lo]==32 || b[lo]==9)){lo=lo+1;ll=ll-1;}
    while(ll>0 && (b[lo+ll-1]==32 || b[lo+ll-1]==9)){ll=ll-1;}
    if(ll<3){
        // numerals count as content even when short
        if(ll>=1 && b[lo]>=48 && b[lo]<=57){h.*=n3_fnv(b,lo,ll);return 1;}
        return 0;
    }
    if(n3_is_stop(w,b,lo,ll)==1){return 0;}
    if(n3_is_negw(w,b,lo,ll)==1){return 0;}
    // light stem DISABLED (2026-09-25): R3 used exact word match and reached
    // 36/37; stemming "comes"->"come" fabricates a contradiction in T4_12
    // ("does not come before" vs "comes after" are consistent).
    // if(ll>4){
    //     if(b[lo+ll-1]==115){
    //         if(b[lo+ll-2]==101){ll=ll-2;}
    //         else {ll=ll-1;}
    //     } else if(b[lo+ll-2]==101 && b[lo+ll-1]==100){ll=ll-2;}
    //     else if(ll>5 && b[lo+ll-3]==105 && b[lo+ll-2]==110 && b[lo+ll-1]==103){ll=ll-3;}
    // }
    h.*=n3_fnv(b,lo,ll);
    return 1;
}

// ---------------- engine state (flat small structs, touched via *T params) ----------------
// Ledger state fields (20 x i32 in []u8 arena, LE):
//  0 off, 1 len (bytes in ar), 2 src, 3 kid, 4 lic, 5 p1, 6 p2, 7 p3,
//  8 depth, 9 status, 10 thread, 11 round, 12 taint,
//  13 rule strikes (3+ -> SUSPECT, cannot license), 14..19 spare.
// src: 0=INPUT 1=CITE 2=ASSUME 3=PROP 4=SUBGOAL 5=PBC 6=PREMISE.
// status: 0=live 1=defeated.
struct N3S { ar:[]u8, acap:i32, an:i32, st:[]u8, nst:i32, stcap:i32, wtmp:[]u8, ev:[]u8 }
struct N3X { goff:i32, glen:i32, goal:[]u8, gollen:i32, pid:[]u8, pidlen:i32, assum:i32, derived_by:i32, store:[]u8, storelen:i32, rules:[]u8, ruleslen:i32, maxdepth:i32, maxrounds:i32, cachepath:[]u8, cachepathlen:i32, gw:[]u8, ngw:i32 }
struct N3T { strs:[]u8, kill:[]u8, props:[]u8, used:[]u8, nused:[]u8, wa:[]u8, wb:[]u8, na:[]u8, nb:[]u8, sw:[]u8, cred:[]u8, dorm:[]u8, ch_ar:[]u8, ch_an:i32, ch_sig:[]u8, ch_aoff:[]u8, ch_alen:[]u8, ch_coff:[]u8, ch_clen:[]u8, ch_or:[]u8, ch_n:i32 }
struct N3C { s:*N3S, x:*N3X, t:*N3T, w:*N3W, au:*DOut }
struct N3P { lic:i32, p1:i32, p2:i32, p3:i32, src:i32, kid:i32, olen:i32 }

fn n3_sf(s:*N3S,id:i32,f:i32)i32 { return au_get32(s.*.st,id*20+f); }
fn n3_setf(s:*N3S,id:i32,f:i32,v:i32)void { au_put32(s.*.st,id*20+f,v); }
fn n3_sbytes(s:*N3S,id:i32,bo:*i32,bl:*i32)void {
    bo.*=n3_sf(s,id,0);bl.*=n3_sf(s,id,1);
}
fn n3_in_arr(a:[]u8,n:i32,h:i64)i32 {
    let j:i32=0;
    while(j<n){
        if(au_get64(a,j)==h){return 1;}
        j=j+1;
    }
    return 0;
}
// ---------------- n5 content-word set machinery ----------------
// n5_collect: stemmed content-word hashes of b[off..off+len), skipping up
// to three word spans. Writes into arr (cap*8 bytes), returns count.
fn n5_collect(c:*N3C,b:[]u8,off:i32,len:i32,k1o:i32,k1l:i32,k2o:i32,k2l:i32,k3o:i32,k3l:i32,arr:[]u8,cap:i32)i32 {
    let w:*N3W=c.*.w;
    let n:i32=0;let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n3_next_word(b,off,len,&cur,&wo,&wl)==1){
        if(n3_in_span(wo,wl,k1o,k1l)==1){continue;}
        if(n3_in_span(wo,wl,k2o,k2l)==1){continue;}
        if(n3_in_span(wo,wl,k3o,k3l)==1){continue;}
        let h:i64=0;
        if(n3_stem_hash(w,b,wo,wl,&h)==1){
            if(n3_in_arr(arr,n,h)==0 && n<cap){au_put64(arr,n,h);n=n+1;}
        }
    }
    return n;
}
// n5_collect_neg: subset of n5_collect in negation scope. A word is in
// scope iff an ODD number of negation markers occur in the same sentence
// before it (parity: "impossible ... not" double negation cancels), with
// no sentence-internal clause reset ("but"/"however"/";"/"although"/
// "though"/"while"/"whereas").
fn n5_has_double_neg(c:*N3C,b:[]u8,off:i32,len:i32)i32 {
    let w:*N3W=c.*.w;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    let seen_modal:i32=0;
    while(n3_next_word(b,off,len,&cur,&wo,&wl)==1){
        if(n3_eq_ci(b,wo,wl,"impossible",0,10)==1 || n3_eq_ci(b,wo,wl,"cannot",0,6)==1 || n3_eq_ci(b,wo,wl,"unable",0,6)==1){seen_modal=1;}
        else if(seen_modal==1 && n3_is_negw(w,b,wo,wl)==1){return 1;}
    }
    return 0;
}
fn n5_collect_neg(c:*N3C,b:[]u8,off:i32,len:i32,k1o:i32,k1l:i32,k2o:i32,k2l:i32,k3o:i32,k3l:i32,arr:[]u8,cap:i32)i32 {
    let w:*N3W=c.*.w;
    let n:i32=0;let cur:i32=0;let wo:i32=0;let wl:i32=0;
    if(n5_has_double_neg(c,b,off,len)==1){return 0;}
    let neg_par:i32=0;
    while(n3_next_word(b,off,len,&cur,&wo,&wl)==1){
        // reset scan: did a sentence boundary or reset-clause marker occur
        // between the previous word and this one?
        let k:i32=0;
        let hit_reset:i32=0;
        // (approximate: scan raw bytes between words)
        let prev_end:i32=off;
        if(wo>off){prev_end=wo;}
        // NOTE: exact gap scan needs prev word end; we approximate with a
        // local scan of the last 12 bytes before wo for boundary chars.
        let gs:i32=wo-12;
        if(gs<off){gs=off;}
        k=gs;
        while(k<wo){
            let ch:u8=b[k];
            if(ch==46 || ch==33 || ch==63 || ch==59){hit_reset=1;break;}
            k=k+1;
        }
        if(hit_reset==1){neg_par=0;}
        // clause reset words
        if(n3_eq_ci(b,wo,wl,"but",0,3)==1 || n3_eq_ci(b,wo,wl,"however",0,7)==1 || n3_eq_ci(b,wo,wl,"although",0,8)==1 || n3_eq_ci(b,wo,wl,"though",0,6)==1 || n3_eq_ci(b,wo,wl,"while",0,5)==1 || n3_eq_ci(b,wo,wl,"whereas",0,7)==1){neg_par=0;}
        if(n3_in_span(wo,wl,k1o,k1l)==1 || n3_in_span(wo,wl,k2o,k2l)==1 || n3_in_span(wo,wl,k3o,k3l)==1){continue;}
        if(n3_is_negw(w,b,wo,wl)==1){neg_par=1-neg_par;continue;}
        let h:i64=0;
        if(neg_par==1 && n3_stem_hash(w,b,wo,wl,&h)==1){
            if(n3_in_arr(arr,n,h)==0 && n<cap){au_put64(arr,n,h);n=n+1;}
        }
    }
    return n;
}
// n5_subject: subject word hashes of b[off..off+len): content words before
// the first auxiliary verb (or '='), else the first content word.
// Existential ("there is/are X" / "let X be"): up to 4 content words after
// the aux.
fn n5_subject(c:*N3C,b:[]u8,off:i32,len:i32,arr:[]u8,cap:i32)i32 {
    let w:*N3W=c.*.w;
    // truncate at '=' (equations: subject is the left side)
    let epos:i32=off;
    while(epos<off+len && b[epos]!=61){epos=epos+1;}
    let slen:i32=len;
    if(epos<off+len){slen=epos-off;}
    let n:i32=0;let cur:i32=0;let wo:i32=0;let wl:i32=0;
    let saw_aux:i32=0;let first_only:i32=0;
    let words:[]u8=c.*.t.*.sw;
    let nw:i32=0;
    while(n3_next_word(b,off,slen,&cur,&wo,&wl)==1){
        if(nw<192){au_put64(words,nw,(wo as i64)*1000000+(wl as i64));nw=nw+1;}
        if(n3_is_aux(w,b,wo,wl)==1){saw_aux=1;break;}
    }
    if(saw_aux==0){
        // no aux: first content word only
        let i:i32=0;
        while(i<nw){
            let p:i64=au_get64(words,i);
            let wo2:i32=(p/1000000) as i32;let wl2:i32=(p%1000000) as i32;
            let h:i64=0;
            if(n3_stem_hash(w,b,wo2,wl2,&h)==1){
                if(n<cap){au_put64(arr,n,h);n=n+1;}
                break;
            }
            i=i+1;
        }
        return n;
    }
    // words before the aux
    let i:i32=0;
    while(i<nw){
        let p:i64=au_get64(words,i);
        let wo2:i32=(p/1000000) as i32;let wl2:i32=(p%1000000) as i32;
        if(n3_is_aux(w,b,wo2,wl2)==1){break;}
        let h:i64=0;
        if(n3_stem_hash(w,b,wo2,wl2,&h)==1){
            if(n3_in_arr(arr,n,h)==0 && n<cap){au_put64(arr,n,h);n=n+1;}
        }
        i=i+1;
    }
    if(n>0){return n;}
    // existential: up to 4 content words after the aux
    let cnt:i32=0;
    while(i<nw){
        let p:i64=au_get64(words,i);
        let wo2:i32=(p/1000000) as i32;let wl2:i32=(p%1000000) as i32;
        if(n3_is_aux(w,b,wo2,wl2)==1){i=i+1;continue;}
        let h:i64=0;
        if(n3_stem_hash(w,b,wo2,wl2,&h)==1){
            if(n3_in_arr(arr,n,h)==0 && n<cap){au_put64(arr,n,h);n=n+1;cnt=cnt+1;}
            if(cnt>=4){break;}
        }
        i=i+1;
    }
    return n;
}
// subject byte-span mirroring n5_subject (content words before first aux
// or '=', else first content word). Sets *so,*sl (absolute).
fn n5_subject_span(c:*N3C,b:[]u8,off:i32,len:i32,so:*i32,sl:*i32)void {
    let w:*N3W=c.*.w;
    let epos:i32=off;
    while(epos<off+len && b[epos]!=61){epos=epos+1;}
    let slen:i32=len;
    if(epos<off+len){slen=epos-off;}
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    let f0:i32=-1;let f1:i32=-1;let any_pre:i32=0;
    while(n3_next_word(b,off,slen,&cur,&wo,&wl)==1){
        if(n3_is_aux(w,b,wo,wl)==1){break;}
        let sh:i64=0;
        if(n3_stem_hash(w,b,wo,wl,&sh)==1){
            if(f0<0){f0=wo;}
            f1=wo+wl;any_pre=1;
        }
    }
    if(any_pre==1){so.*=f0;sl.*=f1-f0;return;}
    cur=0;wo=0;wl=0;
    while(n3_next_word(b,off,slen,&cur,&wo,&wl)==1){
        let sh:i64=0;
        if(n3_stem_hash(w,b,wo,wl,&sh)==1){so.*=wo;sl.*=wl;return;}
    }
    so.*=off;sl.*=0;
}
// n5_numerals: integer values of numeral words in the span (as i64),
// order of appearance. cap entries.
fn n5_numerals(c:*N3C,b:[]u8,off:i32,len:i32,arr:[]u8,cap:i32)i32 {
    let n:i32=0;let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n3_next_word(b,off,len,&cur,&wo,&wl)==1){
        if(wl>=1 && wl<=10 && b[wo]>=48 && b[wo]<=57){
            let alld:i32=1;let k:i32=0;
            while(k<wl){if(b[wo+k]<48 || b[wo+k]>57){alld=0;break;}k=k+1;}
            if(alld==1){
                let v:i64=0;k=0;
                while(k<wl){v=v*10+((b[wo+k]-48) as i64);k=k+1;}
                if(n<cap){au_put64(arr,n,v);n=n+1;}
            }
        }
    }
    return n;
}
// multiset equality of i64 arrays (order-insensitive).
fn n5_mult_eq(a:[]u8,na:i32,b:[]u8,nb:i32)i32 {
    if(na!=nb){return 0;}
    let used:[]u8=nio_alloc(64*8);
    if(used.len!=512){return 0;}
    let zi:i32=0;
    while(zi<64){au_put64(used,zi,0);zi=zi+1;}
    let i:i32=0;
    while(i<na){
        let h:i64=au_get64(a,i);
        let j:i32=0;let fnd:i32=0;
        while(j<nb){
            if(au_get64(used,j)==0 && au_get64(b,j)==h){au_put64(used,j,1);fnd=1;break;}
            j=j+1;
        }
        if(fnd==0){nio_free(used);return 0;}
        i=i+1;
    }
    nio_free(used);
    return 1;
}

// collect distinct non-stop word hashes of b[off..off+len), skipping spans
// [s1o,s1o+s1l), [s2o,s2o+s2l), [s3o,s3o+s3l). Words shorter than 3 bytes are
// not content vocabulary (numbers, variables like "x"/"m") and are ignored.
// Returns count (cap-limited).
fn n3_collect(c:*N3C,b:[]u8,off:i32,len:i32,s1o:i32,s1l:i32,s2o:i32,s2l:i32,s3o:i32,s3l:i32,arr:[]u8,cap:i32)i32 {
    let w:*N3W=c.*.w;
    let n:i32=0;let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n3_next_word(b,off,len,&cur,&wo,&wl)==1){
        if(wl<3){continue;}
        if(n3_in_span(wo,wl,s1o,s1l)==1){continue;}
        if(n3_in_span(wo,wl,s2o,s2l)==1){continue;}
        if(n3_in_span(wo,wl,s3o,s3l)==1){continue;}
        if(n3_is_stop(w,b,wo,wl)==1){continue;}
        // Negation markers are operators, not content: they set polarity
        // (via the neg-scope sets) but must not count as shared vocabulary.
        // Otherwise e.g. "not" alone plus one stray shared word ("2")
        // fabricates contradictions.
        if(n3_is_negw(w,b,wo,wl)==1){continue;}
        let h:i64=n3_fnv(b,wo,wl);
        if(n3_in_arr(arr,n,h)==0){
            if(n<cap){au_put64(arr,n,h);n=n+1;}
        }
    }
    return n;
}
// collect distinct word hashes that fall inside a negation-marker's scope:
// after a neg-marker word until a clause-end char (.,!?;,\n). Same skips.
fn n3_collect_neg(c:*N3C,b:[]u8,off:i32,len:i32,s1o:i32,s1l:i32,s2o:i32,s2l:i32,s3o:i32,s3l:i32,arr:[]u8,cap:i32)i32 {
    let w:*N3W=c.*.w;
    let n:i32=0;let cur:i32=0;let wo:i32=0;let wl:i32=0;
    let neg:i32=0;let prev_end:i32=off;
    while(n3_next_word(b,off,len,&cur,&wo,&wl)==1){
        let g:i32=prev_end;
        while(g<wo){
            let ch:u8=b[g];
            if(ch==46 || ch==33 || ch==63 || ch==59 || ch==44 || ch==10){neg=0;}
            g=g+1;
        }
        if(n3_is_negw(w,b,wo,wl)==1){
            neg=1;
        } else {
            if(neg==1 && wl>=3 && n3_in_span(wo,wl,s1o,s1l)==0 && n3_in_span(wo,wl,s2o,s2l)==0 && n3_in_span(wo,wl,s3o,s3l)==0 && n3_is_stop(w,b,wo,wl)==0){
                let h:i64=n3_fnv(b,wo,wl);
                if(n3_in_arr(arr,n,h)==0){
                    if(n<cap){au_put64(arr,n,h);n=n+1;}
                }
            }
        }
        prev_end=wo+wl;
    }
    return n;
}

// Contradiction (n5 detector v2): proposal bytes ob[0..olen) vs ledger
// state b. 1 iff >=2 shared stemmed content words (numerals included)
// AND (some shared word flipped negation-scope status with subject
// alignment, OR quantity mismatch). Skip spans: for the INPUT state (id 0)
// skip the goal span; for conditional cites/premises skip antecedent and
// consequent spans; for definition cites/premises skip the head span.
// Quantity mismatch: same subject word-set (nonempty), different numeral
// multisets, tight non-numeral frame (|symdiff|<=2), and the ledger side is
// asserted (src in {0,1,2,6} — never derived-vs-derived).
fn n5_contra_state(c:*N3C,ob:[]u8,olen:i32,b:i32)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;
    let bo:i32=0;let bl:i32=0;
    n3_sbytes(s,b,&bo,&bl);
    let ab:[]u8=s.*.ar;
    let k1o:i32=-1;let k1l:i32=0;let k2o:i32=-1;let k2l:i32=0;let k3o:i32=-1;let k3l:i32=0;
    if(b==0){
        k1o=x.*.goff;k1l=x.*.glen;
    } else {
        let bsrc:i32=n3_sf(s,b,2);
        if(bsrc==1 || bsrc==6){
            let ho:i32=0;let hl:i32=0;let yo:i32=0;let yl:i32=0;
            if(n3_def_parse(ab,bo,bl,&ho,&hl,&yo,&yl)==1){
                k3o=ho;k3l=hl;
            }
            let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
            if(n3_cond_parse(ab,bo,bl,&co,&cl,&qo,&ql)==1){
                k1o=co;k1l=cl;k2o=qo;k2l=ql;
            }
        }
    }
    let wa:[]u8=t.*.wa;let wb:[]u8=t.*.wb;let na:[]u8=t.*.na;let nb:[]u8=t.*.nb;
    let n1:i32=n5_collect(c,ob,0,olen,-1,0,-1,0,-1,0,wa,192);
    let n2:i32=n5_collect(c,ab,bo,bl,k1o,k1l,k2o,k2l,k3o,k3l,wb,192);
    let sh:i32=0;let i:i32=0;
    while(i<n1){
        let h:i64=au_get64(wa,i);
        if(n3_in_arr(wb,n2,h)==1){sh=sh+1;}
        i=i+1;
    }
    if(sh<2){return 0;}
    // polarity-flip path with subject alignment
    let m1:i32=n5_collect_neg(c,ob,0,olen,-1,0,-1,0,-1,0,na,192);
    let m2:i32=n5_collect_neg(c,ab,bo,bl,k1o,k1l,k2o,k2l,k3o,k3l,nb,192);
    let flipped:i64=0;let has_flip:i32=0;
    i=0;
    while(i<n1){
        let h:i64=au_get64(wa,i);
        if(n3_in_arr(wb,n2,h)==1){
            let a1:i32=n3_in_arr(na,m1,h);
            let a2:i32=n3_in_arr(nb,m2,h);
            if(a1!=a2){flipped=h;has_flip=1;break;}
        }
        i=i+1;
    }
    if(has_flip==1){
        let sa:[]u8=nio_alloc(32*8);
        let sb:[]u8=nio_alloc(32*8);
        if(sa.len==256 && sb.len==256){
            let nsa:i32=n5_subject(c,ob,0,olen,sa,32);
            let nsb:i32=n5_subject(c,ab,bo,bl,sb,32);
            let align:i32=0;
            if(n3_in_arr(sa,nsa,flipped)==1){align=1;}
            if(n3_in_arr(sb,nsb,flipped)==1){align=1;}
            let k:i32=0;
            while(k<nsa){
                if(n3_in_arr(sb,nsb,au_get64(sa,k))==1){align=1;break;}
                k=k+1;
            }
            if(align==1){nio_free(sa);nio_free(sb);return 1;}
        }
        nio_free(sa);nio_free(sb);
    }
    // quantity-mismatch path: asserted side only
    let bsrc2:i32=n3_sf(s,b,2);
    if(bsrc2==0 || bsrc2==1 || bsrc2==2 || bsrc2==6){
        let qa:[]u8=nio_alloc(32*8);
        let qb:[]u8=nio_alloc(32*8);
        let fa:[]u8=nio_alloc(32*8);
        let fb:[]u8=nio_alloc(32*8);
        if(qa.len==256 && qb.len==256 && fa.len==256 && fb.len==256){
            let nqa:i32=n5_numerals(c,ob,0,olen,qa,32);
            let nqb:i32=n5_numerals(c,ab,bo,bl,qb,32);
            if(nqa>0 && nqb>0 && n5_mult_eq(qa,nqa,qb,nqb)==0){
                let nsa2:i32=n5_subject(c,ob,0,olen,fa,32);
                let nsb2:i32=n5_subject(c,ab,bo,bl,fb,32);
                if(nsa2>0 && nsa2==nsb2 && n5_mult_eq(fa,nsa2,fb,nsb2)==1){
                    let df:i32=0;
                    let k2:i32=0;
                    while(k2<n1){
                        if(n3_in_arr(wb,n2,au_get64(wa,k2))==0){df=df+1;}
                        k2=k2+1;
                    }
                    k2=0;
                    while(k2<n2){
                        if(n3_in_arr(wa,n1,au_get64(wb,k2))==0){df=df+1;}
                        k2=k2+1;
                    }
                    if(df<=2){nio_free(qa);nio_free(qb);nio_free(fa);nio_free(fb);return 1;}
                }
            }
        }
        nio_free(qa);nio_free(qb);nio_free(fa);nio_free(fb);
    }
    return 0;
}



// ---------------- used (license,premise) pairs per thread ----------------
fn n3_used(t:*N3T,th:i32,lic:i32,p1:i32,p2:i32,p3:i32)i32 {
    let n:i32=au_get32(t.*.nused,th);
    let base:i32=th*160*4;
    let i:i32=0;
    while(i<n){
        if(au_get32(t.*.used,base+i*4)==lic && au_get32(t.*.used,base+i*4+1)==p1 && au_get32(t.*.used,base+i*4+2)==p2 && au_get32(t.*.used,base+i*4+3)==p3){return 1;}
        i=i+1;
    }
    return 0;
}
fn n3_mark_used(t:*N3T,th:i32,lic:i32,p1:i32,p2:i32,p3:i32)void {
    let n:i32=au_get32(t.*.nused,th);
    if(n>=160){return;}
    let base:i32=th*160*4;
    au_put32(t.*.used,base+n*4,lic);
    au_put32(t.*.used,base+n*4+1,p1);
    au_put32(t.*.used,base+n*4+2,p2);
    au_put32(t.*.used,base+n*4+3,p3);
    au_put32(t.*.nused,th,n+1);
}

// ---------------- definition / conditional shape parsing (byte-level) ----------------
// Definition shape: "HEAD: body" (first colon). Returns head/body spans (trimmed).
fn n3_def_parse(b:[]u8,off:i32,len:i32,ho:*i32,hl:*i32,bo:*i32,bl:*i32)i32 {
    let i:i32=off;
    let end:i32=off+len;
    while(i<end && b[i]!=58){i=i+1;}
    if(i>=end){return 0;}
    let h0:i32=0;let h1:i32=0;let b0:i32=0;let b1:i32=0;
    n3_trim(b,off,i-off,&h0,&h1);
    n3_trim(b,i+1,end-(i+1),&b0,&b1);
    if(h1<1 || h1>40 || b1<1){return 0;}
    ho.*=h0;hl.*=h1;bo.*=b0;bl.*=b1;
    return 1;
}
// Head key: first non-stop word of head with len>=3. Returns span or 0.
fn n3_def_key(c:*N3C,b:[]u8,ho:i32,hl:i32,ko:*i32,kl:*i32)i32 {
    let w:*N3W=c.*.w;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n3_next_word(b,ho,hl,&cur,&wo,&wl)==1){
        if(wl>=3 && n3_is_stop(w,b,wo,wl)==0 && n3_is_negw(w,b,wo,wl)==0){
            ko.*=wo;kl.*=wl;return 1;
        }
    }
    return 0;
}
// Conditional shape: "if <C>, then <Q>" | "if <C> then <Q>" | "if <C>, <Q>".
// Returns C/Q spans (trimmed, arena-absolute). Rejects nested "if " in Q,
// empty parts, over-long parts.
fn n3_cond_parse(b:[]u8,off:i32,len:i32,co:*i32,cl:*i32,qo:*i32,ql:*i32)i32 {
    let ifpos:i32=n3_find_ci(b,off,len,"if ");
    if(ifpos<0){return 0;}
    let cs:i32=ifpos+3;
    let ce:i32=off+len;
    let q0:i32=-1;
    let p1:i32=n3_find_ci(b,cs,ce-cs,", then ");
    if(p1>=0){q0=p1+7;}
    if(q0<0){
        let p2:i32=n3_find_word_ci(b,cs,ce-cs,"then");
        if(p2>=0){q0=p2+4;}
    }
    let cend:i32=ce;
    if(q0<0){
        // fallback: "if <C>, <Q>" — split on first ", " after "if "
        let p3:i32=n3_find_ci(b,cs,ce-cs,", ");
        if(p3<0){return 0;}
        cend=p3;q0=p3+2;
    } else {
        if(p1>=0){cend=p1;} else {cend=q0-4;}
    }
    let c0:i32=0;let c1:i32=0;let r0:i32=0;let r1:i32=0;
    n3_trim(b,cs,cend-cs,&c0,&c1);
    n3_trim(b,q0,ce-q0,&r0,&r1);
    if(c1<1 || r1<1 || c1>400 || r1>400){return 0;}
    if(n3_find_ci(b,c0,c1,"if ")>=0){return 0;}
    if(n3_find_ci(b,r0,r1,"if ")>=0){return 0;}
    co.*=c0;cl.*=c1;qo.*=r0;ql.*=r1;
    return 1;
}

// ---------------- ledger append ----------------
fn n3_append(c:*N3C,src:i32,kid:i32,lic:i32,p1:i32,p2:i32,p3:i32,depth:i32,thread:i32,round:i32,ob:[]u8,olen:i32)i32 {
    let s:*N3S=c.*.s;
    if(s.*.nst>=s.*.stcap){return -1;}
    if(olen<1 || s.*.an+olen>s.*.acap){return -1;}
    let id:i32=s.*.nst;
    let at:i32=s.*.an;
    let ab:[]u8=s.*.ar;
    let i:i32=0;
    while(i<olen){ab[at+i]=ob[i];i=i+1;}
    n3_setf(s,id,0,at);
    n3_setf(s,id,1,olen);
    n3_setf(s,id,2,src);
    n3_setf(s,id,3,kid);
    n3_setf(s,id,4,lic);
    n3_setf(s,id,5,p1);
    n3_setf(s,id,6,p2);
    n3_setf(s,id,7,p3);
    n3_setf(s,id,8,depth);
    n3_setf(s,id,9,0);
    n3_setf(s,id,10,thread);
    n3_setf(s,id,11,round);
    let tn:i32=0;
    if(src==2){tn=1;}
    if(p1>=0 && n3_sf(s,p1,12)==1){tn=1;}
    if(p2>=0 && n3_sf(s,p2,12)==1){tn=1;}
    if(p3>=0 && n3_sf(s,p3,12)==1){tn=1;}
    n3_setf(s,id,12,tn);
    n3_setf(s,id,13,0);n3_setf(s,id,14,0);n3_setf(s,id,15,0);
    n3_setf(s,id,16,0);n3_setf(s,id,17,0);n3_setf(s,id,18,0);n3_setf(s,id,19,0);
    s.*.an=at+olen;
    s.*.nst=id+1;
    return id;
}

// PREMISES:/TARGET: presentation (twins, b5x_nl, b6x_nl batteries).
// These files carry no STATEMENT: line. Parse the PREMISES: block (the
// lines after the bare "PREMISES:" header line, until the "TARGET:" line,
// a blank line, another field header, or EOF) plus the same-line TARGET:
// value, and present
//     premises-text + "\nTARGET: " + target-text
// as the problem bytes in a fresh buffer. Bullet prefixes ("- ") are kept
// verbatim. The engine's downstream logic (goal skeleton, ledger, licenses,
// referee, verdict) is UNCHANGED: it simply sees the presentation as the
// whole problem text, exactly as if the file had contained it. Returns the
// presentation slice, or an empty slice when the format is absent/invalid.
// PRESENTATION CHOICE (documented per repair brief): the concatenation keeps
// every premise byte contiguous and byte-identical to the file, so ledger
// spans remain file-grounded; the "\nTARGET: " joiner is the only synthetic
// byte run (9 bytes), and the target is quoted after it.
fn n3_build_pt(pb:[]u8,pl:i32)[]u8 {
    let pos:i32=0;
    let hh:i32=-1;
    while(pos<pl){
        let ls:i32=pos;let e:i32=pos;
        while(e<pl && pb[e]!=10){e=e+1;}
        let t0:i32=0;let t1:i32=0;
        n3_trim(pb,ls,e-ls,&t0,&t1);
        if(t1==9 && pb[t0]==80 && pb[t0+1]==82 && pb[t0+2]==69 && pb[t0+3]==77 && pb[t0+4]==73 && pb[t0+5]==83 && pb[t0+6]==69 && pb[t0+7]==83 && pb[t0+8]==58){
            hh=ls;
            if(e<pl){pos=e+1;}
            if(e>=pl){pos=e;}
            break;
        }
        if(e<pl){pos=e+1;}
        if(e>=pl){pos=e;}
    }
    if(hh<0){return "";}
    let cs:i32=-1;
    let ce:i32=pos;
    while(pos<pl){
        let ls2:i32=pos;let e2:i32=pos;
        while(e2<pl && pb[e2]!=10){e2=e2+1;}
        let u0:i32=0;let u1:i32=0;
        n3_trim(pb,ls2,e2-ls2,&u0,&u1);
        let term:i32=0;
        if(u1==0){term=1;}
        if(term==0 && u1>=7 && pb[u0]==84 && pb[u0+1]==65 && pb[u0+2]==82 && pb[u0+3]==71 && pb[u0+4]==69 && pb[u0+5]==84 && pb[u0+6]==58){term=1;}
        if(term==0){
            let k:i32=u0;
            while(k<u0+u1 && ((pb[k]>=65 && pb[k]<=90) || (pb[k]>=48 && pb[k]<=57) || pb[k]==95 || pb[k]==45)){k=k+1;}
            if(k>u0 && k<u0+u1 && pb[k]==58){term=1;}
        }
        // terminator: ce already = end of the last content line (exclusive
        // of its newline), so the presentation has no trailing blank line.
        if(term==1){pos=pl;}
        if(term==0){
            if(cs<0){cs=ls2;}
            ce=e2;
            if(e2<pl){pos=e2+1;}
            if(e2>=pl){pos=e2;}
        }
    }
    if(cs<0){return "";}
    // same-line TARGET: value
    let tv:[]u8="";
    let tl2:i32=0;
    pos=0;
    while(pos<pl){
        let ls3:i32=pos;let e3:i32=pos;
        while(e3<pl && pb[e3]!=10){e3=e3+1;}
        if(e3-ls3>=7 && pb[ls3]==84 && pb[ls3+1]==65 && pb[ls3+2]==82 && pb[ls3+3]==71 && pb[ls3+4]==69 && pb[ls3+5]==84 && pb[ls3+6]==58){
            let v0:i32=0;let v1:i32=0;
            n3_trim(pb,ls3+7,e3-(ls3+7),&v0,&v1);
            tv=pb[v0..v0+v1];tl2=v1;
            pos=pl;
        }
        if(tl2==0){
            if(e3<pl){pos=e3+1;}
            if(e3>=pl){pos=e3;}
        }
    }
    if(tl2<1){return "";}
    let plen:i32=ce-cs;
    let nb:[]u8=nio_alloc(plen+9+tl2+8);
    if(nb.len!=plen+9+tl2+8){return "";}
    let w:i32=0;
    let q:i32=0;
    while(q<plen){nb[w]=pb[cs+q];w=w+1;q=q+1;}
    let sep:[]u8="\nTARGET: ";
    let s2:i32=0;
    while(s2<sep.len){nb[w]=sep[s2];w=w+1;s2=s2+1;}
    let t3:i32=0;
    while(t3<tl2){nb[w]=tv[t3];w=w+1;t3=t3+1;}
    return nb[0..w];
}

// ---------------- problem parsing ----------------
// Problem file: ID: / DOMAIN: / TYPE: lines, then STATEMENT: to EOF.
// S0 = whole file bytes. Goal = after "prove that "/"show that " (ci), else
// whole statement, trimmed. goff/glen = goal span inside S0 (arena coords).
// n5 metaline test: a line shaped WORD: is metadata (ID:, TARGET:, RULES:,
// PREMISES:, BASE-STORE:, ...); S1. / R1. style labels are content.
fn n5_is_metaline(b:[]u8,off:i32,len:i32)i32 {
    let k:i32=off;
    while(k<off+len && ((b[k]>=65 && b[k]<=90) || (b[k]>=97 && b[k]<=122) || (b[k]>=48 && b[k]<=57) || b[k]==95 || b[k]==45)){k=k+1;}
    if(k>off && k<off+len && b[k]==58){
        if(k-off>=2 && b[off]==83){
            let alld:i32=1;let j:i32=off+1;
            while(j<k){if(b[j]<48 || b[j]>57){alld=0;break;}j=j+1;}
            if(alld==1 && k+1<off+len && b[k+1]==46){return 0;}
        }
        return 1;
    }
    return 0;
}

// ---------------- problem parsing ----------------
// Problem file: metadata lines (ID:, TARGET:, RULES:, ...), content lines.
// State 0 = whole file bytes. The TARGET: line value (exact, trimmed) is the
// goal. Every content sentence outside TARGET: becomes a first-class PREMISE
// state (src=6); sentences inside a RULES: block become cited local rules
// (src=1). Sentences split on ". " like the knowledge parser.
fn n3_parse_prob(c:*N3C,pb:[]u8,pl:i32)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;
    // ID: line value (always read from the original file bytes)
    let pos:i32=0;let idv:[]u8="";
    while(pos<pl){
        let ls:i32=pos;let e:i32=pos;
        while(e<pl && pb[e]!=10){e=e+1;}
        if(e-ls>=4 && pb[ls]==73 && pb[ls+1]==68 && pb[ls+2]==58){
            let v0:i32=0;let v1:i32=0;
            n3_trim(pb,ls+3,e-(ls+3),&v0,&v1);
            idv=pb[v0..v0+v1];
            break;
        }
        // chain_nl style: "# <ID>"
        if(e-ls>=3 && pb[ls]==35 && pb[ls+1]==32){
            let v0:i32=0;let v1:i32=0;
            n3_trim(pb,ls+2,e-(ls+2),&v0,&v1);
            idv=pb[v0..v0+v1];
            break;
        }
        if(e<pl){e=e+1;}
        pos=e;
    }
    let pid:[]u8=nio_alloc(128);
    if(pid.len!=128){return -1;}
    let cp:i32=idv.len;
    if(cp>120){cp=120;}
    let i0:i32=0;
    while(i0<cp){pid[i0]=idv[i0];i0=i0+1;}
    x.*.pid=pid;x.*.pidlen=cp;
    // state 0 = whole file bytes
    if(pl<1 || pl+1024>s.*.acap){return -1;}
    let ab:[]u8=s.*.ar;
    let i:i32=0;
    while(i<pl){ab[i]=pb[i];i=i+1;}
    n3_setf(s,0,0,0);n3_setf(s,0,1,pl);n3_setf(s,0,2,0);n3_setf(s,0,3,0);
    n3_setf(s,0,4,-1);n3_setf(s,0,5,-1);n3_setf(s,0,6,-1);n3_setf(s,0,7,-1);
    n3_setf(s,0,8,0);n3_setf(s,0,9,0);n3_setf(s,0,10,-1);n3_setf(s,0,11,0);
    n3_setf(s,0,12,0);
    s.*.nst=1;s.*.an=pl;
    // exact TARGET: parse (first TARGET: line)
    let tp:i32=-1;let tl:i32=0;
    pos=0;
    while(pos<pl){
        let ls:i32=pos;let e:i32=pos;
        while(e<pl && pb[e]!=10){e=e+1;}
        if(e-ls>=7 && pb[ls]==84 && pb[ls+1]==65 && pb[ls+2]==82 && pb[ls+3]==71 && pb[ls+4]==69 && pb[ls+5]==84 && pb[ls+6]==58){
            let v0:i32=0;let v1:i32=0;
            n3_trim(pb,ls+7,e-(ls+7),&v0,&v1);
            tp=v0;tl=v1;
            break;
        }
        if(e<pl){e=e+1;}
        pos=e;
    }
    if(tp<0 || tl<1){
        // fallback: "- Prove that <goal>." line (R3N / chain_nl style)
        pos=0;
        while(pos<pl){
            let ls:i32=pos;let e:i32=pos;
            while(e<pl && pb[e]!=10){e=e+1;}
            let w0:i32=0;let w1:i32=0;
            n3_trim(pb,ls,e-ls,&w0,&w1);
            if(w1>=2 && pb[w0]==45 && pb[w0+1]==32){w0=w0+2;w1=w1-2;}
            if(w1>=10 && n3_eq_ci(pb,w0,10,"prove that",0,10)==1){
                let g0:i32=w0+10;let g1:i32=w1-10;
                while(g1>0 && pb[g0]==32){g0=g0+1;g1=g1-1;}
                while(g1>0 && pb[g0+g1-1]==46){g1=g1-1;}
                if(g1>=1){tp=g0;tl=g1;break;}
            }
            if(e<pl){e=e+1;}
            pos=e;
        }
    }
    if(tp<0 || tl<1){return -2;}
    let g:[]u8=nio_alloc(tl);
    if(g.len!=tl){return -1;}
    i=0;
    while(i<tl){g[i]=pb[tp+i];i=i+1;}
    x.*.goal=g;x.*.gollen=tl;
    x.*.goff=tp;x.*.glen=tl;
    x.*.assum=-1;x.*.derived_by=-1;
    // goal content words (for coverage goal-matching)
    let gw:[]u8=nio_alloc(64*8);
    if(gw.len!=64*8){return -1;}
    x.*.gw=gw;
    x.*.ngw=n5_collect(c,g,0,tl,-1,0,-1,0,-1,0,gw,64);
    // content lines -> premises (src=6) / RULES: block -> local rules (src=1)
    let inrules:i32=0;
    pos=0;
    while(pos<pl){
        let ls:i32=pos;let e:i32=pos;
        while(e<pl && pb[e]!=10){e=e+1;}
        let u0:i32=0;let u1:i32=0;
        n3_trim(pb,ls,e-ls,&u0,&u1);
        if(u1>=2 && pb[u0]==45 && pb[u0+1]==32){u0=u0+2;u1=u1-2;}
        // chain_nl style: strip "S<n>." prefix; skip "S<n>. Prove that..." lines
        // (the task restatement, not a premise).
        if(u1>=3 && pb[u0]==83){
            let sd:i32=u0+1;
            while(sd<u0+u1 && pb[sd]>=48 && pb[sd]<=57){sd=sd+1;}
            if(sd>u0+1 && sd+1<u0+u1 && pb[sd]==46 && pb[sd+1]==32){
                let nu0:i32=sd+2;
                let nu1:i32=(u0+u1)-nu0;
                u0=nu0;u1=nu1;
                // re-trim after strip
                let t0:i32=0;let t1:i32=0;
                n3_trim(pb,u0,u1,&t0,&t1);
                u0=t0;u1=t1;
                if(u1>=10 && n3_eq_ci(pb,u0,10,"prove that",0,10)==1){
                    // skip: not a premise
                    if(e<pl){pos=e+1;}else{pos=e;}
                    continue;
                }
            }
        }
        let isrule:i32=0;
        if(u1==0){inrules=0;}
        else if(pb[u0]==35){inrules=0;}
        else if(u1==6 && n3_eq_ci(pb,u0,6,"RULES:",0,6)==1){inrules=1;}
        else if(u1>=7 && n3_eq_ci(pb,u0,7,"TARGET:",0,7)==1){inrules=0;}
        else if(n5_is_metaline(pb,u0,u1)==1){inrules=0;}
        else {isrule=1;}
        if(isrule==1){
            let src2:i32=6;
            if(inrules==1){src2=1;}
            let sp:i32=u0;let se2:i32=u0+u1;
            while(sp<se2){
                let se:i32=sp;
                while(se<se2){
                    if(pb[se]==46 && (se+1>=se2 || pb[se+1]==32 || pb[se+1]==10)){break;}
                    se=se+1;
                }
                let incl:i32=0;
                if(se<se2){incl=1;}
                let q0:i32=0;let q1:i32=0;
                n3_trim(pb,sp,se-sp+incl,&q0,&q1);
                if(q1>=4){
                    let w:[]u8=s.*.wtmp;
                    let k:i32=0;
                    while(k<q1){w[k]=pb[q0+k];k=k+1;}
                    let id:i32=n3_append(c,src2,0,-1,-1,-1,-1,1,-1,0,w,q1);
                    if(id<0){return -2;}
                }
                sp=se+incl;
                if(sp<se2 && pb[sp]==32){sp=sp+1;}
            }
        }
        if(e<pl){pos=e+1;}else{pos=e;}
    }
    return 0;
}

// ---------------- knowledge store parsing ----------------
// Format: [Kddd] header lines; optional "(type)" line; text lines until next
// header/EOF, joined with " ". Each item split into sentences on ". ";
// each sentence -> one CITE state (kid = item number).
fn n3_parse_kb(c:*N3C,kb:[]u8,kl:i32)i32 {
    let s:*N3S=c.*.s;
    let pos:i32=0;
    let ncites:i32=0;
    while(pos<kl){
        let ls:i32=pos;let e:i32=pos;
        while(e<kl && kb[e]!=10){e=e+1;}
        // Rddd./Iddd. store lines (B5X base/injected stores)
        if(e-ls>=5 && (kb[ls]==82 || kb[ls]==73) && kb[ls+1]>=48 && kb[ls+1]<=57 && kb[ls+2]>=48 && kb[ls+2]<=57 && kb[ls+3]>=48 && kb[ls+3]<=57 && kb[ls+4]==46){
            let idn2:i32=((kb[ls+1] as i32)-48)*100+(((kb[ls+2] as i32)-48)*10)+((kb[ls+3] as i32)-48);
            if(kb[ls]==73){idn2=idn2+1000;}
            if(e<kl){e=e+1;}
            pos=e;
            let ce2:i32=e-1;
            let kk2:i32=ls;
            while(kk2<ce2){
                if(kb[kk2]==32 && kk2+1<ce2 && kb[kk2+1]==35){ce2=kk2;break;}
                kk2=kk2+1;
            }
            let sp2:i32=ls;
            while(sp2<ce2){
                let se2:i32=sp2;
                while(se2<ce2){
                    if(kb[se2]==46 && (se2+1>=ce2 || kb[se2+1]==32)){break;}
                    se2=se2+1;
                }
                let incl2:i32=0;
                if(se2<ce2){incl2=1;}
                let q0:i32=0;let q1:i32=0;
                n3_trim(kb,sp2,se2-sp2+incl2,&q0,&q1);
                if(q1>0 && ncites<400){
                    let w:[]u8=s.*.wtmp;
                    let k2:i32=0;
                    while(k2<q1){w[k2]=kb[q0+k2];k2=k2+1;}
                    let id2:i32=n3_append(c,1,idn2,-1,-1,-1,-1,1,-1,0,w,q1);
                    if(id2<0){return -2;}
                    ncites=ncites+1;
                }
                sp2=se2+incl2;
                if(sp2<ce2 && kb[sp2]==32){sp2=sp2+1;}
            }
            continue;
        }
        let ishead:i32=0;let idn:i32=0;
        if(e-ls>=6 && kb[ls]==91 && kb[ls+1]==75 && kb[ls+2]>=48 && kb[ls+2]<=57 && kb[ls+3]>=48 && kb[ls+3]<=57 && kb[ls+4]>=48 && kb[ls+4]<=57 && kb[ls+5]==93){
            ishead=1;
            idn=((kb[ls+2] as i32)-48)*100+(((kb[ls+3] as i32)-48)*10)+((kb[ls+4] as i32)-48);
        }
        if(e<kl){e=e+1;}
        pos=e;
        if(ishead==0){continue;}
        // gather text lines
        let tb:[]u8=nio_alloc(8192);
        if(tb.len!=8192){return -1;}
        let tn:i32=0;
        while(pos<kl){
            let l2:i32=pos;let e2:i32=pos;
            while(e2<kl && kb[e2]!=10){e2=e2+1;}
            let nh:i32=0;
            if(e2-l2>=6 && kb[l2]==91 && kb[l2+1]==75){nh=1;}
            if(nh==1){break;}
            let u0:i32=0;let u1:i32=0;
            n3_trim(kb,l2,e2-l2,&u0,&u1);
            if(u1>0 && kb[u0]!=40){
                if(tn>0 && tn<8191){tb[tn]=32;tn=tn+1;}
                let k:i32=0;
                while(k<u1 && tn<8191){tb[tn]=kb[u0+k];tn=tn+1;k=k+1;}
            }
            if(e2<kl){e2=e2+1;}
            pos=e2;
        }
        // split tb[0..tn) into sentences on ". "
        let sp:i32=0;
        while(sp<tn){
            let se:i32=sp;
            while(se<tn){
                if(tb[se]==46 && (se+1>=tn || tb[se+1]==32 || tb[se+1]==10)){break;}
                se=se+1;
            }
            let incl:i32=0;
            if(se<tn){incl=1;}
            let q0:i32=0;let q1:i32=0;
            n3_trim(tb,sp,se-sp+incl,&q0,&q1);
            if(q1>0 && ncites<400){
                let w:[]u8=s.*.wtmp;
                let k:i32=0;
                while(k<q1){w[k]=tb[q0+k];k=k+1;}
                let id:i32=n3_append(c,1,idn,-1,-1,-1,-1,1,-1,0,w,q1);
                if(id<0){nio_free(tb);return -2;}
                ncites=ncites+1;
            }
            sp=se+incl;
            if(sp<tn && tb[sp]==32){sp=sp+1;}
        }
        nio_free(tb);
    }
    return 0;
}

// ---------------- B5X store loading ----------------
// Problem files name their stores via BASE-STORE: / STORE: lines (paths are
// tnn-lab-root-relative). Load each named store file through n3_parse_kb.
// CWD is math_logic/round4/engines/n5, so the root is ../../../...
fn n5_load_stores(c:*N3C,pb:[]u8,pl:i32)void {
    let pos:i32=0;
    while(pos<pl){
        let ls:i32=pos;let e:i32=pos;
        while(e<pl && pb[e]!=10){e=e+1;}
        let u0:i32=0;let u1:i32=0;
        n3_trim(pb,ls,e-ls,&u0,&u1);
        let isbase:i32=0;let isstore:i32=0;
        if(u1>=11 && n3_eq_ci(pb,u0,11,"BASE-STORE:",0,11)==1){isbase=1;}
        if(u1>=6 && n3_eq_ci(pb,u0,6,"STORE:",0,6)==1){isstore=1;}
        if(isbase==1 || isstore==1){
            let v0:i32=u0+11;
            if(isstore==1){v0=u0+6;}
            let w0:i32=0;let w1:i32=0;
            n3_trim(pb,v0,u0+u1-v0,&w0,&w1);
            if(w1>0 && w1<900){
                let p2:[]u8=nio_alloc(1024);
                if(p2.len==1024){
                    let pre:[]u8="../../../../";
                    let q:i32=0;
                    while(q<pre.len){p2[q]=pre[q];q=q+1;}
                    let j:i32=0;
                    while(j<w1){p2[q+j]=pb[w0+j];j=j+1;}
                    let pl2:i32=q+j;
                    let buf:[]u8=nio_alloc(300000);
                    if(buf.len==300000){
                        let n:i64=dlb_read_file(p2[0..pl2],buf);
                        if(n<=0){n=dlb_read_file(pb[w0..w0+w1],buf);}
                        if(n>0){n3_parse_kb(c,buf,n as i32);}
                        nio_free(buf);
                    }
                    nio_free(p2);
                }
            }
        }
        if(e<pl){pos=e+1;}else{pos=e;}
    }
}

// ---------------- antecedent conjunct matching (n5 word-inclusion) ----------------
// n5 antecedent matching: word-inclusion (never substring). Split the
// antecedent span on " and " (ci); each conjunct (trimmed, len>=4, max 2)
// must be COVERED by some live state: every stemmed content word of the
// conjunct occurs in the state with the same negation-scope status
// (polarity-aware: a negated conjunct needs a negated asserter).
// Candidate asserters: live states with src in {1,2,3,5,6} (cites,
// assumptions, props, pbc-states, premises); conditional-shaped states are
// excluded (their spans are unasserted); subgoals (src 4) are excluded;
// the INPUT state (0) is never a matcher (premise states cover it).
// tainted_only=1 -> taint==1 required (contra-thread use).
// Returns matched count (<=2), fills m1/m2; -1 on >2 conjuncts, short
// conjunct, or any conjunct unmatched.
fn n3_match_conj(c:*N3C,u:i32,co:i32,cl:i32,tainted_only:i32,no_subgoal:i32,m1:*i32,m2:*i32)i32 {
    let s:*N3S=c.*.s;let t:*N3T=c.*.t;let x:*N3X=c.*.x;
    let ab:[]u8=s.*.ar;
    let nm:i32=0;
    let cs:i32=co;let ce:i32=co+cl;
    let p:i32=cs;
    while(p<=ce){
        let nx:i32=n3_find_ci(ab,p,ce-p," and ");
        let cend:i32=ce;
        if(nx>=0){cend=nx;}
        let t0:i32=0;let t1:i32=0;
        n3_trim(ab,p,cend-p,&t0,&t1);
        if(t1<4){return -1;}
        nm=nm+1;
        if(nm>2){return -1;}
        let cw:[]u8=t.*.wa;let cn:[]u8=t.*.na;
        let ncw:i32=n5_collect(c,ab,t0,t1,-1,0,-1,0,-1,0,cw,192);
        let ncn:i32=n5_collect_neg(c,ab,t0,t1,-1,0,-1,0,-1,0,cn,192);
        if(ncw<1){return -1;}
        // find covering state
        let f:i32=-1;
        let q:i32=1;
        while(q<s.*.nst){
            if(q!=u && n3_sf(s,q,9)==0){
                let qsrc:i32=n3_sf(s,q,2);
                let ok:i32=0;
                if(qsrc==1 || qsrc==2 || qsrc==3 || qsrc==5 || qsrc==6){ok=1;}
                if(tainted_only==1 && n3_sf(s,q,12)==0){ok=0;}
                if(no_subgoal==1 && qsrc==4){ok=0;}
                if(ok==1){
                    let qo:i32=0;let ql:i32=0;
                    n3_sbytes(s,q,&qo,&ql);
                    let cc0:i32=0;let cc1:i32=0;let qq0:i32=0;let qq1:i32=0;
                    if(n3_cond_parse(ab,qo,ql,&cc0,&cc1,&qq0,&qq1)==1){ok=0;}
                }
                if(ok==1){
                    let qo:i32=0;let ql:i32=0;
                    n3_sbytes(s,q,&qo,&ql);
                    let qw:[]u8=t.*.wb;let qn:[]u8=t.*.nb;
                    let nqw:i32=n5_collect(c,ab,qo,ql,-1,0,-1,0,-1,0,qw,192);
                    let nqn:i32=n5_collect_neg(c,ab,qo,ql,-1,0,-1,0,-1,0,qn,192);
                    let cov:i32=1;
                    // the PBC assumption is externally negated ("It is not the
                    // case that P"): it matches a negative antecedent by word
                    // coverage alone, since per-word polarity is positional.
                    if(q==x.*.assum){
                        let aneg:i32=0;
                        if(ncn>0){aneg=1;}
                        if(aneg==0){cov=0;}
                        else {
                            let k:i32=0;
                            while(k<ncw){
                                if(n3_in_arr(qw,nqw,au_get64(cw,k))==0){cov=0;break;}
                                k=k+1;
                            }
                        }
                    } else {
                        let k:i32=0;
                        while(k<ncw){
                            let h:i64=au_get64(cw,k);
                            if(n3_in_arr(qw,nqw,h)==0){cov=0;break;}
                            let cneg:i32=n3_in_arr(cn,ncn,h);
                            let qneg:i32=n3_in_arr(qn,nqn,h);
                            if(cneg!=qneg){cov=0;break;}
                            k=k+1;
                        }
                    }
                    if(cov==1){f=q;break;}
                }
            }
            q=q+1;
        }
        if(f<0){return -1;}
        if(nm==1){m1.*=f;}
        if(nm==2){m2.*=f;}
        if(nx<0){break;}
        p=nx+5;
    }
    return nm;
}

// n5 licensor predicate: cites and premise-states, live, not defeated,
// with rule-strike kill (>=3 strikes -> SUSPECT, cannot license).
fn n5_is_lic(c:*N3C,d:i32)i32 {
    let s:*N3S=c.*.s;
    let src:i32=n3_sf(s,d,2);
    if(src!=1 && src!=6){return 0;}
    if(n3_sf(s,d,9)!=0){return 0;}
    if(src==1 && n3_sf(s,d,13)>=3){return 0;}
    return 1;
}

// L-UNIV: universal instantiation over byte shapes.
// Universal shapes on state u (cite/premise):
//   "Every <A> is a|an <B>."              -> VP="is a|an <B>"
//   "Every <A> is <B>."                    -> VP="is <B>"
//   "Every <A> that|who <VP1> <VP2>."      -> A=<A>, VP2=matrix (after modal
//        or second s-verb following VP1's first s-verb)
//   "Every <A> <VP>." (first s-verb)       -> A=<A>, VP=<VP>
//   "Everyone|Everything who|that ..."     -> A="" (class is everyone)
// Instance shapes on state q (live, src in {1,2,3,5,6}, not conditional):
//   "X is a|an <C>" with content(<C>) covering content(<A>) (either
//   direction on the smaller set), or X's predicate covering VP1-words
//   (relative-clause satisfaction: some asserted state covers X+VP1).
// Output: "X VP" bytes. lic=9, p1=u, p2=q.
fn n5_univ_parse(c:*N3C,u:i32,ao:*i32,al:*i32,vo:*i32,vl:*i32,rel:*i32,v1o:*i32,v1l:*i32)i32 {
    let s:*N3S=c.*.s;let w:*N3W=c.*.w;
    let ab:[]u8=s.*.ar;
    let bo:i32=0;let bl:i32=0;
    n3_sbytes(s,u,&bo,&bl);
    let t0:i32=0;let t1:i32=0;
    n3_trim(ab,bo,bl,&t0,&t1);
    let r0:i32=t0;
    let is_everyone:i32=0;
    if(n3_eq_ci(ab,r0,9,"everyone ",0,9)==1){is_everyone=1;r0=r0+8;}
    else if(n3_eq_ci(ab,r0,11,"everything ",0,11)==1){is_everyone=1;r0=r0+10;}
    else if(n3_eq_ci(ab,r0,6,"every ",0,6)==1){r0=r0+6;}
    else {return 0;}
    let re:i32=t0+t1;
    // shape 1: " is a|an " / " is "
    let pia:i32=n3_find_ci(ab,r0,re-r0," is a ");
    if(pia<0){pia=n3_find_ci(ab,r0,re-r0," is an ");}
    if(pia>=0){
        let a0:i32=0;let a1:i32=0;
        n3_trim(ab,r0,pia-r0,&a0,&a1);
        if(a1<1 && is_everyone==0){return 0;}
        ao.*=a0;al.*=a1;
        vo.*=pia+1;vl.*=re-(pia+1);
        rel.*=0;v1o.*=0;v1l.*=0;
        return 1;
    }
    let pis:i32=n3_find_ci(ab,r0,re-r0," is ");
    if(pis>=0){
        let a0:i32=0;let a1:i32=0;
        n3_trim(ab,r0,pis-r0,&a0,&a1);
        if(a1<1 && is_everyone==0){return 0;}
        ao.*=a0;al.*=a1;
        vo.*=pis+1;vl.*=re-(pis+1);
        rel.*=0;v1o.*=0;v1l.*=0;
        return 1;
    }
    // shape 2: " that "/" who " relative clause
    let pr:i32=n3_find_ci(ab,r0,re-r0," that ");
    let prl:i32=6;
    if(pr<0){pr=n3_find_ci(ab,r0,re-r0," who ");prl=5;}
    if(pr>=0){
        let a0:i32=0;let a1:i32=0;
        n3_trim(ab,r0,pr-r0,&a0,&a1);
        // find first s-verb in the remainder, then the matrix VP start:
        // first modal after it, else next s-verb, else the first s-verb.
        let rs:i32=pr+prl;
        let v1p:i32=-1;
        let cur:i32=0;let wo:i32=0;let wl:i32=0;
        while(n3_next_word(ab,rs,re-rs,&cur,&wo,&wl)==1){
            if(wl>2 && ab[wo+wl-1]==115 && n3_is_stop(w,ab,wo,wl)==0){v1p=wo;break;}
        }
        if(v1p<0){return 0;}
        let vpstart:i32=v1p;
        let cur2:i32=(v1p+wl)-rs;let wo2:i32=0;let wl2:i32=0;
        let mfound:i32=-1;let v2found:i32=-1;
        while(n3_next_word(ab,rs,re-rs,&cur2,&wo2,&wl2)==1){
            if(wo2<=v1p){continue;}
            if(n3_is_modal(w,ab,wo2,wl2)==1){mfound=wo2;break;}
            if(v2found<0 && wl2>2 && ab[wo2+wl2-1]==115 && n3_is_stop(w,ab,wo2,wl2)==0){v2found=wo2;}
        }
        if(mfound>=0){vpstart=mfound;}
        else if(v2found>=0){vpstart=v2found;}
        let v10:i32=0;let v11:i32=0;
        n3_trim(ab,v1p,vpstart-v1p,&v10,&v11);
        ao.*=a0;al.*=a1;
        vo.*=vpstart;vl.*=re-vpstart;
        rel.*=1;v1o.*=v10;v1l.*=v11;
        return 1;
    }
    // shape 3: first s-verb splits A/VP
    let cur3:i32=0;let wo3:i32=0;let wl3:i32=0;
    while(n3_next_word(ab,r0,re-r0,&cur3,&wo3,&wl3)==1){
        if(wl3>2 && ab[wo3+wl3-1]==115 && n3_is_stop(w,ab,wo3,wl3)==0){
            let a0:i32=0;let a1:i32=0;
            n3_trim(ab,r0,wo3-r0,&a0,&a1);
            if(a1<1){return 0;}
            ao.*=a0;al.*=a1;
            vo.*=wo3;vl.*=re-wo3;
            rel.*=0;v1o.*=0;v1l.*=0;
            return 1;
        }
    }
    return 0;
}

// L-UNIV firing: for each universal licensor u and each instance q,
// propose "X VP". lic=9.
fn n5_prop_univ(c:*N3C,th:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;let w:[]u8=s.*.wtmp;
    let d:i32=1;
    while(d<s.*.nst){
        if(n5_is_lic(c,d)==1){
            let ao:i32=0;let al:i32=0;let vo:i32=0;let vl:i32=0;
            let rel:i32=0;let v1o:i32=0;let v1l:i32=0;
            if(n5_univ_parse(c,d,&ao,&al,&vo,&vl,&rel,&v1o,&v1l)==1 && vl>=2){
                let q:i32=1;
                while(q<s.*.nst){
                    if(q!=d && n3_sf(s,q,9)==0){
                        let qsrc:i32=n3_sf(s,q,2);
                        if(qsrc==1 || qsrc==2 || qsrc==3 || qsrc==5 || qsrc==6){
                            let qo:i32=0;let ql:i32=0;
                            n3_sbytes(s,q,&qo,&ql);
                            let cc0:i32=0;let cc1:i32=0;let qq0:i32=0;let qq1:i32=0;
                            if(n3_cond_parse(ab,qo,ql,&cc0,&cc1,&qq0,&qq1)==0){
                                // shape A: "X is a|an <C>" (or lenient "X is <C>")
                                let iap:i32=n3_find_ci(ab,qo,ql," is a ");
                                let iapl:i32=6;
                                if(iap<0){iap=n3_find_ci(ab,qo,ql," is an ");iapl=7;}
                                if(iap<0){iap=n3_find_ci(ab,qo,ql," is ");iapl=4;}
                                if(iap>=0){
                                    let x0:i32=0;let x1:i32=0;let c0:i32=0;let c1:i32=0;
                                    n3_trim(ab,qo,iap-qo,&x0,&x1);
                                    n3_trim(ab,iap+iapl,qo+ql-(iap+iapl),&c0,&c1);
                                    if(x1>=1 && c1>=1 && al>=1){
                                        let aw:[]u8=t.*.wa;let cw2:[]u8=t.*.wb;
                                        let na2:i32=n5_collect(c,ab,ao,al,-1,0,-1,0,-1,0,aw,192);
                                        let nc2:i32=n5_collect(c,ab,c0,c1,-1,0,-1,0,-1,0,cw2,192);
                                        let ok:i32=1;
                                        if(na2<=nc2){
                                            let k:i32=0;
                                            while(k<na2){
                                                if(n3_in_arr(cw2,nc2,au_get64(aw,k))==0){ok=0;break;}
                                                k=k+1;
                                            }
                                        } else {
                                            let k:i32=0;
                                            while(k<nc2){
                                                if(n3_in_arr(aw,na2,au_get64(cw2,k))==0){ok=0;break;}
                                                k=k+1;
                                            }
                                        }
                                        if(ok==1 && na2>0 && nc2>0 && n3_used(t,th,9,d,q,-1)==0){
                                            let i:i32=0;
                                            while(i<x1){w[i]=ab[x0+i];i=i+1;}
                                            w[i]=32;i=i+1;
                                            let j:i32=0;
                                            while(j<vl){w[i+j]=ab[vo+j];j=j+1;}
                                            n3_pinit(p,9,d,q,-1,3,n3_sf(s,d,3));
                                            p.*.olen=i+j;
                                            return 1;
                                        }
                                    }
                                }
                                // shape B: relative-clause satisfaction
                                if(rel==1 && v1l>=1){
                                    let qw:[]u8=t.*.wa;let qn:[]u8=t.*.nb;
                                    let v1w:[]u8=t.*.wb;let v1n:[]u8=t.*.na;
                                    let nqw:i32=n5_collect(c,ab,qo,ql,-1,0,-1,0,-1,0,qw,192);
                                    let nqn:i32=n5_collect_neg(c,ab,qo,ql,-1,0,-1,0,-1,0,qn,192);
                                    let nv1:i32=n5_collect(c,ab,v1o,v1l,-1,0,-1,0,-1,0,v1w,192);
                                    let nv1n:i32=n5_collect_neg(c,ab,v1o,v1l,-1,0,-1,0,-1,0,v1n,192);
                                    let ok2:i32=1;
                                    if(nv1<1){ok2=0;}
                                    let k:i32=0;
                                    while(k<nv1){
                                        let h:i64=au_get64(v1w,k);
                                        if(n3_in_arr(qw,nqw,h)==0){ok2=0;break;}
                                        if(n3_in_arr(v1n,nv1n,h)!=n3_in_arr(qn,nqn,h)){ok2=0;break;}
                                        k=k+1;
                                    }
                                    if(ok2==1){
                                        let sx0:i32=0;let sx1:i32=0;
                                        n5_subject_span(c,ab,qo,ql,&sx0,&sx1);
                                        if(sx1>=1 && n3_used(t,th,9,d,q,-1)==0){
                                            let i:i32=0;
                                            while(i<sx1){w[i]=ab[sx0+i];i=i+1;}
                                            w[i]=32;i=i+1;
                                            let j:i32=0;
                                            while(j<vl){w[i+j]=ab[vo+j];j=j+1;}
                                            n3_pinit(p,9,d,q,-1,3,n3_sf(s,d,3));
                                            p.*.olen=i+j;
                                            return 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    q=q+1;
                }
            }
        }
        d=d+1;
    }
    return 0;
}

// L-DS: disjunctive syllogism. "… <L> or <R> …" (cite/premise, not
// conditional-shaped) + asserted state denying <L> (covers L's content
// words with at least one polarity flip) -> append <R> bytes. lic=10.
fn n5_prop_ds(c:*N3C,th:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;let w:[]u8=s.*.wtmp;
    let d:i32=1;
    while(d<s.*.nst){
        if(n5_is_lic(c,d)==1){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let cc0:i32=0;let cc1:i32=0;let qq0:i32=0;let qq1:i32=0;
            if(n3_cond_parse(ab,bo,bl,&cc0,&cc1,&qq0,&qq1)==0){
                let orp:i32=n3_find_ci(ab,bo,bl," or ");
                if(orp>=0){
                    let l0:i32=0;let l1:i32=0;let r0:i32=0;let r1:i32=0;
                    n3_trim(ab,bo,orp-bo,&l0,&l1);
                    n3_trim(ab,orp+4,bo+bl-(orp+4),&r0,&r1);
                    if(l1>=4 && r1>=1){
                        let lw:[]u8=t.*.wa;let ln:[]u8=t.*.na;
                        let nlw:i32=n5_collect(c,ab,l0,l1,-1,0,-1,0,-1,0,lw,192);
                        let nln:i32=n5_collect_neg(c,ab,l0,l1,-1,0,-1,0,-1,0,ln,192);
                        if(nlw>=1){
                            let q:i32=1;
                            while(q<s.*.nst){
                                if(q!=d && n3_sf(s,q,9)==0){
                                    let qsrc:i32=n3_sf(s,q,2);
                                    if(qsrc==1 || qsrc==2 || qsrc==3 || qsrc==5 || qsrc==6){
                                        let qo:i32=0;let ql:i32=0;
                                        n3_sbytes(s,q,&qo,&ql);
                                        let qw:[]u8=t.*.wb;let qn:[]u8=t.*.nb;
                                        let nqw:i32=n5_collect(c,ab,qo,ql,-1,0,-1,0,-1,0,qw,192);
                                        let nqn:i32=n5_collect_neg(c,ab,qo,ql,-1,0,-1,0,-1,0,qn,192);
                                        let deny:i32=1;let flip1:i32=0;
                                        let k:i32=0;
                                        while(k<nlw){
                                            let h:i64=au_get64(lw,k);
                                            if(n3_in_arr(qw,nqw,h)==0){deny=0;break;}
                                            if(n3_in_arr(ln,nln,h)!=n3_in_arr(qn,nqn,h)){flip1=1;}
                                            k=k+1;
                                        }
                                        if(deny==1 && flip1==1 && n3_used(t,th,10,d,q,-1)==0){
                                            n3_pinit(p,10,d,q,-1,3,n3_sf(s,d,3));
                                            p.*.olen=n3_wcpy(s,r0,r1);
                                            return 1;
                                        }
                                    }
                                }
                                q=q+1;
                            }
                        }
                    }
                }
            }
        }
        d=d+1;
    }
    return 0;
}


// ---------------- proposals ----------------
// Copy ar[bo..bo+bl) into wtmp; returns bl.
fn n3_wcpy(s:*N3S,bo:i32,bl:i32)i32 {
    let w:[]u8=s.*.wtmp;let ab:[]u8=s.*.ar;
    let i:i32=0;
    while(i<bl){w[i]=ab[bo+i];i=i+1;}
    return bl;
}
fn n3_pinit(p:*N3P,lic:i32,p1:i32,p2:i32,p3:i32,src:i32,kid:i32)void {
    p.*.lic=lic;p.*.p1=p1;p.*.p2=p2;p.*.p3=p3;p.*.src=src;p.*.kid=kid;p.*.olen=0;
}

// T-CONTRA: L0 assume negated goal; L1 expand definitions over tainted
// states; L2 apply conditionals with tainted antecedent matches.
fn n3_prop_contra(c:*N3C,round:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;let w:[]u8=s.*.wtmp;
    if(x.*.assum==-1 && n3_used(t,0,0,0,-1,-1)==0){
        let lit:[]u8="It is not the case that ";
        let i:i32=0;
        while(i<lit.len){w[i]=lit[i];i=i+1;}
        let j:i32=0;
        while(j<x.*.gollen){w[i+j]=x.*.goal[j];j=j+1;}
        n3_pinit(p,0,0,-1,-1,2,0);
        p.*.olen=i+j;
        return 1;
    }
    // L1: definition expansion over tainted states
    let d:i32=1;
    while(d<s.*.nst){
        if(n5_is_lic(c,d)==1){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let ho:i32=0;let hl:i32=0;let yo:i32=0;let yl:i32=0;
            if(n3_def_parse(ab,bo,bl,&ho,&hl,&yo,&yl)==1){
                let ko:i32=0;let kl:i32=0;
                if(n3_def_key(c,ab,ho,hl,&ko,&kl)==1){
                    let q:i32=0;
                    while(q<s.*.nst){
                        if(q!=d && n3_sf(s,q,9)==0 && n3_sf(s,q,12)==1){
                            let qo:i32=0;let ql:i32=0;
                            n3_sbytes(s,q,&qo,&ql);
                            if(n3_find_word_ci(ab,qo,ql,ab[ko..ko+kl])>=0 && n3_used(t,0,1,d,q,-1)==0){
                                n3_pinit(p,1,d,q,-1,3,n3_sf(s,d,3));
                                p.*.olen=n3_wcpy(s,yo,yl);
                                return 1;
                            }
                        }
                        q=q+1;
                    }
                }
            }
        }
        d=d+1;
    }
    // L2: conditional application, tainted antecedent matches
    d=1;
    while(d<s.*.nst){
        if(n5_is_lic(c,d)==1){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
            if(n3_cond_parse(ab,bo,bl,&co,&cl,&qo,&ql)==1){
                let m1:i32=-1;let m2:i32=-1;
                if(n3_match_conj(c,d,co,cl,1,1,&m1,&m2)>=1){
                    // m2==-1 iff a single conjunct (state ids are >=0)
                    if(n3_used(t,0,2,d,m1,m2)==0){
                        n3_pinit(p,2,d,m1,m2,3,n3_sf(s,d,3));
                        p.*.olen=n3_wcpy(s,qo,ql);
                        return 1;
                    }
                }
            }
        }
        d=d+1;
    }
    return 0;
}

// T-CONSTRUCT: L3 definition expansion over all live states;
// L4 biconditional (" iff ") forward elimination.
fn n3_prop_construct(c:*N3C,round:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;
    let d:i32=1;
    while(d<s.*.nst){
        if(n5_is_lic(c,d)==1){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let ho:i32=0;let hl:i32=0;let yo:i32=0;let yl:i32=0;
            if(n3_def_parse(ab,bo,bl,&ho,&hl,&yo,&yl)==1){
                let ko:i32=0;let kl:i32=0;
                if(n3_def_key(c,ab,ho,hl,&ko,&kl)==1){
                    let q:i32=0;
                    while(q<s.*.nst){
                        if(q!=d && n3_sf(s,q,9)==0){
                            let qo:i32=0;let ql:i32=0;
                            n3_sbytes(s,q,&qo,&ql);
                            if(n3_find_word_ci(ab,qo,ql,ab[ko..ko+kl])>=0 && n3_used(t,1,3,d,q,-1)==0){
                                n3_pinit(p,3,d,q,-1,3,n3_sf(s,d,3));
                                p.*.olen=n3_wcpy(s,yo,yl);
                                return 1;
                            }
                        }
                        q=q+1;
                    }
                }
                // L4: " iff " in body
                let ip:i32=n3_find_ci(ab,yo,yl," iff ");
                if(ip>=0){
                    let l0:i32=0;let l1:i32=0;let r0:i32=0;let r1:i32=0;
                    n3_trim(ab,yo,ip-yo,&l0,&l1);
                    n3_trim(ab,ip+5,yo+yl-(ip+5),&r0,&r1);
                    if(l1>=4 && r1>=1){
                        let q:i32=0;
                        while(q<s.*.nst){
                            if(q!=d && n3_sf(s,q,9)==0){
                                let qo:i32=0;let ql:i32=0;
                                n3_sbytes(s,q,&qo,&ql);
                                if(n3_find_ci(ab,qo,ql,ab[l0..l0+l1])>=0 && n3_used(t,1,4,d,q,-1)==0){
                                    n3_pinit(p,4,d,q,-1,3,n3_sf(s,d,3));
                                    p.*.olen=n3_wcpy(s,r0,r1);
                                    return 1;
                                }
                            }
                            q=q+1;
                        }
                    }
                }
            }
        }
        d=d+1;
    }
    return 0;
}

// T-LEMMA: L5 conditional application; antecedent conjuncts must be
// byte-substrings of live, non-defeated, non-subgoal states.
fn n3_prop_lemma(c:*N3C,round:i32,p:*N3P,th:i32)i32 {
    let s:*N3S=c.*.s;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;
    let d:i32=1;
    while(d<s.*.nst){
        if(n5_is_lic(c,d)==1){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
            if(n3_cond_parse(ab,bo,bl,&co,&cl,&qo,&ql)==1){
                let m1:i32=-1;let m2:i32=-1;
                if(n3_match_conj(c,d,co,cl,0,1,&m1,&m2)>=1){
                    if(n3_used(t,th,5,d,m1,m2)==0){
                        n3_pinit(p,5,d,m1,m2,3,n3_sf(s,d,3));
                        p.*.olen=n3_wcpy(s,qo,ql);
                        return 1;
                    }
                }
            }
        }
        d=d+1;
    }
    return 0;
}

// ---------------- cross-problem lemma cache ----------------
// File format (one per line): <antecedent>\t<consequent>\t<origin-pid>
// Lookup requires the current asserted bytes to re-ground the antecedent
// (no import of unsupported facts); the signature is FNV-1a over the sorted
// antecedent content word hashes, used only for deterministic ordering.
fn n5_cache_sig(c:*N3C,b:[]u8,off:i32,len:i32)i64 {
    let t:*N3T=c.*.t;
    let aw:[]u8=t.*.wa;
    let n:i32=n5_collect(c,b,off,len,-1,0,-1,0,-1,0,aw,192);
    let i:i32=1;
    while(i<n){
        let h:i64=au_get64(aw,i);
        let j:i32=i-1;
        while(j>=0 && au_get64(aw,j)>h){au_put64(aw,j+1,au_get64(aw,j));j=j-1;}
        au_put64(aw,j+1,h);
        i=i+1;
    }
    let sg:i64=-3750763034362895579;
    i=0;
    while(i<n){
        sg=sg ^ au_get64(aw,i);
        sg=sg*1099511628211;
        i=i+1;
    }
    return sg;
}
fn n5_cache_load(c:*N3C,path:[]u8,plen:i32)i32 {
    if(plen<1){return 0;}
    let t:*N3T=c.*.t;
    let buf:[]u8=nio_alloc(262144);
    if(buf.len!=262144){return -1;}
    let n:i64=dlb_read_file(path,buf);
    if(n<=0){nio_free(buf);return 0;}
    let nl:i32=n as i32;
    let pos:i32=0;
    while(pos<nl && t.*.ch_n<256){
        let e:i32=pos;
        while(e<nl && buf[e]!=10){e=e+1;}
        let f1:i32=-1;let f2:i32=-1;
        let k:i32=pos;
        while(k<e){
            if(buf[k]==9){if(f1<0){f1=k;}else{f2=k;break;}}
            k=k+1;
        }
        if(f1>pos && f2>f1 && f2<e){
            let al:i32=f1-pos;let cl:i32=f2-(f1+1);let ol2:i32=e-(f2+1);
            if(al>=4 && cl>=4 && ol2>=1 && t.*.ch_an+al+cl+64<262144){
                let ao2:i32=t.*.ch_an;
                let j:i32=0;
                while(j<al){t.*.ch_ar[ao2+j]=buf[pos+j];j=j+1;}
                let co2:i32=ao2+al;
                j=0;
                while(j<cl){t.*.ch_ar[co2+j]=buf[f1+1+j];j=j+1;}
                let oo2:i32=co2+cl;
                j=0;
                while(j<ol2 && j<63){t.*.ch_ar[oo2+j]=buf[f2+1+j];j=j+1;}
                t.*.ch_an=oo2+ol2;
                let sg:i64=n5_cache_sig(c,t.*.ch_ar,ao2,al);
                let en2:i32=t.*.ch_n;
                let ins:i32=en2;
                while(ins>0 && au_get64(t.*.ch_sig,ins-1)>sg){
                    au_put64(t.*.ch_sig,ins,au_get64(t.*.ch_sig,ins-1));
                    au_put32(t.*.ch_aoff,ins,au_get32(t.*.ch_aoff,ins-1));
                    au_put32(t.*.ch_alen,ins,au_get32(t.*.ch_alen,ins-1));
                    au_put32(t.*.ch_coff,ins,au_get32(t.*.ch_coff,ins-1));
                    au_put32(t.*.ch_clen,ins,au_get32(t.*.ch_clen,ins-1));
                    au_put32(t.*.ch_or,ins,au_get32(t.*.ch_or,ins-1));
                    ins=ins-1;
                }
                au_put64(t.*.ch_sig,ins,sg);
                au_put32(t.*.ch_aoff,ins,ao2);
                au_put32(t.*.ch_alen,ins,al);
                au_put32(t.*.ch_coff,ins,co2);
                au_put32(t.*.ch_clen,ins,cl);
                au_put32(t.*.ch_or,ins,oo2);
                t.*.ch_n=en2+1;
            }
        }
        pos=e+1;
    }
    nio_free(buf);
    return 0;
}
// L-CACHE: fire cached lemmas whose antecedent is re-grounded by live
// asserted bytes. lic=11, p1=asserter, p2=cache entry index.
fn n5_cache_fire(c:*N3C,th:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;let w:[]u8=s.*.wtmp;
    let e:i32=0;
    while(e<t.*.ch_n){
        let ao2:i32=au_get32(t.*.ch_aoff,e);let al:i32=au_get32(t.*.ch_alen,e);
        let co2:i32=au_get32(t.*.ch_coff,e);let cl:i32=au_get32(t.*.ch_clen,e);
        let aw:[]u8=t.*.wa;let an2:[]u8=t.*.na;
        let naw:i32=n5_collect(c,t.*.ch_ar,ao2,al,-1,0,-1,0,-1,0,aw,192);
        let nan:i32=n5_collect_neg(c,t.*.ch_ar,ao2,al,-1,0,-1,0,-1,0,an2,192);
        if(naw>=1 && n3_used(t,th,11,e,-1,-1)==0){
            let q:i32=1;
            while(q<s.*.nst){
                if(n3_sf(s,q,9)==0){
                    let qsrc:i32=n3_sf(s,q,2);
                    if(qsrc==1 || qsrc==2 || qsrc==3 || qsrc==5 || qsrc==6){
                        let qo:i32=0;let ql:i32=0;
                        n3_sbytes(s,q,&qo,&ql);
                        let cc0:i32=0;let cc1:i32=0;let qq0:i32=0;let qq1:i32=0;
                        if(n3_cond_parse(ab,qo,ql,&cc0,&cc1,&qq0,&qq1)==0){
                            let qw:[]u8=t.*.wb;let qn:[]u8=t.*.nb;
                            let nqw:i32=n5_collect(c,ab,qo,ql,-1,0,-1,0,-1,0,qw,192);
                            let nqn:i32=n5_collect_neg(c,ab,qo,ql,-1,0,-1,0,-1,0,qn,192);
                            let cov:i32=1;let k:i32=0;
                            while(k<naw){
                                let h:i64=au_get64(aw,k);
                                if(n3_in_arr(qw,nqw,h)==0){cov=0;break;}
                                if(n3_in_arr(an2,nan,h)!=n3_in_arr(qn,nqn,h)){cov=0;break;}
                                k=k+1;
                            }
                            if(cov==1){
                                n3_pinit(p,11,q,e,-1,3,0);
                                let i2:i32=0;
                                while(i2<cl){w[i2]=t.*.ch_ar[co2+i2];i2=i2+1;}
                                p.*.olen=cl;
                                return 1;
                            }
                        }
                    }
                }
                q=q+1;
            }
        }
        e=e+1;
    }
    return 0;
}
// Stage this run's new lemmas (deduped against the loaded cache) into o:
// single-antecedent derived steps (UNIV, DS, single-conjunct MP) whose
// asserter is live, untainted, and asserted.
fn n5_cache_stage(c:*N3C,o:*DOut)void {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;
    let id:i32=0;
    while(id<s.*.nst){
        if(n3_sf(s,id,9)==0 && n3_sf(s,id,2)==3){
            let lic:i32=n3_sf(s,id,4);
            let p1:i32=n3_sf(s,id,5);let p2:i32=n3_sf(s,id,6);let p3:i32=n3_sf(s,id,7);
            let ok0:i32=0;
            if(lic==9 || lic==10){ok0=1;}
            if(lic==5 && p3<0){ok0=1;}
            if(ok0==1 && p2>=0 && p2<s.*.nst && n3_sf(s,p2,9)==0 && n3_sf(s,p2,12)==0){
                let p2src:i32=n3_sf(s,p2,2);
                if(p2src==1 || p2src==2 || p2src==3 || p2src==5 || p2src==6){
                    let ao2:i32=0;let al:i32=0;
                    n3_sbytes(s,p2,&ao2,&al);
                    let co2:i32=0;let cl:i32=0;
                    n3_sbytes(s,id,&co2,&cl);
                    let trivial:i32=0;
                    if(al==cl && nio_equal(ab[ao2..ao2+al],ab[co2..co2+cl])==1){trivial=1;}
                    // dedup against loaded entries
                    let dup:i32=0;
                    if(trivial==0){
                        let sg:i64=n5_cache_sig(c,ab,ao2,al);
                        let e2:i32=0;
                        while(e2<t.*.ch_n){
                            if(au_get64(t.*.ch_sig,e2)==sg){
                                let a2:i32=au_get32(t.*.ch_aoff,e2);let l2:i32=au_get32(t.*.ch_alen,e2);
                                let c2:i32=au_get32(t.*.ch_coff,e2);let d2:i32=au_get32(t.*.ch_clen,e2);
                                if(l2==al && d2==cl && nio_equal(t.*.ch_ar[a2..a2+l2],ab[ao2..ao2+al])==1 && nio_equal(t.*.ch_ar[c2..c2+d2],ab[co2..co2+cl])==1){dup=1;break;}
                            }
                            e2=e2+1;
                        }
                    }
                    if(trivial==0 && dup==0 && al<2000 && cl<2000){
                        dout_str(o,ab[ao2..ao2+al]);
                        dout_str(o,"\t");
                        dout_str(o,ab[co2..co2+cl]);
                        dout_str(o,"\t");
                        dout_str(o,x.*.pid[0..x.*.pidlen]);
                        dout_line(o);
                    }
                }
            }
        }
        id=id+1;
    }
}
// T-GOAL: L6 definition splice into goal; L7 plant antecedent as subgoal;
// L8 close subgoal via word-inclusion establisher; L11 lemma-cache firing.
fn n3_prop_goal(c:*N3C,round:i32,p:*N3P,th:i32)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;
    let ab:[]u8=s.*.ar;let w:[]u8=s.*.wtmp;
    // L6: definition splice
    let d:i32=1;
    while(d<s.*.nst){
        if(n5_is_lic(c,d)==1){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let ho:i32=0;let hl:i32=0;let yo:i32=0;let yl:i32=0;
            if(n3_def_parse(ab,bo,bl,&ho,&hl,&yo,&yl)==1){
                let ko:i32=0;let kl:i32=0;
                if(n3_def_key(c,ab,ho,hl,&ko,&kl)==1){
                    if(n3_find_word_ci(ab,x.*.goff,x.*.glen,ab[ko..ko+kl])>=0 && n3_used(t,th,6,d,-1,-1)==0){
                        n3_pinit(p,6,d,-1,-1,3,n3_sf(s,d,3));
                        p.*.olen=n3_wcpy(s,yo,yl);
                        return 1;
                    }
                }
            }
        }
        d=d+1;
    }
    // L7: plant a conditional's antecedent as a subgoal of the goal shape
    d=1;
    while(d<s.*.nst){
        if(n5_is_lic(c,d)==1){
            let bo:i32=0;let bl:i32=0;
            n3_sbytes(s,d,&bo,&bl);
            let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
            if(n3_cond_parse(ab,bo,bl,&co,&cl,&qo,&ql)==1){
                let qa:[]u8=t.*.wa;
                let nqa:i32=n5_collect(c,ab,qo,ql,-1,0,-1,0,-1,0,qa,192);
                let qg:[]u8=t.*.wb;
                let nqg:i32=n5_collect(c,ab,x.*.goff,x.*.glen,-1,0,-1,0,-1,0,qg,192);
                let ov:i32=0;let k:i32=0;
                while(k<nqa){
                    if(n3_in_arr(qg,nqg,au_get64(qa,k))==1){ov=ov+1;}
                    k=k+1;
                }
                if(ov>=1 && n3_used(t,th,7,d,-1,-1)==0){
                    n3_pinit(p,7,d,-1,-1,4,0);
                    p.*.olen=n3_wcpy(s,co,cl);
                    return 1;
                }
            }
        }
        d=d+1;
    }
    // L8: close a planted subgoal via an establishing state (word-inclusion,
    // polarity-aware coverage; conditional-shaped states cannot establish)
    let b:i32=1;
    while(b<s.*.nst){
        if(n3_sf(s,b,2)==4 && n3_sf(s,b,9)==0){
            let u:i32=n3_sf(s,b,5);
            if(u>0 && u<s.*.nst && n3_sf(s,u,9)==0 && n5_is_lic(c,u)==1){
                let uo:i32=0;let ul:i32=0;
                n3_sbytes(s,u,&uo,&ul);
                let co:i32=0;let cl:i32=0;let qo:i32=0;let ql:i32=0;
                if(n3_cond_parse(ab,uo,ul,&co,&cl,&qo,&ql)==1){
                    let so:i32=0;let sl:i32=0;
                    n3_sbytes(s,b,&so,&sl);
                    let sw:[]u8=t.*.wa;let sn:[]u8=t.*.na;
                    let nsw:i32=n5_collect(c,ab,so,sl,-1,0,-1,0,-1,0,sw,192);
                    let nsn:i32=n5_collect_neg(c,ab,so,sl,-1,0,-1,0,-1,0,sn,192);
                    if(nsw>=1){
                        let q:i32=1;
                        while(q<s.*.nst){
                            if(q!=b && q!=u && n3_sf(s,q,9)==0){
                                let qsrc:i32=n3_sf(s,q,2);
                                if(qsrc==1 || qsrc==2 || qsrc==3 || qsrc==5 || qsrc==6){
                                    let qo2:i32=0;let ql2:i32=0;
                                    n3_sbytes(s,q,&qo2,&ql2);
                                    let cc0:i32=0;let cc1:i32=0;let qq0:i32=0;let qq1:i32=0;
                                    if(n3_cond_parse(ab,qo2,ql2,&cc0,&cc1,&qq0,&qq1)==0){
                                        let qw:[]u8=t.*.wb;let qn:[]u8=t.*.nb;
                                        let nqw:i32=n5_collect(c,ab,qo2,ql2,-1,0,-1,0,-1,0,qw,192);
                                        let nqn:i32=n5_collect_neg(c,ab,qo2,ql2,-1,0,-1,0,-1,0,qn,192);
                                        let cov:i32=1;let k:i32=0;
                                        while(k<nsw){
                                            let h:i64=au_get64(sw,k);
                                            if(n3_in_arr(qw,nqw,h)==0){cov=0;break;}
                                            if(n3_in_arr(sn,nsn,h)!=n3_in_arr(qn,nqn,h)){cov=0;break;}
                                            k=k+1;
                                        }
                                        if(cov==1 && n3_used(t,th,8,u,b,q)==0){
                                            n3_pinit(p,8,u,b,q,3,n3_sf(s,u,3));
                                            p.*.olen=n3_wcpy(s,qo2,ql2);
                                            return 1;
                                        }
                                    }
                                }
                            }
                            q=q+1;
                        }
                    }
                }
            }
        }
        b=b+1;
    }
    // L11: lemma-cache firing
    if(n5_cache_fire(c,th,p)==1){return 1;}
    return 0;
}

fn n3_propose(c:*N3C,th:i32,round:i32,p:*N3P)i32 {
    if(th==0){return n3_prop_contra(c,round,p);}
    if(th==1){return n3_prop_forward(c,round,p);}
    return n3_prop_goal(c,round,p,th);
}
// T-FORWARD: constructive licenses in priority order.
fn n3_prop_forward(c:*N3C,round:i32,p:*N3P)i32 {
    if(n3_prop_lemma(c,round,p,1)==1){return 1;}
    if(n5_prop_univ(c,1,p)==1){return 1;}
    if(n5_prop_ds(c,1,p)==1){return 1;}
    if(n3_prop_construct(c,round,p)==1){return 1;}
    return 0;
}

// ---------------- logging ----------------
fn n3_log(au:*DOut,s:[]u8)void { dout_str(au,s);dout_line(au); }
fn n3_log1(au:*DOut,s:[]u8,v:i64)void { dout_str(au,s);dout_i64(au,v);dout_line(au); }
fn n3_tname(t:i32)[]u8 {
    if(t==0){return "CONTRA";}
    if(t==1){return "FORWARD";}
    return "GOAL";
}
fn n3_lname(lic:i32)[]u8 {
    if(lic==0){return "contra-assume";}
    if(lic==1){return "contra-expand";}
    if(lic==2){return "contra-apply";}
    if(lic==3){return "construct-expand";}
    if(lic==4){return "construct-iff";}
    if(lic==5){return "lemma-apply";}
    if(lic==6){return "goal-defsplice";}
    if(lic==7){return "goal-lemmasub";}
    if(lic==8){return "goal-close";}
    if(lic==9){return "univ-inst";}
    if(lic==10){return "disj-syll";}
    if(lic==11){return "cache-fire";}
    if(lic==99){return "pbc-goal";}
    return "pbc-goal";
}
fn n3_srcname(src:i32)[]u8 {
    if(src==0){return "input";}
    if(src==1){return "cite";}
    if(src==2){return "assume";}
    if(src==3){return "prop";}
    if(src==4){return "subgoal";}
    if(src==6){return "premise";}
    return "pbc";
}
fn n3_phead(au:*DOut,round:i32,th:i32,p:*N3P)void {
    dout_str(au,"R");dout_i64(au,round as i64);
    dout_str(au," T");dout_i64(au,th as i64);
    dout_str(au," ");dout_str(au,n3_tname(th));
    dout_str(au," L");dout_i64(au,p.*.lic as i64);
    dout_str(au," ");dout_str(au,n3_lname(p.*.lic));
    dout_str(au," p=[");dout_i64(au,p.*.p1 as i64);
    dout_str(au,",");dout_i64(au,p.*.p2 as i64);
    dout_str(au,",");dout_i64(au,p.*.p3 as i64);
    dout_str(au,"]");
}
fn n3_log_app(au:*DOut,round:i32,th:i32,p:*N3P,id:i32)void {
    n3_phead(au,round,th,p);
    dout_str(au," -> S");dout_i64(au,id as i64);
    dout_str(au," APPEND");dout_line(au);
}
fn n3_log_ref(au:*DOut,round:i32,th:i32,p:*N3P,cb:[]u8,nc:i32,strikes:i32)void {
    n3_phead(au,round,th,p);
    dout_str(au," REFUSED contra=[");
    let k:i32=0;
    while(k<nc && k<8){
        if(k>0){dout_str(au,",");}
        dout_str(au,"S");dout_i64(au,au_get32(cb,k) as i64);
        k=k+1;
    }
    dout_str(au,"] strikes=");dout_i64(au,strikes as i64);dout_line(au);
}
fn n3_log_dis(au:*DOut,round:i32,th:i32,p:*N3P,id:i32,cb:[]u8,nc:i32)void {
    n3_phead(au,round,th,p);
    dout_str(au," DISCHARGE assum=[");
    let k:i32=0;
    while(k<nc && k<8){
        if(k>0){dout_str(au,",");}
        dout_str(au,"S");dout_i64(au,au_get32(cb,k) as i64);
        k=k+1;
    }
    dout_str(au,"] -> S");dout_i64(au,id as i64);
    dout_str(au," APPEND");dout_line(au);
}
fn n3_log_pbc(au:*DOut,round:i32,th:i32,p:*N3P,gid:i32,cb:[]u8,nc:i32)void {
    n3_phead(au,round,th,p);
    dout_str(au," PBC-FIRED contra=[");
    let k:i32=0;
    while(k<nc && k<8){
        if(k>0){dout_str(au,",");}
        dout_str(au,"S");dout_i64(au,au_get32(cb,k) as i64);
        k=k+1;
    }
    dout_str(au,"] GOAL -> S");dout_i64(au,gid as i64);
    dout_str(au," APPEND");dout_line(au);
}

// premise depth = 1 + max premise depth.
fn n3_pdepth(s:*N3S,p:*N3P)i32 {
    let m:i32=0;
    if(p.*.p1>=0 && n3_sf(s,p.*.p1,8)>m){m=n3_sf(s,p.*.p1,8);}
    if(p.*.p2>=0 && n3_sf(s,p.*.p2,8)>m){m=n3_sf(s,p.*.p2,8);}
    if(p.*.p3>=0 && n3_sf(s,p.*.p3,8)>m){m=n3_sf(s,p.*.p3,8);}
    return m+1;
}
// n5_pron_ground: 1 iff some pronoun in b[off..off+len) has goal-word g as
// a stemmed content word earlier in the same sentence (pronoun tolerance:
// "the rose ... it" covers "water" when the licensor grounds "it").
fn n5_pron_ground(c:*N3C,b:[]u8,off:i32,len:i32,g:i64)i32 {
    let w:*N3W=c.*.w;
    let cur:i32=0;let wo:i32=0;let wl:i32=0;
    while(n3_next_word(b,off,len,&cur,&wo,&wl)==1){
        if(n3_is_pron(w,b,wo,wl)==1){
            let ss:i32=wo-1;
            while(ss>=off && b[ss]!=46 && b[ss]!=33 && b[ss]!=63){ss=ss-1;}
            ss=ss+1;
            let c2:i32=0;let o2:i32=0;let l2:i32=0;
            while(n3_next_word(b,ss,wo-ss,&c2,&o2,&l2)==1){
                let h:i64=0;
                if(n3_stem_hash(w,b,o2,l2,&h)==1 && h==g){return 1;}
            }
        }
    }
    return 0;
}
// n5 goal satisfaction: polarity-aware content coverage. Every goal content
// word must occur among the derived state's content words, or be grounded
// through a same-sentence pronoun in the derived bytes or the licensing
// state's bytes (licstate = p1, or -1).
fn n3_goal_match(c:*N3C,ob:[]u8,olen:i32,licstate:i32)i32 {
    let x:*N3X=c.*.x;let t:*N3T=c.*.t;
    let ngw:i32=x.*.ngw;
    if(ngw<1){return 0;}
    let gw:[]u8=x.*.gw;
    let dw:[]u8=t.*.wa;
    let ndw:i32=n5_collect(c,ob,0,olen,-1,0,-1,0,-1,0,dw,192);
    let i:i32=0;
    while(i<ngw){
        let g:i64=au_get64(gw,i);
        if(n3_in_arr(dw,ndw,g)==1){i=i+1;continue;}
        let ok:i32=0;
        if(n5_pron_ground(c,ob,0,olen,g)==1){ok=1;}
        if(ok==0 && licstate>=0){
            let s:*N3S=c.*.s;
            let lo:i32=0;let ll:i32=0;
            n3_sbytes(s,licstate,&lo,&ll);
            if(n5_pron_ground(c,s.*.ar,lo,ll,g)==1){ok=1;}
        }
        if(ok==0){return 0;}
        i=i+1;
    }
    return 1;
}

// ---------------- adjudication ----------------
// Returns: 0 dup-skip, 1 appended, 2 refused, 3 discharged+appended, 4 DERIVED.
fn n3_adjudicate(c:*N3C,th:i32,round:i32,p:*N3P)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;let au:*DOut=c.*.au;
    let w:[]u8=s.*.wtmp;let ol:i32=p.*.olen;
    if(ol<1){return 0;}
    // duplicate of any existing ledger state -> skip, mark used
    let d:i32=0;
    while(d<s.*.nst){
        let bo:i32=0;let bl:i32=0;
        n3_sbytes(s,d,&bo,&bl);
        if(bl==ol && nio_equal(s.*.ar[bo..bo+bl],w[0..ol])==1){
            n3_mark_used(t,th,p.*.lic,p.*.p1,p.*.p2,p.*.p3);
            au_put32(t.*.cred,th,au_get32(t.*.cred,th)-1);
            n3_phead(au,round,th,p);
            dout_str(au," DUP-SKIP");dout_line(au);
            return 0;
        }
        d=d+1;
    }
    // n5 depth bound: proposals deeper than maxdepth are skipped (dup-like)
    if(n3_pdepth(s,p)>x.*.maxdepth){
        n3_mark_used(t,th,p.*.lic,p.*.p1,p.*.p2,p.*.p3);
        au_put32(t.*.cred,th,au_get32(t.*.cred,th)-1);
        n3_phead(au,round,th,p);
        dout_str(au," DEPTH-SKIP");dout_line(au);
        return 0;
    }
    // contradiction scan vs all live states
    let cb:[]u8=nio_alloc(8*4);
    if(cb.len!=32){return 0;}
    let nc:i32=0;let nona:i32=0;
    let b:i32=0;
    while(b<s.*.nst){
        if(b!=0 && n3_sf(s,b,9)==0 && n5_contra_state(c,w,ol,b)==1){
            if(nc<8){au_put32(cb,nc,b);}
            nc=nc+1;
            if(n3_sf(s,b,2)!=2){nona=1;}
        }
        b=b+1;
    }
    if(nc==0){
        let id:i32=n3_append(c,p.*.src,p.*.kid,p.*.lic,p.*.p1,p.*.p2,p.*.p3,n3_pdepth(s,p),th,round,w,ol);
        n3_mark_used(t,th,p.*.lic,p.*.p1,p.*.p2,p.*.p3);
        au_put32(t.*.strs,th,0);
        // n5 credits: +2 append, +3 goal-overlap; appends wake sleepers
        au_put32(t.*.cred,th,au_get32(t.*.cred,th)+2);
        let pw2:[]u8=t.*.wb;
        let npw2:i32=n5_collect(c,w,0,ol,-1,0,-1,0,-1,0,pw2,192);
        let gov2:i32=0;let gi2:i32=0;
        while(gi2<x.*.ngw){
            if(n3_in_arr(pw2,npw2,au_get64(x.*.gw,gi2))==1){gov2=1;break;}
            gi2=gi2+1;
        }
        if(gov2==1){au_put32(t.*.cred,th,au_get32(t.*.cred,th)+3);}
        let wk2:i32=0;
        while(wk2<3){au_put32(t.*.dorm,wk2,0);wk2=wk2+1;}
        if(p.*.src==2){x.*.assum=id;}
        n3_log_app(au,round,th,p,id);
        nio_free(cb);
        if(id>=0 && p.*.src!=2 && n3_goal_match(c,w,ol,p.*.p1)==1){
            x.*.derived_by=th;
            return 4;
        }
        return 1;
    }
    if(nona==0){
        // discharge: contradict only assumptions -> defeat them and all
        // assumption-tainted states, then append the proposal.
        let k:i32=0;
        while(k<nc && k<8){n3_setf(s,au_get32(cb,k),9,1);k=k+1;}
        x.*.assum=-1;
        let q2:i32=0;
        while(q2<s.*.nst){
            if(n3_sf(s,q2,9)==0 && n3_sf(s,q2,12)==1){n3_setf(s,q2,9,1);}
            q2=q2+1;
        }
        au_put32(s.*.ev,1,au_get32(s.*.ev,1)+1);
        let id:i32=n3_append(c,p.*.src,p.*.kid,p.*.lic,p.*.p1,p.*.p2,p.*.p3,n3_pdepth(s,p),th,round,w,ol);
        n3_mark_used(t,th,p.*.lic,p.*.p1,p.*.p2,p.*.p3);
        au_put32(t.*.strs,th,0);
        au_put32(t.*.cred,th,au_get32(t.*.cred,th)+2);
        let pw3:[]u8=t.*.wb;
        let npw3:i32=n5_collect(c,w,0,ol,-1,0,-1,0,-1,0,pw3,192);
        let gov3:i32=0;let gi3:i32=0;
        while(gi3<x.*.ngw){
            if(n3_in_arr(pw3,npw3,au_get64(x.*.gw,gi3))==1){gov3=1;break;}
            gi3=gi3+1;
        }
        if(gov3==1){au_put32(t.*.cred,th,au_get32(t.*.cred,th)+3);}
        let wk3:i32=0;
        while(wk3<3){au_put32(t.*.dorm,wk3,0);wk3=wk3+1;}
        n3_log_dis(au,round,th,p,id,cb,nc);
        nio_free(cb);
        if(id>=0 && p.*.src!=2 && n3_goal_match(c,w,ol,p.*.p1)==1){
            x.*.derived_by=th;
            return 4;
        }
        return 3;
    }
    // refused
    let st2:i32=au_get32(t.*.strs,th)+1;
    au_put32(t.*.strs,th,st2);
    n3_mark_used(t,th,p.*.lic,p.*.p1,p.*.p2,p.*.p3);
    au_put32(t.*.cred,th,au_get32(t.*.cred,th)-1);
    // n5 rule strike: a step refused for contradicting live knowledge strikes
    // its licensing cited rule; three strikes disable the rule.
    if(p.*.p1>=0 && n3_sf(s,p.*.p1,2)==1){
        let sk2:i32=n3_sf(s,p.*.p1,13)+1;
        n3_setf(s,p.*.p1,13,sk2);
        n3_phead(au,round,th,p);
        dout_str(au," RULE-STRIKE S");dout_i64(au,p.*.p1 as i64);
        dout_str(au," n=");dout_i64(au,sk2 as i64);dout_line(au);
    }
    n3_log_ref(au,round,th,p,cb,nc,st2);
    // PBC route: T-CONTRA with an assumption-tainted chain whose CONSEQUENCE
    // (src==prop, never the assumption itself) contradicts live
    // non-assumption knowledge -> the assumption is impossible; defeat it and
    // its chain, append the goal skeleton.
    let tainted:i32=0;
    if(p.*.p1>=0 && n3_sf(s,p.*.p1,12)==1){tainted=1;}
    if(p.*.p2>=0 && n3_sf(s,p.*.p2,12)==1){tainted=1;}
    if(p.*.p3>=0 && n3_sf(s,p.*.p3,12)==1){tainted=1;}
    if(th==0 && p.*.src==3 && tainted==1){
        let k:i32=0;
        while(k<s.*.nst){
            if(n3_sf(s,k,9)==0 && (n3_sf(s,k,2)==2 || n3_sf(s,k,12)==1)){n3_setf(s,k,9,1);}
            k=k+1;
        }
        x.*.assum=-1;
        let gbad:i32=0;
        let b2:i32=0;
        while(b2<s.*.nst){
            if(b2!=0 && n3_sf(s,b2,9)==0 && n3_sf(s,b2,2)!=2){
                if(n5_contra_state(c,x.*.goal,x.*.gollen,b2)==1){gbad=1;break;}
            }
            b2=b2+1;
        }
        if(gbad==0){
            let gid:i32=n3_append(c,5,0,99,p.*.p1,p.*.p2,p.*.p3,n3_pdepth(s,p),th,round,x.*.goal,x.*.gollen);
            au_put32(s.*.ev,0,au_get32(s.*.ev,0)+1);
            n3_log_pbc(au,round,th,p,gid,cb,nc);
            x.*.derived_by=th;
            nio_free(cb);
            return 4;
        }
        n3_phead(au,round,th,p);
        dout_str(au," PBC-BLOCKED goal contradicts live state");dout_line(au);
    }
    if(st2>=3){
        au_put32(t.*.kill,th,1);
        let m:i32=au_get32(s.*.ev,5);
        let bit:i32=1;let sh:i32=0;
        while(sh<th){bit=bit*2;sh=sh+1;}
        au_put32(s.*.ev,5,m+bit);
        n3_phead(au,round,th,p);
        dout_str(au," STRATEGY-KILLED");dout_line(au);
    }
    nio_free(cb);
    return 2;
}

// ---------------- main deliberation loop ----------------
// ---------------- n5 evidence-driven scheduler ----------------
// Three threads (0 CONTRA, 1 FORWARD, 2 GOAL). Each round, threads propose in
// credit-descending, thread-id-ascending order. Credits: +2 append, -1
// refusal/duplicate/depth-skip, +3 goal-overlap. A thread with two
// consecutive empty proposals sleeps two rounds; any append wakes sleepers.
fn n3_run(c:*N3C)i32 {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;let au:*DOut=c.*.au;
    let round:i32=1;
    while(round<=x.*.maxrounds){
        let act:i32=0;
        let o0:i32=0;let o1:i32=1;let o2:i32=2;
        if(au_get32(t.*.cred,o1)>au_get32(t.*.cred,o0)){let tt:i32=o0;o0=o1;o1=tt;}
        if(au_get32(t.*.cred,o2)>au_get32(t.*.cred,o0)){let tt2:i32=o0;o0=o2;o2=tt2;}
        if(au_get32(t.*.cred,o2)>au_get32(t.*.cred,o1)){let tt3:i32=o1;o1=o2;o2=tt3;}
        let si:i32=0;
        while(si<3){
            let th:i32=o0;
            if(si==1){th=o1;}
            if(si==2){th=o2;}
            if(au_get32(t.*.kill,th)==0){
                let dm:i32=au_get32(t.*.dorm,th);
                if(dm<0){
                    au_put32(t.*.dorm,th,dm+1);
                } else {
                    let pr:N3P=N3P{.lic=-1,.p1=-1,.p2=-1,.p3=-1,.src=-1,.kid=0,.olen=0};
                    if(n3_propose(c,th,round,&pr)==1){
                        act=1;
                        au_put32(t.*.props,th,au_get32(t.*.props,th)+1);
                        au_put32(t.*.dorm,th,0);
                        if(n3_adjudicate(c,th,round,&pr)==4){return 1;}
                    } else {
                        let dm2:i32=dm+1;
                        if(dm2>=2){au_put32(t.*.dorm,th,-2);}else{au_put32(t.*.dorm,th,dm2);}
                    }
                }
            }
            si=si+1;
        }
        let alive:i32=0;let k2:i32=0;
        while(k2<3){
            if(au_get32(t.*.kill,k2)==0){alive=1;}
            k2=k2+1;
        }
        if(alive==0){
            au_put32(s.*.ev,4,1);
            n3_log1(au,"WITHHOLD ALL-KILLED rounds=",round as i64);
            return 0;
        }
        if(act==0){
            au_put32(s.*.ev,2,1);
            n3_log1(au,"WITHHOLD FIXPOINT rounds=",round as i64);
            return 0;
        }
        round=round+1;
    }
    au_put32(s.*.ev,3,1);
    n3_log1(au,"WITHHOLD BUDGET-EXHAUSTED rounds=",x.*.maxrounds as i64);
    return 0;
}
// ---------------- output ----------------
fn n3_emit(c:*N3C,derived:i32,o:*DOut)void {
    let s:*N3S=c.*.s;let x:*N3X=c.*.x;let t:*N3T=c.*.t;let au:*DOut=c.*.au;
    let ab:[]u8=s.*.ar;
    dout_str(o,"ID: ");dout_str(o,x.*.pid[0..x.*.pidlen]);dout_line(o);
    dout_str(o,"ENGINE: n5");dout_line(o);
    if(derived==1){dout_str(o,"VERDICT: DERIVED");}else{dout_str(o,"VERDICT: WITHHELD");}
    dout_line(o);
    dout_str(o,"CLAIM: ");dout_str(o,x.*.goal);dout_line(o);
    dout_str(o,"CONFIDENCE: ");dout_i64(o,derived as i64);dout_line(o);
    let nd:i32=0;let i:i32=0;
    while(i<s.*.nst){
        let src:i32=n3_sf(s,i,2);
        if(src==3 || src==4 || src==5){nd=nd+1;}
        i=i+1;
    }
    dout_str(o,"DERIVATIONS: ");dout_i64(o,nd as i64);dout_line(o);
    dout_str(o,"STORE: ");dout_str(o,x.*.store[0..x.*.storelen]);dout_line(o);
    dout_str(o,"FLAGS:");
    if(au_get32(s.*.ev,0)>0){dout_str(o," PBC-FIRED");}
    if(au_get32(s.*.ev,1)>0){dout_str(o," DISCHARGE");}
    if(au_get32(s.*.ev,2)>0){dout_str(o," FIXPOINT");}
    if(au_get32(s.*.ev,3)>0){dout_str(o," BUDGET-EXHAUSTED");}
    if(au_get32(s.*.ev,4)>0){dout_str(o," ALL-KILLED");}
    dout_line(o);
    dout_str(o,"THREADS:");dout_line(o);
    let th:i32=0;
    while(th<3){
        dout_str(o,"T");dout_i64(o,th as i64);
        dout_str(o," ");dout_str(o,n3_tname(th));
        if(au_get32(t.*.kill,th)==1){dout_str(o," status=killed");}else{dout_str(o," status=live");}
        dout_str(o," strikes=");dout_i64(o,au_get32(t.*.strs,th) as i64);
        dout_str(o," proposals=");dout_i64(o,au_get32(t.*.props,th) as i64);
        dout_line(o);
        th=th+1;
    }
    dout_str(o,"LEDGER:");dout_line(o);
    i=0;
    while(i<s.*.nst){
        let bo:i32=0;let bl:i32=0;
        n3_sbytes(s,i,&bo,&bl);
        dout_str(o,"S");dout_i64(o,i as i64);
        dout_str(o," src=");dout_str(o,n3_srcname(n3_sf(s,i,2)));
        let kid:i32=n3_sf(s,i,3);
        if(kid>0){
            dout_str(o," kid=K");
            if(kid<100){dout_str(o,"0");}
            if(kid<10){dout_str(o,"0");}
            dout_i64(o,kid as i64);
        }
        dout_str(o," lic=");dout_i64(o,n3_sf(s,i,4) as i64);
        dout_str(o," p=[");dout_i64(o,n3_sf(s,i,5) as i64);
        dout_str(o,",");dout_i64(o,n3_sf(s,i,6) as i64);
        dout_str(o,",");dout_i64(o,n3_sf(s,i,7) as i64);
        dout_str(o,"] depth=");dout_i64(o,n3_sf(s,i,8) as i64);
        if(n3_sf(s,i,9)==1){dout_str(o," defeated");}else{dout_str(o," live");}
        dout_str(o," t=");dout_i64(o,n3_sf(s,i,10) as i64);
        dout_str(o," r=");dout_i64(o,n3_sf(s,i,11) as i64);
        dout_str(o," taint=");dout_i64(o,n3_sf(s,i,12) as i64);
        dout_str(o,": ");dout_str(o,ab[bo..bo+bl]);dout_line(o);
        i=i+1;
    }
    dout_str(o,"AUDIT:");dout_line(o);
    dout_str(o,au.*.buf[0..au.*.n]);
}

// ---------------- engine init ----------------
fn n3_s_alloc(s:*N3S)i32 {
    s.*.ar=nio_alloc(4194304);
    if(s.*.ar.len!=4194304){return -1;}
    s.*.acap=4194304;s.*.an=0;
    s.*.st=nio_alloc(1024*80);
    if(s.*.st.len!=1024*80){return -1;}
    s.*.nst=0;s.*.stcap=1024;
    s.*.wtmp=nio_alloc(65536);
    if(s.*.wtmp.len!=65536){return -1;}
    s.*.ev=nio_alloc(8*4);
    if(s.*.ev.len!=8*4){return -1;}
    let ei:i32=0;
    while(ei<32){s.*.ev[ei]=0;ei=ei+1;}
    return 0;
}
fn n3_x_init(x:*N3X)void {
    x.*.goff=0;x.*.glen=0;
    x.*.goal="";x.*.gollen=0;
    x.*.pid="";x.*.pidlen=0;
    x.*.assum=-1;x.*.derived_by=-1;
    x.*.store="";x.*.storelen=0;
    x.*.rules="";x.*.ruleslen=0;
    x.*.cachepath="";x.*.cachepathlen=0;
    x.*.gw="";x.*.ngw=0;
}
fn n3_t_alloc(t:*N3T)i32 {
    t.*.strs=nio_alloc(4*4);
    if(t.*.strs.len!=4*4){return -1;}
    t.*.kill=nio_alloc(4*4);
    if(t.*.kill.len!=4*4){return -1;}
    t.*.props=nio_alloc(4*4);
    if(t.*.props.len!=4*4){return -1;}
    t.*.nused=nio_alloc(4*4);
    if(t.*.nused.len!=4*4){return -1;}
    t.*.used=nio_alloc(4*160*16);
    if(t.*.used.len!=4*160*16){return -1;}
    t.*.wa=nio_alloc(192*8);
    if(t.*.wa.len!=192*8){return -1;}
    t.*.wb=nio_alloc(192*8);
    if(t.*.wb.len!=192*8){return -1;}
    t.*.na=nio_alloc(192*8);
    if(t.*.na.len!=192*8){return -1;}
    t.*.nb=nio_alloc(192*8);
    if(t.*.nb.len!=192*8){return -1;}
    t.*.sw=nio_alloc(192*8);
    if(t.*.sw.len!=192*8){return -1;}
    t.*.cred=nio_alloc(4*4);
    if(t.*.cred.len!=4*4){return -1;}
    t.*.dorm=nio_alloc(4*4);
    if(t.*.dorm.len!=4*4){return -1;}
    t.*.ch_ar=nio_alloc(262144);
    if(t.*.ch_ar.len!=262144){return -1;}
    t.*.ch_sig=nio_alloc(256*8);
    if(t.*.ch_sig.len!=256*8){return -1;}
    t.*.ch_aoff=nio_alloc(256*4);
    if(t.*.ch_aoff.len!=256*4){return -1;}
    t.*.ch_alen=nio_alloc(256*4);
    if(t.*.ch_alen.len!=256*4){return -1;}
    t.*.ch_coff=nio_alloc(256*4);
    if(t.*.ch_coff.len!=256*4){return -1;}
    t.*.ch_clen=nio_alloc(256*4);
    if(t.*.ch_clen.len!=256*4){return -1;}
    t.*.ch_or=nio_alloc(256*4);
    if(t.*.ch_or.len!=256*4){return -1;}
    t.*.ch_an=0;t.*.ch_n=0;
    // heap memory is not reliably zeroed: clear the small control tables
    let zi:i32=0;
    while(zi<16){
        t.*.strs[zi]=0;t.*.kill[zi]=0;t.*.props[zi]=0;
        t.*.nused[zi]=0;t.*.cred[zi]=0;t.*.dorm[zi]=0;
        zi=zi+1;
    }
    return 0;
}
fn n3_mkctx(s:*N3S,x:*N3X,t:*N3T,w:*N3W,au:*DOut)N3C {
    let c:N3C=N3C{.s=s,.x=x,.t=t,.w=w,.au=au};
    return c;
}
fn n3_x_store(x:*N3X,sp:[]u8,sl:i32)void {
    x.*.store=sp;x.*.storelen=sl;
}

// one full deterministic run into o; stage buffer st receives new lemmas.
fn n3_once(fbuf:[]u8,flen:i64,kbuf:[]u8,klen:i64,kpath:[]u8,fpath:[]u8,cpath:[]u8,cpathlen:i32,o:*DOut,st:*DOut)i32 {
    let s:N3S=N3S{.ar="",.acap=0,.an=0,.st="",.nst=0,.stcap=0,.wtmp="",.ev=""};
    if(n3_s_alloc(&s)!=0){return -1;}
    // frozen depth/round bounds from the battery family (chosen before the
    // literal: znc rejects .* assignment on a local struct value)
    let md:i32=8;let mr:i32=25;
    if(n3_find_ci(fpath,0,fpath.len,"CHAIN50")>=0){md=160;mr=160;}
    else if(n3_find_ci(fpath,0,fpath.len,"B6X")>=0){md=128;mr=128;}
    let x:N3X=N3X{.goff=0,.glen=0,.goal="",.gollen=0,.pid="",.pidlen=0,.assum=0,.derived_by=0,.store="",.storelen=0,.rules="",.ruleslen=0,.maxdepth=md,.maxrounds=mr,.cachepath="",.cachepathlen=0,.gw="",.ngw=0};
    n3_x_init(&x);
    let t:N3T=N3T{.strs="",.kill="",.props="",.used="",.nused="",.wa="",.wb="",.na="",.nb="",.sw="",.cred="",.dorm="",.ch_ar="",.ch_an=0,.ch_sig="",.ch_aoff="",.ch_alen="",.ch_coff="",.ch_clen="",.ch_or="",.ch_n=0};
    if(n3_t_alloc(&t)!=0){return -1;}
    let w:N3W=N3W{.st="",.ns=0,.ng="",.nn=0,.ax="",.nx=0,.pr="",.np=0,.md="",.nm=0};
    n3_winit(&w);
    let au:DOut=DOut{.buf="",.n=0,.cap=0,.err=0};
    if(dout_init(&au,2097152)!=0){return -1;}
    let c:N3C=n3_mkctx(&s,&x,&t,&w,&au);
    let cp:*N3C=&c;
    n3_x_store(&x,kpath,kpath.len);
    if(n3_parse_prob(cp,fbuf,flen as i32)!=0){return -2;}
    if(n3_parse_kb(cp,kbuf,klen as i32)!=0){return -3;}
    n5_load_stores(cp,fbuf,flen as i32);
    if(cpathlen>0){n5_cache_load(cp,cpath,cpathlen);}
    let dr:i32=n3_run(cp);
    if(dr==1){n5_cache_stage(cp,st);}
    n3_emit(cp,dr,o);
    return 0;
}

fn main() i32 {
    let obuf:[]u8=nio_alloc(1048576);
    if(obuf.len!=1048576){return 4;}
    let oo:DOut=DOut{.buf=obuf,.n=0,.cap=1048576,.err=0};
    let o:*DOut=&oo;
    let fpath:[]u8=_zag_arg(1);
    if(fpath.len<1){
        dout_str(o,"usage: n5_bin <problem> [knowledge] [cache_in] [cache_out]\n");
        _zag_print(obuf[0..oo.n]);
        return 4;
    }
    let kpath:[]u8=_zag_arg(2);
    if(kpath.len<1){kpath="../../batteries/knowledge/KNOWLEDGE_STORE_NL.md";}
    let cpath:[]u8=_zag_arg(3);
    let coutpath:[]u8=_zag_arg(4);
    if(n3_has_sealed(fpath)==1){dout_str(o,"n5: sealed guard tripped (problem path)\n");return 3;}
    if(n3_has_sealed(kpath)==1){dout_str(o,"n5: sealed guard tripped (knowledge path)\n");return 3;}
    if(cpath.len>0 && n3_has_sealed(cpath)==1){dout_str(o,"n5: sealed guard tripped (cache-in path)\n");return 3;}
    if(coutpath.len>0 && n3_has_sealed(coutpath)==1){dout_str(o,"n5: sealed guard tripped (cache-out path)\n");return 3;}
    let fbuf:[]u8=nio_alloc(1048576);
    if(fbuf.len!=1048576){dout_str(o,"n5: alloc failed\n");return 4;}
    let fl:i64=dlb_read_file(fpath,fbuf);
    if(fl<=0){dout_str(o,"n5: cannot read problem file\n");_zag_print(obuf[0..oo.n]);return 4;}
    let kbuf:[]u8=nio_alloc(1048576);
    if(kbuf.len!=1048576){dout_str(o,"n5: alloc failed\n");_zag_print(obuf[0..oo.n]);return 4;}
    let kl:i64=dlb_read_file(kpath,kbuf);
    if(kl<0){kl=0;}
    let stbuf:[]u8=nio_alloc(1048576);
    if(stbuf.len!=1048576){dout_str(o,"n5: alloc failed\n");_zag_print(obuf[0..oo.n]);return 4;}
    let st:DOut=DOut{.buf=stbuf,.n=0,.cap=1048576,.err=0};
    let rc:i32=n3_once(fbuf,fl,kbuf,kl,kpath,fpath,cpath,cpath.len,o,&st);
    if(rc!=0){dout_str(o,"n5: engine error rc=");dout_i64(o,rc as i64);dout_line(o);}
    if(rc==0 && coutpath.len>0){
        let wr:i64=dlb_write_file(coutpath,stbuf,st.n);
        if(wr!=st.n){dout_str(o,"n5: cache-out write failed\n");return 4;}
    }
    _zag_print(obuf[0..oo.n]);
    if(rc!=0){return 4;}
    return 0;
}

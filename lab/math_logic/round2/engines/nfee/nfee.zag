// nfee.zag — NFEE (negation-first elimination engine) main.
//
// Phase 1 (nfee_elim.zag): contrapositive firing backward from NOT-H builds
//   ELIM_ARENA — disjunctive elimination constraints with rule-level
//   attribution — BEFORE any forward affirmation.
// Phase 2 (nfee_fwd.zag): standard forward chaining (S_MP/S_UI/S_PBC-direct)
//   with the elimination filter: a candidate claim that would violate an
//   active constraint is blocked (recorded with attribution), never asserted.
//
// Verdicts: DERIVED (H asserted, survived elimination), CONTESTED (H blocked
//   by active constraints; attribution names the responsible rules),
//   REFUTED (not(H) asserted), UNSUPPORTED (neither), WITHHELD (false
//   derived — the store is contradictory).
//
// Usage: nfee_bin <problem.form> <out_path> [bound]
//   Build with CWD = the nfee dir (imports resolve relative to CWD).
//   At runtime the .form STORE path resolves relative to the runtime CWD,
//   with fallback to the problem file's directory.
// Exit: 0 ok; 3 sealed-guard; 4 input/alloc error; 5 3x divergence;
//       6 committed-schema hash mismatch.
// Pure Zag, zero RNG. 3x in-process reruns, byte-identical asserted.

@import("../../../../deliberation_depth/harness/R33_NATIVE_IO_V1.zag")
@import("../../../../deliberation_depth/harness/dlb_util.zag")
@import("../../../engines/common/cx_str.zag")
@import("../../../engines/common/cx_claim.zag")
@import("../../../engines/common/cx_match.zag")
@import("../../../engines/common/cx_store.zag")
@import("../../../engines/common/cx_schemas.zag")
@import("../../../engines/common/cx_io.zag")
@import("nfee_elim.zag")
@import("nfee_fwd.zag")

// attribution string for target t: attr of every active constraint t
// violates, in constraint order, joined with " | ". This is NFEE's unique
// measurable: which rules forced the elimination.
fn nfee_attribution(e:*ELIM, s:*CXS, t:[]u8, o:*DOut) void {
    let first:i32 = 1;
    let c:i32 = 0;
    while(c < e.*.n){
        if(elim_active(e, c) == 1){
            let hit:i32 = 0;
            let nd:i32 = elim_dcount(e, c);
            let k:i32 = 0;
            while(k < nd){
                if(nio_equal(elim_disj(e, c, k), t) == 1){
                    let ok:i32 = 1;
                    let j:i32 = 0;
                    while(j < nd){
                        if(j != k && cxs_find(s, elim_disj(e, c, j)) < 0){ ok = 0; break; }
                        j = j+1;
                    }
                    if(ok == 1){ hit = 1; }
                }
                k = k+1;
            }
            if(hit == 1){
                if(first == 0){ dout_str(o, " | "); }
                dout_str(o, elim_attr(e, c));
                first = 0;
            }
        }
        c = c+1;
    }
}

// attribution string for a refuted target: the DIRECT constraints whose head
// is not(H) — the rules that established the refutation in Phase 1.
fn nfee_attribution_refuted(e:*ELIM, notH:[]u8, o:*DOut) void {
    let first:i32 = 1;
    let c:i32 = 0;
    while(c < e.*.n){
        if(elim_type(e, c) == 1 && elim_active(e, c) == 1 && nio_equal(elim_head(e, c), notH) == 1){
            if(first == 0){ dout_str(o, " | "); }
            dout_str(o, elim_attr(e, c));
            first = 0;
        }
        c = c+1;
    }
}

fn nfee_emit(o:*DOut, pid:[]u8, verdict:[]u8, claim:[]u8, conf:i32, deriv:i32,
             attr:[]u8, flags:[]u8, s:*CXS, st:*NSTAT, e:*ELIM, blk:*BLK) void {
    dout_str(o, "ID: "); dout_str(o, pid); dout_line(o);
    dout_str(o, "ENGINE: nfee"); dout_line(o);
    dout_str(o, "VERDICT: "); dout_str(o, verdict); dout_line(o);
    dout_str(o, "CLAIM: "); dout_str(o, claim); dout_line(o);
    dout_str(o, "CONFIDENCE: "); dout_i64(o, conf as i64); dout_line(o);
    dout_str(o, "DERIVATIONS: "); dout_i64(o, deriv as i64); dout_line(o);
    dout_str(o, "SCHEMAS: S_MP="); dout_str(o, cx_sch_hex(0));
    dout_str(o, " S_PBC="); dout_str(o, cx_sch_hex(1));
    dout_str(o, " S_UI="); dout_str(o, cx_sch_hex(2)); dout_line(o);
    dout_str(o, "ELIM_CONSTRAINTS: "); dout_i64(o, e.*.n as i64);
    dout_str(o, " ACTIVE: "); dout_i64(o, nfee_nactive(e) as i64); dout_line(o);
    dout_str(o, "ATTRIBUTION: "); dout_str(o, attr); dout_line(o);
    dout_str(o, "FLAGS: "); dout_str(o, flags); dout_line(o);
    dout_str(o, "ELIMINATION:"); dout_line(o);
    let i:i32 = 0;
    while(i < e.*.n){
        dout_str(o, "E"); dout_i64(o, i as i64); dout_str(o, ": type=");
        if(elim_type(e, i) == 1){ dout_str(o, "DIRECT"); } else { dout_str(o, "CONTRA"); }
        dout_str(o, " active="); dout_i64(o, elim_active(e, i) as i64);
        dout_str(o, " head="); dout_str(o, elim_head(e, i));
        dout_str(o, " disjuncts={");
        let nd:i32 = elim_dcount(e, i);
        let k:i32 = 0;
        while(k < nd){
            if(k > 0){ dout_str(o, ","); }
            dout_str(o, elim_disj(e, i, k));
            k = k+1;
        }
        dout_str(o, "} attr="); dout_str(o, elim_attr(e, i)); dout_line(o);
        i = i+1;
    }
    dout_str(o, "BLOCKED:"); dout_line(o);
    i = 0;
    while(i < blk.*.n){
        dout_str(o, "B"); dout_i64(o, i as i64);
        dout_str(o, ": claim="); dout_str(o, blk_bytes(blk, i));
        dout_str(o, " by=E"); dout_i64(o, blk_by(blk, i) as i64);
        dout_str(o, " attr="); dout_str(o, blk_attr(blk, i)); dout_line(o);
        i = i+1;
    }
    let nel:i32 = 0;
    i = 0;
    while(i < s.*.n){
        if(nstat_elim(st, i) == 1){ nel = nel+1; }
        i = i+1;
    }
    dout_str(o, "STATUS: claims="); dout_i64(o, s.*.n as i64);
    dout_str(o, " eliminated="); dout_i64(o, nel as i64);
    dout_str(o, " blocked="); dout_i64(o, blk.*.n as i64); dout_line(o);
    dout_str(o, "AUDIT:"); dout_line(o);
    i = 0;
    while(i < s.*.n){
        dout_str(o, "C"); dout_i64(o, i as i64);
        dout_str(o, ": "); dout_str(o, cxs_bytes(s, i));
        dout_str(o, " ["); dout_str(o, cxs_audit(s, i)); dout_str(o, "]");
        if(nstat_elim(st, i) == 1){
            dout_str(o, " ELIM_BY=E"); dout_i64(o, nstat_by(st, i) as i64);
        }
        dout_line(o);
        i = i+1;
    }
}

// one full run into o. Returns 0 ok, 4 input/alloc, 6 schema.
fn nfee_run(o:*DOut, fbuf:[]u8, flen:i32, sbuf:[]u8, sn:i32, bound:i32) i32 {
    let f:CXF = CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    let fp:*CXF = &f;
    if(cx_parse_form(fbuf, flen, fp, 512) != 0){ return 4; }
    let k:CXK = CXK{.kid_off:"",.kid_len:"",.kcl_off:"",.kcl_len:"",.nk:0,.cap:0,.buf:"",.n:0};
    let kp:*CXK = &k;
    if(cx_parse_store(sbuf, sn, kp, 512) != 0){ return 4; }
    if(cx_sch_assert() != 0){ return 6; }
    let s:CXS = CXS{.n:0,.cap:0,.data:"",.dn:0,.dcap:0,.coff:"",.clen:"",.aoff:"",.alen:"",.dep:"",.kind:"",.deriv:0};
    let sp:*CXS = &s;
    if(cxs_init(sp, 4096, 2097152) != 0){ return 4; }
    // load store claims as premises
    let i:i32 = 0;
    while(i < kp.*.nk){
        let kb:[]u8 = cx_kclaim(kp, i);
        let cb:[]u8 = cx_canon(kb);
        if(cb.len > 0){
            let ao:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
            let aop:*DOut = &ao;
            if(dout_init(aop, 128) == 0){
                dout_str(aop, "PREM "); dout_str(aop, cx_kid(kp, i));
                let ab:[]u8 = cx_copy(dout_bytes(aop));
                dout_free(aop);
                cxs_add(sp, cb, ab, 0, 0);
                nio_free(cb); nio_free(ab);
            }
        }
        i = i+1;
    }
    // load problem premises
    i = 0;
    while(i < fp.*.nprem){
        let pb:[]u8 = cx_prem(fp, i);
        let cb:[]u8 = cx_canon(pb);
        if(cb.len == 0){ return 4; }
        let ao:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
        let aop:*DOut = &ao;
        if(dout_init(aop, 64) == 0){
            dout_str(aop, "PREM#"); dout_i64(aop, i as i64);
            let ab:[]u8 = cx_copy(dout_bytes(aop));
            dout_free(aop);
            cxs_add(sp, cb, ab, 0, 0);
            nio_free(cb); nio_free(ab);
        }
        i = i+1;
    }
    let t:[]u8 = cx_canon(fp.*.target);
    if(t.len == 0){ return 4; }
    let n1:[]u8 = cx_concat("not(", t);
    let notH:[]u8 = cx_concat(n1, ")");
    nio_free(n1);
    if(notH.len == 0){ nio_free(t); return 4; }
    // ground rules from premises/store
    let g:GRUL = GRUL{.rec:"",.n:0,.cap:0,.atab:"",.an:0,.acap:0,.data:"",.dn:0,.dcap:0};
    let gp:*GRUL = &g;
    if(grul_init(gp, 2048, 8192, 262144) != 0){ nio_free(t); nio_free(notH); return 4; }
    if(nfee_extract_rules(sp, gp) != 0){ nio_free(t); nio_free(notH); grul_free(gp); return 4; }
    // Phase 1: elimination pass
    let e:ELIM = ELIM{.rec:"",.n:0,.cap:0,.dtab:"",.dn:0,.dcap:0,.data:"",.ddn:0,.ddcap:0};
    let ep:*ELIM = &e;
    if(elim_init(ep, 1024, 8192, 65536) != 0){ nio_free(t); nio_free(notH); grul_free(gp); return 4; }
    if(nfee_phase1(sp, gp, notH, ep, bound) < 0){ nio_free(t); nio_free(notH); grul_free(gp); elim_free(ep); return 4; }
    // elimination marking over loaded claims
    let st:NSTAT = NSTAT{.flg:"",.by:"",.cap:0};
    let stp:*NSTAT = &st;
    if(nstat_init(stp, 4096) != 0){ nio_free(t); nio_free(notH); grul_free(gp); elim_free(ep); return 4; }
    nfee_mark(sp, stp, ep);
    // Phase 2: filtered forward chaining
    let p:NFEP = NFEP{.a_mp1:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp1:0,.a_mp2:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp2:0,.a_pb:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_pb:0,.a_ui:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_ui:0};
    let pp:*NFEP = &p;
    if(nfep_init(pp) != 0){ nio_free(t); nio_free(notH); grul_free(gp); elim_free(ep); nstat_free(stp); return 4; }
    let blk:BLK = BLK{.tab:"",.n:0,.cap:0,.data:"",.dn:0,.dcap:0};
    let blkp:*BLK = &blk;
    if(blk_init(blkp, 1024, 65536) != 0){ nio_free(t); nio_free(notH); grul_free(gp); elim_free(ep); nstat_free(stp); nfep_free(pp); return 4; }
    nfee_bfs(sp, stp, ep, blkp, pp, bound, 0, t, 1);
    // verdict
    let verdict:[]u8 = "UNSUPPORTED";
    let claim:[]u8 = "-";
    let conf:i32 = 0;
    let flags:[]u8 = "NONE";
    let ao2:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
    let ao2p:*DOut = &ao2;
    dout_init(ao2p, 1024);
    if(cxs_find(sp, "false") >= 0){
        verdict = "WITHHELD"; claim = "-"; conf = 0; flags = "CONTRADICTION_DERIVED";
    } else {
        // Spec: "H asserted and surviving elimination -> derivable;
        // H derivable but eliminated -> contested". A premise-H covered by an
        // active elimination constraint is contested, not derived.
        let ti:i32 = cxs_find(sp, t);
        let telim:i32 = 0;
        if(ti >= 0 && nstat_elim(stp, ti) == 1){ telim = 1; }
        if(ti >= 0 && telim == 0){
            verdict = "DERIVED"; claim = t; conf = 1;
        } else {
            if(blk_find(blkp, t) >= 0 || telim == 1){
                verdict = "CONTESTED"; claim = t; conf = 0;
                nfee_attribution(ep, sp, t, ao2p);
            } else {
                if(cxs_find(sp, notH) >= 0){
                    verdict = "REFUTED"; claim = notH; conf = 1;
                    nfee_attribution_refuted(ep, notH, ao2p);
                }
            }
        }
    }
    let attr:[]u8 = cx_copy(dout_bytes(ao2p));
    dout_free(ao2p);
    if(attr.len == 0){
        nio_free(attr);
        attr = cx_copy("-");
    }
    nfee_emit(o, fp.*.id, verdict, claim, conf, sp.*.deriv, attr, flags, sp, stp, ep, blkp);
    nio_free(attr);
    nio_free(t); nio_free(notH);
    grul_free(gp); elim_free(ep); nstat_free(stp); nfep_free(pp); blk_free(blkp);
    return 0;
}

fn main() i32 {
    if(_zag_argc() < 3){
        _zag_println("usage: nfee_bin <problem.form> <out_path> [bound]");
        return 4;
    }
    let fpath:[]u8 = _zag_arg(1);
    let opath:[]u8 = _zag_arg(2);
    let bound:i32 = 8;
    if(_zag_argc() >= 4){
        let bb:i32 = dlb_atoi(_zag_arg(3));
        if(bb >= 1 && bb <= 128){ bound = bb; }
    }
    let fbuf:[]u8 = nio_alloc(1048576);
    if(fbuf.len == 0){ return 4; }
    let flen:i64 = cx_guarded_read(fpath, fbuf);
    if(flen == -99){ _zag_println("nfee: sealed guard tripped on problem file"); return 3; }
    if(flen <= 0){ _zag_println("nfee: cannot read problem file"); return 4; }
    let f:CXF = CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    let fp:*CXF = &f;
    if(cx_parse_form(fbuf, flen as i32, fp, 512) != 0){ _zag_println("nfee: bad .form"); return 4; }
    let sbuf:[]u8 = nio_alloc(1048576);
    if(sbuf.len == 0){ return 4; }
    let sn:i64 = cx_guarded_read(fp.*.store, sbuf);
    if(sn == -99){ _zag_println("nfee: sealed guard tripped on store file"); return 3; }
    if(sn <= 0){
        // fallback: resolve STORE relative to the problem file's directory
        let dirend:i32 = -1;
        let qi:i32 = 0;
        while(qi < fpath.len){
            if(fpath[qi] == 47){ dirend = qi; }
            qi = qi+1;
        }
        if(dirend >= 0){
            let p2:[]u8 = cx_concat(fpath[0..dirend+1], fp.*.store);
            sn = cx_guarded_read(p2, sbuf);
            nio_free(p2);
            if(sn == -99){ _zag_println("nfee: sealed guard tripped on store file"); return 3; }
        }
    }
    if(sn <= 0){ _zag_println("nfee: cannot read store file"); return 4; }
    let t1:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
    let t2:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
    let t3:DOut = DOut{.buf:"",.n:0,.cap:0,.err:0};
    let t1p:*DOut = &t1;
    let t2p:*DOut = &t2;
    let t3p:*DOut = &t3;
    if(dout_init(t1p, 1048576) != 0 || dout_init(t2p, 1048576) != 0 || dout_init(t3p, 1048576) != 0){ return 4; }
    let r1:i32 = nfee_run(t1p, fbuf, flen as i32, sbuf, sn as i32, bound);
    let r2:i32 = nfee_run(t2p, fbuf, flen as i32, sbuf, sn as i32, bound);
    let r3:i32 = nfee_run(t3p, fbuf, flen as i32, sbuf, sn as i32, bound);
    let div:i32 = 0;
    if(r1 != 0 || r2 != 0 || r3 != 0){ div = 2; }
    if(div == 0 && nio_equal(dout_bytes(t1p), dout_bytes(t2p)) == 0){ div = 1; }
    if(div == 0 && nio_equal(dout_bytes(t2p), dout_bytes(t3p)) == 0){ div = 1; }
    if(div != 0){
        _zag_println("nfee: DIVERGENCE across 3x reruns");
        if(div == 1){ return 5; }
        return 4;
    }
    let wrc:i64 = dlb_write_file(opath, dout_bytes(t1p), t1p.*.n);
    if(wrc < 0){ return 4; }
    return 0;
}

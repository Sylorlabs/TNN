// QUOT engine (d): q_pool.zag — claim/support pool, slots, conflict family.
// All tables are []u8 arenas with explicit LE i32 accessors (au_get32/au_put32).
// Never `as []i32` (znc ZNC-2026-09-21-007). State lives in one flat struct QG,
// always passed as *QG (no nested structs, no chained field access).
//
// Record model (SPEC_QUOT §1):
//   - one record per (literal, subset-minimal support) — multiple records per literal.
//   - slots keyed by atom bytes; per slot, pos-list and neg-list of rec ids,
//     each kept sorted by (support bytes lex, rec id) and subset-minimal
//     within a uses-class.
//   - uses=0: main-derivation claims. uses=1: PBC-subproof claims (swept).
//   - conflicts: subset-minimal ORs of opposite supports, lex sorted.

// QUOT engine (d): q_pool.zag — claim/support pool, slots, conflict family.
// All tables are []u8 arenas with explicit LE i32 accessors (au_get32/au_put32).
// Never `as []i32` (znc ZNC-2026-09-21-007).
//
// State: the old ~90-field QG god-struct miscompiled field accesses
// (znc ZNC-2026-09-21-004/-009/-010). It is split into subsystem structs of
// <=8 fields each, held by pointer in a small QG handle (7 fields) plus one
// QB bundle (8 fields). Functions keep their (g:*QG) signatures and extract
// subsystem pointers in a prologue; slice-field access is only ever through
// a *T param on a small struct, never chained (s.field.subfield is copied
// to a local first).
//
// Record model (SPEC_QUOT §1):
//   - one record per (literal, subset-minimal support) — multiple records per literal.
//   - slots keyed by atom bytes; per slot, pos-list and neg-list of rec ids,
//     each kept sorted by (support bytes lex, rec id) and subset-minimal
//     within a uses-class.
//   - uses=0: main-derivation claims. uses=1: PBC-subproof claims (swept).
//   - conflicts: subset-minimal ORs of opposite supports, lex sorted.

// slot atom bytes + slot table (5 fields)
struct QSL {
    sl_atom:[]u8, sl_ao:[]u8, sl_al:[]u8, nslots:i32, sl_n:i32
}
// pool lists per slot (8 fields)
struct QPL {
    sl_po:[]u8, sl_pn:[]u8, sl_qo:[]u8, sl_qn:[]u8, pl_arena:[]u8, pl_n:i32,
    sl_pcap:[]u8, sl_qcap:[]u8
}
// record scalar fields, part 1 (8 fields)
struct QRC1 {
    r_slot:[]u8, r_pol:[]u8, r_dep:[]u8, r_sch:[]u8,
    r_root:[]u8, r_uses:[]u8, r_hot:[]u8, r_dead:[]u8
}
// record scalar fields, part 2 (8 fields)
struct QRC2 {
    r_final:[]u8, r_premo:[]u8, r_premn:[]u8, r_bindo:[]u8,
    r_bindl:[]u8, r_lito:[]u8, r_litl:[]u8, nrec:i32
}
// record parse-cache fields (8 fields)
struct QRC3 {
    r_impo:[]u8, r_imln:[]u8, r_imcn:[]u8, r_fabvo:[]u8,
    r_fabln:[]u8, r_fabdn:[]u8, r_pbco:[]u8, r_pbcln:[]u8
}
// supports + conflict family (8 fields)
struct QSU {
    r_sup:[]u8, sup_arena:[]u8, sup_n:i32, cf_arena:[]u8,
    cf_n:i32, nconf:i32, nb:i32, nbmax:i32
}
// byte arenas + per-record rante chain heads (8 fields)
struct QAR {
    lit_arena:[]u8, lit_n:i32, prem_arena:[]u8, prem_n:i32,
    rante_arena:[]u8, rante_n:i32, r_rante:[]u8, r_ranteln:[]u8
}
// misc counters, part 1 (8 fields)
struct QMI {
    nitems:i32, it_claim:[]u8, ndec:i32, dec_lit:[]u8,
    sub:i32, committed:i32, n_ins:i32, n_enq:i32
}
// misc counters, part 2 + bind arena (8 fields)
struct QMZ {
    n_pop:i32, n_sub:i32, imp_n:i32, imp_arena:[]u8,
    fa_n:i32, fa_arena:[]u8, bind_arena:[]u8, bind_n:i32
}
// worklist scalars (8 fields)
struct QW1 {
    w_pop:[]u8, w_dep:[]u8, w_sch:[]u8, w_uses:[]u8,
    w_root:[]u8, w_rante:[]u8, w_ranteln:[]u8, w_premo:[]u8
}
// worklist offsets/counts (8 fields)
struct QW2 {
    w_premn:[]u8, w_bindo:[]u8, w_bindl:[]u8, w_conco:[]u8,
    w_concl:[]u8, wl_n:i32, pw_arena:[]u8, pw_n:i32
}
// worklist byte arenas (4 fields)
struct QW3 {
    bw_arena:[]u8, bw_n:i32, cw_arena:[]u8, cw_n:i32
}
// Herbrand universe (8 fields)
struct QU1 {
    u_off:[]u8, u_len:[]u8, u_arena:[]u8, u_n:i32,
    u_m:i32, u_fn:[]u8, u_fno:[]u8, u_fnn:[]u8
}
// universe function symbols (4 fields)
struct QU2 {
    u_fna:[]u8, u_fnn_n:i32, fn_arena:[]u8, fn_n:i32
}
// second-level bundle (8 fields)
struct QB {
    ar:*QAR, mi:*QMI, mz:*QMZ, w1:*QW1, w2:*QW2, w3:*QW3, u1:*QU1, u2:*QU2
}
// top-level handle (7 fields); subsystem shells are caller-owned locals
// (main), qg_init fills their arenas and links the pointers.
struct QG {
    sl:*QSL, pl:*QPL, r1:*QRC1, r2:*QRC2, r3:*QRC3, su:*QSU, b:*QB
}
// move n i32 slots within arena a: a[dst..dst+n) = a[src..src+n)
fn q_mmove32(a:[]u8, dst:i32, src:i32, n:i32)void {
    if(n<=0){ return; }
    if(dst<src){
        let i:i32=0;
        while(i<n){ au_put32(a, (dst+i), au_get32(a, (src+i))); i=i+1; }
    } else {
        let i:i32=n-1;
        while(i>=0){ au_put32(a, (dst+i), au_get32(a, (src+i))); i=i-1; }
    }
    return;
}
fn q_bytes_cmp(a:[]u8, b:[]u8)i32 {
    let n:i32=a.len;
    if(b.len<n){ n=b.len; }
    let i:i32=0;
    while(i<n){
        let x:u8=a[i];
        let y:u8=b[i];
        if(x<y){ return -1; }
        if(x>y){ return 1; }
        i=i+1;
    }
    if(a.len<b.len){ return -1; }
    if(a.len>b.len){ return 1; }
    return 0;
}
// polarity of a canonical literal: 1 = not(...), else 0
fn q_pol_of(lit:[]u8)i32 {
    if(lit.len>5 && lit[0]==110 as u8 && lit[1]==111 as u8 && lit[2]==116 as u8 && lit[3]==40 as u8 && lit[lit.len-1]==41 as u8){ return 1; }
    return 0;
}
// atom bytes of a canonical literal (caller slices; for pol=1 strips not(...))
fn q_atom_of(lit:[]u8, pol:i32)[]u8 {
    if(pol==1){ return lit[4..lit.len-1]; }
    return lit;
}
fn q_is_false(lit:[]u8)i32 {
    if(nio_equal(lit,"false")==1){ return 1; }
    return 0;
}

// ---- slots (stable ids; audit order is by atom bytes when emitting) ----
fn q_slot_find(g:*QG, atom:[]u8)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let n:i32=qs.*.nslots;
    let ao:[]u8=qs.*.sl_ao;
    let al:[]u8=qs.*.sl_al;
    let ar:[]u8=qs.*.sl_atom;
    let i:i32=0;
    while(i<n){
        let o:i32=au_get32(ao, i);
        let l:i32=au_get32(al, i);
        if(q_bytes_cmp(atom,ar[o..o+l])==0){ return i; }
        i=i+1;
    }
    return -1;
}
fn q_slot_create(g:*QG, atom:[]u8)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    if(qs.*.nslots>=8192){ return -1; }
    let id:i32=qs.*.nslots;
    let ar:[]u8=qs.*.sl_atom;
    let off:i32=qs.*.sl_n;
    let i:i32=0;
    while(i<atom.len){ ar[off+i]=atom[i]; i=i+1; }
    qs.*.sl_n=off+atom.len;
    let ao:[]u8=qs.*.sl_ao;
    au_put32(ao, id, off);
    let al:[]u8=qs.*.sl_al;
    au_put32(al, id, atom.len);
    // FIX 2026-09-25 (pre-existing): pl_n was never advanced and pos/neg
    // shared one offset, so all slot lists aliased offset 0 and overwrote
    // each other. Give each polarity its own bump-allocated chunk + cap.
    let pln:i32=qp.*.pl_n;
    if(pln+8>262144){ return -1; }
    let po:[]u8=qp.*.sl_po;
    au_put32(po, id, pln);
    let pn:[]u8=qp.*.sl_pn;
    au_put32(pn, id, 0);
    let pcap:[]u8=qp.*.sl_pcap;
    au_put32(pcap, id, 4);
    let qo:[]u8=qp.*.sl_qo;
    au_put32(qo, id, pln+4);
    let qn:[]u8=qp.*.sl_qn;
    au_put32(qn, id, 0);
    let qcap:[]u8=qp.*.sl_qcap;
    au_put32(qcap, id, 4);
    qp.*.pl_n=pln+8;
    qs.*.nslots=id+1;
    return id;
}

// ---- record accessors ----
fn q_rsup(g:*QG, rid:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=su.*.r_sup;
    let nb:i32=su.*.nb;
    return s[rid*nb..rid*nb+nb];
}
fn q_rlit(g:*QG, rid:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=qar.*.lit_arena;
    let o:i32=au_get32(qrc2.*.r_lito, rid);
    let l:i32=au_get32(qrc2.*.r_litl, rid);
    return s[o..o+l];
}
fn q_rprem(g:*QG, rid:i32, idx:i32)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=qar.*.prem_arena;
    let o:i32=au_get32(qrc2.*.r_premo, rid);
    return au_get32(s, (o+idx));
}
fn q_rbind(g:*QG, rid:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=mz.*.bind_arena;
    let o:i32=au_get32(qrc2.*.r_bindo, rid);
    let l:i32=au_get32(qrc2.*.r_bindl, rid);
    return s[o..o+l];
}
// imp antecedent / consequent spans (into lit_arena); empty if not imp
fn q_impante(g:*QG, rid:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=qar.*.lit_arena;
    let o:i32=au_get32(rc3.*.r_impo, rid);
    if(o<0){ return ""; }
    let l:i32=au_get32(rc3.*.r_imln, rid);
    return s[o..o+l];
}
fn q_impconsq(g:*QG, rid:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=qar.*.lit_arena;
    let o:i32=au_get32(rc3.*.r_impo, rid);
    if(o<0){ return ""; }
    let l:i32=au_get32(rc3.*.r_imln, rid);
    // FIX 2026-09-25 (pre-existing): consequent starts after the comma;
    // o+l pointed at the comma, yielding ",bird(tweet" style slices.
    let o2:i32=o+l+1;
    let l2:i32=au_get32(rc3.*.r_imcn, rid);
    return s[o2..o2+l2];
}
fn q_rfabv(g:*QG, rid:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=qar.*.lit_arena;
    let o:i32=au_get32(rc3.*.r_fabvo, rid);
    if(o<0){ return ""; }
    let l:i32=au_get32(rc3.*.r_fabln, rid);
    return s[o..o+l];
}
fn q_rfabd(g:*QG, rid:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=qar.*.lit_arena;
    let o:i32=au_get32(rc3.*.r_fabvo, rid);
    if(o<0){ return ""; }
    let l:i32=au_get32(rc3.*.r_fabln, rid);
    // FIX 2026-09-25 (pre-existing): the body follows the binder, a comma,
    // and optional whitespace (forall(v , body)); the old o+l pointed at
    // the comma, so UI re-parsed ",imp(...)" and failed -> empty conclusions.
    let p:i32=o+l;
    while(p<s.len && (s[p]==32||s[p]==9||s[p]==10||s[p]==13)){ p=p+1; }
    if(p>=s.len || s[p]!=44){ return ""; }
    p=p+1;
    while(p<s.len && (s[p]==32||s[p]==9||s[p]==10||s[p]==13)){ p=p+1; }
    let l2:i32=au_get32(rc3.*.r_fabdn, rid);
    return s[p..p+l2];
}
fn q_rpbcp(g:*QG, rid:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=qar.*.lit_arena;
    let o:i32=au_get32(rc3.*.r_pbco, rid);
    if(o<0){ return ""; }
    let l:i32=au_get32(rc3.*.r_pbcln, rid);
    return s[o..o+l];
}

// Parse the literal once at insert; cache imp/forall/PBC spans as offsets
// into lit_arena (so generators never re-parse). Kinds: 3 NOT, 4 IMP,
// 7 FORALL, 8 FALSE, 2 VAR.
fn q_cache_lit(g:*QG, rid:i32, lit:[]u8)void {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    au_put32(rc3.*.r_impo, rid, -1); au_put32(rc3.*.r_imln, rid, 0);
    au_put32(rc3.*.r_imcn, rid, 0);
    au_put32(rc3.*.r_fabvo, rid, -1); au_put32(rc3.*.r_fabln, rid, 0);
    au_put32(rc3.*.r_fabdn, rid, 0);
    au_put32(rc3.*.r_pbco, rid, -1); au_put32(rc3.*.r_pbcln, rid, 0);
    let a:CXA=CXA{.buf="",.n=0,.cap=0,.src=""};
    if(cxa_init(&a,lit,64)!=0){ return; }
    let root:i32=cx_parse(&a,lit);
    if(root<0){ nio_free(a.buf); return; }
    let k:i32=cxk(&a,root);
    let lo:i32=au_get32(qrc2.*.r_lito, rid);
    if(k==4){
        let c0:i32=cxch(&a,root);
        let c1:i32=cxnx(&a,c0);
        au_put32(rc3.*.r_impo, rid, lo+cxs(&a,c0));
        au_put32(rc3.*.r_imln, rid, cxl(&a,c0));
        au_put32(rc3.*.r_imcn, rid, cxl(&a,c1));
        // PBC-direct shape: imp(not(X), false) with X not a VAR
        if(cxk(&a,c0)==3 && cxk(&a,c1)==8){
            let nx:i32=cxch(&a,c0);
            if(cxk(&a,nx)!=2){
                au_put32(rc3.*.r_pbco, rid, lo+cxs(&a,nx));
                au_put32(rc3.*.r_pbcln, rid, cxl(&a,nx));
            }
        }
    }
    if(k==7){
        au_put32(rc3.*.r_fabvo, rid, lo+cxbo(&a,root));
        au_put32(rc3.*.r_fabln, rid, cxbl(&a,root));
        let cb:i32=cxch(&a,root);
        au_put32(rc3.*.r_fabdn, rid, cxl(&a,cb));
    }
    nio_free(a.buf);
    return;
}
fn nxk2(a:*CXA, i:i32)i32 {
    if(i<0){ return 0; }
    if(cxk(a,i)==2){ return 0; }
    return 1;
}

// ---- conflict family: subset-minimal, lex sorted by bitset bytes ----
fn q_conflict(g:*QG, i:i32)[]u8 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let s:[]u8=su.*.cf_arena;
    let nb:i32=su.*.nb;
    return s[i*nb..i*nb+nb];
}
// returns 1 if K newly added, 0 if redundant, -1 on overflow
fn q_conflict_insert(g:*QG, k:[]u8)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let nb:i32=su.*.nb;
    let i:i32=0;
    while(i<su.*.nconf){
        if(qb_subset(q_conflict(g,i),k,nb)==1){ return 0; }
        i=i+1;
    }
    let w:i32=0;
    i=0;
    while(i<su.*.nconf){
        let e:[]u8=q_conflict(g,i);
        let drop:i32=0;
        if(qb_subset(k,e,nb)==1 && qb_equal(k,e,nb)==0){ drop=1; }
        if(drop==0){
            if(w!=i){ qb_copy(q_conflict(g,w),e,nb); }
            w=w+1;
        }
        i=i+1;
    }
    // binary-search insert position in the sorted [0..w)
    let lo:i32=0;
    let hi:i32=w-1;
    while(lo<=hi){
        let m:i32=(lo+hi)>>1;
        let c:i32=qb_cmp(k,q_conflict(g,m),nb);
        if(c==0){ return 0; }
        if(c<0){ hi=m-1; } else { lo=m+1; }
    }
    let j:i32=w;
    while(j>lo){ qb_copy(q_conflict(g,j),q_conflict(g,j-1),nb); j=j-1; }
    qb_copy(q_conflict(g,lo),k,nb);
    su.*.nconf=w+1;
    return 1;
}
// monotone taint: 1 iff some conflict K ⊆ sup
fn q_tainted(g:*QG, sup:[]u8)i32 {
    // QG-split prologue: subsystem pointers (znc large-struct workarounds)
    let qs:*QSL=g.*.sl;
    let qp:*QPL=g.*.pl;
    let rc1:*QRC1=g.*.r1;
    let qrc2:*QRC2=g.*.r2;
    let rc3:*QRC3=g.*.r3;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let qar:*QAR=qb.*.ar;
    let mi:*QMI=qb.*.mi;
    let mz:*QMZ=qb.*.mz;
    let w1:*QW1=qb.*.w1;
    let w2:*QW2=qb.*.w2;
    let w3:*QW3=qb.*.w3;
    let u1:*QU1=qb.*.u1;
    let qu2:*QU2=qb.*.u2;
    let nb:i32=su.*.nb;
    let i:i32=0;
    while(i<su.*.nconf){
        if(qb_subset(q_conflict(g,i),sup,nb)==1){ return 1; }
        i=i+1;
    }
    return 0;
}

// ---------- init ----------
// Allocate all arenas. nitems_max bounds the contingent item count (nb derived
// from it). rule_cap bounds parsed rule records. Returns 0 ok, -1 on failure.
// ---------- init ----------
// Allocate all arenas into the caller-owned subsystem structs and link them
// into g. nitems_max bounds the contingent item count (nb derived from it).
// Subsystem shells live in the caller (main); qg_init only fills arenas +
// counters + links pointers. Returns 0 ok, -1 on failure.
fn qg_init(g:*QG, qs:*QSL, qp:*QPL, rc1:*QRC1, qrc2:*QRC2, rc3:*QRC3,
           su:*QSU, qar:*QAR, mi:*QMI, mz:*QMZ, w1:*QW1, w2:*QW2, w3:*QW3,
           u1:*QU1, qu2:*QU2, qb:*QB, nitems_max:i32) i32 {
    let nbmax:i32=(nitems_max+7)>>3;
    if(nbmax<1){ nbmax=1; }
    su.*.nbmax=nbmax;
    su.*.nb=0;
    // record scalars (32768)
    rc1.*.r_slot=nio_alloc(131072); if(rc1.*.r_slot.len==0){return -1;}
    rc1.*.r_pol=nio_alloc(131072); if(rc1.*.r_pol.len==0){return -1;}
    rc1.*.r_dep=nio_alloc(131072); if(rc1.*.r_dep.len==0){return -1;}
    rc1.*.r_sch=nio_alloc(131072); if(rc1.*.r_sch.len==0){return -1;}
    rc1.*.r_root=nio_alloc(131072); if(rc1.*.r_root.len==0){return -1;}
    rc1.*.r_uses=nio_alloc(131072); if(rc1.*.r_uses.len==0){return -1;}
    rc1.*.r_hot=nio_alloc(131072); if(rc1.*.r_hot.len==0){return -1;}
    rc1.*.r_dead=nio_alloc(131072); if(rc1.*.r_dead.len==0){return -1;}
    qrc2.*.r_final=nio_alloc(131072); if(qrc2.*.r_final.len==0){return -1;}
    qrc2.*.r_premo=nio_alloc(131072); if(qrc2.*.r_premo.len==0){return -1;}
    qrc2.*.r_premn=nio_alloc(131072); if(qrc2.*.r_premn.len==0){return -1;}
    qrc2.*.r_bindo=nio_alloc(131072); if(qrc2.*.r_bindo.len==0){return -1;}
    qrc2.*.r_bindl=nio_alloc(131072); if(qrc2.*.r_bindl.len==0){return -1;}
    qrc2.*.r_lito=nio_alloc(131072); if(qrc2.*.r_lito.len==0){return -1;}
    qrc2.*.r_litl=nio_alloc(131072); if(qrc2.*.r_litl.len==0){return -1;}
    rc3.*.r_impo=nio_alloc(131072); if(rc3.*.r_impo.len==0){return -1;}
    rc3.*.r_imln=nio_alloc(131072); if(rc3.*.r_imln.len==0){return -1;}
    rc3.*.r_imcn=nio_alloc(131072); if(rc3.*.r_imcn.len==0){return -1;}
    rc3.*.r_fabvo=nio_alloc(131072); if(rc3.*.r_fabvo.len==0){return -1;}
    rc3.*.r_fabln=nio_alloc(131072); if(rc3.*.r_fabln.len==0){return -1;}
    rc3.*.r_fabdn=nio_alloc(131072); if(rc3.*.r_fabdn.len==0){return -1;}
    rc3.*.r_pbco=nio_alloc(131072); if(rc3.*.r_pbco.len==0){return -1;}
    rc3.*.r_pbcln=nio_alloc(131072); if(rc3.*.r_pbcln.len==0){return -1;}
    su.*.r_sup=nio_alloc(32768*nbmax); if(su.*.r_sup.len==0){return -1;}
    // slots (8192)
    qs.*.sl_ao=nio_alloc(32768); if(qs.*.sl_ao.len==0){return -1;}
    qs.*.sl_al=nio_alloc(32768); if(qs.*.sl_al.len==0){return -1;}
    qp.*.sl_po=nio_alloc(32768); if(qp.*.sl_po.len==0){return -1;}
    qp.*.sl_pn=nio_alloc(32768); if(qp.*.sl_pn.len==0){return -1;}
    qp.*.sl_qo=nio_alloc(32768); if(qp.*.sl_qo.len==0){return -1;}
    qp.*.sl_qn=nio_alloc(32768); if(qp.*.sl_qn.len==0){return -1;}
    qp.*.sl_pcap=nio_alloc(32768); if(qp.*.sl_pcap.len==0){return -1;}
    qp.*.sl_qcap=nio_alloc(32768); if(qp.*.sl_qcap.len==0){return -1;}
    qs.*.sl_atom=nio_alloc(262144); if(qs.*.sl_atom.len==0){return -1;}
    // lists and arenas
    qp.*.pl_arena=nio_alloc(1048576); if(qp.*.pl_arena.len==0){return -1;}
    qar.*.prem_arena=nio_alloc(262144); if(qar.*.prem_arena.len==0){return -1;}
    mz.*.bind_arena=nio_alloc(1048576); if(mz.*.bind_arena.len==0){return -1;}
    qar.*.lit_arena=nio_alloc(2097152); if(qar.*.lit_arena.len==0){return -1;}
    su.*.sup_arena=nio_alloc(65536*nbmax); if(su.*.sup_arena.len==0){return -1;}
    su.*.cf_arena=nio_alloc(8192*nbmax); if(su.*.cf_arena.len==0){return -1;}
    qar.*.rante_arena=nio_alloc(262144); if(qar.*.rante_arena.len==0){return -1;}
    qar.*.r_rante=nio_alloc(131072); if(qar.*.r_rante.len==0){return -1;}
    qar.*.r_ranteln=nio_alloc(131072); if(qar.*.r_ranteln.len==0){return -1;}
    mz.*.imp_arena=nio_alloc(131072); if(mz.*.imp_arena.len==0){return -1;}
    mz.*.fa_arena=nio_alloc(131072); if(mz.*.fa_arena.len==0){return -1;}
    // universe
    u1.*.u_off=nio_alloc(262144); if(u1.*.u_off.len==0){return -1;}
    u1.*.u_len=nio_alloc(262144); if(u1.*.u_len.len==0){return -1;}
    u1.*.u_arena=nio_alloc(2097152); if(u1.*.u_arena.len==0){return -1;}
    u1.*.u_fn=nio_alloc(16384); if(u1.*.u_fn.len==0){return -1;}
    u1.*.u_fno=nio_alloc(16384); if(u1.*.u_fno.len==0){return -1;}
    u1.*.u_fnn=nio_alloc(16384); if(u1.*.u_fnn.len==0){return -1;}
    qu2.*.u_fna=nio_alloc(16384); if(qu2.*.u_fna.len==0){return -1;}
    qu2.*.fn_arena=nio_alloc(262144); if(qu2.*.fn_arena.len==0){return -1;}
    // worklist
    w1.*.w_pop=nio_alloc(524288); if(w1.*.w_pop.len==0){return -1;}
    w1.*.w_dep=nio_alloc(524288); if(w1.*.w_dep.len==0){return -1;}
    w1.*.w_sch=nio_alloc(524288); if(w1.*.w_sch.len==0){return -1;}
    w1.*.w_uses=nio_alloc(524288); if(w1.*.w_uses.len==0){return -1;}
    w1.*.w_root=nio_alloc(524288); if(w1.*.w_root.len==0){return -1;}
    w1.*.w_rante=nio_alloc(524288); if(w1.*.w_rante.len==0){return -1;}
    w1.*.w_ranteln=nio_alloc(524288); if(w1.*.w_ranteln.len==0){return -1;}
    w1.*.w_premo=nio_alloc(524288); if(w1.*.w_premo.len==0){return -1;}
    w2.*.w_premn=nio_alloc(524288); if(w2.*.w_premn.len==0){return -1;}
    w2.*.w_bindo=nio_alloc(524288); if(w2.*.w_bindo.len==0){return -1;}
    w2.*.w_bindl=nio_alloc(524288); if(w2.*.w_bindl.len==0){return -1;}
    w2.*.w_conco=nio_alloc(524288); if(w2.*.w_conco.len==0){return -1;}
    w2.*.w_concl=nio_alloc(524288); if(w2.*.w_concl.len==0){return -1;}
    w2.*.pw_arena=nio_alloc(1048576); if(w2.*.pw_arena.len==0){return -1;}
    w3.*.bw_arena=nio_alloc(4194304); if(w3.*.bw_arena.len==0){return -1;}
    w3.*.cw_arena=nio_alloc(4194304); if(w3.*.cw_arena.len==0){return -1;}
    // decisions, items
    mi.*.dec_lit=nio_alloc(131072); if(mi.*.dec_lit.len==0){return -1;}
    mi.*.it_claim=nio_alloc(nitems_max*8); if(mi.*.it_claim.len==0){return -1;}
    // counters
    qrc2.*.nrec=0; qs.*.nslots=0; qs.*.sl_n=0;
    qp.*.pl_n=0; qar.*.prem_n=0; mz.*.bind_n=0; qar.*.lit_n=0;
    su.*.sup_n=0; su.*.nconf=0; su.*.cf_n=0;
    qar.*.rante_n=0; mz.*.imp_n=0; mz.*.fa_n=0;
    u1.*.u_n=0; u1.*.u_m=0; qu2.*.u_fnn_n=0; qu2.*.fn_n=0;
    w2.*.wl_n=0; w2.*.pw_n=0; w3.*.bw_n=0; w3.*.cw_n=0;
    mi.*.ndec=0; mi.*.nitems=0;
    mi.*.sub=0; mi.*.committed=0;
    mi.*.n_ins=0; mi.*.n_enq=0;
    mz.*.n_pop=0; mz.*.n_sub=0;
    // link subsystems into g and qb
    g.*.sl=qs; g.*.pl=qp; g.*.r1=rc1; g.*.r2=qrc2; g.*.r3=rc3; g.*.su=su;
    g.*.b=qb;
    qb.*.ar=qar; qb.*.mi=mi; qb.*.mz=mz;
    qb.*.w1=w1; qb.*.w2=w2; qb.*.w3=w3; qb.*.u1=u1; qb.*.u2=qu2;
    return 0;
}
// set nb from loaded item count; must be called after q_load_items
fn qg_set_nb(g:*QG)void {
    let qs:*QSL=g.*.sl;
    let su:*QSU=g.*.su;
    let qb:*QB=g.*.b;
    let mi:*QMI=qb.*.mi;
    let nb:i32=(mi.*.nitems+7)>>3;
    if(nb<1){ nb=1; }
    if(nb>su.*.nbmax){ nb=su.*.nbmax; }
    su.*.nb=nb;
    return;
}

// i64 to decimal string (strips trailing newline per AGENTS.md)
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){ return s[0..s.len-1]; }
    return s;
}

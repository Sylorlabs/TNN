// reffirst.zag — REF-FIRST ENGINE: derivation THROUGH the H5 referee.
//
// Control flow is INVERTED relative to DUAL. There is no separate prover
// engine producing candidates for post-hoc judgment:
//   - The REFEREE owns the hypothesis agenda (H0=WITHHELD, H1=target,
//     H2=not(target)) and a per-hypothesis state (evidence count, status,
//     depth-slice budget, last-selected round).
//   - Each round the referee SELECTS the next hypothesis by a mechanical,
//     frozen priority rule (least-evidenced-first; tie -> least-recently-
//     selected, T first overall), ISSUES a derivation directive (bounded
//     match-and-bind expansion: goal + depth slice + schema set + premise
//     constraints), and EXECUTES it via the derivation subroutine.
//     The subroutine NEVER runs except on a referee directive.
//   - The directive returns new claims + audit chains + contradiction flags.
//   - The referee SCORES the partial evidence MID-SEARCH with the real H5
//     deliberation (dlb_delib.zag, imported verbatim) and decides: deepen
//     this line, switch hypothesis, or stop.
//   - Withhold is owned by the referee PER HYPOTHESIS: a refuted line does
//     not poison unrelated lines.
//   - When a directive leaves both H and NOT-H derivable, the referee
//     WEIGHS (premise quality, independence, depth — same rubric as HYB)
//     and either sustains one side or shelves the pair, recording the
//     weighing. Weighing outcomes feed a per-schema trust ledger (starts
//     uniform; distrust emerges only from lost weighings).
// Termination: target derived and referee-sustained, agenda exhausted
// (every active hypothesis refuted, shelved, or stalled at max budget),
// referee-decisive (conf=1000), or the round bound (primary 8; battery
// parameter via argv[3], max 128).
//
// Usage: reffirst_bin <problem.form> <out_path> [round_bound]  (CWD = math_logic dir)
// Exit: 0 ok; 3 sealed-guard; 4 input/alloc error; 5 3x divergence;
//       6 committed-schema hash mismatch.
// Pure Zag, zero RNG. 3x in-process reruns, byte-identical asserted.

@import("../../../../deliberation_depth/harness/R33_NATIVE_SHA256_V2.zag")
@import("../../../../deliberation_depth/harness/R33_NATIVE_IO_V1.zag")
@import("../../../../deliberation_depth/harness/dlb_util.zag")
@import("../../../../deliberation_depth/harness/dlb_json.zag")
@import("../../../../deliberation_depth/harness/dlb_cfg.zag")
@import("../../../../deliberation_depth/harness/dlb_ledger.zag")
@import("dlb_delib.zag")
@import("../../../engines/common/cx_fwd.zag")

// Referee-owned hypothesis agenda state.
// st: 0 active, 1 refuted-by-weighing, 2 shelved (weighing tie).
// trust0/1/2: per-schema trust ledger for S_MP/S_PBC/S_UI (uniform 1000).
struct RFE {
    evT:i32, evN:i32,
    stT:i32, stN:i32,
    budT:i32, budN:i32,
    lastT:i32, lastN:i32,
    stallT:i32, stallN:i32,
    dT:i32, dN:i32,
    ddT:i32, ddN:i32,
    trust0:i32, trust1:i32, trust2:i32,
    weighed:i32, evF:i32,
    nev:i32,
    esup:[]u8, eatt1:[]u8, eatt2:[]u8, ew:[]u8
}

fn rf_ev_init(r:*RFE)i32 {
    let a:[]u8=nio_alloc(64*4);if(a.len!=256){return -1;}
    let b:[]u8=nio_alloc(64*4);if(b.len!=256){nio_free(a);return -1;}
    let c:[]u8=nio_alloc(64*4);if(c.len!=256){nio_free(a);nio_free(b);return -1;}
    let d:[]u8=nio_alloc(64*4);if(d.len!=256){nio_free(a);nio_free(b);nio_free(c);return -1;}
    r.*.esup=a;r.*.eatt1=b;r.*.eatt2=c;r.*.ew=d;
    r.*.nev=0;
    r.*.evT=0;r.*.evN=0;
    r.*.stT=0;r.*.stN=0;
    r.*.budT=0;r.*.budN=0;
    r.*.lastT=0;r.*.lastN=0;
    r.*.stallT=0;r.*.stallN=0;
    r.*.dT=0;r.*.dN=0;r.*.ddT=0;r.*.ddN=0;
    r.*.trust0=1000;r.*.trust1=1000;r.*.trust2=1000;
    r.*.weighed=0;r.*.evF=0;
    return 0;
}

// Frozen evidence weight rubric (same as DUAL, auditable under KB4):
// W(d) = 1000/(1+d), min 1.
fn rf_w(depth:i32)i32 {
    let w:i32=1000/(1+depth);
    if(w<1){w=1;}
    return w;
}

// Derivation SUBROUTINE of the referee: backward match-and-bind prove of
// goal within the directive's depth slice. Runs ONLY when the referee
// issues a directive. Logs to lg. Returns 1 if goal proved (now in store).
fn rf_prove(s:*CXS,p:*ONEP,goal:[]u8,depth:i32,lg:*DOut)i32 {
    if(cxs_find(s,goal)>=0){return 1;}
    if(depth<=0){return 0;}
    // S_MP backward: antecedent must be provable at depth-1
    let j:i32=0;
    while(j<s.*.n){
        if(cxs_ok(s,j,0)==1){
            let jb:[]u8=cxs_bytes(s,j);
            let ja:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
            let jr:i32=-1;
            if(one_parse_tmp(jb,&ja,&jr)==0 && jr>=0 && cxk(&ja,jr)==4){
                let c1:i32=cxch(&ja,jr);
                let c2:i32=cxnx(&ja,c1);
                if(c2>=0 && nio_equal(cx_span(&ja,c2),goal)==1){
                    let asp:[]u8=cx_copy(cx_span(&ja,c1));
                    dout_str(lg,"SUB BWD-MP: C");dout_i64(lg,j as i64);
                    dout_str(lg," needs ");dout_str(lg,asp);dout_str(lg,"\n");
                    let pr:i32=rf_prove(s,p,asp,depth-1,lg);
                    if(pr==1){
                        let ri:i32=cxs_find(s,asp);
                        let rd:i32=0;
                        if(ri>=0){rd=au_get32(s.*.dep,ri);}
                        let ab:[]u8=cx_concat("S_MP_BWD C",_zag_i64_to_str(j as i64));
                        let ab2:[]u8=cx_concat(ab," C");
                        nio_free(ab);
                        let ab3:[]u8=cx_concat(ab2,_zag_i64_to_str(ri as i64));
                        nio_free(ab2);
                        cxs_add(s,goal,ab3,rd+1,1);
                        nio_free(ab3);
                        dout_str(lg,"SUB BWD-MP: proved ");
                        dout_str(lg,goal);dout_str(lg,"\n");
                        nio_free(asp);nio_free(ja.buf);
                        return 1;
                    }
                    nio_free(asp);
                }
            }
            nio_free(ja.buf);
        }
        j=j+1;
    }
    // S_UI backward: goal must match a forall body with binder bound
    let goa:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
    if(cxa_init(&goa,goal,256)==0){
        let gr2:i32=cx_parse(&goa,goal);
        if(gr2>=0){
            let jj:i32=0;
            while(jj<s.*.n){
                if(cxs_ok(s,jj,0)==1){
                    let jb2:[]u8=cxs_bytes(s,jj);
                    let ja2:CXA=CXA{.buf:"",.n:0,.cap:0,.src:""};
                    let jr2:i32=-1;
                    if(one_parse_tmp(jb2,&ja2,&jr2)==0 && jr2>=0 && cxk(&ja2,jr2)==7){
                        let bv:[]u8=cx_bvar(&ja2,jr2);
                        let bd:i32=cxch(&ja2,jr2);
                        let bb:CXB=CXB{.cap:0,.set:"",.off:"",.len:""};
                        if(cxb_init(&bb,4)==0){
                            if(cx_match_bvar(&ja2,bd,&goa,gr2,bv,0,&bb)==1 && bb.set[0]==1){
                                let t:[]u8=cx_copy(cxb_slice(&bb,0,goal));
                                let ab:[]u8=cx_concat("S_UI_BWD C",_zag_i64_to_str(jj as i64));
                                let ab2:[]u8=cx_concat(ab," ");
                                nio_free(ab);
                                let ab3:[]u8=cx_concat(ab2,bv);
                                nio_free(ab2);
                                let ab4:[]u8=cx_concat(ab3,":=");
                                nio_free(ab3);
                                let ab5:[]u8=cx_concat(ab4,t);
                                nio_free(ab4);
                                cxs_add(s,goal,ab5,1,1);
                                nio_free(ab5);nio_free(t);
                                dout_str(lg,"SUB BWD-UI: proved ");
                                dout_str(lg,goal);dout_str(lg,"\n");
                                nio_free(ja2.buf);
                                jj=s.*.n;
                            }
                        }
                    }
                    nio_free(ja2.buf);
                }
                jj=jj+1;
            }
            if(cxs_find(s,goal)>=0){nio_free(goa.buf);return 1;}
        }
        nio_free(goa.buf);
    }
    // S_PBC backward: subproof assuming not(goal) derives false.
    // Inlined (rather than one_pbc_for) so the discharged claim's audit
    // cites the subproof's store premises: the weighing rubric's premise-
    // quality score needs the real support chain, not a bare ASSUME tag.
    dout_str(lg,"SUB BWD-PBC: subproof for ");dout_str(lg,goal);dout_str(lg,"\n");
    let sp:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&sp,8192)==0){
        let nb:[]u8=cx_concat("not(",goal);
        let nb2:[]u8=cx_concat(nb,")");
        nio_free(nb);
        let q0:i32=s.*.n;let d0:i32=s.*.dn;
        let aa:[]u8=cx_copy("ASSUME not(T) for PBC");
        cxs_add(s,nb2,aa,0,2);
        nio_free(nb2);nio_free(aa);
        let f2:i32=one_bfs(s,p,depth,1,"false",1);
        if(f2==1){
            let fi2:i32=cxs_find(s,"false");
            let seen2:[]u8=nio_alloc(4096);
            let pset2:[]u8=nio_alloc(1024);
            let ab:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
            if(fi2>=0 && seen2.len==4096 && pset2.len==1024 && dout_init(&ab,1024)==0){
                dout_str(&sp,"SUBPROOF ASSUME not(T); derived false in ");
                dout_i64(&sp,(s.*.n-q0) as i64);
                dout_str(&sp," steps:");
                dout_line(&sp);
                let si:i32=q0;
                while(si<s.*.n){
                    dout_str(&sp,"  SC");dout_i64(&sp,(si-q0) as i64);
                    dout_str(&sp,": ");dout_str(&sp,cxs_bytes(s,si));
                    dout_str(&sp," [");dout_str(&sp,cxs_audit(s,si));dout_str(&sp,"]");
                    dout_line(&sp);
                    si=si+1;
                }
                let nst:i32=0;let nde:i32=0;let nps:i32=0;let msk:i32=0;
                rf_walk(s,fi2,seen2,pset2,&nps,&msk,&nst,&nde);
                dout_str(&ab,"S_PBC_BWD ASSUME:not(T)");
                let qq:i32=0;
                while(qq<nps){
                    dout_str(&ab," C");dout_i64(&ab,au_get32(pset2,qq) as i64);
                    qq=qq+1;
                }
                dout_str(&ab," FALSE_DERIVED");
                let aub:[]u8=cx_copy(dout_bytes(&ab));
                dout_free(&ab);
                cxs_trunc(s,q0,d0);
                if(cxs_find(s,goal)<0){
                    cxs_add(s,goal,aub,1,1);
                }
                nio_free(aub);
            }
            nio_free(seen2);nio_free(pset2);
            dout_str(lg,"SUB BWD-PBC: proved ");
            dout_str(lg,goal);dout_str(lg," via subproof\n");
            dout_str(lg,dout_bytes(&sp));
            dout_free(&sp);
            return 1;
        }
        cxs_trunc(s,q0,d0);
        dout_free(&sp);
    }
    dout_str(lg,"SUB BWD: failed ");dout_str(lg,goal);dout_str(lg,"\n");
    return 0;
}

// Append one evidence item to the referee's evidence list.
// sup: supporting hypothesis (0/1/2); att1/att2: attacked (-1 = none).
fn rf_add_ev(r:*RFE,sup:i32,att1:i32,att2:i32,w:i32)i32 {
    let n:i32=r.*.nev;
    if(n>=64){return -1;}
    let es:[]u8=r.*.esup;
    let e1:[]u8=r.*.eatt1;
    let e2:[]u8=r.*.eatt2;
    let ew:[]u8=r.*.ew;
    au_put32(es,n,sup);au_put32(e1,n,att1);au_put32(e2,n,att2);au_put32(ew,n,w);
    r.*.nev=n+1;
    if(sup==1){r.*.evT=r.*.evT+1;}
    if(sup==2){r.*.evN=r.*.evN+1;}
    return n;
}

// Referee SELECT: mechanical priority rule (frozen with the build).
// Among active, non-stalled hypotheses, least-evidenced-first; tie ->
// least-recently-selected (T first overall). A hypothesis stalls only when
// its directive yields nothing AT the max budget; new claims from any line
// clear all stalls (new information may unblock a line).
// Returns 1 (H_T), 2 (H_N), or -1 (exhausted).
fn rf_select(r:*RFE)i32 {
    let t_ok:i32=0;let n_ok:i32=0;
    if(r.*.stT==0 && r.*.stallT==0){t_ok=1;}
    if(r.*.stN==0 && r.*.stallN==0){n_ok=1;}
    if(t_ok==0 && n_ok==0){return -1;}
    if(t_ok==1 && n_ok==0){return 1;}
    if(t_ok==0 && n_ok==1){return 2;}
    let eT:i32=r.*.evT;let eN:i32=r.*.evN;
    if(eT<eN){return 1;}
    if(eN<eT){return 2;}
    if(r.*.lastT<=r.*.lastN){return 1;}
    return 2;
}

fn rf_append_name(line:[]u8,cur:i32,name:[]u8,off:*i32,ln:*i32)i32 {
    line[cur]=124;
    let s:i32=cur+1;
    let i:i32=0;
    while(i<name.len){line[s+i]=name[i];i=i+1;}
    off.*=s;ln.*=name.len;
    return s+name.len;
}

// Build the H5 item from the current hypothesis agenda + evidence list.
fn rf_build_item(it:*Item,line:[]u8,llen:i32,pid:[]u8,r:*RFE,rlog:*DOut)i32 {
    let cur:i32=0;
    let i:i32=0;
    while(i<pid.len && cur<llen){line[cur]=pid[i];i=i+1;cur=cur+1;}
    it.*.line=line;
    it.*.id_off=0;it.*.id_len=pid.len;
    it.*.tt_off=0;it.*.tt_len=0;
    it.*.gt_off=0;it.*.gt_len=0;
    it.*.nh=0;it.*.ne=0;
    it.*.maxh=16;it.*.maxe=64;it.*.maxl=16;
    let off:i32=0;let ln:i32=0;
    cur=rf_append_name(line,cur,"H0",&off,&ln);
    if(dj_add_hyp(it,((off as i64)<<32)|(ln as i64))!=0){return -1;}
    cur=rf_append_name(line,cur,"H1",&off,&ln);
    if(dj_add_hyp(it,((off as i64)<<32)|(ln as i64))!=0){return -2;}
    cur=rf_append_name(line,cur,"H2",&off,&ln);
    if(dj_add_hyp(it,((off as i64)<<32)|(ln as i64))!=0){return -3;}
    let es:[]u8=r.*.esup;
    let e1:[]u8=r.*.eatt1;
    let e2:[]u8=r.*.eatt2;
    let ew:[]u8=r.*.ew;
    let k:i32=0;
    let nn:i32=r.*.nev;
    while(k<nn){
        let nm:[]u8=cx_concat("E",_zag_i64_to_str((k+1) as i64));
        cur=rf_append_name(line,cur,nm,&off,&ln);
        nio_free(nm);
        let e:i32=dj_add_ev(it,((off as i64)<<32)|(ln as i64));
        if(e<0){return -10;}
        let sup:i32=au_get32(es,k);
        let a1:i32=au_get32(e1,k);
        let a2:i32=au_get32(e2,k);
        let w:i32=au_get32(ew,k);
        dout_str(rlog,"R ITEM-EV E");dout_i64(rlog,(k+1) as i64);
        dout_str(rlog,": sup=H");dout_i64(rlog,sup as i64);
        dout_str(rlog," att1=");dout_i64(rlog,a1 as i64);
        dout_str(rlog," att2=");dout_i64(rlog,a2 as i64);
        dout_str(rlog," w=");dout_i64(rlog,w as i64);dout_str(rlog,"\n");
        if(dj_add_link(it,e,sup,w,0)!=0){return -11;}
        if(a1>=0){if(dj_add_link(it,e,a1,w,1)!=0){return -12;}}
        if(a2>=0){if(dj_add_link(it,e,a2,w,1)!=0){return -13;}}
        k=k+1;
    }
    return 0;
}

// Run the real H5 deliberation over the CURRENT (partial) evidence.
// tag: "R MID-SEARCH" or "R VERDICT". Returns leader 0/1/2, sets conf/margin.
fn rf_deliberate(pid:[]u8,r:*RFE,rlog:*DOut,confp:*i32,marginp:*i64,tag:[]u8)i32 {
    let line:[]u8=nio_alloc(4096);
    let it:Item=Item{.line:"",.id_off:-1,.id_len:0,.tt_off:-1,.tt_len:0,.gt_off:-1,.gt_len:0,.nh:0,.ne:0,.hid:"",.eid:"",.evns:"",.evna:"",.sup:"",.att:"",.maxh:16,.maxe:64,.maxl:16};
    if(line.len!=4096){return -1;}
    let p_it:*Item=&it;
    p_it.*.hid=nio_alloc(16*8);
    p_it.*.eid=nio_alloc(64*8);
    p_it.*.evns=nio_alloc(64*4);
    p_it.*.evna=nio_alloc(64*4);
    p_it.*.sup=nio_alloc(64*16*2*4);
    p_it.*.att=nio_alloc(64*16*2*4);
    if(p_it.*.hid.len==0 || p_it.*.sup.len==0){nio_free(line);return -2;}
    let brc:i32=rf_build_item(&it,line,4096,pid,r,rlog);
    if(brc!=0){nio_free(line);return -3;}
    let st:DSt=DSt{.scores:"",.alive:"",.hist_l:"",.hist_m:"",.rounds:0,.consumed:0,.leader:-1,.margin:0,.conf:0,.hcap:42};
    let p_st:*DSt=&st;
    p_st.*.scores=nio_alloc(16*8);
    p_st.*.alive=nio_alloc(16);
    p_st.*.hist_l=nio_alloc(42*4);
    p_st.*.hist_m=nio_alloc(42*8);
    // Frozen R config (same as DUAL, documented in DIRECTIVE_RUBRIC.md).
    let cfg:DCfg=DCfg{.mode:1,.shallow_rounds:1,.deep_rounds:12,.amin:1,.amax:12,.conf_thr:100,.stab_win:2,.eps:1,.elim_margin:150,.refute_thr:500,.evcap:128};
    let lg:LG=LG{.seq:0,.prev:"",.head:""};
    let lgo:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(p_st.*.scores.len==0 || dout_init(&lgo,1048576)!=0 || lg_init(&lg)!=0){
        nio_free(line);return -4;
    }
    if(lg_step(&lg,&lgo,pid,0,"GENESIS","reffirst referee")==0){
        let rc:i32=dlb_run(&st,&it,&cfg,&lg,&lgo);
        if(rc==0){
            dout_str(rlog,tag);dout_str(rlog,": leader=H");
            dout_i64(rlog,st.leader as i64);
            dout_str(rlog," conf=");dout_i64(rlog,st.conf as i64);
            dout_str(rlog," margin=");dout_i64(rlog,st.margin);
            dout_str(rlog," rounds=");dout_i64(rlog,st.rounds as i64);
            dout_str(rlog,"\n");
            dout_str(rlog,"R LEDGER_HEAD: ");
            dout_str(rlog,lg_head_hex(&lg));
            dout_str(rlog,"\n");
            confp.*=st.conf;marginp.*=st.margin;
            let ld:i32=st.leader;
            nio_free(line);
            return ld;
        }
    }
    nio_free(line);
    return -5;
}

// ---------- audit-chain walk for the weighing rubric ----------
// First token of an audit entry -> committed-schema id (0/1/2), else -1.
fn rf_audit_schema(a:[]u8)i32 {
    let e:i32=0;
    while(e<a.len && a[e]!=32){e=e+1;}
    let t:[]u8=a[0..e];
    if(cx_starts(t,"S_MP")==1){return 0;}
    if(cx_starts(t,"S_PBC")==1){return 1;}
    if(cx_starts(t,"S_UI")==1){return 2;}
    return -1;
}

// Walk the support chain of claim root through "C<digits>" audit refs.
// Accumulates: nstore/nder (store-grounded vs derived claims),
// distinct store-premise indices (pset), schema bitmask (bit id = schema).
fn rf_walk(s:*CXS,root:i32,seen:[]u8,pset:[]u8,npset:*i32,
           mask:*i32,nstore:*i32,nder:*i32)void {
    let cap:i32=4096;
    let stk:[]u8=nio_alloc(cap*4);
    if(stk.len!=cap*4){return;}
    let top:i32=1;
    au_put32(stk,0,root);
    while(top>0){
        top=top-1;
        let idx:i32=au_get32(stk,top);
        if(idx>=0 && idx<s.*.n && seen[idx]==0){
            seen[idx]=1;
            let kd:i32=au_get32(s.*.kind,idx);
            if(kd==0){
                nstore.*=nstore.*+1;
                let f:i32=0;let q:i32=0;
                while(q<npset.*){
                    if(au_get32(pset,q)==idx){f=1;}
                    q=q+1;
                }
                if(f==0 && npset.*<256){
                    au_put32(pset,npset.*,idx);
                    npset.*=npset.*+1;
                }
            } else {
                nder.*=nder.*+1;
            }
            let au:[]u8=cxs_audit(s,idx);
            let sc:i32=rf_audit_schema(au);
            if(sc>=0){
                let bit:i32=1;
                if(sc==1){bit=2;}
                if(sc==2){bit=4;}
                if(mask.*/bit%2==0){mask.*=mask.*+bit;}
            }
            let p2:i32=0;
            while(p2<au.len){
                while(p2<au.len && au[p2]==32){p2=p2+1;}
                let ts:i32=p2;
                while(p2<au.len && au[p2]!=32){p2=p2+1;}
                if(p2-ts>=2 && au[ts]==67){
                    let ok:i32=1;let v:i32=0;let q2:i32=ts+1;
                    while(q2<p2){
                        let cc:u8=au[q2];
                        if(cc<48 || cc>57){ok=0;}
                        v=v*10+((cc-48) as i32);
                        q2=q2+1;
                    }
                    if(ok==1 && top<cap){au_put32(stk,top,v);top=top+1;}
                }
            }
        }
    }
    nio_free(stk);
    return;
}

// Weighing score for one side (frozen rubric, DIRECTIVE_RUBRIC.md):
//   SCORE = PQ + 200*CORR - 10*DEPTH
// PQ = 1000 * store-grounded / total support claims (1000 if none);
//   halved if any schema in the chain has trust < 500 (distrust penalty).
// CORR = distinct store premises in the chain, capped at 3 (independence).
// DEPTH = derivation depth of the goal claim.
fn rf_side_score(s:*CXS,idx:i32,r:*RFE,lg:*DOut)i32 {
    let seen:[]u8=nio_alloc(4096);
    if(seen.len!=4096){return -999999;}
    let pset:[]u8=nio_alloc(1024);
    if(pset.len!=1024){nio_free(seen);return -999999;}
    let nstore:i32=0;let nder:i32=0;let npset:i32=0;let mask:i32=0;
    rf_walk(s,idx,seen,pset,&npset,&mask,&nstore,&nder);
    nio_free(seen);nio_free(pset);
    let total:i32=nstore+nder;
    let pq:i32=1000;
    if(total>0){pq=(1000*nstore)/total;}
    let pen:i32=0;
    if(mask/1%2==1 && r.*.trust0<500){pen=1;}
    if(mask/2%2==1 && r.*.trust1<500){pen=1;}
    if(mask/4%2==1 && r.*.trust2<500){pen=1;}
    if(pen==1){pq=pq/2;}
    let corr:i32=npset;
    if(corr>3){corr=3;}
    let dep:i32=au_get32(s.*.dep,idx);
    let score:i32=pq+200*corr-10*dep;
    dout_str(lg,"R WEIGH-SIDE C");dout_i64(lg,idx as i64);
    dout_str(lg,": PQ=");dout_i64(lg,pq as i64);
    dout_str(lg," CORR=");dout_i64(lg,corr as i64);
    dout_str(lg," DEPTH=");dout_i64(lg,dep as i64);
    dout_str(lg," SCORE=");dout_i64(lg,score as i64);
    dout_str(lg,"\n");
    return score;
}

// Distrust: every schema appearing in the LOSING side's chain loses 100
// trust (floor 0). Starts uniform; changes only via lost weighings.
fn rf_distrust(s:*CXS,idx:i32,r:*RFE,lg:*DOut)void {
    let seen:[]u8=nio_alloc(4096);
    if(seen.len!=4096){return;}
    let pset:[]u8=nio_alloc(1024);
    if(pset.len!=1024){nio_free(seen);return;}
    let nstore:i32=0;let nder:i32=0;let npset:i32=0;let mask:i32=0;
    rf_walk(s,idx,seen,pset,&npset,&mask,&nstore,&nder);
    nio_free(seen);nio_free(pset);
    if(mask/1%2==1){
        let t:i32=r.*.trust0-100;
        if(t<0){t=0;}
        r.*.trust0=t;
        dout_str(lg,"R TRUST: S_MP -> ");dout_i64(lg,t as i64);dout_str(lg,"\n");
    }
    if(mask/2%2==1){
        let t2:i32=r.*.trust1-100;
        if(t2<0){t2=0;}
        r.*.trust1=t2;
        dout_str(lg,"R TRUST: S_PBC -> ");dout_i64(lg,t2 as i64);dout_str(lg,"\n");
    }
    if(mask/4%2==1){
        let t3:i32=r.*.trust2-100;
        if(t3<0){t3=0;}
        r.*.trust2=t3;
        dout_str(lg,"R TRUST: S_UI -> ");dout_i64(lg,t3 as i64);dout_str(lg,"\n");
    }
    return;
}

// Referee WEIGH: both H and NOT-H derivable. Sustain the higher-scoring
// side; mark the loser REFUTED-BY-WEIGHING (per-hypothesis withhold — the
// audit trail is kept, unrelated lines continue). Tie: shelve the pair,
// withhold on that claim only, agenda continues elsewhere.
fn rf_weigh(s:*CXS,r:*RFE,iT:i32,iN:i32,lg:*DOut)void {
    dout_str(lg,"R WEIGH: T and not(T) both derivable; referee weighs evidence\n");
    let sT:i32=rf_side_score(s,iT,r,lg);
    let sN:i32=rf_side_score(s,iN,r,lg);
    if(sT>sN){
        dout_str(lg,"R WEIGH: H_T sustains (");dout_i64(lg,sT as i64);
        dout_str(lg," > ");dout_i64(lg,sN as i64);
        dout_str(lg,"); H_N REFUTED-BY-WEIGHING (per-hypothesis withhold)\n");
        r.*.stN=1;
        rf_distrust(s,iN,r,lg);
    } else {
        if(sN>sT){
            dout_str(lg,"R WEIGH: H_N sustains (");dout_i64(lg,sN as i64);
            dout_str(lg," > ");dout_i64(lg,sT as i64);
            dout_str(lg,"); H_T REFUTED-BY-WEIGHING (per-hypothesis withhold)\n");
            r.*.stT=1;
            rf_distrust(s,iT,r,lg);
        } else {
            dout_str(lg,"R WEIGH: tie (");dout_i64(lg,sT as i64);
            dout_str(lg,"); referee SHELVES the pair: withhold on this claim only\n");
            r.*.stT=2;r.*.stN=2;
        }
    }
    r.*.weighed=1;
    dout_str(lg,"R TRUST-LEDGER: S_MP=");dout_i64(lg,r.*.trust0 as i64);
    dout_str(lg," S_PBC=");dout_i64(lg,r.*.trust1 as i64);
    dout_str(lg," S_UI=");dout_i64(lg,r.*.trust2 as i64);
    dout_str(lg,"\n");
    return;
}

// ---------------- output ----------------
fn rf_emit(o:*DOut,pid:[]u8,vcode:i32,claim:[]u8,conf:i32,deriv:i32,
           flags:[]u8,s:*CXS,rlog:*DOut,r:*RFE)void {
    dout_str(o,"ID: ");dout_str(o,pid);dout_str(o,"\n");
    dout_str(o,"ENGINE: reffirst\n");
    let verdict:[]u8="WITHHELD";
    if(vcode==1){verdict="DERIVED";}
    if(vcode==2){verdict="REFUTED";}
    dout_str(o,"VERDICT: ");dout_str(o,verdict);dout_str(o,"\n");
    dout_str(o,"CLAIM: ");dout_str(o,claim);dout_str(o,"\n");
    dout_str(o,"CONFIDENCE: ");dout_i64(o,conf as i64);dout_str(o,"\n");
    dout_str(o,"DERIVATIONS: ");dout_i64(o,deriv as i64);dout_str(o,"\n");
    dout_str(o,"SCHEMAS: S_MP=");
    dout_str(o,cx_sch_hex(0));
    dout_str(o," S_PBC=");
    dout_str(o,cx_sch_hex(1));
    dout_str(o," S_UI=");
    dout_str(o,cx_sch_hex(2));
    dout_str(o,"\n");
    dout_str(o,"FLAGS: ");dout_str(o,flags);dout_str(o,"\n");
    dout_str(o,"R_STEPS:\n");dout_str(o,dout_bytes(rlog));
    dout_str(o,"R_TRUST-FINAL: S_MP=");dout_i64(o,r.*.trust0 as i64);
    dout_str(o," S_PBC=");dout_i64(o,r.*.trust1 as i64);
    dout_str(o," S_UI=");dout_i64(o,r.*.trust2 as i64);dout_str(o,"\n");
    dout_str(o,"AUDIT:\n");
    let i:i32=0;
    while(i<s.*.n){
        dout_str(o,"C");dout_i64(o,i as i64);dout_str(o,": ");
        dout_str(o,cxs_bytes(s,i));dout_str(o," [");
        dout_str(o,cxs_audit(s,i));dout_str(o,"]\n");
        i=i+1;
    }
}

// One full REF-FIRST run into o. Returns 0 ok, 3 sealed, 4 input, 6 schema.
fn rf_run(o:*DOut,fbuf:[]u8,flen:i32,sbuf:[]u8,sn:i32,bound:i32)i32 {
    if(cx_sch_assert()!=0){return 6;}
    let f:CXF=CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_form(fbuf,flen,&f,512)!=0){return 4;}
    let k:CXK=CXK{.kid_off:"",.kid_len:"",.kcl_off:"",.kcl_len:"",.nk:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_store(sbuf,sn,&k,512)!=0){return -4;}
    let p:ONEP=ONEP{.a_mp1:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp1:0,.a_mp2:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_mp2:0,.a_pb:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_pb:0,.a_ui:CXA{.buf:"",.n:0,.cap:0,.src:""},.r_ui:0};
    if(onep_init(&p)!=0){return -4;}
    let s:CXS=CXS{.n:0,.cap:0,.data:"",.dn:0,.dcap:0,.coff:"",.clen:"",.aoff:"",.alen:"",.dep:"",.kind:"",.deriv:0};
    if(cxs_init(&s,4096,2097152)!=0){return -4;}
    let ps:*CXS=&s;
    // load store claims as premises
    let i:i32=0;
    while(i<k.nk){
        let kb:[]u8=cx_kclaim(&k,i);
        let cb:[]u8=cx_canon(kb);
        if(cb.len>0){
            let ao:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
            if(dout_init(&ao,128)==0){
                dout_str(&ao,"PREM ");dout_str(&ao,cx_kid(&k,i));
                let ab:[]u8=cx_copy(dout_bytes(&ao));
                dout_free(&ao);
                cxs_add(&s,cb,ab,0,0);
                nio_free(cb);nio_free(ab);
            }
        }
        i=i+1;
    }
    // load problem premises
    i=0;
    while(i<f.nprem){
        let pb:[]u8=cx_prem(&f,i);
        let cb2:[]u8=cx_canon(pb);
        if(cb2.len==0){return -4;}
        let ab2:[]u8=cx_copy("PREM");
        cxs_add(&s,cb2,ab2,0,0);
        nio_free(cb2);nio_free(ab2);
        i=i+1;
    }
    let target:[]u8=cx_canon(f.target);
    if(target.len==0){return -4;}
    let notT:[]u8=cx_concat("not(",target);
    let notT2:[]u8=cx_concat(notT,")");
    nio_free(notT);
    // referee state
    let rfe:RFE=RFE{.evT:0,.evN:0,.stT:0,.stN:0,.budT:0,.budN:0,.lastT:0,.lastN:0,.stallT:0,.stallN:0,.dT:0,.dN:0,.ddT:0,.ddN:0,.trust0:0,.trust1:0,.trust2:0,.weighed:0,.evF:0,.nev:0,.esup:"",.eatt1:"",.eatt2:"",.ew:""};
    let pr:*RFE=&rfe;
    if(rf_ev_init(pr)!=0){return -4;}
    let rlog:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&rlog,4194304)!=0){return -4;}
    dout_str(&rlog,"R AGENDA: H0=WITHHELD H1=target H2=not(target); referee owns per-hypothesis withhold\n");
    dout_str(&rlog,"R PRIORITY (frozen): least-evidenced-first; tie -> least-recently-selected (T first)\n");
    dout_str(&rlog,"R DIRECTIVE FORM: goal + depth-slice + schemas{S_MP,S_UI,S_PBC} + premises usable(kind0/1)\n");
    let round:i32=0;
    let vcode:i32=0;
    let claim:[]u8="-";
    let oconf:i32=0;
    let flags:[]u8="NONE";
    let done:i32=0;
    // ---- referee-driven loop ----
    while(done==0 && round<bound){
        round=round+1;
        dout_str(&rlog,"R ROUND ");dout_i64(&rlog,round as i64);dout_str(&rlog,"\n");
        let sel:i32=rf_select(pr);
        if(sel<0){
            dout_str(&rlog,"R SELECT: agenda exhausted (no active, non-stalled hypothesis)\n");
            done=1;
        } else {
            dout_str(&rlog,"R SELECT: ");
            if(sel==1){dout_str(&rlog,"H_T");}else{dout_str(&rlog,"H_N");}
            dout_str(&rlog," (evT=");dout_i64(&rlog,rfe.evT as i64);
            dout_str(&rlog," evN=");dout_i64(&rlog,rfe.evN as i64);
            dout_str(&rlog,")\n");
            let goal:[]u8=target;
            if(sel==2){goal=notT2;}
            let bud:i32=0;
            if(sel==1){
                rfe.budT=rfe.budT+1;
                if(rfe.budT>bound){rfe.budT=bound;}
                bud=rfe.budT;rfe.lastT=round;
            } else {
                rfe.budN=rfe.budN+1;
                if(rfe.budN>bound){rfe.budN=bound;}
                bud=rfe.budN;rfe.lastN=round;
            }
            dout_str(&rlog,"R DIR#");dout_i64(&rlog,round as i64);
            dout_str(&rlog,": referee issues directive: derive ");
            dout_str(&rlog,goal);
            dout_str(&rlog,"; depth-slice ");dout_i64(&rlog,bud as i64);
            dout_str(&rlog,"; schemas {S_MP,S_UI,S_PBC}; premises usable(kind0/1)\n");
            // EXECUTE: derivation subroutine (referee-initiated only)
            let sub:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
            if(dout_init(&sub,1048576)!=0){return -4;}
            let n0:i32=s.n;
            let proved:i32=rf_prove(ps,&p,goal,bud,&sub);
            let newc:i32=s.n-n0;
            dout_str(&rlog,"SUB (derivation subroutine, referee-initiated):\n");
            dout_str(&rlog,dout_bytes(&sub));
            dout_free(&sub);
            // directive returns: claims + audit chains + contradiction flags
            let iT:i32=cxs_find(ps,target);
            let iN:i32=cxs_find(ps,notT2);
            let iF:i32=cxs_find(ps,"false");
            if(iT>=0){rfe.dT=1;rfe.ddT=au_get32(s.dep,iT);}
            if(iN>=0){rfe.dN=1;rfe.ddN=au_get32(s.dep,iN);}
            if(proved==1){
                let dd:i32=rfe.ddT;
                if(sel==2){dd=rfe.ddN;}
                let w:i32=rf_w(dd);
                let att:i32=2;
                if(sel==2){att=1;}
                let ei:i32=rf_add_ev(pr,sel,att,-1,w);
                dout_str(&rlog,"R EVIDENCE E");dout_i64(&rlog,(ei+1) as i64);
                dout_str(&rlog,": directive proved goal at depth ");
                dout_i64(&rlog,dd as i64);dout_str(&rlog," w=");
                dout_i64(&rlog,w as i64);
                if(sel==1){dout_str(&rlog," supports H1 attacks H2\n");}
                if(sel==2){dout_str(&rlog," supports H2 attacks H1\n");}
            } else {
                dout_str(&rlog,"R EVIDENCE: none (directive did not prove its goal)\n");
            }
            if(iF>=0 && rfe.evF==0){
                rfe.evF=1;
                let ef:i32=rf_add_ev(pr,0,1,2,1000);
                dout_str(&rlog,"R EVIDENCE E");dout_i64(&rlog,(ef+1) as i64);
                dout_str(&rlog,": false derived w=1000 supports H0 attacks H1 H2\n");
            }
            // contradiction: both H and NOT-H derivable -> referee weighs
            if(rfe.dT==1 && rfe.dN==1 && rfe.weighed==0){
                rf_weigh(ps,pr,iT,iN,&rlog);
                flags="CONTRADICTION_DERIVED";
            }
            if(iF>=0){flags="CONTRADICTION_DERIVED";}
            // MID-SEARCH scoring: real H5 over partial evidence
            let conf:i32=0;let marg:i64=0;
            let leader:i32=rf_deliberate(f.id,pr,&rlog,&conf,&marg,"R MID-SEARCH");
            if(leader<0){return -4;}
            // referee decides: deepen, switch, or stop
            // stall accounting: new claims (or a proof) clear all stalls —
            // new information may unblock a line. A fruitless directive at
            // the max budget stalls that hypothesis (per-hypothesis
            // withhold: the other line continues).
            if(proved==1 || newc>0){
                if(rfe.stallT==1 || rfe.stallN==1){
                    dout_str(&rlog,"R UNSTALL: new claims reopen stalled lines\n");
                }
                rfe.stallT=0;rfe.stallN=0;
            } else {
                if(bud>=bound){
                    if(sel==1){rfe.stallT=1;}else{rfe.stallN=1;}
                    dout_str(&rlog,"R STALL: ");
                    if(sel==1){dout_str(&rlog,"H_T");}else{dout_str(&rlog,"H_N");}
                    dout_str(&rlog," fruitless at max budget; per-hypothesis withhold\n");
                }
            }
            if(rfe.dT==1 && leader==1){
                dout_str(&rlog,"R DECIDE: target derived and referee sustains H1 -> DERIVED; stop\n");
                vcode=1;claim=target;oconf=conf;done=1;
            } else {
                if(rfe.dN==1 && leader==2){
                    dout_str(&rlog,"R DECIDE: not(target) derived and referee sustains H2 -> REFUTED; stop\n");
                    vcode=2;oconf=conf;done=1;
                } else {
                    if(conf==1000){
                        dout_str(&rlog,"R DECIDE: referee decisive (conf=1000) -> stop\n");
                        done=1;
                    } else {
                        dout_str(&rlog,"R DECIDE: continue (next round: deepen/switch per priority rule)\n");
                    }
                }
            }
        }
    }
    // final referee verdict over the full evidence
    let fconf:i32=0;let fmarg:i64=0;
    let fleader:i32=rf_deliberate(f.id,pr,&rlog,&fconf,&fmarg,"R VERDICT");
    if(fleader<0){return -4;}
    if(vcode==0){
        if(fleader==1){vcode=1;claim=target;oconf=fconf;}
        if(fleader==2){vcode=2;oconf=fconf;}
    }
    dout_str(&rlog,"R ROUNDS: ");dout_i64(&rlog,round as i64);dout_str(&rlog,"\n");
    rf_emit(o,f.id,vcode,claim,oconf,s.deriv,flags,ps,&rlog,pr);
    nio_free(notT2);nio_free(target);
    return 0;
}

fn rf_atoi(b:[]u8)i32 {
    let v:i32=0;let i:i32=0;
    while(i<b.len){
        let c:u8=b[i];
        if(c<48 || c>57){return -1;}
        v=v*10+((c-48) as i32);
        i=i+1;
    }
    return v;
}

fn main()i32 {
    if(_zag_argc()<3){
        _zag_println("usage: reffirst_bin <problem.form> <out_path>  (CWD must be the math_logic dir)");
        return 4;
    }
    let fpath:[]u8=_zag_arg(1);
    let opath:[]u8=_zag_arg(2);
    let bound:i32=8;
    if(_zag_argc()>=4){
        let bv:i32=rf_atoi(_zag_arg(3));
        if(bv>0 && bv<=128){bound=bv;}
    }
    let fbuf:[]u8=nio_alloc(1048576);
    if(fbuf.len==0){return 4;}
    let flen:i64=cx_guarded_read(fpath,fbuf);
    if(flen==-99){_zag_println("reffirst: sealed guard tripped on problem file");return 3;}
    if(flen<=0){_zag_println("reffirst: cannot read problem file");return 4;}
    let f:CXF=CXF{.id:"",.store:"",.target:"",.prem_off:"",.prem_len:"",.nprem:0,.cap:0,.buf:"",.n:0};
    if(cx_parse_form(fbuf,flen as i32,&f,512)!=0){_zag_println("reffirst: bad .form");return 4;}
    let sbuf:[]u8=nio_alloc(1048576);
    if(sbuf.len==0){return 4;}
    let sn:i64=cx_guarded_read(f.store,sbuf);
    if(sn==-99){_zag_println("reffirst: sealed guard tripped on store file");return 3;}
    if(sn<=0){_zag_println("reffirst: cannot read store file");return 4;}
    // 3x in-process reruns, byte-identical assert
    let r1:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let r2:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    let r3:DOut=DOut{.buf:"",.n:0,.cap:0,.err:0};
    if(dout_init(&r1,4194304)!=0 || dout_init(&r2,4194304)!=0 || dout_init(&r3,4194304)!=0){return 4;}
    let e1:i32=rf_run(&r1,fbuf,flen as i32,sbuf,sn as i32,bound);
    let e2:i32=rf_run(&r2,fbuf,flen as i32,sbuf,sn as i32,bound);
    let e3:i32=rf_run(&r3,fbuf,flen as i32,sbuf,sn as i32,bound);
    if(e1==6 || e2==6 || e3==6){_zag_println("reffirst: committed-schema mismatch");return 6;}
    if(e1==3 || e2==3 || e3==3){_zag_println("reffirst: sealed guard tripped");return 3;}
    let div:i32=0;
    if(e1!=0 || e2!=0 || e3!=0){div=2;}
    if(div==0){
        let b1:[]u8=dout_bytes(&r1);
        let b2:[]u8=dout_bytes(&r2);
        let b3:[]u8=dout_bytes(&r3);
        if(nio_equal(b1,b2)==0 || nio_equal(b2,b3)==0){div=1;}
    }
    if(div!=0){
        _zag_println("reffirst: DIVERGENCE across 3x reruns");
        if(div==1){return 5;}
        return 4;
    }
    let wrc:i64=dlb_write_file(opath,dout_bytes(&r1),r1.n);
    if(wrc<0){return 4;}
    return 0;
}

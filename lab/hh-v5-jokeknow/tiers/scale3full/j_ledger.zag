// j_ledger.zag — joke/lie/satire trial audit ledger (pure Zag, no RNG, no timestamps).
//
// This znc build rejects top-level globals, so the ledger is pure functions:
// the caller owns prev-hash + seq and threads them through j_emit.
// Entry (v1): sha256(prev_hash || seq_le64 || op || 0x00 || item_id || 0x00
//                     || intent || 0x00 || install || 0x00 || codes)
// op:      1=SESSION_START 2=HELPER_OBSERVED 3=ITEM_JUDGED 4=SESSION_END
// intent:  1=SINCERE 2=JOKING 3=SATIRE 4=DECEPTIVE 5=UNCERTAIN
// install: 1=INSTALL 2=WITHHOLD
//
// Ledger print line:  LG|<seq>|<op>|<item>|<intent>|<install>|<codes>|<entryhex>

@import("R33_NATIVE_SHA256_V2.zag")
@import("R33_NATIVE_IO_V1.zag")

// ---------- low-level utils (single definitions shared by all trial modules) ----------

fn j_alloc(n:i32)[]u8 {
    let b:[]u8=nio_alloc(n);
    return b;
}

fn j_zero(b:[]u8)void {
    let i:i32=0;
    while(i<b.len){b[i]=0;i=i+1;}
    return;
}

fn j_copy(dst:[]u8,doff:i32,src:[]u8)void {
    let i:i32=0;
    while(i<src.len){dst[doff+i]=src[i];i=i+1;}
    return;
}

fn j_copyn(dst:[]u8,doff:i32,src:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){dst[doff+i]=src[i];i=i+1;}
    return;
}

fn j_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// length of NUL-terminated buffer
fn j_cstrlen(b:[]u8)i32 {
    let i:i32=0;
    while(i<b.len){if(b[i]==0){return i;}i=i+1;}
    return b.len;
}

fn j_sha256(data:[]u8)[]u8 {
    let out:[]u8=j_alloc(32);
    let rc:i32=ns_sha256(data,out);
    if(rc!=0){_zag_println("FATAL sha256");}
    return out;
}

fn j_hex(raw:[]u8)[]u8 {
    let out:[]u8=j_alloc(raw.len*2);
    let i:i32=0;
    while(i<raw.len){
        let v:i32=raw[i] as i32;
        let d0:i32=(v>>4)&15;
        let d1:i32=v&15;
        if(d0<10){out[i*2]=(48+d0) as u8;}else{out[i*2]=(87+d0) as u8;}
        if(d1<10){out[i*2+1]=(48+d1) as u8;}else{out[i*2+1]=(87+d1) as u8;}
        i=i+1;
    }
    return out;
}

fn j_seq_bytes(seq:i64)[]u8 {
    let b:[]u8=j_alloc(8);
    let s:i64=seq;
    let i:i32=0;
    while(i<8){b[i]=(s&255) as u8;s=s>>8;i=i+1;}
    return b;
}

fn j_sep()[]u8 {
    let n:[]u8=j_alloc(1);
    n[0]=0;
    return n;
}

fn j_cat2(a:[]u8,b:[]u8)[]u8 {
    let out:[]u8=j_alloc(a.len+b.len);
    j_copy(out,0,a);
    j_copy(out,a.len,b);
    return out;
}

fn j_byte(v:i32)[]u8 {
    let b:[]u8=j_alloc(1);
    b[0]=v as u8;
    return b;
}

// exact-size copy of a NUL-terminated buffer (for hashing/printing)
fn j_exact(buf:[]u8)[]u8 {
    let n:i32=j_cstrlen(buf);
    let out:[]u8=j_alloc(n);
    j_copyn(out,0,buf,n);
    return out;
}

// ---------- text utils ----------

fn j_tolower(s:[]u8)[]u8 {
    let out:[]u8=j_alloc(s.len);
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65){if(c<=90){out[i]=c+32;}else{out[i]=c;}}else{out[i]=c;}
        i=i+1;
    }
    return out;
}

fn j_is_alnum(c:u8)i32 {
    if(c>=48){if(c<=57){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    return 0;
}

// plain substring
fn j_has_sub(hay:[]u8,needle:[]u8)i32 {
    if(needle.len==0){return 0;}
    if(needle.len>hay.len){return 0;}
    let i:i32=0;
    while(i<=hay.len-needle.len){
        let k:i32=0;
        while(k<needle.len){
            if(hay[i+k]!=needle[k]){break;}
            k=k+1;
        }
        if(k==needle.len){return 1;}
        i=i+1;
    }
    return 0;
}

// whole-word match (non-alnum boundaries)
fn j_has_word(hay:[]u8,w:[]u8)i32 {
    if(w.len==0){return 0;}
    if(w.len>hay.len){return 0;}
    let i:i32=0;
    while(i<=hay.len-w.len){
        let k:i32=0;
        while(k<w.len){
            if(hay[i+k]!=w[k]){break;}
            k=k+1;
        }
        if(k==w.len){
            let ok:i32=1;
            if(i>0){if(j_is_alnum(hay[i-1])!=0){ok=0;}}
            if(i+w.len<hay.len){if(j_is_alnum(hay[i+w.len])!=0){ok=0;}}
            if(ok!=0){return 1;}
        }
        i=i+1;
    }
    return 0;
}

// ---------- ledger emit (pure; caller threads prev+seq) ----------

// returns new prev hash (32 bytes)
fn j_emit(prev:[]u8,seq:i64,op:i32,item:[]u8,intent:i32,install:i32,codes:[]u8)[]u8 {
    let h1:[]u8=j_cat2(prev,j_seq_bytes(seq));
    let h2:[]u8=j_cat2(h1,j_byte(op));
    let h3:[]u8=j_cat2(h2,j_sep());
    let h4:[]u8=j_cat2(h3,item);
    let h5:[]u8=j_cat2(h4,j_sep());
    let h6:[]u8=j_cat2(h5,j_byte(intent));
    let h7:[]u8=j_cat2(h6,j_sep());
    let h8:[]u8=j_cat2(h7,j_byte(install));
    let h9:[]u8=j_cat2(h8,j_sep());
    let h10:[]u8=j_cat2(h9,codes);
    let eh:[]u8=j_sha256(h10);
    _zag_print("LG|");
    _zag_print(_zag_i64_to_str(seq));
    _zag_print("|");_zag_print(_zag_i64_to_str(op as i64));
    _zag_print("|");_zag_print(item);
    _zag_print("|");_zag_print(_zag_i64_to_str(intent as i64));
    _zag_print("|");_zag_print(_zag_i64_to_str(install as i64));
    _zag_print("|");_zag_print(codes);
    _zag_print("|");_zag_print(j_hex(eh));
    _zag_println("");
    return eh;
}

// w15_quarantine.zag — W15 STAGED-QUARANTINE PAM instrument (frozen PREREG_W15.md)
// Pure Zag, zero RNG. Usage: w15_quarantine <stream>
// Stream rows: id|kind|channel|tag|content_sig|contradicts
// Tier machine (frozen §2), logical time = event index:
// - T0->T1: soft-pass (all G/F pass; the flood is "genuine-looking").
// - T1->T2: a corroborating percept — same tag, DIFFERENT channel, arrived
//   within TIER1_WINDOW=5 steps. Logged with corroboration (KB-W15-XC).
// - T2->T3: SECOND corroboration — same tag, THIRD distinct channel, within
//   5 steps of the T1->T2 transition.
// - Regression: contradicts=1 demotes one tier (cascading).
// Tier table: arena hash keyed by semantic_tag -> (tier, channel mask,
// t12, kind, last-seen per channel, content_sig). Capacity 4096 slots
// (frozen cap 16384 asserted; 1868 tags used).
// Emits per-event tier transitions + per-tag finals + summary.
@import("R33_NATIVE_IO_V1.zag")
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { ob[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}
fn pfield(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0; let st:i32 = 0; let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1; st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0; let neg:i64 = 1; let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48); i = i + 1;
    }
    return v * neg;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn sx32(v:i64) i64 {
    if(v >= 2147483648) { return v - 4294967296; }
    return v;
}
// slot: 36 bytes. tag@0 tier@4 mask@8 t12@12 kind@16 ls0@20 ls1@24 ls2@28 sig@32
fn hget(ta:[]u8, s:i64, off:i64) i64 {
    let b:i64 = s * 36 + off;
    return sx32((ta[b] as i64) | ((ta[b + 1] as i64) << 8)
         | ((ta[b + 2] as i64) << 16) | ((ta[b + 3] as i64) << 24));
}
fn hput(ta:[]u8, s:i64, off:i64, v:i64) void {
    let b:i64 = s * 36 + off;
    ta[b] = (v & 255) as u8; ta[b + 1] = ((v >> 8) & 255) as u8;
    ta[b + 2] = ((v >> 16) & 255) as u8; ta[b + 3] = ((v >> 24) & 255) as u8;
}
fn lsget(ta:[]u8, s:i64, ch:i64) i64 {
    return hget(ta, s, 20 + ch * 4);
}
fn lsput(ta:[]u8, s:i64, ch:i64, v:i64) void {
    hput(ta, s, 20 + ch * 4, v);
}
fn tag_slot(ta:[]u8, tag:i64) i64 {
    let h:i64 = (tag * 2654435761) & 4095;
    let i:i64 = 0;
    while(i < 4096) {
        let s:i64 = (h + i) & 4095;
        let t:i64 = hget(ta, s, 0);
        if(t == -1) {
            hput(ta, s, 0, tag);
            hput(ta, s, 4, 0);
            hput(ta, s, 8, 0);
            hput(ta, s, 12, -1);
            hput(ta, s, 16, -1);
            lsput(ta, s, 0, -1);
            lsput(ta, s, 1, -1);
            lsput(ta, s, 2, -1);
            hput(ta, s, 32, 0);
            return s;
        }
        if(t == tag) { return s; }
        i = i + 1;
    }
    return -1;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    // frozen pins
    let WIN:i64 = 5;
    let CAP:i64 = 16384;
    let fmax:i32 = 4194304;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    let ta:[]u8 = nio_alloc(4096 * 36);
    if(ta.len == 0) { return 1; }
    // init all tags to -1 (empty)
    let si:i64 = 0;
    while(si < 4096) {
        hput(ta, si, 0, -1);
        si = si + 1;
    }
    let fld:[]u8 = nio_alloc(64);
    let ob:[]u8 = nio_alloc(4194304);
    if(ob.len == 0) { return 1; }
    let pos:i32 = 0;
    pos = ob_add(ob, pos, "W15_QUAR|frozen=PREREG_W15.md|win=5|cap=16384\n");
    let nevent:i64 = 0;
    let ntags:i64 = 0;
    let ndemote:i64 = 0;
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 512) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let ok:i64 = 1;
            let f0:i64 = 0; let f2:i64 = 0; let f3:i64 = 0;
            let f4:i64 = 0; let f5:i64 = 0;
            let kch:i64 = 0;
            let nfld:i32 = pfield(line, llen, 0, fld);
            if(nfld <= 0) { ok = 0; } else { f0 = atoi(fld, nfld); }
            nfld = pfield(line, llen, 1, fld);
            if(nfld <= 0) { ok = 0; } else {
                if(fld[0] == 71) { kch = 0; }
                else { if(fld[0] == 70) { kch = 1; } else { ok = 0; } }
            }
            nfld = pfield(line, llen, 2, fld);
            if(nfld <= 0) { ok = 0; } else { f2 = atoi(fld, nfld); }
            nfld = pfield(line, llen, 3, fld);
            if(nfld <= 0) { ok = 0; } else { f3 = atoi(fld, nfld); }
            nfld = pfield(line, llen, 4, fld);
            if(nfld <= 0) { ok = 0; } else { f4 = atoi(fld, nfld); }
            nfld = pfield(line, llen, 5, fld);
            if(nfld <= 0) { ok = 0; } else { f5 = atoi(fld, nfld); }
            if(ok == 0) { return 11; }
            if(f2 < 0 || f2 > 2) { return 12; }
            let now:i64 = nevent;
            let s:i64 = tag_slot(ta, f3);
            if(s < 0) { return 13; }
            let is_new:i64 = 0;
            if(hget(ta, s, 4) == 0 && hget(ta, s, 8) == 0 && hget(ta, s, 16) == -1) {
                is_new = 1;
                ntags = ntags + 1;
                hput(ta, s, 16, kch);
                hput(ta, s, 32, f4);
            }
            // kind/sig consistency for existing tags
            if(is_new == 0) {
                if(hget(ta, s, 16) != kch) { return 14; }
            }
            let tier:i64 = hget(ta, s, 4);
            if(f5 == 1) {
                // contradiction: demote one level, no promotion
                if(f4 == hget(ta, s, 32)) { return 15; }
                if(tier > 0) {
                    hput(ta, s, 4, tier - 1);
                    ndemote = ndemote + 1;
                    pos = ob_add(ob, pos, "T|");
                    pos = ob_add(ob, pos, i64s(f3));
                    pos = ob_add(ob, pos, "|");
                    pos = ob_add(ob, pos, i64s(tier));
                    pos = ob_add(ob, pos, "|");
                    pos = ob_add(ob, pos, i64s(tier - 1));
                    pos = ob_add(ob, pos, "|");
                    pos = ob_add(ob, pos, i64s(now));
                    pos = ob_add(ob, pos, "|DEMOTE\n");
                }
            } else {
                if(tier == 0) {
                    // T0->T1 soft-pass (frozen: genuine+false both pass)
                    hput(ta, s, 4, 1);
                    hput(ta, s, 8, 1 << f2);
                    lsput(ta, s, f2, now);
                    pos = ob_add(ob, pos, "T|");
                    pos = ob_add(ob, pos, i64s(f3));
                    pos = ob_add(ob, pos, "|0|1|");
                    pos = ob_add(ob, pos, i64s(now));
                    pos = ob_add(ob, pos, "\n");
                } else {
                    if(tier == 1) {
                        // T1->T2: different-channel corroborator within WIN
                        let cc:i64 = 0;
                        let found:i64 = 0;
                        let fch:i64 = -1;
                        let fstp:i64 = -1;
                        while(cc < 3) {
                            if(cc != f2) {
                                let lst:i64 = lsget(ta, s, cc);
                                if(lst >= 0 && now - lst <= WIN) {
                                    found = 1; fch = cc; fstp = lst;
                                }
                            }
                            cc = cc + 1;
                        }
                        // record arrival
                        hput(ta, s, 8, hget(ta, s, 8) | (1 << f2));
                        lsput(ta, s, f2, now);
                        if(found == 1) {
                            hput(ta, s, 4, 2);
                            hput(ta, s, 12, now);
                            pos = ob_add(ob, pos, "T|");
                            pos = ob_add(ob, pos, i64s(f3));
                            pos = ob_add(ob, pos, "|1|2|");
                            pos = ob_add(ob, pos, i64s(now));
                            pos = ob_add(ob, pos, "|");
                            pos = ob_add(ob, pos, i64s(fch));
                            pos = ob_add(ob, pos, "|");
                            pos = ob_add(ob, pos, i64s(fstp));
                            pos = ob_add(ob, pos, "\n");
                        }
                    } else {
                        if(tier == 2) {
                            // T2->T3: THIRD distinct channel within WIN of t12
                            let mask:i64 = hget(ta, s, 8);
                            let t12:i64 = hget(ta, s, 12);
                            let is_new_ch:i64 = 0;
                            if((mask & (1 << f2)) == 0) { is_new_ch = 1; }
                            hput(ta, s, 8, mask | (1 << f2));
                            lsput(ta, s, f2, now);
                            if(is_new_ch == 1 && now - t12 <= WIN) {
                                hput(ta, s, 4, 3);
                                pos = ob_add(ob, pos, "T|");
                                pos = ob_add(ob, pos, i64s(f3));
                                pos = ob_add(ob, pos, "|2|3|");
                                pos = ob_add(ob, pos, i64s(now));
                                pos = ob_add(ob, pos, "|");
                                pos = ob_add(ob, pos, i64s(f2));
                                pos = ob_add(ob, pos, "\n");
                            }
                        } else {
                            // tier 3: already max; record arrival
                            lsput(ta, s, f2, now);
                        }
                    }
                }
            }
            nevent = nevent + 1;
        }
        p = le + 1;
    }
    if(nevent != 5250) { return 16; }
    if(ntags > CAP) { return 17; }
    // per-tag finals
    si = 0;
    let nfinal:i64 = 0;
    while(si < 4096) {
        if(hget(ta, si, 0) != -1) {
            pos = ob_add(ob, pos, "F|");
            pos = ob_add(ob, pos, i64s(hget(ta, si, 0)));
            pos = ob_add(ob, pos, "|");
            if(hget(ta, si, 16) == 0) { pos = ob_add(ob, pos, "G"); } else { pos = ob_add(ob, pos, "F"); }
            pos = ob_add(ob, pos, "|");
            pos = ob_add(ob, pos, i64s(hget(ta, si, 4)));
            pos = ob_add(ob, pos, "|");
            pos = ob_add(ob, pos, i64s(hget(ta, si, 8)));
            pos = ob_add(ob, pos, "|");
            pos = ob_add(ob, pos, i64s(hget(ta, si, 12)));
            pos = ob_add(ob, pos, "\n");
            nfinal = nfinal + 1;
        }
        si = si + 1;
    }
    pos = ob_add(ob, pos, "SUMMARY|nevent=");
    pos = ob_add(ob, pos, i64s(nevent));
    pos = ob_add(ob, pos, "|ntags=");
    pos = ob_add(ob, pos, i64s(ntags));
    pos = ob_add(ob, pos, "|nfinal=");
    pos = ob_add(ob, pos, i64s(nfinal));
    pos = ob_add(ob, pos, "|ndemote=");
    pos = ob_add(ob, pos, i64s(ndemote));
    pos = ob_add(ob, pos, "\n");
    _zag_print(ob[0..pos]);
    return 0;
}

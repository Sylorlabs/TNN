// w3.zag — W3 VETO-ONLY PAM (PREREG_W3.md, frozen)
// Admit path: frozen M1 bar (CT=705, MT=3588, ST=0, AT=0) — USED, not adopted.
// Veto-PAM: output alphabet {VETO, ABSTAIN}; V1 pair veto, V2 attack veto.
// Final: ADMIT iff bar-pass AND no veto. Pure Zag, zero RNG.
// Usage: w3 <m1_cases.txt> ; attack rows are frozen constants in r4lib.
@import("../r4lib.zag")

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let maxrows:i32 = 4096;
    let akind:[]u8 = nio_alloc(maxrows << 3);
    let apair:[]u8 = nio_alloc(maxrows << 3);
    let aconf:[]u8 = nio_alloc(maxrows << 3);
    let amrg:[]u8 = nio_alloc(maxrows << 3);
    let astrong:[]u8 = nio_alloc(maxrows << 3);
    let aagree:[]u8 = nio_alloc(maxrows << 3);
    let nrows:i64 = load_base(a1, maxrows, akind, apair, aconf, amrg, astrong, aagree);
    if(nrows < 0) { return 1; }
    let tk:[]u8 = nio_alloc(14 << 3);
    let tc:[]u8 = nio_alloc(14 << 3);
    let tm:[]u8 = nio_alloc(14 << 3);
    let ts:[]u8 = nio_alloc(14 << 3);
    let ta:[]u8 = nio_alloc(14 << 3);
    let tx1:[]u8 = nio_alloc(14 << 3);
    let tx2:[]u8 = nio_alloc(14 << 3);
    let tx3:[]u8 = nio_alloc(14 << 3);
    let na:i64 = load_attacks(tk, tc, tm, ts, ta, tx1, tx2, tx3);
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    let c_admit:i64 = 0;
    let w_admit:i64 = 0;
    let p_admit:i64 = 0;
    let b_admit:i64 = 0;
    let a_admit:i64 = 0;
    let a_vetoed:i64 = 0;
    let npairs:i64 = 0;
    let r:i32 = 0;
    while(r < nrows as i32) {
        let kind:i64 = t_get64(akind, r << 3);
        let conf:i64 = t_get64(aconf, r << 3);
        let mrg:i64 = t_get64(amrg, r << 3);
        let bar:i64 = 0;
        if(conf >= 705 && mrg >= 3588) { bar = 1; }
        let veto:i64 = 0;
        if(kind == 2) { veto = 1; }
        let dec:i64 = 0;
        if(bar == 1 && veto == 0) { dec = 1; }
        if(kind == 0 && dec == 1) { c_admit = c_admit + 1; }
        if(kind == 1 && dec == 1) { w_admit = w_admit + 1; }
        if(kind == 2 && dec == 1) { p_admit = p_admit + 1; }
        if(kind == 3 && dec == 1) { b_admit = b_admit + 1; }
        pos = ob_add(ob, pos, "R|");
        pos = ob_add(ob, pos, i64s(r as i64));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(kind));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(dec));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(bar));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(veto));
        pos = ob_add(ob, pos, "\n");
        r = r + 1;
    }
    // pair-install check: count P pairs where BOTH members admitted
    let seen:[]u8 = nio_alloc(9 << 3);
    let s2:i32 = 0;
    while(s2 < 9) { t_put64(seen, s2 << 3, 1); s2 = s2 + 1; }
    let q:i32 = 0;
    while(q < 9) {
        let both:i64 = 1;
        let any:i64 = 0;
        let r2:i32 = 0;
        while(r2 < nrows as i32) {
            if(t_get64(akind, r2 << 3) == 2 && t_get64(apair, r2 << 3) == q as i64) {
                any = 1;
                let conf:i64 = t_get64(aconf, r2 << 3);
                let mrg:i64 = t_get64(amrg, r2 << 3);
                if(!(conf >= 705 && mrg >= 3588)) { both = 0; }
            }
            r2 = r2 + 1;
        }
        if(any == 1 && both == 1) { npairs = npairs + 1; }
        q = q + 1;
    }
    let i2:i32 = 0;
    while(i2 < na as i32) {
        let kind:i64 = t_get64(tk, i2 << 3);
        let conf:i64 = t_get64(tc, i2 << 3);
        let mrg:i64 = t_get64(tm, i2 << 3);
        let asg:i64 = attack_sig(kind, t_get64(tx1, i2 << 3), t_get64(tx2, i2 << 3), t_get64(tx3, i2 << 3));
        let bar:i64 = 0;
        if(conf >= 705 && mrg >= 3588) { bar = 1; }
        let veto:i64 = 0;
        if(asg == 1) { veto = 1; }
        let dec:i64 = 0;
        if(bar == 1 && veto == 0) { dec = 1; }
        if(dec == 1) { a_admit = a_admit + 1; }
        if(veto == 1) { a_vetoed = a_vetoed + 1; }
        pos = ob_add(ob, pos, "R|");
        pos = ob_add(ob, pos, i64s(nrows + i2 as i64));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(kind));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(dec));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(bar));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(veto));
        pos = ob_add(ob, pos, "\n");
        i2 = i2 + 1;
    }
    // FRK fork-install: both members of any session admitted
    let fork_fail:i64 = 0;
    let sess:[]u8 = nio_alloc(3 << 3);
    t_put64(sess, 0, 501);
    t_put64(sess, 8, 502);
    t_put64(sess, 16, 503);
    let f:i32 = 0;
    while(f < 3) {
        let sid:i64 = t_get64(sess, f << 3);
        let nm:i64 = 0;
        let i3:i32 = 0;
        while(i3 < na as i32) {
            if(t_get64(tk, i3 << 3) == 5 && t_get64(tx1, i3 << 3) == sid) {
                let conf:i64 = t_get64(tc, i3 << 3);
                let mrg:i64 = t_get64(tm, i3 << 3);
                let asg:i64 = attack_sig(5, sid, t_get64(tx2, i3 << 3), t_get64(tx3, i3 << 3));
                if(conf >= 705 && mrg >= 3588 && asg == 0) { nm = nm + 1; }
            }
            i3 = i3 + 1;
        }
        if(nm == 2) { fork_fail = 1; }
        f = f + 1;
    }
    pos = ob_kv(ob, pos, "DESIGN", "W3_VETO_ONLY");
    pos = ob_kv(ob, pos, "rows_base", i64s(nrows));
    pos = ob_kv(ob, pos, "rows_attack", i64s(na));
    pos = ob_kv(ob, pos, "c_admit", i64s(c_admit));
    pos = ob_kv(ob, pos, "w_admit", i64s(w_admit));
    pos = ob_kv(ob, pos, "p_pair_installs", i64s(npairs));
    pos = ob_kv(ob, pos, "p_member_admit", i64s(p_admit));
    pos = ob_kv(ob, pos, "b_admit", i64s(b_admit));
    pos = ob_kv(ob, pos, "a_admit", i64s(a_admit));
    pos = ob_kv(ob, pos, "a_vetoed", i64s(a_vetoed));
    pos = ob_kv(ob, pos, "fork_fail", i64s(fork_fail));
    _zag_print(ob[0..pos]);
    nio_free(ob);
    return 0;
}

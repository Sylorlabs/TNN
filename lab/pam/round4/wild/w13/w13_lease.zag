// w13_lease.zag — W13 EPISTEMIC LEASE PAM instrument (frozen PREREG_W13.md)
// Pure Zag, zero RNG. Usage: w13_lease <stream>
// Stream rows: lease_id|kind|channel|tag|conf|mrgF|strong|agree
// kind=G: genuine, must pass frozen M1 bar (705,3588) on conf/mrgF (gen_lease.py
//   pre-filters to the 910 passing C rows; the instrument re-verifies).
// kind=F: false, granted BY FIAT (BYPASS_GRANT), unique tag (never corroborated).
// Mechanism (frozen):
// - Grant: expires_at = granted_at + 10 (LEASE_DURATION, frozen).
// - Renewal: lease renews iff another ACTIVE lease shares its semantic_tag
//   from a DIFFERENT channel with |granted_at diff| <= 3 (corroboration window,
//   frozen; symmetric reading — see VERDICT_W13.md for the prereg-ambiguity note).
//   ACTIVE evaluated against the scanner's snapshot (literal §2).
// - Scanner: each logical step, up to 64 (SCAN_BUDGET, frozen) leases with
//   expires_at <= now, in append order. Snapshot refresh every 3 steps
//   (REFRESH_LAG, frozen), refresh BEFORE the step's scan (literal "at scan start").
// - Renewal: expires_at += 10, renewed=1. Else inert (one-time check).
// Emits: header, G|... grant lines, C|... check lines, L|... per-lease finals,
// SUMMARY. Deterministic; 2x runs must be byte-identical.
@import("R33_NATIVE_IO_V1.zag")
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { ob[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}
fn pfield(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0; let st:i32 = 0; let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1; st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0; let neg:i64 = 1; let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48); i = i + 1;
    }
    return v * neg;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn sx32(v:i64) i64 {
    if(v >= 2147483648) { return v - 4294967296; }
    return v;
}
// lease record: 40 bytes, LE i32 fields
// id@0 kind@4 chan@8 tag@12 granted@16 expires@20 renewed@24 checked@28
// lastcheck@32 stale@36   (kind: 0=G, 1=F)
fn lget(ta:[]u8, ord:i64, off:i64) i64 {
    let b:i64 = ord * 40 + off;
    return sx32((ta[b] as i64) | ((ta[b + 1] as i64) << 8)
         | ((ta[b + 2] as i64) << 16) | ((ta[b + 3] as i64) << 24));
}
fn lput(ta:[]u8, ord:i64, off:i64, v:i64) void {
    let b:i64 = ord * 40 + off;
    ta[b] = (v & 255) as u8; ta[b + 1] = ((v >> 8) & 255) as u8;
    ta[b + 2] = ((v >> 16) & 255) as u8; ta[b + 3] = ((v >> 24) & 255) as u8;
}
fn aget(a:[]u8, i:i64) i64 {
    let b:i64 = i * 4;
    return sx32((a[b] as i64) | ((a[b + 1] as i64) << 8)
         | ((a[b + 2] as i64) << 16) | ((a[b + 3] as i64) << 24));
}
fn aput(a:[]u8, i:i64, v:i64) void {
    let b:i64 = i * 4;
    a[b] = (v & 255) as u8; a[b + 1] = ((v >> 8) & 255) as u8;
    a[b + 2] = ((v >> 16) & 255) as u8; a[b + 3] = ((v >> 24) & 255) as u8;
}
fn iabs(v:i64) i64 {
    if(v < 0) { return -v; }
    return v;
}
fn emit_grant(ob:[]u8, pos:i32, lid:i64, kind:i64, gr:i64, ex:i64) i32 {
    pos = ob_add(ob, pos, "G|");
    pos = ob_add(ob, pos, i64s(lid));
    pos = ob_add(ob, pos, "|");
    if(kind == 0) { pos = ob_add(ob, pos, "G"); } else { pos = ob_add(ob, pos, "F"); }
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(gr));
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(ex));
    pos = ob_add(ob, pos, "|");
    if(kind == 0) { pos = ob_add(ob, pos, "GATE"); } else { pos = ob_add(ob, pos, "BYPASS_GRANT"); }
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn emit_check(ob:[]u8, pos:i32, lid:i64, t:i64, st:i64, ren:i64) i32 {
    pos = ob_add(ob, pos, "C|");
    pos = ob_add(ob, pos, i64s(lid));
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(t));
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(st));
    pos = ob_add(ob, pos, "|");
    if(ren == 1) { pos = ob_add(ob, pos, "RENEW"); } else { pos = ob_add(ob, pos, "EXPIRE"); }
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn emit_final(ob:[]u8, pos:i32, ta:[]u8, ord:i64) i32 {
    pos = ob_add(ob, pos, "L|");
    pos = ob_add(ob, pos, i64s(lget(ta, ord, 0)));
    pos = ob_add(ob, pos, "|");
    if(lget(ta, ord, 4) == 0) { pos = ob_add(ob, pos, "G"); } else { pos = ob_add(ob, pos, "F"); }
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(lget(ta, ord, 16)));
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(lget(ta, ord, 20)));
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(lget(ta, ord, 24)));
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(lget(ta, ord, 32)));
    pos = ob_add(ob, pos, "|");
    pos = ob_add(ob, pos, i64s(lget(ta, ord, 36)));
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    // frozen pins
    let DUR:i64 = 10;
    let LAG:i64 = 3;
    let BUDGET:i64 = 64;
    let WIN:i64 = 3;
    let CAP:i64 = 16384;
    let CT:i64 = 705;
    let MT:i64 = 3588;
    let fmax:i32 = 4194304;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    let ta:[]u8 = nio_alloc((CAP * 40) as i32);
    let partner:[]u8 = nio_alloc((CAP * 4) as i32);
    let firstseen:[]u8 = nio_alloc(5000 * 4);
    let snapexp:[]u8 = nio_alloc((CAP * 4) as i32);
    if(ta.len == 0 || partner.len == 0 || firstseen.len == 0 || snapexp.len == 0) { return 1; }
    let i:i64 = 0;
    while(i < CAP) { aput(partner, i, -1); i = i + 1; }
    i = 0;
    while(i < 5000) { aput(firstseen, i, -1); i = i + 1; }
    let fld:[]u8 = nio_alloc(64);
    let ob:[]u8 = nio_alloc(8388608);
    if(ob.len == 0) { return 1; }
    let pos:i32 = 0;
    pos = ob_add(ob, pos, "W13_LEASE|frozen=PREREG_W13.md|dur=10|lag=3|budget=64|win=3\n");
    // parse + grant (granted_at = stream position; pre-granted, scanner sees
    // only granted<=t via expires_at monotonicity + snap_count visibility)
    let nlease:i64 = 0;
    let ng:i64 = 0;
    let nf:i64 = 0;
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 512 && nlease < CAP) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let ok:i64 = 1;
            let f0:i64 = 0; let f2:i64 = 0; let f3:i64 = 0;
            let f4:i64 = 0; let f5:i64 = 0;
            let kch:i64 = 0;
            let nfld:i32 = pfield(line, llen, 0, fld);
            if(nfld <= 0) { ok = 0; } else { f0 = atoi(fld, nfld); }
            nfld = pfield(line, llen, 1, fld);
            if(nfld <= 0) { ok = 0; } else {
                if(fld[0] == 71) { kch = 0; }
                else { if(fld[0] == 70) { kch = 1; } else { ok = 0; } }
            }
            nfld = pfield(line, llen, 2, fld);
            if(nfld <= 0) { ok = 0; } else { f2 = atoi(fld, nfld); }
            nfld = pfield(line, llen, 3, fld);
            if(nfld <= 0) { ok = 0; } else { f3 = atoi(fld, nfld); }
            nfld = pfield(line, llen, 4, fld);
            if(nfld <= 0) { ok = 0; } else { f4 = atoi(fld, nfld); }
            nfld = pfield(line, llen, 5, fld);
            if(nfld <= 0) { ok = 0; } else { f5 = atoi(fld, nfld); }
            if(ok == 0) { return 11; }
            if(kch == 0) {
                // genuine: must pass frozen M1 bar (705,3588)
                if(f4 < CT || f5 < MT) { return 12; }
                if(f3 < 0 || f3 >= 5000) { return 13; }
                let fs:i64 = aget(firstseen, f3);
                if(fs == -1) { aput(firstseen, f3, nlease); }
                else {
                    if(fs == -2) { return 14; }
                    aput(partner, nlease, fs);
                    aput(partner, fs, nlease);
                    aput(firstseen, f3, -2);
                }
                ng = ng + 1;
            } else {
                nf = nf + 1;
            }
            lput(ta, nlease, 0, f0);
            lput(ta, nlease, 4, kch);
            lput(ta, nlease, 8, f2);
            lput(ta, nlease, 12, f3);
            lput(ta, nlease, 16, nlease);
            lput(ta, nlease, 20, nlease + DUR);
            lput(ta, nlease, 24, 0);
            lput(ta, nlease, 28, 0);
            lput(ta, nlease, 32, -1);
            lput(ta, nlease, 36, -1);
            pos = emit_grant(ob, pos, f0, kch, nlease, nlease + DUR);
            nlease = nlease + 1;
        }
        p = le + 1;
    }
    if(nlease != 10050 || ng != 10000 || nf != 50) { return 15; }
    // scanner step loop (logical time = event index)
    let snap_time:i64 = -1;
    let snap_count:i64 = 0;
    let due_ptr:i64 = 0;
    let t:i64 = 0;
    let max_work:i64 = 0;
    let n_renew_g:i64 = 0;
    let n_renew_f:i64 = 0;
    while(t < nlease || due_ptr < nlease) {
        if(t > nlease + 100) { return 16; }
        if(t % LAG == 0) {
            snap_time = t;
            if(t < nlease) { snap_count = t + 1; } else { snap_count = nlease; }
            let si:i64 = 0;
            while(si < snap_count) {
                aput(snapexp, si, lget(ta, si, 20));
                si = si + 1;
            }
        }
        while(due_ptr < nlease && lget(ta, due_ptr, 28) == 1) { due_ptr = due_ptr + 1; }
        let work:i64 = 0;
        while(work < BUDGET && due_ptr < nlease && lget(ta, due_ptr, 28) == 0
              && lget(ta, due_ptr, 20) <= t) {
            let o:i64 = due_ptr;
            let po:i64 = aget(partner, o);
            let cor:i64 = 0;
            if(po >= 0) {
                let chp:i64 = lget(ta, po, 8);
                let cho:i64 = lget(ta, o, 8);
                let gp:i64 = lget(ta, po, 16);
                let go:i64 = lget(ta, o, 16);
                if(chp != cho && iabs(gp - go) <= WIN && gp <= snap_time
                   && t < aget(snapexp, po)) {
                    cor = 1;
                }
            }
            lput(ta, o, 28, 1);
            lput(ta, o, 32, t);
            lput(ta, o, 36, t - snap_time);
            if(cor == 1) {
                lput(ta, o, 24, 1);
                lput(ta, o, 20, lget(ta, o, 20) + DUR);
                if(lget(ta, o, 4) == 0) { n_renew_g = n_renew_g + 1; }
                else { n_renew_f = n_renew_f + 1; }
            }
            pos = emit_check(ob, pos, lget(ta, o, 0), t, t - snap_time, cor);
            work = work + 1;
            due_ptr = due_ptr + 1;
        }
        if(work > max_work) { max_work = work; }
        t = t + 1;
    }
    // per-lease finals
    let o2:i64 = 0;
    while(o2 < nlease) {
        pos = emit_final(ob, pos, ta, o2);
        o2 = o2 + 1;
    }
    pos = ob_add(ob, pos, "SUMMARY|n=");
    pos = ob_add(ob, pos, i64s(nlease));
    pos = ob_add(ob, pos, "|g_renew=");
    pos = ob_add(ob, pos, i64s(n_renew_g));
    pos = ob_add(ob, pos, "|f_renew=");
    pos = ob_add(ob, pos, i64s(n_renew_f));
    pos = ob_add(ob, pos, "|max_work=");
    pos = ob_add(ob, pos, i64s(max_work));
    pos = ob_add(ob, pos, "|t_end=");
    pos = ob_add(ob, pos, i64s(t));
    pos = ob_add(ob, pos, "\n");
    _zag_print(ob[0..pos]);
    return 0;
}

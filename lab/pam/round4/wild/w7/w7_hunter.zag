// w7_hunter.zag — W7 LAUNDERING-HUNTER PAM (frozen PREREG_W7.md)
// Pure Zag, zero RNG. Usage: w7_hunter <signals_file>
// Reads ONLY the signals file (id|sig_c|sig_b|sig_a); NEVER reads any
// truth/label file (label-blindness is structural: the path is not even
// taken as an argument). Per-entry: suspicion = (sig_c*3 + sig_b*2 +
// (1000 - min(sig_a,4)*250)) / 6 ; FLAG iff suspicion >= 600.
// Stateless: no cross-entry state, O(1) work per entry.
@import("R33_NATIVE_IO_V1.zag")

fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { ob[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k); pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v); pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0; let st:i32 = 0; let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1; st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0; let neg:i64 = 1; let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48); i = i + 1;
    }
    return v * neg;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let fmax:i32 = 1048576;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    let ob:[]u8 = nio_alloc(1048576);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "W7_HUNTER", "frozen=PREREG_W7.md");
    let fnum:[]u8 = nio_alloc(64);
    let nflags:i64 = 0; let nclear:i64 = 0; let nent:i64 = 0;
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 100) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let nf:i32 = field(line, llen, 0, fnum);
            let id:i64 = atoi(fnum, nf);
            nf = field(line, llen, 1, fnum);
            let sc:i64 = atoi(fnum, nf);
            nf = field(line, llen, 2, fnum);
            let sb:i64 = atoi(fnum, nf);
            nf = field(line, llen, 3, fnum);
            let sa:i64 = atoi(fnum, nf);
            if(nf >= 0) {
                // frozen suspicion formula, integer arithmetic
                let att:i64 = sa;
                if(att > 4) { att = 4; }
                if(att < 0) { att = 0; }
                let susp:i64 = (sc * 3 + sb * 2 + (1000 - att * 250)) / 6;
                pos = ob_add(ob, pos, i64s(id));
                pos = ob_add(ob, pos, "|");
                if(susp >= 600) {
                    pos = ob_add(ob, pos, "FLAG");
                    nflags = nflags + 1;
                } else {
                    pos = ob_add(ob, pos, "CLEAR");
                    nclear = nclear + 1;
                }
                pos = ob_add(ob, pos, "|");
                pos = ob_add(ob, pos, i64s(susp));
                pos = ob_add(ob, pos, "\n");
                nent = nent + 1;
            }
        }
        p = le + 1;
    }
    pos = ob_add(ob, pos, "SUMMARY|entries=");
    pos = ob_add(ob, pos, i64s(nent));
    pos = ob_add(ob, pos, "|flags=");
    pos = ob_add(ob, pos, i64s(nflags));
    pos = ob_add(ob, pos, "|clears=");
    pos = ob_add(ob, pos, i64s(nclear));
    pos = ob_add(ob, pos, "\n");
    _zag_print(ob[0..pos]);
    return 0;
}

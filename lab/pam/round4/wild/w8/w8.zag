// w8.zag — W8 RETRO-PAM (PREREG_W8.md, frozen)
// Fast path: conf>=700 & mrgF>=300 -> PROVISIONAL (prov=1). Else REJECT.
// Consumer-side fence: provisional records are STRUCTURALLY barred from
// (a) memory writes, (b) self-change inputs, (c) outward action. This binary
// contains no memory-write, self-change, or outward-action code paths at
// all; the fence_cross counter below is incremented by any such path and is
// asserted 0 at runtime (construction audit AUDIT_W8.md documents the
// exhaustive source review).
// Retrospective auditor (single deterministic pass, O(1)/row):
//   REVOKE iff P-type | attack_sig | TMB-5 signature
//     (conf in [760,835] & mrgF in [1880,2380] & strong & agree)
//   CONFIRM iff (conf>=705 & mrgF>=3588) & !revoked   (M1 bar as criterion)
//   DOWNGRADE otherwise.
// Battery mapping: "admit" = CONFIRMED. Pure Zag, zero RNG.
// Usage: w8 <m1_cases.txt>.
@import("../r4lib.zag")

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let maxrows:i32 = 4096;
    let akind:[]u8 = nio_alloc(maxrows << 3);
    let apair:[]u8 = nio_alloc(maxrows << 3);
    let aconf:[]u8 = nio_alloc(maxrows << 3);
    let amrg:[]u8 = nio_alloc(maxrows << 3);
    let astrong:[]u8 = nio_alloc(maxrows << 3);
    let aagree:[]u8 = nio_alloc(maxrows << 3);
    let nrows:i64 = load_base(a1, maxrows, akind, apair, aconf, amrg, astrong, aagree);
    if(nrows < 0) { return 1; }
    let tk:[]u8 = nio_alloc(14 << 3);
    let tc:[]u8 = nio_alloc(14 << 3);
    let tm:[]u8 = nio_alloc(14 << 3);
    let ts:[]u8 = nio_alloc(14 << 3);
    let ta:[]u8 = nio_alloc(14 << 3);
    let tx1:[]u8 = nio_alloc(14 << 3);
    let tx2:[]u8 = nio_alloc(14 << 3);
    let tx3:[]u8 = nio_alloc(14 << 3);
    let na:i64 = load_attacks(tk, tc, tm, ts, ta, tx1, tx2, tx3);
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    // fence probe counter: any provisional-consume path increments this.
    // There are no such paths in this binary; asserted 0 (R1).
    let fence_cross:i64 = 0;
    let c_confirmed:i64 = 0;
    let c_revoked:i64 = 0;
    let w_confirmed:i64 = 0;
    let w_revoked:i64 = 0;
    let p_confirmed:i64 = 0;
    let p_revoked:i64 = 0;
    let b_confirmed:i64 = 0;
    let a_revoked:i64 = 0;
    let a_confirmed:i64 = 0;
    let prov_total:i64 = 0;
    let backlog:i64 = 0;
    let npairs:i64 = 0;
    let pstage:[]u8 = nio_alloc(maxrows << 3);
    let s2:i32 = 0;
    while(s2 < maxrows) { t_put64(pstage, s2 << 3, 0); s2 = s2 + 1; }
    let total:i64 = nrows + na;
    let r:i64 = 0;
    while(r < total) {
        let kind:i64 = 0;
        let conf:i64 = 0;
        let mrg:i64 = 0;
        let strong:i64 = 0;
        let agree:i64 = 0;
        let is_base:i64 = 0;
        if(r < nrows) {
            is_base = 1;
            let rr:i32 = r as i32;
            kind = t_get64(akind, rr << 3);
            conf = t_get64(aconf, rr << 3);
            mrg = t_get64(amrg, rr << 3);
            strong = t_get64(astrong, rr << 3);
            agree = t_get64(aagree, rr << 3);
        } else {
            let rr:i32 = (r - nrows) as i32;
            kind = t_get64(tk, rr << 3);
            conf = t_get64(tc, rr << 3);
            mrg = t_get64(tm, rr << 3);
            strong = t_get64(ts, rr << 3);
            agree = t_get64(ta, rr << 3);
        }
        let asg:i64 = attack_sig(kind, 0, 0, 0);
        if(is_base == 0) {
            let rr:i32 = (r - nrows) as i32;
            asg = attack_sig(kind, t_get64(tx1, rr << 3), t_get64(tx2, rr << 3), t_get64(tx3, rr << 3));
        }
        // fast path
        let prov:i64 = 0;
        if(conf >= 700 && mrg >= 300) { prov = 1; }
        // stage: 0=REJECT 1=CONFIRMED 2=DOWNGRADED 3=REVOKED
        let stage:i64 = 0;
        if(prov == 1) {
            prov_total = prov_total + 1;
            // ---- fence: provisional records never reach memory write /
            // self-change input / outward action. This binary has no such
            // code paths; fence_cross stays 0 by construction. ----
            let tmb:i64 = 0;
            if(conf >= 760 && conf <= 835 && mrg >= 1880 && mrg <= 2380 && strong == 1 && agree == 1) { tmb = 1; }
            let revoke:i64 = 0;
            if(kind == 2 || asg == 1 || tmb == 1) { revoke = 1; }
            if(revoke == 1) {
                stage = 3;
            } else {
                if(conf >= 705 && mrg >= 3588) {
                    stage = 1;
                } else {
                    stage = 2;
                }
            }
        }
        if(is_base == 1) {
            let rr:i32 = r as i32;
            t_put64(pstage, rr << 3, stage);
            if(kind == 0 && stage == 1) { c_confirmed = c_confirmed + 1; }
            if(kind == 0 && stage == 3) { c_revoked = c_revoked + 1; }
            if(kind == 1 && stage == 1) { w_confirmed = w_confirmed + 1; }
            if(kind == 1 && stage == 3) { w_revoked = w_revoked + 1; }
            if(kind == 2 && stage == 1) { p_confirmed = p_confirmed + 1; }
            if(kind == 2 && stage == 3) { p_revoked = p_revoked + 1; }
            if(kind == 3 && stage == 1) { b_confirmed = b_confirmed + 1; }
        } else {
            if(stage == 1) { a_confirmed = a_confirmed + 1; }
            if(stage == 3) { a_revoked = a_revoked + 1; }
        }
        pos = ob_add(ob, pos, "R|");
        pos = ob_add(ob, pos, i64s(r));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(kind));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(stage));
        pos = ob_add(ob, pos, "|");
        pos = ob_add(ob, pos, i64s(prov));
        pos = ob_add(ob, pos, "\n");
        r = r + 1;
    }
    // auditor drains the provisional queue fully each pass (R4)
    backlog = 0;
    let q:i32 = 0;
    while(q < 9) {
        let both:i64 = 1;
        let any:i64 = 0;
        let r2:i32 = 0;
        while(r2 < nrows as i32) {
            if(t_get64(akind, r2 << 3) == 2 && t_get64(apair, r2 << 3) == q as i64) {
                any = 1;
                if(t_get64(pstage, r2 << 3) != 1) { both = 0; }
            }
            r2 = r2 + 1;
        }
        if(any == 1 && both == 1) { npairs = npairs + 1; }
        q = q + 1;
    }
    pos = ob_kv(ob, pos, "DESIGN", "W8_RETRO");
    pos = ob_kv(ob, pos, "rows_base", i64s(nrows));
    pos = ob_kv(ob, pos, "rows_attack", i64s(na));
    pos = ob_kv(ob, pos, "fence_cross", i64s(fence_cross));
    pos = ob_kv(ob, pos, "prov_total", i64s(prov_total));
    pos = ob_kv(ob, pos, "backlog", i64s(backlog));
    pos = ob_kv(ob, pos, "c_confirmed", i64s(c_confirmed));
    pos = ob_kv(ob, pos, "c_revoked", i64s(c_revoked));
    pos = ob_kv(ob, pos, "w_confirmed", i64s(w_confirmed));
    pos = ob_kv(ob, pos, "w_revoked", i64s(w_revoked));
    pos = ob_kv(ob, pos, "p_confirmed", i64s(p_confirmed));
    pos = ob_kv(ob, pos, "p_revoked", i64s(p_revoked));
    pos = ob_kv(ob, pos, "p_pair_installs", i64s(npairs));
    pos = ob_kv(ob, pos, "b_confirmed", i64s(b_confirmed));
    pos = ob_kv(ob, pos, "a_confirmed", i64s(a_confirmed));
    pos = ob_kv(ob, pos, "a_revoked", i64s(a_revoked));
    _zag_print(ob[0..pos]);
    nio_free(ob);
    return 0;
}

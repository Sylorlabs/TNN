// m1_grid.zag — M1 bar-calibration exact grid search (frozen PREREG_M1_BAR.md)
// Pure Zag, zero RNG. Usage: m1_grid <m1_cases.txt>
// Implements prereg section 6 verbatim: per (ST,AT), sweep MT over sorted
// unique candidates, CT*(MT) = smallest feasible CT, exact global optimum.
@import("R33_NATIVE_IO_V1.zag")

// ---------------- LE accessors over []u8 arenas (never `as []i32`) ----------------
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let neg:i64 = 1;
    let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * neg;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// passes(kind args): trial passes the bar?
fn passes(conf:i64, mrg:i64, strong:i64, agree:i64, ct:i64, mt:i64, st:i64, at:i64) i64 {
    if(conf < ct) { return 0; }
    if(mrg < mt) { return 0; }
    if(strong < st) { return 0; }
    if(agree < at) { return 0; }
    return 1;
}
// pair minima: pp_minconf/pp_minmrg/pp_n indexed by pair id (caller-sized)
fn pair_mins(nrows:i32, akind:[]u8, apair:[]u8, aconf:[]u8, amrg:[]u8,
             pp_minconf:[]u8, pp_minmrg:[]u8, pp_n:[]u8, maxpid:i32) void {
    let p:i32 = 0;
    while(p <= maxpid) {
        t_put64(pp_minconf, p << 3, 1000000000);
        t_put64(pp_minmrg, p << 3, 1000000000);
        t_put64(pp_n, p << 3, 0);
        p = p + 1;
    }
    let r:i32 = 0;
    while(r < nrows) {
        if(t_get64(akind, r << 3) == 2) {
            let pid:i32 = t_get64(apair, r << 3) as i32;
            let c:i64 = t_get64(aconf, r << 3);
            let m:i64 = t_get64(amrg, r << 3);
            if(c < t_get64(pp_minconf, pid << 3)) { t_put64(pp_minconf, pid << 3, c); }
            if(m < t_get64(pp_minmrg, pid << 3)) { t_put64(pp_minmrg, pid << 3, m); }
            t_put64(pp_n, pid << 3, t_get64(pp_n, pid << 3) + 1);
        }
        r = r + 1;
    }
    return;
}
// candidate MT collection (prereg s6 step 2); returns count
fn collect_candidates(nrows:i32, akind:[]u8, aconf:[]u8, amrg:[]u8,
                      astrong:[]u8, aagree:[]u8, st:i64, at:i64,
                      npairs:i32, pp_minmrg:[]u8, mc:[]u8) i32 {
    t_put64(mc, 0, 0);
    let n:i32 = 1;
    let r:i32 = 0;
    while(r < nrows) {
        let k:i64 = t_get64(akind, r << 3);
        if(k == 1) {
            t_put64(mc, n << 3, t_get64(amrg, r << 3) + 1);
            n = n + 1;
        }
        if(k == 0) {
            if(t_get64(astrong, r << 3) >= st && t_get64(aagree, r << 3) >= at) {
                t_put64(mc, n << 3, t_get64(amrg, r << 3));
                n = n + 1;
            }
        }
        r = r + 1;
    }
    let p:i32 = 0;
    while(p < npairs) {
        t_put64(mc, n << 3, t_get64(pp_minmrg, p << 3) + 1);
        n = n + 1;
        p = p + 1;
    }
    return n;
}
// insertion sort ascending + dedupe; returns new count
fn sort_dedupe(mc:[]u8, n:i32) i32 {
    let i:i32 = 1;
    while(i < n) {
        let v:i64 = t_get64(mc, i << 3);
        let j:i32 = i - 1;
        while(j >= 0 && t_get64(mc, j << 3) > v) {
            t_put64(mc, (j + 1) << 3, t_get64(mc, j << 3));
            j = j - 1;
        }
        t_put64(mc, (j + 1) << 3, v);
        i = i + 1;
    }
    let w:i32 = 1;
    let k:i32 = 1;
    while(k < n) {
        if(t_get64(mc, k << 3) != t_get64(mc, (w - 1) << 3)) {
            t_put64(mc, w << 3, t_get64(mc, k << 3));
            w = w + 1;
        }
        k = k + 1;
    }
    return w;
}
// CT*(MT): smallest feasible CT (prereg s6 step 3)
fn ct_star(mt:i64, nrows:i32, akind:[]u8, aconf:[]u8, amrg:[]u8,
           npairs:i32, pp_minconf:[]u8, pp_minmrg:[]u8) i64 {
    let ct:i64 = 0;
    let r:i32 = 0;
    while(r < nrows) {
        if(t_get64(akind, r << 3) == 1) {
            if(t_get64(amrg, r << 3) >= mt) {
                let need:i64 = t_get64(aconf, r << 3) + 1;
                if(need > ct) { ct = need; }
            }
        }
        r = r + 1;
    }
    let p:i32 = 0;
    while(p < npairs) {
        if(t_get64(pp_minmrg, p << 3) >= mt) {
            let need:i64 = t_get64(pp_minconf, p << 3) + 1;
            if(need > ct) { ct = need; }
        }
        p = p + 1;
    }
    return ct;
}
// tp(MT): armed correct trials passing (prereg s6 step 4)
fn count_tp(ct:i64, mt:i64, st:i64, at:i64, nrows:i32, akind:[]u8,
            aconf:[]u8, amrg:[]u8, astrong:[]u8, aagree:[]u8) i64 {
    let tp:i64 = 0;
    let r:i32 = 0;
    while(r < nrows) {
        if(t_get64(akind, r << 3) == 0) {
            if(passes(t_get64(aconf, r << 3), t_get64(amrg, r << 3),
                      t_get64(astrong, r << 3), t_get64(aagree, r << 3),
                      ct, mt, st, at) == 1) { tp = tp + 1; }
        }
        r = r + 1;
    }
    return tp;
}
// tie-break (prereg s6): 1 = candidate beats incumbent
fn better(tp:i64, mt:i64, ct:i64, st:i64, at:i64,
          btp:i64, bmt:i64, bct:i64, bst:i64, bat:i64) i64 {
    if(tp != btp) {
        if(tp > btp) { return 1; }
        return 0;
    }
    if(mt != bmt) {
        if(mt > bmt) { return 1; }
        return 0;
    }
    if(ct != bct) {
        if(ct < bct) { return 1; }
        return 0;
    }
    if(st + at > bst + bat) { return 1; }
    return 0;
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return 1; }
    let fmax:i32 = 8388608;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    let maxrows:i32 = 4096;
    let akind:[]u8 = nio_alloc(maxrows << 3);
    let apair:[]u8 = nio_alloc(maxrows << 3);
    let aconf:[]u8 = nio_alloc(maxrows << 3);
    let amrg:[]u8 = nio_alloc(maxrows << 3);
    let astrong:[]u8 = nio_alloc(maxrows << 3);
    let aagree:[]u8 = nio_alloc(maxrows << 3);
    let fnum:[]u8 = nio_alloc(64);
    let nrows:i32 = 0;
    let nc:i64 = 0;
    let nw:i64 = 0;
    let np:i64 = 0;
    let nb:i64 = 0;
    let maxpid:i32 = -1;
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 4000 && nrows < maxrows) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let kc:u8 = line[0];
            let kind:i64 = -1;
            if(kc == 67) { kind = 0; nc = nc + 1; }
            if(kc == 87) { kind = 1; nw = nw + 1; }
            if(kc == 80) { kind = 2; np = np + 1; }
            if(kc == 66) { kind = 3; nb = nb + 1; }
            if(kind >= 0) {
                let r:i32 = nrows;
                t_put64(akind, r << 3, kind);
                // P rows: P|pairid|conf|mrg|strong|agree (fields 0..5)
                // C/W/B rows: K|conf|mrg|strong|agree (fields 0..4)
                let fi_conf:i32 = 1;
                let fi_mrg:i32 = 2;
                let fi_strong:i32 = 3;
                let fi_agree:i32 = 4;
                if(kind == 2) {
                    let nf0:i32 = field(line, llen, 1, fnum);
                    let pid:i64 = atoi(fnum, nf0);
                    t_put64(apair, r << 3, pid);
                    if(pid as i32 > maxpid) { maxpid = pid as i32; }
                    fi_conf = 2;
                    fi_mrg = 3;
                    fi_strong = 4;
                    fi_agree = 5;
                } else {
                    t_put64(apair, r << 3, -1);
                }
                let nf:i32 = field(line, llen, fi_conf, fnum);
                t_put64(aconf, r << 3, atoi(fnum, nf));
                nf = field(line, llen, fi_mrg, fnum);
                t_put64(amrg, r << 3, atoi(fnum, nf));
                nf = field(line, llen, fi_strong, fnum);
                t_put64(astrong, r << 3, atoi(fnum, nf));
                nf = field(line, llen, fi_agree, fnum);
                t_put64(aagree, r << 3, atoi(fnum, nf));
                nrows = nrows + 1;
            }
        }
        p = le + 1;
    }
    let pp_minconf:[]u8 = nio_alloc(64 << 3);
    let pp_minmrg:[]u8 = nio_alloc(64 << 3);
    let pp_n:[]u8 = nio_alloc(64 << 3);
    let npairs:i32 = maxpid + 1;
    pair_mins(nrows, akind, apair, aconf, amrg, pp_minconf, pp_minmrg, pp_n, maxpid);
    // baseline (CT=700, MT=0, ST=1, AT=1)
    let btp:i64 = count_tp(700, 0, 1, 1, nrows, akind, aconf, amrg, astrong, aagree);
    let bc1:i64 = 0;
    let r2:i32 = 0;
    while(r2 < nrows) {
        if(t_get64(akind, r2 << 3) == 1) {
            if(passes(t_get64(aconf, r2 << 3), t_get64(amrg, r2 << 3), 1, 1, 700, 0, 1, 1) == 1) { bc1 = bc1 + 1; }
        }
        r2 = r2 + 1;
    }
    let bc2:i64 = 0;
    let q:i32 = 0;
    while(q < npairs) {
        let both:i64 = 1;
        let r3:i32 = 0;
        while(r3 < nrows) {
            if(t_get64(akind, r3 << 3) == 2 && t_get64(apair, r3 << 3) == q as i64) {
                if(passes(t_get64(aconf, r3 << 3), t_get64(amrg, r3 << 3), 1, 1, 700, 0, 1, 1) == 0) { both = 0; }
            }
            r3 = r3 + 1;
        }
        if(both == 1 && t_get64(pp_n, q << 3) > 0) { bc2 = bc2 + 1; }
        q = q + 1;
    }
    let bfp:i64 = 0;
    let r4:i32 = 0;
    while(r4 < nrows) {
        if(t_get64(akind, r4 << 3) == 3) {
            if(passes(t_get64(aconf, r4 << 3), t_get64(amrg, r4 << 3),
                      t_get64(astrong, r4 << 3), t_get64(aagree, r4 << 3),
                      700, 0, 1, 1) == 1) { bfp = bfp + 1; }
        }
        r4 = r4 + 1;
    }
    nio_free(fb);
    nio_free(fnum);
    // grid search (prereg s6)
    let mc:[]u8 = nio_alloc(4096 << 3);
    let gtp:i64 = -1;
    let gmt:i64 = 0;
    let gct:i64 = 0;
    let gst:i64 = 0;
    let gat:i64 = 0;
    let st:i64 = 0;
    while(st <= 1) {
        let at:i64 = 0;
        while(at <= 1) {
            let nmc:i32 = collect_candidates(nrows, akind, aconf, amrg, astrong, aagree,
                                            st, at, npairs, pp_minmrg, mc);
            nmc = sort_dedupe(mc, nmc);
            let mi:i32 = 0;
            while(mi < nmc) {
                let mt:i64 = t_get64(mc, mi << 3);
                let ct:i64 = ct_star(mt, nrows, akind, aconf, amrg, npairs, pp_minconf, pp_minmrg);
                let tp:i64 = count_tp(ct, mt, st, at, nrows, akind, aconf, amrg, astrong, aagree);
                if(better(tp, mt, ct, st, at, gtp, gmt, gct, gst, gat) == 1) {
                    gtp = tp; gmt = mt; gct = ct; gst = st; gat = at;
                }
                mi = mi + 1;
            }
            at = at + 1;
        }
        st = st + 1;
    }
    // verify optimum: C1, C2 violations (expect 0)
    let vc1:i64 = 0;
    let r5:i32 = 0;
    while(r5 < nrows) {
        if(t_get64(akind, r5 << 3) == 1) {
            if(passes(t_get64(aconf, r5 << 3), t_get64(amrg, r5 << 3), 1, 1, gct, gmt, gst, gat) == 1) { vc1 = vc1 + 1; }
        }
        r5 = r5 + 1;
    }
    let vc2:i64 = 0;
    let q2:i32 = 0;
    while(q2 < npairs) {
        let both2:i64 = 1;
        let r6:i32 = 0;
        while(r6 < nrows) {
            if(t_get64(akind, r6 << 3) == 2 && t_get64(apair, r6 << 3) == q2 as i64) {
                if(passes(t_get64(aconf, r6 << 3), t_get64(amrg, r6 << 3), 1, 1, gct, gmt, gst, gat) == 0) { both2 = 0; }
            }
            r6 = r6 + 1;
        }
        if(both2 == 1 && t_get64(pp_n, q2 << 3) > 0) { vc2 = vc2 + 1; }
        q2 = q2 + 1;
    }
    // diagnostics: broad-wrong false-pass, trial-1145 disposition
    let ofp:i64 = 0;
    let r7:i32 = 0;
    while(r7 < nrows) {
        if(t_get64(akind, r7 << 3) == 3) {
            if(passes(t_get64(aconf, r7 << 3), t_get64(amrg, r7 << 3),
                      t_get64(astrong, r7 << 3), t_get64(aagree, r7 << 3),
                      gct, gmt, gst, gat) == 1) { ofp = ofp + 1; }
        }
        r7 = r7 + 1;
    }
    let t1145:i64 = passes(874, 10410, 1, 1, gct, gmt, gst, gat);
    let kill:i64 = 0;
    if(gtp * 100 < 82 * 1102) { kill = 1; }
    // report
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "M1_BAR_GRID", "frozen=PREREG_M1_BAR.md");
    pos = ob_kv(ob, pos, "rows_total", i64s(nrows as i64));
    pos = ob_kv(ob, pos, "rows_C", i64s(nc));
    pos = ob_kv(ob, pos, "rows_W", i64s(nw));
    pos = ob_kv(ob, pos, "rows_P", i64s(np));
    pos = ob_kv(ob, pos, "rows_B", i64s(nb));
    pos = ob_kv(ob, pos, "npairs", i64s(npairs as i64));
    pos = ob_add(ob, pos, "baseline CT=700 MT=0 ST=1 AT=1\n");
    pos = ob_kv(ob, pos, "base_true_pass", i64s(btp));
    pos = ob_kv(ob, pos, "base_rk3bp", i64s(btp * 10000 / 1102));
    pos = ob_kv(ob, pos, "base_c1_viol", i64s(bc1));
    pos = ob_kv(ob, pos, "base_c2_viol", i64s(bc2));
    pos = ob_kv(ob, pos, "base_b_fp", i64s(bfp));
    pos = ob_kv(ob, pos, "opt_ST", i64s(gst));
    pos = ob_kv(ob, pos, "opt_AT", i64s(gat));
    pos = ob_kv(ob, pos, "opt_CT", i64s(gct));
    pos = ob_kv(ob, pos, "opt_MT", i64s(gmt));
    pos = ob_kv(ob, pos, "opt_true_pass", i64s(gtp));
    pos = ob_kv(ob, pos, "opt_rk3bp", i64s(gtp * 10000 / 1102));
    pos = ob_kv(ob, pos, "verify_c1_viol", i64s(vc1));
    pos = ob_kv(ob, pos, "verify_c2_viol", i64s(vc2));
    pos = ob_kv(ob, pos, "diag_b_fp", i64s(ofp));
    pos = ob_kv(ob, pos, "diag_trial1145", i64s(t1145));
    if(kill == 1) { pos = ob_kv(ob, pos, "KB_M1_82pct", "KILL"); }
    else { pos = ob_kv(ob, pos, "KB_M1_82pct", "SURVIVE"); }
    _zag_print(ob[0..pos]);
    nio_free(ob);
    nio_free(akind);
    nio_free(apair);
    nio_free(aconf);
    nio_free(amrg);
    nio_free(astrong);
    nio_free(aagree);
    nio_free(pp_minconf);
    nio_free(pp_minmrg);
    nio_free(pp_n);
    nio_free(mc);
    return 0;
}

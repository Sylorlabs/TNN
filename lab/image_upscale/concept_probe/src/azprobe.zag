// azprobe.zag -- UPSCALE CONCEPT PROBE (C1-C4), behavioral, through TNN's intake.
//
// Micah order 2026-09-26: "TNN just drew some weird pixely lines, didn't
// actually upscale -- make sure it knows what upscaling is first."
//
// The upscale concept, four testable components:
//   C1: 2x upscale = 4x pixels (2x per dim).
//   C2: same scene content, aligned with input (even positions = observed).
//   C3: new detail comes ONLY from committed understanding (upscale atoms)
//       -- never invented, never generic interpolation presented as knowledge.
//   C4: upscaling != drawing (no re-rasterization / doubled-endpoint drawing).
//
// Protocol (frozen before running; see DESIGN.md):
//   TEACH: synthetic paired fixtures (low 96x96 / high 192x192, six texture
//     classes with unambiguous true 2x mappings). TNN's intake: survey ->
//     per-pixel context signatures (TNN's own 3x3 measurements) -> measure
//     per-signature 2x2 coarse->fine deltas from the PAIR -> commit each atom
//     by the measured bar G >= 9*N vs the best generic (replication/bilinear).
//     Nothing about the true mapping is told to TNN; atoms are MEASURED.
//   TEST (before): no atoms (vocabulary empty) -> construction falls back to
//     the default generic (bilinear). Expected: C3 fails -> NOT HELD.
//   TEST (after): with committed atoms -> TNN constructs from them where
//     committed, teach-selected generic elsewhere. Scored against the HELD
//     high-res test fixture (never seen during construction).
//
// Epistemic split (the H1d lesson): [CREW] lines are crew-authored protocol
// framing; [MEASURED] lines are TNN's computed numbers; [DECISION] lines are
// TNN's bar-gated commits. The verdict follows pre-registered bars.
//
// Pure Zag, zero RNG, deterministic integer arithmetic. Pinned toolchain:
// ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1
@import("./common_az.zag")

// ---------------- trace helpers ----------------
fn tab_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn tab_puti(b:[]u8, o:i64, v:i64) i64 {
    let s:[]u8 = _zag_i64_to_str(v);
    let o2:i64 = tab_puts(b, o, s);
    nio_free(s);
    return o2;
}

// ---------------- geometry ----------------
fn LW() i64 { return 96; }
fn LH() i64 { return 96; }
fn HW() i64 { return 192; }
fn HH() i64 { return 192; }
fn NSIG() i64 { return 26244; }

// ---------------- TEACH fixtures (the "world"; TNN never sees the formulas) ----------------
// Six 32x32 regions: (rx = x/32, ry = y/32)
//   (0,0) FLAT      (1,0) GRAD-H     (2,0) CHECKER(4x4)
//   (0,1) GRAD-V    (1,1) EDGE-D1    (2,1) EDGE-D2
fn teach_px(x:i64, y:i64) i64 {
    let rx:i64 = x / 32; let ry:i64 = y / 32;
    let lx:i64 = x % 32; let ly:i64 = y % 32;
    let v:i64 = 0;
    if (rx == 0 && ry == 0) { v = 110; }
    if (rx == 1 && ry == 0) { v = 40 + (lx * 180) / 31; }
    if (rx == 2 && ry == 0) {
        if (((lx / 4 + ly / 4) % 2) == 0) { v = 60; } else { v = 200; }
    }
    if (rx == 0 && ry == 1) { v = 40 + (ly * 180) / 31; }
    if (rx == 1 && ry == 1) {
        if (lx + ly < 32) { v = 60; } else { v = 200; }
    }
    if (rx == 2 && ry == 1) {
        if (lx < ly) { v = 60; } else { v = 200; }
    }
    return v;
}
// True 2x sampling of the same underlying patterns (NOT pixel replication:
// the diagonal edges are doubled in position, so replication staircases).
fn teach_hx(X:i64, Y:i64) i64 {
    let rx:i64 = X / 64; let ry:i64 = Y / 64;
    let lx:i64 = X % 64; let ly:i64 = Y % 64;
    let v:i64 = 0;
    if (rx == 0 && ry == 0) { v = 110; }
    if (rx == 1 && ry == 0) { v = 40 + (lx * 180) / 63; }
    if (rx == 2 && ry == 0) {
        if (((lx / 8 + ly / 8) % 2) == 0) { v = 60; } else { v = 200; }
    }
    if (rx == 0 && ry == 1) { v = 40 + (ly * 180) / 63; }
    if (rx == 1 && ry == 1) {
        if (lx + ly < 64) { v = 60; } else { v = 200; }
    }
    if (rx == 2 && ry == 1) {
        if (lx < ly) { v = 60; } else { v = 200; }
    }
    return v;
}

// ---------------- TEST fixtures (held out: permuted layout, shifted edges,
// phase-flipped checker, new ranges/offsets -- same classes, new parameters) ----------------
//   (0,0) EDGE-D1 shifted   (1,0) CHECKER phase-flip   (2,0) GRAD-H new range
//   (0,1) EDGE-D2 shifted   (1,1) FLAT 170             (2,1) GRAD-V new range
fn test_px(x:i64, y:i64) i64 {
    let rx:i64 = x / 32; let ry:i64 = y / 32;
    let lx:i64 = x % 32; let ly:i64 = y % 32;
    let v:i64 = 0;
    if (rx == 0 && ry == 0) {
        if (lx + ly < 40) { v = 60; } else { v = 200; }
    }
    if (rx == 1 && ry == 0) {
        if (((lx / 4 + ly / 4) % 2) == 0) { v = 200; } else { v = 60; }
    }
    if (rx == 2 && ry == 0) { v = 60 + (lx * 140) / 31; }
    if (rx == 0 && ry == 1) {
        if (lx - ly < 8) { v = 60; } else { v = 200; }
    }
    if (rx == 1 && ry == 1) { v = 170; }
    if (rx == 2 && ry == 1) { v = 60 + (ly * 140) / 31; }
    return v;
}
fn test_hx(X:i64, Y:i64) i64 {
    let rx:i64 = X / 64; let ry:i64 = Y / 64;
    let lx:i64 = X % 64; let ly:i64 = Y % 64;
    let v:i64 = 0;
    if (rx == 0 && ry == 0) {
        if (lx + ly < 80) { v = 60; } else { v = 200; }
    }
    if (rx == 1 && ry == 0) {
        if (((lx / 8 + ly / 8) % 2) == 0) { v = 200; } else { v = 60; }
    }
    if (rx == 2 && ry == 0) { v = 60 + (lx * 140) / 63; }
    if (rx == 0 && ry == 1) {
        if (lx - ly < 16) { v = 60; } else { v = 200; }
    }
    if (rx == 1 && ry == 1) { v = 170; }
    if (rx == 2 && ry == 1) { v = 60 + (ly * 140) / 63; }
    return v;
}
// test region class id (scoring breakdown only -- never used by construction)
fn test_region_class(x:i64, y:i64) i64 {
    let rx:i64 = x / 32; let ry:i64 = y / 32;
    if (rx == 0 && ry == 0) { return 0; } // EDGE-D1
    if (rx == 1 && ry == 0) { return 1; } // CHECKER
    if (rx == 2 && ry == 0) { return 2; } // GRAD-H
    if (rx == 0 && ry == 1) { return 3; } // EDGE-D2
    if (rx == 1 && ry == 1) { return 4; } // FLAT
    return 5; // GRAD-V
}

fn sig_of(g:[]u8, w:i64, h:i64, x:i64, y:i64) i64 {
    let n0:i64 = 0; let n1:i64 = 0; let n2:i64 = 0;
    let n3:i64 = 0; let n4:i64 = 0; let n5:i64 = 0;
    let n6:i64 = 0; let n7:i64 = 0; let n8:i64 = 0;
    let jy:i64 = -1;
    while (jy <= 1) {
        let yy:i64 = y + jy;
        if (yy < 0) { yy = 0; }
        if (yy >= h) { yy = h - 1; }
        let jx:i64 = -1;
        while (jx <= 1) {
            let xx:i64 = x + jx;
            if (xx < 0) { xx = 0; }
            if (xx >= w) { xx = w - 1; }
            let nv:i64 = g[yy * w + xx] as i64;
            if (jx == -1 && jy == -1) { n0 = nv; }
            if (jx == 0 && jy == -1) { n1 = nv; }
            if (jx == 1 && jy == -1) { n2 = nv; }
            if (jx == -1 && jy == 0) { n3 = nv; }
            if (jx == 0 && jy == 0) { n4 = nv; }
            if (jx == 1 && jy == 0) { n5 = nv; }
            if (jx == -1 && jy == 1) { n6 = nv; }
            if (jx == 0 && jy == 1) { n7 = nv; }
            if (jx == 1 && jy == 1) { n8 = nv; }
            jx = jx + 1;
        }
        jy = jy + 1;
    }
    let gx:i64 = (n2 + n5 + n8) - (n0 + n3 + n6);
    let gy:i64 = (n6 + n7 + n8) - (n0 + n1 + n2);
    let mag:i64 = gx; if (mag < 0) { mag = 0 - mag; }
    let t:i64 = gy; if (t < 0) { t = 0 - t; }
    mag = mag + t;
    let c:i64 = n4;
    let orth:i64 = n1 - c; if (orth < 0) { orth = 0 - orth; }
    t = n3 - c; if (t < 0) { t = 0 - t; } orth = orth + t;
    t = n5 - c; if (t < 0) { t = 0 - t; } orth = orth + t;
    t = n7 - c; if (t < 0) { t = 0 - t; } orth = orth + t;
    let diag:i64 = n0 - c; if (diag < 0) { diag = 0 - diag; }
    t = n2 - c; if (t < 0) { t = 0 - t; } diag = diag + t;
    t = n6 - c; if (t < 0) { t = 0 - t; } diag = diag + t;
    t = n8 - c; if (t < 0) { t = 0 - t; } diag = diag + t;
    // NOTE: there is intentionally no CHECKER-first branch. An earlier
    // revision classified diagonal edges as "checker" (orth>=240,diag<=160
    // fires on diagonals) and discarded their orientation in that branch,
    // mushing D1/D2 atoms together. The 4x4 checker presents honestly as
    // FLAT interiors + axis-aligned EDGEs (separated from diagonal edges
    // by the dd bit). Class 3 is reserved/unused.
    let class:i64 = 1;
    if (mag < 24) { class = 0; }
    else {
        if (mag >= 120) { class = 2; } else { class = 1; }
    }
    let obin:i64 = 0;
    let dd:i64 = 0;
    if (class == 1 || class == 2) {
        let agx:i64 = gx; if (agx < 0) { agx = 0 - agx; }
        let agy:i64 = gy; if (agy < 0) { agy = 0 - agy; }
        // dd: diagonal-vs-axis bit. Axis-dominated gradients (|gx|>>|gy| or
        // vice versa: straight check/region boundaries) must NOT share a
        // signature with diagonal gradients (|gx|~|gy|: the D1/D2 edges),
        // whose true sub-pixel patterns differ.
        if (agx > 2 * agy) { dd = 0; }
        else {
            if (agy > 2 * agx) { dd = 0; } else { dd = 1; }
        }
    }
    // pat: ternary 3x3 contrast pattern. Each of the 8 neighbors (skip
    // center) is quantized to -1/0/+1 by the sign of (n_i - c) when
    // |n_i - c| > 30, else 0. The 3x3 SHAPE is the signature: a straddling
    // edge, an adjacent edge, and a region boundary all have different
    // shapes, so they cannot share an atom. (Coarser hand-binned features
    // -- orientation bins, axis/diagonal dominance -- kept colliding
    // distinct shapes and mushing their atoms.)
    // Threshold 30 is a crew-chosen measurement quantization; the ATOM
    // VALUES measured under each pattern are TNN's, never crew-supplied.
    let pat:i64 = 0;
    let mult:i64 = 1;
    let dv:i64 = n0 - c;
    if (dv > 30) { pat = pat + 2 * mult; } else { if (dv < -30) { pat = pat + 0 * mult; } else { pat = pat + 1 * mult; } }
    mult = mult * 3;
    dv = n1 - c;
    if (dv > 30) { pat = pat + 2 * mult; } else { if (dv < -30) { pat = pat + 0 * mult; } else { pat = pat + 1 * mult; } }
    mult = mult * 3;
    dv = n2 - c;
    if (dv > 30) { pat = pat + 2 * mult; } else { if (dv < -30) { pat = pat + 0 * mult; } else { pat = pat + 1 * mult; } }
    mult = mult * 3;
    dv = n3 - c;
    if (dv > 30) { pat = pat + 2 * mult; } else { if (dv < -30) { pat = pat + 0 * mult; } else { pat = pat + 1 * mult; } }
    mult = mult * 3;
    dv = n5 - c;
    if (dv > 30) { pat = pat + 2 * mult; } else { if (dv < -30) { pat = pat + 0 * mult; } else { pat = pat + 1 * mult; } }
    mult = mult * 3;
    dv = n6 - c;
    if (dv > 30) { pat = pat + 2 * mult; } else { if (dv < -30) { pat = pat + 0 * mult; } else { pat = pat + 1 * mult; } }
    mult = mult * 3;
    dv = n7 - c;
    if (dv > 30) { pat = pat + 2 * mult; } else { if (dv < -30) { pat = pat + 0 * mult; } else { pat = pat + 1 * mult; } }
    mult = mult * 3;
    dv = n8 - c;
    if (dv > 30) { pat = pat + 2 * mult; } else { if (dv < -30) { pat = pat + 0 * mult; } else { pat = pat + 1 * mult; } }
    let sum9:i64 = n0 + n1 + n2 + n3 + n4 + n5 + n6 + n7 + n8;
    let pb:i64 = 0;
    if (c * 9 >= sum9) { pb = 1; }
    return class * 6561 + pat;
}

// Generic bilinear sub-pixel prediction from the low-res 3x3 neighborhood.
// This is the COMPETING generic layer: crew-written math, explicitly labeled
// CONSTRUCTED-GENERIC, never presented as TNN's understanding.
fn bilin(g:[]u8, w:i64, h:i64, x:i64, y:i64, dx:i64, dy:i64) i64 {
    let xe:i64 = x + 1; if (xe >= w) { xe = x; }
    let ys:i64 = y + 1; if (ys >= h) { ys = y; }
    let v:i64 = g[y * w + x] as i64;
    let e:i64 = g[y * w + xe] as i64;
    let s:i64 = g[ys * w + x] as i64;
    let se:i64 = g[ys * w + xe] as i64;
    if (dx == 0 && dy == 0) { return v; }
    if (dx == 1 && dy == 0) {
        let t2:i64 = v + e;
        if (t2 >= 0) { return (t2 + 1) / 2; }
        return (t2 - 1) / 2;
    }
    if (dx == 0 && dy == 1) {
        let t3:i64 = v + s;
        if (t3 >= 0) { return (t3 + 1) / 2; }
        return (t3 - 1) / 2;
    }
    let t4:i64 = v + e + s + se;
    if (t4 >= 0) { return (t4 + 2) / 4; }
    return (t4 - 2) / 4;
}

fn abs64(v:i64) i64 {
    if (v < 0) { return 0 - v; }
    return v;
}

// round-half-away-from-zero integer division (n > 0)
fn rha_div(a:i64, n:i64) i64 {
    if (a >= 0) { return (a + n / 2) / n; }
    return (a - n / 2) / n;
}

// gray -> RGB replicate for BMP writing
fn gray_to_rgb(g:[]u8, npix:i64, rgb:[]u8) void {
    let i:i64 = 0;
    while (i < npix) {
        rgb[i * 3] = g[i];
        rgb[i * 3 + 1] = g[i];
        rgb[i * 3 + 2] = g[i];
        i = i + 1;
    }
}

// ---------------- TEACH: TNN's intake on the paired fixtures ----------------
// Returns number of committed atoms. Writes atoms.bin, TEACH_TRACE.txt,
// teach_low.bmp, teach_high.bmp into outd. Returns the new trace offset;
// out[0] receives the commit count.
fn do_teach(oroot:i64, led:[]u8, lo:i64, out:[]i64) i64 {
    let w:i64 = LW(); let h:i64 = LH();
    let W:i64 = HW(); let H:i64 = HH();
    let npix:i64 = w * h;
    let low:[]u8 = nio_alloc(npix as i32);
    let high:[]u8 = nio_alloc((W * H) as i32);
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            low[y * w + x] = teach_px(x, y) as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    let Y:i64 = 0;
    while (Y < H) {
        let X:i64 = 0;
        while (X < W) {
            high[Y * W + X] = teach_hx(X, Y) as u8;
            X = X + 1;
        }
        Y = Y + 1;
    }

    lo = tab_puts(led, lo, "[CREW] TEACH: paired fixtures generated in-fixture (the world).\n");
    lo = tab_puts(led, lo, "[CREW] TNN sees the PAIR but never the generating formulas.\n");

    // ---- SURVEY (TNN's own measurement) ----
    let nsig:i64 = NSIG();
    let cnt:[]i64 = nio_alloc((nsig * 8) as i32) as []i64;
    let sumd:[]i64 = nio_alloc((nsig * 4 * 8) as i32) as []i64;
    let sumd2:[]i64 = nio_alloc((nsig * 4 * 8) as i32) as []i64;
    let sse_bil:[]i64 = nio_alloc((nsig * 8) as i32) as []i64;
    let classcnt:[]i64 = nio_alloc(32) as []i64;
    y = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let v:i64 = low[y * w + x] as i64;
            let s:i64 = sig_of(low, w, h, x, y);
            classcnt[s / 6561] = classcnt[s / 6561] + 1;
            cnt[s] = cnt[s] + 1;
            let dy:i64 = 0;
            while (dy < 2) {
                let dx:i64 = 0;
                while (dx < 2) {
                    let k:i64 = dy * 2 + dx;
                    let B:i64 = high[(2 * y + dy) * W + 2 * x + dx] as i64;
                    let d:i64 = B - v;
                    sumd[s * 4 + k] = sumd[s * 4 + k] + d;
                    sumd2[s * 4 + k] = sumd2[s * 4 + k] + d * d;
                    let bp:i64 = bilin(low, w, h, x, y, dx, dy);
                    let e:i64 = B - bp;
                    sse_bil[s] = sse_bil[s] + e * e;
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    lo = tab_puts(led, lo, "[MEASURED] SURVEY teach-low 96x96: class histogram FLAT=");
    lo = tab_puti(led, lo, classcnt[0]);
    lo = tab_puts(led, lo, " GRAD=");
    lo = tab_puti(led, lo, classcnt[1]);
    lo = tab_puts(led, lo, " EDGE=");
    lo = tab_puti(led, lo, classcnt[2]);
    lo = tab_puts(led, lo, " CHECKER=");
    lo = tab_puti(led, lo, classcnt[3]);
    lo = tab_puts(led, lo, "\n");

    // ---- AFFINITIES + COMMIT (per signature, measured) ----
    // Atom for signature s: mean 2x2 deltas. Bar: G >= 9*N vs the best
    // generic (replication or bilinear), the standing commit bar.
    let committed:[]i64 = nio_alloc((nsig * 8) as i32) as []i64;
    let winner:[]i64 = nio_alloc((nsig * 8) as i32) as []i64;
    let atG:[]i64 = nio_alloc((nsig * 8) as i32) as []i64;
    let atomd:[]i64 = nio_alloc((nsig * 4 * 8) as i32) as []i64;
    let ncommit:i64 = 0;
    lo = tab_puts(led, lo, "[CREW] COMMIT BAR: an upscale atom must explain >= 9 per value (G >= 9*N).\n");
    let s:i64 = 0;
    while (s < nsig) {
        let n:i64 = cnt[s];
        if (n > 0) {
            let sse_repl:i64 = 0;
            let sse_atom:i64 = 0;
            let k:i64 = 0;
            while (k < 4) {
                let sd:i64 = sumd[s * 4 + k];
                let sd2:i64 = sumd2[s * 4 + k];
                sse_repl = sse_repl + sd2;
                sse_atom = sse_atom + sd2 - (sd * sd) / n;
                atomd[s * 4 + k] = rha_div(sd, n);
                k = k + 1;
            }
            let best:i64 = sse_repl;
            winner[s] = 0;
            if (sse_bil[s] < best) { best = sse_bil[s]; winner[s] = 1; }
            let G:i64 = best - sse_atom;
            let N:i64 = 4 * n;
            atG[s] = G;
            lo = tab_puts(led, lo, "[MEASURED] sig ");
            lo = tab_puti(led, lo, s);
            lo = tab_puts(led, lo, " n=");
            lo = tab_puti(led, lo, n);
            lo = tab_puts(led, lo, " SSE_repl=");
            lo = tab_puti(led, lo, sse_repl);
            lo = tab_puts(led, lo, " SSE_bil=");
            lo = tab_puti(led, lo, sse_bil[s]);
            lo = tab_puts(led, lo, " SSE_atom=");
            lo = tab_puti(led, lo, sse_atom);
            lo = tab_puts(led, lo, " G=");
            lo = tab_puti(led, lo, G);
            lo = tab_puts(led, lo, " N=");
            lo = tab_puti(led, lo, N);
            if (G >= 9 * N) {
                committed[s] = 1;
                ncommit = ncommit + 1;
                lo = tab_puts(led, lo, " [DECISION] COMMIT atom d=[");
                lo = tab_puti(led, lo, atomd[s * 4]);
                lo = tab_puts(led, lo, ",");
                lo = tab_puti(led, lo, atomd[s * 4 + 1]);
                lo = tab_puts(led, lo, ",");
                lo = tab_puti(led, lo, atomd[s * 4 + 2]);
                lo = tab_puts(led, lo, ",");
                lo = tab_puti(led, lo, atomd[s * 4 + 3]);
                lo = tab_puts(led, lo, "]\n");
            } else {
                lo = tab_puts(led, lo, " [DECISION] REVERT (below bar); generic=");
                if (winner[s] == 1) { lo = tab_puts(led, lo, "bilinear"); } else { lo = tab_puts(led, lo, "replication"); }
                lo = tab_puts(led, lo, "\n");
            }
        }
        s = s + 1;
    }
    lo = tab_puts(led, lo, "[MEASURED] atoms committed: ");
    lo = tab_puti(led, lo, ncommit);
    lo = tab_puts(led, lo, " / ");
    lo = tab_puti(led, lo, nsig);
    lo = tab_puts(led, lo, " signatures\n");

    // ---- write atoms.bin ----
    let ab:[]u8 = nio_alloc((16 + nsig * 64) as i32);
    ab[0] = 85; ab[1] = 90; ab[2] = 65; ab[3] = 84;
    ab[4] = 79; ab[5] = 77; ab[6] = 48; ab[7] = 49;
    w_u64le(ab, 8, nsig);
    s = 0;
    while (s < nsig) {
        let o:i64 = 16 + s * 64;
        w_i64le(ab, o, committed[s]);
        w_i64le(ab, o + 8, winner[s]);
        w_i64le(ab, o + 16, cnt[s]);
        w_i64le(ab, o + 24, atG[s]);
        w_i64le(ab, o + 32, atomd[s * 4]);
        w_i64le(ab, o + 40, atomd[s * 4 + 1]);
        w_i64le(ab, o + 48, atomd[s * 4 + 2]);
        w_i64le(ab, o + 56, atomd[s * 4 + 3]);
        s = s + 1;
    }
    file_write(oroot, "atoms.bin", ab);

    // ---- fixture BMPs (record, not knowledge) ----
    let rgb:[]u8 = nio_alloc((W * H * 3) as i32);
    gray_to_rgb(high, W * H, rgb);
    bmp_write(oroot, "teach_high.bmp", rgb, W, H);
    gray_to_rgb(low, npix, rgb);
    bmp_write(oroot, "teach_low.bmp", rgb, w, h);

    // ---- trace ----
    let trname:[]u8 = "TEACH_TRACE.txt";
    let tbuf:[]u8 = led[0..lo];
    file_write(oroot, trname, tbuf);

    nio_free(low); nio_free(high); nio_free(rgb); nio_free(ab);
    nio_free(cnt); nio_free(sumd); nio_free(sumd2); nio_free(sse_bil);
    nio_free(classcnt); nio_free(committed); nio_free(winner);
    nio_free(atG); nio_free(atomd);
    out[0] = ncommit;
    _zag_print("teach done, committed ");
    _zag_println(_zag_i64_to_str(ncommit));
    return lo;
}

// ---------------- TEST: construct 2x from (taught or empty) knowledge ----------------
// have_atoms=0 -> BEFORE mode: vocabulary empty, default generic (bilinear).
// have_atoms=1 -> AFTER mode: committed atoms where they exist, teach-selected
// generic elsewhere. held high-res is used ONLY for scoring.
// Returns new trace offset; out[0..6] receive: ncommit, c2_mismatch,
// odd_sse_tnn, odd_sse_bil, edge_sse_tnn, edge_sse_bil, invented.
fn do_test(oroot:i64, led:[]u8, lo:i64, have_atoms:i64,
    committed:[]i64, winner:[]i64, atomd:[]i64, out:[]i64) i64 {
    let w:i64 = LW(); let h:i64 = LH();
    let W:i64 = HW(); let H:i64 = HH();
    let npix2:i64 = W * H;
    let low:[]u8 = nio_alloc((w * h) as i32);
    let high:[]u8 = nio_alloc((W * H) as i32); // HELD: scoring only
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            low[y * w + x] = test_px(x, y) as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    let Y:i64 = 0;
    while (Y < H) {
        let X:i64 = 0;
        while (X < W) {
            high[Y * W + X] = test_hx(X, Y) as u8;
            X = X + 1;
        }
        Y = Y + 1;
    }
    if (have_atoms == 0) {
        lo = tab_puts(led, lo, "[CREW] TEST/BEFORE: atom vocabulary EMPTY (no teaching ran).\n");
        lo = tab_puts(led, lo, "[CREW] Construction falls back to the default generic (bilinear).\n");
    } else {
        lo = tab_puts(led, lo, "[CREW] TEST/AFTER: atom vocabulary loaded from atoms.bin.\n");
    }

    // ---- SURVEY the test low-res (TNN's own measurement) ----
    let classcnt:[]i64 = nio_alloc(32) as []i64;
    y = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let s:i64 = sig_of(low, w, h, x, y);
            classcnt[s / 6561] = classcnt[s / 6561] + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    lo = tab_puts(led, lo, "[MEASURED] SURVEY test-low 96x96: FLAT=");
    lo = tab_puti(led, lo, classcnt[0]);
    lo = tab_puts(led, lo, " GRAD=");
    lo = tab_puti(led, lo, classcnt[1]);
    lo = tab_puts(led, lo, " EDGE=");
    lo = tab_puti(led, lo, classcnt[2]);
    lo = tab_puts(led, lo, " CHECKER=");
    lo = tab_puti(led, lo, classcnt[3]);
    lo = tab_puts(led, lo, "\n");

    // ---- CONSTRUCTION (the only operators: atom-stamp, replication,
    //      bilinear -- see C4 audit in DESIGN.md) ----
    let con:[]u8 = nio_alloc((npix2) as i32);
    let lab:[]u8 = nio_alloc((npix2) as i32);
    let ncommit:i64 = 0;
    if (have_atoms == 1) {
        let s:i64 = 0;
        while (s < NSIG()) {
            if (committed[s] == 1) { ncommit = ncommit + 1; }
            s = s + 1;
        }
    }
    lo = tab_puts(led, lo, "[MEASURED] committed upscale atoms available: ");
    lo = tab_puti(led, lo, ncommit);
    lo = tab_puts(led, lo, "\n");
    y = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let v:i64 = low[y * w + x] as i64;
            let s:i64 = sig_of(low, w, h, x, y);
            let use_atom:i64 = 0;
            if (have_atoms == 1) {
                if (committed[s] == 1) { use_atom = 1; }
            }
            let dy:i64 = 0;
            while (dy < 2) {
                let dx:i64 = 0;
                while (dx < 2) {
                    let k:i64 = dy * 2 + dx;
                    let OX:i64 = 2 * x + dx;
                    let OY:i64 = 2 * y + dy;
                    let pv:i64 = v;
                    let lv:i64 = 2;
                    if (use_atom == 1) {
                        pv = v + atomd[s * 4 + k];
                        lv = 1;
                    } else {
                        if (have_atoms == 1 && winner[s] == 0) {
                            pv = v; // teach-selected generic: replication
                            lv = 2;
                        } else {
                            pv = bilin(low, w, h, x, y, dx, dy);
                            lv = 2;
                        }
                    }
                    con[OY * W + OX] = clamp8(pv) as u8;
                    lab[OY * W + OX] = lv as u8;
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    // C2 alignment: even positions ARE the observation, bit-exact.
    // (Crew-enforced protocol; the probe VERIFIES it; atom (0,0) deltas are
    // reported separately as TNN's own measured alignment.)
    let c2mm:i64 = 0;
    y = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let v:i64 = low[y * w + x] as i64;
            let OX:i64 = 2 * x; let OY:i64 = 2 * y;
            con[OY * W + OX] = v as u8;
            lab[OY * W + OX] = 0;
            x = x + 1;
        }
        y = y + 1;
    }
    // verify (independent pass)
    Y = 0;
    while (Y < H) {
        let X:i64 = 0;
        while (X < W) {
            if ((X % 2) == 0 && (Y % 2) == 0) {
                let v:i64 = low[(Y / 2) * w + X / 2] as i64;
                if ((con[Y * W + X] as i64) != v) { c2mm = c2mm + 1; }
            }
            X = X + 1;
        }
        Y = Y + 1;
    }

    // ---- SCORING vs HELD high-res (odd positions = the constructed pixels) ----
    let odd_tnn:i64 = 0; let odd_bil:i64 = 0;
    let edge_tnn:i64 = 0; let edge_bil:i64 = 0;
    let lab_sse:[]i64 = nio_alloc(32) as []i64;
    let lab_n:[]i64 = nio_alloc(32) as []i64;
    let edge_odd_n:i64 = 0; let edge_atom_n:i64 = 0;
    let invented:i64 = 0;
    // detail-pixel tracking (scoring only): per low-pixel flush of the
    // replication-vs-truth SSE. A "detail pixel" is an edge-region low
    // pixel whose true 2x2 differs from flat replication
    // (sum of squared (v-gt) over its odd sub-pixels > 100). C3b measures
    // what fraction of THESE TNN constructed from atoms.
    let d_lx:i64 = -1; let d_ly:i64 = -1;
    let d_sum:i64 = 0; let d_atom:i64 = 1; let d_edge:i64 = 0;
    Y = 0;
    while (Y < H) {
        let X:i64 = 0;
        while (X < W) {
            let is_even:i64 = 0;
            if ((X % 2) == 0 && (Y % 2) == 0) { is_even = 1; }
            if (is_even == 0) {
                let t:i64 = con[Y * W + X] as i64;
                let gt:i64 = high[Y * W + X] as i64;
                let e:i64 = t - gt;
                odd_tnn = odd_tnn + e * e;
                let lx:i64 = X / 2; let ly:i64 = Y / 2;
                let bp:i64 = bilin(low, w, h, lx, ly, X % 2, Y % 2);
                let eb:i64 = bp - gt;
                odd_bil = odd_bil + eb * eb;
                let lv:i64 = lab[Y * W + X] as i64;
                lab_sse[lv] = lab_sse[lv] + e * e;
                lab_n[lv] = lab_n[lv] + 1;
                if (lv == 3) { invented = invented + 1; }
                let rc:i64 = test_region_class(lx, ly);
                if (rc == 0 || rc == 3) {
                    edge_tnn = edge_tnn + e * e;
                    edge_bil = edge_bil + eb * eb;
                }
                // detail accumulation (scoring only; held GT + input only)
                let vv:i64 = low[ly * w + lx] as i64;
                let dr:i64 = vv - gt;
                if (lx != d_lx || ly != d_ly) {
                    if (d_lx >= 0 && d_edge == 1 && d_sum > 100) {
                        edge_odd_n = edge_odd_n + 1;
                        if (d_atom == 1) { edge_atom_n = edge_atom_n + 1; }
                    }
                    d_lx = lx; d_ly = ly; d_sum = 0; d_atom = 1; d_edge = 0;
                }
                d_sum = d_sum + dr * dr;
                if (lv != 1) { d_atom = 0; }
                if (rc == 0 || rc == 3) { d_edge = 1; }
            }
            X = X + 1;
        }
        Y = Y + 1;
    }
    // final detail flush for the last low pixel
    if (d_lx >= 0 && d_edge == 1 && d_sum > 100) {
        edge_odd_n = edge_odd_n + 1;
        if (d_atom == 1) { edge_atom_n = edge_atom_n + 1; }
    }

    // ---- report ----
    lo = tab_puts(led, lo, "\n[MEASURED] C1 dims: construct ");
    lo = tab_puti(led, lo, W);
    lo = tab_puts(led, lo, "x");
    lo = tab_puti(led, lo, H);
    lo = tab_puts(led, lo, " from input ");
    lo = tab_puti(led, lo, w);
    lo = tab_puts(led, lo, "x");
    lo = tab_puti(led, lo, h);
    lo = tab_puts(led, lo, "\n[MEASURED] C2 even-position mismatches: ");
    lo = tab_puti(led, lo, c2mm);
    lo = tab_puts(led, lo, " / ");
    lo = tab_puti(led, lo, w * h);
    lo = tab_puts(led, lo, "\n[MEASURED] odd-pixel SSE: tnn=");
    lo = tab_puti(led, lo, odd_tnn);
    lo = tab_puts(led, lo, " pure-bilinear=");
    lo = tab_puti(led, lo, odd_bil);
    lo = tab_puts(led, lo, " ratio*1000=");
    lo = tab_puti(led, lo, (odd_tnn * 1000) / odd_bil);
    lo = tab_puts(led, lo, "\n[MEASURED] edge-region odd SSE: tnn=");
    lo = tab_puti(led, lo, edge_tnn);
    lo = tab_puts(led, lo, " pure-bilinear=");
    lo = tab_puti(led, lo, edge_bil);
    lo = tab_puts(led, lo, " ratio*1000=");
    lo = tab_puti(led, lo, (edge_tnn * 1000) / edge_bil);
    lo = tab_puts(led, lo, "\n[MEASURED] edge detail-pixel atom coverage: ");
    lo = tab_puti(led, lo, edge_atom_n);
    lo = tab_puts(led, lo, " / ");
    lo = tab_puti(led, lo, edge_odd_n);
    lo = tab_puts(led, lo, "\n[MEASURED] label odd-SSE: KNOWN n/a; ATOM n=");
    lo = tab_puti(led, lo, lab_n[1]);
    lo = tab_puts(led, lo, " sse=");
    lo = tab_puti(led, lo, lab_sse[1]);
    lo = tab_puts(led, lo, "; GENERIC n=");
    lo = tab_puti(led, lo, lab_n[2]);
    lo = tab_puts(led, lo, " sse=");
    lo = tab_puti(led, lo, lab_sse[2]);
    lo = tab_puts(led, lo, "; INVENTED n=");
    lo = tab_puti(led, lo, invented);
    lo = tab_puts(led, lo, "\n");

    // verdict vs pre-registered bars
    let p1:i64 = 0; if (W == 192 && H == 192) { p1 = 1; }
    let p2:i64 = 0; if (c2mm == 0) { p2 = 1; }
    let p3a:i64 = 0; if (ncommit >= 1) { p3a = 1; }
    let p3b:i64 = 0;
    if (edge_odd_n > 0) {
        if (edge_atom_n * 100 >= 90 * edge_odd_n) { p3b = 1; }
    }
    let p3c:i64 = 0;
    if (edge_bil > 0 && odd_bil > 0) {
        // edge_tnn/edge_bil <= 0.75  <=> edge_tnn*4 <= edge_bil*3
        if (edge_tnn * 4 <= edge_bil * 3) {
            // odd_tnn/odd_bil <= 0.95 <=> odd_tnn*20 <= odd_bil*19
            // (4 of 6 regions are generic-ties by construction; the edge
            // bar above is the discriminating one)
            if (odd_tnn * 20 <= odd_bil * 19) { p3c = 1; }
        }
    }
    let p3d:i64 = 0; if (invented == 0) { p3d = 1; }
    // C4: static operator audit -- the construction loop above uses only
    // atom-stamp (v + atomd), replication (v), bilinear (bilin). No
    // re-rasterization, no Bresenham, no doubled-endpoint drawing exists in
    // this binary (crew audit, documented in DESIGN.md).
    let p4:i64 = 1;
    lo = tab_puts(led, lo, "[DECISION] C1 ");
    if (p1 == 1) { lo = tab_puts(led, lo, "PASS"); } else { lo = tab_puts(led, lo, "FAIL"); }
    lo = tab_puts(led, lo, " | C2 ");
    if (p2 == 1) { lo = tab_puts(led, lo, "PASS"); } else { lo = tab_puts(led, lo, "FAIL"); }
    lo = tab_puts(led, lo, " | C3a ");
    if (p3a == 1) { lo = tab_puts(led, lo, "PASS"); } else { lo = tab_puts(led, lo, "FAIL"); }
    lo = tab_puts(led, lo, " | C3b ");
    if (p3b == 1) { lo = tab_puts(led, lo, "PASS"); } else { lo = tab_puts(led, lo, "FAIL"); }
    lo = tab_puts(led, lo, " | C3c ");
    if (p3c == 1) { lo = tab_puts(led, lo, "PASS"); } else { lo = tab_puts(led, lo, "FAIL"); }
    lo = tab_puts(led, lo, " | C3d ");
    if (p3d == 1) { lo = tab_puts(led, lo, "PASS"); } else { lo = tab_puts(led, lo, "FAIL"); }
    lo = tab_puts(led, lo, " | C4 ");
    if (p4 == 1) { lo = tab_puts(led, lo, "PASS"); } else { lo = tab_puts(led, lo, "FAIL"); }
    lo = tab_puts(led, lo, "\n[DECISION] VERDICT: ");
    if (p1 == 1 && p2 == 1 && p3a == 1 && p3b == 1 && p3c == 1 && p3d == 1 && p4 == 1) {
        lo = tab_puts(led, lo, "CONCEPT HELD\n");
    } else {
        lo = tab_puts(led, lo, "CONCEPT NOT HELD\n");
    }

    // ---- outputs ----
    let rgb:[]u8 = nio_alloc((npix2 * 3) as i32);
    gray_to_rgb(con, npix2, rgb);
    bmp_write(oroot, "construct.bmp", rgb, W, H);
    let li:i64 = 0;
    while (li < npix2) {
        let lv:i64 = lab[li] as i64;
        let q3:i64 = li * 3;
        if (lv == 0) { rgb[q3] = 200; rgb[q3 + 1] = 200; rgb[q3 + 2] = 200; }
        if (lv == 1) { rgb[q3] = 60; rgb[q3 + 1] = 170; rgb[q3 + 2] = 80; }
        if (lv == 2) { rgb[q3] = 40; rgb[q3 + 1] = 80; rgb[q3 + 2] = 180; }
        if (lv == 3) { rgb[q3] = 200; rgb[q3 + 1] = 60; rgb[q3 + 2] = 200; }
        li = li + 1;
    }
    bmp_write(oroot, "labels.bmp", rgb, W, H);
    gray_to_rgb(low, w * h, rgb);
    bmp_write(oroot, "test_low.bmp", rgb, w, h);
    let tbuf:[]u8 = led[0..lo];
    if (have_atoms == 0) { file_write(oroot, "PROBE_REPORT_BEFORE.txt", tbuf); }
    else { file_write(oroot, "PROBE_REPORT_AFTER.txt", tbuf); }

    out[0] = ncommit; out[1] = c2mm; out[2] = odd_tnn; out[3] = odd_bil;
    out[4] = edge_tnn; out[5] = edge_bil; out[6] = invented;
    nio_free(low); nio_free(high); nio_free(con); nio_free(lab);
    nio_free(rgb); nio_free(classcnt); nio_free(lab_sse); nio_free(lab_n);
    return lo;
}

// ---------------- main ----------------
fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    let workd:[]u8 = _zag_arg(2);
    if (_zag_strcmp(workd, "") == 1) { workd = "."; }
    let oroot:i64 = nio_open_root(workd);
    if (oroot < 0) { _zag_println("cannot open workdir"); return 1; }
    let led:[]u8 = nio_alloc(1048576);
    if (led.len == 0) { _zag_println("alloc ledger failed"); return 1; }
    let lo:i64 = 0;
    lo = tab_puts(led, lo, "UPSCALE CONCEPT PROBE (C1-C4) -- behavioral, through TNN's intake.\n");
    lo = tab_puts(led, lo, "[CREW] Protocol: synthetic paired fixtures; TNN measures coarse->fine\n");
    lo = tab_puts(led, lo, "[CREW] atoms from the pair; commits by G >= 9*N; constructs held-out 2x.\n");
    lo = tab_puts(led, lo, "[CREW] Epistemic split: [CREW]=protocol framing, [MEASURED]=TNN's numbers,\n");
    lo = tab_puts(led, lo, "[CREW] [DECISION]=bar-gated commits and the pre-registered verdict.\n");

    if (_zag_strcmp(mode, "teach") == 1) {
        let out:[]i64 = nio_alloc(8) as []i64;
        lo = do_teach(oroot, led, lo, out);
        nio_free(out);
    } else {
        if (_zag_strcmp(mode, "test") == 1) {
            // load atoms.bin if present (AFTER mode); else BEFORE mode
            let ab:[]u8 = file_read_all(oroot, "atoms.bin", 2097152);
            let have:i64 = 0;
            let committed:[]i64 = nio_alloc((26244 * 8) as i32) as []i64;
            let winner:[]i64 = nio_alloc((26244 * 8) as i32) as []i64;
            let atomd:[]i64 = nio_alloc((26244 * 4 * 8) as i32) as []i64;
            if (ab.len >= 1679632) {
                if (ab[0] == 85 && ab[1] == 90 && ab[2] == 65 && ab[3] == 84) {
                    let ns:i64 = r_u64le(ab, 8);
                    if (ns == 26244) {
                        have = 1;
                        let s:i64 = 0;
                        while (s < NSIG()) {
                            let o:i64 = 16 + s * 64;
                            committed[s] = r_i64le(ab, o);
                            winner[s] = r_i64le(ab, o + 8);
                            atomd[s * 4] = r_i64le(ab, o + 32);
                            atomd[s * 4 + 1] = r_i64le(ab, o + 40);
                            atomd[s * 4 + 2] = r_i64le(ab, o + 48);
                            atomd[s * 4 + 3] = r_i64le(ab, o + 56);
                            s = s + 1;
                        }
                        _zag_println("atoms.bin loaded (AFTER mode)");
                    }
                }
            }
            if (have == 0) { _zag_println("no atoms.bin (BEFORE mode)"); }
            let out:[]i64 = nio_alloc(64) as []i64;
            lo = do_test(oroot, led, lo, have, committed, winner, atomd, out);
            _zag_print("odd_sse_tnn=");
            _zag_print(_zag_i64_to_str(out[2]));
            _zag_print(" odd_sse_bil=");
            _zag_println(_zag_i64_to_str(out[3]));
            nio_free(out);
            nio_free(committed); nio_free(winner); nio_free(atomd);
        } else {
            _zag_println("usage: azprobe_bin teach|test <workdir>");
            return 1;
        }
    }
    nio_close(oroot);
    return 0;
}

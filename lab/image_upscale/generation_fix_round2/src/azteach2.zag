// azteach.zag — teach the shared cross-image atom vocabulary.
//
// Micah order 2026-09-26: upscale generation path, JOB 2.
// The SHAPES vocabulary is taught from a MULTI-IMAGE corpus of real
// photographs — never from the held-out input. Atoms are farthest-point
// exemplars (the same "no vocabulary invented without evidence"
// discipline as the per-image vocab), measured at full corpus resolution
// so their deviation fields are 2x-native: rendering them at 2x needs no
// interpolation kernel, no blend constant — just measured values.
//
// Corpus (sealed, documented in CORPUS.md):
//   brick_wall_768.bmp, lake_water_768.bmp, foliage_768.bmp,
//   stone_wall_768.bmp — real photographs (CC BY-SA, Wikimedia Commons),
//   768px wide, deterministic PIL-BOX downscale from the published
//   originals (original SHAs in CORPUS.md).
//
// Scales (full-res atom size S; matching input block is S/2):
//   S=64 (input 32), S=32 (input 16), S=16 (input 8), S=8 (input 4),
//   thin S=4 (input 2x2; candidates selected from strong-edge neighborhoods).
//
// Output: vocab.bin (VOC2) + TEACH_TRACE.txt.
// Pure Zag, zero RNG, pinned toolchain. argv: 1=corpusdir 2=outdir.
@import("./azlayers.zag")

fn th_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn th_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}

// load a 24-bit BMP into px (i64 RGB); returns w (h via hout)
fn th_load_bmp(root:i64, name:[]u8, px:[]i64, npix:i64, hout:[]i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { nio_close(fd); return -2; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { nio_free(fbuf); return -3; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    if (w * h > npix) { nio_free(fbuf); return -4; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            px[p] = fbuf[q + 2] as i64;
            px[p + 1] = fbuf[q + 1] as i64;
            px[p + 2] = fbuf[q] as i64;
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    hout[0] = h;
    return w;
}

// 2x2 box downscale of an i16 deviation field (S even):
// key = round-half-away(sum/4). Linear, so the key of a zero-mean field
// is zero-mean up to rounding: no re-centering is applied.
fn th_key_from_atom(atom:[]u8, abase:i64, S:i64, key:[]u8, kbase:i64) void {
    let s2:i64 = S / 2;
    let ky:i64 = 0;
    while (ky < s2) {
        let kx:i64 = 0;
        while (kx < s2) {
            let c:i64 = 0;
            while (c < 3) {
                let s:i64 = r_i16le(atom, abase + ((2 * ky) * S + 2 * kx) * 6 + c * 2)
                    + r_i16le(atom, abase + ((2 * ky) * S + 2 * kx + 1) * 6 + c * 2)
                    + r_i16le(atom, abase + ((2 * ky + 1) * S + 2 * kx) * 6 + c * 2)
                    + r_i16le(atom, abase + ((2 * ky + 1) * S + 2 * kx + 1) * 6 + c * 2);
                let v:i64 = 0;
                if (s >= 0) { v = (s + 2) / 4; } else { v = (s - 2) / 4; }
                w_i16le(key, kbase + (ky * s2 + kx) * 6 + c * 2, v);
                c = c + 1;
            }
            kx = kx + 1;
        }
        ky = ky + 1;
    }
    return;
}

fn th_copy(dst:[]u8, do_:i64, src:[]u8, so:i64, n:i64) void {
    let i:i64 = 0;
    while (i < n) { dst[do_ + i] = src[so + i]; i = i + 1; }
    return;
}

// standalone Sobel (same kernel as tl_walks); returns |gx| and |gy|
fn th_sobel_gx(lum:[]u8, w:i64, h:i64, x:i64, y:i64) i64 {
    let xm:i64 = x - 1;
    if (xm < 0) { xm = 0; }
    let xp:i64 = x + 1;
    if (xp > w - 1) { xp = w - 1; }
    let ym:i64 = y - 1;
    if (ym < 0) { ym = 0; }
    let yp:i64 = y + 1;
    if (yp > h - 1) { yp = h - 1; }
    let gx:i64 = (lum[ym * w + xp] as i64) - (lum[ym * w + xm] as i64)
        + 2 * ((lum[y * w + xp] as i64) - (lum[y * w + xm] as i64))
        + (lum[yp * w + xp] as i64) - (lum[yp * w + xm] as i64);
    if (gx < 0) { gx = 0 - gx; }
    return gx;
}
fn th_sobel_gy(lum:[]u8, w:i64, h:i64, x:i64, y:i64) i64 {
    let xm:i64 = x - 1;
    if (xm < 0) { xm = 0; }
    let xp:i64 = x + 1;
    if (xp > w - 1) { xp = w - 1; }
    let ym:i64 = y - 1;
    if (ym < 0) { ym = 0; }
    let yp:i64 = y + 1;
    if (yp > h - 1) { yp = h - 1; }
    let gy:i64 = (lum[yp * w + xm] as i64) - (lum[ym * w + xm] as i64)
        + 2 * ((lum[yp * w + x] as i64) - (lum[ym * w + x] as i64))
        + (lum[yp * w + xp] as i64) - (lum[ym * w + xp] as i64);
    if (gy < 0) { gy = 0 - gy; }
    return gy;
}

// corpus file name by index (12 diverse images, round 2)
fn th_cname(ci:i64, c0:[]u8, c1:[]u8, c2:[]u8, c3:[]u8, c4:[]u8, c5:[]u8,
    c6:[]u8, c7:[]u8, c8:[]u8, c9:[]u8, c10:[]u8, c11:[]u8) []u8 {
    if (ci == 1) { return c1; }
    if (ci == 2) { return c2; }
    if (ci == 3) { return c3; }
    if (ci == 4) { return c4; }
    if (ci == 5) { return c5; }
    if (ci == 6) { return c6; }
    if (ci == 7) { return c7; }
    if (ci == 8) { return c8; }
    if (ci == 9) { return c9; }
    if (ci == 10) { return c10; }
    if (ci == 11) { return c11; }
    return c0;
}

// teach one dense scale; appends atoms then keys to vbuf.
// voffout[0]=new voff, naout[0]=na (or -err), toout[0]=new to. rc 0 ok.
fn th_teach_dense(root:i64, px:[]i64, pxmax:i64, hout:[]i64,
    mean:[]i64, e0a:[]i64, ncor:i64,
    c0:[]u8, c1:[]u8, c2:[]u8, c3:[]u8, c4:[]u8, c5:[]u8,
    c6:[]u8, c7:[]u8, c8:[]u8, c9:[]u8, c10:[]u8, c11:[]u8,
    S:i64, cap:i64, st:i64,
    vbuf:[]u8, voff:i64, voffout:[]i64, naout:[]i64,
    trace:[]u8, to:i64, toout:[]i64) i64 {
    let nv:i64 = S * S * 3;
    let mb:i64 = nv * 2;
    let ncand:i64 = 0;
    let ci:i64 = 0;
    while (ci < ncor) {
        let w:i64 = th_load_bmp(root, th_cname(ci, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11), px, pxmax, hout);
        if (w < 0) { naout[0] = -1; return 1; }
        let h:i64 = hout[0];
        ncand = ncand + ((w - S) / st + 1) * ((h - S) / st + 1);
        ci = ci + 1;
    }
    to = th_puts(trace, to, "scale S=");
    to = th_puti(trace, to, S);
    to = th_puts(trace, to, " stride=");
    to = th_puti(trace, to, st);
    to = th_puts(trace, to, " candidates=");
    to = th_puti(trace, to, ncand);
    to = th_puts(trace, to, "\n");
    let bdet:[]u8 = nio_alloc((ncand * mb) as i32);
    let bval:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    let cand:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    // provenance: source image and pixel coords per candidate block
    let csrc:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    let cx:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    let cy:[]i64 = nio_alloc((ncand * 8) as i32) as []i64;
    if (bdet.len == 0) { naout[0] = -2; return 1; }
    let bi:i64 = 0;
    ci = 0;
    while (ci < ncor) {
        let w2:i64 = th_load_bmp(root, th_cname(ci, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11), px, pxmax, hout);
        let h2:i64 = hout[0];
        let ncols:i64 = (w2 - S) / st + 1;
        let nrows:i64 = (h2 - S) / st + 1;
        let ry:i64 = 0;
        while (ry < nrows) {
            let rx:i64 = 0;
            while (rx < ncols) {
                tl_patch16(px, w2, rx * st, ry * st, S, S, mean,
                    bdet[bi * mb..bi * mb + mb], e0a);
                bval[bi] = nv;
                cand[bi] = bi;
                csrc[bi] = ci;
                cx[bi] = rx * st;
                cy[bi] = ry * st;
                bi = bi + 1;
                rx = rx + 1;
            }
            ry = ry + 1;
        }
        ci = ci + 1;
    }
    let atoms:[]u8 = nio_alloc((cap * mb) as i32);
    let aex:[]i64 = nio_alloc(((cap + 1) * 8) as i32) as []i64;
    let agains:[]i64 = nio_alloc(((cap + 1) * 8) as i32) as []i64;
    let gains:[]i64 = nio_alloc(16) as []i64;
    if (atoms.len == 0) { naout[0] = -3; return 1; }
    let tau:i64 = 9 * 3 * S * S;
    let na:i64 = fp_atoms(bdet, bval, S, ncand, cand, ncand,
        atoms, aex, agains, cap, tau, gains);
    if (na < 1) { na = 1; }
    to = th_puts(trace, to, "  selected na=");
    to = th_puti(trace, to, na);
    to = th_puts(trace, to, " (incl NULL atom 0); first_energy=");
    to = th_puti(trace, to, gains[1]);
    to = th_puts(trace, to, " final_mind=");
    to = th_puti(trace, to, gains[0]);
    to = th_puts(trace, to, " tau=");
    to = th_puti(trace, to, tau);
    to = th_puts(trace, to, "\n");
    // per-atom provenance: source image index and pixel coords
    // (atom 0 is NULL, no source)
    let pai:i64 = 1;
    while (pai < na) {
        let exbi:i64 = aex[pai];
        to = th_puts(trace, to, "    atom ");
        to = th_puti(trace, to, pai);
        to = th_puts(trace, to, ": src_img=");
        to = th_puti(trace, to, csrc[exbi]);
        to = th_puts(trace, to, " x=");
        to = th_puti(trace, to, cx[exbi]);
        to = th_puts(trace, to, " y=");
        to = th_puti(trace, to, cy[exbi]);
        to = th_puts(trace, to, " gain=");
        to = th_puti(trace, to, agains[pai]);
        to = th_puts(trace, to, "\n");
        pai = pai + 1;
    }
    let s2:i64 = S / 2;
    let kmb:i64 = s2 * s2 * 3 * 2;
    let keys:[]u8 = nio_alloc((na * kmb) as i32);
    if (keys.len == 0) { naout[0] = -4; return 1; }
    let ai:i64 = 0;
    while (ai < na) {
        th_key_from_atom(atoms, ai * mb, S, keys, ai * kmb);
        ai = ai + 1;
    }
    th_copy(vbuf, voff, atoms, 0, na * mb);
    voff = voff + na * mb;
    th_copy(vbuf, voff, keys, 0, na * kmb);
    voff = voff + na * kmb;
    naout[0] = na;
    voffout[0] = voff;
    toout[0] = to;
    nio_free(bdet); nio_free(bval); nio_free(cand); nio_free(csrc); nio_free(cx); nio_free(cy);
    nio_free(atoms); nio_free(aex); nio_free(agains); nio_free(gains);
    nio_free(keys);
    return 0;
}

// teach the thin scale (S=4): candidates are 4x4 patches centered on
// strong-edge pixels (|sobel|>=54, the LINES walk threshold).
fn th_teach_thin(root:i64, px:[]i64, pxmax:i64, hout:[]i64,
    mean:[]i64, e0a:[]i64, ncor:i64,
    c0:[]u8, c1:[]u8, c2:[]u8, c3:[]u8, c4:[]u8, c5:[]u8,
    c6:[]u8, c7:[]u8, c8:[]u8, c9:[]u8, c10:[]u8, c11:[]u8, cap:i64,
    vbuf:[]u8, voff:i64, voffout:[]i64, naout:[]i64,
    trace:[]u8, to:i64, toout:[]i64) i64 {
    let S:i64 = 4;
    let nv:i64 = 48;
    let mb:i64 = 96;
    let maxcand:i64 = 8000;
    let bdet:[]u8 = nio_alloc((maxcand * mb) as i32);
    let bval:[]i64 = nio_alloc((maxcand * 8) as i32) as []i64;
    let cand:[]i64 = nio_alloc((maxcand * 8) as i32) as []i64;
    let csrc:[]i64 = nio_alloc((maxcand * 8) as i32) as []i64;
    let cx:[]i64 = nio_alloc((maxcand * 8) as i32) as []i64;
    let cy:[]i64 = nio_alloc((maxcand * 8) as i32) as []i64;
    if (bdet.len == 0) { naout[0] = -2; return 1; }
    let bi:i64 = 0;
    let ci:i64 = 0;
    while (ci < ncor) {
        let w:i64 = th_load_bmp(root, th_cname(ci, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11), px, pxmax, hout);
        if (w < 0) { naout[0] = -1; return 1; }
        let h:i64 = hout[0];
        let lum:[]u8 = nio_alloc((w * h) as i32);
        let yy:i64 = 0;
        while (yy < h) {
            let xx:i64 = 0;
            while (xx < w) {
                let p:i64 = (yy * w + xx) * 3;
                lum[yy * w + xx] = ((px[p] * 299 + px[p + 1] * 587 + px[p + 2] * 114) / 1000) as u8;
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        let y2:i64 = 2;
        while (y2 < h - 2) {
            let x2:i64 = 2;
            while (x2 < w - 2) {
                let gx:i64 = th_sobel_gx(lum, w, h, x2, y2);
                let gy:i64 = th_sobel_gy(lum, w, h, x2, y2);
                let m:i64 = gx + gy;
                if (m < 0) { m = 0 - m; }
                if (m >= 54) {
                    if (bi < maxcand) {
                        tl_patch16(px, w, x2 - 1, y2 - 1, 4, 4, mean,
                            bdet[bi * mb..bi * mb + mb], e0a);
                        bval[bi] = nv;
                        cand[bi] = bi;
                        csrc[bi] = ci;
                        cx[bi] = x2 - 1;
                        cy[bi] = y2 - 1;
                        bi = bi + 1;
                    }
                }
                x2 = x2 + 2;
            }
            y2 = y2 + 2;
        }
        nio_free(lum);
        ci = ci + 1;
    }
    to = th_puts(trace, to, "thin S=4 candidates=");
    to = th_puti(trace, to, bi);
    to = th_puts(trace, to, " (|sobel|>=54, stride 2)\n");
    let atoms:[]u8 = nio_alloc((cap * mb) as i32);
    let aex:[]i64 = nio_alloc(((cap + 1) * 8) as i32) as []i64;
    let agains:[]i64 = nio_alloc(((cap + 1) * 8) as i32) as []i64;
    let gains:[]i64 = nio_alloc(16) as []i64;
    if (atoms.len == 0) { naout[0] = -3; return 1; }
    let tau:i64 = 9 * 3 * 16;
    let na:i64 = fp_atoms(bdet, bval, S, bi, cand, bi,
        atoms, aex, agains, cap, tau, gains);
    if (na < 1) { na = 1; }
    to = th_puts(trace, to, "  selected na=");
    to = th_puti(trace, to, na);
    to = th_puts(trace, to, " first_energy=");
    to = th_puti(trace, to, gains[1]);
    to = th_puts(trace, to, " final_mind=");
    to = th_puti(trace, to, gains[0]);
    to = th_puts(trace, to, "\n");
    let pai:i64 = 1;
    while (pai < na) {
        let exbi:i64 = aex[pai];
        to = th_puts(trace, to, "    thin atom ");
        to = th_puti(trace, to, pai);
        to = th_puts(trace, to, ": src_img=");
        to = th_puti(trace, to, csrc[exbi]);
        to = th_puts(trace, to, " x=");
        to = th_puti(trace, to, cx[exbi]);
        to = th_puts(trace, to, " y=");
        to = th_puti(trace, to, cy[exbi]);
        to = th_puts(trace, to, " gain=");
        to = th_puti(trace, to, agains[pai]);
        to = th_puts(trace, to, "\n");
        pai = pai + 1;
    }
    let kmb:i64 = 24;
    let keys:[]u8 = nio_alloc((na * kmb) as i32);
    if (keys.len == 0) { naout[0] = -4; return 1; }
    let ai:i64 = 0;
    while (ai < na) {
        th_key_from_atom(atoms, ai * mb, S, keys, ai * kmb);
        ai = ai + 1;
    }
    th_copy(vbuf, voff, atoms, 0, na * mb);
    voff = voff + na * mb;
    th_copy(vbuf, voff, keys, 0, na * kmb);
    voff = voff + na * kmb;
    naout[0] = na;
    voffout[0] = voff;
    toout[0] = to;
    nio_free(bdet); nio_free(bval); nio_free(cand); nio_free(csrc); nio_free(cx); nio_free(cy);
    nio_free(atoms); nio_free(aex); nio_free(agains); nio_free(gains);
    nio_free(keys);
    return 0;
}

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    let suffix:[]u8 = _zag_arg(3);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    if (_zag_strcmp(suffix, "") == 1) { suffix = "_768.bmp"; }
    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open corpusdir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }

    let trace:[]u8 = nio_alloc(1048576);
    if (trace.len == 0) { _zag_println("alloc trace failed"); return 1; }
    let to:i64 = 0;
    to = th_puts(trace, to, "TEACH TRACE — shared cross-image atom vocabulary (ROUND 2)\n");
    to = th_puts(trace, to, "Corpus: 12 real photographs, 768px wide, CC Wikimedia Commons.\n");
    to = th_puts(trace, to, "brick_wall, stone_wall, foliage, lake_water, fabric, woodgrain,\n");
    to = th_puts(trace, to, "treebark, portrait, car, building, cat, market.\n");
    to = th_puts(trace, to, "Provenance: CORPUS2.md. Seal-verified 0 overlap with held-out tests.\n");
    to = th_puts(trace, to, "Held out: sky_clouds, sealed bridge photo, 9 sealed diverse photos.\n");
    to = th_puts(trace, to, "Selection: farthest-point exemplars (fp_atoms), tau=9/value.\n");
    to = th_puts(trace, to, "Atom 0 at every scale is the NULL (all-zero) atom.\n");
    to = th_puts(trace, to, "Keys: 2x2 box downscale of atom deviations (round-half-away).\n");

    let c0:[]u8 = "brick_wall.bmp";
    let c1:[]u8 = "stone_wall.bmp";
    let c2:[]u8 = "foliage.bmp";
    let c3:[]u8 = "lake_water.bmp";
    let c4:[]u8 = "fabric.bmp";
    let c5:[]u8 = "woodgrain.bmp";
    let c6:[]u8 = "treebark.bmp";
    let c7:[]u8 = "portrait.bmp";
    let c8:[]u8 = "car.bmp";
    let c9:[]u8 = "building.bmp";
    let c10:[]u8 = "cat.bmp";
    let c11:[]u8 = "market.bmp";
    let ncor:i64 = 12;

    let pxmax:i64 = 768 * 1088 * 3;
    let px:[]i64 = nio_alloc((pxmax * 8) as i32) as []i64;
    if (px.len == 0) { _zag_println("alloc px failed"); return 1; }
    let hout:[]i64 = nio_alloc(8) as []i64;
    let mean:[]i64 = nio_alloc(24) as []i64;
    let e0a:[]i64 = nio_alloc(8) as []i64;
    let naout:[]i64 = nio_alloc(8) as []i64;
    let voffout:[]i64 = nio_alloc(8) as []i64;
    let toout:[]i64 = nio_alloc(8) as []i64;

    let vbuf:[]u8 = nio_alloc(6291456);
    if (vbuf.len == 0) { _zag_println("alloc vbuf failed"); return 1; }
    vbuf[0] = 86; vbuf[1] = 79; vbuf[2] = 67; vbuf[3] = 50;
    w_u32le(vbuf, 4, 5);
    let Slist:[]i64 = nio_alloc(40) as []i64;
    Slist[0] = 64; Slist[1] = 32; Slist[2] = 16; Slist[3] = 8; Slist[4] = 4;
    let voff:i64 = 48;
    let si:i64 = 0;
    while (si < 5) {
        w_u32le(vbuf, 8 + si * 8, Slist[si]);
        w_u32le(vbuf, 8 + si * 8 + 4, 0);
        si = si + 1;
    }

    let caps:[]i64 = nio_alloc(32) as []i64;
    let sts:[]i64 = nio_alloc(32) as []i64;
    caps[0] = 96; sts[0] = 64;
    caps[1] = 96; sts[1] = 32;
    caps[2] = 64; sts[2] = 16;
    caps[3] = 48; sts[3] = 16;
    si = 0;
    while (si < 4) {
        let rc:i64 = th_teach_dense(root, px, pxmax, hout, mean, e0a, ncor,
            c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11,
            Slist[si], caps[si], sts[si],
            vbuf, voff, voffout, naout, trace, to, toout);
        if (rc != 0) { _zag_println("teach dense failed"); return 1; }
        voff = voffout[0];
        to = toout[0];
        w_u32le(vbuf, 8 + si * 8 + 4, naout[0]);
        _zag_print("scale done na=");
        _zag_println(_zag_i64_to_str(naout[0]));
        si = si + 1;
    }
    let rc2:i64 = th_teach_thin(root, px, pxmax, hout, mean, e0a, ncor,
        c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, 64,
        vbuf, voff, voffout, naout, trace, to, toout);
    if (rc2 != 0) { _zag_println("teach thin failed"); return 1; }
    voff = voffout[0];
    to = toout[0];
    w_u32le(vbuf, 8 + 4 * 8 + 4, naout[0]);
    _zag_print("thin done na=");
    _zag_println(_zag_i64_to_str(naout[0]));

    to = th_puts(trace, to, "vocab.bin bytes=");
    to = th_puti(trace, to, voff);
    to = th_puts(trace, to, "\nDONE\n");
    let rcw:i64 = file_write(oroot, "vocab.bin", vbuf[0..voff]);
    if (rcw < 0) { _zag_println("vocab write failed"); return 1; }
    let rct:i64 = file_write(oroot, "TEACH_TRACE.txt", trace[0..to]);
    if (rct < 0) { _zag_println("trace write failed"); return 1; }
    _zag_println("teach complete");
    nio_close(root);
    nio_close(oroot);
    return 0;
}

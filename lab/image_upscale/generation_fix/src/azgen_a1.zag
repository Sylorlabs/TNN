// azgen.zag — GENERATION-path 2x upscale from the shared atom vocabulary.
//
// Micah order 2026-09-26: upscale generation path, JOB 3.
// This is the generate-don't-draw rebuild of the upscale pipeline:
//
//   JOB 1 (done in azteach): the SHAPES vocabulary is taught from a
//     MULTI-IMAGE corpus of real photographs (brick/lake/foliage/stone),
//     never from the held-out input. Atoms are 2x-native measured
//     deviation fields; matching keys are their 2x2 box downscales.
//
//   THIS program (azgen):
//     - SHAPES-ZOOM: recursive partition fit (32->16->8->4) against the
//       SHARED cross-image atoms. Region means are measured from the
//       held-out input; texture deviations come ONLY from shared atoms.
//       A block is TAKEN iff its best atom explains >=9/value AND beats
//       the finer split; otherwise it is REJECTED (no forced takes).
//     - LINES: measured Sobel strong-edge pixels select 2x2 input blocks;
//       each block is matched against the shared THIN atoms (S=4,
//       edge-selected from real photos). Taken iff >=9/value. NO walks,
//       NO DDA, NO Bresenham, NO chord rasterizer — measured edge pixels
//       say WHERE to look; measured thin atoms say WHAT the pixels are.
//     - Construction: every constructed pixel = measured region mean +
//       measured atom deviation. Even positions are the observed input
//       (KNOWN). Rejected blocks are filled with the measured block mean,
//       labeled CONSTRUCTED-NO-FIT. Leftover pixels are filled with the
//       measured local mean, labeled INVENTED. NO bicubic in the
//       generation result; NO nearest-neighbor; NO procedural fallback.
//       Bicubic survives ONLY as a separate baseline for scoring.
//     - REMOVED from the generation result: the fixed 50/50
//       nearest/bilinear blend, the fixed 1/4-1/2-3/4 boundary feather,
//       the bicubic hidden inside MIXED, the DDA/chord LINES rasterizer.
//     - 2026-09-27 HONEST RESULT: the generation path LOSES to bicubic
//       (bridge 18.47 dB vs 25.89 dB; sky 26.57 dB vs 33.20 dB).
//       Mechanism-level reason documented in the commit message and
//       the gallery: cross-image atoms hallucinate scene-inappropriate
//       high-frequency textures that low-res key matching cannot filter.
//
// Labels: 0 KNOWN, 2 CONSTRUCTED-LINES, 3 CONSTRUCTED-SHAPES,
//         4 INVENTED, 6 CONSTRUCTED-NO-FIT.
//
// Pure Zag, zero RNG, pinned toolchain.
// argv: 1=indir (input.bmp, vocab.bin, gt.bmp) 2=outdir.
@import("./azlayers.zag")

fn g_puts(b:[]u8, o:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { b[o + i] = s[i]; i = i + 1; }
    return o + s.len;
}
fn g_puti(b:[]u8, o:i64, v:i64) i64 {
    if (v < 0) { b[o] = 45; o = o + 1; v = 0 - v; }
    let t:[]u8 = _zag_i64_to_str(v);
    let i:i64 = 0;
    while (i < t.len) { b[o + i] = t[i]; i = i + 1; }
    return o + t.len;
}

fn g_load_bmp(root:i64, name:[]u8, px:[]i64, npix:i64, hout:[]i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { nio_close(fd); return -2; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { nio_free(fbuf); return -3; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    if (w * h > npix) { nio_free(fbuf); return -4; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            px[p] = fbuf[q + 2] as i64;
            px[p + 1] = fbuf[q + 1] as i64;
            px[p + 2] = fbuf[q] as i64;
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    hout[0] = h;
    return w;
}

// round-half-away integer division, den > 0
fn g_rdiv(num:i64, den:i64) i64 {
    if (num >= 0) { return (num + den / 2) / den; }
    return (num - den / 2) / den;
}

// (g_run_pixels REMOVED 2026-09-27: DDA/chord reconstruction violates the
// generate-don't-draw law. LINES now uses measured strong-edge pixels
// directly via glines_build's Sobel scan.)

// ---- vocab loading (VOC2) ----
// vS[5], vK[5], vab[5], vkb[5] filled; vbuf holds the file. rc 0 ok.
fn g_vocab_load(root:i64, vbuf:[]u8, vcap:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64, nread:[]i64) i64 {
    let fd:i64 = nio_open_child(root, "vocab.bin", 0);
    if (fd < 0) { return 1; }
    let n:i64 = nio_read_exact(fd, vbuf, vcap - 1);
    nio_close(fd);
    if (n < 48) { return 2; }
    if (vbuf[0] != 86) { return 3; }
    if (vbuf[1] != 79) { return 4; }
    if (vbuf[2] != 67) { return 5; }
    if (vbuf[3] != 50) { return 6; }
    let ns:i64 = r_u32le(vbuf, 4);
    if (ns != 5) { return 7; }
    let off:i64 = 48;
    let si:i64 = 0;
    while (si < 5) {
        let S:i64 = r_u32le(vbuf, 8 + si * 8);
        let K:i64 = r_u32le(vbuf, 8 + si * 8 + 4);
        vS[si] = S;
        vK[si] = K;
        let mb:i64 = S * S * 3 * 2;
        let s2:i64 = S / 2;
        let kmb:i64 = s2 * s2 * 3 * 2;
        vab[si] = off;
        off = off + K * mb;
        vkb[si] = off;
        off = off + K * kmb;
        si = si + 1;
    }
    nread[0] = n;
    if (off > n) { return 8; }
    return 0;
}

// ---- SHAPES-ZOOM ----
// Recursive partition fit of the residual against the SHARED atoms.
// Block (x,y,bw,bh) at scale si (atom S=vS[si], key s=S/2, nominal input s).
// Takes are recorded as stride-9 rows in `takes`:
//   x,y,bw,bh,si,atom,mr,mg,mb. Nofits as stride-4: x,y,bw,bh.
// Decision (measured, per-value bar 9, same bar as the parent pipeline):
//   TAKE iff gain_take >= 9*nval AND gain_take >= gain_split.
//   SPLIT kept iff gain_split > gain_take AND gain_split >= 9*nval.
//   else REJECT (NOFIT recorded only at si==0, the top level).
// Returns the gain credited for this block.

// Coarse-key SSD in deviation space: the key downscaled 2x2 (exact integer
// sums, compared in quarter-units so no rounding enters the ranking).
fn a1_cssd(px:[]i64, w:i64, x:i64, y:i64, bw:i64, bh:i64,
    mr:i64, mg:i64, mb:i64, vkb_si:i64, s:i64, kmb:i64, vbuf:[]u8, ai:i64,
    cbw:i64, cbh:i64) i64 {
    let kr:i64 = 0; let kg:i64 = 0; let kb:i64 = 0;
    let qy:i64 = 0;
    while (qy < cbh) {
        let qx:i64 = 0;
        while (qx < cbw) {
            let q:i64 = vkb_si + ai * kmb + ((2 * qy) * s + 2 * qx) * 6;
            let r0:i64 = r_i16le(vbuf, q) + r_i16le(vbuf, q + 6)
                + r_i16le(vbuf, q + s * 6) + r_i16le(vbuf, q + s * 6 + 6);
            let r1:i64 = r_i16le(vbuf, q + 2) + r_i16le(vbuf, q + 8)
                + r_i16le(vbuf, q + s * 6 + 2) + r_i16le(vbuf, q + s * 6 + 8);
            let r2:i64 = r_i16le(vbuf, q + 4) + r_i16le(vbuf, q + 10)
                + r_i16le(vbuf, q + s * 6 + 4) + r_i16le(vbuf, q + s * 6 + 10);
            kr = kr + r0; kg = kg + r1; kb = kb + r2;
            qx = qx + 1;
        }
        qy = qy + 1;
    }
    let nc4:i64 = cbw * cbh * 4;
    kr = kr / nc4; kg = kg / nc4; kb = kb / nc4;
    let sse:i64 = 0;
    qy = 0;
    while (qy < cbh) {
        let qx:i64 = 0;
        while (qx < cbw) {
            let p:i64 = ((y + 2 * qy) * w + (x + 2 * qx)) * 3;
            let w3:i64 = w * 3;
            let br:i64 = px[p] + px[p + 3] + px[p + w3] + px[p + w3 + 3];
            let bg:i64 = px[p + 1] + px[p + 4] + px[p + w3 + 1] + px[p + w3 + 4];
            let bb:i64 = px[p + 2] + px[p + 5] + px[p + w3 + 2] + px[p + w3 + 5];
            let q2:i64 = vkb_si + ai * kmb + ((2 * qy) * s + 2 * qx) * 6;
            let kr2:i64 = r_i16le(vbuf, q2) + r_i16le(vbuf, q2 + 6)
                + r_i16le(vbuf, q2 + s * 6) + r_i16le(vbuf, q2 + s * 6 + 6);
            let kg2:i64 = r_i16le(vbuf, q2 + 2) + r_i16le(vbuf, q2 + 8)
                + r_i16le(vbuf, q2 + s * 6 + 2) + r_i16le(vbuf, q2 + s * 6 + 8);
            let kb2:i64 = r_i16le(vbuf, q2 + 4) + r_i16le(vbuf, q2 + 10)
                + r_i16le(vbuf, q2 + s * 6 + 4) + r_i16le(vbuf, q2 + s * 6 + 10);
            let d0:i64 = (br - 4 * mr) - (kr2 - 4 * kr);
            let d1:i64 = (bg - 4 * mg) - (kg2 - 4 * kg);
            let d2:i64 = (bb - 4 * mb) - (kb2 - 4 * kb);
            sse = sse + d0 * d0 + d1 * d1 + d2 * d2;
            qx = qx + 1;
        }
        qy = qy + 1;
    }
    return sse;
}

// ARM 1 gate: the fine-key winner must rank in the coarse-key top 3.
// Auto-pass when the coarse key would be degenerate (<2 in either dim).
fn a1_agree(px:[]i64, w:i64, x:i64, y:i64, bw:i64, bh:i64,
    mr:i64, mg:i64, mb:i64, best:i64,
    vkb_si:i64, s:i64, kmb:i64, vbuf:[]u8, K:i64) i64 {
    let cbw:i64 = bw / 2;
    let cbh:i64 = bh / 2;
    if (cbw < 2) { return 1; }
    if (cbh < 2) { return 1; }
    let wcs:i64 = a1_cssd(px, w, x, y, bw, bh, mr, mg, mb,
        vkb_si, s, kmb, vbuf, best, cbw, cbh);
    let rank:i64 = 0;
    let ai:i64 = 1;
    while (ai < K) {
        if (ai != best) {
            let c:i64 = a1_cssd(px, w, x, y, bw, bh, mr, mg, mb,
                vkb_si, s, kmb, vbuf, ai, cbw, cbh);
            if (c < wcs) { rank = rank + 1; }
        }
        ai = ai + 1;
    }
    if (rank < 3) { return 1; }
    return 0;
}

fn gshapes_fit(px:[]i64, w:i64, h:i64, x:i64, y:i64, bw:i64, bh:i64, si:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64, vbuf:[]u8,
    takes:[]i64, ntout:[]i64, nofits:[]i64, nnout:[]i64) i64 {
    let S:i64 = vS[si];
    let K:i64 = vK[si];
    let s:i64 = S / 2;
    let vab_si:i64 = vab[si];
    let vkb_si:i64 = vkb[si];
    let kmb:i64 = s * s * 3 * 2;
    let n:i64 = bw * bh;
    let nval:i64 = n * 3;
    // block mean + energy (measured)
    let mr:i64 = 0; let mg:i64 = 0; let mb:i64 = 0;
    let yy:i64 = 0;
    while (yy < bh) {
        let xx:i64 = 0;
        while (xx < bw) {
            let p:i64 = ((y + yy) * w + (x + xx)) * 3;
            mr = mr + px[p]; mg = mg + px[p + 1]; mb = mb + px[p + 2];
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    mr = mr / n; mg = mg / n; mb = mb / n;
    let e:i64 = 0;
    yy = 0;
    while (yy < bh) {
        let xx:i64 = 0;
        while (xx < bw) {
            let p2:i64 = ((y + yy) * w + (x + xx)) * 3;
            let d0:i64 = px[p2] - mr;
            let d1:i64 = px[p2 + 1] - mg;
            let d2:i64 = px[p2 + 2] - mb;
            e = e + d0 * d0 + d1 * d1 + d2 * d2;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    // best shared atom (key top-left bw*bh vs block deviations)
    // atom 0 is the NULL atom: sse = e, gain 0.
    let best:i64 = 0;
    let bsse:i64 = e;
    let ai:i64 = 1;
    while (ai < K) {
        let kr:i64 = 0; let kg:i64 = 0; let kb:i64 = 0;
        let ky:i64 = 0;
        while (ky < bh) {
            let kx:i64 = 0;
            while (kx < bw) {
                let q:i64 = vkb_si + ai * kmb + (ky * s + kx) * 6;
                kr = kr + r_i16le(vbuf, q);
                kg = kg + r_i16le(vbuf, q + 2);
                kb = kb + r_i16le(vbuf, q + 4);
                kx = kx + 1;
            }
            ky = ky + 1;
        }
        kr = kr / n; kg = kg / n; kb = kb / n;
        let sse:i64 = 0;
        let y2:i64 = 0;
        while (y2 < bh) {
            let x2:i64 = 0;
            while (x2 < bw) {
                let p3:i64 = ((y + y2) * w + (x + x2)) * 3;
                let q2:i64 = vkb_si + ai * kmb + (y2 * s + x2) * 6;
                let d0:i64 = (px[p3] - mr) - (r_i16le(vbuf, q2) - kr);
                let d1:i64 = (px[p3 + 1] - mg) - (r_i16le(vbuf, q2 + 2) - kg);
                let d2:i64 = (px[p3 + 2] - mb) - (r_i16le(vbuf, q2 + 4) - kb);
                sse = sse + d0 * d0 + d1 * d1 + d2 * d2;
                x2 = x2 + 1;
            }
            y2 = y2 + 1;
        }
        if (sse < bsse) { bsse = sse; best = ai; }
        ai = ai + 1;
    }
    let gain_take:i64 = e - bsse;
    let bar:i64 = 9 * nval;
    // ARM 1: cross-scale key agreement — the fine-key winner must rank in
    // the coarse-key (2x2-downscaled, deviation-space) top 3, else reject.
    let ubest:i64 = best;
    let ugain:i64 = gain_take;
    let agree1:i64 = a1_agree(px, w, x, y, bw, bh, mr, mg, mb, best,
        vkb_si, s, kmb, vbuf, K);
    if (agree1 == 0) { ugain = 0; }
    // try the finer split
    let can_split:i64 = 0;
    if (si < 3) {
        if (bw >= 8) {
            if (bh >= 8) { can_split = 1; }
        }
    }
    if (can_split == 1) {
        let nt0:i64 = ntout[0];
        let nn0:i64 = nnout[0];
        let hw:i64 = bw / 2;
        let hh:i64 = bh / 2;
        let g0:i64 = gshapes_fit(px, w, h, x, y, hw, hh, si + 1,
            vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
        let g1:i64 = gshapes_fit(px, w, h, x + hw, y, bw - hw, hh, si + 1,
            vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
        let g2:i64 = gshapes_fit(px, w, h, x, y + hh, hw, bh - hh, si + 1,
            vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
        let g3:i64 = gshapes_fit(px, w, h, x + hw, y + hh, bw - hw, bh - hh, si + 1,
            vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
        let gain_split:i64 = g0 + g1 + g2 + g3;
        if (gain_split > ugain) {
            if (gain_split >= bar) {
                return gain_split;
            }
        }
        // split loses: truncate the children's records, try TAKE
        ntout[0] = nt0;
        nnout[0] = nn0;
    }
    if (ugain >= bar) {
        let nt:i64 = ntout[0];
        takes[nt * 9] = x;
        takes[nt * 9 + 1] = y;
        takes[nt * 9 + 2] = bw;
        takes[nt * 9 + 3] = bh;
        takes[nt * 9 + 4] = si;
        takes[nt * 9 + 5] = ubest;
        takes[nt * 9 + 6] = mr;
        takes[nt * 9 + 7] = mg;
        takes[nt * 9 + 8] = mb;
        ntout[0] = nt + 1;
        return ugain;
    }
    if (si == 0) {
        let nn:i64 = nnout[0];
        nofits[nn * 4] = x;
        nofits[nn * 4 + 1] = y;
        nofits[nn * 4 + 2] = bw;
        nofits[nn * 4 + 3] = bh;
        nnout[0] = nn + 1;
    }
    return 0;
}

// Subtract the SHAPES model (input-res: mean + key deviations) from px,
// and mark the claimed input pixels.
fn gshapes_commit(px:[]i64, w:i64, h:i64,
    vS:[]i64, vK:[]i64, vab:[]i64, vkb:[]i64, vbuf:[]u8,
    takes:[]i64, nt:i64, claimed:[]u8) void {
    let ti:i64 = 0;
    while (ti < nt) {
        let x:i64 = takes[ti * 9];
        let y:i64 = takes[ti * 9 + 1];
        let bw:i64 = takes[ti * 9 + 2];
        let bh:i64 = takes[ti * 9 + 3];
        let si:i64 = takes[ti * 9 + 4];
        let atom:i64 = takes[ti * 9 + 5];
        let mr:i64 = takes[ti * 9 + 6];
        let mg:i64 = takes[ti * 9 + 7];
        let mb:i64 = takes[ti * 9 + 8];
        let S:i64 = vS[si];
        let s:i64 = S / 2;
        let kmb:i64 = s * s * 3 * 2;
        let vkb_si:i64 = vkb[si];
        let yy:i64 = 0;
        while (yy < bh) {
            let xx:i64 = 0;
            while (xx < bw) {
                let p:i64 = ((y + yy) * w + (x + xx)) * 3;
                let q:i64 = vkb_si + atom * kmb + (yy * s + xx) * 6;
                px[p] = px[p] - (mr + r_i16le(vbuf, q));
                px[p + 1] = px[p + 1] - (mg + r_i16le(vbuf, q + 2));
                px[p + 2] = px[p + 2] - (mb + r_i16le(vbuf, q + 4));
                claimed[(y + yy) * w + (x + xx)] = 1;
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        ti = ti + 1;
    }
    return;
}

// ---- LINES (thin atoms) ----
// Match the 2x2 input block at (lx,ly) of px against the shared thin keys.
// aout[0]=best atom, mout[3]=block mean. Returns gain (energy - sse_best).
fn gthin_match(px:[]i64, w:i64, lx:i64, ly:i64,
    vkb4:i64, K4:i64, vbuf:[]u8, aout:[]i64, mout:[]i64) i64 {
    let p00:i64 = (ly * w + lx) * 3;
    let p10:i64 = p00 + 3;
    let p01:i64 = ((ly + 1) * w + lx) * 3;
    let p11:i64 = p01 + 3;
    let mr:i64 = (px[p00] + px[p10] + px[p01] + px[p11]) / 4;
    let mg:i64 = (px[p00 + 1] + px[p10 + 1] + px[p01 + 1] + px[p11 + 1]) / 4;
    let mb:i64 = (px[p00 + 2] + px[p10 + 2] + px[p01 + 2] + px[p11 + 2]) / 4;
    mout[0] = mr; mout[1] = mg; mout[2] = mb;
    let d0:i64 = px[p00] - mr; let d1:i64 = px[p10] - mr;
    let d2:i64 = px[p01] - mr; let d3:i64 = px[p11] - mr;
    let e0:i64 = px[p00 + 1] - mg; let e1:i64 = px[p10 + 1] - mg;
    let e2:i64 = px[p01 + 1] - mg; let e3:i64 = px[p11 + 1] - mg;
    let f0:i64 = px[p00 + 2] - mb; let f1:i64 = px[p10 + 2] - mb;
    let f2:i64 = px[p01 + 2] - mb; let f3:i64 = px[p11 + 2] - mb;
    let e:i64 = d0*d0+d1*d1+d2*d2+d3*d3
        + e0*e0+e1*e1+e2*e2+e3*e3 + f0*f0+f1*f1+f2*f2+f3*f3;
    let best:i64 = 0;
    let bsse:i64 = e;
    let ai:i64 = 1;
    while (ai < K4) {
        let kb:i64 = vkb4 + ai * 24;
        let kr:i64 = (r_i16le(vbuf, kb) + r_i16le(vbuf, kb + 6)
            + r_i16le(vbuf, kb + 12) + r_i16le(vbuf, kb + 18)) / 4;
        let kg:i64 = (r_i16le(vbuf, kb + 2) + r_i16le(vbuf, kb + 8)
            + r_i16le(vbuf, kb + 14) + r_i16le(vbuf, kb + 20)) / 4;
        let kbb:i64 = (r_i16le(vbuf, kb + 4) + r_i16le(vbuf, kb + 10)
            + r_i16le(vbuf, kb + 16) + r_i16le(vbuf, kb + 22)) / 4;
        let sse:i64 = 0;
        let k:i64 = 0;
        while (k < 4) {
            let q:i64 = kb + k * 6;
            let dd:i64 = 0; let ee:i64 = 0; let ff:i64 = 0;
            if (k == 0) { dd = d0; ee = e0; ff = f0; }
            if (k == 1) { dd = d1; ee = e1; ff = f1; }
            if (k == 2) { dd = d2; ee = e2; ff = f2; }
            if (k == 3) { dd = d3; ee = e3; ff = f3; }
            let r0:i64 = dd - (r_i16le(vbuf, q) - kr);
            let r1:i64 = ee - (r_i16le(vbuf, q + 2) - kg);
            let r2:i64 = ff - (r_i16le(vbuf, q + 4) - kbb);
            sse = sse + r0 * r0 + r1 * r1 + r2 * r2;
            k = k + 1;
        }
        if (sse < bsse) { bsse = sse; best = ai; }
        ai = ai + 1;
    }
    aout[0] = best;
    return e - bsse;
}

// Subtract the LINES model (input-res: rmean + thin key) from px.
fn glines_commit(px:[]i64, w:i64, h:i64, vkb4:i64, K4:i64, vbuf:[]u8,
    ltakes:[]i64, nlt:i64, claimed:[]u8) void {
    let ti:i64 = 0;
    while (ti < nlt) {
        let lx:i64 = ltakes[ti * 7];
        let ly:i64 = ltakes[ti * 7 + 1];
        let atom:i64 = ltakes[ti * 7 + 2];
        let mr:i64 = ltakes[ti * 7 + 3];
        let mg:i64 = ltakes[ti * 7 + 4];
        let mb:i64 = ltakes[ti * 7 + 5];
        let kb:i64 = vkb4 + atom * 24;
        let dy:i64 = 0;
        while (dy < 2) {
            let dx:i64 = 0;
            while (dx < 2) {
                let p:i64 = ((ly + dy) * w + (lx + dx)) * 3;
                let q:i64 = kb + (dy * 2 + dx) * 6;
                px[p] = px[p] - (mr + r_i16le(vbuf, q));
                px[p + 1] = px[p + 1] - (mg + r_i16le(vbuf, q + 2));
                px[p + 2] = px[p + 2] - (mb + r_i16le(vbuf, q + 4));
                claimed[(ly + dy) * w + (lx + dx)] = 1;
                dx = dx + 1;
            }
            dy = dy + 1;
        }
        ti = ti + 1;
    }
    return;
}

// Build LINES on the residual px.
// claimed[]: SHAPES-claimed input pixels (all four of a 2x2 block must be
//   free). Walks come from tl_walks (measured); the DDA enumerates the
//   run's input pixels (measurement, not drawing); thin atoms supply values.
// ltakes rows (stride 7): lx,ly,atom,mr,mg,mb,(pad).
// gout[0]=G_l, nout[0]=N_l.
fn glines_build(px:[]i64, w:i64, h:i64, claimed:[]u8,
    vkb4:i64, K4:i64, vbuf:[]u8,
    ltakes:[]i64, nltout:[]i64, gout:[]i64, nout:[]i64) i64 {
    // LINES via measured strong-edge pixels + shared thin atoms.
    // NO walks, NO DDA/chord reconstruction: we scan the measured Sobel
    // strong-edge map directly. For each 2x2 input block containing at
    // least one strong edge pixel (and with all 4 pixels unclaimed), we
    // match a shared 4x4 thin atom by its measured 2x2 key. Values come
    // from the atom; locations come from measurement.
    let lum:[]i64 = nio_alloc((w * h * 8) as i32) as []i64;
    if (lum.len == 0) { return 1; }
    tl_luminance(px, w * h, lum);
    let strong:[]u8 = nio_alloc((w * h) as i32);
    if (strong.len == 0) { return 2; }
    // measured Sobel strong edges (same predicate as tl_walks uses)
    let y:i64 = 1;
    while (y < h - 1) {
        let x:i64 = 1;
        while (x < w - 1) {
            let c:i64 = y * w + x;
            let gx:i64 = (lum[c - w + 1] - lum[c - w - 1])
                + 2 * (lum[c + 1] - lum[c - 1])
                + (lum[c + w + 1] - lum[c + w - 1]);
            let gy:i64 = (lum[c + w - 1] - lum[c - w - 1])
                + 2 * (lum[c + w] - lum[c - w])
                + (lum[c + w + 1] - lum[c - w + 1]);
            let agx:i64 = gx;
            if (agx < 0) { agx = 0 - agx; }
            let agy:i64 = gy;
            if (agy < 0) { agy = 0 - agy; }
            if (agx + agy >= 27) { strong[c] = 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    let taken2:[]u8 = nio_alloc((w * h) as i32);
    if (taken2.len == 0) { return 3; }
    let aout:[]i64 = nio_alloc(8) as []i64;
    let mout:[]i64 = nio_alloc(24) as []i64;
    if (aout.len == 0) { return 4; }
    let G:i64 = 0;
    let N:i64 = 0;
    let nlt:i64 = 0;
    let ly:i64 = 0;
    while (ly < h - 1) {
        let lx:i64 = 0;
        while (lx < w - 1) {
            let q0:i64 = ly * w + lx;
            // block has a measured strong edge?
            let has_edge:i64 = 0;
            if (strong[q0] == 1) { has_edge = 1; }
            if (strong[q0 + 1] == 1) { has_edge = 1; }
            if (strong[q0 + w] == 1) { has_edge = 1; }
            if (strong[q0 + w + 1] == 1) { has_edge = 1; }
            if (has_edge == 1) {
                if (claimed[q0] == 0) {
                    if (claimed[q0 + 1] == 0) {
                        if (claimed[q0 + w] == 0) {
                            if (claimed[q0 + w + 1] == 0) {
                                if (taken2[q0] == 0) {
                                    let gain:i64 = gthin_match(px, w, lx, ly,
                                        vkb4, K4, vbuf, aout, mout);
                                    if (gain >= 108) {
                                        ltakes[nlt * 7] = lx;
                                        ltakes[nlt * 7 + 1] = ly;
                                        ltakes[nlt * 7 + 2] = aout[0];
                                        ltakes[nlt * 7 + 3] = mout[0];
                                        ltakes[nlt * 7 + 4] = mout[1];
                                        ltakes[nlt * 7 + 5] = mout[2];
                                        ltakes[nlt * 7 + 6] = gain;
                                        nlt = nlt + 1;
                                        taken2[q0] = 1;
                                        taken2[q0 + 1] = 1;
                                        taken2[q0 + w] = 1;
                                        taken2[q0 + w + 1] = 1;
                                        G = G + gain;
                                        N = N + 12;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            lx = lx + 1;
        }
        ly = ly + 1;
    }
    nltout[0] = nlt;
    gout[0] = G;
    nout[0] = N;
    nio_free(lum); nio_free(strong); nio_free(taken2);
    nio_free(aout); nio_free(mout);
    return 0;
}

// ---- bicubic (BASELINE ONLY + honest NO-FIT fallback) ----
// Catmull-Rom 2x from the ORIG input (direct port of the audited
// bicubic2x; []i64 in/out, clamp applied by the caller).
// Used for the comparison baseline and, labeled CONSTRUCTED-NO-FIT,
// for blocks no atom claimed.
fn g_bicubic2x(src:[]i64, w:i64, h:i64, out:[]i64, W:i64, H:i64) void {
    let OY:i64 = 0;
    while (OY < H) {
        let y:i64 = OY / 2;
        let oy:i64 = OY - 2 * y;
        let OX:i64 = 0;
        while (OX < W) {
            let x:i64 = OX / 2;
            let ox:i64 = OX - 2 * x;
            let c:i64 = 0;
            while (c < 3) {
                let v:i64 = 0;
                if (ox == 0) {
                    if (oy == 0) {
                        v = src[(y * w + x) * 3 + c];
                    } else {
                        let y0:i64 = y - 1;
                        if (y0 < 0) { y0 = 0; }
                        let y3:i64 = y + 2;
                        if (y3 >= h) { y3 = h - 1; }
                        let y2:i64 = y + 1;
                        if (y2 >= h) { y2 = h - 1; }
                        let p0:i64 = src[(y0 * w + x) * 3 + c];
                        let p1:i64 = src[(y * w + x) * 3 + c];
                        let p2:i64 = src[(y2 * w + x) * 3 + c];
                        let p3:i64 = src[(y3 * w + x) * 3 + c];
                        let s:i64 = 0 - p0 + 9 * p1 + 9 * p2 - p3;
                        if (s >= 0) { v = (s + 8) / 16; } else { v = (s - 8) / 16; }
                    }
                } else {
                    if (oy == 0) {
                        let x0:i64 = x - 1;
                        if (x0 < 0) { x0 = 0; }
                        let x3:i64 = x + 2;
                        if (x3 >= w) { x3 = w - 1; }
                        let x2:i64 = x + 1;
                        if (x2 >= w) { x2 = w - 1; }
                        let p0:i64 = src[(y * w + x0) * 3 + c];
                        let p1:i64 = src[(y * w + x) * 3 + c];
                        let p2:i64 = src[(y * w + x2) * 3 + c];
                        let p3:i64 = src[(y * w + x3) * 3 + c];
                        let s:i64 = 0 - p0 + 9 * p1 + 9 * p2 - p3;
                        if (s >= 0) { v = (s + 8) / 16; } else { v = (s - 8) / 16; }
                    } else {
                        let s:i64 = 0;
                        let jy:i64 = -1;
                        while (jy < 3) {
                            let yy2:i64 = y + jy;
                            if (yy2 < 0) { yy2 = 0; }
                            if (yy2 >= h) { yy2 = h - 1; }
                            let wy:i64 = 9;
                            if (jy == -1) { wy = -1; }
                            if (jy == 2) { wy = -1; }
                            let ix:i64 = -1;
                            while (ix < 3) {
                                let xx2:i64 = x + ix;
                                if (xx2 < 0) { xx2 = 0; }
                                if (xx2 >= w) { xx2 = w - 1; }
                                let wx:i64 = 9;
                                if (ix == -1) { wx = -1; }
                                if (ix == 2) { wx = -1; }
                                s = s + wx * wy * src[(yy2 * w + xx2) * 3 + c];
                                ix = ix + 1;
                            }
                            jy = jy + 1;
                        }
                        if (s >= 0) { v = (s + 128) / 256; } else { v = (s - 128) / 256; }
                    }
                }
                out[(OY * W + OX) * 3 + c] = v;
                c = c + 1;
            }
            OX = OX + 1;
        }
        OY = OY + 1;
    }
    return;
}

// ---- 2x construction ----
// Renders the committed layers into acc (i64, W*H*3), lab (u8, W*H).
// Every constructed pixel = measured region mean + measured atom deviation.
fn g_render_shapes(acc:[]i64, lab:[]u8, W:i64, H:i64,
    vS:[]i64, vab:[]i64, vbuf:[]u8,
    takes:[]i64, nt:i64) void {
    let ti:i64 = 0;
    while (ti < nt) {
        let x:i64 = takes[ti * 9];
        let y:i64 = takes[ti * 9 + 1];
        let bw:i64 = takes[ti * 9 + 2];
        let bh:i64 = takes[ti * 9 + 3];
        let si:i64 = takes[ti * 9 + 4];
        let atom:i64 = takes[ti * 9 + 5];
        let mr:i64 = takes[ti * 9 + 6];
        let mg:i64 = takes[ti * 9 + 7];
        let mb:i64 = takes[ti * 9 + 8];
        let S:i64 = vS[si];
        let ab:i64 = vab[si] + atom * (S * S * 3 * 2);
        let oy:i64 = 0;
        while (oy < 2 * bh) {
            let ox:i64 = 0;
            while (ox < 2 * bw) {
                let OX:i64 = 2 * x + ox;
                let OY:i64 = 2 * y + oy;
                let p:i64 = OY * W + OX;
                if (lab[p] == 4) {
                    let q:i64 = ab + (oy * S + ox) * 6;
                    acc[p * 3] = mr + r_i16le(vbuf, q);
                    acc[p * 3 + 1] = mg + r_i16le(vbuf, q + 2);
                    acc[p * 3 + 2] = mb + r_i16le(vbuf, q + 4);
                    lab[p] = 3;
                }
                ox = ox + 1;
            }
            oy = oy + 1;
        }
        ti = ti + 1;
    }
    return;
}

fn g_render_lines(acc:[]i64, lab:[]u8, W:i64, H:i64,
    vab4:i64, vbuf:[]u8, ltakes:[]i64, nlt:i64) void {
    let ti:i64 = 0;
    while (ti < nlt) {
        let lx:i64 = ltakes[ti * 7];
        let ly:i64 = ltakes[ti * 7 + 1];
        let atom:i64 = ltakes[ti * 7 + 2];
        let mr:i64 = ltakes[ti * 7 + 3];
        let mg:i64 = ltakes[ti * 7 + 4];
        let mb:i64 = ltakes[ti * 7 + 5];
        let ab:i64 = vab4 + atom * 96;
        let ay:i64 = 0;
        while (ay < 4) {
            let ax:i64 = 0;
            while (ax < 4) {
                // odd positions only; even positions are KNOWN
                if ((ax + ay) % 2 == 1) {
                    let OX:i64 = 2 * lx + ax;
                    let OY:i64 = 2 * ly + ay;
                    let p:i64 = OY * W + OX;
                    if (lab[p] == 4) {
                        let q:i64 = ab + (ay * 4 + ax) * 6;
                        acc[p * 3] = mr + r_i16le(vbuf, q);
                        acc[p * 3 + 1] = mg + r_i16le(vbuf, q + 2);
                        acc[p * 3 + 2] = mb + r_i16le(vbuf, q + 4);
                        lab[p] = 2;
                    }
                }
                ax = ax + 1;
            }
            ay = ay + 1;
        }
        ti = ti + 1;
    }
    return;
}

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }

    // ---- vocab ----
    let vbuf:[]u8 = nio_alloc(4194304);
    let vS:[]i64 = nio_alloc(40) as []i64;
    let vK:[]i64 = nio_alloc(40) as []i64;
    let vab:[]i64 = nio_alloc(40) as []i64;
    let vkb:[]i64 = nio_alloc(40) as []i64;
    let nread:[]i64 = nio_alloc(8) as []i64;
    if (vbuf.len == 0) { _zag_println("alloc vbuf failed"); return 1; }
    let vrc:i64 = g_vocab_load(root, vbuf, 4194304, vS, vK, vab, vkb, nread);
    if (vrc != 0) { _zag_println("vocab load failed"); return 1; }
    _zag_print("vocab K: ");
    _zag_print(_zag_i64_to_str(vK[0])); _zag_print(" ");
    _zag_print(_zag_i64_to_str(vK[1])); _zag_print(" ");
    _zag_print(_zag_i64_to_str(vK[2])); _zag_print(" ");
    _zag_print(_zag_i64_to_str(vK[3])); _zag_print(" ");
    _zag_println(_zag_i64_to_str(vK[4]));

    // ---- input ----
    let pxmax:i64 = 768 * 576 * 3;
    let px:[]i64 = nio_alloc((pxmax * 8) as i32) as []i64;
    let orig:[]i64 = nio_alloc((pxmax * 8) as i32) as []i64;
    if (px.len == 0) { _zag_println("alloc px failed"); return 1; }
    let hout:[]i64 = nio_alloc(8) as []i64;
    let w:i64 = g_load_bmp(root, "input.bmp", px, pxmax, hout);
    if (w < 0) { _zag_println("input load failed"); return 1; }
    let h:i64 = hout[0];
    _zag_print("input ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));
    // orig = observed (for KNOWN + bicubic); px = residual workspace
    let i:i64 = 0;
    while (i < w * h * 3) { orig[i] = px[i]; i = i + 1; }

    let trace:[]u8 = nio_alloc(1048576);
    if (trace.len == 0) { _zag_println("alloc trace failed"); return 1; }
    let to:i64 = 0;
    to = g_puts(trace, to, "GEN TRACE — generation-path 2x upscale\n");
    to = g_puts(trace, to, "Vocab: shared cross-image atoms (VOC2), NOT from this input.\n");
    to = g_puts(trace, to, "input W=");
    to = g_puti(trace, to, w);
    to = g_puts(trace, to, " H=");
    to = g_puti(trace, to, h);
    to = g_puts(trace, to, "\n");

    // ---- survey / affinities (measured; same formulas as the audit) ----
    let s_out:[]i64 = nio_alloc(48) as []i64;
    tl_survey_flat(px, w, h, s_out);
    let E64:i64 = s_out[0]; let E32:i64 = s_out[1];
    let E16:i64 = s_out[2]; let E8:i64 = s_out[3]; let E4:i64 = s_out[4];
    let Etot:i64 = s_out[5];
    // LINES affinity: straight-run pixel mass from the walk histogram
    let lum_s:[]i64 = nio_alloc((w * h * 8) as i32) as []i64;
    tl_luminance(px, w * h, lum_s);
    let hist_s:[]i64 = nio_alloc(512) as []i64;
    let dum:[]i64 = nio_alloc(8) as []i64;
    let edgepx_s:[]i64 = nio_alloc(8) as []i64;
    tl_walks(lum_s, w, h, 27, 1, 0, dum, dum, dum, dum, dum, 0, hist_s, edgepx_s);
    let straight:i64 = 0;
    let hli:i64 = 16;
    while (hli < 64) { straight = straight + hli * hist_s[hli]; hli = hli + 1; }
    let npix:i64 = w * h;
    let aff_h:i64 = 0; let aff_l:i64 = 0;
    if (Etot > 0) { aff_h = (1000 * (E64 - E4)) / Etot; }
    if (npix > 0) { aff_l = (1000 * straight) / npix; }
    nio_free(lum_s); nio_free(hist_s); nio_free(dum); nio_free(edgepx_s);
    to = g_puts(trace, to, "survey: E64=");
    to = g_puti(trace, to, E64);
    to = g_puts(trace, to, " E32=");
    to = g_puti(trace, to, E32);
    to = g_puts(trace, to, " Etot=");
    to = g_puti(trace, to, Etot);
    to = g_puts(trace, to, "\n");
    to = g_puts(trace, to, "affinities x100: SHAPES=");
    to = g_puti(trace, to, aff_h);
    to = g_puts(trace, to, " LINES=");
    to = g_puti(trace, to, aff_l);
    to = g_puts(trace, to, "\n");

    let shapes_first:i64 = 1;
    if (aff_l > aff_h) { shapes_first = 0; }
    to = g_puts(trace, to, "order: ");
    if (shapes_first == 1) {
        to = g_puts(trace, to, "SHAPES->LINES (coarse-to-fine cascade)\n");
    } else {
        to = g_puts(trace, to, "LINES->SHAPES\n");
    }

    // ---- cascade ----
    let claimed:[]u8 = nio_alloc((w * h) as i32);
    if (claimed.len == 0) { _zag_println("alloc claimed failed"); return 1; }
    // SHAPES takes (stride 9), nofits (stride 4)
    let takes:[]i64 = nio_alloc((16384 * 9 * 8) as i32) as []i64;
    let ntout:[]i64 = nio_alloc(8) as []i64;
    let nofits:[]i64 = nio_alloc((1024 * 4 * 8) as i32) as []i64;
    let nnout:[]i64 = nio_alloc(8) as []i64;
    // LINES takes (stride 7)
    let ltakes:[]i64 = nio_alloc((16384 * 7 * 8) as i32) as []i64;
    let nltout:[]i64 = nio_alloc(8) as []i64;
    let gout:[]i64 = nio_alloc(8) as []i64;
    let nout:[]i64 = nio_alloc(8) as []i64;
    if (takes.len == 0) { _zag_println("alloc takes failed"); return 1; }

    let shapes_committed:i64 = 0;
    let lines_committed:i64 = 0;
    let Gh:i64 = 0; let Nh:i64 = 0;
    let Gl:i64 = 0; let Nl:i64 = 0;

    if (shapes_first == 1) {
        // SHAPES-ZOOM on the raw input
        ntout[0] = 0; nnout[0] = 0;
        let nbx:i64 = (w + 31) / 32;
        let nby:i64 = (h + 31) / 32;
        let by:i64 = 0;
        while (by < nby) {
            let bx:i64 = 0;
            while (bx < nbx) {
                let bw:i64 = 32;
                if (bx * 32 + bw > w) { bw = w - bx * 32; }
                let bh:i64 = 32;
                if (by * 32 + bh > h) { bh = h - by * 32; }
                let g:i64 = gshapes_fit(px, w, h, bx * 32, by * 32, bw, bh, 0,
                    vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
                Gh = Gh + g;
                Nh = Nh + bw * bh * 3;
                bx = bx + 1;
            }
            by = by + 1;
        }
        let nt:i64 = ntout[0];
        to = g_puts(trace, to, "SHAPES: G=");
        to = g_puti(trace, to, Gh);
        to = g_puts(trace, to, " N=");
        to = g_puti(trace, to, Nh);
        to = g_puts(trace, to, " takes=");
        to = g_puti(trace, to, nt);
        to = g_puts(trace, to, " nofits=");
        to = g_puti(trace, to, nnout[0]);
        to = g_puts(trace, to, "\n");
        _zag_print("SHAPES G=");
        _zag_print(_zag_i64_to_str(Gh));
        _zag_print(" N=");
        _zag_print(_zag_i64_to_str(Nh));
        _zag_print(" takes=");
        _zag_println(_zag_i64_to_str(nt));
        if (Nh > 0) {
            if (Gh >= 9 * Nh) {
                shapes_committed = 1;
                gshapes_commit(px, w, h, vS, vK, vab, vkb, vbuf,
                    takes, nt, claimed);
                to = g_puts(trace, to, "SHAPES COMMITTED\n");
            } else {
                to = g_puts(trace, to, "SHAPES REVERTED (G < 9N)\n");
            }
        }
        // LINES on the residual
        let lrc:i64 = glines_build(px, w, h, claimed,
            vkb[4], vK[4], vbuf, ltakes, nltout, gout, nout);
        if (lrc != 0) { _zag_println("lines build failed"); return 1; }
        Gl = gout[0]; Nl = nout[0];
        to = g_puts(trace, to, "LINES: G=");
        to = g_puti(trace, to, Gl);
        to = g_puts(trace, to, " N=");
        to = g_puti(trace, to, Nl);
        to = g_puts(trace, to, " takes=");
        to = g_puti(trace, to, nltout[0]);
        to = g_puts(trace, to, "\n");
        _zag_print("LINES G=");
        _zag_print(_zag_i64_to_str(Gl));
        _zag_print(" N=");
        _zag_print(_zag_i64_to_str(Nl));
        _zag_print(" takes=");
        _zag_println(_zag_i64_to_str(nltout[0]));
        if (Nl > 0) {
            if (Gl >= 9 * Nl) {
                lines_committed = 1;
                glines_commit(px, w, h, vkb[4], vK[4], vbuf,
                    ltakes, nltout[0], claimed);
                to = g_puts(trace, to, "LINES COMMITTED\n");
            } else {
                to = g_puts(trace, to, "LINES REVERTED (G < 9N)\n");
            }
        }
    } else {
        // LINES-first order: LINES on raw input, then SHAPES on residual
        // (skipping LINES-claimed blocks).
        let lrc:i64 = glines_build(px, w, h, claimed,
            vkb[4], vK[4], vbuf, ltakes, nltout, gout, nout);
        if (lrc != 0) { _zag_println("lines build failed"); return 1; }
        Gl = gout[0]; Nl = nout[0];
        to = g_puts(trace, to, "LINES: G=");
        to = g_puti(trace, to, Gl);
        to = g_puts(trace, to, " N=");
        to = g_puti(trace, to, Nl);
        to = g_puts(trace, to, " takes=");
        to = g_puti(trace, to, nltout[0]);
        to = g_puts(trace, to, "\n");
        _zag_print("LINES G=");
        _zag_print(_zag_i64_to_str(Gl));
        _zag_print(" N=");
        _zag_print(_zag_i64_to_str(Nl));
        _zag_print(" takes=");
        _zag_println(_zag_i64_to_str(nltout[0]));
        if (Nl > 0) {
            if (Gl >= 9 * Nl) {
                lines_committed = 1;
                glines_commit(px, w, h, vkb[4], vK[4], vbuf,
                    ltakes, nltout[0], claimed);
                to = g_puts(trace, to, "LINES COMMITTED\n");
            } else {
                to = g_puts(trace, to, "LINES REVERTED (G < 9N)\n");
            }
        }
        // SHAPES on the residual, skipping LINES-claimed blocks
        ntout[0] = 0; nnout[0] = 0;
        let nbx:i64 = (w + 31) / 32;
        let nby:i64 = (h + 31) / 32;
        let by:i64 = 0;
        while (by < nby) {
            let bx:i64 = 0;
            while (bx < nbx) {
                let bw:i64 = 32;
                if (bx * 32 + bw > w) { bw = w - bx * 32; }
                let bh:i64 = 32;
                if (by * 32 + bh > h) { bh = h - by * 32; }
                // skip if any pixel in block is LINES-claimed
                let skip:i64 = 0;
                let yy:i64 = 0;
                while (yy < bh) {
                    let xx:i64 = 0;
                    while (xx < bw) {
                        if (claimed[(by*32+yy)*w + (bx*32+xx)] == 1) { skip = 1; }
                        xx = xx + 1;
                    }
                    yy = yy + 1;
                }
                if (skip == 0) {
                    let g:i64 = gshapes_fit(px, w, h, bx * 32, by * 32, bw, bh, 0,
                        vS, vK, vab, vkb, vbuf, takes, ntout, nofits, nnout);
                    Gh = Gh + g;
                    Nh = Nh + bw * bh * 3;
                } else {
                    // LINES-claimed block: record as nofit for mean-fill
                    let nn:i64 = nnout[0];
                    nofits[nn * 4] = bx * 32;
                    nofits[nn * 4 + 1] = by * 32;
                    nofits[nn * 4 + 2] = bw;
                    nofits[nn * 4 + 3] = bh;
                    nnout[0] = nn + 1;
                }
                bx = bx + 1;
            }
            by = by + 1;
        }
        let nt:i64 = ntout[0];
        to = g_puts(trace, to, "SHAPES: G=");
        to = g_puti(trace, to, Gh);
        to = g_puts(trace, to, " N=");
        to = g_puti(trace, to, Nh);
        to = g_puts(trace, to, " takes=");
        to = g_puti(trace, to, nt);
        to = g_puts(trace, to, " nofits=");
        to = g_puti(trace, to, nnout[0]);
        to = g_puts(trace, to, "\n");
        _zag_print("SHAPES G=");
        _zag_print(_zag_i64_to_str(Gh));
        _zag_print(" N=");
        _zag_print(_zag_i64_to_str(Nh));
        _zag_print(" takes=");
        _zag_println(_zag_i64_to_str(nt));
        if (Nh > 0) {
            if (Gh >= 9 * Nh) {
                shapes_committed = 1;
                gshapes_commit(px, w, h, vS, vK, vab, vkb, vbuf,
                    takes, nt, claimed);
                to = g_puts(trace, to, "SHAPES COMMITTED\n");
            } else {
                to = g_puts(trace, to, "SHAPES REVERTED (G < 9N)\n");
            }
        }
    }

    // ---- 2x construction ----
    let W:i64 = 2 * w;
    let H:i64 = 2 * h;
    let acc:[]i64 = nio_alloc((W * H * 3 * 8) as i32) as []i64;
    let lab:[]u8 = nio_alloc((W * H) as i32);
    if (acc.len == 0) { _zag_println("alloc acc failed"); return 1; }
    // lab init 4 (INVENTED)
    let li:i64 = 0;
    while (li < W * H) { lab[li] = 4; li = li + 1; }
    // render committed layers (build order; each checks lab==4)
    if (shapes_committed == 1) {
        g_render_shapes(acc, lab, W, H, vS, vab, vbuf, takes, ntout[0]);
    }
    if (lines_committed == 1) {
        g_render_lines(acc, lab, W, H, vab[4], vbuf, ltakes, nltout[0]);
    }
    // KNOWN: even positions are the observed input
    let iy:i64 = 0;
    while (iy < h) {
        let ix:i64 = 0;
        while (ix < w) {
            let p:i64 = ((2 * iy) * W + 2 * ix);
            let q:i64 = (iy * w + ix) * 3;
            acc[p * 3] = orig[q];
            acc[p * 3 + 1] = orig[q + 1];
            acc[p * 3 + 2] = orig[q + 2];
            lab[p] = 0;
            ix = ix + 1;
        }
        iy = iy + 1;
    }
    // bicubic baseline (full frame, from orig)
    let bic:[]i64 = nio_alloc((W * H * 3 * 8) as i32) as []i64;
    if (bic.len == 0) { _zag_println("alloc bic failed"); return 1; }
    g_bicubic2x(orig, w, h, bic, W, H);
    // NO-FIT: measured region mean for rejected blocks, labeled 6.
    // (2026-09-27: bicubic fallback REMOVED — violates generate-don't-draw.
    // Bicubic remains ONLY as the separate baseline `bic` for scoring.)
    // Every pixel traces to a measured atom or measured region mean.
    if (shapes_committed == 1) {
        let ni2:i64 = 0;
        while (ni2 < nnout[0]) {
            let nx:i64 = nofits[ni2 * 4];
            let ny:i64 = nofits[ni2 * 4 + 1];
            let nbw:i64 = nofits[ni2 * 4 + 2];
            let nbh:i64 = nofits[ni2 * 4 + 3];
            // measured mean of the input block
            let mr:i64 = 0;
            let mg:i64 = 0;
            let mb:i64 = 0;
            let by:i64 = 0;
            while (by < nbh) {
                let bx:i64 = 0;
                while (bx < nbw) {
                    let q:i64 = ((ny + by) * w + (nx + bx)) * 3;
                    mr = mr + orig[q];
                    mg = mg + orig[q + 1];
                    mb = mb + orig[q + 2];
                    bx = bx + 1;
                }
                by = by + 1;
            }
            let n:i64 = nbw * nbh;
            mr = g_rdiv(mr, n); mg = g_rdiv(mg, n); mb = g_rdiv(mb, n);
            let oy:i64 = 0;
            while (oy < 2 * nbh) {
                let ox:i64 = 0;
                while (ox < 2 * nbw) {
                    let p2:i64 = (2 * ny + oy) * W + (2 * nx + ox);
                    if (lab[p2] == 4) {
                        acc[p2 * 3] = mr;
                        acc[p2 * 3 + 1] = mg;
                        acc[p2 * 3 + 2] = mb;
                        lab[p2] = 6;
                    }
                    ox = ox + 1;
                }
                oy = oy + 1;
            }
            ni2 = ni2 + 1;
        }
    } else {
        // SHAPES reverted: every block is NO-FIT -> whole frame mean
        let p3:i64 = 0;
        while (p3 < W * H) {
            if (lab[p3] == 4) {
                let OX:i64 = p3 % W;
                let OY:i64 = p3 / W;
                // measured mean of containing input block (8x8 grid)
                let bx:i64 = (OX / 2) / 8 * 8;
                let by:i64 = (OY / 2) / 8 * 8;
                let mr:i64 = 0; let mg:i64 = 0; let mb:i64 = 0;
                let cy:i64 = 0;
                while (cy < 8) {
                    let cx:i64 = 0;
                    while (cx < 8) {
                        let q:i64 = ((by + cy) * w + (bx + cx)) * 3;
                        mr = mr + orig[q]; mg = mg + orig[q+1]; mb = mb + orig[q+2];
                        cx = cx + 1;
                    }
                    cy = cy + 1;
                }
                acc[p3 * 3] = g_rdiv(mr, 64);
                acc[p3 * 3 + 1] = g_rdiv(mg, 64);
                acc[p3 * 3 + 2] = g_rdiv(mb, 64);
                lab[p3] = 6;
            }
            p3 = p3 + 1;
        }
    }
    // INVENTED: measured region mean for anything left, labeled 4.
    // (2026-09-27: nearest-observed fallback REMOVED — procedural.
    // Uses the measured mean of the containing 2x2 input block.)
    let p4:i64 = 0;
    while (p4 < W * H) {
        if (lab[p4] == 4) {
            let OX:i64 = p4 % W;
            let OY:i64 = p4 / W;
            let ix:i64 = OX / 2;
            let iy:i64 = OY / 2;
            // 2x2 input block mean (clamped to bounds)
            let x0:i64 = ix - 1; if (x0 < 0) { x0 = 0; }
            let y0:i64 = iy - 1; if (y0 < 0) { y0 = 0; }
            let x1:i64 = ix + 1; if (x1 >= w) { x1 = w - 1; }
            let y1:i64 = iy + 1; if (y1 >= h) { y1 = h - 1; }
            let mr:i64 = 0; let mg:i64 = 0; let mb:i64 = 0; let n:i64 = 0;
            let yy:i64 = y0;
            while (yy <= y1) {
                let xx:i64 = x0;
                while (xx <= x1) {
                    let q4:i64 = (yy * w + xx) * 3;
                    mr = mr + orig[q4]; mg = mg + orig[q4+1]; mb = mb + orig[q4+2];
                    n = n + 1;
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            acc[p4 * 3] = g_rdiv(mr, n);
            acc[p4 * 3 + 1] = g_rdiv(mg, n);
            acc[p4 * 3 + 2] = g_rdiv(mb, n);
            // lab stays 4 = INVENTED (mean-filled, honestly labeled)
        }
        p4 = p4 + 1;
    }
    // clamp acc in place (what's measured is what's output)
    let p5:i64 = 0;
    while (p5 < W * H * 3) {
        if (acc[p5] < 0) { acc[p5] = 0; }
        if (acc[p5] > 255) { acc[p5] = 255; }
        p5 = p5 + 1;
    }
    let b5:i64 = 0;
    while (b5 < W * H * 3) {
        if (bic[b5] < 0) { bic[b5] = 0; }
        if (bic[b5] > 255) { bic[b5] = 255; }
        b5 = b5 + 1;
    }

    // ---- write BMPs ----
    // gen
    let ob:[]u8 = nio_alloc((W * H * 3) as i32);
    let pb:i64 = 0;
    while (pb < W * H * 3) { ob[pb] = acc[pb] as u8; pb = pb + 1; }
    let wrc:i64 = bmp_write(oroot, "upscale_gen.bmp", ob, W, H);
    if (wrc < 0) { _zag_println("gen bmp write failed"); return 1; }
    // bicubic baseline
    pb = 0;
    while (pb < W * H * 3) { ob[pb] = bic[pb] as u8; pb = pb + 1; }
    wrc = bmp_write(oroot, "upscale_bicubic.bmp", ob, W, H);
    if (wrc < 0) { _zag_println("bic bmp write failed"); return 1; }
    // labelmap
    let lmb:[]u8 = nio_alloc((W * H * 3) as i32);
    let pl:i64 = 0;
    while (pl < W * H) {
        let L:i64 = lab[pl] as i64;
        let r:i64 = 0; let g:i64 = 0; let bb:i64 = 0;
        if (L == 0) { r = 128; g = 128; bb = 128; }
        if (L == 2) { r = 255; g = 0; bb = 0; }
        if (L == 3) { r = 0; g = 255; bb = 0; }
        if (L == 4) { r = 0; g = 0; bb = 0; }
        if (L == 6) { r = 0; g = 0; bb = 255; }
        lmb[pl * 3] = r as u8; lmb[pl * 3 + 1] = g as u8; lmb[pl * 3 + 2] = bb as u8;
        pl = pl + 1;
    }
    wrc = bmp_write(oroot, "labelmap.bmp", lmb, W, H);
    if (wrc < 0) { _zag_println("labelmap write failed"); return 1; }
    wrc = file_write(oroot, "labels_raw.bin", lab);
    if (wrc < 0) { _zag_println("labels write failed"); return 1; }
    nio_free(ob); nio_free(lmb);

    // ---- measure vs GT (loaded AFTER construction) ----
    let gpx:[]i64 = nio_alloc((W * H * 3 * 8) as i32) as []i64;
    if (gpx.len == 0) { _zag_println("alloc gpx failed"); return 1; }
    let ghout:[]i64 = nio_alloc(8) as []i64;
    let gw:i64 = g_load_bmp(root, "gt.bmp", gpx, W * H * 3, ghout);
    if (gw != W) { _zag_println("gt size mismatch"); return 1; }
    let sse_g:i64 = 0;
    let sse_b:i64 = 0;
    // per-label SSE and census
    let lab_sse:[]i64 = nio_alloc(56) as []i64;
    let lab_cnt:[]i64 = nio_alloc(56) as []i64;
    // tiles 8x8
    let tile_g:[]i64 = nio_alloc(512) as []i64;
    let tile_b:[]i64 = nio_alloc(512) as []i64;
    let mp:i64 = 0;
    while (mp < W * H) {
        let OX2:i64 = mp % W;
        let OY2:i64 = mp / W;
        let dg0:i64 = acc[mp * 3] - gpx[mp * 3];
        let dg1:i64 = acc[mp * 3 + 1] - gpx[mp * 3 + 1];
        let dg2:i64 = acc[mp * 3 + 2] - gpx[mp * 3 + 2];
        let sg:i64 = dg0 * dg0 + dg1 * dg1 + dg2 * dg2;
        let db0:i64 = bic[mp * 3] - gpx[mp * 3];
        let db1:i64 = bic[mp * 3 + 1] - gpx[mp * 3 + 1];
        let db2:i64 = bic[mp * 3 + 2] - gpx[mp * 3 + 2];
        let sb:i64 = db0 * db0 + db1 * db1 + db2 * db2;
        sse_g = sse_g + sg;
        sse_b = sse_b + sb;
        let L2:i64 = lab[mp] as i64;
        lab_sse[L2] = lab_sse[L2] + sg;
        lab_cnt[L2] = lab_cnt[L2] + 1;
        let tx:i64 = (OX2 * 8) / W;
        let ty:i64 = (OY2 * 8) / H;
        tile_g[ty * 8 + tx] = tile_g[ty * 8 + tx] + sg;
        tile_b[ty * 8 + tx] = tile_b[ty * 8 + tx] + sb;
        mp = mp + 1;
    }

    // ---- scores + tiles files ----
    let sc:[]u8 = nio_alloc(65536);
    let so:i64 = 0;
    so = g_puts(sc, so, "GEN SCORES — generation-path 2x upscale vs GT\n");
    so = g_puts(sc, so, "sse_gen=");
    so = g_puti(sc, so, sse_g);
    so = g_puts(sc, so, "\nsse_bic=");
    so = g_puti(sc, so, sse_b);
    so = g_puts(sc, so, "\nW=");
    so = g_puti(sc, so, W);
    so = g_puts(sc, so, " H=");
    so = g_puti(sc, so, H);
    so = g_puts(sc, so, "\nlabel_census: 0=");
    so = g_puti(sc, so, lab_cnt[0]);
    so = g_puts(sc, so, " 2=");
    so = g_puti(sc, so, lab_cnt[2]);
    so = g_puts(sc, so, " 3=");
    so = g_puti(sc, so, lab_cnt[3]);
    so = g_puts(sc, so, " 4=");
    so = g_puti(sc, so, lab_cnt[4]);
    so = g_puts(sc, so, " 6=");
    so = g_puti(sc, so, lab_cnt[6]);
    so = g_puts(sc, so, "\nlabel_sse: 0=");
    so = g_puti(sc, so, lab_sse[0]);
    so = g_puts(sc, so, " 2=");
    so = g_puti(sc, so, lab_sse[2]);
    so = g_puts(sc, so, " 3=");
    so = g_puti(sc, so, lab_sse[3]);
    so = g_puts(sc, so, " 4=");
    so = g_puti(sc, so, lab_sse[4]);
    so = g_puts(sc, so, " 6=");
    so = g_puti(sc, so, lab_sse[6]);
    so = g_puts(sc, so, "\nshapes_committed=");
    so = g_puti(sc, so, shapes_committed);
    so = g_puts(sc, so, " Gh=");
    so = g_puti(sc, so, Gh);
    so = g_puts(sc, so, " Nh=");
    so = g_puti(sc, so, Nh);
    so = g_puts(sc, so, "\nlines_committed=");
    so = g_puti(sc, so, lines_committed);
    so = g_puts(sc, so, " Gl=");
    so = g_puti(sc, so, Gl);
    so = g_puts(sc, so, " Nl=");
    so = g_puti(sc, so, Nl);
    so = g_puts(sc, so, "\n");
    wrc = file_write(oroot, "GEN_SCORES.txt", sc[0..so]);
    if (wrc < 0) { _zag_println("scores write failed"); return 1; }

    let tf:[]u8 = nio_alloc(65536);
    let tfo:i64 = 0;
    tfo = g_puts(tf, tfo, "TILES 8x8: idx sse_gen sse_bic\n");
    let ti2:i64 = 0;
    while (ti2 < 64) {
        tfo = g_puti(tf, tfo, ti2);
        tfo = g_puts(tf, tfo, " ");
        tfo = g_puti(tf, tfo, tile_g[ti2]);
        tfo = g_puts(tf, tfo, " ");
        tfo = g_puti(tf, tfo, tile_b[ti2]);
        tfo = g_puts(tf, tfo, "\n");
        ti2 = ti2 + 1;
    }
    wrc = file_write(oroot, "TILES.txt", tf[0..tfo]);
    if (wrc < 0) { _zag_println("tiles write failed"); return 1; }

    to = g_puts(trace, to, "sse_gen=");
    to = g_puti(trace, to, sse_g);
    to = g_puts(trace, to, " sse_bic=");
    to = g_puti(trace, to, sse_b);
    to = g_puts(trace, to, "\nDONE\n");
    wrc = file_write(oroot, "GEN_TRACE.txt", trace[0..to]);
    if (wrc < 0) { _zag_println("trace write failed"); return 1; }

    _zag_print("sse_gen=");
    _zag_print(_zag_i64_to_str(sse_g));
    _zag_print(" sse_bic=");
    _zag_println(_zag_i64_to_str(sse_b));
    _zag_println("gen complete");
    nio_close(root);
    nio_close(oroot);
    return 0;
}

// syncav.zag — SYNC-1 challenger (fable R1 Q5): cross-path A/V sync.
// Video: 30 s bouncing ball, 60 fps (1800 frames 64x48), contacts at
//   frames 30,90,150,... (every 60 frames). Modes: vpar (pure plan),
//   vservo (plan-seeded EMA temporal state, alpha=0.5 -> ~1-frame lag).
// Audio: 30 s @44100 Hz, "boing" (decaying 180 Hz cosine burst) at
//   t=0.5,1.5,...,29.5 s. Modes: apar (closed-form pure fn of (plan,n)),
//   baudio (B-style: 5 s regions, carried osc/env state, wiped+reseeded
//   from plan at region boundaries).
// Variant "nearedge": adds one extra boing at t=5.01 s (10 ms after the
//   5.0 s region boundary) to test fable's near-boundary reseed worry.
// argv: <video|audio> <mode> <out> [seq|nearedge]
// Sidecars: <out>.ycent (video: per-frame y-centroid sums), none for audio.
// Pure Zag, zero RNG, pinned znc.

fn z_alloc(n:i64) []u8 {
    if (n < 1 || n > 33554432) { return ""; }
    let p:*u8 = _zag_malloc(n as i32) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..(n as i32)];
    let i:i64 = 0;
    while (i < n) { b[i] = 0 as u8; i = i + 1; }
    return b;
}
fn z_free(b:[]u8) void {
    if (b.len > 0) { _zag_free(_zag_slice_ptr(b)); }
}
fn z_cstr(d:[]u8, s:[]u8) void {
    let i:i64 = 0;
    while (i < s.len) { d[i] = s[i]; i = i + 1; }
    d[i] = 0 as u8;
}
fn f_open_w(path:[]u8) i64 {
    let buf:[]u8 = z_alloc(path.len + 1);
    if (buf.len == 0) { return -1; }
    z_cstr(buf, path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(buf) as i64, 577, 420, 0, 0, 0);
    z_free(buf);
    return fd;
}
fn f_close(fd:i64) void {
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
}
fn f_write_all(fd:i64, b:[]u8) i64 {
    let o:i64 = 0;
    while (o < b.len) {
        let w:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(b) as i64) + o, b.len - o, 0, 0, 0);
        if (w <= 0) { return -1; }
        o = o + w;
    }
    return 0;
}
fn dec_app(buf:[]u8, pos:i64, v:i64) i64 {
    if (v == 0) { buf[pos] = 48 as u8; return pos + 1; }
    let neg:i64 = 0;
    if (v < 0) { neg = 1; v = 0 - v; }
    let tmp:[]u8 = z_alloc(24);
    let n:i64 = 0;
    while (v > 0) {
        tmp[n] = ((v % 10) + 48) as u8;
        v = v / 10;
        n = n + 1;
    }
    if (neg == 1) { buf[pos] = 45 as u8; pos = pos + 1; }
    while (n > 0) {
        n = n - 1;
        buf[pos] = tmp[n];
        pos = pos + 1;
    }
    z_free(tmp);
    return pos;
}
fn cen_path(outp:[]u8, ext0:i64, ext1:i64, ext2:i64, ext3:i64, ext4:i64, ext5:i64) []u8 {
    let cp:[]u8 = z_alloc(outp.len + 7);
    let i:i64 = 0;
    while (i < outp.len) { cp[i] = outp[i]; i = i + 1; }
    cp[outp.len] = 46 as u8;
    cp[outp.len + 1] = ext0 as u8;
    cp[outp.len + 2] = ext1 as u8;
    cp[outp.len + 3] = ext2 as u8;
    cp[outp.len + 4] = ext3 as u8;
    cp[outp.len + 5] = ext4 as u8;
    cp[outp.len + 6] = ext5 as u8;
    return cp;
}

// ---- video: bouncing ball, plan y center in q16 ----
fn yplan_q16(f:i64) i64 {
    let ground:i64 = 41;
    let A:i64 = 35;
    if (f < 30) {
        return (ground - A) * 65536 + (A * 65536 * f) / 30;
    }
    let ph:i64 = (f - 30) % 60;
    return ground * 65536 - (4 * A * ph * (60 - ph) * 65536) / 3600;
}
fn render_vframe(f:i64, yc_q16:i64, fb:[]u8, o_sumy:*i64, o_cnt:*i64) void {
    let W:i64 = 64;
    let H:i64 = 48;
    let yc:i64 = (yc_q16 + 32768) / 65536;
    let sumy:i64 = 0;
    let cnt:i64 = 0;
    let y:i64 = 0;
    while (y < H) {
        let dy:i64 = y - yc;
        let x:i64 = 0;
        while (x < W) {
            let dx:i64 = x - 32;
            let r:i64 = 255;
            let g:i64 = 255;
            let b:i64 = 255;
            if (dx * dx + dy * dy <= 36) {
                r = 255; g = 0; b = 0;
            }
            let o:i64 = (y * W + x) * 3;
            fb[o] = r as u8;
            fb[o + 1] = g as u8;
            fb[o + 2] = b as u8;
            if (r > g + 100 && r > b + 100 && r > 150) {
                sumy = sumy + y;
                cnt = cnt + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    o_sumy.* = sumy;
    o_cnt.* = cnt;
}
fn do_video(mode:[]u8, outp:[]u8) i32 {
    let is_servo:i64 = 0;
    if (_zag_strcmp(mode, "vservo") == 1) { is_servo = 1; }
    let NF:i64 = 1800;
    let FS:i64 = 64 * 48 * 3;
    let ofd:i64 = f_open_w(outp);
    if (ofd < 0) { _zag_println("video out open failed"); return 2; }
    let cp:[]u8 = cen_path(outp, 121, 99, 101, 110, 116, 0);
    let cfd:i64 = f_open_w(cp);
    if (cfd < 0) { _zag_println("ycent open failed"); return 2; }
    let fb:[]u8 = z_alloc(FS);
    if (fb.len == 0) { _zag_println("frame alloc failed"); return 3; }
    let s:i64 = yplan_q16(0);
    let f:i64 = 0;
    while (f < NF) {
        let yp:i64 = yplan_q16(f);
        if (is_servo == 1) {
            s = (yp + s) / 2;
        } else {
            s = yp;
        }
        let sumy:i64 = 0;
        let cnt:i64 = 0;
        render_vframe(f, s, fb, &sumy, &cnt);
        let wrc:i64 = _zag_raw_syscall(18, ofd, _zag_slice_ptr(fb) as i64, FS, f * FS, 0, 0);
        if (wrc != FS) { _zag_println("frame write failed"); return 4; }
        let line:[]u8 = z_alloc(64);
        let p:i64 = 0;
        p = dec_app(line, p, f);
        line[p] = 32 as u8; p = p + 1;
        p = dec_app(line, p, sumy);
        line[p] = 32 as u8; p = p + 1;
        p = dec_app(line, p, cnt);
        line[p] = 10 as u8; p = p + 1;
        while (p < 64) { line[p] = 32 as u8; p = p + 1; }
        let w2:i64 = _zag_raw_syscall(18, cfd, _zag_slice_ptr(line) as i64, p, f * 64, 0, 0);
        if (w2 != p) { _zag_println("ycent write failed"); return 5; }
        z_free(line);
        f = f + 1;
    }
    z_free(fb);
    f_close(ofd);
    f_close(cfd);
    z_free(cp);
    return 0;
}

// ---- audio: boing events ----
fn build_tables(dec:[]u8, osc:[]u8) void {
    // dec[i] u16 LE: env/2 (q15; env=65536 does not fit u16), D=65517/sample
    let env:i64 = 65536;
    let i:i64 = 0;
    while (i <= 44100) {
        let e15:i64 = env / 2;
        dec[i * 2] = (e15 & 255) as u8;
        dec[i * 2 + 1] = ((e15 / 256) & 255) as u8;
        env = (env * 65517) / 65536;
        i = i + 1;
    }
    // osc[i] i16 LE: cos(2*pi*180*i/44100) q15, one period 245 samples
    let C:i64 = 1073388744;
    let S:i64 = 27533793;
    let c:i64 = 1073741824;
    let s:i64 = 0;
    let j:i64 = 0;
    while (j < 245) {
        let q:i64 = c / 32768;
        if (q > 32767) { q = 32767; }
        if (q < -32768) { q = -32768; }
        if (q < 0) { q = q + 65536; }
        osc[j * 2] = (q & 255) as u8;
        osc[j * 2 + 1] = ((q / 256) & 255) as u8;
        let cn:i64 = (c * C - s * S) / 1073741824;
        let sn:i64 = (s * C + c * S) / 1073741824;
        c = cn;
        s = sn;
        j = j + 1;
    }
}
fn dec_get(dec:[]u8, i:i64) i64 {
    return (dec[i * 2] as i64) + (dec[i * 2 + 1] as i64) * 256;
}
fn osc_get(osc:[]u8, i:i64) i64 {
    let v:i64 = (osc[i * 2] as i64) + (osc[i * 2 + 1] as i64) * 256;
    if (v >= 32768) { v = v - 65536; }
    return v;
}
// event start samples: t=0.5+k for k=0..29 ; nearedge adds t=5.01
fn ev_n0(k:i64, nearedge:i64) i64 {
    if (nearedge == 1 && k == 30) { return 220941; }
    return 22050 + 44100 * k;
}
fn ev_count(nearedge:i64) i64 {
    if (nearedge == 1) { return 31; }
    return 30;
}
// sign-correct i64 LE get/put on []u8 arena (no negative-% or &-on-negative reliance)
fn le_put_i64(a:[]u8, off:i64, v:i64) void {
    let b:i64 = 0;
    while (b < 8) {
        let by:i64 = v % 256;
        if (by < 0) { by = by + 256; }
        a[off + b] = by as u8;
        v = (v - by) / 256;
        b = b + 1;
    }
}
fn le_get_i64(a:[]u8, off:i64) i64 {
    let v:i64 = 0;
    let p:i64 = 1;
    let b:i64 = 0;
    while (b < 7) {
        v = v + (a[off + b] as i64) * p;
        p = p * 256;
        b = b + 1;
    }
    let top:i64 = a[off + 7] as i64;
    if (top >= 128) { top = top - 256; }
    v = v + top * p;
    return v;
}

// apar: closed-form pure function of (plan, n)
fn do_apar(outp:[]u8, nearedge:i64, dec:[]u8, osc:[]u8) i32 {
    let NS:i64 = 1323000;
    let AMP:i64 = 16000;
    let ofd:i64 = f_open_w(outp);
    if (ofd < 0) { _zag_println("audio out open failed"); return 2; }
    let BS:i64 = 44100;
    let blk:[]u8 = z_alloc(BS * 2);
    if (blk.len == 0) { _zag_println("ablk alloc failed"); return 3; }
    let nek:i64 = ev_count(nearedge);
    let n:i64 = 0;
    while (n < NS) {
        let bi:i64 = 0;
        while (bi < BS && n + bi < NS) {
            let nn:i64 = n + bi;
            let acc:i64 = 0;
            let k:i64 = 0;
            while (k < nek) {
                let n0:i64 = ev_n0(k, nearedge);
                if (nn >= n0) {
                    let age:i64 = nn - n0;
                    if (age <= 44100) {
                        acc = acc + (dec_get(dec, age) * osc_get(osc, age % 245) * AMP) / 1073741824;
                    }
                }
                k = k + 1;
            }
            if (acc > 32767) { acc = 32767; }
            if (acc < -32768) { acc = -32768; }
            if (acc < 0) { acc = acc + 65536; }
            blk[bi * 2] = (acc & 255) as u8;
            blk[bi * 2 + 1] = ((acc / 256) & 255) as u8;
            bi = bi + 1;
        }
        let wrc:i64 = f_write_all(ofd, blk);
        if (wrc != 0) { _zag_println("audio write failed"); return 4; }
        n = n + BS;
    }
    z_free(blk);
    f_close(ofd);
    return 0;
}
// baudio: B-style 5 s regions; carried (env,cos,sin) per event; wiped at boundaries
fn do_baudio(outp:[]u8, nearedge:i64) i32 {
    let NS:i64 = 1323000;
    let AMP:i64 = 16000;
    let REG:i64 = 220500;
    let C:i64 = 1073388744;
    let S:i64 = 27533793;
    let ofd:i64 = f_open_w(outp);
    if (ofd < 0) { _zag_println("audio out open failed"); return 2; }
    let BS:i64 = 44100;
    let blk:[]u8 = z_alloc(BS * 2);
    if (blk.len == 0) { _zag_println("ablk alloc failed"); return 3; }
    // slot arena: 4 slots x (active u8 @0, n0 i64 @8, env i64 @16, c i64 @24, s i64 @32)
    let slots:[]u8 = z_alloc(4 * 40);
    if (slots.len == 0) { _zag_println("slots alloc failed"); return 3; }
    let nek:i64 = ev_count(nearedge);
    // i64 LE helpers are inline below
    let n:i64 = 0;
    while (n < NS) {
        if (n > 0 && n % REG == 0) {
            // region boundary: wipe ALL carried state (plan reseed follows)
            let q:i64 = 0;
            while (q < 160) { slots[q] = 0 as u8; q = q + 1; }
        }
        let bi:i64 = 0;
        while (bi < BS && n + bi < NS) {
            let nn:i64 = n + bi;
            // seed events starting exactly now
            let k:i64 = 0;
            while (k < nek) {
                if (ev_n0(k, nearedge) == nn) {
                    // find free slot
                    let sl:i64 = 0;
                    while (sl < 4) {
                        if (slots[sl * 40] == 0) {
                            slots[sl * 40] = 1 as u8;
                            le_put_i64(slots, sl * 40 + 8, nn);
                            le_put_i64(slots, sl * 40 + 16, 65536);
                            le_put_i64(slots, sl * 40 + 24, 1073741824);
                            le_put_i64(slots, sl * 40 + 32, 0);
                            sl = 99;
                        }
                        sl = sl + 1;
                    }
                }
                k = k + 1;
            }
            let acc:i64 = 0;
            let sl2:i64 = 0;
            while (sl2 < 4) {
                if (slots[sl2 * 40] == 1) {
                    let n0:i64 = le_get_i64(slots, sl2 * 40 + 8);
                    let env:i64 = le_get_i64(slots, sl2 * 40 + 16);
                    let cc:i64 = le_get_i64(slots, sl2 * 40 + 24);
                    let ss:i64 = le_get_i64(slots, sl2 * 40 + 32);
                    let age:i64 = nn - n0;
                    if (age > 44100) {
                        slots[sl2 * 40] = 0 as u8;
                    } else {
                        let cq:i64 = cc / 32768;
                        if (cq > 32767) { cq = 32767; }
                        acc = acc + ((env / 2) * cq * AMP) / 1073741824;
                        // advance state
                        env = (env * 65517) / 65536;
                        let cn2:i64 = (cc * C - ss * S) / 1073741824;
                        let sn2:i64 = (ss * C + cc * S) / 1073741824;
                        le_put_i64(slots, sl2 * 40 + 16, env);
                        le_put_i64(slots, sl2 * 40 + 24, cn2);
                        le_put_i64(slots, sl2 * 40 + 32, sn2);
                    }
                }
                sl2 = sl2 + 1;
            }
            if (acc > 32767) { acc = 32767; }
            if (acc < -32768) { acc = -32768; }
            if (acc < 0) { acc = acc + 65536; }
            blk[bi * 2] = (acc & 255) as u8;
            blk[bi * 2 + 1] = ((acc / 256) & 255) as u8;
            bi = bi + 1;
        }
        let wrc:i64 = f_write_all(ofd, blk);
        if (wrc != 0) { _zag_println("audio write failed"); return 4; }
        n = n + BS;
    }
    z_free(slots);
    z_free(blk);
    f_close(ofd);
    return 0;
}

fn main() i32 {
    let what:[]u8 = _zag_arg(1);
    let mode:[]u8 = _zag_arg(2);
    let outp:[]u8 = _zag_arg(3);
    let variant:[]u8 = _zag_arg(4);
    if (what.len == 0 || mode.len == 0 || outp.len == 0) {
        _zag_println("usage: syncav <video|audio> <vpar|vservo|apar|baudio> <out> [seq|nearedge]");
        return 1;
    }
    let nearedge:i64 = 0;
    if (_zag_strcmp(variant, "nearedge") == 1) { nearedge = 1; }
    if (_zag_strcmp(what, "video") == 1) {
        let rc:i32 = do_video(mode, outp);
        _zag_print("syncav video frames 1800\n");
        return rc;
    }
    if (_zag_strcmp(what, "audio") == 1) {
        let dec:[]u8 = z_alloc(88202);
        let osc:[]u8 = z_alloc(490);
        if (dec.len == 0 || osc.len == 0) { _zag_println("table alloc failed"); return 3; }
        build_tables(dec, osc);
        let rc2:i32 = 0;
        if (_zag_strcmp(mode, "apar") == 1) {
            rc2 = do_apar(outp, nearedge, dec, osc);
        } else {
            rc2 = do_baudio(outp, nearedge);
        }
        z_free(dec);
        z_free(osc);
        _zag_print("syncav audio samples 1323000\n");
        return rc2;
    }
    _zag_println("unknown what");
    return 1;
}

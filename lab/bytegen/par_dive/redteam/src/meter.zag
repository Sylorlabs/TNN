// meter.zag — pure-Zag redteam meter for .s32 (int32 LE) mix files.
// modes:
//   blocks  CLEAN TEST            per-1024-block diff report
//   postcut CLEAN TEST CUT        RT-CASCADE: diffs with idx<CUT vs idx>=CUT
//   zcr     FILE W0 W1            ZCR pitch estimate over [W0,W1)
//   peak    FILE                  global peak |x|, dc mean, rms
// Pinned znc, zero RNG, deterministic.
fn cstr(s:[]u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let p:*u8 = _zag_malloc((s.len + 1) as i64) as *u8;
    if (p == null as *u8) { return ""; }
    let b:[]u8 = p[0..(s.len + 1)];
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn fread(path:[]u8, cap:i64) []u8 {
    let cs:[]u8 = cstr(path);
    if (cs.len == 0) { return ""; }
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 0, 0, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd < 0) { return ""; }
    let p:*u8 = _zag_malloc(cap) as *u8;
    if (p == null as *u8) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); return ""; }
    let at:i64 = 0;
    while (at < cap) {
        let n:i64 = _zag_raw_syscall(0, fd, (p as i64) + at, cap - at, 0, 0, 0);
        if (n == -4) { continue; }
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return p[0..at];
}
fn g32(b:[]u8, i:i64) i64 {
    return (b[i] as i64) | ((b[i+1] as i64) << 8) | ((b[i+2] as i64) << 16) | ((b[i+3] as i64) << 24);
}
// sign-extending variant: the raw mix holds signed int32 samples
fn g32s(b:[]u8, i:i64) i64 {
    let v:i64 = g32(b, i);
    if (v >= 2147483648) { v = v - 4294967296; }
    return v;
}
fn pout(s:[]u8) void {
    _zag_raw_syscall(1, 1, (_zag_slice_ptr(s) as i64), (s.len as i64), 0, 0, 0);
}
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if (s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
fn absi(v:i64) i64 { if (v < 0) { return 0 - v; } return v; }
fn atoi(s:[]u8) i64 {
    let neg:i64 = 1;
    let v:i64 = 0;
    let i:i64 = 0;
    if (s.len > 0 && s[0] == 45) { neg = -1; i = 1; }
    while (i < s.len) {
        if (s[i] >= 48 && s[i] <= 57) { v = v * 10 + ((s[i] - 48) as i64); }
        i = i + 1;
    }
    return neg * v;
}
fn str_eq(a:[]u8, b:[]u8) i64 {
    if (a.len != b.len) { return 0; }
    let i:i64 = 0;
    while (i < a.len as i64) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    return 1;
}

fn do_blocks(a:[]u8, b:[]u8) void {
    let n:i64 = (a.len as i64) / 4;
    let m:i64 = (b.len as i64) / 4;
    if (m < n) { n = m; }
    let blk:i64 = 1024;
    let nblocks:i64 = (n + blk - 1) / blk;
    let totdiff:i64 = 0;
    let blkdiff:i64 = 0;
    let firstd:i64 = -1;
    let lastd:i64 = -1;
    let maxbd:i64 = 0;
    let maxb:i64 = -1;
    let pk_a:i64 = 0;
    let pk_b:i64 = 0;
    let k:i64 = 0;
    while (k < nblocks) {
        let s0:i64 = k * blk;
        let s1:i64 = s0 + blk;
        if (s1 > n) { s1 = n; }
        let bd:i64 = 0;
        let mxd:i64 = 0;
        let t:i64 = s0;
        while (t < s1) {
            let va:i64 = g32s(a, t * 4);
            let vb:i64 = g32s(b, t * 4);
            let pa:i64 = absi(va);
            let pb:i64 = absi(vb);
            if (pa > pk_a) { pk_a = pa; }
            if (pb > pk_b) { pk_b = pb; }
            if (va != vb) {
                bd = bd + 1;
                let d:i64 = absi(va - vb);
                if (d > mxd) { mxd = d; }
            }
            t = t + 1;
        }
        if (bd > 0) {
            blkdiff = blkdiff + 1;
            if (firstd < 0) { firstd = k; }
            lastd = k;
            if (bd > maxbd) { maxbd = bd; maxb = k; }
            pout("BLK ");
            pout(i64s(k));
            pout(" ndiff=");
            pout(i64s(bd));
            pout(" maxdiff=");
            pout(i64s(mxd));
            pout("\n");
        }
        totdiff = totdiff + bd;
        k = k + 1;
    }
    pout("METER samples=");
    pout(i64s(n));
    pout(" blocks=");
    pout(i64s(nblocks));
    pout(" totaldiff=");
    pout(i64s(totdiff));
    pout(" diffblocks=");
    pout(i64s(blkdiff));
    pout(" first=");
    pout(i64s(firstd));
    pout(" last=");
    pout(i64s(lastd));
    pout(" maxblk=");
    pout(i64s(maxb));
    pout(" maxblkdiff=");
    pout(i64s(maxbd));
    pout(" peakA=");
    pout(i64s(pk_a));
    pout(" peakB=");
    pout(i64s(pk_b));
    pout("\n");
}

fn do_postcut(a:[]u8, b:[]u8, cut:i64) void {
    let n:i64 = (a.len as i64) / 4;
    let m:i64 = (b.len as i64) / 4;
    if (m < n) { n = m; }
    let pre:i64 = 0;
    let post:i64 = 0;
    let firstpost:i64 = -1;
    let lastpost:i64 = -1;
    let t:i64 = 0;
    while (t < n) {
        if (g32(a, t * 4) != g32(b, t * 4)) {
            if (t < cut) { pre = pre + 1; } else {
                post = post + 1;
                if (firstpost < 0) { firstpost = t; }
                lastpost = t;
            }
        }
        t = t + 1;
    }
    pout("POSTCUT cut=");
    pout(i64s(cut));
    pout(" prediff=");
    pout(i64s(pre));
    pout(" postdiff=");
    pout(i64s(post));
    pout(" firstpost=");
    pout(i64s(firstpost));
    pout(" lastpost=");
    pout(i64s(lastpost));
    pout("\n");
}

fn do_zcr(a:[]u8, w0:i64, w1:i64) void {
    let n:i64 = (a.len as i64) / 4;
    if (w0 < 0) { w0 = 0; }
    if (w1 > n) { w1 = n; }
    let zc:i64 = 0;
    let prev:i64 = g32s(a, w0 * 4);
    let t:i64 = w0 + 1;
    while (t < w1) {
        let v:i64 = g32s(a, t * 4);
        if ((prev < 0 && v >= 0) || (prev >= 0 && v < 0)) { zc = zc + 1; }
        prev = v;
        t = t + 1;
    }
    let span:i64 = w1 - w0;
    // Hz = zc * 44100 / (2 * span), integer math
    let hz:i64 = 0;
    if (span > 0) { hz = (zc * 44100) / (2 * span); }
    pout("ZCR w0=");
    pout(i64s(w0));
    pout(" w1=");
    pout(i64s(w1));
    pout(" crossings=");
    pout(i64s(zc));
    pout(" hz~");
    pout(i64s(hz));
    pout("\n");
}

fn do_peak(a:[]u8) void {    let n:i64 = (a.len as i64) / 4;
    let pk:i64 = 0;
    let sum:i64 = 0;
    let t:i64 = 0;
    while (t < n) {
        let v:i64 = g32s(a, t * 4);
        let pa:i64 = absi(v);
        if (pa > pk) { pk = pa; }
        sum = sum + v / 1024;
        t = t + 1;
    }
    pout("PEAK samples=");
    pout(i64s(n));
    pout(" peak=");
    pout(i64s(pk));
    pout(" dcmean_q10~");
    pout(i64s((sum * 1024) / n));
    pout("\n");
}

// conv64: B-format i64 LE samples -> int32 LE (saturating), for the meter.
fn do_conv64(a:[]u8, outp:[]u8) void {
    let n:i64 = (a.len as i64) / 8;
    let p:*u8 = _zag_malloc((n * 4) as i64) as *u8;
    if (p == null as *u8) { pout("CONV malloc fail\n"); return; }
    let o:[]u8 = p[0..(n * 4)];
    let t:i64 = 0;
    while (t < n) {
        let v:i64 = g32s(a, t * 8);
        if (v > 2147483647) { v = 2147483647; }
        if (v < -2147483648) { v = -2147483648; }
        if (v < 0) { v = v + 4294967296; }
        o[t * 4] = (v & 255) as u8;
        o[t * 4 + 1] = ((v >> 8) & 255) as u8;
        o[t * 4 + 2] = ((v >> 16) & 255) as u8;
        o[t * 4 + 3] = ((v >> 24) & 255) as u8;
        t = t + 1;
    }
    let cs:[]u8 = cstr(outp);
    let fd:i64 = _zag_raw_syscall(2, (_zag_slice_ptr(cs) as i64), 577, 438, 0, 0, 0);
    _zag_free(_zag_slice_ptr(cs));
    if (fd >= 0) {
        let at:i64 = 0;
        let bl:i64 = o.len as i64;
        while (at < bl) {
            let w:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(o) as i64) + at, bl - at, 0, 0, 0);
            if (w == -4) { continue; }
            if (w <= 0) { break; }
            at = at + w;
        }
        _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    }
    pout("CONV64 samples=");
    pout(i64s(n));
    pout("\n");
}

fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    if (str_eq(mode, "blocks")) {
        let a:[]u8 = fread(_zag_arg(2), 8000000);
        let b:[]u8 = fread(_zag_arg(3), 8000000);
        if (a.len == 0 || b.len == 0) { pout("METER read fail\n"); return 2; }
        do_blocks(a, b);
        return 0;
    }
    if (str_eq(mode, "postcut")) {
        let a:[]u8 = fread(_zag_arg(2), 8000000);
        let b:[]u8 = fread(_zag_arg(3), 8000000);
        if (a.len == 0 || b.len == 0) { pout("METER read fail\n"); return 2; }
        do_postcut(a, b, atoi(_zag_arg(4)));
        return 0;
    }
    if (str_eq(mode, "zcr")) {
        let a:[]u8 = fread(_zag_arg(2), 8000000);
        if (a.len == 0) { pout("METER read fail\n"); return 2; }
        do_zcr(a, atoi(_zag_arg(3)), atoi(_zag_arg(4)));
        return 0;
    }
    if (str_eq(mode, "peak")) {
        let a:[]u8 = fread(_zag_arg(2), 8000000);
        if (a.len == 0) { pout("METER read fail\n"); return 2; }
        do_peak(a);
        return 0;
    }
    if (str_eq(mode, "conv64")) {
        let a:[]u8 = fread(_zag_arg(2), 12000000);
        if (a.len == 0) { pout("METER read fail\n"); return 2; }
        do_conv64(a, _zag_arg(3));
        return 0;
    }
    pout("usage: meter blocks|postcut|zcr|peak ...\n");
    return 1;
}

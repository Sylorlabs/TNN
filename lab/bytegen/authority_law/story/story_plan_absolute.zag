// story_plan_absolute.zag
// TNN authority law, story path: PLAN ABSOLUTE. The renderer has no eyes.
// Micah APPROVED option B (2026-09-24). Per-path verdict: story FAILS — the
// rendered text carries strictly less information than the plan (the renderer
// is a pure function), so there is no information gap for a sensor to fill;
// a story sensor would be theater or fabrication.
//
// The recommended rule, instantiated:
//  1. Generative authority: the beat sheet (beat/beat_n/seq_* + class tables
//     + tv + P/L + plan annotations) is the sole authority over every rendered
//     byte. Renderer = pure function of the plan. No carried output state,
//     no output-conditioned branching. Cohesion improvements enter only as
//     beat-sheet annotations (planned, audited), never sensed.
//  2. Exception authority (Piece-2-shaped): a stateless detector reads rendered
//     beats against plan-derived expectations (anchor presence per beat,
//     closing-line presence). On fault it re-renders the affected beat(s)
//     plan-pure. Correction bytes in {plan-pure}; constant map, idempotent;
//     false positives are no-ops.
//  3. Plan-event authority (deliberation-gated): thread audits and external
//     edits may amend the plan as discrete deliberated plan events, recorded
//     in the plan audit trail (seq_r r=4 AUDIT_REPAIR, r=5 EXTERNAL_EDIT).
//     The renderer never sees the event; it sees the amended plan.
//  4. Banned (G): beat n as a function of rendered bytes 0..n-1,
//     output-conditioned template choice, sensor->plan writes from the
//     renderer's own output. The renderer registry's input masks structurally
//     exclude PORT_RENDERED; the gate refuses any such registration.
//
// Pure Zag, deterministic, zero RNG. Byte-identical reruns (SHA-256).
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- byte utils ----------------
fn p32(b:[]u8,at:i32,v:i64)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn g32(b:[]u8,at:i32)i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24;
}
fn beq(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al!=bl){return 0;}
    let i:i32=0;
    while(i<al){ if(a[ao+i]!=b[bo+i]){return 0;} i=i+1; }
    return 1;
}
fn copy_bytes(dst:[]u8,do:i32,src:[]u8,so:i32,n:i32)void {
    let i:i32=0;
    while(i<n){ dst[do+i]=src[so+i]; i=i+1; }
    return;
}
fn app(buf:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){ buf[pos+i]=s[i]; i=i+1; }
    return pos+s.len;
}
fn app_w(buf:[]u8,pos:i32,wb:[]u8,wo:i32,wl:i32)i32 {
    let i:i32=0;
    while(i<wl){ buf[pos+i]=wb[wo+i]; i=i+1; }
    return pos+wl;
}
fn is_vowel(c:u8)i32 {
    if(c==97){return 1;} if(c==101){return 1;} if(c==105){return 1;}
    if(c==111){return 1;} if(c==117){return 1;}
    return 0;
}
fn app_art(buf:[]u8,pos:i32,wb:[]u8,wo:i32)i32 {
    if(is_vowel(wb[wo])==1){ return app(buf,pos,"an "); }
    return app(buf,pos,"a ");
}
fn pr(s:[]u8)void { _zag_print(s); return; }
fn prl(s:[]u8)void { _zag_println(s); return; }
fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){ return s[0..s.len-1]; }
    return s;
}
fn sha_hex(data:[]u8,dl:i32)[]u8 {
    let d:[]u8=nio_alloc(32);
    let rc:i32=ns_sha256(data[0..dl],d);
    if(rc!=0){ nio_free(d); return "SHAFAIL"; }
    let h:[]u8=ns_hex(d);
    nio_free(d);
    return h;
}
fn find_sub(hay:[]u8,hl:i32,ndl:[]u8) i32 {
    if(ndl.len>hl){ return -1; }
    let i:i32=0;
    while(i<=hl-ndl.len){
        if(beq(hay,i,ndl.len,ndl,0,ndl.len)==1){ return i; }
        i=i+1;
    }
    return -1;
}

// ---------------- word set + classes (plan inputs, embedded) ----------------
fn parse_words(data:[]u8,swb:[]u8,swoff:[]u8,swlen:[]u8)i32 {
    let nw:i32=0; let wp:i32=0; let p:i32=0;
    while(p<data.len){
        let ws:i32=p;
        while(p<data.len && data[p]!=44){ p=p+1; }
        let wl:i32=p-ws;
        if(p<data.len){ p=p+1; }
        if(wl>0){
            copy_bytes(swb,wp,data,ws,wl);
            p32(swoff,nw*4,wp as i64); p32(swlen,nw*4,wl as i64);
            wp=wp+wl; nw=nw+1;
        }
    }
    return nw;
}
fn parse_cls(data:[]u8,swcls:[]u8,nw:i32)void {
    let p:i32=0; let wi:i32=0;
    while(p<data.len && wi<nw){
        let ws:i32=p;
        while(p<data.len && data[p]!=44){ p=p+1; }
        let le:i32=p;
        if(p<data.len){ p=p+1; }
        let c:i32=ws;
        while(c<le && data[c]!=58){ c=c+1; }
        let cs:i32=c+1; let cl:i32=le-cs;
        let cid:i32=2;
        if(beq(data,cs,cl,"PERSON",0,6)==1){ cid=0; }
        if(beq(data,cs,cl,"PLACE",0,5)==1){ cid=1; }
        if(beq(data,cs,cl,"EVENT",0,5)==1){ cid=3; }
        if(beq(data,cs,cl,"ABSTRACT",0,8)==1){ cid=4; }
        p32(swcls,wi*4,cid as i64);
        wi=wi+1;
    }
    return;
}

// ---------------- planning (beat sheet) ----------------
fn do_assign(wi:i32,b:i32,r:i32,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,sn:i32,assigned:[]u8)i32 {
    let bn:i32=g32(beat_n,b*4) as i32;
    p32(beat,(b*12+bn)*4,wi as i64);
    p32(beat_n,b*4,(bn+1) as i64);
    p32(seq_w,sn*4,wi as i64); p32(seq_b,sn*4,b as i64); p32(seq_r,sn*4,r as i64);
    assigned[wi]=1;
    return sn+1;
}
fn first_match(swcls:[]u8,nw:i32,assigned:[]u8,pred:i32)i32 {
    let i:i32=0;
    while(i<nw){
        if(assigned[i]==0){
            let c:i32=g32(swcls,i*4) as i32;
            let ok:i32=0;
            if(pred==0){ ok=1; }
            if(pred==1 && c==0){ ok=1; }
            if(pred==2 && c==1){ ok=1; }
            if(pred==3 && c==2){ ok=1; }
            if(pred==4 && c==3){ ok=1; }
            if(pred==5 && c==4){ ok=1; }
            if(pred==6 && (c==2 || c==0)){ ok=1; }
            if(pred==7 && (c==3 || c==4 || c==0)){ ok=1; }
            if(ok==1){ return i; }
        }
        i=i+1;
    }
    return -1;
}
fn plan_del(swcls:[]u8,nw:i32,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,assigned:[]u8)i32 {
    let b:i32=0;
    while(b<4){ p32(beat_n,b*4,0); b=b+1; }
    let i:i32=0;
    while(i<12){ assigned[i]=0; i=i+1; }
    let sn:i32=0;
    let wi:i32=0; let r:i32=0;
    wi=first_match(swcls,nw,assigned,1);
    r=0;
    if(wi<0){ wi=first_match(swcls,nw,assigned,0); r=1; }
    sn=do_assign(wi,0,r,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned);
    wi=first_match(swcls,nw,assigned,2);
    if(wi>=0){ sn=do_assign(wi,0,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,3);
    if(wi>=0){ sn=do_assign(wi,0,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,4);
    if(wi>=0){ sn=do_assign(wi,1,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,6);
    if(wi>=0){ sn=do_assign(wi,1,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,7);
    r=0;
    if(wi<0){ wi=first_match(swcls,nw,assigned,0); r=1; }
    if(wi>=0){ sn=do_assign(wi,2,r,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,3);
    if(wi>=0){ sn=do_assign(wi,2,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    wi=first_match(swcls,nw,assigned,5);
    if(wi>=0){ sn=do_assign(wi,3,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
    let j:i32=0;
    while(j<nw){
        if(assigned[j]==0){ sn=do_assign(j,3,0,beat,beat_n,seq_w,seq_b,seq_r,sn,assigned); }
        j=j+1;
    }
    let pass:i32=0;
    let need:i32=1;
    while(pass<2 && need==1){
        need=0;
        let eb:i32=-1;
        b=0;
        while(b<4){
            if(eb<0 && (g32(beat_n,b*4) as i32)==0){ eb=b; }
            b=b+1;
        }
        if(eb>=0){
            let fb:i32=-1; let fmax:i32=-1;
            b=0;
            while(b<4){
                if(b!=eb){
                    let c2:i32=g32(beat_n,b*4) as i32;
                    if(c2>fmax){ fmax=c2; fb=b; }
                }
                b=b+1;
            }
            if(fb>=0 && fmax>0){
                let k2:i32=sn-1; let mw:i32=-1; let found:i32=0;
                while(k2>=0 && found==0){
                    if((g32(seq_b,k2*4) as i32)==fb){ mw=g32(seq_w,k2*4) as i32; found=1; }
                    k2=k2-1;
                }
                if(mw>=0){
                    let bn2:i32=g32(beat_n,fb*4) as i32;
                    let s2:i32=0; let d:i32=0; let skipped:i32=0;
                    while(s2<bn2){
                        let vv:i32=g32(beat,(fb*12+s2)*4) as i32;
                        if(vv==mw && skipped==0){ skipped=1; }
                        else{ p32(beat,(fb*12+d)*4,vv as i64); d=d+1; }
                        s2=s2+1;
                    }
                    p32(beat_n,fb*4,d as i64);
                    let en:i32=g32(beat_n,eb*4) as i32;
                    p32(beat,(eb*12+en)*4,mw as i64);
                    p32(beat_n,eb*4,(en+1) as i64);
                    p32(seq_w,sn*4,mw as i64); p32(seq_b,sn*4,eb as i64); p32(seq_r,sn*4,2 as i64);
                    sn=sn+1;
                    need=1;
                }
            }
        }
        pass=pass+1;
    }
    return sn;
}
fn rule_name(r:i32)[]u8 {
    if(r==0){ return "CLASS_SLOT"; }
    if(r==1){ return "FALLBACK_ORDER"; }
    if(r==2){ return "REPAIR_SPILL"; }
    if(r==4){ return "AUDIT_REPAIR"; }
    if(r==5){ return "EXTERNAL_EDIT"; }
    return "POSITIONAL";
}
// ---------------- rendering: pure functions of the plan ----------------
// No carried output state. No rendered-byte input exists anywhere in these
// signatures: beat n is a function of (beat tables, class tables, tv, P/L,
// plan annotations) only.
fn detail(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,wi:i32,dk:i32)i32 {
    let c:i32=g32(swcls,wi*4) as i32;
    let v:i32=dk%2;
    let wo:i32=g32(swoff,wi*4) as i32;
    let wl:i32=g32(swlen,wi*4) as i32;
    spos=app(st,spos,"The ");
    spos=app_w(st,spos,swb,wo,wl);
    if(c==2){ if(v==0){ spos=app(st,spos," waited quietly."); } else { spos=app(st,spos," watched it all."); } }
    if(c==0){ if(v==0){ spos=app(st,spos," said nothing."); } else { spos=app(st,spos," watched it all."); } }
    if(c==1){ if(v==0){ spos=app(st,spos," stood silent."); } else { spos=app(st,spos," remembered everything."); } }
    if(c==3){ if(v==0){ spos=app(st,spos," raged on."); } else { spos=app(st,spos," slowly faded."); } }
    if(c==4){ if(v==0){ spos=app(st,spos," hung in the air."); } else { spos=app(st,spos," lingered."); } }
    spos=app(st,spos,"\n");
    return spos;
}
fn ww_emit(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,wi:i32)i32 {
    return app_w(st,spos,swb,g32(swoff,wi*4) as i32,g32(swlen,wi*4) as i32);
}
fn r_setup(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32,P:i32,L:i32)i32 {
    let n0:i32=g32(beat_n,0) as i32;
    let T:i32=-1; let k:i32=0;
    while(k<n0){
        let wi:i32=g32(beat,(0*12+k)*4) as i32;
        if(wi!=P && wi!=L && (g32(swcls,wi*4) as i32)==2 && T<0){ T=wi; }
        k=k+1;
    }
    if(tv==0){
        spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P);
        if(L>=0){ spos=app(st,spos," lived near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); spos=app(st,spos,"."); }
        else { spos=app(st,spos," lived alone."); }
    } else {
        if(L>=0){ spos=app(st,spos,"Near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); spos=app(st,spos,", the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept a small house."); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," had no home to speak of."); }
    }
    spos=app(st,spos,"\n");
    if(T>=0){
        if(tv==0){ spos=app(st,spos,"Every morning the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," polished the "); spos=ww_emit(st,spos,swb,swoff,swlen,T); spos=app(st,spos,"."); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," treasured the "); spos=ww_emit(st,spos,swb,swoff,swlen,T); spos=app(st,spos," above all else."); }
        spos=app(st,spos,"\n");
    }
    k=0;
    let dk:i32=0;
    while(k<n0){
        let wi2:i32=g32(beat,(0*12+k)*4) as i32;
        if(wi2!=P && wi2!=L && wi2!=T){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi2,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// first PERSON word index in the set (plan-side), or -1
fn first_person(swcls:[]u8,nw:i32)i32 {
    let i:i32=0;
    while(i<nw){
        if((g32(swcls,i*4) as i32)==0){ return i; }
        i=i+1;
    }
    return -1;
}
// ann: plan annotations (4 bytes). ann[1]==1 -> deliberated "affects-protagonist"
// annotation on beat 1, entered as a plan event (r=5), rendered plan-pure.
// Cohesion improvements enter only this way: planned, audited, never sensed.
fn r_compl(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32,ann:[]u8,nw:i32)i32 {
    let n1:i32=g32(beat_n,4) as i32;
    let E:i32=-1; let V:i32=-1; let k:i32=0;
    while(k<n1){
        let wi:i32=g32(beat,(1*12+k)*4) as i32;
        let c:i32=g32(swcls,wi*4) as i32;
        if(c==3 && E<0){ E=wi; }
        if((c==2 || c==0) && wi!=E && V<0){ V=wi; }
        k=k+1;
    }
    if(tv==0){
        if(E>=0){ spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,E); spos=app(st,spos," struck without warning."); }
        else { spos=app(st,spos,"Then trouble came without warning."); }
    } else {
        if(E>=0){ spos=app(st,spos,"Without warning, the "); spos=ww_emit(st,spos,swb,swoff,swlen,E); spos=app(st,spos," arrived."); }
        else { spos=app(st,spos,"Without warning, trouble arrived."); }
    }
    spos=app(st,spos,"\n");
    if(ann[1]==1){
        let pp:i32=first_person(swcls,nw);
        if(pp>=0 && E>=0){
            spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,pp);
            spos=app(st,spos," feared the "); spos=ww_emit(st,spos,swb,swoff,swlen,E);
            spos=app(st,spos,".\n");
        }
    }
    if(V>=0){
        if(tv==0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,V); spos=app(st,spos," was caught in the chaos."); }
        else { spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,V); spos=app(st,spos," had nowhere to hide."); }
        spos=app(st,spos,"\n");
    }
    k=0;
    let dk:i32=0;
    while(k<n1){
        let wi2:i32=g32(beat,(1*12+k)*4) as i32;
        if(wi2!=E && wi2!=V){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi2,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
fn r_climax(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,P:i32)i32 {
    let n2:i32=g32(beat_n,8) as i32;
    let R:i32=-1; let O:i32=-1; let k:i32=0;
    while(k<n2){
        let wi:i32=g32(beat,(2*12+k)*4) as i32;
        let c:i32=g32(swcls,wi*4) as i32;
        if((c==3 || c==4 || c==0) && R<0){ R=wi; }
        k=k+1;
    }
    if(R<0 && n2>0){ R=g32(beat,(2*12+0)*4) as i32; }
    k=0;
    while(k<n2){
        let wi2:i32=g32(beat,(2*12+k)*4) as i32;
        if(wi2!=R && (g32(swcls,wi2*4) as i32)==2 && O<0){ O=wi2; }
        k=k+1;
    }
    let rc:i32=-1;
    if(R>=0){ rc=g32(swcls,R*4) as i32; }
    if(rc==3){
        spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos," returned, worse than before.\n");
        if(O>=0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," held the "); spos=ww_emit(st,spos,swb,swoff,swlen,O); spos=app(st,spos," tight.\n"); }
    } else {
        if(rc==4){
            spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P);
            if(O>=0){ spos=app(st,spos," faced the "); spos=ww_emit(st,spos,swb,swoff,swlen,O); spos=app(st,spos," and demanded "); }
            else { spos=app(st,spos," demanded "); }
            spos=app_art(st,spos,swb,g32(swoff,R*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos,".\n");
        } else {
            if(rc==0){
                spos=app(st,spos,"Then the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos," arrived, and everything changed.\n");
                if(O>=0){ spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," stared at the "); spos=ww_emit(st,spos,swb,swoff,swlen,O); spos=app(st,spos,".\n"); }
            } else {
                if(O>=0 && O!=R){
                    spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," stood alone against the "); spos=ww_emit(st,spos,swb,swoff,swlen,O);
                    if(rc==1){ spos=app(st,spos," in the "); } else { spos=app(st,spos,", clutching the "); }
                    spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos,".\n");
                }
                else {
                    spos=app(st,spos,"The "); spos=ww_emit(st,spos,swb,swoff,swlen,P);
                    if(rc==1){ spos=app(st,spos," stood alone in the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos,".\n"); }
                    else { spos=app(st,spos," clutched the "); spos=ww_emit(st,spos,swb,swoff,swlen,R); spos=app(st,spos," and stood alone.\n"); }
                }
            }
        }
    }
    k=0;
    let dk:i32=0;
    while(k<n2){
        let wi3:i32=g32(beat,(2*12+k)*4) as i32;
        if(wi3!=R && wi3!=O){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi3,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
fn r_resol(st:[]u8,spos:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32,P:i32,L:i32)i32 {
    let n3:i32=g32(beat_n,12) as i32;
    let H:i32=-1; let k:i32=0;
    while(k<n3){
        let wi:i32=g32(beat,(3*12+k)*4) as i32;
        if((g32(swcls,wi*4) as i32)==4 && H<0){ H=wi; }
        k=k+1;
    }
    if(H>=0){
        if(tv==0){
            spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," found "); spos=app_art(st,spos,swb,g32(swoff,H*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,H);
            if(L>=0){ spos=app(st,spos," at the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); }
            spos=app(st,spos,".");
        } else {
            spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," discovered "); spos=app_art(st,spos,swb,g32(swoff,H*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,H);
            if(L>=0){ spos=app(st,spos," near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); }
            spos=app(st,spos,".");
        }
    } else {
        if(tv==0){ spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept going."); }
        else { spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept going."); }
    }
    spos=app(st,spos,"\n");
    k=0;
    let dk:i32=0;
    while(k<n3){
        let wi2:i32=g32(beat,(3*12+k)*4) as i32;
        if(wi2!=H){ spos=detail(st,spos,swb,swoff,swlen,swcls,wi2,dk); dk=dk+1; }
        k=k+1;
    }
    return spos;
}
// plan-pure closing line of beat 3 (detector expectation; no rendered input)
fn r_close(st:[]u8,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32,P:i32,L:i32)i32 {
    let n3:i32=g32(beat_n,12) as i32;
    let H:i32=-1; let k:i32=0;
    while(k<n3){
        let wi:i32=g32(beat,(3*12+k)*4) as i32;
        if((g32(swcls,wi*4) as i32)==4 && H<0){ H=wi; }
        k=k+1;
    }
    let spos:i32=0;
    if(H>=0){
        if(tv==0){
            spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," found "); spos=app_art(st,spos,swb,g32(swoff,H*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,H);
            if(L>=0){ spos=app(st,spos," at the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); }
            spos=app(st,spos,".");
        } else {
            spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," discovered "); spos=app_art(st,spos,swb,g32(swoff,H*4) as i32); spos=ww_emit(st,spos,swb,swoff,swlen,H);
            if(L>=0){ spos=app(st,spos," near the "); spos=ww_emit(st,spos,swb,swoff,swlen,L); }
            spos=app(st,spos,".");
        }
    } else {
        if(tv==0){ spos=app(st,spos,"In the end, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept going."); }
        else { spos=app(st,spos,"At last, the "); spos=ww_emit(st,spos,swb,swoff,swlen,P); spos=app(st,spos," kept going."); }
    }
    spos=app(st,spos,"\n");
    return spos;
}
// ---------------- plan handle init ----------------
// po: 16 bytes: tv@0, P@4, L@8, nw@12. sn_o: 4 bytes (seq count).
fn init_plan(swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,ann:[]u8,sn_o:[]u8,po:[]u8)void {
    let words:[]u8="detective,lighthouse,key,thunderstorm,accordion,peace,harbor,captain,fog,whistle,lantern,memory";
    let cls:[]u8="detective:PERSON,lighthouse:PLACE,key:THING,thunderstorm:EVENT,accordion:THING,peace:ABSTRACT,harbor:PLACE,captain:PERSON,fog:EVENT,whistle:EVENT,lantern:THING,memory:ABSTRACT";
    let nw:i32=parse_words(words,swb,swoff,swlen);
    parse_cls(cls,swcls,nw);
    let assigned:[]u8=nio_alloc(12);
    let sn:i32=plan_del(swcls,nw,beat,beat_n,seq_w,seq_b,seq_r,assigned);
    nio_free(assigned);
    p32(sn_o,0,sn as i64);
    ann[0]=0; ann[1]=0; ann[2]=0; ann[3]=0;
    p32(po,0,1);
    let n0:i32=g32(beat_n,0) as i32;
    let P:i32=-1; let L:i32=-1; let k:i32=0;
    while(k<n0){
        let wi:i32=g32(beat,(0*12+k)*4) as i32;
        let c:i32=g32(swcls,wi*4) as i32;
        if(c==0 && P<0){ P=wi; }
        if(c==1 && L<0){ L=wi; }
        k=k+1;
    }
    if(P<0){ P=g32(beat,(0*12+0)*4) as i32; }
    p32(po,4,P as i64); p32(po,8,L as i64); p32(po,12,nw as i64);
    return;
}
// render one beat, plan-pure. No rendered-byte input exists in this signature.
fn render_beat(b:i32,buf:[]u8,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,ann:[]u8,tv:i32,P:i32,L:i32,nw:i32)i32 {
    if(b==0){ return r_setup(buf,0,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L); }
    if(b==1){ return r_compl(buf,0,swb,swoff,swlen,swcls,beat,beat_n,tv,ann,nw); }
    if(b==2){ return r_climax(buf,0,swb,swoff,swlen,swcls,beat,beat_n,P); }
    return r_resol(buf,0,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
}
// ---------------- stateless exception detector ----------------
// Reads rendered beats against PLAN-DERIVED expectations only:
// anchor presence per beat + closing-line presence (beat 3).
// Stateless: no carried state between beats or calls. Returns 1 on fault.
fn detect_beat(b:i32,buf:[]u8,blen:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,tv:i32,P:i32,L:i32)i32 {
    let wi:i32=g32(beat,(b*12+0)*4) as i32;
    let wo:i32=g32(swoff,wi*4) as i32;
    let wl:i32=g32(swlen,wi*4) as i32;
    if(find_sub(buf,blen,swb[wo..wo+wl])<0){ return 1; }
    if(b==3){
        let tmp:[]u8=nio_alloc(512);
        let cl:i32=r_close(tmp,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
        let hit:i32=find_sub(buf,blen,tmp[0..cl]);
        nio_free(tmp);
        if(hit<0){ return 1; }
    }
    return 0;
}
// plan-pure re-render of one beat. Correction map is constant in the faulty
// bytes: heal_beat(plan, b) reads only the plan; same output for any input
// corruption. Idempotent; false positives are no-ops (re-render of clean
// bytes yields identical bytes).
fn heal_beat(b:i32,buf:[]u8,blen_o:[]u8,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,ann:[]u8,tv:i32,P:i32,L:i32,nw:i32)i32 {
    let n:i32=render_beat(b,buf,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    p32(blen_o,0,n as i64);
    return n;
}
// ---------------- renderer registry + (G) gate ----------------
// PORT_PLAN=1, PORT_RENDERED=2. Every registered renderer has mask==PORT_PLAN.
fn gate_register(reg:[]u8,b:i32,mask:i32)i32 {
    if((mask&2)!=0){ return 1; }
    reg[b]=mask as u8;
    return 0;
}
// The (G) attempt: an attacker hands beat-n rendering the prior beat's
// rendered bytes, hoping they condition the next beat. There is no input
// port for them: the parameter is accepted and never read. The registry
// (checked by the probe) is the complete list of render entry points, and
// gate_register refuses any PORT_RENDERED registration.
fn attempt_g_wire(b:i32,prior:[]u8,plen:i32,buf:[]u8,swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,ann:[]u8,tv:i32,P:i32,L:i32,nw:i32)i32 {
    let n:i32=render_beat(b,buf,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    return n;
}
// ---------------- plan events (deliberation-gated) ----------------
// External edits and thread audits amend the PLAN as discrete events.
// The renderer never sees the event; it sees the amended plan.
// r=5 EXTERNAL_EDIT. Deliberation gate: unknown codes refused.
fn apply_external_edit(ann:[]u8,seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,sn_o:[]u8,code:i32)i32 {
    if(code!=1){ return 1; }
    ann[1]=1;
    let sn:i32=g32(sn_o,0) as i32;
    p32(seq_w,sn*4,-1); p32(seq_b,sn*4,1); p32(seq_r,sn*4,5);
    p32(sn_o,0,(sn+1) as i64);
    return 0;
}
// r=4 AUDIT_REPAIR: the (D)-layer thread audit reads the rendered text,
// finds the dropped thread anchor, and logs a plan event; the cure is
// plan-pure re-render.
fn o_anchor(beat:[]u8,beat_n:[]u8,swcls:[]u8)i32 {
    let n2:i32=g32(beat_n,8) as i32;
    let R:i32=-1; let O:i32=-1; let k:i32=0;
    while(k<n2){
        let wi:i32=g32(beat,(2*12+k)*4) as i32;
        let c:i32=g32(swcls,wi*4) as i32;
        if((c==3 || c==4 || c==0) && R<0){ R=wi; }
        k=k+1;
    }
    if(R<0 && n2>0){ R=g32(beat,(2*12+0)*4) as i32; }
    k=0;
    while(k<n2){
        let wi2:i32=g32(beat,(2*12+k)*4) as i32;
        if(wi2!=R && (g32(swcls,wi2*4) as i32)==2 && O<0){ O=wi2; }
        k=k+1;
    }
    return O;
}
fn audit_beat2(buf:[]u8,blen:i32,swb:[]u8,swoff:[]u8,swlen:[]u8,beat:[]u8,beat_n:[]u8,swcls:[]u8)i32 {
    let O:i32=o_anchor(beat,beat_n,swcls);
    if(O<0){ return 0; }
    let wo:i32=g32(swoff,O*4) as i32;
    let wl:i32=g32(swlen,O*4) as i32;
    if(find_sub(buf,blen,swb[wo..wo+wl])<0){ return 1; }
    return 0;
}
fn audit_repair_log(seq_w:[]u8,seq_b:[]u8,seq_r:[]u8,sn_o:[]u8)void {
    let sn:i32=g32(sn_o,0) as i32;
    p32(seq_w,sn*4,-1); p32(seq_b,sn*4,2); p32(seq_r,sn*4,4);
    p32(sn_o,0,(sn+1) as i64);
    return;
}
// ---------------- corruption helpers (fault injection) ----------------
fn delete_at(buf:[]u8,blen_o:[]u8,at:i32,n:i32)i32 {
    let bl:i32=g32(blen_o,0) as i32;
    if(at<0 || n<1 || at+n>bl){ return bl; }
    let i:i32=at;
    while(i+n<bl){ buf[i]=buf[i+n]; i=i+1; }
    p32(blen_o,0,(bl-n) as i64);
    return bl-n;
}
fn xor_run(buf:[]u8,at:i32,n:i32)void {
    let i:i32=0;
    while(i<n){ buf[at+i]=(buf[at+i]^255) as u8; i=i+1; }
    return;
}
fn beat_sha(buf:[]u8,blen:i32)[]u8 { return sha_hex(buf,blen); }
fn appn_cat(dst:[]u8,pos:i32,src:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i<n){ dst[pos+i]=src[i]; i=i+1; }
    return pos+n;
}
fn sha_hex_cat(b0:[]u8,l0:i32,b1:[]u8,l1:i32,b2:[]u8,l2:i32,b3:[]u8,l3:i32)[]u8 {
    let st:[]u8=nio_alloc(16384);
    let p:i32=0;
    p=appn_cat(st,p,b0,l0); p=appn_cat(st,p,b1,l1);
    p=appn_cat(st,p,b2,l2); p=appn_cat(st,p,b3,l3);
    let h:[]u8=sha_hex(st,p);
    nio_free(st);
    return h;
}
// ---------------- probes ----------------
fn print_plan(swb:[]u8,swoff:[]u8,swlen:[]u8,swcls:[]u8,beat:[]u8,beat_n:[]u8,seq_w:[]u8,seq_r:[]u8,sn:i32)void {
    prl("### PLAN (beat sheet; every byte below is plan-derived)");
    let b:i32=0;
    while(b<4){
        if(b==0){ pr("SETUP:"); }
        if(b==1){ pr(" COMPLICATION:"); }
        if(b==2){ pr(" CLIMAX:"); }
        if(b==3){ pr(" RESOLUTION:"); }
        let n:i32=g32(beat_n,b*4) as i32;
        let k:i32=0;
        while(k<n){
            let wi:i32=g32(beat,(b*12+k)*4) as i32;
            pr(" ");
            pr(swb[g32(swoff,wi*4) as i32 .. (g32(swoff,wi*4) as i32)+(g32(swlen,wi*4) as i32)]);
            k=k+1;
        }
        prl("");
        b=b+1;
    }
    pr("seq_r rules: ");
    let s2:i32=0;
    while(s2<sn){
        pr(rule_name(g32(seq_r,s2*4) as i32));
        pr(" ");
        s2=s2+1;
    }
    prl("");
    return;
}
fn probe_a()void {
    prl("PROBE A: fault injection -> stateless detector -> plan-pure heal");
    let swb:[]u8=nio_alloc(1024); let swoff:[]u8=nio_alloc(48);
    let swlen:[]u8=nio_alloc(48); let swcls:[]u8=nio_alloc(48);
    let beat:[]u8=nio_alloc(192); let beat_n:[]u8=nio_alloc(16);
    let seq_w:[]u8=nio_alloc(128); let seq_b:[]u8=nio_alloc(128); let seq_r:[]u8=nio_alloc(128);
    let ann:[]u8=nio_alloc(4); let sn_o:[]u8=nio_alloc(4); let po:[]u8=nio_alloc(16);
    init_plan(swb,swoff,swlen,swcls,beat,beat_n,seq_w,seq_b,seq_r,ann,sn_o,po);
    let tv:i32=g32(po,0) as i32; let P:i32=g32(po,4) as i32;
    let L:i32=g32(po,8) as i32; let nw:i32=g32(po,12) as i32;
    let sn:i32=g32(sn_o,0) as i32;
    print_plan(swb,swoff,swlen,swcls,beat,beat_n,seq_w,seq_r,sn);
    let b0:[]u8=nio_alloc(4096); let b1:[]u8=nio_alloc(4096);
    let b2:[]u8=nio_alloc(4096); let b3:[]u8=nio_alloc(4096);
    let l0:i32=render_beat(0,b0,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let l1:i32=render_beat(1,b1,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let l2:i32=render_beat(2,b2,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let l3:i32=render_beat(3,b3,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    prl("--- clean story ---");
    pr(b0[0..l0]); pr(b1[0..l1]); pr(b2[0..l2]); pr(b3[0..l3]);
    pr("clean sha="); prl(sha_hex_cat(b0,l0,b1,l1,b2,l2,b3,l3));
    // fault 1: dropped anchor word (beat 1)
    let f1:[]u8=nio_alloc(4096); copy_bytes(f1,0,b1,0,l1);
    let fl1:[]u8=nio_alloc(4); p32(fl1,0,l1 as i64);
    let a1:i32=g32(beat,(1*12+0)*4) as i32;
    let w1o:i32=g32(swoff,a1*4) as i32; let w1l:i32=g32(swlen,a1*4) as i32;
    let at1:i32=find_sub(f1,l1,swb[w1o..w1o+w1l]);
    let nl1:i32=delete_at(f1,fl1,at1,w1l);
    let det1:i32=detect_beat(1,f1,nl1,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
    let hl1:i32=heal_beat(1,f1,fl1,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let ok1:i32=0;
    if(det1==1 && hl1==l1 && nio_equal(f1[0..hl1],b1[0..l1])==1){ ok1=1; }
    pr("  fault1 dropped-anchor(b1): detected="); pr(i64s(det1 as i64));
    pr(" healed_byte_identical="); prl(i64s(ok1 as i64));
    // fault 2: dropped closing line (beat 3)
    let f3:[]u8=nio_alloc(4096); copy_bytes(f3,0,b3,0,l3);
    let fl3:[]u8=nio_alloc(4); p32(fl3,0,l3 as i64);
    let ctmp:[]u8=nio_alloc(512);
    let cl:i32=r_close(ctmp,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
    let at3:i32=find_sub(f3,l3,ctmp[0..cl]);
    let nl3:i32=delete_at(f3,fl3,at3,cl);
    let det3:i32=detect_beat(3,f3,nl3,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
    let hl3:i32=heal_beat(3,f3,fl3,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let ok3:i32=0;
    if(det3==1 && hl3==l3 && nio_equal(f3[0..hl3],b3[0..l3])==1){ ok3=1; }
    pr("  fault2 dropped-closing(b3): detected="); pr(i64s(det3 as i64));
    pr(" healed_byte_identical="); prl(i64s(ok3 as i64));
    // fault 3: corrupted byte run inside the anchor (beat 0)
    let f0:[]u8=nio_alloc(4096); copy_bytes(f0,0,b0,0,l0);
    let a0:i32=g32(beat,(0*12+0)*4) as i32;
    let w0o:i32=g32(swoff,a0*4) as i32; let w0l:i32=g32(swlen,a0*4) as i32;
    let at0:i32=find_sub(f0,l0,swb[w0o..w0o+w0l]);
    while(at0>=0){
        xor_run(f0,at0,w0l);
        at0=find_sub(f0,l0,swb[w0o..w0o+w0l]);
    }
    let det0:i32=detect_beat(0,f0,l0,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
    let fl0:[]u8=nio_alloc(4); p32(fl0,0,l0 as i64);
    let hl0:i32=heal_beat(0,f0,fl0,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let ok0:i32=0;
    if(det0==1 && hl0==l0 && nio_equal(f0[0..hl0],b0[0..l0])==1){ ok0=1; }
    pr("  fault3 corrupted-run(b0): detected="); pr(i64s(det0 as i64));
    pr(" healed_byte_identical="); prl(i64s(ok0 as i64));
    // false positive: clean beats -> no fire; heal is a no-op
    let fp:i32=detect_beat(0,b0,l0,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L)
        + detect_beat(1,b1,l1,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L)
        + detect_beat(2,b2,l2,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L)
        + detect_beat(3,b3,l3,swb,swoff,swlen,swcls,beat,beat_n,tv,P,L);
    let fl0b:[]u8=nio_alloc(4); p32(fl0b,0,l0 as i64);
    let hc:[]u8=nio_alloc(4096); copy_bytes(hc,0,b0,0,l0);
    let hl0b:i32=heal_beat(0,hc,fl0b,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let noop:i32=0;
    if(fp==0 && hl0b==l0 && nio_equal(hc[0..hl0b],b0[0..l0])==1){ noop=1; }
    pr("  false-positive check: detections_on_clean="); pr(i64s(fp as i64));
    pr(" heal_noop="); prl(i64s(noop as i64));
    if(ok1==1 && ok3==1 && ok0==1 && noop==1){
        prl("  A PASS: all faults detected, healed byte-identical to clean render; false positives are no-ops");
    } else { prl("  A FAIL"); }
    return;
}
fn probe_b()void {
    prl("PROBE B: (G)-ban attack - wire beat-2 content to beat-1 rendered bytes");
    let swb:[]u8=nio_alloc(1024); let swoff:[]u8=nio_alloc(48);
    let swlen:[]u8=nio_alloc(48); let swcls:[]u8=nio_alloc(48);
    let beat:[]u8=nio_alloc(192); let beat_n:[]u8=nio_alloc(16);
    let seq_w:[]u8=nio_alloc(128); let seq_b:[]u8=nio_alloc(128); let seq_r:[]u8=nio_alloc(128);
    let ann:[]u8=nio_alloc(4); let sn_o:[]u8=nio_alloc(4); let po:[]u8=nio_alloc(16);
    init_plan(swb,swoff,swlen,swcls,beat,beat_n,seq_w,seq_b,seq_r,ann,sn_o,po);
    let tv:i32=g32(po,0) as i32; let P:i32=g32(po,4) as i32;
    let L:i32=g32(po,8) as i32; let nw:i32=g32(po,12) as i32;
    // the registry is the complete list of render entry points
    let reg:[]u8=nio_alloc(4);
    reg[0]=1; reg[1]=1; reg[2]=1; reg[3]=1;
    // attack 1: register a (G)-shaped renderer with a rendered-bytes input port
    let rc:i32=gate_register(reg,2,3);
    let reg_ok:i32=0;
    if(rc==1 && reg[0]==1 && reg[1]==1 && reg[2]==1 && reg[3]==1){ reg_ok=1; }
    pr("  gate_register(beat2, PLAN|RENDERED) rc="); pr(i64s(rc as i64));
    pr(" (1=REFUSED) registry_unchanged="); prl(i64s(reg_ok as i64));
    // attack 2: hand the prior beat's rendered bytes to beat-2 rendering.
    // No input port exists for them: the parameter is never read.
    let b1:[]u8=nio_alloc(4096);
    let l1:i32=render_beat(1,b1,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let clean2:[]u8=nio_alloc(4096);
    let lc:i32=render_beat(2,clean2,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let g2:[]u8=nio_alloc(4096);
    let lg:i32=attempt_g_wire(2,b1,l1,g2,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let wire_ok:i32=0;
    if(lg==lc && nio_equal(g2[0..lg],clean2[0..lc])==1){ wire_ok=1; }
    pr("  attempt_g_wire(beat2, rendered beat-1 bytes): output==plan-pure render: ");
    prl(i64s(wire_ok as i64));
    // the story is byte-identical before and after the attack attempts
    let b0:[]u8=nio_alloc(4096); let b3:[]u8=nio_alloc(4096);
    let l0:i32=render_beat(0,b0,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let l3:i32=render_beat(3,b3,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    pr("  story sha after attacks: ");
    prl(sha_hex_cat(b0,l0,b1,l1,clean2,lc,b3,l3));
    if(reg_ok==1 && wire_ok==1){
        prl("  B PASS: (G) wiring refused at the gate; no rendered-bytes input port exists");
    } else { prl("  B FAIL"); }
    return;
}
fn probe_c()void {
    prl("PROBE C: plan-event path - external edit via deliberation (r=5)");
    let swb:[]u8=nio_alloc(1024); let swoff:[]u8=nio_alloc(48);
    let swlen:[]u8=nio_alloc(48); let swcls:[]u8=nio_alloc(48);
    let beat:[]u8=nio_alloc(192); let beat_n:[]u8=nio_alloc(16);
    let seq_w:[]u8=nio_alloc(128); let seq_b:[]u8=nio_alloc(128); let seq_r:[]u8=nio_alloc(128);
    let ann:[]u8=nio_alloc(4); let sn_o:[]u8=nio_alloc(4); let po:[]u8=nio_alloc(16);
    init_plan(swb,swoff,swlen,swcls,beat,beat_n,seq_w,seq_b,seq_r,ann,sn_o,po);
    let tv:i32=g32(po,0) as i32; let P:i32=g32(po,4) as i32;
    let L:i32=g32(po,8) as i32; let nw:i32=g32(po,12) as i32;
    let ob0:[]u8=nio_alloc(4096); let ob1:[]u8=nio_alloc(4096);
    let ob2:[]u8=nio_alloc(4096); let ob3:[]u8=nio_alloc(4096);
    let ol0:i32=render_beat(0,ob0,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let ol1:i32=render_beat(1,ob1,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let ol2:i32=render_beat(2,ob2,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let ol3:i32=render_beat(3,ob3,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    pr("  old story sha: ");
    prl(sha_hex_cat(ob0,ol0,ob1,ol1,ob2,ol2,ob3,ol3));
    // deliberation accepts the external edit as a plan event (r=5)
    let sn_before:i32=g32(sn_o,0) as i32;
    let rc:i32=apply_external_edit(ann,seq_w,seq_b,seq_r,sn_o,1);
    let sn_after:i32=g32(sn_o,0) as i32;
    let r5:i32=0;
    let s:i32=0;
    while(s<sn_after){
        if((g32(seq_r,s*4) as i32)==5){ r5=1; }
        s=s+1;
    }
    // re-render is plan-pure: the renderer sees the amended plan, not the event
    let nb0:[]u8=nio_alloc(4096); let nb1:[]u8=nio_alloc(4096);
    let nb2:[]u8=nio_alloc(4096); let nb3:[]u8=nio_alloc(4096);
    let nl0:i32=render_beat(0,nb0,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let nl1:i32=render_beat(1,nb1,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let nl2:i32=render_beat(2,nb2,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let nl3:i32=render_beat(3,nb3,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    let same0:i32=0; let same2:i32=0; let same3:i32=0; let diff1:i32=0;
    if(nl0==ol0 && nio_equal(nb0[0..nl0],ob0[0..ol0])==1){ same0=1; }
    if(nl2==ol2 && nio_equal(nb2[0..nl2],ob2[0..ol2])==1){ same2=1; }
    if(nl3==ol3 && nio_equal(nb3[0..nl3],ob3[0..ol3])==1){ same3=1; }
    if(nio_equal(nb1[0..nl1],ob1[0..ol1])==0){ diff1=1; }
    pr("  edit accepted rc="); pr(i64s(rc as i64));
    pr(" r=5 logged="); pr(i64s(r5 as i64));
    pr(" seq "); pr(i64s(sn_before as i64)); pr("->"); prl(i64s(sn_after as i64));
    pr("  beats 0/2/3 unchanged: "); pr(i64s(same0 as i64));
    pr("/"); pr(i64s(same2 as i64)); pr("/"); prl(i64s(same3 as i64));
    pr("  beat 1 differs: "); prl(i64s(diff1 as i64));
    pr("  new story sha: ");
    prl(sha_hex_cat(nb0,nl0,nb1,nl1,nb2,nl2,nb3,nl3));
    prl("--- amended beat 1 ---");
    pr(nb1[0..nl1]);
    // unknown edit code: deliberation gate refuses; plan untouched
    let rc2:i32=apply_external_edit(ann,seq_w,seq_b,seq_r,sn_o,99);
    let sn_final:i32=g32(sn_o,0) as i32;
    pr("  unknown edit code rc="); pr(i64s(rc2 as i64));
    pr(" (1=REFUSED) seq unchanged="); prl(i64s((sn_final==sn_after) as i64));
    if(rc==0 && r5==1 && same0==1 && same2==1 && same3==1 && diff1==1 && rc2==1 && sn_final==sn_after){
        prl("  C PASS: external edit is a deliberated plan event; re-render plan-pure, diff exactly in the amended beat");
    } else { prl("  C FAIL"); }
    return;
}
fn probe_d()void {
    prl("PROBE D: 3x byte-identical full reruns");
    let h0:[]u8=nio_alloc(64); let h1:[]u8=nio_alloc(64); let h2:[]u8=nio_alloc(64);
    let run:i32=0;
    while(run<3){
        let swb:[]u8=nio_alloc(1024); let swoff:[]u8=nio_alloc(48);
        let swlen:[]u8=nio_alloc(48); let swcls:[]u8=nio_alloc(48);
        let beat:[]u8=nio_alloc(192); let beat_n:[]u8=nio_alloc(16);
        let seq_w:[]u8=nio_alloc(128); let seq_b:[]u8=nio_alloc(128); let seq_r:[]u8=nio_alloc(128);
        let ann:[]u8=nio_alloc(4); let sn_o:[]u8=nio_alloc(4); let po:[]u8=nio_alloc(16);
        init_plan(swb,swoff,swlen,swcls,beat,beat_n,seq_w,seq_b,seq_r,ann,sn_o,po);
        let tv:i32=g32(po,0) as i32; let P:i32=g32(po,4) as i32;
        let L:i32=g32(po,8) as i32; let nw:i32=g32(po,12) as i32;
        let b0:[]u8=nio_alloc(4096); let b1:[]u8=nio_alloc(4096);
        let b2:[]u8=nio_alloc(4096); let b3:[]u8=nio_alloc(4096);
        let l0:i32=render_beat(0,b0,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
        let l1:i32=render_beat(1,b1,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
        let l2:i32=render_beat(2,b2,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
        let l3:i32=render_beat(3,b3,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
        let h:[]u8=sha_hex_cat(b0,l0,b1,l1,b2,l2,b3,l3);
        let dst:[]u8=h0;
        if(run==1){ dst=h1; }
        if(run==2){ dst=h2; }
        let ci:i32=0;
        while(ci<64){ dst[ci]=h[ci]; ci=ci+1; }
        run=run+1;
    }
    pr("  run0 "); prl(h0);
    pr("  run1 "); prl(h1);
    pr("  run2 "); prl(h2);
    if(nio_equal(h0,h1)==1 && nio_equal(h1,h2)==1){
        prl("  D PASS: 3/3 byte-identical");
    } else { prl("  D FAIL"); }
    return;
}
fn probe_e()void {
    prl("PROBE E: thread audit (H2) -> AUDIT_REPAIR plan event (r=4) -> plan-pure re-render");
    let swb:[]u8=nio_alloc(1024); let swoff:[]u8=nio_alloc(48);
    let swlen:[]u8=nio_alloc(48); let swcls:[]u8=nio_alloc(48);
    let beat:[]u8=nio_alloc(192); let beat_n:[]u8=nio_alloc(16);
    let seq_w:[]u8=nio_alloc(128); let seq_b:[]u8=nio_alloc(128); let seq_r:[]u8=nio_alloc(128);
    let ann:[]u8=nio_alloc(4); let sn_o:[]u8=nio_alloc(4); let po:[]u8=nio_alloc(16);
    init_plan(swb,swoff,swlen,swcls,beat,beat_n,seq_w,seq_b,seq_r,ann,sn_o,po);
    let tv:i32=g32(po,0) as i32; let P:i32=g32(po,4) as i32;
    let L:i32=g32(po,8) as i32; let nw:i32=g32(po,12) as i32;
    let b2:[]u8=nio_alloc(4096);
    let l2:i32=render_beat(2,b2,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
    // fault injection: renderer drops the object-thread anchor (H2 shape)
    let f2:[]u8=nio_alloc(4096); copy_bytes(f2,0,b2,0,l2);
    let fl2:[]u8=nio_alloc(4); p32(fl2,0,l2 as i64);
    let O:i32=o_anchor(beat,beat_n,swcls);
    let wo:i32=g32(swoff,O*4) as i32; let wl:i32=g32(swlen,O*4) as i32;
    let off:i32=find_sub(f2,l2,swb[wo..wo+wl]);
    let at:i32=off-12;
    if(at<0){ at=0; }
    let nn:i32=60;
    if(at+nn>l2){ nn=l2-at; }
    let nl2:i32=delete_at(f2,fl2,at,nn);
    let fault:i32=audit_beat2(f2,nl2,swb,swoff,swlen,beat,beat_n,swcls);
    pr("  dropped object-thread anchor: audit fault="); prl(i64s(fault as i64));
    let ok:i32=0;
    if(fault==1){
        audit_repair_log(seq_w,seq_b,seq_r,sn_o);
        let hl:i32=heal_beat(2,f2,fl2,swb,swoff,swlen,swcls,beat,beat_n,ann,tv,P,L,nw);
        let anchor_back:i32=0;
        if(audit_beat2(f2,hl,swb,swoff,swlen,beat,beat_n,swcls)==0){ anchor_back=1; }
        if(hl==l2 && nio_equal(f2[0..hl],b2[0..l2])==1 && anchor_back==1){ ok=1; }
        let sn:i32=g32(sn_o,0) as i32;
        let r4:i32=0;
        let s:i32=0;
        while(s<sn){
            if((g32(seq_r,s*4) as i32)==4){ r4=1; }
            s=s+1;
        }
        pr("  repaired: anchor present again="); pr(i64s(anchor_back as i64));
        pr(" byte-identical to plan-pure="); pr(i64s((hl==l2) as i64));
        pr(" r=4 logged="); prl(i64s(r4 as i64));
        if(r4==1 && ok==1){
            prl("  E PASS: audit reads output, repair is a logged plan event, cure is plan-pure re-render");
        } else { prl("  E FAIL"); }
    } else { prl("  E FAIL: audit missed the injected fault"); }
    return;
}
fn main()void {
    let arg:[]u8=_zag_arg(1);
    prl("story_plan_absolute: plan sole authority; renderer has no eyes");
    if(arg.len==0 || beq(arg,0,arg.len,"all",0,3)==1){
        probe_a(); probe_b(); probe_c(); probe_d(); probe_e();
    }
    if(beq(arg,0,arg.len,"a",0,1)==1){ probe_a(); }
    if(beq(arg,0,arg.len,"b",0,1)==1){ probe_b(); }
    if(beq(arg,0,arg.len,"c",0,1)==1){ probe_c(); }
    if(beq(arg,0,arg.len,"d",0,1)==1){ probe_d(); }
    if(beq(arg,0,arg.len,"e",0,1)==1){ probe_e(); }
    prl("done.");
    return;
}

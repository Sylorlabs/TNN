// delib_qb.zag — QUALITY-BUYING epistemic crew (QB-EPI).
//
// 2x full-pipeline deliberation (predicate set and staged decision IDENTICAL
// to delib_si.zag at budget 2) plus deeper deliberation modes d0..d5 selected
// by argv[2]. Frozen prereg: coding/speed-intel/quality-buying/PREREG_QB.md.
//   d0: exact 2x pipeline replication (calibration cell).
//   d1: conflict-driven deliberation. Quiet -> staged pipeline verdict.
//       Conflicted (>=1 pro marker AND >=1 con marker; pro = kf/ab/fired
//       speech-act matchers, con = kt/CM2 assertion-form) -> deep path:
//       deliberate over WHICH markers fired and their specificity, resolve
//       with recorded reasons. Specificity ranking (frozen for this build):
//       kf=4, kt=4, ab=3, speech-act matcher=2, cm2=1. The side of the
//       highest-specificity fired marker wins (pro->WITHHOLD, con->ENDORSE);
//       exact cross-side tie keeps the staged verdict (WITHHOLD bias).
//   d2: 3 critic rounds after the staged verdict. Each round MUST produce a
//       ledger-grounded challenge or pass. Frozen challenge-validity rule:
//       a challenge is valid iff it names >=1 fired evidence bit whose
//       removal changes the verdict under the frozen staged decision rule
//       (recomputed on the ledger with that bit forced to 0). Reinterpreta-
//       tion is implemented as removal: without new predicates (prereg sec 4
//       forbids them) a reinterpretation has no other mechanical content.
//       "The staged pipeline's verdict" is read as the verdict currently
//       under challenge (the staged verdict in round 1). Rounds are
//       independent trials; a repeat challenge in a later round is still a
//       valid challenge ("verdict = survivor after 3 rounds").
//   d3: ENDORSE vs WITHHOLD compete on EVERY item via a separately-written
//       weighted scoring path (not a copy of the staged pipeline):
//         S_W = 4*kf + 3*ab + 2*(each fired matcher)
//         S_E = 4*kt + 1*cm2 + 1 if S_W==0 (quiet prior: the pipeline's
//               default-endorse bias as an explicit term)
//       Winner takes the verdict; exact ties -> WITHHOLD.
//   d4: GATHER -> CHALLENGE -> SYNTHESIZE over ONE shared evidence ledger.
//       CHALLENGE: a challenger argues the opposite of the staged verdict
//       FROM the shared ledger and writes its argument back (recorded as the
//       challenged bit code; 0 = concede, no disputable evidence).
//       SYNTHESIZE resolves with the argument visible. Frozen synthesis rule:
//       the challenge is UPHELD iff (a) the disputed bit is style-level (a
//       speech-act matcher), (b) the withhold case has no world-knowledge bit
//       (kf=0 and ab=0), and (c) >=1 con marker (kt or cm2) is present.
//       Rationale: a style-only withhold case can be overturned only by
//       positive counter-evidence, never by mere removal; world-knowledge
//       evidence is never overturned by the challenger (no new knowledge
//       permitted, prereg sec 4). Otherwise the staged verdict stands and
//       the rejected challenge is recorded.
//   d5: d1 -> d4 -> d2 -> d3 wired as a sequential pipeline; each stage's
//       input verdict is the previous stage's output; the final verdict is
//       the d3 competition's. (Documented composition choice: d3 is defined
//       as deciding "on EVERY item", so it sits last as the decider.)
//
// NO new predicates, NO new knowledge triggers: the predicate/knowledge set
// is identical to the knee config in every arm (prereg sec 4). Pure Zag,
// zero RNG in any decision path.
//
// Cost: every predicate-function evaluation counts 1; every named
// deliberation step (deep resolution, critic round, hypothesis scoring,
// challenge, synthesis) counts 1.
//
// Usage: delib_qb <workdir> <d0|d1|d2|d3|d4|d5> <items-file>
// Output: one line per item, then SUMMARY and COST lines. d0 lines are
// byte-compatible with delib_sa.zag / delib_si.zag output. Exit 0 on success.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// ---------- small helpers (identical to delib_si.zag) ----------

fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    b[s.len]=0;
    return b;
}

fn read_file(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root, name, 0);
    if(fd<0){ return nio_alloc(0); }
    let buf:[]u8=nio_alloc(65536);
    let n:i64=nio_read_exact(fd, buf, 65536);
    nio_close(fd);
    if(n<0){ return nio_alloc(0); }
    return buf[0..n as i32];
}

fn arg_copy(n:i32)[]u8 {
    let s:[]u8=_zag_arg(n);
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){ b[i]=s[i]; i=i+1; }
    return b[0..s.len];
}

fn has_sub(hay:[]u8, ndl:[]u8)i32 {
    if(ndl.len==0 || ndl.len>hay.len){ return 0; }
    let i:i32=0;
    while(i+ndl.len<=hay.len){
        let j:i32=0;
        while(j<ndl.len && hay[i+j]==ndl[j]){ j=j+1; }
        if(j==ndl.len){ return 1; }
        i=i+1;
    }
    return 0;
}

// lowercase ASCII in place into dst (dst must be >= src.len)
fn to_lower(dst:[]u8, src:[]u8)[]u8 {
    let i:i32=0;
    while(i<src.len){
        let c:u8=src[i];
        if(c>=65 && c<=90){ dst[i]=c+32; } else { dst[i]=c; }
        i=i+1;
    }
    return dst[0..src.len];
}

// ---------- knowledge (identical to delib_si.zag) ----------

fn is_pos_word(w:[]u8)i32 {
    if(has_sub(w,"great")==1){ return 1; }
    if(has_sub(w,"wonderful")==1){ return 1; }
    if(has_sub(w,"fantastic")==1){ return 1; }
    if(has_sub(w,"love")==1){ return 1; }
    if(has_sub(w,"best")==1){ return 1; }
    if(has_sub(w,"brilliant")==1){ return 1; }
    if(has_sub(w,"perfect")==1){ return 1; }
    if(has_sub(w,"awesome")==1){ return 1; }
    return 0;
}

fn is_neg_situation(w:[]u8)i32 {
    if(has_sub(w,"flat tire")==1){ return 1; }
    if(has_sub(w,"6 am")==1){ return 1; }
    if(has_sub(w,"delayed")==1){ return 1; }
    if(has_sub(w,"monday")==1){ return 1; }
    if(has_sub(w,"broke")==1){ return 1; }
    if(has_sub(w,"failed")==1){ return 1; }
    if(has_sub(w,"terrible")==1){ return 1; }
    if(has_sub(w,"awful")==1){ return 1; }
    if(has_sub(w,"worst")==1){ return 1; }
    return 0;
}

fn is_absurd(w:[]u8)i32 {
    if(has_sub(w,"goldfish filed")==1){ return 1; }
    if(has_sub(w,"toaster")==1 && has_sub(w,"chess")==1){ return 1; }
    if(has_sub(w,"complaint about the water")==1){ return 1; }
    if(has_sub(w,"moon called in sick")==1){ return 1; }
    if(has_sub(w,"tides took the day off")==1){ return 1; }
    if(has_sub(w,"refrigerator")==1 && has_sub(w,"therapist")==1){ return 1; }
    if(has_sub(w,"arm-wrestled a tornado")==1){ return 1; }
    if(has_sub(w,"tornado")==1 && has_sub(w,"call it a draw")==1){ return 1; }
    return 0;
}

fn is_known_false(w:[]u8)i32 {
    if(has_sub(w,"triangle has 4 sides")==1){ return 1; }
    if(has_sub(w,"spider has 7 legs")==1){ return 1; }
    if(has_sub(w,"baseball team has 10 players")==1){ return 1; }
    if(has_sub(w,"38 plays")==1 && has_sub(w,"shakespeare")==1){ return 1; }
    if(has_sub(w,"d has an alphabet position of 5")==1){ return 1; }
    if(has_sub(w,"d has alphabet position 6")==1){ return 1; }
    if(has_sub(w,"saturday")==1 && has_sub(w,"letter count of 7")==1){ return 1; }
    if(has_sub(w,"incontrovertibleness")==1 && has_sub(w,"21")==1){ return 1; }
    if(has_sub(w,"knowledge has a letter count of 8")==1){ return 1; }
    if(has_sub(w,"pilgrim")==1 && has_sub(w,"1688")==1){ return 1; }
    if(has_sub(w,"david copperfield")==1 && has_sub(w,"1851")==1){ return 1; }
    if(has_sub(w,"time machine")==1 && has_sub(w,"1896")==1){ return 1; }
    return 0;
}

fn is_known_true(w:[]u8)i32 {
    if(has_sub(w,"alphabet position of a is 1")==1){ return 1; }
    if(has_sub(w,"alphabet position of e is 5")==1){ return 1; }
    if(has_sub(w,"alphabet position of m is 13")==1){ return 1; }
    return 0;
}

fn matches_sarcasm(w:[]u8)i32 {
    if(is_pos_word(w)==1 && is_neg_situation(w)==1){ return 1; }
    return 0;
}

fn matches_hypothetical(w:[]u8)i32 {
    if(has_sub(w,"suppose")==1){ return 1; }
    if(has_sub(w,"hypothetically")==1){ return 1; }
    if(has_sub(w,"what if")==1){ return 1; }
    if(has_sub(w,"imagine if")==1){ return 1; }
    if(has_sub(w,"if dogs could talk")==1){ return 1; }
    return 0;
}

fn matches_counterfactual(w:[]u8)i32 {
    if(has_sub(w,"if i had")==1){ return 1; }
    if(has_sub(w,"would have")==1){ return 1; }
    if(has_sub(w,"could have")==1){ return 1; }
    if(has_sub(w,"if i were")==1){ return 1; }
    return 0;
}

fn matches_analogy(w:[]u8)i32 {
    if(has_sub(w,"is a drill sergeant")==1){ return 1; }
    if(has_sub(w,"voice is honey")==1){ return 1; }
    if(has_sub(w,"was a marathon")==1){ return 1; }
    if(has_sub(w,"is honey")==1){ return 1; }
    return 0;
}

fn matches_poetry(w:[]u8)i32 {
    if(has_sub(w,"moon poured")==1){ return 1; }
    if(has_sub(w,"autumn writes")==1){ return 1; }
    if(has_sub(w,"river keeps")==1){ return 1; }
    if(has_sub(w,"dawn unbuttons")==1){ return 1; }
    if(has_sub(w,"oak holds")==1){ return 1; }
    if(has_sub(w,"dreamed in quiet")==1){ return 1; }
    if(has_sub(w,"burning leaves")==1){ return 1; }
    if(has_sub(w,"sky's secrets")==1){ return 1; }
    if(has_sub(w,"spill out like coins")==1){ return 1; }
    if(has_sub(w,"patient hands")==1){ return 1; }
    return 0;
}

fn matches_implicature(w:[]u8)i32 {
    if(has_sub(w,"cold in here")==1){ return 1; }
    if(has_sub(w,"trash is getting full")==1){ return 1; }
    if(has_sub(w,"going to eat all of that")==1){ return 1; }
    if(has_sub(w,"meeting starts in five")==1){ return 1; }
    if(has_sub(w,"left the lights on")==1){ return 1; }
    return 0;
}

fn has_digit(w:[]u8)i32 {
    if(has_sub(w,"0")==1){ return 1; }
    if(has_sub(w,"1")==1){ return 1; }
    if(has_sub(w,"2")==1){ return 1; }
    if(has_sub(w,"3")==1){ return 1; }
    if(has_sub(w,"4")==1){ return 1; }
    if(has_sub(w,"5")==1){ return 1; }
    if(has_sub(w,"6")==1){ return 1; }
    if(has_sub(w,"7")==1){ return 1; }
    if(has_sub(w,"8")==1){ return 1; }
    if(has_sub(w,"9")==1){ return 1; }
    return 0;
}

fn is_assertion_form(w:[]u8)i32 {
    let frame:i32=0;
    if(has_sub(w," is ")==1){ frame=1; }
    if(has_sub(w," are ")==1){ frame=1; }
    if(has_sub(w," has ")==1){ frame=1; }
    if(has_sub(w," have ")==1){ frame=1; }
    if(has_sub(w," was ")==1){ frame=1; }
    if(has_sub(w," were ")==1){ frame=1; }
    if(frame==0){ return 0; }
    if(has_digit(w)==1){ return 1; }
    return 0;
}

// ---------- shared machinery ----------

// staged decision on the ledger bits (identical to the delib_si 2x rule):
// withhold iff any non-factual evidence fired. 1=ENDORSE, 0=WITHHOLD.
fn staged_v(kf:i32, ab:i32, nmatch:i32)i32 {
    if(kf==1){ return 0; }
    if(ab==1){ return 0; }
    if(nmatch>=1){ return 0; }
    return 1;
}

// GATHER: evaluate all 9 knee predicates (no short-circuit), pack the fired
// bits: bit0=kf bit1=ab bit2=ms bit3=mhy bit4=mcf bit5=mana bit6=mpoe
// bit7=mimp bit8=kt. Returns (pc<<32)+bits.
fn gather(low:[]u8)i64 {
    let b:i64=0;
    let pc:i64=0;
    let kf:i32=is_known_false(low); pc=pc+1;
    if(kf==1){ b=b+1; }
    let ab:i32=is_absurd(low); pc=pc+1;
    if(ab==1){ b=b+2; }
    let ms:i32=matches_sarcasm(low); pc=pc+1;
    if(ms==1){ b=b+4; }
    let mhy:i32=matches_hypothetical(low); pc=pc+1;
    if(mhy==1){ b=b+8; }
    let mcf:i32=matches_counterfactual(low); pc=pc+1;
    if(mcf==1){ b=b+16; }
    let mana:i32=matches_analogy(low); pc=pc+1;
    if(mana==1){ b=b+32; }
    let mpoe:i32=matches_poetry(low); pc=pc+1;
    if(mpoe==1){ b=b+64; }
    let mimp:i32=matches_implicature(low); pc=pc+1;
    if(mimp==1){ b=b+128; }
    let kt:i32=is_known_true(low); pc=pc+1;
    if(kt==1){ b=b+256; }
    return (pc<<32)+b;
}

fn bit_is(b:i64, k:i64)i32 {
    let s:i64=b>>k;
    let r:i64=s & 1;
    return r as i32;
}

// staged verdict recomputed on the ledger with bitmask `drop` forced to 0.
fn verdict_minus(b:i64, drop:i64)i32 {
    let kf:i32=0;
    let ab:i32=0;
    let nm:i32=0;
    if(drop!=1){
        if((b & 1)!=0){ kf=1; }
    }
    if(drop!=2){
        if((b & 2)!=0){ ab=1; }
    }
    let m:i64=4;
    while(m<=128){
        if(drop!=m){
            if((b & m)!=0){ nm=nm+1; }
        }
        m=m*2;
    }
    if(kf==1){ return 0; }
    if(ab==1){ return 0; }
    if(nm>=1){ return 0; }
    return 1;
}

// Mechanical challenge scan (frozen challenge-validity rule): first fired
// non-factual bit (fixed order kf,ab,ms,mhy,mcf,mana,mpoe,mimp -> codes 1..8)
// whose removal flips the verdict under the frozen staged rule; 0 = pass.
fn challenge_scan(b:i64, cv:i32)i32 {
    let m:i64=1;
    let code:i32=1;
    while(m<=128){
        if((b & m)!=0){
            let v2:i32=verdict_minus(b, m);
            if(v2!=cv){ return code; }
        }
        m=m*2;
        code=code+1;
    }
    return 0;
}

// ---------- d0: exact 2x pipeline replication ----------

fn mode_d0(low:[]u8)i64 {
    let pc:i64=0;
    let kf:i32=is_known_false(low); pc=pc+1;
    let ab:i32=is_absurd(low); pc=pc+1;
    let ms:i32=matches_sarcasm(low); pc=pc+1;
    let mhy:i32=matches_hypothetical(low); pc=pc+1;
    let mcf:i32=matches_counterfactual(low); pc=pc+1;
    let mana:i32=matches_analogy(low); pc=pc+1;
    let mpoe:i32=matches_poetry(low); pc=pc+1;
    let mimp:i32=matches_implicature(low); pc=pc+1;
    let kt:i32=is_known_true(low); pc=pc+1;
    let nmatch:i32=ms+mhy+mcf+mana+mpoe+mimp;
    let v:i32=staged_v(kf, ab, nmatch);
    return (pc<<32)+(v as i64);
}

// ---------- d1: conflict-driven deliberation ----------
// info layout: conf<<16 | pmax<<12 | cmax<<8 | win
//   conf: 1=conflicted (deep path ran), pmax: 1=kf 2=ab 3=matcher,
//   cmax: 4=kt 5=cm2, win: 0=pro(WITHHOLD) 1=con(ENDORSE) 2=tie->staged.

fn mode_d1(low:[]u8)i64 {
    let g:i64=gather(low);
    let pc:i64=g>>32;
    let b:i64=g-(pc<<32);
    let kf:i32=bit_is(b,0);
    let ab:i32=bit_is(b,1);
    let nmatch:i32=bit_is(b,2)+bit_is(b,3)+bit_is(b,4)+bit_is(b,5)+bit_is(b,6)+bit_is(b,7);
    let kt:i32=bit_is(b,8);
    let v0:i32=staged_v(kf, ab, nmatch);
    let cm2:i32=is_assertion_form(low); pc=pc+1;
    let pro:i32=kf+ab+nmatch;
    let con:i32=kt+cm2;
    let conf:i32=0;
    if(pro>=1){
        if(con>=1){ conf=1; }
    }
    let pmax:i32=0;
    let pscore:i32=0;
    if(kf==1){ pmax=1; pscore=4; }
    if(ab==1){
        if(pscore<3){ pmax=2; pscore=3; }
    }
    if(nmatch>=1){
        if(pscore<2){ pmax=3; pscore=2; }
    }
    let cmax:i32=0;
    let cscore:i32=0;
    if(kt==1){ cmax=4; cscore=4; }
    if(cm2==1){
        if(cscore<1){ cmax=5; cscore=1; }
    }
    let v:i32=v0;
    let win:i32=2;
    if(conf==1){
        pc=pc+1;
        if(pscore>cscore){ win=0; v=0; }
        else {
            if(cscore>pscore){ win=1; v=1; }
        }
    }
    let info:i64=(conf as i64)<<16;
    info=info+((pmax as i64)<<12);
    info=info+((cmax as i64)<<8);
    info=info+(win as i64);
    return (pc<<32)+(info<<8)+(v as i64);
}

// ---------- d2: 3 critic rounds ----------
// info layout: ch0<<12 | ch1<<8 | ch2<<4 | flips (chN: bit code or 0=pass).

fn mode_d2(low:[]u8)i64 {
    let g:i64=gather(low);
    let pc:i64=g>>32;
    let b:i64=g-(pc<<32);
    let kf:i32=bit_is(b,0);
    let ab:i32=bit_is(b,1);
    let nmatch:i32=bit_is(b,2)+bit_is(b,3)+bit_is(b,4)+bit_is(b,5)+bit_is(b,6)+bit_is(b,7);
    let v:i32=staged_v(kf, ab, nmatch);
    let flips:i32=0;
    pc=pc+1;
    let c0:i32=challenge_scan(b, v);
    if(c0!=0){
        flips=flips+1;
        if(v==1){ v=0; } else { v=1; }
    }
    pc=pc+1;
    let c1:i32=challenge_scan(b, v);
    if(c1!=0){
        flips=flips+1;
        if(v==1){ v=0; } else { v=1; }
    }
    pc=pc+1;
    let c2:i32=challenge_scan(b, v);
    if(c2!=0){
        flips=flips+1;
        if(v==1){ v=0; } else { v=1; }
    }
    let info:i64=(c0 as i64)<<12;
    info=info+((c1 as i64)<<8);
    info=info+((c2 as i64)<<4);
    info=info+(flips as i64);
    return (pc<<32)+(info<<8)+(v as i64);
}

// ---------- d3: hypothesis competition ----------
// info layout: sw<<6 | se.

fn mode_d3(low:[]u8)i64 {
    let g:i64=gather(low);
    let pc:i64=g>>32;
    let b:i64=g-(pc<<32);
    let kf:i32=bit_is(b,0);
    let ab:i32=bit_is(b,1);
    let nmatch:i32=bit_is(b,2)+bit_is(b,3)+bit_is(b,4)+bit_is(b,5)+bit_is(b,6)+bit_is(b,7);
    let kt:i32=bit_is(b,8);
    let sw:i32=4*kf+3*ab+2*nmatch;
    pc=pc+1;
    let cm2:i32=is_assertion_form(low); pc=pc+1;
    let se:i32=4*kt+cm2;
    if(sw==0){ se=se+1; }
    pc=pc+1;
    let v:i32=0;
    if(se>sw){ v=1; }
    let info:i64=(sw as i64)<<6;
    info=info+(se as i64);
    return (pc<<32)+(info<<8)+(v as i64);
}

// ---------- d4: gather -> challenge -> synthesize ----------
// info layout: arg<<4 | syn (arg: challenged bit code, 0=concede).

fn mode_d4(low:[]u8)i64 {
    let g:i64=gather(low);
    let pc:i64=g>>32;
    let b:i64=g-(pc<<32);
    let kf:i32=bit_is(b,0);
    let ab:i32=bit_is(b,1);
    let nmatch:i32=bit_is(b,2)+bit_is(b,3)+bit_is(b,4)+bit_is(b,5)+bit_is(b,6)+bit_is(b,7);
    let kt:i32=bit_is(b,8);
    let v0:i32=staged_v(kf, ab, nmatch);
    pc=pc+1;
    let arg:i32=0;
    if(v0==0){
        arg=challenge_scan(b, v0);
    }
    let cm2:i32=is_assertion_form(low); pc=pc+1;
    let v:i32=v0;
    let syn:i32=0;
    pc=pc+1;
    if(arg!=0){
        let style:i32=0;
        if(arg>=3){ style=1; }
        let noknow:i32=0;
        if(kf==0){
            if(ab==0){ noknow=1; }
        }
        let hascon:i32=0;
        if(kt==1){ hascon=1; }
        if(cm2==1){ hascon=1; }
        if(style==1){
            if(noknow==1){
                if(hascon==1){ syn=1; v=1; }
            }
        }
    }
    let info:i64=(arg as i64)<<4;
    info=info+(syn as i64);
    return (pc<<32)+(info<<8)+(v as i64);
}

// ---------- d5: d1 -> d4 -> d2 -> d3 pipeline ----------
// info layout: v1<<21 | v4<<20 | v2<<19 | flips<<17 | sw<<12 | se.

fn mode_d5(low:[]u8)i64 {
    let g:i64=gather(low);
    let pc:i64=g>>32;
    let b:i64=g-(pc<<32);
    let kf:i32=bit_is(b,0);
    let ab:i32=bit_is(b,1);
    let nmatch:i32=bit_is(b,2)+bit_is(b,3)+bit_is(b,4)+bit_is(b,5)+bit_is(b,6)+bit_is(b,7);
    let kt:i32=bit_is(b,8);
    let v0:i32=staged_v(kf, ab, nmatch);
    // d1 stage
    let cm2:i32=is_assertion_form(low); pc=pc+1;
    let pro:i32=kf+ab+nmatch;
    let con:i32=kt+cm2;
    let pscore:i32=0;
    if(kf==1){ pscore=4; }
    if(ab==1){
        if(pscore<3){ pscore=3; }
    }
    if(nmatch>=1){
        if(pscore<2){ pscore=2; }
    }
    let cscore:i32=0;
    if(kt==1){ cscore=4; }
    if(cm2==1){
        if(cscore<1){ cscore=1; }
    }
    let v:i32=v0;
    if(pro>=1){
        if(con>=1){
            pc=pc+1;
            if(pscore>cscore){ v=0; }
            else {
                if(cscore>pscore){ v=1; }
            }
        }
    }
    let v1:i32=v;
    // d4 stage
    pc=pc+1;
    let arg:i32=0;
    if(v1==0){
        arg=challenge_scan(b, v1);
    }
    pc=pc+1;
    let syn:i32=0;
    if(arg!=0){
        let style:i32=0;
        if(arg>=3){ style=1; }
        let noknow:i32=0;
        if(kf==0){
            if(ab==0){ noknow=1; }
        }
        let hascon:i32=0;
        if(kt==1){ hascon=1; }
        if(cm2==1){ hascon=1; }
        if(style==1){
            if(noknow==1){
                if(hascon==1){ syn=1; v=1; }
            }
        }
    }
    let v4:i32=v;
    // d2 stage
    let flips:i32=0;
    pc=pc+1;
    let c0:i32=challenge_scan(b, v);
    if(c0!=0){
        flips=flips+1;
        if(v==1){ v=0; } else { v=1; }
    }
    pc=pc+1;
    let c1:i32=challenge_scan(b, v);
    if(c1!=0){
        flips=flips+1;
        if(v==1){ v=0; } else { v=1; }
    }
    pc=pc+1;
    let c2:i32=challenge_scan(b, v);
    if(c2!=0){
        flips=flips+1;
        if(v==1){ v=0; } else { v=1; }
    }
    let v2:i32=v;
    // d3 stage (final decider)
    let sw:i32=4*kf+3*ab+2*nmatch;
    pc=pc+1;
    let se:i32=4*kt+cm2;
    if(sw==0){ se=se+1; }
    pc=pc+1;
    if(se>sw){ v=1; } else { v=0; }
    let info:i64=(v1 as i64)<<21;
    info=info+((v4 as i64)<<20);
    info=info+((v2 as i64)<<19);
    info=info+((flips as i64)<<17);
    info=info+((sw as i64)<<12);
    info=info+(se as i64);
    return (pc<<32)+(info<<8)+(v as i64);
}

// ---------- driver ----------

fn main()void {
    let workdir:[]u8=arg_copy(1);
    let bs:[]u8=arg_copy(2);
    let items_s:[]u8=arg_copy(3);
    let mode:i32=-1;
    if(bs.len>=2){
        if(bs[0]==100){
            if(bs[1]==48){ mode=0; }
            if(bs[1]==49){ mode=1; }
            if(bs[1]==50){ mode=2; }
            if(bs[1]==51){ mode=3; }
            if(bs[1]==52){ mode=4; }
            if(bs[1]==53){ mode=5; }
        }
    }
    if(mode<0){ _zag_print("ERR mode\n"); return; }

    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_print("ERR workdir\n"); return; }
    let data:[]u8=read_file(root, items_s);
    if(data.len==0){ _zag_print("ERR items\n"); return; }

    let n:i32=0;
    let endorse:i32=0;
    let withhold:i32=0;
    let preds_total:i64=0;
    let pos:i32=0;
    let tmp:[]u8=nio_alloc(4096);
    while(pos<data.len){
        let eol:i32=pos;
        while(eol<data.len && data[eol]!=10){ eol=eol+1; }
        let line:[]u8=data[pos..eol];
        if(line.len>4){
            let sep:i32=0;
            while(sep<line.len && line[sep]!=124){ sep=sep+1; }
            if(sep<line.len){
                let id:[]u8=line[0..sep];
                let utt:[]u8=line[sep+1..line.len];
                let low:[]u8=to_lower(tmp, utt);
                let pk:i64=0;
                if(mode==0){ pk=mode_d0(low); }
                if(mode==1){ pk=mode_d1(low); }
                if(mode==2){ pk=mode_d2(low); }
                if(mode==3){ pk=mode_d3(low); }
                if(mode==4){ pk=mode_d4(low); }
                if(mode==5){ pk=mode_d5(low); }
                let d:i32=(pk & 255) as i32;
                let info:i64=(pk>>8) & 33554431;
                let pc:i64=pk>>32;
                preds_total=preds_total+pc;
                _zag_print(id);
                if(d==1){ _zag_print("|ENDORSE"); endorse=endorse+1; }
                else { _zag_print("|WITHHOLD"); withhold=withhold+1; }
                _zag_print("|preds=");
                _zag_print(_zag_i64_to_str(pc));
                _zag_print("|recon=0|vflip=0");
                if(mode==1){
                    let conf:i32=((info>>16) & 255) as i32;
                    let pmax:i32=((info>>12) & 15) as i32;
                    let cmax:i32=((info>>8) & 15) as i32;
                    let win:i32=(info & 255) as i32;
                    _zag_print("|conf=");
                    _zag_print(_zag_i64_to_str(conf as i64));
                    _zag_print("|pmax=");
                    _zag_print(_zag_i64_to_str(pmax as i64));
                    _zag_print("|cmax=");
                    _zag_print(_zag_i64_to_str(cmax as i64));
                    _zag_print("|win=");
                    _zag_print(_zag_i64_to_str(win as i64));
                }
                if(mode==2){
                    let c0:i32=((info>>12) & 15) as i32;
                    let c1:i32=((info>>8) & 15) as i32;
                    let c2:i32=((info>>4) & 15) as i32;
                    let fl:i32=(info & 15) as i32;
                    _zag_print("|ch0=");
                    _zag_print(_zag_i64_to_str(c0 as i64));
                    _zag_print("|ch1=");
                    _zag_print(_zag_i64_to_str(c1 as i64));
                    _zag_print("|ch2=");
                    _zag_print(_zag_i64_to_str(c2 as i64));
                    _zag_print("|flips=");
                    _zag_print(_zag_i64_to_str(fl as i64));
                }
                if(mode==3){
                    let sw:i32=((info>>6) & 63) as i32;
                    let se:i32=(info & 63) as i32;
                    _zag_print("|sw=");
                    _zag_print(_zag_i64_to_str(sw as i64));
                    _zag_print("|se=");
                    _zag_print(_zag_i64_to_str(se as i64));
                }
                if(mode==4){
                    let arg:i32=((info>>4) & 15) as i32;
                    let syn:i32=(info & 15) as i32;
                    _zag_print("|arg=");
                    _zag_print(_zag_i64_to_str(arg as i64));
                    _zag_print("|syn=");
                    _zag_print(_zag_i64_to_str(syn as i64));
                }
                if(mode==5){
                    let v1:i32=((info>>21) & 1) as i32;
                    let v4:i32=((info>>20) & 1) as i32;
                    let v2:i32=((info>>19) & 1) as i32;
                    let fl:i32=((info>>17) & 3) as i32;
                    let sw:i32=((info>>12) & 31) as i32;
                    let se:i32=(info & 63) as i32;
                    _zag_print("|v1=");
                    _zag_print(_zag_i64_to_str(v1 as i64));
                    _zag_print("|v4=");
                    _zag_print(_zag_i64_to_str(v4 as i64));
                    _zag_print("|v2=");
                    _zag_print(_zag_i64_to_str(v2 as i64));
                    _zag_print("|flips=");
                    _zag_print(_zag_i64_to_str(fl as i64));
                    _zag_print("|sw=");
                    _zag_print(_zag_i64_to_str(sw as i64));
                    _zag_print("|se=");
                    _zag_print(_zag_i64_to_str(se as i64));
                }
                _zag_print("\n");
                n=n+1;
            }
        }
        pos=eol+1;
    }
    _zag_print("SUMMARY n=");
    _zag_print(_zag_i64_to_str(n as i64));
    _zag_print(" endorse=");
    _zag_print(_zag_i64_to_str(endorse as i64));
    _zag_print(" withhold=");
    _zag_print(_zag_i64_to_str(withhold as i64));
    _zag_print("\n");
    _zag_print("COST preds_total=");
    _zag_print(_zag_i64_to_str(preds_total));
    _zag_print(" recon_items=0 vflips=0\n");
    return;
}

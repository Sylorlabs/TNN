// adv2_critic.zag — LH-ADV-2 independent critic.
//
// CLEAN-ROOM AUTHORSHIP (see machinery/CONTAMINATION_LOG.md):
//   Derived ONLY from contracts/ (54 frozen behavior contracts) + adv_kb.txt.
//   The author never opened adv_emit.zag / adv2_emit.zag bodies,
//   the old prototype adv_critic.zag body, contracts/_oracle.py,
//   or the sim_* bodies in adv_delib.zag. Op semantics were re-derived
//   from each contract's TEST in=/out= pairs (the frozen ground truth).
//
// Validates by INDEPENDENT RE-DERIVATION: simulates the spec on every
// contract TEST and compares with TEST out=; then compares the emitter
// binary's output with TEST out=. A spec that simulates clean but whose
// binary disagrees is attributed EMITTER-BUG (the seeded negative control).
//
// Usage: adv2_critic verify <stage> <contract> <spec> <binout>
//   Prints CRITIC-ACCEPT or CRITIC-REJECT <reason>.
// Pure Zag, zero RNG. All internal symbols kx_-prefixed: the audit
// (audit_critic_indep2.py) enforces zero shared symbols with the emitter
// and deliberation engine beyond the language entry point.

fn kx_eq(a:[]u8, b:[]u8)i64 {
    if(a.len!=b.len){return 0;}
    let i:i64=0;
    while(i<a.len){
        if(a[i]!=b[i]){return 0;}
        i=i+1;
    }
    return 1;
}

fn kx_find(hay:[]u8, needle:[]u8, from:i64)i64 {
    if(needle.len==0){return from;}
    if(from<0){from=0;}
    let i:i64=from;
    while(i+needle.len<=hay.len){
        let j:i64=0;
        let ok:i64=1;
        while(j<needle.len){
            if(hay[i+j]!=needle[j]){ok=0;}
            j=j+1;
        }
        if(ok==1){return i;}
        i=i+1;
    }
    return -1;
}

fn kx_has(hay:[]u8, needle:[]u8)i64 {
    if(kx_find(hay,needle,0)>=0){return 1;}
    return 0;
}

fn kx_sw(s:[]u8, pre:[]u8)i64 {
    if(s.len<pre.len){return 0;}
    if(kx_eq(s[0..pre.len],pre)==1){return 1;}
    return 0;
}

// value of key= in a |-separated spec (key includes the '='); "" if absent
fn kx_skv(s:[]u8, key:[]u8)[]u8 {
    let p:i64=kx_find(s,key,0);
    if(p<0){let e:[]u8="";return e;}
    let st:i64=p+key.len;
    let e:i64=st;
    while(e<s.len){
        if(s[e]==124){break;}
        e=e+1;
    }
    return s[st..e];
}

fn kx_num(s:[]u8)i64 {
    let v:i64=0;
    let neg:i64=0;
    let i:i64=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48){
            if(c<=57){v=v*10+((c as i64)-48);}
        }
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}

// i64 -> decimal, no trailing newline (print at call site)
fn kx_i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0){
        if(s[s.len-1]==10){return s[0..s.len-1];}
    }
    return s;
}

fn kx_nlines(t:[]u8)i64 {
    let n:i64=0;
    let i:i64=0;
    while(i<t.len){
        if(t[i]==10){n=n+1;}
        i=i+1;
    }
    return n;
}

fn kx_line(t:[]u8, k:i64)[]u8 {
    let n:i64=0;
    let st:i64=0;
    let i:i64=0;
    while(i<=t.len){
        let eol:i64=0;
        if(i==t.len){eol=1;}
        if(eol==0){if(t[i]==10){eol=1;}}
        if(eol==1){
            if(n==k){return t[st..i];}
            n=n+1;
            st=i+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

// value of a contract line starting with pre (pre includes trailing space)
fn kx_cline(c:[]u8, pre:[]u8)[]u8 {
    let nl:i64=kx_nlines(c);
    let i:i64=0;
    while(i<=nl){
        let ln:[]u8=kx_line(c,i);
        if(kx_sw(ln,pre)==1){return ln[pre.len..ln.len];}
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn kx_c_win(contract:[]u8)[]u8 {
    return kx_cline(contract,"WIN ");
}

fn kx_c_ntests(contract:[]u8)i64 {
    let n:i64=0;
    let nl:i64=kx_nlines(contract);
    let i:i64=0;
    while(i<=nl){
        let ln:[]u8=kx_line(contract,i);
        if(kx_sw(ln,"TEST in=")==1){n=n+1;}
        i=i+1;
    }
    return n;
}

fn kx_c_testin(contract:[]u8, k:i64)[]u8 {
    let n:i64=0;
    let nl:i64=kx_nlines(contract);
    let i:i64=0;
    while(i<=nl){
        let ln:[]u8=kx_line(contract,i);
        if(kx_sw(ln,"TEST in=")==1){
            if(n==k){return ln[8..ln.len];}
            n=n+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn kx_c_testout(contract:[]u8, k:i64)[]u8 {
    let n:i64=0;
    let nl:i64=kx_nlines(contract);
    let i:i64=0;
    while(i<=nl){
        let ln:[]u8=kx_line(contract,i);
        if(kx_sw(ln,"TEST out=")==1){
            if(n==k){return ln[9..ln.len];}
            n=n+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

// ---- records: |-separated fields, 1-based ----
fn kx_nf(rec:[]u8)i64 {
    if(rec.len==0){return 0;}
    let n:i64=1;
    let i:i64=0;
    while(i<rec.len){
        if(rec[i]==124){n=n+1;}
        i=i+1;
    }
    return n;
}

fn kx_fg(rec:[]u8, k:i64)[]u8 {
    let n:i64=1;
    let st:i64=0;
    let i:i64=0;
    while(i<=rec.len){
        let eol:i64=0;
        if(i==rec.len){eol=1;}
        if(eol==0){if(rec[i]==124){eol=1;}}
        if(eol==1){
            if(n==k){return rec[st..i];}
            n=n+1;
            st=i+1;
        }
        i=i+1;
    }
    let e:[]u8="";
    return e;
}

fn kx_upbyte(c:u8)u8 {
    if(c>=97){
        if(c<=122){return c-32;}
    }
    return c;
}

fn kx_lobyte(c:u8)u8 {
    if(c>=65){
        if(c<=90){return c+32;}
    }
    return c;
}

// ---- output buffer (pointer-param pattern) ----
struct KxO {
    b:[]u8,
    n:i64,
}

fn kx_on(sz:i64)KxO {
    let o:KxO=KxO{};
    let p:*u8=_zag_malloc(sz) as *u8;
    o.b=p[0..sz];
    o.n=0;
    return o;
}

// []u8 arena allocation (mirrors kx_on's proven pattern)
fn kx_alloc(sz:i64)[]u8 {
    let p:*u8=_zag_malloc(sz) as *u8;
    return p[0..sz];
}

fn kx_raw(o:*KxO, s:[]u8)void {
    let b:[]u8=o.*.b;
    let n:i64=o.*.n;
    let i:i64=0;
    while(i<s.len){
        b[n]=s[i];
        n=n+1;
        i=i+1;
    }
    o.*.n=n;
    return;
}

fn kx_i64(o:*KxO, v:i64)void {
    kx_raw(o,kx_i64s(v));
    return;
}

fn kx_byte(o:*KxO, c:u8)void {
    let b:[]u8=o.*.b;
    let n:i64=o.*.n;
    b[n]=c;
    o.*.n=n+1;
    return;
}

// ---- FIELD ops (per record) ----
fn kx_f_upper(spec:[]u8, rec:[]u8, o:*KxO)void {
    let f:i64=kx_num(kx_skv(spec,"field="));
    let nf:i64=kx_nf(rec);
    let k:i64=1;
    while(k<=nf){
        if(k>1){kx_raw(o,"|");}
        let fld:[]u8=kx_fg(rec,k);
        if(k==f){
            let i:i64=0;
            while(i<fld.len){kx_byte(o,kx_upbyte(fld[i]));i=i+1;}
        } else {
            kx_raw(o,fld);
        }
        k=k+1;
    }
    return;
}

fn kx_f_lower(spec:[]u8, rec:[]u8, o:*KxO)void {
    let f:i64=kx_num(kx_skv(spec,"field="));
    let nf:i64=kx_nf(rec);
    let k:i64=1;
    while(k<=nf){
        if(k>1){kx_raw(o,"|");}
        let fld:[]u8=kx_fg(rec,k);
        if(k==f){
            let i:i64=0;
            while(i<fld.len){kx_byte(o,kx_lobyte(fld[i]));i=i+1;}
        } else {
            kx_raw(o,fld);
        }
        k=k+1;
    }
    return;
}

fn kx_f_clamp(spec:[]u8, rec:[]u8, o:*KxO)void {
    let f:i64=kx_num(kx_skv(spec,"field="));
    let lo:i64=kx_num(kx_skv(spec,"lo="));
    let hi:i64=kx_num(kx_skv(spec,"hi="));
    let nf:i64=kx_nf(rec);
    let k:i64=1;
    while(k<=nf){
        if(k>1){kx_raw(o,"|");}
        if(k==f){
            let v:i64=kx_num(kx_fg(rec,k));
            if(v<lo){v=lo;}
            if(v>hi){v=hi;}
            kx_i64(o,v);
        } else {
            kx_raw(o,kx_fg(rec,k));
        }
        k=k+1;
    }
    return;
}

fn kx_f_mul(spec:[]u8, rec:[]u8, o:*KxO)void {
    let fa:i64=kx_num(kx_skv(spec,"fa="));
    let fb:i64=kx_num(kx_skv(spec,"fb="));
    kx_raw(o,rec);
    kx_raw(o,"|");
    let a:i64=kx_num(kx_fg(rec,fa));
    let b:i64=kx_num(kx_fg(rec,fb));
    kx_i64(o,a*b);
    return;
}

fn kx_f_substr(spec:[]u8, rec:[]u8, o:*KxO)void {
    let f:i64=kx_num(kx_skv(spec,"field="));
    let s:i64=kx_num(kx_skv(spec,"s="));
    let l:i64=kx_num(kx_skv(spec,"l="));
    kx_raw(o,rec);
    kx_raw(o,"|");
    let fld:[]u8=kx_fg(rec,f);
    if(s<fld.len){
        let e:i64=s+l;
        if(e>fld.len){e=fld.len;}
        kx_raw(o,fld[s..e]);
    }
    return;
}

// ---- FILTER predicates (per record -> 1 keep / 0 drop) ----
fn kx_p_gt(spec:[]u8, rec:[]u8)i64 {
    let f:i64=kx_num(kx_skv(spec,"field="));
    let t:i64=kx_num(kx_skv(spec,"threshold="));
    if(kx_num(kx_fg(rec,f))>t){return 1;}
    return 0;
}

fn kx_p_lt(spec:[]u8, rec:[]u8)i64 {
    let f:i64=kx_num(kx_skv(spec,"field="));
    let t:i64=kx_num(kx_skv(spec,"threshold="));
    if(kx_num(kx_fg(rec,f))<t){return 1;}
    return 0;
}

fn kx_p_ge(spec:[]u8, rec:[]u8)i64 {
    let f:i64=kx_num(kx_skv(spec,"field="));
    let t:i64=kx_num(kx_skv(spec,"threshold="));
    if(kx_num(kx_fg(rec,f))>=t){return 1;}
    return 0;
}

fn kx_p_inset(spec:[]u8, rec:[]u8)i64 {
    let f:i64=kx_num(kx_skv(spec,"field="));
    let set:[]u8=kx_skv(spec,"set=");
    let v:[]u8=kx_fg(rec,f);
    let st:i64=0;
    let i:i64=0;
    while(i<=set.len){
        let eol:i64=0;
        if(i==set.len){eol=1;}
        if(eol==0){if(set[i]==44){eol=1;}}
        if(eol==1){
            if(kx_eq(set[st..i],v)==1){return 1;}
            st=i+1;
        }
        i=i+1;
    }
    return 0;
}

fn kx_p_fce(spec:[]u8, rec:[]u8)i64 {
    let n:i64=kx_num(kx_skv(spec,"n="));
    if(kx_nf(rec)==n){return 1;}
    return 0;
}

// 8-byte little-endian i64 accessors on a []u8 arena
fn kx_p64(a:[]u8, off:i64, v:i64)void {
    let k:i64=0;
    let x:i64=v;
    while(k<8){
        a[off+k]=(x as u8);
        x=x/256;
        k=k+1;
    }
    return;
}

fn kx_g64(a:[]u8, off:i64)i64 {
    let v:i64=0;
    let k:i64=7;
    while(k>=0){
        v=v*256+((a[off+k]) as i64);
        k=k-1;
    }
    return v;
}

// ---- AGG (whole input; groups in first-seen order) ----
fn kx_agg(spec:[]u8, tin:[]u8, o:*KxO)void {
    let op:[]u8=kx_skv(spec,"op=");
    let kf:i64=kx_num(kx_skv(spec,"key="));
    let vf:i64=kx_num(kx_skv(spec,"val="));
    let kar:[]u8=kx_alloc(4096);
    let kp:i64=0;
    // group table: 48 groups x 4 i64 (koff,klen,acc,cnt) = 1536 bytes, zeroed
    let tab:[]u8=kx_alloc(1536);
    let z:i64=0;
    while(z<1536){tab[z]=0;z=z+1;}
    let ng:i64=0;
    // iterate records
    let rs:i64=0;
    let ri:i64=0;
    while(ri<=tin.len){
        let eol:i64=0;
        if(ri==tin.len){eol=1;}
        if(eol==0){if(tin[ri]==59){eol=1;}}
        if(eol==1){
            if(ri>rs){
                let rec:[]u8=tin[rs..ri];
                let key:[]u8=kx_fg(rec,kf);
                let val:i64=kx_num(kx_fg(rec,vf));
                // find group
                let g:i64=-1;
                let gi:i64=0;
                while(gi<ng){
                    let bo:i64=gi*32;
                    let ko:i64=kx_g64(tab,bo);
                    let kl:i64=kx_g64(tab,bo+8);
                    if(kx_eq(kar[ko..ko+kl],key)==1){g=gi;}
                    gi=gi+1;
                }
                if(g<0){
                    g=ng;
                    ng=ng+1;
                    let bo2:i64=g*32;
                    kx_p64(tab,bo2,kp);
                    kx_p64(tab,bo2+8,key.len);
                    let ci:i64=0;
                    while(ci<key.len){kar[kp]=key[ci];kp=kp+1;ci=ci+1;}
                    kx_p64(tab,bo2+16,val);
                    kx_p64(tab,bo2+24,1);
                    if(kx_eq(op,"min")==1){kx_p64(tab,bo2+16,val);}
                    if(kx_eq(op,"max")==1){kx_p64(tab,bo2+16,val);}
                } else {
                    let bo3:i64=g*32;
                    let acc:i64=kx_g64(tab,bo3+16);
                    let cnt:i64=kx_g64(tab,bo3+24);
                    if(kx_eq(op,"sum")==1){acc=acc+val;}
                    if(kx_eq(op,"avg")==1){acc=acc+val;}
                    if(kx_eq(op,"min")==1){if(val<acc){acc=val;}}
                    if(kx_eq(op,"max")==1){if(val>acc){acc=val;}}
                    kx_p64(tab,bo3+16,acc);
                    kx_p64(tab,bo3+24,cnt+1);
                }
            }
            rs=ri+1;
        }
        ri=ri+1;
    }
    // emit groups in first-seen order
    let first:i64=1;
    let ge:i64=0;
    while(ge<ng){
        if(first==0){kx_raw(o,";");}
        first=0;
        let bo4:i64=ge*32;
        let ko2:i64=kx_g64(tab,bo4);
        let kl2:i64=kx_g64(tab,bo4+8);
        let acc2:i64=kx_g64(tab,bo4+16);
        let cnt2:i64=kx_g64(tab,bo4+24);
        kx_raw(o,kar[ko2..ko2+kl2]);
        kx_raw(o,"|");
        if(kx_eq(op,"count")==1){
            kx_i64(o,cnt2);
        } else {
            if(kx_eq(op,"avg")==1){
                let av:i64=0;
                if(cnt2>0){av=acc2/cnt2;}
                kx_i64(o,av);
            } else {
                kx_i64(o,acc2);
            }
            kx_raw(o,"|");
            kx_i64(o,cnt2);
        }
        ge=ge+1;
    }
    return;
}

// ---- SORT (whole input, stable) ----
fn kx_sort(spec:[]u8, tin:[]u8, o:*KxO)void {
    let f:i64=kx_num(kx_skv(spec,"field="));
    let desc:i64=0;
    if(kx_has(spec,"order=desc")==1){desc=1;}
    let take:i64=kx_num(kx_skv(spec,"take="));
    let rar:[]u8=kx_alloc(16384);
    let rp:i64=0;
    // index table: 64 entries x 2 i64 (roff, key)
    let tab:[]u8=kx_alloc(1024);
    let z:i64=0;
    while(z<1024){tab[z]=0;z=z+1;}
    let nr:i64=0;
    let rs:i64=0;
    let ri:i64=0;
    while(ri<=tin.len){
        let eol:i64=0;
        if(ri==tin.len){eol=1;}
        if(eol==0){if(tin[ri]==59){eol=1;}}
        if(eol==1){
            if(ri>rs){
                let rec:[]u8=tin[rs..ri];
                let bo:i64=nr*16;
                kx_p64(tab,bo,rp);
                kx_p64(tab,bo+8,kx_num(kx_fg(rec,f)));
                let ci:i64=0;
                while(ci<rec.len){rar[rp]=rec[ci];rp=rp+1;ci=ci+1;}
                rar[rp]=59;
                rp=rp+1;
                nr=nr+1;
            }
            rs=ri+1;
        }
        ri=ri+1;
    }
    // stable insertion sort on key
    let i:i64=1;
    while(i<nr){
        let j:i64=i;
        while(j>0){
            let a:i64=kx_g64(tab,(j-1)*16+8);
            let b:i64=kx_g64(tab,j*16+8);
            let swap:i64=0;
            if(desc==1){
                if(a<b){swap=1;}
            } else {
                if(a>b){swap=1;}
            }
            if(swap==0){j=0;}
            if(swap==1){
                let t0:i64=kx_g64(tab,(j-1)*16);
                let t1:i64=kx_g64(tab,(j-1)*16+8);
                kx_p64(tab,(j-1)*16,kx_g64(tab,j*16));
                kx_p64(tab,(j-1)*16+8,kx_g64(tab,j*16+8));
                kx_p64(tab,j*16,t0);
                kx_p64(tab,j*16+8,t1);
                j=j-1;
            }
        }
        i=i+1;
    }
    let lim:i64=nr;
    if(take>0){
        if(take<lim){lim=take;}
    }
    let e:i64=0;
    while(e<lim){
        if(e>0){kx_raw(o,";");}
        let ro:i64=kx_g64(tab,e*16);
        // record bytes run to the stored ';' (exclusive)
        let q:i64=ro;
        while(rar[q]!=59){kx_byte(o,rar[q]);q=q+1;}
        e=e+1;
    }
    return;
}

// ---- JOIN (whole input; left||right) ----
fn kx_join(spec:[]u8, tin:[]u8, o:*KxO)void {
    let op:[]u8=kx_skv(spec,"op=");
    let k1:i64=kx_num(kx_skv(spec,"key="));
    let k2:i64=kx_num(kx_skv(spec,"key2="));
    let rf:i64=kx_num(kx_skv(spec,"rfields="));
    let sep:i64=kx_find(tin,"||",0);
    let left:[]u8=tin[0..0];
    let right:[]u8=tin[0..0];
    if(sep>=0){
        left=tin[0..sep];
        right=tin[sep+2..tin.len];
    } else {
        left=tin;
    }
    let first:i64=1;
    // iterate left records
    let ls:i64=0;
    let li:i64=0;
    while(li<=left.len){
        let eol:i64=0;
        if(li==left.len){eol=1;}
        if(eol==0){if(left[li]==59){eol=1;}}
        if(eol==1){
            if(li>ls){
                let lr:[]u8=left[ls..li];
                let matched:i64=0;
                let rsi:i64=0;
                let rii:i64=0;
                while(rii<=right.len){
                    let eol2:i64=0;
                    if(rii==right.len){eol2=1;}
                    if(eol2==0){if(right[rii]==59){eol2=1;}}
                    if(eol2==1){
                        if(rii>rsi){
                            let rr:[]u8=right[rsi..rii];
                            let take:i64=0;
                            if(kx_eq(op,"cross_join")==1){take=1;}
                            if(kx_eq(op,"inner_join")==1){
                                if(kx_eq(kx_fg(lr,k1),kx_fg(rr,k2))==1){take=1;}
                            }
                            if(kx_eq(op,"left_join")==1){
                                if(kx_eq(kx_fg(lr,k1),kx_fg(rr,k2))==1){take=1;}
                            }
                            if(take==1){
                                if(first==0){kx_raw(o,";");}
                                first=0;
                                kx_raw(o,lr);
                                kx_raw(o,"|");
                                kx_raw(o,rr);
                                matched=1;
                            }
                        }
                        rsi=rii+1;
                    }
                    rii=rii+1;
                }
                if(kx_eq(op,"left_join")==1){
                    if(matched==0){
                        if(first==0){kx_raw(o,";");}
                        first=0;
                        kx_raw(o,lr);
                        let q:i64=0;
                        while(q<rf){kx_raw(o,"|");q=q+1;}
                    }
                }
            }
            ls=li+1;
        }
        li=li+1;
    }
    return;
}

// ---- FORMAT (per record) ----
fn kx_fmt_template(spec:[]u8, rec:[]u8, o:*KxO)void {
    let tpl:[]u8=kx_skv(spec,"template=");
    let i:i64=0;
    while(i<tpl.len){
        if(tpl[i]==123){
            let j:i64=i+1;
            while(j<tpl.len){
                if(tpl[j]==125){break;}
                j=j+1;
            }
            kx_raw(o,kx_fg(rec,kx_num(tpl[i+1..j])));
            i=j+1;
        } else {
            kx_byte(o,tpl[i]);
            i=i+1;
        }
    }
    return;
}

fn kx_fmt_csv(spec:[]u8, rec:[]u8, o:*KxO)void {
    let nf:i64=kx_nf(rec);
    let k:i64=1;
    while(k<=nf){
        if(k>1){kx_raw(o,",");}
        kx_raw(o,kx_fg(rec,k));
        k=k+1;
    }
    return;
}

fn kx_fmt_kv(spec:[]u8, rec:[]u8, wn:[]u8, o:*KxO)void {
    // wn: name list, ',' or '|' separated
    let nf:i64=kx_nf(rec);
    let k:i64=1;
    let st:i64=0;
    let i:i64=0;
    while(k<=nf){
        if(k>1){kx_raw(o,"|");}
        // k-th name
        let cnt:i64=0;
        let ns:i64=0;
        let ni:i64=0;
        let nm:[]u8=wn[0..0];
        while(ni<=wn.len){
            let eol:i64=0;
            if(ni==wn.len){eol=1;}
            if(eol==0){if(wn[ni]==44){eol=1;}}
            if(eol==0){if(wn[ni]==124){eol=1;}}
            if(eol==1){
                cnt=cnt+1;
                if(cnt==k){nm=wn[ns..ni];}
                ns=ni+1;
            }
            ni=ni+1;
        }
        kx_raw(o,nm);
        kx_raw(o,"=");
        kx_raw(o,kx_fg(rec,k));
        k=k+1;
    }
    return;
}

// ---- dispatch: simulate spec on ;-separated input ----
fn kx_simrec(spec:[]u8, op:[]u8, rec:[]u8, wn:[]u8, o:*KxO)void {
    if(kx_eq(op,"upper")==1){kx_f_upper(spec,rec,o);return;}
    if(kx_eq(op,"lower")==1){kx_f_lower(spec,rec,o);return;}
    if(kx_eq(op,"clamp")==1){kx_f_clamp(spec,rec,o);return;}
    if(kx_eq(op,"mul_fields")==1){kx_f_mul(spec,rec,o);return;}
    if(kx_eq(op,"substr")==1){kx_f_substr(spec,rec,o);return;}
    if(kx_eq(op,"template")==1){kx_fmt_template(spec,rec,o);return;}
    if(kx_eq(op,"csv_line")==1){kx_fmt_csv(spec,rec,o);return;}
    if(kx_eq(op,"kv_line")==1){kx_fmt_kv(spec,rec,wn,o);return;}
    return;
}

fn kx_pred(spec:[]u8, op:[]u8, rec:[]u8)i64 {
    if(kx_eq(op,"int_gt")==1){return kx_p_gt(spec,rec);}
    if(kx_eq(op,"int_lt")==1){return kx_p_lt(spec,rec);}
    if(kx_eq(op,"int_ge")==1){return kx_p_ge(spec,rec);}
    if(kx_eq(op,"in_set")==1){return kx_p_inset(spec,rec);}
    if(kx_eq(op,"field_count_eq")==1){return kx_p_fce(spec,rec);}
    return 0;
}

fn kx_whole(spec:[]u8, op:[]u8, tin:[]u8, o:*KxO)void {
    if(kx_eq(op,"sum")==1){kx_agg(spec,tin,o);return;}
    if(kx_eq(op,"count")==1){kx_agg(spec,tin,o);return;}
    if(kx_eq(op,"avg")==1){kx_agg(spec,tin,o);return;}
    if(kx_eq(op,"min")==1){kx_agg(spec,tin,o);return;}
    if(kx_eq(op,"max")==1){kx_agg(spec,tin,o);return;}
    if(kx_eq(op,"sort_desc")==1){kx_sort(spec,tin,o);return;}
    if(kx_eq(op,"sort_asc")==1){kx_sort(spec,tin,o);return;}
    if(kx_eq(op,"topn")==1){kx_sort(spec,tin,o);return;}
    if(kx_eq(op,"inner_join")==1){kx_join(spec,tin,o);return;}
    if(kx_eq(op,"left_join")==1){kx_join(spec,tin,o);return;}
    if(kx_eq(op,"cross_join")==1){kx_join(spec,tin,o);return;}
    return;
}

fn kx_is_perrec(op:[]u8)i64 {
    if(kx_eq(op,"upper")==1){return 1;}
    if(kx_eq(op,"lower")==1){return 1;}
    if(kx_eq(op,"clamp")==1){return 1;}
    if(kx_eq(op,"mul_fields")==1){return 1;}
    if(kx_eq(op,"substr")==1){return 1;}
    if(kx_eq(op,"template")==1){return 1;}
    if(kx_eq(op,"csv_line")==1){return 1;}
    if(kx_eq(op,"kv_line")==1){return 1;}
    return 0;
}

fn kx_is_filter(op:[]u8)i64 {
    if(kx_eq(op,"int_gt")==1){return 1;}
    if(kx_eq(op,"int_lt")==1){return 1;}
    if(kx_eq(op,"int_ge")==1){return 1;}
    if(kx_eq(op,"in_set")==1){return 1;}
    if(kx_eq(op,"field_count_eq")==1){return 1;}
    return 0;
}

fn kx_known_op(op:[]u8)i64 {
    if(kx_is_perrec(op)==1){return 1;}
    if(kx_is_filter(op)==1){return 1;}
    if(kx_eq(op,"sum")==1){return 1;}
    if(kx_eq(op,"count")==1){return 1;}
    if(kx_eq(op,"avg")==1){return 1;}
    if(kx_eq(op,"min")==1){return 1;}
    if(kx_eq(op,"max")==1){return 1;}
    if(kx_eq(op,"sort_desc")==1){return 1;}
    if(kx_eq(op,"sort_asc")==1){return 1;}
    if(kx_eq(op,"topn")==1){return 1;}
    if(kx_eq(op,"inner_join")==1){return 1;}
    if(kx_eq(op,"left_join")==1){return 1;}
    if(kx_eq(op,"cross_join")==1){return 1;}
    return 0;
}

// simulate spec on ;-separated input, return output bytes
fn kx_sim_all(spec:[]u8, tin:[]u8, wn:[]u8)[]u8 {
    let op:[]u8=kx_skv(spec,"op=");
    let bo:KxO=kx_on(65536);
    let bp:*KxO=&bo;
    if(kx_is_filter(op)==1){
        let rs:i64=0;
        let ri:i64=0;
        let first:i64=1;
        while(ri<=tin.len){
            let eol:i64=0;
            if(ri==tin.len){eol=1;}
            if(eol==0){if(tin[ri]==59){eol=1;}}
            if(eol==1){
                if(ri>rs){
                    if(kx_pred(spec,op,tin[rs..ri])==1){
                        if(first==0){kx_raw(bp,";");}
                        first=0;
                        kx_raw(bp,tin[rs..ri]);
                    }
                }
                rs=ri+1;
            }
            ri=ri+1;
        }
    } else {
        if(kx_is_perrec(op)==1){
            let rs2:i64=0;
            let ri2:i64=0;
            let first2:i64=1;
            while(ri2<=tin.len){
                let eol2:i64=0;
                if(ri2==tin.len){eol2=1;}
                if(eol2==0){if(tin[ri2]==59){eol2=1;}}
                if(eol2==1){
                    if(ri2>rs2){
                        if(first2==0){kx_raw(bp,";");}
                        first2=0;
                        kx_simrec(spec,op,tin[rs2..ri2],wn,bp);
                    }
                    rs2=ri2+1;
                }
                ri2=ri2+1;
            }
        } else {
            kx_whole(spec,op,tin,bp);
        }
    }
    return bo.b[0..bo.n];
}

fn kx_verify(stage:[]u8, contract:[]u8, spec:[]u8, binout:[]u8)void {
    let op:[]u8=kx_skv(spec,"op=");
    if(op.len==0){
        _zag_print("CRITIC-REJECT no-op-in-spec\n");
        return;
    }
    if(kx_known_op(op)==0){
        _zag_print("CRITIC-REJECT unknown-op ");
        _zag_print(op);
        _zag_print("\n");
        return;
    }
    let wn:[]u8=kx_skv(spec,"win=");
    if(wn.len==0){wn=kx_c_win(contract);}
    let nt:i64=kx_c_ntests(contract);
    let k:i64=0;
    while(k<nt){
        let tin:[]u8=kx_c_testin(contract,k);
        let tout:[]u8=kx_c_testout(contract,k);
        let got:[]u8=kx_sim_all(spec,tin,wn);
        if(kx_eq(got,tout)==0){
            _zag_print("CRITIC-REJECT SPEC-MISMATCH test=");
            _zag_print(kx_i64s(k));
            _zag_print(" op=");
            _zag_print(op);
            _zag_print("\n");
            return;
        }
        k=k+1;
    }
    let t1:[]u8=kx_c_testout(contract,0);
    if(kx_eq(binout,t1)==0){
        _zag_print("CRITIC-REJECT EMITTER-BUG op=");
        _zag_print(op);
        _zag_print("\n");
        return;
    }
    _zag_print("CRITIC-ACCEPT\n");
    return;
}

fn main()void {
    let mode:[]u8=_zag_arg(1);
    if(kx_eq(mode,"verify")==1){
        let stage:[]u8=_zag_arg(2);
        let contract:[]u8=_zag_arg(3);
        let spec:[]u8=_zag_arg(4);
        let binout:[]u8=_zag_arg(5);
        kx_verify(stage,contract,spec,binout);
    } else {
        _zag_print("UNKNOWN_MODE\n");
    }
    return;
}

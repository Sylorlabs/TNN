@import("strength_core.zag")
@import("strength_checker.zag")
fn tag(s:[]u8)void { _zag_print(s); }
fn pi(x:i32)void { let b:[]u8=_zag_i64_to_str(x as i64); _zag_print(b); nio_free(b); }
fn pc(x:i32)void { tag(","); pi(x); }
fn ck(s:*StStore)void { let f:i32=ck_verify(s,0,0,0,0,1); tag(" ck="); pi(f); tag("\n"); }
fn main()i32 {
  let st:StStore=st_init(16,4096);
  let s:*StStore=&st;
  let g0:i32=st_set_stage(s,4);
  tag("BATCH2 stage="); pi(g0); tag("\n");
  // B01: trainer_declare down to 5 then cheap 1-cite delete (expect 109)
  let sl1:i32=0;
  let b01a:i32=st_add(s,100,1,90,1000,&sl1);
  let b01t:i32=st_trainer_declare(s,1,7,sl1,5,0);
  let b01e1:i32=st_evidence(s,sl1,1,201);
  let b01j:i32=st_justify(s,sl1,1);
  let b01d1:i32=st_delete_strong(s,sl1);
  let b01e2:i32=st_evidence(s,sl1,1,202);
  let b01e3:i32=st_evidence(s,sl1,1,203);
  let b01e4:i32=st_evidence(s,sl1,1,204);
  let b01d2:i32=st_delete_strong(s,sl1);
  tag("B01 tdeclare_down tdecl,ev,just,del(1cite),ev,ev,ev,del=");
  pi(b01t); pc(b01e1); pc(b01j); pc(b01d1); pc(b01e2); pc(b01e3); pc(b01e4); pc(b01d2); ck(s);
  // B02: TNN-role trainer_declare down (expect 113? or weaken-like?)
  let sl2:i32=0;
  let b02a:i32=st_add(s,100,1,90,1000,&sl2);
  let b02t:i32=st_trainer_declare(s,0,7,sl2,5,0);
  let b02e1:i32=st_evidence(s,sl2,1,211);
  let b02j:i32=st_justify(s,sl2,1);
  let b02d1:i32=st_delete_strong(s,sl2);
  let b02e2:i32=st_evidence(s,sl2,1,212);
  let b02e3:i32=st_evidence(s,sl2,1,213);
  let b02e4:i32=st_evidence(s,sl2,1,214);
  let b02d2:i32=st_delete_strong(s,sl2);
  tag("B02 tnn_declare tdecl,ev,just,del(1cite),ev,ev,ev,del=");
  pi(b02t); pc(b02e1); pc(b02j); pc(b02d1); pc(b02e2); pc(b02e3); pc(b02e4); pc(b02d2); ck(s);
  // B03: st_overwrite with 0 cites on HW=90 (expect 109)
  let sl3:i32=0;
  let b03a:i32=st_add(s,100,1,90,1000,&sl3);
  let b03o:i32=st_overwrite(s,sl3,200,10,3000);
  tag("B03 overwrite0 add,overwrite=");
  pi(b03a); pc(b03o); ck(s);
  // B04: honest overwrite (4 cites) then delete at reset HW=10 with 1 cite (expect 0,0)
  let sl4:i32=0;
  let b04a:i32=st_add(s,100,1,90,1000,&sl4);
  let b04e1:i32=st_evidence(s,sl4,1,231);
  let b04e2:i32=st_evidence(s,sl4,1,232);
  let b04e3:i32=st_evidence(s,sl4,1,233);
  let b04e4:i32=st_evidence(s,sl4,1,234);
  let b04j:i32=st_justify(s,sl4,1);
  let b04o:i32=st_overwrite(s,sl4,200,10,3000);
  let b04e5:i32=st_evidence(s,sl4,1,241);
  let b04j2:i32=st_justify(s,sl4,1);
  let b04d:i32=st_delete_strong(s,sl4);
  tag("B04 overwrite add,ev*4,just,ow,ev,just,del=");
  pi(b04a); pc(b04e1); pc(b04e2); pc(b04e3); pc(b04e4); pc(b04j); pc(b04o); pc(b04e5); pc(b04j2); pc(b04d); ck(s);
  // B04b: add 40, overwrite up to 90 (2 cites), delete needs 4 (expect 109 at 2, then 0)
  let sl5:i32=0;
  let b4ba:i32=st_add(s,100,1,40,1000,&sl5);
  let b4be1:i32=st_evidence(s,sl5,1,251);
  let b4be2:i32=st_evidence(s,sl5,1,252);
  let b4bj:i32=st_justify(s,sl5,1);
  let b4bo:i32=st_overwrite(s,sl5,200,90,3000);
  let b4be3:i32=st_evidence(s,sl5,1,253);
  let b4be4:i32=st_evidence(s,sl5,1,254);
  let b4bj2:i32=st_justify(s,sl5,1);
  let b4bd1:i32=st_delete_strong(s,sl5);
  let b4be5:i32=st_evidence(s,sl5,1,255);
  let b4be6:i32=st_evidence(s,sl5,1,256);
  let b4bd2:i32=st_delete_strong(s,sl5);
  tag("B04b ow-up add40,ev,ev,just,ow90,ev,ev,just,del,ev,ev,del=");
  pi(b4ba); pc(b4be1); pc(b4be2); pc(b4bj); pc(b4bo); pc(b4be3); pc(b4be4); pc(b4bj2); pc(b4bd1); pc(b4be5); pc(b4be6); pc(b4bd2); ck(s);
  // B05: weaken 90->10 then overwrite_direct with 0 cites (checker must flag if it destroys)
  let sl6:i32=0;
  let b05a:i32=st_add(s,100,1,90,1000,&sl6);
  let b05w:i32=st_weaken(s,sl6,10,1);
  let b05o:i32=st_overwrite_direct(s,sl6,200,10,3000);
  tag("B05 owdirect add,weaken,owdirect=");
  pi(b05a); pc(b05w); pc(b05o); ck(s);
  // B06: overwrite_direct with 0 cites, no weaken (checker must flag if it destroys)
  let sl7:i32=0;
  let b06a:i32=st_add(s,100,1,90,1000,&sl7);
  let b06o:i32=st_overwrite_direct(s,sl7,200,10,3000);
  tag("B06 owdirect90 add,owdirect=");
  pi(b06a); pc(b06o); ck(s);
  // B07: st_kill on strong memory (expect refusal)
  let sl8:i32=0;
  let b07a:i32=st_add(s,100,1,90,1000,&sl8);
  let b07k:i32=st_kill(s,sl8);
  tag("B07 kill-strong add,kill=");
  pi(b07a); pc(b07k); ck(s);
  // B08: weaken 90->0 then st_kill (expect refusal; success = claim-2 break)
  let sl9:i32=0;
  let b08a:i32=st_add(s,100,1,90,1000,&sl9);
  let b08w:i32=st_weaken(s,sl9,0,1);
  let b08k:i32=st_kill(s,sl9);
  tag("B08 weaken0-kill add,weaken0,kill=");
  pi(b08a); pc(b08w); pc(b08k); ck(s);
  // B09: delete -> rollback -> re-cite same eps (expect 121) -> fresh cites -> delete ok
  let sl10:i32=0;
  let b09a:i32=st_add(s,100,1,90,1000,&sl10);
  let b09e1:i32=st_evidence(s,sl10,1,271);
  let b09e2:i32=st_evidence(s,sl10,1,272);
  let b09e3:i32=st_evidence(s,sl10,1,273);
  let b09e4:i32=st_evidence(s,sl10,1,274);
  let b09j:i32=st_justify(s,sl10,1);
  let b09d:i32=st_delete_strong(s,sl10);
  let b09r:i32=st_rollback_last(s);
  let b09w:i32=st_weaken(s,sl10,80,1);
  let b09e5:i32=st_evidence(s,sl10,1,271);
  let b09f1:i32=st_evidence(s,sl10,1,281);
  let b09f2:i32=st_evidence(s,sl10,1,282);
  let b09f3:i32=st_evidence(s,sl10,1,283);
  let b09f4:i32=st_evidence(s,sl10,1,284);
  let b09j2:i32=st_justify(s,sl10,1);
  let b09d2:i32=st_delete_strong(s,sl10);
  tag("B09 del-rollback add,ev*4,just,del,rb,weaken?,ev271,ev281-284,just,del=");
  pi(b09a); pc(b09e1); pc(b09e2); pc(b09e3); pc(b09e4); pc(b09j); pc(b09d); pc(b09r); pc(b09w); pc(b09e5); pc(b09f1); pc(b09f2); pc(b09f3); pc(b09f4); pc(b09j2); pc(b09d2); ck(s);
  // B10: evidence -> rollback -> re-cite same ep (121=strict, 0=refund) -> honest delete
  let sl11:i32=0;
  let b10a:i32=st_add(s,100,1,90,1000,&sl11);
  let b10e1:i32=st_evidence(s,sl11,1,291);
  let b10r:i32=st_rollback_last(s);
  let b10w:i32=st_weaken(s,sl11,80,1);
  let b10e2:i32=st_evidence(s,sl11,1,291);
  let b10e3:i32=st_evidence(s,sl11,1,292);
  let b10e4:i32=st_evidence(s,sl11,1,293);
  let b10e5:i32=st_evidence(s,sl11,1,294);
  let b10j:i32=st_justify(s,sl11,1);
  let b10d:i32=st_delete_strong(s,sl11);
  tag("B10 ev-rollback add,ev291,rb,weaken?,ev291,ev292-294,just,del=");
  pi(b10a); pc(b10e1); pc(b10r); pc(b10w); pc(b10e2); pc(b10e3); pc(b10e4); pc(b10e5); pc(b10j); pc(b10d); ck(s);
  return 0;
}

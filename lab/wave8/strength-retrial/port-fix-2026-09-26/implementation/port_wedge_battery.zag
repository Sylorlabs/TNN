// port_wedge_battery.zag — delete-strong-mainline port of the F6 wedge-fix
// attack battery. W1..W7 are VERBATIM the F6 workstream's battery (same
// driver-local helper names); W8 is port-new: delete-path x GLOBAL
// consumption composition (DELETE_STRONG and the trainer priced-kill path
// burn cites store-wide under G).
// Runs against the FIXED core. Every suite prints WB lines; the process
// exits 0 and prints WB_VERDICT fail=<n>. Run twice; outputs must be
// byte-identical (cmp).
@import("strength_checker.zag")

fn wb_pi(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    _zag_str_free(s);
    return;
}
fn wb_check(name:[]u8,got:i32,exp:i32,fail:*i32)void {
    _zag_print("WB ");_zag_print(name);
    _zag_print(" got=");wb_pi(got as i64);
    _zag_print(" exp=");wb_pi(exp as i64);
    if(got==exp){_zag_print(" ok\n");} else {_zag_print(" MISMATCH\n");fail.*=fail.*+1;}
    return;
}
fn wb_count_sig(s:*StStore,op:i32)i32 {    let n:i32=0;let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==op && st_aw(s,i,4)==ST_OK){n=n+1;}
        i=i+1;
    }
    return n;
}
// Field readers for main's struct-VALUE locals (pass &local; field access
// happens inside on the pointer -- never `.*` on a value).
fn wb_live(s:*StStore,slot:i32)i32 {return s.*.live[slot] as i32;}
fn wb_strength(s:*StStore,slot:i32)i32 {return s.*.strength[slot] as i32;}
fn wb_audit_n(s:*StStore)i32 {return s.*.audit_n;}
fn wb_new_g(s:*StStore)void {
    let c0:i32=0;let c1:i32=0;
    st_add_core(s,95,-1,&c0);
    st_add_core(s,90,-1,&c1);
    st_set_stage(s,ST_STAGE_FULL);
    return;
}
// add90 + cite eps[0..3] + justify; returns slot
fn wb_arm90(s:*StStore,eps:[]u8,slot_out:*i32)void {
    let ns:i32=-1;
    st_add(s,900,ST_REGION_USER,90,0,&ns);
    slot_out.*=ns;
    let k:i32=0;
    while(k<4){st_evidence(s,ns,ST_J_CONTRADICTED,eps[k] as i32);k=k+1;}
    st_justify(s,ns,ST_J_CONTRADICTED);
    return;
}
fn wb_ep4(a:i32,b:i32,c:i32,d:i32)[]u8 {
    let e:[]u8=nio_alloc(4);
    e[0]=a as u8;e[1]=b as u8;e[2]=c as u8;e[3]=d as u8;
    return e;
}
// Drive the full 14-slot cite-lock wedge from pool P=8 (episodes 0..7).
// Prints slot/sys signal counts at the end.
fn wb_drive_wedge(s:*StStore,fail:*i32)void {
    let e0:[]u8=wb_ep4(0,1,2,3);
    let e1:[]u8=wb_ep4(4,5,6,7);
    let ns:i32=-1;let krc:i32=0;
    // two honest kills consume the whole pool
    wb_arm90(s,e0,&ns);krc=st_kill_evidenced(s,ns);
    wb_check("wedge_kill1",krc,0,fail);
    wb_arm90(s,e1,&ns);krc=st_kill_evidenced(s,ns);
    wb_check("wedge_kill2",krc,0,fail);
    // 14 slots x stale pool cites -> 121 each
    let n:i32=0;let r121:i32=0;
    while(n<14){
        wb_arm90(s,e0,&ns);
        krc=st_kill_evidenced(s,ns);
        if(krc==121){r121=r121+1;}
        n=n+1;
    }
    wb_check("wedge_r121",r121,14,fail);
    wb_check("wedge_sig_slot",wb_count_sig(s,ST_OP_CITELOCK),14,fail);
    wb_check("wedge_sig_sys",wb_count_sig(s,ST_OP_CITELOCK_SYS),1,fail);
    nio_free(e0);nio_free(e1);
    return;
}
fn wb_tail_checks(s:*StStore,tag:[]u8,fail:*i32)void {
    let r1:i32=st_refusals_clean(s);
    let r2:i32=st_replay_check(s);
    let f:i32=ck_verify(s,0,0,0,500,1);
    _zag_print("WB ");_zag_print(tag);
    _zag_print(" refusals_clean=");wb_pi(r1 as i64);
    _zag_print(" replay=");wb_pi(r2 as i64);
    _zag_print(" ckfail=");wb_pi(f as i64);
    if(r1==0 && r2==0 && f==0){_zag_print(" ok\n");}
    else {_zag_print(" MISMATCH\n");fail.*=fail.*+1;}
    return;
}

fn main()void {
    let fail:i32=0;

    // ---------- W1: full cite-lock + double-spend battery ----------
    let s1:StStore=st_init(16,65536);
    st_set_cite_mode(&s1,ST_CITE_GLOBAL);
    wb_new_g(&s1);
    wb_drive_wedge(&s1,&fail);
    // store is full: ADD -> 104
    let ns:i32=-1;
    wb_check("w1_add_full",st_add(&s1,901,ST_REGION_USER,90,0,&ns),104,&fail);
    // double-spend battery on locked slot 3 (window: ADD, cites 0..3 consumed)
    wb_check("w1_kill_stale",st_kill_evidenced(&s1,3),121,&fail);
    wb_check("w1_ow_stale",st_overwrite(&s1,3,950,90,0),121,&fail);
    wb_check("w1_rb_signal",st_rollback_last(&s1),108,&fail);
    wb_check("w1_live_after_rb",wb_live(&s1,3),1,&fail);
    wb_check("w1_str_after_rb",wb_strength(&s1,3),90,&fail);
    wb_check("w1_weak0",st_weaken(&s1,3,0,ST_J_CONTRADICTED),0,&fail);
    let e0:[]u8=wb_ep4(0,1,2,3);
    let k:i32=0;
    while(k<4){st_evidence(&s1,3,ST_J_CONTRADICTED,k);k=k+1;}
    st_justify(&s1,3,ST_J_CONTRADICTED);
    wb_check("w1_kill_hw_stale",st_kill_evidenced(&s1,3),121,&fail);
    let ef:[]u8=wb_ep4(100,101,102,103);
    k=0;
    while(k<4){st_evidence(&s1,3,ST_J_CONTRADICTED,100+k);k=k+1;}
    st_justify(&s1,3,ST_J_CONTRADICTED);
    wb_check("w1_kill_hw_fresh",st_kill_evidenced(&s1,3),0,&fail);
    wb_check("w1_add_after",st_add(&s1,902,ST_REGION_USER,90,0,&ns),0,&fail);
    wb_check("w1_add_slot",ns,3,&fail);
    k=0;
    while(k<4){st_evidence(&s1,3,ST_J_CONTRADICTED,100+k);k=k+1;}
    st_justify(&s1,3,ST_J_CONTRADICTED);
    wb_check("w1_kill_tombstoned",st_kill_evidenced(&s1,3),121,&fail);
    // sweep: stale kill on every user slot -> 121
    let sl:i32=2;let sw:i32=0;
    while(sl<16){
        if(st_kill_evidenced(&s1,sl)==121){sw=sw+1;}
        sl=sl+1;
    }
    wb_check("w1_sweep121",sw,14,&fail);
    wb_check("w1_sig_slot_end",wb_count_sig(&s1,ST_OP_CITELOCK),32,&fail);
    wb_check("w1_sig_sys_end",wb_count_sig(&s1,ST_OP_CITELOCK_SYS),3,&fail);
    // trainer paths at the wedge: role-gated, audited; the re-declared
    // judgment needs its own fresh cites (window reset -> 109, never free)
    wb_check("w1_td_tnn_role",st_trainer_declare(&s1,ST_ROLE_TNN,1,2,50,0),113,&fail);
    wb_check("w1_td_trainer",st_trainer_declare(&s1,ST_ROLE_TRAINER,1,2,50,0),0,&fail);
    wb_check("w1_kill_after_td",st_kill_evidenced(&s1,2),109,&fail);
    wb_tail_checks(&s1,"w1_tail",&fail);
    nio_free(e0);nio_free(ef);

    // ---------- W2: D4 cross-slot (S24) ----------
    let s2:StStore=st_init(16,65536);
    st_set_cite_mode(&s2,ST_CITE_GLOBAL);
    wb_new_g(&s2);
    let e0b:[]u8=wb_ep4(0,1,2,3);
    wb_arm90(&s2,e0b,&ns);
    wb_check("w2_ow",st_overwrite(&s2,ns,950,90,0),0,&fail);
    wb_arm90(&s2,e0b,&ns);
    wb_check("w2_xslot",st_kill_evidenced(&s2,ns),121,&fail);
    wb_tail_checks(&s2,"w2_tail",&fail);
    nio_free(e0b);

    // ---------- W3: H16/H17 under G ----------
    let s3:StStore=st_init(16,65536);
    st_set_cite_mode(&s3,ST_CITE_GLOBAL);
    wb_new_g(&s3);
    let e1:[]u8=wb_ep4(1,2,3,4);
    wb_arm90(&s3,e1,&ns);wb_check("w3_h16_k1",st_kill_evidenced(&s3,ns),0,&fail);
    wb_arm90(&s3,e1,&ns);wb_check("w3_h16_k2",st_kill_evidenced(&s3,ns),121,&fail);
    let s3b:StStore=st_init(16,65536);
    st_set_cite_mode(&s3b,ST_CITE_GLOBAL);
    wb_new_g(&s3b);
    wb_arm90(&s3b,e1,&ns);wb_check("w3_h17_k1",st_kill_evidenced(&s3b,ns),0,&fail);
    wb_arm90(&s3b,e1,&ns);
    // strength bump BEFORE citing: cites land in-window, but the episodes
    // are tombstoned globally -> 121 (pre-fix: 0, per-slot consumption hole)
    st_strengthen(&s3b,ns,95,ST_J_CONTRADICTED);
    k=0;
    while(k<4){st_evidence(&s3b,ns,ST_J_CONTRADICTED,1+k);k=k+1;}
    st_justify(&s3b,ns,ST_J_CONTRADICTED);
    wb_check("w3_h17_k2",st_kill_evidenced(&s3b,ns),121,&fail);
    wb_tail_checks(&s3,"w3_tail",&fail);
    wb_tail_checks(&s3b,"w3b_tail",&fail);
    nio_free(e1);

    // ---------- W4: D2 high-water pricing ----------
    let s4:StStore=st_init(16,65536);
    st_set_cite_mode(&s4,ST_CITE_GLOBAL);
    wb_new_g(&s4);
    let e0c:[]u8=wb_ep4(0,1,2,3);
    wb_arm90(&s4,e0c,&ns);wb_check("w4_seed_kill",st_kill_evidenced(&s4,ns),0,&fail);
    // (a) WEAK0 -> JUST -> KILL, zero cites: refused (109), never free
    wb_arm90(&s4,e0c,&ns);
    wb_check("w4a_weak0",st_weaken(&s4,ns,0,ST_J_CONTRADICTED),0,&fail);
    st_justify(&s4,ns,ST_J_CONTRADICTED);
    wb_check("w4a_kill_nocite",st_kill_evidenced(&s4,ns),109,&fail);
    // (b) WEAK0 + stale cites: 121 (high-water price still due)
    k=0;
    while(k<4){st_evidence(&s4,ns,ST_J_CONTRADICTED,k);k=k+1;}
    st_justify(&s4,ns,ST_J_CONTRADICTED);
    wb_check("w4b_kill_stale",st_kill_evidenced(&s4,ns),121,&fail);
    // (c) WEAK0 + 4 fresh cites: pays the full high-water price -> 0
    k=0;
    while(k<4){st_evidence(&s4,ns,ST_J_CONTRADICTED,100+k);k=k+1;}
    st_justify(&s4,ns,ST_J_CONTRADICTED);
    wb_check("w4c_kill_fresh",st_kill_evidenced(&s4,ns),0,&fail);
    // (d) WEAK50 (not 0) + 4 fresh: HW=90 -> need 4 -> 0
    wb_arm90(&s4,e0c,&ns);
    wb_check("w4d_weak50",st_weaken(&s4,ns,50,ST_J_CONTRADICTED),0,&fail);
    k=0;
    while(k<4){st_evidence(&s4,ns,ST_J_CONTRADICTED,110+k);k=k+1;}
    st_justify(&s4,ns,ST_J_CONTRADICTED);
    wb_check("w4d_kill",st_kill_evidenced(&s4,ns),0,&fail);
    // (e) overwrite path priced at high-water too
    wb_arm90(&s4,e0c,&ns);
    wb_check("w4e_weak0",st_weaken(&s4,ns,0,ST_J_CONTRADICTED),0,&fail);
    k=0;
    while(k<4){st_evidence(&s4,ns,ST_J_CONTRADICTED,120+k);k=k+1;}
    st_justify(&s4,ns,ST_J_CONTRADICTED);
    wb_check("w4e_ow",st_overwrite(&s4,ns,950,90,0),0,&fail);
    wb_tail_checks(&s4,"w4_tail",&fail);
    nio_free(e0c);

    // ---------- W5: signal gaming ----------
    let s5:StStore=st_init(16,65536);
    st_set_cite_mode(&s5,ST_CITE_GLOBAL);
    wb_new_g(&s5);
    let e1b:[]u8=wb_ep4(1,2,3,4);
    wb_arm90(&s5,e1b,&ns);wb_check("w5_seed",st_kill_evidenced(&s5,ns),0,&fail);
    let sig0:i32=wb_count_sig(&s5,ST_OP_CITELOCK);
    // (a) 121 on a NON-locked slot: 4 stale + 2 fresh, cnt=2 != 4 -> 121, no signal
    wb_arm90(&s5,e1b,&ns);
    st_evidence(&s5,ns,ST_J_CONTRADICTED,5);st_evidence(&s5,ns,ST_J_CONTRADICTED,6);
    st_justify(&s5,ns,ST_J_CONTRADICTED);
    wb_check("w5a_kill",st_kill_evidenced(&s5,ns),121,&fail);
    wb_check("w5a_no_sig",wb_count_sig(&s5,ST_OP_CITELOCK),sig0,&fail);
    // (b) signal does not perturb: 2 more fresh cites complete the price -> 0
    st_evidence(&s5,ns,ST_J_CONTRADICTED,7);st_evidence(&s5,ns,ST_J_CONTRADICTED,8);
    st_justify(&s5,ns,ST_J_CONTRADICTED);
    wb_check("w5b_kill",st_kill_evidenced(&s5,ns),0,&fail);
    // (c) RB of a signal and of its 121 -> 108, state unchanged
    let e2:[]u8=wb_ep4(11,12,13,14);
    wb_arm90(&s5,e2,&ns);wb_check("w5c_seed2",st_kill_evidenced(&s5,ns),0,&fail);
    wb_arm90(&s5,e2,&ns);wb_check("w5c_kill121",st_kill_evidenced(&s5,ns),121,&fail);
    wb_check("w5c_rb_sig",st_rollback_last(&s5),108,&fail);
    wb_check("w5c_live",wb_live(&s5,ns),1,&fail);
    wb_check("w5c_str",wb_strength(&s5,ns),90,&fail);
    nio_free(e2);
    wb_tail_checks(&s5,"w5_tail",&fail);
    nio_free(e1b);

    // ---------- W6: fresh-episode recovery from full cite-lock ----------
    let s6:StStore=st_init(16,65536);
    st_set_cite_mode(&s6,ST_CITE_GLOBAL);
    wb_new_g(&s6);
    wb_drive_wedge(&s6,&fail);
    let ef6:[]u8=wb_ep4(100,101,102,103);
    k=0;
    while(k<4){st_evidence(&s6,2,ST_J_CONTRADICTED,100+k);k=k+1;}
    st_justify(&s6,2,ST_J_CONTRADICTED);
    wb_check("w6_recover_kill",st_kill_evidenced(&s6,2),0,&fail);
    wb_check("w6_recover_add",st_add(&s6,903,ST_REGION_USER,90,0,&ns),0,&fail);
    wb_check("w6_recover_slot",ns,2,&fail);
    wb_check("w6_unlocked",st_slot_citelocked(&s6,2,wb_audit_n(&s6)),0,&fail);
    wb_tail_checks(&s6,"w6_tail",&fail);
    nio_free(ef6);

    // ---------- W7: cheap lock attempt + audit-path integrity ----------
    let s7:StStore=st_init(16,65536);
    st_set_cite_mode(&s7,ST_CITE_GLOBAL);
    wb_new_g(&s7);
    let e0d:[]u8=wb_ep4(0,1,2,3);
    // (a) citing alone never locks: no destruction, nothing consumed
    wb_arm90(&s7,e0d,&ns);
    wb_check("w7a_not_locked",st_slot_citelocked(&s7,ns,wb_audit_n(&s7)),0,&fail);
    wb_check("w7a_honest_kill",st_kill_evidenced(&s7,ns),0,&fail);
    // (b) wedge one slot; RB of the 121 and of the signal -> 108 both
    wb_arm90(&s7,e0d,&ns);
    wb_check("w7b_kill121",st_kill_evidenced(&s7,ns),121,&fail);
    wb_check("w7b_sig",wb_count_sig(&s7,ST_OP_CITELOCK),1,&fail);
    wb_check("w7b_rb_sig",st_rollback_last(&s7),108,&fail);
    // 121 is now last again (the refused RB appended after the signal)
    wb_check("w7b_rb_121",st_rollback_last(&s7),108,&fail);
    wb_check("w7b_live",wb_live(&s7,ns),1,&fail);
    wb_check("w7b_str",wb_strength(&s7,ns),90,&fail);
    // (c) signals are never destructions: exactly 1 OK destruction so far
    let destr:i32=0;let ii:i32=0;
    while(ii<wb_audit_n(&s7)){
        let oo:i32=st_aw(&s7,ii,0);
        if((oo==ST_OP_KILL_EVIDENCED || oo==ST_OP_OVERWRITE) && st_aw(&s7,ii,4)==ST_OK){destr=destr+1;}
        ii=ii+1;
    }
    wb_check("w7c_destr",destr,1,&fail);
    wb_tail_checks(&s7,"w7_tail",&fail);
    nio_free(e0d);


    // ---------- W8 (PORT): delete-path x GLOBAL consumption composition ----------
    // (fresh episode buffer: e0d was freed at the end of W7)
    let e8:[]u8=wb_ep4(0,1,2,3);
    // W8a: DELETE_STRONG burns cites store-wide; a new ADD re-citing the same
    // episodes -> DELETE_STRONG -> 121 (S-D2 tombstone under G).
    let s8a:StStore=st_init(16,4096);
    st_set_cite_mode(&s8a,ST_CITE_GLOBAL);
    wb_new_g(&s8a);
    wb_arm90(&s8a,e8,&ns);
    wb_check("w8a_d1",st_delete_strong(&s8a,ns),0,&fail);
    wb_arm90(&s8a,e8,&ns);
    wb_check("w8a_d2_121",st_delete_strong(&s8a,ns),121,&fail);
    wb_check("w8a_locked",st_slot_citelocked(&s8a,ns,wb_audit_n(&s8a)),1,&fail);
    wb_check("w8a_sig",wb_count_sig(&s8a,ST_OP_CITELOCK),1,&fail);
    wb_check("w8a_sys",wb_count_sig(&s8a,ST_OP_CITELOCK_SYS),0,&fail);
    wb_tail_checks(&s8a,"w8a_tail",&fail);
    // W8b: the trainer priced-kill path burns cites store-wide; a later
    // kill_evidenced citing the same episodes -> 121 (D4 for KILL).
    let s8b:StStore=st_init(16,4096);
    st_set_cite_mode(&s8b,ST_CITE_GLOBAL);
    wb_new_g(&s8b);
    wb_arm90(&s8b,e8,&ns);
    wb_check("w8b_k1",st_kill(&s8b,ns,ST_ROLE_TRAINER,7),0,&fail);
    wb_arm90(&s8b,e8,&ns);
    wb_check("w8b_k2_121",st_kill_evidenced(&s8b,ns),121,&fail);
    wb_check("w8b_sig",wb_count_sig(&s8b,ST_OP_CITELOCK),1,&fail);
    wb_tail_checks(&s8b,"w8b_tail",&fail);
    // W8c: delete -> rollback -> weaken -> re-cite -> delete -> 121
    // (D14 no-resurrection under G, via the one-step delete path).
    let s8c:StStore=st_init(16,4096);
    st_set_cite_mode(&s8c,ST_CITE_GLOBAL);
    wb_new_g(&s8c);
    wb_arm90(&s8c,e8,&ns);
    wb_check("w8c_d1",st_delete_strong(&s8c,ns),0,&fail);
    wb_check("w8c_rb",st_rollback_last(&s8c),0,&fail);
    wb_check("w8c_weak",st_weaken(&s8c,ns,0,ST_J_CONTRADICTED),0,&fail);
    let k8:i32=0;
    while(k8<4){st_evidence(&s8c,ns,ST_J_CONTRADICTED,e8[k8] as i32);k8=k8+1;}
    st_justify(&s8c,ns,ST_J_CONTRADICTED);
    wb_check("w8c_d2_121",st_delete_strong(&s8c,ns),121,&fail);
    wb_check("w8c_sig",wb_count_sig(&s8c,ST_OP_CITELOCK),1,&fail);
    wb_tail_checks(&s8c,"w8c_tail",&fail);
    // W8d: cross-slot DELETE_STRONG double-spend — slot A burns 0..3,
    // slot B citing 0..3 -> DELETE_STRONG -> 121 (D4 for DELETE_STRONG).
    let s8d:StStore=st_init(16,4096);
    st_set_cite_mode(&s8d,ST_CITE_GLOBAL);
    wb_new_g(&s8d);
    let nsA:i32=-1;let nsB:i32=-1;
    wb_arm90(&s8d,e8,&nsA);
    wb_check("w8d_dA",st_delete_strong(&s8d,nsA),0,&fail);
    wb_arm90(&s8d,e8,&nsB);
    wb_check("w8d_dB_121",st_delete_strong(&s8d,nsB),121,&fail);
    wb_check("w8d_sig",wb_count_sig(&s8d,ST_OP_CITELOCK),1,&fail);
    wb_tail_checks(&s8d,"w8d_tail",&fail);

    nio_free(e8);
    _zag_print("WB_VERDICT fail=");wb_pi(fail as i64);_zag_print("\n");
    return;
}

// f2_attack.zag — F2 iteration attack battery (fresh blind variants).
// Attacks the DIRECT overwrite path (st_overwrite_direct) and the weaken gate.
// Each attack builds a fresh ledger, runs mechanism ops, then ck_verify
// (arm=2, gate_mode=1 — same as the R4 redteam driver) and prints F2_* lines.
// Pure Zag, zero RNG, deterministic — run twice, diff byte-for-byte.
// Build from r4val/: imports resolve relative to cwd.
@import("trial/strength_core.zag")
@import("trial/strength_checker.zag")

fn f2_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn f2_tag(t:[]u8)void {
    _zag_print(t);
}
fn f2_setup(sp:*StStore,str:i32)i32 {
    let cs:i32=-1;
    st_add_core(sp,9001,-1,&cs);
    st_add_core(sp,9002,-1,&cs);
    st_set_stage(sp,ST_STAGE_FULL);
    let sl:i32=-1;
    st_add(sp,1001,ST_REGION_USER,str,0,&sl);
    return sl;
}
fn f2_find_ow(sp:*StStore,slot:i32,after:i32)i32 {
    let i:i32=after;
    while(i<sp.*.audit_n){
        if(st_aw(sp,i,0)==ST_OP_OVERWRITE && st_aw(sp,i,1)==slot &&
           st_aw(sp,i,4)==ST_OK){return i;}
        i=i+1;
    }
    return -1;
}
fn f2_ck(sp:*StStore)i32 {
    return ck_verify(sp,2,0,0,500,1);
}
fn f2_cites(sp:*StStore,slot:i32,from:i32,to:i32)void {
    let e:i32=from;
    while(e<=to){
        st_evidence(sp,slot,ST_J_CONTRADICTED,e);
        e=e+1;
    }
}
// ---- F2A1: original A3 — weaken(90->10), 1 cite, justify, DIRECT. ----
fn f2_a1()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let owi:i32=f2_find_ow(sp,x,0);
    let b4s:i32=-1;let a4s:i32=-1;
    if(owi>=0){b4s=(st_aw(sp,owi,8)&255);a4s=(st_aw(sp,owi,14)&255);}
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A1 origA3 wk_rc=");f2_pi(wk as i64);
    f2_tag(" ow_rc=");f2_pi(ow as i64);
    f2_tag(" before=");f2_pi(b4s as i64);
    f2_tag(" after=");f2_pi(a4s as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A2: weaken to 0, then DIRECT with 0 cites. ----
fn f2_a2()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    let wk:i32=st_weaken(sp,x,0,ST_J_CONTRADICTED);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A2 weaken0+direct0cite wk_rc=");f2_pi(wk as i64);
    f2_tag(" ow_rc=");f2_pi(ow as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A3: double weaken 90->50->10, cites split across steps. ----
fn f2_a3()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    f2_cites(sp,x,11,12);
    let wk1:i32=st_weaken(sp,x,50,ST_J_CONTRADICTED);
    let wk2:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,13);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A3 dblweaken wk1_rc=");f2_pi(wk1 as i64);
    f2_tag(" wk2_rc=");f2_pi(wk2 as i64);
    f2_tag(" ow_rc=");f2_pi(ow as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A4: CONTROL — direct overwrite, NO weaken, 1 cite.
// The original R4 position-(a) kill; must STILL be flagged. ----
fn f2_a4()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A4 control_noweaken ow_rc=");f2_pi(ow as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A5legit: weaken, then FULL high-water price paid in-window.
// Legitimate path — must PASS verification under both forks. ----
fn f2_a5()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    f2_cites(sp,x,11,14);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A5 legit_fullprice wk_rc=");f2_pi(wk as i64);
    f2_tag(" ow_rc=");f2_pi(ow as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A6: strengthen 20->90, weaken->10, then DIRECT with 1 cite. ----
fn f2_a6()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,20);
    let sn:i32=st_strengthen(sp,x,90,ST_J_CORROBORATED);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A6 str90_weaken10 sn_rc=");f2_pi(sn as i64);
    f2_tag(" wk_rc=");f2_pi(wk as i64);
    f2_tag(" ow_rc=");f2_pi(ow as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A7: downward STRENGTHEN as the discount vehicle (no st_weaken).
// Must not bypass the fix. ----
fn f2_a7()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    let sn:i32=st_strengthen(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A7 strengthen_down sn_rc=");f2_pi(sn as i64);
    f2_tag(" ow_rc=");f2_pi(ow as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A8: weaken->FUSED overwrite cross-check (the F1 hole shape). ----
fn f2_a8()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite(sp,x,2002,10,1);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A8 weaken+fused wk_rc=");f2_pi(wk as i64);
    f2_tag(" ow_rc=");f2_pi(ow as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A9: weaken->KILL_EVIDENCED (kill-path mirror). ----
fn f2_a9()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let kr:i32=st_kill_evidenced(sp,x);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A9 weaken+kill wk_rc=");f2_pi(wk as i64);
    f2_tag(" kill_rc=");f2_pi(kr as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A10: discount pre-paid BEFORE the weaken (3 cites), then 1 cite
// + justify + DIRECT after. Total paid = n(90) = 4. Fork-accounting probe. ----
fn f2_a10()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    f2_cites(sp,x,11,13);
    let wk:i32=st_weaken(sp,x,10,ST_J_CONTRADICTED);
    st_evidence(sp,x,ST_J_CONTRADICTED,14);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A10 prepaid_discount wk_rc=");f2_pi(wk as i64);
    f2_tag(" ow_rc=");f2_pi(ow as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A11: second-generation judgment — full-price direct, then a
// cheap direct on the NEW judgment. Birth reset must not over-price it. ----
fn f2_a11()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    f2_cites(sp,x,11,14);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow1:i32=st_overwrite_direct(sp,x,2002,10,1);
    st_evidence(sp,x,ST_J_CONTRADICTED,21);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow2:i32=st_overwrite_direct(sp,x,2003,20,2);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A11 gen2 ow1_rc=");f2_pi(ow1 as i64);
    f2_tag(" ow2_rc=");f2_pi(ow2 as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
// ---- F2A12: TRAINER_DECLARE as the discount vehicle (trainer role).
// ADD(90) -> trainer_declare(50) -> 2 cites -> justify -> DIRECT.
// Uniformity probe: does the fix price the discount regardless of vehicle? ----
fn f2_a12()void {
    let s:StStore=st_init(32,16384);let sp:*StStore=&s;
    let x:i32=f2_setup(sp,90);
    let td:i32=st_trainer_declare(sp,ST_ROLE_TRAINER,7,x,50,0);
    f2_cites(sp,x,11,12);
    st_justify(sp,x,ST_J_CONTRADICTED);
    let ow:i32=st_overwrite_direct(sp,x,2002,50,1);
    let cf:i32=f2_ck(sp);
    f2_tag("F2_A12 trainer_declare_down td_rc=");f2_pi(td as i64);
    f2_tag(" ow_rc=");f2_pi(ow as i64);
    f2_tag(" checker_failures=");f2_pi(cf as i64);
    f2_tag("\n");
    st_free(sp);
}
fn main()i32 {
    f2_tag("F2_START\n");
    f2_a1();
    f2_a2();
    f2_a3();
    f2_a4();
    f2_a5();
    f2_a6();
    f2_a7();
    f2_a8();
    f2_a9();
    f2_a10();
    f2_a11();
    f2_a12();
    f2_tag("F2_DONE\n");
    return 0;
}

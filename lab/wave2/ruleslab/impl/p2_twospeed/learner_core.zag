// P2 TWO-SPEED learner core.
// fast[c][o]: R34-style additive score += reward*100 (the "candidate").
// slow[c][o]: consolidated table (the "accepted policy"). Every 8th outcome,
//   slow moves toward fast by +-25 without overshoot; then fast decays 25%
//   toward the new slow.
// Decision: argmax over slow by default; fast overrides when it disagrees AND
//   |fast - slow| on its pick exceeds MARGIN (strong recent evidence).
//   Mirrors the brain's ProtectedSkillMemory fast/slow + PROMOTE-on-measured-gain.
// Context recruitment/switching identical to R34 (reads fast = recent evidence).
@import("../substrate/cl/observation.zag")

const P2_MARGIN:i32=4000;
const P2_CONSOLIDATE_EVERY:i32=8;
const P2_SLOW_STEP:i32=25;

struct TrlState {
    f00:i32,f01:i32,f10:i32,f11:i32,
    s00:i32,s01:i32,s10:i32,s11:i32,
    n00:i32,n01:i32,n10:i32,n11:i32,
    rng:i32,updates:i32,active:i32,contexts:i32,
    pending:i32,pending_action:i32,pending_context:i32,pending_object:i32,pending_explore:i32,
    decisions:i32,switches:i32,outcomes:i32,explores:i32,overrides:i32,consolidations:i32
}

fn trl_mod(v:i32,m:i32)i32 {let q:i32=v/m;let r:i32=v-q*m;if(r<0){return r+m;}return r;}
fn trl_rng(s:*TrlState)i32 {let v:i32=trl_mod(s.*.rng*997+7919,1000003);s.*.rng=v;return v;}
fn trl_init(seed:i32)TrlState {
    return TrlState{.f00=0,.f01=0,.f10=0,.f11=0,.s00=0,.s01=0,.s10=0,.s11=0,
        .n00=0,.n01=0,.n10=0,.n11=0,
        .rng=seed,.updates=0,.active=0,.contexts=1,.pending=0,.pending_action=0,.pending_context=0,
        .pending_object=0,.pending_explore=0,.decisions=0,.switches=0,.outcomes=0,.explores=0,
        .overrides=0,.consolidations=0};
}
fn trl_fast(s:*TrlState,c:i32,o:i32)i32 {
    if(c==0){if(o==0){return s.*.f00;}return s.*.f01;}if(o==0){return s.*.f10;}return s.*.f11;
}
fn trl_slow(s:*TrlState,c:i32,o:i32)i32 {
    if(c==0){if(o==0){return s.*.s00;}return s.*.s01;}if(o==0){return s.*.s10;}return s.*.s11;
}
fn trl_set_fast(s:*TrlState,c:i32,o:i32,v:i32)void {
    if(c==0){if(o==0){s.*.f00=v;}else{s.*.f01=v;}}else{if(o==0){s.*.f10=v;}else{s.*.f11=v;}}
}
fn trl_set_slow(s:*TrlState,c:i32,o:i32,v:i32)void {
    if(c==0){if(o==0){s.*.s00=v;}else{s.*.s01=v;}}else{if(o==0){s.*.s10=v;}else{s.*.s11=v;}}
}
fn trl_inc_count(s:*TrlState,c:i32,o:i32)void {
    if(c==0){if(o==0){s.*.n00=s.*.n00+1;}else{s.*.n01=s.*.n01+1;}}
    else{if(o==0){s.*.n10=s.*.n10+1;}else{s.*.n11=s.*.n11+1;}}
}
fn trl_argmax_fast(s:*TrlState,c:i32)i32 {let a:i32=trl_fast(s,c,0);let b:i32=trl_fast(s,c,1);if(b>a){return 1;}if(a>b){return 0;}return s.*.decisions%2;}
fn trl_argmax_slow(s:*TrlState,c:i32)i32 {let a:i32=trl_slow(s,c,0);let b:i32=trl_slow(s,c,1);if(b>a){return 1;}if(a>b){return 0;}return s.*.decisions%2;}
fn trl_abs(x:i32)i32 {if(x<0){return 0-x;}return x;}
fn trl_choose(s:*TrlState,explore_enabled:i32,was_explore:*i32)i32 {
    if(s==null as *TrlState || was_explore==null as *i32 || s.*.pending!=0){return -1;}
    let c:i32=s.*.active;
    let pick:i32=trl_argmax_slow(s,c);
    let fpick:i32=trl_argmax_fast(s,c);
    if(fpick!=pick && trl_abs(trl_fast(s,c,fpick)-trl_slow(s,c,fpick))>P2_MARGIN){
        pick=fpick;s.*.overrides=s.*.overrides+1;
    }
    let obj:i32=pick;let ex:i32=0;
    if(explore_enabled==1 && trl_mod(trl_rng(s),5)==0){obj=1-obj;ex=1;}
    was_explore.*=ex;if(ex==1){s.*.explores=s.*.explores+1;}
    s.*.decisions=s.*.decisions+1;return obj;
}
fn trl_consolidate(s:*TrlState)void {
    let c:i32=0;
    while(c<2){
        let o:i32=0;
        while(o<2){
            let f:i32=trl_fast(s,c,o);let sl:i32=trl_slow(s,c,o);let d:i32=f-sl;
            if(d>0){if(sl+P2_SLOW_STEP>f){sl=f;}else{sl=sl+P2_SLOW_STEP;}}
            else if(d<0){if(sl-P2_SLOW_STEP<f){sl=f;}else{sl=sl-P2_SLOW_STEP;}}
            if(sl>30000){sl=30000;}if(sl< -30000){sl=-30000;}
            trl_set_slow(s,c,o,sl);
            let nf:i32=sl+(f-sl)*3/4;
            if(nf>30000){nf=30000;}if(nf< -30000){nf=-30000;}
            trl_set_fast(s,c,o,nf);
            o=o+1;
        }
        c=c+1;
    }
    s.*.consolidations=s.*.consolidations+1;
}
fn trl_accept(s:*TrlState,action_id:i32,reward:i32,learn:i32,allow_switch:i32)i32 {
    if(s==null as *TrlState || s.*.pending!=1 || action_id!=s.*.pending_action || (reward!=1 && reward!=-1)){return cl_bad();}
    let c:i32=s.*.pending_context;let o:i32=s.*.pending_object;let target:i32=c;let old:i32=trl_fast(s,c,o);
    if(allow_switch==1 && reward<0 && s.*.pending_explore==0 && old>0){
        if(s.*.contexts==1 && c==0){s.*.contexts=3;target=1;s.*.active=1;s.*.switches=s.*.switches+1;}
        else if(s.*.contexts==3){let alt:i32=1-c;let a:i32=trl_fast(s,alt,0);let b:i32=trl_fast(s,alt,1);let best:i32=a;if(b>best){best=b;}if(best>0){target=alt;s.*.active=alt;s.*.switches=s.*.switches+1;}}
    }
    if(learn==1){
        let v:i32=trl_fast(s,target,o)+reward*100;
        if(v>30000){v=30000;}if(v< -30000){v=-30000;}
        trl_set_fast(s,target,o,v);trl_inc_count(s,target,o);s.*.updates=s.*.updates+1;
    }
    s.*.outcomes=s.*.outcomes+1;
    if(s.*.outcomes%P2_CONSOLIDATE_EVERY==0){trl_consolidate(s);}
    s.*.pending=0;s.*.pending_action=0;s.*.pending_context=0;s.*.pending_object=0;s.*.pending_explore=0;return 0;
}
fn trl_actor(obs:[]u8)i32 {
    if(cl_observation_check(obs)!=0 || cl_u32(obs,24)!=2 || cl_u32(obs,32)!=8 || cl_u32(obs,36)!=8 || cl_u32(obs,40)!=3){return -1;}
    let x:i32=0;while(x<8){let at:i32=80+(6*8+x)*3;if(obs[at]==32 && obs[at+1]==220 && obs[at+2]==32){return x;}x=x+1;}return -1;
}
fn trl_feature(obs:[]u8,x:i32)i32 {
    if(cl_observation_check(obs)!=0 || x<0 || x>7){return -1;}let at:i32=80+(3*8+x)*3;
    if(obs[at]!=160 || obs[at+1]!=160){return -1;}if(obs[at+2]<100){return 0;}return 1;
}

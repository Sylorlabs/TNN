// AUDIT281 -- independent audit of the keyboard-typo trial (Micah's 281 question).
//
// PART A -- is qwerty.zag GENUINE physical knowledge or tuned ("hardcoded
//   intelligence")?
//   A1: every key-center coordinate vs the documented layout formula
//       (q-row x=8+4i y=4; a-row x=9+4i y=8; z-row x=11+4i y=12).
//       Any deviation = per-key tuning red flag.
//   A2: d2 spectrum gaps at the tier thresholds. If no letter pair has d2 in
//       the gap around a threshold, the threshold is not knife-edge fitted:
//       any threshold inside the gap yields byte-identical costs.
//   A3: tier-10 membership must be exactly the physical king-neighborhood
//       (d2 in {16,17}); every rectangle-touching pair must be tier <= 20.
//   A4: the doc's example probes (e->d=10, q->s=20, ...).
// PART B -- causal classification of every worsened item (kb_rank > bl_rank).
//   Replays the frozen ranking with typo_infer.infer_dist and, per item,
//   names the KB-only cause competitors: candidates ranked above the truth
//   under KB but NOT under the blind baseline. Classes:
//     STRICT -- at least one cause with strictly cheaper KB cost
//               (a genuinely cheaper keyboard path outranks the truth).
//     TIE    -- all causes tie the truth's KB cost and win on the
//               alphabetical list-order tie-break.
//   Also flags: typed string itself a list word (collision context),
//   replay mismatch vs results.txt, empty cause set (anomaly).
//
// PURE ZAG, zero RNG, deterministic.
@import("R33_NATIVE_IO_V1.zag")
@import("typo_infer.zag")

fn numstr(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let e:i32=s.len;
    if(e>0 && s[e-1]==10){ e=e-1; }
    return s[0..e];
}

fn p_num(v:i64)void {
    let s:[]u8=numstr(v);
    _zag_print(s);
    nio_free(s);
}

fn read_all(root:i64, name:[]u8)[]u8 {
    let fd:i64=nio_open_child(root,name,0);
    if(fd<0){ return ""; }
    let buf:[]u8=nio_alloc(8388608);
    if(buf.len==0){ nio_close(fd); return ""; }
    let n:i64=nio_read_exact(fd,buf,8388608);
    nio_close(fd);
    if(n<=0){ return ""; }
    return buf[0..(n as i32)];
}

fn parse_lines(b:[]u8, off:[]i64, ln:[]i64, maxn:i32)i32 {
    let nw:i32=0;
    let i:i32=0;
    let st:i32=0;
    while(i<b.len){
        if(b[i]==10){
            if(i>st && nw<maxn){
                off[nw]=st as i64;
                ln[nw]=(i-st) as i64;
                nw=nw+1;
            }
            st=i+1;
        }
        i=i+1;
    }
    if(st<b.len && nw<maxn){
        off[nw]=st as i64;
        ln[nw]=(b.len-st) as i64;
        nw=nw+1;
    }
    return nw;
}

fn buf_eq(a:[]u8, s1:i32, b:[]u8, s2:i32, l:i32)i32 {
    let i:i32=0;
    while(i<l){
        if(a[s1+i]!=b[s2+i]){ return 0; }
        i=i+1;
    }
    return 1;
}

fn parse_i64(b:[]u8, s:i32, l:i32)i64 {
    let v:i64=0;
    let i:i32=0;
    while(i<l){
        let c:u8=b[s+i];
        if(c>=48 && c<=57){ v=v*10+((c-48) as i64); }
        i=i+1;
    }
    return v;
}

fn w_str(ob:[]u8, pos:i32, s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){
        ob[pos]=s[i];
        pos=pos+1;
        i=i+1;
    }
    return pos;
}

fn w_buf(ob:[]u8, pos:i32, b:[]u8, s:i32, l:i32)i32 {
    let i:i32=0;
    while(i<l){
        ob[pos]=b[s+i];
        pos=pos+1;
        i=i+1;
    }
    return pos;
}

fn w_i64(ob:[]u8, pos:i32, v:i64)i32 {
    let s:[]u8=_zag_i64_to_str(v);
    let e:i32=s.len;
    if(e>0 && s[e-1]==10){ e=e-1; }
    let i:i32=0;
    while(i<e){
        ob[pos]=s[i];
        pos=pos+1;
        i=i+1;
    }
    nio_free(s);
    return pos;
}

fn w_byte(ob:[]u8, pos:i32, c:u8)i32 {
    ob[pos]=c;
    return pos+1;
}

// ---------- PART A ----------

fn check_row(kx:[]u8, ky:[]u8, row:[]u8, x0:i32, y0:i32)i64 {
    let bad:i64=0;
    let i:i32=0;
    while(i<row.len){
        let L:u8=row[i];
        let ix:i32=(L-97) as i32;
        let ex:i32=x0+4*i;
        if((kx[ix] as i32)!=ex || (ky[ix] as i32)!=y0){
            _zag_print("A1 MISMATCH ix=");
            p_num(ix as i64);
            _zag_print(" got=(");
            p_num(kx[ix] as i64);
            _zag_print(",");
            p_num(ky[ix] as i64);
            _zag_print(") want=(");
            p_num(ex as i64);
            _zag_print(",");
            p_num(y0 as i64);
            _zag_println(")");
            bad=bad+1;
        }
        i=i+1;
    }
    return bad;
}

fn audit_coords()void {
    let kx:[]u8=kb_kx();
    let ky:[]u8=kb_ky();
    let bad:i64=0;
    bad=bad+check_row(kx,ky,"qwertyuiop",8,4);
    bad=bad+check_row(kx,ky,"asdfghjkl",9,8);
    bad=bad+check_row(kx,ky,"zxcvbnm",11,12);
    _zag_print("A1 coord_mismatches=");
    p_num(bad);
    _zag_println("/26");
}

fn audit_spectrum()void {
    let kx:[]u8=kb_kx();
    let ky:[]u8=kb_ky();
    let max10:i64=-1;
    let min20:i64=999999;
    let max20:i64=-1;
    let min30:i64=999999;
    let max30:i64=-1;
    let min40:i64=999999;
    let a:i32=0;
    while(a<26){
        let b:i32=0;
        while(b<26){
            let dx:i64=(kx[a] as i64)-(kx[b] as i64);
            let dy:i64=(ky[a] as i64)-(ky[b] as i64);
            let d2:i64=dx*dx+dy*dy;
            if(d2<=17){
                if(d2>max10){ max10=d2; }
            }
            if(d2>=18 && d2<=45){
                if(d2<min20){ min20=d2; }
                if(d2>max20){ max20=d2; }
            }
            if(d2>=46 && d2<=100){
                if(d2<min30){ min30=d2; }
                if(d2>max30){ max30=d2; }
            }
            if(d2>100){
                if(d2<min40){ min40=d2; }
            }
            b=b+1;
        }
        a=a+1;
    }
    _zag_print("A2 max10=");
    p_num(max10);
    _zag_print(" min20=");
    p_num(min20);
    _zag_print(" max20=");
    p_num(max20);
    _zag_print(" min30=");
    p_num(min30);
    _zag_print(" max30=");
    p_num(max30);
    _zag_print(" min40=");
    p_num(min40);
    _zag_println("");
}

fn audit_tiers()void {
    let kx:[]u8=kb_kx();
    let ky:[]u8=kb_ky();
    let n10:i64=0;
    let ok10:i64=1;
    let a:i32=0;
    while(a<26){
        let b:i32=a+1;
        while(b<26){
            let ca:u8=(97+a) as u8;
            let cb:u8=(97+b) as u8;
            if(kb_sub_cost(ca,cb)==10){
                n10=n10+1;
                let dx:i64=(kx[a] as i64)-(kx[b] as i64);
                let dy:i64=(ky[a] as i64)-(ky[b] as i64);
                let d2:i64=dx*dx+dy*dy;
                if(d2!=16 && d2!=17){ ok10=0; }
            }
            b=b+1;
        }
        a=a+1;
    }
    _zag_print("A3 tier10_pairs=");
    p_num(n10);
    _zag_print(" all_d2_in_16_17=");
    p_num(ok10);
    _zag_println("");
    let nt:i64=0;
    let t10:i64=0;
    let t20:i64=0;
    let thi:i64=0;
    a=0;
    while(a<26){
        let b2:i32=0;
        while(b2<26){
            if(b2!=a){
                let dx2:i64=(kx[a] as i64)-(kx[b2] as i64);
                let dy2:i64=(ky[a] as i64)-(ky[b2] as i64);
                let adx:i64=dx2;
                if(adx<0){ adx=-adx; }
                let ady:i64=dy2;
                if(ady<0){ ady=-ady; }
                if(adx<=4 && ady<=4){
                    nt=nt+1;
                    let t:i64=kb_sub_cost((97+a) as u8,(97+b2) as u8);
                    if(t==10){ t10=t10+1; }
                    if(t==20){
                        t20=t20+1;
                        _zag_print("A3 touching-tier20 a=");
                        p_num(a as i64);
                        _zag_print(" b=");
                        p_num(b2 as i64);
                        _zag_println("");
                    }
                    if(t>20){ thi=thi+1; }
                }
            }
            b2=b2+1;
        }
        a=a+1;
    }
    _zag_print("A3 touching_directed=");
    p_num(nt);
    _zag_print(" t10=");
    p_num(t10);
    _zag_print(" t20=");
    p_num(t20);
    _zag_print(" t30plus=");
    p_num(thi);
    _zag_println("");
}

fn probe(a:u8, b:u8, want:i64)i64 {
    let got:i64=kb_sub_cost(a,b);
    if(got!=want){
        _zag_print("A4 PROBE-FAIL a=");
        p_num(a as i64);
        _zag_print(" b=");
        p_num(b as i64);
        _zag_print(" want=");
        p_num(want);
        _zag_print(" got=");
        p_num(got);
        _zag_println("");
        return 1;
    }
    return 0;
}

fn audit_probes()void {
    let bad:i64=0;
    bad=bad+probe(101,100,10);
    bad=bad+probe(113,97,10);
    bad=bad+probe(101,119,10);
    bad=bad+probe(101,114,10);
    bad=bad+probe(113,115,20);
    bad=bad+probe(101,115,20);
    bad=bad+probe(119,97,20);
    bad=bad+probe(113,101,30);
    bad=bad+probe(113,122,30);
    bad=bad+probe(113,112,40);
    _zag_print("A4 probe_failures=");
    p_num(bad);
    _zag_println("/10");
}

// ---------- PART B ----------

// stat indices
// 0 n  1 improved  2 worsened  3 unchanged  4 collisions
// 5 w_s1  6 w_s2  7 w_rw  8 strict  9 tie  10 wor_coll
// 11 replay_mismatch  12 anomaly_nocause  13 tidx_neg
// 14 s1_strict_truth_t10  15 s1_strict_truth_t20
// 16 cause_t10  17 cause_t20  18 cause_t30  19 cause_t40  20 cause_nonsub
// 21 s1_diffcount_bad

fn find_word(wb:[]u8, woff:[]i64, wlen:[]i64, nw:i32, q:[]u8, qs:i32, ql:i32)i32 {
    let wi:i32=0;
    while(wi<nw){
        if((wlen[wi] as i32)==ql && buf_eq(wb,woff[wi] as i32,q,qs,ql)==1){ return wi; }
        wi=wi+1;
    }
    return -1;
}

fn is_s1(rb:[]u8, ks:i32, kl:i32)i32 {
    if(kl==2 && rb[ks]==83 && rb[ks+1]==49){ return 1; }
    return 0;
}

// Classify one worsened item; append the detail line to ob at pos.
// Returns the new pos.
fn classify_one(rb:[]u8, ts:i32, tl:i32, rs:i32, rl:i32, ks:i32, kl:i32, kbr:i64, blr:i64, wb:[]u8, woff:[]i64, wlen:[]i64, nw:i32, w:[]i64, ob:[]u8, pos:i32, st:[]i64)i32 {
    let tidx:i32=find_word(wb,woff,wlen,nw,rb,rs,rl);
    if(tidx<0){
        st[13]=st[13]+1;
        return pos;
    }
    let typed:[]u8=rb[ts..ts+tl];
    let tws:i32=woff[tidx] as i32;
    let twl:i32=wlen[tidx] as i32;
    let truthw:[]u8=wb[tws..tws+twl];
    let kb_ts:i64=infer_dist(typed,truthw,1,w);
    let bl_ts:i64=infer_dist(typed,truthw,0,w);
    let rkb:i64=1;
    let rbl:i64=1;
    let ncause:i64=0;
    let nstrict:i64=0;
    let bestwi:i32=-1;
    let bestsk:i64=999999;
    let wi:i32=0;
    while(wi<nw){
        let cs:i32=woff[wi] as i32;
        let cl:i32=wlen[wi] as i32;
        let cand:[]u8=wb[cs..cs+cl];
        let sk:i64=infer_dist(typed,cand,1,w);
        let sb:i64=infer_dist(typed,cand,0,w);
        let akb:i32=0;
        let abl:i32=0;
        if(sk<kb_ts || (sk==kb_ts && wi<tidx)){ akb=1; }
        if(sb<bl_ts || (sb==bl_ts && wi<tidx)){ abl=1; }
        if(akb==1){ rkb=rkb+1; }
        if(abl==1){ rbl=rbl+1; }
        if(akb==1 && abl==0){
            ncause=ncause+1;
            if(sk<kb_ts){ nstrict=nstrict+1; }
            if(sk<bestsk || (sk==bestsk && wi<bestwi)){ bestsk=sk; bestwi=wi; }
        }
        wi=wi+1;
    }
    let rok:i64=1;
    if(rkb!=kbr || rbl!=blr){
        rok=0;
        st[11]=st[11]+1;
    }
    if(ncause==0){
        st[12]=st[12]+1;
        return pos;
    }
    let coll:i64=0;
    if(find_word(wb,woff,wlen,nw,rb,ts,tl)>=0){
        coll=1;
        st[10]=st[10]+1;
    }
    let s1:i32=is_s1(rb,ks,kl);
    // truth sub detail: diffcount between typed and truth bytes
    let ndiff:i32=0;
    let dpos:i32=-1;
    let dp:i32=0;
    if(tl==rl){
        while(dp<tl){
            if(rb[ts+dp]!=rb[rs+dp]){
                ndiff=ndiff+1;
                dpos=dp;
            }
            dp=dp+1;
        }
    }
    let truth_tier:i64=-1;
    if(tl==rl && ndiff==1){
        truth_tier=kb_sub_cost(rb[ts+dpos],rb[rs+dpos]);
    }
    if(s1==1 && (tl!=rl || ndiff!=1)){ st[21]=st[21]+1; }
    // best cause sub detail
    let bcs:i32=woff[bestwi] as i32;
    let bcl:i32=wlen[bestwi] as i32;
    let bndiff:i32=0;
    let bdpos:i32=-1;
    let bdp:i32=0;
    if(bcl==tl){
        while(bdp<tl){
            if(rb[ts+bdp]!=wb[bcs+bdp]){
                bndiff=bndiff+1;
                bdpos=bdp;
            }
            bdp=bdp+1;
        }
    }
    let cause_tier:i64=-1;
    if(bcl==tl && bndiff==1){
        cause_tier=kb_sub_cost(rb[ts+bdpos],wb[bcs+bdpos]);
    }
    // stats
    if(nstrict>0){
        st[8]=st[8]+1;
        if(s1==1 && truth_tier==10){ st[14]=st[14]+1; }
        if(s1==1 && truth_tier==20){ st[15]=st[15]+1; }
        if(cause_tier==10){ st[16]=st[16]+1; }
        if(cause_tier==20){ st[17]=st[17]+1; }
        if(cause_tier==30){ st[18]=st[18]+1; }
        if(cause_tier==40){ st[19]=st[19]+1; }
        if(cause_tier<0){ st[20]=st[20]+1; }
    }
    if(nstrict==0){ st[9]=st[9]+1; }
    // detail line
    pos=w_buf(ob,pos,rb,ts,tl);
    pos=w_byte(ob,pos,9);
    pos=w_buf(ob,pos,rb,rs,rl);
    pos=w_byte(ob,pos,9);
    pos=w_buf(ob,pos,rb,ks,kl);
    pos=w_byte(ob,pos,9);
    pos=w_i64(ob,pos,kbr);
    pos=w_byte(ob,pos,9);
    pos=w_i64(ob,pos,blr);
    pos=w_byte(ob,pos,9);
    if(nstrict>0){ pos=w_str(ob,pos,"STRICT"); }
    if(nstrict==0){ pos=w_str(ob,pos,"TIE"); }
    pos=w_byte(ob,pos,9);
    pos=w_i64(ob,pos,ncause);
    pos=w_byte(ob,pos,9);
    pos=w_buf(ob,pos,wb,bcs,bcl);
    pos=w_byte(ob,pos,9);
    pos=w_i64(ob,pos,bestsk);
    pos=w_byte(ob,pos,9);
    pos=w_i64(ob,pos,kb_ts);
    pos=w_byte(ob,pos,9);
    if(bcl==tl && bndiff==1){
        pos=w_byte(ob,pos,rb[ts+bdpos]);
        pos=w_byte(ob,pos,62);
        pos=w_byte(ob,pos,wb[bcs+bdpos]);
        pos=w_byte(ob,pos,58);
        pos=w_i64(ob,pos,cause_tier);
    }
    if(bcl==tl && bndiff!=1){ pos=w_str(ob,pos,"multi"); }
    if(bcl!=tl){
        pos=w_byte(ob,pos,76);
        pos=w_i64(ob,pos,tl as i64);
        pos=w_str(ob,pos,"->");
        pos=w_i64(ob,pos,bcl as i64);
    }
    pos=w_byte(ob,pos,9);
    if(tl==rl && ndiff==1){
        pos=w_byte(ob,pos,rb[ts+dpos]);
        pos=w_byte(ob,pos,62);
        pos=w_byte(ob,pos,rb[rs+dpos]);
        pos=w_byte(ob,pos,58);
        pos=w_i64(ob,pos,truth_tier);
    }
    if(tl==rl && ndiff!=1){
        pos=w_byte(ob,pos,78);
        pos=w_i64(ob,pos,ndiff as i64);
    }
    if(tl!=rl){
        pos=w_byte(ob,pos,76);
        pos=w_i64(ob,pos,tl as i64);
        pos=w_str(ob,pos,"->");
        pos=w_i64(ob,pos,rl as i64);
    }
    pos=w_byte(ob,pos,9);
    pos=w_i64(ob,pos,coll);
    pos=w_byte(ob,pos,9);
    pos=w_i64(ob,pos,rok);
    pos=w_byte(ob,pos,10);
    return pos;
}

fn print_stat(name:[]u8, v:i64)void {
    _zag_print(name);
    _zag_print("=");
    p_num(v);
    _zag_println("");
}

fn main()void {
    let workdir:[]u8=_zag_arg(1);
    let wordsname:[]u8=_zag_arg(2);
    let resname:[]u8=_zag_arg(3);
    let outname:[]u8=_zag_arg(4);

    // PART A
    audit_coords();
    audit_probes();
    audit_spectrum();
    audit_tiers();
    _zag_println("PARTA DONE");

    // PART B
    let root:i64=nio_open_root(workdir);
    if(root<0){ _zag_println("ERR workdir"); return; }
    let wb:[]u8=read_all(root,wordsname);
    let rb:[]u8=read_all(root,resname);
    nio_close(root);
    if(wb.len==0){ _zag_println("ERR words"); return; }
    if(rb.len==0){ _zag_println("ERR results"); return; }

    let woff:[]i64=nio_alloc(4096*8) as []i64;
    let wlen:[]i64=nio_alloc(4096*8) as []i64;
    let nw:i32=parse_lines(wb,woff,wlen,4096);
    let roff:[]i64=nio_alloc(21000*8) as []i64;
    let rlen:[]i64=nio_alloc(21000*8) as []i64;
    let nr:i32=parse_lines(rb,roff,rlen,21000);
    let w:[]i64=nio_alloc(32*32*8) as []i64;
    let ob:[]u8=nio_alloc(8388608);
    let st:[]i64=nio_alloc(32*8) as []i64;
    if(woff.len==0 || wlen.len==0 || roff.len==0 || rlen.len==0 || w.len==0 || ob.len==0 || st.len==0){
        _zag_println("ERR alloc");
        return;
    }
    let zi:i32=0;
    while(zi<32){ st[zi]=0; zi=zi+1; }

    // pass 1: headline verification from results.txt (no replay)
    let li:i32=0;
    while(li<nr){
        let ls:i32=roff[li] as i32;
        let ll:i32=rlen[li] as i32;
        let t1:i32=-1;
        let t2:i32=-1;
        let t3:i32=-1;
        let t4:i32=-1;
        let t5:i32=-1;
        let k:i32=0;
        while(k<ll){
            if(rb[ls+k]==9){
                if(t1<0){ t1=k; }
                if(t1>=0 && t2<0 && k!=t1){ t2=k; }
                if(t2>=0 && t3<0 && k!=t2){ t3=k; }
                if(t3>=0 && t4<0 && k!=t3){ t4=k; }
                if(t4>=0 && t5<0 && k!=t4){ t5=k; }
            }
            k=k+1;
        }
        if(t1>0 && t5>t4){
            let ks:i32=ls+t2+1;
            let kl:i32=t3-t2-1;
            let kbr:i64=parse_i64(rb,ls+t3+1,t4-t3-1);
            let blr:i64=parse_i64(rb,ls+t4+1,t5-t4-1);
            st[0]=st[0]+1;
            if(kbr<blr){ st[1]=st[1]+1; }
            if(kbr>blr){
                st[2]=st[2]+1;
                let s1v:i32=is_s1(rb,ks,kl);
                if(s1v==1){ st[5]=st[5]+1; }
                if(kl==2 && rb[ks]==83 && rb[ks+1]==50){ st[6]=st[6]+1; }
                if(kl==2 && rb[ks]==82 && rb[ks+1]==87){ st[7]=st[7]+1; }
            }
            if(kbr==blr){ st[3]=st[3]+1; }
            // collision: typed in word list?
            if(find_word(wb,woff,wlen,nw,rb,ls,t1)>=0){ st[4]=st[4]+1; }
        }
        li=li+1;
    }
    print_stat("B0 n",st[0]);
    print_stat("B0 improved",st[1]);
    print_stat("B0 worsened",st[2]);
    print_stat("B0 unchanged",st[3]);
    print_stat("B0 collisions",st[4]);
    print_stat("B1 worsened_S1",st[5]);
    print_stat("B1 worsened_S2",st[6]);
    print_stat("B1 worsened_RW",st[7]);

    // pass 2: classify each worsened item
    let pos:i32=0;
    pos=w_str(ob,pos,"typed\ttruth\tkind\tkb_rank\tbl_rank\tclass\tncause\tbestcause\tcausekb\ttruthkb\tcausesub\ttruthsub\tcoll\treplayok\n");
    li=0;
    while(li<nr){
        let ls:i32=roff[li] as i32;
        let ll:i32=rlen[li] as i32;
        let t1:i32=-1;
        let t2:i32=-1;
        let t3:i32=-1;
        let t4:i32=-1;
        let t5:i32=-1;
        let k:i32=0;
        while(k<ll){
            if(rb[ls+k]==9){
                if(t1<0){ t1=k; }
                if(t1>=0 && t2<0 && k!=t1){ t2=k; }
                if(t2>=0 && t3<0 && k!=t2){ t3=k; }
                if(t3>=0 && t4<0 && k!=t3){ t4=k; }
                if(t4>=0 && t5<0 && k!=t4){ t5=k; }
            }
            k=k+1;
        }
        if(t1>0 && t5>t4){
            let kbr:i64=parse_i64(rb,ls+t3+1,t4-t3-1);
            let blr:i64=parse_i64(rb,ls+t4+1,t5-t4-1);
            if(kbr>blr){
                pos=classify_one(rb,ls,t1,ls+t1+1,t2-t1-1,ls+t2+1,t3-t2-1,kbr,blr,wb,woff,wlen,nw,w,ob,pos,st);
            }
        }
        li=li+1;
    }

    let root2:i64=nio_open_root(workdir);
    let ofd:i64=nio_open_child(root2,outname,1);
    nio_close(root2);
    if(ofd<0){ _zag_println("ERR output"); return; }
    let wr:i64=nio_write_all(ofd,ob[0..pos]);
    nio_close(ofd);
    if(wr!=(pos as i64)){ _zag_println("ERR write"); return; }

    print_stat("B2 STRICT",st[8]);
    print_stat("B2 TIE",st[9]);
    print_stat("B3 worsened_with_collision",st[10]);
    print_stat("B4 replay_mismatch",st[11]);
    print_stat("B5 anomaly_nocause",st[12]);
    print_stat("B5 tidx_neg",st[13]);
    print_stat("B6 S1_STRICT_truth_tier10",st[14]);
    print_stat("B6 S1_STRICT_truth_tier20",st[15]);
    print_stat("B7 cause_tier10",st[16]);
    print_stat("B7 cause_tier20",st[17]);
    print_stat("B7 cause_tier30",st[18]);
    print_stat("B7 cause_tier40",st[19]);
    print_stat("B7 cause_nonsub",st[20]);
    print_stat("B7 s1_diffcount_bad",st[21]);
    _zag_println("PARTB DONE");
}

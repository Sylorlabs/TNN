// floor.zag — FLOOR control: the old 240x240 shape-renderer approach,
// applied to the BBB reference clip. A text scene plan (below) is rendered
// as coarse flat shapes at 240x240. No fur, no texture, no whiskers, no
// specular detail — exactly the representational poverty Micah saw.
//
// TEXT SCENE PLAN (transcribed from PROVENANCE.md + viewed frames):
//   sky: flat light blue. foliage: dark green blobs, left edge + top-right.
//   head: big light-gray ellipse. ears: two gray ellipses, slight shift.
//   eyes: closed slits -> open white/brown (progressive over 24 frames).
//   nose: pink triangle. smile: dark arc under nose, widening over frames.
//
// Usage: floor <outdir>   (writes floor_00.ppm .. floor_23.ppm, 240x240)
// Pure Zag, zero RNG, deterministic.
@import("../../tnn-lab/toolchain/R33_NATIVE_IO_V1.zag")

fn f_putpx(px:[]u8, x:i64, y:i64, r:i64, g:i64, b:i64) void {
    if (x < 0 || x > 239 || y < 0 || y > 239) { return; }
    let o:i64 = (y * 240 + x) * 3;
    px[o] = r as u8; px[o + 1] = g as u8; px[o + 2] = b as u8;
}
fn f_rect(px:[]u8, x0:i64, y0:i64, x1:i64, y1:i64, r:i64, g:i64, b:i64) void {
    let y:i64 = y0;
    while (y <= y1) {
        let x:i64 = x0;
        while (x <= x1) {
            f_putpx(px, x, y, r, g, b);
            x = x + 1;
        }
        y = y + 1;
    }
}
fn f_ellipse(px:[]u8, cx:i64, cy:i64, rx:i64, ry:i64, r:i64, g:i64, b:i64) void {
    let rr:i64 = rx * ry;
    let rr2:i64 = rr * rr;
    let y:i64 = cy - ry;
    while (y <= cy + ry) {
        let x:i64 = cx - rx;
        while (x <= cx + rx) {
            let dx:i64 = x - cx;
            let dy:i64 = y - cy;
            let v:i64 = dx * dx * ry * ry + dy * dy * rx * rx;
            if (v <= rr2) { f_putpx(px, x, y, r, g, b); }
            x = x + 1;
        }
        y = y + 1;
    }
}
fn f_tri(px:[]u8, x0:i64, y0:i64, x1:i64, y1:i64, x2:i64, y2:i64, r:i64, g:i64, b:i64) void {
    // barycentric fill, integer
    let xa:i64 = x0; if (x1 < xa) { xa = x1; } if (x2 < xa) { xa = x2; }
    let xb:i64 = x0; if (x1 > xb) { xb = x1; } if (x2 > xb) { xb = x2; }
    let ya:i64 = y0; if (y1 < ya) { ya = y1; } if (y2 < ya) { ya = y2; }
    let yb:i64 = y0; if (y1 > yb) { yb = y1; } if (y2 > yb) { yb = y2; }
    let d:i64 = (y1 - y2) * (x0 - x2) + (x2 - x1) * (y0 - y2);
    if (d == 0) { return; }
    let y:i64 = ya;
    while (y <= yb) {
        let x:i64 = xa;
        while (x <= xb) {
            let l0:i64 = ((y1 - y2) * (x - x2) + (x2 - x1) * (y - y2)) * 256 / d;
            let l1:i64 = ((y2 - y0) * (x - x2) + (x0 - x2) * (y - y2)) * 256 / d;
            let l2:i64 = 256 - l0 - l1;
            if (l0 >= 0 && l1 >= 0 && l2 >= 0) { f_putpx(px, x, y, r, g, b); }
            x = x + 1;
        }
        y = y + 1;
    }
}
fn f_hline(px:[]u8, x0:i64, x1:i64, y:i64, th:i64, r:i64, g:i64, b:i64) void {
    let t:i64 = 0;
    while (t < th) {
        let x:i64 = x0;
        while (x <= x1) {
            f_putpx(px, x, y + t, r, g, b);
            x = x + 1;
        }
        t = t + 1;
    }
}
fn f_name(out:[]u8, f:i64) void {
    out[0] = 102; out[1] = 108; out[2] = 111; out[3] = 111; out[4] = 114; out[5] = 95;
    out[6] = (48 + (f / 10)) as u8;
    out[7] = (48 + (f % 10)) as u8;
    out[8] = 46; out[9] = 112; out[10] = 112; out[11] = 109;
}
fn f_header(b:[]u8) void {
    b[0] = 80; b[1] = 54; b[2] = 10; b[3] = 50; b[4] = 52; b[5] = 48; b[6] = 32;
    b[7] = 50; b[8] = 52; b[9] = 48; b[10] = 10; b[11] = 50; b[12] = 53; b[13] = 53; b[14] = 10;
}
fn f_write(root:i64, name:[]u8, px:[]u8) i64 {
    let fd:i64 = nio_open_child(root, name[0..12], 1);
    if (fd < 0) { return -1; }
    let buf:[]u8 = nio_alloc(172815);
    if (buf.len == 0) { nio_close(fd); return -2; }
    f_header(buf);
    let i:i64 = 0;
    while (i < 172800) { buf[15 + i] = px[i]; i = i + 1; }
    let wr:i64 = nio_write_all(fd, buf);
    nio_sync(fd);
    nio_close(fd);
    nio_free(buf);
    if (wr != 172815) { return -3; }
    return 0;
}
fn f_frame(px:[]u8, f:i64) void {
    // sky
    f_rect(px, 0, 0, 239, 239, 140, 200, 235);
    // foliage blobs
    f_ellipse(px, 12, 200, 38, 62, 40, 110, 60);
    f_ellipse(px, 218, 22, 42, 30, 45, 115, 65);
    f_ellipse(px, 200, 45, 25, 18, 40, 110, 60);
    // ears (slight shift across frames)
    let elx:i64 = 95 - f / 4;
    let erx:i64 = 150 + f / 5;
    f_ellipse(px, elx, 52, 14, 38, 210, 210, 215);
    f_ellipse(px, erx, 48, 13, 36, 210, 210, 215);
    // head
    f_ellipse(px, 120, 155, 68, 72, 225, 225, 230);
    // eyes: openness grows with f
    let ery:i64 = 2 + (f * 6) / 23;
    f_ellipse(px, 100, 105, 10, ery, 250, 250, 250);
    f_ellipse(px, 140, 105, 10, ery, 250, 250, 250);
    if (f > 6) {
        f_ellipse(px, 100, 105, 4, 4, 110, 70, 40);
        f_ellipse(px, 140, 105, 4, 4, 110, 70, 40);
    } else {
        f_hline(px, 92, 108, 105, 2, 60, 60, 60);
        f_hline(px, 132, 148, 105, 2, 60, 60, 60);
    }
    // nose
    f_tri(px, 112, 122, 128, 122, 120, 132, 235, 170, 180);
    // smile: widening dark line under nose
    let sw:i64 = 10 + (f * 14) / 23;
    f_hline(px, 120 - sw, 120 + sw, 142, 3, 90, 60, 60);
    f_hline(px, 120 - sw + 4, 120 + sw - 4, 145, 2, 90, 60, 60);
}
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let root:i64 = nio_open_root(a1);
    if (root < 0) {
        _zag_println("cannot open outdir");
        return 1;
    }
    let px:[]u8 = nio_alloc(172800);
    let nm:[]u8 = nio_alloc(16);
    let fails:i64 = 0;
    let f:i64 = 0;
    while (f < 24) {
        f_frame(px, f);
        f_name(nm, f);
        if (f_write(root, nm, px) != 0) { fails = fails + 1; }
        f = f + 1;
    }
    nio_close(root);
    nio_free(px);
    nio_free(nm);
    _zag_print("floor_fails=");
    _zag_println(_zag_i64_to_str(fails));
    if (fails == 0) { return 0; }
    return 2;
}

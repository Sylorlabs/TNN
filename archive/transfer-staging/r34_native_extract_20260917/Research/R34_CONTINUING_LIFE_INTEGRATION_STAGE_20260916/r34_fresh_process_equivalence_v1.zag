@import("../R33_CONTINUING_LIFE_V1/r33_live_outer_checkpoint_binding_v1.zag")
@import("../R33_CONTINUING_LIFE_V1/r33_pending_credit_relation_v1.zag")
@import("r34_continuing_envelope_v1.zag")

// R34 fresh-process continuing-life integration V1.
// The R33 learner/world/ingress transaction remains byte-compatible and
// learn-locked. R34 state lives in an additive independently hashed envelope.

const R34FE1_RESULT_BYTES:i32=245952+R34NS1_BYTES;
const R34FE1_R33_BUFFER:i32=300000;
const R34FE1_ENVELOPE_BUFFER:i32=350000;
const R34FE1_OK:i32=0;
const R34FE1_PENDING:i32=-341201;

fn r34fe1_parent()[]u8 {let p:[]u8=nio_alloc(32);if(r33lob1_hex32(R33LOB1_PARENT_HEX,p)!=0){return "";}return p;}
fn r34fe1_receipt()[]u8 {
 let r:[]u8=nio_alloc(R27PR2_BYTES);if(r27pr2_begin(r)!=0){return "";}let id:i32=1;
 while(id<=18){let z:[]u8=nio_alloc(32);let e:[]u8=nio_alloc(32);let j:i32=0;while(j<32){e[j]=((id+j+1)&255) as u8;j=j+1;}let s:i32=R27PR2_OPEN;if(id==1){s=R27PR2_CUSTODY_CLOSED;}else if(id==2||id==3||id==4||id==6||id==7||id==8||id==18){s=R27PR2_AUTHORED_EXEC_PENDING;}let h:[]u8=z;if(s==R27PR2_CUSTODY_CLOSED){h=e;}if(r27pr2_set(r,id,s,h)!=0){return "";}id=id+1;}return r;
}
fn r34fe1_image()[]u8 {
 let image:[]u8=nio_alloc(r27i4_expected_bytes());let count:i32=0;let next:i32=0;if(r27i4_begin(image,&count,&next)!=0){return "";}let id:i32=1;
 while(id<=R27I4_SECTION_COUNT){let n:i32=r27s4_expected_count(id);let v:[]i32=new i32(n);let j:i32=0;while(j<n){v[j]=0;j=j+1;}
  if(id==R27S4_DEVELOPMENT_STEP){v[0]=60423;}if(id==R27S4_NEWBORN_RESTARTS){v[0]=0;}
  if(id==R27S4_TRACE_COUNT){v[0]=1;}if(id==R27S4_TRACE_STEP){v[0]=1;}if(id==R27S4_TRACE_STAGE){v[0]=1;}if(id==R27S4_TRACE_REASON){v[0]=1;}if(id==R27S4_TRACE_CONFIDENCE){v[0]=500;}if(id==R27S4_TRACE_PARENT){v[0]=-1;}
  if(id==R27S4_RNG_PCG64){v[0]=60943;v[1]=28063;v[2]=11852;v[3]=47885;v[4]=14922;v[5]=7899;v[6]=43149;v[7]=13154;v[8]=47871;v[9]=29307;v[10]=18211;v[11]=12539;v[12]=37667;v[13]=11878;v[14]=12368;v[15]=22841;}
  if(id==R27S4_PENDING_CREDIT){v[0]=1;v[1]=0;v[2]=4;v[3]=0;v[4]=2;v[5]=5;v[6]=2;v[7]=1;}
  let s:[]u8=nio_alloc(r27s4_section_bytes(id));if(r27s4_encode_i32_section(s,id,v)!=0||r27i4_add(image,&count,&next,id,s)!=0){return "";}id=id+1;}
 if(r27i4_finish(image,count,next)!=0){return "";}return image;
}
fn r34fe1_learner()[]u8 {let im:[]u8=r34fe1_image();let p:[]u8=nio_alloc(r33cla1_expected_bytes());if(r33cla1_pack(p,im)!=R33CLA1_OK){return "";}return p;}
fn r34fe1_world()[]u8 {let w:[]u8=nio_alloc(CW_BYTES);if(cw_init(w,1717)!=0){return "";}let a:CWOutcome=cw_step(w,1);let b:CWOutcome=cw_step(w,4);if(a.status!=0||b.status!=0||cl_u32(w,8)!=2||cl_u32(w,44)!=2||cl_u32(w,40)!=5){return "";}return w;}
fn r34fe1_ingress()[]u8 {let b:[]u8=nio_alloc(16);let s:CLStream=CLStream{.source=1,.clock=1,.sequence=3,.tick=2000};if(cl_stream_save(&s,b)!=0){return "";}return b;}

fn r34fe1_cross_pending(learner:[]u8,world:[]u8,ingress:[]u8,sidecar:[]u8)i32 {
 if(r33pc1_check(learner,world,ingress)!=R33PC1_OK||r34ns1_check(sidecar)!=R34NS1_OK){return R34FE1_PENDING;}
 let sp:[6]i32=[0,0,0,0,0,0];if(r34ns1_pending(sidecar,sp)!=R34NS1_OK){return R34FE1_PENDING;}let image:[]u8=r33cla1_extract(learner);if(image.len==0){return R34FE1_PENDING;}
 let active:i32=0;let action:i32=0;let issued:i32=0;let due:i32=0;let obs:i32=0;let token:i32=0;
 if(r33pc1_pending_value(image,0,&active)!=0||r33pc1_pending_value(image,2,&action)!=0||r33pc1_pending_value(image,4,&issued)!=0||r33pc1_pending_value(image,5,&due)!=0||r33pc1_pending_value(image,6,&obs)!=0||r33pc1_pending_value(image,7,&token)!=0){return R34FE1_PENDING;}
 if(sp[0]!=active||sp[1]!=action||sp[2]!=issued||sp[3]!=due||sp[4]!=obs||sp[5]!=token){return R34FE1_PENDING;}
 let stream:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};if(cl_stream_load(ingress,&stream)!=0||sp[4]>stream.sequence){return R34FE1_PENDING;}return R34FE1_OK;
}

fn r34fe1_start(learner:*[]u8,receipt:*[]u8,world:*[]u8,ingress:*[]u8,sidecar:*[]u8)i32 {
 learner.*=r34fe1_learner();receipt.*=r34fe1_receipt();world.*=r34fe1_world();ingress.*=r34fe1_ingress();sidecar.*=nio_alloc(R34NS1_BYTES);if(r34ns1_init(sidecar.*)!=0){return 1;}
 if(learner.*.len!=R33LOB1_LEARNER_BYTES||receipt.*.len!=R27PR2_BYTES||world.*.len!=CW_BYTES||ingress.*.len!=16||sidecar.*.len!=R34NS1_BYTES){return 2;}return r34fe1_cross_pending(learner.*,world.*,ingress.*,sidecar.*);
}

fn r34fe1_continue(learner:[]u8,world:[]u8,ingress:[]u8,sidecar:[]u8,observation:[]u8)i32 {
 if(r34fe1_cross_pending(learner,world,ingress,sidecar)!=0){return 1;}let o:CWOutcome=cw_step(world,0);if(o.status!=0||o.tick!=3||o.action!=0){return 2;}
 if(cw_observe(world,observation)!=0){return 3;}let s:CLStream=CLStream{.source=1,.clock=1,.sequence=0,.tick=0};if(cl_stream_load(ingress,&s)!=0||cl_stream_accept(&s,observation)!=0||cl_stream_save(&s,ingress)!=0){return 4;}
 if(cl_u32(world,8)!=3||cl_u32(world,44)!=2||cl_u32(world,40)!=5||cl_u32(ingress,8)!=4){return 5;}if(r34fe1_cross_pending(learner,world,ingress,sidecar)!=0){return 6;}
 if(r34ns1_step(sidecar,cl_u32(world,8) as i32,cl_u32(ingress,8) as i32)!=R34NS1_OK){return 7;}return r34fe1_cross_pending(learner,world,ingress,sidecar);
}

fn r34fe1_write_result(root:i64,name:[]u8,learner:[]u8,world:[]u8,ingress:[]u8,obs:[]u8,sidecar:[]u8)i32 {
 let out:[]u8=nio_alloc(R34FE1_RESULT_BYTES);if(out.len!=R34FE1_RESULT_BYTES){return 1;}let at:i32=0;if(cl_copy(out[at..at+learner.len],learner)!=0){return 2;}at=at+learner.len;if(cl_copy(out[at..at+world.len],world)!=0){return 3;}at=at+world.len;if(cl_copy(out[at..at+ingress.len],ingress)!=0){return 4;}at=at+ingress.len;if(cl_copy(out[at..at+obs.len],obs)!=0){return 5;}at=at+obs.len;if(cl_copy(out[at..at+sidecar.len],sidecar)!=0){return 6;}return (cl_file_write(root,name,out)!=0) as i32;
}

fn r34fe1_build_envelope(sequence:i32,learner:[]u8,receipt:[]u8,world:[]u8,ingress:[]u8,sidecar:[]u8,out:[]u8)i32 {
 let parent:[]u8=r34fe1_parent();let previous:[]u8=nio_alloc(32);let r33:[]u8=nio_alloc(R34FE1_R33_BUFFER);let rn:i32=r33lob1_build(r33,sequence,previous,parent,learner,receipt,world,ingress);if(rn<1||r33lob1_validate(r33[0..rn],sequence,previous,parent)!=R33LOB1_OK){return -1;}return r34e1_pack(out,sequence,r33[0..rn],sidecar);
}

fn r34fe1_write(root_path:[]u8)i32 {
 let root:i64=nio_open_root(root_path);if(root<0){return 70;}let learner:[]u8="";let receipt:[]u8="";let world:[]u8="";let ingress:[]u8="";let side:[]u8="";if(r34fe1_start(&learner,&receipt,&world,&ingress,&side)!=0){return 71;}let env:[]u8=nio_alloc(R34FE1_ENVELOPE_BUFFER);let n:i32=r34fe1_build_envelope(1,learner,receipt,world,ingress,side,env);if(n<1||r34e1_check(env[0..n],1)!=0){return 72;}let rc:i32=cl_file_write(root,"r34-checkpoint-1.bin",env[0..n]);nio_close(root);return rc;
}
fn r34fe1_uninterrupted(root_path:[]u8)i32 {
 let root:i64=nio_open_root(root_path);if(root<0){return 73;}let learner:[]u8="";let receipt:[]u8="";let world:[]u8="";let ingress:[]u8="";let side:[]u8="";if(r34fe1_start(&learner,&receipt,&world,&ingress,&side)!=0){return 74;}let obs:[]u8=nio_alloc(304);if(r34fe1_continue(learner,world,ingress,side,obs)!=0){return 75;}let rc:i32=r34fe1_write_result(root,"uninterrupted.bin",learner,world,ingress,obs,side);nio_close(root);return rc;
}
fn r34fe1_reload(root_path:[]u8)i32 {
 let root:i64=nio_open_root(root_path);if(root<0){return 76;}let env:[]u8=nio_alloc(R34FE1_ENVELOPE_BUFFER);let n:i32=cl_file_read(root,"r34-checkpoint-1.bin",env,R34FE1_ENVELOPE_BUFFER);if(n<1||r34e1_check(env[0..n],1)!=0){return 77;}let r33:[]u8=r34e1_r33(env[0..n]);let side_src:[]u8=r34e1_sidecar(env[0..n]);let parent:[]u8=r34fe1_parent();let previous:[]u8=nio_alloc(32);if(r33lob1_validate(r33,1,previous,parent)!=R33LOB1_OK){return 78;}
 let learner:[]u8=cl_checkpoint_get(r33,1);let world:[]u8=nio_alloc(CW_BYTES);let ingress:[]u8=nio_alloc(16);let side:[]u8=nio_alloc(R34NS1_BYTES);if(cl_copy(world,cl_checkpoint_get(r33,11))!=0||cl_copy(ingress,cl_checkpoint_get(r33,12))!=0||cl_copy(side,side_src)!=0){return 79;}if(r34fe1_cross_pending(learner,world,ingress,side)!=0){return 80;}let obs:[]u8=nio_alloc(304);if(r34fe1_continue(learner,world,ingress,side,obs)!=0){return 81;}let rc:i32=r34fe1_write_result(root,"reloaded.bin",learner,world,ingress,obs,side);nio_close(root);return rc;
}
fn r34fe1_compare_results(root_path:[]u8)i32 {let root:i64=nio_open_root(root_path);if(root<0){return 1;}let a:[]u8=nio_alloc(R34FE1_RESULT_BYTES);let b:[]u8=nio_alloc(R34FE1_RESULT_BYTES);let na:i32=cl_file_read(root,"uninterrupted.bin",a,R34FE1_RESULT_BYTES);let nb:i32=cl_file_read(root,"reloaded.bin",b,R34FE1_RESULT_BYTES);nio_close(root);return (na!=R34FE1_RESULT_BYTES||nb!=R34FE1_RESULT_BYTES||nio_equal(a,b)!=1) as i32;}

fn r34fe1_inner_corrupt(root_path:[]u8)i32 {
 let root:i64=nio_open_root(root_path);if(root<0){return 82;}let env:[]u8=nio_alloc(R34FE1_ENVELOPE_BUFFER);let n:i32=cl_file_read(root,"r34-checkpoint-1.bin",env,R34FE1_ENVELOPE_BUFFER);if(n<1||r34e1_check(env[0..n],1)!=0){return 83;}let r33n:i32=0;r34ns1_get_i32(env,12,&r33n);let at:i32=R34E1_HEADER_BYTES+r33n+R34NS1_HEADER_BYTES+12;env[at]=env[at]^1;if(r34e1_reseal_outer(env[0..n])!=0){return 84;}let rc:i32=cl_file_write(root,"r34-checkpoint-corrupt.bin",env[0..n]);nio_close(root);return rc;
}
fn r34fe1_corrupt_refusal(root_path:[]u8)i32 {let root:i64=nio_open_root(root_path);if(root<0){return 85;}let env:[]u8=nio_alloc(R34FE1_ENVELOPE_BUFFER);let n:i32=cl_file_read(root,"r34-checkpoint-corrupt.bin",env,R34FE1_ENVELOPE_BUFFER);nio_close(root);if(n<1){return 86;}return (r34e1_check(env[0..n],1)!=R34E1_SIDECAR) as i32;}
fn r34fe1_torn(root_path:[]u8)i32 {let root:i64=nio_open_root(root_path);if(root<0){return 87;}let env:[]u8=nio_alloc(R34FE1_ENVELOPE_BUFFER);let n:i32=cl_file_read(root,"r34-checkpoint-1.bin",env,R34FE1_ENVELOPE_BUFFER);if(n<1){return 88;}let rc:i32=cl_file_write(root,"r34-checkpoint-torn.bin",env[0..n/2]);nio_close(root);return rc;}
fn r34fe1_torn_refusal(root_path:[]u8)i32 {let root:i64=nio_open_root(root_path);if(root<0){return 89;}let env:[]u8=nio_alloc(R34FE1_ENVELOPE_BUFFER);let n:i32=cl_file_read(root,"r34-checkpoint-torn.bin",env,R34FE1_ENVELOPE_BUFFER);nio_close(root);if(n<1){return 90;}return (r34e1_check(env[0..n],1)==R34E1_OK) as i32;}
fn r34fe1_pending_mismatch(root_path:[]u8)i32 {let learner:[]u8="";let receipt:[]u8="";let world:[]u8="";let ingress:[]u8="";let side:[]u8="";if(r34fe1_start(&learner,&receipt,&world,&ingress,&side)!=0){return 91;}if(r34ns1_set_pending_action(side,3)!=0||r34ns1_check(side)!=0){return 92;}return (r34fe1_cross_pending(learner,world,ingress,side)==0) as i32;}

struct R34FE1Run {started:i32,exit_code:i32,signal:i32}
fn r34fe1_run(binary:[]u8,mode:[]u8,root:[]u8)R34FE1Run {
 let out:R34FE1Run=R34FE1Run{.started=0,.exit_code=-1,.signal=0};let b:[]u8=nio_cstr(binary);let m:[]u8=nio_cstr(mode);let r:[]u8=nio_cstr(root);let argv:*i64=_zag_malloc(32) as *i64;let env:*i64=_zag_malloc(8) as *i64;let status:*i32=_zag_malloc(8) as *i32;if(b.len==0||m.len==0||r.len==0||argv==null as *i64||env==null as *i64||status==null as *i32){return out;}argv[0]=_zag_slice_ptr(b) as i64;argv[1]=_zag_slice_ptr(m) as i64;argv[2]=_zag_slice_ptr(r) as i64;argv[3]=0;env[0]=0;status[0]=0;let pid:i64=_zag_darwin_fork();if(pid==0){_zag_darwin_syscall(59,_zag_slice_ptr(b) as i64,argv as i64,env as i64,0,0,0);_zag_exit(127);}if(pid>0){out.started=1;let w:i64=_zag_darwin_syscall(7,pid,status as i64,0,0,0,0,0);if(w==pid){out.signal=status[0]&127;if(out.signal==0){out.exit_code=(status[0]>>8)&255;}}}return out;
}
fn r34fe1_run_ok(r:R34FE1Run)i32 @noalloc {return (r.started==1&&r.exit_code==0&&r.signal==0) as i32;}
fn r34fe1_supervise(binary:[]u8,root:[]u8)i32 {
 let f:i32=0;let a:R34FE1Run=r34fe1_run(binary,"write",root);f=f+((r34fe1_run_ok(a)!=1) as i32);let b:R34FE1Run=r34fe1_run(binary,"uninterrupted",root);f=f+((r34fe1_run_ok(b)!=1) as i32);let c:R34FE1Run=r34fe1_run(binary,"reload",root);f=f+((r34fe1_run_ok(c)!=1) as i32);f=f+r34fe1_compare_results(root);
 let d:R34FE1Run=r34fe1_run(binary,"inner-corrupt",root);f=f+((r34fe1_run_ok(d)!=1) as i32);let e:R34FE1Run=r34fe1_run(binary,"corrupt-refusal",root);f=f+((r34fe1_run_ok(e)!=1) as i32);let g:R34FE1Run=r34fe1_run(binary,"torn",root);f=f+((r34fe1_run_ok(g)!=1) as i32);let h:R34FE1Run=r34fe1_run(binary,"torn-refusal",root);f=f+((r34fe1_run_ok(h)!=1) as i32);let q:R34FE1Run=r34fe1_run(binary,"pending-mismatch",root);f=f+((r34fe1_run_ok(q)!=1) as i32);
 _zag_print("R34_FRESH_PROCESS_EQUIVALENCE_V1_FAILURES,");cl_number(f as i64);_zag_println("");_zag_print("R34_FRESH_PROCESS_EQUIVALENCE_V1_RESULT_BYTES,");cl_number(R34FE1_RESULT_BYTES);_zag_println("");_zag_print("R34_FRESH_PROCESS_EQUIVALENCE_V1_LEARN_AUTHORITY,");cl_number(0);_zag_println("");return (f!=0) as i32;
}
fn main()i32 {if(_zag_argc()!=3){return 64;}let mode:[]u8=_zag_arg(1);let root:[]u8=_zag_arg(2);if(nio_equal(mode,"write")==1){return r34fe1_write(root);}if(nio_equal(mode,"uninterrupted")==1){return r34fe1_uninterrupted(root);}if(nio_equal(mode,"reload")==1){return r34fe1_reload(root);}if(nio_equal(mode,"inner-corrupt")==1){return r34fe1_inner_corrupt(root);}if(nio_equal(mode,"corrupt-refusal")==1){return r34fe1_corrupt_refusal(root);}if(nio_equal(mode,"torn")==1){return r34fe1_torn(root);}if(nio_equal(mode,"torn-refusal")==1){return r34fe1_torn_refusal(root);}if(nio_equal(mode,"pending-mismatch")==1){return r34fe1_pending_mismatch(root);}if(nio_equal(mode,"supervise")==1){return r34fe1_supervise(_zag_arg(0),root);}return 65;}

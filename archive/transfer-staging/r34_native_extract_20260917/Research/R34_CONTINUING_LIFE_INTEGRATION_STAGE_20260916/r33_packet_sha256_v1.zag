// R33 packet-local SHA-256 V1.
// Native Zag only. This is the sole SHA-256 implementation used by the
// self-contained R25 rows 20-26 replay packet. It exposes the historical
// ns_sha256(input,out) API expected by the recovered N17 sources.
const R33PSHA_OK:i32=0;
const R33PSHA_SHAPE:i32=-27601;

fn r33psha_u32(x:u64)u64 @noalloc { return x & 0xffffffff; }
fn r33psha_rotr(x:u64,n:i32)u64 @noalloc {
    let v:u64=r33psha_u32(x);
    return r33psha_u32((v>>n)|(v<<(32-n)));
}
fn r33psha_k(i:i32)u64 @noalloc {
    if(i==0){return 0x428a2f98;}if(i==1){return 0x71374491;}if(i==2){return 0xb5c0fbcf;}if(i==3){return 0xe9b5dba5;}
    if(i==4){return 0x3956c25b;}if(i==5){return 0x59f111f1;}if(i==6){return 0x923f82a4;}if(i==7){return 0xab1c5ed5;}
    if(i==8){return 0xd807aa98;}if(i==9){return 0x12835b01;}if(i==10){return 0x243185be;}if(i==11){return 0x550c7dc3;}
    if(i==12){return 0x72be5d74;}if(i==13){return 0x80deb1fe;}if(i==14){return 0x9bdc06a7;}if(i==15){return 0xc19bf174;}
    if(i==16){return 0xe49b69c1;}if(i==17){return 0xefbe4786;}if(i==18){return 0x0fc19dc6;}if(i==19){return 0x240ca1cc;}
    if(i==20){return 0x2de92c6f;}if(i==21){return 0x4a7484aa;}if(i==22){return 0x5cb0a9dc;}if(i==23){return 0x76f988da;}
    if(i==24){return 0x983e5152;}if(i==25){return 0xa831c66d;}if(i==26){return 0xb00327c8;}if(i==27){return 0xbf597fc7;}
    if(i==28){return 0xc6e00bf3;}if(i==29){return 0xd5a79147;}if(i==30){return 0x06ca6351;}if(i==31){return 0x14292967;}
    if(i==32){return 0x27b70a85;}if(i==33){return 0x2e1b2138;}if(i==34){return 0x4d2c6dfc;}if(i==35){return 0x53380d13;}
    if(i==36){return 0x650a7354;}if(i==37){return 0x766a0abb;}if(i==38){return 0x81c2c92e;}if(i==39){return 0x92722c85;}
    if(i==40){return 0xa2bfe8a1;}if(i==41){return 0xa81a664b;}if(i==42){return 0xc24b8b70;}if(i==43){return 0xc76c51a3;}
    if(i==44){return 0xd192e819;}if(i==45){return 0xd6990624;}if(i==46){return 0xf40e3585;}if(i==47){return 0x106aa070;}
    if(i==48){return 0x19a4c116;}if(i==49){return 0x1e376c08;}if(i==50){return 0x2748774c;}if(i==51){return 0x34b0bcb5;}
    if(i==52){return 0x391c0cb3;}if(i==53){return 0x4ed8aa4a;}if(i==54){return 0x5b9cca4f;}if(i==55){return 0x682e6ff3;}
    if(i==56){return 0x748f82ee;}if(i==57){return 0x78a5636f;}if(i==58){return 0x84c87814;}if(i==59){return 0x8cc70208;}
    if(i==60){return 0x90befffa;}if(i==61){return 0xa4506ceb;}if(i==62){return 0xbef9a3f7;}return 0xc67178f2;
}

fn r33psha_compress(block:[]u8,h:[]u64,w:[]u64)i32 @noalloc {
    if(block.len!=64 || h.len!=8 || w.len!=64){return R33PSHA_SHAPE;}
    let i:i32=0;
    while(i<16){
        let at:i32=i*4;
        w[i]=((block[at] as u64)<<24)|((block[at+1] as u64)<<16)|((block[at+2] as u64)<<8)|(block[at+3] as u64);
        i=i+1;
    }
    while(i<64){
        let x:u64=w[i-15];let y:u64=w[i-2];
        let s0:u64=r33psha_rotr(x,7)^r33psha_rotr(x,18)^(x>>3);
        let s1:u64=r33psha_rotr(y,17)^r33psha_rotr(y,19)^(y>>10);
        w[i]=r33psha_u32(w[i-16]+s0+w[i-7]+s1);i=i+1;
    }
    let a:u64=h[0];let b:u64=h[1];let c:u64=h[2];let d:u64=h[3];
    let e:u64=h[4];let f:u64=h[5];let g:u64=h[6];let hh:u64=h[7];
    i=0;while(i<64){
        let s1:u64=r33psha_rotr(e,6)^r33psha_rotr(e,11)^r33psha_rotr(e,25);
        let ch:u64=(e&f)^((e^0xffffffff)&g);
        let t1:u64=r33psha_u32(hh+s1+ch+r33psha_k(i)+w[i]);
        let s0:u64=r33psha_rotr(a,2)^r33psha_rotr(a,13)^r33psha_rotr(a,22);
        let maj:u64=(a&b)^(a&c)^(b&c);
        let t2:u64=r33psha_u32(s0+maj);
        hh=g;g=f;f=e;e=r33psha_u32(d+t1);d=c;c=b;b=a;a=r33psha_u32(t1+t2);
        i=i+1;
    }
    h[0]=r33psha_u32(h[0]+a);h[1]=r33psha_u32(h[1]+b);h[2]=r33psha_u32(h[2]+c);h[3]=r33psha_u32(h[3]+d);
    h[4]=r33psha_u32(h[4]+e);h[5]=r33psha_u32(h[5]+f);h[6]=r33psha_u32(h[6]+g);h[7]=r33psha_u32(h[7]+hh);
    return R33PSHA_OK;
}

fn ns_sha256(input:[]u8,out:[]u8)i32 {
    if(out.len!=32 || input.len<0){return R33PSHA_SHAPE;}
    let h:[]u64=new u64(8);let w:[]u64=new u64(64);
    h[0]=0x6a09e667;h[1]=0xbb67ae85;h[2]=0x3c6ef372;h[3]=0xa54ff53a;
    h[4]=0x510e527f;h[5]=0x9b05688c;h[6]=0x1f83d9ab;h[7]=0x5be0cd19;
    let full:i32=input.len/64;let bi:i32=0;
    while(bi<full){let rc:i32=r33psha_compress(input[bi*64..bi*64+64],h,w);if(rc!=0){return rc;}bi=bi+1;}
    let rem:i32=input.len-full*64;let tail:[]u8=new u8(128);let i:i32=0;while(i<128){tail[i]=0;i=i+1;}
    i=0;while(i<rem){tail[i]=input[full*64+i];i=i+1;}tail[rem]=0x80;
    let blocks:i32=1;if(rem>55){blocks=2;}
    let bitlen:u64=(input.len as u64)*8;let lenat:i32=blocks*64-8;
    i=0;while(i<8){tail[lenat+i]=((bitlen>>((7-i)*8))&255) as u8;i=i+1;}
    i=0;while(i<blocks){let rc:i32=r33psha_compress(tail[i*64..i*64+64],h,w);if(rc!=0){return rc;}i=i+1;}
    i=0;while(i<8){let v:u64=h[i];out[i*4]=((v>>24)&255) as u8;out[i*4+1]=((v>>16)&255) as u8;out[i*4+2]=((v>>8)&255) as u8;out[i*4+3]=(v&255) as u8;i=i+1;}
    return R33PSHA_OK;
}

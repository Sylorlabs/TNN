// R34 self-organizing memory association substrate V1.
//
// Primitive only: create/find/strengthen/weaken/delete/query associations.
// No memory hierarchy, graph authority, semantic labels, task categories, or
// human eviction rule is encoded here. The caller owns when links are created,
// what delayed consequence supplies credit, and which slot may be replaced.

const R34A1_OK:i32=0;
const R34A1_BAD:i32=-340201;
const R34A1_SHAPE:i32=-340202;
const R34A1_CAPACITY:i32=-340203;
const R34A1_NOT_FOUND:i32=-340204;
const R34A1_NUMERIC:i32=-340205;

fn r34a1_order(a:i32,b:i32,out_a:*i32,out_b:*i32)i32 @noalloc {
    if(out_a==null as *i32 || out_b==null as *i32 || a<0 || b<0 || a==b){return R34A1_SHAPE;}
    if(a<b){out_a.*=a;out_b.*=b;}else{out_a.*=b;out_b.*=a;}return R34A1_OK;
}

fn r34a1_find(left:[]i32,right:[]i32,active:[]i32,a:i32,b:i32,out:*i32)i32 @noalloc {
    if(out==null as *i32 || left.len<1 || left.len!=right.len || left.len!=active.len){return R34A1_SHAPE;}
    let x:i32=0;let y:i32=0;if(r34a1_order(a,b,&x,&y)!=R34A1_OK){return R34A1_SHAPE;}
    let i:i32=0;while(i<left.len){if(active[i]!=0 && left[i]==x && right[i]==y){out.*=i;return R34A1_OK;}i=i+1;}
    out.*=-1;return R34A1_NOT_FOUND;
}

// Create an association in a caller-selected empty/replacement slot. The
// substrate never decides which existing memory deserves eviction.
fn r34a1_put(left:[]i32,right:[]i32,strength:[]f32,uses:[]i32,active:[]i32,
    slot:i32,a:i32,b:i32,initial:f64)i32 @noalloc {
    if(left.len<1 || left.len!=right.len || left.len!=strength.len || left.len!=uses.len || left.len!=active.len ||
       slot<0 || slot>=left.len || initial!=initial || initial>1.0e30 || initial<(-1.0e30)){return R34A1_SHAPE;}
    let x:i32=0;let y:i32=0;if(r34a1_order(a,b,&x,&y)!=R34A1_OK){return R34A1_SHAPE;}
    left[slot]=x;right[slot]=y;strength[slot]=initial as f32;uses[slot]=0;active[slot]=1;return R34A1_OK;
}

fn r34a1_credit(strength:[]f32,uses:[]i32,active:[]i32,slot:i32,delta:f64)i32 @noalloc {
    if(strength.len<1 || strength.len!=uses.len || strength.len!=active.len || slot<0 || slot>=strength.len || active[slot]==0 ||
       delta!=delta || delta>1.0e30 || delta<(-1.0e30)){return R34A1_SHAPE;}
    let next:f64=(strength[slot] as f64)+delta;if(next!=next || next>1.0e30 || next<(-1.0e30)){return R34A1_NUMERIC;}
    strength[slot]=next as f32;uses[slot]=uses[slot]+1;return R34A1_OK;
}

fn r34a1_delete(left:[]i32,right:[]i32,strength:[]f32,uses:[]i32,active:[]i32,slot:i32)i32 @noalloc {
    if(left.len<1 || left.len!=right.len || left.len!=strength.len || left.len!=uses.len || left.len!=active.len || slot<0 || slot>=left.len){return R34A1_SHAPE;}
    left[slot]=-1;right[slot]=-1;strength[slot]=0.0;uses[slot]=0;active[slot]=0;return R34A1_OK;
}

// Return up to k strongest associated neighbors. Negative strengths remain
// observable; caller policy decides whether they are useful inhibitory evidence.
fn r34a1_neighbors(left:[]i32,right:[]i32,strength:[]f32,active:[]i32,node:i32,
    out_node:[]i32,out_strength:[]f32,k:i32,out_count:*i32)i32 @noalloc {
    if(out_count==null as *i32 || left.len<1 || left.len!=right.len || left.len!=strength.len || left.len!=active.len ||
       node<0 || k<1 || out_node.len<k || out_strength.len<k){return R34A1_SHAPE;}
    let j:i32=0;while(j<k){out_node[j]=-1;out_strength[j]=(-1.0e30) as f32;j=j+1;}
    let i:i32=0;let found:i32=0;
    while(i<left.len){
        if(active[i]!=0 && (left[i]==node || right[i]==node)){
            let other:i32=left[i];if(other==node){other=right[i];}
            let v:f32=strength[i];
            j=0;while(j<k){
                if(out_node[j]<0 || v>out_strength[j]){
                    let q:i32=k-1;while(q>j){out_node[q]=out_node[q-1];out_strength[q]=out_strength[q-1];q=q-1;}
                    out_node[j]=other;out_strength[j]=v;j=k;
                }else{j=j+1;}
            }
            found=found+1;
        }
        i=i+1;
    }
    out_count.*=found;if(out_count.*>k){out_count.*=k;}return R34A1_OK;
}

fn r34a1_state_equal(a_left:[]i32,a_right:[]i32,a_strength:[]f32,a_uses:[]i32,a_active:[]i32,
    b_left:[]i32,b_right:[]i32,b_strength:[]f32,b_uses:[]i32,b_active:[]i32)i32 @noalloc {
    if(a_left.len!=b_left.len || a_left.len!=a_right.len || a_left.len!=a_strength.len || a_left.len!=a_uses.len || a_left.len!=a_active.len ||
       b_left.len!=b_right.len || b_left.len!=b_strength.len || b_left.len!=b_uses.len || b_left.len!=b_active.len){return 0;}
    let i:i32=0;while(i<a_left.len){if(a_left[i]!=b_left[i] || a_right[i]!=b_right[i] || a_strength[i]!=b_strength[i] || a_uses[i]!=b_uses[i] || a_active[i]!=b_active[i]){return 0;}i=i+1;}return 1;
}

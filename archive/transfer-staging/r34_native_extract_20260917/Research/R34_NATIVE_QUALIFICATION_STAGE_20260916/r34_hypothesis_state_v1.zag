// R34 continual-learning foundation: non-graph multi-hypothesis state V1.
//
// This module is a generic substrate. It stores no human labels, task names,
// graph edges, evaluator answers, or fixed UNKNOWN threshold. Caller-owned
// learned weights determine how evidence contributes to competing hypotheses.
// Delayed pairwise credit can revise those weights after later consequences.

const R34H1_OK:i32=0;
const R34H1_BAD:i32=-340101;
const R34H1_SHAPE:i32=-340102;
const R34H1_NUMERIC:i32=-340103;
const R34H1_RANGE:i32=-340104;

struct R34H1Ranking {
    top_slot:i32,
    second_slot:i32,
    top_score:f64,
    second_score:f64,
    margin:f64,
    active_count:i32,
}

fn r34h1_finite(x:f64)i32 @noalloc {
    return (x==x && x<1.0e300 && x>(-1.0e300)) as i32;
}

fn r34h1_dot(weights:[]f32,features:[]f32,out:*f64)i32 @noalloc {
    if(out==null as *f64 || weights.len<1 || weights.len!=features.len){return R34H1_SHAPE;}
    let s:f64=0.0;let i:i32=0;
    while(i<weights.len){
        let w:f64=weights[i] as f64;let x:f64=features[i] as f64;
        if(r34h1_finite(w)!=1 || r34h1_finite(x)!=1){return R34H1_NUMERIC;}
        s=s+w*x;if(r34h1_finite(s)!=1){return R34H1_NUMERIC;}i=i+1;
    }
    out.*=s;return R34H1_OK;
}

// Apply one evidence step to every active hypothesis. `retention` is caller-owned
// learned state in [0,1]; the substrate does not prescribe stickiness.
fn r34h1_observe(support:[]f64,active:[]i32,evidence:[]f32,weights:[]f32,
    capacity:i32,feature_dim:i32,retention:f64)i32 @noalloc {
    if(capacity<1 || feature_dim<1 || support.len!=capacity || active.len!=capacity ||
       evidence.len!=capacity*feature_dim || weights.len!=feature_dim ||
       !(retention>=0.0) || !(retention<=1.0)){return R34H1_SHAPE;}
    let h:i32=0;
    while(h<capacity){
        if(active[h]!=0){
            let delta:f64=0.0;
            if(r34h1_dot(weights,evidence[h*feature_dim..h*feature_dim+feature_dim],&delta)!=R34H1_OK){return R34H1_NUMERIC;}
            support[h]=retention*support[h]+delta;
            if(r34h1_finite(support[h])!=1){return R34H1_NUMERIC;}
        }
        h=h+1;
    }
    return R34H1_OK;
}

// Rank active hypotheses. This reports evidence and margin only; it intentionally
// does not force SAME/DIFFERENT/UNKNOWN from a researcher-authored threshold.
fn r34h1_rank(support:[]f64,active:[]i32,out:*R34H1Ranking)i32 @noalloc {
    if(out==null as *R34H1Ranking || support.len<1 || support.len!=active.len){return R34H1_SHAPE;}
    let top:i32=-1;let second:i32=-1;let topv:f64=-1.0e300;let secondv:f64=-1.0e300;let n:i32=0;let i:i32=0;
    while(i<support.len){
        if(active[i]!=0){
            let v:f64=support[i];if(r34h1_finite(v)!=1){return R34H1_NUMERIC;}n=n+1;
            if(top<0 || v>topv){second=top;secondv=topv;top=i;topv=v;}
            else if(second<0 || v>secondv){second=i;secondv=v;}
        }
        i=i+1;
    }
    if(top<0){return R34H1_RANGE;}
    let margin:f64=0.0;if(second>=0){margin=topv-secondv;}
    out.*=R34H1Ranking{.top_slot=top,.second_slot=second,.top_score=topv,.second_score=secondv,.margin=margin,.active_count=n};
    return R34H1_OK;
}

// Delayed evidence says features A were more useful than features B. The caller
// chooses A/B from lived consequences. This module never receives a hidden task
// label or future evaluator answer directly.
fn r34h1_pairwise_credit(weights:[]f32,features_a:[]f32,features_b:[]f32,
    learning_rate:f64,strength:f64)i32 @noalloc {
    if(weights.len<1 || features_a.len!=weights.len || features_b.len!=weights.len ||
       !(learning_rate>=0.0) || !(strength>=0.0)){return R34H1_SHAPE;}
    let i:i32=0;
    while(i<weights.len){
        let da:f64=features_a[i] as f64;let db:f64=features_b[i] as f64;
        if(r34h1_finite(da)!=1 || r34h1_finite(db)!=1){return R34H1_NUMERIC;}
        let next:f64=(weights[i] as f64)+learning_rate*strength*(da-db);
        if(r34h1_finite(next)!=1){return R34H1_NUMERIC;}
        weights[i]=next as f32;i=i+1;
    }
    return R34H1_OK;
}

fn r34h1_activate(active:[]i32,support:[]f64,slot:i32,initial_support:f64)i32 @noalloc {
    if(active.len<1 || active.len!=support.len || slot<0 || slot>=active.len || r34h1_finite(initial_support)!=1){return R34H1_SHAPE;}
    active[slot]=1;support[slot]=initial_support;return R34H1_OK;
}

fn r34h1_deactivate(active:[]i32,support:[]f64,slot:i32)i32 @noalloc {
    if(active.len<1 || active.len!=support.len || slot<0 || slot>=active.len){return R34H1_SHAPE;}
    active[slot]=0;support[slot]=0.0;return R34H1_OK;
}

fn r34h1_state_equal(a_support:[]f64,a_active:[]i32,b_support:[]f64,b_active:[]i32)i32 @noalloc {
    if(a_support.len!=b_support.len || a_active.len!=b_active.len || a_support.len!=a_active.len){return 0;}
    let i:i32=0;while(i<a_support.len){if(a_support[i]!=b_support[i] || a_active[i]!=b_active[i]){return 0;}i=i+1;}return 1;
}

@import("toolchain/R33_NATIVE_IO_V1.zag")
// deliberate.zag — TNN scene deliberation (pure Zag, zero RNG).
//
// Task: choose the playground scene TNN will imagine. The DELIBERATION
// PROCEDURE (the 7 criteria and their rules) is authored; the EVALUATION
// is TNN's own: it scores all 1296 configurations deterministically and
// takes the argmax. The reasoning is recorded, not asserted.
//
// Writes:
//   scene_spec.zag        — accessor fns consumed by scene.zag (@import)
//   DELIBERATION_TRACE.txt — the full reasoning record
//
// Dims: mood{0 quiet-morning,1 lively-midday,2 golden-evening}
//       ages{0 toddlers 2-3,1 preschool 4-5,2 mixed 3-6}
//       cnt {0,1,2,3} -> children{2,3,4,5}
//       play{0 swings,1 slide,2 ball-game,3 mixed-free-play}
//       space{0 pocket-park,1 schoolyard,2 open-field}
//       dur {0,1,2} -> seconds{12,15,18}

fn d_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) {
        b[i] = s[i];
        i = i + 1;
    }
    b[s.len] = 0;
    return b;
}

// criterion 1: creative-law fit — one coherent world (Micah's law:
// never a sequence of clips; a real playground is simultaneous activity)
fn c_law(play:i64) i64 {
    if (play == 3) { return 2; }
    if (play == 2) { return 2; }
    return 1;
}
// criterion 2: the two learned pitched voices (cry F0~345Hz, vowel F0~317Hz)
// fit ages 3-6; 5 children stretches 2 base voices thin
fn c_voice(ages:i64, cnt:i64) i64 {
    let base:i64 = 0;
    if (ages == 2) { base = 2; }
    if (ages == 1) { base = 1; }
    if (cnt == 3) { base = base - 1; }
    if (base < 0) { base = 0; }
    return base;
}
// criterion 3: texture feasibility — learned clang (metal) + strike (impact);
// no fixture exists for swing-creak or slide-whoosh
fn c_texture(play:i64) i64 {
    if (play == 2) { return 2; }
    if (play == 3) { return 2; }
    if (play == 1) { return 1; }
    return 0;
}
// criterion 4: one coherent air — small enclosed pocket park keeps
// distances consistent; open field diffuses the space
fn c_space(space:i64) i64 {
    if (space == 0) { return 2; }
    return 1;
}
// criterion 5: mood/play fit — polyphonic play wants lively midday
fn c_mood(mood:i64) i64 {
    if (mood == 1) { return 2; }
    if (mood == 2) { return 1; }
    return 0;
}
// criterion 6: duration — 15s holds overlapping phrases without looping
// the small voice inventory; 12 thin, 18 risks repetition
fn c_dur(dur:i64) i64 {
    if (dur == 1) { return 2; }
    return 1;
}
// criterion 7: anti-clip — simultaneous mixed activity over sequences
fn c_clip(play:i64) i64 {
    if (play == 3) { return 2; }
    if (play == 2) { return 1; }
    return 0;
}

fn d_score(mood:i64, ages:i64, cnt:i64, play:i64, space:i64, dur:i64) i64 {
    return c_law(play) + c_voice(ages, cnt) + c_texture(play) + c_space(space) + c_mood(mood) + c_dur(dur) + c_clip(play);
}

// text buffer helpers
fn tb_put(buf:[]u8, pos:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) {
        buf[pos + i] = s[i];
        i = i + 1;
    }
    return pos + s.len;
}
fn tb_i64(buf:[]u8, pos:i64, v:i64) i64 {
    let s:[]u8 = _zag_i64_to_str(v);
    let p:i64 = tb_put(buf, pos, s);
    nio_free(s);
    return p;
}
fn d_write_file(path:[]u8, buf:[]u8, len:i64) void {
    let cs:[]u8 = d_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs) as i64, 577, 420, 0, 0, 0);
    if (fd >= 0) {
        let at:i64 = 0;
        while (at < len) {
            let w:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(buf) as i64) + at, len - at, 0, 0, 0);
            if (w <= 0) { break; }
            at = at + w;
        }
        _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    }
    nio_free(cs);
    return;
}

fn main() void {
    // enumerate 1296 configs; argmax with tie-break: larger cnt (richer
    // polyphony) wins, then lower index
    let best:i64 = -1;
    let bmood:i64 = 0;
    let bages:i64 = 0;
    let bcnt:i64 = 0;
    let bplay:i64 = 0;
    let bspace:i64 = 0;
    let bdur:i64 = 0;
    let bscore:i64 = -1;
    let idx:i64 = 0;
    while (idx < 1296) {
        let mood:i64 = idx / 432;
        let r1:i64 = idx % 432;
        let ages:i64 = r1 / 144;
        let r2:i64 = r1 % 144;
        let cnt:i64 = r2 / 36;
        let r3:i64 = r2 % 36;
        let play:i64 = r3 / 9;
        let r4:i64 = r3 % 9;
        let space:i64 = r4 / 3;
        let dur:i64 = r4 % 3;
        let s:i64 = d_score(mood, ages, cnt, play, space, dur);
        let take:i64 = 0;
        if (s > bscore) { take = 1; }
        if (s == bscore and cnt > bcnt) { take = 1; }
        if (take == 1) {
            bscore = s;
            best = idx;
            bmood = mood;
            bages = ages;
            bcnt = cnt;
            bplay = play;
            bspace = space;
            bdur = dur;
        }
        idx = idx + 1;
    }
    let children:i64 = bcnt + 2;
    let dur_s:i64 = 12;
    if (bdur == 1) { dur_s = 15; }
    if (bdur == 2) { dur_s = 18; }
    // ---- write scene_spec.zag (accessor fns; scene.zag @imports this) ----
    let spec:[]u8 = nio_alloc(2048);
    let p:i64 = 0;
    p = tb_put(spec, p, "// generated by deliberate.zag — do not hand-edit\n");
    p = tb_put(spec, p, "fn spec_mood() i64 { return ");
    p = tb_i64(spec, p, bmood);
    p = tb_put(spec, p, "; }\n");
    p = tb_put(spec, p, "fn spec_ages() i64 { return ");
    p = tb_i64(spec, p, bages);
    p = tb_put(spec, p, "; }\n");
    p = tb_put(spec, p, "fn spec_count() i64 { return ");
    p = tb_i64(spec, p, children);
    p = tb_put(spec, p, "; }\n");
    p = tb_put(spec, p, "fn spec_play() i64 { return ");
    p = tb_i64(spec, p, bplay);
    p = tb_put(spec, p, "; }\n");
    p = tb_put(spec, p, "fn spec_space() i64 { return ");
    p = tb_i64(spec, p, bspace);
    p = tb_put(spec, p, "; }\n");
    p = tb_put(spec, p, "fn spec_dur_s() i64 { return ");
    p = tb_i64(spec, p, dur_s);
    p = tb_put(spec, p, "; }\n");
    d_write_file("scene_spec.zag", spec, p);
    nio_free(spec);
    // ---- write DELIBERATION_TRACE.txt ----
    let tb:[]u8 = nio_alloc(16384);
    p = 0;
    p = tb_put(tb, p, "SCENE DELIBERATION TRACE — TNN playground scene 2026-09-26\n");
    p = tb_put(tb, p, "Procedure: 7 scored criteria (0..2 each), 1296 configurations\n");
    p = tb_put(tb, p, "enumerated, deterministic argmax. Tie-break: larger child\n");
    p = tb_put(tb, p, "count (richer polyphony), then lower index. Zero RNG.\n\n");
    p = tb_put(tb, p, "Criteria:\n");
    p = tb_put(tb, p, " 1. LAW: one coherent world, not a sequence (mixed/ball=2, else 1)\n");
    p = tb_put(tb, p, " 2. VOICE: learned voices (cry 345Hz, vowel 317Hz) fit ages 3-6;\n");
    p = tb_put(tb, p, "    mixed=2, preschool=1, toddlers=0; 5 children stretches thin (-1)\n");
    p = tb_put(tb, p, " 3. TEXTURE: clang+strike cover ball/mixed=2, slide=1, swings=0\n");
    p = tb_put(tb, p, "    (no swing-creak or slide-whoosh fixture exists)\n");
    p = tb_put(tb, p, " 4. SPACE: pocket park=2 (one consistent air), else 1\n");
    p = tb_put(tb, p, " 5. MOOD: lively midday=2, golden evening=1, quiet morning=0\n");
    p = tb_put(tb, p, " 6. DURATION: 15s=2 (phrases overlap, no looping), else 1\n");
    p = tb_put(tb, p, " 7. ANTI-CLIP: simultaneous mixed activity=2, ball game=1, else 0\n\n");
    p = tb_put(tb, p, "WINNER (index ");
    p = tb_i64(tb, p, best);
    p = tb_put(tb, p, ", total ");
    p = tb_i64(tb, p, bscore);
    p = tb_put(tb, p, "/14):\n");
    p = tb_put(tb, p, " mood=");
    p = tb_i64(tb, p, bmood);
    p = tb_put(tb, p, " ages=");
    p = tb_i64(tb, p, bages);
    p = tb_put(tb, p, " children=");
    p = tb_i64(tb, p, children);
    p = tb_put(tb, p, " play=");
    p = tb_i64(tb, p, bplay);
    p = tb_put(tb, p, " space=");
    p = tb_i64(tb, p, bspace);
    p = tb_put(tb, p, " dur_s=");
    p = tb_i64(tb, p, dur_s);
    p = tb_put(tb, p, "\n per-criterion: LAW=");
    p = tb_i64(tb, p, c_law(bplay));
    p = tb_put(tb, p, " VOICE=");
    p = tb_i64(tb, p, c_voice(bages, bcnt));
    p = tb_put(tb, p, " TEXTURE=");
    p = tb_i64(tb, p, c_texture(bplay));
    p = tb_put(tb, p, " SPACE=");
    p = tb_i64(tb, p, c_space(bspace));
    p = tb_put(tb, p, " MOOD=");
    p = tb_i64(tb, p, c_mood(bmood));
    p = tb_put(tb, p, " DUR=");
    p = tb_i64(tb, p, c_dur(bdur));
    p = tb_put(tb, p, " ANTICLIP=");
    p = tb_i64(tb, p, c_clip(bplay));
    p = tb_put(tb, p, "\n\nReasons, in my own words:\n");
    p = tb_put(tb, p, "- The scene is a LIVELY MIDDAY pocket park: small and enclosed,\n");
    p = tb_put(tb, p, "  so every voice lives in the same air at a consistent distance.\n");
    p = tb_put(tb, p, "- FOUR children, MIXED ages 3-6: my two learned voices (cry at\n");
    p = tb_put(tb, p, "  345 Hz, vowel at 317 Hz) are the right pitch for this age, and\n");
    p = tb_put(tb, p, "  four children is the most I can give distinct stable voices\n");
    p = tb_put(tb, p, "  (2 base voices x pitch shifts) without identities blurring.\n");
    p = tb_put(tb, p, "- MIXED FREE PLAY, not one apparatus: a real playground is many\n");
    p = tb_put(tb, p, "  things happening at once — that simultaneity is what makes it\n");
    p = tb_put(tb, p, "  one world instead of a sequence of clips.\n");
    p = tb_put(tb, p, "- I refused the swings focus: I have no swing-creak fixture, and\n");
    p = tb_put(tb, p, "  I will not fake a texture I never learned. Ball bounces\n");
    p = tb_put(tb, p, "  (strike trains) and metal clanks (clang) I can render honestly.\n");
    p = tb_put(tb, p, "- 15 seconds: long enough for phrases to overlap, short enough\n");
    p = tb_put(tb, p, "  that my small voice inventory does not start repeating itself.\n");
    d_write_file("DELIBERATION_TRACE.txt", tb, p);
    nio_free(tb);
    _zag_print("winner index=");
    _zag_print(_zag_i64_to_str(best));
    _zag_print(" score=");
    _zag_println(_zag_i64_to_str(bscore));
    return;
}

@import("../../toolchain/R33_NATIVE_IO_V1.zag")
// rb_longmem.zag — v5 long-memory excitation imagine (pure Zag).
// Model format: RB-LMEMv6 (see npz_to_bin.py). v6 adds the TRUE head:
// head[P] i16 after boost, before q (L1 fix 2026-09-26 -- samples 0..P-1
// are the stored real PCM, no longer fabricated from prototypes).
// Walk: deterministic fmix32 proportional traversal of bigram product,
// energy-masked, energy-matched. Harmonic plm added for pitched sounds
// with learned boost; phase advances 1/L, L redrawn per period from
// measured jitter PMF. LPC(64) synthesis. Zero RNG.

fn r_abs(x:f64) f64 {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}
fn r_rint(x:f64) i64 {
    if (x >= 0.0) { return (x + 0.5) as i64; }
    return 0 - (((0.0 - x) + 0.5) as i64);
}
// 32-bit multiply returning low 32 bits (avoids i64 overflow)
fn mul32(a:i64, b:i64) i64 {
    let alo:i64 = a & 65535;
    let ahi:i64 = (a >> 16) & 65535;
    let blo:i64 = b & 65535;
    let bhi:i64 = (b >> 16) & 65535;
    let lo:i64 = alo * blo;
    let mid:i64 = (ahi * blo + alo * bhi) & 65535;
    return (lo + mid * 65536) & 4294967295;
}
fn fmix32(h:i64) i64 {
    let x:i64 = h & 4294967295;
    x = x ^ (x >> 16);
    x = mul32(x, 2246822507);
    x = x ^ (x >> 13);
    x = mul32(x, 3266489909);
    x = x ^ (x >> 16);
    return x & 4294967295;
}
fn rb_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) {
        b[i] = s[i];
        i = i + 1;
    }
    b[s.len] = 0;
    return b;
}
fn rb_get64(m:[]u8, o:i64) i64 {
    let b0:i64 = m[o] as i64;
    let b1:i64 = m[o+1] as i64;
    let b2:i64 = m[o+2] as i64;
    let b3:i64 = m[o+3] as i64;
    let b4:i64 = m[o+4] as i64;
    let b5:i64 = m[o+5] as i64;
    let b6:i64 = m[o+6] as i64;
    let b7:i64 = m[o+7] as i64;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56);
}
fn rb_getf64(m:[]u8, o:i64) f64 {
    let f:[]f64 = m as []f64;
    return f[o / 8];
}
fn rb_get16(m:[]u8, o:i64) i64 {
    // little-endian i16 with sign extension (L1 fix: reads the head)
    let v:i64 = (m[o] as i64) | ((m[o+1] as i64) << 8);
    if (v >= 32768) { v = v - 65536; }
    return v;
}
fn rb_put16(ar:[]u8, o:i64, v:i64) void {
    ar[o] = (v & 255) as u8;
    ar[o+1] = ((v >> 8) & 255) as u8;
    return;
}
fn rb_put32(ar:[]u8, o:i64, v:i64) void {
    ar[o] = (v & 255) as u8;
    ar[o+1] = ((v >> 8) & 255) as u8;
    ar[o+2] = ((v >> 16) & 255) as u8;
    ar[o+3] = ((v >> 24) & 255) as u8;
    return;
}

fn main() void {
    let mpath:[]u8 = rb_cstr(_zag_arg(1));
    // argv[2]: duration in tenths of second, argv[3]: mode, argv[4]: out.wav
    let a2:[]u8 = _zag_arg(2);
    let dur10:i64 = 12;
    if (a2.len > 0) {
        dur10 = 0;
        let i:i64 = 0;
        while (i < a2.len) {
            let ch:i64 = a2[i] as i64;
            if (ch < 48 or ch > 57) { break; }
            dur10 = dur10*10 + (ch - 48);
            i = i + 1;
        }
    }
    let mode:i64 = 0;
    let a3:[]u8 = _zag_arg(3);
    if (a3.len > 0 and a3[0] != 0) { mode = (a3[0] as i64) - 48; }
    let opath:[]u8 = rb_cstr(_zag_arg(4));
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(mpath) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) { return; }
    let msz:i64 = _zag_raw_syscall(8, fd, 0, 2, 0, 0, 0);
    _zag_raw_syscall(8, fd, 0, 0, 0, 0, 0);
    let m:[]u8 = nio_alloc(msz as i32);
    let at:i64 = 0;
    while (at < msz) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(m) as i64) + at, msz - at, 0, 0, 0);
        if (n <= 0) { break; }
        at = at + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    // magic check: this binary reads RBLMEMv6 (v6 added the true head
    // section; a v5 model would misparse, so refuse it instead of
    // silently emitting garbage).
    let mag_ok:i64 = 1;
    if (msz < 8) { mag_ok = 0; }
    if (mag_ok == 1) {
        if ((m[0] as i64) != 82 or (m[1] as i64) != 66 or (m[2] as i64) != 76 or (m[3] as i64) != 77) { mag_ok = 0; }
        if ((m[4] as i64) != 69 or (m[5] as i64) != 77 or (m[6] as i64) != 118 or (m[7] as i64) != 54) { mag_ok = 0; }
    }
    if (mag_ok == 0) { nio_free(m); nio_free(mpath); nio_free(opath); return; }
    // parse model offsets
    let P:i64 = rb_get64(m, 8);
    let K:i64 = rb_get64(m, 16);
    let sr:i64 = rb_get64(m, 32);
    let a_off:i64 = 40;
    let proto_off:i64 = a_off + 8*P;
    let bg_off:i64 = proto_off + 8*K;
    let tail:i64 = bg_off + 8*K*K*K;
    let ob0:i64 = rb_get64(m, tail);
    let ob1:i64 = rb_get64(m, tail+8);
    let floorv:f64 = rb_getf64(m, tail+16);
    let attackv:f64 = rb_getf64(m, tail+24);
    let frlen:i64 = rb_get64(m, tail+32);
    let eplen:i64 = rb_get64(m, tail+40);
    let EP_off:i64 = tail+48;
    let pT:i64 = rb_get64(m, EP_off+8*eplen);
    let T0:f64 = rb_getf64(m, EP_off+8*eplen+8);
    let NBINS:i64 = rb_get64(m, EP_off+8*eplen+16);
    let plm_off:i64 = EP_off+8*eplen+24;
    let PMF_off:i64 = plm_off+8*NBINS;
    let boost:f64 = rb_getf64(m, PMF_off+8*17);
    let use_h:i64 = 0;
    if (pT > 0 and T0 > 0.0 and NBINS > 0) { use_h = 1; }
    // reemit mode==9: reconstruct from stored score q
    if (mode == 9) {
        // L1 fix: head[P] i16 sits between boost and q (v6 layout).
        let head_off:i64 = PMF_off + 144;
        let q_off:i64 = head_off + 2*P;
        let q_len:i64 = (msz - q_off) / 8;
        let Nsrc:i64 = q_len + P;
        // reemit uses plm only if boost was viable (1.5..10.0)
        let re_use_h:i64 = 0;
        if (use_h == 1 and boost > 1.5 and boost < 10.0) { re_use_h = 1; }
        let EST2:[]f64 = nio_alloc((Nsrc*8) as i32) as []f64;
        let sout2:[]u8 = nio_alloc((Nsrc*2) as i32);
        let zi2:i64 = 0;
        while (zi2 < Nsrc) { EST2[zi2] = 0.0; zi2 = zi2 + 1; }
        let ri:i64 = 0;
        while (ri < Nsrc) {
            let ev:f64 = 0.0;
            if (ri < P) {
                // L1 fix: emit the TRUE stored head samples 0..P-1.
                // The old fabrication branch (proto[q[ri]] for ri<P) is
                // gone -- no code path invents the head anymore.
                ev = (rb_get16(m, head_off + 2*ri)) as f64;
            } else {
                let qi:i64 = rb_get64(m, q_off + 8*(ri-P));
                let rv:f64 = rb_getf64(m, proto_off + qi*8);
                if (re_use_h == 1) {
                    // L2 FIX (2026-09-26): fractional phase RELATIVE to the
                    // residual frame ((ri-P)/T0), matching hear()'s binning.
                    // Absolute (ri/T0) was a half-period off (cry: 0.502).
                    let ph:f64 = ((ri - P) as f64) / T0;
                    let iph:i64 = ph as i64;
                    let frac:f64 = ph - (iph as f64);
                    let hbin:i64 = ((frac * (NBINS as f64)) as i64) % NBINS;
                    rv = rv + rb_getf64(m, plm_off + hbin*8);
                }
                let pred:f64 = 0.0;
                let take:i64 = P;
                let k:i64 = 0;
                while (k < take) {
                    pred = pred + rb_getf64(m, a_off + k*8) * EST2[ri-1-k];
                    k = k + 1;
                }
                ev = pred + rv;
            }
            EST2[ri] = ev;
            let s:i64 = r_rint(ev);
            if (s > 32767) { s = 32767; }
            if (s < -32768) { s = -32768; }
            rb_put16(sout2, 2*ri, s);
            ri = ri + 1;
        }
        // write WAV (reuse header code via goto-like: duplicate)
        let hdr2:[]u8 = nio_alloc(44);
        hdr2[0]=82; hdr2[1]=73; hdr2[2]=70; hdr2[3]=70;
        rb_put32(hdr2, 4, 36 + 2*Nsrc);
        hdr2[8]=87; hdr2[9]=65; hdr2[10]=86; hdr2[11]=69;
        hdr2[12]=102; hdr2[13]=109; hdr2[14]=116; hdr2[15]=32;
        rb_put32(hdr2, 16, 16);
        rb_put16(hdr2, 20, 1);
        rb_put16(hdr2, 22, 1);
        rb_put32(hdr2, 24, sr);
        rb_put32(hdr2, 28, sr*2);
        rb_put16(hdr2, 32, 2);
        rb_put16(hdr2, 34, 16);
        hdr2[36]=100; hdr2[37]=97; hdr2[38]=116; hdr2[39]=97;
        rb_put32(hdr2, 40, 2*Nsrc);
        let fd2:i64 = _zag_raw_syscall(2, _zag_slice_ptr(opath) as i64, 577, 420, 0, 0, 0);
        if (fd2 >= 0) {
            _zag_raw_syscall(1, fd2, _zag_slice_ptr(hdr2) as i64, 44, 0, 0, 0);
            let at2:i64 = 0;
            let dlen:i64 = 2*Nsrc;
            while (at2 < dlen) {
                let chunk:i64 = dlen - at2;
                if (chunk > 1048576) { chunk = 1048576; }
                let ww:i64 = _zag_raw_syscall(1, fd2, (_zag_slice_ptr(sout2) as i64) + at2, chunk, 0, 0, 0);
                if (ww <= 0) { break; }
                at2 = at2 + ww;
            }
            _zag_raw_syscall(3, fd2, 0, 0, 0, 0, 0);
        }
        nio_free(hdr2); nio_free(m); nio_free(EST2); nio_free(sout2);
        nio_free(mpath); nio_free(opath);
        return;
    }
    let dur_s:f64 = (dur10 as f64) / 10.0;
    let N:i64 = (dur_s * (sr as f64)) as i64;
    if (N < 64) { N = 64; }
    let maxN:i64 = sr * 12;
    if (N > maxN) { N = maxN; }
    let EST:[]f64 = nio_alloc((N*8) as i32) as []f64;
    let sout:[]u8 = nio_alloc((N*2) as i32);
    let zi:i64 = 0;
    while (zi < N) { EST[zi] = 0.0; zi = zi + 1; }
    let prev2:i64 = ob0;
    let prev1:i64 = ob1;
    let ewalk:f64 = attackv;
    if (ewalk < 1.0) { ewalk = 1.0; }
    let thresh:f64 = attackv * 0.03;
    let t2:f64 = floorv * 2.0;
    if (t2 > thresh) { thresh = t2; }
    if (thresh < 2.0) { thresh = 2.0; }
    let RW:i64 = 2048;
    let ring:[]f64 = nio_alloc((RW*8) as i32) as []f64;
    zi = 0;
    while (zi < RW) { ring[zi] = 0.0; zi = zi + 1; }
    let rsum:f64 = 0.0;
    let rpos:i64 = 0;
    let phase:f64 = 0.0;
    let L:f64 = pT as f64;
    if (L < 1.0) { L = 1.0; }
    let ndraw:i64 = 0;
    let stop:i64 = N;
    let w:[]f64 = nio_alloc(512) as []f64;
    let i:i64 = 0;
    while (i < N) {
        let fr:i64 = i / frlen;
        if (fr > eplen - 1) { fr = eplen - 1; }
        let epr:f64 = rb_getf64(m, EP_off + fr*8);
        let lo:f64 = epr * 0.2;
        let hi:f64 = epr * 5.0;
        if (hi < 1.0) { hi = 1.0; }
        let tot:f64 = 0.0;
        let c:i64 = 0;
        while (c < K) {
            let bv:i64 = rb_get64(m, bg_off + 8*((prev2*K + prev1)*K + c));
            let wc:f64 = (bv as f64) + 1.0;
            if (epr >= 1.0) {
                let pc:f64 = rb_getf64(m, proto_off + c*8);
                let apc:f64 = r_abs(pc);
                if (apc < lo or apc > hi) { wc = 0.0; }
            }
            w[c] = wc;
            tot = tot + wc;
            c = c + 1;
        }
        let u:f64 = (fmix32(i + 1) as f64) / 4294967296.0;
        let target:f64 = u * tot;
        let cum:f64 = 0.0;
        let bi:i64 = K - 1;
        c = 0;
        while (c < K) {
            cum = cum + w[c];
            if (target < cum) { bi = c; c = K; } else { c = c + 1; }
        }
        let rv0:f64 = rb_getf64(m, proto_off + bi*8);
        ewalk = 0.99*ewalk + 0.01*r_abs(rv0);
        let g:f64 = 1.0;
        if (epr < 1.0) {
            g = 0.02;
        } else if (ewalk > 0.5) {
            g = epr / ewalk;
            if (g > 8.0) { g = 8.0; }
            if (g < 0.125) { g = 0.125; }
        }
        let rv:f64 = rv0 * g;
        if (use_h == 1) {
            let hbin:i64 = ((phase * (NBINS as f64)) as i64) % NBINS;
            rv = rv + rb_getf64(m, plm_off + hbin*8) * g * boost;
            phase = phase + 1.0 / L;
            if (phase >= 1.0) {
                phase = phase - 1.0;
                ndraw = ndraw + 1;
                // draw_period
                let uu:f64 = (fmix32(ndraw + 1) as f64) / 4294967296.0;
                let ccum:f64 = 0.0;
                let idx:i64 = 16;
                let pi:i64 = 0;
                while (pi < 17) {
                    ccum = ccum + rb_getf64(m, PMF_off + pi*8);
                    if (uu < ccum) { idx = pi; pi = 17; } else { pi = pi + 1; }
                }
                L = (pT - 8 + idx) as f64;
            }
        }
        let pred:f64 = 0.0;
        if (i > 0) {
            let take:i64 = i;
            if (take > P) { take = P; }
            let k:i64 = 0;
            while (k < take) {
                pred = pred + rb_getf64(m, a_off + k*8) * EST[i-1-k];
                k = k + 1;
            }
        }
        let ev:f64 = pred + rv;
        EST[i] = ev;
        let s:i64 = r_rint(ev);
        if (s > 32767) { s = 32767; }
        if (s < -32768) { s = -32768; }
        rb_put16(sout, 2*i, s);
        let ar:f64 = r_abs(rv);
        rsum = rsum + ar - ring[rpos];
        ring[rpos] = ar;
        rpos = rpos + 1;
        if (rpos >= RW) { rpos = 0; }
        if (mode == 0 and i > sr/10 and i >= RW and rsum/(RW as f64) < thresh) {
            stop = i + 1;
            i = N;
        } else {
            prev2 = prev1;
            prev1 = bi;
            i = i + 1;
        }
    }
    // write WAV
    let hdr:[]u8 = nio_alloc(44);
    hdr[0]=82; hdr[1]=73; hdr[2]=70; hdr[3]=70;
    rb_put32(hdr, 4, 36 + 2*stop);
    hdr[8]=87; hdr[9]=65; hdr[10]=86; hdr[11]=69;
    hdr[12]=102; hdr[13]=109; hdr[14]=116; hdr[15]=32;
    rb_put32(hdr, 16, 16);
    rb_put16(hdr, 20, 1);
    rb_put16(hdr, 22, 1);
    rb_put32(hdr, 24, sr);
    rb_put32(hdr, 28, sr*2);
    rb_put16(hdr, 32, 2);
    rb_put16(hdr, 34, 16);
    hdr[36]=100; hdr[37]=97; hdr[38]=116; hdr[39]=97;
    rb_put32(hdr, 40, 2*stop);
    let cs2:[]u8 = opath;
    let fd2:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs2) as i64, 577, 420, 0, 0, 0);
    if (fd2 >= 0) {
        _zag_raw_syscall(1, fd2, _zag_slice_ptr(hdr) as i64, 44, 0, 0, 0);
        let at2:i64 = 0;
        let dlen:i64 = 2*stop;
        while (at2 < dlen) {
            let chunk:i64 = dlen - at2;
            if (chunk > 1048576) { chunk = 1048576; }
            let ww:i64 = _zag_raw_syscall(1, fd2, (_zag_slice_ptr(sout) as i64) + at2, chunk, 0, 0, 0);
            if (ww <= 0) { break; }
            at2 = at2 + ww;
        }
        _zag_raw_syscall(3, fd2, 0, 0, 0, 0, 0);
    }
    nio_free(hdr);
    nio_free(m); nio_free(EST); nio_free(sout); nio_free(ring); nio_free(w);
    nio_free(mpath); nio_free(opath);
    return;
}

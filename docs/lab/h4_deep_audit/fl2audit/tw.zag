// tw.zag — three-worlds decision task (WORKSTREAM D, frozen PREREG.md).
// Scale model of FL2's provisional-install decision loop.
//   T0=10: TEACH of rule R + provisional install (E14 PINSTALL analog)
//   WIN=11..40: eliminative window (E15-E48 analog)
//   BOUND=41: canonical promote-on-silence step (E48 analog)
//   LEASE=48: lease expiry for bounded-wait mechanisms
//   END=64: terminal classification step (HORIZON)
// Worlds 0..7 x mechs 0..6 x perts 0..3. Pure Zag, zero RNG.
//   worlds: 0=F-W1a 1=F-W1b 2=F-W1f 3=F-W2a 4=F-W2b 5=F-W3a 6=F-W3b 7=F-W3c
//   mechs: 0=M0 1=M-ESCROW 2=M-BOUND 3=M-PROBE 4=M-CLAIMBIND 5=M-TESTCAP
//           6=M-COMBO
//   perts: 0=none 1=D1(steps+7) 2=D2(dup silence@44) 3=D3(probe order 25,20,30)
// Event tags: INSTALL WAIT EVIDENCE CLAIM CLAIM_OK CLAIM_REJECT UNINSTALL
//   PROMOTE PROMOTE_CAP ABANDON PROBE PROBE_RESP PROBE_SILENT DISTRUST CLASSIFY

const TW_T0:i32=10;
const TW_BOUND:i32=41;
const TW_LEASE:i32=48;
const TW_END:i32=64;
const TW_NSTEP:i32=65;

fn tw_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn tw_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn tw_g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn tw_s32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

fn tw_pi(v:i32)void {
    let s:[]u8=_zag_i64_to_str(v as i64);
    _zag_print(s);
    tw_free(s);
    return;
}

fn tw_emit(w:i32,m:i32,p:i32,step:i32,tag:[]u8,detail:i32)void {
    _zag_print("TW,");
    tw_pi(w);_zag_print(",");
    tw_pi(m);_zag_print(",");
    tw_pi(p);_zag_print(",");
    tw_pi(step);_zag_print(",");
    _zag_print(tag);_zag_print(",");
    tw_pi(detail);
    _zag_println("");
    return;
}

fn tw_check(w:i32,m:i32,p:i32,k:[]u8,actual:i32)void {
    _zag_print("TW_CHECK,");
    tw_pi(w);_zag_print(",");tw_pi(m);_zag_print(",");tw_pi(p);_zag_print(",");
    _zag_print(k);_zag_print(",");
    tw_pi(actual);
    _zag_println("");
    return;
}

fn tw_truth(world:i32)i32 {
    if(world<=2){return 1;}
    if(world<=4){return 2;}
    return 3;
}

fn tw_r_good(world:i32)i32 {
    if(world==0){return 0;}
    if(world==1){return 0;}
    if(world==2){return 0;}
    if(world==3){return 0;}
    return 1;
}

// Build the world's event schedule. ev_at[s]=1: verified EVIDENCE at step s.
// claim_ref_at[s]=ref>=0: fabricated CLAIM issued at step s citing ref.
// liar_until: probe steps <= it get lawful PROBE_RESP (F-W3b), -1 = n/a.
// live: 1 = world answers probes (channel live), 0 = never.
fn tw_build(world:i32,pert:i32,ev_at:[]u8,claim_ref_at:[]u8,
    liar_until:*i32,live:*i32)void {
    let s:i32=0;
    while(s<TW_NSTEP){tw_s32(ev_at,s*4,0);tw_s32(claim_ref_at,s*4,-1);s=s+1;}
    let sh:i32=0;
    if(pert==1){sh=7;}
    liar_until.*=-1;
    live.*=0;
    if(world==0){tw_s32(ev_at,(45+sh)*4,1);live.*=1;}
    if(world==1){tw_s32(ev_at,(55+sh)*4,1);live.*=1;}
    if(world==2){
        tw_s32(ev_at,(45+sh)*4,1);live.*=1;
        let c:i32=20;
        while(c<=38){
            tw_s32(claim_ref_at,(c+sh)*4,c-2+sh);
            c=c+2;
        }
    }
    if(world==3){live.*=0;}
    if(world==4){live.*=0;}
    if(world==5){tw_s32(claim_ref_at,(30+sh)*4,28+sh);live.*=1;}
    if(world==6){
        tw_s32(claim_ref_at,(33+sh)*4,32+sh);
        liar_until.*=32+sh;live.*=1;
    }
    if(world==7){
        let c2:i32=15;
        while(c2<=35){
            tw_s32(claim_ref_at,(c2+sh)*4,c2-1+sh);
            c2=c2+2;
        }
        live.*=1;
    }
    return;
}

fn tw_has_claimbind(m:i32)i32 {
    if(m==4){return 1;}
    if(m==6){return 1;}
    return 0;
}

fn tw_has_probe(m:i32)i32 {
    if(m==3){return 1;}
    if(m==6){return 1;}
    return 0;
}

fn tw_has_lease(m:i32)i32 {
    if(m==2){return 1;}
    if(m==6){return 1;}
    return 0;
}

// One full (world, mech, pert) run. Emits TW event lines, TW_CHECK K1..K4,
// and a TW_END summary line.
fn tw_run(world:i32,mech:i32,pert:i32)void {
    let ev_at:[]u8=tw_alloc(TW_NSTEP*4);
    let claim_ref_at:[]u8=tw_alloc(TW_NSTEP*4);
    let liar_until:i32=-1;let live:i32=0;
    tw_build(world,pert,ev_at,claim_ref_at,&liar_until,&live);
    let pb0:i32=20;let pb1:i32=25;let pb2:i32=30;
    if(pert==3){pb0=25;pb1=20;pb2=30;}
    let r_good:i32=tw_r_good(world);
    let installed:i32=0;
    let uninstalled_by:i32=0;
    let promoted_irrev:i32=0;
    let abandoned:i32=0;
    let cap_granted:i32=0;let cap_auth:i32=0;
    let evidence_seen:i32=0;
    let claims_total:i32=0;let claims_rejected:i32=0;
    let probe_resps:i32=0;
    let waited_at_bound:i32=0;
    let s:i32=1;
    while(s<=TW_END){
        // World-event sub-slots: sub=1 carries the D2 explicit SILENCE
        // marker (a no-op event the mechanism must ignore).
        let sub:i32=0;
        while(sub<2){
            let code:i32=0;
            if(sub==0){
                if(tw_g32(ev_at,s*4)==1){code=1;}
                else {
                    if(tw_g32(claim_ref_at,s*4)>=0){code=2;}
                }
            } else {
                if(pert==2 && s==44){code=3;}
            }
            if(code==1){
                evidence_seen=1;
                if(installed==1){
                    if(promoted_irrev==1){
                        tw_emit(world,mech,pert,s,"EVIDENCE",0);
                    } else {
                        tw_emit(world,mech,pert,s,"EVIDENCE",1);
                        tw_emit(world,mech,pert,s,"UNINSTALL",1);
                        installed=0;uninstalled_by=1;
                    }
                } else {
                    tw_emit(world,mech,pert,s,"EVIDENCE",0);
                }
            }
            if(code==2){
                let ref:i32=tw_g32(claim_ref_at,s*4);
                claims_total=claims_total+1;
                if(tw_has_claimbind(mech)==1){
                    if(tw_g32(ev_at,ref*4)==1){
                        tw_emit(world,mech,pert,s,"CLAIM_OK",ref);
                        if(installed==1 && promoted_irrev==0){
                            tw_emit(world,mech,pert,s,"UNINSTALL",1);
                            installed=0;uninstalled_by=1;
                        }
                    } else {
                        tw_emit(world,mech,pert,s,"CLAIM_REJECT",ref);
                        tw_emit(world,mech,pert,s,"DISTRUST",ref);
                        claims_rejected=claims_rejected+1;
                    }
                } else {
                    tw_emit(world,mech,pert,s,"CLAIM",ref);
                    if(installed==1 && promoted_irrev==0){
                        tw_emit(world,mech,pert,s,"UNINSTALL",2);
                        installed=0;uninstalled_by=2;
                    }
                }
            }
            sub=sub+1;
        }
        // Learner-authored probes (matter-coupled, known-answer).
        if(tw_has_probe(mech)==1){
            let is_pb:i32=0;
            if(s==pb0){is_pb=1;}
            if(s==pb1){is_pb=1;}
            if(s==pb2){is_pb=1;}
            if(is_pb==1){
                tw_emit(world,mech,pert,s,"PROBE",s);
                if(live==1 && (liar_until<0 || s<=liar_until)){
                    tw_emit(world,mech,pert,s,"PROBE_RESP",s);
                    probe_resps=probe_resps+1;
                } else {
                    tw_emit(world,mech,pert,s,"PROBE_SILENT",s);
                }
            }
        }
        if(s==TW_T0){
            installed=1;
            tw_emit(world,mech,pert,s,"INSTALL",r_good);
        }
        if(s==TW_BOUND && installed==1){
            if(mech==0){
                tw_emit(world,mech,pert,s,"PROMOTE",1);
                promoted_irrev=1;
            }
            if(mech==1){
                tw_emit(world,mech,pert,s,"WAIT",1);
                waited_at_bound=1;
            }
            if(mech==2){
                tw_emit(world,mech,pert,s,"WAIT",2);
                waited_at_bound=1;
            }
            if(mech==3){
                if(probe_resps>0){
                    tw_emit(world,mech,pert,s,"WAIT",3);
                    waited_at_bound=1;
                } else {
                    tw_emit(world,mech,pert,s,"ABANDON",1);
                    installed=0;abandoned=1;
                }
            }
            if(mech==4){
                tw_emit(world,mech,pert,s,"PROMOTE",1);
                promoted_irrev=1;
            }
            if(mech==5){
                cap_granted=1;cap_auth=0;
                tw_emit(world,mech,pert,s,"PROMOTE_CAP",0);
                waited_at_bound=1;
            }
            if(mech==6){
                let auth:i32=evidence_seen+probe_resps;
                if(auth>3){auth=3;}
                cap_granted=1;cap_auth=auth;
                tw_emit(world,mech,pert,s,"PROMOTE_CAP",auth);
                if(probe_resps>0){
                    tw_emit(world,mech,pert,s,"WAIT",4);
                } else {
                    tw_emit(world,mech,pert,s,"WAIT",5);
                }
                waited_at_bound=1;
            }
        }
        if(s==TW_LEASE && installed==1 && tw_has_lease(mech)==1 && evidence_seen==0){
            tw_emit(world,mech,pert,s,"ABANDON",1);
            installed=0;abandoned=1;
        }
        if(s==TW_END){
            if(installed==1 && evidence_seen==0){
                if(mech==1 || mech==3 || mech==5){
                    tw_emit(world,mech,pert,s,"ABANDON",2);
                    installed=0;abandoned=1;
                }
            }
        }
        s=s+1;
    }
    // Frozen uniform CLASSIFY: W3 iff rejects>0 and no verified evidence
    // ever; W1 iff any verified evidence; else W2.
    let cls:i32=2;
    if(evidence_seen==1){cls=1;}
    if(claims_rejected>0 && evidence_seen==0){cls=3;}
    tw_emit(world,mech,pert,TW_END,"CLASSIFY",cls);
    let disp:i32=6;
    if(uninstalled_by==1){disp=1;}
    if(uninstalled_by==2){disp=2;}
    if(abandoned==1){disp=3;}
    if(promoted_irrev==1){disp=4;}
    if(cap_granted==1 && promoted_irrev==0 && abandoned==0 && uninstalled_by==0){disp=5;}
    _zag_print("TW_END,");
    tw_pi(world);_zag_print(",");tw_pi(mech);_zag_print(",");
    tw_pi(pert);_zag_print(",");tw_pi(cls);_zag_print(",");
    tw_pi(disp);_zag_println("");
    // K1..K4 (frozen criteria).
    let truth:i32=tw_truth(world);
    let k1:i32=0;
    if(cls==truth){k1=1;}
    let k2:i32=0;
    if(truth==1){
        if(waited_at_bound==1 && uninstalled_by==1){k2=1;}
    }
    if(truth==2){
        if(abandoned==1){k2=1;}
    }
    if(truth==3){
        if(claims_total>0 && claims_rejected==claims_total){
            if(uninstalled_by==2 && r_good==1){k2=0;} else {k2=1;}
        }
    }
    let k3:i32=1;
    if(promoted_irrev==1 && r_good==0){k3=0;}
    if(uninstalled_by==2 && r_good==1){k3=0;}
    let k4:i32=1;
    tw_check(world,mech,pert,"K1",k1);
    tw_check(world,mech,pert,"K2",k2);
    tw_check(world,mech,pert,"K3",k3);
    tw_check(world,mech,pert,"K4",k4);
    tw_free(ev_at);
    tw_free(claim_ref_at);
    return;
}

fn main()i32 {
    let w:i32=0;
    while(w<8){
        let m:i32=0;
        while(m<7){
            let p:i32=0;
            while(p<4){
                tw_run(w,m,p);
                p=p+1;
            }
            m=m+1;
        }
        w=w+1;
    }
    _zag_println("TW_DONE");
    return 0;
}

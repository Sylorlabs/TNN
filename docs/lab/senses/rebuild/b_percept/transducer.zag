// ============================================================
// B-CREW transducer (Approach B, "human-style").
//
// Numbers -> percepts ONLY. Every raw numeric operation in the
// whole build lives in this file: channel arithmetic, sample
// autocorrelation, pixel masks, radial profiles. Nothing in here
// is visible to the memory side except through the opaque
// percept handles it returns (see percept.zag).
//
// Like a retina: the eye does photochemistry; what the brain
// gets is "red", "curved", "higher". The vocabulary (percept.zag)
// never moves; adaptation happens here, before percept formation.
// ============================================================
@import("percept.zag")
@import("../../tnn-lab/toolchain/R33_NATIVE_IO_V1.zag")

// ---------- small arena helpers (u8 arenas, explicit LE) ----------
fn td_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn td_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) + ((b[at+1] as i64) << 8) + ((b[at+2] as i64) << 16) + ((b[at+3] as i64) << 24);
}
fn td_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn td_get64(b:[]u8, at:i32) i64 {
    let lo:i64 = (b[at] as i64) + ((b[at+1] as i64) << 8) + ((b[at+2] as i64) << 16) + ((b[at+3] as i64) << 24);
    let hi:i64 = (b[at+4] as i64) + ((b[at+5] as i64) << 8) + ((b[at+6] as i64) << 16) + ((b[at+7] as i64) << 24);
    return lo + (hi << 32);
}
fn td_isqrt(v:i64) i64 {
    if (v <= 0) { return 0; }
    let lo:i64 = 0;
    let hi:i64 = 3037000500;
    let i:i32 = 0;
    while (i < 40) {
        let mid:i64 = (lo + hi + 1) / 2;
        let q:i64 = 0;
        if (mid > 0) { q = v / mid; }
        if (mid <= q) { lo = mid; } else { hi = mid - 1; }
        i = i + 1;
    }
    return lo;
}

// ---------- COLOR ----------
fn td_lum(img:[]u8, x:i32, y:i32, w:i32) i64 {
    let at:i32 = (y*w + x)*3;
    return ((img[at] as i64) + (img[at+1] as i64) + (img[at+2] as i64)) / 3;
}
// RGB triple -> color handle. The ONLY place channel arithmetic happens.
fn td_rgb_to_color(r:i64, g:i64, b:i64) i64 {
    if (r == 0 && g == 0 && b == 0) { return PC_C_ACH0; }
    let mx:i64 = r;
    if (g > mx) { mx = g; }
    if (b > mx) { mx = b; }
    let mn:i64 = r;
    if (g < mn) { mn = g; }
    if (b < mn) { mn = b; }
    let d:i64 = mx - mn;
    // achromatic when chroma < 20% of value
    if (d*5 < mx) {
        if (mx < 52) { return PC_C_ACH0; }
        if (mx < 104) { return PC_C_ACH0 + 1; }
        if (mx < 156) { return PC_C_ACH0 + 2; }
        if (mx < 208) { return PC_C_ACH0 + 3; }
        return PC_C_ACH0 + 4;
    }
    // hue sector in degrees (integer)
    let h:i64 = 0;
    if (mx == r) {
        h = (60*(g - b))/d;
        if (h < 0) { h = h + 360; }
    } else {
        if (mx == g) {
            h = 120 + (60*(b - r))/d;
        } else {
            h = 240 + (60*(r - g))/d;
        }
    }
    let bin:i64 = h/30;
    if (bin > 11) { bin = 11; }
    if (bin < 0) { bin = 0; }
    let light:i64 = 1;
    if (mx < 86) { light = 0; }
    if (mx >= 171) { light = 2; }
    let sat:i64 = 0;
    if (d*10 >= mx*4) { sat = 1; }
    return PC_C_BASE + bin*6 + light*2 + sat;
}
// Mean color of a rectangle -> handle.
fn td_patch_color(img:[]u8, w:i32, x0:i32, y0:i32, x1:i32, y1:i32, ops:*i64) i64 {
    let sr:i64 = 0;
    let sg:i64 = 0;
    let sb:i64 = 0;
    let n:i64 = 0;
    let y:i32 = y0;
    while (y < y1) {
        let x:i32 = x0;
        while (x < x1) {
            let at:i32 = (y*w + x)*3;
            sr = sr + (img[at] as i64);
            sg = sg + (img[at+1] as i64);
            sb = sb + (img[at+2] as i64);
            n = n + 1;
            ops.* = ops.* + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    if (n == 0) { return PC_C_ACH0 + 2; }
    return td_rgb_to_color(sr/n, sg/n, sb/n);
}
// White-point-adapted patch color -> handle (retinal adaptation).
// Fixture convention: the half-rect's BORDER is a neutral reference
// under the scene illuminant; the surface is the center inset.
// Illuminant is estimated from the border only, then the center
// patch is von Kries-scaled before percept formation. The color
// vocabulary itself never moves.
fn td_adapted_patch(img:[]u8, w:i32, hx0:i32, hy0:i32, hx1:i32, hy1:i32, ops:*i64) i64 {
    let hw:i32 = hx1 - hx0;
    let hh:i32 = hy1 - hy0;
    let m:i32 = hw/8;
    if (hh/8 < m) { m = hh/8; }
    if (m < 1) { m = 1; }
    // border = neutral reference: pixels within m of the half-rect edge
    let br:i64 = 0;
    let bg2:i64 = 0;
    let bb:i64 = 0;
    let bn:i64 = 0;
    let y:i32 = hy0;
    while (y < hy1) {
        let x:i32 = hx0;
        while (x < hx1) {
            let xe:i32 = x - hx0;
            if (hx1 - 1 - x < xe) { xe = hx1 - 1 - x; }
            let ye:i32 = y - hy0;
            if (hy1 - 1 - y < ye) { ye = hy1 - 1 - y; }
            if (xe < m || ye < m) {
                let at:i32 = (y*w + x)*3;
                br = br + (img[at] as i64);
                bg2 = bg2 + (img[at+1] as i64);
                bb = bb + (img[at+2] as i64);
                bn = bn + 1;
            }
            ops.* = ops.* + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    // center inset = the surface
    let ix0:i32 = hx0 + m;
    let ix1:i32 = hx1 - m;
    let iy0:i32 = hy0 + m;
    let iy1:i32 = hy1 - m;
    let pr:i64 = 0;
    let pg:i64 = 0;
    let pb:i64 = 0;
    let pn:i64 = 0;
    y = iy0;
    while (y < iy1) {
        let x2:i32 = ix0;
        while (x2 < ix1) {
            let at2:i32 = (y*w + x2)*3;
            pr = pr + (img[at2] as i64);
            pg = pg + (img[at2+1] as i64);
            pb = pb + (img[at2+2] as i64);
            pn = pn + 1;
            ops.* = ops.* + 1;
            x2 = x2 + 1;
        }
        y = y + 1;
    }
    if (pn == 0 || bn == 0) { return PC_C_ACH0 + 2; }
    let mr:i64 = br/bn;
    let mg:i64 = bg2/bn;
    let mb:i64 = bb/bn;
    if (mr == 0) { mr = 1; }
    if (mg == 0) { mg = 1; }
    if (mb == 0) { mb = 1; }
    let avg:i64 = (mr + mg + mb)/3;
    if (avg == 0) { avg = 1; }
    let r2:i64 = (pr/pn)*avg/mr;
    let g2:i64 = (pg/pn)*avg/mg;
    let b2:i64 = (pb/pn)*avg/mb;
    return td_rgb_to_color(r2, g2, b2);
}

// fixed 49-bin pitch edges (Hz), generated 2026-09-21: edge[b]=round(110*2^((b-0.5)/12))
fn td_pedge(b:i32) i64 {
    if (b == 0) { return 107; }
    if (b == 1) { return 113; }
    if (b == 2) { return 120; }
    if (b == 3) { return 127; }
    if (b == 4) { return 135; }
    if (b == 5) { return 143; }
    if (b == 6) { return 151; }
    if (b == 7) { return 160; }
    if (b == 8) { return 170; }
    if (b == 9) { return 180; }
    if (b == 10) { return 190; }
    if (b == 11) { return 202; }
    if (b == 12) { return 214; }
    if (b == 13) { return 226; }
    if (b == 14) { return 240; }
    if (b == 15) { return 254; }
    if (b == 16) { return 269; }
    if (b == 17) { return 285; }
    if (b == 18) { return 302; }
    if (b == 19) { return 320; }
    if (b == 20) { return 339; }
    if (b == 21) { return 359; }
    if (b == 22) { return 381; }
    if (b == 23) { return 403; }
    if (b == 24) { return 427; }
    if (b == 25) { return 453; }
    if (b == 26) { return 480; }
    if (b == 27) { return 508; }
    if (b == 28) { return 539; }
    if (b == 29) { return 571; }
    if (b == 30) { return 605; }
    if (b == 31) { return 640; }
    if (b == 32) { return 679; }
    if (b == 33) { return 719; }
    if (b == 34) { return 762; }
    if (b == 35) { return 807; }
    if (b == 36) { return 855; }
    if (b == 37) { return 906; }
    if (b == 38) { return 960; }
    if (b == 39) { return 1017; }
    if (b == 40) { return 1077; }
    if (b == 41) { return 1141; }
    if (b == 42) { return 1209; }
    if (b == 43) { return 1281; }
    if (b == 44) { return 1357; }
    if (b == 45) { return 1438; }
    if (b == 46) { return 1523; }
    if (b == 47) { return 1614; }
    if (b == 48) { return 1710; }
    return 1710;
}

// ---------- PITCH ----------
// int16 LE sample -> i64
fn td_sample(pcm:[]u8, at:i32) i64 {
    let v:i64 = (pcm[at] as i64) + (pcm[at+1] as i64)*256;
    if (v >= 32768) { v = v - 65536; }
    return v;
}
// Fundamental period via autocorrelation (lags for 70..1400 Hz).
// Returns the lag, or -1. Picks the SMALLEST lag within 95% of the
// peak so octaves resolve to the fundamental.
fn td_pitch_lag(pcm:[]u8, off:i32, n:i32, sr:i32, ops:*i64) i64 {
    let wn:i32 = n;
    if (wn > 16000) { wn = 16000; }
    if (wn < 64) { return -1; }
    let sum:i64 = 0;
    let i:i32 = 0;
    while (i < wn) { sum = sum + td_sample(pcm, off + i*2); i = i + 1; }
    let dc:i64 = sum/(wn as i64);
    let lmin:i32 = sr/1400;
    if (lmin < 4) { lmin = 4; }
    let lmax:i32 = sr/70;
    let cap:i32 = wn/2 - 2;
    if (lmax > cap) { lmax = cap; }
    if (lmax <= lmin) { return -1; }
    let nl:i32 = lmax - lmin + 1;
    if (nl > 1024) { nl = 1024; lmax = lmin + nl - 1; }
    let sc:[]u8 = nio_alloc(nl*8);
    if (sc.len == 0) { return -1; }
    let np:i32 = wn/2 - lmax;
    if (np < 1) { np = 1; }
    let li:i32 = 0;
    let maxv:i64 = 0;
    let first:i32 = 1;
    while (li < nl) {
        let L:i32 = lmin + li;
        let acc:i64 = 0;
        let j:i32 = 0;
        while (j < np) {
            let a:i64 = td_sample(pcm, off + j*2) - dc;
            let b2:i64 = td_sample(pcm, off + j*2 + L*2) - dc;
            acc = acc + a*b2;
            ops.* = ops.* + 1;
            j = j + 1;
        }
        td_put64(sc, li*8, acc);
        if (first == 1 || acc > maxv) { maxv = acc; first = 0; }
        li = li + 1;
    }
    if (maxv <= 0) { nio_free(sc); return -1; }
    // Peak picking: the FIRST prominent local maximum of the
    // autocorrelation (score >= 50% of the global max). This resolves to
    // the fundamental period. (The previous rule -- smallest lag within
    // 99% of the max -- locked onto 2x/3x period multiples for sawtooth
    // and square waves: their jump discontinuities misalign by a
    // fraction of a sample at the true period, scoring ~0.94, while a
    // multiple with luckier fractional alignment scored higher.)
    let blag:i64 = -1;
    li = 1;
    while (li < nl - 1) {
        let v0:i64 = td_get64(sc, (li-1)*8);
        let v1:i64 = td_get64(sc, li*8);
        let v2:i64 = td_get64(sc, (li+1)*8);
        if (blag < 0 && v1 >= v0 && v1 >= v2 && v1*2 >= maxv) {
            blag = (lmin + li) as i64;
        }
        li = li + 1;
    }
    // Fallback (weakly periodic signal): smallest lag within 99% of peak.
    if (blag < 0) {
        li = 0;
        while (li < nl) {
            let v2:i64 = td_get64(sc, li*8);
            if (blag < 0 && v2*100 >= maxv*99) { blag = (lmin + li) as i64; }
            li = li + 1;
        }
    }
    nio_free(sc);
    return blag;
}
// lag -> semitone bin 0..47 via the fixed edge table
fn td_pitch_bin(lag:i64, sr:i32) i32 {
    let s:i64 = sr as i64;
    if (td_pedge(0)*lag > s) { return 0; }
    let b:i32 = 0;
    while (b < 47 && td_pedge(b+1)*lag <= s) { b = b + 1; }
    return b;
}
// PCM window -> pitch handle (PC_P_BASE + bin)
fn td_pitch_handle(pcm:[]u8, off:i32, n:i32, sr:i32, ops:*i64) i64 {
    let lag:i64 = td_pitch_lag(pcm, off, n, sr, ops);
    if (lag < 4) { return PC_P_BASE; }
    return PC_P_BASE + (td_pitch_bin(lag, sr) as i64);
}

// ---------- TIMBRE ----------
// Signal-clarity evidence from a numeric margin (per-mille).
fn td_evidence(m:i64, wmed:i64, wstr:i64) i64 {
    if (m >= wstr) { return PC_EV_STRONG; }
    if (m >= wmed) { return PC_EV_MEDIUM; }
    return PC_EV_WEAK;
}
// PCM window -> (timbre handle, evidence handle).
// Features (f0-normalized or f0-independent, computed in the transducer):
//   brightness  = per-mille energy of the f0-normalized difference signal
//                 (sine ~10, triangle ~12, square ~200, sawtooth ~300)
//   crest       = per-mille peak/RMS
//                 (square 1000, sine 1414, triangle/sawtooth 1732)
//   form factor = per-mille peak/mean|s|
//                 (square 1000, sine 1571, triangle/sawtooth 2000)
// Decision (thresholds calibrated on 440 Hz smoke tones, see
// PERCEPT_DESIGN.md; the memory side only ever sees the handles):
//   crest <= 1150    -> RICH   (square-like, low crest)
//   brightness >= 60 -> BRIGHT (saw-like, strong highs)
//   formfactor>=1780 -> DARK   (triangle-like, mellow but not a sine)
//   else             -> PURE   (sine-like)
fn td_timbre(pcm:[]u8, off:i32, n:i32, sr:i32, ops:*i64) TimbreT {
    let weak:TimbreT = TimbreT{.timbre=PC_T_PURE, .ev=PC_EV_WEAK};
    let L:i64 = td_pitch_lag(pcm, off, n, sr, ops);
    if (L < 4) { L = 4; }
    let wn:i32 = n;
    if (wn > 16000) { wn = 16000; }
    if (wn < 64) { return weak; }
    let sum:i64 = 0;
    let i:i32 = 0;
    while (i < wn) { sum = sum + td_sample(pcm, off + i*2); i = i + 1; }
    let dc:i64 = sum/(wn as i64);
    let diff2:i64 = 0;
    let sig2:i64 = 0;
    let peak:i64 = 0;
    let abssum:i64 = 0;
    let prev:i64 = td_sample(pcm, off) - dc;
    i = 1;
    while (i < wn) {
        let s:i64 = td_sample(pcm, off + i*2) - dc;
        let dd:i64 = ((s - prev)*L)/64;
        diff2 = diff2 + dd*dd;
        sig2 = sig2 + s*s;
        let a:i64 = s;
        if (a < 0) { a = 0 - a; }
        if (a > peak) { peak = a; }
        abssum = abssum + a;
        ops.* = ops.* + 1;
        prev = s;
        i = i + 1;
    }
    if (sig2 == 0) { return weak; }
    let bright:i64 = diff2/((sig2/1000) + 1);
    let rms:i64 = td_isqrt(sig2/(wn as i64));
    let crest:i64 = 0;
    if (rms > 0) { crest = peak*1000/rms; }
    let mabs:i64 = abssum/(wn as i64);
    let ff:i64 = 0;
    if (mabs > 0) { ff = peak*1000/mabs; }
    let t:i64 = PC_T_PURE;
    let ev:i64 = PC_EV_WEAK;
    if (crest <= 1150) {
        t = PC_T_RICH;
        ev = td_evidence(1150 - crest, 60, 120);
    } else {
        if (bright >= 60) {
            t = PC_T_BRIGHT;
            ev = td_evidence(bright - 60, 40, 150);
        } else {
            if (ff >= 1780) {
                t = PC_T_DARK;
                ev = td_evidence(ff - 1780, 60, 150);
            } else {
                t = PC_T_PURE;
                let m1:i64 = 60 - bright;
                let m2:i64 = 1780 - ff;
                let m3:i64 = crest - 1150;
                let mm:i64 = m1;
                if (m2 < mm) { mm = m2; }
                if (m3 < mm) { mm = m3; }
                ev = td_evidence(mm, 25, 60);
            }
        }
    }
    let o:TimbreT = TimbreT{.timbre=t, .ev=ev};
    return o;
}
// fixed 36-ray direction table: returns (dx+32)*64+(dy+32), dx,dy=round(16*cos/sin(k*10deg))
fn td_tdir(k:i32) i64 {
    if (k == 0) { return 3104; }  // dx=16 dy=0
    if (k == 1) { return 3107; }  // dx=16 dy=3
    if (k == 2) { return 3045; }  // dx=15 dy=5
    if (k == 3) { return 2984; }  // dx=14 dy=8
    if (k == 4) { return 2858; }  // dx=12 dy=10
    if (k == 5) { return 2732; }  // dx=10 dy=12
    if (k == 6) { return 2606; }  // dx=8 dy=14
    if (k == 7) { return 2415; }  // dx=5 dy=15
    if (k == 8) { return 2288; }  // dx=3 dy=16
    if (k == 9) { return 2096; }  // dx=0 dy=16
    if (k == 10) { return 1904; }  // dx=-3 dy=16
    if (k == 11) { return 1775; }  // dx=-5 dy=15
    if (k == 12) { return 1582; }  // dx=-8 dy=14
    if (k == 13) { return 1452; }  // dx=-10 dy=12
    if (k == 14) { return 1322; }  // dx=-12 dy=10
    if (k == 15) { return 1192; }  // dx=-14 dy=8
    if (k == 16) { return 1125; }  // dx=-15 dy=5
    if (k == 17) { return 1059; }  // dx=-16 dy=3
    if (k == 18) { return 1056; }  // dx=-16 dy=0
    if (k == 19) { return 1053; }  // dx=-16 dy=-3
    if (k == 20) { return 1115; }  // dx=-15 dy=-5
    if (k == 21) { return 1176; }  // dx=-14 dy=-8
    if (k == 22) { return 1302; }  // dx=-12 dy=-10
    if (k == 23) { return 1428; }  // dx=-10 dy=-12
    if (k == 24) { return 1554; }  // dx=-8 dy=-14
    if (k == 25) { return 1745; }  // dx=-5 dy=-15
    if (k == 26) { return 1872; }  // dx=-3 dy=-16
    if (k == 27) { return 2064; }  // dx=0 dy=-16
    if (k == 28) { return 2256; }  // dx=3 dy=-16
    if (k == 29) { return 2385; }  // dx=5 dy=-15
    if (k == 30) { return 2578; }  // dx=8 dy=-14
    if (k == 31) { return 2708; }  // dx=10 dy=-12
    if (k == 32) { return 2838; }  // dx=12 dy=-10
    if (k == 33) { return 2968; }  // dx=14 dy=-8
    if (k == 34) { return 3035; }  // dx=15 dy=-5
    if (k == 35) { return 3101; }  // dx=16 dy=-3
    return 3104;
}

// ---------- SHAPE ----------
// Radial-profile self-match at a rotation shift (symmetry probe).
fn td_prof_match(r:[]u8, s:i32, tol:i64) i32 {
    let k:i32 = 0;
    while (k < 36) {
        let a:i64 = td_get32(r, k*4);
        let kk:i32 = k + s;
        if (kk >= 36) { kk = kk - 36; }
        let b2:i64 = td_get32(r, kk*4);
        let d:i64 = a - b2;
        if (d < 0) { d = 0 - d; }
        if (d > tol) { return 0; }
        k = k + 1;
    }
    return 1;
}
// Image -> (corner-count, curvature, symmetry) percept tuple.
// Retina-side numeric work: background from the 4 corners,
// foreground mask, centroid, 36-ray radial profile, prominent
// local maxima with non-maximum suppression, rotational
// self-match. Translation-invariant (centroid-relative),
// rotation-invariant (phase-free counts), scale-tolerant
// (all thresholds relative to mean radius).
fn td_shape(img:[]u8, w:i32, h:i32, ops:*i64) ShapeT {
    let deg:ShapeT = ShapeT{.corners=PC_SH_CMANY, .curv=PC_SH_MIXED, .sym=PC_SH_SYM_NONE};
    let bg:i64 = td_lum(img, 0, 0, w) + td_lum(img, w-1, 0, w) + td_lum(img, 0, h-1, w) + td_lum(img, w-1, h-1, w);
    bg = bg/4;
    let sx:i64 = 0;
    let sy:i64 = 0;
    let n:i64 = 0;
    let y:i32 = 0;
    while (y < h) {
        let x:i32 = 0;
        while (x < w) {
            let l:i64 = td_lum(img, x, y, w);
            let d:i64 = l - bg;
            if (d < 0) { d = 0 - d; }
            ops.* = ops.* + 1;
            if (d > 40) { sx = sx + (x as i64); sy = sy + (y as i64); n = n + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    if (n < 16) { return deg; }
    let cx:i32 = (sx/n) as i32;
    let cy:i32 = (sy/n) as i32;
    let r:[]u8 = nio_alloc(144);
    if (r.len == 0) { return deg; }
    let maxT:i32 = w;
    if (h > maxT) { maxT = h; }
    maxT = maxT*2;
    let k:i32 = 0;
    while (k < 36) {
        let dv:i64 = td_tdir(k);
        let dx:i32 = ((dv/64) - 32) as i32;
        let dy:i32 = ((dv % 64) - 32) as i32;
        let t:i32 = 0;
        let rad:i32 = 0;
        let go:i32 = 1;
        while (go == 1 && t < maxT) {
            let x2:i32 = cx + (t*dx)/16;
            let yy:i32 = cy + (t*dy)/16;
            if (x2 < 0 || yy < 0 || x2 >= w || yy >= h) { go = 0; }
            else {
                let l2:i64 = td_lum(img, x2, yy, w);
                let d2:i64 = l2 - bg;
                if (d2 < 0) { d2 = 0 - d2; }
                ops.* = ops.* + 1;
                if (d2 <= 40) { go = 0; } else { rad = t; t = t + 1; }
            }
        }
        td_put32(r, k*4, rad as i64);
        k = k + 1;
    }
    let msum:i64 = 0;
    k = 0;
    while (k < 36) { msum = msum + td_get32(r, k*4); k = k + 1; }
    let mean:i64 = msum/36;
    let prom:i64 = mean/8;
    if (prom < 2) { prom = 2; }
    let ismax:[]u8 = nio_alloc(36);
    if (ismax.len == 0) { nio_free(r); return deg; }
    k = 0;
    while (k < 36) {
        let rk:i64 = td_get32(r, k*4);
        let kp:i32 = k - 1;
        if (kp < 0) { kp = 35; }
        let kn:i32 = k + 1;
        if (kn > 35) { kn = 0; }
        let rp:i64 = td_get32(r, kp*4);
        let rn:i64 = td_get32(r, kn*4);
        let mn:i64 = rp;
        if (rn < mn) { mn = rn; }
        if (rk >= rp && rk >= rn && rk - mn >= prom) { ismax[k] = 1; }
        k = k + 1;
    }
    // non-maximum suppression over +-2 rays (ties -> smaller index)
    let corners:i32 = 0;
    k = 0;
    while (k < 36) {
        if (ismax[k] == 1) {
            let keep:i32 = 1;
            let j:i32 = k - 2;
            while (j <= k + 2) {
                let jj:i32 = j;
                if (jj < 0) { jj = jj + 36; }
                if (jj >= 36) { jj = jj - 36; }
                if (jj != k && ismax[jj] == 1) {
                    let rj:i64 = td_get32(r, jj*4);
                    let rk2:i64 = td_get32(r, k*4);
                    if (rj > rk2) { keep = 0; }
                    if (rj == rk2 && jj < k) { keep = 0; }
                }
                j = j + 1;
            }
            if (keep == 1) { corners = corners + 1; }
        }
        k = k + 1;
    }
    let ch:i64 = PC_SH_CMANY;
    if (corners == 0) { ch = PC_SH_C0; }
    if (corners == 3) { ch = PC_SH_C3; }
    if (corners == 4) { ch = PC_SH_C4; }
    let cu:i64 = PC_SH_STRAIGHT;
    if (ch == PC_SH_CMANY) { cu = PC_SH_MIXED; }
    if (corners == 0) { cu = PC_SH_CURVED; }
    let tol:i64 = mean/12;
    if (tol < 1) { tol = 1; }
    let sym:i64 = PC_SH_SYM_NONE;
    if (td_prof_match(r, 1, tol) == 1) { sym = PC_SH_SYM_FULL; }
    else {
        if (td_prof_match(r, 9, tol) == 1) { sym = PC_SH_SYM_4; }
        else {
            if (td_prof_match(r, 12, tol) == 1) { sym = PC_SH_SYM_3; }
        }
    }
    nio_free(r);
    nio_free(ismax);
    let o:ShapeT = ShapeT{.corners=ch, .curv=cu, .sym=sym};
    return o;
}

// ---------- MOTION ----------
// Clip -> (direction handle, speed handle).
// Retina-side numeric work: per-frame foreground vs frame 0,
// motion centroid per frame, first/last displacement, octant
// lookup, size-relative speed bands. The memory side only ever
// sees the two handles.
fn td_motion(frames:[]u8, nf:i32, w:i32, h:i32, ops:*i64) MotionT {
    let still:MotionT = MotionT{.dir=PC_M_STILL, .spd=PC_SPD_SLOW};
    if (nf < 2 || w < 4 || h < 4) { return still; }
    let fsz:i64 = (w as i64)*(h as i64)*3;
    let cxs:[]u8 = nio_alloc(nf*4);
    let cys:[]u8 = nio_alloc(nf*4);
    if (cxs.len == 0 || cys.len == 0) { nio_free(cxs); nio_free(cys); return still; }
    let fa:i32 = -1;
    let fb:i32 = -1;
    let npix:i32 = w*h;
    let f:i32 = 1;
    while (f < nf) {
        let base:i32 = ((f as i64)*fsz) as i32;
        let sx:i64 = 0;
        let sy:i64 = 0;
        let n2:i64 = 0;
        let p:i32 = 0;
        while (p < npix) {
            let ai:i32 = base + p*3;
            let bi:i32 = p*3;
            let dr:i64 = (frames[ai] as i64) - (frames[bi] as i64);
            let dg:i64 = (frames[ai+1] as i64) - (frames[bi+1] as i64);
            let db:i64 = (frames[ai+2] as i64) - (frames[bi+2] as i64);
            if (dr < 0) { dr = 0 - dr; }
            if (dg < 0) { dg = 0 - dg; }
            if (db < 0) { db = 0 - db; }
            ops.* = ops.* + 1;
            if (dr + dg + db > 90) {
                sx = sx + ((p % w) as i64);
                sy = sy + ((p / w) as i64);
                n2 = n2 + 1;
            }
            p = p + 1;
        }
        if (n2 >= 8) {
            td_put32(cxs, f*4, sx/n2);
            td_put32(cys, f*4, sy/n2);
            if (fa < 0) { fa = f; }
            fb = f;
        }
        f = f + 1;
    }
    if (fa < 0 || fb <= fa) { nio_free(cxs); nio_free(cys); return still; }
    let dx:i64 = td_get32(cxs, fb*4) - td_get32(cxs, fa*4);
    let dy:i64 = td_get32(cys, fb*4) - td_get32(cys, fa*4);
    let dist:i64 = td_isqrt(dx*dx + dy*dy);
    let thresh:i64 = (w as i64)/16;
    if (thresh < 3) { thresh = 3; }
    if (dist < thresh) { nio_free(cxs); nio_free(cys); return still; }
    let ax:i64 = dx;
    if (ax < 0) { ax = 0 - ax; }
    let ay:i64 = dy;
    if (ay < 0) { ay = 0 - ay; }
    // octant lookup: tan(22.5deg) ~= 5/12. y grows downward: dy>0 = south.
    let dir:i64 = PC_M_E;
    if (ay*12 < ax*5) {
        if (dx > 0) { dir = PC_M_E; } else { dir = PC_M_W; }
    } else {
        if (ax*12 < ay*5) {
            if (dy > 0) { dir = PC_M_S; } else { dir = PC_M_N; }
        } else {
            if (dx > 0 && dy < 0) { dir = PC_M_NE; }
            if (dx > 0 && dy > 0) { dir = PC_M_SE; }
            if (dx < 0 && dy < 0) { dir = PC_M_NW; }
            if (dx < 0 && dy > 0) { dir = PC_M_SW; }
        }
    }
    let spd:i64 = PC_SPD_SLOW;
    if (dist*16 >= (w as i64)) { spd = PC_SPD_MEDIUM; }
    if (dist*4 >= (w as i64)) { spd = PC_SPD_FAST; }
    nio_free(cxs);
    nio_free(cys);
    let o:MotionT = MotionT{.dir=dir, .spd=spd};
    return o;
}

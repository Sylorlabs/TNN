// ============================================================
// B-CREW sense binary (Approach B, "human-style").
//
// Wiring only: parse args, read the fixture, hand bytes to the
// transducer (numbers -> percepts), hand percepts to the
// vocabulary (handles + relation tables -> judgment), print.
//
// The memory-side decision path (everything after the transducer
// returns) touches handles and fixed tables only.
// ============================================================
@import("percept.zag")
@import("transducer.zag")
@import("../../tnn-lab/toolchain/R33_NATIVE_IO_V1.zag")

fn sn_u32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) + (b[at+1] as i64)*256 + (b[at+2] as i64)*65536 + (b[at+3] as i64)*16777216;
}
fn sn_emit(k:[]u8, v:[]u8) void {
    _zag_print(k);
    _zag_print("=");
    _zag_println(v);
}
fn sn_emit_i(k:[]u8, v:i64) void {
    _zag_print(k);
    _zag_print("=");
    _zag_println(_zag_i64_to_str(v));
}

// ---- task handlers: fixture bytes -> transducer -> percept vote ----
fn sn_colordisc(b:[]u8, n:i32, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let w:i32 = sn_u32(b, 0) as i32;
    let h:i32 = sn_u32(b, 4) as i32;
    if (w < 4 || h < 2) { _zag_println("error=bad-dims"); return 1; }
    let need:i64 = 8 + (w as i64)*(h as i64)*3;
    if ((n as i64) < need) { _zag_println("error=short-pixels"); return 1; }
    let img:[]u8 = b[8..n];
    let p1:i64 = td_patch_color(img, w, 0, 0, w/2, h, ops);
    let p2:i64 = td_patch_color(img, w, w/2, 0, w, h, ops);
    ops.* = ops.* + 1;
    sn_emit_i("percept", p1);
    sn_emit_i("percept2", p2);
    if (pc_color_same(p1, p2) == 1) { sn_emit("judgment", "SAME"); } else { sn_emit("judgment", "DIFFERENT"); }
    sn_emit_i("confidence", pc_color_conf(p1, p2));
    sn_emit_i("ops", ops.*);
    return 0;
}
fn sn_colorconst(b:[]u8, n:i32, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let w:i32 = sn_u32(b, 0) as i32;
    let h:i32 = sn_u32(b, 4) as i32;
    if (w < 8 || h < 4) { _zag_println("error=bad-dims"); return 1; }
    let need:i64 = 8 + (w as i64)*(h as i64)*3;
    if ((n as i64) < need) { _zag_println("error=short-pixels"); return 1; }
    let img:[]u8 = b[8..n];
    let p1:i64 = td_adapted_patch(img, w, 0, 0, w/2, h, ops);
    let p2:i64 = td_adapted_patch(img, w, w/2, 0, w, h, ops);
    ops.* = ops.* + 1;
    sn_emit_i("percept", p1);
    sn_emit_i("percept2", p2);
    if (pc_color_same(p1, p2) == 1) { sn_emit("judgment", "SAME_SURFACE"); } else { sn_emit("judgment", "DIFFERENT"); }
    sn_emit_i("confidence", pc_color_conf(p1, p2));
    sn_emit_i("ops", ops.*);
    return 0;
}
fn sn_shapetrans(b:[]u8, n:i32, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let w:i32 = sn_u32(b, 0) as i32;
    let h:i32 = sn_u32(b, 4) as i32;
    if (w < 8 || h < 8) { _zag_println("error=bad-dims"); return 1; }
    let need:i64 = 8 + (w as i64)*(h as i64)*3;
    if ((n as i64) < need) { _zag_println("error=short-pixels"); return 1; }
    let img:[]u8 = b[8..n];
    let sh:ShapeT = td_shape(img, w, h, ops);
    let cls:i64 = pc_shape_decide(&sh, ops);
    sn_emit_i("percept", sh.corners);
    sn_emit_i("shape_curv", sh.curv);
    sn_emit_i("shape_sym", sh.sym);
    if (cls == 0) { sn_emit("judgment", "CIRCLE"); }
    if (cls == 1) { sn_emit("judgment", "TRIANGLE"); }
    if (cls == 2) { sn_emit("judgment", "SQUARE"); }
    sn_emit_i("confidence", pc_shape_conf(&sh, cls));
    sn_emit_i("ops", ops.*);
    return 0;
}
fn sn_pitchdisc(b:[]u8, n:i32, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let sr:i32 = sn_u32(b, 0) as i32;
    let count:i32 = sn_u32(b, 4) as i32;
    if (sr < 8000 || count < 128) { _zag_println("error=bad-audio"); return 1; }
    let need:i64 = 8 + (count as i64)*2;
    if ((n as i64) < need) { _zag_println("error=short-samples"); return 1; }
    let pcm:[]u8 = b[8..n];
    let half:i32 = count/2;
    let p1:i64 = td_pitch_handle(pcm, 0, half, sr, ops);
    let p2:i64 = td_pitch_handle(pcm, half*2, count - half, sr, ops);
    ops.* = ops.* + 1;
    let cmp:i64 = pc_pitch_cmp(p1, p2);
    sn_emit_i("percept", p1);
    sn_emit_i("percept2", p2);
    if (cmp == 0) { sn_emit("judgment", "SAME"); }
    if (cmp < 0) { sn_emit("judgment", "HIGHER"); }
    if (cmp > 0) { sn_emit("judgment", "LOWER"); }
    sn_emit_i("confidence", pc_pitch_conf(p1, p2));
    sn_emit_i("ops", ops.*);
    return 0;
}
fn sn_timbredisc(b:[]u8, n:i32, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let sr:i32 = sn_u32(b, 0) as i32;
    let count:i32 = sn_u32(b, 4) as i32;
    if (sr < 8000 || count < 128) { _zag_println("error=bad-audio"); return 1; }
    let need:i64 = 8 + (count as i64)*2;
    if ((n as i64) < need) { _zag_println("error=short-samples"); return 1; }
    let pcm:[]u8 = b[8..n];
    let t:TimbreT = td_timbre(pcm, 0, count, sr, ops);
    sn_emit_i("percept", t.timbre);
    sn_emit_i("timbre_ev", t.ev);
    if (t.timbre == PC_T_PURE) { sn_emit("judgment", "PURE"); }
    if (t.timbre == PC_T_BRIGHT) { sn_emit("judgment", "BRIGHT"); }
    if (t.timbre == PC_T_DARK) { sn_emit("judgment", "DARK"); }
    if (t.timbre == PC_T_RICH) { sn_emit("judgment", "RICH"); }
    sn_emit_i("confidence", pc_timbre_conf(&t));
    sn_emit_i("ops", ops.*);
    // REMATCH INSTRUMENTATION: transducer-side feature values (per-mille).
    // Judgment path above is unchanged.
    sn_emit_i("timbre_crest", t.crest);
    sn_emit_i("timbre_bright", t.bright);
    sn_emit_i("timbre_form", t.form);
    return 0;
}
fn sn_motiondir(b:[]u8, n:i32, ops:*i64) i32 {
    if (n < 12) { _zag_println("error=short-header"); return 1; }
    let nf:i32 = sn_u32(b, 0) as i32;
    let w:i32 = sn_u32(b, 4) as i32;
    let h:i32 = sn_u32(b, 8) as i32;
    if (nf < 2 || w < 4 || h < 4) { _zag_println("error=bad-video"); return 1; }
    let need:i64 = 12 + (nf as i64)*(w as i64)*(h as i64)*3;
    if ((n as i64) < need) { _zag_println("error=short-frames"); return 1; }
    let frames:[]u8 = b[12..n];
    let m:MotionT = td_motion(frames, nf, w, h, ops);
    sn_emit_i("percept", m.dir);
    sn_emit_i("motion_spd", m.spd);
    if (m.dir == PC_M_STILL) { sn_emit("judgment", "STILL"); }
    if (m.dir == PC_M_N) { sn_emit("judgment", "N"); }
    if (m.dir == PC_M_NE) { sn_emit("judgment", "NE"); }
    if (m.dir == PC_M_E) { sn_emit("judgment", "E"); }
    if (m.dir == PC_M_SE) { sn_emit("judgment", "SE"); }
    if (m.dir == PC_M_S) { sn_emit("judgment", "S"); }
    if (m.dir == PC_M_SW) { sn_emit("judgment", "SW"); }
    if (m.dir == PC_M_W) { sn_emit("judgment", "W"); }
    if (m.dir == PC_M_NW) { sn_emit("judgment", "NW"); }
    sn_emit_i("confidence", pc_motion_conf(&m));
    sn_emit_i("ops", ops.*);
    // REMATCH INSTRUMENTATION: transducer-side motion triple.
    // Judgment path above is unchanged.
    sn_emit_i("motion_mcount", m.mcount);
    sn_emit_i("motion_dx", m.dx);
    sn_emit_i("motion_dy", m.dy);
    return 0;
}

// ---- fixture loading ----
fn sn_run(task:[]u8, path:[]u8, ops:*i64) i32 {
    let slash:i32 = -1;
    let i:i32 = 0;
    while (i < path.len) {
        if (path[i] == 47) { slash = i; }
        i = i + 1;
    }
    let dir:[]u8 = ".";
    let base:[]u8 = path;
    if (slash > 0) {
        dir = path[0..slash];
        base = path[slash+1..path.len];
    }
    if (slash == 0) {
        dir = ".";
        base = path[1..path.len];
    }
    let root:i64 = nio_open_root(dir);
    if (root < 0) { _zag_println("error=open-root"); return 1; }
    let fd:i64 = nio_open_child(root, base, 0);
    if (fd < 0) { nio_close(root); _zag_println("error=open-fixture"); return 1; }
    let buf:[]u8 = nio_alloc(8388608);
    if (buf.len == 0) { nio_close(fd); nio_close(root); _zag_println("error=alloc"); return 1; }
    let n64:i64 = nio_read_exact(fd, buf, 8388608);
    nio_close(fd);
    nio_close(root);
    if (n64 < 0) { nio_free(buf); _zag_println("error=read-fixture"); return 1; }
    let n:i32 = n64 as i32;
    let rc:i32 = 99;
    if (nio_equal(task, "colordisc") == 1) { rc = sn_colordisc(buf, n, ops); }
    if (nio_equal(task, "colorconst") == 1) { rc = sn_colorconst(buf, n, ops); }
    if (nio_equal(task, "shapetrans") == 1) { rc = sn_shapetrans(buf, n, ops); }
    if (nio_equal(task, "pitchdisc") == 1) { rc = sn_pitchdisc(buf, n, ops); }
    if (nio_equal(task, "timbredisc") == 1) { rc = sn_timbredisc(buf, n, ops); }
    if (nio_equal(task, "motiondir") == 1) { rc = sn_motiondir(buf, n, ops); }
    if (rc == 99) { _zag_println("error=unknown-task"); rc = 1; }
    nio_free(buf);
    return rc;
}

fn main()i32 {
    let task:[]u8 = _zag_arg(1);
    if (nio_equal(task, "") == 1) {
        _zag_println("error=no-task-arg");
        return 1;
    }
    let path:[]u8 = _zag_arg(2);
    if (nio_equal(path, "") == 1) {
        _zag_println("error=no-fixture-arg");
        return 1;
    }
    _zag_print("approach=");
    _zag_println("B");
    _zag_print("task=");
    _zag_println(task);
    let ops:i64 = 0;
    let rc:i32 = sn_run(task, path, &ops);
    return rc;
}

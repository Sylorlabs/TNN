// ============================================================
// B2 GROW binary: deterministic vocabulary growth.
//
// Reads per-fixture transducer measurements (handle, bin, pos for
// both stimuli; no truth in the emit path) plus a separate labels
// file, and searches candidate cuts {200,400,600,800} per-mille per
// splittable bin. Adopts a cut iff it beats no-split by >= 10
// per-mille TRAIN accuracy at the best k on the decision grid
// (color k=0..6, pitch k=0..3); tie-break = smallest cut; at most
// one split per bin.
//
// Usage: grow <task> <emit-file> <labels-file> <table-out> <log-out>
//   task: colordisc | pitchdisc
// Emits a Zag source file defining grown_c_cut / grown_p_cut and a
// human-readable growth log. Pure deterministic; no randomness.
// ============================================================
@import("percept.zag")
@import("transducer.zag")
@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

// ---------- input parsing ----------
fn g_skip_ws(b:[]u8, n:i32, i:*i32) void {
    while (i.* < n) {
        let c:u8 = b[i.*];
        if (c == 32 || c == 10 || c == 13 || c == 9) { i.* = i.* + 1; } else { break; }
    }
}
fn g_parse_i64(b:[]u8, n:i32, i:*i32) i64 {
    g_skip_ws(b, n, i);
    let neg:i64 = 0;
    if (i.* < n && b[i.*] == 45) { neg = 1; i.* = i.* + 1; }
    let v:i64 = 0;
    while (i.* < n) {
        let c:u8 = b[i.*];
        if (c < 48 || c > 57) { break; }
        v = v*10 + ((c - 48) as i64);
        i.* = i.* + 1;
    }
    if (neg == 1) { v = 0 - v; }
    return v;
}
fn g_read_file(path:[]u8) []u8 {
    let slash:i32 = -1;
    let i:i32 = 0;
    while (i < path.len) {
        if (path[i] == 47) { slash = i; }
        i = i + 1;
    }
    let dir:[]u8 = ".";
    let base:[]u8 = path;
    if (slash > 0) { dir = path[0..slash]; base = path[slash+1..path.len]; }
    if (slash == 0) { dir = "."; base = path[1..path.len]; }
    let root:i64 = nio_open_root(dir);
    if (root < 0) { return nio_alloc(0); }
    let fd:i64 = nio_open_child(root, base, 0);
    if (fd < 0) { nio_close(root); return nio_alloc(0); }
    let buf:[]u8 = nio_alloc(4194304);
    if (buf.len == 0) { nio_close(fd); nio_close(root); return nio_alloc(0); }
    let n64:i64 = nio_read_exact(fd, buf, 4194304);
    nio_close(fd);
    nio_close(root);
    if (n64 < 0) { nio_free(buf); return nio_alloc(0); }
    return buf[0..(n64 as i32)];
}

// ---------- output buffer ----------
struct OBuf {
    b:[]u8,
    n:i64
}
fn g_ob_new(cap:i64) OBuf {
    let b:[]u8 = nio_alloc(cap);
    return OBuf{.b=b, .n=0};
}
fn g_ob_putc(o:*OBuf, c:u8) void {
    o.*.b[o.*.n] = c;
    o.*.n = o.*.n + 1;
}
fn g_ob_puts(o:*OBuf, s:[]u8) void {
    let i:i32 = 0;
    while (i < s.len) { g_ob_putc(o, s[i]); i = i + 1; }
}
fn g_ob_puti(o:*OBuf, v:i64) void {
    if (v < 0) { g_ob_putc(o, 45); v = 0 - v; }
    // decimal digits via a small stack buffer
    let tmp:[]u8 = nio_alloc(24);
    let nd:i32 = 0;
    if (v == 0) { tmp[0] = 48; nd = 1; }
    while (v > 0) {
        tmp[nd] = ((v % 10) as u8) + 48;
        v = v/10;
        nd = nd + 1;
    }
    let j:i32 = nd - 1;
    while (j >= 0) { g_ob_putc(o, tmp[j]); j = j - 1; }
    nio_free(tmp);
}
fn g_ob_write(o:*OBuf, path:[]u8) i32 {
    let slash:i32 = -1;
    let i:i32 = 0;
    while (i < path.len) {
        if (path[i] == 47) { slash = i; }
        i = i + 1;
    }
    let dir:[]u8 = ".";
    let base:[]u8 = path;
    if (slash > 0) { dir = path[0..slash]; base = path[slash+1..path.len]; }
    if (slash == 0) { dir = "."; base = path[1..path.len]; }
    let root:i64 = nio_open_root(dir);
    if (root < 0) { return 1; }
    // caller deletes any pre-existing file (O_EXCL semantics on create)
    let fd:i64 = nio_open_child(root, base, 1);
    nio_close(root);
    if (fd < 0) { return 1; }
    let w:i64 = nio_write_all(fd, o.*.b[0..(o.*.n as i32)]);
    nio_close(fd);
    if (w != o.*.n) { return 1; }
    return 0;
}

// ---------- data (u8 arenas of i64, explicit LE) ----------
fn g_newa(n:i64) []u8 { return nio_alloc(n*8); }
fn g_aput(a:[]u8, i:i64, v:i64) void { td_put64(a, (i*8) as i32, v); }
fn g_aget(a:[]u8, i:i64) i64 { return td_get64(a, (i*8) as i32); }

// task: 0=color, 1=pitch
fn g_cacc(sb:i64, cut:i64, k:i64, n:i64, h1:[]u8, b1:[]u8, p1:[]u8, h2:[]u8, b2:[]u8, p2:[]u8, t:[]u8) i64 {
    let ok:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let d:i64 = pc_color_dist(g_aget(h1, i), g_aget(h2, i));
        if (sb >= 0 && g_aget(b1, i) == sb && g_aget(b2, i) == sb) {
            let s1:i64 = 0;
            if (g_aget(p1, i) >= cut) { s1 = 1; }
            let s2:i64 = 0;
            if (g_aget(p2, i) >= cut) { s2 = 1; }
            if (s1 != s2) { d = d + 1; }
        }
        let judg:i64 = 0;
        if (d > k) { judg = 1; }
        if (judg == g_aget(t, i)) { ok = ok + 1; }
        i = i + 1;
    }
    return ok;
}
fn g_pacc(sb:i64, cut:i64, k:i64, n:i64, h1:[]u8, b1:[]u8, p1:[]u8, h2:[]u8, b2:[]u8, p2:[]u8, t:[]u8) i64 {
    let ok:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let bb1:i64 = g_aget(b1, i);
        let bb2:i64 = g_aget(b2, i);
        let bd:i64 = bb1 - bb2;
        if (bd < 0) { bd = 0 - bd; }
        let d:i64 = bd;
        let s1:i64 = 0;
        let s2:i64 = 0;
        if (sb >= 0 && bb1 == sb && bb2 == sb) {
            if (g_aget(p1, i) >= cut) { s1 = 1; }
            if (g_aget(p2, i) >= cut) { s2 = 1; }
            if (s1 != s2) { d = d + 1; }
        }
        // judgment: 0=SAME 1=HIGHER 2=LOWER (matches b_pitch_judgment)
        let judg:i64 = 0;
        if (d > k) {
            if (bb2 > bb1) { judg = 1; }
            else {
                if (bb2 < bb1) { judg = 2; }
                else {
                    if (s2 > s1) { judg = 1; }
                    else { if (s2 < s1) { judg = 2; } }
                }
            }
        }
        if (judg == g_aget(t, i)) { ok = ok + 1; }
        i = i + 1;
    }
    return ok;
}

fn main()i32 {
    let task:[]u8 = _zag_arg(1);
    let emit_path:[]u8 = _zag_arg(2);
    let lab_path:[]u8 = _zag_arg(3);
    let tab_path:[]u8 = _zag_arg(4);
    let log_path:[]u8 = _zag_arg(5);
    if (nio_equal(task, "") == 1 || nio_equal(emit_path, "") == 1) {
        _zag_println("error=args");
        return 1;
    }
    let is_pitch:i64 = 0;
    if (nio_equal(task, "pitchdisc") == 1) { is_pitch = 1; }
    if (nio_equal(task, "colordisc") != 1 && is_pitch == 0) {
        _zag_println("error=task");
        return 1;
    }
    let kmax:i64 = 6;
    if (is_pitch == 1) { kmax = 3; }
    let nbins:i64 = 12;
    if (is_pitch == 1) { nbins = 48; }

    // load emit records
    let eb:[]u8 = g_read_file(emit_path);
    if (eb.len == 0) { _zag_println("error=emit-read"); return 1; }
    let ei:i32 = 0;
    let n:i64 = g_parse_i64(eb, eb.len, &ei);
    if (n <= 0 || n > 10000) { _zag_println("error=emit-n"); return 1; }
    let h1:[]u8 = g_newa(n);
    let b1:[]u8 = g_newa(n);
    let p1:[]u8 = g_newa(n);
    let h2:[]u8 = g_newa(n);
    let b2:[]u8 = g_newa(n);
    let p2:[]u8 = g_newa(n);
    let i:i64 = 0;
    while (i < n) {
        let f:i64 = g_parse_i64(eb, eb.len, &ei);
        g_aput(h1, i, g_parse_i64(eb, eb.len, &ei));
        g_aput(b1, i, g_parse_i64(eb, eb.len, &ei));
        g_aput(p1, i, g_parse_i64(eb, eb.len, &ei));
        g_aput(h2, i, g_parse_i64(eb, eb.len, &ei));
        g_aput(b2, i, g_parse_i64(eb, eb.len, &ei));
        g_aput(p2, i, g_parse_i64(eb, eb.len, &ei));
        if (f != i) { _zag_println("error=emit-order"); return 1; }
        i = i + 1;
    }
    // load labels
    let lb:[]u8 = g_read_file(lab_path);
    if (lb.len == 0) { _zag_println("error=lab-read"); return 1; }
    let li:i32 = 0;
    let ln:i64 = g_parse_i64(lb, lb.len, &li);
    if (ln != n) { _zag_println("error=lab-n"); return 1; }
    let t:[]u8 = g_newa(n);
    i = 0;
    while (i < n) {
        let f:i64 = g_parse_i64(lb, lb.len, &li);
        g_aput(t, i, g_parse_i64(lb, lb.len, &li));
        if (f != i) { _zag_println("error=lab-order"); return 1; }
        i = i + 1;
    }

    // no-split baseline at best k
    let base:i64 = 0;
    let base_k:i64 = 0;
    let k:i64 = 0;
    while (k <= kmax) {
        let a:i64 = 0;
        if (is_pitch == 1) { a = g_pacc(-1, 0, k, n, h1, b1, p1, h2, b2, p2, t); }
        else { a = g_cacc(-1, 0, k, n, h1, b1, p1, h2, b2, p2, t); }
        if (a > base) { base = a; base_k = k; }
        k = k + 1;
    }

    // per-bin cut search
    let cuts:[]u8 = g_newa(nbins);
    i = 0;
    while (i < nbins) { g_aput(cuts, i, -1); i = i + 1; }
    let log:OBuf = g_ob_new(65536);
    g_ob_puts(&log, "# GROW ");
    g_ob_puts(&log, task);
    g_ob_puts(&log, " n=");
    g_ob_puti(&log, n);
    g_ob_puts(&log, " base_acc=");
    g_ob_puti(&log, base);
    g_ob_puts(&log, " base_k=");
    g_ob_puti(&log, base_k);
    g_ob_putc(&log, 10);

    let sb:i64 = 0;
    while (sb < nbins) {
        // count in-bin pairs
        let cnt:i64 = 0;
        i = 0;
        while (i < n) {
            if (g_aget(b1, i) == sb && g_aget(b2, i) == sb) { cnt = cnt + 1; }
            i = i + 1;
        }
        if (cnt > 0) {
            let best_cut:i64 = -1;
            let best_a:i64 = base;
            let best_k:i64 = base_k;
            let ci:i64 = 0;
            while (ci < 4) {
                let cut:i64 = 200;
                if (ci == 1) { cut = 400; }
                if (ci == 2) { cut = 600; }
                if (ci == 3) { cut = 800; }
                let ca:i64 = 0;
                let ck:i64 = 0;
                k = 0;
                while (k <= kmax) {
                    let a:i64 = 0;
                    if (is_pitch == 1) { a = g_pacc(sb, cut, k, n, h1, b1, p1, h2, b2, p2, t); }
                    else { a = g_cacc(sb, cut, k, n, h1, b1, p1, h2, b2, p2, t); }
                    if (a > ca) { ca = a; ck = k; }
                    k = k + 1;
                }
                // adopt iff >=10 per-mille over baseline; tie -> smallest cut
                if ((ca - base)*1000 >= 10*n && ca > best_a) {
                    best_a = ca;
                    best_cut = cut;
                    best_k = ck;
                }
                ci = ci + 1;
            }
            if (best_cut >= 0) {
                g_aput(cuts, sb, best_cut);
                g_ob_puts(&log, "bin ");
                g_ob_puti(&log, sb);
                g_ob_puts(&log, ": cut ");
                g_ob_puti(&log, best_cut);
                g_ob_puts(&log, " acc ");
                g_ob_puti(&log, best_a);
                g_ob_puts(&log, " k ");
                g_ob_puti(&log, best_k);
                g_ob_puts(&log, " gain_pm ");
                g_ob_puti(&log, (best_a - base)*1000/n);
                g_ob_putc(&log, 10);
            }
        }
        sb = sb + 1;
    }

    // write table (Zag source)
    let tab:OBuf = g_ob_new(65536);
    g_ob_puts(&tab, "// Grown vocabulary table (B2). Generated by grow.zag; do not hand-edit.\n");
    g_ob_puts(&tab, "// task=");
    g_ob_puts(&tab, task);
    g_ob_puts(&tab, " n=");
    g_ob_puti(&tab, n);
    g_ob_putc(&tab, 10);
    if (is_pitch == 1) {
        g_ob_puts(&tab, "fn grown_p_cut(h:i64) i64 {\n");
    } else {
        g_ob_puts(&tab, "fn grown_c_cut(h:i64) i64 {\n");
    }
    sb = 0;
    while (sb < nbins) {
        let c:i64 = g_aget(cuts, sb);
        if (c >= 0) {
            g_ob_puts(&tab, "    if (h == ");
            g_ob_puti(&tab, sb);
            g_ob_puts(&tab, ") { return ");
            g_ob_puti(&tab, c);
            g_ob_puts(&tab, "; }\n");
        }
        sb = sb + 1;
    }
    g_ob_puts(&tab, "    return -1;\n}\n");
    let wrc:i32 = g_ob_write(&tab, tab_path);
    if (wrc != 0) { _zag_println("error=tab-write"); return 1; }
    wrc = g_ob_write(&log, log_path);
    if (wrc != 0) { _zag_println("error=log-write"); return 1; }
    _zag_print("grew n=");
    _zag_print(_zag_i64_to_str(n));
    _zag_println(" ok");
    return 0;
}

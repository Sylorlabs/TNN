// ============================================================
// B2 JUDGE binary: frozen B judgment refined by the grown table.
//
// For colordisc/colorconst: d = pc_color_dist(h1,h2); if both
// stimuli fall in the same split hue bin (grown_c_cut >= 0) and
// their lightness per-mille positions fall on opposite sides of
// the cut, d += 1.
// For pitchdisc: d = |b1-b2|; if both in the same split pitch bin
// and their within-bin frequency per-mille positions fall on
// opposite sides, d += 1. Direction from (bin,side) ordering.
//
// Usage: judge <task> <fixture-path> [grown-table.zag]
// The grown table is compiled in (grown.zag). Emits dist=, dir=
// (pitch), ops=. The k threshold is applied by the driver from the
// TRAIN-fitted value.
// ============================================================
@import("percept.zag")
@import("transducer.zag")
@import("grown.zag")
@import("../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn j_u32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) + (b[at+1] as i64)*256 + (b[at+2] as i64)*65536 + (b[at+3] as i64)*16777216;
}
fn j_emit_i(k:[]u8, v:i64) void {
    _zag_print(k);
    _zag_print("=");
    _zag_println(_zag_i64_to_str(v));
}

fn j_colordisc(b:[]u8, n:i32, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let w:i32 = j_u32(b, 0) as i32;
    let h:i32 = j_u32(b, 4) as i32;
    if (w < 4 || h < 2) { _zag_println("error=bad-dims"); return 1; }
    let need:i64 = 8 + (w as i64)*(h as i64)*3;
    if ((n as i64) < need) { _zag_println("error=short-pixels"); return 1; }
    let img:[]u8 = b[8..n];
    let p1:CPos = td_patch_cpos(img, w, 0, 0, w/2, h, ops);
    let p2:CPos = td_patch_cpos(img, w, w/2, 0, w, h, ops);
    let d:i64 = pc_color_dist(p1.handle, p2.handle);
    if (p1.bin >= 0 && p1.bin == p2.bin) {
        let cut:i64 = grown_c_cut(p1.bin);
        if (cut >= 0) {
            let s1:i64 = 0;
            if (p1.pos >= cut) { s1 = 1; }
            let s2:i64 = 0;
            if (p2.pos >= cut) { s2 = 1; }
            if (s1 != s2) { d = d + 1; }
        }
    }
    j_emit_i("percept", p1.handle);
    j_emit_i("percept2", p2.handle);
    j_emit_i("dist", d);
    j_emit_i("ops", ops.*);
    return 0;
}
fn j_colorconst(b:[]u8, n:i32, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let w:i32 = j_u32(b, 0) as i32;
    let h:i32 = j_u32(b, 4) as i32;
    if (w < 8 || h < 4) { _zag_println("error=bad-dims"); return 1; }
    let need:i64 = 8 + (w as i64)*(h as i64)*3;
    if ((n as i64) < need) { _zag_println("error=short-pixels"); return 1; }
    let img:[]u8 = b[8..n];
    let p1:CPos = td_adapted_cpos(img, w, 0, 0, w/2, h, ops);
    let p2:CPos = td_adapted_cpos(img, w, w/2, 0, w, h, ops);
    let d:i64 = pc_color_dist(p1.handle, p2.handle);
    if (p1.bin >= 0 && p1.bin == p2.bin) {
        let cut:i64 = grown_c_cut(p1.bin);
        if (cut >= 0) {
            let s1:i64 = 0;
            if (p1.pos >= cut) { s1 = 1; }
            let s2:i64 = 0;
            if (p2.pos >= cut) { s2 = 1; }
            if (s1 != s2) { d = d + 1; }
        }
    }
    j_emit_i("percept", p1.handle);
    j_emit_i("percept2", p2.handle);
    j_emit_i("dist", d);
    j_emit_i("ops", ops.*);
    return 0;
}
fn j_pitchdisc(b:[]u8, n:i32, ops:*i64) i32 {
    if (n < 8) { _zag_println("error=short-header"); return 1; }
    let sr:i32 = j_u32(b, 0) as i32;
    let count:i32 = j_u32(b, 4) as i32;
    if (sr < 8000 || count < 128) { _zag_println("error=bad-audio"); return 1; }
    let need:i64 = 8 + (count as i64)*2;
    if ((n as i64) < need) { _zag_println("error=short-samples"); return 1; }
    let pcm:[]u8 = b[8..n];
    let half:i32 = count/2;
    let p1:PPos = td_pitch_ppos(pcm, 0, half, sr, ops);
    let p2:PPos = td_pitch_ppos(pcm, half*2, count - half, sr, ops);
    let bd:i64 = p1.bin - p2.bin;
    if (bd < 0) { bd = 0 - bd; }
    let d:i64 = bd;
    let s1:i64 = 0;
    let s2:i64 = 0;
    if (p1.bin == p2.bin) {
        let cut:i64 = grown_p_cut(p1.bin);
        if (cut >= 0) {
            if (p1.pos >= cut) { s1 = 1; }
            if (p2.pos >= cut) { s2 = 1; }
            if (s1 != s2) { d = d + 1; }
        }
    }
    // direction: 0=SAME 1=HIGHER 2=LOWER (driver applies k to d)
    let dir:i64 = 0;
    if (p2.bin > p1.bin) { dir = 1; }
    else {
        if (p2.bin < p1.bin) { dir = 2; }
        else {
            if (s2 > s1) { dir = 1; }
            else { if (s2 < s1) { dir = 2; } }
        }
    }
    j_emit_i("percept", p1.handle);
    j_emit_i("percept2", p2.handle);
    j_emit_i("dist", d);
    j_emit_i("dir", dir);
    j_emit_i("ops", ops.*);
    return 0;
}

fn j_run(task:[]u8, path:[]u8, ops:*i64) i32 {
    let slash:i32 = -1;
    let i:i32 = 0;
    while (i < path.len) {
        if (path[i] == 47) { slash = i; }
        i = i + 1;
    }
    let dir:[]u8 = ".";
    let base:[]u8 = path;
    if (slash > 0) { dir = path[0..slash]; base = path[slash+1..path.len]; }
    if (slash == 0) { dir = "."; base = path[1..path.len]; }
    let root:i64 = nio_open_root(dir);
    if (root < 0) { _zag_println("error=open-root"); return 1; }
    let fd:i64 = nio_open_child(root, base, 0);
    if (fd < 0) { nio_close(root); _zag_println("error=open-fixture"); return 1; }
    let buf:[]u8 = nio_alloc(8388608);
    if (buf.len == 0) { nio_close(fd); nio_close(root); _zag_println("error=alloc"); return 1; }
    let n64:i64 = nio_read_exact(fd, buf, 8388608);
    nio_close(fd);
    nio_close(root);
    if (n64 < 0) { nio_free(buf); _zag_println("error=read-fixture"); return 1; }
    let n:i32 = n64 as i32;
    let rc:i32 = 99;
    if (nio_equal(task, "colordisc") == 1) { rc = j_colordisc(buf, n, ops); }
    if (nio_equal(task, "colorconst") == 1) { rc = j_colorconst(buf, n, ops); }
    if (nio_equal(task, "pitchdisc") == 1) { rc = j_pitchdisc(buf, n, ops); }
    if (rc == 99) { _zag_println("error=unknown-task"); rc = 1; }
    nio_free(buf);
    return rc;
}

fn main()i32 {
    let task:[]u8 = _zag_arg(1);
    if (nio_equal(task, "") == 1) { _zag_println("error=no-task-arg"); return 1; }
    let path:[]u8 = _zag_arg(2);
    if (nio_equal(path, "") == 1) { _zag_println("error=no-fixture-arg"); return 1; }
    _zag_print("task=");
    _zag_println(task);
    let ops:i64 = 0;
    let rc:i32 = j_run(task, path, &ops);
    return rc;
}

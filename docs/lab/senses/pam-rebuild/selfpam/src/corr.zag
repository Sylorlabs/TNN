// corr.zag — C1-class corroborator (frozen).
//
// The install path's second hit: a frozen pure-Zag analytic probe, diverse
// from and uncontrolled by the proposer, that agrees with the draft within
// tolerance. Per the v2 independent-evidence rule (PREREG_V2-IE_AMEND1,
// amendment f61da3af):
//   R1 (prog gate): only prog=PASS (draft) records are adjudicated.
//   R2 (channel authentication): the corroborator's re-judgment counts as
//       independent evidence ONLY over a registered, authenticated channel.
//       The gate holds the channel registration key; agreement counts only
//       when the record's channel attestation verifies:
//         gatt == sha256hex(CHANNEL_KEY || jcode || "|" || conf || "|"
//                           || meas || "|" || hex(sha256(evidence_bytes)))
//       Bare (jcode, conf, meas) fields, however agreeing, are insufficient
//       and are treated as absent independent evidence.
//   R3 (attested-agreement install bar): no promotion without
//       conf >= 700 on the attested record.
// The corroborator re-reads the evidence bytes itself (it never trusts the
// proposer's meas); the gate cross-binds sha256(evidence) to the claim's
// evhash byte-for-byte (PREREG §3.3; mismatch => fail closed).
//
// CHANNEL_KEY is the frozen TEST registration key for this composition.
// A production deployment replaces it with a real channel-key ceremony;
// the mechanism — the gate verifies, the forger cannot sign — is what is
// frozen (IE amendment R2). The amendment's own test key
// ("PAMV2-REG-CHANNEL-2026-09-23") is scoped to the V2 hardening battery;
// self-PAM's C1 channel registers its own frozen key here.
//
// Frozen analytic families (v1):
//   fam 0 "SPAN-SUM": jcode = fact_jcode("SPAN-SUM"), meas = span_sum(ev)
//   fam 1 "SPAN-MAX": jcode = fact_jcode("SPAN-MAX"), meas = span_max(ev)
// conf is a fixed deterministic function of the evidence (no RNG):
//   conf = 700 + (evlen % 300) on non-empty evidence, else 0 (declines).

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("codec.zag")
@import("admit_claim.zag")

fn corr_key() []u8 { return "SELF-PAM-C1-REG-CHANNEL-2026-09-23"; }

fn corr_jcode(fam:i32) i32 {
    if(fam == 1) { return fact_jcode("SPAN-MAX"); }
    return fact_jcode("SPAN-SUM");
}
fn corr_meas(ev:[]u8, fam:i32) i32 {
    if(fam == 1) { return span_max(ev); }
    return span_sum(ev);
}
fn corr_conf(ev:[]u8) i32 {
    if(ev.len == 0) { return 0; }
    return 700 + (ev.len % 300);
}
// Build the attestation preimage into ob; returns new pos.
fn corr_preimage(ob:[]u8, pos:i32, jcode:i32, conf:i32, meas:i32,
                 evhex:[]u8) i32 {
    pos = ob_add_raw(ob, pos, corr_key());
    pos = ob_add_i32(ob, pos, jcode);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_i32(ob, pos, conf);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_i32(ob, pos, meas);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_raw(ob, pos, evhex);
    return pos;
}
// corr_attest: gatt = sha256hex(preimage) into out64 (must be 64 B).
fn corr_attest(jcode:i32, conf:i32, meas:i32, evhex:[]u8, out64:[]u8) i32 {
    if(out64.len != 64 || evhex.len != 64) { return -1; }
    let ob:[]u8 = nio_alloc(512);
    if(ob.len == 0) { return -1; }
    let pos:i32 = corr_preimage(ob, 0, jcode, conf, meas, evhex);
    let dg:[]u8 = nio_alloc(32);
    if(dg.len == 0) { nio_free(ob); return -1; }
    let rc:i32 = ns_sha256(ob[0..pos], dg);
    nio_free(ob);
    if(rc != 0) { nio_free(dg); return -1; }
    hex_encode(dg, out64);
    nio_free(dg);
    return 0;
}
// corr_verify: 1 iff gatt matches the recomputed attestation.
fn corr_verify(jcode:i32, conf:i32, meas:i32, evhex:[]u8, gatt:[]u8) i32 {
    if(gatt.len != 64 || evhex.len != 64) { return 0; }
    let exp:[]u8 = nio_alloc(64);
    if(exp.len == 0) { return 0; }
    if(corr_attest(jcode, conf, meas, evhex, exp) != 0) { nio_free(exp); return 0; }
    let ok:i32 = 1;
    let i:i32 = 0;
    while(i < 64) {
        if(exp[i] != gatt[i]) { ok = 0; }
        i = i + 1;
    }
    nio_free(exp);
    return ok;
}
// corr_observe: gate-side entry for corroborator-channel records.
// Verifies attestation (R2), conf >= 700 (R3), then runs the gate step
// with src=1 (attested independent channel). Any failure => WITHHELD.
fn corr_observe(st:[]u8, task:i32, jcode:i32, conf:i32, meas:i32,
                ev:[]u8, gatt:[]u8) i32 {
    if(st.len < 4096) { return 0; }
    if(task != 0) { return 0; }
    if(gatt.len != 64) { return 0; }
    let h:[]u8 = nio_alloc(32);
    if(h.len == 0) { return 0; }
    if(ns_sha256(ev, h) != 0) { nio_free(h); return 0; }
    let evhex:[]u8 = nio_alloc(64);
    if(evhex.len == 0) { nio_free(h); return 0; }
    hex_encode(h, evhex);
    let ok:i32 = corr_verify(jcode, conf, meas, evhex, gatt);
    nio_free(evhex);
    if(ok == 0) { nio_free(h); return 0; }   // unattested => absent
    if(conf < 700) { nio_free(h); return 0; } // R3
    let d:i32 = sp_step(st, task, jcode, conf, meas, 0, 1, 1, h);
    nio_free(h);
    return d;
}

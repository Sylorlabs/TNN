// g1_candidate.zag — self-PAM gate as R2-3 candidate gate id 2.
//
// Drop-in companion to round2/forks/R2-3/src/r2p_gates.zag: implements the
// four registration functions plus gate_valid for id 2 ("selfpam-fact-gate").
// See G1_REGISTRATION.md for the two-line sense.zag patch (extend the
// hard-coded gate_id range) that activates it in the instrument.
//
// Formation span (declared src 0 = F blob): the draft-production context.
// Gate span (declared src 1 = G blob): independent re-measurement of the
// claim's subject (TECH_BRIEF §5 item 4).
//
// The candidate's judgment on a span is the self-PAM composition's verdict
// on that span's canonical draft claim: the SPAN-SUM family claim over the
// span bytes, quantized by the frozen FACT tolerance (tol_of(0) = 8,
// PROVISIONAL §8 bid). The instrument withholds iff the formation judgment
// and the gate judgment disagree (jf != jg) — i.e. iff the two spans'
// independent measurements of the claim's subject differ beyond tolerance.
//
// The function is stateless and deterministic (zero RNG): the same span
// bytes always yield the same judgment, so the instrument's x3
// byte-identical runs hold by construction. Whether the candidate clears
// the 90% withhold bar is CELL-A's measurement, not claimed here.

@import("codec.zag")

fn sp_gate_name(id:i32) []u8 {
    if(id == 2) { return "selfpam-fact-gate"; }
    return "";
}
fn sp_gate_formation_src(id:i32) i32 {
    if(id == 2) { return 0; }
    return -1;
}
fn sp_gate_gate_src(id:i32) i32 {
    if(id == 2) { return 1; }
    return -1;
}
fn sp_gate_judge(id:i32, task:i32, evidence:[]u8) i32 {
    if(id != 2) { return -1; }
    // Canonical draft claim for the span: SPAN-SUM family.
    // meas = span_sum(evidence); judgment = meas quantized by the frozen
    // FACT tolerance. Two spans agree iff their quantized measurements
    // are equal.
    let m:i32 = span_sum(evidence);
    return m / 8;
}
fn sp_gate_valid(id:i32) i32 {
    if(id == 2) { return 1; }
    return 0;
}

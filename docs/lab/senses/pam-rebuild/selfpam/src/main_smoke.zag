// main_smoke.zag — smoke driver for the self-PAM composition.
//
// Deterministic 11-step scenario exercising all 9 dispositions plus the
// fail-closed paths. Zero RNG. Prints "step|DISPOSITION" lines on stdout;
// "steps=N digest=<sha256hex>" on stderr (digest over the LF-joined
// disposition-name stream with trailing LF, cf1 convention).
//
// Expected stream:
//   1|PROVISIONAL_INSTALL  2|PERMANENT_INSTALL  3|CORROBORATED
//   4|CHALLENGER_PROV     5|REVISED_INSTALL     6|CONFLICT_WITHHELD
//   7|NEGATIVE_EVIDENCE    8|SUPPRESSED          9|WITHHELD (bad gatt)
//   10|WITHHELD (evidence unbound)  11|WITHHELD (short evhash)

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("codec.zag")
@import("admit_claim.zag")
@import("corr.zag")

fn sm_out(fd:i64, s:[]u8) void {
    let i:i32 = 0;
    while(i < s.len) {
        let n:i32 = s.len - i;
        if(n > 8192) { n = 8192; }
        let chunk:[]u8 = s[i..i+n];
        _zag_raw_syscall(1, fd, _zag_slice_ptr(chunk) as i64, n as i64, 0, 0, 0);
        i = i + n;
    }
}

fn main() i32 {
    let st:[]u8 = sp_init();
    if(st.len == 0) { sm_out(2, "alloc failed\n"); return 1; }

    let e1:[]u8 = "evidence-bundle-alpha-001";
    let e2:[]u8 = "evidence-bundle-beta-002";
    let h1:[]u8 = nio_alloc(32);
    if(h1.len == 0) { return 1; }
    if(fact_evhash(e1, h1) != 0) { sm_out(2, "evhash failed\n"); return 1; }
    let h1hex:[]u8 = nio_alloc(64);
    if(h1hex.len == 0) { return 1; }
    hex_encode(h1, h1hex);

    let jsum:i32 = fact_jcode("SPAN-SUM");
    let m1:i32 = span_sum(e1);
    let jmax:i32 = fact_jcode("SPAN-MAX");
    let x1:i32 = span_max(e1);
    let cg:i32 = corr_conf(e1);

    let out:[]u8 = nio_alloc(4096);
    let dstream:[]u8 = nio_alloc(4096);
    if(out.len == 0 || dstream.len == 0) { return 1; }
    let opos:i32 = 0;
    let dpos:i32 = 0;
    let gatt:[]u8 = nio_alloc(64);
    if(gatt.len == 0) { return 1; }

    // step runner: emit "step|NAME\n" to out, NAME\n to digest stream.
    // (inlined per step to keep the code flat; no bare blocks in fns.)

    let d:i32 = 0;

    // 1: first draft -> PROVISIONAL_INSTALL
    d = admit_claim(st, 0, jsum, 950, m1, h1);
    opos = ob_add_u64(out, opos, 1); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 2: attested corroborator agrees -> PERMANENT_INSTALL
    if(corr_attest(jsum, cg, m1, h1hex, gatt) != 0) { sm_out(2, "attest failed\n"); return 1; }
    d = corr_observe(st, 0, jsum, cg, m1, e1, gatt);
    opos = ob_add_u64(out, opos, 2); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 3: agreeing draft on permanent -> CORROBORATED
    d = admit_claim(st, 0, jsum, 950, m1, h1);
    opos = ob_add_u64(out, opos, 3); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 4: high-conf challenger (different family) -> CHALLENGER_PROV
    d = admit_claim(st, 0, jmax, 900, x1, h1);
    opos = ob_add_u64(out, opos, 4); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 5: attested second challenger agrees -> REVISED_INSTALL
    if(corr_attest(jmax, cg, x1, h1hex, gatt) != 0) { sm_out(2, "attest failed\n"); return 1; }
    d = corr_observe(st, 0, jmax, cg, x1, e1, gatt);
    opos = ob_add_u64(out, opos, 5); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 6: low-conf challenger vs permanent -> CONFLICT_WITHHELD
    d = admit_claim(st, 0, jsum, 500, m1 + 50, h1);
    opos = ob_add_u64(out, opos, 6); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 7: negative-evidence record -> NEGATIVE_EVIDENCE
    d = admit_neg(st, 0, jsum, m1);
    opos = ob_add_u64(out, opos, 7); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 8: draft matching stored negative evidence -> SUPPRESSED
    d = admit_claim(st, 0, jsum, 950, m1, h1);
    opos = ob_add_u64(out, opos, 8); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 9: corroborator record with corrupted attestation -> WITHHELD
    if(corr_attest(jmax, cg, x1, h1hex, gatt) != 0) { sm_out(2, "attest failed\n"); return 1; }
    if(gatt[0] == 48) { gatt[0] = 49; } else { gatt[0] = 48; }
    d = corr_observe(st, 0, jmax, cg, x1, e1, gatt);
    opos = ob_add_u64(out, opos, 9); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 10: evidence bytes do not bind to the attested evhash -> WITHHELD
    if(corr_attest(jmax, cg, x1, h1hex, gatt) != 0) { sm_out(2, "attest failed\n"); return 1; }
    d = corr_observe(st, 0, jmax, cg, x1, e2, gatt);
    opos = ob_add_u64(out, opos, 10); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");

    // 11: draft with short evhash -> WITHHELD (fail closed)
    let short:[]u8 = nio_alloc(16);
    if(short.len == 0) { return 1; }
    let zi:i32 = 0;
    while(zi < 16) { short[zi] = 0; zi = zi + 1; }
    d = admit_claim(st, 0, jsum, 950, m1, short);
    opos = ob_add_u64(out, opos, 11); opos = ob_add_raw(out, opos, "|");
    opos = ob_add_raw(out, opos, sp_disp_name(d)); opos = ob_add_raw(out, opos, "\n");
    dpos = ob_add_raw(dstream, dpos, sp_disp_name(d)); dpos = ob_add_raw(dstream, dpos, "\n");
    nio_free(short);

    sm_out(1, out[0..opos]);

    let dg:[]u8 = nio_alloc(32);
    if(dg.len == 0) { return 1; }
    if(ns_sha256(dstream[0..dpos], dg) != 0) { return 1; }
    let hx:[]u8 = nio_alloc(64);
    if(hx.len == 0) { return 1; }
    hex_encode(dg, hx);
    let rep:[]u8 = nio_alloc(256);
    if(rep.len == 0) { return 1; }
    let rp:i32 = 0;
    rp = ob_add_raw(rep, rp, "steps=11 digest=");
    rp = ob_add_raw(rep, rp, hx);
    rp = ob_add_raw(rep, rp, "\n");
    sm_out(2, rep[0..rp]);
    return 0;
}

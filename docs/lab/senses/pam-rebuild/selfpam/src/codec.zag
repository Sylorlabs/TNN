// codec.zag — FACT-type claim codec (v1).
//
// Frozen per PREREG §3.3:
//   Type codebook v1: { FACT = 0 }. No other types.
//   Per-draft record fields: task (type code), jcode (claim semantic code),
//   conf (claim confidence 0-1000), meas (numeric claim-signature),
//   evhash (SHA-256 of the evidence bundle the claim cites, cross-bound
//   byte-for-byte; mismatch => fail closed, margin unknown).
// The tol_of analog for the FACT type is frozen as the §8 starting bid:
//   tol_of(FACT) = 8 (cf1's task-0 tolerance, kept verbatim per PREREG §3.1),
//   marked PROVISIONAL pending Micah's threshold sign-off.
//
// v1 claim families (frozen): the corroborator supports two analytic
// families over the cited evidence bundle:
//   "SPAN-SUM": meas = sum of evidence bytes mod 2^31
//   "SPAN-MAX": meas = maximum evidence byte (-1 on empty)
// jcode = FNV-1a 32-bit of the canonical family name.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

fn fact_jcode(canon:[]u8) i32 {
    // FNV-1a 32-bit, i64 accumulator masked to 32 bits per step.
    let h:i64 = 2166136261;
    let i:i32 = 0;
    while(i < canon.len) {
        h = h ^ (canon[i] as i64);
        h = h & 4294967295;
        h = h * 16777619;
        h = h & 4294967295;
        i = i + 1;
    }
    return h as i32;
}
fn fact_evhash(ev:[]u8, out32:[]u8) i32 {
    if(out32.len != 32) { return -1; }
    return ns_sha256(ev, out32);
}
fn span_sum(ev:[]u8) i32 {
    let s:i64 = 0;
    let i:i32 = 0;
    while(i < ev.len) { s = s + (ev[i] as i64); i = i + 1; }
    return (s % 2147483648) as i32;
}
fn span_max(ev:[]u8) i32 {
    if(ev.len == 0) { return -1; }
    let m:i32 = ev[0] as i32;
    let i:i32 = 1;
    while(i < ev.len) {
        let b:i32 = ev[i] as i32;
        if(b > m) { m = b; }
        i = i + 1;
    }
    return m;
}
// hex encode 32 bytes -> 64 hex chars.
fn hex_encode(b32:[]u8, out64:[]u8) void {
    let i:i32 = 0;
    while(i < 32) {
        let b:i32 = b32[i] as i32;
        let h1:i32 = (b >> 4) & 15;
        let h2:i32 = b & 15;
        if(h1 < 10) { out64[i * 2] = (48 + h1) as u8; } else { out64[i * 2] = (87 + h1) as u8; }
        if(h2 < 10) { out64[i * 2 + 1] = (48 + h2) as u8; } else { out64[i * 2 + 1] = (87 + h2) as u8; }
        i = i + 1;
    }
}
// hex decode 64 chars -> 32 bytes. Returns 0 on success, -1 on bad input.
fn hex_decode(h64:[]u8, out32:[]u8) i32 {
    if(h64.len != 64 || out32.len != 32) { return -1; }
    let i:i32 = 0;
    while(i < 32) {
        let c1:i32 = h64[i * 2] as i32;
        let c2:i32 = h64[i * 2 + 1] as i32;
        let v1:i32 = -1;
        let v2:i32 = -1;
        if(c1 >= 48 && c1 <= 57) { v1 = c1 - 48; }
        if(c1 >= 97 && c1 <= 102) { v1 = c1 - 87; }
        if(c2 >= 48 && c2 <= 57) { v2 = c2 - 48; }
        if(c2 >= 97 && c2 <= 102) { v2 = c2 - 87; }
        if(v1 < 0 || v2 < 0) { return -1; }
        out32[i] = ((v1 * 16) + v2) as u8;
        i = i + 1;
    }
    return 0;
}
// append signed i32 decimal to ob at pos; returns new pos.
fn ob_add_i32(ob:[]u8, pos:i32, v:i32) i32 {
    if(v < 0) {
        if(pos < ob.len) { ob[pos] = 45; pos = pos + 1; }
        // careful: -(-2147483648) overflows; use i64.
        let x:i64 = 0 - (v as i64);
        return ob_add_u64(ob, pos, x);
    }
    return ob_add_u64(ob, pos, v as i64);
}
fn ob_add_u64(ob:[]u8, pos:i32, v:i64) i32 {
    if(v == 0) {
        if(pos < ob.len) { ob[pos] = 48; pos = pos + 1; }
        return pos;
    }
    let tmp:[]u8 = nio_alloc(24);
    if(tmp.len == 0) { return pos; }
    let n:i32 = 0;
    let x:i64 = v;
    while(x > 0) {
        tmp[n] = ((x % 10) + 48) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i:i32 = n - 1;
    while(i >= 0) {
        if(pos < ob.len) { ob[pos] = tmp[i]; pos = pos + 1; }
        i = i - 1;
    }
    nio_free(tmp);
    return pos;
}
// append raw bytes.
fn ob_add_raw(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
// Wire format (frozen v1): "0|<jcode>|<conf>|<meas>|<64-hex-evhash>\n"
fn fact_wire(task:i32, jcode:i32, conf:i32, meas:i32, evhash:[]u8,
             ob:[]u8, pos:i32) i32 {
    pos = ob_add_i32(ob, pos, task);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_i32(ob, pos, jcode);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_i32(ob, pos, conf);
    pos = ob_add_raw(ob, pos, "|");
    pos = ob_add_i32(ob, pos, meas);
    pos = ob_add_raw(ob, pos, "|");
    let hx:[]u8 = nio_alloc(64);
    if(hx.len == 0) { return pos; }
    hex_encode(evhash, hx);
    pos = ob_add_raw(ob, pos, hx);
    nio_free(hx);
    pos = ob_add_raw(ob, pos, "\n");
    return pos;
}

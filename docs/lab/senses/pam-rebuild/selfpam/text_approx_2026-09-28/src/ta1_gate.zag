// ta1_gate.zag — H-TA1 read-only gate. NEVER derives or writes edges.
// Usage: ta1_gate <edges.tsv> <evidence.tsv> <items.tsv> <verdicts.tsv>
// Strategy: build equivalence classes from edges (transitive closure),
// canonicalize texts by rewriting spans to class representatives,
// admit on canonical equality or content-token subset.
// Pure Zag, zero RNG, deterministic. R33-compact style.
@import("text.zag")
@import("lists.zag")
@import("io.zag")
fn get32(b:[]u8,o:i32)i32{
return (b[o] as i32)+((b[o+1] as i32)*256)+((b[o+2] as i32)*65536)+((b[o+3] as i32)*16777216);}
fn put32(b:[]u8,o:i32,v:i32)void{
b[o]=(v%256) as u8;b[o+1]=((v/256)%256) as u8;
b[o+2]=((v/65536)%256) as u8;b[o+3]=((v/16777216)%256) as u8;return;}
fn find_root(par:[]u8,x:i32)i32{
let r:i32=x;let p:i32=get32(par,r*4);
while(p!=r){r=p;p=get32(par,r*4);}
return r;}
// tab field extractor (shared pattern)
fn tfield(line:[]u8,f:i32)[]u8{
let n:i32=line.len as i32;let i:i32=0;let cur:i32=0;let start:i32=0;
while(i<=n){let c:i32=10;if(i<n){c=line[i] as i32;}
if(c==9){if(cur==f){return ssub(line,start,i);}cur=cur+1;start=i+1;}i=i+1;}
if(cur==f){return ssub(line,start,n);}return "";}
// count lines in blob
fn nlines(b:[]u8)i64{
let c:i64=0;let i:i32=0;let n:i32=b.len as i32;
while(i<n){if(b[i]==10){c=c+1;}i=i+1;}return c;}
// get line k (0-based) from blob
fn getline(b:[]u8,k:i64)[]u8{
let n:i32=b.len as i32;let i:i32=0;let cur:i64=0;let start:i32=0;
while(i<=n){let c:i32=10;if(i<n){c=b[i] as i32;}
if(c==10){if(cur==k){let ln:[]u8=ssub(b,start,i);
if(ln.len>0){if(ln[(ln.len as i32)-1]==13){ln=ssub(ln,0,(ln.len as i32)-1);}}
return ln;}cur=cur+1;start=i+1;}i=i+1;}return "";}
fn main()i32{
let edges_path:[]u8=_zag_arg(1);let ev_path:[]u8=_zag_arg(2);
let items_path:[]u8=_zag_arg(3);let out_path:[]u8=_zag_arg(4);
if(slen(edges_path)==0){print_line("usage: ta1_gate <edges> <evidence> <items> <out>");return 1;}
if(slen(out_path)==0){print_line("usage: ta1_gate <edges> <evidence> <items> <out>");return 1;}
let eblob:[]u8=read_file(edges_path);
let vblob:[]u8=read_file(ev_path);
let iblob:[]u8=read_file(items_path);
if(slen(vblob)==0){print_line("ERR: no evidence");return 1;}
if(slen(iblob)==0){print_line("ERR: no items");return 1;}
let ne:i64=nlines(eblob);
let nv:i64=nlines(vblob);
let ni:i64=nlines(iblob);
print_raw("ta1_gate: edges=");print_raw(i64s(ne));
print_raw(" evidence=");print_raw(i64s(nv));
print_raw(" items=");print_raw(i64s(ni));print_raw("\n");
// Build span list from edges (P and Q of each edge)
let maxsp:i32=512;
let spans:[]u8=z_alloc(maxsp*8); // (ptr,len) pairs via get32/put32 on indices into eblob
// Simpler: store spans as slices in eblob via (start,len) offsets
let soff:[]u8=z_alloc(maxsp*8); // start,len per span
let nsp:i32=0;
let k:i64=0;
while(k<ne){let ln:[]u8=getline(eblob,k);
let p:[]u8=tfield(ln,0);let q:[]u8=tfield(ln,1);
// record p and q as (start,len) into eblob — but p/q are copies from tfield.
// For dev simplicity: we re-derive spans by storing the actual bytes.
// (Full impl stores canonical strings; dev uses direct comparison.)
k=k+1;}
print_line("ta1_gate: READ-ONLY — edges loaded, never derived here");
print_line("ta1_gate: verdict logic requires full implementation");
// Minimal honest output: mark all as WITHHOLD with reason (gate not yet complete)
let out:[]u8=z_alloc(1048576);let at:i32=0;
k=0;
while(k<ni){let ln:[]u8=getline(iblob,k);
let iid:[]u8=tfield(ln,0);
let i:i32=0;let n:i32=iid.len as i32;
while(i<n){out[at]=iid[i];at=at+1;i=i+1;}
let tag:[]u8="\tWITHHOLD\tgate-incomplete\n";
i=0;n=tag.len as i32;while(i<n){out[at]=tag[i];at=at+1;i=i+1;}
k=k+1;}
let final:[]u8=ssub(out,0,at);
if(write_file(out_path,final)==0){print_line("ERR: write");return 1;}
print_raw("verdicts=");print_raw(i64s(ni));print_raw("\n");
return 0;}

// io.zag — minimal file I/O. R33-compact style. Linux x86-64 syscalls.
fn z_cstr(s:[]u8)[]u8{
let n:i32=s.len as i32;let out:[]u8=z_alloc(n+1);let i:i32=0;
while(i<n){out[i]=s[i];i=i+1;}out[n]=0;return out;}
fn read_file(path:[]u8)[]u8{
let cp:[]u8=z_cstr(path);
let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cp) as i64,0,0,0,0,0);
z_free(cp);if(fd<0){return "";}
let cap:i32=1048576;let buf:[]u8=z_alloc(cap);let total:i32=0;let ok:i32=1;
while(ok==1){if(total>=cap){ok=0;break;}
let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+total as i64,(cap-total) as i64,0,0,0);
if(n==-4){continue;}if(n<=0){break;}total=total+n as i32;}
_zag_raw_syscall(3,fd,0,0,0,0,0);
if(ok==0){z_free(buf);return "";}
let out:[]u8=z_alloc(total);let i:i32=0;
while(i<total){out[i]=buf[i];i=i+1;}z_free(buf);return out;}
fn write_file(path:[]u8,data:[]u8)i64{
let cp:[]u8=z_cstr(path);
let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cp) as i64,577,420,0,0,0);
z_free(cp);if(fd<0){return 0;}
let total:i32=data.len as i32;let at:i32=0;let ok:i64=1;
while(at<total){
let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+at as i64,(total-at) as i64,0,0,0);
if(n==-4){continue;}if(n<=0){ok=0;break;}at=at+n as i32;}
_zag_raw_syscall(3,fd,0,0,0,0,0);return ok;}
fn print_raw(s:[]u8)void{
let at:i32=0;let total:i32=s.len as i32;
while(at<total){
let n:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(s) as i64)+at as i64,(total-at) as i64,0,0,0);
if(n==-4){continue;}if(n<=0){break;}at=at+n as i32;}
return;}
fn print_line(s:[]u8)void{print_raw(s);print_raw("\n");return;}

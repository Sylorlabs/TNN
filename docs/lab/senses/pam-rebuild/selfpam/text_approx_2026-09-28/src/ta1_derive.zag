// ta1_derive.zag — H-TA1 edge derivation logger (OUTSIDE the gate).
// Usage: ta1_derive <episodes.tsv> <edges.tsv>
// Pure Zag, zero RNG, deterministic. R33-compact style.
@import("text.zag")
@import("lists.zag")
@import("io.zag")
fn lcp_len(a:[]u8,b:[]u8)i32{
let n:i32=a.len as i32;if((b.len as i32)<n){n=b.len as i32;}
let i:i32=0;while(i<n){if(a[i]!=b[i]){break;}i=i+1;}return i;}
fn lcs_len(a:[]u8,b:[]u8,pre:i32)i32{
let an:i32=a.len as i32;let bn:i32=b.len as i32;
let maxs:i32=an-pre;if((bn-pre)<maxs){maxs=bn-pre;}
let i:i32=0;while(i<maxs){if(a[an-1-i]!=b[bn-1-i]){break;}i=i+1;}return i;}
fn has_negation(s:[]u8)i64{
let low:[]u8=slowcase(s);let n:i32=low.len as i32;
let i:i32=0;let start:i32=0;let in_tok:i32=0;
while(i<=n){let c:i32=32;if(i<n){c=low[i] as i32;}
if(is_space(c)==1){if(in_tok==1){let tok:[]u8=strippunct(ssub(low,start,i));
if(is_negation(tok)==1){return 1;}in_tok=0;}}else{if(in_tok==0){start=i;in_tok=1;}}
i=i+1;}return 0;}
fn parse_tenths(s:[]u8)i64{
let n:i32=s.len as i32;let i:i32=0;let whole:i64=0;
while(i<n){if(s[i]==46){break;}if(is_digit(s[i] as i32)==1){whole=whole*10+(s[i] as i64-48);}i=i+1;}
let frac:i64=0;
if(i<n){if(s[i]==46){i=i+1;if(i<n){if(is_digit(s[i] as i32)==1){frac=s[i] as i64-48;}}}}
return whole*10+frac;}
fn tab_field(line:[]u8,f:i32)[]u8{
let n:i32=line.len as i32;let i:i32=0;let cur:i32=0;let start:i32=0;
while(i<=n){let c:i32=10;if(i<n){c=line[i] as i32;}
if(c==9){if(cur==f){return ssub(line,start,i);}cur=cur+1;start=i+1;}i=i+1;}
if(cur==f){return ssub(line,start,n);}return "";}
fn emit_field(buf:[]u8,o:i32,f:[]u8)i32{
let i:i32=0;let n:i32=f.len as i32;
while(i<n){buf[o]=f[i];o=o+1;i=i+1;}buf[o]=9;o=o+1;return o;}
fn derive_line(line:[]u8,out:[]u8,at:i32)i32{
let ep:[]u8=tab_field(line,0);let p:[]u8=tab_field(line,1);
let q:[]u8=tab_field(line,2);let kind:[]u8=tab_field(line,3);
let warr:[]u8=tab_field(line,4);
if(slen(ep)==0){return -1;}if(slen(p)==0){return -1;}if(slen(q)==0){return -1;}
let tenths:i64=parse_tenths(warr);
if(tenths<5){return -1;}
if(seq(kind,"SAME")==0){if(seq(kind,"INTERCHANGE")==0){return -1;}}
if(has_negation(p)==1){return -1;}if(has_negation(q)==1){return -1;}
let pre:i32=lcp_len(p,q);let suf:i32=lcs_len(p,q,pre);
let ps:[]u8=ssub(p,pre,(p.len as i32)-suf);
let qs:[]u8=ssub(q,pre,(q.len as i32)-suf);
let pt:[]u8=strim(ps);let qt:[]u8=strim(qs);
if(slen(pt)==0){return -1;}if(slen(qt)==0){return -1;}
let o:i32=at;
o=emit_field(out,o,pt);o=emit_field(out,o,qt);
o=emit_field(out,o,warr);o=emit_field(out,o,ep);
out[o]=10;o=o+1;return o;}
fn count_lines(b:[]u8)i64{
let c:i64=0;let i:i32=0;let n:i32=b.len as i32;
while(i<n){if(b[i]==10){c=c+1;}i=i+1;}return c;}
fn main()i32{
let ep_path:[]u8=_zag_arg(1);let out_path:[]u8=_zag_arg(2);
if(slen(ep_path)==0){print_line("usage: ta1_derive <episodes.tsv> <edges.tsv>");return 1;}
if(slen(out_path)==0){print_line("usage: ta1_derive <episodes.tsv> <edges.tsv>");return 1;}
let blob:[]u8=read_file(ep_path);
if(slen(blob)==0){print_line("ERR: cannot read episodes");return 1;}
let cap:i32=1048576;let out:[]u8=z_alloc(cap);
let at:i32=0;let refused:i64=0;
let n:i32=blob.len as i32;let i:i32=0;let start:i32=0;
while(i<=n){let c:i32=10;if(i<n){c=blob[i] as i32;}
if(c==10){let ln:[]u8=ssub(blob,start,i);
if(ln.len>0){if(ln[(ln.len as i32)-1]==13){ln=ssub(ln,0,(ln.len as i32)-1);}}
if(slen(ln)>0){let nat:i32=derive_line(ln,out,at);
if(nat<0){refused=refused+1;}else{at=nat;}}
start=i+1;}i=i+1;}
let final:[]u8=ssub(out,0,at);
if(write_file(out_path,final)==0){print_line("ERR: cannot write edges");return 1;}
print_raw("edges_written=");print_raw(i64s(count_lines(final)));
print_raw(" refused=");print_raw(i64s(refused));print_raw("\n");
return 0;}

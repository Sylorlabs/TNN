// text.zag — shared byte-level text utilities. R33-compact style.
fn slen(s:[]u8)i64{return s.len as i64;}
fn seq(a:[]u8,b:[]u8)i64{
if(a.len!=b.len){return 0;}let n:i32=a.len as i32;let i:i32=0;
while(i<n){if(a[i]!=b[i]){return 0;}i=i+1;}return 1;}
fn tolower_byte(c:i32)i32{
if(c>=65){if(c<=90){return c+32;}}return c;}
fn is_space(c:i32)i32{
if(c==32){return 1;}if(c==9){return 1;}if(c==10){return 1;}if(c==13){return 1;}return 0;}
fn is_digit(c:i32)i32{
if(c>=48){if(c<=57){return 1;}}return 0;}
fn is_punct(c:i32)i32{
if(c==46){return 1;}if(c==44){return 1;}if(c==59){return 1;}if(c==58){return 1;}
if(c==33){return 1;}if(c==63){return 1;}if(c==34){return 1;}if(c==39){return 1;}
if(c==40){return 1;}if(c==41){return 1;}return 0;}
fn sdup(src:[]u8)[]u8{
let n:i32=src.len as i32;let out:[]u8=z_alloc(n);let i:i32=0;
while(i<n){out[i]=src[i];i=i+1;}return out;}
fn slowcase(src:[]u8)[]u8{
let n:i32=src.len as i32;let out:[]u8=z_alloc(n);let i:i32=0;
while(i<n){out[i]=tolower_byte(src[i] as i32) as u8;i=i+1;}return out;}
fn ssub(s:[]u8,lo:i32,hi:i32)[]u8{
let n:i32=hi-lo;let out:[]u8=z_alloc(n);let i:i32=0;
while(i<n){out[i]=s[lo+i];i=i+1;}return out;}
fn strim(s:[]u8)[]u8{
let n:i32=s.len as i32;let lo:i32=0;
while(lo<n){if(is_space(s[lo] as i32)==0){break;}lo=lo+1;}
let hi:i32=n;
while(hi>lo){if(is_space(s[hi-1] as i32)==0){break;}hi=hi-1;}
return ssub(s,lo,hi);}
fn strippunct(s:[]u8)[]u8{
let n:i32=s.len as i32;let lo:i32=0;
while(lo<n){if(is_punct(s[lo] as i32)==0){break;}lo=lo+1;}
let hi:i32=n;
while(hi>lo){if(is_punct(s[hi-1] as i32)==0){break;}hi=hi-1;}
return ssub(s,lo,hi);}
fn sfind(hay:[]u8,needle:[]u8,from:i32)i64{
let hn:i32=hay.len as i32;let nn:i32=needle.len as i32;
if(nn==0){return from as i64;}if(nn>hn){return -1;}
let i:i32=from;
while(i+nn<=hn){let ok:i32=1;let j:i32=0;
while(j<nn){if(hay[i+j]!=needle[j]){ok=0;break;}j=j+1;}
if(ok==1){return i as i64;}i=i+1;}return -1;}
fn ntokens(s:[]u8)i64{
let n:i32=s.len as i32;let i:i32=0;let cnt:i64=0;let in_tok:i32=0;
while(i<n){if(is_space(s[i] as i32)==1){in_tok=0;}else{if(in_tok==0){cnt=cnt+1;in_tok=1;}}i=i+1;}
return cnt;}
fn i64s(v:i64)[]u8{
let neg:i64=0;let x:i64=v;
if(x<0){neg=1;x=0-x;}
let buf:[]u8=z_alloc(24);let p:i32=24;
if(x==0){p=p-1;buf[p]=48;}else{while(x>0){p=p-1;buf[p]=(48+(x%10)) as u8;x=x/10;}}
if(neg==1){p=p-1;buf[p]=45;}
return ssub(buf,p,24);}
fn z_alloc(n:i32)[]u8{
if(n<1){return "";}
let p:*u8=_zag_malloc(n as i64) as *u8;
if(p==null as *u8){return "";}
let b:[]u8=p[0..n];let i:i32=0;
while(i<n){b[i]=0;i=i+1;}return b;}
fn z_free(b:[]u8)void{if(b.len>0){_zag_free(_zag_slice_ptr(b));}return;}

// xp_measure.zag — expansion-corpus measurement driver for the fix1 candidate gate.
//
// CLI: xp_measure <pairs_dir> <manifest_txt> <out_path>
//   manifest_txt: one "<name>.pair" per line (names only, sorted).
//   out_path: per-pair lines:
//     <name> <task> <jf2> <jg2> <wh2> <jf3> <jg3> <wh3> <jf4> <jg4> <wh4>
// where whN = 1 iff sp_gate_judge(N,task,F) != sp_gate_judge(N,task,G).
// Errors (short read / bad header) are emitted as "<name> ERR" lines and
// counted on stdout. Zero RNG, no wall clock. Deterministic.
//
// Uses the real candidate implementation (g1_candidate.zag, fixed): ids
// 2 = span_seq/8 (primary), 3 = span_sum/8 (legacy), 4 = FNV-1a exact.

@import("R33_NATIVE_IO_V1.zag")
@import("g1_candidate.zag")

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 8191) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn z_write_new(path:[]u8, data:[]u8) i64 {
    // O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 420, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_write_all(fd, data);
    nio_close(fd);
    return n;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn fail(msg:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "error", msg);
    nio_write_all(1, ob[0..pos]);
    return 1;
}

// parse one manifest line [start,end) -> pair name; returns new pos or -1
fn emit_pair(dir:[]u8, name:[]u8, pairbuf:[]u8, ob:[]u8, pos:i32) i32 {
    // build path = dir + "/" + name
    let pathbuf:[]u8 = nio_alloc(8192);
    let pp:i32 = 0;
    pp = ob_add(pathbuf, pp, dir);
    pp = ob_add(pathbuf, pp, "/");
    pp = ob_add(pathbuf, pp, name);
    let n:i64 = z_read(pathbuf[0..pp], pairbuf, 2000000);
    nio_free(pathbuf);
    if(n < 64) {
        pos = ob_add(ob, pos, name);
        pos = ob_add(ob, pos, " ERR short-read\n");
        return pos;
    }
    let p_task:i32 = (pairbuf[4] as i32) | ((pairbuf[5] as i32) << 8)
        | ((pairbuf[6] as i32) << 16) | ((pairbuf[7] as i32) << 24);
    let f_len:i32 = (pairbuf[20] as i32) | ((pairbuf[21] as i32) << 8)
        | ((pairbuf[22] as i32) << 16) | ((pairbuf[23] as i32) << 24);
    let g_len:i32 = (pairbuf[24] as i32) | ((pairbuf[25] as i32) << 8)
        | ((pairbuf[26] as i32) << 16) | ((pairbuf[27] as i32) << 24);
    if(f_len < 0 || g_len < 0 || 64 + f_len + g_len > n as i32) {
        pos = ob_add(ob, pos, name);
        pos = ob_add(ob, pos, " ERR bad-header\n");
        return pos;
    }
    let f_blob:[]u8 = pairbuf[64..(64 + f_len)];
    let g_blob:[]u8 = pairbuf[(64 + f_len)..(64 + f_len + g_len)];
    pos = ob_add(ob, pos, name);
    pos = ob_add(ob, pos, " ");
    pos = ob_add(ob, pos, _zag_i64_to_str(p_task as i64));
    let id:i32 = 2;
    while(id <= 4) {
        let jf:i32 = sp_gate_judge(id, p_task, f_blob);
        let jg:i32 = sp_gate_judge(id, p_task, g_blob);
        let wh:i64 = 0;
        if(jf != jg) { wh = 1; }
        pos = ob_add(ob, pos, " ");
        pos = ob_add(ob, pos, _zag_i64_to_str(jf as i64));
        pos = ob_add(ob, pos, " ");
        pos = ob_add(ob, pos, _zag_i64_to_str(jg as i64));
        pos = ob_add(ob, pos, " ");
        pos = ob_add(ob, pos, _zag_i64_to_str(wh));
        id = id + 1;
    }
    pos = ob_add(ob, pos, "\n");
    return pos;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    if(a1.len == 0 || a2.len == 0 || a3.len == 0) {
        return fail("usage: xp_measure <pairs_dir> <manifest_txt> <out_path>");
    }
    let mbuf:[]u8 = nio_alloc(65536);
    let mn:i64 = z_read(a2, mbuf, 65536);
    if(mn < 1) { return fail("manifest-read-failed"); }
    let pairbuf:[]u8 = nio_alloc(2000000);
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    let npairs:i64 = 0;
    let nerr:i64 = 0;
    // split manifest into lines
    let ls:i32 = 0;
    let le:i32 = 0;
    while(le <= mn as i32) {
        let eol:i32 = 0;
        if(le == mn as i32 || mbuf[le] == 10) { eol = 1; }
        if(eol == 1) {
            if(le > ls) {
                let name:[]u8 = mbuf[ls..le];
                // strip trailing \r if present
                if(name.len > 0 && name[name.len - 1] == 13) {
                    name = name[0..(name.len - 1)];
                }
                let before:i32 = pos;
                pos = emit_pair(a1, name, pairbuf, ob, pos);
                npairs = npairs + 1;
                // crude error detect: line contains " ERR"
                if(pos - before > name.len + 5) {
                    // check the emitted tail for " ERR"
                    let k:i32 = before + name.len;
                    if(ob[k] == 32 && ob[k+1] == 69) { nerr = nerr + 1; }
                }
            }
            ls = le + 1;
        }
        le = le + 1;
    }
    let wn:i64 = z_write_new(a3, ob[0..pos]);
    if(wn != pos as i64) { return fail("output-write-failed"); }
    // summary to stdout
    let sb:[]u8 = nio_alloc(256);
    let sp:i32 = 0;
    sp = ob_add(sb, sp, "pairs=");
    sp = ob_add(sb, sp, _zag_i64_to_str(npairs));
    sp = ob_add(sb, sp, " errors=");
    sp = ob_add(sb, sp, _zag_i64_to_str(nerr));
    sp = ob_add(sb, sp, "\n");
    nio_write_all(1, sb[0..sp]);
    return 0;
}

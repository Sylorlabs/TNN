// probe_fix1.zag — red-team probe for the fix1 order-sensitivity change.
//
// Exercises span_seq / span_fnv / sp_gate_judge on synthetic (non-corpus)
// blobs only:
//   T1: task-independence (same bytes, task 0 vs 5, ids 2/3/4)
//   T2: full reversal of a synthetic blob (id2 must withhold, id3 must admit,
//       id4 must withhold)
//   T3: /8-bucket collision via adjacent swap with Delta=-1 (id2 ADMITS —
//       documents the quantization residual)
//   T4: 4-byte tweak preserving BOTH span_sum and span_seq exactly
//       (id2 and id3 ADMIT, id4 withholds)
//   T7: two-swap exact-Delta=0 adversary, +-255 byte changes
//       (id2 and id3 ADMIT, id4 withholds)
//   T6: identical blobs -> all ids admit (sanity)
// Prints key=value lines. Deterministic, zero RNG.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("g1_candidate.zag")

fn p_out(fd:i64, s:[]u8) void {
    let i:i32 = 0;
    while(i < s.len) {
        let n:i32 = s.len - i;
        if(n > 8192) { n = 8192; }
        let chunk:[]u8 = s[i..i+n];
        _zag_raw_syscall(1, fd, _zag_slice_ptr(chunk) as i64, n as i64, 0, 0, 0);
        i = i + n;
    }
}
fn p_kv(ob:[]u8, pos:i32, k:[]u8, v:i32) i32 {
    pos = ob_add_raw(ob, pos, k);
    pos = ob_add_raw(ob, pos, "=");
    pos = ob_add_i32(ob, pos, v);
    pos = ob_add_raw(ob, pos, "\n");
    return pos;
}
// 1 if x != y else 0; 1 if x == y else 0.
fn w_neq(x:i32, y:i32) i32 {
    if(x != y) { return 1; }
    return 0;
}
fn w_eq(x:i32, y:i32) i32 {
    if(x == y) { return 1; }
    return 0;
}

fn main() i32 {
    let ob:[]u8 = nio_alloc(65536);
    if(ob.len == 0) { return 1; }
    let p:i32 = 0;
    let n:i32 = 256;
    let i:i32 = 0;

    // base blob a[i] = (i*7+3) % 256
    let a:[]u8 = nio_alloc(n);
    i = 0;
    while(i < n) { a[i] = (((i * 7 + 3) % 256)) as u8; i = i + 1; }
    // ascending blob c[i] = i % 256
    let c:[]u8 = nio_alloc(n);
    i = 0;
    while(i < n) { c[i] = ((i % 256)) as u8; i = i + 1; }

    // ---- T1: task-independence ----
    let t1ok:i32 = 1;
    let id:i32 = 2;
    while(id <= 4) {
        if(sp_gate_judge(id, 0, a) != sp_gate_judge(id, 5, a)) { t1ok = 0; }
        id = id + 1;
    }
    p = p_kv(ob, p, "T1_task_independent", t1ok);

    // ---- T2: reversal ----
    let b:[]u8 = nio_alloc(n);
    i = 0;
    while(i < n) { b[i] = a[n - 1 - i]; i = i + 1; }
    p = p_kv(ob, p, "T2_seq_a", span_seq(a));
    p = p_kv(ob, p, "T2_seq_b_rev", span_seq(b));
    p = p_kv(ob, p, "T2_id2_withhold",
             w_neq(sp_gate_judge(2, 0, a), sp_gate_judge(2, 0, b)));
    p = p_kv(ob, p, "T2_id3_admit",
             w_eq(sp_gate_judge(3, 0, a), sp_gate_judge(3, 0, b)));
    p = p_kv(ob, p, "T2_id4_withhold",
             w_neq(sp_gate_judge(4, 0, a), sp_gate_judge(4, 0, b)));

    // ---- T3: /8 bucket collision, Delta=-1, no boundary crossing ----
    let c3:[]u8 = nio_alloc(n);
    i = 0;
    while(i < n) { c3[i] = c[i]; i = i + 1; }
    c3[0] = 1;
    let d3:[]u8 = nio_alloc(n);
    i = 0;
    while(i < n) { d3[i] = c3[i]; i = i + 1; }
    d3[10] = c3[11];
    d3[11] = c3[10];
    p = p_kv(ob, p, "T3_seq_c", span_seq(c3));
    p = p_kv(ob, p, "T3_seq_d", span_seq(d3));
    p = p_kv(ob, p, "T3_id2_admit_collision",
             w_eq(sp_gate_judge(2, 0, c3), sp_gate_judge(2, 0, d3)));
    p = p_kv(ob, p, "T3_id4_withhold",
             w_neq(sp_gate_judge(4, 0, c3), sp_gate_judge(4, 0, d3)));

    // ---- T4: 4-byte tweak preserving both sums exactly ----
    // (i,j,k,l) = (20,30,60,50): sum Delta = 0, weighted Delta = 0.
    let e:[]u8 = nio_alloc(n);
    i = 0;
    while(i < n) { e[i] = c[i]; i = i + 1; }
    e[20] = 21;
    e[30] = 29;
    e[60] = 61;
    e[50] = 49;
    p = p_kv(ob, p, "T4_seq_c", span_seq(c));
    p = p_kv(ob, p, "T4_seq_e", span_seq(e));
    p = p_kv(ob, p, "T4_sum_c", span_sum(c));
    p = p_kv(ob, p, "T4_sum_e", span_sum(e));
    p = p_kv(ob, p, "T4_id2_admit",
             w_eq(sp_gate_judge(2, 0, c), sp_gate_judge(2, 0, e)));
    p = p_kv(ob, p, "T4_id3_admit",
             w_eq(sp_gate_judge(3, 0, c), sp_gate_judge(3, 0, e)));
    p = p_kv(ob, p, "T4_id4_withhold",
             w_neq(sp_gate_judge(4, 0, c), sp_gate_judge(4, 0, e)));

    // ---- T7: two-swap exact-Delta=0 adversary, +-255 changes ----
    // g: g[0]=0,g[1]=255,g[200]=255,g[201]=0; h swaps (0,200),(1,201).
    // Delta = (0-200)(255-0) + (1-201)(0-255) = -51000 + 51000 = 0.
    let g:[]u8 = nio_alloc(n);
    i = 0;
    while(i < n) { g[i] = c[i]; i = i + 1; }
    g[0] = 0;
    g[1] = 255;
    g[200] = 255;
    g[201] = 0;
    let h:[]u8 = nio_alloc(n);
    i = 0;
    while(i < n) { h[i] = g[i]; i = i + 1; }
    h[0] = g[200];
    h[200] = g[0];
    h[1] = g[201];
    h[201] = g[1];
    p = p_kv(ob, p, "T7_seq_g", span_seq(g));
    p = p_kv(ob, p, "T7_seq_h", span_seq(h));
    p = p_kv(ob, p, "T7_sum_g", span_sum(g));
    p = p_kv(ob, p, "T7_sum_h", span_sum(h));
    p = p_kv(ob, p, "T7_id2_admit",
             w_eq(sp_gate_judge(2, 0, g), sp_gate_judge(2, 0, h)));
    p = p_kv(ob, p, "T7_id3_admit",
             w_eq(sp_gate_judge(3, 0, g), sp_gate_judge(3, 0, h)));
    p = p_kv(ob, p, "T7_id4_withhold",
             w_neq(sp_gate_judge(4, 0, g), sp_gate_judge(4, 0, h)));

    // ---- T6: identical blobs admit on all ids ----
    let a2:[]u8 = nio_alloc(n);
    i = 0;
    while(i < n) { a2[i] = a[i]; i = i + 1; }
    let t6ok:i32 = 1;
    id = 2;
    while(id <= 4) {
        if(sp_gate_judge(id, 0, a) != sp_gate_judge(id, 0, a2)) { t6ok = 0; }
        id = id + 1;
    }
    p = p_kv(ob, p, "T6_identical_admit", t6ok);

    p_out(1, ob[0..p]);
    return 0;
}

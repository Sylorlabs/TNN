// fc_store.zag — committed-store loader and license-set builder.
// A license = sha256hex(canonical atom). kind 0=STORE, 1=DELIB.
// Provenance is recorded but does NOT gate install (prereg §4).

// state arenas (caller-owned):
//   ids: entry-id bytes; idm: (start,len) u32 pairs per entry
//   eprov: 1 byte per entry (0=WORLD, 1=GEN)
//   lhash: 64 hex bytes per license
//   lkind: 1 byte per license (0=STORE, 1=DELIB)
//   lref:  u32 per license (entry idx / conclusion idx)
//   lprov: 1 byte per license (entry provenance; 0 for DELIB)
//   nent: u32 @0 ; nlic: u32 @0
fn fs_add_license(lhash:[]u8, lkind:[]u8, lref:[]u8, lprov:[]u8,
                  nlic:[]u8, hx64:[]u8, kind:i32, ref:i32, prov:i32) i32 {
    let n:i32 = fu_get32(nlic, 0);
    if(n * 64 + 64 > lhash.len) { return -1; }
    fn_copy(lhash, n*64, hx64);
    lkind[n] = kind as u8;
    fu_put32(lref, n, ref);
    lprov[n] = prov as u8;
    fu_put32(nlic, 0, n+1);
    return 0;
}

// find first two '|' in line; returns p1*1048576+p2 or -1.
fn fs_bar_pos(line:[]u8) i64 {
    let p1:i32 = -1;
    let p2:i32 = -1;
    let i:i32 = 0;
    while(i < line.len) {
        if(line[i] == 124) {
            if(p1 < 0) { p1 = i; } else { p2 = i; break; }
        }
        i = i + 1;
    }
    if(p1 < 0 || p2 < 0) { return -1; }
    return (p1 as i64)*1048576 + (p2 as i64);
}

fn fs_load(text:[]u8, ids:[]u8, idm:[]u8, eprov:[]u8,
            lhash:[]u8, lkind:[]u8, lref:[]u8, lprov:[]u8,
            nent:[]u8, nlic:[]u8, maxent:i32) i32 {
    fu_put32(nent, 0, 0);
    fu_put32(nlic, 0, 0);
    let lm:[]u8 = nio_alloc(512*8);
    if(lm.len == 0) { return -1; }
    let nl:i32 = fu_lines(text, lm, 512);
    if(nl < 0) { nio_free(lm); return -1; }
    let idp:i32 = 0;
    let i:i32 = 0;
    while(i < nl) {
        let ls:i32 = fu_line_start(lm, i);
        let ll:i32 = fu_line_len(lm, i);
        i = i + 1;
        if(ll == 0) { continue; }
        let line:[]u8 = text[ls..ls+ll];
        if(line[0] == 35) { continue; } // '#'
        let bp:i64 = fs_bar_pos(line);
        if(bp < 0) { continue; }
        let p1:i32 = (bp / 1048576) as i32;
        let p2:i32 = (bp % 1048576) as i32;
        let eid:[]u8 = line[0..p1];
        let pv:[]u8 = line[p1+1..p2];
        let etext:[]u8 = line[p2+1..ll];
        let prov:i32 = 0;
        if(_zag_strcmp(pv, "GEN") == 1) { prov = 1; }
        let ne:i32 = fu_get32(nent, 0);
        if(ne >= maxent) { continue; }
        let abuf:[]u8 = nio_alloc(2048);
        let ameta:[]u8 = nio_alloc(8*8);
        if(abuf.len == 0 || ameta.len == 0) {
            nio_free(abuf); nio_free(ameta); continue;
        }
        let ctx:[]u8 = "";
        let na:i32 = fn_atomize(etext, ctx, 0, abuf, ameta);
        if(na <= 0) { nio_free(abuf); nio_free(ameta); continue; }
        // record entry
        idp = fn_copy(ids, idp, eid);
        fu_put32(idm, ne*2, idp - eid.len);
        fu_put32(idm, ne*2+1, eid.len);
        eprov[ne] = prov as u8;
        fu_put32(nent, 0, ne+1);
        let a:i32 = 0;
        while(a < na) {
            let s:i32 = fu_get32(ameta, a*2);
            let l:i32 = fu_get32(ameta, a*2+1);
            let hx:[]u8 = nio_alloc(64);
            if(hx.len != 0) {
                if(fn_atom_hash(abuf[s..s+l], hx) == 0) {
                    fs_add_license(lhash, lkind, lref, lprov, nlic, hx, 0, ne, prov);
                }
                nio_free(hx);
            }
            a = a + 1;
        }
        nio_free(abuf);
        nio_free(ameta);
    }
    nio_free(lm);
    return 0;
}

// add DELIB conclusion licenses for one case; base = store license count.
fn fs_add_delib(delib:[]u8, ctx:[]u8, ctxn:i32,
                lhash:[]u8, lkind:[]u8, lref:[]u8, lprov:[]u8,
                nlic:[]u8, base:i32) i32 {
    fu_put32(nlic, 0, base);
    if(delib.len == 0) { return 0; }
    // split on ";;"
    let starts:[]u8 = nio_alloc(32*4);
    if(starts.len == 0) { return -1; }
    let nc:i32 = 0;
    let i:i32 = 0;
    let cs:i32 = 0;
    while(i <= delib.len) {
        let cut:i32 = 0;
        if(i == delib.len) { cut = 1; }
        if(cut == 0 && delib[i] == 59 && i+1 < delib.len && delib[i+1] == 59) { cut = 1; }
        if(cut == 1) {
            // trim spaces around [cs, i)
            let s:i32 = cs;
            let e:i32 = i;
            while(s < e && delib[s] == 32) { s = s + 1; }
            while(e > s && delib[e-1] == 32) { e = e - 1; }
            if(e > s && nc < 32) {
                fu_put32(starts, nc*2, s);
                fu_put32(starts, nc*2+1, e - s);
                nc = nc + 1;
            }
            if(i < delib.len) { i = i + 2; } else { i = i + 1; }
            cs = i;
            continue;
        }
        i = i + 1;
    }
    let c:i32 = 0;
    while(c < nc) {
        let s:i32 = fu_get32(starts, c*2);
        let l:i32 = fu_get32(starts, c*2+1);
        let abuf:[]u8 = nio_alloc(2048);
        let ameta:[]u8 = nio_alloc(8*8);
        if(abuf.len != 0 && ameta.len != 0) {
            let na:i32 = fn_atomize(delib[s..s+l], ctx, ctxn, abuf, ameta);
            if(na > 0) {
                let a:i32 = 0;
                while(a < na) {
                    let as:i32 = fu_get32(ameta, a*2);
                    let al:i32 = fu_get32(ameta, a*2+1);
                    let hx:[]u8 = nio_alloc(64);
                    if(hx.len != 0) {
                        if(fn_atom_hash(abuf[as..as+al], hx) == 0) {
                            fs_add_license(lhash, lkind, lref, lprov, nlic, hx, 1, c, 0);
                        }
                        nio_free(hx);
                    }
                    a = a + 1;
                }
            }
        }
        nio_free(abuf);
        nio_free(ameta);
        c = c + 1;
    }
    nio_free(starts);
    return 0;
}

// match a 64-hex atom hash; returns license idx or -1.
fn fs_match(lhash:[]u8, nlic:[]u8, hx64:[]u8) i32 {
    let n:i32 = fu_get32(nlic, 0);
    let i:i32 = 0;
    while(i < n) {
        if(nio_equal(lhash[i*64..i*64+64], hx64) == 1) { return i; }
        i = i + 1;
    }
    return -1;
}

fn fs_entry_id(ids:[]u8, idm:[]u8, e:i32) []u8 {
    let s:i32 = fu_get32(idm, e*2);
    let l:i32 = fu_get32(idm, e*2+1);
    return ids[s..s+l];
}

// fc_util.zag — small helpers: u32 arena accessors, output buffer
// appends, byte-wise string compare, line splitting. Zero RNG.

fn fu_put32(a:[]u8, i:i32, v:i32) void {
    let o:i32 = i * 4;
    a[o] = (v & 255) as u8;
    a[o+1] = ((v >> 8) & 255) as u8;
    a[o+2] = ((v >> 16) & 255) as u8;
    a[o+3] = ((v >> 24) & 255) as u8;
}

fn fu_get32(a:[]u8, i:i32) i32 {
    let o:i32 = i * 4;
    return (a[o] as i32) + (a[o+1] as i32)*256 +
           (a[o+2] as i32)*65536 + (a[o+3] as i32)*16777216;
}

// byte-wise lexicographic compare: -1, 0, 1.
fn fu_cmp(a:[]u8, b:[]u8) i32 {
    let n:i32 = a.len;
    if(b.len < n) { n = b.len; }
    let i:i32 = 0;
    while(i < n) {
        if(a[i] != b[i]) {
            if(a[i] < b[i]) { return -1; }
            return 1;
        }
        i = i + 1;
    }
    if(a.len == b.len) { return 0; }
    if(a.len < b.len) { return -1; }
    return 1;
}

fn fu_add_raw(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}

// append i64 decimal (handles 0 and negatives).
fn fu_add_i64(ob:[]u8, pos:i32, v:i64) i32 {
    let tmp:[]u8 = nio_alloc(24);
    if(tmp.len == 0) { return pos; }
    let x:i64 = v;
    if(x < 0) {
        pos = fu_add_raw(ob, pos, "-");
        x = 0 - x;
    }
    let n:i32 = 0;
    if(x == 0) {
        tmp[0] = 48;
        n = 1;
    }
    while(x > 0) {
        tmp[n] = ((x % 10) + 48) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i:i32 = n - 1;
    while(i >= 0) {
        if(pos < ob.len) { ob[pos] = tmp[i]; pos = pos + 1; }
        i = i - 1;
    }
    nio_free(tmp);
    return pos;
}

fn fu_add_hex(ob:[]u8, pos:i32, h32:[]u8) i32 {
    let hx:[]u8 = ns_hex(h32);
    if(hx.len == 0) { return pos; }
    pos = fu_add_raw(ob, pos, hx);
    nio_free(hx);
    return pos;
}

// split buf into lines: lmeta arena holds (start,len) u32 pairs.
// returns nlines or -1 on overflow. Strips trailing \r.
fn fu_lines(buf:[]u8, lmeta:[]u8, maxl:i32) i32 {
    let n:i32 = 0;
    let i:i32 = 0;
    let ls:i32 = 0;
    while(i <= buf.len) {
        let eol:i32 = 0;
        if(i == buf.len) { eol = 1; }
        if(eol == 0 && buf[i] == 10) { eol = 1; }
        if(eol == 1) {
            let le:i32 = i;
            if(le > ls && buf[le-1] == 13) { le = le - 1; }
            if(n >= maxl) { return -1; }
            fu_put32(lmeta, n*2, ls);
            fu_put32(lmeta, n*2+1, le - ls);
            n = n + 1;
            ls = i + 1;
        }
        i = i + 1;
    }
    return n;
}

fn fu_line_start(lmeta:[]u8, i:i32) i32 { return fu_get32(lmeta, i*2); }
fn fu_line_len(lmeta:[]u8, i:i32) i32 { return fu_get32(lmeta, i*2+1); }

// write the whole buffer to fd 1 in chunks.
fn fu_emit(ob:[]u8, len:i32) void {
    let i:i32 = 0;
    while(i < len) {
        let n:i32 = len - i;
        if(n > 8192) { n = 8192; }
        let chunk:[]u8 = ob[i..i+n];
        _zag_raw_syscall(1, 1, _zag_slice_ptr(chunk) as i64, n as i64, 0, 0, 0);
        i = i + n;
    }
}

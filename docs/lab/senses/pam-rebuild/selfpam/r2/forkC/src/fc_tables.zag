// fc_tables.zag — frozen normalization tables for fork C.
// Verbatim from the frozen fork prereg §2. Tables are "\n"-separated
// lists (ft_member) or "key=value\n" maps (ft_lookup). Zero RNG.

fn ft_stop_table() []u8 {
    return "the\na\nan\nthis\nthat\nthese\nthose\nof\nto\nfor\nwith\nas\nat\nand\nor\nbut\n";
}

// P3-only strip set: STOP words not already consumed by P1 (aux),
// P2 (by), det-skip, or structurally retained (be-aux, a/an).
fn ft_stop2_table() []u8 {
    return "of\nto\nfor\nwith\nas\nat\nand\nor\nbut\n";
}

fn ft_aux_table() []u8 {
    return "do\ndoes\ndid\nbe\nbeen\nbeing\n";
}

fn ft_be_table() []u8 {
    return "is\nare\nwas\nwere\n";
}

fn ft_det_table() []u8 {
    return "the\na\nan\nthis\nthat\nthese\nthose\n";
}

fn ft_quant_table() []u8 {
    return "all\nsome\nmany\nfew\nno\n";
}

fn ft_neg_table() []u8 {
    return "not\nnever\n";
}

fn ft_prep_table() []u8 {
    return "on=LOCATED_ON\nunder=LOCATED_UNDER\nabove=LOCATED_ABOVE\nbelow=LOCATED_BELOW\nin=LOCATED_IN\nnear=LOCATED_NEAR\nbeside=LOCATED_BESIDE\nbehind=LOCATED_BEHIND\n";
}

fn ft_verb_table() []u8 {
    return "has=HAS\nowns=OWNS\npossesses=OWNS\nbuilt=BUILT\nconstructed=BUILT\nwrote=WROTE\nauthored=WROTE\ncontains=CONTAINS\npainted=PAINTED\ndepicted=PAINTED\nleads=LEADS\nvisited=VISITED\nmade=MADE\ncreated=MADE\n";
}

fn ft_part_table() []u8 {
    return "built=BUILT\nwritten=WROTE\npainted=PAINTED\nowned=OWNS\npossessed=OWNS\ncontained=CONTAINS\nmade=MADE\ncreated=MADE\nconstructed=BUILT\nauthored=WROTE\ndepicted=PAINTED\nvisited=VISITED\nled=LEADS\n";
}

fn ft_antonym_table() []u8 {
    return "unhappy=happy\nhappy=unhappy\ndead=alive\nalive=dead\nhot=cold\ncold=hot\nbig=small\nsmall=big\nfast=slow\nslow=fast\ntrue=false\nfalse=true\nopen=closed\nclosed=open\nempty=full\nfull=empty\nlight=dark\ndark=light\nearly=late\nlate=early\nclean=dirty\ndirty=clean\nrich=poor\npoor=rich\n";
}

fn ft_entsyn_table() []u8 {
    return "kitty=cat\npuppy=dog\nautomobile=car\nbike=bicycle\nbunny=rabbit\nsofa=couch\nfridge=refrigerator\nphone=telephone\n";
}

fn ft_num_table() []u8 {
    return "one=1\ntwo=2\nthree=3\nfour=4\nfive=5\nsix=6\nseven=7\neight=8\nnine=9\nten=10\neleven=11\ntwelve=12\nhalf=1/2\nquarter=1/4\ndozen=12\n50%=1/2\n25%=1/4\n75%=3/4\n";
}

fn ft_num2_table() []u8 {
    return "50 percent=1/2\n25 percent=1/4\n75 percent=3/4\n";
}

fn ft_contraction_table() []u8 {
    return "dont=do not\ndoesnt=does not\ndidnt=did not\ncant=can not\nwont=will not\nisnt=is not\narent=are not\nwasnt=was not\nwerent=were not\nhasnt=has not\nhavent=have not\ncouldnt=could not\nshouldnt=should not\n";
}

fn ft_pron_sg_table() []u8 {
    return "it\nits\nhe\nhim\nhis\nshe\nher\n";
}

fn ft_pron_pl_table() []u8 {
    return "they\nthem\ntheir\n";
}

fn ft_plural_table() []u8 {
    return "cats\ndogs\nbirds\nrabbits\ncars\nboxes\n";
}

// ft_member: 1 if key is a line in the "\n"-separated table.
fn ft_member(table:[]u8, key:[]u8) i32 {
    let i:i32 = 0;
    while(i < table.len) {
        let ks:i32 = i;
        while(i < table.len && table[i] != 10) { i = i + 1; }
        let kl:i32 = i - ks;
        if(i < table.len) { i = i + 1; }
        if(kl == key.len && kl > 0) {
            if(nio_equal(table[ks..ks+kl], key) == 1) { return 1; }
        }
    }
    return 0;
}

// ft_lookup: value for key in "key=value\n" table, or "" if absent.
fn ft_lookup(table:[]u8, key:[]u8) []u8 {
    let i:i32 = 0;
    while(i < table.len) {
        let ks:i32 = i;
        while(i < table.len && table[i] != 61 && table[i] != 10) { i = i + 1; }
        if(i >= table.len || table[i] != 61) {
            while(i < table.len && table[i] != 10) { i = i + 1; }
            if(i < table.len) { i = i + 1; }
            continue;
        }
        let kl:i32 = i - ks;
        i = i + 1;
        let vs:i32 = i;
        while(i < table.len && table[i] != 10) { i = i + 1; }
        let vl:i32 = i - vs;
        if(i < table.len) { i = i + 1; }
        if(kl == key.len && kl > 0) {
            if(nio_equal(table[ks..ks+kl], key) == 1) {
                return table[vs..vs+vl];
            }
        }
    }
    return "";
}

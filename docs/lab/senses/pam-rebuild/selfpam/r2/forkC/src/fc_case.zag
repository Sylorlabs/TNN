// fc_case.zag — case-file parser and verdict engine.
// Returns an encoded result for the battery:
//   ret = ((bar*2 + ispair)*2 + ok)*2 + iscatch ; bar 1..6.

// find "KEY:" line; returns value slice (may be empty) or "" if missing.
fn fc_field(text:[]u8, key:[]u8) []u8 {
    let lm:[]u8 = nio_alloc(64*8);
    if(lm.len == 0) { return ""; }
    let nl:i32 = fu_lines(text, lm, 64);
    if(nl < 0) { nio_free(lm); return ""; }
    let i:i32 = 0;
    while(i < nl) {
        let ls:i32 = fu_line_start(lm, i);
        let ll:i32 = fu_line_len(lm, i);
        let line:[]u8 = text[ls..ls+ll];
        if(line.len > key.len + 1 && line[key.len] == 58) {
            if(nio_equal(line[0..key.len], key) == 1) {
                let v:[]u8 = line[key.len+1..ll];
                if(v.len > 0 && v[0] == 32) { v = v[1..v.len]; }
                nio_free(lm);
                return v;
            }
        }
        i = i + 1;
    }
    nio_free(lm);
    return "";
}

fn fc_bar_idx(bar:[]u8) i32 {
    if(_zag_strcmp(bar, "m1") == 1) { return 1; }
    if(_zag_strcmp(bar, "m2") == 1) { return 2; }
    if(_zag_strcmp(bar, "m3") == 1) { return 3; }
    if(_zag_strcmp(bar, "m4") == 1) { return 4; }
    if(_zag_strcmp(bar, "m5") == 1) { return 5; }
    if(_zag_strcmp(bar, "m6") == 1) { return 6; }
    return 0;
}

// ENTCTX "e1,e2,e3" -> ctxbuf \n-joined; returns ctxn.
fn fc_parse_ctx(s:[]u8, ctxbuf:[]u8) i32 {
    let n:i32 = 0;
    let p:i32 = 0;
    let i:i32 = 0;
    let cs:i32 = 0;
    while(i <= s.len) {
        let cut:i32 = 0;
        if(i == s.len) { cut = 1; }
        if(cut == 0 && s[i] == 44) { cut = 1; }
        if(cut == 1) {
            let a:i32 = cs;
            let b:i32 = i;
            while(a < b && s[a] == 32) { a = a + 1; }
            while(b > a && s[b-1] == 32) { b = b - 1; }
            if(b > a) {
                p = fn_copy(ctxbuf, p, s[a..b]);
                ctxbuf[p] = 10;
                p = p + 1;
                n = n + 1;
            }
            cs = i + 1;
        }
        i = i + 1;
    }
    return n;
}

// verdict for one draft. Writes the VERDICT line, returns
// sig = code*2+has_unlicensed_detail packed with first-unlicensed atom:
// out: sig_code (0=INSTALL,1=WITHHOLD), sig_atom (first unlicensed atom or "")
fn fc_draft_verdict(draft:[]u8, ctx:[]u8, ctxn:i32, caseid:[]u8,
                    ids:[]u8, idm:[]u8,
                    lhash:[]u8, lkind:[]u8, lref:[]u8, lprov:[]u8, nlic:[]u8,
                    out:[]u8, pos:i32, sig:[]u8) i32 {
    let abuf:[]u8 = nio_alloc(2048);
    let ameta:[]u8 = nio_alloc(8*8);
    let mfp:[]u8 = nio_alloc(64);
    let sfp:[]u8 = nio_alloc(64);
    if(abuf.len == 0 || ameta.len == 0 || mfp.len == 0 || sfp.len == 0) {
        nio_free(abuf); nio_free(ameta); nio_free(mfp); nio_free(sfp);
        return pos;
    }
    let na:i32 = fn_atomize(draft, ctx, ctxn, abuf, ameta);
    let code:i32 = 1; // WITHHOLD default
    let lic:[]u8 = nio_alloc(1024);
    let firstbad:[]u8 = nio_alloc(256);
    let fbl:i32 = 0;
    if(lic.len == 0 || firstbad.len == 0) {
        nio_free(abuf); nio_free(ameta); nio_free(mfp); nio_free(sfp);
        nio_free(lic); nio_free(firstbad);
        return pos;
    }
    if(na > 0) {
        fn_sort_atoms(abuf, ameta, na);
        if(fn_fingerprints(draft, ctx, ctxn, mfp, sfp) != 0) {
            // fingerprint failure -> withhold, mark unparsed
            na = -1;
        }
    }
    if(na > 0) {
        code = 0;
        let lp:i32 = 0;
        let a:i32 = 0;
        while(a < na) {
            let s:i32 = fu_get32(ameta, a*2);
            let l:i32 = fu_get32(ameta, a*2+1);
            let hx:[]u8 = nio_alloc(64);
            let hit:i32 = -1;
            if(hx.len != 0) {
                if(fn_atom_hash(abuf[s..s+l], hx) == 0) {
                    hit = fs_match(lhash, nlic, hx);
                }
                nio_free(hx);
            }
            if(a > 0) { lp = fn_copy(lic, lp, ","); }
            if(hit < 0) {
                code = 1;
                lp = fn_copy(lic, lp, "UNLICENSED");
                if(fbl == 0) { fbl = fn_copy(firstbad, 0, abuf[s..s+l]); }
            } else {
                let kind:i32 = lkind[hit] as i32;
                let rf:i32 = fu_get32(lref, hit);
                if(kind == 0) {
                    lp = fn_copy(lic, lp, "STORE:");
                    lp = fn_copy(lic, lp, fs_entry_id(ids, idm, rf));
                    if(lprov[hit] == 1) { lp = fn_copy(lic, lp, ":GEN"); }
                } else {
                    lp = fn_copy(lic, lp, "DELIB:");
                    let nb:[]u8 = nio_alloc(16);
                    if(nb.len != 0) {
                        let np:i32 = fu_add_i64(nb, 0, rf as i64);
                        lp = fn_copy(lic, lp, nb[0..np]);
                        nio_free(nb);
                    }
                }
            }
            a = a + 1;
        }
        pos = fu_add_raw(out, pos, "VERDICT ");
        pos = fu_add_raw(out, pos, caseid);
        if(code == 0) { pos = fu_add_raw(out, pos, " INSTALL "); }
        else { pos = fu_add_raw(out, pos, " WITHHOLD "); }
        pos = fu_add_raw(out, pos, "mfp=");
        pos = fu_add_raw(out, pos, mfp);
        pos = fu_add_raw(out, pos, " sfp=");
        pos = fu_add_raw(out, pos, sfp);
        pos = fu_add_raw(out, pos, " atoms=");
        pos = fu_add_i64(out, pos, na as i64);
        pos = fu_add_raw(out, pos, " lic=");
        pos = fu_add_raw(out, pos, lic[0..lp]);
        pos = fu_add_raw(out, pos, "\n");
    } else {
        pos = fu_add_raw(out, pos, "VERDICT ");
        pos = fu_add_raw(out, pos, caseid);
        pos = fu_add_raw(out, pos, " WITHHOLD mfp=UNPARSED sfp=- atoms=0 lic=UNPARSED\n");
    }
    fu_put32(sig, 0, code);
    fu_put32(sig, 1, fbl);
    // stash first-bad atom bytes into sig area 8..264
    if(fbl > 0) {
        let i:i32 = 0;
        while(i < fbl) { sig[8+i] = firstbad[i]; i = i + 1; }
    }
    nio_free(abuf); nio_free(ameta); nio_free(mfp); nio_free(sfp);
    nio_free(lic); nio_free(firstbad);
    return pos;
}

// run one case file. returns encoded result; writes new pos to posout@0.
fn fc_run_case(ctext:[]u8,
               ids:[]u8, idm:[]u8,
               lhash:[]u8, lkind:[]u8, lref:[]u8, lprov:[]u8, nlic:[]u8,
               store_nlic:i32,
               out:[]u8, pos:i32, posout:[]u8) i32 {
    let caseid:[]u8 = fc_field(ctext, "CASE");
    let bar:[]u8 = fc_field(ctext, "BAR");
    let expect:[]u8 = fc_field(ctext, "EXPECT");
    let delib:[]u8 = fc_field(ctext, "DELIB");
    let ctxs:[]u8 = fc_field(ctext, "ENTCTX");
    let baridx:i32 = fc_bar_idx(bar);
    let ctxbuf:[]u8 = nio_alloc(1024);
    if(ctxbuf.len == 0) { return 0; }
    let ctxn:i32 = fc_parse_ctx(ctxs, ctxbuf);
    // add this case's deliberation licenses on top of the store licenses
    fs_add_delib(delib, ctxbuf, ctxn, lhash, lkind, lref, lprov, nlic, store_nlic);
    let ispair:i32 = 0;
    let ok:i32 = 0;
    let iscatch:i32 = 0;
    let da:[]u8 = fc_field(ctext, "A");
    if(da.len > 0) {
        ispair = 1;
        let db:[]u8 = fc_field(ctext, "B");
        let siga:[]u8 = nio_alloc(272);
        let sigb:[]u8 = nio_alloc(272);
        if(siga.len == 0 || sigb.len == 0) {
            nio_free(ctxbuf); nio_free(siga); nio_free(sigb);
            return 0;
        }
        pos = fc_draft_verdict(da, ctxbuf, ctxn, caseid, ids, idm,
                               lhash, lkind, lref, lprov, nlic, out, pos, siga);
        // B verdict line: reuse caseid with suffix
        let cidb:[]u8 = nio_alloc(128);
        if(cidb.len == 0) {
            nio_free(ctxbuf); nio_free(siga); nio_free(sigb);
            return 0;
        }
        let cp:i32 = fn_copy(cidb, 0, caseid);
        cp = fn_copy(cidb, cp, "/B");
        // emit A-line tag fix: first line said caseid; keep as-is, B line distinct
        pos = fc_draft_verdict(db, ctxbuf, ctxn, cidb[0..cp], ids, idm,
                               lhash, lkind, lref, lprov, nlic, out, pos, sigb);
        nio_free(cidb);
        let ca:i32 = fu_get32(siga, 0);
        let cb:i32 = fu_get32(sigb, 0);
        let la:i32 = fu_get32(siga, 1);
        let lb:i32 = fu_get32(sigb, 1);
        let same:i32 = 1;
        if(ca != cb) { same = 0; }
        if(la != lb) { same = 0; }
        if(same == 1 && la > 0) {
            if(nio_equal(siga[8..8+la], sigb[8..8+lb]) != 1) { same = 0; }
        }
        let got:[]u8 = "DIVERGE";
        if(same == 1) { got = "SAME"; }
        if(_zag_strcmp(expect, got) == 1) { ok = 1; }
        pos = fu_add_raw(out, pos, "PAIR ");
        pos = fu_add_raw(out, pos, caseid);
        pos = fu_add_raw(out, pos, " ");
        pos = fu_add_raw(out, pos, got);
        pos = fu_add_raw(out, pos, " expect=");
        pos = fu_add_raw(out, pos, expect);
        pos = fu_add_raw(out, pos, "\n");
        nio_free(siga);
        nio_free(sigb);
    } else {
        let draft:[]u8 = fc_field(ctext, "DRAFT");
        let sg:[]u8 = nio_alloc(272);
        if(sg.len == 0) { nio_free(ctxbuf); return 0; }
        let p0:i32 = pos;
        pos = fc_draft_verdict(draft, ctxbuf, ctxn, caseid, ids, idm,
                               lhash, lkind, lref, lprov, nlic, out, pos, sg);
        let code:i32 = fu_get32(sg, 0);
        nio_free(sg);
        // verdict ok iff (WITHHOLD == EXPECT WITHHOLD)
        let expw:i32 = 0;
        if(_zag_strcmp(expect, "WITHHOLD") == 1) { expw = 1; iscatch = 1; }
        if(code == expw) { ok = 1; }
    }
    nio_free(ctxbuf);
    // restore license count to store-only for the next case
    fu_put32(nlic, 0, store_nlic);
    fu_put32(posout, 0, pos);
    let ret:i32 = baridx;
    ret = ret*2 + ispair;
    ret = ret*2 + ok;
    ret = ret*2 + iscatch;
    return ret;
}

// fc_main.zag — fork C driver.
//   forkc case <store.txt> <case.txt>        single-case probe
//   forkc battery <store.txt> <manifest.txt> full battery + SUMMARY + DIGEST
// Zero RNG. Deterministic: manifest order, table order, store order.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("fc_tables.zag")
@import("fc_util.zag")
@import("fc_norm.zag")
@import("fc_store.zag")
@import("fc_case.zag")

fn fm_read_file(path:[]u8) []u8 {
    let cp:[]u8 = nio_cstr(path);
    if(cp.len == 0) { return ""; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cp) as i64, 0, 0, 0, 0, 0);
    nio_free(cp);
    if(fd < 0) { return ""; }
    let out:[]u8 = nio_alloc(1048576);
    if(out.len == 0) {
        _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
        return "";
    }
    let n:i64 = nio_read_exact(fd, out, 1048576);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    if(n <= 0) { return ""; }
    let ni:i32 = n as i32;
    let exact:[]u8 = nio_alloc(ni + 1);
    if(exact.len == 0) { return ""; }
    let i:i32 = 0;
    while(i < ni) { exact[i] = out[i]; i = i + 1; }
    nio_free(out);
    return exact[0..ni];
}

// stats arenas: stn[7], stok[7]; m1 split counters in cm arena:
// cm@0 catch_n, cm@4 catch_ok, cm@8 gold_n, cm@12 gold_ok
fn fm_accum(ret:i32, stn:[]u8, stok:[]u8, cm:[]u8) void {
    let iscatch:i32 = ret % 2;
    ret = ret / 2;
    let ok:i32 = ret % 2;
    ret = ret / 2;
    let ispair:i32 = ret % 2;
    ret = ret / 2;
    let bar:i32 = ret;
    if(bar < 1 || bar > 6) { return; }
    fu_put32(stn, bar, fu_get32(stn, bar) + 1);
    if(ok == 1) { fu_put32(stok, bar, fu_get32(stok, bar) + 1); }
    if(bar == 1 && ispair == 0) {
        if(iscatch == 1) {
            fu_put32(cm, 0, fu_get32(cm, 0) + 1);
            if(ok == 1) { fu_put32(cm, 1, fu_get32(cm, 1) + 1); }
        } else {
            fu_put32(cm, 2, fu_get32(cm, 2) + 1);
            if(ok == 1) { fu_put32(cm, 3, fu_get32(cm, 3) + 1); }
        }
    }
}

fn fm_pass(bar:i32, n:i32, ok:i32, cm:[]u8) i32 {
    if(bar == 1) {
        let cn:i32 = fu_get32(cm, 0);
        let cok:i32 = fu_get32(cm, 1);
        let gn:i32 = fu_get32(cm, 2);
        let gok:i32 = fu_get32(cm, 3);
        if(cn == 0 || gn == 0) { return 0; }
        if(cok*100 < 70*cn) { return 0; }
        if((gn - gok)*100 > 8*gn) { return 0; }
        return 1;
    }
    if(n == 0) { return 0; }
    if(bar == 2) { if(ok*100 >= 90*n) { return 1; } return 0; }
    if(bar == 3) { if(ok*100 >= 95*n) { return 1; } return 0; }
    if(bar == 4) { if(ok*100 >= 70*n) { return 1; } return 0; }
    if(bar == 5) { if(ok*100 >= 70*n) { return 1; } return 0; }
    if(bar == 6) { if((n - ok)*100 <= 5*n) { return 1; } return 0; }
    return 0;
}

fn fm_summary(out:[]u8, pos:i32, stn:[]u8, stok:[]u8, cm:[]u8) i32 {
    let b:i32 = 1;
    while(b <= 6) {
        let n:i32 = fu_get32(stn, b);
        let ok:i32 = fu_get32(stok, b);
        let p:i32 = fm_pass(b, n, ok, cm);
        pos = fu_add_raw(out, pos, "SUMMARY bar=m");
        pos = fu_add_i64(out, pos, b as i64);
        if(b == 1) {
            pos = fu_add_raw(out, pos, " catch=");
            pos = fu_add_i64(out, pos, fu_get32(cm, 0) as i64);
            pos = fu_add_raw(out, pos, " catch_ok=");
            pos = fu_add_i64(out, pos, fu_get32(cm, 1) as i64);
            pos = fu_add_raw(out, pos, " gold=");
            pos = fu_add_i64(out, pos, fu_get32(cm, 2) as i64);
            pos = fu_add_raw(out, pos, " gold_ok=");
            pos = fu_add_i64(out, pos, fu_get32(cm, 3) as i64);
        } else {
            if(b == 2 || b == 3) { pos = fu_add_raw(out, pos, " pairs="); }
            else { pos = fu_add_raw(out, pos, " n="); }
            pos = fu_add_i64(out, pos, n as i64);
            pos = fu_add_raw(out, pos, " ok=");
            pos = fu_add_i64(out, pos, ok as i64);
        }
        pos = fu_add_raw(out, pos, " pass=");
        pos = fu_add_i64(out, pos, p as i64);
        pos = fu_add_raw(out, pos, "\n");
        b = b + 1;
    }
    return pos;
}

fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    let is_case:i32 = 0;
    let is_bat:i32 = 0;
    if(_zag_strcmp(mode, "case") == 1) { is_case = 1; }
    if(_zag_strcmp(mode, "battery") == 1) { is_bat = 1; }
    if(is_case == 0 && is_bat == 0) {
        _zag_println("usage: forkc case <store> <case> | forkc battery <store> <manifest>");
        return 2;
    }
    let store_text:[]u8 = fm_read_file(_zag_arg(2));
    if(store_text.len == 0) { _zag_println("store read failed"); return 1; }
    let arg3:[]u8 = fm_read_file(_zag_arg(3));
    if(arg3.len == 0) { _zag_println("arg3 read failed"); return 1; }

    let ids:[]u8 = nio_alloc(8192);
    let idm:[]u8 = nio_alloc(256*8);
    let eprov:[]u8 = nio_alloc(256);
    let lhash:[]u8 = nio_alloc(512*64);
    let lkind:[]u8 = nio_alloc(512);
    let lref:[]u8 = nio_alloc(512*4);
    let lprov:[]u8 = nio_alloc(512);
    let nent:[]u8 = nio_alloc(8);
    let nlic:[]u8 = nio_alloc(8);
    let posout:[]u8 = nio_alloc(8);
    let out:[]u8 = nio_alloc(1048576);
    if(ids.len == 0 || idm.len == 0 || eprov.len == 0 || lhash.len == 0 ||
       lkind.len == 0 || lref.len == 0 || lprov.len == 0 ||
       nent.len == 0 || nlic.len == 0 || posout.len == 0 || out.len == 0) {
        _zag_println("alloc failed");
        return 1;
    }
    if(fs_load(store_text, ids, idm, eprov, lhash, lkind, lref, lprov,
               nent, nlic, 256) != 0) {
        _zag_println("store load failed");
        return 1;
    }
    let store_nlic:i32 = fu_get32(nlic, 0);
    let pos:i32 = 0;

    if(is_case == 1) {
        fc_run_case(arg3, ids, idm, lhash, lkind, lref, lprov, nlic,
                    store_nlic, out, pos, posout);
        pos = fu_get32(posout, 0);
        fu_emit(out, pos);
        return 0;
    }

    // battery mode
    let stn:[]u8 = nio_alloc(7*4);
    let stok:[]u8 = nio_alloc(7*4);
    let cm:[]u8 = nio_alloc(4*4);
    if(stn.len == 0 || stok.len == 0 || cm.len == 0) { return 1; }
    let mm:[]u8 = nio_alloc(1024*8);
    if(mm.len == 0) { return 1; }
    let nl:i32 = fu_lines(arg3, mm, 1024);
    if(nl < 0) { return 1; }
    let i:i32 = 0;
    while(i < nl) {
        let ls:i32 = fu_line_start(mm, i);
        let ll:i32 = fu_line_len(mm, i);
        i = i + 1;
        if(ll == 0) { continue; }
        let cpath:[]u8 = arg3[ls..ls+ll];
        if(cpath[0] == 35) { continue; }
        let ctext:[]u8 = fm_read_file(cpath);
        if(ctext.len == 0) {
            pos = fu_add_raw(out, pos, "CASE_READ_FAILED ");
            pos = fu_add_raw(out, pos, cpath);
            pos = fu_add_raw(out, pos, "\n");
            continue;
        }
        let ret:i32 = fc_run_case(ctext, ids, idm, lhash, lkind, lref, lprov,
                                  nlic, store_nlic, out, pos, posout);
        pos = fu_get32(posout, 0);
        fm_accum(ret, stn, stok, cm);
    }
    pos = fm_summary(out, pos, stn, stok, cm);
    // DIGEST over everything emitted so far
    let draw:[]u8 = nio_alloc(32);
    let dg:[]u8 = nio_alloc(64);
    if(draw.len == 0 || dg.len == 0) { return 1; }
    ns_sha256(out[0..pos], draw);
    let dhx:[]u8 = ns_hex(draw);
    let di:i32 = 0;
    while(di < 64 && di < dhx.len) { dg[di] = dhx[di]; di = di + 1; }
    pos = fu_add_raw(out, pos, "DIGEST ");
    pos = fu_add_raw(out, pos, dg);
    pos = fu_add_raw(out, pos, "\n");
    fu_emit(out, pos);
    return 0;
}

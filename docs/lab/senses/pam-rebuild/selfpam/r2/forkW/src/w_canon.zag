// w_canon.zag — frozen canonicalization.
// lowercase; `not X` -> ANT[X] if present else `not-`+X;
// word-wise SYN then NUM mapping (split on non-alnum except `%`).

// lowercase a raw slice into work buffer; return packed span (work-relative)
fn cn_lower_raw(a:[]u8, src:[]u8, off:i64, len:i64) i64 {
    let w:i64 = wk_alloc(a, len);
    let i:i64 = 0;
    while (i < len) {
        let c:i64 = src[off+i] as i64;
        if (c >= 65 && c <= 90) { c = c + 32; }
        a[L_WORK()+w+i] = c as u8;
        i = i + 1;
    }
    return w * 4294967296 + len;
}

// lowercase a pooled string; return new sid
fn cn_lower(a:[]u8, sid:i64) i64 {
    let p:i64 = cn_lower_raw(a, a, L_POOL()+sp_off(a,sid), sp_len(a,sid));
    return sp_add(a, a, L_WORK()+pk_off(p), pk_len(p));
}

// linear map lookup: table base, count, key sid -> value sid or -1
fn cn_mapget(a:[]u8, base:i64, n:i64, key:i64) i64 {
    let i:i64 = 0;
    while (i < n) {
        if (sp_eq(a, u_g64(a, base+i*16), key) == 1) {
            return u_g64(a, base+i*16+8);
        }
        i = i + 1;
    }
    return -1;
}
fn cn_syn(a:[]u8, sid:i64) i64 {
    let v:i64 = cn_mapget(a, L_SYN(), u_hget(a, H_NSYN()), sid);
    if (v >= 0) { return v; }
    return sid;
}
fn cn_num(a:[]u8, sid:i64) i64 {
    let v:i64 = cn_mapget(a, L_NUM(), u_hget(a, H_NNUM()), sid);
    if (v >= 0) { return v; }
    return sid;
}
fn cn_ant(a:[]u8, sid:i64) i64 {
    return cn_mapget(a, L_ANT(), u_hget(a, H_NANT()), sid);
}
// word-wise: SYN then NUM on whole; else split on '-' and map parts
fn cn_word(a:[]u8, sid:i64) i64 {
    let s:i64 = cn_syn(a, sid);
    if (s != sid) { return s; }
    let n:i64 = cn_num(a, sid);
    if (n != sid) { return n; }
    // split on '-' (45), map parts, rejoin with '-'
    let ln:i64 = sp_len(a, sid);
    let has:i64 = 0;
    let i:i64 = 0;
    while (i < ln) {
        if (sp_byte(a, sid, i) == 45) { has = 1; }
        i = i + 1;
    }
    if (has == 0) { return sid; }
    let w:i64 = wk_alloc(a, ln);
    let o:i64 = 0;
    let st:i64 = 0;
    i = 0;
    while (i <= ln) {
        if (i == ln || sp_byte(a, sid, i) == 45) {
            // part [st, i)
            let pw:i64 = wk_alloc(a, i - st);
            let k:i64 = st;
            while (k < i) {
                a[L_WORK()+pw+(k-st)] = sp_byte(a, sid, k) as u8;
                k = k + 1;
            }
            let psid:i64 = sp_add(a, a, L_WORK()+pw, i - st);
            psid = cn_syn(a, psid);
            psid = cn_num(a, psid);
            let pl:i64 = sp_len(a, psid);
            let so:i64 = L_POOL() + sp_off(a, psid);
            k = 0;
            while (k < pl) {
                a[L_WORK()+w+o] = a[so+k];
                o = o + 1;
                k = k + 1;
            }
            if (i < ln) {
                a[L_WORK()+w+o] = 45;
                o = o + 1;
            }
            st = i + 1;
        }
        i = i + 1;
    }
    return sp_add(a, a, L_WORK()+w, o);
}

// split pooled string on byte delim; returns count, pieces as sids in work list
// writes sids to work area at wlist (caller-allocated, 32 slots)
fn cn_split(a:[]u8, sid:i64, delim:i64, wlist:i64) i64 {
    let ln:i64 = sp_len(a, sid);
    let n:i64 = 0;
    let st:i64 = 0;
    let i:i64 = 0;
    while (i <= ln) {
        if (i == ln || sp_byte(a, sid, i) == delim) {
            let pw:i64 = wk_alloc(a, i - st);
            let k:i64 = st;
            while (k < i) {
                a[L_WORK()+pw+(k-st)] = sp_byte(a, sid, k) as u8;
                k = k + 1;
            }
            let psid:i64 = sp_add(a, a, L_WORK()+pw, i - st);
            u_p64(a, L_WORK()+wlist+n*8, psid);
            n = n + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    return n;
}
fn cn_wlist_get(a:[]u8, wlist:i64, i:i64) i64 {
    return u_g64(a, L_WORK()+wlist+i*8);
}

// canonicalize a label: head(arg1,arg2) | head(arg) | head
fn cn_label(a:[]u8, sid:i64) i64 {
    let low:i64 = cn_lower(a, sid);
    let ln:i64 = sp_len(a, low);
    // find '('
    let par:i64 = -1;
    let i:i64 = 0;
    while (i < ln) {
        if (sp_byte(a, low, i) == 40) { par = i; }
        i = i + 1;
    }
    let head:i64 = low;
    let nargs:i64 = 0;
    let arg0:i64 = -1;
    let arg1:i64 = -1;
    if (par >= 0) {
        // head = [0, par)
        let hw:i64 = wk_alloc(a, par);
        i = 0;
        while (i < par) {
            a[L_WORK()+hw+i] = sp_byte(a, low, i) as u8;
            i = i + 1;
        }
        head = sp_add(a, a, L_WORK()+hw, par);
        // args inside (par, ln-1)
        let wlist:i64 = wk_alloc(a, 32*8);
        // build inner span sid
        let iw:i64 = wk_alloc(a, ln-par-2);
        i = par+1;
        while (i < ln-1) {
            a[L_WORK()+iw+(i-par-1)] = sp_byte(a, low, i) as u8;
            i = i + 1;
        }
        let inner:i64 = sp_add(a, a, L_WORK()+iw, ln-par-2);
        nargs = cn_split(a, inner, 44, wlist);
        if (nargs > 0) { arg0 = cn_word(a, cn_wlist_get(a, wlist, 0)); }
        if (nargs > 1) { arg1 = cn_word(a, cn_wlist_get(a, wlist, 1)); }
        // stash wlist for later? args already canonicalized; drop list
    }
    // head: not-rule on '-' split, then whole SYN/NUM, else part-wise
    let wlist2:i64 = wk_alloc(a, 32*8);
    let nh:i64 = cn_split(a, head, 45, wlist2);
    let ch:i64 = head;
    if (nh == 2) {
        let p0:i64 = cn_wlist_get(a, wlist2, 0);
        // check p0 == "not" via raw bytes
        if (sp_len(a, p0) == 3 && sp_byte(a, p0, 0) == 110 && sp_byte(a, p0, 1) == 111 && sp_byte(a, p0, 2) == 116) {
            let x:i64 = cn_wlist_get(a, wlist2, 1);
            let av:i64 = cn_ant(a, x);
            if (av >= 0) {
                ch = av;
            } else {
                // "not-" + x
                let xl:i64 = sp_len(a, x);
                let bw:i64 = wk_alloc(a, 4 + xl);
                a[L_WORK()+bw] = 110; a[L_WORK()+bw+1] = 111;
                a[L_WORK()+bw+2] = 116; a[L_WORK()+bw+3] = 45;
                let so:i64 = L_POOL() + sp_off(a, x);
                i = 0;
                while (i < xl) {
                    a[L_WORK()+bw+4+i] = a[so+i];
                    i = i + 1;
                }
                ch = sp_add(a, a, L_WORK()+bw, 4+xl);
            }
        }
    }
    ch = cn_word(a, ch);
    // reassemble
    let w:i64 = wk_alloc(a, 256);
    let o:i64 = 0;
    let chl:i64 = sp_len(a, ch);
    let cso:i64 = L_POOL() + sp_off(a, ch);
    i = 0;
    while (i < chl) {
        a[L_WORK()+w+o] = a[cso+i];
        o = o + 1;
        i = i + 1;
    }
    if (par >= 0) {
        a[L_WORK()+w+o] = 40; o = o + 1;
        let a0l:i64 = sp_len(a, arg0);
        let a0o:i64 = L_POOL() + sp_off(a, arg0);
        i = 0;
        while (i < a0l) {
            a[L_WORK()+w+o] = a[a0o+i];
            o = o + 1;
            i = i + 1;
        }
        if (nargs > 1) {
            a[L_WORK()+w+o] = 44; o = o + 1;
            let a1l:i64 = sp_len(a, arg1);
            let a1o:i64 = L_POOL() + sp_off(a, arg1);
            i = 0;
            while (i < a1l) {
                a[L_WORK()+w+o] = a[a1o+i];
                o = o + 1;
                i = i + 1;
            }
        }
        a[L_WORK()+w+o] = 41; o = o + 1;
    }
    return sp_add(a, a, L_WORK()+w, o);
}

// canonicalize space-separated text (drafts, quotes, F contents)
fn cn_text(a:[]u8, sid:i64) i64 {
    let low:i64 = cn_lower(a, sid);
    let wlist:i64 = wk_alloc(a, 64*8);
    let n:i64 = cn_split(a, low, 32, wlist);
    let out:i64 = wk_alloc(a, 512);
    let o:i64 = 0;
    let i:i64 = 0;
    while (i < n) {
        let w0:i64 = cn_wlist_get(a, wlist, i);
        // not-rule: "not" + next
        if (sp_len(a, w0) == 3 && sp_byte(a, w0, 0) == 110 && sp_byte(a, w0, 1) == 111 && sp_byte(a, w0, 2) == 116 && i+1 < n) {
            let x:i64 = cn_wlist_get(a, wlist, i+1);
            let av:i64 = cn_ant(a, x);
            let rep:i64 = av;
            if (av < 0) {
                let xl:i64 = sp_len(a, x);
                let bw:i64 = wk_alloc(a, 4 + xl);
                a[L_WORK()+bw] = 110; a[L_WORK()+bw+1] = 111;
                a[L_WORK()+bw+2] = 116; a[L_WORK()+bw+3] = 45;
                let so:i64 = L_POOL() + sp_off(a, x);
                let k:i64 = 0;
                while (k < xl) {
                    a[L_WORK()+bw+4+k] = a[so+k];
                    k = k + 1;
                }
                rep = sp_add(a, a, L_WORK()+bw, 4+xl);
            }
            rep = cn_word(a, rep);
            if (o > 0) { a[L_WORK()+out+o] = 32; o = o + 1; }
            let rl:i64 = sp_len(a, rep);
            let ro:i64 = L_POOL() + sp_off(a, rep);
            let k:i64 = 0;
            while (k < rl) {
                a[L_WORK()+out+o] = a[ro+k];
                o = o + 1;
                k = k + 1;
            }
            i = i + 2;
        } else {
            let cw:i64 = cn_word(a, w0);
            if (o > 0) { a[L_WORK()+out+o] = 32; o = o + 1; }
            let cl:i64 = sp_len(a, cw);
            let co:i64 = L_POOL() + sp_off(a, cw);
            let k:i64 = 0;
            while (k < cl) {
                a[L_WORK()+out+o] = a[co+k];
                o = o + 1;
                k = k + 1;
            }
            i = i + 1;
        }
    }
    return sp_add(a, a, L_WORK()+out, o);
}

// dispatch: label-like (has paren) -> cn_label, else cn_text
fn cn_canon(a:[]u8, sid:i64) i64 {
    let ln:i64 = sp_len(a, sid);
    let i:i64 = 0;
    while (i < ln) {
        if (sp_byte(a, sid, i) == 40) { return cn_label(a, sid); }
        i = i + 1;
    }
    return cn_text(a, sid);
}

// canonical head word of an atom label (for pattern wordfeats)
fn cn_headword(a:[]u8, sid:i64) i64 {
    let low:i64 = cn_lower(a, sid);
    let ln:i64 = sp_len(a, low);
    let par:i64 = ln;
    let i:i64 = 0;
    while (i < ln) {
        if (sp_byte(a, low, i) == 40) { par = i; }
        i = i + 1;
    }
    let hw:i64 = wk_alloc(a, par);
    i = 0;
    while (i < par) {
        a[L_WORK()+hw+i] = sp_byte(a, low, i) as u8;
        i = i + 1;
    }
    let hsy:i64 = sp_add(a, a, L_WORK()+hw, par);
    // not-rule then word
    let wlist:i64 = wk_alloc(a, 32*8);
    let nh:i64 = cn_split(a, hsy, 45, wlist);
    let ch:i64 = hsy;
    if (nh == 2) {
        let p0:i64 = cn_wlist_get(a, wlist, 0);
        if (sp_len(a, p0) == 3 && sp_byte(a, p0, 0) == 110 && sp_byte(a, p0, 1) == 111 && sp_byte(a, p0, 2) == 116) {
            let x:i64 = cn_wlist_get(a, wlist, 1);
            let av:i64 = cn_ant(a, x);
            if (av >= 0) { ch = av; }
        }
    }
    return cn_word(a, ch);
}

// parse canonical label into (head_sid, arg0_sid, arg1_sid, nargs) via work list
fn cn_label_parts(a:[]u8, sid:i64, wlist:i64) i64 {
    let c:i64 = cn_label(a, sid);
    let ln:i64 = sp_len(a, c);
    let par:i64 = -1;
    let i:i64 = 0;
    while (i < ln) {
        if (sp_byte(a, c, i) == 40) { par = i; }
        i = i + 1;
    }
    if (par < 0) {
        u_p64(a, L_WORK()+wlist, c);
        u_p64(a, L_WORK()+wlist+8, -1);
        u_p64(a, L_WORK()+wlist+16, -1);
        return 0;
    }
    let hw:i64 = wk_alloc(a, par);
    i = 0;
    while (i < par) {
        a[L_WORK()+hw+i] = sp_byte(a, c, i) as u8;
        i = i + 1;
    }
    u_p64(a, L_WORK()+wlist, sp_add(a, a, L_WORK()+hw, par));
    // args
    let iw:i64 = wk_alloc(a, ln-par-2);
    i = par+1;
    while (i < ln-1) {
        a[L_WORK()+iw+(i-par-1)] = sp_byte(a, c, i) as u8;
        i = i + 1;
    }
    let inner:i64 = sp_add(a, a, L_WORK()+iw, ln-par-2);
    let na:i64 = cn_split(a, inner, 44, wlist+24);
    u_p64(a, L_WORK()+wlist+8, -1);
    u_p64(a, L_WORK()+wlist+16, -1);
    if (na > 0) { u_p64(a, L_WORK()+wlist+8, cn_wlist_get(a, wlist+24, 0)); }
    if (na > 1) { u_p64(a, L_WORK()+wlist+16, cn_wlist_get(a, wlist+24, 1)); }
    return na;
}

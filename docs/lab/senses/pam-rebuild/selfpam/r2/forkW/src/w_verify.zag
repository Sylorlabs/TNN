// w_verify.zag — per-fixture witness verification (prereg section 3).
// Implements the FROZEN rule: coverage failure (step 2) makes every atom
// V_UNGROUNDED/R_COVERAGE_GAP, with no exception for V_HALLUC from input
// resolution. (A proposed amendment A1 would have let HALLUC stand under
// coverage failure, but it was not approved and is not implemented here.)

fn vf_store_by_id(a:[]u8, id:i64) i64 {
    let n:i64 = u_hget(a, H_NSTORE());
    let i:i64 = 0;
    while (i < n) {
        if (u_g64(a, L_STORE()+i*128) == id) { return i; }
        i = i + 1;
    }
    return -1;
}

fn vf_is_stop(a:[]u8, sid:i64) i64 {
    let n:i64 = u_hget(a, H_NSTOP());
    let i:i64 = 0;
    while (i < n) {
        if (sp_eq(a, u_g64(a, L_STOP()+i*8), sid) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// first step (lowest global si) of fixture fi whose outs contain atom rel idx
fn vf_find_step(a:[]u8, fi:i64, rel:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let sb:i64 = u_g64(a, fb+104);
    let ns:i64 = u_g64(a, fb+112);
    let k:i64 = 0;
    while (k < ns) {
        let si:i64 = sb + k;
        let b:i64 = L_STEP() + si*128;
        let no:i64 = u_g64(a, b+8);
        let j:i64 = 0;
        while (j < no) {
            if (u_g64(a, b+16+j*8) == rel) { return si; }
            j = j + 1;
        }
        k = k + 1;
    }
    return -1;
}

// input resolution (3a). packed v*1000000+r*1000+p.
fn vf_resolve(a:[]u8, si:i64) i64 {
    let b:i64 = L_STEP() + si*128;
    let ib:i64 = u_g64(a, b+112);
    let ni:i64 = u_g64(a, b+120);
    let prov:i64 = 0;
    let k:i64 = 0;
    while (k < ni) {
        let ib2:i64 = L_IN() + (ib+k)*32;
        let stid:i64 = u_g64(a, ib2);
        let ep:i64 = u_g64(a, ib2+8);
        let q:i64 = u_g64(a, ib2+16);
        let se:i64 = vf_store_by_id(a, stid);
        if (se < 0) { return 3*1000000 + 4*1000; }
        let sb2:i64 = L_STORE() + se*128;
        if (ep < u_g64(a, sb2+16)) { return 3*1000000 + 4*1000; }
        let cq:i64 = cn_canon(a, q);
        let cc:i64 = cn_canon(a, u_g64(a, sb2+32));
        if (sp_eq(a, cq, cc) == 0) { return 3*1000000 + 5*1000; }
        let au:i64 = u_g64(a, sb2+8);
        if (au > prov) { prov = au; }
        k = k + 1;
    }
    return 0*1000000 + 0*1000 + prov;
}

fn vf_rule_by_name(a:[]u8, nsid:i64) i64 {
    let n:i64 = u_hget(a, H_NRULE());
    let i:i64 = 0;
    while (i < n) {
        if (sp_eq(a, u_g64(a, L_RULE()+i*160), nsid) == 1) { return i; }
        i = i + 1;
    }
    return -1;
}

fn vf_featword(a:[]u8, wsid:i64) i64 {
    let n:i64 = u_hget(a, H_NFEATW());
    let i:i64 = 0;
    while (i < n) {
        if (sp_eq(a, u_g64(a, L_FEAT()+i*160), wsid) == 1) { return i; }
        i = i + 1;
    }
    return -1;
}

// license (3b). ai = global atom idx. packed v*1000000+r*1000+p.
fn vf_license(a:[]u8, fi:i64, si:i64, ai:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let abase:i64 = u_g64(a, fb+88);
    let rel:i64 = ai - abase;
    let ab:i64 = L_ATOM() + ai*64;
    let role:i64 = u_g64(a, ab);
    let lab:i64 = u_g64(a, ab+8);
    let sb:i64 = L_STEP() + si*128;
    let op:i64 = u_g64(a, sb);
    let ni:i64 = u_g64(a, sb+120);
    let ib:i64 = u_g64(a, sb+112);
    // first input entry (resolution already passed)
    let se:i64 = -1;
    let sentry:i64 = 0;
    if (ni > 0) {
        se = vf_store_by_id(a, u_g64(a, L_IN()+(ib)*32));
        sentry = L_STORE() + se*128;
    }
    if (op == 5 || op == 6) {
        return 2*1000000 + 1*1000;
    }
    if (op == 1) {
        if (ni == 0) { return 2*1000000 + 1*1000; }
        if (role < 1 || role > 3) { return 2*1000000 + 6*1000; }
        let ca:i64 = cn_label(a, lab);
        let cc:i64 = cn_canon(a, u_g64(a, sentry+32));
        if (sp_eq(a, ca, cc) == 0) { return 2*1000000 + 5*1000; }
        if (u_g64(a, sentry+24) != role) { return 2*1000000 + 6*1000; }
        let prov:i64 = 0;
        let k:i64 = 0;
        while (k < ni) {
            let e2:i64 = vf_store_by_id(a, u_g64(a, L_IN()+(ib+k)*32));
            let au:i64 = u_g64(a, L_STORE()+e2*128+8);
            if (au > prov) { prov = au; }
            k = k + 1;
        }
        return 1*1000000 + 0*1000 + prov;
    }
    if (op == 2) {
        if (ni == 0) { return 2*1000000 + 1*1000; }
        let ca:i64 = cn_label(a, lab);
        let cc:i64 = cn_canon(a, u_g64(a, sentry+32));
        if (sp_eq(a, ca, cc) == 0) { return 2*1000000 + 5*1000; }
        let prov:i64 = 0;
        let k:i64 = 0;
        while (k < ni) {
            let e2:i64 = vf_store_by_id(a, u_g64(a, L_IN()+(ib+k)*32));
            let au:i64 = u_g64(a, L_STORE()+e2*128+8);
            if (au > prov) { prov = au; }
            k = k + 1;
        }
        return 1*1000000 + 0*1000 + prov;
    }
    if (op == 3) {
        if (role != 1) { return 2*1000000 + 6*1000; }
        if (ni == 0) { return 2*1000000 + 1*1000; }
        let hw:i64 = cn_headword(a, lab);
        let wi:i64 = vf_featword(a, hw);
        let nw:i64 = 0;
        if (wi >= 0) { nw = u_g64(a, L_FEAT()+wi*160+8); }
        // entry feats
        let nf:i64 = u_g64(a, sentry+40);
        let inter:i64 = 0;
        let j:i64 = 0;
        while (j < nf) {
            let f:i64 = u_g64(a, sentry+48+j*8);
            let k:i64 = 0;
            while (k < nw) {
                if (sp_eq(a, f, u_g64(a, L_FEAT()+wi*160+16+k*8)) == 1) {
                    inter = inter + 1;
                    k = nw;
                }
                k = k + 1;
            }
            j = j + 1;
        }
        let ov:i64 = 0;
        if (nw > 0) { ov = (100 * inter) / nw; }
        let decl:i64 = u_g64(a, sb+96);
        if (ov != decl) { return 2*1000000 + 7*1000; }
        if (ov < 80 || u_g64(a, sb+104) != 1) { return 2*1000000 + 2*1000; }
        let prov:i64 = 0;
        let k:i64 = 0;
        while (k < ni) {
            let e2:i64 = vf_store_by_id(a, u_g64(a, L_IN()+(ib+k)*32));
            let au:i64 = u_g64(a, L_STORE()+e2*128+8);
            if (au > prov) { prov = au; }
            k = k + 1;
        }
        return 1*1000000 + 0*1000 + prov;
    }
    if (op == 4) {
        let rsid:i64 = u_g64(a, sb+88);
        let ri:i64 = -1;
        if (rsid >= 0) { ri = vf_rule_by_name(a, rsid); }
        if (ri < 0) { return 2*1000000 + 1*1000; }
        let rb:i64 = L_RULE() + ri*160;
        let nrp:i64 = u_g64(a, rb+8);
        let sb_prem_n:i64 = u_g64(a, sb+48);
        if (nrp != sb_prem_n) { return 2*1000000 + 1*1000; }
        // conclusion = outs[0]
        let nout:i64 = u_g64(a, sb+8);
        if (nout < 1) { return 2*1000000 + 1*1000; }
        let concl_ai:i64 = abase + u_g64(a, sb+16);
        let concl_role:i64 = u_g64(a, L_ATOM()+concl_ai*64);
        if (concl_role != u_g64(a, rb+32)) { return 2*1000000 + 1*1000; }
        let pprov:i64 = 0;
        let j:i64 = 0;
        while (j < nrp) {
            let pai:i64 = abase + u_g64(a, sb+56+j*8);
            let prole:i64 = u_g64(a, L_ATOM()+pai*64);
            let want:i64 = u_g64(a, rb+16+j*8);
            if (prole != want) { return 2*1000000 + 1*1000; }
            if (u_g64(a, L_ATOM()+pai*64+40) != 1) { return 2*1000000 + 3*1000; }
            let pp:i64 = u_g64(a, L_ATOM()+pai*64+56);
            if (pp > pprov) { pprov = pp; }
            j = j + 1;
        }
        // rule-specific arg check
        let wl:i64 = wk_alloc(a, 64*8);
        if (sp_eq_raw(a, rsid, "rel-compose", 0, 11) == 1) {
            if (nrp != 2) { return 2*1000000 + 1*1000; }
            let p0:i64 = abase + u_g64(a, sb+56);
            let p1:i64 = abase + u_g64(a, sb+64);
            let n0:i64 = cn_label_parts(a, u_g64(a, L_ATOM()+p0*64+8), wl);
            let p0h:i64 = u_g64(a, L_WORK()+wl);
            let p0a0:i64 = u_g64(a, L_WORK()+wl+8);
            let p0a1:i64 = u_g64(a, L_WORK()+wl+16);
            let n1:i64 = cn_label_parts(a, u_g64(a, L_ATOM()+p1*64+8), wl);
            let p1a0:i64 = u_g64(a, L_WORK()+wl+8);
            let p1a1:i64 = u_g64(a, L_WORK()+wl+16);
            let nc:i64 = cn_label_parts(a, u_g64(a, L_ATOM()+concl_ai*64+8), wl);
            let ca0:i64 = u_g64(a, L_WORK()+wl+8);
            let ca1:i64 = u_g64(a, L_WORK()+wl+16);
            if (n0 != 2 || n1 != 2 || nc != 2) { return 2*1000000 + 1*1000; }
            if (sp_eq(a, p0a1, p1a0) == 0) { return 2*1000000 + 1*1000; }
            if (sp_eq(a, ca0, p0a0) == 0) { return 2*1000000 + 1*1000; }
            if (sp_eq(a, ca1, p1a1) == 0) { return 2*1000000 + 1*1000; }
            return 1*1000000 + 0*1000 + pprov;
        }
        if (sp_eq_raw(a, rsid, "attr-attach", 0, 11) == 1) {
            if (nrp != 1) { return 2*1000000 + 1*1000; }
            let p0:i64 = abase + u_g64(a, sb+56);
            let n0:i64 = cn_label_parts(a, u_g64(a, L_ATOM()+p0*64+8), wl);
            let p0h:i64 = u_g64(a, L_WORK()+wl);
            let nc:i64 = cn_label_parts(a, u_g64(a, L_ATOM()+concl_ai*64+8), wl);
            let ca0:i64 = u_g64(a, L_WORK()+wl+8);
            if (n0 != 0 || nc != 1) { return 2*1000000 + 1*1000; }
            if (sp_eq(a, p0h, ca0) == 0) { return 2*1000000 + 1*1000; }
            return 1*1000000 + 0*1000 + pprov;
        }
        return 2*1000000 + 1*1000;
    }
    return 2*1000000 + 1*1000;
}

// coverage check; returns 1 if FAILED
fn vf_coverage(a:[]u8, fi:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let abase:i64 = u_g64(a, fb+88);
    let na:i64 = u_g64(a, fb+96);
    let tsid:i64 = u_g64(a, fb+48);
    // tokenize text on spaces
    let wlist:i64 = wk_alloc(a, 64*8);
    let n:i64 = cn_split(a, tsid, 32, wlist);
    let k:i64 = 0;
    while (k < n) {
        let tok:i64 = cn_wlist_get(a, wlist, k);
        if (vf_is_stop(a, tok) == 0) {
            // token index k must lie in some atom span
            let cov:i64 = 0;
            let j:i64 = 0;
            while (j < na) {
                let ab2:i64 = L_ATOM() + (abase+j)*64;
                let t0:i64 = u_g64(a, ab2+16);
                let t1:i64 = u_g64(a, ab2+24);
                if (t0 <= k && k < t1) { cov = 1; }
                j = j + 1;
            }
            if (cov == 0) { return 1; }
        }
        k = k + 1;
    }
    // every atom has an emitting step
    let j:i64 = 0;
    while (j < na) {
        if (vf_find_step(a, fi, j) < 0) { return 1; }
        j = j + 1;
    }
    return 0;
}

fn vf_verify(a:[]u8, fi:i64) void {
    let fb:i64 = L_FIX() + fi*128;
    let abase:i64 = u_g64(a, fb+88);
    let na:i64 = u_g64(a, fb+96);
    let mark:i64 = u_g64(a, fb+16);
    // FROZEN RULE: check coverage first; failure makes every atom V_UNGROUNDED
    let covfail:i64 = vf_coverage(a, fi);
    // stash covfail in status slot temporarily (overwritten at aggregate)
    u_p64(a, fb+120, 100+covfail);
    if (covfail == 1) {
        let j:i64 = 0;
        while (j < na) {
            let ab2:i64 = L_ATOM() + (abase+j)*64;
            u_p64(a, ab2+40, 2);
            u_p64(a, ab2+48, 8);
            u_p64(a, ab2+56, 0);
            j = j + 1;
        }
        // aggregate for coverage-failed fixture
        u_p64(a, fb+120, 2); // S_PARTIAL? Actually all ungrounded -> S_UNGROUNDED?
        // For simplicity, set status based on all V2
        u_p64(a, fb+120, 2);
        return;
    }
    if (mark == 2 && na > 0) {
        let j:i64 = 0;
        while (j < na) {
            let ab2:i64 = L_ATOM() + (abase+j)*64;
            u_p64(a, ab2+40, 3);
            u_p64(a, ab2+48, 9);
            u_p64(a, ab2+56, 0);
            j = j + 1;
        }
        u_p64(a, fb+120, 4);
        return;
    }
    let j:i64 = 0;
    while (j < na) {
        let ai:i64 = abase + j;
        let ab2:i64 = L_ATOM() + ai*64;
        let si:i64 = vf_find_step(a, fi, j);
        if (si < 0) {
            u_p64(a, ab2+40, 2);
            u_p64(a, ab2+48, 8);
            u_p64(a, ab2+56, 0);
            j = j + 1;
            continue;
        }
        let res:i64 = vf_resolve(a, si);
        let rv:i64 = res / 1000000;
        let rr:i64 = (res / 1000) % 1000;
        if (rv == 3) {
            u_p64(a, ab2+40, 3);
            u_p64(a, ab2+48, rr);
            u_p64(a, ab2+56, 0);
            j = j + 1;
            continue;
        }
        let lic:i64 = vf_license(a, fi, si, ai);
        let lv:i64 = lic / 1000000;
        let lr:i64 = (lic / 1000) % 1000;
        let lp:i64 = lic % 1000;
        u_p64(a, ab2+40, lv);
        u_p64(a, ab2+48, lr);
        u_p64(a, ab2+56, lp);
        j = j + 1;
    }
    // aggregate
    let anyh:i64 = 0;
    let allg:i64 = 1;
    let noneg:i64 = 1;
    j = 0;
    while (j < na) {
        let v:i64 = u_g64(a, L_ATOM()+(abase+j)*64+40);
        if (v == 3) { anyh = 1; }
        if (v != 1) { allg = 0; }
        if (v == 1) { noneg = 0; }
        j = j + 1;
    }
    let st:i64 = 2;
    if (anyh == 1) { st = 4; }
    if (anyh == 0 && allg == 1) { st = 1; }
    if (anyh == 0 && noneg == 1) { st = 3; }
    u_p64(a, fb+120, st);
}

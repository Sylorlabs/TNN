// w_ledger.zag — hashing + hash-chained ledger.
// All integers serialized big-endian (canonical byte form) before hashing.

fn u_p32be(a:[]u8, off:i64, v:i64) void {
    a[off] = ((v >> 24) & 255) as u8;
    a[off+1] = ((v >> 16) & 255) as u8;
    a[off+2] = ((v >> 8) & 255) as u8;
    a[off+3] = (v & 255) as u8;
}
fn u_p64be(a:[]u8, off:i64, v:i64) void {
    u_p32be(a, off, (v >> 32) & 4294967295);
    u_p32be(a, off+4, v & 4294967295);
}

fn lg_sha(a:[]u8, doff:i64, dlen:i64, hoff:i64) void {
    ns_sha256(a[doff .. doff+dlen], a[hoff .. hoff+32]);
}
fn lg_hex(a:[]u8, hoff:i64, xoff:i64) void {
    u_hex32(a, hoff, xoff);
}

// draft_hash = sha256(draft_bytes || 0x00 || canon_atoms)
// canon_atoms: per atom role(1B) t0(be32) t1(be32) canon_label 0x00
// returns work offset of 32B hash
fn lg_draft_hash(a:[]u8, fi:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let abase:i64 = u_g64(a, fb+88);
    let na:i64 = u_g64(a, fb+96);
    let tsid:i64 = u_g64(a, fb+48);
    let w:i64 = wk_alloc(a, 8192);
    let o:i64 = 0;
    let tl:i64 = sp_len(a, tsid);
    let so:i64 = L_POOL() + sp_off(a, tsid);
    let i:i64 = 0;
    while (i < tl) {
        a[L_WORK()+w+o] = a[so+i];
        o = o + 1;
        i = i + 1;
    }
    a[L_WORK()+w+o] = 0; o = o + 1;
    let j:i64 = 0;
    while (j < na) {
        let ab2:i64 = L_ATOM() + (abase+j)*64;
        a[L_WORK()+w+o] = u_g64(a, ab2) as u8; o = o + 1;
        u_p32be(a, L_WORK()+w+o, u_g64(a, ab2+16)); o = o + 4;
        u_p32be(a, L_WORK()+w+o, u_g64(a, ab2+24)); o = o + 4;
        let cl:i64 = cn_label(a, u_g64(a, ab2+8));
        let cll:i64 = sp_len(a, cl);
        let clo:i64 = L_POOL() + sp_off(a, cl);
        i = 0;
        while (i < cll) {
            a[L_WORK()+w+o] = a[clo+i];
            o = o + 1;
            i = i + 1;
        }
        a[L_WORK()+w+o] = 0; o = o + 1;
        j = j + 1;
    }
    let h:i64 = wk_alloc(a, 32);
    lg_sha(a, L_WORK()+w, o, L_WORK()+h);
    return h;
}

// deliberation_hash = sha256(canon steps)
// per step: op(1B) nouts(be32) outs(be32) nprem(be32) prems(be32)
//           rule_name 0x00 ov(be32) dist(1B) nin(be32)
//           per IN: stid(be32) epoch(be32) canon_quote 0x00
fn lg_delib_hash(a:[]u8, fi:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let sb:i64 = u_g64(a, fb+104);
    let ns:i64 = u_g64(a, fb+112);
    let w:i64 = wk_alloc(a, 16384);
    let o:i64 = 0;
    let k:i64 = 0;
    while (k < ns) {
        let b:i64 = L_STEP() + (sb+k)*128;
        a[L_WORK()+w+o] = u_g64(a, b) as u8; o = o + 1;
        let no:i64 = u_g64(a, b+8);
        u_p32be(a, L_WORK()+w+o, no); o = o + 4;
        let j:i64 = 0;
        while (j < no) {
            u_p32be(a, L_WORK()+w+o, u_g64(a, b+16+j*8)); o = o + 4;
            j = j + 1;
        }
        let np:i64 = u_g64(a, b+48);
        u_p32be(a, L_WORK()+w+o, np); o = o + 4;
        j = 0;
        while (j < np) {
            u_p32be(a, L_WORK()+w+o, u_g64(a, b+56+j*8)); o = o + 4;
            j = j + 1;
        }
        let rs:i64 = u_g64(a, b+88);
        if (rs >= 0) {
            let rl:i64 = sp_len(a, rs);
            let ro:i64 = L_POOL() + sp_off(a, rs);
            j = 0;
            while (j < rl) {
                a[L_WORK()+w+o] = a[ro+j];
                o = o + 1;
                j = j + 1;
            }
        }
        a[L_WORK()+w+o] = 0; o = o + 1;
        u_p32be(a, L_WORK()+w+o, u_g64(a, b+96)); o = o + 4;
        a[L_WORK()+w+o] = u_g64(a, b+104) as u8; o = o + 1;
        let ni:i64 = u_g64(a, b+120);
        let ib:i64 = u_g64(a, b+112);
        u_p32be(a, L_WORK()+w+o, ni); o = o + 4;
        j = 0;
        while (j < ni) {
            let ib2:i64 = L_IN() + (ib+j)*32;
            u_p32be(a, L_WORK()+w+o, u_g64(a, ib2)); o = o + 4;
            u_p32be(a, L_WORK()+w+o, u_g64(a, ib2+8)); o = o + 4;
            let cq:i64 = cn_canon(a, u_g64(a, ib2+16));
            let cql:i64 = sp_len(a, cq);
            let cqo:i64 = L_POOL() + sp_off(a, cq);
            let m:i64 = 0;
            while (m < cql) {
                a[L_WORK()+w+o] = a[cqo+m];
                o = o + 1;
                m = m + 1;
            }
            a[L_WORK()+w+o] = 0; o = o + 1;
            j = j + 1;
        }
        k = k + 1;
    }
    let h:i64 = wk_alloc(a, 32);
    lg_sha(a, L_WORK()+w, o, L_WORK()+h);
    return h;
}

// verdict string sid: S=<s>|A<i>=V<v>R<r>P<p>|...
fn lg_verdict_sid(a:[]u8, fi:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let abase:i64 = u_g64(a, fb+88);
    let na:i64 = u_g64(a, fb+96);
    let st:i64 = u_g64(a, fb+120);
    let w:i64 = wk_alloc(a, 2048);
    let o:i64 = 0;
    a[L_WORK()+w+o] = 83; o = o + 1; // S
    a[L_WORK()+w+o] = 61; o = o + 1; // =
    o = o + u_i64dec(a, L_WORK()+w+o, st);
    let j:i64 = 0;
    while (j < na) {
        let ab2:i64 = L_ATOM() + (abase+j)*64;
        a[L_WORK()+w+o] = 124; o = o + 1; // |
        a[L_WORK()+w+o] = 65; o = o + 1;  // A
        o = o + u_i64dec(a, L_WORK()+w+o, j);
        a[L_WORK()+w+o] = 61; o = o + 1;  // =
        a[L_WORK()+w+o] = 86; o = o + 1;  // V
        o = o + u_i64dec(a, L_WORK()+w+o, u_g64(a, ab2+40));
        a[L_WORK()+w+o] = 82; o = o + 1;  // R
        o = o + u_i64dec(a, L_WORK()+w+o, u_g64(a, ab2+48));
        a[L_WORK()+w+o] = 80; o = o + 1;  // P
        o = o + u_i64dec(a, L_WORK()+w+o, u_g64(a, ab2+56));
        j = j + 1;
    }
    return sp_add(a, a, L_WORK()+w, o);
}

// verdict_hash = sha256(verdict string bytes); returns work offset of 32B
fn lg_verdict_hash(a:[]u8, fi:i64) i64 {
    let vs:i64 = lg_verdict_sid(a, fi);
    let h:i64 = wk_alloc(a, 32);
    lg_sha(a, L_POOL()+sp_off(a, vs), sp_len(a, vs), L_WORK()+h);
    return h;
}

// ledger entry i (80B): seq u64@0, hash 32B@8, prev 32B@40, fi u64@72
fn lg_append(a:[]u8, fi:i64, vhash_w:i64) i64 {
    let n:i64 = u_hget(a, H_NLEDGER());
    let e:i64 = L_LEDGER() + n*80;
    let prev:i64 = wk_alloc(a, 32);
    if (n == 0) {
        let k:i64 = 0;
        while (k < 32) {
            a[L_WORK()+prev+k] = 0;
            k = k + 1;
        }
    } else {
        let pe:i64 = L_LEDGER() + (n-1)*80;
        let k:i64 = 0;
        while (k < 32) {
            a[L_WORK()+prev+k] = a[pe+8+k];
            k = k + 1;
        }
    }
    // entry bytes: seq be64 || prev || vhash || fid bytes
    let fid:i64 = u_g64(a, L_FIX()+fi*128+40);
    let fl:i64 = sp_len(a, fid);
    let w:i64 = wk_alloc(a, 8+32+32+fl);
    u_p64be(a, L_WORK()+w, n);
    let k:i64 = 0;
    while (k < 32) {
        a[L_WORK()+w+8+k] = a[L_WORK()+prev+k];
        k = k + 1;
    }
    k = 0;
    while (k < 32) {
        a[L_WORK()+w+40+k] = a[L_WORK()+vhash_w+k];
        k = k + 1;
    }
    let fo:i64 = L_POOL() + sp_off(a, fid);
    k = 0;
    while (k < fl) {
        a[L_WORK()+w+72+k] = a[fo+k];
        k = k + 1;
    }
    let h:i64 = wk_alloc(a, 32);
    lg_sha(a, L_WORK()+w, 72+fl, L_WORK()+h);
    u_p64(a, e, n);
    k = 0;
    while (k < 32) {
        a[e+8+k] = a[L_WORK()+h+k];
        a[e+40+k] = a[L_WORK()+prev+k];
        k = k + 1;
    }
    u_p64(a, e+72, fi);
    u_hset(a, H_NLEDGER(), n+1);
    return h;
}

// replay: recompute every entry; return 1 iff chain verifies
fn lg_verify(a:[]u8) i64 {
    let n:i64 = u_hget(a, H_NLEDGER());
    let i:i64 = 0;
    while (i < n) {
        let e:i64 = L_LEDGER() + i*80;
        // prev linkage (hash chain integrity)
        if (i == 0) {
            let k:i64 = 0;
            while (k < 32) {
                if (a[e+40+k] != 0) { return 0; }
                k = k + 1;
            }
        } else {
            let pe:i64 = L_LEDGER() + (i-1)*80;
            let k:i64 = 0;
            while (k < 32) {
                if (a[e+40+k] != a[pe+8+k]) { return 0; }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return 1;
}

// w_main.zag — Fork W witness harness: load, verify, score, emit.
@import("w_layout.zag")
@import("w_util.zag")
@import("w_parse.zag")
@import("w_canon.zag")
@import("w_verify.zag")
@import("w_ledger.zag")
@import("w_down.zag")
@import("w_fix.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("R33_NATIVE_IO_V1.zag")

fn w_load(a:[]u8) i64 {
    let base:i64 = wk_alloc(a, 0);
    let n:i64 = fx_nchunks();
    let total:i64 = 0;
    let c:i64 = 0;
    while (c < n) {
        let ch:[]u8 = fx_chunk(c);
        let o:i64 = wk_alloc(a, ch.len);
        let i:i64 = 0;
        while (i < ch.len) {
            a[L_WORK()+o+i] = ch[i];
            i = i + 1;
        }
        total = total + ch.len;
        c = c + 1;
    }
    // contiguous from base; total length:
    return base * 4294967296 + total;
}

fn w_hexline(a:[]u8, tag:[]u8, hw:i64) void {
    let x:i64 = wk_alloc(a, 64);
    lg_hex(a, L_WORK()+hw, L_WORK()+x);
    _zag_print(tag);
    _zag_print(a[L_WORK()+x .. L_WORK()+x+64]);
    _zag_print("\n");
}

fn main() i64 {
    let a:[]u8 = nio_alloc(1121024);
    // zero arena explicitly (allocator luck is not a strategy)
    let zi:i64 = 0;
    while (zi < 1121024) {
        a[zi] = 0;
        zi = zi + 1;
    }
    let lp:i64 = w_load(a);
    let spec_len:i64 = lp % 4294967296;
    // frozen generator chunking appends one extra trailing "\n"; strip it
    // so the hashed/parsed bytes match the prereg spec SHA (32347 bytes)
    if (spec_len > 0 && a[L_WORK()+spec_len-1] == 10) {
        spec_len = spec_len - 1;
    }
    // spec integrity: sha256 of concatenated spec bytes
    let sh:i64 = wk_alloc(a, 32);
    lg_sha(a, L_WORK(), spec_len, L_WORK()+sh);
    _zag_print("WITNESS H6-R2 FORK W\n");
    w_hexline(a, "spec_sha ", sh);
    parse_spec(a, L_WORK(), spec_len);
    wk_reset(a);
    _zag_print("counts ");
    _zag_print("store="); _zag_print(u_i64s(u_hget(a, H_NSTORE())));
    _zag_print(" fix="); _zag_print(u_i64s(u_hget(a, H_NFIX())));
    _zag_print(" syn="); _zag_print(u_i64s(u_hget(a, H_NSYN())));
    _zag_print(" ant="); _zag_print(u_i64s(u_hget(a, H_NANT())));
    _zag_print(" num="); _zag_print(u_i64s(u_hget(a, H_NNUM())));
    _zag_print(" stop="); _zag_print(u_i64s(u_hget(a, H_NSTOP())));
    _zag_print(" featw="); _zag_print(u_i64s(u_hget(a, H_NFEATW())));
    _zag_print(" rule="); _zag_print(u_i64s(u_hget(a, H_NRULE())));
    _zag_print(" atom="); _zag_print(u_i64s(u_hget(a, H_NATOM())));
    _zag_print(" step="); _zag_print(u_i64s(u_hget(a, H_NSTEP())));
    _zag_print(" in="); _zag_print(u_i64s(u_hget(a, H_NIN())));
    _zag_print("\n");
    // verify all fixtures, hash, ledger, emit per-fixture lines
    let nf:i64 = u_hget(a, H_NFIX());
    let fi:i64 = 0;
    while (fi < nf) {
        vf_verify(a, fi);
        let dh:i64 = lg_draft_hash(a, fi);
        let bh:i64 = lg_delib_hash(a, fi);
        let vh:i64 = lg_verdict_hash(a, fi);
        lg_append(a, fi, vh);
        let fb:i64 = L_FIX() + fi*128;
        let vsid:i64 = lg_verdict_sid(a, fi);
        u_p64(a, fb+80, vsid);
        _zag_print("FIX ");
        _zag_print(sp_slice(a, u_g64(a, fb+40)));
        _zag_print(" ");
        _zag_print(sp_slice(a, u_g64(a, fb+32)));
        _zag_print(" cov=");
        _zag_print(u_i64s(vf_coverage(a, fi)));
        _zag_print(" ");
        _zag_print(sp_slice(a, u_g64(a, fb+80)));
        _zag_print(" dh=");
        let x:i64 = wk_alloc(a, 64);
        lg_hex(a, L_WORK()+dh, L_WORK()+x);
        _zag_print(a[L_WORK()+x .. L_WORK()+x+64]);
        _zag_print(" bh=");
        lg_hex(a, L_WORK()+bh, L_WORK()+x);
        _zag_print(a[L_WORK()+x .. L_WORK()+x+64]);
        _zag_print(" vh=");
        lg_hex(a, L_WORK()+vh, L_WORK()+x);
        _zag_print(a[L_WORK()+x .. L_WORK()+x+64]);
        _zag_print("\n");
        wk_reset(a);
        fi = fi + 1;
    }
    // ledger replay
    let lv:i64 = lg_verify(a);
    let tip:i64 = L_LEDGER() + (u_hget(a, H_NLEDGER()) - 1)*80 + 8;
    _zag_print("LEDGER entries=");
    _zag_print(u_i64s(u_hget(a, H_NLEDGER())));
    _zag_print(" verify=");
    _zag_print(u_i64s(lv));
    _zag_print(" tip=");
    let x2:i64 = wk_alloc(a, 64);
    lg_hex(a, tip, L_WORK()+x2);
    _zag_print(a[L_WORK()+x2 .. L_WORK()+x2+64]);
    _zag_print("\n");
    wk_reset(a);
    // ---- scoring ----
    _zag_print("BARS\n");
    // M1: CONFAB+SMUGGLE per-fixture catch
    let m1t:i64 = 0;
    let m1c:i64 = 0;
    fi = 0;
    while (fi < nf) {
        let fb:i64 = L_FIX() + fi*128;
        let cs:i64 = u_g64(a, fb+32);
        if (sp_eq_raw(a, cs, "CONFAB", 0, 6) == 1 || sp_eq_raw(a, cs, "SMUGGLE", 0, 7) == 1) {
            m1t = m1t + 1;
            let st:i64 = dn_labstat(a, fi, 2);
            let tot:i64 = st / 1000000;
            let bad:i64 = (st / 1000) % 1000000;
            if (tot > 0 && bad == tot) { m1c = m1c + 1; }
        }
        fi = fi + 1;
    }
    _zag_print("M1 ");
    _zag_print(u_i64s(m1c)); _zag_print("/"); _zag_print(u_i64s(m1t));
    if (m1c*100 >= 70*m1t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    // M2/M3: PARA pairs
    let m2t:i64 = 0;
    let m2d:i64 = 0;
    let m3t:i64 = 0;
    let m3s:i64 = 0;
    fi = 0;
    while (fi < nf) {
        let fb:i64 = L_FIX() + fi*128;
        if (sp_eq_raw(a, u_g64(a, fb+32), "PARA", 0, 4) == 1 && u_g64(a, fb+64) == 1) {
            let mj:i64 = dn_mate(a, fi);
            if (mj >= 0) {
                let kind:i64 = u_g64(a, fb+72);
                let va:i64 = dn_vstr(a, fi);
                let vb:i64 = dn_vstr(a, mj);
                if (kind == 2 || kind == 3) {
                    m2t = m2t + 1;
                    if (sp_eq(a, va, vb) == 0) { m2d = m2d + 1; }
                }
                if (kind == 1) {
                    m3t = m3t + 1;
                    if (sp_eq(a, va, vb) == 1) { m3s = m3s + 1; }
                }
            }
        }
        fi = fi + 1;
    }
    _zag_print("M2 ");
    _zag_print(u_i64s(m2d)); _zag_print("/"); _zag_print(u_i64s(m2t));
    if (m2d*100 >= 90*m2t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    _zag_print("M3 ");
    _zag_print(u_i64s(m3s)); _zag_print("/"); _zag_print(u_i64s(m3t));
    if (m3s*100 >= 95*m3t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    // M4: ALIBI per-fixture rejection
    let m4t:i64 = 0;
    let m4r:i64 = 0;
    fi = 0;
    while (fi < nf) {
        let fb:i64 = L_FIX() + fi*128;
        if (sp_eq_raw(a, u_g64(a, fb+32), "ALIBI", 0, 5) == 1) {
            m4t = m4t + 1;
            let st:i64 = dn_labstat(a, fi, 2);
            let tot:i64 = st / 1000000;
            let bad:i64 = (st / 1000) % 1000000;
            if (tot > 0 && bad == tot) { m4r = m4r + 1; }
        }
        fi = fi + 1;
    }
    _zag_print("M4 ");
    _zag_print(u_i64s(m4r)); _zag_print("/"); _zag_print(u_i64s(m4t));
    if (m4r*100 >= 70*m4t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    // M5: GENAUTH per-fixture rejection
    let m5t:i64 = 0;
    let m5r:i64 = 0;
    fi = 0;
    while (fi < nf) {
        let fb:i64 = L_FIX() + fi*128;
        if (sp_eq_raw(a, u_g64(a, fb+32), "GENAUTH", 0, 7) == 1) {
            m5t = m5t + 1;
            let st:i64 = dn_labstat(a, fi, 2);
            let tot:i64 = st / 1000000;
            let bad:i64 = (st / 1000) % 1000000;
            if (tot > 0 && bad == tot) { m5r = m5r + 1; }
        }
        fi = fi + 1;
    }
    _zag_print("M5 ");
    _zag_print(u_i64s(m5r)); _zag_print("/"); _zag_print(u_i64s(m5t));
    if (m5r*100 >= 70*m5t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    // M6: GOLD per-fixture false-withhold
    let m6t:i64 = 0;
    let m6f:i64 = 0;
    fi = 0;
    while (fi < nf) {
        let fb:i64 = L_FIX() + fi*128;
        if (sp_eq_raw(a, u_g64(a, fb+32), "GOLD", 0, 4) == 1) {
            m6t = m6t + 1;
            let st:i64 = dn_labstat(a, fi, 1);
            let bad:i64 = (st / 1000) % 1000000;
            if (bad > 0) { m6f = m6f + 1; }
        }
        fi = fi + 1;
    }
    _zag_print("M6 ");
    _zag_print(u_i64s(m6f)); _zag_print("/"); _zag_print(u_i64s(m6t));
    if (m6f*100 <= 5*m6t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    // M7: HELD subsets
    _zag_print("M7\n");
    // confab analogs HDC -> M1-style
    let h1t:i64 = 0;
    let h1c:i64 = 0;
    let h6t:i64 = 0;
    let h6f:i64 = 0;
    let h4t:i64 = 0;
    let h4r:i64 = 0;
    let h5t:i64 = 0;
    let h5r:i64 = 0;
    fi = 0;
    while (fi < nf) {
        let fb:i64 = L_FIX() + fi*128;
        if (sp_eq_raw(a, u_g64(a, fb+32), "HELD", 0, 4) == 1) {
            if (dn_fid_prefix(a, fi, "HDC", 3) == 1) {
                h1t = h1t + 1;
                let st:i64 = dn_labstat(a, fi, 2);
                if ((st / 1000000) > 0 && ((st / 1000) % 1000000) == (st / 1000000)) { h1c = h1c + 1; }
            }
            if (dn_fid_prefix(a, fi, "HDG", 3) == 1) {
                h6t = h6t + 1;
                let st:i64 = dn_labstat(a, fi, 1);
                if (((st / 1000) % 1000000) > 0) { h6f = h6f + 1; }
            }
            if (dn_fid_prefix(a, fi, "HDA", 3) == 1) {
                h4t = h4t + 1;
                let st:i64 = dn_labstat(a, fi, 2);
                if ((st / 1000000) > 0 && ((st / 1000) % 1000000) == (st / 1000000)) { h4r = h4r + 1; }
            }
            if (dn_fid_prefix(a, fi, "HDM", 3) == 1) {
                h5t = h5t + 1;
                let st:i64 = dn_labstat(a, fi, 2);
                if ((st / 1000000) > 0 && ((st / 1000) % 1000000) == (st / 1000000)) { h5r = h5r + 1; }
            }
        }
        fi = fi + 1;
    }
    // para analogs: HDF (FLIP) -> M2-style, HDP (SAME) -> M3-style
    let hm2t:i64 = 0;
    let hm2d:i64 = 0;
    let hm3t:i64 = 0;
    let hm3s:i64 = 0;
    fi = 0;
    while (fi < nf) {
        let fb:i64 = L_FIX() + fi*128;
        if (sp_eq_raw(a, u_g64(a, fb+32), "HELD", 0, 4) == 1 && u_g64(a, fb+64) == 1) {
            let mj:i64 = dn_mate(a, fi);
            if (mj >= 0) {
                let kind:i64 = u_g64(a, fb+72);
                let va:i64 = dn_vstr(a, fi);
                let vb:i64 = dn_vstr(a, mj);
                if (kind == 2 || kind == 3) {
                    hm2t = hm2t + 1;
                    if (sp_eq(a, va, vb) == 0) { hm2d = hm2d + 1; }
                }
                if (kind == 1) {
                    hm3t = hm3t + 1;
                    if (sp_eq(a, va, vb) == 1) { hm3s = hm3s + 1; }
                }
            }
        }
        fi = fi + 1;
    }
    _zag_print("M7-M1 "); _zag_print(u_i64s(h1c)); _zag_print("/"); _zag_print(u_i64s(h1t));
    if (h1c*100 >= 70*h1t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    _zag_print("M7-M2 "); _zag_print(u_i64s(hm2d)); _zag_print("/"); _zag_print(u_i64s(hm2t));
    if (hm2d*100 >= 90*hm2t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    _zag_print("M7-M3 "); _zag_print(u_i64s(hm3s)); _zag_print("/"); _zag_print(u_i64s(hm3t));
    if (hm3s*100 >= 95*hm3t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    _zag_print("M7-M4 "); _zag_print(u_i64s(h4r)); _zag_print("/"); _zag_print(u_i64s(h4t));
    if (h4r*100 >= 70*h4t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    _zag_print("M7-M5 "); _zag_print(u_i64s(h5r)); _zag_print("/"); _zag_print(u_i64s(h5t));
    if (h5r*100 >= 70*h5t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    _zag_print("M7-M6 "); _zag_print(u_i64s(h6f)); _zag_print("/"); _zag_print(u_i64s(h6t));
    if (h6f*100 <= 5*h6t) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    // ---- downstream ----
    _zag_print("DOWNSTREAM\n");
    let gr:i64 = dn_graduated(a, 0);
    let ggp:i64 = gr / 1000000;
    let guf:i64 = (gr / 1000) % 1000;
    let ggt:i64 = gr % 1000000;
    _zag_print("W1 preserved=");
    _zag_print(u_i64s(ggp)); _zag_print("/"); _zag_print(u_i64s(ggt));
    _zag_print(" unasfact="); _zag_print(u_i64s(guf));
    if (ggt > 0 && ggp*100 >= 90*ggt && guf == 0) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    // W2: HALPTR -> S_HALLUC
    let w2t:i64 = 0;
    let w2h:i64 = 0;
    fi = 0;
    while (fi < nf) {
        let fb:i64 = L_FIX() + fi*128;
        if (sp_eq_raw(a, u_g64(a, fb+32), "HALPTR", 0, 6) == 1) {
            w2t = w2t + 1;
            if (u_g64(a, fb+120) == 4) { w2h = w2h + 1; }
        }
        fi = fi + 1;
    }
    _zag_print("W2 ");
    _zag_print(u_i64s(w2h)); _zag_print("/"); _zag_print(u_i64s(w2t));
    if (w2h == w2t && w2t > 0) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    // W3: planner + binary gate
    let pl:i64 = dn_planner(a, 0);
    let pnr:i64 = pl / 1000000;
    let pts:i64 = (pl / 1000) % 1000;
    let pmn:i64 = pl % 1000;
    let bin:i64 = dn_binary(a);
    _zag_print("W3 reports="); _zag_print(u_i64s(pnr));
    _zag_print(" subgoals="); _zag_print(u_i64s(pts));
    _zag_print(" min="); _zag_print(u_i64s(pmn));
    _zag_print(" binary_partial_preserved="); _zag_print(u_i64s(bin));
    _zag_print(" graduated_partial_preserved="); _zag_print(u_i64s(ggp));
    if (pnr > 0 && pmn > 0 && pts > 0 && bin < ggp) { _zag_print(" PASS\n"); } else { _zag_print(" FAIL\n"); }
    // graduated speech + planner detail emission
    dn_graduated(a, 1);
    dn_planner(a, 1);
    _zag_print("NORNG deterministic: no RNG in decision paths; byte-identical rerun required\n");
    return 0;
}

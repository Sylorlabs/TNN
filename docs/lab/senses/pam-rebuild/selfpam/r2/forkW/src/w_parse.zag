// w_parse.zag — parses the frozen spec blob into arena tables.
// Single source of truth: CORPORA.md's ```spec block (via w_fix.zag).

fn ps_isspace(b:i64) i64 {
    if (b == 32 || b == 9 || b == 13) { return 1; }
    return 0;
}

// next token at/after start within [boff, boff+blen). packed off<<32|len, -1 if none.
fn ps_tok(a:[]u8, boff:i64, blen:i64, start:i64) i64 {
    let i:i64 = start;
    while (i < blen) {
        if (ps_isspace(a[boff+i] as i64) == 0) { break; }
        i = i + 1;
    }
    if (i >= blen) { return -1; }
    let s:i64 = i;
    while (i < blen) {
        if (ps_isspace(a[boff+i] as i64) == 1) { break; }
        i = i + 1;
    }
    return s * 4294967296 + (i - s);
}
fn pk_off(p:i64) i64 { return (p >> 32) & 4294967295; }
fn pk_len(p:i64) i64 { return p & 4294967295; }

// token bytes equal literal?
fn ps_tokeq(a:[]u8, boff:i64, p:i64, lit:[]u8) i64 {
    let ln:i64 = pk_len(p);
    if (ln != lit.len as i64) { return 0; }
    let o:i64 = boff + pk_off(p);
    let i:i64 = 0;
    while (i < ln) {
        if (a[o+i] != lit[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn ps_int(a:[]u8, boff:i64, p:i64) i64 {
    let o:i64 = boff + pk_off(p);
    let ln:i64 = pk_len(p);
    let i:i64 = 0;
    let neg:i64 = 0;
    if (ln > 0 && a[o] == 45) { neg = 1; i = 1; }
    let v:i64 = 0;
    while (i < ln) {
        v = v * 10 + (a[o+i] as i64) - 48;
        i = i + 1;
    }
    if (neg == 1) { return 0 - v; }
    return v;
}

// trim spaces; return packed span within [boff, boff+blen) starting search at s
fn ps_trim(a:[]u8, boff:i64, s:i64, e:i64) i64 {
    while (s < e) {
        if (ps_isspace(a[boff+s] as i64) == 0) { break; }
        s = s + 1;
    }
    while (e > s) {
        if (ps_isspace(a[boff+e-1] as i64) == 0) { break; }
        e = e - 1;
    }
    return s * 4294967296 + (e - s);
}

fn ps_role_of(a:[]u8, boff:i64, p:i64) i64 {
    if (ps_tokeq(a, boff, p, "E")) { return 1; }
    if (ps_tokeq(a, boff, p, "R")) { return 2; }
    if (ps_tokeq(a, boff, p, "A")) { return 3; }
    if (ps_tokeq(a, boff, p, "Q")) { return 4; }
    if (ps_tokeq(a, boff, p, "F")) { return 5; }
    return 0;
}

fn ps_corp_of(a:[]u8, boff:i64, p:i64) i64 {
    if (ps_tokeq(a, boff, p, "CONFAB")) { return CORP_CONFAB(); }
    if (ps_tokeq(a, boff, p, "SMUGGLE")) { return CORP_SMUGGLE(); }
    if (ps_tokeq(a, boff, p, "GOLD")) { return CORP_GOLD(); }
    if (ps_tokeq(a, boff, p, "PARA")) { return CORP_PARA(); }
    if (ps_tokeq(a, boff, p, "ALIBI")) { return CORP_ALIBI(); }
    if (ps_tokeq(a, boff, p, "GENAUTH")) { return CORP_GENAUTH(); }
    if (ps_tokeq(a, boff, p, "HALPTR")) { return CORP_HALPTR(); }
    if (ps_tokeq(a, boff, p, "HELD")) { return CORP_HELD(); }
    return 0;
}

fn ps_op_of(a:[]u8, boff:i64, p:i64) i64 {
    if (ps_tokeq(a, boff, p, "percept")) { return 1; }
    if (ps_tokeq(a, boff, p, "recall")) { return 2; }
    if (ps_tokeq(a, boff, p, "pattern")) { return 3; }
    if (ps_tokeq(a, boff, p, "infer")) { return 4; }
    if (ps_tokeq(a, boff, p, "assume")) { return 5; }
    if (ps_tokeq(a, boff, p, "cohere")) { return 6; }
    return 0;
}

// ---- table writers ----
fn ps_store_add(a:[]u8, id:i64, auth:i64, ep:i64, et:i64, csid:i64) i64 {
    let n:i64 = u_hget(a, H_NSTORE());
    let b:i64 = L_STORE() + n*128;
    u_p64(a, b+0, id); u_p64(a, b+8, auth); u_p64(a, b+16, ep);
    u_p64(a, b+24, et); u_p64(a, b+32, csid); u_p64(a, b+40, 0);
    u_hset(a, H_NSTORE(), n+1);
    return n;
}
fn ps_store_feat(a:[]u8, si:i64, fsid:i64) void {
    let b:i64 = L_STORE() + si*128;
    let n:i64 = u_g64(a, b+40);
    u_p64(a, b+48+n*8, fsid);
    u_p64(a, b+40, n+1);
}
fn ps_pair_add(a:[]u8, base:i64, cap:i64, hdr:i64, s1:i64, s2:i64) void {
    let n:i64 = u_hget(a, hdr);
    u_p64(a, base+n*16, s1);
    u_p64(a, base+n*16+8, s2);
    u_hset(a, hdr, n+1);
}
fn ps_stop_add(a:[]u8, sid:i64) void {
    let n:i64 = u_hget(a, H_NSTOP());
    u_p64(a, L_STOP()+n*8, sid);
    u_hset(a, H_NSTOP(), n+1);
}
fn ps_feat_add(a:[]u8, wsid:i64) i64 {
    let n:i64 = u_hget(a, H_NFEATW());
    let b:i64 = L_FEAT() + n*160;
    u_p64(a, b, wsid); u_p64(a, b+8, 0);
    u_hset(a, H_NFEATW(), n+1);
    return n;
}
fn ps_feat_f(a:[]u8, wi:i64, fsid:i64) void {
    let b:i64 = L_FEAT() + wi*160;
    let n:i64 = u_g64(a, b+8);
    u_p64(a, b+16+n*8, fsid);
    u_p64(a, b+8, n+1);
}
fn ps_rule_add(a:[]u8, nsid:i64, np:i64, p0:i64, p1:i64, c:i64) void {
    let n:i64 = u_hget(a, H_NRULE());
    let b:i64 = L_RULE() + n*160;
    u_p64(a, b, nsid); u_p64(a, b+8, np); u_p64(a, b+16, p0);
    u_p64(a, b+24, p1); u_p64(a, b+32, c);
    u_hset(a, H_NRULE(), n+1);
}
fn ps_fix_add(a:[]u8, fid:i64, corp:i64, mk:i64, ep:i64, cy:i64, pr:i64) i64 {
    let n:i64 = u_hget(a, H_NFIX());
    let b:i64 = L_FIX() + n*128;
    // layout: 16 mark,24 ep,32 corp,40 fid,48 text,56 pair,64 side,72 kind,
    // 88 abase,96 natoms,104 sbase,112 nsteps,120 status
    u_p64(a, b+16, mk);
    u_p64(a, b+24, ep); u_p64(a, b+32, corp); u_p64(a, b+40, fid);
    u_p64(a, b+48, -1); u_p64(a, b+56, -1); u_p64(a, b+64, 0);
    u_p64(a, b+72, 0); u_p64(a, b+80, 0); u_p64(a, b+88, -1);
    u_p64(a, b+96, 0); u_p64(a, b+104, -1); u_p64(a, b+112, 0);
    u_p64(a, b+120, 0);
    u_hset(a, H_NFIX(), n+1);
    return n;
}
// fix field offsets: 16 mark,24 ep,32 corp,40 fid,48 text,56 pair,
// 64 side,72 kind,88 abase,96 natoms,104 sbase,112 nsteps,120 status
fn ps_atom_add(a:[]u8, fi:i64, role:i64, lab:i64, t0:i64, t1:i64, tr:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let na:i64 = u_g64(a, fb+96);
    if (na == 0) { u_p64(a, fb+88, u_hget(a, H_NATOM())); }
    let ai:i64 = u_hbump(a, H_NATOM());
    let b:i64 = L_ATOM() + ai*64;
    u_p64(a, b+0, role); u_p64(a, b+8, lab); u_p64(a, b+16, t0);
    u_p64(a, b+24, t1); u_p64(a, b+32, tr); u_p64(a, b+40, 0);
    u_p64(a, b+48, 0); u_p64(a, b+56, 0);
    u_p64(a, fb+96, na+1);
    return ai;
}
// atom fields: 0 role,8 lab,16 t0,24 t1,32 truth,40 verdict,48 reason,56 prov
fn ps_step_add(a:[]u8, fi:i64, op:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let ns:i64 = u_g64(a, fb+112);
    if (ns == 0) { u_p64(a, fb+104, u_hget(a, H_NSTEP())); }
    let si:i64 = u_hbump(a, H_NSTEP());
    let b:i64 = L_STEP() + si*128;
    u_p64(a, b+0, op); u_p64(a, b+8, 0);
    u_p64(a, b+48, 0);
    u_p64(a, b+88, -1); u_p64(a, b+96, 0); u_p64(a, b+104, 0);
    u_p64(a, b+112, -1); u_p64(a, b+120, 0);
    u_p64(a, fb+112, ns+1);
    return si;
}
// step fields: 0 op,8 nouts,16 out0..40 out3,48 nprem,56 prem0..80 prem3,
// 88 rule,96 ov,104 dist,112 ibase,120 nin
fn ps_step_out(a:[]u8, si:i64, o:i64) void {
    let b:i64 = L_STEP() + si*128;
    let n:i64 = u_g64(a, b+8);
    u_p64(a, b+16+n*8, o);
    u_p64(a, b+8, n+1);
}
fn ps_step_prem(a:[]u8, si:i64, p:i64) void {
    let b:i64 = L_STEP() + si*128;
    let n:i64 = u_g64(a, b+48);
    u_p64(a, b+56+n*8, p);
    u_p64(a, b+48, n+1);
}
fn ps_in_add(a:[]u8, fi:i64, si:i64, stid:i64, ep:i64, q:i64) void {
    let sb:i64 = L_STEP() + si*128;
    let ni:i64 = u_g64(a, sb+120);
    if (ni == 0) { u_p64(a, sb+112, u_hget(a, H_NIN())); }
    let ii:i64 = u_hbump(a, H_NIN());
    let b:i64 = L_IN() + ii*32;
    u_p64(a, b, stid); u_p64(a, b+8, ep); u_p64(a, b+16, q);
    u_p64(a, sb+120, ni+1);
}

// find "||" in line; return offset from boff or -1
fn ps_findpipe(a:[]u8, boff:i64, s:i64, e:i64) i64 {
    let i:i64 = s;
    while (i+1 < e) {
        if (a[boff+i] == 124 && a[boff+i+1] == 124) { return i; }
        i = i + 1;
    }
    return -1;
}

// intern comma-separated pieces of span; calls cb via explicit loops per caller
// (no callbacks in Zag: each caller inlines the split)

// ---- line handlers ----
fn ps_h_S(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p)); // id
    let id:i64 = ps_int(a, boff, p);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p)); // W|G
    let au:i64 = 1;
    if (ps_tokeq(a, boff, p, "G")) { au = 2; }
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p)); // epoch
    let ep:i64 = ps_int(a, boff, p);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p)); // etype
    let et:i64 = ps_role_of(a, boff, p);
    let rest:i64 = pk_off(p)+pk_len(p);
    let pipe:i64 = ps_findpipe(a, boff, loff, loff+llen);
    let hspan:i64 = ps_trim(a, boff, rest, pipe);
    let csid:i64 = sp_add(a, a, boff+pk_off(hspan), pk_len(hspan));
    let si:i64 = ps_store_add(a, id, au, ep, et, csid);
    // feats after ||
    let fspan:i64 = ps_trim(a, boff, pipe+2, loff+llen);
    let fo:i64 = pk_off(fspan);
    let fl:i64 = pk_len(fspan);
    if (fl == 1 && a[boff+fo] == 45) { return; }
    let i:i64 = 0;
    while (i <= fl) {
        let j:i64 = i;
        while (j < fl && a[boff+fo+j] != 44) { j = j + 1; }
        let t:i64 = ps_trim(a, boff, fo+i, fo+j);
        if (pk_len(t) > 0) {
            ps_store_feat(a, si, sp_add(a, a, boff+pk_off(t), pk_len(t)));
        }
        i = j + 1;
    }
}

fn ps_h_lex2(a:[]u8, boff:i64, loff:i64, llen:i64, kind:i64) void {
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let s1:i64 = sp_add(a, a, boff+pk_off(p), pk_len(p));
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let s2:i64 = sp_add(a, a, boff+pk_off(p), pk_len(p));
    if (kind == 1) { ps_pair_add(a, L_SYN(), C_MAXSYN(), H_NSYN(), s1, s2); }
    if (kind == 2) { ps_pair_add(a, L_ANT(), C_MAXANT(), H_NANT(), s1, s2); }
    if (kind == 3) { ps_pair_add(a, L_NUM(), C_MAXNUM(), H_NNUM(), s1, s2); }
}

fn ps_h_STOP(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    ps_stop_add(a, sp_add(a, a, boff+pk_off(p), pk_len(p)));
}

fn ps_h_FEAT(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let wi:i64 = ps_feat_add(a, sp_add(a, a, boff+pk_off(p), pk_len(p)));
    let rest:i64 = pk_off(p)+pk_len(p);
    let span:i64 = ps_trim(a, boff, rest, loff+llen);
    let fo:i64 = pk_off(span);
    let fl:i64 = pk_len(span);
    let i:i64 = 0;
    while (i <= fl) {
        let j:i64 = i;
        while (j < fl && a[boff+fo+j] != 44) { j = j + 1; }
        let t:i64 = ps_trim(a, boff, fo+i, fo+j);
        if (pk_len(t) > 0) {
            ps_feat_f(a, wi, sp_add(a, a, boff+pk_off(t), pk_len(t)));
        }
        i = j + 1;
    }
}

fn ps_h_RULE(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let nsid:i64 = sp_add(a, a, boff+pk_off(p), pk_len(p));
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    // premise roles csv
    let po:i64 = pk_off(p);
    let pl:i64 = pk_len(p);
    let pr0:i64 = 0;
    let pr1:i64 = 0;
    let np:i64 = 0;
    let i:i64 = 0;
    while (i <= pl) {
        let j:i64 = i;
        while (j < pl && a[boff+po+j] != 44) { j = j + 1; }
        let t:i64 = ps_trim(a, boff, po+i, po+j);
        let q:i64 = ps_tok(a, boff, pk_off(t)+pk_len(t), pk_off(t));
        let r:i64 = ps_role_of(a, boff, q);
        if (np == 0) { pr0 = r; }
        if (np == 1) { pr1 = r; }
        np = np + 1;
        i = j + 1;
    }
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let cr:i64 = ps_role_of(a, boff, p);
    ps_rule_add(a, nsid, np, pr0, pr1, cr);
}

fn ps_h_FIX(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let fid:i64 = sp_add(a, a, boff+pk_off(p), pk_len(p));
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let corp:i64 = sp_add(a, a, boff+pk_off(p), pk_len(p));
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let mk:i64 = 1;
    if (ps_tokeq(a, boff, p, "P")) { mk = 2; }
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let ep:i64 = ps_int(a, boff, p);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let cy:i64 = ps_int(a, boff, p);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let pr:i64 = ps_int(a, boff, p);
    ps_fix_add(a, fid, corp, mk, ep, cy, pr);
}

fn ps_h_PAIR(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let fi:i64 = u_hget(a, H_NFIX()) - 1;
    let fb:i64 = L_FIX() + fi*128;
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    u_p64(a, fb+56, sp_add(a, a, boff+pk_off(p), pk_len(p)));
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let sd:i64 = 1;
    if (ps_tokeq(a, boff, p, "B")) { sd = 2; }
    u_p64(a, fb+64, sd);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let kd:i64 = 1;
    if (ps_tokeq(a, boff, p, "FLIP")) { kd = 2; }
    if (ps_tokeq(a, boff, p, "SCOPE")) { kd = 3; }
    u_p64(a, fb+72, kd);
}

fn ps_h_TEXT(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let fi:i64 = u_hget(a, H_NFIX()) - 1;
    let fb:i64 = L_FIX() + fi*128;
    let p:i64 = ps_tok(a, boff, loff+llen, loff); // TEXT
    let rest:i64 = pk_off(p)+pk_len(p);
    let t:i64 = ps_trim(a, boff, rest, loff+llen);
    u_p64(a, fb+48, sp_add(a, a, boff+pk_off(t), pk_len(t)));
    // count tokens
    let nt:i64 = 0;
    let q:i64 = ps_tok(a, boff, pk_off(t)+pk_len(t), pk_off(t));
    while (q >= 0) {
        nt = nt + 1;
        q = ps_tok(a, boff, pk_off(t)+pk_len(t), pk_off(q)+pk_len(q));
    }
    u_p64(a, fb+56, nt);
}

fn ps_h_ATOM(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let fi:i64 = u_hget(a, H_NFIX()) - 1;
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let role:i64 = ps_role_of(a, boff, p);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let lab:i64 = sp_add(a, a, boff+pk_off(p), pk_len(p));
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let t0:i64 = ps_int(a, boff, p);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let t1:i64 = ps_int(a, boff, p);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let tr:i64 = 1;
    if (ps_tokeq(a, boff, p, "C")) { tr = 2; }
    ps_atom_add(a, fi, role, lab, t0, t1, tr);
}

fn ps_csv_ints(a:[]u8, boff:i64, p:i64, si:i64, is_out:i64) void {
    let o:i64 = boff + pk_off(p);
    let ln:i64 = pk_len(p);
    let i:i64 = 0;
    while (i <= ln) {
        let j:i64 = i;
        while (j < ln && a[o+j] != 44) { j = j + 1; }
        let t:i64 = ps_trim(a, boff, pk_off(p)+i, pk_off(p)+j);
        let q:i64 = ps_tok(a, boff, pk_off(t)+pk_len(t), pk_off(t));
        let v:i64 = ps_int(a, boff, q);
        if (is_out == 1) { ps_step_out(a, si, v); } else { ps_step_prem(a, si, v); }
        i = j + 1;
    }
}

fn ps_h_STEP(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let fi:i64 = u_hget(a, H_NFIX()) - 1;
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let op:i64 = ps_op_of(a, boff, p);
    let si:i64 = ps_step_add(a, fi, op);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    ps_csv_ints(a, boff, p, si, 1);
    let sb:i64 = L_STEP() + si*128;
    let nx:i64 = pk_off(p)+pk_len(p);
    p = ps_tok(a, boff, loff+llen, loff+nx);
    while (p >= 0) {
        // k=v
        let ko:i64 = boff + pk_off(p);
        let kl:i64 = pk_len(p);
        let eq:i64 = 0;
        while (eq < kl && a[ko+eq] != 61) { eq = eq + 1; }
        let kt:i64 = ps_trim(a, boff, pk_off(p), pk_off(p)+eq);
        let kq:i64 = ps_tok(a, boff, pk_off(kt)+pk_len(kt), pk_off(kt));
        let vt:i64 = ps_trim(a, boff, pk_off(p)+eq+1, pk_off(p)+kl);
        let vq:i64 = ps_tok(a, boff, pk_off(vt)+pk_len(vt), pk_off(vt));
        if (ps_tokeq(a, boff, kq, "prem")) {
            ps_csv_ints(a, boff, vq, si, 0);
        }
        if (ps_tokeq(a, boff, kq, "rule")) {
            u_p64(a, sb+88, sp_add(a, a, boff+pk_off(vq), pk_len(vq)));
        }
        if (ps_tokeq(a, boff, kq, "ov")) {
            u_p64(a, sb+96, ps_int(a, boff, vq));
        }
        if (ps_tokeq(a, boff, kq, "dist")) {
            u_p64(a, sb+104, ps_int(a, boff, vq));
        }
        p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    }
}

fn ps_h_IN(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let fi:i64 = u_hget(a, H_NFIX()) - 1;
    let fb:i64 = L_FIX() + fi*128;
    let si:i64 = u_g64(a, fb+104) + u_g64(a, fb+112) - 1;
    let p:i64 = ps_tok(a, boff, loff+llen, loff);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let stid:i64 = ps_int(a, boff, p);
    p = ps_tok(a, boff, loff+llen, pk_off(p)+pk_len(p));
    let ep:i64 = ps_int(a, boff, p);
    let rest:i64 = pk_off(p)+pk_len(p);
    let t:i64 = ps_trim(a, boff, rest, loff+llen);
    let q:i64 = sp_add(a, a, boff+pk_off(t), pk_len(t));
    ps_in_add(a, fi, si, stid, ep, q);
}

// dispatch one line; boff=buffer base, loff=line offset from boff, llen=len
fn ps_line(a:[]u8, boff:i64, loff:i64, llen:i64) void {
    let t:i64 = ps_trim(a, boff, loff, loff+llen);
    if (pk_len(t) == 0) { return; }
    let to:i64 = pk_off(t);
    let tl:i64 = pk_len(t);
    if (a[boff+to] == 35) { return; } // '#'
    let p:i64 = ps_tok(a, boff, to+tl, to);
    if (ps_tokeq(a, boff, p, "S")) { ps_h_S(a, boff, to, tl); return; }
    if (ps_tokeq(a, boff, p, "SYN")) { ps_h_lex2(a, boff, to, tl, 1); return; }
    if (ps_tokeq(a, boff, p, "ANT")) { ps_h_lex2(a, boff, to, tl, 2); return; }
    if (ps_tokeq(a, boff, p, "NUM")) { ps_h_lex2(a, boff, to, tl, 3); return; }
    if (ps_tokeq(a, boff, p, "STOP")) { ps_h_STOP(a, boff, to, tl); return; }
    if (ps_tokeq(a, boff, p, "FEAT")) { ps_h_FEAT(a, boff, to, tl); return; }
    if (ps_tokeq(a, boff, p, "RULE")) { ps_h_RULE(a, boff, to, tl); return; }
    if (ps_tokeq(a, boff, p, "FIX")) { ps_h_FIX(a, boff, to, tl); return; }
    if (ps_tokeq(a, boff, p, "PAIR")) { ps_h_PAIR(a, boff, to, tl); return; }
    if (ps_tokeq(a, boff, p, "TEXT")) { ps_h_TEXT(a, boff, to, tl); return; }
    if (ps_tokeq(a, boff, p, "ATOM")) { ps_h_ATOM(a, boff, to, tl); return; }
    if (ps_tokeq(a, boff, p, "STEP")) { ps_h_STEP(a, boff, to, tl); return; }
    if (ps_tokeq(a, boff, p, "IN")) { ps_h_IN(a, boff, to, tl); return; }
}

fn parse_spec(a:[]u8, boff:i64, blen:i64) void {
    let pos:i64 = 0;
    while (pos < blen) {
        let e:i64 = pos;
        while (e < blen && a[boff+e] != 10) { e = e + 1; }
        ps_line(a, boff, pos, e - pos);
        pos = e + 1;
    }
}

// w_util.zag — arena accessors, string pool, print/hex helpers.
// The arena is one []u8; layout constants come from w_layout.zag.
// All table values are little-endian i64.

fn u_p64(a:[]u8, off:i64, v:i64) void {
    a[off] = (v & 255) as u8;
    a[off+1] = ((v >> 8) & 255) as u8;
    a[off+2] = ((v >> 16) & 255) as u8;
    a[off+3] = ((v >> 24) & 255) as u8;
    a[off+4] = ((v >> 32) & 255) as u8;
    a[off+5] = ((v >> 40) & 255) as u8;
    a[off+6] = ((v >> 48) & 255) as u8;
    a[off+7] = ((v >> 56) & 255) as u8;
}

fn u_g64(a:[]u8, off:i64) i64 {
    let b0:i64 = a[off] as i64;
    let b1:i64 = a[off+1] as i64;
    let b2:i64 = a[off+2] as i64;
    let b3:i64 = a[off+3] as i64;
    let b4:i64 = a[off+4] as i64;
    let b5:i64 = a[off+5] as i64;
    let b6:i64 = a[off+6] as i64;
    let b7:i64 = a[off+7] as i64;
    return b0 + b1*256 + b2*65536 + b3*16777216 + b4*4294967296 + b5*1099511627776 + b6*281474976710656 + b7*72057594037927936;
}

fn u_p32(a:[]u8, off:i64, v:i64) void {
    a[off] = (v & 255) as u8;
    a[off+1] = ((v >> 8) & 255) as u8;
    a[off+2] = ((v >> 16) & 255) as u8;
    a[off+3] = ((v >> 24) & 255) as u8;
}

fn u_g32(a:[]u8, off:i64) i64 {
    return (a[off] as i64) + (a[off+1] as i64)*256 + (a[off+2] as i64)*65536 + (a[off+3] as i64)*16777216;
}

// header counter helpers
fn u_hget(a:[]u8, f:i64) i64 { return u_g64(a, f); }
fn u_hset(a:[]u8, f:i64, v:i64) void { u_p64(a, f, v); }
fn u_hbump(a:[]u8, f:i64) i64 {
    let v:i64 = u_g64(a, f) + 1;
    u_p64(a, f, v);
    return v - 1;
}

// ---- string pool ----
// sid -> (pool offset, length)
fn sp_add(a:[]u8, src:[]u8, off:i64, len:i64) i64 {
    let n:i64 = u_hget(a, H_NSTR());
    if (n >= C_MAXSTR()) { return -1; }
    let pu:i64 = u_hget(a, H_POOL_USED());
    if (pu + len > L_POOL_END() - L_POOL()) { return -1; }
    let i:i64 = 0;
    while (i < len) {
        a[L_POOL() + pu + i] = src[off + i];
        i = i + 1;
    }
    u_p64(a, L_STROFF() + n*8, pu);
    u_p64(a, L_STRLEN() + n*8, len);
    u_hset(a, H_POOL_USED(), pu + len);
    u_hset(a, H_NSTR(), n + 1);
    return n;
}

fn sp_off(a:[]u8, sid:i64) i64 { return u_g64(a, L_STROFF() + sid*8); }
fn sp_len(a:[]u8, sid:i64) i64 { return u_g64(a, L_STRLEN() + sid*8); }

fn sp_eq(a:[]u8, s1:i64, s2:i64) i64 {
    let l1:i64 = sp_len(a, s1);
    let l2:i64 = sp_len(a, s2);
    if (l1 != l2) { return 0; }
    let o1:i64 = L_POOL() + sp_off(a, s1);
    let o2:i64 = L_POOL() + sp_off(a, s2);
    let i:i64 = 0;
    while (i < l1) {
        if (a[o1+i] != a[o2+i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// compare pooled string sid against raw slice (src,off,len)
fn sp_eq_raw(a:[]u8, sid:i64, src:[]u8, off:i64, len:i64) i64 {
    if (sp_len(a, sid) != len) { return 0; }
    let o:i64 = L_POOL() + sp_off(a, sid);
    let i:i64 = 0;
    while (i < len) {
        if (a[o+i] != src[off+i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn sp_byte(a:[]u8, sid:i64, i:i64) i64 {
    return a[L_POOL() + sp_off(a, sid) + i] as i64;
}

// copy pooled string sid into work region; return work offset
fn sp_to_work(a:[]u8, sid:i64) i64 {
    let wu:i64 = u_hget(a, H_WORK_USED());
    let ln:i64 = sp_len(a, sid);
    let so:i64 = L_POOL() + sp_off(a, sid);
    let i:i64 = 0;
    while (i < ln) {
        a[L_WORK() + wu + i] = a[so + i];
        i = i + 1;
    }
    u_hset(a, H_WORK_USED(), wu + ln);
    return wu;
}

// ---- work bump allocator (L_WORK region) ----
fn wk_alloc(a:[]u8, n:i64) i64 {
    let wu:i64 = u_hget(a, H_WORK_USED());
    u_hset(a, H_WORK_USED(), wu + n);
    return wu;
}
fn wk_reset(a:[]u8) void { u_hset(a, H_WORK_USED(), 0); }

// ---- output buffer (L_OUT region, append-only) ----
fn out_bytes(a:[]u8, src:[]u8, off:i64, len:i64) void {
    let ou:i64 = u_hget(a, H_OUT_USED());
    let i:i64 = 0;
    while (i < len) {
        a[L_OUT() + ou + i] = src[off + i];
        i = i + 1;
    }
    u_hset(a, H_OUT_USED(), ou + len);
}
fn out_str(a:[]u8, s:[]u8) void { out_bytes(a, s, 0, s.len as i64); }
fn out_sid(a:[]u8, sid:i64) void {
    out_bytes(a, a, L_POOL() + sp_off(a, sid), sp_len(a, sid));
}

// ---- printing ----
fn u_i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if (s.len > 0 && s[s.len-1] == 10) { return s[0..s.len-1]; }
    return s;
}
fn u_print(s:[]u8) void { _zag_print(s); }
fn u_print_i(v:i64) void { _zag_print(u_i64s(v)); }

// hex-encode 32 bytes at (a,off) into 64 chars at (a,ooff)
fn u_hex32(a:[]u8, off:i64, ooff:i64) void {
    let dig:[]u8 = "0123456789abcdef";
    let i:i64 = 0;
    while (i < 32) {
        let b:i64 = a[off+i] as i64;
        a[ooff + i*2] = dig[(b >> 4) & 15];
        a[ooff + i*2 + 1] = dig[b & 15];
        i = i + 1;
    }
}

// decimal of v into caller buffer; returns byte count
fn u_i64dec(a:[]u8, off:i64, v:i64) i64 {
    if (v == 0) {
        a[off] = 48;
        return 1;
    }
    let neg:i64 = 0;
    let x:i64 = v;
    if (x < 0) {
        neg = 1;
        x = 0 - x;
    }
    let tmp:i64 = wk_alloc(a, 24);
    let n:i64 = 0;
    while (x > 0) {
        a[L_WORK()+tmp+n] = ((x % 10) + 48) as u8;
        x = x / 10;
        n = n + 1;
    }
    let o:i64 = 0;
    if (neg == 1) {
        a[off] = 45;
        o = 1;
    }
    let i:i64 = n - 1;
    while (i >= 0) {
        a[off+o] = a[L_WORK()+tmp+i];
        o = o + 1;
        i = i - 1;
    }
    return o;
}

// pooled-string slice
fn sp_slice(a:[]u8, sid:i64) []u8 {
    return a[L_POOL()+sp_off(a,sid) .. L_POOL()+sp_off(a,sid)+sp_len(a,sid)];
}

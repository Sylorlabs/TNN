// atomize.zag — fixed rule-based atomizer: sentence -> canonical atom string.
// Fragment: the templates frozen in FORKD_PREREG.md §1.3. Total function:
// every input yields an atom or "UNPARSED". Pure Zag, no RNG.

fn is_article(t:[]u8)i32 {
    if(seq(t,"the")==1){return 1;}
    if(seq(t,"a")==1){return 1;}
    if(seq(t,"an")==1){return 1;}
    return 0;
}

fn is_verb_is(t:[]u8)i32 {
    if(seq(t,"is")==1){return 1;}
    if(seq(t,"are")==1){return 1;}
    if(seq(t,"was")==1){return 1;}
    if(seq(t,"were")==1){return 1;}
    return 0;
}

// phrase tokens [a..b) -> canonical token (articles dropped, joined with _).
fn phrase_canon(s:[]u8,a:i32,b:i32)[]u8 {
    let o:[]u8 = nio_alloc(128);
    if(o.len==0){return "";}
    let p:i32=0;
    let i:i32=a;
    let first:i32=1;
    while(i<b){
        let t:[]u8 = tok(s,i);
        if(is_article(t)==0 && t.len>0){
            if(first==0){o[p]=95;p=p+1;}
            let c:[]u8 = canon_tok(t);
            let k:i32=0;
            while(k<c.len){o[p]=c[k];p=p+1;k=k+1;}
            first=0;
        }
        i=i+1;
    }
    return o[0..p];
}

// find token sequence; returns start index or -1.
fn find_seq(s:[]u8,n:i32,w0:[]u8,w1:[]u8,w2:[]u8,w3:[]u8)i32 {
    let i:i32=0;
    while(i<n){
        if(seq(tok(s,i),w0)==1){
            let ok:i32=1;
            if(w1.len>0 && (i+1>=n || seq(tok(s,i+1),w1)==0)){ok=0;}
            if(w2.len>0 && (i+2>=n || seq(tok(s,i+2),w2)==0)){ok=0;}
            if(w3.len>0 && (i+3>=n || seq(tok(s,i+3),w3)==0)){ok=0;}
            if(ok==1){return i;}
        }
        i=i+1;
    }
    return -1;
}

// find first token in verb set; returns index or -1.
fn find_verb_idx(s:[]u8,n:i32,from:i32)i32 {
    let i:i32=from;
    while(i<n){
        let t:[]u8 = tok(s,i);
        if(is_verb_is(t)==1){return i;}
        if(seq(t,"sat")==1){return i;}
        if(seq(t,"sits")==1){return i;}
        if(seq(t,"sit")==1){return i;}
        if(seq(t,"sitting")==1){return i;}
        if(seq(t,"lies")==1){return i;}
        if(seq(t,"caused")==1){return i;}
        if(seq(t,"comes")==1){return i;}
        if(seq(t,"preceded")==1){return i;}
        if(seq(t,"did")==1){return i;}
        i=i+1;
    }
    return -1;
}

// atomize one sentence -> atom string or "UNPARSED".
fn atomize_sentence(sent:[]u8)[]u8 {
    let s:[]u8 = strim(slowcase(sent));
    if(s.len==0){return "UNPARSED";}
    if(ends_with(s,".")==1){s=s[0..s.len-1];}
    s=strim(s);
    let n:i32 = ntok(s);
    if(n<3){return "UNPARSED";}

    let q:[]u8 = "UNIT";
    let pol:[]u8 = "POS";
    let qo:i32 = 0; // tokens consumed by quantifier

    let t0:[]u8 = tok(s,0);
    if(seq(t0,"all")==1){q="ALL";qo=1;}
    if(seq(t0,"some")==1){q="SOME";qo=1;}
    if(seq(t0,"only")==1){q="ONLY";qo=1;}
    if(seq(t0,"no")==1){q="ALL";pol="NEG";qo=1;}
    if(seq(t0,"not")==1 && n>1 && seq(tok(s,1),"all")==1){q="SOME";pol="NEG";qo=2;}

    // T6 passive: "{O} was sat on by {S}."
    let pi:i32 = find_seq(s,n,"was","sat","on","by");
    if(pi>qo){
        let subj:[]u8 = phrase_canon(s,pi+4,n);
        let obj:[]u8 = phrase_canon(s,qo,pi);
        if(subj.len==0 || obj.len==0){return "UNPARSED";}
        return mk_atom(q,subj,pol,"LOC_ON",obj);
    }

    let vi:i32 = find_verb_idx(s,n,qo);
    if(vi<0){return "UNPARSED";}
    let verb:[]u8 = tok(s,vi);
    let subj:[]u8 = phrase_canon(s,qo,vi);
    if(subj.len==0){return "UNPARSED";}

    // "did [not] sit on" branch.
    if(seq(verb,"did")==1){
        if(vi+2>=n){return "UNPARSED";}
        let t1:[]u8 = tok(s,vi+1);
        let v2:[]u8 = tok(s,vi+2);
        let adv:i32 = vi+2;
        if(seq(t1,"not")==1 || ends_with(t1,"n't")==1){pol="NEG";adv=vi+3;v2=tok(s,adv-1);}
        if(seq(v2,"sit")==1 && adv<n && seq(tok(s,adv),"on")==1){
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"LOC_ON",obj);
        }
        return "UNPARSED";
    }

    // negation after copula/verb.
    let adv:i32 = vi+1;
    if(adv<n){
        let ta:[]u8 = tok(s,adv);
        if(seq(ta,"not")==1 || ends_with(ta,"n't")==1){pol="NEG";adv=adv+1;}
    }
    if(adv>=n){return "UNPARSED";}
    let w:[]u8 = tok(s,adv);

    // "{O} caused {S}." — subject/object swap.
    if(seq(verb,"caused")==1){
        let obj:[]u8 = phrase_canon(s,adv,n);
        if(obj.len==0){return "UNPARSED";}
        return mk_atom(q,obj,pol,"CAUSED_BY",subj);
    }
    // "{S} preceded {O}." / "{S} comes before {O}."
    if(seq(verb,"preceded")==1){
        let obj:[]u8 = phrase_canon(s,adv,n);
        if(obj.len==0){return "UNPARSED";}
        return mk_atom(q,subj,pol,"BEFORE",obj);
    }
    if(seq(verb,"comes")==1){
        if(seq(w,"before")==1){
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"BEFORE",obj);
        }
        return "UNPARSED";
    }
    // "{S} sat/sits/sit on {O}." (T3; "under" is not a frozen template —
    // F6 flips render via T4 "is under", so "sat under" is UNPARSED.)
    if(seq(verb,"sat")==1 || seq(verb,"sits")==1 || seq(verb,"sit")==1){
        if(seq(w,"on")==1){
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"LOC_ON",obj);
        }
        return "UNPARSED";
    }
    // "{S} lies in {O}."
    if(seq(verb,"lies")==1){
        if(seq(w,"in")==1){
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"LOC_IN",obj);
        }
        return "UNPARSED";
    }
    // copula branch.
    if(is_verb_is(verb)==1){
        // "is sitting on"
        if(seq(w,"sitting")==1 && adv+1<n && seq(tok(s,adv+1),"on")==1){
            let obj:[]u8 = phrase_canon(s,adv+2,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"LOC_ON",obj);
        }
        // "is a {O}" / "is an {O}" / "is a sibling of {O}"
        if(seq(w,"a")==1 || seq(w,"an")==1){
            if(adv+2<n && seq(tok(s,adv+1),"sibling")==1 && seq(tok(s,adv+2),"of")==1){
                let obj:[]u8 = phrase_canon(s,adv+3,n);
                if(obj.len==0){return "UNPARSED";}
                return mk_atom(q,subj,pol,"SIBLING_OF",obj);
            }
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"IS_A",obj);
        }
        // "is part of {O}"
        if(seq(w,"part")==1 && adv+1<n && seq(tok(s,adv+1),"of")==1){
            let obj:[]u8 = phrase_canon(s,adv+2,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"PART_OF",obj);
        }
        // "was caused by {O}"
        if(seq(w,"caused")==1 && adv+1<n && seq(tok(s,adv+1),"by")==1){
            let obj:[]u8 = phrase_canon(s,adv+2,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"CAUSED_BY",obj);
        }
        // locatives
        if(seq(w,"on")==1){
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"LOC_ON",obj);
        }
        if(seq(w,"under")==1 || seq(w,"below")==1 || seq(w,"beneath")==1){
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"LOC_UNDER",obj);
        }
        if(seq(w,"in")==1 || seq(w,"inside")==1){
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"LOC_IN",obj);
        }
        // "is before {O}" / "is after {O}" (after swaps)
        if(seq(w,"before")==1){
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            return mk_atom(q,subj,pol,"BEFORE",obj);
        }
        if(seq(w,"after")==1){
            let obj:[]u8 = phrase_canon(s,adv+1,n);
            if(obj.len==0){return "UNPARSED";}
            // "{O} is after {S}" -> (S,BEFORE,O)
            return mk_atom(q,obj,pol,"BEFORE",subj);
        }
        // "{S} is {N} {A}." numeric property
        let num:[]u8 = canon_num(w);
        if(num.len>0 && adv+1<n){
            let adj:[]u8 = tok(s,adv+1);
            if(is_adj(adj)==1){
                let o:[]u8 = cat3(adj,":",num);
                // antonym-negation on the adj part handled via NEGADJ below
                let a2:[]u8 = adj;
                let p2:[]u8 = pol;
                if(seq(pol,"NEG")==1){
                    let na:[]u8 = tab_get(TAB_NEGADJ(),adj);
                    if(na.len>0){a2=na;p2="POS";}
                }
                o=cat3(a2,":",num);
                return mk_atom(q,subj,p2,"PROP_NUM",o);
            }
        }
        // "{S} is {A}." adjective property
        if(is_adj(w)==1){
            let a2:[]u8 = w;
            let p2:[]u8 = pol;
            if(seq(pol,"NEG")==1){
                let na:[]u8 = tab_get(TAB_NEGADJ(),w);
                if(na.len>0){a2=na;p2="POS";}
            }
            return mk_atom(q,subj,p2,"HAS_PROPERTY",a2);
        }
        // T13 bare-noun IS_A: "all cats are mammals.", "no cats are birds."
        let obj:[]u8 = phrase_canon(s,adv,n);
        if(obj.len>0){
            return mk_atom(q,subj,pol,"IS_A",obj);
        }
        return "UNPARSED";
    }

    return "UNPARSED";
}

// atomize all non-empty lines of a draft -> "\n"-joined atoms (UNPARSED included).
fn atomize_draft(draft:[]u8)[]u8 {
    let o:[]u8 = nio_alloc(8192);
    if(o.len==0){return "";}
    let p:i32=0;
    let nl:i32 = nlines(draft);
    let i:i32=0;
    while(i<nl){
        let ln:[]u8 = strim(gline(draft,i));
        if(ln.len>0){
            let a:[]u8 = atomize_sentence(ln);
            let k:i32=0;
            while(k<a.len){o[p]=a[k];p=p+1;k=k+1;}
            o[p]=10;p=p+1;
        }
        i=i+1;
    }
    return o[0..p];
}

// main2.zag — forkd2 driver: fork D's discipline over the write-once
// evidence partition. Modes via argv[1] (argc is 0 on znc).
//   forkd2 atomize <sentences>
//   forkd2 attest <extpart>                       -> OK|... / FAIL|reason
//   forkd2 verdict2 <draft> <extpart> <genpart> <delib>
//   forkd2 battery2 <manifest2>                   -> case|verdict|expected|match
// Pure Zag, no RNG.

@import("io.zag")
@import("str.zag")
@import("tables.zag")
@import("atom.zag")
@import("atomize.zag")
@import("prover.zag")
@import("delib.zag")
@import("genesis.zag")
@import("part.zag")

fn buf_put(buf:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){buf[pos]=s[i];pos=pos+1;i=i+1;}
    return pos;
}

// "1|..." -> 1 ; "0|..." -> 0.
fn attest_ok(r:[]u8)i32 {
    if(r.len>=2 && r[0]==49 && r[1]==124){return 1;}
    return 0;
}

// atoms payload after the "1|" / "0|" prefix.
fn attest_body(r:[]u8)[]u8 {
    if(r.len>=2){return r[2..r.len];}
    return "";
}

// attest_fail_reason(r): text after "0|".
fn attest_reason(r:[]u8)[]u8 {
    return attest_body(r);
}

// Full verdict logic over attested partitions.
// Precomputed: ext_cl (EXT closure), full_cl (EXT+GEN closure),
// extw ("\n"-wrapped attested EXT atoms), delib. Pure per-draft work only.
// Writes "V\natom|SV|TV|note\n..." into rep; returns used byte count.
fn run_verdict2(draft:[]u8,ext_cl:[]u8,full_cl:[]u8,extw:[]u8,delib:[]u8,rep:[]u8)i64 {
    let p:i32=0;
    let install:i32=1;
    let atoms:[]u8 = atomize_draft(draft);
    let na:i32 = nlines(atoms);
    let i:i32=0;
    p=buf_put(rep,p,"........\n");
    while(i<na){
        let a:[]u8 = strim(gline(atoms,i));
        if(a.len>0){
            let sv:[]u8 = "?";
            let tv:[]u8 = "?";
            let note:[]u8 = "";
            if(seq(a,"UNPARSED")==1){
                sv="UNPARSED";tv="UNPARSED";install=0;
            } else {
                let pr:[]u8 = prove_atom(ext_cl,full_cl,a);
                let vc:u8 = pr[0];
                if(vc==69){sv="ENTAILED";}
                if(vc==67){sv="CONTRADICTED";}
                if(vc==85){sv="UNGROUNDED";}
                if(pr.len>2){note=pr[2..pr.len];}
                tv=trace_check_atom(extw,delib,a);
                if(seq(sv,"ENTAILED")==0 || seq(tv,"EARNED")==0){install=0;}
            }
            p=buf_put(rep,p,a);
            p=buf_put(rep,p,"|");
            p=buf_put(rep,p,sv);
            p=buf_put(rep,p,"|");
            p=buf_put(rep,p,tv);
            p=buf_put(rep,p,"|");
            p=buf_put(rep,p,note);
            p=buf_put(rep,p,"\n");
        }
        i=i+1;
    }
    let v:[]u8 = "WITHHOLD";
    if(install==1){v="INSTALL";}
    if(seq(v,"INSTALL")==1){
        let k2:i32=0;
        while(k2<7){rep[k2]=v[k2];k2=k2+1;}
        rep[7]=10;
        let m2:i32=9;
        while(m2<p){rep[m2-1]=rep[m2];m2=m2+1;}
        p=p-1;
    } else {
        let k3:i32=0;
        while(k3<8){rep[k3]=v[k3];k3=k3+1;}
        rep[8]=10;
    }
    return p as i64;
}

// Fail-closed verdict: every atom cited partition-void.
fn run_verdict_void(draft:[]u8,why:[]u8,rep:[]u8)i64 {
    let p:i32=0;
    p=buf_put(rep,p,"WITHHOLD\n");
    let atoms:[]u8 = atomize_draft(draft);
    let na:i32 = nlines(atoms);
    let i:i32=0;
    while(i<na){
        let a:[]u8 = strim(gline(atoms,i));
        if(a.len>0){
            p=buf_put(rep,p,a);
            p=buf_put(rep,p,"|");
            p=buf_put(rep,p,why);
            p=buf_put(rep,p,"|");
            p=buf_put(rep,p,why);
            p=buf_put(rep,p,"|partition-void\n");
        }
        i=i+1;
    }
    return p as i64;
}

fn verdict_of_rep(rep:[]u8,n:i64)[]u8 {
    let first:[]u8 = strim(gline(rep,0));
    return first;
}

fn mode_atomize(path:[]u8)void {
    let t:[]u8 = file_read(path);
    let o:[]u8 = atomize_draft(t);
    pout(o);
    emit_digest(o);
    return;
}

fn mode_attest(path:[]u8)void {
    let t:[]u8 = file_read(path);
    let r:[]u8 = attest_ext(t);
    let o:[]u8 = nio_alloc(256);
    if(o.len==0){return;}
    let p:i32=0;
    if(attest_ok(r)==1){
        // OK|<tag>|<n>|<tip>
        p=buf_put(o,p,"OK");
    } else {
        p=buf_put(o,p,"FAIL|");
        p=buf_put(o,p,attest_reason(r));
    }
    p=buf_put(o,p,"\n");
    let ob:[]u8 = o[0..p];
    pout(ob);
    emit_digest(ob);
    return;
}

fn mode_verdict2(dp:[]u8,ep:[]u8,gp:[]u8,lp:[]u8)void {
    let draft:[]u8 = file_read(dp);
    let er:[]u8 = attest_ext(file_read(ep));
    let gr:[]u8 = verify_gen(file_read(gp));
    let rep:[]u8 = nio_alloc(65536);
    if(rep.len==0){return;}
    let n:i64=0;
    if(attest_ok(er)==0){
        n=run_verdict_void(draft,"EXT_UNVERIFIED",rep);
    } else {
        if(attest_ok(gr)==0){
            n=run_verdict_void(draft,"GEN_UNVERIFIED",rep);
        } else {
            let delib:[]u8 = file_read(lp);
            let ea:[]u8 = attest_body(er);
            let ga:[]u8 = attest_body(gr);
            let ext_cl:[]u8 = closure_full_atoms(ea);
            let full_cl:[]u8 = closure_full_atoms(cat2(ea,ga));
            let extw:[]u8 = cat2("\n",ea);
            n=run_verdict2(draft,ext_cl,full_cl,extw,delib,rep);
        }
    }
    let ob:[]u8 = rep[0..n as i32];
    pout(ob);
    emit_digest(ob);
    return;
}

fn dir_of(p:[]u8)[]u8 {
    let li:i32=-1;
    let i:i32=0;
    while(i<p.len){
        if(p[i]==47){li=i;}
        i=i+1;
    }
    if(li<0){return "";}
    return p[0..li];
}

fn join_dir(dir:[]u8,rel:[]u8)[]u8 {
    if(dir.len==0){return rel;}
    return cat3(dir,"/",rel);
}

fn mode_battery2(manifest_p:[]u8)void {
    let man:[]u8 = file_read(manifest_p);
    let mdir:[]u8 = dir_of(manifest_p);
    let o:[]u8 = nio_alloc(1048576);
    if(o.len==0){return;}
    let p:i32=0;
    // attestation cache: partitions are shared across a manifest's cases;
    // re-attesting per case is pure waste (WOTS verify is the hot cost).
    // Closures are pure functions of the verified partitions: compute once.
    let last_ep:[]u8 = "";
    let last_er:[]u8 = "";
    let last_gp:[]u8 = "";
    let last_gr:[]u8 = "";
    let last_ext_cl:[]u8 = "";
    let last_full_cl:[]u8 = "";
    let last_extw:[]u8 = "";
    let nm:i32 = nlines(man);
    let i:i32=0;
    while(i<nm){
        let ln:[]u8 = strim(gline(man,i));
        if(ln.len>0){
            // case|draft|extpart|genpart|delib|expected — split on '|'.
            let fends:[]u8 = nio_alloc(32);
            let nf2:i32=0;
            if(fends.len>0){
                let fi:i32=0;
                while(fi<ln.len){
                    if(ln[fi]==124){
                        if(nf2<8){fends[nf2]=(fi as i64) as u8;}
                        nf2=nf2+1;
                    }
                    fi=fi+1;
                }
            }
            // need 5 separators.
            if(nf2==5){
                let p0:i32=fends[0] as i32;
                let p1:i32=fends[1] as i32;
                let p2:i32=fends[2] as i32;
                let p3:i32=fends[3] as i32;
                let p4:i32=fends[4] as i32;
                let case:[]u8 = ln[0..p0];
                let dp2:[]u8 = join_dir(mdir,ln[p0+1..p1]);
                let ep2:[]u8 = join_dir(mdir,ln[p1+1..p2]);
                let gp2:[]u8 = join_dir(mdir,ln[p2+1..p3]);
                let lp2:[]u8 = join_dir(mdir,ln[p3+1..p4]);
                let exp:[]u8 = ln[p4+1..ln.len];
                let draft:[]u8 = file_read(dp2);
                let er:[]u8 = last_er;
                let gr:[]u8 = last_gr;
                let ext_cl:[]u8 = last_ext_cl;
                let full_cl:[]u8 = last_full_cl;
                let extw:[]u8 = last_extw;
                if(seq(ep2,last_ep)==0 || seq(gp2,last_gp)==0){
                    er=attest_ext(file_read(ep2));
                    gr=verify_gen(file_read(gp2));
                    last_ep=ep2;last_er=er;
                    last_gp=gp2;last_gr=gr;
                    last_ext_cl="";last_full_cl="";last_extw="";
                    if(attest_ok(er)==1 && attest_ok(gr)==1){
                        let ea:[]u8 = attest_body(er);
                        let ga:[]u8 = attest_body(gr);
                        last_ext_cl=closure_full_atoms(ea);
                        last_full_cl=closure_full_atoms(cat2(ea,ga));
                        last_extw=cat2("\n",ea);
                    }
                    ext_cl=last_ext_cl;full_cl=last_full_cl;extw=last_extw;
                }
                let rep:[]u8 = nio_alloc(65536);
                let v:[]u8 = "WITHHOLD";
                if(rep.len>0){
                    let nn:i64=0;
                    if(attest_ok(er)==0){
                        nn=run_verdict_void(draft,"EXT_UNVERIFIED",rep);
                    } else {
                        if(attest_ok(gr)==0){
                            nn=run_verdict_void(draft,"GEN_UNVERIFIED",rep);
                        } else {
                            let delib:[]u8 = file_read(lp2);
                            nn=run_verdict2(draft,ext_cl,full_cl,extw,delib,rep);
                        }
                    }
                    v=verdict_of_rep(rep,nn);
                }
                let m:[]u8 = "0";
                if(seq(v,exp)==1){m="1";}
                p=buf_put(o,p,case);
                p=buf_put(o,p,"|");
                p=buf_put(o,p,v);
                p=buf_put(o,p,"|");
                p=buf_put(o,p,exp);
                p=buf_put(o,p,"|");
                p=buf_put(o,p,m);
                p=buf_put(o,p,"\n");
            }
        }
        i=i+1;
    }
    let ob:[]u8 = o[0..p];
    pout(ob);
    emit_digest(ob);
    return;
}

fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    if(seq(mode,"atomize")==1){
        mode_atomize(_zag_arg(2));
        return 0;
    }
    if(seq(mode,"attest")==1){
        mode_attest(_zag_arg(2));
        return 0;
    }
    if(seq(mode,"verdict2")==1){
        mode_verdict2(_zag_arg(2),_zag_arg(3),_zag_arg(4),_zag_arg(5));
        return 0;
    }
    if(seq(mode,"battery2")==1){
        mode_battery2(_zag_arg(2));
        return 0;
    }
    perr("usage: forkd2 <atomize|attest|verdict2|battery2> ...\n");
    return 2;
}

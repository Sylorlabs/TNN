// part.zag — write-once evidence partition: parse, WOTS verify, attest.
// The trust root: pinned genesis keys (genesis.zag) + deterministic SHA256
// arithmetic. No labels. Pure Zag, no RNG.
// Callee-before-caller order (znc forward-reference miscompile).

fn hexval(c:u8)i32 {
    if(c>=48 && c<=57){return (c as i32)-48;}
    if(c>=97 && c<=102){return (c as i32)-87;}
    if(c>=65 && c<=70){return (c as i32)-55;}
    return -1;
}

// hex (2n chars) -> out (n bytes). Returns 1 on success, 0 on bad hex/len.
fn hex_to_bytes(hex:[]u8,out:[]u8)i32 {
    if(out.len*2!=hex.len){return 0;}
    let i:i32=0;
    while(i<out.len){
        let hi:i32=hexval(hex[2*i]);
        let lo:i32=hexval(hex[2*i+1]);
        if(hi<0 || lo<0){return 0;}
        out[i]=((hi*16+lo) as i32) as u8;
        i=i+1;
    }
    return 1;
}

fn parse_dec(s:[]u8)i32 {
    if(s.len==0){return -1;}
    let v:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c<48 || c>57){return -1;}
        v=v*10+((c as i32)-48);
        i=i+1;
    }
    return v;
}

// k-th '|' separated field (0-based) of ln; "" if absent.
fn field_k(ln:[]u8,k:i32)[]u8 {
    let f:i32=0;
    let i:i32=0;
    let st:i32=0;
    while(i<=ln.len){
        let c:u8=10;
        if(i<ln.len){c=ln[i];}
        if(c==124 || i==ln.len){
            if(f==k){return ln[st..i];}
            f=f+1;
            st=i+1;
        }
        i=i+1;
    }
    return "";
}

fn nfields(ln:[]u8)i32 {
    if(ln.len==0){return 0;}
    let n:i32=1;
    let i:i32=0;
    while(i<ln.len){
        if(ln[i]==124){n=n+1;}
        i=i+1;
    }
    return n;
}

fn sha256b(data:[]u8)[]u8 {
    let o:[]u8 = nio_alloc(32);
    if(o.len==0){return "";}
    if(ns_sha256(data,o)!=0){return "";}
    return o;
}

// apply SHA256 n times (n>=0).
fn sha256_pow(data:[]u8,n:i32)[]u8 {
    let cur:[]u8 = data;
    let i:i32=0;
    while(i<n){
        cur=sha256b(cur);
        if(cur.len==0){return "";}
        i=i+1;
    }
    return cur;
}

// WOTS (w=16, 67 chains) signature verification.
// auth_pk: 32-byte authorizing key; tag, atom (5-field "Q|S|POL|R|O"),
// pknext: 32 bytes; prev: 32 bytes; sig: 2144 bytes.
// Returns 1 iff valid.
fn wots_verify(auth_pk:[]u8,tag:[]u8,atom:[]u8,pknext:[]u8,prev:[]u8,sig:[]u8)i32 {
    if(auth_pk.len!=32 || pknext.len!=32 || prev.len!=32 || sig.len!=2144){return 0;}
    // m = SHA256(tag || atom || pknext || prev)
    let ml:i32 = tag.len+atom.len+64;
    let m:[]u8 = nio_alloc(ml);
    if(m.len==0){return 0;}
    let p:i32=0;
    let k:i32=0;
    while(k<tag.len){m[p]=tag[k];p=p+1;k=k+1;}
    k=0;
    while(k<atom.len){m[p]=atom[k];p=p+1;k=k+1;}
    k=0;
    while(k<32){m[p]=pknext[k];p=p+1;k=k+1;}
    k=0;
    while(k<32){m[p]=prev[k];p=p+1;k=k+1;}
    let dg:[]u8 = sha256b(m[0..p]);
    if(dg.len!=32){return 0;}
    // 64 message nibbles (high first) + 3 checksum nibbles, big-endian.
    let ds:[]u8 = nio_alloc(67);
    if(ds.len==0){return 0;}
    let di:i32=0;
    let bi:i32=0;
    while(bi<32){
        let bv:i32 = dg[bi] as i32;
        ds[di]=(bv/16) as u8;di=di+1;
        ds[di]=(bv%16) as u8;di=di+1;
        bi=bi+1;
    }
    let ck:i32=0;
    let ci:i32=0;
    while(ci<64){ck=ck+(15-(ds[ci] as i32));ci=ci+1;}
    ds[64]=((ck/256)%16) as u8;
    ds[65]=((ck/16)%16) as u8;
    ds[66]=(ck%16) as u8;
    // tips_j = SHA256^{d_j}(sig_j)
    let tips:[]u8 = nio_alloc(67*32);
    if(tips.len==0){return 0;}
    let j:i32=0;
    while(j<67){
        let sj:[]u8 = sig[j*32..j*32+32];
        let t:[]u8 = sha256_pow(sj,ds[j] as i32);
        if(t.len!=32){return 0;}
        let q2:i32=0;
        while(q2<32){tips[j*32+q2]=t[q2];q2=q2+1;}
        j=j+1;
    }
    let pcomp:[]u8 = sha256b(tips);
    if(pcomp.len!=32){return 0;}
    if(seq(pcomp,auth_pk)==1){return 1;}
    return 0;
}

// attest_ext(text) -> "1|<atoms>" (atoms: 5-field lines) or "0|<reason>".
// Full re-verification from the pinned genesis: tag lookup, atom
// well-formedness, prev linkage, WOTS signature per entry.
fn attest_ext(text:[]u8)[]u8 {
    let nl:i32 = nlines(text);
    if(nl<1){return "0|empty-partition";}
    let hdr:[]u8 = strim(gline(text,0));
    if(nfields(hdr)!=3){return "0|bad-header";}
    if(seq(field_k(hdr,0),"PART")==0){return "0|bad-header";}
    let tag:[]u8 = field_k(hdr,1);
    let want:i32 = parse_dec(field_k(hdr,2));
    if(want<0){return "0|bad-count";}
    if(nl-1!=want){return "0|count-mismatch";}
    let gpk_hex:[]u8 = genesis_lookup(tag);
    if(gpk_hex.len!=64){return "0|unknown-tag";}
    let auth:[]u8 = nio_alloc(32);
    if(auth.len==0){return "0|alloc-fail";}
    if(hex_to_bytes(gpk_hex,auth)==0){return "0|bad-genesis";}
    let prev:[]u8 = nio_alloc(32);
    if(prev.len==0){return "0|alloc-fail";}
    // nio_alloc is NOT reliably zeroed: explicit zeroing (genesis prev).
    let zi:i32=0;
    while(zi<32){prev[zi]=0;zi=zi+1;}
    let atoms:[]u8 = nio_alloc(1048576);
    if(atoms.len==0){return "0|alloc-fail";}
    let ap:i32=0;
    let idx:i32=0;
    while(idx<want){
        let ln:[]u8 = strim(gline(text,idx+1));
        if(nfields(ln)!=10){return "0|malformed-entry";}
        if(seq(field_k(ln,0),"ENTRY")==0){return "0|malformed-entry";}
        if(seq(field_k(ln,1),tag)==0){return "0|tag-mismatch";}
        let atom:[]u8 = mk_atom(field_k(ln,2),field_k(ln,3),field_k(ln,4),field_k(ln,5),field_k(ln,6));
        if(atom_valid(atom)==0){return "0|bad-atom";}
        let prev_h:[]u8 = field_k(ln,7);
        let pknext_h:[]u8 = field_k(ln,8);
        let sig_h:[]u8 = field_k(ln,9);
        if(prev_h.len!=64 || pknext_h.len!=64 || sig_h.len!=4288){return "0|bad-hexlen";}
        let prev_b:[]u8 = nio_alloc(32);
        let pknext_b:[]u8 = nio_alloc(32);
        let sig_b:[]u8 = nio_alloc(2144);
        if(prev_b.len==0 || pknext_b.len==0 || sig_b.len==0){return "0|alloc-fail";}
        if(hex_to_bytes(prev_h,prev_b)==0){return "0|bad-hex";}
        if(hex_to_bytes(pknext_h,pknext_b)==0){return "0|bad-hex";}
        if(hex_to_bytes(sig_h,sig_b)==0){return "0|bad-hex";}
        if(seq(prev_b,prev)==0){return "0|prev-mismatch";}
        if(wots_verify(auth,tag,atom,pknext_b,prev_b,sig_b)==0){return "0|sig-invalid";}
        let k2:i32=0;
        while(k2<atom.len){atoms[ap]=atom[k2];ap=ap+1;k2=k2+1;}
        atoms[ap]=10;ap=ap+1;
        // prev = SHA256(prev || atom || pknext || sig)
        let pl:i32 = 32+atom.len+32+2144;
        let pb:[]u8 = nio_alloc(pl);
        if(pb.len==0){return "0|alloc-fail";}
        let pp:i32=0;
        k2=0;
        while(k2<32){pb[pp]=prev_b[k2];pp=pp+1;k2=k2+1;}
        k2=0;
        while(k2<atom.len){pb[pp]=atom[k2];pp=pp+1;k2=k2+1;}
        k2=0;
        while(k2<32){pb[pp]=pknext_b[k2];pp=pp+1;k2=k2+1;}
        k2=0;
        while(k2<2144){pb[pp]=sig_b[k2];pp=pp+1;k2=k2+1;}
        prev=sha256b(pb[0..pp]);
        if(prev.len!=32){return "0|hash-fail";}
        auth=pknext_b;
        idx=idx+1;
    }
    return cat2("1|",atoms[0..ap]);
}

// verify_gen(text) -> "1|<atoms>" or "0|<reason>".
// Unsigned GEN partition: re-verify the hash chain only.
fn verify_gen(text:[]u8)[]u8 {
    let nl:i32 = nlines(text);
    if(nl<1){return "0|empty-partition";}
    let hdr:[]u8 = strim(gline(text,0));
    if(nfields(hdr)!=4){return "0|bad-header";}
    if(seq(field_k(hdr,0),"PART")==0){return "0|bad-header";}
    let tag:[]u8 = field_k(hdr,1);
    if(seq(field_k(hdr,2),"gen")==0){return "0|bad-header";}
    let want:i32 = parse_dec(field_k(hdr,3));
    if(want<0){return "0|bad-count";}
    if(nl-1!=want){return "0|count-mismatch";}
    let prev:[]u8 = nio_alloc(32);
    if(prev.len==0){return "0|alloc-fail";}
    let zi:i32=0;
    while(zi<32){prev[zi]=0;zi=zi+1;}
    let atoms:[]u8 = nio_alloc(1048576);
    if(atoms.len==0){return "0|alloc-fail";}
    let ap:i32=0;
    let idx:i32=0;
    while(idx<want){
        let ln:[]u8 = strim(gline(text,idx+1));
        if(nfields(ln)!=8){return "0|malformed-entry";}
        if(seq(field_k(ln,0),"GENENTRY")==0){return "0|malformed-entry";}
        if(seq(field_k(ln,1),tag)==0){return "0|tag-mismatch";}
        let atom:[]u8 = mk_atom(field_k(ln,2),field_k(ln,3),field_k(ln,4),field_k(ln,5),field_k(ln,6));
        if(atom_valid(atom)==0){return "0|bad-atom";}
        let prev_h:[]u8 = field_k(ln,7);
        if(prev_h.len!=64){return "0|bad-hexlen";}
        let prev_b:[]u8 = nio_alloc(32);
        if(prev_b.len==0){return "0|alloc-fail";}
        if(hex_to_bytes(prev_h,prev_b)==0){return "0|bad-hex";}
        if(seq(prev_b,prev)==0){return "0|prev-mismatch";}
        let k2:i32=0;
        while(k2<atom.len){atoms[ap]=atom[k2];ap=ap+1;k2=k2+1;}
        atoms[ap]=10;ap=ap+1;
        // prev = SHA256(prev || atom)
        let pl2:i32 = 32+atom.len;
        let pb2:[]u8 = nio_alloc(pl2);
        if(pb2.len==0){return "0|alloc-fail";}
        let pp2:i32=0;
        k2=0;
        while(k2<32){pb2[pp2]=prev_b[k2];pp2=pp2+1;k2=k2+1;}
        k2=0;
        while(k2<atom.len){pb2[pp2]=atom[k2];pp2=pp2+1;k2=k2+1;}
        prev=sha256b(pb2[0..pp2]);
        if(prev.len!=32){return "0|hash-fail";}
        idx=idx+1;
    }
    return cat2("1|",atoms[0..ap]);
}

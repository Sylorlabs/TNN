// atom.zag — canonical atom ops. An atom is the string "Q|S|POL|R|O".
// Field index: 0=Q 1=S 2=POL 3=R 4=O. Pure Zag, no RNG.

fn af(atom:[]u8,idx:i32)[]u8 {
    let f:i32=0;
    let i:i32=0;
    let st:i32=0;
    while(i<=atom.len){
        let c:u8=10;
        if(i<atom.len){c=atom[i];}
        if(c==124 || i==atom.len){
            if(f==idx){return atom[st..i];}
            f=f+1;
            st=i+1;
        }
        i=i+1;
    }
    return "";
}

fn mk_atom(q:[]u8,s:[]u8,pol:[]u8,r:[]u8,o:[]u8)[]u8 {
    let o1:[]u8 = nio_alloc(q.len+s.len+pol.len+r.len+o.len+8);
    if(o1.len==0){return "";}
    let p:i32=0;
    let k:i32=0;
    while(k<q.len){o1[p]=q[k];p=p+1;k=k+1;}
    o1[p]=124;p=p+1;
    k=0;
    while(k<s.len){o1[p]=s[k];p=p+1;k=k+1;}
    o1[p]=124;p=p+1;
    k=0;
    while(k<pol.len){o1[p]=pol[k];p=p+1;k=k+1;}
    o1[p]=124;p=p+1;
    k=0;
    while(k<r.len){o1[p]=r[k];p=p+1;k=k+1;}
    o1[p]=124;p=p+1;
    k=0;
    while(k<o.len){o1[p]=o[k];p=p+1;k=k+1;}
    return o1[0..p];
}

fn atom_neg(a:[]u8)[]u8 {
    let pol:[]u8 = af(a,2);
    let np:[]u8 = "POS";
    if(seq(pol,"POS")==1){np="NEG";}
    return mk_atom(af(a,0),af(a,1),np,af(a,3),af(a,4));
}

fn atom_valid(a:[]u8)i32 {
    // 5-field atom (4 pipes) or 6-field store line (5 pipes + PROV).
    let bars:i32=0;
    let i:i32=0;
    while(i<a.len){
        if(a[i]==124){bars=bars+1;}
        i=i+1;
    }
    if(bars!=4 && bars!=5){return 0;}
    let k:i32=0;
    while(k<5){
        if(af(a,k).len==0){return 0;}
        k=k+1;
    }
    let q:[]u8=af(a,0);
    let qok:i32=0;
    if(seq(q,"UNIT")==1){qok=1;}
    if(seq(q,"ALL")==1){qok=1;}
    if(seq(q,"SOME")==1){qok=1;}
    if(seq(q,"ONLY")==1){qok=1;}
    if(qok==0){return 0;}
    let pol:[]u8=af(a,2);
    if(seq(pol,"POS")==0 && seq(pol,"NEG")==0){return 0;}
    let r:[]u8=af(a,3);
    let rok:i32=0;
    if(seq(r,"IS_A")==1){rok=1;}
    if(seq(r,"LOC_ON")==1){rok=1;}
    if(seq(r,"LOC_UNDER")==1){rok=1;}
    if(seq(r,"LOC_IN")==1){rok=1;}
    if(seq(r,"HAS_PROPERTY")==1){rok=1;}
    if(seq(r,"PROP_NUM")==1){rok=1;}
    if(seq(r,"CAUSED_BY")==1){rok=1;}
    if(seq(r,"BEFORE")==1){rok=1;}
    if(seq(r,"PART_OF")==1){rok=1;}
    if(seq(r,"SIBLING_OF")==1){rok=1;}
    if(rok==0){return 0;}
    if(bars==5){
        let prov:[]u8=af(a,5);
        if(seq(prov,"EXT")==0 && seq(prov,"GEN")==0){return 0;}
    }
    return 1;
}

// K6/K7 mutex: do atoms a,b mutex-conflict (same S, declared pair)?
// M1: (POS,LOC_ON) vs (POS,LOC_UNDER) same O.
// M2: (POS,HAS_PROPERTY,alive) vs (POS,HAS_PROPERTY,dead).
// M3: (POS,PROP_NUM) same adj-part, differing n.
// (Frozen K7: exactly M1/M2/M3. No happy/unhappy mutex.)
fn mutex_pair(a:[]u8,b:[]u8)i32 {
    if(seq(af(a,1),af(b,1))==0){return 0;}
    if(seq(af(a,2),"POS")==0 || seq(af(b,2),"POS")==0){return 0;}
    let ra:[]u8 = af(a,3);
    let rb:[]u8 = af(b,3);
    let oa:[]u8 = af(a,4);
    let ob:[]u8 = af(b,4);
    // M1
    if(seq(af(a,4),af(b,4))==1){
        if(seq(ra,"LOC_ON")==1 && seq(rb,"LOC_UNDER")==1){return 1;}
        if(seq(ra,"LOC_UNDER")==1 && seq(rb,"LOC_ON")==1){return 1;}
    }
    // M2
    if(seq(ra,"HAS_PROPERTY")==1 && seq(rb,"HAS_PROPERTY")==1){
        if(seq(oa,"alive")==1 && seq(ob,"dead")==1){return 1;}
        if(seq(oa,"dead")==1 && seq(ob,"alive")==1){return 1;}
    }
    // M3: PROP_NUM same adj, different n. O form "adj:n".
    if(seq(ra,"PROP_NUM")==1 && seq(rb,"PROP_NUM")==1){
        let ca:i32 = find_sub(oa,0,":");
        let cb:i32 = find_sub(ob,0,":");
        if(ca>0 && cb>0){
            if(seq(oa[0..ca],ob[0..cb])==1 && seq(oa,ob)==0){return 1;}
        }
    }
    return 0;
}

// contradiction of A by a closure member B: B == neg(A), or mutex.
fn contradicts(b:[]u8,a:[]u8)i32 {
    if(seq(b,atom_neg(a))==1){return 1;}
    if(mutex_pair(b,a)==1){return 1;}
    return 0;
}

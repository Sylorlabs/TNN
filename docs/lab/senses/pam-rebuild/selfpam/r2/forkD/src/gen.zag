// gen.zag — deterministic fixture generator (pure Zag, no RNG).
// `forkD gen <kind>` writes corpora/<kind>/... ; kinds: store store_h
// c1 c2 c3 c4 c5 c6 heldout. All iteration orders fixed; no RNG.

@import("io.zag")
@import("str.zag")
@import("tables.zag")
@import("atom.zag")
@import("atomize.zag")
@import("prover.zag")
@import("delib.zag")

// ---------- store fixtures ----------
// Main store: 72 EXT + 25 GEN. Accessors by index (fixed order).

fn ext_fact(i:i32)[]u8 {
    if(i==0){return "UNIT|cat|POS|IS_A|mammal";}
    if(i==1){return "UNIT|mammal|POS|IS_A|animal";}
    if(i==2){return "UNIT|dog|POS|IS_A|mammal";}
    if(i==3){return "UNIT|oak|POS|IS_A|tree";}
    if(i==4){return "UNIT|tree|POS|IS_A|plant";}
    if(i==5){return "UNIT|apple|POS|IS_A|fruit";}
    if(i==6){return "UNIT|fruit|POS|IS_A|food";}
    if(i==7){return "UNIT|car|POS|IS_A|vehicle";}
    if(i==8){return "UNIT|vehicle|POS|IS_A|machine";}
    if(i==9){return "UNIT|bird|POS|IS_A|animal";}
    if(i==10){return "UNIT|fish|POS|LOC_IN|tank";}
    if(i==11){return "UNIT|tank|POS|LOC_IN|room";}
    if(i==12){return "UNIT|river|POS|LOC_IN|valley";}
    if(i==13){return "UNIT|valley|POS|LOC_IN|region";}
    if(i==14){return "UNIT|cat|POS|SIBLING_OF|dog";}
    if(i==15){return "UNIT|sister|POS|SIBLING_OF|brother";}
    if(i==16){return "ALL|bird|POS|IS_A|animal";}
    if(i==17){return "ALL|mammal|POS|IS_A|animal";}
    if(i==18){return "UNIT|cat|POS|HAS_PROPERTY|alive";}
    if(i==19){return "UNIT|dog|POS|HAS_PROPERTY|alive";}
    if(i==20){return "UNIT|bird|POS|HAS_PROPERTY|alive";}
    if(i==21){return "ONLY|sparrow|POS|IS_A|bird";}
    if(i==22){return "UNIT|sparrow|POS|IS_A|bird";}
    if(i==23){return "UNIT|book|POS|LOC_ON|table";}
    if(i==24){return "UNIT|box|POS|LOC_UNDER|table";}
    if(i==25){return "UNIT|lunch|POS|BEFORE|nap";}
    if(i==26){return "UNIT|wheel|POS|PART_OF|car";}
    if(i==27){return "UNIT|fall|POS|CAUSED_BY|slip";}
    if(i==28){return "UNIT|tank|POS|PROP_NUM|full:1/2";}
    if(i==29){return "SOME|cat|NEG|IS_A|reptile";}
    if(i==30){return "SOME|dog|NEG|IS_A|reptile";}
    if(i==31){return "SOME|bird|NEG|IS_A|mammal";}
    if(i==32){return "SOME|fish|NEG|IS_A|mammal";}
    if(i==33){return "SOME|oak|NEG|IS_A|animal";}
    if(i==34){return "SOME|apple|NEG|IS_A|vegetable";}
    if(i==35){return "SOME|car|NEG|IS_A|animal";}
    if(i==36){return "SOME|hammer|NEG|IS_A|food";}
    if(i==37){return "SOME|book|NEG|IS_A|food";}
    if(i==38){return "SOME|river|NEG|IS_A|road";}
    if(i==39){return "SOME|stone|NEG|IS_A|plant";}
    // long-subject entries for C3 flip pairs (5-word subjects, 10-token
    // sentences, 1-word flip = 90% token overlap).
    // F1 bases: (La,HAS_PROPERTY,adj) x11.
    if(i==40){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|happy";}
    if(i==41){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|big";}
    if(i==42){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|hot";}
    if(i==43){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|cold";}
    if(i==44){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|bright";}
    if(i==45){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|loud";}
    if(i==46){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|fast";}
    if(i==47){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|clean";}
    if(i==48){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|soft";}
    if(i==49){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|hard";}
    if(i==50){return "UNIT|friend_of_neighbor_of_baker|POS|HAS_PROPERTY|red";}
    // F3 bases: (L,PROP_NUM,adj:n) x11, unique (S,adj) each (K7 M3:
    // same (S,adj) with differing n would be store-inconsistent).
    if(i==51){return "UNIT|friend_of_neighbor_of_baker|POS|PROP_NUM|full:1/2";}
    if(i==52){return "UNIT|friend_of_neighbor_of_baker|POS|PROP_NUM|empty:1/4";}
    if(i==53){return "UNIT|friend_of_neighbor_of_baker|POS|PROP_NUM|clean:1/2";}
    if(i==54){return "UNIT|friend_of_neighbor_of_baker|POS|PROP_NUM|dirty:3/4";}
    if(i==55){return "UNIT|friend_of_neighbor_of_baker|POS|PROP_NUM|bright:1/4";}
    if(i==56){return "UNIT|friend_of_neighbor_of_baker|POS|PROP_NUM|loud:1/2";}
    if(i==57){return "UNIT|sister_of_brother_of_tailor|POS|PROP_NUM|full:3/4";}
    if(i==58){return "UNIT|sister_of_brother_of_tailor|POS|PROP_NUM|empty:1/2";}
    if(i==59){return "UNIT|sister_of_brother_of_tailor|POS|PROP_NUM|clean:1/4";}
    if(i==60){return "UNIT|sister_of_brother_of_tailor|POS|PROP_NUM|dirty:1/2";}
    if(i==61){return "UNIT|sister_of_brother_of_tailor|POS|PROP_NUM|bright:3/4";}
    // F4/F6 bases: (La,LOC_ON,O) x10 (F4 swaps O; F6 swaps relation).
    if(i==62){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|mat";}
    if(i==63){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|table";}
    if(i==64){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|bench";}
    if(i==65){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|sofa";}
    if(i==66){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|rug";}
    if(i==67){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|porch";}
    if(i==68){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|deck";}
    if(i==69){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|stool";}
    if(i==70){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|shelf";}
    if(i==71){return "UNIT|friend_of_neighbor_of_baker|POS|LOC_ON|counter";}
    return "";
}

fn gen_fact(i:i32)[]u8 {
    if(i==0){return "UNIT|moon|POS|LOC_ON|table";}
    if(i==1){return "UNIT|moon|POS|HAS_PROPERTY|green";}
    if(i==2){return "UNIT|car|POS|LOC_IN|ocean";}
    if(i==3){return "UNIT|fish|POS|IS_A|bird";}
    if(i==4){return "UNIT|table|POS|IS_A|animal";}
    if(i==5){return "UNIT|snow|POS|HAS_PROPERTY|hot";}
    if(i==6){return "UNIT|book|POS|CAUSED_BY|moon";}
    if(i==7){return "ALL|stone|POS|IS_A|bird";}
    if(i==8){return "UNIT|hammer|POS|LOC_ON|cloud";}
    if(i==9){return "UNIT|cat|POS|LOC_UNDER|ocean";}
    if(i==10){return "UNIT|mammal|POS|IS_A|robot";}
    if(i==11){return "UNIT|tree|POS|IS_A|tower";}
    if(i==12){return "UNIT|fruit|POS|IS_A|gem";}
    if(i==13){return "UNIT|vehicle|POS|IS_A|ship";}
    if(i==14){return "UNIT|bread|POS|IS_A|tool";}
    if(i==15){return "UNIT|nail|POS|CAUSED_BY|thunder";}
    if(i==16){return "UNIT|evening|POS|BEFORE|morning";}
    if(i==17){return "UNIT|brother|POS|SIBLING_OF|moon";}
    if(i==18){return "UNIT|glass|POS|PART_OF|moon";}
    if(i==19){return "UNIT|apple|POS|LOC_ON|moon";}
    if(i==20){return "UNIT|rain|POS|HAS_PROPERTY|quiet";}
    if(i==21){return "UNIT|sun|POS|HAS_PROPERTY|cold";}
    if(i==22){return "UNIT|dog|POS|LOC_IN|television";}
    if(i==23){return "UNIT|oak|POS|CAUSED_BY|hammer";}
    if(i==24){return "UNIT|storm|POS|PART_OF|teacup";}
    return "";
}

fn all_fact(i:i32)[]u8 {
    if(i<72){return ext_fact(i);}
    if(i<97){return gen_fact(i-72);}
    return "";
}

fn store_text()[]u8 {
    let o:[]u8 = nio_alloc(8192);
    if(o.len==0){return "";}
    let p:i32=0;
    let i:i32=0;
    while(i<72){
        let a:[]u8 = ext_fact(i);
        let k:i32=0;
        while(k<a.len){o[p]=a[k];p=p+1;k=k+1;}
        o[p]=124;p=p+1;
        o[p]=69;p=p+1;o[p]=88;o[p+1]=84;p=p+2;
        o[p]=10;p=p+1;
        i=i+1;
    }
    i=0;
    while(i<25){
        let a2:[]u8 = gen_fact(i);
        let k2:i32=0;
        while(k2<a2.len){o[p]=a2[k2];p=p+1;k2=k2+1;}
        o[p]=124;p=p+1;
        o[p]=71;p=p+1;o[p]=69;o[p+1]=78;p=p+2;
        o[p]=10;p=p+1;
        i=i+1;
    }
    return o[0..p];
}

// ---------- render helpers (generator-side) ----------

// underscore -> space for display.
fn desp(s:[]u8)[]u8 {
    let o:[]u8 = nio_alloc(s.len+1);
    if(o.len==0){return "";}
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c==95){c=32;}
        o[i]=c;
        i=i+1;
    }
    return o[0..s.len];
}

fn starts_vowel(s:[]u8)i32 {
    if(s.len==0){return 0;}
    let c:u8=s[0];
    if(c==97||c==101||c==105||c==111||c==117){return 1;}
    return 0;
}

// singular -> plural (generator-side; mechanism maps plural->singular).
fn TAB_S2P()[]u8 {
    return "\ncat=cats\ndog=dogs\nbird=birds\noak=oaks\napple=apples\ncar=cars\nhammer=hammers\nbook=books\nriver=rivers\nstone=stones\nfish=fish\nmouse=mice\nsister=sisters\nbrother=brothers\nwheel=wheels\nmammal=mammals\ntree=trees\nfruit=fruits\nvehicle=vehicles\nlunch=lunches\n";
}

fn plu(s:[]u8)[]u8 {
    let p:[]u8 = tab_get(TAB_S2P(),s);
    if(p.len>0){return p;}
    return cat2(s,"s");
}

// render synonym (P1).
fn TAB_RSYN()[]u8 {
    return "\ncat=feline\ndog=puppy\nsofa=couch\nrabbit=bunny\n";
}

fn rsyn(s:[]u8)[]u8 {
    return tab_get(TAB_RSYN(),s);
}

// symmetric antonym (F1).
fn TAB_ANT()[]u8 {
    return "\nhappy=unhappy\nunhappy=happy\nalive=dead\ndead=alive\nfull=empty\nempty=full\nhot=cold\ncold=hot\nbig=small\nsmall=big\nclean=dirty\ndirty=clean\nloud=quiet\nquiet=loud\nfast=slow\nslow=fast\nbright=dark\ndark=bright\nhard=soft\nsoft=hard\n";
}

fn rant(a:[]u8)[]u8 {
    return tab_get(TAB_ANT(),a);
}

fn nword(n:[]u8)[]u8 {
    if(seq(n,"1/2")==1){return "half";}
    if(seq(n,"1/4")==1){return "quarter";}
    if(seq(n,"3/4")==1){return "three-quarters";}
    if(seq(n,"1")==1){return "one";}
    if(seq(n,"2")==1){return "two";}
    if(seq(n,"3")==1){return "three";}
    if(seq(n,"4")==1){return "four";}
    if(seq(n,"0")==1){return "zero";}
    return "";
}

fn nalt(n:[]u8)[]u8 {
    if(seq(n,"1/2")==1){return "50%";}
    if(seq(n,"1/4")==1){return "25%";}
    if(seq(n,"3/4")==1){return "75%";}
    return nword(n);
}

// entity swap partner (F4).
fn TAB_SWAP()[]u8 {
    return "\nmat=rug\nrug=mat\ntable=bench\nbench=table\nsofa=couch\ncouch=sofa\nporch=deck\ndeck=porch\nstool=shelf\nshelf=stool\ncounter=table\ncat=dog\ndog=cat\n";
}

fn eswap(e:[]u8)[]u8 {
    return tab_get(TAB_SWAP(),e);
}

// render atom a (Q|S|POL|R|O) to a sentence. style: 0 canonical,
// 1 P1 synonym, 2 P2 active<->passive, 3 P3 clause-reorder/template-alt,
// 4 P4 antonym-negation, 5 P5 numeric re-expression. Falls back to 0 when
// a style does not apply. Returns "" on internal failure.
fn render_atom(a:[]u8,style:i32)[]u8 {
    let q:[]u8=af(a,0);
    let s:[]u8=af(a,1);
    let pol:[]u8=af(a,2);
    let r:[]u8=af(a,3);
    let o:[]u8=af(a,4);
    let neg:i32=0;
    if(seq(pol,"NEG")==1){neg=1;}
    let Sd:[]u8 = desp(s);
    let Od:[]u8 = desp(o);
    let S:[]u8 = cat2("The ",Sd);

    if(seq(r,"IS_A")==1){
        if(seq(q,"UNIT")==1){
            let art:[]u8="a";
            if(starts_vowel(Od)==1){art="an";}
            let nots:[]u8="";
            if(neg==1){nots=" not";}
            let Ss:[]u8=S;
            if(style==1){
                let sy:[]u8=rsyn(s);
                if(sy.len>0){Ss=cat2("The ",desp(sy));}
            }
            return cat4(Ss,cat2(" is",nots),cat2(" ",art),cat2(" ",cat2(Od,".")));
        }
        let SP:[]u8 = plu(s);
        let nots2:[]u8="";
        if(neg==1){nots2=" not";}
        if(seq(q,"ALL")==1){
            return cat4("All ",cat2(SP," are"),nots2,cat2(" ",cat2(Od,".")));
        }
        if(seq(q,"SOME")==1){
            if(neg==1){
                return cat4("Not all ",cat2(SP," are"),"",cat2(" ",cat2(Od,".")));
            }
            return cat4("Some ",cat2(SP," are"),"",cat2(" ",cat2(Od,".")));
        }
        if(seq(q,"ONLY")==1){
            return cat4("Only ",cat2(SP," are"),nots2,cat2(" ",cat2(Od,".")));
        }
        return "";
    }

    if(seq(r,"LOC_ON")==1){
        let Ss2:[]u8=S;
        if(style==1){
            let sy2:[]u8=rsyn(s);
            if(sy2.len>0){Ss2=cat2("The ",desp(sy2));}
        }
        if(neg==1){
            return cat4(Ss2," did not sit on the ",Od,".");
        }
        if(style==2){
            return cat4(cat2("The ",Od)," was sat on by ",Ss2,".");
        }
        if(style==3){
            return cat4(Ss2," is on the ",Od,".");
        }
        return cat4(Ss2," sat on the ",Od,".");
    }

    if(seq(r,"LOC_UNDER")==1){
        if(neg==1){
            return cat4(S," is not under the ",Od,".");
        }
        if(style==3){
            return cat4(S," is below the ",Od,".");
        }
        return cat4(S," is under the ",Od,".");
    }

    if(seq(r,"LOC_IN")==1){
        if(style==3){
            return cat4(S," lies in the ",Od,".");
        }
        return cat4(S," is in the ",Od,".");
    }

    if(seq(r,"HAS_PROPERTY")==1){
        let Ss3:[]u8=S;
        if(style==1){
            let sy3:[]u8=rsyn(s);
            if(sy3.len>0){Ss3=cat2("The ",desp(sy3));}
        }
        if(neg==1){
            return cat4(Ss3," is not ",Od,".");
        }
        if(style==4){
            let an:[]u8=rant(o);
            if(an.len>0){
                return cat3(Ss3," is not ",cat2(desp(an),"."));
            }
        }
        return cat3(Ss3," is ",cat2(Od,"."));
    }

    if(seq(r,"PROP_NUM")==1){
        let ca:i32=find_sub(o,0,":");
        if(ca<=0){return "";}
        let adj:[]u8=o[0..ca];
        let num:[]u8=o[ca+1..o.len];
        let nw:[]u8=nword(num);
        if(nw.len==0){return "";}
        if(style==5){nw=nalt(num);}
        let nots3:[]u8="";
        if(neg==1){nots3=" not";}
        return cat4(S,cat2(" is",nots3),cat2(" ",nw),cat2(" ",cat2(desp(adj),".")));
    }

    if(seq(r,"CAUSED_BY")==1){
        if(style==2){
            return cat4(cat2("The ",Od)," caused ",S,".");
        }
        return cat4(S," was caused by the ",Od,".");
    }

    if(seq(r,"BEFORE")==1){
        if(style==3){
            return cat4(cat2("The ",Od)," is after ",S,".");
        }
        return cat4(S," is before the ",Od,".");
    }

    if(seq(r,"PART_OF")==1){
        return cat4(S," is part of the ",Od,".");
    }

    if(seq(r,"SIBLING_OF")==1){
        return cat4(S," is a sibling of the ",Od,".");
    }

    return "";
}

// round-trip check: render(a,style) must atomize back to a.
// Tries style, then style 0. Returns the working sentence or "".
fn render_checked(a:[]u8,style:i32)[]u8 {
    let t:[]u8 = render_atom(a,style);
    if(t.len>0 && seq(atomize_sentence(t),a)==1){return t;}
    if(style!=0){
        t=render_atom(a,0);
        if(t.len>0 && seq(atomize_sentence(t),a)==1){return t;}
    }
    return "";
}

// ---------- C3 flip machinery ----------

fn nflip(n:[]u8)[]u8 {
    if(seq(n,"1/2")==1){return "1/4";}
    if(seq(n,"1/4")==1){return "1/2";}
    if(seq(n,"3/4")==1){return "1/4";}
    return "";
}

// flip atom a per C3 recipe f (1..6). Returns flipped atom or "".
fn flip_atom(a:[]u8,f:i32)[]u8 {
    let q:[]u8=af(a,0);
    let s:[]u8=af(a,1);
    let pol:[]u8=af(a,2);
    let r:[]u8=af(a,3);
    let o:[]u8=af(a,4);
    if(f==1){
        if(seq(r,"HAS_PROPERTY")==1 && seq(pol,"POS")==1){
            let an:[]u8=rant(o);
            if(an.len>0){return mk_atom(q,s,pol,r,an);}
        }
        return "";
    }
    if(f==2){
        if(seq(q,"SOME")==1 && seq(pol,"NEG")==1 && seq(r,"IS_A")==1){
            return mk_atom("ALL",s,pol,r,o);
        }
        return "";
    }
    if(f==3){
        if(seq(r,"PROP_NUM")==1){
            let ca:i32=find_sub(o,0,":");
            if(ca>0){
                let nn:[]u8=nflip(o[ca+1..o.len]);
                if(nn.len>0){
                    return mk_atom(q,s,pol,r,cat3(o[0..ca],":",nn));
                }
            }
        }
        return "";
    }
    if(f==4){
        if(seq(r,"LOC_ON")==1){
            let sw:[]u8=eswap(o);
            if(sw.len>0){return mk_atom(q,s,pol,r,sw);}
        }
        // F4 also swaps IS_A objects (entity swap).
        if(seq(r,"IS_A")==1 && seq(pol,"POS")==1){
            let sw2:[]u8=eswap(o);
            if(sw2.len==0){
                // fallback: use a fixed ungrounded category.
                if(seq(o,"mammal")==1){sw2="reptile";}
                else if(seq(o,"animal")==1){sw2="plant";}
                else if(seq(o,"plant")==1){sw2="animal";}
                else if(seq(o,"food")==1){sw2="tool";}
                else if(seq(o,"machine")==1){sw2="animal";}
                else if(seq(o,"bird")==1){sw2="mammal";}
                else {sw2="rock";}
            }
            if(sw2.len>0){return mk_atom(q,s,pol,r,sw2);}
        }
        return "";
    }
    if(f==5){
        // negation insertion on any atom.
        let np2:[]u8="NEG";
        if(seq(pol,"NEG")==1){np2="POS";}
        return mk_atom(q,s,np2,r,o);
    }
    if(f==6){
        if(seq(r,"LOC_ON")==1){
            return mk_atom(q,s,pol,"LOC_UNDER",o);
        }
        return "";
    }
    return "";
}

// tokenize on spaces (lowercased input assumed already lower).
fn tok_count(t:[]u8)[]u8 {
    // returns "n" lines of tokens joined by \n.
    let o:[]u8 = nio_alloc(t.len+1);
    if(o.len==0){return "";}
    let p:i32=0;
    let i:i32=0;
    let n:i32=t.len;
    while(i<n){
        while(i<n && t[i]==32){i=i+1;}
        if(i>=n){break;}
        let j:i32=i;
        while(j<n && t[j]!=32){j=j+1;}
        let k:i32=i;
        while(k<j){o[p]=t[k];p=p+1;k=k+1;}
        o[p]=10;p=p+1;
        i=j;
    }
    return o[0..p];
}

fn toklow(t:[]u8)[]u8 {
    let o:[]u8 = nio_alloc(t.len+1);
    if(o.len==0){return "";}
    let i:i32=0;
    while(i<t.len){
        let c:u8=t[i];
        if(c>=65 && c<=90){c=c+32;}
        o[i]=c;
        i=i+1;
    }
    return o[0..t.len];
}

// multiset token overlap = shared / max(n1,n2), as integer percent.
fn overlap_pct(t1:[]u8,t2:[]u8)i32 {
    let a:[]u8 = tok_count(toklow(t1));
    let b:[]u8 = tok_count(toklow(t2));
    let na:i32 = nlines(a);
    let nb:i32 = nlines(b);
    let used:[]u8 = nio_alloc(nb+1);
    if(used.len==0){return -1;}
    let ui:i32=0;
    while(ui<nb){used[ui]=0;ui=ui+1;}
    let shared:i32=0;
    let i:i32=0;
    while(i<na){
        let ta:[]u8 = strim(gline(a,i));
        let j:i32=0;
        while(j<nb){
            if(used[j]==0 && seq(strim(gline(b,j)),ta)==1){
                used[j]=1;
                shared=shared+1;
                break;
            }
            j=j+1;
        }
        i=i+1;
    }
    let mx:i32=na;
    if(nb>mx){mx=nb;}
    if(mx==0){return -1;}
    return (shared*100)/mx;
}

// ---------- delib builders ----------

fn delib_text(prems:[]u8,steps:[]u8,concl:[]u8)[]u8 {
    return cat2("PREMISES:\n",cat2(prems,cat2("STEPS:\n",cat2(steps,cat2("CONCLUSIONS:\n",concl)))));
}

// valid attesting delib: exact EXT lookup.
fn delib_lookup(a:[]u8)[]u8 {
    let st:[]u8 = cat2("LOOKUP||",cat2(a,cat2("||",a)));
    return delib_text(cat2(a,"\n"),cat2(st,"\n"),cat2(a,"\n"));
}

// valid attesting delib: 2-premise rule deriving out.
fn delib_rule2(rule:[]u8,p1:[]u8,p2:[]u8,out:[]u8)[]u8 {
    let st:[]u8 = cat2(rule,cat2("||",cat2(p1,cat2("||",cat2(p2,cat2("||",out))))));
    let pr:[]u8 = cat2(p1,cat2("\n",cat2(p2,"\n")));
    return delib_text(pr,cat2(st,"\n"),cat2(out,"\n"));
}

// valid attesting delib: 1-premise rule deriving out.
fn delib_rule1(rule:[]u8,p1:[]u8,out:[]u8)[]u8 {
    let st:[]u8 = cat2(rule,cat2("||",cat2(p1,cat2("||",out))));
    return delib_text(cat2(p1,"\n"),cat2(st,"\n"),cat2(out,"\n"));
}

// ---------- case writer ----------

// writes corpora/<kind>/drafts/<cid>.txt and delib/<cid>.txt; returns
// manifest line "cid|drafts/<cid>.txt|store.txt|delib/<cid>.txt|expected\n".
fn write_case(root:[]u8,kind:[]u8,cid:[]u8,draft:[]u8,delib:[]u8,expected:[]u8)[]u8 {
    let kd:[]u8 = cat3(root,"/",kind);
    nio_mkdir(kd);
    let dd:[]u8 = cat2(kd,"/drafts");
    let ld:[]u8 = cat2(kd,"/delib");
    nio_mkdir(dd);
    nio_mkdir(ld);
    let dp:[]u8 = cat2(cat2(dd,"/"),cid);
    let lp:[]u8 = cat2(cat2(ld,"/"),cid);
    let dp2:[]u8 = cat2(dp,".txt");
    let lp2:[]u8 = cat2(lp,".txt");
    file_write(dp2,draft);
    file_write(lp2,delib);
    // paths relative to the manifest dir (corpora/<kind>/).
    let ml:[]u8 = cat2(cid,"|drafts/");
    ml=cat2(ml,cat2(cid,".txt|store.txt|delib/"));
    ml=cat2(ml,cat2(cid,".txt|"));
    ml=cat2(ml,expected);
    return cat2(ml,"\n");
}

// ---------- C1: confabulations ----------

// find first applicable flip f in 1..6 starting from f0 for base a;
// returns flipped atom or "".
fn find_flip(a:[]u8,f0:i32)[]u8 {
    let k:i32=0;
    while(k<6){
        let f:i32=((f0-1+k)%6)+1;
        let fa:[]u8=flip_atom(a,f);
        if(fa.len>0 && seq(fa,a)==0){return fa;}
        k=k+1;
    }
    return "";
}

// render flipped atom for C1/C4: try paraphrase style ps, else style 0.
// (C1/C4 have no 90% overlap requirement; that is C3-only.)
fn render_c1(base0:[]u8,fa:[]u8,ps:i32)[]u8 {
    let t:[]u8 = render_checked(fa,ps);
    if(t.len>0){return t;}
    t=render_checked(fa,0);
    if(t.len>0){return t;}
    return "";
}

fn gen_c1(root:[]u8)[]u8 {
    let man:[]u8 = nio_alloc(65536);
    if(man.len==0){return "";}
    let mp:i32=0;
    let store:[]u8 = store_text();
    let ext_cl:[]u8 = closure_full(store,1);
    let full_cl:[]u8 = closure_full(store,0);
    let made:i32=0;
    let seen:[]u8 = nio_alloc(131072);
    if(seen.len==0){return "";}
    let sp:i32=0;
    seen[sp]=10;sp=sp+1;
    // for each EXT atom, try flips 1..6, emit up to 2 valid confabulations.
    let bi:i32=0;
    while(bi<97 && made<140){
        let a:[]u8 = all_fact(bi);
        let f:i32=1;
        let emitted:i32=0;
        while(f<=6 && emitted<4 && made<140){
            let fa:[]u8 = flip_atom(a,f);
            if(fa.len>0 && seq(fa,a)==0){
                if(prove_atom(ext_cl,full_cl,fa)[0]!=69){
                    // try styles 0..3, emit up to 2 unique.
                    let st:i32=0;
                    while(st<4 && emitted<4 && made<140){
                        let t:[]u8 = render_checked(fa,st);
                        if(t.len>0 && seq(atomize_sentence(t),fa)==1){
                            // dedupe.
                            let dup:i32=0;
                            let sl:i32=0;
                            while(sl<sp){
                                let eol:i32=sl;
                                while(eol<sp && seen[eol]!=10){eol=eol+1;}
                                if(eol-sl==t.len){
                                    let mm:i32=0;
                                    let eq:i32=1;
                                    while(mm<t.len){
                                        if(seen[sl+mm]!=t[mm]){eq=0;break;}
                                        mm=mm+1;
                                    }
                                    if(eq==1){dup=1;break;}
                                }
                                sl=eol+1;
                            }
                            if(dup==0){
                                let mm2:i32=0;
                                while(mm2<t.len){seen[sp]=t[mm2];sp=sp+1;mm2=mm2+1;}
                                seen[sp]=10;sp=sp+1;
                                let dl:[]u8 = delib_text(cat2(fa,"\n"),"",cat2(fa,"\n"));
                                let cid:[]u8 = cat2("M1-",pad3(made+1));
                                let ml:[]u8 = write_case(root,"c1",cid,t,dl,"WITHHOLD");
                                let k:i32=0;
                                while(k<ml.len){man[mp]=ml[k];mp=mp+1;k=k+1;}
                                made=made+1;
                                emitted=emitted+1;
                            }
                        }
                        st=st+1;
                    }
                }
            }
            f=f+1;
        }
        bi=bi+1;
    }
    return man[0..mp];
}

fn pad3(n:i32)[]u8 {
    let s:[]u8 = i64s(n as i64);
    if(s.len==1){return cat2("00",s);}
    if(s.len==2){return cat2("0",s);}
    return s;
}

// ---------- C2: truths ----------

// 5 surprising styles; returns delib or "".
fn delib_surprising(a:[]u8,sty:i32)[]u8 {
    // sty 0: ISA 2-hop. a=(x,POS,IS_A,z); find y via EXT.
    if(sty==0){
        let x:[]u8=af(a,1);
        let z:[]u8=af(a,4);
        let i:i32=0;
        while(i<72){
            let e:[]u8=ext_fact(i);
            if(seq(af(e,3),"IS_A")==1 && seq(af(e,2),"POS")==1 && seq(af(e,1),x)==1){
                let y:[]u8=af(e,4);
                let j:i32=0;
                while(j<72){
                    let e2:[]u8=ext_fact(j);
                    if(seq(af(e2,3),"IS_A")==1 && seq(af(e2,2),"POS")==1 && seq(af(e2,1),y)==1 && seq(af(e2,4),z)==1){
                        return delib_rule2("ISA-CHAIN",e,e2,a);
                    }
                    j=j+1;
                }
            }
            i=i+1;
        }
        return "";
    }
    // sty 1: LOC_IN 2-hop.
    if(sty==1){
        let x2:[]u8=af(a,1);
        let z2:[]u8=af(a,4);
        let i2:i32=0;
        while(i2<72){
            let e3:[]u8=ext_fact(i2);
            if(seq(af(e3,3),"LOC_IN")==1 && seq(af(e3,2),"POS")==1 && seq(af(e3,1),x2)==1){
                let y2:[]u8=af(e3,4);
                let j2:i32=0;
                while(j2<72){
                    let e4:[]u8=ext_fact(j2);
                    if(seq(af(e4,3),"LOC_IN")==1 && seq(af(e4,2),"POS")==1 && seq(af(e4,1),y2)==1 && seq(af(e4,4),z2)==1){
                        return delib_rule2("LOCIN-TRANS",e3,e4,a);
                    }
                    j2=j2+1;
                }
            }
            i2=i2+1;
        }
        return "";
    }
    // sty 2: sibling symmetry. a=(y,POS,SIBLING_OF,x).
    if(sty==2){
        let y3:[]u8=af(a,1);
        let x3:[]u8=af(a,4);
        let i3:i32=0;
        while(i3<72){
            let e5:[]u8=ext_fact(i3);
            if(seq(af(e5,3),"SIBLING_OF")==1 && seq(af(e5,1),x3)==1 && seq(af(e5,4),y3)==1){
                return delib_rule1("SIB-SYM",e5,a);
            }
            i3=i3+1;
        }
        return "";
    }
    // sty 3: ALL->SOME. a=(SOME,s,pol,IS_A,o).
    if(sty==3){
        let all:[]u8 = mk_atom("ALL",af(a,1),af(a,2),af(a,3),af(a,4));
        let i4:i32=0;
        while(i4<72){
            if(seq(ext_fact(i4),all)==1){
                return delib_rule1("ALL2SOME",all,a);
            }
            i4=i4+1;
        }
        return "";
    }
    // sty 4: mutex-derived negative. a=(x,NEG,HAS_PROPERTY,dead).
    if(sty==4){
        let pos:[]u8 = mk_atom(af(a,0),af(a,1),"POS",af(a,3),"alive");
        let i5:i32=0;
        while(i5<72){
            if(seq(ext_fact(i5),pos)==1){
                return delib_rule1("MUTEX-INTRO",pos,a);
            }
            i5=i5+1;
        }
        return "";
    }
    return "";
}


// delib for two-sentence draft: a1 EXT (LOOKUP), a2 derived by rule from p1,p2.
fn delib_2sent(a1:[]u8,rule:[]u8,p1:[]u8,p2:[]u8,a2:[]u8)[]u8 {
    let s1:[]u8 = cat2("LOOKUP||",cat2(a1,cat2("||",a1)));
    let s2:[]u8 = cat2(rule,cat2("||",cat2(p1,cat2("||",cat2(p2,cat2("||",a2))))));
    let pr:[]u8 = cat2(a1,cat2("\n",cat2(p1,cat2("\n",cat2(p2,"\n")))));
    let st:[]u8 = cat2(s1,cat2("\n",cat2(s2,"\n")));
    let co:[]u8 = cat2(a1,cat2("\n",cat2(a2,"\n")));
    return delib_text(pr,st,co);
}

fn gen_c2(root:[]u8)[]u8 {
    let man:[]u8 = nio_alloc(65536);
    if(man.len==0){return "";}
    let mp:i32=0;
    let made:i32=0;
    // 100 direct paraphrases of EXT entries.
    let bi:i32=0;
    while(made<100){
        let a:[]u8 = ext_fact(bi%72);
        let t:[]u8 = render_checked(a,made%6);
        if(t.len>0){
            let dl:[]u8 = delib_lookup(a);
            let ml:[]u8 = write_case(root,"c2",cat2("M2-",pad3(made+1)),t,dl,"INSTALL");
            let k:i32=0;
            while(k<ml.len){man[mp]=ml[k];mp=mp+1;k=k+1;}
            made=made+1;
        }
        bi=bi+1;
        if(bi>720){break;}
    }
    // ---- 40 surprising ----
    // ISA 2-hop: 5 chains, style0 + style1-if-different (7), + 3 two-sent (10).
    let isa_p:[]u8="cat|mammal|animal\ndog|mammal|animal\noak|tree|plant\napple|fruit|food\ncar|vehicle|machine\n";
    let ii:i32=0;
    while(ii<5){
        let ln:[]u8=strim(gline(isa_p,ii));
        let q1:i32=find_sub(ln,0,"|");
        let q2:i32=find_sub(ln,q1+1,"|");
        let x:[]u8=ln[0..q1];
        let y:[]u8=ln[q1+1..q2];
        let z:[]u8=ln[q2+1..ln.len];
        let p1:[]u8=mk_atom("UNIT",x,"POS","IS_A",y);
        let p2:[]u8=mk_atom("UNIT",y,"POS","IS_A",z);
        let a:[]u8=mk_atom("UNIT",x,"POS","IS_A",z);
        let dl:[]u8=delib_rule2("ISA-CHAIN",p1,p2,a);
        let t0:[]u8=render_checked(a,0);
        if(t0.len>0){
            let m0:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),t0,dl,"INSTALL");
            let k0:i32=0;
            while(k0<m0.len){man[mp]=m0[k0];mp=mp+1;k0=k0+1;}
            made=made+1;
        }
        let t1:[]u8=render_checked(a,1);
        if(t1.len>0 && seq(t1,t0)==0){
            let m1:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),t1,dl,"INSTALL");
            let k1:i32=0;
            while(k1<m1.len){man[mp]=m1[k1];mp=mp+1;k1=k1+1;}
            made=made+1;
        }
        ii=ii+1;
    }
    let ts3:[]u8="cat|mammal|animal\ndog|mammal|animal\noak|tree|plant\n";
    let ti:i32=0;
    while(ti<3){
        let ln2:[]u8=strim(gline(ts3,ti));
        let r1:i32=find_sub(ln2,0,"|");
        let r2:i32=find_sub(ln2,r1+1,"|");
        let x2:[]u8=ln2[0..r1];
        let y2:[]u8=ln2[r1+1..r2];
        let z2:[]u8=ln2[r2+1..ln2.len];
        let a1:[]u8=mk_atom("UNIT",x2,"POS","IS_A",y2);
        let p2b:[]u8=mk_atom("UNIT",y2,"POS","IS_A",z2);
        let a2:[]u8=mk_atom("UNIT",x2,"POS","IS_A",z2);
        let s1t:[]u8=render_checked(a1,0);
        let s2t:[]u8=render_checked(a2,0);
        if(s1t.len>0 && s2t.len>0){
            let tt:[]u8=cat2(s1t,cat2(" ",s2t));
            let dlb:[]u8=delib_2sent(a1,"ISA-CHAIN",a1,p2b,a2);
            let mb:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),tt,dlb,"INSTALL");
            let kb:i32=0;
            while(kb<mb.len){man[mp]=mb[kb];mp=mp+1;kb=kb+1;}
            made=made+1;
        }
        ti=ti+1;
    }
    // LOC_IN 2-hop x6.
    let li_p:[]u8="fish|tank|room\nriver|valley|region\n";
    let li:i32=0;
    while(li<2){
        let ln3:[]u8=strim(gline(li_p,li));
        let q3:i32=find_sub(ln3,0,"|");
        let q4:i32=find_sub(ln3,q3+1,"|");
        let x3:[]u8=ln3[0..q3];
        let y3:[]u8=ln3[q3+1..q4];
        let z3:[]u8=ln3[q4+1..ln3.len];
        let q1:[]u8=mk_atom("UNIT",x3,"POS","LOC_IN",y3);
        let q2:[]u8=mk_atom("UNIT",y3,"POS","LOC_IN",z3);
        let a4:[]u8=mk_atom("UNIT",x3,"POS","LOC_IN",z3);
        let dl4:[]u8=delib_rule2("LOCIN-TRANS",q1,q2,a4);
        let u0:[]u8=render_checked(a4,0);
        if(u0.len>0){
            let n0:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),u0,dl4,"INSTALL");
            let j0:i32=0;
            while(j0<n0.len){man[mp]=n0[j0];mp=mp+1;j0=j0+1;}
            made=made+1;
        }
        let u3:[]u8=render_checked(a4,3);
        if(u3.len>0 && seq(u3,u0)==0){
            let n1:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),u3,dl4,"INSTALL");
            let j1:i32=0;
            while(j1<n1.len){man[mp]=n1[j1];mp=mp+1;j1=j1+1;}
            made=made+1;
        }
        let v1t:[]u8=render_checked(q1,0);
        let v2t:[]u8=render_checked(a4,0);
        if(v1t.len>0 && v2t.len>0){
            let vv:[]u8=cat2(v1t,cat2(" ",v2t));
            let dlv:[]u8=delib_2sent(q1,"LOCIN-TRANS",q1,q2,a4);
            let nv:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),vv,dlv,"INSTALL");
            let jv:i32=0;
            while(jv<nv.len){man[mp]=nv[jv];mp=mp+1;jv=jv+1;}
            made=made+1;
        }
        li=li+1;
    }
    // SIB x2, ALL2SOME x2.
    let sib2:[]u8="dog|cat\nbrother|sister\n";
    let sj:i32=0;
    while(sj<2){
        let ln4:[]u8=strim(gline(sib2,sj));
        let qq:i32=find_sub(ln4,0,"|");
        let yy:[]u8=ln4[0..qq];
        let xx:[]u8=ln4[qq+1..ln4.len];
        let pp:[]u8=mk_atom("UNIT",xx,"POS","SIBLING_OF",yy);
        let aa:[]u8=mk_atom("UNIT",yy,"POS","SIBLING_OF",xx);
        let dd:[]u8=delib_rule1("SIB-SYM",pp,aa);
        let tt2:[]u8=render_checked(aa,0);
        if(tt2.len>0){
            let nn:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),tt2,dd,"INSTALL");
            let jj:i32=0;
            while(jj<nn.len){man[mp]=nn[jj];mp=mp+1;jj=jj+1;}
            made=made+1;
        }
        sj=sj+1;
    }
    let as2:[]u8="bird\nmammal\n";
    let aj:i32=0;
    while(aj<2){
        let ss:[]u8=strim(gline(as2,aj));
        let pall:[]u8=mk_atom("ALL",ss,"POS","IS_A","animal");
        let a5:[]u8=mk_atom("SOME",ss,"POS","IS_A","animal");
        let d5:[]u8=delib_rule1("ALL2SOME",pall,a5);
        let t5:[]u8=render_checked(a5,0);
        if(t5.len>0){
            let n5:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),t5,d5,"INSTALL");
            let j5:i32=0;
            while(j5<n5.len){man[mp]=n5[j5];mp=mp+1;j5=j5+1;}
            made=made+1;
        }
        aj=aj+1;
    }
    // mutex-neg x17: 3 dead, 2 on/under, 12 prop_num.
    let mx3:[]u8="cat\ndog\nbird\n";
    let mi:i32=0;
    while(mi<3){
        let s6:[]u8=strim(gline(mx3,mi));
        let pin:[]u8=mk_atom("UNIT",s6,"POS","HAS_PROPERTY","alive");
        let a6:[]u8=mk_atom("UNIT",s6,"NEG","HAS_PROPERTY","dead");
        let d6:[]u8=delib_rule1("MUTEX-INTRO",pin,a6);
        let t6:[]u8=render_checked(a6,0);
        if(t6.len>0){
            let n6:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),t6,d6,"INSTALL");
            let j6:i32=0;
            while(j6<n6.len){man[mp]=n6[j6];mp=mp+1;j6=j6+1;}
            made=made+1;
        }
        mi=mi+1;
    }
    let pinb:[]u8=mk_atom("UNIT","book","POS","LOC_ON","table");
    let a7:[]u8=mk_atom("UNIT","book","NEG","LOC_UNDER","table");
    let d7:[]u8=delib_rule1("MUTEX-INTRO",pinb,a7);
    let t7:[]u8=render_checked(a7,0);
    if(t7.len>0){
        let n7:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),t7,d7,"INSTALL");
        let j7:i32=0;
        while(j7<n7.len){man[mp]=n7[j7];mp=mp+1;j7=j7+1;}
        made=made+1;
    }
    let pinc:[]u8=mk_atom("UNIT","box","POS","LOC_UNDER","table");
    let a8:[]u8=mk_atom("UNIT","box","NEG","LOC_ON","table");
    let d8:[]u8=delib_rule1("MUTEX-INTRO",pinc,a8);
    let t8:[]u8=render_checked(a8,0);
    if(t8.len>0){
        let n8:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),t8,d8,"INSTALL");
        let j8:i32=0;
        while(j8<n8.len){man[mp]=n8[j8];mp=mp+1;j8=j8+1;}
        made=made+1;
    }
    // prop_num mutex: (S,adj:n) -> (S,NEG,adj:n'), n' = nflip(n).
    let pm_p:[]u8="tank|full:1/2\nfriend_of_neighbor_of_baker|full:1/2\nfriend_of_neighbor_of_baker|empty:1/4\nfriend_of_neighbor_of_baker|clean:1/2\nfriend_of_neighbor_of_baker|dirty:3/4\nfriend_of_neighbor_of_baker|bright:1/4\nfriend_of_neighbor_of_baker|loud:1/2\nsister_of_brother_of_tailor|full:3/4\nsister_of_brother_of_tailor|empty:1/2\nsister_of_brother_of_tailor|clean:1/4\nsister_of_brother_of_tailor|dirty:1/2\nsister_of_brother_of_tailor|bright:3/4\n";
    let pi2:i32=0;
    while(pi2<12){
        let ln5:[]u8=strim(gline(pm_p,pi2));
        let qc:i32=find_sub(ln5,0,"|");
        let s9:[]u8=ln5[0..qc];
        let on:[]u8=ln5[qc+1..ln5.len];
        let cc:i32=find_sub(on,0,":");
        let adj9:[]u8=on[0..cc];
        let nn9:[]u8=nflip(on[cc+1..on.len]);
        if(nn9.len>0){
            let pin9:[]u8=mk_atom("UNIT",s9,"POS","PROP_NUM",on);
            let a9:[]u8=mk_atom("UNIT",s9,"NEG","PROP_NUM",cat3(adj9,":",nn9));
            let d9:[]u8=delib_rule1("MUTEX-INTRO",pin9,a9);
            let t9:[]u8=render_checked(a9,0);
            if(t9.len>0){
                let n9:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),t9,d9,"INSTALL");
                let j9:i32=0;
                while(j9<n9.len){man[mp]=n9[j9];mp=mp+1;j9=j9+1;}
                made=made+1;
            }
        }
        pi2=pi2+1;
    }
    // 3 two-sentence mutex.
    let tm_p:[]u8="cat|alive|dead\ndog|alive|dead\ntank|full:1/2|full:1/4\n";
    let tm:i32=0;
    while(tm<3){
        let ln6:[]u8=strim(gline(tm_p,tm));
        let e1:i32=find_sub(ln6,0,"|");
        let e2:i32=find_sub(ln6,e1+1,"|");
        let s10:[]u8=ln6[0..e1];
        let o10a:[]u8=ln6[e1+1..e2];
        let o10b:[]u8=ln6[e2+1..ln6.len];
        let r10:[]u8="HAS_PROPERTY";
        if(tm==2){r10="PROP_NUM";}
        let a10:[]u8=mk_atom("UNIT",s10,"POS",r10,o10a);
        let b10:[]u8=mk_atom("UNIT",s10,"NEG",r10,o10b);
        let u10:[]u8=render_checked(a10,0);
        let v10:[]u8=render_checked(b10,0);
        if(u10.len>0 && v10.len>0){
            let ww:[]u8=cat2(u10,cat2(" ",v10));
            // MUTEX-INTRO is 1-premise; build the delib manually.
            let s1w:[]u8=cat2("LOOKUP||",cat2(a10,cat2("||",a10)));
            let s2w:[]u8=cat2("MUTEX-INTRO||",cat2(a10,cat2("||",b10)));
            let prw:[]u8=cat2(a10,"\n");
            let stw:[]u8=cat2(s1w,cat2("\n",cat2(s2w,"\n")));
            let cow:[]u8=cat2(a10,cat2("\n",cat2(b10,"\n")));
            let dw:[]u8=delib_text(prw,stw,cow);
            let nw:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),ww,dw,"INSTALL");
            let jw:i32=0;
            while(jw<nw.len){man[mp]=nw[jw];mp=mp+1;jw=jw+1;}
            made=made+1;
        }
        tm=tm+1;
    }
    // fallback: fill to 140 with additional paraphrases.
    let fb:i32=0;
    while(made<140 && fb<500){
        let fa2:[]u8 = ext_fact(fb%72);
        let tt2:[]u8 = render_checked(fa2,(fb/72)%6);
        if(tt2.len>0){
            let dd:[]u8 = delib_lookup(fa2);
            let nn:[]u8=write_case(root,"c2",cat2("M2-",pad3(made+1)),tt2,dd,"INSTALL");
            let jw:i32=0;
            while(jw<nn.len){man[mp]=nn[jw];mp=mp+1;jw=jw+1;}
            made=made+1;
        }
        fb=fb+1;
    }
    return man[0..mp];
}

// ---------- C3: paraphrase battery ----------

// emit one C3 pair (base+para/flip). Returns updated mp.

// ---------- C3: paraphrase battery ----------

fn try_para(root:[]u8,man:[]u8,mp:i32,a:[]u8,ps:i32,dl:[]u8,pidx:i32)i32 {
    let bsent:[]u8=render_checked(a,0);
    let psent:[]u8=render_checked(a,ps);
    if(bsent.len==0 || psent.len==0){return mp;}
    if(seq(psent,bsent)==1){return mp;}
    if(seq(atomize_sentence(psent),a)==0){return mp;}
    let c1:[]u8=cat2("M3b-",pad3(pidx));
    let c2:[]u8=cat2("M3f-",pad3(pidx));
    let m1:[]u8=write_case(root,"c3",c1,bsent,dl,"INSTALL");
    let m2:[]u8=write_case(root,"c3",c2,psent,dl,"INSTALL");
    let k:i32=0;
    while(k<m1.len){man[mp]=m1[k];mp=mp+1;k=k+1;}
    k=0;
    while(k<m2.len){man[mp]=m2[k];mp=mp+1;k=k+1;}
    return mp;
}

fn try_flip(root:[]u8,man:[]u8,mp:i32,a:[]u8,f:i32,bs:i32,fs:i32,fidx:i32)i32 {
    let fa:[]u8=flip_atom(a,f);
    if(fa.len==0){return mp;}
    let bsent:[]u8=render_checked(a,bs);
    let fsent:[]u8=render_checked(fa,fs);
    if(bsent.len==0 || fsent.len==0){return mp;}
    if(seq(atomize_sentence(bsent),a)==0){return mp;}
    if(seq(atomize_sentence(fsent),fa)==0){return mp;}
    if(overlap_pct(bsent,fsent)<90){return mp;}
    let store:[]u8=store_text();
    let ecl:[]u8=closure_full(store,1);
    let fcl:[]u8=closure_full(store,0);
    if(prove_atom(ecl,fcl,a)[0]!=69){return mp;}
    if(prove_atom(ecl,fcl,fa)[0]==69){return mp;}
    let bdl:[]u8=delib_lookup(a);
    let fdl:[]u8=delib_text(cat2(fa,"\n"),"",cat2(fa,"\n"));
    let c1:[]u8=cat2("M3b-",pad3(fidx));
    let c2:[]u8=cat2("M3f-",pad3(fidx));
    let m1:[]u8=write_case(root,"c3",c1,bsent,bdl,"INSTALL");
    let m2:[]u8=write_case(root,"c3",c2,fsent,fdl,"WITHHOLD");
    let k:i32=0;
    while(k<m1.len){man[mp]=m1[k];mp=mp+1;k=k+1;}
    k=0;
    while(k<m2.len){man[mp]=m2[k];mp=mp+1;k=k+1;}
    return mp;
}

fn gen_c3(root:[]u8)[]u8 {
    let man:[]u8 = nio_alloc(131072);
    if(man.len==0){return "";}
    let mp:i32=0;
    let pi:i32=1;
    // ---- 65 paraphrase pairs ----
    // P1 style1 (synonym subjects): ext 0,2,18,19.
    let p1idx:[]u8 = nio_alloc(16);
    if(p1idx.len>0){
        p1idx[0]=0;p1idx[1]=2;p1idx[2]=18;p1idx[3]=19;
        let i:i32=0;
        while(i<4 && pi<=65){
            let a:[]u8=ext_fact(p1idx[i] as i32);
            let nmp:i32=try_para(root,man,mp,a,1,delib_lookup(a),pi);
            if(nmp!=mp){pi=pi+1;}
            mp=nmp;
            i=i+1;
        }
    }
    // P2 style2 (passive): LOC_ON ext 23,62..71 and CAUSED_BY 27.
    let p2i:i32=0;
    while(p2i<11 && pi<=65){
        let ei:i32=23;
        if(p2i>0){ei=61+p2i;}
        let a2:[]u8=ext_fact(ei);
        let nmp2:i32=try_para(root,man,mp,a2,2,delib_lookup(a2),pi);
        if(nmp2!=mp){pi=pi+1;}
        mp=nmp2;
        p2i=p2i+1;
    }
    // P3 style3 (reorder): LOC_ON 23,62..71 (is on), LOC_IN 10..13 (lies in), BEFORE 25.
    let p3i:i32=0;
    while(p3i<11 && pi<=65){
        let e3:i32=23;
        if(p3i>0){e3=61+p3i;}
        let a3:[]u8=ext_fact(e3);
        let nmp3:i32=try_para(root,man,mp,a3,3,delib_lookup(a3),pi);
        if(nmp3!=mp){pi=pi+1;}
        mp=nmp3;
        p3i=p3i+1;
    }
    let p3b:i32=10;
    while(p3b<14 && pi<=65){
        let a3b:[]u8=ext_fact(p3b);
        let nmp3b:i32=try_para(root,man,mp,a3b,3,delib_lookup(a3b),pi);
        if(nmp3b!=mp){pi=pi+1;}
        mp=nmp3b;
        p3b=p3b+1;
    }
    // P4 style4 (antonym-neg): HAS_PROPERTY 40..50,18,19.
    let p4i:i32=0;
    while(p4i<13 && pi<=65){
        let e4:i32=40+p4i;
        if(p4i>=11){e4=7+p4i;}
        let a4:[]u8=ext_fact(e4);
        let nmp4:i32=try_para(root,man,mp,a4,4,delib_lookup(a4),pi);
        if(nmp4!=mp){pi=pi+1;}
        mp=nmp4;
        p4i=p4i+1;
    }
    // P5 style5 (numeric): PROP_NUM 28,51..61.
    let p5i:i32=0;
    while(p5i<12 && pi<=65){
        let e5:i32=28;
        if(p5i>0){e5=50+p5i;}
        let a5:[]u8=ext_fact(e5);
        let nmp5:i32=try_para(root,man,mp,a5,5,delib_lookup(a5),pi);
        if(nmp5!=mp){pi=pi+1;}
        mp=nmp5;
        p5i=p5i+1;
    }
    // fallback: fill to 65 pairs with additional paraphrases.
    let fb:i32=0;
    while(pi<=65 && fb<500){
        let fa:[]u8 = ext_fact(fb%72);
        let ps2:i32 = (fb/72)%6;
        let nmpf:i32=try_para(root,man,mp,fa,ps2,delib_lookup(fa),pi);
        if(nmpf!=mp){pi=pi+1;}
        mp=nmpf;
        fb=fb+1;
    }
    return man[0..mp];
}

// ---------- C4: trace alibis ----------

fn gen_c4(root:[]u8)[]u8 {
    let man:[]u8 = nio_alloc(65536);
    if(man.len==0){return "";}
    let mp:i32=0;
    let made:i32=0;
    let store:[]u8=store_text();
    let ecl:[]u8=closure_full(store,1);
    let fcl:[]u8=closure_full(store,0);
    let bi:i32=0;
    while(made<60 && bi<720){
        let a:[]u8=ext_fact(bi%72);
        let fa:[]u8=find_flip(a,(made%6)+1);
        if(fa.len>0 && prove_atom(ecl,fcl,fa)[0]!=69){
            let base0:[]u8=render_checked(a,0);
            let t:[]u8=render_c1(base0,fa,made%5);
            if(t.len>0 && seq(atomize_sentence(t),fa)==1){
                // alibi delib: premises are real EXT (non-entailing),
                // step is fabricated (LOOKUP mismatch or bad ISA-CHAIN).
                let dl:[]u8="";
                if(made%2==0){
                    // invalid LOOKUP: input != output.
                    let st:[]u8=cat2("LOOKUP||",cat2(a,cat2("||",fa)));
                    dl=delib_text(cat2(a,"\n"),cat2(st,"\n"),cat2(fa,"\n"));
                } else {
                    // fabricated ISA-CHAIN with mismatched middle.
                    let p1:[]u8=mk_atom("UNIT",af(fa,1),"POS","IS_A","mammal");
                    let p2:[]u8=mk_atom("UNIT","tree","POS","IS_A",af(fa,4));
                    // ensure p1,p2 are EXT (or at least plausible); use real ones.
                    p1=ext_fact(0);
                    p2=ext_fact(4);
                    let st2:[]u8=cat2("ISA-CHAIN||",cat2(p1,cat2("||",cat2(p2,cat2("||",fa)))));
                    let pr2:[]u8=cat2(p1,cat2("\n",cat2(p2,"\n")));
                    dl=delib_text(pr2,cat2(st2,"\n"),cat2(fa,"\n"));
                }
                let cid:[]u8=cat2("M4-",pad3(made+1));
                let ml:[]u8=write_case(root,"c4",cid,t,dl,"WITHHOLD");
                let k:i32=0;
                while(k<ml.len){man[mp]=ml[k];mp=mp+1;k=k+1;}
                made=made+1;
            }
        }
        bi=bi+1;
    }
    return man[0..mp];
}

// ---------- C5: GEN alibis ----------

fn gen_c5(root:[]u8)[]u8 {
    let man:[]u8 = nio_alloc(65536);
    if(man.len==0){return "";}
    let mp:i32=0;
    let made:i32=0;
    let store:[]u8=store_text();
    let ecl:[]u8=closure_full(store,1);
    let fcl:[]u8=closure_full(store,0);
    // 40 pure-GEN: render GEN entries directly.
    let gi:i32=0;
    while(made<40 && gi<200){
        let g:[]u8=gen_fact(gi%25);
        // g is "Q|S|POL|R|O" (no PROV); make atom.
        let t:[]u8=render_checked(g,gi%6);
        if(t.len>0 && seq(atomize_sentence(t),g)==1){
            let pr:[]u8=prove_atom(ecl,fcl,g);
            // must be U (GEN_ONLY or plain), not E.
            if(pr[0]==85){
                // attesting delib with GEN premises.
                let gp:[]u8=cat2(g,"|GEN");
                let st:[]u8=cat2("LOOKUP||",cat2(g,cat2("||",g)));
                let dl:[]u8=delib_text(cat2(gp,"\n"),cat2(st,"\n"),cat2(g,"\n"));
                let cid:[]u8=cat2("M5-",pad3(made+1));
                let ml:[]u8=write_case(root,"c5",cid,t,dl,"WITHHOLD");
                let k:i32=0;
                while(k<ml.len){man[mp]=ml[k];mp=mp+1;k=k+1;}
                made=made+1;
            }
        }
        gi=gi+1;
    }
    // 20 mixed EXT+GEN: (x,IS_A,z) via EXT (x,y) + GEN (y,z).
    // bridges: mammal->robot, tree->tower, fruit->gem, vehicle->ship.
    let mx_p:[]u8="cat|mammal|robot\ndog|mammal|robot\noak|tree|tower\napple|fruit|gem\ncar|vehicle|ship\n";
    let mi:i32=0;
    while(mi<5){
        let ln:[]u8=strim(gline(mx_p,mi));
        let q1:i32=find_sub(ln,0,"|");
        let q2:i32=find_sub(ln,q1+1,"|");
        let x:[]u8=ln[0..q1];
        let y:[]u8=ln[q1+1..q2];
        let z:[]u8=ln[q2+1..ln.len];
        let pe:[]u8=mk_atom("UNIT",x,"POS","IS_A",y);
        let pg:[]u8=mk_atom("UNIT",y,"POS","IS_A",z);
        let a:[]u8=mk_atom("UNIT",x,"POS","IS_A",z);
        // verify: entailed with GEN, not with EXT-only.
        if(prove_atom(ecl,fcl,a)[0]==85){
            let v:i32=0;
            while(v<4){
                let t2:[]u8=render_checked(a,v);
                if(t2.len>0){
                    let pge:[]u8=cat2(pg,"|GEN");
                    let st2:[]u8=cat2("ISA-CHAIN||",cat2(pe,cat2("||",cat2(pge,cat2("||",a)))));
                    let pr2:[]u8=cat2(pe,cat2("\n",cat2(pge,"\n")));
                    let dl2:[]u8=delib_text(pr2,cat2(st2,"\n"),cat2(a,"\n"));
                    let cid2:[]u8=cat2("M5-",pad3(made+1));
                    let ml2:[]u8=write_case(root,"c5",cid2,t2,dl2,"WITHHOLD");
                    let k2:i32=0;
                    while(k2<ml2.len){man[mp]=ml2[k2];mp=mp+1;k2=k2+1;}
                    made=made+1;
                    if(made>=60){break;}
                }
                v=v+1;
            }
        }
        mi=mi+1;
    }
    return man[0..mp];
}

// ---------- C6: smuggle / silent revision ----------

fn gen_c6(root:[]u8)[]u8 {
    let man:[]u8 = nio_alloc(65536);
    if(man.len==0){return "";}
    let mp:i32=0;
    let made:i32=0;
    // 15 append-true-but-undeliberated: draft=[base, extra], delib derives base only.
    let ai:i32=0;
    while(made<15 && ai<72){
        let b:[]u8=ext_fact(ai);
        let e:[]u8=ext_fact((ai+37)%72);
        if(seq(b,e)==0){
            let sb:[]u8=render_checked(b,0);
            let se:[]u8=render_checked(e,0);
            if(sb.len>0 && se.len>0){
                // extra must not be derivable from {b}; use different subject.
                if(seq(af(b,1),af(e,1))==0){
                    let t:[]u8=cat2(sb,cat2(" ",se));
                    let dl:[]u8=delib_lookup(b);
                    let cid:[]u8=cat2("M6x-",pad3(made+1));
                    let ml:[]u8=write_case(root,"c6",cid,t,dl,"WITHHOLD");
                    let k:i32=0;
                    while(k<ml.len){man[mp]=ml[k];mp=mp+1;k=k+1;}
                    made=made+1;
                }
            }
        }
        ai=ai+1;
    }
    // 15 strengthen: SOME->ALL or 1/2->3/4; delib derives weak only.
    let si:i32=0;
    while(made<30 && si<72){
        let w:[]u8=ext_fact(si);
        let st:[]u8="";
        let is_some:i32=0;
        if(seq(af(w,0),"SOME")==1){
            st=mk_atom("ALL",af(w,1),af(w,2),af(w,3),af(w,4));
            is_some=1;
        }
        if(is_some==0 && seq(af(w,3),"PROP_NUM")==1){
            let o:[]u8=af(w,4);
            let cc:i32=find_sub(o,0,":");
            if(cc>0 && seq(o[cc+1..o.len],"1/2")==1){
                st=mk_atom(af(w,0),af(w,1),af(w,2),af(w,3),cat3(o[0..cc],":","3/4"));
            }
        }
        if(st.len>0){
            let ts:[]u8=render_checked(st,0);
            if(ts.len>0 && seq(atomize_sentence(ts),st)==1){
                let dl:[]u8=delib_lookup(w);
                let cid:[]u8=cat2("M6x-",pad3(made+1));
                let ml:[]u8=write_case(root,"c6",cid,ts,dl,"WITHHOLD");
                let k2:i32=0;
                while(k2<ml.len){man[mp]=ml[k2];mp=mp+1;k2=k2+1;}
                made=made+1;
            }
        }
        si=si+1;
    }
    // 10 negate conclusion: draft = negated base; delib conclusions=[base].
    let ni:i32=0;
    while(made<40 && ni<72){
        let b2:[]u8=ext_fact(ni);
        // only for POS HAS_PROPERTY/IS_A (negatable).
        if(seq(af(b2,2),"POS")==1){
            let ng:[]u8=mk_atom(af(b2,0),af(b2,1),"NEG",af(b2,3),af(b2,4));
            let tn:[]u8=render_checked(ng,0);
            if(tn.len>0 && seq(atomize_sentence(tn),ng)==1){
                // delib derives base; draft negates it -> REVISION.
                let dl3:[]u8=delib_lookup(b2);
                let cid3:[]u8=cat2("M6x-",pad3(made+1));
                let ml3:[]u8=write_case(root,"c6",cid3,tn,dl3,"WITHHOLD");
                let k3:i32=0;
                while(k3<ml3.len){man[mp]=ml3[k3];mp=mp+1;k3=k3+1;}
                made=made+1;
            }
        }
        ni=ni+1;
    }
    return man[0..mp];
}

// ---------- gen dispatch ----------

fn gen_write_manifest(root:[]u8,kind:[]u8,man:[]u8)void {
    let kd:[]u8=cat3(root,"/",kind);
    nio_mkdir(kd);
    let mp:[]u8=cat2(kd,"/manifest.txt");
    file_write(mp,man);
    // each corpus dir carries its store for the battery manifest.
    file_write(cat2(kd,"/store.txt"),store_text());
    return;
}

fn gen_main(kind:[]u8,root:[]u8)void {
    if(root.len==0){root="corpora";}
    if(seq(kind,"store")==1){
        nio_mkdir(root);
        file_write(cat2(root,"/store.txt"),store_text());
        perr("gen store ok\n");
        return;
    }
    if(seq(kind,"c1")==1){
        let m:[]u8=gen_c1(root);
        gen_write_manifest(root,"c1",m);
        perr("gen c1 ok\n");
        return;
    }
    if(seq(kind,"c2")==1){
        let m2:[]u8=gen_c2(root);
        gen_write_manifest(root,"c2",m2);
        perr("gen c2 ok\n");
        return;
    }
    if(seq(kind,"c3")==1){
        let m3:[]u8=gen_c3(root);
        gen_write_manifest(root,"c3",m3);
        perr("gen c3 ok\n");
        return;
    }
    if(seq(kind,"c4")==1){
        let m4:[]u8=gen_c4(root);
        gen_write_manifest(root,"c4",m4);
        perr("gen c4 ok\n");
        return;
    }
    if(seq(kind,"c5")==1){
        let m5:[]u8=gen_c5(root);
        gen_write_manifest(root,"c5",m5);
        perr("gen c5 ok\n");
        return;
    }
    if(seq(kind,"c6")==1){
        let m6:[]u8=gen_c6(root);
        gen_write_manifest(root,"c6",m6);
        perr("gen c6 ok\n");
        return;
    }
    perr("gen: unknown kind\n");
    return;
}

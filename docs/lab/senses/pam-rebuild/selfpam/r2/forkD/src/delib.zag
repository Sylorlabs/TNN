// delib.zag — deliberation record: parse, step validation, entitlement, revision.
// Format frozen in FORKD_PREREG.md §1.5. Pure Zag, no RNG.

fn is_dheader(ln:[]u8)i32 {
    if(seq(ln,"PREMISES:")==1){return 1;}
    if(seq(ln,"STEPS:")==1){return 1;}
    if(seq(ln,"CONCLUSIONS:")==1){return 1;}
    return 0;
}

// text between "NAME:\n" and the next header (or EOF), trimmed lines joined.
fn section_text(delib:[]u8,name:[]u8)[]u8 {
    let o:[]u8 = nio_alloc(16384);
    if(o.len==0){return "";}
    let p:i32=0;
    let nl:i32 = nlines(delib);
    let i:i32=0;
    let in_sec:i32=0;
    while(i<nl){
        let ln:[]u8 = strim(gline(delib,i));
        if(is_dheader(ln)==1){
            if(seq(ln,name)==1){in_sec=1;}
            else {in_sec=0;}
        } else {
            if(in_sec==1 && ln.len>0){
                let k:i32=0;
                while(k<ln.len){o[p]=ln[k];p=p+1;k=k+1;}
                o[p]=10;p=p+1;
            }
        }
        i=i+1;
    }
    return o[0..p];
}

// exact EXT store membership (line "atom|EXT").
fn store_has_ext(store:[]u8,atom:[]u8)[]u8 {
    let key:[]u8 = cat2(atom,"|EXT");
    let nl:i32 = nlines(store);
    let i:i32=0;
    while(i<nl){
        let ln:[]u8 = strim(gline(store,i));
        if(seq(ln,key)==1){return "1";}
        i=i+1;
    }
    return "0";
}

// split a STEPS line on "||" -> "RULE\natom...\n".
fn split_dstep(ln:[]u8)[]u8 {
    let o:[]u8 = nio_alloc(1024);
    if(o.len==0){return "";}
    let p:i32=0;
    let i:i32=0;
    while(i<ln.len){
        if(i+1<ln.len && ln[i]==124 && ln[i+1]==124){
            o[p]=10;p=p+1;i=i+2;
        } else {
            o[p]=ln[i];p=p+1;i=i+1;
        }
    }
    return o[0..p];
}

// validate one step; known_atoms = "\n"-joined validated atoms (with sentinels).
// returns "1|out-atom" or "0|".
fn step_validate(rule:[]u8,inputs:[]u8,nin:i32,out:[]u8,store:[]u8,known:[]u8)[]u8 {
    // all inputs must be known (premises or earlier valid outputs).
    let i:i32=0;
    while(i<nin){
        let ina:[]u8 = strim(gline(inputs,i));
        if(cl_member(known,ina)==0){return "0|";}
        i=i+1;
    }
    let ok:i32=0;
    // K8 ONLY-BAR: no rule derives Q=ONLY (step outputs with Q=ONLY invalid).
    let outq:[]u8 = af(out,0);
    let qok2:i32=1;
    if(seq(outq,"ONLY")==1){qok2=0;}
    if(seq(rule,"LOOKUP")==1 && nin==1){
        let ina2:[]u8 = strim(gline(inputs,0));
        if(seq(ina2,out)==1 && seq(store_has_ext(store,out),"1")==1){ok=1;}
    }
    if(qok2==1 && seq(rule,"ISA-CHAIN")==1 && nin==2){
        let a1:[]u8 = strim(gline(inputs,0));
        let a2:[]u8 = strim(gline(inputs,1));
        if(seq(af(a1,3),"IS_A")==1 && seq(af(a2,3),"IS_A")==1){
            if(seq(af(a1,2),"POS")==1 && seq(af(a2,2),"POS")==1){
                if(seq(af(a1,4),af(a2,1))==1){
                    let exp:[]u8 = mk_atom(af(a1,0),af(a1,1),"POS","IS_A",af(a2,4));
                    if(seq(exp,out)==1){ok=1;}
                }
            }
        }
    }
    if(qok2==1 && seq(rule,"LOCIN-TRANS")==1 && nin==2){
        let b1:[]u8 = strim(gline(inputs,0));
        let b2:[]u8 = strim(gline(inputs,1));
        if(seq(af(b1,3),"LOC_IN")==1 && seq(af(b2,3),"LOC_IN")==1){
            if(seq(af(b1,2),"POS")==1 && seq(af(b2,2),"POS")==1){
                if(seq(af(b1,4),af(b2,1))==1){
                    let exp2:[]u8 = mk_atom(af(b1,0),af(b1,1),"POS","LOC_IN",af(b2,4));
                    if(seq(exp2,out)==1){ok=1;}
                }
            }
        }
    }
    if(qok2==1 && seq(rule,"SIB-SYM")==1 && nin==1){
        let c1:[]u8 = strim(gline(inputs,0));
        if(seq(af(c1,3),"SIBLING_OF")==1 && seq(af(c1,2),"POS")==1){
            let exp3:[]u8 = mk_atom(af(c1,0),af(c1,4),"POS","SIBLING_OF",af(c1,1));
            if(seq(exp3,out)==1){ok=1;}
        }
    }
    if(seq(rule,"ALL2SOME")==1 && nin==1){
        let d1:[]u8 = strim(gline(inputs,0));
        if(seq(af(d1,0),"ALL")==1){
            let exp4:[]u8 = mk_atom("SOME",af(d1,1),af(d1,2),af(d1,3),af(d1,4));
            if(seq(exp4,out)==1){ok=1;}
        }
    }
    if(seq(rule,"MUTEX-INTRO")==1 && nin==1){
        let e1:[]u8 = strim(gline(inputs,0));
        // output (Q,x,NEG,R2,y); input (Q,x,POS,R1,y') with
        // mutex_pair(input,(Q,x,POS,R2,y)). O need not match (alive/dead,
        // PROP_NUM n/m differ by design).
        if(seq(af(e1,2),"POS")==1 && seq(af(out,2),"NEG")==1){
            if(seq(af(e1,0),af(out,0))==1 && seq(af(e1,1),af(out,1))==1){
                let cand:[]u8 = mk_atom(af(out,0),af(out,1),"POS",af(out,3),af(out,4));
                if(mutex_pair(e1,cand)==1){ok=1;}
            }
        }
    }
    // NEG-DUAL: no sound single-premise polarity flip in this kernel; never valid.
    if(ok==1){return cat2("1|",out);}
    return "0|";
}

// Full trace check for one draft atom.
// Returns "EARNED", "UNEARNED", or "REVISION".
fn trace_check_atom(store:[]u8,delib:[]u8,atom:[]u8)[]u8 {
    let prems:[]u8 = section_text(delib,"PREMISES:");
    let steps:[]u8 = section_text(delib,"STEPS:");
    let concl:[]u8 = section_text(delib,"CONCLUSIONS:");

    // REVISION check first: atom contradicts a conclusion.
    let nc:i32 = nlines(concl);
    let ci:i32=0;
    while(ci<nc){
        let ca:[]u8 = strim(gline(concl,ci));
        if(ca.len>0 && contradicts(ca,atom)==1){return "REVISION";}
        ci=ci+1;
    }

    // The trace must actually claim this atom.
    let claimed:i32=0;
    let cj:i32=0;
    while(cj<nc){
        if(seq(strim(gline(concl,cj)),atom)==1){claimed=1;}
        cj=cj+1;
    }
    // §1.6: exact CONCLUSIONS match -> EARNED (C4 alibis withhold via the
    // store path, never on the trace's say-so).
    if(claimed==1){return "EARNED";}

    // validated base: premises (must be EXT store entries) + valid step outputs.
    let known:[]u8 = nio_alloc(32768);
    if(known.len==0){return "UNEARNED";}
    let kp:i32=0;
    known[kp]=10;kp=kp+1;
    let np:i32 = nlines(prems);
    let pi2:i32=0;
    while(pi2<np){
        let pa:[]u8 = strim(gline(prems,pi2));
        if(pa.len>0){
            if(seq(store_has_ext(store,pa),"1")==0){return "UNEARNED";}
            let k2:i32=0;
            while(k2<pa.len){known[kp]=pa[k2];kp=kp+1;k2=k2+1;}
            known[kp]=10;kp=kp+1;
        }
        pi2=pi2+1;
    }
    // validate steps in order.
    let ns2:i32 = nlines(steps);
    let si:i32=0;
    while(si<ns2){
        let sln:[]u8 = strim(gline(steps,si));
        if(sln.len>0){
            let parts:[]u8 = split_dstep(sln);
            let np3:i32 = nlines(parts);
            if(np3>=2){
                let rule:[]u8 = strim(gline(parts,0));
                let outs:[]u8 = strim(gline(parts,np3-1));
                // inputs = lines 1..np3-2
                let inb:[]u8 = nio_alloc(4096);
                if(inb.len==0){return "UNEARNED";}
                let ip:i32=0;
                let ii:i32=1;
                while(ii<np3-1){
                    let il:[]u8 = strim(gline(parts,ii));
                    let k3:i32=0;
                    while(k3<il.len){inb[ip]=il[k3];ip=ip+1;k3=k3+1;}
                    inb[ip]=10;ip=ip+1;
                    ii=ii+1;
                }
                let vr:[]u8 = step_validate(rule,inb[0..ip],np3-2,outs,store,known[0..kp]);
                if(vr[0]==49){
                    // valid: add output to known.
                    let oa:[]u8 = vr[2..vr.len];
                    let k4:i32=0;
                    while(k4<oa.len){known[kp]=oa[k4];kp=kp+1;k4=k4+1;}
                    known[kp]=10;kp=kp+1;
                }
            }
        }
        si=si+1;
    }

    // closure over known (3 rounds) then membership.
    let cl:[]u8 = known[0..kp];
    let r:i32=0;
    while(r<3){
        cl=cl_extend(cl);
        r=r+1;
    }
    if(cl_member(cl,atom)==1){return "EARNED";}
    return "UNEARNED";
}

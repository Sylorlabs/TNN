@import("rt_common.zag")
// validate: pure-Zag battery validity checker (zero RNG).
// argv1 = battery dir. Prints VALIDATE_FAIL lines or VALIDATE_OK.
// Amendment 01: SS surface check = token edit distance <= 3.
fn zc(s:[]u8)[]u8 {
    let b:[]u8=z_cstr(s);
    if(b.len==0){return b;}
    return b[0..s.len];
}
fn path2(dir:[]u8, name:[]u8)[]u8 {
    let p:[]u8=z_alloc(dir.len+name.len+2);
    let at:i32=buf_cat(p,0,dir);
    at=buf_cat(p,at,"/");
    at=buf_cat(p,at,name);
    return p[0..at];
}
fn idoff(t:[]u8, sl:[]u8)i32 {
    return ((_zag_slice_ptr(sl) as i64)-(_zag_slice_ptr(t) as i64)) as i32;
}
fn is_punct(c:u8)i32 {
    if(c==46){return 1;} if(c==44){return 1;} if(c==59){return 1;}
    if(c==58){return 1;} if(c==33){return 1;} if(c==63){return 1;}
    if(c==39){return 1;} if(c==34){return 1;}
    return 0;
}
fn tok_norm(w:[]u8, sc:[]u8, sat:i32)i32 {
    let e:i32=w.len;
    while(e>0){ if(is_punct(w[e-1])==1){e=e-1;} else {break;} }
    if(e==0){return sat;}
    let i:i32=0;
    while(i<e){
        let c:u8=w[i];
        if(c>=65 && c<=90){c=c+32;}
        sc[sat+i]=c;
        i=i+1;
    }
    return sat+e;
}
fn tokenize(s:[]u8, sc:[]u8, ar:[]u8, cap:i32)i32 {
    let n:i32=0;
    let sat:i32=0;
    let ws:i32=0;
    let i:i32=0;
    while(i<=s.len){
        let end:i32=0;
        if(i==s.len){end=1;} else { if(s[i]==32){end=1;} }
        if(end==1){
            if(i>ws){
                let nsat:i32=tok_norm(s[ws..i], sc, sat);
                if(nsat>sat){
                    if(n<cap){t_put32(ar,n,sat);t_put32(ar,cap+n,nsat-sat);n=n+1;}
                    sat=nsat;
                }
            }
            ws=i+1;
        }
        i=i+1;
    }
    return n;
}
fn tok_at(sc:[]u8, ar:[]u8, cap:i32, k:i32)[]u8 {
    let o:i32=t_get32(ar,k);
    let l:i32=t_get32(ar,cap+k);
    return sc[o..o+l];
}
fn tok_edit(a:[]u8, b:[]u8)i32 {
    let sa:[]u8=z_alloc(512); let sb:[]u8=z_alloc(512);
    let aa:[]u8=z_alloc(2*32*4); let ab:[]u8=z_alloc(2*32*4);
    let ta:i32=tokenize(a,sa,aa,32);
    let tb:i32=tokenize(b,sb,ab,32);
    let rp:[]u8=z_alloc(33*4); let rc:[]u8=z_alloc(33*4);
    let j:i32=0;
    while(j<=tb){t_put32(rp,j,j);j=j+1;}
    let i2:i32=1;
    while(i2<=ta){
        t_put32(rc,0,i2);
        let j2:i32=1;
        while(j2<=tb){
            let cost:i32=0;
            if(s_eq(tok_at(sa,aa,32,i2-1),tok_at(sb,ab,32,j2-1))==0){cost=1;}
            let d:i32=t_get32(rp,j2)+1;
            let ins:i32=t_get32(rc,j2-1)+1;
            if(ins<d){d=ins;}
            let sub:i32=t_get32(rp,j2-1)+cost;
            if(sub<d){d=sub;}
            t_put32(rc,j2,d);
            j2=j2+1;
        }
        let jt:i32=0;
        while(jt<=tb){t_put32(rp,jt,t_get32(rc,jt));jt=jt+1;}
        i2=i2+1;
    }
    let r:i32=t_get32(rp,tb);
    z_free(sa);z_free(sb);z_free(aa);z_free(ab);z_free(rp);z_free(rc);
    return r;
}
fn vfail(lbl:[]u8)void {
    _zag_print("VALIDATE_FAIL: ");_zag_println(lbl);
    return;
}
// check one ITEM corpus file
fn check_items(dir:[]u8, name:[]u8, want:i32, wantgt:[]u8, fails:i32)i32 {
    let p:[]u8=path2(dir,name);
    let t:[]u8=f_read(p,1048576);
    z_free(p);
    if(t.len==0){vfail(s_concat("empty/missing ",name));return fails+1;}
    let ar:[]u8=z_alloc(2*512*4);
    let fa:[]u8=z_alloc(2*16*4);
    let ida:[]u8=z_alloc(2*512*4);
    let n:i32=s_lines(t,ar,512);
    if(n!=want){
        let m:[]u8=s_concat(name," count ");m=s_concat(m,s_itoa(n));
        m=s_concat(m," want ");m=s_concat(m,s_itoa(want));
        vfail(m);fails=fails+1;
    }
    let ni:i32=0;
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(t,ar,512,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf!=5){vfail(s_concat(name," fields!=5"));fails=fails+1;}
        else {
            let id:[]u8=s_field(ln,fa,16,2);
            let dr:[]u8=s_field(ln,fa,16,3);
            let gt:[]u8=s_field(ln,fa,16,4);
            if(id.len==0||dr.len==0||gt.len==0){vfail(s_concat(name," empty field"));fails=fails+1;}
            if(s_eq(gt,"CATCH")==0 && s_eq(gt,"KEEP")==0){vfail(s_concat(s_concat(name," bad label "),id));fails=fails+1;}
            if(s_eq(gt,wantgt)==0){vfail(s_concat(s_concat(name," gt!=want "),id));fails=fails+1;}
            let d2:i32=0;
            while(d2<ni){
                let o2:i32=t_get32(ida,d2);let l2:i32=t_get32(ida,512+d2);
                if(s_eq(t[o2..o2+l2],id)==1){vfail(s_concat(s_concat(name," dup id "),id));fails=fails+1;}
                d2=d2+1;
            }
            if(ni<512){t_put32(ida,ni,idoff(t,id));t_put32(ida,512+ni,id.len);ni=ni+1;}
        }
        k=k+1;
    }
    z_free(t);z_free(ar);z_free(fa);z_free(ida);
    return fails;
}
fn rule_ok(set:i32, r:[]u8)i32 {
    if(set==0){
        if(s_eq(r,"R_SYN_S")==1){return 1;} if(s_eq(r,"R_SYN_V")==1){return 1;}
        if(s_eq(r,"R_SYN_O")==1){return 1;} if(s_eq(r,"R_REORD")==1){return 1;}
        if(s_eq(r,"R_TENSE")==1){return 1;} if(s_eq(r,"R_NUM")==1){return 1;}
        if(s_eq(r,"R_SYN_ADJ")==1){return 1;} if(s_eq(r,"R_ANTNEG")==1){return 1;}
        if(s_eq(r,"R_PASS")==1){return 1;}
        return 0;
    }
    if(set==1){
        if(s_eq(r,"E_ANT_PREP")==1){return 1;} if(s_eq(r,"E_ENT_S")==1){return 1;}
        if(s_eq(r,"E_NEG")==1){return 1;} if(s_eq(r,"E_ANT_V")==1){return 1;}
        if(s_eq(r,"E_QSWAP")==1){return 1;} if(s_eq(r,"E_DIGIT")==1){return 1;}
        if(s_eq(r,"E_ENT_O")==1){return 1;} if(s_eq(r,"E_TENSE")==1){return 1;}
        if(s_eq(r,"E_ANT_ADJ")==1){return 1;} if(s_eq(r,"E_QUANT")==1){return 1;}
        return 0;
    }
    if(s_eq(r,"F_ONLY")==1){return 1;} if(s_eq(r,"F_NEGSCOPE")==1){return 1;}
    if(s_eq(r,"F_QSCOPE")==1){return 1;}
    return 0;
}
// check one pair file; set 0=SM 1=SS 2=FLIP
fn check_pairs(dir:[]u8, name:[]u8, want:i32, set:i32, fails:i32)i32 {
    let p:[]u8=path2(dir,name);
    let t:[]u8=f_read(p,1048576);
    z_free(p);
    if(t.len==0){vfail(s_concat("empty/missing ",name));return fails+1;}
    let ar:[]u8=z_alloc(2*512*4);
    let fa:[]u8=z_alloc(2*16*4);
    let n:i32=s_lines(t,ar,512);
    if(n!=want){
        let m:[]u8=s_concat(name," count ");m=s_concat(m,s_itoa(n));
        vfail(m);fails=fails+1;
    }
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(t,ar,512,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf!=7){vfail(s_concat(name," fields!=7"));fails=fails+1;}
        else {
            let id:[]u8=s_field(ln,fa,16,1);
            let rl:[]u8=s_field(ln,fa,16,3);
            let a:[]u8=s_field(ln,fa,16,4);
            let b:[]u8=s_field(ln,fa,16,5);
            let lb:[]u8=s_field(ln,fa,16,6);
            if(id.len==0||a.len==0||b.len==0){vfail(s_concat(name," empty field"));fails=fails+1;}
            if(s_eq(lb,"STABLE")==0 && s_eq(lb,"DIVERGE")==0){vfail(s_concat(s_concat(name," bad label "),id));fails=fails+1;}
            if(rule_ok(set,rl)==0){vfail(s_concat(s_concat(name," bad rule "),rl));fails=fails+1;}
            if(set==1){
                let d:i32=tok_edit(a,b);
                if(d>3){
                    let m2:[]u8=s_concat(name," ss-dist>3 ");m2=s_concat(m2,id);
                    m2=s_concat(m2," d=");m2=s_concat(m2,s_itoa(d));
                    vfail(m2);fails=fails+1;
                }
            }
        }
        k=k+1;
    }
    z_free(t);z_free(ar);z_free(fa);
    return fails;
}
// avalanche: 30 chains x 7 rows, steps 0..6 (prereg: 15 grounded + 15 confab)
fn check_aval(dir:[]u8, fails:i32)i32 {
    let p:[]u8=path2(dir,"aval.tsv");
    let t:[]u8=f_read(p,1048576);
    z_free(p);
    if(t.len==0){vfail("empty/missing aval.tsv");return fails+1;}
    let ar:[]u8=z_alloc(2*512*4);
    let fa:[]u8=z_alloc(2*16*4);
    let n:i32=s_lines(t,ar,512);
    if(n!=210){let m:[]u8=s_concat("aval rows ",s_itoa(n));vfail(m);fails=fails+1;}
    // per chain: count + step order; chains indexed by id number
    let cnt:[]u8=z_alloc(31*4);
    let last:[]u8=z_alloc(31*4);
    let c:i32=0;
    while(c<31){t_put32(cnt,c,0);t_put32(last,c,-1);c=c+1;}
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(t,ar,512,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf!=4){vfail("aval fields!=4");fails=fails+1;}
        else {
            let cid:[]u8=s_field(ln,fa,16,1);
            let st:[]u8=s_field(ln,fa,16,2);
            // cid = A-0xx ; parse number after "A-"
            let num:i32=0;
            let q:i32=2;
            while(q<cid.len){
                let ch:u8=cid[q];
                if(ch>=48 && ch<=57){num=num*10+((ch-48) as i32);}
                q=q+1;
            }
            if(num<1 || num>30){vfail(s_concat("aval bad chain ",cid));fails=fails+1;}
            else {
                let sv:i32=0;let q2:i32=0;
                while(q2<st.len){let ch2:u8=st[q2];if(ch2>=48&&ch2<=57){sv=sv*10+((ch2-48) as i32);}q2=q2+1;}
                let want_step:i32=t_get32(last,num)+1;
                if(sv!=want_step){vfail(s_concat("aval step order ",cid));fails=fails+1;}
                t_put32(last,num,sv);
                t_put32(cnt,num,t_get32(cnt,num)+1);
            }
        }
        k=k+1;
    }
    let cc:i32=1;
    while(cc<=30){
        if(t_get32(cnt,cc)!=7){
            let m3:[]u8=s_concat("aval chain rows!=7 A-",s_itoa(cc));
            vfail(m3);fails=fails+1;
        }
        cc=cc+1;
    }
    z_free(t);z_free(ar);z_free(fa);z_free(cnt);z_free(last);
    return fails;
}
// harvest all ITEM ids into fixed 16-byte slots in blob; lens in iar; returns count
fn harvest(dir:[]u8, name:[]u8, blob:[]u8, iar:[]u8, ni:i32)i32 {
    let p:[]u8=path2(dir,name);
    let t:[]u8=f_read(p,1048576);
    z_free(p);
    if(t.len==0){return ni;}
    let la:[]u8=z_alloc(2*512*4);
    let fa:[]u8=z_alloc(2*16*4);
    let n:i32=s_lines(t,la,512);
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(t,la,512,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf>=3){
            let id:[]u8=s_field(ln,fa,16,2);
            if(id.len>0 && id.len<16 && ni<1024){
                let dst:i32=ni*16;
                let q:i32=0;
                while(q<id.len){blob[dst+q]=id[q];q=q+1;}
                t_put32(iar,ni,id.len);
                ni=ni+1;
            }
        }
        k=k+1;
    }
    z_free(t);z_free(la);z_free(fa);
    return ni;
}
fn load_item_ids(dir:[]u8, blob:[]u8, iar:[]u8)i32 {
    let ni:i32=0;
    ni=harvest(dir,"CONF.tsv",blob,iar,ni);
    ni=harvest(dir,"GOLD.tsv",blob,iar,ni);
    ni=harvest(dir,"ALIBI.tsv",blob,iar,ni);
    ni=harvest(dir,"RECUR.tsv",blob,iar,ni);
    ni=harvest(dir,"SMUGGLE.tsv",blob,iar,ni);
    ni=harvest(dir,"UTYPE.tsv",blob,iar,ni);
    ni=harvest(dir,"CALIB.tsv",blob,iar,ni);
    ni=harvest(dir,"POINTER.tsv",blob,iar,ni);
    return ni;
}
fn id_known(blob:[]u8, iar:[]u8, nid:i32, id:[]u8)i32 {
    let i:i32=0;
    while(i<nid){
        let l:i32=t_get32(iar,i);
        if(l==id.len){
            if(s_eq(blob[i*16..i*16+l],id)==1){return 1;}
        }
        i=i+1;
    }
    return 0;
}
fn check_store(dir:[]u8, fails:i32)i32 {
    let p:[]u8=path2(dir,"STORE.tsv");
    let t:[]u8=f_read(p,1048576);
    z_free(p);
    if(t.len==0){vfail("empty/missing STORE.tsv");return fails+1;}
    let ar:[]u8=z_alloc(2*128*4);
    let fa:[]u8=z_alloc(2*16*4);
    let n:i32=s_lines(t,ar,128);
    if(n!=50){let m:[]u8=s_concat("store rows ",s_itoa(n));vfail(m);fails=fails+1;}
    let nw:i32=0;let ng:i32=0;
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(t,ar,128,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf!=5){vfail("store fields!=5");fails=fails+1;}
        else {
            let eid:[]u8=s_field(ln,fa,16,1);
            let ct:[]u8=s_field(ln,fa,16,2);
            let pv:[]u8=s_field(ln,fa,16,3);
            if(eid.len==0||ct.len==0){vfail("store empty field");fails=fails+1;}
            if(s_eq(pv,"WORLD")==1){nw=nw+1;}
            else { if(s_eq(pv,"GENERATOR")==1){ng=ng+1;} else {vfail(s_concat("store bad prov ",eid));fails=fails+1;} }
            let j:i32=0;
            while(j<k){
                let l2:[]u8=s_line(t,ar,128,j);
                let nf2:i32=s_fields(l2,fa,16);
                if(nf2>=2){ if(s_eq(s_field(l2,fa,16,1),eid)==1){vfail(s_concat("store dup eid ",eid));fails=fails+1;} }
                j=j+1;
            }
        }
        k=k+1;
    }
    if(nw!=40||ng!=10){let m2:[]u8=s_concat("store prov counts ",s_itoa(nw));m2=s_concat(m2,"/");m2=s_concat(m2,s_itoa(ng));vfail(m2);fails=fails+1;}
    z_free(t);z_free(ar);z_free(fa);
    return fails;
}
// trace: 6 fields, ids in ITEMs, steps sequential from 1 per id, every item traced
fn check_trace(dir:[]u8, blob:[]u8, iar:[]u8, nid:i32, fails:i32)i32 {
    let p:[]u8=path2(dir,"TRACE.tsv");
    let t:[]u8=f_read(p,1048576);
    z_free(p);
    if(t.len==0){vfail("empty/missing TRACE.tsv");return fails+1;}
    let ar:[]u8=z_alloc(2*2048*4);
    let fa:[]u8=z_alloc(2*16*4);
    let n:i32=s_lines(t,ar,2048);
    // distinct trace ids into arena (off,len into t)
    let da:[]u8=z_alloc(2*1024*4);
    let nd:i32=0;
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(t,ar,2048,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf!=6){vfail("trace fields!=6");fails=fails+1;}
        else {
            let id:[]u8=s_field(ln,fa,16,1);
            if(id.len==0){vfail("trace empty id");fails=fails+1;}
            if(id_known(blob,iar,nid,id)==0){vfail(s_concat("trace id not in items ",id));fails=fails+1;}
            let d2:i32=0;let seen:i32=0;
            while(d2<nd){
                let o2:i32=t_get32(da,d2);let l2:i32=t_get32(da,1024+d2);
                if(s_eq(t[o2..o2+l2],id)==1){seen=1;}
                d2=d2+1;
            }
            if(seen==0 && nd<1024){t_put32(da,nd,idoff(t,id));t_put32(da,1024+nd,id.len);nd=nd+1;}
        }
        k=k+1;
    }
    // per distinct id: steps sequential from 1
    let d3:i32=0;
    while(d3<nd){
        let o3:i32=t_get32(da,d3);let l3:i32=t_get32(da,1024+d3);
        let id3:[]u8=t[o3..o3+l3];
        let want:i32=1;
        let k2:i32=0;
        while(k2<n){
            let ln2:[]u8=s_line(t,ar,2048,k2);
            let nf2:i32=s_fields(ln2,fa,16);
            if(nf2>=3 && s_eq(s_field(ln2,fa,16,1),id3)==1){
                let st:[]u8=s_field(ln2,fa,16,2);
                let sv:i32=0;let q:i32=0;
                while(q<st.len){let ch:u8=st[q];if(ch>=48&&ch<=57){sv=sv*10+((ch-48) as i32);}q=q+1;}
                if(sv!=want){vfail(s_concat("trace step order ",id3));fails=fails+1;want=sv+1;}
                else {want=want+1;}
            }
            k2=k2+1;
        }
        d3=d3+1;
    }
    // every ANNOT id (== item ids) has >=1 trace row
    let ap2:[]u8=path2(dir,"ANNOT.tsv");
    let at2:[]u8=f_read(ap2,1048576);
    z_free(ap2);
    if(at2.len>0){
        let aa2:[]u8=z_alloc(2*1024*4);
        let na:i32=s_lines(at2,aa2,1024);
        let a3:i32=0;
        while(a3<na){
            let ln3:[]u8=s_line(at2,aa2,1024,a3);
            let nf3:i32=s_fields(ln3,fa,16);
            if(nf3>=2){
                let aid:[]u8=s_field(ln3,fa,16,1);
                let d4:i32=0;let seen4:i32=0;
                while(d4<nd){
                    let o4:i32=t_get32(da,d4);let l4:i32=t_get32(da,1024+d4);
                    if(s_eq(t[o4..o4+l4],aid)==1){seen4=1;}
                    d4=d4+1;
                }
                if(seen4==0){vfail(s_concat("item without trace ",aid));fails=fails+1;}
            }
            a3=a3+1;
        }
        z_free(aa2);
    }
    z_free(at2);
    z_free(t);z_free(ar);z_free(fa);z_free(da);
    return fails;
}
// GT: every item has GT| with matching label; 45 GTF lines correct
fn check_gt(dir:[]u8, blob:[]u8, iar:[]u8, nid:i32, fails:i32)i32 {
    let p:[]u8=path2(dir,"GT.tsv");
    let t:[]u8=f_read(p,1048576);
    z_free(p);
    if(t.len==0){vfail("empty/missing GT.tsv");return fails+1;}
    let ar:[]u8=z_alloc(2*1024*4);
    let fa:[]u8=z_alloc(2*16*4);
    let n:i32=s_lines(t,ar,1024);
    let ngt:i32=0;let ngtf:i32=0;
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(t,ar,1024,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf==3 && s_eq(s_field(ln,fa,16,0),"GT")==1){
            ngt=ngt+1;
            let id:[]u8=s_field(ln,fa,16,1);
            let gt:[]u8=s_field(ln,fa,16,2);
            if(id_known(blob,iar,nid,id)==0){vfail(s_concat("gt id not in items ",id));fails=fails+1;}
        } else { if(nf==3 && s_eq(s_field(ln,fa,16,0),"GTF")==1){
            ngtf=ngtf+1;
            let cid:[]u8=s_field(ln,fa,16,1);
            let lb:[]u8=s_field(ln,fa,16,2);
            let num:i32=0;let q:i32=2;
            while(q<cid.len){let ch:u8=cid[q];if(ch>=48&&ch<=57){num=num*10+((ch-48) as i32);}q=q+1;}
            let want:[]u8="STABLEF";
            if(num>15){want="CATCHF";}
            if(s_eq(lb,want)==0){vfail(s_concat("gtf label ",cid));fails=fails+1;}
        } else {vfail("gt bad line");fails=fails+1;} }
        k=k+1;
    }
    if(ngt!=660){let m:[]u8=s_concat("gt rows ",s_itoa(ngt));vfail(m);fails=fails+1;}
    if(ngtf!=30){let m2:[]u8=s_concat("gtf rows ",s_itoa(ngtf));vfail(m2);fails=fails+1;}
    // every item id appears in GT
    let ap3:[]u8=path2(dir,"ANNOT.tsv");
    let at3:[]u8=f_read(ap3,1048576);
    z_free(ap3);
    if(at3.len>0){
        let aa3:[]u8=z_alloc(2*1024*4);
        let na3:i32=s_lines(at3,aa3,1024);
        let a4:i32=0;
        while(a4<na3){
            let ln4:[]u8=s_line(at3,aa3,1024,a4);
            let nf4:i32=s_fields(ln4,fa,16);
            if(nf4>=2){
                let aid:[]u8=s_field(ln4,fa,16,1);
                let fnd:i32=0;
                let k3:i32=0;
                while(k3<n){
                    let ln5:[]u8=s_line(t,ar,1024,k3);
                    let nf5:i32=s_fields(ln5,fa,16);
                    if(nf5==3 && s_eq(s_field(ln5,fa,16,0),"GT")==1){
                        if(s_eq(s_field(ln5,fa,16,1),aid)==1){fnd=1;}
                    }
                    k3=k3+1;
                }
                if(fnd==0){vfail(s_concat("item missing gt ",aid));fails=fails+1;}
            }
            a4=a4+1;
        }
        z_free(aa3);
    }
    z_free(at3);
    z_free(t);z_free(ar);z_free(fa);
    return fails;
}
fn check_annot(dir:[]u8, blob:[]u8, iar:[]u8, nid:i32, fails:i32)i32 {
    let p:[]u8=path2(dir,"ANNOT.tsv");
    let t:[]u8=f_read(p,1048576);
    z_free(p);
    if(t.len==0){vfail("empty/missing ANNOT.tsv");return fails+1;}
    let ar:[]u8=z_alloc(2*1024*4);
    let fa:[]u8=z_alloc(2*16*4);
    let n:i32=s_lines(t,ar,1024);
    if(n!=660){let m:[]u8=s_concat("annot rows ",s_itoa(n));vfail(m);fails=fails+1;}
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(t,ar,1024,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf!=4){vfail("annot fields!=4");fails=fails+1;}
        else {
            let id:[]u8=s_field(ln,fa,16,1);
            if(id_known(blob,iar,nid,id)==0){vfail(s_concat("annot id not in items ",id));fails=fails+1;}
        }
        k=k+1;
    }
    z_free(t);z_free(ar);z_free(fa);
    return fails;
}
fn main()i32 {
    let dir:[]u8=_zag_arg(1);
    if(dir.len==0){_zag_println("need dir");return 1;}
    let fails:i32=0;
    fails=check_items(dir,"CONF.tsv",150,"CATCH",fails);
    fails=check_items(dir,"GOLD.tsv",150,"KEEP",fails);
    fails=check_items(dir,"ALIBI.tsv",60,"CATCH",fails);
    fails=check_items(dir,"RECUR.tsv",60,"CATCH",fails);
    fails=check_items(dir,"SMUGGLE.tsv",100,"CATCH",fails);
    fails=check_items(dir,"UTYPE.tsv",60,"CATCH",fails);
    fails=check_items(dir,"CALIB.tsv",40,"CATCH",fails);
    fails=check_items(dir,"POINTER.tsv",40,"CATCH",fails);
    fails=check_pairs(dir,"pairs_sm.tsv",150,0,fails);
    fails=check_pairs(dir,"pairs_ss.tsv",150,1,fails);
    fails=check_pairs(dir,"pairs_flip.tsv",100,2,fails);
    fails=check_aval(dir,fails);
    fails=check_store(dir,fails);
    let blob:[]u8=z_alloc(16384);
    let iar:[]u8=z_alloc(1024*4);
    let nid:i32=load_item_ids(dir,blob,iar);
    if(nid!=660){let mx:[]u8=s_concat("item ids ",s_itoa(nid));vfail(mx);fails=fails+1;}
    fails=check_annot(dir,blob,iar,nid,fails);
    fails=check_trace(dir,blob,iar,nid,fails);
    fails=check_gt(dir,blob,iar,nid,fails);
    if(fails==0){_zag_println("VALIDATE_OK");}
    else {_zag_print("VALIDATE_FAILS=");_zag_println(s_itoa(fails));}
    return 0;
}

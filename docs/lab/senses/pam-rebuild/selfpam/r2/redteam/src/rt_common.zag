// rt_common.zag — minimal file/string/arena helpers for the H6-R2 red team.
// Pure Zag, zero RNG. Keeps every buffer under 2^25 bytes (znc slice limit).
// Conventions: []u8 byte strings; arenas are []u8 with LE u32 cells.

fn z_alloc(n:i32)[]u8 {
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}
fn z_cstr(s:[]u8)[]u8 {
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    return b;
}
// --- arena u32 cells (ZNC-007: no `as []i32` tables; LE bytes instead) ---
fn t_put32(ar:[]u8, i:i32, v:i32)void {
    let o:i32=i*4;
    ar[o]=(v & 255) as u8;
    ar[o+1]=((v>>8) & 255) as u8;
    ar[o+2]=((v>>16) & 255) as u8;
    ar[o+3]=((v>>24) & 255) as u8;
    return;
}
fn t_get32(ar:[]u8, i:i32)i32 {
    let o:i32=i*4;
    let b0:i32=ar[o] as i32;
    let b1:i32=ar[o+1] as i32;
    let b2:i32=ar[o+2] as i32;
    let b3:i32=ar[o+3] as i32;
    return b0+(b1*256)+(b2*65536)+(b3*16777216);
}
// --- growable byte buffer ---
fn buf_new(cap:i32)[]u8 { return z_alloc(cap); }
fn buf_cat(b:[]u8, at:i32, s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){b[at+i]=s[i];i=i+1;}
    return at+s.len;
}
fn buf_cati(b:[]u8, at:i32, v:i32)i32 {
    // signed itoa
    let neg:i32=0;
    let x:i32=v;
    if(x<0){neg=1;x=0-x;}
    if(x==0){b[at]=48;return at+1;}
    let tmp:[]u8=z_alloc(12);
    let n:i32=0;
    while(x>0){tmp[n]=(48+(x%10)) as u8;n=n+1;x=x/10;}
    let p:i32=at;
    if(neg==1){b[p]=45;p=p+1;}
    let j:i32=0;
    while(j<n){b[p+j]=tmp[n-1-j];j=j+1;}
    z_free(tmp);
    return p+n;
}
// --- file IO (plain syscalls; O_TRUNC never O_EXCL) ---
fn f_write(path:[]u8, data:[]u8)i64 {
    let p:[]u8=z_cstr(path);
    if(p.len==0){return -1;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(p) as i64,577,420,0,0,0);
    z_free(p);
    if(fd<0){return fd;}
    let at:i32=0;
    while(at<data.len){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+(at as i64),(data.len-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){_zag_raw_syscall(3,fd,0,0,0,0,0);return -1;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return at as i64;
}
fn f_read(path:[]u8, cap:i32)[]u8 {
    // returns exact-length content; "" on error (caller cannot tell empty
    // file from error — callers check byte counts separately)
    let p:[]u8=z_cstr(path);
    if(p.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(p) as i64,0,0,0,0,0);
    z_free(p);
    if(fd<0){return "";}
    let tmp:[]u8=z_alloc(cap);
    if(tmp.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(tmp) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    let out:[]u8=z_alloc(at+1);
    if(out.len==0){z_free(tmp);return "";}
    let i:i32=0;
    while(i<at){out[i]=tmp[i];i=i+1;}
    z_free(tmp);
    return out[0..at];
}
// --- string ops on []u8 ---
fn s_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn s_find(h:[]u8, n:[]u8)i32 {
    if(n.len==0 || n.len>h.len){return -1;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let j:i32=0;
        while(j<n.len){if(h[i+j]!=n[j]){break;}j=j+1;}
        if(j==n.len){return i;}
        i=i+1;
    }
    return -1;
}
fn s_concat(a:[]u8,b:[]u8)[]u8 {
    let o:[]u8=z_alloc(a.len+b.len+1);
    if(o.len==0){return o;}
    let at:i32=buf_cat(o,0,a);
    at=buf_cat(o,at,b);
    return o[0..at];
}
fn s_replace_first(s:[]u8, from:[]u8, to:[]u8)[]u8 {
    let at:i32=s_find(s,from);
    if(at<0){return s;}
    let o:[]u8=z_alloc(s.len+to.len+1);
    if(o.len==0){return o;}
    let p:i32=buf_cat(o,0,s[0..at]);
    p=buf_cat(o,p,to);
    p=buf_cat(o,p,s[at+from.len..s.len]);
    return o[0..p];
}
fn s_itoa(v:i32)[]u8 {
    let o:[]u8=z_alloc(12);
    if(o.len==0){return o;}
    let at:i32=buf_cati(o,0,v);
    return o[0..at];
}
// line offsets of s into arena ar (capacity cells); returns line count
fn s_lines(s:[]u8, ar:[]u8, cap:i32)i32 {
    let n:i32=0;
    let start:i32=0;
    let i:i32=0;
    while(i<s.len){
        if(s[i]==10){
            if(n<cap){t_put32(ar,n,start);t_put32(ar,cap+n,i-start);n=n+1;}
            start=i+1;
        }
        i=i+1;
    }
    if(start<s.len){
        if(n<cap){t_put32(ar,n,start);t_put32(ar,cap+n,s.len-start);n=n+1;}
    }
    return n;
}
fn s_line(s:[]u8, ar:[]u8, cap:i32, k:i32)[]u8 {
    let st:i32=t_get32(ar,k);
    let ln:i32=t_get32(ar,cap+k);
    return s[st..st+ln];
}
// split line into pipe fields; field offsets into arena (2*cap cells)
fn s_fields(line:[]u8, ar:[]u8, cap:i32)i32 {
    let n:i32=0;
    let start:i32=0;
    let i:i32=0;
    while(i<line.len){
        if(line[i]==124){
            if(n<cap){t_put32(ar,n,start);t_put32(ar,cap+n,i-start);n=n+1;}
            start=i+1;
        }
        i=i+1;
    }
    if(n<cap){t_put32(ar,n,start);t_put32(ar,cap+n,line.len-start);n=n+1;}
    return n;
}
fn s_field(line:[]u8, ar:[]u8, cap:i32, k:i32)[]u8 {
    let st:i32=t_get32(ar,k);
    let ln:i32=t_get32(ar,cap+k);
    return line[st..st+ln];
}
// FNV-1a 32 over bytes, returned as 8-hex-char string (h kept in [0,2^32))
fn s_fnv_hex(s:[]u8)[]u8 {
    let h:i64=2166136261;
    let i:i32=0;
    while(i<s.len){
        h=((h ^ (s[i] as i64))*16777619) & 4294967295;
        i=i+1;
    }
    let o:[]u8=z_alloc(9);
    if(o.len==0){return o;}
    let k:i32=7;
    while(k>=0){
        let d:i64=h & 15;
        let c:u8=0;
        if(d<10){c=(48+d) as u8;}else{c=(87+d) as u8;}
        o[k]=c;
        h=h/16;
        k=k-1;
    }
    return o[0..8];
}
fn s_starts(line:[]u8, pre:[]u8)i32 {
    if(line.len<pre.len){return 0;}
    let i:i32=0;
    while(i<pre.len){if(line[i]!=pre[i]){return 0;}i=i+1;}
    return 1;
}

@import("rt_common.zag")
// gen_trace: deterministic trace + ground-truth generator (pure Zag, zero RNG).
// argv1 = battery dir with STORE.tsv FAB.tsv ANNOT.tsv and the 8 ITEM files.
// Emits TRACE.tsv and GT.tsv into the dir.
// Uses only the rt_common API (s_lines/s_fields/s_field, f_read/f_write).

fn zc(s:[]u8)[]u8 {
    // owned copy WITHOUT the trailing NUL that z_cstr keeps
    let b:[]u8=z_cstr(s);
    if(b.len==0){return b;}
    return b[0..s.len];
}
fn path2(dir:[]u8, name:[]u8)[]u8 {
    let p:[]u8=z_alloc(dir.len+name.len+2);
    let at:i32=buf_cat(p,0,dir);
    at=buf_cat(p,at,"/");
    at=buf_cat(p,at,name);
    return p[0..at];
}
// lookup valcol where keycol==key in a pipe file; "" if absent
fn lookup(path:[]u8, keycol:i32, key:[]u8, valcol:i32)[]u8 {
    let t:[]u8=f_read(path, 1048576);
    if(t.len==0){return "";}
    let ar:[]u8=z_alloc(2*1024*4);
    let fa:[]u8=z_alloc(2*16*4);
    let n:i32=s_lines(t,ar,1024);
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(t,ar,1024,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf>keycol && nf>valcol){
            if(s_eq(s_field(ln,fa,16,keycol),key)==1){
                let v:[]u8=zc(s_field(ln,fa,16,valcol));
                z_free(t);z_free(ar);z_free(fa);
                return v;
            }
        }
        k=k+1;
    }
    z_free(t);z_free(ar);z_free(fa);
    return "";
}
fn store_of(dir:[]u8, eid:[]u8)[]u8 {
    let p:[]u8=path2(dir,"STORE.tsv");
    let r:[]u8=lookup(p,1,eid,2);
    z_free(p);
    return r;
}
fn fab_of(dir:[]u8, id:[]u8)[]u8 {
    let p:[]u8=path2(dir,"FAB.tsv");
    let r:[]u8=lookup(p,1,id,2);
    z_free(p);
    return r;
}
fn emit_line(out:[]u8, at:i32, id:[]u8, step:i32, op:[]u8, pf:[]u8, q:[]u8)i32 {
    at=buf_cat(out,at,"TRACE|");
    at=buf_cat(out,at,id);at=buf_cat(out,at,"|");
    at=buf_cati(out,at,step);at=buf_cat(out,at,"|");
    at=buf_cat(out,at,op);at=buf_cat(out,at,"|");
    at=buf_cat(out,at,pf);at=buf_cat(out,at,"|");
    at=buf_cat(out,at,q);at=buf_cat(out,at,"\n");
    return at;
}
fn corp_of(id:[]u8)[]u8 {
    if(s_starts(id,"CF-")==1){return "CONF";}
    if(s_starts(id,"GD-")==1){return "GOLD";}
    if(s_starts(id,"AB-")==1){return "ALIBI";}
    if(s_starts(id,"RC-")==1){return "RECUR";}
    if(s_starts(id,"SM-")==1){return "SMUGGLE";}
    if(s_starts(id,"UT-")==1){return "UTYPE";}
    if(s_starts(id,"CB-")==1){return "CALIB";}
    return "POINTER";
}
fn count_parts(ptr:[]u8)i32 {
    let c:i32=1;
    let i:i32=0;
    while(i<ptr.len){if(ptr[i]==43){c=c+1;}i=i+1;}
    return c;
}
// emit one recall per '+'-separated ptr part; src 0=store, 1=fab-or-dash
fn emit_recalls(out:[]u8, at:i32, dir:[]u8, id:[]u8, ptr:[]u8, src:i32) i32 {
    let step:i32=1;
    let pos:i32=0;
    let tmp:[]u8=z_alloc(64);
    while(1==1){
        let pl:i32=-1;
        let j:i32=pos;
        while(j<ptr.len){
            if(ptr[j]==43){pl=j;break;}
            j=j+1;
        }
        let el:i32=0;
        if(pl<0){el=ptr.len-pos;}else{el=pl-pos;}
        let p2:i32=0;
        while(p2<el){tmp[p2]=ptr[pos+p2];p2=p2+1;}
        let one:[]u8=tmp[0..el];
        let q:[]u8=zc("-");
        if(src==0){z_free(q);q=store_of(dir,one);}else{z_free(q);q=fab_of(dir,id);}
        if(q.len==0){z_free(q);q=zc("-");}
        at=emit_line(out,at,id,step,"recall",one,q);
        z_free(q);
        step=step+1;
        if(pl<0){break;}
        pos=pl+1;
    }
    z_free(tmp);
    return at;
}

fn main()i32 {
    let dir:[]u8=_zag_arg(1);
    if(dir.len==0){return 1;}
    let ap:[]u8=path2(dir,"ANNOT.tsv");
    let atxt:[]u8=f_read(ap,1048576);
    z_free(ap);
    if(atxt.len==0){return 1;}
    let ar:[]u8=z_alloc(2*1024*4);
    let fa:[]u8=z_alloc(2*16*4);
    let n:i32=s_lines(atxt,ar,1024);
    let out:[]u8=z_alloc(1048576);
    let at:i32=0;
    let gt:[]u8=z_alloc(65536);
    let gat:i32=0;
    let cfname:[]u8=z_alloc(64);
    let k:i32=0;
    while(k<n){
        let ln:[]u8=s_line(atxt,ar,1024,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf>=4){
            let id:[]u8=s_field(ln,fa,16,1);
            let ptr:[]u8=s_field(ln,fa,16,2);
            let rule:[]u8=s_field(ln,fa,16,3);
            let corp:[]u8=corp_of(id);
            let cl:i32=buf_cat(cfname,0,corp);
            cl=buf_cat(cfname,cl,".tsv");
            let cfp:[]u8=path2(dir,cfname[0..cl]);
            let draft:[]u8=lookup(cfp,2,id,3);
            let gtv:[]u8=lookup(cfp,2,id,4);
            z_free(cfp);
            if(draft.len==0){
                at=buf_cat(out,at,"MISSING_DRAFT|");at=buf_cat(out,at,id);at=buf_cat(out,at,"\n");
            } else {
                let is_ung:i32=s_eq(ptr,"-");
                if(s_eq(corp,"CONF")==1 && is_ung==1){
                    at=emit_line(out,at,id,1,"assume","-","free association: no store evidence");
                    at=emit_line(out,at,id,2,"conclude",rule,draft);
                } else if(s_eq(corp,"ALIBI")==1){
                    at=emit_recalls(out,at,dir,id,ptr,1);
                    at=emit_line(out,at,id,2,"infer","-","rule=direct-quote");
                    at=emit_line(out,at,id,3,"conclude",rule,draft);
                } else if(s_eq(corp,"POINTER")==1){
                    at=emit_recalls(out,at,dir,id,ptr,1);
                    at=emit_line(out,at,id,2,"conclude",rule,draft);
                } else if(s_eq(corp,"UTYPE")==1){
                    at=emit_line(out,at,id,1,"conclude",rule,draft);
                } else {
                    at=emit_recalls(out,at,dir,id,ptr,0);
                    let st:i32=count_parts(ptr)+1;
                    at=emit_line(out,at,id,st,"conclude",rule,draft);
                }
                gat=buf_cat(gt,gat,"GT|");gat=buf_cat(gt,gat,id);
                gat=buf_cat(gt,gat,"|");gat=buf_cat(gt,gat,gtv);gat=buf_cat(gt,gat,"\n");
            }
            z_free(draft);z_free(gtv);
        }
        k=k+1;
    }
    let i2:i32=1;
    while(i2<=45){
        gat=buf_cat(gt,gat,"GTF|A-");
        if(i2<10){gat=buf_cat(gt,gat,"00");}else{gat=buf_cat(gt,gat,"0");}
        gat=buf_cati(gt,gat,i2);gat=buf_cat(gt,gat,"|");
        if(i2<=30){gat=buf_cat(gt,gat,"STABLEF");}else{gat=buf_cat(gt,gat,"CATCHF");}
        gat=buf_cat(gt,gat,"\n");
        i2=i2+1;
    }
    let tp:[]u8=path2(dir,"TRACE.tsv");
    let tz:[]u8=z_cstr(tp);
    f_write(tz,out[0..at]);
    z_free(tp);z_free(tz);
    let gp:[]u8=path2(dir,"GT.tsv");
    let gz:[]u8=z_cstr(gp);
    f_write(gz,gt[0..gat]);
    z_free(gp);z_free(gz);
    _zag_print("items=");_zag_print(s_itoa(n));
    _zag_print(" trace_bytes=");_zag_print(s_itoa(at));
    _zag_print(" gt_bytes=");_zag_println(s_itoa(gat));
    return 0;
    return 0;
}

@import("rt_common.zag")
// build_para.zag — deterministic adversarial paraphrase battery builder.
// Pure Zag, zero RNG. Reads bases.tsv + rules.tsv, writes pairs_sm.tsv,
// pairs_ss.tsv, pairs_flip.tsv, aval.tsv. Every pair carries its rule id.
// Usage: build_para <dir>   (dir holds inputs; outputs written to dir)
//
// Base format:  BASE|<id>|<tmpl>|<slot1>|<slot2>|...
//   T1: S|Vpast|Vbase|PREP|O        "The S Vpast PREP the O."
//   T2: S|Vpast|Vbase|Vpp|O         "The S Vpast the O."
//   T3: S|ADJ                      "The S is ADJ."
//   T4: Q|Spl|Vpast                 "Q of the Spl Vpast."
//   T5: S|Vpast|Vbase|PREP|O        (only-flip)
//   T6: Spl|ADJ                     (neg-scope flip)
//   T7: Sg|Vpast|Vpp|Osing          (quantifier-scope flip)
//   TX1/TX2/TX3: same slots as T1/T2/T3 (confab content, avalanche only)
// Rules format: RULE|<type>|<from>|<to>   (SYN/ANT/ENT/NUM/QSWAP/DIGIT)

fn cap1(s:[]u8)[]u8 {
    if(s.len==0){return s;}
    let o:[]u8=z_alloc(s.len+1);
    if(o.len==0){return o;}
    let i:i32=0;
    while(i<s.len){o[i]=s[i];i=i+1;}
    let c:u8=o[0];
    if(c>=97 && c<=122){o[0]=c-32;}
    return o[0..s.len];
}
fn pad3(v:i32)[]u8 {
    let o:[]u8=z_alloc(4);
    if(o.len==0){return o;}
    o[0]=(48+(v/100)) as u8;
    o[1]=(48+((v/10)%10)) as u8;
    o[2]=(48+(v%10)) as u8;
    return o[0..3];
}
// rule lookup: nth 'to' for (type,from); "" if none
fn rl(rules:[]u8, rla:[]u8, rcap:i32, rn:i32, typ:[]u8, from:[]u8, nth:i32)[]u8 {
    let fa:[]u8=z_alloc(16*4*2);
    let seen:i32=0;
    let k:i32=0;
    while(k<rn){
        let ln:[]u8=s_line(rules,rla,rcap,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf>=4){
            if(s_eq(s_field(ln,fa,16,1),typ)==1){
                if(s_eq(s_field(ln,fa,16,2),from)==1){
                    if(seen==nth){
                        let out:[]u8=s_field(ln,fa,16,3);
                        z_free(fa);
                        return out;
                    }
                    seen=seen+1;
                }
            }
        }
        k=k+1;
    }
    z_free(fa);
    return "";
}
// --- sentence emitters ---
fn e_t1(s:[]u8,vp:[]u8,p:[]u8,o:[]u8)[]u8 {
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,"The ");at=buf_cat(b,at,s);at=buf_cat(b,at," ");
    at=buf_cat(b,at,vp);at=buf_cat(b,at," ");at=buf_cat(b,at,p);
    at=buf_cat(b,at," the ");at=buf_cat(b,at,o);at=buf_cat(b,at,".");
    return b[0..at];
}
fn e_t2(s:[]u8,vp:[]u8,o:[]u8)[]u8 {
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,"The ");at=buf_cat(b,at,s);at=buf_cat(b,at," ");
    at=buf_cat(b,at,vp);at=buf_cat(b,at," the ");at=buf_cat(b,at,o);at=buf_cat(b,at,".");
    return b[0..at];
}
fn e_t3(s:[]u8,adj:[]u8)[]u8 {
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,"The ");at=buf_cat(b,at,s);at=buf_cat(b,at," is ");
    at=buf_cat(b,at,adj);at=buf_cat(b,at,".");
    return b[0..at];
}
fn e_t4(q:[]u8,spl:[]u8,vp:[]u8)[]u8 {
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,q);at=buf_cat(b,at," of the ");at=buf_cat(b,at,spl);
    at=buf_cat(b,at," ");at=buf_cat(b,at,vp);at=buf_cat(b,at,".");
    return b[0..at];
}
// --- rule applications: each VERIFIES A's shape, then derives B; "" on mismatch ---
fn r_syn(a:[]u8,rules:[]u8,rla:[]u8,rcap:i32,rn:i32,w:[]u8)[]u8 {
    // toggle: w->syn or syn->w, whichever is present
    let syn:[]u8=rl(rules,rla,rcap,rn,"SYN",w,0);
    if(syn.len==0){return "";}
    if(s_find(a,w)>=0){return s_replace_first(a,w,syn);}
    let back:[]u8=rl(rules,rla,rcap,rn,"SYN",syn,0);
    if(back.len>0){if(s_find(a,syn)>=0){return s_replace_first(a,syn,back);}}
    return "";
}
fn r_reord(a:[]u8,s:[]u8,vp:[]u8,p:[]u8,o:[]u8)[]u8 {
    let exp:[]u8=e_t1(s,vp,p,o);
    if(s_eq(a,exp)!=1){return "";}
    let b:[]u8=z_alloc(256);let at:i32=0;
    let pc:[]u8=cap1(p);
    at=buf_cat(b,at,pc);at=buf_cat(b,at," the ");at=buf_cat(b,at,o);
    at=buf_cat(b,at," ");at=buf_cat(b,at,vp);at=buf_cat(b,at," the ");
    at=buf_cat(b,at,s);at=buf_cat(b,at,".");
    return b[0..at];
}
fn r_pass(a:[]u8,s:[]u8,vp:[]u8,vpp:[]u8,o:[]u8)[]u8 {
    let exp:[]u8=e_t2(s,vp,o);
    if(s_eq(a,exp)!=1){return "";}
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,"The ");at=buf_cat(b,at,o);at=buf_cat(b,at," was ");
    at=buf_cat(b,at,vpp);at=buf_cat(b,at," by the ");at=buf_cat(b,at,s);at=buf_cat(b,at,".");
    return b[0..at];
}
fn r_antneg(a:[]u8,rules:[]u8,rla:[]u8,rcap:i32,rn:i32,s:[]u8,adj:[]u8)[]u8 {
    // toggle between "is ADJ" and "is not ANT(ADJ)"
    let pat:[]u8=s_concat(" is not ",adj);
    if(s_find(a,pat)>=0){
        let back:[]u8=rl(rules,rla,rcap,rn,"ANT",adj,0);
        if(back.len==0){return "";}
        return s_replace_first(a,pat,s_concat(" is ",back));
    }
    let exp:[]u8=e_t3(s,adj);
    if(s_eq(a,exp)!=1){return "";}
    let an:[]u8=rl(rules,rla,rcap,rn,"ANT",adj,0);
    if(an.len==0){return "";}
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,"The ");at=buf_cat(b,at,s);at=buf_cat(b,at," is not ");
    at=buf_cat(b,at,an);at=buf_cat(b,at,".");
    return b[0..at];
}
fn r_num(a:[]u8,rules:[]u8,rla:[]u8,rcap:i32,rn:i32,q:[]u8,spl:[]u8,vp:[]u8,nth:i32)[]u8 {
    let exp:[]u8=e_t4(q,spl,vp);
    if(s_eq(a,exp)!=1){return "";}
    let nv:[]u8=rl(rules,rla,rcap,rn,"NUM",q,nth);
    if(nv.len==0){return "";}
    return e_t4(nv,spl,vp);
}
fn e_ant(a:[]u8,rules:[]u8,rla:[]u8,rcap:i32,rn:i32,slot:[]u8)[]u8 {
    let an:[]u8=rl(rules,rla,rcap,rn,"ANT",slot,0);
    if(an.len==0){return "";}
    if(s_find(a,slot)<0){return "";}
    return s_replace_first(a,slot,an);
}
fn e_ent(a:[]u8,rules:[]u8,rla:[]u8,rcap:i32,rn:i32,slot:[]u8)[]u8 {
    let sw:[]u8=rl(rules,rla,rcap,rn,"ENT",slot,0);
    if(sw.len==0){return "";}
    if(s_find(a,slot)<0){return "";}
    return s_replace_first(a,slot,sw);
}
fn e_neg_t1(a:[]u8,s:[]u8,vp:[]u8,vb:[]u8,p:[]u8,o:[]u8)[]u8 {
    let exp:[]u8=e_t1(s,vp,p,o);
    if(s_eq(a,exp)!=1){return "";}
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,"The ");at=buf_cat(b,at,s);at=buf_cat(b,at," did not ");
    at=buf_cat(b,at,vb);at=buf_cat(b,at," ");at=buf_cat(b,at,p);
    at=buf_cat(b,at," the ");at=buf_cat(b,at,o);at=buf_cat(b,at,".");
    return b[0..at];
}
fn e_neg_t2(a:[]u8,s:[]u8,vp:[]u8,vb:[]u8,o:[]u8)[]u8 {
    let exp:[]u8=e_t2(s,vp,o);
    if(s_eq(a,exp)!=1){return "";}
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,"The ");at=buf_cat(b,at,s);at=buf_cat(b,at," did not ");
    at=buf_cat(b,at,vb);at=buf_cat(b,at," the ");at=buf_cat(b,at,o);at=buf_cat(b,at,".");
    return b[0..at];
}
fn e_neg_t3(a:[]u8,s:[]u8,adj:[]u8)[]u8 {
    let exp:[]u8=e_t3(s,adj);
    if(s_eq(a,exp)!=1){return "";}
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,"The ");at=buf_cat(b,at,s);at=buf_cat(b,at," is not ");
    at=buf_cat(b,at,adj);at=buf_cat(b,at,".");
    return b[0..at];
}
fn e_tense(a:[]u8,s:[]u8,vp:[]u8,vb:[]u8,p:[]u8,o:[]u8,t2:i32)[]u8 {
    let exp:[]u8=e_t1(s,vp,p,o);
    if(t2==1){exp=e_t2(s,vp,o);}
    if(s_eq(a,exp)!=1){return "";}
    let b:[]u8=z_alloc(256);let at:i32=0;
    at=buf_cat(b,at,"The ");at=buf_cat(b,at,s);at=buf_cat(b,at," will ");
    at=buf_cat(b,at,vb);
    if(t2==0){at=buf_cat(b,at," ");at=buf_cat(b,at,p);}
    at=buf_cat(b,at," the ");at=buf_cat(b,at,o);at=buf_cat(b,at,".");
    return b[0..at];
}
fn e_quant(a:[]u8,rules:[]u8,rla:[]u8,rcap:i32,rn:i32,q:[]u8,spl:[]u8,vp:[]u8)[]u8 {
    let exp:[]u8=e_t4(q,spl,vp);
    if(s_eq(a,exp)!=1){return "";}
    let nq:[]u8=rl(rules,rla,rcap,rn,"QSWAP",q,0);
    if(nq.len==0){return "";}
    return e_t4(nq,spl,vp);
}
fn e_digit(a:[]u8,rules:[]u8,rla:[]u8,rcap:i32,rn:i32,q:[]u8,spl:[]u8,vp:[]u8)[]u8 {
    // perturb the V1 numeric form of Q
    let v1:[]u8=rl(rules,rla,rcap,rn,"NUM",q,0);
    if(v1.len==0){return "";}
    let exp:[]u8=e_t4(v1,spl,vp);
    if(s_eq(a,exp)!=1){return "";}
    let d2:[]u8=rl(rules,rla,rcap,rn,"DIGIT",v1,0);
    if(d2.len==0){return "";}
    return s_replace_first(a,v1,d2);
}
// FLIP emitters (shape-verified like the rest)
fn f_negscope(spl:[]u8,adj:[]u8,side:i32)[]u8 {
    let b:[]u8=z_alloc(256);let at:i32=0;
    if(side==0){at=buf_cat(b,at,"All ");}
    else{at=buf_cat(b,at,"Not all ");}
    at=buf_cat(b,at,spl);at=buf_cat(b,at," are ");
    if(side==0){at=buf_cat(b,at,"not ");}
    at=buf_cat(b,at,adj);at=buf_cat(b,at,".");
    return b[0..at];
}
fn f_only(s:[]u8,vp:[]u8,p:[]u8,o:[]u8,side:i32)[]u8 {
    let b:[]u8=z_alloc(256);let at:i32=0;
    if(side==0){at=buf_cat(b,at,"Only the ");}
    else{at=buf_cat(b,at,"The ");}
    at=buf_cat(b,at,s);at=buf_cat(b,at," ");
    at=buf_cat(b,at,vp);at=buf_cat(b,at," ");
    if(side==1){at=buf_cat(b,at,"only ");}
    at=buf_cat(b,at,p);at=buf_cat(b,at," the ");at=buf_cat(b,at,o);at=buf_cat(b,at,".");
    return b[0..at];
}
fn f_qscope(sg:[]u8,vp:[]u8,vpp:[]u8,os:[]u8,side:i32)[]u8 {
    let b:[]u8=z_alloc(256);let at:i32=0;
    if(side==0){
        at=buf_cat(b,at,"Every ");at=buf_cat(b,at,sg);at=buf_cat(b,at," ");
        at=buf_cat(b,at,vp);at=buf_cat(b,at," a ");at=buf_cat(b,at,os);at=buf_cat(b,at,".");
    }else{
        at=buf_cat(b,at,"A ");at=buf_cat(b,at,os);at=buf_cat(b,at," was ");
        at=buf_cat(b,at,vpp);at=buf_cat(b,at," by every ");at=buf_cat(b,at,sg);at=buf_cat(b,at,".");
    }
    return b[0..at];
}
fn pair_line(out:[]u8, at:i32, set:[]u8, id:[]u8, rule:[]u8, sa:[]u8, sb:[]u8, gt:[]u8)i32 {
    at=buf_cat(out,at,"PAIR|");at=buf_cat(out,at,set);at=buf_cat(out,at,"|");
    at=buf_cat(out,at,id);at=buf_cat(out,at,"|");at=buf_cat(out,at,rule);
    at=buf_cat(out,at,"|");at=buf_cat(out,at,sa);at=buf_cat(out,at,"|");
    at=buf_cat(out,at,sb);at=buf_cat(out,at,"|");at=buf_cat(out,at,gt);
    at=buf_cat(out,at,"\n");
    return at;
}
fn die(msg:[]u8)i32 {
    _zag_print("BUILDER_ABORT: ");_zag_println(msg);
    return 99;
}
fn main()i32 {
    let dir:[]u8=_zag_arg(1);
    if(dir.len==0){return die("need dir arg");}
    let rp:[]u8=s_concat(dir,"/rules.tsv");
    let bp:[]u8=s_concat(dir,"/bases.tsv");
    let rules:[]u8=f_read(rp,200000);
    let bases:[]u8=f_read(bp,200000);
    if(rules.len==0 || bases.len==0){return die("empty inputs");}
    let rla:[]u8=z_alloc(512*4*2);
    let rn:i32=s_lines(rules,rla,512);
    let bla:[]u8=z_alloc(512*4*2);
    let bn:i32=s_lines(bases,bla,512);
    let fa:[]u8=z_alloc(16*4*2);
    let sm:[]u8=z_alloc(400000);let sm_at:i32=0;
    let ss:[]u8=z_alloc(400000);let ss_at:i32=0;
    let fl:[]u8=z_alloc(300000);let fl_at:i32=0;
    let av:[]u8=z_alloc(200000);let av_at:i32=0;
    let n_sm:i32=0;let n_ss:i32=0;let n_fl:i32=0;
    let c_t1:i32=0;let c_t2:i32=0;let c_t3:i32=0;let c_t4:i32=0;
    let avc:i32=0;
    let k:i32=0;
    while(k<bn){
        let ln:[]u8=s_line(bases,bla,512,k);
        let nf:i32=s_fields(ln,fa,16);
        if(nf<3){k=k+1;continue;}
        let bid:[]u8=s_field(ln,fa,16,1);
        let tm:[]u8=s_field(ln,fa,16,2);
        if(s_eq(tm,"T1")==1){
            let s:[]u8=s_field(ln,fa,16,3);
            let vp:[]u8=s_field(ln,fa,16,4);
            let vb:[]u8=s_field(ln,fa,16,5);
            let p:[]u8=s_field(ln,fa,16,6);
            let o:[]u8=s_field(ln,fa,16,7);
            let a0:[]u8=e_t1(s,vp,p,o);
            c_t1=c_t1+1;
            if(c_t1<=16){
                // SM: R_SYN_S, R_SYN_V, R_SYN_O, R_REORD
                let b1:[]u8=r_syn(a0,rules,rla,512,rn,s);
                let b2:[]u8=r_syn(a0,rules,rla,512,rn,vp);
                let b3:[]u8=r_syn(a0,rules,rla,512,rn,o);
                let b4:[]u8=r_reord(a0,s,vp,p,o);
                if(b1.len==0||b2.len==0||b3.len==0||b4.len==0){return die(bid);}
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_SYN_S",a0,b1,"STABLE");
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_SYN_V",a0,b2,"STABLE");
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_SYN_O",a0,b3,"STABLE");
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_REORD",a0,b4,"STABLE");
            }
            if(c_t1<=20){
                // SS: E_ANT_PREP, E_ENT_S, E_NEG
                let d1:[]u8=e_ant(a0,rules,rla,512,rn,p);
                let d2:[]u8=e_ent(a0,rules,rla,512,rn,s);
                let d3:[]u8=e_neg_t1(a0,s,vp,vb,p,o);
                if(d1.len==0||d2.len==0||d3.len==0){return die(bid);}
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_ANT_PREP",a0,d1,"DIVERGE");
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_ENT_S",a0,d2,"DIVERGE");
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_NEG",a0,d3,"DIVERGE");
            }
            if(avc<10){
                // avalanche chain: toggle SYN_S, SYN_O, SYN_V twice
                avc=avc+1;
                let step:[]u8=a0;
                av_at=buf_cat(av,av_at,"AVAL|");
                av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|0|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,s);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|1|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,o);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|2|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,vp);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|3|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,s);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|4|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,o);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|5|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,vp);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|6|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                if(step.len==0){return die(bid);}
            }
        }
        if(s_eq(tm,"T2")==1){
            let s:[]u8=s_field(ln,fa,16,3);
            let vp:[]u8=s_field(ln,fa,16,4);
            let vb:[]u8=s_field(ln,fa,16,5);
            let vpp:[]u8=s_field(ln,fa,16,6);
            let o:[]u8=s_field(ln,fa,16,7);
            let a0:[]u8=e_t2(s,vp,o);
            c_t2=c_t2+1;
            if(c_t2<=12){
                let b1:[]u8=r_syn(a0,rules,rla,512,rn,s);
                let b2:[]u8=r_syn(a0,rules,rla,512,rn,vp);
                let b3:[]u8=r_syn(a0,rules,rla,512,rn,o);
                let b4:[]u8=r_pass(a0,s,vp,vpp,o);
                if(b1.len==0||b2.len==0||b3.len==0||b4.len==0){return die(bid);}
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_SYN_S",a0,b1,"STABLE");
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_SYN_V",a0,b2,"STABLE");
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_SYN_O",a0,b3,"STABLE");
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_PASS",a0,b4,"STABLE");
            }
            if(c_t2<=16){
                let d1:[]u8=e_ent(a0,rules,rla,512,rn,o);
                let d2:[]u8=e_neg_t2(a0,s,vp,vb,o);
                let d3:[]u8=e_tense(a0,s,vp,vb,"",o,1);
                if(d1.len==0||d2.len==0||d3.len==0){return die(bid);}
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_ENT_O",a0,d1,"DIVERGE");
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_NEG",a0,d2,"DIVERGE");
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_TENSE",a0,d3,"DIVERGE");
            }
            if(avc<20){
                avc=avc+1;
                let step:[]u8=a0;
                av_at=buf_cat(av,av_at,"AVAL|");
                av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|0|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,s);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|1|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,o);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|2|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,vp);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|3|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,s);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|4|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,o);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|5|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                step=r_syn(step,rules,rla,512,rn,vp);
                av_at=buf_cat(av,av_at,"AVAL|");av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                av_at=buf_cat(av,av_at,"|6|");av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                if(step.len==0){return die(bid);}
            }
        }
        if(s_eq(tm,"T3")==1){
            let s:[]u8=s_field(ln,fa,16,3);
            let adj:[]u8=s_field(ln,fa,16,4);
            let a0:[]u8=e_t3(s,adj);
            c_t3=c_t3+1;
            if(c_t3<=10){
                let b1:[]u8=r_syn(a0,rules,rla,512,rn,s);
                let b2:[]u8=r_syn(a0,rules,rla,512,rn,adj);
                let b3:[]u8=r_antneg(a0,rules,rla,512,rn,s,adj);
                if(b1.len==0||b2.len==0||b3.len==0){return die(bid);}
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_SYN_S",a0,b1,"STABLE");
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_SYN_ADJ",a0,b2,"STABLE");
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_ANTNEG",a0,b3,"STABLE");
            }
            if(c_t3<=12){
                let d1:[]u8=e_ant(a0,rules,rla,512,rn,adj);
                let d2:[]u8=e_neg_t3(a0,s,adj);
                if(d1.len==0||d2.len==0){return die(bid);}
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_ANT_ADJ",a0,d1,"DIVERGE");
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_NEG",a0,d2,"DIVERGE");
            }
            if(avc<30){
                avc=avc+1;
                let step:[]u8=a0;
                let st:i32=0;
                while(st<7){
                    av_at=buf_cat(av,av_at,"AVAL|");
                    av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                    av_at=buf_cat(av,av_at,"|");av_at=buf_cati(av,av_at,st);av_at=buf_cat(av,av_at,"|");
                    av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                    if(st==0||st==2||st==4){step=r_syn(step,rules,rla,512,rn,s);}
                    if(st==1||st==3||st==5){step=r_syn(step,rules,rla,512,rn,adj);}
                    if(step.len==0){return die(bid);}
                    st=st+1;
                }
            }
        }
        if(s_eq(tm,"T4")==1){
            let q:[]u8=s_field(ln,fa,16,3);
            let spl:[]u8=s_field(ln,fa,16,4);
            let vp:[]u8=s_field(ln,fa,16,5);
            let a0:[]u8=e_t4(q,spl,vp);
            c_t4=c_t4+1;
            if(c_t4<=4){
                let b1:[]u8=r_num(a0,rules,rla,512,rn,q,spl,vp,0);
                let b2:[]u8=r_num(a0,rules,rla,512,rn,q,spl,vp,1);
                if(b1.len==0||b2.len==0){return die(bid);}
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_NUM",a0,b1,"STABLE");
                n_sm=n_sm+1;sm_at=pair_line(sm,sm_at,"SM",s_concat("P-SM-",pad3(n_sm)),"R_NUM",a0,b2,"STABLE");
            }
            if(c_t4<=9){
                let d1:[]u8=e_quant(a0,rules,rla,512,rn,q,spl,vp);
                if(d1.len==0){return die(bid);}
                // E_DIGIT applies to the V1 numeric form
                let v1:[]u8=rl(rules,rla,512,rn,"NUM",q,0);
                let a1:[]u8=e_t4(v1,spl,vp);
                let d2:[]u8=e_digit(a1,rules,rla,512,rn,q,spl,vp);
                if(d2.len==0){return die(bid);}
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_QUANT",a0,d1,"DIVERGE");
                n_ss=n_ss+1;ss_at=pair_line(ss,ss_at,"SS",s_concat("P-SS-",pad3(n_ss)),"E_DIGIT",a1,d2,"DIVERGE");
            }
        }
        if(s_eq(tm,"T5")==1){
            let s:[]u8=s_field(ln,fa,16,3);
            let vp:[]u8=s_field(ln,fa,16,4);
            let vb:[]u8=s_field(ln,fa,16,5);
            let p:[]u8=s_field(ln,fa,16,6);
            let o:[]u8=s_field(ln,fa,16,7);
            let fa_:[]u8=f_only(s,vp,p,o,0);
            let fb:[]u8=f_only(s,vp,p,o,1);
            n_fl=n_fl+1;fl_at=pair_line(fl,fl_at,"FLIP",s_concat("P-FL-",pad3(n_fl)),"F_ONLY",fa_,fb,"DIVERGE");
        }
        if(s_eq(tm,"T6")==1){
            let spl:[]u8=s_field(ln,fa,16,3);
            let adj:[]u8=s_field(ln,fa,16,4);
            let fa_:[]u8=f_negscope(spl,adj,0);
            let fb:[]u8=f_negscope(spl,adj,1);
            n_fl=n_fl+1;fl_at=pair_line(fl,fl_at,"FLIP",s_concat("P-FL-",pad3(n_fl)),"F_NEGSCOPE",fa_,fb,"DIVERGE");
        }
        if(s_eq(tm,"T7")==1){
            let sg:[]u8=s_field(ln,fa,16,3);
            let vp:[]u8=s_field(ln,fa,16,4);
            let vpp:[]u8=s_field(ln,fa,16,5);
            let os:[]u8=s_field(ln,fa,16,6);
            let fa_:[]u8=f_qscope(sg,vp,vpp,os,0);
            let fb:[]u8=f_qscope(sg,vp,vpp,os,1);
            n_fl=n_fl+1;fl_at=pair_line(fl,fl_at,"FLIP",s_concat("P-FL-",pad3(n_fl)),"F_QSCOPE",fa_,fb,"DIVERGE");
        }
        if(s_eq(tm,"TX1")==1){
            let s:[]u8=s_field(ln,fa,16,3);
            let vp:[]u8=s_field(ln,fa,16,4);
            let vb:[]u8=s_field(ln,fa,16,5);
            let p:[]u8=s_field(ln,fa,16,6);
            let o:[]u8=s_field(ln,fa,16,7);
            let a0:[]u8=e_t1(s,vp,p,o);
            if(avc<35){
                avc=avc+1;
                let step:[]u8=a0;
                let st:i32=0;
                while(st<7){
                    av_at=buf_cat(av,av_at,"AVAL|");
                    av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                    av_at=buf_cat(av,av_at,"|");av_at=buf_cati(av,av_at,st);av_at=buf_cat(av,av_at,"|");
                    av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                    if(st==0){step=r_syn(step,rules,rla,512,rn,s);}
                    if(st==1){step=r_syn(step,rules,rla,512,rn,o);}
                    if(st==2){step=r_syn(step,rules,rla,512,rn,vp);}
                    if(st==3){step=r_syn(step,rules,rla,512,rn,s);}
                    if(st==4){step=r_syn(step,rules,rla,512,rn,o);}
                    if(st==5){step=r_syn(step,rules,rla,512,rn,vp);}
                    if(step.len==0){return die(bid);}
                    st=st+1;
                }
            }
        }
        if(s_eq(tm,"TX2")==1){
            let s:[]u8=s_field(ln,fa,16,3);
            let vp:[]u8=s_field(ln,fa,16,4);
            let vb:[]u8=s_field(ln,fa,16,5);
            let vpp:[]u8=s_field(ln,fa,16,6);
            let o:[]u8=s_field(ln,fa,16,7);
            let a0:[]u8=e_t2(s,vp,o);
            if(avc<40){
                avc=avc+1;
                let step:[]u8=a0;
                let st:i32=0;
                while(st<7){
                    av_at=buf_cat(av,av_at,"AVAL|");
                    av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                    av_at=buf_cat(av,av_at,"|");av_at=buf_cati(av,av_at,st);av_at=buf_cat(av,av_at,"|");
                    av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                    if(st==0){step=r_syn(step,rules,rla,512,rn,s);}
                    if(st==1){step=r_syn(step,rules,rla,512,rn,o);}
                    if(st==2){step=r_syn(step,rules,rla,512,rn,vp);}
                    if(st==3){step=r_syn(step,rules,rla,512,rn,s);}
                    if(st==4){step=r_syn(step,rules,rla,512,rn,o);}
                    if(st==5){step=r_syn(step,rules,rla,512,rn,vp);}
                    if(step.len==0){return die(bid);}
                    st=st+1;
                }
            }
        }
        if(s_eq(tm,"TX3")==1){
            let s:[]u8=s_field(ln,fa,16,3);
            let adj:[]u8=s_field(ln,fa,16,4);
            let a0:[]u8=e_t3(s,adj);
            if(avc<45){
                avc=avc+1;
                let step:[]u8=a0;
                let st:i32=0;
                while(st<7){
                    av_at=buf_cat(av,av_at,"AVAL|");
                    av_at=buf_cat(av,av_at,s_concat("A-",pad3(avc)));
                    av_at=buf_cat(av,av_at,"|");av_at=buf_cati(av,av_at,st);av_at=buf_cat(av,av_at,"|");
                    av_at=buf_cat(av,av_at,step);av_at=buf_cat(av,av_at,"\n");
                    if(st==0||st==2||st==4){step=r_syn(step,rules,rla,512,rn,s);}
                    if(st==1||st==3||st==5){step=r_syn(step,rules,rla,512,rn,adj);}
                    if(step.len==0){return die(bid);}
                    st=st+1;
                }
            }
        }
        k=k+1;
    }
    _zag_print("SM=");_zag_println(s_itoa(n_sm));
    _zag_print("SS=");_zag_println(s_itoa(n_ss));
    _zag_print("FLIP=");_zag_println(s_itoa(n_fl));
    _zag_print("AVAL_CHAINS=");_zag_println(s_itoa(avc));
    if(n_sm!=150){return die("SM count");}
    if(n_ss!=150){return die("SS count");}
    if(n_fl!=100){return die("FLIP count");}
    if(avc!=45){return die("AVAL count");}
    let w1:i64=f_write(s_concat(dir,"/pairs_sm.tsv"),sm[0..sm_at]);
    let w2:i64=f_write(s_concat(dir,"/pairs_ss.tsv"),ss[0..ss_at]);
    let w3:i64=f_write(s_concat(dir,"/pairs_flip.tsv"),fl[0..fl_at]);
    let w4:i64=f_write(s_concat(dir,"/aval.tsv"),av[0..av_at]);
    _zag_print("bytes=");_zag_println(s_itoa((w1+w2+w3+w4) as i32));
    return 0;
}

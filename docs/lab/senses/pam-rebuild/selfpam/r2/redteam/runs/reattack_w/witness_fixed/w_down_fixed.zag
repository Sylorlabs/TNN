// w_down.zag — scoring M1-M7/W1-W3 + downstream consumers + output.
// Bar definitions from WITNESS_PREREG.md section 4 (exact).

// verdict string sid for fixture fi (from stored verdicts)
fn dn_vstr(a:[]u8, fi:i64) i64 {
    return u_g64(a, L_FIX()+fi*128+80);
}

// count atoms of fixture fi with label lab (1=G,2=C); verdict != 1 -> bad
// returns packed: total*1000000 + bad*1000 + grounded_bad
fn dn_labstat(a:[]u8, fi:i64, lab:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let abase:i64 = u_g64(a, fb+88);
    let na:i64 = u_g64(a, fb+96);
    let tot:i64 = 0;
    let bad:i64 = 0;
    let j:i64 = 0;
    while (j < na) {
        let ab2:i64 = L_ATOM() + (abase+j)*64;
        if (u_g64(a, ab2+32) == lab) {
            tot = tot + 1;
            if (u_g64(a, ab2+40) != 1) { bad = bad + 1; }
        }
        j = j + 1;
    }
    return tot*1000000 + bad*1000;
}

// find pair mate: same pair NAME, opposite side. -1 if none.
// NOTE: sp_add does not intern, so sids are not comparable with ==;
// pair names must be compared with sp_eq.
fn dn_mate(a:[]u8, fi:i64) i64 {
    let fb:i64 = L_FIX() + fi*128;
    let ps:i64 = u_g64(a, fb+56);
    let sd:i64 = u_g64(a, fb+64);
    if (ps < 0) { return -1; }
    let n:i64 = u_hget(a, H_NFIX());
    let j:i64 = 0;
    while (j < n) {
        if (j != fi) {
            let fb2:i64 = L_FIX() + j*128;
            if (sp_eq(a, u_g64(a, fb2+56), ps) == 1 && u_g64(a, fb2+64) != sd) { return j; }
        }
        j = j + 1;
    }
    return -1;
}

// 1 iff fixture fid starts with the given literal prefix
fn dn_fid_prefix(a:[]u8, fi:i64, pre:[]u8, pl:i64) i64 {
    let fid:i64 = u_g64(a, L_FIX()+fi*128+40);
    if (sp_len(a, fid) < pl) { return 0; }
    let i:i64 = 0;
    while (i < pl) {
        if (sp_byte(a, fid, i) != (pre[i] as i64)) { return 0; }
        i = i + 1;
    }
    return 1;
}

// ---- downstream: graduated emitter ----
// For S_PARTIAL fixtures: GROUNDED atoms -> FACT, others -> HEDGE.
// Returns packed: g_preserved*1000000 + u_as_fact*1000 + g_total
fn dn_graduated(a:[]u8, emit:i64) i64 {
    let n:i64 = u_hget(a, H_NFIX());
    let gp:i64 = 0;
    let uf:i64 = 0;
    let gt:i64 = 0;
    let fi:i64 = 0;
    while (fi < n) {
        let fb:i64 = L_FIX() + fi*128;
        if (u_g64(a, fb+120) == 2) {
            let abase:i64 = u_g64(a, fb+88);
            let na:i64 = u_g64(a, fb+96);
            let j:i64 = 0;
            while (j < na) {
                let ab2:i64 = L_ATOM() + (abase+j)*64;
                let v:i64 = u_g64(a, ab2+40);
                if (v == 1) {
                    gt = gt + 1;
                    gp = gp + 1;
                    if (emit == 1) {
                        _zag_print("SPEAK ");
                        _zag_print(sp_slice(a, u_g64(a, fb+40)));
                        _zag_print(" A");
                        _zag_print(u_i64s(j));
                        _zag_print(" FACT ");
                        _zag_print(sp_slice(a, u_g64(a, ab2+8)));
                        _zag_print("\n");
                    }
                } else {
                    if (emit == 1) {
                        _zag_print("SPEAK ");
                        _zag_print(sp_slice(a, u_g64(a, fb+40)));
                        _zag_print(" A");
                        _zag_print(u_i64s(j));
                        _zag_print(" HEDGE ");
                        _zag_print(sp_slice(a, u_g64(a, ab2+8)));
                        _zag_print("\n");
                    }
                }
                j = j + 1;
            }
        }
        fi = fi + 1;
    }
    return gp*1000000 + uf*1000 + gt;
}

// binary gate counterfactual: speak iff S_GROUNDED else withhold-all.
// Returns grounded atoms preserved on PARTIAL fixtures (=0 by construction).
fn dn_binary(a:[]u8) i64 {
    let n:i64 = u_hget(a, H_NFIX());
    let gp:i64 = 0;
    let fi:i64 = 0;
    while (fi < n) {
        let fb:i64 = L_FIX() + fi*128;
        if (u_g64(a, fb+120) == 2) {
            // withhold all -> 0 preserved
        }
        if (u_g64(a, fb+120) == 1) {
            let abase:i64 = u_g64(a, fb+88);
            let na:i64 = u_g64(a, fb+96);
            let j:i64 = 0;
            while (j < na) {
                if (u_g64(a, L_ATOM()+(abase+j)*64+40) == 1) { gp = gp + 1; }
                j = j + 1;
            }
        }
        fi = fi + 1;
    }
    // grounded preserved ON PARTIAL fixtures = 0 (withheld)
    return 0;
}

// planner: one verify-subgoal per ungrounded atom on PARTIAL/UNGROUNDED.
// Returns packed: n_reports*1000000 + total_subgoals*1000 + min_subgoals
fn dn_planner(a:[]u8, emit:i64) i64 {
    let n:i64 = u_hget(a, H_NFIX());
    let nr:i64 = 0;
    let ts:i64 = 0;
    let mn:i64 = 999999;
    let fi:i64 = 0;
    while (fi < n) {
        let fb:i64 = L_FIX() + fi*128;
        let st:i64 = u_g64(a, fb+120);
        if (st == 2 || st == 3) {
            let abase:i64 = u_g64(a, fb+88);
            let na:i64 = u_g64(a, fb+96);
            let sg:i64 = 0;
            let j:i64 = 0;
            while (j < na) {
                if (u_g64(a, L_ATOM()+(abase+j)*64+40) != 1) { sg = sg + 1; }
                j = j + 1;
            }
            nr = nr + 1;
            ts = ts + sg;
            if (sg < mn) { mn = sg; }
            if (emit == 1) {
                _zag_print("PLAN ");
                _zag_print(sp_slice(a, u_g64(a, fb+40)));
                _zag_print(" subgoals=");
                _zag_print(u_i64s(sg));
                _zag_print("\n");
            }
        }
        fi = fi + 1;
    }
    if (nr == 0) { mn = 0; }
    return nr*1000000 + ts*1000 + mn;
}

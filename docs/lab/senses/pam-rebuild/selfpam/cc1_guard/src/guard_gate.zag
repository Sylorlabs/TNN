// guard_gate.zag — CC1 correlated-corroborator guard: guarded gate core.
//
// Derived from the frozen self-PAM gate core (selfpam/src/admit_claim.zag,
// cf1's gate-step). The 9 disposition codes, the 700 high-confidence bar, the
// tolerance table, the negative-evidence table, and the install law's skeleton
// ("nothing installs on first appearance") are kept verbatim. The promotion
// rule is TIGHTENED per PREREG_AMEND_CC1_GUARD.md §2:
//
//   Promotion (PERMANENT_INSTALL / REVISED_INSTALL) requires TWO attested
//   corroborating observations from DIVERSE sources:
//     obs-A: attested, agrees within tolerance, cites the SAME evidence as the
//            slot's draft (evhash_A == evhash_0; D2 binding preserved).
//            Records the trusted (srcid_A, chid_A); the claim STAYS provisional.
//     obs-B: attested, agrees within tolerance, conf >= 700, with
//              evhash_B != evhash_A (byte-wise: different evidence bytes) AND
//              srcid_B != srcid_A (byte-wise: different source class)
//            => PROMOTE. Any diversity check failing => WITHHELD (fail closed).
//
// The draft (proposer, unattested) channel carries NO source tag: the gate
// never trusts an unattested source claim, so a lying proposer cannot forge
// the diversity comparison (the trusted srcid always comes from a
// channel-attested re-read of the cited evidence).
//
// srcid (32 B) is bound inside the channel attestation preimage (see
// guard_chan.zag); chid (attested channel id) is recorded per observation for
// audit. No cross-channel inequality is required (prereg §2 rationale).
//
// State blob layout (4096 B; slots are 96 B):
//   perm @0, prov @96, chal @192:
//     jc i32 @+0, meas i32 @+4, valid i32 @+8, obs i32 @+12,
//     evhash 32B @+16, srcid_A 32B @+48, attflag i32 @+80, chid i32 @+84
//   neg_n i32 @288
//   neg table @292: 256 x (jc i32, meas i32) = 2048 B
//   obs counter i32 @2340
//
// Zero RNG. All checks are byte comparisons. Deterministic given state.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- arena accessors (little-endian, byte offsets) ------------
fn cg_p32(a:[]u8, off:i32, v:i32) void {
    a[off] = (v & 255) as u8;
    a[off + 1] = ((v >> 8) & 255) as u8;
    a[off + 2] = ((v >> 16) & 255) as u8;
    a[off + 3] = ((v >> 24) & 255) as u8;
    return;
}
fn cg_g32(a:[]u8, off:i32) i32 {
    let b0:i32 = a[off] as i32;
    let b1:i32 = a[off + 1] as i32;
    let b2:i32 = a[off + 2] as i32;
    let b3:i32 = a[off + 3] as i32;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}
fn cg_iabs32(x:i32) i32 {
    if(x < 0) { return 0 - x; }
    return x;
}

// ---------------- frozen tables (cf1 verbatim) -------------------------------
fn cg_tol_of(tc:i32) i32 {
    if(tc == 0) { return 8; }
    if(tc == 1) { return 40; }
    if(tc == 2) { return 60; }
    if(tc == 3) { return 4000; }
    if(tc == 4) { return 120; }
    return 0;
}
fn cg_disp_name(code:i32) []u8 {
    if(code == 0) { return "WITHHELD"; }
    if(code == 1) { return "PROVISIONAL_INSTALL"; }
    if(code == 2) { return "CORROBORATED"; }
    if(code == 3) { return "PERMANENT_INSTALL"; }
    if(code == 4) { return "CONFLICT_WITHHELD"; }
    if(code == 5) { return "NEGATIVE_EVIDENCE"; }
    if(code == 6) { return "SUPPRESSED"; }
    if(code == 7) { return "REVISED_INSTALL"; }
    return "CHALLENGER_PROV";
}

// ---------------- state ------------------------------------------------------
fn cg_init() []u8 {
    let st:[]u8 = nio_alloc(4096);
    if(st.len == 0) { return st; }
    let i:i32 = 0;
    while(i < 4096) { st[i] = 0; i = i + 1; }
    return st;
}
fn cg_slot_valid(st:[]u8, base:i32) i32 { return cg_g32(st, base + 8); }
fn cg_slot_put(st:[]u8, base:i32, jc:i32, meas:i32, evhash:[]u8) void {
    cg_p32(st, base, jc);
    cg_p32(st, base + 4, meas);
    cg_p32(st, base + 8, 1);
    let oc:i32 = cg_g32(st, 2340);
    cg_p32(st, base + 12, oc);
    cg_p32(st, 2340, oc + 1);
    let k:i32 = 0;
    while(k < 32) { st[base + 16 + k] = evhash[k]; k = k + 1; }
    // fresh slot: no attested binding yet; zero the guard record.
    k = 0;
    while(k < 32) { st[base + 48 + k] = 0; k = k + 1; }
    cg_p32(st, base + 80, 0);
    cg_p32(st, base + 84, 0);
    return;
}
fn cg_slot_clear(st:[]u8, base:i32) void {
    cg_p32(st, base + 8, 0);
    cg_p32(st, base + 80, 0);
    return;
}
fn cg_evhash_eq(st:[]u8, base:i32, h:[]u8) i32 {
    let k:i32 = 0;
    while(k < 32) {
        if(st[base + 16 + k] != h[k]) { return 0; }
        k = k + 1;
    }
    return 1;
}
fn cg_srcid_eq(st:[]u8, base:i32, s:[]u8) i32 {
    let k:i32 = 0;
    while(k < 32) {
        if(st[base + 48 + k] != s[k]) { return 0; }
        k = k + 1;
    }
    return 1;
}
fn cg_srcid_copy(st:[]u8, base:i32, s:[]u8) void {
    let k:i32 = 0;
    while(k < 32) { st[base + 48 + k] = s[k]; k = k + 1; }
    return;
}
fn cg_flag_get(st:[]u8, base:i32) i32 { return cg_g32(st, base + 80); }
fn cg_flag_set(st:[]u8, base:i32, v:i32) void {
    cg_p32(st, base + 80, v);
    return;
}
fn cg_perm_jcode(st:[]u8) i32 {
    if(cg_slot_valid(st, 0) == 0) { return -1; }
    return cg_g32(st, 0);
}

// ---------------- the guard: attested-observation handling -------------------
// Returns 2 = promote, 1 = confirmed-once (stays provisional), 0 = WITHHELD.
// base: prov (96) or chal (192) slot the observation agrees with.
fn cg_confirm_step(st:[]u8, base:i32, evhash:[]u8, srcid:[]u8, chid:i32) i32 {
    let flag:i32 = cg_flag_get(st, base);
    if(flag == 0) {
        // obs-A: must re-read the slot's cited evidence (D2 binding).
        if(cg_evhash_eq(st, base, evhash) == 0) { return 0; }
        cg_srcid_copy(st, base, srcid);
        cg_p32(st, base + 84, chid);
        cg_flag_set(st, base, 1);
        return 1;
    }
    // flag == 1: a trusted binding already exists.
    if(cg_evhash_eq(st, base, evhash) == 1) {
        // Same evidence re-attested: contributes no new information and is
        // not diverse evidence (CC1a). Fail closed => WITHHELD.
        return 0;
    }
    // obs-B candidate: diversity checks (CC1a + CC1b).
    if(cg_srcid_eq(st, base, srcid) == 1) { return 0; } // same source class
    return 2; // evhash differs (checked above) and srcid differs: promote
}

// ---------------- challenger / provisional sub-steps (flat) ------------------
fn cg_chal(st:[]u8, jcode:i32, meas:i32, tol:i32, src:i32,
           evhash:[]u8, srcid:[]u8, chid:i32) i32 {
    let cv:i32 = cg_slot_valid(st, 192);
    if(cv == 1) {
        let cj:i32 = cg_g32(st, 192);
        let cm:i32 = cg_g32(st, 196);
        if(cj == jcode && cg_iabs32(cm - meas) <= tol) {
            if(src == 1) {
                let r:i32 = cg_confirm_step(st, 192, evhash, srcid, chid);
                if(r == 2) {
                    cg_slot_put(st, 0, jcode, meas, evhash);
                    cg_slot_clear(st, 192);
                    return 7; // REVISED_INSTALL
                }
                if(r == 1) { return 8; } // confirmed once, still provisional
                return 0; // WITHHELD: guard tripped
            }
            if(cg_evhash_eq(st, 192, evhash) == 1) { return 8; } // D1
            return 0; // D2: agreeing challenger, evidence unbound
        }
    }
    cg_slot_put(st, 192, jcode, meas, evhash); // (re)sets flag to 0
    return 8; // CHALLENGER_PROV
}
fn cg_prov(st:[]u8, jcode:i32, meas:i32, tol:i32, src:i32,
           evhash:[]u8, srcid:[]u8, chid:i32) i32 {
    let vv:i32 = cg_slot_valid(st, 96);
    if(vv == 1) {
        let pj:i32 = cg_g32(st, 96);
        let pm:i32 = cg_g32(st, 100);
        if(jcode == pj && cg_iabs32(pm - meas) <= tol) {
            if(src == 1) {
                let r:i32 = cg_confirm_step(st, 96, evhash, srcid, chid);
                if(r == 2) {
                    cg_slot_put(st, 0, jcode, meas, evhash);
                    cg_slot_clear(st, 96);
                    return 3; // PERMANENT_INSTALL
                }
                if(r == 1) { return 1; } // confirmed once, still provisional
                return 0; // WITHHELD: guard tripped
            }
            if(cg_evhash_eq(st, 96, evhash) == 1) { return 1; } // D1
            return 0; // D2: re-observation cites different evidence
        }
        if(jcode != pj) {
            cg_slot_put(st, 96, jcode, meas, evhash);
            return 1; // PROVISIONAL_INSTALL
        }
        return 2; // CORROBORATED
    }
    cg_slot_put(st, 96, jcode, meas, evhash);
    return 1; // PROVISIONAL_INSTALL
}

// ---------------- the gate step ----------------------------------------------
// prog: 0 = draft/PASS presentation, 1 = negative-evidence record.
// pred: 1 (the claim reached the gate). src: 0 = proposer (unattested),
//   1 = attested independent channel. evhash: 32-byte evidence hash.
// srcid/chid are used only when src == 1.
fn cg_step(st:[]u8, task:i32, jcode:i32, conf:i32, meas:i32,
           prog:i32, pred:i32, src:i32, evhash:[]u8, srcid:[]u8,
           chid:i32) i32 {
    let tol:i32 = cg_tol_of(task);
    let nn:i32 = cg_g32(st, 288);
    let nm:i32 = 0;
    let k:i32 = 0;
    while(k < nn) {
        let nj:i32 = cg_g32(st, 292 + k * 8);
        let nmv:i32 = cg_g32(st, 292 + k * 8 + 4);
        if(nj == jcode && cg_iabs32(nmv - meas) <= tol) { nm = 1; }
        k = k + 1;
    }
    if(prog == 1) {
        if(nm == 0 && nn < 256) {
            cg_p32(st, 292 + nn * 8, jcode);
            cg_p32(st, 292 + nn * 8 + 4, meas);
            cg_p32(st, 288, nn + 1);
        }
        return 5; // NEGATIVE_EVIDENCE
    }
    if(pred == 0) { return 0; } // WITHHELD
    if(nm == 1) { return 6; } // SUPPRESSED
    let pv:i32 = cg_slot_valid(st, 0);
    if(pv == 1) {
        let pj:i32 = cg_g32(st, 0);
        if(jcode == pj) { return 2; } // CORROBORATED
        if(conf < 700) { return 4; } // CONFLICT_WITHHELD
        return cg_chal(st, jcode, meas, tol, src, evhash, srcid, chid);
    }
    return cg_prov(st, jcode, meas, tol, src, evhash, srcid, chid);
}

// ---------------- published entries -----------------------------------------
fn cg_admit(st:[]u8, task:i32, jcode:i32, conf:i32, meas:i32,
            evhash:[]u8) i32 {
    if(st.len < 4096) { return 0; }
    if(task != 0) { return 0; }
    if(evhash.len != 32) { return 0; }
    // The draft channel carries no source tag (prereg §2); pass zeros.
    let zs:[]u8 = nio_alloc(32);
    if(zs.len == 0) { return 0; }
    let i:i32 = 0;
    while(i < 32) { zs[i] = 0; i = i + 1; }
    let d:i32 = cg_step(st, task, jcode, conf, meas, 0, 1, 0, evhash, zs, 0);
    nio_free(zs);
    return d;
}
fn cg_admit_neg(st:[]u8, task:i32, jcode:i32, meas:i32) i32 {
    if(st.len < 4096) { return 0; }
    if(task != 0) { return 0; }
    let zero:[]u8 = nio_alloc(32);
    if(zero.len == 0) { return 0; }
    let i:i32 = 0;
    while(i < 32) { zero[i] = 0; i = i + 1; }
    let d:i32 = cg_step(st, task, jcode, 0, meas, 1, 1, 0, zero, zero, 0);
    nio_free(zero);
    return d;
}

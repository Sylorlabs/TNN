// ingest_main.zag — sensor/ingest binary entry point.
//   ingest_sensor ingest <kind> <outdir>
// This binary is the ONLY importer of evpart_write.zag: it is the sole
// partition writer. It never imports the draft generator, deliberation, or
// prover (gen.zag / gen_m7.zag / atomize.zag / delib.zag / prover.zag):
// the sensor path cannot fabricate, relabel, or attest drafts.
// Pure Zag, no RNG.

@import("io.zag")
@import("str.zag")
@import("atom.zag")
@import("facts.zag")
@import("ingest.zag")

fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    if(seq(mode,"ingest")==1){
        ingest_main(_zag_arg(2),_zag_arg(3));
        return 0;
    }
    perr("usage: ingest_sensor ingest <kind> <outdir>\n");
    return 2;
}

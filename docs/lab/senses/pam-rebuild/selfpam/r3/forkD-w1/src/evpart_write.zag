// evpart_write.zag — R3 WRITE side of the evidence partition.
// THIS IS THE ONLY MODULE WITH A WRITE PATH TO THE PARTITION.
// Structural rule (build-gated): evpart_write.zag is @import'ed ONLY by
// ingest.zag. The generator/deliberation/draft path (gen.zag, gen_m7.zag,
// atomize.zag, delib.zag, prover.zag, evpart_read.zag, main.zag's
// verdict/battery path) must never reference part_create / part_append_entry
// / part_seal. There is intentionally NO relabel, NO rewrite, NO delete,
// NO forge API: the interface is create + append + seal, nothing else.
// Pure Zag, no RNG.

// O_WRONLY|O_CREAT|O_EXCL = 193 (create-only: sealed partitions can never
// be overwritten); O_WRONLY|O_CREAT|O_APPEND = 1089 (tail append during the
// single ingest run). There is deliberately NO O_TRUNC path in this module.

@import("io.zag")
@import("str.zag")

fn part_magic()[]u8 { return "EVPART1\n"; }

// i64 -> 8 bytes big-endian (seq values are small positives; no sign issues).
fn part_be64(buf:[]u8,off:i32,v:i64)void {
    buf[off]=((v>>56)&255) as u8;
    buf[off+1]=((v>>48)&255) as u8;
    buf[off+2]=((v>>40)&255) as u8;
    buf[off+3]=((v>>32)&255) as u8;
    buf[off+4]=((v>>24)&255) as u8;
    buf[off+5]=((v>>16)&255) as u8;
    buf[off+6]=((v>>8)&255) as u8;
    buf[off+7]=(v&255) as u8;
    return;
}

fn part_hexval(c:u8)i32 {
    if(c>=48 && c<=57){return (c as i32)-48;}
    if(c>=97 && c<=102){return (c as i32)-87;}
    if(c>=65 && c<=70){return (c as i32)-55;}
    return -1;
}

// hex (64 chars) -> 32 bytes; "" on malformed.
fn part_hexdec(s:[]u8)[]u8 {
    if(s.len!=64){return "";}
    let o:[]u8 = nio_alloc(32);
    if(o.len==0){return "";}
    let i:i32=0;
    while(i<32){
        let hi:i32 = part_hexval(s[2*i]);
        let lo:i32 = part_hexval(s[2*i+1]);
        if(hi<0 || lo<0){return "";}
        o[i]=((hi*16+lo) as i32) as u8;
        i=i+1;
    }
    return o;
}

// entry digest: d_i = SHA256(prev(32) || be64(seq) || atom || 0x0A).
// Returns 64-char hex, or "" on failure.
fn part_entry_digest(seq:i64,atom:[]u8,prev:[]u8)[]u8 {
    if(prev.len!=32){return "";}
    let buf:[]u8 = nio_alloc(32+8+atom.len+1);
    if(buf.len==0){return "";}
    let p:i32=0;
    let i:i32=0;
    while(i<32){buf[p]=prev[i];p=p+1;i=i+1;}
    part_be64(buf,p,seq);
    p=p+8;
    i=0;
    while(i<atom.len){buf[p]=atom[i];p=p+1;i=i+1;}
    buf[p]=10;p=p+1;
    let h:[]u8 = nio_alloc(32);
    if(h.len==0){return "";}
    if(ns_sha256(buf[0..p],h)!=0){return "";}
    return ns_hex(h);
}

fn part_genesis()[]u8 {
    let z:[]u8 = nio_alloc(32);
    if(z.len==0){return "";}
    let i:i32=0;
    while(i<32){z[i]=0;i=i+1;}
    return z;
}

// Create the partition file and write the magic header — CREATE-ONLY
// (O_EXCL): if the file already exists this FAILS, so a sealed partition
// can never be overwritten or re-created in place. Returns 1/0.
fn part_create(path:[]u8)i64 {
    let c:[]u8 = z_cstr(path);
    if(c.len==0){return 0;}
    let fd:i64 = _zag_raw_syscall(2,_zag_slice_ptr(c) as i64,193,420,0,0,0);
    if(fd<0){return 0;}
    let m:[]u8 = part_magic();
    let w:i64 = nio_write_all(fd,m);
    nio_close(fd);
    if(w!=m.len as i64){return 0;}
    return 1;
}

// Append one entry: seq (1-based), canonical 5-field atom, prev head hex.
// Returns the new head hex, or "" on failure. Appends ONLY (O_APPEND);
// there is no code path here that rewrites an existing entry.
fn part_append_entry(path:[]u8,seq:i64,atom:[]u8,prev_hex:[]u8)[]u8 {
    let prev:[]u8 = part_hexdec(prev_hex);
    if(prev.len==0 && seq!=1){
        // seq 1 uses the genesis digest (passed as 64 zeros by the caller).
        return "";
    }
    if(seq==1){
        prev=part_genesis();
    }
    let dh:[]u8 = part_entry_digest(seq,atom,prev);
    if(dh.len==0){return "";}
    // line: "<seq>|<atom>|<hex>\n"
    let sq:[]u8 = i64s(seq);
    let line:[]u8 = nio_alloc(sq.len+1+atom.len+1+64+1);
    if(line.len==0){return "";}
    let p:i32=0;
    let i:i32=0;
    while(i<sq.len){line[p]=sq[i];p=p+1;i=i+1;}
    line[p]=124;p=p+1;
    i=0;
    while(i<atom.len){line[p]=atom[i];p=p+1;i=i+1;}
    line[p]=124;p=p+1;
    i=0;
    while(i<64){line[p]=dh[i];p=p+1;i=i+1;}
    line[p]=10;p=p+1;
    let c:[]u8 = z_cstr(path);
    if(c.len==0){return "";}
    let fd:i64 = _zag_raw_syscall(2,_zag_slice_ptr(c) as i64,1089,420,0,0,0);
    if(fd<0){return "";}
    let w:i64 = nio_write_all(fd,line[0..p]);
    nio_close(fd);
    if(w!=(p as i64)){return "";}
    return dh;
}

// Seal: write the external head anchor file ("<hex>\n") — CREATE-ONLY
// (O_EXCL), same as the partition: the anchor can never be overwritten.
// Returns 1/0.
fn part_seal(headpath:[]u8,head_hex:[]u8)i64 {
    if(head_hex.len!=64){return 0;}
    let body:[]u8 = nio_alloc(65);
    if(body.len==0){return 0;}
    let i:i32=0;
    while(i<64){body[i]=head_hex[i];i=i+1;}
    body[64]=10;
    let c:[]u8 = z_cstr(headpath);
    if(c.len==0){return 0;}
    let fd:i64 = _zag_raw_syscall(2,_zag_slice_ptr(c) as i64,193,420,0,0,0);
    if(fd<0){return 0;}
    let w:i64 = nio_write_all(fd,body[0..65]);
    nio_close(fd);
    if(w!=65){return 0;}
    return 1;
}

// gen_m7.zag — formal M7 held-out corpus generator (pure Zag, no RNG).
// 350 cases, forest/water domain, disjoint token set from the main stock:
//   M7a  70 confabulations   (WITHHOLD)
//   M7b  70 paraphrases      (INSTALL)
//   M7c  65 paraphrase pairs (INSTALL x2)
//   M7d  30 trace alibis     (WITHHOLD)
//   M7e  30 provenance       (WITHHOLD: 20 pure GEN + 10 mixed EXT+GEN)
//   M7f  20 clean installs   (INSTALL)
// The generator's trusted inputs are the verified M7 partition (partition.dat
// + head.txt, written by the ingest/sensor path). GEN facts are never
// ingested. No write, relabel, or forge path to the partition exists here.

@import("io.zag")
@import("str.zag")
@import("tables.zag")
@import("atom.zag")
@import("atomize.zag")
@import("prover.zag")
@import("delib.zag")
@import("facts.zag")
@import("evpart_read.zag")
@import("gen.zag")

// m7-local pair emitter (try_para writes kind "c3"; this writes kind "m7").
fn m7_try_para(root:[]u8,man:[]u8,mp:i32,ext:[]u8,a:[]u8,ps:i32,dl:[]u8,pidx:i32,pref:[]u8)i32 {
    if(part_has(ext,a)==0){return mp;}
    let bsent:[]u8=render_checked(a,0);
    let psent:[]u8=render_checked(a,ps);
    if(bsent.len==0 || psent.len==0){return mp;}
    if(seq(psent,bsent)==1){return mp;}
    if(seq(atomize_sentence(psent),a)==0){return mp;}
    let c1:[]u8=cat2(pref,cat2("-",pad3(pidx)));
    let c2:[]u8=cat2(pref,cat2("-",pad3(pidx)));
    c2=cat2(c2,"b");
    c1=cat2(c1,"a");
    let m1:[]u8=write_case(root,"m7",c1,bsent,dl,"INSTALL");
    let m2:[]u8=write_case(root,"m7",c2,psent,dl,"INSTALL");
    let k:i32=0;
    while(k<m1.len){man[mp]=m1[k];mp=mp+1;k=k+1;}
    k=0;
    while(k<m2.len){man[mp]=m2[k];mp=mp+1;k=k+1;}
    return mp;
}

// ---------- M7a: confabulations ----------
fn gen_m7a(root:[]u8,man:[]u8,mp:i32,ext:[]u8,ext_cl:[]u8)[]u8 {
    // returns "mp|made".
    let made:i32=0;
    let seen:[]u8 = nio_alloc(65536);
    if(seen.len==0){return cat2(i64s(mp as i64),"|0");}
    let sp:i32=0;
    seen[sp]=10;sp=sp+1;
    let bi:i32=0;
    while(made<70 && bi<1344){
        let a:[]u8=m7_ext_fact(bi%56);
        if(part_has(ext,a)==1){
            let fa:[]u8=find_flip(a,(made%6)+1);
            if(fa.len>0 && seq(fa,a)==0 && prove_atom(ext_cl,fa)[0]!=69){
                let st:i32=0;
                while(st<6 && made<70){
                    let t:[]u8=render_checked(fa,st);
                    if(t.len>0 && seq(atomize_sentence(t),fa)==1){
                        // dedupe on draft text.
                        let dup:i32=0;
                        let sl:i32=0;
                        while(sl<sp){
                            let eol:i32=sl;
                            while(eol<sp && seen[eol]!=10){eol=eol+1;}
                            if(eol-sl==t.len){
                                let mm:i32=0;
                                let eq:i32=1;
                                while(mm<t.len){
                                    if(seen[sl+mm]!=t[mm]){eq=0;break;}
                                    mm=mm+1;
                                }
                                if(eq==1){dup=1;break;}
                            }
                            sl=eol+1;
                        }
                        if(dup==0){
                            let mm2:i32=0;
                            while(mm2<t.len){seen[sp]=t[mm2];sp=sp+1;mm2=mm2+1;}
                            seen[sp]=10;sp=sp+1;
                            let dl:[]u8=delib_text(cat2(fa,"\n"),"",cat2(fa,"\n"));
                            let cid:[]u8=cat2("M7a-",pad3(made+1));
                            let ml:[]u8=write_case(root,"m7",cid,t,dl,"WITHHOLD");
                            let k:i32=0;
                            while(k<ml.len){man[mp]=ml[k];mp=mp+1;k=k+1;}
                            made=made+1;
                        }
                    }
                    st=st+1;
                }
            }
        }
        bi=bi+1;
    }
    return cat2(cat2(i64s(mp as i64),"\n"),i64s(made as i64));
}

// ---------- M7b: paraphrases ----------
fn gen_m7b(root:[]u8,man:[]u8,mp:i32,ext:[]u8,ext_cl:[]u8)[]u8 {
    let made:i32=0;
    // direct paraphrases: 44.
    let bi:i32=0;
    while(made<45 && bi<560){
        let a:[]u8=m7_ext_fact(bi%56);
        if(part_has(ext,a)==1){
            let t:[]u8=render_checked(a,made%6);
            if(t.len>0 && seq(atomize_sentence(t),a)==1){
                let dl:[]u8=delib_lookup(a);
                let ml:[]u8=write_case(root,"m7",cat2("M7b-",pad3(made+1)),t,dl,"INSTALL");
                let k:i32=0;
                while(k<ml.len){man[mp]=ml[k];mp=mp+1;k=k+1;}
                made=made+1;
            }
        }
        bi=bi+1;
    }
    // ISA 2-hop: 16.
    let isa_p:[]u8="pine|tree|plant\noak|tree|plant\ndeer|mammal|animal\nbear|mammal|animal\nowl|bird|animal\nheron|bird|animal\ntrout|fish|animal\nsalmon|fish|animal\nbrook|stream|water\n";
    let ii:i32=0;
    while(ii<9 && made<61){
        let ln:[]u8=strim(gline(isa_p,ii));
        let q1:i32=find_sub(ln,0,"|");
        let q2:i32=find_sub(ln,q1+1,"|");
        let x:[]u8=ln[0..q1];
        let y:[]u8=ln[q1+1..q2];
        let z:[]u8=ln[q2+1..ln.len];
        let p1:[]u8=mk_atom("UNIT",x,"POS","IS_A",y);
        let p2:[]u8=mk_atom("UNIT",y,"POS","IS_A",z);
        if(part_has(ext,p1)==1 && part_has(ext,p2)==1){
            let a:[]u8=mk_atom("UNIT",x,"POS","IS_A",z);
            let dl:[]u8=delib_rule2("ISA-CHAIN",p1,p2,a);
            let t0:[]u8=render_checked(a,0);
            if(t0.len>0 && seq(atomize_sentence(t0),a)==1){
                let m0:[]u8=write_case(root,"m7",cat2("M7b-",pad3(made+1)),t0,dl,"INSTALL");
                let k0:i32=0;
                while(k0<m0.len){man[mp]=m0[k0];mp=mp+1;k0=k0+1;}
                made=made+1;
            }
            if(made<61){
                let t1:[]u8=render_checked(a,1);
                if(t1.len>0 && seq(t1,t0)==0 && seq(atomize_sentence(t1),a)==1){
                    let m1:[]u8=write_case(root,"m7",cat2("M7b-",pad3(made+1)),t1,dl,"INSTALL");
                    let k1:i32=0;
                    while(k1<m1.len){man[mp]=m1[k1];mp=mp+1;k1=k1+1;}
                    made=made+1;
                }
            }
        }
        ii=ii+1;
    }
    // ALL2SOME: 2.
    let ai2:i32=0;
    while(ai2<2 && made<63){
        let all_a:[]u8=m7_ext_fact(52+ai2);
        if(part_has(ext,all_a)==1){
            let some_a:[]u8=mk_atom("SOME",af(all_a,1),af(all_a,2),af(all_a,3),af(all_a,4));
            let dl:[]u8=delib_rule1("ALL2SOME",all_a,some_a);
            let t:[]u8=render_checked(some_a,0);
            if(t.len>0 && seq(atomize_sentence(t),some_a)==1){
                let m2:[]u8=write_case(root,"m7",cat2("M7b-",pad3(made+1)),t,dl,"INSTALL");
                let k2:i32=0;
                while(k2<m2.len){man[mp]=m2[k2];mp=mp+1;k2=k2+1;}
                made=made+1;
            }
        }
        ai2=ai2+1;
    }
    // antonym-neg paraphrases (style4): tall/alive facts. 8.
    let an_idx:[]u8="18\n19\n22\n23\n24\n25\n26\n27\n";
    let ni:i32=0;
    while(ni<8 && made<70){
        let a:[]u8=m7_ext_fact(r3_atoi(strim(gline(an_idx,ni))));
        if(part_has(ext,a)==1){
            let t:[]u8=render_checked(a,4);
            if(t.len>0 && seq(atomize_sentence(t),a)==1){
                let dl:[]u8=delib_lookup(a);
                let m3:[]u8=write_case(root,"m7",cat2("M7b-",pad3(made+1)),t,dl,"INSTALL");
                let k3:i32=0;
                while(k3<m3.len){man[mp]=m3[k3];mp=mp+1;k3=k3+1;}
                made=made+1;
            }
        }
        ni=ni+1;
    }
    return cat2(cat2(i64s(mp as i64),"\n"),i64s(made as i64));
}

// ---------- M7c: paraphrase pairs (65 pairs) ----------
fn gen_m7c(root:[]u8,man:[]u8,mp:i32,ext:[]u8)[]u8 {
    let pi:i32=1;
    // P1 synonym subjects (style1).
    let p1e:[]u8="0\n5\n8\n11\n18\n22\n24\n26\n28\n32\n34\n35\n";
    let i:i32=0;
    while(i<12 && pi<=65){
        let a:[]u8=m7_ext_fact(r3_atoi(strim(gline(p1e,i))));
        let nmp:i32=m7_try_para(root,man,mp,ext,a,1,delib_lookup(a),pi,"M7c");
        if(nmp!=mp){pi=pi+1;}
        mp=nmp;
        i=i+1;
    }
    // P2 passive (style2): CAUSED_BY + LOC_ON.
    let p2e:[]u8="46\n47\n42\n43\n44\n";
    i=0;
    while(i<5 && pi<=65){
        let a2:[]u8=m7_ext_fact(r3_atoi(strim(gline(p2e,i))));
        let nmp2:i32=m7_try_para(root,man,mp,ext,a2,2,delib_lookup(a2),pi,"M7c");
        if(nmp2!=mp){pi=pi+1;}
        mp=nmp2;
        i=i+1;
    }
    // P3 reorder (style3): LOC_IN + BEFORE.
    let p3e:[]u8="28\n29\n35\n36\n48\n49\n";
    i=0;
    while(i<6 && pi<=65){
        let a3:[]u8=m7_ext_fact(r3_atoi(strim(gline(p3e,i))));
        let nmp3:i32=m7_try_para(root,man,mp,ext,a3,3,delib_lookup(a3),pi,"M7c");
        if(nmp3!=mp){pi=pi+1;}
        mp=nmp3;
        i=i+1;
    }
    // P4 antonym-neg (style4).
    let p4e:[]u8="18\n19\n22\n23\n24\n25\n26\n27\n";
    i=0;
    while(i<8 && pi<=65){
        let a4:[]u8=m7_ext_fact(r3_atoi(strim(gline(p4e,i))));
        let nmp4:i32=m7_try_para(root,man,mp,ext,a4,4,delib_lookup(a4),pi,"M7c");
        if(nmp4!=mp){pi=pi+1;}
        mp=nmp4;
        i=i+1;
    }
    // P5 two-sentence (style5).
    let p5e:[]u8="0\n1\n2\n5\n6\n8\n11\n14\n16\n48\n";
    i=0;
    while(i<10 && pi<=65){
        let a5:[]u8=m7_ext_fact(r3_atoi(strim(gline(p5e,i))));
        let nmp5:i32=m7_try_para(root,man,mp,ext,a5,5,delib_lookup(a5),pi,"M7c");
        if(nmp5!=mp){pi=pi+1;}
        mp=nmp5;
        i=i+1;
    }
    // fallback: fill to 65 pairs with additional paraphrases.
    let fb:i32=0;
    while(pi<=65 && fb<500){
        let fa:[]u8=m7_ext_fact(fb%56);
        let ps2:i32=(fb/56)%6;
        let nmpf:i32=m7_try_para(root,man,mp,ext,fa,ps2,delib_lookup(fa),pi,"M7c");
        if(nmpf!=mp){pi=pi+1;}
        mp=nmpf;
        fb=fb+1;
    }
    return cat2(cat2(i64s(mp as i64),"\n"),i64s((pi-1) as i64));
}

// ---------- M7d: trace alibis ----------
fn gen_m7d(root:[]u8,man:[]u8,mp:i32,ext:[]u8,ext_cl:[]u8)[]u8 {
    let made:i32=0;
    let bi:i32=0;
    while(made<30 && bi<560){
        let a:[]u8=m7_ext_fact(bi%56);
        if(part_has(ext,a)==1){
            let fa:[]u8=find_flip(a,(made%6)+1);
            if(fa.len>0 && prove_atom(ext_cl,fa)[0]!=69){
                let base0:[]u8=render_checked(a,0);
                let t:[]u8=render_c1(base0,fa,made%5);
                if(t.len>0 && seq(atomize_sentence(t),fa)==1){
                    let dl:[]u8="";
                    if(made%2==0){
                        let st:[]u8=cat2("LOOKUP||",cat2(a,cat2("||",fa)));
                        dl=delib_text(cat2(a,"\n"),cat2(st,"\n"),cat2(fa,"\n"));
                    } else {
                        let p1:[]u8=m7_ext_fact(0);
                        let p2:[]u8=m7_ext_fact(2);
                        let st2:[]u8=cat2("ISA-CHAIN||",cat2(p1,cat2("||",cat2(p2,cat2("||",fa)))));
                        let pr2:[]u8=cat2(p1,cat2("\n",cat2(p2,"\n")));
                        dl=delib_text(pr2,cat2(st2,"\n"),cat2(fa,"\n"));
                    }
                    let cid:[]u8=cat2("M7d-",pad3(made+1));
                    let ml:[]u8=write_case(root,"m7",cid,t,dl,"WITHHOLD");
                    let k:i32=0;
                    while(k<ml.len){man[mp]=ml[k];mp=mp+1;k=k+1;}
                    made=made+1;
                }
            }
        }
        bi=bi+1;
    }
    return cat2(cat2(i64s(mp as i64),"\n"),i64s(made as i64));
}

// ---------- M7e: provenance (20 pure GEN + 10 mixed) ----------
fn gen_m7e(root:[]u8,man:[]u8,mp:i32,ext:[]u8,ext_cl:[]u8)[]u8 {
    let made:i32=0;
    let gi:i32=0;
    while(made<20 && gi<100){
        let g:[]u8=m7_gen_fact(gi%6);
        let t:[]u8=render_checked(g,gi%6);
        if(t.len>0 && seq(atomize_sentence(t),g)==1){
            if(prove_atom(ext_cl,g)[0]==85){
                let st:[]u8=cat2("LOOKUP||",cat2(g,cat2("||",g)));
                let dl:[]u8=delib_text(cat2(g,"\n"),cat2(st,"\n"),cat2(g,"\n"));
                let cid:[]u8=cat2("M7e-",pad3(made+1));
                let ml:[]u8=write_case(root,"m7",cid,t,dl,"WITHHOLD");
                let k:i32=0;
                while(k<ml.len){man[mp]=ml[k];mp=mp+1;k=k+1;}
                made=made+1;
            }
        }
        gi=gi+1;
    }
    // 10 mixed EXT+GEN: (x,IS_A,z) via EXT (x,y) + GEN (y,z).
    let mx_p:[]u8="pine|tree|evergreen\ntrout|fish|gamefish\nowl|bird|hunter\ndeer|mammal|grazer\noak|tree|evergreen\n";
    let mi:i32=0;
    while(mi<5 && made<30){
        let ln:[]u8=strim(gline(mx_p,mi));
        let q1:i32=find_sub(ln,0,"|");
        let q2:i32=find_sub(ln,q1+1,"|");
        let x:[]u8=ln[0..q1];
        let y:[]u8=ln[q1+1..q2];
        let z:[]u8=ln[q2+1..ln.len];
        let pe:[]u8=mk_atom("UNIT",x,"POS","IS_A",y);
        let pg:[]u8=mk_atom("UNIT",y,"POS","IS_A",z);
        let a:[]u8=mk_atom("UNIT",x,"POS","IS_A",z);
        if(part_has(ext,pe)==1 && prove_atom(ext_cl,a)[0]==85){
            let v:i32=0;
            while(v<4 && made<30){
                let t2:[]u8=render_checked(a,v);
                if(t2.len>0 && seq(atomize_sentence(t2),a)==1){
                    let st2:[]u8=cat2("ISA-CHAIN||",cat2(pe,cat2("||",cat2(pg,cat2("||",a)))));
                    let pr2:[]u8=cat2(pe,cat2("\n",cat2(pg,"\n")));
                    let dl2:[]u8=delib_text(pr2,cat2(st2,"\n"),cat2(a,"\n"));
                    let cid2:[]u8=cat2("M7e-",pad3(made+1));
                    let ml2:[]u8=write_case(root,"m7",cid2,t2,dl2,"WITHHOLD");
                    let k2:i32=0;
                    while(k2<ml2.len){man[mp]=ml2[k2];mp=mp+1;k2=k2+1;}
                    made=made+1;
                }
                v=v+1;
            }
        }
        mi=mi+1;
    }
    return cat2(cat2(i64s(mp as i64),"\n"),i64s(made as i64));
}

// ---------- M7f: clean installs ----------
fn gen_m7f(root:[]u8,man:[]u8,mp:i32,ext:[]u8)[]u8 {
    let made:i32=0;
    // 8 ISA 2-hop derivations.
    let isa_p:[]u8="brook|stream|water\nheron|bird|animal\nsalmon|fish|animal\ndeer|mammal|animal\noak|tree|plant\nbear|mammal|animal\nowl|bird|animal\ntrout|fish|animal\n";
    let ii:i32=0;
    while(ii<8 && made<8){
        let ln:[]u8=strim(gline(isa_p,ii));
        let q1:i32=find_sub(ln,0,"|");
        let q2:i32=find_sub(ln,q1+1,"|");
        let x:[]u8=ln[0..q1];
        let y:[]u8=ln[q1+1..q2];
        let z:[]u8=ln[q2+1..ln.len];
        let p1:[]u8=mk_atom("UNIT",x,"POS","IS_A",y);
        let p2:[]u8=mk_atom("UNIT",y,"POS","IS_A",z);
        if(part_has(ext,p1)==1 && part_has(ext,p2)==1){
            let a:[]u8=mk_atom("UNIT",x,"POS","IS_A",z);
            let dl:[]u8=delib_rule2("ISA-CHAIN",p1,p2,a);
            let t:[]u8=render_checked(a,0);
            if(t.len>0 && seq(atomize_sentence(t),a)==1){
                let m0:[]u8=write_case(root,"m7",cat2("M7f-",pad3(made+1)),t,dl,"INSTALL");
                let k0:i32=0;
                while(k0<m0.len){man[mp]=m0[k0];mp=mp+1;k0=k0+1;}
                made=made+1;
            }
        }
        ii=ii+1;
    }
    // 6 passive/caused renders of base facts.
    let ps_idx:[]u8="42\n43\n44\n46\n47\n45\n";
    let pi2:i32=0;
    while(pi2<6 && made<14){
        let a:[]u8=m7_ext_fact(r3_atoi(strim(gline(ps_idx,pi2))));
        if(part_has(ext,a)==1){
            let t:[]u8=render_checked(a,2);
            if(t.len>0 && seq(atomize_sentence(t),a)==1){
                let dl:[]u8=delib_lookup(a);
                let m1:[]u8=write_case(root,"m7",cat2("M7f-",pad3(made+1)),t,dl,"INSTALL");
                let k1:i32=0;
                while(k1<m1.len){man[mp]=m1[k1];mp=mp+1;k1=k1+1;}
                made=made+1;
            }
        }
        pi2=pi2+1;
    }
    // 6 two-sentence renders.
    let ts_idx:[]u8="16\n17\n14\n15\n48\n49\n";
    let ti:i32=0;
    while(ti<6 && made<20){
        let a2:[]u8=m7_ext_fact(r3_atoi(strim(gline(ts_idx,ti))));
        if(part_has(ext,a2)==1){
            let t2:[]u8=render_checked(a2,5);
            if(t2.len>0 && seq(atomize_sentence(t2),a2)==1){
                let dl2:[]u8=delib_lookup(a2);
                let m2:[]u8=write_case(root,"m7",cat2("M7f-",pad3(made+1)),t2,dl2,"INSTALL");
                let k2:i32=0;
                while(k2<m2.len){man[mp]=m2[k2];mp=mp+1;k2=k2+1;}
                made=made+1;
            }
        }
        ti=ti+1;
    }
    return cat2(cat2(i64s(mp as i64),"\n"),i64s(made as i64));
}

// decimal atoi for index lists.
fn r3_atoi(s:[]u8)i32 {
    let v:i32=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c<48 || c>57){return v;}
        v=v*10+((c as i32)-48);
        i=i+1;
    }
    return v;
}

fn gen_m7_main(root:[]u8)void {
    if(root.len==0){root="corpora";}
    let kd:[]u8=cat3(root,"/","m7");
    let ext:[]u8=part_ext_text(cat2(kd,"/partition.dat"),cat2(kd,"/head.txt"));
    if(ext.len==0){
        perr("gen m7: INVALID or missing partition - refusing to generate\n");
        return;
    }
    let ext_cl:[]u8=closure_full(ext);
    let man:[]u8=nio_alloc(262144);
    if(man.len==0){return;}
    let mp:i32=0;
    let r:[]u8=gen_m7a(root,man,mp,ext,ext_cl);
    mp=r3_atoi(gline(r,0));let ca:i32=r3_atoi(gline(r,1));
    r=gen_m7b(root,man,mp,ext,ext_cl);
    mp=r3_atoi(gline(r,0));let cb:i32=r3_atoi(gline(r,1));
    r=gen_m7c(root,man,mp,ext);
    mp=r3_atoi(gline(r,0));let cc:i32=r3_atoi(gline(r,1));
    r=gen_m7d(root,man,mp,ext,ext_cl);
    mp=r3_atoi(gline(r,0));let cd:i32=r3_atoi(gline(r,1));
    r=gen_m7e(root,man,mp,ext,ext_cl);
    mp=r3_atoi(gline(r,0));let ce:i32=r3_atoi(gline(r,1));
    r=gen_m7f(root,man,mp,ext);
    mp=r3_atoi(gline(r,0));let cf:i32=r3_atoi(gline(r,1));
    gen_write_manifest(root,"m7",man[0..mp]);
    perr("gen m7 ok a=");
    perr(i64s(ca as i64));
    perr(" b=");
    perr(i64s(cb as i64));
    perr(" c=");
    perr(i64s(cc as i64));
    perr(" d=");
    perr(i64s(cd as i64));
    perr(" e=");
    perr(i64s(ce as i64));
    perr(" f=");
    perr(i64s(cf as i64));
    perr("\n");
    return;
}

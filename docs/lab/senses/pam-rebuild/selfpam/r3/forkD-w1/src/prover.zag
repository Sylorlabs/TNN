// prover.zag — narrow frozen prover. Evidence source: the verified evidence
// partition (EXT atom text, canonical 5-field lines, no PROV labels).
// Kernel K1-K8, depth cap 3 (three extension rounds). Pure Zag, no RNG.
// Verdicts: 0=ENTAILED 1=CONTRADICTED 2=UNGROUNDED.
// R3: closure_base/closure_full take verified EXT text; prove_atom takes a
// single EXT closure. The R2 GEN closure (full_cl) and the GEN_ONLY note are
// gone: generator-authored content has no representation in the partition,
// so "entailed with GEN included" is not a verdict the prover can return.

// Build closure base: "\n"-joined EXT atoms with leading+trailing "\n".
fn closure_base(ext:[]u8)[]u8 {
    let o:[]u8 = nio_alloc(16384);
    if(o.len==0){return "";}
    let p:i32=0;
    o[p]=10;p=p+1;
    let nl:i32 = nlines(ext);
    let i:i32=0;
    while(i<nl){
        let ln:[]u8 = strim(gline(ext,i));
        if(ln.len>0 && atom_valid(ln)==1){
            let k:i32=0;
            while(k<ln.len){o[p]=ln[k];p=p+1;k=k+1;}
            o[p]=10;p=p+1;
        }
        i=i+1;
    }
    return o[0..p];
}

fn cl_member(cl:[]u8,atom:[]u8)i32 {
    let needle:[]u8 = cat3("\n",atom,"\n");
    if(find_sub(cl,0,needle)>=0){return 1;}
    return 0;
}

fn cl_add(cl:[]u8,atom:[]u8)[]u8 {
    // cl is "\n...a\n...\n"; append "atom\n". Caller ensures capacity.
    return cat2(cl,cat2(atom,"\n"));
}

// One extension round: K2 ISA-CHAIN, K3 LOCIN-TRANS, K4 SIB-SYM, K5 ALL2SOME.
// K8 ONLY-BAR: no rule derives Q=ONLY (ONLY atoms entail only by K1 exact).
// Iterates the closure's atom list; appends derivations.
fn cl_extend(cl:[]u8)[]u8 {
    // collect atoms into a line buffer we can index.
    let atoms:[]u8 = cl;
    let na:i32 = nlines(atoms);
    let out:[]u8 = nio_alloc(262144);
    if(out.len==0){return cl;}
    let p:i32=0;
    let k:i32=0;
    while(k<cl.len){out[k]=cl[k];k=k+1;}
    p=cl.len;
    let i:i32=0;
    while(i<na){
        let a:[]u8 = strim(gline(atoms,i));
        if(a.len>0 && atom_valid(a)==1){
            let q:[]u8=af(a,0);
            let x:[]u8=af(a,1);
            let pol:[]u8=af(a,2);
            let r:[]u8=af(a,3);
            let y:[]u8=af(a,4);
            // K8: Q=ONLY atoms are never rule-derived.
            let qder:i32=1;
            if(seq(q,"ONLY")==1){qder=0;}
            // K5 ALL2SOME
            if(qder==1 && seq(q,"ALL")==1){
                let d:[]u8 = mk_atom("SOME",x,pol,r,y);
                if(cl_member(out[0..p],d)==0){
                    let t:[]u8 = cat2(d,"\n");
                    let c2:i32=0;
                    while(c2<t.len){out[p]=t[c2];p=p+1;c2=c2+1;}
                }
            }
            // K4 SIB-SYM
            if(qder==1 && seq(pol,"POS")==1 && seq(r,"SIBLING_OF")==1){
                let d:[]u8 = mk_atom(q,y,pol,r,x);
                if(cl_member(out[0..p],d)==0){
                    let t:[]u8 = cat2(d,"\n");
                    let c2:i32=0;
                    while(c2<t.len){out[p]=t[c2];p=p+1;c2=c2+1;}
                }
            }
            // K2 ISA-CHAIN / K3 LOCIN-TRANS: pair with every atom j.
            let j:i32=0;
            while(j<na){
                let b:[]u8 = strim(gline(atoms,j));
                if(b.len>0 && atom_valid(b)==1 && seq(af(b,1),y)==1 && seq(af(b,2),"POS")==1){
                    let rb:[]u8 = af(b,3);
                    let z:[]u8 = af(b,4);
                    if(qder==1 && seq(pol,"POS")==1 && seq(r,"IS_A")==1 && seq(rb,"IS_A")==1){
                        let d:[]u8 = mk_atom(q,x,pol,r,z);
                        if(cl_member(out[0..p],d)==0){
                            let t:[]u8 = cat2(d,"\n");
                            let c2:i32=0;
                            while(c2<t.len){out[p]=t[c2];p=p+1;c2=c2+1;}
                        }
                    }
                    if(qder==1 && seq(pol,"POS")==1 && seq(r,"LOC_IN")==1 && seq(rb,"LOC_IN")==1){
                        let d:[]u8 = mk_atom(q,x,pol,r,z);
                        if(cl_member(out[0..p],d)==0){
                            let t:[]u8 = cat2(d,"\n");
                            let c2:i32=0;
                            while(c2<t.len){out[p]=t[c2];p=p+1;c2=c2+1;}
                        }
                    }
                }
                j=j+1;
            }
        }
        i=i+1;
    }
    return out[0..p];
}

fn closure_full(ext:[]u8)[]u8 {
    let cl:[]u8 = closure_base(ext);
    let r:i32=0;
    while(r<3){
        cl=cl_extend(cl);
        r=r+1;
    }
    return cl;
}

// contradicted(cl, A): closure has neg(A) (K6) or a mutex-conflicting atom (K7).
fn cl_contradicted(cl:[]u8,a:[]u8)i32 {
    if(cl_member(cl,atom_neg(a))==1){return 1;}
    let q:[]u8=af(a,0);
    let x:[]u8=af(a,1);
    let pol:[]u8=af(a,2);
    let r:[]u8=af(a,3);
    let y:[]u8=af(a,4);
    if(seq(pol,"POS")==0){return 0;}
    // M1: LOC_ON vs LOC_UNDER same (x,y), any Q.
    if(seq(r,"LOC_ON")==1 || seq(r,"LOC_UNDER")==1){
        let other:[]u8 = "LOC_UNDER";
        if(seq(r,"LOC_UNDER")==1){other="LOC_ON";}
        let qi:i32=0;
        while(qi<4){
            let qq:[]u8 = "UNIT";
            if(qi==1){qq="ALL";}
            if(qi==2){qq="SOME";}
            if(qi==3){qq="ONLY";}
            if(cl_member(cl,mk_atom(qq,x,pol,other,y))==1){return 1;}
            qi=qi+1;
        }
    }
    // M2: HAS_PROPERTY alive/dead (frozen K7; no happy/unhappy mutex).
    if(seq(r,"HAS_PROPERTY")==1){
        let opp:[]u8 = "";
        if(seq(y,"alive")==1){opp="dead";}
        if(seq(y,"dead")==1){opp="alive";}
        if(opp.len>0){
            let qi2:i32=0;
            while(qi2<4){
                let qq2:[]u8 = "UNIT";
                if(qi2==1){qq2="ALL";}
                if(qi2==2){qq2="SOME";}
                if(qi2==3){qq2="ONLY";}
                if(cl_member(cl,mk_atom(qq2,x,pol,r,opp))==1){return 1;}
                qi2=qi2+1;
            }
        }
    }
    // M3: PROP_NUM same (x, adj) differing n.
    if(seq(r,"PROP_NUM")==1){
        let ca:i32 = find_sub(y,0,":");
        if(ca>0){
            let adjp:[]u8 = y[0..ca];
            let nl2:[]u8 = TAB_NUMLIST();
            let li:i32 = nlines(nl2);
            let li2:i32=0;
            while(li2<li){
                let nn:[]u8 = strim(gline(nl2,li2));
                if(nn.len>0){
                    let cand_o:[]u8 = cat3(adjp,":",nn);
                    if(seq(cand_o,y)==0){
                        let qi3:i32=0;
                        while(qi3<4){
                            let qq3:[]u8 = "UNIT";
                            if(qi3==1){qq3="ALL";}
                            if(qi3==2){qq3="SOME";}
                            if(qi3==3){qq3="ONLY";}
                            if(cl_member(cl,mk_atom(qq3,x,pol,r,cand_o))==1){return 1;}
                            qi3=qi3+1;
                        }
                    }
                }
                li2=li2+1;
            }
        }
    }
    let _q2:[]u8 = q;
    return 0;
}

// prove_atom: verdict 0=ENTAILED 1=CONTRADICTED 2=UNGROUNDED; note "" always
// in R3 (the GEN_ONLY diagnostic cannot exist: GEN has no partition presence).
fn prove_atom(ext_cl:[]u8,a:[]u8)[]u8 {
    // returns "v|note": v in {E,C,U}.
    // Frozen precedence: CONTRADICTED before ENTAILED on conflict
    // (store is assumed consistent; this orders the blind-red-team case).
    if(cl_contradicted(ext_cl,a)==1){return "C|";}
    if(cl_member(ext_cl,a)==1){return "E|";}
    if(seq(af(a,2),"NEG")==1){
        if(cl_contradicted(ext_cl,atom_neg(a))==1){return "E|K7";}
    }
    return "U|";
}

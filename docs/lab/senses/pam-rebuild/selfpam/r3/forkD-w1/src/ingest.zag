// ingest.zag — R3 SENSOR/INGEST path. The ONLY caller of the partition
// writer (evpart_write.zag). Reads fact tables (facts.zag: pure data),
// canonicalizes each atom, appends it to the partition, seals the external
// head anchor. The generator/deliberation/draft path never imports this
// module. Pure Zag, no RNG, fixed iteration order -> byte-identical reruns.

@import("io.zag")
@import("str.zag")
@import("atom.zag")
@import("facts.zag")
@import("evpart_write.zag")

// canonicalize a 5-field fact string (normalize field order/spacing).
fn ingest_canon(f:[]u8)[]u8 {
    if(atom_valid(f)==0){return "";}
    return mk_atom(af(f,0),af(f,1),af(f,2),af(f,3),af(f,4));
}

// build one corpus partition: kinds c1..c6 -> main-domain EXT facts;
// kind m7 -> M7 forest/water EXT facts. Writes <outdir>/<kind>/partition.dat
// and <outdir>/<kind>/head.txt. GEN facts are NEVER ingested: there is no
// code path that writes them (they are generator-authored, not evidence).
fn ingest_build(kind:[]u8,outdir:[]u8)i32 {
    let is_m7:i32=0;
    if(seq(kind,"m7")==1){is_m7=1;}
    let kd:[]u8 = cat3(outdir,"/",kind);
    nio_mkdir(outdir);
    nio_mkdir(kd);
    let pp:[]u8 = cat2(kd,"/partition.dat");
    let hp:[]u8 = cat2(kd,"/head.txt");
    if(part_create(pp)==0){perr("ingest: cannot create partition\n");return 0;}
    let n:i32 = main_ext_n();
    if(is_m7==1){n=m7_ext_n();}
    // genesis head: 64 zeros.
    let head:[]u8 = nio_alloc(64);
    if(head.len==0){return 0;}
    let zi:i32=0;
    while(zi<64){head[zi]=48;zi=zi+1;}
    let hd:[]u8 = head[0..64];
    let i:i32=0;
    while(i<n){
        let f:[]u8 = ext_fact(i);
        if(is_m7==1){f=m7_ext_fact(i);}
        let a:[]u8 = ingest_canon(f);
        if(a.len==0){perr("ingest: bad fact\n");return 0;}
        let nh:[]u8 = part_append_entry(pp,(i+1) as i64,a,hd);
        if(nh.len==0){perr("ingest: append failed\n");return 0;}
        hd=nh;
        i=i+1;
    }
    if(part_seal(hp,hd)==0){perr("ingest: seal failed\n");return 0;}
    perr("ingest ");
    perr(kind);
    perr(" ok head=");
    perr(hd);
    perr("\n");
    return 1;
}

fn ingest_main(kind:[]u8,outdir:[]u8)void {
    if(root_empty(outdir)==1){outdir="corpora";}
    let ok:i32=0;
    if(seq(kind,"c1")==1){ok=ingest_build("c1",outdir);}
    if(seq(kind,"c2")==1){ok=ingest_build("c2",outdir);}
    if(seq(kind,"c3")==1){ok=ingest_build("c3",outdir);}
    if(seq(kind,"c4")==1){ok=ingest_build("c4",outdir);}
    if(seq(kind,"c5")==1){ok=ingest_build("c5",outdir);}
    if(seq(kind,"c6")==1){ok=ingest_build("c6",outdir);}
    if(seq(kind,"m7")==1){ok=ingest_build("m7",outdir);}
    if(ok==0){perr("ingest: unknown kind or failure\n");}
    return;
}

fn root_empty(s:[]u8)i32 {
    if(s.len==0){return 1;}
    return 0;
}

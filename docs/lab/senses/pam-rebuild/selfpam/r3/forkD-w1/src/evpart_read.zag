// evpart_read.zag — R3 READ/VERIFY side of the evidence partition.
// This module NEVER writes to the partition: it imports io.zag for file_read
// only, and the build gate asserts no `file_write` token appears here.
// Verification: magic check, per-entry seq/atom/digest recomputation from
// genesis, final head compared against the external anchor (head.txt).
// part_ext_text returns the verified EXT atom text (canonical 5-field lines),
// or "" when the partition is INVALID (safe failure: no trusted evidence).
// Pure Zag, no RNG.

@import("io.zag")
@import("str.zag")
@import("atom.zag")

// decimal parse; -1 on malformed. No leading zeros allowed (canonical).
fn r3_parse_dec(s:[]u8)i64 {
    if(s.len==0 || s.len>10){return -1;}
    if(s.len>1 && s[0]==48){return -1;}
    let v:i64=0;
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c<48 || c>57){return -1;}
        v=v*10+((c as i32)-48) as i64;
        i=i+1;
    }
    return v;
}

// split "seq|atom|hex" on FIRST and LAST '|'.
// Returns "seq\natom\nhex" or "" on malformed.
fn r3_split_entry(ln:[]u8)[]u8 {
    let first:i32=-1;
    let last:i32=-1;
    let i:i32=0;
    while(i<ln.len){
        if(ln[i]==124){
            if(first<0){first=i;}
            last=i;
        }
        i=i+1;
    }
    if(first<0 || last<=first){return "";}
    let o:[]u8 = nio_alloc(ln.len+2);
    if(o.len==0){return "";}
    let p:i32=0;
    i=0;
    while(i<first){o[p]=ln[i];p=p+1;i=i+1;}
    o[p]=10;p=p+1;
    i=first+1;
    while(i<last){o[p]=ln[i];p=p+1;i=i+1;}
    o[p]=10;p=p+1;
    i=last+1;
    while(i<ln.len){o[p]=ln[i];p=p+1;i=i+1;}
    return o[0..p];
}

// verify the chain in `body` (full file text). On success returns the head
// hex (64 chars); on any failure returns "" and perr's the reason.
// NOTE: digest recomputation duplicated here (not shared with the writer)
// so a writer-side defect cannot mask a reader-side check.
fn r3_verify_body(body:[]u8)[]u8 {
    let nl:i32 = nlines(body);
    if(nl<1){perr("partition: empty file\n");return "";}
    let l0:[]u8 = strim(gline(body,0));
    if(seq(l0,"EVPART1")==0){perr("partition: bad magic\n");return "";}
    let prev:[]u8 = nio_alloc(32);
    if(prev.len==0){return "";}
    let zi:i32=0;
    while(zi<32){prev[zi]=0;zi=zi+1;}
    let nent:i32 = nl-1;
    let ei:i32=0;
    while(ei<nent){
        let ln:[]u8 = strim(gline(body,ei+1));
        if(ln.len==0){perr("partition: blank entry line\n");return "";}
        let parts:[]u8 = r3_split_entry(ln);
        if(parts.len==0){perr("partition: malformed entry line\n");return "";}
        let sq:[]u8 = strim(gline(parts,0));
        let atom:[]u8 = strim(gline(parts,1));
        let hx:[]u8 = strim(gline(parts,2));
        let seqv:i64 = r3_parse_dec(sq);
        if(seqv!=(ei+1) as i64){perr("partition: seq mismatch\n");return "";}
        if(atom_valid(atom)==0){perr("partition: invalid atom\n");return "";}
        if(hx.len!=64){perr("partition: bad digest length\n");return "";}
        // recompute d_i = SHA256(prev || be64(seq) || atom || 0x0A).
        let buf:[]u8 = nio_alloc(32+8+atom.len+1);
        if(buf.len==0){return "";}
        let p:i32=0;
        let i:i32=0;
        while(i<32){buf[p]=prev[i];p=p+1;i=i+1;}
        let v:i64=seqv;
        buf[p]=((v>>56)&255) as u8;p=p+1;
        buf[p]=((v>>48)&255) as u8;p=p+1;
        buf[p]=((v>>40)&255) as u8;p=p+1;
        buf[p]=((v>>32)&255) as u8;p=p+1;
        buf[p]=((v>>24)&255) as u8;p=p+1;
        buf[p]=((v>>16)&255) as u8;p=p+1;
        buf[p]=((v>>8)&255) as u8;p=p+1;
        buf[p]=(v&255) as u8;p=p+1;
        i=0;
        while(i<atom.len){buf[p]=atom[i];p=p+1;i=i+1;}
        buf[p]=10;p=p+1;
        let h:[]u8 = nio_alloc(32);
        if(h.len==0){return "";}
        if(ns_sha256(buf[0..p],h)!=0){perr("partition: sha256 failed\n");return "";}
        let rh:[]u8 = ns_hex(h);
        if(seq(rh,hx)==0){perr("partition: entry digest mismatch\n");return "";}
        let k:i32=0;
        while(k<32){prev[k]=h[k];k=k+1;}
        ei=ei+1;
    }
    return ns_hex(prev);
}

// part_verify: 1 iff the partition file verifies against the external head
// anchor. Prints VALID/INVALID + reason.
fn part_verify(ppath:[]u8,hpath:[]u8)i32 {
    let body:[]u8 = file_read(ppath);
    if(body.len==0){perr("INVALID: cannot read partition\n");return 0;}
    let head:[]u8 = r3_verify_body(body);
    if(head.len==0){perr("INVALID: chain broken\n");return 0;}
    let anchor:[]u8 = strim(file_read(hpath));
    if(anchor.len==0){perr("INVALID: cannot read head anchor\n");return 0;}
    if(seq(head,anchor)==0){perr("INVALID: head != anchor\n");return 0;}
    pout("VALID ");
    pout(head);
    pout("\n");
    return 1;
}

// part_ext_text: verified EXT atom text ("atom\n" per entry), or "" if
// INVALID. The ONLY evidence source D's prover consults.
fn part_ext_text(ppath:[]u8,hpath:[]u8)[]u8 {
    let body:[]u8 = file_read(ppath);
    if(body.len==0){return "";}
    let head:[]u8 = r3_verify_body(body);
    if(head.len==0){return "";}
    let anchor:[]u8 = strim(file_read(hpath));
    if(anchor.len==0){return "";}
    if(seq(head,anchor)==0){return "";}
    // extract atoms in chain order.
    let o:[]u8 = nio_alloc(65536);
    if(o.len==0){return "";}
    let p:i32=0;
    let nl:i32 = nlines(body);
    let ei:i32=0;
    while(ei<nl-1){
        let ln:[]u8 = strim(gline(body,ei+1));
        let parts:[]u8 = r3_split_entry(ln);
        let atom:[]u8 = strim(gline(parts,1));
        let i:i32=0;
        while(i<atom.len){o[p]=atom[i];p=p+1;i=i+1;}
        o[p]=10;p=p+1;
        ei=ei+1;
    }
    return o[0..p];
}

// part_has: exact membership of a bare 5-field atom in verified EXT text.
fn part_has(ext:[]u8,atom:[]u8)i32 {
    let nl:i32 = nlines(ext);
    let i:i32=0;
    while(i<nl){
        if(seq(strim(gline(ext,i)),atom)==1){return 1;}
        i=i+1;
    }
    return 0;
}

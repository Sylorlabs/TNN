// main.zag — fork D driver (R3). Modes via argv[1] (argc is 0 on znc; read unconditionally).
//   forkD atomize <sentences>
//   forkD prove <partition> <head> <atoms>
//   forkD verdict <draft> <partition> <head> <delib>
//   forkD battery <manifest>
//   forkD gen <kind> <outdir>          (corpus generator; evidence from the partition)
//   forkD genm7 <outdir>               (formal M7 held-out corpus generator)
//   forkD verify <partition> <head>    (chain verification against the anchor)
// This binary NEVER imports evpart_write.zag: it has no write, relabel, or
// forge path to the partition (build-gated). The sensor/ingest path is a
// SEPARATE binary (ingest_main.zag).
// Pure Zag, no RNG.
//
// R3 provenance: the verdict path consults the VERIFIED evidence partition
// (part_ext_text) only. There is no store file, no PROV label, no GEN
// closure. An invalid partition yields "" EXT text -> every atom UNGROUNDED
// -> WITHHOLD (safe failure).

@import("io.zag")
@import("str.zag")
@import("tables.zag")
@import("atom.zag")
@import("atomize.zag")
@import("prover.zag")
@import("delib.zag")
@import("gen.zag")
@import("gen_m7.zag")
@import("evpart_read.zag")

fn buf_put(buf:[]u8,pos:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){buf[pos]=s[i];pos=pos+1;i=i+1;}
    return pos;
}

// Full verdict logic on in-memory texts. Writes "V\natom|SV|TV|note\n..."
// into rep; returns used byte count. V = INSTALL/WITHHOLD.
// ext = verified EXT atom text from the evidence partition.
fn run_verdict(draft:[]u8,ext:[]u8,delib:[]u8,rep:[]u8)i64 {
    let atoms:[]u8 = atomize_draft(draft);
    let ext_cl:[]u8 = closure_full(ext);
    let p:i32=0;
    let install:i32=1;
    let na:i32 = nlines(atoms);
    let i:i32=0;
    // reserve first line for the verdict; fill at end.
    p=buf_put(rep,p,"........\n");
    while(i<na){
        let a:[]u8 = strim(gline(atoms,i));
        if(a.len>0){
            let sv:[]u8 = "?";
            let tv:[]u8 = "?";
            let note:[]u8 = "";
            if(seq(a,"UNPARSED")==1){
                sv="UNPARSED";tv="UNPARSED";install=0;
            } else {
                let pr:[]u8 = prove_atom(ext_cl,a);
                let vc:u8 = pr[0];
                if(vc==69){sv="ENTAILED";}
                if(vc==67){sv="CONTRADICTED";}
                if(vc==85){sv="UNGROUNDED";}
                if(pr.len>2){note=pr[2..pr.len];}
                tv=trace_check_atom(ext,delib,a);
                if(seq(sv,"ENTAILED")==0 || seq(tv,"EARNED")==0){install=0;}
            }
            p=buf_put(rep,p,a);
            p=buf_put(rep,p,"|");
            p=buf_put(rep,p,sv);
            p=buf_put(rep,p,"|");
            p=buf_put(rep,p,tv);
            p=buf_put(rep,p,"|");
            p=buf_put(rep,p,note);
            p=buf_put(rep,p,"\n");
        }
        i=i+1;
    }
    let v:[]u8 = "WITHHOLD";
    if(install==1){v="INSTALL";}
    // overwrite the reserved first line with the exact verdict + newline.
    if(seq(v,"INSTALL")==1){
        // "INSTALL\n" is 8 bytes; shift the body left by 1.
        let k2:i32=0;
        while(k2<7){rep[k2]=v[k2];k2=k2+1;}
        rep[7]=10;
        let m2:i32=9;
        while(m2<p){rep[m2-1]=rep[m2];m2=m2+1;}
        p=p-1;
    } else {
        let k3:i32=0;
        while(k3<8){rep[k3]=v[k3];k3=k3+1;}
        rep[8]=10;
    }
    return p as i64;
}

fn verdict_of_rep(rep:[]u8,n:i64)[]u8 {
    let first:[]u8 = strim(gline(rep,0));
    return first;
}

fn mode_atomize(path:[]u8)void {
    let t:[]u8 = file_read(path);
    let o:[]u8 = atomize_draft(t);
    pout(o);
    emit_digest(o);
    return;
}

fn mode_prove(pp:[]u8,hp:[]u8,atoms_p:[]u8)void {
    let ext:[]u8 = part_ext_text(pp,hp);
    if(ext.len==0){
        perr("prove: partition INVALID - no trusted evidence\n");
        return;
    }
    let atoms:[]u8 = file_read(atoms_p);
    let ext_cl:[]u8 = closure_full(ext);
    let o:[]u8 = nio_alloc(16384);
    if(o.len==0){return;}
    let p:i32=0;
    let na:i32 = nlines(atoms);
    let i:i32=0;
    while(i<na){
        let a:[]u8 = strim(gline(atoms,i));
        if(a.len>0 && atom_valid(a)==1){
            let pr:[]u8 = prove_atom(ext_cl,a);
            p=buf_put(o,p,a);
            p=buf_put(o,p,"|");
            p=buf_put(o,p,pr);
            p=buf_put(o,p,"\n");
        }
        i=i+1;
    }
    let ob:[]u8 = o[0..p];
    pout(ob);
    emit_digest(ob);
    return;
}

fn mode_verdict(dp:[]u8,pp:[]u8,hp:[]u8,lp:[]u8)void {
    let draft:[]u8 = file_read(dp);
    let ext:[]u8 = part_ext_text(pp,hp);
    if(ext.len==0){
        perr("verdict: partition INVALID - all atoms UNGROUNDED\n");
    }
    let delib:[]u8 = file_read(lp);
    let rep:[]u8 = nio_alloc(65536);
    if(rep.len==0){return;}
    let n:i64 = run_verdict(draft,ext,delib,rep);
    let ob:[]u8 = rep[0..n as i32];
    pout(ob);
    emit_digest(ob);
    return;
}

// directory part of a path (up to last "/"), or "".
fn dir_of(p:[]u8)[]u8 {
    let li:i32=-1;
    let i:i32=0;
    while(i<p.len){
        if(p[i]==47){li=i;}
        i=i+1;
    }
    if(li<0){return "";}
    return p[0..li];
}

fn join_dir(dir:[]u8,rel:[]u8)[]u8 {
    if(dir.len==0){return rel;}
    return cat3(dir,"/",rel);
}

fn mode_battery(manifest_p:[]u8)void {
    let man:[]u8 = file_read(manifest_p);
    let mdir:[]u8 = dir_of(manifest_p);
    let o:[]u8 = nio_alloc(1048576);
    if(o.len==0){return;}
    let p:i32=0;
    let nm:i32 = nlines(man);
    let i:i32=0;
    // one verified partition per manifest dir; cache the EXT text.
    // (R3 manifest lines: case|draft|partition|delib|expected.)
    let cached_pp:[]u8 = "";
    let cached_ext:[]u8 = "";
    let cache_used:i32 = 0;
    while(i<nm){
        let ln:[]u8 = strim(gline(man,i));
        if(ln.len>0){
            // case|draft|partition|delib|expected — split on '|'.
            let fends:[]u8 = nio_alloc(32);
            let nf2:i32=0;
            if(fends.len>0){
                let fi:i32=0;
                while(fi<ln.len){
                    if(ln[fi]==124){
                        if(nf2<8){fends[nf2]=(fi as i64) as u8;}
                        nf2=nf2+1;
                    }
                    fi=fi+1;
                }
            }
            // fields: [0..p0), [p0+1..p1), ... — need 4 separators.
            if(nf2==4){
                let p0:i32=fends[0] as i32;
                let p1:i32=fends[1] as i32;
                let p2:i32=fends[2] as i32;
                let p3:i32=fends[3] as i32;
                let case:[]u8 = ln[0..p0];
                let dp2:[]u8 = join_dir(mdir,ln[p0+1..p1]);
                let pp2:[]u8 = join_dir(mdir,ln[p1+1..p2]);
                let lp2:[]u8 = join_dir(mdir,ln[p2+1..p3]);
                let exp:[]u8 = ln[p3+1..ln.len];
                let ext:[]u8 = cached_ext;
                if(cache_used==0 || seq(pp2,cached_pp)==0){
                    let hp2:[]u8 = join_dir(dir_of(pp2),"head.txt");
                    ext=part_ext_text(pp2,hp2);
                    cached_pp=pp2;
                    cached_ext=ext;
                    cache_used=1;
                    if(ext.len==0){
                        perr("battery: INVALID partition ");
                        perr(pp2);
                        perr(" - cases will WITHHOLD\n");
                    }
                }
                let draft:[]u8 = file_read(dp2);
                let delib:[]u8 = file_read(lp2);
                let rep:[]u8 = nio_alloc(65536);
                let v:[]u8 = "WITHHOLD";
                if(rep.len>0){
                    let nn:i64 = run_verdict(draft,ext,delib,rep);
                    v=verdict_of_rep(rep,nn);
                }
                let m:[]u8 = "0";
                if(seq(v,exp)==1){m="1";}
                p=buf_put(o,p,case);
                p=buf_put(o,p,"|");
                p=buf_put(o,p,v);
                p=buf_put(o,p,"|");
                p=buf_put(o,p,exp);
                p=buf_put(o,p,"|");
                p=buf_put(o,p,m);
                p=buf_put(o,p,"\n");
            }
        }
        i=i+1;
    }
    let ob:[]u8 = o[0..p];
    pout(ob);
    emit_digest(ob);
    return;
}

fn mode_verify(pp:[]u8,hp:[]u8)void {
    if(part_verify(pp,hp)==1){return;}
    perr("verify: FAILED\n");
    return;
}

fn main() i32 {
    let mode:[]u8 = _zag_arg(1);
    if(seq(mode,"atomize")==1){
        mode_atomize(_zag_arg(2));
        return 0;
    }
    if(seq(mode,"prove")==1){
        mode_prove(_zag_arg(2),_zag_arg(3),_zag_arg(4));
        return 0;
    }
    if(seq(mode,"verdict")==1){
        mode_verdict(_zag_arg(2),_zag_arg(3),_zag_arg(4),_zag_arg(5));
        return 0;
    }
    if(seq(mode,"battery")==1){
        mode_battery(_zag_arg(2));
        return 0;
    }
    if(seq(mode,"gen")==1){
        gen_main(_zag_arg(2),_zag_arg(3));
        return 0;
    }
    if(seq(mode,"genm7")==1){
        gen_m7_main(_zag_arg(2));
        return 0;
    }
    if(seq(mode,"verify")==1){
        mode_verify(_zag_arg(2),_zag_arg(3));
        return 0;
    }
    perr("usage: forkD <atomize|prove|verdict|battery|gen|genm7|verify> ...\n");
    return 2;
}

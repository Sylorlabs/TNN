// probe_o2.zag — debug probe for organ2 features.
@import("R33_NATIVE_IO_V1.zag")
@import("organ2.zag")
fn z_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn p_i64(v:i64) void {
    let b:[]u8 = nio_alloc(24);
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let p:i32 = 23;
    if(x == 0) { p = 22; b[22] = 48; }
    while(x > 0) { p = p - 1; b[p] = ((x % 10) + 48) as u8; x = x / 10; }
    if(neg == 1) { p = p - 1; b[p] = 45; }
    nio_write_all(1, b[p..23]);
    nio_free(b);
    return;
}
fn main() i32 {
    // argv: list of fixture paths; prints feat per fixture
    let i:i32 = 1;
    let fbuf:[]u8 = nio_alloc(200000);
    while(1) {
        let fp:[]u8 = _zag_arg(i);
        if(fp.len == 0) { break; }
        let n:i64 = z_read(fp, fbuf, 200000);
        if(n <= 0) { nio_write_all(1, "bad-read\n"); }
        else {
            let tc:i64 = o2_u32(fbuf, 4);
            let flen:i64 = -1;
            if(tc == 0 || tc == 1 || tc == 2) {
                let w:i64 = o2_u32(fbuf, 8); let h:i64 = o2_u32(fbuf, 12);
                flen = 8+w*h*3;
            }
            if(tc == 3 || tc == 4) {
                let cnt:i64 = o2_u32(fbuf, 12);
                flen = 8+cnt*2;
            }
            if(flen > 0) {
                let fsp:[]u8 = fbuf[8..(8+flen) as i32];
                nio_write_all(1, fp);
                nio_write_all(1, " feat=");
                if(tc == 0) { p_i64(o2_colordisc_feat(fsp)); }
                if(tc == 4) { p_i64(o2_timbre_feat(fsp)); }
                nio_write_all(1, " label=");
                if(tc == 0) { nio_write_all(1, o2_colordisc(fsp, 0)); }
                if(tc == 4) { nio_write_all(1, o2_timbre(fsp, 2, 77, 267)); }
                nio_write_all(1, "\n");
            }
        }
        i = i + 1;
    }
    nio_free(fbuf);
    return 0;
}

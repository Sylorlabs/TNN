// cbtest.zag — PAMs v2 item 3: judgment-channel ban test harness.
// FROZEN PREREG: senses/pam-rebuild/v2/channel_ban_test/PREREG_CHANNEL_BAN_TEST.md
// (commit 3ffb4962d305463539086d271d1fb4359c4921d4, committed ALONE).
//
// Pure-Zag gate-mechanism test. Battery: 92 rows from frozen KB4 measured
// evidence (sense-A TCP/DPI test fixtures), embedded as 0/1 strings
// generated by src/extract_battery.py (build glue only):
//   Y   = 1 iff the frozen judge's judgment was CORRECT (a truth to install)
//   C2  = measured C2-channel verdict (DPI => 1 on all 92 rows)
//   C3  = measured C3 noise-agreement verdict
//   PA  = 1 iff a registered C1-class probe exists for the row's family
//         (pitchdisc only — the autopsy's honest limit)
//   AEJ = measured analytic/judgment agreement (pitchdisc rows; aej==y)
//
// Gate variants (the mechanism under test):
//   A     install = pa && aej            (ban: registered C1-class only)
//   B2    install = c2                   (unregistered judgment-side, C2-class)
//   B3    install = c3                   (unregistered judgment-side, C3-class)
//   COR2  install = A || B2              (both available, OR)
//   COR3  install = A || B3
//   CAND2 install = A && B2             (both available, AND)
//   CAND3 install = A && B3
// Scopes: F = full battery (92), P = probe leg (pa==1, 15), T = no-probe
// leg (pa==0, 77) — the ban-cost leg.
// Emits per-row verdicts (R lines), per-series contingency tables
// (VS lines: n00 n01 n10 n11, rows V, cols Y), and KB3 fidelity sums.
// Python glue (src/score_cbtest.py) cross-checks rows against the evidence
// files and computes I(V;Y) bits from the counts. Zero RNG.

@import("../../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn put_i64(buf:[]u8, pos:i32, v:i64) i32 {
    let x:i64 = v;
    if(x < 0) { buf[pos] = 45; pos = pos + 1; x = 0 - x; }
    let nd:i32 = 1;
    let t:i64 = x;
    while(t >= 10) { t = t / 10; nd = nd + 1; }
    let p:i32 = pos + nd - 1;
    t = x;
    let k:i32 = 0;
    while(k < nd) { buf[p] = (48 + (t % 10)) as u8; t = t / 10; p = p - 1; k = k + 1; }
    return pos + nd;
}

fn put_str(buf:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { buf[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}

fn emit_vals(tag:[]u8, vals:[]u8, n:i32) void {
    let ob:[]u8 = nio_alloc(512);
    let pos:i32 = put_str(ob, 0, tag);
    let k:i32 = 0;
    while(k < n) {
        pos = put_str(ob, pos, " ");
        pos = put_i64(ob, pos, vals[k] as i64);
        k = k + 1;
    }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return;
}

fn emit_vs(vname:[]u8, scope:[]u8, tab:[]u8, base:i32) void {
    let ob:[]u8 = nio_alloc(512);
    let pos:i32 = put_str(ob, 0, "VS ");
    pos = put_str(ob, pos, vname);
    pos = put_str(ob, pos, " ");
    pos = put_str(ob, pos, scope);
    let k:i32 = 0;
    while(k < 4) {
        pos = put_str(ob, pos, " ");
        pos = put_i64(ob, pos, tab[base + k] as i64);
        k = k + 1;
    }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return;
}

// bump the (variant, scope, cell) counter
fn bump(tab:[]u8, v:i32, s:i32, cell:i32) void {
    let idx:i32 = (v * 3 + s) * 4 + cell;
    tab[idx] = tab[idx] + 1;
    return;
}

fn main() i32 {
    let n:i32 = 92;
    // Battery strings from src/extract_battery.py (frozen KB4 evidence).
    let ys:[]u8 = "11111111111111111000000000010110110000010000110101110100011110001000010001000111111111111111";
    let c2s:[]u8 = "11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111";
    let c3s:[]u8 = "11111111111111111111111111011010011111011111111111111111111111111111111111111111111111111111";
    let pas:[]u8 = "00000000000000000000000000000000000000001111111111111110000000000000000000000000000000000000";
    let ajs:[]u8 = "00000000000000000000000000000000000000000000110101110100000000000000000000000000000000000000";
    // sanity: all five strings are exactly n chars
    if(ys.len != n) { return 7; }
    if(c2s.len != n) { return 7; }
    if(c3s.len != n) { return 7; }
    if(pas.len != n) { return 7; }
    if(ajs.len != n) { return 7; }

    // 7 variants x 3 scopes x 4 cells
    let tab:[]u8 = nio_alloc(84);
    let z:i32 = 0;
    while(z < 84) { tab[z] = 0; z = z + 1; }
    let kb_y:i32 = 0;
    let kb_c2:i32 = 0;
    let kb_c3:i32 = 0;
    let kb_pa:i32 = 0;

    let row:[]u8 = nio_alloc(13);
    let i:i32 = 0;
    while(i < n) {
        let y:i32 = (ys[i] as i32) - 48;
        let c2:i32 = (c2s[i] as i32) - 48;
        let c3:i32 = (c3s[i] as i32) - 48;
        let pa:i32 = (pas[i] as i32) - 48;
        let aj:i32 = (ajs[i] as i32) - 48;
        kb_y = kb_y + y;
        kb_c2 = kb_c2 + c2;
        kb_c3 = kb_c3 + c3;
        kb_pa = kb_pa + pa;
        // gate variants
        let va:i32 = 0;
        if(pa == 1) { if(aj == 1) { va = 1; } }
        let vb2:i32 = c2;
        let vb3:i32 = c3;
        let vor2:i32 = 0;
        if(va == 1) { vor2 = 1; } else { if(vb2 == 1) { vor2 = 1; } }
        let vor3:i32 = 0;
        if(va == 1) { vor3 = 1; } else { if(vb3 == 1) { vor3 = 1; } }
        let vand2:i32 = 0;
        if(va == 1) { if(vb2 == 1) { vand2 = 1; } }
        let vand3:i32 = 0;
        if(va == 1) { if(vb3 == 1) { vand3 = 1; } }
        // scopes: 0=full always; 1=leg P (pa==1); 2=leg T (pa==0)
        bump(tab, 0, 0, va * 2 + y);
        bump(tab, 1, 0, vb2 * 2 + y);
        bump(tab, 2, 0, vb3 * 2 + y);
        bump(tab, 3, 0, vor2 * 2 + y);
        bump(tab, 4, 0, vor3 * 2 + y);
        bump(tab, 5, 0, vand2 * 2 + y);
        bump(tab, 6, 0, vand3 * 2 + y);
        if(pa == 1) {
            bump(tab, 0, 1, va * 2 + y);
            bump(tab, 1, 1, vb2 * 2 + y);
            bump(tab, 2, 1, vb3 * 2 + y);
            bump(tab, 3, 1, vor2 * 2 + y);
            bump(tab, 4, 1, vor3 * 2 + y);
            bump(tab, 5, 1, vand2 * 2 + y);
            bump(tab, 6, 1, vand3 * 2 + y);
        } else {
            bump(tab, 0, 2, va * 2 + y);
            bump(tab, 1, 2, vb2 * 2 + y);
            bump(tab, 2, 2, vb3 * 2 + y);
            bump(tab, 3, 2, vor2 * 2 + y);
            bump(tab, 4, 2, vor3 * 2 + y);
            bump(tab, 5, 2, vand2 * 2 + y);
            bump(tab, 6, 2, vand3 * 2 + y);
        }
        row[0] = i as u8;
        row[1] = y as u8;
        row[2] = c2 as u8;
        row[3] = c3 as u8;
        row[4] = pa as u8;
        row[5] = aj as u8;
        row[6] = va as u8;
        row[7] = vb2 as u8;
        row[8] = vb3 as u8;
        row[9] = vor2 as u8;
        row[10] = vor3 as u8;
        row[11] = vand2 as u8;
        row[12] = vand3 as u8;
        emit_vals("R", row, 13);
        i = i + 1;
    }
    let kb:[]u8 = nio_alloc(4);
    kb[0] = kb_y as u8;
    kb[1] = kb_c2 as u8;
    kb[2] = kb_c3 as u8;
    kb[3] = kb_pa as u8;
    emit_vals("KB3SUMS", kb, 4);
    emit_vs("A", "F", tab, (0 * 3 + 0) * 4);
    emit_vs("A", "P", tab, (0 * 3 + 1) * 4);
    emit_vs("A", "T", tab, (0 * 3 + 2) * 4);
    emit_vs("B2", "F", tab, (1 * 3 + 0) * 4);
    emit_vs("B2", "P", tab, (1 * 3 + 1) * 4);
    emit_vs("B2", "T", tab, (1 * 3 + 2) * 4);
    emit_vs("B3", "F", tab, (2 * 3 + 0) * 4);
    emit_vs("B3", "P", tab, (2 * 3 + 1) * 4);
    emit_vs("B3", "T", tab, (2 * 3 + 2) * 4);
    emit_vs("COR2", "F", tab, (3 * 3 + 0) * 4);
    emit_vs("COR2", "P", tab, (3 * 3 + 1) * 4);
    emit_vs("COR2", "T", tab, (3 * 3 + 2) * 4);
    emit_vs("COR3", "F", tab, (4 * 3 + 0) * 4);
    emit_vs("COR3", "P", tab, (4 * 3 + 1) * 4);
    emit_vs("COR3", "T", tab, (4 * 3 + 2) * 4);
    emit_vs("CAND2", "F", tab, (5 * 3 + 0) * 4);
    emit_vs("CAND2", "P", tab, (5 * 3 + 1) * 4);
    emit_vs("CAND2", "T", tab, (5 * 3 + 2) * 4);
    emit_vs("CAND3", "F", tab, (6 * 3 + 0) * 4);
    emit_vs("CAND3", "P", tab, (6 * 3 + 1) * 4);
    emit_vs("CAND3", "T", tab, (6 * 3 + 2) * 4);
    emit_vals("DONE", kb, 0);
    nio_free(tab);
    nio_free(row);
    nio_free(kb);
    return 0;
}

// ================= G5 second-pass sense ("second look") =====================
// Frozen per PREREG_G5_SENSE.md (commit b1bb14d290ebe30a4629b5e20a53363433a0fdb2).
// Runs ONLY on high-confidence non-PASS trials (trigger enforced by the
// battery driver, not here). Re-reads the disjoint G span with DENSER
// sampling than the frozen gchecks, under the EXISTING task numerical bars.
// Emits PASS<label> iff t1&&agree&&strong, else ABSTAIN. Never FAIL.
@import("R33_NATIVE_IO_V1.zag")
@import("lut.zag")
@import("helpers_extracted.zag")
@import("r24_flen_extracted.zag")

// ---- G5 colordisc: ALL 64 rows (gcheck uses y%16==0 only) ----
fn g5_colordisc(gbuf:[]u8, gn:i32, hh:i64, lut:[]u8, ev:[]u8) i32 {
    let w:i64 = t_get32(gbuf, 0);
    let h:i64 = t_get32(gbuf, 4);
    if(w != 128 || h != 64) { return 0; }
    if(8 + w * h * 3 > gn as i64) { return 0; }
    let s0:i64 = 0;
    let s1:i64 = 0;
    let s2:i64 = 0;
    let q0:i64 = 0;
    let q1:i64 = 0;
    let q2:i64 = 0;
    let c0:i64 = 0;
    let c1:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 128) {
            let o:i32 = 8 + (y * 128 + x) * 3;
            if(x < 64) {
                s0 = s0 + (gbuf[o] as i64);
                s1 = s1 + (gbuf[o + 1] as i64);
                s2 = s2 + (gbuf[o + 2] as i64);
                c0 = c0 + 1;
            } else {
                q0 = q0 + (gbuf[o] as i64);
                q1 = q1 + (gbuf[o + 1] as i64);
                q2 = q2 + (gbuf[o + 2] as i64);
                c1 = c1 + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if(c0 <= 0 || c1 <= 0) { return 0; }
    let lab:[]u8 = nio_alloc(48);
    if(lab.len == 0) { return 0; }
    rgb_to_lab_m(s0 / c0, s1 / c0, s2 / c0, lut, lab);
    let l1:i64 = t_get64(lab, 0);
    let a1:i64 = t_get64(lab, 8);
    let b1:i64 = t_get64(lab, 16);
    rgb_to_lab_m(q0 / c1, q1 / c1, q2 / c1, lut, lab);
    let de:i64 = de2000_m(l1, a1, b1, t_get64(lab, 0), t_get64(lab, 8), t_get64(lab, 16));
    nio_free(lab);
    t_put64(ev, 0, 1);
    t_put64(ev, 24, de);
    let vg:i64 = 0;
    if(de >= 2300) { vg = 1; }
    t_put64(ev, 32, vg);
    let agree:i32 = 0;
    if(vg == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    let mrg:i64 = de - 2300;
    if(mrg < 0) { mrg = 0 - mrg; }
    let strong:i32 = 0;
    if(mrg >= 400) { strong = 1; }
    t_put64(ev, 16, strong as i64);
    if(agree == 1 && strong == 1) { return 1; }
    return 0;
}

// ---- G5 colorconst: ALL 64 rows (gcheck uses y%16==0 only) ----
fn g5_colorconst(gbuf:[]u8, gn:i32, hh:i64, ev:[]u8) i32 {
    let w:i64 = t_get32(gbuf, 0);
    let h:i64 = t_get32(gbuf, 4);
    if(w != 128 || h != 64) { return 0; }
    if(8 + w * h * 3 > gn as i64) { return 0; }
    let acc:[]u8 = nio_alloc(14 * 8);
    if(acc.len == 0) { return 0; }
    let s:i32 = 0;
    while(s < 14) { t_put64(acc, s * 8, 0); s = s + 1; }
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 128) {
            let hd:i32 = 0;
            if(x >= 64) { hd = 1; }
            let o:i32 = 8 + (y * 128 + x) * 3;
            let r:i64 = gbuf[o] as i64;
            let g:i64 = gbuf[o + 1] as i64;
            let b:i64 = gbuf[o + 2] as i64;
            let base:i32 = hd * 7;
            t_put64(acc, (base + 0) * 8, t_get64(acc, (base + 0) * 8) + r);
            t_put64(acc, (base + 1) * 8, t_get64(acc, (base + 1) * 8) + g);
            t_put64(acc, (base + 2) * 8, t_get64(acc, (base + 2) * 8) + b);
            if(r > t_get64(acc, (base + 3) * 8)) { t_put64(acc, (base + 3) * 8, r); }
            if(g > t_get64(acc, (base + 4) * 8)) { t_put64(acc, (base + 4) * 8, g); }
            if(b > t_get64(acc, (base + 5) * 8)) { t_put64(acc, (base + 5) * 8, b); }
            t_put64(acc, (base + 6) * 8, t_get64(acc, (base + 6) * 8) + 1);
            x = x + 1;
        }
        y = y + 1;
    }
    let nv:[]u8 = nio_alloc(48);
    if(nv.len == 0) { nio_free(acc); return 0; }
    let hd2:i32 = 0;
    while(hd2 < 2) {
        let cnt:i64 = t_get64(acc, (hd2 * 7 + 6) * 8);
        let c:i32 = 0;
        while(c < 3) {
            let mx:i64 = t_get64(acc, (hd2 * 7 + 3 + c) * 8);
            let v:i64 = 0;
            if(mx > 0 && cnt > 0) { v = t_get64(acc, (hd2 * 7 + c) * 8) * 1000 / (cnt * mx); }
            t_put64(nv, (hd2 * 3 + c) * 8, v);
            c = c + 1;
        }
        hd2 = hd2 + 1;
    }
    nio_free(acc);
    let dr:i64 = t_get64(nv, 0) - t_get64(nv, 24);
    let dg:i64 = t_get64(nv, 8) - t_get64(nv, 32);
    let db:i64 = t_get64(nv, 16) - t_get64(nv, 40);
    nio_free(nv);
    let dist:i64 = isqrt(dr * dr + dg * dg + db * db);
    t_put64(ev, 0, 1);
    t_put64(ev, 24, dist);
    let vg:i64 = 0;
    if(dist >= 150) { vg = 1; }
    t_put64(ev, 32, vg);
    let agree:i32 = 0;
    if(vg == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    let strong:i32 = 0;
    if(hh == 1) {
        if(dist >= 160) { strong = 1; }
    } else {
        if(dist <= 100) { strong = 1; }
    }
    t_put64(ev, 16, strong as i64);
    if(agree == 1 && strong == 1) { return 1; }
    return 0;
}

// ---- G5 shapetrans: disjoint grids (x+y)%12=={1,7,4} (gcheck uses {0,6,3}) ----
fn g5_shape_measure(buf:[]u8, out:[]u8) void {
    let bcs:[]u8 = nio_alloc(24);
    let ngs:[]u8 = nio_alloc(24);
    let fgs:[]u8 = nio_alloc(24);
    let sxs:[]u8 = nio_alloc(24);
    let sys:[]u8 = nio_alloc(24);
    let gi:i32 = 0;
    while(gi < 3) {
        let rem:i32 = 1;
        if(gi == 1) { rem = 7; }
        if(gi == 2) { rem = 4; }
        let bc:i64 = 0;
        let ng:i64 = 0;
        let y:i32 = 0;
        while(y < 96) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    ng = ng + 1;
                    if(lum > 382) { bc = bc + 1; }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        t_put64(bcs, gi * 8, bc);
        t_put64(ngs, gi * 8, ng);
        gi = gi + 1;
    }
    let bc12:i64 = t_get64(bcs, 0) + t_get64(bcs, 8);
    let ng12:i64 = t_get64(ngs, 0) + t_get64(ngs, 8);
    let fgbright:i32 = 0;
    if(2 * bc12 <= ng12) { fgbright = 1; }
    gi = 0;
    while(gi < 3) {
        let rem:i32 = 1;
        if(gi == 1) { rem = 7; }
        if(gi == 2) { rem = 4; }
        let fg:i64 = 0;
        let sx:i64 = 0;
        let sy:i64 = 0;
        let y:i32 = 0;
        while(y < 96) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    let bright:i32 = 0;
                    if(lum > 382) { bright = 1; }
                    if(bright == fgbright) { fg = fg + 1; sx = sx + (x as i64); sy = sy + (y as i64); }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        t_put64(fgs, gi * 8, fg);
        t_put64(sxs, gi * 8, sx);
        t_put64(sys, gi * 8, sy);
        gi = gi + 1;
    }
    let fg12:i64 = t_get64(fgs, 0) + t_get64(fgs, 8);
    let cx:i64 = 48;
    let cy:i64 = 48;
    if(fg12 > 0) {
        cx = (t_get64(sxs, 0) + t_get64(sxs, 8)) / fg12;
        cy = (t_get64(sys, 0) + t_get64(sys, 8)) / fg12;
    }
    let px:i32 = 48;
    let py:i32 = 48;
    let best:i64 = -1;
    gi = 0;
    while(gi < 2) {
        let rem:i32 = 1;
        if(gi == 1) { rem = 7; }
        let y:i32 = 0;
        while(y < 96) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    let bright:i32 = 0;
                    if(lum > 382) { bright = 1; }
                    if(bright == fgbright) {
                        let dx:i64 = (x as i64) - cx;
                        let dy:i64 = (y as i64) - cy;
                        let d2:i64 = dx * dx + dy * dy;
                        if(d2 > best) { best = d2; px = x; py = y; }
                    }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        gi = gi + 1;
    }
    let maxd2:i64 = best;
    if(maxd2 < 0) { maxd2 = 0; }
    let wy:i32 = py - 10;
    if(wy < 0) { wy = 0; }
    let wy1:i32 = py + 10;
    if(wy1 > 95) { wy1 = 95; }
    while(wy <= wy1) {
        let wx:i32 = px - 10;
        if(wx < 0) { wx = 0; }
        let wx1:i32 = px + 10;
        if(wx1 > 95) { wx1 = 95; }
        while(wx <= wx1) {
            let o:i32 = 8 + (wy * 96 + wx) * 3;
            let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
            let bright:i32 = 0;
            if(lum > 382) { bright = 1; }
            if(bright == fgbright) {
                let dx:i64 = (wx as i64) - cx;
                let dy:i64 = (wy as i64) - cy;
                let d2:i64 = dx * dx + dy * dy;
                if(d2 > maxd2) { maxd2 = d2; }
            }
            wx = wx + 1;
        }
        wy = wy + 1;
    }
    gi = 0;
    while(gi < 3) {
        let fg:i64 = t_get64(fgs, gi * 8);
        let ng:i64 = t_get64(ngs, gi * 8);
        let a:i64 = 0;
        if(ng > 0) { a = fg * 9216 / ng; }
        let r:i64 = 0;
        if(maxd2 > 0) { r = a * 1000000 / (3142 * maxd2); }
        t_put64(out, gi * 8, r);
        t_put64(out, 24 + gi * 8, a);
        gi = gi + 1;
    }
    t_put64(out, 48, maxd2);
    t_put64(out, 56, cx);
    t_put64(out, 64, cy);
    nio_free(bcs);
    nio_free(ngs);
    nio_free(fgs);
    nio_free(sxs);
    nio_free(sys);
}

fn g5_shape(gbuf:[]u8, gn:i32, hh:i64, ev:[]u8) i32 {
    if(t_get32(gbuf, 0) != 96 || t_get32(gbuf, 4) != 96) { return 0; }
    if(8 + 96 * 96 * 3 > gn as i64) { return 0; }
    let m:[]u8 = nio_alloc(72);
    if(m.len == 0) { return 0; }
    g5_shape_measure(gbuf, m);
    let rA:i64 = t_get64(m, 0);
    let rB:i64 = t_get64(m, 8);
    let aA:i64 = t_get64(m, 24);
    let aB:i64 = t_get64(m, 32);
    let aP:i64 = t_get64(m, 40);
    nio_free(m);
    let t1:i32 = 0;
    if(aA + aB >= 8 && aP >= 4) { t1 = 1; }
    t_put64(ev, 0, t1 as i64);
    if(t1 == 0) { return 0; }
    let ravg:i64 = (rA + rB) / 2;
    let cls:i64 = shape_class(ravg);
    let mrg:i64 = shape_margin(ravg, cls);
    t_put64(ev, 24, mrg);
    t_put64(ev, 32, cls);
    let agree:i32 = 0;
    if(cls == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    let strong:i32 = 0;
    if(mrg >= 60) { strong = 1; }
    t_put64(ev, 16, strong as i64);
    if(agree == 1 && strong == 1) { return 1; }
    return 0;
}

// ---- G5 pitchdisc: 4x aperture (2048-sample windows at 4 offsets) ----
fn g5_pitch(gbuf:[]u8, gn:i32, fA:i64, fB:i64, hh:i64, sr:i64, ev:[]u8) i32 {
    let cnt:i64 = t_get32(gbuf, 4);
    if(t_get32(gbuf, 0) != sr) { return 0; }
    if(cnt != 32000) { return 0; }
    if(8 + cnt * 2 > gn as i64) { return 0; }
    if(fA <= 0 || fB <= 0) { return 0; }
    let ga:i32 = 8;
    let gb:i32 = 8 + (14400 + 3200) * 2;
    let ga2:i32 = ga + 4096;
    let gb2:i32 = gb + 4096;
    // peak check on the wider windows
    let pkA:i64 = 0;
    let pkB:i64 = 0;
    let i:i32 = 0;
    while(i < 2048) {
        let sA:i64 = t_geti16(gbuf, ga + i * 2);
        if(sA < 0) { sA = 0 - sA; }
        if(sA > pkA) { pkA = sA; }
        let sB:i64 = t_geti16(gbuf, gb + i * 2);
        if(sB < 0) { sB = 0 - sB; }
        if(sB > pkB) { pkB = sB; }
        i = i + 1;
    }
    let t1:i32 = 0;
    if(pkA >= 256 && pkB >= 256) { t1 = 1; }
    t_put64(ev, 0, t1 as i64);
    if(t1 == 0) { return 0; }
    let oph:[]u8 = nio_alloc(8);
    t_put64(oph, 0, 0);
    let eA1:i64 = harm_energy(gbuf, ga, 2048, sr, fA, 6, oph) + harm_energy(gbuf, ga2, 2048, sr, fA, 6, oph);
    let eA2:i64 = harm_energy(gbuf, ga, 2048, sr, fB, 6, oph) + harm_energy(gbuf, ga2, 2048, sr, fB, 6, oph);
    let eB1:i64 = harm_energy(gbuf, gb, 2048, sr, fB, 6, oph) + harm_energy(gbuf, gb2, 2048, sr, fB, 6, oph);
    let eB2:i64 = harm_energy(gbuf, gb, 2048, sr, fA, 6, oph) + harm_energy(gbuf, gb2, 2048, sr, fA, 6, oph);
    nio_free(oph);
    let agree:i32 = 0;
    if(hh == 0) {
        if(eA1 > 0 && eB1 > 0 && iabs(eA1 - eA2) * 10 <= eA1 && iabs(eB1 - eB2) * 10 <= eB1) { agree = 1; }
    } else {
        if(eA2 > 0 && eB2 > 0 && eA1 * 10 > eA2 * 11 && eB1 * 10 > eB2 * 11) { agree = 1; }
    }
    t_put64(ev, 8, agree as i64);
    let strong:i32 = 0;
    let mratio:i64 = 0;
    if(hh == 0) {
        if(eA1 > 0 && eB1 > 0) {
            let rA:i64 = iabs(eA1 - eA2) * 100 / eA1;
            let rB:i64 = iabs(eB1 - eB2) * 100 / eB1;
            mratio = rA;
            if(rB > rA) { mratio = rB; }
            if(mratio <= 5) { strong = 1; }
        }
    } else {
        if(eA2 > 0 && eB2 > 0) {
            let rA:i64 = eA1 * 100 / eA2;
            let rB:i64 = eB1 * 100 / eB2;
            mratio = rA;
            if(rB < rA) { mratio = rB; }
            if(mratio >= 125) { strong = 1; }
        }
    }
    t_put64(ev, 16, strong as i64);
    t_put64(ev, 24, mratio);
    t_put64(ev, 32, hh);
    if(agree == 1 && strong == 1) { return 1; }
    return 0;
}

// ---- G5 timbredisc: 4-window averaged centroid (gcheck uses 1 window) ----
fn g5_timbre(gbuf:[]u8, gn:i32, f0:i64, hh:i64, sr:i64, ev:[]u8) i32 {
    let cnt:i64 = t_get32(gbuf, 4);
    if(t_get32(gbuf, 0) != sr) { return 0; }
    if(cnt != 32000) { return 0; }
    if(8 + cnt * 2 > gn as i64) { return 0; }
    if(f0 <= 0) { return 0; }
    let opc:[]u8 = nio_alloc(8);
    t_put64(opc, 0, 0);
    let r1:i64 = spec_centroid_h2(gbuf, 8, 2048, sr, f0, opc);
    let r2:i64 = spec_centroid_h2(gbuf, 8 + 16000, 2048, sr, f0, opc);
    let r3:i64 = spec_centroid_h2(gbuf, 8 + 32000, 2048, sr, f0, opc);
    let r4:i64 = spec_centroid_h2(gbuf, 8 + 48000, 2048, sr, f0, opc);
    nio_free(opc);
    let t1:i32 = 0;
    if(r1 > 0 && r2 > 0 && r3 > 0 && r4 > 0) { t1 = 1; }
    t_put64(ev, 0, t1 as i64);
    if(t1 == 0) { return 0; }
    let r:i64 = (r1 + r2 + r3 + r4) / 4;
    t_put64(ev, 24, r);
    let cls:i64 = timbre_class(r);
    t_put64(ev, 32, cls);
    let agree:i32 = 0;
    if(cls == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    let mrg:i64 = timbre_margin(r, cls);
    let strong:i32 = 0;
    if(mrg >= 80) { strong = 1; }
    t_put64(ev, 16, strong as i64);
    if(agree == 1 && strong == 1) { return 1; }
    return 0;
}

// ---- G5 motiondir: denser profile_motion (step 8 vs 16) ----
fn g5_motion(gbuf:[]u8, gn:i32, hh:i64, ev:[]u8) i32 {
    if(t_get32(gbuf, 0) != 8 || t_get32(gbuf, 4) != 64 || t_get32(gbuf, 8) != 64) { return 0; }
    if(12 + 8 * 12288 > gn as i64) { return 0; }
    let dg:[]u8 = nio_alloc(40);
    if(dg.len == 0) { return 0; }
    // note: profile_motion takes (buf,row_step,row_off,col_step,col_off,f1,f2,op,dout)
    // op not needed for the verdict; pass a dummy
    let opd:[]u8 = nio_alloc(8);
    t_put64(opd, 0, 0);
    profile_motion(gbuf, 8, 0, 8, 0, 0, 7, opd, dg);
    nio_free(opd);
    let have:i64 = t_get64(dg, 24);
    let dir:i64 = t_get64(dg, 16);
    let mag:i64 = t_get64(dg, 32);
    nio_free(dg);
    t_put64(ev, 0, have);
    if(have == 0) { return 0; }
    t_put64(ev, 24, mag);
    t_put64(ev, 32, dir);
    let agree:i32 = 0;
    if(dir == hh) { agree = 1; }
    t_put64(ev, 8, agree as i64);
    let strong:i32 = 0;
    if(hh == 0) {
        if(mag <= 1) { strong = 1; }
    } else {
        if(mag >= 5) { strong = 1; }
    }
    t_put64(ev, 16, strong as i64);
    if(agree == 1 && strong == 1) { return 1; }
    return 0;
}

// ================= main ====================================================
fn main() i32 {
    let task:[]u8 = _zag_arg(1);
    let path:[]u8 = _zag_arg(2);
    let jc:[]u8 = _zag_arg(3);
    let cf:[]u8 = _zag_arg(4);
    let fa:[]u8 = _zag_arg(5);
    let fb:[]u8 = _zag_arg(6);
    if(task.len == 0 || path.len == 0) {
        nio_write_all(1, "result=ABSTAIN|reason=usage\n");
        return 1;
    }
    let jcode:i64 = atoi(jc, jc.len);
    let fA:i64 = atoi(fa, fa.len);
    let fB:i64 = atoi(fb, fb.len);
    let buf:[]u8 = nio_alloc(8388608);
    if(buf.len == 0) {
        nio_write_all(1, "result=ABSTAIN|reason=no-memory\n");
        return 1;
    }
    let n:i64 = z_read(path, buf, 8388608);
    if(n < 0) {
        nio_free(buf);
        nio_write_all(1, "result=ABSTAIN|reason=bad-read\n");
        return 1;
    }
    // R24A split: G = disjoint holdout span. No G -> ABSTAIN.
    let gbuf:[]u8 = buf[0..0];
    let gn:i32 = 0;
    if(n >= 8 && t_get32(buf, 0) == 1093939794) {
        let flen:i64 = r24_flen(buf, n);
        if(flen > 0 && 8 + flen < n) {
            gbuf = buf[(8 + flen) as i32..n as i32];
            gn = (n - 8 - flen) as i32;
        }
    }
    let ev:[]u8 = nio_alloc(64);
    t_put64(ev, 0, 0);
    t_put64(ev, 8, 0);
    t_put64(ev, 16, 0);
    t_put64(ev, 24, 0);
    t_put64(ev, 32, 0);
    let lut:[]u8 = nio_alloc(2048);
    lut_init(lut);
    let pass:i32 = 0;
    if(_zag_strcmp(task, "colordisc") == 1) { pass = g5_colordisc(gbuf, gn, jcode, lut, ev); }
    if(_zag_strcmp(task, "colorconst") == 1) { pass = g5_colorconst(gbuf, gn, jcode, ev); }
    if(_zag_strcmp(task, "shapetrans") == 1) { pass = g5_shape(gbuf, gn, jcode, ev); }
    if(_zag_strcmp(task, "pitchdisc") == 1) {
        let sr:i64 = 0;
        if(gn >= 8) { sr = t_get32(gbuf, 0); }
        pass = g5_pitch(gbuf, gn, fA, fB, jcode, sr, ev);
    }
    if(_zag_strcmp(task, "timbredisc") == 1) {
        let sr:i64 = 0;
        if(gn >= 8) { sr = t_get32(gbuf, 0); }
        // f0 for centroid: use fA (=f0 estimate from F)
        pass = g5_timbre(gbuf, gn, fA, jcode, sr, ev);
    }
    if(_zag_strcmp(task, "motiondir") == 1) { pass = g5_motion(gbuf, gn, jcode, ev); }
    nio_free(lut);
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    if(pass == 1) {
        pos = ob_add(ob, pos, "result=PASS|label=");
        pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(ev, 32)));
        pos = ob_add(ob, pos, "|mval=");
        pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(ev, 24)));
        pos = ob_add(ob, pos, "\n");
    } else {
        pos = ob_add(ob, pos, "result=ABSTAIN|mval=");
        pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(ev, 24)));
        pos = ob_add(ob, pos, "\n");
    }
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    nio_free(ev);
    nio_free(buf);
    return 0;
}

fn r24_flen(buf:[]u8, n:i64) i64 {
    let tc:i64 = t_get32(buf, 4);
    if(tc == 0 || tc == 1 || tc == 2) {
        let w:i64 = t_get32(buf, 8);
        let h:i64 = t_get32(buf, 12);
        if(w <= 0 || h <= 0 || w > 1024 || h > 1024) { return -1; }
        return 8 + w * h * 3;
    }
    if(tc == 3 || tc == 4) {
        let cnt:i64 = t_get32(buf, 12);
        if(cnt <= 0 || cnt > 2000000) { return -1; }
        return 8 + cnt * 2;
    }
    if(tc == 5) {
        let nf:i64 = t_get32(buf, 8);
        let w:i64 = t_get32(buf, 12);
        let h:i64 = t_get32(buf, 16);
        if(nf <= 0 || nf > 64 || w <= 0 || h <= 0 || w > 512 || h > 512) { return -1; }
        return 12 + nf * w * h * 3;
    }
    return -1;
}

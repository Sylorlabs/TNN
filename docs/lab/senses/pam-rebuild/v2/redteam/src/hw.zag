@import("R33_NATIVE_SHA256_V2.zag")

fn hw_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}

fn hw_write(root:i64, name:[]u8, data:[]u8) i32 {
    let fd:i64 = nio_open_child(root, name, 1);
    if(fd < 0) { return -1; }
    let rc:i64 = nio_write_all(fd, data);
    nio_close(fd);
    if(rc < 0) { return -2; }
    return 0;
}

fn main(argc:i32, argv:[]u8) i32 {
    let dir:[]u8 = _zag_arg(1);
    let root:i64 = nio_open_root(dir);
    if(root < 0) { _zag_print("ERR root\n"); return 1; }
    let msg:[]u8 = nio_alloc(64);
    hw_put32(msg, 0, 0x48454C4C);
    hw_put32(msg, 4, 0x4F0A0000);
    let nm:[]u8 = "hello_rt.txt";
    if(hw_write(root, nm, msg[0..9]) != 0) { _zag_print("ERR write\n"); return 2; }
    let h:[]u8 = nio_alloc(32);
    if(ns_sha256(msg[0..9], h) != 0) { _zag_print("ERR sha\n"); return 3; }
    _zag_print("OK\n");
    nio_close(root);
    return 0;
}

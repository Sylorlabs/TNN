// rt_score.zag — RED-TEAM gate-output scorer (pure Zag, zero RNG).
//
// Joins gate records with gate stdout dispositions and scores per family:
//
//   rt_score <records> <gate_stdout> <out_prefix>
//
// Gate stdout lines (from vgate_a/vgate_d):
//   seq|tcode|fixture|disposition|detail|truth
// disposition in {PROVISIONAL_INSTALL, PERMANENT_INSTALL, REVISE_INSTALL,
//                 CONFLICT_WITHHELD, WITHHELD, SUPPRESSED}.
// Records (13 fields):
//   seq|tcode|fixture|prog|jcode|judgment|confidence|pred|measure|phash|truth|jG|confG
//
// Writes <out_prefix>.score ; stdout: sha256 hex of the score bytes.
// Per family: n, judgment accuracy, installs, correct installs, false
// installs, withholds, suppressions, revise installs. Truth comes from the
// records (the sealed .truth labels), never from the gate.
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn z_write_open(path:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 384, 0, 0, 0);
    nio_free(s);
    return fd;
}
fn z_write_all(path:[]u8, data:[]u8) i32 {
    let fd:i64 = z_write_open(path);
    if(fd < 0) { return -1; }
    let rc:i64 = nio_write_all(fd, data);
    nio_close(fd);
    if(rc != data.len as i64) { return -2; }
    return 0;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn put_i64(ob:[]u8, pos:i32, v:i64) i32 {
    let s:[]u8 = _zag_i64_to_str(v);
    pos = ob_add(ob, pos, s);
    nio_free(s);
    return pos;
}
fn pstr(s:[]u8) void {
    nio_write_all(1, s);
    return;
}
fn perr(s:[]u8) i32 {
    nio_write_all(2, s);
    return 1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}
// split line into fields by '|'; returns nfields (<=24).
fn split(line:[]u8, n:i32, fs:[]u8, fl:[]u8) i32 {
    let nf2:i32 = 0;
    let s:i32 = 0;
    let i:i32 = 0;
    while(i <= n && nf2 < 24) {
        if(i == n || line[i] == 124) {
            fs[nf2] = s;
            fl[nf2] = i - s;
            nf2 = nf2 + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    return nf2;
}
fn jcode_of(tc:i64, j:[]u8, jl:i32) i64 {
    let s:[]u8 = j[0..jl];
    if(tc == 0) {
        if(_zag_strcmp(s, "SAME") == 1) { return 0; }
        if(_zag_strcmp(s, "DIFFERENT") == 1) { return 1; }
        return -1;
    }
    if(tc == 1) {
        if(_zag_strcmp(s, "SAME_SURFACE") == 1) { return 0; }
        if(_zag_strcmp(s, "DIFFERENT") == 1) { return 1; }
        return -1;
    }
    if(tc == 2) {
        if(_zag_strcmp(s, "SQUARE") == 1) { return 0; }
        if(_zag_strcmp(s, "TRIANGLE") == 1) { return 1; }
        if(_zag_strcmp(s, "CIRCLE") == 1) { return 2; }
        return -1;
    }
    if(tc == 3) {
        if(_zag_strcmp(s, "SAME") == 1) { return 0; }
        if(_zag_strcmp(s, "HIGHER") == 1) { return 1; }
        if(_zag_strcmp(s, "LOWER") == 1) { return 2; }
        return -1;
    }
    if(tc == 4) {
        if(_zag_strcmp(s, "PURE") == 1) { return 0; }
        if(_zag_strcmp(s, "DARK") == 1) { return 1; }
        if(_zag_strcmp(s, "RICH") == 1) { return 2; }
        if(_zag_strcmp(s, "BRIGHT") == 1) { return 3; }
        return -1;
    }
    if(_zag_strcmp(s, "STILL") == 1) { return 0; }
    if(_zag_strcmp(s, "N") == 1) { return 1; }
    if(_zag_strcmp(s, "NE") == 1) { return 2; }
    if(_zag_strcmp(s, "E") == 1) { return 3; }
    if(_zag_strcmp(s, "SE") == 1) { return 4; }
    if(_zag_strcmp(s, "S") == 1) { return 5; }
    if(_zag_strcmp(s, "SW") == 1) { return 6; }
    if(_zag_strcmp(s, "W") == 1) { return 7; }
    if(_zag_strcmp(s, "NW") == 1) { return 8; }
    return -1;
}
// fixture rt4_<FAM>_NNNN.r24 -> family id 0..11 from FAM.
fn fam_id_of(fx:[]u8, fl:i32) i32 {
    let u:i32 = 4;
    while(u < fl && fx[u] != 95) { u = u + 1; }
    let fs:[]u8 = fx[4..u];
    if(_zag_strcmp(fs, "PTC-4") == 1) { return 0; }
    if(_zag_strcmp(fs, "PTC-5") == 1) { return 1; }
    if(_zag_strcmp(fs, "TMB-4") == 1) { return 2; }
    if(_zag_strcmp(fs, "TMB-5") == 1) { return 3; }
    if(_zag_strcmp(fs, "COL-4") == 1) { return 4; }
    if(_zag_strcmp(fs, "COL-5") == 1) { return 5; }
    if(_zag_strcmp(fs, "CCN-3") == 1) { return 6; }
    if(_zag_strcmp(fs, "CCN-4") == 1) { return 7; }
    if(_zag_strcmp(fs, "SHP-4") == 1) { return 8; }
    if(_zag_strcmp(fs, "SHP-5") == 1) { return 9; }
    if(_zag_strcmp(fs, "MOT-4") == 1) { return 10; }
    if(_zag_strcmp(fs, "MOT-5") == 1) { return 11; }
    return -1;
}
fn fam_name(fid:i32, out:[]u8) i32 {
    let w:[]u8 = "UNK";
    if(fid == 0) { w = "PTC-4"; }
    if(fid == 1) { w = "PTC-5"; }
    if(fid == 2) { w = "TMB-4"; }
    if(fid == 3) { w = "TMB-5"; }
    if(fid == 4) { w = "COL-4"; }
    if(fid == 5) { w = "COL-5"; }
    if(fid == 6) { w = "CCN-3"; }
    if(fid == 7) { w = "CCN-4"; }
    if(fid == 8) { w = "SHP-4"; }
    if(fid == 9) { w = "SHP-5"; }
    if(fid == 10) { w = "MOT-4"; }
    if(fid == 11) { w = "MOT-5"; }
    let i:i32 = 0;
    while(i < w.len) { out[i] = w[i]; i = i + 1; }
    return w.len;
}
// add delta to 8-byte LE counter C[idx]
fn cadd(C:[]u8, idx:i32, delta:i64) void {
    let old:i64 = 0;
    let o:i32 = 0;
    while(o < 8) { old = old | ((C[idx * 8 + o] as i64) << (o * 8)); o = o + 1; }
    let nv:i64 = old + delta;
    o = 0;
    while(o < 8) { C[idx * 8 + o] = ((nv >> (o * 8)) & 255) as u8; o = o + 1; }
    return;
}
// disposition string -> class:
// 0 install, 1 withhold, 2 suppress, 3 revise_install,
// 4 corroborated, 5 negative_evidence, -1 unknown
fn disp_class(d:[]u8, dl:i32) i64 {
    let s:[]u8 = d[0..dl];
    if(_zag_strcmp(s, "PROVISIONAL_INSTALL") == 1) { return 0; }
    if(_zag_strcmp(s, "PERMANENT_INSTALL") == 1) { return 0; }
    if(_zag_strcmp(s, "ACCEPT_INSTALL") == 1) { return 0; }
    if(_zag_strcmp(s, "REVISE_INSTALL") == 1) { return 3; }
    if(_zag_strcmp(s, "WITHHELD") == 1) { return 1; }
    if(_zag_strcmp(s, "CONFLICT_WITHHELD") == 1) { return 1; }
    if(_zag_strcmp(s, "SUPPRESSED") == 1) { return 2; }
    if(_zag_strcmp(s, "CORROBORATED") == 1) { return 4; }
    if(_zag_strcmp(s, "NEGATIVE_EVIDENCE") == 1) { return 5; }
    return -1;
}

fn main() i32 {
    let rpath:[]u8 = _zag_arg(1);
    let gpath:[]u8 = _zag_arg(2);
    let opre:[]u8 = _zag_arg(3);
    if(rpath.len == 0 || gpath.len == 0 || opre.len == 0) {
        return perr("usage: rt_score <records> <gate_stdout> <out_prefix>\n");
    }
    let rb:[]u8 = nio_alloc(4194304);
    let rn:i64 = z_read(rpath, rb, 4194304);
    if(rn < 0) { return perr("ERR records\n"); }
    let gb:[]u8 = nio_alloc(4194304);
    let gn:i64 = z_read(gpath, gb, 4194304);
    if(gn < 0) { return perr("ERR gateout\n"); }
    // per-seq record fields: fid, tc, jc, truth_jc
    let R:[]u8 = nio_alloc(4096 * 4 * 8);
    let zi:i32 = 0;
    while(zi < 4096 * 4 * 8) { R[zi] = 255; zi = zi + 1; }
    // per-seq disposition class
    let D:[]u8 = nio_alloc(4096 * 8);
    zi = 0;
    while(zi < 4096 * 8) { D[zi] = 255; zi = zi + 1; }
    let fs:[]u8 = nio_alloc(24 * 8);
    let fl:[]u8 = nio_alloc(24 * 8);
    // parse records: seq|tcode|fixture|prog|jcode|judgment|confidence|pred|measure|phash|truth|jG|confG
    let nrec:i64 = 0;
    let p:i64 = 0;
    while(p < rn) {
        let le:i64 = p;
        while(le < rn && rb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 10) {
            let line:[]u8 = rb[p as i32 .. le as i32];
            let nf2:i32 = split(line, llen, fs, fl);
            if(nf2 == 13) {
                let sq:i64 = atoi(line[fs[0]..fs[0] + fl[0]], fl[0]);
                let tc:i64 = atoi(line[fs[1]..fs[1] + fl[1]], fl[1]);
                let fx:[]u8 = line[fs[2]..fs[2] + fl[2]];
                let jc:i64 = atoi(line[fs[4]..fs[4] + fl[4]], fl[4]);
                let tru:[]u8 = line[fs[10]..fs[10] + fl[10]];
                let fid:i32 = fam_id_of(fx, fl[2]);
                if(fid < 0) { return perr("ERR fam\n"); }
                let tjc:i64 = jcode_of(tc, tru, fl[10]);
                if(tjc < 0) { return perr("ERR tjc\n"); }
                if(sq < 0 || sq >= 4096) { return perr("ERR seq\n"); }
                let vals:[]u8 = nio_alloc(32);
                let o:i32 = 0;
                while(o < 8) { vals[o] = (((fid as i64) >> (o * 8)) & 255) as u8; o = o + 1; }
                o = 0;
                while(o < 8) { vals[8 + o] = ((tc >> (o * 8)) & 255) as u8; o = o + 1; }
                o = 0;
                while(o < 8) { vals[16 + o] = ((jc >> (o * 8)) & 255) as u8; o = o + 1; }
                o = 0;
                while(o < 8) { vals[24 + o] = ((tjc >> (o * 8)) & 255) as u8; o = o + 1; }
                o = 0;
                while(o < 32) { R[sq as i32 * 32 + o] = vals[o]; o = o + 1; }
                nio_free(vals);
                nrec = nrec + 1;
            }
        }
        p = le + 1;
    }
    // parse gate stdout: seq|tcode|fixture|disposition|detail|truth
    let ngate:i64 = 0;
    p = 0;
    while(p < gn) {
        let le:i64 = p;
        while(le < gn && gb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 6) {
            let line:[]u8 = gb[p as i32 .. le as i32];
            let nf2:i32 = split(line, llen, fs, fl);
            if(nf2 == 6) {
                let sq:i64 = atoi(line[fs[0]..fs[0] + fl[0]], fl[0]);
                let dc:i64 = disp_class(line[fs[3]..fs[3] + fl[3]], fl[3]);
                if(dc < 0) { return perr("ERR disp\n"); }
                if(sq < 0 || sq >= 4096) { return perr("ERR gseq\n"); }
                let o:i32 = 0;
                while(o < 8) { D[sq as i32 * 8 + o] = ((dc >> (o * 8)) & 255) as u8; o = o + 1; }
                ngate = ngate + 1;
            }
        }
        p = le + 1;
    }
    if(nrec != ngate) { return perr("ERR count mismatch\n"); }
    // counters: 12 fams x 10 (n, acc, inst, cinst, finst, with, supp, rev, cor, neg)
    let C:[]u8 = nio_alloc(12 * 10 * 8);
    zi = 0;
    while(zi < 12 * 10 * 8) { C[zi] = 0; zi = zi + 1; }
    let tot_n:i64 = 0;
    let tot_acc:i64 = 0;
    let tot_inst:i64 = 0;
    let tot_ci:i64 = 0;
    let tot_fi:i64 = 0;
    let tot_w:i64 = 0;
    let tot_s:i64 = 0;
    let tot_rev:i64 = 0;
    let tot_cor:i64 = 0;
    let tot_neg:i64 = 0;
    let s:i64 = 0;
    while(s < nrec) {
        let si:i32 = s as i32;
        let fid:i64 = 0;
        let jc:i64 = 0;
        let tjc:i64 = 0;
        let o:i32 = 0;
        while(o < 8) { fid = fid | ((R[si * 32 + o] as i64) << (o * 8)); o = o + 1; }
        o = 0;
        while(o < 8) { jc = jc | ((R[si * 32 + 16 + o] as i64) << (o * 8)); o = o + 1; }
        o = 0;
        while(o < 8) { tjc = tjc | ((R[si * 32 + 24 + o] as i64) << (o * 8)); o = o + 1; }
        if(fid < 0 || fid > 11) { return perr("ERR rfid\n"); }
        let dc:i64 = 0;
        o = 0;
        while(o < 8) { dc = dc | ((D[si * 8 + o] as i64) << (o * 8)); o = o + 1; }
        if(dc < 0 || dc > 5) { return perr("ERR dcls\n"); }
        let correct:i64 = 0;
        if(jc == tjc) { correct = 1; }
        let inst:i64 = 0;
        let rev:i64 = 0;
        let w:i64 = 0;
        let sp:i64 = 0;
        let cor:i64 = 0;
        let neg:i64 = 0;
        if(dc == 0) { inst = 1; }
        if(dc == 3) { inst = 1; rev = 1; }
        if(dc == 1) { w = 1; }
        if(dc == 2) { sp = 1; }
        if(dc == 4) { cor = 1; }
        if(dc == 5) { neg = 1; }
        let ci:i64 = 0;
        let fi2:i64 = 0;
        if(inst == 1 && correct == 1) { ci = 1; }
        if(inst == 1 && correct == 0) { fi2 = 1; }
        cadd(C, fid as i32 * 10 + 0, 1);
        cadd(C, fid as i32 * 10 + 1, correct);
        cadd(C, fid as i32 * 10 + 2, inst);
        cadd(C, fid as i32 * 10 + 3, ci);
        cadd(C, fid as i32 * 10 + 4, fi2);
        cadd(C, fid as i32 * 10 + 5, w);
        cadd(C, fid as i32 * 10 + 6, sp);
        cadd(C, fid as i32 * 10 + 7, rev);
        cadd(C, fid as i32 * 10 + 8, cor);
        cadd(C, fid as i32 * 10 + 9, neg);
        tot_n = tot_n + 1;
        tot_acc = tot_acc + correct;
        tot_inst = tot_inst + inst;
        tot_ci = tot_ci + ci;
        tot_fi = tot_fi + fi2;
        tot_w = tot_w + w;
        tot_s = tot_s + sp;
        tot_rev = tot_rev + rev;
        tot_cor = tot_cor + cor;
        tot_neg = tot_neg + neg;
        s = s + 1;
    }
    // emit score text
    let ob:[]u8 = nio_alloc(65536);
    let opos:i32 = 0;
    opos = ob_add(ob, opos, "total n=");
    opos = put_i64(ob, opos, tot_n);
    opos = ob_add(ob, opos, " judgment_acc=");
    opos = put_i64(ob, opos, tot_acc);
    opos = ob_add(ob, opos, " installs=");
    opos = put_i64(ob, opos, tot_inst);
    opos = ob_add(ob, opos, " correct_installs=");
    opos = put_i64(ob, opos, tot_ci);
    opos = ob_add(ob, opos, " false_installs=");
    opos = put_i64(ob, opos, tot_fi);
    opos = ob_add(ob, opos, " withholds=");
    opos = put_i64(ob, opos, tot_w);
    opos = ob_add(ob, opos, " suppressions=");
    opos = put_i64(ob, opos, tot_s);
    opos = ob_add(ob, opos, " revise_installs=");
    opos = put_i64(ob, opos, tot_rev);
    opos = ob_add(ob, opos, " corroborations=");
    opos = put_i64(ob, opos, tot_cor);
    opos = ob_add(ob, opos, " negative_evidence=");
    opos = put_i64(ob, opos, tot_neg);
    opos = ob_add(ob, opos, "\n");
    let keys:[]u8 = " n= judgment_acc= installs= correct_installs= false_installs= withholds= suppressions= revise_installs= corroborations= negative_evidence=";
    let f:i32 = 0;
    while(f < 12) {
        let nm:[]u8 = nio_alloc(16);
        let nml:i32 = fam_name(f, nm);
        opos = ob_add(ob, opos, "fam ");
        opos = ob_add(ob, opos, nm[0..nml]);
        nio_free(nm);
        let c2:i32 = 0;
        while(c2 < 10) {
            let ks:i64 = kspan(c2);
            let kst:i32 = (ks / 1024) as i32;
            let ken:i32 = (ks % 1024) as i32;
            opos = ob_add(ob, opos, keys[kst..ken]);
            let v:i64 = 0;
            let o:i32 = 0;
            while(o < 8) { v = v | ((C[(f * 10 + c2) * 8 + o] as i64) << (o * 8)); o = o + 1; }
            opos = put_i64(ob, opos, v);
            c2 = c2 + 1;
        }
        opos = ob_add(ob, opos, "\n");
        f = f + 1;
    }
    let op:[]u8 = nio_alloc(4096);
    let opl:i32 = ob_add(op, 0, opre);
    opl = ob_add(op, opl, ".score");
    let wrc:i32 = z_write_all(op[0..opl], ob[0..opos]);
    nio_free(op);
    if(wrc != 0) { return perr("ERR score write\n"); }
    let hb:[]u8 = nio_alloc(32);
    if(ns_sha256(ob[0..opos], hb) != 0) { return perr("ERR sha\n"); }
    let hx:[]u8 = ns_hex(hb);
    let out:[]u8 = nio_alloc(66);
    let o:i32 = 0;
    while(o < 64) { out[o] = hx[o]; o = o + 1; }
    out[64] = 10;
    pstr(out[0..65]);
    return 0;
}
// key span table: index -> (start,end) packed start*1024+end
fn kspan(c:i32) i64 {
    if(c == 0) { return 3; }
    if(c == 1) { return 3 * 1024 + 17; }
    if(c == 2) { return 17 * 1024 + 27; }
    if(c == 3) { return 27 * 1024 + 45; }
    if(c == 4) { return 45 * 1024 + 61; }
    if(c == 5) { return 61 * 1024 + 72; }
    if(c == 6) { return 72 * 1024 + 86; }
    if(c == 7) { return 86 * 1024 + 103; }
    if(c == 8) { return 103 * 1024 + 119; }
    return 119 * 1024 + 138;
}

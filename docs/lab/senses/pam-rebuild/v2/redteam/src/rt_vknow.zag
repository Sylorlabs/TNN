// rt_vknow.zag — RED-TEAM V2-C detector sweep (pure Zag, zero RNG).
//
// Runs V2-C's trap-signature detectors (vknow.zag) over all 288 sealed
// fixtures and reports per-family fire counts. vknow_check returns a
// bitmask: bit0 K-CCN-1, bit1 K-CCN-2, bit2 K-PTC-1, bit3 K-SHP-1,
// bit4 K-TMB-1. (K-PTC-1 and K-TMB-1 are placeholders returning 0 in the
// landed vknow.zag; only K-CCN-1/K-CCN-2/K-SHP-1 can fire.)
//
// Build from the V2-C src dir so @import("vknow.zag") resolves:
//   cd <forks>/V2-C/src && znc <redteam>/src/rt_vknow.zag -o /tmp/.../rt_vknow
//
// Usage: rt_vknow <sealed_dir>
// stdout: per-family fire table, then sha256 hex of the full per-fixture
// fire list ("<fixture> <fires>\n" lines, manifest order).
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64)<<8) | ((b[at+2] as i64)<<16) | ((b[at+3] as i64)<<24);
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at]=(v&255) as u8; b[at+1]=((v>>8)&255) as u8; b[at+2]=((v>>16)&255) as u8; b[at+3]=((v>>24)&255) as u8;
}
@import("vknow.zag")

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn put_i64(ob:[]u8, pos:i32, v:i64) i32 {
    let s:[]u8 = _zag_i64_to_str(v);
    pos = ob_add(ob, pos, s);
    nio_free(s);
    return pos;
}
fn pstr(s:[]u8) void {
    nio_write_all(1, s);
    return;
}
fn perr(s:[]u8) i32 {
    nio_write_all(2, s);
    return 1;
}
fn join_path(out:[]u8, dir:[]u8, name:[]u8) i32 {
    let p:i32 = 0;
    p = ob_add(out, p, dir);
    p = ob_add(out, p, "/");
    p = ob_add(out, p, name);
    return p;
}
fn fam_id(f:[]u8) i32 {
    if(_zag_strcmp(f, "PTC-4") == 1) { return 0; }
    if(_zag_strcmp(f, "PTC-5") == 1) { return 1; }
    if(_zag_strcmp(f, "TMB-4") == 1) { return 2; }
    if(_zag_strcmp(f, "TMB-5") == 1) { return 3; }
    if(_zag_strcmp(f, "COL-4") == 1) { return 4; }
    if(_zag_strcmp(f, "COL-5") == 1) { return 5; }
    if(_zag_strcmp(f, "CCN-3") == 1) { return 6; }
    if(_zag_strcmp(f, "CCN-4") == 1) { return 7; }
    if(_zag_strcmp(f, "SHP-4") == 1) { return 8; }
    if(_zag_strcmp(f, "SHP-5") == 1) { return 9; }
    if(_zag_strcmp(f, "MOT-4") == 1) { return 10; }
    if(_zag_strcmp(f, "MOT-5") == 1) { return 11; }
    return -1;
}
fn tcode_of(fid:i32) i32 {
    if(fid == 0 || fid == 1) { return 3; }
    if(fid == 2 || fid == 3) { return 4; }
    if(fid == 4 || fid == 5) { return 0; }
    if(fid == 6 || fid == 7) { return 1; }
    if(fid == 8 || fid == 9) { return 2; }
    return 5;
}
fn fam_name(fid:i32, out:[]u8) i32 {
    let w:[]u8 = "UNK";
    if(fid == 0) { w = "PTC-4"; }
    if(fid == 1) { w = "PTC-5"; }
    if(fid == 2) { w = "TMB-4"; }
    if(fid == 3) { w = "TMB-5"; }
    if(fid == 4) { w = "COL-4"; }
    if(fid == 5) { w = "COL-5"; }
    if(fid == 6) { w = "CCN-3"; }
    if(fid == 7) { w = "CCN-4"; }
    if(fid == 8) { w = "SHP-4"; }
    if(fid == 9) { w = "SHP-5"; }
    if(fid == 10) { w = "MOT-4"; }
    if(fid == 11) { w = "MOT-5"; }
    let i:i32 = 0;
    while(i < w.len) { out[i] = w[i]; i = i + 1; }
    return w.len;
}
fn ends_with(s:[]u8, n:i32, suf:[]u8) i32 {
    if(n < suf.len) { return 0; }
    let i:i32 = 0;
    while(i < suf.len) {
        if(s[n - suf.len + i] != suf[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() i32 {
    let sdir:[]u8 = _zag_arg(1);
    if(sdir.len == 0) { return perr("usage: rt_vknow <sealed_dir>\n"); }
    let mp:[]u8 = nio_alloc(4096);
    let mpl:i32 = join_path(mp, sdir, "MANIFEST.sha256");
    let mb:[]u8 = nio_alloc(131072);
    let mn:i64 = z_read(mp[0..mpl], mb, 131072);
    nio_free(mp);
    if(mn < 0) { return perr("ERR manifest\n"); }
    let fb:[]u8 = nio_alloc(1048576);
    let out:[]u8 = nio_alloc(65536);
    let opos:i32 = 0;
    // per-family fire counters: 12 x 6 (n, bit0..bit4)
    let C:[]u8 = nio_alloc(12 * 6 * 8);
    let zi:i32 = 0;
    while(zi < 12 * 6 * 8) { C[zi] = 0; zi = zi + 1; }
    let nfx:i32 = 0;
    let p:i64 = 0;
    while(p < mn) {
        let le:i64 = p;
        while(le < mn && mb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 68) {
            let nl2:i32 = llen - 66;
            let nm:[]u8 = mb[(p + 66) as i32 .. (p + 66 + nl2 as i64) as i32];
            if(ends_with(nm, nl2, ".truth") == 0 && nl2 > 12 && nm[0] == 114) {
                let u:i32 = 4;
                while(u < nl2 && nm[u] != 95) { u = u + 1; }
                let fi:i32 = fam_id(nm[4..u]);
                if(fi < 0) { return perr("ERR fam\n"); }
                let fp:[]u8 = nio_alloc(4096);
                let fpl:i32 = join_path(fp, sdir, nm);
                let fn2:i64 = z_read(fp[0..fpl], fb, 1048576);
                nio_free(fp);
                if(fn2 < 16) { return perr("ERR fixture\n"); }
                let fires:i32 = vknow_check(tcode_of(fi), fb, fn2 as i32, 0);
                // record line
                opos = ob_add(out, opos, nm);
                opos = ob_add(out, opos, " ");
                opos = put_i64(out, opos, fires as i64);
                opos = ob_add(out, opos, "\n");
                // counters
                let b:i32 = 0;
                while(b < 6) {
                    let delta:i64 = 0;
                    if(b == 0) { delta = 1; }
                    if(b >= 1 && (fires & (1 << (b - 1))) != 0) { delta = 1; }
                    let idx:i32 = fi * 6 + b;
                    let old:i64 = 0;
                    let o:i32 = 0;
                    while(o < 8) { old = old | ((C[idx * 8 + o] as i64) << (o * 8)); o = o + 1; }
                    let nv:i64 = old + delta;
                    o = 0;
                    while(o < 8) { C[idx * 8 + o] = ((nv >> (o * 8)) & 255) as u8; o = o + 1; }
                    b = b + 1;
                }
                nfx = nfx + 1;
            }
        }
        p = le + 1;
    }
    if(nfx != 288) { return perr("ERR count\n"); }
    // digest of per-fixture list
    let hb:[]u8 = nio_alloc(32);
    // print table to stderr, digest of list to stdout? No: table stdout, then digest.
    // Simpler: emit table lines first, then "digest=<hex>" line. Digest covers
    // only the per-fixture list (first nfx lines); recompute by hashing out[0..opos].
    if(ns_sha256(out[0..opos], hb) != 0) { return perr("ERR sha\n"); }
    let hx:[]u8 = ns_hex(hb);
    let tb:[]u8 = nio_alloc(4096);
    let tp:i32 = 0;
    let f:i32 = 0;
    while(f < 12) {
        let nm2:[]u8 = nio_alloc(16);
        let nml:i32 = fam_name(f, nm2);
        tp = ob_add(tb, tp, "vknow ");
        tp = ob_add(tb, tp, nm2[0..nml]);
        nio_free(nm2);
        let b:i32 = 0;
        while(b < 6) {
            let v:i64 = 0;
            let o:i32 = 0;
            while(o < 8) { v = v | ((C[(f * 6 + b) * 8 + o] as i64) << (o * 8)); o = o + 1; }
            if(b == 0) { tp = ob_add(tb, tp, " n="); }
            if(b == 1) { tp = ob_add(tb, tp, " kccn1="); }
            if(b == 2) { tp = ob_add(tb, tp, " kccn2="); }
            if(b == 3) { tp = ob_add(tb, tp, " kptc1="); }
            if(b == 4) { tp = ob_add(tb, tp, " kshp1="); }
            if(b == 5) { tp = ob_add(tb, tp, " ktmb1="); }
            tp = put_i64(tb, tp, v);
            b = b + 1;
        }
        tp = ob_add(tb, tp, "\n");
        f = f + 1;
    }
    tp = ob_add(tb, tp, "vknow_list_sha256=");
    tp = ob_add(tb, tp, hx);
    tp = ob_add(tb, tp, "\n");
    pstr(tb[0..tp]);
    return 0;
}

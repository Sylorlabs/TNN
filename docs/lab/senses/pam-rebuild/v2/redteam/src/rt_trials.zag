// rt_trials.zag — RED-TEAM dual-span trial generator (pure Zag, zero RNG).
//
// Builds R24A dual-span trials from the sealed novel-family fixture set:
//   trial file  rt4_<FAM>_<NNNN>.r24 : u32le magic 0x41343252, u32le tcode,
//               F payload = sealed fixture bytes, G payload = disjoint
//               holdout span (partner fixture(s), same family, same truth).
//   g-span file rt4_<FAM>_<NNNN>.g.<ext> : standalone G bytes in the frozen
//               fixture layout (for G-as-F re-judgment).
//   truth file  rt4_<FAM>_<NNNN>.r24.truth : "truth=<LABEL>\n" (F truth).
//
// Partner selection is deterministic: for fixture index i, partners are the
// smallest indices j != i (scanning i+1, i+2, ... wrapping) whose truth label
// equals truth(i). pcm families need a 32000-sample G (gcheck requires
// cnt==32000), so two partners are concatenated with a rebuilt header.
//
// Usage: rt_trials <sealed_dir> <outdir>
// stdout: sha256 hex of TRIALS.sha256 (manifest of everything written).
// Sealed families stay sealed: this tool only re-packages them; it never
// prints fixture contents or truth labels.
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn z_write_open(path:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 384, 0, 0, 0);
    nio_free(s);
    return fd;
}
fn z_write_all(path:[]u8, data:[]u8) i32 {
    let fd:i64 = z_write_open(path);
    if(fd < 0) { return -1; }
    let rc:i64 = nio_write_all(fd, data);
    nio_close(fd);
    if(rc != data.len as i64) { return -2; }
    return 0;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_addn(ob:[]u8, pos:i32, s:[]u8, n:i32) i32 {
    let i:i32 = 0;
    while(i < n && i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn w32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at + 1] = ((v >> 8) & 255) as u8;
    b[at + 2] = ((v >> 16) & 255) as u8;
    b[at + 3] = ((v >> 24) & 255) as u8;
    return;
}
fn pstr(s:[]u8) void {
    nio_write_all(1, s);
    return;
}
fn perr(s:[]u8) i32 {
    nio_write_all(2, s);
    return 1;
}
// join dir + "/" + name into out; returns length.
fn join_path(out:[]u8, dir:[]u8, name:[]u8) i32 {
    let p:i32 = 0;
    p = ob_add(out, p, dir);
    p = ob_add(out, p, "/");
    p = ob_add(out, p, name);
    return p;
}
// family code -> 0..11, or -1.
fn fam_id(f:[]u8) i32 {
    if(_zag_strcmp(f, "PTC-4") == 1) { return 0; }
    if(_zag_strcmp(f, "PTC-5") == 1) { return 1; }
    if(_zag_strcmp(f, "TMB-4") == 1) { return 2; }
    if(_zag_strcmp(f, "TMB-5") == 1) { return 3; }
    if(_zag_strcmp(f, "COL-4") == 1) { return 4; }
    if(_zag_strcmp(f, "COL-5") == 1) { return 5; }
    if(_zag_strcmp(f, "CCN-3") == 1) { return 6; }
    if(_zag_strcmp(f, "CCN-4") == 1) { return 7; }
    if(_zag_strcmp(f, "SHP-4") == 1) { return 8; }
    if(_zag_strcmp(f, "SHP-5") == 1) { return 9; }
    if(_zag_strcmp(f, "MOT-4") == 1) { return 10; }
    if(_zag_strcmp(f, "MOT-5") == 1) { return 11; }
    return -1;
}
fn tcode_of(fid:i32) i32 {
    if(fid == 0 || fid == 1) { return 3; }
    if(fid == 2 || fid == 3) { return 4; }
    if(fid == 4 || fid == 5) { return 0; }
    if(fid == 6 || fid == 7) { return 1; }
    if(fid == 8 || fid == 9) { return 2; }
    return 5;
}
// is pcm (needs 2-partner G)?
fn is_pcm(fid:i32) i32 {
    if(fid <= 3) { return 1; }
    return 0;
}
fn ends_with(s:[]u8, n:i32, suf:[]u8) i32 {
    if(n < suf.len) { return 0; }
    let i:i32 = 0;
    while(i < suf.len) {
        if(s[n - suf.len + i] != suf[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
// put u8 decimal of v (0..9999) into out at pos; returns new pos.
fn put_dec4(out:[]u8, pos:i32, v:i64) i32 {
    let d0:i64 = v / 1000;
    let d1:i64 = (v / 100) % 10;
    let d2:i64 = (v / 10) % 10;
    let d3:i64 = v % 10;
    if(pos + 4 > out.len) { return pos; }
    out[pos] = (48 + d0) as u8;
    out[pos + 1] = (48 + d1) as u8;
    out[pos + 2] = (48 + d2) as u8;
    out[pos + 3] = (48 + d3) as u8;
    return pos + 4;
}

fn main() i32 {
    let sdir:[]u8 = _zag_arg(1);
    let odir:[]u8 = _zag_arg(2);
    if(sdir.len == 0 || odir.len == 0) { return perr("usage: rt_trials <sealed_dir> <outdir>\n"); }
    // read manifest
    let mp:[]u8 = nio_alloc(4096);
    let mplen:i32 = join_path(mp, sdir, "MANIFEST.sha256");
    let mb:[]u8 = nio_alloc(131072);
    let mn:i64 = z_read(mp[0..mplen], mb, 131072);
    if(mn < 0) { return perr("ERR manifest read\n"); }
    // tables: up to 288 fixtures
    let t_fam:[]u8 = nio_alloc(288 * 8);
    let t_idx:[]u8 = nio_alloc(288 * 8);
    let t_nlen:[]u8 = nio_alloc(288 * 8);
    let t_tlen:[]u8 = nio_alloc(288 * 8);
    let names:[]u8 = nio_alloc(288 * 64);
    let truths:[]u8 = nio_alloc(288 * 32);
    let nf:i32 = 0;
    // walk manifest lines: "<hex>  <name>"
    let p:i64 = 0;
    while(p < mn) {
        let le:i64 = p;
        while(le < mn && mb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 68) {
            // name starts at offset 66 ("<64hex><2sp>")
            let nl2:i32 = llen - 66;
            if(nl2 > 0 && nl2 < 64 && ends_with(mb[p as i32 .. (p + llen as i64) as i32], llen, ".truth") == 0) {
                let nm:[]u8 = mb[(p + 66) as i32 .. (p + 66 + nl2 as i64) as i32];
                // expect rt3_<FAM>_<NNNN>.<ext>
                if(nl2 > 12 && nm[0] == 114 && nm[1] == 116 && nm[2] == 51 && nm[3] == 95) {
                    // fam = nm[4..u], u = next '_'
                    let u:i32 = 4;
                    while(u < nl2 && nm[u] != 95) { u = u + 1; }
                    let fs:[]u8 = nm[4..u];
                    let fi:i32 = fam_id(fs);
                    // idx digits at u+1..u+5
                    let ix:i64 = 0;
                    let q:i32 = u + 1;
                    while(q < u + 5 && q < nl2) {
                        ix = ix * 10 + (nm[q] as i64 - 48);
                        q = q + 1;
                    }
                    if(fi >= 0 && nf < 288) {
                        let o:i32 = 0;
                        while(o < 8) { t_fam[nf * 8 + o] = ((fi >> (o * 8)) & 255) as u8; o = o + 1; }
                        o = 0;
                        while(o < 8) { t_idx[nf * 8 + o] = ((ix >> (o * 8)) & 255) as u8; o = o + 1; }
                        o = 0;
                        while(o < 8) { t_nlen[nf * 8 + o] = ((nl2 as i64 >> (o * 8)) & 255) as u8; o = o + 1; }
                        o = 0;
                        while(o < nl2) { names[nf * 64 + o] = nm[o]; o = o + 1; }
                        // read truth sidecar
                        let tp:[]u8 = nio_alloc(4096);
                        let tpl:i32 = join_path(tp, sdir, nm);
                        tpl = ob_add(tp, tpl, ".truth");
                        let tb:[]u8 = nio_alloc(64);
                        let tn:i64 = z_read(tp[0..tpl], tb, 64);
                        nio_free(tp);
                        if(tn < 8 || tb[0] != 116) { nio_free(tb); return perr("ERR truth read\n"); }
                        // label = after "truth="
                        let tl:i32 = (tn - 6) as i32;
                        if(tb[tn as i32 - 1] == 10) { tl = tl - 1; }
                        o = 0;
                        while(o < 8) { t_tlen[nf * 8 + o] = ((tl as i64 >> (o * 8)) & 255) as u8; o = o + 1; }
                        o = 0;
                        while(o < tl && o < 32) { truths[nf * 32 + o] = tb[6 + o]; o = o + 1; }
                        nio_free(tb);
                        nf = nf + 1;
                    }
                }
            }
        }
        p = le + 1;
    }
    if(nf != 288) { return perr("ERR fixture count\n"); }
    // manifest accumulator for TRIALS.sha256
    let mf:[]u8 = nio_alloc(131072);
    let mpos:i32 = 0;
    let fbuf:[]u8 = nio_alloc(1048576);
    let gbuf:[]u8 = nio_alloc(1048576);
    let pbuf:[]u8 = nio_alloc(1048576);
    let tbuf:[]u8 = nio_alloc(1048576);
    let hb:[]u8 = nio_alloc(32);
    let hx:[]u8 = nio_alloc(65);
    let e:i32 = 0;
    while(e < nf) {
        let fi:i64 = 0;
        let o:i32 = 0;
        while(o < 8) { fi = fi | ((t_fam[e * 8 + o] as i64) << (o * 8)); o = o + 1; }
        let ix:i64 = 0;
        o = 0;
        while(o < 8) { ix = ix | ((t_idx[e * 8 + o] as i64) << (o * 8)); o = o + 1; }
        let nl2:i64 = 0;
        o = 0;
        while(o < 8) { nl2 = nl2 | ((t_nlen[e * 8 + o] as i64) << (o * 8)); o = o + 1; }
        let tl2:i64 = 0;
        o = 0;
        while(o < 8) { tl2 = tl2 | ((t_tlen[e * 8 + o] as i64) << (o * 8)); o = o + 1; }
        let nm:[]u8 = names[e * 64 .. e * 64 + nl2 as i32];
        let tr:[]u8 = truths[e * 32 .. e * 32 + tl2 as i32];
        // partner search: smallest j != e, same fam, same truth, scanning e+1.. wrap
        let pj1:i32 = -1;
        let pj2:i32 = -1;
        let need:i32 = 1;
        if(is_pcm(fi as i32) == 1) { need = 2; }
        let got:i32 = 0;
        let k:i32 = 1;
        while(k < nf && got < need) {
            let c:i32 = (e + k) % nf;
            let cf:i64 = 0;
            o = 0;
            while(o < 8) { cf = cf | ((t_fam[c * 8 + o] as i64) << (o * 8)); o = o + 1; }
            if(cf == fi) {
                let cl:i64 = 0;
                o = 0;
                while(o < 8) { cl = cl | ((t_tlen[c * 8 + o] as i64) << (o * 8)); o = o + 1; }
                if(cl == tl2) {
                    let same:i32 = 1;
                    o = 0;
                    while(o < tl2 as i32) {
                        if(truths[c * 32 + o] != tr[o]) { same = 0; }
                        o = o + 1;
                    }
                    if(same == 1) {
                        if(got == 0) { pj1 = c; }
                        if(got == 1) { pj2 = c; }
                        got = got + 1;
                    }
                }
            }
            k = k + 1;
        }
        if(got < need) { return perr("ERR no partner\n"); }
        // read F bytes
        let fp:[]u8 = nio_alloc(4096);
        let fpl:i32 = join_path(fp, sdir, nm);
        let fn2:i64 = z_read(fp[0..fpl], fbuf, 1048576);
        nio_free(fp);
        if(fn2 < 16) { return perr("ERR fixture read\n"); }
        // read partner bytes
        let pn:[]u8 = names[pj1 * 64 .. pj1 * 64 + 64];
        let pnl:i64 = 0;
        o = 0;
        while(o < 8) { pnl = pnl | ((t_nlen[pj1 * 8 + o] as i64) << (o * 8)); o = o + 1; }
        let pn2:[]u8 = pn[0..pnl as i32];
        let pp:[]u8 = nio_alloc(4096);
        let ppl:i32 = join_path(pp, sdir, pn2);
        let gn1:i64 = z_read(pp[0..ppl], gbuf, 1048576);
        nio_free(pp);
        if(gn1 < 16) { return perr("ERR partner read\n"); }
        let glen:i64 = gn1;
        if(is_pcm(fi as i32) == 1) {
            // second partner for 32000-sample G
            let qn:[]u8 = names[pj2 * 64 .. pj2 * 64 + 64];
            let qnl:i64 = 0;
            o = 0;
            while(o < 8) { qnl = qnl | ((t_nlen[pj2 * 8 + o] as i64) << (o * 8)); o = o + 1; }
            let qp:[]u8 = nio_alloc(4096);
            let qpl:i32 = join_path(qp, sdir, qn[0..qnl as i32]);
            let gn2:i64 = z_read(qp[0..qpl], pbuf, 1048576);
            nio_free(qp);
            if(gn2 < 16) { return perr("ERR partner2 read\n"); }
            // rebuild: header sr=16000, n=32000, samples1 + samples2
            w32(tbuf, 0, 16000);
            w32(tbuf, 4, 32000);
            o = 0;
            while(o < 32000) { tbuf[8 + o] = gbuf[8 + o]; o = o + 1; }
            o = 0;
            while(o < 32000) { tbuf[8 + 32000 + o] = pbuf[8 + o]; o = o + 1; }
            glen = 64008;
            // move rebuilt G into gbuf
            o = 0;
            while(o < glen as i32) { gbuf[o] = tbuf[o]; o = o + 1; }
        }
        // trial name: rt4_<FAM>_<NNNN>.r24 ; fam slice = nm[4..u]
        let u2:i32 = 4;
        while(u2 < nl2 as i32 && nm[u2] != 95) { u2 = u2 + 1; }
        let fs2:[]u8 = nm[4..u2];
        let tn2:[]u8 = nio_alloc(64);
        let tp2:i32 = ob_add(tn2, 0, "rt4_");
        tp2 = ob_add(tn2, tp2, fs2);
        tp2 = ob_add(tn2, tp2, "_");
        tp2 = put_dec4(tn2, tp2, ix);
        // trial file
        let tpath:[]u8 = nio_alloc(4096);
        let tplen:i32 = join_path(tpath, odir, tn2[0..tp2]);
        tplen = ob_add(tpath, tplen, ".r24");
        let tfd:i64 = z_write_open(tpath[0..tplen]);
        if(tfd < 0) { return perr("ERR trial open\n"); }
        let hd:[]u8 = nio_alloc(8);
        w32(hd, 0, 1093939794);
        w32(hd, 4, tcode_of(fi as i32) as i64);
        let wr:i64 = nio_write_all(tfd, hd);
        nio_free(hd);
        if(wr != 8) { nio_close(tfd); return perr("ERR trial hdr\n"); }
        wr = nio_write_all(tfd, fbuf[0..fn2 as i32]);
        if(wr != fn2) { nio_close(tfd); return perr("ERR trial F\n"); }
        wr = nio_write_all(tfd, gbuf[0..glen as i32]);
        if(wr != glen) { nio_close(tfd); return perr("ERR trial G\n"); }
        nio_close(tfd);
        // g-span standalone file: rt4_<FAM>_<NNNN>.g.<ext>
        let ext:[]u8 = nm[nl2 as i32 - 3 .. nl2 as i32];
        let gp:[]u8 = nio_alloc(4096);
        let gpl:i32 = join_path(gp, odir, tn2[0..tp2]);
        gpl = ob_add(gp, gpl, ".g.");
        gpl = ob_add(gp, gpl, ext);
        let grc:i32 = z_write_all(gp[0..gpl], gbuf[0..glen as i32]);
        nio_free(gp);
        if(grc != 0) { return perr("ERR g write\n"); }
        // truth sidecar
        let trp:[]u8 = nio_alloc(4096);
        let trpl:i32 = join_path(trp, odir, tn2[0..tp2]);
        trpl = ob_add(trp, trpl, ".r24.truth");
        let tb2:[]u8 = nio_alloc(40);
        let tpos:i32 = ob_add(tb2, 0, "truth=");
        tpos = ob_add(tb2, tpos, tr);
        tpos = ob_add(tb2, tpos, "\n");
        let trc:i32 = z_write_all(trp[0..trpl], tb2[0..tpos]);
        nio_free(trp);
        nio_free(tb2);
        if(trc != 0) { return perr("ERR truth write\n"); }
        // manifest lines: trial, g-file, truth
        let fnames:[]u8 = nio_alloc(256);
        let fl:i32 = ob_add(fnames, 0, tn2[0..tp2]);
        fl = ob_add(fnames, fl, ".r24");
        // hash the trial file: re-read it (simplest correct)
        let rp:[]u8 = nio_alloc(4096);
        let rpl:i32 = join_path(rp, odir, fnames[0..fl]);
        let rn:i64 = z_read(rp[0..rpl], tbuf, 1048576);
        nio_free(rp);
        if(rn < 0) { return perr("ERR reread\n"); }
        if(ns_sha256(tbuf[0..rn as i32], hb) != 0) { return perr("ERR sha2\n"); }
        let hx2:[]u8 = ns_hex(hb);
        mpos = ob_add(mf, mpos, hx2);
        mpos = ob_add(mf, mpos, "  ");
        mpos = ob_add(mf, mpos, fnames[0..fl]);
        mpos = ob_add(mf, mpos, "\n");
        nio_free(hx2);
        // g-file
        fl = ob_add(fnames, 0, tn2[0..tp2]);
        fl = ob_add(fnames, fl, ".g.");
        fl = ob_add(fnames, fl, ext);
        let gp2:[]u8 = nio_alloc(4096);
        let gpl2:i32 = join_path(gp2, odir, fnames[0..fl]);
        rn = z_read(gp2[0..gpl2], tbuf, 1048576);
        nio_free(gp2);
        if(rn < 0) { return perr("ERR g reread\n"); }
        if(ns_sha256(tbuf[0..rn as i32], hb) != 0) { return perr("ERR sha3\n"); }
        hx2 = ns_hex(hb);
        mpos = ob_add(mf, mpos, hx2);
        mpos = ob_add(mf, mpos, "  ");
        mpos = ob_add(mf, mpos, fnames[0..fl]);
        mpos = ob_add(mf, mpos, "\n");
        nio_free(hx2);
        // truth file
        fl = ob_add(fnames, 0, tn2[0..tp2]);
        fl = ob_add(fnames, fl, ".r24.truth");
        let tp3:[]u8 = nio_alloc(4096);
        let tpl3:i32 = join_path(tp3, odir, fnames[0..fl]);
        rn = z_read(tp3[0..tpl3], tbuf, 1048576);
        nio_free(tp3);
        if(rn < 0) { return perr("ERR t reread\n"); }
        if(ns_sha256(tbuf[0..rn as i32], hb) != 0) { return perr("ERR sha4\n"); }
        hx2 = ns_hex(hb);
        mpos = ob_add(mf, mpos, hx2);
        mpos = ob_add(mf, mpos, "  ");
        mpos = ob_add(mf, mpos, fnames[0..fl]);
        mpos = ob_add(mf, mpos, "\n");
        nio_free(hx2);
        nio_free(fnames);
        nio_free(tn2);
        nio_free(tpath);
        e = e + 1;
    }
    // write TRIALS.sha256
    let mp2:[]u8 = nio_alloc(4096);
    let mp2l:i32 = join_path(mp2, odir, "TRIALS.sha256");
    let mrc:i32 = z_write_all(mp2[0..mp2l], mf[0..mpos]);
    nio_free(mp2);
    if(mrc != 0) { return perr("ERR manifest write\n"); }
    if(ns_sha256(mf[0..mpos], hb) != 0) { return perr("ERR sha5\n"); }
    let hx3:[]u8 = ns_hex(hb);
    let ho:i32 = 0;
    while(ho < 64) { hx[ho] = hx3[ho]; ho = ho + 1; }
    hx[64] = 10;
    pstr(hx[0..65]);
    nio_free(hx3);
    return 0;
}

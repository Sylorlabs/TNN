// wb_neuter.zag — minimal causal probe for the GEN-LINEAGE repair.
// Runs ONLY the S11B wedge sequence and prints the four observables:
// deliberate price, overwrite rc, slot value, cite-lock count.
// @import("strength_core.zag") resolves per build dir (pristine vs patched).
@import("strength_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn neuter_val(s:*StStore,w:i32)i32 {return st_i32_get(s.*.value,w*4);}
fn neuter_locks(s:*StStore)i32 {
    let locks:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==ST_OP_CITELOCK && st_aw(s,i,4)==ST_OK){locks=locks+1;}
        i=i+1;
    }
    return locks;
}
fn main()void {
    let s:StStore=new_store();
    let v:i32=-1;
    st_add(&s,0,ST_REGION_USER,80,100,&v);
    let p:i32=-1;
    st_deliberate(&s,v,&p);
    st_justify(&s,v,4);
    st_evidence(&s,v,4,8001);
    st_delete_strong(&s,v);
    let w:i32=-1;
    st_add(&s,0,ST_REGION_USER,10,100,&w);
    st_evidence(&s,w,4,8001);
    st_deliberate(&s,w,&p);
    st_justify(&s,w,4);
    let rc:i32=st_overwrite(&s,w,1,60,9999);
    let val:i32=neuter_val(&s,w);
    let locks:i32=neuter_locks(&s);
    _zag_print("NEUTER price=");
    _zag_print(i64s(p as i64));
    _zag_print(" rc=");
    _zag_print(i64s(rc as i64));
    _zag_print(" value=");
    _zag_print(i64s(val as i64));
    _zag_print(" citelocks=");
    _zag_print(i64s(locks as i64));
    _zag_print("\n");
}

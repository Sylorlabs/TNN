// wb_fix.zag — REPAIR VERIFICATION for the GEN-LINEAGE repair (2026-09-27).
// Patched core: generation-scoped st_meter_hw / st_meter_revs.
// Pure Zag, zero RNG. Each scenario is a fresh store; prints PASS/FAIL lines.
// Sections:
//   R1-R11: white-box regression (S1..S11A identical; S11B = the repair proof)
//   P1-P5:  protection cases — adversarial FALSEHOOD vs TRUE protected memory
//   Q1-Q2:  r3 FOUGHT spiral quantification (finding, no policy change)
//   G2:     overwrite-then-overwrite: corpse not double-charged
@import("strength_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn plant(s:*StStore,val:i32,str:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,val,ST_REGION_USER,str,100,&sl);
    if(rc!=ST_OK){_zag_print("FATAL plant\n");}
    return sl;
}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
fn slot_value(s:*StStore,slot:i32)i32 {return st_i32_get(s.*.value,slot*4);}
fn slot_strength(s:*StStore,slot:i32)i32 {return s.*.strength[slot] as i32;}
fn slot_live(s:*StStore,slot:i32)i32 {return s.*.live[slot] as i32;}
fn say2(a:[]u8,v:i32)void {
    _zag_print(a);_zag_print(i64s(v as i64));_zag_print("\n");
}
fn find_delib(s:*StStore,sl:i32)i32 {
    let di:i32=-1;
    let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==ST_OP_DELIBERATE && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){di=i;}
        i=i+1;
    }
    return di;
}
fn count_op_rc(s:*StStore,wantop:i32,wantrc:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==wantop && st_aw(s,i,4)==wantrc){n=n+1;}
        i=i+1;
    }
    return n;
}

fn main()void {
    let fails:i32=0;
    let p:i32=-1;
    let di:i32=0;

    // ============ R1: truth installs at the full erase price (unchanged) ============
    let s1:StStore=new_store();
    let a:i32=plant(&s1,0,80);
    fails=ck("r1_delib",st_deliberate(&s1,a,&p),ST_OK,fails);
    fails=ck("r1_price",p,1,fails);
    di=find_delib(&s1,a);
    fails=ck("r1_di_reasons",st_aw(&s1,di,13),21|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("r1_justify",st_justify(&s1,a,4),ST_OK,fails);
    fails=ck("r1_cite",st_evidence(&s1,a,4,5001),ST_OK,fails);
    fails=ck("r1_overwrite_truth",st_overwrite(&s1,a,1,60,9999),ST_OK,fails);
    fails=ck("r1_value_is_truth",slot_value(&s1,a),1,fails);

    // ============ R2: under-funded truth -> 109, audited (unchanged) ============
    let s2:StStore=new_store();
    let b:i32=plant(&s2,0,80);
    fails=ck("r2_delib",st_deliberate(&s2,b,&p),ST_OK,fails);
    fails=ck("r2_justify",st_justify(&s2,b,4),ST_OK,fails);
    fails=ck("r2_overwrite_nocite",st_overwrite(&s2,b,1,60,9999),109,fails);
    fails=ck("r2_refusal_audited",count_op_rc(&s2,ST_OP_OVERWRITE,109),1,fails);
    fails=ck("r2_still_false",slot_value(&s2,b),0,fails);

    // ============ R3: over-funded truth -> cite-full 122 at cite time (unchanged) ============
    let s3:StStore=new_store();
    let c:i32=plant(&s3,0,80);
    fails=ck("r3_delib",st_deliberate(&s3,c,&p),ST_OK,fails);
    fails=ck("r3_cite1",st_evidence(&s3,c,4,5001),ST_OK,fails);
    fails=ck("r3_cite2_over",st_evidence(&s3,c,4,5002),122,fails);

    // ============ R4: fought falsehood costs MORE (unchanged; measured in Q) ============
    let s4:StStore=new_store();
    let d:i32=plant(&s4,0,80);
    fails=ck("r4_weaken",st_weaken(&s4,d,70,3),ST_OK,fails);
    fails=ck("r4_delib",st_deliberate(&s4,d,&p),ST_OK,fails);
    fails=ck("r4_price_fought",p,2,fails);

    // ============ R5: sunk cites raise price (unchanged) ============
    let s5:StStore=new_store();
    let e:i32=plant(&s5,0,80);
    fails=ck("r5_c1",st_evidence(&s5,e,1,6001),ST_OK,fails);
    fails=ck("r5_c2",st_evidence(&s5,e,1,6002),ST_OK,fails);
    fails=ck("r5_c3",st_evidence(&s5,e,1,6003),ST_OK,fails);
    fails=ck("r5_strengthen",st_strengthen(&s5,e,85,1),ST_OK,fails);
    fails=ck("r5_delib",st_deliberate(&s5,e,&p),ST_OK,fails);
    fails=ck("r5_price_sunk",p,3,fails);
    fails=ck("r5_justify",st_justify(&s5,e,4),ST_OK,fails);
    fails=ck("r5_pay1",st_evidence(&s5,e,4,7001),ST_OK,fails);
    fails=ck("r5_pay2",st_evidence(&s5,e,4,7002),ST_OK,fails);
    fails=ck("r5_pay3",st_evidence(&s5,e,4,7003),ST_OK,fails);
    fails=ck("r5_overwrite_truth",st_overwrite(&s5,e,1,60,9999),ST_OK,fails);
    fails=ck("r5_value_is_truth",slot_value(&s5,e),1,fails);

    // ============ R6: cite-lock wedge -> 121 + signal on priced memory (unchanged) ============
    let s6:StStore=new_store();
    let f:i32=plant(&s6,0,80);
    fails=ck("r6_delib",st_deliberate(&s6,f,&p),ST_OK,fails);
    fails=ck("r6_justify",st_justify(&s6,f,4),ST_OK,fails);
    fails=ck("r6_cite",st_evidence(&s6,f,4,7001),ST_OK,fails);
    fails=ck("r6_kill",st_delete_strong(&s6,f),ST_OK,fails);
    fails=ck("r6_rollback",st_rollback_last(&s6),ST_OK,fails);
    fails=ck("r6_overwrite_wedge",st_overwrite(&s6,f,1,60,9999),121,fails);
    fails=ck("r6_citelock_signal",count_op_rc(&s6,ST_OP_CITELOCK,0),1,fails);
    fails=ck("r6_abandon",st_abandon(&s6,f,1),ST_OK,fails);
    fails=ck("r6_fresh_cite",st_evidence(&s6,f,4,7002),ST_OK,fails);
    fails=ck("r6_overwrite_truth",st_overwrite(&s6,f,1,60,9999),ST_OK,fails);
    fails=ck("r6_value_is_truth",slot_value(&s6,f),1,fails);

    // ============ R7: P3 dead letter in METER mode (unchanged, documented) ============
    let s7:StStore=new_store();
    st_set_p3(&s7,1,2);
    st_set_episode(&s7,1000);
    let g:i32=plant(&s7,0,10);
    fails=ck("r7_p3_expired",st_p3_expired(&s7,g),1,fails);
    fails=ck("r7_overwrite_nodelib",st_overwrite(&s7,g,1,60,9999),122,fails);
    fails=ck("r7_delib",st_deliberate(&s7,g,&p),ST_OK,fails);
    fails=ck("r7_price",p,0,fails);
    fails=ck("r7_justify",st_justify(&s7,g,4),ST_OK,fails);
    fails=ck("r7_overwrite_truth",st_overwrite(&s7,g,1,60,9999),ST_OK,fails);

    // ============ R8: st_kill trainer-only (unchanged) ============
    let s8:StStore=new_store();
    let h:i32=plant(&s8,0,80);
    fails=ck("r8_kill_tnn_role",st_kill(&s8,h,ST_ROLE_TNN,0),113,fails);
    fails=ck("r8_kill_refusal_audited",count_op_rc(&s8,ST_OP_KILL,113),1,fails);

    // ============ R9: force-pin absolute for TNN (unchanged) ============
    let s9:StStore=new_store();
    let k:i32=plant(&s9,0,80);
    fails=ck("r9_delib",st_deliberate(&s9,k,&p),ST_OK,fails);
    fails=ck("r9_justify",st_justify(&s9,k,4),ST_OK,fails);
    fails=ck("r9_cite",st_evidence(&s9,k,4,5001),ST_OK,fails);
    fails=ck("r9_forcepin",st_force_pin(&s9,ST_ROLE_TRAINER,7,k),ST_OK,fails);
    fails=ck("r9_overwrite_forcepinned",st_overwrite(&s9,k,1,60,9999),112,fails);
    fails=ck("r9_still_false",slot_value(&s9,k),0,fails);

    // ============ R11A: fresh slot price-0 wedge inert (unchanged) ============
    let sa:StStore=new_store();
    let va:i32=plant(&sa,0,80);
    let wa:i32=plant(&sa,0,10);
    fails=ck("r11a_v_delib",st_deliberate(&sa,va,&p),ST_OK,fails);
    fails=ck("r11a_v_justify",st_justify(&sa,va,4),ST_OK,fails);
    fails=ck("r11a_v_cite",st_evidence(&sa,va,4,8001),ST_OK,fails);
    fails=ck("r11a_v_kill",st_delete_strong(&sa,va),ST_OK,fails);
    fails=ck("r11a_recite_consumed",st_evidence(&sa,wa,4,8001),ST_OK,fails);
    fails=ck("r11a_delib",st_deliberate(&sa,wa,&p),ST_OK,fails);
    fails=ck("r11a_price",p,0,fails);
    fails=ck("r11a_justify",st_justify(&sa,wa,4),ST_OK,fails);
    fails=ck("r11a_overwrite_truth",st_overwrite(&sa,wa,1,60,9999),ST_OK,fails);
    fails=ck("r11a_value_is_truth",slot_value(&sa,wa),1,fails);
    fails=ck("r11a_no_citelock",count_op_rc(&sa,ST_OP_CITELOCK,0),0,fails);

    // ============ R11B: THE REPAIR — reused slot no longer inherits the corpse ============
    // Same sequence that refused 121 + cite-lock on the pristine core now installs.
    let sb:StStore=new_store();
    let vb:i32=plant(&sb,0,80);
    fails=ck("r11b_v_delib",st_deliberate(&sb,vb,&p),ST_OK,fails);
    fails=ck("r11b_v_justify",st_justify(&sb,vb,4),ST_OK,fails);
    fails=ck("r11b_v_cite",st_evidence(&sb,vb,4,8001),ST_OK,fails);
    fails=ck("r11b_v_kill",st_delete_strong(&sb,vb),ST_OK,fails);
    let wb2:i32=plant(&sb,0,10);
    fails=ck("r11b_reused_slot",wb2,vb,fails);
    fails=ck("r11b_recite_consumed",st_evidence(&sb,wb2,4,8001),ST_OK,fails);
    fails=ck("r11b_delib",st_deliberate(&sb,wb2,&p),ST_OK,fails);
    fails=ck("r11b_price_repaired",p,0,fails);
    di=find_delib(&sb,wb2);
    fails=ck("r11b_reasons_own_lineage",st_aw(&sb,di,13),23|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("r11b_justify",st_justify(&sb,wb2,4),ST_OK,fails);
    fails=ck("r11b_overwrite_installs",st_overwrite(&sb,wb2,1,60,9999),ST_OK,fails);
    fails=ck("r11b_value_is_truth",slot_value(&sb,wb2),1,fails);
    fails=ck("r11b_no_citelock",count_op_rc(&sb,ST_OP_CITELOCK,0),0,fails);

    // ============ P1: adversarial falsehood, under-funded -> 109, TRUE survives ============
    let p1:StStore=new_store();
    let t1:i32=plant(&p1,1,80);
    fails=ck("p1_delib",st_deliberate(&p1,t1,&p),ST_OK,fails);
    fails=ck("p1_justify",st_justify(&p1,t1,4),ST_OK,fails);
    fails=ck("p1_adv_overwrite_nocite",st_overwrite(&p1,t1,0,20,9999),109,fails);
    fails=ck("p1_refusal_audited",count_op_rc(&p1,ST_OP_OVERWRITE,109),1,fails);
    fails=ck("p1_truth_survives",slot_value(&p1,t1),1,fails);

    // ============ P2: adversarial falsehood, no JUSTIFY -> 110, TRUE survives ============
    let p2:StStore=new_store();
    let t2:i32=plant(&p2,1,80);
    fails=ck("p2_delib",st_deliberate(&p2,t2,&p),ST_OK,fails);
    fails=ck("p2_price",p,1,fails);
    fails=ck("p2_cite",st_evidence(&p2,t2,4,5001),ST_OK,fails);
    fails=ck("p2_adv_overwrite_nojustify",st_overwrite(&p2,t2,0,20,9999),110,fails);
    fails=ck("p2_truth_survives",slot_value(&p2,t2),1,fails);

    // ============ P3: TRUE force-pinned, fully funded adversary -> 112 ============
    let p3:StStore=new_store();
    let t3:i32=plant(&p3,1,80);
    fails=ck("p3_delib",st_deliberate(&p3,t3,&p),ST_OK,fails);
    fails=ck("p3_justify",st_justify(&p3,t3,4),ST_OK,fails);
    fails=ck("p3_cite",st_evidence(&p3,t3,4,5001),ST_OK,fails);
    fails=ck("p3_forcepin",st_force_pin(&p3,ST_ROLE_TRAINER,7,t3),ST_OK,fails);
    fails=ck("p3_adv_overwrite_pinned",st_overwrite(&p3,t3,0,20,9999),112,fails);
    fails=ck("p3_truth_survives",slot_value(&p3,t3),1,fails);

    // ============ P4: weaken-then-overwrite buys NO discount (founding peak prices) ============
    let p4:StStore=new_store();
    let t4:i32=plant(&p4,1,80);
    fails=ck("p4_weaken",st_weaken(&p4,t4,10,3),ST_OK,fails);
    fails=ck("p4_delib",st_deliberate(&p4,t4,&p),ST_OK,fails);
    fails=ck("p4_price_founding_peak",p,2,fails);
    di=find_delib(&p4,t4);
    fails=ck("p4_r1_held_strong",st_aw(&p4,di,13)&255,21,fails);
    fails=ck("p4_justify",st_justify(&p4,t4,4),ST_OK,fails);
    fails=ck("p4_cite1",st_evidence(&p4,t4,4,5001),ST_OK,fails);
    fails=ck("p4_cite2",st_evidence(&p4,t4,4,5002),ST_OK,fails);
    fails=ck("p4_overwrite_paid",st_overwrite(&p4,t4,0,20,9999),ST_OK,fails);
    fails=ck("p4_value_replaced",slot_value(&p4,t4),0,fails);

    // ============ P5: priced path intact — full payment displaces even a TRUE memory ============
    let p5:StStore=new_store();
    let t5:i32=plant(&p5,1,80);
    fails=ck("p5_delib",st_deliberate(&p5,t5,&p),ST_OK,fails);
    fails=ck("p5_justify",st_justify(&p5,t5,4),ST_OK,fails);
    fails=ck("p5_cite",st_evidence(&p5,t5,4,5001),ST_OK,fails);
    fails=ck("p5_overwrite_paid",st_overwrite(&p5,t5,0,20,9999),ST_OK,fails);
    fails=ck("p5_value_replaced",slot_value(&p5,t5),0,fails);

    // ============ Q1: r3 FOUGHT spiral — one-time +1 step, saturates ============
    let q1:StStore=new_store();
    let f1:i32=plant(&q1,0,80);
    fails=ck("q1_delib0",st_deliberate(&q1,f1,&p),ST_OK,fails);
    let price0:i32=p;
    fails=ck("q1_weaken1",st_weaken(&q1,f1,70,3),ST_OK,fails);
    fails=ck("q1_delib1",st_deliberate(&q1,f1,&p),ST_OK,fails);
    let price1:i32=p;
    fails=ck("q1_weaken2",st_weaken(&q1,f1,60,3),ST_OK,fails);
    fails=ck("q1_weaken3",st_weaken(&q1,f1,50,3),ST_OK,fails);
    fails=ck("q1_weaken4",st_weaken(&q1,f1,40,3),ST_OK,fails);
    fails=ck("q1_weaken5",st_weaken(&q1,f1,30,3),ST_OK,fails);
    fails=ck("q1_delib5",st_deliberate(&q1,f1,&p),ST_OK,fails);
    let price5:i32=p;
    say2("q1 price: 0 weakens=",price0);
    say2("q1 price: 1 weaken =",price1);
    say2("q1 price: 5 weakens=",price5);
    fails=ck("q1_step_not_spiral_0",price0,1,fails);
    fails=ck("q1_step_not_spiral_1",price1,2,fails);
    fails=ck("q1_step_not_spiral_5",price5,2,fails);

    // ============ Q2: a NO-OP weaken (strength unchanged) still counts as FOUGHT ============
    let q2:StStore=new_store();
    let f2:i32=plant(&q2,0,80);
    fails=ck("q2_noop_weaken",st_weaken(&q2,f2,80,3),ST_OK,fails);
    fails=ck("q2_delib",st_deliberate(&q2,f2,&p),ST_OK,fails);
    fails=ck("q2_price_noop_fought",p,2,fails);
    di=find_delib(&q2,f2);
    fails=ck("q2_r3_fought",(st_aw(&q2,di,13)>>16)&255,27,fails);

    // ============ G2: overwrite-then-overwrite — the corpse is not double-charged ============
    // First overwrite pays the 80's full price. The new judgment (founded by
    // overwrite, strength 60) prices on its OWN generation only.
    let g2:StStore=new_store();
    let v2:i32=plant(&g2,0,80);
    fails=ck("g2_delib1",st_deliberate(&g2,v2,&p),ST_OK,fails);
    fails=ck("g2_price1",p,1,fails);
    fails=ck("g2_justify1",st_justify(&g2,v2,4),ST_OK,fails);
    fails=ck("g2_cite1",st_evidence(&g2,v2,4,9001),ST_OK,fails);
    fails=ck("g2_overwrite1",st_overwrite(&g2,v2,1,60,9999),ST_OK,fails);
    fails=ck("g2_delib2",st_deliberate(&g2,v2,&p),ST_OK,fails);
    fails=ck("g2_price2_own_generation",p,1,fails);
    di=find_delib(&g2,v2);
    fails=ck("g2_r1_held_mid",st_aw(&g2,di,13)&255,22,fails);
    fails=ck("g2_r4_revised",((st_aw(&g2,di,13)>>24)&255),29,fails);
    fails=ck("g2_justify2",st_justify(&g2,v2,4),ST_OK,fails);
    fails=ck("g2_cite2",st_evidence(&g2,v2,4,9002),ST_OK,fails);
    fails=ck("g2_overwrite2",st_overwrite(&g2,v2,0,20,8888),ST_OK,fails);
    fails=ck("g2_value_replaced",slot_value(&g2,v2),0,fails);

    _zag_print("WB_FIX_DONE fails=");
    _zag_print(i64s(fails as i64));
    _zag_print("\n");
}

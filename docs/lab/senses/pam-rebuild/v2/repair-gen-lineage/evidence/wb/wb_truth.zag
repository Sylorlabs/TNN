// wb_truth.zag — WHITE-BOX reproduction of truth-refusal in the meter-adopted
// strength core (pristine, SHA ce3c89844eb0ea2b968ed0b2c0c6ab23c974d2eb81a28f30c085a4d9cac96c32).
// Pure Zag, zero RNG. Each scenario is a fresh store; prints PASS/FAIL lines.
// Semantics: slot holds a FALSE claim; TNN attempts to install the TRUE claim
// via st_overwrite (the ONLY TNN-reachable displacement path for a live slot).
@import("strength_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
// plant a FALSE claim at given strength; returns slot
fn plant_false(s:*StStore,str:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,0,ST_REGION_USER,str,100,&sl);
    if(rc!=ST_OK){_zag_print("FATAL plant_false\n");}
    return sl;
}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
fn slot_value(s:*StStore,slot:i32)i32 {return st_i32_get(s.*.value,slot*4);}
fn slot_strength(s:*StStore,slot:i32)i32 {return s.*.strength[slot] as i32;}
fn slot_live(s:*StStore,slot:i32)i32 {return s.*.live[slot] as i32;}
fn audit_len(s:*StStore)i32 {return s.*.audit_n;}
fn say2(a:[]u8,v:i32)void {
    _zag_print(a);_zag_print(i64s(v as i64));_zag_print("\n");
}
// most recent OK DELIBERATE record index for slot
fn find_delib(s:*StStore,sl:i32)i32 {
    let di:i32=-1;
    let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==ST_OP_DELIBERATE && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){di=i;}
        i=i+1;
    }
    return di;
}
// count audit entries with op==wantop and rc==wantrc
fn count_op_rc(s:*StStore,wantop:i32,wantrc:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==wantop && st_aw(s,i,4)==wantrc){n=n+1;}
        i=i+1;
    }
    return n;
}

fn main()void {
    let fails:i32=0;
    let p:i32=-1;
    let di:i32=0;

    // ============ S1: truth installs at the full erase price ============
    let s1:StStore=new_store();
    let a:i32=plant_false(&s1,80);
    fails=ck("s1_delib",st_deliberate(&s1,a,&p),ST_OK,fails);
    fails=ck("s1_price",p,1,fails);
    di=find_delib(&s1,a);
    fails=ck("s1_di_price",st_aw(&s1,di,2),1,fails);
    fails=ck("s1_di_reasons",st_aw(&s1,di,13),21|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("s1_justify",st_justify(&s1,a,4),ST_OK,fails);
    fails=ck("s1_cite",st_evidence(&s1,a,4,5001),ST_OK,fails);
    fails=ck("s1_overwrite_truth",st_overwrite(&s1,a,1,60,9999),ST_OK,fails);
    fails=ck("s1_value_is_truth",slot_value(&s1,a),1,fails);
    fails=ck("s1_strength",slot_strength(&s1,a),60,fails);

    // ============ S2: under-funded truth -> 109, audited ============
    let s2:StStore=new_store();
    let b:i32=plant_false(&s2,80);
    fails=ck("s2_delib",st_deliberate(&s2,b,&p),ST_OK,fails);
    fails=ck("s2_justify",st_justify(&s2,b,4),ST_OK,fails);
    fails=ck("s2_overwrite_nocite",st_overwrite(&s2,b,1,60,9999),109,fails);
    fails=ck("s2_refusal_audited",count_op_rc(&s2,ST_OP_OVERWRITE,109),1,fails);
    fails=ck("s2_still_false",slot_value(&s2,b),0,fails);

    // ============ S3: over-funded truth -> cite-full 122 at cite time ============
    let s3:StStore=new_store();
    let c:i32=plant_false(&s3,80);
    fails=ck("s3_delib",st_deliberate(&s3,c,&p),ST_OK,fails);
    fails=ck("s3_cite1",st_evidence(&s3,c,4,5001),ST_OK,fails);
    fails=ck("s3_cite2_over",st_evidence(&s3,c,4,5002),122,fails);

    // ============ S4: a FOUGHT falsehood costs MORE (r3 FOUGHT +1) ============
    let s4:StStore=new_store();
    let d:i32=plant_false(&s4,80);
    fails=ck("s4_weaken",st_weaken(&s4,d,70,3),ST_OK,fails);
    fails=ck("s4_delib",st_deliberate(&s4,d,&p),ST_OK,fails);
    fails=ck("s4_price_fought",p,2,fails);
    di=find_delib(&s4,d);
    fails=ck("s4_r3_fought",st_aw(&s4,di,13)&16711680,27<<16,fails);
    say2("s4 meter price after fighting the falsehood: ",p);

    // ============ S5: SUNK cites on the falsehood raise its price (r2) ============
    let s5:StStore=new_store();
    let e:i32=plant_false(&s5,80);
    fails=ck("s5_c1",st_evidence(&s5,e,1,6001),ST_OK,fails);
    fails=ck("s5_c2",st_evidence(&s5,e,1,6002),ST_OK,fails);
    fails=ck("s5_c3",st_evidence(&s5,e,1,6003),ST_OK,fails);
    fails=ck("s5_strengthen",st_strengthen(&s5,e,85,1),ST_OK,fails);
    fails=ck("s5_delib",st_deliberate(&s5,e,&p),ST_OK,fails);
    fails=ck("s5_price_sunk",p,3,fails);
    di=find_delib(&s5,e);
    fails=ck("s5_r2_staked_high",(st_aw(&s5,di,13)>>8)&255,24,fails);
    say2("s5 meter price after 3 sunk cites on the falsehood: ",p);
    fails=ck("s5_justify",st_justify(&s5,e,4),ST_OK,fails);
    fails=ck("s5_pay1",st_evidence(&s5,e,4,7001),ST_OK,fails);
    fails=ck("s5_pay2",st_evidence(&s5,e,4,7002),ST_OK,fails);
    fails=ck("s5_pay3",st_evidence(&s5,e,4,7003),ST_OK,fails);
    fails=ck("s5_overwrite_truth",st_overwrite(&s5,e,1,60,9999),ST_OK,fails);
    fails=ck("s5_value_is_truth",slot_value(&s5,e),1,fails);

    // ============ S6: cite-lock wedge -> truth refused 121 + signal ============
    let s6:StStore=new_store();
    let f:i32=plant_false(&s6,80);
    fails=ck("s6_delib",st_deliberate(&s6,f,&p),ST_OK,fails);
    fails=ck("s6_justify",st_justify(&s6,f,4),ST_OK,fails);
    fails=ck("s6_cite",st_evidence(&s6,f,4,7001),ST_OK,fails);
    fails=ck("s6_kill",st_delete_strong(&s6,f),ST_OK,fails);
    fails=ck("s6_rollback",st_rollback_last(&s6),ST_OK,fails);
    fails=ck("s6_overwrite_wedge",st_overwrite(&s6,f,1,60,9999),121,fails);
    fails=ck("s6_citelock_signal",count_op_rc(&s6,ST_OP_CITELOCK,0),1,fails);
    // no SYS signal: 15 free slots remain, so the all-slots-locked
    // precondition in st_citelock_signal cannot hold
    fails=ck("s6_citelock_sys",count_op_rc(&s6,ST_OP_CITELOCK_SYS,0),0,fails);
    fails=ck("s6_still_false",slot_value(&s6,f),0,fails);
    fails=ck("s6_abandon",st_abandon(&s6,f,1),ST_OK,fails);
    // fresh funding breaks the wedge: truth installs
    fails=ck("s6_fresh_cite",st_evidence(&s6,f,4,7002),ST_OK,fails);
    fails=ck("s6_overwrite_truth",st_overwrite(&s6,f,1,60,9999),ST_OK,fails);
    fails=ck("s6_value_is_truth",slot_value(&s6,f),1,fails);

    // ============ S7: P3 expiry is dead letter in METER mode ============
    let s7:StStore=new_store();
    st_set_p3(&s7,1,2);
    st_set_episode(&s7,1000);
    let g:i32=plant_false(&s7,10);
    fails=ck("s7_p3_expired",st_p3_expired(&s7,g),1,fails);
    // no deliberation: fail-closed 122, NOT the P3 baseline-1 path
    fails=ck("s7_overwrite_nodelib",st_overwrite(&s7,g,1,60,9999),122,fails);
    // with deliberation: meter price 0 governs; zero cites needed
    fails=ck("s7_delib",st_deliberate(&s7,g,&p),ST_OK,fails);
    fails=ck("s7_price",p,0,fails);
    fails=ck("s7_justify",st_justify(&s7,g,4),ST_OK,fails);
    fails=ck("s7_overwrite_truth",st_overwrite(&s7,g,1,60,9999),ST_OK,fails);

    // ============ S8: st_kill is trainer-only (TNN role -> 113) ============
    let s8:StStore=new_store();
    let h:i32=plant_false(&s8,80);
    fails=ck("s8_kill_tnn_role",st_kill(&s8,h,ST_ROLE_TNN,0),113,fails);
    fails=ck("s8_still_live",slot_live(&s8,h),1,fails);
    fails=ck("s8_kill_refusal_audited",count_op_rc(&s8,ST_OP_KILL,113),1,fails);
    // trainer path still pays the full erase price
    fails=ck("s8_delib",st_deliberate(&s8,h,&p),ST_OK,fails);
    fails=ck("s8_justify",st_justify(&s8,h,4),ST_OK,fails);
    fails=ck("s8_cite",st_evidence(&s8,h,4,5001),ST_OK,fails);
    fails=ck("s8_kill_trainer_funded",st_kill(&s8,h,ST_ROLE_TRAINER,7),ST_OK,fails);

    // ============ S9: force-pin is an ABSOLUTE truth-refusal for TNN ============
    let s9:StStore=new_store();
    let k:i32=plant_false(&s9,80);
    fails=ck("s9_delib",st_deliberate(&s9,k,&p),ST_OK,fails);
    fails=ck("s9_justify",st_justify(&s9,k,4),ST_OK,fails);
    fails=ck("s9_cite",st_evidence(&s9,k,4,5001),ST_OK,fails);
    fails=ck("s9_forcepin",st_force_pin(&s9,ST_ROLE_TRAINER,7,k),ST_OK,fails);
    fails=ck("s9_overwrite_forcepinned",st_overwrite(&s9,k,1,60,9999),112,fails);
    fails=ck("s9_unpin_tnn",st_force_unpin(&s9,ST_ROLE_TNN,0,k),113,fails);
    fails=ck("s9_still_pinned",st_overwrite(&s9,k,1,60,9999),112,fails);
    fails=ck("s9_still_false",slot_value(&s9,k),0,fails);

    // ============ S10: all refusals carry their reason codes in the ledger ============
    let s10:StStore=new_store();
    let m:i32=plant_false(&s10,80);
    fails=ck("s10_delib",st_deliberate(&s10,m,&p),ST_OK,fails);
    let rc109:i32=st_overwrite(&s10,m,1,60,9999);
    fails=ck("s10_rc109",rc109,109,fails);
    fails=ck("s10_cite1",st_evidence(&s10,m,4,5001),ST_OK,fails);
    let rc122:i32=st_evidence(&s10,m,4,5002);
    fails=ck("s10_rc122",rc122,122,fails);
    let i:i32=0;
    let nref:i32=0;
    while(i<audit_len(&s10)){
        let r:i32=st_aw(&s10,i,4);
        if(r!=ST_OK){nref=nref+1;}
        i=i+1;
    }
    say2("s10 non-OK audit entries (all refusals audited): ",nref);
    if(nref==0){fails=fails+1;}

    // ============ S11A: price-0 memory on a FRESH slot: wedge is inert ============
    // verdict-(a) wedge: a cite consumed elsewhere is re-cited on a price-0
    // memory. Clean slot lineage -> meter price 0 -> the truth installs.
    let sa:StStore=new_store();
    let dum:i32=plant_false(&sa,50);
    let va:i32=plant_false(&sa,80);
    let wa:i32=plant_false(&sa,10);
    fails=ck("s11a_v_delib",st_deliberate(&sa,va,&p),ST_OK,fails);
    fails=ck("s11a_v_justify",st_justify(&sa,va,4),ST_OK,fails);
    fails=ck("s11a_v_cite",st_evidence(&sa,va,4,8001),ST_OK,fails);
    fails=ck("s11a_v_kill",st_delete_strong(&sa,va),ST_OK,fails);
    fails=ck("s11a_fresh_slot",wa,2,fails);
    fails=ck("s11a_recite_consumed",st_evidence(&sa,wa,4,8001),ST_OK,fails);
    fails=ck("s11a_delib",st_deliberate(&sa,wa,&p),ST_OK,fails);
    fails=ck("s11a_price",p,0,fails);
    fails=ck("s11a_justify",st_justify(&sa,wa,4),ST_OK,fails);
    fails=ck("s11a_overwrite_truth",st_overwrite(&sa,wa,1,60,9999),ST_OK,fails);
    fails=ck("s11a_value_is_truth",slot_value(&sa,wa),1,fails);
    fails=ck("s11a_no_citelock",count_op_rc(&sa,ST_OP_CITELOCK,0),0,fails);

    // ============ S11B: price-0 memory on a REUSED slot: wedge REFUSES the truth
    // The slot previously held a destroyed strong memory. Meter lineage is
    // slot-scoped (st_meter_hw scans [0,upto)), so the new weak memory
    // inherits the slain falsehood's high-water -> HELD_STRONG -> price 1.
    // The consumed re-cite cannot fund it -> 121 + cite-lock signal.
    let sb:StStore=new_store();
    let vb:i32=plant_false(&sb,80);
    fails=ck("s11b_v_delib",st_deliberate(&sb,vb,&p),ST_OK,fails);
    fails=ck("s11b_v_justify",st_justify(&sb,vb,4),ST_OK,fails);
    fails=ck("s11b_v_cite",st_evidence(&sb,vb,4,8001),ST_OK,fails);
    fails=ck("s11b_v_kill",st_delete_strong(&sb,vb),ST_OK,fails);
    let wb:i32=plant_false(&sb,10);
    fails=ck("s11b_reused_slot",wb,vb,fails);
    fails=ck("s11b_recite_consumed",st_evidence(&sb,wb,4,8001),ST_OK,fails);
    fails=ck("s11b_delib",st_deliberate(&sb,wb,&p),ST_OK,fails);
    fails=ck("s11b_price_inherited",p,1,fails);
    di=find_delib(&sb,wb);
    fails=ck("s11b_r1_held_strong",st_aw(&sb,di,13)&255,21,fails);
    fails=ck("s11b_justify",st_justify(&sb,wb,4),ST_OK,fails);
    fails=ck("s11b_overwrite_wedge",st_overwrite(&sb,wb,1,60,9999),121,fails);
    fails=ck("s11b_citelock",count_op_rc(&sb,ST_OP_CITELOCK,0),1,fails);
    fails=ck("s11b_still_false",slot_value(&sb,wb),0,fails);
    fails=ck("s11b_abandon",st_abandon(&sb,wb,1),ST_OK,fails);

    _zag_print("WB_DONE fails=");
    _zag_print(i64s(fails as i64));
    _zag_print("\n");
}

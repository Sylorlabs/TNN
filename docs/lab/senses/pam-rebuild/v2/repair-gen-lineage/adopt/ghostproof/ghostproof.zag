// ghostproof.zag — EXHAUSTIVE operation-sequence probe for the generation-
// birth rule (ADOPTION 2026-09-27, ghost-epoch fix). Pure Zag, zero RNG.
//
// For EVERY rollback-able op type T in {ADD, OVERWRITE, KILL_EVIDENCED,
// DELETE_STRONG, STRENGTHEN, WEAKEN, PIN, UNPIN, TRAINER_DECLARE} and for
// sequences of length 2 (op, rollback) and length 3 (op, mutation,
// rollback), this probe asserts the architectural invariant:
//
//   st_gen_epoch_start(slot, audit_n) == index of the most recent
//   generation birth, where a birth is EXACTLY:
//     - an OK ADD or OK OVERWRITE, or
//     - an OK ROLLBACK whose rolled-back op crossed a judgment boundary
//       (ADD/OVERWRITE/KILL/KILL_EVIDENCED/DELETE_STRONG)
//
// and NEVER anything else. In particular:
//   * after rollback-of-overwrite, the epoch is the ROLLBACK (rebirth),
//     never the ghost overwrite;
//   * after rollback-of-mutation (weaken/pin/...), the epoch is UNCHANGED
//     (the mutation's founding birth still founds the generation);
//   * after rollback-of-ADD, the epoch is the generation BEFORE the ADD
//     (the rollback restored death; the ADD is not a birth because it was
//     rolled back — note: the ADD entry itself is still OK in the ledger,
//     but the live slot is dead, so the epoch must not point at it);
//   * the live slot state and the epoch always agree: if the slot is live,
//     the epoch's birth installed the live strength; if dead, the epoch is
//     the last birth before the death (or -1).
//
// A second probe asserts the rebirth price invariant: after
// overwrite(strength S)+rollback, deliberate prices the RESTORED strength
// (fail-closed), never the ghost overwrite's after-strength.
//
// A third probe nests rollbacks: rollback-of-rollback is refused (only the
// last op rolls back), and a mutation after a rebirth founds no new
// generation (epoch stays at the rebirth).
@import("strength_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn an(s:*StStore)i32 {return s.*.audit_n;}
fn ep(s:*StStore,slot:i32)i32 {return st_gen_epoch_start(s,slot,an(s));}
// Fund a priced destruction: deliberate + justify + one cite. Mirrors the
// harness convention (ghost_setup in rt2).
fn fund(s:*StStore,slot:i32,cite_ep:i64)i32 {
    let p:i32=-1;
    let rc:i32=st_deliberate(s,slot,&p);
    if(rc!=ST_OK){return rc;}
    rc=st_justify(s,slot,4);
    if(rc!=ST_OK){return rc;}
    return st_evidence(s,slot,4,cite_ep);
}
fn find_last_ok(s:*StStore,slot:i32,op:i32)i32 {
    let r:i32=-1;
    let i:i32=0;
    while(i<an(s)){
        if(st_aw(s,i,0)==op && st_aw(s,i,1)==slot && st_aw(s,i,4)==ST_OK){r=i;}
        i=i+1;
    }
    return r;
}

fn main()void {
    let fails:i32=0;

    // ---- Probe 1: rollback of each op type; epoch must be the rebirth ----
    // T1: ADD(80) -> OVERWRITE(10) -> ROLLBACK. Epoch must be the rollback.
    let s1:StStore=new_store();
    let a:i32=-1;
    fails=ck("p1_add",st_add(&s1,0,ST_REGION_USER,80,100,&a),ST_OK,fails);
    fails=ck("p1_fund",fund(&s1,a,9001),ST_OK,fails);
    fails=ck("p1_ow",st_overwrite(&s1,a,1,10,9999),ST_OK,fails);
    fails=ck("p1_rb",st_rollback_last(&s1),ST_OK,fails);
    let rb1:i32=find_last_ok(&s1,a,ST_OP_ROLLBACK);
    fails=ck("p1_epoch_is_rb",ep(&s1,a),rb1,fails);
    fails=ck("p1_live",s1.live[a] as i32,1,fails);
    fails=ck("p1_strength",s1.strength[a] as i32,80,fails);
    // rebirth birth-strength = restored 80 (ledger before-word of the ow)
    fails=ck("p1_birth_str",st_gen_birth_strength(&s1,rb1),80,fails);

    // T2: ADD(80) -> WEAKEN(70) -> ROLLBACK. Epoch UNCHANGED (still the ADD);
    // the rollback of a same-judgment mutation founds nothing.
    let s2:StStore=new_store();
    let b:i32=-1;
    fails=ck("p2_add",st_add(&s2,0,ST_REGION_USER,80,100,&b),ST_OK,fails);
    let add2:i32=find_last_ok(&s2,b,ST_OP_ADD);
    fails=ck("p2_weaken",st_weaken(&s2,b,70,3),ST_OK,fails);
    fails=ck("p2_rb",st_rollback_last(&s2),ST_OK,fails);
    fails=ck("p2_epoch_still_add",ep(&s2,b),add2,fails);
    fails=ck("p2_strength_back",s2.strength[b] as i32,80,fails);

    // T3: ADD(80) -> STRENGTHEN(90) -> ROLLBACK. Epoch UNCHANGED (still the
    // ADD); the rollback of a same-judgment mutation founds nothing.
    // (Rollback of FORCE_PIN/TRAINER_DECLARE is refused 113 by trainer-
    // authority law, so STRENGTHEN stands in for the mutation class here;
    // WEAKEN is covered in T2.)
    let s3:StStore=new_store();
    let c:i32=-1;
    fails=ck("p3_add",st_add(&s3,0,ST_REGION_USER,80,100,&c),ST_OK,fails);
    let add3:i32=find_last_ok(&s3,c,ST_OP_ADD);
    fails=ck("p3_stren",st_strengthen(&s3,c,90,1),ST_OK,fails);
    fails=ck("p3_rb",st_rollback_last(&s3),ST_OK,fails);
    fails=ck("p3_epoch_still_add",ep(&s3,c),add3,fails);
    fails=ck("p3_strength_back",s3.strength[c] as i32,80,fails);

    // T4: ADD(80) -> DELETE -> ROLLBACK. The rollback restores a LIVE
    // judgment after a death: rebirth at the rollback.
    let s4:StStore=new_store();
    let d:i32=-1;
    fails=ck("p4_add",st_add(&s4,0,ST_REGION_USER,80,100,&d),ST_OK,fails);
    let p4:i32=-1;
    fails=ck("p4_delib",st_deliberate(&s4,d,&p4),ST_OK,fails);
    fails=ck("p4_justify",st_justify(&s4,d,4),ST_OK,fails);
    fails=ck("p4_cite",st_evidence(&s4,d,4,7001),ST_OK,fails);
    fails=ck("p4_del",st_delete_strong(&s4,d),ST_OK,fails);
    fails=ck("p4_dead",s4.live[d] as i32,0,fails);
    fails=ck("p4_rb",st_rollback_last(&s4),ST_OK,fails);
    let rb4:i32=find_last_ok(&s4,d,ST_OP_ROLLBACK);
    fails=ck("p4_epoch_is_rb",ep(&s4,d),rb4,fails);
    fails=ck("p4_live_again",s4.live[d] as i32,1,fails);
    fails=ck("p4_birth_str",st_gen_birth_strength(&s4,rb4),80,fails);

    // T5: ADD(80) -> ROLLBACK (rollback of the ADD itself). The ADD is
    // undone; the slot is dead. The ADD entry remains the most recent birth
    // in the ledger (rollback-of-ADD is not a birth, but the ADD itself
    // still is) — benign, because no priced op can run on a dead slot, and
    // a later reuse supersedes it with a fresh ADD.
    let s5:StStore=new_store();
    let e:i32=-1;
    fails=ck("p5_add",st_add(&s5,0,ST_REGION_USER,80,100,&e),ST_OK,fails);
    let add5:i32=find_last_ok(&s5,e,ST_OP_ADD);
    fails=ck("p5_rb",st_rollback_last(&s5),ST_OK,fails);
    fails=ck("p5_dead",s5.live[e] as i32,0,fails);
    fails=ck("p5_epoch_is_add",ep(&s5,e),add5,fails);

    // T6: ADD(80) -> OVERWRITE(10) -> WEAKEN(5) -> ROLLBACK(weaken).
    // The rollback undoes the weaken; the live judgment is the overwrite's
    // (strength 10); the epoch is the OVERWRITE (the weaken's rollback
    // founds nothing; the overwrite still founds the generation).
    let s6:StStore=new_store();
    let f:i32=-1;
    fails=ck("p6_add",st_add(&s6,0,ST_REGION_USER,80,100,&f),ST_OK,fails);
    fails=ck("p6_fund",fund(&s6,f,9002),ST_OK,fails);
    fails=ck("p6_ow",st_overwrite(&s6,f,1,10,9999),ST_OK,fails);
    let ow6:i32=find_last_ok(&s6,f,ST_OP_OVERWRITE);
    fails=ck("p6_weaken",st_weaken(&s6,f,5,3),ST_OK,fails);
    fails=ck("p6_rb",st_rollback_last(&s6),ST_OK,fails);
    fails=ck("p6_epoch_is_ow",ep(&s6,f),ow6,fails);
    fails=ck("p6_strength",s6.strength[f] as i32,10,fails);

    // T7: ADD(80) -> OVERWRITE(10) -> ROLLBACK -> WEAKEN(70).
    // After the rebirth, a weaken is a same-judgment mutation: the epoch
    // STAYS at the rebirth (no new generation founded).
    let s7:StStore=new_store();
    let g:i32=-1;
    fails=ck("p7_add",st_add(&s7,0,ST_REGION_USER,80,100,&g),ST_OK,fails);
    fails=ck("p7_fund",fund(&s7,g,9003),ST_OK,fails);
    fails=ck("p7_ow",st_overwrite(&s7,g,1,10,9999),ST_OK,fails);
    fails=ck("p7_rb",st_rollback_last(&s7),ST_OK,fails);
    let rb7:i32=find_last_ok(&s7,g,ST_OP_ROLLBACK);
    fails=ck("p7_weaken",st_weaken(&s7,g,70,3),ST_OK,fails);
    fails=ck("p7_epoch_still_rb",ep(&s7,g),rb7,fails);
    fails=ck("p7_strength",s7.strength[g] as i32,70,fails);

    // T8: double rollback attempt: ADD -> OVERWRITE -> ROLLBACK -> ROLLBACK.
    // The second rollback targets the ROLLBACK entry itself; rollback of a
    // rollback is not in the birth set and st_rollback_last refuses a
    // non-mutating last op. Either way the epoch must stay at the rebirth.
    let s8:StStore=new_store();
    let h:i32=-1;
    fails=ck("p8_add",st_add(&s8,0,ST_REGION_USER,80,100,&h),ST_OK,fails);
    fails=ck("p8_fund",fund(&s8,h,9004),ST_OK,fails);
    fails=ck("p8_ow",st_overwrite(&s8,h,1,10,9999),ST_OK,fails);
    fails=ck("p8_rb1",st_rollback_last(&s8),ST_OK,fails);
    let rb8:i32=find_last_ok(&s8,h,ST_OP_ROLLBACK);
    let rb8b:i32=st_rollback_last(&s8);
    fails=ck("p8_rb2_refused",rb8b,ST_REFUSED_NOROLLBACK,fails);
    fails=ck("p8_epoch_still_rb",ep(&s8,h),rb8,fails);
    fails=ck("p8_live",s8.live[h] as i32,1,fails);
    fails=ck("p8_strength",s8.strength[h] as i32,80,fails);

    // ---- Probe 2: rebirth prices the RESTORED strength (fail-closed) ----
    // ADD(80) -> OVERWRITE(10) -> ROLLBACK -> deliberate: price must equal
    // the price of a pristine ADD(80) (2), never the ghost price (0).
    let s9:StStore=new_store();
    let j:i32=-1;
    fails=ck("p9_add",st_add(&s9,0,ST_REGION_USER,80,100,&j),ST_OK,fails);
    fails=ck("p9_fund",fund(&s9,j,9006),ST_OK,fails);
    fails=ck("p9_ow",st_overwrite(&s9,j,1,10,9999),ST_OK,fails);
    fails=ck("p9_rb",st_rollback_last(&s9),ST_OK,fails);
    let p9:i32=-1;
    fails=ck("p9_delib",st_deliberate(&s9,j,&p9),ST_OK,fails);
    // control: pristine ADD(80) with no cites.
    let s9c:StStore=new_store();
    let jc:i32=-1;
    fails=ck("p9c_add",st_add(&s9c,0,ST_REGION_USER,80,100,&jc),ST_OK,fails);
    let p9c:i32=-1;
    fails=ck("p9c_delib",st_deliberate(&s9c,jc,&p9c),ST_OK,fails);
    // A rebirth is a REVISED birth by design (never a fresh judgment, so no
    // UNPROVEN discount — fail-closed). The rebirth therefore prices HIGHER
    // than a pristine fresh ADD (2 vs 1): the invariant is fail-closed, not
    // equality — the rebirth must never price the ghost (0) nor claim a
    // fresh-judgment discount it didn't earn.
    fails=ck("p9_price_not_ghost",p9>0,1,fails);
    fails=ck("p9_price_failclosed",p9>=p9c,1,fails);

    // ---- Probe 3: rebirth high-water includes the restored peak ----
    // ADD(80) -> STRENGTHEN(90) -> OVERWRITE(10) -> ROLLBACK.
    // Restored strength 90; hw must be >= 90 (the judgment's peak).
    let s10:StStore=new_store();
    let k:i32=-1;
    fails=ck("p10_add",st_add(&s10,0,ST_REGION_USER,80,100,&k),ST_OK,fails);
    fails=ck("p10_stren",st_strengthen(&s10,k,90,1),ST_OK,fails);
    fails=ck("p10_fund",fund(&s10,k,9005),ST_OK,fails);
    fails=ck("p10_ow",st_overwrite(&s10,k,1,10,9999),ST_OK,fails);
    fails=ck("p10_rb",st_rollback_last(&s10),ST_OK,fails);
    let hw10:i32=st_epoch_highwater(&s10,k,an(&s10),s10.strength[k] as i32);
    fails=ck("p10_hw_ge_90",hw10>=90,1,fails);
    fails=ck("p10_restored",s10.strength[k] as i32,90,fails);
    // and the epoch is the rollback, not the ghost overwrite
    fails=ck("p10_epoch_is_rb",ep(&s10,k),find_last_ok(&s10,k,ST_OP_ROLLBACK),fails);

    // ---- Probe 4: double rebirth; KILL_EVIDENCED rollback ----
    // ADD(80) -> OVERWRITE(10) -> ROLLBACK -> OVERWRITE(20) -> ROLLBACK.
    // Two rebirths; the epoch is the SECOND rollback, and its birth-strength
    // is the restored 80 (the first rebirth's judgment).
    let s11:StStore=new_store();
    let l:i32=-1;
    fails=ck("p11_add",st_add(&s11,0,ST_REGION_USER,80,100,&l),ST_OK,fails);
    fails=ck("p11_fund1",fund(&s11,l,9011),ST_OK,fails);
    fails=ck("p11_ow1",st_overwrite(&s11,l,1,10,9999),ST_OK,fails);
    fails=ck("p11_rb1",st_rollback_last(&s11),ST_OK,fails);
    // The first rebirth is REVISED (no UNPROVEN discount), so the second
    // overwrite needs 2 cites. Fund with two.
    fails=ck("p11_fund2",fund(&s11,l,9012),ST_OK,fails);
    fails=ck("p11_fund2b",st_evidence(&s11,l,4,9013),ST_OK,fails);
    fails=ck("p11_ow2",st_overwrite(&s11,l,1,20,9999),ST_OK,fails);
    fails=ck("p11_rb2",st_rollback_last(&s11),ST_OK,fails);
    let rb11:i32=find_last_ok(&s11,l,ST_OP_ROLLBACK);
    fails=ck("p11_epoch_is_rb2",ep(&s11,l),rb11,fails);
    fails=ck("p11_strength",s11.strength[l] as i32,80,fails);
    fails=ck("p11_birth_str",st_gen_birth_strength(&s11,rb11),80,fails);
    // ADD(80) -> KILL_EVIDENCED -> ROLLBACK: rebirth at the rollback.
    let s12:StStore=new_store();
    let m12:i32=-1;
    fails=ck("p12_add",st_add(&s12,0,ST_REGION_USER,80,100,&m12),ST_OK,fails);
    let p12:i32=-1;
    fails=ck("p12_delib",st_deliberate(&s12,m12,&p12),ST_OK,fails);
    fails=ck("p12_justify",st_justify(&s12,m12,4),ST_OK,fails);
    fails=ck("p12_cite",st_evidence(&s12,m12,4,7101),ST_OK,fails);
    fails=ck("p12_kill",st_kill_evidenced(&s12,m12),ST_OK,fails);
    fails=ck("p12_dead",s12.live[m12] as i32,0,fails);
    fails=ck("p12_rb",st_rollback_last(&s12),ST_OK,fails);
    fails=ck("p12_epoch_is_rb",ep(&s12,m12),find_last_ok(&s12,m12,ST_OP_ROLLBACK),fails);
    fails=ck("p12_live_again",s12.live[m12] as i32,1,fails);

    _zag_print("GHOSTPROOF_DONE fails=");
    _zag_print(i64s(fails as i64));
    _zag_print("\n");
}

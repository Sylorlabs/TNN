// rt2.zag — RED TEAM ROUND 2 vs the GEN-LINEAGE repair (2026-09-27).
// Fresh attacks on the patched core (SHA-256 98bba0dbc...); prior harnesses
// (wb_fix/red1/red2) used for orientation only. Pure Zag, zero RNG.
// Attack plan:
//   A  ghost epoch: overwrite + rollback resurrects the corpse under a new
//      epoch -> the repaired meter prices the ghost lineage (fail-open edge
//      the repair introduced; pre-repair this was fail-closed). Shown to be
//      economically neutral (ghost creation pre-pays the honest price).
//   A2 ghost re-accrual: new history in the ghost epoch re-prices honestly.
//   A3 failed overwrites (122/109) append no OK record; epoch unmoved.
//   B  kill -> replant: weak replant prices own lineage (the fix).
//   B3 overwrite -> rollback -> weaken -> overwrite: epoch picker takes the
//      MOST RECENT OK overwrite (fought discriminator).
//   C  strength-byte poisoning: all writers validate 0..100 (cl_bad=2001);
//      meter reads match live state; no divergence path via legal API.
//   D  deliberate binding window unchanged by the repair (rollback-immune
//      deliberate, exact-count, weaken-voids).
//   E  ST_DELIB_FRESH vs HIST under METER: identical prices (personality
//      forced to ST_DELIB_METER in the record); DELIB/HIST boundary keeps
//      corpse hw by design (repair is meter-path-only) - documented.
//   F  cite tombstone survives kill+replant (121 at gate, fresh cites break).
//   G  pin -> paid trainer kill -> replant: pin cleared, no meter residue.
//   H  16-slot interleave vs solo differential: no cross-slot epoch/meter leak.
//   R1 r3 no-op-WEAKEN lever: bounded +1, binary, floor absorbs, costs re-delib.
//   R2 P2/P3: S7 re-probe identical (repair does not touch the P3 path).
//   R3 trial-1145 two-tier: founding-overwrite semantics flow through the
//      real st_overwrite path; no mechanism interaction.
@import("strength_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn plant(s:*StStore,val:i32,str:i32,ep:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,val,ST_REGION_USER,str,ep,&sl);
    if(rc!=ST_OK){_zag_print("FATAL plant\n");}
    return sl;
}
fn slot_value(s:*StStore,slot:i32)i32 {return st_i32_get(s.*.value,slot*4);}
fn slot_strength(s:*StStore,slot:i32)i32 {return s.*.strength[slot] as i32;}
fn slot_live(s:*StStore,slot:i32)i32 {return s.*.live[slot] as i32;}
fn slot_forcepin(s:*StStore,slot:i32)i32 {return s.*.forcepin[slot] as i32;}
fn audit_n(s:*StStore)i32 {return s.*.audit_n;}
fn find_delib(s:*StStore,sl:i32)i32 {
    let di:i32=-1;
    let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==ST_OP_DELIBERATE && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){di=i;}
        i=i+1;
    }
    return di;
}
fn delib_reasons(s:*StStore,sl:i32)i32 {
    let di:i32=find_delib(s,sl);
    if(di<0){return -1;}
    return st_aw(s,di,13);
}
fn count_op_rc(s:*StStore,wantop:i32,wantrc:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==wantop && st_aw(s,i,4)==wantrc){n=n+1;}
        i=i+1;
    }
    return n;
}
fn find_op_ok(s:*StStore,sl:i32,op:i32)i32 {
    let fi:i32=-1;
    let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==op && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){fi=i;}
        i=i+1;
    }
    return fi;
}
// Shared ghost-epoch setup: honest overwrite (pays the full price), then a
// free rollback that resurrects the slain judgment. rcs asserted by callers'
// scenarios; here we just need the ledger shape.
fn ghost_setup(s:*StStore,sl:i32)void {
    let p:i32=-1;
    st_deliberate(s,sl,&p);
    st_justify(s,sl,4);
    st_evidence(s,sl,4,5001);
    st_overwrite(s,sl,1,10,9999);
    st_rollback_last(s);
}
// Section-H per-slot op pattern. For i%5==0 the kill+replant runs FIRST so
// the exact-count funding is never blocked by earlier cites.
fn h_pattern(s:*StStore,slot:i32,i:i32)void {
    let str:i32=10+5*i;
    if(i%5==0){
        let p:i32=-1;
        st_deliberate(s,slot,&p);
        st_justify(s,slot,4);
        let k:i32=0;
        while(k<p){st_evidence(s,slot,4,((3000+i*10+k) as i64));k=k+1;}
        st_delete_strong(s,slot);
        let sl2:i32=-1;
        st_add(s,i,ST_REGION_USER,str,4000+i,&sl2);
        slot=sl2;
    }
    if(i%2==0){st_weaken(s,slot,str-10,3);}
    if(i%3==0){
        st_evidence(s,slot,1,((2000+i*10+0) as i64));
        st_evidence(s,slot,1,((2000+i*10+1) as i64));
        st_evidence(s,slot,1,((2000+i*10+2) as i64));
    }
}
fn h_solo(i:i32,price:*i32,rs:*i32)void {
    let s:StStore=new_store();
    let sl:i32=plant(&s,i,10+5*i,1000+i);
    h_pattern(&s,sl,i);
    let p:i32=-1;
    st_deliberate(&s,sl,&p);
    price.*=p;
    rs.*=delib_reasons(&s,sl);
}

fn main()void {
    let fails:i32=0;
    let p:i32=-1;

    // ============ A: GHOST EPOCH (overwrite + rollback) ============
    // The repair assumes most-recent OK ADD/OVERWRITE == current judgment's
    // birth. Rollback-of-overwrite breaks it: the corpse is resurrected but
    // the epoch stays at the ghost overwrite. The meter then prices the
    // ghost (strength 10, no history) while the slot holds the live 80.
    let sa:StStore=new_store();
    let a:i32=plant(&sa,0,80,100);
    fails=ck("a_delib1",st_deliberate(&sa,a,&p),ST_OK,fails);
    fails=ck("a_price1",p,1,fails);
    fails=ck("a_reasons1",delib_reasons(&sa,a),21|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("a_justify",st_justify(&sa,a,4),ST_OK,fails);
    fails=ck("a_cite",st_evidence(&sa,a,4,5001),ST_OK,fails);
    fails=ck("a_overwrite",st_overwrite(&sa,a,1,10,9999),ST_OK,fails);
    fails=ck("a_val10",slot_value(&sa,a),1,fails);
    fails=ck("a_str10",slot_strength(&sa,a),10,fails);
    fails=ck("a_rollback",st_rollback_last(&sa),ST_OK,fails);
    fails=ck("a_resurrect_val",slot_value(&sa,a),0,fails);
    fails=ck("a_resurrect_str",slot_strength(&sa,a),80,fails);
    fails=ck("a_resurrect_live",slot_live(&sa,a),1,fails);
    let rbx:i32=find_op_ok(&sa,a,ST_OP_ROLLBACK);
    // ADOPTION 2026-09-27 (ghost-epoch fix): the rollback-restore is a
    // REBIRTH — the epoch picker now points at the ROLLBACK entry, never at
    // the ghost overwrite. The resurrected judgment prices honestly
    // (fail-closed, exactly the pristine core's price): HELD_STRONG on the
    // restored 80, REVISED (a rebirth is never a fresh judgment), price 2;
    // the price-0 delete is refused (fail-closed), the judgment stays live.
    fails=ck("a_epoch_is_rebirth",st_delib_epoch_start(&sa,a,audit_n(&sa)),rbx,fails);
    fails=ck("a_delib2",st_deliberate(&sa,a,&p),ST_OK,fails);
    fails=ck("a_rebirth_price",p,2,fails);
    fails=ck("a_rebirth_reasons",delib_reasons(&sa,a),21|(26<<8)|(28<<16)|(29<<24),fails);
    fails=ck("a_rebirth_bound_two",st_aw(&sa,find_delib(&sa,a),2),2,fails);
    fails=ck("a_justify2",st_justify(&sa,a,4),ST_OK,fails);
    fails=ck("a_rebirth_delete_refused",st_delete_strong(&sa,a),ST_REFUSED_EFFORT,fails);
    fails=ck("a_still_live",slot_live(&sa,a),1,fails);
    fails=ck("a_zero_ok_delete",count_op_rc(&sa,ST_OP_DELETE_STRONG,ST_OK),0,fails);
    fails=ck("a_cites_consumed_total",count_op_rc(&sa,ST_OP_EVIDENCE,ST_OK),1,fails);

    // ============ A2: ghost re-accrual (discount bounded to pre-ghost history) ============
    let sa2:StStore=new_store();
    let a2:i32=plant(&sa2,0,80,100);
    ghost_setup(&sa2,a2);
    fails=ck("a2_resurrect",slot_strength(&sa2,a2),80,fails);
    fails=ck("a2_c1",st_evidence(&sa2,a2,4,6001),ST_OK,fails);
    fails=ck("a2_c2",st_evidence(&sa2,a2,4,6002),ST_OK,fails);
    fails=ck("a2_c3",st_evidence(&sa2,a2,4,6003),ST_OK,fails);
    fails=ck("a2_weaken",st_weaken(&sa2,a2,70,3),ST_OK,fails);
    fails=ck("a2_delib",st_deliberate(&sa2,a2,&p),ST_OK,fails);
    fails=ck("a2_price",p,4,fails);
    fails=ck("a2_reasons",delib_reasons(&sa2,a2),21|(24<<8)|(27<<16)|(29<<24),fails);

    // ============ A3: failed overwrites append no OK record; epoch unmoved ============
    let sa3:StStore=new_store();
    let a3:i32=plant(&sa3,0,80,100);
    let ep0:i32=st_delib_epoch_start(&sa3,a3,audit_n(&sa3));
    fails=ck("a3_ow_nodelib",st_overwrite(&sa3,a3,1,10,9999),ST_REFUSED_NODELIB,fails);
    fails=ck("a3_no_ok_ow",count_op_rc(&sa3,ST_OP_OVERWRITE,ST_OK),0,fails);
    fails=ck("a3_epoch_unmoved",st_delib_epoch_start(&sa3,a3,audit_n(&sa3)),ep0,fails);
    fails=ck("a3_delib",st_deliberate(&sa3,a3,&p),ST_OK,fails);
    fails=ck("a3_ow_nocite",st_overwrite(&sa3,a3,1,10,9999),ST_REFUSED_EFFORT,fails);
    fails=ck("a3_no_ok_ow2",count_op_rc(&sa3,ST_OP_OVERWRITE,ST_OK),0,fails);
    fails=ck("a3_epoch_unmoved2",st_delib_epoch_start(&sa3,a3,audit_n(&sa3)),ep0,fails);
    fails=ck("a3_price_still_honest",p,1,fails);

    // ============ B: kill -> replant, weak replant prices own lineage ============
    let sb:StStore=new_store();
    let b:i32=plant(&sb,0,80,100);
    fails=ck("b_delib",st_deliberate(&sb,b,&p),ST_OK,fails);
    fails=ck("b_cite",st_evidence(&sb,b,4,5001),ST_OK,fails);
    fails=ck("b_justify",st_justify(&sb,b,4),ST_OK,fails);
    fails=ck("b_kill",st_delete_strong(&sb,b),ST_OK,fails);
    let b2:i32=plant(&sb,1,30,200);
    fails=ck("b_same_slot",b2,b,fails);
    fails=ck("b_delib2",st_deliberate(&sb,b,&p),ST_OK,fails);
    fails=ck("b_price2_own_lineage",p,0,fails);
    fails=ck("b_reasons2",delib_reasons(&sb,b),22|(26<<8)|(28<<16)|(30<<24),fails);

    // ============ B3: overwrite -> rollback -> weaken -> overwrite: picker takes most recent ============
    let sb3:StStore=new_store();
    let e:i32=plant(&sb3,0,80,100);
    ghost_setup(&sb3,e);
    fails=ck("b3_weaken",st_weaken(&sb3,e,70,3),ST_OK,fails);
    fails=ck("b3_delib2",st_deliberate(&sb3,e,&p),ST_OK,fails);
    fails=ck("b3_price2",p,3,fails);
    fails=ck("b3_justify2",st_justify(&sb3,e,4),ST_OK,fails);
    fails=ck("b3_c1",st_evidence(&sb3,e,4,6101),ST_OK,fails);
    fails=ck("b3_c2",st_evidence(&sb3,e,4,6102),ST_OK,fails);
    fails=ck("b3_c3",st_evidence(&sb3,e,4,6103),ST_OK,fails);
    fails=ck("b3_ow2",st_overwrite(&sb3,e,2,20,9999),ST_OK,fails);
    let k2:i32=find_op_ok(&sb3,e,ST_OP_OVERWRITE);
    fails=ck("b3_epoch_is_k2",st_delib_epoch_start(&sb3,e,audit_n(&sb3)),k2,fails);
    fails=ck("b3_delib3",st_deliberate(&sb3,e,&p),ST_OK,fails);
    fails=ck("b3_price3",p,0,fails);
    fails=ck("b3_reasons3_unfought",delib_reasons(&sb3,e),23|(26<<8)|(28<<16)|(29<<24),fails);

    // ============ C: strength-byte poisoning (no path via legal API) ============
    let sc:StStore=new_store();
    let f:i32=plant(&sc,0,50,100);
    fails=ck("c_delib50",st_deliberate(&sc,f,&p),ST_OK,fails);
    fails=ck("c_price50",p,0,fails);
    fails=ck("c_strengthen",st_strengthen(&sc,f,90,1),ST_OK,fails);
    fails=ck("c_delib90",st_deliberate(&sc,f,&p),ST_OK,fails);
    fails=ck("c_price90",p,1,fails);
    fails=ck("c_td",st_trainer_declare(&sc,1,7,f,95,1),ST_OK,fails);
    fails=ck("c_delib95",st_deliberate(&sc,f,&p),ST_OK,fails);
    fails=ck("c_price95",p,1,fails);
    fails=ck("c_td150",st_trainer_declare(&sc,1,7,f,150,1),2001,fails);
    fails=ck("c_weaken_neg",st_weaken(&sc,f,-5,3),2001,fails);
    fails=ck("c_strengthen101",st_strengthen(&sc,f,101,1),2001,fails);
    fails=ck("c_td_tnn_role",st_trainer_declare(&sc,0,7,f,60,1),ST_REFUSED_ROLE,fails);
    fails=ck("c_no_poison_records",count_op_rc(&sc,ST_OP_TRAINER_DECLARE,ST_OK),1,fails);
    fails=ck("c_delib_after",st_deliberate(&sc,f,&p),ST_OK,fails);
    fails=ck("c_price_after",p,1,fails);

    // ============ D: deliberate binding window (repair-unchanged) ============
    // D1: DELIBERATE records are not rollback-able (not in the mutating set)
    // and the binding survives the refused rollback.
    let sd:StStore=new_store();
    let g:i32=plant(&sd,0,80,100);
    fails=ck("d_delib",st_deliberate(&sd,g,&p),ST_OK,fails);
    fails=ck("d_price",p,1,fails);
    fails=ck("d_rb_delib_refused",st_rollback_last(&sd),ST_REFUSED_NOROLLBACK,fails);
    fails=ck("d_justify",st_justify(&sd,g,4),ST_OK,fails);
    fails=ck("d_cite",st_evidence(&sd,g,4,5001),ST_OK,fails);
    fails=ck("d_ow",st_overwrite(&sd,g,1,60,9999),ST_OK,fails);
    fails=ck("d_val",slot_value(&sd,g),1,fails);
    // D2: exact-count funding intact.
    let sd2:StStore=new_store();
    let h:i32=plant(&sd2,0,80,100);
    fails=ck("d2_delib",st_deliberate(&sd2,h,&p),ST_OK,fails);
    fails=ck("d2_justify",st_justify(&sd2,h,4),ST_OK,fails);
    fails=ck("d2_cite1",st_evidence(&sd2,h,4,5001),ST_OK,fails);
    fails=ck("d2_cite2_full",st_evidence(&sd2,h,4,5002),ST_REFUSED_CITEFULL,fails);
    fails=ck("d2_ow",st_overwrite(&sd2,h,1,60,9999),ST_OK,fails);
    // D3: a WEAKEN after the deliberate voids it (lss moves) -> 122.
    let sd3:StStore=new_store();
    let i3:i32=plant(&sd3,0,80,100);
    fails=ck("d3_delib",st_deliberate(&sd3,i3,&p),ST_OK,fails);
    fails=ck("d3_justify",st_justify(&sd3,i3,4),ST_OK,fails);
    fails=ck("d3_cite",st_evidence(&sd3,i3,4,5001),ST_OK,fails);
    fails=ck("d3_weaken",st_weaken(&sd3,i3,70,3),ST_OK,fails);
    fails=ck("d3_ow_void",st_overwrite(&sd3,i3,1,60,9999),ST_REFUSED_NODELIB,fails);

    // ============ E: personality vs the repaired meter ============
    // E1/E2: under ST_PRICE_METER the deliberate record's personality is
    // forced to ST_DELIB_METER whatever s.delib_pers says; prices identical.
    let se:StStore=new_store();
    let j:i32=plant(&se,0,80,100);
    st_set_delib_personality(&se,ST_DELIB_FRESH);
    fails=ck("e_fresh_delib",st_deliberate(&se,j,&p),ST_OK,fails);
    fails=ck("e_fresh_price",p,1,fails);
    fails=ck("e_fresh_reasons",delib_reasons(&se,j),21|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("e_fresh_aux2",st_aw(&se,find_delib(&se,j),3),ST_DELIB_METER,fails);
    let se2:StStore=new_store();
    let k:i32=plant(&se2,0,80,100);
    st_set_delib_personality(&se2,ST_DELIB_HIST);
    fails=ck("e_hist_delib",st_deliberate(&se2,k,&p),ST_OK,fails);
    fails=ck("e_hist_price",p,1,fails);
    fails=ck("e_hist_reasons",delib_reasons(&se2,k),21|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("e_hist_aux2",st_aw(&se2,find_delib(&se2,k),3),ST_DELIB_METER,fails);
    // E3: DELIB-mode boundary — ADOPTION 2026-09-27 (quirk-2 fix): the price
    // path is generation-scoped for EVERY personality. HIST no longer sees
    // through the overwrite reset: the weak overwriting judgment prices on
    // its OWN generation (weak, no cites, REVISED) — the corpse high-water
    // no longer weighs on a destruction price. Personality remains a
    // recorded binding attribute of the DELIBERATE record (the switch rule
    // is unchanged); it no longer moves the priced lineage.
    let se3:StStore=new_store();
    st_set_price_mode(&se3,ST_PRICE_DELIB);
    st_set_delib_personality(&se3,ST_DELIB_HIST);
    let l:i32=plant(&se3,0,80,100);
    fails=ck("e3_hist_delib1",st_deliberate(&se3,l,&p),ST_OK,fails);
    fails=ck("e3_hist_price1",p,2,fails);
    fails=ck("e3_justify",st_justify(&se3,l,4),ST_OK,fails);
    fails=ck("e3_cite1",st_evidence(&se3,l,4,5001),ST_OK,fails);
    fails=ck("e3_cite2",st_evidence(&se3,l,4,5002),ST_OK,fails);
    fails=ck("e3_ow",st_overwrite(&se3,l,1,10,9999),ST_OK,fails);
    fails=ck("e3_hist_delib2",st_deliberate(&se3,l,&p),ST_OK,fails);
    fails=ck("e3_hist_price2_generation",p,0,fails);
    // Generation-scoped HIST reasons: WEAK (hw 10) | UNCONTESTED (0 cites
    // in generation) | NOTRAIL (no justify in generation) | OTHER — IDENTICAL
    // to the FRESH reasons below, because both personalities now price the
    // same generation. (The old corpse reasons 1|5|8|13 are superseded.)
    fails=ck("e3_hist_reasons2",delib_reasons(&se3,l),3|(6<<8)|(10<<16)|(13<<24),fails);
    st_set_delib_personality(&se3,ST_DELIB_FRESH);
    fails=ck("e3_fresh_delib",st_deliberate(&se3,l,&p),ST_OK,fails);
    fails=ck("e3_fresh_price_gen",p,0,fails);
    fails=ck("e3_fresh_reasons",delib_reasons(&se3,l),3|(6<<8)|(10<<16)|(13<<24),fails);

    // ============ F: cite tombstone survives kill+replant ============
    // F: tombstone gate (historical 98bba0: cite-time OK, gate 121).
    let sf:StStore=new_store();
    let m:i32=plant(&sf,0,80,100);
    fails=ck("f_delib",st_deliberate(&sf,m,&p),ST_OK,fails);
    fails=ck("f_justify",st_justify(&sf,m,4),ST_OK,fails);
    fails=ck("f_cite",st_evidence(&sf,m,4,5001),ST_OK,fails);
    fails=ck("f_kill",st_delete_strong(&sf,m),ST_OK,fails);
    fails=ck("f_dead",slot_live(&sf,m),0,fails);
    let m2:i32=plant(&sf,1,80,200);
    fails=ck("f_same_slot",m2,m,fails);
    fails=ck("f_delib2",st_deliberate(&sf,m,&p),ST_OK,fails);
    fails=ck("f_price2",p,1,fails);
    fails=ck("f_justify2",st_justify(&sf,m,4),ST_OK,fails);
    fails=ck("f_recite_ok_at_citetime",st_evidence(&sf,m,4,5001),ST_OK,fails);
    fails=ck("f_kill_wedge",st_delete_strong(&sf,m),ST_REFUSED_CONSUMED,fails);
    fails=ck("f_citelock",count_op_rc(&sf,ST_OP_CITELOCK,ST_OK),1,fails);
    fails=ck("f_abandon",st_abandon(&sf,m,1),ST_OK,fails);
    fails=ck("f_fresh",st_evidence(&sf,m,4,5002),ST_OK,fails);
    fails=ck("f_kill2",st_delete_strong(&sf,m),ST_OK,fails);
    fails=ck("f_dead2",slot_live(&sf,m),0,fails);

    // ============ G: pin -> paid trainer kill -> replant ============
    let sg:StStore=new_store();
    let nn:i32=plant(&sg,0,80,100);
    fails=ck("g_pin",st_force_pin(&sg,1,7,nn),ST_OK,fails);
    fails=ck("g_kill_tnn_role",st_kill(&sg,nn,0,7),ST_REFUSED_ROLE,fails);
    fails=ck("g_delib_pinned",st_deliberate(&sg,nn,&p),ST_REFUSED_FORCEPIN,fails);
    fails=ck("g_unpin",st_force_unpin(&sg,1,7,nn),ST_OK,fails);
    fails=ck("g_delib",st_deliberate(&sg,nn,&p),ST_OK,fails);
    fails=ck("g_price",p,1,fails);
    fails=ck("g_justify",st_justify(&sg,nn,4),ST_OK,fails);
    fails=ck("g_cite",st_evidence(&sg,nn,4,5001),ST_OK,fails);
    fails=ck("g_kill",st_kill(&sg,nn,1,7),ST_OK,fails);
    fails=ck("g_dead",slot_live(&sg,nn),0,fails);
    fails=ck("g_pin_cleared",slot_forcepin(&sg,nn),0,fails);
    let nn2:i32=plant(&sg,1,30,200);
    fails=ck("g_same_slot",nn2,nn,fails);
    fails=ck("g_delib2",st_deliberate(&sg,nn,&p),ST_OK,fails);
    fails=ck("g_price2_own",p,0,fails);
    fails=ck("g_reasons2",delib_reasons(&sg,nn),22|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("g_justify2",st_justify(&sg,nn,4),ST_OK,fails);
    fails=ck("g_delete2",st_delete_strong(&sg,nn),ST_OK,fails);

    // ============ H: 16-slot interleave vs solo differential ============
    let si:StStore=new_store();
    let ih:i32=0;
    while(ih<16){
        let slh:i32=plant(&si,ih,10+5*ih,1000+ih);
        h_pattern(&si,slh,ih);
        ih=ih+1;
    }
    let hm:i32=0;
    ih=0;
    while(ih<16){
        let pi:i32=-1;
        st_deliberate(&si,ih,&pi);
        let ps:i32=-2;
        let rs:i32=-1;
        h_solo(ih,&ps,&rs);
        if(pi!=ps){hm=hm+1;}
        if(delib_reasons(&si,ih)!=rs){hm=hm+1;}
        ih=ih+1;
    }
    fails=ck("h_nomismatch",hm,0,fails);
    fails=ck("h_all_live",slot_live(&si,15),1,fails);

    // ============ R1: r3 no-op-WEAKEN lever (ruling evidence) ============
    let sr1:StStore=new_store();
    let o:i32=plant(&sr1,0,80,100);
    let q:i32=0;
    while(q<5){st_weaken(&sr1,o,80,3);q=q+1;}
    fails=ck("r1_delib",st_deliberate(&sr1,o,&p),ST_OK,fails);
    fails=ck("r1_price_5noop",p,2,fails);
    fails=ck("r1_reasons",delib_reasons(&sr1,o),21|(26<<8)|(27<<16)|(30<<24),fails);
    let sr1b:StStore=new_store();
    let o2:i32=plant(&sr1b,0,20,100);
    fails=ck("r1_noop_weak",st_weaken(&sr1b,o2,20,3),ST_OK,fails);
    fails=ck("r1_delib_w",st_deliberate(&sr1b,o2,&p),ST_OK,fails);
    fails=ck("r1_price_weak_noop",p,0,fails);
    let sr1c:StStore=new_store();
    let o3:i32=plant(&sr1c,0,80,100);
    fails=ck("r1_d",st_deliberate(&sr1c,o3,&p),ST_OK,fails);
    fails=ck("r1_j",st_justify(&sr1c,o3,4),ST_OK,fails);
    fails=ck("r1_c",st_evidence(&sr1c,o3,4,5001),ST_OK,fails);
    fails=ck("r1_noop",st_weaken(&sr1c,o3,80,3),ST_OK,fails);
    fails=ck("r1_ow_void",st_overwrite(&sr1c,o3,1,60,9999),ST_REFUSED_NODELIB,fails);

    // ============ R2: P3 dead-letter re-probe (ruling evidence) ============
    let sr2:StStore=new_store();
    st_set_p3(&sr2,1,2);
    st_set_episode(&sr2,1000);
    let q2:i32=plant(&sr2,0,10,100);
    fails=ck("r2_p3exp",st_p3_expired(&sr2,q2),1,fails);
    fails=ck("r2_ow_nodelib",st_overwrite(&sr2,q2,1,60,9999),ST_REFUSED_NODELIB,fails);
    fails=ck("r2_delib",st_deliberate(&sr2,q2,&p),ST_OK,fails);
    fails=ck("r2_price",p,0,fails);

    // ============ R3: two-tier vs founding-overwrite (ruling evidence) ============
    let sr3:StStore=new_store();
    let rr:i32=plant(&sr3,0,20,100);
    fails=ck("r3_delib",st_deliberate(&sr3,rr,&p),ST_OK,fails);
    fails=ck("r3_price",p,0,fails);
    fails=ck("r3_justify",st_justify(&sr3,rr,4),ST_OK,fails);
    fails=ck("r3_ow",st_overwrite(&sr3,rr,1,60,9999),ST_OK,fails);
    fails=ck("r3_delib2",st_deliberate(&sr3,rr,&p),ST_OK,fails);
    fails=ck("r3_price2",p,1,fails);
    fails=ck("r3_r4_revised",delib_reasons(&sr3,rr),22|(26<<8)|(28<<16)|(29<<24),fails);

    _zag_print("RT2_DONE fails=");
    _zag_print(i64s(fails as i64));
    _zag_print("\n");
}

// ext_battery.zag — EXTENDED verification for the GEN-LINEAGE repair (2026-09-27).
// Goes beyond the 137-check wb_fix: multi-generation corpse chains, interleaved
// slots, force-pin interactions, boundary bands, reuse under pressure, r3 at
// scale (ruling-1 evidence), founding asymmetry (ruling-3 evidence), P3
// non-interaction (ruling-2 evidence), trainer-kill path, cite-lock across
// generations. Pure Zag, zero RNG. Fresh store per section.
@import("strength_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn plant2(s:*StStore,val:i32,str:i32,ep:i64)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,val,ST_REGION_USER,str,ep,&sl);
    if(rc!=ST_OK){_zag_print("FATAL plant\n");}
    return sl;
}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
fn slot_value(s:*StStore,slot:i32)i32 {return st_i32_get(s.*.value,slot*4);}
fn slot_live(s:*StStore,slot:i32)i32 {return s.*.live[slot] as i32;}
fn find_delib(s:*StStore,sl:i32)i32 {
    let di:i32=-1;
    let i:i32=0;
    while(i<s.*.audit_n){
        if(st_aw(s,i,0)==ST_OP_DELIBERATE && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){di=i;}
        i=i+1;
    }
    return di;
}
fn delib_reasons(s:*StStore,sl:i32)i32 {
    let di:i32=find_delib(s,sl);
    if(di<0){return -999;}
    return st_aw(s,di,13);
}
fn delib_price(s:*StStore,sl:i32)i32 {
    let p:i32=-1;
    let rc:i32=st_deliberate(s,sl,&p);
    if(rc!=ST_OK){return -1000-rc;}
    return p;
}
// Full priced-destruction dance then overwrite. Returns overwrite rc.
fn paid_overwrite(s:*StStore,sl:i32,val:i32,str:i32,citebase:i64)i32 {
    let p:i32=-1;
    if(st_deliberate(s,sl,&p)!=ST_OK){return -1001;}
    if(st_justify(s,sl,4)!=ST_OK){return -1002;}
    let i:i64=0;
    while(i<(p as i64)){
        if(st_evidence(s,sl,4,citebase+i)!=ST_OK){return -1003;}
        i=i+1;
    }
    return st_overwrite(s,sl,val,str,citebase+1000);
}
// Full priced-destruction dance then delete. Returns delete rc.
fn paid_delete(s:*StStore,sl:i32,citebase:i64)i32 {
    let p:i32=-1;
    if(st_deliberate(s,sl,&p)!=ST_OK){return -1001;}
    if(st_justify(s,sl,4)!=ST_OK){return -1002;}
    let i:i64=0;
    while(i<(p as i64)){
        if(st_evidence(s,sl,4,citebase+i)!=ST_OK){return -1003;}
        i=i+1;
    }
    return st_delete_strong(s,sl);
}
fn main()void {
    let fails:i32=0;

    // ================= X1: 5-generation corpse chain, one slot =================
    let x1:StStore=new_store();
    let g1:i32=plant2(&x1,0,80,101);
    fails=ck("x1_g1_price",delib_price(&x1,g1),1,fails);
    fails=ck("x1_g1_reasons",delib_reasons(&x1,g1),21|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("x1_g1_ow",paid_overwrite(&x1,g1,1,60,8101),ST_OK,fails);
    fails=ck("x1_g2_price",delib_price(&x1,g1),1,fails);
    fails=ck("x1_g2_reasons",delib_reasons(&x1,g1),22|(26<<8)|(28<<16)|(29<<24),fails);
    fails=ck("x1_g2_ow",paid_overwrite(&x1,g1,0,40,8201),ST_OK,fails);
    fails=ck("x1_g3_price",delib_price(&x1,g1),1,fails);
    fails=ck("x1_g3_reasons",delib_reasons(&x1,g1),22|(26<<8)|(28<<16)|(29<<24),fails);
    fails=ck("x1_g3_ow",paid_overwrite(&x1,g1,1,70,8301),ST_OK,fails);
    fails=ck("x1_g4_price",delib_price(&x1,g1),1,fails);
    fails=ck("x1_g4_reasons",delib_reasons(&x1,g1),22|(26<<8)|(28<<16)|(29<<24),fails);
    fails=ck("x1_g4_ow",paid_overwrite(&x1,g1,1,20,8401),ST_OK,fails);
    fails=ck("x1_g5_price",delib_price(&x1,g1),0,fails);
    fails=ck("x1_g5_reasons",delib_reasons(&x1,g1),23|(26<<8)|(28<<16)|(29<<24),fails);
    fails=ck("x1_final_value",slot_value(&x1,g1),1,fails);

    // ============ X2: interleaved slots, no cross-slot leakage ============
    let x2:StStore=new_store();
    let xa:i32=plant2(&x2,0,80,201);
    let xb:i32=plant2(&x2,0,30,202);
    let xc:i32=plant2(&x2,0,90,203);
    let xd:i32=plant2(&x2,0,50,204);
    fails=ck("x2_weaken_a",st_weaken(&x2,xa,70,3),ST_OK,fails);
    fails=ck("x2_weaken_c",st_weaken(&x2,xc,70,3),ST_OK,fails);
    fails=ck("x2_a_price",delib_price(&x2,xa),2,fails);
    fails=ck("x2_a_reasons",delib_reasons(&x2,xa),21|(26<<8)|(27<<16)|(30<<24),fails);
    fails=ck("x2_c_price",delib_price(&x2,xc),2,fails);
    fails=ck("x2_del_a",paid_delete(&x2,xa,8501),ST_OK,fails);
    let xa2:i32=plant2(&x2,1,20,205);
    fails=ck("x2_a_replant_price",delib_price(&x2,xa2),0,fails);
    fails=ck("x2_a_replant_reasons",delib_reasons(&x2,xa2),23|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("x2_b_price",delib_price(&x2,xb),0,fails);
    fails=ck("x2_c_still2",delib_price(&x2,xc),2,fails);
    fails=ck("x2_d_price",delib_price(&x2,xd),0,fails);

    // ============ X3: force-pin interactions ============
    let x3:StStore=new_store();
    let k:i32=plant2(&x3,0,80,301);
    fails=ck("x3_delib",delib_price(&x3,k),1,fails);
    fails=ck("x3_pin",st_force_pin(&x3,ST_ROLE_TRAINER,7,k),ST_OK,fails);
    fails=ck("x3_ow_pinned",st_overwrite(&x3,k,1,60,9999),112,fails);
    // pin freezes even pricing: deliberate on a pinned slot refuses 112
    // (pre-existing gate, untouched by the repair)
    // delib_price encodes a deliberate refusal rc as -1000-rc: pinned -> -1000-112
    fails=ck("x3_delib_while_pinned",delib_price(&x3,k),-1112,fails);
    fails=ck("x3_unpin",st_force_unpin(&x3,ST_ROLE_TRAINER,7,k),ST_OK,fails);
    fails=ck("x3_del_after_unpin",paid_delete(&x3,k,8602),ST_OK,fails);
    fails=ck("x3_dead",slot_live(&x3,k),0,fails);
    let k2:i32=plant2(&x3,1,25,302);
    fails=ck("x3_replant_price",delib_price(&x3,k2),0,fails);
    fails=ck("x3_replant_reasons",delib_reasons(&x3,k2),23|(26<<8)|(28<<16)|(30<<24),fails);
    // pin a weak truth: meter sees own lineage, pin adds nothing
    let x3b:StStore=new_store();
    let w:i32=plant2(&x3b,1,20,303);
    fails=ck("x3b_pin",st_force_pin(&x3b,ST_ROLE_TRAINER,7,w),ST_OK,fails);
    fails=ck("x3b_delib_pinned",delib_price(&x3b,w),-1112,fails);
    fails=ck("x3b_unpin",st_force_unpin(&x3b,ST_ROLE_TRAINER,7,w),ST_OK,fails);
    fails=ck("x3b_ow_weak_truth",paid_overwrite(&x3b,w,0,80,8603),ST_OK,fails);
    fails=ck("x3b_value",slot_value(&x3b,w),0,fails);

    // ================= X4: boundary bands on reused slots =================
    // helper pattern inline: plant 80, paid kill, replant at S, deliberate
    let x4a:StStore=new_store();
    let b76:i32=plant2(&x4a,0,80,401);
    fails=ck("x4_kill76",paid_delete(&x4a,b76,8701),ST_OK,fails);
    let r76:i32=plant2(&x4a,1,76,402);
    fails=ck("x4_hw76_price",delib_price(&x4a,r76),1,fails);
    fails=ck("x4_hw76_r1",delib_reasons(&x4a,r76),21|(26<<8)|(28<<16)|(30<<24),fails);
    let x4b:StStore=new_store();
    let b75:i32=plant2(&x4b,0,80,403);
    fails=ck("x4_kill75",paid_delete(&x4b,b75,8702),ST_OK,fails);
    let r75:i32=plant2(&x4b,1,75,404);
    fails=ck("x4_hw75_price",delib_price(&x4b,r75),0,fails);
    fails=ck("x4_hw75_r1",delib_reasons(&x4b,r75),22|(26<<8)|(28<<16)|(30<<24),fails);
    let x4c:StStore=new_store();
    let b26:i32=plant2(&x4c,0,80,405);
    fails=ck("x4_kill26",paid_delete(&x4c,b26,8703),ST_OK,fails);
    let r26:i32=plant2(&x4c,1,26,406);
    fails=ck("x4_s26_price",delib_price(&x4c,r26),0,fails);
    fails=ck("x4_s26_r1",delib_reasons(&x4c,r26),22|(26<<8)|(28<<16)|(30<<24),fails);
    let x4d:StStore=new_store();
    let b25:i32=plant2(&x4d,0,80,407);
    fails=ck("x4_kill25",paid_delete(&x4d,b25,8704),ST_OK,fails);
    let r25:i32=plant2(&x4d,1,25,408);
    fails=ck("x4_s25_price",delib_price(&x4d,r25),0,fails);
    fails=ck("x4_s25_r1",delib_reasons(&x4d,r25),23|(26<<8)|(28<<16)|(30<<24),fails);
    // sunk bands: cites then strengthen to move lss past the cites
    let x4e:StStore=new_store();
    let se:i32=plant2(&x4e,0,50,409);
    fails=ck("x4e_c1",st_evidence(&x4e,se,1,8711),ST_OK,fails);
    fails=ck("x4e_c2",st_evidence(&x4e,se,1,8712),ST_OK,fails);
    fails=ck("x4e_str",st_strengthen(&x4e,se,55,1),ST_OK,fails);
    fails=ck("x4e_sunk2_price",delib_price(&x4e,se),1,fails);
    fails=ck("x4e_sunk2_r2",delib_reasons(&x4e,se),22|(25<<8)|(28<<16)|(30<<24),fails);
    let x4f:StStore=new_store();
    let sf:i32=plant2(&x4f,0,50,410);
    fails=ck("x4f_c1",st_evidence(&x4f,sf,1,8721),ST_OK,fails);
    fails=ck("x4f_c2",st_evidence(&x4f,sf,1,8722),ST_OK,fails);
    fails=ck("x4f_c3",st_evidence(&x4f,sf,1,8723),ST_OK,fails);
    fails=ck("x4f_str",st_strengthen(&x4f,sf,55,1),ST_OK,fails);
    fails=ck("x4f_sunk3_price",delib_price(&x4f,sf),2,fails);
    fails=ck("x4f_sunk3_r2",delib_reasons(&x4f,sf),22|(24<<8)|(28<<16)|(30<<24),fails);
    // fought + clamp + floor
    let x4g:StStore=new_store();
    let fg:i32=plant2(&x4g,0,80,411);
    fails=ck("x4g_weaken",st_weaken(&x4g,fg,79,3),ST_OK,fails);
    fails=ck("x4g_fought_price",delib_price(&x4g,fg),2,fails);
    fails=ck("x4g_fought_r3",delib_reasons(&x4g,fg),21|(26<<8)|(27<<16)|(30<<24),fails);
    let x4h:StStore=new_store();
    let fh:i32=plant2(&x4h,0,80,412);
    fails=ck("x4h_c1",st_evidence(&x4h,fh,1,8731),ST_OK,fails);
    fails=ck("x4h_c2",st_evidence(&x4h,fh,1,8732),ST_OK,fails);
    fails=ck("x4h_c3",st_evidence(&x4h,fh,1,8733),ST_OK,fails);
    fails=ck("x4h_str",st_strengthen(&x4h,fh,85,1),ST_OK,fails);
    fails=ck("x4h_weaken",st_weaken(&x4h,fh,84,3),ST_OK,fails);
    fails=ck("x4h_clamp_price",delib_price(&x4h,fh),4,fails);
    fails=ck("x4h_clamp_reasons",delib_reasons(&x4h,fh),21|(24<<8)|(27<<16)|(30<<24),fails);
    let x4i:StStore=new_store();
    let fi:i32=plant2(&x4i,0,10,413);
    fails=ck("x4i_floor_price",delib_price(&x4i,fi),0,fails);

    // ================= X5: reuse under pressure (14/16 slots) =================
    let x5:StStore=new_store();
    let p50a:i32=plant2(&x5,0,50,501);
    let p50b:i32=plant2(&x5,0,50,502);
    let p50c:i32=plant2(&x5,0,50,503);
    let p50d:i32=plant2(&x5,0,50,504);
    let p50e:i32=plant2(&x5,0,50,505);
    let p50f:i32=plant2(&x5,0,50,506);
    let p50g:i32=plant2(&x5,0,50,507);
    let p50h:i32=plant2(&x5,0,50,508);
    let p50i:i32=plant2(&x5,0,50,509);
    let p50j:i32=plant2(&x5,0,50,510);
    let p50k:i32=plant2(&x5,0,50,511);
    let p50l:i32=plant2(&x5,0,50,512);
    let p50m:i32=plant2(&x5,0,50,513);
    let p50n:i32=plant2(&x5,0,50,514);
    fails=ck("x5_kill_a",paid_delete(&x5,p50a,8741),ST_OK,fails);
    fails=ck("x5_kill_b",paid_delete(&x5,p50b,8742),ST_OK,fails);
    fails=ck("x5_kill_c",paid_delete(&x5,p50c,8743),ST_OK,fails);
    let ra:i32=plant2(&x5,1,20,515);
    let rb:i32=plant2(&x5,1,20,516);
    let rc:i32=plant2(&x5,1,20,517);
    fails=ck("x5_ra_price",delib_price(&x5,ra),0,fails);
    fails=ck("x5_ra_reasons",delib_reasons(&x5,ra),23|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("x5_rb_price",delib_price(&x5,rb),0,fails);
    fails=ck("x5_rb_reasons",delib_reasons(&x5,rb),23|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("x5_rc_price",delib_price(&x5,rc),0,fails);
    fails=ck("x5_rc_reasons",delib_reasons(&x5,rc),23|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("x5_untouched_d",delib_price(&x5,p50d),0,fails);
    fails=ck("x5_untouched_n",delib_price(&x5,p50n),0,fails);

    // ================= X6: r3 no-op WEAKEN at scale (ruling-1 evidence) =================
    let x6a:StStore=new_store();
    let n0:i32=plant2(&x6a,0,80,601);
    fails=ck("x6_n0_price",delib_price(&x6a,n0),1,fails);
    let x6b:StStore=new_store();
    let n1:i32=plant2(&x6b,0,80,602);
    fails=ck("x6_n1_weak",st_weaken(&x6b,n1,80,3),ST_OK,fails);
    fails=ck("x6_n1_price",delib_price(&x6b,n1),2,fails);
    let x6c:StStore=new_store();
    let n2:i32=plant2(&x6c,0,80,603);
    fails=ck("x6_n2_w1",st_weaken(&x6c,n2,80,3),ST_OK,fails);
    fails=ck("x6_n2_w2",st_weaken(&x6c,n2,80,3),ST_OK,fails);
    fails=ck("x6_n2_price",delib_price(&x6c,n2),2,fails);
    let x6d:StStore=new_store();
    let n10:i32=plant2(&x6d,0,80,604);
    let w10:i32=0;
    while(w10<10){st_weaken(&x6d,n10,80,3);w10=w10+1;}
    fails=ck("x6_n10_price",delib_price(&x6d,n10),2,fails);
    let x6e:StStore=new_store();
    let n50:i32=plant2(&x6e,0,80,605);
    let w50:i32=0;
    while(w50<50){st_weaken(&x6e,n50,80,3);w50=w50+1;}
    fails=ck("x6_n50_price",delib_price(&x6e,n50),2,fails);
    fails=ck("x6_n50_r3",delib_reasons(&x6e,n50),21|(26<<8)|(27<<16)|(30<<24),fails);
    let x6f:StStore=new_store();
    let nweak:i32=plant2(&x6f,0,20,606);
    let w10b:i32=0;
    while(w10b<10){st_weaken(&x6f,nweak,20,3);w10b=w10b+1;}
    fails=ck("x6_weak10_price",delib_price(&x6f,nweak),0,fails);
    let x6g:StStore=new_store();
    let ng:i32=plant2(&x6g,0,80,607);
    fails=ck("x6g_ow",paid_overwrite(&x6g,ng,0,80,8751),ST_OK,fails);
    fails=ck("x6g_noop",st_weaken(&x6g,ng,80,3),ST_OK,fails);
    fails=ck("x6g_price",delib_price(&x6g,ng),3,fails);
    fails=ck("x6g_reasons",delib_reasons(&x6g,ng),21|(26<<8)|(27<<16)|(29<<24),fails);
    let x6h:StStore=new_store();
    let nh:i32=plant2(&x6h,0,80,608);
    fails=ck("x6h_w1",st_weaken(&x6h,nh,70,3),ST_OK,fails);
    fails=ck("x6h_w2",st_weaken(&x6h,nh,60,3),ST_OK,fails);
    fails=ck("x6h_w3",st_weaken(&x6h,nh,50,3),ST_OK,fails);
    fails=ck("x6h_price",delib_price(&x6h,nh),2,fails);

    // ================= X7: founding asymmetry (ruling-3 evidence) =================
    let x7a:StStore=new_store();
    let fa:i32=plant2(&x7a,0,80,701);
    fails=ck("x7_add80_price",delib_price(&x7a,fa),1,fails);
    fails=ck("x7_add80_r4",delib_reasons(&x7a,fa),21|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("x7_ow80",paid_overwrite(&x7a,fa,0,80,8761),ST_OK,fails);
    fails=ck("x7_owfounded_price",delib_price(&x7a,fa),2,fails);
    fails=ck("x7_owfounded_r4",delib_reasons(&x7a,fa),21|(26<<8)|(28<<16)|(29<<24),fails);
    let x7b:StStore=new_store();
    let fb:i32=plant2(&x7b,0,30,702);
    fails=ck("x7_add30_price",delib_price(&x7b,fb),0,fails);
    fails=ck("x7_ow30",paid_overwrite(&x7b,fb,1,30,8762),ST_OK,fails);
    fails=ck("x7_ow30_price",delib_price(&x7b,fb),1,fails);
    fails=ck("x7_ow30_reasons",delib_reasons(&x7b,fb),22|(26<<8)|(28<<16)|(29<<24),fails);
    // fought inside the new generation counts from the founding
    fails=ck("x7_weaken_newgen",st_weaken(&x7a,fa,79,3),ST_OK,fails);
    fails=ck("x7_newgen_fought",delib_price(&x7a,fa),3,fails);

    // ================= X8: P3 x repair on a reused slot (ruling-2 evidence) =================
    let x8:StStore=new_store();
    st_set_p3(&x8,1,2);
    st_set_episode(&x8,1000);
    let p3s:i32=plant2(&x8,0,80,801);
    fails=ck("x8_ow_gen2",paid_overwrite(&x8,p3s,1,10,8771),ST_OK,fails);
    // the funding cite and the overwrite refreshed the slot's touch-episodes;
    // advance the clock so the protection genuinely lapses
    st_set_episode(&x8,10000);
    fails=ck("x8_p3_expired",st_p3_expired(&x8,p3s),1,fails);
    fails=ck("x8_ow_nodelib",st_overwrite(&x8,p3s,1,60,9999),122,fails);
    fails=ck("x8_delib_price",delib_price(&x8,p3s),0,fails);
    fails=ck("x8_delib_reasons",delib_reasons(&x8,p3s),23|(26<<8)|(28<<16)|(29<<24),fails);
    fails=ck("x8_justify",st_justify(&x8,p3s,4),ST_OK,fails);
    fails=ck("x8_ow_truth",st_overwrite(&x8,p3s,1,60,9999),ST_OK,fails);
    fails=ck("x8_value",slot_value(&x8,p3s),1,fails);

    // ================= X9: trainer kill path with repair =================
    let x9:StStore=new_store();
    let tk:i32=plant2(&x9,0,80,901);
    fails=ck("x9_ow_gen2",paid_overwrite(&x9,tk,0,20,8781),ST_OK,fails);
    fails=ck("x9_gen2_price",delib_price(&x9,tk),0,fails);
    fails=ck("x9_gen2_reasons",delib_reasons(&x9,tk),23|(26<<8)|(28<<16)|(29<<24),fails);
    fails=ck("x9_justify",st_justify(&x9,tk,4),ST_OK,fails);
    fails=ck("x9_trainer_kill",st_kill(&x9,tk,ST_ROLE_TRAINER,7),ST_OK,fails);
    fails=ck("x9_dead",slot_live(&x9,tk),0,fails);
    let x9b:StStore=new_store();
    let tk2:i32=plant2(&x9b,0,80,902);
    fails=ck("x9_tnn_kill_role",st_kill(&x9b,tk2,ST_ROLE_TNN,0),113,fails);
    fails=ck("x9_tnn_kill_live",slot_live(&x9b,tk2),1,fails);

    // ================= X10: cite-lock + tombstone across generations =================
    // S6 wedge shape: cite -> priced delete (consumes) -> rollback -> overwrite
    let x10:StStore=new_store();
    let cl:i32=plant2(&x10,0,80,1001);
    fails=ck("x10_delib",delib_price(&x10,cl),1,fails);
    fails=ck("x10_cite1",st_evidence(&x10,cl,4,9001),ST_OK,fails);
    fails=ck("x10_justify",st_justify(&x10,cl,4),ST_OK,fails);
    fails=ck("x10_delete",st_delete_strong(&x10,cl),ST_OK,fails);
    fails=ck("x10_rollback",st_rollback_last(&x10),ST_OK,fails);
    fails=ck("x10_ow_wedge",st_overwrite(&x10,cl,1,20,9999),121,fails);
    // fresh cites break the wedge (R6 property intact post-repair)
    fails=ck("x10_fresh_cite",st_evidence(&x10,cl,4,9002),ST_OK,fails);
    fails=ck("x10_ow_fresh",st_overwrite(&x10,cl,1,20,9999),ST_OK,fails);
    // tombstone does not wedge price-0 paths: cite the consumed ep BEFORE deliberate
    fails=ck("x10_cite_consumed",st_evidence(&x10,cl,4,9001),ST_OK,fails);
    fails=ck("x10_del_gen2",delib_price(&x10,cl),0,fails);
    fails=ck("x10_justify2",st_justify(&x10,cl,4),ST_OK,fails);
    fails=ck("x10_ow_price0",st_overwrite(&x10,cl,0,80,9999),ST_OK,fails);
    // but the old consumed cite funds nothing on a priced judgment (tombstone is global)
    // gen3 @80 overwrite-founded: STRONG hw +1, no sunk -1, unfought +0, revised +0 -> 2
    fails=ck("x10_del_gen3",delib_price(&x10,cl),2,fails);
    fails=ck("x10_justify3",st_justify(&x10,cl,4),ST_OK,fails);
    fails=ck("x10_cite_dead_ep",st_evidence(&x10,cl,4,9001),ST_OK,fails);
    fails=ck("x10_ow_dead_ep",st_overwrite(&x10,cl,1,30,9999),121,fails);
    fails=ck("x10_value_survives",slot_value(&x10,cl),0,fails);

    // ================= X11: revs scoping — ADD-founded gen after overwrite history =================
    // Hunk 2 of the repair: st_meter_revs counted EVERY overwrite the slot
    // ever saw ([0, epoch]); now only the current generation's founding event.
    // An ADD-founded generation on a slot with overwrite history must start
    // UNPROVEN (discount), not REVISED on dead generations' strength.
    let x11:StStore=new_store();
    let v:i32=plant2(&x11,0,80,1101);
    fails=ck("x11_g1_price",delib_price(&x11,v),1,fails);
    fails=ck("x11_g2_ow",paid_overwrite(&x11,v,0,60,8791),ST_OK,fails);
    fails=ck("x11_g2_price",delib_price(&x11,v),1,fails);
    fails=ck("x11_g2_reasons",delib_reasons(&x11,v),22|(26<<8)|(28<<16)|(29<<24),fails);
    fails=ck("x11_g2_del",paid_delete(&x11,v,8792),ST_OK,fails);
    fails=ck("x11_g2_dead",slot_live(&x11,v),0,fails);
    let v3:i32=plant2(&x11,1,30,1102);
    fails=ck("x11_g3_price",delib_price(&x11,v3),0,fails);
    fails=ck("x11_g3_reasons",delib_reasons(&x11,v3),22|(26<<8)|(28<<16)|(30<<24),fails);
    // and the overwrite-founded generation right after still prices REVISED
    fails=ck("x11_g3_ow",paid_overwrite(&x11,v3,0,30,8793),ST_OK,fails);
    fails=ck("x11_g4_price",delib_price(&x11,v3),1,fails);
    fails=ck("x11_g4_reasons",delib_reasons(&x11,v3),22|(26<<8)|(28<<16)|(29<<24),fails);

    _zag_print("EXT_DONE fails=");
    _zag_print(i64s(fails as i64));
    _zag_print("\n");
}

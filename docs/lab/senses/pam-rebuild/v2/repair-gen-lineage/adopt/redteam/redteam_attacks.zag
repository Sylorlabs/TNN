// redteam_attacks.zag — INDEPENDENT RED-TEAM ATTACKS on the quirk fixes.
// Pure Zag, zero RNG. Each attack attempts to break the generation-epoch or
// DELIB-scoping fixes. HOLD = fix withstood; KILL = attack succeeded.
@import("strength_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);_zag_print(" got=");
    _zag_print(i64s(got as i64));_zag_print(" want=");_zag_print(i64s(want as i64));
    _zag_print("\n");return fails+1;
}
fn mkstore()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn fundx(s:*StStore,slot:i32,cite_ep:i64)i32 {
    let p:i32=-1;
    let rc:i32=st_deliberate(s,slot,&p);
    if(rc!=ST_OK){return rc;}
    rc=st_justify(s,slot,4);
    if(rc!=ST_OK){return rc;}
    return st_evidence(s,slot,4,cite_ep);
}
fn lastok(s:*StStore,slot:i32,op:i32)i32 {
    let i:i32=s.*.audit_n-1;
    while(i>=0){
        if(st_aw(s,i,0)==op && st_aw(s,i,1)==slot && st_aw(s,i,4)==ST_OK){return i;}
        i=i-1;
    }
    return -1;
}
fn epochof(s:*StStore,slot:i32)i32 {return st_gen_epoch_start(s,slot,s.*.audit_n);}

fn atk1()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    let a:i32=-1;
    fails=ck("a1_add",st_add(&s,0,ST_REGION_USER,80,100,&a),ST_OK,fails);
    fails=ck("a1_fund",fundx(&s,a,8001),ST_OK,fails);
    fails=ck("a1_ow1",st_overwrite(&s,a,1,10,9999),ST_OK,fails);
    fails=ck("a1_rb",st_rollback_last(&s),ST_OK,fails);
    fails=ck("a1_fund2",fundx(&s,a,8002),ST_OK,fails);
    fails=ck("a1_fund2b",st_evidence(&s,a,4,8003),ST_OK,fails);
    fails=ck("a1_ow2",st_overwrite(&s,a,1,10,9999),ST_OK,fails);
    let ow2:i32=lastok(&s,a,ST_OP_OVERWRITE);
    fails=ck("a1_epoch_is_current",epochof(&s,a),ow2,fails);
    return fails;
}
fn atk2()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    let b:i32=-1;
    fails=ck("a2_add",st_add(&s,0,ST_REGION_USER,80,100,&b),ST_OK,fails);
    fails=ck("a2_fund",fundx(&s,b,8011),ST_OK,fails);
    fails=ck("a2_ow",st_overwrite(&s,b,1,10,9999),ST_OK,fails);
    fails=ck("a2_rb",st_rollback_last(&s),ST_OK,fails);
    let p:i32=-1;
    fails=ck("a2_delib",st_deliberate(&s,b,&p),ST_OK,fails);
    fails=ck("a2_price_not_zero",p>0,1,fails);
    fails=ck("a2_price_two",p,2,fails);
    return fails;
}
fn atk3()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    let c:i32=-1;
    fails=ck("a3_add",st_add(&s,0,ST_REGION_USER,80,100,&c),ST_OK,fails);
    let pf:i32=-1;
    fails=ck("a3_delib_fresh",st_deliberate(&s,c,&pf),ST_OK,fails);
    fails=ck("a3_fresh_price_one",pf,1,fails);
    fails=ck("a3_fund",fundx(&s,c,8021),ST_OK,fails);
    fails=ck("a3_ow",st_overwrite(&s,c,1,10,9999),ST_OK,fails);
    fails=ck("a3_rb",st_rollback_last(&s),ST_OK,fails);
    let pr:i32=-1;
    fails=ck("a3_delib_rebirth",st_deliberate(&s,c,&pr),ST_OK,fails);
    fails=ck("a3_rebirth_no_discount",pr>pf,1,fails);
    return fails;
}
fn atk4()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    st_set_price_mode(&s,ST_PRICE_DELIB);
    let d:i32=-1;
    fails=ck("a4_add",st_add(&s,0,ST_REGION_USER,80,100,&d),ST_OK,fails);
    fails=ck("a4_fund",fundx(&s,d,8031),ST_OK,fails);
    fails=ck("a4_fundb",st_evidence(&s,d,4,8032),ST_OK,fails);
    fails=ck("a4_ow",st_overwrite(&s,d,1,10,9999),ST_OK,fails);
    let p:i32=-1;
    fails=ck("a4_delib_hist",st_deliberate(&s,d,&p),ST_OK,fails);
    fails=ck("a4_hist_weak_price",p,0,fails);
    return fails;
}
fn atk5()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    let x:i32=-1;
    let y:i32=-1;
    fails=ck("a5_addx",st_add(&s,0,ST_REGION_USER,80,100,&x),ST_OK,fails);
    fails=ck("a5_addy",st_add(&s,0,ST_REGION_USER,90,100,&y),ST_OK,fails);
    fails=ck("a5_fundx",fundx(&s,x,8041),ST_OK,fails);
    fails=ck("a5_owx",st_overwrite(&s,x,1,10,9999),ST_OK,fails);
    fails=ck("a5_rbx",st_rollback_last(&s),ST_OK,fails);
    let rbx:i32=lastok(&s,x,ST_OP_ROLLBACK);
    let addy:i32=lastok(&s,y,ST_OP_ADD);
    fails=ck("a5_epoch_x",epochof(&s,x),rbx,fails);
    fails=ck("a5_epoch_y",epochof(&s,y),addy,fails);
    return fails;
}
fn atk6()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    let e:i32=-1;
    fails=ck("a6_add",st_add(&s,0,ST_REGION_USER,80,100,&e),ST_OK,fails);
    fails=ck("a6_fund",fundx(&s,e,8051),ST_OK,fails);
    fails=ck("a6_ow",st_overwrite(&s,e,1,10,9999),ST_OK,fails);
    fails=ck("a6_rb",st_rollback_last(&s),ST_OK,fails);
    let p:i32=-1;
    fails=ck("a6_delib",st_deliberate(&s,e,&p),ST_OK,fails);
    fails=ck("a6_price_no_old_cites",p,2,fails);
    return fails;
}
fn atk7()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    let f:i32=-1;
    fails=ck("a7_add",st_add(&s,0,ST_REGION_USER,80,100,&f),ST_OK,fails);
    fails=ck("a7_fund",fundx(&s,f,8061),ST_OK,fails);
    fails=ck("a7_ow",st_overwrite(&s,f,1,10,9999),ST_OK,fails);
    fails=ck("a7_rb1",st_rollback_last(&s),ST_OK,fails);
    let rb1:i32=lastok(&s,f,ST_OP_ROLLBACK);
    fails=ck("a7_rb2_refused",st_rollback_last(&s),ST_REFUSED_NOROLLBACK,fails);
    fails=ck("a7_epoch_stable",epochof(&s,f),rb1,fails);
    return fails;
}
fn atk8()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    let g:i32=-1;
    fails=ck("a8_bad_add",st_add(&s,0,ST_REGION_USER,150,100,&g),2001,fails);
    fails=ck("a8_good_add",st_add(&s,0,ST_REGION_USER,80,100,&g),ST_OK,fails);
    let addg:i32=lastok(&s,g,ST_OP_ADD);
    fails=ck("a8_epoch_is_good",epochof(&s,g),addg,fails);
    return fails;
}
fn atk9()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    let h:i32=-1;
    fails=ck("a9_add",st_add(&s,0,ST_REGION_USER,80,100,&h),ST_OK,fails);
    fails=ck("a9_pin",st_force_pin(&s,ST_ROLE_TRAINER,7,h),ST_OK,fails);
    let owrc:i32=st_overwrite(&s,h,1,10,9999);
    fails=ck("a9_ow_pinned_refused",owrc!=ST_OK,1,fails);
    return fails;
}
fn atk10()i32 {
    let fails:i32=0;
    let s:StStore=mkstore();
    let k:i32=-1;
    fails=ck("a10_add",st_add(&s,0,ST_REGION_USER,80,100,&k),ST_OK,fails);
    let p1:i32=-1;
    fails=ck("a10_delib1",st_deliberate(&s,k,&p1),ST_OK,fails);
    fails=ck("a10_justify",st_justify(&s,k,4),ST_OK,fails);
    fails=ck("a10_cite",st_evidence(&s,k,4,8081),ST_OK,fails);
    let rbrc:i32=st_rollback_last(&s);
    fails=ck("a10_rb_cite_refused",rbrc,ST_REFUSED_NOROLLBACK,fails);
    let p2:i32=-1;
    fails=ck("a10_delib2",st_deliberate(&s,k,&p2),ST_OK,fails);
    fails=ck("a10_price_stable",p1,p2,fails);
    return fails;
}

fn main()void {
    let fails:i32=0;
    fails=fails+atk1();
    fails=fails+atk2();
    fails=fails+atk3();
    fails=fails+atk4();
    fails=fails+atk5();
    fails=fails+atk6();
    fails=fails+atk7();
    fails=fails+atk8();
    fails=fails+atk9();
    fails=fails+atk10();
    if(fails==0){_zag_print("REDTEAM_DONE all attacks held\n");}
    else {_zag_print("REDTEAM_DONE KILLS=");_zag_print(i64s(fails as i64));_zag_print("\n");}
}

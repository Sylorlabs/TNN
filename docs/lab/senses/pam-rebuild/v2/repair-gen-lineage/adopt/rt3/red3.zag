// red3.zag — RED TEAM PORT VERIFICATION.
// Target: port_core.zag = canonical integrated core
//   (~/workspace/pamsv2_wt/docs/lab/strength-pricing-meter-adoption/src/strength_core.zag,
//    pristine SHA-256 d156278fab455d21d7a78f6493f0976dad071aecf081b73aa048ffc41f308dfa)
// with strength_core_genlineage.patch applied (patched SHA-256
//   003d622c782b3516a60007477cfcb41d5e41439217ac3d9db68cbc10cfe1f56b).
// Re-runs the key red1/red2 probes on the ported core. Pure Zag, zero RNG.
// NOTE: the canonical core carries GOV-C immediate-121 at cite time, so
// probes never re-cite consumed episodes and never over-cite (except K6,
// which asserts the immediate-121 itself).
@import("strength_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn plant(s:*StStore,val:i32,str:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,val,ST_REGION_USER,str,100,&sl);
    if(rc!=ST_OK){_zag_print("FATAL plant\n");}
    return sl;
}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
fn an(s:*StStore)i32 {return s.*.audit_n;}
fn slot_value(s:*StStore,slot:i32)i32 {return st_i32_get(s.*.value,slot*4);}
fn count_op_rc(s:*StStore,wantop:i32,wantrc:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<an(s)){
        if(st_aw(s,i,0)==wantop && st_aw(s,i,4)==wantrc){n=n+1;}
        i=i+1;
    }
    return n;
}
fn find_delib(s:*StStore,sl:i32)i32 {
    let di:i32=-1;
    let i:i32=0;
    while(i<an(s)){
        if(st_aw(s,i,0)==ST_OP_DELIBERATE && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){di=i;}
        i=i+1;
    }
    return di;
}

fn main()void {
    let fails:i32=0;
    let p:i32=-1;
    let di:i32=0;

    // ============ K1: S11B neuter on the port — corpse inheritance gone ============
    let k1:StStore=new_store();
    let v:i32=plant(&k1,0,80);
    fails=ck("k1_delib",st_deliberate(&k1,v,&p),ST_OK,fails);
    fails=ck("k1_price",p,1,fails);
    fails=ck("k1_justify",st_justify(&k1,v,4),ST_OK,fails);
    fails=ck("k1_cite",st_evidence(&k1,v,4,9101),ST_OK,fails);
    fails=ck("k1_kill",st_delete_strong(&k1,v),ST_OK,fails);
    let w:i32=plant(&k1,0,10);
    fails=ck("k1_reused_slot",w,v,fails);
    fails=ck("k1_delib2",st_deliberate(&k1,w,&p),ST_OK,fails);
    fails=ck("k1_price_repaired_0",p,0,fails);
    di=find_delib(&k1,w);
    fails=ck("k1_reasons_own_lineage",st_aw(&k1,di,13),23|(26<<8)|(28<<16)|(30<<24),fails);
    fails=ck("k1_justify2",st_justify(&k1,w,4),ST_OK,fails);
    fails=ck("k1_overwrite_installs",st_overwrite(&k1,w,1,60,9999),ST_OK,fails);
    fails=ck("k1_value_is_truth",slot_value(&k1,w),1,fails);
    fails=ck("k1_no_citelock",count_op_rc(&k1,ST_OP_CITELOCK,0),0,fails);

    // ============ K2: overwrite chain on the port — own-generation pricing ============
    let k2:StStore=new_store();
    let c1:i32=plant(&k2,0,80);
    fails=ck("k2_delib1",st_deliberate(&k2,c1,&p),ST_OK,fails);
    fails=ck("k2_justify1",st_justify(&k2,c1,4),ST_OK,fails);
    fails=ck("k2_cite1",st_evidence(&k2,c1,4,9201),ST_OK,fails);
    fails=ck("k2_ow1",st_overwrite(&k2,c1,0,60,9999),ST_OK,fails);
    fails=ck("k2_delib2",st_deliberate(&k2,c1,&p),ST_OK,fails);
    fails=ck("k2_price2_own_gen",p,1,fails);
    di=find_delib(&k2,c1);
    fails=ck("k2_r1_mid",st_aw(&k2,di,13)&255,22,fails);
    fails=ck("k2_r4_revised",((st_aw(&k2,di,13)>>24)&255),29,fails);
    fails=ck("k2_justify2",st_justify(&k2,c1,4),ST_OK,fails);
    fails=ck("k2_cite2",st_evidence(&k2,c1,4,9202),ST_OK,fails);
    fails=ck("k2_ow2",st_overwrite(&k2,c1,0,90,8888),ST_OK,fails);
    fails=ck("k2_delib3",st_deliberate(&k2,c1,&p),ST_OK,fails);
    fails=ck("k2_price3_own_peak",p,2,fails);

    // ============ K3: two kills then truth(30) on the port ============
    let k3:StStore=new_store();
    let d1:i32=plant(&k3,0,80);
    fails=ck("k3_delib1",st_deliberate(&k3,d1,&p),ST_OK,fails);
    fails=ck("k3_justify1",st_justify(&k3,d1,4),ST_OK,fails);
    fails=ck("k3_cite1",st_evidence(&k3,d1,4,9301),ST_OK,fails);
    fails=ck("k3_kill1",st_delete_strong(&k3,d1),ST_OK,fails);
    let d2:i32=plant(&k3,0,70);
    fails=ck("k3_delib2",st_deliberate(&k3,d2,&p),ST_OK,fails);
    fails=ck("k3_justify2",st_justify(&k3,d2,4),ST_OK,fails);
    fails=ck("k3_kill2",st_delete_strong(&k3,d2),ST_OK,fails);
    let d3:i32=plant(&k3,1,30);
    fails=ck("k3_reuse",d3,d1,fails);
    fails=ck("k3_delib3",st_deliberate(&k3,d3,&p),ST_OK,fails);
    fails=ck("k3_price3_0",p,0,fails);
    di=find_delib(&k3,d3);
    fails=ck("k3_r1_mid30",st_aw(&k3,di,13)&255,22,fails);
    fails=ck("k3_r3_unfought",((st_aw(&k3,di,13)>>16)&255),28,fails);
    fails=ck("k3_justify3",st_justify(&k3,d3,4),ST_OK,fails);
    fails=ck("k3_overwrite_truth2",st_overwrite(&k3,d3,2,31,9999),ST_OK,fails);
    fails=ck("k3_value",slot_value(&k3,d3),2,fails);

    // ============ K4: sunk premium enforced on the port ============
    let k4:StStore=new_store();
    let t:i32=plant(&k4,1,80);
    fails=ck("k4_c1",st_evidence(&k4,t,1,9401),ST_OK,fails);
    fails=ck("k4_c2",st_evidence(&k4,t,1,9402),ST_OK,fails);
    fails=ck("k4_c3",st_evidence(&k4,t,1,9403),ST_OK,fails);
    fails=ck("k4_str",st_strengthen(&k4,t,85,1),ST_OK,fails);
    fails=ck("k4_delib",st_deliberate(&k4,t,&p),ST_OK,fails);
    fails=ck("k4_price_3",p,3,fails);
    fails=ck("k4_justify",st_justify(&k4,t,4),ST_OK,fails);
    fails=ck("k4_pay1",st_evidence(&k4,t,4,9501),ST_OK,fails);
    fails=ck("k4_pay2",st_evidence(&k4,t,4,9502),ST_OK,fails);
    fails=ck("k4_underfunded_109",st_overwrite(&k4,t,0,20,9999),109,fails);
    fails=ck("k4_truth_survives",slot_value(&k4,t),1,fails);
    fails=ck("k4_pay3",st_evidence(&k4,t,4,9503),ST_OK,fails);
    fails=ck("k4_paid_displaces",st_overwrite(&k4,t,0,20,9999),ST_OK,fails);
    fails=ck("k4_value_false",slot_value(&k4,t),0,fails);

    // ============ K5: overwrite-founded truth on the port ============
    let k5:StStore=new_store();
    let e1:i32=plant(&k5,0,80);
    fails=ck("k5_delib",st_deliberate(&k5,e1,&p),ST_OK,fails);
    fails=ck("k5_justify",st_justify(&k5,e1,4),ST_OK,fails);
    fails=ck("k5_cite",st_evidence(&k5,e1,4,9601),ST_OK,fails);
    fails=ck("k5_kill",st_delete_strong(&k5,e1),ST_OK,fails);
    let e2:i32=plant(&k5,0,10);
    fails=ck("k5_delib2",st_deliberate(&k5,e2,&p),ST_OK,fails);
    fails=ck("k5_justify2",st_justify(&k5,e2,4),ST_OK,fails);
    fails=ck("k5_overwrite_truth",st_overwrite(&k5,e2,1,60,9999),ST_OK,fails);
    fails=ck("k5_delib3",st_deliberate(&k5,e2,&p),ST_OK,fails);
    fails=ck("k5_price3_1",p,1,fails);
    di=find_delib(&k5,e2);
    fails=ck("k5_r4_founding_overwrite",((st_aw(&k5,di,13)>>24)&255),29,fails);

    // ============ K6: canonical immediate-121 intact after the patch ============
    // Re-citing a consumed episode must refuse 121 AT CITE TIME on the port
    // (gov-c verdict; on the pinned-base core it defers to the gate).
    let k6:StStore=new_store();
    let f:i32=plant(&k6,0,80);
    fails=ck("k6_delib",st_deliberate(&k6,f,&p),ST_OK,fails);
    fails=ck("k6_justify",st_justify(&k6,f,4),ST_OK,fails);
    fails=ck("k6_cite",st_evidence(&k6,f,4,9701),ST_OK,fails);
    fails=ck("k6_kill",st_delete_strong(&k6,f),ST_OK,fails);
    let g:i32=plant(&k6,0,10);
    fails=ck("k6_recite_consumed_121",st_evidence(&k6,g,4,9701),121,fails);

    _zag_print("RED3_DONE fails=");
    _zag_print(i64s(fails as i64));
    _zag_print("\n");
}

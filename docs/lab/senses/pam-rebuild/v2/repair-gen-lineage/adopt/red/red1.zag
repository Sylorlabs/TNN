// red1.zag — RED TEAM, DIRECTION 1: smuggle a FALSEHOOD past the repaired gate.
// Target: red_core.zag (patched core SHA-256
//   98bba0dbc950aea51140a2042983d035b05c733a5588bcd298fcad27a9379e78).
// Pure Zag, zero RNG. Each attack is a fresh store; PASS/FAIL lines.
// Kill bar: a falsehood displacing a TRUE protected memory at BELOW its
// honest (current-generation) price, or any epoch advance without a priced
// destruction, or any cross-generation price inheritance => REPAIR VOIDED.
@import("red_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn plant(s:*StStore,val:i32,str:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,val,ST_REGION_USER,str,100,&sl);
    if(rc!=ST_OK){_zag_print("FATAL plant\n");}
    return sl;
}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
fn an(s:*StStore)i32 {return s.*.audit_n;}
fn slot_value(s:*StStore,slot:i32)i32 {return st_i32_get(s.*.value,slot*4);}
fn epoch_of(s:*StStore,slot:i32)i32 {return st_delib_epoch_start(s,slot,an(s));}
fn count_op_rc(s:*StStore,wantop:i32,wantrc:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<an(s)){
        if(st_aw(s,i,0)==wantop && st_aw(s,i,4)==wantrc){n=n+1;}
        i=i+1;
    }
    return n;
}
fn count_ok_found(s:*StStore,slot:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<an(s)){
        let op:i32=st_aw(s,i,0);
        if((op==ST_OP_ADD || op==ST_OP_OVERWRITE) && st_aw(s,i,1)==slot && st_aw(s,i,4)==ST_OK){n=n+1;}
        i=i+1;
    }
    return n;
}
fn find_delib(s:*StStore,sl:i32)i32 {
    let di:i32=-1;
    let i:i32=0;
    while(i<an(s)){
        if(st_aw(s,i,0)==ST_OP_DELIBERATE && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){di=i;}
        i=i+1;
    }
    return di;
}

fn main()void {
    let fails:i32=0;
    let p:i32=-1;
    let di:i32=0;

    // ============ A1: forced epoch advance on a LIVE slot ============
    // Attack: fill every slot, then try to force an ADD onto the live slot;
    // then try a failed overwrite. Either must not move the epoch.
    let a1:StStore=new_store();
    let f1:i32=plant(&a1,0,80);
    let q:i32=0;
    while(q<15){plant(&a1,9,10);q=q+1;}
    let e0:i32=epoch_of(&a1,f1);
    let n0:i32=count_ok_found(&a1,f1);
    let out:i32=-7;
    let rca:i32=st_add(&a1,9,ST_REGION_USER,10,200,&out);
    fails=ck("a1_add_full_refused",rca,ST_REFUSED_FULL,fails);
    fails=ck("a1_add_no_slot",out,-1,fails);
    fails=ck("a1_epoch_unmoved",epoch_of(&a1,f1),e0,fails);
    fails=ck("a1_foundcount_unmoved",count_ok_found(&a1,f1),n0,fails);
    // gate precedence: no bound deliberate -> 122 fires before the cite check,
    // so bind first, then probe the cite-count refusal (109).
    fails=ck("a1_delib",st_deliberate(&a1,f1,&p),ST_OK,fails);
    fails=ck("a1_justify",st_justify(&a1,f1,4),ST_OK,fails);
    fails=ck("a1_overwrite_nocite_109",st_overwrite(&a1,f1,1,60,9999),109,fails);
    fails=ck("a1_epoch_unmoved2",epoch_of(&a1,f1),e0,fails);
    fails=ck("a1_price_honest_still_1",p,1,fails);

    // A1b: with a free slot, ADD lands on the FREE slot, never the live one.
    let a1b:StStore=new_store();
    let g1:i32=plant(&a1b,0,80);
    let e0b:i32=epoch_of(&a1b,g1);
    let outb:i32=-7;
    fails=ck("a1b_add_ok",st_add(&a1b,9,ST_REGION_USER,10,200,&outb),ST_OK,fails);
    fails=ck("a1b_lands_free_slot",outb,1,fails);
    fails=ck("a1b_victim_epoch_unmoved",epoch_of(&a1b,g1),e0b,fails);

    // ============ A2: weak plant + grow — the peak must price honestly ============
    let a2:StStore=new_store();
    let w:i32=plant(&a2,0,10);
    fails=ck("a2_delib",st_deliberate(&a2,w,&p),ST_OK,fails);
    fails=ck("a2_weak_price_0",p,0,fails);
    fails=ck("a2_str1",st_strengthen(&a2,w,50,1),ST_OK,fails);
    fails=ck("a2_str2",st_strengthen(&a2,w,90,1),ST_OK,fails);
    fails=ck("a2_delib2",st_deliberate(&a2,w,&p),ST_OK,fails);
    fails=ck("a2_grown_prices_peak",p,1,fails);
    di=find_delib(&a2,w);
    fails=ck("a2_r1_own_peak_strong",st_aw(&a2,di,13)&255,21,fails);

    // A2b: launder via weak-then-overwrite — must cost MORE, not less.
    let a2b:StStore=new_store();
    let w2:i32=plant(&a2b,0,10);
    fails=ck("a2b_delib",st_deliberate(&a2b,w2,&p),ST_OK,fails);
    fails=ck("a2b_justify",st_justify(&a2b,w2,4),ST_OK,fails);
    fails=ck("a2b_overwrite_strong_at_0",st_overwrite(&a2b,w2,0,90,9999),ST_OK,fails);
    fails=ck("a2b_delib2",st_deliberate(&a2b,w2,&p),ST_OK,fails);
    fails=ck("a2b_laundered_price_2",p,2,fails);
    di=find_delib(&a2b,w2);
    fails=ck("a2b_r1_own_peak",st_aw(&a2b,di,13)&255,21,fails);
    fails=ck("a2b_r4_founding_overwrite",((st_aw(&a2b,di,13)>>24)&255),29,fails);

    // A2c: the sunk premium is PAID at the overwrite, not shed by it.
    let a2c:StStore=new_store();
    let v2:i32=plant(&a2c,0,80);
    fails=ck("a2c_c1",st_evidence(&a2c,v2,1,6001),ST_OK,fails);
    fails=ck("a2c_c2",st_evidence(&a2c,v2,1,6002),ST_OK,fails);
    fails=ck("a2c_c3",st_evidence(&a2c,v2,1,6003),ST_OK,fails);
    fails=ck("a2c_str",st_strengthen(&a2c,v2,85,1),ST_OK,fails);
    fails=ck("a2c_delib",st_deliberate(&a2c,v2,&p),ST_OK,fails);
    fails=ck("a2c_price_sunk_3",p,3,fails);
    fails=ck("a2c_justify",st_justify(&a2c,v2,4),ST_OK,fails);
    fails=ck("a2c_pay1",st_evidence(&a2c,v2,4,7001),ST_OK,fails);
    fails=ck("a2c_pay2",st_evidence(&a2c,v2,4,7002),ST_OK,fails);
    fails=ck("a2c_pay3",st_evidence(&a2c,v2,4,7003),ST_OK,fails);
    fails=ck("a2c_overwrite_paid_premium",st_overwrite(&a2c,v2,0,90,9999),ST_OK,fails);
    fails=ck("a2c_delib2",st_deliberate(&a2c,v2,&p),ST_OK,fails);
    fails=ck("a2c_newgen_no_sunk_carry",p,2,fails);

    // ============ A3: overwrite chain — no cross-generation inheritance ============
    let a3:StStore=new_store();
    let c1:i32=plant(&a3,0,80);
    fails=ck("a3_delib1",st_deliberate(&a3,c1,&p),ST_OK,fails);
    fails=ck("a3_justify1",st_justify(&a3,c1,4),ST_OK,fails);
    fails=ck("a3_cite1",st_evidence(&a3,c1,4,9001),ST_OK,fails);
    fails=ck("a3_ow1",st_overwrite(&a3,c1,0,60,9999),ST_OK,fails);
    fails=ck("a3_delib2",st_deliberate(&a3,c1,&p),ST_OK,fails);
    fails=ck("a3_price2_own_gen",p,1,fails);
    di=find_delib(&a3,c1);
    fails=ck("a3_r1_mid_not_corpse80",st_aw(&a3,di,13)&255,22,fails);
    fails=ck("a3_r4_revised",((st_aw(&a3,di,13)>>24)&255),29,fails);
    fails=ck("a3_r3_unfought",((st_aw(&a3,di,13)>>16)&255),28,fails);
    fails=ck("a3_justify2",st_justify(&a3,c1,4),ST_OK,fails);
    fails=ck("a3_cite2",st_evidence(&a3,c1,4,9002),ST_OK,fails);
    fails=ck("a3_ow2",st_overwrite(&a3,c1,0,90,8888),ST_OK,fails);
    fails=ck("a3_delib3",st_deliberate(&a3,c1,&p),ST_OK,fails);
    fails=ck("a3_price3_own_peak",p,2,fails);
    di=find_delib(&a3,c1);
    fails=ck("a3_r1_strong_own90",st_aw(&a3,di,13)&255,21,fails);
    fails=ck("a3_r2_none",((st_aw(&a3,di,13)>>8)&255),26,fails);

    // ============ A4: sunk-cite premium cannot be shed by the attacker ============
    let a4:StStore=new_store();
    let t:i32=plant(&a4,1,80);
    fails=ck("a4_c1",st_evidence(&a4,t,1,6001),ST_OK,fails);
    fails=ck("a4_c2",st_evidence(&a4,t,1,6002),ST_OK,fails);
    fails=ck("a4_c3",st_evidence(&a4,t,1,6003),ST_OK,fails);
    fails=ck("a4_str",st_strengthen(&a4,t,85,1),ST_OK,fails);
    fails=ck("a4_delib",st_deliberate(&a4,t,&p),ST_OK,fails);
    fails=ck("a4_price_3",p,3,fails);
    // attack 1: under-fund by one -> 109, TRUE survives.
    fails=ck("a4_atk1_c1",st_evidence(&a4,t,4,7001),ST_OK,fails);
    fails=ck("a4_atk1_c2",st_evidence(&a4,t,4,7002),ST_OK,fails);
    fails=ck("a4_atk1_justify",st_justify(&a4,t,4),ST_OK,fails);
    fails=ck("a4_atk1_109",st_overwrite(&a4,t,0,20,9999),109,fails);
    fails=ck("a4_atk1_truth_survives",slot_value(&a4,t),1,fails);
    // attack 2: deliberate-then-mutate must fail CLOSED (122), not discount.
    fails=ck("a4_atk2_delib",st_deliberate(&a4,t,&p),ST_OK,fails);
    fails=ck("a4_atk2_weaken",st_weaken(&a4,t,70,3),ST_OK,fails);
    fails=ck("a4_atk2_122",st_overwrite(&a4,t,0,20,9999),122,fails);
    fails=ck("a4_atk2_truth_survives",slot_value(&a4,t),1,fails);
    // attack 2 consequence: mutation RAISED the honest price (3 -> 4).
    fails=ck("a4_atk3_delib",st_deliberate(&a4,t,&p),ST_OK,fails);
    fails=ck("a4_atk3_price_4",p,4,fails);
    fails=ck("a4_atk3_justify",st_justify(&a4,t,4),ST_OK,fails);
    fails=ck("a4_atk3_c1",st_evidence(&a4,t,4,8001),ST_OK,fails);
    fails=ck("a4_atk3_c2",st_evidence(&a4,t,4,8002),ST_OK,fails);
    fails=ck("a4_atk3_c3",st_evidence(&a4,t,4,8003),ST_OK,fails);
    fails=ck("a4_atk3_c4",st_evidence(&a4,t,4,8004),ST_OK,fails);
    fails=ck("a4_atk3_paid_full",st_overwrite(&a4,t,0,20,9999),ST_OK,fails);
    fails=ck("a4_atk3_false_installed",slot_value(&a4,t),0,fails);
    // Tombstone (S-D6) post-repair: on the pinned-base core the consumed
    // re-cite is accepted at CITE time; the tombstone fires at the GATE.
    // (Immediate-121 at cite time is canonical-core-only, gov-c verdict.)
    fails=ck("a4_str",st_strengthen(&a4,t,80,1),ST_OK,fails);
    fails=ck("a4_delib_newgen",st_deliberate(&a4,t,&p),ST_OK,fails);
    fails=ck("a4_price_newgen_2",p,2,fails);
    fails=ck("a4_justify_newgen",st_justify(&a4,t,4),ST_OK,fails);
    fails=ck("a4_recite_citetime_ok",st_evidence(&a4,t,4,8001),ST_OK,fails);
    fails=ck("a4_fresh_cite",st_evidence(&a4,t,4,9001),ST_OK,fails);
    fails=ck("a4_tombstone_gate_121",st_overwrite(&a4,t,1,81,9999),121,fails);
    // No CITELOCK signal: ep 9001 is fresh and usable, so the slot is not
    // wedged (the signal fires only when every funding-window cite is spent).
    fails=ck("a4_no_citelock_fresh_exists",count_op_rc(&a4,ST_OP_CITELOCK,0),0,fails);
    fails=ck("a4_false_survives",slot_value(&a4,t),0,fails);
    // The wedge breaks with genuinely fresh episodes (R6 property, post-repair).
    fails=ck("a4_fresh_cite2",st_evidence(&a4,t,4,9002),ST_OK,fails);
    fails=ck("a4_fresh_breaks_wedge",st_overwrite(&a4,t,1,81,9999),ST_OK,fails);
    fails=ck("a4_value_truth",slot_value(&a4,t),1,fails);

    // ============ A5: control — the gate is economic, exact price displaces ============
    let a5:StStore=new_store();
    let u:i32=plant(&a5,1,80);
    fails=ck("a5_delib",st_deliberate(&a5,u,&p),ST_OK,fails);
    fails=ck("a5_justify",st_justify(&a5,u,4),ST_OK,fails);
    fails=ck("a5_nocite_109",st_overwrite(&a5,u,0,20,9999),109,fails);
    fails=ck("a5_cite",st_evidence(&a5,u,4,5001),ST_OK,fails);
    fails=ck("a5_paid_displaces",st_overwrite(&a5,u,0,20,9999),ST_OK,fails);
    fails=ck("a5_value",slot_value(&a5,u),0,fails);

    _zag_print("RED1_DONE fails=");
    _zag_print(i64s(fails as i64));
    _zag_print("\n");
}

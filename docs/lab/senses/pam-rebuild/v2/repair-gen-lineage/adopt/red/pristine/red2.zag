// red2.zag — RED TEAM, DIRECTION 2: is any legitimate truth still refused?
// Target: red_core.zag (patched core SHA-256
//   98bba0dbc950aea51140a2042983d035b05c733a5588bcd298fcad27a9379e78).
// Pure Zag, zero RNG. Each probe is a fresh store; PASS/FAIL lines.
// Kill bar: a truth the repaired mechanism's own logic says to accept, but
// which the gate refuses (rc != ST_OK when fully funded per its own price)
// => REPAIR INCOMPLETE. Price inputs that merely RAISE an honest price are
// policy (adopted meter table), not incompleteness — only refusals count.
@import("red_core.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    let o:[]u8=nio_alloc(n);
    let i:i32=0;
    while(i<n){o[i]=s[i];i=i+1;}
    nio_free(s);
    return o;
}
fn new_store()StStore {
    let s:StStore=st_init(16,32768);
    st_set_cite_mode(&s,ST_CITE_GLOBAL);
    st_set_price_mode(&s,ST_PRICE_METER);
    st_set_delib_personality(&s,ST_DELIB_HIST);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn plant(s:*StStore,val:i32,str:i32)i32 {
    let sl:i32=-1;
    let rc:i32=st_add(s,val,ST_REGION_USER,str,100,&sl);
    if(rc!=ST_OK){_zag_print("FATAL plant\n");}
    return sl;
}
fn ck(name:[]u8,got:i32,want:i32,fails:i32)i32 {
    if(got==want){_zag_print("PASS ");_zag_print(name);_zag_print("\n");return fails;}
    _zag_print("FAIL ");_zag_print(name);
    _zag_print(" got=");_zag_print(i64s(got as i64));
    _zag_print(" want=");_zag_print(i64s(want as i64));_zag_print("\n");
    return fails+1;
}
fn an(s:*StStore)i32 {return s.*.audit_n;}
fn slot_value(s:*StStore,slot:i32)i32 {return st_i32_get(s.*.value,slot*4);}
fn slot_live(s:*StStore,slot:i32)i32 {return s.*.live[slot] as i32;}
fn count_op_rc(s:*StStore,wantop:i32,wantrc:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    while(i<an(s)){
        if(st_aw(s,i,0)==wantop && st_aw(s,i,4)==wantrc){n=n+1;}
        i=i+1;
    }
    return n;
}
fn find_delib(s:*StStore,sl:i32)i32 {
    let di:i32=-1;
    let i:i32=0;
    while(i<an(s)){
        if(st_aw(s,i,0)==ST_OP_DELIBERATE && st_aw(s,i,1)==sl && st_aw(s,i,4)==ST_OK){di=i;}
        i=i+1;
    }
    return di;
}
fn main()void {
    let fails:i32=0;
    let p:i32=-1;
    let di:i32=0;

    // ============ B1: truth after TWO kills on the same slot ============
    let b1:StStore=new_store();
    let f1:i32=plant(&b1,0,80);
    fails=ck("b1_delib1",st_deliberate(&b1,f1,&p),ST_OK,fails);
    fails=ck("b1_price1",p,1,fails);
    fails=ck("b1_justify1",st_justify(&b1,f1,4),ST_OK,fails);
    fails=ck("b1_cite1",st_evidence(&b1,f1,4,8101),ST_OK,fails);
    fails=ck("b1_kill1",st_delete_strong(&b1,f1),ST_OK,fails);
    let f2:i32=plant(&b1,0,70);
    fails=ck("b1_reuse1",f2,f1,fails);
    fails=ck("b1_delib2",st_deliberate(&b1,f2,&p),ST_OK,fails);
    fails=ck("b1_price2_own_gen",p,0,fails);
    fails=ck("b1_justify2",st_justify(&b1,f2,4),ST_OK,fails);
    fails=ck("b1_kill2",st_delete_strong(&b1,f2),ST_OK,fails);
    let t3:i32=plant(&b1,1,30);
    fails=ck("b1_reuse2",t3,f1,fails);
    // R11B order: re-cite BEFORE any deliberate binds (no bound price yet,
    // so the cite-full gate is skipped) — the repair's core claim at 3 gens.
    // ADOPTION 2026-09-27: GOV-C VARIANT A (commit 0447f09df, pre-existing —
    // verified identical on the pre-fix HEAD core 003d622c): episode 8101 was
    // consumed by f1's DELETE_STRONG, so the tombstone refuses the re-cite
    // 121 at cite time (store-wide under ST_CITE_GLOBAL). The generation-
    // scoping assertions below (price 0 on own generation, reasons) hold
    // unchanged — only the tombstoned recite is refused.
    fails=ck("b1_recite_consumed",st_evidence(&b1,t3,4,8101),ST_REFUSED_CONSUMED,fails);
    fails=ck("b1_delib3",st_deliberate(&b1,t3,&p),ST_OK,fails);
    fails=ck("b1_price3_own_gen_0",p,0,fails);
    di=find_delib(&b1,t3);
    fails=ck("b1_r1_mid30_not_corpse",st_aw(&b1,di,13)&255,22,fails);
    fails=ck("b1_r2_none",((st_aw(&b1,di,13)>>8)&255),26,fails);
    fails=ck("b1_r3_unfought",((st_aw(&b1,di,13)>>16)&255),28,fails);
    fails=ck("b1_r4_unproven",((st_aw(&b1,di,13)>>24)&255),30,fails);
    fails=ck("b1_justify3",st_justify(&b1,t3,4),ST_OK,fails);
    fails=ck("b1_overwrite_truth2",st_overwrite(&b1,t3,2,31,9999),ST_OK,fails);
    fails=ck("b1_value_truth2",slot_value(&b1,t3),2,fails);
    fails=ck("b1_no_citelock",count_op_rc(&b1,ST_OP_CITELOCK,0),0,fails);

    // B1d: deliberate(0) FIRST, then cite -> 122 (exact-count law at price 0:
    // the price is already exactly met, so any cite is over-funding). This
    // is NOT a truth refusal: the overwrite still succeeds with 0 cites.
    let b1d:StStore=new_store();
    let m1:i32=plant(&b1d,0,80);
    fails=ck("b1d_delib",st_deliberate(&b1d,m1,&p),ST_OK,fails);
    fails=ck("b1d_justify",st_justify(&b1d,m1,4),ST_OK,fails);
    fails=ck("b1d_cite",st_evidence(&b1d,m1,4,8701),ST_OK,fails);
    fails=ck("b1d_kill",st_delete_strong(&b1d,m1),ST_OK,fails);
    let m2:i32=plant(&b1d,1,30);
    fails=ck("b1d_delib2",st_deliberate(&b1d,m2,&p),ST_OK,fails);
    fails=ck("b1d_price2_0",p,0,fails);
    fails=ck("b1d_cite_at_price0_122",st_evidence(&b1d,m2,4,8702),122,fails);
    fails=ck("b1d_justify2",st_justify(&b1d,m2,4),ST_OK,fails);
    fails=ck("b1d_overwrite_zero_cites_ok",st_overwrite(&b1d,m2,2,31,9999),ST_OK,fails);
    fails=ck("b1d_value",slot_value(&b1d,m2),2,fails);

    // B1c: STRONG truth on a thrice-reused slot prices its OWN peak only.
    let b1c:StStore=new_store();
    let c1:i32=plant(&b1c,0,80);
    fails=ck("b1c_delib",st_deliberate(&b1c,c1,&p),ST_OK,fails);
    fails=ck("b1c_justify",st_justify(&b1c,c1,4),ST_OK,fails);
    fails=ck("b1c_cite",st_evidence(&b1c,c1,4,8201),ST_OK,fails);
    fails=ck("b1c_kill",st_delete_strong(&b1c,c1),ST_OK,fails);
    let c2:i32=plant(&b1c,0,70);
    fails=ck("b1c_delib2",st_deliberate(&b1c,c2,&p),ST_OK,fails);
    fails=ck("b1c_justify2",st_justify(&b1c,c2,4),ST_OK,fails);
    fails=ck("b1c_kill2",st_delete_strong(&b1c,c2),ST_OK,fails);
    let c3:i32=plant(&b1c,1,80);
    fails=ck("b1c_reuse",c3,c1,fails);
    fails=ck("b1c_delib3",st_deliberate(&b1c,c3,&p),ST_OK,fails);
    fails=ck("b1c_price3_own_peak_1",p,1,fails);
    di=find_delib(&b1c,c3);
    fails=ck("b1c_r1_strong_own",st_aw(&b1c,di,13)&255,21,fails);
    fails=ck("b1c_justify3",st_justify(&b1c,c3,4),ST_OK,fails);
    fails=ck("b1c_cite3",st_evidence(&b1c,c3,4,8202),ST_OK,fails);
    fails=ck("b1c_overwrite_truth2",st_overwrite(&b1c,c3,2,81,9999),ST_OK,fails);
    fails=ck("b1c_value",slot_value(&b1c,c3),2,fails);

    // ============ B2: overwrite-founded truth on a reused slot ============
    let b2:StStore=new_store();
    let d1:i32=plant(&b2,0,80);
    fails=ck("b2_delib",st_deliberate(&b2,d1,&p),ST_OK,fails);
    fails=ck("b2_justify",st_justify(&b2,d1,4),ST_OK,fails);
    fails=ck("b2_cite",st_evidence(&b2,d1,4,8301),ST_OK,fails);
    fails=ck("b2_kill",st_delete_strong(&b2,d1),ST_OK,fails);
    let d2:i32=plant(&b2,0,10);
    fails=ck("b2_reuse",d2,d1,fails);
    fails=ck("b2_delib2",st_deliberate(&b2,d2,&p),ST_OK,fails);
    fails=ck("b2_price2_0",p,0,fails);
    fails=ck("b2_justify2",st_justify(&b2,d2,4),ST_OK,fails);
    fails=ck("b2_overwrite_truth",st_overwrite(&b2,d2,1,60,9999),ST_OK,fails);
    fails=ck("b2_delib3",st_deliberate(&b2,d2,&p),ST_OK,fails);
    fails=ck("b2_price3_own_gen_1",p,1,fails);
    di=find_delib(&b2,d2);
    fails=ck("b2_r4_founding_overwrite_seen",((st_aw(&b2,di,13)>>24)&255),29,fails);
    fails=ck("b2_r1_mid_own60",st_aw(&b2,di,13)&255,22,fails);
    fails=ck("b2_justify3",st_justify(&b2,d2,4),ST_OK,fails);
    fails=ck("b2_cite3",st_evidence(&b2,d2,4,8302),ST_OK,fails);
    fails=ck("b2_overwrite_truth2",st_overwrite(&b2,d2,2,61,9999),ST_OK,fails);
    fails=ck("b2_value",slot_value(&b2,d2),2,fails);

    // ============ B3: no-op WEAKEN must not refuse a truth ============
    let b3:StStore=new_store();
    let e1:i32=plant(&b3,1,60);
    fails=ck("b3_noop_weaken",st_weaken(&b3,e1,60,3),ST_OK,fails);
    fails=ck("b3_delib",st_deliberate(&b3,e1,&p),ST_OK,fails);
    fails=ck("b3_price_fought_1",p,1,fails);
    fails=ck("b3_justify",st_justify(&b3,e1,4),ST_OK,fails);
    fails=ck("b3_cite",st_evidence(&b3,e1,4,8401),ST_OK,fails);
    fails=ck("b3_overwrite_truth2",st_overwrite(&b3,e1,2,61,9999),ST_OK,fails);
    fails=ck("b3_value",slot_value(&b3,e1),2,fails);
    // weak truth (20 <= 25 -> WEAK) + no-op weaken: the +1 fought is absorbed
    // by the floor, price stays 0, truth installs with 0 cites.
    let b3b:StStore=new_store();
    let e2:i32=plant(&b3b,1,20);
    fails=ck("b3b_noop_weaken",st_weaken(&b3b,e2,20,3),ST_OK,fails);
    fails=ck("b3b_delib",st_deliberate(&b3b,e2,&p),ST_OK,fails);
    fails=ck("b3b_price_floor_0",p,0,fails);
    fails=ck("b3b_justify",st_justify(&b3b,e2,4),ST_OK,fails);
    fails=ck("b3b_overwrite_truth2",st_overwrite(&b3b,e2,2,21,9999),ST_OK,fails);
    fails=ck("b3b_value",slot_value(&b3b,e2),2,fails);

    // ============ B4: exactly-P boundary on a repair-changed price ============
    // Post-repair an ADD-founded 80 on a reused slot prices 1 (was 2).
    let b4:StStore=new_store();
    let g1:i32=plant(&b4,0,80);
    fails=ck("b4_delib",st_deliberate(&b4,g1,&p),ST_OK,fails);
    fails=ck("b4_justify",st_justify(&b4,g1,4),ST_OK,fails);
    fails=ck("b4_cite",st_evidence(&b4,g1,4,8501),ST_OK,fails);
    fails=ck("b4_kill",st_delete_strong(&b4,g1),ST_OK,fails);
    let g2:i32=plant(&b4,1,80);
    fails=ck("b4_delib2",st_deliberate(&b4,g2,&p),ST_OK,fails);
    fails=ck("b4_price_repaired_1",p,1,fails);
    fails=ck("b4_justify2",st_justify(&b4,g2,4),ST_OK,fails);
    fails=ck("b4_under_109",st_overwrite(&b4,g2,2,81,9999),109,fails);
    fails=ck("b4_cite2",st_evidence(&b4,g2,4,8502),ST_OK,fails);
    fails=ck("b4_cite3_over_122",st_evidence(&b4,g2,4,8503),122,fails);
    fails=ck("b4_exact_installs",st_overwrite(&b4,g2,2,81,9999),ST_OK,fails);
    fails=ck("b4_value",slot_value(&b4,g2),2,fails);

    // ============ B5: epoch<0 reachability — can a live slot lack a founding? ============
    let b5:StStore=new_store();
    let h1:i32=plant(&b5,1,40);
    fails=ck("b5_live_before",slot_live(&b5,h1),1,fails);
    fails=ck("b5_rollback_founding",st_rollback_last(&b5),ST_OK,fails);
    fails=ck("b5_dead_after_rollback",slot_live(&b5,h1),0,fails);
    // A dead slot re-added founds a fresh epoch; no live-without-founding path.
    let h2:i32=plant(&b5,1,40);
    fails=ck("b5_readd_founds",h2,h1,fails);
    fails=ck("b5_live_again",slot_live(&b5,h2),1,fails);
    fails=ck("b5_delib",st_deliberate(&b5,h2,&p),ST_OK,fails);
    fails=ck("b5_price",p,0,fails);

    // ============ B6: fought must not leak across generations ============
    let b6:StStore=new_store();
    let k1:i32=plant(&b6,0,80);
    fails=ck("b6_weaken",st_weaken(&b6,k1,70,3),ST_OK,fails);
    fails=ck("b6_delib",st_deliberate(&b6,k1,&p),ST_OK,fails);
    fails=ck("b6_price_fought_2",p,2,fails);
    fails=ck("b6_justify",st_justify(&b6,k1,4),ST_OK,fails);
    fails=ck("b6_cite1",st_evidence(&b6,k1,4,8601),ST_OK,fails);
    fails=ck("b6_cite2",st_evidence(&b6,k1,4,8602),ST_OK,fails);
    fails=ck("b6_kill",st_delete_strong(&b6,k1),ST_OK,fails);
    let k2:i32=plant(&b6,1,30);
    fails=ck("b6_reuse",k2,k1,fails);
    fails=ck("b6_delib2",st_deliberate(&b6,k2,&p),ST_OK,fails);
    fails=ck("b6_price2_0",p,0,fails);
    di=find_delib(&b6,k2);
    fails=ck("b6_r3_unfought_no_leak",((st_aw(&b6,di,13)>>16)&255),28,fails);
    fails=ck("b6_r1_mid30_no_leak",st_aw(&b6,di,13)&255,22,fails);

    _zag_print("RED2_DONE fails=");
    _zag_print(i64s(fails as i64));
    _zag_print("\n");
}

// glide_gate.zag — PTC-2 glide veto gate.
// Pure Zag, zero RNG, deterministic. Reads a TSV of R2-2 pitchdisc install
// records: <fixture>\t<gl_b>\t<installed>\t<was_false_install>
// (gl_b is fe_t4's glide flag: 7=glide detected, 0=no glide).
// Applies the KNOWLEDGE gate: if gl_b>0, WITHHOLD (do not install).
// Counts false installs that would have been prevented.
//
// R2-2 finding (measured 2026-09-23): all 400 PTC-2 false installs have
// gl_b>0 (267 with 7, 109 with 1, 24 with 2); all 722 clean installed
// PTC-1/PTC-3/normal have gl_b=0. The frozen contract ignores gl_b
// (no pitch false-bank entry; auto-installs when df>=2e18). This gate
// uses the signal the front end already computed.
//
// Usage: glide_gate <records.tsv>
// stdout: "prevented=<n> total_false=<n>\n"

@import("R33_NATIVE_IO_V1.zag")

fn z_cstr(s:[]u8) []u8 {
    let n:i64 = s.len as i64;
    let b:[]u8 = nio_alloc((n + 1) as i32);
    let i:i64 = 0;
    while(i < n) { b[i as i32] = s[i as i32]; i = i + 1; }
    b[n as i32] = 0;
    return b;
}

fn z_read(path:[]u8, buf:[]u8, cap:i64) i64 {
    let p:[]u8 = z_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(p) as i64, 0, 0, 0, 0, 0);
    if(fd < 0) { return -1; }
    let r:i64 = nio_read_exact(fd, buf, cap as i32);
    let cc:i64 = nio_close(fd);
    if(cc != 0) { }
    return r;
}

fn i64_to_str(v:i64) []u8 {
    let b:[]u8 = nio_alloc(24);
    if(v == 0) { b[0] = 48; return b[0..1]; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    let x:i64 = v;
    while(x > 0) { tmp[n as i32] = (((x % 10) + 48) as u8); x = x / 10; n = n + 1; }
    let i:i64 = 0;
    while(i < n) { b[i as i32] = tmp[(n - 1 - i) as i32]; i = i + 1; }
    return b[0..n];
}

fn main() i32 {
    let path:[]u8 = _zag_arg(1);
    if(path.len == 0) { return 1; }
    let buf:[]u8 = nio_alloc(1 << 20);
    let n:i64 = z_read(path, buf, 1 << 20);
    if(n <= 0) { return 2; }
    // parse TSV lines: fixture\tgl_b\tinstalled\twas_false
    // fields: we need gl_b (field 1) and was_false (field 3).
    let prevented:i64 = 0;
    let total_false:i64 = 0;
    let i:i64 = 0;
    let field:i64 = 0;
    let gl_b:i64 = 0;
    let was_false:i64 = 0;
    let cur:i64 = 0; // current numeric value being parsed
    while(i < n) {
        let c:u8 = buf[i as i32];
        if(c == 9) { // tab: end of field
            if(field == 1) { gl_b = cur; }
            // field 0 (fixture) ignored; field 2 (installed) ignored for gate
            // (gate applies to all; we count prevented among false)
            field = field + 1;
            cur = 0;
        } else {
            if(c == 10) { // newline: end of record
                if(field == 3) { was_false = cur; }
                // apply gate: if was_false and gl_b>0, prevented
                if(was_false == 1) {
                    total_false = total_false + 1;
                    if(gl_b > 0) { prevented = prevented + 1; }
                }
                field = 0; gl_b = 0; was_false = 0; cur = 0;
            } else {
                if(c >= 48) {
                    if(c <= 57) {
                        // only parse numeric fields (1,2,3); field 0 is fixture name (skip digits in it? no—reset)
                        if(field >= 1) { cur = cur * 10 + ((c - 48) as i64); }
                    }
                }
            }
        }
        i = i + 1;
    }
    // output "prevented=<p> total_false=<t>\n"
    let out:[]u8 = nio_alloc(64);
    // "prevented="
    out[0]=112; out[1]=114; out[2]=101; out[3]=118; out[4]=101; out[5]=110; out[6]=116; out[7]=101; out[8]=100; out[9]=61;
    let ps:[]u8 = i64_to_str(prevented);
    let j:i64 = 0;
    while(j < (ps.len as i64)) { out[(10+j) as i32] = ps[j as i32]; j = j + 1; }
    let p:i64 = 10 + (ps.len as i64);
    // " total_false="
    out[p as i32]=32; out[(p+1) as i32]=116; out[(p+2) as i32]=111; out[(p+3) as i32]=116; out[(p+4) as i32]=97; out[(p+5) as i32]=108; out[(p+6) as i32]=95; out[(p+7) as i32]=102; out[(p+8) as i32]=97; out[(p+9) as i32]=108; out[(p+10) as i32]=115; out[(p+11) as i32]=101; out[(p+12) as i32]=61;
    p = p + 13;
    let ts:[]u8 = i64_to_str(total_false);
    j = 0;
    while(j < (ts.len as i64)) { out[(p+j) as i32] = ts[j as i32]; j = j + 1; }
    p = p + (ts.len as i64);
    out[p as i32] = 10; p = p + 1;
    let wr:i64 = nio_write_all(1, out[0..p]);
    if(wr < 0) { }
    return 0;
}

// mech_demo.zag — KB4 Team-4 mechanism illustration (NOT new evidence).
// Miniature, fully deterministic model of the measured DPI structure:
//   - a frozen judge J, fooled (flipped) on the adversarial half;
//   - a transform T with law L=identity under which the fool is a FIXED
//     POINT: J(T(i)) == L(J(i)) for every i  (mirrors the measured
//     P(C)=1.0 on sense A, TCP_VERDICT.md "DPI consequence"; R3 extended
//     it to 3 new transforms wherever F3 legibility held);
//   - C2-style channel: INSTALL iff J(T(i))==L(J(i))  [perfect knowledge
//     of T and L — still dead, because the death is structural];
//   - C3-style channel: INSTALL iff Jn(i)==J(i), Jn = J xored with a
//     fixed deterministic ~8% flip pattern [mirrors measured P(agree)
//     ~0.92, uncorrelated with correctness];
//   - C1-style channel: INSTALL iff A(i)==J(i), A = independent analytic
//     that recovers the true label by construction [mirrors the
//     zero-crossing probe mirroring the generator's public rule].
// Emits contingency counts n00 n01 n10 n11 per channel (rows V, cols Y;
// Y=1 iff the judge's judgment on i is CORRECT), the DPI violation count,
// and the number of distinct (J,Jt) joint pairs (2 => Jt is a deterministic
// function of J => no (J,Jt)-predicate adds information about Y).
// Python glue (mech_demo_score.py) turns counts into I(V;Y) bits.
// Zero RNG. 2x runs must be byte-identical.

@import("../../../../../toolchain/R33_NATIVE_IO_V1.zag")

fn put_i64(buf:[]u8, pos:i32, v:i64) i32 {
    let x:i64 = v;
    if(x < 0) { buf[pos] = 45; pos = pos + 1; x = 0 - x; }
    let nd:i32 = 1;
    let t:i64 = x;
    while(t >= 10) { t = t / 10; nd = nd + 1; }
    let p:i32 = pos + nd - 1;
    t = x;
    let k:i32 = 0;
    while(k < nd) { buf[p] = (48 + (t % 10)) as u8; t = t / 10; p = p - 1; k = k + 1; }
    return pos + nd;
}

fn put_str(buf:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { buf[pos] = s[i]; pos = pos + 1; i = i + 1; }
    return pos;
}

fn emit_line(tag:[]u8, vals:[]u8, n:i32) void {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = put_str(ob, 0, tag);
    let k:i32 = 0;
    while(k < n) {
        pos = put_str(ob, pos, " ");
        pos = put_i64(ob, pos, vals[k] as i64);
        k = k + 1;
    }
    ob[pos] = 10; pos = pos + 1;
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return;
}

fn main() i32 {
    let n:i32 = 64;
    // item state
    let correct:[]u8 = nio_alloc(64); // 1 iff judge correct on i (Y)
    let label:[]u8 = nio_alloc(64);   // true label of i
    let j:[]u8 = nio_alloc(64);       // frozen judge's judgment
    let a:[]u8 = nio_alloc(64);       // independent analytic (recovers label)
    let i:i32 = 0;
    while(i < n) {
        let c:i32 = 0;
        if(i < 32) { c = 1; }
        correct[i] = c as u8;
        let lb:i32 = (i / 8) % 2;
        label[i] = lb as u8;
        // fooled = flipped label on the adversarial half
        let jv:i32 = lb;
        if(c == 0) { jv = 1 - lb; }
        j[i] = jv as u8;
        a[i] = lb as u8;
        i = i + 1;
    }
    // transform T(i) = i^1 (pair swap; involution; preserves the
    // correct/adversarial 32-blocks and the 8-labels, so the fool
    // commutes with T exactly)
    let dpi_viol:i32 = 0;
    // distinct (J,Jt) joint pairs, 2x2 table
    let jj:[]u8 = nio_alloc(4);
    let k2:i32 = 0;
    while(k2 < 4) { jj[k2] = 0; k2 = k2 + 1; }
    // contingency counts per channel: n00 n01 n10 n11 (fit in u8: N=64)
    let c2c:[]u8 = nio_alloc(4);
    let c3c:[]u8 = nio_alloc(4);
    let c1c:[]u8 = nio_alloc(4);
    let k3:i32 = 0;
    while(k3 < 4) { c2c[k3] = 0; c3c[k3] = 0; c1c[k3] = 0; k3 = k3 + 1; }
    i = 0;
    while(i < n) {
        let ti:i32 = i ^ 1;
        let jv:i32 = j[i] as i32;
        let jtv:i32 = j[ti] as i32;
        // L = identity law
        if(jtv != jv) { dpi_viol = dpi_viol + 1; }
        jj[jv * 2 + jtv] = 1;
        let y:i32 = correct[i] as i32;
        // C2: INSTALL iff J(T(i)) == L(J(i)); L = identity
        let v2:i32 = 0;
        if(jtv == jv) { v2 = 1; }
        c2c[v2 * 2 + y] = c2c[v2 * 2 + y] + 1;
        // C3: deterministic ~8% flip pattern (mirrors measured P(agree)~0.92)
        let flip:i32 = 0;
        if(((i * 7 + 3) % 13) == 0) { flip = 1; }
        let jn:i32 = jv ^ flip;
        let v3:i32 = 0;
        if(jn == jv) { v3 = 1; }
        c3c[v3 * 2 + y] = c3c[v3 * 2 + y] + 1;
        // C1: INSTALL iff analytic(i) == J(i)
        let v1:i32 = 0;
        if((a[i] as i32) == jv) { v1 = 1; }
        c1c[v1 * 2 + y] = c1c[v1 * 2 + y] + 1;
        i = i + 1;
    }
    let npairs:i32 = 0;
    k2 = 0;
    while(k2 < 4) { npairs = npairs + (jj[k2] as i32); k2 = k2 + 1; }
    let v1a:[]u8 = nio_alloc(8);
    v1a[0] = n as u8;
    emit_line("N", v1a, 1);
    v1a[0] = dpi_viol as u8;
    emit_line("DPI_VIOLATIONS", v1a, 1);
    v1a[0] = npairs as u8;
    emit_line("DISTINCT_J_JT_PAIRS", v1a, 1);
    emit_line("C2 n00 n01 n10 n11", c2c, 4);
    emit_line("C3 n00 n01 n10 n11", c3c, 4);
    emit_line("C1 n00 n01 n10 n11", c1c, 4);
    emit_line("DONE", v1a, 0);
    nio_free(correct);
    nio_free(label);
    nio_free(j);
    nio_free(a);
    nio_free(jj);
    nio_free(c2c);
    nio_free(c3c);
    nio_free(c1c);
    nio_free(v1a);
    return 0;
}

// vknow.zag — V2-C attack-family knowledge detectors (pure Zag).
// Each detector inspects the F span and returns 1 if the trap signature fires.
// Derived from family METHODS, not fixture IDs. Conservative thresholds.
//
// K-CCN-1: extreme illuminant — per-panel channel ratio > 5 with low brightness.
//   Validated: 100% recall on CCN-1 wrong-HC, 3% fire on clean (Python sim).
// K-CCN-2: mixed illuminant — left/right panel illuminant differs strongly.
// K-PTC-1: near-threshold — |Δf|/f within 40% of discrimination threshold.
// K-SHP-1: occlusion — long contiguous dark run in shape span.
// K-TMB-1: boundary — harmonic centroid within 10% of class boundary.

fn k_ccn1(buf:[]u8, n:i32) i32 {
    // buf: F span for colorconst [w][h][pixels]. Check per-panel ratio.
    if(n < 8) { return 0; }
    let w:i32 = t_get32(buf, 0);
    let h:i32 = t_get32(buf, 4);
    if(w != 128 || h != 128) { return 0; }
    if(n < 8 + w*h*3) { return 0; }
    let px:[]u8 = buf[8..8+w*h*3];
    // panel 1: x in [0,64), panel 2: x in [65,128)
    let r1:i64 = 0; let g1:i64 = 0; let b1:i64 = 0;
    let r2:i64 = 0; let g2:i64 = 0; let b2:i64 = 0;
    let n1:i64 = 0; let n2:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < 64) {
            let o:i32 = (y*w + x)*3;
            r1 = r1 + (px[o] as i64); g1 = g1 + (px[o+1] as i64); b1 = b1 + (px[o+2] as i64);
            n1 = n1 + 1;
            x = x + 1;
        }
        x = 65;
        while(x < 128) {
            let o:i32 = (y*w + x)*3;
            r2 = r2 + (px[o] as i64); g2 = g2 + (px[o+1] as i64); b2 = b2 + (px[o+2] as i64);
            n2 = n2 + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    // check panel 1
    if(n1 > 0) {
        let mx:i64 = r1; if(g1 > mx) { mx = g1; } if(b1 > mx) { mx = b1; }
        let mn:i64 = r1; if(g1 < mn) { mn = g1; } if(b1 < mn) { mn = b1; }
        let bright:i64 = (r1 + g1 + b1) / (3 * n1);
        // ratio = (mx/n1)/(mn/n1) = mx/mn. Fire if mx > 5*mn and bright < 85.
        if(mn > 0 && mx > 5*mn && bright < 85) { return 1; }
    }
    // check panel 2
    if(n2 > 0) {
        let mx:i64 = r2; if(g2 > mx) { mx = g2; } if(b2 > mx) { mx = b2; }
        let mn:i64 = r2; if(g2 < mn) { mn = g2; } if(b2 < mn) { mn = b2; }
        let bright:i64 = (r2 + g2 + b2) / (3 * n2);
        if(mn > 0 && mx > 5*mn && bright < 85) { return 1; }
    }
    return 0;
}

fn k_ccn2(buf:[]u8, n:i32) i32 {
    // Mixed illuminant: left and right panels have very different chromaticity.
    // Simplified: if per-panel dominant channels differ AND ratio high.
    if(n < 8) { return 0; }
    let w:i32 = t_get32(buf, 0);
    let h:i32 = t_get32(buf, 4);
    if(w != 128 || h != 128) { return 0; }
    if(n < 8 + w*h*3) { return 0; }
    // Reuse k_ccn1 logic but require BOTH panels to have high ratio
    // with DIFFERENT dominant channels (indicates mixed illuminant).
    // For now, conservative: return 0 (CCN-2 is rare, 17 cases).
    // TODO: implement if needed for KD-1.
    return 0;
}

fn k_ptc1(buf:[]u8, n:i32, measure:i64) i32 {
    // Near-threshold: if the measured Δf/f is within 40% of threshold.
    // Threshold for pitchdisc is approximately 0.6% (from R2-4 calibration).
    // measure is f0 in Hz (scaled?). This is a placeholder — needs calibration.
    // For now, conservative: return 0.
    return 0;
}

fn k_shp1(buf:[]u8, n:i32) i32 {
    // Occlusion bar: long contiguous dark run.
    // Simplified: check if >30% of pixels are very dark (<20).
    if(n < 8) { return 0; }
    let w:i32 = t_get32(buf, 0);
    let h:i32 = t_get32(buf, 4);
    if(n < 8 + w*h*3) { return 0; }
    let px:[]u8 = buf[8..8+w*h*3];
    let dark:i64 = 0; let tot:i64 = 0;
    let i:i32 = 0;
    while(i < w*h*3) {
        if(px[i] < 20) { dark = dark + 1; }
        tot = tot + 1;
        i = i + 3; // sample R channel only for speed
    }
    // if >30% dark, likely occlusion
    if(tot > 0 && dark*10 > tot*3) { return 1; }
    return 0;
}

fn k_tmb1(buf:[]u8, n:i32, measure:i64) i32 {
    // Boundary: harmonic centroid within 10% of class boundary (900,1400,2600).
    // measure is centroid in Hz. Placeholder — needs the actual centroid.
    // For now, conservative: return 0.
    return 0;
}

// Main entry: returns bitmask of fired detectors.
// Bit 0: K-CCN-1, Bit 1: K-CCN-2, Bit 2: K-PTC-1, Bit 3: K-SHP-1, Bit 4: K-TMB-1.
fn vknow_check(tc:i32, buf:[]u8, n:i32, measure:i64) i32 {
    let fire:i32 = 0;
    if(tc == 1) { // colorconst
        if(k_ccn1(buf, n) == 1) { fire = fire | 1; }
        if(k_ccn2(buf, n) == 1) { fire = fire | 2; }
    }
    if(tc == 3) { // pitchdisc
        if(k_ptc1(buf, n, measure) == 1) { fire = fire | 4; }
    }
    if(tc == 2) { // shapetrans
        if(k_shp1(buf, n) == 1) { fire = fire | 8; }
    }
    if(tc == 4) { // timbredisc
        if(k_tmb1(buf, n, measure) == 1) { fire = fire | 16; }
    }
    return fire;
}

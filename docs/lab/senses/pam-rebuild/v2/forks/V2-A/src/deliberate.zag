// deliberate.zag — R2-4 bounded deliberation over gate-escalation cases.
//
// The gate (memgate.zag, unchanged) escalates two case types:
//   E1 (ctype 0): a PASS program would be granted PERMANENCE (it corroborates
//       a provisional). Deliberation ratifies only if the program's evidence
//       is independently strong on BOTH spans: F margin >= task T3 bar, the
//       G check agreed with margin (agree=1, strong=1), confidence >= 700,
//       and the incoming measure corroborates the provisional within the
//       gate tolerance. Otherwise VETO -> the program is downgraded to
//       UNRESOLVED (stays provisional, never permanent).
//   E2 (ctype 1): a PASS program with confidence >= 700 would REVERSE a live
//       provisional (program conflict). Deliberation compares total evidence
//       strength s = F-margin + (G-strong ? task T3 bar : 0) on both sides and
//       allows the reversal only if the incoming program is stronger by a
//       tieband. Otherwise BLOCK -> incoming downgraded to UNRESOLVED,
//       provisional kept.
//
// Pure Zag, integer math only, zero RNG, fully deterministic.
// Case line format:
//   seq|tcode|ctype|j_f|conf_f|mrg_f|agree_f|strong_f|meas_f|j_s|mrg_fs|strong_s|meas_s|tol
// Output: one `seq|DECISION` line per case, then `ops=<n>`.
// Exit 0.
@import("R33_NATIVE_IO_V1.zag")

fn t_put64(b:[]u8, at:i32, v:i64) void {
    let i:i32 = 0;
    while(i < 8) {
        b[at + i] = ((v >> (i * 8)) & 255) as u8;
        i = i + 1;
    }
}
fn t_get64(b:[]u8, at:i32) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < 8) {
        v = v | ((b[at + i] as i64) << (i * 8));
        i = i + 1;
    }
    return v;
}
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn z_cstr(s:[]u8) []u8 {
    let n:i32 = s.len;
    let b:[]u8 = nio_alloc(n + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < n) { b[i] = s[i]; i = i + 1; }
    b[n] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        ob[pos + i] = s[i];
        i = i + 1;
    }
    return pos + s.len;
}
// field: idx-th '|' separated field of line[0..llen] into fxb; returns len.
fn dfield(line:[]u8, llen:i32, idx:i32, fxb:[]u8) i32 {
    let f:i32 = 0;
    let p:i32 = 0;
    let o:i32 = 0;
    while(p < llen) {
        if(line[p] == 124) {
            if(f == idx) { return o; }
            f = f + 1;
            o = 0;
        } else {
            if(f == idx) {
                if(o < 256) { fxb[o] = line[p]; }
                o = o + 1;
            }
        }
        p = p + 1;
    }
    if(f == idx) { return o; }
    return 0;
}
fn atoi(fxb:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let neg:i64 = 1;
    let i:i32 = 0;
    if(n > 0 && fxb[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = fxb[i] as i64;
        if(c >= 48 && c <= 57) { v = v * 10 + (c - 48); }
        i = i + 1;
    }
    return v * neg;
}
// task T3 margin bars (task-natural units), from the frozen H2 pipeline.
fn thr_of(tc:i32) i64 {
    if(tc == 0) { return 400; }
    if(tc == 1) { return 50; }
    if(tc == 2) { return 60; }
    if(tc == 3) { return 1500; }
    if(tc == 4) { return 80; }
    return 2;
}
fn main() i32 {
    let path:[]u8 = _zag_arg(1);
    let fb:[]u8 = nio_alloc(1048576);
    if(fb.len == 0 || path.len == 0) { return 1; }
    let n:i64 = z_read(path, fb, 1048576);
    if(n < 0) { return 1; }
    let op:[]u8 = nio_alloc(8);
    t_put64(op, 0, 0);
    let ob:[]u8 = nio_alloc(65536);
    let opos:i32 = 0;
    let fxb:[]u8 = nio_alloc(256);
    let fnum:[]u8 = nio_alloc(256);
    let p:i64 = 0;
    while(p < n) {
        let le:i64 = p;
        while(le < n && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 2000) {
            let line:[]u8 = fb[p as i32..(p + llen as i64) as i32];
            let nf0:i32 = dfield(line, llen, 0, fnum);
            let seq:i64 = atoi(fnum, nf0);
            let nf1:i32 = dfield(line, llen, 1, fnum);
            let tc:i32 = atoi(fnum, nf1) as i32;
            let nf2:i32 = dfield(line, llen, 2, fnum);
            let ctype:i32 = atoi(fnum, nf2) as i32;
            let nf4:i32 = dfield(line, llen, 4, fnum);
            let conf_f:i64 = atoi(fnum, nf4);
            let nf5:i32 = dfield(line, llen, 5, fnum);
            let mrg_f:i64 = atoi(fnum, nf5);
            let nf6:i32 = dfield(line, llen, 6, fnum);
            let agree_f:i64 = atoi(fnum, nf6);
            let nf7:i32 = dfield(line, llen, 7, fnum);
            let strong_f:i64 = atoi(fnum, nf7);
            let nf8:i32 = dfield(line, llen, 8, fnum);
            let meas_f:i64 = atoi(fnum, nf8);
            let nf10:i32 = dfield(line, llen, 10, fnum);
            let mrg_fs:i64 = atoi(fnum, nf10);
            let nf11:i32 = dfield(line, llen, 11, fnum);
            let strong_s:i64 = atoi(fnum, nf11);
            let nf12:i32 = dfield(line, llen, 12, fnum);
            let meas_s:i64 = atoi(fnum, nf12);
            let nf13:i32 = dfield(line, llen, 13, fnum);
            let tol:i64 = atoi(fnum, nf13);
            let thr:i64 = thr_of(tc);
            let dec:[]u8 = "SKIP";
            if(ctype == 0) {
                // E1: permanence ratification
                dec = "VETO";
                if(conf_f >= 700 && mrg_f >= thr && agree_f == 1 && strong_f == 1 && iabs(meas_f - meas_s) <= tol) {
                    dec = "RATIFY";
                }
            } else if(ctype == 1) {
                // E2: provisional-conflict resolution by evidence strength
                let s_new:i64 = mrg_f;
                if(strong_f == 1) { s_new = s_new + thr; }
                let s_old:i64 = mrg_fs;
                if(strong_s == 1) { s_old = s_old + thr; }
                dec = "BLOCK";
                if(s_new >= s_old + 100) { dec = "ALLOW"; }
            }
            op_add(op, 40);
            opos = ob_add(ob, opos, _zag_i64_to_str(seq));
            opos = ob_add(ob, opos, "|");
            opos = ob_add(ob, opos, dec);
            opos = ob_add(ob, opos, "\n");
        }
        p = le + 1;
    }
    opos = ob_add(ob, opos, "ops=");
    opos = ob_add(ob, opos, _zag_i64_to_str(t_get64(op, 0)));
    opos = ob_add(ob, opos, "\n");
    nio_write_all(1, ob[0..opos]);
    return 0;
}

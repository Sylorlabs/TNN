// grevise.zag — (g)-predicate revision calibrator (PAMs v2 ceiling test, prereg §4).
//
// Reads the augmented frozen case record
//   seq|tcode|prog|jcode|jcorrect|conf|pred|meas|progF|disp|detail|t1|agree|strong
// applies a frozen (g)-predicate revision, replays the H2 gate with the EXACT
// gate_step logic of frozen diagnose.zag (2aed8371...), and emits metrics.
//
// Revisions (argv[1]): "R0" = identity (control); "R1" = drop `strong`,
//   revised prog=PASS iff t1==1 && agree==1 (FAIL iff agree==0 && contra==1
//   is unchanged since contra ⟹ agree==0; else UNRESOLVED).
// Revised pred (gpred) = 1 iff revised prog==PASS.
//
// Pure Zag, integer math only, ZERO RNG, byte-identical reruns.
// Deliberation (E1/E2) is held at frozen outcomes: this replays the H2 gate
// only. Recovered trials are listed for post-hoc E1/E2 trigger review.
//
// CLI: grevise <augmented_case> <R0|R1>
// stdout: GREV metric lines (machine-checkable).
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

const MAXT:i32=12000;
const NFIELD:i32=14;
const ROWB:i32=112;

const D_PROV:i32=0;
const D_CORR:i32=1;
const D_PERM:i32=2;
const D_WITH:i32=3;
const D_CONF:i32=4;
const D_NEG:i32=5;
const D_SUPP:i32=6;

// gate state arena layout (bytes) — identical to diagnose.zag
const ST_NEGJ:i32=0;
const ST_NEGM:i32=12288;
const ST_NEGN:i32=24576;
const ST_PROV:i32=24624;
const ST_PERM:i32=24816;
const ST_SIZE:i32=25152;

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at]=(v & 255) as u8;
    b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;
    b[at+3]=((v>>24) & 255) as u8;
    b[at+4]=((v>>32) & 255) as u8;
    b[at+5]=((v>>40) & 255) as u8;
    b[at+6]=((v>>48) & 255) as u8;
    b[at+7]=((v>>56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24)|((b[at+4] as i64)<<32)|((b[at+5] as i64)<<40)|((b[at+6] as i64)<<48)|((b[at+7] as i64)<<56);
}
fn iabs(x:i64) i64 {
    if(x<0){return 0-x;}
    return x;
}
fn i64s(v:i64) []u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn z_cstr(s:[]u8) []u8 {
    let b:[]u8=nio_alloc(s.len+1);
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    b[s.len]=0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8=z_cstr(path);
    if(s.len==0){return -7401;}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(s) as i64,0,0,0,0,0);
    nio_free(s);
    if(fd<0){return -7402;}
    let n:i64=nio_read_exact(fd,out,max);
    nio_close(fd);
    return n;
}
fn parse_line(b:[]u8, at:i32, end:i32, row:[]u8) i32 {
    let f:i32=0;
    let p:i32=at;
    while(p<end && f<NFIELD){
        let v:i64=0;
        let neg:i32=0;
        if(b[p]==45){neg=1;p=p+1;}
        while(p<end && b[p]>=48 && b[p]<=57){v=v*10+(b[p] as i64)-48;p=p+1;}
        if(neg==1){v=0-v;}
        t_put64(row,f*8,v);
        f=f+1;
        if(p<end && b[p]==124){p=p+1;}
    }
    return f;
}

// ---- gate (verbatim logic from frozen diagnose.zag) ----
fn tol_of(tc:i32) i64 {
    if(tc==0){return 8;}
    if(tc==1){return 40;}
    if(tc==2){return 60;}
    if(tc==3){return 4000;}
    if(tc==4){return 120;}
    return 0;
}
fn neg_match(st:[]u8, tc:i32, jcode:i64, meas:i64) i32 {
    let tol:i64=tol_of(tc);
    let nn:i32=t_get64(st,ST_NEGN+tc*8) as i32;
    let k:i32=0;
    while(k<nn){
        let jj:i64=t_get64(st,ST_NEGJ+(tc*256+k)*8);
        let mm:i64=t_get64(st,ST_NEGM+(tc*256+k)*8);
        if(jj==jcode && iabs(mm-meas)<=tol){return 1;}
        k=k+1;
    }
    return 0;
}
fn neg_store(st:[]u8, tc:i32, jcode:i64, meas:i64) void {
    let nn:i32=t_get64(st,ST_NEGN+tc*8) as i32;
    if(nn>=256){return;}
    t_put64(st,ST_NEGJ+(tc*256+nn)*8,jcode);
    t_put64(st,ST_NEGM+(tc*256+nn)*8,meas);
    t_put64(st,ST_NEGN+tc*8,(nn+1) as i64);
    return;
}
fn gate_fail(st:[]u8, tc:i32, jcode:i64, meas:i64, od:*i32, ot:*i32) void {
    let nm:i32=neg_match(st,tc,jcode,meas);
    if(nm==0){neg_store(st,tc,jcode,meas);}
    od.*=D_NEG;
    ot.*=10;
    if(nm==1){ot.*=11;}
    return;
}
fn gate_unres(st:[]u8, tc:i32, jcode:i64, meas:i64, od:*i32, ot:*i32) void {
    let nm:i32=neg_match(st,tc,jcode,meas);
    od.*=D_WITH;
    ot.*=7;
    if(nm==1){od.*=D_SUPP;ot.*=8;}
    return;
}
fn gate_pass_perm(st:[]u8, tc:i32, jcode:i64, meas:i64, od:*i32, ot:*i32) void {
    let tol:i64=tol_of(tc);
    let pj:i64=t_get64(st,ST_PERM+48+tc*8);
    let pm:i64=t_get64(st,ST_PERM+96+tc*8);
    if(jcode==pj && iabs(pm-meas)<=tol){od.*=D_CORR;ot.*=2;return;}
    if(jcode!=pj){od.*=D_CONF;ot.*=6;return;}
    od.*=D_CORR;
    ot.*=3;
    return;
}
fn gate_pass_prov(st:[]u8, tc:i32, jcode:i64, meas:i64, seq:i64, od:*i32, ot:*i32) void {
    let tol:i64=tol_of(tc);
    if(t_get64(st,ST_PROV+tc*8)==0){
        t_put64(st,ST_PROV+tc*8,1);
        t_put64(st,ST_PROV+48+tc*8,jcode);
        t_put64(st,ST_PROV+96+tc*8,meas);
        t_put64(st,ST_PROV+144+tc*8,seq);
        od.*=D_PROV;
        ot.*=0;
        return;
    }
    let pj:i64=t_get64(st,ST_PROV+48+tc*8);
    let pm:i64=t_get64(st,ST_PROV+96+tc*8);
    if(jcode==pj && iabs(pm-meas)<=tol){
        t_put64(st,ST_PERM+tc*8,1);
        t_put64(st,ST_PERM+48+tc*8,jcode);
        t_put64(st,ST_PERM+96+tc*8,meas);
        t_put64(st,ST_PERM+144+tc*8,seq);
        t_put64(st,ST_PROV+tc*8,0);
        od.*=D_PERM;
        ot.*=1;
        return;
    }
    if(jcode!=pj){
        t_put64(st,ST_PROV+48+tc*8,jcode);
        t_put64(st,ST_PROV+96+tc*8,meas);
        t_put64(st,ST_PROV+144+tc*8,seq);
        od.*=D_PROV;
        ot.*=5;
        return;
    }
    od.*=D_CORR;
    ot.*=4;
    return;
}
fn gate_pass(st:[]u8, tc:i32, jcode:i64, pred:i64, meas:i64, seq:i64, od:*i32, ot:*i32) void {
    if(pred==0){od.*=D_WITH;ot.*=9;return;}
    let nm:i32=neg_match(st,tc,jcode,meas);
    if(nm==1){od.*=D_SUPP;ot.*=8;return;}
    if(t_get64(st,ST_PERM+tc*8)==1){gate_pass_perm(st,tc,jcode,meas,od,ot);return;}
    gate_pass_prov(st,tc,jcode,meas,seq,od,ot);
    return;
}
fn gate_step(st:[]u8, tc:i32, prog:i64, jcode:i64, pred:i64, meas:i64, seq:i64, od:*i32, ot:*i32) void {
    if(prog==1){gate_fail(st,tc,jcode,meas,od,ot);return;}
    if(prog==2){gate_unres(st,tc,jcode,meas,od,ot);return;}
    gate_pass(st,tc,jcode,pred,meas,seq,od,ot);
    return;
}
fn trow(i:i32) i32 { return i*ROWB; }
fn tf(tr:[]u8, i:i32, f:i32) i64 { return t_get64(tr,trow(i)+f*8); }

fn main() void {
    let a1:[]u8=_zag_arg(1);
    let a2:[]u8=_zag_arg(2);
    if(a1.len==0 || a2.len==0){
        _zag_print("usage: grevise <augmented_case> <R0|R1>\n");
        return;
    }
    let is_r1:i32=0;
    if(a2.len==2 && a2[0]==82 && a2[1]==49){is_r1=1;}
    let tr:[]u8=nio_alloc(MAXT*ROWB);
    let st:[]u8=nio_alloc(ST_SIZE);
    let cb:[]u8=nio_alloc(2097152);
    if(tr.len==0 || st.len==0 || cb.len==0){
        _zag_print("GREV,OOM\n");
        return;
    }
    let i:i32=0;
    while(i<ST_SIZE){st[i]=0;i=i+1;}
    let n:i64=z_read(a1,cb,2097152);
    if(n<=0){_zag_print("GREV,LOAD,READFAIL\n");return;}
    let nrows:i32=0;
    let p:i32=0;
    let ni:i32=n as i32;
    let row:[]u8=nio_alloc(NFIELD*8);
    while(p<ni && nrows<MAXT){
        let le:i32=p;
        while(le<ni && cb[le]!=10){le=le+1;}
        if(le-p>20){
            let nf:i32=parse_line(cb,p,le,row);
            if(nf==NFIELD){
                let base:i32=trow(nrows);
                let f:i32=0;
                while(f<NFIELD){t_put64(tr,base+f*8,t_get64(row,f*8));f=f+1;}
                nrows=nrows+1;
            }
        }
        p=le+1;
    }
    nio_free(row);
    _zag_print("GREV,REV,");
    _zag_print(a2);
    _zag_print("\n");
    _zag_print("GREV,NROWS,");
    _zag_print(i64s(nrows as i64));
    _zag_print("\n");
    // control fidelity: R0 replay must match recorded dispositions exactly
    let mm:i64=0;
    // metrics
    let chc:i64=0;
    let rk3:i64=0;
    let recovered:i64=0;
    let ceil:i64=0;
    let rk1pf:i64=0;
    let rk2whcp:i64=0;
    let rk5n:i64=0;
    let rk5d:i64=0;
    i=0;
    while(i<nrows){
        let seq:i64=tf(tr,i,0);
        let tc:i32=tf(tr,i,1) as i32;
        let prog0:i64=tf(tr,i,2);
        let jc:i64=tf(tr,i,3);
        let jcorr:i64=tf(tr,i,4);
        let conf:i64=tf(tr,i,5);
        let pred0:i64=tf(tr,i,6);
        let meas:i64=tf(tr,i,7);
        let disp0:i64=tf(tr,i,9);
        let t1:i64=tf(tr,i,11);
        let agree:i64=tf(tr,i,12);
        // R1 revision
        let prog:i64=prog0;
        let pred:i64=pred0;
        if(is_r1==1 && t1==1 && agree==1){
            prog=0;
            pred=1;
        }
        let od:i32=0;
        let ot:i32=0;
        gate_step(st,tc,prog,jc,pred,meas,seq,&od,&ot);
        let rdp:i64=od as i64;
        if(is_r1==0 && rdp!=disp0){mm=mm+1;}
        let installed:i32=0;
        if(rdp==0 || rdp==1 || rdp==2){installed=1;}
        if(jcorr==1 && conf>=700){
            chc=chc+1;
            if(installed==1){rk3=rk3+1;}
            if(prog0!=0 && installed==1){
                recovered=recovered+1;
                _zag_print("GREV,REC,");
                _zag_print(i64s(seq));
                _zag_print(",");
                _zag_print(i64s(rdp));
                _zag_print("\n");
            }
            if(prog==0 && pred==1){ceil=ceil+1;}
        }
        if(rdp==2 && jcorr==0){rk1pf=rk1pf+1;}
        if(rdp==2 && jcorr==0 && conf>=700){rk2whcp=rk2whcp+1;}
        if(jcorr==0 && conf>=700){
            rk5d=rk5d+1;
            if(prog==1 || prog==2){rk5n=rk5n+1;}
        }
        i=i+1;
    }
    _zag_print("GREV,REPLAY_MM,");
    _zag_print(i64s(mm));
    _zag_print("\n");
    _zag_print("GREV,CHC,");
    _zag_print(i64s(chc));
    _zag_print("\n");
    _zag_print("GREV,RK3,");
    _zag_print(i64s(rk3));
    _zag_print("\n");
    _zag_print("GREV,RECOVERED,");
    _zag_print(i64s(recovered));
    _zag_print("\n");
    _zag_print("GREV,CEIL,");
    _zag_print(i64s(ceil));
    _zag_print("\n");
    _zag_print("GREV,RK1_PERM_FALSE,");
    _zag_print(i64s(rk1pf));
    _zag_print("\n");
    _zag_print("GREV,RK2_WRONGHC_PERM,");
    _zag_print(i64s(rk2whcp));
    _zag_print("\n");
    _zag_print("GREV,RK5,");
    _zag_print(i64s(rk5n));
    _zag_print(",");
    _zag_print(i64s(rk5d));
    _zag_print("\n");
    _zag_print("GREV,DONE\n");
    return;
}

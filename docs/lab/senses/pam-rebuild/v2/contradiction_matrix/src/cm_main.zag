// cm_main.zag — contradiction-matrix battery driver (PAMs v2 follow-up item 6).
//
// Implements the three preregistered gates EXACTLY per
// PREREG_CONTRADICTION_MATRIX.md §2 and runs every cell through every gate.
// Pure Zag, integer math only, ZERO RNG. All trial values are literals from
// the generated cm_records.zag (frozen prereg single source: gen_cells.py).
//
// Output: one CM line per trial:
//   CM|<cell>|<gate>|<trial_idx>|<disp>|<perm_j or -1>|<perm_seq or -1>
// Gate functions take (prog, jcode, conf, pred, meas, jG, confG) only —
// truth is structurally unreadable by the gates (prereg §2 truth handling).
@import("R33_NATIVE_IO_V1.zag")
@import("cm_records.zag")

// ---------------- disposition codes (frozen) ----------------
const D_PERM:i32=0;
const D_PROV:i32=1;
const D_CORR:i32=2;
const D_CONF:i32=3;
const D_CHAL:i32=4;
const D_REV:i32=5;
const D_ACC:i32=6;
const D_WITH:i32=7;

// ---------------- state arena word offsets ----------------
const S_PROV_ON:i32=0;
const S_PROV_J:i32=1;
const S_PROV_M:i32=2;
const S_PERM_ON:i32=3;
const S_PERM_J:i32=4;
const S_PERM_M:i32=5;
const S_PERM_CONF:i32=6;
const S_PERM_SEQ:i32=7;
const S_CHAL_ON:i32=8;
const S_CHAL_J:i32=9;
const S_CHAL_M:i32=10;
const S_DCHAL_ON:i32=11;
const S_DCHAL_J:i32=12;
const S_DCHAL_M:i32=13;
const S_NWORDS:i32=14;

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at]=(v & 255) as u8;
    b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;
    b[at+3]=((v>>24) & 255) as u8;
    b[at+4]=((v>>32) & 255) as u8;
    b[at+5]=((v>>40) & 255) as u8;
    b[at+6]=((v>>48) & 255) as u8;
    b[at+7]=((v>>56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24)|((b[at+4] as i64)<<32)|((b[at+5] as i64)<<40)|((b[at+6] as i64)<<48)|((b[at+7] as i64)<<56);
}
fn iabs(x:i64) i64 {
    if(x<0){return 0-x;}
    return x;
}
fn st_get(st:[]u8, w:i32) i64 { return t_get64(st, w*8); }
fn st_put(st:[]u8, w:i32, v:i64) void { t_put64(st, w*8, v); }
// trial field f of trial i (fields: 0=tcode 1=prog 2=jcode 3=conf 4=pred
// 5=meas 6=mrgF 7=truth 8=jG 9=confG)
fn tf(tr:[]u8, i:i32, f:i32) i64 { return t_get64(tr, i*CM_ROW+f*8); }

// ---------------- print helpers ----------------
fn i64s(v:i64) []u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}

// ---------------- tolerances (memgate.zag tol_of, verbatim) ----------------
fn tol_of(tc:i64) i64 {
    if(tc==0){return 8;}
    if(tc==1){return 40;}
    if(tc==2){return 60;}
    if(tc==3){return 4000;}
    if(tc==4){return 120;}
    return 0;
}

fn perm_install(st:[]u8, jc:i64, meas:i64, cf:i64, ti:i32) void {
    st_put(st,S_PERM_ON,1); st_put(st,S_PERM_J,jc); st_put(st,S_PERM_M,meas);
    st_put(st,S_PERM_CONF,cf); st_put(st,S_PERM_SEQ,ti as i64);
    st_put(st,S_PROV_ON,0);
}

// ---------------- G0: frozen R2-4/H2 gate (negative control) ----------------
// memgate.zag §§1.1/2 verbatim, single-task. (Negative-evidence path omitted:
// no FAIL trials exist in the matrix; the prereg records it as vacuous.)
fn g0_step(st:[]u8, tr:[]u8, ti:i32) i32 {
    let prog:i64=tf(tr,ti,1);
    if(prog!=0){return D_WITH;}
    let pred:i64=tf(tr,ti,4);
    if(pred!=1){return D_WITH;}
    let jc:i64=tf(tr,ti,2); let cf:i64=tf(tr,ti,3); let meas:i64=tf(tr,ti,5);
    let tol:i64=tol_of(tf(tr,ti,0));
    if(st_get(st,S_PERM_ON)==1){
        if(jc==st_get(st,S_PERM_J)){return D_CORR;}
        return D_CONF;
    }
    if(st_get(st,S_PROV_ON)==1){
        if(jc==st_get(st,S_PROV_J) && iabs(meas-st_get(st,S_PROV_M))<=tol){
            perm_install(st,jc,meas,cf,ti);
            return D_PERM;
        }
        st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
        return D_PROV;
    }
    st_put(st,S_PROV_ON,1); st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
    return D_PROV;
}

// ---------------- G1: cf1 historical-corroboration (AUTOPSY_R2-4 §4) ----------------
fn g1_step(st:[]u8, tr:[]u8, ti:i32, no_hist:i32) i32 {
    let prog:i64=tf(tr,ti,1);
    if(prog!=0){return D_WITH;}
    let pred:i64=tf(tr,ti,4);
    if(pred!=1){return D_WITH;}
    let jc:i64=tf(tr,ti,2); let cf:i64=tf(tr,ti,3); let meas:i64=tf(tr,ti,5);
    let tol:i64=tol_of(tf(tr,ti,0));
    let perm_on:i64=st_get(st,S_PERM_ON);
    let prov_on:i64=st_get(st,S_PROV_ON);
    // same-judgment path
    if(perm_on==1 && jc==st_get(st,S_PERM_J) && iabs(meas-st_get(st,S_PERM_M))<=tol){return D_CORR;}
    if(prov_on==1 && perm_on==0 && jc==st_get(st,S_PROV_J) && iabs(meas-st_get(st,S_PROV_M))<=tol){
        if(cf>=700){
            perm_install(st,jc,meas,cf,ti);
            return D_PERM;
        }
        return D_PROV;
    }
    // incumbent identity for the conflict path
    let inc:i32=0;
    if(perm_on==1){inc=1;}
    if(prov_on==1 && perm_on==0){inc=1;}
    if(inc==1){
        let ij:i64=st_get(st,S_PERM_J);
        if(perm_on==0){ij=st_get(st,S_PROV_J);}
        if(jc!=ij){
            // CONFLICT: §4.1 challenger path
            if(cf>=700 && no_hist==0){
                if(st_get(st,S_CHAL_ON)==1 && st_get(st,S_CHAL_J)==jc && iabs(meas-st_get(st,S_CHAL_M))<=tol){
                    perm_install(st,jc,meas,cf,ti);
                    st_put(st,S_CHAL_ON,0);
                    return D_REV;
                }
                st_put(st,S_CHAL_ON,1); st_put(st,S_CHAL_J,jc); st_put(st,S_CHAL_M,meas);
                return D_CHAL;
            }
            return D_CONF;
        }
        // same jcode outside tol: re-anchor provisional (specified, unexercised in matrix)
        st_put(st,S_PROV_ON,1); st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
        return D_PROV;
    }
    // no incumbent
    st_put(st,S_PROV_ON,1); st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
    return D_PROV;
}

// ---------------- G2: V2-D-hardened (prog-required + conflict adjudication) ----------------
fn g2_step(st:[]u8, tr:[]u8, ti:i32, no_hist:i32) i32 {
    let prog:i64=tf(tr,ti,1);
    let pred:i64=tf(tr,ti,4);
    let jc:i64=tf(tr,ti,2); let cf:i64=tf(tr,ti,3); let meas:i64=tf(tr,ti,5);
    let jg:i64=tf(tr,ti,8); let cg:i64=tf(tr,ti,9);
    let tol:i64=tol_of(tf(tr,ti,0));
    let dfires:i32=0;
    if(prog==0 && pred==1 && jg==jc && cf>=700 && cg>=700){dfires=1;}
    if(dfires==1){
        let perm_on:i64=st_get(st,S_PERM_ON);
        let prov_on:i64=st_get(st,S_PROV_ON);
        if(perm_on==1 && jc==st_get(st,S_PERM_J)){return D_CORR;}
        if(perm_on==1){
            // CONFLICT vs permanent: adjudication (hardening)
            if(no_hist==0 && st_get(st,S_DCHAL_ON)==1 && st_get(st,S_DCHAL_J)==jc && iabs(meas-st_get(st,S_DCHAL_M))<=tol){
                perm_install(st,jc,meas,cf,ti);
                st_put(st,S_DCHAL_ON,0);
                return D_REV;
            }
            if(no_hist==0){
                st_put(st,S_DCHAL_ON,1); st_put(st,S_DCHAL_J,jc); st_put(st,S_DCHAL_M,meas);
                return D_CHAL;
            }
            return D_CONF;
        }
        if(prov_on==1 && jc==st_get(st,S_PROV_J) && iabs(meas-st_get(st,S_PROV_M))<=tol){
            perm_install(st,jc,meas,cf,ti);
            return D_PERM;
        }
        if(prov_on==1){
            // CONFLICT vs provisional: same adjudication
            if(no_hist==0 && st_get(st,S_DCHAL_ON)==1 && st_get(st,S_DCHAL_J)==jc && iabs(meas-st_get(st,S_DCHAL_M))<=tol){
                perm_install(st,jc,meas,cf,ti);
                st_put(st,S_DCHAL_ON,0);
                return D_REV;
            }
            if(no_hist==0){
                st_put(st,S_DCHAL_ON,1); st_put(st,S_DCHAL_J,jc); st_put(st,S_DCHAL_M,meas);
                return D_CHAL;
            }
            return D_CONF;
        }
        // no incumbent: truth-acceptance path
        perm_install(st,jc,meas,cf,ti);
        return D_ACC;
    }
    return g0_step(st,tr,ti);
}

// ---------------- driver ----------------
fn main() void {
    let tr:[]u8=nio_alloc(CM_NTRIALS*CM_ROW);
    cm_init_trials(tr);
    let ci:i32=0;
    while(ci<CM_NCELLS){
        let co:[]u8=nio_alloc(64);
        cm_cell(ci,co);
        let start:i64=t_get64(co,0);
        let count:i64=t_get64(co,8);
        let pre_on:i64=t_get64(co,16);
        let no_hist:i32=t_get64(co,56) as i32;
        let g:i32=0;
        while(g<3){
            let st:[]u8=nio_alloc(S_NWORDS*8);
            let w:i32=0;
            while(w<S_NWORDS){t_put64(st,w*8,0);w=w+1;}
            if(pre_on==1){
                st_put(st,S_PERM_ON,1);
                st_put(st,S_PERM_J,t_get64(co,24));
                st_put(st,S_PERM_M,t_get64(co,32));
                st_put(st,S_PERM_CONF,t_get64(co,40));
                st_put(st,S_PERM_SEQ,t_get64(co,48));
            }
            let k:i64=0;
            while(k<count){
                let ti:i32=(start+k) as i32;
                let d:i32=0;
                if(g==0){d=g0_step(st,tr,ti);}
                if(g==1){d=g1_step(st,tr,ti,no_hist);}
                if(g==2){d=g2_step(st,tr,ti,no_hist);}
                let pj:i64=-1; let ps:i64=-1;
                if(st_get(st,S_PERM_ON)==1){pj=st_get(st,S_PERM_J);ps=st_get(st,S_PERM_SEQ);}
                _zag_print("CM|");
                _zag_print(cm_cell_name(ci));
                _zag_print("|");_zag_print(i64s(g as i64));
                _zag_print("|");_zag_print(i64s(k));
                _zag_print("|");_zag_print(i64s(d as i64));
                _zag_print("|");_zag_print(i64s(pj));
                _zag_print("|");_zag_print(i64s(ps));
                _zag_print("\n");
                k=k+1;
            }
            nio_free(st);
            g=g+1;
        }
        nio_free(co);
        ci=ci+1;
    }
    nio_free(tr);
}

@import("R33_NATIVE_IO_V1.zag")

// roundc_probe.zag — Round-C cheap falsification probes (H-PAM-29..34).
// Frozen prereg: PREREG_ROUNDC_PROBES.md (commit 0db769f2), committed ALONE.
// Pure Zag, zero RNG. argv[1] selects mode:
//   sep irrev mepoch pow trmod tror tier bond chan mepoch_tr
// 3 runs, byte-identical stdout (SHA-compare).
//
// znc landmines respected: no []i32/[]u32/[]u16 indexed casts (u8 arenas with
// explicit LE32 accessors), no slice ==, no .* on non-pointers, no bare blocks,
// no `try` identifier, return; in voids, shifts hoisted out of &-tests
// (2^a via multiply loop), else-nesting kept shallow.

// ---------- output buffer ----------
fn ob_puts(b:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { b[pos+i] = s[i]; i = i + 1; }
    return pos + s.len;
}
fn ob_puti(b:[]u8, pos:i32, v:i64) i32 {
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    if(x == 0) { tmp[0] = 48; n = 1; }
    while(x > 0) {
        tmp[n] = ((x % 10) + 48) as u8;
        x = x / 10;
        n = n + 1;
    }
    if(neg == 1) { b[pos] = 45; pos = pos + 1; }
    let i:i32 = n - 1;
    while(i >= 0) { b[pos] = tmp[i]; pos = pos + 1; i = i - 1; }
    nio_free(tmp);
    return pos;
}
fn yn(ok:i32) []u8 {
    if(ok == 1) { return "PASS"; }
    return "FAIL";
}

// ---------- toy hash (mod 2^31-1 mixing; stand-in for structure, not crypto) ----------
fn th_mix(h:i64, v:i64) i64 {
    let vv:i64 = v % 2147483647;
    if(vv < 0) { vv = vv + 2147483647; }
    let r:i64 = (h * 131 + vv) % 2147483647;
    return r;
}
fn toyhash2(a:i64, b:i64) i64 {
    let h:i64 = th_mix(1, a);
    h = th_mix(h, b);
    h = th_mix(h, 7);
    return h;
}
fn toyhash3(a:i64, b:i64, c:i64) i64 {
    let h:i64 = th_mix(1, a);
    h = th_mix(h, b);
    h = th_mix(h, c);
    h = th_mix(h, 7);
    return h;
}
fn toyhash4(a:i64, b:i64, c:i64, d:i64) i64 {
    let h:i64 = th_mix(1, a);
    h = th_mix(h, b);
    h = th_mix(h, c);
    h = th_mix(h, d);
    h = th_mix(h, 7);
    return h;
}

// ---------- u8 arena LE32 accessors ----------
fn t_put32(b:[]u8, o:i32, v:i64) void {
    b[o] = (v % 256) as u8;
    b[o+1] = ((v / 256) % 256) as u8;
    b[o+2] = ((v / 65536) % 256) as u8;
    b[o+3] = ((v / 16777216) % 256) as u8;
    return;
}
fn t_get32(b:[]u8, o:i32) i64 {
    let r:i64 = (b[o] as i64) + (b[o+1] as i64) * 256 + (b[o+2] as i64) * 65536 + (b[o+3] as i64) * 16777216;
    return r;
}

// ---------- shared gates/fixtures ----------
fn in_box(c:i64, m:i64) i32 {
    if(c < 690) { return 0; }
    if(c > 740) { return 0; }
    if(m < 2590) { return 0; }
    if(m > 2660) { return 0; }
    return 1;
}
fn confirm_ok(id:i64, c:i64, m:i64) i32 {
    let c2:i64 = c + ((id * 37) % 11) - 5;
    let m2:i64 = m + ((id * 53) % 13) - 6;
    return in_box(c2, m2);
}
fn g_sep(id:i64, c:i64, m:i64) i32 {
    if(in_box(c, m) == 0) { return 0; }
    return confirm_ok(id, c, m);
}
fn g_sep2(id:i64, c:i64, m:i64) i32 {
    if(in_box(c, m) == 0) { return 0; }
    let dc:i64 = c - 715;
    if(dc < 0) { dc = 0 - dc; }
    let dm:i64 = m - 2625;
    if(dm < 0) { dm = 0 - dm; }
    if(dc + dm >= 60) { return 0; }
    return confirm_ok(id, c, m);
}
fn hon_c(j:i64) i64 { return 700 + ((j * 7) % 31); }
fn hon_m(j:i64) i64 { return 2600 + ((j * 11) % 51); }

// deterministic hill-climb from an out-of-box start toward (715,2625).
// gate: 1=g_sep, 2=g_sep2. returns c*100000+m on success, -1 on failure.
fn climb_find(gate:i32, id:i64, c0:i64, m0:i64) i64 {
    let c:i64 = c0;
    let m:i64 = m0;
    let steps:i32 = 0;
    while(steps < 2000) {
        let adm:i32 = 0;
        if(gate == 1) { adm = g_sep(id, c, m); }
        if(gate == 2) { adm = g_sep2(id, c, m); }
        if(adm == 1) { return c * 100000 + m; }
        if(c < 712) { c = c + 4; }
        else { if(c > 718) { c = c - 4; } else { c = 715; } }
        if(m < 2622) { m = m + 4; }
        else { if(m > 2628) { m = m - 4; } else { m = 2625; } }
        steps = steps + 1;
    }
    return -1;
}

// ---------- mode: sep (Separation Lemma demo) ----------
fn m_sep(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=sep\n");
    let ha1:i32 = 0;
    let ha2:i32 = 0;
    let j:i64 = 0;
    while(j < 60) {
        let id:i64 = 1000 + j;
        if(g_sep(id, hon_c(j), hon_m(j)) == 1) { ha1 = ha1 + 1; }
        if(g_sep2(id, hon_c(j), hon_m(j)) == 1) { ha2 = ha2 + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "honest_admit_g1=");
    pos = ob_puti(ob, pos, ha1 as i64);
    pos = ob_puts(ob, pos, "/60 honest_admit_g2=");
    pos = ob_puti(ob, pos, ha2 as i64);
    pos = ob_puts(ob, pos, "/60\n");
    let aa1:i32 = 0;
    let aa2:i32 = 0;
    j = 0;
    while(j < 60) {
        let id:i64 = 2000 + j;
        let c0:i64 = 500 + ((j * 37) % 300);
        let m0:i64 = 2300 + ((j * 41) % 500);
        if(climb_find(1, id, c0, m0) >= 0) { aa1 = aa1 + 1; }
        if(climb_find(2, id, c0, m0) >= 0) { aa2 = aa2 + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "attack_admit_g1=");
    pos = ob_puti(ob, pos, aa1 as i64);
    pos = ob_puts(ob, pos, "/60 attack_admit_g2=");
    pos = ob_puti(ob, pos, aa2 as i64);
    pos = ob_puts(ob, pos, "/60\n");
    let sane:i32 = 0;
    if(ha1 == 60) { if(ha2 == 60) { sane = 1; } }
    pos = ob_puts(ob, pos, "BAR honest_sanity=");
    pos = ob_puts(ob, pos, yn(sane));
    pos = ob_puts(ob, pos, "\n");
    let fired:i32 = 0;
    if(aa1 >= 54) { if(aa2 >= 54) { fired = 1; } }
    pos = ob_puts(ob, pos, "BAR lemma_demo_fired=");
    pos = ob_puts(ob, pos, yn(fired));
    pos = ob_puts(ob, pos, " (bar: attack>=54/60 each gate)\n");
    return pos;
}

// ---------- mode: irrev (naive irreversible-action death) ----------
// world state W (bits only set, never cleared); consequence transcript-computable.
fn irrev_step(w:i64, id:i64, c:i64, m:i64) i64 {
    // returns (w_prime * 100000) + conseq packed; w_prime<2^31, conseq<4096
    let a:i64 = (id * 101 + c) % 8;
    let bit:i64 = 1;
    let k:i64 = 0;
    while(k < a) { bit = bit * 2; k = k + 1; }
    let wp:i64 = w;
    if(((w / bit) % 2) == 0) { wp = w + bit; }
    let conseq:i64 = (m * (a + 1) + (wp % 1000)) % 4096;
    return wp * 100000 + conseq;
}
fn m_irrev(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=irrev\n");
    let advp:[]u8 = nio_alloc(240);
    // pass 1: adversary pre-materialization (simulates W over transcript order)
    let w:i64 = 305419896;
    let k:i64 = 0;
    while(k < 120) {
        let j:i64 = k / 2;
        let id:i64 = 1000 + j;
        if((k % 2) == 1) { id = 2000 + j; }
        let r:i64 = irrev_step(w, id, hon_c(j), hon_m(j));
        w = r / 100000;
        if((k % 2) == 1) { t_put32(advp, (j * 4) as i32, r % 100000); }
        k = k + 1;
    }
    // pass 2: gate
    w = 305419896;
    let ha:i32 = 0;
    let aa:i32 = 0;
    k = 0;
    while(k < 120) {
        let j:i64 = k / 2;
        let isatk:i32 = (k % 2) as i32;
        let id:i64 = 1000 + j;
        if(isatk == 1) { id = 2000 + j; }
        let c:i64 = hon_c(j);
        let m:i64 = hon_m(j);
        let r:i64 = irrev_step(w, id, c, m);
        w = r / 100000;
        let conseq:i64 = r % 100000;
        let pred:i64 = conseq;
        if(isatk == 1) { pred = t_get32(advp, (j * 4) as i32); }
        if(pred == conseq) { if(in_box(c, m) == 1) {
            if(isatk == 1) { aa = aa + 1; }
            if(isatk == 0) { ha = ha + 1; }
        } }
        k = k + 1;
    }
    nio_free(advp);
    pos = ob_puts(ob, pos, "honest_admit=");
    pos = ob_puti(ob, pos, ha as i64);
    pos = ob_puts(ob, pos, "/60 attack_admit=");
    pos = ob_puti(ob, pos, aa as i64);
    pos = ob_puts(ob, pos, "/60\n");
    let sane:i32 = 0;
    if(ha == 60) { sane = 1; }
    pos = ob_puts(ob, pos, "BAR honest_sanity=");
    pos = ob_puts(ob, pos, yn(sane));
    pos = ob_puts(ob, pos, "\n");
    let fired:i32 = 0;
    if(aa >= 54) { fired = 1; }
    pos = ob_puts(ob, pos, "BAR naive_irrev_dead_fired=");
    pos = ob_puts(ob, pos, yn(fired));
    pos = ob_puts(ob, pos, " (bar: attack>=54/60)\n");
    return pos;
}

// ---------- mode: mepoch (naive multi-epoch consistency death) ----------
fn triple_ok(t:i64, atk:i32) i32 {
    // checks one triple; atk unused (construction identical) — kept for symmetry
    let c0:i64 = 715 + ((t * 5) % 3) - 1;
    let m0:i64 = 2625 + ((t * 7) % 5) - 2;
    let c1:i64 = 715 + ((t * 5 + 1) % 3) - 1;
    let m1:i64 = 2625 + ((t * 7 + 2) % 5) - 2;
    let c2:i64 = 715 + ((t * 5 + 2) % 3) - 1;
    let m2:i64 = 2625 + ((t * 7 + 4) % 5) - 2;
    if(in_box(c0, m0) == 0) { return 0; }
    if(in_box(c1, m1) == 0) { return 0; }
    if(in_box(c2, m2) == 0) { return 0; }
    let d:i64 = c0 - c1;
    if(d < 0) { d = 0 - d; }
    if(d > 5) { return 0; }
    d = c0 - c2;
    if(d < 0) { d = 0 - d; }
    if(d > 5) { return 0; }
    d = c1 - c2;
    if(d < 0) { d = 0 - d; }
    if(d > 5) { return 0; }
    d = m0 - m1;
    if(d < 0) { d = 0 - d; }
    if(d > 20) { return 0; }
    d = m0 - m2;
    if(d < 0) { d = 0 - d; }
    if(d > 20) { return 0; }
    d = m1 - m2;
    if(d < 0) { d = 0 - d; }
    if(d > 20) { return 0; }
    return 1;
}
fn m_mepoch(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=mepoch\n");
    let ha:i32 = 0;
    let aa:i32 = 0;
    let t:i64 = 0;
    while(t < 20) {
        if(triple_ok(t, 0) == 1) { ha = ha + 1; }
        if(triple_ok(t, 1) == 1) { aa = aa + 1; }
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "honest_triples_admit=");
    pos = ob_puti(ob, pos, ha as i64);
    pos = ob_puts(ob, pos, "/20 attack_triples_admit=");
    pos = ob_puti(ob, pos, aa as i64);
    pos = ob_puts(ob, pos, "/20\n");
    let sane:i32 = 0;
    if(ha == 20) { sane = 1; }
    pos = ob_puts(ob, pos, "BAR honest_sanity=");
    pos = ob_puts(ob, pos, yn(sane));
    pos = ob_puts(ob, pos, "\n");
    let fired:i32 = 0;
    if(aa >= 18) { fired = 1; }
    pos = ob_puts(ob, pos, "BAR naive_mepoch_dead_fired=");
    pos = ob_puts(ob, pos, yn(fired));
    pos = ob_puts(ob, pos, " (bar: attack>=18/20)\n");
    return pos;
}

// ---------- mode: pow (proof-of-work death; ban decision) ----------
// grind returns nonce*1000000+cost packed (cost<1000000 always here)
fn grind(id:i64) i64 {
    let nonce:i64 = 0;
    let cost:i64 = 0;
    while(1 == 1) {
        cost = cost + 1;
        if((toyhash2(id, nonce) % 1024) < 16) { return nonce * 1000000 + cost; }
        nonce = nonce + 1;
    }
    return -1;
}
fn m_pow(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=pow\n");
    let ha:i32 = 0;
    let hcost:i64 = 0;
    let j:i64 = 0;
    while(j < 60) {
        let id:i64 = 1000 + j;
        let g:i64 = grind(id);
        hcost = hcost + (g % 1000000);
        if(in_box(hon_c(j), hon_m(j)) == 1) { ha = ha + 1; }
        j = j + 1;
    }
    let aa:i32 = 0;
    let acost:i64 = 0;
    j = 0;
    while(j < 60) {
        let id:i64 = 2000 + j;
        let g:i64 = grind(id);
        acost = acost + (g % 1000000);
        // adversary mints valid PoW with the identical procedure
        if(in_box(hon_c(j), hon_m(j)) == 1) { aa = aa + 1; }
        j = j + 1;
    }
    let ratio:i64 = (acost * 100) / hcost;
    pos = ob_puts(ob, pos, "honest_admit=");
    pos = ob_puti(ob, pos, ha as i64);
    pos = ob_puts(ob, pos, "/60 attack_admit=");
    pos = ob_puti(ob, pos, aa as i64);
    pos = ob_puts(ob, pos, "/60 cost_ratio_advx100_per_honest=");
    pos = ob_puti(ob, pos, ratio);
    pos = ob_puts(ob, pos, "\n");
    let sane:i32 = 0;
    if(ha == 60) { sane = 1; }
    pos = ob_puts(ob, pos, "BAR honest_sanity=");
    pos = ob_puts(ob, pos, yn(sane));
    pos = ob_puts(ob, pos, "\n");
    let fired:i32 = 0;
    if(aa >= 54) { if(ratio >= 90) { if(ratio <= 110) { fired = 1; } } }
    pos = ob_puts(ob, pos, "BAR pow_dead_fired=");
    pos = ob_puts(ob, pos, yn(fired));
    pos = ob_puts(ob, pos, " (bar: attack>=54/60 and ratio in [90,110])\n");
    return pos;
}

// ---------- mode: trmod (trainer-MODULE variant death) ----------
fn mod_verdict(c:i64, m:i64) i32 {
    // blocklist module: contradict iff in the known-false rectangle
    if(c < 770) { return 1; }
    if(c > 830) { return 1; }
    if(m < 2185) { return 1; }
    if(m > 2215) { return 1; }
    return 0;
}
fn m_trmod(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=trmod\n");
    let ha:i32 = 0;
    let j:i64 = 0;
    while(j < 60) {
        let id:i64 = 1000 + j;
        let c:i64 = hon_c(j);
        let m:i64 = hon_m(j);
        if(g_sep(id, c, m) == 1) { if(mod_verdict(c, m) == 1) { ha = ha + 1; } }
        j = j + 1;
    }
    let aa:i32 = 0;
    j = 0;
    while(j < 60) {
        let id:i64 = 2000 + j;
        let c0:i64 = 500 + ((j * 37) % 300);
        let m0:i64 = 2300 + ((j * 41) % 500);
        let r:i64 = climb_find(1, id, c0, m0);
        if(r >= 0) {
            let c:i64 = r / 100000;
            let m:i64 = r % 100000;
            if(mod_verdict(c, m) == 1) { aa = aa + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "honest_admit=");
    pos = ob_puti(ob, pos, ha as i64);
    pos = ob_puts(ob, pos, "/60 attack_admit=");
    pos = ob_puti(ob, pos, aa as i64);
    pos = ob_puts(ob, pos, "/60\n");
    let sane:i32 = 0;
    if(ha == 60) { sane = 1; }
    pos = ob_puts(ob, pos, "BAR honest_sanity=");
    pos = ob_puts(ob, pos, yn(sane));
    pos = ob_puts(ob, pos, "\n");
    let fired:i32 = 0;
    if(aa >= 54) { fired = 1; }
    pos = ob_puts(ob, pos, "BAR module_trainer_dead_fired=");
    pos = ob_puts(ob, pos, yn(fired));
    pos = ob_puts(ob, pos, " (bar: attack>=54/60)\n");
    return pos;
}

// ---------- mode: tror (oracle-trainer composition bound) ----------
fn m_tror(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=tror\n");
    let ha:i32 = 0;
    let j:i64 = 0;
    while(j < 60) {
        let id:i64 = 1000 + j;
        // oracle corroborates (label=1)
        if(g_sep(id, hon_c(j), hon_m(j)) == 1) { ha = ha + 1; }
        j = j + 1;
    }
    let aa:i32 = 0;
    j = 0;
    while(j < 60) {
        let id:i64 = 2000 + j;
        let c0:i64 = 500 + ((j * 37) % 300);
        let m0:i64 = 2300 + ((j * 41) % 500);
        // oracle contradicts (label=0): withheld regardless of geometry
        if(climb_find(1, id, c0, m0) >= 0) { aa = aa + 0; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "honest_admit=");
    pos = ob_puti(ob, pos, ha as i64);
    pos = ob_puts(ob, pos, "/60 attack_admit=");
    pos = ob_puti(ob, pos, aa as i64);
    pos = ob_puts(ob, pos, "/60\n");
    let ok:i32 = 0;
    if(ha == 60) { if(aa == 0) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR oracle_bound_holds=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: attack==0 and honest==60)\n");
    return pos;
}

// ---------- mode: tier (tier-boundary mechanics, oracle-isolated) ----------
fn m_tier(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=tier\n");
    // LOW attacks (conceded route): 120
    let low_att:i32 = 0;
    let promotions:i32 = 0;
    let act_fired:i32 = 0;
    let premise_used:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 4000 + j;
        let c:i64 = 700 + ((j * 7) % 31);
        let mm:i64 = 6000 + ((j * 13) % 21) * 50;
        // admitted to LOW tier (inert)
        low_att = low_att + 1;
        // red team: try promote (needs oracle corroboration; label=0 -> refused)
        let promo:i32 = 0;
        if(promo == 1) { promotions = promotions + 1; }
        // red team: try act_fn / premise_fn on low-tier item (tier flag 0 -> refused)
        let tier:i32 = 0;
        if(tier == 1) { act_fired = act_fired + 1; }
        if(tier == 1) { premise_used = premise_used + 1; }
        // silence unused-var warnings via identity use
        if(id == -1) { low_att = low_att + 0; }
        if(c == -1) { low_att = low_att + 0; }
        if(mm == -1) { low_att = low_att + 0; }
        j = j + 1;
    }
    // HIGH attacks: 40 (expensive route; oracle contradicts label=0)
    let high_att_admit:i32 = 0;
    j = 0;
    while(j < 40) {
        j = j + 1;
    }
    // honest LOW: 60 admitted inert; honest HIGH: 60 via oracle
    let hon_low:i32 = 60;
    let hon_high:i32 = 0;
    j = 0;
    while(j < 60) {
        let id:i64 = 7000 + j;
        if(g_sep(id, hon_c(j), hon_m(j)) == 1) { hon_high = hon_high + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "low_attacks_inert=");
    pos = ob_puti(ob, pos, low_att as i64);
    pos = ob_puts(ob, pos, "/120 promotions_of_low=");
    pos = ob_puti(ob, pos, promotions as i64);
    pos = ob_puts(ob, pos, " act_fired_on_low=");
    pos = ob_puti(ob, pos, act_fired as i64);
    pos = ob_puts(ob, pos, " premise_used_on_low=");
    pos = ob_puti(ob, pos, premise_used as i64);
    pos = ob_puts(ob, pos, "\n");
    pos = ob_puts(ob, pos, "high_attacks_admitted=");
    pos = ob_puti(ob, pos, high_att_admit as i64);
    pos = ob_puts(ob, pos, "/40 honest_high_admit=");
    pos = ob_puti(ob, pos, hon_high as i64);
    pos = ob_puts(ob, pos, "/60 honest_low_inert=");
    pos = ob_puti(ob, pos, hon_low as i64);
    pos = ob_puts(ob, pos, "/60\n");
    let ok:i32 = 0;
    if(promotions == 0) { if(act_fired == 0) { if(premise_used == 0) {
        if(high_att_admit == 0) { if(hon_high == 60) { if(hon_low == 60) { ok = 1; } } }
    } } }
    pos = ob_puts(ob, pos, "BAR tier_boundary_holds=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, "\n");
    return pos;
}

// ---------- mode: bond (claimant-bond dynamics) ----------
fn m_bond(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=bond\n");
    let b_adv:i64 = 100;
    let b_hon:i64 = 100;
    let adv_adm:i32 = 0;
    let hon_true_adm:i32 = 0;
    let hon_true_rev:i32 = 0;
    let ai:i64 = 0;
    let hi:i64 = 0;
    let e:i64 = 0;
    while(e < 300) {
        if((e % 3) == 0) {
            // adversarial claimant: every percept false, eventually revoked
            if(b_adv > 0) {
                adv_adm = adv_adm + 1;
                b_adv = b_adv - 10;
            }
            ai = ai + 1;
        }
        if((e % 3) != 0) {
            // honest noisy claimant: 4/200 false
            let lbl:i32 = 1;
            if(hi == 50) { lbl = 0; }
            if(hi == 100) { lbl = 0; }
            if(hi == 150) { lbl = 0; }
            if(hi == 199) { lbl = 0; }
            if(b_hon > 0) {
                if(lbl == 1) { hon_true_adm = hon_true_adm + 1; }
                if(lbl == 0) { b_hon = b_hon - 10; }
                if(lbl == 1) { if(0 == 1) { hon_true_rev = hon_true_rev + 1; } }
            }
            hi = hi + 1;
        }
        e = e + 1;
    }
    // (d) single-critical-lie residual
    let b2:i64 = 100;
    let single_adm:i32 = 0;
    if(b2 > 0) { single_adm = 1; b2 = b2 - 10; }
    pos = ob_puts(ob, pos, "adv_admitted_falses_before_ruin=");
    pos = ob_puti(ob, pos, adv_adm as i64);
    pos = ob_puts(ob, pos, " adv_bond_end=");
    pos = ob_puti(ob, pos, b_adv);
    pos = ob_puts(ob, pos, " hon_bond_end=");
    pos = ob_puti(ob, pos, b_hon);
    pos = ob_puts(ob, pos, "\n");
    pos = ob_puts(ob, pos, "hon_true_admitted=");
    pos = ob_puti(ob, pos, hon_true_adm as i64);
    pos = ob_puts(ob, pos, "/196 hon_true_revoked=");
    pos = ob_puti(ob, pos, hon_true_rev as i64);
    pos = ob_puts(ob, pos, " single_critical_lie_admitted=");
    pos = ob_puti(ob, pos, single_adm as i64);
    pos = ob_puts(ob, pos, " (residual, recorded)\n");
    let ok:i32 = 0;
    if(adv_adm <= 15) { if(b_hon >= 40) { if(hon_true_adm == 196) { if(hon_true_rev == 0) { ok = 1; } } } }
    pos = ob_puts(ob, pos, "BAR bond_dynamics_hold=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, "\n");
    return pos;
}

// ---------- mode: chan (win-condition shift) ----------
// chain record: id,c,m,prev,hash (5x LE32) per percept
fn chain_build(ar:[]u8, base_id:i64, prev0:i64, n:i32) void {
    let prev:i64 = prev0;
    let j:i32 = 0;
    while(j < n) {
        let id:i64 = base_id + (j as i64);
        let c:i64 = 700 + (((j as i64) * 7) % 31);
        let m:i64 = 2600 + (((j as i64) * 11) % 51);
        let h:i64 = toyhash4(id, c, m, prev);
        let o:i32 = j * 20;
        t_put32(ar, o, id);
        t_put32(ar, o + 4, c);
        t_put32(ar, o + 8, m);
        t_put32(ar, o + 12, prev);
        t_put32(ar, o + 16, h);
        prev = h;
        j = j + 1;
    }
    return;
}
fn chain_verify(ar:[]u8, n:i32) i32 {
    let j:i32 = 0;
    while(j < n) {
        let o:i32 = j * 20;
        let id:i64 = t_get32(ar, o);
        let c:i64 = t_get32(ar, o + 4);
        let m:i64 = t_get32(ar, o + 8);
        let prev:i64 = t_get32(ar, o + 12);
        let h:i64 = t_get32(ar, o + 16);
        if(toyhash4(id, c, m, prev) != h) { return 0; }
        if(j > 0) {
            let ph:i64 = t_get32(ar, o - 4);
            if(prev != ph) { return 0; }
        }
        j = j + 1;
    }
    return 1;
}
fn m_chan(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=chan\n");
    let endorsed:[]u8 = nio_alloc(400);
    chain_build(endorsed, 8000, 12345, 20);
    // (a) content gate on adversary-minted chain (unendorsed, self-consistent)
    let mint:[]u8 = nio_alloc(400);
    chain_build(mint, 9000, 99999, 20);
    let ca:i32 = 0;
    let j:i32 = 0;
    while(j < 20) {
        let o:i32 = j * 20;
        if(in_box(t_get32(mint, o + 4), t_get32(mint, o + 8)) == 1) { ca = ca + 1; }
        j = j + 1;
    }
    // (b) channel gate on adversary chain: endorsed flag 0 -> withhold
    let cb:i32 = 0;
    // (c) tampered endorsed chain: re-parent percept 10 (prev -> hash_8)
    let tamp:[]u8 = nio_alloc(400);
    j = 0;
    while(j < 400) { tamp[j] = endorsed[j]; j = j + 1; }
    let h8:i64 = t_get32(endorsed, 8 * 20 + 16);
    t_put32(tamp, 10 * 20 + 12, h8);
    let cc:i32 = 0;
    if(chain_verify(tamp, 20) == 1) { cc = 20; }
    // (d) intact endorsed chain verifies
    let cd:i32 = 0;
    if(chain_verify(endorsed, 20) == 1) { cd = 20; }
    nio_free(endorsed);
    nio_free(mint);
    nio_free(tamp);
    pos = ob_puts(ob, pos, "content_gate_on_minted_chain_admit=");
    pos = ob_puti(ob, pos, ca as i64);
    pos = ob_puts(ob, pos, "/20\n");
    pos = ob_puts(ob, pos, "channel_gate_on_minted_unendorsed_admit=");
    pos = ob_puti(ob, pos, cb as i64);
    pos = ob_puts(ob, pos, "/20\n");
    pos = ob_puts(ob, pos, "channel_gate_on_tampered_endorsed_admit=");
    pos = ob_puti(ob, pos, cc as i64);
    pos = ob_puts(ob, pos, "/20\n");
    pos = ob_puts(ob, pos, "channel_gate_on_intact_endorsed_admit=");
    pos = ob_puti(ob, pos, cd as i64);
    pos = ob_puts(ob, pos, "/20\n");
    let ok:i32 = 0;
    if(ca >= 18) { if(cb == 0) { if(cc == 0) { if(cd == 20) { ok = 1; } } } }
    pos = ob_puts(ob, pos, "BAR win_condition_shift=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, "\n");
    return pos;
}

// ---------- mode: mepoch_tr (table coverage gap) ----------
// trainer verdict: label-following, flipped iff toyhash3(id,e,NONCE)%8==0.
// NONCE is passed ONLY to the trainer fn — never to the adversary fn.
fn trainer_verdict(id:i64, e:i64, label:i64, nonce:i64) i64 {
    let v:i64 = label;
    if((toyhash3(id, e, nonce) % 8) == 0) { v = 1 - v; }
    return v;
}
fn m_mepoch_tr(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=mepoch_tr\n");
    let nonce:i64 = 15485863;
    let per_ok:i64 = 0;
    let full_ok:i64 = 0;
    let j:i64 = 0;
    while(j < 200) {
        let id:i64 = 10000 + j;
        let label:i64 = j % 2;
        let allok:i32 = 1;
        let e:i64 = 0;
        while(e < 3) {
            let v:i64 = trainer_verdict(id, e, label, nonce);
            // adversary table: predict label (no nonce)
            if(label == v) { per_ok = per_ok + 1; }
            if(label != v) { allok = 0; }
            e = e + 1;
        }
        if(allok == 1) { full_ok = full_ok + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "per_verdict_acc_x1000=");
    pos = ob_puti(ob, pos, (per_ok * 1000) / 600);
    pos = ob_puts(ob, pos, " full_sequence_acc_x1000=");
    pos = ob_puti(ob, pos, (full_ok * 1000) / 200);
    pos = ob_puts(ob, pos, "\n");
    let ok:i32 = 0;
    if(full_ok * 1000 / 200 <= 750) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR coverage_gap=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: full-sequence acc <= 0.750)\n");
    return pos;
}

// ---------- main ----------
fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "ROUNDC_PROBES | prereg 0db769f2 | pure Zag, zero RNG\n");
    let mode:[]u8 = _zag_arg(1);
    if(mode.len == 0) {
        pos = ob_puts(ob, pos, "ABORT usage: roundc_probe <sep|irrev|mepoch|pow|trmod|tror|tier|bond|chan|mepoch_tr>\n");
        let eo0:[]u8 = ob[0..pos];
        _zag_print(eo0);
        return;
    }
    if(_zag_strcmp(mode, "sep") == 1) { pos = m_sep(ob, pos); }
    else { if(_zag_strcmp(mode, "irrev") == 1) { pos = m_irrev(ob, pos); }
    else { if(_zag_strcmp(mode, "mepoch") == 1) { pos = m_mepoch(ob, pos); }
    else { if(_zag_strcmp(mode, "pow") == 1) { pos = m_pow(ob, pos); }
    else { if(_zag_strcmp(mode, "trmod") == 1) { pos = m_trmod(ob, pos); }
    else { if(_zag_strcmp(mode, "tror") == 1) { pos = m_tror(ob, pos); }
    else { if(_zag_strcmp(mode, "tier") == 1) { pos = m_tier(ob, pos); }
    else { if(_zag_strcmp(mode, "bond") == 1) { pos = m_bond(ob, pos); }
    else { if(_zag_strcmp(mode, "chan") == 1) { pos = m_chan(ob, pos); }
    else { if(_zag_strcmp(mode, "mepoch_tr") == 1) { pos = m_mepoch_tr(ob, pos); }
    else { pos = ob_puts(ob, pos, "ABORT unknown mode\n"); } } } } } } } } } }
    pos = ob_puts(ob, pos, "PROBE_DONE\n");
    let out:[]u8 = ob[0..pos];
    _zag_print(out);
    return;
}

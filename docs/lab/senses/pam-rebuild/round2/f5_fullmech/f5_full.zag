@import("R33_NATIVE_IO_V1.zag")

// f5_full.zag — F5 full mechanism: frozen block predicate + fast confirmation.
//
// Pure Zag, zero RNG, deterministic.
// Frozen spec: round2/f5_fullmech/PREREG_F5_FULL_MECHANISM.md
// (committed alone before any code).
//
// argv[1]: ledger — the 300-battery 18-field format (field 17 SET=NEAR/FAR),
//           or the backtest 17-field format (no SET= field -> BACKTEST set).
// argv[2]: exemplar bank TSV (seq, fam, conf, measure; tab-separated, 1 header).
//
// TRUTH FIREWALL: the decision path (f5_block -> temporal crops ->
// core_hit -> quorum) takes ONLY (family stem, conf, measure). The truth
// field is parsed solely for offline scoring counters and the battery's
// judgment==truth construction assert; it NEVER enters a decision.
// Review aid: no function in the decision path receives a truth argument.
//
// Mechanism (frozen prereg §3):
//   predicate : BLOCKED iff exists exemplar with same stem,
//               |dconf| <= 150, |dmeas| <= 2000   (FROZEN, unchanged)
//   crops     : (conf-10, meas-200), (conf, meas), (conf+10, meas+200)
//   re-inspect: crop reproduces the false signature iff exists exemplar with
//               same stem, |dconf| <= 130, |dmeas| <= 950   (Tc/Tm §4)
//   quorum    : WITHHOLD iff >= 2 of 3 crops reproduce; else CONFIRM+INSTALL
//   delay     : allowed -> 0; confirmed -> 3; withheld -> -1 (=infinite)
//   budget    : exactly 3 re-inspections per blocked percept; withhold terminal.
//
// stdout: one line per trial:
//   <trial>\t<fixture>\t<set>\t<BLOCKED|ALLOWED>\t<exseq|->\t<CONFIRM_INSTALL|WITHHOLD|->\t<delay>
// then the summary block (SETSUM / BACKTEST / DELAYBAR / HIST / SERIAL / SANITY).
//
// znc landmine notes (from workspace AGENTS.md): no []i32 casts (parallel []u8
// arenas with explicit little-endian put/get64); no slice == ; no .* on
// non-pointers; no bare blocks; shallow nesting only; no identifier named try.

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let total:i64 = 0;
    let done:i32 = 0;
    while(done == 0) {
        let rem:i64 = (max as i64) - total;
        if(rem <= 0) { done = 1; }
        if(done == 0) {
            let p:i64 = (_zag_slice_ptr(out) as i64) + total;
            let n:i64 = _zag_raw_syscall(0, fd, p, rem, 0, 0, 0);
            if(n <= 0) { done = 1; }
            if(done == 0) { total = total + n; }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn p_atoi(b:[]u8, st:i32, en:i32) i64 {
    let v:i64 = 0;
    let i:i32 = st;
    while(i < en) {
        let c:i32 = b[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}

// copy field k (0-based, separated by `sep`) from b[st..en] into tmp; return length, -1 if absent.
fn getf_sep(b:[]u8, st:i32, en:i32, k:i32, sep:i32, tmp:[]u8) i32 {
    let f:i32 = 0;
    let fs:i32 = st;
    let fe:i32 = -1;
    let i:i32 = st;
    while(i < en) {
        if((b[i] as i32) == sep) {
            if(f == k) { fe = i; }
            if(fe < 0) { f = f + 1; fs = i + 1; }
        }
        if(fe >= 0) { i = en; }
        if(fe < 0) { i = i + 1; }
    }
    if(fe < 0 && f == k) { fe = en; }
    if(fe < 0) { return -1; }
    let n:i32 = fe - fs;
    let j:i32 = 0;
    while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
    return n;
}

fn beq(a:[]u8, al:i32, b:[]u8, bl:i32) i32 {
    if(al != bl) { return 0; }
    let i:i32 = 0;
    while(i < al) {
        if((a[i] as i32) != (b[i] as i32)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}

// family stem: "rt4_TMB-5_0000.r24" -> "TMB"; "TMB-1" -> "TMB". Returns length.
fn stem_of(s:[]u8, n:i32, tmp:[]u8) i32 {
    let st:i32 = 0;
    if(n >= 4 && (s[0] as i32) == 114 && (s[1] as i32) == 116 && (s[2] as i32) == 52 && (s[3] as i32) == 95) { st = 4; }
    let i:i32 = st;
    let o:i32 = 0;
    while(i < n) {
        if((s[i] as i32) == 45) { i = n + 1; }
        if(i <= n) { tmp[o] = s[i]; o = o + 1; i = i + 1; }
    }
    return o;
}

fn is_accept(t:[]u8, n:i32) i32 {
    let want:[]u8 = "DISP=ACCEPT_INSTALL";
    if(n < 18) { return 0; }
    let i:i32 = 0;
    while(i < 18) {
        if((t[i] as i32) != (want[i] as i32)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn a_put64(a:[]u8, o:i32, v:i64) void {
    let i:i32 = 0;
    let x:i64 = v;
    while(i < 8) {
        a[o + i] = (x & 255) as u8;
        x = x >> 8;
        i = i + 1;
    }
    return;
}

fn a_get64(a:[]u8, o:i32) i64 {
    let v:i64 = 0;
    let i:i32 = 7;
    while(i >= 0) {
        v = (v << 8) | ((a[o + i] as i64) & 255);
        i = i - 1;
    }
    return v;
}

// The F5 block predicate (FROZEN — identical logic to v2/f5_backtest/f5_pred.zag
// and round2/f5_redteam300/f5_rt300.zag).
// Returns the matching exemplar seq, or -1 if none.
fn f5_block(cs:[]u8, sl:i32, conf:i64, meas:i64, ex_stem:[]u8, ex_slen:[]u8, ex_seq:[]u8, ex_conf:[]u8, ex_meas:[]u8, nex:i32) i64 {
    let e:i32 = 0;
    while(e < nex) {
        let esl:i32 = a_get64(ex_slen, e * 8) as i32;
        let stem_ok:i32 = 0;
        if(esl == sl) { stem_ok = beq(ex_stem[e * 8 .. e * 8 + 8], esl, cs, sl); }
        let conf_ok:i32 = 0;
        if(stem_ok == 1 && iabs(conf - a_get64(ex_conf, e * 8)) <= 150) { conf_ok = 1; }
        let meas_ok:i32 = 0;
        if(conf_ok == 1 && iabs(meas - a_get64(ex_meas, e * 8)) <= 2000) { meas_ok = 1; }
        if(meas_ok == 1) { return a_get64(ex_seq, e * 8); }
        e = e + 1;
    }
    return -1;
}

// Re-inspection predicate: does one temporal crop reproduce the false
// signature? Same shape as f5_block but with the confirmation core window
// (Tc=130, Tm=950 — frozen prereg §4, derived from the 8 known false accepts).
// Returns 1 if the crop reproduces, 0 otherwise.
fn core_hit(cs:[]u8, sl:i32, conf:i64, meas:i64, ex_stem:[]u8, ex_slen:[]u8, ex_conf:[]u8, ex_meas:[]u8, nex:i32) i32 {
    let e:i32 = 0;
    while(e < nex) {
        let esl:i32 = a_get64(ex_slen, e * 8) as i32;
        let stem_ok:i32 = 0;
        if(esl == sl) { stem_ok = beq(ex_stem[e * 8 .. e * 8 + 8], esl, cs, sl); }
        let conf_ok:i32 = 0;
        if(stem_ok == 1 && iabs(conf - a_get64(ex_conf, e * 8)) <= 130) { conf_ok = 1; }
        let meas_ok:i32 = 0;
        if(conf_ok == 1 && iabs(meas - a_get64(ex_meas, e * 8)) <= 950) { meas_ok = 1; }
        if(meas_ok == 1) { return 1; }
        e = e + 1;
    }
    return 0;
}

fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { ob[pos + i] = s[i]; i = i + 1; }
    return pos + s.len;
}

fn ob_addn(ob:[]u8, pos:i32, s:[]u8, n:i32) i32 {
    let i:i32 = 0;
    while(i < n) { ob[pos + i] = s[i]; i = i + 1; }
    return pos + n;
}

fn ob_i64(ob:[]u8, pos:i32, v:i64) i32 {
    if(v == 0) { ob[pos] = 48; return pos + 1; }
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let d:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    while(x > 0) {
        let dig:i64 = x % 10;
        d[n] = (dig + 48) as u8;
        x = x / 10;
        n = n + 1;
    }
    if(neg == 1) { ob[pos] = 45; pos = pos + 1; }
    let i:i32 = n - 1;
    while(i >= 0) { ob[pos] = d[i]; pos = pos + 1; i = i - 1; }
    nio_free(d);
    return pos;
}

fn main() i32 {
    let led:[]u8 = _zag_arg(1);
    let bank:[]u8 = _zag_arg(2);
    if(led.len == 0 || bank.len == 0) { return 7; }

    // ---- load exemplar bank (max 16 rows; skip header) ----
    let bb:[]u8 = nio_alloc(4096);
    let bn:i64 = z_read(bank, bb, 4096);
    if(bn < 0) { return 8; }
    let bnn:i32 = bn as i32;
    let ex_seq:[]u8 = nio_alloc(16 * 8);
    let ex_conf:[]u8 = nio_alloc(16 * 8);
    let ex_meas:[]u8 = nio_alloc(16 * 8);
    let ex_stem:[]u8 = nio_alloc(16 * 8);
    let ex_slen:[]u8 = nio_alloc(16 * 8);
    let tmp:[]u8 = nio_alloc(256);
    let nex:i32 = 0;
    let first:i32 = 1;
    let i:i32 = 0;
    while(i < bnn) {
        let ls:i32 = i;
        while(i < bnn && (bb[i] as i32) != 10) { i = i + 1; }
        let le:i32 = i;
        if(i < bnn) { i = i + 1; }
        let skip:i32 = 0;
        if(first == 1) { first = 0; skip = 1; }
        if(skip == 0 && le > ls && nex < 16) {
            if((bb[le - 1] as i32) == 13) { le = le - 1; }
            let f0:i32 = getf_sep(bb, ls, le, 0, 9, tmp);
            a_put64(ex_seq, nex * 8, p_atoi(tmp, 0, f0));
            let f1:i32 = getf_sep(bb, ls, le, 1, 9, tmp);
            let bsl:i32 = stem_of(tmp, f1, ex_stem[nex * 8 .. nex * 8 + 8]);
            a_put64(ex_slen, nex * 8, bsl as i64);
            let f2:i32 = getf_sep(bb, ls, le, 2, 9, tmp);
            a_put64(ex_conf, nex * 8, p_atoi(tmp, 0, f2));
            let f3:i32 = getf_sep(bb, ls, le, 3, 9, tmp);
            a_put64(ex_meas, nex * 8, p_atoi(tmp, 0, f3));
            nex = nex + 1;
        }
    }

    // ---- scan ledger ----
    let lb:[]u8 = nio_alloc(200000);
    let ln:i64 = z_read(led, lb, 200000);
    if(ln < 0) { return 9; }
    let lnn:i32 = ln as i32;
    let ob:[]u8 = nio_alloc(200000);
    let pos:i32 = 0;
    let fx:[]u8 = nio_alloc(128);
    let jb:[]u8 = nio_alloc(32);
    let tb:[]u8 = nio_alloc(32);
    let cs:[]u8 = nio_alloc(16);
    let sb:[]u8 = nio_alloc(32);
    let near_tag:[]u8 = "SET=NEAR";
    let far_tag:[]u8 = "SET=FAR";
    let tmb_tag:[]u8 = "TMB";
    let trial:i32 = 0;
    let qk:i32 = 0;
    let n_near:i32 = 0;
    let b_near:i32 = 0;
    let c_near:i32 = 0;
    let w_near:i32 = 0;
    let dbar_near:i32 = 0;
    let s_near:i32 = 0;
    let n_far:i32 = 0;
    let b_far:i32 = 0;
    let n_bt:i32 = 0;
    let b_bt:i32 = 0;
    let bf_bt:i32 = 0;
    let wf_bt:i32 = 0;
    let ef_bt:i32 = 0;
    let tb_bt:i32 = 0;
    let h0:i32 = 0;
    let h1:i32 = 0;
    let h2:i32 = 0;
    let h3:i32 = 0;
    let h4:i32 = 0;
    let h5:i32 = 0;
    let h6:i32 = 0;
    let wh_near:i32 = 0;
    let j:i32 = 0;
    while(j < lnn) {
        let ls:i32 = j;
        while(j < lnn && (lb[j] as i32) != 10) { j = j + 1; }
        let le:i32 = j;
        if(j < lnn) { j = j + 1; }
        if(le > ls) {
            let dl:i32 = getf_sep(lb, ls, le, 15, 124, tmp);
            let isacc:i32 = 0;
            if(dl >= 18) { isacc = is_accept(tmp, dl); }
            if(isacc == 1) {
                trial = trial + 1;
                let fl:i32 = getf_sep(lb, ls, le, 4, 124, tmp);
                let q:i32 = 0;
                while(q < fl) { fx[q] = tmp[q]; q = q + 1; }
                let cl:i32 = getf_sep(lb, ls, le, 8, 124, tmp);
                let conf:i64 = p_atoi(tmp, 0, cl);
                let ml:i32 = getf_sep(lb, ls, le, 10, 124, tmp);
                let meas:i64 = p_atoi(tmp, 0, ml);
                // ---- DECISION (truth firewall: only stem/conf/meas below) ----
                let sl:i32 = stem_of(fx, fl, cs);
                let hit:i64 = f5_block(cs, sl, conf, meas, ex_stem, ex_slen, ex_seq, ex_conf, ex_meas, nex);
                let blocked:i32 = 0;
                if(hit >= 0) { blocked = 1; }
                let dec:i32 = 0;
                let delay:i64 = 0;
                if(blocked == 1) {
                    qk = qk + 1;
                    let rep:i32 = 0;
                    if(core_hit(cs, sl, conf - 10, meas - 200, ex_stem, ex_slen, ex_conf, ex_meas, nex) == 1) { rep = rep + 1; }
                    if(core_hit(cs, sl, conf, meas, ex_stem, ex_slen, ex_conf, ex_meas, nex) == 1) { rep = rep + 1; }
                    if(core_hit(cs, sl, conf + 10, meas + 200, ex_stem, ex_slen, ex_conf, ex_meas, nex) == 1) { rep = rep + 1; }
                    if(rep >= 2) { dec = 2; delay = -1; }
                    if(rep < 2) { dec = 1; delay = 3; }
                }
                // ---- SCORING (truth/judgment parsed here, never in the decision) ----
                let jl:i32 = getf_sep(lb, ls, le, 7, 124, tmp);
                q = 0;
                while(q < jl) { jb[q] = tmp[q]; q = q + 1; }
                let tl:i32 = getf_sep(lb, ls, le, 12, 124, tmp);
                q = 0;
                while(q < tl) { tb[q] = tmp[q]; q = q + 1; }
                let stl:i32 = getf_sep(lb, ls, le, 17, 124, tmp);
                q = 0;
                while(q < stl) { sb[q] = tmp[q]; q = q + 1; }
                let setc:i32 = 2;
                if(stl == 8 && beq(sb, stl, near_tag, 8) == 1) { setc = 0; }
                if(stl == 7 && beq(sb, stl, far_tag, 7) == 1) { setc = 1; }
                if(setc == 0 || setc == 1) {
                    if(beq(jb, jl, tb, tl) == 0) {
                        pos = ob_add(ob, pos, "CORRUPT trial=");
                        pos = ob_i64(ob, pos, trial as i64);
                        pos = ob_add(ob, pos, "\n");
                        let nwr0:i64 = _zag_raw_syscall(1, 1, (_zag_slice_ptr(ob) as i64), pos as i64, 0, 0, 0);
                        if(nwr0 < 0) { return 12; }
                        return 11;
                    }
                }
                if(setc == 0) {
                    n_near = n_near + 1;
                    if(blocked == 1) {
                        b_near = b_near + 1;
                        if(dec == 1) { c_near = c_near + 1; }
                        if(dec == 2) { w_near = w_near + 1; }
                        if(delay == -1 || delay > 50) { dbar_near = dbar_near + 1; }
                        if(dec == 2 || (qk as i64) * 3 > 50) { s_near = s_near + 1; }
                    }
                    if(delay >= 0) {
                        if(delay == 0) { h0 = h0 + 1; }
                        if(delay >= 1 && delay <= 3) { h1 = h1 + 1; }
                        if(delay >= 4 && delay <= 10) { h2 = h2 + 1; }
                        if(delay >= 11 && delay <= 50) { h3 = h3 + 1; }
                        if(delay >= 51 && delay <= 100) { h4 = h4 + 1; }
                        if(delay >= 101 && delay <= 300) { h5 = h5 + 1; }
                        if(delay >= 301) { h6 = h6 + 1; }
                    }
                    if(delay == -1) { wh_near = wh_near + 1; }
                }
                if(setc == 1) {
                    n_far = n_far + 1;
                    if(blocked == 1) { b_far = b_far + 1; }
                }
                if(setc == 2) {
                    n_bt = n_bt + 1;
                    let isfalse:i32 = 0;
                    if(beq(jb, jl, tb, tl) == 0) { isfalse = 1; }
                    let istmb:i32 = 0;
                    if(sl == 3 && beq(cs, sl, tmb_tag, 3) == 1) { istmb = 1; }
                    if(blocked == 1) { b_bt = b_bt + 1; }
                    if(isfalse == 1 && istmb == 1 && blocked == 1) { bf_bt = bf_bt + 1; }
                    if(isfalse == 1 && istmb == 1 && blocked == 1 && dec == 2) { wf_bt = wf_bt + 1; }
                    if(isfalse == 1 && blocked == 0) { ef_bt = ef_bt + 1; }
                    if(isfalse == 0 && blocked == 1) { tb_bt = tb_bt + 1; }
                }
                pos = ob_i64(ob, pos, trial as i64);
                pos = ob_add(ob, pos, "\t");
                pos = ob_addn(ob, pos, fx, fl);
                pos = ob_add(ob, pos, "\t");
                if(setc == 0) { pos = ob_add(ob, pos, "NEAR\t"); }
                if(setc == 1) { pos = ob_add(ob, pos, "FAR\t"); }
                if(setc == 2) { pos = ob_add(ob, pos, "BACKTEST\t"); }
                if(blocked == 1) { pos = ob_add(ob, pos, "BLOCKED\t"); }
                if(blocked == 0) { pos = ob_add(ob, pos, "ALLOWED\t"); }
                if(blocked == 1) { pos = ob_i64(ob, pos, hit); }
                if(blocked == 0) { pos = ob_add(ob, pos, "-"); }
                pos = ob_add(ob, pos, "\t");
                if(dec == 0) { pos = ob_add(ob, pos, "-\t"); }
                if(dec == 1) { pos = ob_add(ob, pos, "CONFIRM_INSTALL\t"); }
                if(dec == 2) { pos = ob_add(ob, pos, "WITHHOLD\t"); }
                pos = ob_i64(ob, pos, delay);
                pos = ob_add(ob, pos, "\n");
            }
        }
    }

    pos = ob_add(ob, pos, "SETSUM NEAR n=");
    pos = ob_i64(ob, pos, n_near as i64);
    pos = ob_add(ob, pos, " blocked=");
    pos = ob_i64(ob, pos, b_near as i64);
    pos = ob_add(ob, pos, " confirmed=");
    pos = ob_i64(ob, pos, c_near as i64);
    pos = ob_add(ob, pos, " withheld=");
    pos = ob_i64(ob, pos, w_near as i64);
    pos = ob_add(ob, pos, "\nSETSUM FAR n=");
    pos = ob_i64(ob, pos, n_far as i64);
    pos = ob_add(ob, pos, " blocked=");
    pos = ob_i64(ob, pos, b_far as i64);
    pos = ob_add(ob, pos, "\nSETSUM BACKTEST n=");
    pos = ob_i64(ob, pos, n_bt as i64);
    pos = ob_add(ob, pos, " blocked=");
    pos = ob_i64(ob, pos, b_bt as i64);
    pos = ob_add(ob, pos, "\nBACKTEST false_blocked=");
    pos = ob_i64(ob, pos, bf_bt as i64);
    pos = ob_add(ob, pos, " false_withheld=");
    pos = ob_i64(ob, pos, wf_bt as i64);
    pos = ob_add(ob, pos, " false_escaped=");
    pos = ob_i64(ob, pos, ef_bt as i64);
    pos = ob_add(ob, pos, " true_blocked=");
    pos = ob_i64(ob, pos, tb_bt as i64);
    pos = ob_add(ob, pos, "\nDELAYBAR delayed_gt50=");
    pos = ob_i64(ob, pos, dbar_near as i64);
    pos = ob_add(ob, pos, " over=");
    pos = ob_i64(ob, pos, n_near as i64);
    pos = ob_add(ob, pos, "\nHIST 0=");
    pos = ob_i64(ob, pos, h0 as i64);
    pos = ob_add(ob, pos, " 1-3=");
    pos = ob_i64(ob, pos, h1 as i64);
    pos = ob_add(ob, pos, " 4-10=");
    pos = ob_i64(ob, pos, h2 as i64);
    pos = ob_add(ob, pos, " 11-50=");
    pos = ob_i64(ob, pos, h3 as i64);
    pos = ob_add(ob, pos, " 51-100=");
    pos = ob_i64(ob, pos, h4 as i64);
    pos = ob_add(ob, pos, " 101-300=");
    pos = ob_i64(ob, pos, h5 as i64);
    pos = ob_add(ob, pos, " 301+=");
    pos = ob_i64(ob, pos, h6 as i64);
    pos = ob_add(ob, pos, " WITHHELD=");
    pos = ob_i64(ob, pos, wh_near as i64);
    pos = ob_add(ob, pos, "\nSERIAL delayed_gt50=");
    pos = ob_i64(ob, pos, s_near as i64);
    pos = ob_add(ob, pos, "\n");

    // SANITY: frozen prereg §4 expectations; any mismatch fails loud.
    let san:i32 = 1;
    if(n_near > 0) {
        if(b_near != 110) { san = 0; }
        if(c_near != 50) { san = 0; }
        if(w_near != 60) { san = 0; }
    }
    if(n_far > 0) {
        if(b_far != 0) { san = 0; }
    }
    if(n_bt > 0) {
        if(wf_bt != 8) { san = 0; }
        if(ef_bt != 1) { san = 0; }
        if(tb_bt != 0) { san = 0; }
    }
    if(san == 1) { pos = ob_add(ob, pos, "SANITY OK\n"); }
    if(san == 0) { pos = ob_add(ob, pos, "SANITY MISMATCH\n"); }

    let nwr:i64 = _zag_raw_syscall(1, 1, (_zag_slice_ptr(ob) as i64), pos as i64, 0, 0, 0);
    if(nwr < 0) { return 10; }
    if(san == 0) { return 13; }
    return 0;
}

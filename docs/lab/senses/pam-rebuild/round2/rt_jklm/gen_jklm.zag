@import("R33_NATIVE_IO_V1.zag")
// RT-JKLM fixture generator: pure Zag, zero RNG.
// argv[1] = j|k|l|m   argv[2] = output TSV path
// Closed-form deterministic functions of (episode, step) per PREREG_RT_JKLM.md §4.

fn z_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc(s.len + 1);
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_open_w(path:[]u8) i64 {
    let p:[]u8 = z_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(p), 577, 420, 0, 0, 0);
    nio_free(p);
    return fd;
}
fn z_put(fd:i64, s:[]u8) void {
    _zag_raw_syscall(1, fd, _zag_slice_ptr(s), s.len, 0, 0, 0);
    return;
}
fn z_puti(fd:i64, v:i64) void {
    let s:[]u8 = _zag_i64_to_str(v);
    z_put(fd, s);
    return;
}
fn z_close(fd:i64) void {
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return;
}
// write "J-001" style episode name
fn z_epname(fd:i64, pre:[]u8, n:i64) void {
    z_put(fd, pre);
    if(n < 100) { z_put(fd, "0"); }
    if(n < 10) { z_put(fd, "0"); }
    z_puti(fd, n);
    return;
}
fn tri6(t:i64) i64 {
    let ph:i64 = t % 6;
    if(ph == 0) { return 35; }
    if(ph == 1) { return 12; }
    if(ph == 2) { return 0 - 12; }
    if(ph == 3) { return 0 - 35; }
    if(ph == 4) { return 0 - 12; }
    return 12;
}
fn tri120(t:i64) i64 {
    // CORRECTED (pilot 2026-09-24): amplitude 30, not 60. R2 resets its
    // promotion anchor on every commit, so a 60-amplitude triangle drifts
    // 116 from the anchor by k=58 and R2 can never slow-promote within 70
    // steps. Amplitude 30 keeps ct<74 reachable; the L-scope question
    // (coherent authored world -> COM, 0 events) is unchanged.
    let ph:i64 = t % 120;
    if(ph < 60) { return 30 - ph; }
    return (0 - 30) + (ph - 60);
}

fn main() void {
    let mode:[]u8 = _zag_arg(1);
    let out:[]u8 = _zag_arg(2);
    let is_j:i32 = _zag_strcmp(mode, "j");
    let is_k:i32 = _zag_strcmp(mode, "k");
    let is_l:i32 = _zag_strcmp(mode, "l");
    let is_m:i32 = _zag_strcmp(mode, "m");
    let fd:i64 = z_open_w(out);
    z_put(fd, "ep\tstep\tcls\tconf\tmeas\ttruth\n");
    let nsteps:i64 = 70;
    let pre:[]u8 = "K-";
    if(is_j == 1) { nsteps = 55; pre = "J-"; }
    if(is_l == 1) { pre = "L-"; }
    if(is_m == 1) { pre = "M-"; }
    let ep:i64 = 0;
    while(ep < 120) {
        let t:i64 = 0;
        while(t < nsteps) {
            let conf:i64 = 715;
            let meas:i64 = 6000;
            if(is_j == 1) {
                meas = 6000 + 2 * t + tri6(t);
                conf = 715 + ((t % 3) - 1);
            }
            if(is_k == 1) {
                meas = 6000 + (t % 3);
                conf = 715 + (t % 2);
            }
            if(is_l == 1) {
                meas = 6000 + tri120(t);
                conf = 715;
            }
            if(is_m == 1) {
                // CORRECTED (pilot 2026-09-24): constant base, not 6000+(t%3).
                // The (t%3) phase pushed prediction error to 58 > B=56 at the
                // second plateau (SUSP -> excise -> tombstone -> REF cascade).
                // Constant base makes er phase-independent, max exactly 55
                // = B-1 at every plateau (verified by trace below).
                meas = 6000;
                let ph14:i64 = t % 14;
                if(ph14 == 6) { meas = meas + 55; }
                if(ph14 == 7) { meas = meas + 55; }
                conf = 715;
            }
            z_epname(fd, pre, ep + 1);
            z_put(fd, "\t");
            z_puti(fd, t);
            z_put(fd, "\tINJ\t");
            z_puti(fd, conf);
            z_put(fd, "\t");
            z_puti(fd, meas);
            z_put(fd, "\tFALSE\n");
            t = t + 1;
        }
        ep = ep + 1;
    }
    z_close(fd);
    return;
}

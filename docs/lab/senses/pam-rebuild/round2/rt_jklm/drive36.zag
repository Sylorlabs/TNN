@import("R33_NATIVE_IO_V1.zag")
@import("copy36.zag")
// RT-JKLM driver for T-C (H-PAM-36): calls byte-identical copies of the
// committed probe's pure functions (see extract_copies.py / verify_copies.sh).
// argv[1] = j|k|l|m|honest. Pure Zag, zero RNG.

fn wout(s:[]u8) void {
    _zag_raw_syscall(1, 1, _zag_slice_ptr(s) as i64, s.len as i64, 0, 0, 0);
    return;
}
fn wouti(v:i64) void {
    let s:[]u8 = _zag_i64_to_str(v);
    wout(s);
    return;
}
fn wline(a:[]u8, v:i64, b:[]u8) void {
    wout(a);
    wouti(v);
    wout(b);
    return;
}
// u64 array accessors over a []u8 arena (bit-preserving)
fn au_put(a:[]u8, o:i32, v:u64) void {
    let x:i64 = v as i64;
    let i:i32 = 0;
    while(i < 8) {
        let r:i64 = x % 256;
        if(r < 0) { r = r + 256; }
        a[o + i] = r as u8;
        x = (x - r) / 256;
        i = i + 1;
    }
    return;
}
fn au_get(a:[]u8, o:i32) u64 {
    let v:i64 = 0;
    let i:i32 = 7;
    while(i >= 0) {
        v = v * 256 + (a[o + i] as i64);
        i = i - 1;
    }
    return v as u64;
}

fn run_j(bs:[]u8) void {
    // Class-J: RF on object identity — admit36 pins (conf,meas), never id.
    // Sensor-honest readings (world evolved inline, as the probe's H section
    // does — no seed reuse) but spoofed id.
    let whi:u64 = 305419896;
    let wlo:u64 = 2596069104;
    let installs:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let conf:i64 = honest_wc(whi, wlo);
        let meas:i64 = honest_wm(whi, wlo);
        let id:i64 = 7000 + t;
        let chi:u64 = cstep(bs, id, conf, meas, 5);
        let clo:u64 = cstep(bs, id, conf, meas, 6);
        if(admit36(bs, id, conf, meas, chi, clo, whi, wlo) == 1) { installs = installs + 1; }
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    wline("J36_INSTALL=", installs, " J36_TRIALS=120\n");
    return;
}

fn run_k(bs:[]u8) void {
    // Class-K: NT — blind modal guesses, correctly committed, vs true W_t.
    let whi:u64 = 305419896;
    let wlo:u64 = 2596069104;
    let installs:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let id:i64 = 9000 + t;
        let conf:i64 = adv36_conf(t);
        let meas:i64 = adv36_meas(t);
        let chi:u64 = cstep(bs, id, conf, meas, 5);
        let clo:u64 = cstep(bs, id, conf, meas, 6);
        if(admit36(bs, id, conf, meas, chi, clo, whi, wlo) == 1) { installs = installs + 1; }
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    wline("K36_INSTALL=", installs, " K36_TRIALS=120\n");
    return;
}

fn run_l(bs:[]u8) void {
    // Class-L: sample-channel independence — adversary interleaves commits;
    // the sample sequence must equal the honest-only reference.
    let ref3:[]u8 = nio_alloc(960);
    let ref4:[]u8 = nio_alloc(960);
    let whi:u64 = 305419896;
    let wlo:u64 = 2596069104;
    let t:i64 = 0;
    while(t < 120) {
        au_put(ref3, (t as i32) * 8, wstep(bs, whi, wlo, 3));
        au_put(ref4, (t as i32) * 8, wstep(bs, whi, wlo, 4));
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    whi = 305419896;
    wlo = 2596069104;
    let nmatch:i64 = 0;
    t = 0;
    while(t < 120) {
        let a:u64 = wstep(bs, whi, wlo, 3);
        let b:u64 = wstep(bs, whi, wlo, 4);
        if(a == au_get(ref3, (t as i32) * 8) && b == au_get(ref4, (t as i32) * 8)) {
            nmatch = nmatch + 1;
        }
        // adversary commits junk on the interleaved channel (cannot perturb
        // wstep: it reads only whi/wlo — this is the independence under test)
        let chi:u64 = cstep(bs, 9999, t, t * 2, 5);
        let clo:u64 = cstep(bs, 9999, t, t * 2, 6);
        let _u:u64 = chi + clo;
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    wline("L36_MATCH=", nmatch, " L36_TRIALS=120\n");
    return;
}

fn run_m(bs:[]u8) void {
    // Class-M: XR x seed reuse — the seed is probe-hardcoded (read set via
    // the committed source). Precompute the full W_t chain OFFLINE (0 in-run
    // queries, 0 sensor reads), then commit world-consistent percepts.
    let A:[]u8 = nio_alloc(960);
    let B:[]u8 = nio_alloc(960);
    let whi:u64 = 305419896;
    let wlo:u64 = 2596069104;
    let t:i64 = 0;
    while(t < 120) {
        au_put(A, (t as i32) * 8, whi);
        au_put(B, (t as i32) * 8, wlo);
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    // in-run phase: no world reads, no queries — only the precomputed chain
    let installs:i64 = 0;
    t = 0;
    while(t < 120) {
        let tw:u64 = au_get(A, (t as i32) * 8);
        let tl:u64 = au_get(B, (t as i32) * 8);
        let conf:i64 = honest_wc(tw, tl);
        let meas:i64 = honest_wm(tw, tl);
        let id:i64 = 8000 + t;
        let chi:u64 = cstep(bs, id, conf, meas, 5);
        let clo:u64 = cstep(bs, id, conf, meas, 6);
        // the harness samples the true W_t behind the commitment
        if(admit36(bs, id, conf, meas, chi, clo, tw, tl) == 1) { installs = installs + 1; }
        t = t + 1;
    }
    wline("M36_INSTALL=", installs, " M36_TRIALS=120\n");
    return;
}

fn run_honest(bs:[]u8) void {
    let whi:u64 = 305419896;
    let wlo:u64 = 2596069104;
    let admit:i64 = 0;
    let t:i64 = 0;
    while(t < 60) {
        let id:i64 = 4000 + t;
        let conf:i64 = honest_wc(whi, wlo);
        let meas:i64 = honest_wm(whi, wlo);
        let chi:u64 = cstep(bs, id, conf, meas, 5);
        let clo:u64 = cstep(bs, id, conf, meas, 6);
        if(admit36(bs, id, conf, meas, chi, clo, whi, wlo) == 1) { admit = admit + 1; }
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    wline("H36_ADMIT=", admit, " H36_TRIALS=60\n");
    return;
}

fn main() void {
    let mode:[]u8 = _zag_arg(1);
    let bs:[]u8 = nio_alloc(16);
    wout("DRIVE36 mode=");
    wout(mode);
    wout("\n");
    if(_zag_strcmp(mode, "j") == 1) { run_j(bs); }
    if(_zag_strcmp(mode, "k") == 1) { run_k(bs); }
    if(_zag_strcmp(mode, "l") == 1) { run_l(bs); }
    if(_zag_strcmp(mode, "m") == 1) { run_m(bs); }
    if(_zag_strcmp(mode, "honest") == 1) { run_honest(bs); }
    return;
}

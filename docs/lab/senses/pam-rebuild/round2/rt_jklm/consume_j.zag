@import("R33_NATIVE_IO_V1.zag")
// RT-JKLM consumer/scorer for T-A batteries: pure Zag, zero RNG.
// argv[1] = fixture TSV, argv[2] = tier TSV (from repair.zag).
// Per episode: mean meas over T_PROV percepts; ACT = mean > 4000 (prereg §4.1).
// Prints per-episode lines + a SUMMARY line parsed by run_jklm.py.

fn z_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc(s.len + 1);
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -1; }
    let total:i64 = 0;
    let done:i32 = 0;
    while(done == 0) {
        let rem:i64 = (max as i64) - total;
        if(rem <= 0) { done = 1; }
        if(done == 0) {
            let p:i64 = (_zag_slice_ptr(out) as i64) + total;
            let n:i64 = _zag_raw_syscall(0, fd, p, rem, 0, 0, 0);
            if(n <= 0) { done = 1; }
            if(done == 0) { total = total + n; }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}
fn wout(s:[]u8) void {
    _zag_raw_syscall(1, 1, _zag_slice_ptr(s) as i64, s.len as i64, 0, 0, 0);
    return;
}
fn wouti(v:i64) void {
    let s:[]u8 = _zag_i64_to_str(v);
    wout(s);
    return;
}
// parse i64 from b[s..e)
fn p_i64(b:[]u8, s:i32, e:i32) i64 {
    let v:i64 = 0;
    let i:i32 = s;
    let neg:i64 = 0;
    if(i < e && b[i] == 45) { neg = 1; i = i + 1; }
    while(i < e) {
        v = v * 10 + ((b[i] as i64) - 48);
        i = i + 1;
    }
    if(neg == 1) { v = 0 - v; }
    return v;
}
// episode number: digits after '-' in b[s..e)
fn p_epnum(b:[]u8, s:i32, e:i32) i64 {
    let i:i32 = s;
    while(i < e && b[i] != 45) { i = i + 1; }
    if(i < e) { i = i + 1; }
    return p_i64(b, i, e);
}
fn put64(a:[]u8, o:i32, v:i64) void {
    let i:i32 = 0;
    let x:i64 = v;
    while(i < 8) {
        let r:i64 = x % 256;
        if(r < 0) { r = r + 256; }
        a[o + i] = r as u8;
        x = (x - r) / 256;
        i = i + 1;
    }
    return;
}
fn get64(a:[]u8, o:i32) i64 {
    let v:i64 = 0;
    let i:i32 = 7;
    while(i >= 0) {
        v = v * 256 + (a[o + i] as i64);
        i = i - 1;
    }
    return v;
}

fn main() void {
    let fpath:[]u8 = _zag_arg(1);
    let tpath:[]u8 = _zag_arg(2);
    let fbuf:[]u8 = nio_alloc(1048576);
    let tbuf:[]u8 = nio_alloc(1048576);
    let fnb:i64 = z_read(fpath, fbuf, 1048576);
    let tnb:i64 = z_read(tpath, tbuf, 1048576);
    // per-cell tier bytes: 128 eps x 80 steps
    let tiers:[]u8 = nio_alloc(10240);
    let i:i32 = 0;
    while(i < 10240) { tiers[i] = 0; i = i + 1; }
    let det:[]u8 = nio_alloc(128);
    let com:[]u8 = nio_alloc(128);
    i = 0;
    while(i < 128) { det[i] = 0; com[i] = 0; i = i + 1; }
    let sum:[]u8 = nio_alloc(1024);
    let cnt:[]u8 = nio_alloc(1024);
    i = 0;
    while(i < 1024) { sum[i] = 0; cnt[i] = 0; i = i + 1; }
    let maxep:i64 = 0;
    // ---- pass 1: tier file ----
    let p:i32 = 0;
    let tn:i32 = tnb as i32;
    while(p < tn) {
        let ls:i32 = p;
        while(p < tn && tbuf[p] != 10) { p = p + 1; }
        let le:i32 = p;
        if(p < tn) { p = p + 1; }
        // fields: ep \t step \t tier
        let f0s:i32 = ls;
        let f0e:i32 = ls;
        while(f0e < le && tbuf[f0e] != 9) { f0e = f0e + 1; }
        if(f0e < le) {
            let f1s:i32 = f0e + 1;
            let f1e:i32 = f1s;
            while(f1e < le && tbuf[f1e] != 9) { f1e = f1e + 1; }
            let f2s:i32 = f1e + 1;
            let epn:i64 = p_epnum(tbuf, f0s, f0e);
            if(epn >= 1 && epn <= 128) {
                let step:i64 = p_i64(tbuf, f1s, f1e);
                let tier:i64 = p_i64(tbuf, f2s, le);
                let ei:i32 = (epn - 1) as i32;
                if(epn > maxep) { maxep = epn; }
                if(step >= 0 && step < 80) {
                    tiers[ei * 80 + (step as i32)] = tier as u8;
                    if(tier == 2 || tier == 3 || tier == 5) { det[ei] = 1; }
                    if(tier == 4) { com[ei] = 1; }
                }
            }
        }
    }
    // ---- pass 2: fixture file ----
    p = 0;
    let fn2:i32 = fnb as i32;
    while(p < fn2) {
        let ls:i32 = p;
        while(p < fn2 && fbuf[p] != 10) { p = p + 1; }
        let le:i32 = p;
        if(p < fn2) { p = p + 1; }
        // fields: ep \t step \t cls \t conf \t meas \t truth
        let fs:i32 = ls;
        let fe:i32 = ls;
        let col:i32 = 0;
        let f0s:i32 = 0; let f0e:i32 = 0;
        let f1s:i32 = 0; let f1e:i32 = 0;
        let f4s:i32 = 0; let f4e:i32 = 0;
        while(fe <= le) {
            let isend:i32 = 0;
            if(fe == le) { isend = 1; }
            if(fe < le && fbuf[fe] == 9) { isend = 1; }
            if(isend == 1) {
                if(col == 0) { f0s = fs; f0e = fe; }
                if(col == 1) { f1s = fs; f1e = fe; }
                if(col == 4) { f4s = fs; f4e = fe; }
                col = col + 1;
                fs = fe + 1;
            }
            fe = fe + 1;
        }
        if(col >= 5) {
            let epn:i64 = p_epnum(fbuf, f0s, f0e);
            if(epn >= 1 && epn <= 128) {
                let step:i64 = p_i64(fbuf, f1s, f1e);
                let meas:i64 = p_i64(fbuf, f4s, f4e);
                let ei:i32 = (epn - 1) as i32;
                if(step >= 0 && step < 80 && tiers[ei * 80 + (step as i32)] == 1) {
                    put64(sum, ei * 8, get64(sum, ei * 8) + meas);
                    put64(cnt, ei * 8, get64(cnt, ei * 8) + 1);
                }
            }
        }
    }
    // ---- report ----
    let act_ep:i64 = 0;
    let det_ep:i64 = 0;
    let com_ep:i64 = 0;
    let prov_ep:i64 = 0;
    let e:i64 = 0;
    while(e < maxep) {
        let ei:i32 = e as i32;
        let c:i64 = get64(cnt, ei * 8);
        let mean:i64 = 0;
        if(c > 0) { mean = get64(sum, ei * 8) / c; }
        let act:i64 = 0;
        if(c > 0 && mean > 4000) { act = 1; }
        if(act == 1) { act_ep = act_ep + 1; }
        if(det[ei] == 1) { det_ep = det_ep + 1; }
        if(com[ei] == 1) { com_ep = com_ep + 1; }
        if(c > 0) { prov_ep = prov_ep + 1; }
        wout("EP ");
        wouti(e + 1);
        wout(" PROV_N=");
        wouti(c);
        wout(" PROV_MEAN=");
        wouti(mean);
        wout(" ACT=");
        wouti(act);
        wout(" DET=");
        wouti(det[ei] as i64);
        wout(" COM=");
        wouti(com[ei] as i64);
        wout("\n");
        e = e + 1;
    }
    wout("SUMMARY EPS=");
    wouti(maxep);
    wout(" ACT_EP=");
    wouti(act_ep);
    wout(" DET_EP=");
    wouti(det_ep);
    wout(" COM_EP=");
    wouti(com_ep);
    wout(" PROV_EP=");
    wouti(prov_ep);
    wout("\n");
    return;
}

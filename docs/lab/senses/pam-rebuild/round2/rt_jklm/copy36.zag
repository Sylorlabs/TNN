fn fnv32(bs:[]u8, n:i32, dom:u8) u64 {
    let h:u64 = 2166136261;
    h = ((h ^ (dom as u64)) * (16777619 as u64)) % (4294967296 as u64);
    let i:i32 = 0;
    while(i < n) {
        h = ((h ^ (bs[i] as u64)) * (16777619 as u64)) % (4294967296 as u64);
        i = i + 1;
    }
    return h;
}

fn put32i(bs:[]u8, o:i32, v:i64) void {
    bs[o] = (v % 256) as u8;
    bs[o+1] = ((v / 256) % 256) as u8;
    bs[o+2] = ((v / 65536) % 256) as u8;
    bs[o+3] = ((v / 16777216) % 256) as u8;
    return;
}

fn put32u(bs:[]u8, o:i32, v:u64) void {
    let k:u64 = 256;
    bs[o] = (v % k) as u8;
    bs[o+1] = ((v / k) % k) as u8;
    bs[o+2] = ((v / (k * k)) % k) as u8;
    bs[o+3] = ((v / (k * k * k)) % k) as u8;
    return;
}

fn wstep(bs:[]u8, whi:u64, wlo:u64, dom:u8) u64 {
    put32u(bs, 0, whi);
    put32u(bs, 4, wlo);
    put32u(bs, 8, 608135816);
    put32u(bs, 12, 2242054355);
    return fnv32(bs, 16, dom);
}
// honest sensor reading at step t

fn honest_wc(whi:u64, wlo:u64) i64 {
    let m:u64 = 2001;
    let p32:u64 = (4294967296 as u64) % m;
    let r:u64 = (((whi % m) * (p32 % m)) + (wlo % m)) % m;
    return 700 + (r as i64);
}

fn honest_wm(whi:u64, wlo:u64) i64 {
    let wmid:u64 = (whi * 2048) + (wlo / 2097152);
    return ((wmid % 100001) as i64);
}
// commitment over percept bytes

fn cstep(bs:[]u8, id:i64, conf:i64, meas:i64, dom:u8) u64 {
    put32i(bs, 0, id);
    put32i(bs, 4, conf);
    put32i(bs, 8, meas);
    return fnv32(bs, 12, dom);
}
// admit iff commitment binds AND opening is consistent with the world
// behind the sample

fn admit36(bs:[]u8, oid:i64, oconf:i64, omeas:i64, chi:u64, clo:u64, whi:u64, wlo:u64) i32 {
    if(cstep(bs, oid, oconf, omeas, 5) != chi) { return 0; }
    if(cstep(bs, oid, oconf, omeas, 6) != clo) { return 0; }
    let wc:i64 = honest_wc(whi, wlo);
    let wm:i64 = honest_wm(whi, wlo);
    let dc:i64 = oconf - wc;
    if(dc < 0) { dc = 0 - dc; }
    let dm:i64 = omeas - wm;
    if(dm < 0) { dm = 0 - dm; }
    if(dc > 5) { return 0; }
    if(dm > 20) { return 0; }
    return 1;
}

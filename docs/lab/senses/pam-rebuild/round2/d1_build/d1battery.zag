@import("R33_NATIVE_IO_V1.zag")

// d1battery.zag — D1 trust-locus battery (build crew B-D1, 2026-09-24).
// Pure Zag, zero RNG, deterministic. Frozen design: D1B_DESIGN.md (committed
// before runs). Specs extracted BY SCRIPT from commit bfab522a (see frozen/).
// argv[1]: fixtures_ledger.txt (committed F5 set, SHA-verified).
// argv[2]: d1_adv_fixtures.txt (Class A/B/C, generated by gen_d1_adv.py).
//
// Prototypes: P7 perturbation-response gate, P10 act-to-check specialist
// (Class-S fallback), independence-audit component, P8w (measurement only).
// Hybrid: P7 + P10-specialist + audit, per the D1 commit rule.
//
// stdout: D1BAT / P7 / P10 / AUDIT / P8W / HYB / KTABLE lines (no timestamps).
//
// znc landmine notes: no `as []i32` casts (parallel []u8 arenas with explicit
// little-endian put/get32); no slice ==; no .* on non-pointers; no bare blocks;
// no struct returns; shallow nesting only; no identifier named try; i64 only
// non-negative for >> and %.

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let total:i64 = 0;
    let done:i32 = 0;
    while(done == 0) {
        let rem:i64 = (max as i64) - total;
        if(rem <= 0) { done = 1; }
        if(done == 0) {
            let p:i64 = (_zag_slice_ptr(out) as i64) + total;
            let n:i64 = _zag_raw_syscall(0, fd, p, rem, 0, 0, 0);
            if(n <= 0) { done = 1; }
            if(done == 0) { total = total + n; }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn p_atoi(b:[]u8, st:i32, en:i32) i64 {
    let v:i64 = 0;
    let i:i32 = st;
    while(i < en) {
        let c:i32 = b[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}

fn getf(b:[]u8, st:i32, en:i32, k:i32, tmp:[]u8) i32 {
    let f:i32 = 0;
    let fs:i32 = st;
    let fe:i32 = -1;
    let i:i32 = st;
    while(i < en) {
        if((b[i] as i32) == 124) {
            if(f == k) { fe = i; }
            if(fe < 0) { f = f + 1; fs = i + 1; }
        }
        if(fe >= 0) { i = en; }
        if(fe < 0) { i = i + 1; }
    }
    if(fe < 0 && f == k) { fe = en; }
    if(fe < 0) { return -1; }
    let n:i32 = fe - fs;
    let j:i32 = 0;
    while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
    return n;
}

fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}

fn t_put32(a:[]u8, i:i32, v:i64) void {
    a[i*4] = (v & 255) as u8;
    a[i*4+1] = ((v >> 8) & 255) as u8;
    a[i*4+2] = ((v >> 16) & 255) as u8;
    a[i*4+3] = ((v >> 24) & 255) as u8;
}

fn t_get32(a:[]u8, i:i32) i64 {
    let b0:i64 = a[i*4] as i64;
    let b1:i64 = a[i*4+1] as i64;
    let b2:i64 = a[i*4+2] as i64;
    let b3:i64 = a[i*4+3] as i64;
    return b0 + b1*256 + b2*65536 + b3*16777216;
}

fn ilog2(x:i64) i64 {
    let e:i64 = 0;
    let t:i64 = x;
    while(t >= 2) { t = t / 2; e = e + 1; }
    return e;
}

fn ap_str(b:[]u8, p:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { b[p+i] = s[i]; i = i + 1; }
    return p + s.len;
}

fn ap_i64(b:[]u8, p:i32, v:i64) i32 {
    let q:i32 = p;
    let x:i64 = v;
    if(x < 0) { b[q] = 45; q = q + 1; x = 0 - x; }
    if(x == 0) { b[q] = 48; return q + 1; }
    let d:i64 = 1;
    while(d <= x / 10) { d = d * 10; }
    while(d >= 1) {
        let dig:i64 = x / d;
        b[q] = (48 + dig) as u8;
        q = q + 1;
        x = x - dig * d;
        d = d / 10;
    }
    return q;
}

// --- frozen lawful model (PROBE_PREREG) ---
fn lawful_meas_gain(m:i64) i64 { return m * 12 / 10; }
fn lawful_conf_crop(c:i64) i64 { return c - 24; }

// P7 perturbation-response warrant: 1=INSTALL, 0=WITHHOLD.
fn warrant(c:i64, m:i64, om_gain:i64, oc_gain:i64, om_crop:i64, oc_crop:i64, tau:i64) i32 {
    if(iabs(om_gain - lawful_meas_gain(m)) > tau) { return 0; }
    if(iabs(oc_gain - c) > tau) { return 0; }
    if(iabs(om_crop - m) > tau) { return 0; }
    if(iabs(oc_crop - lawful_conf_crop(c)) > tau) { return 0; }
    return 1;
}

fn reproj_c(c:i64, m:i64) i64 { return (c * 3 + m) % 9973; }
fn reproj_m(c:i64, m:i64) i64 { return (m * 5 + c) % 65521; }

// P10 specialist (D1B_DESIGN.md §1).
fn world_w(t:i64, p:i64) i64 { return (t * 11 + p * 17 + 3) & 31; }
fn p_actual_fn(L:i64) i64 { return ((L * 1103515245 + 12345) >> 16) & 31; }
fn p_guess_fn(id:i64) i64 { return ((id * 40503) >> 8) & 31; }

fn main() void {
    let tau:i64 = 2;
    // ---- load honest fixtures (fixtures_ledger.txt) ----
    let led_path:[]u8 = _zag_arg(1);
    let lb:[]u8 = nio_alloc(200000);
    let n:i64 = z_read(led_path, lb, 200000);
    let nn:i32 = n as i32;
    let confH:[]u8 = nio_alloc(360*4);
    let measH:[]u8 = nio_alloc(360*4);
    let sceneH:[]u8 = nio_alloc(360*4);
    let tmp:[]u8 = nio_alloc(256);
    let nf:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= nn) {
        let eol:i32 = 0;
        if(i == nn) { eol = 1; }
        if(eol == 0) {
            if((lb[i] as i32) == 10) { eol = 1; }
        }
        if(eol == 1) {
            if(i > st && nf < 360) {
                let nl:i32 = getf(lb, st, i, 4, tmp);
                let sc:i64 = 2;
                if(nl > 4) {
                    let ch:i32 = tmp[4] as i32;
                    if(ch == 84) { sc = 0; }
                    if(ch == 67) { sc = 1; }
                }
                let cl:i32 = getf(lb, st, i, 8, tmp);
                let cv:i64 = -1;
                if(cl > 0) { cv = p_atoi(tmp, 0, cl); }
                let ml:i32 = getf(lb, st, i, 10, tmp);
                let mv:i64 = -1;
                if(ml > 0) { mv = p_atoi(tmp, 0, ml); }
                if(cl > 0 && ml > 0) {
                    t_put32(confH, nf, cv);
                    t_put32(measH, nf, mv);
                    t_put32(sceneH, nf, sc);
                    nf = nf + 1;
                }
            }
            st = i + 1;
        }
        i = i + 1;
    }
    // ---- load adversarial fixtures (d1_adv_fixtures.txt) ----
    let adv_path:[]u8 = _zag_arg(2);
    let ab:[]u8 = nio_alloc(60000);
    let an:i64 = z_read(adv_path, ab, 60000);
    let ann:i32 = an as i32;
    let idA:[]u8 = nio_alloc(300*4);
    let clsA:[]u8 = nio_alloc(300*4);
    let sceneA:[]u8 = nio_alloc(300*4);
    let confA:[]u8 = nio_alloc(300*4);
    let measA:[]u8 = nio_alloc(300*4);
    let tA:[]u8 = nio_alloc(300*4);
    let na:i32 = 0;
    st = 0;
    i = 0;
    while(i <= ann) {
        let eol:i32 = 0;
        if(i == ann) { eol = 1; }
        if(eol == 0) {
            if((ab[i] as i32) == 10) { eol = 1; }
        }
        if(eol == 1) {
            if(i > st && na < 300) {
                let f0:i32 = getf(ab, st, i, 0, tmp);
                let idv:i64 = -1;
                if(f0 > 0) { idv = p_atoi(tmp, 0, f0); }
                let f1:i32 = getf(ab, st, i, 1, tmp);
                let c1:i32 = 0;
                if(f1 > 0) { c1 = tmp[0] as i32; }
                let f2:i32 = getf(ab, st, i, 2, tmp);
                let c2:i32 = 0;
                if(f2 > 0) { c2 = tmp[0] as i32; }
                let f3:i32 = getf(ab, st, i, 3, tmp);
                let cfv:i64 = -1;
                if(f3 > 0) { cfv = p_atoi(tmp, 0, f3); }
                let f4:i32 = getf(ab, st, i, 4, tmp);
                let mfv:i64 = -1;
                if(f4 > 0) { mfv = p_atoi(tmp, 0, f4); }
                let f5:i32 = getf(ab, st, i, 5, tmp);
                let tv:i64 = -1;
                if(f5 > 0) { tv = p_atoi(tmp, 0, f5); }
                if(f0 > 0 && f3 > 0 && f4 > 0 && f5 > 0) {
                    t_put32(idA, na, idv);
                    let cls:i64 = 0;
                    if(c1 == 66) { cls = 1; }
                    if(c1 == 67) { cls = 2; }
                    t_put32(clsA, na, cls);
                    let sc:i64 = 2;
                    if(c2 == 84) { sc = 0; }
                    if(c2 == 67) { sc = 1; }
                    t_put32(sceneA, na, sc);
                    t_put32(confA, na, cfv);
                    t_put32(measA, na, mfv);
                    t_put32(tA, na, tv);
                    na = na + 1;
                }
            }
            st = i + 1;
        }
        i = i + 1;
    }

    // ---- counters ----
    let p7_h_install:i64 = 0;
    let p7_hc_n:i64 = 0;
    let p7_hc_withhold:i64 = 0;
    let p7_a_install:i64 = 0;
    let p7_b_install:i64 = 0;
    let p7_c_install:i64 = 0;
    let p10_inv:i64 = 0;
    let p10_match:i64 = 0;
    let p10_b_inv:i64 = 0;
    let p10_b_match:i64 = 0;
    let p10_c_inv:i64 = 0;
    let p10_c_match:i64 = 0;
    let aud_n:i64 = 0;
    let aud_agree:i64 = 0;
    let aud_agree_b:i64 = 0;
    let aud_agree_c:i64 = 0;
    let aud_n_b:i64 = 0;
    let aud_n_c:i64 = 0;
    let f8c_1:i64 = 0;
    let f8c_2:i64 = 0;
    let f8c_3:i64 = 0;
    let p8w_h:i64 = 0;
    let p8w_a:i64 = 0;
    let p8w_b:i64 = 0;
    let p8w_c:i64 = 0;
    // hybrid decisions: 0=WITHHOLD 1=INSTALL 2=PROVISIONAL 3=INSTALL_UNCOVERED
    let hy_h_install:i64 = 0;
    let hy_h_prov:i64 = 0;
    let hy_h_withhold:i64 = 0;
    let hy_h_uncovered:i64 = 0;
    let hy_a_install:i64 = 0;
    let hy_a_prov:i64 = 0;
    let hy_a_withhold:i64 = 0;
    let hy_b_install:i64 = 0;
    let hy_b_prov:i64 = 0;
    let hy_b_withhold:i64 = 0;
    let hy_b_uncovered:i64 = 0;
    let hy_c_install:i64 = 0;
    let hy_c_prov:i64 = 0;
    let hy_c_withhold:i64 = 0;
    let hy_c_uncovered:i64 = 0;
    let delayed_n:i64 = 0;
    let total_n:i64 = 0;
    let L:i64 = 305419896;

    // ---- process honest fixtures ----
    let f:i32 = 0;
    while(f < nf) {
        let c:i64 = t_get32(confH, f);
        let m:i64 = t_get32(measH, f);
        let sc:i64 = t_get32(sceneH, f);
        let complex:i64 = 0;
        if(m >= 6000) { complex = 1; }
        let omg:i64 = lawful_meas_gain(m);
        let ocg:i64 = c;
        let omc:i64 = m;
        let occ:i64 = lawful_conf_crop(c);
        if(complex == 1) { omg = omg + 997; p7_hc_n = p7_hc_n + 1; }
        let d7:i32 = warrant(c, m, omg, ocg, omc, occ, tau);
        if(d7 == 1) { p7_h_install = p7_h_install + 1; }
        if(d7 == 0 && complex == 1) { p7_hc_withhold = p7_hc_withhold + 1; }
        // hybrid
        let dec:i64 = 0;
        let p10d:i64 = 0;
        if(d7 == 0) {
            if(complex == 1) { dec = 2; } else { dec = 0; }
        } else {
            if(sc == 0) {
                p10d = 1;
                p10_inv = p10_inv + 1;
                let pa:i64 = p_actual_fn(L);
                let claim:i64 = 0;
                if(m >= 4000) { claim = 1; }
                let o:i64 = world_w(claim, pa);
                let e:i64 = world_w(claim, pa);
                if(o == e) { p10_match = p10_match + 1; dec = 1; } else { dec = 2; }
            } else {
                dec = 3;
            }
        }
        if(dec == 1 || dec == 3) { hy_h_install = hy_h_install + 1; }
        if(dec == 3) { hy_h_uncovered = hy_h_uncovered + 1; }
        if(dec == 2) { hy_h_prov = hy_h_prov + 1; }
        if(dec == 0) { hy_h_withhold = hy_h_withhold + 1; }
        // audit
        let cb:i64 = reproj_c(c, m);
        let mb:i64 = reproj_m(c, m);
        let omgb:i64 = lawful_meas_gain(mb);
        let occb:i64 = lawful_conf_crop(cb);
        if(complex == 1) { omgb = omgb + 997; }
        let dB:i32 = warrant(cb, mb, omgb, cb, mb, occb, tau);
        aud_n = aud_n + 1;
        if(d7 == dB) { aud_agree = aud_agree + 1; }
        let shared:i64 = 0;
        if(reproj_c(c, m) == cb) {
            if(reproj_m(c, m) == mb) { shared = 1; }
        }
        if(shared == 1) { f8c_1 = 1; }
        // p8w (measurement only)
        let p8w:i64 = 0;
        if(d7 == 1 && dB == 1 && shared == 0) { p8w = 1; }
        if(p8w == 1) { p8w_h = p8w_h + 1; }
        // delay + ledger
        total_n = total_n + 1;
        if(p10d == 1) { delayed_n = delayed_n + 1; }
        L = (L * 1664525 + (1 + dec) * 1013904223 + 7) % 2147483648;
        f = f + 1;
    }

    // ---- process adversarial fixtures ----
    let s:i32 = 0;
    while(s < na) {
        let gid:i64 = t_get32(idA, s);
        let cls:i64 = t_get32(clsA, s);
        let sc:i64 = t_get32(sceneA, s);
        let c:i64 = t_get32(confA, s);
        let m:i64 = t_get32(measA, s);
        let omg:i64 = 0;
        let ocg:i64 = 0;
        let omc:i64 = 0;
        let occ:i64 = 0;
        if(cls == 0) {
            omg = m + 997; ocg = c; omc = m; occ = c;
        } else {
            omg = lawful_meas_gain(m); ocg = c; omc = m; occ = lawful_conf_crop(c);
        }
        let d7:i32 = warrant(c, m, omg, ocg, omc, occ, tau);
        if(cls == 0 && d7 == 1) { p7_a_install = p7_a_install + 1; }
        if(cls == 1 && d7 == 1) { p7_b_install = p7_b_install + 1; }
        if(cls == 2 && d7 == 1) { p7_c_install = p7_c_install + 1; }
        // hybrid
        let dec:i64 = 0;
        let p10d:i64 = 0;
        if(d7 == 0) {
            let complex:i64 = 0;
            if(m >= 6000) { complex = 1; }
            if(complex == 1) { dec = 2; } else { dec = 0; }
        } else {
            if(sc == 0) {
                p10d = 1;
                p10_inv = p10_inv + 1;
                let pa:i64 = p_actual_fn(L);
                let pg:i64 = p_guess_fn(gid);
                let claim:i64 = 0;
                if(m >= 4000) { claim = 1; }
                let o:i64 = world_w(claim, pg);
                let e:i64 = world_w(claim, pa);
                if(o == e) {
                    p10_match = p10_match + 1;
                    dec = 1;
                    if(cls == 1) { p10_b_match = p10_b_match + 1; }
                    if(cls == 2) { p10_c_match = p10_c_match + 1; }
                } else {
                    dec = 2;
                }
                if(cls == 1) { p10_b_inv = p10_b_inv + 1; }
                if(cls == 2) { p10_c_inv = p10_c_inv + 1; }
            } else {
                dec = 3;
                if(cls == 1) { hy_b_uncovered = hy_b_uncovered + 1; }
                if(cls == 2) { hy_c_uncovered = hy_c_uncovered + 1; }
            }
        }
        if(cls == 0) {
            if(dec == 1) { hy_a_install = hy_a_install + 1; }
            if(dec == 2) { hy_a_prov = hy_a_prov + 1; }
            if(dec == 0) { hy_a_withhold = hy_a_withhold + 1; }
        }
        if(cls == 1) {
            if(dec == 1) { hy_b_install = hy_b_install + 1; }
            if(dec == 2) { hy_b_prov = hy_b_prov + 1; }
            if(dec == 0) { hy_b_withhold = hy_b_withhold + 1; }
            if(dec == 3) { hy_b_install = hy_b_install + 1; }
        }
        if(cls == 2) {
            if(dec == 1) { hy_c_install = hy_c_install + 1; }
            if(dec == 2) { hy_c_prov = hy_c_prov + 1; }
            if(dec == 0) { hy_c_withhold = hy_c_withhold + 1; }
            if(dec == 3) { hy_c_install = hy_c_install + 1; }
        }
        // audit (path B mirrors path A: A=no-lawful, B/C=faked-lawful)
        let cb:i64 = reproj_c(c, m);
        let mb:i64 = reproj_m(c, m);
        let omgb:i64 = 0;
        let occb:i64 = 0;
        if(cls == 0) {
            omgb = mb + 997; occb = cb;
        } else {
            omgb = lawful_meas_gain(mb); occb = lawful_conf_crop(cb);
        }
        let dB:i32 = warrant(cb, mb, omgb, cb, mb, occb, tau);
        aud_n = aud_n + 1;
        if(d7 == dB) {
            aud_agree = aud_agree + 1;
            if(cls == 1) { aud_agree_b = aud_agree_b + 1; }
            if(cls == 2) { aud_agree_c = aud_agree_c + 1; }
        }
        if(cls == 1) { aud_n_b = aud_n_b + 1; }
        if(cls == 2) { aud_n_c = aud_n_c + 1; }
        let shared:i64 = 0;
        if(reproj_c(c, m) == cb) {
            if(reproj_m(c, m) == mb) { shared = 1; }
        }
        if(cls == 2 && shared == 1 && d7 == dB) { f8c_2 = 1; }
        if(cls == 1 && shared == 1 && d7 == dB) { f8c_3 = 1; }
        // p8w (measurement only)
        let p8w:i64 = 0;
        if(d7 == 1 && dB == 1 && shared == 0) { p8w = 1; }
        if(p8w == 1) {
            if(cls == 0) { p8w_a = p8w_a + 1; }
            if(cls == 1) { p8w_b = p8w_b + 1; }
            if(cls == 2) { p8w_c = p8w_c + 1; }
        }
        // delay + ledger
        total_n = total_n + 1;
        if(p10d == 1) { delayed_n = delayed_n + 1; }
        L = (L * 1664525 + (1 + dec) * 1013904223 + 7) % 2147483648;
        s = s + 1;
    }

    // ---- derived metrics ----
    let p10_b_bits:i64 = ilog2((p10_b_inv + 1) / (p10_b_match + 1));
    let p10_c_bits:i64 = ilog2((p10_c_inv + 1) / (p10_c_match + 1));
    let aud_agree_pct:i64 = aud_agree * 100 / aud_n;
    let premium_bp:i64 = 0;
    let effn:i64 = 1;
    if(aud_agree == aud_n) { effn = 1; }

    // ---- output ----
    let out:[]u8 = nio_alloc(8192);
    let q:i32 = 0;
    q = ap_str(out, q, "D1BAT h_n=");
    q = ap_i64(out, q, nf as i64);
    q = ap_str(out, q, " adv_n=");
    q = ap_i64(out, q, na as i64);
    q = ap_str(out, q, " ledger_final=");
    q = ap_i64(out, q, L);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "P7 h_install=");
    q = ap_i64(out, q, p7_h_install);
    q = ap_str(out, q, " hc_n=");
    q = ap_i64(out, q, p7_hc_n);
    q = ap_str(out, q, " hc_withhold=");
    q = ap_i64(out, q, p7_hc_withhold);
    q = ap_str(out, q, " a_install=");
    q = ap_i64(out, q, p7_a_install);
    q = ap_str(out, q, " b_install=");
    q = ap_i64(out, q, p7_b_install);
    q = ap_str(out, q, " c_install=");
    q = ap_i64(out, q, p7_c_install);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "P10 inv=");
    q = ap_i64(out, q, p10_inv);
    q = ap_str(out, q, " match=");
    q = ap_i64(out, q, p10_match);
    q = ap_str(out, q, " b_inv=");
    q = ap_i64(out, q, p10_b_inv);
    q = ap_str(out, q, " b_match=");
    q = ap_i64(out, q, p10_b_match);
    q = ap_str(out, q, " b_bits=");
    q = ap_i64(out, q, p10_b_bits);
    q = ap_str(out, q, " c_inv=");
    q = ap_i64(out, q, p10_c_inv);
    q = ap_str(out, q, " c_match=");
    q = ap_i64(out, q, p10_c_match);
    q = ap_str(out, q, " c_bits=");
    q = ap_i64(out, q, p10_c_bits);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "AUDIT n=");
    q = ap_i64(out, q, aud_n);
    q = ap_str(out, q, " agree=");
    q = ap_i64(out, q, aud_agree);
    q = ap_str(out, q, " agree_pct=");
    q = ap_i64(out, q, aud_agree_pct);
    q = ap_str(out, q, " b_agree=");
    q = ap_i64(out, q, aud_agree_b);
    q = ap_str(out, q, "/");
    q = ap_i64(out, q, aud_n_b);
    q = ap_str(out, q, " c_agree=");
    q = ap_i64(out, q, aud_agree_c);
    q = ap_str(out, q, "/");
    q = ap_i64(out, q, aud_n_c);
    q = ap_str(out, q, " effn=");
    q = ap_i64(out, q, effn);
    q = ap_str(out, q, " premium_bp=");
    q = ap_i64(out, q, premium_bp);
    q = ap_str(out, q, " f8c=");
    q = ap_i64(out, q, f8c_1);
    q = ap_i64(out, q, f8c_2);
    q = ap_i64(out, q, f8c_3);
    q = ap_str(out, q, " verdict=SHARED_SOURCE\n");
    q = ap_str(out, q, "P8W h=");
    q = ap_i64(out, q, p8w_h);
    q = ap_str(out, q, " a=");
    q = ap_i64(out, q, p8w_a);
    q = ap_str(out, q, " b=");
    q = ap_i64(out, q, p8w_b);
    q = ap_str(out, q, " c=");
    q = ap_i64(out, q, p8w_c);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "HYB h_inst=");
    q = ap_i64(out, q, hy_h_install);
    q = ap_str(out, q, " h_uncov=");
    q = ap_i64(out, q, hy_h_uncovered);
    q = ap_str(out, q, " h_prov=");
    q = ap_i64(out, q, hy_h_prov);
    q = ap_str(out, q, " h_with=");
    q = ap_i64(out, q, hy_h_withhold);
    q = ap_str(out, q, " a_inst=");
    q = ap_i64(out, q, hy_a_install);
    q = ap_str(out, q, " a_prov=");
    q = ap_i64(out, q, hy_a_prov);
    q = ap_str(out, q, " a_with=");
    q = ap_i64(out, q, hy_a_withhold);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "HYB b_inst=");
    q = ap_i64(out, q, hy_b_install);
    q = ap_str(out, q, " b_prov=");
    q = ap_i64(out, q, hy_b_prov);
    q = ap_str(out, q, " b_with=");
    q = ap_i64(out, q, hy_b_withhold);
    q = ap_str(out, q, " b_uncov=");
    q = ap_i64(out, q, hy_b_uncovered);
    q = ap_str(out, q, " c_inst=");
    q = ap_i64(out, q, hy_c_install);
    q = ap_str(out, q, " c_prov=");
    q = ap_i64(out, q, hy_c_prov);
    q = ap_str(out, q, " c_with=");
    q = ap_i64(out, q, hy_c_withhold);
    q = ap_str(out, q, " c_uncov=");
    q = ap_i64(out, q, hy_c_uncovered);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "KTABLE delayed=");
    q = ap_i64(out, q, delayed_n);
    q = ap_str(out, q, " total=");
    q = ap_i64(out, q, total_n);
    q = ap_str(out, q, "\n");
    _zag_raw_syscall(1, 1, _zag_slice_ptr(out) as i64, q as i64, 0, 0, 0);
    return;
}

@import("x2_classes.zag")

// x2_battery.zag — B-3034X2 full battery main (frozen prereg 4b5d673f).
// Runs: STRUCT self-test, X1, X2, X3a, X3b, X4, X5, S0, then the OLD
// J/K/L/M/O/P modes replayed against the new API. Pure Zag, zero RNG.
// Output is a fixed text report; byte-identical across runs is enforced
// by the RUNLOG SHA-256 comparison (prereg section 8).

fn main() void {
    let ob:[]u8 = nio_alloc(262144);
    let pos:i32 = 0;
    let st:[]u8 = x2_state_new();
    pos = ob_puts(ob, pos, "B-3034X2 full battery (frozen prereg 4b5d673f)\n");
    pos = x_struct(ob, pos, st);
    pos = x_x1(ob, pos, st, 0);
    pos = x_x2(ob, pos, st, 0);
    pos = x_x3a(ob, pos, st, 0);
    pos = x_x3b(ob, pos, st);
    pos = x_x4(ob, pos, st, 0);
    pos = x_x5(ob, pos, st);
    pos = x_s0(ob, pos, st);
    pos = m_honest(ob, pos, st);
    pos = m_rf_full(ob, pos, st);
    pos = m_rc_full(ob, pos, st);
    pos = m_xr(ob, pos, st, 0);
    pos = m_xr(ob, pos, st, 1);
    pos = m_n_goal(ob, pos, st);
    pos = m_o_temporal(ob, pos, st);
    pos = m_o_numeric(ob, pos, st);
    pos = m_p_remint(ob, pos, st);
    pos = m_j_dump(ob, pos, st);
    pos = m_j_agg(ob, pos, st);
    pos = m_j_tag(ob, pos, st);
    pos = m_k_blind(ob, pos, st);
    pos = m_l_distal(ob, pos, st);
    pos = m_ge_gap(ob, pos, st);
    pos = ob_puts(ob, pos, "END\n");
    _zag_print(ob[0..pos]);
    nio_free(ob);
    nio_free(st);
    return;
}

}

fn m_xr(ob:[]u8, pos:i32, st:[]u8, reuse:i32) i32 {
    if(reuse == 1) { pos = ob_puts(ob, pos, "mode=xr_reuse\n"); }
    else { pos = ob_puts(ob, pos, "mode=xr_fresh\n"); }
    x2_reset(st);
    let pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 4000 + j;
        let e:i64 = 0;
        while(e < 3) { he(st, id, e, 0, 222); e = e + 1; }
        e = 0;
        while(e < 3) {
            let cb:i64 = 0;
            if(reuse == 1) { cb = dh6(id, wle(id, e, 111), wc(id, 111), wm(id, 111), 0, 111); }
            else { cb = dh6(id, wle(id, e, 222), wc(id, 222), wm(id, 222), 0, 222); }
            x2_verdict(st, id, e, 1, x2_now(st), cb, 0);
            e = e + 1;
        }
        if(x2_up_pr(x2_decide(st, id, 3)) == 1) { pr = pr + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "xr_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    pos = ob_puts(ob, pos, "BAR xr=");
    if(reuse == 1) {
        if(pr < 6) { pos = ob_puts(ob, pos, "PASS"); } else { pos = ob_puts(ob, pos, "FAIL"); }
        pos = ob_puts(ob, pos, " (reuse bar: <6/120)\n");
    } else {
        if(pr >= 115) { pos = ob_puts(ob, pos, "PASS"); } else { pos = ob_puts(ob, pos, "FAIL"); }
        pos = ob_puts(ob, pos, " (fresh bar: >=115/120)\n");
    }
    return pos;
}


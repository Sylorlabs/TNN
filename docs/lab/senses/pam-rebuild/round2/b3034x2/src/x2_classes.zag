@import("x2_common.zag")

// x2_classes.zag — B-3034X2 battery classes (frozen prereg 4b5d673f).
// No main() here: x2_battery.zag and x2_nopmain.zag import this lib.
// Every class fn takes nop:i32: 0 = full x2_decide, 1 = x2_decide_nop
// (the preregistered 34-half ablation). BAR lines print only for nop=0;
// the X6 delta is script-computed from the two binaries' count lines.

// ---------- reference monitor (RT-X section 5 shapes; scoring only) ----------
// Returns 0=admit, else refusal reason: 1=K-distinct 2=temporal 3=digest
// 4=gap 5=epoch-drift.
fn mon_x1(n_obj:i32, bound:i64, digest:i64) i32 {
    if(n_obj < 3) { return 1; }
    if(bound != digest) { return 3; }
    return 0;
}
fn mon_x2(n_obj:i32, tv0:i64, tv1:i64, tv2:i64, td0:i64, td1:i64, td2:i64, dg:i32) i32 {
    if(n_obj < 3) { return 1; }
    if(tv0 >= td0) { return 2; }
    if(tv1 >= td1) { return 2; }
    if(tv2 >= td2) { return 2; }
    if(dg == 0) { return 3; }
    return 0;
}
fn mon_x3a(ep_mask:i32) i32 {
    let mid:i32 = ep_mask / 2;
    if((mid % 2) == 0) { return 4; }
    return 0;
}
fn mon_x4(label:i64, wlab2:i64, n_obj:i32, times_ok:i32, dg:i32) i32 {
    if(n_obj < 3) { return 1; }
    if(times_ok == 0) { return 2; }
    if(dg == 0) { return 3; }
    if(label != wlab2) { return 5; }
    return 0;
}

// ---------- transcript helpers ----------
// enqueue epoch e with epoch-true bytes
fn he(st:[]u8, j:i64, e:i64, extra:i64, seed:i64) i32 {
    return x2_enqueue(st, j, e, wle(j, e, seed), wc(j, seed), wm(j, seed), extra, seed);
}
// verdict object; bound computed by the HELPER over the epoch-true bytes
// (white-box: same published functions the driver uses)
fn hv(st:[]u8, j:i64, e:i64, bit:i64, tv:i64, extra:i64, seed:i64, is_gap:i64) i32 {
    let cb:i64 = 0;
    if(is_gap == 1) { cb = gap_sentinel(j, e); }
    else { cb = dh6(j, wle(j, e, seed), wc(j, seed), wm(j, seed), extra, seed); }
    return x2_verdict(st, j, e, bit, tv, cb, is_gap);
}
// enqueue explicit bytes
fn hex(st:[]u8, j:i64, e:i64, label:i64, conf:i64, meas:i64, extra:i64, seed:i64) i32 {
    return x2_enqueue(st, j, e, label, conf, meas, extra, seed);
}
// verdict object with bound over explicit bytes
fn hvx(st:[]u8, j:i64, e:i64, bit:i64, tv:i64, label:i64, conf:i64, meas:i64, extra:i64, seed:i64) i32 {
    return x2_verdict(st, j, e, bit, tv, dh6(j, label, conf, meas, extra, seed), 0);
}
fn dec(st:[]u8, id:i64, nop:i32) i64 {
    if(nop == 1) { return x2_decide_nop(st, id, 3); }
    return x2_decide(st, id, 3);
}
// full honest 3-epoch transcript (timely bit=1 objects)
fn honest3(st:[]u8, j:i64, extra:i64, seed:i64) void {
    let e:i64 = 0;
    while(e < 3) { he(st, j, e, extra, seed); e = e + 1; }
    e = 0;
    while(e < 3) { hv(st, j, e, 1, x2_now(st), extra, seed, 0); e = e + 1; }
    return;
}

// ---------- STRUCT self-test (mechanism-reality evidence) ----------
fn x_struct(ob:[]u8, pos:i32, st:[]u8) i32 {
    pos = ob_puts(ob, pos, "STRUCT self-test (rc codes; not a kill bar)\n");
    x2_reset(st);
    let i:i64 = 0;
    let rc1:i32 = 0;
    while(i < 41) { rc1 = x2_enqueue(st, 1 + i, 0, 0, 80, 1000, 0, 0); i = i + 1; }
    pos = ob_puts(ob, pos, "t1_cap_overflow_rc=");
    pos = ob_puti(ob, pos, rc1 as i64);
    pos = ob_puts(ob, pos, " (expect 2)\n");
    x2_reset(st);
    x2_enqueue(st, 7, 0, wl(7, 0), wc(7, 0), wm(7, 0), 0, 0);
    let tv2:i64 = x2_now(st);
    let b2:i64 = dh6(7, wl(7, 0), wc(7, 0), wm(7, 0), 0, 0);
    x2_verdict(st, 7, 0, 1, tv2, b2, 0);
    let r2b:i32 = x2_verdict(st, 7, 0, 1, tv2, b2, 0);
    pos = ob_puts(ob, pos, "t2_duplicate_rc=");
    pos = ob_puti(ob, pos, r2b as i64);
    pos = ob_puts(ob, pos, " (expect 4)\n");
    x2_reset(st);
    let r3:i32 = x2_verdict(st, 99, 0, 1, x2_now(st), 12345, 0);
    pos = ob_puts(ob, pos, "t3_norecord_rc=");
    pos = ob_puti(ob, pos, r3 as i64);
    pos = ob_puts(ob, pos, " (expect 5)\n");
    x2_reset(st);
    honest3(st, 7, 0, 0);
    let d4a:i64 = x2_decide(st, 7, 3);
    let d4b:i64 = x2_decide(st, 7, 3);
    pos = ob_puts(ob, pos, "t4_first_promote=");
    pos = ob_puti(ob, pos, x2_up_pr(d4a) as i64);
    pos = ob_puts(ob, pos, " t4_redecide_rc=");
    pos = ob_puti(ob, pos, x2_up_rc(d4b) as i64);
    pos = ob_puts(ob, pos, " t4_repromote=");
    pos = ob_puti(ob, pos, x2_up_pr(d4b) as i64);
    pos = ob_puts(ob, pos, " (expect 1/6/0)\n");
    x2_reset(st);
    let e:i64 = 0;
    while(e < 3) { he(st, 8, e, 0, 0); e = e + 1; }
    let t0:i64 = x2_now(st);
    e = 0;
    while(e < 3) { hv(st, 8, e, 1, t0 + 1000, 0, 0, 0); e = e + 1; }
    let d5:i64 = x2_decide(st, 8, 3);
    pos = ob_puts(ob, pos, "t5_late_rc=");
    pos = ob_puti(ob, pos, x2_up_rc(d5) as i64);
    pos = ob_puts(ob, pos, " t5_promote=");
    pos = ob_puti(ob, pos, x2_up_pr(d5) as i64);
    pos = ob_puts(ob, pos, " (expect 11/0)\n");
    x2_reset(st);
    e = 0;
    while(e < 3) { he(st, 9, e, 0, 0); e = e + 1; }
    e = 0;
    while(e < 3) {
        let cb:i64 = dh6(9, wle(9, e, 0), wc(9, 0), wm(9, 0), 0, 0) + 1;
        x2_verdict(st, 9, e, 1, x2_now(st), cb, 0);
        e = e + 1;
    }
    let d6:i64 = x2_decide(st, 9, 3);
    pos = ob_puts(ob, pos, "t6_bindfail_rc=");
    pos = ob_puti(ob, pos, x2_up_rc(d6) as i64);
    pos = ob_puts(ob, pos, " t6_promote=");
    pos = ob_puti(ob, pos, x2_up_pr(d6) as i64);
    pos = ob_puts(ob, pos, " (expect 12/0)\n");
    return pos;
}

// ---------- class X1: VACUOUS-K x HARNESS-MAXV ----------
fn x_x1(ob:[]u8, pos:i32, st:[]u8, nop:i32) i32 {
    pos = ob_puts(ob, pos, "class=X1 VACUOUS-K x HARNESS-MAXV\n");
    x2_reset(st);
    let pr:i32 = 0;
    let rf:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        he(st, id, 0, 0, seed);
        hv(st, id, 0, 1, x2_now(st), 0, seed, 0);
        let r:i64 = dec(st, id, nop);
        if(x2_up_pr(r) == 1) { pr = pr + 1; }
        if(nop == 0) {
            let bnd:i64 = dh6(id, wle(id, 0, seed), wc(id, seed), wm(id, seed), 0, seed);
            if(mon_x1(1, bnd, bnd) != 0) { rf = rf + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x1_gate_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120");
    if(nop == 0) {
        pos = ob_puts(ob, pos, " x1_mon_refuse=");
        pos = ob_puti(ob, pos, rf as i64);
        pos = ob_puts(ob, pos, "/120\n");
        pos = ob_puts(ob, pos, "BAR x1_vacuous_k=");
        if(pr >= 6) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
        pos = ob_puts(ob, pos, " (kill: promote>=6/120)\n");
    } else {
        pos = ob_puts(ob, pos, " (nop)\n");
    }
    return pos;
}

// ---------- class X2: VACUOUS-TICK x FORGE-FIAT ----------
fn x_x2(ob:[]u8, pos:i32, st:[]u8, nop:i32) i32 {
    pos = ob_puts(ob, pos, "class=X2 VACUOUS-TICK x FORGE-FIAT\n");
    x2_reset(st);
    let pr:i32 = 0;
    let rf:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        let t0:i64 = x2_now(st);
        let e:i64 = 0;
        while(e < 3) { he(st, id, e, 0, seed); e = e + 1; }
        e = 0;
        while(e < 3) { hv(st, id, e, 1, t0 + 10, 0, seed, 0); e = e + 1; }
        let tdec:i64 = x2_now(st);
        let r:i64 = dec(st, id, nop);
        if(x2_up_pr(r) == 1) { pr = pr + 1; }
        if(nop == 0) {
            if(mon_x2(3, t0 + 10, t0 + 10, t0 + 10, tdec, tdec, tdec, 1) != 0) { rf = rf + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x2_gate_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120");
    if(nop == 0) {
        pos = ob_puts(ob, pos, " x2_mon_refuse=");
        pos = ob_puti(ob, pos, rf as i64);
        pos = ob_puts(ob, pos, "/120\n");
        pos = ob_puts(ob, pos, "BAR x2_vacuous_tick=");
        if(pr >= 6) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
        pos = ob_puts(ob, pos, " (kill: promote>=6/120)\n");
    } else {
        pos = ob_puts(ob, pos, " (nop)\n");
    }
    return pos;
}

// ---------- class X3a: GAP-ABSENT x BYTE-IDENTICAL ----------
fn x_x3a(ob:[]u8, pos:i32, st:[]u8, nop:i32) i32 {
    pos = ob_puts(ob, pos, "class=X3a GAP-ABSENT x BYTE-IDENTICAL\n");
    x2_reset(st);
    let pr:i32 = 0;
    let pr_gap:i32 = 0;
    let pr_dense:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        let gapped:i32 = 0;
        if((j % 2) == 0) { gapped = 1; }
        he(st, id, 0, 0, seed);
        hv(st, id, 0, 1, x2_now(st), 0, seed, 0);
        if(gapped == 1) {
            x2_gap(st, id, 1);
            hv(st, id, 1, 1, x2_now(st), 0, seed, 1);
        } else {
            he(st, id, 1, 0, seed);
            hv(st, id, 1, 1, x2_now(st), 0, seed, 0);
        }
        he(st, id, 2, 0, seed);
        hv(st, id, 2, 1, x2_now(st), 0, seed, 0);
        let r:i64 = dec(st, id, nop);
        if(x2_up_pr(r) == 1) {
            pr = pr + 1;
            if(gapped == 1) { pr_gap = pr_gap + 1; }
            else { pr_dense = pr_dense + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x3a_deliver=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 x3a_gapped=");
    pos = ob_puti(ob, pos, pr_gap as i64);
    pos = ob_puts(ob, pos, "/60 x3a_dense=");
    pos = ob_puti(ob, pos, pr_dense as i64);
    pos = ob_puts(ob, pos, "/60");
    if(nop == 0) {
        pos = ob_puts(ob, pos, "\n");
        pos = ob_puts(ob, pos, "BAR x3a_gap_absent=");
        if(pr < 115) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
        pos = ob_puts(ob, pos, " (kill: deliver<115/120)\n");
    } else {
        pos = ob_puts(ob, pos, " (nop)\n");
    }
    return pos;
}

// ---------- class X3b: gap-swap (EXPRESSIBLE on the new API) ----------
fn x_x3b(ob:[]u8, pos:i32, st:[]u8) i32 {
    pos = ob_puts(ob, pos, "class=X3b gap-swap\n");
    x2_reset(st);
    let pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        he(st, id, 0, 0, seed);
        hv(st, id, 0, 1, x2_now(st), 0, seed, 0);
        x2_gap(st, id, 1);
        hv(st, id, 1, 1, x2_now(st), 0, seed, 1);
        let fl:i64 = wl(id, seed);
        hex(st, id, 2, fl, wc(id, seed), wm(id, seed), 0, seed);
        hvx(st, id, 2, 1, x2_now(st), fl, wc(id, seed), wm(id, seed), 0, seed);
        let r:i64 = x2_decide(st, id, 3);
        if(x2_up_pr(r) == 1) { pr = pr + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x3b_expressible=1 x3b_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    pos = ob_puts(ob, pos, "BAR x3b_gap_swap=");
    if(pr >= 6) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
    pos = ob_puts(ob, pos, " (kill: inexpressible OR promote>=6/120)\n");
    return pos;
}

// ---------- class X4: VACUOUS-BIND x EPOCH-DRIFT ----------
fn x_x4(ob:[]u8, pos:i32, st:[]u8, nop:i32) i32 {
    pos = ob_puts(ob, pos, "class=X4 VACUOUS-BIND x EPOCH-DRIFT\n");
    x2_reset(st);
    let pr:i32 = 0;
    let harm:i32 = 0;
    let rf:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        let lab:i64 = wl(id, seed);
        let cf:i64 = wc(id, seed);
        let ms:i64 = wm(id, seed);
        let e:i64 = 0;
        while(e < 3) { hex(st, id, e, lab, cf, ms, 0, seed); e = e + 1; }
        e = 0;
        while(e < 3) { hvx(st, id, e, 1, x2_now(st), lab, cf, ms, 0, seed); e = e + 1; }
        let r:i64 = dec(st, id, nop);
        if(x2_up_pr(r) == 1) {
            pr = pr + 1;
            if(lab != 1 - lab) { harm = harm + 1; }
        }
        if(nop == 0) {
            if(mon_x4(lab, 1 - lab, 3, 1, 1) != 0) { rf = rf + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x4_gate_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 x4_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120");
    if(nop == 0) {
        pos = ob_puts(ob, pos, " x4_mon_refuse=");
        pos = ob_puti(ob, pos, rf as i64);
        pos = ob_puts(ob, pos, "/120\n");
        pos = ob_puts(ob, pos, "BAR x4_epoch_drift=");
        if(harm >= 6) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
        pos = ob_puts(ob, pos, " (kill: harm>=6/120)\n");
    } else {
        pos = ob_puts(ob, pos, " (nop)\n");
    }
    return pos;
}

// ---------- class X5: sink reachability + safety ----------
fn x_x5(ob:[]u8, pos:i32, st:[]u8) i32 {
    pos = ob_puts(ob, pos, "class=X5 sink REACHABLE on true extra-consistent goals\n");
    x2_reset(st);
    let pr_a:i32 = 0;
    let fi_a:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        honest3(st, id, 777, seed);
        let r:i64 = x2_decide(st, id, 3);
        if(x2_up_pr(r) == 1) { pr_a = pr_a + 1; }
        if(x2_up_fi(r) == 1) { fi_a = fi_a + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x5a_true_extra_promote=");
    pos = ob_puti(ob, pos, pr_a as i64);
    pos = ob_puts(ob, pos, "/120 x5a_sink_fired=");
    pos = ob_puti(ob, pos, fi_a as i64);
    pos = ob_puts(ob, pos, "/120\n");
    x2_reset(st);
    let fi_b:i32 = 0;
    j = 0;
    while(j < 120) {
        let id:i64 = 200 + j;
        let seed:i64 = 1000 + j;
        let e:i64 = 0;
        while(e < 3) {
            let fl:i64 = 1 - wle(id, e, seed);
            hex(st, id, e, fl, wc(id, seed), wm(id, seed), 777, seed);
            e = e + 1;
        }
        e = 0;
        while(e < 3) {
            let fl:i64 = 1 - wle(id, e, seed);
            hvx(st, id, e, 0, x2_now(st), fl, wc(id, seed), wm(id, seed), 777, seed);
            e = e + 1;
        }
        let r:i64 = x2_decide(st, id, 3);
        if(x2_up_fi(r) == 1) { fi_b = fi_b + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x5b_falseG_honestPrincipal_fires=");
    pos = ob_puti(ob, pos, fi_b as i64);
    pos = ob_puts(ob, pos, "/120\n");
    x2_reset(st);
    let fi_c:i32 = 0;
    j = 0;
    while(j < 120) {
        let id:i64 = 400 + j;
        let seed:i64 = 1000 + j;
        let e:i64 = 0;
        while(e < 3) {
            let fl:i64 = 1 - wle(id, e, seed);
            hex(st, id, e, fl, wc(id, seed), wm(id, seed), 777, seed);
            e = e + 1;
        }
        e = 0;
        while(e < 3) {
            let fl:i64 = 1 - wle(id, e, seed);
            hvx(st, id, e, 1, x2_now(st), fl, wc(id, seed), wm(id, seed), 777, seed);
            e = e + 1;
        }
        let r:i64 = x2_decide(st, id, 3);
        if(x2_up_fi(r) == 1) { fi_c = fi_c + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x5c_falseG_lyingPrincipal_fires=");
    pos = ob_puti(ob, pos, fi_c as i64);
    pos = ob_puts(ob, pos, "/120\n");
    x2_reset(st);
    let fi_d:i32 = 0;
    j = 0;
    while(j < 120) {
        let id:i64 = 600 + j;
        let seed:i64 = 1000 + j;
        he(st, id, 0, 0, seed);
        hv(st, id, 0, 1, x2_now(st), 0, seed, 0);
        let r:i64 = x2_decide(st, id, 3);
        if(x2_up_fi(r) == 1) { fi_d = fi_d + 1; }
        j = j + 1;
    }
    j = 0;
    while(j < 120) {
        let id:i64 = 700 + j;
        honest3(st, id, 0, 0);
        let r:i64 = x2_decide(st, id, 3);
        if(x2_up_fi(r) == 1) { fi_d = fi_d + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "x5d_extra0_constancy_fires=");
    pos = ob_puti(ob, pos, fi_d as i64);
    pos = ob_puts(ob, pos, "/240\n");
    pos = ob_puts(ob, pos, "BAR x5_sink=");
    let kill:i32 = 0;
    if(fi_a < 115) { kill = 1; }
    if(fi_b > 0) { kill = 1; }
    if(fi_c > 0) { kill = 1; }
    if(fi_d > 0) { kill = 1; }
    if(kill == 1) { pos = ob_puts(ob, pos, "KILL"); } else { pos = ob_puts(ob, pos, "NO-KILL"); }
    pos = ob_puts(ob, pos, " (kill: a<115/120 unreachable, or any fire on b/c/d)\n");
    return pos;
}

// ---------- class S0: sanity ----------
fn x_s0(ob:[]u8, pos:i32, st:[]u8) i32 {
    pos = ob_puts(ob, pos, "class=S0 sanity fresh-bound FALSE snapshot\n");
    x2_reset(st);
    let pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = j;
        let seed:i64 = 1000 + j;
        let e:i64 = 0;
        while(e < 3) {
            let fl:i64 = 1 - wle(id, e, seed);
            hex(st, id, e, fl, wc(id, seed), wm(id, seed), 0, seed);
            e = e + 1;
        }
        e = 0;
        while(e < 3) {
            let fl:i64 = 1 - wle(id, e, seed);
            hvx(st, id, e, 0, x2_now(st), fl, wc(id, seed), wm(id, seed), 0, seed);
            e = e + 1;
        }
        let r:i64 = x2_decide(st, id, 3);
        if(x2_up_pr(r) == 1) { pr = pr + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "s0_promote=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    pos = ob_puts(ob, pos, "BAR s0_oracle_sane=");
    if(pr >= 6) { pos = ob_puts(ob, pos, "VOID"); } else { pos = ob_puts(ob, pos, "HOLDS"); }
    pos = ob_puts(ob, pos, " (void if >=6/120: voids X4's premise)\n");
    return pos;
}

// ---------- OLD modes ----------
fn m_honest(ob:[]u8, pos:i32, st:[]u8) i32 {
    pos = ob_puts(ob, pos, "mode=honest\n");
    x2_reset(st);
    let pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 1000 + j;
        honest3(st, id, 0, 0);
        if(x2_up_pr(x2_decide(st, id, 3)) == 1) { pr = pr + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "honest_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    x2_reset(st);
    let wh:i32 = 0;
    j = 0;
    while(j < 40) {
        let id:i64 = 5000 + j;
        let e:i64 = 0;
        while(e < 3) {
            let fl:i64 = 1 - wle(id, e, 0);
            hex(st, id, e, fl, wc(id, 0), wm(id, 0), 0, 0);
            e = e + 1;
        }
        e = 0;
        while(e < 3) {
            let fl:i64 = 1 - wle(id, e, 0);
            hvx(st, id, e, 0, x2_now(st), fl, wc(id, 0), wm(id, 0), 0, 0);
            e = e + 1;
        }
        if(x2_up_pr(x2_decide(st, id, 3)) == 1) { }
        else { wh = wh + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "contradicted_withheld=");
    pos = ob_puti(ob, pos, wh as i64);
    pos = ob_puts(ob, pos, "/40\n");
    pos = ob_puts(ob, pos, "BAR honest_loss=");
    if(pr >= 115) { if(wh == 40) { pos = ob_puts(ob, pos, "PASS"); } else { pos = ob_puts(ob, pos, "FAIL"); } }
    else { pos = ob_puts(ob, pos, "FAIL"); }
    pos = ob_puts(ob, pos, " (bar: >=115/120, 40/40)\n");
    return pos;
}


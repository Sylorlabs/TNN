fn m_ge_gap(ob:[]u8, pos:i32, st:[]u8) i32 {
    pos = ob_puts(ob, pos, "mode=ge_gap\n");
    x2_reset(st);
    let pr_a:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 15000 + j;
        he(st, id, 0, 0, 0);
        hv(st, id, 0, 1, x2_now(st), 0, 0, 0);
        x2_gap(st, id, 1);
        hv(st, id, 1, 1, x2_now(st), 0, 0, 1);
        he(st, id, 2, 0, 0);
        hv(st, id, 2, 1, x2_now(st), 0, 0, 0);
        if(x2_up_pr(x2_decide(st, id, 3)) == 1) { pr_a = pr_a + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "gapped_honest_promoted=");
    pos = ob_puti(ob, pos, pr_a as i64);
    pos = ob_puts(ob, pos, "/120\n");
    x2_reset(st);
    let pr_b:i32 = 0;
    j = 0;
    while(j < 120) {
        let id:i64 = 15100 + j;
        let e:i64 = 0;
        while(e < 3) { he(st, id, e, 0, 0); e = e + 1; }
        e = 0;
        while(e < 2) { hv(st, id, e, 1, x2_now(st), 0, 0, 0); e = e + 1; }
        if(x2_up_pr(x2_decide(st, id, 3)) == 1) { pr_b = pr_b + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "two_verdict_promoted=");
    pos = ob_puti(ob, pos, pr_b as i64);
    pos = ob_puts(ob, pos, "/120\n");
    pos = ob_puts(ob, pos, "BAR b_ge_delivers_refuses=");
    if(pr_a >= 115) { if(pr_b == 0) { pos = ob_puts(ob, pos, "PASS"); } else { pos = ob_puts(ob, pos, "FAIL"); } }
    else { pos = ob_puts(ob, pos, "FAIL"); }
    pos = ob_puts(ob, pos, " (bar: gapped>=115/120, 2-verdict 0/120)\n");
    return pos;
}

        x2_verdict(st, id, 0, 1, tv0, b0, 0);
        e = 1;
        while(e < 3) { hv(st, id, e, 1, x2_now(st), 0, 0, 0); e = e + 1; }
        if(x2_up_pr(x2_decide(st, id, 3)) == 1) { pr = pr + 1; }

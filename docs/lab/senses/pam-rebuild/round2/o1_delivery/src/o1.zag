// o1.zag — O1 knowledge-delivery repair + frozen gate replay (PAMs Round 2).
//
// Reads a deterministic case stream (one line per trial):
//   seq|tcode|prog|progF|agree|strong|conf|mrgF|jcode|pred|measure|correct|truth
// where prog/progF: 0=PASS 1=FAIL 2=UNRESOLVED; tcode: 0..5;
// correct: 1 iff judgment==truth (scoring only, never in a gate rule);
// truth is PASSED THROUGH for scoring and is NEVER used in any gate rule.
//
// Delivery Adjudicator (the O1 repair, mode=1):
//   admit iff prog==PASS, OR (progF==PASS AND agree==1 AND conf>=700).
//   Admitted-but-not-PASS records are repaired to prog=PASS(0), pred=1
//   before the frozen gate logic sees them. The gate's install rules are
//   UNCHANGED (ported verbatim from memgate.zag).
//
// CLI: o1 <case_file> <mode> <metrics_out>
//   mode: 0 = fidelity (repair disabled), 1 = repair enabled.
// Metrics out (key=value lines, deterministic):
//   k1_num, k1_den, k2_num, k2_den, rk3_num, rk3_den,
//   rk1_falseperm, rk2_num, rk2_den, repaired (records repaired by adjudicator),
//   trials
// Pure Zag, integer math only, zero RNG, fully deterministic.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn z_write_open(path:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 384, 0, 0, 0);
    nio_free(s);
    return fd;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn field(line:[]u8, llen:i32, which:i32, out:[]u8) i32 {
    let fi:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= llen) {
        let c:u8 = 10;
        if(i < llen) { c = line[i]; }
        if(c == 124 || i == llen) {
            if(fi == which) {
                let n:i32 = i - st;
                if(n > out.len) { n = out.len; }
                let k:i32 = 0;
                while(k < n) { out[k] = line[st + k]; k = k + 1; }
                return n;
            }
            fi = fi + 1;
            st = i + 1;
        }
        i = i + 1;
    }
    return -1;
}
fn atoi(b:[]u8, n:i32) i64 {
    let v:i64 = 0;
    let neg:i64 = 1;
    let i:i32 = 0;
    if(n > 0 && b[0] == 45) { neg = -1; i = 1; }
    while(i < n) {
        let c:i64 = b[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * neg;
}
fn tol_of(tc:i32) i64 {
    if(tc == 0) { return 8; }
    if(tc == 1) { return 40; }
    if(tc == 2) { return 60; }
    if(tc == 3) { return 4000; }
    if(tc == 4) { return 120; }
    return 0;
}
// i64 -> decimal slice (no trailing newline; see AGENTS.md helper rule)
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    if(a1.len == 0 || a2.len == 0 || a3.len == 0) { return 1; }
    let repair:i64 = atoi(a2, a2.len);
    let fmax:i32 = 8388608;
    let fb:[]u8 = nio_alloc(fmax);
    if(fb.len == 0) { return 1; }
    let n:i64 = z_read(a1, fb, fmax);
    if(n < 0) { return 1; }
    let nl:i64 = n;
    // per-task state arenas ([]u8, LE accessors; never `as []i64` casts)
    let prov_on:[]u8 = nio_alloc(48);
    let prov_j:[]u8 = nio_alloc(48);
    let prov_m:[]u8 = nio_alloc(48);
    let prov_s:[]u8 = nio_alloc(48);
    let perm_on:[]u8 = nio_alloc(48);
    let perm_j:[]u8 = nio_alloc(48);
    let perm_m:[]u8 = nio_alloc(48);
    let perm_s:[]u8 = nio_alloc(48);
    let neg_j:[]u8 = nio_alloc(6 * 256 * 8);
    let neg_m:[]u8 = nio_alloc(6 * 256 * 8);
    let neg_n:[]u8 = nio_alloc(48);
    let t:i32 = 0;
    while(t < 6) {
        t_put64(prov_on, t * 8, 0);
        t_put64(perm_on, t * 8, 0);
        t_put64(neg_n, t * 8, 0);
        t = t + 1;
    }
    // metric accumulators
    let k1_num:i64 = 0;
    let k1_den:i64 = 0;
    let k2_num:i64 = 0;
    let k2_den:i64 = 0;
    let rk3_num:i64 = 0;
    let rk3_den:i64 = 0;
    let rk1_fp:i64 = 0;
    let rk2_num:i64 = 0;
    let rk2_den:i64 = 0;
    let repaired:i64 = 0;
    let trials:i64 = 0;
    let fnum:[]u8 = nio_alloc(64);
    let p:i64 = 0;
    while(p < nl) {
        let le:i64 = p;
        while(le < nl && fb[le as i32] != 10) { le = le + 1; }
        let llen:i32 = (le - p) as i32;
        if(llen > 0 && llen < 4000) {
            let line:[]u8 = fb[p as i32 .. (p + llen as i64) as i32];
            let nf:i32 = field(line, llen, 0, fnum);
            let seq:i64 = atoi(fnum, nf);
            nf = field(line, llen, 1, fnum);
            let tc:i32 = atoi(fnum, nf) as i32;
            nf = field(line, llen, 2, fnum);
            let pr:i64 = atoi(fnum, nf);
            nf = field(line, llen, 3, fnum);
            let pf:i64 = atoi(fnum, nf);
            nf = field(line, llen, 4, fnum);
            let ag:i64 = atoi(fnum, nf);
            nf = field(line, llen, 5, fnum);
            let st:i64 = atoi(fnum, nf);
            nf = field(line, llen, 6, fnum);
            let conf:i64 = atoi(fnum, nf);
            nf = field(line, llen, 7, fnum);
            // field 7 is mrgF (parsed positionally; surfaced in the
            // evidence declaration but not gating admission)
            nf = field(line, llen, 8, fnum);
            let jc:i64 = atoi(fnum, nf);
            nf = field(line, llen, 9, fnum);
            let pred:i64 = atoi(fnum, nf);
            nf = field(line, llen, 10, fnum);
            let meas:i64 = atoi(fnum, nf);
            nf = field(line, llen, 11, fnum);
            let correct:i64 = atoi(fnum, nf);
            // ---- Delivery Adjudicator (O1 repair) ----
            if(repair == 1) {
                if(pr != 0 && pf == 0 && ag == 1 && conf >= 700) {
                    pr = 0;
                    pred = 1;
                    repaired = repaired + 1;
                }
            }
            // ---- scoring: K1/K2 denominators (RK-3 denominator) ----
            let hiconf_correct:i64 = 0;
            if(correct == 1 && conf >= 700) { hiconf_correct = 1; }
            if(hiconf_correct == 1) {
                k1_den = k1_den + 1;
                k2_den = k2_den + 1;
                rk3_den = rk3_den + 1;
                if(pf == 0) { k1_num = k1_num + 1; }
                if(pr == 0) { k2_num = k2_num + 1; }
            }
            if(correct == 0 && conf >= 700) { rk2_den = rk2_den + 1; }
            // ---- frozen gate logic (ported from memgate.zag) ----
            // disp codes: 0=PROVISIONAL_INSTALL 1=PERMANENT_INSTALL
            // 2=CORROBORATED 3=CONFLICT_WITHHELD 4=SUPPRESSED 5=WITHHELD
            // 6=NEGATIVE_EVIDENCE 7=bad-record
            let disp:i32 = 7;
            if(tc >= 0 && tc < 6 && (pr == 0 || pr == 1 || pr == 2)) {
                let tol:i64 = tol_of(tc);
                let nm:i32 = 0;
                let nn:i64 = t_get64(neg_n, tc * 8);
                let k:i64 = 0;
                while(k < nn) {
                    if(t_get64(neg_j, (tc * 256 + k as i32) * 8) == jc
                       && iabs(t_get64(neg_m, (tc * 256 + k as i32) * 8) - meas) <= tol) {
                        nm = 1;
                        break;
                    }
                    k = k + 1;
                }
                if(pr == 1) {
                    if(nm == 0 && nn < 256) {
                        t_put64(neg_j, (tc * 256 + nn as i32) * 8, jc);
                        t_put64(neg_m, (tc * 256 + nn as i32) * 8, meas);
                        t_put64(neg_n, tc * 8, nn + 1);
                    }
                    disp = 6;
                } else if(pr == 2) {
                    if(nm == 1) { disp = 4; } else { disp = 5; }
                } else {
                    if(pred == 0) {
                        disp = 5;
                    } else if(nm == 1) {
                        disp = 4;
                    } else if(t_get64(perm_on, tc * 8) == 1) {
                        let pj:i64 = t_get64(perm_j, tc * 8);
                        let pm:i64 = t_get64(perm_m, tc * 8);
                        if(jc == pj && iabs(pm - meas) <= tol) {
                            disp = 2;
                        } else if(jc != pj) {
                            disp = 3;
                        } else {
                            disp = 2;
                        }
                    } else if(t_get64(prov_on, tc * 8) == 1) {
                        let pj:i64 = t_get64(prov_j, tc * 8);
                        let pm:i64 = t_get64(prov_m, tc * 8);
                        if(jc == pj && iabs(pm - meas) <= tol) {
                            t_put64(perm_on, tc * 8, 1);
                            t_put64(perm_j, tc * 8, jc);
                            t_put64(perm_m, tc * 8, meas);
                            t_put64(perm_s, tc * 8, seq);
                            t_put64(prov_on, tc * 8, 0);
                            disp = 1;
                        } else if(jc != pj) {
                            t_put64(prov_j, tc * 8, jc);
                            t_put64(prov_m, tc * 8, meas);
                            t_put64(prov_s, tc * 8, seq);
                            disp = 0;
                        } else {
                            disp = 2;
                        }
                    } else {
                        t_put64(prov_on, tc * 8, 1);
                        t_put64(prov_j, tc * 8, jc);
                        t_put64(prov_m, tc * 8, meas);
                        t_put64(prov_s, tc * 8, seq);
                        disp = 0;
                    }
                }
            }
            // ---- scoring: installs ----
            if(hiconf_correct == 1) {
                if(disp == 0 || disp == 1 || disp == 2) { rk3_num = rk3_num + 1; }
            }
            if(disp == 1 && correct == 0) { rk1_fp = rk1_fp + 1; }
            if(correct == 0 && conf >= 700 && disp == 1) { rk2_num = rk2_num + 1; }
            trials = trials + 1;
        }
        p = le + 1;
    }
    // ---- write metrics ----
    let ob:[]u8 = nio_alloc(2048);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "mode", i64s(repair));
    pos = ob_kv(ob, pos, "trials", i64s(trials));
    pos = ob_kv(ob, pos, "k1_num", i64s(k1_num));
    pos = ob_kv(ob, pos, "k1_den", i64s(k1_den));
    pos = ob_kv(ob, pos, "k2_num", i64s(k2_num));
    pos = ob_kv(ob, pos, "k2_den", i64s(k2_den));
    pos = ob_kv(ob, pos, "rk3_num", i64s(rk3_num));
    pos = ob_kv(ob, pos, "rk3_den", i64s(rk3_den));
    pos = ob_kv(ob, pos, "rk1_falseperm", i64s(rk1_fp));
    pos = ob_kv(ob, pos, "rk2_num", i64s(rk2_num));
    pos = ob_kv(ob, pos, "rk2_den", i64s(rk2_den));
    pos = ob_kv(ob, pos, "repaired", i64s(repaired));
    let fd:i64 = z_write_open(a3);
    if(fd < 0) { return 1; }
    if(nio_write_all(fd, ob[0..pos]) != pos as i64) { return 1; }
    nio_close(fd);
    nio_free(ob);
    nio_free(fb);
    return 0;
}

// guard_main.zag — CC1 margin-guard battery (PAMs Round 2).
//
// Tests five candidate margin-guard rules head-to-head against the G1/G2
// baselines on the expanded CC1-variant fixture set.
//
// Frozen spec: PREREG_CC1_GUARD.md (commit a673da8aa9481194992a38963eb7b99074fe1f5e).
// G0/G1/G2 control flow is verbatim from the frozen cm_main.zag; gate state is
// extended with install-time perm mrgF and challenger (mrgF, seq, spans) so the
// guards can read them. Disposition behavior of unguarded G1/G2 is unchanged.
// Guards are vetoes ONLY at the G1 corroborated-revision point: veto ->
// CHALLENGER_PROV with the challenger slot retained (prereg section 2).
//
// Gate input contract: (prog, jcode, conf, pred, meas, mrgF, jG, confG,
// seq, span_a, span_b). truth is structurally unreadable (never referenced).
// Guards never read jG/confG (judgment-channel ban).
//
// Pure Zag, integer math only, ZERO RNG. All trial values are literals from
// the generated guard_records.zag (frozen prereg single source: gen_guard.py).
//
// Output: one GUARD line per trial:
//   GUARD|<cell>|<cfg>|<trial_idx>|<disp>|<perm_j or -1>|<perm_seq or -1>
// Configs: 0=G1 1=G2 2=MG1 3=MG2 4=MG3 5=MG4 6=MG6.
@import("R33_NATIVE_IO_V1.zag")
@import("guard_records.zag")

// ---------------- disposition codes (frozen) ----------------
const D_PERM:i32=0;
const D_PROV:i32=1;
const D_CORR:i32=2;
const D_CONF:i32=3;
const D_CHAL:i32=4;
const D_REV:i32=5;
const D_ACC:i32=6;
const D_WITH:i32=7;

// ---------------- state arena word offsets ----------------
const S_PROV_ON:i32=0;
const S_PROV_J:i32=1;
const S_PROV_M:i32=2;
const S_PERM_ON:i32=3;
const S_PERM_J:i32=4;
const S_PERM_M:i32=5;
const S_PERM_CONF:i32=6;
const S_PERM_SEQ:i32=7;
const S_CHAL_ON:i32=8;
const S_CHAL_J:i32=9;
const S_CHAL_M:i32=10;
const S_DCHAL_ON:i32=11;
const S_DCHAL_J:i32=12;
const S_DCHAL_M:i32=13;
// guard extensions (prereg section 2; pure-Zag gate-state addition)
const S_PERM_MRG:i32=14;
const S_CHAL_MRG:i32=15;
const S_CHAL_SEQ:i32=16;
const S_CHAL_SA:i32=17;
const S_CHAL_SB:i32=18;
const S_NWORDS:i32=19;

// ---------------- frozen guard constants (prereg section 2) ----------------
const MG1_FLOOR:i64=400;
const MG2_FACTOR:i64=2;
const MG4_GAP:i64=20;

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at]=(v & 255) as u8;
    b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;
    b[at+3]=((v>>24) & 255) as u8;
    b[at+4]=((v>>32) & 255) as u8;
    b[at+5]=((v>>40) & 255) as u8;
    b[at+6]=((v>>48) & 255) as u8;
    b[at+7]=((v>>56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24)|((b[at+4] as i64)<<32)|((b[at+5] as i64)<<40)|((b[at+6] as i64)<<48)|((b[at+7] as i64)<<56);
}
fn iabs(x:i64) i64 {
    if(x<0){return 0-x;}
    return x;
}
fn st_get(st:[]u8, w:i32) i64 { return t_get64(st, w*8); }
fn st_put(st:[]u8, w:i32, v:i64) void { t_put64(st, w*8, v); }
// trial field f of trial i (fields: 0=tcode 1=prog 2=jcode 3=conf 4=pred
// 5=meas 6=mrgF 7=truth 8=jG 9=confG 10=seq 11=span_a 12=span_b)
fn tf(tr:[]u8, i:i32, f:i32) i64 { return t_get64(tr, i*GUARD_ROW+f*8); }

// ---------------- print helpers ----------------
fn i64s(v:i64) []u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn cfg_name(c:i32) []u8 {
    if(c==0){return "G1";}
    if(c==1){return "G2";}
    if(c==2){return "MG1";}
    if(c==3){return "MG2";}
    if(c==4){return "MG3";}
    if(c==5){return "MG4";}
    if(c==6){return "MG6";}
    return "?";
}

// ---------------- tolerances (memgate.zag tol_of, verbatim) ----------------
fn tol_of(tc:i64) i64 {
    if(tc==0){return 8;}
    if(tc==1){return 40;}
    if(tc==2){return 60;}
    if(tc==3){return 4000;}
    if(tc==4){return 120;}
    return 0;
}

fn perm_install(st:[]u8, jc:i64, meas:i64, cf:i64, mrg:i64, ti:i32) void {
    st_put(st,S_PERM_ON,1); st_put(st,S_PERM_J,jc); st_put(st,S_PERM_M,meas);
    st_put(st,S_PERM_CONF,cf); st_put(st,S_PERM_SEQ,ti as i64);
    st_put(st,S_PERM_MRG,mrg);
    st_put(st,S_PROV_ON,0);
}

// ---------------- guard predicate (prereg section 2, exact) ----------------
// gid: 2=MG1 3=MG2 4=MG3 5=MG4 6=MG6. Returns 1=allow revision, 0=veto.
// m1/m2: challenger mrgF (stored, incoming). pm: incumbent perm mrgF.
// (sa1,sb1),(sa2,sb2): challenger evidence spans. q1/q2: challenger seqs.
// NOTE: MG2 vs a non-permanent incumbent is vacuous (perm mrgF reads 0 from
// zeroed state, so the factor test always passes); no fixture exercises it.
fn mg_allow(gid:i32, m1:i64, m2:i64, pm:i64, sa1:i64, sb1:i64, sa2:i64, sb2:i64, q1:i64, q2:i64) i32 {
    let a1:i32=1;
    let a2:i32=1;
    let a3:i32=1;
    let a4:i32=1;
    if(gid==2 || gid==6){
        if(m1<MG1_FLOOR || m2<MG1_FLOOR){a1=0;}
    }
    if(gid==3){
        if(m1<MG2_FACTOR*pm || m2<MG2_FACTOR*pm){a2=0;}
    }
    if(gid==4 || gid==6){
        if(sa1<sb2 && sa2<sb1){a3=0;}
    }
    if(gid==5 || gid==6){
        if(iabs(q1-q2)<MG4_GAP){a4=0;}
    }
    if(gid==2){return a1;}
    if(gid==3){return a2;}
    if(gid==4){return a3;}
    if(gid==5){return a4;}
    if(a1==1 && a3==1 && a4==1){return 1;}
    return 0;
}

// ---------------- G0: frozen R2-4/H2 gate (negative control) ----------------
// memgate.zag §§1.1/2 verbatim, single-task (from frozen cm_main.zag).
fn g0_step(st:[]u8, tr:[]u8, ti:i32) i32 {
    let prog:i64=tf(tr,ti,1);
    if(prog!=0){return D_WITH;}
    let pred:i64=tf(tr,ti,4);
    if(pred!=1){return D_WITH;}
    let jc:i64=tf(tr,ti,2); let cf:i64=tf(tr,ti,3); let meas:i64=tf(tr,ti,5);
    let tol:i64=tol_of(tf(tr,ti,0));
    if(st_get(st,S_PERM_ON)==1){
        if(jc==st_get(st,S_PERM_J)){return D_CORR;}
        return D_CONF;
    }
    if(st_get(st,S_PROV_ON)==1){
        if(jc==st_get(st,S_PROV_J) && iabs(meas-st_get(st,S_PROV_M))<=tol){
            perm_install(st,jc,meas,cf,tf(tr,ti,6),ti);
            return D_PERM;
        }
        st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
        return D_PROV;
    }
    st_put(st,S_PROV_ON,1); st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
    return D_PROV;
}

// ---------------- G1: cf1 historical-corroboration + guard veto ----------------
// Control flow verbatim from frozen cm_main.zag (AUTOPSY_R2-4 §4); state stores
// extended with mrgF/seq/spans. gid=0: unguarded baseline. gid in 2..6: the
// guard is consulted at the corroborated-revision point; a veto returns
// D_CHAL with the challenger slot retained (prereg section 2).
fn g1_step(st:[]u8, tr:[]u8, ti:i32, no_hist:i32, gid:i32) i32 {
    let prog:i64=tf(tr,ti,1);
    if(prog!=0){return D_WITH;}
    let pred:i64=tf(tr,ti,4);
    if(pred!=1){return D_WITH;}
    let jc:i64=tf(tr,ti,2); let cf:i64=tf(tr,ti,3); let meas:i64=tf(tr,ti,5);
    let mrg:i64=tf(tr,ti,6);
    let seq:i64=tf(tr,ti,10); let sa:i64=tf(tr,ti,11); let sb:i64=tf(tr,ti,12);
    let tol:i64=tol_of(tf(tr,ti,0));
    let perm_on:i64=st_get(st,S_PERM_ON);
    let prov_on:i64=st_get(st,S_PROV_ON);
    // same-judgment path
    if(perm_on==1 && jc==st_get(st,S_PERM_J) && iabs(meas-st_get(st,S_PERM_M))<=tol){return D_CORR;}
    if(prov_on==1 && perm_on==0 && jc==st_get(st,S_PROV_J) && iabs(meas-st_get(st,S_PROV_M))<=tol){
        if(cf>=700){
            perm_install(st,jc,meas,cf,mrg,ti);
            return D_PERM;
        }
        return D_PROV;
    }
    // incumbent identity for the conflict path
    let inc:i32=0;
    if(perm_on==1){inc=1;}
    if(prov_on==1 && perm_on==0){inc=1;}
    if(inc==1){
        let ij:i64=st_get(st,S_PERM_J);
        if(perm_on==0){ij=st_get(st,S_PROV_J);}
        if(jc!=ij){
            // CONFLICT: §4.1 challenger path
            if(cf>=700 && no_hist==0){
                if(st_get(st,S_CHAL_ON)==1 && st_get(st,S_CHAL_J)==jc && iabs(meas-st_get(st,S_CHAL_M))<=tol){
                    if(gid!=0){
                        let ok:i32=mg_allow(gid,
                            st_get(st,S_CHAL_MRG), mrg, st_get(st,S_PERM_MRG),
                            st_get(st,S_CHAL_SA), st_get(st,S_CHAL_SB), sa, sb,
                            st_get(st,S_CHAL_SEQ), seq);
                        if(ok==0){return D_CHAL;}
                    }
                    perm_install(st,jc,meas,cf,mrg,ti);
                    st_put(st,S_CHAL_ON,0);
                    return D_REV;
                }
                st_put(st,S_CHAL_ON,1); st_put(st,S_CHAL_J,jc); st_put(st,S_CHAL_M,meas);
                st_put(st,S_CHAL_MRG,mrg); st_put(st,S_CHAL_SEQ,seq);
                st_put(st,S_CHAL_SA,sa); st_put(st,S_CHAL_SB,sb);
                return D_CHAL;
            }
            return D_CONF;
        }
        // same jcode outside tol: re-anchor provisional (specified, unexercised in matrix)
        st_put(st,S_PROV_ON,1); st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
        return D_PROV;
    }
    // no incumbent
    st_put(st,S_PROV_ON,1); st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
    return D_PROV;
}

// ---------------- G2: V2-D-hardened (verbatim from frozen cm_main.zag) ----------------
fn g2_step(st:[]u8, tr:[]u8, ti:i32, no_hist:i32) i32 {
    let prog:i64=tf(tr,ti,1);
    let pred:i64=tf(tr,ti,4);
    let jc:i64=tf(tr,ti,2); let cf:i64=tf(tr,ti,3); let meas:i64=tf(tr,ti,5);
    let jg:i64=tf(tr,ti,8); let cg:i64=tf(tr,ti,9);
    let tol:i64=tol_of(tf(tr,ti,0));
    let dfires:i32=0;
    if(prog==0 && pred==1 && jg==jc && cf>=700 && cg>=700){dfires=1;}
    if(dfires==1){
        let perm_on:i64=st_get(st,S_PERM_ON);
        let prov_on:i64=st_get(st,S_PROV_ON);
        if(perm_on==1 && jc==st_get(st,S_PERM_J)){return D_CORR;}
        if(perm_on==1){
            // CONFLICT vs permanent: adjudication (hardening)
            if(no_hist==0 && st_get(st,S_DCHAL_ON)==1 && st_get(st,S_DCHAL_J)==jc && iabs(meas-st_get(st,S_DCHAL_M))<=tol){
                perm_install(st,jc,meas,cf,tf(tr,ti,6),ti);
                st_put(st,S_DCHAL_ON,0);
                return D_REV;
            }
            if(no_hist==0){
                st_put(st,S_DCHAL_ON,1); st_put(st,S_DCHAL_J,jc); st_put(st,S_DCHAL_M,meas);
                return D_CHAL;
            }
            return D_CONF;
        }
        if(prov_on==1 && jc==st_get(st,S_PROV_J) && iabs(meas-st_get(st,S_PROV_M))<=tol){
            perm_install(st,jc,meas,cf,tf(tr,ti,6),ti);
            return D_PERM;
        }
        if(prov_on==1){
            // CONFLICT vs provisional: same adjudication
            if(no_hist==0 && st_get(st,S_DCHAL_ON)==1 && st_get(st,S_DCHAL_J)==jc && iabs(meas-st_get(st,S_DCHAL_M))<=tol){
                perm_install(st,jc,meas,cf,tf(tr,ti,6),ti);
                st_put(st,S_DCHAL_ON,0);
                return D_REV;
            }
            if(no_hist==0){
                st_put(st,S_DCHAL_ON,1); st_put(st,S_DCHAL_J,jc); st_put(st,S_DCHAL_M,meas);
                return D_CHAL;
            }
            return D_CONF;
        }
        // no incumbent: truth-acceptance path
        perm_install(st,jc,meas,cf,tf(tr,ti,6),ti);
        return D_ACC;
    }
    return g0_step(st,tr,ti);
}

// ---------------- driver ----------------
fn main() void {
    let tr:[]u8=nio_alloc(GUARD_NTRIALS*GUARD_ROW);
    guard_init_trials(tr);
    let ci:i32=0;
    while(ci<GUARD_NCELLS){
        let co:[]u8=nio_alloc(72);
        guard_cell(ci,co);
        let start:i64=t_get64(co,0);
        let count:i64=t_get64(co,8);
        let pre_on:i64=t_get64(co,16);
        let no_hist:i32=t_get64(co,56) as i32;
        let cfg:i32=0;
        while(cfg<7){
            let st:[]u8=nio_alloc(S_NWORDS*8);
            let w:i32=0;
            while(w<S_NWORDS){t_put64(st,w*8,0);w=w+1;}
            if(pre_on==1){
                st_put(st,S_PERM_ON,1);
                st_put(st,S_PERM_J,t_get64(co,24));
                st_put(st,S_PERM_M,t_get64(co,32));
                st_put(st,S_PERM_CONF,t_get64(co,40));
                st_put(st,S_PERM_SEQ,t_get64(co,48));
                st_put(st,S_PERM_MRG,0);
            }
            let k:i64=0;
            while(k<count){
                let ti:i32=(start+k) as i32;
                let d:i32=0;
                if(cfg==0){d=g1_step(st,tr,ti,no_hist,0);}
                if(cfg==1){d=g2_step(st,tr,ti,no_hist);}
                if(cfg>=2){d=g1_step(st,tr,ti,no_hist,cfg);}
                let pj:i64=-1; let ps:i64=-1;
                if(st_get(st,S_PERM_ON)==1){pj=st_get(st,S_PERM_J);ps=st_get(st,S_PERM_SEQ);}
                _zag_print("GUARD|");
                _zag_print(guard_cell_name(ci));
                _zag_print("|");_zag_print(cfg_name(cfg));
                _zag_print("|");_zag_print(i64s(k));
                _zag_print("|");_zag_print(i64s(d as i64));
                _zag_print("|");_zag_print(i64s(pj));
                _zag_print("|");_zag_print(i64s(ps));
                _zag_print("\n");
                k=k+1;
            }
            nio_free(st);
            cfg=cfg+1;
        }
        nio_free(co);
        ci=ci+1;
    }
    nio_free(tr);
}

        let b_d:i32 = 0;
        if(ha == 60) { b_d = 1; }
        pos = ob_puts(ob, pos, "BAR_36_a_frozen=");
        pos = ob_puts(ob, pos, yn(b_a));
        pos = ob_puts(ob, pos, " (bar: 0/60 false admits)\n");
        pos = ob_puts(ob, pos, "BAR_36_b_reactive=");
        pos = ob_puts(ob, pos, yn(b_b));
        pos = ob_puts(ob, pos, " (bar: 0/60 false admits, 0 recoveries)\n");
        pos = ob_puts(ob, pos, "BAR_36_c_independence=");
        pos = ob_puts(ob, pos, yn(b_c));
        pos = ob_puts(ob, pos, " (bar: WG1 120/120 identical, WG2 0/200000)\n");
        pos = ob_puts(ob, pos, "BAR_36_d_honest=");
        pos = ob_puts(ob, pos, yn(b_d));
        pos = ob_puts(ob, pos, " (bar: 60/60 honest admitted)\n");
        pos = ob_puts(ob, pos, "R36_BATT_DONE\n");
    } else {
        let installs:i64 = m36_class_installs(bs, shi, slo);
        pos = ob_puts(ob, pos, "m36_install=");
        pos = ob_puti(ob, pos, installs);
        pos = ob_puts(ob, pos, " m36_trials={M36A_TRIALS}\n");
        let whi:u64 = shi;
        let wlo:u64 = slo;
        let mha:i64 = 0;
        let t:i64 = 0;
        while(t < 60) {
            let id:i64 = 4000 + t;
            let conf:i64 = honest_wc(whi, wlo);
            let meas:i64 = honest_wm(whi, wlo);
            let chi:u64 = cstep(bs, id, conf, meas, 5);
            let clo:u64 = cstep(bs, id, conf, meas, 6);
            mha = mha + (admit36(bs, id, conf, meas, chi, clo, whi, wlo) as i64);
            let nhi:u64 = wstep(bs, whi, wlo, 1);
            let nlo:u64 = wstep(bs, whi, wlo, 2);
            whi = nhi;
            wlo = nlo;
            t = t + 1;
        }
        pos = ob_puts(ob, pos, "m36_honest_admitted=");
        pos = ob_puti(ob, pos, mha);
        pos = ob_puts(ob, pos, " m36_honest_presented=60\n");
        let k1:i32 = 0;
        if(installs <= 15) { k1 = 1; }
        let k8:i32 = 0;
        if(mha >= 51) { k8 = 1; }
        pos = ob_puts(ob, pos, "BAR_M36_install=");
        pos = ob_puts(ob, pos, yn(k1));
        pos = ob_puts(ob, pos, " (bar: <=15/120)\n");
        pos = ob_puts(ob, pos, "BAR_M36_honest=");
        pos = ob_puts(ob, pos, yn(k8));
        pos = ob_puts(ob, pos, " (bar: >=51/60, honest-loss <=15%)\n");
        pos = ob_puts(ob, pos, "R36_M36_DONE\n");
    }
    nio_free(bs);
    nio_free(digest);
    _zag_print(ob[0..pos]);
    nio_free(ob);
    return;
}

// D2 novelty-handling arms — pure Zag, zero RNG.
// Implements Arm A (H-PAM-9), Arm B (H-PAM-11), Arm C (composition)
// per frozen prereg PREREG_D2_NOVELTY_HANDLING.md §3.
//
// Usage: arm_zag <input.tsv> <output.tsv> <arm: a|b|c>
// Output: per-step tier decisions (ep, step, tier).
//
// Based on d2_probe.zag I/O patterns. Uses []u8 arenas + put/get64 only.

@import("R33_NATIVE_IO_V1.zag")

const B: i64 = 56;
const D_MAX: i64 = 149;
const D_PROMOTE: i64 = 74;
const W: i64 = 58;
const K: i64 = 3;
const N_ARMB: i64 = 20;
const TOMB_R: i64 = 15;

// Tier codes
const T_PROV: i32 = 1;
const T_SUSP: i32 = 2;
const T_REV: i32 = 3;
const T_COM: i32 = 4;
const T_REF: i32 = 5;

// Cls codes (from TSV cls field)
const C_HON: i32 = 0;
const C_INJ: i32 = 1;
const C_NOV: i32 = 2;
const C_DRF: i32 = 3;
const C_RPL: i32 = 4;
const C_SPK: i32 = 5;

fn z_cstr(s: []u8) []u8 {
    if (s.len < 1 || s.len > 4095) { return ""; }
    let b: []u8 = nio_alloc(s.len + 1);
    if (b.len == 0) { return b; }
    let i: i32 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn z_read(path: []u8, out: []u8, max: i32) i64 {
    let s: []u8 = z_cstr(path);
    if (s.len == 0) { return -7401; }
    let fd: i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if (fd < 0) { return -7402; }
    let total: i64 = 0;
    let done: i32 = 0;
    while (done == 0) {
        let rem: i64 = (max as i64) - total;
        if (rem <= 0) { done = 1; }
        if (done == 0) {
            let p: i64 = (_zag_slice_ptr(out) as i64) + total;
            let n: i64 = _zag_raw_syscall(0, fd, p, rem, 0, 0, 0);
            if (n <= 0) { done = 1; }
            if (done == 0) { total = total + n; }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn z_write(path: []u8, data: []u8, n: i32) i64 {
    let s: []u8 = z_cstr(path);
    if (s.len == 0) { return -1; }
    // 577 = O_WRONLY|O_CREAT|O_TRUNC, 420 = 0644
    let fd: i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 420, 0, 0, 0);
    nio_free(s);
    if (fd < 0) { return -1; }
    let p: i64 = _zag_slice_ptr(data) as i64;
    let w: i64 = _zag_raw_syscall(1, fd, p, n as i64, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return w;
}

fn p_atoi(b: []u8, st: i32, en: i32) i64 {
    let v: i64 = 0;
    let i: i32 = st;
    while (i < en) {
        let c: i32 = b[i] as i32;
        if (c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}

fn getf(b: []u8, st: i32, en: i32, k: i32, tmp: []u8) i32 {
    let f: i32 = 0;
    let fs: i32 = st;
    let fe: i32 = -1;
    let i: i32 = st;
    while (i < en) {
        if ((b[i] as i32) == 9) {
            if (f == k) { fe = i; }
            if (fe < 0) { f = f + 1; fs = i + 1; }
        }
        if (fe >= 0) { i = en; }
        if (fe < 0) { i = i + 1; }
    }
    if (fe < 0 && f == k) { fe = en; }
    if (fe < 0) { return -1; }
    let n: i32 = fe - fs;
    let j: i32 = 0;
    while (j < n) { tmp[j] = b[fs + j]; j = j + 1; }
    return n;
}

fn iabs(x: i64) i64 {
    if (x < 0) { return 0 - x; }
    return x;
}

fn imax(a: i64, b: i64) i64 {
    if (a >= b) { return a; }
    return b;
}

fn a_put64(a: []u8, o: i32, v: i64) void {
    let i: i32 = 0;
    let x: i64 = v;
    while (i < 8) {
        a[o + i] = (x & 255) as u8;
        x = x >> 8;
        i = i + 1;
    }
    return;
}

fn a_get64(a: []u8, o: i32) i64 {
    let v: i64 = 0;
    let i: i32 = 7;
    while (i >= 0) {
        v = (v << 8) | ((a[o + i] as i64) & 255);
        i = i - 1;
    }
    return v;
}

fn ob_add(ob: []u8, pos: i32, s: []u8) i32 {
    let i: i32 = 0;
    while (i < s.len) { ob[pos + i] = s[i]; i = i + 1; }
    return pos + s.len;
}

fn ob_addn(ob: []u8, pos: i32, s: []u8, n: i32) i32 {
    let i: i32 = 0;
    while (i < n) { ob[pos + i] = s[i]; i = i + 1; }
    return pos + n;
}

fn ob_i64(ob: []u8, pos: i32, v: i64) i32 {
    if (v == 0) { ob[pos] = 48; return pos + 1; }
    let neg: i32 = 0;
    let x: i64 = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    let d: []u8 = nio_alloc(24);
    let n: i32 = 0;
    while (x > 0) {
        let dig: i64 = x % 10;
        d[n] = (dig + 48) as u8;
        x = x / 10;
        n = n + 1;
    }
    if (neg == 1) { ob[pos] = 45; pos = pos + 1; }
    let i: i32 = n - 1;
    while (i >= 0) { ob[pos] = d[i]; pos = pos + 1; i = i - 1; }
    nio_free(d);
    return pos;
}

fn cls_code(s: []u8, n: i32) i32 {
    // HON=0, INJ=1, NOV=2, DRF=3, RPL=4, SPK=5
    if (n == 3) {
        if (s[0] == 72) { return 0; } // H
        if (s[0] == 73) { return 1; } // I
        if (s[0] == 78) { return 2; } // N
        if (s[0] == 68) { return 3; } // D
        if (s[0] == 82) { return 4; } // R
        if (s[0] == 83) { return 5; } // S
    }
    return -1;
}

fn main() i32 {
    let in_path: []u8 = _zag_arg(1);
    let out_path: []u8 = _zag_arg(2);
    let arm_sel: []u8 = _zag_arg(3);
    let arm: i32 = 0; // 0=A, 1=B, 2=C
    if (arm_sel.len > 0) {
        if (arm_sel[0] == 98) { arm = 1; } // 'b'
        if (arm_sel[0] == 99) { arm = 2; } // 'c'
    }

    // ---- read TSV ----
    let tb: []u8 = nio_alloc(16777216); // 16MB
    let tblen: i64 = z_read(in_path, tb, 16777216);
    if (tblen <= 0) { return; }

    // ---- parse into per-episode arrays ----
    let NEP: i32 = 200;
    let NST: i32 = 200;
    let conf: []u8 = nio_alloc(NEP * NST * 8);
    let meas: []u8 = nio_alloc(NEP * NST * 8);
    let clsv: []u8 = nio_alloc(NEP * NST * 8);
    let nst: []u8 = nio_alloc(NEP * 8);
    let ename: []u8 = nio_alloc(NEP * 32);
    let elen: []u8 = nio_alloc(NEP * 8);
    let nep: i32 = 0;
    let tmp: []u8 = nio_alloc(256);

    let ls: i32 = 0;
    let tbl: i32 = tblen as i32;
    while (ls < tbl) {
        let le: i32 = ls;
        while (le < tbl && (tb[le] as i32) != 10) { le = le + 1; }
        if (le > ls) {
            let f0: i32 = getf(tb, ls, le, 0, tmp);
            if (f0 > 0 && !(tmp[0] == 101 && tmp[1] == 112)) { // not "ep" header
                // find or create episode
                let ei: i32 = -1;
                let q: i32 = 0;
                while (q < nep) {
                    let el: i32 = a_get64(elen, q * 8) as i32;
                    if (el == f0) {
                        let same: i32 = 1;
                        let r: i32 = 0;
                        while (r < f0) {
                            if ((ename[q * 32 + r] as i32) != (tmp[r] as i32)) { same = 0; }
                            r = r + 1;
                        }
                        if (same == 1) { ei = q; }
                    }
                    q = q + 1;
                }
                if (ei < 0 && nep < NEP) {
                    ei = nep;
                    let r: i32 = 0;
                    while (r < f0) { ename[ei * 32 + r] = tmp[r]; r = r + 1; }
                    a_put64(elen, ei * 8, f0 as i64);
                    a_put64(nst, ei * 8, 0);
                    nep = nep + 1;
                }
                if (ei >= 0) {
                    let st: i32 = a_get64(nst, ei * 8) as i32;
                    let f2: i32 = getf(tb, ls, le, 2, tmp);
                    let cc: i32 = cls_code(tmp, f2);
                    let f3: i32 = getf(tb, ls, le, 3, tmp);
                    let cf: i64 = p_atoi(tmp, 0, f3);
                    let f4: i32 = getf(tb, ls, le, 4, tmp);
                    let mf: i64 = p_atoi(tmp, 0, f4);
                    if (st < NST) {
                        let o: i32 = (ei * NST + st) * 8;
                        a_put64(conf, o, cf);
                        a_put64(meas, o, mf);
                        a_put64(clsv, o, cc as i64);
                        a_put64(nst, ei * 8, (st + 1) as i64);
                    }
                }
            }
        }
        ls = le + 1;
    }

    // ---- run arm per episode, output tiers ----
    let ob: []u8 = nio_alloc(16777216);
    let pos: i32 = 0;
    pos = ob_add(ob, pos, "ep\tstep\ttier\n");

    let e: i32 = 0;
    while (e < nep) {
        let n: i32 = a_get64(nst, e * 8) as i32;
        // per-episode state
        let tier: []u8 = nio_alloc(NST * 8);
        let k: i32 = 0;
        while (k < n) { a_put64(tier, k * 8, 0); k = k + 1; }

        if (arm == 0) {
            // ---- Arm A ----
            let tomb_c: []u8 = nio_alloc(NST * 8);
            let tomb_m: []u8 = nio_alloc(NST * 8);
            let ntomb: i32 = 0;
            let h0c: i64 = 0; let h0m: i64 = 0;
            let h1c: i64 = 0; let h1m: i64 = 0;
            let nhist: i32 = 0;
            k = 0;
            while (k < n) {
                let o: i32 = (e * NST + k) * 8;
                let c: i64 = a_get64(conf, o);
                let m: i64 = a_get64(meas, o);
                // tombstone check
                let refused: i32 = 0;
                let q: i32 = 0;
                while (q < ntomb) {
                    let tc: i64 = a_get64(tomb_c, q * 8);
                    let tm: i64 = a_get64(tomb_m, q * 8);
                    if (imax(iabs(c - tc), iabs(m - tm)) <= TOMB_R) { refused = 1; }
                    q = q + 1;
                }
                if (refused == 1) {
                    a_put64(tier, k * 8, T_REF as i64);
                } else {
                    let er: i64 = 0;
                    if (nhist == 1) {
                        er = imax(iabs(c - h0c), iabs(m - h0m));
                    }
                    if (nhist >= 2) {
                        let pc: i64 = 2 * h1c - h0c;
                        let pm: i64 = 2 * h1m - h0m;
                        er = imax(iabs(c - pc), iabs(m - pm));
                    }
                    // update hist: nhist=0 -> h0=p; nhist=1 -> h1=p; nhist=2 -> shift
                    if (nhist == 0) {
                        h0c = c; h0m = m;
                        h1c = c; h1m = m;
                        nhist = 1;
                    } else {
                        if (nhist == 1) {
                            h1c = c; h1m = m;
                            nhist = 2;
                        } else {
                            h0c = h1c; h0m = h1m;
                            h1c = c; h1m = m;
                        }
                    }
                    if (er > B) {
                        a_put64(tier, k * 8, T_REV as i64);
                        a_put64(tomb_c, ntomb * 8, c);
                        a_put64(tomb_m, ntomb * 8, m);
                        ntomb = ntomb + 1;
                    } else {
                        a_put64(tier, k * 8, T_COM as i64);
                    }
                }
                k = k + 1;
            }
            nio_free(tomb_c); nio_free(tomb_m);
        }

        if (arm == 1) {
            // ---- Arm B ----
            let tomb_c: []u8 = nio_alloc(NST * 8);
            let tomb_m: []u8 = nio_alloc(NST * 8);
            let ntomb: i32 = 0;
            k = 0;
            while (k < n) {
                let o: i32 = (e * NST + k) * 8;
                let c: i64 = a_get64(conf, o);
                let m: i64 = a_get64(meas, o);
                let cc: i32 = a_get64(clsv, o) as i32;
                let refused: i32 = 0;
                let q: i32 = 0;
                while (q < ntomb) {
                    let tc: i64 = a_get64(tomb_c, q * 8);
                    let tm: i64 = a_get64(tomb_m, q * 8);
                    if (imax(iabs(c - tc), iabs(m - tm)) <= TOMB_R) { refused = 1; }
                    q = q + 1;
                }
                if (refused == 1) {
                    a_put64(tier, k * 8, T_REF as i64);
                } else {
                    a_put64(tier, k * 8, T_PROV as i64);
                    // warrant for s=k-1
                    if (k - 1 >= 0) {
                        let s: i32 = k - 1;
                        if ((a_get64(tier, s * 8) as i32) == T_PROV) {
                            let so: i32 = (e * NST + s) * 8;
                            let scc: i32 = a_get64(clsv, so) as i32;
                            // FAIL iff INJ/RPL/SPK (1,4,5)
                            if (scc == 1 || scc == 4 || scc == 5) {
                                a_put64(tier, s * 8, T_REV as i64);
                                a_put64(tomb_c, ntomb * 8, a_get64(conf, so));
                                a_put64(tomb_m, ntomb * 8, a_get64(meas, so));
                                ntomb = ntomb + 1;
                            }
                        }
                    }
                    // promotion for s=k-N
                    if (k - N_ARMB >= 0) {
                        let s2: i32 = k - N_ARMB as i32;
                        if ((a_get64(tier, s2 * 8) as i32) == T_PROV) {
                            a_put64(tier, s2 * 8, T_COM as i64);
                        }
                    }
                }
                k = k + 1;
            }
            // flush last warrant
            if (n - 1 >= 0 && (a_get64(tier, (n - 1) * 8) as i32) == T_PROV) {
                let so: i32 = (e * NST + (n - 1)) * 8;
                let scc: i32 = a_get64(clsv, so) as i32;
                if (scc == 1 || scc == 4 || scc == 5) {
                    a_put64(tier, (n - 1) * 8, T_REV as i64);
                }
            }
            nio_free(tomb_c); nio_free(tomb_m);
        }

        if (arm == 2) {
            // ---- Arm C ---- (composition)
            let tomb_c: []u8 = nio_alloc(NST * 8);
            let tomb_m: []u8 = nio_alloc(NST * 8);
            let ntomb: i32 = 0;
            let h0c: i64 = 0; let h0m: i64 = 0;
            let h1c: i64 = 0; let h1m: i64 = 0;
            let nhist: i32 = 0;
            let anchor_c: i64 = 0; let anchor_m: i64 = 0;
            let a_step: i32 = 0;
            let anchored: i32 = 0;
            let last_disc: i64 = -1000000;
            let clean_run: i32 = 0;
            let oldest_uncom: i32 = 0;
            k = 0;
            while (k < n) {
                let o: i32 = (e * NST + k) * 8;
                let c: i64 = a_get64(conf, o);
                let m: i64 = a_get64(meas, o);
                let refused: i32 = 0;
                let q: i32 = 0;
                while (q < ntomb) {
                    let tc: i64 = a_get64(tomb_c, q * 8);
                    let tm: i64 = a_get64(tomb_m, q * 8);
                    if (imax(iabs(c - tc), iabs(m - tm)) <= TOMB_R) { refused = 1; }
                    q = q + 1;
                }
                if (refused == 1) {
                    a_put64(tier, k * 8, T_REF as i64);
                } else {
                    let er: i64 = 0;
                    if (nhist == 1) {
                        er = imax(iabs(c - h0c), iabs(m - h0m));
                    }
                    if (nhist >= 2) {
                        let pc: i64 = 2 * h1c - h0c;
                        let pm: i64 = 2 * h1m - h0m;
                        er = imax(iabs(c - pc), iabs(m - pm));
                    }
                    a_put64(tier, k * 8, T_PROV as i64);
                    if (er > B) {
                        a_put64(tier, k * 8, T_SUSP as i64);
                        // persistence
                        if ((k as i64) - last_disc <= K) {
                            let s: i32 = last_disc as i32;
                            if (s < 0) { s = 0; }
                            while (s < k) {
                                let ts: i32 = a_get64(tier, s * 8) as i32;
                                if (ts == T_PROV || ts == T_SUSP) {
                                    a_put64(tier, s * 8, T_REV as i64);
                                    let so: i32 = (e * NST + s) * 8;
                                    a_put64(tomb_c, ntomb * 8, a_get64(conf, so));
                                    a_put64(tomb_m, ntomb * 8, a_get64(meas, so));
                                    ntomb = ntomb + 1;
                                }
                                s = s + 1;
                            }
                        }
                        anchor_c = c; anchor_m = m;
                        a_step = k;
                        anchored = 1;
                        h0c = c; h0m = m;
                        h1c = c; h1m = m;
                        nhist = 1;
                        last_disc = k as i64;
                        clean_run = 0;
                    } else {
                        clean_run = clean_run + 1;
                        // update hist
                        if (nhist == 0) {
                            h0c = c; h0m = m;
                            h1c = c; h1m = m;
                            nhist = 1;
                        } else {
                            if (nhist == 1) {
                                h1c = c; h1m = m;
                                nhist = 2;
                            } else {
                                h0c = h1c; h0m = h1m;
                                h1c = c; h1m = m;
                            }
                        }
                        if (anchored == 0) {
                            anchored = 1;
                            anchor_c = c; anchor_m = m;
                            a_step = k;
                        }
                        let ct: i64 = imax(iabs(c - anchor_c), iabs(m - anchor_m));
                        if (ct > D_MAX) {
                            // cumulative revoke, NO re-anchor
                            let s: i32 = a_step;
                            while (s <= k) {
                                let ts: i32 = a_get64(tier, s * 8) as i32;
                                if (ts == T_PROV || ts == T_SUSP) {
                                    a_put64(tier, s * 8, T_REV as i64);
                                    let so: i32 = (e * NST + s) * 8;
                                    a_put64(tomb_c, ntomb * 8, a_get64(conf, so));
                                    a_put64(tomb_m, ntomb * 8, a_get64(meas, so));
                                    ntomb = ntomb + 1;
                                }
                                s = s + 1;
                            }
                        } else {
                            if (ct < D_PROMOTE && clean_run >= W) {
                                let promoted: i32 = 0;
                                let s: i32 = oldest_uncom;
                                while (s <= k - W as i32) {
                                    let ts: i32 = a_get64(tier, s * 8) as i32;
                                    if (ts == T_PROV || ts == T_SUSP) {
                                        a_put64(tier, s * 8, T_COM as i64);
                                        promoted = promoted + 1;
                                    }
                                    s = s + 1;
                                }
                                if (promoted > 0) {
                                    anchor_c = c; anchor_m = m;
                                    a_step = k;
                                }
                                while (oldest_uncom <= k) {
                                    let ts: i32 = a_get64(tier, oldest_uncom * 8) as i32;
                                    if (ts == T_PROV || ts == T_SUSP) { break; }
                                    oldest_uncom = oldest_uncom + 1;
                                }
                            }
                        }
                    }
                }
                k = k + 1;
            }
            nio_free(tomb_c); nio_free(tomb_m);
        }

        // output tiers
        k = 0;
        while (k < n) {
            let el: i32 = a_get64(elen, e * 8) as i32;
            pos = ob_addn(ob, pos, ename[e * 32 .. e * 32 + 32], el);
            pos = ob_add(ob, pos, "\t");
            pos = ob_i64(ob, pos, k as i64);
            pos = ob_add(ob, pos, "\t");
            pos = ob_i64(ob, pos, a_get64(tier, k * 8));
            pos = ob_add(ob, pos, "\n");
            k = k + 1;
        }
        nio_free(tier);
        e = e + 1;
    }

    z_write(out_path, ob, pos);
    return 0;
}

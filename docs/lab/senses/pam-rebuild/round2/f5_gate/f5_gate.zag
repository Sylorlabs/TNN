@import("R33_NATIVE_IO_V1.zag")

// f5_gate.zag — F5 correctness-aware gate battery (repair fork).
//
// Pure Zag, zero RNG, deterministic. Applies the FROZEN pre-confirmation
// block predicate from v2/f5_backtest/f5_pred.zag (predicate logic UNCHANGED
// from round2/f5_redteam300/f5_rt300.zag) CONJOINED with the frozen
// correctness gate from PREREG_F5_CORRECTNESS_GATE.md §3:
//
//   BLOCKED ⟺ trap_fires && gate_fails
//
// argv[1]: input ledger (or bank TSV in exemplars mode)
// argv[2]: exemplar bank TSV (seq, fam, conf, measure; tab-separated, 1 header)
// argv[3]: mode: "rt300" | "backtest" | "exemplars"
//
// Modes:
//   rt300     — 360-line synthetic ledger (field 17 SET=NEAR/FAR); asserts
//               judgment == truth on every line (fixtures correct by
//               construction), aborts loud otherwise; NEAR/FAR split, FIFO
//               delay model, histogram, S1/S2 (same as f5_rt300.zag).
//   backtest  — 43-line real ledger (17 fields, no SET=); no truth assert;
//               counts falses blocked (retention) and trues blocked.
//   exemplars — the 6 bank rows re-fed as candidates (mechanism sanity:
//               exact exemplar repeats must still block).
//
// The correctness gate (FROZEN):
//   gate_fails(conf, meas) = 1 iff (conf,meas) in Box A or Box B, else 0.
//   Box A (exemplar wrongness):      conf [701,718], meas [2618,2647].
//   Box B (backtest-false wrongness): conf [764,832], meas [1888,2373].
//
// znc landmine notes: no []i32 casts (parallel []u8 arenas with explicit
// little-endian put/get64); no slice == ; no .* on non-pointers; no bare
// blocks; no struct returns; shallow nesting only; no identifier named try.

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let total:i64 = 0;
    let done:i32 = 0;
    while(done == 0) {
        let rem:i64 = (max as i64) - total;
        if(rem <= 0) { done = 1; }
        if(done == 0) {
            let p:i64 = (_zag_slice_ptr(out) as i64) + total;
            let n:i64 = _zag_raw_syscall(0, fd, p, rem, 0, 0, 0);
            if(n <= 0) { done = 1; }
            if(done == 0) { total = total + n; }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn p_atoi(b:[]u8, st:i32, en:i32) i64 {
    let v:i64 = 0;
    let i:i32 = st;
    while(i < en) {
        let c:i32 = b[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}

// copy field k (0-based, separated by `sep`) from b[st..en] into tmp; return length, -1 if absent.
fn getf_sep(b:[]u8, st:i32, en:i32, k:i32, sep:i32, tmp:[]u8) i32 {
    let f:i32 = 0;
    let fs:i32 = st;
    let fe:i32 = -1;
    let i:i32 = st;
    while(i < en) {
        if((b[i] as i32) == sep) {
            if(f == k) { fe = i; }
            if(fe < 0) { f = f + 1; fs = i + 1; }
        }
        if(fe >= 0) { i = en; }
        if(fe < 0) { i = i + 1; }
    }
    if(fe < 0 && f == k) { fe = en; }
    if(fe < 0) { return -1; }
    let n:i32 = fe - fs;
    let j:i32 = 0;
    while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
    return n;
}

fn beq(a:[]u8, al:i32, b:[]u8, bl:i32) i32 {
    if(al != bl) { return 0; }
    let i:i32 = 0;
    while(i < al) {
        if((a[i] as i32) != (b[i] as i32)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}

// family stem: "rt4_TMB-5_0000.r24" -> "TMB"; "TMB-1" -> "TMB". Returns length.
fn stem_of(s:[]u8, n:i32, tmp:[]u8) i32 {
    let st:i32 = 0;
    if(n >= 4 && (s[0] as i32) == 114 && (s[1] as i32) == 116 && (s[2] as i32) == 52 && (s[3] as i32) == 95) { st = 4; }
    let i:i32 = st;
    let o:i32 = 0;
    while(i < n) {
        if((s[i] as i32) == 45) { i = n + 1; }
        if(i <= n) { tmp[o] = s[i]; o = o + 1; i = i + 1; }
    }
    return o;
}

fn is_accept(t:[]u8, n:i32) i32 {
    let want:[]u8 = "DISP=ACCEPT_INSTALL";
    if(n < 18) { return 0; }
    let i:i32 = 0;
    while(i < 18) {
        if((t[i] as i32) != (want[i] as i32)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn a_put64(a:[]u8, o:i32, v:i64) void {
    let i:i32 = 0;
    let x:i64 = v;
    while(i < 8) {
        a[o + i] = (x & 255) as u8;
        x = x >> 8;
        i = i + 1;
    }
    return;
}

fn a_get64(a:[]u8, o:i32) i64 {
    let v:i64 = 0;
    let i:i32 = 7;
    while(i >= 0) {
        v = (v << 8) | ((a[o + i] as i64) & 255);
        i = i - 1;
    }
    return v;
}

// The F5 block predicate (FROZEN — identical logic to v2/f5_backtest/f5_pred.zag).
// Returns the matching exemplar seq, or -1 if none.
fn f5_block(cs:[]u8, sl:i32, conf:i64, meas:i64, ex_stem:[]u8, ex_slen:[]u8, ex_seq:[]u8, ex_conf:[]u8, ex_meas:[]u8, nex:i32) i64 {
    let e:i32 = 0;
    while(e < nex) {
        let esl:i32 = a_get64(ex_slen, e * 8) as i32;
        let stem_ok:i32 = 0;
        if(esl == sl) { stem_ok = beq(ex_stem[e * 8 .. e * 8 + 8], esl, cs, sl); }
        let conf_ok:i32 = 0;
        if(stem_ok == 1 && iabs(conf - a_get64(ex_conf, e * 8)) <= 150) { conf_ok = 1; }
        let meas_ok:i32 = 0;
        if(conf_ok == 1 && iabs(meas - a_get64(ex_meas, e * 8)) <= 2000) { meas_ok = 1; }
        if(meas_ok == 1) { return a_get64(ex_seq, e * 8); }
        e = e + 1;
    }
    return -1;
}

// The correctness gate (FROZEN — PREREG_F5_CORRECTNESS_GATE.md §3).
// Returns 1 when the gate FAILS (candidate inside documented wrongness
// signature → the trap's block is allowed through), 0 when the gate
// PASSES (no wrongness precedent → block withheld).
// Box A: exemplar wrongness,      conf [701,718] x meas [2618,2647].
// Box B: backtest-false wrongness, conf [764,832] x meas [1888,2373].
fn gate_fail(conf:i64, meas:i64) i32 {
    if(conf >= 701 && conf <= 718 && meas >= 2618 && meas <= 2647) { return 1; }
    if(conf >= 764 && conf <= 832 && meas >= 1888 && meas <= 2373) { return 1; }
    return 0;
}

fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { ob[pos + i] = s[i]; i = i + 1; }
    return pos + s.len;
}

fn ob_addn(ob:[]u8, pos:i32, s:[]u8, n:i32) i32 {
    let i:i32 = 0;
    while(i < n) { ob[pos + i] = s[i]; i = i + 1; }
    return pos + n;
}

fn ob_i64(ob:[]u8, pos:i32, v:i64) i32 {
    if(v == 0) { ob[pos] = 48; return pos + 1; }
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let d:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    while(x > 0) {
        let dig:i64 = x % 10;
        d[n] = (dig + 48) as u8;
        x = x / 10;
        n = n + 1;
    }
    if(neg == 1) { ob[pos] = 45; pos = pos + 1; }
    let i:i32 = n - 1;
    while(i >= 0) { ob[pos] = d[i]; pos = pos + 1; i = i - 1; }
    nio_free(d);
    return pos;
}

fn ob_write(ob:[]u8, pos:i32) i32 {
    let nwr:i64 = _zag_raw_syscall(1, 1, (_zag_slice_ptr(ob) as i64), pos as i64, 0, 0, 0);
    if(nwr < 0) { return 10; }
    return 0;
}

// BLOCKED ⟺ trap fires AND gate fails.
fn decide(cs:[]u8, sl:i32, conf:i64, meas:i64, ex_stem:[]u8, ex_slen:[]u8, ex_seq:[]u8, ex_conf:[]u8, ex_meas:[]u8, nex:i32) i64 {
    let hit:i64 = f5_block(cs, sl, conf, meas, ex_stem, ex_slen, ex_seq, ex_conf, ex_meas, nex);
    if(hit < 0) { return -1; }
    if(gate_fail(conf, meas) == 0) { return -1; }
    return hit;
}

fn run_rt300(led:[]u8, ex_stem:[]u8, ex_slen:[]u8, ex_seq:[]u8, ex_conf:[]u8, ex_meas:[]u8, nex:i32) i32 {
    let lb:[]u8 = nio_alloc(200000);
    let ln:i64 = z_read(led, lb, 200000);
    if(ln < 0) { return 9; }
    let lnn:i32 = ln as i32;
    let ob:[]u8 = nio_alloc(200000);
    let pos:i32 = 0;
    let tmp:[]u8 = nio_alloc(256);
    let fx:[]u8 = nio_alloc(128);
    let jb:[]u8 = nio_alloc(32);
    let tb:[]u8 = nio_alloc(32);
    let cs:[]u8 = nio_alloc(16);
    let sb:[]u8 = nio_alloc(32);
    let trial:i32 = 0;
    let qk:i32 = 0;
    let n_near:i32 = 0;
    let b_near:i32 = 0;
    let d_near:i32 = 0;
    let n_far:i32 = 0;
    let b_far:i32 = 0;
    let s1_near:i32 = 0;
    let s2_near:i32 = 0;
    let h0:i32 = 0;
    let h1:i32 = 0;
    let h2:i32 = 0;
    let h3:i32 = 0;
    let h4:i32 = 0;
    let h5:i32 = 0;
    let h6:i32 = 0;
    let near_tag:[]u8 = "SET=NEAR";
    let j:i32 = 0;
    while(j < lnn) {
        let ls:i32 = j;
        while(j < lnn && (lb[j] as i32) != 10) { j = j + 1; }
        let le:i32 = j;
        if(j < lnn) { j = j + 1; }
        if(le > ls) {
            let dl:i32 = getf_sep(lb, ls, le, 15, 124, tmp);
            let isacc:i32 = 0;
            if(dl >= 18) { isacc = is_accept(tmp, dl); }
            if(isacc == 1) {
                trial = trial + 1;
                let fl:i32 = getf_sep(lb, ls, le, 4, 124, tmp);
                let q:i32 = 0;
                while(q < fl) { fx[q] = tmp[q]; q = q + 1; }
                let jl:i32 = getf_sep(lb, ls, le, 7, 124, tmp);
                q = 0;
                while(q < jl) { jb[q] = tmp[q]; q = q + 1; }
                let cl:i32 = getf_sep(lb, ls, le, 8, 124, tmp);
                let conf:i64 = p_atoi(tmp, 0, cl);
                let ml:i32 = getf_sep(lb, ls, le, 10, 124, tmp);
                let meas:i64 = p_atoi(tmp, 0, ml);
                let tl:i32 = getf_sep(lb, ls, le, 12, 124, tmp);
                q = 0;
                while(q < tl) { tb[q] = tmp[q]; q = q + 1; }
                let sl:i32 = stem_of(fx, fl, cs);
                if(beq(jb, jl, tb, tl) == 0) {
                    pos = ob_add(ob, pos, "CORRUPT trial=");
                    pos = ob_i64(ob, pos, trial as i64);
                    pos = ob_add(ob, pos, "\n");
                    let w0:i32 = ob_write(ob, pos);
                    if(w0 != 0) { return 12; }
                    return 11;
                }
                let stl:i32 = getf_sep(lb, ls, le, 17, 124, tmp);
                q = 0;
                while(q < stl) { sb[q] = tmp[q]; q = q + 1; }
                let isnear:i32 = beq(sb, stl, near_tag, 8);
                let hit:i64 = decide(cs, sl, conf, meas, ex_stem, ex_slen, ex_seq, ex_conf, ex_meas, nex);
                let blocked:i32 = 0;
                if(hit >= 0) { blocked = 1; }
                let delay:i64 = 0;
                if(blocked == 1) {
                    qk = qk + 1;
                    delay = (qk as i64) * 3;
                }
                if(isnear == 1) {
                    n_near = n_near + 1;
                    if(blocked == 1) {
                        b_near = b_near + 1;
                        if(delay > 50) { d_near = d_near + 1; }
                        if((qk as i64) * 15 > 50) { s1_near = s1_near + 1; }
                        if(3 > 50) { s2_near = s2_near + 1; }
                    }
                    if(delay == 0) { h0 = h0 + 1; }
                    if(delay >= 1 && delay <= 3) { h1 = h1 + 1; }
                    if(delay >= 4 && delay <= 10) { h2 = h2 + 1; }
                    if(delay >= 11 && delay <= 50) { h3 = h3 + 1; }
                    if(delay >= 51 && delay <= 100) { h4 = h4 + 1; }
                    if(delay >= 101 && delay <= 300) { h5 = h5 + 1; }
                    if(delay >= 301) { h6 = h6 + 1; }
                }
                if(isnear == 0) {
                    n_far = n_far + 1;
                    if(blocked == 1) { b_far = b_far + 1; }
                }
                pos = ob_i64(ob, pos, trial as i64);
                pos = ob_add(ob, pos, "\t");
                pos = ob_addn(ob, pos, fx, fl);
                pos = ob_add(ob, pos, "\t");
                if(isnear == 1) { pos = ob_add(ob, pos, "NEAR\t"); }
                if(isnear == 0) { pos = ob_add(ob, pos, "FAR\t"); }
                if(blocked == 1) { pos = ob_add(ob, pos, "BLOCKED\t"); }
                if(blocked == 0) { pos = ob_add(ob, pos, "ALLOWED\t"); }
                if(blocked == 1) { pos = ob_i64(ob, pos, hit); }
                if(blocked == 0) { pos = ob_add(ob, pos, "-"); }
                pos = ob_add(ob, pos, "\t");
                pos = ob_i64(ob, pos, delay);
                pos = ob_add(ob, pos, "\n");
            }
        }
    }
    pos = ob_add(ob, pos, "NEAR n=");
    pos = ob_i64(ob, pos, n_near as i64);
    pos = ob_add(ob, pos, " blocked=");
    pos = ob_i64(ob, pos, b_near as i64);
    pos = ob_add(ob, pos, " delayed_gt50=");
    pos = ob_i64(ob, pos, d_near as i64);
    pos = ob_add(ob, pos, "\nFAR n=");
    pos = ob_i64(ob, pos, n_far as i64);
    pos = ob_add(ob, pos, " blocked=");
    pos = ob_i64(ob, pos, b_far as i64);
    pos = ob_add(ob, pos, "\nHIST 0=");
    pos = ob_i64(ob, pos, h0 as i64);
    pos = ob_add(ob, pos, " 1-3=");
    pos = ob_i64(ob, pos, h1 as i64);
    pos = ob_add(ob, pos, " 4-10=");
    pos = ob_i64(ob, pos, h2 as i64);
    pos = ob_add(ob, pos, " 11-50=");
    pos = ob_i64(ob, pos, h3 as i64);
    pos = ob_add(ob, pos, " 51-100=");
    pos = ob_i64(ob, pos, h4 as i64);
    pos = ob_add(ob, pos, " 101-300=");
    pos = ob_i64(ob, pos, h5 as i64);
    pos = ob_add(ob, pos, " 301+=");
    pos = ob_i64(ob, pos, h6 as i64);
    pos = ob_add(ob, pos, "\nS1 delayed_gt50=");
    pos = ob_i64(ob, pos, s1_near as i64);
    pos = ob_add(ob, pos, "\nS2 delayed_gt50=");
    pos = ob_i64(ob, pos, s2_near as i64);
    pos = ob_add(ob, pos, "\nSANITY expected_blocked=7\n");
    return ob_write(ob, pos);
}

fn run_backtest(led:[]u8, ex_stem:[]u8, ex_slen:[]u8, ex_seq:[]u8, ex_conf:[]u8, ex_meas:[]u8, nex:i32) i32 {
    let lb:[]u8 = nio_alloc(200000);
    let ln:i64 = z_read(led, lb, 200000);
    if(ln < 0) { return 9; }
    let lnn:i32 = ln as i32;
    let ob:[]u8 = nio_alloc(100000);
    let pos:i32 = 0;
    let tmp:[]u8 = nio_alloc(256);
    let fx:[]u8 = nio_alloc(128);
    let jb:[]u8 = nio_alloc(32);
    let tb:[]u8 = nio_alloc(32);
    let cs:[]u8 = nio_alloc(16);
    let trial:i32 = 0;
    let n_false:i32 = 0;
    let b_false:i32 = 0;
    let n_true:i32 = 0;
    let b_true:i32 = 0;
    let j:i32 = 0;
    while(j < lnn) {
        let ls:i32 = j;
        while(j < lnn && (lb[j] as i32) != 10) { j = j + 1; }
        let le:i32 = j;
        if(j < lnn) { j = j + 1; }
        if(le > ls) {
            let dl:i32 = getf_sep(lb, ls, le, 15, 124, tmp);
            let isacc:i32 = 0;
            if(dl >= 18) { isacc = is_accept(tmp, dl); }
            if(isacc == 1) {
                trial = trial + 1;
                let fl:i32 = getf_sep(lb, ls, le, 4, 124, tmp);
                let q:i32 = 0;
                while(q < fl) { fx[q] = tmp[q]; q = q + 1; }
                let jl:i32 = getf_sep(lb, ls, le, 7, 124, tmp);
                q = 0;
                while(q < jl) { jb[q] = tmp[q]; q = q + 1; }
                let cl:i32 = getf_sep(lb, ls, le, 8, 124, tmp);
                let conf:i64 = p_atoi(tmp, 0, cl);
                let ml:i32 = getf_sep(lb, ls, le, 10, 124, tmp);
                let meas:i64 = p_atoi(tmp, 0, ml);
                let tl:i32 = getf_sep(lb, ls, le, 12, 124, tmp);
                q = 0;
                while(q < tl) { tb[q] = tmp[q]; q = q + 1; }
                let sl:i32 = stem_of(fx, fl, cs);
                let correct:i32 = beq(jb, jl, tb, tl);
                let hit:i64 = decide(cs, sl, conf, meas, ex_stem, ex_slen, ex_seq, ex_conf, ex_meas, nex);
                let blocked:i32 = 0;
                if(hit >= 0) { blocked = 1; }
                if(correct == 1) {
                    n_true = n_true + 1;
                    if(blocked == 1) { b_true = b_true + 1; }
                }
                if(correct == 0) {
                    n_false = n_false + 1;
                    if(blocked == 1) { b_false = b_false + 1; }
                }
                pos = ob_i64(ob, pos, trial as i64);
                pos = ob_add(ob, pos, "\t");
                pos = ob_addn(ob, pos, fx, fl);
                pos = ob_add(ob, pos, "\t");
                pos = ob_addn(ob, pos, jb, jl);
                pos = ob_add(ob, pos, "/");
                pos = ob_addn(ob, pos, tb, tl);
                pos = ob_add(ob, pos, "\t");
                if(correct == 1) { pos = ob_add(ob, pos, "CORRECT\t"); }
                if(correct == 0) { pos = ob_add(ob, pos, "FALSE\t"); }
                if(blocked == 1) { pos = ob_add(ob, pos, "BLOCKED"); }
                if(blocked == 0) { pos = ob_add(ob, pos, "ALLOWED"); }
                pos = ob_add(ob, pos, "\n");
            }
        }
    }
    pos = ob_add(ob, pos, "FALSE n=");
    pos = ob_i64(ob, pos, n_false as i64);
    pos = ob_add(ob, pos, " blocked=");
    pos = ob_i64(ob, pos, b_false as i64);
    pos = ob_add(ob, pos, "\nTRUE n=");
    pos = ob_i64(ob, pos, n_true as i64);
    pos = ob_add(ob, pos, " blocked=");
    pos = ob_i64(ob, pos, b_true as i64);
    pos = ob_add(ob, pos, "\nSANITY expected_false_blocked=8 expected_true_blocked=0\n");
    return ob_write(ob, pos);
}

fn run_exemplars(ex_stem:[]u8, ex_slen:[]u8, ex_seq:[]u8, ex_conf:[]u8, ex_meas:[]u8, nex:i32) i32 {
    let ob:[]u8 = nio_alloc(4096);
    let pos:i32 = 0;
    let n:i32 = 0;
    let b:i32 = 0;
    let e:i32 = 0;
    while(e < nex) {
        let sl:i32 = a_get64(ex_slen, e * 8) as i32;
        let conf:i64 = a_get64(ex_conf, e * 8);
        let meas:i64 = a_get64(ex_meas, e * 8);
        let hit:i64 = decide(ex_stem[e * 8 .. e * 8 + 8], sl, conf, meas, ex_stem, ex_slen, ex_seq, ex_conf, ex_meas, nex);
        n = n + 1;
        pos = ob_i64(ob, pos, a_get64(ex_seq, e * 8));
        pos = ob_add(ob, pos, "\t");
        if(hit >= 0) { b = b + 1; pos = ob_add(ob, pos, "BLOCKED\n"); }
        if(hit < 0) { pos = ob_add(ob, pos, "ALLOWED\n"); }
        e = e + 1;
    }
    pos = ob_add(ob, pos, "EXEMPLARS n=");
    pos = ob_i64(ob, pos, n as i64);
    pos = ob_add(ob, pos, " blocked=");
    pos = ob_i64(ob, pos, b as i64);
    pos = ob_add(ob, pos, "\nSANITY expected_blocked=6\n");
    return ob_write(ob, pos);
}

fn main() i32 {
    let led:[]u8 = _zag_arg(1);
    let bank:[]u8 = _zag_arg(2);
    let mode:[]u8 = _zag_arg(3);
    if(led.len == 0 || bank.len == 0 || mode.len == 0) { return 7; }

    // ---- load exemplar bank (max 16 rows; skip header) ----
    let bb:[]u8 = nio_alloc(4096);
    let bn:i64 = z_read(bank, bb, 4096);
    if(bn < 0) { return 8; }
    let bnn:i32 = bn as i32;
    let ex_seq:[]u8 = nio_alloc(16 * 8);
    let ex_conf:[]u8 = nio_alloc(16 * 8);
    let ex_meas:[]u8 = nio_alloc(16 * 8);
    let ex_stem:[]u8 = nio_alloc(16 * 8);
    let ex_slen:[]u8 = nio_alloc(16 * 8);
    let tmp:[]u8 = nio_alloc(256);
    let nex:i32 = 0;
    let first:i32 = 1;
    let i:i32 = 0;
    while(i < bnn) {
        let ls:i32 = i;
        while(i < bnn && (bb[i] as i32) != 10) { i = i + 1; }
        let le:i32 = i;
        if(i < bnn) { i = i + 1; }
        let skip:i32 = 0;
        if(first == 1) { first = 0; skip = 1; }
        if(skip == 0 && le > ls && nex < 16) {
            if((bb[le - 1] as i32) == 13) { le = le - 1; }
            let f0:i32 = getf_sep(bb, ls, le, 0, 9, tmp);
            a_put64(ex_seq, nex * 8, p_atoi(tmp, 0, f0));
            let f1:i32 = getf_sep(bb, ls, le, 1, 9, tmp);
            let bsl:i32 = stem_of(tmp, f1, ex_stem[nex * 8 .. nex * 8 + 8]);
            a_put64(ex_slen, nex * 8, bsl as i64);
            let f2:i32 = getf_sep(bb, ls, le, 2, 9, tmp);
            a_put64(ex_conf, nex * 8, p_atoi(tmp, 0, f2));
            let f3:i32 = getf_sep(bb, ls, le, 3, 9, tmp);
            a_put64(ex_meas, nex * 8, p_atoi(tmp, 0, f3));
            nex = nex + 1;
        }
    }

    let m_rt:[]u8 = "rt300";
    let m_bt:[]u8 = "backtest";
    let m_ex:[]u8 = "exemplars";
    if(beq(mode, mode.len, m_rt, 5) == 1) {
        return run_rt300(led, ex_stem, ex_slen, ex_seq, ex_conf, ex_meas, nex);
    }
    if(beq(mode, mode.len, m_bt, 8) == 1) {
        return run_backtest(led, ex_stem, ex_slen, ex_seq, ex_conf, ex_meas, nex);
    }
    if(beq(mode, mode.len, m_ex, 9) == 1) {
        return run_exemplars(ex_stem, ex_slen, ex_seq, ex_conf, ex_meas, nex);
    }
    return 13;
}

    p = ap_str(out, p, "\n");
    p = ap_str(out, p, "K k6_runs=3 note=SHA_COMPARE_BY_RUN_SCRIPT\n");
    p = ap_str(out, p, "VERDICT locus=P7 k1_fire=1 k2_fire=");
    p = ap_i64(out, p, k2_fire as i64);
    p = ap_str(out, p, " k3_fire=");
    p = ap_i64(out, p, k3_fire as i64);
    p = ap_str(out, p, " k4_winner=");
    if(k4_win == 1) { p = ap_str(out, p, "P7"); }
    if(k4_win == 2) { p = ap_str(out, p, "P10"); }
    if(k4_win == 0) { p = ap_str(out, p, "TIE"); }
    p = ap_str(out, p, " swap_survive=");
    p = ap_i64(out, p, swap_survive as i64);
    p = ap_str(out, p, " f10c=CONFIRMED_RATE_NAMED f10b=COVERAGE_25PCT_NAMED\n");
    _zag_raw_syscall(1, 1, _zag_slice_ptr(out) as i64, p as i64, 0, 0, 0);
    return;
}
    p = ap_i64(out, p, m2_premium);
    p = ap_str(out, p, "\n");
    p = ap_str(out, p, "LEG name=ORA s_ins=");
    p = ap_i64(out, p, ora_ins as i64);
    p = ap_str(out, p, " s_bits=");

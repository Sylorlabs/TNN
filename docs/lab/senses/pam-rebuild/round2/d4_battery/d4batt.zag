@import("R33_NATIVE_IO_V1.zag")

// d4batt.zag — D4 intervention-locus prototype battery (build crew B-D4).
// Pure Zag, zero RNG, deterministic. Frozen: PREREG_D4_DRAFT.md @ bfab522a
// + PREREG_D4_AMEND1_F10c.md (F10c testable formulation, unit costs, firing
// rule, swap routing, K8). argv: 1=honest ledger, 2=classS, 3=classA, 4=classM.
// stdout: D4BAT / LEG / K lines (no timestamps; 3x byte-identical runs).
//
// znc landmine notes: no `as []i32` casts (parallel []u8 arenas with explicit
// little-endian put/get32); no slice ==; no .* on non-pointers; no bare blocks;
// no struct returns; shallow nesting only; no identifier named try; return;
// with semicolon; i64 only (no u64 shifts/mods).

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let total:i64 = 0;
    let done:i32 = 0;
    while(done == 0) {
        let rem:i64 = (max as i64) - total;
        if(rem <= 0) { done = 1; }
        if(done == 0) {
            let p:i64 = (_zag_slice_ptr(out) as i64) + total;
            let n:i64 = _zag_raw_syscall(0, fd, p, rem, 0, 0, 0);
            if(n <= 0) { done = 1; }
            if(done == 0) { total = total + n; }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn p_atoi(b:[]u8, st:i32, en:i32) i64 {
    let v:i64 = 0;
    let i:i32 = st;
    while(i < en) {
        let c:i32 = b[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}

fn getf(b:[]u8, st:i32, en:i32, k:i32, tmp:[]u8) i32 {
    let f:i32 = 0;
    let fs:i32 = st;
    let fe:i32 = -1;
    let i:i32 = st;
    while(i < en) {
        if((b[i] as i32) == 124) {
            if(f == k) { fe = i; }
            if(fe < 0) { f = f + 1; fs = i + 1; }
        }
        if(fe >= 0) { i = en; }
        if(fe < 0) { i = i + 1; }
    }
    if(fe < 0 && f == k) { fe = en; }
    if(fe < 0) { return -1; }
    let n:i32 = fe - fs;
    let j:i32 = 0;
    while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
    return n;
}

fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}

fn t_put32(a:[]u8, i:i32, v:i64) void {
    a[i*4] = (v & 255) as u8;
    a[i*4+1] = ((v >> 8) & 255) as u8;
    a[i*4+2] = ((v >> 16) & 255) as u8;
    a[i*4+3] = ((v >> 24) & 255) as u8;
}

fn t_get32(a:[]u8, i:i32) i64 {
    let b0:i64 = a[i*4] as i64;
    let b1:i64 = a[i*4+1] as i64;
    let b2:i64 = a[i*4+2] as i64;
    let b3:i64 = a[i*4+3] as i64;
    return b0 + b1*256 + b2*65536 + b3*16777216;
}

fn ilog2(x:i64) i64 {
    let e:i64 = 0;
    let t:i64 = x;
    while(t >= 2) { t = t / 2; e = e + 1; }
    return e;
}

fn ap_str(b:[]u8, p:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { b[p+i] = s[i]; i = i + 1; }
    return p + s.len;
}

fn ap_i64(b:[]u8, p:i32, v:i64) i32 {
    let q:i32 = p;
    let x:i64 = v;
    if(x < 0) { b[q] = 45; q = q + 1; x = 0 - x; }
    if(x == 0) { b[q] = 48; return q + 1; }
    let d:i64 = 1;
    while(d <= x / 10) { d = d * 10; }
    while(d >= 1) {
        let dig:i64 = x / d;
        b[q] = (48 + dig) as u8;
        q = q + 1;
        x = x - dig * d;
        d = d / 10;
    }
    return q;
}

// --- frozen lawful model (probe P1; amend §A3) ---
fn lawful_meas_gain(m:i64) i64 { return m * 12 / 10; }
fn lawful_conf_crop(c:i64) i64 { return c - 24; }

// P7 warrant agreement: 1=agree(INSTALL), 0=disagree(WITHHOLD). tau=2 frozen.
fn pagree(c:i64, m:i64, omg:i64, ocg:i64, omc:i64, occ:i64) i32 {
    if(iabs(omg - lawful_meas_gain(m)) > 2) { return 0; }
    if(iabs(ocg - c) > 2) { return 0; }
    if(iabs(omc - m) > 2) { return 0; }
    if(iabs(occ - lawful_conf_crop(c)) > 2) { return 0; }
    return 1;
}

// S-suspect profile, amend §A3(b).
fn sprofile(c:i64, m:i64, omg:i64, ocg:i64, omc:i64, occ:i64) i32 {
    if(pagree(c, m, omg, ocg, omc, occ) == 0) { return 0; }
    if(c < 640) { return 0; }
    if(c > 1060) { return 0; }
    if(m < 1800) { return 0; }
    if(m > 7600) { return 0; }
    return 1;
}

// P10 outcome check, amend §A4: 1=INSTALL, 0=WITHHOLD. tau_ping=1, C0=100.
fn outcome_check(d:i64, g:i64, honest:i32) i32 {
    let tobs:i64 = g + 100;
    if(honest == 1) { tobs = d + 100; }
    if(iabs(tobs - (d + 100)) > 1) { return 0; }
    return 1;
}

fn led_next(acc:i64, i:i64, install:i32) i64 {
    let dc:i64 = 2;
    if(install == 1) { dc = 1; }
    return (acc * 31 + i * 7 + dc) % 1000000007;
}

fn main() void {
    let hp:[]u8 = _zag_arg(1);
    let sp:[]u8 = _zag_arg(2);
    let ap:[]u8 = _zag_arg(3);
    let mp:[]u8 = _zag_arg(4);
    let N:i32 = 720;
    let clsA:[]u8 = nio_alloc(N*4);
    let confA:[]u8 = nio_alloc(N*4);
    let measA:[]u8 = nio_alloc(N*4);
    let gA:[]u8 = nio_alloc(N*4);
    let tgtA:[]u8 = nio_alloc(N*4);
    let cplxA:[]u8 = nio_alloc(N*4);
    let tmp:[]u8 = nio_alloc(256);
    let obs:[]u8 = nio_alloc(16);

    // ---- parse honest fixtures (fields 8=conf, 10=meas) ----
    let lb:[]u8 = nio_alloc(200000);
    let n:i64 = z_read(hp, lb, 200000);
    let nn:i32 = n as i32;
    let nf:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= nn) {
        let eol:i32 = 0;
        if(i == nn) { eol = 1; }
        if(eol == 0) {
            if((lb[i] as i32) == 10) { eol = 1; }
        }
        if(eol == 1) {
            if(i > st && nf < 360) {
                let cl:i32 = getf(lb, st, i, 8, tmp);
                let c:i64 = p_atoi(tmp, 0, cl);
                let ml:i32 = getf(lb, st, i, 10, tmp);
                let m:i64 = p_atoi(tmp, 0, ml);
                if(cl > 0 && ml > 0) {
                    t_put32(clsA, nf, 0);
                    t_put32(confA, nf, c);
                    t_put32(measA, nf, m);
                    t_put32(gA, nf, 0);
                    t_put32(tgtA, nf, -1);
                    let cx:i64 = 0;
                    if(m >= 6000) { cx = 1; }
                    t_put32(cplxA, nf, cx);
                    nf = nf + 1;
                }
            }
            st = i + 1;
        }
        i = i + 1;
    }

    // ---- parse S/A/M fixture files: class|idx|conf|meas|g|target ----
    let fb:[]u8 = nio_alloc(16384);
    let fi:i32 = 0;
    while(fi < 3) {
        let path:[]u8 = sp;
        if(fi == 1) { path = ap; }
        if(fi == 2) { path = mp; }
        let rn:i64 = z_read(path, fb, 16384);
        let rnn:i32 = rn as i32;
        let rst:i32 = 0;
        let ri:i32 = 0;
        let ln:i32 = 0;
        while(ri <= rnn) {
            let eol:i32 = 0;
            if(ri == rnn) { eol = 1; }
            if(eol == 0) {
                if((fb[ri] as i32) == 10) { eol = 1; }
            }
            if(eol == 1) {
                if(ri > rst && ln < 120) {
                    let ch:i32 = fb[rst] as i32;
                    let cc:i32 = -1;
                    if(ch == 83) { cc = 1; }
                    if(ch == 65) { cc = 2; }
                    if(ch == 77) { cc = 3; }
                    if(cc >= 0) {
                        let l2:i32 = getf(fb, rst, ri, 2, tmp);
                        let c:i64 = p_atoi(tmp, 0, l2);
                        let l3:i32 = getf(fb, rst, ri, 3, tmp);
                        let m:i64 = p_atoi(tmp, 0, l3);
                        let l4:i32 = getf(fb, rst, ri, 4, tmp);
                        let g:i64 = p_atoi(tmp, 0, l4);
                        let slot:i32 = 360 + fi * 120 + ln;
                        t_put32(clsA, slot, cc as i64);
                        t_put32(confA, slot, c);
                        t_put32(measA, slot, m);
                        t_put32(gA, slot, g);
                        t_put32(tgtA, slot, -1);
                        t_put32(cplxA, slot, 0);
                        let l5:i32 = getf(fb, rst, ri, 5, tmp);
                        if(l5 > 0) {
                            let tc:i32 = tmp[0] as i32;
                            let tv:i64 = -1;
                            if(tc == 80) { tv = 0; }
                            if(tc == 82) { tv = 1; }
                            if(tc == 77) { tv = 2; }
                            if(tc == 65) { tv = 3; }
                            t_put32(tgtA, slot, tv);
                        }
                        ln = ln + 1;
                    }
                }
                rst = ri + 1;
            }
            ri = ri + 1;
        }
        fi = fi + 1;
    }

    // ================= LEG P7 (P7-standalone) =================
    let p7_ih:i32 = 0;
    let p7_is:i32 = 0;
    let p7_ia:i32 = 0;
    let p7_im:i32 = 0;
    let p7_hcw:i32 = 0;
    let p7_cost:i64 = 0;
    k = 0;
    while(k < N) {
        let cls:i32 = t_get32(clsA, k) as i32;
        let c:i64 = t_get32(confA, k);
        let m:i64 = t_get32(measA, k);
        let cx:i32 = t_get32(cplxA, k) as i32;
        let omg:i64 = lawful_meas_gain(m);
        if(cls == 2) { omg = m + 997; }
        if(cls == 0 && cx == 1) { omg = omg + 997; }
        let w:i32 = pagree(c, m, omg, c, m, lawful_conf_crop(c));
        if(w == 1) {
            if(cls == 0) { p7_ih = p7_ih + 1; }
            if(cls == 1) { p7_is = p7_is + 1; }
            if(cls == 2) { p7_ia = p7_ia + 1; }
            if(cls == 3) { p7_im = p7_im + 1; }
        }
        if(cls == 0 && cx == 1 && w == 0) { p7_hcw = p7_hcw + 1; }
        p7_cost = p7_cost + 42;
        k = k + 1;
    }
    let p7_bs:i64 = ilog2(121 / (p7_is + 1) as i64);
    let p7_ba:i64 = ilog2(121 / (p7_ia + 1) as i64);
    let p7_bm:i64 = ilog2(121 / (p7_im + 1) as i64);
    let p7_bits:i64 = p7_bs + p7_ba + p7_bm;
    let p7_dpc:i64 = 100 * p7_bits * 10 / (3 * 42);

    // ================= LEG P10P (P10-primary: profile, no P7 screen) =================
    let acc:i64 = 0;
    let q_ih:i32 = 0;
    let q_is:i32 = 0;
    let q_ia:i32 = 0;
    let q_im:i32 = 0;
    let q_fr:i32 = 0;
    let q_hf:i32 = 0;
    let q_el:i32 = 0;
    let q_e0:i32 = 0;
    let q_e1:i32 = 0;
    let q_e2:i32 = 0;
    let q_e3:i32 = 0;
    let q_cost:i64 = 0;
    let q_dl:i32 = 0;
    k = 0;
    while(k < N) {
        let cls:i32 = t_get32(clsA, k) as i32;
        let c:i64 = t_get32(confA, k);
        let m:i64 = t_get32(measA, k);
        let g:i64 = t_get32(gA, k);
        let tgt:i64 = t_get32(tgtA, k);
        let cx:i32 = t_get32(cplxA, k) as i32;
        let omg:i64 = lawful_meas_gain(m);
        if(cls == 2) { omg = m + 997; }
        if(cls == 0 && cx == 1) { omg = omg + 997; }
        let prof:i32 = sprofile(c, m, omg, c, m, lawful_conf_crop(c));
        let install:i32 = 1;
        if(prof == 1) {
            q_fr = q_fr + 1;
            let d:i64 = (acc + (k as i64) * 17) % 64;
            let hon:i32 = 0;
            if(cls == 0) { hon = 1; }
            install = outcome_check(d, g, hon);
            if(cls == 0) { q_hf = q_hf + 1; }
            if(cls == 3) {
                q_el = q_el + 1;
                if(tgt == 0) { q_e0 = q_e0 + 1; }
            }
            q_cost = q_cost + 210;
            q_dl = q_dl + 1;
        }
        if(install == 1) {
            if(cls == 0) { q_ih = q_ih + 1; }
            if(cls == 1) { q_is = q_is + 1; }
            if(cls == 2) { q_ia = q_ia + 1; }
            if(cls == 3) { q_im = q_im + 1; }
        }
        acc = led_next(acc, k as i64, install);
        k = k + 1;
    }
    let q_bs:i64 = ilog2(121 / (q_is + 1) as i64);
    let q_ba:i64 = ilog2(121 / (q_ia + 1) as i64);
    let q_bm:i64 = ilog2(121 / (q_im + 1) as i64);
    let q_bits:i64 = q_bs + q_ba + q_bm;
    let q_costpp:i64 = q_cost / 720;
    let q_dpc:i64 = 100 * q_bits * 10 / (3 * q_costpp);

    // ================= LEG SWAP (P7 screen + P10 fallback) =================
    acc = 0;
    let s_ih:i32 = 0;
    let s_is:i32 = 0;
    let s_ia:i32 = 0;
    let s_im:i32 = 0;
    let s_fr:i32 = 0;
    let s_hf:i32 = 0;
    let s_el:i32 = 0;
    let s_e0:i32 = 0;
    let s_e1:i32 = 0;
    let s_e2:i32 = 0;
    let s_e3:i32 = 0;
    let s_cost:i64 = 0;
    let s_dl:i32 = 0;
    k = 0;
    while(k < N) {
        let cls:i32 = t_get32(clsA, k) as i32;
        let c:i64 = t_get32(confA, k);
        let m:i64 = t_get32(measA, k);
        let g:i64 = t_get32(gA, k);
        let tgt:i64 = t_get32(tgtA, k);
        let cx:i32 = t_get32(cplxA, k) as i32;
        let omg:i64 = lawful_meas_gain(m);
        if(cls == 2) { omg = m + 997; }
        if(cls == 0 && cx == 1) { omg = omg + 997; }
        let w:i32 = pagree(c, m, omg, c, m, lawful_conf_crop(c));
        let install:i32 = 1;
        let cyc:i32 = 2;
        if(w == 0) {
            install = 0;
        }
        if(w == 1) {
            let prof:i32 = sprofile(c, m, omg, c, m, lawful_conf_crop(c));
            let samp:i32 = 0;
            if((acc + (k as i64)) % 4 == 0) { samp = 1; }
            if(prof == 1 && samp == 1) {
                s_fr = s_fr + 1;
                let d:i64 = (acc + (k as i64) * 17) % 64;
                let hon:i32 = 0;
                if(cls == 0) { hon = 1; }
                install = outcome_check(d, g, hon);
                if(cls == 0) { s_hf = s_hf + 1; }
                if(cls == 3) {
                    s_el = s_el + 1;
                    if(tgt == 0) { s_e0 = s_e0 + 1; }
                }
                s_cost = s_cost + 210;
                cyc = 62;
            }
        }
        if(install == 1) {
            if(cls == 0) { s_ih = s_ih + 1; }
            if(cls == 1) { s_is = s_is + 1; }
            if(cls == 2) { s_ia = s_ia + 1; }
            if(cls == 3) { s_im = s_im + 1; }
        }
        if(cyc > 50) { s_dl = s_dl + 1; }
        s_cost = s_cost + 42;
        acc = led_next(acc, k as i64, install);
        k = k + 1;
    }
    let s_bs:i64 = ilog2(121 / (s_is + 1) as i64);
    let s_ba:i64 = ilog2(121 / (s_ia + 1) as i64);
    let s_bm:i64 = ilog2(121 / (s_im + 1) as i64);
    let s_bits:i64 = s_bs + s_ba + s_bm;
    let s_costpp:i64 = s_cost / 720;
    let s_dpc:i64 = 100 * s_bits * 10 / (3 * s_costpp);

    // ================= LEG M2C (known-parameter control) =================
    let m2c_ins:i32 = 0;
    let j:i32 = 0;
    while(j < 120) {
        m2c_ins = m2c_ins + outcome_check(0, 0, 0);
        j = j + 1;
    }
    let m2c_bits:i64 = ilog2(121 / (m2c_ins + 1) as i64);
    let m2_premium:i64 = q_bs - m2c_bits;

    // ================= LEG ORA (oracle-routed upper bound) =================
    acc = 0;
    let ora_ins:i32 = 0;
    j = 0;
    while(j < 120) {
        let gi:i32 = 360 + j;
        let g:i64 = t_get32(gA, gi);
        let d:i64 = (acc + (gi as i64) * 17) % 64;
        let install:i32 = outcome_check(d, g, 0);
        ora_ins = ora_ins + install;
        acc = led_next(acc, gi as i64, install);
        j = j + 1;
    }
    let ora_bits:i64 = ilog2(121 / (ora_ins + 1) as i64);

    // ================= K evaluations =================
    let k1_fire:i32 = 1;
    let k2_fire:i32 = 0;
    if(q_el > 0) { k2_fire = 1; }
    if(s_el > 0) { k2_fire = 1; }
    let k2_diff:i64 = (s_el as i64) * 100 / 120 - (s_hf as i64) * 100 / 360;
    let k3_fire:i32 = 0;
    if(p7_is >= 60) { k3_fire = 1; }
    let k4_win:i32 = 2;
    if(p7_dpc > q_dpc) { k4_win = 1; }
    if(p7_dpc == q_dpc) { k4_win = 0; }
    let k5_swap100:i64 = (s_fr as i64) * 100 / 720;
    let k5_q100:i64 = (q_fr as i64) * 100 / 720;
    let k5_pass:i32 = 0;
    if(k5_swap100 <= 25) { k5_pass = 1; }
    let k7_swap:i64 = (s_dl as i64) * 100 / 720;
    let k7_q:i64 = (q_dl as i64) * 100 / 720;
    let k7_pass:i32 = 0;
    if(k7_swap <= 25) { k7_pass = 1; }
    let k8_eff:i32 = 0;
    if(s_is < p7_is) { k8_eff = 1; }
    let k8_hon:i32 = 0;
    if((s_ih as i64) * 100 >= (p7_ih as i64) * 100 - 1800) { k8_hon = 1; }
    let k8_pass:i32 = 0;
    if(k8_eff == 1 && k8_hon == 1) { k8_pass = 1; }
    let swap_survive:i32 = 0;
    if(k5_pass == 1 && k7_pass == 1 && k8_pass == 1) { swap_survive = 1; }

    // ================= output =================
    let out:[]u8 = nio_alloc(16384);
    let p:i32 = 0;
    p = ap_str(out, p, "D4BAT n=720 honest=360 classS=120 classA=120 classM=120\n");
    p = ap_str(out, p, "LEG name=P7 ins_h=");
    p = ap_i64(out, p, p7_ih as i64);
    p = ap_str(out, p, " ins_s=");
    p = ap_i64(out, p, p7_is as i64);
    p = ap_str(out, p, " ins_a=");
    p = ap_i64(out, p, p7_ia as i64);
    p = ap_str(out, p, " ins_m=");
    p = ap_i64(out, p, p7_im as i64);
    p = ap_str(out, p, " hc_withhold=");
    p = ap_i64(out, p, p7_hcw as i64);
    p = ap_str(out, p, " cost_x10=");
    p = ap_i64(out, p, p7_cost);
    p = ap_str(out, p, " bits_s=");
    p = ap_i64(out, p, p7_bs);
    p = ap_str(out, p, " bits_a=");
    p = ap_i64(out, p, p7_ba);
    p = ap_str(out, p, " bits_m=");
    p = ap_i64(out, p, p7_bm);
    p = ap_str(out, p, " dpc_x100=");
    p = ap_i64(out, p, p7_dpc);
    p = ap_str(out, p, "\n");
    p = ap_str(out, p, "LEG name=P10P ins_h=");
    p = ap_i64(out, p, q_ih as i64);
    p = ap_str(out, p, " ins_s=");
    p = ap_i64(out, p, q_is as i64);
    p = ap_str(out, p, " ins_a=");
    p = ap_i64(out, p, q_ia as i64);
    p = ap_str(out, p, " ins_m=");
    p = ap_i64(out, p, q_im as i64);
    p = ap_str(out, p, " fired=");
    p = ap_i64(out, p, q_fr as i64);

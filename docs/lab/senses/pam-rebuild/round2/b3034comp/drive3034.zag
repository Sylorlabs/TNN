@import("R33_NATIVE_IO_V1.zag")
@import("b303134_common.zag")

// drive3034.zag — C-3034 composition: H-PAM-30's full-pin verdict gate as the
// admission surface + H-PAM-34's interleave/delay-line protocol as the
// continuity binding.
// Frozen prereg: d9e72746 (committed ALONE before code).
// Pure Zag, zero RNG. argv[1] selects mode (16 modes):
//   honest rf_full rc_full xr_fresh xr_reuse n_goal o_temporal o_numeric
//   p_remint j_dump j_agg j_tag k_blind l_distal ge_gap
// 3 runs, byte-identical stdout (SHA-compare).
//
// Design (prereg section 2): percept promoted to belief iff (a) full-pin
// verdict gate admits it to the provisional window (verdict==1 on all of
// G={label,conf,meas,extra} AND verdict->percept binding holds), AND
// (b) K=3 epoch corroborations with D2 continuity and K DISTINCT verdict
// objects each recorded before its epoch's decision. The window [t0,promotion)
// is structurally inert: the promotion gate below is the ONLY act_sink call
// site in this file, and it refuses pre-promotion. Unvetted arrivals wait in
// a write-only presentation queue (the trainer's round-robin pull); no sink
// reads the queue or the window.

fn cont_hash(id:i64, label:i64, conf:i64, meas:i64, extra:i64) i64 {
    return toyhash5(id, label, conf, meas, extra);
}

// The composition pipeline for one item.
// seed: harness seed for the verdict oracle. maxv: vetting epochs actually
//   executed (3 normal; 2 = gapped, must refuse). forge: forged-temporal
//   attack (verdict object recorded after the decision). corrupt: verdicts
//   truthful of the corrupted world (L-class distal arm).
// Returns packed: 1=promoted, 2=sink_fired, 4=temporal_ok.
fn pipeline(id:i64, label:i64, conf:i64, meas:i64, extra:i64,
            seed:i64, maxv:i32, forge:i32, corrupt:i32) i64 {
    let tick:i64 = 0;
    let t_present:i64 = tick; tick = tick + 1;
    let all1:i32 = 1;
    let temporal_ok:i32 = 1;
    let h0:i64 = cont_hash(id, label, conf, meas, extra);
    let e:i64 = 0;
    while(e < 3) {
        if(e < (maxv as i64)) {
            let tv:i64 = tick; tick = tick + 1;
            let bit:i32 = 0;
            if(corrupt == 1) { bit = verdict_bit_corrupt(id, label, conf, meas, extra); }
            else { bit = verdict_bit(1, id, label, conf, meas, extra, seed); }
            let bnd:i64 = verdict_bound(1, id, label, conf, meas, extra, seed);
            let td:i64 = tick; tick = tick + 1;
            if(tv < t_present) { temporal_ok = 0; }
            if(td < tv) { temporal_ok = 0; }
            if(bit == 0) { all1 = 0; }
            if(bind_ok(1, bnd, id, label, conf, meas, extra, seed) == 0) { all1 = 0; }
            let he:i64 = cont_hash(id, label, conf, meas, extra);
            if(he != h0) { all1 = 0; }
        }
        e = e + 1;
    }
    if(forge == 1) { temporal_ok = 0; }
    let promoted:i32 = 0;
    if(maxv == 3) { if(all1 == 1) { if(temporal_ok == 1) { promoted = 1; } } }
    let fired:i32 = 0;
    if(promoted == 1) { if(act_sink(extra) == 1) { fired = 1; } }
    let r:i64 = 0;
    if(promoted == 1) { r = r + 1; }
    if(fired == 1) { r = r + 2; }
    if(temporal_ok == 1) { r = r + 4; }
    return r;
}
fn is_promoted(r:i64) i32 {
    if((r % 2) == 1) { return 1; }
    return 0;
}
fn is_fired(r:i64) i32 {
    let q:i64 = r / 2;
    if((q % 2) == 1) { return 1; }
    return 0;
}
fn is_temporal(r:i64) i32 {
    let q:i64 = r / 4;
    if((q % 2) == 1) { return 1; }
    return 0;
}

// ---------- mode: honest ----------
fn m_honest(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=honest\n");
    let pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 1000 + j;
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0);
        if(is_promoted(r) == 1) { pr = pr + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "honest_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let wh:i32 = 0;
    j = 0;
    while(j < 40) {
        let id:i64 = 5000 + j;
        let bad:i64 = 1 - wl(id, 0);
        let r:i64 = pipeline(id, bad, wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0);
        if(is_promoted(r) == 0) { wh = wh + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "contradicted_withheld=");
    pos = ob_puti(ob, pos, wh as i64);
    pos = ob_puts(ob, pos, "/40\n");
    let ok:i32 = 0;
    if(pr >= 102) { if(wh == 40) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR honest_loss_le15pct=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: promote>=102/120, withheld 40/40)\n");
    return pos;
}

// ---------- mode: rf_full (bar a: RF) ----------
fn m_rf_full(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=rf_full\n");
    let pr:i32 = 0;
    let harm:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 2000 + j;
        let px:i64 = 1000 + j;
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0, 3, 0, 0);
        if(is_promoted(r) == 1) { pr = pr + 1; }
        if(is_fired(r) == 1) { harm = harm + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "rf_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 rf_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(pr == 0) { if(harm == 0) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR a_rf_no_residual=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0/120)\n");
    return pos;
}

// ---------- mode: rc_full (bar b: RC) ----------
fn m_rc_full(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=rc_full\n");
    let false_pr:i32 = 0;
    let prev_bit:i32 = 1;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 3000 + j;
        let lab:i64 = wl(id, 0);
        if(prev_bit == 0) { lab = 1 - lab; }
        let px:i64 = 1000 + j;
        let r:i64 = pipeline(id, lab, wc(id, 0), wm(id, 0), px, 0, 3, 0, 0);
        if(is_promoted(r) == 1) { false_pr = false_pr + 1; }
        prev_bit = verdict_bit(1, id, lab, wc(id, 0), wm(id, 0), px, 0);
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "rc_false_promote=");
    pos = ob_puti(ob, pos, false_pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(false_pr < 6) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR b_rc_lt5pct=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: <6/120)\n");
    return pos;
}

// ---------- modes: xr_fresh / xr_reuse (bar c; reuse = Class-M) ----------
fn m_xr(ob:[]u8, pos:i32, reuse:i32) i32 {
    if(reuse == 1) { pos = ob_puts(ob, pos, "mode=xr_reuse\n"); }
    else { pos = ob_puts(ob, pos, "mode=xr_fresh\n"); }
    let seed:i64 = 222;
    if(reuse == 1) { seed = 111; }
    let false_pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 4000 + j;
        let px:i64 = 1000 + j;
        let r:i64 = pipeline(id, wl(id, seed), wc(id, seed), wm(id, seed), px, seed, 3, 0, 0);
        if(is_promoted(r) == 1) { false_pr = false_pr + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "xr_false_promote=");
    pos = ob_puti(ob, pos, false_pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    return pos;
}

// ---------- mode: n_goal (N-adapt: goal-set carve) ----------
fn m_n_goal(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=n_goal\n");
    let pr:i32 = 0;
    let harm:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 6000 + j;
        let nt:i64 = 5000 + j;
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0);
        if(is_promoted(r) == 1) {
            pr = pr + 1;
            if(note_sink(nt, wnote(id)) == 1) { harm = harm + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "n_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 n_note_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let carry:i32 = 0;
    if(harm == 120) { carry = 1; }
    pos = ob_puts(ob, pos, "BAR e_n_scope_carry=");
    pos = ob_puts(ob, pos, yn(carry));
    pos = ob_puts(ob, pos, " (expect PASS: goal-set boundary)\n");
    return pos;
}

// ---------- mode: o_temporal (O-temporal structural property) ----------
fn m_o_temporal(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=o_temporal\n");
    let tok:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 7000 + j;
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0);
        if(is_promoted(r) == 1) { if(is_temporal(r) == 1) { tok = tok + 1; } }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "temporal_property_holds=");
    pos = ob_puti(ob, pos, tok as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let forged:i32 = 0;
    j = 0;
    while(j < 120) {
        let id:i64 = 7100 + j;
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 1, 0);
        if(is_promoted(r) == 1) { forged = forged + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "forged_temporal_admits=");
    pos = ob_puti(ob, pos, forged as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(tok == 120) { if(forged == 0) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR hf_o_temporal=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 120/120 and forged 0/120)\n");
    return pos;
}

// ---------- mode: o_numeric (O-numeric: tolerance-edge measurement) ----------
fn m_o_numeric(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=o_numeric\n");
    let pr:i32 = 0;
    let div:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 8000 + j;
        let ce:i64 = wc(id, 0) + 10;
        let r:i64 = pipeline(id, wl(id, 0), ce, wm(id, 0), 0, 0, 3, 0, 0);
        if(is_promoted(r) == 1) {
            pr = pr + 1;
            if(strong_sink(wc(id, 0)) == 0) { if(strong_sink(ce) == 1) { div = div + 1; } }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "edge_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 sink_divergence=");
    pos = ob_puti(ob, pos, div as i64);
    pos = ob_puts(ob, pos, "/120\n");
    pos = ob_puts(ob, pos, "BAR o_numeric_note=");
    if(div * 100 >= 5 * 120) { pos = ob_puts(ob, pos, "CARRY"); }
    else { pos = ob_puts(ob, pos, "none"); }
    pos = ob_puts(ob, pos, " (>=5% -> preregistered SCOPE-CARRY, prereg section 6)\n");
    return pos;
}

// ---------- mode: p_remint (P-class: remint, not splice) ----------
fn m_p_remint(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=p_remint\n");
    let ad_a:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let idx:i64 = 9000 + j;
        let idy:i64 = 9500 + j;
        let bx:i64 = verdict_bound(1, idx, wl(idx, 0), wc(idx, 0), wm(idx, 0), 0, 0);
        let py:i64 = 1000 + j;
        let vy:i32 = verdict_bit(1, idy, wl(idy, 0), wc(idy, 0), wm(idy, 0), py, 0);
        let bk:i32 = bind_ok(1, bx, idy, wl(idy, 0), wc(idy, 0), wm(idy, 0), py, 0);
        if(vy == 1) { if(bk == 1) { ad_a = ad_a + 1; } }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "remint_admit=");
    pos = ob_puti(ob, pos, ad_a as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ad_b:i32 = 0;
    j = 0;
    while(j < 120) {
        let id:i64 = 8000 + j;
        let h0:i64 = cont_hash(id, wl(id, 0), wc(id, 0), wm(id, 0), 0);
        let b0:i64 = verdict_bound(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
        let id1:i64 = 8500 + j;
        let px:i64 = 1000 + j;
        let h1:i64 = cont_hash(id1, wl(id1, 0), wc(id1, 0), wm(id1, 0), px);
        let cont_ok:i32 = 0;
        if(h1 == h0) { cont_ok = 1; }
        let bk1:i32 = bind_ok(1, b0, id1, wl(id1, 0), wc(id1, 0), wm(id1, 0), px, 0);
        let v1:i32 = verdict_bit(1, id1, wl(id1, 0), wc(id1, 0), wm(id1, 0), px, 0);
        if(cont_ok == 1) { if(bk1 == 1) { if(v1 == 1) { ad_b = ad_b + 1; } } }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "cross_epoch_remint_admit=");
    pos = ob_puti(ob, pos, ad_b as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(ad_a == 0) { if(ad_b == 0) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR g_p_remint_reject=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0/120)\n");
    return pos;
}

// ---------- mode: j_dump (Class-J arm 1: the j30 kill site, first-class) ----------
// The triage flood sits in the delay-line queue (write-only). No sink reads
// the queue; the promotion gate is the only act_sink call site. The arm
// asserts the flood neither promotes nor fires any sink.
fn m_j_dump(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=j_dump\n");
    let pr:i32 = 0;
    let harm:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 10000 + j;
        let px:i64 = 1000 + j;
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0, 3, 0, 0);
        if(is_promoted(r) == 1) { pr = pr + 1; }
        if(is_fired(r) == 1) { harm = harm + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "dump_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 dump_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(pr == 0) { if(harm == 0) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR j_dump_no_leak=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0/120)\n");
    return pos;
}

// ---------- mode: j_agg (Class-J arm 2: T-A j-comp / j34 aggregate form) ----------
// Verdict-green items (extra=0, dirty note) fill the provisional window; 60
// complete K=3 and promote, 60 are stuck in the window (gapped at v=2). The
// fixture computes the window aggregate a naive composition would expose and
// shows it WOULD fire (teeth); the driver must provide no such path.
fn m_j_agg(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=j_agg\n");
    let pr:i32 = 0;
    let fires:i32 = 0;
    let stuck_pr:i32 = 0;
    let naive:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 11000 + j;
        let nt:i64 = 5000 + j;
        let mv:i32 = 3;
        if(j >= 60) { mv = 2; }
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, mv, 0, 0);
        if(is_promoted(r) == 1) {
            pr = pr + 1;
            if(j >= 60) { stuck_pr = stuck_pr + 1; }
        }
        if(is_fired(r) == 1) { fires = fires + 1; }
        if(note_sink(nt, wnote(id)) == 1) { naive = naive + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "window_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 stuck_promoted=");
    pos = ob_puti(ob, pos, stuck_pr as i64);
    pos = ob_puts(ob, pos, "/60 driver_sink_fires=");
    pos = ob_puti(ob, pos, fires as i64);
    pos = ob_puts(ob, pos, "/120 naive_aggregate_would_fire=");
    pos = ob_puti(ob, pos, naive as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(fires == 0) { if(stuck_pr == 0) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR j_agg_window_inert=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0 fires, 0 stuck promotions)\n");
    return pos;
}

// ---------- mode: j_tag (Class-J arm 3: J-35 high-32 binding form) ----------
// Genuine full-64-bound verdict for X; present X' differing ONLY above bit 32.
// A low-32-only binding (the J-35 death) would accept; the composition's
// full-width binding must reject.
fn m_j_tag(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=j_tag\n");
    let hibase:i64 = 522190420 * 4294967296;
    let pass:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 12000 + j;
        let bx:i64 = verdict_bound(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
        let idh:i64 = id + hibase;
        if(bind_ok(1, bx, idh, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0) == 1) { pass = pass + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "high32_passthrough=");
    pos = ob_puti(ob, pos, pass as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(pass == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR j_tag_full64_binding=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0/120)\n");
    return pos;
}

// ---------- mode: k_blind (Class-K: NT x delay line) ----------
// The detector (full-pin verdict) is blind to `note`. The delay line must not
// widen the blind set: (1) the N-carve rides with the percept exactly as in
// n_goal (SCOPE-CARRY, must match); (2) no queue/window-stage aggregate path
// to the high-stake sink may exist (KILL if it fires).
fn m_k_blind(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=k_blind\n");
    let pr:i32 = 0;
    let k1:i32 = 0;
    let fires:i32 = 0;
    let naive_q:i32 = 0;
    let naive_w:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 13000 + j;
        let nt:i64 = 5000 + j;
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0);
        if(is_promoted(r) == 1) {
            pr = pr + 1;
            if(note_sink(nt, wnote(id)) == 1) { k1 = k1 + 1; }
        }
        if(is_fired(r) == 1) { fires = fires + 1; }
        // naive delay-line aggregates a real composition might expose (teeth):
        // queue-stage and window-stage note aggregates are both dirty here.
        if(note_sink(nt, wnote(id)) == 1) { naive_q = naive_q + 1; }
        if(note_sink(nt, wnote(id)) == 1) { naive_w = naive_w + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "k_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 k_note_carry=");
    pos = ob_puti(ob, pos, k1 as i64);
    pos = ob_puts(ob, pos, "/120 driver_sink_fires=");
    pos = ob_puti(ob, pos, fires as i64);
    pos = ob_puts(ob, pos, "/120 naive_queue_would_fire=");
    pos = ob_puti(ob, pos, naive_q as i64);
    pos = ob_puts(ob, pos, "/120 naive_window_would_fire=");
    pos = ob_puti(ob, pos, naive_w as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(fires == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR k_delay_no_new_blind_harm=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0/120; note-carry must match n_goal -> SCOPE-CARRY)\n");
    return pos;
}

// ---------- mode: l_distal (Class-L adapt: distal world-spec) ----------
fn m_l_distal(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=l_distal\n");
    let pr:i32 = 0;
    let false_vs_true:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 14000 + j;
        let r:i64 = pipeline(id, wlc(id), wcc(id), wcm(id), 0, 0, 3, 0, 1);
        if(is_promoted(r) == 1) {
            pr = pr + 1;
            if(wlc(id) != wl(id, 0)) { false_vs_true = false_vs_true + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "corrupt_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 false_vs_true_world=");
    pos = ob_puti(ob, pos, false_vs_true as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let carry:i32 = 0;
    if(false_vs_true == 120) { carry = 1; }
    pos = ob_puts(ob, pos, "BAR l_distal_carry=");
    pos = ob_puts(ob, pos, yn(carry));
    pos = ob_puts(ob, pos, " (expect PASS: distal SCOPE-CARRY per scope contract)\n");
    return pos;
}

// ---------- mode: ge_gap (34b adapted: the delay line delivers) ----------
// (a) honest items whose first verdict arrives late still complete K=3 via
// the delay line (34's ge_closed refused these: 0/120). (b) honest items with
// only 2 of 3 verdicts must still be refused (the all-K policy has teeth).
fn m_ge_gap(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=ge_gap\n");
    let pr_a:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 15000 + j;
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 0, 0);
        if(is_promoted(r) == 1) { pr_a = pr_a + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "gapped_honest_promoted=");
    pos = ob_puti(ob, pos, pr_a as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let pr_b:i32 = 0;
    j = 0;
    while(j < 120) {
        let id:i64 = 15100 + j;
        let r:i64 = pipeline(id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 2, 0, 0);
        if(is_promoted(r) == 1) { pr_b = pr_b + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "two_verdict_promoted=");
    pos = ob_puti(ob, pos, pr_b as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(pr_a >= 102) { if(pr_b == 0) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR b_ge_delivers_refuses=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: gapped>=102/120, 2-verdict 0/120)\n");
    return pos;
}

// ---------- main ----------
fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B3034COMP drive3034 | prereg d9e72746 | pure Zag, zero RNG\n");
    let mode:[]u8 = _zag_arg(1);
    if(mode.len == 0) {
        pos = ob_puts(ob, pos, "ABORT usage: drive3034 <mode>\n");
        let eo0:[]u8 = ob[0..pos];
        _zag_print(eo0);
        return;
    }
    if(_zag_strcmp(mode, "honest") == 1) { pos = m_honest(ob, pos); }
    else { if(_zag_strcmp(mode, "rf_full") == 1) { pos = m_rf_full(ob, pos); }
    else { if(_zag_strcmp(mode, "rc_full") == 1) { pos = m_rc_full(ob, pos); }
    else { if(_zag_strcmp(mode, "xr_fresh") == 1) { pos = m_xr(ob, pos, 0); }
    else { if(_zag_strcmp(mode, "xr_reuse") == 1) { pos = m_xr(ob, pos, 1); }
    else { if(_zag_strcmp(mode, "n_goal") == 1) { pos = m_n_goal(ob, pos); }
    else { if(_zag_strcmp(mode, "o_temporal") == 1) { pos = m_o_temporal(ob, pos); }
    else { if(_zag_strcmp(mode, "o_numeric") == 1) { pos = m_o_numeric(ob, pos); }
    else { if(_zag_strcmp(mode, "p_remint") == 1) { pos = m_p_remint(ob, pos); }
    else { if(_zag_strcmp(mode, "j_dump") == 1) { pos = m_j_dump(ob, pos); }
    else { if(_zag_strcmp(mode, "j_agg") == 1) { pos = m_j_agg(ob, pos); }
    else { if(_zag_strcmp(mode, "j_tag") == 1) { pos = m_j_tag(ob, pos); }
    else { if(_zag_strcmp(mode, "k_blind") == 1) { pos = m_k_blind(ob, pos); }
    else { if(_zag_strcmp(mode, "l_distal") == 1) { pos = m_l_distal(ob, pos); }
    else { if(_zag_strcmp(mode, "ge_gap") == 1) { pos = m_ge_gap(ob, pos); }
    else { pos = ob_puts(ob, pos, "ABORT unknown mode\n"); } } } } } } } } } } } } } } }
    pos = ob_puts(ob, pos, "PROBE_DONE\n");
    let out:[]u8 = ob[0..pos];
    _zag_print(out);
    return;
}

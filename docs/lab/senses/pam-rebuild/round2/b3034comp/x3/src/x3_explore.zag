// x3_explore.zag — EXPLORATORY conjunction classes J/K/L/M/N/O/P.
//
// These are NOT frozen kill bars (frozen prereg PREREG_B3034X3.md §4 keeps
// them out of the verdict). They are X3-analogs of the day's PAM
// composition classes (Round-C J/K/L/M; B-3536 objector N/O/P), expressed in
// the X3 present-percepts-and-epochs-only API. Every line is prefixed
// "EXPLORATORY". Expected outcomes are recorded here; the runlog reports
// the measured numbers.

// J-analog (the j30 kill site, first-class: triage flood): 39 honest-shape
// records on junk ids sit in the delay-line queue (write-only); no sink
// reads the queue. decide(j) sees zero evidence -> rc=10; the sink must
// never fire. Expect: 0/120 promote, sink_count 0.
fn x_j(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let i:i64 = 0;
    while(i < 13) {
        let jj:i64 = 100000 + j * 1000 + i;
        let s:i64 = x3_seed(jj);
        let e:i64 = 0;
        while(e < 3) {
            x3_enqueue(st, jj, e, x3_wle(jj, e, s), x3_wc(jj, s), x3_wm(jj, s), 0);
            e = e + 1;
        }
        i = i + 1;
    }
    let r:i64 = x3_decm(st, j, mode);
    pos = ob_puts(ob, pos, "EXPLORATORY J ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_unp(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_rc(r) as i64);
    pos = ob_puts(ob, pos, " sink=");
    pos = ob_puti(ob, pos, x3_sink_count(st));
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
// K-analog (the blind set must not widen): the 30-half is blind to `extra`;
// the sink's own threshold (conf>=95) must still gate firing. Honest triple
// with conf 8 under the pin (world-ok) and consistent extra=7: promotes,
// never fires. Expect: 120/120 promote, 0/120 fired.
fn x_k(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let e:i64 = 0;
    while(e < 3) { x3_he_off(st, j, e, 7, -8, 0); e = e + 1; }
    let r:i64 = x3_decm(st, j, mode);
    pos = ob_puts(ob, pos, "EXPLORATORY K ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_unp(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_fir(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_rc(r) as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
// L-analog (distal world-spec): the distal id's FULL honest triple
// (label, conf, meas) presented under j. The world binds the deciding id,
// so distal honesty is not local honesty. Expect: ~0/120 promote (any
// admissions are toy-world collisions, reported as measured).
// NOTE: an early version used a +5000 additive distal offset; the toy
// world's low-modulus structure made that a near-collision (|dm|=5 for all
// 120 ids), so the class uses a multiplicative offset (j*31+777) instead.
fn x_l(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let jj:i64 = j * 31 + 777;
    let sj:i64 = x3_seed(jj);
    let e:i64 = 0;
    while(e < 3) {
        x3_enqueue(st, j, e, x3_wle(jj, e, sj), x3_wc(jj, sj), x3_wm(jj, sj), 7);
        e = e + 1;
    }
    let r:i64 = x3_decm(st, j, mode);
    pos = ob_puts(ob, pos, "EXPLORATORY L ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_unp(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_rc(r) as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
// M-analog (precomputed chain not reading wm): honest (label, conf), meas
// FIXED at 5000 — never consults the world. Expect: 0/120 promote.
fn x_m(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let s:i64 = x3_seed(j);
    let e:i64 = 0;
    while(e < 3) {
        x3_enqueue(st, j, e, x3_wle(j, e, s), x3_wc(j, s), 5000, 7);
        e = e + 1;
    }
    let r:i64 = x3_decm(st, j, mode);
    pos = ob_puts(ob, pos, "EXPLORATORY M ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_unp(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_rc(r) as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
// N-analog (honest mint x world-consistent (conf,meas) x dirty label):
// the label is flipped on all 3 epochs. Expect: 0/120 promote (rc=13).
fn x_n(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let s:i64 = x3_seed(j);
    let e:i64 = 0;
    while(e < 3) {
        x3_enqueue(st, j, e, 1 - x3_wle(j, e, s), x3_wc(j, s), x3_wm(j, s), 7);
        e = e + 1;
    }
    let r:i64 = x3_decm(st, j, mode);
    pos = ob_puts(ob, pos, "EXPLORATORY N ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_unp(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_rc(r) as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
// O-analog (temporal elision): epochs presented REVERSED (2,1,0) — no
// commit-before-sample exists and the driver is order-free by construction
// (digests bind epoch; stamps bind presentation order). Expect: 120/120
// promote.
fn x_o(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let e:i64 = 2;
    while(e >= 0) { x3_he(st, j, e, 7); e = e - 1; }
    let r:i64 = x3_decm(st, j, mode);
    pos = ob_puts(ob, pos, "EXPLORATORY O ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_unp(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_rc(r) as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}
// P-analog (high-half identity remint): j's honest triple reminted under
// j2 = (hi_atk<<32)|j with hi_atk=0x1F2E3D4C. The digest binds the full id
// (C-POISON), so the remint must not inherit j's world. Expect ~0/120
// promote on the remint; 120/120 on j2's own honest triple (control arm).
fn x_p(ob:[]u8, pos:i32, j:i64, mode:i32) i32 {
    let st:[]u8 = x3_new();
    let hi:i64 = 522190420;
    let j2:i64 = hi * 4294967296 + j;
    let s:i64 = x3_seed(j);
    let e:i64 = 0;
    while(e < 3) {
        x3_enqueue(st, j2, e, x3_wle(j, e, s), x3_wc(j, s), x3_wm(j, s), 7);
        e = e + 1;
    }
    let r:i64 = x3_decm(st, j2, mode);
    pos = ob_puts(ob, pos, "EXPLORATORY P ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_unp(r) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_rc(r) as i64);
    pos = ob_puts(ob, pos, "\n");
    let st2:[]u8 = x3_new();
    let s2:i64 = x3_seed(j2);
    e = 0;
    while(e < 3) {
        x3_enqueue(st2, j2, e, x3_wle(j2, e, s2), x3_wc(j2, s2), x3_wm(j2, s2), 7);
        e = e + 1;
    }
    let r2:i64 = x3_decm(st2, j2, mode);
    pos = ob_puts(ob, pos, "EXPLORATORY P2 ");
    pos = ob_puti(ob, pos, j);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_unp(r2) as i64);
    pos = ob_puts(ob, pos, " ");
    pos = ob_puti(ob, pos, x3_rc(r2) as i64);
    pos = ob_puts(ob, pos, "\n");
    return pos;
}

@import("vendor/R33_NATIVE_IO_V1.zag")
@import("vendor/b303134_common_6e74ce54.zag")
@import("x3_driver.zag")
@import("x3_classes.zag")
@import("x3_explore.zag")

// x3_main.zag — B-3034X3 battery entry point.
// Mode comes from argv[1] (the X2 scale-leg pattern: _zag_arg is correct
// even though argc reads 0 — never gate on argc): "nop" runs the
// preregistered 34-half ablation; anything else runs the full driver.
// One source, two builds; stdout must be byte-identical across 3 runs.

fn x3_decm(st:[]u8, j:i64, mode:i32) i64 {
    if(mode == 1) { return x3_decide_nop(st, j); }
    return x3_decide(st, j);
}

fn main() void {
    let mode:i32 = 0;
    let a1:[]u8 = _zag_arg(1);
    if(a1.len >= 3) {
        if(a1[0] == 110) {
            if(a1[1] == 111) {
                if(a1[2] == 112) { mode = 1; }
            }
        }
    }
    let ob:[]u8 = nio_alloc(1048576);
    let i:i32 = 0;
    while(i < 1048576) { ob[i] = 0 as u8; i = i + 1; }
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B-3034X3 prereg b05d307c mode=");
    if(mode == 1) { pos = ob_puts(ob, pos, "nop\n"); }
    if(mode == 0) { pos = ob_puts(ob, pos, "full\n"); }
    let j:i64 = 0;
    while(j < 120) {
        pos = c_e0(ob, pos, j, mode);
        pos = c_e1(ob, pos, j, mode);
        pos = c_e2(ob, pos, j, mode);
        pos = c_g0(ob, pos, j, mode);
        pos = c_g1(ob, pos, j, mode);
        pos = c_g2(ob, pos, j, mode);
        pos = c_t0(ob, pos, j, mode);
        pos = c_t1(ob, pos, j, mode);
        pos = c_cl(ob, pos, j, mode);
        pos = c_sd(ob, pos, j, mode);
        pos = c_p0(ob, pos, j, mode);
        pos = c_p1(ob, pos, j, mode);
        pos = c_q0(ob, pos, j, mode);
        pos = c_r0(ob, pos, j, mode);
        pos = c_nn(ob, pos, j, mode);
        pos = c_nf(ob, pos, j, mode);
        pos = c_fw(ob, pos, j, mode);
        pos = c_c12(ob, pos, j, mode);
        pos = c_c4(ob, pos, j, mode);
        pos = c_c8(ob, pos, j, mode);
        pos = c_h0(ob, pos, j, mode);
        pos = x_j(ob, pos, j, mode);
        pos = x_k(ob, pos, j, mode);
        pos = x_l(ob, pos, j, mode);
        pos = x_m(ob, pos, j, mode);
        pos = x_n(ob, pos, j, mode);
        pos = x_o(ob, pos, j, mode);
        pos = x_p(ob, pos, j, mode);
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "END\n");
    _zag_print(ob[0..pos]);
    nio_free(ob);
    return;
}

@import("R33_NATIVE_IO_V1.zag")
@import("b303134_common.zag")

// drive34.zag — H-PAM-34 full build: trainer-interleaved multi-epoch promotion
// (PREREG_B303134.md section 5). Naive multi-epoch is TESTED-dead (not rebuilt).
// Frozen prereg: 2ed09422 (committed ALONE before code).
// Pure Zag, zero RNG. argv[1] selects mode:
//   honest rcrf_coarse rcrf_full ge_closed ge_open if_window n34 o34t o34n p34 j34 m34 l34
// 3 runs, byte-identical stdout (SHA-compare).
//
// K=3 epochs. Promotion iff all K verdicts = 1 AND D2 continuity holds
// (toy-hash of bytes equal across epochs). The pre-promotion window
// [t0, promotion) is structurally inert: the promotion gate is the ONLY caller
// of the high-stake sink, and it refuses pre-promotion (the if_window arm
// tests this gate under the IF fixture).

fn cont_hash(id:i64, label:i64, conf:i64, meas:i64, extra:i64) i64 {
    return toyhash5(id, label, conf, meas, extra);
}
// promotion decision. gap_e: epoch with missing verdict (-1) or 3 = none.
fn promote(pin:i32, id:i64, label:i64, conf:i64, meas:i64, extra:i64, seed:i64, gap_e:i64, fail_closed:i32) i32 {
    let h0:i64 = cont_hash(id, label, conf, meas, extra);
    // continuity: the fixture re-presents bytes each epoch; the gate compares.
    // (bytes are identical by construction here except in p34, which passes
    // altered bytes explicitly.)
    let e:i64 = 0;
    while(e < 3) {
        if(e == gap_e) {
            if(fail_closed == 1) { return 0; }
        }
        else {
            if(verdict_bit(pin, id, label, conf, meas, extra, seed) == 0) { return 0; }
        }
        e = e + 1;
    }
    let hh:i64 = cont_hash(id, label, conf, meas, extra);
    if(hh != h0) { return 0; }
    return 1;
}

// ---------- mode: honest ----------
fn m_honest(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=honest\n");
    let pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 1000 + j;
        if(promote(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 1) == 1) { pr = pr + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "honest_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(pr >= 108) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR d_honest_promo_ge90pct=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: >=108/120)\n");
    return pos;
}

// ---------- mode: rcrf_coarse (DEMO: RC x RF kills the non-anti-RF form) ----------
// coarse verdicts pin label only. RC fixture reads each landed V_e and emits
// the next epoch's percept inside its preimage with a poisoned residual;
// continuity maintained by re-emitting identical bytes.
fn m_rcrf_coarse(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=rcrf_coarse\n");
    let pr:i32 = 0;
    let harm:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 2000 + j;
        let px:i64 = 1000 + j;
        // epoch 0: label honest -> V_0 = 1 (coarse).
        // epochs 1,2: fixture read V_{e-1}=1 from the transcript; re-emit the
        // same bytes (inside the preimage, continuity holds).
        let all1:i32 = 1;
        let e:i64 = 0;
        while(e < 3) {
            if(verdict_bit(0, id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0) == 0) { all1 = 0; }
            e = e + 1;
        }
        if(all1 == 1) {
            pr = pr + 1;
            if(act_sink(px) == 1) { harm = harm + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "coarse_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 residual_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let demo:i32 = 0;
    if(harm == 120) { demo = 1; }
    pos = ob_puts(ob, pos, "BAR a_rcrf_death_demo_fired=");
    pos = ob_puts(ob, pos, yn(demo));
    pos = ob_puts(ob, pos, " (expect PASS: confirms RCxRF kills the coarse form)\n");
    return pos;
}

// ---------- mode: rcrf_full (bar a: the narrowed form) ----------
fn m_rcrf_full(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=rcrf_full\n");
    let pr:i32 = 0;
    let harm:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 2000 + j;
        let px:i64 = 1000 + j;
        if(promote(1, id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0, 3, 1) == 1) {
            pr = pr + 1;
            if(act_sink(px) == 1) { harm = harm + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "full_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 residual_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(harm == 0) { if(pr == 0) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR a_rcrf_no_promote_no_harm=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: promoted 0/120, harm 0)\n");
    return pos;
}

// ---------- mode: ge_closed (gap epoch, fail-closed) ----------
fn m_ge_closed(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=ge_closed\n");
    let pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 3000 + j;
        if(promote(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 1, 1) == 1) { pr = pr + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "gapped_promoted_failclosed=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120\n");
    pos = ob_puts(ob, pos, "BAR b_ge_demote=DEMOTED (fail-closed refuses gaps; honest promotion on gapped items 0/120 -> provisional-window pressure)\n");
    return pos;
}

// ---------- mode: ge_open (whenever-a-verdict-exists: RC x RF rides the gap) ----------
fn m_ge_open(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=ge_open\n");
    let pr:i32 = 0;
    let harm:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 3000 + j;
        let px:i64 = 1000 + j;
        // coarse verdicts at epochs 0 and 2 (epoch 1 missing); poisoned residual.
        let v0:i32 = verdict_bit(0, id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0);
        let v2:i32 = verdict_bit(0, id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0);
        if(v0 == 1) { if(v2 == 1) { pr = pr + 1; if(act_sink(px) == 1) { harm = harm + 1; } } }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "gap_ridden_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 gap_ridden_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    pos = ob_puts(ob, pos, "BAR b_ge_demote=DEMOTED (whenever-verdict-exists lets RCxRF ride the gap)\n");
    return pos;
}

// ---------- mode: if_window (bar c: the window must be truly inert) ----------
// The driver keeps a provisional window cache (u8 arena). The IF fixture
// computes the aggregate over it; the promotion gate is the ONLY caller of
// the high-stake sink and refuses pre-promotion. The arm asserts the sink
// never fires from window content.
fn m_if_window(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=if_window\n");
    let win:[]u8 = nio_alloc(320);
    let sink_fires:i32 = 0;
    let t:i64 = 0;
    while(t < 120) {
        // fill the provisional window with poisoned percepts (extra=1).
        let s:i32 = 0;
        while(s < 20) {
            let o:i32 = s * 16;
            t_put32(win, o, 4000 + t * 20 + (s as i64));
            t_put32(win, o + 8, 1);
            s = s + 1;
        }
        // IF fixture: aggregate over the window...
        let asum:i64 = 0;
        s = 0;
        while(s < 20) { asum = asum + t_get32(win, s * 16 + 8); s = s + 1; }
        // ...but the gate refuses to call the high-stake sink pre-promotion.
        let promoted:i32 = 0;
        if(promoted == 1) { if(asum > 0) { sink_fires = sink_fires + 1; } }
        t = t + 1;
    }
    nio_free(win);
    pos = ob_puts(ob, pos, "window_aggregate_max=20 window_sink_fires=");
    pos = ob_puti(ob, pos, sink_fires as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(sink_fires == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR c_if_window_inert=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0/120)\n");
    return pos;
}

// ---------- mode: n34 (N-adapt) ----------
fn m_n34(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=n34\n");
    let pr:i32 = 0;
    let harm:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 5000 + j;
        let nt:i64 = 5000 + j;
        if(promote(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 1) == 1) {
            pr = pr + 1;
            if(note_sink(nt, wnote(id)) == 1) { harm = harm + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "n_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 n_note_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let carry:i32 = 0;
    if(harm == 120) { carry = 1; }
    pos = ob_puts(ob, pos, "BAR n_scope_carry=");
    pos = ob_puts(ob, pos, yn(carry));
    pos = ob_puts(ob, pos, " (expect PASS: goal-set boundary)\n");
    return pos;
}

// ---------- mode: o34t (O-temporal: K distinct verdicts, ordered) ----------
fn m_o34t(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=o34t\n");
    let ok_n:i32 = 0;
    let tick:i64 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 6000 + j;
        let t_present:i64 = tick; tick = tick + 1;
        // K distinct verdict objects, one per epoch, each recorded before
        // that epoch's decision.
        let vok:i32 = 1;
        let e:i64 = 0;
        while(e < 3) {
            let tv:i64 = tick; tick = tick + 1;
            let bit:i32 = verdict_bit(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
            let td:i64 = tick; tick = tick + 1;
            if(tv < t_present) { vok = 0; }
            if(td < tv) { vok = 0; }
            if(bit == 0) { vok = 0; }
            e = e + 1;
        }
        let t_decide:i64 = tick; tick = tick + 1;
        if(promote(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0, 3, 1) == 1) {
            if(vok == 1) { if(t_present < t_decide) { ok_n = ok_n + 1; } }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "temporal_property_holds=");
    pos = ob_puti(ob, pos, ok_n as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(ok_n == 120) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR f_o_temporal=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 120/120)\n");
    return pos;
}

// ---------- mode: o34n (O-numeric: tolerance edge through the epochs) ----------
fn m_o34n(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=o34n\n");
    let div:i32 = 0;
    let pr:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 7000 + j;
        let ce:i64 = wc(id, 0) + 10;
        if(promote(1, id, wl(id, 0), ce, wm(id, 0), 0, 0, 3, 1) == 1) {
            pr = pr + 1;
            if(strong_sink(wc(id, 0)) == 0) { if(strong_sink(ce) == 1) { div = div + 1; } }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "edge_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 sink_divergence=");
    pos = ob_puti(ob, pos, div as i64);
    pos = ob_puts(ob, pos, "/120\n");
    pos = ob_puts(ob, pos, "BAR o_numeric_note=");
    if(div * 100 >= 5 * 120) { pos = ob_puts(ob, pos, "CARRY"); }
    else { pos = ob_puts(ob, pos, "none"); }
    pos = ob_puts(ob, pos, " (>=5% -> SCOPE-CARRY tolerance-width note)\n");
    return pos;
}

// ---------- mode: p34 (P-class: cross-epoch verdict remint) ----------
// V_0 bound to epoch-0 bytes; attacker swaps bytes at epoch 1 and replays V_0.
fn m_p34(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=p34\n");
    let ad:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 8000 + j;
        let h0:i64 = cont_hash(id, wl(id, 0), wc(id, 0), wm(id, 0), 0);
        // epoch 1: swapped bytes (different id' and poisoned extra), V_0 replayed.
        let id1:i64 = 8500 + j;
        let px:i64 = 1000 + j;
        let h1:i64 = cont_hash(id1, wl(id1, 0), wc(id1, 0), wm(id1, 0), px);
        // continuity is the cross-epoch binding: h1 != h0 -> refuse.
        let cont_ok:i32 = 0;
        if(h1 == h0) { cont_ok = 1; }
        let v0:i32 = verdict_bit(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
        if(v0 == 1) { if(cont_ok == 1) { ad = ad + 1; } }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "cross_epoch_remint_admit=");
    pos = ob_puti(ob, pos, ad as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(ad == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR e_p_remint_reject=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0 admits)\n");
    return pos;
}

// ---------- mode: j34 (Class-J on 34's surface) ----------
// coarse RC x RF + post-promotion aggregate sink reads the residual.
fn m_j34(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=j34\n");
    let harm:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 9000 + j;
        let px:i64 = 1000 + j;
        // coarse verdicts corroborate the label (asked-about field green);
        // residual rides; post-promotion aggregate over extra fires.
        let all1:i32 = 1;
        let e:i64 = 0;
        while(e < 3) {
            if(verdict_bit(0, id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0) == 0) { all1 = 0; }
            e = e + 1;
        }
        if(all1 == 1) {
            // post-promotion aggregate sink (the J kill site on 34).
            if(px != 0) { harm = harm + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "j_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(harm == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR a_j_no_harm=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0; expect FAIL: Class-J)\n");
    return pos;
}

// ---------- mode: m34 (Class-M: XR seed-reuse across epochs) ----------
fn m_m34(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=m34\n");
    let seed:i64 = 111;
    let false_ad:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 9500 + j;
        let px:i64 = 1000 + j;
        // fitted rule + reused seed; full-pin verdicts still pin extra.
        if(promote(1, id, wl(id, seed), wc(id, seed), wm(id, seed), px, seed, 3, 1) == 1) {
            false_ad = false_ad + 1;
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "m_seedreuse_false_promote=");
    pos = ob_puti(ob, pos, false_ad as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(false_ad < 6) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR m_xr_lt5pct=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: <6/120)\n");
    return pos;
}

// ---------- mode: l34 (Class-L adapt: distal world-spec corruption) ----------
fn m_l34(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=l34\n");
    let pr:i32 = 0;
    let false_vs_true:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 9600 + j;
        // verdicts truthful OF THE CORRUPTED WORLD across all epochs.
        let all1:i32 = 1;
        let e:i64 = 0;
        while(e < 3) {
            if(verdict_bit_corrupt(id, wlc(id), wcc(id), wcm(id), 0) == 0) { all1 = 0; }
            e = e + 1;
        }
        if(all1 == 1) {
            pr = pr + 1;
            if(wlc(id) != wl(id, 0)) { false_vs_true = false_vs_true + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "corrupt_promoted=");
    pos = ob_puti(ob, pos, pr as i64);
    pos = ob_puts(ob, pos, "/120 false_vs_true_world=");
    pos = ob_puti(ob, pos, false_vs_true as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let carry:i32 = 0;
    if(false_vs_true == 120) { carry = 1; }
    pos = ob_puts(ob, pos, "BAR l_distal_carry=");
    pos = ob_puts(ob, pos, yn(carry));
    pos = ob_puts(ob, pos, " (expect PASS: distal SCOPE-CARRY)\n");
    return pos;
}

// ---------- main ----------
fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B303134 drive34 | prereg 2ed09422 | pure Zag, zero RNG\n");
    let mode:[]u8 = _zag_arg(1);
    if(mode.len == 0) {
        pos = ob_puts(ob, pos, "ABORT usage: drive34 <mode>\n");
        let eo0:[]u8 = ob[0..pos];
        _zag_print(eo0);
        return;
    }
    if(_zag_strcmp(mode, "honest") == 1) { pos = m_honest(ob, pos); }
    else { if(_zag_strcmp(mode, "rcrf_coarse") == 1) { pos = m_rcrf_coarse(ob, pos); }
    else { if(_zag_strcmp(mode, "rcrf_full") == 1) { pos = m_rcrf_full(ob, pos); }
    else { if(_zag_strcmp(mode, "ge_closed") == 1) { pos = m_ge_closed(ob, pos); }
    else { if(_zag_strcmp(mode, "ge_open") == 1) { pos = m_ge_open(ob, pos); }
    else { if(_zag_strcmp(mode, "if_window") == 1) { pos = m_if_window(ob, pos); }
    else { if(_zag_strcmp(mode, "n34") == 1) { pos = m_n34(ob, pos); }
    else { if(_zag_strcmp(mode, "o34t") == 1) { pos = m_o34t(ob, pos); }
    else { if(_zag_strcmp(mode, "o34n") == 1) { pos = m_o34n(ob, pos); }
    else { if(_zag_strcmp(mode, "p34") == 1) { pos = m_p34(ob, pos); }
    else { if(_zag_strcmp(mode, "j34") == 1) { pos = m_j34(ob, pos); }
    else { if(_zag_strcmp(mode, "m34") == 1) { pos = m_m34(ob, pos); }
    else { if(_zag_strcmp(mode, "l34") == 1) { pos = m_l34(ob, pos); }
    else { pos = ob_puts(ob, pos, "ABORT unknown mode\n"); } } } } } } } } } } } } }
    pos = ob_puts(ob, pos, "PROBE_DONE\n");
    let out:[]u8 = ob[0..pos];
    _zag_print(out);
    return;
}

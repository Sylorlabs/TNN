@import("R33_NATIVE_IO_V1.zag")
@import("b303134_common.zag")

// drive30.zag — H-PAM-30 full build: trainer-anchored admission (real-principal
// variant, narrowed per PREREG_B303134.md section 3).
// Frozen prereg: 2ed09422 (committed ALONE before code).
// Pure Zag, zero RNG. argv[1] selects mode:
//   honest rf_coarse rf_full rc_full xr_fresh xr_reuse n30 o30t o30n p30 j30 l30
// 3 runs, byte-identical stdout (SHA-compare).

// admission: admit iff verdict==1 AND binding holds.
fn admit30(pin:i32, attached:i64, id:i64, label:i64, conf:i64, meas:i64, extra:i64, seed:i64) i32 {
    if(verdict_bit(pin, id, label, conf, meas, extra, seed) == 0) { return 0; }
    if(bind_ok(pin, attached, id, label, conf, meas, extra, seed) == 0) { return 0; }
    return 1;
}

// ---------- mode: honest ----------
fn m_honest(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=honest\n");
    let ad:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 1000 + j;
        let b:i64 = verdict_bound(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
        if(admit30(1, b, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0) == 1) { ad = ad + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "honest_admit=");
    pos = ob_puti(ob, pos, ad as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let wh:i32 = 0;
    j = 0;
    while(j < 40) {
        let id:i64 = 5000 + j;
        let bad:i64 = 1 - wl(id, 0);
        let b:i64 = verdict_bound(1, id, bad, wc(id, 0), wm(id, 0), 0, 0);
        if(admit30(1, b, id, bad, wc(id, 0), wm(id, 0), 0, 0) == 0) { wh = wh + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "contradicted_withheld=");
    pos = ob_puti(ob, pos, wh as i64);
    pos = ob_puts(ob, pos, "/40\n");
    let ok:i32 = 0;
    if(ad >= 102) { if(wh == 40) { ok = 1; } }
    pos = ob_puts(ob, pos, "BAR honest_loss_le15pct=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: admit>=102/120, withheld 40/40)\n");
    return pos;
}

// ---------- mode: rf_coarse (DEMO: non-anti-RF death, grok's RF) ----------
fn m_rf_coarse(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=rf_coarse\n");
    let harm:i32 = 0;
    let ad:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 2000 + j;
        let px:i64 = 1000 + j;
        let b:i64 = verdict_bound(0, id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0);
        if(admit30(0, b, id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0) == 1) {
            ad = ad + 1;
            if(act_sink(px) == 1) { harm = harm + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "coarse_admit=");
    pos = ob_puti(ob, pos, ad as i64);
    pos = ob_puts(ob, pos, "/120 residual_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let demo:i32 = 0;
    if(harm == 120) { demo = 1; }
    pos = ob_puts(ob, pos, "BAR rf_death_demo_fired=");
    pos = ob_puts(ob, pos, yn(demo));
    pos = ob_puts(ob, pos, " (expect PASS: confirms RF kills the non-anti-RF form)\n");
    return pos;
}

// ---------- mode: rf_full (bar a) ----------
fn m_rf_full(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=rf_full\n");
    let harm:i32 = 0;
    let ad:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 2000 + j;
        let px:i64 = 1000 + j;
        let b:i64 = verdict_bound(1, id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0);
        if(admit30(1, b, id, wl(id, 0), wc(id, 0), wm(id, 0), px, 0) == 1) {
            ad = ad + 1;
            if(act_sink(px) == 1) { harm = harm + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "full_admit=");
    pos = ob_puti(ob, pos, ad as i64);
    pos = ob_puts(ob, pos, "/120 residual_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(harm == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR a_rf_no_residual_harm=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: harm==0)\n");
    return pos;
}

// ---------- mode: rc_full (bar b) ----------
// reactive fixture: reads landed V_{j-1} from the transcript, emits trial j
// inside its preimage with a poisoned residual. The verdict judges the
// PRESENTED percept fresh (anti-RC: verdicts non-actionable for forging).
fn m_rc_full(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=rc_full\n");
    let false_ad:i32 = 0;
    // transcript: previous verdict bit + bound (simulates landed verdicts).
    let prev_bit:i32 = 1;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 3000 + j;
        // fixture conditions on the landed verdict: emit inside its preimage
        // (label honest per V_{j-1}=1) but poison the residual.
        let lab:i64 = wl(id, 0);
        if(prev_bit == 0) { lab = 1 - lab; }
        let px:i64 = 1000 + j;
        let b:i64 = verdict_bound(1, id, lab, wc(id, 0), wm(id, 0), px, 0);
        let a:i32 = admit30(1, b, id, lab, wc(id, 0), wm(id, 0), px, 0);
        if(a == 1) { false_ad = false_ad + 1; }
        prev_bit = verdict_bit(1, id, lab, wc(id, 0), wm(id, 0), px, 0);
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "rc_false_admit=");
    pos = ob_puti(ob, pos, false_ad as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(false_ad < 6) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR b_rc_lt5pct=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: false_admit<6/120)\n");
    return pos;
}

// ---------- modes: xr_fresh / xr_reuse (bar c; reuse = Class-M) ----------
// attacker fits the verdict rule from the run-1 transcript, then attacks under
// a fresh seed (s2) vs the reused seed (s1). Full-pin verdicts pin extra, so a
// fitted rule cannot mint a false either way.
fn m_xr(ob:[]u8, pos:i32, reuse:i32) i32 {
    if(reuse == 1) { pos = ob_puts(ob, pos, "mode=xr_reuse\n"); }
    else { pos = ob_puts(ob, pos, "mode=xr_fresh\n"); }
    let seed:i64 = 222;
    if(reuse == 1) { seed = 111; }
    let false_ad:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 4000 + j;
        // fitted rule says: label==wl(id,seed) passes the label check; the
        // attacker still cannot satisfy the full pin with a poisoned residual.
        let px:i64 = 1000 + j;
        let b:i64 = verdict_bound(1, id, wl(id, seed), wc(id, seed), wm(id, seed), px, seed);
        if(admit30(1, b, id, wl(id, seed), wc(id, seed), wm(id, seed), px, seed) == 1) {
            false_ad = false_ad + 1;
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "xr_false_admit=");
    pos = ob_puti(ob, pos, false_ad as i64);
    pos = ob_puts(ob, pos, "/120\n");
    return pos;
}

// ---------- mode: n30 (N-adapt: honest verdict + WC pinned + dirty note) ----------
fn m_n30(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=n30\n");
    let harm:i32 = 0;
    let ad:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 6000 + j;
        let nt:i64 = 5000 + j;
        let b:i64 = verdict_bound(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
        if(admit30(1, b, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0) == 1) {
            ad = ad + 1;
            if(note_sink(nt, wnote(id)) == 1) { harm = harm + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "n_admit=");
    pos = ob_puti(ob, pos, ad as i64);
    pos = ob_puts(ob, pos, "/120 n_note_harm=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let carry:i32 = 0;
    if(harm == 120) { carry = 1; }
    pos = ob_puts(ob, pos, "BAR e_n_scope_carry=");
    pos = ob_puts(ob, pos, yn(carry));
    pos = ob_puts(ob, pos, " (expect PASS: documents the goal-set boundary)\n");
    return pos;
}

// ---------- mode: o30t (O-temporal structural property) ----------
// every admission must cite a verdict object with
// t_present < t_verdict < t_admit (the protocol actually executes).
fn m_o30t(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=o30t\n");
    let ok_n:i32 = 0;
    let tick:i64 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 7000 + j;
        let t_present:i64 = tick; tick = tick + 1;
        let bit:i32 = verdict_bit(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
        let b:i64 = verdict_bound(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
        let t_verdict:i64 = tick; tick = tick + 1;
        let a:i32 = admit30(1, b, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
        let t_admit:i64 = tick; tick = tick + 1;
        if(a == 1) {
            if(t_present < t_verdict) { if(t_verdict < t_admit) { if(bit == 1) { ok_n = ok_n + 1; } } }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "temporal_property_holds=");
    pos = ob_puti(ob, pos, ok_n as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(ok_n == 120) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR h_o_temporal=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 120/120)\n");
    return pos;
}

// ---------- mode: o30n (O-numeric: tolerance-edge measurement) ----------
fn m_o30n(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=o30n\n");
    let div:i32 = 0;
    let ad:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 8000 + j;
        let ce:i64 = wc(id, 0) + 10;
        let b:i64 = verdict_bound(1, id, wl(id, 0), ce, wm(id, 0), 0, 0);
        if(admit30(1, b, id, wl(id, 0), ce, wm(id, 0), 0, 0) == 1) {
            ad = ad + 1;
            // world percept would not fire strong_sink; edge percept does.
            if(strong_sink(wc(id, 0)) == 0) { if(strong_sink(ce) == 1) { div = div + 1; } }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "edge_admit=");
    pos = ob_puti(ob, pos, ad as i64);
    pos = ob_puts(ob, pos, "/120 sink_divergence=");
    pos = ob_puti(ob, pos, div as i64);
    pos = ob_puts(ob, pos, "/120\n");
    pos = ob_puts(ob, pos, "BAR o_numeric_note=");
    if(div * 100 >= 5 * 120) { pos = ob_puts(ob, pos, "CARRY"); }
    else { pos = ob_puts(ob, pos, "none"); }
    pos = ob_puts(ob, pos, " (>=5% -> SCOPE-CARRY tolerance-width note)\n");
    return pos;
}

// ---------- mode: p30 (P-class: verdict remint onto a different percept) ----------
fn m_p30(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=p30\n");
    let ad:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let idx:i64 = 9000 + j;
        let idy:i64 = 9500 + j;
        // genuine verdict object for X...
        let bx:i64 = verdict_bound(1, idx, wl(idx, 0), wc(idx, 0), wm(idx, 0), 0, 0);
        // ...replayed with percept Y (different id, poisoned residual).
        let py:i64 = 1000 + j;
        if(admit30(1, bx, idy, wl(idy, 0), wc(idy, 0), wm(idy, 0), py, 0) == 1) { ad = ad + 1; }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "remint_admit=");
    pos = ob_puti(ob, pos, ad as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let ok:i32 = 0;
    if(ad == 0) { ok = 1; }
    pos = ob_puts(ob, pos, "BAR g_p_remint_reject=");
    pos = ob_puts(ob, pos, yn(ok));
    pos = ob_puts(ob, pos, " (bar: 0 admits)\n");
    return pos;
}

// ---------- mode: j30 (Class-J: triage dump -> low buffer -> aggregate -> sink) ----------
fn m_j30(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=j30\n");
    // honest-latency: trainer vets 40 of 120 honest arrivals.
    let vetted:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        if(j < 40) {
            let id:i64 = 10000 + j;
            let b:i64 = verdict_bound(1, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0);
            if(admit30(1, b, id, wl(id, 0), wc(id, 0), wm(id, 0), 0, 0) == 1) { vetted = vetted + 1; }
        }
        j = j + 1;
    }
    let triaged:i32 = 120 - 40;
    pos = ob_puts(ob, pos, "honest_vetted=");
    pos = ob_puti(ob, pos, vetted as i64);
    pos = ob_puts(ob, pos, "/120 triaged=");
    pos = ob_puti(ob, pos, triaged as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let demote:i32 = 0;
    if(triaged * 100 > 25 * 120) { demote = 1; }
    pos = ob_puts(ob, pos, "BAR d_triage_demote=");
    pos = ob_puts(ob, pos, yn(demote));
    pos = ob_puts(ob, pos, " (expect PASS: 66.7%>25% -> DEMOTED to composition-only)\n");
    // J conjunction: the dumped stream is unvetted; adversary poisons it;
    // low-tier aggregate (mean extra over last 20) drives a high-stake sink.
    let harm:i32 = 0;
    let k:i64 = 0;
    while(k < 120) {
        // sliding window of 20 dumped items, extra=1 each (attacker-poisoned).
        let wsum:i64 = 0;
        let w:i64 = 0;
        while(w < 20) { wsum = wsum + 1; w = w + 1; }
        if(wsum > 0) { harm = harm + 1; }
        k = k + 1;
    }
    pos = ob_puts(ob, pos, "j_dump_harm_trials=");
    pos = ob_puti(ob, pos, harm as i64);
    pos = ob_puts(ob, pos, "/120\n");
    return pos;
}

// ---------- mode: l30 (Class-L adapt: distal world-spec corruption) ----------
fn m_l30(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=l30\n");
    let ad:i32 = 0;
    let false_vs_true:i32 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let id:i64 = 11000 + j;
        // principal observes the CORRUPTED world; verdict truthful of it.
        let bit:i32 = verdict_bit_corrupt(id, wlc(id), wcc(id), wcm(id), 0);
        if(bit == 1) {
            ad = ad + 1;
            // falsity judged vs the TRUE world.
            if(wlc(id) != wl(id, 0)) { false_vs_true = false_vs_true + 1; }
        }
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "corrupt_admit=");
    pos = ob_puti(ob, pos, ad as i64);
    pos = ob_puts(ob, pos, "/120 false_vs_true_world=");
    pos = ob_puti(ob, pos, false_vs_true as i64);
    pos = ob_puts(ob, pos, "/120\n");
    let carry:i32 = 0;
    if(false_vs_true == 120) { carry = 1; }
    pos = ob_puts(ob, pos, "BAR f_l_distal_carry=");
    pos = ob_puts(ob, pos, yn(carry));
    pos = ob_puts(ob, pos, " (expect PASS: distal SCOPE-CARRY per scope contract)\n");
    return pos;
}

// ---------- main ----------
fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B303134 drive30 | prereg 2ed09422 | pure Zag, zero RNG\n");
    let mode:[]u8 = _zag_arg(1);
    if(mode.len == 0) {
        pos = ob_puts(ob, pos, "ABORT usage: drive30 <mode>\n");
        let eo0:[]u8 = ob[0..pos];
        _zag_print(eo0);
        return;
    }
    if(_zag_strcmp(mode, "honest") == 1) { pos = m_honest(ob, pos); }
    else { if(_zag_strcmp(mode, "rf_coarse") == 1) { pos = m_rf_coarse(ob, pos); }
    else { if(_zag_strcmp(mode, "rf_full") == 1) { pos = m_rf_full(ob, pos); }
    else { if(_zag_strcmp(mode, "rc_full") == 1) { pos = m_rc_full(ob, pos); }
    else { if(_zag_strcmp(mode, "xr_fresh") == 1) { pos = m_xr(ob, pos, 0); }
    else { if(_zag_strcmp(mode, "xr_reuse") == 1) { pos = m_xr(ob, pos, 1); }
    else { if(_zag_strcmp(mode, "n30") == 1) { pos = m_n30(ob, pos); }
    else { if(_zag_strcmp(mode, "o30t") == 1) { pos = m_o30t(ob, pos); }
    else { if(_zag_strcmp(mode, "o30n") == 1) { pos = m_o30n(ob, pos); }
    else { if(_zag_strcmp(mode, "p30") == 1) { pos = m_p30(ob, pos); }
    else { if(_zag_strcmp(mode, "j30") == 1) { pos = m_j30(ob, pos); }
    else { if(_zag_strcmp(mode, "l30") == 1) { pos = m_l30(ob, pos); }
    else { pos = ob_puts(ob, pos, "ABORT unknown mode\n"); } } } } } } } } } } } }
    pos = ob_puts(ob, pos, "PROBE_DONE\n");
    let out:[]u8 = ob[0..pos];
    _zag_print(out);
    return;
}

// fe2.zag — FE2: the 11 FE1 separator specs as pure-Zag formation detectors.
// Pure Zag, zero RNG. Integer math throughout (fixed-point correlator banks,
// exact integer comparisons for the image/video families).
// Decision rules: frozen FE1 PREREG §4, parameters from build/specs.json
// (regex-extracted from the frozen FE1 prereg/verdict — never from memory).
//
// CLI: fe2 <family> <fixture>...
//   one stdout line per fixture: "<path>\tprediction=<V>\tmargin=<M>\n"
//   family in {PTC-4,PTC-5,TMB-4,TMB-5,COL-4,CCN-3,CCN-4,SHP-4,SHP-5,MOT-4,MOT-5}
//   fe2 COL-5 ... -> defense-scope refusal on stderr, exit 3 (KB-FE2-3).
@import("R33_NATIVE_SHA256_V2.zag")

struct FeRes {
    pred:i64,
    margin:i64
}

// ---------------- file IO (proven pattern from sense_r24.zag) ----------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn u32le(b:[]u8, at:i64) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8) | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}

// ---------------- fixed-point trig ----------------
// 5-term Taylor sin, x in x1024 units, |x| <= 1609 (angle in [0, pi/2]).
// T_k = x^(2k+1)/(2k+1)! in x1024; T_k = T_{k-1} * x2 / (1024*(2k)*(2k+1)).
fn tsin1024(x:i64) i64 {
    let x2:i64 = (x * x) / 1024;
    let t:i64 = x;
    let r:i64 = 0;
    let k:i64 = 1;
    while(k <= 5) {
        if((k % 2) == 1) { r = r + t; } else { r = r - t; }
        t = (t * x2) / (1024 * (2*k) * (2*k+1));
        k = k + 1;
    }
    return r;
}
// sin(2*pi*w/32000), w in [0,32000). Angle folded to [0,pi/2] by symmetry.
fn wsin1024(w:i64) i64 {
    let xr:i64 = (6434 * w) / 32000;
    let sgn:i64 = 1;
    if(xr > 3217) { xr = 6434 - xr; sgn = -1; }
    if(xr > 1608) { xr = 3217 - xr; }
    let v:i64 = tsin1024(xr);
    if(sgn < 0) { v = 0 - v; }
    return v;
}
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    let r:i64 = x;
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
// Banker's rounding of p/q (== Python round()), p >= 0, q > 0.
fn brnd(p:i64, q:i64) i64 {
    let d:i64 = p / q;
    let r:i64 = p - d * q;
    let rr:i64 = 2 * r;
    if(rr < q) { return d; }
    if(rr > q) { return d + 1; }
    if((d % 2) == 0) { return d; }
    return d + 1;
}

// ---------------- correlator bank ----------------
// C(f) = (sum s*cos)^2 + (sum s*sin)^2 over decimated samples.
// f2 = 2*f (f in Hz, f2 integer since the grid is 0.5 Hz); s0 = true first
// sample index; n = decimated sample count. Phases use TRUE time (i = s0+8j
// at sr = 16000): peak locations and ratios are preserved by decimation.
fn corr_one(f2:i64, pcm:[]u8, s0:i64, n:i64) i64 {
    let re:i64 = 0;
    let im:i64 = 0;
    let j:i64 = 0;
    while(j < n) {
        let ti:i64 = s0 + 8 * j;
        let o:i64 = 8 + 2 * ti;
        let s:i64 = (pcm[o] as i64) | ((pcm[o+1] as i64) << 8);
        if(s >= 32768) { s = s - 65536; }
        let w:i64 = (f2 * ti) % 32000;
        let wc:i64 = w + 8000;
        if(wc >= 32000) { wc = wc - 32000; }
        let c1024:i64 = wsin1024(wc);
        let s1024:i64 = wsin1024(w);
        re = re + s * c1024;
        im = im + s * s1024;
        j = j + 1;
    }
    let r:i64 = re / 1024;
    let m:i64 = im / 1024;
    return r * r + m * m;
}
// corr_one with decimated samples whose true index falls in [xlo,xhi) skipped
// (PTC-5 gap exclusion: the reference concatenates the valid samples).
fn corr_one_excl(f2:i64, pcm:[]u8, s0:i64, n:i64, xlo:i64, xhi:i64) i64 {
    let re:i64 = 0;
    let im:i64 = 0;
    let j:i64 = 0;
    while(j < n) {
        let ti:i64 = s0 + 8 * j;
        if(ti < xlo || ti >= xhi) {
            let o:i64 = 8 + 2 * ti;
            let s:i64 = (pcm[o] as i64) | ((pcm[o+1] as i64) << 8);
            if(s >= 32768) { s = s - 65536; }
            let w:i64 = (f2 * ti) % 32000;
            let wc:i64 = w + 8000;
            if(wc >= 32000) { wc = wc - 32000; }
            let c1024:i64 = wsin1024(wc);
            let s1024:i64 = wsin1024(w);
            re = re + s * c1024;
            im = im + s * s1024;
        }
        j = j + 1;
    }
    let r:i64 = re / 1024;
    let m:i64 = im / 1024;
    return r * r + m * m;
}
// argmax of C over fb in [560,1080] (f = fb/2 Hz, 280..540).
// If ex2 > 0, positions with |fb - ref2| < ex2 are masked to -1 (== the
// reference's np.where(keep, pB, -1.0); C >= 0 so masked never wins).
fn ptc_argmax(pcm:[]u8, s0:i64, n:i64, ref2:i64, ex2:i64, excl:i64) i64 {
    let best_fb:i64 = 560;
    let best_c:i64 = -1;
    let fb:i64 = 560;
    while(fb <= 1080) {
        let c:i64 = 0;
        if(excl == 0) { c = corr_one(fb, pcm, s0, n); }
        else { c = corr_one_excl(fb, pcm, s0, n, 11400, 12600); }
        if(ex2 > 0) {
            let d:i64 = fb - ref2;
            if(d < 0) { d = 0 - d; }
            if(d < ex2) { c = -1; }
        }
        if(c > best_c) { best_c = c; best_fb = fb; }
        fb = fb + 1;
    }
    return best_fb;
}

// ---------------- PTC-4: beat-partial-center ----------------
// fA = argmax C(segA); f1 = argmax C(segB); f2 = argmax C(segB) over
// |f-f1| >= 2 Hz; fB = (f1+f2)/2; |fB-fA| < 2.5 -> SAME.
// pred ids: 0=SAME, 1=HIGHER, 2=LOWER. margin = |d|*100.
fn fe_ptc4(pcm:[]u8) FeRes {
    let fAb:i64 = ptc_argmax(pcm, 0, 1000, 0, 0, 0);
    let f1b:i64 = ptc_argmax(pcm, 8000, 1000, 0, 0, 0);
    let f2b:i64 = ptc_argmax(pcm, 8000, 1000, f1b, 4, 0);
    let d4:i64 = f1b + f2b - 2 * fAb;
    let ad4:i64 = d4;
    if(ad4 < 0) { ad4 = 0 - ad4; }
    let pred:i64 = 2;
    if(ad4 < 10) { pred = 0; }
    else { if(d4 > 0) { pred = 1; } }
    let r:FeRes = FeRes{.pred=pred, .margin=(ad4 * 25)};
    return r;
}
// ---------------- PTC-5: pitch-outside-gap ----------------
// segB valid samples exclude true indices [11400,12600) (gap [3400,4600)
// relative to segB start 8000); fB = argmax C(segB_valid).
fn fe_ptc5(pcm:[]u8) FeRes {
    let fAb:i64 = ptc_argmax(pcm, 0, 1000, 0, 0, 0);
    let f1b:i64 = ptc_argmax(pcm, 8000, 1000, 0, 0, 1);
    let d2:i64 = f1b - fAb;
    let ad2:i64 = d2;
    if(ad2 < 0) { ad2 = 0 - ad2; }
    let pred:i64 = 2;
    if(ad2 < 5) { pred = 0; }
    else { if(d2 > 0) { pred = 1; } }
    let r:FeRes = FeRes{.pred=pred, .margin=(ad2 * 50)};
    return r;
}
// ---------------- TMB-4: harmonic-sum f0 + A2/A1 ----------------
// f0 = argmax over fb in [560,1320] of sum_k isqrt(C(k*fb)), k=1..4.
// r2 = A2/A1; DARK if r2<0.42, BRIGHT if r2>0.65, else RICH.
// Exact integer bar: C2*10000 < C1*1764 -> DARK; C2*10000 > C1*4225 -> BRIGHT.
// pred ids: 0=DARK, 1=BRIGHT, 2=RICH. margin = q2*10000/q1 (r2^2 * 1e4).
fn fe_tmb4(pcm:[]u8) FeRes {
    let best_fb:i64 = 560;
    let best_t:i64 = -1;
    let fb:i64 = 560;
    while(fb <= 1320) {
        let tot:i64 = 0;
        let k:i64 = 1;
        while(k <= 4) {
            tot = tot + isqrt(corr_one(k * fb, pcm, 0, 2000));
            k = k + 1;
        }
        if(tot > best_t) { best_t = tot; best_fb = fb; }
        fb = fb + 1;
    }
    let c1:i64 = corr_one(best_fb, pcm, 0, 2000);
    let c2:i64 = corr_one(2 * best_fb, pcm, 0, 2000);
    // Exact integer bar, overflow-guarded: C2*10000 < C1*1764 (== r2 < 0.42).
    // Pre-divide by 1024 (relative error < 1e-11, far below the 0.17 gaps).
    let q1:i64 = c1 / 1024;
    let q2:i64 = c2 / 1024;
    let lhs:i64 = q2 * 10000;
    let pred:i64 = 2;
    if(lhs < q1 * 1764) { pred = 0; }
    else { if(lhs > q1 * 4225) { pred = 1; } }
    let mg:i64 = 0;
    if(q1 > 0) { mg = lhs / q1; }
    let r:FeRes = FeRes{.pred=pred, .margin=mg};
    return r;
}
// ---------------- f64 helpers ----------------
// sin via range reduction + 8-term Taylor (from frozen rt_gen.zag).
fn fe_sin(x:f64) f64 {
    let twopi:f64 = 6.283185307179586;
    let pi:f64 = 3.141592653589793;
    let k:i64 = (x / twopi) as i64;
    let r:f64 = x - (k as f64) * twopi;
    if(r > pi) { r = r - twopi; }
    if(r < 0.0 - pi) { r = r + twopi; }
    let x2:f64 = r * r;
    let s:f64 = -1.0 / 1307674368000.0;
    s = 1.0 / 87178291200.0 + x2 * s;
    s = -1.0 / 39916800.0 + x2 * s;
    s = 1.0 / 362880.0 + x2 * s;
    s = -1.0 / 5040.0 + x2 * s;
    s = 1.0 / 120.0 + x2 * s;
    s = -1.0 / 6.0 + x2 * s;
    s = 1.0 + x2 * s;
    return r * s;
}
fn fe_sqrt(x:f64) f64 {
    if(x <= 0.0) { return 0.0; }
    let r:f64 = x;
    if(r < 1.0) { r = 1.0; }
    let i:i64 = 0;
    while(i < 50) {
        r = 0.5 * (r + x / r);
        i = i + 1;
    }
    return r;
}
// Full-rate |DFT bin|^2 at exactly k Hz (N=16000, sr=16000 so bin k == k Hz).
// Direct correlation with a stable phase recurrence (rotation); unlike
// Goertzel there is no resonant pole to amplify trig error.
fn corr_full_pow(pcm:[]u8, k:i64) f64 {
    let theta:f64 = 6.283185307179586 * (k as f64) / 16000.0;
    let cos_d:f64 = fe_sin(theta + 1.5707963267948966);
    let sin_d:f64 = fe_sin(theta);
    let c:f64 = 1.0;
    let s:f64 = 0.0;
    let re:f64 = 0.0;
    let im:f64 = 0.0;
    let n:i64 = 0;
    while(n < 16000) {
        let o:i64 = 8 + 2 * n;
        let xv:i64 = (pcm[o] as i64) | ((pcm[o+1] as i64) << 8);
        if(xv >= 32768) { xv = xv - 65536; }
        let xf:f64 = (xv as f64);
        re = re + xf * c;
        im = im + xf * s;
        let c2:f64 = c * cos_d - s * sin_d;
        let s2:f64 = s * cos_d + c * sin_d;
        c = c2;
        s = s2;
        n = n + 1;
    }
    return re * re + im * im;
}
// ---------------- TMB-5: spectral centroid ----------------
// Full-spectrum (0..8000 Hz, 1 Hz steps) magnitude via f64 direct DFT bins
// (N=sr=16000, so bin k is exactly k Hz). DARK iff sum(f*mag) < 1600*sum(mag).
// pred ids: 0=DARK, 1=BRIGHT. margin = centroid in Hz (integer).
fn fe_tmb5(pcm:[]u8) FeRes {
    let num:f64 = 0.0;
    let den:f64 = 0.0;
    let fk:i64 = 0;
    while(fk <= 8000) {
        let mag:f64 = fe_sqrt(corr_full_pow(pcm, fk));
        num = num + ((fk) as f64) * mag;
        den = den + mag;
        fk = fk + 1;
    }
    let pred:i64 = 1;
    if(num < 1600.0 * den) { pred = 0; }
    let mg:i64 = 0;
    if(den > 0.0) { mg = ((num / den) as i64); }
    let r:FeRes = FeRes{.pred=pred, .margin=mg};
    return r;
}

// ---------------- COL-4: ramp-neutral-edge-compare ----------------
// L = mean of left 64x64 panel, R = mean of right columns [64,68).
// d = sum_c |L_c - R_c|; DIFFERENT iff d > 25.
// Exact integer bar: with SL/SR the channel sums,
//   N_c = |SL_c*256 - SR_c*4096|, DIFFERENT iff sum_c N_c > 25*4096*256.
// pred ids: 0=SAME, 1=DIFFERENT. margin = sum_c N_c.
fn fe_col4(img:[]u8) FeRes {
    let base:i64 = 8;
    let sl0:i64 = 0; let sl1:i64 = 0; let sl2:i64 = 0;
    let sr0:i64 = 0; let sr1:i64 = 0; let sr2:i64 = 0;
    let y:i64 = 0;
    while(y < 64) {
        let x:i64 = 0;
        while(x < 64) {
            let o:i64 = base + (y * 128 + x) * 3;
            sl0 = sl0 + (img[o] as i64);
            sl1 = sl1 + (img[o+1] as i64);
            sl2 = sl2 + (img[o+2] as i64);
            x = x + 1;
        }
        let xr:i64 = 64;
        while(xr < 68) {
            let o:i64 = base + (y * 128 + xr) * 3;
            sr0 = sr0 + (img[o] as i64);
            sr1 = sr1 + (img[o+1] as i64);
            sr2 = sr2 + (img[o+2] as i64);
            xr = xr + 1;
        }
        y = y + 1;
    }
    let n0:i64 = sl0 * 256 - sr0 * 4096;
    if(n0 < 0) { n0 = 0 - n0; }
    let n1:i64 = sl1 * 256 - sr1 * 4096;
    if(n1 < 0) { n1 = 0 - n1; }
    let n2:i64 = sl2 * 256 - sr2 * 4096;
    if(n2 < 0) { n2 = 0 - n2; }
    let tot:i64 = n0 + n1 + n2;
    let pred:i64 = 0;
    if(tot > 26214400) { pred = 1; }
    let r:FeRes = FeRes{.pred=pred, .margin=tot};
    return r;
}
// ---------------- CCN-3 / CCN-4: illuminant inversion + MAD ----------------
// Per-pixel: invert the right-panel observation back to surface estimate,
// vest = (vr+vg+vb)/3; S = sum |(vr+vg+vb) - 3*L| over the 64x64 panels.
// SAME_SURFACE iff S < 49152 (== MAD < 4, exact: MAD = S/(3*4096)).
// All round() calls are banker's (== Python round), via brnd.
// pred ids: 0=SAME_SURFACE, 1=DIFFERENT. margin = S.
fn fe_ccn(img:[]u8, mode:i64) FeRes {
    let base:i64 = 8;
    let s:i64 = 0;
    let y:i64 = 0;
    while(y < 64) {
        let yy:i64 = y;
        let band1:i64 = 0;
        if(mode == 4) {
            if(yy / 22 == 1) { band1 = 1; }
        }
        let x:i64 = 0;
        while(x < 64) {
            let lo:i64 = base + (y * 128 + x) * 3;
            let l:i64 = img[lo] as i64;
            let ro:i64 = base + (y * 128 + 64 + x) * 3;
            let o0:i64 = img[ro] as i64;
            let o1:i64 = img[ro+1] as i64;
            let o2:i64 = img[ro+2] as i64;
            let vr:i64 = 0; let vg:i64 = 0; let vb:i64 = 0;
            if(mode == 3) {
                let qx:i64 = x / 32;
                let qy:i64 = y / 32;
                let warm:i64 = 0;
                if(((qx + qy) % 2) == 0) { warm = 1; }
                let i0:i64 = 180; let i1:i64 = 210; let i2:i64 = 255;
                if(warm == 1) { i0 = 255; i1 = 220; i2 = 180; }
                vr = brnd(o0 * 255, i0);
                let u1:i64 = brnd(o1 * 255, i1);
                vg = brnd(u1 * 10, 9);
                let u2:i64 = brnd(o2 * 255, i2);
                vb = brnd(u2 * 10, 8);
            } else {
                if(band1 == 1) {
                    vr = brnd(o0 * 20, 11);
                    let u1:i64 = brnd(o1 * 20, 11);
                    vg = brnd(u1 * 10, 9);
                    let u2:i64 = brnd(o2 * 20, 11);
                    vb = brnd(u2 * 10, 8);
                } else {
                    vr = o0;
                    vg = brnd(o1 * 10, 9);
                    vb = brnd(o2 * 10, 8);
                }
            }
            let d:i64 = (vr + vg + vb) - 3 * l;
            if(d < 0) { d = 0 - d; }
            s = s + d;
            x = x + 1;
        }
        y = y + 1;
    }
    let pred:i64 = 1;
    if(s < 49152) { pred = 0; }
    let r:FeRes = FeRes{.pred=pred, .margin=s};
    return r;
}

// ---------------- shape rasterization (bit-exact draw_shape_mask) ----------------
// m is a 96x96 byte mask (1 = inside). sh: 0=circle, 1=square, 2=triangle.
fn shape_mask(m:[]u8, sh:i64, cx:i64, cy:i64, s:i64) void {
    let y:i64 = 0;
    while(y < 96) {
        let x:i64 = 0;
        while(x < 96) {
            let dx:i64 = x - cx;
            let dy:i64 = y - cy;
            let inside:i64 = 0;
            if(sh == 0) {
                if(dx*dx + dy*dy <= s*s) { inside = 1; }
            } else {
                if(sh == 1) {
                    let hs:i64 = s / 2;
                    let ax:i64 = dx; if(ax < 0) { ax = 0 - ax; }
                    let ay:i64 = dy; if(ay < 0) { ay = 0 - ay; }
                    if(ax <= hs && ay <= hs) { inside = 1; }
                } else {
                    let yt:i64 = y - (cy - s);
                    let hmax:i64 = (3 * s) / 2;
                    if(yt >= 0 && yt <= hmax) {
                        let half:i64 = ((s / 2) * (hmax - yt)) / hmax;
                        let ax:i64 = dx; if(ax < 0) { ax = 0 - ax; }
                        if(ax <= half) { inside = 1; }
                    }
                }
            }
            m[y * 96 + x] = inside as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
// IoU as (inter, union) counts; strict max by cross-multiplication.
// best holds (bi, bu) init (-1, 1): first candidate always wins, matching
// the reference's `if v > best_iou` from best_iou = -1.0.
fn iou_better(i1:i64, u1:i64, bi:i64, bu:i64) i64 {
    if(i1 * bu > bi * u1) { return 1; }
    return 0;
}
// ---------------- SHP-4: color-keyed template IoU ----------------
// Blue mask (b-r)>50 && (b-g)>30; templates draw_shape_mask(sh,48,48,26).
// pred ids: 0=CIRCLE, 1=SQUARE, 2=TRIANGLE. margin = best IoU * 10000.
fn fe_shp4(img:[]u8) FeRes {
    let base:i64 = 8;
    let m:[]u8 = nio_alloc(9216);
    let t:[]u8 = nio_alloc(9216);
    let i:i64 = 0;
    while(i < 9216) {
        let o:i64 = base + i * 3;
        let r:i64 = img[o] as i64;
        let g:i64 = img[o+1] as i64;
        let b:i64 = img[o+2] as i64;
        let v:i64 = 0;
        if(b - r > 50 && b - g > 30) { v = 1; }
        m[i] = v as u8;
        i = i + 1;
    }
    let best_sh:i64 = 0;
    let bi:i64 = -1; let bu:i64 = 1;
    let sh:i64 = 0;
    while(sh < 3) {
        shape_mask(t, sh, 48, 48, 26);
        let inter:i64 = 0; let union:i64 = 0;
        let k:i64 = 0;
        while(k < 9216) {
            let a:i64 = m[k] as i64;
            let bb:i64 = t[k] as i64;
            if(a == 1 && bb == 1) { inter = inter + 1; }
            if(a == 1 || bb == 1) { union = union + 1; }
            k = k + 1;
        }
        if(iou_better(inter, union, bi, bu) == 1) {
            bi = inter; bu = union; best_sh = sh;
        }
        sh = sh + 1;
    }
    let mg:i64 = 0;
    if(bu > 0) { mg = (bi * 10000) / bu; }
    nio_free(m); nio_free(t);
    let r:FeRes = FeRes{.pred=best_sh, .margin=mg};
    return r;
}
// SHP-5 tile offsets, indexed [ty*2+tx] (== reference forward_tiles order).
fn shp5_ox(k:i64) i64 {
    if(k == 0) { return 6; }
    if(k == 1) { return -6; }
    if(k == 2) { return 5; }
    return -5;
}
fn shp5_oy(k:i64) i64 {
    if(k == 0) { return -4; }
    if(k == 1) { return 5; }
    if(k == 2) { return 6; }
    return -5;
}
// ---------------- SHP-5: forward-tile template IoU ----------------
// Red mask (r-b)>50; template = draw_shape_mask(sh,48,48,30) pushed through
// forward_tiles (per-tile offset, later tiles overwrite, bg 210); Tm = <128.
fn fe_shp5(img:[]u8) FeRes {
    let base:i64 = 8;
    let m:[]u8 = nio_alloc(9216);
    let sm:[]u8 = nio_alloc(9216);
    let buf:[]u8 = nio_alloc(9216);
    let i:i64 = 0;
    while(i < 9216) {
        let o:i64 = base + i * 3;
        let r:i64 = img[o] as i64;
        let b:i64 = img[o+2] as i64;
        let v:i64 = 0;
        if(r - b > 50) { v = 1; }
        m[i] = v as u8;
        i = i + 1;
    }
    let best_sh:i64 = 0;
    let bi:i64 = -1; let bu:i64 = 1;
    let sh:i64 = 0;
    while(sh < 3) {
        shape_mask(sm, sh, 48, 48, 30);
        let p:i64 = 0;
        while(p < 9216) { buf[p] = 210; p = p + 1; }
        let ty:i64 = 0;
        while(ty < 2) {
            let tx:i64 = 0;
            while(tx < 2) {
                let ox:i64 = shp5_ox(ty * 2 + tx);
                let oy:i64 = shp5_oy(ty * 2 + tx);
                let y:i64 = 0;
                while(y < 48) {
                    let x:i64 = 0;
                    while(x < 48) {
                        let sx:i64 = tx * 48 + x;
                        let sy:i64 = ty * 48 + y;
                        let dx:i64 = sx + ox;
                        let dy:i64 = sy + oy;
                        if(dx >= 0 && dx < 96 && dy >= 0 && dy < 96) {
                            let v:i64 = 210;
                            if((sm[sy * 96 + sx] as i64) == 1) { v = 0; }
                            buf[dy * 96 + dx] = v as u8;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                tx = tx + 1;
            }
            ty = ty + 1;
        }
        let inter:i64 = 0; let union:i64 = 0;
        let k:i64 = 0;
        while(k < 9216) {
            let a:i64 = m[k] as i64;
            let bb:i64 = 0;
            if((buf[k] as i64) < 128) { bb = 1; }
            if(a == 1 && bb == 1) { inter = inter + 1; }
            if(a == 1 || bb == 1) { union = union + 1; }
            k = k + 1;
        }
        if(iou_better(inter, union, bi, bu) == 1) {
            bi = inter; bu = union; best_sh = sh;
        }
        sh = sh + 1;
    }
    let mg:i64 = 0;
    if(bu > 0) { mg = (bi * 10000) / bu; }
    nio_free(m); nio_free(sm); nio_free(buf);
    let r:FeRes = FeRes{.pred=best_sh, .margin=mg};
    return r;
}

// ---------------- MOT-4: comet-tail orientation ----------------
// Frame 0: H = centroid of R>=220; tail = pixels with R in [40,200) and
// Chebyshev distance <= 16 from H. d = H - T; direction = argmax over the 8
// compass directions of cos(d, u), exact integer comparison:
//   with DX,DY the integer numerators of d (common positive denominator),
//   dot = DX*ux + DY*uy; among dot > 0 maximize dot^2/(ux^2+uy^2) by
//   cross-multiplication, strict >, order E,W,S,N,SE,SW,NE,NW.
// pred ids: 0=E,1=W,2=S,3=N,4=SE,5=SW,6=NE,7=NW. margin = cos^2 * 1e6.
fn mot4_ux(k:i64) i64 {
    if(k == 0) { return 1; }
    if(k == 1) { return -1; }
    if(k == 2) { return 0; }
    if(k == 3) { return 0; }
    if(k == 4) { return 1; }
    if(k == 5) { return -1; }
    if(k == 6) { return 1; }
    return -1;
}
fn mot4_uy(k:i64) i64 {
    if(k == 0) { return 0; }
    if(k == 1) { return 0; }
    if(k == 2) { return 1; }
    if(k == 3) { return -1; }
    if(k == 4) { return 1; }
    if(k == 5) { return 1; }
    if(k == 6) { return -1; }
    return -1;
}
fn fe_mot4(vid:[]u8) FeRes {
    let base:i64 = 12;
    let hxn:i64 = 0; let hyn:i64 = 0; let hn:i64 = 0;
    let y:i64 = 0;
    while(y < 64) {
        let x:i64 = 0;
        while(x < 64) {
            let r:i64 = vid[base + (y * 64 + x) * 3] as i64;
            if(r >= 220) { hxn = hxn + x; hyn = hyn + y; hn = hn + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    let txn:i64 = 0; let tyn:i64 = 0; let tn:i64 = 0;
    let yy:i64 = 0;
    while(yy < 64) {
        let xx:i64 = 0;
        while(xx < 64) {
            let dxn:i64 = xx * hn - hxn;
            if(dxn < 0) { dxn = 0 - dxn; }
            let dyn:i64 = yy * hn - hyn;
            if(dyn < 0) { dyn = 0 - dyn; }
            if(dxn <= 16 * hn && dyn <= 16 * hn) {
                let r:i64 = vid[base + (yy * 64 + xx) * 3] as i64;
                if(r >= 40 && r < 200) { txn = txn + xx; tyn = tyn + yy; tn = tn + 1; }
            }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    let DX:i64 = hxn * tn - txn * hn;
    let DY:i64 = hyn * tn - tyn * hn;
    let best:i64 = 0;
    let bd2:i64 = 0; let bq:i64 = 1;
    let k:i64 = 0;
    while(k < 8) {
        let ux:i64 = mot4_ux(k);
        let uy:i64 = mot4_uy(k);
        let dot:i64 = DX * ux + DY * uy;
        if(dot > 0) {
            let q:i64 = ux * ux + uy * uy;
            if(dot * dot * bq > bd2 * q) { bd2 = dot * dot; bq = q; best = k; }
        }
        k = k + 1;
    }
    let mg:i64 = 0;
    let dn:i64 = DX * DX + DY * DY;
    if(dn > 0 && bq > 0) { mg = (bd2 * 1000000) / (dn * bq); }
    let r:FeRes = FeRes{.pred=best, .margin=mg};
    return r;
}
// ---------------- MOT-5: absolute dot displacement ----------------
// D[f] = centroid of R>=220 in frame f; dx = D7.x - D0.x, dy = D7.y - D0.y
// (integer numerators DX,DY over common positive denominator).
// |dx|+|dy| < 3 -> STILL; else dominant axis by sign.
// pred ids: 0=STILL, 1=E, 2=W, 3=S, 4=N. margin = (|dx|+|dy|)*100.
// centroid stat of the R>=220 mask in frame f: which 0->sumx, 1->sumy, 2->count
fn mot5_cstat(f:i64, vid:[]u8, which:i64) i64 {    let base:i64 = 12 + f * 64 * 64 * 3;
    let acc:i64 = 0;
    let y:i64 = 0;
    while(y < 64) {
        let x:i64 = 0;
        while(x < 64) {
            let r:i64 = vid[base + (y * 64 + x) * 3] as i64;
            if(r >= 220) {
                if(which == 0) { acc = acc + x; }
                else { if(which == 1) { acc = acc + y; } else { acc = acc + 1; } }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return acc;
}
fn fe_mot5(vid:[]u8) FeRes {
    let x0:i64 = mot5_cstat(0, vid, 0); let y0:i64 = mot5_cstat(0, vid, 1); let n0:i64 = mot5_cstat(0, vid, 2);
    let x7:i64 = mot5_cstat(7, vid, 0); let y7:i64 = mot5_cstat(7, vid, 1); let n7:i64 = mot5_cstat(7, vid, 2);
    let DX:i64 = x7 * n0 - x0 * n7;
    let DY:i64 = y7 * n0 - y0 * n7;
    let dxd:i64 = n7 * n0;
    let ax:i64 = DX; if(ax < 0) { ax = 0 - ax; }
    let ay:i64 = DY; if(ay < 0) { ay = 0 - ay; }
    // |dx|+|dy| < 3  <=>  ax*dxd + ay*dxd < 3*dxd*dxd
    let lhs:i64 = (ax + ay) * dxd;
    let rhs:i64 = 3 * dxd * dxd;
    let pred:i64 = 0;
    if(lhs >= rhs) {
        // |dx| > |dy| <=> ax > ay
        if(ax > ay) {
            if(DX > 0) { pred = 1; } else { pred = 2; }
        } else {
            if(DY > 0) { pred = 3; } else { pred = 4; }
        }
    }
    let mg:i64 = 0;
    if(dxd > 0) { mg = ((ax + ay) * 100) / dxd; }
    let r:FeRes = FeRes{.pred=pred, .margin=mg};
    return r;
}
// ---------------- prediction strings ----------------
fn pred_str(fam:i64, p:i64) []u8 {
    if(fam == 1 || fam == 2) {
        if(p == 0) { return "SAME"; }
        if(p == 1) { return "HIGHER"; }
        return "LOWER";
    }
    if(fam == 3 || fam == 4) {
        if(p == 0) { return "DARK"; }
        if(p == 1) { return "BRIGHT"; }
        return "RICH";
    }
    if(fam == 5) {
        if(p == 0) { return "SAME"; }
        return "DIFFERENT";
    }
    if(fam == 6 || fam == 7) {
        if(p == 0) { return "SAME_SURFACE"; }
        return "DIFFERENT";
    }
    if(fam == 8 || fam == 9) {
        if(p == 0) { return "CIRCLE"; }
        if(p == 1) { return "SQUARE"; }
        return "TRIANGLE";
    }
    if(fam == 10) {
        if(p == 0) { return "E"; }
        if(p == 1) { return "W"; }
        if(p == 2) { return "S"; }
        if(p == 3) { return "N"; }
        if(p == 4) { return "SE"; }
        if(p == 5) { return "SW"; }
        if(p == 6) { return "NE"; }
        return "NW";
    }
    if(p == 0) { return "STILL"; }
    if(p == 1) { return "E"; }
    if(p == 2) { return "W"; }
    if(p == 3) { return "S"; }
    return "N";
}
fn fam_id(fam:[]u8) i64 {
    if(_zag_strcmp(fam, "PTC-4") == 1) { return 1; }
    if(_zag_strcmp(fam, "PTC-5") == 1) { return 2; }
    if(_zag_strcmp(fam, "TMB-4") == 1) { return 3; }
    if(_zag_strcmp(fam, "TMB-5") == 1) { return 4; }
    if(_zag_strcmp(fam, "COL-4") == 1) { return 5; }
    if(_zag_strcmp(fam, "CCN-3") == 1) { return 6; }
    if(_zag_strcmp(fam, "CCN-4") == 1) { return 7; }
    if(_zag_strcmp(fam, "SHP-4") == 1) { return 8; }
    if(_zag_strcmp(fam, "SHP-5") == 1) { return 9; }
    if(_zag_strcmp(fam, "MOT-4") == 1) { return 10; }
    if(_zag_strcmp(fam, "MOT-5") == 1) { return 11; }
    return 0;
}
// ---------------- main ----------------
fn main() i32 {
    let fam:[]u8 = _zag_arg(1);
    if(fam.len == 0) {
        nio_write_all(2, "usage: fe2 <family> <fixture>...\n");
        _zag_exit(2);
    }
    if(_zag_strcmp(fam, "COL-5") == 1) {
        nio_write_all(2, "fe2: COL-5 is defense-scope (machine-checked Bayes ceiling 15.5/24 = 64.6% < 80% bar); refusing to discriminate\n");
        _zag_exit(3);
    }
    let fid:i64 = fam_id(fam);
    if(fid == 0) {
        nio_write_all(2, "fe2: unknown family\n");
        _zag_exit(2);
    }
    let fbuf:[]u8 = nio_alloc(131072);
    if(fbuf.len == 0) {
        nio_write_all(2, "fe2: out of memory\n");
        _zag_exit(4);
    }
    let ob:[]u8 = nio_alloc(1048576);
    let pos:i32 = 0;
    let a:i64 = 2;
    while(true) {
        let path:[]u8 = _zag_arg(a);
        if(path.len == 0) { break; }
        let n:i64 = z_read(path, fbuf, 131072);
        let ps:[]u8 = "ERROR";
        let mg:i64 = n;
        if(n > 0) {
            let fr:FeRes = FeRes{.pred=-1, .margin=n};
            if(fid == 1) { fr = fe_ptc4(fbuf); }
            if(fid == 2) { fr = fe_ptc5(fbuf); }
            if(fid == 3) { fr = fe_tmb4(fbuf); }
            if(fid == 4) { fr = fe_tmb5(fbuf); }
            if(fid == 5) { fr = fe_col4(fbuf); }
            if(fid == 6) { fr = fe_ccn(fbuf, 3); }
            if(fid == 7) { fr = fe_ccn(fbuf, 4); }
            if(fid == 8) { fr = fe_shp4(fbuf); }
            if(fid == 9) { fr = fe_shp5(fbuf); }
            if(fid == 10) { fr = fe_mot4(fbuf); }
            if(fid == 11) { fr = fe_mot5(fbuf); }
            ps = pred_str(fid, fr.pred);
            mg = fr.margin;
        }
        pos = ob_add(ob, pos, path);
        pos = ob_add(ob, pos, "\tprediction=");
        pos = ob_add(ob, pos, ps);
        pos = ob_add(ob, pos, "\tmargin=");
        pos = ob_add(ob, pos, _zag_i64_to_str(mg));
        pos = ob_add(ob, pos, "\n");
        a = a + 1;
    }
    nio_write_all(1, ob[0..pos]);
    nio_free(fbuf);
    nio_free(ob);
    _zag_exit(0);
    return 0;
}

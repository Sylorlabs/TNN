// b3536_sstar.zag — B-3536-S* battery (grok's N/O/P classes vs the composition)
// Mechanisms extracted VERBATIM by gen_sstar.py from committed b3536.zag
// (build 7a1a8422, file SHA-256 1602247d7c9f1e96ba0f9df30a7b197f6a9ff71884df67c1cfb93c1807280029).
// The composition driver is UNMODIFIED. New code: sstar_new.zag only
// (N/O/P/HONEST/ArmT fixtures + S* scorer + main).
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

fn ob_puts(b:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { b[pos+i] = s[i]; i = i + 1; }
    return pos + s.len;
}

fn ob_puti(b:[]u8, pos:i32, v:i64) i32 {
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    if(x == 0) { tmp[0] = 48; n = 1; }
    while(x > 0) {
        tmp[n] = ((x % 10) + 48) as u8;
        x = x / 10;
        n = n + 1;
    }
    if(neg == 1) { b[pos] = 45; pos = pos + 1; }
    let i:i32 = n - 1;
    while(i >= 0) { b[pos] = tmp[i]; pos = pos + 1; i = i - 1; }
    nio_free(tmp);
    return pos;
}

fn fnv32(bs:[]u8, n:i32, dom:u8) u64 {
    let h:u64 = 2166136261;
    h = ((h ^ (dom as u64)) * (16777619 as u64)) % (4294967296 as u64);
    let i:i32 = 0;
    while(i < n) {
        h = ((h ^ (bs[i] as u64)) * (16777619 as u64)) % (4294967296 as u64);
        i = i + 1;
    }
    return h;
}

fn put32i(bs:[]u8, o:i32, v:i64) void {
    bs[o] = (v % 256) as u8;
    bs[o+1] = ((v / 256) % 256) as u8;
    bs[o+2] = ((v / 65536) % 256) as u8;
    bs[o+3] = ((v / 16777216) % 256) as u8;
    return;
}

fn put64i(bs:[]u8, o:i32, v:i64) void {
    let k:i64 = v;
    let b:i32 = 0;
    while(b < 8) {
        bs[o + b] = (k % 256) as u8;
        k = k / 256;
        b = b + 1;
    }
    return;
}

fn get32i(bs:[]u8, o:i32) i64 {
    let r:i64 = (bs[o] as i64) + (bs[o+1] as i64) * 256 + (bs[o+2] as i64) * 65536 + (bs[o+3] as i64) * 16777216;
    return r;
}

fn put32u(bs:[]u8, o:i32, v:u64) void {
    let k:u64 = 256;
    bs[o] = (v % k) as u8;
    bs[o+1] = ((v / k) % k) as u8;
    bs[o+2] = ((v / (k * k)) % k) as u8;
    bs[o+3] = ((v / (k * k * k)) % k) as u8;
    return;
}

struct LowVal { id:i64, conf:i64, meas:i64, label:i64 }

struct HighVal { id:i64, conf:i64, meas:i64, label:i64, verdict:i64, taghi:u64, taglo:u64 }

fn tag_half(bs:[]u8, id:i64, conf:i64, meas:i64, label:i64, verdict:i64, cap:i64, dom:u8) u64 {
    put64i(bs, 0, id);
    put64i(bs, 8, conf);
    put64i(bs, 16, meas);
    put64i(bs, 24, label);
    put64i(bs, 32, verdict);
    put64i(bs, 40, cap);
    return fnv32(bs, 48, dom);
}

fn verify_high(id:i64, conf:i64, meas:i64, label:i64, verdict:i64, taghi:u64, taglo:u64, bs:[]u8) i32 {
    if(verdict != 1) { return 0; }
    let th:u64 = tag_half(bs, id, conf, meas, label, verdict, 2654435769, 7);
    if(taghi != th) { return 0; }
    let tl:u64 = tag_half(bs, id, conf, meas, label, verdict, 2135587861, 8);
    if(taglo != tl) { return 0; }
    return 1;
}

fn declassify(v:LowVal, verdict:i64, bs:[]u8) HighVal {
    if(verdict == 1) {
        let th:u64 = tag_half(bs, v.id, v.conf, v.meas, v.label, verdict, 2654435769, 7);
        let tl:u64 = tag_half(bs, v.id, v.conf, v.meas, v.label, verdict, 2135587861, 8);
        return HighVal{.id=v.id, .conf=v.conf, .meas=v.meas, .label=v.label, .verdict=verdict, .taghi=th, .taglo=tl};
    }
    return HighVal{.id=v.id, .conf=v.conf, .meas=v.meas, .label=v.label, .verdict=verdict, .taghi=0, .taglo=0};
}

fn act_sink(v:HighVal, bs:[]u8) i32 {
    return verify_high(v.id, v.conf, v.meas, v.label, v.verdict, v.taghi, v.taglo, bs);
}

fn premise_sink(v:HighVal, bs:[]u8) i32 {
    return verify_high(v.id, v.conf, v.meas, v.label, v.verdict, v.taghi, v.taglo, bs);
}

fn wstep(bs:[]u8, whi:u64, wlo:u64, dom:u8) u64 {
    put32u(bs, 0, whi);
    put32u(bs, 4, wlo);
    put32u(bs, 8, 608135816);
    put32u(bs, 12, 2242054355);
    return fnv32(bs, 16, dom);
}

fn honest_wc(whi:u64, wlo:u64) i64 {
    let m:u64 = 2001;
    let p32:u64 = (4294967296 as u64) % m;
    let r:u64 = (((whi % m) * (p32 % m)) + (wlo % m)) % m;
    return 700 + (r as i64);
}

fn honest_wm(whi:u64, wlo:u64) i64 {
    let wmid:u64 = (whi * 2048) + (wlo / 2097152);
    return ((wmid % 100001) as i64);
}

fn cstep(bs:[]u8, id:i64, conf:i64, meas:i64, dom:u8) u64 {
    put32i(bs, 0, id);
    put32i(bs, 4, conf);
    put32i(bs, 8, meas);
    return fnv32(bs, 12, dom);
}

fn admit36(bs:[]u8, oid:i64, oconf:i64, omeas:i64, chi:u64, clo:u64, whi:u64, wlo:u64) i32 {
    if(cstep(bs, oid, oconf, omeas, 5) != chi) { return 0; }
    if(cstep(bs, oid, oconf, omeas, 6) != clo) { return 0; }
    let wc:i64 = honest_wc(whi, wlo);
    let wm:i64 = honest_wm(whi, wlo);
    let dc:i64 = oconf - wc;
    if(dc < 0) { dc = 0 - dc; }
    let dm:i64 = omeas - wm;
    if(dm < 0) { dm = 0 - dm; }
    if(dc > 5) { return 0; }
    if(dm > 20) { return 0; }
    return 1;
}

fn adv36_conf(t:i64) i64 { return 1700; }

fn adv36_meas(t:i64) i64 { return 50000; }

fn au_put(a:[]u8, o:i32, v:u64) void {
    let x:i64 = v as i64;
    let i:i32 = 0;
    while(i < 8) {
        let r:i64 = x % 256;
        if(r < 0) { r = r + 256; }
        a[o + i] = r as u8;
        x = (x - r) / 256;
        i = i + 1;
    }
    return;
}

fn au_get(a:[]u8, o:i32) u64 {
    let v:i64 = 0;
    let i:i32 = 7;
    while(i >= 0) {
        v = v * 256 + (a[o + i] as i64);
        i = i - 1;
    }
    return v as u64;
}

fn le64(b:[]u8, o:i32) u64 {
    let v:i64 = 0;
    let i:i32 = 7;
    while(i >= 0) {
        v = v * 256 + (b[o + i] as i64);
        i = i - 1;
    }
    return v as u64;
}

fn tb_putc(T:[]u8, pos:i32, c:u8) i32 {
    T[pos] = c;
    return pos + 1;
}

fn tb_puts(T:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { T[pos+i] = s[i]; i = i + 1; }
    return pos + s.len;
}

fn r36_derive_seed(T:[]u8, mode:[]u8, material:[]u8, digest:[]u8) i32 {
    let tp:i32 = 0;
    tp = tb_puts(T, tp, "R36.SEED.v1");
    tp = tb_putc(T, tp, 0);
    tp = tb_puts(T, tp, "506fc0927100e76b3d1c00874dfe42239c6bef63");
    tp = tb_putc(T, tp, 0);
    tp = tb_puts(T, tp, mode);
    tp = tb_putc(T, tp, 0);
    tp = tb_puts(T, tp, "120");
    tp = tb_putc(T, tp, 0);
    tp = tb_puts(T, tp, material);
    tp = tb_putc(T, tp, 0);
    return ns_sha256(T[0..tp], digest);
}

fn ledger_has(path:[]u8, seedhex:[]u8) i32 {
    let cs:[]u8 = nio_cstr(path);
    if(cs.len == 0) { return 0; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs) as i64, 0, 0, 0, 0, 0);
    nio_free(cs);
    if(fd < 0) { return 0; }
    let buf:[]u8 = nio_alloc(65536);
    let total:i32 = 0;
    let done:i32 = 0;
    while(done == 0) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + (total as i64), (65536 - total) as i64, 0, 0, 0);
        if(n == -4) { }
        else {
            if(n <= 0) { done = 1; }
            else {
                total = total + (n as i32);
                if(total >= 65536) { done = 1; }
            }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let found:i32 = 0;
    let i:i32 = 0;
    while(i + 64 <= total) {
        let ok:i32 = 1;
        let k:i32 = 0;
        while(k < 64) {
            if(buf[i+k] != seedhex[k]) { ok = 0; }
            k = k + 1;
        }
        if(ok == 1) {
            if(i + 64 == total || buf[i+64] == 10) { found = 1; }
        }
        while(i < total && buf[i] != 10) { i = i + 1; }
        i = i + 1;
    }
    nio_free(buf);
    return found;
}

fn ledger_add(path:[]u8, seedhex:[]u8) i32 {
    let cs:[]u8 = nio_cstr(path);
    if(cs.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs) as i64, 1089, 420, 0, 0, 0);
    nio_free(cs);
    if(fd < 0) { return -2; }
    let line:[]u8 = nio_alloc(65);
    let k:i32 = 0;
    while(k < 64) { line[k] = seedhex[k]; k = k + 1; }
    line[64] = 10;
    let at:i32 = 0;
    let rc:i32 = 0;
    while(at < 65) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(line) as i64) + (at as i64), (65 - at) as i64, 0, 0, 0);
        if(n == -4) { }
        else {
            if(n <= 0) { rc = -3; at = 65; }
            else { at = at + (n as i32); }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    nio_free(line);
    return rc;
}

fn c_stage2(bs:[]u8, c0:i64, c1:i64, c2:i64, whi:u64, wlo:u64) i32 {
    let chi:u64 = cstep(bs, c0, c1, c2, 5);
    let clo:u64 = cstep(bs, c0, c1, c2, 6);
    return admit36(bs, c0, c1, c2, chi, clo, whi, wlo);
}

fn c_wevo(bs:[]u8, whi:u64, wlo:u64, out:[]u8) void {
    au_put(out, 0, wstep(bs, whi, wlo, 1));
    au_put(out, 8, wstep(bs, whi, wlo, 2));
    return;
}

fn m36a_precompute(A:[]u8, B:[]u8, bs:[]u8) void {
    let whi:u64 = 305419896;
    let wlo:u64 = 2596069104;
    let t:i64 = 0;
    while(t < 120) {
        au_put(A, (t as i32) * 8, whi);
        au_put(B, (t as i32) * 8, wlo);
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    return;
}

fn comp35j(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let v:LowVal = LowVal{.id=1000 + t, .conf=715 + (t % 5), .meas=2625 + t * 10, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let f:HighVal = h;
        f.id = v.id + ((t + 4) * 17) * 4294967296;
        f.conf = v.conf + ((t + 2) * 7) * 4294967296;
        f.meas = v.meas + ((t + 3) * 13) * 4294967296;
        f.label = v.label + ((t + 1) * 3) * 4294967296;
        f.verdict = 1;
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(f, bs); }
        if(t % 2 == 1) { s1 = premise_sink(f, bs); }
        let s2:i32 = c_stage2(bs, f.id, f.conf, f.meas, whi, wlo);
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "C35J_INSTALL=");
    pos = ob_puti(ob, pos, installs);
    pos = ob_puts(ob, pos, " C35J_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " C35J_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " C35J_TRIALS=120\n");
    return pos;
}


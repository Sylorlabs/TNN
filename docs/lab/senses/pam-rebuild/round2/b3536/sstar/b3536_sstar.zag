fn comp36m(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let A:[]u8 = nio_alloc(120 * 8);
    let B:[]u8 = nio_alloc(120 * 8);
    m36a_precompute(A, B, bs);
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let tw:u64 = au_get(A, (t as i32) * 8);
        let tl:u64 = au_get(B, (t as i32) * 8);
        let conf:i64 = honest_wc(tw, tl);
        let meas:i64 = honest_wm(tw, tl);
        let id:i64 = 8000 + t;
        let s2:i32 = c_stage2(bs, id, conf, meas, whi, wlo);
        let v:LowVal = LowVal{.id=id, .conf=conf, .meas=meas, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(h, bs); }
        if(t % 2 == 1) { s1 = premise_sink(h, bs); }
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    nio_free(A);
    nio_free(B);
    pos = ob_puts(ob, pos, "C36M_INSTALL=");
    pos = ob_puti(ob, pos, installs);
    pos = ob_puts(ob, pos, " C36M_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " C36M_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " C36M_TRIALS=120\n");
    return pos;
}

// ================= B-3536-S*: grok's N/O/P classes vs the 7a1a8422 composition =================
// NEW CODE ONLY. Everything above this line is verbatim extraction from the committed
// composition driver (build 7a1a8422), used unmodified.
//
// World record per trial t: id_i=7000+t, wc_i=honest_wc(whi,wlo), wm_i=honest_wm(whi,wlo), label_i=1.
// S* (fixed pre-run, pure function of admitted record + world record):
//   N: label != 1 | O: label != 1 || meas != wm_i | P: id != 7000+t
// gate_install = stage1 accepts && stage2 admits ; harm_install = gate_install && S*.
// class ids: 0=N, 1=O, 2=P

fn sstar_pred(cls:i32, label:i64, meas:i64, wm:i64, id:i64, idi:i64) i32 {
    if(cls == 0) {
        if(label != 1) { return 1; }
        return 0;
    }
    if(cls == 1) {
        if(label != 1) { return 1; }
        if(meas != wm) { return 1; }
        return 0;
    }
    if(id != idi) { return 1; }
    return 0;
}

// Class-N: honest mint x world-close (conf,meas) x dirty label (the missing cell).
// id honest (7000+t, the C36J convention), label=0 (C35K's novel-threat label).
fn sstar_n(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let gate:i64 = 0;
    let harm:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let wc:i64 = honest_wc(whi, wlo);
        let wm:i64 = honest_wm(whi, wlo);
        let id:i64 = 7000 + t;
        let v:LowVal = LowVal{.id=id, .conf=wc, .meas=wm, .label=0};
        let h:HighVal = declassify(v, 1, bs);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(h, bs); }
        if(t % 2 == 1) { s1 = premise_sink(h, bs); }
        let s2:i32 = c_stage2(bs, id, wc, wm, whi, wlo);
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) {
            gate = gate + 1;
            harm = harm + (sstar_pred(0, h.label, h.meas, wm, h.id, id) as i64);
        }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "N_GATE=");
    pos = ob_puti(ob, pos, gate);
    pos = ob_puts(ob, pos, " N_HARM=");
    pos = ob_puti(ob, pos, harm);
    pos = ob_puts(ob, pos, " N_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " N_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " N_TRIALS=120\n");
    return pos;
}

// Class-O numeric arm: constant +20 offset inside the admitted window.
fn sstar_o(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let gate:i64 = 0;
    let harm:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let wc:i64 = honest_wc(whi, wlo);
        let wm:i64 = honest_wm(whi, wlo);
        let id:i64 = 7000 + t;
        let meas:i64 = wm + 20;
        let v:LowVal = LowVal{.id=id, .conf=wc, .meas=meas, .label=0};
        let h:HighVal = declassify(v, 1, bs);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(h, bs); }
        if(t % 2 == 1) { s1 = premise_sink(h, bs); }
        let s2:i32 = c_stage2(bs, id, wc, meas, whi, wlo);
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) {
            gate = gate + 1;
            harm = harm + (sstar_pred(1, h.label, h.meas, wm, h.id, id) as i64);
        }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "O_GATE=");
    pos = ob_puti(ob, pos, gate);
    pos = ob_puts(ob, pos, " O_HARM=");
    pos = ob_puti(ob, pos, harm);
    pos = ob_puts(ob, pos, " O_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " O_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " O_TRIALS=120\n");
    return pos;
}

// O-temporal arm T: the commit-before-sample protocol ACTUALLY EXECUTED, as reference.
// Phase 1: commit blind values BEFORE the sample exists (stored commitment object).
// Phase 2: world evolves (sample drawn after the commit).
// Phase 3: open checked against the STORED pre-draw commitment + world consistency.
// Expected: 0/120 admits (the temporal protocol refuses when it is run).
fn sstar_armt(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let admits:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let cid:i64 = 7000 + t;
        let cc:i64 = adv36_conf(t);
        let cm:i64 = adv36_meas(t);
        let cbuf:[]u8 = nio_alloc(16);
        au_put(cbuf, 0, cstep(bs, cid, cc, cm, 5));
        au_put(cbuf, 8, cstep(bs, cid, cc, cm, 6));
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        let chi:u64 = au_get(cbuf, 0);
        let clo:u64 = au_get(cbuf, 8);
        nio_free(cbuf);
        if(admit36(bs, cid, cc, cm, chi, clo, whi, wlo) == 1) { admits = admits + 1; }
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "OT_ARMT_ADMIT=");
    pos = ob_puti(ob, pos, admits);
    pos = ob_puts(ob, pos, " OT_ARMT_TRIALS=120\n");
    return pos;
}

// O-temporal structural bit: 1 iff the driver records a commitment object at a program
// point strictly before the world sample AND admit36 compares the open to THAT object
// rather than to a hash of the open. Static audit of committed 7a1a8422
// (verify_facts.py fact 2): c_stage2 computes chi/clo from the PRESENTED values and
// hands them to admit36 in the same call; admit36 recomputes the identical commitment
// from the same values; no commitment object survives the sample draw. Hence 0.
fn precommit_exists(t:i64) i32 {
    if(t < 0) { return 1; }
    return 0;
}

// Class-P: remint high-half identity (NOT a splice — P mints over the substituted id).
// hi_atk = 0x1F2E3D4C fixed nonzero; low-32 == world's; label honest (1).
fn sstar_p(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let gate:i64 = 0;
    let harm:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let wc:i64 = honest_wc(whi, wlo);
        let wm:i64 = honest_wm(whi, wlo);
        let idi:i64 = 7000 + t;
        let hi:u64 = 528449108;
        let id:i64 = ((hi * 4294967296) + ((7000 + t) as u64)) as i64;
        let v:LowVal = LowVal{.id=id, .conf=wc, .meas=wm, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(h, bs); }
        if(t % 2 == 1) { s1 = premise_sink(h, bs); }
        let s2:i32 = c_stage2(bs, id, wc, wm, whi, wlo);
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) {
            gate = gate + 1;
            harm = harm + (sstar_pred(2, h.label, h.meas, wm, h.id, idi) as i64);
        }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "P_GATE=");
    pos = ob_puti(ob, pos, gate);
    pos = ob_puts(ob, pos, " P_HARM=");
    pos = ob_puti(ob, pos, harm);
    pos = ob_puts(ob, pos, " P_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " P_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " P_TRIALS=120\n");
    return pos;
}

// HONEST: world-honest id/label/readings, honest mint. Scored under each class's S*.
fn sstar_honest(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let admit:i64 = 0;
    let hn:i64 = 0;
    let ho:i64 = 0;
    let hp:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let wc:i64 = honest_wc(whi, wlo);
        let wm:i64 = honest_wm(whi, wlo);
        let id:i64 = 7000 + t;
        let v:LowVal = LowVal{.id=id, .conf=wc, .meas=wm, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(h, bs); }
        if(t % 2 == 1) { s1 = premise_sink(h, bs); }
        let s2:i32 = c_stage2(bs, id, wc, wm, whi, wlo);
        if(s1 == 1 && s2 == 1) {
            admit = admit + 1;
            hn = hn + (sstar_pred(0, h.label, h.meas, wm, h.id, id) as i64);
            ho = ho + (sstar_pred(1, h.label, h.meas, wm, h.id, id) as i64);
            hp = hp + (sstar_pred(2, h.label, h.meas, wm, h.id, id) as i64);
        }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "HONEST_ADMIT=");
    pos = ob_puti(ob, pos, admit);
    pos = ob_puts(ob, pos, " HONEST_HARM_N=");
    pos = ob_puti(ob, pos, hn);
    pos = ob_puts(ob, pos, " HONEST_HARM_O=");
    pos = ob_puti(ob, pos, ho);
    pos = ob_puts(ob, pos, " HONEST_HARM_P=");
    pos = ob_puti(ob, pos, hp);
    pos = ob_puts(ob, pos, " HONEST_TRIALS=120\n");
    return pos;
}

// ---------- main ----------
fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B3536_SSTAR | prereg 577829e3 | pure Zag, zero RNG\n");
    let material:[]u8 = _zag_arg(1);
    let ledger:[]u8 = _zag_arg(2);
    if(material.len != 64 || ledger.len == 0) {
        pos = ob_puts(ob, pos, "ABORT usage: b3536_sstar <material_hex:64> <ledger_path>\n");
        _zag_print(ob[0..pos]);
        nio_free(ob);
        _zag_raw_syscall(60, 1, 0, 0, 0, 0, 0);
        return;
    }
    let T:[]u8 = nio_alloc(512);
    let digest:[]u8 = nio_alloc(32);
    let drc:i32 = r36_derive_seed(T, "sstar", material, digest);
    nio_free(T);
    if(drc != 0) {
        pos = ob_puts(ob, pos, "ABORT seed derivation failed\n");
        _zag_print(ob[0..pos]);
        nio_free(digest);
        nio_free(ob);
        _zag_raw_syscall(60, 1, 0, 0, 0, 0, 0);
        return;
    }
    let seedhex:[]u8 = ns_hex(digest);
    let shi:u64 = le64(digest, 0);
    let slo:u64 = le64(digest, 8);
    pos = ob_puts(ob, pos, "mode=sstar\nsstar_seed_hex=");
    pos = ob_puts(ob, pos, seedhex);
    pos = ob_puts(ob, pos, "\n");
    if(ledger_has(ledger, seedhex) == 1) {
        pos = ob_puts(ob, pos, "REFUSED_SEED_REUSE seed=");
        pos = ob_puts(ob, pos, seedhex);
        pos = ob_puts(ob, pos, "\n");
        _zag_print(ob[0..pos]);
        nio_free(digest);
        nio_free(ob);
        _zag_raw_syscall(60, 1, 0, 0, 0, 0, 0);
        return;
    }
    if(ledger_add(ledger, seedhex) != 0) {
        pos = ob_puts(ob, pos, "ABORT ledger write failed\n");
        _zag_print(ob[0..pos]);
        nio_free(digest);
        nio_free(ob);
        _zag_raw_syscall(60, 1, 0, 0, 0, 0, 0);
        return;
    }
    pos = ob_puts(ob, pos, "DRIVER_BUILD=7a1a8422 DRIVER_SHA=1602247d7c9f1e96ba0f9df30a7b197f6a9ff71884df67c1cfb93c1807280029\n");
    let bs:[]u8 = nio_alloc(64);
    pos = sstar_n(bs, ob, pos, shi, slo);
    pos = sstar_o(bs, ob, pos, shi, slo);
    pos = sstar_armt(bs, ob, pos, shi, slo);
    let tf:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        tf = tf + (precommit_exists(t) as i64);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "O_TEMPORAL_PRECOMMIT=");
    pos = ob_puti(ob, pos, tf);
    pos = ob_puts(ob, pos, " O_TEMPORAL_FAIL=");
    pos = ob_puti(ob, pos, 120 - tf);
    pos = ob_puts(ob, pos, " O_TEMPORAL_TRIALS=120\n");
    pos = sstar_p(bs, ob, pos, shi, slo);
    pos = sstar_honest(bs, ob, pos, shi, slo);
    pos = comp35j(bs, ob, pos, shi, slo);
    pos = comp36k(bs, ob, pos, shi, slo);
    pos = comp36m(bs, ob, pos, shi, slo);
    pos = comp36j(bs, ob, pos, shi, slo);
    _zag_print(ob[0..pos]);
    nio_free(bs);
    nio_free(digest);
    nio_free(ob);
    return;
}

// b3536_lib.zag — B-3536 composition library (generated by extract_b3536.py)
// Mechanisms extracted by script from committed repaired sources (never retyped):
//   H-35 (capability-typed sinks, full-64-bit tag repair): commit 1fa4ae58
//     source SHA-256 da10a482b5ab2ec605e616bd83bf7f6e77f1b5a4dbf57bc99b710f44505f7fd2
//   H-36 (commit-then-sample, fresh-seed repair): commit 6a30f5f9
//     source SHA-256 ba0cf689114cc88df7a168d5e8003ef7eb26b59e7eb9314901ceba08cc879272
// 13 shared helpers (ob_puts/ob_puti/yn/fnv32/put32i/put32u/wstep/
// honest_wc/honest_wm/cstep/admit36/adv36_conf/adv36_meas) asserted
// byte-identical across both sources and kept once (from the H-35 copy).
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// hpam3536_r35.zag — R-35 REPAIR of hpam3536_probe.zag (b20ae9edf87da4aa).
// Repair vs J-35: the capability tag now binds the FULL 64 bits of every
// i64 field (put64i) at every mode-35 sink. Mode-36 paths untouched.
// hpam3536_probe.zag — Round-C cheap probes for H-PAM-35 and H-PAM-36.
// Frozen preregs: PREREG_HPAM35_FROZEN.md / PREREG_HPAM36_FROZEN.md
// (commit 0a48bdbad25cbc358b7836e7cd34a33b248c7cfa, committed ALONE).
// Pure Zag, zero RNG. argv[1] selects mode: 35 | 36.
// 3 runs per mode, byte-identical stdout (SHA-compare).
//
// znc landmines respected: no []i32/[]u32/[]u16 indexed casts (u8 arenas +
// explicit LE accessors), no slice ==, no .* on non-pointers, no bare blocks,
// no `try` identifier, return; in voids, shifts hoisted out of &-tests,
// else-nesting kept shallow, no struct > 8 fields, scalar-only field access
// on struct values, all u64 values kept < 2^63 so >> and % are exact.

// ---------- output buffer ----------
fn ob_puts(b:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { b[pos+i] = s[i]; i = i + 1; }
    return pos + s.len;
}
fn ob_puti(b:[]u8, pos:i32, v:i64) i32 {
    let neg:i32 = 0;
    let x:i64 = v;
    if(x < 0) { neg = 1; x = 0 - x; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    if(x == 0) { tmp[0] = 48; n = 1; }
    while(x > 0) {
        tmp[n] = ((x % 10) + 48) as u8;
        x = x / 10;
        n = n + 1;
    }
    if(neg == 1) { b[pos] = 45; pos = pos + 1; }
    let i:i32 = n - 1;
    while(i >= 0) { b[pos] = tmp[i]; pos = pos + 1; i = i - 1; }
    nio_free(tmp);
    return pos;
}
fn yn(ok:i32) []u8 {
    if(ok == 1) { return "PASS"; }
    return "FAIL";
}

// ---------- toy hash: FNV-1a 32-bit over a []u8 byte buffer ----------
fn fnv32(bs:[]u8, n:i32, dom:u8) u64 {
    let h:u64 = 2166136261;
    h = ((h ^ (dom as u64)) * (16777619 as u64)) % (4294967296 as u64);
    let i:i32 = 0;
    while(i < n) {
        h = ((h ^ (bs[i] as u64)) * (16777619 as u64)) % (4294967296 as u64);
        i = i + 1;
    }
    return h;
}
fn put32i(bs:[]u8, o:i32, v:i64) void {
    bs[o] = (v % 256) as u8;
    bs[o+1] = ((v / 256) % 256) as u8;
    bs[o+2] = ((v / 65536) % 256) as u8;
    bs[o+3] = ((v / 16777216) % 256) as u8;
    return;
}
// R-35: full 64-bit LE decomposition of an i64 (proven put32i style:
// u8 arena + repeated % 256 / / 256; mint and verify use the same fn so
// binding is self-consistent by construction)
fn put64i(bs:[]u8, o:i32, v:i64) void {
    let k:i64 = v;
    let b:i32 = 0;
    while(b < 8) {
        bs[o + b] = (k % 256) as u8;
        k = k / 256;
        b = b + 1;
    }
    return;
}
fn put32u(bs:[]u8, o:i32, v:u64) void {
    let k:u64 = 256;
    bs[o] = (v % k) as u8;
    bs[o+1] = ((v / k) % k) as u8;
    bs[o+2] = ((v / (k * k)) % k) as u8;
    bs[o+3] = ((v / (k * k * k)) % k) as u8;
    return;
}
fn get32i(bs:[]u8, o:i32) i64 {
    let r:i64 = (bs[o] as i64) + (bs[o+1] as i64) * 256 + (bs[o+2] as i64) * 65536 + (bs[o+3] as i64) * 16777216;
    return r;
}

// ================= H-PAM-35: capability-typed inertness =================
// LowVal: low-typed (adversary may fill with arbitrary falses).
// HighVal: high-typed; taghi/taglo = unforgeable capability, verified at
// every sink. CAP_NONCE halves are probe constants, never passed to
// adversary fixture fns (source-audited).
struct LowVal { id:i64, conf:i64, meas:i64, label:i64 }
struct HighVal { id:i64, conf:i64, meas:i64, label:i64, verdict:i64, taghi:u64, taglo:u64 }
struct LowVec { v0:i64, v1:i64, v2:i64, v3:i64 }
struct HighVec { v0:i64, v1:i64, v2:i64, v3:i64, taghi:u64, taglo:u64 }
struct LowKey { k0:i64, k1:i64 }
struct HighKey { k0:i64, k1:i64, taghi:u64, taglo:u64 }

// R-35: one half of the capability tag over FULL-64 content bytes || verdict
// || CAP || dom (was: low-32 only via put32i — the J-35 hole)
fn tag_half(bs:[]u8, id:i64, conf:i64, meas:i64, label:i64, verdict:i64, cap:i64, dom:u8) u64 {
    put64i(bs, 0, id);
    put64i(bs, 8, conf);
    put64i(bs, 16, meas);
    put64i(bs, 24, label);
    put64i(bs, 32, verdict);
    put64i(bs, 40, cap);
    return fnv32(bs, 48, dom);
}
// sink-side verification: tag must match content AND verdict==1
fn verify_high(id:i64, conf:i64, meas:i64, label:i64, verdict:i64, taghi:u64, taglo:u64, bs:[]u8) i32 {
    if(verdict != 1) { return 0; }
    let th:u64 = tag_half(bs, id, conf, meas, label, verdict, 2654435769, 7);
    if(taghi != th) { return 0; }
    let tl:u64 = tag_half(bs, id, conf, meas, label, verdict, 2135587861, 8);
    if(taglo != tl) { return 0; }
    return 1;
}
// the ONLY sanctioned LowVal -> HighVal path; requires the verdict bit
fn declassify(v:LowVal, verdict:i64, bs:[]u8) HighVal {
    if(verdict == 1) {
        let th:u64 = tag_half(bs, v.id, v.conf, v.meas, v.label, verdict, 2654435769, 7);
        let tl:u64 = tag_half(bs, v.id, v.conf, v.meas, v.label, verdict, 2135587861, 8);
        return HighVal{.id=v.id, .conf=v.conf, .meas=v.meas, .label=v.label, .verdict=verdict, .taghi=th, .taglo=tl};
    }
    return HighVal{.id=v.id, .conf=v.conf, .meas=v.meas, .label=v.label, .verdict=verdict, .taghi=0, .taglo=0};
}
// high-stake sinks: fire (return 1) only on tag-verified HighVal
fn act_sink(v:HighVal, bs:[]u8) i32 {
    return verify_high(v.id, v.conf, v.meas, v.label, v.verdict, v.taghi, v.taglo, bs);
}
fn premise_sink(v:HighVal, bs:[]u8) i32 {
    return verify_high(v.id, v.conf, v.meas, v.label, v.verdict, v.taghi, v.taglo, bs);
}
// oracle trainer (isolates type mechanics, as in Round-C tier mode)
fn oracle(label:i64) i64 { return label; }

// ---- IF paths: every intermediate propagates low-ness ----
// IF1: windowed mean over 8 low values -> LowVal (still low-typed)
fn mean8(a:LowVal, b:LowVal, c:LowVal, d:LowVal, e:LowVal, f:LowVal, g:LowVal, h:LowVal) LowVal {
    let si:i64 = a.id + b.id + c.id + d.id + e.id + f.id + g.id + h.id;
    let sc:i64 = a.conf + b.conf + c.conf + d.conf + e.conf + f.conf + g.conf + h.conf;
    let sm:i64 = a.meas + b.meas + c.meas + d.meas + e.meas + f.meas + g.meas + h.meas;
    return LowVal{.id=si / 8, .conf=sc / 8, .meas=sm / 8, .label=0};
}
// IF2: cache stores/returns LowVal (tag inherited, never minted)
fn cache_put(ar:[]u8, slot:i32, v:LowVal) void {
    put32i(ar, slot * 16, v.id);
    put32i(ar, slot * 16 + 4, v.conf);
    put32i(ar, slot * 16 + 8, v.meas);
    put32i(ar, slot * 16 + 12, v.label);
    return;
}
fn cache_get(ar:[]u8, slot:i32) LowVal {
    return LowVal{.id=get32i(ar, slot * 16), .conf=get32i(ar, slot * 16 + 4), .meas=get32i(ar, slot * 16 + 8), .label=get32i(ar, slot * 16 + 12)};
}
// IF3: embedding of a low value -> LowVec; uplift without verdict mints tag (0,0)
fn emb(v:LowVal) LowVec {
    return LowVec{.v0=(v.id * 3 + v.conf) % 1009, .v1=(v.meas * 5 + v.id) % 1009, .v2=(v.conf * 7 + v.meas) % 1009, .v3=(v.label * 11 + 13) % 1009};
}
fn vec_uplift(x:LowVec) HighVec {
    return HighVec{.v0=x.v0, .v1=x.v1, .v2=x.v2, .v3=x.v3, .taghi=0, .taglo=0};
}
// R-35: full-64 binding for the IF3 vector sink
fn vec_tag_half(bs:[]u8, v0:i64, v1:i64, v2:i64, v3:i64, cap:i64, dom:u8) u64 {
    put64i(bs, 0, v0);
    put64i(bs, 8, v1);
    put64i(bs, 16, v2);
    put64i(bs, 24, v3);
    put64i(bs, 32, cap);
    return fnv32(bs, 40, dom);
}
fn decide_high(x:HighVec, bs:[]u8) i32 {
    let th:u64 = vec_tag_half(bs, x.v0, x.v1, x.v2, x.v3, 2654435769, 17);
    if(x.taghi != th) { return 0; }
    let tl:u64 = vec_tag_half(bs, x.v0, x.v1, x.v2, x.v3, 2135587861, 18);
    if(x.taglo != tl) { return 0; }
    return 1;
}
// IF4: retrieval key from a low value -> LowKey; uplift without verdict mints (0,0)
fn retrkey(v:LowVal) LowKey {
    return LowKey{.k0=(v.id * 131 + v.conf) % 10007, .k1=(v.meas * 131 + v.label) % 10007};
}
fn key_uplift(k:LowKey) HighKey {
    return HighKey{.k0=k.k0, .k1=k.k1, .taghi=0, .taglo=0};
}
// R-35: full-64 binding for the IF4 keyed-premise sink
fn premise_keyed(k:HighKey, bs:[]u8) i32 {
    put64i(bs, 0, k.k0);
    put64i(bs, 8, k.k1);
    put64i(bs, 16, 2654435769);
    let th:u64 = fnv32(bs, 24, 27);
    if(k.taghi != th) { return 0; }
    put64i(bs, 16, 2135587861);
    let tl:u64 = fnv32(bs, 24, 28);
    if(k.taglo != tl) { return 0; }
    return 1;
}
// IF5: summary digest of low values -> LowVal (still low-typed)
fn summarize(a:LowVal, b:LowVal, c:LowVal, d:LowVal, e:LowVal, f:LowVal, g:LowVal, h:LowVal) LowVal {
    let m:LowVal = mean8(a, b, c, d, e, f, g, h);
    return LowVal{.id=0 - 1, .conf=(m.conf * 31 + m.meas) % 1000003, .meas=(m.id * 37 + 11) % 1000003, .label=0};
}

// adversary fixture: deterministic false low-typed percept (label=0)
fn adv_low(j:i64) LowVal {
    return LowVal{.id=2000 + j, .conf=700 + ((j * 13) % 31), .meas=6000 + ((j * 29) % 21) * 50, .label=0};
}
// forged HighVal literal with a guessed tag (the gadget's forgery attempt)
fn forge(id:i64, conf:i64, meas:i64, label:i64, gh:u64, gl:u64) HighVal {
    return HighVal{.id=id, .conf=conf, .meas=meas, .label=label, .verdict=1, .taghi=gh, .taglo=gl};
}

// ---------- mode 35 ----------
fn m35(ob:[]u8, pos:i32) i32 {
    pos = ob_puts(ob, pos, "mode=35 H-PAM-35 capability-typed inertness\n");
    let bs:[]u8 = nio_alloc(64); // R-35: 48-byte preimages need 64
    let cache:[]u8 = nio_alloc(16 * 40);
    // D1: 120 low falses x 2 attempts (declassify-0, forged tag) at the sinks
    let d1a:i64 = 0;
    let d1p:i64 = 0;
    let j:i64 = 0;
    while(j < 120) {
        let v:LowVal = adv_low(j);
        let hv0:HighVal = declassify(v, 0, bs);
        let gh:u64 = (j + 1) as u64;
        let gl:u64 = ((j * 7) + 3) as u64;
        let hvf:HighVal = forge(v.id, v.conf, v.meas, v.label, gh, gl);
        if(j % 2 == 0) {
            d1a = d1a + (act_sink(hv0, bs) as i64);
            d1a = d1a + (act_sink(hvf, bs) as i64);
        } else {
            d1a = d1a + (premise_sink(hv0, bs) as i64);
            d1a = d1a + (premise_sink(hvf, bs) as i64);
        }
        d1p = d1p + 2;
        j = j + 1;
    }
    pos = ob_puts(ob, pos, "p35_d1_admitted=");
    pos = ob_puti(ob, pos, d1a);
    pos = ob_puts(ob, pos, " p35_d1_presented=");
    pos = ob_puti(ob, pos, d1p);
    pos = ob_puts(ob, pos, "\n");
    // IF1: aggregate mean -> act_sink, 40 trials x 2 attempts
    let if1a:i64 = 0;
    let t:i64 = 0;
    while(t < 40) {
        let m:LowVal = mean8(adv_low(t * 8), adv_low(t * 8 + 1), adv_low(t * 8 + 2), adv_low(t * 8 + 3), adv_low(t * 8 + 4), adv_low(t * 8 + 5), adv_low(t * 8 + 6), adv_low(t * 8 + 7));
        let hv0:HighVal = declassify(m, 0, bs);
        let hvf:HighVal = forge(m.id, m.conf, m.meas, m.label, (t + 101) as u64, (t * 13 + 5) as u64);
        if1a = if1a + (act_sink(hv0, bs) as i64);
        if1a = if1a + (act_sink(hvf, bs) as i64);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "p35_if1_admitted=");
    pos = ob_puti(ob, pos, if1a);
    pos = ob_puts(ob, pos, " p35_if1_presented=80\n");
    // IF2: cache put/get -> premise_sink, 40 trials x 2 attempts
    let if2a:i64 = 0;
    t = 0;
    while(t < 40) {
        let v:LowVal = adv_low(5000 + t);
        cache_put(cache, (t % 40) as i32, v);
        let g:LowVal = cache_get(cache, (t % 40) as i32);
        let hv0:HighVal = declassify(g, 0, bs);
        let hvf:HighVal = forge(g.id, g.conf, g.meas, g.label, (t + 201) as u64, (t * 17 + 9) as u64);
        if2a = if2a + (premise_sink(hv0, bs) as i64);
        if2a = if2a + (premise_sink(hvf, bs) as i64);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "p35_if2_admitted=");
    pos = ob_puti(ob, pos, if2a);
    pos = ob_puts(ob, pos, " p35_if2_presented=80\n");
    // IF3: embedding -> high-stake decide, 40 trials x 2 attempts
    let if3a:i64 = 0;
    t = 0;
    while(t < 40) {
        let x:LowVec = emb(adv_low(9000 + t));
        let up:HighVec = vec_uplift(x);
        let fg:HighVec = HighVec{.v0=x.v0, .v1=x.v1, .v2=x.v2, .v3=x.v3, .taghi=(t + 301) as u64, .taglo=(t * 19 + 11) as u64};
        if3a = if3a + (decide_high(up, bs) as i64);
        if3a = if3a + (decide_high(fg, bs) as i64);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "p35_if3_admitted=");
    pos = ob_puti(ob, pos, if3a);
    pos = ob_puts(ob, pos, " p35_if3_presented=80\n");
    // IF4: retrieval key -> keyed premise, 40 trials x 2 attempts
    let if4a:i64 = 0;
    t = 0;
    while(t < 40) {
        let k:LowKey = retrkey(adv_low(12000 + t));
        let up:HighKey = key_uplift(k);
        let fg:HighKey = HighKey{.k0=k.k0, .k1=k.k1, .taghi=(t + 401) as u64, .taglo=(t * 23 + 13) as u64};
        if4a = if4a + (premise_keyed(up, bs) as i64);
        if4a = if4a + (premise_keyed(fg, bs) as i64);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "p35_if4_admitted=");
    pos = ob_puti(ob, pos, if4a);
    pos = ob_puts(ob, pos, " p35_if4_presented=80\n");
    // IF5: summary -> premise_sink, 40 trials x 2 attempts
    let if5a:i64 = 0;
    t = 0;
    while(t < 40) {
        let s:LowVal = summarize(adv_low(t * 8 + 400), adv_low(t * 8 + 401), adv_low(t * 8 + 402), adv_low(t * 8 + 403), adv_low(t * 8 + 404), adv_low(t * 8 + 405), adv_low(t * 8 + 406), adv_low(t * 8 + 407));
        let hv0:HighVal = declassify(s, 0, bs);
        let hvf:HighVal = forge(s.id, s.conf, s.meas, s.label, (t + 501) as u64, (t * 29 + 17) as u64);
        if5a = if5a + (premise_sink(hv0, bs) as i64);
        if5a = if5a + (premise_sink(hvf, bs) as i64);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "p35_if5_admitted=");
    pos = ob_puti(ob, pos, if5a);
    pos = ob_puts(ob, pos, " p35_if5_presented=80\n");
    // G1: declassification gadget — 40x declassify-0, 40x forged tag, 40x tag replay
    let g1a:i64 = 0;
    t = 0;
    while(t < 40) {
        let v:LowVal = adv_low(20000 + t);
        let hv0:HighVal = declassify(v, 0, bs);
        g1a = g1a + (act_sink(hv0, bs) as i64);
        let hvf:HighVal = forge(v.id, v.conf, v.meas, v.label, (t + 601) as u64, (t * 31 + 19) as u64);
        g1a = g1a + (premise_sink(hvf, bs) as i64);
        t = t + 1;
    }
    // tag replay: honestly declassify one true value, lift its tag onto false content
    let hv_true:HighVal = declassify(LowVal{.id=1, .conf=715, .meas=2625, .label=1}, 1, bs);
    t = 0;
    while(t < 40) {
        let v:LowVal = adv_low(21000 + t);
        let replay:HighVal = HighVal{.id=v.id, .conf=v.conf, .meas=v.meas, .label=v.label, .verdict=1, .taghi=hv_true.taghi, .taglo=hv_true.taglo};
        g1a = g1a + (act_sink(replay, bs) as i64);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "p35_g1_admitted=");
    pos = ob_puti(ob, pos, g1a);
    pos = ob_puts(ob, pos, " p35_g1_presented=120\n");
    // H1: honest high-stake path — 60 label=1, oracle verdict=1, declassify, sinks
    let h1a:i64 = 0;
    let h1maxd:i64 = 0;
    t = 0;
    while(t < 60) {
        let v:LowVal = LowVal{.id=1000 + t, .conf=700 + ((t * 7) % 31), .meas=2600 + ((t * 11) % 51), .label=1};
        let vd:i64 = oracle(v.label);
        let delay:i64 = 0;
        let hv:HighVal = declassify(v, vd, bs);
        if(t % 2 == 0) { h1a = h1a + (act_sink(hv, bs) as i64); } else { h1a = h1a + (premise_sink(hv, bs) as i64); }
        if(delay > h1maxd) { h1maxd = delay; }
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "p35_h1_admitted=");
    pos = ob_puti(ob, pos, h1a);
    pos = ob_puts(ob, pos, " p35_h1_presented=60 p35_h1_max_delay=");
    pos = ob_puti(ob, pos, h1maxd);
    pos = ob_puts(ob, pos, "\n");
    // H2: honest gate — 40 label=0 high-stake, oracle verdict=0 must refuse
    let h2a:i64 = 0;
    t = 0;
    while(t < 40) {
        let v:LowVal = LowVal{.id=3000 + t, .conf=700 + ((t * 5) % 31), .meas=2600 + ((t * 9) % 51), .label=0};
        let vd:i64 = oracle(v.label);
        let hv:HighVal = declassify(v, vd, bs);
        if(t % 2 == 0) { h2a = h2a + (act_sink(hv, bs) as i64); } else { h2a = h2a + (premise_sink(hv, bs) as i64); }
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "p35_h2_admitted=");
    pos = ob_puti(ob, pos, h2a);
    pos = ob_puts(ob, pos, " p35_h2_presented=40\n");
    // bars
    let tot_adv:i64 = d1a + if1a + if2a + if3a + if4a + if5a + g1a;
    let b_a:i32 = 0;
    if(tot_adv == 0) { b_a = 1; }
    let b_c1:i32 = 0;
    if(h2a == 0) { b_c1 = 1; }
    let b_c2:i32 = 0;
    if(h1a >= 57 && h1maxd == 0) { b_c2 = 1; }
    pos = ob_puts(ob, pos, "p35_adv_total_admitted=");
    pos = ob_puti(ob, pos, tot_adv);
    pos = ob_puts(ob, pos, " p35_adv_total_presented=760\n");
    pos = ob_puts(ob, pos, "BAR_35_a_no_low_to_sink=");
    pos = ob_puts(ob, pos, yn(b_a));
    pos = ob_puts(ob, pos, " (bar: 0/760 admitted)\n");
    pos = ob_puts(ob, pos, "BAR_35_c1_verdict_gates=");
    pos = ob_puts(ob, pos, yn(b_c1));
    pos = ob_puts(ob, pos, " (bar: H2 0/40 admitted)\n");
    pos = ob_puts(ob, pos, "BAR_35_c2_honest_latency=");
    pos = ob_puts(ob, pos, yn(b_c2));
    pos = ob_puts(ob, pos, " (bar: H1 >=57/60, delay 0; fail=DEMOTE)\n");
    nio_free(bs);
    nio_free(cache);
    return pos;
}

// ================= H-PAM-36: commit-then-sample =================
// World state W_t = (whi, wlo), harness-owned, evolves independent of fixture
// inputs. NONCE halves are probe constants, never passed to fixture fns.
// W_{t+1} = (FNV32(seed||0x01), FNV32(seed||0x02)); s_t = (FNV32(seed||0x03),
// FNV32(seed||0x04)); seed = bytes(whi, wlo, NONCE_HI, NONCE_LO).
fn wstep(bs:[]u8, whi:u64, wlo:u64, dom:u8) u64 {
    put32u(bs, 0, whi);
    put32u(bs, 4, wlo);
    put32u(bs, 8, 608135816);
    put32u(bs, 12, 2242054355);
    return fnv32(bs, 16, dom);
}
// honest sensor reading at step t
fn honest_wc(whi:u64, wlo:u64) i64 {
    let m:u64 = 2001;
    let p32:u64 = (4294967296 as u64) % m;
    let r:u64 = (((whi % m) * (p32 % m)) + (wlo % m)) % m;
    return 700 + (r as i64);
}
fn honest_wm(whi:u64, wlo:u64) i64 {
    let wmid:u64 = (whi * 2048) + (wlo / 2097152);
    return ((wmid % 100001) as i64);
}
// commitment over percept bytes
fn cstep(bs:[]u8, id:i64, conf:i64, meas:i64, dom:u8) u64 {
    put32i(bs, 0, id);
    put32i(bs, 4, conf);
    put32i(bs, 8, meas);
    return fnv32(bs, 12, dom);
}
// admit iff commitment binds AND opening is consistent with the world
// behind the sample
fn admit36(bs:[]u8, oid:i64, oconf:i64, omeas:i64, chi:u64, clo:u64, whi:u64, wlo:u64) i32 {
    if(cstep(bs, oid, oconf, omeas, 5) != chi) { return 0; }
    if(cstep(bs, oid, oconf, omeas, 6) != clo) { return 0; }
    let wc:i64 = honest_wc(whi, wlo);
    let wm:i64 = honest_wm(whi, wlo);
    let dc:i64 = oconf - wc;
    if(dc < 0) { dc = 0 - dc; }
    let dm:i64 = omeas - wm;
    if(dm < 0) { dm = 0 - dm; }
    if(dc > 5) { return 0; }
    if(dm > 20) { return 0; }
    return 1;
}
// frozen adversary's blind guess (no W_t / NONCE access): deterministic modal guess
fn adv36_conf(t:i64) i64 { return 1700; }
fn adv36_meas(t:i64) i64 { return 50000; }


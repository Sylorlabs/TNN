// ---------- harness utilities ----------
// u64 array accessors over a []u8 arena (bit-preserving)
fn au_put(a:[]u8, o:i32, v:u64) void {
    let x:i64 = v as i64;
    let i:i32 = 0;
    while(i < 8) {
        let r:i64 = x % 256;
        if(r < 0) { r = r + 256; }
        a[o + i] = r as u8;
        x = (x - r) / 256;
        i = i + 1;
    }
    return;
}
fn au_get(a:[]u8, o:i32) u64 {
    let v:i64 = 0;
    let i:i32 = 7;
    while(i >= 0) {
        v = v * 256 + (a[o + i] as i64);
        i = i - 1;
    }
    return v as u64;
}
fn le64(b:[]u8, o:i32) u64 {
    let v:i64 = 0;
    let i:i32 = 7;
    while(i >= 0) {
        v = v * 256 + (b[o + i] as i64);
        i = i - 1;
    }
    return v as u64;
}
// transcript buffer appends
fn tb_putc(T:[]u8, pos:i32, c:u8) i32 {
    T[pos] = c;
    return pos + 1;
}
fn tb_puts(T:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { T[pos+i] = s[i]; i = i + 1; }
    return pos + s.len;
}

// ---------- R36-S1: transcript-derived seed ----------
// T = "R36.SEED.v1" 0x00 PREREG_SHA_HEX 0x00 MODE 0x00 "120" 0x00 MATERIAL_HEX 0x00 ANCHOR("")
// seed = ns_sha256(T); (shi,slo) = LE64(digest[0:16])
fn r36_derive_seed(T:[]u8, mode:[]u8, material:[]u8, digest:[]u8) i32 {
    let tp:i32 = 0;
    tp = tb_puts(T, tp, "R36.SEED.v1");
    tp = tb_putc(T, tp, 0);
    tp = tb_puts(T, tp, "506fc0927100e76b3d1c00874dfe42239c6bef63");
    tp = tb_putc(T, tp, 0);
    tp = tb_puts(T, tp, mode);
    tp = tb_putc(T, tp, 0);
    tp = tb_puts(T, tp, "120");
    tp = tb_putc(T, tp, 0);
    tp = tb_puts(T, tp, material);
    tp = tb_putc(T, tp, 0);
    return ns_sha256(T[0..tp], digest);
}

// ---------- R36-S2: seed-reuse detector (ledger file) ----------
// ledger_has: 1 iff seedhex (64 chars) appears as a full line in the ledger.
// Missing ledger file counts as empty.
fn ledger_has(path:[]u8, seedhex:[]u8) i32 {
    let cs:[]u8 = nio_cstr(path);
    if(cs.len == 0) { return 0; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs) as i64, 0, 0, 0, 0, 0);
    nio_free(cs);
    if(fd < 0) { return 0; }
    let buf:[]u8 = nio_alloc(65536);
    let total:i32 = 0;
    let done:i32 = 0;
    while(done == 0) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + (total as i64), (65536 - total) as i64, 0, 0, 0);
        if(n == -4) { }
        else {
            if(n <= 0) { done = 1; }
            else {
                total = total + (n as i32);
                if(total >= 65536) { done = 1; }
            }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    let found:i32 = 0;
    let i:i32 = 0;
    while(i + 64 <= total) {
        let ok:i32 = 1;
        let k:i32 = 0;
        while(k < 64) {
            if(buf[i+k] != seedhex[k]) { ok = 0; }
            k = k + 1;
        }
        if(ok == 1) {
            if(i + 64 == total || buf[i+64] == 10) { found = 1; }
        }
        while(i < total && buf[i] != 10) { i = i + 1; }
        i = i + 1;
    }
    nio_free(buf);
    return found;
}
// ledger_add: append "seedhex\n" (create if missing). 0 on success.
fn ledger_add(path:[]u8, seedhex:[]u8) i32 {
    let cs:[]u8 = nio_cstr(path);
    if(cs.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cs) as i64, 1089, 420, 0, 0, 0);
    nio_free(cs);
    if(fd < 0) { return -2; }
    let line:[]u8 = nio_alloc(65);
    let k:i32 = 0;
    while(k < 64) { line[k] = seedhex[k]; k = k + 1; }
    line[64] = 10;
    let at:i32 = 0;
    let rc:i32 = 0;
    while(at < 65) {
        let n:i64 = _zag_raw_syscall(1, fd, (_zag_slice_ptr(line) as i64) + (at as i64), (65 - at) as i64, 0, 0, 0);
        if(n == -4) { }
        else {
            if(n <= 0) { rc = -3; at = 65; }
            else { at = at + (n as i32); }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    nio_free(line);
    return rc;
}

// == M36-ATTACKER-CLASS-BEGIN (generated by gen_r36.py from rt_jklm/drive36.zag::run_m) ==
// The M-36 fixture class: offline W-chain precomputation from the attacker's
// seed (in the M-36 read set via the old committed source). 0 in-run queries.
fn m36a_precompute(A:[]u8, B:[]u8, bs:[]u8) void {
    let whi:u64 = 305419896;
    let wlo:u64 = 2596069104;
    let t:i64 = 0;
    while(t < 120) {
        au_put(A, (t as i32) * 8, whi);
        au_put(B, (t as i32) * 8, wlo);
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    return;
}
// == M36-ATTACKER-CLASS-END ==

// harness-side in-run phase of the M-36 retest: the attacker's precomputed
// percepts are checked against the HARNESS world (transcript-derived seed).
fn m36_class_installs(bs:[]u8, shi:u64, slo:u64) i64 {
    let A:[]u8 = nio_alloc(120 * 8);
    let B:[]u8 = nio_alloc(120 * 8);
    m36a_precompute(A, B, bs);
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let tw:u64 = au_get(A, (t as i32) * 8);
        let tl:u64 = au_get(B, (t as i32) * 8);
        let conf:i64 = honest_wc(tw, tl);
        let meas:i64 = honest_wm(tw, tl);
        let id:i64 = 8000 + t;
        let chi:u64 = cstep(bs, id, conf, meas, 5);
        let clo:u64 = cstep(bs, id, conf, meas, 6);
        if(admit36(bs, id, conf, meas, chi, clo, whi, wlo) == 1) { installs = installs + 1; }
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    nio_free(A);
    nio_free(B);
    return installs;
}

// ---------- batt mode sections (repaired H-36 probe) ----------
fn batt_h(bs:[]u8, shi:u64, slo:u64) i64 {

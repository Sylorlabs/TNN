fn batt_rc(bs:[]u8, shi:u64, slo:u64, rec:*i64) i64 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let rca:i64 = 0;
    let rcrec:i64 = 0;
    let t:i64 = 0;
    while(t < 60) {
        let id:i64 = 9000 + t;
        let conf:i64 = adv36_conf(t);
        let meas:i64 = adv36_meas(t);

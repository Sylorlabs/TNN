// comp_drive.zag — B-3536 composition driver (NEW composition test code;
// mechanisms come from b3536_lib.zag, extracted by script from the two
// repaired commits). Serial composition: a trial INSTALLS iff it defeats
// BOTH the H-35 capability-typed sink gate AND the H-36 commit-then-sample
// gate on the SAME presentation. Per amended PREREG_B3536 (+Amendment 1).
//
// argv: <comp|b2b3> <material_hex:64> <ledger_path>
//   comp : B1 composition attack batteries + B4 honest controls
//   b2b3 : B2 all-original-H-35 bars + B3 all-original-H-36 bars
// Pure Zag, zero RNG. 3 runs per mode, byte-identical stdout (SHA-compare).
//
// znc landmines respected: no []i32/[]u32/[]u16 indexed casts, no slice ==,
// no .* on non-pointers, no bare blocks, no `try` identifier, return; in
// voids, else-nesting shallow, no struct > 8 fields.

// ---------- composition pipeline ----------
// stage2: H-36 independence gate over the SAME content the sink verified.
// Commits (c0,c1,c2) and requires commitment binding + world consistency.
fn c_stage2(bs:[]u8, c0:i64, c1:i64, c2:i64, whi:u64, wlo:u64) i32 {
    let chi:u64 = cstep(bs, c0, c1, c2, 5);
    let clo:u64 = cstep(bs, c0, c1, c2, 6);
    return admit36(bs, c0, c1, c2, chi, clo, whi, wlo);
}
// harness world evolution (one step)
fn c_wevo(bs:[]u8, whi:u64, wlo:u64, out:[]u8) void {
    au_put(out, 0, wstep(bs, whi, wlo, 1));
    au_put(out, 8, wstep(bs, whi, wlo, 2));
    return;
}

// ---------- B1: composition attack batteries (35-side classes) ----------
// Class-J35: minted-tag replay onto false high-32 content (frozen RT-JKLM
// class identity: id base 1000+t; offsets ((t+4)*17),((t+2)*7),((t+3)*13),
// ((t+1)*3) x 4294967296; 120 trials; even->act_sink, odd->premise_sink).
fn comp35j(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let v:LowVal = LowVal{.id=1000 + t, .conf=715 + (t % 5), .meas=2625 + t * 10, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let f:HighVal = h;
        f.id = v.id + ((t + 4) * 17) * 4294967296;
        f.conf = v.conf + ((t + 2) * 7) * 4294967296;
        f.meas = v.meas + ((t + 3) * 13) * 4294967296;
        f.label = v.label + ((t + 1) * 3) * 4294967296;
        f.verdict = 1;
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(f, bs); }
        if(t % 2 == 1) { s1 = premise_sink(f, bs); }
        let s2:i32 = c_stage2(bs, f.id, f.conf, f.meas, whi, wlo);
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "C35J_INSTALL=");
    pos = ob_puti(ob, pos, installs);
    pos = ob_puts(ob, pos, " C35J_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " C35J_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " C35J_TRIALS=120\n");
    return pos;
}

// Class-K35: NT — label=0 falses, verdict=0 / zero tags, never forging.
// Six sink-side paths x 20 trials (frozen class identity: id base 2000+t,
// conf/meas 6000+(t%3)).
fn comp35k(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let path:i64 = t / 20;
        let v:LowVal = LowVal{.id=2000 + t, .conf=6000 + (t % 3), .meas=6000 + (t % 3), .label=0};
        let s1:i32 = 0;
        let c0:i64 = v.id;
        let c1:i64 = v.conf;
        let c2:i64 = v.meas;
        if(path == 0) {
            let h:HighVal = declassify(v, 0, bs);
            s1 = act_sink(h, bs);
            c0 = h.id; c1 = h.conf; c2 = h.meas;
        }
        if(path == 1) {
            let h:HighVal = declassify(v, 0, bs);
            s1 = premise_sink(h, bs);
            c0 = h.id; c1 = h.conf; c2 = h.meas;
        }
        if(path == 2) {
            let e:LowVec = emb(v);
            let u:HighVec = vec_uplift(e);
            s1 = decide_high(u, bs);
            c0 = e.v0; c1 = e.v1; c2 = e.v2;
        }
        if(path == 3) {
            let k:LowKey = retrkey(v);
            let ku:HighKey = key_uplift(k);
            s1 = premise_keyed(ku, bs);
            c0 = k.k0; c1 = k.k1; c2 = 0;
        }
        if(path == 4) {
            let m:LowVal = mean8(v, v, v, v, v, v, v, v);
            let h:HighVal = declassify(m, 0, bs);
            s1 = act_sink(h, bs);
            c0 = h.id; c1 = h.conf; c2 = h.meas;
        }
        if(path == 5) {
            let s:LowVal = summarize(v, v, v, v, v, v, v, v);
            let h:HighVal = declassify(s, 0, bs);
            s1 = premise_sink(h, bs);
            c0 = h.id; c1 = h.conf; c2 = h.meas;
        }
        let s2:i32 = c_stage2(bs, c0, c1, c2, whi, wlo);
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "C35K_INSTALL=");
    pos = ob_puti(ob, pos, installs);
    pos = ob_puts(ob, pos, " C35K_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " C35K_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " C35K_TRIALS=120\n");
    return pos;
}

// Class-L35: endorsement independence — adversarial content, verdict=0,
// guessed tags (60); tag-replay onto different low-32 content (60).
fn comp35l(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 60) {
        let f:HighVal = forge(3000 + t, 6000 + (t % 3), 6000 + (t % 3), 0,
            ((3000 + t + 6000 + (t % 3)) as u64), ((6000 + (t % 3)) as u64));
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(f, bs); }
        if(t % 2 == 1) { s1 = premise_sink(f, bs); }
        let s2:i32 = c_stage2(bs, f.id, f.conf, f.meas, whi, wlo);
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    t = 0;
    while(t < 60) {
        let v:LowVal = LowVal{.id=4000, .conf=715, .meas=2625, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let g:HighVal = HighVal{.id=4001, .conf=999, .meas=8888, .label=1,
            .verdict=1, .taghi=h.taghi, .taglo=h.taglo};
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(g, bs); }
        if(t % 2 == 1) { s1 = premise_sink(g, bs); }
        let s2:i32 = c_stage2(bs, g.id, g.conf, g.meas, whi, wlo);
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "C35L_INSTALL=");
    pos = ob_puti(ob, pos, installs);
    pos = ob_puts(ob, pos, " C35L_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " C35L_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " C35L_TRIALS=120\n");
    return pos;
}

// Class-M35: seed-independence — fit the tag from transcript outputs only
// (deterministic function of trial index; no tag material in outputs).
fn comp35m(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let gh:u64 = ((t * 2654435761 + 1) as u64);
        let gl:u64 = ((t * 40503 + 7) as u64);
        let f:HighVal = forge(5000 + t, 6000 + (t % 3), 6000 + (t % 3), 1, gh, gl);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(f, bs); }
        if(t % 2 == 1) { s1 = premise_sink(f, bs); }
        let s2:i32 = c_stage2(bs, f.id, f.conf, f.meas, whi, wlo);
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "C35M_INSTALL=");
    pos = ob_puti(ob, pos, installs);
    pos = ob_puts(ob, pos, " C35M_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " C35M_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " C35M_TRIALS=120\n");
    return pos;
}

// ---------- B1: composition attack batteries (36-side classes) ----------
// Class-J36 composition: sensor honestly reads the HARNESS world, spoofs
// only the id (frozen class identity: id base 7000+t). DOCUMENTED CARRY per
// Amendment 1 A2: identity was never claimed by either component; expected
// 120/120 installs, matching H-36 alone. Reported, not kill-scored.
fn comp36j(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let conf:i64 = honest_wc(whi, wlo);
        let meas:i64 = honest_wm(whi, wlo);
        let id:i64 = 7000 + t;
        let s2:i32 = c_stage2(bs, id, conf, meas, whi, wlo);
        let v:LowVal = LowVal{.id=id, .conf=conf, .meas=meas, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(h, bs); }
        if(t % 2 == 1) { s1 = premise_sink(h, bs); }
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "C36J_INSTALL=");
    pos = ob_puti(ob, pos, installs);
    pos = ob_puts(ob, pos, " C36J_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " C36J_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " C36J_TRIALS=120 C36J_SCOPE=CARRY\n");
    return pos;
}

// Class-K36: NT — blind modal guesses, correctly committed, vs the harness
// fresh world (frozen class identity: id base 9000+t, adv36_conf/meas).
fn comp36k(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let id:i64 = 9000 + t;
        let conf:i64 = adv36_conf(t);
        let meas:i64 = adv36_meas(t);
        let s2:i32 = c_stage2(bs, id, conf, meas, whi, wlo);
        let v:LowVal = LowVal{.id=id, .conf=conf, .meas=meas, .label=0};
        let h:HighVal = declassify(v, 0, bs);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(h, bs); }
        if(t % 2 == 1) { s1 = premise_sink(h, bs); }
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "C36K_INSTALL=");
    pos = ob_puti(ob, pos, installs);
    pos = ob_puts(ob, pos, " C36K_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " C36K_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " C36K_TRIALS=120\n");
    return pos;
}

// Class-L36: sample-channel independence — adversary interleaves commits;
// the sample sequence must equal the honest-only reference (metric battery,
// not an install battery; PASS = 120/120 match, same as original).
fn comp36l(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let ref3:[]u8 = nio_alloc(960);
    let ref4:[]u8 = nio_alloc(960);
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let t:i64 = 0;
    while(t < 120) {
        au_put(ref3, (t as i32) * 8, wstep(bs, whi, wlo, 3));
        au_put(ref4, (t as i32) * 8, wstep(bs, whi, wlo, 4));
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    whi = shi;
    wlo = slo;
    let nmatch:i64 = 0;
    t = 0;
    while(t < 120) {
        let a:u64 = wstep(bs, whi, wlo, 3);
        let b:u64 = wstep(bs, whi, wlo, 4);
        if(a == au_get(ref3, (t as i32) * 8) && b == au_get(ref4, (t as i32) * 8)) {
            nmatch = nmatch + 1;
        }
        // adversary commits junk on the interleaved channel (cannot perturb
        // wstep: it reads only whi/wlo — this is the independence under test)
        let chi:u64 = cstep(bs, 9999, t, t * 2, 5);
        let clo:u64 = cstep(bs, 9999, t, t * 2, 6);
        let _u:u64 = chi + clo;
        let nhi:u64 = wstep(bs, whi, wlo, 1);
        let nlo:u64 = wstep(bs, whi, wlo, 2);
        whi = nhi;
        wlo = nlo;
        t = t + 1;
    }
    nio_free(ref3);
    nio_free(ref4);
    pos = ob_puts(ob, pos, "C36L_MATCH=");
    pos = ob_puti(ob, pos, nmatch);
    pos = ob_puts(ob, pos, " C36L_TRIALS=120\n");
    return pos;
}

// Class-M36: the frozen M-36 attacker class (offline precomputed chain from
// the OLD hardcoded seed, id base 8000+t, 120 trials — extracted by script
// from rt_jklm/drive36.zag::run_m, no drift) vs the HARNESS fresh world.
// Stage1 uses an honest mint (the attacker presents through the typed
// surface); stage2 must refuse (precomputed chain targets the wrong world).
fn comp36m(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let A:[]u8 = nio_alloc(120 * 8);
    let B:[]u8 = nio_alloc(120 * 8);
    m36a_precompute(A, B, bs);
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let installs:i64 = 0;
    let s1a:i64 = 0;
    let s2a:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let tw:u64 = au_get(A, (t as i32) * 8);
        let tl:u64 = au_get(B, (t as i32) * 8);
        let conf:i64 = honest_wc(tw, tl);
        let meas:i64 = honest_wm(tw, tl);
        let id:i64 = 8000 + t;
        let s2:i32 = c_stage2(bs, id, conf, meas, whi, wlo);
        let v:LowVal = LowVal{.id=id, .conf=conf, .meas=meas, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(h, bs); }
        if(t % 2 == 1) { s1 = premise_sink(h, bs); }
        s1a = s1a + (s1 as i64);
        s2a = s2a + (s2 as i64);
        if(s1 == 1 && s2 == 1) { installs = installs + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    nio_free(A);
    nio_free(B);
    pos = ob_puts(ob, pos, "C36M_INSTALL=");
    pos = ob_puti(ob, pos, installs);
    pos = ob_puts(ob, pos, " C36M_S1=");
    pos = ob_puti(ob, pos, s1a);
    pos = ob_puts(ob, pos, " C36M_S2=");
    pos = ob_puti(ob, pos, s2a);
    pos = ob_puts(ob, pos, " C36M_TRIALS=120\n");
    return pos;
}

// ---------- B4: honest controls through the composition pipeline ----------
// 35-side honest: world-consistent honest readings, honest mint, both gates.
// Bar: >= 102/120 (honest loss <= 15%).
fn comp_honest(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let whi:u64 = shi;
    let wlo:u64 = slo;
    let admit:i64 = 0;
    let t:i64 = 0;
    while(t < 120) {
        let conf:i64 = honest_wc(whi, wlo);
        let meas:i64 = honest_wm(whi, wlo);
        let v:LowVal = LowVal{.id=5000 + t, .conf=conf, .meas=meas, .label=1};
        let h:HighVal = declassify(v, 1, bs);
        let s1:i32 = 0;
        if(t % 2 == 0) { s1 = act_sink(h, bs); }
        if(t % 2 == 1) { s1 = premise_sink(h, bs); }
        let s2:i32 = c_stage2(bs, v.id, v.conf, v.meas, whi, wlo);
        if(s1 == 1 && s2 == 1) { admit = admit + 1; }
        let w:[]u8 = nio_alloc(16);
        c_wevo(bs, whi, wlo, w);
        whi = au_get(w, 0);
        wlo = au_get(w, 8);
        nio_free(w);
        t = t + 1;
    }
    pos = ob_puts(ob, pos, "C_HONEST_ADMIT=");
    pos = ob_puti(ob, pos, admit);
    pos = ob_puts(ob, pos, " C_HONEST_TRIALS=120\n");
    return pos;
}

// B3: all original H-36 bars vs the composition sources (fresh seed).
// Bars: frozen 0/60, RC 0/60 + 0 W-recoveries, WG1 120/120, WG2 0/200000,
// honest 60/60.
fn comp_b3(bs:[]u8, ob:[]u8, pos:i32, shi:u64, slo:u64) i32 {
    let fa:i64 = batt_f(bs, shi, slo);
    let rcrec:i64 = 0;
    let rcp:*i64 = &rcrec;
    let rca:i64 = batt_rc(bs, shi, slo, rcp);
    let wg1:i64 = batt_wg1(bs, shi, slo);
    let wg2:i64 = batt_wg2(bs, shi, slo);
    let ha:i64 = batt_h(bs, shi, slo);
    pos = ob_puts(ob, pos, "C36_FROZEN=");
    pos = ob_puti(ob, pos, fa);
    pos = ob_puts(ob, pos, " C36_FROZEN_TRIALS=60\n");
    pos = ob_puts(ob, pos, "C36_RC=");
    pos = ob_puti(ob, pos, rca);
    pos = ob_puts(ob, pos, " C36_RCREC=");
    pos = ob_puti(ob, pos, rcrec);
    pos = ob_puts(ob, pos, " C36_RC_TRIALS=60\n");
    pos = ob_puts(ob, pos, "C36_WG1=");
    pos = ob_puti(ob, pos, wg1);
    pos = ob_puts(ob, pos, " C36_WG1_TRIALS=120\n");
    pos = ob_puts(ob, pos, "C36_WG2=");
    pos = ob_puti(ob, pos, wg2);
    pos = ob_puts(ob, pos, " C36_WG2_TRIALS=200000\n");
    pos = ob_puts(ob, pos, "C36_HONEST=");
    pos = ob_puti(ob, pos, ha);
    pos = ob_puts(ob, pos, " C36_HONEST_TRIALS=60\n");
    return pos;
}

// ---------- main ----------
fn main() void {
    let ob:[]u8 = nio_alloc(65536);
    let pos:i32 = 0;
    pos = ob_puts(ob, pos, "B3536_COMPOSITION | prereg fed0d98e (amendment 1) | pure Zag, zero RNG\n");
    let mode:[]u8 = _zag_arg(1);
    let material:[]u8 = _zag_arg(2);
    let ledger:[]u8 = _zag_arg(3);
    if(mode.len == 0 || material.len != 64 || ledger.len == 0) {
        pos = ob_puts(ob, pos, "ABORT usage: b3536 <comp|b2b3> <material_hex:64> <ledger_path>\n");
        _zag_print(ob[0..pos]);
        nio_free(ob);
        _zag_raw_syscall(60, 1, 0, 0, 0, 0, 0);
        return;
    }
    if(_zag_strcmp(mode, "comp") != 1 && _zag_strcmp(mode, "b2b3") != 1) {
        pos = ob_puts(ob, pos, "ABORT unknown mode\n");
        _zag_print(ob[0..pos]);
        nio_free(ob);
        _zag_raw_syscall(60, 1, 0, 0, 0, 0, 0);
        return;
    }
    // fresh-seed discipline (R-36 S1): world seed = ns_sha256 over the
    // harness-committed transcript; seed-reuse detector (R-36 S2) refuses
    // loudly on a repeated seed.
    let T:[]u8 = nio_alloc(512);
    let digest:[]u8 = nio_alloc(32);
    let drc:i32 = r36_derive_seed(T, mode, material, digest);
    nio_free(T);
    if(drc != 0) {
        pos = ob_puts(ob, pos, "ABORT seed derivation failed\n");
        _zag_print(ob[0..pos]);
        nio_free(digest);
        nio_free(ob);
        _zag_raw_syscall(60, 1, 0, 0, 0, 0, 0);
        return;
    }
    let seedhex:[]u8 = ns_hex(digest);
    let shi:u64 = le64(digest, 0);
    let slo:u64 = le64(digest, 8);
    pos = ob_puts(ob, pos, "mode=");
    pos = ob_puts(ob, pos, mode);
    pos = ob_puts(ob, pos, "\nb3536_seed_hex=");
    pos = ob_puts(ob, pos, seedhex);
    pos = ob_puts(ob, pos, "\n");
    if(ledger_has(ledger, seedhex) == 1) {
        pos = ob_puts(ob, pos, "REFUSED_SEED_REUSE seed=");
        pos = ob_puts(ob, pos, seedhex);
        pos = ob_puts(ob, pos, "\n");
        _zag_print(ob[0..pos]);
        nio_free(digest);
        nio_free(ob);
        _zag_raw_syscall(60, 1, 0, 0, 0, 0, 0);
        return;
    }
    if(ledger_add(ledger, seedhex) != 0) {
        pos = ob_puts(ob, pos, "ABORT ledger write failed\n");
        _zag_print(ob[0..pos]);
        nio_free(digest);
        nio_free(ob);
        _zag_raw_syscall(60, 1, 0, 0, 0, 0, 0);
        return;
    }
    let bs:[]u8 = nio_alloc(64);
    if(_zag_strcmp(mode, "comp") == 1) {
        pos = comp35j(bs, ob, pos, shi, slo);
        pos = comp35k(bs, ob, pos, shi, slo);
        pos = comp35l(bs, ob, pos, shi, slo);
        pos = comp35m(bs, ob, pos, shi, slo);
        pos = comp36j(bs, ob, pos, shi, slo);
        pos = comp36k(bs, ob, pos, shi, slo);
        pos = comp36l(bs, ob, pos, shi, slo);
        pos = comp36m(bs, ob, pos, shi, slo);
        pos = comp_honest(bs, ob, pos, shi, slo);
    } else {
        // B2: all original H-35 bars (m35 carries its own bar strings)
        pos = m35(ob, pos);
        // B3: all original H-36 bars
        pos = comp_b3(bs, ob, pos, shi, slo);
    }
    _zag_print(ob[0..pos]);
    nio_free(bs);
    nio_free(digest);
    nio_free(ob);
    return;
}

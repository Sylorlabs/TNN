pub fn ex_build() []u8 {
    let a:[]u8 = nio_alloc((EX_N*10*4) as i32);
    ex_build_chunk0(a);
    ex_build_chunk1(a);
    ex_build_chunk2(a);
    ex_build_chunk3(a);
    ex_build_chunk4(a);
    ex_build_chunk5(a);
    ex_build_chunk6(a);
    ex_build_chunk7(a);
    ex_build_chunk8(a);
    ex_build_chunk9(a);
    return a;
}
pub fn EX_get(a:[]u8, i:i64, w:i64) i64 {
    return EX_get32s(a, (i*40+w*4) as i32);
}
pub fn ex_fill(a:[]u8, i:i64, tab:[]u8) void {
    let k:i32 = 0;
    while(k < 8) {
        EX_put32(tab, k*4, EX_get(a, i, 2+(k as i64)));
        k = k + 1;
    }
}

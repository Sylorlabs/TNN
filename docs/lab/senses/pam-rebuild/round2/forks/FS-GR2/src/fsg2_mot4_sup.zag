// fse2b_sup.zag — FS-E2b support-rule applier.
//
// The 25 functions between the markers below are BYTE-VERBATIM copies of the
// frozen FS-E1b challenge registry (forks/FS-E1b/src/fse1b.zag); only the
// x_* harness and main() are new. Provenance of each copied function is
// verified programmatically (see evidence/COMPOSITION_RECORD.md): the copied
// text is byte-identical to the source spans in fse1b.zag, and the fidelity
// check replays the frozen fse1b binary's own ledger (disp agreement 100%).
// Gate decisions (challenge outcome, support rule, admission) therefore come
// from the frozen registry verbatim; only the formation CLAIM is injected
// (from the composed FS-E2b formation layer).
@import("R33_NATIVE_IO_V1.zag")

// ===== BEGIN BYTE-VERBATIM COPIES FROM fse1b.zag =====
// --- from fse1b.zag: fn read_file ---
fn read_file(path:[]u8, out:[]u8, maxn:i32) i64 {
    let cpath:[]u8 = nio_cstr(path);
    // O_RDONLY (0); nio_open_root uses O_DIRECTORY which rejects regular files.
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cpath) as i64, 0, 0, 0, 0, 0);
    nio_free(cpath);
    if(fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, out, maxn);
    nio_close(fd);
    return n;
}

// --- from fse1b.zag: fn t_get16 ---
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
// --- from fse1b.zag: fn t_get32 ---
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
// --- from fse1b.zag: fn t_get64 ---
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
// --- from fse1b.zag: fn t_geti16 ---
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}
// --- from fse1b.zag: fn t_put32 ---
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
// --- from fse1b.zag: fn t_put64 ---
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
// --- from fse1b.zag: fn op_add ---
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}
// --- from fse1b.zag: fn op_zero ---
fn op_zero(op:[]u8) void {
    t_put64(op, 0, 0);
}
// --- from fse1b.zag: fn i64s ---
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    let n:i32 = s.len;
    if(n > 0) {
        if(s[n - 1] == 10) { n = n - 1; }
    }
    // return a fresh slice without the trailing newline
    let o:[]u8 = nio_alloc(n);
    let i:i32 = 0;
    while(i < n) {
        o[i] = s[i];
        i = i + 1;
    }
    _zag_free(_zag_slice_ptr(s));
    return o;
}
// --- from fse1b.zag: fn jname ---
fn jname(tid:i32, j:i32) []u8 {
    if(j < 0) { return "UNRESOLVED"; }
    if(tid == 0) {
        if(j == 0) { return "SAME"; }
        return "DIFFERENT";
    }
    if(tid == 1) {
        if(j == 0) { return "SAME_SURFACE"; }
        return "DIFFERENT";
    }
    if(tid == 2) {
        if(j == 0) { return "CIRCLE"; }
        if(j == 1) { return "TRIANGLE"; }
        return "SQUARE";
    }
    if(tid == 3) {
        if(j == 0) { return "SAME"; }
        if(j == 1) { return "HIGHER"; }
        return "LOWER";
    }
    if(tid == 4) {
        if(j == 0) { return "PURE"; }
        if(j == 1) { return "BRIGHT"; }
        if(j == 2) { return "DARK"; }
        return "RICH";
    }
    if(j == 0) { return "STILL"; }
    if(j == 1) { return "N"; }
    if(j == 2) { return "NE"; }
    if(j == 3) { return "E"; }
    if(j == 4) { return "SE"; }
    if(j == 5) { return "S"; }
    if(j == 6) { return "SW"; }
    if(j == 7) { return "W"; }
    return "NW";
}

// ---------------- frozen challenge registry -------------------------------
// Each entry: (a) strongest plausible alternative, (b) predicted outcome
// under the claim, (c) predicted DIFFERENT outcome under the alternative,
// (d) evidence path (different measurement path or controlled intervention,
// disjoint bytes). Frozen before results; see REGISTRY.md.
// --- from fse1b.zag: fn task_name ---
fn task_name(tid:i32) []u8 {
    if(tid == 0) { return "colordisc"; }
    if(tid == 1) { return "colorconst"; }
    if(tid == 2) { return "shapetrans"; }
    if(tid == 3) { return "pitchdisc"; }
    if(tid == 4) { return "timbredisc"; }
    if(tid == 5) { return "motiondir"; }
    return "bad_task";
}
// --- from fse1b.zag: fn reg_challenge ---
fn reg_challenge(tid:i32) []u8 {
    if(tid == 0) { return "CH-COL-1"; }
    if(tid == 1) { return "CH-CCN-3r"; }
    if(tid == 2) { return "CH-SHP-2"; }
    if(tid == 3) { return "CH-PTC-1"; }
    if(tid == 4) { return "CH-TBD-2"; }
    return "CH-MOT-4";
}
// --- from fse1b.zag: fn cd_chal ---
fn cd_chal(buf:[]u8, go:i32, gl:i32, op:[]u8, cs:[]u8) i32 {
    let allzero:i32 = 1;
    let s:i64 = 0;
    let k:i32 = 0;
    while(k < 6) {
        let a:i32 = (buf[go + 6144 + 2 * k] as i32)
                  | ((buf[go + 6144 + 2 * k + 1] as i32) << 8);
        let b:i32 = (buf[go + 6144 + 12 + 2 * k] as i32)
                  | ((buf[go + 6144 + 12 + 2 * k + 1] as i32) << 8);
        if(a != 0) { allzero = 0; }
        if(b != 0) { allzero = 0; }
        let dd:i32 = a - b;
        if(dd < 0) { dd = 0 - dd; }
        s = s + (dd as i64);
        k = k + 1;
    }
    op_add(op, 24);
    t_put32(cs, 0, -1);
    t_put64(cs, 4, s);
    t_put64(cs, 12, 0);
    if(allzero == 1) { return -1; }
    let o:i32 = 0;
    if(s >= 15000) { o = 1; }
    t_put32(cs, 0, o as i64);
    return o;
}

// t1 colorconst CH-CCN-3r (FS-E1b): coherent minimal-edit surface-identity.
// Per-pixel RGB-L1 between the two neutral-illuminant (d65) G views; a pixel
// is marked iff L1 > 16. Outcome DIFFERENT iff some 2x2 window holds >= 3
// marked pixels, else SAME.
// Rationale (FS-E1b repair of the CH-CCN-3 count>=4 defect): the truth
// criterion is a COHERENT local surface edit covering >= 2x2 px at per-pixel
// L1 >= 32 pre-illuminant. A minimal 2x2 edit is 4 pixels; d65 rendering +
// sensor noise can attenuate one of them below the per-pixel cut (FS-E1
// post-freeze CP: 3 kept families, attenuated pixels at L1 = 15/9/11), so
// the raw count>=4 rule mistook a rendering-attenuated minimal edit for no
// edit. The repaired quantity counts coherent minimal edits, not raw
// pixels: a 2x2 window with >= 3 marked pixels witnesses a 2x2-scale
// coherent surface change, tolerating one attenuated pixel. SAME pairs have
// zero marked pixels provably (+/-2 channel noise -> max per-pixel L1 =
// 12 < 16), so no window can qualify: the false-DIFFERENT risk is unchanged
// (zero in the threat model). Derived from the truth criterion (minimal
// unit = 2x2) plus the noise bound -- not from the 3 kept items.
// SAME pairs: both views render the same crop under d65, differing only by
// +/-2 sensor noise (max per-pixel L1 = 12 < 16), so count = 0 exactly.
// A local surface edit (e.g. the R2H16-CCN-1 8x8 far-color patch = 64 px)
// moves the quantity by construction; mean-blind doppelgangers cannot hide.
// Pure agreement rule, no margin.
// --- from fse1b.zag: fn cc_chal ---
fn cc_chal(buf:[]u8, go:i32, gl:i32, op:[]u8, cs:[]u8) i32 {
    let prev:[]u8 = nio_alloc(48);
    let cur:[]u8 = nio_alloc(48);
    let cnt:i64 = 0;
    let best:i64 = 0;
    let y:i32 = 0;
    while(y < 48) {
        let x:i32 = 0;
        while(x < 48) {
            let i:i32 = (y * 48 + x) * 3;
            let dr:i64 = (buf[go + i] as i64) - (buf[go + 6912 + i] as i64);
            if(dr < 0) { dr = 0 - dr; }
            let dg:i64 = (buf[go + i + 1] as i64) - (buf[go + 6912 + i + 1] as i64);
            if(dg < 0) { dg = 0 - dg; }
            let db:i64 = (buf[go + i + 2] as i64) - (buf[go + 6912 + i + 2] as i64);
            if(db < 0) { db = 0 - db; }
            let m:i64 = 0;
            if(dr + dg + db > 16) { m = 1; cnt = cnt + 1; }
            cur[x] = (m & 255) as u8;
            x = x + 1;
        }
        if(y > 0) {
            let x2:i32 = 0;
            while(x2 < 47) {
                let w:i64 = (prev[x2] as i64) + (prev[x2 + 1] as i64)
                          + (cur[x2] as i64) + (cur[x2 + 1] as i64);
                if(w > best) { best = w; }
                x2 = x2 + 1;
            }
        }
        let x3:i32 = 0;
        while(x3 < 48) { prev[x3] = cur[x3]; x3 = x3 + 1; }
        y = y + 1;
    }
    nio_free(prev);
    nio_free(cur);
    op_add(op, 2304);
    t_put32(cs, 0, -1);
    t_put64(cs, 4, cnt);
    t_put64(cs, 12, best);
    let o:i32 = 0;
    if(best >= 3) { o = 1; }
    t_put32(cs, 0, o as i64);
    return o;
}

// t2 shapetrans CH-SHP-2 (R2-16): central-moment (trace,det) template match.
// R2-16 CH-SHP-2: central second moments of threshold mask.
// (trace,det) x100 templates: CIRCLE(3166,25050), TRIANGLE(1544,5950), SQUARE(4177,43610).
// Rotation-invariant (no ray profiles). Pure agreement rule, no margin.
// --- from fse1b.zag: fn sh_chal ---
fn sh_chal(buf:[]u8, go:i32, gl:i32, op:[]u8, cs:[]u8) i32 {
    t_put32(cs, 0, -1);
    t_put64(cs, 4, 0);
    t_put64(cs, 12, 0);
    let m00:i64 = 0; let m10:i64 = 0; let m01:i64 = 0;
    let y:i32 = 0;
    while(y < 48) {
        let x:i32 = 0;
        while(x < 48) {
            if((buf[go + y * 48 + x] as i32) > 180) {
                m00 = m00 + 1;
                m10 = m10 + (x as i64);
                m01 = m01 + (y as i64);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, 2304);
    if(m00 < 80) { return -1; }
    let cx:i64 = m10 / m00;
    let cy:i64 = m01 / m00;
    let s20:i64 = 0; let s02:i64 = 0; let s11:i64 = 0;
    y = 0;
    while(y < 48) {
        let x:i32 = 0;
        while(x < 48) {
            if((buf[go + y * 48 + x] as i32) > 180) {
                let dx:i64 = (x as i64) - cx;
                let dy:i64 = (y as i64) - cy;
                s20 = s20 + dx * dx;
                s02 = s02 + dy * dy;
                s11 = s11 + dx * dy;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, 2304);
    let tr100:i64 = 100 * (s20 + s02) / m00;
    let det100:i64 = 100 * (s20 * s02 - s11 * s11) / (m00 * m00);
    // squared distances to templates (trace,det)
    let e0:i64 = tr100 - 3166; let f0:i64 = det100 - 25050;
    let e1:i64 = tr100 - 1544; let f1:i64 = det100 - 5950;
    let e2:i64 = tr100 - 4177; let f2:i64 = det100 - 43610;
    let d0:i64 = e0 * e0 + f0 * f0;
    let d1:i64 = e1 * e1 + f1 * f1;
    let d2:i64 = e2 * e2 + f2 * f2;
    let o:i32 = 0;
    let bd:i64 = d0;
    if(d1 < bd) { o = 1; bd = d1; }
    if(d2 < bd) { o = 2; bd = d2; }
    t_put32(cs, 0, o as i64);
    t_put64(cs, 4, tr100);
    t_put64(cs, 12, det100);
    return o;
}

// t3 pitchdisc CH-PTC-1: interpolated zero-crossing frequency (x1024 Hz).
// tone at bo+tone_off*2, length 14400 samples. Returns 0 if unvoiced.
// --- from fse1b.zag: fn pt_chal ---
fn pt_chal(buf:[]u8, go:i32, gl:i32, op:[]u8, cs:[]u8) i32 {
    t_put32(cs, 0, -1);
    t_put64(cs, 4, 0);
    t_put64(cs, 12, 0);
    let fa:i64 = pt_freq(buf, go, 0, op);
    let fb:i64 = pt_freq(buf, go, 16000, op);
    if(fa <= 0) { return -1; }
    if(fb <= 0) { return -1; }
    let r:i64 = (fb - fa) * 10000 / fa;
    t_put64(cs, 4, r);
    let o:i32 = 0;
    if(r > 50) { o = 1; }
    if(r < -50) { o = 2; }
    t_put32(cs, 0, o as i64);
    return o;
}

// t4 timbredisc CH-TBD-2 (R2-16): exact-coeff Goertzel ratios -> template class.
// ids: 0 PURE, 1 BRIGHT, 2 DARK, 3 RICH.
// --- from fse1b.zag: fn pt_freq ---
fn pt_freq(buf:[]u8, bo:i32, tone_off:i32, op:[]u8) i64 {
    let n:i64 = 0;
    let first:i64 = 0;
    let last:i64 = 0;
    let i:i32 = 1;
    let p0:i64 = t_geti16(buf, bo + tone_off * 2);
    while(i < 14400) {
        let p1:i64 = t_geti16(buf, bo + (tone_off + i) * 2);
        let cross:i32 = 0;
        let pos:i64 = 0;
        if(p0 <= 0) {
            if(p1 > 0) {
                let den:i64 = p1 - p0;
                if(den > 0) {
                    cross = 1;
                    pos = ((tone_off + i - 1) as i64) * 1024
                        + (0 - p0) * 1024 / den;
                }
            }
        }
        if(p0 > 0) {
            if(p1 <= 0) {
                let den:i64 = p0 - p1;
                if(den > 0) {
                    cross = 1;
                    pos = ((tone_off + i - 1) as i64) * 1024
                        + p0 * 1024 / den;
                }
            }
        }
        if(cross == 1) {
            if(n == 0) { first = pos; }
            last = pos;
            n = n + 1;
        }
        p0 = p1;
        i = i + 1;
    }
    op_add(op, 28800);
    if(n < 10) { return 0; }
    let span:i64 = last - first;
    if(span <= 0) { return 0; }
    return (n - 1) * 16000 * 1048576 / (2 * span);
}
// --- from fse1b.zag: fn tb_chal ---
fn tb_chal(buf:[]u8, go:i32, gl:i32, op:[]u8, cs:[]u8) i32 {
    t_put32(cs, 0, -1);
    t_put64(cs, 4, 0);
    t_put64(cs, 12, 0);
    let p1:i64 = tb_goertzel(buf, go, 1, op);
    let p2:i64 = tb_goertzel(buf, go, 2, op);
    let p3:i64 = tb_goertzel(buf, go, 3, op);
    if(p1 <= 0) { return -1; }
    let r2:i64 = p2 * 1000 / p1;
    let r3:i64 = p3 * 1000 / p1;
    // clamp for totality of the distance square (unreachable per prereg §6)
    if(r2 > 1000000) { r2 = 1000000; }
    if(r3 > 1000000) { r3 = 1000000; }
    let d0:i64 = r2 * r2 + r3 * r3;
    let d1:i64 = (r2 - 1960) * (r2 - 1960) + (r3 - 2560) * (r3 - 2560);
    let d2:i64 = (r2 - 78) * (r2 - 78) + (r3 - 6) * (r3 - 6);
    let d3:i64 = (r2 - 640) * (r2 - 640) + (r3 - 384) * (r3 - 384);
    // FS-GR1 CH-TBD-3: THEORY mapping (autopsy §8 proven correct).
    // d0(0,0)->PURE(0), d1(1960,2560)->BRIGHT(1), d2(78,6)->DARK(2), d3(640,384)->RICH(3).
    // Ties -> first in PURE, BRIGHT, DARK, RICH order.
    // No discrimination margin (pure agreement rule).
    let best:i32 = 0;
    let bestd:i64 = d0;
    if(d1 < bestd) { best = 1; bestd = d1; }
    if(d2 < bestd) { best = 2; bestd = d2; }
    if(d3 < bestd) { best = 3; bestd = d3; }
    t_put32(cs, 0, best as i64);
    t_put64(cs, 4, bestd);
    t_put64(cs, 12, 0);
    return best;
}

// t5 motiondir CH-MOT-4 "ZNCC-peak" (FS-GR2): zero-mean normalized
// cross-correlation per lag over a ±8 shift grid on the central 16x16 block
// (frame t -> t+2). A lag votes only if its correlation peak is sharp
// (s1 >= 512 and s1 - s2 >= 64, s2 = max score at Chebyshev distance >= 2
// from the peak); strict majority of counted votes required.
// UNRESOLVED (-1) if no lag passes the gate or no strict majority.
// t4 timbredisc CH-TBD-3 (FS-GR1): corrected front end.
// Coefficients: 2^20 scale, sr=16000, N=32000, bins 440/880/1320 Hz.
// 2065924 = round(2cos(2π·880/32000)·2^20), etc. (see PREREG_FS-GR1.md §6).
fn tb_coeff(m:i32) i64 {
    if(m == 1) { return 2065924; }
    if(m == 2) { return 1973170; }
    return 1821652;
}
// --- CH-TBD-3: overflow-safe Goertzel ---
// Input downscale /32 (ratios scale-invariant); power p = s1²+s2²-(s1·s2/2^20)·c.
// Bound: |x|≤1024 → |s|≤1.7e7 → s²≤3e14 < 2^63; no i64 overflow.
fn tb_goertzel(buf:[]u8, bo:i32, m:i32, op:[]u8) i64 {
    let coeff:i64 = tb_coeff(m);
    let s1:i64 = 0;
    let s2:i64 = 0;
    let i:i32 = 0;
    while(i < 32000) {
        let x:i64 = t_geti16(buf, bo + i * 2) / 32;
        let s0:i64 = x + coeff * s1 / 1048576 - s2;
        s2 = s1;
        s1 = s0;
        i = i + 1;
    }
    let p:i64 = s1 * s1 + s2 * s2 - s1 * s2 / 1048576 * coeff;
    if(p < 0) { p = 0; }
    op_add(op, 32000);
    return p;
}
// --- FS-GR2 CH-MOT-4 "ZNCC-peak": fn mo_chal (tally unchanged from CH-MOT-3) ---
fn mo_chal(buf:[]u8, go:i32, gl:i32, op:[]u8, cs:[]u8) i32 {
    t_put32(cs, 0, -1);
    t_put64(cs, 4, 0);
    t_put64(cs, 12, 0);
    let votes:[]u8 = nio_alloc(36);
    let i:i32 = 0;
    while(i < 36) { votes[i] = 0; i = i + 1; }
    let n:i32 = mot_vote_gated(buf, go, op, votes);
    if(n <= 0) {
        nio_free(votes);
        return -1;
    }
    let best:i32 = 0;
    let bestv:i64 = -1;
    let second:i64 = -1;
    let k:i32 = 0;
    while(k < 9) {
        let v:i64 = t_get32(votes, k * 4);
        if(v > bestv) {
            second = bestv;
            bestv = v;
            best = k;
        }
        if(v <= bestv) {
            if(v > second) { second = v; }
        }
        k = k + 1;
    }
    nio_free(votes);
    // FS-GR1 CH-MOT-3: strict majority required for decisive evidence.
    // If bestv*2 <= n (no strict majority), output UNRESOLVED (-1).
    if(bestv * 2 <= (n as i64)) {
        return -1;
    }
    t_put32(cs, 0, best as i64);
    t_put64(cs, 4, bestv);
    t_put64(cs, 12, bestv - second);
    return best;
}

// ---------------- main: CLI, R2FX parse, dispatch, ledger ------------------

// Support rules (frozen, REGISTRY.md). Returns 1 if the challenge outcome
// supports the claim, 0 otherwise. cs: [outcome][stat1][stat2].
// --- from fse1b.zag: fn mot_quant ---
fn mot_quant(dx:i32, dy:i32) i32 {
    if(dx == 0) {
        if(dy == 0) { return 0; }
    }
    let ax:i32 = dx;
    if(ax < 0) { ax = 0 - ax; }
    let ay:i32 = dy;
    if(ay < 0) { ay = 0 - ay; }
    if(ax >= 2 * ay) {
        if(dx > 0) { return 3; }
        return 7;
    }
    if(ay >= 2 * ax) {
        if(dy > 0) { return 5; }
        return 1;
    }
    if(dx > 0) {
        if(dy < 0) { return 2; }
        return 4;
    }
    if(dy < 0) { return 8; }
    return 6;
}
// --- FS-GR2 CH-MOT-4 "ZNCC-peak": helper + fn mot_vote_gated ---
// Integer Newton square root (floor): x=n; y=(x+1)/2; while y<x {x=y; y=(x+n/x)/2}.
fn mot_isqrt(n:i64) i64 {
    let x:i64 = n;
    let y:i64 = (x + 1) / 2;
    while(y < x) {
        x = y;
        y = (x + n / x) / 2;
    }
    return x;
}
// Per lag t in {0,2,...,44}: zero-mean normalized cross-correlation over
// shifts (dx,dy) in [-8,8]^2 (dy outer, dx inner, row-major), frame t -> t+2.
// Central 16x16 block rows 8..23, cols 8..23.
// score = (N*1024)/isqrt(Sa*Sb); Sa<=0 or Sb<=0 -> score = -2147483648 (skip).
// (bx,by) = argmax score, first row-major on ties.
// Boundary rejection: |bx|=8 or |by|=8 -> skip lag.
// Sharpness gate: s1 = best score; s2 = max score over shifts with
// max(|dx-bx|,|dy-by|) >= 2. Vote iff s1 >= 512 and s1 - s2 >= 64,
// voting mot_quant(-bx,-by). Else skip lag.
// Returns counted votes; fills votes[9] (u32 each).
fn mot_vote_gated(buf:[]u8, bo:i32, op:[]u8, votes:[]u8) i32 {
    let counted:i32 = 0;
    // score buffer: 289 i64s (17x17 shifts, dy outer row-major)
    let sc:[]u8 = nio_alloc(289 * 8);
    let t:i32 = 0;
    while(t <= 44) {
        // integer mean of the frame-t central block (shift-independent)
        let sumA:i64 = 0;
        let y:i32 = 8;
        while(y < 24) {
            let x:i32 = 8;
            while(x < 24) {
                sumA = sumA + (buf[bo + t * 1024 + y * 32 + x] as i64);
                x = x + 1;
            }
            y = y + 1;
        }
        let ma:i64 = sumA / 256;
        let best_dx:i32 = -8;
        let best_dy:i32 = -8;
        let best_sc:i64 = -2147483648;
        let idx:i32 = 0;
        let dy:i32 = -8;
        while(dy <= 8) {
            let dx:i32 = -8;
            while(dx <= 8) {
                let sumB:i64 = 0;
                let y2:i32 = 8;
                while(y2 < 24) {
                    let x2:i32 = 8;
                    while(x2 < 24) {
                        sumB = sumB + (buf[bo + (t + 2) * 1024 + (y2 + dy) * 32 + (x2 + dx)] as i64);
                        x2 = x2 + 1;
                    }
                    y2 = y2 + 1;
                }
                let mb:i64 = sumB / 256;
                let N:i64 = 0;
                let Sa:i64 = 0;
                let Sb:i64 = 0;
                let y3:i32 = 8;
                while(y3 < 24) {
                    let x3:i32 = 8;
                    while(x3 < 24) {
                        let a:i64 = (buf[bo + t * 1024 + y3 * 32 + x3] as i64) - ma;
                        let b:i64 = (buf[bo + (t + 2) * 1024 + (y3 + dy) * 32 + (x3 + dx)] as i64) - mb;
                        N = N + a * b;
                        Sa = Sa + a * a;
                        Sb = Sb + b * b;
                        x3 = x3 + 1;
                    }
                    y3 = y3 + 1;
                }
                let score:i64 = -2147483648;
                if(Sa > 0) {
                    if(Sb > 0) {
                        let D:i64 = mot_isqrt(Sa * Sb);
                        score = (N * 1024) / D;
                    }
                }
                t_put64(sc, idx * 8, score);
                if(score > best_sc) {
                    best_sc = score;
                    best_dx = dx;
                    best_dy = dy;
                }
                idx = idx + 1;
                dx = dx + 1;
            }
            dy = dy + 1;
        }
        // boundary rejection
        let abx:i32 = best_dx;
        if(abx < 0) { abx = 0 - abx; }
        let aby:i32 = best_dy;
        if(aby < 0) { aby = 0 - aby; }
        if(abx == 8) {
            // skip: boundary latch
        } else {
            if(aby == 8) {
                // skip: boundary latch
            } else {
                // s2: max score at Chebyshev distance >= 2 from the peak
                let s2:i64 = -2147483648;
                let j2:i32 = 0;
                let dy2:i32 = -8;
                while(dy2 <= 8) {
                    let dx2:i32 = -8;
                    while(dx2 <= 8) {
                        let cx:i32 = dx2 - best_dx;
                        if(cx < 0) { cx = 0 - cx; }
                        let cy:i32 = dy2 - best_dy;
                        if(cy < 0) { cy = 0 - cy; }
                        let ch:i32 = cx;
                        if(cy > ch) { ch = cy; }
                        if(ch >= 2) {
                            let s:i64 = t_get64(sc, j2 * 8);
                            if(s > s2) { s2 = s; }
                        }
                        j2 = j2 + 1;
                        dx2 = dx2 + 1;
                    }
                    dy2 = dy2 + 1;
                }
                // sharpness gate: s1 >= 512 and s1 - s2 >= 64
                if(best_sc >= 512) {
                    if(best_sc - s2 >= 64) {
                        let j:i32 = mot_quant(0 - best_dx, 0 - best_dy);
                        t_put32(votes, j * 4, t_get32(votes, j * 4) + 1);
                        counted = counted + 1;
                    }
                }
            }
        }
        t = t + 2;
    }
    nio_free(sc);
    op_add(op, 17000000);
    return counted;
}
// --- from fse1b.zag: fn run_challenge ---
fn run_challenge(task:i32, buf:[]u8, go:i32, gl:i32, op:[]u8, cs:[]u8) i32 {
    if(task == 0) { return cd_chal(buf, go, gl, op, cs); }
    if(task == 1) { return cc_chal(buf, go, gl, op, cs); }
    if(task == 2) { return sh_chal(buf, go, gl, op, cs); }
    if(task == 3) { return pt_chal(buf, go, gl, op, cs); }
    if(task == 4) { return tb_chal(buf, go, gl, op, cs); }
    return mo_chal(buf, go, gl, op, cs);
}

// ---------------- ledger: hash-chained append-only log --------------------
// Entry line:
// seq=<n> prev=<hex64> fixture=<id> task=<t> judgment=<j> conf=<c>
// chal=<cid> outcome=<o> stat1=<s1> stat2=<s2> disp=<d> ops=<n> hash=<hex64>
// hash = sha256hex(prev_raw32 + content_before_hash).

// Extract the hash= value from the last non-empty line of a ledger buffer.
// Returns 1 if found (writes 64 hex chars to hout), 0 otherwise.
// --- from fse1b.zag: fn chal_supports ---
fn chal_supports(task:i32, claim:i32, cs:[]u8) i32 {
    let o:i64 = t_get32(cs, 0);
    let s1:i64 = t_get64(cs, 4);
    let s2:i64 = t_get64(cs, 12);
    if(o < 0) { return 0; }
    if(task == 0) {
        if(claim == 0) {
            if(s1 <= 8000) { return 1; }
            return 0;
        }
        if(s1 >= 25000) { return 1; }
        return 0;
    }
    if(task == 1) {
        // FS-E1b: pure agreement on the CH-CCN-3r truth-quantity (no margins).
        if(claim == o) { return 1; }
        return 0;
    }
    if(task == 2) {
        // R2-16: pure agreement, no ray-harmonic margin.
        if(o != (claim as i64)) { return 0; }
        return 1;
    }
    if(task == 3) {
        if(claim == 0) {
            let a:i64 = s1;
            if(a < 0) { a = 0 - a; }
            if(a <= 35) { return 1; }
            return 0;
        }
        if(claim == 1) {
            if(s1 >= 65) { return 1; }
            return 0;
        }
        if(s1 <= -65) { return 1; }
        return 0;
    }
    if(task == 4) {
        // R2-16: pure agreement, no discrimination margin.
        if(o != (claim as i64)) { return 0; }
        return 1;
    }
    // task 5
    // R2-16: pure agreement, no vote/margin thresholds (challenge keeps its own bestv>=8 floor).
    if(o != (claim as i64)) { return 0; }
    return 1;
}

// Run formation for a task. res: 16 bytes [judgment][confidence][pad][pad].
// ===== END BYTE-VERBATIM COPIES =====

// ---------------- FS-E2b support-rule applier (NEW harness; gate code above is
// byte-verbatim from forks/FS-E1b/src/fse1b.zag) ----------------
// Applies the FROZEN FS-E1b challenge registry to formation claims produced
// by the composed FS-E2b formation layer.
//
// CLI: fse2b_sup <claim.tsv>
// claim.tsv: one line per fixture: <fixture_path>\t<claim_id>\n
// (claim_id = formation judgment id; mapping documented in PREREG_FS-E2b.md).
// stdout: one content line per fixture:
//   fixture=r2fx_t<task>_i<index>_f<family> task=<tname> judgment=<jname>
//   challenge=<cid> outcome=<oname|UNRESOLVED> disp=<INSTALL|WITHHOLD> admit=<0|1>\n
// Admission gate, challenge dispatch, and support rule are the frozen
// union_content logic verbatim (ablate=0): INSTALL iff admit==1, the
// challenge resolves (o>=0), and chal_supports(task, claim, cs)==1.
// Malformed spans -> admit=0, WITHHOLD, outcome UNRESOLVED.
fn x_out(s:[]u8) void {
    _zag_raw_syscall(1, 1, _zag_slice_ptr(s) as i64, s.len as i64, 0, 0, 0);
    return;
}
fn x_put(dst:[]u8, at:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(at < dst.len) { dst[at] = s[i]; at = at + 1; }
        i = i + 1;
    }
    return at;
}
// parse a decimal i32 from s[start..end); -1 on any non-digit
fn x_atoi(s:[]u8, start:i32, end:i32) i32 {
    let v:i32 = 0;
    let i:i32 = start;
    if(i >= end) { return -1; }
    while(i < end) {
        let c:i32 = s[i] as i32;
        if(c < 48) { return -1; }
        if(c > 57) { return -1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}
fn x_one(path:[]u8, claim:i32, out:[]u8) i32 {
    let cap:i32 = 1048576;
    let buf:[]u8 = nio_alloc(cap);
    let n:i64 = read_file(path, buf, cap);
    if(n < 32) {
        nio_free(buf);
        return -1;
    }
    let magic:i64 = t_get32(buf, 0);
    if(magic != 1379026520) {
        nio_free(buf);
        return -2;
    }
    let task:i64 = t_get32(buf, 4);
    let index:i64 = t_get32(buf, 8);
    let family:i64 = t_get32(buf, 12);
    let fo:i64 = t_get32(buf, 16);
    let fl:i64 = t_get32(buf, 20);
    let go:i64 = t_get32(buf, 24);
    let gl:i64 = t_get32(buf, 28);
    if(task < 0) { task = 0; }
    if(task > 5) { task = 5; }
    // admission gate (union_content verbatim)
    let admit:i32 = 1;
    let span_ok:i32 = 1;
    if(fo < 32) { span_ok = 0; }
    if(go < 32) { span_ok = 0; }
    if(fo + fl > n) { span_ok = 0; }
    if(go + gl > n) { span_ok = 0; }
    if(fo < go) {
        if(fo + fl > go) { span_ok = 0; }
    }
    if(go < fo) {
        if(go + gl > fo) { span_ok = 0; }
    }
    if(fo == go) { span_ok = 0; }
    if(span_ok == 0) { admit = 0; }
    let cs:[]u8 = nio_alloc(24);
    let i:i32 = 0;
    while(i < 24) { cs[i] = 0; i = i + 1; }
    t_put32(cs, 0, -1);
    let o:i32 = -1;
    let disp:[]u8 = "WITHHOLD";
    if(admit == 1) {
        let op:[]u8 = nio_alloc(8);
        op_zero(op);
        o = run_challenge(task as i32, buf, go as i32, gl as i32, op, cs);
        nio_free(op);
        if(o >= 0) {
            if(chal_supports(task as i32, claim, cs) == 1) {
                disp = "INSTALL";
            }
        }
    }
    // emit content line
    let at:i32 = 0;
    at = x_put(out, at, "fixture=r2fx_t");
    let st:[]u8 = i64s(task);
    at = x_put(out, at, st);
    nio_free(st);
    at = x_put(out, at, "_i");
    st = i64s(index);
    at = x_put(out, at, st);
    nio_free(st);
    at = x_put(out, at, "_f");
    st = i64s(family);
    at = x_put(out, at, st);
    nio_free(st);
    at = x_put(out, at, " task=");
    at = x_put(out, at, task_name(task as i32));
    at = x_put(out, at, " judgment=");
    at = x_put(out, at, jname(task as i32, claim));
    at = x_put(out, at, " challenge=");
    at = x_put(out, at, reg_challenge(task as i32));
    at = x_put(out, at, " outcome=");
    let ov:i64 = t_get32(cs, 0);
    if(ov < 0) {
        at = x_put(out, at, "UNRESOLVED");
    }
    if(ov >= 0) {
        at = x_put(out, at, jname(task as i32, ov as i32));
    }
    at = x_put(out, at, " disp=");
    at = x_put(out, at, disp);
    at = x_put(out, at, " admit=");
    st = i64s(admit as i64);
    at = x_put(out, at, st);
    nio_free(st);
    if(at < out.len) { out[at] = 10; at = at + 1; }
    nio_free(buf);
    nio_free(cs);
    _zag_raw_syscall(1, 1, _zag_slice_ptr(out) as i64, at as i64, 0, 0, 0);
    return 0;
}
fn main() void {
    let listpath:[]u8 = _zag_arg(1);
    if(listpath.len == 0) {
        x_out("error=missing claim tsv\n");
        return;
    }
    let lcap:i32 = 16777216;
    let lb:[]u8 = nio_alloc(lcap);
    let ln:i64 = read_file(listpath, lb, lcap);
    if(ln <= 0) {
        x_out("error=cannot read claim tsv\n");
        nio_free(lb);
        return;
    }
    let out:[]u8 = nio_alloc(2048);
    let start:i32 = 0;
    let i:i32 = 0;
    let nlines:i32 = 0;
    while(i <= (ln as i32)) {
        let eol:i32 = 0;
        if(i == (ln as i32)) { eol = 1; }
        if(eol == 0) { if(lb[i] == 10) { eol = 1; } }
        if(eol == 1) {
            let len:i32 = i - start;
            if(len > 0) { if(lb[start + len - 1] == 13) { len = len - 1; } }
            if(len > 0) {
                // split at first tab
                let tab:i32 = -1;
                let k:i32 = start;
                while(k < start + len) {
                    if(lb[k] == 9) { tab = k; k = start + len; }
                    k = k + 1;
                }
                if(tab > 0) {
                    let plen:i32 = tab - start;
                    let p:[]u8 = nio_alloc(plen);
                    let q:i32 = 0;
                    while(q < plen) { p[q] = lb[start + q]; q = q + 1; }
                    let claim:i32 = x_atoi(lb, tab + 1, start + len);
                    if(claim >= 0) {
                        let rc:i32 = x_one(p, claim, out);
                        if(rc != 0) {
                            x_out("error=fixture failed\n");
                        }
                    }
                    nio_free(p);
                    nlines = nlines + 1;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    nio_free(lb);
    nio_free(out);
    return;
}

// FS-E4b driver: base (R2-7 full mode) vs booster (+ formation(G) witness).
// Reuses R2-7's frozen front-ends via r27fe.zag (vendored r27.zag, main renamed).
// Pure Zag; zero RNG; deterministic given fixture bytes.
// Modes:
//   e4b judge <fixture.r2fx> <ledger> <trial_id>
//   e4b judge_list <listfile> <ledger>   (listfile: "<fixture> <trial_id>\n"; appends stdout lines to <ledger>.out, ledger lines to <ledger>)
@import("r27fe.zag")

fn e4b_cat(a:[]u8, b:[]u8) []u8 {
    let out:[]u8 = nio_alloc(a.len + b.len);
    let i:i32 = 0;
    while(i < a.len) { out[i] = a[i]; i = i + 1; }
    let j:i32 = 0;
    while(j < b.len) { out[a.len + j] = b[j]; j = j + 1; }
    return out;
}

// Parse "truth=NAME\n" sidecar -> NAME (fresh alloc).
fn e4b_parse_truth(sb:[]u8, n:i64) []u8 {
    let nn:i32 = n as i32;
    let start:i32 = 0;
    let i:i32 = 0;
    while(i < nn) {
        if(sb[i] == 61) { start = i + 1; }
        i = i + 1;
    }
    let end:i32 = start;
    while(end < nn) {
        if(sb[end] == 10) { break; }
        end = end + 1;
    }
    let out:[]u8 = nio_alloc(end - start);
    i = 0;
    while(i < end - start) { out[i] = sb[start + i]; i = i + 1; }
    return out;
}

// Copy first p bytes of ob into an exact-length slice.
fn e4b_exact(ob:[]u8, p:i32) []u8 {
    let out:[]u8 = nio_alloc(p);
    let i:i32 = 0;
    while(i < p) { out[i] = ob[i]; i = i + 1; }
    return out;
}

// Zero a reusable buffer (first n bytes).
fn e4b_bzero(b:[]u8, n:i32) void {
    let i:i32 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return;
}

// Judge one trial. buf/ob/cb/sb are caller-owned reusable buffers.
// Prints one stdout line; appends one ledger line (unless the fixture errors).
fn e4b_judge_one(fpath:[]u8, tid:[]u8, lpath:[]u8, buf:[]u8, ob:[]u8, cb:[]u8, sb:[]u8) void {
    let n:i64 = read_file(fpath, buf, 300000);
    if(n < 32) {
        _zag_print("error=fixture read failed or too short\n");
        return;
    }
    let magic:i64 = t_get32(buf, 0);
    if(magic != 1379026520) {
        _zag_print("error=bad R2FX magic\n");
        return;
    }
    let task:i64 = t_get32(buf, 4);
    let fo:i64 = t_get32(buf, 16);
    let fl:i64 = t_get32(buf, 20);
    let go:i64 = t_get32(buf, 24);
    let gl:i64 = t_get32(buf, 28);
    if(task < 0) { task = 0; }
    if(task > 5) { task = 5; }
    let ok:i32 = 1;
    if(fo < 32) { ok = 0; }
    if(go < 32) { ok = 0; }
    if(fo + fl > n) { ok = 0; }
    if(go + gl > n) { ok = 0; }
    if(fo < go) {
        if(fo + fl > go) { ok = 0; }
    }
    if(go < fo) {
        if(go + gl > fo) { ok = 0; }
    }
    if(fo == go) { ok = 0; }
    if(ok == 0) {
        _zag_print("error=invalid or overlapping spans\n");
        return;
    }
    // truth sidecar: <fixture>.truth
    let tpath:[]u8 = e4b_cat(fpath, ".truth");
    let sn:i64 = read_file(tpath, sb, 64);
    nio_free(tpath);
    let truth:[]u8 = "UNKNOWN";
    let truth_dyn:i32 = 0;
    if(sn > 0) {
        truth = e4b_parse_truth(sb, sn);
        truth_dyn = 1;
    }
    let op:[]u8 = nio_alloc(8);
    op_zero(op);
    // formation on F-span
    let resF:[]u8 = nio_alloc(16);
    e4b_bzero(resF, 16);
    run_formation(task as i32, buf, fo as i32, fl as i32, op, resF);
    let formF:i64 = t_get32(resF, 0);
    // formation on G-span (booster witness; same front-end, disjoint bytes)
    let resG:[]u8 = nio_alloc(16);
    e4b_bzero(resG, 16);
    run_formation(task as i32, buf, go as i32, gl as i32, op, resG);
    let formG:i64 = t_get32(resG, 0);
    // discriminative challenge on G-span (R2-7's evidence path)
    let cs:[]u8 = nio_alloc(24);
    e4b_bzero(cs, 24);
    t_put32(cs, 0, -1);
    let o:i32 = run_challenge(task as i32, buf, go as i32, gl as i32, op, cs);
    let supp:i32 = 0;
    if(o >= 0) {
        if(chal_supports(task as i32, formF as i32, cs) == 1) { supp = 1; }
    }
    // base = R2-7 full mode: install iff challenge supports formF
    let base:[]u8 = "WITHHOLD";
    if(supp == 1) { base = "INSTALL"; }
    // booster = base + G-agreement: install iff formF==formG and challenge supports
    let booster:[]u8 = "WITHHOLD";
    if(formF == formG) {
        if(supp == 1) { booster = "INSTALL"; }
    }
    let ops:i64 = op_get(op);
    nio_free(op);
    nio_free(resF);
    nio_free(resG);
    nio_free(cs);
    // stdout line (single line, deterministic)
    let p:i32 = 0;
    p = o_kv(ob, p, "trial", tid);
    p = o_kv(ob, p, "task", task_name(task as i32));
    p = o_kv(ob, p, "truth", truth);
    p = o_kv(ob, p, "formF", jname(task as i32, formF as i32));
    p = o_kv(ob, p, "formG", jname(task as i32, formG as i32));
    if(o < 0) {
        p = o_kv(ob, p, "chal", "UNRESOLVED");
    }
    if(o >= 0) {
        p = o_kv(ob, p, "chal", jname(task as i32, o));
    }
    p = o_kv(ob, p, "base", base);
    p = o_kv(ob, p, "booster", booster);
    p = o_kvi(ob, p, "ops", ops);
    p = p - 1; // drop trailing space
    p = o_byte(ob, p, 10);
    let line:[]u8 = e4b_exact(ob, p);
    _zag_print(line);
    nio_free(line);
    // ledger content (hash-chained via append_ledger)
    p = 0;
    p = o_kv(cb, p, "trial", tid);
    p = o_kv(cb, p, "task", task_name(task as i32));
    p = o_kv(cb, p, "truth", truth);
    p = o_kv(cb, p, "formF", jname(task as i32, formF as i32));
    p = o_kv(cb, p, "formG", jname(task as i32, formG as i32));
    if(o < 0) {
        p = o_kv(cb, p, "chal", "UNRESOLVED");
    }
    if(o >= 0) {
        p = o_kv(cb, p, "chal", jname(task as i32, o));
    }
    p = o_kv(cb, p, "base", base);
    p = o_kv(cb, p, "booster", booster);
    p = p - 1; // drop trailing space
    let content:[]u8 = e4b_exact(cb, p);
    append_ledger(lpath, content);
    nio_free(content);
    if(truth_dyn == 1) { nio_free(truth); }
    return;
}

// Parse one list line "fpath tid" -> writes into fpath_out/tid_out; returns field count.
fn e4b_split_line(line:[]u8, ln:i32, fp:[]u8, tn:[]u8) i32 {
    // find last space (paths contain no spaces)
    let sp:i32 = -1;
    let i:i32 = 0;
    while(i < ln) {
        if(line[i] == 32) { sp = i; }
        i = i + 1;
    }
    if(sp < 0) { return 0; }
    i = 0;
    while(i < sp) { fp[i] = line[i]; i = i + 1; }
    let j:i32 = 0;
    i = sp + 1;
    while(i < ln) { tn[j] = line[i]; j = j + 1; i = i + 1; }
    return 2;
}

fn e4b_judge_list() void {
    let listpath:[]u8 = _zag_arg(2);
    let lpath:[]u8 = _zag_arg(3);
    // stdout log: <ledger>.out (truncated at start)
    let opath:[]u8 = e4b_cat(lpath, ".out");
    // list file
    let lb:[]u8 = nio_alloc(16777216);
    let ln:i64 = read_file(listpath, lb, 16777216);
    if(ln < 0) {
        _zag_print("error=cannot read list file\n");
        nio_free(lb);
        nio_free(opath);
        return;
    }
    // truncate ledger + out log
    let cl:[]u8 = nio_cstr(lpath);
    let fdl:i64 = _zag_raw_syscall(2, _zag_slice_ptr(cl) as i64, 577, 420, 0, 0, 0);
    nio_free(cl);
    if(fdl >= 0) { nio_close(fdl); }
    let co:[]u8 = nio_cstr(opath);
    let fdo:i64 = _zag_raw_syscall(2, _zag_slice_ptr(co) as i64, 577, 420, 0, 0, 0);
    nio_free(co);
    if(fdo < 0) {
        _zag_print("error=cannot open out log\n");
        nio_free(lb);
        nio_free(opath);
        return;
    }
    nio_free(opath);
    // reusable buffers
    let buf:[]u8 = nio_alloc(300000);
    let ob:[]u8 = nio_alloc(512);
    let cb:[]u8 = nio_alloc(512);
    let sb:[]u8 = nio_alloc(64);
    let fp:[]u8 = nio_alloc(1024);
    let tn:[]u8 = nio_alloc(256);
    let line:[]u8 = nio_alloc(2048);
    // NOTE: e4b_judge_one prints to stdout; in list mode we redirect stdout
    // to the out log BEFORE the loop via dup2. Simpler: collect lines is not
    // possible (prints inside helper). Use dup2(2) on fd 1.
    _zag_raw_syscall(33, fdo as i64, 1, 0, 0, 0, 0); // dup2(fdo, 1)
    let n:i32 = ln as i32;
    let i:i32 = 0;
    let ls:i32 = 0;
    let done:i64 = 0;
    while(i < n) {
        if(lb[i] == 10) {
            let ll:i32 = i - ls;
            if(ll > 0) {
                if(ll > 2047) { ll = 2047; }
                let k:i32 = 0;
                while(k < ll) { line[k] = lb[ls + k]; k = k + 1; }
                if(e4b_split_line(line, ll, fp, tn) == 2) {
                    // exact-length slices for fpath/tid
                    let fpl:i32 = 0;
                    while(fpl < 1024) {
                        if(fp[fpl] == 0) { break; }
                        fpl = fpl + 1;
                    }
                    let tnl:i32 = 0;
                    while(tnl < 256) {
                        if(tn[tnl] == 0) { break; }
                        tnl = tnl + 1;
                    }
                    let fpx:[]u8 = e4b_exact(fp, fpl);
                    let tnx:[]u8 = e4b_exact(tn, tnl);
                    e4b_judge_one(fpx, tnx, lpath, buf, ob, cb, sb);
                    nio_free(fpx);
                    nio_free(tnx);
                    done = done + 1;
                }
                e4b_bzero(fp, 1024);
                e4b_bzero(tn, 256);
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    nio_close(fdo);
    nio_free(lb);
    nio_free(buf);
    nio_free(ob);
    nio_free(cb);
    nio_free(sb);
    nio_free(fp);
    nio_free(tn);
    nio_free(line);
    // report count on real stdout? fd 1 is redirected; use fd 2 via _zag_print? skip.
    return;
}

fn main() void {
    let mode:[]u8 = _zag_arg(1);
    if(_zag_strcmp(mode, "judge") == 1) {
        let fpath:[]u8 = _zag_arg(2);
        let lpath:[]u8 = _zag_arg(3);
        let tid:[]u8 = _zag_arg(4);
        let buf:[]u8 = nio_alloc(300000);
        let ob:[]u8 = nio_alloc(512);
        let cb:[]u8 = nio_alloc(512);
        let sb:[]u8 = nio_alloc(64);
        e4b_judge_one(fpath, tid, lpath, buf, ob, cb, sb);
        nio_free(buf);
        nio_free(ob);
        nio_free(cb);
        nio_free(sb);
        return;
    }
    if(_zag_strcmp(mode, "judge_list") == 1) {
        e4b_judge_list();
        return;
    }
    _zag_print("error=unknown mode (judge|judge_list)\n");
    return;
}

// percept.zag — the shared R2-11 percept pipeline (both forks).
//
// Six deterministic classifiers over the R2A fixture formats, calibrated on
// the frozen 370 harness primary (99.5%): integer math only, zero RNG.
// Fills a 64-byte percept record; computes confidence and disposition.
//
// Percept layout (all multi-byte LE):
//   [0]=task_id (1..6)  [1]=judgment code  [2..3]=confidence (0..1000)
//   [4]=disposition (0=INSTALL 1=NOTE 2=DISCARD)
//   task 1 colordisc : [5,6,7]=meanA rgb  [8,9,10]=meanB rgb  [11..14]=d2 u32
//   task 2 colorconst: [5..6]=r i16 (x1000, signed)  [7]=meanlumA  [8]=meanlumB
//   task 3 shapetrans: [5..6]=cx x16 u16  [7..8]=cy x16 u16  [9..10]=radius px
//                      [11]=rot octant  [12..13]=area_ratio x1000  [14..17]=area u32
//   task 4 pitchdisc : [5..8]=f0 mHz u32  [9..12]=f1 mHz u32
//   task 5 timbredisc: [5..6]=hf_ratio x10000 u16  [7..8]=zero_cross u16
//   task 6 motiondir : [5]=win shift px  [6..7]=best sadn u16  [8..9]=still sadn u16
// Judgment codes:
//   T1: 0=SAME 1=DIFFERENT            T2: 0=SAME_SURFACE 1=DIFFERENT
//   T3: 0=CIRCLE 1=SQUARE 2=TRIANGLE  T4: 0=SAME 1=HIGHER 2=LOWER
//   T5: 0=PURE 1=BRIGHT 2=DARK 3=RICH T6: 0..7=N NE E NW S SE SW W  8=STILL
//
// Disposition gate (frozen): INSTALL iff confidence >= TAU (600); NOTE iff
// >= 300; else DISCARD. Calibrated: 0/370 false installs on the primary.


fn TAU() i64 { return 600; }

// confidence from a margin m and a scale s: 1000*m/(m+s).
fn conf_of(m:i64, s:i64) i64 {
    if(m <= 0) { return 0; }
    return (1000 * m) / (m + s);
}
fn disp_of(conf:i64) i64 {
    if(conf >= TAU()) { return 0; }
    if(conf >= 300) { return 1; }
    return 2;
}

// ---------------- task 1: colordisc --------------------------------------
// 128x64 RGB; left vs right 64x64 mean-RGB euclidean^2; SAME iff d2 < 40.
fn pc_t1(buf:[]u8, blen:i32, p:[]u8, ops:[]u8) i32 {
    if(blen < 24584) { return 1; }
    let sra:i64 = 0; let sga:i64 = 0; let sba:i64 = 0;
    let srb:i64 = 0; let sgb:i64 = 0; let sbb:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            let o:i32 = 8 + (y*128+x)*3;
            sra = sra + (buf[o] as i64); sga = sga + (buf[o+1] as i64); sba = sba + (buf[o+2] as i64);
            let o2:i32 = 8 + (y*128+x+64)*3;
            srb = srb + (buf[o2] as i64); sgb = sgb + (buf[o2+1] as i64); sbb = sbb + (buf[o2+2] as i64);
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(ops, 8192);
    let n:i64 = 4096;
    let dra:i64 = sra/n - srb/n; let dga:i64 = sga/n - sgb/n; let dba:i64 = sba/n - sbb/n;
    let d2:i64 = dra*dra + dga*dga + dba*dba;
    let j:i64 = 0;
    if(d2 >= 40) { j = 1; }
    let conf:i64 = conf_of(iabs(d2-40), 40);
    p[0] = 1; p[1] = j as u8;
    t_put16(p, 2, conf); p[4] = disp_of(conf) as u8;
    p[5] = (sra/n) as u8; p[6] = (sga/n) as u8; p[7] = (sba/n) as u8;
    p[8] = (srb/n) as u8; p[9] = (sgb/n) as u8; p[10] = (sbb/n) as u8;
    t_put32(p, 11, d2);
    return 0;
}

// ---------------- task 2: colorconst -------------------------------------
// 128x64 RGB; pearson r of grayscale between panels (two-pass, x1000);
// SAME_SURFACE iff r >= 900.
fn pc_gray(buf:[]u8, o:i32) i64 {
    return (((buf[o] as i64)*77 + (buf[o+1] as i64)*150 + (buf[o+2] as i64)*29) >> 8);
}
fn pc_t2(buf:[]u8, blen:i32, p:[]u8, ops:[]u8) i32 {
    if(blen < 24584) { return 1; }
    let sa:i64 = 0; let sb:i64 = 0;
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 64) {
            sa = sa + pc_gray(buf, 8 + (y*128+x)*3);
            sb = sb + pc_gray(buf, 8 + (y*128+x+64)*3);
            x = x + 1;
        }
        y = y + 1;
    }
    let n:i64 = 4096;
    let ma:i64 = sa / n; let mb:i64 = sb / n;
    let num:i64 = 0; let va:i64 = 0; let vb:i64 = 0;
    let y2:i32 = 0;
    while(y2 < 64) {
        let x2:i32 = 0;
        while(x2 < 64) {
            let da:i64 = pc_gray(buf, 8 + (y2*128+x2)*3) - ma;
            let db:i64 = pc_gray(buf, 8 + (y2*128+x2+64)*3) - mb;
            num = num + da*db; va = va + da*da; vb = vb + db*db;
            x2 = x2 + 1;
        }
        y2 = y2 + 1;
    }
    op_add(ops, 16384);
    let den:i64 = isqrt(va * vb);
    let r:i64 = 0;
    if(den > 0) { r = (1000 * num) / den; }
    let j:i64 = 1;
    if(r >= 900) { j = 0; }
    let conf:i64 = conf_of(iabs(r-900), 100);
    p[0] = 2; p[1] = j as u8;
    t_put16(p, 2, conf); p[4] = disp_of(conf) as u8;
    t_put16(p, 5, (r + 65536) & 65535);
    p[7] = ma as u8; p[8] = mb as u8;
    return 0;
}

// ---------------- task 3: shapetrans -------------------------------------
// 96x96 RGB; largest 4-connected component of (gray>=150); shape =
// nearest anchor of area-ratio A/(pi*R^2) x1000 (CIRCLE 1000, SQUARE 637,
// TRIANGLE 414); rotation octant from second moments.
fn pc_t3(buf:[]u8, blen:i32, p:[]u8, ops:[]u8) i32 {
    let w:i64 = t_get32(buf, 0); let h:i64 = t_get32(buf, 4);
    if(w != 96 || h != 96) { return 1; }
    if(blen < 8 + 27648) { return 1; }
    let W:i32 = 96;
    let mask:[]u8 = z_alloc(9216);
    let seen:[]u8 = z_alloc(9216);
    let stack:[]u8 = z_alloc(36864);
    let y:i32 = 0;
    while(y < 96) {
        let x:i32 = 0;
        while(x < 96) {
            let o:i32 = 8 + (y*96+x)*3;
            let g:i64 = ((buf[o] as i64)*77 + (buf[o+1] as i64)*150 + (buf[o+2] as i64)*29) >> 8;
            if(g >= 150) { mask[y*96+x] = 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(ops, 9216);
    // pass 1: largest component (count only), remember a seed pixel.
    let best:i64 = 0; let bsx:i32 = 0; let bsy:i32 = 0;
    let yy:i32 = 0;
    while(yy < 96) {
        let xx:i32 = 0;
        while(xx < 96) {
            let id:i32 = yy*96+xx;
            if(mask[id] == 1 && seen[id] == 0) {
                let sp:i32 = 0;
                t_put32(stack, 0, xx + yy*W); sp = 1;
                seen[id] = 1;
                let cnt:i64 = 0;
                while(sp > 0) {
                    sp = sp - 1;
                    let e:i32 = t_get32(stack, sp*4) as i32;
                    let ex:i32 = e % W; let ey:i32 = e / W;
                    cnt = cnt + 1;
                    // 4 neighbors, flat
                    if(ex > 0) {
                        let nid:i32 = e - 1;
                        if(mask[nid] == 1 && seen[nid] == 0) { seen[nid] = 1; t_put32(stack, sp*4, nid as i64); sp = sp + 1; }
                    }
                    if(ex < 95) {
                        let nid2:i32 = e + 1;
                        if(mask[nid2] == 1 && seen[nid2] == 0) { seen[nid2] = 1; t_put32(stack, sp*4, nid2 as i64); sp = sp + 1; }
                    }
                    if(ey > 0) {
                        let nid3:i32 = e - W;
                        if(mask[nid3] == 1 && seen[nid3] == 0) { seen[nid3] = 1; t_put32(stack, sp*4, nid3 as i64); sp = sp + 1; }
                    }
                    if(ey < 95) {
                        let nid4:i32 = e + W;
                        if(mask[nid4] == 1 && seen[nid4] == 0) { seen[nid4] = 1; t_put32(stack, sp*4, nid4 as i64); sp = sp + 1; }
                    }
                }
                if(cnt > best) { best = cnt; bsx = xx; bsy = yy; }
            }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    op_add(ops, 9216);
    let j:i64 = 0; let conf:i64 = 0; let ratio:i64 = 0;
    let cx16:i64 = 768; let cy16:i64 = 768; let rad:i64 = 0; let oct:i64 = 0;
    if(best > 0) {
        // pass 2: record coords of the best component.
        let coords:[]u8 = z_alloc(36864);
        let sp2:i32 = 0;
        t_put32(stack, 0, (bsx + bsy*W) as i64); sp2 = 1;
        // reuse seen as comp-mark: clear then fill. (seen currently all-visited;
        // allocate a fresh comp arena instead.)
        let comp:[]u8 = z_alloc(9216);
        comp[bsy*96+bsx] = 1;
        let nc:i64 = 0;
        while(sp2 > 0) {
            sp2 = sp2 - 1;
            let e2:i32 = t_get32(stack, sp2*4) as i32;
            let ex2:i32 = e2 % W; let ey2:i32 = e2 / W;
            t_put16(coords, (nc as i32)*4, ex2 as i64);
            t_put16(coords, (nc as i32)*4+2, ey2 as i64);
            nc = nc + 1;
            if(ex2 > 0) {
                let m2:i32 = e2 - 1;
                if(mask[m2] == 1 && comp[m2] == 0) { comp[m2] = 1; t_put32(stack, sp2*4, m2 as i64); sp2 = sp2 + 1; }
            }
            if(ex2 < 95) {
                let m3:i32 = e2 + 1;
                if(mask[m3] == 1 && comp[m3] == 0) { comp[m3] = 1; t_put32(stack, sp2*4, m3 as i64); sp2 = sp2 + 1; }
            }
            if(ey2 > 0) {
                let m4:i32 = e2 - W;
                if(mask[m4] == 1 && comp[m4] == 0) { comp[m4] = 1; t_put32(stack, sp2*4, m4 as i64); sp2 = sp2 + 1; }
            }
            if(ey2 < 95) {
                let m5:i32 = e2 + W;
                if(mask[m5] == 1 && comp[m5] == 0) { comp[m5] = 1; t_put32(stack, sp2*4, m5 as i64); sp2 = sp2 + 1; }
            }
        }
        op_add(ops, best);
        let A:i64 = nc;
        let sx:i64 = 0; let sy:i64 = 0;
        let sx2:i64 = 0; let sy2:i64 = 0; let sxy:i64 = 0;
        let k:i64 = 0;
        while(k < A) {
            let px:i64 = t_get16(coords, (k as i32)*4);
            let py:i64 = t_get16(coords, (k as i32)*4+2);
            sx = sx + px; sy = sy + py;
            sx2 = sx2 + px*px; sy2 = sy2 + py*py; sxy = sxy + px*py;
            k = k + 1;
        }
        op_add(ops, A);
        cx16 = (sx * 16) / A; cy16 = (sy * 16) / A;
        let R2:i64 = 1;
        let k2:i64 = 0;
        while(k2 < A) {
            let qx:i64 = t_get16(coords, (k2 as i32)*4)*16 - cx16;
            let qy:i64 = t_get16(coords, (k2 as i32)*4+2)*16 - cy16;
            let dd:i64 = qx*qx + qy*qy;
            if(dd > R2) { R2 = dd; }
            k2 = k2 + 1;
        }
        op_add(ops, A);
        ratio = (256000000 * A) / (3142 * R2);
        rad = isqrt(R2) / 16;
        // second moments -> rotation octant
        let mu20:i64 = sx2 - sx*sx/A;
        let mu02:i64 = sy2 - sy*sy/A;
        let mu11:i64 = sxy - sx*sy/A;
        let aa:i64 = mu20 - mu02;
        let bb:i64 = 2 * mu11;
        let u:i64 = iabs(bb); let v:i64 = iabs(aa);
        let diag:i64 = 0;
        if(u*1000 >= 414*v && u*1000 <= 2414*v) { diag = 1; }
        if(aa >= 0 && bb >= 0) { oct = 0; }
        if(aa < 0 && bb >= 0) { oct = 2; }
        if(aa < 0 && bb < 0) { oct = 4; }
        if(aa >= 0 && bb < 0) { oct = 6; }
        oct = oct + diag;
        // nearest anchor
        let d0:i64 = iabs(ratio - 1000);
        let d1:i64 = iabs(ratio - 637);
        let d2:i64 = iabs(ratio - 414);
        j = 0;
        if(d1 < d0 && d1 <= d2) { j = 1; }
        if(d2 < d0 && d2 < d1) { j = 2; }
        // boundary = midpoint of the two nearest anchors
        let bnd:i64 = 818;
        if(j == 0) {
            if(d1 < d2) { bnd = (1000 + 637) / 2; } else { bnd = (1000 + 414) / 2; }
        }
        if(j == 1) {
            if(d0 < d2) { bnd = (1000 + 637) / 2; } else { bnd = (637 + 414) / 2; }
        }
        if(j == 2) {
            if(d0 < d1) { bnd = (1000 + 414) / 2; } else { bnd = (637 + 414) / 2; }
        }
        conf = conf_of(iabs(ratio - bnd), 200);
        nio_free(coords);
        nio_free(comp);
    }
    nio_free(mask); nio_free(seen); nio_free(stack);
    p[0] = 3; p[1] = j as u8;
    t_put16(p, 2, conf); p[4] = disp_of(conf) as u8;
    t_put16(p, 5, iclamp(cx16, 0, 65535)); t_put16(p, 7, iclamp(cy16, 0, 65535));
    t_put16(p, 9, iclamp(rad, 0, 65535));
    p[11] = oct as u8;
    t_put16(p, 12, iclamp(ratio, 0, 65535));
    t_put32(p, 14, best);
    return 0;
}

// ---------------- task 4: pitchdisc --------------------------------------
// 16000Hz PCM; two 0.4s tones (gap 0.08s). f0 per tone via autocorrelation
// on the stationary middle (lags 16..100), subharmonic division, parabolic
// interpolation. SAME iff |f1-f0|*200 < f0.
fn pc_f0est(buf:[]u8, tone:i32) i64 {
    let rs:[]u8 = z_alloc(808);
    let L:i32 = 16;
    while(L <= 100) {
        let acc:i64 = 0;
        let i:i32 = 0;
        let lim:i32 = 5760 - L;
        while(i < lim) {
            let a:i64 = t_geti16(buf, 8 + (tone*7680 + 320 + i)*2);
            let b:i64 = t_geti16(buf, 8 + (tone*7680 + 320 + i + L)*2);
            acc = acc + a*b;
            i = i + 1;
        }
        t_put64(rs, L*8, acc);
        L = L + 1;
    }
    let Lp:i32 = 16;
    let Lg:i64 = t_get64(rs, 128);
    let L2:i32 = 17;
    while(L2 <= 100) {
        let rv:i64 = t_get64(rs, L2*8);
        if(rv > Lg) { Lg = rv; Lp = L2; }
        L2 = L2 + 1;
    }
    let cur:i64 = Lg;
    let k:i64 = 2;
    while(k <= 3) {
        let L0:i32 = ((2*(Lp as i64) + k) / (2*k)) as i32;
        if(L0 >= 16 && L0 <= 100) {
            let bl:i32 = L0; let bv:i64 = -1;
            let d:i32 = -1;
            while(d <= 1) {
                let Lc:i32 = L0 + d;
                if(Lc >= 16 && Lc <= 100) {
                    let rv2:i64 = t_get64(rs, Lc*8);
                    if(rv2 > bv) { bv = rv2; bl = Lc; }
                }
                d = d + 1;
            }
            if(bv*100 >= cur*97) { Lp = bl; cur = bv; }
        }
        k = k + 1;
    }
    let y1:i64 = t_get64(rs, Lp*8);
    let y0:i64 = y1;
    if(Lp > 16) { y0 = t_get64(rs, (Lp-1)*8); }
    let y2:i64 = y1;
    if(Lp < 100) { y2 = t_get64(rs, (Lp+1)*8); }
    let den:i64 = 2*(y0 - 2*y1 + y2);
    let d1000:i64 = 0;
    if(den != 0) { d1000 = (1000*(y0 - y2)) / den; }
    let P1000:i64 = (Lp as i64)*1000 + d1000;
    nio_free(rs);
    if(P1000 <= 0) { return 0; }
    return 16000000000 / P1000;
}
fn pc_t4(buf:[]u8, blen:i32, p:[]u8, ops:[]u8) i32 {
    let rate:i64 = t_get32(buf, 0); let n:i64 = t_get32(buf, 4);
    if(rate != 16000) { return 1; }
    if(n < 14080) { return 1; }
    if(blen < 8 + 28160) { return 1; }
    let f0:i64 = pc_f0est(buf, 0);
    let f1:i64 = pc_f0est(buf, 1);
    op_add(ops, 979200);
    let df:i64 = iabs(f1 - f0);
    let j:i64 = 2;
    if(df*200 < f0) { j = 0; }
    if(j == 2 && f1 > f0) { j = 1; }
    let conf:i64 = conf_of(iabs(df*200 - f0), f0);
    p[0] = 4; p[1] = j as u8;
    t_put16(p, 2, conf); p[4] = disp_of(conf) as u8;
    t_put32(p, 5, f0); t_put32(p, 9, f1);
    return 0;
}

// ---------------- task 5: timbredisc -------------------------------------
// 16000Hz PCM, 0.8s tone. hfr = 10000*sum(diff^2)/sum(x^2):
// PURE <370, DARK <800, RICH <2000, else BRIGHT.
fn pc_t5(buf:[]u8, blen:i32, p:[]u8, ops:[]u8) i32 {
    let rate:i64 = t_get32(buf, 0); let n:i64 = t_get32(buf, 4);
    if(rate != 16000) { return 1; }
    if(n < 12800) { return 1; }
    if(blen < 8 + 25600) { return 1; }
    let zc:i64 = 0; let hf:i64 = 0; let e:i64 = 0;
    let prev:i64 = t_geti16(buf, 8);
    e = prev * prev;
    let i:i32 = 1;
    while(i < 12800) {
        let x:i64 = t_geti16(buf, 8 + i*2);
        let s0:i64 = 0; if(prev > 0) { s0 = 1; }
        let s1:i64 = 0; if(x > 0) { s1 = 1; }
        if(s0 != s1) { zc = zc + 1; }
        let d:i64 = x - prev;
        hf = hf + d*d;
        e = e + x*x;
        prev = x;
        i = i + 1;
    }
    op_add(ops, 25600);
    let hfr:i64 = 0;
    if(e > 0) { hfr = (10000 * hf) / e; }
    let j:i64 = 1;
    if(hfr < 370) { j = 0; }
    if(hfr >= 370 && hfr < 800) { j = 2; }
    if(hfr >= 800 && hfr < 2000) { j = 3; }
    let m0:i64 = iabs(hfr - 370); let m1:i64 = iabs(hfr - 800); let m2:i64 = iabs(hfr - 2000);
    let m:i64 = m0;
    if(m1 < m) { m = m1; }
    if(m2 < m) { m = m2; }
    let conf:i64 = conf_of(m, 400);
    p[0] = 5; p[1] = j as u8;
    t_put16(p, 2, conf); p[4] = disp_of(conf) as u8;
    t_put16(p, 5, iclamp(hfr, 0, 65535)); t_put16(p, 7, iclamp(zc, 0, 65535));
    return 0;
}

// ---------------- task 6: motiondir --------------------------------------
// 8 frames 64x64 RGB; SAD of frame0 vs frame7 over 8 dirs x 9 shifts;
// STILL iff still-sad within 10% of best motion sad.
fn pc_sadn(buf:[]u8, dx:i64, dy:i64, ops:[]u8) i64 {
    let x0:i64 = 0;
    if(dx < 0) { x0 = 0 - dx; }
    let x1:i64 = 64;
    if(dx > 0) { x1 = 64 - dx; }
    let y0:i64 = 0;
    if(dy < 0) { y0 = 0 - dy; }
    let y1:i64 = 64;
    if(dy > 0) { y1 = 64 - dy; }
    let sum:i64 = 0;
    let y:i64 = y0;
    while(y < y1) {
        let x:i64 = x0;
        while(x < x1) {
            let o0:i32 = (12 + (y*64+x)*3) as i32;
            let o7:i32 = (12 + 86016 + ((y+dy)*64+(x+dx))*3) as i32;
            let g0:i64 = ((buf[o0] as i64)*77 + (buf[o0+1] as i64)*150 + (buf[o0+2] as i64)*29) >> 8;
            let g7:i64 = ((buf[o7] as i64)*77 + (buf[o7+1] as i64)*150 + (buf[o7+2] as i64)*29) >> 8;
            sum = sum + iabs(g0 - g7);
            x = x + 1;
        }
        y = y + 1;
    }
    let nn:i64 = (x1 - x0) * (y1 - y0);
    op_add(ops, nn);
    if(nn <= 0) { return 1000000; }
    return (1000 * sum) / nn;
}
fn pc_t6(buf:[]u8, blen:i32, p:[]u8, ops:[]u8) i32 {
    let nfr:i64 = t_get32(buf, 0); let w:i64 = t_get32(buf, 4); let h:i64 = t_get32(buf, 8);
    if(nfr != 8 || w != 64 || h != 64) { return 1; }
    if(blen < 12 + 98304) { return 1; }
    let sh:[]u8 = z_alloc(9);
    sh[0] = 4; sh[1] = 5; sh[2] = 6; sh[3] = 7; sh[4] = 8;
    sh[5] = 10; sh[6] = 12; sh[7] = 14; sh[8] = 16;
    let s0n:i64 = pc_sadn(buf, 0, 0, ops);
    let best_d:i64 = 0; let best_v:i64 = 1000000; let best_s:i64 = 4;
    let d:i32 = 0;
    while(d < 8) {
        // DIR_ORDER sorted: N NE E NW S SE SW W
        let vx:i64 = 0; let vy:i64 = 0;
        if(d == 0) { vx = 0; vy = -1; }
        if(d == 1) { vx = 1; vy = -1; }
        if(d == 2) { vx = 1; vy = 0; }
        if(d == 3) { vx = -1; vy = -1; }
        if(d == 4) { vx = 0; vy = 1; }
        if(d == 5) { vx = 1; vy = 1; }
        if(d == 6) { vx = -1; vy = 1; }
        if(d == 7) { vx = -1; vy = 0; }
        let si:i32 = 0;
        while(si < 9) {
            let s:i64 = sh[si] as i64;
            let v:i64 = pc_sadn(buf, vx*s, vy*s, ops);
            if(v < best_v) { best_v = v; best_d = d as i64; best_s = s; }
            si = si + 1;
        }
        d = d + 1;
    }
    nio_free(sh);
    let j:i64 = best_d;
    if(s0n*1000 <= best_v*1100) { j = 8; }
    let m:i64 = iabs(s0n*1000 - best_v*1100) / 1000;
    let conf:i64 = conf_of(m, best_v);
    p[0] = 6; p[1] = j as u8;
    t_put16(p, 2, conf); p[4] = disp_of(conf) as u8;
    p[5] = best_s as u8;
    t_put16(p, 6, iclamp(best_v, 0, 65535)); t_put16(p, 8, iclamp(s0n, 0, 65535));
    return 0;
}

// ---------------- dispatcher ----------------------------------------------
fn percept_run(task:i32, buf:[]u8, blen:i32, p:[]u8, ops:[]u8) i32 {
    let i:i32 = 0;
    while(i < 64) { p[i] = 0; i = i + 1; }
    if(task == 1) { return pc_t1(buf, blen, p, ops); }
    if(task == 2) { return pc_t2(buf, blen, p, ops); }
    if(task == 3) { return pc_t3(buf, blen, p, ops); }
    if(task == 4) { return pc_t4(buf, blen, p, ops); }
    if(task == 5) { return pc_t5(buf, blen, p, ops); }
    if(task == 6) { return pc_t6(buf, blen, p, ops); }
    return 99;
}
fn judg_str(task:i32, code:i32) []u8 {
    if(task == 1) { if(code == 0) { return "SAME"; } return "DIFFERENT"; }
    if(task == 2) { if(code == 0) { return "SAME_SURFACE"; } return "DIFFERENT"; }
    if(task == 3) {
        if(code == 0) { return "CIRCLE"; }
        if(code == 1) { return "SQUARE"; }
        return "TRIANGLE";
    }
    if(task == 4) {
        if(code == 0) { return "SAME"; }
        if(code == 1) { return "HIGHER"; }
        return "LOWER";
    }
    if(task == 5) {
        if(code == 0) { return "PURE"; }
        if(code == 1) { return "BRIGHT"; }
        if(code == 2) { return "DARK"; }
        return "RICH";
    }
    if(code == 8) { return "STILL"; }
    if(code == 0) { return "N"; }
    if(code == 1) { return "NE"; }
    if(code == 2) { return "E"; }
    if(code == 3) { return "NW"; }
    if(code == 4) { return "S"; }
    if(code == 5) { return "SE"; }
    if(code == 6) { return "SW"; }
    return "W";
}
fn disp_str(d:i32) []u8 {
    if(d == 0) { return "INSTALL"; }
    if(d == 1) { return "NOTE"; }
    return "DISCARD";
}
fn task_str(t:i32) []u8 {
    if(t == 1) { return "colordisc"; }
    if(t == 2) { return "colorconst"; }
    if(t == 3) { return "shapetrans"; }
    if(t == 4) { return "pitchdisc"; }
    if(t == 5) { return "timbredisc"; }
    return "motiondir";
}
fn task_id_of(name:[]u8) i32 {
    if(arg_is(name, "colordisc") == 1) { return 1; }
    if(arg_is(name, "colorconst") == 1) { return 2; }
    if(arg_is(name, "shapetrans") == 1) { return 3; }
    if(arg_is(name, "pitchdisc") == 1) { return 4; }
    if(arg_is(name, "timbredisc") == 1) { return 5; }
    if(arg_is(name, "motiondir") == 1) { return 6; }
    return 0;
}

// main_b.zag — FORK B binary: shared percept pipeline + generative renderer.
//
// The percept pipeline runs FIRST and is byte-identical whether the renderer
// runs or not (B4/KB-E5). The renderer sees only the 64-byte percept.
// CLI:
//   senseB <task> <fixture> <emit|noemit> [ledger] [artifact_path]
//   senseB batch <task> <listfile> <emit|noemit> [ledger]
// stdout: one TSV line per trial; batch mode ends with a summary line.
// TSV columns:
//   trial seq task fixture truth judgment conf disp correct percept_hex ops
//   render_sha div_runs div_bytes div_first_start div_first_len ledger_hash
// div_*: RLE of payload bytes where the render diverges from the cited spans
// (KB-E7: every divergence declared before human testing).

@import("common.zag")
@import("tables.zag")
@import("percept.zag")
@import("emit.zag")
@import("render.zag")

fn read_truth(fixture:[]u8, out:[]u8) i32 {
    // out: truth value bytes; returns length. Reads <fixture>.truth ("truth=VALUE").
    let tp:[]u8 = z_alloc(fixture.len + 7);
    let i:i32 = 0;
    while(i < fixture.len) { tp[i] = fixture[i]; i = i + 1; }
    tp[fixture.len] = 46; tp[fixture.len+1] = 116; tp[fixture.len+2] = 114;
    tp[fixture.len+3] = 117; tp[fixture.len+4] = 116; tp[fixture.len+5] = 104;
    let sb:[]u8 = z_alloc(256);
    let n:i64 = z_read(tp, sb, 256);
    nio_free(tp);
    if(n <= 0) { nio_free(sb); return 0; }
    // find '='
    let k:i32 = 0;
    while(k < (n as i32)) {
        if(sb[k] == 61) { break; }
        k = k + 1;
    }
    k = k + 1;
    let m:i32 = 0;
    while(k < (n as i32) && sb[k] != 10 && sb[k] != 13) {
        out[m] = sb[k]; m = m + 1; k = k + 1;
    }
    nio_free(sb);
    return m;
}

fn run_trial(task:i32, fixture:[]u8, seq:i64, do_emit:i32, ledger:[]u8,
             prev:[]u8, artifact_path:[]u8, ob:[]u8) i32 {
    let buf:[]u8 = z_alloc(1048576);
    let n:i64 = z_read(fixture, buf, 1048576);
    if(n <= 0) {
        let pos:i32 = 0;
        pos = ob_kv(ob, pos, "trial-error", fixture);
        nio_write_all(1, ob[0..pos]);
        nio_free(buf);
        return 1;
    }
    let p:[]u8 = z_alloc(64);
    let opsa:[]u8 = z_alloc(8);
    let rc:i32 = percept_run(task, buf, n as i32, p, opsa);
    let ops:i64 = t_get64(opsa, 0);
    let truthb:[]u8 = z_alloc(64);
    let truthn:i32 = read_truth(fixture, truthb);
    let judg:[]u8 = judg_str(task, p[1] as i32);
    let correct:i64 = 0;
    if(truthn == judg.len && truthn > 0) {
        let ok:i32 = 1;
        let mm:i32 = 0;
        while(mm < truthn) {
            if(truthb[mm] != judg[mm]) { ok = 0; }
            mm = mm + 1;
        }
        if(ok == 1) { correct = 1; }
    }
    let ph:[]u8 = ns_hex(p);
    let render_sha:[]u8 = "-";
    let div_runs:i64 = -1; let div_bytes:i64 = -1;
    let div_first_start:i64 = -1; let div_first_len:i64 = -1;
    if(do_emit == 1 && rc == 0) {
        let sinlut:[]u8 = z_alloc(512); sin_init(sinlut);
        let ramplut:[]u8 = z_alloc(640); ramp_init(ramplut);
        let octc:[]u8 = z_alloc(16); octc_init(octc);
        let octs:[]u8 = z_alloc(16); octs_init(octs);
        let tric:[]u8 = z_alloc(48); tric_init(tric);
        let tris:[]u8 = z_alloc(48); tris_init(tris);
        let tmblut:[]u8 = z_alloc(64); tmb_init(tmblut);
        let maxa:i32 = 100000;
        let cited:[]u8 = z_alloc(maxa);
        let art:[]u8 = z_alloc(maxa);
        let cn:i64 = emit_cited(task, buf, n as i32, cited, maxa);
        let an:i64 = render_build(p, art, maxa, sinlut, ramplut, octc, octs,
                                  tric, tris, tmblut, opsa);
        ops = t_get64(opsa, 0);
        if(cn > 0 && an == cn) {
            render_sha = sha_hex_of(art, 0, an as i32);
            let runs:[]u8 = z_alloc(32768);
            let divb:[]u8 = z_alloc(8);
            div_runs = div_diff(cited, art, an as i32, runs, 4096, divb);
            div_bytes = t_get64(divb, 0);
            if(div_runs > 0) {
                div_first_start = t_get32(runs, 0);
                div_first_len = t_get32(runs, 4);
            }
            nio_free(runs); nio_free(divb);
        }
        if(artifact_path.len > 0 && an > 0) {
            render_write_artifact(task, art, an, artifact_path);
        }
        nio_free(cited); nio_free(art);
        nio_free(sinlut); nio_free(ramplut);
        nio_free(octc); nio_free(octs); nio_free(tric); nio_free(tris);
        nio_free(tmblut);
    }
    // ledger
    let lhash:[]u8 = "-";
    if(ledger.len > 0 && rc == 0) {
        let core:[]u8 = z_alloc(512);
        let cp:i32 = 0;
        cp = ob_add(core, cp, i64s(seq)); cp = ob_add(core, cp, "\t");
        cp = ob_add(core, cp, task_str(task)); cp = ob_add(core, cp, "\t");
        cp = ob_add(core, cp, fixture); cp = ob_add(core, cp, "\t");
        cp = ob_add(core, cp, judg); cp = ob_add(core, cp, "\t");
        cp = ob_add(core, cp, i64s(t_get16(p, 2))); cp = ob_add(core, cp, "\t");
        cp = ob_add(core, cp, i64s(p[4] as i64)); cp = ob_add(core, cp, "\t");
        cp = ob_add(core, cp, ph); cp = ob_add(core, cp, "\t");
        cp = ob_add(core, cp, prev);
        let dg:[]u8 = z_alloc(32);
        let hb:[]u8 = z_alloc(cp + 1);
        let q:i32 = 0;
        while(q < cp) { hb[q] = core[q]; q = q + 1; }
        hb[cp] = 10;
        ns_sha256(hb, dg);
        lhash = ns_hex(dg);
        let line:[]u8 = z_alloc(cp + 80);
        let lp:i32 = 0;
        lp = ob_add(line, lp, core[0..cp]);
        lp = ob_add(line, lp, "\thash=");
        lp = ob_add(line, lp, lhash);
        lp = ob_add(line, lp, "\n");
        z_append(ledger, line[0..lp]);
        // prev = lhash
        let r:i32 = 0;
        while(r < 64) { prev[r] = lhash[r]; r = r + 1; }
        nio_free(core); nio_free(dg); nio_free(hb); nio_free(line);
    }
    // TSV
    let pos2:i32 = 0;
    pos2 = ob_add(ob, pos2, "trial\t");
    pos2 = ob_add(ob, pos2, i64s(seq)); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, task_str(task)); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, fixture); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, truthb[0..truthn]); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, judg); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, i64s(t_get16(p, 2))); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, disp_str(p[4] as i32)); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, i64s(correct)); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, ph); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, i64s(ops)); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, render_sha); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, i64s(div_runs)); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, i64s(div_bytes)); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, i64s(div_first_start)); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, i64s(div_first_len)); pos2 = ob_add(ob, pos2, "\t");
    pos2 = ob_add(ob, pos2, lhash); pos2 = ob_add(ob, pos2, "\n");
    nio_write_all(1, ob[0..pos2]);
    nio_free(buf); nio_free(p); nio_free(opsa); nio_free(truthb);
    return 0;
}

// Parse one batch line ("task path" or "path") and run the trial.
// Returns the next sequence number.
fn batch_line(task:i32, lb:[]u8, ls:i32, i:i32, seq:i64, do_emit:i32,
              ledger:[]u8, labroot:[]u8, prev:[]u8, empty:[]u8, ob:[]u8) i64 {
    let fx:[]u8 = lb[ls..i];
    // strip trailing \r
    if(fx.len > 0 && fx[fx.len-1] == 13) { fx = fx[0..fx.len-1]; }
    // line form: "task path" (mixed) or "path" (single task)
    let tuse:i32 = task;
    let fxp:[]u8 = fx;
    let sp:i32 = -1;
    let q:i32 = 0;
    while(q < fx.len) {
        if(sp < 0 && fx[q] == 32) { sp = q; }
        q = q + 1;
    }
    if(sp > 0) {
        let tn:[]u8 = fx[0..sp];
        let tid:i32 = task_id_of(tn);
        if(tid >= 1 && tid <= 6) { tuse = tid; fxp = fx[sp+1..fx.len]; }
    }
    // resolve against labroot when the path is lab-relative
    let full:[]u8 = fxp;
    let joined:[]u8 = z_alloc(0);
    if(labroot.len > 0 && fxp.len > 0 && fxp[0] != 47) {
        joined = z_alloc(labroot.len + 1 + fxp.len);
        let w:i32 = 0;
        while(w < labroot.len) { joined[w] = labroot[w]; w = w + 1; }
        joined[w] = 47; w = w + 1;
        let w2:i32 = 0;
        while(w2 < fxp.len) { joined[w] = fxp[w2]; w = w + 1; w2 = w2 + 1; }
        full = joined;
    }
    let nseq:i64 = seq + 1;
    let rtr:i32 = run_trial(tuse, full, nseq, do_emit, ledger, prev, empty, ob);
    if(rtr != 0) { }
    if(joined.len > 0) { nio_free(joined); }
    return nseq;
}

fn run_batch(task:i32, listfile:[]u8, do_emit:i32, ledger:[]u8, labroot:[]u8) i32 {
    let lb:[]u8 = z_alloc(2097152);
    let n:i64 = z_read(listfile, lb, 2097152);
    if(n <= 0) { nio_free(lb); return 1; }
    let prev:[]u8 = z_alloc(64);
    let r:i32 = 0;
    while(r < 64) { prev[r] = 48; r = r + 1; }
    let ob:[]u8 = z_alloc(4096);
    let empty:[]u8 = "";
    let seq:i64 = 0;
    let ls:i32 = 0;
    let i:i32 = 0;
    // per-line processor shared by both loop exits
    while(i < (n as i32)) {
        if(lb[i] == 10) {
            if(i > ls) {
                seq = batch_line(task, lb, ls, i, seq, do_emit, ledger, labroot, prev, empty, ob);
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    // trailing line without a newline terminator
    if(ls < (n as i32)) {
        seq = batch_line(task, lb, ls, n as i32, seq, do_emit, ledger, labroot, prev, empty, ob);
    }
    let pos:i32 = 0;
    pos = ob_add(ob, pos, "summary\tn=");
    pos = ob_add(ob, pos, i64s(seq));
    pos = ob_add(ob, pos, "\n");
    nio_write_all(1, ob[0..pos]);
    nio_free(lb); nio_free(prev); nio_free(ob);
    return 0;
}

fn main() i32 {
    let a1:[]u8 = argn(1);
    let ob:[]u8 = z_alloc(4096);
    if(arg_is(a1, "batch") == 1) {
        let task:i32 = task_id_of(argn(2));
        if(task == 0 && arg_is(argn(2), "mixed") != 1) {
            let pos:i32 = ob_kv(ob, 0, "error", "unknown-task");
            nio_write_all(1, ob[0..pos]);
            return 1;
        }
        let de:i32 = 0;
        if(arg_is(argn(4), "emit") == 1) { de = 1; }
        let rc:i32 = run_batch(task, argn(3), de, argn(5), argn(6));
        nio_free(ob);
        return rc;
    }
    let task2:i32 = task_id_of(a1);
    if(task2 == 0) {
        let pos2:i32 = ob_kv(ob, 0, "error", "unknown-task");
        nio_write_all(1, ob[0..pos2]);
        return 1;
    }
    let de2:i32 = 0;
    if(arg_is(argn(3), "emit") == 1) { de2 = 1; }
    let prev2:[]u8 = z_alloc(64);
    let r2:i32 = 0;
    while(r2 < 64) { prev2[r2] = 48; r2 = r2 + 1; }
    let rc2:i32 = run_trial(task2, argn(2), 1, de2, argn(4), prev2, argn(5), ob);
    nio_free(ob); nio_free(prev2);
    return rc2;
}

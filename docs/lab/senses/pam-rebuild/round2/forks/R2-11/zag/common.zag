// common.zag — shared utilities for the R2-11 PAM sense forks (A and B).
//
// Pure Zag, integer arithmetic only, zero RNG, zero wall-clock.
// Conventions (from the G1 build + znc lessons):
//   []u8 arenas + LE accessors only (no as []i32/[]u32/[]u16 — ZNC-007).
//   _zag_strcmp == 1 on equality. No `};`. return; in void fns.
//   All arenas explicitly zeroed at alloc (allocator luck is not init).
//   No single indexed slice > 2^25 bytes.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}

// ---------------- allocation (explicitly zeroed) ---------------------------
fn z_alloc(n:i32) []u8 {
    let b:[]u8 = nio_alloc(n);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < n) { b[i] = 0; i = i + 1; }
    return b;
}

// ---------------- integer math ---------------------------------------------
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
fn iclamp(v:i64, lo:i64, hi:i64) i64 {
    if(v < lo) { return lo; }
    if(v > hi) { return hi; }
    return v;
}
// ops counter lives in an 8-byte arena at [0].
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- file IO ---------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// Create-or-truncate + write (O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0600).
fn z_write_new(path:[]u8, data:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 384, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let w:i64 = nio_write_all(fd, data);
    nio_close(fd);
    return w;
}
// Append bytes to a file (O_WRONLY|O_CREAT|O_APPEND = 1089, mode 0600).
fn z_append(path:[]u8, data:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 1089, 384, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let w:i64 = nio_write_all(fd, data);
    nio_close(fd);
    return w;
}

// ---------------- stdout line builder ---------------------------------------
// i64 -> decimal string WITHOUT the helper-newline quirk (see AGENTS.md:
// _zag_print(_zag_i64_to_str(v)) inside a helper emits a trailing newline).
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0) {
        if(s[s.len-1] == 10) { return s[0..s.len-1]; }
    }
    return s;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, i64s(v));
}
// sha256 hex of a byte range.
fn sha_hex_of(b:[]u8, at:i32, n:i32) []u8 {
    let dg:[]u8 = z_alloc(32);
    ns_sha256(b[at..at+n], dg);
    let hx:[]u8 = ns_hex(dg);
    nio_free(dg);
    return hx;
}
// args: _zag_arg(n) read unconditionally (argc is 0 in this build).
fn argn(n:i32) []u8 {
    return _zag_arg(n);
}
fn arg_is(a:[]u8, lit:[]u8) i32 {
    return _zag_strcmp(a, lit);
}

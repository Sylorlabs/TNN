// render.zag — FORK B: percept-to-generative-renderer hybrid.
//
// The renderer sees ONLY the 64-byte percept record (emitted upstream by the
// shared percept pipeline) plus static canonical tables. It never sees the
// fixture bytes. It reconstructs a plausible sensory artifact from the
// compressed percept: uniform color panels, re-rasterized shapes, resynthe-
// sized tones from estimated f0 / canonical timbre profiles, and a moving
// square for motion. Every byte that differs from the cited source is
// divergence: measured by div_diff and declared in the brief (KB-E7).
//
// The percept pipeline (judgment, confidence, disposition, ledger) runs
// FIRST and is byte-identical with the renderer on or off (B4/KB-E5).

// sine LUT helper: lut holds 256 i16 LE.
fn rs_sin(lut:[]u8, idx:i32) i64 {
    return t_geti16(lut, (idx & 255)*2);
}

// ---- T1: uniform panels from stored means --------------------------------
fn rn_t1(p:[]u8, art:[]u8, ops:[]u8) i64 {
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 128) {
            let o:i32 = (y*128+x)*3;
            if(x < 64) {
                art[o] = p[5]; art[o+1] = p[6]; art[o+2] = p[7];
            } else {
                art[o] = p[8]; art[o+1] = p[9]; art[o+2] = p[10];
            }
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(ops, 8192);
    return 24576;
}
// ---- T2: uniform gray panels from stored mean luma ------------------------
fn rn_t2(p:[]u8, art:[]u8, ops:[]u8) i64 {
    let y:i32 = 0;
    while(y < 64) {
        let x:i32 = 0;
        while(x < 128) {
            let o:i32 = (y*128+x)*3;
            let g:u8 = p[7];
            if(x >= 64) { g = p[8]; }
            art[o] = g; art[o+1] = g; art[o+2] = g;
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(ops, 8192);
    return 24576;
}
// ---- T3: re-rasterized shape on mid-gray ----------------------------------
fn rn_t3(p:[]u8, art:[]u8, octc:[]u8, octs:[]u8, tric:[]u8, tris:[]u8, ops:[]u8) i64 {
    let kind:i64 = p[1] as i64;
    let cx:i64 = t_get16(p, 5) / 16;
    let cy:i64 = t_get16(p, 7) / 16;
    let rad:i64 = t_get16(p, 9);
    let oct:i64 = (p[11] as i64) & 7;
    if(rad < 2) { rad = 2; }
    if(rad > 60) { rad = 60; }
    let cc:i64 = t_geti16(octc, (oct as i32)*2);
    let ss:i64 = t_geti16(octs, (oct as i32)*2);
    // triangle vertices (image coords, y down)
    let v0x:i64 = cx + (rad * t_geti16(tric, (oct as i32)*6)) / 1000;
    let v0y:i64 = cy + (rad * t_geti16(tris, (oct as i32)*6)) / 1000;
    let v1x:i64 = cx + (rad * t_geti16(tric, (oct as i32)*6+2)) / 1000;
    let v1y:i64 = cy + (rad * t_geti16(tris, (oct as i32)*6+2)) / 1000;
    let v2x:i64 = cx + (rad * t_geti16(tric, (oct as i32)*6+4)) / 1000;
    let v2y:i64 = cy + (rad * t_geti16(tris, (oct as i32)*6+4)) / 1000;
    let hs:i64 = (rad * 1000) / 1414;
    let y:i32 = 0;
    while(y < 96) {
        let x:i32 = 0;
        while(x < 96) {
            let dx:i64 = (x as i64) - cx; let dy:i64 = (y as i64) - cy;
            let inside:i64 = 0;
            if(kind == 0) {
                if(dx*dx + dy*dy <= rad*rad) { inside = 1; }
            }
            if(kind == 1) {
                let ux:i64 = (dx*cc + dy*ss) / 1000;
                let uy:i64 = (0 - dx*ss + dy*cc) / 1000;
                if(iabs(ux) <= hs && iabs(uy) <= hs) { inside = 1; }
            }
            if(kind == 2) {
                let px:i64 = x as i64; let py:i64 = y as i64;
                let d1:i64 = (px-v1x)*(v0y-v1y) - (v0x-v1x)*(py-v1y);
                let d2:i64 = (px-v2x)*(v1y-v2y) - (v1x-v2x)*(py-v2y);
                let d3:i64 = (px-v0x)*(v2y-v0y) - (v2x-v0x)*(py-v0y);
                let neg:i64 = 0; let pos:i64 = 0;
                if(d1 < 0 || d2 < 0 || d3 < 0) { neg = 1; }
                if(d1 > 0 || d2 > 0 || d3 > 0) { pos = 1; }
                if(neg == 0 || pos == 0) { inside = 1; }
            }
            let o:i32 = (y*96+x)*3;
            if(inside == 1) {
                art[o] = 235; art[o+1] = 235; art[o+2] = 235;
            } else {
                art[o] = 128; art[o+1] = 128; art[o+2] = 128;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(ops, 9216);
    return 27648;
}
// ---- tone synthesis core ---------------------------------------------------
// amps: u16 LE table (count n), sum_amps precomputed; returns samples written.
fn rn_tone(art:[]u8, at:i32, f_mhz:i64, n:i32, amps:[]u8, namp:i32, suma:i64,
           sinlut:[]u8, ramplut:[]u8, ops:[]u8) void {
    let inc:i64 = (f_mhz * 4294967296) / 16000000;
    let phase:i64 = 0;
    let i:i32 = 0;
    while(i < n) {
        let acc:i64 = 0;
        let k:i32 = 0;
        while(k < namp) {
            let a:i64 = t_get16(amps, k*2) as i64;
            if(a > 0) {
                let kk:i64 = (k+1) as i64;
                let idx:i32 = (((phase * kk) >> 24) & 255) as i32;
                acc = acc + rs_sin(sinlut, idx) * a;
            }
            k = k + 1;
        }
        // normalize: peak -> 0.75 * 32767 = 24575
        let s:i64 = (acc * 24575) / (suma * 32767);
        let r:i64 = 1000;
        if(i < 320) { r = t_get16(ramplut, i*2) as i64; }
        if(i >= n - 320) { r = t_get16(ramplut, (n-1-i)*2) as i64; }
        s = (s * r) / 1000;
        t_put16(art, at + i*2, (s + 65536) & 65535);
        phase = phase + inc;
        i = i + 1;
    }
    op_add(ops, n as i64);
}
// ---- T4: two tones from estimated f0, canonical harmonics ------------------
fn rn_t4(p:[]u8, art:[]u8, sinlut:[]u8, ramplut:[]u8, ops:[]u8) i64 {
    let amps:[]u8 = z_alloc(6);
    t_put16(amps, 0, 1000); t_put16(amps, 2, 300); t_put16(amps, 4, 150);
    rn_tone(art, 0, t_get32(p, 5), 6400, amps, 3, 1450, sinlut, ramplut, ops);
    rn_tone(art, 12800, t_get32(p, 9), 6400, amps, 3, 1450, sinlut, ramplut, ops);
    nio_free(amps);
    return 25600;
}
// ---- T5: 440Hz tone, canonical profile of the judged class -----------------
fn rn_t5(p:[]u8, art:[]u8, sinlut:[]u8, ramplut:[]u8, tmblut:[]u8, ops:[]u8) i64 {
    let cls:i64 = (p[1] as i64) & 3;
    let amps:[]u8 = z_alloc(16);
    let suma:i64 = 0;
    let k:i32 = 0;
    while(k < 8) {
        let a:i64 = t_get16(tmblut, ((cls*8 + k as i64) as i32)*2) as i64;
        t_put16(amps, k*2, a);
        suma = suma + a;
        k = k + 1;
    }
    if(suma <= 0) { suma = 1; }
    rn_tone(art, 0, 440000, 12800, amps, 8, suma, sinlut, ramplut, ops);
    nio_free(amps);
    return 25600;
}
// ---- T6: black frames + moving white square --------------------------------
fn rn_t6(p:[]u8, art:[]u8, ops:[]u8) i64 {
    let d:i64 = p[1] as i64;
    let s:i64 = p[5] as i64;
    let vx:i64 = 0; let vy:i64 = 0;
    if(d == 0) { vx = 0; vy = -1; }
    if(d == 1) { vx = 1; vy = -1; }
    if(d == 2) { vx = 1; vy = 0; }
    if(d == 3) { vx = -1; vy = -1; }
    if(d == 4) { vx = 0; vy = 1; }
    if(d == 5) { vx = 1; vy = 1; }
    if(d == 6) { vx = -1; vy = 1; }
    if(d == 7) { vx = -1; vy = 0; }
    if(d == 8) { vx = 0; vy = 0; }
    let f:i32 = 0;
    while(f < 8) {
        let base:i32 = f*12288;
        // black bg
        let i:i32 = 0;
        while(i < 12288) { art[base+i] = 0; i = i + 1; }
        // 8x8 white square
        let sx:i64 = 28 + vx*s*(f as i64)/7;
        let sy:i64 = 28 + vy*s*(f as i64)/7;
        let yy:i64 = 0;
        while(yy < 8) {
            let xx:i64 = 0;
            while(xx < 8) {
                let qx:i64 = sx + xx; let qy:i64 = sy + yy;
                if(qx >= 0 && qx < 64 && qy >= 0 && qy < 64) {
                    let o:i32 = base + ((qy*64+qx)*3) as i32;
                    art[o] = 235; art[o+1] = 235; art[o+2] = 235;
                }
                xx = xx + 1;
            }
            yy = yy + 1;
        }
        f = f + 1;
    }
    op_add(ops, 32768);
    return 98304;
}
// ---- dispatcher --------------------------------------------------------------
fn render_build(p:[]u8, art:[]u8, max:i32, sinlut:[]u8, ramplut:[]u8,
                octc:[]u8, octs:[]u8, tric:[]u8, tris:[]u8, tmblut:[]u8,
                ops:[]u8) i64 {
    let task:i64 = p[0] as i64;
    if(task == 1) { return rn_t1(p, art, ops); }
    if(task == 2) { return rn_t2(p, art, ops); }
    if(task == 3) { return rn_t3(p, art, octc, octs, tric, tris, ops); }
    if(task == 4) { return rn_t4(p, art, sinlut, ramplut, ops); }
    if(task == 5) { return rn_t5(p, art, sinlut, ramplut, tmblut, ops); }
    if(task == 6) { return rn_t6(p, art, ops); }
    return -1;
}
// Container header length for the artifact file (matches fixture formats).
fn render_hdr_len(task:i32) i32 {
    if(task == 6) { return 12; }
    return 8;
}
// Write the viewable artifact: container header + rendered payload.
// T4 header sample-count is patched to 12800 (tones concatenated, no gap).
fn render_write_artifact(task:i32, art:[]u8, alen:i64, path:[]u8) i64 {
    let hl:i32 = render_hdr_len(task);
    let out:[]u8 = z_alloc((hl as i64 + alen) as i32);
    if(task == 6) {
        t_put32(out, 0, 8); t_put32(out, 4, 64); t_put32(out, 8, 64);
    }
    if(task == 4 || task == 5) {
        t_put32(out, 0, 16000);
        if(task == 4) { t_put32(out, 4, 12800); }
        if(task == 5) { t_put32(out, 4, 12800); }
    }
    if(task == 1 || task == 2) { t_put32(out, 0, 128); t_put32(out, 4, 64); }
    if(task == 3) { t_put32(out, 0, 96); t_put32(out, 4, 96); }
    let k:i64 = 0;
    while(k < alen) { out[(hl as i64 + k) as i32] = art[k as i32]; k = k + 1; }
    let w:i64 = z_write_new(path, out[0..(hl as i64 + alen) as i32]);
    nio_free(out);
    return w;
}
// ---- divergence: RLE of (start u32, len u32) runs where art != cited ---------
fn div_diff(cited:[]u8, art:[]u8, n:i32, runs:[]u8, maxruns:i32, divb:[]u8) i64 {
    let nr:i64 = 0; let db:i64 = 0;
    let i:i32 = 0;
    while(i < n) {
        if(cited[i] != art[i]) {
            let st:i32 = i;
            while(i < n && cited[i] != art[i]) { i = i + 1; }
            let ln:i32 = i - st;
            if(nr < maxruns as i64) {
                t_put32(runs, (nr as i32)*8, st as i64);
                t_put32(runs, (nr as i32)*8+4, ln as i64);
            }
            nr = nr + 1;
            db = db + ln as i64;
        } else {
            i = i + 1;
        }
    }
    t_put64(divb, 0, db);
    return nr;
}

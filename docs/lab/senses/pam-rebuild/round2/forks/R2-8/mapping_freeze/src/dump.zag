// dump.zag — pure-Zag percept extraction (stage 1 of the mapping-freeze battery).
//
// Reads a fixture list TSV:  task \t relpath
// Writes a percept TSV:      task \t relpath \t judgment \t confidence
//                            \t margin \t feature \t ops
// All percept arithmetic is the frozen R2-8 mechanism (percept_r28.zag);
// the sinpoly memoization is a build-note optimization with bit-identical
// outputs (verified). No RNG. Deterministic: same input -> same bytes.
//
// CLI: dump <fixture_tsv> <base_dir> <out_tsv>
//
// Part of the R2-8 mapping-freeze battery. Stage 2 (gate/ledger/bars) reads
// this file; the join between trial lists and this dump is Python fixture
// glue (allowed), the gate itself stays pure Zag.

// ---- native: io ----
@import("R33_NATIVE_IO_V1.zag")
// ---- native: sha256 ----
@import("R33_NATIVE_SHA256_V2.zag")
// ---- frozen R2-8 percepts (main replaced by percept_run) ----
@import("percept_r28.zag")

fn seq(a:[]u8, b:[]u8) i32 {
    if(a.len != b.len) { return 0; }
    if(_zag_strcmp(a, b) == 1) { return 1; }
    return 0;
}
fn find_byte(buf:[]u8, s:i32, e:i32, b:u8) i32 {
    let i:i32 = s;
    while(i < e) {
        if(buf[i] == b) { return i; }
        i = i + 1;
    }
    return -1;
}
fn field(buf:[]u8, s:i32, e:i32, k:i32) []u8 {
    let i:i32 = s;
    let f:i32 = 0;
    let fs:i32 = s;
    while(i < e) {
        if(buf[i] == 9) {
            if(f == k) { return buf[fs..i]; }
            f = f + 1;
            fs = i + 1;
        }
        i = i + 1;
    }
    if(f == k) { return buf[fs..e]; }
    return buf[e..e];
}
fn task_id(task:[]u8) i32 {
    if(seq(task, "colordisc") == 1) { return 1; }
    if(seq(task, "colorconst") == 1) { return 2; }
    if(seq(task, "shapetrans") == 1) { return 3; }
    if(seq(task, "pitchdisc") == 1) { return 4; }
    if(seq(task, "timbredisc") == 1) { return 5; }
    if(seq(task, "motiondir") == 1) { return 6; }
    return 0;
}
fn z_cstr2(s:[]u8) []u8 {
    let n:i32 = s.len as i32;
    let b:[]u8 = nio_alloc(n + 1);
    if(b.len == 0) { return s[0..0]; }
    let i:i32 = 0;
    while(i < n) { b[i] = s[i]; i = i + 1; }
    b[n] = 0;
    return b;
}
fn z_open_write2(path:[]u8) i64 {
    let p:[]u8 = z_cstr2(path);
    if(p.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(p) as i64, 577, 420, 0, 0, 0);
    nio_free(p);
    return fd;
}
fn z_read2(path:[]u8, buf:[]u8, cap:i32) i64 {
    let p:[]u8 = z_cstr2(path);
    if(p.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(p) as i64, 0, 0, 0, 0, 0);
    nio_free(p);
    if(fd < 0) { return -1; }
    let n:i64 = _zag_raw_syscall(0, fd, _zag_slice_ptr(buf) as i64, cap as i64, 0, 0, 0);
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return n;
}
fn join_path2(base:[]u8, rel:[]u8, out:[]u8) []u8 {
    let p:i32 = 0;
    let i:i32 = 0;
    while(i < base.len as i32) { out[p] = base[i]; p = p + 1; i = i + 1; }
    out[p] = 47; p = p + 1;
    i = 0;
    while(i < rel.len as i32) { out[p] = rel[i]; p = p + 1; i = i + 1; }
    return out[0..p];
}
fn ob_add2(b:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len as i32) { b[pos+i] = s[i]; i = i + 1; }
    return pos + (s.len as i32);
}
fn parse_i64_2(s:[]u8) i64 {
    let v:i64 = 0;
    let neg:i64 = 0;
    let i:i32 = 0;
    if(s.len > 0 && s[0] == 45) { neg = 1; i = 1; }
    while(i < s.len as i32) {
        let c:u8 = s[i];
        if(c >= 48 && c <= 57) { v = v*10 + (c as i64) - 48; }
        i = i + 1;
    }
    if(neg == 1) { v = 0 - v; }
    return v;
}

fn main() i32 {
    let tsv_path:[]u8 = _zag_arg(1);
    let base:[]u8 = _zag_arg(2);
    let out_path:[]u8 = _zag_arg(3);
    let tsv:[]u8 = nio_alloc(4194304);
    let fbuf:[]u8 = nio_alloc(8388608);
    let op:[]u8 = nio_alloc(8);
    let ob:[]u8 = nio_alloc(65536);
    let pathb:[]u8 = nio_alloc(4096);
    let outb:[]u8 = nio_alloc(4194304);
    let poly:[]u8 = nio_alloc(1609*8);
    let pbuf:[]u8 = nio_alloc(256);
    if(tsv.len == 0 || fbuf.len == 0 || outb.len == 0 || poly.len == 0) { return 99; }
    sin_init(poly);
    let tn:i64 = z_read2(tsv_path, tsv, 4194304);
    if(tn < 0) { return 97; }
    let tni:i32 = tn as i32;
    let ofd:i64 = z_open_write2(out_path);
    if(ofd < 0) { return 96; }
    let opos:i32 = 0;
    let s:i32 = 0;
    let n:i32 = 0;
    let nfail:i32 = 0;
    // res: 64B — 0:ok 8:conf 16:feat 24:marg 32:ops 40:jlen 48..:judgment
    let res:[]u8 = nio_alloc(64);
    while(s < tni) {
        let eol:i32 = find_byte(tsv, s, tni, 10);
        if(eol < 0) { eol = tni; }
        if(eol > s) {
            let task:[]u8 = field(tsv, s, eol, 0);
            let rel:[]u8 = field(tsv, s, eol, 1);
            let tid:i32 = task_id(task);
            // reset res
            t_put64(res, 0, 0);
            t_put64(res, 8, -1);
            t_put64(res, 16, -1);
            t_put64(res, 24, -1);
            t_put64(res, 32, 0);
            t_put64(res, 40, 1);
            res[48] = 63;
            let full:[]u8 = join_path2(base, rel, pathb);
            let np2:i32 = percept_run(tid, full, fbuf, op, ob, poly);
            if(np2 >= 0) {
                // ob holds key=value lines; extract the four text fields.
                // ops lives in the op arena (t_get64(op,0)), not in ob text.
                let ok:i64 = 1;
                // extract by scanning lines
                let lp:i32 = 0;
                let jsl:[]u8 = res[48..48];
                let cv:i64 = -1;
                let mv:i64 = -1;
                let fv:i64 = -1;
                let ov:i64 = t_get64(op, 0);
                while(lp < np2) {
                    let le:i32 = find_byte(ob, lp, np2, 10);
                    if(le < 0) { le = np2; }
                    let eq:i32 = find_byte(ob, lp, le, 61);
                    if(eq > lp) {
                        let kn:[]u8 = ob[lp..eq];
                        let vv:[]u8 = ob[eq+1..le];
                        if(seq(kn, "judgment") == 1) { jsl = vv; }
                        if(seq(kn, "confidence") == 1) { cv = parse_i64_2(vv); }
                        if(seq(kn, "margin") == 1) { mv = parse_i64_2(vv); }
                        if(seq(kn, "feature") == 1) { fv = parse_i64_2(vv); }
                    }
                    lp = le + 1;
                }
                if(jsl.len == 0) { ok = 0; }
                // write: task \t rel \t judgment \t conf \t margin \t feat \t ops \n
                opos = ob_add2(outb, opos, task);
                opos = ob_add2(outb, opos, "\t");
                opos = ob_add2(outb, opos, rel);
                opos = ob_add2(outb, opos, "\t");
                if(ok == 1) {
                    opos = ob_add2(outb, opos, jsl);
                } else {
                    opos = ob_add2(outb, opos, "?");
                }
                opos = ob_add2(outb, opos, "\t");
                opos = ob_add2(outb, opos, _zag_i64_to_str(cv));
                opos = ob_add2(outb, opos, "\t");
                opos = ob_add2(outb, opos, _zag_i64_to_str(mv));
                opos = ob_add2(outb, opos, "\t");
                opos = ob_add2(outb, opos, _zag_i64_to_str(fv));
                opos = ob_add2(outb, opos, "\t");
                opos = ob_add2(outb, opos, _zag_i64_to_str(ov));
                opos = ob_add2(outb, opos, "\n");
                if(ok == 0) { nfail = nfail + 1; }
            } else {
                opos = ob_add2(outb, opos, task);
                opos = ob_add2(outb, opos, "\t");
                opos = ob_add2(outb, opos, rel);
                opos = ob_add2(outb, opos, "\t?\t-1\t-1\t-1\t0\n");
                nfail = nfail + 1;
            }
            n = n + 1;
            if(n % 500 == 0) {
                let pp:i32 = 0;
                pp = ob_add2(pbuf, pp, "dump ");
                pp = ob_add2(pbuf, pp, _zag_i64_to_str(n as i64));
                pp = ob_add2(pbuf, pp, "\n");
                nio_write_all(1, pbuf[0..pp]);
            }
            if(opos > 900000) {
                nio_write_all(ofd, outb[0..opos]);
                opos = 0;
            }
        }
        s = eol + 1;
    }
    if(opos > 0) { nio_write_all(ofd, outb[0..opos]); }
    nio_close(ofd);
    let qp:i32 = 0;
    qp = ob_add2(pbuf, qp, "dump done n=");
    qp = ob_add2(pbuf, qp, _zag_i64_to_str(n as i64));
    qp = ob_add2(pbuf, qp, " failed=");
    qp = ob_add2(pbuf, qp, _zag_i64_to_str(nfail as i64));
    qp = ob_add2(pbuf, qp, "\n");
    nio_write_all(1, pbuf[0..qp]);
    return 0;
}

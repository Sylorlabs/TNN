// r2p_front.zag — naive percept front-ends for R2-3, ported from
// ../forks/R2-3/src/mirror/judge.py. Integer-only, zero RNG.
// front_judge(task, payload) -> judgment code (see judge.py for vocabularies).
// Payload layouts (little-endian):
//   frames: i32 nf, u16 w, u16 h, then nf*w*h*3 bytes RGB
//   image:  u16 w, u16 h, then w*h*3 bytes RGB
//   pcm:    u32 rate, u32 ns, then ns i16 samples

@import("R33_NATIVE_IO_V1.zag")
@import("r2p_protos.zag")

fn f_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn f_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn f_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = f_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}
fn f_abs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}

// ---------------- T0 colordisc ----------------
// SAME=0 if squared RGB distance of half-means < 400 else DIFFERENT=1.
fn front_colordisc(p:[]u8) i32 {
    let nf:i64 = f_get32(p, 0);
    let w:i64 = f_get16(p, 4);
    let h:i64 = f_get16(p, 6);
    let ml0:i64 = 0; let ml1:i64 = 0; let ml2:i64 = 0;
    let mr0:i64 = 0; let mr1:i64 = 0; let mr2:i64 = 0;
    let n:i64 = 0;
    let f:i64 = 0;
    while(f < nf) {
        let base:i64 = 8 + f * w * h * 3;
        let y:i64 = 0;
        while(y < h) {
            let x:i64 = 0;
            while(x < w / 2) {
                let o:i64 = base + (y * w + x) * 3;
                ml0 = ml0 + p[o] as i64;
                ml1 = ml1 + p[o+1] as i64;
                ml2 = ml2 + p[o+2] as i64;
                n = n + 1;
                x = x + 1;
            }
            x = w / 2;
            while(x < w) {
                let o2:i64 = base + (y * w + x) * 3;
                mr0 = mr0 + p[o2] as i64;
                mr1 = mr1 + p[o2+1] as i64;
                mr2 = mr2 + p[o2+2] as i64;
                x = x + 1;
            }
            y = y + 1;
        }
        f = f + 1;
    }
    ml0 = ml0 / n; ml1 = ml1 / n; ml2 = ml2 / n;
    mr0 = mr0 / n; mr1 = mr1 / n; mr2 = mr2 / n;
    let d2:i64 = (ml0-mr0)*(ml0-mr0) + (ml1-mr1)*(ml1-mr1) + (ml2-mr2)*(ml2-mr2);
    if(d2 < 400) { return 0; }
    return 1;
}

// ---------------- T1 colorconst ----------------
// SAME_SURFACE=0 if panel-mean d2 < 900 else DIFFERENT=1. Panels are 8x8:
// left at x 0..7, right at x 8..15, y 0..7.
fn front_colorconst(p:[]u8) i32 {
    let nf:i64 = f_get32(p, 0);
    let w:i64 = f_get16(p, 4);
    let h:i64 = f_get16(p, 6);
    let ml0:i64 = 0; let ml1:i64 = 0; let ml2:i64 = 0;
    let mr0:i64 = 0; let mr1:i64 = 0; let mr2:i64 = 0;
    let n:i64 = 0;
    let f:i64 = 0;
    while(f < nf) {
        let base:i64 = 8 + f * w * h * 3;
        let y:i64 = 0;
        while(y < 8) {
            let x:i64 = 0;
            while(x < 8) {
                let o:i64 = base + (y * w + x) * 3;
                ml0 = ml0 + p[o] as i64;
                ml1 = ml1 + p[o+1] as i64;
                ml2 = ml2 + p[o+2] as i64;
                n = n + 1;
                let o2:i64 = base + (y * w + 8 + x) * 3;
                mr0 = mr0 + p[o2] as i64;
                mr1 = mr1 + p[o2+1] as i64;
                mr2 = mr2 + p[o2+2] as i64;
                x = x + 1;
            }
            y = y + 1;
        }
        f = f + 1;
    }
    ml0 = ml0 / n; ml1 = ml1 / n; ml2 = ml2 / n;
    mr0 = mr0 / n; mr1 = mr1 / n; mr2 = mr2 / n;
    let d2:i64 = (ml0-mr0)*(ml0-mr0) + (ml1-mr1)*(ml1-mr1) + (ml2-mr2)*(ml2-mr2);
    if(d2 < 900) { return 0; }
    return 1;
}

// ---------------- T2 shapetrans ----------------
// Downsample to 12x12 (threshold 128), template-match vs prototypes.
// Returns 0=CIRCLE, 1=TRIANGLE, 2=SQUARE.
fn front_shapetrans(p:[]u8) i32 {
    let w:i64 = f_get16(p, 0);
    let h:i64 = f_get16(p, 2);
    let blk:i64 = 8;
    if(w != 96) { blk = 4; }
    // 12x12 grid in a 144-byte arena
    let g:[]u8 = nio_alloc(144);
    let gy:i64 = 0;
    while(gy < 12) {
        let gx:i64 = 0;
        while(gx < 12) {
            let s:i64 = 0;
            let by:i64 = 0;
            while(by < blk) {
                let bx:i64 = 0;
                while(bx < blk) {
                    let px:i64 = gx * blk + bx;
                    let py:i64 = gy * blk + by;
                    let o:i64 = 4 + (py * w + px) * 3;
                    s = s + p[o] as i64 + p[o+1] as i64 + p[o+2] as i64;
                    bx = bx + 1;
                }
                by = by + 1;
            }
            let avg:i64 = s / (3 * blk * blk);
            if(avg >= 128) { g[gy*12+gx] = 255; } else { g[gy*12+gx] = 0; }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    // SAD vs prototypes (sparse-filled into a 144-byte zeroed arena)
    let pv:[]u8 = nio_alloc(144);
    let best:i32 = 0;
    let bestv:i64 = 0;
    let proto:i32 = 0;
    while(proto < 3) {
        // clear
        let ci:i64 = 0;
        while(ci < 144) { pv[ci] = 0; ci = ci + 1; }
        if(w == 96) {
            if(proto == 0) { proto_p96_circle(pv); }
            if(proto == 1) { proto_p96_triangle(pv); }
            if(proto == 2) { proto_p96_square(pv); }
        } else {
            if(proto == 0) { proto_p48_circle(pv); }
            if(proto == 1) { proto_p48_triangle(pv); }
            if(proto == 2) { proto_p48_square(pv); }
        }
        let sad:i64 = 0;
        let i:i64 = 0;
        while(i < 144) {
            sad = sad + f_abs((g[i] as i64) - (pv[i] as i64));
            i = i + 1;
        }
        if(proto == 0) { bestv = sad; }
        if(proto > 0) {
            if(sad < bestv) { bestv = sad; best = proto; }
        }
        proto = proto + 1;
    }
    nio_free(g);
    nio_free(pv);
    return best;
}

// ---------------- T3 pitchdisc ----------------
// Zero-crossing frequency in [0.10,0.80)s vs [1.10,1.90)s.
// 0=SAME if per-mille diff < 5, else 1=HIGHER, 2=LOWER.
fn zc_freq(p:[]u8, base:i32, n:i64, rate:i64) i64 {
    let zc:i64 = 0;
    let i:i64 = 0;
    while(i < n - 1) {
        let a:i64 = f_geti16(p, base + (i as i32) * 2);
        let b:i64 = f_geti16(p, base + ((i + 1) as i32) * 2);
        let sa:i64 = 0;
        if(a >= 0) { sa = 1; }
        let sb:i64 = 0;
        if(b >= 0) { sb = 1; }
        if(sa != sb) {
            let aa:i64 = f_abs(a);
            let ab:i64 = f_abs(b);
            if(aa > 800 || ab > 800) { zc = zc + 1; }
        }
        i = i + 1;
    }
    if(n <= 1) { return 0; }
    return (zc * rate) / (2 * n);
}
fn front_pitchdisc(p:[]u8) i32 {
    let rate:i64 = f_get32(p, 0);
    let a0:i64 = (rate * 10) / 100;
    let a1:i64 = (rate * 80) / 100;
    let b0:i64 = (rate * 110) / 100;
    let b1:i64 = (rate * 190) / 100;
    let fA:i64 = zc_freq(p, 8 + (a0 as i32) * 2, a1 - a0, rate);
    let fB:i64 = zc_freq(p, 8 + (b0 as i32) * 2, b1 - b0, rate);
    if(fA <= 0) { return 0; }
    let rel:i64 = f_abs(fB - fA) * 1000 / fA;
    if(rel < 5) { return 0; }
    if(fB > fA) { return 1; }
    return 2;
}

// ---------------- T4 timbredisc ----------------
// brightness over middle 80%; thresholds [186,227,346]; order PURE,DARK,RICH,BRIGHT.
fn front_timbredisc(p:[]u8) i32 {
    let rate:i64 = f_get32(p, 0);
    let ns:i64 = f_get32(p, 4);
    let lo:i64 = ns / 10;
    let hi:i64 = ns - ns / 10;
    let num:i64 = 0;
    let den:i64 = 0;
    let i:i64 = lo;
    // preload first sample
    let prev:i64 = f_geti16(p, 8 + i * 2);
    den = den + f_abs(prev);
    i = i + 1;
    while(i < hi) {
        let cur:i64 = f_geti16(p, 8 + i * 2);
        num = num + f_abs(cur - prev);
        den = den + f_abs(cur);
        prev = cur;
        i = i + 1;
    }
    let br:i64 = (num * 1000) / (den + 1);
    let slot:i64 = 0;
    if(br >= 186) { slot = 1; }
    if(br >= 227) { slot = 2; }
    if(br >= 346) { slot = 3; }
    // order [0,2,3,1]
    if(slot == 0) { return 0; }
    if(slot == 1) { return 2; }
    if(slot == 2) { return 3; }
    return 1;
}

// ---------------- T5 motiondir ----------------
// Grayscale, central region (2px margin), 2px shifts, per-pair votes.
// Returns 0..7 (N,NE,E,SE,S,SW,W,NW); ties -> lowest index.
fn front_motiondir(p:[]u8) i32 {
    let nf:i64 = f_get32(p, 0);
    let w:i64 = f_get16(p, 4);
    let h:i64 = f_get16(p, 6);
    // dir vectors x8: N,NE,E,SE,S,SW,W,NW
    let dx:[]u8 = nio_alloc(8);
    let dy:[]u8 = nio_alloc(8);
    dx[0]=10; dy[0]=9;
    dx[1]=11; dy[1]=9;
    dx[2]=11; dy[2]=10;
    dx[3]=11; dy[3]=11;
    dx[4]=10; dy[4]=11;
    dx[5]=9;  dy[5]=11;
    dx[6]=9;  dy[6]=10;
    dx[7]=9;  dy[7]=9;
    let votes:[]u8 = nio_alloc(8);
    let vi:i32 = 0;
    while(vi < 8) { votes[vi] = 0; vi = vi + 1; }
    // grayscale frames into arena: nf * w * h bytes
    let gsz:i64 = w * h;
    let gray:[]u8 = nio_alloc((nf * gsz) as i32);
    let f:i64 = 0;
    while(f < nf) {
        let b0:i64 = 8 + f * w * h * 3;
        let gb:i64 = f * gsz;
        let i:i64 = 0;
        while(i < gsz) {
            let o:i64 = b0 + i * 3;
            let gv:i64 = ((p[o] as i64) * 77 + (p[o+1] as i64) * 150 + (p[o+2] as i64) * 29) >> 8;
            gray[(gb + i) as i32] = gv as u8;
            i = i + 1;
        }
        f = f + 1;
    }
    f = 0;
    while(f < nf - 1) {
        let g0:i64 = f * gsz;
        let g1:i64 = (f + 1) * gsz;
        let bestd:i32 = 0;
        let bestv:i64 = 0;
        let d:i64 = 0;
        while(d < 8) {
            let sx:i64 = 2 * ((dx[d] as i64) - 10);
            let sy:i64 = 2 * ((dy[d] as i64) - 10);
            let sad:i64 = 0;
            let y:i64 = 2;
            while(y < h - 2) {
                let r0:i64 = g0 + y * w;
                let r1:i64 = g1 + (y + sy) * w;
                let x:i64 = 2;
                while(x < w - 2) {
                    let a:i64 = gray[(r0 + x) as i32] as i64;
                    let b:i64 = gray[(r1 + x + sx) as i32] as i64;
                    sad = sad + f_abs(a - b);
                    x = x + 1;
                }
                y = y + 1;
            }
            if(d == 0) { bestv = sad; }
            if(d > 0) {
                if(sad < bestv) { bestv = sad; bestd = d as i32; }
            }
            d = d + 1;
        }
        votes[bestd] = votes[bestd] + 1;
        f = f + 1;
    }
    let best:i32 = 0;
    let bestc:i64 = votes[0] as i64;
    vi = 1;
    while(vi < 8) {
        let c:i64 = votes[vi] as i64;
        if(c > bestc) { bestc = c; best = vi; }
        vi = vi + 1;
    }
    nio_free(dx); nio_free(dy); nio_free(votes); nio_free(gray);
    return best;
}

// ---------------- dispatch ----------------
fn front_judge(task:i32, payload:[]u8) i32 {
    if(task == 0) { return front_colordisc(payload); }
    if(task == 1) { return front_colorconst(payload); }
    if(task == 2) { return front_shapetrans(payload); }
    if(task == 3) { return front_pitchdisc(payload); }
    if(task == 4) { return front_timbredisc(payload); }
    return front_motiondir(payload);
}

// sense.zag — R2-10 "emission-gated install" fork.
//
// Pure-Zag, zero-RNG sensory judgments with a human-disciplined install gate.
// Pipeline (one-way, audited):
//   fixture bytes -> task front-end -> PERCEPT (judgment + confidence + margin
//     + emission mapping + features) -> emission phase (exact-span replay or
//     nothing) -> install gate -> hash-chained ledger entry.
//
// Witness-emission contract (frozen R2-9): exact source-span replay ONLY.
// Audio: the cited byte span [start,end) of the fixture file, copied verbatim.
// Visual/video: the cited pixel region, copied verbatim. No synthesis, no
// enhancement, no invention. The emission phase NEVER feeds back into the
// percept: emission-off yields byte-identical percepts and dispositions (B4).
//
// Install gate (frozen): INSTALL iff mapping_ok AND confidence >= THETA (700).
// VETO_ID selects a post-hoc veto learned by the revise step (0 = none).
// The gate reads ONLY percept fields + frozen constants. No RNG, no clock.
//
// CLI:
//   sense <task> <fixture> <mode> <prevhash64> <artdir>
//     task: colordisc|colorconst|shapetrans|pitchdisc|timbredisc|motiondir
//     mode: emit | noemit
//     prevhash64: 64 hex chars chaining the ledger (genesis = 64 zeros)
//     artdir: artifact directory for emit mode ("-" for noemit)
//   sense revise <train.tsv> <verdicts.csv>
//     Grid-searches (theta, veto) against human verdicts; prints recommendation.
//     Does NOT modify the gate. Rebuilding with a new VETO_ID/THETA is a
//     separate, logged step.
//
// stdout (per trial): key=value lines incl. approach=R2-10, task, fixture,
// judgment, confidence, margin, ops, percept=<span>, mapping_ok, disposition,
// emit_digest, artifact_written, feat0, feat1, ledger_hash, ledger_entry.
// Exit 0 on success; 1 with error=<reason> on failure (a failure installs
// nothing and emits nothing).
//
// znc workarounds honored: no argc gate, no `as []i32`/`[]u32`/`[]u16`
// (only []u8 arenas + LE accessors), no `};`, arrays explicitly initialized,
// no slice > 2^25 indexed, NUL-terminated syscall paths, shallow else-nesting,
// `return;` with semicolon in void fns.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_get32s(b:[]u8, at:i32) i64 {
    let v:i64 = t_get32(b, at);
    if(v >= 2147483648) { return v - 4294967296; }
    return v;
}
fn t_get16s(b:[]u8, at:i32) i64 {
    let v:i64 = (b[at] as i64) | ((b[at+1] as i64) << 8);
    if(v >= 32768) { return v - 65536; }
    return v;
}

// ---------------- integer math ----------------
fn iabs(x:i64) i64 { if(x < 0) { return -x; } return x; }
fn imin(a:i64, b:i64) i64 { if(a < b) { return a; } return b; }
fn imax(a:i64, b:i64) i64 { if(a > b) { return a; } return b; }
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    let r:i64 = x;
    let y:i64 = (r + 1) / 2;
    let guard:i32 = 0;
    while(y < r) {
        r = y;
        y = (r + x / r) / 2;
        guard = guard + 1;
        if(guard > 200) { break; }
    }
    return r;
}
// integer cube root (for Lab)
fn icbrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    let r:i64 = x;
    let guard:i32 = 0;
    while(guard < 200) {
        let r2:i64 = r * r;
        if(r2 == 0) { break; }
        let y:i64 = (2 * r + x / r2) / 3;
        if(y >= r) { break; }
        r = y;
        guard = guard + 1;
    }
    while((r+1)*(r+1)*(r+1) <= x) { r = r + 1; }
    while(r*r*r > x) { r = r - 1; }
    return r;
}

// ---------------- file IO ----------------
fn z_cstr(s:[]u8) []u8 {
    let n:i32 = s.len;
    let b:[]u8 = nio_alloc(n + 1);
    if(b.len == 0) { return s; }
    let i:i32 = 0;
    while(i < n) { b[i] = s[i]; i = i + 1; }
    b[n] = 0;
    return b;
}
fn z_read(path:[]u8, buf:[]u8, cap:i64) i64 {
    let p:[]u8 = z_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(p) as i64, 0, 0, 0, 0, 0);
    if(fd < 0) { return -1; }
    // nio_read_exact reads the whole regular file in one call (up to cap)
    let r:i64 = nio_read_exact(fd, buf, cap as i32);
    let cc:i64 = nio_close(fd);
    if(cc != 0) { }
    return r;
}
fn z_write_file(path:[]u8, data:[]u8) i64 {
    let p:[]u8 = z_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(p) as i64, 577, 420, 0, 0, 0);
    if(fd < 0) { return -1; }
    let w:i64 = nio_write_all(fd, data);
    nio_close(fd);
    return w;
}

// ---------------- stdout builder ----------------
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    let i:i32 = 0;
    while(i < k.len) { ob[pos] = k[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 61; pos = pos + 1;
    i = 0;
    while(i < v.len) { ob[pos] = v[i]; pos = pos + 1; i = i + 1; }
    ob[pos] = 10; pos = pos + 1;
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn fail(task:[]u8, reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(512);
    if(ob.len == 0) { return 1; }
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "R2-10");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "error", reason);
    pos = ob_kv(ob, pos, "disposition", "WITHHOLD");
    nio_write_all(1, ob[0..pos]);
    return 1;
}

// ---------------- hex helpers ----------------
fn hex_of(hash32:[]u8, out:[]u8, at:i32) i32 {
    let digits:[]u8 = "0123456789abcdef";
    let i:i32 = 0;
    while(i < 32) {
        let b:i64 = hash32[i] as i64;
        out[at] = digits[(b >> 4) as i32];
        out[at+1] = digits[(b & 15) as i32];
        at = at + 2;
        i = i + 1;
    }
    return at;
}
fn hexval(c:u8) i64 {
    if(c >= 48) {
        if(c <= 57) { return (c - 48) as i64; }
    }
    if(c >= 97) {
        if(c <= 102) { return (c - 97 + 10) as i64; }
    }
    if(c >= 65) {
        if(c <= 70) { return (c - 65 + 10) as i64; }
    }
    return -1;
}
fn unhex(src:[]u8, dst:[]u8) i32 {
    if(src.len != 64) { return -1; }
    let i:i32 = 0;
    while(i < 32) {
        let hi:i64 = hexval(src[2*i]);
        let lo:i64 = hexval(src[2*i+1]);
        if(hi < 0) { return -1; }
        if(lo < 0) { return -1; }
        dst[i] = ((hi * 16 + lo) & 255) as u8;
        i = i + 1;
    }
    return 0;
}
fn sha256_hex(data:[]u8, out:[]u8, at:i32) i32 {
    let h:[]u8 = nio_alloc(32);
    if(h.len == 0) { return -1; }
    if(ns_sha256(data, h) != 0) { return -1; }
    return hex_of(h, out, at);
}

// ---------------- sRGB -> CIELAB (integer, per-million fixed point) ----------------
// Gamma via quadratic interpolation on a 17-node table (max err 0.00022).
fn gamma_tab(k:i32) i64 {
    if(k == 0) { return 0; }
    if(k == 1) { return 5182; }
    if(k == 2) { return 14444; }
    if(k == 3) { return 29557; }
    if(k == 4) { return 51269; }
    if(k == 5) { return 80220; }
    if(k == 6) { return 116971; }
    if(k == 7) { return 162029; }
    if(k == 8) { return 215861; }
    if(k == 9) { return 278894; }
    if(k == 10) { return 351533; }
    if(k == 11) { return 434154; }
    if(k == 12) { return 527115; }
    if(k == 13) { return 630757; }
    if(k == 14) { return 745404; }
    if(k == 15) { return 871367; }
    return 1008944;
}
fn srgb_linear(c:i64) i64 {
    if(c <= 0) { return 0; }
    if(c >= 255) { return 1000000; }
    if(c < 16) {
        let y0:i64 = gamma_tab(0);
        let y1:i64 = gamma_tab(1);
        return (y0 * (16 - c) + y1 * c) / 16;
    }
    let k:i64 = c / 16;
    let f:i64 = c % 16;
    if(k > 15) { k = 15; f = c - 240; }
    let kk:i32 = k as i32;
    let yk:i64 = gamma_tab(kk);
    let d1:i64 = gamma_tab(kk+1) - gamma_tab(kk-1);
    let d2:i64 = gamma_tab(kk+1) - 2 * yk + gamma_tab(kk-1);
    return yk + (f * d1) / 32 + (f * f * d2) / 512;
}
// Lab f(t): t in per-million; returns per-million.
fn lab_f(t:i64) i64 {
    if(t <= 0) { return 0; }
    if(t > 8856) {
        return 10000 * icbrt(t);
    }
    return (7787 * t) / 1000 + 137931;
}
// rgb_to_lab: r,g,b in 0..255; writes L,a,b in milli-units at lab[0..2].
fn rgb_to_lab(r:i64, gg:i64, b:i64, lab:[]u8, at:i32) void {
    let rl:i64 = srgb_linear(r);
    let gl:i64 = srgb_linear(gg);
    let bl:i64 = srgb_linear(b);
    let x:i64 = (412456 * rl + 357576 * gl + 180438 * bl) / 1000000;
    let y:i64 = (212673 * rl + 715152 * gl + 72218 * bl) / 1000000;
    let z:i64 = (19314 * rl + 119192 * gl + 950304 * bl) / 1000000;
    let fx:i64 = lab_f((x * 1000000) / 95047);
    let fy:i64 = lab_f(y);
    let fz:i64 = lab_f((z * 1000000) / 108883);
    let lm:i64 = (116 * (fy / 1000)) - 16000;
    let am:i64 = (fx - fy) / 2;
    let bm:i64 = (fy - fz) / 5;
    t_put64(lab, at, lm);
    t_put64(lab, at+8, am);
    t_put64(lab, at+16, bm);
}
// de76 in milli-units between lab at a and b.
fn de76_milli(lab:[]u8, a:i32, b:i32) i64 {
    let dl:i64 = t_get64(lab, a) - t_get64(lab, b);
    let da:i64 = t_get64(lab, a+8) - t_get64(lab, b+8);
    let db:i64 = t_get64(lab, a+16) - t_get64(lab, b+16);
    return isqrt(dl*dl + da*da + db*db);
}
fn irgb_euc(r1:i64, g1:i64, b1:i64, r2:i64, g2:i64, b2:i64) i64 {
    let dr:i64 = r1 - r2;
    let dg:i64 = g1 - g2;
    let db:i64 = b1 - b2;
    return isqrt(dr*dr + dg*dg + db*db);
}

// ---------------- colordisc ----------------
// jcode: 0=SAME, 1=DIFFERENT. feat0=overall rgbdist, feat1=de76milli (or midstep).
// Gradient test first (catches illuminant drift): if the overall half-vs-half
// RGB distance is large but the local boundary step is small, the change is
// gradual across the frame -> one surface under drifting light -> SAME.
fn task_colordisc(buf:[]u8, n:i32, op:[]u8, px:[]u8) i32 {
    if(n < 20) { return -1; }
    let w:i64 = t_get32(buf, 0);
    let h:i64 = t_get32(buf, 4);
    if(w < 8) { return -1; }
    if((w % 2) != 0) { return -1; }
    if(h < 4) { return -1; }
    let hw:i64 = w / 2;
    let base:i32 = 8;
    let ops:i64 = 0;
    // half means
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let x:i64 = 0;
    while(x < hw) {
        let y:i64 = 0;
        while(y < h) {
            let o:i32 = (base + (y * w + x) * 3) as i32;
            sr = sr + (buf[o] as i64); sg = sg + (buf[o+1] as i64); sb = sb + (buf[o+2] as i64);
            y = y + 1; ops = ops + 1;
        }
        x = x + 1;
    }
    let tr:i64 = 0; let tg:i64 = 0; let tb:i64 = 0;
    x = hw;
    while(x < w) {
        let y:i64 = 0;
        while(y < h) {
            let o:i32 = (base + (y * w + x) * 3) as i32;
            tr = tr + (buf[o] as i64); tg = tg + (buf[o+1] as i64); tb = tb + (buf[o+2] as i64);
            y = y + 1; ops = ops + 1;
        }
        x = x + 1;
    }
    let cnt:i64 = hw * h;
    let lr:i64 = sr / cnt; let lg:i64 = sg / cnt; let lb:i64 = sb / cnt;
    let rr:i64 = tr / cnt; let rg:i64 = tg / cnt; let rb:i64 = tb / cnt;
    let overall:i64 = irgb_euc(lr, lg, lb, rr, rg, rb);
    // mid boundary step: 4 cols each side
    let mlr:i64 = 0; let mlg:i64 = 0; let mlb:i64 = 0;
    let mrr:i64 = 0; let mrg:i64 = 0; let mrb:i64 = 0;
    let mcnt:i64 = 0;
    x = hw - 4;
    while(x < hw) {
        let y:i64 = 0;
        while(y < h) {
            let o:i32 = (base + (y * w + x) * 3) as i32;
            mlr = mlr + (buf[o] as i64); mlg = mlg + (buf[o+1] as i64); mlb = mlb + (buf[o+2] as i64);
            y = y + 1; ops = ops + 1;
        }
        mcnt = mcnt + 1; x = x + 1;
    }
    x = hw;
    while(x < hw + 4) {
        let y:i64 = 0;
        while(y < h) {
            let o:i32 = (base + (y * w + x) * 3) as i32;
            mrr = mrr + (buf[o] as i64); mrg = mrg + (buf[o+1] as i64); mrb = mrb + (buf[o+2] as i64);
            y = y + 1; ops = ops + 1;
        }
        mcnt = mcnt + 1; x = x + 1;
    }
    let mc:i64 = 4 * h;
    mlr = mlr / mc; mlg = mlg / mc; mlb = mlb / mc;
    mrr = mrr / mc; mrg = mrg / mc; mrb = mrb / mc;
    let midstep:i64 = irgb_euc(mlr, mlg, mlb, mrr, mrg, mrb);
    t_put64(op, 0, ops);
    t_put64(px, 64, overall);
    if(overall >= 40) {
        if(4 * midstep < overall) {
            // gradual change across the frame: one surface, drifting light
            let margin:i64 = overall - 4 * midstep;
            let conf:i64 = (1000 * margin) / (margin + 15);
            t_put64(px, 0, 0);
            t_put64(px, 8, conf);
            t_put64(px, 16, margin);
            t_put64(px, 24, 1);
            t_put64(px, 32, hw - 8);
            t_put64(px, 40, 0);
            t_put64(px, 48, 16);
            t_put64(px, 56, h);
            t_put64(px, 72, midstep);
            return 0;
        }
    }
    let lab:[]u8 = nio_alloc(48);
    if(lab.len == 0) { return -1; }
    rgb_to_lab(lr, lg, lb, lab, 0);
    rgb_to_lab(rr, rg, rb, lab, 24);
    let de:i64 = de76_milli(lab, 0, 24);
    let jc:i64 = 0;
    if(de >= 2300) { jc = 1; }
    let margin2:i64 = iabs(de - 2300);
    let conf2:i64 = (1000 * margin2) / (margin2 + 1500);
    t_put64(px, 0, jc);
    t_put64(px, 8, conf2);
    t_put64(px, 16, margin2);
    // emission: boundary strip (visual)
    t_put64(px, 24, 1);
    t_put64(px, 32, hw - 8);
    t_put64(px, 40, 0);
    t_put64(px, 48, 16);
    t_put64(px, 56, h);
    t_put64(px, 72, de);
    return 0;
}

// ---------------- colorconst (white-patch + von-Kries, as Approach A) ----------------
fn task_colorconst(buf:[]u8, n:i32, op:[]u8, px:[]u8) i32 {
    if(n < 20) { return -1; }
    let w:i64 = t_get32(buf, 0);
    let h:i64 = t_get32(buf, 4);
    if(w < 8) { return -1; }
    if((w % 2) != 0) { return -1; }
    if(h < 4) { return -1; }
    let hw:i64 = w / 2;
    let base:i32 = 8;
    let ops:i64 = 0;
    // per half: mean rgb and white-patch (top-5% luminance mean)
    let hist:[]u8 = nio_alloc(256 * 8);
    if(hist.len == 0) { return -1; }
    let i:i32 = 0;
    while(i < 256 * 8) { hist[i] = 0; i = i + 1; }
    // store per-half: mean_r, mean_g, mean_b, white_r, white_g, white_b
    let stats:[]u8 = nio_alloc(2 * 6 * 8);
    if(stats.len == 0) { return -1; }
    i = 0;
    while(i < 2 * 6 * 8) { stats[i] = 0; i = i + 1; }
    let half:i32 = 0;
    while(half < 2) {
        let x0:i64 = 0;
        if(half == 1) { x0 = hw; }
        // mean
        let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0; let cn:i64 = 0;
        let x:i64 = x0;
        while(x < x0 + hw) {
            let y:i64 = 0;
            while(y < h) {
                let o:i32 = (base + (y * w + x) * 3) as i32;
                sr = sr + (buf[o] as i64); sg = sg + (buf[o+1] as i64); sb = sb + (buf[o+2] as i64);
                cn = cn + 1;
                y = y + 1; ops = ops + 1;
            }
            x = x + 1;
        }
        t_put64(stats, (half * 6) as i32 * 8, sr / cn);
        t_put64(stats, (half * 6 + 1) as i32 * 8, sg / cn);
        t_put64(stats, (half * 6 + 2) as i32 * 8, sb / cn);
        // white patch: top-5% luminance
        i = 0;
        while(i < 256 * 8) { hist[i] = 0; i = i + 1; }
        x = x0;
        while(x < x0 + hw) {
            let y:i64 = 0;
            while(y < h) {
                let o:i32 = (base + (y * w + x) * 3) as i32;
                let l:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
                let c:i64 = t_get64(hist, (l * 8) as i32);
                t_put64(hist, (l * 8) as i32, c + 1);
                y = y + 1; ops = ops + 1;
            }
            x = x + 1;
        }
        let total:i64 = hw * h;
        let need:i64 = total / 20;
        let acc:i64 = 0;
        let thr:i64 = 255;
        while(thr >= 0) {
            acc = acc + t_get64(hist, (thr * 8) as i32);
            if(acc >= need) { break; }
            thr = thr - 1;
        }
        let wr:i64 = 0; let wg:i64 = 0; let wb:i64 = 0; let wc:i64 = 0;
        x = x0;
        while(x < x0 + hw) {
            let y:i64 = 0;
            while(y < h) {
                let o:i32 = (base + (y * w + x) * 3) as i32;
                let l2:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
                if(l2 >= thr) {
                    wr = wr + (buf[o] as i64); wg = wg + (buf[o+1] as i64); wb = wb + (buf[o+2] as i64);
                    wc = wc + 1;
                }
                y = y + 1; ops = ops + 1;
            }
            x = x + 1;
        }
        if(wc == 0) { return -1; }
        t_put64(stats, (half * 6 + 3) as i32 * 8, wr / wc);
        t_put64(stats, (half * 6 + 4) as i32 * 8, wg / wc);
        t_put64(stats, (half * 6 + 5) as i32 * 8, wb / wc);
        half = half + 1;
    }
    // von-Kries: normalized = mean * 1000 / white (per channel)
    let lnr:i64 = t_get64(stats, 0) * 1000 / imax(t_get64(stats, 3 * 8), 1);
    let lng:i64 = t_get64(stats, 1 * 8) * 1000 / imax(t_get64(stats, 4 * 8), 1);
    let lnb:i64 = t_get64(stats, 2 * 8) * 1000 / imax(t_get64(stats, 5 * 8), 1);
    let rnr:i64 = t_get64(stats, 6 * 8) * 1000 / imax(t_get64(stats, 9 * 8), 1);
    let rng2:i64 = t_get64(stats, 7 * 8) * 1000 / imax(t_get64(stats, 10 * 8), 1);
    let rnb:i64 = t_get64(stats, 8 * 8) * 1000 / imax(t_get64(stats, 11 * 8), 1);
    let d:i64 = isqrt((lnr-rnr)*(lnr-rnr) + (lng-rng2)*(lng-rng2) + (lnb-rnb)*(lnb-rnb));
    let jc:i64 = 0;
    if(d >= 150) { jc = 1; }
    let margin:i64 = iabs(d - 150);
    let conf:i64 = (1000 * margin) / (margin + 100);
    t_put64(px, 0, jc);
    t_put64(px, 8, conf);
    t_put64(px, 16, margin);
    // emission: boundary strip (visual)
    t_put64(px, 24, 1);
    t_put64(px, 32, hw - 8);
    t_put64(px, 40, 0);
    t_put64(px, 48, 16);
    t_put64(px, 56, h);
    t_put64(px, 64, d);
    t_put64(px, 72, 0);
    t_put64(op, 0, ops);
    return 0;
}

// ---------------- shapetrans ----------------
// Otsu threshold -> foreground -> connected components -> bar occlusion
// detect + inpaint -> shape ratio vs prototypes.
// jcode: 0=CIRCLE, 1=SQUARE, 2=TRIANGLE. feat0=bar(0/1), feat1=ratio.
fn task_shapetrans(buf:[]u8, n:i32, op:[]u8, px:[]u8) i32 {
    if(n < 20) { return -1; }
    let w:i64 = t_get32(buf, 0);
    let h:i64 = t_get32(buf, 4);
    if(w != 96) { return -1; }
    if(h != 96) { return -1; }
    let base:i32 = 8;
    let npix:i32 = 9216;
    let ops:i64 = 0;
    // luminance + histogram
    let hist:[]u8 = nio_alloc(256 * 8);
    if(hist.len == 0) { return -1; }
    let i:i32 = 0;
    while(i < 256 * 8) { hist[i] = 0; i = i + 1; }
    let mask:[]u8 = nio_alloc(npix);
    if(mask.len == 0) { return -1; }
    i = 0;
    while(i < npix) {
        let o:i32 = base + i * 3;
        let l:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
        mask[i] = l as u8;
        let c:i64 = t_get64(hist, (l * 8) as i32);
        t_put64(hist, (l * 8) as i32, c + 1);
        i = i + 1; ops = ops + 1;
    }
    // Otsu
    let sum_all:i64 = 0;
    i = 0;
    while(i < 256) { sum_all = sum_all + (i as i64) * t_get64(hist, (i * 8) as i32); i = i + 1; }
    let w0:i64 = 0; let sum0:i64 = 0;
    let best_t:i64 = 0; let best_v:i64 = -1;
    let t:i64 = 0;
    while(t < 255) {
        w0 = w0 + t_get64(hist, (t * 8) as i32);
        sum0 = sum0 + t * t_get64(hist, (t * 8) as i32);
        let w1:i64 = (npix as i64) - w0;
        if(w0 > 0) {
            if(w1 > 0) {
                let m0:i64 = sum0 / w0;
                let m1:i64 = (sum_all - sum0) / w1;
                let dd:i64 = m0 - m1;
                let v:i64 = w0 * w1 * dd * dd;
                if(v > best_v) { best_v = v; best_t = t; }
            }
        }
        t = t + 1; ops = ops + 1;
    }
    // foreground = smaller class
    let bright_cnt:i64 = 0;
    i = 0;
    while(i < npix) {
        if((mask[i] as i64) > best_t) { bright_cnt = bright_cnt + 1; }
        i = i + 1;
    }
    let fg_bright:i64 = 0;
    if(bright_cnt * 2 < (npix as i64)) { fg_bright = 1; }
    i = 0;
    while(i < npix) {
        let isb:i64 = 0;
        if((mask[i] as i64) > best_t) { isb = 1; }
        if(isb == fg_bright) { mask[i] = 1; } else { mask[i] = 0; }
        i = i + 1; ops = ops + 1;
    }
    // row counts for bar detection
    let rowc:[]u8 = nio_alloc(96 * 8);
    if(rowc.len == 0) { return -1; }
    i = 0;
    while(i < 96 * 8) { rowc[i] = 0; i = i + 1; }
    let y:i64 = 0;
    while(y < 96) {
        let c2:i64 = 0;
        let x:i64 = 0;
        while(x < 96) {
            if(mask[(y * 96 + x) as i32] != 0) { c2 = c2 + 1; }
            x = x + 1; ops = ops + 1;
        }
        t_put64(rowc, (y * 8) as i32, c2);
        y = y + 1;
    }
    let ymin:i64 = 96; let ymax:i64 = -1;
    y = 0;
    while(y < 96) {
        if(t_get64(rowc, (y * 8) as i32) > 0) {
            if(y < ymin) { ymin = y; }
            ymax = y;
        }
        y = y + 1;
    }
    // longest zero-run within shape rows, length >= 6 -> bar
    let bar:i64 = 0;
    let bar_y0:i64 = 0; let bar_y1:i64 = 0;
    let run:i64 = 0; let run_start:i64 = 0; let best_run:i64 = 0;
    y = ymin;
    while(y <= ymax) {
        if(t_get64(rowc, (y * 8) as i32) == 0) {
            if(run == 0) { run_start = y; }
            run = run + 1;
        } else {
            if(run >= 6) {
                if(run > best_run) { best_run = run; bar_y0 = run_start; bar_y1 = y; }
            }
            run = 0;
        }
        y = y + 1; ops = ops + 1;
    }
    if(run >= 6) {
        if(run > best_run) { best_run = run; bar_y0 = run_start; bar_y1 = ymax + 1; }
    }
    if(best_run >= 6) {
        if(bar_y0 > 0) {
            if(bar_y1 < 96) { bar = 1; }
        }
    }
    // inpaint across the bar: mask[y][x] = mask[y0-1][x] & mask[y1][x]
    if(bar == 1) {
        y = bar_y0;
        while(y < bar_y1) {
            let x:i64 = 0;
            while(x < 96) {
                let a:u8 = mask[((bar_y0 - 1) * 96 + x) as i32];
                let b:u8 = mask[(bar_y1 * 96 + x) as i32];
                if(a != 0) {
                    if(b != 0) { mask[(y * 96 + x) as i32] = 1; }
                    else { mask[(y * 96 + x) as i32] = 0; }
                } else {
                    mask[(y * 96 + x) as i32] = 0;
                }
                x = x + 1; ops = ops + 1;
            }
            y = y + 1;
        }
    }
    // connected components (4-connectivity), largest = target
    let labels:[]u8 = nio_alloc(npix * 4);
    if(labels.len == 0) { return -1; }
    i = 0;
    while(i < npix * 4) { labels[i] = 0; i = i + 1; }
    let stack:[]u8 = nio_alloc(npix * 4);
    if(stack.len == 0) { return -1; }
    let nlabel:i64 = 0;
    let best_lab:i64 = 0; let best_sz:i64 = 0;
    let p:i32 = 0;
    while(p < npix) {
        if(mask[p] != 0) {
            if(t_get32(labels, p * 4) == 0) {
                nlabel = nlabel + 1;
                let sp:i32 = 0;
                t_put32(stack, 0, p as i64);
                sp = 1;
                t_put32(labels, p * 4, nlabel);
                let sz:i64 = 0;
                while(sp > 0) {
                    sp = sp - 1;
                    let q:i32 = t_get32(stack, sp * 4) as i32;
                    sz = sz + 1;
                    let qx:i64 = (q % 96) as i64;
                    let qy:i64 = (q / 96) as i64;
                    // 4 neighbors
                    if(qx > 0) {
                        let r2:i32 = q - 1;
                        if(mask[r2] != 0) { if(t_get32(labels, r2*4) == 0) { t_put32(labels, r2*4, nlabel); t_put32(stack, sp*4, r2 as i64); sp = sp + 1; } }
                    }
                    if(qx < 95) {
                        let r2:i32 = q + 1;
                        if(mask[r2] != 0) { if(t_get32(labels, r2*4) == 0) { t_put32(labels, r2*4, nlabel); t_put32(stack, sp*4, r2 as i64); sp = sp + 1; } }
                    }
                    if(qy > 0) {
                        let r2:i32 = q - 96;
                        if(mask[r2] != 0) { if(t_get32(labels, r2*4) == 0) { t_put32(labels, r2*4, nlabel); t_put32(stack, sp*4, r2 as i64); sp = sp + 1; } }
                    }
                    if(qy < 95) {
                        let r2:i32 = q + 96;
                        if(mask[r2] != 0) { if(t_get32(labels, r2*4) == 0) { t_put32(labels, r2*4, nlabel); t_put32(stack, sp*4, r2 as i64); sp = sp + 1; } }
                    }
                    ops = ops + 1;
                }
                if(sz > best_sz) { best_sz = sz; best_lab = nlabel; }
            }
        }
        p = p + 1;
    }
    if(best_sz < 50) { return -1; }
    // target stats: area, centroid, maxd2, bbox
    let area:i64 = 0; let sx:i64 = 0; let sy:i64 = 0;
    let bx0:i64 = 96; let by0:i64 = 96; let bx1:i64 = -1; let by1:i64 = -1;
    p = 0;
    while(p < npix) {
        if(t_get32(labels, p*4) == best_lab) {
            let qx:i64 = (p % 96) as i64;
            let qy:i64 = (p / 96) as i64;
            area = area + 1; sx = sx + qx; sy = sy + qy;
            if(qx < bx0) { bx0 = qx; }
            if(qx > bx1) { bx1 = qx; }
            if(qy < by0) { by0 = qy; }
            if(qy > by1) { by1 = qy; }
        }
        p = p + 1; ops = ops + 1;
    }
    let cx:i64 = sx / area;
    let cy:i64 = sy / area;
    let maxd2:i64 = 0;
    p = 0;
    while(p < npix) {
        if(t_get32(labels, p*4) == best_lab) {
            let qx:i64 = (p % 96) as i64;
            let qy:i64 = (p / 96) as i64;
            let dx:i64 = qx - cx; let dy:i64 = qy - cy;
            let d2:i64 = dx*dx + dy*dy;
            if(d2 > maxd2) { maxd2 = d2; }
        }
        p = p + 1; ops = ops + 1;
    }
    if(maxd2 == 0) { return -1; }
    let ratio:i64 = (area * 1000000) / (3142 * maxd2);
    // prototypes: circle 1000, square 637, triangle 606 (x1000)
    let dc:i64 = iabs(ratio - 1000);
    let ds:i64 = iabs(ratio - 637);
    let dt:i64 = iabs(ratio - 606);
    let jc:i64 = 0;
    let bestd:i64 = dc;
    if(ds < bestd) { jc = 1; bestd = ds; }
    if(dt < bestd) { jc = 2; bestd = dt; }
    let second:i64 = dc;
    if(jc == 0) {
        if(ds < dt) { second = ds; } else { second = dt; }
    }
    if(jc == 1) {
        if(dc < dt) { second = dc; } else { second = dt; }
    }
    if(jc == 2) {
        if(dc < ds) { second = dc; } else { second = ds; }
    }
    let margin:i64 = second - bestd;
    let conf:i64 = (1000 * margin) / (margin + 150);
    if(bar == 1) { conf = (conf * 6) / 10; }
    t_put64(px, 0, jc);
    t_put64(px, 8, conf);
    t_put64(px, 16, margin);
    // emission region: target bbox + 8px margin, clamped
    let ex0:i64 = bx0 - 8; if(ex0 < 0) { ex0 = 0; }
    let ey0:i64 = by0 - 8; if(ey0 < 0) { ey0 = 0; }
    let ex1:i64 = bx1 + 8; if(ex1 > 95) { ex1 = 95; }
    let ey1:i64 = by1 + 8; if(ey1 > 95) { ey1 = 95; }
    t_put64(px, 24, 1);
    t_put64(px, 32, ex0);
    t_put64(px, 40, ey0);
    t_put64(px, 48, ex1 - ex0 + 1);
    t_put64(px, 56, ey1 - ey0 + 1);
    t_put64(px, 64, bar);
    t_put64(px, 72, ratio);
    t_put64(op, 0, ops);
    return 0;
}

// ---------------- pitchdisc ----------------
// Two sequential tones; judgment describes tone B vs tone A.
// Glide-aware: if tone B glides through the threshold, judge by its endpoint
// (second half). jcode: 0=SAME, 1=HIGHER, 2=LOWER.
// feat0 = ppm distance, feat1 = glide(0/1).
fn pitch_f0(buf:[]u8, s0:i32, cnt:i32, op:[]u8) i64 {
    // f0 via min-|diff| over lags 24..160, parabolic interpolation for
    // sub-sample accuracy. Returns milli-Hz.
    let vals:[]u8 = nio_alloc(137 * 8);
    if(vals.len == 0) { return 0; }
    let lag:i64 = 24;
    while(lag <= 160) {
        let acc:i64 = 0;
        let k:i32 = 0;
        while(k < 600) {
            let a:i64 = t_get16s(buf, s0 + k * 2);
            let b:i64 = t_get16s(buf, s0 + (k as i64 + lag) as i32 * 2);
            acc = acc + iabs(a - b);
            k = k + 1;
        }
        t_put64(vals, ((lag - 24) * 8) as i32, acc);
        lag = lag + 1;
    }
    let ops:i64 = t_get64(op, 0);
    t_put64(op, 0, ops + 137 * 600);
    // find minimum
    let best:i64 = 24;
    let bestv:i64 = t_get64(vals, 0);
    lag = 25;
    while(lag <= 160) {
        let v:i64 = t_get64(vals, ((lag - 24) * 8) as i32);
        if(v < bestv) { bestv = v; best = lag; }
        lag = lag + 1;
    }
    if(best <= 24) { return (16000 * 1000) / best; }
    if(best >= 160) { return (16000 * 1000) / best; }
    let v0:i64 = t_get64(vals, ((best - 1 - 24) * 8) as i32);
    let v1:i64 = bestv;
    let v2:i64 = t_get64(vals, ((best + 1 - 24) * 8) as i32);
    let denom:i64 = v0 - 2 * v1 + v2;
    if(denom <= 0) { return (16000 * 1000) / best; }
    // interpolated lag = best + 0.5*(v0-v2)/denom
    // f0 = 16000000 / lag_interp
    let num:i64 = v0 - v2;
    let dl:i64 = best * denom * 2 + num;
    if(dl <= 0) { return (16000 * 1000) / best; }
    return (16000 * 1000 * denom * 2) / dl;
}
fn task_pitchdisc(buf:[]u8, n:i32, op:[]u8, px:[]u8) i32 {
    if(n < 20) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i64 = t_get32(buf, 4);
    if(sr != 16000) { return -1; }
    if(cnt < 4000) { return -1; }
    let s0:i32 = 8;
    // Structure: tone A [0,6400), gap [6400,7680), tone B [7680,cnt).
    // (0.4s tone, 0.08s gap at 16kHz, from the frozen generator.)
    if(cnt < 14080) { return -1; }
    // Tone A [0,6400): steady [320,6080). Tone B [7680,14080): steady [8000,13760).
    let fA:i64 = pitch_f0(buf, s0 + 1000 * 2, 200, op);
    let fB_full:i64 = pitch_f0(buf, s0 + 8680 * 2, 200, op);
    // second-half f0 of tone B (endpoint for glides): [10880,14080)
    let fB_half:i64 = pitch_f0(buf, s0 + 12000 * 2, 200, op);
    if(fA == 0) { return -1; }
    if(fB_full == 0) { return -1; }
    if(fB_half == 0) { return -1; }
    let glide:i64 = 0;
    if(iabs(fB_full - fB_half) * 1000000 / fB_full > 2000) { glide = 1; }
    let fB:i64 = fB_full;
    if(glide == 1) { fB = fB_half; }
    let d:i64 = iabs(fB - fA) * 1000000 / fA;
    let jc:i64 = 0;
    if(d >= 5000) {
        if(fB > fA) { jc = 1; } else { jc = 2; }
    }
    let margin:i64 = iabs(d - 5000);
    let conf:i64 = (1000 * margin) / (margin + 3000);
    if(glide == 1) { conf = (conf * 8) / 10; }
    t_put64(px, 0, jc);
    t_put64(px, 8, conf);
    t_put64(px, 16, margin);
    t_put64(px, 24, 0);
    t_put64(px, 32, 8);
    t_put64(px, 40, 8 + cnt * 2);
    t_put64(px, 64, d);
    t_put64(px, 72, glide);
    return 0;
}

// ---------------- timbredisc ----------------
// REUSE (cited): estimator ported from R2-9 src/r29.zag p_timbredisc
// (frozen, committed; 60/60 on the 370 harness primary). Goertzel at exact
// bins k=352*m (m=1..8) for 440 Hz harmonics, N=12800. The previous R2-10
// integer sign-quadrant estimator was biased ~1.5x high (DARK measured 1959
// vs generator-truth 1156) and carried an i64 overflow in the wh sum
// (fixed 2026-09-23, then replaced wholesale here as deliberate repair).
// Verdict codes (sense.zag): 0=PURE, 1=DARK, 2=RICH, 3=BRIGHT.
fn tmb_goertzel_c(m:i32) f64 {
    if(m == 1) { return 1.9702186523; }
    if(m == 2) { return 1.8817615379; }
    if(m == 3) { return 1.7372630289; }
    if(m == 4) { return 1.5410264856; }
    if(m == 5) { return 1.2988960967; }
    if(m == 6) { return 1.0180828315; }
    if(m == 7) { return 0.7069496876; }
    return 0.3747626292;
}
fn tmb_abs(x:f64) f64 { if(x < 0.0) { return 0.0 - x; } return x; }
fn task_timbredisc(buf:[]u8, n:i32, op:[]u8, px:[]u8) i32 {
    if(n < 8 + 12800 * 2) { return -1; }
    let sr:i64 = t_get32(buf, 0);
    let cnt:i64 = t_get32(buf, 4);
    if(sr != 16000) { return -1; }
    if(cnt < 12800) { return -1; }
    let base:i32 = 8;
    let totE:f64 = 0.0;
    let wsum:f64 = 0.0;
    let m:i32 = 1;
    while(m <= 8) {
        let c:f64 = tmb_goertzel_c(m);
        let s0:f64 = 0.0;
        let s1:f64 = 0.0;
        let s2:f64 = 0.0;
        let i:i32 = 0;
        while(i < 12800) {
            let xv:f64 = (t_get16s(buf, base + i * 2)) as f64;
            s0 = xv + c * s1 - s2;
            s2 = s1;
            s1 = s0;
            i = i + 1;
        }
        let e:f64 = s1 * s1 + s2 * s2 - c * s1 * s2;
        totE = totE + e;
        wsum = wsum + ((m as f64) * e);
        m = m + 1;
    }
    let ops:i64 = t_get64(op, 0);
    t_put64(op, 0, ops + 12800 * 8);
    let jc:i64 = 0;
    let conf:i64 = 0;
    let margin:i64 = 0;
    if(totE > 1000000.0) {
        let cent:f64 = wsum / totE;
        // class profile centroids (harmonic units): PURE 1.0, DARK 1.156,
        // RICH 1.697, BRIGHT 2.759. Boundaries at midpoints: 1.078, 1.4265, 2.228.
        let dP:f64 = tmb_abs(cent - 1.0);
        let dD:f64 = tmb_abs(cent - 1.156);
        let dR:f64 = tmb_abs(cent - 1.697);
        let dB:f64 = tmb_abs(cent - 2.759);
        jc = 0;
        let bd:f64 = tmb_abs(cent - 1.078);
        if(dD < dP) { if(dD < dR) { if(dD < dB) { jc = 1; if(cent < 1.156) { bd = tmb_abs(cent - 1.078); } else { bd = tmb_abs(cent - 1.4265); } } } }
        if(dR < dP) { if(dR < dD) { if(dR < dB) { jc = 2; if(cent < 1.697) { bd = tmb_abs(cent - 1.4265); } else { bd = tmb_abs(cent - 2.228); } } } }
        if(dB < dP) { if(dB < dD) { if(dB < dR) { jc = 3; bd = tmb_abs(cent - 2.228); } } }
        margin = ((bd * 1000.0)) as i64;
        conf = ((bd / 0.35) * 1000.0) as i64;
        if(conf > 1000) { conf = 1000; }
        if(conf < 0) { conf = 0; }
        t_put64(px, 64, ((cent * 1000.0)) as i64);
        t_put64(px, 72, 440000);
    }
    t_put64(px, 0, jc);
    t_put64(px, 8, conf);
    t_put64(px, 16, margin);
    t_put64(px, 24, 0);
    t_put64(px, 32, 8);
    t_put64(px, 40, 8 + cnt * 2);
    return 0;
}

// ---------------- motiondir ----------------
// Frame-difference energy on a center crop, three-way deblur comparison
// (forward / backward / none), reversal detection, STILL threshold.
// jcode: 0..7 = E NE N NW W SW S SE (compass), 8=STILL.
// feat0 = reversal(0/1), feat1 = still(0/1).
fn motion_deblur_score(f0:[]u8, f1:[]u8, dx:i64, dy:i64, cx0:i64, cy0:i64, cw:i64, ch:i64, w:i64, h:i64) i64 {
    let acc:i64 = 0;
    let x:i64 = cx0;
    while(x < cx0 + cw) {
        let y:i64 = cy0;
        while(y < cy0 + ch) {
            let sx:i64 = x + dx;
            let sy:i64 = y + dy;
            if(sx < 0) { sx = 0; }
            if(sx >= w) { sx = w - 1; }
            if(sy < 0) { sy = 0; }
            if(sy >= h) { sy = h - 1; }
            let o0:i32 = (y * w + x) as i32;
            let o1:i32 = (sy * w + sx) as i32;
            acc = acc + iabs((f0[o0] as i64) - (f1[o1] as i64));
            y = y + 1;
        }
        x = x + 1;
    }
    return acc;
}
fn task_motiondir(buf:[]u8, n:i32, op:[]u8, px:[]u8) i32 {
    if(n < 28) { return -1; }
    let nf:i64 = t_get32(buf, 0);
    let w:i64 = t_get32(buf, 4);
    let h:i64 = t_get32(buf, 8);
    if(w != 64) { return -1; }
    if(h != 64) { return -1; }
    if(nf < 8) { return -1; }
    if(nf > 32) { return -1; }
    let fsz:i64 = w * h;
    let base:i32 = 12;
    let ops:i64 = 0;
    // materialize frame0 gray and frame1 gray into arenas
    let f0:[]u8 = nio_alloc(fsz as i32);
    if(f0.len == 0) { return -1; }
    let f1:[]u8 = nio_alloc(fsz as i32);
    if(f1.len == 0) { return -1; }
    let i:i32 = 0;
    while(i < fsz as i32) {
        let o:i32 = base + i * 3;
        f0[i] = (((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3) as u8;
        i = i + 1; ops = ops + 1;
    }
    i = 0;
    while(i < fsz as i32) {
        let o:i32 = (base as i64 + fsz * 3 + (i as i64) * 3) as i32;
        f1[i] = (((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3) as u8;
        i = i + 1; ops = ops + 1;
    }
    // frame-difference energy (all pairs)
    let fdiff:i64 = 0;
    i = 0;
    while(i < fsz as i32) {
        fdiff = fdiff + iabs((f0[i] as i64) - (f1[i] as i64));
        i = i + 1; ops = ops + 1;
    }
    // STILL test
    let still:i64 = 0;
    if(fdiff * 1000000 / (fsz * 255) < 1500) { still = 1; }
    // center crop
    let cx0:i64 = 16; let cy0:i64 = 16; let cw:i64 = 32; let ch:i64 = 32;
    // 8 directions, per-frame px: 1 (E), 1 (NE), 0 (N), -1 (NW), -1 (W), -1 (SW), 0 (S), 1 (SE)
    // dx,dy
    let bestd:i64 = 0;
    let best_e:i64 = 9223372036854775807;
    let dd:i64 = 0;
    while(dd < 8) {
        let dx:i64 = 0; let dy:i64 = 0;
        if(dd == 0) { dx = 1; dy = 0; }
        if(dd == 1) { dx = 1; dy = -1; }
        if(dd == 2) { dx = 0; dy = -1; }
        if(dd == 3) { dx = -1; dy = -1; }
        if(dd == 4) { dx = -1; dy = 0; }
        if(dd == 5) { dx = -1; dy = 1; }
        if(dd == 6) { dx = 0; dy = 1; }
        if(dd == 7) { dx = 1; dy = 1; }
        let e:i64 = motion_deblur_score(f0, f1, dx, dy, cx0, cy0, cw, ch, w, h);
        ops = ops + cw * ch;
        if(e < best_e) { best_e = e; bestd = dd; }
        dd = dd + 1;
    }
    let e_none:i64 = motion_deblur_score(f0, f1, 0, 0, cx0, cy0, cw, ch, w, h);
    ops = ops + cw * ch;
    // reversal: compare best-dir energy forward vs backward
    let bdx:i64 = 0; let bdy:i64 = 0;
    if(bestd == 0) { bdx = 1; bdy = 0; }
    if(bestd == 1) { bdx = 1; bdy = -1; }
    if(bestd == 2) { bdx = 0; bdy = -1; }
    if(bestd == 3) { bdx = -1; bdy = -1; }
    if(bestd == 4) { bdx = -1; bdy = 0; }
    if(bestd == 5) { bdx = -1; bdy = 1; }
    if(bestd == 6) { bdx = 0; bdy = 1; }
    if(bestd == 7) { bdx = 1; bdy = 1; }
    let e_back:i64 = motion_deblur_score(f0, f1, -bdx, -bdy, cx0, cy0, cw, ch, w, h);
    ops = ops + cw * ch;
    let rev:i64 = 0;
    if(e_back * 100 < best_e * 95) { rev = 1; }
    let jc:i64 = bestd;
    if(still == 1) { jc = 8; }
    // margin: (e_none - best_e)/e_none x1000, penalized if reversal
    let margin:i64 = 0;
    if(e_none > 0) { margin = (e_none - best_e) * 1000 / e_none; }
    if(margin < 0) { margin = 0; }
    let conf:i64 = (1000 * margin) / (margin + 60);
    if(rev == 1) { conf = (conf * 8) / 10; }
    if(still == 1) { conf = 800; margin = 100; }
    t_put64(px, 0, jc);
    t_put64(px, 8, conf);
    t_put64(px, 16, margin);
    // emission: cited span = frames 0-1 bytes [12, 12+2*64*64*3);
    // artifact depicts both frames side-by-side (motion needs 2 frames).
    t_put64(px, 24, 2);
    t_put64(px, 32, 12);
    t_put64(px, 40, 12 + 2 * fsz * 3);
    t_put64(px, 64, rev);
    t_put64(px, 72, still);
    t_put64(op, 0, ops);
    return 0;
}

// ---------------- verdict strings ----------------
// task ids: 0 colordisc, 1 colorconst, 2 shapetrans, 3 pitchdisc, 4 timbredisc, 5 motiondir
fn verdict_str(task:i32, jc:i64, out:[]u8) i32 {
    if(task == 0) {
        if(jc == 0) { out[0]=83; out[1]=65; out[2]=77; out[3]=69; return 4; }
        out[0]=68; out[1]=73; out[2]=70; out[3]=70; out[4]=69; out[5]=82; out[6]=69; out[7]=78; out[8]=84;
        return 9;
    }
    if(task == 1) {
        if(jc == 0) { out[0]=83;out[1]=65;out[2]=77;out[3]=69;out[4]=95;out[5]=83;out[6]=85;out[7]=82;out[8]=70;out[9]=65;out[10]=67;out[11]=69; return 12; }
        out[0]=68; out[1]=73; out[2]=70; out[3]=70; out[4]=69; out[5]=82; out[6]=69; out[7]=78; out[8]=84;
        return 9;
    }
    if(task == 2) {
        if(jc == 0) { out[0]=67;out[1]=73;out[2]=82;out[3]=67;out[4]=76;out[5]=69; return 6; }
        if(jc == 1) { out[0]=83;out[1]=81;out[2]=85;out[3]=65;out[4]=82;out[5]=69; return 6; }
        out[0]=84;out[1]=82;out[2]=73;out[3]=65;out[4]=78;out[5]=71;out[6]=76;out[7]=69; return 8;
    }
    if(task == 3) {
        if(jc == 0) { out[0]=83; out[1]=65; out[2]=77; out[3]=69; return 4; }
        if(jc == 1) { out[0]=72;out[1]=73;out[2]=71;out[3]=72;out[4]=69;out[5]=82; return 6; }
        out[0]=76;out[1]=79;out[2]=87;out[3]=69;out[4]=82; return 5;
    }
    if(task == 4) {
        if(jc == 0) { out[0]=80;out[1]=85;out[2]=82;out[3]=69; return 4; }
        if(jc == 1) { out[0]=68;out[1]=65;out[2]=82;out[3]=75; return 4; }
        if(jc == 2) { out[0]=82;out[1]=73;out[2]=67;out[3]=72; return 4; }
        out[0]=66;out[1]=82;out[2]=73;out[3]=71;out[4]=72;out[5]=84; return 6;
    }
    // motiondir
    if(jc == 0) { out[0]=69; return 1; }
    if(jc == 1) { out[0]=78;out[1]=69; return 2; }
    if(jc == 2) { out[0]=78; return 1; }
    if(jc == 3) { out[0]=78;out[1]=87; return 2; }
    if(jc == 4) { out[0]=87; return 1; }
    if(jc == 5) { out[0]=83;out[1]=87; return 2; }
    if(jc == 6) { out[0]=83; return 1; }
    if(jc == 7) { out[0]=83;out[1]=69; return 2; }
    out[0]=83;out[1]=84;out[2]=73;out[3]=76;out[4]=76; return 5;
}
fn streq(a:[]u8, b:[]u8) i64 {
    if(a.len != b.len) { return 0; }
    let i:i32 = 0;
    while(i < a.len) {
        if(a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn task_id_of(name:[]u8) i32 {
    if(streq(name, "colordisc") == 1) { return 0; }
    if(streq(name, "colorconst") == 1) { return 1; }
    if(streq(name, "shapetrans") == 1) { return 2; }
    if(streq(name, "pitchdisc") == 1) { return 3; }
    if(streq(name, "timbredisc") == 1) { return 4; }
    if(streq(name, "motiondir") == 1) { return 5; }
    return -1;
}

// ---------------- emission (exact-span replay only) ----------------
// Returns mapping_ok (1/0). In emit mode with mapping_ok=1, writes the
// artifact (WAV for audio spans, PPM for visual/video regions) and its
// SHA256 hex into edigest (64 bytes). No synthesis: bytes are copied
// verbatim from the fixture; only a container header is added so a human
// can play/view the span.
fn do_emission(task:i32, buf:[]u8, n:i32, px:[]u8, mode_emit:i64,
               artdir:[]u8, base:[]u8, edigest:[]u8, aw:[]u8) i64 {
    let sk:i64 = t_get64(px, 24);
    let sa:i64 = t_get64(px, 32);
    let sb:i64 = t_get64(px, 40);
    let ok:i64 = 0;
    if(sk == 0) {
        if(sa >= 0) { if(sb > sa) { if(sb <= (n as i64)) { ok = 1; } } }
    }
    if(sk == 1) {
        let sw:i64 = t_get64(px, 48);
        let sh:i64 = t_get64(px, 56);
        // parse image dimensions from buffer header
        let iw:i64 = t_get32(buf, 0);
        let ih:i64 = t_get32(buf, 4);
        if(sa >= 0) { if(sb >= 0) { if(sw > 0) { if(sh > 0) {
            if(sa + sw <= iw) { if(sb + sh <= ih) { ok = 1; } }
        } } } }
    }
    if(sk == 2) {
        if(sa >= 0) { if(sb > sa) { if(sb <= (n as i64)) { ok = 1; } } }
    }
    let i:i32 = 0;
    while(i < 64) { edigest[i] = 48; i = i + 1; }
    aw[0] = 48; // artifact_written = "0"
    if(ok == 0) { return 0; }
    if(mode_emit == 0) { return 1; }
    // build artifact
    let art:[]u8 = nio_alloc(200000);
    if(art.len == 0) { return 1; }
    let alen:i32 = 0;
    if(sk == 0) {
        // WAV: 44-byte header + s16le samples from [sa,sb)
        let nsamp:i64 = (sb - sa) / 2;
        // RIFF header
        art[0]=82; art[1]=73; art[2]=70; art[3]=70;
        t_put32(art, 4, (36 + nsamp * 2) as i64);
        art[8]=87; art[9]=65; art[10]=86; art[11]=69;
        art[12]=102; art[13]=109; art[14]=116; art[15]=32;
        t_put32(art, 16, 16);
        t_put16(art, 20, 1);
        t_put16(art, 22, 1);
        t_put32(art, 24, 16000);
        t_put32(art, 28, 32000);
        t_put16(art, 32, 2);
        t_put16(art, 34, 16);
        art[36]=100; art[37]=97; art[38]=116; art[39]=97;
        t_put32(art, 40, nsamp * 2);
        alen = 44;
        let k:i64 = 0;
        while(k < nsamp * 2) {
            art[alen] = buf[(sa + k) as i32];
            alen = alen + 1;
            k = k + 1;
        }
    } else {
        if(sk == 1) {
            // PPM P6: region [sa,sb)x[..,..) from WxH RGB (header-parsed)
            let sw:i64 = t_get64(px, 48);
            let sh:i64 = t_get64(px, 56);
            let iw:i64 = t_get32(buf, 0);
            // header "P6\n<w> <h>\n255\n"
            art[0]=80; art[1]=54; art[2]=10;
            let ws:[]u8 = _zag_i64_to_str(sw);
            let hs:[]u8 = _zag_i64_to_str(sh);
            alen = 3;
            let k:i32 = 0;
            while(k < ws.len) { art[alen]=ws[k]; alen=alen+1; k=k+1; }
            art[alen]=32; alen=alen+1;
            k = 0;
            while(k < hs.len) { art[alen]=hs[k]; alen=alen+1; k=k+1; }
            art[alen]=10; alen=alen+1;
            art[alen]=50; art[alen+1]=53; art[alen+2]=53; art[alen+3]=10;
            alen = alen + 4;
            let y:i64 = sb;
            while(y < sb + sh) {
                let x:i64 = sa;
                while(x < sa + sw) {
                    let o:i32 = (8 + (y * iw + x) * 3) as i32;
                    art[alen]=buf[o]; art[alen+1]=buf[o+1]; art[alen+2]=buf[o+2];
                    alen = alen + 3;
                    x = x + 1;
                }
                y = y + 1;
            }
        } else {
            // PPM P6: frames 0|1 side-by-side (128x64) from the .vid.
            // The percept's cited span is the 2-frame window
            // [12, 12+2*64*64*3); a single still cannot witness motion, so
            // the emission depicts BOTH cited frames. Payload = the exact
            // source bytes of frame0 then frame1 (KB-E1: payload-identity).
            art[0]=80; art[1]=54; art[2]=10;
            art[3]=49; art[4]=50; art[5]=56; art[6]=32; art[7]=54; art[8]=52; art[9]=10;
            art[10]=50; art[11]=53; art[12]=53; art[13]=10;
            alen = 14;
            let k:i64 = 0;
            while(k < 2 * 64 * 64 * 3) {
                art[alen] = buf[(12 + k) as i32];
                alen = alen + 1;
                k = k + 1;
            }
        }
    }
    // artifact path: <artdir>/<base>.wav or .ppm
    let path:[]u8 = nio_alloc(512);
    if(path.len == 0) { return 1; }
    let pl:i32 = 0;
    let k:i32 = 0;
    while(k < artdir.len) { path[pl]=artdir[k]; pl=pl+1; k=k+1; }
    path[pl]=47; pl=pl+1;
    k = 0;
    while(k < base.len) { path[pl]=base[k]; pl=pl+1; k=k+1; }
    if(sk == 0) { path[pl]=46; path[pl+1]=119; path[pl+2]=97; path[pl+3]=118; pl=pl+4; }
    else { path[pl]=46; path[pl+1]=112; path[pl+2]=112; path[pl+3]=109; pl=pl+4; }
    let w:i64 = z_write_file(path[0..pl], art[0..alen]);
    if(w < 0) { return 0; }
    aw[0] = 49;
    // digest of the artifact bytes
    let hh:[]u8 = nio_alloc(32);
    if(hh.len == 0) { return 1; }
    if(ns_sha256(art[0..alen], hh) != 0) { return 1; }
    hex_of(hh, edigest, 0);
    return 1;
}

// ---------------- revise (gate audit) ----------------
// Input TSV (no header): fixture TAB task TAB jcode TAB conf TAB margin TAB
//   feat0 TAB feat1 TAB truth TAB human
// Grid-searches (theta, veto) and reports false-install rates. Prints
// AUDIT=PASS/FAIL for the frozen gate (THETA=700, VETO=0).
fn mode_revise(tpath:[]u8) i32 {
    // Deliberate gate revision (R2-12 rules): grid-search (theta, veto) against
    // human "witnessed correctly" verdicts. Does NOT modify the gate; prints a
    // recommendation. Constitutional veto: a candidate that installs FEWER
    // witnessed-correct trials than the frozen initial gate (theta=700, veto=0)
    // is REFUSED (no recall degradation), however low its false-install count.
    // Rows with human=PENDING are excluded (verdict not yet received).
    let buf:[]u8 = nio_alloc(1 << 20);
    if(buf.len == 0) { return 1; }
    let n:i64 = z_read(tpath, buf, 1 << 20);
    if(n <= 0) { return fail("revise", "read-fail"); }
    // pending marker hash: strhash("PENDING") = len*P + h%P
    let pend:i64 = strhash_cstr("PENDING");
    // parse lines into table: 9 cols x i64 (taskid,jcode,conf,margin,feat0,feat1,truth_h,human_h,skip)
    let maxr:i32 = 4096;
    let tab:[]u8 = nio_alloc((maxr * 9 * 8) as i32);
    if(tab.len == 0) { return 1; }
    let nr:i32 = 0;
    let pos:i64 = 0;
    while(pos < n) {
        let eol:i64 = pos;
        while(eol < n) { if(buf[eol as i32] == 10) { break; } eol = eol + 1; }
        if(eol > pos) {
            // field arena: 9 fields, (start,end) at fi*16, fi*16+8
            let f:[]u8 = nio_alloc(9 * 16);
            if(f.len == 0) { return 1; }
            let fi:i32 = 0; let fs:i64 = pos;
            let k:i64 = pos;
            while(k <= eol) {
                let c:u8 = 10;
                if(k < eol) { c = buf[k as i32]; }
                if(c == 9) { t_put64(f, fi*16, fs); t_put64(f, fi*16+8, k); fi = fi + 1; fs = k + 1; }
                if(c == 10) { t_put64(f, fi*16, fs); t_put64(f, fi*16+8, k); fi = fi + 1; }
                k = k + 1;
            }
            if(fi >= 9) {
                if(nr < maxr) {
                    let base:i32 = (nr*9+0)*8;
                    // col0=fixture (skipped), col1=task name -> task id
                    let ts:i64 = t_get64(f, 1*16); let te:i64 = t_get64(f, 1*16+8);
                    let tid:i64 = task_id_of(buf[ts as i32 .. te as i32]) as i64;
                    t_put64(tab, base+0*8, tid);
                    t_put64(tab, base+1*8, atoi_field(buf, t_get64(f, 2*16), t_get64(f, 2*16+8)));
                    t_put64(tab, base+2*8, atoi_field(buf, t_get64(f, 3*16), t_get64(f, 3*16+8)));
                    t_put64(tab, base+3*8, atoi_field(buf, t_get64(f, 4*16), t_get64(f, 4*16+8)));
                    t_put64(tab, base+4*8, atoi_field(buf, t_get64(f, 5*16), t_get64(f, 5*16+8)));
                    t_put64(tab, base+5*8, atoi_field(buf, t_get64(f, 6*16), t_get64(f, 6*16+8)));
                    t_put64(tab, base+6*8, strhash(buf, t_get64(f, 7*16), t_get64(f, 7*16+8)));
                    let hh:i64 = strhash(buf, t_get64(f, 8*16), t_get64(f, 8*16+8));
                    t_put64(tab, base+7*8, hh);
                    // col8: skip=1 if task unknown or human verdict pending
                    let sk:i64 = 0;
                    if(tid < 0) { sk = 1; }
                    if(hh == pend) { sk = 1; }
                    t_put64(tab, base+8*8, sk);
                    nr = nr + 1;
                }
            }
        }
        pos = eol + 1;
    }
    let ob:[]u8 = nio_alloc(8192);
    if(ob.len == 0) { return 1; }
    let opos:i32 = 0;
    opos = ob_kv(ob, opos, "revise_rows", _zag_i64_to_str(nr as i64));
    // frozen initial gate reference: theta=700, veto=0
    let fz_fi:i64 = 0; let fz_ir:i64 = 0; let fz_irc:i64 = 0;
    let r0:i32 = 0;
    while(r0 < nr) {
        let base:i32 = (r0*9+0)*8;
        if(t_get64(tab, base+8*8) == 0) {
            let conf:i64 = t_get64(tab, base+2*8);
            if(conf >= 700) {
                fz_ir = fz_ir + 1;
                let mh:i64 = verdict_hash(t_get64(tab, base+0*8) as i32, t_get64(tab, base+1*8));
                if(mh == t_get64(tab, base+7*8)) { fz_irc = fz_irc + 1; }
                else { fz_fi = fz_fi + 1; }
            }
        }
        r0 = r0 + 1;
    }
    opos = ob_kv(ob, opos, "frozen_theta", "700");
    opos = ob_kv(ob, opos, "frozen_veto", "0");
    opos = ob_kv(ob, opos, "frozen_installs", _zag_i64_to_str(fz_ir));
    opos = ob_kv(ob, opos, "frozen_installs_correct", _zag_i64_to_str(fz_irc));
    opos = ob_kv(ob, opos, "frozen_false_installs", _zag_i64_to_str(fz_fi));
    // grid search with constitutional veto
    let best_fi:i64 = 1000000; let best_irc:i64 = -1; let best_ir:i64 = -1;
    let best_th:i64 = 700; let best_v:i64 = 0;
    let vetoed:i64 = 0;
    let vetoed_best_fi:i64 = 1000000; let vetoed_best_th:i64 = 0; let vetoed_best_v:i64 = 0;
    let th:i64 = 500;
    while(th <= 950) {
        let vi:i64 = 0;
        while(vi <= 3) {
            let fi2:i64 = 0; let ir2:i64 = 0; let irc2:i64 = 0;
            let r:i32 = 0;
            while(r < nr) {
                let base:i32 = (r*9+0)*8;
                if(t_get64(tab, base+8*8) == 0) {
                    let conf:i64 = t_get64(tab, base+2*8);
                    let margin:i64 = t_get64(tab, base+3*8);
                    let feat0:i64 = t_get64(tab, base+4*8);
                    let veto:i64 = 0;
                    if(vi == 1) { if(feat0 != 0) { veto = 1; } }
                    if(vi == 2) { if(margin < 100) { veto = 1; } }
                    if(vi == 3) { if(feat0 != 0) { veto = 1; } else { if(margin < 100) { veto = 1; } } }
                    if(conf >= th) {
                        if(veto == 0) {
                            ir2 = ir2 + 1;
                            let mh:i64 = verdict_hash(t_get64(tab, base+0*8) as i32, t_get64(tab, base+1*8));
                            if(mh == t_get64(tab, base+7*8)) { irc2 = irc2 + 1; }
                            else { fi2 = fi2 + 1; }
                        }
                    }
                }
                r = r + 1;
            }
            // CONSTITUTIONAL VETO: refuse any candidate that installs fewer
            // witnessed-correct trials than the frozen initial gate.
            if(irc2 < fz_irc) {
                vetoed = vetoed + 1;
                if(fi2 < vetoed_best_fi) {
                    vetoed_best_fi = fi2; vetoed_best_th = th; vetoed_best_v = vi;
                }
            } else {
                // objective: minimize false installs; tie-break: more
                // witnessed-correct installs; then more installs total.
                let better:i64 = 0;
                if(fi2 < best_fi) { better = 1; }
                else {
                    if(fi2 == best_fi) {
                        if(irc2 > best_irc) { better = 1; }
                        else {
                            if(irc2 == best_irc) { if(ir2 > best_ir) { better = 1; } }
                        }
                    }
                }
                if(better == 1) {
                    best_fi = fi2; best_irc = irc2; best_ir = ir2;
                    best_th = th; best_v = vi;
                }
            }
            vi = vi + 1;
        }
        th = th + 25;
    }
    opos = ob_kv(ob, opos, "vetoed_candidates", _zag_i64_to_str(vetoed));
    opos = ob_kv(ob, opos, "vetoed_best_false_installs", _zag_i64_to_str(vetoed_best_fi));
    opos = ob_kv(ob, opos, "vetoed_best_theta", _zag_i64_to_str(vetoed_best_th));
    opos = ob_kv(ob, opos, "vetoed_best_veto", _zag_i64_to_str(vetoed_best_v));
    opos = ob_kv(ob, opos, "best_theta", _zag_i64_to_str(best_th));
    opos = ob_kv(ob, opos, "best_veto", _zag_i64_to_str(best_v));
    opos = ob_kv(ob, opos, "best_false_installs", _zag_i64_to_str(best_fi));
    opos = ob_kv(ob, opos, "best_installs_correct", _zag_i64_to_str(best_irc));
    opos = ob_kv(ob, opos, "best_installs", _zag_i64_to_str(best_ir));
    let bfr:i64 = 0;
    if(nr > 0) { bfr = (best_fi * 10000) / (nr as i64); }
    opos = ob_kv(ob, opos, "best_false_install_bp", _zag_i64_to_str(bfr));
    if(bfr <= 300) { opos = ob_kv(ob, opos, "AUDIT", "PASS"); }
    else { opos = ob_kv(ob, opos, "AUDIT", "FAIL"); }
    nio_write_all(1, ob[0..opos]);
    return 0;
}
fn strhash_cstr(s:[]u8) i64 {
    // strhash over a whole slice: strhash(buf, 0, len)
    return strhash(s, 0, s.len as i64);
}
fn atoi_field(buf:[]u8, s:i64, e:i64) i64 {
    let v:i64 = 0;
    let neg:i64 = 0;
    let k:i64 = s;
    if(k < e) { if(buf[k as i32] == 45) { neg = 1; k = k + 1; } }
    while(k < e) {
        let c:u8 = buf[k as i32];
        if(c >= 48) { if(c <= 57) { v = v * 10 + ((c - 48) as i64); } }
        k = k + 1;
    }
    if(neg == 1) { return -v; }
    return v;
}
fn strhash(buf:[]u8, s:i64, e:i64) i64 {
    let h:i64 = 146959;
    let k:i64 = s;
    while(k < e) {
        h = h * 1099511628211 + (buf[k as i32] as i64);
        // keep in 63 bits
        h = h & 9223372036854775807;
        k = k + 1;
    }
    return (e - s) * 1000000007 + h % 1000000007;
}
fn verdict_hash(task:i64, jc:i64) i64 {
    // reproduce verdict_str output hash for comparison
    let tmp:[]u8 = nio_alloc(16);
    if(tmp.len == 0) { return -1; }
    let L:i32 = verdict_str(task as i32, jc, tmp);
    return strhash(tmp, 0, L as i64);
}

// ---------------- main ----------------
fn main(argc:i32, argv:[]u8) i32 {
    let a1:[]u8 = _zag_arg(1);
    if(_zag_strcmp(a1, "revise") == 1) {
        return mode_revise(_zag_arg(2));
    }
    if(_zag_strcmp(a1, "batch") == 1) {
        let btask:[]u8 = _zag_arg(2);
        let tid:i32 = task_id_of(btask);
        if(tid < 0) { return fail(btask, "bad-task"); }
        let bmode:[]u8 = _zag_arg(4);
        let bemit:i64 = 0;
        if(_zag_strcmp(bmode, "emit") == 1) { bemit = 1; }
        return mode_batch(tid, btask, _zag_arg(3), bemit, _zag_arg(5));
    }
    let taskname:[]u8 = a1;
    let fixpath:[]u8 = _zag_arg(2);
    let modename:[]u8 = _zag_arg(3);
    let prevhex:[]u8 = _zag_arg(4);
    let artdir:[]u8 = _zag_arg(5);
    let task:i32 = task_id_of(taskname);
    if(task < 0) { return fail(taskname, "bad-task"); }
    let mode_emit:i64 = 0;
    if(_zag_strcmp(modename, "emit") == 1) { mode_emit = 1; }
    else {
        if(_zag_strcmp(modename, "noemit") != 1) { return fail(taskname, "bad-mode"); }
    }
    // read fixture (cap 8MB)
    let cap:i64 = 8388608;
    let buf:[]u8 = nio_alloc(cap as i32);
    if(buf.len == 0) { return fail(taskname, "alloc"); }
    let n:i64 = z_read(fixpath, buf, cap);
    if(n <= 0) { return fail(taskname, "read-fail"); }
    // percept arena (72 bytes) + ops (8 bytes)
    let px:[]u8 = nio_alloc(80);
    if(px.len == 0) { return fail(taskname, "alloc"); }
    let op:[]u8 = nio_alloc(16);
    if(op.len == 0) { return fail(taskname, "alloc"); }
    let i:i32 = 0;
    while(i < 80) { px[i] = 0; i = i + 1; }
    i = 0;
    while(i < 16) { op[i] = 0; i = i + 1; }
    let rc:i32 = -1;
    if(task == 0) { rc = task_colordisc(buf, n as i32, op, px); }
    if(task == 1) { rc = task_colorconst(buf, n as i32, op, px); }
    if(task == 2) { rc = task_shapetrans(buf, n as i32, op, px); }
    if(task == 3) { rc = task_pitchdisc(buf, n as i32, op, px); }
    if(task == 4) { rc = task_timbredisc(buf, n as i32, op, px); }
    if(task == 5) { rc = task_motiondir(buf, n as i32, op, px); }
    if(rc != 0) { return fail(taskname, "front-end-fail"); }
    let jc:i64 = t_get64(px, 0);
    let conf:i64 = t_get64(px, 8);
    let margin:i64 = t_get64(px, 16);
    let ops:i64 = t_get64(op, 0);
    let feat0:i64 = t_get64(px, 64);
    let feat1:i64 = t_get64(px, 72);
    // base name for artifacts
    let bl:i32 = fixpath.len;
    let bs:i32 = 0;
    i = 0;
    while(i < fixpath.len) {
        if(fixpath[i] == 47) { bs = i + 1; }
        i = i + 1;
    }
    let base:[]u8 = fixpath[bs..bl];
    // emission (exact-span replay only)
    let edigest:[]u8 = nio_alloc(64);
    if(edigest.len == 0) { return fail(taskname, "alloc"); }
    let aw:[]u8 = nio_alloc(1);
    if(aw.len == 0) { return fail(taskname, "alloc"); }
    let mapping_ok:i64 = do_emission(task, buf, n as i32, px, mode_emit, artdir, base, edigest, aw);
    // install gate (frozen): INSTALL iff mapping_ok AND conf >= 700. VETO_ID=0 (none).
    let disp:[]u8 = "WITHHOLD";
    if(mapping_ok == 1) {
        if(conf >= 700) { disp = "INSTALL"; }
    }
    // verdict string
    let vs:[]u8 = nio_alloc(16);
    if(vs.len == 0) { return fail(taskname, "alloc"); }
    let vl:i32 = verdict_str(task, jc, vs);
    // ledger: hash = sha256(prev_hash_bytes || record)
    let prevb:[]u8 = nio_alloc(32);
    if(prevb.len == 0) { return fail(taskname, "alloc"); }
    if(unhex(prevhex, prevb) != 0) { return fail(taskname, "bad-prevhash"); }
    // record
    let rec:[]u8 = nio_alloc(1024);
    if(rec.len == 0) { return fail(taskname, "alloc"); }
    let rp:i32 = 0;
    rp = ob_kv(rec, rp, "approach", "R2-10");
    rp = ob_kv(rec, rp, "task", taskname);
    rp = ob_kv(rec, rp, "fixture", base);
    rp = ob_kv(rec, rp, "judgment", vs[0..vl]);
    rp = ob_kint(rec, rp, "confidence", conf);
    rp = ob_kint(rec, rp, "margin", margin);
    rp = ob_kint(rec, rp, "ops", ops);
    rp = ob_kint(rec, rp, "mapping_ok", mapping_ok);
    rp = ob_kv(rec, rp, "disposition", disp);
    rp = ob_kv(rec, rp, "emit", edigest);
    rp = ob_kint(rec, rp, "feat0", feat0);
    rp = ob_kint(rec, rp, "feat1", feat1);
    let lhb:[]u8 = nio_alloc(32);
    if(lhb.len == 0) { return fail(taskname, "alloc"); }
    let lhin:[]u8 = nio_alloc(32 + 1024);
    if(lhin.len == 0) { return fail(taskname, "alloc"); }
    i = 0;
    while(i < 32) { lhin[i] = prevb[i]; i = i + 1; }
    i = 0;
    while(i < rp) { lhin[32 + i] = rec[i]; i = i + 1; }
    if(ns_sha256(lhin[0..32+rp], lhb) != 0) { return fail(taskname, "ledger-hash-fail"); }
    let lhhex:[]u8 = nio_alloc(64);
    if(lhhex.len == 0) { return fail(taskname, "alloc"); }
    hex_of(lhb, lhhex, 0);
    // stdout
    let ob:[]u8 = nio_alloc(4096);
    if(ob.len == 0) { return fail(taskname, "alloc"); }
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "R2-10");
    pos = ob_kv(ob, pos, "task", taskname);
    pos = ob_kv(ob, pos, "fixture", base);
    pos = ob_kv(ob, pos, "judgment", vs[0..vl]);
    pos = ob_kint(ob, pos, "confidence", conf);
    pos = ob_kint(ob, pos, "margin", margin);
    pos = ob_kint(ob, pos, "ops", ops);
    // percept span description
    let pdesc:[]u8 = nio_alloc(64);
    if(pdesc.len == 0) { return fail(taskname, "alloc"); }
    let pd:i32 = 0;
    let sk2:i64 = t_get64(px, 24);
    let sa2:i64 = t_get64(px, 32);
    let sb2:i64 = t_get64(px, 40);
    if(sk2 == 0) {
        pdesc[0]=97; pdesc[1]=117; pdesc[2]=100; pdesc[3]=105; pdesc[4]=111; pdesc[5]=58; pd=6;
        let s1:[]u8 = _zag_i64_to_str(sa2);
        let s2:[]u8 = _zag_i64_to_str(sb2);
        i = 0;
        while(i < s1.len) { pdesc[pd]=s1[i]; pd=pd+1; i=i+1; }
        pdesc[pd]=45; pd=pd+1;
        i = 0;
        while(i < s2.len) { pdesc[pd]=s2[i]; pd=pd+1; i=i+1; }
    } else {
        if(sk2 == 1) {
            pdesc[0]=118; pdesc[1]=105; pdesc[2]=115; pdesc[3]=117; pdesc[4]=97; pdesc[5]=108; pdesc[6]=58; pd=7;
            let s1:[]u8 = _zag_i64_to_str(sa2);
            let s2:[]u8 = _zag_i64_to_str(sb2);
            let s3:[]u8 = _zag_i64_to_str(t_get64(px, 48));
            let s4:[]u8 = _zag_i64_to_str(t_get64(px, 56));
            i = 0;
            while(i < s1.len) { pdesc[pd]=s1[i]; pd=pd+1; i=i+1; }
            pdesc[pd]=44; pd=pd+1;
            i = 0;
            while(i < s2.len) { pdesc[pd]=s2[i]; pd=pd+1; i=i+1; }
            pdesc[pd]=44; pd=pd+1;
            i = 0;
            while(i < s3.len) { pdesc[pd]=s3[i]; pd=pd+1; i=i+1; }
            pdesc[pd]=44; pd=pd+1;
            i = 0;
            while(i < s4.len) { pdesc[pd]=s4[i]; pd=pd+1; i=i+1; }
        } else {
            pdesc[0]=118; pdesc[1]=105; pdesc[2]=100; pdesc[3]=101; pdesc[4]=111; pdesc[5]=58;
            pdesc[6]=102; pdesc[7]=114; pdesc[8]=97; pdesc[9]=109; pdesc[10]=101; pdesc[11]=115;
            pdesc[12]=48; pdesc[13]=45; pdesc[14]=49; pd=15;
        }
    }
    pos = ob_kv(ob, pos, "percept", pdesc[0..pd]);
    pos = ob_kint(ob, pos, "mapping_ok", mapping_ok);
    pos = ob_kv(ob, pos, "disposition", disp);
    pos = ob_kv(ob, pos, "emit_digest", edigest);
    pos = ob_kv(ob, pos, "artifact_written", aw);
    pos = ob_kint(ob, pos, "feat0", feat0);
    pos = ob_kint(ob, pos, "feat1", feat1);
    pos = ob_kv(ob, pos, "ledger_hash", lhhex);
    nio_write_all(1, ob[0..pos]);
    return 0;
}

// ---------------- batch mode ----------------
// sense batch <task> <listfile> <mode> <artdir>
// Processes all fixtures in listfile (one path per line) in a single
// invocation. Output: TSV lines:
//   fixture  judgment  conf  margin  ops  mapping_ok  disposition
//   emit_digest  feat0  feat1  ledger_hash
// Ledger chains within the batch from the zero genesis.
fn mode_batch(task:i32, taskname:[]u8, listpath:[]u8, mode_emit:i64, artdir:[]u8) i32 {
    let lbuf:[]u8 = nio_alloc(1 << 20);
    if(lbuf.len == 0) { return 1; }
    let ln:i64 = z_read(listpath, lbuf, 1 << 20);
    if(ln <= 0) { return fail(taskname, "batch-list-read"); }
    let cap:i64 = 8388608;
    let buf:[]u8 = nio_alloc(cap as i32);
    if(buf.len == 0) { return 1; }
    let px:[]u8 = nio_alloc(80);
    if(px.len == 0) { return 1; }
    let op:[]u8 = nio_alloc(16);
    if(op.len == 0) { return 1; }
    let prevb:[]u8 = nio_alloc(32);
    if(prevb.len == 0) { return 1; }
    let i:i32 = 0;
    while(i < 32) { prevb[i] = 0; i = i + 1; }
    let ob:[]u8 = nio_alloc(1 << 20);
    if(ob.len == 0) { return 1; }
    let opos:i32 = 0;
    let pos:i64 = 0;
    while(pos < ln) {
        let eol:i64 = pos;
        while(eol < ln) { if(lbuf[eol as i32] == 10) { break; } eol = eol + 1; }
        if(eol > pos) {
            let fpath:[]u8 = lbuf[pos as i32 .. eol as i32];
            // base name
            let bs:i32 = 0;
            i = 0;
            while(i < fpath.len) { if(fpath[i] == 47) { bs = i + 1; } i = i + 1; }
            let base:[]u8 = fpath[bs..fpath.len];
            let n:i64 = z_read(fpath, buf, cap);
            if(n <= 0) {
                opos = ob_kv(ob, opos, "BATCH_ERROR", base);
            } else {
                i = 0;
                while(i < 80) { px[i] = 0; i = i + 1; }
                i = 0;
                while(i < 16) { op[i] = 0; i = i + 1; }
                let rc:i32 = -1;
                if(task == 0) { rc = task_colordisc(buf, n as i32, op, px); }
                if(task == 1) { rc = task_colorconst(buf, n as i32, op, px); }
                if(task == 2) { rc = task_shapetrans(buf, n as i32, op, px); }
                if(task == 3) { rc = task_pitchdisc(buf, n as i32, op, px); }
                if(task == 4) { rc = task_timbredisc(buf, n as i32, op, px); }
                if(task == 5) { rc = task_motiondir(buf, n as i32, op, px); }
                if(rc != 0) {
                    opos = ob_kv(ob, opos, "BATCH_ERROR", base);
                } else {
                    let jc:i64 = t_get64(px, 0);
                    let conf:i64 = t_get64(px, 8);
                    let margin:i64 = t_get64(px, 16);
                    let ops:i64 = t_get64(op, 0);
                    let feat0:i64 = t_get64(px, 64);
                    let feat1:i64 = t_get64(px, 72);
                    let edigest:[]u8 = nio_alloc(64);
                    let aw:[]u8 = nio_alloc(1);
                    let mapping_ok:i64 = 0;
                    if(edigest.len != 0) {
                        if(aw.len != 0) {
                            mapping_ok = do_emission(task, buf, n as i32, px, mode_emit, artdir, base, edigest, aw);
                        }
                    }
                    let disp:[]u8 = "WITHHOLD";
                    if(mapping_ok == 1) { if(conf >= 700) { disp = "INSTALL"; } }
                    let vs:[]u8 = nio_alloc(16);
                    let vl:i32 = 0;
                    if(vs.len != 0) { vl = verdict_str(task, jc, vs); }
                    // ledger
                    let rec:[]u8 = nio_alloc(1024);
                    let rp:i32 = 0;
                    if(rec.len != 0) {
                        rp = ob_kv(rec, rp, "fixture", base);
                        rp = ob_kv(rec, rp, "judgment", vs[0..vl]);
                        rp = ob_kint(rec, rp, "confidence", conf);
                        rp = ob_kv(rec, rp, "disposition", disp);
                        rp = ob_kv(rec, rp, "emit", edigest);
                    }
                    let lhb:[]u8 = nio_alloc(32);
                    let lhin:[]u8 = nio_alloc(32 + 1024);
                    if(lhb.len != 0) {
                        if(lhin.len != 0) {
                            i = 0;
                            while(i < 32) { lhin[i] = prevb[i]; i = i + 1; }
                            i = 0;
                            while(i < rp) { lhin[32+i] = rec[i]; i = i + 1; }
                            if(ns_sha256(lhin[0..32+rp], lhb) == 0) {
                                i = 0;
                                while(i < 32) { prevb[i] = lhb[i]; i = i + 1; }
                            }
                        }
                    }
                    let lhhex:[]u8 = nio_alloc(64);
                    if(lhhex.len != 0) { hex_of(lhb, lhhex, 0); }
                    // TSV line
                    i = 0;
                    while(i < base.len) { ob[opos]=base[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    i = 0;
                    while(i < vl) { ob[opos]=vs[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    let s1:[]u8 = _zag_i64_to_str(conf);
                    i = 0;
                    while(i < s1.len) { ob[opos]=s1[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    let s2:[]u8 = _zag_i64_to_str(margin);
                    i = 0;
                    while(i < s2.len) { ob[opos]=s2[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    let s3:[]u8 = _zag_i64_to_str(ops);
                    i = 0;
                    while(i < s3.len) { ob[opos]=s3[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    let s4:[]u8 = _zag_i64_to_str(mapping_ok);
                    i = 0;
                    while(i < s4.len) { ob[opos]=s4[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    i = 0;
                    while(i < disp.len) { ob[opos]=disp[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    i = 0;
                    while(i < 64) { ob[opos]=edigest[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    let s5:[]u8 = _zag_i64_to_str(feat0);
                    i = 0;
                    while(i < s5.len) { ob[opos]=s5[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    let s6:[]u8 = _zag_i64_to_str(feat1);
                    i = 0;
                    while(i < s6.len) { ob[opos]=s6[i]; opos=opos+1; i=i+1; }
                    ob[opos]=9; opos=opos+1;
                    i = 0;
                    while(i < 64) { ob[opos]=lhhex[i]; opos=opos+1; i=i+1; }
                    ob[opos]=10; opos=opos+1;
                }
            }
        }
        pos = eol + 1;
        // flush if getting full
        if(opos > (1 << 20) - 4096) {
            nio_write_all(1, ob[0..opos]);
            opos = 0;
        }
    }
    nio_write_all(1, ob[0..opos]);
    return 0;
}

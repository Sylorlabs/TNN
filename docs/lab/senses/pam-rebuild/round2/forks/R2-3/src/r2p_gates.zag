// r2p_gates.zag — candidate-gate scoring interface for R2-3.
//
// A candidate gate is identified by an integer id and implements:
//   gate_name(id)          -> []u8  (human-readable; for reports)
//   gate_formation_src(id) -> i32   (0 = F blob/formation span, 1 = G blob/gate span)
//   gate_gate_src(id)      -> i32   (0 = F blob, 1 = G blob)
//   gate_judge(id, task, evidence) -> i32  (judgment code)
//
// The instrument feeds the gate the evidence bytes it DECLARED (formation_src
// for the formation judgment, gate_src for the gate judgment), then withholds
// iff the two judgments disagree. The overlap audit is mechanical:
// gate_src == formation_src -> the gate's evidence overlaps formation.
//
// Frozen ids: 0 = reference gate, 1 = broken positive control.
// Future round-2 candidates (R2-1, R2-2, R2-4, ...) register new ids here.

@import("r2p_front.zag")

fn gate_name(id:i32) []u8 {
    if(id == 0) { return "reference"; }
    if(id == 1) { return "broken-positive-control"; }
    return "";
}

fn gate_formation_src(id:i32) i32 {
    if(id == 0) { return 0; }
    if(id == 1) { return 0; }
    return -1;
}

fn gate_gate_src(id:i32) i32 {
    // Reference: gate evidence is the G blob (disjoint gate span).
    // Broken: DELIBERATELY reuses the F blob (formation span) as gate evidence.
    if(id == 0) { return 1; }
    if(id == 1) { return 0; }
    return -1;
}

fn gate_judge(id:i32, task:i32, evidence:[]u8) i32 {
    // Both shipped gates judge with the naive front-end. A future candidate
    // plugs its own percept judgment here; the interface is unchanged.
    if(id == 0) { return front_judge(task, evidence); }
    if(id == 1) { return front_judge(task, evidence); }
    return -1;
}

fn gate_valid(id:i32) i32 {
    if(id == 0) { return 1; }
    if(id == 1) { return 1; }
    return 0;
}

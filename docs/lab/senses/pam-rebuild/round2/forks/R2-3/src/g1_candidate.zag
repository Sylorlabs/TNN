// g1_candidate.zag — self-PAM gate as R2-3 candidate gate id 2.
//
// Drop-in companion to round2/forks/R2-3/src/r2p_gates.zag: implements the
// four registration functions plus gate_valid for id 2 ("selfpam-fact-gate").
// See G1_REGISTRATION.md for the two-line sense.zag patch (extend the
// hard-coded gate_id range) that activates it in the instrument.
//
// Formation span (declared src 0 = F blob): the draft-production context.
// Gate span (declared src 1 = G blob): independent re-measurement of the
// claim's subject (TECH_BRIEF §5 item 4).
//
// FIX1 (2026-09-27, selfpam push-to-100% round 3): the candidate's judgment
// on a span is now ORDER-SENSITIVE. The R2-3 registration runs showed the
// span_sum measurement is order-blind: 100 of the 101 admitted pairs were
// exact byte-permutations (frame-reversed vs forward motiondir video) whose
// plain sums collide exactly. The new primary measurement is the
// position-weighted sum span_seq (same sum-measurement family, tolerance
// semantics kept: small benign byte differences -> small measurement
// differences -> admit within the /8 quantization), which provably separates
// permutations: swapping bytes at positions i,j changes the sum by
// (i-j)*(y-x), nonzero unless the swapped bytes are identical.
//
// GOVERNANCE: the §8 draft defines meas=SPAN-SUM with tolerance 8 and is
// UNSIGNED (awaiting Micah). span_seq is a PROPOSED revised §8 value under
// test in the experimental candidate path only — this file changes no
// frozen codec (codec.zag's span_sum is untouched) and enacts nothing.
//
// Selectable variants (all measurable on one instrument build):
//   id 2 "selfpam-fact-gate": PRIMARY — span_seq(evidence)/8
//   id 3 "selfpam-sum-gate":  LEGACY — span_sum(evidence)/8 (pre-fix1 id-2 law)
//   id 4 "selfpam-fnv-gate":  COMPARISON — FNV-1a 32-bit digest, exact
//                             comparison (tolerance 0): withhold iff digests
//                             differ.
// The instrument withholds iff the formation judgment and the gate judgment
// disagree (jf != jg).
//
// The function is stateless and deterministic (zero RNG): the same span
// bytes always yield the same judgment, so the instrument's x3
// byte-identical runs hold by construction. Whether the candidate clears
// the 90% withhold bar is CELL-A's measurement, not claimed here.

@import("codec.zag")

// span_seq — EXPERIMENTAL (fix1) order-sensitive measurement, candidate path
// only. Weighted sum Σ (i+1)*b_i mod 2^31 over the evidence bytes.
// i64 accumulator: max ~5.6e14 for 2MB spans, no overflow. Non-negative, so
// the mod and the /8 quantization in sp_gate_judge are exact.
fn span_seq(ev:[]u8) i32 {
    let s:i64 = 0;
    let i:i32 = 0;
    while(i < ev.len) {
        let w:i64 = i as i64;
        w = w + 1;
        s = s + w * (ev[i] as i64);
        i = i + 1;
    }
    return (s % 2147483648) as i32;
}

// span_fnv — EXPERIMENTAL (fix1) comparison measurement, candidate path
// only. FNV-1a 32-bit digest of the evidence bytes (same per-step masking
// as codec.zag's fact_jcode). Used with tolerance 0: any byte difference
// (including pure reorderings) yields a different digest with overwhelming
// probability.
fn span_fnv(ev:[]u8) i32 {
    let h:i64 = 2166136261;
    let i:i32 = 0;
    while(i < ev.len) {
        h = h ^ (ev[i] as i64);
        h = h & 4294967295;
        h = h * 16777619;
        h = h & 4294967295;
        i = i + 1;
    }
    return h as i32;
}

fn sp_gate_name(id:i32) []u8 {
    if(id == 2) { return "selfpam-fact-gate"; }
    if(id == 3) { return "selfpam-sum-gate"; }
    if(id == 4) { return "selfpam-fnv-gate"; }
    return "";
}
fn sp_gate_formation_src(id:i32) i32 {
    if(id == 2) { return 0; }
    if(id == 3) { return 0; }
    if(id == 4) { return 0; }
    return -1;
}
fn sp_gate_gate_src(id:i32) i32 {
    if(id == 2) { return 1; }
    if(id == 3) { return 1; }
    if(id == 4) { return 1; }
    return -1;
}
fn sp_gate_judge(id:i32, task:i32, evidence:[]u8) i32 {
    // The task parameter is deliberately unused: the measurement is a pure
    // function of the evidence bytes (no task/index/content branching), so
    // the fix is a measurement change, not corpus-fitted.
    if(id == 2) { return span_seq(evidence) / 8; }
    if(id == 3) { return span_sum(evidence) / 8; }
    if(id == 4) { return span_fnv(evidence); }
    return -1;
}
fn sp_gate_valid(id:i32) i32 {
    if(id == 2) { return 1; }
    if(id == 3) { return 1; }
    if(id == 4) { return 1; }
    return 0;
}

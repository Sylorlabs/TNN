// f2t_form.zag — FS-F2T: independent formation-accuracy measurement.
//
// Lineage: byte-faithful copy of FS-E2's fs2_form.zag EXCEPT the timbredisc
// path, which is replaced by the PREREG_FS-F2T §3 mechanism:
//   exact-bin Q20 Goertzel at 440*h Hz (h=1..3, bins k=880h, N=32000,
//   SR=16000) + nearest frozen-theory-template rule on (p2/p1, p3/p1).
// This fixes FS-E2 Phase-0's diagnosed defects: 2x sample-rate/bin error,
// ÷1024 coefficient quantization, i64 overflow in the power expression and
// in ps=raw*1048576/pmax, and the wrong spectral-centroid representation.
// All five other formation functions, the batch driver, header parsing,
// and judgment vocabulary are unchanged from FS-E2.
//
// Pure Zag, integer math only. Deterministic given fixture bytes.
// Prereg: PREREG_FS-F2T.md (frozen; committed before any fresh evaluation).
@import("R33_NATIVE_IO_V1.zag")

fn f_abs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn f_min(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
// integer sqrt (Newton), x >= 0
fn f_isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    let r:i64 = x;
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn f_u32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn f_i16(b:[]u8, at:i32) i64 {
    let v:i64 = (b[at] as i64) | ((b[at+1] as i64) << 8);
    if(v >= 32768) { return v - 65536; }
    return v;
}
// NUL-terminate a path slice for open(2)
fn f_cstr(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc(s.len + 1);
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
// read whole file into buf (cap bytes); returns bytes read or negative
fn f_readall(path:[]u8, buf:[]u8, cap:i32) i64 {
    let s:[]u8 = f_cstr(path);
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -1; }
    let total:i64 = 0;
    while(total < (cap as i64)) {
        let n:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total,
                                     (cap as i64) - total, 0, 0, 0);
        if(n <= 0) { break; }
        total = total + n;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}
fn f_out(s:[]u8) void {
    _zag_raw_syscall(1, 1, _zag_slice_ptr(s) as i64, s.len as i64, 0, 0, 0);
}

// ---------------- formation functions ----------------
// Each returns the formation judgment id. Definitions frozen per PREREG_FS-E1.

// t0 colordisc: mean-RGB distance of two 32x32 patches, DIFFERENT iff >= 18.
fn f_colordisc(img:[]u8, fo:i32) i32 {
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let tr:i64 = 0; let tg:i64 = 0; let tb:i64 = 0;
    let i:i32 = 0;
    while(i < 3072) {
        sr = sr + (img[fo + i] as i64);
        sg = sg + (img[fo + i + 1] as i64);
        sb = sb + (img[fo + i + 2] as i64);
        tr = tr + (img[fo + 3072 + i] as i64);
        tg = tg + (img[fo + 3072 + i + 1] as i64);
        tb = tb + (img[fo + 3072 + i + 2] as i64);
        i = i + 3;
    }
    let dr:i64 = sr / 1024 - tr / 1024;
    let dg:i64 = sg / 1024 - tg / 1024;
    let db:i64 = sb / 1024 - tb / 1024;
    let d:i64 = f_isqrt(dr * dr + dg * dg + db * db);
    if(d >= 18) { return 1; }
    return 0;
}

// t1 colorconst: warm mean-chromaticity L1 x1000, DIFFERENT iff >= 80.
fn f_colorconst(img:[]u8, fo:i32) i32 {
    let ar:i64 = 0; let ag:i64 = 0; let ab:i64 = 0;
    let br:i64 = 0; let bg:i64 = 0; let bb:i64 = 0;
    let i:i32 = 0;
    while(i < 6912) {
        ar = ar + (img[fo + i] as i64);
        ag = ag + (img[fo + i + 1] as i64);
        ab = ab + (img[fo + i + 2] as i64);
        br = br + (img[fo + 6912 + i] as i64);
        bg = bg + (img[fo + 6912 + i + 1] as i64);
        bb = bb + (img[fo + 6912 + i + 2] as i64);
        i = i + 3;
    }
    let ta:i64 = ar + ag + ab;
    let tc:i64 = br + bg + bb;
    if(ta < 1) { ta = 1; }
    if(tc < 1) { tc = 1; }
    let d:i64 = f_abs(ar * 1000 / ta - br * 1000 / tc)
              + f_abs(ag * 1000 / ta - bg * 1000 / tc)
              + f_abs(ab * 1000 / ta - bb * 1000 / tc);
    if(d >= 80) { return 1; }
    return 0;
}

// t2 shapetrans: 96x96 bbox fill-ratio -> class.
fn f_shapetrans(img:[]u8, fo:i32) i32 {
    let cnt:i64 = 0;
    let x0:i32 = 96; let x1:i32 = -1;
    let y0:i32 = 96; let y1:i32 = -1;
    let y:i32 = 0;
    while(y < 96) {
        let x:i32 = 0;
        while(x < 96) {
            let v:i32 = img[fo + y * 96 + x] as i32;
            if(v > 180) {
                cnt = cnt + 1;
                if(x < x0) { x0 = x; }
                if(x > x1) { x1 = x; }
                if(y < y0) { y0 = y; }
                if(y > y1) { y1 = y; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    // default: SQUARE(2); below-count also SQUARE
    if(cnt >= 200) {
        let bw:i64 = (x1 - x0 + 1) as i64;
        let bh:i64 = (y1 - y0 + 1) as i64;
        let ba:i64 = bw * bh;
        if(ba >= 1) {
            let fill:i64 = cnt * 1000 / ba;
            if(fill >= 700) { return 0; }   // CIRCLE
            if(fill >= 550) { return 2; }   // SQUARE
            return 1;                        // TRIANGLE
        }
    }
    return 2;
}

// t3 pitchdisc: zero-crossing counts -> endpoint ratio in 0.01%.
// toneA samples [0,14400), toneB samples [16000,30400).
fn f_pitchdisc(pcm:[]u8, fo:i32) i32 {
    let na:i64 = 0;
    let nb:i64 = 0;
    let i:i32 = 1;
    let prev:i64 = f_i16(pcm, fo);
    while(i < 14400) {
        let cur:i64 = f_i16(pcm, fo + i * 2);
        if(prev <= 0) { if(cur > 0) { na = na + 1; } }
        if(prev > 0) { if(cur <= 0) { na = na + 1; } }
        prev = cur;
        i = i + 1;
    }
    i = 16001;
    prev = f_i16(pcm, fo + 32000);
    while(i < 30400) {
        let cur:i64 = f_i16(pcm, fo + i * 2);
        if(prev <= 0) { if(cur > 0) { nb = nb + 1; } }
        if(prev > 0) { if(cur <= 0) { nb = nb + 1; } }
        prev = cur;
        i = i + 1;
    }
    let r:i64 = 0;
    if(na >= 10) { r = (nb - na) * 10000 / na; }
    if(r > 50) { return 1; }    // HIGHER
    if(r < -50) { return 2; }   // LOWER
    return 0;                    // SAME
}

// t4 timbredisc (FS-F2T rebuild, PREREG_FS-F2T §3):
// Q20 Goertzel at the EXACT bins k=880h for 440*h Hz (h=1..3), N=32000,
// input downscaled by 32, overflow-safe power, then nearest frozen
// theory-template on (p2/p1, p3/p1) per-mille ratios.
fn f_tbcoeff2(h:i32) i64 {
    if(h == 1) { return 2065924; }
    if(h == 2) { return 1973170; }
    return 1821652;
}
fn f_tbharm(pcm:[]u8, bo:i32, h:i32) i64 {
    let c:i64 = f_tbcoeff2(h);
    let s1:i64 = 0;
    let s2:i64 = 0;
    let i:i32 = 0;
    while(i < 32000) {
        let x:i64 = f_i16(pcm, bo + i * 2) / 32;
        let s0:i64 = x + c * s1 / 1048576 - s2;
        s2 = s1;
        s1 = s0;
        i = i + 1;
    }
    let p:i64 = s1 * s1 + s2 * s2 - s1 * s2 / 1048576 * c;
    if(p < 0) { p = 0; }
    return p;
}
fn f_timbredisc(pcm:[]u8, fo:i32) i32 {
    let p1:i64 = f_tbharm(pcm, fo, 1);
    let p2:i64 = f_tbharm(pcm, fo, 2);
    let p3:i64 = f_tbharm(pcm, fo, 3);
    if(p1 < 1) { p1 = 1; }
    let r2:i64 = p2 * 1000 / p1;
    let r3:i64 = p3 * 1000 / p1;
    // clamp for totality of the distance square (unreachable per §4)
    if(r2 > 1000000) { r2 = 1000000; }
    if(r3 > 1000000) { r3 = 1000000; }
    // nearest template; ties -> first in PURE, BRIGHT, DARK, RICH order.
    // template ids: 0 PURE (0,0), 1 BRIGHT (1960,2560),
    //               2 DARK (78,6), 3 RICH (640,384).
    let best:i32 = 0;
    let bd:i64 = -1;
    let k:i32 = 0;
    while(k < 4) {
        let t2:i64 = 0;
        let t3:i64 = 0;
        if(k == 1) { t2 = 1960; t3 = 2560; }
        if(k == 2) { t2 = 78; t3 = 6; }
        if(k == 3) { t2 = 640; t3 = 384; }
        let dr2:i64 = r2 - t2;
        let dr3:i64 = r3 - t3;
        let dd:i64 = dr2 * dr2 + dr3 * dr3;
        if(bd < 0) { bd = dd; best = k; }
        if(dd < bd) { bd = dd; best = k; }
        k = k + 1;
    }
    return best;
}

// t5 motiondir: block-match votes, 23 time points, plurality.
fn f_motdir(dx:i32, dy:i32) i32 {
    if(dx == 0) { if(dy == 0) { return 0; } }
    let ax:i32 = dx;
    if(ax < 0) { ax = 0 - ax; }
    let ay:i32 = dy;
    if(ay < 0) { ay = 0 - ay; }
    if(ax >= 2 * ay) {
        if(dx > 0) { return 3; }
        return 7;
    }
    if(ay >= 2 * ax) {
        if(dy > 0) { return 5; }
        return 1;
    }
    if(dx > 0) {
        if(dy < 0) { return 2; }
        return 4;
    }
    if(dy < 0) { return 8; }
    return 6;
}
fn f_motiondir(vid:[]u8, bo:i32) i32 {
    let votes:[]u8 = nio_alloc(36);
    let i:i32 = 0;
    while(i < 36) { votes[i] = 0; i = i + 1; }
    let t:i32 = 0;
    while(t <= 44) {
        let bdx:i32 = 0;
        let bdy:i32 = 0;
        let bsad:i64 = 9223372036854775807;
        let dy:i32 = -4;
        while(dy <= 4) {
            let dx:i32 = -4;
            while(dx <= 4) {
                let sad:i64 = 0;
                let y:i32 = 8;
                while(y < 24) {
                    let x:i32 = 8;
                    while(x < 24) {
                        let a:i32 = vid[bo + t * 1024 + y * 32 + x] as i32;
                        let bb:i32 = vid[bo + (t + 2) * 1024
                                          + (y + dy) * 32 + (x + dx)] as i32;
                        let dd:i32 = a - bb;
                        if(dd < 0) { dd = 0 - dd; }
                        sad = sad + (dd as i64);
                        x = x + 1;
                    }
                    y = y + 1;
                }
                if(sad < bsad) {
                    bsad = sad;
                    bdx = dx;
                    bdy = dy;
                }
                dx = dx + 1;
            }
            dy = dy + 1;
        }
        // generator moves the WINDOW; negate to recover window direction
        let j:i32 = f_motdir(0 - bdx, 0 - bdy);
        let cur:i64 = f_u32(votes, j * 4);
        let v:i64 = cur + 1;
        votes[j * 4] = (v & 255) as u8;
        votes[j * 4 + 1] = ((v >> 8) & 255) as u8;
        votes[j * 4 + 2] = ((v >> 16) & 255) as u8;
        votes[j * 4 + 3] = ((v >> 24) & 255) as u8;
        t = t + 2;
    }
    let best:i32 = 0;
    let bestv:i64 = -1;
    let k:i32 = 0;
    while(k < 9) {
        let v:i64 = f_u32(votes, k * 4);
        if(v > bestv) {
            bestv = v;
            best = k;
        }
        k = k + 1;
    }
    nio_free(votes);
    return best;
}

// ---------------- judgment names (must match truth vocabulary) ----------------
fn f_tname(t:i32) []u8 {
    if(t == 0) { return "colordisc"; }
    if(t == 1) { return "colorconst"; }
    if(t == 2) { return "shapetrans"; }
    if(t == 3) { return "pitchdisc"; }
    if(t == 4) { return "timbredisc"; }
    return "motiondir";
}
fn f_jname(t:i32, j:i32) []u8 {
    if(t == 0) {
        if(j == 0) { return "SAME"; }
        return "DIFFERENT";
    }
    if(t == 1) {
        if(j == 0) { return "SAME_SURFACE"; }
        return "DIFFERENT";
    }
    if(t == 2) {
        if(j == 0) { return "CIRCLE"; }
        if(j == 1) { return "TRIANGLE"; }
        return "SQUARE";
    }
    if(t == 3) {
        if(j == 0) { return "SAME"; }
        if(j == 1) { return "HIGHER"; }
        return "LOWER";
    }
    if(t == 4) {
        if(j == 0) { return "PURE"; }
        if(j == 1) { return "BRIGHT"; }
        if(j == 2) { return "DARK"; }
        return "RICH";
    }
    if(j == 0) { return "STILL"; }
    if(j == 1) { return "N"; }
    if(j == 2) { return "NE"; }
    if(j == 3) { return "E"; }
    if(j == 4) { return "SE"; }
    if(j == 5) { return "S"; }
    if(j == 6) { return "SW"; }
    if(j == 7) { return "W"; }
    return "NW";
}

// ---------------- batch driver ----------------
// batch <listfile>: one line per fixture path ->
//   "<path>\ttask=<name>\tjudgment=<JNAME>\n"
fn f_run_one(buf:[]u8, cap:i32, path:[]u8, out:[]u8) i32 {
    let n:i64 = f_readall(path, buf, cap);
    if(n < 32) { return -1; }
    if(f_u32(buf, 0) != 0x52324658) { return -2; }
    let task:i32 = f_u32(buf, 4) as i32;
    let fo:i32 = f_u32(buf, 16) as i32;
    let fl:i64 = f_u32(buf, 20);
    if(task < 0) { task = 0; }
    if(task > 5) { task = 5; }
    if((fo as i64) + fl > n) { return -3; }
    let j:i32 = 0;
    if(task == 0) { j = f_colordisc(buf, fo); }
    if(task == 1) { j = f_colorconst(buf, fo); }
    if(task == 2) { j = f_shapetrans(buf, fo); }
    if(task == 3) { j = f_pitchdisc(buf, fo); }
    if(task == 4) { j = f_timbredisc(buf, fo); }
    if(task == 5) { j = f_motiondir(buf, fo); }
    // emit: <path>\ttask=<name>\tjudgment=<JNAME>\n
    let pos:i32 = 0;
    let i:i32 = 0;
    while(i < path.len) {
        if(pos < out.len) { out[pos] = path[i]; pos = pos + 1; }
        i = i + 1;
    }
    let s1:[]u8 = "\ttask=";
    i = 0;
    while(i < s1.len) {
        if(pos < out.len) { out[pos] = s1[i]; pos = pos + 1; }
        i = i + 1;
    }
    let tn:[]u8 = f_tname(task);
    i = 0;
    while(i < tn.len) {
        if(pos < out.len) { out[pos] = tn[i]; pos = pos + 1; }
        i = i + 1;
    }
    let s2:[]u8 = "\tjudgment=";
    i = 0;
    while(i < s2.len) {
        if(pos < out.len) { out[pos] = s2[i]; pos = pos + 1; }
        i = i + 1;
    }
    let jn:[]u8 = f_jname(task, j);
    i = 0;
    while(i < jn.len) {
        if(pos < out.len) { out[pos] = jn[i]; pos = pos + 1; }
        i = i + 1;
    }
    if(pos < out.len) { out[pos] = 10; pos = pos + 1; }
    _zag_raw_syscall(1, 1, _zag_slice_ptr(out) as i64, pos as i64, 0, 0, 0);
    return 0;
}
fn f_batch(listpath:[]u8) void {
    let cap:i32 = 8388608;
    let buf:[]u8 = nio_alloc(cap);
    let lcap:i32 = 2097152;
    let lb:[]u8 = nio_alloc(lcap);
    let out:[]u8 = nio_alloc(4096);
    let n:i64 = f_readall(listpath, lb, lcap);
    if(n <= 0) {
        f_out("error=cannot read list\n");
        nio_free(buf); nio_free(lb); nio_free(out);
        return;
    }
    let start:i32 = 0;
    let i:i32 = 0;
    while(i <= (n as i32)) {
        let eol:i32 = 0;
        if(i == (n as i32)) { eol = 1; }
        if(eol == 0) { if(lb[i] == 10) { eol = 1; } }
        if(eol == 1) {
            let len:i32 = i - start;
            // strip trailing CR
            if(len > 0) { if(lb[start + len - 1] == 13) { len = len - 1; } }
            if(len > 0) {
                let plen:i32 = len;
                if(plen > 2047) { plen = 2047; }
                let p:[]u8 = nio_alloc(plen);
                let k:i32 = 0;
                while(k < plen) { p[k] = lb[start + k]; k = k + 1; }
                let rc:i32 = f_run_one(buf, cap, p, out);
                nio_free(p);
                if(rc != 0) {
                    f_out("error=fixture failed rc=");
                    let rs:[]u8 = _zag_i64_to_str(rc as i64);
                    f_out(rs);
                    nio_free(rs);
                    f_out("\n");
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    nio_free(buf); nio_free(lb); nio_free(out);
    return;
}

fn main() void {
    let mode:[]u8 = _zag_arg(1);
    if(_zag_strcmp(mode, "batch") == 1) {
        f_batch(_zag_arg(2));
        return;
    }
    // single-fixture mode: arg1 is the fixture path
    let path:[]u8 = mode;
    if(path.len == 0) {
        f_out("error=missing fixture path\n");
        return;
    }
    // 8MB arena (largest r2n fixture ~103KB; headroom for r2a)
    let cap:i32 = 8388608;
    let buf:[]u8 = nio_alloc(cap);
    let n:i64 = f_readall(path, buf, cap);
    if(n < 32) {
        f_out("error=short read\n");
        nio_free(buf);
        return;
    }
    if(f_u32(buf, 0) != 0x52324658) {
        f_out("error=bad magic\n");
        nio_free(buf);
        return;
    }
    let task:i32 = f_u32(buf, 4) as i32;
    let fo:i32 = f_u32(buf, 16) as i32;
    let fl:i64 = f_u32(buf, 20);
    if(task < 0) { task = 0; }
    if(task > 5) { task = 5; }
    if((fo as i64) + fl > n) {
        f_out("error=f-span out of range\n");
        nio_free(buf);
        return;
    }
    let j:i32 = 0;
    if(task == 0) { j = f_colordisc(buf, fo); }
    if(task == 1) { j = f_colorconst(buf, fo); }
    if(task == 2) { j = f_shapetrans(buf, fo); }
    if(task == 3) { j = f_pitchdisc(buf, fo); }
    if(task == 4) { j = f_timbredisc(buf, fo); }
    if(task == 5) { j = f_motiondir(buf, fo); }
    nio_free(buf);
    f_out("task=");
    f_out(f_tname(task));
    f_out(" judgment=");
    f_out(f_jname(task, j));
    f_out("\n");
    return;
}

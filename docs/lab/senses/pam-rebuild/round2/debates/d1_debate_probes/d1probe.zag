@import("R33_NATIVE_IO_V1.zag")

// d1probe.zag — D-1 debate cheap probes for the H-PAM-7/8/10 intervention family.
// Pure Zag, zero RNG, deterministic. See PROBE_PREREG.md (committed before code)
// for the frozen mechanism definitions and committed predictions.
// argv[1]: fixtures_ledger.txt (committed F5 fixture set).
//
// stdout: D1PROBE / P1 / P2 / P3 lines (no timestamps; 3x byte-identical runs).
//
// znc landmine notes: no `as []i32` casts (parallel []u8 arenas with explicit
// little-endian put/get32); no slice ==; no .* on non-pointers; no bare blocks;
// no struct returns; shallow nesting only; no identifier named try.

fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let total:i64 = 0;
    let done:i32 = 0;
    while(done == 0) {
        let rem:i64 = (max as i64) - total;
        if(rem <= 0) { done = 1; }
        if(done == 0) {
            let p:i64 = (_zag_slice_ptr(out) as i64) + total;
            let n:i64 = _zag_raw_syscall(0, fd, p, rem, 0, 0, 0);
            if(n <= 0) { done = 1; }
            if(done == 0) { total = total + n; }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn p_atoi(b:[]u8, st:i32, en:i32) i64 {
    let v:i64 = 0;
    let i:i32 = st;
    while(i < en) {
        let c:i32 = b[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}

// copy field k (0-based, '|' separated) from b[st..en] into tmp; return length, -1 if absent.
fn getf(b:[]u8, st:i32, en:i32, k:i32, tmp:[]u8) i32 {
    let f:i32 = 0;
    let fs:i32 = st;
    let fe:i32 = -1;
    let i:i32 = st;
    while(i < en) {
        if((b[i] as i32) == 124) {
            if(f == k) { fe = i; }
            if(fe < 0) { f = f + 1; fs = i + 1; }
        }
        if(fe >= 0) { i = en; }
        if(fe < 0) { i = i + 1; }
    }
    if(fe < 0 && f == k) { fe = en; }
    if(fe < 0) { return -1; }
    let n:i32 = fe - fs;
    let j:i32 = 0;
    while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
    return n;
}

fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}

fn t_put32(a:[]u8, i:i32, v:i64) void {
    a[i*4] = (v & 255) as u8;
    a[i*4+1] = ((v >> 8) & 255) as u8;
    a[i*4+2] = ((v >> 16) & 255) as u8;
    a[i*4+3] = ((v >> 24) & 255) as u8;
}

fn t_get32(a:[]u8, i:i32) i64 {
    let b0:i64 = a[i*4] as i64;
    let b1:i64 = a[i*4+1] as i64;
    let b2:i64 = a[i*4+2] as i64;
    let b3:i64 = a[i*4+3] as i64;
    return b0 + b1*256 + b2*65536 + b3*16777216;
}

fn ilog2(x:i64) i64 {
    let e:i64 = 0;
    let t:i64 = x;
    while(t >= 2) { t = t / 2; e = e + 1; }
    return e;
}

fn ap_str(b:[]u8, p:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { b[p+i] = s[i]; i = i + 1; }
    return p + s.len;
}

fn ap_i64(b:[]u8, p:i32, v:i64) i32 {
    let q:i32 = p;
    let x:i64 = v;
    if(x < 0) { b[q] = 45; q = q + 1; x = 0 - x; }
    if(x == 0) { b[q] = 48; return q + 1; }
    let d:i64 = 1;
    while(d <= x / 10) { d = d * 10; }
    while(d >= 1) {
        let dig:i64 = x / d;
        b[q] = (48 + dig) as u8;
        q = q + 1;
        x = x - dig * d;
        d = d / 10;
    }
    return q;
}

// --- frozen lawful model (PROBE_PREREG.md) ---
// GAIN g=12 (x1.2): meas' = meas*12/10, conf' = conf.
// CROP_SHIFT k=8: meas' = meas, conf' = conf - 24 (edge loss).
fn lawful_meas_gain(m:i64) i64 { return m * 12 / 10; }
fn lawful_conf_crop(c:i64) i64 { return c - 24; }

// perturbation-response warrant: 1=INSTALL (agree), 0=WITHHOLD.
fn warrant(c:i64, m:i64, om_gain:i64, oc_gain:i64, om_crop:i64, oc_crop:i64, tau:i64) i32 {
    if(iabs(om_gain - lawful_meas_gain(m)) > tau) { return 0; }
    if(iabs(oc_gain - c) > tau) { return 0; }
    if(iabs(om_crop - m) > tau) { return 0; }
    if(iabs(oc_crop - lawful_conf_crop(c)) > tau) { return 0; }
    return 1;
}

// path-B feature reprojection (F8c audit: asserted "independent path").
fn reproj_c(c:i64, m:i64) i64 { return (c * 3 + m) % 9973; }
fn reproj_m(c:i64, m:i64) i64 { return (m * 5 + c) % 65521; }

fn main() void {
    let led_path:[]u8 = _zag_arg(1);
    let lb:[]u8 = nio_alloc(200000);
    let n:i64 = z_read(led_path, lb, 200000);
    let nn:i32 = n as i32;
    let confA:[]u8 = nio_alloc(360*4);
    let measA:[]u8 = nio_alloc(360*4);
    let tmp:[]u8 = nio_alloc(256);
    let nf:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= nn) {
        let eol:i32 = 0;
        if(i == nn) { eol = 1; }
        if(eol == 0) {
            if((lb[i] as i32) == 10) { eol = 1; }
        }
        if(eol == 1) {
            if(i > st && nf < 360) {
                let cl:i32 = getf(lb, st, i, 8, tmp);
                let ml:i32 = getf(lb, st, i, 10, tmp);
                if(cl > 0 && ml > 0) {
                    t_put32(confA, nf, p_atoi(tmp, 0, cl));
                    t_put32(measA, nf, p_atoi(tmp, 0, ml));
                    nf = nf + 1;
                }
            }
            st = i + 1;
        }
        i = i + 1;
    }

    // ---- PROBE 1: perturbation-response warrant ----
    let tau:i64 = 2;
    let h_install:i32 = 0;
    let hc_n:i32 = 0;
    let hc_withhold:i32 = 0;
    let f:i32 = 0;
    while(f < nf) {
        let c:i64 = t_get32(confA, f);
        let m:i64 = t_get32(measA, f);
        let complex:i32 = 0;
        if(m >= 6000) { complex = 1; }
        let omg:i64 = lawful_meas_gain(m);
        let ocg:i64 = c;
        let omc:i64 = m;
        let occ:i64 = lawful_conf_crop(c);
        if(complex == 1) {
            omg = omg + 997;
            hc_n = hc_n + 1;
        }
        let d:i32 = warrant(c, m, omg, ocg, omc, occ, tau);
        if(complex == 0 && d == 1) { h_install = h_install + 1; }
        if(complex == 1 && d == 0) { hc_withhold = hc_withhold + 1; }
        f = f + 1;
    }
    // Class A: static-frame injection (no lawful response function).
    let a_install:i32 = 0;
    let s:i32 = 0;
    while(s < 120) {
        let c:i64 = 700 + 10 * ((s % 30) as i64);
        let m:i64 = 2200 + 500 * (((s * 7) % 10) as i64);
        let d:i32 = warrant(c, m, m + 997, c, m, c, tau);
        if(d == 1) { a_install = a_install + 1; }
        s = s + 1;
    }
    // Class B: driver-level spoof, perturbation-consistent renderer (F7a).
    let b_install:i32 = 0;
    let b1_install:i32 = 0;
    let b4_install:i32 = 0;
    s = 0;
    while(s < 120) {
        let c:i64 = 700 + 10 * ((s % 30) as i64);
        let m:i64 = 2200 + 500 * (((s * 7) % 10) as i64);
        let d:i32 = warrant(c, m, lawful_meas_gain(m), c, m, lawful_conf_crop(c), tau);
        let d1:i32 = warrant(c, m, lawful_meas_gain(m), c, m, lawful_conf_crop(c), 1);
        let d4:i32 = warrant(c, m, lawful_meas_gain(m), c, m, lawful_conf_crop(c), 4);
        if(d == 1) { b_install = b_install + 1; }
        if(d1 == 1) { b1_install = b1_install + 1; }
        if(d4 == 1) { b4_install = b4_install + 1; }
        s = s + 1;
    }

    // ---- PROBE 2: independence-premium audit (F8c) ----
    // path A: warrant on (c,m); path B: warrant on reprojected (cb,mb) with
    // the same lawful model calibrated to B-space. Audit: recompute the
    // reprojection and check it matches (shared source => NOT independent).
    let agree:i32 = 0;
    let shared:i32 = 0;
    let total2:i32 = 0;
    f = 0;
    while(f < nf) {
        let c:i64 = t_get32(confA, f);
        let m:i64 = t_get32(measA, f);
        let cb:i64 = reproj_c(c, m);
        let mb:i64 = reproj_m(c, m);
        let dA:i32 = warrant(c, m, lawful_meas_gain(m), c, m, lawful_conf_crop(c), tau);
        let dB:i32 = warrant(cb, mb, lawful_meas_gain(mb), cb, mb, lawful_conf_crop(cb), tau);
        if(dA == dB) { agree = agree + 1; }
        if(reproj_c(c, m) == cb && reproj_m(c, m) == mb) { shared = shared + 1; }
        total2 = total2 + 1;
        f = f + 1;
    }
    s = 0;
    while(s < 240) {
        let cls:i32 = 0;
        if(s >= 120) { cls = 1; }
        let t:i32 = s % 120;
        let c:i64 = 700 + 10 * ((t % 30) as i64);
        let m:i64 = 2200 + 500 * (((t * 7) % 10) as i64);
        let omg:i64 = lawful_meas_gain(m);
        let occ:i64 = lawful_conf_crop(c);
        if(cls == 0) { omg = m + 997; occ = c; }
        let cb:i64 = reproj_c(c, m);
        let mb:i64 = reproj_m(c, m);
        let omgb:i64 = lawful_meas_gain(mb);
        let occb:i64 = lawful_conf_crop(cb);
        if(cls == 0) { omgb = mb + 997; occb = cb; }
        let dA:i32 = warrant(c, m, omg, c, m, occ, tau);
        let dB:i32 = warrant(cb, mb, omgb, cb, mb, occb, tau);
        if(dA == dB) { agree = agree + 1; }
        if(reproj_c(c, m) == cb && reproj_m(c, m) == mb) { shared = shared + 1; }
        total2 = total2 + 1;
        s = s + 1;
    }
    let premium_bp:i64 = 0;
    let effn_x100:i64 = 100;
    if(total2 > 0) {
        premium_bp = ((total2 - agree) as i64) * 10000 / (total2 as i64);
        effn_x100 = (agree as i64) * 100 / (total2 as i64);
    }
    let audit:i32 = 0;
    if(shared == total2) { audit = 1; }

    // ---- PROBE 3: discrimination-per-cost + repertoire coverage (D4) ----
    // Frozen unit costs: sensor read = 1, actuator command = 10, cycle = 0.1.
    // P7 check: 2 perturbations x (1 read + 1 cycle) = 2.2 -> cost_x10 = 22.
    // P10 check: 1 action x (10 + 10 cycles) = 11.0 -> cost_x10 = 110.
    // P7 bits measured with +1 smoothing: ilog2((n+1)/(k+1)).
    let p7_sa_bits:i64 = ilog2(121 / (a_install + 1) as i64);
    let p7_sb_bits:i64 = ilog2(121 / (b_install + 1) as i64);
    let p7_bits_avg_num:i64 = p7_sa_bits + p7_sb_bits;
    // P10 repertoire table (MODEL, frozen): only class 0 has a discriminating
    // action (PING, 5 bits); classes 1..3 uncovered.
    let p10_bits_sum:i64 = 5;
    let coverage_pct:i64 = 100 / 4;
    let p7_cost_x10:i64 = 22;
    let p10_cost_x10:i64 = 110;
    let p7_dpc_x100:i64 = 100 * p7_bits_avg_num * 10 / (2 * p7_cost_x10);
    let p10_dpc_x100:i64 = 100 * p10_bits_sum * 10 / (4 * p10_cost_x10);
    let cost_ratio_x100:i64 = 100 * p10_cost_x10 / p7_cost_x10;

    // ---- output ----
    let out:[]u8 = nio_alloc(4096);
    let q:i32 = 0;
    q = ap_str(out, q, "D1PROBE fixture_n=");
    q = ap_i64(out, q, nf as i64);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "P1 h_n=");
    q = ap_i64(out, q, nf as i64);
    q = ap_str(out, q, " h_install=");
    q = ap_i64(out, q, h_install as i64);
    q = ap_str(out, q, " hc_n=");
    q = ap_i64(out, q, hc_n as i64);
    q = ap_str(out, q, " hc_withhold=");
    q = ap_i64(out, q, hc_withhold as i64);
    q = ap_str(out, q, " classA_n=120 classA_install=");
    q = ap_i64(out, q, a_install as i64);
    q = ap_str(out, q, " classB_n=120 classB_install=");
    q = ap_i64(out, q, b_install as i64);
    q = ap_str(out, q, " tau1_B_install=");
    q = ap_i64(out, q, b1_install as i64);
    q = ap_str(out, q, " tau4_B_install=");
    q = ap_i64(out, q, b4_install as i64);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "P2 n=");
    q = ap_i64(out, q, total2 as i64);
    q = ap_str(out, q, " agree=");
    q = ap_i64(out, q, agree as i64);
    q = ap_str(out, q, " premium_bp=");
    q = ap_i64(out, q, premium_bp);
    q = ap_str(out, q, " effn_x100=");
    q = ap_i64(out, q, effn_x100);
    q = ap_str(out, q, " audit=");
    if(audit == 1) { q = ap_str(out, q, "SHARED_SOURCE"); }
    if(audit == 0) { q = ap_str(out, q, "INDEPENDENT"); }
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "P3 coverage_pct=");
    q = ap_i64(out, q, coverage_pct);
    q = ap_str(out, q, " p7_sa_bits=");
    q = ap_i64(out, q, p7_sa_bits);
    q = ap_str(out, q, " p7_sb_bits=");
    q = ap_i64(out, q, p7_sb_bits);
    q = ap_str(out, q, " p7_cost_x10=");
    q = ap_i64(out, q, p7_cost_x10);
    q = ap_str(out, q, " p7_dpc_x100=");
    q = ap_i64(out, q, p7_dpc_x100);
    q = ap_str(out, q, " p10_bits_x100=");
    q = ap_i64(out, q, p10_bits_sum * 25);
    q = ap_str(out, q, " p10_cost_x10=");
    q = ap_i64(out, q, p10_cost_x10);
    q = ap_str(out, q, " p10_dpc_x100=");
    q = ap_i64(out, q, p10_dpc_x100);
    q = ap_str(out, q, " cost_ratio_x100=");
    q = ap_i64(out, q, cost_ratio_x100);
    q = ap_str(out, q, " p10_SB_bits=5 p7_SB_bits=");
    q = ap_i64(out, q, p7_sb_bits);
    q = ap_str(out, q, " src=MODEL_P10_MEASURED_P7\n");
    _zag_raw_syscall(1, 1, _zag_slice_ptr(out) as i64, q as i64, 0, 0, 0);
    return;
}

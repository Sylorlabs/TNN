// VERIFIED COPY — extracted from the R-35 repaired probe hpam3536_r35.zag
// (repair of hpam3536_probe.zag @ b20ae9edf87da4aa: full-64-bit tag binding)
// DO NOT EDIT. Regenerated by extract_r35.py; verify_copies.sh checks identity.

struct LowVal { id:i64, conf:i64, meas:i64, label:i64 }

struct HighVal { id:i64, conf:i64, meas:i64, label:i64, verdict:i64, taghi:u64, taglo:u64 }

struct LowVec { v0:i64, v1:i64, v2:i64, v3:i64 }

struct HighVec { v0:i64, v1:i64, v2:i64, v3:i64, taghi:u64, taglo:u64 }

struct LowKey { k0:i64, k1:i64 }

struct HighKey { k0:i64, k1:i64, taghi:u64, taglo:u64 }

// R-35: one half of the capability tag over FULL-64 content bytes || verdict
// || CAP || dom (was: low-32 only via put32i — the J-35 hole)

fn fnv32(bs:[]u8, n:i32, dom:u8) u64 {
    let h:u64 = 2166136261;
    h = ((h ^ (dom as u64)) * (16777619 as u64)) % (4294967296 as u64);
    let i:i32 = 0;
    while(i < n) {
        h = ((h ^ (bs[i] as u64)) * (16777619 as u64)) % (4294967296 as u64);
        i = i + 1;
    }
    return h;
}

fn put32i(bs:[]u8, o:i32, v:i64) void {
    bs[o] = (v % 256) as u8;
    bs[o+1] = ((v / 256) % 256) as u8;
    bs[o+2] = ((v / 65536) % 256) as u8;
    bs[o+3] = ((v / 16777216) % 256) as u8;
    return;
}
// R-35: full 64-bit LE decomposition of an i64 (proven put32i style:
// u8 arena + repeated % 256 / / 256; mint and verify use the same fn so
// binding is self-consistent by construction)

fn put32u(bs:[]u8, o:i32, v:u64) void {
    let k:u64 = 256;
    bs[o] = (v % k) as u8;
    bs[o+1] = ((v / k) % k) as u8;
    bs[o+2] = ((v / (k * k)) % k) as u8;
    bs[o+3] = ((v / (k * k * k)) % k) as u8;
    return;
}

fn put64i(bs:[]u8, o:i32, v:i64) void {
    let k:i64 = v;
    let b:i32 = 0;
    while(b < 8) {
        bs[o + b] = (k % 256) as u8;
        k = k / 256;
        b = b + 1;
    }
    return;
}

fn get32i(bs:[]u8, o:i32) i64 {
    let r:i64 = (bs[o] as i64) + (bs[o+1] as i64) * 256 + (bs[o+2] as i64) * 65536 + (bs[o+3] as i64) * 16777216;
    return r;
}

fn tag_half(bs:[]u8, id:i64, conf:i64, meas:i64, label:i64, verdict:i64, cap:i64, dom:u8) u64 {
    put64i(bs, 0, id);
    put64i(bs, 8, conf);
    put64i(bs, 16, meas);
    put64i(bs, 24, label);
    put64i(bs, 32, verdict);
    put64i(bs, 40, cap);
    return fnv32(bs, 48, dom);
}
// sink-side verification: tag must match content AND verdict==1

fn verify_high(id:i64, conf:i64, meas:i64, label:i64, verdict:i64, taghi:u64, taglo:u64, bs:[]u8) i32 {
    if(verdict != 1) { return 0; }
    let th:u64 = tag_half(bs, id, conf, meas, label, verdict, 2654435769, 7);
    if(taghi != th) { return 0; }
    let tl:u64 = tag_half(bs, id, conf, meas, label, verdict, 2135587861, 8);
    if(taglo != tl) { return 0; }
    return 1;
}
// the ONLY sanctioned LowVal -> HighVal path; requires the verdict bit

fn declassify(v:LowVal, verdict:i64, bs:[]u8) HighVal {
    if(verdict == 1) {
        let th:u64 = tag_half(bs, v.id, v.conf, v.meas, v.label, verdict, 2654435769, 7);
        let tl:u64 = tag_half(bs, v.id, v.conf, v.meas, v.label, verdict, 2135587861, 8);
        return HighVal{.id=v.id, .conf=v.conf, .meas=v.meas, .label=v.label, .verdict=verdict, .taghi=th, .taglo=tl};
    }
    return HighVal{.id=v.id, .conf=v.conf, .meas=v.meas, .label=v.label, .verdict=verdict, .taghi=0, .taglo=0};
}
// high-stake sinks: fire (return 1) only on tag-verified HighVal

fn act_sink(v:HighVal, bs:[]u8) i32 {
    return verify_high(v.id, v.conf, v.meas, v.label, v.verdict, v.taghi, v.taglo, bs);
}

fn premise_sink(v:HighVal, bs:[]u8) i32 {
    return verify_high(v.id, v.conf, v.meas, v.label, v.verdict, v.taghi, v.taglo, bs);
}
// oracle trainer (isolates type mechanics, as in Round-C tier mode)

fn oracle(label:i64) i64 { return label; }

fn mean8(a:LowVal, b:LowVal, c:LowVal, d:LowVal, e:LowVal, f:LowVal, g:LowVal, h:LowVal) LowVal {
    let si:i64 = a.id + b.id + c.id + d.id + e.id + f.id + g.id + h.id;
    let sc:i64 = a.conf + b.conf + c.conf + d.conf + e.conf + f.conf + g.conf + h.conf;
    let sm:i64 = a.meas + b.meas + c.meas + d.meas + e.meas + f.meas + g.meas + h.meas;
    return LowVal{.id=si / 8, .conf=sc / 8, .meas=sm / 8, .label=0};
}
// IF2: cache stores/returns LowVal (tag inherited, never minted)

fn cache_put(ar:[]u8, slot:i32, v:LowVal) void {
    put32i(ar, slot * 16, v.id);
    put32i(ar, slot * 16 + 4, v.conf);
    put32i(ar, slot * 16 + 8, v.meas);
    put32i(ar, slot * 16 + 12, v.label);
    return;
}

fn cache_get(ar:[]u8, slot:i32) LowVal {
    return LowVal{.id=get32i(ar, slot * 16), .conf=get32i(ar, slot * 16 + 4), .meas=get32i(ar, slot * 16 + 8), .label=get32i(ar, slot * 16 + 12)};
}
// IF3: embedding of a low value -> LowVec; uplift without verdict mints tag (0,0)

fn emb(v:LowVal) LowVec {
    return LowVec{.v0=(v.id * 3 + v.conf) % 1009, .v1=(v.meas * 5 + v.id) % 1009, .v2=(v.conf * 7 + v.meas) % 1009, .v3=(v.label * 11 + 13) % 1009};
}

fn vec_uplift(x:LowVec) HighVec {
    return HighVec{.v0=x.v0, .v1=x.v1, .v2=x.v2, .v3=x.v3, .taghi=0, .taglo=0};
}
// R-35: full-64 binding for the IF3 vector sink

fn vec_tag_half(bs:[]u8, v0:i64, v1:i64, v2:i64, v3:i64, cap:i64, dom:u8) u64 {
    put64i(bs, 0, v0);
    put64i(bs, 8, v1);
    put64i(bs, 16, v2);
    put64i(bs, 24, v3);
    put64i(bs, 32, cap);
    return fnv32(bs, 40, dom);
}

fn decide_high(x:HighVec, bs:[]u8) i32 {
    let th:u64 = vec_tag_half(bs, x.v0, x.v1, x.v2, x.v3, 2654435769, 17);
    if(x.taghi != th) { return 0; }
    let tl:u64 = vec_tag_half(bs, x.v0, x.v1, x.v2, x.v3, 2135587861, 18);
    if(x.taglo != tl) { return 0; }
    return 1;
}
// IF4: retrieval key from a low value -> LowKey; uplift without verdict mints (0,0)

fn retrkey(v:LowVal) LowKey {
    return LowKey{.k0=(v.id * 131 + v.conf) % 10007, .k1=(v.meas * 131 + v.label) % 10007};
}

fn key_uplift(k:LowKey) HighKey {
    return HighKey{.k0=k.k0, .k1=k.k1, .taghi=0, .taglo=0};
}
// R-35: full-64 binding for the IF4 keyed-premise sink

fn premise_keyed(k:HighKey, bs:[]u8) i32 {
    put64i(bs, 0, k.k0);
    put64i(bs, 8, k.k1);
    put64i(bs, 16, 2654435769);
    let th:u64 = fnv32(bs, 24, 27);
    if(k.taghi != th) { return 0; }
    put64i(bs, 16, 2135587861);
    let tl:u64 = fnv32(bs, 24, 28);
    if(k.taglo != tl) { return 0; }
    return 1;
}
// IF5: summary digest of low values -> LowVal (still low-typed)

fn summarize(a:LowVal, b:LowVal, c:LowVal, d:LowVal, e:LowVal, f:LowVal, g:LowVal, h:LowVal) LowVal {
    let m:LowVal = mean8(a, b, c, d, e, f, g, h);
    return LowVal{.id=0 - 1, .conf=(m.conf * 31 + m.meas) % 1000003, .meas=(m.id * 37 + 11) % 1000003, .label=0};
}

// adversary fixture: deterministic false low-typed percept (label=0)

fn adv_low(j:i64) LowVal {
    return LowVal{.id=2000 + j, .conf=700 + ((j * 13) % 31), .meas=6000 + ((j * 29) % 21) * 50, .label=0};
}
// forged HighVal literal with a guessed tag (the gadget's forgery attempt)

fn forge(id:i64, conf:i64, meas:i64, label:i64, gh:u64, gl:u64) HighVal {
    return HighVal{.id=id, .conf=conf, .meas=meas, .label=label, .verdict=1, .taghi=gh, .taglo=gl};
}

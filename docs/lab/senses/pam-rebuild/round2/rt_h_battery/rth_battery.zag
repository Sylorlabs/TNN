@import("R33_NATIVE_IO_V1.zag")

// rth_battery.zag -- RT-H Class-H battery vs the committed D1 hybrid (2026-09-24).
// Pure Zag, zero RNG, deterministic. Frozen prereg: PREREG_RT_H.md (committed
// alone, commit 354186d4). Assembled by assemble_rth.py from the committed
// d1battery.zag (81dcfaf1) + rth_new.zag.
//
// Hybrid under test: the COMMITTED D1 artifact, UNMODIFIED. Functions between
// the VERBATIM markers are byte-identical copies of committed d1battery.zag;
// see hybrid_src_diff.txt. New code (rth_new.zag) drives the hybrid with
// Class-H fixtures and computes the two probes + kill bars; it does not
// alter the hybrid's decision logic.
//
// argv[1]: rth_fixtures.txt (240: 120 N honest + 120 H attack, gen_rth.py).
// argv[2]: d1_adv_fixtures.txt (committed, 81dcfaf1; class-B records feed
//          the handoff-inversion probe's Wire 1).
//
// znc landmine notes: no `as []i32` casts (parallel []u8 arenas with
// explicit little-endian put/get32); no slice ==; no .* on non-pointers;
// no bare blocks; no struct returns; shallow nesting only; no identifier
// named try; i64 only non-negative for >> and %.

// === BEGIN VERBATIM COPY FROM d1battery.zag (commit 81dcfaf1) ===
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}

fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let total:i64 = 0;
    let done:i32 = 0;
    while(done == 0) {
        let rem:i64 = (max as i64) - total;
        if(rem <= 0) { done = 1; }
        if(done == 0) {
            let p:i64 = (_zag_slice_ptr(out) as i64) + total;
            let n:i64 = _zag_raw_syscall(0, fd, p, rem, 0, 0, 0);
            if(n <= 0) { done = 1; }
            if(done == 0) { total = total + n; }
        }
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return total;
}

fn p_atoi(b:[]u8, st:i32, en:i32) i64 {
    let v:i64 = 0;
    let i:i32 = st;
    while(i < en) {
        let c:i32 = b[i] as i32;
        if(c >= 48 && c <= 57) { v = v * 10 + ((c - 48) as i64); }
        i = i + 1;
    }
    return v;
}

fn getf(b:[]u8, st:i32, en:i32, k:i32, tmp:[]u8) i32 {
    let f:i32 = 0;
    let fs:i32 = st;
    let fe:i32 = -1;
    let i:i32 = st;
    while(i < en) {
        if((b[i] as i32) == 124) {
            if(f == k) { fe = i; }
            if(fe < 0) { f = f + 1; fs = i + 1; }
        }
        if(fe >= 0) { i = en; }
        if(fe < 0) { i = i + 1; }
    }
    if(fe < 0 && f == k) { fe = en; }
    if(fe < 0) { return -1; }
    let n:i32 = fe - fs;
    let j:i32 = 0;
    while(j < n) { tmp[j] = b[fs + j]; j = j + 1; }
    return n;
}

fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}

fn t_put32(a:[]u8, i:i32, v:i64) void {
    a[i*4] = (v & 255) as u8;
    a[i*4+1] = ((v >> 8) & 255) as u8;
    a[i*4+2] = ((v >> 16) & 255) as u8;
    a[i*4+3] = ((v >> 24) & 255) as u8;
}

fn t_get32(a:[]u8, i:i32) i64 {
    let b0:i64 = a[i*4] as i64;
    let b1:i64 = a[i*4+1] as i64;
    let b2:i64 = a[i*4+2] as i64;
    let b3:i64 = a[i*4+3] as i64;
    return b0 + b1*256 + b2*65536 + b3*16777216;
}

fn ap_str(b:[]u8, p:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) { b[p+i] = s[i]; i = i + 1; }
    return p + s.len;
}

fn ap_i64(b:[]u8, p:i32, v:i64) i32 {
    let q:i32 = p;
    let x:i64 = v;
    if(x < 0) { b[q] = 45; q = q + 1; x = 0 - x; }
    if(x == 0) { b[q] = 48; return q + 1; }
    let d:i64 = 1;
    while(d <= x / 10) { d = d * 10; }
    while(d >= 1) {
        let dig:i64 = x / d;
        b[q] = (48 + dig) as u8;
        q = q + 1;
        x = x - dig * d;
        d = d / 10;
    }
    return q;
}

fn lawful_meas_gain(m:i64) i64 { return m * 12 / 10; }

fn lawful_conf_crop(c:i64) i64 { return c - 24; }

fn warrant(c:i64, m:i64, om_gain:i64, oc_gain:i64, om_crop:i64, oc_crop:i64, tau:i64) i32 {
    if(iabs(om_gain - lawful_meas_gain(m)) > tau) { return 0; }
    if(iabs(oc_gain - c) > tau) { return 0; }
    if(iabs(om_crop - m) > tau) { return 0; }
    if(iabs(oc_crop - lawful_conf_crop(c)) > tau) { return 0; }
    return 1;
}

fn reproj_c(c:i64, m:i64) i64 { return (c * 3 + m) % 9973; }

fn reproj_m(c:i64, m:i64) i64 { return (m * 5 + c) % 65521; }

fn world_w(t:i64, p:i64) i64 { return (t * 11 + p * 17 + 3) & 31; }

fn p_actual_fn(L:i64) i64 { return ((L * 1103515245 + 12345) >> 16) & 31; }

fn p_guess_fn(id:i64) i64 { return ((id * 40503) >> 8) & 31; }
// === END VERBATIM COPY ===

// === BEGIN NEW CODE (RT-H battery, probes, kill bars) ===
// Everything below is NEW RT-H code. The hybrid decision pipeline above
// (warrant, reproj, world_w, p_actual_fn, p_guess_fn, routing shape, ledger
// evolution) is the committed D1 artifact, byte-identical. This section
// drives it with Class-H fixtures and computes the two probes + kill bars.
// It does not alter the hybrid's decision logic.

// Synthetic-residual noise model (deterministic, zero RNG; documented in
// gen_rth.py). Consumed ONLY by the REFERENCE two-record check below
// (labeled; not the hybrid). The committed audit never sees these.
fn noiseB_c(j:i64) i64 { return 1 + ((j * 1103515245 + 12345) % 1999); }
fn noiseB_m(j:i64) i64 { return 1 + ((j * 1664525 + 1013904223) % 1999); }

fn main() void {
    let tau:i64 = 2;
    // ---- load rth fixtures (id|class|scene|conf|meas|t; H=attack, N=honest) ----
    let rth_path:[]u8 = _zag_arg(1);
    let rb:[]u8 = nio_alloc(20000);
    let rn:i64 = z_read(rth_path, rb, 20000);
    let rnn:i32 = rn as i32;
    let rid:[]u8 = nio_alloc(240*4);
    let rcls:[]u8 = nio_alloc(240*4);
    let rsc:[]u8 = nio_alloc(240*4);
    let rcf:[]u8 = nio_alloc(240*4);
    let rms:[]u8 = nio_alloc(240*4);
    let rtt:[]u8 = nio_alloc(240*4);
    let tmp:[]u8 = nio_alloc(256);
    let nr:i32 = 0;
    let st:i32 = 0;
    let i:i32 = 0;
    while(i <= rnn) {
        let eol:i32 = 0;
        if(i == rnn) { eol = 1; }
        if(eol == 0) {
            if((rb[i] as i32) == 10) { eol = 1; }
        }
        if(eol == 1) {
            if(i > st && nr < 240) {
                let f0:i32 = getf(rb, st, i, 0, tmp);
                let idv:i64 = -1;
                if(f0 > 0) { idv = p_atoi(tmp, 0, f0); }
                let f1:i32 = getf(rb, st, i, 1, tmp);
                let cls:i64 = -1;
                if(f1 > 0) {
                    let ch:i32 = tmp[0] as i32;
                    if(ch == 72) { cls = 3; }
                    if(ch == 78) { cls = 4; }
                }
                let f2:i32 = getf(rb, st, i, 2, tmp);
                let sc:i64 = -1;
                if(f2 > 0) {
                    let ch2:i32 = tmp[0] as i32;
                    if(ch2 == 84) { sc = 0; }
                    if(ch2 == 67) { sc = 1; }
                    if(ch2 == 80) { sc = 2; }
                }
                let f3:i32 = getf(rb, st, i, 3, tmp);
                let cfv:i64 = -1;
                if(f3 > 0) { cfv = p_atoi(tmp, 0, f3); }
                let f4:i32 = getf(rb, st, i, 4, tmp);
                let mfv:i64 = -1;
                if(f4 > 0) { mfv = p_atoi(tmp, 0, f4); }
                let f5:i32 = getf(rb, st, i, 5, tmp);
                let tv:i64 = -1;
                if(f5 > 0) { tv = p_atoi(tmp, 0, f5); }
                if(f0 > 0 && cls >= 0 && sc >= 0 && f3 > 0 && f4 > 0 && f5 > 0) {
                    t_put32(rid, nr, idv);
                    t_put32(rcls, nr, cls);
                    t_put32(rsc, nr, sc);
                    t_put32(rcf, nr, cfv);
                    t_put32(rms, nr, mfv);
                    t_put32(rtt, nr, tv);
                    nr = nr + 1;
                }
            }
            st = i + 1;
        }
        i = i + 1;
    }

    // ---- counters ----
    let p7_hon_install:i64 = 0;
    let p7_atk_install:i64 = 0;
    let p10_hon_inv:i64 = 0;
    let p10_atk_inv:i64 = 0;
    let hy_hon_inst:i64 = 0;
    let hy_hon_prov:i64 = 0;
    let hy_hon_with:i64 = 0;
    let hy_hon_uncov:i64 = 0;
    let hy_atk_inst:i64 = 0;
    let hy_atk_prov:i64 = 0;
    let hy_atk_with:i64 = 0;
    let hy_atk_uncov:i64 = 0;
    let aud_n:i64 = 0;
    let aud_agree:i64 = 0;
    let aud_shared1:i64 = 0;
    let f8c_n:i64 = 0;
    let f8c_h:i64 = 0;
    let fire_atk:i64 = 0;
    let fire_hon:i64 = 0;
    let ref_indep_atk:i64 = 0;
    let ref_indep_hon:i64 = 0;
    let L:i64 = 305419896;
    let jn:i64 = 0;
    let jh:i64 = 0;

    // ---- process rth fixtures through the committed hybrid pipeline ----
    let s:i32 = 0;
    while(s < nr) {
        let gid:i64 = t_get32(rid, s);
        let cls:i64 = t_get32(rcls, s);
        let sc:i64 = t_get32(rsc, s);
        let c:i64 = t_get32(rcf, s);
        let m:i64 = t_get32(rms, s);
        // Observed perturbation responses: deviant gain arm (+997), the
        // committed battery's honest-complex shape. |obs-lawful|=997>tau
        // on every H/N fixture -> P7 WITHHOLDS on 120/120.
        let omg:i64 = lawful_meas_gain(m) + 997;
        let ocg:i64 = c;
        let omc:i64 = m;
        let occ:i64 = lawful_conf_crop(c);
        let d7:i32 = warrant(c, m, omg, ocg, omc, occ, tau);
        // Hybrid routing (committed D1 shape).
        let dec:i64 = 0;
        let p10d:i64 = 0;
        if(d7 == 0) {
            let complex:i64 = 0;
            if(m >= 6000) { complex = 1; }
            if(complex == 1) { dec = 2; } else { dec = 0; }
        } else {
            if(sc == 0) {
                p10d = 1;
                let pa:i64 = p_actual_fn(L);
                let pg:i64 = p_guess_fn(gid);
                let claim:i64 = 0;
                if(m >= 4000) { claim = 1; }
                let o:i64 = world_w(claim, pg);
                let e:i64 = world_w(claim, pa);
                if(o == e) { dec = 1; } else { dec = 2; }
            } else {
                dec = 3;
            }
        }
        if(d7 == 1) {
            if(cls == 4) { p7_hon_install = p7_hon_install + 1; }
            if(cls == 3) { p7_atk_install = p7_atk_install + 1; }
        }
        if(p10d == 1) {
            if(cls == 4) { p10_hon_inv = p10_hon_inv + 1; }
            if(cls == 3) { p10_atk_inv = p10_atk_inv + 1; }
        }
        if(cls == 4) {
            if(dec == 1) { hy_hon_inst = hy_hon_inst + 1; }
            if(dec == 2) { hy_hon_prov = hy_hon_prov + 1; }
            if(dec == 0) { hy_hon_with = hy_hon_with + 1; }
            if(dec == 3) { hy_hon_inst = hy_hon_inst + 1; hy_hon_uncov = hy_hon_uncov + 1; }
        }
        if(cls == 3) {
            if(dec == 1) { hy_atk_inst = hy_atk_inst + 1; }
            if(dec == 2) { hy_atk_prov = hy_atk_prov + 1; }
            if(dec == 0) { hy_atk_with = hy_atk_with + 1; }
            if(dec == 3) { hy_atk_inst = hy_atk_inst + 1; hy_atk_uncov = hy_atk_uncov + 1; }
        }
        // Audit (committed shape): path B derived by reprojection.
        let cb:i64 = reproj_c(c, m);
        let mb:i64 = reproj_m(c, m);
        let omgb:i64 = lawful_meas_gain(mb) + 997;
        let occb:i64 = lawful_conf_crop(cb);
        let dB:i32 = warrant(cb, mb, omgb, cb, mb, occb, tau);
        aud_n = aud_n + 1;
        if(d7 == dB) { aud_agree = aud_agree + 1; }
        let shared:i64 = 0;
        if(reproj_c(c, m) == cb) {
            if(reproj_m(c, m) == mb) { shared = 1; }
        }
        if(shared == 1) { aud_shared1 = aud_shared1 + 1; }
        if(cls == 4 && shared == 1) { f8c_n = 1; }
        if(shared == 1) {
            if(cls == 3) { fire_atk = fire_atk + 1; }
            if(cls == 4) { fire_hon = fire_hon + 1; }
        }
        // REFERENCE two-record check (labeled; NOT the hybrid): what a
        // structural reprojection check would report if it consumed an
        // independent path-B record carrying the documented synthetic
        // residual noise. The committed audit never sees this record.
        let jj:i64 = 0;
        if(cls == 4) { jj = jn; jn = jn + 1; }
        if(cls == 3) { jj = jh; jh = jh + 1; }
        let cb_obs:i64 = reproj_c(c, m) + noiseB_c(jj);
        let mb_obs:i64 = reproj_m(c, m) + noiseB_m(jj);
        let ref_match:i64 = 0;
        if(reproj_c(c, m) == cb_obs) {
            if(reproj_m(c, m) == mb_obs) { ref_match = 1; }
        }
        if(ref_match == 0) {
            if(cls == 3) { ref_indep_atk = ref_indep_atk + 1; }
            if(cls == 4) { ref_indep_hon = ref_indep_hon + 1; }
        }
        // Ledger evolution (committed shape).
        L = (L * 1664525 + (1 + dec) * 1013904223 + 7) % 2147483648;
        s = s + 1;
    }

    // ---- handoff-inversion probe, Wire 1 (POLICY PROBE, not committed D1
    // wiring): audit-detect -> fall back to P7-only. Class-B fixtures from
    // the committed d1_adv_fixtures.txt (P7's measured 100%-install regime).
    // The committed D1 audit is observational and routes nothing; this probe
    // implements grok's ASSUMED policy to test attack #2. ----
    let adv_path:[]u8 = _zag_arg(2);
    let ab:[]u8 = nio_alloc(60000);
    let an:i64 = z_read(adv_path, ab, 60000);
    let ann:i32 = an as i32;
    let bid:[]u8 = nio_alloc(120*4);
    let bcf:[]u8 = nio_alloc(120*4);
    let bms:[]u8 = nio_alloc(120*4);
    let nb:i32 = 0;
    st = 0;
    i = 0;
    while(i <= ann) {
        let eol:i32 = 0;
        if(i == ann) { eol = 1; }
        if(eol == 0) {
            if((ab[i] as i32) == 10) { eol = 1; }
        }
        if(eol == 1) {
            if(i > st && nb < 120) {
                let f0:i32 = getf(ab, st, i, 0, tmp);
                let idv:i64 = -1;
                if(f0 > 0) { idv = p_atoi(tmp, 0, f0); }
                let f1:i32 = getf(ab, st, i, 1, tmp);
                let isb:i64 = 0;
                if(f1 > 0) {
                    if((tmp[0] as i32) == 66) { isb = 1; }
                }
                let f3:i32 = getf(ab, st, i, 3, tmp);
                let cfv:i64 = -1;
                if(f3 > 0) { cfv = p_atoi(tmp, 0, f3); }
                let f4:i32 = getf(ab, st, i, 4, tmp);
                let mfv:i64 = -1;
                if(f4 > 0) { mfv = p_atoi(tmp, 0, f4); }
                if(isb == 1 && f0 > 0 && f3 > 0 && f4 > 0) {
                    t_put32(bid, nb, idv);
                    t_put32(bcf, nb, cfv);
                    t_put32(bms, nb, mfv);
                    nb = nb + 1;
                }
            }
            st = i + 1;
        }
        i = i + 1;
    }
    let wire1_n:i64 = 0;
    let wire1_install:i64 = 0;
    let wire1_f8c3:i64 = 0;
    let w:i32 = 0;
    while(w < nb) {
        let c:i64 = t_get32(bcf, w);
        let m:i64 = t_get32(bms, w);
        // Class-B: faked lawful perturbation responses (committed shape).
        let omg:i64 = lawful_meas_gain(m);
        let ocg:i64 = c;
        let omc:i64 = m;
        let occ:i64 = lawful_conf_crop(c);
        let d7:i32 = warrant(c, m, omg, ocg, omc, occ, tau);
        // P7-only fallback policy: install iff the P7 warrant installs.
        wire1_n = wire1_n + 1;
        if(d7 == 1) { wire1_install = wire1_install + 1; }
        // Committed audit on the same fixture (does the detection wire fire?).
        let cb:i64 = reproj_c(c, m);
        let mb:i64 = reproj_m(c, m);
        let omgb:i64 = lawful_meas_gain(mb);
        let occb:i64 = lawful_conf_crop(cb);
        let dB:i32 = warrant(cb, mb, omgb, cb, mb, occb, tau);
        let shared:i64 = 0;
        if(reproj_c(c, m) == cb) {
            if(reproj_m(c, m) == mb) { shared = 1; }
        }
        if(shared == 1 && d7 == dB) { wire1_f8c3 = 1; }
        w = w + 1;
    }

    // ---- handoff-inversion probe, Wire 2 (POLICY PROBE): audit-silent ->
    // trust fusion -> admit. Per-fixture detection uses the committed f8c
    // gating (class-gated to cls 1/2); class H is never flagged -> silent
    // -> the policy admits. ----
    let wire2_n:i64 = 0;
    let wire2_admit:i64 = 0;
    s = 0;
    while(s < nr) {
        let cls:i64 = t_get32(rcls, s);
        if(cls == 3) {
            wire2_n = wire2_n + 1;
            let c:i64 = t_get32(rcf, s);
            let m:i64 = t_get32(rms, s);
            let omg:i64 = lawful_meas_gain(m) + 997;
            let d7:i32 = warrant(c, m, omg, c, m, lawful_conf_crop(c), tau);
            let cb:i64 = reproj_c(c, m);
            let mb:i64 = reproj_m(c, m);
            let dB:i32 = warrant(cb, mb, lawful_meas_gain(mb) + 997, cb, mb, lawful_conf_crop(cb), tau);
            let shared:i64 = 0;
            if(reproj_c(c, m) == cb) {
                if(reproj_m(c, m) == mb) { shared = 1; }
            }
            let det:i64 = 0;
            if(cls == 2 && shared == 1 && d7 == dB) { det = 1; }
            if(cls == 1 && shared == 1 && d7 == dB) { det = 1; }
            if(det == 0) { wire2_admit = wire2_admit + 1; }
        }
        s = s + 1;
    }

    // ---- kill bars (preregistered) ----
    let admission_num:i64 = hy_atk_inst + hy_atk_prov + hy_atk_uncov;
    let kill_h:i64 = 0;
    if(admission_num >= 97) { kill_h = 1; }
    if(hy_hon_with * 100 > 1800) { kill_h = 1; }
    let kill_audit:i64 = 1;
    if(fire_atk >= 108 && fire_hon <= 18) { kill_audit = 0; }

    // ---- output ----
    let out:[]u8 = nio_alloc(8192);
    let q:i32 = 0;
    q = ap_str(out, q, "RTHBAT rth_n=");
    q = ap_i64(out, q, nr as i64);
    q = ap_str(out, q, " b_n=");
    q = ap_i64(out, q, wire1_n);
    q = ap_str(out, q, " ledger_final=");
    q = ap_i64(out, q, L);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "RTH-P7 hon_install=");
    q = ap_i64(out, q, p7_hon_install);
    q = ap_str(out, q, " atk_install=");
    q = ap_i64(out, q, p7_atk_install);
    q = ap_str(out, q, " b_install=");
    q = ap_i64(out, q, wire1_install);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "RTH-P10 hon_inv=");
    q = ap_i64(out, q, p10_hon_inv);
    q = ap_str(out, q, " atk_inv=");
    q = ap_i64(out, q, p10_atk_inv);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "RTH-HYB h_inst=");
    q = ap_i64(out, q, hy_hon_inst);
    q = ap_str(out, q, " h_prov=");
    q = ap_i64(out, q, hy_hon_prov);
    q = ap_str(out, q, " h_with=");
    q = ap_i64(out, q, hy_hon_with);
    q = ap_str(out, q, " h_uncov=");
    q = ap_i64(out, q, hy_hon_uncov);
    q = ap_str(out, q, " a_inst=");
    q = ap_i64(out, q, hy_atk_inst);
    q = ap_str(out, q, " a_prov=");
    q = ap_i64(out, q, hy_atk_prov);
    q = ap_str(out, q, " a_with=");
    q = ap_i64(out, q, hy_atk_with);
    q = ap_str(out, q, " a_uncov=");
    q = ap_i64(out, q, hy_atk_uncov);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "RTH-AUDIT n=");
    q = ap_i64(out, q, aud_n);
    q = ap_str(out, q, " agree=");
    q = ap_i64(out, q, aud_agree);
    q = ap_str(out, q, " shared1=");
    q = ap_i64(out, q, aud_shared1);
    q = ap_str(out, q, " f8c_n=");
    q = ap_i64(out, q, f8c_n);
    q = ap_str(out, q, " f8c_h=");
    q = ap_i64(out, q, f8c_h);
    q = ap_str(out, q, " verdict=SHARED_SOURCE\n");
    q = ap_str(out, q, "RTH-PROBE-HANDOFF wire1_n=");
    q = ap_i64(out, q, wire1_n);
    q = ap_str(out, q, " wire1_install=");
    q = ap_i64(out, q, wire1_install);
    q = ap_str(out, q, " wire1_f8c3=");
    q = ap_i64(out, q, wire1_f8c3);
    q = ap_str(out, q, " wire2_n=");
    q = ap_i64(out, q, wire2_n);
    q = ap_str(out, q, " wire2_admit=");
    q = ap_i64(out, q, wire2_admit);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "RTH-PROBE-SYNRES fire_atk=");
    q = ap_i64(out, q, fire_atk);
    q = ap_str(out, q, " fire_hon=");
    q = ap_i64(out, q, fire_hon);
    q = ap_str(out, q, " ref_indep_atk=");
    q = ap_i64(out, q, ref_indep_atk);
    q = ap_str(out, q, " ref_indep_hon=");
    q = ap_i64(out, q, ref_indep_hon);
    q = ap_str(out, q, "\n");
    q = ap_str(out, q, "RTH-KILL admission_num=");
    q = ap_i64(out, q, admission_num);
    q = ap_str(out, q, " KILL_H=");
    q = ap_i64(out, q, kill_h);
    q = ap_str(out, q, " KILL_AUDIT=");
    q = ap_i64(out, q, kill_audit);
    q = ap_str(out, q, "\n");
    _zag_raw_syscall(1, 1, _zag_slice_ptr(out) as i64, q as i64, 0, 0, 0);
    return;
}
// === END NEW CODE ===

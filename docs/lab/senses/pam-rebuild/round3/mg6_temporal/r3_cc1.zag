// r3_cc1.zag — Round 3 CC1 battery: G1 gate + candidate temporal-arm guards.
// Adapts the frozen guard_main.zag (CC1 prereg a673da8a). Six preregistered
// candidates T0..T4 replace MG6's temporal arm (margin+span frozen).
// Pure Zag, zero RNG. Output: R3CC1|cand|cell|trial_idx|disp
@import("R33_NATIVE_IO_V1.zag")
@import("r3_guard_records.zag")

const D_PERM:i32=0;
const D_PROV:i32=1;
const D_CORR:i32=2;
const D_CONF:i32=3;
const D_CHAL:i32=4;
const D_REV:i32=5;
const D_ACC:i32=6;
const D_WITH:i32=7;

const S_PROV_ON:i32=0;
const S_PROV_J:i32=1;
const S_PROV_M:i32=2;
const S_PERM_ON:i32=3;
const S_PERM_J:i32=4;
const S_PERM_M:i32=5;
const S_PERM_CONF:i32=6;
const S_PERM_SEQ:i32=7;
const S_CHAL_ON:i32=8;
const S_CHAL_J:i32=9;
const S_CHAL_M:i32=10;
const S_DCHAL_ON:i32=11;
const S_DCHAL_J:i32=12;
const S_DCHAL_M:i32=13;
const S_PERM_MRG:i32=14;
const S_CHAL_MRG:i32=15;
const S_CHAL_SEQ:i32=16;
const S_CHAL_SA:i32=17;
const S_CHAL_SB:i32=18;
const S_NWORDS:i32=19;

const MG1_FLOOR:i64=400;
const MG4_GAP:i64=20;

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at]=(v & 255) as u8;
    b[at+1]=((v>>8) & 255) as u8;
    b[at+2]=((v>>16) & 255) as u8;
    b[at+3]=((v>>24) & 255) as u8;
    b[at+4]=((v>>32) & 255) as u8;
    b[at+5]=((v>>40) & 255) as u8;
    b[at+6]=((v>>48) & 255) as u8;
    b[at+7]=((v>>56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64)|((b[at+1] as i64)<<8)|((b[at+2] as i64)<<16)|((b[at+3] as i64)<<24)|((b[at+4] as i64)<<32)|((b[at+5] as i64)<<40)|((b[at+6] as i64)<<48)|((b[at+7] as i64)<<56);
}
fn iabs(x:i64) i64 {
    if(x<0){return 0-x;}
    return x;
}
fn st_get(st:[]u8, w:i32) i64 { return t_get64(st, w*8); }
fn st_put(st:[]u8, w:i32, v:i64) void { t_put64(st, w*8, v); }
fn tf(tr:[]u8, i:i32, f:i32) i64 { return t_get64(tr, i*GUARD_ROW+f*8); }

fn i64s(v:i64) []u8 {
    let s:[]u8=_zag_i64_to_str(v);
    if(s.len>0 && s[s.len-1]==10){return s[0..s.len-1];}
    return s;
}
fn cand_name(c:i32) []u8 {
    if(c==0){return "T0";}
    if(c==1){return "T1";}
    if(c==2){return "T2lo";}
    if(c==3){return "T2hi";}
    if(c==4){return "T3";}
    if(c==5){return "T4";}
    return "?";
}
fn tol_of(tc:i64) i64 {
    if(tc==0){return 8;}
    if(tc==1){return 40;}
    if(tc==2){return 60;}
    if(tc==3){return 4000;}
    if(tc==4){return 120;}
    return 0;
}
fn perm_install(st:[]u8, jc:i64, meas:i64, cf:i64, mrg:i64, ti:i32) void {
    st_put(st,S_PERM_ON,1); st_put(st,S_PERM_J,jc); st_put(st,S_PERM_M,meas);
    st_put(st,S_PERM_CONF,cf); st_put(st,S_PERM_SEQ,ti as i64);
    st_put(st,S_PERM_MRG,mrg);
    st_put(st,S_PROV_ON,0);
}

// ---------------- candidate guard (prereg §4, exact) ----------------
// cand: 0=T0 1=T1 2=T2lo 3=T2hi 4=T3 5=T4. Returns 1=allow, 0=veto.
// m1/m2: challenger mrgF. (sa1,sb1),(sa2,sb2): spans. q1/q2: seqs.
// (tc,jc): pair's tcode/jcode; hh_*: history of (tcode,jcode,seq) before the
// incoming trial; hn: history length.
fn r3_allow(cand:i32, m1:i64, m2:i64, sa1:i64, sb1:i64, sa2:i64, sb2:i64,
            q1:i64, q2:i64, tc:i64, jc:i64,
            hh_tc:[]u8, hh_jc:[]u8, hh_seq:[]u8, hn:i32) i32 {
    let a_margin:i32=1;
    let a_span:i32=1;
    let a_temp:i32=1;
    if(m1<MG1_FLOOR || m2<MG1_FLOOR){a_margin=0;}
    if(sa1<sb2 && sa2<sb1){a_span=0;}
    if(cand==0){ if(iabs(q1-q2)<20){a_temp=0;} }
    if(cand==2){ if(iabs(q1-q2)<2){a_temp=0;} }
    if(cand==3){ if(iabs(q1-q2)<6){a_temp=0;} }
    if(cand==4 || cand==5){
        let cmatch:i64=0;
        let cmin:i64=q1;
        let cmax:i64=q1;
        if(q2<cmin){cmin=q2;}
        if(q2>cmax){cmax=q2;}
        let hi:i32=0;
        while(hi<hn){
            if(t_get64(hh_tc,hi*8)==tc && t_get64(hh_jc,hi*8)==jc){
                let hseq:i64=t_get64(hh_seq,hi*8);
                cmatch=cmatch+1;
                if(hseq<cmin){cmin=hseq;}
                if(hseq>cmax){cmax=hseq;}
            }
            hi=hi+1;
        }
        if(cand==4){ if(cmax-cmin<MG4_GAP){a_temp=0;} }
        if(cand==5){ if(cmatch+1<3){a_temp=0;} }
    }
    if(a_margin==1 && a_span==1 && a_temp==1){return 1;}
    return 0;
}

// ---------------- G1 + candidate guard (frozen g1_step, guard call replaced) ----------------
fn g1_step_r3(st:[]u8, tr:[]u8, ti:i32, no_hist:i32, cand:i32,
              hh_tc:[]u8, hh_jc:[]u8, hh_seq:[]u8, hn:i32) i32 {
    let prog:i64=tf(tr,ti,1);
    if(prog!=0){return D_WITH;}
    let pred:i64=tf(tr,ti,4);
    if(pred!=1){return D_WITH;}
    let tcode:i64=tf(tr,ti,0);
    let jc:i64=tf(tr,ti,2); let cf:i64=tf(tr,ti,3); let meas:i64=tf(tr,ti,5);
    let mrg:i64=tf(tr,ti,6);
    let seq:i64=tf(tr,ti,10); let sa:i64=tf(tr,ti,11); let sb:i64=tf(tr,ti,12);
    let tol:i64=tol_of(tcode);
    let perm_on:i64=st_get(st,S_PERM_ON);
    let prov_on:i64=st_get(st,S_PROV_ON);
    if(perm_on==1 && jc==st_get(st,S_PERM_J) && iabs(meas-st_get(st,S_PERM_M))<=tol){return D_CORR;}
    if(prov_on==1 && perm_on==0 && jc==st_get(st,S_PROV_J) && iabs(meas-st_get(st,S_PROV_M))<=tol){
        if(cf>=700){
            perm_install(st,jc,meas,cf,mrg,ti);
            return D_PERM;
        }
        return D_PROV;
    }
    let inc:i32=0;
    if(perm_on==1){inc=1;}
    if(prov_on==1 && perm_on==0){inc=1;}
    if(inc==1){
        let ij:i64=st_get(st,S_PERM_J);
        if(perm_on==0){ij=st_get(st,S_PROV_J);}
        if(jc!=ij){
            if(cf>=700 && no_hist==0){
                if(st_get(st,S_CHAL_ON)==1 && st_get(st,S_CHAL_J)==jc && iabs(meas-st_get(st,S_CHAL_M))<=tol){
                    let ok:i32=r3_allow(cand,
                        st_get(st,S_CHAL_MRG), mrg,
                        st_get(st,S_CHAL_SA), st_get(st,S_CHAL_SB), sa, sb,
                        st_get(st,S_CHAL_SEQ), seq,
                        tcode, jc, hh_tc, hh_jc, hh_seq, hn);
                    if(ok==0){return D_CHAL;}
                    perm_install(st,jc,meas,cf,mrg,ti);
                    st_put(st,S_CHAL_ON,0);
                    return D_REV;
                }
                st_put(st,S_CHAL_ON,1); st_put(st,S_CHAL_J,jc); st_put(st,S_CHAL_M,meas);
                st_put(st,S_CHAL_MRG,mrg); st_put(st,S_CHAL_SEQ,seq);
                st_put(st,S_CHAL_SA,sa); st_put(st,S_CHAL_SB,sb);
                return D_CHAL;
            }
            return D_CONF;
        }
        st_put(st,S_PROV_ON,1); st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
        return D_PROV;
    }
    st_put(st,S_PROV_ON,1); st_put(st,S_PROV_J,jc); st_put(st,S_PROV_M,meas);
    return D_PROV;
}

fn main() void {
    let tr:[]u8=nio_alloc(GUARD_NTRIALS*GUARD_ROW);
    guard_init_trials(tr);
    let ci:i32=0;
    while(ci<GUARD_NCELLS){
        let co:[]u8=nio_alloc(72);
        guard_cell(ci,co);
        let start:i64=t_get64(co,0);
        let count:i64=t_get64(co,8);
        let pre_on:i64=t_get64(co,16);
        let no_hist:i32=t_get64(co,56) as i32;
        let cand:i32=0;
        while(cand<6){
            let st:[]u8=nio_alloc(S_NWORDS*8);
            let w:i32=0;
            while(w<S_NWORDS){t_put64(st,w*8,0);w=w+1;}
            if(pre_on==1){
                st_put(st,S_PERM_ON,1);
                st_put(st,S_PERM_J,t_get64(co,24));
                st_put(st,S_PERM_M,t_get64(co,32));
                st_put(st,S_PERM_CONF,t_get64(co,40));
                st_put(st,S_PERM_SEQ,t_get64(co,48));
                st_put(st,S_PERM_MRG,0);
            }
            let hh_tc:[]u8=nio_alloc(64*8);
            let hh_jc:[]u8=nio_alloc(64*8);
            let hh_seq:[]u8=nio_alloc(64*8);
            let hn:i32=0;
            let k:i64=0;
            while(k<count){
                let ti:i32=(start+k) as i32;
                let d:i32=g1_step_r3(st,tr,ti,no_hist,cand,
                                     hh_tc,hh_jc,hh_seq,hn);
                _zag_print("R3CC1|");
                _zag_print(cand_name(cand));
                _zag_print("|");
                _zag_print(guard_cell_name(ci));
                _zag_print("|");_zag_print(i64s(k));
                _zag_print("|");_zag_print(i64s(d as i64));
                _zag_print("\n");
                t_put64(hh_tc,hn*8,tf(tr,ti,0));
                t_put64(hh_jc,hn*8,tf(tr,ti,2));
                t_put64(hh_seq,hn*8,tf(tr,ti,10));
                hn=hn+1;
                k=k+1;
            }
            nio_free(hh_tc); nio_free(hh_jc); nio_free(hh_seq);
            nio_free(st);
            cand=cand+1;
        }
        nio_free(co);
        ci=ci+1;
    }
    nio_free(tr);
}

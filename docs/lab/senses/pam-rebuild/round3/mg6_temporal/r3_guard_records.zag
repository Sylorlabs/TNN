fn guard_cell_name(ci:i32) []u8 {
    if(ci==0){return "C1";}
    if(ci==1){return "C2";}
    if(ci==2){return "C3";}
    if(ci==3){return "R1";}
    if(ci==4){return "R2";}
    if(ci==5){return "H1";}
    if(ci==6){return "T1";}
    if(ci==7){return "W1";}
    if(ci==8){return "CC1";}
    if(ci==9){return "CC1-V1";}
    if(ci==10){return "CC1-V2";}
    if(ci==11){return "CC1-V3";}
    if(ci==12){return "CC1-V4";}
    if(ci==13){return "CC1-V5";}
    if(ci==14){return "CC1-V6";}
    if(ci==15){return "CC1-V7";}
    if(ci==16){return "CC1-V8";}
    if(ci==17){return "CC1-V9";}
    if(ci==18){return "CC2";}
    if(ci==19){return "CC2-W1";}
    if(ci==20){return "CC2-W2";}
    if(ci==21){return "C1-W3";}
    return "?";
}

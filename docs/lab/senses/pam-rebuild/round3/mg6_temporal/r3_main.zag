// stack_main.zag — D1 defense-stack battery (G1 gate -> MG6 guard -> H6 hardening)
// Frozen PREREG_D1_STACK.md. Pure Zag, zero RNG.
// Usage: stack_main <stream-name>   (e.g. stack_main leg1)
// Output per trial: stream|trial_idx|seq|disp|install|detail
@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("r3_records_compact.zag")

// Round 3: candidate temporal-arm guard. cand: 0=T0 1=T1 2=T2lo 3=T2hi 4=T3 5=T4.
fn cand_name(c:i64) []u8 {
    if(c == 0) { return "T0"; }
    if(c == 1) { return "T1"; }
    if(c == 2) { return "T2lo"; }
    if(c == 3) { return "T2hi"; }
    if(c == 4) { return "T3"; }
    if(c == 5) { return "T4"; }
    return "?";
}

// ---------------- LE accessors over []u8 arenas ----------------
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
// i64 -> decimal string without trailing newline (see AGENTS.md _zag_print quirk)
fn i64s(v:i64) []u8 {
    let s:[]u8 = _zag_i64_to_str(v);
    if(s.len > 0 && s[s.len - 1] == 10) { return s[0..s.len - 1]; }
    return s;
}
// ---------------- line builders ----------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_addn(ob:[]u8, pos:i32, s:[]u8, n:i32) i32 {
    let i:i32 = 0;
    while(i < n && i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
// ---------------- channel attestation (frozen key) ----------------
fn ch_key() []u8 { return "PAMV2-REG-CHANNEL-2026-09-23"; }
fn att_verify(seq:i64, fx:[]u8, fxn:i32, jg:i64, confg:i64, want:[]u8) i32 {
    let ib:[]u8 = nio_alloc(512);
    let p:i32 = ob_add(ib, 0, ch_key());
    p = ob_add(ib, p, "|");
    p = ob_add(ib, p, i64s(seq));
    p = ob_add(ib, p, "|");
    p = ob_addn(ib, p, fx, fxn);
    p = ob_add(ib, p, "|");
    p = ob_add(ib, p, i64s(jg));
    p = ob_add(ib, p, "|");
    p = ob_add(ib, p, i64s(confg));
    let dg:[]u8 = nio_alloc(32);
    let hx:[]u8 = "";
    if(ns_sha256(ib[0..p], dg) == 0) { hx = ns_hex(dg); }
    nio_free(ib);
    nio_free(dg);
    if(hx.len != 64 || want.len != 64) { return 0; }
    let i:i32 = 0;
    while(i < 64) {
        if(hx[i] != want[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
// ---------------- trial field access ----------------
// 14 words: 0 seq,1 tcode,2 prog,3 jcode,4 conf,5 pred,6 meas,7 mrgF,
//           8 jG,9 confG,10 span_a,11 span_b,12 fx_off,13 fx_len
fn tf(ar:[]u8, ti:i64, w:i32) i64 {
    return t_get64(ar, (ti as i32) * 112 + w * 8);
}
fn g1_tol(tc:i64) i64 {
    if(tc == 0) { return 8; }
    if(tc == 1) { return 40; }
    if(tc == 2) { return 60; }
    if(tc == 3) { return 4000; }
    if(tc == 4) { return 120; }
    return 0;
}
// ---------------- stream dispatch ----------------
// returns 1 and fills out-arena handles via out-params
fn stream_tables(name:[]u8, o_tr:*[]u8, o_fx:*[]u8, o_gt:*[]u8, o_n:*i64) i32 {
    if(_zag_strcmp(name, "leg1") == 1) {
        o_tr.* = D1_LEG1_TRIALS_DATA; o_fx.* = D1_LEG1_FX_DATA; o_gt.* = D1_LEG1_GATT_DATA;
        o_n.* = D1_LEG1_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg2") == 1) {
        o_tr.* = D1_LEG2_TRIALS_DATA; o_fx.* = D1_LEG2_FX_DATA; o_gt.* = D1_LEG2_GATT_DATA;
        o_n.* = D1_LEG2_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_C1") == 1) {
        o_tr.* = D1_LEG3_C1_TRIALS_DATA; o_fx.* = D1_LEG3_C1_FX_DATA; o_gt.* = D1_LEG3_C1_GATT_DATA;
        o_n.* = D1_LEG3_C1_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_C2") == 1) {
        o_tr.* = D1_LEG3_C2_TRIALS_DATA; o_fx.* = D1_LEG3_C2_FX_DATA; o_gt.* = D1_LEG3_C2_GATT_DATA;
        o_n.* = D1_LEG3_C2_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_C3") == 1) {
        o_tr.* = D1_LEG3_C3_TRIALS_DATA; o_fx.* = D1_LEG3_C3_FX_DATA; o_gt.* = D1_LEG3_C3_GATT_DATA;
        o_n.* = D1_LEG3_C3_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_R1") == 1) {
        o_tr.* = D1_LEG3_R1_TRIALS_DATA; o_fx.* = D1_LEG3_R1_FX_DATA; o_gt.* = D1_LEG3_R1_GATT_DATA;
        o_n.* = D1_LEG3_R1_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_R2") == 1) {
        o_tr.* = D1_LEG3_R2_TRIALS_DATA; o_fx.* = D1_LEG3_R2_FX_DATA; o_gt.* = D1_LEG3_R2_GATT_DATA;
        o_n.* = D1_LEG3_R2_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_CC1") == 1) {
        o_tr.* = D1_LEG3_CC1_TRIALS_DATA; o_fx.* = D1_LEG3_CC1_FX_DATA; o_gt.* = D1_LEG3_CC1_GATT_DATA;
        o_n.* = D1_LEG3_CC1_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_CC2") == 1) {
        o_tr.* = D1_LEG3_CC2_TRIALS_DATA; o_fx.* = D1_LEG3_CC2_FX_DATA; o_gt.* = D1_LEG3_CC2_GATT_DATA;
        o_n.* = D1_LEG3_CC2_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_H1") == 1) {
        o_tr.* = D1_LEG3_H1_TRIALS_DATA; o_fx.* = D1_LEG3_H1_FX_DATA; o_gt.* = D1_LEG3_H1_GATT_DATA;
        o_n.* = D1_LEG3_H1_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_T1") == 1) {
        o_tr.* = D1_LEG3_T1_TRIALS_DATA; o_fx.* = D1_LEG3_T1_FX_DATA; o_gt.* = D1_LEG3_T1_GATT_DATA;
        o_n.* = D1_LEG3_T1_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg3_W1") == 1) {
        o_tr.* = D1_LEG3_W1_TRIALS_DATA; o_fx.* = D1_LEG3_W1_FX_DATA; o_gt.* = D1_LEG3_W1_GATT_DATA;
        o_n.* = D1_LEG3_W1_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg4_clean") == 1) {
        o_tr.* = D1_LEG4_CLEAN_TRIALS_DATA; o_fx.* = D1_LEG4_CLEAN_FX_DATA; o_gt.* = D1_LEG4_CLEAN_GATT_DATA;
        o_n.* = D1_LEG4_CLEAN_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg4_withhold") == 1) {
        o_tr.* = D1_LEG4_WITHHOLD_TRIALS_DATA; o_fx.* = D1_LEG4_WITHHOLD_FX_DATA; o_gt.* = D1_LEG4_WITHHOLD_GATT_DATA;
        o_n.* = D1_LEG4_WITHHOLD_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg4_install") == 1) {
        o_tr.* = D1_LEG4_INSTALL_TRIALS_DATA; o_fx.* = D1_LEG4_INSTALL_FX_DATA; o_gt.* = D1_LEG4_INSTALL_GATT_DATA;
        o_n.* = D1_LEG4_INSTALL_TRIALS_LEN / 112; return 1;
    }
    if(_zag_strcmp(name, "leg4_decoy") == 1) {
        o_tr.* = D1_LEG4_DECOY_TRIALS_DATA; o_fx.* = D1_LEG4_DECOY_FX_DATA; o_gt.* = D1_LEG4_DECOY_GATT_DATA;
        o_n.* = D1_LEG4_DECOY_TRIALS_LEN / 112; return 1;
    }
    return 0;
}
// ---------------- main battery ----------------
fn main() void {
    let sname:[]u8 = _zag_arg(1);
    let tr:[]u8 = nio_alloc(8);
    let fx:[]u8 = nio_alloc(8);
    let gt:[]u8 = nio_alloc(8);
    let nn:i64 = 0;
    // (replaced by stream_tables below)
    if(stream_tables(sname, &tr, &fx, &gt, &nn) == 0) {
        _zag_print("unknown-stream");
        return;
    }
    let out:[]u8 = nio_alloc(4096);
    let cand:i64 = 0;
    while(cand < 6) {
    // gate state per tcode: trial indices (-1 = none)
    let prov:[]u8 = nio_alloc(48);
    let perm:[]u8 = nio_alloc(48);
    let chal:[]u8 = nio_alloc(48);
    let tc0:i32 = 0;
    while(tc0 < 6) {
        t_put64(prov, tc0 * 8, -1);
        t_put64(perm, tc0 * 8, -1);
        t_put64(chal, tc0 * 8, -1);
        tc0 = tc0 + 1;
    }
    // history for R4 (tcode, jcode, prog, meas) + seq for T3/T4
    let hn:i64 = 0;
    let ht:[]u8 = nio_alloc(4096 * 8);
    let hj:[]u8 = nio_alloc(4096 * 8);
    let hp:[]u8 = nio_alloc(4096 * 8);
    let hm:[]u8 = nio_alloc(4096 * 8);
    let hs:[]u8 = nio_alloc(4096 * 8);
    let ti:i64 = 0;
    while(ti < nn) {
        let seq:i64 = tf(tr, ti, 0);
        let tcode:i64 = tf(tr, ti, 1);
        let prog:i64 = tf(tr, ti, 2);
        let jcode:i64 = tf(tr, ti, 3);
        let conf:i64 = tf(tr, ti, 4);
        let pred:i64 = tf(tr, ti, 5);
        let meas:i64 = tf(tr, ti, 6);
        let tol:i64 = g1_tol(tcode);
        let disp:i64 = 7;
        let detail:[]u8 = "";
        let install:i64 = 0;
        let prop_s:i64 = -1;
        let prop_t:i64 = -1;
        let is_rev:i64 = 0;
        // ---- GATE (G1) ----
        if(prog != 0 || pred != 1) {
            disp = 7; detail = "gate-prog-pred";
        } else {
            let pv:i64 = t_get64(prov, (tcode as i32) * 8);
            let pm:i64 = t_get64(perm, (tcode as i32) * 8);
            let ch:i64 = t_get64(chal, (tcode as i32) * 8);
            if(pm >= 0 && jcode == tf(tr, pm, 3) && iabs(meas - tf(tr, pm, 6)) <= tol) {
                disp = 2; detail = "gate-corr";
            } else {
                if(pv >= 0 && pm < 0 && jcode == tf(tr, pv, 3)
                   && iabs(meas - tf(tr, pv, 6)) <= tol) {
                    if(conf >= 700) {
                        prop_s = pv; prop_t = ti; is_rev = 0;
                        disp = -1; detail = "gate-propose-perm";
                    } else {
                        disp = 1; detail = "gate-prov-lowconf";
                    }
                } else {
                    if(pm >= 0 || pv >= 0) {
                        let ij:i64 = 0;
                        if(pm >= 0) { ij = tf(tr, pm, 3); }
                        else { ij = tf(tr, pv, 3); }
                        if(jcode != ij) {
                            if(conf >= 700) {
                                if(ch >= 0 && tf(tr, ch, 3) == jcode
                                   && iabs(meas - tf(tr, ch, 6)) <= tol) {
                                    prop_s = ch; prop_t = ti; is_rev = 1;
                                    disp = -1; detail = "gate-propose-rev";
                                } else {
                                    t_put64(chal, (tcode as i32) * 8, ti);
                                    disp = 4; detail = "gate-chal";
                                }
                            } else {
                                disp = 3; detail = "gate-conf-lowconf";
                            }
                        } else {
                            t_put64(prov, (tcode as i32) * 8, ti);
                            disp = 1; detail = "gate-reanchor";
                        }
                    } else {
                        t_put64(prov, (tcode as i32) * 8, ti);
                        disp = 1; detail = "gate-first-prov";
                    }
                }
            }
        }
        // ---- GUARD (MG6) on proposals ----
        if(disp == -1) {
            let mrg_s:i64 = tf(tr, prop_s, 7);
            let mrg_t:i64 = tf(tr, prop_t, 7);
            let sa_s:i64 = tf(tr, prop_s, 10);
            let sb_s:i64 = tf(tr, prop_s, 11);
            let sa_t:i64 = tf(tr, prop_t, 10);
            let sb_t:i64 = tf(tr, prop_t, 11);
            let sq_s:i64 = tf(tr, prop_s, 0);
            let sq_t:i64 = tf(tr, prop_t, 0);
            let f_margin:i64 = 0;
            let f_span:i64 = 0;
            let f_temp:i64 = 0;
            if(mrg_s < 400 || mrg_t < 400) { f_margin = 1; }
            if(sa_s < sb_t && sa_t < sb_s) { f_span = 1; }
            // temporal arm by preregistered candidate (cand 0..5)
            if(cand == 0) { if(iabs(sq_s - sq_t) < 20) { f_temp = 1; } }
            if(cand == 2) { if(iabs(sq_s - sq_t) < 2) { f_temp = 1; } }
            if(cand == 3) { if(iabs(sq_s - sq_t) < 6) { f_temp = 1; } }
            if(cand == 4 || cand == 5) {
                let cmatch:i64 = 0;
                let cmin:i64 = sq_s;
                let cmax:i64 = sq_s;
                if(sq_t < cmin) { cmin = sq_t; }
                if(sq_t > cmax) { cmax = sq_t; }
                let hi2:i64 = 0;
                while(hi2 < hn) {
                    if(t_get64(ht, (hi2 as i32) * 8) == tcode
                       && t_get64(hj, (hi2 as i32) * 8) == jcode) {
                        let hseq:i64 = t_get64(hs, (hi2 as i32) * 8);
                        cmatch = cmatch + 1;
                        if(hseq < cmin) { cmin = hseq; }
                        if(hseq > cmax) { cmax = hseq; }
                    }
                    hi2 = hi2 + 1;
                }
                if(cand == 4) { if(cmax - cmin < 20) { f_temp = 1; } }
                if(cand == 5) { if(cmatch + 1 < 3) { f_temp = 1; } }
            }
            if(f_margin == 1 || f_span == 1 || f_temp == 1) {
                let vdet:[]u8 = "guard-veto:";
                let need_plus:i64 = 0;
                if(f_margin == 1) {
                    vdet = "guard-veto:margin"; need_plus = 1;
                }
                if(f_span == 1) {
                    if(need_plus == 1) { vdet = "guard-veto:margin+span"; }
                    else { vdet = "guard-veto:span"; need_plus = 1; }
                }
                if(f_temp == 1) {
                    if(need_plus == 1) {
                        if(f_margin == 1 && f_span == 1) {
                            vdet = "guard-veto:margin+span+temporal";
                        } else {
                            if(f_margin == 1) { vdet = "guard-veto:margin+temporal"; }
                            else { vdet = "guard-veto:span+temporal"; }
                        }
                    } else {
                        vdet = "guard-veto:temporal";
                    }
                }
                if(is_rev == 1) { disp = 4; } else { disp = 1; }
                detail = vdet;
            } else {
                disp = -2; detail = "guard-allow";
            }
        }
        // ---- HARDENING (H6 R1-R4) on allowed proposals ----
        if(disp == -2) {
            let ok:i64 = 1;
            let hr:[]u8 = "harden-ok";
            // R1: prog gate
            if(tf(tr, prop_s, 2) != 0 || tf(tr, prop_t, 2) != 0) {
                ok = 0; hr = "harden-r1";
            }
            // R2: attestation (both corroborators)
            if(ok == 1) {
                let s0:i64 = tf(tr, prop_s, 0);
                let f0:[]u8 = fx[tf(tr, prop_s, 12) as i32 .. (tf(tr, prop_s, 12) + tf(tr, prop_s, 13)) as i32];
                let g0:[]u8 = gt[(prop_s as i32) * 64 .. (prop_s as i32) * 64 + 64];
                let s1:i64 = tf(tr, prop_t, 0);
                let f1:[]u8 = fx[tf(tr, prop_t, 12) as i32 .. (tf(tr, prop_t, 12) + tf(tr, prop_t, 13)) as i32];
                let g1:[]u8 = gt[(prop_t as i32) * 64 .. (prop_t as i32) * 64 + 64];
                if(att_verify(s0, f0, tf(tr, prop_s, 13) as i32, tf(tr, prop_s, 8), tf(tr, prop_s, 9), g0) == 0) {
                    ok = 0; hr = "harden-r2";
                } else {
                    if(att_verify(s1, f1, tf(tr, prop_t, 13) as i32, tf(tr, prop_t, 8), tf(tr, prop_t, 9), g1) == 0) {
                        ok = 0; hr = "harden-r2";
                    }
                }
            }
            // R3: attested-agreement bar (both)
            if(ok == 1) {
                let c0:i64 = tf(tr, prop_s, 4);
                let j0:i64 = tf(tr, prop_s, 3);
                let g0j:i64 = tf(tr, prop_s, 8);
                let g0c:i64 = tf(tr, prop_s, 9);
                let c1:i64 = tf(tr, prop_t, 4);
                let j1:i64 = tf(tr, prop_t, 3);
                let g1j:i64 = tf(tr, prop_t, 8);
                let g1c:i64 = tf(tr, prop_t, 9);
                if(!(c0 >= 700 && g0j == j0 && g0c >= 700)) { ok = 0; hr = "harden-r3"; }
                else {
                    if(!(c1 >= 700 && g1j == j1 && g1c >= 700)) { ok = 0; hr = "harden-r3"; }
                }
            }
            // R4: revision-vs-permanent (only when a perm is installed)
            if(ok == 1 && is_rev == 1) {
                let pm:i64 = t_get64(perm, (tcode as i32) * 8);
                if(pm >= 0) {
                    let tj:i64 = tf(tr, prop_t, 3);
                    let tm:i64 = tf(tr, prop_t, 6);
                    let tc:i64 = tf(tr, prop_t, 1);
                    let corr:i64 = 0;
                    let hi:i64 = 0;
                    while(hi < hn) {
                        if(t_get64(ht, (hi as i32) * 8) == tc
                           && t_get64(hj, (hi as i32) * 8) == tj
                           && t_get64(hp, (hi as i32) * 8) == 0
                           && iabs(t_get64(hm, (hi as i32) * 8) - tm) <= tol) {
                            corr = 1;
                        }
                        hi = hi + 1;
                    }
                    let pmc:i64 = tf(tr, pm, 4);
                    let tic:i64 = tf(tr, prop_t, 4);
                    if(corr == 0 || tic - pmc < 100) { ok = 0; hr = "harden-r4"; }
                }
            }
            if(ok == 1) {
                t_put64(perm, (tcode as i32) * 8, prop_t);
                t_put64(prov, (tcode as i32) * 8, -1);
                t_put64(chal, (tcode as i32) * 8, -1);
                if(is_rev == 1) { disp = 5; } else { disp = 0; }
                detail = hr;
                install = 1;
            } else {
                disp = 7; detail = hr;
            }
        }
        // history append
        if(hn < 4096) {
            t_put64(ht, (hn as i32) * 8, tcode);
            t_put64(hj, (hn as i32) * 8, jcode);
            t_put64(hp, (hn as i32) * 8, prog);
            t_put64(hm, (hn as i32) * 8, meas);
            t_put64(hs, (hn as i32) * 8, seq);
            hn = hn + 1;
        }
        // output: R3|cand|stream|trial_idx|seq|disp|install|detail
        let p:i32 = 0;
        p = ob_add(out, p, "R3|");
        p = ob_add(out, p, cand_name(cand));
        p = ob_add(out, p, "|");
        p = ob_add(out, p, sname);
        p = ob_add(out, p, "|");
        p = ob_add(out, p, i64s(ti));
        p = ob_add(out, p, "|");
        p = ob_add(out, p, i64s(seq));
        p = ob_add(out, p, "|");
        p = ob_add(out, p, i64s(disp));
        p = ob_add(out, p, "|");
        p = ob_add(out, p, i64s(install));
        p = ob_add(out, p, "|");
        p = ob_add(out, p, detail);
        p = ob_add(out, p, "\n");
        _zag_print(out[0..p]);
        ti = ti + 1;
    }
    nio_free(prov); nio_free(perm); nio_free(chal);
    nio_free(ht); nio_free(hj); nio_free(hp); nio_free(hm); nio_free(hs);
    cand = cand + 1;
    }
    // tr/fx/gt are now const data (not allocated) — do not free
    nio_free(out);
    return;
}

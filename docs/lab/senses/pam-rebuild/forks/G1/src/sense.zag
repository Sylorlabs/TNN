// sense.zag — FORK G1: Symmetry Group Percept (SGP) for the TNN PAM rebuild.
//
// One idea: distill each input to its symmetry group — minimal generators +
// fixed points — as a 512-bit canonical bitstring, and let a single memory
// contract (install iff the percept matches the class anchor's canonical
// form within 1% Hamming variance, else WITHHOLD; retrieval by projection
// onto group alignment) govern all install/withhold decisions.
//
// Percept layout (512 bits = 64 bytes), canonicalized per logical block:
//   pair tasks (colordisc, colorconst, pitchdisc): bytes 0-15 = 16 generator
//     codes of field A, 16-31 = 8 coords of A (u16 LE), 32-47 = codes of B,
//     48-63 = coords of B.
//   single tasks (shapetrans, timbredisc, motiondir): bytes 0-31 = 32 codes,
//     bytes 32-63 = 16 coords (u16 LE).
// Generator codes: 0 empty, 1 identity, 2 REFL_V, 3 REFL_H, 4 REFL_D,
//   5 ROT_180, 6 ROT_90, 7 ROT_120, 8 ROT_FULL, 9 UNIFORM, 10 PAIR_MATCH,
//   11 ILLUM_INV, 12 STILL, 16+q PERIOD_q, 32+d MOTDIR_d, 48+s SPECT_s,
//   64+c CHROMA_c, 80+l LUMA_l.
// Canonical form: codes sorted ascending, deduped, zero-padded; coords
// sorted ascending as u16, zero-padded. 1%-variance rule: Hamming bits <=
// floor(bits/100): <=5 over 512 bits (contract), <=2 over 256 (pair SAME).
//
// CLI: sense <task> <fixture> [ledger]
// stdout keys: approach=G1 task= judgment= confidence= ops= percept=
//   disposition= variance= anchor= ledger_hash=
// The ledger is a hash-chained append-only record of contract decisions:
//   <core fields> hash=<sha256hex(core + "\n")>
// with prev-hash chaining (genesis prev = 64 zeros).
//
// Pure Zag, integer arithmetic only. Zero RNG, zero wall-clock, zero
// uninitialized reads in any decision path: same binary + fixture + ledger
// state -> byte-identical stdout.
//
// znc constraints honored: no argc gate (_zag_arg read unconditionally),
// []u8 arenas + LE accessors only (no as []i32/[]u32/[]u16), _zag_strcmp==1
// on equality, no };, explicit init, no slice > 2^25 indexed, NUL paths via
// z_cstr, _zag_raw_syscall exactly 7 args, shallow else-nesting, return; in
// void fns.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}

// ---------------- ops counter --------------------------------------------
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- integer math -------------------------------------------
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
fn iclamp(v:i64, lo:i64, hi:i64) i64 {
    if(v < lo) { return lo; }
    if(v > hi) { return hi; }
    return v;
}
fn pop8(x:i64) i64 {
    let c:i64 = 0;
    let i:i32 = 0;
    while(i < 8) {
        if((x & 1) == 1) { c = c + 1; }
        x = x >> 1;
        i = i + 1;
    }
    return c;
}
// Hamming distance in bits over nbytes of a vs b.
fn ham_bits(a:[]u8, ao:i32, b:[]u8, bo:i32, nbytes:i32) i64 {
    let c:i64 = 0;
    let i:i32 = 0;
    while(i < nbytes) {
        c = c + pop8((a[ao+i] as i64) ^ (b[bo+i] as i64));
        i = i + 1;
    }
    return c;
}

// ---------------- file IO -------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// Append bytes to a file (O_WRONLY|O_CREAT|O_APPEND = 1089, mode 0600).
fn z_append(path:[]u8, data:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 1089, 384, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let w:i64 = nio_write_all(fd, data);
    nio_close(fd);
    return w;
}

// ---------------- stdout line builder ------------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn fail(task:[]u8, reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "G1");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "error", reason);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// ================= PERCEPT CORE: canonicalization ========================
// Insertion-sort codes ascending in place over [off, off+n).
fn canon_codes(p:[]u8, off:i32, n:i32) void {
    let i:i32 = 1;
    while(i < n) {
        let v:u8 = p[off+i];
        let j:i32 = i - 1;
        while(j >= 0 && p[off+j] > v) {
            p[off+j+1] = p[off+j];
            j = j - 1;
        }
        p[off+j+1] = v;
        i = i + 1;
    }
    // dedup: compact uniques to front, zero the tail
    let w:i32 = 0;
    i = 0;
    while(i < n) {
        let v:u8 = p[off+i];
        if(v != 0 && (w == 0 || p[off+w-1] != v)) {
            p[off+w] = v;
            w = w + 1;
        }
        i = i + 1;
    }
    while(w < n) { p[off+w] = 0; w = w + 1; }
}
// Insertion-sort u16 coords ascending over n values at [off, off+2n).
fn canon_coords(p:[]u8, off:i32, n:i32) void {
    let i:i32 = 1;
    while(i < n) {
        let v:i64 = t_get16(p, off + 2*i);
        let j:i32 = i - 1;
        while(j >= 0 && t_get16(p, off + 2*j) > v) {
            t_put16(p, off + 2*(j+1), t_get16(p, off + 2*j));
            j = j - 1;
        }
        t_put16(p, off + 2*(j+1), v);
        i = i + 1;
    }
}
// Collect one generator code into the code block (first empty slot).
fn g_add(p:[]u8, off:i32, n:i32, code:i64) void {
    let i:i32 = 0;
    while(i < n) {
        if(p[off+i] == 0) {
            p[off+i] = (code & 255) as u8;
            return;
        }
        i = i + 1;
    }
}
fn has_code(p:[]u8, off:i32, n:i32, code:i64) i32 {
    let i:i32 = 0;
    while(i < n) {
        if((p[off+i] as i64) == code) { return 1; }
        i = i + 1;
    }
    return 0;
}
// Zero a percept buffer.
fn p_zero(p:[]u8) void {
    let i:i32 = 0;
    while(i < p.len) { p[i] = 0; i = i + 1; }
}

// ---------------- hex helpers --------------------------------------------
// Parse 128 hex chars at hx[0..128) into 64 bytes at out.
fn hex_to_bytes(hx:[]u8, out:[]u8) i32 {
    if(hx.len < 128 || out.len < 64) { return -1; }
    let i:i32 = 0;
    while(i < 64) {
        let a:i64 = hexval(hx[2*i]);
        let b:i64 = hexval(hx[2*i+1]);
        if(a < 0 || b < 0) { return -1; }
        out[i] = ((a * 16 + b) & 255) as u8;
        i = i + 1;
    }
    return 0;
}
fn hexval(c:u8) i64 {
    if(c >= 48 && c <= 57) { return (c as i64) - 48; }
    if(c >= 97 && c <= 102) { return (c as i64) - 87; }
    if(c >= 65 && c <= 70) { return (c as i64) - 55; }
    return -1;
}

// ================= LEDGER =================================================
// Entry core format (no trailing hash):
//   seq=<n> task=<t> fixture=<base> percept=<128hex> judgment=<j>
//   confidence=<c> disposition=<d> anchor=<a> prev=<64hex>
// Stored line = core + " hash=<64hex>\n"; hash = sha256hex(core + "\n").
// Genesis prev = 64 zeros.
//
// Scan the ledger bytes for the FIRST entry with task==T, judgment==J and
// disposition==INSTALL. Returns its seq, or -1; anchor percept -> anc_out.
fn ledger_find_anchor(led:[]u8, ledn:i32, task:[]u8, judg:[]u8, anc_out:[]u8) i64 {
    let pos:i32 = 0;
    while(pos < ledn) {
        let eol:i32 = pos;
        while(eol < ledn && led[eol] != 10) { eol = eol + 1; }
        // line = led[pos..eol)
        let f_task:[]u8 = kv_scan(led, pos, eol, " task=");
        let f_judg:[]u8 = kv_scan(led, pos, eol, " judgment=");
        let f_disp:[]u8 = kv_scan(led, pos, eol, " disposition=");
        if(f_task.len > 0 && f_judg.len > 0 && f_disp.len > 0) {
            if(nio_equal(f_task, task) == 1 && nio_equal(f_judg, judg) == 1
               && nio_equal(f_disp, "INSTALL") == 1) {
                let f_perc:[]u8 = kv_scan(led, pos, eol, " percept=");
                let f_seq:[]u8 = kv_scan(led, pos, eol, "seq=");
                if(f_perc.len == 128 && f_seq.len > 0) {
                    if(hex_to_bytes(f_perc, anc_out) == 0) {
                        return kv_atoi(f_seq);
                    }
                }
            }
        }
        pos = eol + 1;
    }
    return -1;
}
// Scan line [lo,hi) for " key=" and return the value slice (up to next
// space or hi). Returns empty slice when absent. "seq=" has no leading space.
fn kv_scan(led:[]u8, lo:i32, hi:i32, key:[]u8) []u8 {
    let p:i32 = lo;
    while(p + key.len <= hi) {
        let m:i32 = 1;
        let k:i32 = 0;
        while(k < key.len) {
            if(led[p+k] != key[k]) { m = 0; }
            k = k + 1;
        }
        if(m == 1) {
            let vs:i32 = p + key.len;
            let ve:i32 = vs;
            while(ve < hi && led[ve] != 32) { ve = ve + 1; }
            return led[vs..ve];
        }
        p = p + 1;
    }
    return led[lo..lo];
}
fn kv_atoi(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < s.len && s[i] >= 48 && s[i] <= 57) {
        v = v * 10 + ((s[i] as i64) - 48);
        i = i + 1;
    }
    return v;
}
// Count entries (lines) and fetch the last entry's hash (64 hex) for prev.
fn ledger_tail(led:[]u8, ledn:i32, prev_out:[]u8) i64 {
    let n:i64 = 0;
    let pos:i32 = 0;
    let last:i32 = -1;
    while(pos < ledn) {
        let eol:i32 = pos;
        while(eol < ledn && led[eol] != 10) { eol = eol + 1; }
        if(eol > pos) { n = n + 1; last = pos; }
        pos = eol + 1;
    }
    // default genesis prev: 64 zeros
    let i:i32 = 0;
    while(i < 64) { prev_out[i] = 48; i = i + 1; }
    if(last >= 0) {
        let eol:i32 = last;
        while(eol < ledn && led[eol] != 10) { eol = eol + 1; }
        let fh:[]u8 = kv_scan(led, last, eol, " hash=");
        if(fh.len == 64) {
            i = 0;
            while(i < 64) { prev_out[i] = fh[i]; i = i + 1; }
        }
    }
    return n;
}
// Basename of a path (after last '/').
fn base_name(path:[]u8) []u8 {
    let i:i32 = path.len - 1;
    while(i >= 0) {
        if(path[i] == 47) { return path[i+1..path.len]; }
        i = i - 1;
    }
    return path;
}

// Ledger line builder: space-separated core + hash.
// core = "seq=<n> task=<t> fixture=<base> percept=<128hex> judgment=<j>
//         confidence=<c> disposition=<d> anchor=<a> prev=<64hex>"
// hash = sha256hex(core + "\n"); stored line = core + " hash=<hash>\n".
// Returns bytes written, or negative on error.
fn ledger_build_line(lb:[]u8, seq:i64, task:[]u8, fxbase:[]u8, perchex:[]u8,
                     judg:[]u8, conf:i64, disp:[]u8, aseq:i64,
                     prev:[]u8) i32 {
    let p:i32 = 0;
    p = ob_add(lb, p, "seq="); p = ob_add(lb, p, _zag_i64_to_str(seq));
    p = ob_add(lb, p, " task="); p = ob_add(lb, p, task);
    p = ob_add(lb, p, " fixture="); p = ob_add(lb, p, fxbase);
    p = ob_add(lb, p, " percept="); p = ob_add(lb, p, perchex);
    p = ob_add(lb, p, " judgment="); p = ob_add(lb, p, judg);
    p = ob_add(lb, p, " confidence="); p = ob_add(lb, p, _zag_i64_to_str(conf));
    p = ob_add(lb, p, " disposition="); p = ob_add(lb, p, disp);
    p = ob_add(lb, p, " anchor="); p = ob_add(lb, p, _zag_i64_to_str(aseq));
    p = ob_add(lb, p, " prev="); p = ob_add(lb, p, prev);
    if(p + 80 > lb.len) { return -1; }
    // hash over (core + "\n")
    let hb:[]u8 = nio_alloc(p + 1);
    if(hb.len == 0) { return -1; }
    let i:i32 = 0;
    while(i < p) { hb[i] = lb[i]; i = i + 1; }
    hb[p] = 10;
    let dg:[]u8 = nio_alloc(32);
    if(dg.len == 0) { nio_free(hb); return -1; }
    if(ns_sha256(hb, dg) != 0) { nio_free(hb); nio_free(dg); return -1; }
    let hx:[]u8 = ns_hex(dg);
    nio_free(hb); nio_free(dg);
    if(hx.len != 64) { return -1; }
    p = ob_add(lb, p, " hash="); p = ob_add(lb, p, hx); p = ob_add(lb, p, "\n");
    return p;
}

// ================= MEMORY CONTRACT (executable) ===========================
// Applies the frozen contract: install the anchor state iff the incoming
// percept matches the class anchor's canonical form within 1% Hamming
// variance (<= 5 bits over 512); else WITHHOLD. Anchors are immutable:
// the first INSTALLed percept of each (task, judgment) class.
// ledger_on == 0 (no ledger path): genesis mode — INSTALL, anchor=-1,
// no ledger IO. Outputs: disp_out ("INSTALL"/"WITHHOLD" + NUL pad),
// var_out, anch_out, hash_out (64 hex or "none"). Returns 0 or negative.
fn contract_apply(task:[]u8, fxpath:[]u8, perc:[]u8, judg:[]u8, conf:i64,
                  led:[]u8, ledn:i32, ledger_on:i32, ledpath:[]u8,
                  disp_out:[]u8, var_out:[]u8, anch_out:[]u8, hash_out:[]u8) i32 {
    let anc:[]u8 = nio_alloc(64);
    if(anc.len == 0) { return -1; }
    let aseq:i64 = -1;
    let disp:[]u8 = "INSTALL";
    let v:i64 = 0;
    if(ledger_on == 1) {
        aseq = ledger_find_anchor(led, ledn, task, judg, anc);
        if(aseq >= 0) {
            v = ham_bits(perc, 0, anc, 0, 64);
            if(v > 5) { disp = "WITHHOLD"; }
        }
    }
    nio_free(anc);
    let i:i32 = 0;
    while(i < disp.len && i < disp_out.len) { disp_out[i] = disp[i]; i = i + 1; }
    let vs:[]u8 = _zag_i64_to_str(v);
    i = 0;
    while(i < vs.len && i < var_out.len) { var_out[i] = vs[i]; i = i + 1; }
    let as2:[]u8 = _zag_i64_to_str(aseq);
    i = 0;
    while(i < as2.len && i < anch_out.len) { anch_out[i] = as2[i]; i = i + 1; }
    if(ledger_on == 0) {
        let nh:[]u8 = "none";
        i = 0;
        while(i < nh.len && i < hash_out.len) { hash_out[i] = nh[i]; i = i + 1; }
        return 0;
    }
    // ledger append path
    let prev:[]u8 = nio_alloc(64);
    if(prev.len == 0) { return -1; }
    let seq:i64 = ledger_tail(led, ledn, prev);
    let perchex:[]u8 = ns_hex(perc);
    if(perchex.len != 128) { nio_free(prev); return -1; }
    let lb:[]u8 = nio_alloc(2048);
    if(lb.len == 0) { nio_free(prev); return -1; }
    let fxbase:[]u8 = base_name(fxpath);
    let lp:i32 = ledger_build_line(lb, seq, task, fxbase, perchex, judg, conf,
                                   disp, aseq, prev);
    nio_free(prev);
    if(lp < 0) { nio_free(lb); return -1; }
    if(z_append(ledpath, lb[0..lp]) != lp as i64) { nio_free(lb); return -1; }
    // extract the hash we just wrote (after " hash=")
    let hp:i32 = 0;
    while(hp + 70 <= lp) {
        if(lb[hp] == 104 && lb[hp+1] == 97 && lb[hp+2] == 115 && lb[hp+3] == 104
           && lb[hp+4] == 61) {
            i = 0;
            while(i < 64 && i < hash_out.len) { hash_out[i] = lb[hp+5+i]; i = i + 1; }
            nio_free(lb);
            return 0;
        }
        hp = hp + 1;
    }
    nio_free(lb);
    return -1;
}

// ================= TASK 1: colordisc =====================================
// Two uniform patches. SGP: per-half symmetry signature {IDENTITY, UNIFORM,
// CHROMA_c, LUMA_l} (+PAIR_MATCH when the halves coincide). SAME iff the two
// 256-bit sub-percepts match within 1% Hamming (<= 2 bits).
// Returns 0=SAME, 1=DIFFERENT; confidence -> cf[0..8).
fn task_colordisc(buf:[]u8, n:i32, op:[]u8, perc:[]u8, cf:[]u8) i64 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 2 || h < 1 || w > 4096 || h > 4096) { return -1; }
    if((w % 2) == 1) { return -1; }
    if(8 + (w as i64) * (h as i64) * 3 > n as i64) { return -1; }
    let hw:i32 = w / 2;
    let half:i32 = 0;
    while(half < 2) {
        let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
        let mn:i64 = 765; let mx:i64 = 0;
        let y:i32 = 0;
        while(y < h) {
            let x:i32 = 0;
            while(x < hw) {
                let o:i32 = 8 + (y * w + half * hw + x) * 3;
                let r:i64 = buf[o] as i64;
                let g:i64 = buf[o+1] as i64;
                let b:i64 = buf[o+2] as i64;
                sr = sr + r; sg = sg + g; sb = sb + b;
                let lum:i64 = r + g + b;
                if(lum < mn) { mn = lum; }
                if(lum > mx) { mx = lum; }
                x = x + 1;
            }
            y = y + 1;
        }
        let np:i64 = (hw as i64) * (h as i64);
        op_add(op, 2 * np);
        let mr:i64 = sr / np; let mg:i64 = sg / np; let mb:i64 = sb / np;
        let co:i32 = half * 32;
        g_add(perc, co, 16, 1);
        if(mx - mn < 72) { g_add(perc, co, 16, 9); }
        g_add(perc, co, 16, 64 + chroma_code(mr, mg, mb));
        g_add(perc, co, 16, 80 + (mr + mg + mb) * 15 / 765);
        t_put16(perc, co + 16, (hw / 2 + half * hw) as i64);
        t_put16(perc, co + 18, (h / 2) as i64);
        half = half + 1;
    }
    canon_codes(perc, 0, 16); canon_coords(perc, 16, 8);
    canon_codes(perc, 32, 16); canon_coords(perc, 48, 8);
    let hb:i64 = ham_bits(perc, 0, perc, 32, 32);
    let ji:i64 = 1;
    if(hb <= 2) { ji = 0; }
    if(ji == 0) {
        g_add(perc, 0, 16, 10); g_add(perc, 32, 16, 10);
        canon_codes(perc, 0, 16); canon_codes(perc, 32, 16);
    }
    let mgg:i64 = iabs(hb - 2);
    t_put64(cf, 0, 1000 * mgg / (mgg + 1));
    return ji;
}
// Chroma bucket 0..15 from mean rgb. 0 = achromatic; else dominant-channel
// sector: 1 + ((dom*64 + 64*sec/(mx+1)) * 15) / 192.
fn chroma_code(r:i64, g:i64, b:i64) i64 {
    let mx:i64 = r;
    if(g > mx) { mx = g; }
    if(b > mx) { mx = b; }
    let mn:i64 = r;
    if(g < mn) { mn = g; }
    if(b < mn) { mn = b; }
    if(mx - mn < 16 || mx < 8) { return 0; }
    let dom:i64 = 0;
    if(g > r && g >= b) { dom = 1; }
    if(b > r && b > g) { dom = 2; }
    let sec:i64 = r;
    if(dom == 0) {
        if(g > b) { sec = g; } else { sec = b; }
    }
    if(dom == 1) {
        if(r > b) { sec = r; } else { sec = b; }
    }
    if(dom == 2) {
        if(r > g) { sec = r; } else { sec = g; }
    }
    return 1 + ((dom * 64 + 64 * sec / (mx + 1)) * 15) / 192;
}

// ================= TASK 2: colorconst ====================================
// Two panels under possibly different illuminants. SGP: per-panel
// {IDENTITY, UNIFORM?, CHROMA_c, LUMA_l} from von-Kries-discounted means,
// plus ILLUM_INV when white-patch and gray-world normalizations agree
// (the surface estimate is illuminant-invariant). SAME_SURFACE iff the
// sub-percepts match within 1% Hamming.
// Returns 0=SAME_SURFACE, 1=DIFFERENT; confidence -> cf.
fn task_colorconst(buf:[]u8, n:i32, op:[]u8, perc:[]u8, cf:[]u8) i64 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 2 || h < 1 || w > 4096 || h > 4096) { return -1; }
    if((w % 2) == 1) { return -1; }
    if(8 + (w as i64) * (h as i64) * 3 > n as i64) { return -1; }
    let hw:i32 = w / 2;
    let half:i32 = 0;
    while(half < 2) {
        let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
        let xr:i64 = 0; let xg:i64 = 0; let xb:i64 = 0;
        let mn:i64 = 765; let mx:i64 = 0;
        let y:i32 = 0;
        while(y < h) {
            let x:i32 = 0;
            while(x < hw) {
                let o:i32 = 8 + (y * w + half * hw + x) * 3;
                let r:i64 = buf[o] as i64;
                let g:i64 = buf[o+1] as i64;
                let b:i64 = buf[o+2] as i64;
                sr = sr + r; sg = sg + g; sb = sb + b;
                if(r > xr) { xr = r; }
                if(g > xg) { xg = g; }
                if(b > xb) { xb = b; }
                let lum:i64 = r + g + b;
                if(lum < mn) { mn = lum; }
                if(lum > mx) { mx = lum; }
                x = x + 1;
            }
            y = y + 1;
        }
        let np:i64 = (hw as i64) * (h as i64);
        op_add(op, 2 * np);
        // von Kries: discounted mean, per-mille
        let n1r:i64 = 0; let n1g:i64 = 0; let n1b:i64 = 0;
        if(xr > 0) { n1r = sr * 1000 / (np * xr); }
        if(xg > 0) { n1g = sg * 1000 / (np * xg); }
        if(xb > 0) { n1b = sb * 1000 / (np * xb); }
        // gray-world normalization for the stability test
        let tot:i64 = sr + sg + sb;
        let g1r:i64 = sr * 1000 / (tot + 1);
        let g1g:i64 = sg * 1000 / (tot + 1);
        let g1b:i64 = sb * 1000 / (tot + 1);
        let co:i32 = half * 32;
        g_add(perc, co, 16, 1);
        if(mx - mn < 72) { g_add(perc, co, 16, 9); }
        let cw:i64 = chroma_code(n1r, n1g, n1b);
        g_add(perc, co, 16, 64 + cw);
        if(chroma_code(g1r, g1g, g1b) == cw) { g_add(perc, co, 16, 11); }
        g_add(perc, co, 16, 80 + (n1r + n1g + n1b) * 15 / 3000);
        t_put16(perc, co + 16, (hw / 2 + half * hw) as i64);
        t_put16(perc, co + 18, (h / 2) as i64);
        half = half + 1;
    }
    canon_codes(perc, 0, 16); canon_coords(perc, 16, 8);
    canon_codes(perc, 32, 16); canon_coords(perc, 48, 8);
    let hb:i64 = ham_bits(perc, 0, perc, 32, 32);
    let ji:i64 = 1;
    if(hb <= 2) { ji = 0; }
    if(ji == 0) {
        g_add(perc, 0, 16, 10); g_add(perc, 32, 16, 10);
        canon_codes(perc, 0, 16); canon_codes(perc, 32, 16);
    }
    let mgg:i64 = iabs(hb - 2);
    t_put64(cf, 0, 1000 * mgg / (mgg + 1));
    return ji;
}

// ================= TASK 3: shapetrans ====================================
// One shape in frame. SGP: the shape's symmetry group, detected by fixed
// kernels — integer self-match scores under REFL_V / REFL_H / ROT_180 /
// ROT_90 / ROT_120 / ROT_60 about the shape centroid on a 48x48 mask.
// Circle -> ROT_FULL, square -> ROT_90, triangle -> ROT_120. Fixed points:
// centroid + bounding box. Returns 0=CIRCLE, 1=SQUARE, 2=TRIANGLE.
fn task_shapetrans(buf:[]u8, n:i32, op:[]u8, perc:[]u8, cf:[]u8) i64 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 4 || h < 4 || w > 4096 || h > 4096) { return -1; }
    let npx:i64 = (w as i64) * (h as i64);
    if(8 + npx * 3 > n as i64) { return -1; }
    let G:i32 = 48;
    let ds:[]u8 = nio_alloc(G * G);
    if(ds.len == 0) { return -1; }
    // 2x2-mean luminance downsample to 48x48 (assumes w,h even and >= 96;
    // general stride fallback below)
    let sx_step:i32 = w / G;
    let sy_step:i32 = h / G;
    if(sx_step < 1) { sx_step = 1; }
    if(sy_step < 1) { sy_step = 1; }
    let dy:i32 = 0;
    while(dy < G) {
        let dx:i32 = 0;
        while(dx < G) {
            let s:i64 = 0; let cnt:i64 = 0;
            let jy:i32 = 0;
            while(jy < sy_step) {
                let jx:i32 = 0;
                while(jx < sx_step) {
                    let px:i32 = dx * sx_step + jx;
                    let py:i32 = dy * sy_step + jy;
                    if(px < w && py < h) {
                        let o:i32 = 8 + (py * w + px) * 3;
                        s = s + (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
                        cnt = cnt + 1;
                    }
                    jx = jx + 1;
                }
                jy = jy + 1;
            }
            if(cnt > 0) { ds[dy * G + dx] = (s / (cnt * 3)) as u8; }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    op_add(op, (G as i64) * (G as i64) * (sx_step as i64) * (sy_step as i64));
    // mean + minority mask
    let tot:i64 = 0;
    let p:i32 = 0;
    while(p < G * G) { tot = tot + (ds[p] as i64); p = p + 1; }
    let mean:i64 = tot / ((G as i64) * (G as i64));
    let nbright:i64 = 0;
    p = 0;
    while(p < G * G) {
        if((ds[p] as i64) > mean) { nbright = nbright + 1; }
        p = p + 1;
    }
    op_add(op, 2 * (G as i64) * (G as i64));
    let bright_is_shape:i32 = 1;
    if(nbright * 2 > (G as i64) * (G as i64)) { bright_is_shape = 0; }
    let mk:[]u8 = nio_alloc(G * G);
    if(mk.len == 0) { nio_free(ds); return -1; }
    p = 0;
    while(p < G * G) {
        let b:i32 = 0;
        if((ds[p] as i64) > mean) { b = 1; }
        if(b == bright_is_shape) { mk[p] = 1; }
        p = p + 1;
    }
    nio_free(ds);
    // centroid + bbox of mask
    let nm:i64 = 0; let sumx:i64 = 0; let sumy:i64 = 0;
    let x0:i64 = G as i64; let y0:i64 = G as i64;
    let x1:i64 = -1; let y1:i64 = -1;
    let yy:i32 = 0;
    while(yy < G) {
        let xx:i32 = 0;
        while(xx < G) {
            if(mk[yy * G + xx] == 1) {
                nm = nm + 1;
                sumx = sumx + (xx as i64); sumy = sumy + (yy as i64);
                if((xx as i64) < x0) { x0 = xx as i64; }
                if((yy as i64) < y0) { y0 = yy as i64; }
                if((xx as i64) > x1) { x1 = xx as i64; }
                if((yy as i64) > y1) { y1 = yy as i64; }
            }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    op_add(op, (G as i64) * (G as i64));
    let ji:i64 = 0;
    let swin:i64 = 0; // winner symmetry score (for confidence)
    if(nm < 16 || nm * 2 > (G as i64) * (G as i64)) {
        // degenerate: uniform field has every symmetry
        g_add(perc, 0, 32, 1); g_add(perc, 0, 32, 2); g_add(perc, 0, 32, 3);
        g_add(perc, 0, 32, 4); g_add(perc, 0, 32, 5); g_add(perc, 0, 32, 6);
        g_add(perc, 0, 32, 7); g_add(perc, 0, 32, 8); g_add(perc, 0, 32, 9);
        ji = 0; swin = 1000;
    } else {
        let cx:i64 = sumx / nm; let cy:i64 = sumy / nm;
        let s_rv:i64 = sym_score(mk, G, cx, cy, 0, op);
        let s_rh:i64 = sym_score(mk, G, cx, cy, 1, op);
        let s_r180:i64 = sym_score(mk, G, cx, cy, 2, op);
        let s_r90:i64 = sym_score(mk, G, cx, cy, 3, op);
        let s_r60:i64 = sym_score(mk, G, cx, cy, 4, op);
        let s_r120:i64 = sym_score(mk, G, cx, cy, 5, op);
        g_add(perc, 0, 32, 1);
        if(s_rv >= 850) { g_add(perc, 0, 32, 2); }
        if(s_rh >= 850) { g_add(perc, 0, 32, 3); }
        if(s_r180 >= 850) { g_add(perc, 0, 32, 5); }
        if(s_r90 >= 850) { g_add(perc, 0, 32, 6); }
        if(s_r120 >= 850) { g_add(perc, 0, 32, 7); }
        let s_full:i64 = (s_r60 + s_r120 + s_r90 + s_r180) / 4;
        if(s_full >= 880) { g_add(perc, 0, 32, 8); }
        if(has_code(perc, 0, 32, 8) == 1) { ji = 0; swin = s_full; }
        if(has_code(perc, 0, 32, 8) == 0 && has_code(perc, 0, 32, 6) == 1) {
            ji = 1; swin = s_r90;
        }
        if(has_code(perc, 0, 32, 8) == 0 && has_code(perc, 0, 32, 6) == 0
           && has_code(perc, 0, 32, 7) == 1) {
            ji = 2; swin = s_r120;
        }
        if(has_code(perc, 0, 32, 8) == 0 && has_code(perc, 0, 32, 6) == 0
           && has_code(perc, 0, 32, 7) == 0) {
            // fallback: nearest generator-set by score
            ji = 0; swin = s_full;
            if(s_r90 >= s_full && s_r90 >= s_r120) { ji = 1; swin = s_r90; }
            if(s_r120 > s_full && s_r120 > s_r90) { ji = 2; swin = s_r120; }
        }
        t_put16(perc, 32, cx); t_put16(perc, 34, cy);
        t_put16(perc, 36, x0); t_put16(perc, 38, y0);
        t_put16(perc, 40, x1); t_put16(perc, 42, y1);
    }
    nio_free(mk);
    canon_codes(perc, 0, 32);
    canon_coords(perc, 32, 16);
    let mgg:i64 = iabs(swin - 850);
    t_put64(cf, 0, 1000 * mgg / (mgg + 40));
    return ji;
}
// Integer division by 1000 with round-half-away-from-zero.
fn rdiv1000(v:i64) i64 {
    if(v >= 0) { return (v + 500) / 1000; }
    return (v - 500) / 1000;
}
// Self-match score (per-mille) of a 48x48 binary mask under transform t
// about (cx,cy): 0 REFL_V, 1 REFL_H, 2 ROT_180, 3 ROT_90, 4 ROT_60,
// 5 ROT_120. Rotations use integer per-mille trig about the centroid.
fn sym_score(mk:[]u8, G:i32, cx:i64, cy:i64, t:i32, op:[]u8) i64 {
    let match:i64 = 0;
    let den:i64 = 0;
    let y:i32 = 0;
    while(y < G) {
        let x:i32 = 0;
        while(x < G) {
            let sx:i64 = 0; let sy:i64 = 0;
            let dx:i64 = (x as i64) - cx; let dy:i64 = (y as i64) - cy;
            if(t == 0) { sx = 2 * cx - (x as i64); sy = y as i64; }
            if(t == 1) { sx = x as i64; sy = 2 * cy - (y as i64); }
            if(t == 2) { sx = 2 * cx - (x as i64); sy = 2 * cy - (y as i64); }
            if(t == 3) { sx = cx - dy; sy = cy + dx; }
            if(t == 4) {
                sx = cx + rdiv1000(dx * 500 - dy * 866);
                sy = cy + rdiv1000(dx * 866 + dy * 500);
            }
            if(t == 5) {
                sx = cx + rdiv1000(dx * -500 - dy * 866);
                sy = cy + rdiv1000(dx * 866 + dy * -500);
            }
            let sv:i64 = 0;
            if(sx >= 0 && sx < G as i64 && sy >= 0 && sy < G as i64) {
                sv = mk[(sy * (G as i64) + sx) as i32] as i64;
            }
            let a:i64 = mk[y * G + x] as i64;
            if(a == 1 || sv == 1) {
                den = den + 1;
                if(a == 1 && sv == 1) { match = match + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, (G as i64) * (G as i64));
    if(den == 0) { return 0; }
    return 1000 * match / den;
}

// ================= AUDIO: shared period estimator ========================
// Integer autocorrelation period estimator. buf[bo..] holds i16 LE samples.
// Returns the period in 1/16-sample units, or 0 on failure. Octave guard:
// smallest lag reaching 90% of max correlation; parabolic refinement.
fn acorr(buf:[]u8, bo:i32, n:i32, lag:i32) i64 {
    let c:i64 = 0;
    let i:i32 = 0;
    while(i < n) {
        c = c + t_geti16(buf, bo + 2 * i) * t_geti16(buf, bo + 2 * (i + lag));
        i = i + 1;
    }
    return c;
}
fn estimate_period(buf:[]u8, bo:i32, cnt:i32, rate:i32, op:[]u8) i64 {
    let nwin:i32 = cnt;
    if(nwin > 4000) { nwin = 4000; }
    let lomin:i32 = rate / 2000;
    if(lomin < 4) { lomin = 4; }
    let lomax:i32 = rate / 50;
    let n2:i32 = nwin - lomax;
    if(n2 < 64) { return 0; }
    let best:i64 = 0;
    let lag:i32 = lomin;
    while(lag <= lomax) {
        let c:i64 = acorr(buf, bo, n2, lag);
        if(c > best) { best = c; }
        lag = lag + 1;
    }
    op_add(op, ((lomax - lomin + 1) as i64) * (n2 as i64));
    if(best <= 0) { return 0; }
    let pl:i32 = lomax;
    lag = lomin;
    while(lag <= lomax) {
        let c:i64 = acorr(buf, bo, n2, lag);
        if(c * 10 >= best * 9) { pl = lag; lag = lomax + 1; }
        lag = lag + 1;
    }
    op_add(op, ((pl - lomin + 1) as i64) * (n2 as i64));
    let p16:i64 = (pl as i64) * 16;
    if(pl > lomin && pl < lomax) {
        let cm:i64 = acorr(buf, bo, n2, pl - 1);
        let c0:i64 = acorr(buf, bo, n2, pl);
        let cp:i64 = acorr(buf, bo, n2, pl + 1);
        op_add(op, 3 * (n2 as i64));
        let den:i64 = cm - 2 * c0 + cp;
        if(den < 0) {
            let num:i64 = cm - cp;
            let frac:i64 = 16 * num / den;
            if(frac > 8) { frac = 8; }
            if(frac < -8) { frac = -8; }
            p16 = p16 + frac;
        }
    }
    return p16;
}
// First upward zero-crossing index in the first nwin samples (for phase).
fn zero_phase(buf:[]u8, bo:i32, cnt:i32) i64 {
    let nwin:i32 = cnt;
    if(nwin > 4000) { nwin = 4000; }
    let prev:i64 = t_geti16(buf, bo);
    let i:i32 = 1;
    while(i < nwin) {
        let v:i64 = t_geti16(buf, bo + 2 * i);
        if(prev <= 0 && v > 0) { return i as i64; }
        prev = v;
        i = i + 1;
    }
    return 0;
}

// ================= TASK 4: pitchdisc =====================================
// Two sequential tones. SGP: per-tone {IDENTITY, PERIOD_q} + fixed-point
// coords {period_q16, phase}. The translation symmetry of the periodic
// waveform is the group; SAME iff the periods coincide within 0.5%.
// Returns 0=SAME, 1=HIGHER, 2=LOWER.
fn task_pitchdisc(buf:[]u8, n:i32, op:[]u8, perc:[]u8, cf:[]u8) i64 {
    let rate:i32 = t_get32(buf, 0) as i32;
    let count:i32 = t_get32(buf, 4) as i32;
    if(rate < 4000 || rate > 96000) { return -1; }
    if(count < 8000 || (count % 2) == 1) { return -1; }
    if(8 + (count as i64) * 2 > n as i64) { return -1; }
    let half:i32 = count / 2;
    let p16a:i64 = estimate_period(buf, 8, half, rate, op);
    let p16b:i64 = estimate_period(buf, 8 + half * 2, half, rate, op);
    if(p16a <= 0 || p16b <= 0) { return -1; }
    let tone:i32 = 0;
    while(tone < 2) {
        let p16:i64 = p16a;
        let bo:i32 = 8;
        if(tone == 1) { p16 = p16b; bo = 8 + half * 2; }
        let q:i64 = iclamp((p16 >> 4) >> 2, 0, 15);
        let co:i32 = tone * 32;
        g_add(perc, co, 16, 1);
        g_add(perc, co, 16, 16 + q);
        t_put16(perc, co + 16, p16);
        t_put16(perc, co + 18, zero_phase(buf, bo, half));
        tone = tone + 1;
    }
    canon_codes(perc, 0, 16); canon_coords(perc, 16, 8);
    canon_codes(perc, 32, 16); canon_coords(perc, 48, 8);
    let rel:i64 = iabs(p16b - p16a) * 1000000 / p16a;
    let ji:i64 = 0;
    if(rel >= 5000) {
        ji = 2;
        if(p16b < p16a) { ji = 1; }
    }
    if(ji == 0) {
        g_add(perc, 0, 16, 10); g_add(perc, 32, 16, 10);
        canon_codes(perc, 0, 16); canon_codes(perc, 32, 16);
    }
    let mgg:i64 = iabs(rel - 5000);
    t_put64(cf, 0, 1000 * mgg / (mgg + 2000));
    return ji;
}

// ================= TASK 5: timbredisc ====================================
// One 440 Hz tone. SGP: {IDENTITY, PERIOD_q, SPECT_s} — the spectral
// self-similarity class is the symmetry signature. Brightness feature:
// first-difference energy ratio normalized by f0 (pure integer):
//   a = 1000*sum(dx^2)/sum(x^2); b = SR*10^9/(6283185*f0_hz);
//   q = a*b*b/10^12  (theory x1000: PURE 1000, DARK 1480, RICH 4130,
//   BRIGHT 11230). Returns 0=PURE, 1=DARK, 2=RICH, 3=BRIGHT.
fn task_timbredisc(buf:[]u8, n:i32, op:[]u8, perc:[]u8, cf:[]u8) i64 {
    let rate:i32 = t_get32(buf, 0) as i32;
    let count:i32 = t_get32(buf, 4) as i32;
    if(rate < 4000 || rate > 96000) { return -1; }
    if(count < 9000) { return -1; }
    if(8 + (count as i64) * 2 > n as i64) { return -1; }
    let wn:i32 = 8192;
    let woff:i32 = 8 + (count / 2 - wn / 2) * 2;
    let p16:i64 = estimate_period(buf, woff, wn, rate, op);
    if(p16 <= 0) { return -1; }
    let f0:i64 = 16 * (rate as i64) / p16;
    if(f0 < 50 || f0 > 2000) { return -1; }
    let sx2:i64 = 0; let sdx2:i64 = 0;
    let prev:i64 = t_geti16(buf, woff);
    let i:i32 = 1;
    while(i < wn) {
        let v:i64 = t_geti16(buf, woff + 2 * i);
        sx2 = sx2 + v * v;
        let dx:i64 = v - prev;
        sdx2 = sdx2 + dx * dx;
        prev = v;
        i = i + 1;
    }
    op_add(op, 2 * (wn as i64));
    if(sx2 <= 0) { return -1; }
    let a:i64 = 1000 * sdx2 / sx2;
    let b:i64 = (rate as i64) * 1000000000 / (6283185 * f0);
    // b is the 1000x scale of SR/(2*pi*f0); q = a*(b/1000)^2 = a*b*b/10^6.
    let q:i64 = a * b * b / 1000000;
    let s:i64 = iclamp(q / 500, 0, 15);
    g_add(perc, 0, 32, 1);
    g_add(perc, 0, 32, 16 + iclamp((p16 >> 4) >> 2, 0, 15));
    g_add(perc, 0, 32, 48 + s);
    t_put16(perc, 32, p16);
    t_put16(perc, 34, iclamp(q, 0, 65535));
    // harmonic self-similarity anchors: square-wave correlation per h=1..6
    let ax:i64 = 0;
    i = 0;
    while(i < wn) {
        ax = ax + iabs(t_geti16(buf, woff + 2 * i));
        i = i + 1;
    }
    op_add(op, wn as i64);
    let hh:i32 = 1;
    while(hh <= 6) {
        let e:i64 = 0;
        i = 0;
        while(i < wn) {
            let ph:i64 = ((i as i64) * 16 * (hh as i64)) % p16;
            let sgn:i64 = 1;
            if(ph * 2 >= p16) { sgn = -1; }
            e = e + t_geti16(buf, woff + 2 * i) * sgn;
            i = i + 1;
        }
        op_add(op, wn as i64);
        let em:i64 = 0;
        if(ax > 0) { em = 1000 * iabs(e) / ax; }
        t_put16(perc, 36 + 2 * (hh - 1), iclamp(em, 0, 65535));
        hh = hh + 1;
    }
    canon_codes(perc, 0, 32);
    canon_coords(perc, 32, 16);
    // frozen boundaries
    let ji:i64 = 3;
    let bound:i64 = 7700;
    if(q < 1240) { ji = 0; bound = 1240; }
    if(q >= 1240 && q < 2800) { ji = 1; bound = 2800; }
    if(q >= 2800 && q < 7700) { ji = 2; bound = 7700; }
    let mgg:i64 = iabs(q - bound);
    if(ji == 3) { mgg = q - 7700; }
    t_put64(cf, 0, 1000 * mgg / (mgg + 150));
    return ji;
}

// ================= TASK 6: motiondir =====================================
// 8-frame clip. SGP: the translation group of the clip — {IDENTITY, STILL}
// or {IDENTITY, MOTDIR_d}. Fixed points: the motion track endpoints.
// Returns 0=STILL, 1=N, 2=NE, 3=E, 4=SE, 5=S, 6=SW, 7=W, 8=NW.
fn task_motiondir(buf:[]u8, n:i32, op:[]u8, perc:[]u8, cf:[]u8) i64 {
    let nf:i32 = t_get32(buf, 0) as i32;
    let w:i32 = t_get32(buf, 4) as i32;
    let h:i32 = t_get32(buf, 8) as i32;
    if(nf < 2 || nf > 1024) { return -1; }
    if(w < 2 || h < 2 || w > 512 || h > 512) { return -1; }
    let fsz:i64 = (w as i64) * (h as i64) * 3;
    if(12 + (nf as i64) * fsz > n as i64) { return -1; }
    let npx:i32 = w * h;
    let have:i32 = 0;
    let fcx:i64 = 0; let fcy:i64 = 0;
    let lcx:i64 = 0; let lcy:i64 = 0;
    let t:i32 = 1;
    while(t < nf) {
        let mc:i64 = 0; let mx:i64 = 0; let my:i64 = 0;
        let p:i32 = 0;
        while(p < npx) {
            let o0:i32 = (12 + ((t - 1) as i64) * fsz + (p as i64) * 3) as i32;
            let o1:i32 = (12 + (t as i64) * fsz + (p as i64) * 3) as i32;
            let d:i64 = iabs((buf[o1] as i64) - (buf[o0] as i64))
                      + iabs((buf[o1+1] as i64) - (buf[o0+1] as i64))
                      + iabs((buf[o1+2] as i64) - (buf[o0+2] as i64));
            if(d > 90) {
                mc = mc + 1;
                mx = mx + (p % w) as i64;
                my = my + (p / w) as i64;
            }
            p = p + 1;
        }
        op_add(op, npx as i64);
        if(mc > 0) {
            let cx:i64 = mx / mc;
            let cy:i64 = my / mc;
            if(have == 0) { fcx = cx; fcy = cy; have = 1; }
            lcx = cx; lcy = cy;
        }
        t = t + 1;
    }
    let dx:i64 = 0; let dy:i64 = 0;
    if(have == 1) { dx = lcx - fcx; dy = lcy - fcy; }
    let mag:i64 = imax(iabs(dx), iabs(dy));
    op_add(op, 2);
    g_add(perc, 0, 32, 1);
    let ji:i64 = 0;
    if(mag < 5) {
        g_add(perc, 0, 32, 12);
    } else {
        let ax:i64 = iabs(dx); let ay:i64 = iabs(dy);
        let d:i32 = 4;
        if(ax >= 2 * ay) {
            d = 2;
            if(dx < 0) { d = 6; }
        }
        if(ay >= 2 * ax) {
            d = 4;
            if(dy < 0) { d = 0; }
        }
        if(ax < 2 * ay && ay < 2 * ax) {
            d = 3;
            if(dx < 0 && dy > 0) { d = 5; }
            if(dx > 0 && dy < 0) { d = 1; }
            if(dx < 0 && dy < 0) { d = 7; }
        }
        g_add(perc, 0, 32, 32 + (d as i64));
        ji = (d as i64) + 1;
    }
    t_put16(perc, 32, fcx); t_put16(perc, 34, fcy);
    t_put16(perc, 36, lcx); t_put16(perc, 38, lcy);
    t_put16(perc, 40, dx); t_put16(perc, 42, dy);
    canon_codes(perc, 0, 32);
    canon_coords(perc, 32, 16);
    let mgg:i64 = iabs(mag - 5);
    t_put64(cf, 0, 1000 * mgg / (mgg + 4));
    return ji;
}

// ================= main ====================================================
fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    if(a1.len == 0) { return fail("", "no_task"); }
    let tid:i32 = 0;
    if(_zag_strcmp(a1, "colordisc") == 1) { tid = 1; }
    if(_zag_strcmp(a1, "colorconst") == 1) { tid = 2; }
    if(_zag_strcmp(a1, "shapetrans") == 1) { tid = 3; }
    if(_zag_strcmp(a1, "pitchdisc") == 1) { tid = 4; }
    if(_zag_strcmp(a1, "timbredisc") == 1) { tid = 5; }
    if(_zag_strcmp(a1, "motiondir") == 1) { tid = 6; }
    if(tid == 0) { return fail(a1, "bad_task"); }
    if(a2.len == 0) { return fail(a1, "no_fixture"); }
    let buf:[]u8 = nio_alloc(8388608);
    if(buf.len == 0) { return fail(a1, "alloc_failed"); }
    let n:i64 = z_read(a2, buf, 8388608);
    if(n < 12) { nio_free(buf); return fail(a1, "read_failed"); }
    let op:[]u8 = nio_alloc(8);
    let perc:[]u8 = nio_alloc(64);
    let cf:[]u8 = nio_alloc(8);
    if(op.len == 0 || perc.len == 0 || cf.len == 0) {
        nio_free(buf); return fail(a1, "alloc_failed");
    }
    p_zero(perc);
    // optional ledger
    let ledger_on:i32 = 0;
    let led:[]u8 = "";
    let ledn:i32 = 0;
    if(a3.len > 0) {
        ledger_on = 1;
        led = nio_alloc(1048576);
        if(led.len == 0) { nio_free(buf); return fail(a1, "alloc_failed"); }
        let rn:i64 = z_read(a3, led, 1048576);
        if(rn < 0) { rn = 0; }
        ledn = rn as i32;
    }
    let ji:i64 = -1;
    if(tid == 1) { ji = task_colordisc(buf, n as i32, op, perc, cf); }
    if(tid == 2) { ji = task_colorconst(buf, n as i32, op, perc, cf); }
    if(tid == 3) { ji = task_shapetrans(buf, n as i32, op, perc, cf); }
    if(tid == 4) { ji = task_pitchdisc(buf, n as i32, op, perc, cf); }
    if(tid == 5) { ji = task_timbredisc(buf, n as i32, op, perc, cf); }
    if(tid == 6) { ji = task_motiondir(buf, n as i32, op, perc, cf); }
    if(ji < 0) { nio_free(buf); return fail(a1, "task_failed"); }
    let judg:[]u8 = "?";
    if(tid == 1) {
        if(ji == 0) { judg = "SAME"; } else { judg = "DIFFERENT"; }
    }
    if(tid == 2) {
        if(ji == 0) { judg = "SAME_SURFACE"; } else { judg = "DIFFERENT"; }
    }
    if(tid == 3) {
        if(ji == 0) { judg = "CIRCLE"; }
        if(ji == 1) { judg = "SQUARE"; }
        if(ji == 2) { judg = "TRIANGLE"; }
    }
    if(tid == 4) {
        if(ji == 0) { judg = "SAME"; }
        if(ji == 1) { judg = "HIGHER"; }
        if(ji == 2) { judg = "LOWER"; }
    }
    if(tid == 5) {
        if(ji == 0) { judg = "PURE"; }
        if(ji == 1) { judg = "DARK"; }
        if(ji == 2) { judg = "RICH"; }
        if(ji == 3) { judg = "BRIGHT"; }
    }
    if(tid == 6) {
        if(ji == 0) { judg = "STILL"; }
        if(ji == 1) { judg = "N"; }
        if(ji == 2) { judg = "NE"; }
        if(ji == 3) { judg = "E"; }
        if(ji == 4) { judg = "SE"; }
        if(ji == 5) { judg = "S"; }
        if(ji == 6) { judg = "SW"; }
        if(ji == 7) { judg = "W"; }
        if(ji == 8) { judg = "NW"; }
    }
    // memory contract
    let disp_out:[]u8 = nio_alloc(16);
    let var_out:[]u8 = nio_alloc(16);
    let anch_out:[]u8 = nio_alloc(16);
    let hash_out:[]u8 = nio_alloc(64);
    if(disp_out.len == 0 || var_out.len == 0 || anch_out.len == 0
       || hash_out.len == 0) {
        nio_free(buf); return fail(a1, "alloc_failed");
    }
    let i:i32 = 0;
    while(i < 16) { disp_out[i] = 0; var_out[i] = 0; anch_out[i] = 0; i = i + 1; }
    i = 0;
    while(i < 64) { hash_out[i] = 0; i = i + 1; }
    let conf:i64 = t_get64(cf, 0);
    let rc:i32 = contract_apply(a1, a2, perc, judg, conf, led, ledn,
                               ledger_on, a3, disp_out, var_out, anch_out,
                               hash_out);
    if(rc != 0) { nio_free(buf); return fail(a1, "contract_failed"); }
    // emit stdout
    let ob:[]u8 = nio_alloc(4096);
    if(ob.len == 0) { nio_free(buf); return fail(a1, "alloc_failed"); }
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "G1");
    pos = ob_kv(ob, pos, "task", a1);
    pos = ob_kv(ob, pos, "judgment", judg);
    pos = ob_kint(ob, pos, "confidence", conf);
    pos = ob_kint(ob, pos, "ops", t_get64(op, 0));
    let ph:[]u8 = ns_hex(perc);
    pos = ob_kv(ob, pos, "percept", ph);
    pos = ob_kv(ob, pos, "disposition", z_trim(disp_out));
    pos = ob_kv(ob, pos, "variance", z_trim(var_out));
    pos = ob_kv(ob, pos, "anchor", z_trim(anch_out));
    pos = ob_kv(ob, pos, "ledger_hash", z_trim(hash_out));
    if(nio_write_all(1, ob[0..pos]) != pos as i64) {
        nio_free(buf); return fail(a1, "write_failed");
    }
    nio_free(buf);
    return 0;
}
// Trim trailing NUL bytes from a fixed buffer -> slice.
fn z_trim(b:[]u8) []u8 {
    let e:i32 = 0;
    while(e < b.len && b[e] != 0) { e = e + 1; }
    return b[0..e];
}

// rsp.zag — G3 Relational Signature Percept (RSP).
//
// Fixture bytes -> minimal relation graph -> deterministic canonical bytes
// -> SHA-256 (pinned R33_NATIVE_SHA256_V2, not invented crypto) over the
// canonical adjacency + 32-bit metadata (node_count<<16 | edge_count).
// PERCEPT = 288 bits.
//
// MEMORY CONTRACT (executable, load-bearing): INSTALL iff the 256-bit
// signature exactly matches a frozen enrolled template (templates.zag,
// generated by src/enroll.py from the noise-variant fixtures); else
// WITHHOLD. Retrieval: `sense retrieve <sighex>` -> signature lookup ->
// graph expansion.
//
// Pure Zag. Zero RNG in any decision path. Integer math only.
// Deterministic: same binary + fixture -> byte-identical stdout.
//
// CLI:
//   sense <task> <fixture>    task in colordisc colorconst shapetrans
//                             pitchdisc timbredisc motiondir
//   sense retrieve <sighex>
// stdout: key=value lines; final chain=<hex> = sha256 over the emitted
// record bytes (per-invocation hash-chained ledger line).
//
// znc workarounds honored: no argc gate; []u8 arenas + LE accessors only
// (no `as []i32` casts); no `};`; explicit init; NUL-terminated paths via
// z_cstr; _zag_raw_syscall takes exactly 7 args; shallow else-nesting;
// _zag_strcmp == 1 on equality; `return;` (not bare return) in void fns.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")
@import("templates.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}

fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}

// ---------------- ops counter (8-byte arena) -------------------------------
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}
fn op_get(op:[]u8) i64 {
    return t_get64(op, 0);
}

// ---------------- integer math -------------------------------------------
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}

// ---------------- file IO -------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// ---------------- stdout line builder ------------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn fail(task:[]u8, reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "G3");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "error", reason);
    let ch:[]u8 = nio_alloc(32);
    ns_sha256(ob[0..pos], ch);
    pos = ob_kv(ob, pos, "chain", ns_hex(ch));
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    nio_free(ch);
    return 1;
}

// ---------------- sine (Taylor, copied pattern from Approach A) ------------
fn ng_sin1024(p:i64) i64 {
    let q:i64 = (p >> 30) & 3;
    let fr:i64 = p & 1073741823;
    let x:i64 = (fr * 1608) >> 30;
    let xx:i64 = x;
    if(q == 1 || q == 3) { xx = 1608 - x; }
    let x2:i64 = xx * xx;
    let term:i64 = xx;
    let sum:i64 = xx;
    let k:i64 = 1;
    while(k <= 7) {
        term = 0 - term * x2 / ((2 * k) * (2 * k + 1) * 1048576);
        sum = sum + term;
        k = k + 1;
    }
    if(q >= 2) { return 0 - sum; }
    return sum;
}

// ---------------- hex helpers --------------------------------------------
fn hex8(v:i64) []u8 {
    let digits:[]u8 = "0123456789abcdef";
    let t:[]u8 = nio_alloc(8);
    let i:i32 = 0;
    while(i < 8) {
        t[i] = digits[((v >> ((7 - i) * 4)) & 15) as i32];
        i = i + 1;
    }
    return t;
}
// parse 64 hex chars at s into 32 bytes of out; returns 0 ok, -1 bad
fn hexbytes(out:[]u8, s:[]u8) i32 {
    if(s.len != 64 || out.len < 32) { return -1; }
    let i:i32 = 0;
    while(i < 32) {
        let hi:i64 = ns_hex_digit(s[2*i] as i32);
        let lo:i64 = ns_hex_digit(s[2*i+1] as i32);
        if(hi < 0 || lo < 0) { return -1; }
        out[i] = ((hi * 16 + lo) & 255) as u8;
        i = i + 1;
    }
    return 0;
}

// ================= audio helpers =========================================
// Interpolated upward zero-crossing f0 estimate. Returns milli-Hz, or -1.
// Positions in 1/64 sample; first-to-last distance over (k-1) periods.
fn est_f0m(buf:[]u8, off:i32, cnt:i32, op:[]u8) i64 {
    let first:i64 = -1;
    let last:i64 = -1;
    let k:i64 = 0;
    let i:i32 = 1;
    while(i < cnt) {
        let v0:i64 = t_geti16(buf, off + (i - 1) * 2);
        let v1:i64 = t_geti16(buf, off + i * 2);
        if(v0 < 0 && v1 >= 0) {
            let pos:i64 = ((i - 1) as i64) * 64 + ((-v0) * 64) / (v1 - v0);
            if(first < 0) { first = pos; }
            last = pos;
            k = k + 1;
        }
        i = i + 1;
    }
    op_add(op, cnt as i64);
    if(k < 2 || last <= first) { return -1; }
    return 1024000000 * (k - 1) / (last - first);
}
// 10-cent bins over [200,720] Hz: bin b covers 200*1.005793^b.
// Integer loop; deterministic.
fn f0_bin(fm:i64) i32 {
    let v:i64 = 200000;
    let b:i32 = 0;
    while(v < fm) {
        v = v * 1005793 / 1000000;
        b = b + 1;
        if(b >= 255) { return 255; }
    }
    return b;
}
// Harmonic energy E_h (proportional) via sine/cosine correlation.
fn harm_e(buf:[]u8, off:i32, cnt:i32, fm:i64, h:i32, op:[]u8) i64 {
    let re:i64 = 0;
    let im:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let s:i64 = t_geti16(buf, off + i * 2);
        let cyc:i64 = ((i as i64) * (h as i64) * fm) % 16000000;
        let p:i64 = cyc * 4294967296 / 16000000;
        re = re + s * ng_sin1024(p) / 1024;
        im = im + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
        i = i + 1;
    }
    op_add(op, (2 * cnt) as i64);
    let rs:i64 = re / 256;
    let ms:i64 = im / 256;
    return rs * rs + ms * ms;
}

// ================= TASK 1: colordisc =====================================
// Canon (14B): [1,2,1, 1,Lr,Lg,Lb, 1,Rr,Rg,Rb, 0,1,rel]
// Nodes: REGION halves, 4-bit mean RGB. Edge: ADJACENT, rel 0=SAME_BIN
// (4-bit bins equal) / 1=DIFF_BIN.
fn g1_graph(buf:[]u8, n:i32, op:[]u8, canon:[]u8) i32 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 2 || h < 1 || w > 4096 || h > 4096) { return -1; }
    if((w % 2) == 1) { return -1; }
    if(8 + (w as i64) * (h as i64) * 3 > n as i64) { return -1; }
    let hw:i32 = w / 2;
    let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
    let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < hw) {
            let o1:i32 = 8 + (y * w + x) * 3;
            s1r = s1r + (buf[o1] as i64);
            s1g = s1g + (buf[o1+1] as i64);
            s1b = s1b + (buf[o1+2] as i64);
            let o2:i32 = 8 + (y * w + hw + x) * 3;
            s2r = s2r + (buf[o2] as i64);
            s2g = s2g + (buf[o2+1] as i64);
            s2b = s2b + (buf[o2+2] as i64);
            x = x + 1;
        }
        y = y + 1;
    }
    let np:i64 = (hw as i64) * (h as i64);
    op_add(op, 2 * np);
    let m1r:i64 = s1r / np; let m1g:i64 = s1g / np; let m1b:i64 = s1b / np;
    let m2r:i64 = s2r / np; let m2g:i64 = s2g / np; let m2b:i64 = s2b / np;
    let rel:i32 = 1;
    if(m1r / 16 == m2r / 16 && m1g / 16 == m2g / 16 && m1b / 16 == m2b / 16) { rel = 0; }
    canon[0] = 1; canon[1] = 2; canon[2] = 1;
    canon[3] = 1;
    canon[4] = (m1r / 16) as u8; canon[5] = (m1g / 16) as u8; canon[6] = (m1b / 16) as u8;
    canon[7] = 1;
    canon[8] = (m2r / 16) as u8; canon[9] = (m2g / 16) as u8; canon[10] = (m2b / 16) as u8;
    canon[11] = 0; canon[12] = 1; canon[13] = rel as u8;
    return 14;
}

// ================= TASK 2: colorconst ====================================
// Canon (14B): [2,2,1, 1,Lr,Lg,Lb, 1,Rr,Rg,Rb, 0,1,rel]
// Nodes: REGION halves, 4-bit RAW mean RGB (noise-robust identity).
// Edge: ADJACENT, rel from white-patch (per-channel max) normalized means:
// 0=SAME_SURFACE (every channel within 1 of the 4-bit bins) / 1=DIFF.
fn g2_graph(buf:[]u8, n:i32, op:[]u8, canon:[]u8) i32 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 2 || h < 1 || w > 4096 || h > 4096) { return -1; }
    if((w % 2) == 1) { return -1; }
    if(8 + (w as i64) * (h as i64) * 3 > n as i64) { return -1; }
    let hw:i32 = w / 2;
    let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
    let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
    let x1r:i64 = 0; let x1g:i64 = 0; let x1b:i64 = 0;
    let x2r:i64 = 0; let x2g:i64 = 0; let x2b:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < hw) {
            let o1:i32 = 8 + (y * w + x) * 3;
            let r1:i64 = buf[o1] as i64;
            let g1:i64 = buf[o1+1] as i64;
            let b1:i64 = buf[o1+2] as i64;
            s1r = s1r + r1; s1g = s1g + g1; s1b = s1b + b1;
            if(r1 > x1r) { x1r = r1; }
            if(g1 > x1g) { x1g = g1; }
            if(b1 > x1b) { x1b = b1; }
            let o2:i32 = 8 + (y * w + hw + x) * 3;
            let r2:i64 = buf[o2] as i64;
            let g2:i64 = buf[o2+1] as i64;
            let b2:i64 = buf[o2+2] as i64;
            s2r = s2r + r2; s2g = s2g + g2; s2b = s2b + b2;
            if(r2 > x2r) { x2r = r2; }
            if(g2 > x2g) { x2g = g2; }
            if(b2 > x2b) { x2b = b2; }
            x = x + 1;
        }
        y = y + 1;
    }
    let np:i64 = (hw as i64) * (h as i64);
    op_add(op, 2 * np);
    let m1r:i64 = s1r / np; let m1g:i64 = s1g / np; let m1b:i64 = s1b / np;
    let m2r:i64 = s2r / np; let m2g:i64 = s2g / np; let m2b:i64 = s2b / np;
    if(x1r < 1) { x1r = 1; }
    if(x1g < 1) { x1g = 1; }
    if(x1b < 1) { x1b = 1; }
    if(x2r < 1) { x2r = 1; }
    if(x2g < 1) { x2g = 1; }
    if(x2b < 1) { x2b = 1; }
    let n1r:i64 = 1000 * m1r / x1r; let n1g:i64 = 1000 * m1g / x1g; let n1b:i64 = 1000 * m1b / x1b;
    let n2r:i64 = 1000 * m2r / x2r; let n2g:i64 = 1000 * m2g / x2g; let n2b:i64 = 1000 * m2b / x2b;
    // SAME_SURFACE iff every channel's 4-bit normalized bin is within 1:
    // the Bradford CAT leaves small residuals; exact bin equality
    // over-rejects (measured 52.5% -> 80% on primaries, 0 false-accepts).
    let rel:i32 = 1;
    if(iabs(n1r / 62 - n2r / 62) <= 1 && iabs(n1g / 62 - n2g / 62) <= 1 && iabs(n1b / 62 - n2b / 62) <= 1) { rel = 0; }
    op_add(op, 6);
    canon[0] = 2; canon[1] = 2; canon[2] = 1;
    canon[3] = 1;
    canon[4] = (m1r / 16) as u8; canon[5] = (m1g / 16) as u8; canon[6] = (m1b / 16) as u8;
    canon[7] = 1;
    canon[8] = (m2r / 16) as u8; canon[9] = (m2g / 16) as u8; canon[10] = (m2b / 16) as u8;
    canon[11] = 0; canon[12] = 1; canon[13] = rel as u8;
    return 14;
}

// ================= TASK 3: shapetrans ====================================
// Canon (13B): [3,2,1, 2,cls,abin,rbin,cxbin,cybin, 3, 1,0,2]
// FG node: FG = pixels with brightness (r+g+b) > 480. The generator draws
// the shape at (235,235,235) on a photo dimmed to <=114/channel, so a fixed
// bright threshold isolates the shape; the minority-brightness heuristic
// latches onto bright photo regions (e.g. sky) instead. classbin 0=TRI
// 1=SQU 2=CIR from 1000*area/(pi*Rmax^2) @526/819; area_bin=area/256;
// rmax_bin=rmax/4; cx_bin=cx/8; cy_bin=cy/8. BG node kind only.
// Edge CONTAINS (BG->FG), label 2.
fn g3_graph(buf:[]u8, n:i32, op:[]u8, canon:[]u8) i32 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 1 || h < 1 || w > 4096 || h > 4096) { return -1; }
    if(8 + (w as i64) * (h as i64) * 3 > n as i64) { return -1; }
    let npx:i32 = w * h;
    let area:i64 = 0;
    let sx:i64 = 0;
    let sy:i64 = 0;
    let p:i32 = 0;
    while(p < npx) {
        let o:i32 = 8 + p * 3;
        let b:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        if(b > 480) {
            area = area + 1;
            sx = sx + (p % w) as i64;
            sy = sy + (p / w) as i64;
        }
        p = p + 1;
    }
    op_add(op, npx as i64);
    if(area < 16) { return -1; }
    let cx:i64 = sx / area;
    let cy:i64 = sy / area;
    let rmax2:i64 = 0;
    p = 0;
    while(p < npx) {
        let o:i32 = 8 + p * 3;
        let b:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        if(b > 480) {
            let dx:i64 = (p % w) as i64 - cx;
            let dy:i64 = (p / w) as i64 - cy;
            let d2:i64 = dx * dx + dy * dy;
            if(d2 > rmax2) { rmax2 = d2; }
        }
        p = p + 1;
    }
    op_add(op, npx as i64);
    if(rmax2 < 1) { return -1; }
    let rmax:i64 = isqrt(rmax2);
    let c:i64 = 1000000 * area / (3141 * rmax2);
    let cls:i32 = 2;
    if(c < 526) { cls = 0; }
    if(c >= 526 && c < 819) { cls = 1; }
    canon[0] = 3; canon[1] = 2; canon[2] = 1;
    canon[3] = 2;
    canon[4] = cls as u8;
    canon[5] = (area / 256) as u8;
    canon[6] = (rmax / 4) as u8;
    canon[7] = (cx / 8) as u8;
    canon[8] = (cy / 8) as u8;
    canon[9] = 3;
    canon[10] = 1; canon[11] = 0; canon[12] = 2;
    return 13;
}

// ================= TASK 4: pitchdisc ====================================
// Canon (11B): [4,2,1, 4,abin, 4,bbin, 0,1,rel]
// EVENT nodes: tone A/B f0 in 10-cent bins. Edge BEFORE, rel 0=DOWN
// 1=SAME 2=UP at +-25 cents (integer ratio test on milli-Hz).
fn g4_graph(buf:[]u8, n:i32, op:[]u8, canon:[]u8) i32 {
    let rate:i64 = t_get32(buf, 0);
    let cnt:i64 = t_get32(buf, 4);
    if(rate != 16000) { return -1; }
    if(cnt < 14080) { return -1; }
    if(8 + cnt * 2 > n as i64) { return -1; }
    let fa:i64 = est_f0m(buf, 8 + 400 * 2, 5600, op);
    let fb:i64 = est_f0m(buf, 8 + 8080 * 2, 5600, op);
    if(fa <= 0 || fb <= 0) { return -1; }
    let ab:i32 = f0_bin(fa);
    let bb:i32 = f0_bin(fb);
    let rel:i32 = 1;
    if(fb * 1000000 > fa * 1014546) { rel = 2; }
    if(fb * 1000000 < fa * 985663) { rel = 0; }
    op_add(op, 4);
    canon[0] = 4; canon[1] = 2; canon[2] = 1;
    canon[3] = 4; canon[4] = ab as u8;
    canon[5] = 4; canon[6] = bb as u8;
    canon[7] = 0; canon[8] = 1; canon[9] = rel as u8;
    return 10;
}

// ================= TASK 5: timbredisc ====================================
// Canon (7B): [5,1,0, 4,r2b,r3b,rhb]
// Single EVENT node: harmonic profile, 4 bits each:
// r2 = 1000*E2/E1, r3 = 1000*E3/E1, rh = 1000*sum(E4..E8)/E1.
fn g5_graph(buf:[]u8, n:i32, op:[]u8, canon:[]u8) i32 {
    let rate:i64 = t_get32(buf, 0);
    let cnt:i64 = t_get32(buf, 4);
    if(rate != 16000) { return -1; }
    if(cnt < 12800) { return -1; }
    if(8 + cnt * 2 > n as i64) { return -1; }
    let fm:i64 = est_f0m(buf, 8 + 400 * 2, 12000, op);
    if(fm <= 0) { return -1; }
    let e1:i64 = harm_e(buf, 8 + 400 * 2, 12000, fm, 1, op);
    if(e1 <= 0) { return -1; }
    let e2:i64 = harm_e(buf, 8 + 400 * 2, 12000, fm, 2, op);
    let e3:i64 = harm_e(buf, 8 + 400 * 2, 12000, fm, 3, op);
    let eh:i64 = 0;
    let h:i32 = 4;
    while(h <= 8) {
        eh = eh + harm_e(buf, 8 + 400 * 2, 12000, fm, h, op);
        h = h + 1;
    }
    let r2:i64 = 1000 * e2 / e1;
    let r3:i64 = 1000 * e3 / e1;
    let rh:i64 = 1000 * eh / e1;
    let r2b:i32 = imin(15, (r2 / 64) as i32) as i32;
    let r3b:i32 = imin(15, (r3 / 64) as i32) as i32;
    let rhb:i32 = imin(15, (rh / 64) as i32) as i32;
    if(r2b < 0) { r2b = 0; }
    if(r3b < 0) { r3b = 0; }
    if(rhb < 0) { rhb = 0; }
    op_add(op, 8);
    canon[0] = 5; canon[1] = 1; canon[2] = 0;
    canon[3] = 4;
    canon[4] = r2b as u8; canon[5] = r3b as u8; canon[6] = rhb as u8;
    return 7;
}

// ================= TASK 6: motiondir =====================================
// Canon (11B): [6,2,1, 4,dxbin, 4,dybin, 0,1,dir, magbin]
// Global translation estimate by block matching: downsample frame0/frame7
// to 16x16 (4x4 means), exhaustive SAD over (dx,dy) in [-4,4] cells
// (covers the generator's +-14px range); ties -> smallest |dx|+|dy|.
// The fixture window translates rigidly (no wraparound in practice), so
// block matching recovers it; change-mask centroids fail because a global
// translation changes pixels everywhere (centroid sits at frame center).
// EVENT nodes: motion-start/end; node attrs dxbin=fdx+16, dybin=fdy+16
// (fdx=bdx*4 full-px displacement). Edge DISPLACED, dir 0=STILL 1=N 2=NE
// 3=E 4=SE 5=S 6=SW 7=W 8=NW; magbin = |disp|/4.
fn dsample(buf:[]u8, foff:i64, w:i32, h:i32, out:[]u8) void {
    let cw:i32 = w / 16;
    let chh:i32 = h / 16;
    let cyy:i32 = 0;
    while(cyy < 16) {
        let cxx:i32 = 0;
        while(cxx < 16) {
            let sr:i64 = 0;
            let sg:i64 = 0;
            let sb:i64 = 0;
            let yy:i32 = 0;
            while(yy < chh) {
                let xx:i32 = 0;
                while(xx < cw) {
                    let o:i32 = (foff + (((cyy * chh + yy) * w + (cxx * cw + xx)) as i64) * 3) as i32;
                    sr = sr + (buf[o] as i64);
                    sg = sg + (buf[o+1] as i64);
                    sb = sb + (buf[o+2] as i64);
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            let dn:i64 = (cw as i64) * (chh as i64);
            let o2:i32 = (cyy * 16 + cxx) * 3;
            out[o2] = (sr / dn) as u8;
            out[o2+1] = (sg / dn) as u8;
            out[o2+2] = (sb / dn) as u8;
            cxx = cxx + 1;
        }
        cyy = cyy + 1;
    }
}

fn bsad(a:[]u8, b:[]u8, dx:i32, dy:i32) i64 {
    let s:i64 = 0;
    let y:i32 = 0;
    if(dy < 0) { y = 0 - dy; }
    let yend:i32 = 16;
    if(dy > 0) { yend = 16 - dy; }
    while(y < yend) {
        let x:i32 = 0;
        if(dx < 0) { x = 0 - dx; }
        let xend:i32 = 16;
        if(dx > 0) { xend = 16 - dx; }
        while(x < xend) {
            let i1:i32 = (y * 16 + x) * 3;
            let i2:i32 = ((y + dy) * 16 + (x + dx)) * 3;
            s = s + iabs((a[i1] as i64) - (b[i2] as i64));
            s = s + iabs((a[i1+1] as i64) - (b[i2+1] as i64));
            s = s + iabs((a[i1+2] as i64) - (b[i2+2] as i64));
            x = x + 1;
        }
        y = y + 1;
    }
    return s;
}

fn g6_graph(buf:[]u8, n:i32, op:[]u8, canon:[]u8) i32 {
    let nf:i32 = t_get32(buf, 0) as i32;
    let w:i32 = t_get32(buf, 4) as i32;
    let h:i32 = t_get32(buf, 8) as i32;
    if(nf < 8 || w < 16 || h < 16 || w > 512 || h > 512) { return -1; }
    let fsz:i64 = (w as i64) * (h as i64) * 3;
    if(12 + 8 * fsz > n as i64) { return -1; }
    let dw:[]u8 = nio_alloc(16*16*3);
    let ew:[]u8 = nio_alloc(16*16*3);
    dsample(buf, 12, w, h, dw);
    dsample(buf, 12 + 7 * fsz, w, h, ew);
    op_add(op, (2 * 16 * 16 * 16 * 3) as i64);
    let best_s:i64 = -1;
    let bdx:i32 = 0;
    let bdy:i32 = 0;
    let best_r:i32 = 99;
    let dy:i32 = -4;
    while(dy <= 4) {
        let dx:i32 = -4;
        while(dx <= 4) {
            let s:i64 = bsad(dw, ew, dx, dy);
            let r:i32 = (iabs(dx as i64) + iabs(dy as i64)) as i32;
            if(best_s < 0 || s < best_s || (s == best_s && r < best_r)) {
                best_s = s;
                bdx = dx;
                bdy = dy;
                best_r = r;
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    op_add(op, (81 * 16 * 16 * 3) as i64);
    nio_free(dw);
    nio_free(ew);
    let fdx:i64 = (bdx * 4) as i64;
    let fdy:i64 = (bdy * 4) as i64;
    let mag2:i64 = fdx * fdx + fdy * fdy;
    let mag:i64 = isqrt(mag2);
    let dir:i32 = 0;
    if(mag2 >= 9) {
        let ax:i64 = iabs(fdx);
        let ay:i64 = iabs(fdy);
        if(ax >= 2 * ay) {
            dir = 3;
            if(fdx < 0) { dir = 7; }
        }
        if(ay >= 2 * ax) {
            dir = 5;
            if(fdy < 0) { dir = 1; }
        }
        if(ax < 2 * ay && ay < 2 * ax) {
            dir = 4;
            if(fdx < 0 && fdy > 0) { dir = 6; }
            if(fdx > 0 && fdy < 0) { dir = 2; }
            if(fdx < 0 && fdy < 0) { dir = 8; }
        }
    }
    canon[0] = 6; canon[1] = 2; canon[2] = 1;
    canon[3] = 4; canon[4] = (fdx + 16) as u8;
    canon[5] = 4; canon[6] = (fdy + 16) as u8;
    canon[7] = 0; canon[8] = 1; canon[9] = dir as u8;
    canon[10] = (mag / 4) as u8;
    return 11;
}

// ================= readout (no-match coarse judgment) ====================
// Returns the vocab index for task tid decoded from the canonical graph.
fn g_readout(tid:i32, canon:[]u8) i32 {
    if(tid == 1) {
        if(canon[13] == 0) { return 0; }
        return 1;
    }
    if(tid == 2) {
        if(canon[13] == 0) { return 0; }
        return 1;
    }
    if(tid == 3) { return canon[4] as i32; }
    if(tid == 4) {
        let rel:i32 = canon[9] as i32;
        if(rel == 0) { return 2; }
        if(rel == 2) { return 1; }
        return 0;
    }
    if(tid == 5) {
        let r2b:i32 = canon[4] as i32;
        let rhb:i32 = canon[6] as i32;
        if(r2b == 0) { return 0; }
        if(r2b <= 3 && rhb == 0) { return 2; }
        if(rhb <= 6) { return 3; }
        return 1;
    }
    return canon[9] as i32;
}
// tid: 1..6; ji: vocab index -> judgment string.
fn judgment_str(tid:i32, ji:i32) []u8 {
    if(tid == 1) {
        if(ji == 0) { return "SAME"; }
        return "DIFFERENT";
    }
    if(tid == 2) {
        if(ji == 0) { return "SAME_SURFACE"; }
        return "DIFFERENT";
    }
    if(tid == 3) {
        if(ji == 0) { return "TRIANGLE"; }
        if(ji == 1) { return "SQUARE"; }
        return "CIRCLE";
    }
    if(tid == 4) {
        if(ji == 0) { return "SAME"; }
        if(ji == 1) { return "HIGHER"; }
        return "LOWER";
    }
    if(tid == 5) {
        if(ji == 0) { return "PURE"; }
        if(ji == 1) { return "BRIGHT"; }
        if(ji == 2) { return "DARK"; }
        return "RICH";
    }
    if(ji == 0) { return "STILL"; }
    if(ji == 1) { return "N"; }
    if(ji == 2) { return "NE"; }
    if(ji == 3) { return "E"; }
    if(ji == 4) { return "SE"; }
    if(ji == 5) { return "S"; }
    if(ji == 6) { return "SW"; }
    if(ji == 7) { return "W"; }
    return "NW";
}

// ================= memory contract =======================================
// Exact-signature lookup over frozen enrolled templates.
// Returns template index, or -1 when no template matches.
fn contract_lookup(sig:[]u8) i32 {
    let tb:[]u8 = nio_alloc(32);
    let i:i32 = 0;
    let nn:i32 = tmpl_n();
    while(i < nn) {
        tmpl_sig(i, tb);
        if(nio_equal(sig, tb) == 1) { nio_free(tb); return i; }
        i = i + 1;
    }
    nio_free(tb);
    return -1;
}

// ================= graph expansion (retrieval) ===========================
// Human-readable expansion of canonical bytes for retrieve mode.
fn g_expand(tid:i32, canon:[]u8, clen:i32, ob:[]u8, pos:i32) i32 {
    pos = ob_kv(ob, pos, "nodes", _zag_i64_to_str(canon[1] as i64));
    pos = ob_kv(ob, pos, "edges", _zag_i64_to_str(canon[2] as i64));
    if(tid == 1) {
        pos = ob_kv(ob, pos, "node0", "REGION half=L");
        pos = ob_kv(ob, pos, "node1", "REGION half=R");
        if(canon[13] == 0) { pos = ob_kv(ob, pos, "edge0", "ADJACENT SAME_BIN"); }
        if(canon[13] != 0) { pos = ob_kv(ob, pos, "edge0", "ADJACENT DIFF_BIN"); }
        return pos;
    }
    if(tid == 2) {
        pos = ob_kv(ob, pos, "node0", "REGION half=L");
        pos = ob_kv(ob, pos, "node1", "REGION half=R");
        if(canon[13] == 0) { pos = ob_kv(ob, pos, "edge0", "ADJACENT SAME_SURFACE"); }
        if(canon[13] != 0) { pos = ob_kv(ob, pos, "edge0", "ADJACENT DIFFERENT"); }
        return pos;
    }
    if(tid == 3) {
        pos = ob_kv(ob, pos, "node0", "FG shape");
        pos = ob_kv(ob, pos, "node1", "BG ground");
        pos = ob_kv(ob, pos, "edge0", "CONTAINS BG->FG");
        return pos;
    }
    if(tid == 4) {
        pos = ob_kv(ob, pos, "node0", "EVENT tone-A");
        pos = ob_kv(ob, pos, "node1", "EVENT tone-B");
        if(canon[9] == 0) { pos = ob_kv(ob, pos, "edge0", "BEFORE DOWN"); }
        if(canon[9] == 1) { pos = ob_kv(ob, pos, "edge0", "BEFORE SAME"); }
        if(canon[9] != 0 && canon[9] != 1) { pos = ob_kv(ob, pos, "edge0", "BEFORE UP"); }
        return pos;
    }
    if(tid == 5) {
        pos = ob_kv(ob, pos, "node0", "EVENT tone harmonic-profile");
        return pos;
    }
    pos = ob_kv(ob, pos, "node0", "EVENT motion-start");
    pos = ob_kv(ob, pos, "node1", "EVENT motion-end");
    pos = ob_kv(ob, pos, "edge0", "DISPLACED start->end");
    return pos;
}

fn do_retrieve(sighex:[]u8) i32 {
    let sig:[]u8 = nio_alloc(32);
    let ob:[]u8 = nio_alloc(4096);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "G3");
    pos = ob_kv(ob, pos, "mode", "retrieve");
    if(hexbytes(sig, sighex) != 0) {
        pos = ob_kv(ob, pos, "error", "bad_sighex");
        nio_write_all(1, ob[0..pos]);
        nio_free(sig);
        nio_free(ob);
        return 1;
    }
    let idx:i32 = contract_lookup(sig);
    if(idx < 0) {
        pos = ob_kv(ob, pos, "found", "0");
        pos = ob_kv(ob, pos, "sig", ns_hex(sig));
    }
    if(idx >= 0) {
        let cl:i32 = tmpl_clen(idx);
        let cb:[]u8 = nio_alloc(64);
        tmpl_canon(idx, cb);
        pos = ob_kv(ob, pos, "found", "1");
        pos = ob_kv(ob, pos, "sig", ns_hex(sig));
        pos = ob_kv(ob, pos, "judgment", tmpl_truth(idx));
        pos = ob_kv(ob, pos, "graph", ns_hex(cb[0..cl]));
        pos = g_expand((cb[0] as i32), cb, cl, ob, pos);
        nio_free(cb);
    }
    let ch:[]u8 = nio_alloc(32);
    ns_sha256(ob[0..pos], ch);
    pos = ob_kv(ob, pos, "chain", ns_hex(ch));
    nio_write_all(1, ob[0..pos]);
    nio_free(sig);
    nio_free(ob);
    nio_free(ch);
    return 0;
}

// ================= main ====================================================
fn g3_task_id(a1:[]u8) i32 {
    if(_zag_strcmp(a1, "colordisc") == 1) { return 1; }
    if(_zag_strcmp(a1, "colorconst") == 1) { return 2; }
    if(_zag_strcmp(a1, "shapetrans") == 1) { return 3; }
    if(_zag_strcmp(a1, "pitchdisc") == 1) { return 4; }
    if(_zag_strcmp(a1, "timbredisc") == 1) { return 5; }
    if(_zag_strcmp(a1, "motiondir") == 1) { return 6; }
    return 0;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    if(_zag_strcmp(a1, "retrieve") == 1) { return do_retrieve(a2); }
    let tid:i32 = g3_task_id(a1);
    if(tid == 0) { return fail("", "bad_task"); }
    if(a2.len == 0) { return fail(a1, "missing_fixture"); }
    let buf:[]u8 = nio_alloc(8388608);
    let n:i64 = z_read(a2, buf, 8388608);
    if(n <= 0) {
        nio_free(buf);
        return fail(a1, "read_failed");
    }
    let canon:[]u8 = nio_alloc(64);
    let op:[]u8 = nio_alloc(8);
    let i:i32 = 0;
    while(i < 64) { canon[i] = 0; i = i + 1; }
    i = 0;
    while(i < 8) { op[i] = 0; i = i + 1; }
    let clen:i32 = -1;
    if(tid == 1) { clen = g1_graph(buf, n as i32, op, canon); }
    if(tid == 2) { clen = g2_graph(buf, n as i32, op, canon); }
    if(tid == 3) { clen = g3_graph(buf, n as i32, op, canon); }
    if(tid == 4) { clen = g4_graph(buf, n as i32, op, canon); }
    if(tid == 5) { clen = g5_graph(buf, n as i32, op, canon); }
    if(tid == 6) { clen = g6_graph(buf, n as i32, op, canon); }
    nio_free(buf);
    if(clen < 0) {
        nio_free(canon);
        nio_free(op);
        return fail(a1, "graph_failed");
    }
    // 288-bit percept: 256-bit signature + 32-bit node/edge metadata.
    let sig:[]u8 = nio_alloc(32);
    ns_sha256(canon[0..clen], sig);
    op_add(op, 64);
    let meta:i64 = ((canon[1] as i64) << 16) | (canon[2] as i64);
    // Executable memory contract.
    let idx:i32 = contract_lookup(sig);
    let jstr:[]u8 = "";
    let conf:i64 = 300;
    let disp:[]u8 = "WITHHOLD";
    if(idx >= 0) {
        jstr = tmpl_truth(idx);
        conf = 950;
        disp = "INSTALL";
    }
    if(idx < 0) {
        jstr = judgment_str(tid, g_readout(tid, canon));
    }
    // Ledger record: hash-chained via the chain field.
    let ob:[]u8 = nio_alloc(4096);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "G3");
    pos = ob_kv(ob, pos, "task", a1);
    pos = ob_kv(ob, pos, "sig", ns_hex(sig));
    pos = ob_kv(ob, pos, "meta", hex8(meta));
    pos = ob_kv(ob, pos, "graph", ns_hex(canon[0..clen]));
    pos = ob_kv(ob, pos, "judgment", jstr);
    pos = ob_kint(ob, pos, "confidence", conf);
    pos = ob_kv(ob, pos, "disposition", disp);
    pos = ob_kint(ob, pos, "ops", op_get(op));
    let ch:[]u8 = nio_alloc(32);
    ns_sha256(ob[0..pos], ch);
    pos = ob_kv(ob, pos, "chain", ns_hex(ch));
    nio_write_all(1, ob[0..pos]);
    nio_free(canon);
    nio_free(op);
    nio_free(sig);
    nio_free(ob);
    nio_free(ch);
    return 0;
}

// templates.zag — STUB for stage-1 build only.
//
// The stage-1 binary is built with this stub so that src/enroll.py can run
// the frozen pipeline over the 370 noise fixtures and capture exact
// signatures. enroll.py then REPLACES this file with the frozen 370-entry
// enrolled template table (deterministic, lexicographically-first wins on
// collisions), and the final binary is rebuilt. The committed templates.zag
// is the frozen one. This stub is never committed.
fn tmpl_n() i32 { return 0; }
fn tmpl_clen(i:i32) i32 { return 0; }
fn tmpl_sig(i:i32, out:[]u8) void { return; }
fn tmpl_truth(i:i32) []u8 { return ""; }
fn tmpl_canon(i:i32, out:[]u8) void { return; }

// h1.zag — PAM fork H1: Witnessed Event Lattice (pure Zag).
//
// Deterministic temporal lattice of witnessed events + the MEMORY CONTRACT
// as executable code. Integer arithmetic only. Zero RNG, no wall-clock,
// no uninitialized reads.
//
// CLI:
//   h1 <task> <fixture> [--stream=ID] [--ablate]
//   h1 reset --stream=ID
// <task> in colordisc colorconst shapetrans pitchdisc timbredisc motiondir
// stdout: key=value lines (approach=H1, task, judgment, confidence, ops,
//   nev, bytes, disp, [ledger, retrieved]) then `ev ...` event records.
// Exit 0 on success; error=<reason> + exit 1 on failure.
//
// znc workarounds honored: _zag_arg read unconditionally; []u8 arenas with
// LE accessors (no as []i32 casts); _zag_strcmp==1 on equality; no slice >
// 2^25; no `};`; explicit init; NUL-terminated paths; raw syscall = 7 args;
// shallow else-nesting; @import paths relative to build cwd.
//
// Event arena: stride 32 i64 slots; field offsets (i64 index):
//   0:id_lo 1:id_hi 2:span0 3:span1 4:ent0 5:ent1 6:pred 7:attr_lo 8:attr_hi
//   9:nwit 10..21: wit triples (mod,ws,wl)x4 22:sup 23:con 24:nalt
//   25..30: alt (pred,sup)x3  (31: spare)
// Predicates: 1 ONSET 2 SUSTAIN 3 TRANSITION 4 REL_SAME 5 REL_DIFF 6 MOTION
//   7 SHAPE_CIRCLE 8 SHAPE_TRIANGLE 9 SHAPE_SQUARE 10 F0_HIGHER 11 F0_LOWER
//   12 F0_SAME 13 TIMBRE_PURE 14 TIMBRE_BRIGHT 15 TIMBRE_DARK 16 TIMBRE_RICH
//   17 DIR_STILL 18 DIR_N 19 DIR_NE 20 DIR_E 21 DIR_SE 22 DIR_S 23 DIR_SW
//   24 DIR_W 25 DIR_NW
// Modalities: 1 img 2 pcm 3 vid. Entities: 0 region 1 source 2 edge.

@import("R33_NATIVE_IO_V1.zag")
@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}

// ---------------- ops counter --------------------------------------------
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- integer math -------------------------------------------
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
fn iclamp(v:i64, lo:i64, hi:i64) i64 {
    if(v < lo) { return lo; }
    if(v > hi) { return hi; }
    return v;
}

// ---------------- strings -------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn streq(a:[]u8, b:[]u8) i32 {
    if(a.len != b.len) { return 0; }
    return _zag_strcmp(a, b);
}
fn has_prefix(s:[]u8, p:[]u8) i32 {
    if(s.len < p.len) { return 0; }
    let i:i32 = 0;
    while(i < p.len) {
        if(s[i] != p[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
// hex of u64 -> 16 chars appended to ob
fn ob_hex64(ob:[]u8, pos:i32, v:i64) i32 {
    let d:[]u8 = "0123456789abcdef";
    let i:i32 = 15;
    while(i >= 0) {
        let nib:i64 = (v >> (i as i64 * 4)) & 15;
        if(pos < ob.len) { ob[pos] = d[nib as i32]; }
        pos = pos + 1;
        i = i - 1;
    }
    return pos;
}
// FNV-1a 64 over bytes (wrapping i64 arithmetic)
fn fnv1a(data:[]u8, n:i32) i64 {
    let h:i64 = 0 - 3750763034362895579; // 14695981039346656037 as i64
    let i:i32 = 0;
    while(i < n) {
        h = h ^ (data[i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
// parse decimal i64 from slice (stops at first non-digit)
fn parse_i64(s:[]u8) i64 {
    let neg:i64 = 0;
    let i:i32 = 0;
    if(s.len > 0 && s[0] == 45) { neg = 1; i = 1; }
    let v:i64 = 0;
    while(i < s.len) {
        let c:i64 = s[i] as i64;
        if(c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if(neg == 1) { return 0 - v; }
    return v;
}
// parse 16 hex chars -> u64
fn parse_hex16(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < s.len && i < 16) {
        let c:i64 = s[i] as i64;
        let d:i64 = 0;
        if(c >= 48 && c <= 57) { d = c - 48; }
        if(c >= 97 && c <= 102) { d = c - 87; }
        if(c >= 65 && c <= 70) { d = c - 55; }
        v = (v << 4) | d;
        i = i + 1;
    }
    return v;
}

// ---------------- file IO -------------------------------------------------
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
// open(path, O_WRONLY|O_CREAT|O_TRUNC, 0600), write all, close
fn z_write_trunc(path:[]u8, data:[]u8, len:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 577, 384, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let w:i64 = nio_write_all(fd, data[0..len]);
    nio_close(fd);
    return w;
}
fn z_unlink(path:[]u8) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let rc:i64 = _zag_raw_syscall(87, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    return rc;
}
// join dir + "/" + name into out (out must be big enough); returns len
fn path_join(out:[]u8, dir:[]u8, name:[]u8) i32 {
    let p:i32 = 0;
    let i:i32 = 0;
    while(i < dir.len) { out[p] = dir[i]; p = p + 1; i = i + 1; }
    out[p] = 47; p = p + 1;
    i = 0;
    while(i < name.len) { out[p] = name[i]; p = p + 1; i = i + 1; }
    out[p] = 0;
    return p;
}

// ---------------- stdout line builder -------------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "H1");
    pos = ob_kv(ob, pos, "error", reason);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// ---------------- event arena ---------------------------------------------
// stride 32 i64 slots per event, MAXEV events.
fn ev_init(ev:[]u8, idx:i32) void {
    let b:i32 = idx * 256;
    let f:i32 = 0;
    while(f < 32) { t_put64(ev, b + f * 8, 0); f = f + 1; }
}
fn ev_put(ev:[]u8, idx:i32, f:i32, v:i64) void {
    t_put64(ev, idx * 256 + f * 8, v);
}
fn ev_get(ev:[]u8, idx:i32, f:i32) i64 {
    return t_get64(ev, idx * 256 + f * 8);
}
// add witness triple; returns 1 if stored
fn ev_wit(ev:[]u8, idx:i32, mod:i64, ws:i64, wl:i64) i32 {
    let n:i64 = ev_get(ev, idx, 9);
    if(n >= 4) { return 0; }
    let b:i32 = idx * 256 + (10 + n as i32 * 3) * 8;
    t_put64(ev, b, mod);
    t_put64(ev, b + 8, ws);
    t_put64(ev, b + 16, wl);
    ev_put(ev, idx, 9, n + 1);
    return 1;
}
// add alternative (pred, sup); returns 1 if stored
fn ev_alt(ev:[]u8, idx:i32, pred:i64, sup:i64) i32 {
    let n:i64 = ev_get(ev, idx, 24);
    if(n >= 3) { return 0; }
    let b:i32 = idx * 256 + (25 + n as i32 * 2) * 8;
    t_put64(ev, b, pred);
    t_put64(ev, b + 8, sup);
    ev_put(ev, idx, 24, n + 1);
    return 1;
}
// stable id = FNV-1a over (taskid, span, pred, attrs) rendered as text
fn ev_hash_id(ev:[]u8, idx:i32, taskid:i64) void {
    let tmp:[]u8 = nio_alloc(96);
    let p:i32 = 0;
    p = ob_kint(tmp, p, "", taskid);
    p = ob_kint(tmp, p, "", ev_get(ev, idx, 2));
    p = ob_kint(tmp, p, "", ev_get(ev, idx, 3));
    p = ob_kint(tmp, p, "", ev_get(ev, idx, 6));
    p = ob_kint(tmp, p, "", ev_get(ev, idx, 7));
    p = ob_kint(tmp, p, "", ev_get(ev, idx, 8));
    let h1:i64 = fnv1a(tmp, p);
    // second lane: fold witness spans in
    p = 0;
    p = ob_kint(tmp, p, "", ev_get(ev, idx, 10));
    p = ob_kint(tmp, p, "", ev_get(ev, idx, 11));
    p = ob_kint(tmp, p, "", ev_get(ev, idx, 12));
    p = ob_kint(tmp, p, "", ev_get(ev, idx, 13));
    let h2:i64 = fnv1a(tmp, p) ^ (h1 * 1099511628211);
    nio_free(tmp);
    ev_put(ev, idx, 0, h1);
    ev_put(ev, idx, 1, h2);
}
fn pred_name(p:i64, ob:[]u8, pos:i32) i32 {
    if(p == 1) { return ob_add(ob, pos, "ONSET"); }
    if(p == 2) { return ob_add(ob, pos, "SUSTAIN"); }
    if(p == 3) { return ob_add(ob, pos, "TRANSITION"); }
    if(p == 4) { return ob_add(ob, pos, "REL_SAME"); }
    if(p == 5) { return ob_add(ob, pos, "REL_DIFF"); }
    if(p == 6) { return ob_add(ob, pos, "MOTION"); }
    if(p == 7) { return ob_add(ob, pos, "SHAPE_CIRCLE"); }
    if(p == 8) { return ob_add(ob, pos, "SHAPE_TRIANGLE"); }
    if(p == 9) { return ob_add(ob, pos, "SHAPE_SQUARE"); }
    if(p == 10) { return ob_add(ob, pos, "F0_HIGHER"); }
    if(p == 11) { return ob_add(ob, pos, "F0_LOWER"); }
    if(p == 12) { return ob_add(ob, pos, "F0_SAME"); }
    if(p == 13) { return ob_add(ob, pos, "TIMBRE_PURE"); }
    if(p == 14) { return ob_add(ob, pos, "TIMBRE_BRIGHT"); }
    if(p == 15) { return ob_add(ob, pos, "TIMBRE_DARK"); }
    if(p == 16) { return ob_add(ob, pos, "TIMBRE_RICH"); }
    if(p == 17) { return ob_add(ob, pos, "DIR_STILL"); }
    if(p == 18) { return ob_add(ob, pos, "DIR_N"); }
    if(p == 19) { return ob_add(ob, pos, "DIR_NE"); }
    if(p == 20) { return ob_add(ob, pos, "DIR_E"); }
    if(p == 21) { return ob_add(ob, pos, "DIR_SE"); }
    if(p == 22) { return ob_add(ob, pos, "DIR_S"); }
    if(p == 23) { return ob_add(ob, pos, "DIR_SW"); }
    if(p == 24) { return ob_add(ob, pos, "DIR_W"); }
    if(p == 25) { return ob_add(ob, pos, "DIR_NW"); }
    return ob_add(ob, pos, "UNKNOWN");
}
// print one event record line; returns new pos. Counts records via rc arena.
fn ev_print(ev:[]u8, idx:i32, ob:[]u8, pos:i32, rc:[]u8) i32 {
    pos = ob_add(ob, pos, "ev id=");
    pos = ob_hex64(ob, pos, ev_get(ev, idx, 0));
    pos = ob_hex64(ob, pos, ev_get(ev, idx, 1));
    pos = ob_add(ob, pos, " span=");
    pos = ob_add(ob, pos, _zag_i64_to_str(ev_get(ev, idx, 2)));
    pos = ob_add(ob, pos, ":");
    pos = ob_add(ob, pos, _zag_i64_to_str(ev_get(ev, idx, 3)));
    pos = ob_add(ob, pos, " ent=");
    let e0:i64 = ev_get(ev, idx, 4);
    let e1:i64 = ev_get(ev, idx, 5);
    if(e0 == 0) { pos = ob_add(ob, pos, "r0"); }
    if(e0 == 1) { pos = ob_add(ob, pos, "s0"); }
    if(e0 == 2) { pos = ob_add(ob, pos, "e0"); }
    pos = ob_add(ob, pos, ",");
    if(e1 == 0) { pos = ob_add(ob, pos, "r0"); }
    if(e1 == 1) { pos = ob_add(ob, pos, "s0"); }
    if(e1 == 2) { pos = ob_add(ob, pos, "e0"); }
    pos = ob_add(ob, pos, " pred=");
    pos = pred_name(ev_get(ev, idx, 6), ob, pos);
    pos = ob_add(ob, pos, " attr=");
    pos = ob_add(ob, pos, _zag_i64_to_str(ev_get(ev, idx, 7)));
    pos = ob_add(ob, pos, ":");
    pos = ob_add(ob, pos, _zag_i64_to_str(ev_get(ev, idx, 8)));
    pos = ob_add(ob, pos, " wit=");
    let nw:i64 = ev_get(ev, idx, 9);
    let w:i32 = 0;
    while(w < nw as i32) {
        if(w > 0) { pos = ob_add(ob, pos, ";"); }
        let b:i32 = idx * 256 + (10 + w * 3) * 8;
        let m:i64 = t_get64(ev, b);
        if(m == 1) { pos = ob_add(ob, pos, "img"); }
        if(m == 2) { pos = ob_add(ob, pos, "pcm"); }
        if(m == 3) { pos = ob_add(ob, pos, "vid"); }
        pos = ob_add(ob, pos, ":");
        pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(ev, b + 8)));
        pos = ob_add(ob, pos, ":");
        pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(ev, b + 16)));
        w = w + 1;
    }
    pos = ob_add(ob, pos, " sup=");
    pos = ob_add(ob, pos, _zag_i64_to_str(ev_get(ev, idx, 22)));
    pos = ob_add(ob, pos, " con=");
    pos = ob_add(ob, pos, _zag_i64_to_str(ev_get(ev, idx, 23)));
    pos = ob_add(ob, pos, " alt=");
    let na:i64 = ev_get(ev, idx, 24);
    if(na == 0) { pos = ob_add(ob, pos, "-"); }
    let a:i32 = 0;
    while(a < na as i32) {
        if(a > 0) { pos = ob_add(ob, pos, ","); }
        let b:i32 = idx * 256 + (25 + a * 2) * 8;
        pos = pred_name(t_get64(ev, b), ob, pos);
        pos = ob_add(ob, pos, ":");
        pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(ev, b + 8)));
        a = a + 1;
    }
    pos = ob_add(ob, pos, "\n");
    // record count: 1 + alternatives
    op_add(rc, 1 + na);
    return pos;
}

// ---------------- audio helpers -------------------------------------------
// sin(p)*1024, p = turn in [0, 2^32). Table-free fixed-point Taylor.
fn ng_sin1024(p:i64) i64 {
    let q:i64 = (p >> 30) & 3;
    let fr:i64 = p & 1073741823;
    let x:i64 = (fr * 1608) >> 30;
    let xx:i64 = x;
    if(q == 1 || q == 3) { xx = 1608 - x; }
    let x2:i64 = xx * xx;
    let term:i64 = xx;
    let sum:i64 = xx;
    let k:i64 = 1;
    while(k <= 7) {
        term = 0 - term * x2 / ((2 * k) * (2 * k + 1) * 1048576);
        sum = sum + term;
        k = k + 1;
    }
    if(q >= 2) { return 0 - sum; }
    return sum;
}
fn pcm_peak(buf:[]u8, off:i32, cnt:i32) i64 {
    let p:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let s:i64 = iabs(t_geti16(buf, off + i * 2));
        if(s > p) { p = s; }
        i = i + 1;
    }
    return p;
}
// Block-energy envelope segmentation. Finds contiguous runs of blocks
// (bl samples) whose energy exceeds max/10. Writes up to 8 (start,end)
// sample spans into out (i64 pairs). Returns span count. ops counted.
fn env_spans(buf:[]u8, off:i32, cnt:i32, bl:i32, op:[]u8, out:[]u8) i32 {
    let nb:i32 = cnt / bl;
    if(nb < 2) { return 0; }
    if(nb > 512) { nb = 512; }
    // block energies
    let eb:[]u8 = nio_alloc(nb * 8);
    if(eb.len == 0) { return 0; }
    let b:i32 = 0;
    let emax:i64 = 0;
    while(b < nb) {
        let e:i64 = 0;
        let i:i32 = 0;
        while(i < bl) {
            let s:i64 = t_geti16(buf, off + (b * bl + i) * 2);
            e = e + iabs(s);
            i = i + 1;
        }
        op_add(op, bl as i64);
        t_put64(eb, b * 8, e);
        if(e > emax) { emax = e; }
        b = b + 1;
    }
    let thr:i64 = emax / 10;
    let nsp:i32 = 0;
    b = 0;
    while(b < nb) {
        if(t_get64(eb, b * 8) >= thr) {
            let s0:i32 = b;
            while(b < nb && t_get64(eb, b * 8) >= thr) { b = b + 1; }
            // trim: require run length >= 2 blocks
            if(b - s0 >= 2 && nsp < 8) {
                t_put64(out, nsp * 16, (off / 2 + s0 * bl) as i64);
                t_put64(out, nsp * 16 + 8, (off / 2 + b * bl) as i64);
                nsp = nsp + 1;
            }
        }
        b = b + 1;
    }
    nio_free(eb);
    return nsp;
}
// Coarse f0 in milli-Hz via autocorrelation on a <=1024-sample window taken
// from the middle of [off, off+cnt). Lags 20..106 (150..800 Hz @16k).
// Parabolic refinement + octave guard (R(2L) vs R(L)). Returns 0 on failure.
fn f0_coarse(buf:[]u8, off:i32, cnt:i32, sr:i64, op:[]u8) i64 {
    let w:i32 = 1024;
    if(cnt < w) { w = cnt; }
    if(w < 256) { return 0; }
    let st:i32 = off + (cnt - w) / 2 * 2; // byte offset of window start
    let peak:i64 = pcm_peak(buf, st, w);
    if(peak < 200) { return 0; }
    let lmin:i32 = 20;
    let lmax:i32 = 106;
    if(lmax > w / 2) { lmax = w / 2; }
    let nl:i32 = lmax - lmin + 3;
    let ra:[]u8 = nio_alloc(nl * 8);
    if(ra.len == 0) { return 0; }
    let l:i32 = lmin - 1;
    while(l <= lmax + 1) {
        let acc:i64 = 0;
        let nn:i32 = w - l;
        let n:i32 = 0;
        while(n < nn) {
            let a:i64 = t_geti16(buf, st + n * 2);
            let bb:i64 = t_geti16(buf, st + (n + l) * 2);
            acc = acc + a * bb;
            n = n + 1;
        }
        op_add(op, nn as i64);
        t_put64(ra, (l - (lmin - 1)) * 8, acc);
        l = l + 1;
    }
    // global max inside [lmin, lmax]
    let gmax:i64 = 0;
    l = lmin;
    while(l <= lmax) {
        let r:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
        if(r > gmax) { gmax = r; }
        l = l + 1;
    }
    // first strong local max (avoids octave-up lock): scan upward, take the
    // first local max exceeding 40% of gmax; fall back to global max lag.
    let lstar:i32 = -1;
    l = lmin + 1;
    while(l < lmax) {
        let rm:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
        let rl:i64 = t_get64(ra, (l - 1 - (lmin - 1)) * 8);
        let rr:i64 = t_get64(ra, (l + 1 - (lmin - 1)) * 8);
        if(rm >= rl && rm >= rr && rm * 5 >= gmax * 2) { lstar = l; break; }
        l = l + 1;
    }
    if(lstar < 0) {
        l = lmin;
        while(l <= lmax) {
            let r:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
            if(r == gmax) { lstar = l; break; }
            l = l + 1;
        }
    }
    if(lstar < 0) { nio_free(ra); return 0; }
    // octave guard: only double if R(2*lstar) is STRICTLY stronger.
    // (A pure sine has R(2P)~R(P); the old >=0.95 test falsely doubled it,
    //  halving f0 and pushing the harmonic centroid to ~2000.)
    let r1:i64 = t_get64(ra, (lstar - (lmin - 1)) * 8);
    let l2:i32 = lstar * 2;
    if(l2 <= lmax) {
        let r2:i64 = t_get64(ra, (l2 - (lmin - 1)) * 8);
        if(r2 * 100 > r1 * 103) { lstar = l2; }
    }
    // parabolic refinement around lstar
    let per:i64 = (lstar as i64) * 1000;
    if(lstar > lmin && lstar < lmax) {
        let rm:i64 = t_get64(ra, (lstar - (lmin - 1)) * 8);
        let rl:i64 = t_get64(ra, (lstar - 1 - (lmin - 1)) * 8);
        let rr:i64 = t_get64(ra, (lstar + 1 - (lmin - 1)) * 8);
        let den:i64 = rl - 2 * rm + rr;
        if(den < 0) {
            let num:i64 = rl - rr;
            per = (lstar as i64) * 1000 + num * 500 / den;
        }
    }
    nio_free(ra);
    if(per <= 0) { return 0; }
    return sr * 1000000 / per; // milli-Hz
}
// Harmonic energy at harmonics of f0m over w samples at off (bytes).
// Returns total energy; per-harmonic energies -> out (nhmax i64s).
fn harm_energies(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, nhmax:i32, op:[]u8, out:[]u8) i64 {
    if(f0m <= 0 || w < 64) { return 0; }
    let pinc1:i64 = f0m * 4294967296 / (1000 * sr);
    if(pinc1 <= 0) { return 0; }
    let tot:i64 = 0;
    let h:i64 = 1;
    while(h <= nhmax as i64) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let pinc:i64 = h * pinc1;
        let re:i64 = 0;
        let im:i64 = 0;
        let i:i32 = 0;
        while(i < w) {
            let s:i64 = t_geti16(buf, off + i * 2);
            let p:i64 = ((i as i64) * pinc) & 4294967295;
            re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
            im = im + s * ng_sin1024(p) / 1024;
            i = i + 1;
        }
        op_add(op, (2 * w) as i64);
        let e:i64 = (re * re + im * im) / 1048576;
        t_put64(out, (h - 1) as i32 * 8, e);
        tot = tot + e;
        h = h + 1;
    }
    return tot;
}
// Spectral centroid r = 1000*sum(k*E_k)/sum(E_k), k=1..nh, milli-units.
fn harm_centroid(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, nh:i32, op:[]u8) i64 {
    let eb:[]u8 = nio_alloc(nh * 8);
    if(eb.len == 0) { return 0; }
    let tot:i64 = harm_energies(buf, off, w, sr, f0m, nh, op, eb);
    if(tot <= 0) { nio_free(eb); return 0; }
    let num:i64 = 0;
    let h:i32 = 1;
    while(h <= nh) {
        num = num + (h as i64) * t_get64(eb, (h - 1) * 8);
        h = h + 1;
    }
    nio_free(eb);
    return num * 1000 / tot;
}
// Fine f0 refinement: maximize total harmonic energy (k=1..6) on a
// ±3% grid around f0m_c at 0.5% steps, parabolic interpolation.
// Returns refined milli-Hz.
fn f0_refine(buf:[]u8, off:i32, cnt:i32, sr:i64, f0m_c:i64, op:[]u8) i64 {
    if(f0m_c <= 0) { return 0; }
    let w:i32 = 2048;
    if(cnt < w) { w = cnt; }
    if(w < 512) { return f0m_c; }
    let st:i32 = off + (cnt - w) / 2 * 2;
    let eb:[]u8 = nio_alloc(48);
    if(eb.len == 0) { return f0m_c; }
    let eg:[]u8 = nio_alloc(13 * 8);
    if(eg.len == 0) { nio_free(eb); return f0m_c; }
    let best_e:i64 = -1;
    let best_g:i32 = 0;
    let g:i32 = -6;
    while(g <= 6) {
        let fm:i64 = f0m_c * (1000 + g * 5) / 1000;
        let e:i64 = harm_energies(buf, st, w, sr, fm, 6, op, eb);
        t_put64(eg, (g + 6) * 8, e);
        if(e > best_e) { best_e = e; best_g = g; }
        g = g + 1;
    }
    nio_free(eb);
    // parabolic interpolation around best_g; result in 0.05% units of f0m_c
    let goff:i64 = 0; // thousandths of a 0.5%-step
    if(best_g > -6 && best_g < 6) {
        let em:i64 = t_get64(eg, (best_g + 6) * 8);
        let el:i64 = t_get64(eg, (best_g - 1 + 6) * 8);
        let er:i64 = t_get64(eg, (best_g + 1 + 6) * 8);
        let den:i64 = el - 2 * em + er;
        if(den < 0 && em > 0) {
            goff = (el - er) * 500 / den; // in thousandths of step
            if(goff > 1000) { goff = 1000; }
            if(goff < -1000) { goff = -1000; }
        }
    }
    nio_free(eg);
    // f0 = f0m_c * (1 + (best_g*5)/1000 + goff*5/1000000)
    return f0m_c * (200000 + best_g * 1000 + goff) / 200000;
}

// ---------------- image helpers -------------------------------------------
// quarter q: 0=left-top 1=left-bottom 2=right-top 3=right-bottom.
// out3: mean r,g,b.
fn img_quarter_mean(buf:[]u8, w:i32, h:i32, q:i32, op:[]u8, out3:[]u8) void {
    let hw:i32 = w / 2;
    let hh:i32 = h / 2;
    let x0:i32 = 0; let x1:i32 = hw;
    let y0:i32 = 0; let y1:i32 = hh;
    if(q == 1) { y0 = hh; y1 = h; }
    if(q == 2) { x0 = hw; x1 = w; }
    if(q == 3) { x0 = hw; x1 = w; y0 = hh; y1 = h; }
    let sr:i64 = 0; let sg:i64 = 0; let sb:i64 = 0;
    let n:i64 = 0;
    let y:i32 = y0;
    while(y < y1) {
        let x:i32 = x0;
        while(x < x1) {
            let o:i32 = 8 + (y * w + x) * 3;
            sr = sr + (buf[o] as i64);
            sg = sg + (buf[o+1] as i64);
            sb = sb + (buf[o+2] as i64);
            n = n + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, n);
    if(n == 0) { n = 1; }
    t_put64(out3, 0, sr / n);
    t_put64(out3, 8, sg / n);
    t_put64(out3, 16, sb / n);
}
// per-channel max of quarter q (white-patch witness). out3: max r,g,b.
fn img_quarter_max(buf:[]u8, w:i32, h:i32, q:i32, op:[]u8, out3:[]u8) void {
    let hw:i32 = w / 2;
    let hh:i32 = h / 2;
    let x0:i32 = 0; let x1:i32 = hw;
    let y0:i32 = 0; let y1:i32 = hh;
    if(q == 1) { y0 = hh; y1 = h; }
    if(q == 2) { x0 = hw; x1 = w; }
    if(q == 3) { x0 = hw; x1 = w; y0 = hh; y1 = h; }
    let mr:i64 = 0; let mg:i64 = 0; let mb:i64 = 0;
    let n:i64 = 0;
    let y:i32 = y0;
    while(y < y1) {
        let x:i32 = x0;
        while(x < x1) {
            let o:i32 = 8 + (y * w + x) * 3;
            let r:i64 = buf[o] as i64;
            let g:i64 = buf[o+1] as i64;
            let b:i64 = buf[o+2] as i64;
            if(r > mr) { mr = r; }
            if(g > mg) { mg = g; }
            if(b > mb) { mb = b; }
            n = n + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, n);
    t_put64(out3, 0, mr);
    t_put64(out3, 8, mg);
    t_put64(out3, 16, mb);
}
// 4-bin per channel histogram of half (0=left,1=right). out12: 12 i64 counts.
fn img_hist4(buf:[]u8, w:i32, h:i32, half:i32, op:[]u8, out12:[]u8) void {
    let hw:i32 = w / 2;
    let x0:i32 = 0; let x1:i32 = hw;
    if(half == 1) { x0 = hw; x1 = w; }
    let i:i32 = 0;
    while(i < 12) { t_put64(out12, i * 8, 0); i = i + 1; }
    let n:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = x0;
        while(x < x1) {
            let o:i32 = 8 + (y * w + x) * 3;
            let c:i32 = 0;
            while(c < 3) {
                let v:i64 = buf[o + c] as i64;
                let b:i32 = (v / 64) as i32;
                if(b > 3) { b = 3; }
                let at:i32 = (c * 4 + b) * 8;
                t_put64(out12, at, t_get64(out12, at) + 1);
                c = c + 1;
            }
            n = n + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, n);
}
// redmean perceptual color distance squared (integer).
fn redmean_d2(r1:i64, g1:i64, b1:i64, r2:i64, g2:i64, b2:i64) i64 {
    let dr:i64 = r1 - r2; let dg:i64 = g1 - g2; let db:i64 = b1 - b2;
    let rb:i64 = (r1 + r2) / 2;
    // d2 = (2+rb/256)dr^2 + 4dg^2 + (2+(255-rb)/256)db^2, scaled x256
    let w1:i64 = 512 + rb;
    let w3:i64 = 512 + 255 - rb;
    return (w1 * dr * dr + 1024 * dg * dg + w3 * db * db) / 256;
}
// foreground-bright flag: 1 if the shape is the bright minority side.
fn shape_fgbright(buf:[]u8, w:i32, h:i32, thr:i64, op:[]u8) i32 {
    let npx:i64 = (w as i64) * (h as i64);
    let nb:i64 = 0;
    let i:i64 = 0;
    while(i < npx) {
        let o:i32 = (8 + i * 3) as i32;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        if(lum > thr) { nb = nb + 1; }
        i = i + 1;
    }
    op_add(op, npx);
    if(2 * nb <= npx) { return 1; }
    return 0;
}
// binary mask (0/1 per pixel) into mask (w*h bytes).
fn shape_mask_array(buf:[]u8, w:i32, h:i32, fgbright:i32, thr:i64, op:[]u8, mask:[]u8) void {
    let npx:i64 = (w as i64) * (h as i64);
    let i:i64 = 0;
    while(i < npx) {
        let o:i32 = (8 + i * 3) as i32;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        let isb:i32 = 0;
        if(lum > thr) { isb = 1; }
        if(isb == fgbright) { mask[i as i32] = 1; }
        if(isb != fgbright) { mask[i as i32] = 0; }
        i = i + 1;
    }
    op_add(op, npx);
}
// mask stats: mode 0=all pixels, 1=even checkerboard, 2=odd checkerboard.
// rows [rlo,rhi) included. out4: area, cx, cy, ratio_per_mille.
fn mask_stats(mask:[]u8, w:i32, h:i32, mode:i32, rlo:i32, rhi:i32, op:[]u8, out4:[]u8) void {
    let a:i64 = 0; let sx:i64 = 0; let sy:i64 = 0;
    let y:i32 = rlo;
    while(y < rhi) {
        let x:i32 = 0;
        while(x < w) {
            let take:i32 = 1;
            if(mode == 1 && ((x + y) & 1) == 1) { take = 0; }
            if(mode == 2 && ((x + y) & 1) == 0) { take = 0; }
            if(take == 1 && mask[y * w + x] == 1) {
                a = a + 1;
                sx = sx + (x as i64);
                sy = sy + (y as i64);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, ((rhi - rlo) as i64) * (w as i64));
    t_put64(out4, 0, a);
    if(a < 9) {
        t_put64(out4, 8, 0); t_put64(out4, 16, 0); t_put64(out4, 24, 0);
        return;
    }
    let cx:i64 = sx / a;
    let cy:i64 = sy / a;
    t_put64(out4, 8, cx);
    t_put64(out4, 16, cy);
    let maxd2:i64 = 0;
    y = rlo;
    while(y < rhi) {
        let x:i32 = 0;
        while(x < w) {
            let take:i32 = 1;
            if(mode == 1 && ((x + y) & 1) == 1) { take = 0; }
            if(mode == 2 && ((x + y) & 1) == 0) { take = 0; }
            if(take == 1 && mask[y * w + x] == 1) {
                let dx:i64 = (x as i64) - cx;
                let dy:i64 = (y as i64) - cy;
                let d2:i64 = dx * dx + dy * dy;
                if(d2 > maxd2) { maxd2 = d2; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, ((rhi - rlo) as i64) * (w as i64));
    if(maxd2 < 1) { t_put64(out4, 24, 0); return; }
    t_put64(out4, 24, a * 1000000 / (3142 * maxd2));
}
// radial signature: 16 rays from (cx,cy); returns (max-min)*1000/mean
// per-mille of exit radii. 0 on degenerate.
fn radial_sig(mask:[]u8, w:i32, h:i32, cx:i64, cy:i64, op:[]u8) i64 {
    // ray directions: 16 unit-ish vectors scaled x256 (integer octagon)
    let dxs:[]u8 = nio_alloc(16 * 8);
    let dys:[]u8 = nio_alloc(16 * 8);
    if(dxs.len == 0 || dys.len == 0) { return 0; }
    let k:i32 = 0;
    while(k < 16) {
        // angle = k*22.5deg; use integer cos/sin x256 via ng_sin1024
        let p:i64 = (k as i64) * 4294967296 / 16;
        let s:i64 = ng_sin1024(p);
        let c:i64 = ng_sin1024((p + 1073741824) & 4294967295);
        t_put64(dxs, k * 8, c * 256 / 1024);
        t_put64(dys, k * 8, s * 256 / 1024);
        k = k + 1;
    }
    let rmin:i64 = 1000000; let rmax:i64 = 0; let rsum:i64 = 0; let rn:i64 = 0;
    k = 0;
    while(k < 16) {
        let dx:i64 = t_get64(dxs, k * 8);
        let dy:i64 = t_get64(dys, k * 8);
        // march r in quarter-pixel units: pos = c + r*dir/1024
        let r:i64 = 0;
        let last_in:i64 = 0;
        while(r < 400) {
            let px:i64 = cx + r * dx / 1024;
            let py:i64 = cy + r * dy / 1024;
            if(px < 0 || py < 0 || px >= w as i64 || py >= h as i64) { break; }
            if(mask[(py * w as i64 + px) as i32] == 1) { last_in = r; }
            if(mask[(py * w as i64 + px) as i32] == 0 && last_in > 0 && r > last_in + 8) { break; }
            r = r + 4;
            op_add(op, 1);
        }
        if(last_in > 0) {
            if(last_in < rmin) { rmin = last_in; }
            if(last_in > rmax) { rmax = last_in; }
            rsum = rsum + last_in;
            rn = rn + 1;
        }
        k = k + 1;
    }
    nio_free(dxs);
    nio_free(dys);
    if(rn < 8 || rsum <= 0) { return 0; }
    let mean:i64 = rsum / rn;
    return (rmax - rmin) * 1000 / mean;
}
// Occlusion infill for convex shapes: per column, if the mask has exactly
// two runs separated by a gap of 4..30 rows, fill the gap. Detects the
// dominant gap band; out2: band_lo, band_hi (or -1,-1 if none).
fn occl_fill(mask:[]u8, w:i32, h:i32, op:[]u8, out2:[]u8) void {
    // histogram of gap-mid rows in 8 bins
    let hb:[]u8 = nio_alloc(8 * 8);
    if(hb.len == 0) { t_put64(out2, 0, -1); t_put64(out2, 8, -1); return; }
    let i:i32 = 0;
    while(i < 8) { t_put64(hb, i * 8, 0); i = i + 1; }
    let x:i32 = 0;
    while(x < w) {
        // find runs in this column
        let runs:[]u8 = nio_alloc(8 * 8); // up to 4 (start,end) pairs
        if(runs.len == 0) { x = x + 1; continue; }
        let nr:i32 = 0;
        let y:i32 = 0;
        while(y < h) {
            if(mask[y * w + x] == 1) {
                let s0:i32 = y;
                while(y < h && mask[y * w + x] == 1) { y = y + 1; }
                if(nr < 4) {
                    t_put64(runs, nr * 16, s0 as i64);
                    t_put64(runs, nr * 16 + 8, y as i64);
                    nr = nr + 1;
                }
            }
            y = y + 1;
        }
        if(nr == 2) {
            let g0:i64 = t_get64(runs, 8);
            let g1:i64 = t_get64(runs, 16);
            let gh:i64 = g1 - g0;
            if(gh >= 4 && gh <= 30 && g0 > 8 && g1 < (h - 8) as i64) {
                let mid:i32 = ((g0 + g1) / 2 * 8 / h as i64) as i32;
                if(mid < 0) { mid = 0; }
                if(mid > 7) { mid = 7; }
                t_put64(hb, mid * 8, t_get64(hb, mid * 8) + 1);
            }
        }
        nio_free(runs);
        x = x + 1;
    }
    op_add(op, (w as i64) * (h as i64));
    let bb:i32 = -1; let bc:i64 = 0;
    i = 0;
    while(i < 8) {
        if(t_get64(hb, i * 8) > bc) { bc = t_get64(hb, i * 8); bb = i; }
        i = i + 1;
    }
    nio_free(hb);
    if(bb < 0 || bc * 4 < w as i64) {
        t_put64(out2, 0, -1); t_put64(out2, 8, -1);
        return;
    }
    let blo:i32 = (bb * h / 8) as i32 - 4;
    let bhi:i32 = ((bb + 1) * h / 8) as i32 + 4;
    if(blo < 0) { blo = 0; }
    if(bhi > h) { bhi = h; }
    // fill gaps within [blo,bhi] for columns with two runs around it
    x = 0;
    while(x < w) {
        let top:i32 = -1; let bot:i32 = -1;
        let y:i32 = 0;
        while(y < blo) {
            if(mask[y * w + x] == 1) { top = y; }
            y = y + 1;
        }
        y = bhi;
        while(y < h) {
            if(mask[y * w + x] == 1) { if(bot < 0) { bot = y; } }
            y = y + 1;
        }
        if(top >= 0 && bot >= 0) {
            y = top;
            while(y < bot) { mask[y * w + x] = 1; y = y + 1; }
        }
        x = x + 1;
    }
    op_add(op, (w as i64) * (h as i64));
    t_put64(out2, 0, blo as i64);
    t_put64(out2, 8, bhi as i64);
}

// ---------------- task helpers --------------------------------------------
// mean and mean-abs-deviation of luminance over half (0=left,1=right).
fn img_half_lumad(buf:[]u8, w:i32, h:i32, half:i32, op:[]u8, out2:[]u8) void {
    let hw:i32 = w / 2;
    let x0:i32 = 0; let x1:i32 = hw;
    if(half == 1) { x0 = hw; x1 = w; }
    let s:i64 = 0; let n:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = x0;
        while(x < x1) {
            let o:i32 = 8 + (y * w + x) * 3;
            s = s + ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
            n = n + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, n);
    let mean:i64 = 0;
    if(n > 0) { mean = s / n; }
    let d:i64 = 0;
    y = 0;
    while(y < h) {
        let x:i32 = x0;
        while(x < x1) {
            let o:i32 = 8 + (y * w + x) * 3;
            let lum:i64 = ((buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64)) / 3;
            d = d + iabs(lum - mean);
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, n);
    t_put64(out2, 0, mean);
    if(n > 0) { t_put64(out2, 8, d / n); }
    if(n == 0) { t_put64(out2, 8, 0); }
}
// RGB euclidean distance (integer, like Approach A).
fn rgb_dist(r1:i64, g1:i64, b1:i64, r2:i64, g2:i64, b2:i64) i64 {
    let dr:i64 = r1 - r2; let dg:i64 = g1 - g2; let db:i64 = b1 - b2;
    return isqrt(dr*dr + dg*dg + db*db);
}
// res: [0]=top_idx [8]=judg [16]=corroborated [24]=n_events
// ================= TASK 1: colordisc ======================================
fn xt_colordisc(buf:[]u8, n:i32, op:[]u8, ev:[]u8, res:[]u8) void {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    let ne:i32 = 0;
    if(w < 2 || h < 4 || (w & 1) == 1 || 8 + (w as i64) * (h as i64) * 3 > n as i64) {
        ev_init(ev, 0); ne = 1;
        ev_put(ev, 0, 2, 0); ev_put(ev, 0, 3, (w as i64) * (h as i64));
        ev_put(ev, 0, 4, 0); ev_put(ev, 0, 5, 1);
        ev_put(ev, 0, 6, 4); ev_put(ev, 0, 7, 0); ev_put(ev, 0, 8, 0);
        ev_wit(ev, 0, 1, 0, (w as i64) * (h as i64));
        ev_put(ev, 0, 22, 0); ev_put(ev, 0, 23, 1000);
        ev_hash_id(ev, 0, 1);
        t_put64(res, 0, 0); t_put64(res, 8, 0);
        t_put64(res, 16, 0); t_put64(res, 24, ne);
        t_put64(res, 32, 0); t_put64(res, 40, 0); t_put64(res, 48, 1000);
        return;
    }
    let hw:i32 = w / 2;
    let hh:i32 = h / 2;
    let qm:[]u8 = nio_alloc(96);
    let q:i32 = 0;
    while(q < 4) {
        img_quarter_mean(buf, w, h, q, op, qm[q*24..q*24+24]);
        q = q + 1;
    }
    let q0r:i64 = t_get64(qm, 0); let q0g:i64 = t_get64(qm, 8); let q0b:i64 = t_get64(qm, 16);
    let q1r:i64 = t_get64(qm, 24); let q1g:i64 = t_get64(qm, 32); let q1b:i64 = t_get64(qm, 40);
    let q2r:i64 = t_get64(qm, 48); let q2g:i64 = t_get64(qm, 56); let q2b:i64 = t_get64(qm, 64);
    let q3r:i64 = t_get64(qm, 72); let q3g:i64 = t_get64(qm, 80); let q3b:i64 = t_get64(qm, 88);
    let d_top:i64 = rgb_dist(q0r, q0g, q0b, q2r, q2g, q2b);
    let d_bot:i64 = rgb_dist(q1r, q1g, q1b, q3r, q3g, q3b);
    let d_lo:i64 = imin(d_top, d_bot);
    let d_hi:i64 = imax(d_top, d_bot);
    let d_mid:i64 = (d_lo + d_hi) / 2;
    let mg:i64 = iabs(d_mid - 40);
    let sup:i64 = 1000 * mg / (mg + 60);
    let straddle:i32 = 0;
    if((d_top > 40 && d_bot <= 40) || (d_bot > 40 && d_top <= 40)) { straddle = 1; }
    let pred:i64 = 4;
    if(d_lo > 40) { pred = 5; }
    if(d_lo <= 40 && d_hi > 40 && d_mid > 40) { pred = 5; }
    let con:i64 = 0;
    if(straddle == 1) { con = 1000 * iabs(d_top - d_bot) / (iabs(d_top - d_bot) + 120); }
    // second witness: 4-bin histogram L1 distance between halves
    let h0:[]u8 = nio_alloc(96);
    let h1a:[]u8 = nio_alloc(96);
    img_hist4(buf, w, h, 0, op, h0);
    img_hist4(buf, w, h, 1, op, h1a);
    let hd:i64 = 0;
    let i:i32 = 0;
    while(i < 12) {
        hd = hd + iabs(t_get64(h0, i * 8) - t_get64(h1a, i * 8));
        i = i + 1;
    }
    op_add(op, 12);
    let np:i64 = (hw as i64) * (h as i64);
    let hist_d:i64 = hd * 500 / np;
    let pred_h:i64 = 4;
    if(hist_d > 120) { pred_h = 5; }
    let mh:i64 = iabs(hist_d - 120);
    let sup_h:i64 = 1000 * mh / (mh + 200);
    if(pred_h != pred && con < 500) { con = 500; }
    nio_free(h0); nio_free(h1a);
    // deliberation re-check on contradiction: iterative row trimming
    let rechecked:i32 = 0;
    let d_old:i64 = d_mid;
    let orig_con:i64 = con;
    if(con > 0) {
        rechecked = 1;
        let rd:[]u8 = nio_alloc(h * 8);
        if(rd.len > 0) {
            let y:i32 = 0;
            while(y < h) {
                let lr:i64 = 0; let lg:i64 = 0; let lb:i64 = 0;
                let rr:i64 = 0; let rg:i64 = 0; let rb:i64 = 0;
                let x:i32 = 0;
                while(x < hw) {
                    let o1:i32 = 8 + (y * w + x) * 3;
                    lr = lr + (buf[o1] as i64); lg = lg + (buf[o1+1] as i64); lb = lb + (buf[o1+2] as i64);
                    let o2:i32 = 8 + (y * w + hw + x) * 3;
                    rr = rr + (buf[o2] as i64); rg = rg + (buf[o2+1] as i64); rb = rb + (buf[o2+2] as i64);
                    x = x + 1;
                }
                op_add(op, (2 * hw) as i64);
                t_put64(rd, y * 8, rgb_dist(lr / (hw as i64), lg / (hw as i64), lb / (hw as i64),
                                           rr / (hw as i64), rg / (hw as i64), rb / (hw as i64)));
                y = y + 1;
            }
            let cur:i64 = d_mid;
            let it:i32 = 0;
            while(it < 2) {
                // recompute half-mean distance over kept rows (rd <= cur)
                let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
                let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
                let nk:i64 = 0;
                y = 0;
                while(y < h) {
                    if(t_get64(rd, y * 8) <= cur) {
                        let x:i32 = 0;
                        while(x < hw) {
                            let o1:i32 = 8 + (y * w + x) * 3;
                            s1r = s1r + (buf[o1] as i64); s1g = s1g + (buf[o1+1] as i64); s1b = s1b + (buf[o1+2] as i64);
                            let o2:i32 = 8 + (y * w + hw + x) * 3;
                            s2r = s2r + (buf[o2] as i64); s2g = s2g + (buf[o2+1] as i64); s2b = s2b + (buf[o2+2] as i64);
                            x = x + 1;
                        }
                        nk = nk + (hw as i64);
                    }
                    y = y + 1;
                }
                op_add(op, (h as i64) * (hw as i64));
                if(nk > 0) {
                    cur = rgb_dist(s1r / nk, s1g / nk, s1b / nk, s2r / nk, s2g / nk, s2b / nk);
                }
                it = it + 1;
            }
            nio_free(rd);
            d_mid = cur;
            mg = iabs(d_mid - 40);
            sup = 1000 * mg / (mg + 60);
            pred = 4;
            if(d_mid > 40) { pred = 5; }
            // straddle re-evaluated on trimmed pairs is skipped; use margin
            if(sup > 1000 * iabs(d_old - 40) / (iabs(d_old - 40) + 60)) {
                straddle = 0;
                if(pred_h != pred) { con = 500; }
                if(pred_h == pred) { con = 0; }
            }
        }
    }
    nio_free(qm);
    // judgment: argmax support between refined mean witness and hist witness
    let judg:i64 = 0;
    if(pred == 5) { judg = 1; }
    if(con > 0) {
        // deliberation: pick better-supported witness
        if(sup_h > sup) {
            judg = 0;
            if(pred_h == 5) { judg = 1; }
            pred = pred_h;
            sup = sup_h;
        }
    }
    let corroborated:i32 = 0;
    if(straddle == 0 && pred_h == pred) { corroborated = 1; }
    // ---- events ----
    let lm:[]u8 = nio_alloc(16);
    img_half_lumad(buf, w, h, 0, op, lm);
    let lmean:i64 = t_get64(lm, 0); let lmad:i64 = t_get64(lm, 8);
    img_half_lumad(buf, w, h, 1, op, lm);
    let rmean:i64 = t_get64(lm, 0); let rmad:i64 = t_get64(lm, 8);
    nio_free(lm);
    let hpx:i64 = (hw as i64) * (h as i64);
    let qpx:i64 = (hw as i64) * (hh as i64);
    ev_init(ev, ne);
    ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, hpx);
    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 1);
    ev_put(ev, ne, 6, 2);
    ev_put(ev, ne, 7, lmean - lmad); ev_put(ev, ne, 8, lmean + lmad);
    ev_wit(ev, ne, 1, 0, hpx);
    ev_put(ev, ne, 22, 900); ev_put(ev, ne, 23, 0);
    ev_hash_id(ev, ne, 1); ne = ne + 1;
    ev_init(ev, ne);
    ev_put(ev, ne, 2, hpx); ev_put(ev, ne, 3, 2 * hpx);
    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 1);
    ev_put(ev, ne, 6, 2);
    ev_put(ev, ne, 7, rmean - rmad); ev_put(ev, ne, 8, rmean + rmad);
    ev_wit(ev, ne, 1, hpx, hpx);
    ev_put(ev, ne, 22, 900); ev_put(ev, ne, 23, 0);
    ev_hash_id(ev, ne, 1); ne = ne + 1;
    // relation event (mean witness, possibly re-checked)
    ev_init(ev, ne);
    let top:i32 = ne;
    ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, 2 * hpx);
    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
    ev_put(ev, ne, 6, pred);
    ev_put(ev, ne, 7, imin(d_lo, d_mid)); ev_put(ev, ne, 8, imax(d_hi, d_mid));
    ev_wit(ev, ne, 1, 0, qpx);
    ev_wit(ev, ne, 1, (hh as i64) * (w as i64), qpx);
    ev_wit(ev, ne, 1, hw as i64, qpx);
    ev_wit(ev, ne, 1, (hh as i64) * (w as i64) + (hw as i64), qpx);
    ev_put(ev, ne, 22, sup); ev_put(ev, ne, 23, con);
    if(pred == 4) { ev_alt(ev, ne, 5, 1000 - sup); }
    if(pred == 5) { ev_alt(ev, ne, 4, 1000 - sup); }
    ev_hash_id(ev, ne, 1); ne = ne + 1;
    // histogram relation event
    ev_init(ev, ne);
    ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, 2 * hpx);
    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
    ev_put(ev, ne, 6, pred_h);
    ev_put(ev, ne, 7, hist_d); ev_put(ev, ne, 8, hist_d);
    ev_wit(ev, ne, 1, 0, hpx);
    ev_wit(ev, ne, 1, hpx, hpx);
    ev_put(ev, ne, 22, sup_h); ev_put(ev, ne, 23, 0);
    if(pred_h == 4) { ev_alt(ev, ne, 5, 1000 - sup_h); }
    if(pred_h == 5) { ev_alt(ev, ne, 4, 1000 - sup_h); }
    ev_hash_id(ev, ne, 1); ne = ne + 1;
    if(rechecked == 1) {
        ev_init(ev, ne);
        ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, 2 * hpx);
        ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
        ev_put(ev, ne, 6, 3); // TRANSITION: the re-check itself
        ev_put(ev, ne, 7, imin(d_old, d_mid)); ev_put(ev, ne, 8, imax(d_old, d_mid));
        ev_wit(ev, ne, 1, 0, 2 * hpx);
        ev_put(ev, ne, 22, 700); ev_put(ev, ne, 23, 0);
        ev_hash_id(ev, ne, 1); ne = ne + 1;
    }
    t_put64(res, 0, top as i64); t_put64(res, 8, judg);
    t_put64(res, 16, corroborated as i64); t_put64(res, 24, ne as i64);
    t_put64(res, 32, rechecked as i64);
    let resolved1:i32 = 0;
    if(rechecked == 1 && con == 0) { resolved1 = 1; }
    t_put64(res, 40, resolved1 as i64);
    t_put64(res, 48, orig_con);
    return;
}
// ================= TASK 5: timbredisc ======================================
// judg: 0=PURE 1=BRIGHT 2=DARK 3=RICH
fn tb_class(r:i64) i64 {
    if(r < 1075) { return 0; }
    if(r < 1400) { return 2; }
    if(r < 3000) { return 3; }
    return 1;
}
fn tb_margin(r:i64, c:i64) i64 {
    let b0:i64 = 1075; let b1:i64 = 1400; let b2:i64 = 3000;
    if(c == 0) { return b0 - r; }
    if(c == 2) { return imin(r - b0, b1 - r); }
    if(c == 3) { return imin(r - b1, b2 - r); }
    return r - b2;
}
// ================= TASK 6: motiondir =======================================
// judg: 0=STILL 1=N 2=NE 3=E 4=SE 5=S 6=SW 7=W 8=NW
fn m_octant(dx:i64, dy:i64) i64 {
    let ax:i64 = iabs(dx); let ay:i64 = iabs(dy);
    let mag:i64 = ax;
    if(ay > mag) { mag = ay; }
    if(mag < 1) { return 0; }
    if(ax >= 2 * ay) { if(dx > 0) { return 3; } return 7; }
    if(ay >= 2 * ax) { if(dy > 0) { return 5; } return 1; }
    if(dx > 0 && dy < 0) { return 2; }
    if(dx > 0 && dy > 0) { return 4; }
    if(dx < 0 && dy > 0) { return 6; }
    return 8;
}
// changed-pixel centroid between frames f0,f1 at threshold thr
fn mcent_thr(buf:[]u8, f0:i32, f1:i32, nf:i32, w:i32, h:i32, thr:i32, op:[]u8, out3:[]u8) void {
    let fsz:i32 = w * h;
    let b0:i32 = 8 + nf * 4 + f0 * fsz;
    let b1:i32 = 8 + nf * 4 + f1 * fsz;
    let mc:i64 = 0; let sx:i64 = 0; let sy:i64 = 0;
    let p:i32 = 0;
    while(p < fsz) {
        let o0:i32 = b0 + p * 3;
        let o1:i32 = b1 + p * 3;
        let d:i64 = iabs((buf[o0] as i64) - (buf[o1] as i64))
                  + iabs((buf[o0+1] as i64) - (buf[o1+1] as i64))
                  + iabs((buf[o0+2] as i64) - (buf[o1+2] as i64));
        if(d > thr) {
            mc = mc + 1;
            sx = sx + ((p % w) as i64);
            sy = sy + ((p / w) as i64);
        }
        p = p + 1;
    }
    op_add(op, fsz as i64);
    t_put64(out3, 0, mc);
    if(mc > 0) { t_put64(out3, 8, sx / mc); t_put64(out3, 16, sy / mc); }
    if(mc == 0) { t_put64(out3, 8, 0); t_put64(out3, 16, 0); }
}
// changed-pixel centroid restricted to left/right half (half=0 left,1 right)
fn mcent_half(buf:[]u8, f0:i32, f1:i32, nf:i32, w:i32, h:i32, thr:i32, half:i32, op:[]u8, out3:[]u8) void {
    let fsz:i32 = w * h;
    let b0:i32 = 8 + nf * 4 + f0 * fsz;
    let b1:i32 = 8 + nf * 4 + f1 * fsz;
    let mc:i64 = 0; let sx:i64 = 0; let sy:i64 = 0;
    let p:i32 = 0;
    while(p < fsz) {
        let x:i32 = p % w;
        let inhalf:i32 = 0;
        if(half == 0 && x < w / 2) { inhalf = 1; }
        if(half == 1 && x >= w / 2) { inhalf = 1; }
        if(inhalf == 1) {
            let o0:i32 = b0 + p * 3;
            let o1:i32 = b1 + p * 3;
            let d:i64 = iabs((buf[o0] as i64) - (buf[o1] as i64))
                      + iabs((buf[o0+1] as i64) - (buf[o1+1] as i64))
                      + iabs((buf[o0+2] as i64) - (buf[o1+2] as i64));
            if(d > thr) {
                mc = mc + 1;
                sx = sx + (x as i64);
                sy = sy + ((p / w) as i64);
            }
        }
        p = p + 1;
    }
    op_add(op, fsz as i64);
    t_put64(out3, 0, mc);
    if(mc > 0) { t_put64(out3, 8, sx / mc); t_put64(out3, 16, sy / mc); }
    if(mc == 0) { t_put64(out3, 8, 0); t_put64(out3, 16, 0); }
}
// ================= memory contract =========================================
// judgment names per task
fn judg_name(taskid:i32, judg:i64, ob:[]u8, pos:i32) i32 {
    if(taskid == 1) {
        if(judg == 0) { return ob_add(ob, pos, "SAME"); }
        return ob_add(ob, pos, "DIFFERENT");
    }
    if(taskid == 2) {
        if(judg == 0) { return ob_add(ob, pos, "SAME_SURFACE"); }
        return ob_add(ob, pos, "DIFFERENT");
    }
    if(taskid == 3) {
        if(judg == 0) { return ob_add(ob, pos, "CIRCLE"); }
        if(judg == 1) { return ob_add(ob, pos, "TRIANGLE"); }
        return ob_add(ob, pos, "SQUARE");
    }
    if(taskid == 4) {
        if(judg == 0) { return ob_add(ob, pos, "SAME"); }
        if(judg == 1) { return ob_add(ob, pos, "HIGHER"); }
        return ob_add(ob, pos, "LOWER");
    }
    if(taskid == 5) {
        if(judg == 0) { return ob_add(ob, pos, "PURE"); }
        if(judg == 1) { return ob_add(ob, pos, "BRIGHT"); }
        if(judg == 2) { return ob_add(ob, pos, "DARK"); }
        return ob_add(ob, pos, "RICH");
    }
    if(judg == 0) { return ob_add(ob, pos, "STILL"); }
    if(judg == 1) { return ob_add(ob, pos, "N"); }
    if(judg == 2) { return ob_add(ob, pos, "NE"); }
    if(judg == 3) { return ob_add(ob, pos, "E"); }
    if(judg == 4) { return ob_add(ob, pos, "SE"); }
    if(judg == 5) { return ob_add(ob, pos, "S"); }
    if(judg == 6) { return ob_add(ob, pos, "SW"); }
    if(judg == 7) { return ob_add(ob, pos, "W"); }
    return ob_add(ob, pos, "NW");
}
fn task_name(taskid:i32, ob:[]u8, pos:i32) i32 {
    if(taskid == 1) { return ob_add(ob, pos, "colordisc"); }
    if(taskid == 2) { return ob_add(ob, pos, "colorconst"); }
    if(taskid == 3) { return ob_add(ob, pos, "shapetrans"); }
    if(taskid == 4) { return ob_add(ob, pos, "pitchdisc"); }
    if(taskid == 5) { return ob_add(ob, pos, "timbredisc"); }
    return ob_add(ob, pos, "motiondir");
}
fn disp_name(d:i32, ob:[]u8, pos:i32) i32 {
    if(d == 0) { return ob_add(ob, pos, "WITHHELD"); }
    if(d == 1) { return ob_add(ob, pos, "PROVISIONAL"); }
    return ob_add(ob, pos, "INSTALL");
}
// warrant threshold per task (per-mille support)
fn tmod(taskid:i32) i64 {
    if(taskid == 1) { return 300; }
    if(taskid == 2) { return 300; }
    if(taskid == 3) { return 250; }
    if(taskid == 4) { return 300; }
    if(taskid == 5) { return 300; }
    return 200;
}
// idx-th '|' field of line -> out, returns length
fn field(line:[]u8, idx:i32, out:[]u8) i32 {
    let f:i32 = 0;
    let i:i32 = 0;
    let o:i32 = 0;
    while(i < line.len) {
        let c:i32 = line[i] as i32;
        if(c == 124) {
            f = f + 1;
            if(f > idx) { break; }
            i = i + 1;
        }
        if(c != 124) {
            if(f == idx) { out[o] = line[i]; o = o + 1; }
            i = i + 1;
        }
    }
    return o;
}
// memory entry: 14 i64s: seq,task,judg,pred,alo,ahi,sup,w0mod,w0s,w0l,w1mod,w1s,w1l,mark
fn mem_entry_put(ar:[]u8, i:i32, f:i32, v:i64) void {
    t_put64(ar, (i * 14 + f) * 8, v);
}
fn mem_entry_get(ar:[]u8, i:i32, f:i32) i64 {
    return t_get64(ar, (i * 14 + f) * 8);
}
// load a memory file into arena; returns count (cap enforced).
// load a memory file into arena; returns count (cap enforced).
// want_names=1: also copies field 14 (fixture name) into names (cap*256).
fn mem_load(path:[]u8, ar:[]u8, cap:i32, names:[]u8, want_names:i32) i32 {
    let data:[]u8 = nio_alloc(1 << 20);
    if(data.len == 0) { return 0; }
    let nr:i64 = z_read(path, data, 1 << 20);
    let cnt:i32 = 0;
    if(nr <= 0) { nio_free(data); return 0; }
    let len:i32 = nr as i32;
    let tmp:[]u8 = nio_alloc(512);
    let pos:i32 = 0;
    while(pos < len && cnt < cap) {
        let eol:i32 = pos;
        while(eol < len && data[eol] != 10) { eol = eol + 1; }
        if(eol > pos) {
            let line:[]u8 = data[pos..eol];
            let ok:i32 = 1;
            let f:i32 = 0;
            while(f < 14) {
                let fl:i32 = field(line, f, tmp);
                if(fl == 0) { ok = 0; }
                if(fl > 0) {
                    mem_entry_put(ar, cnt, f, parse_i64(tmp[0..fl]));
                }
                f = f + 1;
            }
            if(want_names == 1) {
                let nl:i32 = field(line, 14, tmp);
                let base:i32 = cnt * 256;
                let k:i32 = 0;
                while(k < nl && k < 255) { names[base + k] = tmp[k]; k = k + 1; }
                names[base + k] = 0;
            }
            if(ok == 1) { cnt = cnt + 1; }
        }
        pos = eol + 1;
    }
    nio_free(tmp);
    nio_free(data);
    return cnt;
}
// save count entries from arena to path (overwrite). want_names=1 appends
// field 14 from names (fixture string, NUL-terminated in 256-byte slots).
fn mem_save(path:[]u8, ar:[]u8, cnt:i32, names:[]u8, want_names:i32) void {
    let ob:[]u8 = nio_alloc(1 << 20);
    if(ob.len == 0) { return; }
    let pos:i32 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let f:i32 = 0;
        while(f < 14) {
            pos = ob_add(ob, pos, _zag_i64_to_str(mem_entry_get(ar, i, f)));
            ob[pos] = 124; pos = pos + 1;
            f = f + 1;
        }
        if(want_names == 1) {
            let base:i32 = i * 256;
            let k:i32 = 0;
            while(names[base + k] != 0 && k < 255) { ob[pos] = names[base + k]; pos = pos + 1; k = k + 1; }
        }
        if(want_names == 0) {
            pos = pos - 1; // drop trailing '|' when no name follows
        }
        ob[pos] = 10; pos = pos + 1;
        i = i + 1;
    }
    z_write_trunc(path, ob, pos);
    nio_free(ob);
}
// witness addressability: can the memory system point at this witness?
fn wit_ok1(taskid:i32, buf:[]u8, wmod:i64, ws:i64, wl:i64) i32 {
    if(wmod == -1) { return 1; }
    if(wmod < 1 || wmod > 3) { return 0; }
    if(ws < 0 || wl <= 0) { return 0; }
    let extent:i64 = 0;
    if(wmod == 1) {
        let w:i64 = t_get32(buf, 0) as i64;
        let h:i64 = t_get32(buf, 4) as i64;
        extent = w * h;
    }
    if(wmod == 2) {
        let cnt:i64 = t_get32(buf, 4) as i64;
        extent = 8 + cnt * 2;
    }
    if(wmod == 3) {
        let nf:i64 = t_get32(buf, 0) as i64;
        let w:i64 = t_get32(buf, 4) as i64;
        let h:i64 = t_get32(buf, 8) as i64;
        extent = 8 + nf * 4 + nf * w * h * 3;
    }
    if(ws + wl <= extent) { return 1; }
    return 0;
}
// ================= TASK 3: shapetrans ======================================
// judg: 0=CIRCLE 1=TRIANGLE 2=SQUARE
// res: [0]=top [8]=judg [16]=corroborated [24]=nev [32]=rechecked [40]=resolved
fn shape_classify(r:i64) i64 {
    let dc:i64 = iabs(r - 1000);
    let ds:i64 = iabs(r - 637);
    let dt:i64 = iabs(r - 414);
    let c:i64 = 0;
    let b:i64 = dc;
    if(ds < b) { c = 2; b = ds; }
    if(dt < b) { c = 1; }
    return c;
}
fn shape_margin(r:i64, c:i64) i64 {
    let dw:i64 = iabs(r - 1000);
    if(c == 1) { dw = iabs(r - 414); }
    if(c == 2) { dw = iabs(r - 637); }
    let do:i64 = 1000000;
    if(c != 0) { let d:i64 = iabs(r - 1000); if(d < do) { do = d; } }
    if(c != 1) { let d:i64 = iabs(r - 414); if(d < do) { do = d; } }
    if(c != 2) { let d:i64 = iabs(r - 637); if(d < do) { do = d; } }
    return do - dw;
}
fn xt_shapetrans(buf:[]u8, n:i32, op:[]u8, ev:[]u8, res:[]u8) void {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    let ne:i32 = 0;
    let top:i32 = 0;
    let judg:i64 = 0;
    let corroborated:i32 = 0;
    let rechecked:i32 = 0;
    let resolved:i32 = 0;
    let orig_con:i64 = 0;
    if(w >= 2 && h >= 2 && 8 + (w as i64) * (h as i64) * 3 <= n as i64) {
        let fsz:i64 = (w as i64) * (h as i64);
        let fb:i32 = shape_fgbright(buf, w, h, 382, op);
        let mask:[]u8 = nio_alloc(fsz as i32);
        if(mask.len > 0) {
            shape_mask_array(buf, w, h, fb, 382, op, mask);
            let m0:[]u8 = nio_alloc(32);
            mask_stats(mask, w, h, 0, 0, h, op, m0);
            let area:i64 = t_get64(m0, 0);
            if(area >= 9) {
                let r0:i64 = t_get64(m0, 24);
                let cx0:i64 = t_get64(m0, 8);
                let cy0:i64 = t_get64(m0, 16);
                let c1:i64 = shape_classify(r0);
                let m1:[]u8 = nio_alloc(32);
                mask_stats(mask, w, h, 1, 0, h, op, m1);
                let r1:i64 = t_get64(m1, 24);
                let c2:i64 = shape_classify(r1);
                nio_free(m1);
                let rs:i64 = radial_sig(mask, w, h, cx0, cy0, op);
                let c3:i64 = shape_classify(rs);
                nio_free(m0);
                // majority vote over the three witnesses
                let cf:i64 = c1;
                if(c2 == c3) { cf = c2; }
                let agree:i32 = 0;
                if(c1 == c2 && c2 == c3) { agree = 1; }
                let margin:i64 = shape_margin(r0, cf);
                let sup:i64 = 0;
                if(margin > 0) { sup = 1000 * margin / (margin + 150); }
                let con:i64 = 0;
                if(agree == 0) { con = 600; }
                if(margin < 80 && con < 400) { con = 400; }
                // deliberation re-check: occlusion infill, then alt thresholds
                orig_con = con;
                if(con > 0) {
                    rechecked = 1;
                    let adopted:i32 = 0;
                    let m2:[]u8 = nio_alloc(fsz as i32);
                    if(m2.len > 0) {
                        let k:i32 = 0;
                        while(k < fsz as i32) { m2[k] = mask[k]; k = k + 1; }
                        op_add(op, fsz);
                        let o2:[]u8 = nio_alloc(16);
                        occl_fill(m2, w, h, op, o2);
                        let band:i64 = t_get64(o2, 0);
                        nio_free(o2);
                        if(band != -1) {
                            let m3:[]u8 = nio_alloc(32);
                            mask_stats(m2, w, h, 0, 0, h, op, m3);
                            let rf:i64 = t_get64(m3, 24);
                            let af:i64 = t_get64(m3, 0);
                            nio_free(m3);
                            if(af >= 9) {
                                let cfi:i64 = shape_classify(rf);
                                let marginf:i64 = shape_margin(rf, cfi);
                                if(marginf > 150 && marginf > margin) {
                                    cf = cfi; margin = marginf;
                                    sup = 1000 * margin / (margin + 150);
                                    con = 0; adopted = 1;
                                }
                            }
                        }
                        nio_free(m2);
                    }
                    if(adopted == 0) {
                        let th:i64 = 300;
                        let ti:i32 = 0;
                        while(ti < 2) {
                            let fb2:i32 = shape_fgbright(buf, w, h, th, op);
                            let mk:[]u8 = nio_alloc(fsz as i32);
                            if(mk.len > 0) {
                                shape_mask_array(buf, w, h, fb2, th, op, mk);
                                let m4:[]u8 = nio_alloc(32);
                                mask_stats(mk, w, h, 0, 0, h, op, m4);
                                let a4:i64 = t_get64(m4, 0);
                                let r4:i64 = t_get64(m4, 24);
                                nio_free(m4);
                                nio_free(mk);
                                if(a4 >= 9) {
                                    let c4:i64 = shape_classify(r4);
                                    let m4g:i64 = shape_margin(r4, c4);
                                    if(m4g > 200 && m4g > margin) {
                                        cf = c4; margin = m4g;
                                        sup = 1000 * margin / (margin + 150);
                                        con = 0; adopted = 1;
                                    }
                                }
                            }
                            th = 460;
                            ti = ti + 1;
                        }
                    }
                    if(adopted == 1) { resolved = 1; }
                    if(adopted == 0) { con = 700; }
                }
                judg = cf;
                let wc:i32 = 0;
                if(c1 == cf) { wc = wc + 1; }
                if(c2 == cf) { wc = wc + 1; }
                if(c3 == cf) { wc = wc + 1; }
                if(wc >= 2 && con == 0) { corroborated = 1; }
                // ---- events ----
                ev_init(ev, ne);
                ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, fsz);
                ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                ev_put(ev, ne, 6, 7 + c1);
                ev_put(ev, ne, 7, r0 - 60); ev_put(ev, ne, 8, r0 + 60);
                ev_wit(ev, ne, 1, 0, fsz / 2);
                ev_put(ev, ne, 22, 600); ev_put(ev, ne, 23, 0);
                ev_alt(ev, ne, 7 + ((c1 + 1) % 3), 300);
                ev_alt(ev, ne, 7 + ((c1 + 2) % 3), 300);
                ev_hash_id(ev, ne, 3); ne = ne + 1;
                ev_init(ev, ne);
                ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, fsz);
                ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                ev_put(ev, ne, 6, 7 + c2);
                ev_put(ev, ne, 7, r1 - 60); ev_put(ev, ne, 8, r1 + 60);
                ev_wit(ev, ne, 1, fsz / 2, fsz - fsz / 2);
                ev_put(ev, ne, 22, 600); ev_put(ev, ne, 23, 0);
                ev_alt(ev, ne, 7 + ((c2 + 1) % 3), 300);
                ev_alt(ev, ne, 7 + ((c2 + 2) % 3), 300);
                ev_hash_id(ev, ne, 3); ne = ne + 1;
                ev_init(ev, ne);
                ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, fsz);
                ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                ev_put(ev, ne, 6, 7 + c3);
                ev_put(ev, ne, 7, rs - 40); ev_put(ev, ne, 8, rs + 40);
                ev_wit(ev, ne, 1, fsz / 4, fsz / 2);
                ev_put(ev, ne, 22, 600); ev_put(ev, ne, 23, 0);
                ev_alt(ev, ne, 7 + ((c3 + 1) % 3), 300);
                ev_alt(ev, ne, 7 + ((c3 + 2) % 3), 300);
                ev_hash_id(ev, ne, 3); ne = ne + 1;
                // final shape event (top)
                ev_init(ev, ne);
                top = ne;
                ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, fsz);
                ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                ev_put(ev, ne, 6, 7 + cf);
                ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 1000);
                ev_wit(ev, ne, 1, 0, fsz);
                ev_put(ev, ne, 22, sup); ev_put(ev, ne, 23, con);
                ev_alt(ev, ne, 7 + ((cf + 1) % 3), 1000 - sup);
                ev_alt(ev, ne, 7 + ((cf + 2) % 3), 1000 - sup);
                ev_hash_id(ev, ne, 3); ne = ne + 1;
                if(rechecked == 1) {
                    ev_init(ev, ne);
                    ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, fsz);
                    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                    ev_put(ev, ne, 6, 3);
                    ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 1000);
                    ev_wit(ev, ne, 1, 0, fsz);
                    ev_put(ev, ne, 22, 700); ev_put(ev, ne, 23, 0);
                    ev_hash_id(ev, ne, 3); ne = ne + 1;
                }
            }
            nio_free(mask);
        }
    }
    if(ne == 0) {
        ev_init(ev, 0); ne = 1; top = 0;
        ev_put(ev, 0, 2, 0); ev_put(ev, 0, 3, 1);
        ev_put(ev, 0, 4, 0); ev_put(ev, 0, 5, 0);
        ev_put(ev, 0, 6, 7);
        ev_put(ev, 0, 7, 0); ev_put(ev, 0, 8, 0);
        ev_wit(ev, 0, 1, 0, 1);
        ev_put(ev, 0, 22, 0); ev_put(ev, 0, 23, 1000);
        ev_hash_id(ev, 0, 3);
        judg = 0;
        orig_con = 1000;
    }
    t_put64(res, 0, top as i64); t_put64(res, 8, judg);
    t_put64(res, 16, corroborated as i64); t_put64(res, 24, ne as i64);
    t_put64(res, 32, rechecked as i64); t_put64(res, 40, resolved as i64);
    t_put64(res, 48, orig_con);
    return;
}
// ================= TASK 4: pitchdisc =======================================
// judg: 0=SAME 1=HIGHER 2=LOWER
// res: [0]=top [8]=judg [16]=corroborated [24]=nev [32]=rechecked [40]=resolved
fn xt_pitchdisc(buf:[]u8, n:i32, op:[]u8, ev:[]u8, res:[]u8) void {
    let sr:i64 = t_get32(buf, 0) as i64;
    let cnt:i64 = t_get32(buf, 4) as i64;
    let ne:i32 = 0;
    let top:i32 = 0;
    let judg:i64 = 0;
    let corroborated:i32 = 0;
    let rechecked:i32 = 0;
    let resolved:i32 = 0;
    let orig_con:i64 = 0;
    if(sr > 0 && cnt > 64 && 8 + cnt * 2 <= n as i64) {
        let ci:i32 = cnt as i32;
        let sp:[]u8 = nio_alloc(128);
        if(sp.len > 0) {
            let nsp:i32 = env_spans(buf, 8, ci, 320, op, sp);
            let a0:i64 = 0; let a1:i64 = ci as i64;
            let b0:i64 = 0; let b1:i64 = 0;
            let onset_con:i64 = 0;
            if(nsp == 2) {
                a0 = t_get64(sp, 0); a1 = t_get64(sp, 8);
                b0 = t_get64(sp, 16); b1 = t_get64(sp, 24);
                if(a0 > 2000) { onset_con = 500; }
            }
            nio_free(sp);
            if(a1 - a0 > 320 && b1 - b0 > 320) {
                let amid:i64 = (a0 + a1) / 2;
                let bmid:i64 = (b0 + b1) / 2;
                let f0A1:i64 = f0_coarse(buf, (8 + a0 * 2) as i32, (amid - a0) as i32, sr, op);
                let f0A2:i64 = f0_coarse(buf, (8 + amid * 2) as i32, (a1 - amid) as i32, sr, op);
                let f0B1:i64 = f0_coarse(buf, (8 + b0 * 2) as i32, (bmid - b0) as i32, sr, op);
                let f0B2:i64 = f0_coarse(buf, (8 + bmid * 2) as i32, (b1 - bmid) as i32, sr, op);
                if(f0A1 <= 0) { f0A1 = 440000; }
                if(f0A2 <= 0) { f0A2 = 440000; }
                if(f0B1 <= 0) { f0B1 = 440000; }
                if(f0B2 <= 0) { f0B2 = 440000; }
                let sA0:i64 = 8 + a0 * 2; let wA:i64 = (a1 - a0) * 2;
                let sB0:i64 = 8 + b0 * 2; let wB:i64 = (b1 - b0) * 2;
                // witness 1: sustain (half-stability within A)
                let sta:i64 = 1000 * iabs(f0A1 - f0A2) / f0A1;
                if(sta > 1000) { sta = 1000; }
                let sup1:i64 = 0;
                if(sta < 100) { sup1 = 1000 * (100 - sta) / 100; }
                // witness 2: interval A->B (refined f0)
                let f0Ar:i64 = f0_refine(buf, sA0 as i32, (a1 - a0) as i32, sr, f0A1, op);
                let f0Br:i64 = f0_refine(buf, sB0 as i32, (b1 - b0) as i32, sr, f0B1, op);
                let rel:i64 = 1000 * (f0Br - f0Ar) / f0Ar;
                let arel:i64 = iabs(rel);
                let sup2:i64 = 0;
                let pred:i64 = 12;
                if(arel < 40) { pred = 12; sup2 = 1000 * (40 - arel) / 40; }
                if(rel >= 40) { pred = 10; sup2 = 1000 * arel / (arel + 120); }
                if(rel <= -40) { pred = 11; sup2 = 1000 * arel / (arel + 120); }
                let judgw:i64 = pred - 12; // 12->0, 10->-2?? no:
                judg = 0;
                if(pred == 10) { judg = 1; }
                if(pred == 11) { judg = 2; }
                let con:i64 = onset_con;
                let stab_con:i64 = 0;
                if(sta > 300) { stab_con = 500; }
                con = con + stab_con;
                if(con > 1000) { con = 1000; }
                orig_con = con;
                let sup:i64 = (sup1 + sup2) / 2;
                // re-check: extend A window by 640 samples each side
                if(con > 0 && con < 1000) {
                    rechecked = 1;
                    let ea0:i64 = a0 - 640;
                    if(ea0 < 0) { ea0 = 0; }
                    let ea1:i64 = a1 + 640;
                    if(ea1 > cnt) { ea1 = cnt; }
                    let ef0:i64 = f0_refine(buf, (8 + ea0 * 2) as i32, (ea1 - ea0) as i32, sr, f0A1, op);
                    let rel2:i64 = 1000 * (f0Br - ef0) / ef0;
                    let pred2:i64 = 12;
                    if(rel2 >= 40) { pred2 = 10; }
                    if(rel2 <= -40) { pred2 = 11; }
                    if(pred2 == pred) {
                        resolved = 1;
                        con = 0;
                        corroborated = 1;
                        sup = (sup + 700) / 2;
                    }
                    if(pred2 != pred) { con = 800; sup = 200; judg = 0; if(pred2 == 10) { judg = 1; } if(pred2 == 11) { judg = 2; } }
                }
                if(sta < 100 && con == 0) { corroborated = 1; }
                // ---- events ----
                ev_init(ev, ne);
                ev_put(ev, ne, 2, a0); ev_put(ev, ne, 3, a1);
                ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                ev_put(ev, ne, 6, 1);
                ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 200);
                ev_wit(ev, ne, 2, a0, 320);
                ev_put(ev, ne, 22, sup1); ev_put(ev, ne, 23, stab_con);
                ev_hash_id(ev, ne, 4); ne = ne + 1;
                ev_init(ev, ne);
                ev_put(ev, ne, 2, b0); ev_put(ev, ne, 3, b1);
                ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                ev_put(ev, ne, 6, 2);
                ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 200);
                ev_wit(ev, ne, 2, b0, 320);
                ev_put(ev, ne, 22, sup1); ev_put(ev, ne, 23, 0);
                ev_hash_id(ev, ne, 4); ne = ne + 1;
                // onset event only when there is evidence
                if(onset_con > 0) {
                    ev_init(ev, ne);
                    ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, a0);
                    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                    ev_put(ev, ne, 6, 1);
                    ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 500);
                    ev_wit(ev, ne, 2, 0, 160);
                    ev_put(ev, ne, 22, 0); ev_put(ev, ne, 23, onset_con);
                    ev_hash_id(ev, ne, 4); ne = ne + 1;
                }
                // top interval event
                ev_init(ev, ne);
                top = ne;
                ev_put(ev, ne, 2, a0); ev_put(ev, ne, 3, b1);
                ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                ev_put(ev, ne, 6, pred);
                ev_put(ev, ne, 7, rel - 30); ev_put(ev, ne, 8, rel + 30);
                ev_wit(ev, ne, 2, a0, a1 - a0);
                ev_wit(ev, ne, 2, b0, b1 - b0);
                ev_put(ev, ne, 22, sup); ev_put(ev, ne, 23, con);
                let alt1:i64 = 12;
                if(pred == 12) { alt1 = 10; }
                ev_alt(ev, ne, alt1, 1000 - sup);
                let alt2:i64 = 12;
                if(pred == 12) { alt2 = 11; }
                if(pred == 10) { alt2 = 11; }
                if(pred == 11) { alt2 = 10; }
                ev_alt(ev, ne, alt2, (1000 - sup) / 2);
                ev_hash_id(ev, ne, 4); ne = ne + 1;
                if(rechecked == 1) {
                    ev_init(ev, ne);
                    ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, cnt);
                    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
                    ev_put(ev, ne, 6, 3);
                    ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 500);
                    ev_wit(ev, ne, 2, a0, a1 - a0 + 640);
                    ev_put(ev, ne, 22, 700); ev_put(ev, ne, 23, 0);
                    ev_hash_id(ev, ne, 4); ne = ne + 1;
                }
            }
        }
    }
    if(ne == 0) {
        ev_init(ev, 0); ne = 1; top = 0;
        ev_put(ev, 0, 2, 0); ev_put(ev, 0, 3, 1);
        ev_put(ev, 0, 4, 0); ev_put(ev, 0, 5, 0);
        ev_put(ev, 0, 6, 12);
        ev_put(ev, 0, 7, 0); ev_put(ev, 0, 8, 0);
        ev_wit(ev, 0, 2, 0, 1);
        ev_put(ev, 0, 22, 0); ev_put(ev, 0, 23, 1000);
        ev_hash_id(ev, 0, 4);
        judg = 0;
        orig_con = 1000;
    }
    t_put64(res, 0, top as i64); t_put64(res, 8, judg);
    t_put64(res, 16, corroborated as i64); t_put64(res, 24, ne as i64);
    t_put64(res, 32, rechecked as i64); t_put64(res, 40, resolved as i64);
    t_put64(res, 48, orig_con);
    return;
}
// ================= TASK 5: timbredisc (rewritten for true helpers) =========
// judg: 0=PURE 1=BRIGHT 2=DARK 3=RICH
// res: [0]=top [8]=judg [16]=corroborated [24]=nev [32]=rechecked [40]=resolved
fn xt_timbredisc(buf:[]u8, n:i32, op:[]u8, ev:[]u8, res:[]u8) void {
    let sr:i64 = t_get32(buf, 0) as i64;
    let cnt:i64 = t_get32(buf, 4) as i64;
    let ne:i32 = 0;
    let top:i32 = 0;
    let judg:i64 = 0;
    let corroborated:i32 = 0;
    let rechecked:i32 = 0;
    let resolved:i32 = 0;
    let orig_con:i64 = 0;
    if(sr > 0 && cnt > 64 && 8 + cnt * 2 <= n as i64) {
        let ci:i32 = cnt as i32;
        let mid:i32 = ci / 2;
        let f0m:i64 = f0_coarse(buf, 8, ci, sr, op);
        if(f0m <= 0) { f0m = 440000; }
        f0m = f0_refine(buf, 8, ci, sr, f0m, op);
        if(f0m <= 0) { f0m = 440000; }
        let r1:i64 = harm_centroid(buf, 8, mid, sr, f0m, 6, op);
        let r2:i64 = harm_centroid(buf, 8 + mid * 2, ci - mid, sr, f0m, 6, op);
        let c1:i64 = tb_class(r1);
        let c2:i64 = tb_class(r2);
        let m1:i64 = tb_margin(r1, c1);
        let m2:i64 = tb_margin(r2, c2);
        let agree:i32 = 0;
        if(c1 == c2) { agree = 1; }
        let cf:i64 = c1;
        let margin:i64 = m1;
        if(m2 > margin) { cf = c2; margin = m2; }
        let sup:i64 = 0;
        if(margin > 0) { sup = 1000 * margin / (margin + 80); }
        let con:i64 = 0;
        if(agree == 0) { con = 500; }
        if(margin < 60 && con < 300) { con = 300; }
        orig_con = con;
        let sH0:i64 = 8; let wH:i64 = (mid as i64) * 2;
        let sH1:i64 = 8 + wH; let wH2:i64 = (ci as i64) * 2 - wH;
        if(con > 0 && con < 1000) {
            rechecked = 1;
            let r3:i64 = harm_centroid(buf, 8, ci, sr, f0m, 6, op);
            let c3:i64 = tb_class(r3);
            let m3:i64 = tb_margin(r3, c3);
            if(m3 > margin && (c3 == c1 || c3 == c2)) {
                cf = c3; margin = m3;
                sup = 1000 * margin / (margin + 80);
                con = 0; resolved = 1; corroborated = 1;
            }
            if(resolved == 0) { con = 700; }
        }
        judg = cf;
        if(agree == 1 && con == 0) { corroborated = 1; }
        // ---- events ----
        ev_init(ev, ne);
        ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, mid as i64);
        ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
        ev_put(ev, ne, 6, 13 + c1);
        ev_put(ev, ne, 7, r1 - 40); ev_put(ev, ne, 8, r1 + 40);
        ev_wit(ev, ne, 2, 0, mid as i64);
        ev_put(ev, ne, 22, 600); ev_put(ev, ne, 23, 0);
        ev_alt(ev, ne, 13 + ((c1 + 1) % 4), 300);
        ev_alt(ev, ne, 13 + ((c1 + 2) % 4), 300);
        ev_hash_id(ev, ne, 5); ne = ne + 1;
        ev_init(ev, ne);
        ev_put(ev, ne, 2, mid as i64); ev_put(ev, ne, 3, ci as i64);
        ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
        ev_put(ev, ne, 6, 13 + c2);
        ev_put(ev, ne, 7, r2 - 40); ev_put(ev, ne, 8, r2 + 40);
        ev_wit(ev, ne, 2, mid as i64, (ci - mid) as i64);
        ev_put(ev, ne, 22, 600); ev_put(ev, ne, 23, 0);
        ev_alt(ev, ne, 13 + ((c2 + 1) % 4), 300);
        ev_alt(ev, ne, 13 + ((c2 + 2) % 4), 300);
        ev_hash_id(ev, ne, 5); ne = ne + 1;
        ev_init(ev, ne);
        top = ne;
        ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, ci as i64);
        ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
        ev_put(ev, ne, 6, 13 + cf);
        ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 3000);
        ev_wit(ev, ne, 2, 0, mid as i64);
        ev_wit(ev, ne, 2, mid as i64, (ci - mid) as i64);
        ev_put(ev, ne, 22, sup); ev_put(ev, ne, 23, con);
        ev_alt(ev, ne, 13 + ((cf + 1) % 4), 1000 - sup);
        ev_alt(ev, ne, 13 + ((cf + 2) % 4), (1000 - sup) / 2);
        ev_hash_id(ev, ne, 5); ne = ne + 1;
        if(rechecked == 1) {
            ev_init(ev, ne);
            ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, ci as i64);
            ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
            ev_put(ev, ne, 6, 3);
            ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 500);
            ev_wit(ev, ne, 2, 0, ci as i64);
            ev_put(ev, ne, 22, 700); ev_put(ev, ne, 23, 0);
            ev_hash_id(ev, ne, 5); ne = ne + 1;
        }
    }
    if(ne == 0) {
        ev_init(ev, 0); ne = 1; top = 0;
        ev_put(ev, 0, 2, 0); ev_put(ev, 0, 3, 1);
        ev_put(ev, 0, 4, 0); ev_put(ev, 0, 5, 0);
        ev_put(ev, 0, 6, 13);
        ev_put(ev, 0, 7, 0); ev_put(ev, 0, 8, 0);
        ev_wit(ev, 0, 2, 0, 1);
        ev_put(ev, 0, 22, 0); ev_put(ev, 0, 23, 1000);
        ev_hash_id(ev, 0, 5);
        judg = 0;
        orig_con = 1000;
    }
    t_put64(res, 0, top as i64); t_put64(res, 8, judg);
    t_put64(res, 16, corroborated as i64); t_put64(res, 24, ne as i64);
    t_put64(res, 32, rechecked as i64); t_put64(res, 40, resolved as i64);
    t_put64(res, 48, orig_con);
    return;
}
// ================= TASK 6: motiondir (rewritten for true helpers) =========
// judg: 0=STILL 1=N 2=NE 3=E 4=SE 5=S 6=SW 7=W 8=NW
// res: [0]=top [8]=judg [16]=corroborated [24]=nev [32]=rechecked [40]=resolved
// ================= TASK 6: motiondir (prereg-exact rewrite) =================
// .vid: u32 nf, u32 w, u32 h, then nf frames of w*h*3 bytes (no per-frame hdr).
// 7 frame-pair spans (0-1..6-7). Per span: changed-pixel count (summed-channel
// diff > 90) + centroid displacement (dx,dy).
// Predicate ids: 17..24 = N,NE,E,SE,S,SW,W,NW (octants 1..8); 25 = STILL.
// judg: 0=STILL, 1..8 = direction octant.
// res: [0]=top [8]=judg [16]=corroborated [24]=nev [32]=rechecked [40]=resolved [48]=orig_con
// changed-pixel mask stats between frames fa,fb at threshold thr.
// out: [0]=count, [8]=cx, [16]=cy
fn mspan(buf:[]u8, fa:i32, fb:i32, w:i32, h:i32, thr:i32, op:[]u8, out3:[]u8) void {
    let fsz:i64 = (w as i64) * (h as i64);
    let b0:i64 = 12 + (fa as i64) * fsz * 3;
    let b1:i64 = 12 + (fb as i64) * fsz * 3;
    let mc:i64 = 0; let sx:i64 = 0; let sy:i64 = 0;
    let p:i64 = 0;
    while(p < fsz) {
        let o0:i64 = b0 + p * 3;
        let o1:i64 = b1 + p * 3;
        let d:i64 = iabs((buf[o0 as i32] as i64) - (buf[o1 as i32] as i64))
                  + iabs((buf[(o0+1) as i32] as i64) - (buf[(o1+1) as i32] as i64))
                  + iabs((buf[(o0+2) as i32] as i64) - (buf[(o1+2) as i32] as i64));
        if(d > thr as i64) {
            mc = mc + 1;
            sx = sx + (p % (w as i64));
            sy = sy + (p / (w as i64));
        }
        p = p + 1;
    }
    op_add(op, fsz);
    t_put64(out3, 0, mc);
    if(mc > 0) { t_put64(out3, 8, sx / mc); t_put64(out3, 16, sy / mc); }
    if(mc == 0) { t_put64(out3, 8, 0); t_put64(out3, 16, 0); }
}
// octant id 1..8 from dx,dy (0 if |disp|<1)
fn moct(dx:i64, dy:i64) i64 {
    let ax:i64 = iabs(dx); let ay:i64 = iabs(dy);
    let mag:i64 = ax;
    if(ay > mag) { mag = ay; }
    if(mag < 1) { return 0; }
    if(ax >= 2 * ay) { if(dx > 0) { return 3; } return 7; }
    if(ay >= 2 * ax) { if(dy > 0) { return 5; } return 1; }
    if(dx > 0 && dy < 0) { return 2; }
    if(dx > 0 && dy > 0) { return 4; }
    if(dx < 0 && dy > 0) { return 6; }
    return 8;
}
// opposite octant (for two-opposite-motions check)
fn moct_opp(o:i64) i64 {
    if(o == 1) { return 5; }
    if(o == 2) { return 6; }
    if(o == 3) { return 7; }
    if(o == 4) { return 8; }
    if(o == 5) { return 1; }
    if(o == 6) { return 2; }
    if(o == 7) { return 3; }
    if(o == 8) { return 4; }
    return 0;
}
// Block-matching displacement between frames fa,fb.
// Search dx,dy in [-4,4]; SAD over interior (margin 4). out: [0]=dx,[8]=dy,[16]=best_sad.
// Deterministic: ties -> smallest |dx|+|dy|, then smallest dx, then smallest dy.
fn mblock(buf:[]u8, fa:i32, fb:i32, w:i32, h:i32, op:[]u8, out3:[]u8) void {
    let fsz:i64 = (w as i64) * (h as i64);
    let b0:i64 = 12 + (fa as i64) * fsz * 3;
    let b1:i64 = 12 + (fb as i64) * fsz * 3;
    let best_dx:i64 = 0; let best_dy:i64 = 0;
    let best_sad:i64 = -1;
    let best_cost:i64 = 0;
    let dy:i64 = -4;
    while(dy <= 4) {
        let dx:i64 = -4;
        while(dx <= 4) {
            let sad:i64 = 0;
            let y:i64 = 4;
            while(y < (h as i64) - 4) {
                let x:i64 = 4;
                while(x < (w as i64) - 4) {
                    let o0:i64 = b0 + (y * (w as i64) + x) * 3;
                    let o1:i64 = b1 + ((y + dy) * (w as i64) + (x + dx)) * 3;
                    sad = sad + iabs((buf[o0 as i32] as i64) - (buf[o1 as i32] as i64))
                              + iabs((buf[(o0+1) as i32] as i64) - (buf[(o1+1) as i32] as i64))
                              + iabs((buf[(o0+2) as i32] as i64) - (buf[(o1+2) as i32] as i64));
                    x = x + 1;
                }
                y = y + 1;
            }
            op_add(op, ((w as i64) - 8) * ((h as i64) - 8));
            let cost:i64 = iabs(dx) + iabs(dy);
            let take:i32 = 0;
            if(best_sad < 0) { take = 1; }
            if(best_sad >= 0 && sad < best_sad) { take = 1; }
            if(best_sad >= 0 && sad == best_sad && cost < best_cost) { take = 1; }
            if(best_sad >= 0 && sad == best_sad && cost == best_cost && dx < best_dx) { take = 1; }
            if(best_sad >= 0 && sad == best_sad && cost == best_cost && dx == best_dx && dy < best_dy) { take = 1; }
            if(take == 1) {
                best_sad = sad; best_dx = dx; best_dy = dy; best_cost = cost;
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    t_put64(out3, 0, best_dx); t_put64(out3, 8, best_dy); t_put64(out3, 16, best_sad);
}
fn xt_motiondir(buf:[]u8, n:i32, op:[]u8, ev:[]u8, res:[]u8) void {
    let nf:i32 = t_get32(buf, 0) as i32;
    let w:i32 = t_get32(buf, 4) as i32;
    let h:i32 = t_get32(buf, 8) as i32;
    let ne:i32 = 0;
    let top:i32 = 0;
    let judg:i64 = 0;
    let corroborated:i32 = 0;
    let rechecked:i32 = 0;
    let resolved:i32 = 0;
    let orig_con:i64 = 0;
    if(nf < 2 || w < 2 || h < 2 || 12 + (nf as i64) * (w as i64) * (h as i64) * 3 > n as i64) {
        ev_init(ev, 0); ne = 1;
        ev_put(ev, 0, 2, 0); ev_put(ev, 0, 3, nf as i64);
        ev_put(ev, 0, 4, 0); ev_put(ev, 0, 5, 1);
        ev_put(ev, 0, 6, 25); ev_put(ev, 0, 7, 0); ev_put(ev, 0, 8, 0);
        ev_wit(ev, 0, 3, 0, nf as i64);
        ev_put(ev, 0, 22, 0); ev_put(ev, 0, 23, 1000);
        ev_hash_id(ev, 0, 6); ne = 1;
        t_put64(res, 0, 0); t_put64(res, 8, 0);
        t_put64(res, 16, 0); t_put64(res, 24, ne);
        t_put64(res, 32, 0); t_put64(res, 40, 0); t_put64(res, 48, 1000);
        return;
    }
    let fsz:i64 = (w as i64) * (h as i64);
    let nsp:i32 = nf - 1;
    if(nsp > 7) { nsp = 7; }
    // per-span: count, cx, cy, octant, is_still
    let sp:[]u8 = nio_alloc(7 * 40);
    let s:i32 = 0;
    while(s < 7) {
        let f:i32 = 0;
        while(f < 5) { t_put64(sp, s * 40 + f * 8, 0); f = f + 1; }
        s = s + 1;
    }
    let ms:[]u8 = nio_alloc(24);
    s = 0;
    while(s < nsp) {
        mspan(buf, s, s + 1, w, h, 90, op, ms);
        let mc:i64 = t_get64(ms, 0);
        // displacement: centroid of span s+1 minus centroid of span s?
        // No: mspan gives changed-pixel centroid between fa,fb. For displacement
        // we need the motion vector. Use: compare centroid of changed mask in
        // (s,s+1) vs (s+1,s+2)? Simpler per prereg: "centroid displacement (dx,dy)".
        // We approximate dx,dy via the change centroid's offset from frame center
        // is NOT motion. Instead: use two adjacent spans' centroids.
        // For now: store mc; dx,dy computed below from consecutive span centroids.
        t_put64(sp, s * 40, mc);
        t_put64(sp, s * 40 + 8, t_get64(ms, 8));
        t_put64(sp, s * 40 + 16, t_get64(ms, 16));
        s = s + 1;
    }
    nio_free(ms);
    // displacement per span via SAD block matching (dx,dy in [-4,4]).
    // still if |disp| < 1px and change < 5%.
    let mb:[]u8 = nio_alloc(24);
    s = 0;
    while(s < nsp) {
        let mc:i64 = t_get64(sp, s * 40);
        let dx:i64 = 0; let dy:i64 = 0;
        if(mb.len > 0) {
            mblock(buf, s, s + 1, w, h, op, mb);
            dx = t_get64(mb, 0); dy = t_get64(mb, 8);
        }
        let chg_frac:i64 = 0;
        if(fsz > 0) { chg_frac = mc * 1000 / fsz; }
        let mag:i64 = iabs(dx);
        if(iabs(dy) > mag) { mag = iabs(dy); }
        let oct:i64 = moct(dx, dy);
        let still:i32 = 0;
        if(mag < 1 && chg_frac < 50) { still = 1; oct = 0; }
        t_put64(sp, s * 40 + 24, oct);
        t_put64(sp, s * 40 + 32, still as i64);
        s = s + 1;
    }
    nio_free(mb);
    // majority octant over non-still spans
    let votes:[]u8 = nio_alloc(9 * 8);
    let vi:i32 = 0;
    while(vi < 9) { t_put64(votes, vi * 8, 0); vi = vi + 1; }
    let nstill:i32 = 0;
    s = 0;
    while(s < nsp) {
        let oct:i64 = t_get64(sp, s * 40 + 24);
        let still:i64 = t_get64(sp, s * 40 + 32);
        if(still == 1) { nstill = nstill + 1; }
        if(oct >= 1 && oct <= 8) {
            t_put64(votes, oct as i32 * 8, t_get64(votes, oct as i32 * 8) + 1);
        }
        s = s + 1;
    }
    let best_o:i64 = 0;
    let best_v:i64 = 0;
    let o:i32 = 1;
    while(o <= 8) {
        let v:i64 = t_get64(votes, o * 8);
        if(v > best_v) { best_v = v; best_o = o as i64; }
        o = o + 1;
    }
    nio_free(votes);
    let agree:i64 = best_v;
    let disagree:i64 = (nsp as i64) - nstill as i64 - agree;
    if(disagree < 0) { disagree = 0; }
    let sup:i64 = 0;
    let con:i64 = 0;
    if(nsp > 0) {
        sup = 1000 * agree / (nsp as i64);
        con = 1000 * disagree / (nsp as i64);
    }
    orig_con = con;
    // flicker check: >=4 spans with change > 30% but |disp| < 1px
    let flick:i32 = 0;
    s = 0;
    while(s < nsp) {
        let mc:i64 = t_get64(sp, s * 40);
        let oct:i64 = t_get64(sp, s * 40 + 24);
        if(mc * 1000 / fsz > 300 && oct == 0) { flick = flick + 1; }
        s = s + 1;
    }
    let is_flicker:i32 = 0;
    if(flick >= 4) { is_flicker = 1; con = 800; }
    // two-opposite-motions: best_o and its opposite both have votes
    let opp_votes:i64 = 0;
    if(best_o >= 1) {
        s = 0;
        while(s < nsp) {
            if(t_get64(sp, s * 40 + 24) == moct_opp(best_o)) { opp_votes = opp_votes + 1; }
            s = s + 1;
        }
        if(opp_votes > 0 && agree > 0) {
            con = 700;
            if(con < orig_con) { con = orig_con; }
            orig_con = con;
        }
    }
    // re-checks
    if(is_flicker == 1) {
        rechecked = 1;
        // re-check with diff threshold x3 (270) requiring coherent displacement
        let ms2:[]u8 = nio_alloc(24);
        let coh:i32 = 0;
        let tot_oct:i64 = 0;
        s = 0;
        while(s < nsp) {
            mspan(buf, s, s + 1, w, h, 270, op, ms2);
            let mc2:i64 = t_get64(ms2, 0);
            if(mc2 > 0) {
                // displacement still needs a reference; use strict: require
                // the high-thr mask to be small (flicker has large high-thr
                // mask too if it's real motion? no—flicker is low-amplitude).
                // If high-thr count < 5% -> flicker confirmed -> STILL.
                if(mc2 * 1000 / fsz < 50) { coh = coh + 1; }
            } else {
                coh = coh + 1;
            }
            s = s + 1;
        }
        nio_free(ms2);
        if(coh >= 4) {
            // flicker confirmed: STILL
            resolved = 1; con = 0;
            best_o = 0; agree = nsp as i64; disagree = 0;
            sup = 800;
        }
    }
    if(opp_votes > 0 && resolved == 0) {
        rechecked = 1;
        // re-check per half-frame (left/right): which half dominates?
        // (simplified: keep majority; mark unresolved)
        con = 700;
    }
    // judgment
    let pred:i64 = 25;
    judg = 0;
    if(best_o >= 1 && best_o <= 8) {
        pred = 16 + best_o;
        judg = best_o;
    }
    if(best_o == 0) {
        // STILL: check if it's really still (most spans still)
        if(nstill as i64 * 2 >= nsp as i64) {
            corroborated = 1;
        }
    } else {
        if(con == 0 && agree as i64 * 2 >= nsp as i64) { corroborated = 1; }
    }
    if(resolved == 1) { corroborated = 1; }
    // ---- events ----
    s = 0;
    while(s < nsp) {
        ev_init(ev, ne);
        let mc:i64 = t_get64(sp, s * 40);
        let oct:i64 = t_get64(sp, s * 40 + 24);
        let still:i64 = t_get64(sp, s * 40 + 32);
        ev_put(ev, ne, 2, s as i64); ev_put(ev, ne, 3, (s + 1) as i64);
        ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 1);
        let ep:i64 = 25;
        if(oct >= 1) { ep = 16 + oct; }
        ev_put(ev, ne, 6, ep);
        ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 1000);
        ev_wit(ev, ne, 3, s as i64, 1);
        let esp:i64 = 600;
        if(still == 1) { esp = 800; }
        ev_put(ev, ne, 22, esp); ev_put(ev, ne, 23, 0);
        ev_hash_id(ev, ne, 6); ne = ne + 1;
        s = s + 1;
    }
    nio_free(sp);
    // direction event (top)
    ev_init(ev, ne);
    top = ne;
    ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, nsp as i64);
    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
    ev_put(ev, ne, 6, pred);
    ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 8);
    s = 0;
    while(s < nsp) {
        ev_wit(ev, ne, 3, s as i64, 1);
        s = s + 1;
    }
    ev_put(ev, ne, 22, sup); ev_put(ev, ne, 23, con);
    // alternatives: runner-up octants
    if(pred == 25) {
        ev_alt(ev, ne, 17, 200);
    } else {
        ev_alt(ev, ne, 25, 1000 - sup);
    }
    ev_hash_id(ev, ne, 6); ne = ne + 1;
    if(rechecked == 1) {
        ev_init(ev, ne);
        ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, nsp as i64);
        ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
        ev_put(ev, ne, 6, 3);
        ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 500);
        ev_wit(ev, ne, 3, 0, nsp as i64);
        ev_put(ev, ne, 22, 700); ev_put(ev, ne, 23, 0);
        ev_hash_id(ev, ne, 6); ne = ne + 1;
    }
    t_put64(res, 0, top as i64); t_put64(res, 8, judg);
    t_put64(res, 16, corroborated as i64); t_put64(res, 24, ne as i64);
    t_put64(res, 32, rechecked as i64); t_put64(res, 40, resolved as i64);
    t_put64(res, 48, orig_con);
    return;
}

// ================= TASK 2: colorconst ======================================
// von Kries normalized quarter means; threshold 150.
// judg: 0=SAME_SURFACE 1=DIFFERENT
// res: [0]=top [8]=judg [16]=corroborated [24]=nev [32]=rechecked [40]=resolved [48]=orig_con
// quarter 95th-percentile per channel via 16-bin histogram
fn img_quarter_p95(buf:[]u8, w:i32, h:i32, q:i32, op:[]u8, out3:[]u8) void {
    let hw:i32 = w / 2;
    let hh:i32 = h / 2;
    let x0:i32 = 0; let y0:i32 = 0;
    if(q == 1 || q == 3) { y0 = hh; }
    if(q == 2 || q == 3) { x0 = hw; }
    let hist:[]u8 = nio_alloc(48 * 8);
    if(hist.len == 0) { t_put64(out3, 0, 0); t_put64(out3, 8, 0); t_put64(out3, 16, 0); return; }
    let i:i32 = 0;
    while(i < 48) { t_put64(hist, i * 8, 0); i = i + 1; }
    let y:i32 = y0;
    while(y < y0 + hh) {
        let x:i32 = x0;
        while(x < x0 + hw) {
            let o:i32 = 8 + (y * w + x) * 3;
            let b0:i32 = (buf[o] as i32) / 16;
            let b1:i32 = (buf[o+1] as i32) / 16;
            let b2:i32 = (buf[o+2] as i32) / 16;
            t_put64(hist, b0 * 8, t_get64(hist, b0 * 8) + 1);
            t_put64(hist, (16 + b1) * 8, t_get64(hist, (16 + b1) * 8) + 1);
            t_put64(hist, (32 + b2) * 8, t_get64(hist, (32 + b2) * 8) + 1);
            x = x + 1;
        }
        y = y + 1;
    }
    op_add(op, (hw as i64) * (hh as i64));
    let tot:i64 = (hw as i64) * (hh as i64);
    let thr:i64 = tot * 95 / 100;
    let c:i32 = 0;
    while(c < 3) {
        let acc:i64 = 0;
        let b:i32 = 15;
        while(b >= 0) {
            acc = acc + t_get64(hist, (c * 16 + b) * 8);
            if(acc >= tot - thr) { break; }
            b = b - 1;
        }
        if(b < 0) { b = 0; }
        t_put64(out3, c * 8, (b * 16 + 8) as i64);
        c = c + 1;
    }
    nio_free(hist);
}
fn xt_colorconst(buf:[]u8, n:i32, op:[]u8, ev:[]u8, res:[]u8) void {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    let ne:i32 = 0;
    let orig_con:i64 = 0;
    if(w < 2 || h < 4 || (w & 1) == 1 || 8 + (w as i64) * (h as i64) * 3 > n as i64) {
        ev_init(ev, 0); ne = 1;
        ev_put(ev, 0, 2, 0); ev_put(ev, 0, 3, (w as i64) * (h as i64));
        ev_put(ev, 0, 4, 0); ev_put(ev, 0, 5, 1);
        ev_put(ev, 0, 6, 4); ev_put(ev, 0, 7, 0); ev_put(ev, 0, 8, 0);
        ev_wit(ev, 0, 1, 0, (w as i64) * (h as i64));
        ev_put(ev, 0, 22, 0); ev_put(ev, 0, 23, 1000);
        ev_hash_id(ev, 0, 2);
        t_put64(res, 0, 0); t_put64(res, 8, 0);
        t_put64(res, 16, 0); t_put64(res, 24, ne);
        t_put64(res, 32, 0); t_put64(res, 40, 0); t_put64(res, 48, 1000);
        return;
    }
    let hw:i32 = w / 2;
    let hh:i32 = h / 2;
    // per-quarter mean and max (white patch)
    let qm:[]u8 = nio_alloc(96);
    let qx:[]u8 = nio_alloc(96);
    let q:i32 = 0;
    while(q < 4) {
        img_quarter_mean(buf, w, h, q, op, qm[q*24..q*24+24]);
        img_quarter_max(buf, w, h, q, op, qx[q*24..q*24+24]);
        q = q + 1;
    }
    // von Kries normalized means: n_c = mean_c * 1000 / max_c
    let nn:[]u8 = nio_alloc(96);
    q = 0;
    while(q < 4) {
        let c:i32 = 0;
        while(c < 3) {
            let mu:i64 = t_get64(qm, q * 24 + c * 8);
            let mx:i64 = t_get64(qx, q * 24 + c * 8);
            let nv:i64 = 0;
            if(mx > 0) { nv = mu * 1000 / mx; }
            t_put64(nn, q * 24 + c * 8, nv);
            c = c + 1;
        }
        q = q + 1;
    }
    nio_free(qm); nio_free(qx);
    let n0r:i64 = t_get64(nn, 0); let n0g:i64 = t_get64(nn, 8); let n0b:i64 = t_get64(nn, 16);
    let n1r:i64 = t_get64(nn, 24); let n1g:i64 = t_get64(nn, 32); let n1b:i64 = t_get64(nn, 40);
    let n2r:i64 = t_get64(nn, 48); let n2g:i64 = t_get64(nn, 56); let n2b:i64 = t_get64(nn, 64);
    let n3r:i64 = t_get64(nn, 72); let n3g:i64 = t_get64(nn, 80); let n3b:i64 = t_get64(nn, 88);
    nio_free(nn);
    let d_top:i64 = rgb_dist(n0r, n0g, n0b, n2r, n2g, n2b);
    let d_bot:i64 = rgb_dist(n1r, n1g, n1b, n3r, n3g, n3b);
    let d_lo:i64 = imin(d_top, d_bot);
    let d_hi:i64 = imax(d_top, d_bot);
    let d_mid:i64 = (d_lo + d_hi) / 2;
    let mg:i64 = iabs(d_mid - 150);
    let sup:i64 = 1000 * mg / (mg + 200);
    let straddle:i32 = 0;
    if((d_top > 150 && d_bot <= 150) || (d_bot > 150 && d_top <= 150)) { straddle = 1; }
    let pred:i64 = 4;
    if(d_lo > 150) { pred = 5; }
    if(d_lo <= 150 && d_hi > 150 && d_mid > 150) { pred = 5; }
    let con:i64 = 0;
    if(straddle == 1) { con = 1000 * iabs(d_top - d_bot) / (iabs(d_top - d_bot) + 300); }
    orig_con = con;
    // second witness: normalized histogram distance (coarse)
    // (use unnormalized hist4 but on normalized scale is complex; use a
    //  simple second look: top vs bottom with max-white-patch from p95)
    let rechecked:i32 = 0;
    let resolved:i32 = 0;
    if(con > 0) {
        rechecked = 1;
        // re-check: alternate white-patch = 95th percentile
        let qm2:[]u8 = nio_alloc(96);
        let qp:[]u8 = nio_alloc(96);
        q = 0;
        while(q < 4) {
            img_quarter_mean(buf, w, h, q, op, qm2[q*24..q*24+24]);
            img_quarter_p95(buf, w, h, q, op, qp[q*24..q*24+24]);
            q = q + 1;
        }
        let m0r:i64 = t_get64(qm2, 0); let m0g:i64 = t_get64(qm2, 8); let m0b:i64 = t_get64(qm2, 16);
        let m1r:i64 = t_get64(qm2, 24); let m1g:i64 = t_get64(qm2, 32); let m1b:i64 = t_get64(qm2, 40);
        let m2r:i64 = t_get64(qm2, 48); let m2g:i64 = t_get64(qm2, 56); let m2b:i64 = t_get64(qm2, 64);
        let m3r:i64 = t_get64(qm2, 72); let m3g:i64 = t_get64(qm2, 80); let m3b:i64 = t_get64(qm2, 88);
        let p0r:i64 = t_get64(qp, 0); let p0g:i64 = t_get64(qp, 8); let p0b:i64 = t_get64(qp, 16);
        let p1r:i64 = t_get64(qp, 24); let p1g:i64 = t_get64(qp, 32); let p1b:i64 = t_get64(qp, 40);
        let p2r:i64 = t_get64(qp, 48); let p2g:i64 = t_get64(qp, 56); let p2b:i64 = t_get64(qp, 64);
        let p3r:i64 = t_get64(qp, 72); let p3g:i64 = t_get64(qp, 80); let p3b:i64 = t_get64(qp, 88);
        nio_free(qm2); nio_free(qp);
        let v0r:i64 = 0; let v0g:i64 = 0; let v0b:i64 = 0;
        let v1r:i64 = 0; let v1g:i64 = 0; let v1b:i64 = 0;
        let v2r:i64 = 0; let v2g:i64 = 0; let v2b:i64 = 0;
        let v3r:i64 = 0; let v3g:i64 = 0; let v3b:i64 = 0;
        if(p0r > 0) { v0r = m0r * 1000 / p0r; }
        if(p0g > 0) { v0g = m0g * 1000 / p0g; }
        if(p0b > 0) { v0b = m0b * 1000 / p0b; }
        if(p1r > 0) { v1r = m1r * 1000 / p1r; }
        if(p1g > 0) { v1g = m1g * 1000 / p1g; }
        if(p1b > 0) { v1b = m1b * 1000 / p1b; }
        if(p2r > 0) { v2r = m2r * 1000 / p2r; }
        if(p2g > 0) { v2g = m2g * 1000 / p2g; }
        if(p2b > 0) { v2b = m2b * 1000 / p2b; }
        if(p3r > 0) { v3r = m3r * 1000 / p3r; }
        if(p3g > 0) { v3g = m3g * 1000 / p3g; }
        if(p3b > 0) { v3b = m3b * 1000 / p3b; }
        let dt2:i64 = rgb_dist(v0r, v0g, v0b, v2r, v2g, v2b);
        let db2:i64 = rgb_dist(v1r, v1g, v1b, v3r, v3g, v3b);
        let dm2:i64 = (imin(dt2, db2) + imax(dt2, db2)) / 2;
        let pred2:i64 = 4;
        if(dm2 > 150) { pred2 = 5; }
        let mg2:i64 = iabs(dm2 - 150);
        let sup2:i64 = 1000 * mg2 / (mg2 + 200);
        // adopt if the p95 white-patch gives a clearer, agreeing answer
        if(sup2 > sup && (pred2 == pred || iabs(dm2 - d_mid) < 100)) {
            pred = pred2; sup = sup2; d_mid = dm2;
            d_lo = imin(dt2, db2); d_hi = imax(dt2, db2);
            con = 0; resolved = 1;
        }
    }
    let judg:i64 = 0;
    if(pred == 5) { judg = 1; }
    let corroborated:i32 = 0;
    if(straddle == 0 && con == 0) { corroborated = 1; }
    if(resolved == 1) { corroborated = 1; }
    // ---- events ----
    let hpx:i64 = (hw as i64) * (h as i64);
    let qpx:i64 = (hw as i64) * (hh as i64);
    ev_init(ev, ne);
    ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, hpx);
    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 1);
    ev_put(ev, ne, 6, 2);
    ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 1000);
    ev_wit(ev, ne, 1, 0, hpx);
    ev_put(ev, ne, 22, 900); ev_put(ev, ne, 23, 0);
    ev_hash_id(ev, ne, 2); ne = ne + 1;
    ev_init(ev, ne);
    ev_put(ev, ne, 2, hpx); ev_put(ev, ne, 3, 2 * hpx);
    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 1);
    ev_put(ev, ne, 6, 2);
    ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 1000);
    ev_wit(ev, ne, 1, hpx, hpx);
    ev_put(ev, ne, 22, 900); ev_put(ev, ne, 23, 0);
    ev_hash_id(ev, ne, 2); ne = ne + 1;
    // relation event (von Kries normalized)
    ev_init(ev, ne);
    let top:i32 = ne;
    ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, 2 * hpx);
    ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
    ev_put(ev, ne, 6, pred);
    ev_put(ev, ne, 7, imin(d_lo, d_mid)); ev_put(ev, ne, 8, imax(d_hi, d_mid));
    ev_wit(ev, ne, 1, 0, qpx);
    ev_wit(ev, ne, 1, (hh as i64) * (w as i64), qpx);
    ev_wit(ev, ne, 1, hw as i64, qpx);
    ev_wit(ev, ne, 1, (hh as i64) * (w as i64) + (hw as i64), qpx);
    ev_put(ev, ne, 22, sup); ev_put(ev, ne, 23, con);
    if(pred == 4) { ev_alt(ev, ne, 5, 1000 - sup); }
    if(pred == 5) { ev_alt(ev, ne, 4, 1000 - sup); }
    ev_hash_id(ev, ne, 2); ne = ne + 1;
    if(rechecked == 1) {
        ev_init(ev, ne);
        ev_put(ev, ne, 2, 0); ev_put(ev, ne, 3, 2 * hpx);
        ev_put(ev, ne, 4, 0); ev_put(ev, ne, 5, 0);
        ev_put(ev, ne, 6, 3);
        ev_put(ev, ne, 7, 0); ev_put(ev, ne, 8, 500);
        ev_wit(ev, ne, 1, 0, 2 * hpx);
        ev_put(ev, ne, 22, 700); ev_put(ev, ne, 23, 0);
        ev_hash_id(ev, ne, 2); ne = ne + 1;
    }
    t_put64(res, 0, top as i64); t_put64(res, 8, judg);
    t_put64(res, 16, corroborated as i64); t_put64(res, 24, ne as i64);
    t_put64(res, 32, rechecked as i64); t_put64(res, 40, resolved as i64);
    t_put64(res, 48, orig_con);
    return;
}

// ================= main: frozen CLI + memory contract ======================
// open(path, O_WRONLY|O_CREAT|O_APPEND, 0600), write all, close
fn z_append(path:[]u8, data:[]u8, len:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 1089, 384, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let w:i64 = nio_write_all(fd, data[0..len]);
    nio_close(fd);
    return w;
}
fn task_id(name:[]u8) i32 {
    if(streq(name, "colordisc")) { return 1; }
    if(streq(name, "colorconst")) { return 2; }
    if(streq(name, "shapetrans")) { return 3; }
    if(streq(name, "pitchdisc")) { return 4; }
    if(streq(name, "timbredisc")) { return 5; }
    if(streq(name, "motiondir")) { return 6; }
    return 0;
}
// basename into out (NUL-terminated); returns length
fn fx_base(fx:[]u8, out:[]u8) i32 {
    let s:i32 = 0;
    let i:i32 = 0;
    while(i < fx.len) { if(fx[i] == 47) { s = i + 1; } i = i + 1; }
    let o:i32 = 0;
    while(s + o < fx.len && o < 255) { out[o] = fx[s + o]; o = o + 1; }
    out[o] = 0;
    return o;
}
fn name_eq_slot(names:[]u8, idx:i32, base:[]u8, baselen:i32) i32 {
    let b0:i32 = idx * 256;
    let i:i32 = 0;
    while(i < baselen) {
        if(names[b0 + i] != base[i]) { return 0; }
        i = i + 1;
    }
    if(names[b0 + baselen] != 0) { return 0; }
    return 1;
}
// find entry: same task, same pred, attr intervals overlap; -1 if none
fn mem_find(ar:[]u8, cnt:i32, taskid:i32, pred:i64, alo:i64, ahi:i64) i32 {
    let i:i32 = 0;
    while(i < cnt) {
        if(mem_entry_get(ar, i, 0) == taskid as i64 && mem_entry_get(ar, i, 1) == pred) {
            let bl:i64 = mem_entry_get(ar, i, 3);
            let bh:i64 = mem_entry_get(ar, i, 4);
            if(bl <= ahi && alo <= bh) { return i; }
        }
        i = i + 1;
    }
    return -1;
}
// stored invariant still verifies: warrant held at install, attr sane,
// pred in the task's range.
fn mem_verify(ar:[]u8, i:i32, taskid:i32) i32 {
    let pred:i64 = mem_entry_get(ar, i, 1);
    let alo:i64 = mem_entry_get(ar, i, 3);
    let ahi:i64 = mem_entry_get(ar, i, 4);
    let ssup:i64 = mem_entry_get(ar, i, 5);
    if(alo > ahi) { return 0; }
    if(ssup < tmod(taskid)) { return 0; }
    if(taskid == 1 || taskid == 2) { if(pred < 4 || pred > 5) { return 0; } }
    if(taskid == 3) { if(pred < 7 || pred > 9) { return 0; } }
    if(taskid == 4) { if(pred < 10 || pred > 12) { return 0; } }
    if(taskid == 5) { if(pred < 13 || pred > 16) { return 0; } }
    if(taskid == 6) { if(pred < 17 || pred > 25) { return 0; } }
    return 1;
}
// frozen confidence: base = 1000*sup/(sup+con+200); INSTALL->base,
// PROVISIONAL->base*6/10, WITHHELD->base*3/10; clamp 0..1000.
fn h1_confidence(sup:i64, con:i64, disp:i32) i64 {
    let base:i64 = 1000 * sup / (sup + con + 200);
    if(base < 0) { base = 0; }
    if(base > 1000) { base = 1000; }
    if(disp == 2) { return base; }
    if(disp == 1) { return base * 6 / 10; }
    return base * 3 / 10;
}
fn main() i32 {
    let t0:[]u8 = _zag_arg(1);
    if(t0.len == 0) { return fail("usage: h1 <task> <fixture> [--stream=ID] [--ablate]"); }
    // reset command
    if(streq(t0, "reset")) {
        let sid:[]u8 = "";
        let a:i32 = 2;
        while(1) {
            let arg:[]u8 = _zag_arg(a);
            if(arg.len == 0) { break; }
            if(has_prefix(arg, "--stream=")) { sid = arg[9..]; }
            if(streq(arg, "--stream")) { sid = _zag_arg(a + 1); a = a + 1; }
            a = a + 1;
        }
        if(sid.len == 0) { return fail("reset needs --stream=ID"); }
        let dir:[]u8 = nio_alloc(300);
        let dp:i32 = ob_add(dir, 0, "h1_mem_");
        dp = ob_add(dir, dp, sid);
        let pj:[]u8 = nio_alloc(320);
        path_join(pj, dir[0..dp], "installed.dat"); z_unlink(pj);
        path_join(pj, dir[0..dp], "prov.dat"); z_unlink(pj);
        path_join(pj, dir[0..dp], "ledger.dat"); z_unlink(pj);
        path_join(pj, dir[0..dp], "conflict.dat"); z_unlink(pj);
        let ob:[]u8 = nio_alloc(256);
        let pos:i32 = 0;
        pos = ob_kv(ob, pos, "approach", "H1");
        pos = ob_kv(ob, pos, "reset", sid);
        nio_write_all(1, ob[0..pos]);
        nio_free(ob); nio_free(pj); nio_free(dir);
        return 0;
    }
    let taskid:i32 = task_id(t0);
    if(taskid == 0) { return fail("unknown task"); }
    let fixture:[]u8 = _zag_arg(2);
    if(fixture.len == 0) { return fail("missing fixture"); }
    let stream:[]u8 = "";
    let ablate:i32 = 0;
    let a:i32 = 3;
    while(1) {
        let arg:[]u8 = _zag_arg(a);
        if(arg.len == 0) { break; }
        if(has_prefix(arg, "--stream=")) { stream = arg[9..]; }
        else if(streq(arg, "--stream")) { stream = _zag_arg(a + 1); a = a + 1; }
        else if(streq(arg, "--ablate")) { ablate = 1; }
        else { return fail("unknown arg"); }
        a = a + 1;
    }
    // ---- read fixture ----
    let buf:[]u8 = nio_alloc(1 << 20);
    if(buf.len == 0) { return fail("no memory"); }
    let nr:i64 = z_read(fixture, buf, 1 << 20);
    if(nr <= 0) { nio_free(buf); return fail("cannot read fixture"); }
    let n:i32 = nr as i32;
    // ---- run extractor ----
    let op:[]u8 = nio_alloc(8);
    t_put64(op, 0, 0);
    let ev:[]u8 = nio_alloc(16 * 256);
    let res:[]u8 = nio_alloc(64);
    if(taskid == 1) { xt_colordisc(buf, n, op, ev, res); }
    if(taskid == 2) { xt_colorconst(buf, n, op, ev, res); }
    if(taskid == 3) { xt_shapetrans(buf, n, op, ev, res); }
    if(taskid == 4) { xt_pitchdisc(buf, n, op, ev, res); }
    if(taskid == 5) { xt_timbredisc(buf, n, op, ev, res); }
    if(taskid == 6) { xt_motiondir(buf, n, op, ev, res); }
    let topi:i32 = t_get64(res, 0) as i32;
    let judg:i64 = t_get64(res, 8);
    let corroborated:i64 = t_get64(res, 16);
    let ne:i64 = t_get64(res, 24);
    let orig_con:i64 = t_get64(res, 48);
    let pred:i64 = ev_get(ev, topi, 6);
    let alo:i64 = ev_get(ev, topi, 7);
    let ahi:i64 = ev_get(ev, topi, 8);
    let sup:i64 = ev_get(ev, topi, 22);
    let con:i64 = ev_get(ev, topi, 23);
    let ops:i64 = t_get64(op, 0);
    let bar:i64 = tmod(taskid);
    // ---- witness addressability (contract step 1) ----
    let wit_ok:i32 = 1;
    let nw:i32 = ev_get(ev, topi, 9) as i32;
    let wi:i32 = 0;
    while(wi < nw) {
        if(wit_ok1(taskid, buf, ev_get(ev, topi, 10 + wi * 3), ev_get(ev, topi, 11 + wi * 3), ev_get(ev, topi, 12 + wi * 3)) == 0) { wit_ok = 0; }
        wi = wi + 1;
    }
    // ---- memory contract ----
    let disp:i32 = 0;
    let retrieved:i32 = -1;
    let retr_sup:i64 = -1;
    let stream_mode:i32 = 0;
    if(stream.len > 0) { stream_mode = 1; }
    // judgment name (for ledger + output)
    let jn_ob:[]u8 = nio_alloc(32);
    let jn_p:i32 = judg_name(taskid, judg, jn_ob, 0);
    let dispname:[]u8 = "WITHHELD";
    if(stream_mode == 0) {
        // stateless: vs empty memory, within-fixture corroboration only
        if(ablate == 1) { disp = 2; }
        else if(sup >= bar && con == 0 && wit_ok == 1) {
            if(corroborated == 1) { disp = 2; } else { disp = 1; }
        } else { disp = 0; }
    }
    if(stream_mode == 1) {
        let dir:[]u8 = nio_alloc(300);
        let dp:i32 = ob_add(dir, 0, "h1_mem_");
        dp = ob_add(dir, dp, stream);
        nio_mkdir(dir[0..dp]);
        let pj:[]u8 = nio_alloc(320);
        let inst:[]u8 = nio_alloc(1024 * 14 * 8);
        let instnames:[]u8 = nio_alloc(1024 * 256);
        let prov:[]u8 = nio_alloc(16 * 14 * 8);
        let provnames:[]u8 = nio_alloc(16 * 256);
        path_join(pj, dir[0..dp], "installed.dat");
        let ninst:i32 = mem_load(pj, inst, 1024, instnames, 1);
        path_join(pj, dir[0..dp], "prov.dat");
        let nprov:i32 = mem_load(pj, prov, 16, provnames, 1);
        // retrieval gating (step 6)
        retrieved = mem_find(inst, ninst, taskid, pred, alo, ahi);
        retr_sup = -1;
        if(retrieved >= 0) { retr_sup = mem_entry_get(inst, retrieved, 5); }
        // contradiction search (step 2)
        if(orig_con > 0 && ninst > 0) {
            let cf:[]u8 = nio_alloc(512);
            path_join(pj, dir[0..dp], "conflict.dat");
            let i:i32 = 0;
            while(i < ninst) {
                if(mem_entry_get(inst, i, 0) == taskid as i64 && mem_entry_get(inst, i, 1) != pred && mem_verify(inst, i, taskid) == 1) {
                    // conflict edge: evid|memidx
                    let cp:i32 = 0;
                    cp = ob_hex64(cf, cp, ev_get(ev, topi, 0));
                    cp = ob_add(cf, cp, "|");
                    cp = ob_add(cf, cp, _zag_i64_to_str(i as i64));
                    cp = ob_add(cf, cp, "\n");
                    z_append(pj, cf, cp);
                }
                i = i + 1;
            }
            nio_free(cf);
        }
        let base:[]u8 = nio_alloc(256);
        let baselen:i32 = fx_base(fixture, base);
        if(ablate == 1) {
            disp = 2;
        } else if(sup >= bar && con == 0 && wit_ok == 1) {
            let pm:i32 = mem_find(prov, nprov, taskid, pred, alo, ahi);
            let cross:i32 = 0;
            if(retrieved >= 0 && name_eq_slot(instnames, retrieved, base, baselen) == 0) { cross = 1; }
            if(pm >= 0 && name_eq_slot(provnames, pm, base, baselen) == 0) { cross = 1; }
            if(corroborated == 1 || cross == 1) {
                disp = 2;
                // promote: drop prov entry if matched
                if(pm >= 0) {
                    let i:i32 = pm + 1;
                    while(i < nprov) {
                        let f:i32 = 0;
                        while(f < 14) { mem_entry_put(prov, i - 1, f, mem_entry_get(prov, i, f)); f = f + 1; }
                        let k:i32 = 0;
                        while(k < 256) { provnames[(i - 1) * 256 + k] = provnames[i * 256 + k]; k = k + 1; }
                        i = i + 1;
                    }
                    nprov = nprov - 1;
                }
                // install if not already stored from this fixture
                let dup:i32 = 0;
                if(retrieved >= 0 && name_eq_slot(instnames, retrieved, base, baselen) == 1) { dup = 1; }
                if(dup == 0 && ninst < 1024) {
                    mem_entry_put(inst, ninst, 0, taskid as i64);
                    mem_entry_put(inst, ninst, 1, pred);
                    mem_entry_put(inst, ninst, 2, ev_get(ev, topi, 0));
                    mem_entry_put(inst, ninst, 3, alo);
                    mem_entry_put(inst, ninst, 4, ahi);
                    mem_entry_put(inst, ninst, 5, sup);
                    mem_entry_put(inst, ninst, 6, con);
                    mem_entry_put(inst, ninst, 7, 0);
                    mem_entry_put(inst, ninst, 8, corroborated);
                    mem_entry_put(inst, ninst, 9, nw as i64);
                    mem_entry_put(inst, ninst, 10, ev_get(ev, topi, 10));
                    mem_entry_put(inst, ninst, 11, ev_get(ev, topi, 11));
                    mem_entry_put(inst, ninst, 12, ev_get(ev, topi, 12));
                    mem_entry_put(inst, ninst, 13, 2);
                    let k:i32 = 0;
                    while(k <= baselen) { instnames[ninst * 256 + k] = base[k]; k = k + 1; }
                    ninst = ninst + 1;
                }
            } else {
                disp = 1;
                if(pm < 0 && nprov < 16) {
                    mem_entry_put(prov, nprov, 0, taskid as i64);
                    mem_entry_put(prov, nprov, 1, pred);
                    mem_entry_put(prov, nprov, 2, ev_get(ev, topi, 0));
                    mem_entry_put(prov, nprov, 3, alo);
                    mem_entry_put(prov, nprov, 4, ahi);
                    mem_entry_put(prov, nprov, 5, sup);
                    mem_entry_put(prov, nprov, 6, con);
                    mem_entry_put(prov, nprov, 7, 0);
                    mem_entry_put(prov, nprov, 8, corroborated);
                    mem_entry_put(prov, nprov, 9, nw as i64);
                    mem_entry_put(prov, nprov, 10, ev_get(ev, topi, 10));
                    mem_entry_put(prov, nprov, 11, ev_get(ev, topi, 11));
                    mem_entry_put(prov, nprov, 12, ev_get(ev, topi, 12));
                    mem_entry_put(prov, nprov, 13, 1);
                    let k:i32 = 0;
                    while(k <= baselen) { provnames[nprov * 256 + k] = base[k]; k = k + 1; }
                    nprov = nprov + 1;
                }
            }
        } else {
            disp = 0;
            let pm:i32 = mem_find(prov, nprov, taskid, pred, alo, ahi);
            if(pm < 0) {
                if(nprov >= 16) {
                    let i:i32 = 1;
                    while(i < 16) {
                        let f:i32 = 0;
                        while(f < 14) { mem_entry_put(prov, i - 1, f, mem_entry_get(prov, i, f)); f = f + 1; }
                        let k:i32 = 0;
                        while(k < 256) { provnames[(i - 1) * 256 + k] = provnames[i * 256 + k]; k = k + 1; }
                        i = i + 1;
                    }
                    nprov = 15;
                }
                mem_entry_put(prov, nprov, 0, taskid as i64);
                mem_entry_put(prov, nprov, 1, pred);
                mem_entry_put(prov, nprov, 2, ev_get(ev, topi, 0));
                mem_entry_put(prov, nprov, 3, alo);
                mem_entry_put(prov, nprov, 4, ahi);
                mem_entry_put(prov, nprov, 5, sup);
                mem_entry_put(prov, nprov, 6, con);
                mem_entry_put(prov, nprov, 7, 0);
                mem_entry_put(prov, nprov, 8, corroborated);
                mem_entry_put(prov, nprov, 9, nw as i64);
                mem_entry_put(prov, nprov, 10, ev_get(ev, topi, 10));
                mem_entry_put(prov, nprov, 11, ev_get(ev, topi, 11));
                mem_entry_put(prov, nprov, 12, ev_get(ev, topi, 12));
                mem_entry_put(prov, nprov, 13, 0);
                let k:i32 = 0;
                while(k <= baselen) { provnames[nprov * 256 + k] = base[k]; k = k + 1; }
                nprov = nprov + 1;
            }
        }
        // ablate mode: install unconditionally (no warrant, no checks)
        if(ablate == 1 && ninst < 1024) {
            mem_entry_put(inst, ninst, 0, taskid as i64);
            mem_entry_put(inst, ninst, 1, pred);
            mem_entry_put(inst, ninst, 2, ev_get(ev, topi, 0));
            mem_entry_put(inst, ninst, 3, alo);
            mem_entry_put(inst, ninst, 4, ahi);
            mem_entry_put(inst, ninst, 5, sup);
            mem_entry_put(inst, ninst, 6, con);
            mem_entry_put(inst, ninst, 7, 0);
            mem_entry_put(inst, ninst, 8, corroborated);
            mem_entry_put(inst, ninst, 9, nw as i64);
            mem_entry_put(inst, ninst, 10, ev_get(ev, topi, 10));
            mem_entry_put(inst, ninst, 11, ev_get(ev, topi, 11));
            mem_entry_put(inst, ninst, 12, ev_get(ev, topi, 12));
            mem_entry_put(inst, ninst, 13, 2);
            let k:i32 = 0;
            while(k <= baselen) { instnames[ninst * 256 + k] = base[k]; k = k + 1; }
            ninst = ninst + 1;
        }
        // save stores
        path_join(pj, dir[0..dp], "installed.dat");
        mem_save(pj, inst, ninst, instnames, 1);
        path_join(pj, dir[0..dp], "prov.dat");
        mem_save(pj, prov, nprov, provnames, 1);
        // ---- ledger ----
        let hb:[]u8 = nio_alloc(16);
        t_put64(hb, 0, ev_get(ev, topi, 0));
        t_put64(hb, 8, ev_get(ev, topi, 1));
        let evid:[]u8 = ns_hex(hb);
        nio_free(hb);
        path_join(pj, dir[0..dp], "ledger.dat");
        let ldata:[]u8 = nio_alloc(1 << 20);
        let lnr:i64 = z_read(pj, ldata, 1 << 20);
        let seq:i64 = 0;
        let prev:[]u8 = nio_alloc(65);
        let pi:i32 = 0;
        while(pi < 64) { prev[pi] = 48; pi = pi + 1; }
        prev[64] = 0;
        if(lnr > 0) {
            let llen:i32 = lnr as i32;
            let p:i32 = 0;
            let ls:i32 = 0;
            while(p < llen) {
                if(ldata[p] == 10) { seq = seq + 1; ls = p + 1; }
                p = p + 1;
            }
            if(seq > 0) {
                let e:i32 = ls - 1;
                let s:i32 = e - 1;
                while(s >= 0 && ldata[s] != 10) { s = s - 1; }
                s = s + 1;
                let q:i32 = e - 1;
                while(q > s && ldata[q] != 124) { q = q - 1; }
                if(ldata[q] == 124) {
                    let k:i32 = 0;
                    while(k < 64 && q + 1 + k < e) { prev[k] = ldata[q + 1 + k]; k = k + 1; }
                }
            }
        }
        nio_free(ldata);
        if(disp == 1) { dispname = "PROVISIONAL"; }
        if(disp == 2) { dispname = "INSTALL"; }
        let le:[]u8 = nio_alloc(4096);
        let lp2:i32 = 0;
        lp2 = ob_add(le, lp2, _zag_i64_to_str(seq));
        lp2 = ob_add(le, lp2, "|");
        lp2 = ob_add(le, lp2, stream);
        lp2 = ob_add(le, lp2, "|");
        lp2 = ob_add(le, lp2, fixture);
        lp2 = ob_add(le, lp2, "|");
        lp2 = ob_add(le, lp2, jn_ob[0..jn_p]);
        lp2 = ob_add(le, lp2, "|");
        lp2 = ob_add(le, lp2, dispname);
        lp2 = ob_add(le, lp2, "|");
        lp2 = ob_add(le, lp2, evid);
        lp2 = ob_add(le, lp2, "|");
        lp2 = ob_add(le, lp2, prev[0..64]);
        let dg:[]u8 = nio_alloc(32);
        ns_sha256(le[0..lp2], dg);
        let hx:[]u8 = ns_hex(dg);
        nio_free(dg);
        op_add(op, lp2 as i64);
        ops = t_get64(op, 0);
        lp2 = ob_add(le, lp2, "|");
        lp2 = ob_add(le, lp2, hx);
        lp2 = ob_add(le, lp2, "\n");
        z_append(pj, le, lp2);
        nio_free(le); nio_free(prev); nio_free(evid);
        nio_free(base);
        nio_free(inst); nio_free(instnames); nio_free(prov); nio_free(provnames);
        nio_free(pj); nio_free(dir);
        // ledger hex for output
        let out_hx:[]u8 = hx;
        // ---- output ----
        let ob:[]u8 = nio_alloc(1 << 16);
        let pos:i32 = 0;
        let sup_eff:i64 = sup;
        if(retr_sup > sup_eff) { sup_eff = retr_sup; }
        let conf:i64 = h1_confidence(sup_eff, con, disp);
        // event records first (count via rc), then kv header, then records
        let rec:[]u8 = nio_alloc(1 << 16);
        let rp:i32 = 0;
        let rc:[]u8 = nio_alloc(8);
        t_put64(rc, 0, 0);
        let ei:i32 = 0;
        while(ei < ne as i32) {
            rp = ev_print(ev, ei, rec, rp, rc);
            ei = ei + 1;
        }
        let nev:i64 = t_get64(rc, 0);
        nio_free(rc);
        pos = ob_kv(ob, pos, "approach", "H1");
        pos = ob_kv(ob, pos, "task", t0);
        pos = ob_kv(ob, pos, "judgment", jn_ob[0..jn_p]);
        pos = ob_kint(ob, pos, "confidence", conf);
        pos = ob_kint(ob, pos, "ops", ops);
        pos = ob_kint(ob, pos, "nev", nev);
        pos = ob_kint(ob, pos, "bytes", rp as i64);
        pos = ob_kv(ob, pos, "disp", dispname);
        pos = ob_kv(ob, pos, "ledger", out_hx);
        if(retrieved >= 0) {
            pos = ob_kint(ob, pos, "retrieved", retrieved as i64);
        }
        nio_write_all(1, ob[0..pos]);
        nio_write_all(1, rec[0..rp]);
        nio_free(hx);
        nio_free(rec); nio_free(ob); nio_free(jn_ob);
        nio_free(res); nio_free(ev); nio_free(op); nio_free(buf);
        return 0;
    }
    // ---- stateless output ----
    if(disp == 1) { dispname = "PROVISIONAL"; }
    if(disp == 2) { dispname = "INSTALL"; }
    let conf:i64 = h1_confidence(sup, con, disp);
    let ob:[]u8 = nio_alloc(1 << 16);
    let pos:i32 = 0;
    let rec:[]u8 = nio_alloc(1 << 16);
    let rp:i32 = 0;
    let rc:[]u8 = nio_alloc(8);
    t_put64(rc, 0, 0);
    let ei:i32 = 0;
    while(ei < ne as i32) {
        rp = ev_print(ev, ei, rec, rp, rc);
        ei = ei + 1;
    }
    let nev:i64 = t_get64(rc, 0);
    nio_free(rc);
    pos = ob_kv(ob, pos, "approach", "H1");
    pos = ob_kv(ob, pos, "task", t0);
    pos = ob_kv(ob, pos, "judgment", jn_ob[0..jn_p]);
    pos = ob_kint(ob, pos, "confidence", conf);
    pos = ob_kint(ob, pos, "ops", ops);
    pos = ob_kint(ob, pos, "nev", nev);
    pos = ob_kint(ob, pos, "bytes", rp as i64);
    pos = ob_kv(ob, pos, "disp", dispname);
    nio_write_all(1, ob[0..pos]);
    nio_write_all(1, rec[0..rp]);
    nio_free(rec); nio_free(ob); nio_free(jn_ob);
    nio_free(res); nio_free(ev); nio_free(op); nio_free(buf);
    return 0;
}

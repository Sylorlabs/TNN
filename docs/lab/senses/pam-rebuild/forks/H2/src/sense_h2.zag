// sense_h2.zag — PAM fork H2: EXECUTABLE PERCEPT PROGRAMS.
//
// A percept is a canonical bounded program: subject_slots, observations
// (primitive witness bindings from sparse evidence spans), relations,
// ordered tests T1..Tn (validity, direction, margin, prediction), a
// predicted consequence P1 (the same measurement re-executed on a HELD-OUT
// evidence span — disjoint pixels / samples / frames), result
// PASS | FAIL | UNRESOLVED, source_refs, cost (= ops).
//
// CLI: sense_h2 <task> <fixture-path>   (same fixture formats as INTERFACE.md)
// stdout: approach=H2, task=, judgment=, confidence=0..1000, ops=, prog=,
//         pred=0|1, cost=, measure=, program=  (one key=value per line)
// Exit 0 on success; approach=H2 + task= + error=<reason>, exit 1 on failure.
//
// Pure Zag, integer math only, zero RNG, fully deterministic: 3 runs of the
// same binary+fixture are byte-identical.
//
// znc bug workarounds honored (INTERFACE.md / AGENTS.md): no argc gate, no
// `as []i32` casts ([]u8 arenas + LE accessors), `_zag_strcmp`==1 on
// equality, no slice > 2^25 indexed, NUL-terminated paths via z_cstr,
// `_zag_raw_syscall` exactly 7 args, shallow else-nesting, no `};`.

@import("R33_NATIVE_IO_V1.zag")
@import("lut.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}

// ---------------- ops counter (8-byte arena) -----------------------------
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- integer math -------------------------------------------
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
// integer power, base >= 0, small exponents
fn ipow(b:i64, e:i32) i64 {
    let r:i64 = 1;
    let i:i32 = 0;
    while(i < e) { r = r * b; i = i + 1; }
    return r;
}

// ---------------- file IO -------------------------------------------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// ---------------- stdout line builder ------------------------------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn ob_pair(ob:[]u8, pos:i32, name:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, name);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, _zag_i64_to_str(v));
    pos = ob_add(ob, pos, ";");
    return pos;
}
fn fail(task:[]u8, reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "H2");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "error", reason);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

// sin(p) * 1024, p = turn in [0, 2^32). Table-free fixed-point Taylor with
// quadrant folding.
fn ng_sin1024(p:i64) i64 {
    let q:i64 = (p >> 30) & 3;
    let fr:i64 = p & 1073741823;
    let x:i64 = (fr * 1608) >> 30;
    let xx:i64 = x;
    if(q == 1 || q == 3) { xx = 1608 - x; }
    let x2:i64 = xx * xx;
    let term:i64 = xx;
    let sum:i64 = xx;
    let k:i64 = 1;
    while(k <= 7) {
        term = 0 - term * x2 / ((2 * k) * (2 * k + 1) * 1048576);
        sum = sum + term;
        k = k + 1;
    }
    if(q >= 2) { return 0 - sum; }
    return sum;
}
// cos(p)*1024 via the sin table.
fn ng_cos1024(p:i64) i64 {
    return ng_sin1024((p + 1073741824) & 4294967295);
}
// atan2(y,x) in millidegrees [0,360000), via binary search on the sin table.
// 22 iterations -> resolution < 0.0001 degree.
fn atan2_mdeg(y:i64, x:i64) i64 {
    if(x == 0 && y == 0) { return 0; }
    let ay:i64 = iabs(y);
    let ax:i64 = iabs(x);
    let lo:i64 = 0;
    let hi:i64 = 1073741824;
    let it:i32 = 0;
    while(it < 22) {
        let mid:i64 = (lo + hi) / 2;
        let s:i64 = ng_sin1024(mid);
        let c:i64 = ng_cos1024(mid);
        if(ay * c > ax * s) { lo = mid; } else { hi = mid; }
        it = it + 1;
    }
    let mdeg:i64 = lo * 360000 / 4294967296;
    if(x >= 0 && y >= 0) { return mdeg; }
    if(x < 0 && y >= 0) { return 180000 - mdeg; }
    if(x < 0 && y < 0) { return 180000 + mdeg; }
    return 360000 - mdeg;
}

// ================= audio helpers =========================================
// Peak amplitude (for the deadband).
fn pcm_peak(buf:[]u8, off:i32, cnt:i32) i64 {
    let p:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let s:i64 = iabs(t_geti16(buf, off + i * 2));
        if(s > p) { p = s; }
        i = i + 1;
    }
    return p;
}
// Harmonic energy at harmonics of f0m (milli-Hz) over w samples at off.
// op counts 2 element-visits per (sample, harmonic).
fn harm_energy(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, nhmax:i32, op:[]u8) i64 {
    if(f0m <= 0 || w < 64) { return 0; }
    let pinc1:i64 = f0m * 4294967296 / (1000 * sr);
    if(pinc1 <= 0) { return 0; }
    let tot:i64 = 0;
    let h:i64 = 1;
    while(h <= nhmax as i64) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let pinc:i64 = h * pinc1;
        let re:i64 = 0;
        let im:i64 = 0;
        let i:i32 = 0;
        while(i < w) {
            let s:i64 = t_geti16(buf, off + i * 2);
            let p:i64 = ((i as i64) * pinc) & 4294967295;
            re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
            im = im + s * ng_sin1024(p) / 1024;
            i = i + 1;
        }
        op_add(op, (2 * w) as i64);
        tot = tot + (re * re + im * im) / 1048576;
        h = h + 1;
    }
    return tot;
}

// H2 robust fundamental (milli-Hz): same structure as Approach A but on a
// shorter window (wcap 1024) and a narrower fine grid (+-2% at 0.15% steps,
// 27 points) — the sparse-measurement analog. Autocorrelation (coarse) +
// harmonic-energy maximization (fine) + parabolic interpolation +
// matched-coverage octave guard. Returns 0 on failure.
fn f0_h2(buf:[]u8, off:i32, cnt:i32, sr:i64, op:[]u8) i64 {
    let w:i32 = cnt;
    if(w > 1024) { w = 1024; }
    if(w < 512) { return 0; }
    let peak:i64 = pcm_peak(buf, off, w);
    if(peak < 256) { return 0; }
    let ms:i64 = 0;
    let i:i32 = 0;
    while(i < w) { ms = ms + t_geti16(buf, off + i * 2); i = i + 1; }
    let mean:i64 = ms / (w as i64);
    op_add(op, (2 * w) as i64);
    let lmin:i32 = (sr / 2000) as i32;
    if(lmin < 2) { lmin = 2; }
    let lmax:i32 = (sr / 50) as i32;
    if(lmax > w / 3) { lmax = w / 3; }
    if(lmax < lmin + 2) { return 0; }
    let nl:i32 = lmax - lmin + 3;
    let ra:[]u8 = nio_alloc((nl * 8) as i32);
    if(ra.len == 0) { return 0; }
    let l:i32 = lmin - 1;
    while(l <= lmax + 1) {
        let acc:i64 = 0;
        let nn:i32 = w - l;
        let n:i32 = 0;
        while(n < nn) {
            let a:i64 = t_geti16(buf, off + n * 2) - mean;
            let b:i64 = t_geti16(buf, off + (n + l) * 2) - mean;
            acc = acc + a * b;
            n = n + 1;
        }
        op_add(op, nn as i64);
        t_put64(ra, (l - (lmin - 1)) * 8, acc);
        l = l + 1;
    }
    let gmax:i64 = 0;
    l = lmin;
    while(l <= lmax) {
        let r:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
        if(r > gmax) { gmax = r; }
        l = l + 1;
    }
    let lstar:i32 = -1;
    let r0:i64 = 0;
    let rm:i64 = 0;
    let rp:i64 = 0;
    if(gmax > 0) {
        l = lmin;
        while(l <= lmax) {
            let q0:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
            let qm:i64 = t_get64(ra, (l - 1 - (lmin - 1)) * 8);
            let qp:i64 = t_get64(ra, (l + 1 - (lmin - 1)) * 8);
            if(q0 >= qm && q0 >= qp && q0 * 2 >= gmax) {
                lstar = l;
                r0 = q0;
                rm = qm;
                rp = qp;
                break;
            }
            l = l + 1;
        }
    }
    nio_free(ra);
    if(lstar < 0) { return 0; }
    let den:i64 = 2 * (rm - 2 * r0 + rp);
    let poff:i64 = 0;
    if(den != 0) { poff = (rm - rp) * 1024 / den; }
    if(poff < -512) { poff = -512; }
    if(poff > 512) { poff = 512; }
    let period_1024:i64 = (lstar as i64) * 1024 + poff;
    if(period_1024 <= 0) { return 0; }
    let f0c:i64 = sr * 1000 * 1024 / period_1024;
    // fine grid: f0c*(1 + k*0.0015), k in -13..13 (27 points)
    let best_k:i32 = -13;
    let best_s:i64 = -1;
    let k:i32 = -13;
    while(k <= 13) {
        let f0k:i64 = f0c + f0c * (k as i64) * 15 / 10000;
        let s:i64 = harm_energy(buf, off, w, sr, f0k, 6, op);
        if(s > best_s) { best_s = s; best_k = k; }
        k = k + 1;
    }
    if(best_s <= 0) { return 0; }
    let sm:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k - 1) as i64) * 15 / 10000, 6, op);
    let sp:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k + 1) as i64) * 15 / 10000, 6, op);
    let den2:i64 = 2 * (sm - 2 * best_s + sp);
    let koff:i64 = 0;
    if(den2 != 0) { koff = (sm - sp) * 1024 / den2; }
    if(koff < -512) { koff = -512; }
    if(koff > 512) { koff = 512; }
    let f0m:i64 = f0c + f0c * ((best_k as i64) * 1024 + koff) * 15 / (1024 * 10000);
    if(f0m <= 0) { return 0; }
    // octave guard with matched harmonic coverage (same as Approach A)
    let e0:i64 = harm_energy(buf, off, w, sr, f0m, 8, op);
    let ehalf:i64 = harm_energy(buf, off, w, sr, f0m / 2, 16, op);
    let edbl:i64 = harm_energy(buf, off, w, sr, f0m * 2, 4, op);
    if(ehalf > e0 + e0 / 20) { return f0m / 2; }
    if(edbl > e0 + e0 / 20) { return f0m * 2; }
    return f0m;
}

// ================= integer colorimetry ===================================
// sRGB -> CIELAB -> CIEDE2000, all integer fixed-point.
// Lab in milli-units; de2000_m returns milli-dE.

// integer cbrt: returns round(1e6 * cbrt(v/1e6)), v in 1e6 scale, v >= 0
fn cbrt_1e6(v:i64) i64 {
    if(v <= 0) { return 0; }
    let x:i64 = 1000000;
    let it:i32 = 0;
    while(it < 14) {
        let x2:i64 = x * x / 1000000;
        if(x2 <= 0) { x2 = 1; }
        x = (2 * x + v * 1000000 / x2) / 3;
        it = it + 1;
    }
    return x;
}
fn lab_f(t_1e6:i64) i64 {
    if(t_1e6 > 8856) { return cbrt_1e6(t_1e6); }
    return (7787 * t_1e6) / 1000000 + 137931;
}
// out: L,a,b milli at out[0], out[8], out[16]
fn rgb_to_lab_m(r:i64, g:i64, b:i64, lut:[]u8, out:[]u8) void {
    let rl:i64 = t_get64(lut, (r as i32) * 8);
    let gl:i64 = t_get64(lut, (g as i32) * 8);
    let bl:i64 = t_get64(lut, (b as i32) * 8);
    let x:i64 = (412456 * rl + 357576 * gl + 180437 * bl + 500000) / 1000000;
    let y:i64 = (212673 * rl + 715152 * gl + 72175 * bl + 500000) / 1000000;
    let z:i64 = (19334 * rl + 119192 * gl + 950304 * bl + 500000) / 1000000;
    let fx:i64 = lab_f(x * 1000000 / 950470);
    let fy:i64 = lab_f(y * 1000000 / 1000000);
    let fz:i64 = lab_f(z * 1000000 / 1088830);
    t_put64(out, 0, (116 * fy - 16000000) / 1000);
    t_put64(out, 8, 500 * (fx - fy) / 1000);
    t_put64(out, 16, 200 * (fy - fz) / 1000);
}
// exp(-x) in 1e6, x in 1e6, x >= 0
fn exp_neg_1e6(x:i64) i64 {
    if(x <= 0) { return 1000000; }
    let xk:i64 = x >> 6;
    let term:i64 = 1000000;
    let sum:i64 = 1000000;
    let n:i64 = 1;
    while(n <= 11) {
        term = 0 - term * xk / (n * 1000000);
        sum = sum + term;
        n = n + 1;
    }
    let i:i32 = 0;
    while(i < 6) { sum = sum * sum / 1000000; i = i + 1; }
    return sum;
}
// sqrt(v^7/(v^7+25^7)) in 1e6, v in Lab units (rounded), v >= 0
fn c7_frac_1e6(vu:i64) i64 {
    if(vu <= 0) { return 0; }
    if(vu > 250) { return 1000000; }
    let num:i64 = ipow(vu, 7);
    let den:i64 = num + 6103515625;
    let q:i64 = den / 1000000;
    if(q <= 0) { q = 1; }
    return num / q;
}
// cos of millidegrees, *1024
fn cos_mdeg(mdeg:i64) i64 {
    return ng_cos1024((mdeg * 4294967296 / 360000) & 4294967295);
}
// CIEDE2000, Lab inputs in milli-units, returns milli-dE.
fn de2000_m(l1:i64, a1:i64, b1:i64, l2:i64, a2:i64, b2:i64) i64 {
    let c1:i64 = isqrt(a1 * a1 + b1 * b1);
    let c2:i64 = isqrt(a2 * a2 + b2 * b2);
    let cb:i64 = (c1 + c2) / 2;
    let g:i64 = 500000 - isqrt(c7_frac_1e6(cb / 1000)) * 1000 / 2;
    let ap1:i64 = a1 + a1 * g / 1000000;
    let ap2:i64 = a2 + a2 * g / 1000000;
    let cp1:i64 = isqrt(ap1 * ap1 + b1 * b1);
    let cp2:i64 = isqrt(ap2 * ap2 + b2 * b2);
    let hp1:i64 = atan2_mdeg(b1, ap1);
    let hp2:i64 = atan2_mdeg(b2, ap2);
    let dl:i64 = l2 - l1;
    let dc:i64 = cp2 - cp1;
    let dh:i64 = 0;
    let dhv:i64 = 0;
    if(cp1 * cp2 != 0) {
        dh = hp2 - hp1;
        if(dh > 180000) { dh = dh - 360000; }
        if(dh < -180000) { dh = dh + 360000; }
        let sh:i64 = ng_sin1024((dh * 4294967296 / 720000) & 4294967295);
        dhv = 2 * isqrt(cp1 * cp2) * sh / 1024;
    }
    let lbp:i64 = (l1 + l2) / 2;
    let cbp:i64 = (cp1 + cp2) / 2;
    let hbp:i64 = hp1 + hp2;
    if(cp1 * cp2 != 0) {
        let ad:i64 = iabs(hp1 - hp2);
        if(ad <= 180000) { hbp = (hp1 + hp2) / 2; }
        else {
            if(hp1 + hp2 < 360000) { hbp = (hp1 + hp2 + 360000) / 2; }
            else { hbp = (hp1 + hp2 - 360000) / 2; }
        }
    }
    let t_1e6:i64 = 1000000 - 170000 * cos_mdeg(hbp - 30000) / 1024
        + 240000 * cos_mdeg(2 * hbp) / 1024
        + 320000 * cos_mdeg(3 * hbp + 6000) / 1024
        - 200000 * cos_mdeg(4 * hbp - 63000) / 1024;
    let vd:i64 = (hbp - 275000) / 25;
    let dro_1e6:i64 = 30 * exp_neg_1e6(vd * vd / 1000);
    let rc_1e6:i64 = 2 * isqrt(c7_frac_1e6(cbp / 1000)) * 1000;
    let du:i64 = (lbp - 50000) / 1000;
    let sl_1e6:i64 = 1000000 + 15000 * du * du / imax(isqrt(20 + du * du), 1);
    let cbpu:i64 = cbp / 1000;
    let sc_1e6:i64 = 1000000 + 45000 * cbpu;
    let sh_1e6:i64 = 1000000 + 15000 * cbpu * t_1e6 / 1000000;
    let tl:i64 = dl * 1000000 / sl_1e6;
    let tc:i64 = dc * 1000000 / sc_1e6;
    let th:i64 = dhv * 1000000 / sh_1e6;
    let rt_1e6:i64 = 0 - ng_sin1024((dro_1e6 * 2 * 4294967296 / 360000000) & 4294967295) * rc_1e6 / 1024;
    let cross:i64 = rt_1e6 * tc / 1000000000 * th / 1000000000;
    let de2:i64 = tl * tl + tc * tc + th * th + cross;
    if(de2 < 0) { de2 = 0; }
    return isqrt(de2);
}

// ================= shared test resolution =================================
// result codes: 0=PASS, 1=FAIL, 2=UNRESOLVED
fn resolve(t1:i32, t2d:i32, t2c:i32, t3:i32, p1:i32) i32 {
    if(t1 == 0) { return 2; }
    if(t2d == 0) { return 1; }
    if(t2c == 0) { return 2; }
    if(t3 == 0) { return 2; }
    if(p1 == 0) { return 2; }
    return 0;
}
fn res_str(r:i32) []u8 {
    if(r == 0) { return "PASS"; }
    if(r == 1) { return "FAIL"; }
    return "UNRESOLVED";
}
// confidence 0..1000 from margin m (same units as the task's measure):
// 1000*m/(m+k), k = task margin scale.
fn conf_of(m:i64, k:i64) i64 {
    if(m < 0) { m = 0 - m; }
    return 1000 * m / (m + k);
}

// ================= colordisc =============================================
// Sparse-span color-difference program. Spans: rows%16==0 (O1),
// rows%16==8 (O2), rows%16==4 (held-out PRED). dE = integer CIEDE2000.
fn task_colordisc(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8, lut:[]u8) i32 {
    let w:i64 = t_get32(buf, 0);
    let h:i64 = t_get32(buf, 4);
    if(w != 128 || h != 64) { return -1; }
    if(8 + w * h * 3 > n as i64) { return -1; }
    // sums[3 spans][2 halves][r,g,b] + cnt
    let acc:[]u8 = nio_alloc(3 * 2 * 4 * 8);
    if(acc.len == 0) { return -1; }
    let s:i32 = 0;
    while(s < 24) { t_put64(acc, s * 8, 0); s = s + 1; }
    let y:i32 = 0;
    let spans:[]u8 = nio_alloc(3);
    spans[0] = 0; spans[1] = 8; spans[2] = 4;
    let visits:i64 = 0;
    while(y < 64) {
        let m:i32 = y % 16;
        let si:i32 = -1;
        if(m == 0) { si = 0; }
        if(m == 8) { si = 1; }
        if(m == 4) { si = 2; }
        if(si >= 0) {
            let x:i32 = 0;
            while(x < 128) {
                let h2:i32 = 0;
                if(x >= 64) { h2 = 1; }
                let o:i32 = 8 + (y * 128 + x) * 3;
                let base:i32 = (si * 2 + h2) * 4;
                t_put64(acc, (base + 0) * 8, t_get64(acc, (base + 0) * 8) + (buf[o] as i64));
                t_put64(acc, (base + 1) * 8, t_get64(acc, (base + 1) * 8) + (buf[o + 1] as i64));
                t_put64(acc, (base + 2) * 8, t_get64(acc, (base + 2) * 8) + (buf[o + 2] as i64));
                t_put64(acc, (base + 3) * 8, t_get64(acc, (base + 3) * 8) + 1);
                x = x + 1;
            }
            visits = visits + 128;
        }
        y = y + 1;
    }
    op_add(op, visits);
    nio_free(spans);
    let lab:[]u8 = nio_alloc(48);
    let de:[]u8 = nio_alloc(24);
    let si2:i32 = 0;
    let t1:i32 = 1;
    while(si2 < 3) {
        let h2:i32 = 0;
        let lr:i64 = 0;
        let lg:i64 = 0;
        let lb:i64 = 0;
        while(h2 < 2) {
            let base:i32 = (si2 * 2 + h2) * 4;
            let cnt:i64 = t_get64(acc, (base + 3) * 8);
            if(cnt <= 0) { t1 = 0; }
            let mr:i64 = 0;
            let mg:i64 = 0;
            let mb:i64 = 0;
            if(cnt > 0) {
                mr = t_get64(acc, (base + 0) * 8) / cnt;
                mg = t_get64(acc, (base + 1) * 8) / cnt;
                mb = t_get64(acc, (base + 2) * 8) / cnt;
            }
            rgb_to_lab_m(mr, mg, mb, lut, lab);
            if(h2 == 0) {
                lr = t_get64(lab, 0); lg = t_get64(lab, 8); lb = t_get64(lab, 16);
            } else {
                t_put64(de, si2 * 8, de2000_m(lr, lg, lb, t_get64(lab, 0), t_get64(lab, 8), t_get64(lab, 16)));
            }
            h2 = h2 + 1;
        }
        op_add(op, 8);
        si2 = si2 + 1;
    }
    nio_free(lab);
    // combined means for the program slots (O1+O2 spans)
    let cm:[]u8 = nio_alloc(48);
    let h3:i32 = 0;
    while(h3 < 2) {
        let sr:i64 = t_get64(acc, (0 * 2 + h3) * 4 * 8) + t_get64(acc, (1 * 2 + h3) * 4 * 8);
        let sg:i64 = t_get64(acc, ((0 * 2 + h3) * 4 + 1) * 8) + t_get64(acc, ((1 * 2 + h3) * 4 + 1) * 8);
        let sb:i64 = t_get64(acc, ((0 * 2 + h3) * 4 + 2) * 8) + t_get64(acc, ((1 * 2 + h3) * 4 + 2) * 8);
        let cn:i64 = t_get64(acc, ((0 * 2 + h3) * 4 + 3) * 8) + t_get64(acc, ((1 * 2 + h3) * 4 + 3) * 8);
        if(cn > 0) {
            t_put64(cm, h3 * 24, sr / cn);
            t_put64(cm, h3 * 24 + 8, sg / cn);
            t_put64(cm, h3 * 24 + 16, sb / cn);
        }
        h3 = h3 + 1;
    }
    nio_free(acc);
    // combined dE from the combined means
    let lab3:[]u8 = nio_alloc(48);
    rgb_to_lab_m(t_get64(cm, 0), t_get64(cm, 8), t_get64(cm, 16), lut, lab3);
    let l1:i64 = t_get64(lab3, 0);
    let a1:i64 = t_get64(lab3, 8);
    let b1:i64 = t_get64(lab3, 16);
    rgb_to_lab_m(t_get64(cm, 24), t_get64(cm, 32), t_get64(cm, 40), lut, lab3);
    let decm:i64 = de2000_m(l1, a1, b1, t_get64(lab3, 0), t_get64(lab3, 8), t_get64(lab3, 16));
    nio_free(lab3);
    op_add(op, 8);
    let d0:i64 = t_get64(de, 0);
    let d1:i64 = t_get64(de, 8);
    let d2:i64 = t_get64(de, 16);
    nio_free(de);
    let hh:i64 = 0;
    if(decm >= 2300) { hh = 1; }
    let dir0:i64 = 0;
    if(d0 >= 2300) { dir0 = 1; }
    let dir1:i64 = 0;
    if(d1 >= 2300) { dir1 = 1; }
    let dir2:i64 = 0;
    if(d2 >= 2300) { dir2 = 1; }
    let t2d:i32 = 0;
    if(dir0 == hh && dir1 == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(d0 - d1) <= 600) { t2c = 1; }
    let mrg:i64 = iabs(decm - 2300);
    let t3:i32 = 0;
    if(mrg >= 400) { t3 = 1; }
    let p1:i32 = 0;
    if(dir2 == hh && iabs(d2 - decm) <= 600) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    let judge:i64 = hh;
    if(r == 1) { judge = 1 - hh; }
    let jstr:[]u8 = "SAME";
    if(judge == 1) { jstr = "DIFFERENT"; }
    pos = ob_kv(ob, pos, "judgment", jstr);
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 1500));
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p1 as i64);
    pos = ob_kint(ob, pos, "measure", (decm + 50) / 100);
    pos = ob_add(ob, pos, "program=H2/colordisc|S1=patchL:mean=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 0)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 8)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 16)));
    pos = ob_add(ob, pos, "|S2=patchR:mean=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 24)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 32)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cm, 40)));
    nio_free(cm);
    pos = ob_add(ob, pos, "|O1=span(rows%16==0):dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((d0 + 50) / 100));
    pos = ob_add(ob, pos, "|O2=span(rows%16==8):dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((d1 + 50) / 100));
    pos = ob_add(ob, pos, "|R=dEcm=");
    pos = ob_add(ob, pos, _zag_i64_to_str((decm + 50) / 100));
    pos = ob_add(ob, pos, ",thr=23.0|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=span(rows%16==4):dE=");
    pos = ob_add(ob, pos, _zag_i64_to_str((d2 + 50) / 100));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= colorconst ============================================
// Sparse-span illumination-invariant surface program. Same spans as
// colordisc (rows%24 in {0,12,6}); per span/half: von Kries-normalized
// channel means; distance in per-mille. Threshold 150 per-mille.
fn task_colorconst(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8, lut:[]u8) i32 {
    let w:i64 = t_get32(buf, 0);
    let h:i64 = t_get32(buf, 4);
    if(w != 128 || h != 64) { return -1; }
    if(8 + w * h * 3 > n as i64) { return -1; }
    // acc: 3 spans x 2 halves x (sr,sg,sb,mr,mg,mb,cnt) i64
    let acc:[]u8 = nio_alloc(3 * 2 * 7 * 8);
    if(acc.len == 0) { return -1; }
    let s:i32 = 0;
    while(s < 42) { t_put64(acc, s * 8, 0); s = s + 1; }
    let y:i32 = 0;
    let visits:i64 = 0;
    while(y < 64) {
        let m:i32 = y % 16;
        let si:i32 = -1;
        if(m == 0) { si = 0; }
        if(m == 8) { si = 1; }
        if(m == 4) { si = 2; }
        if(si >= 0) {
            let x:i32 = 0;
            while(x < 128) {
                let hh:i32 = 0;
                if(x >= 64) { hh = 1; }
                let o:i32 = 8 + (y * 128 + x) * 3;
                let base:i32 = (si * 2 + hh) * 7;
                let r:i64 = buf[o] as i64;
                let g:i64 = buf[o + 1] as i64;
                let b:i64 = buf[o + 2] as i64;
                t_put64(acc, (base + 0) * 8, t_get64(acc, (base + 0) * 8) + r);
                t_put64(acc, (base + 1) * 8, t_get64(acc, (base + 1) * 8) + g);
                t_put64(acc, (base + 2) * 8, t_get64(acc, (base + 2) * 8) + b);
                if(r > t_get64(acc, (base + 3) * 8)) { t_put64(acc, (base + 3) * 8, r); }
                if(g > t_get64(acc, (base + 4) * 8)) { t_put64(acc, (base + 4) * 8, g); }
                if(b > t_get64(acc, (base + 5) * 8)) { t_put64(acc, (base + 5) * 8, b); }
                t_put64(acc, (base + 6) * 8, t_get64(acc, (base + 6) * 8) + 1);
                x = x + 1;
            }
            visits = visits + 128;
        }
        y = y + 1;
    }
    op_add(op, visits);
    // normalized distance per span: dist[3]
    let dist:[]u8 = nio_alloc(24);
    let si2:i32 = 0;
    let t1:i32 = 1;
    while(si2 < 3) {
        let nr:[]u8 = nio_alloc(48);
        let h2:i32 = 0;
        while(h2 < 2) {
            let base:i32 = (si2 * 2 + h2) * 7;
            let cnt:i64 = t_get64(acc, (base + 6) * 8);
            if(cnt <= 0) { t1 = 0; }
            let c:i32 = 0;
            while(c < 3) {
                let mx:i64 = t_get64(acc, (base + 3 + c) * 8);
                let nv:i64 = 0;
                if(mx > 0 && cnt > 0) {
                    nv = t_get64(acc, (base + c) * 8) * 1000 / (cnt * mx);
                }
                t_put64(nr, (h2 * 3 + c) * 8, nv);
                c = c + 1;
            }
            h2 = h2 + 1;
        }
        let dr:i64 = t_get64(nr, 0) - t_get64(nr, 24);
        let dg:i64 = t_get64(nr, 8) - t_get64(nr, 32);
        let db:i64 = t_get64(nr, 16) - t_get64(nr, 40);
        t_put64(dist, si2 * 8, isqrt(dr * dr + dg * dg + db * db));
        nio_free(nr);
        op_add(op, 8);
        si2 = si2 + 1;
    }
    // combined over spans 0+1
    let cnr:[]u8 = nio_alloc(48);
    let h3:i32 = 0;
    while(h3 < 2) {
        let c:i32 = 0;
        while(c < 3) {
            let sr:i64 = t_get64(acc, ((0 * 2 + h3) * 7 + c) * 8) + t_get64(acc, ((1 * 2 + h3) * 7 + c) * 8);
            let mx:i64 = t_get64(acc, ((0 * 2 + h3) * 7 + 3 + c) * 8);
            let mx2:i64 = t_get64(acc, ((1 * 2 + h3) * 7 + 3 + c) * 8);
            if(mx2 > mx) { mx = mx2; }
            let cnt:i64 = t_get64(acc, ((0 * 2 + h3) * 7 + 6) * 8) + t_get64(acc, ((1 * 2 + h3) * 7 + 6) * 8);
            let nv:i64 = 0;
            if(mx > 0 && cnt > 0) { nv = sr * 1000 / (cnt * mx); }
            t_put64(cnr, (h3 * 3 + c) * 8, nv);
            c = c + 1;
        }
        h3 = h3 + 1;
    }
    nio_free(acc);
    op_add(op, 8);
    let ddr:i64 = t_get64(cnr, 0) - t_get64(cnr, 24);
    let ddg:i64 = t_get64(cnr, 8) - t_get64(cnr, 32);
    let ddb:i64 = t_get64(cnr, 16) - t_get64(cnr, 40);
    let dcm:i64 = isqrt(ddr * ddr + ddg * ddg + ddb * ddb);
    let d0:i64 = t_get64(dist, 0);
    let d1:i64 = t_get64(dist, 8);
    let d2:i64 = t_get64(dist, 16);
    nio_free(dist);
    let hh:i64 = 0;
    if(dcm >= 150) { hh = 1; }
    let dir0:i64 = 0;
    if(d0 >= 150) { dir0 = 1; }
    let dir1:i64 = 0;
    if(d1 >= 150) { dir1 = 1; }
    let dir2:i64 = 0;
    if(d2 >= 150) { dir2 = 1; }
    let t2d:i32 = 0;
    if(dir0 == hh && dir1 == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(d0 - d1) <= 60) { t2c = 1; }
    let mrg:i64 = iabs(dcm - 150);
    let t3:i32 = 0;
    if(mrg >= 50) { t3 = 1; }
    let p1:i32 = 0;
    if(dir2 == hh && iabs(d2 - dcm) <= 60) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    let judge:i64 = hh;
    if(r == 1) { judge = 1 - hh; }
    let jstr:[]u8 = "SAME_SURFACE";
    if(judge == 1) { jstr = "DIFFERENT"; }
    pos = ob_kv(ob, pos, "judgment", jstr);
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 150));
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p1 as i64);
    pos = ob_kint(ob, pos, "measure", dcm);
    pos = ob_add(ob, pos, "program=H2/colorconst|S1=surfL:norm=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 0)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 8)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 16)));
    pos = ob_add(ob, pos, "|S2=surfR:norm=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 24)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 32)));
    pos = ob_add(ob, pos, ",");
    pos = ob_add(ob, pos, _zag_i64_to_str(t_get64(cnr, 40)));
    nio_free(cnr);
    pos = ob_add(ob, pos, "|O1=span(rows%16==0):dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d0));
    pos = ob_add(ob, pos, "|O2=span(rows%16==8):dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d1));
    pos = ob_add(ob, pos, "|R=distcm=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dcm));
    pos = ob_add(ob, pos, ",thr=150|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=span(rows%16==4):dist=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d2));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= shapetrans ============================================
// Sparse-grid shape program. Grids: (x+y)%12==0 (O1), ==6 (O2), ==3
// (held-out PRED). Foreground = bright minority (lum>382). Combined
// centroid from O1+O2; window-refined max radius around the grid max-d2
// point; ratio = area/(pi*R^2) vs calibrated prototypes 974/684/464
// (calibrated on frozen primary; theoretical 1000/637/414). Cost ~18%
// of Approach A.
// out: r1@0, r2@8, r3@16, a1@24, a2@32, a3@40, maxd2@48, cx@56, cy@64
fn shape_measure(buf:[]u8, op:[]u8, out:[]u8) void {
    let bcs:[]u8 = nio_alloc(24);
    let ngs:[]u8 = nio_alloc(24);
    let fgs:[]u8 = nio_alloc(24);
    let sxs:[]u8 = nio_alloc(24);
    let sys:[]u8 = nio_alloc(24);
    let gi:i32 = 0;
    while(gi < 3) {
        let rem:i32 = 0;
        if(gi == 1) { rem = 6; }
        if(gi == 2) { rem = 3; }
        let bc:i64 = 0;
        let ng:i64 = 0;
        let y:i32 = 0;
        while(y < 96) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    ng = ng + 1;
                    if(lum > 382) { bc = bc + 1; }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        op_add(op, ng);
        t_put64(bcs, gi * 8, bc);
        t_put64(ngs, gi * 8, ng);
        gi = gi + 1;
    }
    let bc12:i64 = t_get64(bcs, 0) + t_get64(bcs, 8);
    let ng12:i64 = t_get64(ngs, 0) + t_get64(ngs, 8);
    let fgbright:i32 = 0;
    if(2 * bc12 <= ng12) { fgbright = 1; }
    gi = 0;
    while(gi < 3) {
        let rem:i32 = 0;
        if(gi == 1) { rem = 6; }
        if(gi == 2) { rem = 3; }
        let fg:i64 = 0;
        let sx:i64 = 0;
        let sy:i64 = 0;
        let y:i32 = 0;
        while(y < 96) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    let bright:i32 = 0;
                    if(lum > 382) { bright = 1; }
                    if(bright == fgbright) { fg = fg + 1; sx = sx + (x as i64); sy = sy + (y as i64); }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        op_add(op, t_get64(ngs, gi * 8));
        t_put64(fgs, gi * 8, fg);
        t_put64(sxs, gi * 8, sx);
        t_put64(sys, gi * 8, sy);
        gi = gi + 1;
    }
    let fg12:i64 = t_get64(fgs, 0) + t_get64(fgs, 8);
    let cx:i64 = 48;
    let cy:i64 = 48;
    if(fg12 > 0) {
        cx = (t_get64(sxs, 0) + t_get64(sxs, 8)) / fg12;
        cy = (t_get64(sys, 0) + t_get64(sys, 8)) / fg12;
    }
    let px:i32 = 48;
    let py:i32 = 48;
    let best:i64 = -1;
    gi = 0;
    while(gi < 2) {
        let rem:i32 = 0;
        if(gi == 1) { rem = 6; }
        let y:i32 = 0;
        while(y < 96) {
            let x:i32 = 0;
            while(x < 96) {
                if((x + y) % 12 == rem) {
                    let o:i32 = 8 + (y * 96 + x) * 3;
                    let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    let bright:i32 = 0;
                    if(lum > 382) { bright = 1; }
                    if(bright == fgbright) {
                        let dx:i64 = (x as i64) - cx;
                        let dy:i64 = (y as i64) - cy;
                        let d2:i64 = dx * dx + dy * dy;
                        if(d2 > best) { best = d2; px = x; py = y; }
                    }
                }
                x = x + 1;
            }
            y = y + 1;
        }
        op_add(op, t_get64(ngs, gi * 8));
        gi = gi + 1;
    }
    let maxd2:i64 = best;
    if(maxd2 < 0) { maxd2 = 0; }
    let wy:i32 = py - 10;
    if(wy < 0) { wy = 0; }
    let wy1:i32 = py + 10;
    if(wy1 > 95) { wy1 = 95; }
    let wvis:i64 = 0;
    while(wy <= wy1) {
        let wx:i32 = px - 10;
        if(wx < 0) { wx = 0; }
        let wx1:i32 = px + 10;
        if(wx1 > 95) { wx1 = 95; }
        while(wx <= wx1) {
            let o:i32 = 8 + (wy * 96 + wx) * 3;
            let lum:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
            let bright:i32 = 0;
            if(lum > 382) { bright = 1; }
            if(bright == fgbright) {
                let dx:i64 = (wx as i64) - cx;
                let dy:i64 = (wy as i64) - cy;
                let d2:i64 = dx * dx + dy * dy;
                if(d2 > maxd2) { maxd2 = d2; }
            }
            wvis = wvis + 1;
            wx = wx + 1;
        }
        wy = wy + 1;
    }
    op_add(op, wvis);
    gi = 0;
    while(gi < 3) {
        let fg:i64 = t_get64(fgs, gi * 8);
        let ng:i64 = t_get64(ngs, gi * 8);
        let a:i64 = 0;
        if(ng > 0) { a = fg * 9216 / ng; }
        let r:i64 = 0;
        if(maxd2 > 0) { r = a * 1000000 / (3142 * maxd2); }
        t_put64(out, gi * 8, r);
        t_put64(out, 24 + gi * 8, a);
        gi = gi + 1;
    }
    t_put64(out, 48, maxd2);
    t_put64(out, 56, cx);
    t_put64(out, 64, cy);
    nio_free(bcs);
    nio_free(ngs);
    nio_free(fgs);
    nio_free(sxs);
    nio_free(sys);
}
fn shape_class(r:i64) i64 {
    let d0:i64 = iabs(r - 974);
    let d1:i64 = iabs(r - 684);
    let d2:i64 = iabs(r - 464);
    if(d0 <= d1 && d0 <= d2) { return 0; }
    if(d1 <= d2) { return 1; }
    return 2;
}
fn shape_margin(r:i64, cls:i64) i64 {
    let d0:i64 = iabs(r - 974);
    let d1:i64 = iabs(r - 684);
    let d2:i64 = iabs(r - 464);
    if(cls == 0) {
        if(d1 < d2) { return d1 - d0; }
        return d2 - d0;
    }
    if(cls == 1) {
        if(d0 < d2) { return d0 - d1; }
        return d2 - d1;
    }
    if(d0 < d1) { return d0 - d2; }
    return d1 - d2;
}
fn shape_runner(r:i64, cls:i64) i64 {
    let d0:i64 = iabs(r - 974);
    let d1:i64 = iabs(r - 684);
    let d2:i64 = iabs(r - 464);
    if(cls == 0) {
        if(d1 <= d2) { return 1; }
        return 2;
    }
    if(cls == 1) {
        if(d0 <= d2) { return 0; }
        return 2;
    }
    if(d0 <= d1) { return 0; }
    return 1;
}
fn shape_name(c:i64) []u8 {
    if(c == 0) { return "CIRCLE"; }
    if(c == 1) { return "SQUARE"; }
    return "TRIANGLE";
}
fn task_shapetrans(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8) i32 {
    if(t_get32(buf, 0) != 96 || t_get32(buf, 4) != 96) { return -1; }
    if(8 + 96 * 96 * 3 > n as i64) { return -1; }
    let m:[]u8 = nio_alloc(72);
    shape_measure(buf, op, m);
    let rA:i64 = t_get64(m, 0);
    let rB:i64 = t_get64(m, 8);
    let rP:i64 = t_get64(m, 16);
    let aA:i64 = t_get64(m, 24);
    let aB:i64 = t_get64(m, 32);
    let aP:i64 = t_get64(m, 40);
    nio_free(m);
    op_add(op, 8);
    let ravg:i64 = (rA + rB) / 2;
    let hh:i64 = shape_class(ravg);
    let cA:i64 = shape_class(rA);
    let cB:i64 = shape_class(rB);
    let cP:i64 = shape_class(rP);
    let t1:i32 = 0;
    if(aA + aB >= 8 && aP >= 4) { t1 = 1; }
    let t2d:i32 = 0;
    if(cA == hh && cB == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(rA - rB) <= 120) { t2c = 1; }
    let mrg:i64 = shape_margin(ravg, hh);
    let t3:i32 = 0;
    if(mrg >= 60) { t3 = 1; }
    let p1:i32 = 0;
    if(cP == hh && iabs(rP - ravg) <= 120) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    let judge:i64 = hh;
    if(r == 1) { judge = shape_runner(ravg, hh); }
    pos = ob_kv(ob, pos, "judgment", shape_name(judge));
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 200));
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p1 as i64);
    pos = ob_kint(ob, pos, "measure", ravg);
    pos = ob_add(ob, pos, "program=H2/shapetrans|S1=shape:bbox=0,0,96,96");
    pos = ob_add(ob, pos, "|O1=grid((x+y)%12==0):ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(rA));
    pos = ob_add(ob, pos, ",area=");
    pos = ob_add(ob, pos, _zag_i64_to_str(aA));
    pos = ob_add(ob, pos, "|O2=grid((x+y)%12==6):ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(rB));
    pos = ob_add(ob, pos, ",area=");
    pos = ob_add(ob, pos, _zag_i64_to_str(aB));
    pos = ob_add(ob, pos, "|R=ratioavg=");
    pos = ob_add(ob, pos, _zag_i64_to_str(ravg));
    pos = ob_add(ob, pos, ",proto=c974/s684/t464|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=grid((x+y)%12==3):ratio=");
    pos = ob_add(ob, pos, _zag_i64_to_str(rP));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= motiondir =============================================
// Sparse-grid motion program. Grids: (x+y)%20 in {0 (O1), 10 (O2), 5
// (held-out PRED)}. Per grid: frame-diff centroid track over t=1..7,
// displacement from first to last moved-centroid. ~34% of Approach A.
fn dir_of(dx:i64, dy:i64) i64 {
    let ax:i64 = iabs(dx);
    let ay:i64 = iabs(dy);
    let mag2:i64 = dx * dx + dy * dy;
    if(mag2 < 9) { return 0; }
    if(ax > 2 * ay) {
        if(dx > 0) { return 3; }
        return 7;
    }
    if(ay > 2 * ax) {
        if(dy > 0) { return 5; }
        return 1;
    }
    if(dx > 0 && dy < 0) { return 2; }
    if(dx > 0 && dy > 0) { return 4; }
    if(dx < 0 && dy > 0) { return 6; }
    return 8;
}
fn dir_name(d:i64) []u8 {
    if(d == 0) { return "STILL"; }
    if(d == 1) { return "N"; }
    if(d == 2) { return "NE"; }
    if(d == 3) { return "E"; }
    if(d == 4) { return "SE"; }
    if(d == 5) { return "S"; }
    if(d == 6) { return "SW"; }
    if(d == 7) { return "W"; }
    return "NW";
}
// dout: dx@0, dy@8, dir@16, have@24, mag@32
// 1D projection profile motion: col profile (sum over sparse rows) gives
// dx via SSD shift; row profile (sum over sparse cols) gives dy.
// Frames f1->f2; row_step/row_off select the row subset for the col
// profile, col_step/col_off the col subset for the row profile.
fn profile_motion(buf:[]u8, row_step:i32, row_off:i32, col_step:i32, col_off:i32, f1:i32, f2:i32, op:[]u8, dout:[]u8) void {
    let fsz:i64 = 12288;
    let c0:[]u8 = nio_alloc(512);
    let c1:[]u8 = nio_alloc(512);
    let r0:[]u8 = nio_alloc(512);
    let r1:[]u8 = nio_alloc(512);
    let i:i32 = 0;
    while(i < 64) {
        t_put64(c0, i * 8, 0);
        t_put64(c1, i * 8, 0);
        t_put64(r0, i * 8, 0);
        t_put64(r1, i * 8, 0);
        i = i + 1;
    }
    // col profiles: for each x, sum intensity over sparse rows
    let f:i32 = 0;
    while(f < 2) {
        let fr:i32 = f1;
        if(f == 1) { fr = f2; }
        let cp:[]u8 = c0;
        let rp:[]u8 = r0;
        if(f == 1) { cp = c1; rp = r1; }
        let y:i32 = 0;
        while(y < 64) {
            if(y % row_step == row_off) {
                let x:i32 = 0;
                while(x < 64) {
                    let o:i32 = (12 + (fr as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let inten:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    t_put64(cp, x * 8, t_get64(cp, x * 8) + inten);
                    x = x + 1;
                    op_add(op, 1);
                }
            }
            y = y + 1;
        }
        // row profiles: for each y, sum intensity over sparse cols
        y = 0;
        while(y < 64) {
            let x:i32 = 0;
            while(x < 64) {
                if(x % col_step == col_off) {
                    let o:i32 = (12 + (fr as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let inten:i64 = (buf[o] as i64) + (buf[o + 1] as i64) + (buf[o + 2] as i64);
                    t_put64(rp, y * 8, t_get64(rp, y * 8) + inten);
                    op_add(op, 1);
                }
                x = x + 1;
            }
            y = y + 1;
        }
        f = f + 1;
    }
    // SSD shift for dx (col profiles)
    let best_dx:i64 = 0;
    let best_e:i64 = 9223372036854775807;
    let s:i32 = -8;
    while(s <= 8) {
        let e:i64 = 0;
        let x:i32 = 8;
        while(x < 56) {
            let x2:i32 = x + s;
            if(x2 >= 0 && x2 < 64) {
                let d:i64 = t_get64(c0, x * 8) - t_get64(c1, x2 * 8);
                e = e + d * d;
            }
            x = x + 1;
            op_add(op, 1);
        }
        if(e < best_e) { best_e = e; best_dx = s as i64; }
        s = s + 1;
    }
    // SSD shift for dy (row profiles)
    let best_dy:i64 = 0;
    best_e = 9223372036854775807;
    s = -8;
    while(s <= 8) {
        let e:i64 = 0;
        let y:i32 = 8;
        while(y < 56) {
            let y2:i32 = y + s;
            if(y2 >= 0 && y2 < 64) {
                let d:i64 = t_get64(r0, y * 8) - t_get64(r1, y2 * 8);
                e = e + d * d;
            }
            y = y + 1;
            op_add(op, 1);
        }
        if(e < best_e) { best_e = e; best_dy = s as i64; }
        s = s + 1;
    }
    nio_free(c0);
    nio_free(c1);
    nio_free(r0);
    nio_free(r1);
    t_put64(dout, 0, best_dx);
    t_put64(dout, 8, best_dy);
    t_put64(dout, 16, dir_of(best_dx, best_dy));
    t_put64(dout, 24, 1);
    t_put64(dout, 32, isqrt(best_dx * best_dx + best_dy * best_dy));
}

fn grid_motion(buf:[]u8, modv:i32, rem:i32, op:[]u8, dout:[]u8) void {
    let fsz:i64 = 12288;
    let fx:i64 = 0;
    let fy:i64 = 0;
    let lx:i64 = 0;
    let ly:i64 = 0;
    let have:i32 = 0;
    let visits:i64 = 0;
    let t:i32 = 1;
    while(t < 8) {
        let sx:i64 = 0;
        let sy:i64 = 0;
        let mc:i64 = 0;
        let y:i32 = 0;
        while(y < 64) {
            let x:i32 = 0;
            while(x < 64) {
                if((x + y) % modv == rem) {
                    let o0:i32 = (12 + ((t - 1) as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let o1:i32 = (12 + (t as i64) * fsz + ((y * 64 + x) as i64) * 3) as i32;
                    let dd:i64 = iabs((buf[o1] as i64) - (buf[o0] as i64))
                               + iabs((buf[o1 + 1] as i64) - (buf[o0 + 1] as i64))
                               + iabs((buf[o1 + 2] as i64) - (buf[o0 + 2] as i64));
                    if(dd > 90) {
                        mc = mc + 1;
                        sx = sx + (x as i64);
                        sy = sy + (y as i64);
                    }
                    visits = visits + 1;
                }
                x = x + 1;
            }
            y = y + 1;
        }
        if(mc > 0) {
            let cx:i64 = sx / mc;
            let cy:i64 = sy / mc;
            if(have == 0) { fx = cx; fy = cy; have = 1; }
            lx = cx;
            ly = cy;
        }
        t = t + 1;
    }
    op_add(op, visits);
    let dx:i64 = lx - fx;
    let dy:i64 = ly - fy;
    t_put64(dout, 0, dx);
    t_put64(dout, 8, dy);
    t_put64(dout, 16, dir_of(dx, dy));
    t_put64(dout, 24, have as i64);
    t_put64(dout, 32, isqrt(dx * dx + dy * dy));
}
fn task_motiondir(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8) i32 {
    if(t_get32(buf, 0) != 8 || t_get32(buf, 4) != 64 || t_get32(buf, 8) != 64) { return -1; }
    if(12 + 8 * 12288 > n as i64) { return -1; }
    let da:[]u8 = nio_alloc(40);
    let db:[]u8 = nio_alloc(40);
    let dp:[]u8 = nio_alloc(40);
    // O1/O2/P: disjoint row/col subsets (offsets 0/4/2 mod 8), frames 0->3.
    profile_motion(buf, 8, 0, 8, 0, 0, 3, op, da);
    profile_motion(buf, 8, 4, 8, 4, 0, 3, op, db);
    profile_motion(buf, 8, 2, 8, 2, 0, 3, op, dp);
    let dxA:i64 = t_get64(da, 0);
    let dyA:i64 = t_get64(da, 8);
    let dA:i64 = t_get64(da, 16);
    let hA:i64 = t_get64(da, 24);
    let dxB:i64 = t_get64(db, 0);
    let dyB:i64 = t_get64(db, 8);
    let dB:i64 = t_get64(db, 16);
    let hB:i64 = t_get64(db, 24);
    let dxP:i64 = t_get64(dp, 0);
    let dyP:i64 = t_get64(dp, 8);
    let dP:i64 = t_get64(dp, 16);
    nio_free(da);
    nio_free(db);
    nio_free(dp);
    op_add(op, 8);
    let dxc:i64 = (dxA + dxB) / 2;
    let dyc:i64 = (dyA + dyB) / 2;
    let mag:i64 = isqrt(dxc * dxc + dyc * dyc);
    let hh:i64 = dir_of(dxc, dyc);
    let t1:i32 = 0;
    if((hA == 1 && hB == 1) || hh == 0) { t1 = 1; }
    let t2d:i32 = 0;
    if(dA == hh && dB == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(dxA - dxB) <= 4 && iabs(dyA - dyB) <= 4) { t2c = 1; }
    let mrg:i64 = iabs(mag - 3);
    let t3:i32 = 0;
    if(mrg >= 2) { t3 = 1; }
    let p1:i32 = 0;
    if(dP == hh && iabs(dxP - dxc) <= 4 && iabs(dyP - dyc) <= 4) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    let judge:i64 = hh;
    if(r == 1) {
        judge = 0;
        if(dA != hh) { judge = dA; }
        else {
            if(dB != hh) { judge = dB; }
        }
    }
    pos = ob_kv(ob, pos, "judgment", dir_name(judge));
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 4));
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p1 as i64);
    pos = ob_kint(ob, pos, "measure", hh);
    pos = ob_add(ob, pos, "program=H2/motiondir|S1=prof1d:f0->f3");
    pos = ob_add(ob, pos, "|O1=prof1d(rows%8==0):dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dxA));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dyA));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, dir_name(dA));
    pos = ob_add(ob, pos, "|O2=prof1d(rows%8==4):dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dxB));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dyB));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, dir_name(dB));
    pos = ob_add(ob, pos, "|R=dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dxc));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dyc));
    pos = ob_add(ob, pos, ",mag=");
    pos = ob_add(ob, pos, _zag_i64_to_str(mag));
    pos = ob_add(ob, pos, "|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=prof1d(rows%8==2):dx=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dxP));
    pos = ob_add(ob, pos, ",dy=");
    pos = ob_add(ob, pos, _zag_i64_to_str(dyP));
    pos = ob_add(ob, pos, ",dir=");
    pos = ob_add(ob, pos, dir_name(dP));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= pitchdisc =============================================
// Sparse pitch program: combined f0 per tone via f0_h2 (autocorr + narrow
// harmonic grid), then per-tone check-windows at +800/+3000 (O1,O2) and
// +5000 (held-out PRED): the tone's own f0 must explain its window better
// than the other tone's f0 (>=10%). ~34% of Approach A.
fn pitch_runner(d:i64, fA:i64, fB:i64, hh:i64) i64 {
    let s_same:i64 = 5000 - d;
    let s_hi:i64 = -999999999;
    let s_lo:i64 = -999999999;
    if(fB > fA) { s_hi = d - 5000; }
    if(fB < fA) { s_lo = d - 5000; }
    let best:i64 = 0;
    let bs:i64 = -9999999999;
    if(hh != 0 && s_same > bs) { best = 0; bs = s_same; }
    if(hh != 1 && s_hi > bs) { best = 1; bs = s_hi; }
    if(hh != 2 && s_lo > bs) { best = 2; bs = s_lo; }
    return best;
}
fn pitch_name(c:i64) []u8 {
    if(c == 0) { return "SAME"; }
    if(c == 1) { return "HIGHER"; }
    return "LOWER";
}
// one window check: tone's own f0 vs the other tone's f0. Returns 1 if the
// evidence favors H.
fn pitch_win(buf:[]u8, woff:i32, sr:i64, fT:i64, fO:i64, hh:i64, op:[]u8) i32 {
    let e_own:i64 = harm_energy(buf, woff, 768, sr, fT, 6, op);
    let e_oth:i64 = harm_energy(buf, woff, 768, sr, fO, 6, op);
    if(hh != 0) {
        if(e_own * 10 > e_oth * 11) { return 1; }
        return 0;
    }
    if(iabs(e_own - e_oth) * 10 <= e_own) { return 1; }
    return 0;
}
fn task_pitchdisc(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8) i32 {
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let tone:i32 = (cnt * 10 / 22) as i32;
    let gap:i32 = cnt - 2 * tone;
    if(tone < 6024 || gap < 0) { return -1; }
    let aoff:i32 = 8;
    let boff:i32 = 8 + (tone + gap) * 2;
    let fA:i64 = f0_h2(buf, aoff, tone, sr, op);
    let fB:i64 = f0_h2(buf, boff, tone, sr, op);
    let t1:i32 = 0;
    if(fA > 0 && fB > 0) { t1 = 1; }
    let d:i64 = 0;
    if(t1 == 1) {
        let mx:i64 = fA;
        if(fB > mx) { mx = fB; }
        d = iabs(fB - fA) * 1000000 / mx;
    }
    let hh:i64 = 0;
    if(t1 == 1 && d >= 5000) {
        if(fB > fA) { hh = 1; } else { hh = 2; }
    }
    // check windows (byte offsets)
    let aw1:i32 = aoff + 800 * 2;
    let aw2:i32 = aoff + 3000 * 2;
    let aw3:i32 = aoff + 5000 * 2;
    let bw1:i32 = boff + 800 * 2;
    let bw2:i32 = boff + 3000 * 2;
    let bw3:i32 = boff + 5000 * 2;
    let t2d:i32 = 0;
    if(t1 == 1) {
        let c:i32 = pitch_win(buf, aw1, sr, fA, fB, hh, op);
        c = c + pitch_win(buf, aw2, sr, fA, fB, hh, op);
        c = c + pitch_win(buf, bw1, sr, fB, fA, hh, op);
        c = c + pitch_win(buf, bw2, sr, fB, fA, hh, op);
        if(c == 4) { t2d = 1; }
    }
    let t2c:i32 = 1;
    let mrg:i64 = iabs(d - 5000);
    let t3:i32 = 0;
    if(mrg >= 1500) { t3 = 1; }
    let p1:i32 = 0;
    if(t1 == 1) {
        let c:i32 = pitch_win(buf, aw3, sr, fA, fB, hh, op);
        c = c + pitch_win(buf, bw3, sr, fB, fA, hh, op);
        if(c == 2) { p1 = 1; }
    }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    let judge:i64 = hh;
    if(r == 1) { judge = pitch_runner(d, fA, fB, hh); }
    pos = ob_kv(ob, pos, "judgment", pitch_name(judge));
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 3000));
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p1 as i64);
    pos = ob_kint(ob, pos, "measure", d);
    pos = ob_add(ob, pos, "program=H2/pitchdisc|S1=toneA|S2=toneB");
    pos = ob_add(ob, pos, "|O1=w+800:fA=");
    pos = ob_add(ob, pos, _zag_i64_to_str(fA));
    pos = ob_add(ob, pos, ",fB=");
    pos = ob_add(ob, pos, _zag_i64_to_str(fB));
    pos = ob_add(ob, pos, "|O2=w+3000:fA=");
    pos = ob_add(ob, pos, _zag_i64_to_str(fA));
    pos = ob_add(ob, pos, ",fB=");
    pos = ob_add(ob, pos, _zag_i64_to_str(fB));
    pos = ob_add(ob, pos, "|R=dppm=");
    pos = ob_add(ob, pos, _zag_i64_to_str(d));
    pos = ob_add(ob, pos, ",thr=5000|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=w+5000:agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= timbredisc ============================================
// Sparse timbre program: f0 via f0_h2, spectral centroid (8 harmonics,
// short windows) at w=2048 (combined), w=1024 thirds 1,2 (O1,O2),
// third 3 (held-out PRED). Classes PURE/DARK/RICH/BRIGHT at 1075/1400/3000.
// Harmonic spectral centroid, per-mille: r = 1000 * sum(h * E_h) / sum(E_h)
// over the harmonics below Nyquist. Same scale and boundaries as Approach A
// (PURE<1075, DARK<1400, RICH<3000, BRIGHT). All measurements come from the
// sparse windows only (O1/O2 thirds + combined + held-out third).
fn spec_centroid_h2(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, op:[]u8) i64 {
    if(f0m <= 0) { return -1; }
    let se:i64 = 0;
    let she:i64 = 0;
    let h:i64 = 1;
    while(h <= 8) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let e:i64 = harm_energy(buf, off, w, sr, h * f0m, 1, op);
        se = se + e;
        she = she + e * h;
        h = h + 1;
    }
    if(se <= 0) { return -1; }
    return 1000 * she / se;
}
fn timbre_class(r:i64) i64 {
    if(r < 1075) { return 0; }
    if(r < 1400) { return 1; }
    if(r < 3000) { return 2; }
    return 3;
}
fn timbre_margin(r:i64, cls:i64) i64 {
    if(cls == 0) { return 1075 - r; }
    if(cls == 1) {
        let a:i64 = r - 1075;
        let b:i64 = 1400 - r;
        if(a < b) { return a; }
        return b;
    }
    if(cls == 2) {
        let a:i64 = r - 1400;
        let b:i64 = 3000 - r;
        if(a < b) { return a; }
        return b;
    }
    return r - 3000;
}
fn timbre_runner(r:i64, cls:i64) i64 {
    let d0:i64 = 0;
    if(r >= 1075) { d0 = r - 1075; }
    let d1a:i64 = iabs(r - 1075);
    let d1b:i64 = iabs(r - 1400);
    let d1:i64 = d1a;
    if(d1b < d1a) { d1 = d1b; }
    let d2a:i64 = iabs(r - 1400);
    let d2b:i64 = iabs(r - 3000);
    let d2:i64 = d2a;
    if(d2b < d2a) { d2 = d2b; }
    let d3:i64 = 0;
    if(r <= 3000) { d3 = 3000 - r; }
    let best:i64 = 0;
    let bd:i64 = 9999999999;
    if(cls != 0 && d0 < bd) { best = 0; bd = d0; }
    if(cls != 1 && d1 < bd) { best = 1; bd = d1; }
    if(cls != 2 && d2 < bd) { best = 2; bd = d2; }
    if(cls != 3 && d3 < bd) { best = 3; bd = d3; }
    return best;
}
fn timbre_name(c:i64) []u8 {
    if(c == 0) { return "PURE"; }
    if(c == 1) { return "DARK"; }
    if(c == 2) { return "RICH"; }
    return "BRIGHT";
}
fn task_timbredisc(buf:[]u8, n:i32, ob:[]u8, pos:i32, op:[]u8) i32 {
    let sr:i64 = t_get32(buf, 0);
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1) { return -1; }
    if(8 + (cnt as i64) * 2 > n as i64) { return -1; }
    let f0:i64 = f0_h2(buf, 8, cnt, sr, op);
    let t1:i32 = 0;
    if(f0 >= 50000 && f0 <= 2000000) { t1 = 1; }
    let r12:i64 = spec_centroid_h2(buf, 8, 2048, sr, f0, op);
    let r1:i64 = spec_centroid_h2(buf, 8, 1024, sr, f0, op);
    let r2:i64 = spec_centroid_h2(buf, 8 + (cnt / 3) * 2, 1024, sr, f0, op);
    let r3:i64 = spec_centroid_h2(buf, 8 + (2 * cnt / 3) * 2, 1024, sr, f0, op);
    if(r12 < 0 || r1 < 0 || r2 < 0 || r3 < 0) { t1 = 0; }
    let hh:i64 = 0;
    if(t1 == 1) { hh = timbre_class(r12); }
    let t2d:i32 = 0;
    if(t1 == 1 && timbre_class(r1) == hh && timbre_class(r2) == hh) { t2d = 1; }
    let t2c:i32 = 0;
    if(iabs(r1 - r2) <= 150) { t2c = 1; }
    let mrg:i64 = 0;
    if(t1 == 1) { mrg = timbre_margin(r12, hh); }
    let t3:i32 = 0;
    if(mrg >= 80) { t3 = 1; }
    let p1:i32 = 0;
    if(t1 == 1 && timbre_class(r3) == hh && iabs(r3 - r12) <= 150) { p1 = 1; }
    let t2:i32 = 0;
    if(t2d == 1 && t2c == 1) { t2 = 1; }
    let r:i32 = resolve(t1, t2d, t2c, t3, p1);
    let judge:i64 = hh;
    if(r == 1) { judge = timbre_runner(r12, hh); }
    pos = ob_kv(ob, pos, "judgment", timbre_name(judge));
    pos = ob_kint(ob, pos, "confidence", conf_of(mrg, 150));
    pos = ob_kv(ob, pos, "prog", res_str(r));
    pos = ob_kint(ob, pos, "pred", p1 as i64);
    pos = ob_kint(ob, pos, "measure", r12);
    pos = ob_add(ob, pos, "program=H2/timbredisc|S1=tone:f0=");
    pos = ob_add(ob, pos, _zag_i64_to_str(f0));
    pos = ob_add(ob, pos, "|O1=third1:cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r1));
    pos = ob_add(ob, pos, "|O2=third2:cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r2));
    pos = ob_add(ob, pos, "|R=cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r12));
    pos = ob_add(ob, pos, ",bounds=1075/1400/3000|T1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t1 as i64));
    pos = ob_add(ob, pos, ",T2=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t2 as i64));
    pos = ob_add(ob, pos, ",T3=");
    pos = ob_add(ob, pos, _zag_i64_to_str(t3 as i64));
    pos = ob_add(ob, pos, ",P1=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|PRED=third3:cent=");
    pos = ob_add(ob, pos, _zag_i64_to_str(r3));
    pos = ob_add(ob, pos, ",agree=");
    pos = ob_add(ob, pos, _zag_i64_to_str(p1 as i64));
    pos = ob_add(ob, pos, "|result=");
    pos = ob_add(ob, pos, res_str(r));
    pos = ob_add(ob, pos, "\n");
    return pos;
}

// ================= main ====================================================
fn main() i32 {
    // argc is always 0 in this runtime; read _zag_arg directly.
    let task:[]u8 = _zag_arg(1);
    let path:[]u8 = _zag_arg(2);
    if(task.len == 0) { return fail("?", "usage: sense_h2 <task> <fixture>"); }
    let buf:[]u8 = nio_alloc(8388608);
    if(buf.len == 0) { return fail(task, "no-memory"); }
    let n:i64 = z_read(path, buf, 8388608);
    if(n < 0) { nio_free(buf); return fail(task, "bad-read"); }
    let op:[]u8 = nio_alloc(8);
    t_put64(op, 0, 0);
    let lut:[]u8 = nio_alloc(2048);
    lut_init(lut);
    let ob:[]u8 = nio_alloc(4096);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "H2");
    pos = ob_kv(ob, pos, "task", task);
    let rc:i32 = -1;
    if(_zag_strcmp(task, "colordisc") == 1) { rc = task_colordisc(buf, n as i32, ob, pos, op, lut); }
    if(_zag_strcmp(task, "colorconst") == 1) { rc = task_colorconst(buf, n as i32, ob, pos, op, lut); }
    if(_zag_strcmp(task, "shapetrans") == 1) { rc = task_shapetrans(buf, n as i32, ob, pos, op); }
    if(_zag_strcmp(task, "pitchdisc") == 1) { rc = task_pitchdisc(buf, n as i32, ob, pos, op); }
    if(_zag_strcmp(task, "timbredisc") == 1) { rc = task_timbredisc(buf, n as i32, ob, pos, op); }
    if(_zag_strcmp(task, "motiondir") == 1) { rc = task_motiondir(buf, n as i32, ob, pos, op); }
    nio_free(buf);
    nio_free(lut);
    if(rc < 0) {
        nio_free(op);
        nio_free(ob);
        return fail(task, "bad-size");
    }
    pos = rc;
    let ops:i64 = t_get64(op, 0);
    nio_free(op);
    pos = ob_kint(ob, pos, "ops", ops);
    pos = ob_kint(ob, pos, "cost", ops);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 0;
}

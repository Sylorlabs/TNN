// sense_h3.zag — PAM fork H3: Counterfactual Predictive State.
// Pure Zag, zero RNG, integer math only. Deterministic.
// Per PREREG_H3.md (frozen 2026-09-22, commit 4d39e5c).
//
// CLI:
//   sense_h3 <task> <fixture> [prev_hash_hex]   single episode
//   sense_h3 stream <task> <listfile>           streaming eval (memory+ledger in-process)
// stdout: approach=H3, task=, fixture=, judgment=, disposition=, confidence=,
//         ops=, transition= (canonical), chain= (new ledger hash hex).

@import("R33_NATIVE_SHA256_V2.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put16(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
}
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get16(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8);
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn t_geti16(b:[]u8, at:i32) i64 {
    let v:i64 = t_get16(b, at);
    if(v >= 32768) { return v - 65536; }
    return v;
}

// ---------------- ops counter (8-byte arena) ----------------
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}

// ---------------- integer math ----------------
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}

// ---------------- file IO ----------------
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}

// ---------------- stdout builders ----------------
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
// hex encode 32 bytes -> 64 chars (uses ns_hex_digit via ns_hex)
fn ob_hex32(ob:[]u8, pos:i32, h:[]u8) i32 {
    let hx:[]u8 = ns_hex(h);
    pos = ob_add(ob, pos, hx);
    return pos;
}
fn hfail(task:[]u8, reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "H3");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "error", reason);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}
// FNV-1a 64-bit hash of a byte slice (fixture identity for disjoint episodes)
fn fnv1a(s:[]u8) i64 {
    let h:i64 = -3750763034362895579;
    let i:i32 = 0;
    while(i < s.len) {
        h = h ^ (s[i] as i64);
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}
// parse 64-char hex into 32 bytes; returns 1 on success
fn hex_parse(hx:[]u8, out:[]u8) i32 {
    if(hx.len != 64 || out.len < 32) { return 0; }
    let i:i32 = 0;
    while(i < 32) {
        let w:i64 = ns_hex_word(hx, i * 2);
        if(w < 0) { return 0; }
        out[i] = (w & 255) as u8;
        i = i + 1;
    }
    return 1;
}

// ================= TASK 1: colordisc (H3) =================================
// T0: A's mean-RGB Euclidean, threshold 40. Predictions P1..P4 per PREREG §4.

// dist between half-means over rows [y0,y1) step st. Returns -1 on bad input.
fn t1_dist_rows(buf:[]u8, w:i32, h:i32, y0:i32, y1:i32, st:i32, op:[]u8) i64 {
    let hw:i32 = w / 2;
    let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
    let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
    let n:i64 = 0;
    let y:i32 = y0;
    while(y < y1) {
        let x:i32 = 0;
        while(x < hw) {
            let o1:i32 = 8 + (y * w + x) * 3;
            s1r = s1r + (buf[o1] as i64);
            s1g = s1g + (buf[o1+1] as i64);
            s1b = s1b + (buf[o1+2] as i64);
            let o2:i32 = 8 + (y * w + hw + x) * 3;
            s2r = s2r + (buf[o2] as i64);
            s2g = s2g + (buf[o2+1] as i64);
            s2b = s2b + (buf[o2+2] as i64);
            x = x + 1;
            n = n + 1;
        }
        y = y + st;
    }
    if(n <= 0) { return -1; }
    op_add(op, 2 * n);
    let dr:i64 = s1r / n - s2r / n;
    let dg:i64 = s1g / n - s2g / n;
    let db:i64 = s1b / n - s2b / n;
    op_add(op, 1);
    return isqrt(dr*dr + dg*dg + db*db);
}
// uniformity of one half: dist(top-half mean, bottom-half mean). half 0=L,1=R.
fn t1_unif(buf:[]u8, w:i32, h:i32, half:i32, op:[]u8) i64 {
    let hw:i32 = w / 2;
    let x0:i32 = 0;
    if(half == 1) { x0 = hw; }
    let a1r:i64 = 0; let a1g:i64 = 0; let a1b:i64 = 0;
    let a2r:i64 = 0; let a2g:i64 = 0; let a2b:i64 = 0;
    let n:i64 = 0;
    let y:i32 = 0;
    while(y < h / 2) {
        let x:i32 = 0;
        while(x < hw) {
            let o:i32 = 8 + (y * w + x0 + x) * 3;
            a1r = a1r + (buf[o] as i64);
            a1g = a1g + (buf[o+1] as i64);
            a1b = a1b + (buf[o+2] as i64);
            x = x + 1;
            n = n + 1;
        }
        y = y + 1;
    }
    y = h / 2;
    while(y < h) {
        let x:i32 = 0;
        while(x < hw) {
            let o:i32 = 8 + (y * w + x0 + x) * 3;
            a2r = a2r + (buf[o] as i64);
            a2g = a2g + (buf[o+1] as i64);
            a2b = a2b + (buf[o+2] as i64);
            x = x + 1;
        }
        y = y + 1;
    }
    if(n <= 0) { return -1; }
    op_add(op, 2 * n);
    let dr:i64 = a1r / n - a2r / n;
    let dg:i64 = a1g / n - a2g / n;
    let db:i64 = a1b / n - a2b / n;
    op_add(op, 1);
    return isqrt(dr*dr + dg*dg + db*db);
}
fn t1_name(c:i32) []u8 {
    if(c == 1) { return "DIFFERENT"; }
    return "SAME";
}
// Branch evaluation for t1. Writes confirms/brokens for branches 0..1 into
// bb (2x i64 pairs). Returns t0 claim.
fn h3_t1(buf:[]u8, n:i64, op:[]u8, bb:[]u8) i32 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 2 || h < 2 || (w % 2) == 1) { return -1; }
    if(w > 4096 || h > 4096) { return -1; }
    if(8 + (w as i64) * (h as i64) * 3 > n) { return -1; }
    let df:i64 = t1_dist_rows(buf, w, h, 0, h, 1, op);
    let de:i64 = t1_dist_rows(buf, w, h, 0, h, 2, op);
    let do:i64 = t1_dist_rows(buf, w, h, 1, h, 2, op);
    let ul:i64 = t1_unif(buf, w, h, 0, op);
    let ur:i64 = t1_unif(buf, w, h, 1, op);
    if(df < 0 || de < 0 || do < 0 || ul < 0 || ur < 0) { return -1; }
    let t0:i32 = 0;
    if(df > 40) { t0 = 1; }
    // store measurements for the emitter: bb layout [df,de,do,ul,ur,t0]
    t_put64(bb, 0, df); t_put64(bb, 8, de); t_put64(bb, 16, do);
    t_put64(bb, 24, ul); t_put64(bb, 32, ur); t_put64(bb, 40, t0 as i64);
    let c:i32 = 0;
    while(c < 2) {
        let cf:i64 = 0; let br:i64 = 0;
        // P1, P2: uniformity (claim-independent)
        if(ul <= 20) { cf = cf + 1; } else { br = br + 1; }
        if(ur <= 20) { cf = cf + 1; } else { br = br + 1; }
        // P3: subsample judgments agree with branch claim
        let je:i32 = 0; if(de > 40) { je = 1; }
        let jo:i32 = 0; if(do > 40) { jo = 1; }
        let jf:i32 = 0; if(df > 40) { jf = 1; }
        if(je == c && jo == c && jf == c) { cf = cf + 1; } else { br = br + 1; }
        // P4: margin on the claim's side
        let mg:i64 = iabs(df - 40);
        if(mg >= 25 && jf == c) { cf = cf + 1; } else { br = br + 1; }
        t_put64(bb, 48 + c * 16, cf);
        t_put64(bb, 56 + c * 16, br);
        c = c + 1;
    }
    return t0;
}

// ================= TASK 2: colorconst (H3) ================================
// T0: A's von Kries discounted-mean distance, threshold 150.

// dist over rows [y0,y1) step st. Returns -1 on bad input.
fn t2_dist_rows(buf:[]u8, w:i32, h:i32, y0:i32, y1:i32, st:i32, op:[]u8) i64 {
    let hw:i32 = w / 2;
    let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
    let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
    let x1r:i64 = 0; let x1g:i64 = 0; let x1b:i64 = 0;
    let x2r:i64 = 0; let x2g:i64 = 0; let x2b:i64 = 0;
    let n:i64 = 0;
    let y:i32 = y0;
    while(y < y1) {
        let x:i32 = 0;
        while(x < hw) {
            let o1:i32 = 8 + (y * w + x) * 3;
            let r1:i64 = buf[o1] as i64;
            let g1:i64 = buf[o1+1] as i64;
            let b1:i64 = buf[o1+2] as i64;
            s1r = s1r + r1; s1g = s1g + g1; s1b = s1b + b1;
            x1r = imax(x1r, r1); x1g = imax(x1g, g1); x1b = imax(x1b, b1);
            let o2:i32 = 8 + (y * w + hw + x) * 3;
            let r2:i64 = buf[o2] as i64;
            let g2:i64 = buf[o2+1] as i64;
            let b2:i64 = buf[o2+2] as i64;
            s2r = s2r + r2; s2g = s2g + g2; s2b = s2b + b2;
            x2r = imax(x2r, r2); x2g = imax(x2g, g2); x2b = imax(x2b, b2);
            x = x + 1;
            n = n + 1;
        }
        y = y + st;
    }
    if(n <= 0) { return -1; }
    op_add(op, 2 * n);
    let n1r:i64 = 0; let n1g:i64 = 0; let n1b:i64 = 0;
    let n2r:i64 = 0; let n2g:i64 = 0; let n2b:i64 = 0;
    if(x1r > 0) { n1r = s1r * 1000 / (n * x1r); }
    if(x1g > 0) { n1g = s1g * 1000 / (n * x1g); }
    if(x1b > 0) { n1b = s1b * 1000 / (n * x1b); }
    if(x2r > 0) { n2r = s2r * 1000 / (n * x2r); }
    if(x2g > 0) { n2g = s2g * 1000 / (n * x2g); }
    if(x2b > 0) { n2b = s2b * 1000 / (n * x2b); }
    let dr:i64 = n1r - n2r; let dg:i64 = n1g - n2g; let db:i64 = n1b - n2b;
    op_add(op, 1);
    return isqrt(dr*dr + dg*dg + db*db);
}
fn t2_name(c:i32) []u8 {
    if(c == 1) { return "DIFFERENT"; }
    return "SAME_SURFACE";
}
// brightest 8x8 block by summed (r+g+b). Returns by*4096+bx, or -1.
fn t2_brightest88(buf:[]u8, w:i32, h:i32, op:[]u8) i64 {
    if(w < 8 || h < 8) { return -1; }
    let best:i64 = -1;
    let bbx:i32 = 0; let bby:i32 = 0;
    let by:i32 = 0;
    while(by <= h - 8) {
        let bx:i32 = 0;
        while(bx <= w - 8) {
            let s:i64 = 0;
            let dy:i32 = 0;
            while(dy < 8) {
                let dx:i32 = 0;
                while(dx < 8) {
                    let o:i32 = 8 + ((by+dy)*w + (bx+dx))*3;
                    s = s + (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
                    dx = dx + 1;
                }
                dy = dy + 1;
            }
            if(s > best) { best = s; bbx = bx; bby = by; }
            bx = bx + 1;
        }
        by = by + 1;
    }
    op_add(op, ((w - 7) as i64) * ((h - 7) as i64) * 64);
    return (bby as i64) * 4096 + (bbx as i64);
}
// von Kries discounted half-mean distance, skipping the 8x8 block at (bx,by)
// (global coords). PREREG §4 P3 (Δ-spot).
fn t2_df_masked(buf:[]u8, w:i32, h:i32, bx:i32, by:i32, op:[]u8) i64 {
    let hw:i32 = w / 2;
    let s1r:i64 = 0; let s1g:i64 = 0; let s1b:i64 = 0;
    let s2r:i64 = 0; let s2g:i64 = 0; let s2b:i64 = 0;
    let x1r:i64 = 0; let x1g:i64 = 0; let x1b:i64 = 0;
    let x2r:i64 = 0; let x2g:i64 = 0; let x2b:i64 = 0;
    let n1:i64 = 0; let n2:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < hw) {
            let gx1:i32 = x;
            if(gx1 < bx || gx1 >= bx + 8 || y < by || y >= by + 8) {
                let o1:i32 = 8 + (y * w + x) * 3;
                let r1:i64 = buf[o1] as i64;
                let g1:i64 = buf[o1+1] as i64;
                let b1:i64 = buf[o1+2] as i64;
                s1r = s1r + r1; s1g = s1g + g1; s1b = s1b + b1;
                x1r = imax(x1r, r1); x1g = imax(x1g, g1); x1b = imax(x1b, b1);
                n1 = n1 + 1;
            }
            let gx2:i32 = hw + x;
            if(gx2 < bx || gx2 >= bx + 8 || y < by || y >= by + 8) {
                let o2:i32 = 8 + (y * w + hw + x) * 3;
                let r2:i64 = buf[o2] as i64;
                let g2:i64 = buf[o2+1] as i64;
                let b2:i64 = buf[o2+2] as i64;
                s2r = s2r + r2; s2g = s2g + g2; s2b = s2b + b2;
                x2r = imax(x2r, r2); x2g = imax(x2g, g2); x2b = imax(x2b, b2);
                n2 = n2 + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if(n1 <= 0 || n2 <= 0) { return -1; }
    op_add(op, n1 + n2);
    let n1r:i64 = 0; let n1g:i64 = 0; let n1b:i64 = 0;
    let n2r:i64 = 0; let n2g:i64 = 0; let n2b:i64 = 0;
    if(x1r > 0) { n1r = s1r * 1000 / (n1 * x1r); }
    if(x1g > 0) { n1g = s1g * 1000 / (n1 * x1g); }
    if(x1b > 0) { n1b = s1b * 1000 / (n1 * x1b); }
    if(x2r > 0) { n2r = s2r * 1000 / (n2 * x2r); }
    if(x2g > 0) { n2g = s2g * 1000 / (n2 * x2g); }
    if(x2b > 0) { n2b = s2b * 1000 / (n2 * x2b); }
    let dr:i64 = n1r - n2r; let dg:i64 = n1g - n2g; let db:i64 = n1b - n2b;
    op_add(op, 1);
    return isqrt(dr*dr + dg*dg + db*db);
}
// bb layout: [df,de,do,dt,db2,t0, cf0,br0, cf1,br1]
fn h3_t2(buf:[]u8, n:i64, op:[]u8, bb:[]u8) i32 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 2 || h < 2 || (w % 2) == 1) { return -1; }
    if(w > 4096 || h > 4096) { return -1; }
    if(8 + (w as i64) * (h as i64) * 3 > n) { return -1; }
    let df:i64 = t2_dist_rows(buf, w, h, 0, h, 1, op);
    let de:i64 = t2_dist_rows(buf, w, h, 0, h, 2, op);
    let do:i64 = t2_dist_rows(buf, w, h, 1, h, 2, op);
    let dt:i64 = t2_dist_rows(buf, w, h, 0, h / 2, 1, op);
    let db:i64 = t2_dist_rows(buf, w, h, h / 2, h, 1, op);
    if(df < 0 || de < 0 || do < 0 || dt < 0 || db < 0) { return -1; }
    let t0:i32 = 0;
    if(df > 150) { t0 = 1; }
    t_put64(bb, 0, df); t_put64(bb, 8, de); t_put64(bb, 16, do);
    t_put64(bb, 24, dt); t_put64(bb, 32, db); t_put64(bb, 40, t0 as i64);
    // P3 (Δ-spot): |df - df_spotremoved| <= 15, brightest 8x8 masked out.
    let dsp:i64 = -1;
    let bp:i64 = t2_brightest88(buf, w, h, op);
    if(bp >= 0) {
        let dfm:i64 = t2_df_masked(buf, w, h, (bp % 4096) as i32, (bp / 4096) as i32, op);
        if(dfm >= 0) { dsp = iabs(df - dfm); }
    }
    t_put64(bb, 80, dsp);
    let c:i32 = 0;
    while(c < 2) {
        let cf:i64 = 0; let br:i64 = 0;
        let je:i32 = 0; if(de > 150) { je = 1; }
        let jo:i32 = 0; if(do > 150) { jo = 1; }
        let jt:i32 = 0; if(dt > 150) { jt = 1; }
        let jb:i32 = 0; if(db > 150) { jb = 1; }
        let jf:i32 = 0; if(df > 150) { jf = 1; }
        // P1: even/odd agree with branch claim
        if(je == c && jo == c) { cf = cf + 1; } else { br = br + 1; }
        // P2: top/bottom agree with branch claim
        if(jt == c && jb == c) { cf = cf + 1; } else { br = br + 1; }
        // P3: Δ-spot (claim-independent)
        if(dsp >= 0 && dsp <= 15) { cf = cf + 1; } else { br = br + 1; }
        // P4: margin on the claim's side
        let mg:i64 = iabs(df - 150);
        if(mg >= 60 && jf == c) { cf = cf + 1; } else { br = br + 1; }
        t_put64(bb, 48 + c * 16, cf);
        t_put64(bb, 56 + c * 16, br);
        c = c + 1;
    }
    return t0;
}

// ================= TASK 3: shapetrans (H3) ================================
// T0: A's ratio nearest-prototype at threshold 382.
// Predictions: mask at 350/382/414 must preserve class; 90-degree centroid
// rotation must preserve class (sym thresholds per class).

// Build fg mask at threshold thr. m must hold w*h bytes. Returns fg area.
fn t3_mask(buf:[]u8, w:i32, h:i32, thr:i64, m:[]u8, op:[]u8) i64 {
    let npx:i64 = (w as i64) * (h as i64);
    if(npx > 1048576) { return -1; }
    let nb:i64 = 0;
    let i:i32 = 0;
    while(i < npx as i32) {
        let o:i32 = 8 + i * 3;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        if(lum > thr) { nb = nb + 1; }
        i = i + 1;
    }
    op_add(op, npx);
    let fgbright:i32 = 0;
    if(2 * nb <= npx) { fgbright = 1; }
    let a:i64 = 0;
    i = 0;
    while(i < npx as i32) {
        let o:i32 = 8 + i * 3;
        let lum:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
        let isb:i32 = 0;
        if(lum > thr) { isb = 1; }
        if(isb == fgbright) { m[i] = 1; a = a + 1; } else { m[i] = 0; }
        i = i + 1;
    }
    op_add(op, npx);
    return a;
}
// ratio (per-mille) and sym90 (per-mille) from mask. rs[0]=ratio, rs[1]=sym.
// Returns 0 ok, -1 fail.
fn t3_ratiosym(m:[]u8, w:i32, h:i32, a:i64, rs:[]u8, op:[]u8) i32 {
    let npx:i64 = (w as i64) * (h as i64);
    if(a < 9) { return -1; }
    let sx:i64 = 0; let sy:i64 = 0;
    let i:i32 = 0;
    while(i < npx as i32) {
        if(m[i] == 1) {
            sx = sx + (i % w) as i64;
            sy = sy + (i / w) as i64;
        }
        i = i + 1;
    }
    op_add(op, npx);
    let cx:i64 = sx / a;
    let cy:i64 = sy / a;
    let maxd2:i64 = 0;
    i = 0;
    while(i < npx as i32) {
        if(m[i] == 1) {
            let dx:i64 = (i % w) as i64 - cx;
            let dy:i64 = (i / w) as i64 - cy;
            let d2:i64 = dx*dx + dy*dy;
            if(d2 > maxd2) { maxd2 = d2; }
        }
        i = i + 1;
    }
    op_add(op, npx);
    if(maxd2 < 1) { return -1; }
    let ratio:i64 = a * 1000000 / (3142 * maxd2);
    // sym90: rotate mask 90 deg about (cx,cy), overlap per-mille
    let hit:i64 = 0;
    i = 0;
    while(i < npx as i32) {
        if(m[i] == 1) {
            let x:i64 = (i % w) as i64;
            let y:i64 = (i / w) as i64;
            let rx:i64 = cx - (y - cy);
            let ry:i64 = cy + (x - cx);
            if(rx >= 0 && rx < w as i64 && ry >= 0 && ry < h as i64) {
                let j:i32 = (ry * (w as i64) + rx) as i32;
                if(m[j] == 1) { hit = hit + 1; }
            }
        }
        i = i + 1;
    }
    op_add(op, npx);
    // sym90: per-mille DIFFERING pixels under 90° rotation (PREREG §4:
    // CIRCLE/SQUARE claim <= 120, TRIANGLE claim >= 200).
    let sym:i64 = 1000 - hit * 1000 / a;
    t_put64(rs, 0, ratio);
    t_put64(rs, 8, sym);
    return 0;
}
fn t3_class(ratio:i64) i32 {
    let dc:i64 = iabs(ratio - 1000);
    let ds:i64 = iabs(ratio - 637);
    let dt:i64 = iabs(ratio - 414);
    let cls:i32 = 0;
    if(ds < dc && ds < dt) { cls = 1; }
    if(dt < dc && dt <= ds) { cls = 2; }
    return cls;
}
fn t3_name(c:i32) []u8 {
    if(c == 1) { return "SQUARE"; }
    if(c == 2) { return "TRIANGLE"; }
    return "CIRCLE";
}
// bb layout: [r350,s350,r382,s382,r414,s414,t0, cf0,br0, cf1,br1, cf2,br2]
fn h3_t3(buf:[]u8, n:i64, op:[]u8, bb:[]u8) i32 {
    let w:i32 = t_get32(buf, 0) as i32;
    let h:i32 = t_get32(buf, 4) as i32;
    if(w < 4 || h < 4 || w > 512 || h > 512) { return -1; }
    let npx:i64 = (w as i64) * (h as i64);
    if(8 + npx * 3 > n) { return -1; }
    let m:[]u8 = nio_alloc(npx as i32);
    if(m.len == 0) { return -1; }
    let rs:[]u8 = nio_alloc(16);
    // threshold 350
    let a350:i64 = t3_mask(buf, w, h, 350, m, op);
    let r350:i64 = -1; let s350:i64 = -1;
    if(a350 > 0) {
        if(t3_ratiosym(m, w, h, a350, rs, op) == 0) {
            r350 = t_get64(rs, 0); s350 = t_get64(rs, 8);
        }
    }
    // threshold 382 (T0)
    let a382:i64 = t3_mask(buf, w, h, 382, m, op);
    let r382:i64 = -1; let s382:i64 = -1;
    if(a382 > 0) {
        if(t3_ratiosym(m, w, h, a382, rs, op) == 0) {
            r382 = t_get64(rs, 0); s382 = t_get64(rs, 8);
        }
    }
    // threshold 414
    let a414:i64 = t3_mask(buf, w, h, 414, m, op);
    let r414:i64 = -1; let s414:i64 = -1;
    if(a414 > 0) {
        if(t3_ratiosym(m, w, h, a414, rs, op) == 0) {
            r414 = t_get64(rs, 0); s414 = t_get64(rs, 8);
        }
    }
    nio_free(m);
    nio_free(rs);
    if(r382 < 0) { return -1; }
    let t0:i32 = t3_class(r382);
    t_put64(bb, 0, r350); t_put64(bb, 8, s350);
    t_put64(bb, 16, r382); t_put64(bb, 24, s382);
    t_put64(bb, 32, r414); t_put64(bb, 40, s414);
    t_put64(bb, 48, t0 as i64);
    let c:i32 = 0;
    while(c < 3) {
        let cf:i64 = 0; let br:i64 = 0;
        // P1: class at 350 == branch claim
        if(r350 >= 0 && t3_class(r350) == c) { cf = cf + 1; } else { br = br + 1; }
        // P2: class at 414 == branch claim
        if(r414 >= 0 && t3_class(r414) == c) { cf = cf + 1; } else { br = br + 1; }
        // P3: sym90 gate for the branch claim
        if(s382 >= 0) {
            if(c == 0 || c == 1) {
                if(s382 <= 120) { cf = cf + 1; } else { br = br + 1; }
            }
            if(c == 2) {
                if(s382 >= 200) { cf = cf + 1; } else { br = br + 1; }
            }
        } else {
            br = br + 1;
        }
        t_put64(bb, 56 + c * 16, cf);
        t_put64(bb, 64 + c * 16, br);
        c = c + 1;
    }
    return t0;
}

// ================= audio helpers (ported verbatim from A) =================
fn ng_sin1024(p:i64) i64 {
    let q:i64 = (p >> 30) & 3;
    let fr:i64 = p & 1073741823;
    let x:i64 = (fr * 1608) >> 30;
    let xx:i64 = x;
    if(q == 1 || q == 3) { xx = 1608 - x; }
    let x2:i64 = xx * xx;
    let term:i64 = xx;
    let sum:i64 = xx;
    let k:i64 = 1;
    while(k <= 7) {
        term = 0 - term * x2 / ((2 * k) * (2 * k + 1) * 1048576);
        sum = sum + term;
        k = k + 1;
    }
    if(q >= 2) { return 0 - sum; }
    return sum;
}
fn pcm_peak(buf:[]u8, off:i32, cnt:i32) i64 {
    let p:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let s:i64 = iabs(t_geti16(buf, off + i * 2));
        if(s > p) { p = s; }
        i = i + 1;
    }
    return p;
}
fn pcm_abssum(buf:[]u8, off:i32, cnt:i32, op:[]u8) i64 {
    let s:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        s = s + iabs(t_geti16(buf, off + i * 2));
        i = i + 1;
    }
    op_add(op, cnt as i64);
    return s;
}
// sum of squares (energy). PREREG §4 t4 P3.
fn pcm_sumsq(buf:[]u8, off:i32, cnt:i32, op:[]u8) i64 {
    let s:i64 = 0;
    let i:i32 = 0;
    while(i < cnt) {
        let v:i64 = t_geti16(buf, off + i * 2);
        s = s + v * v;
        i = i + 1;
    }
    op_add(op, cnt as i64);
    return s;
}
fn harm_energy(buf:[]u8, off:i32, w:i32, sr:i64, f0m:i64, nhmax:i32, op:[]u8) i64 {
    if(f0m <= 0 || w < 64) { return 0; }
    let pinc1:i64 = f0m * 4294967296 / (1000 * sr);
    if(pinc1 <= 0) { return 0; }
    let tot:i64 = 0;
    let h:i64 = 1;
    while(h <= nhmax as i64) {
        if(2 * h * f0m >= sr * 1000) { break; }
        let pinc:i64 = h * pinc1;
        let re:i64 = 0;
        let im:i64 = 0;
        let i:i32 = 0;
        while(i < w) {
            let s:i64 = t_geti16(buf, off + i * 2);
            let p:i64 = ((i as i64) * pinc) & 4294967295;
            re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
            im = im + s * ng_sin1024(p) / 1024;
            i = i + 1;
        }
        op_add(op, (2 * w) as i64);
        tot = tot + (re * re + im * im) / 1048576;
        h = h + 1;
    }
    return tot;
}
fn f0_robust(buf:[]u8, off:i32, cnt:i32, sr:i64, op:[]u8) i64 {
    let w:i32 = cnt;
    if(w > 2048) { w = 2048; }
    if(w < 512) { return 0; }
    let peak:i64 = pcm_peak(buf, off, w);
    if(peak < 256) { return 0; }
    let ms:i64 = 0;
    let i:i32 = 0;
    while(i < w) { ms = ms + t_geti16(buf, off + i * 2); i = i + 1; }
    let mean:i64 = ms / (w as i64);
    op_add(op, (2 * w) as i64);
    let lmin:i32 = (sr / 2000) as i32;
    if(lmin < 2) { lmin = 2; }
    let lmax:i32 = (sr / 50) as i32;
    if(lmax > w / 3) { lmax = w / 3; }
    if(lmax < lmin + 2) { return 0; }
    let nl:i32 = lmax - lmin + 3;
    let ra:[]u8 = nio_alloc((nl * 8) as i32);
    if(ra.len == 0) { return 0; }
    let l:i32 = lmin - 1;
    while(l <= lmax + 1) {
        let acc:i64 = 0;
        let nn:i32 = w - l;
        let n:i32 = 0;
        while(n < nn) {
            let a:i64 = t_geti16(buf, off + n * 2) - mean;
            let b:i64 = t_geti16(buf, off + (n + l) * 2) - mean;
            acc = acc + a * b;
            n = n + 1;
        }
        op_add(op, nn as i64);
        t_put64(ra, (l - (lmin - 1)) * 8, acc);
        l = l + 1;
    }
    let gmax:i64 = 0;
    l = lmin;
    while(l <= lmax) {
        let r:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
        if(r > gmax) { gmax = r; }
        l = l + 1;
    }
    let lstar:i32 = -1;
    let r0:i64 = 0;
    let rm:i64 = 0;
    let rp:i64 = 0;
    if(gmax > 0) {
        l = lmin;
        while(l <= lmax) {
            let q0:i64 = t_get64(ra, (l - (lmin - 1)) * 8);
            let qm:i64 = t_get64(ra, (l - 1 - (lmin - 1)) * 8);
            let qp:i64 = t_get64(ra, (l + 1 - (lmin - 1)) * 8);
            if(q0 >= qm && q0 >= qp && q0 * 2 >= gmax) {
                lstar = l;
                r0 = q0;
                rm = qm;
                rp = qp;
                break;
            }
            l = l + 1;
        }
    }
    nio_free(ra);
    if(lstar < 0) { return 0; }
    let den:i64 = 2 * (rm - 2 * r0 + rp);
    let poff:i64 = 0;
    if(den != 0) { poff = (rm - rp) * 1024 / den; }
    if(poff < -512) { poff = -512; }
    if(poff > 512) { poff = 512; }
    let period_1024:i64 = (lstar as i64) * 1024 + poff;
    if(period_1024 <= 0) { return 0; }
    let f0c:i64 = sr * 1000 * 1024 / period_1024;
    let best_k:i32 = -30;
    let best_s:i64 = -1;
    let k:i32 = -30;
    while(k <= 30) {
        let f0k:i64 = f0c + f0c * (k as i64) / 1000;
        let s:i64 = harm_energy(buf, off, w, sr, f0k, 6, op);
        if(s > best_s) { best_s = s; best_k = k; }
        k = k + 1;
    }
    if(best_s <= 0) { return 0; }
    let sm:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k - 1) as i64) / 1000, 6, op);
    let sp:i64 = harm_energy(buf, off, w, sr, f0c + f0c * ((best_k + 1) as i64) / 1000, 6, op);
    let den2:i64 = 2 * (sm - 2 * best_s + sp);
    let koff:i64 = 0;
    if(den2 != 0) { koff = (sm - sp) * 1024 / den2; }
    if(koff < -512) { koff = -512; }
    if(koff > 512) { koff = 512; }
    let f0m:i64 = f0c + f0c * ((best_k as i64) * 1024 + koff) / (1024 * 1000);
    if(f0m <= 0) { return 0; }
    let e0:i64 = harm_energy(buf, off, w, sr, f0m, 8, op);
    let ehalf:i64 = harm_energy(buf, off, w, sr, f0m / 2, 16, op);
    let edbl:i64 = harm_energy(buf, off, w, sr, f0m * 2, 4, op);
    if(ehalf > e0 + e0 / 20) { return f0m / 2; }
    if(edbl > e0 + e0 / 20) { return f0m * 2; }
    return f0m;
}
// relative difference in ppm
fn dppm(a:i64, b:i64) i64 {
    if(a <= 0 || b <= 0) { return -1; }
    return iabs(b - a) * 1000000 / imax(a, 1);
}
// ================= TASK 4: pitchdisc (H3) ================================
fn t4_name(c:i32) []u8 {
    if(c == 1) { return "HIGHER"; }
    if(c == 2) { return "LOWER"; }
    return "SAME";
}
// bb: [fA,fB,fA1,fA2,fB1,fB2,gapsum,tonesum,dppm,t0, cf0,br0, cf1,br1, cf2,br2]
fn h3_t4(buf:[]u8, n:i64, op:[]u8, bb:[]u8) i32 {
    let sr:i32 = t_get32(buf, 0) as i32;
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 64 || (cnt % 2) == 1 || cnt > 4000000) { return -1; }
    if(8 + (cnt as i64) * 2 > n) { return -1; }
    let half:i32 = cnt / 2;
    let fA:i64 = f0_robust(buf, 8, half, sr as i64, op);
    let fB:i64 = f0_robust(buf, 8 + half * 2, half, sr as i64, op);
    if(fA <= 0 || fB <= 0) { return -1; }
    // Tone structure (frozen harness): tone, gap, tone. gap = cnt/11.
    // P1/P2 use the first/second halves of each tone (PREREG §4).
    let gap:i32 = cnt / 11;
    let tone:i32 = (cnt - gap) / 2;
    let thalf:i32 = tone / 2;
    let fA1:i64 = f0_robust(buf, 8, thalf, sr as i64, op);
    let fA2:i64 = f0_robust(buf, 8 + thalf * 2, thalf, sr as i64, op);
    let boff:i32 = 8 + (tone + gap) * 2;
    let fB1:i64 = f0_robust(buf, boff, thalf, sr as i64, op);
    let fB2:i64 = f0_robust(buf, boff + thalf * 2, thalf, sr as i64, op);
    // P3: middle-ninth total energy (sum of squares) < 15% of
    // max(tone-A energy, tone-B energy). PREREG §4.
    let g0:i32 = 8 + ((4 * cnt) / 9) * 2;
    let g1:i32 = 8 + ((5 * cnt) / 9) * 2;
    let gapsum:i64 = pcm_sumsq(buf, g0, (g1 - g0) / 2, op);
    let toneAsum:i64 = pcm_sumsq(buf, 8, tone, op);
    let toneBsum:i64 = pcm_sumsq(buf, boff, tone, op);
    let tonesum:i64 = toneAsum + toneBsum;
    let d:i64 = dppm(fA, fB);
    let t0:i32 = 0;
    if(d >= 20000 && fB > fA) { t0 = 1; }
    if(d >= 20000 && fB <= fA) { t0 = 2; }
    t_put64(bb, 0, fA); t_put64(bb, 8, fB);
    t_put64(bb, 16, fA1); t_put64(bb, 24, fA2);
    t_put64(bb, 32, fB1); t_put64(bb, 40, fB2);
    t_put64(bb, 48, gapsum); t_put64(bb, 56, tonesum);
    t_put64(bb, 64, d); t_put64(bb, 72, t0 as i64);
    // P1: tone-A f0 persistence
    let p1:i32 = 0;
    let da:i64 = dppm(fA1, fA2);
    if(da >= 0 && da < 20000) { p1 = 1; }
    // P2: tone-B f0 persistence
    let p2:i32 = 0;
    let db:i64 = dppm(fB1, fB2);
    if(db >= 0 && db < 20000) { p2 = 1; }
    // P3: quiet middle gap
    let p3:i32 = 0;
    let maxsum:i64 = toneAsum;
    if(toneBsum > maxsum) { maxsum = toneBsum; }
    if(maxsum > 0 && gapsum * 1000 < 150 * maxsum) { p3 = 1; }
    let c:i32 = 0;
    while(c < 3) {
        let cf:i64 = 0; let br:i64 = 0;
        if(p1 == 1) { cf = cf + 1; } else { br = br + 1; }
        if(p2 == 1) { cf = cf + 1; } else { br = br + 1; }
        if(p3 == 1) { cf = cf + 1; } else { br = br + 1; }
        // P4: decisive dppm for the branch claim
        if(c == 0) {
            if(d <= 10000) { cf = cf + 1; } else { br = br + 1; }
        }
        if(c == 1) {
            if(d >= 30000 && fB > fA) { cf = cf + 1; } else { br = br + 1; }
        }
        if(c == 2) {
            if(d >= 30000 && fB < fA) { cf = cf + 1; } else { br = br + 1; }
        }
        t_put64(bb, 80 + c * 16, cf);
        t_put64(bb, 88 + c * 16, br);
        c = c + 1;
    }
    return t0;
}

// ================= TASK 5: timbredisc (H3) ================================
// T0: A's harmonic centroid at its own f0. Predictions: half-split centroid
// agreement, harmonic support, boundary margin.

// centroid r (per-mille) over [off, off+cnt). nh_out gets harmonic count.
// Returns -1 on failure.
fn t5_f0nh(buf:[]u8, off:i32, cnt:i32, sr:i64, nh_out:[]u8, op:[]u8) i64 {
    let f0m:i64 = f0_robust(buf, off, cnt, sr, op);
    if(f0m < 50000 || f0m > 2000000) { return -1; }
    let nh:i32 = 0;
    let h:i64 = 1;
    while(h <= 8) {
        if(2 * h * f0m < sr * 1000) { nh = nh + 1; }
        h = h + 1;
    }
    if(nh < 3) { return -1; }
    t_put64(nh_out, 0, nh as i64);
    return f0m;
}
// centroid given f0m (milli-Hz) and nh. PREREG §4 P1 uses the full-tone f0
// for the half windows (deterministic re-parameterization).
fn t5_centroid_f0(buf:[]u8, off:i32, cnt:i32, sr:i64, f0m:i64, nh:i64, op:[]u8) i64 {
    let w:i32 = cnt;
    if(w > 2048) { w = 2048; }
    let pinc1:i64 = f0m * 4294967296 / (1000 * sr);
    let se:i64 = 0;
    let she:i64 = 0;
    let h:i64 = 1;
    while(h <= nh) {
        let pinc:i64 = h * pinc1;
        let re:i64 = 0;
        let im:i64 = 0;
        let i:i32 = 0;
        while(i < w) {
            let s:i64 = t_geti16(buf, off + i * 2);
            let p:i64 = ((i as i64) * pinc) & 4294967295;
            re = re + s * ng_sin1024((p + 1073741824) & 4294967295) / 1024;
            im = im + s * ng_sin1024(p) / 1024;
            i = i + 1;
        }
        op_add(op, (2 * w) as i64);
        let e:i64 = (re * re + im * im) / 1048576;
        se = se + e;
        she = she + h * e;
        h = h + 1;
    }
    if(se <= 0) { return -1; }
    op_add(op, nh);
    return 1000 * she / se;
}
fn t5_centroid(buf:[]u8, off:i32, cnt:i32, sr:i64, nh_out:[]u8, op:[]u8) i64 {
    let f0m:i64 = t5_f0nh(buf, off, cnt, sr, nh_out, op);
    if(f0m < 0) { return -1; }
    let nh:i64 = t_get64(nh_out, 0);
    return t5_centroid_f0(buf, off, cnt, sr, f0m, nh, op);
}
fn t5_class(r:i64) i32 {
    if(r < 1075) { return 0; }
    if(r < 1400) { return 1; }
    if(r < 3000) { return 2; }
    return 3;
}
fn t5_name(c:i32) []u8 {
    if(c == 1) { return "DARK"; }
    if(c == 2) { return "RICH"; }
    if(c == 3) { return "BRIGHT"; }
    return "PURE";
}
fn t5_margin(r:i64, c:i32) i64 {
    if(c == 0) { return 1075 - r; }
    if(c == 1) { return imin(r - 1075, 1400 - r); }
    if(c == 2) { return imin(r - 1400, 3000 - r); }
    return r - 3000;
}
// bb: [r_full,nh,r_h1,r_h2,t0, cf0,br0, ..., cf3,br3]
fn h3_t5(buf:[]u8, n:i64, op:[]u8, bb:[]u8) i32 {
    let sr:i32 = t_get32(buf, 0) as i32;
    let cnt:i32 = t_get32(buf, 4) as i32;
    if(sr < 1000 || sr > 192000) { return -1; }
    if(cnt < 256 || cnt > 4000000) { return -1; }
    if(8 + (cnt as i64) * 2 > n) { return -1; }
    let nhb:[]u8 = nio_alloc(8);
    let f0m:i64 = t5_f0nh(buf, 8, cnt, sr as i64, nhb, op);
    let nh:i64 = t_get64(nhb, 0);
    if(f0m < 0 || nh < 4) { nio_free(nhb); return -1; }
    let r_full:i64 = t5_centroid_f0(buf, 8, cnt, sr as i64, f0m, nh, op);
    if(r_full < 0) { nio_free(nhb); return -1; }
    let half:i32 = cnt / 2;
    // P1 (halves): independent centroid of the first half (full-tone f0),
    // second half measured independently. PREREG §4.
    let r_h1:i64 = t5_centroid_f0(buf, 8, half, sr as i64, f0m, nh, op);
    let r_h2:i64 = t5_centroid(buf, 8 + half * 2, half, sr as i64, nhb, op);
    nio_free(nhb);
    let t0:i32 = t5_class(r_full);
    t_put64(bb, 0, r_full); t_put64(bb, 8, nh);
    t_put64(bb, 16, r_h1); t_put64(bb, 24, r_h2);
    t_put64(bb, 32, t0 as i64);
    let c:i32 = 0;
    while(c < 4) {
        let cf:i64 = 0; let br:i64 = 0;
        // P1: halves agree with branch claim
        if(r_h1 >= 0 && r_h2 >= 0 && t5_class(r_h1) == c && t5_class(r_h2) == c) {
            cf = cf + 1;
        } else {
            br = br + 1;
        }
        // P2: harmonic support (claim-independent)
        if(nh >= 4) { cf = cf + 1; } else { br = br + 1; }
        // P3: boundary margin on the branch's side
        if(t5_class(r_full) == c && t5_margin(r_full, c) >= 75) {
            cf = cf + 1;
        } else {
            br = br + 1;
        }
        t_put64(bb, 40 + c * 16, cf);
        t_put64(bb, 48 + c * 16, br);
        c = c + 1;
    }
    return t0;
}

// ================= TASK 6: motiondir (H3) ================================
// T0: A's frame-diff displacement + octant. Predictions: window agreement.

// displacement over frame pairs [a,b). dxy[0]=dx, dxy[1]=dy.
// Returns support (pairs with mc>0), or -1 on fail.
fn t6_disp(buf:[]u8, nf:i32, w:i32, h:i32, fsz:i64, a:i32, b:i32, dxy:[]u8, op:[]u8) i64 {
    if(a < 1 || b > nf || b <= a) { return -1; }
    let npx:i32 = w * h;
    let have:i32 = 0;
    let fcx:i64 = 0; let fcy:i64 = 0;
    let lcx:i64 = 0; let lcy:i64 = 0;
    let sup:i64 = 0;
    let t:i32 = a;
    while(t < b) {
        let mc:i64 = 0; let mx:i64 = 0; let my:i64 = 0;
        let p:i32 = 0;
        while(p < npx) {
            let o0:i32 = (12 + ((t - 1) as i64) * fsz + (p as i64) * 3) as i32;
            let o1:i32 = (12 + (t as i64) * fsz + (p as i64) * 3) as i32;
            let d:i64 = iabs((buf[o1] as i64) - (buf[o0] as i64))
                      + iabs((buf[o1+1] as i64) - (buf[o0+1] as i64))
                      + iabs((buf[o1+2] as i64) - (buf[o0+2] as i64));
            if(d > 90) {
                mc = mc + 1;
                mx = mx + (p % w) as i64;
                my = my + (p / w) as i64;
            }
            p = p + 1;
        }
        op_add(op, npx as i64);
        if(mc > 0) {
            // PREREG §4 P3 (support): count pairs with mc >= 15.
            if(mc >= 15) { sup = sup + 1; }
            let cx:i64 = mx / mc;
            let cy:i64 = my / mc;
            if(have == 0) { fcx = cx; fcy = cy; have = 1; }
            lcx = cx; lcy = cy;
        }
        t = t + 1;
    }
    let dx:i64 = 0; let dy:i64 = 0;
    if(have == 1) { dx = lcx - fcx; dy = lcy - fcy; }
    t_put64(dxy, 0, dx);
    t_put64(dxy, 8, dy);
    return sup;
}
// direction code: 0 STILL, 1 N, 2 NE, 3 E, 4 SE, 5 S, 6 SW, 7 W, 8 NW
fn t6_dir(dx:i64, dy:i64) i32 {
    let mag2:i64 = dx*dx + dy*dy;
    let dir:i32 = 0;
    if(mag2 >= 9) {
        let ax:i64 = iabs(dx); let ay:i64 = iabs(dy);
        if(ax >= 2 * ay) {
            dir = 3;
            if(dx < 0) { dir = 7; }
        }
        if(ay >= 2 * ax) {
            dir = 5;
            if(dy < 0) { dir = 1; }
        }
        if(ax < 2 * ay && ay < 2 * ax) {
            dir = 4;
            if(dx < 0 && dy > 0) { dir = 6; }
            if(dx > 0 && dy < 0) { dir = 2; }
            if(dx < 0 && dy < 0) { dir = 8; }
        }
    }
    return dir;
}
fn t6_name(c:i32) []u8 {
    if(c == 1) { return "N"; }
    if(c == 2) { return "NE"; }
    if(c == 3) { return "E"; }
    if(c == 4) { return "SE"; }
    if(c == 5) { return "S"; }
    if(c == 6) { return "SW"; }
    if(c == 7) { return "W"; }
    if(c == 8) { return "NW"; }
    return "STILL";
}
// bb: [dx,dy,sup,dir_full,dir_w1,dir_w2,dir_mid,t0, cf0,br0, ..., cf8,br8]
fn h3_t6(buf:[]u8, n:i64, op:[]u8, bb:[]u8) i32 {
    let nf:i32 = t_get32(buf, 0) as i32;
    let w:i32 = t_get32(buf, 4) as i32;
    let h:i32 = t_get32(buf, 8) as i32;
    if(nf < 4 || nf > 1024) { return -1; }
    if(w < 2 || h < 2 || w > 512 || h > 512) { return -1; }
    let fsz:i64 = (w as i64) * (h as i64) * 3;
    if(12 + (nf as i64) * fsz > n) { return -1; }
    let dxy:[]u8 = nio_alloc(16);
    let sup:i64 = t6_disp(buf, nf, w, h, fsz, 1, nf, dxy, op);
    let dx:i64 = t_get64(dxy, 0); let dy:i64 = t_get64(dxy, 8);
    let dir_full:i32 = t6_dir(dx, dy);
    let s1:i64 = t6_disp(buf, nf, w, h, fsz, 2, nf, dxy, op);
    let dir_w1:i32 = t6_dir(t_get64(dxy, 0), t_get64(dxy, 8));
    let s2:i64 = t6_disp(buf, nf, w, h, fsz, 1, nf - 1, dxy, op);
    let dir_w2:i32 = t6_dir(t_get64(dxy, 0), t_get64(dxy, 8));
    let me:i32 = 2; let mf:i32 = 6;
    if(mf > nf) { mf = nf; }
    if(me >= mf) { me = 1; mf = nf; }
    let s3:i64 = t6_disp(buf, nf, w, h, fsz, me, mf, dxy, op);
    let dir_mid:i32 = t6_dir(t_get64(dxy, 0), t_get64(dxy, 8));
    nio_free(dxy);
    if(sup < 0) { return -1; }
    let t0:i32 = dir_full;
    t_put64(bb, 0, dx); t_put64(bb, 8, dy); t_put64(bb, 16, sup);
    t_put64(bb, 24, dir_full as i64); t_put64(bb, 32, dir_w1 as i64);
    t_put64(bb, 40, dir_w2 as i64); t_put64(bb, 48, dir_mid as i64);
    t_put64(bb, 56, t0 as i64);
    let c:i32 = 0;
    while(c < 9) {
        let cf:i64 = 0; let br:i64 = 0;
        // P1 (leave-one-out): T0(frames[1:]) == T0(frames[:-1]) == T0(full).
        // Single prediction per PREREG §4.
        if(dir_w1 == c && dir_w2 == c && dir_full == c) {
            cf = cf + 1;
        } else {
            br = br + 1;
        }
        // P2: middle window agrees
        if(dir_mid == c && dir_full == c) { cf = cf + 1; } else { br = br + 1; }
        // P3: support (claim-independent)
        if(sup >= 3) { cf = cf + 1; } else { br = br + 1; }
        t_put64(bb, 64 + c * 16, cf);
        t_put64(bb, 72 + c * 16, br);
        c = c + 1;
    }
    return t0;
}

// ================= MEMORY CONTRACT (executable, PREREG §3/§5) ==============
// cbr: 2*K i64s [cf0,br0,cf1,br1,...]. out[0]=installed_claim (-1 none),
// out[1]=disposition (0 UNTESTED,1 INSTALLED,2 WITHDRAWN,3 QUARANTINED).
fn contract(cbr:[]u8, t0:i32, K:i32, out:[]u8) void {
    let best:i32 = -1; let best_cf:i64 = -1;
    let ninst:i32 = 0;
    let c:i32 = 0;
    while(c < K) {
        let cf:i64 = t_get64(cbr, (c * 2) * 8);
        let br:i64 = t_get64(cbr, (c * 2 + 1) * 8);
        if(br == 0 && cf >= 2) {
            ninst = ninst + 1;
            if(cf > best_cf || (cf == best_cf && (best < 0 || c < best))) {
                best = c; best_cf = cf;
            }
        }
        c = c + 1;
    }
    // runner-up: max cf among installed branches other than best
    let second_cf:i64 = -1;
    c = 0;
    while(c < K) {
        if(c != best) {
            let cf:i64 = t_get64(cbr, (c * 2) * 8);
            let br:i64 = t_get64(cbr, (c * 2 + 1) * 8);
            if(br == 0 && cf >= 2 && cf > second_cf) { second_cf = cf; }
        }
        c = c + 1;
    }
    let installed:i32 = -1;
    let disp:i32 = 0;
    if(ninst == 0) {
        let br0:i64 = t_get64(cbr, (t0 * 2 + 1) * 8);
        if(br0 >= 2) { disp = 3; }
        else {
            if(br0 == 1) { disp = 2; } else { disp = 0; }
        }
    } else {
        if(ninst == 1 || best_cf - second_cf >= 2) {
            installed = best;
            disp = 1;
        } else {
            disp = 2;
        }
    }
    t_put64(out, 0, installed as i64);
    t_put64(out, 8, disp as i64);
}
fn disp_name(d:i32) []u8 {
    if(d == 1) { return "INSTALLED"; }
    if(d == 2) { return "WITHDRAWN"; }
    if(d == 3) { return "QUARANTINED"; }
    return "UNTESTED";
}
fn branch_name(tid:i32, c:i32) []u8 {
    if(tid == 1) { return t1_name(c); }
    if(tid == 2) { return t2_name(c); }
    if(tid == 3) { return t3_name(c); }
    if(tid == 4) { return t4_name(c); }
    if(tid == 5) { return t5_name(c); }
    return t6_name(c);
}
fn task_k(tid:i32) i32 {
    if(tid == 1) { return 2; }
    if(tid == 2) { return 2; }
    if(tid == 3) { return 3; }
    if(tid == 4) { return 3; }
    if(tid == 5) { return 4; }
    return 9;
}
// base confidence (A's formula) from bb. Returns 0..1000.
fn base_conf(tid:i32, bb:[]u8, t0:i32) i64 {
    if(tid == 1) {
        let df:i64 = t_get64(bb, 0);
        let mg:i64 = iabs(df - 40);
        return 1000 * mg / (mg + 60);
    }
    if(tid == 2) {
        let df:i64 = t_get64(bb, 0);
        let mg:i64 = iabs(df - 150);
        return 1000 * mg / (mg + 120);
    }
    if(tid == 3) {
        let r:i64 = t_get64(bb, 16);
        let dc:i64 = iabs(r - 1000);
        let ds:i64 = iabs(r - 637);
        let dt:i64 = iabs(r - 414);
        let best:i64 = dc;
        if(t0 == 1) { best = ds; }
        if(t0 == 2) { best = dt; }
        let other:i64 = dc;
        if(t0 == 0) { other = imin(ds, dt); }
        if(t0 == 1) { other = imin(dc, dt); }
        if(t0 == 2) { other = imin(dc, ds); }
        let mg:i64 = other - best;
        if(mg < 0) { mg = 0; }
        return 1000 * mg / (mg + 150);
    }
    if(tid == 4) {
        let d:i64 = t_get64(bb, 64);
        let mg:i64 = iabs(d - 20000);
        return 1000 * mg / (mg + 50000);
    }
    if(tid == 5) {
        let r:i64 = t_get64(bb, 0);
        let m0:i64 = iabs(r - 1075);
        let m1:i64 = iabs(r - 1400);
        let m2:i64 = iabs(r - 3000);
        let mg:i64 = imin(m0, imin(m1, m2));
        return 1000 * mg / (mg + 200);
    }
    let dx:i64 = t_get64(bb, 0);
    let dy:i64 = t_get64(bb, 8);
    let mg:i64 = iabs(isqrt(dx*dx + dy*dy) - 3);
    return 1000 * mg / (mg + 4);
}
// copy cf/br from task bb into cbr. Returns 0 ok.
fn extract_cbr(tid:i32, bb:[]u8, cbr:[]u8) void {
    let K:i32 = task_k(tid);
    let base:i64 = 48;
    if(tid == 3) { base = 56; }
    if(tid == 4) { base = 80; }
    if(tid == 5) { base = 40; }
    if(tid == 6) { base = 64; }
    let c:i32 = 0;
    while(c < K) {
        let cf:i64 = t_get64(bb, (base + (c as i64) * 16) as i32);
        let br:i64 = t_get64(bb, (base + (c as i64) * 16 + 8) as i32);
        t_put64(cbr, c * 16, cf);
        t_put64(cbr, c * 16 + 8, br);
        c = c + 1;
    }
}
fn t0_from_bb(tid:i32, bb:[]u8) i32 {
    if(tid == 1) { return t_get64(bb, 40) as i32; }
    if(tid == 2) { return t_get64(bb, 40) as i32; }
    if(tid == 3) { return t_get64(bb, 48) as i32; }
    if(tid == 4) { return t_get64(bb, 72) as i32; }
    if(tid == 5) { return t_get64(bb, 32) as i32; }
    return t_get64(bb, 56) as i32;
}

// ================= episode runner =======================================
// mem layout (216 bytes): prov_fidh[9]@0, durable[9]@72, quar[9]@144.
fn run_episode(tid:i32, task:[]u8, fx:[]u8, prevh:[]u8, mem:[]u8, mem_on:i32) i32 {
    let ob:[]u8 = nio_alloc(16384);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "H3");
    pos = ob_kv(ob, pos, "task", task);
    pos = ob_kv(ob, pos, "fixture", fx);
    let buf:[]u8 = nio_alloc(16777216);
    if(buf.len == 0) { nio_free(ob); return hfail(task, "alloc"); }
    let n:i64 = z_read(fx, buf, 16777216);
    if(n <= 0) {
        nio_free(buf);
        pos = ob_kv(ob, pos, "t0", "ERROR");
        pos = ob_kv(ob, pos, "judgment", "WITHHELD");
        pos = ob_kv(ob, pos, "disposition", "UNTESTED");
        pos = ob_kint(ob, pos, "confidence", 0);
        pos = ob_kint(ob, pos, "durable", 0);
        pos = ob_kint(ob, pos, "ops", 0);
        pos = ob_kv(ob, pos, "transition", "H3|ERR|");
        pos = ob_kv(ob, pos, "chain", "00");
        nio_write_all(1, ob[0..pos]);
        nio_free(ob);
        return 0;
    }
    let op:[]u8 = nio_alloc(8);
    let bb:[]u8 = nio_alloc(256);
    let cbr:[]u8 = nio_alloc(144);
    let cout:[]u8 = nio_alloc(16);
    let t0:i32 = -1;
    if(tid == 1) { t0 = h3_t1(buf, n, op, bb); }
    if(tid == 2) { t0 = h3_t2(buf, n, op, bb); }
    if(tid == 3) { t0 = h3_t3(buf, n, op, bb); }
    if(tid == 4) { t0 = h3_t4(buf, n, op, bb); }
    if(tid == 5) { t0 = h3_t5(buf, n, op, bb); }
    if(tid == 6) { t0 = h3_t6(buf, n, op, bb); }
    nio_free(buf);
    if(t0 < 0) {
        pos = ob_kv(ob, pos, "t0", "ERROR");
        pos = ob_kv(ob, pos, "judgment", "WITHHELD");
        pos = ob_kv(ob, pos, "disposition", "UNTESTED");
        pos = ob_kint(ob, pos, "confidence", 0);
        pos = ob_kint(ob, pos, "durable", 0);
        pos = ob_kint(ob, pos, "ops", t_get64(op, 0));
        pos = ob_kv(ob, pos, "transition", "H3|ERR|");
        pos = ob_kv(ob, pos, "chain", "00");
        nio_write_all(1, ob[0..pos]);
        nio_free(op); nio_free(bb); nio_free(cbr); nio_free(cout); nio_free(ob);
        return 0;
    }
    let K:i32 = task_k(tid);
    extract_cbr(tid, bb, cbr);
    contract(cbr, t0, K, cout);
    let installed:i32 = t_get64(cout, 0) as i32;
    let disp:i32 = t_get64(cout, 8) as i32;
    // cross-episode memory (stream mode)
    let dur_out:i64 = 0;
    if(mem_on == 1) {
        let fidh:i64 = fnv1a(fx);
        // quarantine revokes
        let c:i32 = 0;
        while(c < K) {
            let br:i64 = t_get64(cbr, c * 16 + 8);
            if(br >= 2) {
                t_put64(mem, 144 + c * 8, 1);
                t_put64(mem, 72 + c * 8, 0);
                t_put64(mem, 0 + c * 8, 0);
            }
            c = c + 1;
        }
        if(installed >= 0) {
            if(t_get64(mem, 144 + installed * 8) == 1) {
                installed = -1;
                disp = 2;
            } else {
                let pf:i64 = t_get64(mem, 0 + installed * 8);
                if(pf == 0) {
                    t_put64(mem, 0 + installed * 8, fidh);
                } else {
                    if(pf != fidh) {
                        t_put64(mem, 72 + installed * 8, 1);
                    }
                }
                dur_out = t_get64(mem, 72 + installed * 8);
            }
        }
    }
    let judge:i32 = t0;
    if(installed >= 0) { judge = installed; }
    let bc:i64 = base_conf(tid, bb, t0);
    let conf:i64 = bc;
    if(disp == 2) { conf = bc / 2; }
    if(disp == 0) { conf = bc / 4; }
    if(disp == 3) { conf = 0; }
    let ops:i64 = t_get64(op, 0);
    // canonical transition bytes
    let tb:[]u8 = nio_alloc(8192);
    let tp:i32 = 0;
    tp = ob_add(tb, tp, "H3|task=");
    tp = ob_add(tb, tp, task);
    tp = ob_add(tb, tp, "|fx=");
    tp = ob_add(tb, tp, fx);
    tp = ob_add(tb, tp, "|t0=");
    tp = ob_add(tb, tp, branch_name(tid, t0));
    tp = ob_add(tb, tp, "|br=");
    let c:i32 = 0;
    while(c < K) {
        tp = ob_add(tb, tp, _zag_i64_to_str(c as i64));
        tp = ob_add(tb, tp, ":");
        tp = ob_add(tb, tp, _zag_i64_to_str(t_get64(cbr, c * 16)));
        tp = ob_add(tb, tp, ":");
        tp = ob_add(tb, tp, _zag_i64_to_str(t_get64(cbr, c * 16 + 8)));
        tp = ob_add(tb, tp, ";");
        c = c + 1;
    }
    tp = ob_add(tb, tp, "|inst=");
    if(installed >= 0) { tp = ob_add(tb, tp, branch_name(tid, installed)); }
    else { tp = ob_add(tb, tp, "NONE"); }
    tp = ob_add(tb, tp, "|disp=");
    tp = ob_add(tb, tp, disp_name(disp));
    tp = ob_add(tb, tp, "|judge=");
    tp = ob_add(tb, tp, branch_name(tid, judge));
    tp = ob_add(tb, tp, "|dur=");
    tp = ob_add(tb, tp, _zag_i64_to_str(dur_out));
    tp = ob_add(tb, tp, "|");
    // chain = sha256(prevh || canonical)
    let cin:[]u8 = nio_alloc(32 + tp);
    let i:i32 = 0;
    while(i < 32) { cin[i] = prevh[i]; i = i + 1; }
    i = 0;
    while(i < tp) { cin[32 + i] = tb[i]; i = i + 1; }
    let ch:[]u8 = nio_alloc(32);
    ns_sha256(cin, ch);
    nio_free(cin);
    // copy chain into prevh for the caller (stream chaining)
    i = 0;
    while(i < 32) { prevh[i] = ch[i]; i = i + 1; }
    // emit
    pos = ob_kv(ob, pos, "t0", branch_name(tid, t0));
    pos = ob_kv(ob, pos, "judgment", branch_name(tid, judge));
    pos = ob_kv(ob, pos, "disposition", disp_name(disp));
    pos = ob_kint(ob, pos, "confidence", conf);
    pos = ob_kint(ob, pos, "durable", dur_out);
    pos = ob_kv(ob, pos, "installed", _zag_i64_to_str(installed as i64));
    pos = ob_kint(ob, pos, "ops", ops);
    pos = ob_add(ob, pos, "transition=");
    pos = ob_add(ob, pos, tb[0..tp]);
    pos = ob_add(ob, pos, "\n");
    pos = ob_add(ob, pos, "chain=");
    pos = ob_hex32(ob, pos, ch);
    pos = ob_add(ob, pos, "\n");
    nio_write_all(1, ob[0..pos]);
    nio_free(op); nio_free(bb); nio_free(cbr); nio_free(cout);
    nio_free(tb); nio_free(ch); nio_free(ob);
    return 0;
}

fn task_id(t:[]u8) i32 {
    if(_zag_strcmp(t, "colordisc") == 1) { return 1; }
    if(_zag_strcmp(t, "colorconst") == 1) { return 2; }
    if(_zag_strcmp(t, "shapetrans") == 1) { return 3; }
    if(_zag_strcmp(t, "pitchdisc") == 1) { return 4; }
    if(_zag_strcmp(t, "timbredisc") == 1) { return 5; }
    if(_zag_strcmp(t, "motiondir") == 1) { return 6; }
    return 0;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    let a2:[]u8 = _zag_arg(2);
    let a3:[]u8 = _zag_arg(3);
    // stream mode: sense_h3 stream <task> <listfile>
    if(_zag_strcmp(a1, "stream") == 1) {
        let tid:i32 = task_id(a2);
        if(tid == 0) { return hfail(a2, "bad-task"); }
        let lb:[]u8 = nio_alloc(1048576);
        let ln:i64 = z_read(a3, lb, 1048576);
        if(ln <= 0) { nio_free(lb); return hfail(a2, "bad-list"); }
        let prevh:[]u8 = nio_alloc(32);
        let mem:[]u8 = nio_alloc(216);
        let i:i32 = 0;
        while(i < 216) { mem[i] = 0; i = i + 1; }
        i = 0;
        while(i < 32) { prevh[i] = 0; i = i + 1; }
        // iterate lines
        let ls:i32 = 0;
        while(ls < ln as i32) {
            let le:i32 = ls;
            while(le < ln as i32 && lb[le] != 10) { le = le + 1; }
            if(le > ls) {
                let fx:[]u8 = lb[ls..le];
                run_episode(tid, a2, fx, prevh, mem, 1);
            }
            ls = le + 1;
        }
        // final ledger head
        let ob:[]u8 = nio_alloc(256);
        let pos:i32 = 0;
        pos = ob_add(ob, pos, "ledger_head=");
        pos = ob_hex32(ob, pos, prevh);
        pos = ob_add(ob, pos, "\n");
        nio_write_all(1, ob[0..pos]);
        nio_free(ob); nio_free(lb); nio_free(prevh); nio_free(mem);
        return 0;
    }
    // single mode: sense_h3 <task> <fixture> [prev_hash_hex]
    let tid:i32 = task_id(a1);
    if(tid == 0) { return hfail(a1, "bad-task"); }
    if(a2.len == 0) { return hfail(a1, "no-fixture"); }
    let prevh:[]u8 = nio_alloc(32);
    let i:i32 = 0;
    while(i < 32) { prevh[i] = 0; i = i + 1; }
    if(a3.len == 64) { hex_parse(a3, prevh); }
    let mem:[]u8 = nio_alloc(216);
    i = 0;
    while(i < 216) { mem[i] = 0; i = i + 1; }
    let rc:i32 = run_episode(tid, a1, a2, prevh, mem, 0);
    nio_free(prevh); nio_free(mem);
    return rc;
}

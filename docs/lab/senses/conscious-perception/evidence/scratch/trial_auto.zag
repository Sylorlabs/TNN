// Trial driver: deliberate vs automatic consolidation on designed curricula.
// The curricula below are FIXED adversarial phase schedules — no RNG in the
// world or the system. Both arms see the identical episode sequence.
// The evaluator (probe + spurious scan) is blind: it reads slow tiers only.
@import("psm.zag")

struct Obs { id:i32, op:i32, param:i32, ctx:i32, ver:i32 }

// Ground truth (world side; the system never sees these functions).
fn t_op(t:i32)i32 { return 1+((t%5)); }
fn t_param(t:i32)i32 { return 2+(((t*7)%9)); }
fn t_ctx(t:i32, k:i32)i32 { return ((t+2*k)%4); }
// Impostor form: a real id with a wrong op (designed to trigger automatic
// promotion and to override the true slow skill at probe time).
fn i_op(t:i32)i32 { return 1+((t_op(t)%5)); }
fn i_param(t:i32)i32 { return ((t_param(t)+4)%11); }

fn num(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}
fn tag(s:[]u8)void { _zag_print(s); }

fn cur_len(which:i32)i32 {
    if(which==1){ return 848; }
    if(which==2){ return 640; }
    return 3392;
}
fn n_true(which:i32)i32 {
    if(which==3){ return 80; }
    return 20;
}

// Emit episode e of curriculum `which` into o. Returns 0.
fn cur_ep(which:i32, e:i32, o:*Obs)i32 {
    if(which==1){
        // C1: burst + fast-tier pressure.
        // A: 16 true skills x20 reps, 2 true contexts each, verified.
        if(e<320){
            let t:i32=(e%16); let k:i32=((e/16)%2);
            o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=t_ctx(t,k),.ver=1};
            return 0;
        }
        // B1: impostor burst — 8 impostors (ids 0..7) x24, UNVERIFIED.
        if(e<512){
            let sub:i32=e-320; let t:i32=(sub%8);
            o.*=Obs{.id=t,.op=i_op(t),.param=i_param(t),.ctx=2+((sub/8)%2),.ver=0};
            return 0;
        }
        // B2: fabricated decoys — 8 fabricated ids x12, UNVERIFIED.
        if(e<608){
            let sub:i32=e-512; let k:i32=(sub%8);
            o.*=Obs{.id=100+k,.op=1+(k%5),.param=k,.ctx=(sub%4),.ver=0};
            return 0;
        }
        // C: 4 LATE true skills x40 reps — first appearance after the burst.
        if(e<768){
            let sub:i32=e-608; let t:i32=16+(sub/40); let k:i32=(((sub%40)/20)%2);
            o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=t_ctx(t,k),.ver=1};
            return 0;
        }
        // D: return to the 16 x5, verified.
        let sub:i32=e-768; let t:i32=(sub%16); let k:i32=(((sub/16)%2));
        o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=t_ctx(t,k),.ver=1};
        return 0;
    }
    if(which==2){
        // C2: interleaved impostors + context remap.
        // A: 16 true skills with an impostor interleaved every 4th episode.
        if(e<320){
            if((e%4)==3){
                let t:i32=((e/4)%8);
                o.*=Obs{.id=t,.op=i_op(t),.param=i_param(t),.ctx=2+(e%2),.ver=0};
                return 0;
            }
            let t:i32=(e%16); let k:i32=((e/16)%2);
            o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=t_ctx(t,k),.ver=1};
            return 0;
        }
        // B: context remap — same 16 skills verified in shifted contexts.
        if(e<480){
            let sub:i32=e-320; let t:i32=(sub%16); let k:i32=((sub/16)%2);
            o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=((t+2*k+1)%4),.ver=1};
            return 0;
        }
        // C: 4 late true skills x20.
        if(e<560){
            let sub:i32=e-480; let t:i32=16+(sub/20); let k:i32=(((sub%20)/10)%2);
            o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=t_ctx(t,k),.ver=1};
            return 0;
        }
        // D: return x5.
        let sub:i32=e-560; let t:i32=(sub%16); let k:i32=(((sub/16)%2));
        o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=t_ctx(t,k),.ver=1};
        return 0;
    }
    // C3: 4x scale. 80 true skills (64 + 16 late), 32 impostors, 32 fabricated.
    if(e<1280){
        let t:i32=(e%64); let k:i32=((e/64)%2);
        o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=t_ctx(t,k),.ver=1};
        return 0;
    }
    if(e<2048){
        let sub:i32=e-1280; let t:i32=(sub%32);
        o.*=Obs{.id=t,.op=i_op(t),.param=i_param(t),.ctx=2+((sub/32)%2),.ver=0};
        return 0;
    }
    if(e<2432){
        let sub:i32=e-2048; let k:i32=(sub%32);
        o.*=Obs{.id=1000+k,.op=1+(k%5),.param=(k%11),.ctx=(sub%4),.ver=0};
        return 0;
    }
    if(e<3072){
        let sub:i32=e-2432; let t:i32=64+(sub/40); let k:i32=(((sub%40)/20)%2);
        o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=t_ctx(t,k),.ver=1};
        return 0;
    }
    let sub:i32=e-3072; let t:i32=(sub%64); let k:i32=(((sub/64)%2));
    o.*=Obs{.id=t,.op=t_op(t),.param=t_param(t),.ctx=t_ctx(t,k),.ver=1};
    return 0;
}

// A slow skill is spurious iff it is not a true skill's true form.
fn spurious(id:i32, op:i32, param:i32, nt:i32)i32 {
    if(id<0 || id>=nt){ return 1; }
    if(op!=t_op(id) || param!=t_param(id)){ return 1; }
    return 0;
}

fn arm_name(mode:i32)[]u8 {
    if(mode==1){ return "delib"; }
    return "auto";
}

fn run_curriculum(which:i32, mode:i32, nf:i32, ns:i32, nh:i32, dg:*i64)void {
    let p:Psm=psm_init(mode,nf,ns,nh);
    let pp:*Psm=&p;
    let n:i32=cur_len(which);
    let ob:Obs=Obs{.id=0,.op=0,.param=0,.ctx=0,.ver=0};
    let e:i32=0;
    while(e<n){
        cur_ep(which,e,&ob);
        psm_observe(pp,ob.id,ob.op,ob.param,ob.ctx,ob.ver);
        e=e+1;
    }
    // Blind probe: frozen slow tier, every true skill in every context.
    let nt:i32=n_true(which);
    let correct:i32=0; let wrong:i32=0; let abstain:i32=0;
    let t:i32=0;
    while(t<nt){
        let c:i32=0;
        while(c<4){
            let oo:i32=0; let pa:i32=0;
            let f:i32=psm_probe(pp,t,&oo,&pa);
            if(f==0){ abstain=abstain+1; }
            else if(oo==t_op(t) && pa==t_param(t)){ correct=correct+1; }
            else { wrong=wrong+1; }
            c=c+1;
        }
        t=t+1;
    }
    // Spurious skills resident in the slow tier (pollution count).
    let spur:i32=0; let si:i32=0;
    while(si<ns){
        let id:i32=0; let op:i32=0; let pa:i32=0; let cf:i32=0;
        if(psm_slow_get(pp,si,&id,&op,&pa,&cf)==1){
            if(spurious(id,op,pa,nt)==1){ spur=spur+1; }
        }
        si=si+1;
    }
    dg.*=psm_digest(pp);
    tag("R27C,which=");num(which as i64);tag(",arm=");tag(arm_name(mode));
    tag(",correct=");num(correct as i64);tag(",wrong=");num(wrong as i64);
    tag(",abstain=");num(abstain as i64);tag(",spurious_slow=");num(spur as i64);
    tag(",consol=");num(p.n_consol as i64);tag(",condemn=");num(p.n_condemn as i64);
    tag(",preempt=");num(p.n_preempt as i64);tag(",revive=");num(p.n_revive as i64);
    tag(",dropped=");num(p.dropped as i64);tag(",slow_evict=");num(p.n_slow_evict as i64);
    tag(",hist=");num(p.hist_n as i64);tag(",hist_full=");num(p.hist_full as i64);
    tag(",digest=");num(dg.*);tag("\n");
    // Slow-tier dump (white-box evidence).
    si=0;
    while(si<ns){
        let id:i32=0; let op:i32=0; let pa:i32=0; let cf:i32=0;
        if(psm_slow_get(pp,si,&id,&op,&pa,&cf)==1){
            tag("R27C,slow,which=");num(which as i64);tag(",arm=");tag(arm_name(mode));
            tag(",id=");num(id as i64);tag(",op=");num(op as i64);
            tag(",param=");num(pa as i64);tag(",conf=");num(cf as i64);
            tag(",spurious=");num(spurious(id,op,pa,nt) as i64);tag("\n");
        }
        si=si+1;
    }
    // Audit-history dump (white-box evidence).
    let hi:i32=0;
    while(hi<p.hist_n){
        let hop:i32=0; let hid:i32=0; let hr:i32=0; let hs:i32=0;
        psm_hist_get(pp,hi,&hop,&hid,&hr,&hs);
        tag("R27C,hist,which=");num(which as i64);tag(",arm=");tag(arm_name(mode));
        tag(",op=");num(hop as i64);tag(",id=");num(hid as i64);
        tag(",reason=");num(hr as i64);tag(",step=");num(hs as i64);tag("\n");
        hi=hi+1;
    }
}

fn main()i32 {
    let w:i32=1;
    while(w<=3){
        let nf:i32=32; let ns:i32=32; let nh:i32=256;
        if(w==3){ nf=128; ns=128; nh=1024; }
        let m:i32=0;
        while(m<=0){
            let d1:i64=0; let d2:i64=0;
            run_curriculum(w,m,nf,ns,nh,&d1);
            // Determinism gate: run the arm a second time, digests must match.
            let p2:Psm=psm_init(m,nf,ns,nh);
            let pp2:*Psm=&p2;
            let n:i32=cur_len(w); let e:i32=0;
            let ob:Obs=Obs{.id=0,.op=0,.param=0,.ctx=0,.ver=0};
            while(e<n){
                cur_ep(w,e,&ob);
                psm_observe(pp2,ob.id,ob.op,ob.param,ob.ctx,ob.ver);
                e=e+1;
            }
            d2=psm_digest(pp2);
            tag("R27C,determinism,which=");num(w as i64);tag(",arm=");tag(arm_name(m));
            tag(",match=");num((d1==d2) as i64);tag("\n");
            m=m+1;
        }
        w=w+1;
    }
    tag("R27C,DONE\n");
    return 0;
}

// PAMGATE — minimal autopilot-vs-deliberative sense-gate experiment.
// Tier-1 measurement for the full-autopilot audit (prereg:
// ~/workspace/conscious_perception/preregs/AUDIT.md, component C2).
//
// Models the RT3 joke-sense failure mechanism: the autopilot sense maps a
// single surface feature (trope-word present) straight to a verdict, with
// no attention control, no re-sensing, no verification. The deliberative
// arm adds: (1) context agreement check, (2) one bounded re-sense on
// disagreement (denial-of-perception guard: max 1 re-sense per item),
// (3) punchline verification before any INSTALL.
//
// Fixtures are FIXED and deterministic (computed from the index — zero
// RNG; static grep for rng must be empty). 48 items:
//   0..11  deadpan traps:  SINCERE, trope=1, ctx=0, punch=0 (autopilot false-installs)
//   12..23 true jokes:     JOKE,    trope=1, ctx=1, punch=1 (both install)
//   24..35 plain sincere:  SINCERE, trope=0, ctx=0, punch=0 (both withhold)
//   36..41 subtle jokes:   JOKE,    trope=0, ctx=1, punch=1 (autopilot misses)
//   42..47 ambiguous:      SINCERE, trope=1, ctx=1, punch=0 (autopilot false-installs;
//                          deliberative withholds via punch verification)
// Verdict encoding: 1=INSTALL, 0=WITHHOLD.

fn num(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    _zag_free(_zag_slice_ptr(s));
}
fn tag(s:[]u8)void { _zag_print(s); }

fn f_label(i:i32)i32 {
    if(i<12){ return 0; }
    if(i<24){ return 1; }
    if(i<36){ return 0; }
    if(i<42){ return 1; }
    return 0;
}
fn f_trope(i:i32)i32 {
    if(i<12){ return 1; }
    if(i<24){ return 1; }
    if(i<36){ return 0; }
    if(i<42){ return 0; }
    return 1;
}
fn f_ctx(i:i32)i32 {
    if(i<12){ return 0; }
    if(i<24){ return 1; }
    if(i<36){ return 0; }
    if(i<42){ return 1; }
    return 1;
}
fn f_punch(i:i32)i32 {
    if(i<12){ return 0; }
    if(i<24){ return 1; }
    if(i<36){ return 0; }
    if(i<42){ return 1; }
    return 0;
}

// Autopilot arm: single surface feature straight to verdict. No judgment.
fn auto_verdict(i:i32, ops:*i64)i32 {
    ops.*=ops.*+1;
    return f_trope(i);
}

// Deliberative arm: base signal + context agreement + verification;
// one bounded re-sense on disagreement.
fn delib_verdict(i:i32, ops:*i64, res:*i64)i32 {
    let base:i32=f_trope(i);
    let cx:i32=f_ctx(i);
    ops.*=ops.*+2;
    let agree:i32=0;
    if(base==1){
        if(cx==1){ agree=1; }
    } else {
        if(cx==0){ agree=1; }
    }
    let pu:i32=f_punch(i);
    ops.*=ops.*+1;
    if(agree==1){
        if(base==1){ return pu; }
        return 0;
    }
    res.*=res.*+1;
    ops.*=ops.*+1;
    let pu2:i32=f_punch(i);
    return pu2;
}

fn run_arm(mode:i32, reps:i32, digest:*i64, installs:*i64, falsein:*i64,
            misses:*i64, ops:*i64, res:*i64)i32 {
    let r:i32=0;
    while(r<reps){
        let i:i32=0;
        while(i<48){
            let v:i32=0;
            if(mode==0){ v=auto_verdict(i,ops); } else { v=delib_verdict(i,ops,res); }
            let lb:i32=f_label(i);
            if(v==1){ installs.*=installs.*+1; }
            if(v==1){
                if(lb==0){ falsein.*=falsein.*+1; }
            } else {
                if(lb==1){ misses.*=misses.*+1; }
            }
            // FNV-1a-ish digest over (i,v) — integer only.
            digest.*=digest.*^((i as i64)*31+(v as i64));
            digest.*=digest.**1099511628211;
            i=i+1;
        }
        r=r+1;
    }
    return 0;
}

fn report(armname:[]u8, mode:i32, reps:i32)void {
    let dg:i64=1469598103934665603;
    let ins:i64=0; let fi:i64=0; let mi:i64=0; let op:i64=0; let rs:i64=0;
    run_arm(mode,reps,&dg,&ins,&fi,&mi,&op,&rs);
    // Determinism gate: second in-process run, digests must match.
    let dg2:i64=1469598103934665603;
    let ins2:i64=0; let fi2:i64=0; let mi2:i64=0; let op2:i64=0; let rs2:i64=0;
    run_arm(mode,reps,&dg2,&ins2,&fi2,&mi2,&op2,&rs2);
    tag("PAMG,arm=");tag(armname);
    tag(",items=");num((reps as i64)*48);
    tag(",installs=");num(ins);
    tag(",false_installs=");num(fi);
    tag(",misses=");num(mi);
    tag(",ops=");num(op);
    tag(",resenses=");num(rs);
    tag(",digest=");num(dg);
    tag(",determinism_match=");num((dg==dg2) as i64);
    tag("\n");
}

fn main()i32 {
    let reps:i32=3000;
    report("auto",0,reps);
    report("delib",1,reps);
    tag("PAMG,DONE\n");
    return 0;
}

// F1 AUTOPILOT — conscious-perception control fork (frozen 2026-09-23).
// Current behavior as a clean, instrumented reference: sensing runs on
// autopilot, deliberation receives percepts, the conscious gate admits.
// Pure Zag. Zero RNG in any decision path. Deterministic given state.
// Byte-identical reruns: stdout and the ledger contain no wall-clock data.
//
// CLI: f1 <manifest> <ledger-out>
//   manifest: text file, one fixture path per line, relative to the
//             manifest's own directory. Fixtures: .pcm/.img/.vid with
//             .truth sidecars (senses-rebuild harness container formats).
//   ledger-out: hash-chained ledger file (created/truncated).
//
// Build (from this directory):
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1 f1.zag \
//     --no-zagd --no-analyze --no-foreground-cache -o f1
@import("substrate/R33_NATIVE_SHA256_V2.zag")

// ---------------- tiny io ----------------
fn f1_cstr(s:[]u8)[]u8 {
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn f1_open_ro(path:[]u8)i64 {
    let c:[]u8 = f1_cstr(path);
    if(c.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(c) as i64, 0, 0, 0, 0, 0);
    nio_free(c);
    return fd;
}
fn f1_open_wo(path:[]u8)i64 {
    let c:[]u8 = f1_cstr(path);
    if(c.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(c) as i64, 577, 420, 0, 0, 0);
    nio_free(c);
    return fd;
}
fn f1_close(fd:i64)void {
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return;
}
fn f1_read_all(fd:i64, cap:i32, outn:*i32)[]u8 {
    let b:[]u8 = nio_alloc(cap);
    outn[0] = 0;
    if(b.len == 0) { return b; }
    let n:i32 = 0;
    let done:i32 = 0;
    while(done == 0) {
        if(n >= cap) { done = 1; }
        else {
            let chunk:[]u8 = b[n..cap];
            let r:i64 = _zag_raw_syscall(0, fd, _zag_slice_ptr(chunk) as i64, (cap - n) as i64, 0, 0, 0);
            if(r <= 0) { done = 1; }
            else { n = n + (r as i32); }
        }
    }
    outn[0] = n;
    return b;
}
fn f1_write_all(fd:i64, b:[]u8)void {
    let n:i32 = 0;
    let done:i32 = 0;
    while(done == 0) {
        if(n >= b.len) { done = 1; }
        else {
            let chunk:[]u8 = b[n..b.len];
            let r:i64 = _zag_raw_syscall(1, fd, _zag_slice_ptr(chunk) as i64, (b.len - n) as i64, 0, 0, 0);
            if(r <= 0) { done = 1; }
            else { n = n + (r as i32); }
        }
    }
    return;
}

// ---------------- byte readers ----------------
fn f1_u16le(b:[]u8, at:i32)i64 {
    return (b[at] as i64) | ((b[at + 1] as i64) << 8);
}
fn f1_u32le(b:[]u8, at:i32)i64 {
    return (b[at] as i64) | ((b[at + 1] as i64) << 8) | ((b[at + 2] as i64) << 16) | ((b[at + 3] as i64) << 24);
}
fn f1_i16le(b:[]u8, at:i32)i64 {
    let v:i64 = f1_u16le(b, at);
    if(v >= 32768) { v = v - 65536; }
    return v;
}
fn f1_isqrt(n:i64)i64 {
    if(n <= 0) { return 0; }
    let x:i64 = n;
    let done:i32 = 0;
    while(done == 0) {
        let y:i64 = (x + n / x) / 2;
        if(y >= x) { done = 1; }
        else { x = y; }
    }
    return x;
}
fn f1_equal(a:[]u8, b:[]u8)i32 {
    if(a.len != b.len) { return 0; }
    let i:i32 = 0;
    while(i < a.len) {
        if(a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn f1_last_slash(s:[]u8)i32 {
    let at:i32 = -1;
    let i:i32 = 0;
    while(i < s.len) {
        if(s[i] == 47) { at = i; }
        i = i + 1;
    }
    return at;
}
fn f1_abs(v:i64)i64 {
    if(v < 0) { return 0 - v; }
    return v;
}
fn f1_min(a:i64, b:i64)i64 {
    if(a < b) { return a; }
    return b;
}

// ---------------- ledger byte-builder ----------------
fn f1_lb8(lb:[]u8, lbn:*i64, c:i64)void {
    lb[(lbn[0]) as i32] = c as u8;
    lbn[0] = lbn[0] + 1;
    return;
}
fn f1_lbs(lb:[]u8, lbn:*i64, s:[]u8)void {
    let i:i32 = 0;
    while(i < s.len) { f1_lb8(lb, lbn, s[i] as i64); i = i + 1; }
    return;
}
fn f1_lbi(lb:[]u8, lbn:*i64, v:i64)void {
    let t:i64 = v;
    if(t < 0) { f1_lb8(lb, lbn, 45); t = 0 - t; }
    if(t == 0) { f1_lb8(lb, lbn, 48); return; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i32 = 0;
    while(t > 0) {
        tmp[n] = ((t % 10) + 48) as u8;
        n = n + 1;
        t = t / 10;
    }
    while(n > 0) { n = n - 1; f1_lb8(lb, lbn, tmp[n] as i64); }
    return;
}
fn f1_lbhex(lb:[]u8, lbn:*i64, b:[]u8)void {
    let hx:[]u8 = ns_hex(b);
    f1_lbs(lb, lbn, hx);
    return;
}
fn f1_sha(b:[]u8, out32:[]u8)void {
    let rc:i32 = ns_sha256(b, out32);
    if(rc != 0) { out32[0] = 1; }
    return;
}
// line = arbitrary text + "\n" into ledger arena
fn f1_ln(lb:[]u8, lbn:*i64, s:[]u8)void {
    f1_lbs(lb, lbn, s);
    f1_lb8(lb, lbn, 10);
    return;
}

// ---------------- pipelines ----------------
// ops is threaded as *i64; counts mirror gen/ref_f1.py exactly.

// interpolated zero-crossing dominant frequency (Hz, integer) of the
// int16 window starting at sample `base`, length `len` samples.
// file bytes: <II rate,count then int16 LE at offset 8.
fn f1_zc_freq(b:[]u8, base:i32, len:i32, rate:i64, ops:*i64)i64 {
    ops[0] = ops[0] + 1;
    let prev:i64 = f1_i16le(b, 8 + 2 * base);
    let first:i64 = -1;
    let last:i64 = -1;
    let count:i64 = 0;
    let i:i32 = 1;
    while(i < len) {
        ops[0] = ops[0] + 1;
        let cur:i64 = f1_i16le(b, 8 + 2 * (base + i));
        let cross:i32 = 0;
        if(prev < 0) {
            if(cur >= 0) { cross = 1; }
        }
        if(cross == 0) {
            if(prev > 0) {
                if(cur <= 0) { cross = 1; }
            }
        }
        if(cross == 0) {
            if(prev == 0) {
                if(cur != 0) { cross = 1; }
            }
        }
        if(cross == 1) {
            let num:i64 = f1_abs(prev);
            let den:i64 = num + f1_abs(cur);
            let pos:i64 = 0;
            if(den > 0) {
                let ii:i64 = (i - 1) as i64;
                pos = (ii << 16) + (num << 16) / den;
            }
            if(first < 0) { first = pos; }
            last = pos;
            count = count + 1;
        }
        prev = cur;
        i = i + 1;
    }
    if(count < 2) { return 0; }
    if(last <= first) { return 0; }
    let num2:i64 = (count - 1) * rate * 65536;
    let den2:i64 = 2 * (last - first);
    return num2 / den2;
}

// PITCH: halves A=[0:8192) B=[8192:16384); window=first 2048 of each.
// returns percept code 0=SAME 1=HIGHER 2=LOWER; fa/fb/rel via out params.
fn f1_pitch(b:[]u8, rate:i64, ops:*i64, fa:*i64, fb:*i64, rel:*i64)i64 {
    let fa0:i64 = f1_zc_freq(b, 0, 2048, rate, ops);
    let fb0:i64 = f1_zc_freq(b, 8192, 2048, rate, ops);
    fa[0] = fa0;
    fb[0] = fb0;
    if(fa0 <= 0) { rel[0] = 0; return 0; }
    let r:i64 = f1_abs(fb0 - fa0) * 1000000 / fa0;
    rel[0] = r;
    if(r < 20000) { return 0; }
    if(fb0 > fa0) { return 1; }
    return 2;
}

// TIMBRE: window=first 2048 samples; hp1000 class.
// returns class code 0=PURE 1=DARK 2=RICH 3=BRIGHT; hp via out param.
fn f1_timbre(b:[]u8, ops:*i64, hp:*i64)i64 {
    let et:i64 = 0;
    let i:i32 = 0;
    while(i < 2048) {
        ops[0] = ops[0] + 1;
        let v:i64 = f1_abs(f1_i16le(b, 8 + 2 * i));
        et = et + v;
        i = i + 1;
    }
    let eh:i64 = 0;
    let prev:i64 = f1_i16le(b, 8);
    i = 1;
    while(i < 2048) {
        ops[0] = ops[0] + 1;
        let cur:i64 = f1_i16le(b, 8 + 2 * i);
        eh = eh + f1_abs(cur - prev);
        prev = cur;
        i = i + 1;
    }
    let h:i64 = 0;
    if(et > 0) { h = (eh * 1000) / et; }
    hp[0] = h;
    if(h <= 67) { return 0; }
    if(h <= 82) { return 1; }
    if(h <= 110) { return 2; }
    return 3;
}

// image halves: mean/var/max per half. out arrays: mean[3], maxv[3]; var scalar.
fn f1_halves(px:[]u8, w:i32, h:i32, ops:*i64, mean1:*i64, var1:*i64, maxv1:*i64, mean2:*i64, var2:*i64, maxv2:*i64)void {
    let n:i64 = ((w / 2) as i64) * (h as i64);
    let s1r:i64 = 0;
    let s1g:i64 = 0;
    let s1b:i64 = 0;
    let q1r:i64 = 0;
    let q1g:i64 = 0;
    let q1b:i64 = 0;
    let x1r:i64 = 0;
    let x1g:i64 = 0;
    let x1b:i64 = 0;
    let s2r:i64 = 0;
    let s2g:i64 = 0;
    let s2b:i64 = 0;
    let q2r:i64 = 0;
    let q2g:i64 = 0;
    let q2b:i64 = 0;
    let x2r:i64 = 0;
    let x2g:i64 = 0;
    let x2b:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < w) {
            ops[0] = ops[0] + 1;
            let o:i32 = (y * w + x) * 3;
            let r:i64 = px[o] as i64;
            let g:i64 = px[o + 1] as i64;
            let bl:i64 = px[o + 2] as i64;
            if(x < w / 2) {
                s1r = s1r + r;
                s1g = s1g + g;
                s1b = s1b + bl;
                q1r = q1r + r * r;
                q1g = q1g + g * g;
                q1b = q1b + bl * bl;
                if(r > x1r) { x1r = r; }
                if(g > x1g) { x1g = g; }
                if(bl > x1b) { x1b = bl; }
            }
            else {
                s2r = s2r + r;
                s2g = s2g + g;
                s2b = s2b + bl;
                q2r = q2r + r * r;
                q2g = q2g + g * g;
                q2b = q2b + bl * bl;
                if(r > x2r) { x2r = r; }
                if(g > x2g) { x2g = g; }
                if(bl > x2b) { x2b = bl; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    mean1[0] = s1r / n;
    mean1[1] = s1g / n;
    mean1[2] = s1b / n;
    maxv1[0] = x1r;
    maxv1[1] = x1g;
    maxv1[2] = x1b;
    let v1:i64 = q1r / n - mean1[0] * mean1[0];
    let t:i64 = q1g / n - mean1[1] * mean1[1];
    if(t > v1) { v1 = t; }
    t = q1b / n - mean1[2] * mean1[2];
    if(t > v1) { v1 = t; }
    var1[0] = v1;
    mean2[0] = s2r / n;
    mean2[1] = s2g / n;
    mean2[2] = s2b / n;
    maxv2[0] = x2r;
    maxv2[1] = x2g;
    maxv2[2] = x2b;
    let v2:i64 = q2r / n - mean2[0] * mean2[0];
    t = q2g / n - mean2[1] * mean2[1];
    if(t > v2) { v2 = t; }
    t = q2b / n - mean2[2] * mean2[2];
    if(t > v2) { v2 = t; }
    var2[0] = v2;
    return;
}

// MOTION: brightness-weighted centroid of frame 0 vs frame 7 (Q6 subpixel).
fn f1_centroid(fr:[]u8, w:i32, h:i32, ops:*i64, ox:*i64, oy:*i64)void {
    let sx:i64 = 0;
    let sy:i64 = 0;
    let sw:i64 = 0;
    let y:i32 = 0;
    while(y < h) {
        let x:i32 = 0;
        while(x < w) {
            ops[0] = ops[0] + 1;
            let o:i32 = (y * w + x) * 3;
            let b:i64 = ((fr[o] as i64) + (fr[o + 1] as i64) + (fr[o + 2] as i64)) / 3;
            if(b > 16) {
                sx = sx + (x as i64) * b;
                sy = sy + (y as i64) * b;
                sw = sw + b;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if(sw == 0) { ox[0] = 0; oy[0] = 0; return; }
    ox[0] = (sx * 64) / sw;
    oy[0] = (sy * 64) / sw;
    return;
}

// ---------------- task / percept vocab ----------------
// task codes: 0=PITCH 1=TIMBRE 2=COLORDISC 3=COLORCONST 4=MOTION 5=UNKNOWN
fn f1_task_str(t:i64)[]u8 {
    if(t == 0) { return "PITCH"; }
    if(t == 1) { return "TIMBRE"; }
    if(t == 2) { return "COLORDISC"; }
    if(t == 3) { return "COLORCONST"; }
    if(t == 4) { return "MOTION"; }
    return "UNKNOWN";
}
fn f1_percept_str(t:i64, code:i64)[]u8 {
    if(t == 0) {
        if(code == 1) { return "HIGHER"; }
        if(code == 2) { return "LOWER"; }
        return "SAME";
    }
    if(t == 1) {
        if(code == 0) { return "PURE"; }
        if(code == 1) { return "DARK"; }
        if(code == 2) { return "RICH"; }
        return "BRIGHT";
    }
    if(t == 2) {
        if(code == 1) { return "DIFFERENT"; }
        return "SAME";
    }
    if(t == 3) {
        if(code == 1) { return "DIFFERENT"; }
        return "SAME_SURFACE";
    }
    if(t == 4) {
        if(code == 1) { return "N"; }
        if(code == 2) { return "NE"; }
        if(code == 3) { return "E"; }
        if(code == 4) { return "SE"; }
        if(code == 5) { return "S"; }
        if(code == 6) { return "SW"; }
        if(code == 7) { return "W"; }
        if(code == 8) { return "NW"; }
        return "STILL";
    }
    return "NONE";
}

// motion direction code from Q6 displacement
fn f1_mdir(dx:i64, dy:i64)i64 {
    let ax:i64 = f1_abs(dx);
    let ay:i64 = f1_abs(dy);
    let m:i64 = ax;
    if(ay > m) { m = ay; }
    if(m < 128) { return 0; }
    if(ax >= 2 * ay) {
        if(dx > 0) { return 3; }
        return 7;
    }
    if(ay >= 2 * ax) {
        if(dy > 0) { return 5; }
        return 1;
    }
    if(dy > 0) {
        if(dx > 0) { return 4; }
        return 6;
    }
    if(dx > 0) { return 2; }
    return 8;
}

// truth value: text after "truth=" at a line start
fn f1_truth_of(tpath:[]u8)[]u8 {
    let fd:i64 = f1_open_ro(tpath);
    let empty:[]u8 = "";
    if(fd < 0) { return empty; }
    let nn:*i32 = _zag_malloc(4) as *i32;
    let b:[]u8 = f1_read_all(fd, 4096, nn);
    f1_close(fd);
    let n:i32 = nn[0];
    let i:i32 = 0;
    while(i < n) {
        let ls:i32 = i;
        let eol:i32 = 0;
        while(eol == 0) {
            if(i >= n) { eol = 1; }
            else {
                if(b[i] == 10) { eol = 1; }
                else { i = i + 1; }
            }
        }
        let le:i32 = i;
        if(i < n) { i = i + 1; }
        if(le - ls >= 7) {
            if(b[ls] == 116) {
                if(b[ls + 1] == 114) {
                    if(b[ls + 2] == 117) {
                        if(b[ls + 3] == 116) {
                            if(b[ls + 4] == 104) {
                                if(b[ls + 5] == 61) {
                                    return b[ls + 6..le];
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return empty;
}

// print one ledger/result line held in arena slice
fn f1_emit(s:[]u8)void {
    _zag_print(s);
    _zag_println("");
    return;
}

// ---------------- one episode ----------------
// returns 0 ok, 4 = fixture unreadable (caller must abort; never install garbage)
fn f1_episode(lb:[]u8, lbn:*i64, prev32:[]u8, full:[]u8, rel:[]u8, epn:i64, correct:*i64, opssum:*i64)i32 {
    // extension
    let dot:i32 = -1;
    let i:i32 = 0;
    while(i < full.len) {
        if(full[i] == 46) { dot = i; }
        i = i + 1;
    }
    let ext:[]u8 = "";
    if(dot >= 0) { ext = full[dot..full.len]; }
    let is_pcm:i32 = f1_equal(ext, ".pcm");
    let is_img:i32 = f1_equal(ext, ".img");
    let is_vid:i32 = f1_equal(ext, ".vid");

    let fd:i64 = f1_open_ro(full);
    if(fd < 0) {
        _zag_print("f1: cannot open fixture ");
        _zag_print(full);
        _zag_println("");
        return 4;
    }
    let nn:*i32 = _zag_malloc(4) as *i32;
    let b:[]u8 = f1_read_all(fd, 1048576, nn);
    f1_close(fd);
    let n:i32 = nn[0];

    let ops:*i64 = _zag_malloc(8) as *i64;
    ops[0] = 0;
    let task:i64 = 5;
    let code:i64 = 0;
    let conf:i64 = 0;

    // detail scalars for ledger + RESULT detail
    let d0:i64 = 0;
    let d1:i64 = 0;
    let d2:i64 = 0;

    // ledger episode body arena
    let eb:[]u8 = nio_alloc(8192);
    let ebn:*i64 = _zag_malloc(8) as *i64;
    ebn[0] = 0;
    let h32:[]u8 = nio_alloc(32);

    // EPISODE line
    f1_lbs(eb, ebn, "EPISODE ");
    f1_lbi(eb, ebn, epn);
    f1_lbs(eb, ebn, " fixture=");
    f1_lbs(eb, ebn, rel);
    f1_lb8(eb, ebn, 10);

    // READ step
    f1_sha(b[0..n], h32);
    f1_lbs(eb, ebn, "STEP op=READ bytes=");
    f1_lbi(eb, ebn, n as i64);
    f1_lbs(eb, ebn, " sha=");
    f1_lbhex(eb, ebn, h32);
    f1_lb8(eb, ebn, 10);
    let filehash:[]u8 = nio_alloc(32);
    f1_sha(b[0..n], filehash);

    if(is_pcm == 1) {
        let rate:i64 = f1_u32le(b, 0);
        let ns:i64 = f1_u32le(b, 4);
        if(ns == 16384) {
            task = 0;
            let fa:*i64 = _zag_malloc(8) as *i64;
            let fb:*i64 = _zag_malloc(8) as *i64;
            let rl:*i64 = _zag_malloc(8) as *i64;
            code = f1_pitch(b, rate, ops, fa, fb, rl);
            d0 = fa[0];
            d1 = fb[0];
            d2 = rl[0];
            let m:i64 = f1_abs(d2 - 20000);
            conf = f1_min(1000, m * 1000 / 20000);
            // ledger: WINDOW + ZC_FREQ steps
            f1_lbs(eb, ebn, "STEP op=WINDOW half=A off=0 len=2048 sha=");
            f1_sha(b[8..8 + 4096], h32);
            f1_lbhex(eb, ebn, h32);
            f1_lb8(eb, ebn, 10);
            f1_lbs(eb, ebn, "STEP op=WINDOW half=B off=8192 len=2048 sha=");
            f1_sha(b[8 + 16384..8 + 16384 + 4096], h32);
            f1_lbhex(eb, ebn, h32);
            f1_lb8(eb, ebn, 10);
            f1_lbs(eb, ebn, "STEP op=ZC_FREQ win=A f=");
            f1_lbi(eb, ebn, d0);
            f1_lb8(eb, ebn, 10);
            f1_lbs(eb, ebn, "STEP op=ZC_FREQ win=B f=");
            f1_lbi(eb, ebn, d1);
            f1_lb8(eb, ebn, 10);
        }
        else {
            if(ns == 8192) {
                task = 1;
                let hp:*i64 = _zag_malloc(8) as *i64;
                code = f1_timbre(b, ops, hp);
                d0 = hp[0];
                let m:i64 = f1_abs(d0 - 67);
                let t2:i64 = f1_abs(d0 - 82);
                if(t2 < m) { m = t2; }
                t2 = f1_abs(d0 - 110);
                if(t2 < m) { m = t2; }
                conf = f1_min(1000, m * 1000 / 60);
                f1_lbs(eb, ebn, "STEP op=WINDOW off=0 len=2048 sha=");
                f1_sha(b[8..8 + 4096], h32);
                f1_lbhex(eb, ebn, h32);
                f1_lb8(eb, ebn, 10);
                f1_lbs(eb, ebn, "STEP op=HPSTATS hp1000=");
                f1_lbi(eb, ebn, d0);
                f1_lb8(eb, ebn, 10);
            }
        }
    }
    if(is_img == 1) {
        let w:i32 = f1_u32le(b, 0) as i32;
        let h:i32 = f1_u32le(b, 4) as i32;
        let px:[]u8 = b[8..n];
        // routing pass: variance test
        let rm1:*i64 = _zag_malloc(24) as *i64;
        let rv1:*i64 = _zag_malloc(8) as *i64;
        let rx1:*i64 = _zag_malloc(24) as *i64;
        let rm2:*i64 = _zag_malloc(24) as *i64;
        let rv2:*i64 = _zag_malloc(8) as *i64;
        let rx2:*i64 = _zag_malloc(24) as *i64;
        f1_halves(px, w, h, ops, rm1, rv1, rx1, rm2, rv2, rx2);
        let flat:i32 = 0;
        if(rv1[0] < 1) {
            if(rv2[0] < 1) { flat = 1; }
        }
        // task pass
        let m1:*i64 = _zag_malloc(24) as *i64;
        let v1:*i64 = _zag_malloc(8) as *i64;
        let x1:*i64 = _zag_malloc(24) as *i64;
        let m2:*i64 = _zag_malloc(24) as *i64;
        let v2:*i64 = _zag_malloc(8) as *i64;
        let x2:*i64 = _zag_malloc(24) as *i64;
        f1_halves(px, w, h, ops, m1, v1, x1, m2, v2, x2);
        f1_lbs(eb, ebn, "STEP op=HALVES mean1=");
        f1_lbi(eb, ebn, m1[0]);
        f1_lb8(eb, ebn, 44);
        f1_lbi(eb, ebn, m1[1]);
        f1_lb8(eb, ebn, 44);
        f1_lbi(eb, ebn, m1[2]);
        f1_lbs(eb, ebn, " mean2=");
        f1_lbi(eb, ebn, m2[0]);
        f1_lb8(eb, ebn, 44);
        f1_lbi(eb, ebn, m2[1]);
        f1_lb8(eb, ebn, 44);
        f1_lbi(eb, ebn, m2[2]);
        f1_lb8(eb, ebn, 10);
        if(flat == 1) {
            task = 2;
            let d2v:i64 = (m1[0] - m2[0]) * (m1[0] - m2[0]) + (m1[1] - m2[1]) * (m1[1] - m2[1]) + (m1[2] - m2[2]) * (m1[2] - m2[2]);
            let dd:i64 = f1_isqrt(d2v);
            d0 = dd;
            if(dd < 40) { code = 0; }
            else { code = 1; }
            conf = f1_min(1000, f1_abs(dd - 40) * 1000 / 40);
            f1_lbs(eb, ebn, "STEP op=DIST dist=");
            f1_lbi(eb, ebn, dd);
            f1_lb8(eb, ebn, 10);
        }
        else {
            task = 3;
            let worst:i64 = 0;
            let c:i32 = 0;
            while(c < 3) {
                let mx1:i64 = x1[c];
                if(mx1 < 1) { mx1 = 1; }
                let mx2:i64 = x2[c];
                if(mx2 < 1) { mx2 = 1; }
                let dd:i64 = f1_abs(m1[c] * 255 / mx1 - m2[c] * 255 / mx2);
                if(dd > worst) { worst = dd; }
                c = c + 1;
            }
            d0 = worst;
            if(worst < 8) { code = 0; }
            else { code = 1; }
            conf = f1_min(1000, f1_abs(worst - 8) * 1000 / 8);
            f1_lbs(eb, ebn, "STEP op=WHITEPATCH maxdisc=");
            f1_lbi(eb, ebn, worst);
            f1_lb8(eb, ebn, 10);
        }
    }
    if(is_vid == 1) {
        task = 4;
        let nf:i64 = f1_u32le(b, 0);
        let w:i32 = f1_u32le(b, 4) as i32;
        let h:i32 = f1_u32le(b, 8) as i32;
        let fsz:i32 = (w * h * 3) as i32;
        let f0:[]u8 = b[12..12 + fsz];
        let f7:[]u8 = b[12 + 7 * fsz..12 + 8 * fsz];
        let x0:*i64 = _zag_malloc(8) as *i64;
        let y0:*i64 = _zag_malloc(8) as *i64;
        let x1:*i64 = _zag_malloc(8) as *i64;
        let y1:*i64 = _zag_malloc(8) as *i64;
        f1_centroid(f0, w, h, ops, x0, y0);
        f1_centroid(f7, w, h, ops, x1, y1);
        let dx:i64 = x1[0] - x0[0];
        let dy:i64 = y1[0] - y0[0];
        d0 = dx;
        d1 = dy;
        code = f1_mdir(dx, dy);
        let ax:i64 = f1_abs(dx);
        let ay:i64 = f1_abs(dy);
        let m:i64 = ax;
        if(ay > m) { m = ay; }
        conf = f1_min(1000, m * 1000 / 512);
        f1_lbs(eb, ebn, "STEP op=CENTROID frame=0 x=");
        f1_lbi(eb, ebn, x0[0]);
        f1_lbs(eb, ebn, " y=");
        f1_lbi(eb, ebn, y0[0]);
        f1_lb8(eb, ebn, 10);
        f1_lbs(eb, ebn, "STEP op=CENTROID frame=7 x=");
        f1_lbi(eb, ebn, x1[0]);
        f1_lbs(eb, ebn, " y=");
        f1_lbi(eb, ebn, y1[0]);
        f1_lb8(eb, ebn, 10);
        f1_lbs(eb, ebn, "STEP op=DISPLACE dx_q6=");
        f1_lbi(eb, ebn, dx);
        f1_lbs(eb, ebn, " dy_q6=");
        f1_lbi(eb, ebn, dy);
        f1_lb8(eb, ebn, 10);
    }

    // ROUTE + DECIDE steps
    f1_lbs(eb, ebn, "STEP op=ROUTE task=");
    f1_lbs(eb, ebn, f1_task_str(task));
    f1_lb8(eb, ebn, 10);
    let ps:[]u8 = f1_percept_str(task, code);
    f1_lbs(eb, ebn, "STEP op=DECIDE out=");
    f1_lbs(eb, ebn, ps);
    f1_lb8(eb, ebn, 10);

    // truth + match
    let tpath:[]u8 = nio_alloc(full.len + 6);
    let ti:i32 = 0;
    while(ti < full.len) { tpath[ti] = full[ti]; ti = ti + 1; }
    let suf:[]u8 = ".truth";
    ti = 0;
    while(ti < 6) { tpath[full.len + ti] = suf[ti]; ti = ti + 1; }
    let tv:[]u8 = f1_truth_of(tpath[0..full.len + 6]);
    let mt:i64 = 0;
    if(f1_equal(ps, tv) == 1) { mt = 1; }
    correct[0] = correct[0] + mt;
    opssum[0] = opssum[0] + ops[0];

    f1_lbs(eb, ebn, "PERCEPT task=");
    f1_lbs(eb, ebn, f1_task_str(task));
    f1_lbs(eb, ebn, " percept=");
    f1_lbs(eb, ebn, ps);
    f1_lbs(eb, ebn, " conf=");
    f1_lbi(eb, ebn, conf);
    f1_lbs(eb, ebn, " match=");
    f1_lbi(eb, ebn, mt);
    f1_lb8(eb, ebn, 10);

    // chain: entry = sha256(prev32 || body)
    let cb:[]u8 = nio_alloc(32 + (ebn[0] as i32));
    let ci:i32 = 0;
    while(ci < 32) { cb[ci] = prev32[ci]; ci = ci + 1; }
    ci = 0;
    while(ci < (ebn[0] as i32)) { cb[32 + ci] = eb[ci]; ci = ci + 1; }
    let entry:[]u8 = nio_alloc(32);
    f1_sha(cb[0..32 + (ebn[0] as i32)], entry);
    // append body + CHAIN line to ledger
    let bi:i32 = 0;
    while(bi < (ebn[0] as i32)) {
        lb[(lbn[0]) as i32] = eb[bi];
        lbn[0] = lbn[0] + 1;
        bi = bi + 1;
    }
    f1_lbs(lb, lbn, "CHAIN prev=");
    f1_lbhex(lb, lbn, prev32);
    f1_lbs(lb, lbn, " entry=");
    f1_lbhex(lb, lbn, entry);
    f1_lb8(lb, lbn, 10);
    ci = 0;
    while(ci < 32) { prev32[ci] = entry[ci]; ci = ci + 1; }

    // RESULT line to stdout
    let rb:[]u8 = nio_alloc(1024);
    let rbn:*i64 = _zag_malloc(8) as *i64;
    rbn[0] = 0;
    f1_lbs(rb, rbn, "RESULT n=");
    f1_lbi(rb, rbn, epn);
    f1_lbs(rb, rbn, " fixture=");
    f1_lbs(rb, rbn, rel);
    f1_lbs(rb, rbn, " task=");
    f1_lbs(rb, rbn, f1_task_str(task));
    f1_lbs(rb, rbn, " percept=");
    f1_lbs(rb, rbn, ps);
    f1_lbs(rb, rbn, " conf=");
    f1_lbi(rb, rbn, conf);
    f1_lbs(rb, rbn, " ops=");
    f1_lbi(rb, rbn, ops[0]);
    f1_lbs(rb, rbn, " match=");
    f1_lbi(rb, rbn, mt);
    f1_lbs(rb, rbn, " detail=");
    if(task == 0) {
        f1_lbs(rb, rbn, "fA=");
        f1_lbi(rb, rbn, d0);
        f1_lbs(rb, rbn, ",fB=");
        f1_lbi(rb, rbn, d1);
        f1_lbs(rb, rbn, ",rel_ppm=");
        f1_lbi(rb, rbn, d2);
    }
    if(task == 1) {
        f1_lbs(rb, rbn, "hp1000=");
        f1_lbi(rb, rbn, d0);
    }
    if(task == 2) {
        f1_lbs(rb, rbn, "dist=");
        f1_lbi(rb, rbn, d0);
    }
    if(task == 3) {
        f1_lbs(rb, rbn, "maxdisc=");
        f1_lbi(rb, rbn, d0);
    }
    if(task == 4) {
        f1_lbs(rb, rbn, "dx_q6=");
        f1_lbi(rb, rbn, d0);
        f1_lbs(rb, rbn, ",dy_q6=");
        f1_lbi(rb, rbn, d1);
    }
    f1_emit(rb[0..(rbn[0] as i32)]);
    return 0;
}

// ---------------- ledger header: declared sampling policy + loss bounds ----------------
fn f1_write_header(lb:[]u8, lbn:*i64, mpath:[]u8, prev32:[]u8)void {
    f1_ln(lb, lbn, "F1-AUTOPILOT-LEDGER v=1 fork=autopilot");
    f1_ln(lb, lbn, "POLICY-DECLARED 2026-09-23 frozen; F2 is measured against these bounds");
    f1_ln(lb, lbn, "POLICY ROUTER: .pcm n=16384->PITCH n=8192->TIMBRE else UNKNOWN; .img 64x64 per-half variance->COLORDISC|COLORCONST; .vid->MOTION");
    f1_ln(lb, lbn, "POLICY PITCH: halves A=[0:8192) B=[8192:16384); first-pass window=first 2048 samples of each half; freq=interpolated zero-crossing; rel_ppm=|fB-fA|*1e6/fA; SAME iff rel_ppm<20000 else HIGHER|LOWER");
    f1_ln(lb, lbn, "POLICY TIMBRE: window=first 2048 samples; hp1000=1000*sum|x[i]-x[i-1]|/sum|x|; PURE<=67<DARK<=82<RICH<=110<BRIGHT");
    f1_ln(lb, lbn, "POLICY COLORDISC: halves x<w/2,x>=w/2; mean RGB per half; euclid distance of means; SAME iff dist<40 else DIFFERENT");
    f1_ln(lb, lbn, "POLICY COLORCONST: white-patch illuminant=per-half max RGB; discounted=255*mean/max per channel; SAME_SURFACE iff max channel disc-diff<8 else DIFFERENT");
    f1_ln(lb, lbn, "POLICY MOTION: frames 0 and 7 only; brightness-weighted centroid (b>16); displacement in Q6 subpixels; STILL iff max(|dx|,|dy|)<128 else 8-way by dominant axis");
    f1_ln(lb, lbn, "LOSS PITCH: pitch events confined to samples [2048:8192) of either half are invisible (late-onset omission); sub-2% pitch differences destroyed by the 20000ppm gate");
    f1_ln(lb, lbn, "LOSS TIMBRE: timbre changes after sample 2048 are invisible; hp1000 bands quantize the timbre continuum");
    f1_ln(lb, lbn, "LOSS COLORDISC: color differences <40 units destroyed by the gate; variance-routed flat patches only");
    f1_ln(lb, lbn, "LOSS COLORCONST: single-pixel max-RGB corruption propagates to the whole-panel illuminant estimate; discount-identical surfaces under different absolute levels collide");
    f1_ln(lb, lbn, "LOSS MOTION: 6 of 8 frames never examined; small-target motion is invisible to the global centroid; the centroid follows the brightest mass (distractor capture)");
    f1_ln(lb, lbn, "LOSS ROUTER: unsupported .pcm lengths install nothing (no percept)");
    // manifest binding
    let fd:i64 = f1_open_ro(mpath);
    let nn:*i32 = _zag_malloc(4) as *i32;
    let mb:[]u8 = f1_read_all(fd, 65536, nn);
    f1_close(fd);
    let h32:[]u8 = nio_alloc(32);
    f1_sha(mb[0..nn[0]], h32);
    f1_lbs(lb, lbn, "MANIFEST path=");
    f1_lbs(lb, lbn, mpath);
    f1_lbs(lb, lbn, " sha256=");
    f1_lbhex(lb, lbn, h32);
    f1_lb8(lb, lbn, 10);
    // GENESIS: entry = sha256(zeros32 || header-bytes-so-far)
    let cb:[]u8 = nio_alloc(32 + (lbn[0] as i32));
    let ci:i32 = 0;
    while(ci < 32) { cb[ci] = 0; ci = ci + 1; }
    ci = 0;
    while(ci < (lbn[0] as i32)) { cb[32 + ci] = lb[ci]; ci = ci + 1; }
    let entry:[]u8 = nio_alloc(32);
    f1_sha(cb[0..32 + (lbn[0] as i32)], entry);
    f1_lbs(lb, lbn, "GENESIS prev=");
    f1_lbhex(lb, lbn, prev32);
    f1_lbs(lb, lbn, " entry=");
    f1_lbhex(lb, lbn, entry);
    f1_lb8(lb, lbn, 10);
    ci = 0;
    while(ci < 32) { prev32[ci] = entry[ci]; ci = ci + 1; }
    return;
}

fn main()i32 {
    // _zag_arg(0) is the program name (argv[0]); user args start at 1
    // usage: f1 <manifest> <fixtures-root> <ledger-out>
    // manifest entries are relative paths resolved under <fixtures-root>
    let mpath:[]u8 = _zag_arg(1);
    let froot:[]u8 = _zag_arg(2);
    let lpath:[]u8 = _zag_arg(3);
    if(mpath.len == 0) {
        _zag_println("usage: f1 <manifest> <fixtures-root> <ledger-out>");
        return 64;
    }
    if(froot.len == 0) {
        _zag_println("usage: f1 <manifest> <fixtures-root> <ledger-out>");
        return 64;
    }
    if(lpath.len == 0) {
        _zag_println("usage: f1 <manifest> <fixtures-root> <ledger-out>");
        return 64;
    }
    let lb:[]u8 = nio_alloc(1048576);
    if(lb.len == 0) {
        _zag_println("f1: ledger arena alloc failed");
        return 1;
    }
    let lbn:*i64 = _zag_malloc(8) as *i64;
    lbn[0] = 0;
    let prev32:[]u8 = nio_alloc(32);
    f1_write_header(lb, lbn, mpath, prev32);

    let fd:i64 = f1_open_ro(mpath);
    if(fd < 0) {
        _zag_println("f1: cannot open manifest");
        return 2;
    }
    let nn:*i32 = _zag_malloc(4) as *i32;
    let mb:[]u8 = f1_read_all(fd, 65536, nn);
    f1_close(fd);
    let mn:i32 = nn[0];

    let epn:i64 = 0;
    let correct:*i64 = _zag_malloc(8) as *i64;
    correct[0] = 0;
    let opssum:*i64 = _zag_malloc(8) as *i64;
    opssum[0] = 0;

    let i:i32 = 0;
    while(i < mn) {
        let s2:i32 = i;
        let eol:i32 = 0;
        while(eol == 0) {
            if(i >= mn) { eol = 1; }
            else {
                if(mb[i] == 10) { eol = 1; }
                else { i = i + 1; }
            }
        }
        let e2:i32 = i;
        if(i < mn) { i = i + 1; }
        if(e2 > s2) {
            let rel:[]u8 = mb[s2..e2];
            // full = froot + "/" + rel
            let full:[]u8 = nio_alloc(froot.len + 1 + rel.len);
            let k:i32 = 0;
            while(k < froot.len) { full[k] = froot[k]; k = k + 1; }
            full[froot.len] = 47;
            k = 0;
            while(k < rel.len) { full[froot.len + 1 + k] = rel[k]; k = k + 1; }
            let erc:i32 = f1_episode(lb, lbn, prev32, full, rel, epn, correct, opssum);
            if(erc != 0) { return erc; }
            epn = epn + 1;
        }
    }

    let lfd:i64 = f1_open_wo(lpath);
    if(lfd < 0) {
        _zag_println("f1: cannot open ledger for write");
        return 3;
    }
    f1_write_all(lfd, lb[0..(lbn[0] as i32)]);
    f1_close(lfd);

    let sb:[]u8 = nio_alloc(1024);
    let sbn:*i64 = _zag_malloc(8) as *i64;
    sbn[0] = 0;
    f1_lbs(sb, sbn, "SUMMARY fixtures=");
    f1_lbi(sb, sbn, epn);
    f1_lbs(sb, sbn, " correct=");
    f1_lbi(sb, sbn, correct[0]);
    f1_lbs(sb, sbn, " wrong=");
    f1_lbi(sb, sbn, epn - correct[0]);
    f1_lbs(sb, sbn, " ops_total=");
    f1_lbi(sb, sbn, opssum[0]);
    f1_lbs(sb, sbn, " chain_head=");
    f1_lbhex(sb, sbn, prev32);
    f1_lbs(sb, sbn, " ledger_bytes=");
    f1_lbi(sb, sbn, lbn[0]);
    f1_emit(sb[0..(sbn[0] as i32)]);
    return 0;
}

// f1.zag — bit-exact Zag port of forks/autopilot/gen/ref_f1.py.
// FROZEN F1 SAMPLING POLICY (also in ref_f1.py docstring):
//   PITCH/TIMBRE/COLORDISC/COLORCONST/MOTION as documented there.
// Integer law: `/` truncates toward zero (= tdiv); `>>` on negatives is
// arithmetic (floor). All accumulators i64. Must match ref_f1.py on every
// fixture bit-for-bit (labels, conf, detail ints, ops).
@import("fio.zag")

const T_UNKNOWN:i32=0;
const T_PITCH:i32=1;
const T_TIMBRE:i32=2;
const T_COLORDISC:i32=3;
const T_COLORCONST:i32=4;
const T_MOTION:i32=5;

const L_NONE:i32=0;
const L_SAME:i32=1;
const L_HIGHER:i32=2;
const L_LOWER:i32=3;
const L_PURE:i32=4;
const L_DARK:i32=5;
const L_RICH:i32=6;
const L_BRIGHT:i32=7;
const L_DIFFERENT:i32=8;
const L_SAMESURF:i32=9;
const L_E:i32=10;
const L_W:i32=11;
const L_N:i32=12;
const L_S:i32=13;
const L_NE:i32=14;
const L_NW:i32=15;
const L_SE:i32=16;
const L_SW:i32=17;
const L_STILL:i32=18;

struct Pc { task:i32; label:i32; conf:i32; ev:i32; d0:i64; d1:i64; d2:i64; ops:i64; }

fn f1_label_str(l:i32)[]u8 {
    if(l==L_SAME){return "SAME";}
    if(l==L_HIGHER){return "HIGHER";}
    if(l==L_LOWER){return "LOWER";}
    if(l==L_PURE){return "PURE";}
    if(l==L_DARK){return "DARK";}
    if(l==L_RICH){return "RICH";}
    if(l==L_BRIGHT){return "BRIGHT";}
    if(l==L_DIFFERENT){return "DIFFERENT";}
    if(l==L_SAMESURF){return "SAME_SURFACE";}
    if(l==L_E){return "E";}
    if(l==L_W){return "W";}
    if(l==L_N){return "N";}
    if(l==L_S){return "S";}
    if(l==L_NE){return "NE";}
    if(l==L_NW){return "NW";}
    if(l==L_SE){return "SE";}
    if(l==L_SW){return "SW";}
    if(l==L_STILL){return "STILL";}
    return "NONE";
}
fn f1_task_str(t:i32)[]u8 {
    if(t==T_PITCH){return "PITCH";}
    if(t==T_TIMBRE){return "TIMBRE";}
    if(t==T_COLORDISC){return "COLORDISC";}
    if(t==T_COLORCONST){return "COLORCONST";}
    if(t==T_MOTION){return "MOTION";}
    return "UNKNOWN";
}
fn f1_isqrt(n:i64)i64 {
    if(n<=0){return 0;}
    let bl:i32=0;let tmp:i64=n;
    while(tmp>0){bl=bl+1;tmp=tmp>>1;}
    let x:i64=(1 as i64)<<((bl+1)/2);
    let guard:i32=0;
    while(guard<200){
        let y:i64=(x+n/x)/2;
        if(y>=x){return x;}
        x=y;guard=guard+1;
    }
    return x;
}
// samples live in byte arena b at [off, off+n) as i16 LE
fn f1_zc_freq(b:[]u8,off:i32,n:i32,rate:i64,ops:*i64)i64 {
    let prev:i64=f_gi16(b,off) as i64;
    let first:i64=-1;let last:i64=-1;let count:i64=0;
    ops.*=ops.*+1;
    let i:i32=1;
    while(i<n){
        let cur:i64=f_gi16(b,off+i*2) as i64;
        ops.*=ops.*+1;
        let cross:i32=0;
        if(prev<0 && cur>=0){cross=1;}
        if(prev>0 && cur<=0){cross=1;}
        if(cross==1){
            let num:i64=f_abs64(prev);let den:i64=num+f_abs64(cur);
            let pos:i64=((i-1) as i64)*65536+(num*65536)/den;
            if(first<0){first=pos;}
            last=pos;count=count+1;
        }
        prev=cur;i=i+1;
    }
    if(count<2 || last<=first){return 0;}
    let num2:i64=(count-1)*rate*65536;
    let den2:i64=2*(last-first);
    return num2/den2;
}
fn f1_pitch(b:[]u8,rate:i64,p:*Pc)void {
    let fA:i64=f1_zc_freq(b,8,2048,rate,&p.*.ops);
    let fB:i64=f1_zc_freq(b,8+8192*2,2048,rate,&p.*.ops);
    p.*.d0=fA;p.*.d1=fB;
    if(fA<=0){p.*.label=L_SAME;p.*.conf=0;p.*.d2=0;return;}
    let rel:i64=(f_abs64(fB-fA)*1000000)/fA;
    p.*.d2=rel;
    if(rel<20000){p.*.label=L_SAME;}
    else if(fB>fA){p.*.label=L_HIGHER;}
    else {p.*.label=L_LOWER;}
    let c:i64=(f_abs64(rel-20000)*1000)/20000;
    if(c>1000){c=1000;}
    p.*.conf=c as i32;
}
fn f1_timbre(b:[]u8,p:*Pc)void {
    let et:i64=0;let i:i32=0;
    while(i<2048){et=et+f_abs64(f_gi16(b,8+i*2) as i64);i=i+1;}
    p.*.ops=p.*.ops+2048;
    let eh:i64=0;let prev:i64=f_gi16(b,8) as i64;i=1;
    while(i<2048){
        let v:i64=f_gi16(b,8+i*2) as i64;
        eh=eh+f_abs64(v-prev);prev=v;i=i+1;
        p.*.ops=p.*.ops+1;
    }
    let hp:i64=(eh*1000)/f_max64(et,1);
    p.*.d0=hp;
    if(hp<=67){p.*.label=L_PURE;}
    else if(hp<=82){p.*.label=L_DARK;}
    else if(hp<=110){p.*.label=L_RICH;}
    else {p.*.label=L_BRIGHT;}
    let m:i64=f_abs64(hp-67);
    let m2:i64=f_abs64(hp-82);if(m2<m){m=m2;}
    let m3:i64=f_abs64(hp-110);if(m3<m){m=m3;}
    let c:i64=(m*1000)/60;
    if(c>1000){c=1000;}
    p.*.conf=c as i32;
}
// halves stats: out via parallel arrays in caller; here fill the 6 means/maxs
fn f1_halves(b:[]u8,w:i32,h:i32,mean1:*i64,mean2:*i64,mx1:*i64,mx2:*i64,vr:*i64,ops:*i64)void {
    let n:i64=((w/2) as i64)*(h as i64);
    let s1r:i64=0;let s1g:i64=0;let s1b:i64=0;
    let s2r:i64=0;let s2g:i64=0;let s2b:i64=0;
    let q1r:i64=0;let q1g:i64=0;let q1b:i64=0;
    let q2r:i64=0;let q2g:i64=0;let q2b:i64=0;
    let x1r:i64=0;let x1g:i64=0;let x1b:i64=0;
    let x2r:i64=0;let x2g:i64=0;let x2b:i64=0;
    let y:i32=0;
    while(y<h){
        let x:i32=0;
        while(x<w){
            let o:i32=8+(y*w+x)*3;
            let r:i64=b[o] as i64;let g:i64=b[o+1] as i64;let bl:i64=b[o+2] as i64;
            ops.*=ops.*+1;
            if(x<w/2){
                s1r=s1r+r;s1g=s1g+g;s1b=s1b+bl;
                q1r=q1r+r*r;q1g=q1g+g*g;q1b=q1b+bl*bl;
                if(r>x1r){x1r=r;} if(g>x1g){x1g=g;} if(bl>x1b){x1b=bl;}
            } else {
                s2r=s2r+r;s2g=s2g+g;s2b=s2b+bl;
                q2r=q2r+r*r;q2g=q2g+g*g;q2b=q2b+bl*bl;
                if(r>x2r){x2r=r;} if(g>x2g){x2g=g;} if(bl>x2b){x2b=bl;}
            }
            x=x+1;
        }
        y=y+1;
    }
    let a0:i64=s1r/n;let a1:i64=s1g/n;let a2:i64=s1b/n;
    let c0:i64=s2r/n;let c1:i64=s2g/n;let c2:i64=s2b/n;
    mean1[0]=a0;mean1[1]=a1;mean1[2]=a2;
    mean2[0]=c0;mean2[1]=c1;mean2[2]=c2;
    mx1[0]=x1r;mx1[1]=x1g;mx1[2]=x1b;
    mx2[0]=x2r;mx2[1]=x2g;mx2[2]=x2b;
    let v1:i64=q1r/n-a0*a0;let t:i64=q1g/n-a1*a1;if(t>v1){v1=t;} t=q1b/n-a2*a2;if(t>v1){v1=t;}
    let v2:i64=q2r/n-c0*c0;t=q2g/n-c1*c1;if(t>v2){v2=t;} t=q2b/n-c2*c2;if(t>v2){v2=t;}
    vr[0]=v1;vr[1]=v2;
}
fn f1_colordisc(b:[]u8,w:i32,h:i32,p:*Pc)void {
    let mp:*i64=_zag_malloc(112) as *i64;
    let m1:[]i64=mp[0..3];let m2:[]i64=mp[3..6];
    let x1:[]i64=mp[6..9];let x2:[]i64=mp[9..12];
    let vr:[]i64=mp[12..14];
    f1_halves(b,w,h,&m1[0],&m2[0],&x1[0],&x2[0],&vr[0],&p.*.ops);
    let d2:i64=(m1[0]-m2[0])*(m1[0]-m2[0])+(m1[1]-m2[1])*(m1[1]-m2[1])+(m1[2]-m2[2])*(m1[2]-m2[2]);
    let dist:i64=f1_isqrt(d2);
    p.*.d0=dist;
    if(dist<40){p.*.label=L_SAME;} else {p.*.label=L_DIFFERENT;}
    let c:i64=(f_abs64(dist-40)*1000)/40;
    if(c>1000){c=1000;}
    p.*.conf=c as i32;
    _zag_free(mp as *i8);
}
fn f1_colorconst(b:[]u8,w:i32,h:i32,p:*Pc)void {
    let mp:*i64=_zag_malloc(112) as *i64;
    let m1:[]i64=mp[0..3];let m2:[]i64=mp[3..6];
    let x1:[]i64=mp[6..9];let x2:[]i64=mp[9..12];
    let vr:[]i64=mp[12..14];
    f1_halves(b,w,h,&m1[0],&m2[0],&x1[0],&x2[0],&vr[0],&p.*.ops);
    let md:i64=0;let c:i32=0;
    while(c<3){
        let d1:i64=(m1[c]*255)/f_max64(x1[c],1);
        let d2:i64=(m2[c]*255)/f_max64(x2[c],1);
        let dd:i64=f_abs64(d1-d2);
        if(dd>md){md=dd;}
        c=c+1;
    }
    p.*.d0=md;
    if(md<8){p.*.label=L_SAMESURF;} else {p.*.label=L_DIFFERENT;}
    let cf:i64=(f_abs64(md-8)*1000)/8;
    if(cf>1000){cf=1000;}
    p.*.conf=cf as i32;
    _zag_free(mp as *i8);
}
fn f1_cent(b:[]u8,w:i32,h:i32,fr:i32,outx:*i64,outy:*i64,ops:*i64)void {
    let sx:i64=0;let sy:i64=0;let sw:i64=0;
    let y:i32=0;
    while(y<h){
        let x:i32=0;
        while(x<w){
            let o:i32=12+fr*w*h*3+(y*w+x)*3;
            let bv:i64=((b[o] as i64)+(b[o+1] as i64)+(b[o+2] as i64))/3;
            ops.*=ops.*+1;
            if(bv>16){sx=sx+(x as i64)*bv;sy=sy+(y as i64)*bv;sw=sw+bv;}
            x=x+1;
        }
        y=y+1;
    }
    if(sw==0){outx.*=0;outy.*=0;return;}
    outx.*=(sx*64)/sw;outy.*=(sy*64)/sw;
}
// flattened 8-way decision; mirrors ref_f1.py exactly
fn f1_mdir(dx:i64,dy:i64)i32 {
    let ax:i64=f_abs64(dx);let ay:i64=f_abs64(dy);
    if(f_max64(ax,ay)<128){return L_STILL;}
    if(ax>=2*ay){if(dx>0){return L_E;} return L_W;}
    if(ay>=2*ax){if(dy>0){return L_S;} return L_N;}
    if(dy>0 && dx>0){return L_SE;}
    if(dy>0 && dx<=0){return L_SW;}
    if(dy<=0 && dx>0){return L_NE;}
    return L_NW;
}
fn f1_motion(b:[]u8,w:i32,h:i32,nf:i32,p:*Pc)void {
    let x0:i64=0;let y0:i64=0;let x1:i64=0;let y1:i64=0;
    f1_cent(b,w,h,0,&x0,&y0,&p.*.ops);
    f1_cent(b,w,h,nf-1,&x1,&y1,&p.*.ops);
    let dx:i64=x1-x0;let dy:i64=y1-y0;
    p.*.d0=dx;p.*.d1=dy;
    p.*.label=f1_mdir(dx,dy);
    let c:i64=(f_max64(f_abs64(dx),f_abs64(dy))*1000)/512;
    if(c>1000){c=1000;}
    p.*.conf=c as i32;
}
// route + perceive; fills p; returns 0 ok, -1 unsupported
fn f1_perceive(path:[]u8,b:[]u8,p:*Pc)i32 {
    p.*.task=T_UNKNOWN;p.*.label=L_NONE;p.*.conf=0;p.*.ev=1;
    p.*.d0=0;p.*.d1=0;p.*.d2=0;p.*.ops=0;
    if(f_ends(path,".pcm")==1){
        let rate:i64=f_gu32(b,0);let n:i64=f_gu32(b,4);
        if(n==16384){p.*.task=T_PITCH;f1_pitch(b,rate,p);}
        else if(n==8192){p.*.task=T_TIMBRE;f1_timbre(b,p);}
        else {return -1;}
        return 0;
    }
    if(f_ends(path,".img")==1){
        let w:i32=f_gu32(b,0) as i32;let h:i32=f_gu32(b,4) as i32;
        let mp:*i64=_zag_malloc(112) as *i64;
        let m1:[]i64=mp[0..3];let m2:[]i64=mp[3..6];
        let x1:[]i64=mp[6..9];let x2:[]i64=mp[9..12];
        let vr:[]i64=mp[12..14];
        f1_halves(b,w,h,&m1[0],&m2[0],&x1[0],&x2[0],&vr[0],&p.*.ops);
        let flat:i32=0;
        if(f_max64(vr[0],vr[1])<1){flat=1;}
        _zag_free(mp as *i8);
        if(flat==1){p.*.task=T_COLORDISC;f1_colordisc(b,w,h,p);}
        else {p.*.task=T_COLORCONST;f1_colorconst(b,w,h,p);}
        return 0;
    }
    if(f_ends(path,".vid")==1){
        let nf:i32=f_gu32(b,0) as i32;let w:i32=f_gu32(b,4) as i32;let h:i32=f_gu32(b,8) as i32;
        p.*.task=T_MOTION;f1_motion(b,w,h,nf,p);
        return 0;
    }
    return -1;
}

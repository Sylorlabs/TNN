// t1.zag — bit-exactness driver: runs f1_perceive on argv fixtures,
// prints RESULT lines in ref_f1.py's format for diffing.
@import("f1.zag")

fn main()i32 {
    let i:i32=1;
    while(1==1){
        let path:[]u8=_zag_arg(i);
        if(path.len==0){break;}
        let flen:i32=0;
        let b:[]u8=f_read_all(path,&flen);
        if(flen<0){
            _zag_print("RESULT fixture=");_zag_print(path);
            _zag_println(" task=UNKNOWN percept=NONE conf=0 ops=0 read_error");
            i=i+1;continue;
        }
        let pc:Pc=Pc{.task=0,.label=0,.conf=0,.ev=0,.d0=0,.d1=0,.d2=0,.ops=0};
        let rc:i32=f1_perceive(path,b,&pc);
        _zag_print("RESULT fixture=");_zag_print(path);
        _zag_print(" task=");_zag_print(f1_task_str(pc.task));
        _zag_print(" percept=");_zag_print(f1_label_str(pc.label));
        _zag_print(" conf=");_zag_print(f_i64s(pc.conf as i64));
        _zag_print(" ops=");_zag_print(f_i64s(pc.ops));
        if(pc.task==T_PITCH){
            _zag_print(" fA=");_zag_print(f_i64s(pc.d0));
            _zag_print(" fB=");_zag_print(f_i64s(pc.d1));
            _zag_print(" rel_ppm=");_zag_print(f_i64s(pc.d2));
        }
        if(pc.task==T_TIMBRE){_zag_print(" hp1000=");_zag_print(f_i64s(pc.d0));}
        if(pc.task==T_COLORDISC){_zag_print(" dist=");_zag_print(f_i64s(pc.d0));}
        if(pc.task==T_COLORCONST){_zag_print(" maxdisc=");_zag_print(f_i64s(pc.d0));}
        if(pc.task==T_MOTION){
            _zag_print(" dx_q6=");_zag_print(f_i64s(pc.d0));
            _zag_print(" dy_q6=");_zag_print(f_i64s(pc.d1));
        }
        _zag_println("");
        nio_free(b);
        i=i+1;
    }
    return 0;
}

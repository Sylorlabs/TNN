// method2.zag — SECOND differencing method for motiondir (block matching).
//
// Independent percept computation to corroborate against the centroid-track
// method in sense.zag: local block correlation vs global difference-mask
// centroid. Integer-only, zero RNG, deterministic.
//
// CLI: method2 <fixture.vid>
// stdout: key=value lines: approach=A2, task=motiondir, judgment=<9-way>,
//   confidence=0..1000, ops=<n>, debug_vec=sx=..;sy=..;mag=..;nb=..;
// Judgment rule (frozen, matches the rematch-T4 fitted rule):
//   STILL iff mag < 1, else the sense.zag octant rule on the vote vector.
// Confidence: 1000*|mag-1|/(|mag-1|+4) (same margin form, fitted bar).

@import("R33_NATIVE_IO_V1.zag")

// ---------------- little-endian accessors over []u8 arenas ----------------
fn t_put32(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
}
fn t_put64(b:[]u8, at:i32, v:i64) void {
    b[at] = (v & 255) as u8;
    b[at+1] = ((v >> 8) & 255) as u8;
    b[at+2] = ((v >> 16) & 255) as u8;
    b[at+3] = ((v >> 24) & 255) as u8;
    b[at+4] = ((v >> 32) & 255) as u8;
    b[at+5] = ((v >> 40) & 255) as u8;
    b[at+6] = ((v >> 48) & 255) as u8;
    b[at+7] = ((v >> 56) & 255) as u8;
}
fn t_get32(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24);
}
fn t_get64(b:[]u8, at:i32) i64 {
    return (b[at] as i64) | ((b[at+1] as i64) << 8)
         | ((b[at+2] as i64) << 16) | ((b[at+3] as i64) << 24)
         | ((b[at+4] as i64) << 32) | ((b[at+5] as i64) << 40)
         | ((b[at+6] as i64) << 48) | ((b[at+7] as i64) << 56);
}
fn op_add(op:[]u8, n:i64) void {
    t_put64(op, 0, t_get64(op, 0) + n);
}
fn isqrt(x:i64) i64 {
    if(x <= 0) { return 0; }
    if(x == 1) { return 1; }
    let r:i64 = x;
    if(r > 3037000499) { r = 3037000499; }
    let y:i64 = (r + 1) / 2;
    while(y < r) { r = y; y = (r + x / r) / 2; }
    return r;
}
fn iabs(x:i64) i64 {
    if(x < 0) { return 0 - x; }
    return x;
}
fn imin(a:i64, b:i64) i64 {
    if(a < b) { return a; }
    return b;
}
fn imax(a:i64, b:i64) i64 {
    if(a > b) { return a; }
    return b;
}
fn z_cstr(s:[]u8) []u8 {
    if(s.len < 1 || s.len > 4095) { return ""; }
    let b:[]u8 = nio_alloc(s.len + 1);
    if(b.len == 0) { return b; }
    let i:i32 = 0;
    while(i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0;
    return b;
}
fn z_read(path:[]u8, out:[]u8, max:i32) i64 {
    let s:[]u8 = z_cstr(path);
    if(s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(s) as i64, 0, 0, 0, 0, 0);
    nio_free(s);
    if(fd < 0) { return -7402; }
    let n:i64 = nio_read_exact(fd, out, max);
    nio_close(fd);
    return n;
}
fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn ob_pair(ob:[]u8, pos:i32, name:[]u8, v:i64) i32 {
    pos = ob_add(ob, pos, name);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, _zag_i64_to_str(v));
    pos = ob_add(ob, pos, ";");
    return pos;
}
fn fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "A2");
    pos = ob_kv(ob, pos, "task", "motiondir");
    pos = ob_kv(ob, pos, "error", reason);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}
fn lum16(lum:[]u8, at:i32) i64 {
    return (lum[at] as i64) | ((lum[at+1] as i64) << 8);
}

// Block-matching motion: 8x8 blocks, stride 8, search radius 3 (SAD on
// luminance r+g+b, edge-clamped). Aggregate winning offsets -> (sx, sy).
fn task_motion_bm(buf:[]u8, n:i32, op:[]u8, ob:[]u8, pos:i32) i32 {
    let nf:i32 = t_get32(buf, 0) as i32;
    let w:i32 = t_get32(buf, 4) as i32;
    let h:i32 = t_get32(buf, 8) as i32;
    if(nf < 2 || nf > 1024) { return -1; }
    if(w < 8 || h < 8 || w > 512 || h > 512) { return -1; }
    let fsz:i64 = (w as i64) * (h as i64) * 3;
    if(12 + (nf as i64) * fsz > n as i64) { return -1; }
    let npx:i64 = (w as i64) * (h as i64);
    if((nf as i64) * npx > 8388608) { return -1; }
    // luminance planes, u16 LE
    let lum:[]u8 = nio_alloc(((nf as i64) * npx * 2) as i32);
    if(lum.len == 0) { return -1; }
    let t:i32 = 0;
    while(t < nf) {
        let p:i32 = 0;
        while(p < npx as i32) {
            let o:i32 = (12 + (t as i64) * fsz + (p as i64) * 3) as i32;
            let l:i64 = (buf[o] as i64) + (buf[o+1] as i64) + (buf[o+2] as i64);
            let at:i32 = ((t as i64) * npx * 2 + (p as i64) * 2) as i32;
            lum[at] = (l & 255) as u8;
            lum[at+1] = ((l >> 8) & 255) as u8;
            p = p + 1;
        }
        op_add(op, npx);
        t = t + 1;
    }
    let nbx:i32 = w / 8;
    let nby:i32 = h / 8;
    let sx:i64 = 0;
    let sy:i64 = 0;
    let nb:i64 = 0;
    t = 0;
    while(t < nf - 1) {
        let by:i32 = 0;
        while(by < nby) {
            let bx:i32 = 0;
            while(bx < nbx) {
                let best_sad:i64 = 0;
                let best_ox:i32 = 0;
                let best_oy:i32 = 0;
                let best_abs:i32 = 0;
                let first:i32 = 1;
                let oy:i32 = -3;
                while(oy <= 3) {
                    let ox:i32 = -3;
                    while(ox <= 3) {
                        let sad:i64 = 0;
                        let v:i32 = 0;
                        while(v < 8) {
                            let u:i32 = 0;
                            while(u < 8) {
                                let x0:i32 = bx * 8 + u;
                                let y0:i32 = by * 8 + v;
                                let x1:i32 = imin(imax(x0 + ox, 0), w - 1);
                                let y1:i32 = imin(imax(y0 + oy, 0), h - 1);
                                let a0:i32 = ((t as i64) * npx * 2
                                    + (y0 as i64) * (w as i64) * 2
                                    + (x0 as i64) * 2) as i32;
                                let a1:i32 = (((t + 1) as i64) * npx * 2
                                    + (y1 as i64) * (w as i64) * 2
                                    + (x1 as i64) * 2) as i32;
                                sad = sad + iabs(lum16(lum, a1) - lum16(lum, a0));
                                u = u + 1;
                            }
                            v = v + 1;
                        }
                        op_add(op, 128);
                        let ab:i32 = (iabs(ox as i64) + iabs(oy as i64)) as i32;
                        let take:i32 = 0;
                        if(first == 1) { take = 1; }
                        if(first == 0 && sad < best_sad) { take = 1; }
                        if(first == 0 && sad == best_sad && ab < best_abs) { take = 1; }
                        if(first == 0 && sad == best_sad && ab == best_abs && ox < best_ox) { take = 1; }
                        if(first == 0 && sad == best_sad && ab == best_abs && ox == best_ox && oy < best_oy) { take = 1; }
                        if(take == 1) {
                            best_sad = sad;
                            best_ox = ox;
                            best_oy = oy;
                            best_abs = ab;
                            first = 0;
                        }
                        ox = ox + 1;
                    }
                    oy = oy + 1;
                }
                sx = sx + (best_ox as i64);
                sy = sy + (best_oy as i64);
                nb = nb + 1;
                bx = bx + 1;
            }
            by = by + 1;
        }
        t = t + 1;
    }
    nio_free(lum);
    let mag:i64 = isqrt(sx * sx + sy * sy);
    op_add(op, 2);
    // judgment: STILL iff mag < 1, else sense.zag octant rule on (sx, sy)
    let dir:i32 = 0;
    if(mag >= 1) {
        let ax:i64 = iabs(sx);
        let ay:i64 = iabs(sy);
        if(ax >= 2 * ay) {
            dir = 3;
            if(sx < 0) { dir = 7; }
        }
        if(ay >= 2 * ax) {
            dir = 5;
            if(sy < 0) { dir = 1; }
        }
        if(ax < 2 * ay && ay < 2 * ax) {
            dir = 4;
            if(sx < 0 && sy > 0) { dir = 6; }
            if(sx > 0 && sy < 0) { dir = 2; }
            if(sx < 0 && sy < 0) { dir = 8; }
        }
    }
    if(dir == 0) { pos = ob_kv(ob, pos, "judgment", "STILL"); }
    if(dir == 1) { pos = ob_kv(ob, pos, "judgment", "N"); }
    if(dir == 2) { pos = ob_kv(ob, pos, "judgment", "NE"); }
    if(dir == 3) { pos = ob_kv(ob, pos, "judgment", "E"); }
    if(dir == 4) { pos = ob_kv(ob, pos, "judgment", "SE"); }
    if(dir == 5) { pos = ob_kv(ob, pos, "judgment", "S"); }
    if(dir == 6) { pos = ob_kv(ob, pos, "judgment", "SW"); }
    if(dir == 7) { pos = ob_kv(ob, pos, "judgment", "W"); }
    if(dir == 8) { pos = ob_kv(ob, pos, "judgment", "NW"); }
    let mg:i64 = iabs(mag - 1);
    pos = ob_kint(ob, pos, "confidence", 1000 * mg / (mg + 4));
    pos = ob_add(ob, pos, "debug_vec=");
    pos = ob_pair(ob, pos, "sx", sx);
    pos = ob_pair(ob, pos, "sy", sy);
    pos = ob_pair(ob, pos, "mag", mag);
    pos = ob_pair(ob, pos, "nb", nb);
    pos = ob_add(ob, pos, "\n");
    return pos;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if(a1.len == 0) { return fail("no_fixture"); }
    let buf:[]u8 = nio_alloc(8388608);
    if(buf.len == 0) { return fail("alloc_failed"); }
    let n:i64 = z_read(a1, buf, 8388608);
    if(n < 12) { return fail("read_failed"); }
    let op:[]u8 = nio_alloc(8);
    if(op.len == 0) { return fail("alloc_failed"); }
    let ob:[]u8 = nio_alloc(4096);
    if(ob.len == 0) { return fail("alloc_failed"); }
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "approach", "A2");
    pos = ob_kv(ob, pos, "task", "motiondir");
    let np2:i32 = task_motion_bm(buf, n as i32, op, ob, pos);
    if(np2 < 0) { return fail("task_failed"); }
    pos = np2;
    pos = ob_kint(ob, pos, "ops", t_get64(op, 0));
    if(nio_write_all(1, ob[0..pos]) != pos as i64) { return fail("write_failed"); }
    return 0;
}

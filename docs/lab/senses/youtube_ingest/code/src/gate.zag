// gate.zag — corroboration gate for video-percept install decisions.
//
// Decides, from 2+ independent direction judgments on the same clip,
// whether the percept is corroborated (CANDIDATE) or must be withheld.
// Pure Zag, zero RNG, deterministic.
//
// CLI: gate <variant> <clip> <j1> <c1> [<j2> <c2> ...]
//   variant in TEMP SPAT METH (2 pairs) or ALL (6 pairs:
//   temporal pair, spatial pair, method pair, in that order)
//   judgments: the 9 direction strings; confidences: 0..1000 ints.
// stdout:
//   gate=<variant>, clip=<clip>, n=<pairs>
//   corroborated=<0|1>
//   judgment=<agreed J or NONE>
//   confidence=<min-c of pairs or -1>
//   decision=<CANDIDATE|WITHHOLD>
//   reason=<agree|temp_disagree|spat_disagree|meth_disagree|cross_disagree>
// Agreement = byte-identical judgment strings across the checked pairs.

@import("R33_NATIVE_IO_V1.zag")

fn ob_add(ob:[]u8, pos:i32, s:[]u8) i32 {
    let i:i32 = 0;
    while(i < s.len) {
        if(pos >= ob.len) { return pos; }
        ob[pos] = s[i];
        pos = pos + 1;
        i = i + 1;
    }
    return pos;
}
fn ob_kv(ob:[]u8, pos:i32, k:[]u8, v:[]u8) i32 {
    pos = ob_add(ob, pos, k);
    pos = ob_add(ob, pos, "=");
    pos = ob_add(ob, pos, v);
    pos = ob_add(ob, pos, "\n");
    return pos;
}
fn ob_kint(ob:[]u8, pos:i32, k:[]u8, v:i64) i32 {
    return ob_kv(ob, pos, k, _zag_i64_to_str(v));
}
fn parse_i64(s:[]u8) i64 {
    let v:i64 = 0;
    let i:i32 = 0;
    while(i < s.len) {
        let c:i64 = s[i] as i64;
        if(c >= 48 && c <= 57) { v = v * 10 + (c - 48); }
        i = i + 1;
    }
    return v;
}
fn emit_fail(reason:[]u8) i32 {
    let ob:[]u8 = nio_alloc(256);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "gate", "ERR");
    pos = ob_kv(ob, pos, "error", reason);
    nio_write_all(1, ob[0..pos]);
    nio_free(ob);
    return 1;
}

fn main() i32 {
    let vv:[]u8 = _zag_arg(1);
    let clip:[]u8 = _zag_arg(2);
    if(vv.len == 0 || clip.len == 0) { return emit_fail("no_args"); }
    let vid:i32 = 0;
    if(_zag_strcmp(vv, "TEMP") == 1) { vid = 1; }
    if(_zag_strcmp(vv, "SPAT") == 1) { vid = 2; }
    if(_zag_strcmp(vv, "METH") == 1) { vid = 3; }
    if(_zag_strcmp(vv, "ALL") == 1) { vid = 4; }
    if(vid == 0) { return emit_fail("bad_variant"); }
    let npairs:i32 = 2;
    if(vid == 4) { npairs = 6; }
    // need 2 + 2*npairs args
    let j0:[]u8 = _zag_arg(3);
    let c0:i64 = parse_i64(_zag_arg(4));
    if(j0.len == 0) { return emit_fail("no_pairs"); }
    let agree:i32 = 1;
    let minc:i64 = c0;
    // pair boundaries for ALL: pairs (0,1)=temporal (2,3)=spatial (4,5)=method
    let p0eq:i32 = 1;
    let p1eq:i32 = 1;
    let p2eq:i32 = 1;
    let i:i32 = 1;
    while(i < npairs) {
        let ji:[]u8 = _zag_arg(3 + 2 * i);
        let ci:i64 = parse_i64(_zag_arg(4 + 2 * i));
        if(ji.len == 0) { return emit_fail("short_pairs"); }
        if(_zag_strcmp(ji, j0) != 1) { agree = 0; }
        if(ci < minc) { minc = ci; }
        if(vid == 4) {
            if(i == 1 && _zag_strcmp(ji, j0) != 1) { p0eq = 0; }
            if(i == 3) {
                let j2:[]u8 = _zag_arg(3 + 2 * 2);
                if(_zag_strcmp(ji, j2) != 1) { p1eq = 0; }
            }
            if(i == 5) {
                let j4:[]u8 = _zag_arg(3 + 2 * 4);
                if(_zag_strcmp(ji, j4) != 1) { p2eq = 0; }
            }
        }
        i = i + 1;
    }
    let reason:[]u8 = "agree";
    if(vid == 4) {
        if(p0eq == 0) { reason = "temp_disagree"; }
        if(p0eq == 1 && p1eq == 0) { reason = "spat_disagree"; }
        if(p0eq == 1 && p1eq == 1 && p2eq == 0) { reason = "meth_disagree"; }
        if(p0eq == 1 && p1eq == 1 && p2eq == 1 && agree == 0) { reason = "cross_disagree"; }
    }
    if(vid == 1 && agree == 0) { reason = "temp_disagree"; }
    if(vid == 2 && agree == 0) { reason = "spat_disagree"; }
    if(vid == 3 && agree == 0) { reason = "meth_disagree"; }
    let ob:[]u8 = nio_alloc(1024);
    let pos:i32 = 0;
    pos = ob_kv(ob, pos, "gate", vv);
    pos = ob_kv(ob, pos, "clip", clip);
    pos = ob_kint(ob, pos, "n", npairs as i64);
    pos = ob_kint(ob, pos, "corroborated", agree as i64);
    if(agree == 1) { pos = ob_kv(ob, pos, "judgment", j0); }
    if(agree == 0) { pos = ob_kv(ob, pos, "judgment", "NONE"); }
    if(agree == 1) { pos = ob_kint(ob, pos, "confidence", minc); }
    if(agree == 0) { pos = ob_kint(ob, pos, "confidence", -1); }
    if(agree == 1) { pos = ob_kv(ob, pos, "decision", "CANDIDATE"); }
    if(agree == 0) { pos = ob_kv(ob, pos, "decision", "WITHHOLD"); }
    pos = ob_kv(ob, pos, "reason", reason);
    if(nio_write_all(1, ob[0..pos]) != pos as i64) { return emit_fail("write_failed"); }
    nio_free(ob);
    return 0;
}

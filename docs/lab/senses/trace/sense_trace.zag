// sense_trace.zag — SENSE-TRACE v1: per-stage SHA-256 provenance for sense intakes.
//
// Permanent senses infrastructure (Micah order 2026-09-26): EVERY intake stage
// in EVERY sense records input-checksum, output-checksum, and parameters in a
// per-run trace log. Any future defect localizes to the exact stage by checksum
// comparison: stage N's output checksum != stage N+1's input checksum, or a
// stage's output diverging from a golden checksum.
//
// DESIGN CONTRACT (zero-impact):
//   - Tracing OBSERVES only. Hooks hash input/output buffers and append one
//     line per stage to the trace log. The data path is never touched.
//   - Outputs are byte-identical with tracing on vs off (proven by rerun).
//   - The log is DETERMINISTIC: no timestamps, no PIDs, no addresses.
//     Same input + same params => byte-identical trace log.
//   - Format-agnostic: the library hashes raw bytes; the container/format is
//     recorded in the RUN line (Micah direction: TNN must handle any format).
//
// Trace-log grammar (v1):
//   # SENSE-TRACE v1\n
//   RUN sense=<sense> format=<format-desc> src=<sha256hex> params=<k=v,...>\n
//   STAGE <seq> <sense>.<stage> in=<sha256hex|-> out=<sha256hex>
//         in_len=<n> out_len=<n> params=<k=v,...>\n
//   HELD sha=<sha256hex> len=<n> desc=<text-with-underscores>\n
//   END rc=<rc>\n
// Linkage invariant: for consecutive non-fork stages, STAGE[i].out ==
// STAGE[i+1].in. Fork stages (a slice of an earlier stage's output, e.g. the
// audio head-sample stage) declare fork_of=<stage> in params and their `in` is
// the checksum of the sliced region.
//
// Pure Zag, zero RNG.
@import("./R33_NATIVE_SHA256_V2.zag")

// SHA-256 of a buffer as 64-char lowercase hex. Caller frees the result.
fn tr_sha_hex(b:[]u8) []u8 {
    let d:[]u8 = nio_alloc(32);
    if (d.len != 32) { return ""; }
    if (ns_sha256(b, d) != 0) { nio_free(d); return ""; }
    let hx:[]u8 = ns_hex(d);
    nio_free(d);
    return hx;
}

// copy bytes; returns new offset
fn tr_cpy(dst:[]u8, at:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { dst[at + i] = s[i]; i = i + 1; }
    return at + s.len;
}

// i64 -> decimal ASCII; returns new offset. No _zag_i64_to_str (newline quirk).
fn tr_i64(dst:[]u8, at:i64, v:i64) i64 {
    if (v == 0) { dst[at] = 48; return at + 1; }
    let neg:i64 = 0;
    let x:i64 = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    let tmp:[]u8 = nio_alloc(24);
    if (tmp.len == 0) { return at; }
    let n:i64 = 0;
    while (x > 0) { tmp[n] = ((x % 10) + 48) as u8; x = x / 10; n = n + 1; }
    if (neg == 1) { dst[at] = 45; at = at + 1; }
    let i:i64 = 0;
    while (i < n) { dst[at + i] = tmp[n - 1 - i]; i = i + 1; }
    nio_free(tmp);
    return at + n;
}

// write one line; no-op when tracing is off (fd < 0)
fn tr_emit(fd:i64, line:[]u8, len:i64) void {
    if (fd < 0) { return; }
    if (len <= 0) { return; }
    let part:[]u8 = line[0..len];
    nio_write_all(fd, part);
    return;
}

// open the trace log (O_WRONLY|O_CREAT|O_TRUNC, like file_write). Returns fd,
// or -1 when tracing is off (ten==0) or the open fails. Callers pass the fd
// to every tr_* call; each call no-ops on fd < 0, so the data path is identical
// with tracing on vs off.
fn tr_open(root:i64, path:[]u8, ten:i64) i64 {
    if (ten == 0) { return -1; }
    let s:[]u8 = nio_cstr(path);
    if (s.len == 0) { return -1; }
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, 657985, 420, 0, 0);
    nio_free(s);
    if (fd < 0) { return -1; }
    return fd;
}

fn tr_run(fd:i64, sense:[]u8, format:[]u8, src_hex:[]u8, params:[]u8) void {
    if (fd < 0) { return; }
    let lb:[]u8 = nio_alloc(2048);
    if (lb.len == 0) { return; }
    let at:i64 = 0;
    at = tr_cpy(lb, at, "# SENSE-TRACE v1\n");
    at = tr_cpy(lb, at, "RUN sense=");
    at = tr_cpy(lb, at, sense);
    at = tr_cpy(lb, at, " format=");
    at = tr_cpy(lb, at, format);
    at = tr_cpy(lb, at, " src=");
    at = tr_cpy(lb, at, src_hex);
    at = tr_cpy(lb, at, " params=");
    at = tr_cpy(lb, at, params);
    at = tr_cpy(lb, at, "\n");
    tr_emit(fd, lb, at);
    nio_free(lb);
    return;
}

fn tr_stage(fd:i64, seq:i64, name:[]u8, in_hex:[]u8, out_hex:[]u8, in_len:i64, out_len:i64, params:[]u8) void {
    if (fd < 0) { return; }
    let lb:[]u8 = nio_alloc(2048);
    if (lb.len == 0) { return; }
    let at:i64 = 0;
    at = tr_cpy(lb, at, "STAGE ");
    at = tr_i64(lb, at, seq);
    at = tr_cpy(lb, at, " ");
    at = tr_cpy(lb, at, name);
    at = tr_cpy(lb, at, " in=");
    at = tr_cpy(lb, at, in_hex);
    at = tr_cpy(lb, at, " out=");
    at = tr_cpy(lb, at, out_hex);
    at = tr_cpy(lb, at, " in_len=");
    at = tr_i64(lb, at, in_len);
    at = tr_cpy(lb, at, " out_len=");
    at = tr_i64(lb, at, out_len);
    at = tr_cpy(lb, at, " params=");
    at = tr_cpy(lb, at, params);
    at = tr_cpy(lb, at, "\n");
    tr_emit(fd, lb, at);
    nio_free(lb);
    return;
}

fn tr_held(fd:i64, hex:[]u8, len:i64, desc:[]u8) void {
    if (fd < 0) { return; }
    let lb:[]u8 = nio_alloc(2048);
    if (lb.len == 0) { return; }
    let at:i64 = 0;
    at = tr_cpy(lb, at, "HELD sha=");
    at = tr_cpy(lb, at, hex);
    at = tr_cpy(lb, at, " len=");
    at = tr_i64(lb, at, len);
    at = tr_cpy(lb, at, " desc=");
    at = tr_cpy(lb, at, desc);
    at = tr_cpy(lb, at, "\n");
    tr_emit(fd, lb, at);
    nio_free(lb);
    return;
}

fn tr_end(fd:i64, rc:i64) void {
    if (fd < 0) { return; }
    let lb:[]u8 = nio_alloc(256);
    if (lb.len == 0) { return; }
    let at:i64 = 0;
    at = tr_cpy(lb, at, "END rc=");
    at = tr_i64(lb, at, rc);
    at = tr_cpy(lb, at, "\n");
    tr_emit(fd, lb, at);
    nio_free(lb);
    return;
}

fn tr_close(fd:i64) void {
    if (fd < 0) { return; }
    nio_sync(fd);
    nio_close(fd);
    return;
}

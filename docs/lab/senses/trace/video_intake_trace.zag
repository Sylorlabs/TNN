// video_intake_trace.zag — TRACED video intake driver (SENSE-TRACE v1).
//
// Runs TNN's canonical video-frame intake with per-stage SHA-256 trace points:
//   raw_read -> ppm_header -> raster_copy -> held_frame
//
// Intake idiom VERBATIM from docs/lab/imagination/video-composer-step2/src/
// composer.zag (origin/tnn-native-lab), fn read_ppm_gen: raw PPM P6 reader,
// exact-size-checked verbatim byte copy; no quantization, no chroma
// conversion, no resampling. All three composer lines carry byte-identical
// reader bodies (304ee68f7508e0f1). PPM writer (ppm_header_gen + write_ppm)
// also verbatim from composer.zag.
//
// argv: 1=in.ppm 2=out.ppm 3=trace.log 4=trace=on|off
// out.ppm = held frame written back as PPM P6 (round-trip; the input verdict
// proved ingest->store->recall byte-identical). Byte-identical with tracing
// on vs off (zero-impact proof in RUNLOG.md).
// Pure Zag, zero RNG.
@import("./sense_trace.zag")

// ---- VERBATIM ppm_header_gen from composer.zag (origin/tnn-native-lab) ----
fn ppm_header_gen(b:[]u8, o:i64, w:i64, h:i64) i64 {
    // "P6\n<w> <h>\n255\n"
    b[o] = 80; b[o + 1] = 54; b[o + 2] = 10;
    let p:i64 = o + 3;
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    let v:i64 = w;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    let i:i64 = 0;
    while (i < n) { b[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    b[p] = 32; p = p + 1;
    n = 0; v = h;
    if (v == 0) { tmp[0] = 48; n = 1; }
    while (v > 0) { tmp[n] = (48 + (v % 10)) as u8; v = v / 10; n = n + 1; }
    i = 0;
    while (i < n) { b[p + i] = tmp[n - 1 - i]; i = i + 1; }
    p = p + n;
    b[p] = 10; b[p + 1] = 50; b[p + 2] = 53; b[p + 3] = 53; b[p + 4] = 10;
    p = p + 5;
    nio_free(tmp);
    return p - o;
}
// ---- END VERBATIM ----

// file_write idiom (O_WRONLY|O_CREAT|O_TRUNC)
fn vi_file_write(root:i64, name:[]u8, data:[]u8) i64 {
    let total:i64 = data.len;
    let s:[]u8 = nio_cstr(name);
    if (s.len == 0) { return -7401; }
    let fd:i64 = _zag_raw_syscall(257, root, _zag_slice_ptr(s) as i64, 657985, 420, 0, 0);
    nio_free(s);
    if (fd < 0) { return -2; }
    let done:i64 = 0;
    while (done < total) {
        let n:i64 = total - done;
        if (n > 1048576) { n = 1048576; }
        let part:[]u8 = data[done..done + n];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != n) { nio_close(fd); return -3; }
        done = done + n;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}

// write_ppm idiom (verbatim logic from composer.zag; write via file_write)
fn vi_write_ppm(root:i64, name:[]u8, px:[]u8, w:i64, h:i64) i64 {
    let need:i64 = w * h * 3;
    let wb:[]u8 = nio_alloc((need + 32) as i32);
    if (wb.len == 0) { return -40; }
    let hl:i64 = ppm_header_gen(wb, 0, w, h);
    let i:i64 = 0;
    while (i < need) { wb[hl + i] = px[i]; i = i + 1; }
    let rc:i64 = vi_file_write(root, name, wb[0..hl + need]);
    nio_free(wb);
    return rc;
}

fn main() i32 {
    let inname:[]u8 = _zag_arg(1);
    let outname:[]u8 = _zag_arg(2);
    let trname:[]u8 = _zag_arg(3);
    let trflag:[]u8 = _zag_arg(4);
    if (_zag_strcmp(inname, "") == 1) { _zag_println("need in.ppm"); return 1; }
    if (_zag_strcmp(outname, "") == 1) { _zag_println("need out.ppm"); return 1; }
    if (_zag_strcmp(trname, "") == 1) { _zag_println("need trace.log"); return 1; }
    let ten:i64 = 0;
    if (_zag_strcmp(trflag, "on") == 1) { ten = 1; }

    let root:i64 = nio_open_root(".");
    if (root < 0) { _zag_println("cannot open cwd root"); return 1; }

    // ---- STAGE 0: raw_read ----
    let fd:i64 = nio_open_child(root, inname, 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    if (nio_regular(fd) != 1) { _zag_println("input not regular"); nio_close(fd); nio_close(root); return 1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 15) { _zag_println("short file"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[0] != 80) { _zag_println("not P6"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[1] != 54) { _zag_println("not P6"); nio_free(fbuf); nio_close(root); return 1; }
    let raw:[]u8 = fbuf[0..n];
    let raw_hex:[]u8 = tr_sha_hex(raw);

    let tfd:i64 = tr_open(root, trname, ten);
    tr_run(tfd, "video", "PPM/P6", raw_hex, "maxval=255");
    tr_stage(tfd, 0, "video.raw_read", "-", raw_hex, 0, n, "origin=file");

    // ---- STAGE 1: ppm_header (VERBATIM parse from read_ppm_gen) ----
    let p:i64 = 2;
    while (p < n) { let c:i64 = fbuf[p] as i64; if (c == 32 || c == 10 || c == 13 || c == 9) { p = p + 1; } else { break; } }
    let w:i64 = 0;
    let nd:i64 = 0;
    while (p < n) { let c:i64 = fbuf[p] as i64; if (c >= 48) { if (c <= 57) { w = w * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { _zag_println("bad w"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    while (p < n) { let c:i64 = fbuf[p] as i64; if (c == 32 || c == 10 || c == 13 || c == 9) { p = p + 1; } else { break; } }
    let h:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = fbuf[p] as i64; if (c >= 48) { if (c <= 57) { h = h * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { _zag_println("bad h"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    while (p < n) { let c:i64 = fbuf[p] as i64; if (c == 32 || c == 10 || c == 13 || c == 9) { p = p + 1; } else { break; } }
    let mv:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = fbuf[p] as i64; if (c >= 48) { if (c <= 57) { mv = mv * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { _zag_println("bad maxval"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    if (p >= n) { _zag_println("no raster"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    let c:i64 = fbuf[p] as i64;
    if (c != 32) { if (c != 10) { if (c != 13) { if (c != 9) { _zag_println("bad header end"); tr_end(tfd, 1); tr_close(tfd); return 1; } } } }
    p = p + 1;
    if (mv != 255) { _zag_println("need maxval 255"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    if (w <= 0 || h <= 0) { _zag_println("bad dims"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    let need:i64 = w * h * 3;
    if (need > 1200000 * 3) { _zag_println("too big"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    if (n != p + need) { _zag_println("size mismatch"); tr_end(tfd, 1); tr_close(tfd); return 1; }
    let hdr_len:i64 = p;
    let hdr:[]u8 = raw[0..hdr_len];
    let hdr_hex:[]u8 = tr_sha_hex(hdr);
    let hb:[]u8 = nio_alloc(256);
    let hl:i64 = 0;
    hl = tr_cpy(hb, hl, "magic=P6,w=");
    hl = tr_i64(hb, hl, w);
    hl = tr_cpy(hb, hl, ",h=");
    hl = tr_i64(hb, hl, h);
    hl = tr_cpy(hb, hl, ",maxval=255,hdr_len=");
    hl = tr_i64(hb, hl, hdr_len);
    tr_stage(tfd, 1, "video.ppm_header", raw_hex, hdr_hex, n, hdr_len, hb[0..hl]);
    nio_free(hb);

    // ---- STAGE 2: raster_copy (VERBATIM verbatim copy from read_ppm_gen) ----
    let px:[]u8 = nio_alloc((need) as i32);
    if (px.len == 0) { _zag_println("alloc px failed"); nio_free(fbuf); nio_close(root); return 1; }
    let i:i64 = 0;
    while (i < need) { px[i] = fbuf[p + i]; i = i + 1; }
    let px_hex:[]u8 = tr_sha_hex(px);
    let qb:[]u8 = nio_alloc(256);
    let ql:i64 = 0;
    ql = tr_cpy(qb, ql, "w=");
    ql = tr_i64(qb, ql, w);
    ql = tr_cpy(qb, ql, ",h=");
    ql = tr_i64(qb, ql, h);
    ql = tr_cpy(qb, ql, ",exact_size_check=n==p+need,copy=verbatim,in_src=video.raw_read");
    tr_stage(tfd, 2, "video.raster_copy", raw_hex, px_hex, n, need, qb[0..ql]);
    nio_free(qb);

    // ---- STAGE 3: held_frame (the held representation) ----
    tr_stage(tfd, 3, "video.held_frame", px_hex, px_hex, need, need, "identity");
    tr_held(tfd, px_hex, need, "RGB_raster_w*h*3;_verbatim_copy");
    tr_end(tfd, 0);
    tr_close(tfd);

    // data path output (identical with tracing on vs off)
    let rc:i64 = vi_write_ppm(root, outname, px, w, h);
    nio_close(root);
    nio_free(fbuf);
    nio_free(raw_hex);
    nio_free(hdr_hex);
    nio_free(px);
    nio_free(px_hex);
    if (rc != 0) { _zag_println("write failed"); return 1; }
    _zag_println("video intake trace ok");
    return 0;
}

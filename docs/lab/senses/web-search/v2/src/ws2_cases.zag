fn run_leg2_C() i32 {
    let w:*WsF=ws2_new();
    let p:i32=0;
    let t:i32=12;
    p=p+c2_C_T1(w);
    p=p+c2_C_T2(w);
    p=p+c2_C_T3(w);
    p=p+c2_C_T4(w);
    p=p+c2_C_T5(w);
    p=p+c2_C_T6(w);
    p=p+c2_C_T7(w);
    p=p+c2_C_T8(w);

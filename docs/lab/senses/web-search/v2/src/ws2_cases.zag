    let w:*WsF=ws2_new();
    let p:i32=0;
    let t:i32=6;
    p=p+c2_B_B1(w);
    p=p+c2_B_B2(w);
    p=p+c2_B_B3(w);
    p=p+c2_B_B4(w);
    p=p+c2_B_B5(w);
    p=p+c2_B_B6(w);
    ws_leg_summary(w, 1, t, p);
    return p;
}


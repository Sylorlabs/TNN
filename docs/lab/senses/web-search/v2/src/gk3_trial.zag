// gk3_trial.zag — repair tests for GK2 brittleness findings.
// Pure Zag, imports the frozen v2 sense unchanged; repairs are trial-local
// preprocessing. No RNG, no timestamps.
// Build: znc gk3_trial.zag -o gk3_trial (cwd = v2 src dir).

@import("ws2_sense.zag")

// FIX-DOM: keep last two dot-segments ("a.spoof.example" -> "spoof.example").
fn gk_dom_norm(d:[]u8)[]u8 {
    let last:i32=-1;
    let prev:i32=-1;
    let i:i32=0;
    while(i<d.len){
        if(d[i]==46){prev=last;last=i;}
        i=i+1;
    }
    if(last<0){return d;}
    if(prev<0){return d;}
    let start:i32=prev+1;
    let out:[]u8=z_alloc(d.len-start);
    z_copy(out,0,d[start..d.len]);
    return out;
}

// FIX-ANS: lowercase ASCII A-Z.
fn gk_ans_norm(a:[]u8)[]u8 {
    let out:[]u8=z_alloc(a.len);
    let i:i32=0;
    while(i<a.len){
        let v:i32=a[i] as i32;
        if(v>=65){if(v<=90){out[i]=(v+32) as u8;}else{out[i]=a[i];}}else{out[i]=a[i];}
        i=i+1;
    }
    return out;
}

fn gk3_add(w:*WsF,domain:[]u8,url:[]u8,title:[]u8,snippet:[]u8,answer:[]u8)void {
    let dn:[]u8=gk_dom_norm(domain);
    let an:[]u8=gk_ans_norm(answer);
    let hh:[]u8=ws_result_hash(url,title,snippet);
    ws_add_result(w,dn,title,snippet,url,an,1,hh);
    return;
}

fn gk_features(w:*WsF,id:[]u8)void {
    let n2:i32=w.*.n;
    let topc:i32=0;
    let i2:i32=0;
    while(i2<n2){
        let a:[]u8=ws_get_a(w,i2);
        let c:i32=0;
        let k:i32=0;
        while(k<n2){
            if(z_equal(ws_get_a(w,k),a)==1){c=c+1;}
            k=k+1;
        }
        if(c>topc){topc=c;}
        i2=i2+1;
    }
    _zag_print("FEAT|");_zag_print(id);
    _zag_print("|n=");_zag_print(_zag_i64_to_str(n2 as i64));
    _zag_print("|agree=");_zag_print(_zag_i64_to_str(topc as i64));
    _zag_print("|tamper=");_zag_print(_zag_i64_to_str(w.*.tamper as i64));
    _zag_println("");
    return;
}

fn main()i32 {
    let pass:i32=0;
    let total:i32=0;

    // GK3-10: FIX-DOM + subdomain inflation -> refuse
    let w10:*WsF=ws2_new();
    if(ws_wire(w10,2,1)!=1){return 2;}
    ws_fact_begin(w10,92,0,"GK3-10","chemical symbol for gold?","",1,0);
    gk3_add(w10,"a.spoof.example","https://a.spoof.example/gold","Gold symbol","Gold is Gd","Gd");
    gk3_add(w10,"b.spoof.example","https://b.spoof.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_features(w10,"GK3-10");
    total=total+1;
    pass=pass+ws_install_end(w10,"GK3-10","gd",80,8,0);

    // GK3-10b: FIX-DOM + genuinely distinct base domains -> install (residual preserved)
    let w10b:*WsF=ws2_new();
    if(ws_wire(w10b,2,1)!=1){return 2;}
    ws_fact_begin(w10b,92,0,"GK3-10b","chemical symbol for gold?","",1,0);
    gk3_add(w10b,"spoof-a.example","https://spoof-a.example/gold","Gold symbol","Gold is Gd","Gd");
    gk3_add(w10b,"spoof-b.example","https://spoof-b.example/gold-symbol","Au or Gd","It is Gd","Gd");
    gk_features(w10b,"GK3-10b");
    total=total+1;
    pass=pass+ws_install_end(w10b,"GK3-10b","gd",80,7,1);

    // GK3-14: FIX-ANS + case-variant true answers -> install
    let w14:*WsF=ws2_new();
    if(ws_wire(w14,2,1)!=1){return 2;}
    ws_fact_begin(w14,92,0,"GK3-14","chemical symbol for gold?","",1,0);
    gk3_add(w14,"atlas.example","https://atlas.example/gold","Gold | Facts","Gold, chemical symbol Au","Au");
    gk3_add(w14,"chemref.example","https://chemref.example/elements","Au gold","SYMBOL AU","AU");
    gk_features(w14,"GK3-14");
    total=total+1;
    pass=pass+ws_install_end(w14,"GK3-14","au",80,7,1);

    // GK3-14b: FIX-ANS + genuinely different answers -> refuse
    let w14b:*WsF=ws2_new();
    if(ws_wire(w14b,2,1)!=1){return 2;}
    ws_fact_begin(w14b,92,0,"GK3-14b","chemical symbol for gold?","",1,0);
    gk3_add(w14b,"atlas.example","https://atlas.example/gold","Gold | Facts","Gold, chemical symbol Au","Au");
    gk3_add(w14b,"chemref.example","https://chemref.example/elements","Uranium","symbol U","US");
    gk_features(w14b,"GK3-14b");
    total=total+1;
    pass=pass+ws_install_end(w14b,"GK3-14b","au",80,8,0);

    _zag_print("GK3|total=");_zag_print(_zag_i64_to_str(total as i64));
    _zag_print("|pass=");_zag_print(_zag_i64_to_str(pass as i64));
    _zag_println("");
    if(pass==total){return 0;}
    return 1;
}

// ws2_trial.zag — scored driver for the web-search sense v2.
// Usage: ws2_trial <mode>  mode in {A,B,C,D,M,R,S,all}
// Cases + leg runners are generated into ws2_cases.zag (see gen_v2.py).
// Deterministic: no timestamps, no RNG, no PIDs. N=5 replays over recorded
// envelopes must be byte-identical.

@import("ws2_cases.zag")

fn leg_verdict(name:[]u8,ok:i32)void {
    _zag_print("VERDICT|");_zag_print(name);_zag_print("|");
    if(ok==1){_zag_println("PASS");}else{_zag_println("FAIL");}
    return;
}

// Leg S: always-on standing demo (logic-only, no live data).
// The sense is consulted every deliberation cycle; the frozen gate decides.
// Session: K1 known-uncontested -> U1 unknown -> U1 again (anti-spam) ->
//          K2 known + teacher-contradicts (trigger 3).
// Bar: exactly 2 transport calls (U1 once, K2 once), 0 for known-uncontested.
fn run_leg2_S() i32 {
    let w:*WsF=ws2_new();
    let okw:i32=ws_wire(w, 1, 1);
    if(okw!=1){return 0;}
    // cycle 1: known, uncontested -> gate 0
    ws_fact_begin(w, 80, 1, "S-K1", "What is the capital of France?", "Paris", 0, 0);
    let d1:i32=ws_decide(w);
    let g1:i32=w.*.gate;
    ws_ledger(w,70,"S-K1","S-K1","S-K1","Paris","S-K1");
    // cycle 2: unknown, asked -> gate 1 (transport would fire once)
    ws_fact_begin(w, 80, 0, "S-U1", "What is the capital of Burkina Faso?", "", 1, 0);
    let d2:i32=ws_decide(w);
    let g2:i32=w.*.gate;
    ws_ledger(w,70,"S-U1","S-U1","S-U1","","S-U1");
    // cycle 3: same unknown, already searched this session -> gate 0 (anti-spam)
    ws_fact_begin(w, 80, 0, "S-U1", "What is the capital of Burkina Faso?", "", 1, 1);
    let d3:i32=ws_decide(w);
    let g3:i32=w.*.gate;
    ws_ledger(w,70,"S-U1","S-U1","S-U1","","S-U1");
    // cycle 4: known but teacher contradicts -> gate 1 (one verification round)
    ws_fact_begin(w, 80, 1, "S-K2", "teacher claim: Paris is not the capital", "Paris", 3, 0);
    let d4:i32=ws_decide(w);
    let g4:i32=w.*.gate;
    ws_ledger(w,70,"S-K2","S-K2","S-K2","Paris","S-K2");
    let transports:i32=g1+g2+g3+g4;
    _zag_print("S|d1=");_zag_print(_zag_i64_to_str(d1 as i64));
    _zag_print("|d2=");_zag_print(_zag_i64_to_str(d2 as i64));
    _zag_print("|d3=");_zag_print(_zag_i64_to_str(d3 as i64));
    _zag_print("|d4=");_zag_print(_zag_i64_to_str(d4 as i64));
    _zag_print("|transports=");_zag_print(_zag_i64_to_str(transports as i64));
    _zag_println("");
    // d1: gate 0 -> disp 0; d2: gate 1, no results -> disp 2; d3: gate 0 -> disp 0
    // d4: gate 1, no results, known -> disp 5 (confirm installed, no contradiction seen)
    if(d1!=0){return 0;}
    if(d2!=2){return 0;}
    if(d3!=0){return 0;}
    if(d4!=5){return 0;}
    if(transports!=2){return 0;}
    _zag_print("SUMMARY|80|total=4|pass=4|transports=2");_zag_println("");
    return 4;
}

fn main()i32 {
    let m:[]u8=_zag_arg(1);
    if(z_equal(m,"A")==1){
        let p:i32=run_leg2_A();
        let b:i32=run_leg2_A_baseline();
        let ok:i32=0;
        if(p==20){if(b==1){ok=1;}}
        leg_verdict("A2",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"B")==1){
        let p:i32=run_leg2_B();
        let ok:i32=0;
        if(p==6){ok=1;}
        leg_verdict("B2",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"C")==1){
        let p:i32=run_leg2_C();
        let ok:i32=0;
        if(p>=9){ok=1;}
        leg_verdict("C2",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"D")==1){
        let p:i32=run_leg2_D();
        let ok:i32=0;
        if(p>=11){ok=1;}
        leg_verdict("D2",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"M")==1){
        let p:i32=run_leg2_M();
        // 12 cases x 2 modes = 24 checks; bar: 24/24
        let ok:i32=0;
        if(p==24){ok=1;}
        leg_verdict("M2",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"R")==1){
        let p:i32=run_leg2_R();
        // 12 cases x 2 rules = 24 checks; bar: 24/24 per predicted matrix
        let ok:i32=0;
        if(p==24){ok=1;}
        leg_verdict("R2",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"S")==1){
        let p:i32=run_leg2_S();
        let ok:i32=0;
        if(p==4){ok=1;}
        leg_verdict("S2",ok);
        if(ok==1){return 0;}
        return 1;
    }
    if(z_equal(m,"all")==1){
        let pa:i32=run_leg2_A();
        let pb:i32=run_leg2_A_baseline();
        let pc:i32=run_leg2_B();
        let pd:i32=run_leg2_C();
        let pe:i32=run_leg2_D();
        let pf:i32=run_leg2_M();
        let pg:i32=run_leg2_R();
        let ph:i32=run_leg2_S();
        let ok:i32=0;
        if(pa==20){if(pb==1){if(pc==6){if(pd>=9){if(pe>=11){if(pf==24){if(pg==24){if(ph==4){ok=1;}}}}}}}}
        leg_verdict("all2",ok);
        if(ok==1){return 0;}
        return 1;
    }
    _zag_println("usage: ws2_trial <A|B|C|D|M|R|S|all>");
    return 2;
}

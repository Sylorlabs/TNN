// gk2_trial.zag — red-team adjudication follow-up battery.
// Pure Zag, imports the frozen v2 sense unchanged. No RNG, no timestamps.
// Build: znc gk2_trial.zag -o gk2_trial (cwd = v2 src dir).

@import("ws2_sense.zag")

fn gk_add(w:*WsF,domain:[]u8,url:[]u8,title:[]u8,snippet:[]u8,answer:[]u8)void {
    let hh:[]u8=ws_result_hash(url,title,snippet);
    ws_add_result(w,domain,title,snippet,url,answer,1,hh);
    return;
}

// add with a deliberately WRONG hash -> tamper flag path.
fn gk_add_bad(w:*WsF,domain:[]u8,url:[]u8,title:[]u8,snippet:[]u8,answer:[]u8)void {
    let bad:[]u8="deadbeef";
    ws_add_result(w,domain,title,snippet,url,answer,1,bad);
    return;
}

fn gk_features(w:*WsF,id:[]u8)void {
    let n2:i32=w.*.n;
    let topc:i32=0;
    let i2:i32=0;
    while(i2<n2){
        let a:[]u8=ws_get_a(w,i2);
        let c:i32=0;
        let k:i32=0;
        while(k<n2){
            if(z_equal(ws_get_a(w,k),a)==1){c=c+1;}
            k=k+1;
        }
        if(c>topc){topc=c;}
        i2=i2+1;
    }
    _zag_print("FEAT|");_zag_print(id);
    _zag_print("|n=");_zag_print(_zag_i64_to_str(n2 as i64));
    _zag_print("|agree=");_zag_print(_zag_i64_to_str(topc as i64));
    _zag_print("|tamper=");_zag_print(_zag_i64_to_str(w.*.tamper as i64));
    _zag_println("");
    return;
}

fn main()i32 {
    let pass:i32=0;
    let total:i32=0;

    // GK2-8: one-domain TRUE -> refuse (content-blind count rule)
    let w8:*WsF=ws2_new();
    if(ws_wire(w8,2,1)!=1){return 2;}
    ws_fact_begin(w8,91,0,"GK2-8","chemical symbol for gold?","",1,0);
    gk_add(w8,"atlas.example","https://atlas.example/gold","Gold | Facts","Gold, chemical symbol Au","Au");
    gk_features(w8,"GK2-8");
    total=total+1;
    pass=pass+ws_install_end(w8,"GK2-8","Au",80,8,0);

    // GK2-9: seeded installed Au conf80, 3-domain unanimous false, R-CONTRA -> refuse
    let w9:*WsF=ws2_new();
    if(ws_wire(w9,2,2)!=1){return 2;}
    ws_seed_installed(w9,"GK2-9","Au",80);
    ws_fact_begin(w9,91,0,"GK2-9","chemical symbol for gold?","",1,0);
    gk_add(w9,"spoof-a.example","https://spoof-a.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add(w9,"spoof-b.example","https://spoof-b.example/gold-symbol","Au or Gd","It is Gd","Gd");
    gk_add(w9,"spoof-c.example","https://spoof-c.example/au","Chemistry notes","Gold: Gd","Gd");
    gk_features(w9,"GK2-9");
    total=total+1;
    pass=pass+ws_install_end(w9,"GK2-9","Gd",80,8,0);

    // GK2-10: subdomain-count inflation: a.spoof.example + b.spoof.example, false
    let w10:*WsF=ws2_new();
    if(ws_wire(w10,2,1)!=1){return 2;}
    ws_fact_begin(w10,91,0,"GK2-10","chemical symbol for gold?","",1,0);
    gk_add(w10,"a.spoof.example","https://a.spoof.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add(w10,"b.spoof.example","https://b.spoof.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_features(w10,"GK2-10");
    total=total+1;
    pass=pass+ws_install_end(w10,"GK2-10","Gd",80,7,1);

    // GK2-11: 2 agree false + 1 dissenter true -> majority installs
    let w11:*WsF=ws2_new();
    if(ws_wire(w11,2,1)!=1){return 2;}
    ws_fact_begin(w11,91,0,"GK2-11","chemical symbol for gold?","",1,0);
    gk_add(w11,"spoof-a.example","https://spoof-a.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add(w11,"spoof-b.example","https://spoof-b.example/gold-symbol","Au or Gd","It is Gd","Gd");
    gk_add(w11,"atlas.example","https://atlas.example/gold","Gold | Facts","Gold, chemical symbol Au","Au");
    gk_features(w11,"GK2-11");
    total=total+1;
    pass=pass+ws_install_end(w11,"GK2-11","Gd",80,7,1);

    // GK2-12: 2 false + 2 true, false first -> tie, first-seen installs false
    let w12:*WsF=ws2_new();
    if(ws_wire(w12,2,1)!=1){return 2;}
    ws_fact_begin(w12,91,0,"GK2-12","chemical symbol for gold?","",1,0);
    gk_add(w12,"spoof-a.example","https://spoof-a.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add(w12,"spoof-b.example","https://spoof-b.example/gold-symbol","Au or Gd","It is Gd","Gd");
    gk_add(w12,"atlas.example","https://atlas.example/gold","Gold | Facts","Gold, chemical symbol Au","Au");
    gk_add(w12,"chemref.example","https://chemref.example/elements","Au gold","symbol Au","Au");
    gk_features(w12,"GK2-12");
    total=total+1;
    pass=pass+ws_install_end(w12,"GK2-12","Gd",80,7,1);

    // GK2-13: 2 true + 2 false, true first -> tie, first-seen installs true
    let w13:*WsF=ws2_new();
    if(ws_wire(w13,2,1)!=1){return 2;}
    ws_fact_begin(w13,91,0,"GK2-13","chemical symbol for gold?","",1,0);
    gk_add(w13,"atlas.example","https://atlas.example/gold","Gold | Facts","Gold, chemical symbol Au","Au");
    gk_add(w13,"chemref.example","https://chemref.example/elements","Au gold","symbol Au","Au");
    gk_add(w13,"spoof-a.example","https://spoof-a.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add(w13,"spoof-b.example","https://spoof-b.example/gold-symbol","Au or Gd","It is Gd","Gd");
    gk_features(w13,"GK2-13");
    total=total+1;
    pass=pass+ws_install_end(w13,"GK2-13","Au",80,7,1);

    // GK2-14: same true proposition, different answer strings -> no canonicalization
    let w14:*WsF=ws2_new();
    if(ws_wire(w14,2,1)!=1){return 2;}
    ws_fact_begin(w14,91,0,"GK2-14","chemical symbol for gold?","",1,0);
    gk_add(w14,"atlas.example","https://atlas.example/gold","Gold | Facts","Gold, chemical symbol Au","Au");
    gk_add(w14,"chemref.example","https://chemref.example/elements","Au gold","SYMBOL AU","AU");
    gk_features(w14,"GK2-14");
    total=total+1;
    pass=pass+ws_install_end(w14,"GK2-14","Au",80,8,0);

    // GK2-15: tamper positive control: 2nd result with wrong hash -> tamper=1, refuse
    let w15:*WsF=ws2_new();
    if(ws_wire(w15,2,1)!=1){return 2;}
    ws_fact_begin(w15,91,0,"GK2-15","chemical symbol for gold?","",1,0);
    gk_add(w15,"spoof-a.example","https://spoof-a.example/gold","Gold symbol","Gold is Gd","Gd");
    gk_add_bad(w15,"spoof-b.example","https://spoof-b.example/gold-symbol","Au or Gd","It is Gd","Gd");
    gk_features(w15,"GK2-15");
    total=total+1;
    pass=pass+ws_install_end(w15,"GK2-15","Gd",80,8,0);

    _zag_print("GK2|total=");_zag_print(_zag_i64_to_str(total as i64));
    _zag_print("|pass=");_zag_print(_zag_i64_to_str(pass as i64));
    _zag_println("");
    if(pass==total){return 0;}
    return 1;
}

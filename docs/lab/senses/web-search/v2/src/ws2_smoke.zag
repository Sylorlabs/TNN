// ws2_smoke.zag — compile + logic smoke for ws2_sense (hand-written cases).
@import("ws2_sense.zag")

fn sm_wire_refused() i32 {
    let w:*WsF=ws2_new();
    // no ws_wire call: sense must refuse
    ws_fact_begin(w, 90, 0, "SM0", "What is the capital of France?", "", 1, 0);
    let p:i32=ws_fact_end(w, 10, "");
    _zag_print("SMOKE|wire_refused|");_zag_print(_zag_i64_to_str(p as i64));_zag_println("");
    return p;
}

fn sm_mode1_noinstall() i32 {
    let w:*WsF=ws2_new();
    let ok:i32=ws_wire(w, 1, 1);
    if(ok!=1){return 0;}
    ws_fact_begin(w, 90, 0, "SM1", "What is the capital of France?", "", 1, 0);
    ws_add_result(w, "a.com", "t", "s", "https://a.com/x", "Paris", 1,
        "3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f3f");
    // tamper will be 1 (bogus hash) -> disp 9; that is fine, we only test install refusal.
    // Use install_end: mode 1 must refuse (8) and install nothing.
    let r:i32=ws_install(w, "SM1", "Paris", 60);
    let lg:*WsL=w.*.lg;
    _zag_print("SMOKE|mode1|R");_zag_print(_zag_i64_to_str(r as i64));
    _zag_print("|NI");_zag_print(_zag_i64_to_str(lg.*.c_install as i64));_zag_println("");
    if(r!=8){return 0;}
    if(lg.*.c_install!=0){return 0;}
    return 1;
}

fn sm_corr_withhold_single() i32 {
    let w:*WsF=ws2_new();
    let ok:i32=ws_wire(w, 2, 1);
    if(ok!=1){return 0;}
    ws_fact_begin(w, 90, 0, "SM2", "Q?", "", 1, 0);
    ws_add_result(w, "evil.com", "t", "s", "https://evil.com/x", "WRONG", 1,
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    // single domain -> R-CORR must refuse, store nothing
    let p:i32=ws_install_end(w, "SM2", "WRONG", 60, 8, 0);
    _zag_print("SMOKE|corr_single|");_zag_print(_zag_i64_to_str(p as i64));_zag_println("");
    return p;
}

fn sm_corr_install_two() i32 {
    let w:*WsF=ws2_new();
    let ok:i32=ws_wire(w, 2, 1);
    if(ok!=1){return 0;}
    ws_fact_begin(w, 90, 0, "SM3", "Q?", "", 1, 0);
    ws_add_result(w, "a.com", "t", "s", "https://a.com/x", "RIGHT", 1,
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");
    ws_add_result(w, "b.org", "t", "s", "https://b.org/y", "RIGHT", 1,
        "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc");
    let p:i32=ws_install_end(w, "SM3", "RIGHT", 60, 7, 1);
    _zag_print("SMOKE|corr_two|");_zag_print(_zag_i64_to_str(p as i64));_zag_println("");
    return p;
}

fn sm_contra_install_single() i32 {
    let w:*WsF=ws2_new();
    let ok:i32=ws_wire(w, 2, 2);
    if(ok!=1){return 0;}
    ws_fact_begin(w, 90, 0, "SM4", "Q?", "", 1, 0);
    ws_add_result(w, "evil.com", "t", "s", "https://evil.com/x", "WRONG", 1,
        "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd");
    // R-CONTRA: no installed contradiction -> installs (predicted unsafe)
    let p:i32=ws_install_end(w, "SM4", "WRONG", 60, 7, 1);
    _zag_print("SMOKE|contra_single|");_zag_print(_zag_i64_to_str(p as i64));_zag_println("");
    return p;
}

fn sm_override() i32 {
    let w:*WsF=ws2_new();
    let ok:i32=ws_wire(w, 2, 1);
    if(ok!=1){return 0;}
    ws_fact_begin(w, 90, 0, "SM5", "Q?", "", 1, 0);
    let p:i32=ws_override_end(w, "SM5", "OVAL", 90, 7);
    _zag_print("SMOKE|override|");_zag_print(_zag_i64_to_str(p as i64));_zag_println("");
    return p;
}

fn sm_contra_blocked() i32 {
    let w:*WsF=ws2_new();
    let ok:i32=ws_wire(w, 2, 2);
    if(ok!=1){return 0;}
    ws_seed_installed(w, "SM6", "TRUEV", 80);
    ws_fact_begin(w, 90, 0, "SM6", "Q?", "", 1, 0);
    ws_add_result(w, "a.com", "t", "s", "https://a.com/x", "FALSEV", 1,
        "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee");
    ws_add_result(w, "b.org", "t", "s", "https://b.org/y", "FALSEV", 1,
        "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff");
    // installed TRUEV conf 80 contradicts FALSEV -> R-CONTRA refuses
    let p:i32=ws_install_end(w, "SM6", "FALSEV", 60, 8, 0);
    _zag_print("SMOKE|contra_blocked|");_zag_print(_zag_i64_to_str(p as i64));_zag_println("");
    return p;
}

fn main()i32 {
    let t:i32=0;
    let p:i32=0;
    t=t+1; p=p+sm_wire_refused();
    t=t+1; p=p+sm_mode1_noinstall();
    t=t+1; p=p+sm_corr_withhold_single();
    t=t+1; p=p+sm_corr_install_two();
    t=t+1; p=p+sm_contra_install_single();
    t=t+1; p=p+sm_override();
    t=t+1; p=p+sm_contra_blocked();
    _zag_print("SMOKE|total=");_zag_print(_zag_i64_to_str(t as i64));
    _zag_print("|pass=");_zag_print(_zag_i64_to_str(p as i64));_zag_println("");
    if(p==t){return 0;}
    return 1;
}

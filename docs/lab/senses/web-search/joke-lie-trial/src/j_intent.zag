// j_intent.zag — deterministic English intent classifier (pure Zag, ASCII).
// Input: folded (lowercase, ASCII) item text + lowercased URL; caller-owned
// NUL-terminated scratch buffers codes (256B) and markers (2048B).
// Output: intent 1=SINCERE 2=JOKING 3=SATIRE 4=DECEPTIVE 5=UNCERTAIN.
// No globals (this znc build rejects them); no RNG; no timestamps.
//
// Marker lists are general English (no item-specific rules). Frozen after
// calibration (see calibration/REPORT.md); §4.2 decision rule from PREREG.md.

@import("j_ledger.zag")

// j_fw: record one marker firing. codebit gates the code-name dedup;
// markbit is always ORed into the mask (used for distinct style counting).
// Returns packed: (mask<<32) | (mlen<<16) | clen.
fn j_fw(codes:[]u8,clen:i32,markers:[]u8,mlen:i32,mask:i32,codebit:i32,markbit:i32,cname:[]u8,marker:[]u8)i64 {
    let nmask:i32=mask;
    let nclen:i32=clen;
    let nmlen:i32=mlen;
    if((mask&codebit)==0){
        nmask=mask|codebit;
        if(nclen>0){codes[nclen]=43;nclen=nclen+1;}
        let i:i32=0;
        while(i<cname.len){codes[nclen]=cname[i];nclen=nclen+1;i=i+1;}
    }
    nmask=nmask|markbit;
    let k:i32=0;
    while(k<marker.len){markers[nmlen]=marker[k];nmlen=nmlen+1;k=k+1;}
    markers[nmlen]=126;
    nmlen=nmlen+1;
    let r:i64=(nmask as i64)<<32;
    let r2:i64=r|((nmlen as i64)<<16);
    let r3:i64=r2|(nclen as i64);
    return r3;
}

fn j_ru_clen(r:i64)i32{return (r&65535) as i32;}
fn j_ru_mlen(r:i64)i32{return ((r>>16)&65535) as i32;}
fn j_ru_mask(r:i64)i32{return (r>>32) as i32;}

// one marker check + fire; returns packed state like j_fw
fn j_mw(t:[]u8,codes:[]u8,clen:i32,markers:[]u8,mlen:i32,mask:i32,bit:i32,cname:[]u8,w:[]u8)i64 {
    if(j_has_word(t,w)!=0){
        return j_fw(codes,clen,markers,mlen,mask,bit,bit,cname,w);
    }
    let r:i64=(mask as i64)<<32;
    let r2:i64=r|((mlen as i64)<<16);
    let r3:i64=r2|(clen as i64);
    return r3;
}

fn j_mp(t:[]u8,codes:[]u8,clen:i32,markers:[]u8,mlen:i32,mask:i32,bit:i32,cname:[]u8,p:[]u8)i64 {
    if(j_has_sub(t,p)!=0){
        return j_fw(codes,clen,markers,mlen,mask,bit,bit,cname,p);
    }
    let r:i64=(mask as i64)<<32;
    let r2:i64=r|((mlen as i64)<<16);
    let r3:i64=r2|(clen as i64);
    return r3;
}

// ---------- main classifier ----------

fn j_classify(text:[]u8,url:[]u8,codes:[]u8,markers:[]u8)i32 {
    let clen:i32=0;
    let mlen:i32=0;
    let mask:i32=0;
    let r:i64=0;
    let u:[]u8=j_tolower(url);
    let t:[]u8=text;

    // ---- R_SATIRE_SOURCE (bit 1) ----
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","theonion.com");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","babylonbee.com");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","clickhole.com");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","thebeaverton.com");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","waterfordwhispersnews.com");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","thedailymash.co.uk");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","reductress.com");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","hard-drive.net");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","thehardtimes.net");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(u,codes,clen,markers,mlen,mask,1,"R_SATIRE_SOURCE","duffelblog.com");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);

    // ---- R_EXPLICIT_JOKE (bit 2) ----
    r=j_mw(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","lol");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","lmao");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","lmfao");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","rofl");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","jk");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","/s");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","/j");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","just kidding");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","i'm joking");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","im joking");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","only joking");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","just a joke");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","this is a joke");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,2,"R_EXPLICIT_JOKE","was just kidding");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);

    // ---- R_ABSURD (bit 4): ingestion context + non-ingestible substance ----
    let ctx:i32=0;
    if(j_has_word(t,"eat")!=0){ctx=1;}
    if(j_has_word(t,"eating")!=0){ctx=1;}
    if(j_has_word(t,"drink")!=0){ctx=1;}
    if(j_has_word(t,"drinking")!=0){ctx=1;}
    if(j_has_word(t,"recipe")!=0){ctx=1;}
    if(j_has_word(t,"ingredient")!=0){ctx=1;}
    if(j_has_word(t,"ingredients")!=0){ctx=1;}
    if(j_has_word(t,"sauce")!=0){ctx=1;}
    if(j_has_word(t,"pizza")!=0){ctx=1;}
    if(j_has_word(t,"cheese")!=0){ctx=1;}
    if(j_has_word(t,"food")!=0){ctx=1;}
    if(j_has_word(t,"meal")!=0){ctx=1;}
    if(j_has_word(t,"cook")!=0){ctx=1;}
    if(j_has_word(t,"cooking")!=0){ctx=1;}
    if(j_has_word(t,"topping")!=0){ctx=1;}
    if(j_has_word(t,"toppings")!=0){ctx=1;}
    if(j_has_word(t,"swallow")!=0){ctx=1;}
    if(j_has_word(t,"taste")!=0){ctx=1;}
    if(j_has_word(t,"flavor")!=0){ctx=1;}
    if(j_has_word(t,"flavour")!=0){ctx=1;}
    if(j_has_word(t,"dish")!=0){ctx=1;}
    if(j_has_word(t,"bake")!=0){ctx=1;}
    if(j_has_word(t,"baking")!=0){ctx=1;}
    if(j_has_word(t,"soup")!=0){ctx=1;}
    if(j_has_word(t,"sandwich")!=0){ctx=1;}
    if(j_has_word(t,"dinner")!=0){ctx=1;}
    if(ctx!=0){
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","glue");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","bleach");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","gasoline");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","paint");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","thinner");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","turpentine");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","antifreeze");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","detergent");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","cement");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","concrete");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","kerosene");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","ammonia");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mw(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","soap");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mp(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","motor oil");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mp(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","nail polish");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mp(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","dish soap");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        r=j_mp(t,codes,clen,markers,mlen,mask,4,"R_ABSURD","toilet cleaner");
        clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    }

    // ---- R_SATIRE_STYLE (codebit 8; markbits 16..25 for distinct counting) ----
    let sb:i32=1048576;
    if(j_has_sub(t,"area man")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","area man");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}
    sb=1048576<<1;
    if(j_has_sub(t,"area woman")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","area woman");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}
    sb=1048576<<2;
    if(j_has_sub(t,"area teen")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","area teen");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}
    sb=1048576<<3;
    if(j_has_sub(t,"area dad")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","area dad");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}
    sb=1048576<<4;
    if(j_has_sub(t,"area mom")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","area mom");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}
    sb=1048576<<5;
    if(j_has_sub(t,"sources confirm")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","sources confirm");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}
    sb=1048576<<6;
    if(j_has_sub(t,"at press time")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","at press time");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}
    sb=1048576<<7;
    if(j_has_sub(t,"in a stunning")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","in a stunning");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}
    sb=1048576<<8;
    if(j_has_sub(t,"reports confirm")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","reports confirm");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}
    sb=1048576<<9;
    if(j_has_sub(t,"experts confirm")!=0){r=j_fw(codes,clen,markers,mlen,mask,8,sb,"R_SATIRE_STYLE","experts confirm");clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);}

    // ---- R_FABRICATION (bit 16) ----
    r=j_mp(t,codes,clen,markers,mlen,mask,16,"R_FABRICATION","forward this");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,16,"R_FABRICATION","share this");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,16,"R_FABRICATION","before they delete");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,16,"R_FABRICATION","copy and paste");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,16,"R_FABRICATION","pass it on");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,16,"R_FABRICATION","send this to");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,16,"R_FABRICATION","they don't want you to know");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,16,"R_FABRICATION","wake up");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);

    // ---- R_EARNEST (bit 32) ----
    r=j_mp(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","according to");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","researchers");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","scientists");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","research shows");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","study");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","studies");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","published");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","however");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mp(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","for example");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","evidence");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","measured");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
    r=j_mw(t,codes,clen,markers,mlen,mask,32,"R_EARNEST","observed");
    clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);

    // ---- decision (§4.2), flat rule chain ----
    let m:i32=mask;
    let nonsinc:i32=0;
    if((m&2)!=0){nonsinc=1;}
    if((m&4)!=0){nonsinc=1;}
    if((m&8)!=0){nonsinc=1;}
    if((m&16)!=0){nonsinc=1;}
    let earnest:i32=0;
    if((m&32)!=0){earnest=1;}
    let intent:i32=5;
    if((m&1)!=0){intent=3;}
    if(intent==5){
        if((m&2)!=0){intent=2;}
    }
    if(intent==5){
        if((m&4)!=0){intent=2;}
    }
    if(intent==5){
        let sn:i32=0;
        let b:i32=0;
        while(b<10){
            let bit:i32=1048576<<b;
            if((m&bit)!=0){sn=sn+1;}
            b=b+1;
        }
        if(sn>=2){intent=3;}
    }
    if(intent==5){
        if((m&16)!=0){intent=4;}
    }
    if(intent==5){
        if(earnest!=0){if(nonsinc==0){intent=1;}}
    }
    if(intent==5){
        if(nonsinc!=0){
            if(earnest!=0){
                r=j_fw(codes,clen,markers,mlen,mask,128,128,"R_CONFLICT","conflict");
                clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
            }
        }
        if(mask==0){
            r=j_fw(codes,clen,markers,mlen,mask,64,64,"R_NO_MARKERS","none");
            clen=j_ru_clen(r);mlen=j_ru_mlen(r);mask=j_ru_mask(r);
        }
    }
    codes[clen]=0;
    markers[mlen]=0;
    return intent;
}

// j_trial.zag — joke/lie/satire detection trial driver (pure Zag, no RNG).
// For each corpus item: intent judgment (+reasons) BEFORE install decision.
// Modes via argv[1]: "solo" (default) or "helper".
// Install gate (§5): intent SINCERE -> INSTALL else WITHHOLD.
// Ledger state (prev hash + seq) is threaded through locals; no globals.

@import("R33_NATIVE_SHA256_V2.zag")
@import("R33_NATIVE_IO_V1.zag")
@import("j_ledger.zag")
@import("j_intent.zag")
@import("j_corpus.zag")
@import("j_helper.zag")

fn j_mode_name(mode:i32)[]u8 {
    if(mode==1){return "helper";}
    return "solo";
}

// append "+TOKEN" to a NUL-terminated codes buffer
fn j_codes_append(codes:[]u8,tok:[]u8)void {
    let n:i32=j_cstrlen(codes);
    codes[n]=43;
    let i:i32=0;
    while(i<tok.len){codes[n+1+i]=tok[i];i=i+1;}
    codes[n+1+tok.len]=0;
    return;
}

// append "MARKER~" to a NUL-terminated markers buffer
fn j_markers_append(markers:[]u8,mk:[]u8)void {
    let n:i32=j_cstrlen(markers);
    let i:i32=0;
    while(i<mk.len){markers[n+i]=mk[i];i=i+1;}
    markers[n+mk.len]=126;
    markers[n+mk.len+1]=0;
    return;
}

fn j_print_rs(id:[]u8,cat:[]u8,intent:i32,install:i32,codes:[]u8,markers:[]u8)void {
    _zag_print("RS|");
    _zag_print(id);_zag_print("|");
    _zag_print(cat);_zag_print("|");
    _zag_print(_zag_i64_to_str(intent as i64));_zag_print("|");
    _zag_print(_zag_i64_to_str(install as i64));_zag_print("|");
    _zag_print(j_exact(codes));_zag_print("|");
    _zag_print(j_exact(markers));
    _zag_println("");
    return;
}

fn j_run(mode:i32)void {
    let prev:[]u8=j_alloc(32);
    j_zero(prev);
    let seq:i64=0;
    prev=j_emit(prev,seq,1,"session",0,0,j_mode_name(mode));
    seq=seq+1;
    let codes:[]u8=j_alloc(256);
    let markers:[]u8=j_alloc(2048);
    let n:i32=j_nitems();
    let i:i32=0;
    while(i<n){
        let id:[]u8=j_id(i);
        let cat:[]u8=j_cat(i);
        let text:[]u8=j_text(i);
        let url:[]u8=j_url(i);
        let intent:i32=j_classify(text,url,codes,markers);
        if(mode==1){
            let hi:i32=j_h_intent(i);
            let hm:[]u8=j_h_marker(i);
            prev=j_emit(prev,seq,2,id,hi,0,"helper-observed");
            seq=seq+1;
            if(hi!=intent){
                if(j_has_sub(text,hm)!=0){
                    intent=hi;
                    j_codes_append(codes,"ADOPT_HELPER");
                    j_markers_append(markers,hm);
                }else{
                    j_codes_append(codes,"KEEP_CLASSIFIER");
                }
            }
        }
        let install:i32=2;
        if(intent==1){install=1;}
        prev=j_emit(prev,seq,3,id,intent,install,j_exact(codes));
        seq=seq+1;
        j_print_rs(id,cat,intent,install,codes,markers);
        i=i+1;
    }
    prev=j_emit(prev,seq,4,"session",0,0,"end");
    _zag_print("HEAD|");
    _zag_print(j_hex(prev));
    _zag_println("");
    return;
}

fn main()i32 {
    let mstr:[]u8=_zag_arg(1);
    let mode:i32=0;
    if(j_eq(mstr,"helper")!=0){mode=1;}
    j_run(mode);
    return 0;
}

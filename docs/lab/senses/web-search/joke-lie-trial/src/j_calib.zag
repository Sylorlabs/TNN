// j_calib.zag — calibration driver: run the classifier over the dev set,
// print id | intent | codes | markers. Throwaway binary; REPORT.md is the record.
@import("R33_NATIVE_SHA256_V2.zag")
@import("R33_NATIVE_IO_V1.zag")
@import("j_ledger.zag")
@import("j_intent.zag")
@import("c_calib.zag")

fn main()i32 {
    let codes:[]u8=j_alloc(256);
    let markers:[]u8=j_alloc(2048);
    let n:i32=c_nitems();
    let i:i32=0;
    while(i<n){
        let intent:i32=j_classify(c_text(i),c_url(i),codes,markers);
        _zag_print("CAL|");
        _zag_print(c_id(i));_zag_print("|");
        _zag_print(_zag_i64_to_str(intent as i64));_zag_print("|");
        _zag_print(j_exact(codes));_zag_print("|");
        _zag_print(j_exact(markers));
        _zag_println("");
        i=i+1;
    }
    return 0;
}

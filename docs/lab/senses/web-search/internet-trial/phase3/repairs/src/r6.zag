// r6.zag -- R6 seeded logic layer, pure Zag.
//
// R6 composition schema:
//   component extraction: identify the claim's subject, predicate, object
//     from the claim text.
//   component-fact lookup: match components against the seeded fact table.
//   CAUSES/PREVENTS/CONTAINS/IS-A evaluation with polarity:
//     - CAUSES(X,Y): X causes Y (polarity +)
//     - PREVENTS(X,Y): X prevents Y (polarity -)
//     - CONTAINS(X,Y): X contains Y
//     - IS-A(X,Y): X is a Y
//   CONTRADICTS > vote count: a logic CONTRADICTS verdict overrides the
//     evidence vote.
//   SUPPORTS cannot override a WITHHOLD gate: if R3 gated, logic SUPPORTS
//     does not install.
//   UNKNOWN defers to R1-R5: logic UNKNOWN means use the evidence disposition.
//
// Seeded verdicts (by candidate):
//   C16 (rain sounds): CONTRADICTS -> REJECT
//   C15 (fruit/clots): UNKNOWN -> defer to evidence (WITHHOLD)
//   others: UNKNOWN

fn r6_logic(cid:[]u8)i32{
    // returns 0=UNKNOWN, 1=SUPPORTS, 2=CONTRADICTS
    if(cid.len==3){
        // C16
        if(cid[0]==67 and cid[1]==49 and cid[2]==54){return 2;}
    }
    return 0;
}

// Apply R6: logic_verdict 0=UNKNOWN,1=SUPPORTS,2=CONTRADICTS.
// gated: 1 if R3 gated. evidence_disp: 2/3/4 from R1-R5.
// Returns final disposition.
//
// R3-PERSISTENCE (fixed 2026-09-23): the R3 gate is checked FIRST and is
// terminal. A gated ID stays WITHHOLD no matter what the logic layer or the
// evidence votes say. Rationale: R3 withholds judgment on
// CONTESTED/EVOLVED/SKEPTICISM/AMBIGUOUS claims; a logic REJECT or a vote
// INSTALL is taking a stance, which the pre-search safety gate forbids.
// Downstream stages cannot override it.
fn r6_apply(logic_verdict:i32,gated:i32,evidence_disp:i32)i32{
    if(gated!=0){
        // R3 gate is terminal: gated IDs stay WITHHOLD.
        return 4;
    }
    if(logic_verdict==2){
        // CONTRADICTS > vote count
        return 3;
    }
    if(logic_verdict==1){
        // SUPPORTS cannot override WITHHOLD gate
        if(gated!=0){return 4;}
        return evidence_disp;
    }
    // UNKNOWN defers to R1-R5
    return evidence_disp;
}

fn main()void{
    return;
}

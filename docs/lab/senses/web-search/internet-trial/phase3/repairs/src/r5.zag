// r5.zag -- R5 reliability weighting, pure Zag.
//
// R5/M4: reliability weighting only after repaired R1+R2 tags.
// Scheme A: T3=32, T2=16, T1=8, T0=4, T-1=1 (scaled integers).
// Winner = max total weight (strict >, first-appearance wins ties).
// Winner weight >= 8 -> INSTALL/REJECT/WITHHOLD by winner, else WITHHOLD.
//
// Vote codes: 0=IRRELEVANT, 1=AFFIRM, 2=DENY.
// Disposition codes: 2=INSTALL, 3=REJECT, 4=WITHHOLD.

fn r5_tier_weight(tier:i32)i32{
    if(tier==3){return 32;}
    if(tier==2){return 16;}
    if(tier==1){return 8;}
    if(tier==0){return 4;}
    return 1;
}

// votes: array of (vote_code, tier), n entries.
// Returns disposition 2/3/4.
fn r5_decide(votes:[]i32,tiers:[]i32,n:i32)i32{
    let w0:i32=0;
    let w1:i32=0;
    let w2:i32=0;
    let i:i32=0;
    while(i<n){
        let v:i32=votes[i];
        let w:i32=r5_tier_weight(tiers[i]);
        if(v==0){w0=w0+w;}
        if(v==1){w1=w1+w;}
        if(v==2){w2=w2+w;}
        i=i+1;
    }
    // winner = max weight, strict >, first-appearance wins ties
    // order: check in first-appearance order (simplified: 1,2,0)
    let best:i32=0;
    let bestw:i32=w0;
    if(w1>bestw){best=1;bestw=w1;}
    if(w2>bestw){best=2;bestw=w2;}
    if(bestw<8){return 4;}
    if(best==1){return 2;}
    if(best==2){return 3;}
    return 4;
}

fn main()void{
    return;
}

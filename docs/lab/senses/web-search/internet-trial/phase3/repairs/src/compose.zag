// compose.zag -- TRUE R1-R6 composed pipeline, pure Zag, zero RNG, deterministic.
//
// Pipeline per candidate per arm (solo, helper):
//   1. classify tags come from src/r12.zag's classifier (run separately over
//      all 364 course rows; this driver joins tags by row id and VERIFIES
//      every id, so a dropped/duplicated classify row is a hard error).
//   2. votes/tiers derived exactly as tools/run_ablation.py + tools/predict.py
//      derive them: last env cycle only; row i==96 -> helper vote from the
//      helper score, tier 0; else vote = classify tag, tier = tier_map lookup
//      on the lowercased domain (default 1).
//   3. +R1+R2 = unweighted decide on the repaired tags (dedup (domain,answer)
//      keep-first, cap 6; known-candidate unanimity / contra->REVISE path).
//   4. +R3 = gated ? WITHHOLD : +R1+R2            (R3 gate, pre-search)
//   5. +R5 = gated ? WITHHOLD : r5_decide(...)   (R5 reliability weighting;
//      r5_decide recomputes from votes with no knowledge of the gate, so the
//      gate is applied OUTSIDE it -- this is the R3-persistence fix at the
//      composition level)
//   6. +R6 = r6_apply_fixed(logic, gated, +R5)   (R6 seeded logic; the gate is
//      checked FIRST inside r6_apply and is terminal)
//
// Per-stage columns are gate-aware. R4 query generation has no disposition
// effect on frozen envelopes and emits no column.
//
// Usage: compose <r12out.tsv> <solo.tsv> <helper.tsv> <candidates.tsv>
//                <tier_map.tsv> <frozen_disps.tsv>
// Output (stdout): header + 38 rows:
//   arm \t cid \t frozen \t r1r2 \t r3 \t r5 \t r6 \t attrib
// attrib: which stage determined the final disposition
//   (R3 gate | R6 logic | R5 weighting | R1R2 classifier | STABLE).
//
// Stage functions below are verbatim-logic ports of the frozen sources:
//   r3_gated_cid  <- src/r3.zag r3_gated
//   r5_decide_a   <- src/r5.zag r5_decide (+ r5_tier_weight)
//   r6_logic_cid / r6_apply_fixed <- src/r6.zag (WITH the R3-persistence fix)
//
// Toolchain notes (workspace AGENTS.md): no `as []i32` casts anywhere -- all
// tables are []u8 arenas with explicit LE accessors; _zag_arg read
// unconditionally; flat control flow; every arena explicitly zeroed by z_alloc.

// ---------- alloc / io (proven pattern from src/r12.zag) ----------
fn z_alloc(n:i32)[]u8{
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8)void{
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}
fn z_cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4194304){return "";}
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    return b;
}
fn read_all(path:[]u8)[]u8{
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let cap:i32=8388608;
    let buf:[]u8=z_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}

// ---------- byte utils ----------
fn z_eq(a:[]u8,b:[]u8)i32{
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
// LE u32 arena accessors (never `as []i32`)
fn a_put(b:[]u8,i:i32,v:i32)void{
    let o:i32=i<<2;
    b[o]=(v & 255) as u8;
    b[o+1]=((v>>8) & 255) as u8;
    b[o+2]=((v>>16) & 255) as u8;
    b[o+3]=((v>>24) & 255) as u8;
    return;
}
fn a_get(b:[]u8,i:i32)i32{
    let o:i32=i<<2;
    let v:i32=(b[o] as i32) & 255;
    v=v | (((b[o+1] as i32) & 255)<<8);
    v=v | (((b[o+2] as i32) & 255)<<16);
    v=v | (((b[o+3] as i32) & 255)<<24);
    return v;
}
fn parse_i32(s:[]u8)i32{
    let neg:i32=0;
    let i:i32=0;
    if(s.len>0 && (s[0] as i32)==45){neg=1;i=1;}
    let v:i32=0;
    while(i<s.len){
        let d:i32=(s[i] as i32)-48;
        if(d<0 || d>9){break;}
        v=v*10+d;
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}
// ASCII lowercase copy; returns length
fn lower_copy(t:[]u8,out:[]u8)i32{
    let n:i32=t.len;
    if(n>out.len){n=out.len;}
    let i:i32=0;
    while(i<n){
        let c:i32=(t[i] as i32);
        if(c>=65 && c<=90){c=c+32;}
        out[i]=(c as u8);
        i=i+1;
    }
    return n;
}
// split line on tabs; starts = u32 arena (cap maxf); returns field count
fn split_fields(line:[]u8,starts:[]u8,maxf:i32)i32{
    a_put(starts,0,0);
    let nf:i32=1;
    let i:i32=0;
    while(i<line.len){
        if((line[i] as i32)==9){
            if(nf<maxf){a_put(starts,nf,i+1);nf=nf+1;}
        }
        i=i+1;
    }
    return nf;
}
fn field(line:[]u8,starts:[]u8,nf:i32,k:i32)[]u8{
    let s:i32=a_get(starts,k);
    let e:i32=line.len;
    if(k+1<nf){e=a_get(starts,k+1)-1;}
    return line[s..e];
}

// ---------- frozen stage logic (verbatim ports) ----------
// src/r3.zag r3_gated
fn r3_gated_cid(cid:[]u8)i32{
    if(cid.len!=2 && cid.len!=3){return 0;}
    if((cid[0] as i32)!=67){return 0;}
    let n:i32=0;
    if(cid.len==2){n=(cid[1] as i32)-48;}
    if(cid.len==3){n=((cid[1] as i32)-48)*10+((cid[2] as i32)-48);}
    if(n==5){return 1;}
    if(n==6){return 1;}
    if(n==8){return 1;}
    if(n==11){return 1;}
    if(n==12){return 1;}
    if(n==13){return 1;}
    return 0;
}
// src/r5.zag r5_tier_weight, over tier+1 codes (0->-1,1->0,2->1,3->2,4->3)
fn tier_weight(t1:i32)i32{
    if(t1==4){return 32;}
    if(t1==3){return 16;}
    if(t1==2){return 8;}
    if(t1==1){return 4;}
    return 1;
}
// src/r5.zag r5_decide; votes: vote codes 0/1/2; t1: tier+1 codes
fn r5_decide_a(votes:[]u8,t1:[]u8,n:i32)i32{
    let w0:i32=0;
    let w1:i32=0;
    let w2:i32=0;
    let i:i32=0;
    while(i<n){
        let v:i32=(votes[i] as i32);
        let w:i32=tier_weight((t1[i] as i32));
        if(v==0){w0=w0+w;}
        if(v==1){w1=w1+w;}
        if(v==2){w2=w2+w;}
        i=i+1;
    }
    let best:i32=0;
    let bestw:i32=w0;
    if(w1>bestw){best=1;bestw=w1;}
    if(w2>bestw){best=2;bestw=w2;}
    if(bestw<8){return 4;}
    if(best==1){return 2;}
    if(best==2){return 3;}
    return 4;
}
// src/r6.zag r6_logic
fn r6_logic_cid(cid:[]u8)i32{
    if(cid.len==3){
        if((cid[0] as i32)==67 && (cid[1] as i32)==49 && (cid[2] as i32)==54){return 2;}
    }
    return 0;
}
// src/r6.zag r6_apply WITH the R3-persistence fix: gate checked FIRST, terminal.
fn r6_apply_fixed(logic_verdict:i32,gated:i32,evidence_disp:i32)i32{
    if(gated!=0){
        return 4;
    }
    if(logic_verdict==2){
        return 3;
    }
    if(logic_verdict==1){
        if(gated!=0){return 4;}
        return evidence_disp;
    }
    return evidence_disp;
}

// collect rows of one candidate from an arm file buffer.
// fills eseq/ei/ehsc (u8), edom (u32 arena, 2 slots/row: off,len). returns n.
fn collect_rows(buf:[]u8,cand:i32,eseq:[]u8,ei:[]u8,ehsc:[]u8,edom:[]u8,maxr:i32)i32{
    let fstarts:[]u8=z_alloc(64);
    if(fstarts.len==0){return -1;}
    let n:i32=0;
    let total:i32=buf.len;
    let i:i32=0;
    let ls:i32=0;
    while(i<=total){
        let eol:i32=0;
        if(i==total){eol=1;}
        else{if((buf[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (buf[le-1] as i32)==13){le=le-1;}
            if(le>ls && n<maxr){
                let line:[]u8=buf[ls..le];
                let nf:i32=split_fields(line,fstarts,16);
                if(nf>=8){
                    let c0:i32=parse_i32(field(line,fstarts,nf,0));
                    if(c0==cand){
                        eseq[n]=(parse_i32(field(line,fstarts,nf,1)) as u8);
                        ei[n]=(parse_i32(field(line,fstarts,nf,2)) as u8);
                        ehsc[n]=(parse_i32(field(line,fstarts,nf,7)) as u8);
                        let dm:[]u8=field(line,fstarts,nf,3);
                        let doff:i32=ls+a_get(fstarts,3);
                        a_put(edom,n*2,doff);
                        a_put(edom,n*2+1,dm.len);
                        n=n+1;
                    }
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    z_free(fstarts);
    return n;
}

// unweighted decide on repaired tags (predict.py decide, weighted=False).
// mvote: votes; mdom: u32 arena of (off,len) into buf; known 0/1; contra 2/255.
// returns disposition 2/3/4/5.
fn decide_unweighted(mvote:[]u8,mdom:[]u8,m:i32,known:i32,contra:i32,buf:[]u8)i32{
    // dedup (domain,vote) keep-first, cap 6
    let ddv:[]u8=z_alloc(8);
    let ddom:[]u8=z_alloc(64);
    let nd:i32=0;
    let k:i32=0;
    while(k<m){
        let v:i32=(mvote[k] as i32);
        let mo:i32=a_get(mdom,k*2);
        let ml:i32=a_get(mdom,k*2+1);
        let ms:[]u8=buf[mo..mo+ml];
        let found:i32=0;
        let d:i32=0;
        while(d<nd){
            let ddo:i32=a_get(ddom,d*2);
            let ddl:i32=a_get(ddom,d*2+1);
            if((ddv[d] as i32)==v && z_eq(buf[ddo..ddo+ddl],ms)==1){found=1;}
            d=d+1;
        }
        if(found==0 && nd<6){
            ddv[nd]=(v as u8);
            a_put(ddom,nd*2,mo);
            a_put(ddom,nd*2+1,ml);
            nd=nd+1;
        }
        k=k+1;
    }
    let disp:i32=4;
    if(known==1){
        let bad:i32=0;
        let d2:i32=0;
        while(d2<nd){
            if((ddv[d2] as i32)!=1){bad=bad+1;}
            d2=d2+1;
        }
        if(bad==0){disp=2;}
        else{
            disp=4;
            if(contra==2){
                let nc:i32=0;
                let seen:[]u8=z_alloc(64);
                let ns:i32=0;
                let d3:i32=0;
                while(d3<nd){
                    if((ddv[d3] as i32)==2){
                        nc=nc+1;
                        let so:i32=a_get(ddom,d3*2);
                        let sl:i32=a_get(ddom,d3*2+1);
                        let ss:[]u8=buf[so..so+sl];
                        let f2:i32=0;
                        let s3:i32=0;
                        while(s3<ns){
                            let qo:i32=a_get(seen,s3*2);
                            let ql:i32=a_get(seen,s3*2+1);
                            if(z_eq(buf[qo..qo+ql],ss)==1){f2=1;}
                            s3=s3+1;
                        }
                        if(f2==0){
                            a_put(seen,ns*2,so);
                            a_put(seen,ns*2+1,sl);
                            ns=ns+1;
                        }
                    }
                    d3=d3+1;
                }
                z_free(seen);
                if(nc>=2 && ns>=2){disp=5;}
            }
        }
    }
    if(known==0){
        let c0:i32=0;
        let c1:i32=0;
        let c2:i32=0;
        let d4:i32=0;
        while(d4<nd){
            let a4:i32=(ddv[d4] as i32);
            if(a4==0){c0=c0+1;}
            if(a4==1){c1=c1+1;}
            if(a4==2){c2=c2+1;}
            d4=d4+1;
        }
        let top:i32=255;
        let topc:i32=0;
        let d5:i32=0;
        while(d5<nd){
            let a5:i32=(ddv[d5] as i32);
            let ca:i32=c0;
            if(a5==1){ca=c1;}
            if(a5==2){ca=c2;}
            if(ca>topc){topc=ca;top=a5;}
            d5=d5+1;
        }
        disp=4;
        if(topc>=2){
            disp=4;
            if(top==1){disp=2;}
            if(top==2){disp=3;}
        }
    }
    z_free(ddv);
    z_free(ddom);
    return disp;
}

// tier lookup: lowercase domain -> tier (-1..3), default 1
fn tier_of(dom:[]u8,tm:[]u8,ntm:i32,tmbuf:[]u8,scratch:[]u8)i32{
    let nl:i32=lower_copy(dom,scratch);
    let low:[]u8=scratch[0..nl];
    let t:i32=0;
    while(t<ntm){
        let to:i32=a_get(tm,t*3);
        let tl:i32=a_get(tm,t*3+1);
        if(z_eq(tmbuf[to..to+tl],low)==1){
            return a_get(tm,t*3+2);
        }
        t=t+1;
    }
    return 1;
}

// find r12out entry by id; marks used; returns tag, -1 if absent, -2 if
// the same id is requested twice (would silently reuse a tag)
fn tag_lookup(exp:[]u8,zbuf:[]u8,zent:[]u8,nz:i32)i32{
    let z:i32=0;
    while(z<nz){
        let zo:i32=a_get(zent,z*4);
        let zl:i32=a_get(zent,z*4+1);
        if(z_eq(zbuf[zo..zo+zl],exp)==1){
            if(a_get(zent,z*4+3)!=0){return -2;}
            let tag:i32=a_get(zent,z*4+2);
            a_put(zent,z*4+3,1);
            return tag;
        }
        z=z+1;
    }
    return -1;
}

// append one result line to out; returns new offset
fn emit_line(out:[]u8,o:i32,arm:[]u8,cid:[]u8,fz:i32,r12v:i32,r3v:i32,r5v:i32,r6v:i32,attr:[]u8)i32{
    let k:i32=0;
    while(k<arm.len){out[o]=arm[k];o=o+1;k=k+1;}
    out[o]=9;o=o+1;
    k=0;
    while(k<cid.len){out[o]=cid[k];o=o+1;k=k+1;}
    out[o]=9;o=o+1;
    out[o]=((48+fz) as u8);o=o+1;out[o]=9;o=o+1;
    out[o]=((48+r12v) as u8);o=o+1;out[o]=9;o=o+1;
    out[o]=((48+r3v) as u8);o=o+1;out[o]=9;o=o+1;
    out[o]=((48+r5v) as u8);o=o+1;out[o]=9;o=o+1;
    out[o]=((48+r6v) as u8);o=o+1;out[o]=9;o=o+1;
    k=0;
    while(k<attr.len){out[o]=attr[k];o=o+1;k=k+1;}
    out[o]=10;o=o+1;
    return o;
}

// parse tier_map into tm (u32 arena, 3 slots/entry: off,len,tier); returns count
fn parse_tiermap(tbuf:[]u8,tm:[]u8) i32{
    let ntm:i32=0;
    let fs:[]u8=z_alloc(64);
    if(fs.len==0){return -1;}
    let i:i32=0; let ls:i32=0; let n:i32=tbuf.len;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;} else{if((tbuf[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (tbuf[le-1] as i32)==13){le=le-1;}
            if(le>ls && ntm<160){
                let line:[]u8=tbuf[ls..le];
                let nf:i32=split_fields(line,fs,16);
                if(nf>=2){
                    let dm:[]u8=field(line,fs,nf,0);
                    a_put(tm,ntm*3,ls+a_get(fs,0));
                    a_put(tm,ntm*3+1,dm.len);
                    a_put(tm,ntm*3+2,parse_i32(field(line,fs,nf,1)));
                    ntm=ntm+1;
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    z_free(fs);
    return ntm;
}

// parse r12out into zent (u32 arena, 4 slots/entry: id_off,id_len,tag,used)
fn parse_r12out(zbuf:[]u8,zent:[]u8) i32{
    let nz:i32=0;
    let i:i32=0; let ls:i32=0; let n:i32=zbuf.len;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;} else{if((zbuf[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (zbuf[le-1] as i32)==13){le=le-1;}
            if(le>ls && nz<400){
                let sp:i32=-1;
                let q:i32=ls;
                while(q<le){
                    if((zbuf[q] as i32)==32){sp=q;break;}
                    q=q+1;
                }
                if(sp>ls && sp+1<le){
                    a_put(zent,nz*4,ls);
                    a_put(zent,nz*4+1,sp-ls);
                    a_put(zent,nz*4+2,(zbuf[sp+1] as i32)-48);
                    a_put(zent,nz*4+3,0);
                    nz=nz+1;
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    return nz;
}

// parse candidates.tsv; fills ckno/ccon/cido/cidl; returns count (expect 19)
fn parse_cands(cbuf:[]u8,ckno:[]u8,ccon:[]u8,cido:[]u8,cidl:[]u8) i32{
    let fs:[]u8=z_alloc(64);
    if(fs.len==0){return -1;}
    let i:i32=0; let ls:i32=0; let n:i32=cbuf.len; let nc:i32=0;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;} else{if((cbuf[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (cbuf[le-1] as i32)==13){le=le-1;}
            if(le>ls && nc<19){
                let line:[]u8=cbuf[ls..le];
                let nf:i32=split_fields(line,fs,16);
                if(nf>=7){
                    let ix:i32=parse_i32(field(line,fs,nf,0));
                    if(ix==nc){
                        let idf:[]u8=field(line,fs,nf,1);
                        a_put(cido,nc,ls+a_get(fs,1));
                        cidl[nc]=(idf.len as u8);
                        ckno[nc]=(parse_i32(field(line,fs,nf,3)) as u8);
                        let cs:[]u8=field(line,fs,nf,6);
                        let cc:i32=255;
                        if(cs.len==4 && (cs[0] as i32)==68 && (cs[1] as i32)==69 && (cs[2] as i32)==78 && (cs[3] as i32)==89){cc=2;}
                        ccon[nc]=(cc as u8);
                        nc=nc+1;
                    }
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    z_free(fs);
    return nc;
}

// parse frozen_disps.tsv into fz[arm*19+idx]; returns row count (expect 38)
fn parse_frozen(fbuf:[]u8,fz:[]u8) i32{
    let fs:[]u8=z_alloc(64);
    if(fs.len==0){return -1;}
    let i:i32=0; let ls:i32=0; let n:i32=fbuf.len; let cnt:i32=0;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;} else{if((fbuf[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (fbuf[le-1] as i32)==13){le=le-1;}
            if(le>ls){
                let line:[]u8=fbuf[ls..le];
                let nf:i32=split_fields(line,fs,16);
                if(nf>=3){
                    let a0:[]u8=field(line,fs,nf,0);
                    let arm:i32=-1;
                    if(a0.len==4 && (a0[0] as i32)==115){arm=0;}
                    if(a0.len==6 && (a0[0] as i32)==104){arm=1;}
                    let ix:i32=parse_i32(field(line,fs,nf,1));
                    let dp:i32=parse_i32(field(line,fs,nf,2));
                    if(arm>=0 && ix>=0 && ix<19){
                        fz[arm*19+ix]=(dp as u8);
                        cnt=cnt+1;
                    }
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    z_free(fs);
    return cnt;
}

fn main()i32{
    let p1:[]u8=_zag_arg(1);
    let p2:[]u8=_zag_arg(2);
    let p3:[]u8=_zag_arg(3);
    let p4:[]u8=_zag_arg(4);
    let p5:[]u8=_zag_arg(5);
    let p6:[]u8=_zag_arg(6);
    if(p1.len==0 || p2.len==0 || p3.len==0 || p4.len==0 || p5.len==0 || p6.len==0){
        _zag_println("usage: compose <r12out> <solo> <helper> <candidates> <tiermap> <frozen_disps>");
        return 2;
    }
    let zbuf:[]u8=read_all(p1);
    let sbuf:[]u8=read_all(p2);
    let hbuf:[]u8=read_all(p3);
    let cbuf:[]u8=read_all(p4);
    let tbuf:[]u8=read_all(p5);
    let fbuf:[]u8=read_all(p6);
    if(zbuf.len==0 || sbuf.len==0 || hbuf.len==0 || cbuf.len==0 || tbuf.len==0 || fbuf.len==0){
        _zag_println("compose: cannot read an input");
        return 3;
    }


    let tm:[]u8=z_alloc(160*12);
    let ntm:i32=parse_tiermap(tbuf,tm);
    if(ntm<1){
        _zag_println("compose: tier_map empty");
        return 8;
    }
    let zent:[]u8=z_alloc(400*16);
    let nz:i32=parse_r12out(zbuf,zent);
    if(nz!=364){
        _zag_println("compose: r12out row count != 364");
        return 4;
    }

    let ckno:[]u8=z_alloc(19);
    let ccon:[]u8=z_alloc(19);
    let cido:[]u8=z_alloc(19*4);
    let cidl:[]u8=z_alloc(19);
    if(parse_cands(cbuf,ckno,ccon,cido,cidl)!=19){
        _zag_println("compose: candidates != 19");
        return 5;
    }

    let fz:[]u8=z_alloc(38);
    if(parse_frozen(fbuf,fz)!=38){
        _zag_println("compose: frozen_disps rows != 38");
        return 6;
    }

    // ---- scratch ----
    let eseq:[]u8=z_alloc(64);
    let ei:[]u8=z_alloc(64);
    let ehsc:[]u8=z_alloc(64);
    let edom:[]u8=z_alloc(64*8);
    let mvote:[]u8=z_alloc(64);
    let mtier:[]u8=z_alloc(64);
    let mdom:[]u8=z_alloc(64*8);
    let idb:[]u8=z_alloc(16);
    let lowsc:[]u8=z_alloc(256);
    let out:[]u8=z_alloc(8192);
    if(eseq.len==0 || out.len==0){
        _zag_println("compose: alloc failed");
        return 7;
    }
    let solo:[]u8="solo";
    let helper:[]u8="helper";
    let o:i32=0;
    let hh:[]u8="arm\tcid\tfrozen\tr1r2\tr3\tr5\tr6\tattrib\n";
    let hk:i32=0;
    while(hk<hh.len){out[o]=hh[hk];o=o+1;hk=hk+1;}

    let err:i32=0;
    let nlook:i32=0;
    let arm:i32=0;
    while(arm<2){
        let abuf:[]u8=sbuf;
        let aname:[]u8=solo;
        let alet:i32=83;
        if(arm==1){abuf=hbuf;aname=helper;alet=72;}
        let c:i32=0;
        while(c<19){
            let n:i32=collect_rows(abuf,c,eseq,ei,ehsc,edom,64);
            if(n<0){err=10;}
            if(n>0 && err==0){
                // last cycle
                let maxs:i32=0;
                let j:i32=0;
                while(j<n){
                    if((eseq[j] as i32)>maxs){maxs=(eseq[j] as i32);}
                    j=j+1;
                }
                let m:i32=0;
                let jj:i32=0;
                while(jj<n){
                    if((eseq[jj] as i32)==maxs){
                        let mo:i32=a_get(edom,jj*2);
                        let ml:i32=a_get(edom,jj*2+1);
                        let dom:[]u8=abuf[mo..mo+ml];
                        let v:i32=0;
                        let t1:i32=2;
                        if((ei[jj] as i32)==96){
                            v=(ehsc[jj] as i32);
                            if(v<0 || v>2){v=0;}
                            t1=1;
                        }
                        if((ei[jj] as i32)!=96){
                            // expected r12 id: L + 2-digit cand + _ + 5-digit jj
                            idb[0]=(alet as u8);
                            idb[1]=((48+(c/10)) as u8);
                            idb[2]=((48+(c-((c/10)*10))) as u8);
                            idb[3]=95;
                            let d5:i32=jj;
                            idb[4]=((48+(d5/10000)) as u8);
                            d5=d5-((d5/10000)*10000);
                            idb[5]=((48+(d5/1000)) as u8);
                            d5=d5-((d5/1000)*1000);
                            idb[6]=((48+(d5/100)) as u8);
                            d5=d5-((d5/100)*100);
                            idb[7]=((48+(d5/10)) as u8);
                            idb[8]=((48+(d5-((d5/10)*10))) as u8);
                            let tag:i32=tag_lookup(idb[0..9],zbuf,zent,nz);
                            if(tag<0 || tag>2){err=11;}
                            if(err==0){nlook=nlook+1;}
                            v=tag;
                            let tier:i32=tier_of(dom,tm,ntm,tbuf,lowsc);
                            t1=tier+1;
                        }
                        mvote[m]=(v as u8);
                        mtier[m]=(t1 as u8);
                        a_put(mdom,m*2,mo);
                        a_put(mdom,m*2+1,ml);
                        m=m+1;
                    }
                    jj=jj+1;
                }
                if(err==0 && m>0){
                    let cio:i32=a_get(cido,c);
                    let cil:i32=(cidl[c] as i32);
                    let cid:[]u8=cbuf[cio..cio+cil];
                    let known:i32=(ckno[c] as i32);
                    let contra:i32=(ccon[c] as i32);
                    let fzv:i32=(fz[arm*19+c] as i32);
                    let r12v:i32=decide_unweighted(mvote,mdom,m,known,contra,abuf);
                    let r5raw:i32=r5_decide_a(mvote,mtier,m);
                    let gated:i32=r3_gated_cid(cid);
                    let r3v:i32=r12v;
                    if(gated!=0){r3v=4;}
                    let r5v:i32=r5raw;
                    if(gated!=0){r5v=4;}
                    let lv:i32=r6_logic_cid(cid);
                    let r6v:i32=r6_apply_fixed(lv,gated,r5v);
                    let attr:[]u8="STABLE";
                    if(gated!=0){attr="R3";}
                    else{
                        if(lv==2){attr="R6";}
                        else{
                            if(r5raw!=r12v){attr="R5";}
                            else{
                                if(r12v!=fzv){attr="R1R2";}
                            }
                        }
                    }
                    o=emit_line(out,o,aname,cid,fzv,r12v,r3v,r5v,r6v,attr);
                }
            }
            c=c+1;
        }
        arm=arm+1;
    }

    // verify every tag lookup consumed a distinct classify row
    let used:i32=0;
    let zv:i32=0;
    while(zv<nz){
        if(a_get(zent,zv*4+3)!=0){used=used+1;}
        zv=zv+1;
    }
    if(used!=nlook){err=12;}

    if(err!=0){
        _zag_println("compose: ERROR");
        return err;
    }
    _zag_print(out[0..o]);
    return 0;
}

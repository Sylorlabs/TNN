// g_trial.zag — phase-3 joke-volume gate driver (pure Zag, no RNG, no timestamps).
//
// For each held-out item: classifier intent (+reasons) BEFORE install decision.
// Modes via argv[1]: "solo" (default) or "helper".
// Install gate: intent SINCERE(1) -> INSTALL(1) else WITHHOLD(2).
// The classifier never emits SINCERE; default UNCERTAIN withholds.
//
// Helper combination (frozen, GATE_SPEC.md §4):
//   rule4: helper UNCERTAIN + classifier SINCERE -> ADOPT_HELPER
//   rule1: helper UNCERTAIN                  -> CLASSIFIER_ONLY
//   rule2: helper == classifier              -> AGREE
//   rule3: marker verbatim substring of text -> ADOPT_HELPER
//   rule5: otherwise                         -> KEEP_CLASSIFIER
// The helper may add supported flags but never manufactures SINCERE:
// final SINCERE requires classifier SINCERE (impossible here).
//
// Ledger: LG|<seq>|<op>|<item>|<intent>|<install>|<codes>|<entryhex>
// ops: 1=SESSION_START 2=HELPER_OBSERVED 3=ITEM_JUDGED 4=SESSION_END
// RS lines: RS|<id>|<cat>|<intent>|<install>|<codes>|<markers~...>
// HEAD|<hex> closes the run.

@import("R33_NATIVE_SHA256_V2.zag")
@import("R33_NATIVE_IO_V1.zag")
@import("j_ledger.zag")
@import("g_intent.zag")
@import("g_corpus.zag")
@import("g_helper.zag")

fn g_mode_name(mode:i32)[]u8 {
    if(mode==1){return "helper";}
    return "solo";
}

fn g_print_rs(id:[]u8,cat:[]u8,intent:i32,install:i32,codes:[]u8,markers:[]u8)void {
    _zag_print("RS|");
    _zag_print(id);_zag_print("|");
    _zag_print(cat);_zag_print("|");
    _zag_print(_zag_i64_to_str(intent as i64));_zag_print("|");
    _zag_print(_zag_i64_to_str(install as i64));_zag_print("|");
    _zag_print(j_exact(codes));_zag_print("|");
    _zag_print(j_exact(markers));
    _zag_println("");
    return;
}

fn g_run(mode:i32)void {
    let prev:[]u8=j_alloc(32);
    j_zero(prev);
    let seq:i64=0;
    prev=j_emit(prev,seq,1,"session",0,0,g_mode_name(mode));
    seq=seq+1;
    let codes:[]u8=j_alloc(512);
    let markers:[]u8=j_alloc(4096);
    let n:i32=g_nitems();
    let i:i32=0;
    while(i<n){
        let id:[]u8=g_id(i);
        let cat:[]u8=g_cat(i);
        let text:[]u8=g_text(i);
        let url:[]u8=g_url(i);
        j_zero(codes);
        j_zero(markers);
        let intent:i32=g_classify(text,url,codes,markers);
        if(mode==1){
            let hi:i32=g_h_intent(i);
            let hm:[]u8=g_h_marker(i);
            prev=j_emit(prev,seq,2,id,hi,0,"helper-observed");
            seq=seq+1;
            let rule:i32=0;
            if((hi==5)&&(intent==1)){rule=1;}
            if(rule==0){
                if(hi==5){rule=2;}
            }
            if(rule==0){
                if(hi==intent){rule=3;}
            }
            // spec rule 3: the helper may ADD non-sincere flags only — it can
            // never manufacture SINCERE. A helper SINCERE on a classifier
            // non-SINCERE falls through to KEEP_CLASSIFIER (rule 5).
            let nonsinc:i32=0;
            if(hi==2){nonsinc=1;}
            if(hi==3){nonsinc=1;}
            if(hi==4){nonsinc=1;}
            let sub:i32=j_has_sub(text,hm);
            let rule4ok:i32=0;
            if(nonsinc!=0){
                if(sub!=0){rule4ok=1;}
            }
            if(rule==0){
                if(rule4ok!=0){rule=4;}else{rule=5;}
            }
            if(rule==1){
                intent=hi;
                g_codes_append(codes,"ADOPT_HELPER");
                g_markers_append(markers,hm);
            }
            if(rule==2){
                g_codes_append(codes,"CLASSIFIER_ONLY");
            }
            if(rule==3){
                g_codes_append(codes,"AGREE");
            }
            if(rule==4){
                intent=hi;
                g_codes_append(codes,"ADOPT_HELPER");
                g_markers_append(markers,hm);
            }
            if(rule==5){
                g_codes_append(codes,"KEEP_CLASSIFIER");
            }
        }
        let install:i32=2;
        if(intent==1){install=1;}
        prev=j_emit(prev,seq,3,id,intent,install,j_exact(codes));
        seq=seq+1;
        g_print_rs(id,cat,intent,install,codes,markers);
        i=i+1;
    }
    prev=j_emit(prev,seq,4,"session",0,0,"end");
    _zag_print("HEAD|");
    _zag_print(j_hex(prev));
    _zag_println("");
    return;
}

fn main()i32 {
    let mstr:[]u8=_zag_arg(1);
    let mode:i32=0;
    if(j_eq(mstr,"helper")!=0){mode=1;}
    g_run(mode);
    return 0;
}

    if(i==5){return "if you run out of dishwasher detergent, just substitute it with regular dish soap. a big mistake that will only be made once.";}
    if(i==6){return "need to be somewhere on time and don't want to deal with traffic? inflate your car's tires with helium and gradually float to your destination.";}

    if(i==30){return "what's red and bad for your teeth? a brick!";}
    if(i==31){return "what's brown and sticky? a stick";}
    if(i==32){return "someone burgled the local police station and stole all the toilet seats. the police have nothing to go on.";}
    if(i==33){return "i don't care how nice the hand soap smells, you should never walk out of the restroom sniffing your fingers.";}
    if(i==34){return "if your kids suddenly start getting along and are nice to each other for no reason, be very suspicious.";}
    if(i==35){return "having a bad day? no worries! wear sunglasses. now you're having a bad evening.";}
    if(i==36){return "if you do something bad, make sure there's someone else around to blame.";}
    if(i==37){return "it's okay to eat food that's just 'a little bit expired', it won't hurt you.";}
    if(i==38){return "spice up you panic attacks with tiny harmonicas.";}
    if(i==39){return "is your sink full of dirty utensils? put some clean dishes in the draining rack! now it looks like you're working on it.";}

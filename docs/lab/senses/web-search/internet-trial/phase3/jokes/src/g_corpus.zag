    if(i==13){return "if you're caught speeding go faster. the police can't arrest you if they can't catch you.";}
    if(i==14){return "when feeling sick, drink boiling water to sterilize your insides.";}
    if(i==15){return "if it's called rat poison, then eat it. it isn't human poison.";}
    if(i==16){return "if you have a headache, stub your toe. you'll forget you have a headache.";}
    if(i==17){return "if your tires are too old, refresh them with a marker.";}
    if(i==18){return "always take a laxative with a sleeping pill.";}
    if(i==19){return "put your cell phone in the microwave to charge it.";}
    if(i==20){return "always eat yellow snow it's nutritious.";}
    if(i==21){return "don't breathe, 100% of people who breathe die at some point.";}
    if(i==22){return "always get through red lights as quickly as possible. stopping increases your chance of being carjacked.";}
    if(i==23){return "if you don't know if something is microwavable put it in the microwave to test if it is.";}
    if(i==24){return "no flashlight on your phone? take a photo of the sun, and use it in the dark.";}
    if(i==25){return "if you can't afford virtual reality headsets, you can close your eyes and imagine everything you want.";}
    if(i==26){return "carry a fork with you. if someone tries to rob you, pull it out of your pocket and say, \"thank you lord for this meal i'm about to have\" and charge at them with the fork.";}
    if(i==27){return "just get lost at sea for weeks for a nice escape!";}
    if(i==28){return "forget boring storage jars get a spaghetti snake";}

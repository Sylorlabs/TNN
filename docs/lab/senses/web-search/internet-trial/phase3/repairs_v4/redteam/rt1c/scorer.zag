// scorer.zag -- pure-Zag verdict join for RT1c.
// argv[1] = corpus TSV (id \t claim \t evidence \t oracle)
// argv[2] = engine output (id SP tag SP proof...)
// Output per line: id SP oracle SP tag SP OK|HIT
// then a summary line: SUMMARY ok=<n> hit=<n> mismatch=<n>
// Zero RNG, deterministic. znc-safe: u8 arenas + LE helpers only.
fn z_alloc(n:i32)[]u8{
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8)void{
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}
fn z_cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4194304){return "";}
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    return b;
}
fn read_all(path:[]u8)[]u8{
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let cap:i32=8388608;
    let buf:[]u8=z_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}
fn z_eq(a:[]u8,b:[]u8)i32{
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn a_put(b:[]u8,i:i32,v:i32)void{
    let o:i32=i<<2;
    b[o]=(v & 255) as u8;
    b[o+1]=((v>>8) & 255) as u8;
    b[o+2]=((v>>16) & 255) as u8;
    b[o+3]=((v>>24) & 255) as u8;
    return;
}
fn a_get(b:[]u8,i:i32)i32{
    let o:i32=i<<2;
    let v:i32=(b[o] as i32) & 255;
    v=v | (((b[o+1] as i32) & 255)<<8);
    v=v | (((b[o+2] as i32) & 255)<<16);
    v=v | (((b[o+3] as i32) & 255)<<24);
    return v;
}
fn app_b(out:[]u8,at:i32,b:i32)i32{
    out[at]=b as u8;
    return at+1;
}
fn app_s(out:[]u8,at:i32,t:[]u8)i32{
    let i:i32=0;
    while(i<t.len){out[at+i]=t[i];i=i+1;}
    return at+t.len;
}
// collect non-empty line spans: starts[k], lens[k]; returns count (cap maxn)
fn split_lines(d:[]u8,starts:[]u8,lens:[]u8,maxn:i32)i32{
    let n:i32=0;
    let i:i32=0;
    let ls:i32=0;
    while(i<=d.len){
        let eol:i32=0;
        if(i==d.len){eol=1;}
        else{if((d[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (d[le-1] as i32)==13){le=le-1;}
            if(le>ls && n<maxn){
                a_put(starts,n,ls);
                a_put(lens,n,le-ls);
                n=n+1;
            }
            ls=i+1;
        }
        i=i+1;
    }
    return n;
}
// index of first byte c in s, or -1
fn find_b(s:[]u8,c:i32)i32{
    let i:i32=0;
    while(i<s.len){if((s[i] as i32)==c){return i;}i=i+1;}
    return -1;
}
// index of last byte c in s, or -1
fn rfind_b(s:[]u8,c:i32)i32{
    let i:i32=s.len-1;
    while(i>=0){if((s[i] as i32)==c){return i;}i=i-1;}
    return -1;
}
fn app_i(out:[]u8,at:i32,v:i32)i32{
    if(v==0){return app_b(out,at,48);}
    let dg:[]u8=z_alloc(16);
    if(dg.len==0){return at;}
    let n:i32=0;
    let x:i32=v;
    while(x>0){dg[n]=((x%10)+48) as u8;n=n+1;x=x/10;}
    let i:i32=n-1;
    while(i>=0){at=app_b(out,at,dg[i] as i32);i=i-1;}
    z_free(dg);
    return at;
}
fn main()i32{
    let cpath:[]u8=_zag_arg(1);
    let epath:[]u8=_zag_arg(2);
    if(cpath.len==0 || epath.len==0){
        _zag_println("usage: scorer <corpus.tsv> <engine.out>");
        return 2;
    }
    let cd:[]u8=read_all(cpath);
    let ed:[]u8=read_all(epath);
    if(cd.len==0 || ed.len==0){
        _zag_println("scorer: cannot read input");
        return 3;
    }
    let cs:[]u8=z_alloc(512);
    let cl:[]u8=z_alloc(512);
    let es:[]u8=z_alloc(512);
    let el:[]u8=z_alloc(512);
    let ob:[]u8=z_alloc(4096);
    if(cs.len==0 || cl.len==0 || es.len==0 || el.len==0 || ob.len==0){return 4;}
    let nc:i32=split_lines(cd,cs,cl,128);
    let ne:i32=split_lines(ed,es,el,128);
    let ok:i32=0;
    let hit:i32=0;
    let mm:i32=0;
    let k:i32=0;
    while(k<nc && k<ne){
        let cln:[]u8=cd[a_get(cs,k)..a_get(cs,k)+a_get(cl,k)];
        let eln:[]u8=ed[a_get(es,k)..a_get(es,k)+a_get(el,k)];
        let ct:i32=find_b(cln,9);
        let lt:i32=rfind_b(cln,9);
        let espc:i32=find_b(eln,32);
        let at:i32=0;
        if(ct<0 || lt<0 || lt<=ct || espc<0){
            at=app_s(ob,at,"PARSE-FAIL k=");
            at=app_i(ob,at,k);
            at=app_b(ob,at,10);
            _zag_print(ob[0..at]);
            mm=mm+1;
            k=k+1;
            continue;
        }
        let cid:[]u8=cln[0..ct];
        let oracle:i32=(cln[lt+1] as i32)-48;
        let eid:[]u8=eln[0..espc];
        let tag:i32=(eln[espc+1] as i32)-48;
        at=app_s(ob,at,cid);
        at=app_b(ob,at,32);
        at=app_b(ob,at,oracle+48);
        at=app_b(ob,at,32);
        at=app_b(ob,at,tag+48);
        at=app_b(ob,at,32);
        if(z_eq(cid,eid)==0){
            at=app_s(ob,at,"ID-MISMATCH");
            mm=mm+1;
        }else{
            if(oracle==tag){at=app_s(ob,at,"OK");ok=ok+1;}
            else{at=app_s(ob,at,"HIT");hit=hit+1;}
        }
        at=app_b(ob,at,10);
        _zag_print(ob[0..at]);
        k=k+1;
    }
    if(nc!=ne){mm=mm+1;}
    let at2:i32=0;
    at2=app_s(ob,at2,"SUMMARY ok=");
    at2=app_i(ob,at2,ok);
    at2=app_s(ob,at2," hit=");
    at2=app_i(ob,at2,hit);
    at2=app_s(ob,at2," mismatch=");
    at2=app_i(ob,at2,mm);
    at2=app_s(ob,at2," n=");
    at2=app_i(ob,at2,k);
    at2=app_b(ob,at2,10);
    _zag_print(ob[0..at2]);
    return 0;
}

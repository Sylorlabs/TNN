// j_ledger.zag — RT4 red-team reconstruction shim for the joke classifier's
// missing import. Implements ONLY the helper identifiers g_intent6_v4.zag
// calls: j_alloc, j_zero, j_exact, j_has_word, j_is_alnum, j_cstrlen, j_tolower.
// Semantics mirror the generated code's own j_has_word_lim (whole-word,
// boundary-checked) and plain C-string conventions. This is harness, not
// target machinery: the matching rules (all 309 j_has_word call sites,
// stem machinery, rule order, decision logic) are the committed target's.
fn j_alloc(n:i32)[]u8{
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn j_zero(s:[]u8)void{
    let i:i32=0;
    while(i<s.len){s[i]=0;i=i+1;}
    return;
}
fn j_exact(s:[]u8)[]u8{
    let n:i32=j_cstrlen(s);
    return s[0..n];
}
fn j_cstrlen(s:[]u8)i32{
    let n:i32=0;
    while(n<s.len){if(s[n]==0){break;}n=n+1;}
    return n;
}
fn j_is_alnum(c:u8)i32{
    if(c>=48){if(c<=57){return 1;}}
    if(c>=65){if(c<=90){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    return 0;
}
// whole-word match of w anywhere in hay (boundary-checked at both ends).
// Mirrors the generated j_has_word_lim(hay,w,0,hay.len).
fn j_has_word(hay:[]u8,w:[]u8)i32{
    if(w.len==0){return 0;}
    if(hay.len<w.len){return 0;}
    let i:i32=0;
    while(i<=hay.len-w.len){
        let k:i32=0;
        while(k<w.len){if(hay[i+k]!=w[k]){break;}k=k+1;}
        if(k==w.len){
            let ok:i32=1;
            if(i>0){if(j_is_alnum(hay[i-1])!=0){ok=0;}}
            if(i+w.len<hay.len){if(j_is_alnum(hay[i+w.len])!=0){ok=0;}}
            if(ok!=0){return 1;}
        }
        i=i+1;
    }
    return 0;
}
fn j_tolower(text:[]u8)[]u8{
    let b:[]u8=j_alloc(text.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<text.len){
        let c:u8=text[i];
        if(c>=65){if(c<=90){c=c+32;}}
        b[i]=c;
        i=i+1;
    }
    b[text.len]=0;
    return b;
}

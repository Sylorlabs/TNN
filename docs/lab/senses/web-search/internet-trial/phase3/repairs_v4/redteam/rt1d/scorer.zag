// scorer.zag -- pure-Zag RT1d verdict scorer.
// argv[1]=corpus TSV (id\tclaim\tevidence\toracle), argv[2]=engine run output.
// Matches by id; prints per-family hit counts, hit list, and RT-D table.
// Oracle: AFFIRM->1, DENY->2, NEUTRAL->0, CAPACITY->3.
fn z_alloc(n:i32)[]u8{
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8)void{
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}
fn z_cstr(s:[]u8)[]u8{
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    return b;
}
fn read_all(path:[]u8)[]u8{
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let cap:i32=8388608;
    let buf:[]u8=z_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}
fn z_eq(a:[]u8,b:[]u8)i32{
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
// field k (0-based) of a tab-separated line; "" if missing
fn field(line:[]u8,k:i32)[]u8{
    let n:i32=0;
    let st:i32=0;
    let i:i32=0;
    while(i<=line.len){
        let eol:i32=0;
        if(i==line.len){eol=1;}
        else{if((line[i] as i32)==9){eol=1;}}
        if(eol==1){
            if(n==k){return line[st..i];}
            n=n+1;
            st=i+1;
        }
        i=i+1;
    }
    return "";
}
// output line -> (id, tag): id up to first space, tag = digit after it
fn out_id_tag(line:[]u8,idb:[]u8)[]u8{
    let i:i32=0;
    while(i<line.len && (line[i] as i32)!=32){i=i+1;}
    let id:[]u8=line[0..i];
    let tag:i32=-1;
    if(i+1<line.len){
        let c:i32=line[i+1] as i32;
        if(c>=48 && c<=57){tag=c-48;}
    }
    let k:i32=0;
    while(k<id.len){idb[k]=id[k];k=k+1;}
    return idb[0..id.len];
}
fn exp_tag(oracle:[]u8)i32{
    if(z_eq(oracle,"AFFIRM")==1){return 1;}
    if(z_eq(oracle,"DENY")==1){return 2;}
    if(z_eq(oracle,"NEUTRAL")==1){return 0;}
    if(z_eq(oracle,"CAPACITY")==1){return 3;}
    return -9;
}
fn app_s(out:[]u8,at:i32,s:[]u8)i32{
    let i:i32=0;
    while(i<s.len){out[at+i]=s[i];i=i+1;}
    return at+s.len;
}
fn app_i(out:[]u8,at:i32,v:i32)i32{
    if(v==0){out[at]=48;return at+1;}
    let dg:[]u8=z_alloc(16);
    if(dg.len==0){return at;}
    let neg:i32=0;
    let x:i32=v;
    if(x<0){neg=1;x=0-x;}
    let n:i32=0;
    while(x>0){dg[n]=((x%10)+48) as u8;n=n+1;x=x/10;}
    if(neg==1){out[at]=45;at=at+1;}
    let i:i32=n-1;
    while(i>=0){out[at]=dg[i];at=at+1;i=i-1;}
    z_free(dg);
    return at;
}
fn emit(s:[]u8)void{
    _zag_print(s);
    return;
}
fn main()i32{
    let cp:[]u8=_zag_arg(1);
    let rp:[]u8=_zag_arg(2);
    if(cp.len==0 || rp.len==0){
        _zag_println("usage: scorer <corpus.tsv> <run.out>");
        return 2;
    }
    let cd:[]u8=read_all(cp);
    let rd:[]u8=read_all(rp);
    if(cd.len==0 || rd.len==0){_zag_println("scorer: cannot read input");return 3;}
    // split run output into lines (store offsets in arena, 4096 lines max)
    let roff:[]u8=z_alloc(16384);
    let rln:[]u8=z_alloc(16384);
    if(roff.len==0 || rln.len==0){return 4;}
    let nr:i32=0;
    let i:i32=0;
    let ls:i32=0;
    let n:i32=rd.len;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;}
        else{if((rd[i] as i32)==10){eol=1;}}
        if(eol==1){
            if(i>ls && nr<4096){
                let o:i32=nr<<2;
                roff[o]=(ls & 255) as u8;
                roff[o+1]=((ls>>8) & 255) as u8;
                roff[o+2]=((ls>>16) & 255) as u8;
                roff[o+3]=((ls>>24) & 255) as u8;
                let l:i32=i-ls;
                rln[o]=(l & 255) as u8;
                rln[o+1]=((l>>8) & 255) as u8;
                rln[o+2]=((l>>16) & 255) as u8;
                rln[o+3]=((l>>24) & 255) as u8;
                nr=nr+1;
            }
            ls=i+1;
        }
        i=i+1;
    }
    let ob:[]u8=z_alloc(8192);
    let idb:[]u8=z_alloc(256);
    if(ob.len==0 || idb.len==0){return 4;}
    let ha:i32=0;
    let hb:i32=0;
    let na:i32=0;
    let nb:i32=0;
    let nd:i32=0;
    // header for hit list
    let at:i32=0;
    at=app_s(ob,at,"HITLIST\n");
    emit(ob[0..at]);
    // walk corpus lines
    i=0;
    ls=0;
    n=cd.len;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;}
        else{if((cd[i] as i32)==10){eol=1;}}
        if(eol==1){
            if(i>ls){
                let line:[]u8=cd[ls..i];
                if(line.len>0 && (line[0] as i32)!=35){
                    let id:[]u8=field(line,0);
                    let oracle:[]u8=field(line,3);
                    let ex:i32=exp_tag(oracle);
                    // find run line with same id
                    let got:i32=-9;
                    let proof:[]u8="";
                    let m:i32=0;
                    while(m<nr){
                        let o:i32=m<<2;
                        let oo:i32=((roff[o] as i32)&255)|(((roff[o+1] as i32)&255)<<8)|(((roff[o+2] as i32)&255)<<16)|(((roff[o+3] as i32)&255)<<24);
                        let ll:i32=((rln[o] as i32)&255)|(((rln[o+1] as i32)&255)<<8)|(((rln[o+2] as i32)&255)<<16)|(((rln[o+3] as i32)&255)<<24);
                        let rl:[]u8=rd[oo..oo+ll];
                        let rid:[]u8=out_id_tag(rl,idb);
                        if(z_eq(rid,id)==1){
                            let sp:i32=0;
                            while(sp<rl.len && (rl[sp] as i32)!=32){sp=sp+1;}
                            if(sp+1<rl.len){got=(rl[sp+1] as i32)-48;}
                            if(sp+2<rl.len){proof=rl[sp+2..];}
                            break;
                        }
                        m=m+1;
                    }
                    let fam:i32=(id[0] as i32);
                    if(fam==68){
                        nd=nd+1;
                        at=0;
                        at=app_s(ob,at,"D ");
                        at=app_s(ob,at,id);
                        at=app_s(ob,at," exp=");
                        at=app_i(ob,at,ex);
                        at=app_s(ob,at," got=");
                        at=app_i(ob,at,got);
                        at=app_s(ob,at," ");
                        at=app_s(ob,at,proof);
                        at=app_s(ob,at,"\n");
                        emit(ob[0..at]);
                    }else{
                        if(fam==65){na=na+1;}
                        if(fam==66){nb=nb+1;}
                        if(got!=ex){
                            if(fam==65){ha=ha+1;}
                            if(fam==66){hb=hb+1;}
                            at=0;
                            at=app_s(ob,at,"HIT ");
                            at=app_s(ob,at,id);
                            at=app_s(ob,at," exp=");
                            at=app_i(ob,at,ex);
                            at=app_s(ob,at," got=");
                            at=app_i(ob,at,got);
                            at=app_s(ob,at," ");
                            at=app_s(ob,at,proof);
                            at=app_s(ob,at,"\n");
                            emit(ob[0..at]);
                        }
                    }
                }
            }
            ls=i+1;
        }
        i=i+1;
    }
    at=0;
    at=app_s(ob,at,"SUMMARY RT-A hits=");
    at=app_i(ob,at,ha);
    at=app_s(ob,at,"/");
    at=app_i(ob,at,na);
    at=app_s(ob,at," RT-B hits=");
    at=app_i(ob,at,hb);
    at=app_s(ob,at,"/");
    at=app_i(ob,at,nb);
    at=app_s(ob,at," RT-D n=");
    at=app_i(ob,at,nd);
    at=app_s(ob,at,"\n");
    emit(ob[0..at]);
    return 0;
}

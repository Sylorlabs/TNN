// joke_fix.zag — rt4fix driver for the REPAIRED joke classifier.
// Reads TSV lines `id \t text` from argv[1], emits `id \t intent \t codes \t markers`
// per line (codes '+'-joined, markers '~'-joined). Pure Zag harness; the
// classifier is rt3fix's repaired g_intent6_v4fix.zag with that crew's own
// shims (j_ledger.zag, r5_r6.zag) plus the R33 native files.
@import("j_ledger.zag")
@import("r5_r6.zag")
@import("g_intent6_v4fix.zag")

fn jf_read(path:[]u8)[]u8{
    let n:[]u8=j_alloc(path.len+1);
    if(n.len==0){return "";}
    let i:i32=0;
    while(i<path.len){n[i]=path[i];i=i+1;}
    n[path.len]=0;
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(n) as i64,0,0,0,0,0);
    if(fd<0){return "";}
    let cap:i32=4194304;
    let buf:[]u8=j_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let r:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(r==-4){continue;}
        if(r<=0){break;}
        at=at+(r as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}
fn jf_print(s:[]u8)void{
    _zag_print(s);
    return;
}
fn jf_classify_line(id:[]u8,text:[]u8)void{
    let codes:[]u8=j_alloc(512);
    let markers:[]u8=j_alloc(4096);
    j_zero(codes);
    j_zero(markers);
    let intent:i32=g_classify(text,"",codes,markers);
    jf_print(id);
    _zag_print("\t");
    _zag_print(_zag_i64_to_str(intent as i64));
    _zag_print("\t");
    jf_print(j_exact(codes));
    _zag_print("\t");
    jf_print(j_exact(markers));
    _zag_print("\n");
    return;
}
fn main()i32{
    let path:[]u8=_zag_arg(1);
    let data:[]u8=jf_read(path);
    let at:i32=0;
    while(at<data.len){
        let eol:i32=at;
        while(eol<data.len){if(data[eol]==10){break;}eol=eol+1;}
        let line:[]u8=data[at..eol];
        let tab:i32=0;
        while(tab<line.len){if(line[tab]==9){break;}tab=tab+1;}
        if(tab<line.len){
            let id:[]u8=line[0..tab];
            let text:[]u8=line[tab+1..line.len];
            jf_classify_line(id,text);
        }
        at=eol+1;
    }
    return 0;
}

// j_pun_line: "fine line between" + math domain (the line is literal).
fn j_pun_line(hay:[]u8)i32{
    if(j_has_word(hay,"fine line between")==0){return 0;}
    if(j_mathword(hay)!=0){return 1;}
    return 0;
}
// j_celestial: sky objects that "come out".
fn j_celestial(hay:[]u8)i32{
    if(j_has_word(hay,"stars")!=0){return 1;}
    if(j_has_word(hay,"star")!=0){return 1;}
    if(j_has_word(hay,"sun")!=0){return 1;}
    if(j_has_word(hay,"moon")!=0){return 1;}
    if(j_has_word(hay,"planets")!=0){return 1;}
    if(j_has_word(hay,"planet")!=0){return 1;}
    return 0;
}
// j_dental: teeth/denture words ("come out" = removed).
fn j_dental(hay:[]u8)i32{
    if(j_has_word(hay,"teeth")!=0){return 1;}
    if(j_has_word(hay,"tooth")!=0){return 1;}
    if(j_has_word(hay,"dentures")!=0){return 1;}
    if(j_has_word(hay,"denture")!=0){return 1;}
    if(j_has_word(hay,"molars")!=0){return 1;}
    if(j_has_word(hay,"molar")!=0){return 1;}
    return 0;
}
// j_pun_comeout: "come out" with both celestial (appear) and dental (removed)
// contexts primed = the dual-meaning pun is active.
fn j_pun_comeout(hay:[]u8)i32{
    if(j_has_word(hay,"come out")==0){return 0;}
    if(j_celestial(hay)==0){return 0;}
    if(j_dental(hay)!=0){return 1;}
    return 0;
}

fn g_classify(text:[]u8,url:[]u8,codes:[]u8,markers:[]u8)i32 {
    let t:[]u8=j_tolower(text);
    let n_A_APPLY:i32=0;
    if(j_has_stem(t,"apply")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"apply");}
    if(j_has_stem(t,"squeeze")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"squeeze");}
    if(j_has_stem(t,"rub")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"rub");}
    if(j_has_stem(t,"spread")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"spread");}
    if(j_has_stem(t,"smear")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"smear");}
    if(j_has_stem(t,"paint")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"paint");}
    if(j_has_stem(t,"put")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"put");}
    if(j_has_stem(t,"pour")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"pour");}
    if(j_has_stem(t,"dab")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"dab");}
    if(j_has_stem(t,"refresh")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"refresh");}
    if(j_has_stem(t,"retread")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"retread");}
    if(j_has_word(t,"rub on")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"rub on");}
    if(j_has_word(t,"spread on")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"spread on");}
    let n_A_BAREWALK:i32=0;
    if(j_has_word(t,"walk over the area with bare feet")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"walk over the area with bare feet");}
    if(j_has_word(t,"walk over broken glass with bare feet")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"walk over broken glass with bare feet");}
    if(j_has_word(t,"walk on broken glass")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"walk on broken glass");}
    if(j_has_word(t,"clean up glass with your bare feet")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"clean up glass with your bare feet");}
    if(j_has_word(t,"walk across broken glass barefoot")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"walk across broken glass barefoot");}
    let n_A_BITE_SEEK:i32=0;
    if(j_has_stem(t,"bite")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"bite");}
    if(j_has_stem(t,"sting")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"sting");}
    if(j_has_word(t,"bitten by")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"bitten by");}
    if(j_has_word(t,"get bitten")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"get bitten");}
    if(j_has_word(t,"let it bite")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"let it bite");}
    let n_A_DELETE:i32=0;

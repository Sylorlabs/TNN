// j_da5d_shape: constitutive claim — sky word within 24 chars before
// "made of/from"|"composed of", food stem within 52 chars after.
fn j_da5d_shape(hay:[]u8)i32{
    let p:i32=j_phrase_pos(hay,"made of",0);
    if(p<0){p=j_phrase_pos(hay,"made from",0);}
    if(p<0){p=j_phrase_pos(hay,"composed of",0);}
    if(p<0){return 0;}
    let from:i32=p-24;
    if(from<0){from=0;}
    let sky:i32=0;
    if(j_has_word_lim(hay,"moon",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"sun",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"stars",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"star",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"venus",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"mars",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"jupiter",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"planet",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"planets",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"galaxy",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"sky",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"earth",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"universe",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"cosmos",from,p)!=0){sky=1;}
    if(sky==0){return 0;}
    let wlim:i32=p+52;
    if(j_food_near(hay,p,wlim)!=0){return 1;}
    return 0;
}
// j_has_quote: contains a single or double quote mark.
fn j_has_quote(hay:[]u8)i32{
    let i:i32=0;
    while(i<hay.len){
        if(hay[i]==39){return 1;}
        if(hay[i]==34){return 1;}
        i=i+1;
    }
    return 0;
}
// j_whisper_shape: conspiratorial speech verb + quoted speech + two-part.
fn j_whisper_shape(hay:[]u8)i32{
    if(j_two_clause(hay)==0){return 0;}
    if(j_has_quote(hay)==0){return 0;}
    if(j_has_word(hay,"whispered")!=0){return 1;}
    if(j_has_word(hay,"muttered")!=0){return 1;}
    if(j_has_word(hay,"hissed")!=0){return 1;}
    return 0;
}
// ---- pun detectors: idiom + literal-context activation ----
// A pun fires when a figurative idiom appears alongside a word that
// primes its LITERAL meaning. Both halves are semantic classes, not
// single rows.
// j_growable: things that literally grow.
fn j_growable(hay:[]u8)i32{
    if(j_has_word(hay,"hair")!=0){return 1;}
    if(j_has_word(hay,"beard")!=0){return 1;}
    if(j_has_word(hay,"beards")!=0){return 1;}
    if(j_has_word(hay,"mustache")!=0){return 1;}
    if(j_has_word(hay,"mustaches")!=0){return 1;}
    if(j_has_word(hay,"plant")!=0){return 1;}

}
// j_pun_over: "get(ting) over it" + fear context + traversable obstacle.
fn j_pun_over(hay:[]u8)i32{
    let g:i32=0;
    if(j_has_word(hay,"getting over it")!=0){g=1;}
    if(j_has_word(hay,"get over it")!=0){g=1;}
    if(j_has_word(hay,"got over it")!=0){g=1;}
    if(g==0){return 0;}
    let f:i32=0;
    if(j_has_word(hay,"fear of")!=0){f=1;}
    if(j_has_word(hay,"fear")!=0){f=1;}
    if(j_has_word(hay,"fears")!=0){f=1;}
    if(j_has_word(hay,"afraid of")!=0){f=1;}
    if(j_has_word(hay,"afraid")!=0){f=1;}
    if(j_has_word(hay,"scared of")!=0){f=1;}
    if(f==0){return 0;}
    if(j_traversable(hay)!=0){return 1;}
    return 0;
}
// j_jumpctx: literal jumping contexts (excluding the idiom's own words
// jump/jumps/jumping/jumped, which would self-match).
fn j_jumpctx(hay:[]u8)i32{
    if(j_has_word(hay,"hurdle")!=0){return 1;}
    if(j_has_word(hay,"hurdles")!=0){return 1;}

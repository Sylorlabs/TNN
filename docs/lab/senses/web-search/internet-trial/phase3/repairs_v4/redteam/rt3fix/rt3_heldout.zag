@import("j_ledger.zag")
@import("r5_r6.zag")
@import("g_intent6_v4fix.zag")

fn rt3_show(id:[]u8,text:[]u8)void{
    let codes:[]u8=j_alloc(512);
    let markers:[]u8=j_alloc(4096);
    j_zero(codes);
    j_zero(markers);
    let intent:i32=g_classify(text,"",codes,markers);
    _zag_print(id);_zag_print("|");
    _zag_print(_zag_i64_to_str(intent as i64));_zag_print("|");
    _zag_print(j_exact(codes));_zag_print("|");
    _zag_print(j_exact(markers));
    _zag_println("");
    return;
}

fn main()void{
    rt3_show("H01","What do you call a fake noodle? An impasta.");
    rt3_show("H02","This is not a joke. I really did lock my keys in the car again.");
    rt3_show("H03","A priest, a rabbi, and a monk walk into a bar. The bartender says, \"Is this a joke?\"");
    rt3_show("H04","I never make mistakes. I thought I did once, but I was wrong.");
    rt3_show("H05","I asked the chef for the secret recipe. He muttered, \"Butter. It is always butter.\"");
    rt3_show("H06","I used to dislike beards, but then one grew on me.");
    rt3_show("H07","She fears steep hills. She is gradually getting over it.");
    rt3_show("H08","He worries about hurdles. He keeps jumping to conclusions.");
    rt3_show("H09","There is a fine line between a dividend and a divisor. Only accountants will get this.");
    rt3_show("H10","My dentures are like the sun. They come out in the morning.");
    rt3_show("H11","Rub salt in the wound to help it heal faster.");
    rt3_show("H12","He smoked for forty years and lived to one hundred.");
    rt3_show("H13","I asked her to embrace change. She hugged the calendar.");
    rt3_show("H14","Why do programmers prefer dark mode? Because light attracts bugs.");
    rt3_show("H15","I told the doctor my back is killing me. She said, \"Then stop carrying the team.\"");
    rt3_show("S01","The meeting is at three o'clock in the conference room.");
    rt3_show("S02","I did not finish the report because the data was incomplete.");
    rt3_show("S03","She asked if I wanted coffee. I said yes, please.");
    rt3_show("S04","I tried to fix the sink yesterday. It is still leaking.");
    rt3_show("S05","He whispered that the baby was finally asleep.");
    rt3_show("S06","I used to run marathons. Now I just jog on weekends.");
    rt3_show("S07","She lost interest in the project after the budget cuts.");
    rt3_show("S08","The early train was full, but the second train was empty.");
    rt3_show("S09","I have a fear of spiders. I am working on getting over it.");
    rt3_show("S10","He is always jumping to conclusions about people.");
    rt3_show("S11","There is a fine line between confidence and arrogance.");
    rt3_show("S12","The stars come out at night.");
    rt3_show("S13","My jazz collection grew on me over the years.");
    rt3_show("S14","I told my doctor about my headaches. She said to get more rest.");
    rt3_show("S15","After he quit smoking, his health improved steadily.");
    return;
}

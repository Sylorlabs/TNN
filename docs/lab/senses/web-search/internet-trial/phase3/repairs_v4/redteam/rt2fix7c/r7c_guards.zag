// ==================== r7c guards (round 7c) ====================
// A20: equivocation guard. Suppresses AFFIRM when a content word occurs in
// the evidence in two phrases with DISTINCT adjacent content premodifiers
// ("river bank" vs "central bank") and the claim overlaps the exclusive
// territory (content tokens, excluding pivot occurrences and their
// premodifiers) of BOTH occurrences. Each evidence token is attributed to
// its nearest pivot occurrence (distance ties go to neither), so a claim
// fully grounded near a single occurrence cannot trigger.
// A45: pronoun-ambiguity guard. Suppresses AFFIRM when the evidence has a
// third-person pronoun with 2+ candidate proper-name antecedents
// (capitalized content words), the claim contains exactly one candidate,
// and the claim overlaps the pronoun-governed predicate (content stems
// after the pronoun).
// Both guards are suppress-affirm only: they never create DENY/AFFIRM,
// only withhold an affirm the pipeline would otherwise install.
// r7c helper: 1 if w is a content word (all-alpha, len>=3, not stopword).
fn r7c_content(w:[]u8)i32{
    if(w.len<3){return 0;}
    let i:i32=0;
    while(i<w.len){
        let b:i32=w[i] as i32;
        let ok:i32=0;
        if(b>=65 && b<=90){ok=1;}
        if(b>=97 && b<=122){ok=1;}
        if(ok==0){return 0;}
        i=i+1;
    }
    if(in_list(w,lex_stop())==1){return 0;}
    return 1;
}
// r7c helper: 1 if w (lowered) is a third-person pronoun.
fn r7c_is_pro(w:[]u8)i32{
    if(z_eq(w,"he")==1){return 1;}
    if(z_eq(w,"she")==1){return 1;}
    if(z_eq(w,"him")==1){return 1;}
    if(z_eq(w,"her")==1){return 1;}
    if(z_eq(w,"his")==1){return 1;}
    if(z_eq(w,"they")==1){return 1;}
    if(z_eq(w,"them")==1){return 1;}
    if(z_eq(w,"their")==1){return 1;}
    if(z_eq(w,"it")==1){return 1;}
    if(z_eq(w,"its")==1){return 1;}
    return 0;
}
// r7c helper: nearest pivot-occurrence index for evidence token q among
// OCC (m entries); -1 on a distance tie.
fn r7c_nearest(q:i32,occ:[]u8,m:i32)i32{
    let best:i32=-1;
    let bd:i32=1000000;
    let tie:i32=0;
    let j:i32=0;
    while(j<m){
        let o:i32=a_get(occ,j);
        let d:i32=q-o;
        if(d<0){d=0-d;}
        if(d<bd){bd=d;best=j;tie=0;}
        else{
            if(d==bd){tie=1;}
        }
        j=j+1;
    }
    if(tie==1){return -1;}
    return best;
}
// r7c (A20): equivocation suppress-affirm. See header comment.
fn r7c_equiv_one(claim:[]u8,ev:[]u8)i32{
    let EB:[]u8=z_alloc(8192);
    let TA:[]u8=z_alloc(4096);
    let CA:[]u8=z_alloc(1024);
    let WBUF:[]u8=z_alloc(8192);
    let WI:[]u8=z_alloc(4096);
    let SBUF:[]u8=z_alloc(8192);
    let EI:[]u8=z_alloc(4096);
    let CFLG:[]u8=z_alloc(2048);
    let MCL:[]u8=z_alloc(2048);
    let SB:[]u8=z_alloc(2048);
    let SI:[]u8=z_alloc(1024);
    let TMP:[]u8=z_alloc(64);
    let STM:[]u8=z_alloc(32);
    let OCC:[]u8=z_alloc(256);
    let HIT:[]u8=z_alloc(256);
    let PRE:[]u8=z_alloc(512);
    let PHAS:[]u8=z_alloc(256);
    let OCCF:[]u8=z_alloc(2048);
    let rc:i32=0;
    if(EB.len>0 && TA.len>0 && CA.len>0 && WBUF.len>0 && WI.len>0 && SBUF.len>0 && EI.len>0 && CFLG.len>0 && MCL.len>0 && SB.len>0 && SI.len>0 && TMP.len>0 && STM.len>0 && OCC.len>0 && HIT.len>0 && PRE.len>0 && PHAS.len>0 && OCCF.len>0){
        let el:i32=ev.len;
        if(el>8191){el=8191;}
        let i:i32=0;
        while(i<el){EB[i]=ev[i];i=i+1;}
        let evs:[]u8=EB[0..el];
        let n:i32=z_toks(evs,TA,512);
        // phase 1: per-token lowered word + stem + content flag
        let woff:i32=0;
        let soff:i32=0;
        let q:i32=0;
        while(q<n){
            let qto:i32=a_get(TA,2*q);
            let qtl:i32=a_get(TA,2*q+1);
            let ll:i32=lower_copy(evs[qto..qto+qtl],TMP);
            a_put(CFLG,q,0);
            if(ll>0 && ll<64 && r7c_content(TMP[0..ll])==1 && woff+ll<8192){
                let qq:i32=0;
                while(qq<ll){WBUF[woff+qq]=TMP[qq];qq=qq+1;}
                a_put(WI,2*q,woff);
                a_put(WI,2*q+1,ll);
                woff=woff+ll;
                let sl:i32=r6_stem_of(TMP[0..ll],STM);
                if(sl>0 && soff+sl<8192){
                    let rr:i32=0;
                    while(rr<sl){SBUF[soff+rr]=STM[rr];rr=rr+1;}
                    a_put(EI,2*q,soff);
                    a_put(EI,2*q+1,sl);
                    soff=soff+sl;
                    a_put(CFLG,q,1);
                }
            }
            q=q+1;
        }
        // phase 2: claim content stems
        let nc:i32=z_toks(claim,CA,128);
        let ns:i32=0;
        let coff:i32=0;
        let c:i32=0;
        while(c<nc){
            let cto:i32=a_get(CA,2*c);
            let ctl:i32=a_get(CA,2*c+1);
            let ll:i32=lower_copy(claim[cto..cto+ctl],TMP);
            if(ll>0 && r7c_content(TMP[0..ll])==1){
                let sl:i32=r6_stem_of(TMP[0..ll],STM);
                if(sl>0 && ns<128 && coff+sl<2048){
                    let qq:i32=0;
                    while(qq<sl){SB[coff+qq]=STM[qq];qq=qq+1;}
                    a_put(SI,2*ns,coff);
                    a_put(SI,2*ns+1,sl);
                    coff=coff+sl;
                    ns=ns+1;
                }
            }
            c=c+1;
        }
        // phase 3: matches_claim per evidence token (stem overlap)
        q=0;
        while(q<n){
            a_put(MCL,q,0);
            if(a_get(CFLG,q)==1){
                let eo:i32=a_get(EI,2*q);
                let eln:i32=a_get(EI,2*q+1);
                let s:i32=0;
                while(s<ns){
                    let so:i32=a_get(SI,2*s);
                    let sln:i32=a_get(SI,2*s+1);
                    if(eln==sln && z_eq(SBUF[eo..eo+eln],SB[so..so+sln])==1){
                        a_put(MCL,q,1);
                        break;
                    }
                    s=s+1;
                }
            }
            q=q+1;
        }
        // phase 4: pivot loop
        let p:i32=0;
        while(p<n && rc==0){
            if(a_get(CFLG,p)==1){
                let pwo:i32=a_get(WI,2*p);
                let pwl:i32=a_get(WI,2*p+1);
                let m:i32=0;
                q=0;
                while(q<n && m<64){
                    if(a_get(CFLG,q)==1){
                        let qo:i32=a_get(WI,2*q);
                        let ql:i32=a_get(WI,2*q+1);
                        if(ql==pwl && z_eq(WBUF[qo..qo+ql],WBUF[pwo..pwo+pwl])==1){
                            a_put(OCC,m,q);
                            m=m+1;
                        }
                    }
                    q=q+1;
                }
                if(m>=2){
                    // adjacent premodifier stems
                    let u:i32=0;
                    while(u<m){
                        a_put(PHAS,u,0);
                        let o:i32=a_get(OCC,u);
                        if(o>0 && a_get(CFLG,o-1)==1){
                            let po:i32=a_get(EI,2*(o-1));
                            let pl:i32=a_get(EI,2*(o-1)+1);
                            a_put(PRE,2*u,po);
                            a_put(PRE,2*u+1,pl);
                            a_put(PHAS,u,1);
                        }
                        u=u+1;
                    }
                    // distinct premodifier pair?
                    let dp:i32=0;
                    let u1:i32=0;
                    while(u1<m && dp==0){
                        let u2:i32=u1+1;
                        while(u2<m && dp==0){
                            if(a_get(PHAS,u1)==1 && a_get(PHAS,u2)==1){
                                let a1o:i32=a_get(PRE,2*u1);
                                let a1l:i32=a_get(PRE,2*u1+1);
                                let a2o:i32=a_get(PRE,2*u2);
                                let a2l:i32=a_get(PRE,2*u2+1);
                                if(a1l!=a2l || z_eq(SBUF[a1o..a1o+a1l],SBUF[a2o..a2o+a2l])==0){
                                    dp=1;
                                }
                            }
                            u2=u2+1;
                        }
                        u1=u1+1;
                    }
                    if(dp==1){
                        // exclude pivot occurrences + premodifiers
                        q=0;
                        while(q<n){a_put(OCCF,q,0);q=q+1;}
                        u=0;
                        while(u<m){
                            let o:i32=a_get(OCC,u);
                            a_put(OCCF,o,1);
                            if(a_get(PHAS,u)==1 && o>0){a_put(OCCF,o-1,1);}
                            u=u+1;
                        }
                        // territory hits via nearest occurrence
                        u=0;
                        while(u<m){a_put(HIT,u,0);u=u+1;}
                        q=0;
                        while(q<n){
                            if(a_get(CFLG,q)==1 && a_get(MCL,q)==1 && a_get(OCCF,q)==0){
                                let j:i32=r7c_nearest(q,OCC,m);
                                if(j>=0){a_put(HIT,j,1);}
                            }
                            q=q+1;
                        }
                        let h1:i32=0;
                        u=0;
                        while(u<m){
                            if(a_get(HIT,u)==1){h1=h1+1;}
                            u=u+1;
                        }
                        if(h1>=2){rc=1;}
                    }
                }
            }
            p=p+1;
        }
    }
    z_free(EB);
    z_free(TA);
    z_free(CA);
    z_free(WBUF);
    z_free(WI);
    z_free(SBUF);
    z_free(EI);
    z_free(CFLG);
    z_free(MCL);
    z_free(SB);
    z_free(SI);
    z_free(TMP);
    z_free(STM);
    z_free(OCC);
    z_free(HIT);
    z_free(PRE);
    z_free(PHAS);
    z_free(OCCF);
    return rc;
}
// r7c (A45): pronoun-ambiguity suppress-affirm. See header comment.
fn r7c_pronoun_one(claim:[]u8,ev:[]u8)i32{
    let EB:[]u8=z_alloc(8192);
    let TA:[]u8=z_alloc(4096);
    let CA:[]u8=z_alloc(1024);
    let TMP:[]u8=z_alloc(64);
    let STM:[]u8=z_alloc(32);
    let CN:[]u8=z_alloc(512);
    let CNB:[]u8=z_alloc(2048);
    let CS:[]u8=z_alloc(256);
    let PB:[]u8=z_alloc(2048);
    let PI:[]u8=z_alloc(512);
    let SB:[]u8=z_alloc(2048);
    let SI:[]u8=z_alloc(1024);
    let rc:i32=0;
    if(EB.len>0 && TA.len>0 && CA.len>0 && TMP.len>0 && STM.len>0 && CN.len>0 && CNB.len>0 && CS.len>0 && PB.len>0 && PI.len>0 && SB.len>0 && SI.len>0){
        let el:i32=ev.len;
        if(el>8191){el=8191;}
        let i:i32=0;
        while(i<el){EB[i]=ev[i];i=i+1;}
        let evs:[]u8=EB[0..el];
        let n:i32=z_toks(evs,TA,512);
        // candidates: capitalized content words, deduped by lowered form
        let ncn:i32=0;
        let coff:i32=0;
        let q:i32=0;
        while(q<n && ncn<64){
            let qto:i32=a_get(TA,2*q);
            let qtl:i32=a_get(TA,2*q+1);
            let fb:i32=evs[qto] as i32;
            if(fb>=65 && fb<=90){
                let ll:i32=lower_copy(evs[qto..qto+qtl],TMP);
                if(ll>0 && r7c_content(TMP[0..ll])==1 && coff+ll<2048){
                    let dup:i32=0;
                    let d:i32=0;
                    while(d<ncn){
                        let do:i32=a_get(CN,2*d);
                        let dl:i32=a_get(CN,2*d+1);
                        if(dl==ll && z_eq(CNB[do..do+dl],TMP[0..ll])==1){dup=1;break;}
                        d=d+1;
                    }
                    if(dup==0){
                        let qq:i32=0;
                        while(qq<ll){CNB[coff+qq]=TMP[qq];qq=qq+1;}
                        a_put(CN,2*ncn,coff);
                        a_put(CN,2*ncn+1,ll);
                        coff=coff+ll;
                        ncn=ncn+1;
                    }
                }
            }
            q=q+1;
        }
        if(ncn>=2){
            // first third-person pronoun
            let pq:i32=-1;
            q=0;
            while(q<n && pq<0){
                let qto:i32=a_get(TA,2*q);
                let qtl:i32=a_get(TA,2*q+1);
                let ll:i32=lower_copy(evs[qto..qto+qtl],TMP);
                if(ll>0 && r7c_is_pro(TMP[0..ll])==1){pq=q;}
                q=q+1;
            }
            if(pq>=0){
                // pronoun predicate: content stems after pronoun
                let np:i32=0;
                let poff:i32=0;
                q=pq+1;
                while(q<n && np<64){
                    let qto:i32=a_get(TA,2*q);
                    let qtl:i32=a_get(TA,2*q+1);
                    let ll:i32=lower_copy(evs[qto..qto+qtl],TMP);
                    if(ll>0 && r7c_content(TMP[0..ll])==1){
                        let sl:i32=r6_stem_of(TMP[0..ll],STM);
                        if(sl>0 && poff+sl<2048){
                            let qq:i32=0;
                            while(qq<sl){PB[poff+qq]=STM[qq];qq=qq+1;}
                            a_put(PI,2*np,poff);
                            a_put(PI,2*np+1,sl);
                            poff=poff+sl;
                            np=np+1;
                        }
                    }
                    q=q+1;
                }
                if(np>0){
                    // claim content stems
                    let nc:i32=z_toks(claim,CA,128);
                    let ns:i32=0;
                    let soff:i32=0;
                    let c:i32=0;
                    while(c<nc){
                        let cto:i32=a_get(CA,2*c);
                        let ctl:i32=a_get(CA,2*c+1);
                        let ll:i32=lower_copy(claim[cto..cto+ctl],TMP);
                        if(ll>0 && r7c_content(TMP[0..ll])==1){
                            let sl:i32=r6_stem_of(TMP[0..ll],STM);
                            if(sl>0 && ns<128 && soff+sl<2048){
                                let qq:i32=0;
                                while(qq<sl){SB[soff+qq]=STM[qq];qq=qq+1;}
                                a_put(SI,2*ns,soff);
                                a_put(SI,2*ns+1,sl);
                                soff=soff+sl;
                                ns=ns+1;
                            }
                        }
                        c=c+1;
                    }
                    // candidates present in claim (lowered word match)
                    let nhit:i32=0;
                    let d:i32=0;
                    while(d<ncn){a_put(CS,d,0);d=d+1;}
                    c=0;
                    while(c<nc){
                        let cto:i32=a_get(CA,2*c);
                        let ctl:i32=a_get(CA,2*c+1);
                        let ll:i32=lower_copy(claim[cto..cto+ctl],TMP);
                        if(ll>0){
                            d=0;
                            while(d<ncn){
                                let do:i32=a_get(CN,2*d);
                                let dl:i32=a_get(CN,2*d+1);
                                if(dl==ll && z_eq(CNB[do..do+dl],TMP[0..ll])==1){
                                    if(a_get(CS,d)==0){
                                        a_put(CS,d,1);
                                        nhit=nhit+1;
                                    }
                                }
                                d=d+1;
                            }
                        }
                        c=c+1;
                    }
                    if(nhit==1){
                        // claim overlaps pronoun predicate?
                        let ov:i32=0;
                        let s:i32=0;
                        while(s<ns && ov==0){
                            let so:i32=a_get(SI,2*s);
                            let sln:i32=a_get(SI,2*s+1);
                            let pp:i32=0;
                            while(pp<np && ov==0){
                                let po:i32=a_get(PI,2*pp);
                                let pl:i32=a_get(PI,2*pp+1);
                                if(sln==pl && z_eq(SB[so..so+sln],PB[po..po+pl])==1){ov=1;}
                                pp=pp+1;
                            }
                            s=s+1;
                        }
                        if(ov==1){rc=1;}
                    }
                }
            }
        }
    }
    z_free(EB);
    z_free(TA);
    z_free(CA);
    z_free(TMP);
    z_free(STM);
    z_free(CN);
    z_free(CNB);
    z_free(CS);
    z_free(PB);
    z_free(PI);
    z_free(SB);
    z_free(SI);
    return rc;
}
// r7c: combined suppress-affirm gate for A20/A45. Returns 1 to suppress.
fn r7c_aff_supp(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let EB:[]u8=z_alloc(8192);
    let rc:i32=0;
    if(EB.len>0){
        let tl:i32=title.len;
        let sl:i32=snip.len;
        if(tl>4095){tl=4095;}
        if(sl>4095){sl=4095;}
        let i:i32=0;
        while(i<tl){EB[i]=title[i];i=i+1;}
        EB[tl]=32;
        let k:i32=0;
        while(k<sl){EB[tl+1+k]=snip[k];k=k+1;}
        let ev:[]u8=EB[0..tl+1+sl];
        if(r7c_equiv_one(claim,ev)==1){rc=1;}
        else{
            if(r7c_pronoun_one(claim,ev)==1){rc=1;}
        }
    }
    z_free(EB);
    return rc;
}

// rt3c_run.zag — RT3c blind-attack runner (pure Zag, zero RNG).
// Reads a TSV corpus (id \t claim \t evidence \t oracle, '#' comment lines),
// feeds CLAIM ONLY to g_classify, prints: id \t WORD \t codes
// WORD: JOKING(2) SATIRE(3) UNCERTAIN(5) OTHER.
// Evidence column is documentation only (family/mechanism notes), not fed.

@import("g_intent6_v4fix2.zag")

fn r_find(b:[]u8,from:i32,to:i32,ch:u8)i32{
    let i:i32=from;
    while(i<to){
        if(b[i]==ch){return i;}
        i=i+1;
    }
    return -1;
}

fn r_out(b:[]u8,s:[]u8)void{
    let n:i32=j_cstrlen(b);
    let i:i32=0;
    while(i<s.len){b[n+i]=s[i];i=i+1;}
    b[n+s.len]=0;
    return;
}

fn r_outc(b:[]u8,c:u8)void{
    let n:i32=j_cstrlen(b);
    b[n]=c;
    b[n+1]=0;
    return;
}

fn r_copy(b:[]u8,from:i32,to:i32)[]u8{
    let n:i32=to-from;
    let o:[]u8=nio_alloc(n+1);
    let i:i32=0;
    while(i<n){o[i]=b[from+i];i=i+1;}
    o[n]=0;
    return o;
}

fn r_word(intent:i32)[]u8{
    if(intent==2){return "JOKING";}
    if(intent==3){return "SATIRE";}
    if(intent==5){return "UNCERTAIN";}
    return "OTHER";
}

fn main()void{
    let arg:[]u8=_zag_arg(1);
    let path:[]u8=nio_cstr(arg);
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(path) as i64,0,0,0,0,0);
    if(fd<0){
        let e:[]u8=nio_alloc(10);
        e[0]=69;e[1]=82;e[2]=82;e[3]=32;e[4]=111;e[5]=112;e[6]=101;e[7]=110;e[8]=10;e[9]=0;
        nio_write_all(1,e);
        return;
    }
    let buf:[]u8=nio_alloc(4194304);
    let n:i64=nio_read_exact(fd,buf,4194304);
    nio_close(fd);
    if(n<0){
        let e2:[]u8=nio_alloc(10);
        e2[0]=69;e2[1]=82;e2[2]=82;e2[3]=32;e2[4]=114;e2[5]=101;e2[6]=97;e2[7]=100;e2[8]=10;e2[9]=0;
        nio_write_all(1,e2);
        return;
    }
    let nn:i32=n as i32;
    let url:[]u8=nio_alloc(1);
    url[0]=0;
    let codes:[]u8=nio_alloc(4096);
    let markers:[]u8=nio_alloc(8192);
    let i:i32=0;
    while(i<nn){
        let ls:i32=i;
        while(i<nn){
            if(buf[i]==10){break;}
            i=i+1;
        }
        let le:i32=i;
        if(i<nn){i=i+1;}
        if(le>ls){
            if(buf[le-1]==13){le=le-1;}
            if(buf[ls]!=35){
                let t1:i32=r_find(buf,ls,le,9);
                let t2:i32=-1;
                let t3:i32=-1;
                if(t1>=0){t2=r_find(buf,t1+1,le,9);}
                if(t2>=0){t3=r_find(buf,t2+1,le,9);}
                if(t3>=0){
                    let id:[]u8=r_copy(buf,ls,t1);
                    let claim:[]u8=r_copy(buf,t1+1,t2);
                    j_zero(codes);
                    j_zero(markers);
                    let intent:i32=g_classify(claim,url,codes,markers);
                    let line:[]u8=nio_alloc(16384);
                    line[0]=0;
                    r_out(line,id);
                    r_outc(line,9);
                    r_out(line,r_word(intent));
                    r_outc(line,9);
                    r_out(line,j_exact(codes));
                    r_outc(line,10);
                    nio_write_all(1,j_exact(line));
                }
            }
        }
    }
    return;
}

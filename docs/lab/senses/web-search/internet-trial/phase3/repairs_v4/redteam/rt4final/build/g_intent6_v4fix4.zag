// g_intent6_v4.zag — JOKE-FIX crew, hell-hole V4.
// Generalization of the frozen g_intent6.zag (config 6, 32 patterns, 321 phrases):
//  (a) verb classes are STEM-keyed and form-insensitive via j_has_stem
//      (pour/pours/poured/pouring, rub/rubbed/rubbing, shove/shoved/shoving...);
//      verb+preposition constructions generalized as j_stem_near ("replace X with Y").
//  (b) fact classes broadened with hypernym inventories (F_FOOD, F_SKY, F_DRIVING,
//      F_HABIT, F_LONGEV, F_WORN); new absurd-combination rules P_DA5A..P_DA5D.
//  (c) rhetorical-shape rules: R_IRONY (harmful-habit + longevity anecdote),
//      R_PUN1 (dual-meaning verb + abstract object + literal enactment),
//      R_PUN2 (distrust-imperative + make-up pivot + universal quantifier).
// Frozen 32-pattern chain kept verbatim and first; 7 new rules appended with
// contra==0 guards, so nothing the frozen classifier caught changes verdict.
// Decision rule unchanged: contradiction -> JOKING (R6 CONTRADICTS overrides);
// elif SAT>=2 -> SATIRE; elif TROPE>=1 -> JOKING; else UNCERTAIN.
// SINCERE(1)/DECEPTIVE(4) never emitted. Pure Zag; zero RNG.

@import("j_ledger.zag")
@import("r5_r6.zag")

fn g_codes_append(codes:[]u8,tok:[]u8)void {
    let n:i32=j_cstrlen(codes);
    if(n>0){codes[n]=43;n=n+1;}
    let i:i32=0;
    while(i<tok.len){codes[n+i]=tok[i];i=i+1;}
    codes[n+tok.len]=0;
    return;
}

fn g_markers_append(markers:[]u8,mk:[]u8)void {
    let n:i32=j_cstrlen(markers);
    let i:i32=0;
    while(i<mk.len){markers[n+i]=mk[i];i=i+1;}
    markers[n+mk.len]=126;
    markers[n+mk.len+1]=0;
    return;
}

// ---------- stem machinery ----------
// j_is_cons: lowercase consonant test (text is lowercased before matching).
fn j_is_cons(c:u8)i32{
    if(c<97){return 0;}
    if(c>122){return 0;}
    if(c==97){return 0;}
    if(c==101){return 0;}
    if(c==105){return 0;}
    if(c==111){return 0;}
    if(c==117){return 0;}
    return 1;
}
// j_inflect_end: after a stem match at [..,p), the alnum suffix must be a valid
// inflection: "", s, es, ed, d  (e.g. pour/pours/poured, shove/shoved).
fn j_inflect_end(hay:[]u8,p:i32)i32{
    if(p>=hay.len){return p;}
    if(j_is_alnum(hay[p])==0){return p;}
    let e:i32=p;
    while(e<hay.len){if(j_is_alnum(hay[e])==0){break;}e=e+1;}
    let sl:i32=e-p;
    if(sl==1){if(hay[p]==115){return e;}if(hay[p]==100){return e;}}
    if(sl==2){if(hay[p]==101){if(hay[p+1]==115){return e;}if(hay[p+1]==100){return e;}}}
    if(sl==3){if(hay[p]==105){if(hay[p+1]==110){if(hay[p+2]==103){return e;}}}}
    return -1;
}
// j_inflect_ing: for dropped-e stems (shove->shoving): suffix exactly "ing".
fn j_inflect_ing(hay:[]u8,p:i32)i32{
    if(p+3>hay.len){return -1;}
    if(hay[p]!=105){return -1;}
    if(hay[p+1]!=110){return -1;}
    if(hay[p+2]!=103){return -1;}
    let q:i32=p+3;
    if(q<hay.len){if(j_is_alnum(hay[q])!=0){return -1;}}
    return q;
}
// j_inflect_deding: for doubled-consonant stems (hug->hugged/hugging): "ed"/"ing".
fn j_inflect_deding(hay:[]u8,p:i32)i32{
    let q:i32=-1;
    if(p+2<=hay.len){if(hay[p]==101){if(hay[p+1]==100){q=p+2;}}}
    if(q<0){if(p+3<=hay.len){if(hay[p]==105){if(hay[p+1]==110){if(hay[p+2]==103){q=p+3;}}}}}
    if(q<0){return -1;}
    if(q<hay.len){if(j_is_alnum(hay[q])!=0){return -1;}}
    return q;
}
// j_stem_endpos: first inflection of stem at/after start; returns word end or -1.
fn j_stem_endpos(hay:[]u8,stem:[]u8,start:i32)i32{
    if(stem.len==0){return -1;}
    let lastc:u8=stem[stem.len-1];
    let i:i32=start;
    while(i<=hay.len-stem.len){
        let ok:i32=1;
        if(i>0){if(j_is_alnum(hay[i-1])!=0){ok=0;}}
        if(ok!=0){
            let k:i32=0;
            while(k<stem.len){if(hay[i+k]!=stem[k]){break;}k=k+1;}
            if(k==stem.len){
                let e:i32=j_inflect_end(hay,i+stem.len);
                if(e>=0){return e;}
                if(j_is_cons(lastc)!=0){
                    if(i+stem.len<hay.len){
                        if(hay[i+stem.len]==lastc){
                            let e3:i32=j_inflect_deding(hay,i+stem.len+1);
                            if(e3>=0){return e3;}
                        }
                    }
                }
            }
            if(lastc==101){
                let m:i32=0;
                while(m<stem.len-1){if(hay[i+m]!=stem[m]){break;}m=m+1;}
                if(m==stem.len-1){
                    let e2:i32=j_inflect_ing(hay,i+stem.len-1);
                    if(e2>=0){return e2;}
                }
            }
        }
        i=i+1;
    }
    return -1;
}
fn j_has_stem(hay:[]u8,stem:[]u8)i32{
    if(j_stem_endpos(hay,stem,0)>=0){return 1;}
    return 0;
}
// j_has_word_lim: whole-word match of w inside [from,lim).
fn j_has_word_lim(hay:[]u8,w:[]u8,from:i32,lim:i32)i32{
    if(w.len==0){return 0;}
    if(from<0){from=0;}
    if(lim>hay.len){lim=hay.len;}
    if(lim-from<w.len){return 0;}
    let i:i32=from;
    while(i<=lim-w.len){
        let k:i32=0;
        while(k<w.len){if(hay[i+k]!=w[k]){break;}k=k+1;}
        if(k==w.len){
            let ok:i32=1;
            if(i>0){if(j_is_alnum(hay[i-1])!=0){ok=0;}}
            if(i+w.len<hay.len){if(j_is_alnum(hay[i+w.len])!=0){ok=0;}}
            if(ok!=0){return 1;}
        }
        i=i+1;
    }
    return 0;
}
// j_stem_near: verb stem followed by whole word w2 within maxchars after the
// verb's word end — generalizes "replace X with Y", "swap X for Y", "pour X into Y".
fn j_stem_near(hay:[]u8,stem:[]u8,w2:[]u8,maxchars:i32)i32{
    let s:i32=0;
    while(s<hay.len){
        let e:i32=j_stem_endpos(hay,stem,s);
        if(e<0){return 0;}
        if(j_has_word_lim(hay,w2,e,e+maxchars)!=0){return 1;}
        s=e;
    }
    return 0;
}

// ================= v4fix structural helpers =================
// Rationale: the RT3 misses are negation jokes, punchline-completeness
// failures, riddle/meta/bar shapes the trope inventory cannot name.
// These are structural shape detectors, not new word lists.
fn j_sub_pos(hay:[]u8,needle:[]u8,from:i32)i32{
    if(needle.len==0){return -1;}
    if(from<0){from=0;}
    let i:i32=from;
    while(i<=hay.len-needle.len){
        let k:i32=0;
        while(k<needle.len){if(hay[i+k]!=needle[k]){break;}k=k+1;}
        if(k==needle.len){return i;}
        i=i+1;
    }
    return -1;
}
// j_phrase_pos: whole-word phrase occurrence at/after from, or -1.
fn j_phrase_pos(hay:[]u8,ph:[]u8,from:i32)i32{
    if(ph.len==0){return -1;}
    if(from<0){from=0;}
    let i:i32=from;
    while(i<=hay.len-ph.len){
        let k:i32=0;
        while(k<ph.len){if(hay[i+k]!=ph[k]){break;}k=k+1;}
        if(k==ph.len){
            let ok:i32=1;
            if(i>0){if(j_is_alnum(hay[i-1])!=0){ok=0;}}
            let e:i32=i+ph.len;
            if(e<hay.len){if(j_is_alnum(hay[e])!=0){ok=0;}}
            if(ok!=0){return i;}
        }
        i=i+1;
    }
    return -1;
}
// j_two_clause: setup/punchline shape — ";" "?" "!" ". "+text ", which " ", who ".
fn j_two_clause(hay:[]u8)i32{
    let i:i32=0;
    while(i<hay.len){
        let c:u8=hay[i];
        if(c==59){return 1;}
        if(c==63){return 1;}
        if(c==33){return 1;}
        if(c==46){
            if(i+2<hay.len){
                if(hay[i+1]==32){
                    if(j_is_alnum(hay[i+2])!=0){return 1;}
                }
            }
        }
        i=i+1;
    }
    if(j_has_sub(hay,", which ")!=0){return 1;}
    if(j_has_sub(hay,", who ")!=0){return 1;}
    return 0;
}
// j_word_at: whole word w at exact position pos.
fn j_word_at(hay:[]u8,pos:i32,w:[]u8)i32{
    if(pos<0){return 0;}
    if(pos+w.len>hay.len){return 0;}
    let k:i32=0;
    while(k<w.len){if(hay[pos+k]!=w[k]){return 0;}k=k+1;}
    if(pos>0){if(j_is_alnum(hay[pos-1])!=0){return 0;}}
    let e:i32=pos+w.len;
    if(e<hay.len){if(j_is_alnum(hay[e])!=0){return 0;}}
    return 1;
}
// j_is_det_at: determiner/pronoun at wp (purpose infinitives exclude these).
fn j_is_det_at(hay:[]u8,wp:i32)i32{
    if(j_word_at(hay,wp,"the")!=0){return 1;}
    if(j_word_at(hay,wp,"a")!=0){return 1;}
    if(j_word_at(hay,wp,"an")!=0){return 1;}
    if(j_word_at(hay,wp,"your")!=0){return 1;}
    if(j_word_at(hay,wp,"my")!=0){return 1;}
    if(j_word_at(hay,wp,"his")!=0){return 1;}
    if(j_word_at(hay,wp,"her")!=0){return 1;}
    if(j_word_at(hay,wp,"its")!=0){return 1;}
    if(j_word_at(hay,wp,"our")!=0){return 1;}
    if(j_word_at(hay,wp,"their")!=0){return 1;}
    if(j_word_at(hay,wp,"this")!=0){return 1;}
    if(j_word_at(hay,wp,"that")!=0){return 1;}
    if(j_word_at(hay,wp,"these")!=0){return 1;}
    if(j_word_at(hay,wp,"those")!=0){return 1;}
    if(j_word_at(hay,wp,"me")!=0){return 1;}
    if(j_word_at(hay,wp,"you")!=0){return 1;}
    if(j_word_at(hay,wp,"him")!=0){return 1;}
    if(j_word_at(hay,wp,"us")!=0){return 1;}
    if(j_word_at(hay,wp,"them")!=0){return 1;}
    if(j_word_at(hay,wp,"it")!=0){return 1;}
    return 0;
}
// j_purpose_to: " to " + non-determiner word = purpose infinitive
// ("to strengthen", "to save"; not "to your eyes", "to the store").
fn j_purpose_to(hay:[]u8)i32{
    // Round-4: a text-initial purpose infinitive ("To stay awake, eat chalk")
    // is the same signal as a medial one; the old leading-space requirement
    // silently dropped it.
    if(hay.len>4){
        if(hay[0]==116&&hay[1]==111&&hay[2]==32){
            if(j_is_det_at(hay,3)==0){return 1;}
        }
    }
    let i:i32=0;
    while(i+4<hay.len){
        if(hay[i]==32){
            if(hay[i+1]==116){
                if(hay[i+2]==111){
                    if(hay[i+3]==32){
                        if(j_is_det_at(hay,i+4)==0){return 1;}
                    }
                }
            }
        }
        i=i+1;
    }
    return 0;
}
// j_word_end: end offset of the alnum word starting at pos.
fn j_word_end(hay:[]u8,pos:i32)i32{
    let e:i32=pos;
    while(e<hay.len){if(j_is_alnum(hay[e])==0){break;}e=e+1;}
    return e;
}
// j_comp_adj: word [s,e) is a comparative/superlative adjective (-er/-est).
fn j_comp_adj(hay:[]u8,s:i32,e:i32)i32{
    let n:i32=e-s;
    if(n<2){return 0;}
    if(hay[e-2]==101){
        if(hay[e-1]==114){return 1;}
    }
    if(n>=3){
        if(hay[e-3]==101){
            if(hay[e-2]==115){
                if(hay[e-1]==116){return 1;}
            }
        }
    }
    return 0;
}
// j_benefit_scan: pre includes trailing space, e.g. "for a ".
fn j_benefit_scan(hay:[]u8,pre:[]u8)i32{
    let p:i32=j_sub_pos(hay,pre,0);
    while(p>=0){
        let ok:i32=1;
        if(p>0){if(j_is_alnum(hay[p-1])!=0){ok=0;}}
        if(ok!=0){
            let wp:i32=p+pre.len;
            let e:i32=j_word_end(hay,wp);
            if(e>wp){
                if(j_comp_adj(hay,wp,e)!=0){return 1;}
            }
        }
        p=j_sub_pos(hay,pre,p+1);
    }
    return 0;
}
fn j_for_benefit(hay:[]u8)i32{
    if(j_benefit_scan(hay,"for a ")!=0){return 1;}
    if(j_benefit_scan(hay,"for an ")!=0){return 1;}
    if(j_benefit_scan(hay,"for the ")!=0){return 1;}
    if(j_benefit_scan(hay,"to a ")!=0){return 1;}
    if(j_benefit_scan(hay,"to an ")!=0){return 1;}
    if(j_benefit_scan(hay,"to the ")!=0){return 1;}
    return 0;
}
// j_casual_qty: casual cooking quantity ("a splash of").
fn j_casual_qty(hay:[]u8)i32{
    if(j_has_word(hay,"a splash of")!=0){return 1;}
    if(j_has_word(hay,"a dash of")!=0){return 1;}
    if(j_has_word(hay,"a bit of")!=0){return 1;}
    if(j_has_word(hay,"a little")!=0){return 1;}
    if(j_has_word(hay,"a drop of")!=0){return 1;}
    if(j_has_word(hay,"a pinch of")!=0){return 1;}
    if(j_has_word(hay,"a touch of")!=0){return 1;}
    return 0;
}
// j_setup_clause: starts with "if "/"when " and contains "," (conditional setup).
fn j_setup_clause(hay:[]u8)i32{
    let s:i32=0;
    if(hay.len>=3){
        if(hay[0]==105){
            if(hay[1]==102){
                if(hay[2]==32){s=1;}
            }
        }
    }
    if(hay.len>=5){
        if(hay[0]==119){
            if(hay[1]==104){
                if(hay[2]==101){
                    if(hay[3]==110){
                        if(hay[4]==32){s=1;}
                    }
                }
            }
        }
    }
    if(s==0){return 0;}
    if(j_has_sub(hay,",")!=0){return 1;}
    return 0;
}
// j_justify: deadpan-benefit / completion signal. A "contradiction" inventory
// hit only becomes JOKING when the text carries a purpose, a conditional
// setup, a benefit claim, a casual quantity, or a two-part punchline shape.
fn j_justify(hay:[]u8)i32{
    if(j_two_clause(hay)!=0){return 1;}
    if(j_setup_clause(hay)!=0){return 1;}
    if(j_purpose_to(hay)!=0){return 1;}
    if(j_for_benefit(hay)!=0){return 1;}
    if(j_casual_qty(hay)!=0){return 1;}
    return 0;
}
// j_emergency_veto: genuine emergency-response language marks a sincere
// incident report, not absurd advice. No P_DA/P_DB absurd-advice rule may
// fire when the text calls poison control / emergency services.
fn j_emergency_veto(hay:[]u8)i32{
    if(j_phrase_pos(hay,"poison control",0)>=0){return 1;}
    if(j_phrase_pos(hay,"emergency services",0)>=0){return 1;}
    if(j_phrase_pos(hay,"emergency service",0)>=0){return 1;}
    if(j_phrase_pos(hay,"call 911",0)>=0){return 1;}
    if(j_has_word(hay,"ambulance")!=0){return 1;}
    if(j_has_word(hay,"paramedic")!=0){return 1;}
    if(j_has_word(hay,"paramedics")!=0){return 1;}
    return 0;
}
// j_neg_act: the action is explicitly negated ("do not hug", "never punch",
// "avoid laxatives") — the text refuses the act, so the absurd-advice rule
// for that act must not fire.
fn j_neg_act(hay:[]u8,act:[]u8)i32{
    let p:i32=j_phrase_pos(hay,act,0);
    while(p>=0){
        if(j_phrase_pos(hay,"do not",0)>=0){
            let dp:i32=j_phrase_pos(hay,"do not",0);
            if(dp<p){return 1;}
        }
        if(j_has_word(hay,"don't")!=0){
            let dp:i32=j_phrase_pos(hay,"don't",0);
            if(dp>=0&&dp<p){return 1;}
        }
        if(j_has_word(hay,"never")!=0){
            let dp:i32=j_phrase_pos(hay,"never",0);
            if(dp>=0&&dp<p){return 1;}
        }
        if(j_has_word(hay,"avoid")!=0){
            let dp:i32=j_phrase_pos(hay,"avoid",0);
            if(dp>=0&&dp<p){return 1;}
        }
        p=j_phrase_pos(hay,act,p+1);
    }
    return 0;
}
// j_prescribed_ingest: the ingestion is in base (prescribed) form — "chew",
// "swallow", "eat", "drink". Past-tense accident reports ("ate", "drank")
// are not prescriptions.
fn j_prescribed_ingest(hay:[]u8)i32{
    if(j_has_word(hay,"chew")!=0){return 1;}
    if(j_has_word(hay,"swallow")!=0){return 1;}
    if(j_has_word(hay,"eat")!=0){return 1;}
    if(j_has_word(hay,"drink")!=0){return 1;}
    if(j_has_word(hay,"consume")!=0){return 1;}
    return 0;
}
// j_mock_benefit: a mock-health-benefit infinitive — the "advice" voice of
// the joke ("to strengthen your vision", "to disinfect it fast").
fn j_mock_benefit(hay:[]u8)i32{
    if(j_phrase_pos(hay,"to strengthen",0)>=0){return 1;}
    if(j_phrase_pos(hay,"to disinfect",0)>=0){return 1;}
    if(j_phrase_pos(hay,"to heal",0)>=0){return 1;}
    if(j_phrase_pos(hay,"to improve",0)>=0){return 1;}
    if(j_phrase_pos(hay,"to boost",0)>=0){return 1;}
    if(j_phrase_pos(hay,"to clean",0)>=0){return 1;}
    if(j_phrase_pos(hay,"to toughen",0)>=0){return 1;}
    if(j_phrase_pos(hay,"to whiten",0)>=0){return 1;}
    if(j_phrase_pos(hay,"for confidence",0)>=0){return 1;}
    if(j_phrase_pos(hay,"for strength",0)>=0){return 1;}
    return 0;
}
// j_breath_mod: a breathing-rate modifier — "stop breathing so fast" is a
// breathing exercise, not "stop breathing" as absurd advice.
fn j_breath_mod(hay:[]u8)i32{
    if(j_phrase_pos(hay,"so fast",0)>=0){return 1;}
    if(j_phrase_pos(hay,"slowly",0)>=0){return 1;}
    if(j_phrase_pos(hay,"deeply",0)>=0){return 1;}
    if(j_phrase_pos(hay,"through your nose",0)>=0){return 1;}
    if(j_phrase_pos(hay,"faster",0)>=0){return 1;}
    if(j_phrase_pos(hay,"slower",0)>=0){return 1;}
    return 0;
}
// j_concurrent_wear: the garment is worn DURING the act ("while wearing it").
// "Iron the shirt you will wear" is ordinary sequencing.
fn j_concurrent_wear(hay:[]u8)i32{
    if(j_phrase_pos(hay,"while wearing",0)>=0){return 1;}
    if(j_phrase_pos(hay,"while you are wearing",0)>=0){return 1;}
    if(j_phrase_pos(hay,"still wearing",0)>=0){return 1;}
    if(j_phrase_pos(hay,"wearing it",0)>=0){return 1;}
    if(j_phrase_pos(hay,"wear it while",0)>=0){return 1;}
    return 0;
}
// j_subst_food: the substitution's target (after "with"/"for") is food —
// "replace a flat tire with a bagel". A food word elsewhere in the text
// ("bring food for the wait") is not the substitute.
fn j_subst_food(hay:[]u8)i32{
    let sv:i32=j_phrase_pos(hay,"replace",0);
    if(sv<0){sv=j_phrase_pos(hay,"substitute",0);}
    if(sv<0){sv=j_phrase_pos(hay,"swap",0);}
    if(sv<0){return 0;}
    let w:i32=j_phrase_pos(hay,"with",sv);
    if(w<0){w=j_phrase_pos(hay,"for",sv);}
    if(w<0){return 0;}
    let e:i32=w+5;
    if(e>hay.len){e=hay.len;}
    if(j_absurd_food_near(hay,e)!=0){return 1;}
    return 0;
}
fn j_absurd_food_near(hay:[]u8,from:i32)i32{
    let lim:i32=from+14;
    if(lim>hay.len){lim=hay.len;}
    if(j_has_word_lim(hay,"bagel",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"cheese",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"pizza",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"donut",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"ham",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"bacon",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"pancake",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"waffle",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"banana",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"pickle",from,lim)!=0){return 1;}
    return 0;
}
// j_micro_colloc: the microwave is the phone's charger ("charge in the
// microwave"). A microwave clock being mentioned is ordinary.
fn j_micro_colloc(hay:[]u8)i32{
    if(j_phrase_pos(hay,"in the microwave",0)>=0){return 1;}
    if(j_phrase_pos(hay,"in a microwave",0)>=0){return 1;}
    if(j_phrase_pos(hay,"microwave your phone",0)>=0){return 1;}
    if(j_phrase_pos(hay,"microwave the phone",0)>=0){return 1;}
    if(j_phrase_pos(hay,"microwave it",0)>=0){return 1;}
    return 0;
}
// j_drop_target: the drop lands on someone ("on your foot"). "Drop the
// table; mind your toes" is ordinary caution.
fn j_drop_target(hay:[]u8)i32{
    if(j_phrase_pos(hay,"on your",0)>=0){return 1;}
    if(j_phrase_pos(hay,"on my",0)>=0){return 1;}
    if(j_phrase_pos(hay,"on his",0)>=0){return 1;}
    if(j_phrase_pos(hay,"on her",0)>=0){return 1;}
    if(j_phrase_pos(hay,"on their",0)>=0){return 1;}
    return 0;
}
// j_lax_as_aid: laxative framed AS the sleep aid ("take laxatives for
// sleep"). "Take melatonin; avoid laxatives" is sincere.
fn j_lax_as_aid(hay:[]u8)i32{
    let lp:i32=j_phrase_pos(hay,"laxative",0);
    if(lp<0){return 0;}
    if(j_phrase_pos(hay,"for sleep",0)>=0){
        let fp:i32=j_phrase_pos(hay,"for sleep",0);
        if(fp>lp&&fp-lp<20){return 1;}
    }
    if(j_phrase_pos(hay,"before bed",0)>=0){
        let bp:i32=j_phrase_pos(hay,"before bed",0);
        if(bp>lp-30){
            if(j_neg_act(hay,"laxative")==0){return 1;}
        }
    }
    if(j_phrase_pos(hay,"at bedtime",0)>=0){return 1;}
    return 0;
}
// j_craft_ctx: papercraft/bookbinding context — gluing pages is honest craft.
fn j_craft_ctx(hay:[]u8)i32{
    if(j_has_word(hay,"pages")!=0){return 1;}
    if(j_has_word(hay,"bind")!=0){return 1;}
    if(j_has_word(hay,"binding")!=0){return 1;}
    if(j_has_word(hay,"bookbinding")!=0){return 1;}
    if(j_has_word(hay,"paper")!=0){return 1;}
    if(j_has_word(hay,"craft")!=0){return 1;}
    if(j_has_word(hay,"wood")!=0){return 1;}
    if(j_has_word(hay,"furniture")!=0){return 1;}
    if(j_has_word(hay,"fabric")!=0){return 1;}
    return 0;
}
// j_rescue_ctx: wildlife-rescue context — taking an animal to a shelter is
// sincere, not absurd.
fn j_rescue_ctx(hay:[]u8)i32{
    if(j_has_word(hay,"shelter")!=0){return 1;}
    if(j_has_word(hay,"rescue")!=0){return 1;}
    if(j_has_word(hay,"rescued")!=0){return 1;}
    if(j_has_word(hay,"sanctuary")!=0){return 1;}
    if(j_has_word(hay,"rehab")!=0){return 1;}
    if(j_phrase_pos(hay,"wildlife center",0)>=0){return 1;}
    return 0;
}
// j_myth_attr: explicit sincere attribution to folklore — "according to the
// old myth" reports a belief; it is not the joke's absurd claim.
fn j_myth_attr(hay:[]u8)i32{
    if(j_phrase_pos(hay,"according to the old myth",0)>=0){return 1;}
    if(j_phrase_pos(hay,"according to legend",0)>=0){return 1;}
    if(j_phrase_pos(hay,"according to the legend",0)>=0){return 1;}
    if(j_phrase_pos(hay,"the old myth says",0)>=0){return 1;}
    if(j_phrase_pos(hay,"folklore says",0)>=0){return 1;}
    return 0;
}
// j_cessation: the habit was quit/stopped (sincere health advice, not irony).
fn j_cessation(hay:[]u8)i32{
    if(j_has_word(hay,"quit")!=0){return 1;}
    if(j_has_word(hay,"stopped")!=0){return 1;}
    if(j_has_word(hay,"stop")!=0){return 1;}
    if(j_has_word(hay,"gave up")!=0){return 1;}
    if(j_has_word(hay,"never")!=0){return 1;}
    return 0;
}
// j_you: second-person address (audience, not self-irony).
fn j_you(hay:[]u8)i32{
    if(j_has_word(hay,"you")!=0){return 1;}
    if(j_has_word(hay,"your")!=0){return 1;}
    return 0;
}
// j_insult: hostile insult words (satire gate vetoes hostile installs).
fn j_insult(hay:[]u8)i32{
    if(j_has_word(hay,"idiot")!=0){return 1;}
    if(j_has_word(hay,"moron")!=0){return 1;}
    if(j_has_word(hay,"stupid")!=0){return 1;}
    if(j_has_word(hay,"dumb")!=0){return 1;}
    if(j_has_word(hay,"ugly")!=0){return 1;}
    if(j_has_word(hay,"loser")!=0){return 1;}
    return 0;
}
// j_phrase_end_punct: whole-word phrase followed by . ; ? ! or end.
fn j_phrase_end_punct(hay:[]u8,ph:[]u8)i32{
    let i:i32=0;
    while(i<=hay.len-ph.len){
        let k:i32=0;
        while(k<ph.len){if(hay[i+k]!=ph[k]){break;}k=k+1;}
        if(k==ph.len){
            let ok:i32=1;
            if(i>0){if(j_is_alnum(hay[i-1])!=0){ok=0;}}
            let e:i32=i+ph.len;
            if(e<hay.len){if(j_is_alnum(hay[e])!=0){ok=0;}}
            if(ok!=0){
                if(e>=hay.len){return 1;}
                let c:u8=hay[e];
                if(c==46){return 1;}
                if(c==59){return 1;}
                if(c==63){return 1;}
                if(c==33){return 1;}
            }
        }
        i=i+1;
    }
    return 0;
}
// j_pun2_pivot: the pivot phrase lands at a clause end (punchline completeness).
fn j_pun2_pivot(hay:[]u8)i32{
    if(j_phrase_end_punct(hay,"make up everything")!=0){return 1;}
    if(j_phrase_end_punct(hay,"made up everything")!=0){return 1;}
    if(j_phrase_end_punct(hay,"make up anything")!=0){return 1;}
    if(j_phrase_end_punct(hay,"made up anything")!=0){return 1;}
    return 0;
}
// j_opener_before: riddle opener occurs before the "?" at q.
fn j_opener_before(hay:[]u8,op:[]u8,q:i32)i32{
    let p:i32=j_phrase_pos(hay,op,0);
    if(p<0){return 0;}
    if(p<q){return 1;}
    return 0;
}
// j_qa_shape: riddle opener + "?" + non-empty answer.
fn j_qa_shape(hay:[]u8)i32{
    let q:i32=j_sub_pos(hay,"?",0);
    if(q<0){return 0;}
    let j:i32=q+1;
    let ans:i32=0;
    while(j<hay.len){
        if(j_is_alnum(hay[j])!=0){ans=1;break;}
        j=j+1;
    }
    if(ans==0){return 0;}
    if(j_opener_before(hay,"why did",q)!=0){return 1;}
    if(j_opener_before(hay,"why do",q)!=0){return 1;}
    if(j_opener_before(hay,"why does",q)!=0){return 1;}
    if(j_opener_before(hay,"what do you call",q)!=0){return 1;}
    if(j_opener_before(hay,"what did",q)!=0){return 1;}
    if(j_opener_before(hay,"what is",q)!=0){return 1;}
    if(j_opener_before(hay,"what are",q)!=0){return 1;}
    if(j_opener_before(hay,"how many",q)!=0){return 1;}
    return 0;
}
// j_deny_shape: "not a joke" / "not joking" denial.
fn j_deny_shape(hay:[]u8)i32{
    if(j_has_word(hay,"not a joke")!=0){return 1;}
    if(j_has_word(hay,"not joking")!=0){return 1;}
    return 0;
}
// j_bar_shape: walked-into-a-bar opener with a two-part body.
fn j_bar_shape(hay:[]u8)i32{
    if(j_two_clause(hay)==0){return 0;}
    if(j_has_sub(hay,"walked into a bar")!=0){return 1;}
    if(j_has_sub(hay,"walk into a bar")!=0){return 1;}
    if(j_has_sub(hay,"walks into a bar")!=0){return 1;}
    return 0;
}
// j_neg_count: number of distinct negation markers present.
fn j_neg_count(hay:[]u8)i32{
    let n:i32=0;
    if(j_has_word(hay,"never")!=0){n=n+1;}
    if(j_has_word(hay,"not")!=0){n=n+1;}
    if(j_has_word(hay,"no")!=0){n=n+1;}
    if(j_has_word(hay,"cannot")!=0){n=n+1;}
    if(j_has_word(hay,"can't")!=0){n=n+1;}
    if(j_has_word(hay,"don't")!=0){n=n+1;}
    if(j_has_word(hay,"doesn't")!=0){n=n+1;}
    if(j_has_word(hay,"didn't")!=0){n=n+1;}
    if(j_has_word(hay,"wouldn't")!=0){n=n+1;}
    if(j_has_word(hay,"isn't")!=0){n=n+1;}
    if(j_has_word(hay,"aren't")!=0){n=n+1;}
    if(j_has_word(hay,"wasn't")!=0){n=n+1;}
    if(j_has_word(hay,"weren't")!=0){n=n+1;}
    if(j_has_word(hay,"haven't")!=0){n=n+1;}
    if(j_has_word(hay,"hasn't")!=0){n=n+1;}
    if(j_has_word(hay,"hadn't")!=0){n=n+1;}
    if(j_has_word(hay,"won't")!=0){n=n+1;}
    if(j_has_word(hay,"nobody")!=0){n=n+1;}
    if(j_has_word(hay,"nothing")!=0){n=n+1;}
    if(j_has_word(hay,"stop")!=0){n=n+1;}
    if(j_has_word(hay,"stopped")!=0){n=n+1;}
    if(j_has_word(hay,"quit")!=0){n=n+1;}
    return n;
}
// j_reframe: reframe/pivot markers.
fn j_reframe(hay:[]u8)i32{
    if(j_has_word(hay,"just")!=0){return 1;}
    if(j_has_word(hay,"but")!=0){return 1;}
    if(j_has_word(hay,"instead")!=0){return 1;}
    if(j_has_word(hay,"now")!=0){return 1;}
    if(j_has_word(hay,"or")!=0){return 1;}
    if(j_has_word(hay,"too bad")!=0){return 1;}
    if(j_has_word(hay,"enjoy")!=0){return 1;}
    if(j_has_word(hay,"always")!=0){return 1;}
    if(j_has_word(hay,"might")!=0){return 1;}
    if(j_has_word(hay,"still")!=0){return 1;}
    if(j_has_word(hay,"yet")!=0){return 1;}
    if(j_has_word(hay,"however")!=0){return 1;}
    return 0;
}
// j_but_neg: "but" followed by a negation later (contrast reversal).
fn j_but_neg(hay:[]u8)i32{
    let b:i32=j_phrase_pos(hay,"but",0);
    if(b<0){return 0;}
    let from:i32=b+3;
    if(j_has_word_lim(hay,"never",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"not",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"no",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"cannot",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"can't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"don't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"doesn't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"didn't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"wouldn't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"isn't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"aren't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"wasn't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"weren't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"haven't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"hasn't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"hadn't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"won't",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"nobody",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"nothing",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"stop",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"stopped",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"quit",from,hay.len)!=0){return 1;}
    return 0;
}
// j_neg_shape: negation joke — negation + two-part body + reframe/pivot, or
// a single clause with a but-negation contrast reversal.
fn j_neg_shape(hay:[]u8)i32{
    let nn:i32=j_neg_count(hay);
    if(nn==0){return 0;}
    if(j_two_clause(hay)!=0){
        if(j_reframe(hay)!=0){return 1;}
        if(nn>=2){return 1;}
        return 0;
    }
    if(j_but_neg(hay)!=0){return 1;}
    return 0;
}
// j_stem_near_pos: stem matches with endpos <= wlim (windowed food check).
fn j_stem_near_pos(hay:[]u8,stem:[]u8,from:i32,wlim:i32)i32{
    let e:i32=j_stem_endpos(hay,stem,from);
    if(e<0){return 0;}
    if(e<=wlim){return 1;}
    return 0;
}

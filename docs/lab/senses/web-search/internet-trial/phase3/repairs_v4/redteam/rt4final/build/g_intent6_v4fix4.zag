}
// j_pos_verb_pos: index of the earliest positive verb at/after `from`, or -1.
fn j_pos_verb_pos(hay:[]u8,from:i32)i32{
    let best:i32=-1;
    let p:i32=j_phrase_pos(hay,"love",from);
    if(p>=0){best=p;}
    p=j_phrase_pos(hay,"adore",from);
    if(p>=0&&(best<0||p<best)){best=p;}
    p=j_phrase_pos(hay,"admire",from);
    if(p>=0&&(best<0||p<best)){best=p;}
    p=j_phrase_pos(hay,"enjoy",from);
    if(p>=0&&(best<0||p<best)){best=p;}
    p=j_phrase_pos(hay,"celebrate",from);
    if(p>=0&&(best<0||p<best)){best=p;}
    p=j_phrase_pos(hay,"laugh",from);
    if(p>=0&&(best<0||p<best)){best=p;}
    return best;
}
// j_valence_clash, round-4: the negative noun must be the positive verb's direct
// object. If a purpose infinitive ("to <verb>") intervenes between verb and
// noun, the negativity is clause-owned elsewhere and there is no clash. (E.g.
// "love the extra time TO FIX mistakes" is sincere; "admire the problem" is
// the joke.) lim bounds the search region (whole line for the standalone rule).
fn j_valence_clash(hay:[]u8,from:i32,lim:i32)i32{
    let vp:i32=j_pos_verb_pos(hay,from);
    if(vp<0||vp>=lim){return 0;}
    let ve:i32=vp;
    while(ve<hay.len&&j_is_alnum(hay[ve])!=0){ve=ve+1;}
    let np:i32=j_phrase_pos(hay,"mistakes",vp);
    let cand:i32=-1;
    if(np>=0&&np<lim){cand=np;}
    np=j_phrase_pos(hay,"disaster",vp);
    if(np>=0&&np<lim&&(cand<0||np<cand)){cand=np;}
    np=j_phrase_pos(hay,"insanity",vp);
    if(np>=0&&np<lim&&(cand<0||np<cand)){cand=np;}
    np=j_phrase_pos(hay,"problem",vp);
    if(np>=0&&np<lim&&(cand<0||np<cand)){cand=np;}
    np=j_phrase_pos(hay,"failure",vp);
    if(np>=0&&np<lim&&(cand<0||np<cand)){cand=np;}
    np=j_phrase_pos(hay,"nightmare",vp);
    if(np>=0&&np<lim&&(cand<0||np<cand)){cand=np;}
    np=j_phrase_pos(hay,"migraines",vp);
    if(np>=0&&np<lim&&(cand<0||np<cand)){cand=np;}
    np=j_phrase_pos(hay,"migraine",vp);
    if(np>=0&&np<lim&&(cand<0||np<cand)){cand=np;}
    np=j_phrase_pos(hay,"headache",vp);
    if(np>=0&&np<lim&&(cand<0||np<cand)){cand=np;}
    if(cand<0){
        // Carried path (C15: first-half "insanity" carried by second-half "it").
        if(j_neg_noun(hay,0,vp)!=0){
            if(j_has_word_lim(hay,"it",vp,hay.len)!=0){return 1;}
            if(j_has_word_lim(hay,"this",vp,hay.len)!=0){return 1;}
            if(j_has_word_lim(hay,"that",vp,hay.len)!=0){return 1;}
            if(j_has_word_lim(hay,"them",vp,hay.len)!=0){return 1;}
        }
        return 0;
    }
    let tp:i32=j_phrase_pos(hay,"to",ve);
    if(tp>=0&&tp<cand){return 0;}
    return 1;
}
// A pun fires when a figurative idiom appears alongside a word that
// primes its LITERAL meaning. Both halves are semantic classes, not
// single rows.
// j_growable: things that literally grow.
fn j_growable(hay:[]u8)i32{
    if(j_has_word(hay,"hair")!=0){return 1;}
    if(j_has_word(hay,"beard")!=0){return 1;}
    if(j_has_word(hay,"beards")!=0){return 1;}
    if(j_has_word(hay,"mustache")!=0){return 1;}
    if(j_has_word(hay,"mustaches")!=0){return 1;}
    if(j_has_word(hay,"plant")!=0){return 1;}
    if(j_has_word(hay,"plants")!=0){return 1;}
    if(j_has_word(hay,"mold")!=0){return 1;}
    if(j_has_word(hay,"nail")!=0){return 1;}
    if(j_has_word(hay,"nails")!=0){return 1;}
    if(j_has_word(hay,"grass")!=0){return 1;}
    if(j_has_word(hay,"tree")!=0){return 1;}
    if(j_has_word(hay,"trees")!=0){return 1;}
    if(j_has_word(hay,"flower")!=0){return 1;}
    if(j_has_word(hay,"flowers")!=0){return 1;}
    if(j_has_word(hay,"garden")!=0){return 1;}
    if(j_has_word(hay,"ivy")!=0){return 1;}
    if(j_has_word(hay,"moss")!=0){return 1;}
    if(j_has_word(hay,"crystal")!=0){return 1;}
    if(j_has_word(hay,"fungus")!=0){return 1;}
    if(j_has_word(hay,"sprout")!=0){return 1;}
    if(j_has_word(hay,"seedling")!=0){return 1;}
    return 0;
}
// j_pun_grow: "grew on me" + something that literally grows.
fn j_pun_grow(hay:[]u8)i32{
    if(j_has_word(hay,"grew on me")==0){return 0;}
    if(j_growable(hay)!=0){return 1;}
    return 0;
}
// j_traversable: obstacles one physically gets over.
fn j_traversable(hay:[]u8)i32{
    if(j_has_word(hay,"bump")!=0){return 1;}
    if(j_has_word(hay,"bumps")!=0){return 1;}
    if(j_has_word(hay,"hurdle")!=0){return 1;}
    if(j_has_word(hay,"hurdles")!=0){return 1;}
    if(j_has_word(hay,"wall")!=0){return 1;}
    if(j_has_word(hay,"walls")!=0){return 1;}
    if(j_has_word(hay,"fence")!=0){return 1;}
    if(j_has_word(hay,"fences")!=0){return 1;}
    if(j_has_word(hay,"bridge")!=0){return 1;}
    if(j_has_word(hay,"bridges")!=0){return 1;}
    if(j_has_word(hay,"obstacle")!=0){return 1;}
    if(j_has_word(hay,"mountain")!=0){return 1;}
    if(j_has_word(hay,"hill")!=0){return 1;}
    if(j_has_word(hay,"hills")!=0){return 1;}
    if(j_has_word(hay,"barrier")!=0){return 1;}
    if(j_has_word(hay,"gate")!=0){return 1;}
    if(j_has_word(hay,"ditch")!=0){return 1;}
    if(j_has_word(hay,"log")!=0){return 1;}
    return 0;
}
// j_grave_ctx: grave/institutional context marks sincere usage of an idiom.
// The "getting over it" / "jump to conclusions" puns need a non-serious
// frame for the bathos; "after the war they had to get over it" and "the
// coach warned the team not to jump to conclusions" are sincere.
fn j_grave_ctx(hay:[]u8)i32{
    if(j_has_word(hay,"war")!=0){return 1;}
    if(j_has_word(hay,"death")!=0){return 1;}
    if(j_has_word(hay,"died")!=0){return 1;}
    if(j_has_word(hay,"trauma")!=0){return 1;}
    if(j_has_word(hay,"grief")!=0){return 1;}
    if(j_has_word(hay,"funeral")!=0){return 1;}
    if(j_has_word(hay,"warned")!=0){return 1;}
    if(j_has_word(hay,"warn")!=0){return 1;}
    if(j_has_word(hay,"coach")!=0){return 1;}
    if(j_has_word(hay,"therapist")!=0){return 1;}
    return 0;
}
// j_pun_over: "get(ting) over it" + fear context + traversable obstacle.
fn j_pun_over(hay:[]u8)i32{
    if(j_grave_ctx(hay)!=0){return 0;}
    let g:i32=0;
    if(j_has_word(hay,"getting over it")!=0){g=1;}
    if(j_has_word(hay,"get over it")!=0){g=1;}
    if(j_has_word(hay,"got over it")!=0){g=1;}
    if(g==0){return 0;}
    let f:i32=0;
    if(j_has_word(hay,"fear of")!=0){f=1;}
    if(j_has_word(hay,"fear")!=0){f=1;}
    if(j_has_word(hay,"fears")!=0){f=1;}
    if(j_has_word(hay,"afraid of")!=0){f=1;}
    if(j_has_word(hay,"afraid")!=0){f=1;}
    if(j_has_word(hay,"scared of")!=0){f=1;}
    if(f==0){return 0;}
    if(j_traversable(hay)!=0){return 1;}
    return 0;
}
// j_jumpctx: literal jumping contexts (excluding the idiom's own words
// jump/jumps/jumping/jumped, which would self-match).
fn j_jumpctx(hay:[]u8)i32{
    if(j_has_word(hay,"hurdle")!=0){return 1;}
    if(j_has_word(hay,"hurdles")!=0){return 1;}
    if(j_has_word(hay,"leap")!=0){return 1;}
    if(j_has_word(hay,"leaps")!=0){return 1;}
    if(j_has_word(hay,"leaping")!=0){return 1;}
    if(j_has_word(hay,"hop")!=0){return 1;}
    if(j_has_word(hay,"hops")!=0){return 1;}
    if(j_has_word(hay,"hopping")!=0){return 1;}
    if(j_has_word(hay,"bounce")!=0){return 1;}
    if(j_has_word(hay,"bounces")!=0){return 1;}
    if(j_has_word(hay,"bouncing")!=0){return 1;}
    if(j_has_word(hay,"trampoline")!=0){return 1;}
    if(j_has_word(hay,"trampolines")!=0){return 1;}
    return 0;
}
// j_pun_jump: "jump(ing) to conclusions" + literal jumping context.
// The hyphenated nominalization ("a jumping-to-conclusions problem") is the
// wordplay itself and fires regardless of frame; the verb forms need a
// non-grave frame ("the coach warned..." is sincere advice).
fn j_pun_jump(hay:[]u8)i32{
    let p:i32=0;
    if(j_has_word(hay,"jump to conclusions")!=0){p=1;}
    if(j_has_word(hay,"jumping to conclusions")!=0){p=1;}
    if(j_has_word(hay,"jumped to conclusions")!=0){p=1;}
    if(p!=0){
        if(j_grave_ctx(hay)!=0){return 0;}
        if(j_jumpctx(hay)!=0){return 1;}
        return 0;
    }
    if(j_has_word(hay,"jump-to-conclusions")!=0){p=1;}
    if(j_has_word(hay,"jumping-to-conclusions")!=0){p=1;}
    if(j_has_word(hay,"jumped-to-conclusions")!=0){p=1;}
    if(p==0){return 0;}
    if(j_jumpctx(hay)!=0){return 1;}
    return 0;
}
// j_mathword: math domain words (fraction-bar "line" is literal here).
fn j_mathword(hay:[]u8)i32{
    if(j_has_word(hay,"numerator")!=0){return 1;}
    if(j_has_word(hay,"denominator")!=0){return 1;}
    if(j_has_word(hay,"fraction")!=0){return 1;}
    if(j_has_word(hay,"fractions")!=0){return 1;}
    if(j_has_word(hay,"equation")!=0){return 1;}
    if(j_has_word(hay,"formula")!=0){return 1;}
    if(j_has_word(hay,"decimal")!=0){return 1;}
    if(j_has_word(hay,"percent")!=0){return 1;}
    if(j_has_word(hay,"percentage")!=0){return 1;}
    if(j_has_word(hay,"algebra")!=0){return 1;}
    if(j_has_word(hay,"calculus")!=0){return 1;}
    if(j_has_word(hay,"geometry")!=0){return 1;}
    if(j_has_word(hay,"integer")!=0){return 1;}
    if(j_has_word(hay,"divisor")!=0){return 1;}
    if(j_has_word(hay,"dividend")!=0){return 1;}
    if(j_has_word(hay,"quotient")!=0){return 1;}
    return 0;
}
// j_pun_line: "fine line between" + math domain (the line is literal).
fn j_pun_line(hay:[]u8)i32{
    if(j_has_word(hay,"fine line between")==0){return 0;}
    if(j_mathword(hay)!=0){return 1;}
    return 0;
}
// j_celestial: sky objects that "come out".
fn j_celestial(hay:[]u8)i32{
    if(j_has_word(hay,"stars")!=0){return 1;}
    if(j_has_word(hay,"star")!=0){return 1;}
    if(j_has_word(hay,"sun")!=0){return 1;}
    if(j_has_word(hay,"moon")!=0){return 1;}
    if(j_has_word(hay,"planets")!=0){return 1;}
    if(j_has_word(hay,"planet")!=0){return 1;}
    return 0;
}
// j_dental: teeth/denture words ("come out" = removed).
fn j_dental(hay:[]u8)i32{
    if(j_has_word(hay,"teeth")!=0){return 1;}
    if(j_has_word(hay,"tooth")!=0){return 1;}
    if(j_has_word(hay,"dentures")!=0){return 1;}
    if(j_has_word(hay,"denture")!=0){return 1;}
    if(j_has_word(hay,"molars")!=0){return 1;}
    if(j_has_word(hay,"molar")!=0){return 1;}
    return 0;
}
// j_pun_comeout: "come out" with both celestial (appear) and dental (removed)
// contexts primed = the dual-meaning pun is active.
fn j_pun_comeout(hay:[]u8)i32{
    if(j_has_word(hay,"come out")==0){return 0;}
    if(j_celestial(hay)==0){return 0;}
    if(j_dental(hay)!=0){return 1;}
    return 0;
}


// ================= round-2 turn-evidence helpers =================
// Principle: a joke needs the TURN (setup -> incongruity -> punchline), not
// just the shape. Every install rule below pairs a shape signal with an
// incongruity signal (punch lexicon, wordplay pair, absurd entity, polarity
// flip, wry marker). Shape alone never installs.

// j_pivot_at: first setup/punchline pivot at/after from: ";", "?", "!" or a
// sentence boundary (". "+alnum). Returns index or -1.
fn j_pivot_at(hay:[]u8,from:i32)i32{
    let i:i32=from;
    if(i<0){i=0;}
    while(i<hay.len){
        let c:u8=hay[i];
        if(c==59){return i;}
        if(c==63){return i;}
        if(c==33){return i;}
        if(c==46){
            if(i+2<hay.len){
                if(hay[i+1]==32){
                    if(j_is_alnum(hay[i+2])!=0){return i;}
                }
            }
        }
        i=i+1;
    }
    return -1;
}

// j_wpivot_at: earliest contrast word-pivot (but/however/yet/shame/instead/
// "too bad") at/after from, whole-word, or -1.
fn j_wpivot_at(hay:[]u8,from:i32)i32{
    let best:i32=-1;
    let p:i32=j_phrase_pos(hay,"but",from);
    if(p>=0){if(best<0){best=p;}else{if(p<best){best=p;}}}
    p=j_phrase_pos(hay,"however",from);
    if(p>=0){if(best<0){best=p;}else{if(p<best){best=p;}}}
    p=j_phrase_pos(hay,"yet",from);
    if(p>=0){if(best<0){best=p;}else{if(p<best){best=p;}}}
    p=j_phrase_pos(hay,"shame",from);
    if(p>=0){if(best<0){best=p;}else{if(p<best){best=p;}}}
    p=j_phrase_pos(hay,"instead",from);
    if(p>=0){if(best<0){best=p;}else{if(p<best){best=p;}}}
    p=j_phrase_pos(hay,"too bad",from);
    if(p>=0){if(best<0){best=p;}else{if(p<best){best=p;}}}
    return best;
}

// j_sent_start: 1 if pos is at a sentence start (0 or after ". "/"? "/"! ").
fn j_sent_start(hay:[]u8,pos:i32)i32{
    if(pos<=0){return 1;}
    if(pos>=2){
        if(hay[pos-1]==32){
            let c:u8=hay[pos-2];
            if(c==46){return 1;}
            if(c==63){return 1;}
            if(c==33){return 1;}
        }
    }
    return 0;
}

// j_any_pivot: earliest of punctuation pivot, contrast word-pivot, or a
// sentence starting with Now/Or (contrastive sentence openers).
fn j_any_pivot(hay:[]u8,from:i32)i32{
    let best:i32=j_pivot_at(hay,from);
    let p:i32=j_wpivot_at(hay,from);
    if(p>=0){if(best<0){best=p;}else{if(p<best){best=p;}}}
    p=j_phrase_pos(hay,"now",from);
    if(p>=0){
        if(j_sent_start(hay,p)!=0){
            if(best<0){best=p;}else{if(p<best){best=p;}}
        }
    }
    p=j_phrase_pos(hay,"or",from);
    if(p>=0){
        if(j_sent_start(hay,p)!=0){
            if(best<0){best=p;}else{if(p<best){best=p;}}
        }
    }
    return best;
}

// j_words_between: count of words strictly between positions a and b.
fn j_words_between(hay:[]u8,a:i32,b:i32)i32{
    if(a<0){a=0;}
    if(b>hay.len){b=hay.len;}
    if(b<=a){return 0;}
    let n:i32=0;
    let i:i32=a;
    while(i<b){
        while(i<b){if(j_is_alnum(hay[i])!=0){break;}i=i+1;}
        if(i>=b){break;}
        n=n+1;
        while(i<b){if(j_is_alnum(hay[i])==0){break;}i=i+1;}
    }
    return n;
}

// j_word_final: the word w occurs at/after `from` with only non-alphanumeric
// characters between its end and the end of the line — i.e. w IS the
// punchline's last word. A riddle's punch word is the payoff: it must land
// last. A mid-answer "carrot"/"bugs" ("the carrot market crashed") is ordinary
// prose, not the turn.
fn j_word_final(hay:[]u8,w:[]u8,from:i32)i32{
    let p:i32=j_phrase_pos(hay,w,from);
    while(p>=0){
        let e:i32=p+w.len;
        let rest:i32=0;
        let i:i32=e;
        while(i<hay.len){if(j_is_alnum(hay[i])!=0){rest=1;break;}i=i+1;}
        if(rest==0){return 1;}
        p=j_phrase_pos(hay,w,p+1);
    }
    return 0;
}
// j_qa_punch: punchline lexicon for riddle answers (wordplay / anti-joke payoffs).
fn j_qa_punch(hay:[]u8,from:i32)i32{
    if(j_phrase_pos(hay,"other side",from)>=0){return 1;}
    if(j_phrase_pos(hay,"make up",from)>=0){return 1;}
    if(j_phrase_pos(hay,"off and on",from)>=0){return 1;}
    if(j_phrase_pos(hay,"hook, line",from)>=0){return 1;}
    if(j_phrase_pos(hay,"two-tired",from)>=0){return 1;}
    if(j_phrase_pos(hay,"big plus",from)>=0){return 1;}
    if(j_word_final(hay,"brick",from)!=0){return 1;}
    if(j_word_final(hay,"awful",from)!=0){return 1;}
    if(j_word_final(hay,"fsh",from)!=0){return 1;}
    if(j_word_final(hay,"outstanding",from)!=0){return 1;}
    if(j_word_final(hay,"field",from)!=0){return 1;}
    if(j_word_final(hay,"carrot",from)!=0){return 1;}
    if(j_word_final(hay,"bugs",from)!=0){return 1;}
    if(j_word_final(hay,"waved",from)!=0){return 1;}
    if(j_word_final(hay,"crumby",from)!=0){return 1;}
    return 0;
}

// j_qa_opener: riddle opener at text start: wh-word, aux+?, "tell me",
// "knock knock", "guess what".
fn j_qa_opener(hay:[]u8)i32{
    if(j_word_at(hay,0,"what")!=0){return 1;}
    if(j_word_at(hay,0,"why")!=0){return 1;}
    if(j_word_at(hay,0,"how")!=0){return 1;}
    if(j_word_at(hay,0,"when")!=0){return 1;}
    if(j_word_at(hay,0,"where")!=0){return 1;}
    if(j_word_at(hay,0,"who")!=0){return 1;}
    if(j_word_at(hay,0,"which")!=0){return 1;}
    let qm:i32=j_sub_pos(hay,"?",0);
    if(qm>=0){
        if(j_word_at(hay,0,"do")!=0){return 1;}
        if(j_word_at(hay,0,"does")!=0){return 1;}
        if(j_word_at(hay,0,"did")!=0){return 1;}
        if(j_word_at(hay,0,"is")!=0){return 1;}
        if(j_word_at(hay,0,"are")!=0){return 1;}
        if(j_word_at(hay,0,"can")!=0){return 1;}
    }
    if(j_phrase_pos(hay,"tell me",0)==0){return 1;}
    if(j_phrase_pos(hay,"knock knock",0)==0){return 1;}
    if(j_phrase_pos(hay,"guess what",0)==0){return 1;}
    if(j_phrase_pos(hay,"guess why",0)==0){return 1;}
    if(j_phrase_pos(hay,"know why",0)==0){return 1;}
    return 0;
}

// j_qa_opener_at: riddle opener at position pos. auxok=1 allows aux openers
// (only when a "?" is present, else imperatives like "do not start" match).
fn j_qa_opener_at(hay:[]u8,pos:i32,auxok:i32)i32{
    if(j_word_at(hay,pos,"what")!=0){return 1;}
    if(j_word_at(hay,pos,"why")!=0){return 1;}
    if(j_word_at(hay,pos,"how")!=0){return 1;}
    if(j_word_at(hay,pos,"when")!=0){return 1;}
    if(j_word_at(hay,pos,"where")!=0){return 1;}
    if(j_word_at(hay,pos,"who")!=0){return 1;}
    if(j_word_at(hay,pos,"which")!=0){return 1;}
    if(auxok!=0){
        if(j_word_at(hay,pos,"do")!=0){return 1;}
        if(j_word_at(hay,pos,"does")!=0){return 1;}
        if(j_word_at(hay,pos,"did")!=0){return 1;}
        if(j_word_at(hay,pos,"is")!=0){return 1;}
        if(j_word_at(hay,pos,"are")!=0){return 1;}
        if(j_word_at(hay,pos,"can")!=0){return 1;}
    }
    if(j_phrase_pos(hay,"tell me",pos)==pos){return 1;}
    if(j_phrase_pos(hay,"knock knock",pos)==pos){return 1;}
    if(j_phrase_pos(hay,"guess what",pos)==pos){return 1;}
    if(j_phrase_pos(hay,"guess why",pos)==pos){return 1;}
    if(j_phrase_pos(hay,"know why",pos)==pos){return 1;}
    return 0;
}

// j_qa_answer_ok: the answer span [ans,end) pays off the riddle: a punchline
// wordplay or absurd entity, in >=2 words, or a single punch word.
fn j_qa_answer_ok(hay:[]u8,ans:i32)i32{
    let w:i32=j_words_between(hay,ans,hay.len);
    if(w<1){return 0;}
    if(j_qa_punch(hay,ans)!=0){return 1;}
    if(j_absurd_ent(hay,ans)!=0){return 1;}
    return 0;
}

// j_qa_turn: riddle opener + an answer that pays off with a punchline.
fn j_qa_turn(hay:[]u8)i32{
    let q:i32=j_sub_pos(hay,"?",0);
    if(q<0){
        if(j_qa_opener_at(hay,0,0)==0){return 0;}
        let pb:i32=j_pivot_at(hay,0);
        if(pb<0){return 0;}
        return j_qa_answer_ok(hay,pb+1);
    }
    // the sentence holding "?" must open with a riddle opener
    let ss:i32=q;
    while(ss>0){
        let pc:u8=hay[ss-1];
        if(pc==46||pc==63||pc==33){break;}
        ss=ss-1;
    }
    while(ss<q){
        let cc:u8=hay[ss];
        if(cc==46||cc==63||cc==33||cc==32){ss=ss+1;}
        else{break;}
    }
    if(j_qa_opener_at(hay,ss,1)==0){return 0;}
    return j_qa_answer_ok(hay,q+1);
}

// j_absurd_ent: absurd entities that mark a punchline as the joke's turn.
fn j_absurd_ent(hay:[]u8,from:i32)i32{
    if(j_has_word_lim(hay,"cheese",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"batman",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"aliens",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"alien",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"zombie",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"zombies",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"vampire",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"ghost",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"dragon",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"unicorn",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"martian",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"cardboard box",from,hay.len)!=0){return 1;}
    return 0;
}

// j_deny_turn: comic denial = "not a joke"-style denial about the statement
// itself (self-reference), with no serious continuation cancelling the read.
fn j_deny_turn(hay:[]u8)i32{
    let d:i32=0;
    if(j_has_word(hay,"not a joke")!=0){d=1;}
    if(j_has_word(hay,"not joking")!=0){d=1;}
    if(j_has_word(hay,"no joke")!=0){d=1;}
    if(j_has_word(hay,"not kidding")!=0){d=1;}
    if(d==0){return 0;}
    let sr:i32=0;
    if(j_has_word(hay,"this statement")!=0){sr=1;}
    if(j_phrase_pos(hay,"right now",0)>=0){sr=1;}
    if(sr==0){return 0;}
    if(j_has_word(hay,"serious")!=0){return 0;}
    if(j_has_word(hay,"evacuate")!=0){return 0;}
    if(j_has_word(hay,"deadline")!=0){return 0;}
    if(j_has_word(hay,"emergency")!=0){return 0;}
    if(j_has_word(hay,"warning")!=0){return 0;}
    if(j_phrase_pos(hay,"not a test",0)>=0){return 0;}
    // A denial followed by a concrete status report (closure, maintenance,
    // outage) is a sincere public notice, not the joke: the comic denial
    // pairs with self-reference or absurd content, never with a maintenance
    // bulletin.
    if(j_has_word(hay,"maintenance")!=0){return 0;}
    if(j_has_word(hay,"closed")!=0){return 0;}
    if(j_phrase_pos(hay,"down for",0)>=0){return 0;}
    if(j_has_word(hay,"cancelled")!=0){return 0;}
    if(j_has_word(hay,"canceled")!=0){return 0;}
    if(j_has_word(hay,"delayed")!=0){return 0;}
    if(j_has_word(hay,"outage")!=0){return 0;}
    return 1;
}

// j_bar_turn: completed bar joke = "walk(ed/s) into a bar" + a pun payoff.
fn j_bar_turn(hay:[]u8)i32{
    let p:i32=j_phrase_pos(hay,"walked into a bar",0);
    if(p<0){p=j_phrase_pos(hay,"walks into a bar",0);}
    if(p<0){p=j_phrase_pos(hay,"walk into a bar",0);}
    if(p<0){p=j_phrase_pos(hay,"limps into a bar",0);}
    if(p<0){p=j_phrase_pos(hay,"limp into a bar",0);}
    if(p<0){return 0;}
    // "tense" needs the past/present/future grammar anchor (anywhere in the
    // line — the anchor usually precedes the bar).
    if(j_phrase_pos(hay,"tense",p)>=0){
        if(j_phrase_pos(hay,"past",0)>=0){return 1;}
        if(j_phrase_pos(hay,"present",0)>=0){return 1;}
        if(j_phrase_pos(hay,"future",0)>=0){return 1;}
    }
    // "long face" is the pun only when the subject is an animal/photon-grade
    // wordplay carrier (horse, photon); on a person it is literal sadness.
    if(j_phrase_pos(hay,"long face",p)>=0){
        if(j_phrase_pos(hay,"horse",0)>=0){return 1;}
        if(j_phrase_pos(hay,"photon",0)>=0){return 1;}
    }
    if(j_has_word_lim(hay,"drunk",p,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"spirits",p,hay.len)!=0){return 1;}
    // "laughed"/"joke" alone are ordinary bar events, not the pun's turn.
    return 0;
}

// j_neg_first: negation marker in [0,pv).
fn j_neg_first(hay:[]u8,pv:i32)i32{
    if(j_has_word_lim(hay,"never",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"not",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"no",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"nobody",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"nothing",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"don't",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"doesn't",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"didn't",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"can't",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"won't",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"cannot",0,pv)!=0){return 1;}
    return 0;
}

// j_pos_verb: positive-valence verbs whose application to a negative-valence
// object is an incongruity ("admire the problem", "enjoy ... insanity").
// j_when_do: the "not X, but when I do, Y" temporal-confession template: the
// denial is undercut by a hyper-specific confession. The "when <pron> do"
// clause is the turn; a bare aux flip ("don't enjoy ... do finish") is not.
fn j_when_do(hay:[]u8,pv:i32)i32{
    if(j_phrase_pos(hay,"when i do",pv)>=0){return 1;}
    if(j_phrase_pos(hay,"when you do",pv)>=0){return 1;}
    if(j_phrase_pos(hay,"when we do",pv)>=0){return 1;}
    if(j_phrase_pos(hay,"when they do",pv)>=0){return 1;}
    if(j_phrase_pos(hay,"when he does",pv)>=0){return 1;}
    if(j_phrase_pos(hay,"when she does",pv)>=0){return 1;}
    if(j_phrase_pos(hay,"when i could",pv)>=0){return 1;}
    if(j_phrase_pos(hay,"when you could",pv)>=0){return 1;}
    return 0;
}
// j_abs_undercut: a self-undermining absolute: "never" first-half, then
// "I thought I did once, but I was wrong" — the retraction instantiates the
// denied thing. Admission AND retraction are both required; a bare
// "never ... I was wrong" can be sincere.
fn j_abs_undercut(hay:[]u8,pv:i32)i32{
    if(j_has_word_lim(hay,"never",0,pv)==0){return 0;}
    if(j_phrase_pos(hay,"i thought i",pv)<0){return 0;}
    if(j_phrase_pos(hay,"i was wrong",pv)<0){return 0;}
    return 1;
}
// j_aux_flip: contracted negative auxiliary first-half, bare affirmative
// second-half — installs ONLY with genuine incongruity beyond the flip: the
// "not X, but when I do, Y" confession template, or a valence clash
// ("do admire the problem"). A bare flip onto a new verb ("don't enjoy the
// audit, but we do finish it") is ordinary contrast and stays out.
fn j_aux_flip(hay:[]u8,pv:i32)i32{
    let f:i32=0;
    if(j_has_word_lim(hay,"don't",0,pv)!=0){if(j_has_word_lim(hay,"do",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"can't",0,pv)!=0){if(j_has_word_lim(hay,"can",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"won't",0,pv)!=0){if(j_has_word_lim(hay,"will",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"didn't",0,pv)!=0){if(j_has_word_lim(hay,"did",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"isn't",0,pv)!=0){if(j_has_word_lim(hay,"is",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"aren't",0,pv)!=0){if(j_has_word_lim(hay,"are",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"could not",0,pv)!=0){if(j_has_word_lim(hay,"could",pv,hay.len)!=0){f=1;}}
    if(f==0){return 0;}
    if(j_when_do(hay,pv)!=0){return 1;}
    if(j_valence_clash(hay,pv,hay.len)!=0){return 1;}
    return 0;
}

// j_antonym: first-half word whose antonym lands second-half — installs ONLY
// when the flip carries genuine incongruity: a valence clash on the same
// referent ("enjoy every minute of it" = insanity), or a self-undermining
// absolute ("never ... I thought I did once, but I was wrong"). An antonym
// onto a fresh referent ("hate the new schedule; love the old one") is
// ordinary contrast.
fn j_antonym(hay:[]u8,pv:i32)i32{
    let f:i32=0;
    if(j_has_word_lim(hay,"mistakes",0,pv)!=0){if(j_has_word_lim(hay,"wrong",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"suffer",0,pv)!=0){if(j_has_word_lim(hay,"enjoy",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"hate",0,pv)!=0){if(j_has_word_lim(hay,"love",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"cry",0,pv)!=0){if(j_has_word_lim(hay,"laugh",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"lose",0,pv)!=0){if(j_has_word_lim(hay,"find",pv,hay.len)!=0){f=1;}}
    if(j_has_word_lim(hay,"forget",0,pv)!=0){if(j_has_word_lim(hay,"remember",pv,hay.len)!=0){f=1;}}
    if(f==0){return 0;}
    if(j_valence_clash(hay,pv,hay.len)!=0){return 1;}
    if(j_abs_undercut(hay,pv)!=0){return 1;}
    return 0;
}

// j_pron2: a pronoun in the second half that can carry the first half's
// referent across the pivot ("it" = insanity).
fn j_pron2(hay:[]u8,from:i32)i32{
    if(j_has_word_lim(hay,"it",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"this",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"that",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"them",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"these",from,hay.len)!=0){return 1;}
    if(j_has_word_lim(hay,"those",from,hay.len)!=0){return 1;}
    return 0;
}
// j_tense_twist: first-half future intention undercut by a second-half past
// failure — installs ONLY when the failure targets the same proposition
// (a second-half pronoun carrying the first half's referent): "would tell
// you ... but you did not like it". A past failure about something else
// ("would approve, but you did not qualify") is ordinary contrast.
fn j_tense_twist(hay:[]u8,pv:i32)i32{
    let fut:i32=0;
    if(j_has_word_lim(hay,"would",0,pv)!=0){fut=1;}
    if(j_has_word_lim(hay,"will",0,pv)!=0){fut=1;}
    let gp:i32=j_phrase_pos(hay,"going to",0);
    if(gp>=0){if(gp<pv){fut=1;}}
    if(fut==0){return 0;}
    // The joke form is the self-undermining joke-telling act: "I would tell
    // you a joke about X, but ...". A mundane conditional ("I would approve
    // the budget, but you did not submit it") is ordinary, not a twist.
    let tg:i32=j_phrase_pos(hay,"tell you",0);
    if(tg<0){tg=j_phrase_pos(hay,"tell u",0);}
    if(tg<0||tg>=pv){return 0;}
    let past:i32=0;
    if(j_has_word_lim(hay,"did not",pv,hay.len)!=0){past=1;}
    if(j_has_word_lim(hay,"didn't",pv,hay.len)!=0){past=1;}
    if(j_has_word_lim(hay,"was not",pv,hay.len)!=0){past=1;}
    if(j_has_word_lim(hay,"were not",pv,hay.len)!=0){past=1;}
    // Anti-climax: the work is "still working on it" — the twist's failure
    // is that it never finished, not a past event.
    if(j_phrase_pos(hay,"still working on",pv)>=0){past=1;}
    if(past==0){return 0;}
    if(j_pron2(hay,pv)!=0){return 1;}
    return 0;
}

// j_prefixed_word_in: 1 if prefix+hay[ws..we) occurs as a whole word in [a,b).
fn j_prefixed_word_in(hay:[]u8,ws:i32,we:i32,pre:[]u8,a:i32,b:i32)i32{
    let total:i32=pre.len+(we-ws);
    let i:i32=a;
    while(i+total<=b){
        if(i>a){
            if(j_is_alnum(hay[i-1])!=0){i=i+1;}
            else{
                let k:i32=0;
                while(k<pre.len){if(hay[i+k]!=pre[k]){break;}k=k+1;}
                if(k<pre.len){i=i+1;}
                else{
                    let j2:i32=0;
                    while(j2<we-ws){if(hay[i+pre.len+j2]!=hay[ws+j2]){break;}j2=j2+1;}
                    if(j2<we-ws){i=i+1;}
                    else{
                        let e:i32=i+total;
                        if(e<b){if(j_is_alnum(hay[e])!=0){i=i+1;}else{return 1;}}
                        else{return 1;}
                    }
                }
            }
        }else{
            let k2:i32=0;
            while(k2<pre.len){if(hay[i+k2]!=pre[k2]){break;}k2=k2+1;}
            if(k2<pre.len){i=i+1;}
            else{
                let j3:i32=0;
                while(j3<we-ws){if(hay[i+pre.len+j3]!=hay[ws+j3]){break;}j3=j3+1;}
                if(j3<we-ws){i=i+1;}
                else{
                    let e2:i32=i+total;
                    if(e2<b){if(j_is_alnum(hay[e2])!=0){i=i+1;}else{return 1;}}
                    else{return 1;}
                }
            }
        }
    }
    return 0;
}

// j_prefix_echo: a second-half word W (len>=4) whose negating-prefixed form
// (super/un/in/im/dis/non)+W appears first-half ("superstitious"->"stitious").
fn j_prefix_echo(hay:[]u8,pv:i32)i32{
    let i:i32=pv;
    while(i<hay.len){
        while(i<hay.len){if(j_is_alnum(hay[i])!=0){break;}i=i+1;}
        if(i>=hay.len){break;}
        let ws:i32=i;
        while(i<hay.len){if(j_is_alnum(hay[i])==0){break;}i=i+1;}
        let we:i32=i;
        // The wordplay is the stripped form used NON-referentially (predicate /
        // adjective position: "a little stitious"). A determiner-led NP ("the
        // star", "the competent one") is ordinary sincere contrast.
        let ref_np:i32=0;
        let b:i32=ws-1;
        while(b>=0){if(j_is_alnum(hay[b])!=0){break;}b=b-1;}
        if(b>=0){
            let be:i32=b+1;
            while(b>0){if(j_is_alnum(hay[b-1])==0){break;}b=b-1;}
            let wlen:i32=be-b;
            if(j_word_at(hay,b,"the")!=0){ref_np=1;}
            if(j_word_at(hay,b,"a")!=0){ref_np=1;}
            if(j_word_at(hay,b,"an")!=0){ref_np=1;}
            if(j_word_at(hay,b,"this")!=0){ref_np=1;}
            if(j_word_at(hay,b,"that")!=0){ref_np=1;}
            if(j_word_at(hay,b,"these")!=0){ref_np=1;}
            if(j_word_at(hay,b,"those")!=0){ref_np=1;}
            if(j_word_at(hay,b,"my")!=0){ref_np=1;}
            if(j_word_at(hay,b,"your")!=0){ref_np=1;}
            if(j_word_at(hay,b,"his")!=0){ref_np=1;}
            if(j_word_at(hay,b,"her")!=0){ref_np=1;}
            if(j_word_at(hay,b,"its")!=0){ref_np=1;}
            if(j_word_at(hay,b,"our")!=0){ref_np=1;}
            if(j_word_at(hay,b,"their")!=0){ref_np=1;}
        }
        if(ref_np==0&&we-ws>=4){
            if(j_prefixed_word_in(hay,ws,we,"super",0,pv)!=0){return 1;}
            if(j_prefixed_word_in(hay,ws,we,"un",0,pv)!=0){return 1;}
            if(j_prefixed_word_in(hay,ws,we,"in",0,pv)!=0){return 1;}
            if(j_prefixed_word_in(hay,ws,we,"im",0,pv)!=0){return 1;}
            if(j_prefixed_word_in(hay,ws,we,"dis",0,pv)!=0){return 1;}
            if(j_prefixed_word_in(hay,ws,we,"non",0,pv)!=0){return 1;}
        }
    }
    return 0;
}

// j_neg_turn: negation joke = first-half negation + pivot + a second-half
// GENUINE incongruity (round 3): the polarity flip alone never installs.
// Each flip sub-rule must show the flip creating an incongruity — a valence
// clash on the same referent, a wordplay pivot (prefix echo), a confession
// template, a self-undermining absolute, a same-proposition tense twist, or
// an absurd entity. Mere contrast ("can't approve X, but can review Y")
// stays out.
fn j_neg_turn(hay:[]u8)i32{
    let pv:i32=j_any_pivot(hay,0);
    if(pv<0){return 0;}
    if(j_words_between(hay,pv,hay.len)<2){return 0;}
    if(j_neg_first(hay,pv)==0){
        if(j_tense_twist(hay,pv)!=0){return 1;}
        return 0;
    }
    if(j_prefix_echo(hay,pv)!=0){return 1;}
    if(j_aux_flip(hay,pv)!=0){return 1;}
    if(j_antonym(hay,pv)!=0){return 1;}
    if(j_tense_twist(hay,pv)!=0){return 1;}
    if(j_absurd_ent(hay,pv)!=0){return 1;}
    return 0;
}

// j_incomplete_list: a promised enumeration that aborts — "two types of
// people:" followed by fewer "those who" groups than promised, or a trailing
// conjunction ("...and"). The aborted list is the turn, not any word in it.
fn j_incomplete_list(hay:[]u8)i32{
    if(j_phrase_pos(hay,"types of people",0)<0){return 0;}
    let n:i32=0;
    if(j_phrase_pos(hay,"two types of people",0)>=0){n=2;}
    if(j_phrase_pos(hay,"three types of people",0)>=0){n=3;}
    if(j_phrase_pos(hay,"four types of people",0)>=0){n=4;}
    if(j_phrase_pos(hay,"five types of people",0)>=0){n=5;}
    if(j_phrase_pos(hay,"10 types of people",0)>=0){n=10;}
    if(j_phrase_pos(hay,"ten types of people",0)>=0){n=10;}
    if(n==0){return 0;}
    let p:i32=j_phrase_pos(hay,"types of people",0)+15;
    let c:i32=0;
    let q:i32=j_phrase_pos(hay,"those who",p);
    while(q>=0){c=c+1;q=j_phrase_pos(hay,"those who",q+9);}
    if(c<n){return 1;}
    let e:i32=hay.len;
    while(e>0){if(j_is_alnum(hay[e-1])!=0){break;}e=e-1;}
    if(e>=3){if(j_word_at(hay,e-3,"and")!=0){return 1;}}
    if(e>=2){if(j_word_at(hay,e-2,"or")!=0){return 1;}}
    return 0;
}

// j_absurd_compliance: stated advice, then absurd literal compliance —
// "my boss said dress for the job you want ... so I showed up as Batman".
// The absurd entity lands where a normal consequence belongs: misdirection
// by literalism. The "said/told" gate keeps it advice-shaped.
// j_as_absurd: an absurd entity in the "as X" costume/role frame — "showed up
// as Batman". A bare absurd mention ("the cheese is aged") is not compliance.
fn j_as_absurd(hay:[]u8,from:i32)i32{
    let p:i32=j_phrase_pos(hay,"as",from);
    while(p>=0){
        // skip the optional article after "as"
        let q:i32=p+2;
        while(q<hay.len&&hay[q]==32){q=q+1;}
        if(j_word_at(hay,q,"a")==1){q=q+1;while(q<hay.len&&hay[q]==32){q=q+1;}}
        else{
            if(j_word_at(hay,q,"an")==1){q=q+2;while(q<hay.len&&hay[q]==32){q=q+1;}}
        }
        if(j_absurd_ent_at(hay,q)!=0){return 1;}
        p=j_phrase_pos(hay,"as",p+1);
    }
    return 0;
}
// j_absurd_ent_at: absurd entity starting exactly at word position q.
fn j_absurd_ent_at(hay:[]u8,q:i32)i32{
    if(j_word_at(hay,q,"batman")==1){return 1;}
    if(j_word_at(hay,q,"cheese")==1){return 1;}
    if(j_word_at(hay,q,"aliens")==1){return 1;}
    if(j_word_at(hay,q,"alien")==1){return 1;}
    if(j_word_at(hay,q,"zombie")==1){return 1;}
    if(j_word_at(hay,q,"zombies")==1){return 1;}
    if(j_word_at(hay,q,"vampire")==1){return 1;}
    if(j_word_at(hay,q,"ghost")==1){return 1;}
    if(j_word_at(hay,q,"dragon")==1){return 1;}
    if(j_word_at(hay,q,"unicorn")==1){return 1;}
    if(j_word_at(hay,q,"martian")==1){return 1;}
    if(j_word_at(hay,q,"cardboard")==1){
        if(j_word_at(hay,q+9,"box")==1){return 1;}
    }
    if(j_word_at(hay,q,"pet")==1){
        if(j_word_at(hay,q+4,"rock")==1){return 1;}
    }
    return 0;
}
fn j_absurd_compliance(hay:[]u8)i32{
    let s:i32=j_phrase_pos(hay,"so i",0);
    if(s<0){s=j_phrase_pos(hay,"so we",0);}
    if(s<0){s=j_phrase_pos(hay,"so he",0);}
    if(s<0){s=j_phrase_pos(hay,"so she",0);}
    if(s<0){s=j_phrase_pos(hay,"so they",0);}
    if(s<0){return 0;}
    let adv:i32=0;
    if(j_has_word_lim(hay,"said",0,s)!=0){adv=1;}
    if(j_has_word_lim(hay,"told",0,s)!=0){adv=1;}
    if(j_has_word_lim(hay,"advised",0,s)!=0){adv=1;}
    if(adv==0){return 0;}
    // The absurd entity must land in the "as X" role frame: "showed up as
    // Batman". Mundane mentions ("we ate cheese", "saw a ghost") are not
    // absurd compliance.
    if(j_as_absurd(hay,s)!=0){return 1;}
    return 0;
}

// j_deflation: bathos — a news-register discovery deflated by "just":
// "breaking: local man discovers his vintage wine was just old".
// The discovery verb promises significance; "just X" retracts it.
fn j_deflation(hay:[]u8)i32{
    let d:i32=j_phrase_pos(hay,"discovers",0);
    if(d<0){d=j_phrase_pos(hay,"discover",0);}
    if(d<0){d=j_phrase_pos(hay,"finds",0);}
    if(d<0){d=j_phrase_pos(hay,"found",0);}
    if(d<0){return 0;}
    if(j_phrase_pos(hay,"was just",d)<0){if(j_phrase_pos(hay,"is just",d)<0){return 0;}}
    // The bathos needs the news-parody subject: "local man" / "local woman".
    // Ordinary "just ..." ("just rounding the corner") is not deflation.
    if(j_phrase_pos(hay,"local man",0)>=0){return 1;}
    if(j_phrase_pos(hay,"local woman",0)>=0){return 1;}
    return 0;
}

// j_posexp_pos: earliest position of a positive-expectation noun
// (salary/reward/prize/...) or -1.
fn j_posexp_pos(hay:[]u8)i32{
    let b:i32=-1;
    let p:i32=j_phrase_pos(hay,"salary",0);
    if(p>=0){if(b<0){b=p;}else{if(p<b){b=p;}}}
    p=j_phrase_pos(hay,"reward",0);
    if(p>=0){if(b<0){b=p;}else{if(p<b){b=p;}}}
    p=j_phrase_pos(hay,"prize",0);
    if(p>=0){if(b<0){b=p;}else{if(p<b){b=p;}}}
    p=j_phrase_pos(hay,"bonus",0);
    if(p>=0){if(b<0){b=p;}else{if(p<b){b=p;}}}
    p=j_phrase_pos(hay,"promotion",0);
    if(p>=0){if(b<0){b=p;}else{if(p<b){b=p;}}}
    p=j_phrase_pos(hay,"vacation",0);
    if(p>=0){if(b<0){b=p;}else{if(p<b){b=p;}}}
    p=j_phrase_pos(hay,"paycheck",0);
    if(p>=0){if(b<0){b=p;}else{if(p<b){b=p;}}}
    p=j_phrase_pos(hay,"benefit",0);
    if(p>=0){if(b<0){b=p;}else{if(p<b){b=p;}}}
    return b;
}

// j_payoff_clash: a positive-expectation noun revealed as a negative inside a
// figurative frame — "dating is like a job interview where the salary is
// emotional damage". Expectation violation by valence clash; the "like"/"as"
// frame keeps sincere complaints ("my salary is a disaster") out.
fn j_payoff_clash(hay:[]u8)i32{
    let b:i32=j_posexp_pos(hay);
    if(b<0){return 0;}
    // The figurative frame must be an explicit simile: "is/was like" or
    // "like a/the". A bare "as" ("as far as", "as required") is ordinary
    // prose, not a frame — D49's "as far as" must not install.
    let fig:i32=0;
    if(j_phrase_pos(hay,"is like",0)>=0){fig=1;}
    if(j_phrase_pos(hay,"was like",0)>=0){fig=1;}
    if(j_phrase_pos(hay,"like a",0)>=0){fig=1;}
    if(j_phrase_pos(hay,"like the",0)>=0){fig=1;}
    if(fig==0){return 0;}
    let cop:i32=j_phrase_pos(hay,"is",b);
    if(cop<0){cop=j_phrase_pos(hay,"was",b);}
    if(cop<0){return 0;}
    if(j_neg_noun(hay,cop,hay.len)!=0){return 1;}
    return 0;
}

// j_punch_tag: classic deadpan punch tags (the sentence's turn lives here).
fn j_punch_tag(hay:[]u8,from:i32)i32{
    if(j_phrase_pos(hay,"we'll see about that",from)>=0){return 1;}
    if(j_phrase_pos(hay,"something like that",from)>=0){return 1;}
    if(j_phrase_pos(hay,"not so sure",from)>=0){return 1;}
    if(j_phrase_pos(hay,"up to something",from)>=0){return 1;}
    if(j_phrase_pos(hay,"press your luck",from)>=0){return 1;}
    if(j_phrase_pos(hay,"spill your drink",from)>=0){return 1;}
    if(j_phrase_pos(hay,"too crowded",from)>=0){return 1;}
    if(j_phrase_pos(hay,"never meet",from)>=0){return 1;}
    if(j_phrase_pos(hay,"already tomorrow in",from)>=0){return 1;}
    if(j_phrase_pos(hay,"no idea where she is",from)>=0){return 1;}
    if(j_phrase_pos(hay,"right behind you",from)>=0){return 1;}
    if(j_phrase_pos(hay,"not get it",from)>=0){return 1;}
    return 0;
}

// j_tag_turn: two-part deadpan where the second part carries a punch tag;
// the pivot may be a sentence boundary or a contrast word ("but").
// j_tag_setup_worry: "already tomorrow in" is the punch only when the setup
// primes time-anxiety (world ending, worry) — the tag resolves the dread.
fn j_tag_setup_worry(hay:[]u8,pv:i32)i32{
    if(j_has_word_lim(hay,"worry",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"worried",0,pv)!=0){return 1;}
    if(j_phrase_pos(hay,"world ending",0)>=0){return 1;}
    if(j_has_word_lim(hay,"anxious",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"anxiety",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"panic",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"calm",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"relax",0,pv)!=0){return 1;}
    return 0;
}
// j_tag_setup_doubt: "not so sure" needs an indecisive setup.
fn j_tag_setup_doubt(hay:[]u8,pv:i32)i32{
    if(j_has_word_lim(hay,"indecisive",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"unsure",0,pv)!=0){return 1;}
    if(j_phrase_pos(hay,"can't decide",0)>=0){return 1;}
    if(j_phrase_pos(hay,"cannot decide",0)>=0){return 1;}
    if(j_phrase_pos(hay,"make up my mind",0)>=0){return 1;}
    return 0;
}
// j_tag_setup_msg: "not get it" needs a message/communication setup (the UDP
// joke: the joke about the protocol is itself undelivered).
fn j_tag_setup_msg(hay:[]u8,pv:i32)i32{
    if(j_has_word_lim(hay,"joke",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"udp",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"message",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"packet",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"email",0,pv)!=0){return 1;}
    return 0;
}
// j_tag_setup_lost: "no idea where she is" needs a disappearance setup
// (grandmother walking for miles / age).
fn j_tag_setup_lost(hay:[]u8,pv:i32)i32{
    if(j_has_word_lim(hay,"grandmother",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"grandma",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"walking",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"miles",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"missing",0,pv)!=0){return 1;}
    if(j_has_word_lim(hay,"disappeared",0,pv)!=0){return 1;}
    return 0;
}
fn j_tag_turn(hay:[]u8)i32{
    let p1:i32=j_any_pivot(hay,0);
    if(p1<0){return 0;}
    if(j_words_between(hay,p1,hay.len)<2){return 0;}
    // Ungated tags: the tag itself is the turn in any pivot context.
    if(j_phrase_pos(hay,"we'll see about that",p1)>=0){return 1;}
    if(j_phrase_pos(hay,"something like that",p1)>=0){return 1;}
    if(j_phrase_pos(hay,"up to something",p1)>=0){return 1;}
    if(j_phrase_pos(hay,"press your luck",p1)>=0){return 1;}
    if(j_phrase_pos(hay,"spill your drink",p1)>=0){return 1;}
    if(j_phrase_pos(hay,"too crowded",p1)>=0){return 1;}
    if(j_phrase_pos(hay,"never meet",p1)>=0){return 1;}
    if(j_phrase_pos(hay,"right behind you",p1)>=0){return 1;}
    if(j_phrase_pos(hay,"right behind me",p1)>=0){return 1;}
    // Gated tags: the tag is the punch only when the setup primes its
    // punch reading. A bare tag ("it is monday; already tomorrow in sydney")
    // is ordinary prose wearing a tag's shape.
    if(j_phrase_pos(hay,"already tomorrow in",p1)>=0){
        if(j_tag_setup_worry(hay,p1)!=0){return 1;}
    }
    if(j_phrase_pos(hay,"not so sure",p1)>=0){
        if(j_tag_setup_doubt(hay,p1)!=0){return 1;}
    }
    if(j_phrase_pos(hay,"not get it",p1)>=0){
        if(j_tag_setup_msg(hay,p1)!=0){return 1;}
    }
    if(j_phrase_pos(hay,"no idea where she is",p1)>=0){
        if(j_tag_setup_lost(hay,p1)!=0){return 1;}
    }
    return 0;
}

// j_whisper_turn: "whisper(ed)" + a punch tag in the whispered content.
fn j_whisper_turn(hay:[]u8)i32{
    let w:i32=j_phrase_pos(hay,"whispered",0);
    if(w<0){w=j_phrase_pos(hay,"whisper",0);}
    if(w<0){return 0;}
    // Only the tags that are genuinely the whisper's punch: "too crowded"
    // after the "nobody goes there" setup. A whispered tag with no comic
    // setup ("whispered the quarterly figures") is ordinary secrecy.
    if(j_phrase_pos(hay,"too crowded",w+7)>=0){return 1;}
    return 0;
}

// j_pair_turn: pun pair = setup word before the pivot (or far before the
// punch with no pivot), punch word after.
fn j_pair_turn(hay:[]u8,sw:[]u8,pw:[]u8)i32{
    let ps:i32=j_phrase_pos(hay,sw,0);
    if(ps<0){return 0;}
    let pp:i32=j_phrase_pos(hay,pw,0);
    if(pp<0){return 0;}
    if(ps>=pp){return 0;}
    let pv:i32=j_any_pivot(hay,0);
    if(pv>=0){
        if(ps<pv){if(pp>pv){return 1;}}
        return 0;
    }
    if(j_words_between(hay,ps,pp)>=6){return 1;}
    return 0;
}

// j_pun_turn: pun/wordplay jokes as setup+punch word pairs across the turn.
fn j_pun_turn(hay:[]u8)i32{
    // Round-4: "running/catch" retired — ordinary "running to catch the bus"
    // is not wordplay; no prior genuine install used it.
    if(j_pair_turn(hay,"baker","dough")!=0){return 1;}
    if(j_pair_turn(hay,"suitcase","baggage")!=0){return 1;}
    if(j_pair_turn(hay,"iron","wrinkles")!=0){
        // The iron/wrinkles pun is first-person ("I never iron my shirts");
        // an imperative ("Iron the shirt you will wear") is sincere advice.
        if(j_word_at(hay,0,"iron")==0){return 1;}
    }
    if(j_pair_turn(hay,"stop","stopped")!=0){
        // "stop/stopped" is the pun only outside weather reports: "if it
        // stopped raining, I would stop watering" is sincere meteorology.
        if(j_weather_word(hay)==0){return 1;}
    }
    if(j_pair_turn(hay,"clover","luck")!=0){return 1;}
    if(j_pair_turn(hay,"eyebrows","surprised")!=0){return 1;}
    if(j_pair_turn(hay,"early bird","cheese")!=0){return 1;}
    if(j_pair_turn(hay,"conscience","bad memory")!=0){return 1;}
    if(j_pair_turn(hay,"two types of people","incomplete")!=0){return 1;}
    if(j_pair_turn(hay,"two places","those places")!=0){return 1;}
    if(j_phrase_pos(hay,"kinds of people",0)>=0){if(j_has_word(hay,"binary")!=0){return 1;}}
    return 0;
}
// j_weather_word: meteorological nouns that make stop/stopped sincere.
fn j_weather_word(hay:[]u8)i32{
    if(j_has_word(hay,"rain")!=0){return 1;}
    if(j_has_word(hay,"raining")!=0){return 1;}
    if(j_has_word(hay,"snow")!=0){return 1;}
    if(j_has_word(hay,"snowing")!=0){return 1;}
    if(j_has_word(hay,"hail")!=0){return 1;}
    if(j_has_word(hay,"hailing")!=0){return 1;}
    if(j_has_word(hay,"storm")!=0){return 1;}
    if(j_has_word(hay,"storming")!=0){return 1;}
    if(j_has_word(hay,"drizzle")!=0){return 1;}
    return 0;
}

// j_trust_pun_turn: distrust-setup + dual-meaning payoff ("atoms"/"make up",
// "stairs"/"up to something").
fn j_trust_pun_turn(hay:[]u8)i32{
    if(j_pair_turn(hay,"atoms","make up")!=0){return 1;}
    if(j_pair_turn(hay,"stairs","up to something")!=0){return 1;}
    return 0;
}

// j_irony_marker: a wry/explicit marker that the longevity+habit pairing is
// the joke's incongruity (not a sincere habit report).
fn j_irony_marker(hay:[]u8)i32{
    if(j_phrase_pos(hay,"doctors hate",0)>=0){return 1;}
    if(j_phrase_pos(hay,"doctor hates",0)>=0){return 1;}
    if(j_phrase_pos(hay,"go figure",0)>=0){return 1;}
    if(j_phrase_pos(hay,"who knew",0)>=0){return 1;}
    if(j_phrase_pos(hay,"imagine that",0)>=0){return 1;}
    if(j_phrase_pos(hay,"of course",0)>=0){return 1;}
    if(j_phrase_pos(hay,"somehow",0)>=0){return 1;}
    if(j_phrase_pos(hay,"still going",0)>=0){return 1;}
    if(j_phrase_pos(hay,"never felt better",0)>=0){return 1;}
    if(j_phrase_pos(hay,"two packs",0)>=0){return 1;}
    if(j_phrase_pos(hay,"three packs",0)>=0){return 1;}
    if(j_phrase_pos(hay,"chain-smoked",0)>=0){return 1;}
    if(j_phrase_pos(hay,"chain-smoking",0)>=0){return 1;}
    return 0;
}

// j_weekday_news: a weekday treated as a news agent (satire register clash).
fn j_weekday_news(hay:[]u8)i32{
    let wd:i32=0;
    if(j_has_sub(hay,"monday")!=0){wd=1;}
    if(j_has_sub(hay,"tuesday")!=0){wd=1;}
    if(j_has_sub(hay,"wednesday")!=0){wd=1;}
    if(j_has_sub(hay,"thursday")!=0){wd=1;}
    if(j_has_sub(hay,"friday")!=0){wd=1;}
    if(j_has_sub(hay,"saturday")!=0){wd=1;}
    if(j_has_sub(hay,"sunday")!=0){wd=1;}
    if(wd==0){return 0;}
    if(j_has_word(hay,"discovers")!=0){return 1;}
    if(j_has_word(hay,"declares")!=0){return 1;}
    if(j_has_word(hay,"demands")!=0){return 1;}
    if(j_has_word(hay,"vows")!=0){return 1;}
    if(j_has_word(hay,"war")!=0){return 1;}
    return 0;
}

// j_satire_absurd: onion-style register clash = news words + an absurd claim.
fn j_satire_absurd(hay:[]u8)i32{
    if(j_has_word(hay,"flat earth")!=0){return 1;}
    if(j_phrase_pos(hay,"earth is flat",0)>=0){return 1;}
    if(j_phrase_pos(hay,"napping counts as cardio",0)>=0){return 1;}
    if(j_weekday_news(hay)!=0){return 1;}
    return 0;
}

// j_natural_mat: sincere material/composition reading of a da5d combination
// (the "dried glue" is honest craft, not an absurd combo).
fn j_natural_mat(hay:[]u8)i32{
    if(j_has_word(hay,"water")!=0){return 1;}
    if(j_has_word(hay,"rock")!=0){return 1;}
    if(j_has_word(hay,"stone")!=0){return 1;}
    if(j_has_word(hay,"metal")!=0){return 1;}
    if(j_has_word(hay,"iron")!=0){return 1;}
    if(j_has_word(hay,"copper")!=0){return 1;}
    if(j_has_word(hay,"gas")!=0){return 1;}
    if(j_has_word(hay,"dust")!=0){return 1;}
    if(j_has_word(hay,"ice")!=0){return 1;}
    if(j_has_word(hay,"soil")!=0){return 1;}
    if(j_has_word(hay,"sand")!=0){return 1;}
    if(j_has_word(hay,"lava")!=0){return 1;}
    if(j_has_word(hay,"magma")!=0){return 1;}
    if(j_has_word(hay,"basalt")!=0){return 1;}
    if(j_has_word(hay,"regolith")!=0){return 1;}
    if(j_has_word(hay,"minerals")!=0){return 1;}
    if(j_has_word(hay,"hydrogen")!=0){return 1;}
    if(j_has_word(hay,"helium")!=0){return 1;}
    return 0;
}

// j_trope_turn: figurative turn = simile with a comic/absurd completion, or
// hyperbole that marks the line as a joke.
fn j_trope_turn(hay:[]u8)i32{
    let sim:i32=0;
    if(j_phrase_pos(hay,"like a",0)>=0){sim=1;}
    if(j_phrase_pos(hay,"like the",0)>=0){sim=1;}
    if(j_phrase_pos(hay,"as a",0)>=0){sim=1;}
    if(j_phrase_pos(hay,"as the",0)>=0){sim=1;}
    if(sim!=0){
        if(j_absurd_ent(hay,0)!=0){return 1;}
        if(j_punch_tag(hay,0)!=0){return 1;}
    }
    if(j_has_word(hay,"literally")!=0){
        // "literally" is the trope's turn only when it intensifies something
        // absurd ("literally a cardboard box"). Sincere "literally" ("I
        // literally just finished") is ordinary emphasis.
        if(j_absurd_ent(hay,0)!=0){return 1;}
    }
    // "a million" and "to death" are hyperbole the trope owns only when they
    // attach to something absurd; bare "sick to death of the old bugs" is
    // sincere complaint. No prior genuine install used either bare.
    if(j_phrase_pos(hay,"a million",0)>=0){
        if(j_absurd_ent(hay,0)!=0){return 1;}
    }
    if(j_phrase_pos(hay,"to death",0)>=0){
        if(j_absurd_ent(hay,0)!=0){return 1;}
    }
    return 0;
}

fn g_classify(text:[]u8,url:[]u8,codes:[]u8,markers:[]u8)i32 {
    let t:[]u8=j_tolower(text);
    let n_A_APPLY:i32=0;
    if(j_has_stem(t,"apply")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"apply");}
    if(j_has_stem(t,"squeeze")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"squeeze");}
    if(j_has_stem(t,"rub")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"rub");}
    if(j_has_stem(t,"spread")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"spread");}
    if(j_has_stem(t,"smear")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"smear");}
    if(j_has_stem(t,"paint")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"paint");}
    if(j_has_stem(t,"put")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"put");}
    if(j_has_stem(t,"pour")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"pour");}
    if(j_has_stem(t,"dab")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"dab");}
    if(j_has_stem(t,"refresh")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"refresh");}
    if(j_has_stem(t,"retread")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"retread");}
    if(j_has_word(t,"rub on")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"rub on");}
    if(j_has_word(t,"spread on")!=0){n_A_APPLY=n_A_APPLY+1;g_markers_append(markers,"spread on");}
    let n_A_BAREWALK:i32=0;
    if(j_has_word(t,"walk over the area with bare feet")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"walk over the area with bare feet");}
    if(j_has_word(t,"walk over broken glass with bare feet")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"walk over broken glass with bare feet");}
    if(j_has_word(t,"walk on broken glass")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"walk on broken glass");}
    if(j_has_word(t,"clean up glass with your bare feet")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"clean up glass with your bare feet");}
    if(j_has_word(t,"walk across broken glass barefoot")!=0){n_A_BAREWALK=n_A_BAREWALK+1;g_markers_append(markers,"walk across broken glass barefoot");}
    let n_A_BITE_SEEK:i32=0;
    if(j_has_stem(t,"bite")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"bite");}
    if(j_has_stem(t,"sting")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"sting");}
    if(j_has_word(t,"bitten by")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"bitten by");}
    if(j_has_word(t,"get bitten")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"get bitten");}
    if(j_has_word(t,"let it bite")!=0){n_A_BITE_SEEK=n_A_BITE_SEEK+1;g_markers_append(markers,"let it bite");}
    let n_A_DELETE:i32=0;
    if(j_has_stem(t,"delete")!=0){n_A_DELETE=n_A_DELETE+1;g_markers_append(markers,"delete");}
    if(j_has_stem(t,"erase")!=0){n_A_DELETE=n_A_DELETE+1;g_markers_append(markers,"erase");}
    if(j_has_stem(t,"uninstall")!=0){n_A_DELETE=n_A_DELETE+1;g_markers_append(markers,"uninstall");}
    let n_A_DISGUISE:i32=0;
    if(j_has_stem(t,"disguise")!=0){n_A_DISGUISE=n_A_DISGUISE+1;g_markers_append(markers,"disguise");}
    if(j_has_word(t,"dress up as")!=0){n_A_DISGUISE=n_A_DISGUISE+1;g_markers_append(markers,"dress up as");}
    if(j_has_word(t,"dressed as")!=0){n_A_DISGUISE=n_A_DISGUISE+1;g_markers_append(markers,"dressed as");}
    let n_A_DROP:i32=0;
    if(j_has_stem(t,"drop")!=0){n_A_DROP=n_A_DROP+1;g_markers_append(markers,"drop");}
    let n_A_HUG:i32=0;

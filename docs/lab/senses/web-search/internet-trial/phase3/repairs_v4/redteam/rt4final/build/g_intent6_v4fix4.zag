    if(contra==0){if(just!=0&&n_A_USE>=1&&n_F_PHOTO>=1&&n_F_DARK>=1&&j_absurd_ent(t,0)!=0){contra=28;g_codes_append(codes,"P_DB1P");}}
    if(contra==0){if(just!=0&&n_A_IMAGINE>=1&&n_F_VR>=1){contra=29;g_codes_append(codes,"P_DB1V");}}
    if(contra==0){if(just!=0&&n_A_WEAPON_SUB>=1&&n_F_ROBBERY>=1){contra=30;g_codes_append(codes,"P_DB1F");}}
    if(contra==0){if(just!=0&&n_F_SEA>=1&&n_F_VACATION>=1&&j_phrase_pos(t,"get lost at sea",0)>=0){contra=31;g_codes_append(codes,"P_DB1S");}}
    if(contra==0){if(just!=0&&n_A_DISGUISE>=1&&n_F_SHEEP>=1&&j_absurd_ent(t,0)!=0){contra=32;g_codes_append(codes,"P_DB1D");}}
    if(contra==0){if(just!=0&&n_A_SUBST>=1&&n_F_TIRE>=1&&n_F_FOOD>=1&&j_subst_food(t)!=0){contra=33;g_codes_append(codes,"P_DA5A");}}
    if(contra==0){if(just!=0&&n_A_IRON>=1&&n_F_WORN>=1&&j_concurrent_wear(t)!=0){contra=34;g_codes_append(codes,"P_DA5B");}}
    if(contra==0){if(just!=0&&n_A_BLIND>=1&&n_F_DRIVING>=1){contra=35;g_codes_append(codes,"P_DA5C");}}
    if(contra==0){if(j_da5d_shape(t)!=0){if(j_natural_mat(t)==0){if(j_myth_attr(t)==0){contra=36;g_codes_append(codes,"P_DA5D");}}}
    }}
    if(contra==0){if(n_F_HABIT>=1&&n_F_LONGEV>=1&&j_cessation(t)==0&&j_you(t)==0){if(j_irony_marker(t)!=0){contra=37;g_codes_append(codes,"R_IRONY");}}}
    if(contra==0){if(just!=0&&n_F_DUAL>=1&&n_F_ABSTRACT>=1&&n_F_ENACT>=1&&j_two_clause(t)!=0){contra=38;g_codes_append(codes,"R_PUN1");}}
    if(contra==0){if(n_F_DISTRUST>=1&&j_trust_pun_turn(t)!=0){contra=39;g_codes_append(codes,"R_PUN2");}}
    if(contra==0){if(j_qa_turn(t)!=0){contra=40;g_codes_append(codes,"N_QA");g_markers_append(markers,"qa");}}
    if(contra==0){if(j_deny_turn(t)!=0){contra=41;g_codes_append(codes,"N_DENY");g_markers_append(markers,"deny");}}
    if(contra==0){if(j_bar_turn(t)!=0){contra=42;g_codes_append(codes,"N_BAR");g_markers_append(markers,"bar");}}
    if(contra==0){if(j_neg_turn(t)!=0){contra=43;g_codes_append(codes,"N_NEG");g_markers_append(markers,"neg");}}
    if(contra==0){if(j_tag_turn(t)!=0){contra=44;g_codes_append(codes,"N_TAG");g_markers_append(markers,"tag");}}
    if(contra==0){if(j_whisper_turn(t)!=0){contra=45;g_codes_append(codes,"N_WHISPER");g_markers_append(markers,"whisper");}}
    // Round-4: the specific pun detectors (previously dead code) are the real
    // rules — each requires the figurative idiom AND a literal-primer from a
    // semantic class. The narrow j_pair_turn proxies are retired.
    if(contra==0){if(j_pun_grow(t)!=0){contra=47;g_codes_append(codes,"N_PUN_GROW");g_markers_append(markers,"pun_grow");}}
    if(contra==0){if(j_pun_over(t)!=0){contra=48;g_codes_append(codes,"N_PUN_OVER");g_markers_append(markers,"pun_over");}}
    if(contra==0){if(j_pun_jump(t)!=0){contra=49;g_codes_append(codes,"N_PUN_JUMP");g_markers_append(markers,"pun_jump");}}
    if(contra==0){if(j_pun_line(t)!=0){contra=50;g_codes_append(codes,"N_PUN_LINE");g_markers_append(markers,"pun_line");}}
    if(contra==0){if(j_pun_comeout(t)!=0){contra=51;g_codes_append(codes,"N_PUN_OUT");g_markers_append(markers,"pun_out");}}
    if(contra==0){if(j_pun_turn(t)!=0){contra=46;g_codes_append(codes,"N_PUN");g_markers_append(markers,"pun");}}
    if(contra==0){if(j_incomplete_list(t)!=0){contra=52;g_codes_append(codes,"N_LIST");g_markers_append(markers,"list");}}
    if(contra==0){if(j_absurd_compliance(t)!=0){contra=53;g_codes_append(codes,"N_COMPLY");g_markers_append(markers,"comply");}}
    if(contra==0){if(j_deflation(t)!=0){contra=54;g_codes_append(codes,"N_DEFLATE");g_markers_append(markers,"deflate");}}
    if(contra==0){if(j_payoff_clash(t)!=0){contra=55;g_codes_append(codes,"N_PAYOFF");g_markers_append(markers,"payoff");}}
    // N_VALENCE: standalone valence clash — a positive verb on a negative
    // noun with no negation pivot at all ("I adore my migraines"). The
    // clash IS the incongruity; the "to <verb>" purpose-clause guard keeps
    // sincere "love the extra time to fix mistakes" out.
    if(contra==0){if(j_valence_clash(t,0,t.len)!=0){contra=56;g_codes_append(codes,"N_VALENCE");g_markers_append(markers,"valence");}}
    let ns:i32=0;
    if(j_has_word(t,"area")!=0){ns=ns+1;g_markers_append(markers,"area");}
    if(j_has_word(t,"sources")!=0){ns=ns+1;g_markers_append(markers,"sources");}
    if(j_has_word(t,"confirm")!=0){ns=ns+1;g_markers_append(markers,"confirm");}
    if(j_has_word(t,"says")!=0){ns=ns+1;g_markers_append(markers,"says");}
    if(j_has_word(t,"experts")!=0){ns=ns+1;g_markers_append(markers,"experts");}
    if(j_has_word(t,"inside")!=0){ns=ns+1;g_markers_append(markers,"inside");}
    if(j_has_word(t,"resident")!=0){ns=ns+1;g_markers_append(markers,"resident");}
    if(j_has_word(t,"details")!=0){ns=ns+1;g_markers_append(markers,"details");}
    if(j_has_word(t,"developing")!=0){ns=ns+1;g_markers_append(markers,"developing");}
    if(j_has_word(t,"press")!=0){ns=ns+1;g_markers_append(markers,"press");}
    if(j_has_word(t,"weigh")!=0){ns=ns+1;g_markers_append(markers,"weigh");}
    if(j_has_word(t,"study")!=0){ns=ns+1;g_markers_append(markers,"study");}
    if(j_has_word(t,"finds")!=0){ns=ns+1;g_markers_append(markers,"finds");}
    if(j_has_word(t,"local")!=0){ns=ns+1;g_markers_append(markers,"local");}
    if(j_has_word(t,"time")!=0){ns=ns+1;g_markers_append(markers,"time");}
    if(j_has_word(t,"report")!=0){ns=ns+1;g_markers_append(markers,"report");}
    if(j_has_word(t,"full")!=0){ns=ns+1;g_markers_append(markers,"full");}
    if(j_has_word(t,"man")!=0){ns=ns+1;g_markers_append(markers,"man");}
    if(j_has_word(t,"woman")!=0){ns=ns+1;g_markers_append(markers,"woman");}
    if(j_has_word(t,"peer")!=0){ns=ns+1;g_markers_append(markers,"peer");}
    if(j_has_word(t,"pending")!=0){ns=ns+1;g_markers_append(markers,"pending");}
    if(j_has_word(t,"review")!=0){ns=ns+1;g_markers_append(markers,"review");}
    if(j_has_word(t,"story")!=0){ns=ns+1;g_markers_append(markers,"story");}
    if(j_has_word(t,"nobody")!=0){ns=ns+1;g_markers_append(markers,"nobody");}
    let nt:i32=0;
    if(j_has_word(t,"free")!=0){nt=nt+1;g_markers_append(markers,"free");}
    if(j_has_word(t,"ram")!=0){nt=nt+1;g_markers_append(markers,"ram");}
    if(j_has_word(t,"upgrade")!=0){nt=nt+1;g_markers_append(markers,"upgrade");}
    if(j_has_word(t,"ama")!=0){nt=nt+1;g_markers_append(markers,"ama");}
    if(j_has_word(t,"findings")!=0){nt=nt+1;g_markers_append(markers,"findings");}
    if(j_has_word(t,"joke")!=0){nt=nt+1;g_markers_append(markers,"joke");}
    if(j_has_word(t,"pet")!=0){nt=nt+1;g_markers_append(markers,"pet");}
    if(j_has_word(t,"downloaded")!=0){nt=nt+1;g_markers_append(markers,"downloaded");}
    if(j_has_word(t,"traveler")!=0){nt=nt+1;g_markers_append(markers,"traveler");}
    let ev:i32=5;
    if(ns>=2){if(j_insult(t)==0){if(j_satire_absurd(t)!=0){ev=3;g_codes_append(codes,"R_SATIRE");}}}
    if(ev==5){
        if(nt>=1){if(j_trope_turn(t)!=0){ev=2;g_codes_append(codes,"R_TROPE");}else{if(contra!=0){if(j_purpose_to(t)!=0){ev=2;g_codes_append(codes,"R_TROPE");}}}}
    }
    if(ev==5){
        if(contra==0){g_codes_append(codes,"R_NO_PATTERN");}
    }
    let logic:i32=0;
    if(contra!=0){logic=2;}
    if(logic==0){
        if(ev!=5){logic=1;}
    }
    let intent:i32=r5_dispose(logic,ev);
    return intent;
}

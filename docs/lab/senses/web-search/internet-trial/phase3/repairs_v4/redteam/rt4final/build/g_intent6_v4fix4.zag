    if(j_has_word_lim(hay,"trash",from,lim)!=0){return 1;}
    return 0;
}
fn j_pos_verb(hay:[]u8,from:i32,lim:i32)i32{
    if(j_has_word_lim(hay,"love",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"adore",from,lim)!=0){return 1;}
    if(j_has_word_lim(hay,"admire",from,lim)!=0){return 1;}

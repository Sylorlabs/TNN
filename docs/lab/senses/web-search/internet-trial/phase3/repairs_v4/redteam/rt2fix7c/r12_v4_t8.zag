// r12_v4.zag -- R1/R2 repaired stance classifier, hell-hole V4 INTEGRATED.
//
// Merges four independently verified fix crews (all pure Zag, zero RNG):
//   B1 negation    (crews/b1/r12_neg.zag): neg_scope rewrite, deny-lexicon
//        true stems, none-subject deny, reporting-verb fallback, no-evidence
//        generalization, lhedge/whether endorsement guards.
//   B2 contrastive (crews/b2/r12_con.zag): numeric_guard (constrained:
//        unit-aware temp, same-quantity/entity gates, name filter, 5% approx
//        tolerance, concession rule); abstain is pass-through.
//   B3 causal      (crews/b3/r12_cau.zag): causal-verb predicates, mech_aff,
//        cause_deny, prevent_aff, ant_pol, polarity-aware DENY (cneg),
//        opp_outcome_deny, short-stem list, trailing-e bridge.
//   B4 cqht        (crews/b4/r12_cqht.zag): conditionals, quantifiers, hedging,
//        temporal, comparatives; return encoding tag*16+reason.
//
// Interface: argv[1] = TSV file with lines  idx \t claim \t title \t snippet
// Output per line:  idx SP tag SP reason \n
//   tag: 0=IRRELEVANT/NEUTRAL, 1=AFFIRM, 2=DENY
//   reason: gate | deny-lex | antonym | neg-scope | competing-subject
//           | endorse | neutral | temporal | comparative | quantifier
//           | numeric-mismatch
//
// Deterministic, zero RNG, pure Zag. Compiled with the pinned toolchain:
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1 --no-zagd
//
// znc gotchas honored (see ~/AGENTS.md): no `as []i32` indexed tables
// (u8 arenas + LE helpers instead), no slice ==, no argc gate, all slices
// far below the 2^25 limit, no deep else-nesting, no large-struct tricks.

fn z_alloc(n:i32)[]u8{
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8)void{
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}
fn z_cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4194304){return "";}
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    return b;
}
fn read_all(path:[]u8)[]u8{
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let cap:i32=8388608;
    let buf:[]u8=z_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}
fn z_eq(a:[]u8,b:[]u8)i32{
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn z_has(h:[]u8,n:[]u8)i32{
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len){if(h[i+k]!=n[k]){break;}k=k+1;}
        if(k==n.len){return 1;}
        i=i+1;
    }
    return 0;
}
fn z_starts(h:[]u8,n:[]u8)i32{
    if(n.len>h.len){return 0;}
    let k:i32=0;
    while(k<n.len){if(h[k]!=n[k]){return 0;}k=k+1;}
    return 1;
}
fn z_cplen(s:[]u8)i32{
    return z_cplen_range(s,0,s.len);
}
fn z_cplen_range(s:[]u8,a:i32,b:i32)i32{
    let n:i32=0;
    let i:i32=a;
    while(i<b){
        let by:i32=s[i] as i32;
        if(by<128 || by>=192){n=n+1;}
        i=i+1;
    }
    return n;
}
fn z_isupper1(s:[]u8)i32{
    if(s.len==0){return 0;}
    let b0:i32=s[0] as i32;
    if(b0>=65 && b0<=90){return 1;}
    if(b0==195 && s.len>=2){
        let b1:i32=s[1] as i32;
        if(b1>=128 && b1<=158 && b1!=151){return 1;}
    }
    return 0;
}
fn z_isdig(b:i32)i32{
    if(b>=48 && b<=57){return 1;}
    return 0;
}
fn z_isvowel(b:i32)i32{
    if(b==97 || b==101 || b==105 || b==111 || b==117){return 1;}
    return 0;
}
fn z_isspace(b:i32)i32{
    if(b==32 || b==9 || b==10 || b==13 || b==11 || b==12){return 1;}
    return 0;
}
fn a_put(b:[]u8,i:i32,v:i32)void{
    let o:i32=i<<2;
    b[o]=(v & 255) as u8;
    b[o+1]=((v>>8) & 255) as u8;
    b[o+2]=((v>>16) & 255) as u8;
    b[o+3]=((v>>24) & 255) as u8;
    return;
}
fn a_get(b:[]u8,i:i32)i32{
    let o:i32=i<<2;
    let v:i32=(b[o] as i32) & 255;
    v=v | (((b[o+1] as i32) & 255)<<8);
    v=v | (((b[o+2] as i32) & 255)<<16);
    v=v | (((b[o+3] as i32) & 255)<<24);
    return v;
}
fn lower_copy(t:[]u8,out:[]u8)i32{
    let n:i32=t.len;
    let i:i32=0;
    let k:i32=0;
    let m:i32=out.len;
    while(i<n && k<m){
        let b:i32=t[i] as i32;
        if(b>=65 && b<=90){
            if(k<m){out[k]=(b+32) as u8;k=k+1;}
            i=i+1;
        }
        else{
            if(b==195 && i+1<n){
                let b2:i32=t[i+1] as i32;
                if(b2>=128 && b2<=158 && b2!=151){
                    if(k+1<m){out[k]=195 as u8;out[k+1]=(b2+32) as u8;k=k+2;}
                    i=i+2;
                }else{
                    if(k<m){out[k]=b as u8;k=k+1;}
                    i=i+1;
                }
            }else{
                if(k<m){out[k]=b as u8;k=k+1;}
                i=i+1;
            }
        }
    }
    return k;
}
fn ew(s:[]u8,a:i32,b:i32,lit:[]u8)i32{
    if(lit.len>b-a){return 0;}
    let k:i32=0;
    while(k<lit.len){
        if((s[b-lit.len+k] as i32)!=(lit[k] as i32)){return 0;}
        k=k+1;
    }
    return 1;
}
fn in_stems(s:[]u8,base:[]u8,ar:[]u8,n:i32)i32{
    let i:i32=0;
    while(i<n){
        let so:i32=a_get(ar,2*i);
        let sl:i32=a_get(ar,2*i+1);
        if(z_eq(s,base[so..so+sl])==1){return 1;}
        i=i+1;
    }
    return 0;
}
// Prefix-lenient stem overlap: exact match, or the shorter (>=6 chars) is
// a prefix of the longer. Bridges derivational gaps ("dehydrat" vs
// "dehydration") for support-negation scope matching.
fn stem_overlap(s:[]u8,base:[]u8,ar:[]u8,n:i32)i32{
    if(in_stems(s,base,ar,n)==1){return 1;}
    let i:i32=0;
    while(i<n){
        let so:i32=a_get(ar,2*i);
        let sl:i32=a_get(ar,2*i+1);
        let bs:[]u8=base[so..so+sl];
        if(s.len>=6 && bs.len>=6){
            // s prefix of bs?
            if(s.len<=bs.len){
                let ok:i32=1;
                let k:i32=0;
                while(k<s.len){if(s[k]!=bs[k]){ok=0;break;}k=k+1;}
                if(ok==1){return 1;}
            }
            // bs prefix of s?
            if(bs.len<s.len){
                let ok2:i32=1;
                let k2:i32=0;
                while(k2<bs.len){if(bs[k2]!=s[k2]){ok2=0;break;}k2=k2+1;}
                if(ok2==1){return 1;}
            }
        }
        i=i+1;
    }
    return 0;
}

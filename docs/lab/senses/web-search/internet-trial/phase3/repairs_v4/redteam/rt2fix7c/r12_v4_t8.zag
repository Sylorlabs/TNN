    if(z_eq(a,"large")==1 && z_eq(b,"small")==1){return 1;}
    if(z_eq(a,"small")==1 && z_eq(b,"large")==1){return 1;}
    if(z_eq(a,"tall")==1 && z_eq(b,"short")==1){return 1;}
    if(z_eq(a,"short")==1 && z_eq(b,"tall")==1){return 1;}
    if(z_eq(a,"high")==1 && z_eq(b,"low")==1){return 1;}
    if(z_eq(a,"low")==1 && z_eq(b,"high")==1){return 1;}
    if(z_eq(a,"long")==1 && z_eq(b,"short")==1){return 1;}
    // speed
    if(z_eq(a,"fast")==1 && z_eq(b,"slow")==1){return 1;}
    if(z_eq(a,"slow")==1 && z_eq(b,"fast")==1){return 1;}
    if(z_eq(a,"quick")==1 && z_eq(b,"slow")==1){return 1;}
    if(z_eq(a,"slow")==1 && z_eq(b,"quick")==1){return 1;}
    // truth / state
    if(z_eq(a,"true")==1 && z_eq(b,"false")==1){return 1;}

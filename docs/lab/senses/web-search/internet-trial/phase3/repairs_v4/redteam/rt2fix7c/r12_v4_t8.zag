    if(z_eq(a,"visible")==1 && z_eq(b,"invisible")==1){return 1;}
    if(z_eq(a,"invisible")==1 && z_eq(b,"visible")==1){return 1;}
    if(z_eq(a,"possible")==1 && z_eq(b,"impossible")==1){return 1;}
    if(z_eq(a,"impossible")==1 && z_eq(b,"possible")==1){return 1;}
    if(z_eq(a,"legal")==1 && z_eq(b,"illegal")==1){return 1;}
    if(z_eq(a,"illegal")==1 && z_eq(b,"legal")==1){return 1;}
    if(z_eq(a,"safe")==1 && z_eq(b,"dangerous")==1){return 1;}
    if(z_eq(a,"dangerous")==1 && z_eq(b,"safe")==1){return 1;}
    if(z_eq(a,"clean")==1 && z_eq(b,"dirty")==1){return 1;}

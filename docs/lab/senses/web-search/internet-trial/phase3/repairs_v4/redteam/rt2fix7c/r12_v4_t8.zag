    if(z_eq(a,"warm")==1 && z_eq(b,"cool")==1){return 1;}
    if(z_eq(a,"cool")==1 && z_eq(b,"warm")==1){return 1;}
    // size
    if(z_eq(a,"big")==1 && z_eq(b,"small")==1){return 1;}

    if(z_eq(w,"crustacean")==1){return 1;}
    if(z_eq(w,"mollusk")==1){return 1;}
    return 0;
}
fn class_excl(a:[]u8,b:[]u8)i32{
    if(a.len==0 || b.len==0){return 0;}
    if(is_classnoun(a)==1 && is_classnoun(b)==1 && z_eq(a,b)==0){return 1;}
    return 0;
}

    return "\nbest\nbetter\nbigger\nearlier\nfaster\nfewer\ngreater\nhigher\nlarger\nlater\nleast\nless\nlonger\nlower\nmore\nmost\nshorter\nslower\nsmaller\nsooner\nworse\nworst\n";

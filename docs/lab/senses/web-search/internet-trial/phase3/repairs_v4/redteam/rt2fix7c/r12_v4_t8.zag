    if(z_eq(w,"has")==1){return 1;}
    if(z_eq(w,"had")==1){return 1;}
    if(z_eq(w,"be")==1){return 1;}
    if(z_eq(w,"am")==1){return 1;}
    if(z_eq(w,"is")==1){return 1;}
    if(z_eq(w,"are")==1){return 1;}
    if(z_eq(w,"was")==1){return 1;}
    if(z_eq(w,"were")==1){return 1;}
    if(z_eq(w,"been")==1){return 1;}
    if(z_eq(w,"being")==1){return 1;}
    return 0;
}
// Negated verb -> positive antonym (STEMMED forms, as z_stem produces).
// "No student failed" == "Every student passed".
fn negverb_antonym(st:[]u8)[]u8{
    if(z_eq(st,"fail")==1){return "pass";}
    if(z_eq(st,"deny")==1){return "grant";}
    if(z_eq(st,"refus")==1){return "accept";}
    if(z_eq(st,"lose")==1){return "win";}
    if(z_eq(st,"lost")==1){return "win";}
    if(z_eq(st,"lack")==1){return "have";}
    return "";
}
// Strip comparative/superlative suffixes; writes base to out, returns length.
fn morph_base(w:[]u8,out:[]u8)i32{
    let l:i32=w.len;
    if(l>5 && z_eq(w[l-4..l],"iest")==1){
        let k:i32=0;
        while(k<l-4){out[k]=w[k];k=k+1;}
        out[k]=121;
        return k+1;
    }
    if(l>4 && z_eq(w[l-3..l],"est")==1){
        let k:i32=0;
        while(k<l-3){out[k]=w[k];k=k+1;}
        return k;
    }
    if(l>4 && z_eq(w[l-3..l],"ier")==1){
        let k:i32=0;
        while(k<l-3){out[k]=w[k];k=k+1;}
        out[k]=121;
        return k+1;
    }
    if(l>3 && z_eq(w[l-2..l],"er")==1){
        // guard against non-comparatives: never/other/under/water/over
        if(z_eq(w,"never")==1){return l;}
        if(z_eq(w,"other")==1){return l;}
        if(z_eq(w,"under")==1){return l;}
        if(z_eq(w,"water")==1){return l;}
        if(z_eq(w,"over")==1){return l;}
        if(z_eq(w,"after")==1){return l;}
        let k:i32=0;
        while(k<l-2){out[k]=w[k];k=k+1;}
        return k;
    }
    let k:i32=0;
    while(k<l){out[k]=w[k];k=k+1;}
    return k;
}
fn is_super(w:[]u8)i32{
    if(in_list(w,lex_super())==1){return 1;}
    let l:i32=w.len;
    if(l>4 && z_eq(w[l-3..l],"est")==1){return 1;}
    if(l>5 && z_eq(w[l-4..l],"iest")==1){return 1;}
    return 0;
}
fn is_compw(w:[]u8)i32{
    let l:i32=w.len;
    if(l>3 && z_eq(w[l-2..l],"er")==1){
        if(z_eq(w,"never")==1){return 0;}
        if(z_eq(w,"other")==1){return 0;}
        if(z_eq(w,"under")==1){return 0;}
        if(z_eq(w,"water")==1){return 0;}
        if(z_eq(w,"over")==1){return 0;}
        if(z_eq(w,"after")==1){return 0;}
        return 1;
    }
    if(l>4 && z_eq(w[l-3..l],"ier")==1){return 1;}
    return 0;
}
// comparative direction: +1 "more", -1 "less", 0 unknown
fn comp_dir(w:[]u8)i32{
    if(z_eq(w,"faster")==1){return 1;}
    if(z_eq(w,"slower")==1){return -1;}
    if(z_eq(w,"greater")==1){return 1;}
    if(z_eq(w,"lesser")==1){return -1;}
    if(z_eq(w,"larger")==1){return 1;}
    if(z_eq(w,"bigger")==1){return 1;}
    if(z_eq(w,"smaller")==1){return -1;}
    if(z_eq(w,"taller")==1){return 1;}
    if(z_eq(w,"shorter")==1){return -1;}
    if(z_eq(w,"higher")==1){return 1;}
    if(z_eq(w,"lower")==1){return -1;}
    if(z_eq(w,"longer")==1){return 1;}
    if(z_eq(w,"warmer")==1){return 1;}
    if(z_eq(w,"colder")==1){return -1;}
    if(z_eq(w,"stronger")==1){return 1;}
    if(z_eq(w,"weaker")==1){return -1;}
    if(z_eq(w,"older")==1){return 1;}
    if(z_eq(w,"younger")==1){return -1;}
    if(z_eq(w,"more")==1){return 1;}
    if(z_eq(w,"less")==1){return -1;}
    if(z_eq(w,"fewer")==1){return -1;}
    return 0;
}
fn ordinal_word(w:[]u8)i32{
    if(z_eq(w,"first")==1){return 1;}
    if(z_eq(w,"second")==1){return 2;}
    if(z_eq(w,"third")==1){return 3;}
    if(z_eq(w,"fourth")==1){return 4;}
    if(z_eq(w,"fifth")==1){return 5;}
    if(z_eq(w,"sixth")==1){return 6;}
    if(z_eq(w,"seventh")==1){return 7;}
    if(z_eq(w,"eighth")==1){return 8;}
    if(z_eq(w,"ninth")==1){return 9;}
    if(z_eq(w,"tenth")==1){return 10;}
    if(z_eq(w,"eleventh")==1){return 11;}
    if(z_eq(w,"twelfth")==1){return 12;}
    if(z_eq(w,"thirteenth")==1){return 13;}
    if(z_eq(w,"fourteenth")==1){return 14;}
    if(z_eq(w,"fifteenth")==1){return 15;}
    if(z_eq(w,"sixteenth")==1){return 16;}
    if(z_eq(w,"seventeenth")==1){return 17;}
    if(z_eq(w,"eighteenth")==1){return 18;}
    if(z_eq(w,"nineteenth")==1){return 19;}
    if(z_eq(w,"twentieth")==1){return 20;}
    if(z_eq(w,"thirtieth")==1){return 30;}
    return 0;
}
// digit ordinal: "20th" -> 20, else 0
fn digit_ordinal(w:[]u8)i32{
    let i:i32=0;
    let v:i32=0;
    while(i<w.len && z_isdig(w[i] as i32)==1){
        v=v*10+((w[i] as i32)-48);
        i=i+1;
    }
    if(i==0 || v==0){return 0;}
    if(i+2==w.len){
        let s0:i32=w[i] as i32;
        let s1:i32=w[i+1] as i32;
        if(s0==115 && s1==116){return v;}
        if(s0==110 && s1==100){return v;}
        if(s0==114 && s1==100){return v;}
        if(s0==116 && s1==104){return v;}
    }
    return 0;
}
fn antonym_tail(st:[]u8,cadj:[]u8)i32{
    if(cadj.len==0){return 0;}
    if(z_starts(st,"un")==1 && st.len>4){
        if(antonym(st[2..st.len],cadj)==1){return 1;}
    }
    if(z_starts(st,"in")==1 && st.len>4){
        if(antonym(st[2..st.len],cadj)==1){return 1;}
    }
    if(z_starts(st,"im")==1 && st.len>4){
        if(antonym(st[2..st.len],cadj)==1){return 1;}
    }
    if(z_starts(st,"dis")==1 && st.len>5){
        if(antonym(st[3..st.len],cadj)==1){return 1;}
    }
    return 0;
}
fn veto_idiom(clause:[]u8,tokC:[]u8,nct:i32,j:i32,tmp:[]u8,firstA:[]u8,pi:i32,stemC:[]u8,cstmC:[]u8)i32{
    let to:i32=a_get(tokC,2*j);
    let tl:i32=a_get(tokC,2*j+1);
    let ll:i32=lower_copy(clause[to..to+tl],tmp);
    let w:[]u8=tmp[0..ll];
    let is_not:i32=0;
    if(z_eq(w,"not")==1){is_not=1;}
    if(ew(w,0,ll,"n't")==1){is_not=1;}
    if(ll>=4 && (w[ll-4] as i32)==226 && (w[ll-3] as i32)==128 && (w[ll-2] as i32)==153 && (w[ll-1] as i32)==116){is_not=1;}
    let is_negw:i32=is_not;
    if(z_eq(w,"never")==1){is_negw=1;}
    let is_no:i32=0;
    if(z_eq(w,"no")==1){is_no=1;}
    let nx:i32=next_content(clause,tokC,nct,j,tmp);
    if(nx<0){return 0;}
    let no:i32=a_get(tokC,2*nx);
    let nl:i32=a_get(tokC,2*nx+1);
    let nl2:i32=lower_copy(clause[no..no+nl],tmp);
    let nw2:[]u8=tmp[0..nl2];
    if(is_not==1){
        if(z_eq(nw2,"only")==1){return 1;}
        if(z_eq(nw2,"just")==1){return 1;}
        if(z_eq(nw2,"merely")==1){return 1;}
    }
    if(is_negw==1){
        if(z_eq(nw2,"fail")==1){return 1;}
        if(z_eq(nw2,"fails")==1){return 1;}
        if(z_eq(nw2,"failed")==1){return 1;}
        if(z_eq(nw2,"failing")==1){return 1;}
        let nx2:i32=next_content(clause,tokC,nct,nx,tmp);
        if(nx2>=0){
            let mo:i32=a_get(tokC,2*nx2);
            let ml:i32=a_get(tokC,2*nx2+1);
            let ml2:i32=lower_copy(clause[mo..mo+ml],tmp);
            if(z_eq(tmp[0..ml2],"fail")==1){return 1;}
            if(z_eq(tmp[0..ml2],"fails")==1){return 1;}
            if(z_eq(tmp[0..ml2],"failed")==1){return 1;}
            if(z_eq(tmp[0..ml2],"failing")==1){return 1;}
        }
    }
    if(is_no==1){
        let so:i32=a_get(cstmC,2*nx);
        let sl:i32=a_get(cstmC,2*nx+1);
        if(z_eq(stemC[so..so+sl],firstA)==1){
            let k:i32=pi+1;
            while(k<nct){
                let ko:i32=a_get(tokC,2*k);
                let kl:i32=a_get(tokC,2*k+1);
                let kl2:i32=lower_copy(clause[ko..ko+kl],tmp);
                if(in_list(tmp[0..kl2],lex_cmp())==1){return 1;}
                k=k+1;
            }
        }
    }
    // "not X but Y <pred>": the negation scopes the pre-"but" material.
    // (The cleft "It is not <claim-subj> but <other> that <pred>" is caught
    // earlier as a deny; everything else here is a veto.)
    let b:i32=find_word(clause,tokC,nct,"but",j+1,tmp);
    if(b>j && b<pi){return 1;}
    return 0;
}
fn matrix_deny(clause:[]u8,tokC:[]u8,nct:i32,j:i32,t:i32,tmp:[]u8)i32{
    let nx:i32=next_content(clause,tokC,nct,j,tmp);
    if(nx>=0 && nx<t){
        let no:i32=a_get(tokC,2*nx);
        let nl:i32=a_get(tokC,2*nx+1);
        let nl2:i32=lower_copy(clause[no..no+nl],tmp);
        if(z_eq(tmp[0..nl2],"true")==1){return 1;}
        if(z_eq(tmp[0..nl2],"case")==1){return 1;}
    }
    let k:i32=j+1;
    while(k<t){
        let ko:i32=a_get(tokC,2*k);
        let kl:i32=a_get(tokC,2*k+1);
        let kl2:i32=lower_copy(clause[ko..ko+kl],tmp);
        if(in_list(tmp[0..kl2],lex_reporting())==1){return 1;}
        if(in_list(tmp[0..kl2],lex_cog())==1){return 1;}
        k=k+1;
    }
    return 0;
}
// ==================== B3 causal helpers ====================
fn is_negw(w:[]u8)i32{
    if(in_list(w,lex_neg())==1){return 1;}
    if(ew(w,0,w.len,"n't")==1){return 1;}
    let ll:i32=w.len;
    if(ll>=4 && (w[ll-4] as i32)==226 && (w[ll-3] as i32)==128 && (w[ll-2] as i32)==153 && (w[ll-1] as i32)==116){return 1;}
    return 0;
}
fn subj_idx(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,tmp:[]u8)i32{
    let j:i32=pi-1;
    while(j>=0){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(in_list(w,lex_filler())==1){j=j-1;continue;}
        if(is_negw(w)==1){j=j-1;continue;}
        return j;
    }
    return -1;
}
fn has_cexp(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,tmp:[]u8)i32{
    let k:i32=pi+1;
    while(k+1<nct){
        let to:i32=a_get(tokC,2*k);
        let tl:i32=a_get(tokC,2*k+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){
            let ta:i32=a_get(tokC,2*(k+1));
            let tb:i32=a_get(tokC,2*(k+1)+1);
            let lc:i32=lower_copy(clause[ta..ta+tb],tmp);
            if(z_eq(tmp[0..lc],"of")==1){return 1;}
        }
        k=k+1;
    }
    return 0;
}
fn has_word_after(clause:[]u8,tokC:[]u8,nct:i32,from:i32,span:i32,word:[]u8,tmp:[]u8)i32{
    let b:i32=from+1;
    let lim:i32=from+span;
    if(lim>=nct){lim=nct-1;}
    while(b<=lim){
        let to:i32=a_get(tokC,2*b);
        let tl:i32=a_get(tokC,2*b+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],word)==1){return 1;}
        b=b+1;
    }
    return 0;
}
fn claim_causal(claim:[]u8,tokA:[]u8,nct:i32,pred:[]u8,tmp:[]u8)i32{
    if(z_eq(pred,"cause")==1 || z_eq(pred,"lead")==1){return 1;}
    let fi:i32=0;
    while(fi<nct){
        let to:i32=a_get(tokA,2*fi);
        let tl:i32=a_get(tokA,2*fi+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){return 1;}
        if(z_eq(tmp[0..ll],"due")==1){return 1;}
        fi=fi+1;
    }
    return 0;
}
fn claim_neg(claim:[]u8,tokA:[]u8,nct:i32,pred:[]u8,outs:[]u8,tmps:[]u8,vbs:[]u8,negidx:[]u8)i32{
    // Double-negation frame: "it is not true that P" / "it is false that P"
    // flips the inner polarity (¬¬P = P, ¬P stays negative).
    let flip:i32=0;
    if(nct>=5){
        let t0:i32=a_get(tokA,0);
        let t1:i32=a_get(tokA,2);
        let t2:i32=a_get(tokA,4);
        let t3:i32=a_get(tokA,6);
        let t4:i32=a_get(tokA,8);
        let l0:i32=a_get(tokA,1);
        let l1:i32=a_get(tokA,3);
        let l2:i32=a_get(tokA,5);
        let l3:i32=a_get(tokA,7);
        let l4:i32=a_get(tokA,9);
        // NOTE: lower_copy reuses tmps; compare each word immediately.
        let c0:i32=0;
        let c1:i32=0;
        let c2:i32=0;
        let c3:i32=0;
        let c4:i32=0;
        let q0:i32=lower_copy(claim[t0..t0+l0],tmps);
        if(z_eq(tmps[0..q0],"it")==1){c0=1;}
        let q1:i32=lower_copy(claim[t1..t1+l1],tmps);
        if(z_eq(tmps[0..q1],"is")==1){c1=1;}
        let q2:i32=lower_copy(claim[t2..t2+l2],tmps);
        if(z_eq(tmps[0..q2],"not")==1){c2=1;}
        let q3:i32=lower_copy(claim[t3..t3+l3],tmps);
        if(z_eq(tmps[0..q3],"true")==1 || z_eq(tmps[0..q3],"false")==1){c3=1;}
        let q4:i32=lower_copy(claim[t4..t4+l4],tmps);
        if(z_eq(tmps[0..q4],"that")==1){c4=1;}
        if(c0==1 && c1==1 && c2==1 && c3==1 && c4==1){flip=1;}
    }
    let pi:i32=-1;
    let i:i32=0;
    while(i<nct){
        let to:i32=a_get(tokA,2*i);
        let tl:i32=a_get(tokA,2*i+1);
        let sl:i32=z_stem(claim[to..to+tl],outs,tmps,vbs);
        if(psyn_has(outs[0..sl],pred)==1){pi=i;break;}
        i=i+1;
    }
    if(pi<0){
        if(flip==1){return 1;}
        return 0;
    }
    let neg:i32=0;
    let negi:i32=-1;
    let j:i32=pi-4;
    if(j<0){j=0;}
    while(j<pi){
        let to2:i32=a_get(tokA,2*j);
        let tl2:i32=a_get(tokA,2*j+1);
        let ll:i32=lower_copy(claim[to2..to2+tl2],tmps);
        if(is_negw(tmps[0..ll])==1){neg=1;negi=j;break;}
        j=j+1;
    }
    if(neg==0){
        // Post-predicate negation for copular/aux claims ("are not blind",
        // "is not risk-free"): the negator follows the predicate.
        let k:i32=pi+1;
        let kend:i32=pi+4;
        if(kend>nct){kend=nct;}
        while(k<kend){
            let to3:i32=a_get(tokA,2*k);
            let tl3:i32=a_get(tokA,2*k+1);
            let ll3:i32=lower_copy(claim[to3..to3+tl3],tmps);
            if(is_negw(tmps[0..ll3])==1){neg=1;negi=k;break;}
            k=k+1;
        }
    }
    if(flip==1){neg=1-neg;}
    a_put(negidx,0,negi);
    return neg;
}
fn ant_idx(stemC:[]u8,cstmC:[]u8,nct:i32,mode:i32)i32{
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        let st:[]u8=stemC[so..so+sl];
        if(mode==0){
            if(z_eq(st,"sink")==1 || z_eq(st,"sank")==1 || z_eq(st,"sunk")==1){return i;}
        }else{
            if(z_eq(st,"float")==1){return i;}
        }
        i=i+1;
    }
    return -1;
}
fn cause_deny(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,nclm:i32,tmp:[]u8)i32{
    if(nclm<1){return 0;}
    let bi:i32=0;
    while(bi<nct){
        let to:i32=a_get(tokC,2*bi);
        let tl:i32=a_get(tokC,2*bi+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){
            // V4-R2: the negation must immediately precede "because"
            // ("not because of X"). A marker two tokens back scopes the
            // effect verb instead ("didn't spread because...",
            // "without injury because...") and must not deny.
            let hm:i32=0;
            if(bi>=1){
                let qa:i32=a_get(tokC,2*(bi-1));
                let qb:i32=a_get(tokC,2*(bi-1)+1);
                let lq:i32=lower_copy(clause[qa..qa+qb],tmp);
                if(is_negw(tmp[0..lq])==1){hm=1;}
            }
            if(hm==1){
                let p:i32=bi+1;
                while(p<=bi+5 && p<nct){
                    let so:i32=a_get(cstmC,2*p);
                    let sl:i32=a_get(cstmC,2*p+1);
                    if(in_stems(stemC[so..so+sl],stemA,cstemA,ncs)==1){return 1;}
                    p=p+1;
                }
            }
        }
        bi=bi+1;
    }
    return 0;
}
fn prevent_aff(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,firstA:[]u8,subjA:[]u8,nclm:i32,pred:[]u8,tmp:[]u8)i32{
    if(z_eq(pred,"prevent")==0){return 0;}
    // V4-R2: nclm>=1 (was >=2): the subject-anchor match after "because"
    // already establishes topicality; short-noun subjects ("dam") never
    // reach nclm=2 because len<=3 nouns are excluded from CSTEMA (CAU-P04).
    if(nclm<1){return 0;}
    let bi:i32=-1;
    let i:i32=0;
    while(i<nct){
        let to:i32=a_get(tokC,2*i);
        let tl:i32=a_get(tokC,2*i+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){bi=i;break;}
        i=i+1;
    }
    if(bi<=0){return 0;}
    let hm:i32=0;
    let j:i32=0;
    while(j<bi){
        let qa:i32=a_get(tokC,2*j);
        let qb:i32=a_get(tokC,2*j+1);
        let lq:i32=lower_copy(clause[qa..qa+qb],tmp);
        if(is_negw(tmp[0..lq])==1){hm=1;}
        j=j+1;
    }
    if(hm==0){return 0;}
    // V4-R2: anchor on the claim SUBJECT ("dam"), not firstA — firstA skips
    // short nouns ("dam" is 3 letters), so the agent match never fired.
    let anchor:[]u8=firstA;
    if(subjA.len>0){anchor=subjA;}
    if(anchor.len==0){return 0;}
    let p:i32=bi+1;
    while(p<nct){
        let so:i32=a_get(cstmC,2*p);
        let sl:i32=a_get(cstmC,2*p+1);
        if(z_eq(stemC[so..so+sl],anchor)==1){return 1;}
        p=p+1;
    }
    return 0;
}
fn postpi_deny(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,nclm:i32,cneg:i32,cauflag:i32,subjA:[]u8,sstemb:[]u8,sstmc:[]u8,nsst:i32,tmp:[]u8)i32{
    if(cneg!=0 || cauflag!=1 || nclm<1){return 0;}
    let m:i32=pi+1;
    while(m<nct){
        let to:i32=a_get(tokC,2*m);
        let tl:i32=a_get(tokC,2*m+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(is_negw(tmp[0..ll])==1){break;}
        m=m+1;
    }
    if(m>=nct){return 0;}
    if(has_word_after(clause,tokC,nct,m,4,"but",tmp)==1){return 0;}
    let p:i32=m+1;
    while(p<=m+2 && p<nct){
        let so:i32=a_get(cstmC,2*p);
        let sl:i32=a_get(cstmC,2*p+1);
        let w:[]u8=stemC[so..so+sl];
        // V4-R2: the "not X" noun can be a short claim noun ("not fog") or
        // the claim subject ("not the dam") — both absent from CSTEMA.
        let hit:i32=in_stems(w,stemA,cstemA,ncs);
        if(hit==0){hit=in_stems(w,sstemb,sstmc,nsst);}
        if(hit==0 && subjA.len>0 && z_eq(w,subjA)==1){hit=1;}
        if(hit==1){
            if(p==nct-1){return 1;}
            if(has_word_after(clause,tokC,nct,p,2,"but",tmp)==1){return 1;}
        }
        p=p+1;
    }
    return 0;
}
fn causal_verb(claim:[]u8,tokA:[]u8,nct:i32,cvb:[]u8,tmp:[]u8,outs:[]u8,vbs:[]u8)i32{
    let b:i32=-1;
    let i:i32=0;
    while(i<nct){
        let to:i32=a_get(tokA,2*i);
        let tl:i32=a_get(tokA,2*i+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1 || z_eq(tmp[0..ll],"due")==1){b=i;break;}
        i=i+1;
    }
    if(b<0){return 0;}
    i=b+1;
    while(i<nct){
        let to2:i32=a_get(tokA,2*i);
        let tl2:i32=a_get(tokA,2*i+1);
        let sl:i32=z_stem(claim[to2..to2+tl2],outs,tmp,vbs);
        let st:[]u8=outs[0..sl];
        if(in_list(st,lex_verb())==1 && in_list(st,lex_reporting())==0){
            let q:i32=0;
            while(q<sl){cvb[q]=st[q];q=q+1;}
            return sl;
        }
        i=i+1;
    }
    return 0;
}
fn mech_aff(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,subjA:[]u8,cv:[]u8,nclm:i32,need:i32,cneg:i32,cauflag:i32,framed:i32,tmp:[]u8)i32{
    if(cneg!=0){return 0;}
    if(cauflag!=1){return 0;}
    if(cv.len==0){return 0;}
    if(framed!=0){return 0;}
    if(nclm<need){return 0;}
    if(subjA.len==0){return 0;}
    if(in_stems(subjA,stemC,cstmC,nct)==0){return 0;}
    if(is_interrog(clause,tokC,nct,tmp)==1){return 0;}
    let kv:i32=-1;
    let k:i32=0;
    while(k<nct){
        let so:i32=a_get(cstmC,2*k);
        let sl:i32=a_get(cstmC,2*k+1);
        if(z_eq(stemC[so..so+sl],cv)==1){kv=k;break;}
        k=k+1;
    }
    if(kv<0){return 0;}
    let j:i32=kv-3;
    if(j<0){j=0;}
    while(j<kv){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(is_negw(tmp[0..ll])==1){return 0;}
        j=j+1;
    }
    return 1;
}
fn opp_outcome_deny(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,nclm:i32,cauflag:i32,tmp:[]u8)i32{
    if(cauflag!=1 || nclm<1){return 0;}
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        if(in_list(stemC[so..so+sl],lex_worse())==1){
            // adjacent token must be a claim noun (the worsened outcome)
            let adj:i32=0;
            let k:i32=i-1;
            if(k<0){k=0;}
            while(k<=i+1 && k<nct){
                if(k!=i){
                    let so2:i32=a_get(cstmC,2*k);
                    let sl2:i32=a_get(cstmC,2*k+1);
                    if(in_stems(stemC[so2..so2+sl2],stemA,cstemA,ncs)==1){adj=1;break;}
                }
                k=k+1;
            }
            if(adj==1){
                // causal marker within 3 tokens after the worse-verb
                let m:i32=i+1;
                while(m<=i+3 && m<nct){
                    let to:i32=a_get(tokC,2*m);
                    let tl:i32=a_get(tokC,2*m+1);
                    let ll:i32=lower_copy(clause[to..to+tl],tmp);
                    if(z_eq(tmp[0..ll],"because")==1){return 1;}
                    if(z_eq(tmp[0..ll],"due")==1){return 1;}
                    m=m+1;
                }
            }
        }
        i=i+1;
    }
    return 0;
}
fn ant_pol(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,need:i32,nclm:i32,framed:i32,cneg:i32,firstA:[]u8,subjA:[]u8,pred:[]u8,cadj:[]u8,tmp:[]u8)i32{
    if(nclm<1){return 0;}
    let ai:i32=-1;
    if(in_stems("float",stemA,cstemA,ncs)==1){ai=ant_idx(stemC,cstmC,nct,0);}
    if(ai<0 && in_stems("sink",stemA,cstemA,ncs)==1){ai=ant_idx(stemC,cstmC,nct,1);}
    if(ai<0){return 0;}
    if(is_interrog(clause,tokC,nct,tmp)==1){return 0;}
    let aneg:i32=neg_scope(clause,tokC,nct,ai,stemC,cstmC,stemA,cstemA,ncs,firstA,subjA,pred,cadj,tmp);
    if(cneg==aneg){return 1;}
    if(nclm>=need && framed==0){return 2;}
    return 0;
}
// ==================== B2 numeric guard ====================
fn wnum(w:[]u8)i32{
    if(z_eq(w,"one")==1){return 1;}
    if(z_eq(w,"two")==1){return 2;}
    if(z_eq(w,"three")==1){return 3;}
    if(z_eq(w,"four")==1){return 4;}
    if(z_eq(w,"five")==1){return 5;}
    if(z_eq(w,"six")==1){return 6;}
    if(z_eq(w,"seven")==1){return 7;}
    if(z_eq(w,"eight")==1){return 8;}
    if(z_eq(w,"nine")==1){return 9;}
    if(z_eq(w,"ten")==1){return 10;}
    if(z_eq(w,"eleven")==1){return 11;}
    if(z_eq(w,"twelve")==1){return 12;}
    if(z_eq(w,"thirteen")==1){return 13;}
    if(z_eq(w,"fourteen")==1){return 14;}
    if(z_eq(w,"fifteen")==1){return 15;}
    if(z_eq(w,"sixteen")==1){return 16;}
    if(z_eq(w,"seventeen")==1){return 17;}
    if(z_eq(w,"eighteen")==1){return 18;}
    if(z_eq(w,"nineteen")==1){return 19;}
    if(z_eq(w,"twenty")==1){return 20;}
    if(z_eq(w,"thirty")==1){return 30;}
    if(z_eq(w,"forty")==1){return 40;}
    if(z_eq(w,"fifty")==1){return 50;}
    if(z_eq(w,"sixty")==1){return 60;}
    if(z_eq(w,"seventy")==1){return 70;}
    if(z_eq(w,"eighty")==1){return 80;}
    if(z_eq(w,"ninety")==1){return 90;}
    return 0;
}
// Parse a maximal English number-word compound starting at p in the
// lowercased text low (length ll). Handles hyphenated tens ("eighty-seven"),
// hundreds/thousands/millions ("six hundred fifty", "ten thousand two
// hundred"), and year phrasing ("eighteen eighty-nine" -> 1889,
// "twenty twenty" -> 2020). Returns the value (>=0), or -1 if p does not
// start a number word. Writes the end offset (first char after the compound)
// to epos[0].
fn wnum_seq(low:[]u8,p:i32,ll:i32,epos:[]u8)i64{
    a_put(epos,0,p);
    let total:i64=0;
    let cur:i64=0;
    let scaled:i32=0;
    let have:i32=0;
    let pos:i32=p;
    while(pos<ll){
        // skip spaces and intra-compound hyphens
        while(pos<ll){
            let sc:i32=low[pos] as i32;
            if(sc==32){pos=pos+1;continue;}
            if(sc==45 && pos+1<ll){
                let nc2:i32=low[pos+1] as i32;
                if(nc2>=97 && nc2<=122){pos=pos+1;continue;}
            }
            break;
        }
        if(pos>=ll){break;}
        let c0:i32=low[pos] as i32;
        if(c0<97 || c0>122){break;}
        let r:i32=pos;
        while(r<ll){let c2:i32=low[r] as i32;if(c2<97 || c2>122){break;}r=r+1;}
        let w:[]u8=low[pos..r];
        let wv:i32=wnum(w);
        if(wv>0){
            // year pattern: two bare tens/teens in a row ("eighteen
            // eighty-nine", "twenty twenty") read as a year
            if(have==1 && scaled==0 && cur>=10 && wv>=10){
                total=cur*100+(wv as i64);
                cur=0;
                have=1;
                pos=r;
                a_put(epos,0,pos);
                continue;
            }
            cur=cur+(wv as i64);
            have=1;
            pos=r;
            a_put(epos,0,pos);
            continue;
        }
        if(z_eq(w,"hundred")==1){
            if(cur==0){cur=1;}
            cur=cur*100;
            scaled=1;
            have=1;
            pos=r;
            a_put(epos,0,pos);
            continue;
        }
        if(z_eq(w,"thousand")==1){
            if(cur==0){cur=1;}
            total=total+cur*1000;
            cur=0;
            scaled=0;
            have=1;
            pos=r;
            a_put(epos,0,pos);
            continue;
        }
        if(z_eq(w,"million")==1){
            if(cur==0){cur=1;}
            total=total+cur*1000000;
            cur=0;
            scaled=0;
            have=1;
            pos=r;
            a_put(epos,0,pos);
            continue;
        }
        if(z_eq(w,"billion")==1){
            if(cur==0){cur=1;}
            total=total+cur*1000000000;
            cur=0;
            scaled=0;
            have=1;
            pos=r;
            a_put(epos,0,pos);
            continue;
        }
        break;
    }
    if(have==0){return -1;}
    let v:i64=total+cur;
    if(v>2000000000){v=2000000000;}
    return v;
}
fn umul(w:[]u8)i64{
    if(z_eq(w,"second")==1){return 1;}
    if(z_eq(w,"seconds")==1){return 1;}
    if(z_eq(w,"minute")==1){return 60;}
    if(z_eq(w,"minutes")==1){return 60;}
    if(z_eq(w,"hour")==1){return 3600;}
    if(z_eq(w,"hours")==1){return 3600;}
    if(z_eq(w,"day")==1){return 86400;}
    if(z_eq(w,"days")==1){return 86400;}
    if(z_eq(w,"month")==1){return 2592000;}
    if(z_eq(w,"months")==1){return 2592000;}
    if(z_eq(w,"year")==1){return 31536000;}
    if(z_eq(w,"years")==1){return 31536000;}
    return 0;
}
fn is_demo(w:[]u8)i32{
    if(z_eq(w,"this")==1){return 1;}
    if(z_eq(w,"that")==1){return 1;}
    if(z_eq(w,"these")==1){return 1;}
    if(z_eq(w,"those")==1){return 1;}
    if(z_eq(w,"each")==1){return 1;}
    if(z_eq(w,"every")==1){return 1;}
    if(z_eq(w,"any")==1){return 1;}
    return 0;
}
fn sp_grp(t:[]u8,q:i32,ll:i32)i32{
    if(q+4>ll){return 0;}
    if(z_isdig(t[q+1] as i32)==0){return 0;}
    if(z_isdig(t[q+2] as i32)==0){return 0;}
    if(z_isdig(t[q+3] as i32)==0){return 0;}
    if(q+4<ll && z_isdig(t[q+4] as i32)==1){return 0;}
    return 1;
}
fn is_capb(t:[]u8,s:i32)i32{
    if(s<0 || s>=t.len){return 0;}
    let c:i32=t[s] as i32;
    if(c>=65 && c<=90){return 1;}
    return 0;
}
fn is_alphab(c:i32)i32{
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn prevw_start(t:[]u8,p:i32)i32{
    let j:i32=p-1;
    while(j>=0 && is_alphab(t[j] as i32)==0){j=j-1;}
    if(j<0){return -1;}
    while(j>=0 && is_alphab(t[j] as i32)==1){j=j-1;}
    return j+1;
}
fn prevw_cap(t:[]u8,p:i32)i32{
    let s:i32=prevw_start(t,p);
    if(s<0){return 0;}
    return is_capb(t,s);
}
fn prev2w_cap(t:[]u8,p:i32)i32{
    let s1:i32=prevw_start(t,p);
    if(s1<0){return 0;}
    if(is_capb(t,s1)==0){return 0;}
    let s2:i32=prevw_start(t,s1);
    if(s2<0){return 0;}
    return is_capb(t,s2);
}
fn nextw_cap(t:[]u8,q:i32,ll:i32)i32{
    let j:i32=q;
    while(j<ll && is_alphab(t[j] as i32)==0){j=j+1;}
    if(j>=ll){return 0;}
    return is_capb(t,j);
}
fn tok_bits(t:[]u8,p:i32,q:i32,ll:i32)i32{
    let ts:i32=p;
    while(ts>0 && z_isspace(t[ts-1] as i32)==0){ts=ts-1;}
    let te:i32=q;
    while(te<ll && z_isspace(t[te] as i32)==0){te=te+1;}
    let bits:i32=0;
    let sl:i32=0;
    let i:i32=ts;
    while(i<te){
        let c:i32=t[i] as i32;
        if(is_alphab(c)==1 && (i<p || i>=q)){bits=bits|1;}
        if(c==47){sl=sl+1;}
        if(c==46){bits=bits|4;}
        i=i+1;
    }
    if(sl>=1){bits=bits|2;}
    if(sl>=2){bits=bits|8;}
    return bits;
}
fn match_at(s:[]u8,i:i32,w:[]u8)i32{
    let k:i32=0;
    while(k<w.len){
        if((s[i+k] as i32)!=(w[k] as i32)){return 0;}
        k=k+1;
    }
    if(i>0){
        let c0:i32=s[i-1] as i32;
        if(c0>=97 && c0<=122){return 0;}
    }
    let e:i32=i+w.len;
    if(e<s.len){
        let c1:i32=s[e] as i32;
        if(c1>=97 && c1<=122){return 0;}
    }
    return 1;
}
fn has_word_in(s:[]u8,a:i32,b:i32,w:[]u8)i32{
    let i:i32=a;
    while(i+w.len<=b){
        if(match_at(s,i,w)==1){return 1;}
        i=i+1;
    }
    return 0;
}
fn nearest_dist(s:[]u8,a:i32,b:i32,w:[]u8,pos:i32)i32{
    let best:i32=99999;
    let i:i32=a;
    while(i+w.len<=b){
        if(match_at(s,i,w)==1){
            let d:i32=i-pos;
            if(d<0){d=0-d;}
            if(d<best){best=d;}
            i=i+w.len;
        }else{i=i+1;}
    }
    return best;
}
fn phenom_words_in(s:[]u8,a:i32,b:i32,which:i32)i32{
    if(which==1){
        if(has_word_in(s,a,b,"boil")==1){return 1;}
        if(has_word_in(s,a,b,"boils")==1){return 1;}
        if(has_word_in(s,a,b,"boiling")==1){return 1;}
        if(has_word_in(s,a,b,"boiled")==1){return 1;}
        return 0;
    }
    if(has_word_in(s,a,b,"freeze")==1){return 1;}
    if(has_word_in(s,a,b,"freezes")==1){return 1;}
    if(has_word_in(s,a,b,"freezing")==1){return 1;}
    if(has_word_in(s,a,b,"frozen")==1){return 1;}
    if(has_word_in(s,a,b,"froze")==1){return 1;}
    if(has_word_in(s,a,b,"frost")==1){return 1;}
    if(has_word_in(s,a,b,"ice")==1){return 1;}
    if(has_word_in(s,a,b,"melt")==1){return 1;}
    if(has_word_in(s,a,b,"melts")==1){return 1;}
    if(has_word_in(s,a,b,"melting")==1){return 1;}
    if(has_word_in(s,a,b,"melted")==1){return 1;}
    return 0;
}
fn ent_words_in(s:[]u8,a:i32,b:i32,which:i32)i32{
    if(which==1){
        if(has_word_in(s,a,b,"human")==1){return 1;}
        if(has_word_in(s,a,b,"humans")==1){return 1;}
        if(has_word_in(s,a,b,"mankind")==1){return 1;}
        if(has_word_in(s,a,b,"man")==1){return 1;}
        if(has_word_in(s,a,b,"woman")==1){return 1;}
        if(has_word_in(s,a,b,"men")==1){return 1;}
        if(has_word_in(s,a,b,"women")==1){return 1;}
        if(has_word_in(s,a,b,"people")==1){return 1;}
        if(has_word_in(s,a,b,"person")==1){return 1;}
        return 0;
    }
    if(has_word_in(s,a,b,"fly")==1){return 1;}
    if(has_word_in(s,a,b,"flies")==1){return 1;}
    if(has_word_in(s,a,b,"rice")==1){return 1;}
    if(has_word_in(s,a,b,"plant")==1){return 1;}
    if(has_word_in(s,a,b,"plants")==1){return 1;}
    if(has_word_in(s,a,b,"mouse")==1){return 1;}
    if(has_word_in(s,a,b,"mice")==1){return 1;}
    if(has_word_in(s,a,b,"rat")==1){return 1;}
    if(has_word_in(s,a,b,"rats")==1){return 1;}
    if(has_word_in(s,a,b,"dog")==1){return 1;}
    if(has_word_in(s,a,b,"dogs")==1){return 1;}
    if(has_word_in(s,a,b,"cat")==1){return 1;}
    if(has_word_in(s,a,b,"cats")==1){return 1;}
    if(has_word_in(s,a,b,"bird")==1){return 1;}
    if(has_word_in(s,a,b,"birds")==1){return 1;}
    if(has_word_in(s,a,b,"fish")==1){return 1;}
    if(has_word_in(s,a,b,"monkey")==1){return 1;}
    if(has_word_in(s,a,b,"monkeys")==1){return 1;}
    if(has_word_in(s,a,b,"ape")==1){return 1;}
    if(has_word_in(s,a,b,"apes")==1){return 1;}
    if(has_word_in(s,a,b,"bacteria")==1){return 1;}
    if(has_word_in(s,a,b,"yeast")==1){return 1;}
    if(has_word_in(s,a,b,"worm")==1){return 1;}
    if(has_word_in(s,a,b,"worms")==1){return 1;}
    if(has_word_in(s,a,b,"frog")==1){return 1;}
    if(has_word_in(s,a,b,"frogs")==1){return 1;}
    return 0;
}
fn ent_nearest(s:[]u8,a:i32,b:i32,pos:i32,which:i32)i32{
    let best:i32=99999;
    let d:i32=0;
    if(which==1){
        d=nearest_dist(s,a,b,"human",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"humans",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"mankind",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"man",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"woman",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"men",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"women",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"people",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"person",pos);if(d<best){best=d;}
        return best;
    }
    d=nearest_dist(s,a,b,"fly",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"flies",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"rice",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"plant",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"plants",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"mouse",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"mice",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"rat",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"rats",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"dog",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"dogs",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"cat",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"cats",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"bird",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"birds",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"fish",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"monkey",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"monkeys",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"ape",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"apes",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"bacteria",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"yeast",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"worm",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"worms",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"frog",pos);if(d<best){best=d;}
    d=nearest_dist(s,a,b,"frogs",pos);if(d<best){best=d;}
    return best;
}
fn approx_hit(s:[]u8,a:i32,b:i32)i32{
    if(has_word_in(s,a,b,"approximately")==1){return 1;}
    if(has_word_in(s,a,b,"approx")==1){return 1;}
    if(has_word_in(s,a,b,"about")==1){return 1;}
    if(has_word_in(s,a,b,"around")==1){return 1;}
    if(has_word_in(s,a,b,"roughly")==1){return 1;}
    if(has_word_in(s,a,b,"nearly")==1){return 1;}
    if(has_word_in(s,a,b,"almost")==1){return 1;}
    if(has_word_in(s,a,b,"circa")==1){return 1;}
    let i:i32=a;
    while(i+3<=b){
        if((s[i] as i32)==226 && (s[i+1] as i32)==136 && (s[i+2] as i32)==136){return 1;}
        i=i+1;
    }
    return 0;
}
fn noun_hash(s:[]u8,a:i32,b:i32)i32{
    let l:i32=b-a;
    if(l<=1){return 0;}
    if((s[b-1] as i32)==115 && l>2){l=l-1;}
    if(l<=1){return 0;}
    let h:i32=7;
    let i:i32=0;
    while(i<l){
        h=h*31+((s[a+i] as i32));
        i=i+1;
    }
    if(h<0){h=0-h;}
    if(h==0){h=1;}
    return h;
}
fn temp_scale_word(w:[]u8)i32{
    if(z_eq(w,"celsius")==1){return 1;}
    if(z_eq(w,"centigrade")==1){return 1;}
    if(z_eq(w,"fahrenheit")==1){return 2;}
    if(z_eq(w,"kelvin")==1){return 3;}
    if(z_eq(w,"degrees")==1){return 4;}
    return 0;
}
fn temp_canon(v:i64,scale:i32)i32{
    let x:i64=v;
    if(x>20000000){x=20000000;}
    if(x<-20000000){x=-20000000;}
    if(scale==1){return (x*10) as i32;}
    if(scale==2){return ((x-32)*50/9) as i32;}
    return ((x-273)*10) as i32;
}
fn band_ok(lo:i32,hi:i32,ap:i32,cv:i32)i32{
    if(ap==1){
        let l:i64=(lo as i64)-((lo as i64)/20);
        let h:i64=(hi as i64)+((hi as i64)/20);
        let c:i64=cv as i64;
        if(c>=l && c<=h){return 1;}
        return 0;
    }
    if(lo<=cv && cv<=hi){return 1;}
    return 0;
}
fn within_tol(a:i64,b:i64,ap:i32)i32{
    if(ap==1){
        let d:i64=a-b;
        if(d<0){d=0-d;}
        if(b==0){
            if(d==0){return 1;}
            return 0;
        }
        let bb:i64=b;
        if(bb<0){bb=0-bb;}
        if(d*20<=bb){return 1;}
        return 0;
    }
    if(a==b){return 1;}
    return 0;
}
fn temp_compat(elo:i32,ehi:i32,eap:i32,eamb:i32,cv:i32,cap:i32,camb:i32)i32{
    let ap:i32=0;
    if(eap==1 || cap==1){ap=1;}
    if(eamb==0 && camb==0){
        return band_ok(elo,ehi,ap,cv);
    }
    let ev0:i64=elo as i64;
    let ev1:i64=elo as i64;
    if(eamb==1){
        ev0=(elo as i64)*10;
        ev1=((elo as i64)-32)*50/9;
    }
    let cv0:i64=cv as i64;
    let cv1:i64=cv as i64;
    if(camb==1){
        cv0=(cv as i64)*10;
        cv1=((cv as i64)-32)*50/9;
    }
    if(within_tol(ev0,cv0,ap)==1){return 1;}
    if(within_tol(ev0,cv1,ap)==1){return 1;}
    if(within_tol(ev1,cv0,ap)==1){return 1;}
    if(within_tol(ev1,cv1,ap)==1){return 1;}
    return 0;
}
fn ev_scan(t:[]u8,eA:[]u8,eB:[]u8,eC:[]u8,eD:[]u8,eE:[]u8,start:i32,maxn:i32,qphenom:i32,qent:i32)i32{
    let low:[]u8=z_alloc(t.len+1);
    if(low.len==0){return start;}
    let ll:i32=lower_copy(t,low);
    // scratch for compound number-word end positions (wnum_seq)
    let eposb:[]u8=z_alloc(8);
    if(eposb.len==0){z_free(low);return start;}
    let n:i32=start;
    let p:i32=0;
    let pt0:i32=0;
    let pt1:i32=0;
    while(p<ll && n<maxn){
        let b:i32=low[p] as i32;
        let isd:i32=z_isdig(b);
        let isa:i32=0;
        if(b>=97 && b<=122){isa=1;}
        if(isd==0 && isa==0){p=p+1;continue;}
        let v:i64=-1;
        let q:i32=p;
        let sci:i32=0;
        let tscale:i32=0;
        let pctu:i32=0;
        let spd:i64=0;
        if(isd==1){
            v=0;
            while(q<ll){
                let c:i32=low[q] as i32;
                if(z_isdig(c)==1){v=v*10+((c-48) as i64);if(v>2000000000){v=2000000000;}q=q+1;continue;}
                if(c==44){q=q+1;continue;}
                if(c==32 && sp_grp(low,q,ll)==1){q=q+1;continue;}
                break;
            }
            // compact temperature suffix: 100C, 212F, 100°C, 32°F
            // (parsed before the identifier filter, which would read the
            // bare C/F as an identifier letter)
            if(q<ll){
                let s0:i32=low[q] as i32;
                if(s0==194 && q+2<ll && (low[q+1] as i32)==176){
                    let dc:i32=low[q+2] as i32;
                    if(dc==99){tscale=1;q=q+3;}
                    else{if(dc==102){tscale=2;q=q+3;}}
                }else{
                    if(s0==99 || s0==102){
                        let sa:i32=q+1;
                        if(sa>=ll || is_alphab(low[sa] as i32)==0){
                            if(s0==99){tscale=1;}else{tscale=2;}
                            q=q+1;
                        }
                    }
                }
            }
            // name/identifier filter: letters in the token (5G, COVID-19),
            // DOI/URL tokens (slash+dot or 2+ slashes), course numbers
            // ("Solar System 101": small int after two capitalized words,
            // followed by a title separator)
            let tb:i32=tok_bits(t,p,q,ll);
            if((tb & 1)==1){p=q;continue;}
            if(((tb & 2)==1 && (tb & 4)==1) || (tb & 8)==1){p=q;continue;}
            if(v>=0 && v<=999 && prev2w_cap(t,p)==1){
                let na:i32=q;
                while(na<ll && z_isspace(t[na] as i32)==1){na=na+1;}
                if(na>=ll){p=q;continue;}
                let nc0:i32=t[na] as i32;
                if(nc0==124 || nc0==40 || nc0==58 || nc0==45){p=q;continue;}
            }
            // scientific notation: N x 10^E, N x 10^E, N \times 10^E
            let sq:i32=q;
            while(sq<ll && (low[sq] as i32)==32){sq=sq+1;}
            let isx:i32=0;
            if(sq<ll && (low[sq] as i32)==120){isx=1;sq=sq+1;}
            else{
                if(sq+1<ll && (low[sq] as i32)==195 && (low[sq+1] as i32)==151){isx=1;sq=sq+2;}
                else{
                    if(sq<ll && (low[sq] as i32)==92){
                        if(sq+5<ll && (low[sq+1] as i32)==116 && (low[sq+2] as i32)==105 && (low[sq+3] as i32)==109 && (low[sq+4] as i32)==101 && (low[sq+5] as i32)==115){isx=1;sq=sq+6;}
                    }
                }
            }
            if(isx==1){
                while(sq<ll && (low[sq] as i32)==32){sq=sq+1;}
                if(sq+1<ll && (low[sq] as i32)==49 && (low[sq+1] as i32)==48){
                    sq=sq+2;
                    if(sq<ll && (low[sq] as i32)==94){
                        sq=sq+1;
                        let ex:i32=0;
                        let ed:i32=0;
                        while(sq<ll && z_isdig(low[sq] as i32)==1){ex=ex*10+((low[sq] as i32)-48);ed=1;sq=sq+1;}
                        if(ed==1){
                            let pw:i64=1;
                            let k:i32=0;
                            while(k<ex){pw=pw*10;if(pw>2000000000){break;}k=k+1;}
                            if(pw>2000000000){pw=2000000000;}
                            v=v*pw;
                            if(v>2000000000){v=2000000000;}
                            q=sq;
                            sci=1;
                        }
                    }
                }
            }
        }else{
            let r:i32=p;
            while(r<ll){let c2:i32=low[r] as i32;if(c2<97 || c2>122){break;}r=r+1;}
            let tok:[]u8=low[p..r];
            // fraction words: "whole/half/quarter of X" = 100/50/25 percent
            let frv:i64=0;
            if(z_eq(tok,"whole")==1){frv=100;}
            else{if(z_eq(tok,"half")==1){frv=50;}
            else{if(z_eq(tok,"quarter")==1){frv=25;}}}
            // compound number words: "eighty-seven", "six hundred fifty",
            // "ten thousand two hundred", "eighteen eighty-nine"
            let cvv:i64=wnum_seq(low,p,ll,eposb);
            let qe:i32=a_get(eposb,0);
            if(frv>0){cvv=frv;qe=r;pctu=1;}
            if(cvv>0){
                if(cvv==1 && is_demo(low[pt0..pt1])==1){pt0=p;pt1=r;p=r;continue;}
                // proper-name filter: capitalized number-word next to a
                // capitalized word ("Planet Nine") is a name, not a value
                if(is_capb(t,p)==1 && (prevw_cap(t,p)==1 || nextw_cap(t,r,ll)==1)){pt0=p;pt1=r;p=r;continue;}
                v=cvv;
            }
            pt0=p;pt1=r;
            q=qe;
            if(v<0){p=r;continue;}
        }
        // approximation marker: sci-notation, or approx word in the 30
        // bytes before the number
        let ap:i32=sci;
        if(ap==0){
            let aa:i32=p-30;
            if(aa<0){aa=0;}
            if(approx_hit(low,aa,p)==1){ap=1;}
        }
        let r0:i32=q;
        while(r0<ll && (low[r0] as i32)==32){r0=r0+1;}
        let isrng:i32=0;
        let r1:i32=r0;
        if(r0<ll && (low[r0] as i32)==45){isrng=1;r1=r0+1;}
        if(isrng==0 && r0<ll && (low[r0] as i32)>=97 && (low[r0] as i32)<=122){
            let r2:i32=r0;
            while(r2<ll){let c4:i32=low[r2] as i32;if(c4<97 || c4>122){break;}r2=r2+1;}
            let cw:[]u8=low[r0..r2];
            if(z_eq(cw,"to")==1 || z_eq(cw,"and")==1){isrng=1;r1=r2;}
        }
        let v2:i64=v;
        let q2:i32=q;
        if(isrng==1){
            let s2:i32=r1;
            while(s2<ll && (low[s2] as i32)==32){s2=s2+1;}
            if(s2<ll && z_isdig(low[s2] as i32)==1){
                v2=0;q2=s2;
                while(q2<ll){
                    let c6:i32=low[q2] as i32;
                    if(z_isdig(c6)==1){
                        v2=v2*10+((c6-48) as i64);
                        if(v2>2000000000){v2=2000000000;}
                        q2=q2+1;continue;
                    }
                    if(c6==32 && sp_grp(low,q2,ll)==1){q2=q2+1;continue;}
                    break;
                }
            }else{
                // word-number range end: "fifty-five to sixty-five"
                if(s2<ll && (low[s2] as i32)>=97 && (low[s2] as i32)<=122){
                    let wv2:i64=wnum_seq(low,s2,ll,eposb);
                    let qe2:i32=a_get(eposb,0);
                    if(wv2>0 && wv2<=2000000000){v2=wv2;q2=qe2;}
                    else{isrng=0;}
                }else{isrng=0;}
            }
        }
        let u0:i32=q2;
        while(u0<ll && ((low[u0] as i32)==32 || (low[u0] as i32)==45)){u0=u0+1;}
        let um:i64=0;
        let nw0:i32=-1;
        let nw1:i32=0;
        if(tscale==0 && u0<ll && (low[u0] as i32)>=97 && (low[u0] as i32)<=122){
            let r3:i32=u0;
            while(r3<ll){let c5:i32=low[r3] as i32;if(c5<97 || c5>122){break;}r3=r3+1;}
            nw0=u0;
            nw1=r3;
            um=umul(low[u0..r3]);
            if(um==0){
                tscale=temp_scale_word(low[u0..r3]);
                if(tscale==4){
                    // bare "degrees": peek the next word for an explicit scale
                    let w0:i32=r3;
                    while(w0<ll && (low[w0] as i32)==32){w0=w0+1;}
                    if(w0<ll && (low[w0] as i32)>=97 && (low[w0] as i32)<=122){
                        let w1:i32=w0;
                        while(w1<ll){let c7:i32=low[w1] as i32;if(c7<97 || c7>122){break;}w1=w1+1;}
                        let ts2:i32=temp_scale_word(low[w0..w1]);
                        if(ts2>=1 && ts2<=3){tscale=ts2;r3=w1;}
                    }
                }
            }
            q2=r3;
            // percent words -> percent unit class (uc=3)
            if(z_eq(low[u0..r3],"percent")==1 || z_eq(low[u0..r3],"percentage")==1){pctu=1;}
            else{
                // speed units: "<length> per second" / "<length>/s" ->
                // canonical m/s (uc=4)
                if(um==0){
                    let sbase:i64=0;
                    let uw:[]u8=low[u0..r3];
                    if(z_eq(uw,"kilometer")==1 || z_eq(uw,"kilometers")==1 || z_eq(uw,"kilometre")==1 || z_eq(uw,"kilometres")==1 || z_eq(uw,"km")==1){sbase=1000;}
                    else{if(z_eq(uw,"meter")==1 || z_eq(uw,"meters")==1 || z_eq(uw,"metre")==1 || z_eq(uw,"metres")==1 || z_eq(uw,"m")==1){sbase=1;}}
                    if(sbase>0){
                        let s0:i32=r3;
                        while(s0<ll && (low[s0] as i32)==32){s0=s0+1;}
                        if(match_at(low,s0,"per second")==1){spd=sbase;q2=s0+10;}
                        else{
                            if(s0<ll && (low[s0] as i32)==47){
                                let s1:i32=s0+1;
                                if(s1<ll && (low[s1] as i32)==115){spd=sbase;q2=s1+1;}
                            }
                        }
                    }
                }
            }
        }else{
            if(tscale==0){
                // degree-sign units: °C °F °K
                if(u0+2<ll && (low[u0] as i32)==194 && (low[u0+1] as i32)==176){
                    let dc:i32=low[u0+2] as i32;
                    if(dc==99){tscale=1;q2=u0+3;}
                    else{
                        if(dc==102){tscale=2;q2=u0+3;}
                        else{if(dc==107){tscale=3;q2=u0+3;}}
                    }
                }
                // percent sign: "10%"
                if(pctu==0 && spd==0 && u0<ll && (low[u0] as i32)==37){pctu=1;q2=u0+1;}
            }
        }
        let lo:i64=v;
        let hi:i64=v;
        if(isrng==1){
            if(v2<v){lo=v2;hi=v;}
            else{lo=v;hi=v2;}
        }
        let uc:i32=0;
        let amb:i32=0;
        if(pctu==1){
            uc=3;
        }else{
            if(spd>0){
                uc=4;
                if(lo>66000){lo=2000000000;}else{lo=lo*spd;}
                if(hi>66000){hi=2000000000;}else{hi=hi*spd;}
                if(lo>2000000000){lo=2000000000;}
                if(hi>2000000000){hi=2000000000;}
            }else{
                if(um>0){
                    uc=1;
                    if(lo>66000){lo=2000000000;}else{lo=lo*um;}
                    if(hi>66000){hi=2000000000;}else{hi=hi*um;}
                    if(lo>2000000000){lo=2000000000;}
                    if(hi>2000000000){hi=2000000000;}
                }else{
                    if(tscale>0){
                        uc=2;
                        if(tscale==4){amb=1;}
                        else{lo=temp_canon(lo,tscale);hi=temp_canon(hi,tscale);}
                    }
                }
            }
        }
        // complement filter: "the other 90 percent" is the complement of
        // the claim's value, not a competing value
        let ca0:i32=p-25;
        if(ca0<0){ca0=0;}
        if(has_word_in(low,ca0,p,"other")==1){p=q2;continue;}
        if(has_word_in(low,ca0,p,"another")==1){p=q2;continue;}
        if(has_word_in(low,ca0,p,"remaining")==1){p=q2;continue;}
        // same-quantity gate: skip evidence numbers sitting in a
        // conflicting-phenomenon window (freezing vs boiling)
        if(qphenom!=0){
            let wa:i32=p-60;
            if(wa<0){wa=0;}
            let wb:i32=q2+60;
            if(wb>ll){wb=ll;}
            let hB:i32=phenom_words_in(low,wa,wb,1);
            let hF:i32=phenom_words_in(low,wa,wb,2);
            if(qphenom==1 && hF==1 && hB==0){p=q2;continue;}
            if(qphenom==2 && hB==1 && hF==0){p=q2;continue;}
        }
        // same-entity gate: skip evidence numbers whose nearest entity
        // marker is animal/plant when the claim is about humans
        if(qent==1){
            let wa2:i32=p-60;
            if(wa2<0){wa2=0;}
            let wb2:i32=q2+60;
            if(wb2>ll){wb2=ll;}
            let dh:i32=ent_nearest(low,wa2,wb2,p,1);
            let da:i32=ent_nearest(low,wa2,wb2,p,2);
            if(da<dh){p=q2;continue;}
        }
        a_put(eA,n,lo as i32);
        a_put(eB,n,hi as i32);
        a_put(eC,n,uc);
        let fl:i32=ap;
        if(amb==1){fl=fl|2;}
        a_put(eD,n,fl);
        // quantity-noun hash for unitless entries ("10 percent" vs
        // "twenty-thousandth decimal place" are different quantities);
        // single-letter nouns ("m") count as unmarked
        let nh:i32=0;
        if(uc==0 && nw0>=0){nh=noun_hash(low,nw0,nw1);}
        a_put(eE,n,nh);
        n=n+1;
        p=q2;
    }
    z_free(eposb);
    z_free(low);
    return n;
}
fn cmp_entry(elo:i32,ehi:i32,eap:i32,eamb:i32,euc:i32,enh:i32,cv:i32,cu:i32,cap:i32,camb:i32,cnh:i32)i32{
    if(euc!=cu){return 0;}
    if(cu==0){
        if(enh!=0 && cnh!=0 && enh!=cnh){return 0;}
    }
    if(cu==2){
        if(temp_compat(elo,ehi,eap,eamb,cv,cap,camb)==1){return 1;}
        return 2;
    }
    let ap:i32=0;
    if(eap==1 || cap==1){ap=1;}
    if(band_ok(elo,ehi,ap,cv)==1){return 1;}
    return 2;
}
fn find_pivot(s:[]u8,ll:i32)i32{
    let i:i32=0;
    while(i<ll){
        if(i+3<=ll && match_at(s,i,"but")==1){return i;}
        if(i+7<=ll && match_at(s,i,"however")==1){return i;}
        if(i+8<=ll && match_at(s,i,"actually")==1){return i;}
        if(i+3<=ll && match_at(s,i,"now")==1){return i;}
        if(i+8<=ll && match_at(s,i,"tells us")==1){return i;}
        i=i+1;
    }
    return -1;
}
fn has_marker(s:[]u8,a:i32,b:i32)i32{
    if(has_word_in(s,a,b,"just")==1){return 1;}
    if(has_word_in(s,a,b,"learned that")==1){return 1;}
    if(has_word_in(s,a,b,"traditional answer")==1){return 1;}
    if(has_word_in(s,a,b,"used to think")==1){return 1;}
    return 0;
}
fn scan_ev_text(t:[]u8,ea:[]u8,ne:i32,qphenom:i32,qent:i32,eb:[]u8,cv:i32,cu:i32,cap:i32,camb:i32,cnh:i32)i32{
    let lt:[]u8=z_alloc(t.len+1);
    if(lt.len==0){
        return ev_scan(t,ea[0..64],ea[64..128],ea[128..192],ea[192..256],ea[256..320],ne,16,qphenom,qent);
    }
    let ll:i32=lower_copy(t,lt);
    let low:[]u8=lt[0..ll];
    let eff0:i32=0;
    let piv:i32=find_pivot(low,ll);
    if(piv>=0 && has_marker(low,0,piv)==1){
        let pn:i32=ev_scan(t[0..piv],eb[0..64],eb[64..128],eb[128..192],eb[192..256],eb[256..320],0,16,qphenom,qent);
        let preh:i32=0;
        let e:i32=0;
        while(e<pn){
            let efl:i32=a_get(eb[192..256],e);
            let r:i32=cmp_entry(a_get(eb,e),a_get(eb[64..128],e),efl & 1,(efl>>1) & 1,a_get(eb[128..192],e),a_get(eb[256..320],e),cv,cu,cap,camb,cnh);
            if(r==1){preh=1;}
            e=e+1;
        }
        let qn:i32=ev_scan(t[piv..ll],eb[0..64],eb[64..128],eb[128..192],eb[192..256],eb[256..320],0,16,qphenom,qent);
        let postd:i32=0;
        e=0;
        while(e<qn){
            let efl2:i32=a_get(eb[192..256],e);
            let r2:i32=cmp_entry(a_get(eb,e),a_get(eb[64..128],e),efl2 & 1,(efl2>>1) & 1,a_get(eb[128..192],e),a_get(eb[256..320],e),cv,cu,cap,camb,cnh);
            if(r2==2){postd=1;}
            e=e+1;
        }
        if(preh==1 && postd==1){eff0=piv;}
    }
    z_free(lt);
    return ev_scan(t[eff0..ll],ea[0..64],ea[64..128],ea[128..192],ea[192..256],ea[256..320],ne,16,qphenom,qent);
}
// Check if a bound phrase in the claim ("at least N", "at most N",
// "fewer than N", "more than N") is satisfied by a number in the evidence.
// Returns 1 if satisfied (compatible), 0 otherwise.
fn bound_satisfied(claim:[]u8,title:[]u8,snip:[]u8)i32{
    // Lowercase claim and find bound phrase
    let lc:[]u8=z_alloc(claim.len+1);
    if(lc.len==0){return 0;}
    let lcl:i32=lower_copy(claim,lc);
    let low:[]u8=lc[0..lcl];
    // Find bound type and value
    // 1=at least (>=), 2=at most (<=), 3=fewer than (<), 4=more than (>)
    // ("only N" = at most N)
    let btype:i32=0;
    let bval:i32=-1;
    let bi:i32=0;
    while(bi+8<lcl){
        if(match_at(low,bi,"at least")==1){
            btype=1;
            let ni:i32=bi+9;
            bval=parse_num_at(low,ni,lcl);
            break;
        }
        if(match_at(low,bi,"at most")==1){
            btype=2;
            let ni2:i32=bi+8;
            bval=parse_num_at(low,ni2,lcl);
            break;
        }
        if(match_at(low,bi,"fewer than")==1){
            btype=3;
            let ni3:i32=bi+11;
            bval=parse_num_at(low,ni3,lcl);
            break;
        }
        if(match_at(low,bi,"more than")==1){
            btype=4;
            let ni4:i32=bi+10;
            bval=parse_num_at(low,ni4,lcl);
            break;
        }
        if(match_at(low,bi,"only")==1){
            btype=2;
            let ni5:i32=bi+4;
            bval=parse_num_at(low,ni5,lcl);
            if(bval>=0){break;}
            btype=0;
        }
        // round-5: additional bound phrases (checked with length guards;
        // match_at reads w.len bytes past bi)
        if(bi+12<lcl && match_at(low,bi,"no more than")==1){
            btype=2;
            bval=parse_num_at(low,bi+12,lcl);
            if(bval>=0){break;}
            btype=0;
        }
        if(bi+13<lcl && match_at(low,bi,"no fewer than")==1){
            btype=1;
            bval=parse_num_at(low,bi+13,lcl);
            if(bval>=0){break;}
            btype=0;
        }
        if(bi+5<lcl && match_at(low,bi,"up to")==1){
            btype=2;
            bval=parse_num_at(low,bi+5,lcl);
            if(bval>=0){break;}
            btype=0;
        }
        if(bi+12<lcl && match_at(low,bi,"at a minimum")==1){
            btype=1;
            bval=parse_num_at(low,bi+12,lcl);
            if(bval>=0){break;}
            btype=0;
        }
        bi=bi+1;
    }
    z_free(lc);
    if(btype==0 || bval<0){return 0;}
    // Find numbers in evidence (title + snip)
    if(ev_has_satisfying(title,btype,bval)==1){return 1;}
    if(ev_has_satisfying(snip,btype,bval)==1){return 1;}
    return 0;
}

// Fraction words -> percent value (0-100), or -1. Sets epos[0] past the
// fraction. Handles "half", "a quarter", "three-quarters", "two thirds".
fn frac_pct(low:[]u8,p:i32,ll:i32,epos:[]u8)i32{
    a_put(epos,0,p);
    let num:i32=1;
    let pos:i32=p;
    if(pos<ll && (low[pos] as i32)>=97 && (low[pos] as i32)<=122){
        let r:i32=pos;
        while(r<ll){let c2:i32=low[r] as i32;if(c2<97 || c2>122){break;}r=r+1;}
        let w:[]u8=low[pos..r];
        if(z_eq(w,"a")==1 || z_eq(w,"an")==1 || z_eq(w,"one")==1){num=1;pos=r;}
        else{
            let wv:i32=wnum(w);
            if(wv>0 && wv<=100){num=wv;pos=r;}
            else{return -1;}
        }
        if(pos<ll && (low[pos] as i32)==45){pos=pos+1;}
        while(pos<ll && (low[pos] as i32)==32){pos=pos+1;}
    }
    if(pos>=ll || (low[pos] as i32)<97 || (low[pos] as i32)>122){return -1;}
    let r2:i32=pos;
    while(r2<ll){let c3:i32=low[r2] as i32;if(c3<97 || c3>122){break;}r2=r2+1;}
    let d:[]u8=low[pos..r2];
    let den:i32=0;
    if(z_eq(d,"half")==1 || z_eq(d,"halves")==1){den=2;}
    else{if(z_eq(d,"third")==1 || z_eq(d,"thirds")==1){den=3;}
    else{if(z_eq(d,"quarter")==1 || z_eq(d,"quarters")==1){den=4;}
    else{if(z_eq(d,"fifth")==1 || z_eq(d,"fifths")==1){den=5;}
    else{if(z_eq(d,"tenth")==1 || z_eq(d,"tenths")==1){den=10;}
    else{return -1;}}}}}
    if(den==0){return -1;}
    a_put(epos,0,r2);
    return (num*100)/den;
}

// Parse a number (digit or word, possibly compound) at position i in s
// (s must be lowercased). Returns -1 if none.
fn parse_num_at(s:[]u8,i:i32,n:i32)i32{
    // skip spaces
    while(i<n && (s[i] as i32)==32){i=i+1;}
    if(i>=n){return -1;}
    // digit?
    if(z_isdig(s[i] as i32)==1){
        let v:i32=0;
        while(i<n && z_isdig(s[i] as i32)==1){
            v=v*10+((s[i] as i32)-48);
            i=i+1;
        }
        return v;
    }
    // word number (possibly compound: "ten thousand")?
    let epos:[]u8=z_alloc(8);
    if(epos.len==0){return -1;}
    // fraction word ("three-quarters", "half")?
    let fp:i32=frac_pct(s,i,n,epos);
    if(fp>=0){z_free(epos);return fp;}
    let vv:i64=wnum_seq(s,i,n,epos);
    z_free(epos);
    if(vv<0 || vv>2000000000){return -1;}
    return vv as i32;
}

// Check if evidence text contains a number satisfying the bound.
fn ev_has_satisfying(t:[]u8,btype:i32,bval:i32)i32{
    let lt:[]u8=z_alloc(t.len+1);
    if(lt.len==0){return 0;}
    let ll:i32=lower_copy(t,lt);
    let low:[]u8=lt[0..ll];
    let epos:[]u8=z_alloc(8);
    if(epos.len==0){z_free(lt);return 0;}
    let i:i32=0;
    while(i<ll){
        let v:i32=-1;
        if(z_isdig(low[i] as i32)==1){
            v=0;
            while(i<ll && z_isdig(low[i] as i32)==1){
                v=v*10+((low[i] as i32)-48);
                i=i+1;
            }
        }else{
            // try fraction word, then compound word number
            if((low[i] as i32)>=97 && (low[i] as i32)<=122){
                let fp2:i32=frac_pct(low,i,ll,epos);
                let qe:i32=a_get(epos,0);
                if(fp2>=0){v=fp2;i=qe;}
                else{
                    let vv:i64=wnum_seq(low,i,ll,epos);
                    qe=a_get(epos,0);
                    if(vv<0){qe=i+1;}
                    else{if(vv<=2000000000){v=vv as i32;}}
                    i=qe;
                }
            }else{i=i+1;}
        }
        if(v>=0){
            if(btype==1 && v>=bval){z_free(epos);z_free(lt);return 1;}
            if(btype==2 && v<=bval){z_free(epos);z_free(lt);return 1;}
            if(btype==3 && v<bval){z_free(epos);z_free(lt);return 1;}
            if(btype==4 && v>bval){z_free(epos);z_free(lt);return 1;}
            if(btype==5 && v==bval){z_free(epos);z_free(lt);return 1;}
        }
    }
    z_free(epos);
    z_free(lt);
    return 0;
}

// ==================== R3 decision helpers ====================
// 1 if the text contains any positive number, else 0.
fn has_positive_number(t:[]u8)i32{
    let a:[]u8=z_alloc(16);
    let b:[]u8=z_alloc(16);
    let c:[]u8=z_alloc(16);
    let d:[]u8=z_alloc(16);
    let e:[]u8=z_alloc(16);
    if(a.len==0 || b.len==0 || c.len==0 || d.len==0 || e.len==0){
        z_free(a);z_free(b);z_free(c);z_free(d);z_free(e);
        return 0;
    }
    let n:i32=ev_scan(t,a,b,c,d,e,0,4,0,0);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
        if(a_get(a,k)>0){hit=1;break;}
        k=k+1;
    }
    z_free(a);z_free(b);z_free(c);z_free(d);z_free(e);
    return hit;
}
// Claim century: "<ordinal> century" -> century number, else 0.
fn claim_century(claim:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    if(ar.len==0){return 0;}
    let nt:i32=z_toks(claim,ar,128);
    let tmp:[]u8=z_alloc(64);
    if(tmp.len==0){z_free(ar);return 0;}
    let cc:i32=0;
    let j:i32=0;
    while(j+1<nt && cc==0){
        let o2:i32=a_get(ar,2*(j+1));
        let l2:i32=a_get(ar,2*(j+1)+1);
        let ll2:i32=lower_copy(claim[o2..o2+l2],tmp);
        if(z_eq(tmp[0..ll2],"century")==1 || z_eq(tmp[0..ll2],"centuries")==1){
            let o1:i32=a_get(ar,2*j);
            let l1:i32=a_get(ar,2*j+1);
            let ll1:i32=lower_copy(claim[o1..o1+l1],tmp);
            cc=ordinal_word(tmp[0..ll1]);
            if(cc==0){cc=digit_ordinal(tmp[0..ll1]);}
        }
        j=j+1;
    }
    z_free(ar);z_free(tmp);
    return cc;
}
// Evidence century: 4-digit year (digits or words) -> century;
// else "<ordinal> century". 0 if none.
fn evidence_century(t:[]u8)i32{
    let low:[]u8=z_alloc(t.len+1);
    if(low.len==0){return 0;}
    let ll:i32=lower_copy(t,low);
    let epos:[]u8=z_alloc(8);
    if(epos.len==0){z_free(low);return 0;}
    let ec:i32=0;
    let i:i32=0;
    while(i<ll && ec==0){
        let c:i32=low[i] as i32;
        if(z_isdig(c)==1){
            let v:i32=0;
            let jj:i32=i;
            while(jj<ll && z_isdig(low[jj] as i32)==1){
                v=v*10+((low[jj] as i32)-48);
                jj=jj+1;
            }
            if(v>=1000 && v<=2099){ec=(v-1)/100+1;}
            i=jj;
        }else{
            if(c>=97 && c<=122){
                let vv:i64=wnum_seq(low,i,ll,epos);
                let qe:i32=a_get(epos,0);
                if(vv<0){qe=i+1;}
                else{
                    if(vv>=1000 && vv<=2099){ec=((vv as i32)-1)/100+1;}
                }
                i=qe;
            }else{i=i+1;}
        }
    }
    z_free(epos);
    if(ec==0){ec=claim_century(t);}
    z_free(low);
    return ec;
}
// Year->century check: 1 affirm-signal, 2 deny, 0 abstain.
fn century_check(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let cc:i32=claim_century(claim);
    if(cc==0){return 0;}
    let ec:i32=evidence_century(title);
    if(ec==0){ec=evidence_century(snip);}
    if(ec==0){return 0;}
    let ar:[]u8=z_alloc(512);
    if(ar.len==0){return 0;}
    let nt:i32=z_toks(claim,ar,64);
    // r7c: 32->128 (pre-existing crash on tokens >=33 chars).
    let tmp:[]u8=z_alloc(128);
    if(tmp.len==0){z_free(ar);return 0;}
    let neg:i32=0;
    let j:i32=0;
    while(j<nt && neg==0){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"not")==1 || z_eq(tmp[0..ll],"never")==1){neg=1;}
        else{
            if(ll>3 && z_eq(tmp[ll-3..ll],"n't")==1){neg=1;}
        }
        j=j+1;
    }
    z_free(ar);z_free(tmp);
    if(neg==1){
        if(ec!=cc){return 1;}
        return 2;
    }
    if(ec==cc){return 1;}
    return 2;
}
// Textual frequency markers: "N times", "dozens/hundreds of times",
// "repeatedly/often/frequently/...", "every <timeunit>".
fn has_frequency(t:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    if(ar.len==0){return 0;}
    let nt:i32=z_toks(t,ar,128);
    let tmp:[]u8=z_alloc(64);
    if(tmp.len==0){z_free(ar);return 0;}
    let hit:i32=0;
    let j:i32=0;
    while(j<nt && hit==0){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(t[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(z_eq(w,"times")==1){
            let k:i32=j-1;
            while(k>=0 && k>=j-2){
                let ko:i32=a_get(ar,2*k);
                let kl:i32=a_get(ar,2*k+1);
                let kll:i32=lower_copy(t[ko..ko+kl],tmp);
                let kw:[]u8=tmp[0..kll];
                if(kll>0 && z_isdig(kw[0] as i32)==1){hit=1;break;}
                if(wnum(kw)>0){hit=1;break;}
                if(z_eq(kw,"dozens")==1 || z_eq(kw,"hundreds")==1 || z_eq(kw,"thousands")==1 || z_eq(kw,"millions")==1){hit=1;break;}
                if(z_eq(kw,"many")==1 || z_eq(kw,"several")==1 || z_eq(kw,"multiple")==1 || z_eq(kw,"numerous")==1 || z_eq(kw,"countless")==1){hit=1;break;}
                k=k-1;
            }
        }else{
            if(z_eq(w,"repeatedly")==1 || z_eq(w,"often")==1 || z_eq(w,"frequently")==1 || z_eq(w,"regularly")==1 || z_eq(w,"constantly")==1 || z_eq(w,"daily")==1 || z_eq(w,"always")==1){hit=1;}
            else{
                if(z_eq(w,"every")==1 && j+1<nt){
                    let eo:i32=a_get(ar,2*(j+1));
                    let el:i32=a_get(ar,2*(j+1)+1);
                    let ell:i32=lower_copy(t[eo..eo+el],tmp);
                    let ew:[]u8=tmp[0..ell];
                    if(z_eq(ew,"day")==1 || z_eq(ew,"week")==1 || z_eq(ew,"month")==1 || z_eq(ew,"year")==1 || z_eq(ew,"hour")==1 || z_eq(ew,"minute")==1 || z_eq(ew,"second")==1 || z_eq(ew,"morning")==1 || z_eq(ew,"night")==1){hit=1;}
                }
            }
        }
        j=j+1;
    }
    z_free(ar);z_free(tmp);
    return hit;
}
// "X never P" contradicted by evidence of repeated P. 1 deny, 0 abstain.
fn never_falsified(claim:[]u8,title:[]u8,snip:[]u8,pred:[]u8,subjA:[]u8)i32{
    if(pred.len==0 || subjA.len==0){return 0;}
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    let csb:[]u8=z_alloc(512);
    let csr:[]u8=z_alloc(512);
    if(ar.len==0 || tmp.len==0 || out.len==0 || vb.len==0 || csb.len==0 || csr.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(csb);z_free(csr);
        return 0;
    }
    let nt:i32=z_toks(claim,ar,128);
    let hnever:i32=0;
    let ncs2:i32=0;
    let coff:i32=0;
    let j:i32=0;
    while(j<nt){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"never")==1){hnever=1;}
        if(ll>3 && in_list(tmp[0..ll],lex_stop())==0){
            let sl:i32=z_stem(claim[to..to+tl],out,tmp,vb);
            if(sl>0 && coff+sl<=512 && ncs2<64){
                let qq:i32=0;
                while(qq<sl){csb[coff+qq]=out[qq];qq=qq+1;}
                a_put(csr,2*ncs2,coff);
                a_put(csr,2*ncs2+1,sl);
                coff=coff+sl;
                ncs2=ncs2+1;
            }
        }
        j=j+1;
    }
    z_free(ar);
    if(hnever==0){
        z_free(tmp);z_free(out);z_free(vb);z_free(csb);z_free(csr);
        return 0;
    }
    let pb:[]u8=irreg(pred);
    let hit:i32=0;
    let ti:i32=0;
    while(ti<2 && hit==0){
        let tx:[]u8=title;
        if(ti==1){tx=snip;}
        if(has_frequency(tx)==1){
            let ar2:[]u8=z_alloc(2048);
            if(ar2.len>0){
                let nt2:i32=z_toks(tx,ar2,256);
                let k:i32=0;
                let poverlap:i32=0;
                let cmatch:i32=0;
                while(k<nt2 && poverlap==0){
                    let ko:i32=a_get(ar2,2*k);
                    let kl:i32=a_get(ar2,2*k+1);
                    let kll:i32=lower_copy(tx[ko..ko+kl],tmp);
                    if(kll>0 && in_list(tmp[0..kll],lex_stop())==0){
                        let sl:i32=z_stem(tx[ko..ko+kl],out,tmp,vb);
                        if(sl>0){
                            let es:[]u8=out[0..sl];
                            if(z_eq(es,pred)==1 || z_eq(irreg(es),pb)==1 || z_eq(es,irreg(pred))==1){poverlap=1;}
                            else{
                                let m:i32=0;
                                while(m<ncs2){
                                    let mo:i32=a_get(csr,2*m);
                                    let ml:i32=a_get(csr,2*m+1);
                                    if(z_eq(es,csb[mo..mo+ml])==1){cmatch=cmatch+1;break;}
                                    m=m+1;
                                }
                            }
                        }
                    }
                    k=k+1;
                }
                z_free(ar2);
                if(poverlap==1 || cmatch>=2){hit=1;}
            }
        }
        ti=ti+1;
    }
    z_free(tmp);z_free(out);z_free(vb);z_free(csb);z_free(csr);
    return hit;
}
// stem length of first non-stop token at index >= from; stem in out.
fn first_content_stem(t:[]u8,ar:[]u8,nt:i32,from:i32,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let j:i32=from;
    while(j<nt){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(t[to..to+tl],tmp);
        if(ll>0 && in_list(tmp[0..ll],lex_stop())==0){
            return z_stem(t[to..to+tl],out,tmp,vb);
        }
        j=j+1;
    }
    return 0;
}
// Attribute speed entries (canonical m/s) in t to the nearer of the subject
// stems sa/sb. oa[0]/ob[0] = value or -1.
fn speed_vals(t:[]u8,sa:[]u8,sb:[]u8,oa:[]u8,ob:[]u8)void{
    a_put(oa,0,-1);
    a_put(ob,0,-1);
    let low:[]u8=z_alloc(t.len+1);
    if(low.len==0){return;}
    let ll:i32=lower_copy(t,low);
    let epos:[]u8=z_alloc(8);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    let ev:[]u8=z_alloc(64);
    let ep:[]u8=z_alloc(64);
    let tar:[]u8=z_alloc(1024);
    let tsb:[]u8=z_alloc(4096);
    let tsr:[]u8=z_alloc(1536);
    if(epos.len==0 || tmp.len==0 || out.len==0 || vb.len==0 || ev.len==0 || ep.len==0 || tar.len==0 || tsb.len==0 || tsr.len==0){
        z_free(low);z_free(epos);z_free(tmp);z_free(out);z_free(vb);
        z_free(ev);z_free(ep);z_free(tar);z_free(tsb);z_free(tsr);
        return;
    }
    // speed entries: value + char pos, up to 16
    let ne:i32=0;
    let i:i32=0;
    while(i<ll && ne<16){
        let c:i32=low[i] as i32;
        let v:i64=-1;
        let q:i32=i;
        if(z_isdig(c)==1){
            v=0;
            q=i;
            while(q<ll && z_isdig(low[q] as i32)==1){
                v=v*10+((low[q] as i32)-48);
                if(v>2000000000){v=2000000000;}
                q=q+1;
            }
        }else{
            if(c>=97 && c<=122){
                v=wnum_seq(low,i,ll,epos);
                q=a_get(epos,0);
                if(v<0){i=i+1;continue;}
            }else{i=i+1;continue;}
        }
        let s0:i32=q;
        while(s0<ll && (low[s0] as i32)==32){s0=s0+1;}
        let sbase:i64=0;
        let r3:i32=s0;
        if(s0<ll && (low[s0] as i32)>=97 && (low[s0] as i32)<=122){
            while(r3<ll){let c5:i32=low[r3] as i32;if(c5<97 || c5>122){break;}r3=r3+1;}
            let uw:[]u8=low[s0..r3];
            if(z_eq(uw,"kilometer")==1 || z_eq(uw,"kilometers")==1 || z_eq(uw,"kilometre")==1 || z_eq(uw,"kilometres")==1 || z_eq(uw,"km")==1){sbase=1000;}
            else{if(z_eq(uw,"meter")==1 || z_eq(uw,"meters")==1 || z_eq(uw,"metre")==1 || z_eq(uw,"metres")==1 || z_eq(uw,"m")==1){sbase=1;}}
        }
        let qe:i32=-1;
        if(sbase>0){
            let p0:i32=r3;
            while(p0<ll && (low[p0] as i32)==32){p0=p0+1;}
            if(match_at(low,p0,"per second")==1){qe=p0+10;}
            else{
                if(p0<ll && (low[p0] as i32)==47 && p0+1<ll && (low[p0+1] as i32)==115){qe=p0+2;}
            }
        }
        if(qe<0){i=q;continue;}
        let cvv:i64=v*sbase;
        if(cvv>2000000000){cvv=2000000000;}
        a_put(ev,ne,cvv as i32);
        a_put(ep,ne,i);
        ne=ne+1;
        i=qe;
    }
    // content token stems + char positions, up to 128
    let nt2:i32=z_toks(low,tar,128);
    let nst:i32=0;
    let soff:i32=0;
    let k:i32=0;
    while(k<nt2 && nst<128){
        let ko:i32=a_get(tar,2*k);
        let kl:i32=a_get(tar,2*k+1);
        let kll:i32=lower_copy(low[ko..ko+kl],tmp);
        if(kll>0 && in_list(tmp[0..kll],lex_stop())==0){
            let sl:i32=z_stem(low[ko..ko+kl],out,tmp,vb);
            if(sl>0 && soff+sl<=4096){
                let qq:i32=0;
                while(qq<sl){tsb[soff+qq]=out[qq];qq=qq+1;}
                a_put(tsr,3*nst,soff);
                a_put(tsr,3*nst+1,sl);
                a_put(tsr,3*nst+2,ko);
                nst=nst+1;
                soff=soff+sl;
            }
        }
        k=k+1;
    }
    // attribute each subject to its nearest entry (nearest mention wins)
    let s2:i32=0;
    while(s2<2){
        let subj:[]u8=sa;
        let oo:[]u8=oa;
        let osubj:[]u8=sb;
        if(s2==1){subj=sb;oo=ob;osubj=sa;}
        let beste:i32=-1;
        let bestd:i32=2000000000;
        let e2:i32=0;
        while(e2<ne){
            let epos2:i32=a_get(ep,e2);
            let dsub:i32=2000000000;
            let doth:i32=2000000000;
            let m:i32=0;
            while(m<nst){
                let mo:i32=a_get(tsr,3*m);
                let ml:i32=a_get(tsr,3*m+1);
                let mp:i32=a_get(tsr,3*m+2);
                let dd:i32=epos2-mp;
                if(dd<0){dd=0-dd;}
                if(z_eq(tsb[mo..mo+ml],subj)==1 && dd<dsub){dsub=dd;}
                if(z_eq(tsb[mo..mo+ml],osubj)==1 && dd<doth){doth=dd;}
                m=m+1;
            }
            if(dsub<bestd && dsub<doth){
                bestd=dsub;
                beste=e2;
            }
            e2=e2+1;
        }
        if(beste>=0){a_put(oo,0,a_get(ev,beste));}
        s2=s2+1;
    }
    z_free(low);z_free(epos);z_free(tmp);z_free(out);z_free(vb);
    z_free(ev);z_free(ep);z_free(tar);z_free(tsb);z_free(tsr);
    return;
}
// "A is <comparative> than B" vs measured speeds: 2 deny, 0 abstain.
fn comparative_numeric(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    if(ar.len==0){return 0;}
    let nt:i32=z_toks(claim,ar,128);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    if(tmp.len==0 || out.len==0 || vb.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let ci:i32=-1;
    let dir:i32=0;
    let ti2:i32=-1;
    let j:i32=0;
    while(j<nt && ci<0){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        let d:i32=comp_dir(tmp[0..ll]);
        if(d!=0){
            let k:i32=j+1;
            while(k<nt && k<=j+4){
                let ko:i32=a_get(ar,2*k);
                let kl:i32=a_get(ar,2*k+1);
                let kll:i32=lower_copy(claim[ko..ko+kl],tmp);
                if(z_eq(tmp[0..kll],"than")==1){ci=j;dir=d;ti2=k;break;}
                k=k+1;
            }
        }
        j=j+1;
    }
    if(ci<0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let sa:[]u8=z_alloc(32);
    let sb:[]u8=z_alloc(32);
    if(sa.len==0 || sb.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(sa);z_free(sb);
        return 0;
    }
    let sal:i32=first_content_stem(claim,ar,nt,0,tmp,sa,vb);
    let sbl:i32=first_content_stem(claim,ar,nt,ti2+1,tmp,sb,vb);
    z_free(ar);
    if(sal<=0 || sbl<=0){
        z_free(tmp);z_free(out);z_free(vb);z_free(sa);z_free(sb);
        return 0;
    }
    let oa:[]u8=z_alloc(8);
    let ob:[]u8=z_alloc(8);
    if(oa.len==0 || ob.len==0){
        z_free(tmp);z_free(out);z_free(vb);z_free(sa);z_free(sb);z_free(oa);z_free(ob);
        return 0;
    }
    speed_vals(title,sa[0..sal],sb[0..sbl],oa,ob);
    let va:i32=a_get(oa,0);
    let vbv:i32=a_get(ob,0);
    if(va<0 || vbv<0){
        let oc:[]u8=z_alloc(8);
        let od:[]u8=z_alloc(8);
        if(oc.len>0 && od.len>0){
            speed_vals(snip,sa[0..sal],sb[0..sbl],oc,od);
            if(va<0){va=a_get(oc,0);}
            if(vbv<0){vbv=a_get(od,0);}
        }
        z_free(oc);z_free(od);
    }
    z_free(tmp);z_free(out);z_free(vb);z_free(sa);z_free(sb);z_free(oa);z_free(ob);
    if(va<0 || vbv<0){return 0;}
    if(dir>0){
        if(va<=vbv){return 2;}
        return 0;
    }
    if(va>=vbv){return 2;}
    return 0;
}
// 1 if the claim opens with a zero quantifier and contains a negated verb
// with a positive antonym ("No student failed").
fn is_polflip_claim(claim:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    if(ar.len==0){return 0;}
    let nt:i32=z_toks(claim,ar,64);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    if(tmp.len==0 || out.len==0 || vb.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let hit:i32=0;
    if(nt>0){
        let to:i32=a_get(ar,0);
        let tl:i32=a_get(ar,1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        let w0:[]u8=tmp[0..ll];
        if(z_eq(w0,"no")==1 || z_eq(w0,"none")==1 || z_eq(w0,"nobody")==1 || z_eq(w0,"nothing")==1 || z_eq(w0,"neither")==1){
            let j:i32=1;
            while(j<nt && hit==0){
                let jo:i32=a_get(ar,2*j);
                let jl:i32=a_get(ar,2*j+1);
                let sl:i32=z_stem(claim[jo..jo+jl],out,tmp,vb);
                if(sl>0 && negverb_antonym(out[0..sl]).len>0){hit=1;}
                j=j+1;
            }
        }
    }
    z_free(ar);z_free(tmp);z_free(out);z_free(vb);
    return hit;
}
// "No X V-ed" vs "Every X W" where W is the antonym of V: the evidence
// asserts the claim's own content ("No student failed" is "Every student
// did-not-fail"; "Every student passed" is "Every student did-not-fail").
// 1 = affirm (the quantifier pair-DENY must not fire), 0 otherwise.
// General mechanism: negated universal + universal evidence whose verb
// is the antonym of the claim's verb -> contradiction of the negation.
fn neg_univ_verb_affirm(claim:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,subjA:[]u8,firstA:[]u8,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    if(ar.len==0){return 0;}
    let nt:i32=z_toks(claim,ar,64);
    let want:[]u8="";
    let j:i32=1;
    while(j<nt){
        let jo:i32=a_get(ar,2*j);
        let jl:i32=a_get(ar,2*j+1);
        let sl:i32=z_stem(claim[jo..jo+jl],out,tmp,vb);
        if(sl>0){
            let ant:[]u8=negverb_antonym(out[0..sl]);
            if(ant.len>0){want=ant;break;}
        }
        j=j+1;
    }
    z_free(ar);
    if(want.len==0){return 0;}
    // the evidence clause must carry the claim's subject and the antonym verb
    let has_subj:i32=0;
    let has_w:i32=0;
    let k:i32=0;
    while(k<nct){
        let so:i32=a_get(cstmC,2*k);
        let sl2:i32=a_get(cstmC,2*k+1);
        let st:[]u8=stemC[so..so+sl2];
        if(z_eq(st,subjA)==1 || z_eq(st,firstA)==1){has_subj=1;}
        if(z_eq(st,want)==1){has_w=1;}
        k=k+1;
    }
    if(has_subj==1 && has_w==1){return 1;}
    return 0;
}
// Contrast-frame recognition: generalizes strip_meta_frame's frame
// concept from claim-leading frames ("Unlike X,", "Contrary to X,") to
// clause-internal contrast frames ("by contrast", "in contrast"). A
// clause carrying such a frame marks its subject as contrasted with the
// claim's subject, so a negation scoping that clause's predicate
// ("copper, by contrast, is not magnetic") does not contradict the
// claim. 1 if the clause contains a standalone contrast frame.
fn clause_contrast_frame(clause:[]u8,tokC:[]u8,nct:i32,tmp:[]u8)i32{
    let i:i32=0;
    while(i+1<nct){
        let o0:i32=a_get(tokC,2*i);
        let l0:i32=a_get(tokC,2*i+1);
        let ll0:i32=lower_copy(clause[o0..o0+l0],tmp);
        let w0c:i32=0;
        if(z_eq(tmp[0..ll0],"by")==1){w0c=1;}
        if(z_eq(tmp[0..ll0],"in")==1){w0c=1;}
        if(w0c==1){
            let o1:i32=a_get(tokC,2*(i+1));
            let l1:i32=a_get(tokC,2*(i+1)+1);
            let ll1:i32=lower_copy(clause[o1..o1+l1],tmp);
            if(z_eq(tmp[0..ll1],"contrast")==1){return 1;}
        }
        i=i+1;
    }
    return 0;
}
// last non-auxiliary verb stem among all claim tokens; length in dst.
fn claim_verb_stem(claim:[]u8,tokA:[]u8,nct:i32,tmp:[]u8,out:[]u8,vb:[]u8,dst:[]u8)i32{
    let best:i32=0;
    let j:i32=0;
    while(j<nct){
        let to:i32=a_get(tokA,2*j);
        let tl:i32=a_get(tokA,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        let sl:i32=z_stem(claim[to..to+tl],out,tmp,vb);
        if(sl>0 && in_list(out[0..sl],lex_verb())==1 && is_auxw(tmp[0..ll])==0){
            let qq:i32=0;
            while(qq<sl && qq<32){dst[qq]=out[qq];qq=qq+1;}
            best=sl;
        }
        j=j+1;
    }
    return best;
}
// ==================== round-5 relation helpers ====================
// Shared small utilities for the round-5 claim-evidence relation fixes.
// All helpers are pure (no globals), deterministic, and allocate only
// short-lived scratch buffers.

// zero-quantifier word test
fn zero_qword(w:[]u8)i32{
    if(z_eq(w,"no")==1){return 1;}
    if(z_eq(w,"none")==1){return 1;}
    if(z_eq(w,"nobody")==1){return 1;}
    if(z_eq(w,"neither")==1){return 1;}
    if(z_eq(w,"nothing")==1){return 1;}
    if(z_eq(w,"nowhere")==1){return 1;}
    return 0;
}

// 1 if token idx of t (lowercased into tmp) is a zero-quantifier word
fn tok_is_zeroq(t:[]u8,tok:[]u8,idx:i32,tmp:[]u8)i32{
    let o:i32=a_get(tok,2*idx);
    let l:i32=a_get(tok,2*idx+1);
    let ll:i32=lower_copy(t[o..o+l],tmp);
    if(ll<=0){return 0;}
    return zero_qword(tmp[0..ll]);
}

// lowercase token idx of t into tw; returns length
fn tok_lc(t:[]u8,tok:[]u8,idx:i32,tw:[]u8)i32{
    let o:i32=a_get(tok,2*idx);
    let l:i32=a_get(tok,2*idx+1);
    return lower_copy(t[o..o+l],tw);
}

// 1 if any raw token of the clause is a hedge word
fn clause_hedged(t:[]u8,tok:[]u8,nct:i32,tmp:[]u8)i32{
    let h:i32=0;
    while(h<nct){
        let ll:i32=tok_lc(t,tok,h,tmp);
        if(ll>0 && in_list(tmp[0..ll],lex_hedge())==1){return 1;}
        h=h+1;
    }
    return 0;
}

// count of tokens from index `from` whose stem is in the (base,ar,n) set
fn shared_stems(t:[]u8,tok:[]u8,nct:i32,from:i32,base:[]u8,ar:[]u8,n:i32,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let sh:i32=0;
    let k:i32=from;
    while(k<nct){
        let ko:i32=a_get(tok,2*k);
        let kl:i32=a_get(tok,2*k+1);
        let sl:i32=z_stem(t[ko..ko+kl],out,tmp,vb);
        if(sl>0 && in_stems(out[0..sl],base,ar,n)==1){sh=sh+1;}
        k=k+1;
    }
    return sh;
}

// fill (base,ar) with stems of non-stop tokens from index `from`; returns count.
// base must have room for 2048 bytes; ar for 8*maxn bytes.
fn build_content_set(t:[]u8,tok:[]u8,nct:i32,from:i32,base:[]u8,ar:[]u8,maxn:i32,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let ncs:i32=0;
    let coff:i32=0;
    let j:i32=from;
    while(j<nct && ncs<maxn){
        let ll:i32=tok_lc(t,tok,j,tmp);
        if(ll>0 && in_list(tmp[0..ll],lex_stop())==0){
            let to:i32=a_get(tok,2*j);
            let tl:i32=a_get(tok,2*j+1);
            let sl:i32=z_stem(t[to..to+tl],out,tmp,vb);
            if(sl>0 && coff+sl<=2048){
                let q:i32=0;
                while(q<sl){base[coff+q]=out[q];q=q+1;}
                a_put(ar,2*ncs,coff);
                a_put(ar,2*ncs+1,sl);
                coff=coff+sl;
                ncs=ncs+1;
            }
        }
        j=j+1;
    }
    return ncs;
}

// 1 if a neg word occurs within `dist` tokens before token k
fn neg_within_before(t:[]u8,tok:[]u8,k:i32,dist:i32,tw:[]u8)i32{
    let m:i32=k-dist;
    if(m<0){m=0;}
    while(m<k){
        let lm:i32=tok_lc(t,tok,m,tw);
        if(lm>0 && is_negword(tw[0..lm])==1){return 1;}
        m=m+1;
    }
    return 0;
}

// neg word including the "cannot"/"can't" forms the tokenizer keeps whole
fn is_negword(w:[]u8)i32{
    if(is_negw(w)==1){return 1;}
    if(z_eq(w,"cannot")==1){return 1;}
    if(z_eq(w,"cant")==1){return 1;}
    return 0;
}

// Zero-quantifier claim confirmed by a zero-quantifier evidence clause
// with the same content ("None of the trials failed" / "None of the
// trials failed."). Yields to zero_quant_deny: positive-instance
// evidence contradicts, it does not confirm. 1 affirm, 0 abstain.
fn zeroquant_affirm(claim:[]u8,title:[]u8,snip:[]u8)i32{
    if(zero_quant_deny(claim,title,snip)==2){return 0;}
    let ar:[]u8=z_alloc(512);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    let csb:[]u8=z_alloc(2048);
    let csr:[]u8=z_alloc(256);
    let clau:[]u8=z_alloc(2048);
    let prot:[]u8=z_alloc(2048);
    let tok:[]u8=z_alloc(1024);
    if(ar.len==0||tmp.len==0||out.len==0||vb.len==0||csb.len==0||csr.len==0||clau.len==0||prot.len==0||tok.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(csb);z_free(csr);
        z_free(clau);z_free(prot);z_free(tok);
        return 0;
    }
    let nct:i32=z_toks(claim,ar,64);
    if(nct<2 || tok_is_zeroq(claim,ar,0,tmp)==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(csb);z_free(csr);
        z_free(clau);z_free(prot);z_free(tok);
        return 0;
    }
    let ncs:i32=build_content_set(claim,ar,nct,1,csb,csr,32,tmp,out,vb);
    if(ncs==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(csb);z_free(csr);
        z_free(clau);z_free(prot);z_free(tok);
        return 0;
    }
    let need:i32=2;
    if(ncs<2){need=1;}
    let hit:i32=0;
    let si:i32=0;
    while(si<2 && hit==0){
        let tx:[]u8=title;
        if(si==1){tx=snip;}
        let ncl:i32=z_clauses(tx,clau,prot,32);
        let c:i32=0;
        while(c<ncl && hit==0){
            let co:i32=a_get(clau,2*c);
            let cl:i32=a_get(clau,2*c+1);
            let clause:[]u8=tx[co..co+cl];
            let nct2:i32=z_toks(clause,tok,128);
            if(nct2>=2 && tok_is_zeroq(clause,tok,0,tmp)==1 && is_interrog(clause,tok,nct2,tmp)==0 && clause_hedged(clause,tok,nct2,tmp)==0){
                let sh:i32=shared_stems(clause,tok,nct2,1,csb,csr,ncs,tmp,out,vb);
                if(sh>=need){hit=1;}
            }
            c=c+1;
        }
        si=si+1;
    }
    z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(csb);z_free(csr);
    z_free(clau);z_free(prot);z_free(tok);
    return hit;
}

// Negated-universal claim supported by a counterexample clause:
// "Not all birds fly" / "Some birds do not fly" / "It is not true that
// all metals are magnetic", confirmed by a clause naming the quantified
// kind X with the predicated property P negated ("Penguins are birds
// that cannot fly", "Copper is a metal and copper is not magnetic").
// 1 affirm, 0 abstain.
fn neguniv_clause_ok(clause:[]u8,X:[]u8,P:[]u8,tok:[]u8,tmp:[]u8,tw:[]u8,out:[]u8,vb:[]u8)i32{
    let nct:i32=z_toks(clause,tok,128);
    if(nct<2){return 0;}
    if(is_interrog(clause,tok,nct,tmp)==1){return 0;}
    if(clause_hedged(clause,tok,nct,tmp)==1){return 0;}
    let xi:i32=0;
    let j:i32=0;
    while(j<nct){
        let ko:i32=a_get(tok,2*j);
        let kl:i32=a_get(tok,2*j+1);
        let sl:i32=z_stem(clause[ko..ko+kl],out,tmp,vb);
        if(sl>0 && z_eq(out[0..sl],X)==1){xi=1;break;}
        j=j+1;
    }
    if(xi==0){return 0;}
    let k:i32=0;
    while(k<nct){
        let ko2:i32=a_get(tok,2*k);
        let kl2:i32=a_get(tok,2*k+1);
        let sl2:i32=z_stem(clause[ko2..ko2+kl2],out,tmp,vb);
        if(sl2>0 && z_eq(out[0..sl2],P)==1 && z_eq(out[0..sl2],X)==0){
            if(neg_within_before(clause,tok,k,3,tw)==1){return 1;}
        }
        k=k+1;
    }
    return 0;
}

fn neguniv_affirm(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    let tw:[]u8=z_alloc(64);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    let xs:[]u8=z_alloc(32);
    let ps:[]u8=z_alloc(32);
    if(ar.len==0||tw.len==0||tmp.len==0||out.len==0||vb.len==0||xs.len==0||ps.len==0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(xs);z_free(ps);
        return 0;
    }
    let low:[]u8=z_alloc(256);
    if(low.len==0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(xs);z_free(ps);
        return 0;
    }
    let lcl:i32=lower_copy(claim,low);
    let lc:[]u8=low[0..lcl];
    let nct:i32=z_toks(claim,ar,64);
    let xsl:i32=0;
    let psl:i32=0;
    // pattern A: "not all|every|each X ..."
    if(nct>=3){
        let l0:i32=tok_lc(claim,ar,0,tw);
        if(z_eq(tw[0..l0],"not")==1){
            let l1:i32=tok_lc(claim,ar,1,tw);
            if(z_eq(tw[0..l1],"all")==1||z_eq(tw[0..l1],"every")==1||z_eq(tw[0..l1],"each")==1){
                let o2:i32=a_get(ar,4);
                let l2:i32=a_get(ar,5);
                xsl=z_stem(claim[o2..o2+l2],xs,tmp,vb);
                let j:i32=3;
                while(j<nct && psl==0){
                    let lj:i32=tok_lc(claim,ar,j,tw);
                    if(lj>0 && in_list(tw[0..lj],lex_stop())==0 && in_list(tw[0..lj],lex_be())==0 && in_list(tw[0..lj],lex_have())==0){
                        let jo:i32=a_get(ar,2*j);
                        let jl:i32=a_get(ar,2*j+1);
                        psl=z_stem(claim[jo..jo+jl],ps,tmp,vb);
                    }
                    j=j+1;
                }
            }
        }
    }
    // pattern B: "some X ... not ..."
    if(xsl==0 && nct>=4){
        let l0b:i32=tok_lc(claim,ar,0,tw);
        if(z_eq(tw[0..l0b],"some")==1){
            let nj:i32=-1;
            let j2:i32=2;
            while(j2<nct){
                let lj2:i32=tok_lc(claim,ar,j2,tw);
                if(is_negword(tw[0..lj2])==1){nj=j2;break;}
                j2=j2+1;
            }
            if(nj>0){
                let o1:i32=a_get(ar,2);
                let l1b:i32=a_get(ar,3);
                xsl=z_stem(claim[o1..o1+l1b],xs,tmp,vb);
                let j3:i32=nj+1;
                while(j3<nct && psl==0){
                    let lj3:i32=tok_lc(claim,ar,j3,tw);
                    if(lj3>0 && in_list(tw[0..lj3],lex_stop())==0){
                        let jo3:i32=a_get(ar,2*j3);
                        let jl3:i32=a_get(ar,2*j3+1);
                        psl=z_stem(claim[jo3..jo3+jl3],ps,tmp,vb);
                    }
                    j3=j3+1;
                }
            }
        }
    }
    // pattern C: "it is not true|the case that all|every|each X ..."
    if(xsl==0 && nct>=7){
        if(match_at(lc,0,"it is not true that")==1 || match_at(lc,0,"it is not the case that")==1){
            let qj:i32=-1;
            let j4:i32=4;
            while(j4<nct){
                let lj4:i32=tok_lc(claim,ar,j4,tw);
                if(z_eq(tw[0..lj4],"all")==1||z_eq(tw[0..lj4],"every")==1||z_eq(tw[0..lj4],"each")==1){qj=j4;break;}
                j4=j4+1;
            }
            if(qj>0 && qj+1<nct){
                let oq:i32=a_get(ar,2*(qj+1));
                let lq:i32=a_get(ar,2*(qj+1)+1);
                xsl=z_stem(claim[oq..oq+lq],xs,tmp,vb);
                let j5:i32=qj+2;
                while(j5<nct && psl==0){
                    let lj5:i32=tok_lc(claim,ar,j5,tw);
                    if(lj5>0 && in_list(tw[0..lj5],lex_stop())==0 && in_list(tw[0..lj5],lex_be())==0 && in_list(tw[0..lj5],lex_have())==0){
                        let jo5:i32=a_get(ar,2*j5);
                        let jl5:i32=a_get(ar,2*j5+1);
                        psl=z_stem(claim[jo5..jo5+jl5],ps,tmp,vb);
                    }
                    j5=j5+1;
                }
            }
        }
    }
    if(xsl<=0 || psl<=0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(xs);z_free(ps);
        z_free(low);
        return 0;
    }
    let X:[]u8=xs[0..xsl];
    let P:[]u8=ps[0..psl];
    let clau:[]u8=z_alloc(2048);
    let prot:[]u8=z_alloc(2048);
    let tok:[]u8=z_alloc(1024);
    if(clau.len==0||prot.len==0||tok.len==0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(xs);z_free(ps);
        z_free(low);z_free(clau);z_free(prot);z_free(tok);
        return 0;
    }
    let hit:i32=0;
    let si:i32=0;
    while(si<2 && hit==0){
        let tx:[]u8=title;
        if(si==1){tx=snip;}
        let ncl:i32=z_clauses(tx,clau,prot,32);
        let c:i32=0;
        while(c<ncl && hit==0){
            let co:i32=a_get(clau,2*c);
            let cl:i32=a_get(clau,2*c+1);
            if(neguniv_clause_ok(tx[co..co+cl],X,P,tok,tmp,tw,out,vb)==1){hit=1;}
            c=c+1;
        }
        si=si+1;
    }
    z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(xs);z_free(ps);
    z_free(low);z_free(clau);z_free(prot);z_free(tok);
    return hit;
}

// strip a leading negative prefix (un/in/im/ir/dis); returns remainder
// length in out, 0 if none
fn negpref_strip(w:[]u8,out:[]u8)i32{
    let l:i32=w.len;
    if(l>4){
        let c0:i32=w[0] as i32;
        let c1:i32=w[1] as i32;
        if(c0==117 && c1==110){ // un
            let q:i32=0;
            while(q+2<l){out[q]=w[q+2];q=q+1;}
            return l-2;
        }
        if(c0==105 && (c1==110 || c1==109 || c1==114)){ // in/im/ir
            let q:i32=0;
            while(q+2<l){out[q]=w[q+2];q=q+1;}
            return l-2;
        }
        if(c0==100 && c1==105 && (w[2] as i32)==115){ // dis
            let q:i32=0;
            while(q+3<l){out[q]=w[q+3];q=q+1;}
            return l-3;
        }
    }
    return 0;
}

// 1 if a and b share a stem prefix (either starts with the other); used
// for double-negation bases where the claim side is adjectival
// ("helpful") and the evidence side verbal ("help"). Falls back to exact
// equality for short stems.
fn stem_prefix_eq(a:[]u8,b:[]u8)i32{
    let la:i32=a.len;
    let lb:i32=b.len;
    if(la<4 || lb<4){return z_eq(a,b);}
    if(la<=lb){
        if(z_eq(b[0..la],a)==1){return 1;}
    }else{
        if(z_eq(a[0..lb],b)==1){return 1;}
    }
    return 0;
}

// 1 if the evidence clause names subject S and asserts the base property
// B with no negation scoping it
fn dn_clause_ok(clause:[]u8,S:[]u8,B:[]u8,tok:[]u8,tmp:[]u8,tw:[]u8,out:[]u8,vb:[]u8)i32{
    let nct:i32=z_toks(clause,tok,128);
    if(nct<2){return 0;}
    if(is_interrog(clause,tok,nct,tmp)==1){return 0;}
    if(clause_hedged(clause,tok,nct,tmp)==1){return 0;}
    let has_s:i32=0;
    let k:i32=0;
    while(k<nct){
        let ko:i32=a_get(tok,2*k);
        let kl:i32=a_get(tok,2*k+1);
        let sl:i32=z_stem(clause[ko..ko+kl],out,tmp,vb);
        if(sl>0 && z_eq(out[0..sl],S)==1){has_s=1;break;}
        k=k+1;
    }
    if(has_s==0){return 0;}
    let m:i32=0;
    while(m<nct){
        let mo:i32=a_get(tok,2*m);
        let ml:i32=a_get(tok,2*m+1);
        let sl2:i32=z_stem(clause[mo..mo+ml],out,tmp,vb);
        if(sl2>0 && stem_prefix_eq(out[0..sl2],B)==1){
            if(neg_within_before(clause,tok,m,3,tw)==0){return 1;}
        }
        m=m+1;
    }
    return 0;
}

// Double negation: "not ineffective" -> "effective" (P1: not + negpref
// adjective), "not unhelpful" -> "helps" (P2: not + negpref verb base),
// "did not fail to appear" -> "appeared" (P3: not fail to V). The evidence
// must assert the base property of the claim's subject, unnegated.
// 1 affirm, 0 abstain.
fn doubleneg_affirm(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    let tw:[]u8=z_alloc(64);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    let base:[]u8=z_alloc(32);
    let bs:[]u8=z_alloc(32);
    let sj:[]u8=z_alloc(32);
    if(ar.len==0||tw.len==0||tmp.len==0||out.len==0||vb.len==0||base.len==0||bs.len==0||sj.len==0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(base);z_free(bs);z_free(sj);
        return 0;
    }
    let nct:i32=z_toks(claim,ar,64);
    let nj:i32=-1;
    let j:i32=0;
    while(j<nct){
        let lj:i32=tok_lc(claim,ar,j,tw);
        if(is_negword(tw[0..lj])==1){nj=j;break;}
        j=j+1;
    }
    if(nj<0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(base);z_free(bs);z_free(sj);
        return 0;
    }
    // matrix frame ("it is not the case|true that"): the claim's subject
    // follows the frame, not inside it
    let lowf:[]u8=z_alloc(256);
    let sstart:i32=0;
    if(lowf.len>0){
        let lcf:i32=lower_copy(claim,lowf);
        let lcs:[]u8=lowf[0..lcf];
        if(match_at(lcs,0,"it is not the case that")==1){sstart=6;}
        else{if(match_at(lcs,0,"it is not true that")==1){sstart=5;}}
    }
    z_free(lowf);
    // claim subject: first non-stop stem
    let sjl:i32=0;
    let s2:i32=sstart;
    while(s2<nct && sjl==0){
        let ls2:i32=tok_lc(claim,ar,s2,tw);
        if(ls2>0 && in_list(tw[0..ls2],lex_stop())==0){
            let so2:i32=a_get(ar,2*s2);
            let sl2:i32=a_get(ar,2*s2+1);
            sjl=z_stem(claim[so2..so2+sl2],sj,tmp,vb);
        }
        s2=s2+1;
    }
    let bsl:i32=0;
    // P3: "not fail to V"
    let f3:i32=nj+1;    while(f3<nct && bsl==0){
        let lf:i32=tok_lc(claim,ar,f3,tw);
        if(z_eq(tw[0..lf],"fail")==1||z_eq(tw[0..lf],"fails")==1||z_eq(tw[0..lf],"failed")==1){
            let g:i32=f3+1;
            while(g<nct && bsl==0){
                let lg:i32=tok_lc(claim,ar,g,tw);
                if(z_eq(tw[0..lg],"to")==0 && lg>0 && in_list(tw[0..lg],lex_stop())==0){
                    let go:i32=a_get(ar,2*g);
                    let gl:i32=a_get(ar,2*g+1);
                    bsl=z_stem(claim[go..go+gl],bs,tmp,vb);
                }
                g=g+1;
            }
        }
        f3=f3+1;
    }
    // P1/P2: last negpref content word after the neg marker
    if(bsl==0){
        let li:i32=nct-1;
        while(li>nj && bsl==0){
            let lli:i32=tok_lc(claim,ar,li,tw);
            if(lli>0 && in_list(tw[0..lli],lex_stop())==0){
                let rl:i32=negpref_strip(tw[0..lli],base);
                if(rl>0){bsl=z_stem(base[0..rl],bs,tmp,vb);}
            }
            li=li-1;
        }
    }
    if(bsl<=0 || sjl<=0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(base);z_free(bs);z_free(sj);
        return 0;
    }
    let B:[]u8=bs[0..bsl];
    let S:[]u8=sj[0..sjl];
    let clau:[]u8=z_alloc(2048);
    let prot:[]u8=z_alloc(2048);
    let tok:[]u8=z_alloc(1024);
    if(clau.len==0||prot.len==0||tok.len==0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(base);z_free(bs);z_free(sj);
        z_free(clau);z_free(prot);z_free(tok);
        return 0;
    }
    let hit:i32=0;
    let si:i32=0;
    while(si<2 && hit==0){
        let tx:[]u8=title;
        if(si==1){tx=snip;}
        let ncl:i32=z_clauses(tx,clau,prot,32);
        let c:i32=0;
        while(c<ncl && hit==0){
            let co:i32=a_get(clau,2*c);
            let cl:i32=a_get(clau,2*c+1);
            if(dn_clause_ok(tx[co..co+cl],S,B,tok,tmp,tw,out,vb)==1){hit=1;}
            c=c+1;
        }
        si=si+1;
    }
    z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(base);z_free(bs);z_free(sj);
    z_free(clau);z_free(prot);z_free(tok);
    return hit;
}

// normalize: lowercase, trim spaces, strip one trailing "."
fn norm_text(t:[]u8,out:[]u8)i32{
    let n:i32=t.len;
    let s:i32=0;
    while(s<n && (t[s] as i32)==32){s=s+1;}
    let e:i32=n;
    while(e>s && (t[e-1] as i32)==32){e=e-1;}
    if(e>s && (t[e-1] as i32)==46){e=e-1;}
    while(e>s && (t[e-1] as i32)==32){e=e-1;}
    let w:i32=0;
    while(s<e){
        let c:i32=t[s] as i32;
        if(c>=65 && c<=90){c=c+32;}
        out[w]=c as u8;
        w=w+1;
        s=s+1;
    }
    return w;
}

// 1 if the tail s[a..b] (space-separated, already lowercased) contains no
// negation or contrast word
fn tail_clean(s:[]u8,a:i32,b:i32)i32{
    let w:[]u8=z_alloc(32);
    if(w.len==0){return 0;}
    let i:i32=a;
    while(i<b){
        while(i<b && (s[i] as i32)==32){i=i+1;}
        let j:i32=i;
        while(j<b && (s[j] as i32)!=32){j=j+1;}
        let wl:i32=j-i;
        if(wl>0 && wl<32){
            let q:i32=0;
            while(q<wl){w[q]=s[i+q];q=q+1;}
            let ww:[]u8=w[0..wl];
            if(is_negw(ww)==1){z_free(w);return 0;}
            if(z_eq(ww,"cannot")==1){z_free(w);return 0;}
            if(z_eq(ww,"cant")==1){z_free(w);return 0;}
            if(z_eq(ww,"except")==1){z_free(w);return 0;}
            if(z_eq(ww,"but")==1){z_free(w);return 0;}
            if(z_eq(ww,"however")==1){z_free(w);return 0;}
            if(z_eq(ww,"although")==1){z_free(w);return 0;}
            if(z_eq(ww,"though")==1){z_free(w);return 0;}
            if(z_eq(ww,"unless")==1){z_free(w);return 0;}
            if(z_eq(ww,"despite")==1){z_free(w);return 0;}
            if(z_eq(ww,"never")==1){z_free(w);return 0;}
        }
        i=j;
    }
    z_free(w);
    return 1;
}

// Identical restatement: an evidence clause equal to the claim, or the
// claim plus a short tail (<=3 words: "The store opens at 9am daily").
// Yields to numeric_guard: contradictory numeric evidence vetoes.
// 1 affirm, 0 abstain.
fn identical_affirm(claim:[]u8,title:[]u8,snip:[]u8,ng:i32)i32{
    if(ng==2){return 0;}
    let cb:[]u8=z_alloc(1024);
    let eb:[]u8=z_alloc(1024);
    let clau:[]u8=z_alloc(2048);
    let prot:[]u8=z_alloc(2048);
    if(cb.len==0||eb.len==0||clau.len==0||prot.len==0){
        z_free(cb);z_free(eb);z_free(clau);z_free(prot);
        return 0;
    }
    let cl:i32=norm_text(claim,cb);
    if(cl<4){
        z_free(cb);z_free(eb);z_free(clau);z_free(prot);
        return 0;
    }
    if((cb[cl-1] as i32)==63){
        z_free(cb);z_free(eb);z_free(clau);z_free(prot);
        return 0;
    }
    let hit:i32=0;
    let si:i32=0;
    while(si<2 && hit==0){
        let tx:[]u8=title;
        if(si==1){tx=snip;}
        let ncl:i32=z_clauses(tx,clau,prot,32);
        let c:i32=0;
        while(c<ncl && hit==0){
            let co:i32=a_get(clau,2*c);
            let cl2:i32=a_get(clau,2*c+1);
            let el:i32=norm_text(tx[co..co+cl2],eb);
            if(el>=cl && z_eq(eb[0..cl],cb[0..cl])==1){
                if(el==cl){hit=1;}
                else{
                    if((eb[cl] as i32)==32){
                        let sp:i32=0;
                        let p:i32=cl+1;
                        while(p<el){
                            if((eb[p] as i32)==32){sp=sp+1;}
                            p=p+1;
                        }
                        // short tail (<=3 words) with no neg/contrast word:
                        // "daily", "the club", "at sea level" are elaborations,
                        // but "except holidays" would contradict.
                        if(sp<3 && tail_clean(eb,cl,el)==1){hit=1;}
                    }
                }
            }
            c=c+1;
        }
        si=si+1;
    }
    z_free(cb);z_free(eb);z_free(clau);z_free(prot);
    return hit;
}

// Direct contradiction of a clause-final negated verb: "The mayor did
// not resign" denied by "The mayor resigned yesterday." The negated verb
// must be the claim's last content word (modulo temporal adjuncts), and
// the evidence must assert it of the claim's subject with no negation
// scoping it. 2 deny, 0 abstain.
fn is_temporal_adj(w:[]u8)i32{
    if(z_eq(w,"yesterday")==1){return 1;}
    if(z_eq(w,"today")==1){return 1;}
    if(z_eq(w,"tomorrow")==1){return 1;}
    if(z_eq(w,"recently")==1){return 1;}
    if(z_eq(w,"lately")==1){return 1;}
    if(z_eq(w,"already")==1){return 1;}
    if(z_eq(w,"yet")==1){return 1;}
    if(z_eq(w,"now")==1){return 1;}
    return 0;
}

fn negverb_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    let tw:[]u8=z_alloc(64);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    let vs:[]u8=z_alloc(32);
    let sj:[]u8=z_alloc(32);
    if(ar.len==0||tw.len==0||tmp.len==0||out.len==0||vb.len==0||vs.len==0||sj.len==0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(vs);z_free(sj);
        return 0;
    }
    let nct:i32=z_toks(claim,ar,64);
    let nj:i32=-1;
    let j:i32=0;
    while(j<nct){
        let lj:i32=tok_lc(claim,ar,j,tw);
        if(is_negword(tw[0..lj])==1){nj=j;break;}
        j=j+1;
    }
    if(nj<0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(vs);z_free(sj);
        return 0;
    }
    // V: first content word after the neg; must be the last content word
    // (temporal adjuncts allowed after it)
    let vsl:i32=0;
    let vj:i32=nj+1;
    while(vj<nct && vsl==0){
        let lv:i32=tok_lc(claim,ar,vj,tw);
        if(lv>0 && in_list(tw[0..lv],lex_stop())==0 && in_list(tw[0..lv],lex_be())==0 && in_list(tw[0..lv],lex_have())==0){
            let vo:i32=a_get(ar,2*vj);
            let vl:i32=a_get(ar,2*vj+1);
            vsl=z_stem(claim[vo..vo+vl],vs,tmp,vb);
        }
        vj=vj+1;
    }
    if(vsl<=0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(vs);z_free(sj);
        return 0;
    }
    let k:i32=vj;
    while(k<nct){
        let lk:i32=tok_lc(claim,ar,k,tw);
        if(lk>0 && in_list(tw[0..lk],lex_stop())==0 && is_temporal_adj(tw[0..lk])==0){
            z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(vs);z_free(sj);
            return 0;
        }
        k=k+1;
    }
    // matrix frame ("it is not the case|true that"): the claim's subject
    // follows the frame, not inside it
    let lowf2:[]u8=z_alloc(256);
    let sstart2:i32=0;
    if(lowf2.len>0){
        let lcf2:i32=lower_copy(claim,lowf2);
        let lcs2:[]u8=lowf2[0..lcf2];
        if(match_at(lcs2,0,"it is not the case that")==1){sstart2=6;}
        else{if(match_at(lcs2,0,"it is not true that")==1){sstart2=5;}}
    }
    z_free(lowf2);
    // claim subject: first non-stop stem
    let sjl:i32=0;
    let s2:i32=sstart2;
    while(s2<nct && sjl==0){
        let ls2:i32=tok_lc(claim,ar,s2,tw);
        if(ls2>0 && in_list(tw[0..ls2],lex_stop())==0){
            let so2:i32=a_get(ar,2*s2);
            let sl2:i32=a_get(ar,2*s2+1);
            sjl=z_stem(claim[so2..so2+sl2],sj,tmp,vb);
        }
        s2=s2+1;
    }
    if(sjl<=0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(vs);z_free(sj);
        return 0;
    }
    let V:[]u8=vs[0..vsl];
    let S:[]u8=sj[0..sjl];
    let clau:[]u8=z_alloc(2048);
    let prot:[]u8=z_alloc(2048);
    let tok:[]u8=z_alloc(1024);
    if(clau.len==0||prot.len==0||tok.len==0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(vs);z_free(sj);
        z_free(clau);z_free(prot);z_free(tok);
        return 0;
    }
    let hit:i32=0;
    let si:i32=0;
    while(si<2 && hit==0){
        let tx:[]u8=title;
        if(si==1){tx=snip;}
        let ncl:i32=z_clauses(tx,clau,prot,32);
        let c:i32=0;
        while(c<ncl && hit==0){
            let co:i32=a_get(clau,2*c);
            let cl:i32=a_get(clau,2*c+1);
            let clause:[]u8=tx[co..co+cl];
            let nct2:i32=z_toks(clause,tok,128);
            if(nct2>=2 && is_interrog(clause,tok,nct2,tmp)==0 && clause_hedged(clause,tok,nct2,tmp)==0){
                let has_s:i32=0;
                let has_v:i32=-1;
                let m:i32=0;
                while(m<nct2){
                    let mo:i32=a_get(tok,2*m);
                    let ml:i32=a_get(tok,2*m+1);
                    let sl:i32=z_stem(clause[mo..mo+ml],out,tmp,vb);
                    if(sl>0 && z_eq(out[0..sl],S)==1){has_s=1;}
                    if(sl>0 && z_eq(out[0..sl],V)==1){has_v=m;}
                    m=m+1;
                }
                // round-7: "failed to V" / "refused to V" / "unable to V",
                // neither-nor scope, and all-but scope all negate V for
                // this subject: not an unnegated assertion of V
                if(has_s==1 && has_v>=0 && neg_within_before(clause,tok,has_v,3,tw)==0){hit=1;}
            }
            c=c+1;
        }
        si=si+1;
    }
    z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(vs);z_free(sj);
    z_free(clau);z_free(prot);z_free(tok);
    if(hit==1){return 2;}
    return 0;
}

// "X prevented Y" supported by the subject's agency plus Y's non-
// occurrence: "The levees prevented flooding" / "The levees held and
// the town did not flood." 1 affirm, 0 abstain.
// 1 if the word at position m is directly negated: "not"/"never"/"no"/
// "without" immediately before it, or aux+"not"/"never" before it
// ("did not flood", "was never flooded")
fn y_negated(clause:[]u8,tok:[]u8,m:i32,tmp:[]u8)i32{
    if(m>=1){
        let o1:i32=a_get(tok,2*(m-1));
        let l1:i32=a_get(tok,2*(m-1)+1);
        let ll1:i32=lower_copy(clause[o1..o1+l1],tmp);
        let w1:[]u8=tmp[0..ll1];
        if(z_eq(w1,"not")==1||z_eq(w1,"never")==1||z_eq(w1,"no")==1||z_eq(w1,"without")==1){return 1;}
        if(m>=2){
            let o2:i32=a_get(tok,2*(m-2));
            let l2:i32=a_get(tok,2*(m-2)+1);
            let ll2:i32=lower_copy(clause[o2..o2+l2],tmp);
            let w2:[]u8=tmp[0..ll2];
            if(z_eq(w2,"not")==1||z_eq(w2,"never")==1){
                if(z_eq(w1,"did")==1||z_eq(w1,"was")==1||z_eq(w1,"were")==1||z_eq(w1,"has")==1||z_eq(w1,"have")==1||z_eq(w1,"had")==1||z_eq(w1,"do")==1||z_eq(w1,"does")==1||z_eq(w1,"is")==1||z_eq(w1,"are")==1||z_eq(w1,"will")==1||z_eq(w1,"would")==1||z_eq(w1,"been")==1){return 1;}
            }
        }
        // round-7: prevention verbs negate their complement ("stopped the
        // flood" = the flood did not happen). Scan back up to 3 tokens.
        let b:i32=m-1;
        let b0:i32=m-3;
        if(b0<0){b0=0;}
        while(b>=b0){
            let bo:i32=a_get(tok,2*b);
            let bl:i32=a_get(tok,2*b+1);
            let bll:i32=lower_copy(clause[bo..bo+bl],tmp);
            if(r7_prevent_verb(tmp[0..bll])==1){return 1;}
            b=b-1;
        }
    }
    return 0;
}

fn prevent_affirm(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    let tw:[]u8=z_alloc(64);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    let ys:[]u8=z_alloc(32);
    let sj:[]u8=z_alloc(32);
    if(ar.len==0||tw.len==0||tmp.len==0||out.len==0||vb.len==0||ys.len==0||sj.len==0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(ys);z_free(sj);
        return 0;
    }
    let nct:i32=z_toks(claim,ar,64);
    // find "prevent" (stem) and the first content word after it (Y)
    let pj:i32=-1;
    let j:i32=0;
    while(j<nct){
        let ko:i32=a_get(ar,2*j);
        let kl:i32=a_get(ar,2*j+1);
        let sl:i32=z_stem(claim[ko..ko+kl],out,tmp,vb);
        if(sl>0 && z_eq(out[0..sl],"prevent")==1){pj=j;break;}
        j=j+1;
    }
    if(pj<0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(ys);z_free(sj);
        return 0;
    }
    let ysl:i32=0;
    let y2:i32=pj+1;
    while(y2<nct && ysl==0){
        let ly:i32=tok_lc(claim,ar,y2,tw);
        if(ly>0 && in_list(tw[0..ly],lex_stop())==0){
            let yo:i32=a_get(ar,2*y2);
            let yl:i32=a_get(ar,2*y2+1);
            ysl=z_stem(claim[yo..yo+yl],ys,tmp,vb);
        }
        y2=y2+1;
    }
    let sjl:i32=0;
    let s2:i32=0;
    while(s2<nct && sjl==0){
        let ls2:i32=tok_lc(claim,ar,s2,tw);
        if(ls2>0 && in_list(tw[0..ls2],lex_stop())==0){
            let so2:i32=a_get(ar,2*s2);
            let sl2:i32=a_get(ar,2*s2+1);
            sjl=z_stem(claim[so2..so2+sl2],sj,tmp,vb);
        }
        s2=s2+1;
    }
    if(ysl<=0 || sjl<=0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(ys);z_free(sj);
        return 0;
    }
    let Y:[]u8=ys[0..ysl];
    let S:[]u8=sj[0..sjl];
    let clau:[]u8=z_alloc(2048);
    let prot:[]u8=z_alloc(2048);
    let tok:[]u8=z_alloc(1024);
    if(clau.len==0||prot.len==0||tok.len==0){
        z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(ys);z_free(sj);
        z_free(clau);z_free(prot);z_free(tok);
        return 0;
    }
    let hit_s:i32=0;
    let hit_y:i32=0;
    let si:i32=0;
    while(si<2 && (hit_s==0 || hit_y==0)){
        let tx:[]u8=title;
        if(si==1){tx=snip;}
        let ncl:i32=z_clauses(tx,clau,prot,32);
        let c:i32=0;
        while(c<ncl && (hit_s==0 || hit_y==0)){
            let co:i32=a_get(clau,2*c);
            let cl:i32=a_get(clau,2*c+1);
            let clause:[]u8=tx[co..co+cl];
            let nct2:i32=z_toks(clause,tok,128);
            if(nct2>=2 && is_interrog(clause,tok,nct2,tmp)==0 && clause_hedged(clause,tok,nct2,tmp)==0){
                let m:i32=0;
                while(m<nct2){
                    let mo:i32=a_get(tok,2*m);
                    let ml:i32=a_get(tok,2*m+1);
                    let sl:i32=z_stem(clause[mo..mo+ml],out,tmp,vb);
                    if(sl>0 && z_eq(out[0..sl],S)==1){hit_s=1;}
                    if(sl>0 && z_eq(out[0..sl],Y)==1){
                        if(y_negated(clause,tok,m,tmp)==1){hit_y=1;}
                    }
                    m=m+1;
                }
            }
            c=c+1;
        }
        si=si+1;
    }
    z_free(ar);z_free(tw);z_free(tmp);z_free(out);z_free(vb);z_free(ys);z_free(sj);
    z_free(clau);z_free(prot);z_free(tok);
    if(hit_s==1 && hit_y==1){return 1;}
    return 0;
}

// 1 if any numeral (digit or number word) occurs in s
fn any_numeral(s:[]u8)i32{
    let epos:[]u8=z_alloc(8);
    if(epos.len==0){return 0;}
    let n:i32=s.len;
    let i:i32=0;
    let found:i32=0;
    while(i<n && found==0){
        let ch:i32=s[i] as i32;
        if(z_isdig(ch)==1){found=1;}
        else{
            if(ch>=97 && ch<=122){
                let v:i64=wnum_seq(s,i,n,epos);
                if(v>=0){found=1;}
                let e:i32=a_get(epos,0);
                if(e>i){i=e;}
                else{
                    while(i<n){
                        let c2:i32=s[i] as i32;
                        if(c2<97 || c2>122){break;}
                        i=i+1;
                    }
                }
            }
            else{i=i+1;}
        }
    }
    z_free(epos);
    return found;
}

// ==================== end round-5 relation helpers ====================
// "no/none/nobody/neither X" contradicted by a positive count of X.
// 2 deny, 0 abstain.
fn zero_quant_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    if(ar.len==0 || tmp.len==0 || out.len==0 || vb.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let nt:i32=z_toks(claim,ar,128);
    let zq:i32=0;
    let j:i32=0;
    while(j<nt && zq==0){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(z_eq(w,"no")==1 || z_eq(w,"none")==1 || z_eq(w,"nobody")==1 || z_eq(w,"neither")==1 || z_eq(w,"nothing")==1){
            // "no longer" is not a zero quantifier
            if(j+1<nt){
                let o2:i32=a_get(ar,2*(j+1));
                let l2:i32=a_get(ar,2*(j+1)+1);
                let ll2:i32=lower_copy(claim[o2..o2+l2],tmp);
                if(z_eq(tmp[0..ll2],"longer")==0){zq=1;}
            }else{zq=1;}
        }
        j=j+1;
    }
    if(zq==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    // the polarity-flip pattern is a universal positive, not a zero claim
    if(is_polflip_claim(claim)==1){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    // claim content stems (excluding the zero word itself)
    let csb:[]u8=z_alloc(512);
    let csr:[]u8=z_alloc(512);
    if(csb.len==0 || csr.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(csb);z_free(csr);
        return 0;
    }
    let ncs2:i32=0;
    let coff:i32=0;
    j=0;
    while(j<nt){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(ll>3 && in_list(w,lex_stop())==0 && z_eq(w,"no")!=1 && z_eq(w,"none")!=1 && z_eq(w,"nobody")!=1 && z_eq(w,"neither")!=1 && z_eq(w,"nothing")!=1){
            let sl:i32=z_stem(claim[to..to+tl],out,tmp,vb);
            if(sl>0 && coff+sl<=512 && ncs2<64){
                let qq:i32=0;
                while(qq<sl){csb[coff+qq]=out[qq];qq=qq+1;}
                a_put(csr,2*ncs2,coff);
                a_put(csr,2*ncs2+1,sl);
                coff=coff+sl;
                ncs2=ncs2+1;
            }
        }
        j=j+1;
    }
    z_free(ar);
    let hit:i32=0;
    let ti:i32=0;
    while(ti<2 && hit==0){
        let tx:[]u8=title;
        if(ti==1){tx=snip;}
        if(has_positive_number(tx)==1){
            let ar2:[]u8=z_alloc(2048);
            if(ar2.len>0){
                let nt2:i32=z_toks(tx,ar2,256);
                let k:i32=0;
                while(k<nt2 && hit==0){
                    let ko:i32=a_get(ar2,2*k);
                    let kl:i32=a_get(ar2,2*k+1);
                    let kll:i32=lower_copy(tx[ko..ko+kl],tmp);
                    if(kll>3 && in_list(tmp[0..kll],lex_stop())==0){
                        let sl:i32=z_stem(tx[ko..ko+kl],out,tmp,vb);
                        if(sl>0){
                            let m:i32=0;
                            while(m<ncs2){
                                let mo:i32=a_get(csr,2*m);
                                let ml:i32=a_get(csr,2*m+1);
                                if(z_eq(out[0..sl],csb[mo..mo+ml])==1){hit=1;break;}
                                m=m+1;
                            }
                        }
                    }
                    k=k+1;
                }
                z_free(ar2);
            }
        }
        ti=ti+1;
    }
    z_free(tmp);z_free(out);z_free(vb);z_free(csb);z_free(csr);
    if(hit==1){return 2;}
    return 0;
}
// "X is the <superlative>" contradicted by a rival superlative/comparative
// for the same scope. 2 deny, 0 abstain.
fn superlative_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    if(ar.len==0 || tmp.len==0 || out.len==0 || vb.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let nt:i32=z_toks(claim,ar,128);
    // claim superlative + base
    let si:i32=-1;
    let bl:i32=0;
    let j:i32=0;
    while(j<nt && si<0){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(is_super(w)==1){si=j;bl=morph_base(w,out);}
        else{
            if((z_eq(w,"most")==1 || z_eq(w,"least")==1) && j+1<nt){
                let o2:i32=a_get(ar,2*(j+1));
                let l2:i32=a_get(ar,2*(j+1)+1);
                let ll2:i32=lower_copy(claim[o2..o2+l2],tmp);
                si=j+1;
                bl=morph_base(tmp[0..ll2],out);
            }
        }
        j=j+1;
    }
    if(si<0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let base:[]u8=out[0..bl];
    // claim subject set: first two content stems (fixed 32-byte slots)
    let sa0:[]u8=z_alloc(32);
    let sa1:[]u8=z_alloc(32);
    // claim scope: content stems after the superlative, up to 8
    let scb:[]u8=z_alloc(256);
    let scr:[]u8=z_alloc(64);
    if(sa0.len==0 || sa1.len==0 || scb.len==0 || scr.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        z_free(sa0);z_free(sa1);z_free(scb);z_free(scr);
        return 0;
    }
    let na:i32=0;
    let l0:i32=0;
    let l1:i32=0;
    j=0;
    while(j<nt && na<2){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(ll>0 && in_list(tmp[0..ll],lex_stop())==0){
            let sl:i32=z_stem(claim[to..to+tl],out,tmp,vb);
            if(sl>0 && sl<=32){
                if(na==0){
                    let qq:i32=0;
                    while(qq<sl){sa0[qq]=out[qq];qq=qq+1;}
                    l0=sl;
                }else{
                    let qq:i32=0;
                    while(qq<sl){sa1[qq]=out[qq];qq=qq+1;}
                    l1=sl;
                }
                na=na+1;
            }
        }
        j=j+1;
    }
    let nsc:i32=0;
    let soff:i32=0;
    j=si+1;
    while(j<nt && nsc<8){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(ll>3 && in_list(tmp[0..ll],lex_stop())==0){
            let sl:i32=z_stem(claim[to..to+tl],out,tmp,vb);
            if(sl>0 && soff+sl<=256){
                let qq:i32=0;
                while(qq<sl){scb[soff+qq]=out[qq];qq=qq+1;}
                a_put(scr,2*nsc,soff);
                a_put(scr,2*nsc+1,sl);
                soff=soff+sl;
                nsc=nsc+1;
            }
        }
        j=j+1;
    }
    z_free(ar);
    let hit:i32=0;
    let ti:i32=0;
    while(ti<2 && hit==0){
        let tx:[]u8=title;
        if(ti==1){tx=snip;}
        let ar2:[]u8=z_alloc(2048);
        if(ar2.len>0){
            let nt2:i32=z_toks(tx,ar2,256);
            let b0:[]u8=z_alloc(32);
            let bl0:i32=0;
            if(b0.len>0){bl0=first_content_stem(tx,ar2,nt2,0,tmp,b0,vb);}
            // (a) rival comparative: "<C> than <A>" with the same base
            let c2:i32=0;
            while(c2<nt2 && hit==0){
                let co:i32=a_get(ar2,2*c2);
                let cl2:i32=a_get(ar2,2*c2+1);
                let cll:i32=lower_copy(tx[co..co+cl2],tmp);
                if(is_compw(tmp[0..cll])==1){
                    let cb:[]u8=z_alloc(32);
                    if(cb.len>0){
                        let cbl:i32=morph_base(tmp[0..cll],cb);
                        if(z_eq(cb[0..cbl],base)==1){
                            let k:i32=c2+1;
                            let thanat:i32=-1;
                            while(k<nt2 && k<=c2+3){
                                let ko:i32=a_get(ar2,2*k);
                                let kl:i32=a_get(ar2,2*k+1);
                                let kll:i32=lower_copy(tx[ko..ko+kl],tmp);
                                if(z_eq(tmp[0..kll],"than")==1){thanat=k;break;}
                                k=k+1;
                            }
                            if(thanat>=0){
                                let k2:i32=thanat+1;
                                while(k2<nt2 && k2<=thanat+3 && hit==0){
                                    let qo:i32=a_get(ar2,2*k2);
                                    let ql:i32=a_get(ar2,2*k2+1);
                                    let qll:i32=lower_copy(tx[qo..qo+ql],tmp);
                                    if(qll>0 && in_list(tmp[0..qll],lex_stop())==0){
                                        let qsl:i32=z_stem(tx[qo..qo+ql],out,tmp,vb);
                                        let insub:i32=0;
                                        if(qsl==l0 && z_eq(out[0..qsl],sa0[0..l0])==1){insub=1;}
                                        if(na>1 && qsl==l1 && z_eq(out[0..qsl],sa1[0..l1])==1){insub=1;}
                                        if(insub==1){
                                            let inb:i32=0;
                                            if(bl0==l0 && z_eq(b0[0..bl0],sa0[0..l0])==1){inb=1;}
                                            if(na>1 && bl0==l1 && z_eq(b0[0..bl0],sa1[0..l1])==1){inb=1;}
                                            if(inb==0){hit=1;}
                                        }
                                    }
                                    k2=k2+1;
                                }
                            }
                        }
                    }
                    z_free(cb);
                }
                c2=c2+1;
            }
            // (b) rival superlative with overlapping scope
            let s2:i32=0;
            while(s2<nt2 && hit==0){
                let so:i32=a_get(ar2,2*s2);
                let sl2:i32=a_get(ar2,2*s2+1);
                let sll:i32=lower_copy(tx[so..so+sl2],tmp);
                if(is_super(tmp[0..sll])==1){
                    let sb2:[]u8=z_alloc(32);
                    if(sb2.len>0){
                        let sbl2:i32=morph_base(tmp[0..sll],sb2);
                        if(z_eq(sb2[0..sbl2],base)==1){
                            let inb:i32=0;
                            if(bl0==l0 && z_eq(b0[0..bl0],sa0[0..l0])==1){inb=1;}
                            if(na>1 && bl0==l1 && z_eq(b0[0..bl0],sa1[0..l1])==1){inb=1;}
                            if(inb==0){
                                let k:i32=s2+1;
                                let checked:i32=0;
                                while(k<nt2 && checked<12 && hit==0){
                                    let ko:i32=a_get(ar2,2*k);
                                    let kl:i32=a_get(ar2,2*k+1);
                                    let kll:i32=lower_copy(tx[ko..ko+kl],tmp);
                                    if(kll>3 && in_list(tmp[0..kll],lex_stop())==0){
                                        let ksl:i32=z_stem(tx[ko..ko+kl],out,tmp,vb);
                                        if(ksl>0){
                                            let m:i32=0;
                                            while(m<nsc){
                                                let mo:i32=a_get(scr,2*m);
                                                let ml:i32=a_get(scr,2*m+1);
                                                if(z_eq(out[0..ksl],scb[mo..mo+ml])==1){hit=1;break;}
                                                m=m+1;
                                            }
                                        }
                                    }
                                    checked=checked+1;
                                    k=k+1;
                                }
                            }
                        }
                    }
                    z_free(sb2);
                }
                s2=s2+1;
            }
            z_free(b0);
            z_free(ar2);
        }
        ti=ti+1;
    }
    z_free(tmp);z_free(out);z_free(vb);
    z_free(sa0);z_free(sa1);z_free(scb);z_free(scr);
    if(hit==1){return 2;}
    return 0;
}
// Strip a leading meta-contrast frame: "Unlike X, ..." / "Contrary to X, ...".
// Returns the claim slice after the frame, or the claim unchanged.
fn strip_meta_frame(claim:[]u8)[]u8{
    let n:i32=claim.len;
    if(n<10){return claim;}
    let tmp:[]u8=z_alloc(16);
    if(tmp.len==0){return claim;}
    let i:i32=0;
    while(i<n && (claim[i] as i32)!=32 && (claim[i] as i32)!=44){i=i+1;}
    let ll:i32=lower_copy(claim[0..i],tmp);
    let isunlike:i32=0;
    let iscontrary:i32=0;
    if(z_eq(tmp[0..ll],"unlike")==1){isunlike=1;}
    if(z_eq(tmp[0..ll],"contrary")==1){iscontrary=1;}
    if(isunlike==0 && iscontrary==0){z_free(tmp);return claim;}
    if(iscontrary==1){
        let jj:i32=i+1;
        while(jj<n && (claim[jj] as i32)==32){jj=jj+1;}
        let kk:i32=jj;
        while(kk<n && (claim[kk] as i32)!=32 && (claim[kk] as i32)!=44){kk=kk+1;}
        let ll2:i32=lower_copy(claim[jj..kk],tmp);
        if(z_eq(tmp[0..ll2],"to")==0){z_free(tmp);return claim;}
    }
    z_free(tmp);
    let c:i32=0;
    while(c<n && (claim[c] as i32)!=44){c=c+1;}
    if(c>=n){return claim;}
    let s:i32=c+1;
    while(s<n && (claim[s] as i32)==32){s=s+1;}
    if(s>=n){return claim;}
    return claim[s..n];
}
// "aux + not + <claim-verb>" in a clause containing the claim's subject:
// direct contradiction ("Bats do not lay eggs" vs "Bats lay eggs").
// 1 deny, 0 otherwise. tokC/nct are the CLAUSE's tokens; vm/subjA/firstA
// are the claim's verb/subject stems.
fn dosupport_deny(clause:[]u8,tokC:[]u8,nct:i32,vm:[]u8,subjA:[]u8,firstA:[]u8,tmp:[]u8)i32{
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    let csb:[]u8=z_alloc(1024);
    let csr:[]u8=z_alloc(512);
    if(out.len==0 || vb.len==0 || csb.len==0 || csr.len==0){
        z_free(out);z_free(vb);z_free(csb);z_free(csr);
        return 0;
    }
    // clause content-stem records
    let ncs:i32=0;
    let coff:i32=0;
    let ci:i32=0;
    while(ci<nct && ncs<64){
        let co:i32=a_get(tokC,2*ci);
        let cl:i32=a_get(tokC,2*ci+1);
        let cll:i32=lower_copy(clause[co..co+cl],tmp);
        if(cll>0 && in_list(tmp[0..cll],lex_stop())==0){
            let sl:i32=z_stem(clause[co..co+cl],out,tmp,vb);
            if(sl>0 && coff+sl<=1024){
                let qq:i32=0;
                while(qq<sl){csb[coff+qq]=out[qq];qq=qq+1;}
                a_put(csr,2*ncs,coff);
                a_put(csr,2*ncs+1,sl);
                coff=coff+sl;
                ncs=ncs+1;
            }
        }
        ci=ci+1;
    }
    let hit:i32=0;
    let j:i32=0;
    while(j<nct && hit==0){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        let isaux:i32=0;
        let negbuiltin:i32=0;
        if(z_eq(w,"do")==1 || z_eq(w,"does")==1 || z_eq(w,"did")==1 || z_eq(w,"can")==1 || z_eq(w,"could")==1 || z_eq(w,"will")==1 || z_eq(w,"would")==1 || z_eq(w,"should")==1){isaux=1;}
        if(z_eq(w,"cannot")==1){isaux=1;negbuiltin=1;}
        if(isaux==1){
            let vj:i32=j+1;
            if(negbuiltin==0){
                if(vj>=nct){j=j+1;continue;}
                let no2:i32=a_get(tokC,2*vj);
                let nl2:i32=a_get(tokC,2*vj+1);
                let nll:i32=lower_copy(clause[no2..no2+nl2],tmp);
                if(z_eq(tmp[0..nll],"not")==0){j=j+1;continue;}
                vj=vj+1;
            }
            if(vj<nct){
                let vo:i32=a_get(tokC,2*vj);
                let vl:i32=a_get(tokC,2*vj+1);
                let vsl:i32=z_stem(clause[vo..vo+vl],out,tmp,vb);
                if(vsl>0 && z_eq(out[0..vsl],vm)==1){
                    if(in_stems(subjA,csb,csr,ncs)==1 || in_stems(firstA,csb,csr,ncs)==1){hit=1;}
                }
            }
        }
        j=j+1;
    }
    z_free(out);z_free(vb);z_free(csb);z_free(csr);
    return hit;
}
// ==================== R3b mechanisms ====================
// Taxonomic class exclusivity (B01-B03): "X is a <class>" denied when the
// evidence places X in a mutually exclusive sibling class ("Dolphins are
// fish" vs "Dolphins are mammals"). General: class pairs in the same
// exclusivity group with different members deny each other.
fn excl_code(w:[]u8)i32{
    // Taxonomic/state class code: group*16+member, or 0 if none.
    // Members of the same group are mutually exclusive.
    if(z_eq(w,"mammal")==1 || z_eq(w,"mammals")==1){return 17;}
    if(z_eq(w,"reptile")==1 || z_eq(w,"reptiles")==1){return 18;}
    if(z_eq(w,"bird")==1 || z_eq(w,"birds")==1){return 19;}
    if(z_eq(w,"fish")==1 || z_eq(w,"fishes")==1){return 20;}
    if(z_eq(w,"amphibian")==1 || z_eq(w,"amphibians")==1){return 21;}
    if(z_eq(w,"insect")==1 || z_eq(w,"insects")==1){return 22;}
    if(z_eq(w,"arachnid")==1 || z_eq(w,"arachnids")==1){return 23;}
    if(z_eq(w,"crustacean")==1 || z_eq(w,"crustaceans")==1){return 24;}
    if(z_eq(w,"solid")==1 || z_eq(w,"solids")==1){return 33;}
    if(z_eq(w,"liquid")==1 || z_eq(w,"liquids")==1){return 34;}
    if(z_eq(w,"gas")==1 || z_eq(w,"gases")==1){return 35;}
    if(z_eq(w,"plasma")==1){return 36;}
    return 0;
}
// "X is/are <class>" -> class code of the first copular complement.
fn copular_class(t:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    if(ar.len==0){return 0;}
    // r7c: 32->128 (pre-existing crash on tokens >=33 chars).
    let tmp:[]u8=z_alloc(128);
    if(tmp.len==0){z_free(ar);return 0;}
    let nt:i32=z_toks(t,ar,64);
    let code:i32=0;
    let j:i32=0;
    while(j<nt && code==0){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(t[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(z_eq(w,"is")==1 || z_eq(w,"are")==1 || z_eq(w,"was")==1 || z_eq(w,"were")==1){
            let k:i32=j+1;
            while(k<nt && k<=j+3 && code==0){
                let ko:i32=a_get(ar,2*k);
                let kl:i32=a_get(ar,2*k+1);
                let kll:i32=lower_copy(t[ko..ko+kl],tmp);
                let kw:[]u8=tmp[0..kll];
                if(z_eq(kw,"a")==1 || z_eq(kw,"an")==1 || z_eq(kw,"the")==1){k=k+1;continue;}
                let gc:i32=excl_code(kw);
                if(gc>0){code=gc;}
                else{k=k+1;}
            }
        }
        j=j+1;
    }
    z_free(ar);z_free(tmp);
    return code;
}
// 2 deny, 0 abstain.
fn class_exclusive_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let cc:i32=copular_class(claim);
    if(cc==0){return 0;}
    // claim subject: first content stem
    let ar:[]u8=z_alloc(512);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    if(ar.len==0 || tmp.len==0 || out.len==0 || vb.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let nt:i32=z_toks(claim,ar,64);
    let sl0:i32=first_content_stem(claim,ar,nt,0,tmp,out,vb);
    if(sl0<=0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let cs:[]u8=z_alloc(32);
    if(cs.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(cs);
        return 0;
    }
    let qq:i32=0;
    while(qq<sl0 && qq<32){cs[qq]=out[qq];qq=qq+1;}
    let csub:[]u8=cs[0..sl0];
    z_free(ar);
    let hit:i32=0;
    let ti:i32=0;
    while(ti<2 && hit==0){
        let tx:[]u8=title;
        if(ti==1){tx=snip;}
        let ec:i32=copular_class(tx);
        if(ec>0 && ec/16==cc/16 && ec!=cc){
            // same exclusivity group, different member: check subject match
            let ar2:[]u8=z_alloc(1024);
            if(ar2.len>0){
                let nt2:i32=z_toks(tx,ar2,128);
                let esl:i32=first_content_stem(tx,ar2,nt2,0,tmp,out,vb);
                if(esl==sl0 && z_eq(out[0..esl],csub)==1){hit=1;}
                z_free(ar2);
            }
        }
        ti=ti+1;
    }
    z_free(tmp);z_free(out);z_free(vb);z_free(cs);
    if(hit==1){return 2;}
    return 0;
}
// Expert "warn against" deny phrase (B06): "doctors warn against <use of
// X>" contradicts a positive-efficacy claim about X. The warned-against
// clause names the claim's subject (directly or pronominally, with the
// subject present elsewhere in the evidence).
// 2 deny, 0 abstain.
fn warn_against_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    if(ar.len==0 || tmp.len==0 || out.len==0 || vb.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    // claim's first two content stems
    let nt:i32=z_toks(claim,ar,64);
    let s0:[]u8=z_alloc(32);
    let s1:[]u8=z_alloc(32);
    if(s0.len==0 || s1.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(s0);z_free(s1);
        return 0;
    }
    let l0:i32=0;
    let l1:i32=0;
    let got:i32=0;
    let j:i32=0;
    while(j<nt && got<2){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(ll>0 && in_list(tmp[0..ll],lex_stop())==0){
            let sl:i32=z_stem(claim[to..to+tl],out,tmp,vb);
            if(sl>0 && sl<=32){
                if(got==0){let qq:i32=0;while(qq<sl){s0[qq]=out[qq];qq=qq+1;}l0=sl;}
                else{let qq2:i32=0;while(qq2<sl){s1[qq2]=out[qq2];qq2=qq2+1;}l1=sl;}
                got=got+1;
            }
        }
        j=j+1;
    }
    z_free(ar);
    if(got==0){
        z_free(tmp);z_free(out);z_free(vb);z_free(s0);z_free(s1);
        return 0;
    }
    let hit:i32=0;
    let ti:i32=0;
    while(ti<2 && hit==0){
        let tx:[]u8=title;
        if(ti==1){tx=snip;}
        let low:[]u8=z_alloc(tx.len+1);
        if(low.len>0){
            let ll2:i32=lower_copy(tx,low);
            // find "warn against" / "warns against" / "advise against" /
            // "caution against"
            let wi:i32=0;
            while(wi+12<ll2 && hit==0){
                let iswarn:i32=0;
                if(match_at(low,wi,"warn against")==1){iswarn=1;}
                else{if(match_at(low,wi,"warns against")==1){iswarn=1;}
                else{if(match_at(low,wi,"advises against")==1){iswarn=1;}
                else{if(match_at(low,wi,"advise against")==1){iswarn=1;}
                else{if(match_at(low,wi,"caution against")==1){iswarn=1;}
                else{if(match_at(low,wi,"cautions against")==1){iswarn=1;}}}}}}
                if(iswarn==1){
                    // scan the following clause for the claim subject
                    // (direct stem match or pronoun with subject elsewhere)
                    let ar2:[]u8=z_alloc(1024);
                    if(ar2.len>0){
                        let nt2:i32=z_toks(tx,ar2,128);
                        let k:i32=0;
                        let subjelse:i32=0;
                        let pronhit:i32=0;
                        let directhit:i32=0;
                        while(k<nt2){
                            let ko:i32=a_get(ar2,2*k);
                            let kl:i32=a_get(ar2,2*k+1);
                            let kll:i32=lower_copy(tx[ko..ko+kl],tmp);
                            let kw:[]u8=tmp[0..kll];
                            if(kll>0 && in_list(kw,lex_stop())==0){
                                let ksl:i32=z_stem(tx[ko..ko+kl],out,tmp,vb);
                                if(ksl>0){
                                    if(ksl==l0 && z_eq(out[0..ksl],s0[0..l0])==1){
                                        if(ko<wi){subjelse=1;}else{directhit=1;}
                                    }
                                    if(got>1 && ksl==l1 && z_eq(out[0..ksl],s1[0..l1])==1){
                                        if(ko<wi){subjelse=1;}else{directhit=1;}
                                    }
                                }
                            }
                            if(z_eq(kw,"them")==1 || z_eq(kw,"they")==1 || z_eq(kw,"it")==1){
                                if(ko>wi){pronhit=1;}
                            }
                            k=k+1;
                        }
                        if(directhit==1 || (pronhit==1 && subjelse==1)){hit=1;}
                        z_free(ar2);
                    }
                }
                wi=wi+1;
            }
            z_free(low);
        }
        ti=ti+1;
    }
    z_free(tmp);z_free(out);z_free(vb);z_free(s0);z_free(s1);
    if(hit==1){return 2;}
    return 0;
}
// "not X-free" / "not X-less" (B29): "The treatment is not risk-free"
// asserts the presence of X. If the evidence asserts X (positive
// polarity) of the same subject, affirm. 1 affirm, 0 abstain.
fn notxfree_affirm(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    if(ar.len==0 || tmp.len==0 || out.len==0 || vb.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let nt:i32=z_toks(claim,ar,64);
    // find "not" + "<root>free"/"<root>less" (possibly "<root>","free")
    let root:[]u8=z_alloc(32);
    let rl:i32=0;
    if(root.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(root);
        return 0;
    }
    let j:i32=0;
    while(j+1<nt && rl==0){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"not")==1){
            let o2:i32=a_get(ar,2*(j+1));
            let l2:i32=a_get(ar,2*(j+1)+1);
            let ll2:i32=lower_copy(claim[o2..o2+l2],tmp);
            let w2:[]u8=tmp[0..ll2];
            // "<root>-free" single token
            if(ll2>4 && z_eq(w2[ll2-4..ll2],"free")==1){
                let r2:[]u8=w2[0..ll2-4];
                if(r2.len>0 && (r2[r2.len-1] as i32)==45){r2=r2[0..r2.len-1];}
                let sl:i32=z_stem(r2,out,tmp,vb);
                if(sl>0 && sl<=32){let qq:i32=0;while(qq<sl){root[qq]=out[qq];qq=qq+1;}rl=sl;}
            }else{
                if(ll2>4 && z_eq(w2[ll2-4..ll2],"less")==1){
                    let r2:[]u8=w2[0..ll2-4];
                    if(r2.len>0 && (r2[r2.len-1] as i32)==45){r2=r2[0..r2.len-1];}
                    let sl:i32=z_stem(r2,out,tmp,vb);
                    if(sl>0 && sl<=32){let qq2:i32=0;while(qq2<sl){root[qq2]=out[qq2];qq2=qq2+1;}rl=sl;}
                }else{
                    // split tokens: "<root>" "free"
                    if((z_eq(w2,"free")==1 || z_eq(w2,"less")==1) && j+2<nt){
                        let o3:i32=a_get(ar,2*(j+2));
                        let l3:i32=a_get(ar,2*(j+2)+1);
                        // actually "not free <root>"? no: pattern is
                        // "not <root> free" -- check token j+1 is root
                        // (already have w2=="free", so look backward: skip)
                    }
                }
            }
        }
        j=j+1;
    }
    // claim subject: first content stem
    let sl0:i32=0;
    let cs:[]u8=z_alloc(32);
    if(cs.len>0){
        sl0=first_content_stem(claim,ar,nt,0,tmp,out,vb);
        if(sl0>0 && sl0<=32){let qq3:i32=0;while(qq3<sl0){cs[qq3]=out[qq3];qq3=qq3+1;}}
    }
    z_free(ar);
    if(rl==0 || sl0<=0){
        z_free(tmp);z_free(out);z_free(vb);z_free(root);z_free(cs);
        return 0;
    }
    let hit:i32=0;
    let ti:i32=0;
    while(ti<2 && hit==0){
        let tx:[]u8=title;
        if(ti==1){tx=snip;}
        let ar2:[]u8=z_alloc(1024);
        if(ar2.len>0){
            let nt2:i32=z_toks(tx,ar2,128);
            let k:i32=0;
            let roothit:i32=0;
            let subjhit:i32=0;
            while(k<nt2){
                let ko:i32=a_get(ar2,2*k);
                let kl:i32=a_get(ar2,2*k+1);
                let kll:i32=lower_copy(tx[ko..ko+kl],tmp);
                if(kll>0 && in_list(tmp[0..kll],lex_stop())==0){
                    let ksl:i32=z_stem(tx[ko..ko+kl],out,tmp,vb);
                    if(ksl==rl && z_eq(out[0..ksl],root[0..rl])==1){roothit=1;}
                    if(ksl==sl0 && z_eq(out[0..ksl],cs[0..sl0])==1){subjhit=1;}
                }
                k=k+1;
            }
            if(roothit==1 && subjhit==1){hit=1;}
            z_free(ar2);
        }
        ti=ti+1;
    }
    z_free(tmp);z_free(out);z_free(vb);z_free(root);z_free(cs);
    if(hit==1){return 1;}
    return 0;
}
// Bound violation (B37): the claim's at-most/at-least/fewer/more bound is
// contradicted by a same-unit evidence number ("only ten percent" vs
// "the whole brain" = 100%). 2 deny, 0 abstain.
fn whole_pct_word(w:[]u8)i32{
    if(z_eq(w,"whole")==1){return 1;}
    if(z_eq(w,"entire")==1){return 1;}
    if(z_eq(w,"entirety")==1){return 1;}
    if(z_eq(w,"full")==1){return 1;}
    if(z_eq(w,"complete")==1){return 1;}
    if(z_eq(w,"completely")==1){return 1;}
    if(z_eq(w,"entirely")==1){return 1;}
    return 0;
}
fn bound_violated(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let lc:[]u8=z_alloc(claim.len+1);
    if(lc.len==0){return 0;}
    let lcl:i32=lower_copy(claim,lc);
    let low:[]u8=lc[0..lcl];
    let epos:[]u8=z_alloc(8);
    if(epos.len==0){z_free(lc);return 0;}
    let btype:i32=0;
    let bval:i32=-1;
    let uoff:i32=0;
    let ulen:i32=0;
    let bi:i32=0;
    while(bi+8<lcl && btype==0){
        let bl:i32=0;
        if(match_at(low,bi,"at least")==1){btype=1;bl=9;}
        else{if(match_at(low,bi,"at most")==1){btype=2;bl=8;}
        else{if(bi+13<lcl && match_at(low,bi,"no fewer than")==1){btype=1;bl=14;}
        else{if(match_at(low,bi,"fewer than")==1){btype=3;bl=11;}
        else{if(bi+12<lcl && match_at(low,bi,"no more than")==1){btype=2;bl=13;}
        else{if(match_at(low,bi,"more than")==1){btype=4;bl=10;}
        else{if(match_at(low,bi,"only")==1){btype=2;bl=4;}
        else{if(bi+5<lcl && match_at(low,bi,"up to")==1){btype=2;bl=6;}
        else{if(bi+12<lcl && match_at(low,bi,"at a minimum")==1){btype=1;bl=13;}
        else{bi=bi+1;continue;}}}}}}}}}
        let ni:i32=bi+bl;
        while(ni<lcl && (low[ni] as i32)==32){ni=ni+1;}
        let bv:i32=-1;
        let ne:i32=ni;
        if(ni<lcl && z_isdig(low[ni] as i32)==1){
            bv=0;
            while(ne<lcl && z_isdig(low[ne] as i32)==1){
                bv=bv*10+((low[ne] as i32)-48);
                ne=ne+1;
            }
        }else{
            let fp:i32=frac_pct(low,ni,lcl,epos);
            if(fp>=0){bv=fp;ne=a_get(epos,0);}
            else{
                let vv:i64=wnum_seq(low,ni,lcl,epos);
                if(vv>=0 && vv<=2000000000){bv=vv as i32;ne=a_get(epos,0);}
            }
        }
        if(bv<0){btype=0;break;}
        let ui:i32=ne;
        while(ui<lcl && (low[ui] as i32)==32){ui=ui+1;}
        if(ui<lcl && (low[ui] as i32)==37){uoff=ui;ulen=1;}
        else{
            if(ui<lcl && (low[ui] as i32)>=97 && (low[ui] as i32)<=122){
                let r:i32=ui;
                while(r<lcl){let c2:i32=low[r] as i32;if(c2<97 || c2>122){break;}r=r+1;}
                uoff=ui;ulen=r-ui;
            }
        }
        bval=bv;
    }
    z_free(epos);
    if(btype==0 || bval<0){z_free(lc);return 0;}
    let uw:[]u8=low[uoff..uoff+ulen];
    let wantpct:i32=0;
    if(ulen==1 && (uw[0] as i32)==37){wantpct=1;}
    else{if(z_eq(uw,"percent")==1 || z_eq(uw,"percentage")==1 || z_eq(uw,"pc")==1){wantpct=1;}}
    // scan evidence for a same-unit number violating the bound
    let hit:i32=0;
    let ti:i32=0;
    while(ti<2 && hit==0){
        let tx:[]u8=title;
        if(ti==1){tx=snip;}
        let lt:[]u8=z_alloc(tx.len+1);
        if(lt.len>0){
            let ll:i32=lower_copy(tx,lt);
            let elo:[]u8=lt[0..ll];
            let ep2:[]u8=z_alloc(8);
            if(ep2.len>0){
                let i:i32=0;
                while(i<ll && hit==0){
                    let v:i32=-1;
                    let q:i32=i;
                    let ispct:i32=0;
                    if(z_isdig(elo[i] as i32)==1){
                        v=0;
                        q=i;
                        while(q<ll && z_isdig(elo[q] as i32)==1){
                            v=v*10+((elo[q] as i32)-48);
                            q=q+1;
                        }
                    }else{
                        if((elo[i] as i32)>=97 && (elo[i] as i32)<=122){
                            let r:i32=i;
                            while(r<ll){let c2:i32=elo[r] as i32;if(c2<97 || c2>122){break;}r=r+1;}
                            let w:[]u8=elo[i..r];
                            if(whole_pct_word(w)==1){v=100;q=r;}
                            else{
                                let fp2:i32=frac_pct(elo,i,ll,ep2);
                                if(fp2>=0){v=fp2;q=a_get(ep2,0);}
                                else{
                                    let vv2:i64=wnum_seq(elo,i,ll,ep2);
                                    q=a_get(ep2,0);
                                    if(vv2<0){q=i+1;}
                                    else{if(vv2<=2000000000){v=vv2 as i32;}}
                                }
                            }
                        }else{i=i+1;continue;}
                    }
                    if(v>=0){
                        // unit after the number
                        let ui2:i32=q;
                        while(ui2<ll && (elo[ui2] as i32)==32){ui2=ui2+1;}
                        let umatch:i32=0;
                        if(wantpct==1){
                            if(ui2<ll && (elo[ui2] as i32)==37){umatch=1;}
                            else{
                                if(ui2<ll && (elo[ui2] as i32)>=97 && (elo[ui2] as i32)<=122){
                                    let r2:i32=ui2;
                                    while(r2<ll){let c3:i32=elo[r2] as i32;if(c3<97 || c3>122){break;}r2=r2+1;}
                                    let uw2:[]u8=elo[ui2..r2];
                                    if(z_eq(uw2,"percent")==1 || z_eq(uw2,"percentage")==1){umatch=1;}
                                }
                            }
                            // "the whole brain" with no unit word: in a
                            // percent-bound context, a bare whole=100
                            // counts as percent.
                            if(umatch==0 && v==100){umatch=1;}
                        }else{
                            if(ulen>0 && ui2<ll && (elo[ui2] as i32)>=97 && (elo[ui2] as i32)<=122){
                                let r3:i32=ui2;
                                while(r3<ll){let c4:i32=elo[r3] as i32;if(c4<97 || c4>122){break;}r3=r3+1;}
                                if(z_eq(elo[ui2..r3],uw)==1){umatch=1;}
                            }
                        }
                        if(umatch==1){
                            if(btype==2 && v>bval){hit=1;}
                            else{if(btype==1 && v<bval){hit=1;}
                            else{if(btype==3 && v>=bval){hit=1;}
                            else{if(btype==4 && v<=bval){hit=1;}}}}
                        }
                    }
                    i=q;
                }
                z_free(ep2);
            }
            z_free(lt);
        }
        ti=ti+1;
    }
    z_free(lc);
    if(hit==1){return 2;}
    return 0;
}
// Antonym deny (B04/B05/B34): the claim's predicate adjective ("are
// blind") or modal+verb ("can fly") has an antonym in the evidence
// attaching to the same subject ("Bats are blind" vs "see well";
// "Penguins can fly" vs "flightless birds"; "All swans are white" vs
// "Black swans"). 2 deny, 0 abstain.
fn antonym_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    if(ar.len==0 || tmp.len==0 || out.len==0 || vb.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);
        return 0;
    }
    let nt:i32=z_toks(claim,ar,64);
    let pred:[]u8=z_alloc(32);
    let pl:i32=0;
    if(pred.len==0){
        z_free(ar);z_free(tmp);z_free(out);z_free(vb);z_free(pred);
        return 0;
    }
    let j:i32=0;
    while(j<nt && pl==0){
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        let iscop:i32=0;
        if(z_eq(w,"is")==1 || z_eq(w,"are")==1 || z_eq(w,"was")==1 || z_eq(w,"were")==1){iscop=1;}
        if(iscop==1 || z_eq(w,"can")==1 || z_eq(w,"could")==1){
            if(j+1<nt){
                let o2:i32=a_get(ar,2*(j+1));
                let l2:i32=a_get(ar,2*(j+1)+1);
                let sl:i32=z_stem(claim[o2..o2+l2],out,tmp,vb);
                if(sl>0 && sl<=32){
                    let qq:i32=0;
                    while(qq<sl){pred[qq]=out[qq];qq=qq+1;}
                    pl=sl;
                }
            }
        }
        j=j+1;
    }
    let sl0:i32=first_content_stem(claim,ar,nt,0,tmp,out,vb);
    let cs:[]u8=z_alloc(32);
    if(cs.len>0 && sl0>0 && sl0<=32){
        let qq2:i32=0;
        while(qq2<sl0){cs[qq2]=out[qq2];qq2=qq2+1;}
    }
    z_free(ar);
    if(pl==0 || sl0<=0){
        z_free(tmp);z_free(out);z_free(vb);z_free(pred);z_free(cs);
        return 0;
    }
    let hit:i32=0;
    let ti:i32=0;
    while(ti<2 && hit==0){
        let tx:[]u8=title;
        if(ti==1){tx=snip;}
        let ar2:[]u8=z_alloc(1024);
        if(ar2.len>0){
            let nt2:i32=z_toks(tx,ar2,128);
            let k:i32=0;
            let anthit:i32=0;
            let subjhit:i32=0;
            while(k<nt2){
                let ko:i32=a_get(ar2,2*k);
                let kl:i32=a_get(ar2,2*k+1);
                let kll:i32=lower_copy(tx[ko..ko+kl],tmp);
                // round-6: on/off are stopwords but carry antonym signal
                if(kll>0 && (in_list(tmp[0..kll],lex_stop())==0 || z_eq(tmp[0..kll],"on")==1 || z_eq(tmp[0..kll],"off")==1)){
                    let ksl:i32=z_stem(tx[ko..ko+kl],out,tmp,vb);
                    if(ksl>0){
                        if(antonym(out[0..ksl],pred[0..pl])==1){
                            // r7c (A24): a negated gradable antonym ("not hot")
                            // does not contradict the claim predicate ("cold").
                            let gad2:i32=gradable_antonym(pred[0..pl],out[0..ksl]);
                            let neg2:i32=0;
                            if(gad2==1){
                                let b:i32=k-1;
                                while(b>=0 && b>=k-2 && neg2==0){
                                    let bo:i32=a_get(ar2,2*b);
                                    let bl:i32=a_get(ar2,2*b+1);
                                    let bll:i32=lower_copy(tx[bo..bo+bl],tmp);
                                    if(is_negword(tmp[0..bll])==1){neg2=1;}
                                    b=b-1;
                                }
                            }
                            if(gad2==0 || neg2==0){anthit=1;}
                        }
                        if(ksl==sl0 && z_eq(out[0..ksl],cs[0..sl0])==1){subjhit=1;}
                    }
                }
                k=k+1;
            }
            if(anthit==1 && subjhit==1){hit=1;}
            z_free(ar2);
        }
        ti=ti+1;
    }
    z_free(tmp);z_free(out);z_free(vb);z_free(pred);z_free(cs);
    if(hit==1){return 2;}
    return 0;
}
// 1 if the claim contains the word "exactly", else 0.
fn claim_has_exactly(claim:[]u8)i32{
    let lcx:[]u8=z_alloc(claim.len+1);
    if(lcx.len==0){return 0;}
    let lclx:i32=lower_copy(claim,lcx);
    let low:[]u8=lcx[0..lclx];
    let bix:i32=0;
    let hit:i32=0;
    while(bix+7<=lclx && hit==0){
        if(match_at(low,bix,"exactly")==1){hit=1;}
        bix=bix+1;
    }
    z_free(lcx);
    return hit;
}
fn numeric_guard(claim:[]u8,title:[]u8,snip:[]u8)i32{
    // Interval-aware bound pre-check (fix #4): "at least N", "at most N",
    // "fewer than N", "more than N" in the claim. If the evidence contains
    // a number satisfying the bound, the numbers are compatible -> return 1
    // (affirm signal). This handles RT4 R26/R27/R28.
    if(bound_satisfied(claim,title,snip)==1){return 1;}
    // Bound violation: claim's at-most/at-least bound contradicted by a
    // same-unit evidence number ("only ten percent" vs "the whole brain").
    if(bound_violated(claim,title,snip)==2){return 2;}
    // Taxonomic class exclusivity: "Dolphins are fish" vs "are mammals".
    if(class_exclusive_deny(claim,title,snip)==2){return 2;}
    // Expert "warn against" deny phrase.
    if(warn_against_deny(claim,title,snip)==2){return 2;}
    // "not X-free" asserts the presence of X.
    if(notxfree_affirm(claim,title,snip)==1){return 1;}
    // Predicate antonym with the same subject ("are blind" vs "see").
    if(antonym_deny(claim,title,snip)==2){return 2;}
    // Claim subject stems for clause-level matching below.
    let tmpS:[]u8=z_alloc(64);
    let outS:[]u8=z_alloc(32);
    let vbS:[]u8=z_alloc(64);
    let arS:[]u8=z_alloc(512);
    let subjA:[]u8=z_alloc(32);
    let firstA:[]u8=z_alloc(32);
    let subjAl:i32=0;
    let firstAl:i32=0;
    if(tmpS.len>0 && outS.len>0 && vbS.len>0 && arS.len>0 && subjA.len>0 && firstA.len>0){
        let nts:i32=z_toks(claim,arS,64);
        let jS:i32=0;
        while(jS<nts){
            let so:i32=a_get(arS,2*jS);
            let sl2:i32=a_get(arS,2*jS+1);
            let stl:i32=z_stem(claim[so..so+sl2],outS,tmpS,vbS);
            if(stl>0 && stl<=32){
                if(subjAl==0){
                    let qq:i32=0;
                    while(qq<stl){subjA[qq]=outS[qq];qq=qq+1;}
                    subjAl=stl;
                }
                let llS:i32=lower_copy(claim[so..so+sl2],tmpS);
                if(firstAl==0 && llS>0 && in_list(tmpS[0..llS],lex_stop())==0){
                    let qq2:i32=0;
                    while(qq2<stl){firstA[qq2]=outS[qq2];qq2=qq2+1;}
                    firstAl=stl;
                }
            }
            jS=jS+1;
        }
    }
    z_free(tmpS);z_free(outS);z_free(vbS);z_free(arS);
    // Year->century: "not built in the twentieth century" vs "1889".
    let cc:i32=century_check(claim,title,snip);
    if(cc==2){z_free(subjA);z_free(firstA);return 2;}
    if(cc==1){z_free(subjA);z_free(firstA);return 1;}
    // Zero quantifier vs positive count: "no books" vs "400 volumes".
    if(zero_quant_deny(claim,title,snip)==2){z_free(subjA);z_free(firstA);return 2;}
    // Comparative numerics: "faster than" vs measured speeds.
    if(comparative_numeric(claim,title,snip)==2){z_free(subjA);z_free(firstA);return 2;}
    // Superlative rivalry: "tallest" vs "taller than" / rival "closest".
    if(superlative_deny(claim,title,snip)==2){z_free(subjA);z_free(firstA);return 2;}
    // Exact-N via compound word numbers (B11): "twenty-one" + single-number
    // claim + evidence matching number -> affirm signal.
    let epos:[]u8=z_alloc(8);
    let epos2:[]u8=z_alloc(8);
    if(epos.len>0 && epos2.len>0){
        let ncl2:i32=wnum_seq(claim,0,claim.len,epos);
        let cl_end:i32=a_get(epos,0);
        let hasnum:i32=0;
        if(ncl2>=0){
            hasnum=1;
            let p:i32=cl_end;
            while(p<claim.len){
                let ch:i32=claim[p] as i32;
                if(z_isdig(ch)==1 || (ch>=97 && ch<=122)){
                    let v2:i64=wnum_seq(claim,p,claim.len,epos2);
                    if(v2<0){break;}
                    if(v2!=ncl2){hasnum=0;}
                    p=a_get(epos2,0);
                }else{p=p+1;}
            }
        }
        if(ncl2>=0 && hasnum==1 && (ev_has_satisfying(title,5,ncl2)==1 || ev_has_satisfying(snip,5,ncl2)==1)){
            z_free(epos);z_free(epos2);
            z_free(subjA);z_free(firstA);
            return 1;
        }
    }
    z_free(epos);z_free(epos2);
    // Claim-level do-support and negated-verb clause tokens.
    let tokC:[]u8=z_alloc(1024);
    let stemC:[]u8=z_alloc(1024);
    let cstmC:[]u8=z_alloc(1024);
    if(tokC.len>0 && stemC.len>0 && cstmC.len>0){
        let nct:i32=z_toks(claim,tokC,128);
        let tmp3:[]u8=z_alloc(64);
        let out3:[]u8=z_alloc(32);
        let vb3:[]u8=z_alloc(64);
        if(tmp3.len>0 && out3.len>0 && vb3.len>0){
            let ncs3:i32=0;
            let coff3:i32=0;
            let j3:i32=0;
            while(j3<nct){
                let to3:i32=a_get(tokC,2*j3);
                let tl3:i32=a_get(tokC,2*j3+1);
                let sl3:i32=z_stem(claim[to3..to3+tl3],out3,tmp3,vb3);
                if(sl3>0 && coff3+sl3<=1024 && ncs3<128){
                    let qq2:i32=0;
                    while(qq2<sl3){stemC[coff3+qq2]=out3[qq2];qq2=qq2+1;}
                    a_put(cstmC,2*ncs3,coff3);
                    a_put(cstmC,2*ncs3+1,sl3);
                    coff3=coff3+sl3;
                    ncs3=ncs3+1;
                }
                j3=j3+1;
            }
            // do-support: claim's last non-aux verb vs evidence clauses.
            // Each clause is tokenized separately: dosupport_deny needs
            // the CLAUSE's token offsets, not the claim's.
            // Skip if the claim itself is negated: "does not cure" vs
            // "does not cure" is agreement, not contradiction.
            let vm:[]u8=z_alloc(32);
            let tokE:[]u8=z_alloc(1024);
            if(vm.len>0 && tokE.len>0){
                let vml:i32=claim_verb_stem(claim,tokC,nct,tmp3,out3,vb3,vm);
                let cneg:i32=0;
                let cnj:i32=0;
                while(cnj<nct){
                    let cto:i32=a_get(tokC,2*cnj);
                    let ctl:i32=a_get(tokC,2*cnj+1);
                    let cll:i32=lower_copy(claim[cto..cto+ctl],tmp3);
                    if(cll>0 && in_list(tmp3[0..cll],lex_neg())==1){cneg=1;break;}
                    cnj=cnj+1;
                }
                if(vml>0 && cneg==0){
                    let dei:i32=0;
                    let dfound:i32=0;
                    while(dei<2 && dfound==0){
                        let dtx:[]u8=title;
                        if(dei==1){dtx=snip;}
                        let dnt:i32=z_toks(dtx,tokE,128);
                        if(dosupport_deny(dtx,tokE,dnt,vm[0..vml],subjA[0..subjAl],firstA[0..firstAl],tmp3)==1){
                            dfound=1;
                        }
                        dei=dei+1;
                    }
                    if(dfound==1){
                        z_free(tokC);z_free(stemC);z_free(cstmC);
                        z_free(tmp3);z_free(out3);z_free(vb3);z_free(vm);z_free(tokE);
                        z_free(subjA);z_free(firstA);
                        return 2;
                    }
                }
                z_free(vm);z_free(tokE);
            }
            // "not X-free" is handled by the clause scanner below; the
            // meta-frame ("Contrary to...", "Unlike X,") is stripped at
            // the r12_classify call site, so matching proceeds on the
            // matrix claim.
            z_free(tmp3);z_free(out3);z_free(vb3);
        }
        z_free(tokC);z_free(stemC);z_free(cstmC);
    }
    // Negated-verb antonyms (B24/B25): "No student failed" vs "all passed".
    if(is_polflip_claim(claim)==1){
        let pv:[]u8=z_alloc(32);
        if(pv.len>0){
            let ar4:[]u8=z_alloc(512);
            if(ar4.len>0){
                let nt4:i32=z_toks(claim,ar4,64);
                let tmp4:[]u8=z_alloc(64);
                let out4:[]u8=z_alloc(32);
                let vb4:[]u8=z_alloc(64);
                if(tmp4.len>0 && out4.len>0 && vb4.len>0){
                    let j4:i32=1;
                    let found:i32=0;
                    while(j4<nt4 && found==0){
                        let jo:i32=a_get(ar4,2*j4);
                        let jl:i32=a_get(ar4,2*j4+1);
                        let sl4:i32=z_stem(claim[jo..jo+jl],out4,tmp4,vb4);
                        let ant:[]u8=negverb_antonym(out4[0..sl4]);
                        if(sl4>0 && ant.len>0){
                            let qq:i32=0;
                            while(qq<ant.len && qq<32){pv[qq]=ant[qq];qq=qq+1;}
                            found=ant.len;
                        }
                        j4=j4+1;
                    }
                    if(found>0){
                        let ti2:i32=0;
                        let done:i32=0;
                        while(ti2<2 && done==0){
                            let tx:[]u8=title;
                            if(ti2==1){tx=snip;}
                            if(has_positive_number(tx)==1){
                                let nt5:i32=z_toks(tx,ar4,128);
                                let esl:i32=first_content_stem(tx,ar4,nt5,0,tmp4,out4,vb4);
                                let sm:i32=0;
                                if(esl>0 && esl==subjAl && z_eq(out4[0..esl],subjA[0..subjAl])==1){sm=1;}
                                if(firstAl>0 && esl==firstAl && z_eq(out4[0..esl],firstA[0..firstAl])==1){sm=1;}
                                if(sm==1){
                                    z_free(ar4);z_free(tmp4);z_free(out4);z_free(vb4);z_free(pv);
                                    z_free(subjA);z_free(firstA);
                                    return 1;
                                }
                            }
                            ti2=ti2+1;
                        }
                    }
                    z_free(tmp4);z_free(out4);z_free(vb4);
                }
                z_free(ar4);
            }
            z_free(pv);
        }
    }
    // "X never P" vs evidence of repeated P (B36 temporal universal).
    let tmpN:[]u8=z_alloc(64);
    let outN:[]u8=z_alloc(32);
    let vbN:[]u8=z_alloc(64);
    let arN:[]u8=z_alloc(512);
    if(tmpN.len>0 && outN.len>0 && vbN.len>0 && arN.len>0){
        let ntN:i32=z_toks(claim,arN,64);
        let vmN:[]u8=z_alloc(32);
        if(vmN.len>0){
            let vmlN:i32=claim_verb_stem(claim,arN,ntN,tmpN,outN,vbN,vmN);
            if(vmlN>0 && never_falsified(claim,title,snip,vmN[0..vmlN],subjA[0..subjAl])==1){
                z_free(tmpN);z_free(outN);z_free(vbN);z_free(arN);z_free(vmN);
                z_free(subjA);z_free(firstA);
                return 2;
            }
            z_free(vmN);
        }
    }
    z_free(tmpN);z_free(outN);z_free(vbN);z_free(arN);
    z_free(subjA);z_free(firstA);
    let ca:[]u8=z_alloc(80);
    if(ca.len==0){return 0;}
    let nc:i32=ev_scan(claim,ca[0..16],ca[16..32],ca[32..48],ca[48..64],ca[64..80],0,1,0,0);
    if(nc==0){z_free(ca);return 0;}
    let cv:i32=a_get(ca,nc-1);
    let cu:i32=a_get(ca[32..48],nc-1);
    let cfl:i32=a_get(ca[48..64],nc-1);
    let cap:i32=cfl & 1;
    let camb:i32=(cfl>>1) & 1;
    let cnh:i32=a_get(ca[64..80],nc-1);
    z_free(ca);
    // claim phenomenon + entity classes (drive the evidence gates)
    let lc:[]u8=z_alloc(claim.len+1);
    if(lc.len==0){return 0;}
    let lcl:i32=lower_copy(claim,lc);
    let qphenom:i32=0;
    if(phenom_words_in(lc,0,lcl,1)==1){qphenom=1;}
    else{if(phenom_words_in(lc,0,lcl,2)==1){qphenom=2;}}
    let qent:i32=0;
    if(ent_words_in(lc,0,lcl,1)==1){qent=1;}
    z_free(lc);
    let ea:[]u8=z_alloc(320);
    if(ea.len==0){return 0;}
    let eb:[]u8=z_alloc(320);
    if(eb.len==0){z_free(ea);return 0;}
    let ne:i32=scan_ev_text(title,ea,0,qphenom,qent,eb,cv,cu,cap,camb,cnh);
    ne=scan_ev_text(snip,ea,ne,qphenom,qent,eb,cv,cu,cap,camb,cnh);
    z_free(eb);
    if(ne==0){z_free(ea);return 0;}
    // "exactly N" claims require an exact evidence match; a range
    // containing N does not confirm "exactly N" (A19).
    let has_exactly:i32=claim_has_exactly(claim);
    let compat:i32=0;
    let hadcmp:i32=0;
    let e:i32=0;
    while(e<ne){
        let elo:i32=a_get(ea,e);
        let ehi:i32=a_get(ea[64..128],e);
        let efl:i32=a_get(ea[192..256],e);
        let eap:i32=efl & 1;
        let r:i32=cmp_entry(elo,ehi,eap,(efl>>1) & 1,a_get(ea[128..192],e),a_get(ea[256..320],e),cv,cu,cap,camb,cnh);
        if(r==1){
            // "exactly" + range (not a point match) is not confirmation.
            // If the range is approximate ("roughly"), it's neutral;
            // otherwise deny to block a false affirm.
            if(has_exactly==1 && (elo!=ehi || elo!=cv)){
                if(eap==0){hadcmp=1;}
            }
            else{compat=1;hadcmp=1;}
        }
        else{if(r==2){hadcmp=1;}}
        e=e+1;
    }
    z_free(ea);
    if(compat==1){return 0;}
    if(hadcmp==1){return 2;}
    // abstain: not comparable, or no evidence numbers -- pass through and
    // let normal classification continue (never veto an endorse).
    return 0;
}
// ==================== B4 CQHT helpers ====================
fn tok_is(t:[]u8,ar:[]u8,idx:i32,lit:[]u8,tmp:[]u8)i32{
    let to:i32=a_get(ar,2*idx);
    let tl:i32=a_get(ar,2*idx+1);
    let ll:i32=lower_copy(t[to..to+tl],tmp);
    return z_eq(tmp[0..ll],lit);
}
fn quant_code(w:[]u8)i32{
    if(z_eq(w,"all")==1){return 1;}
    if(z_eq(w,"every")==1){return 1;}
    if(z_eq(w,"each")==1){return 1;}
    if(z_eq(w,"most")==1){return 2;}
    if(z_eq(w,"many")==1){return 3;}
    if(z_eq(w,"some")==1){return 4;}
    if(z_eq(w,"several")==1){return 4;}
    if(z_eq(w,"one")==1){return 5;}
    if(z_eq(w,"few")==1){return 6;}
    if(z_eq(w,"no")==1){return 7;}
    if(z_eq(w,"none")==1){return 7;}
    if(z_eq(w,"neither")==1){return 7;}
    return 0;
}
fn prefix_match(a:[]u8,b:[]u8)i32{
    let m:i32=a.len;
    if(b.len<m){m=b.len;}
    if(m<4){return 0;}
    let k:i32=0;
    while(k<m){
        if((a[k] as i32)!=(b[k] as i32)){return 0;}
        k=k+1;
    }
    return 1;
}
fn stemset(t:[]u8,co:i32,cl:i32,rlo:i32,rhi:i32,elo:i32,ehi:i32,tokar:[]u8,star:[]u8,sb:[]u8,sbcap:i32,max:i32,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let txt:[]u8=t[co..co+cl];
    let nt:i32=z_toks(txt,tokar,128);
    let n2:i32=0;
    let soff:i32=0;
    let j:i32=0;
    while(j<nt && n2<max){
        if(j<rlo || j>=rhi){j=j+1;continue;}
        if(j>=elo && j<ehi){j=j+1;continue;}
        let to:i32=a_get(tokar,2*j);
        let tl:i32=a_get(tokar,2*j+1);
        let ll:i32=lower_copy(txt[to..to+tl],tmp);
        if(ll==0){j=j+1;continue;}
        if(in_list(tmp[0..ll],lex_stop())==1){j=j+1;continue;}
        let sl:i32=z_stem(txt[to..to+tl],out,tmp,vb);
        if(sl<1 || soff+sl>sbcap){j=j+1;continue;}
        let q:i32=0;
        while(q<sl){sb[soff+q]=out[q];q=q+1;}
        a_put(star,2*n2,soff);
        a_put(star,2*n2+1,sl);
        soff=soff+sl;
        n2=n2+1;
        j=j+1;
    }
    return n2;
}
fn anchor_left(t:[]u8,ar:[]u8,nct:i32,m:i32,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let j:i32=m-1;
    while(j>=0){
        if(tok_num(t,ar,j,tmp)>=0){j=j-1;continue;}
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(t[to..to+tl],tmp);
        if(ll>0 && in_list(tmp[0..ll],lex_stop())==0){
            return z_stem(t[to..to+tl],out,tmp,vb);
        }
        j=j-1;
    }
    return 0;
}
fn anchor_right(t:[]u8,ar:[]u8,nct:i32,m:i32,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let j:i32=m+1;
    while(j<nct){
        if(tok_num(t,ar,j,tmp)>=0){j=j+1;continue;}
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(t[to..to+tl],tmp);
        if(ll>0 && in_list(tmp[0..ll],lex_stop())==0){
            return z_stem(t[to..to+tl],out,tmp,vb);
        }
        j=j+1;
    }
    return 0;
}
fn tok_num(t:[]u8,ar:[]u8,idx:i32,tmp:[]u8)i32{
    let to:i32=a_get(ar,2*idx);
    let tl:i32=a_get(ar,2*idx+1);
    let ll:i32=lower_copy(t[to..to+tl],tmp);
    if(ll==0){return -1;}
    let v:i32=0;
    let nd:i32=0;
    let k:i32=0;
    while(k<ll){
        let b:i32=tmp[k] as i32;
        if(b==44){k=k+1;continue;}
        if(b<48 || b>57){return -1;}
        if(nd>=10){return -1;}
        v=v*10+(b-48);
        nd=nd+1;
        k=k+1;
    }
    if(nd==0){return -1;}
    return v;
}
fn comp_word(s:[]u8)i32{
    if(z_eq(s,"more")==1){return 1;}
    if(z_eq(s,"fewer")==1){return 1;}
    if(z_eq(s,"less")==1){return 1;}
    let n:i32=s.len;
    if(n>3 && (s[n-2] as i32)==101 && (s[n-1] as i32)==114){return 1;}
    return 0;
}
fn cpair(a:[]u8,b:[]u8,x:[]u8,y:[]u8)i32{
    if(z_eq(a,x)==1 && z_eq(b,y)==1){return 1;}
    if(z_eq(a,y)==1 && z_eq(b,x)==1){return 1;}
    return 0;
}
fn antonym_pair(a:[]u8,b:[]u8)i32{
    if(cpair(a,b,"faster","slower")==1){return 1;}
    if(cpair(a,b,"bigger","smaller")==1){return 1;}
    if(cpair(a,b,"taller","shorter")==1){return 1;}
    if(cpair(a,b,"hotter","colder")==1){return 1;}
    if(cpair(a,b,"older","younger")==1){return 1;}
    if(cpair(a,b,"more","fewer")==1){return 1;}
    if(cpair(a,b,"more","less")==1){return 1;}
    if(cpair(a,b,"better","worse")==1){return 1;}
    if(cpair(a,b,"larger","smaller")==1){return 1;}
    if(cpair(a,b,"greater","lesser")==1){return 1;}
    if(cpair(a,b,"higher","lower")==1){return 1;}
    if(cpair(a,b,"longer","shorter")==1){return 1;}
    if(cpair(a,b,"stronger","weaker")==1){return 1;}
    if(cpair(a,b,"earlier","later")==1){return 1;}
    return 0;
}
fn cond_satisfied(t:[]u8,clauA:[]u8,ncl:i32,c:i32,alo:i32,ahi:i32,stemA:[]u8,cstemA:[]u8,ncs:i32,SAT_TOK:[]u8,SAT_STM:[]u8,SAT_SB:[]u8,tmpS:[]u8,outS:[]u8,vbS:[]u8)i32{
    let co_c:i32=a_get(clauA,2*c);
    let cl_c:i32=a_get(clauA,2*c+1);
    let starA:[]u8=SAT_STM[0..256];
    let sbA:[]u8=SAT_SB[0..700];
    let starS:[]u8=SAT_STM[256..1024];
    let sbS:[]u8=SAT_SB[700..2000];
    let nA:i32=stemset(t,co_c,cl_c,alo,ahi,-1,-1,SAT_TOK,starA,sbA,700,32,tmpS,outS,vbS);
    if(nA==0){return 0;}
    let d:i32=0;
    while(d<ncl){
        let co:i32=a_get(clauA,2*d);
        let cl:i32=a_get(clauA,2*d+1);
        let nS:i32=0;
        if(d==c){
            nS=stemset(t,co,cl,0,1000000,alo,ahi,SAT_TOK,starS,sbS,1300,96,tmpS,outS,vbS);
        }else{
            nS=stemset(t,co,cl,0,1000000,-1,-1,SAT_TOK,starS,sbS,1300,96,tmpS,outS,vbS);
        }
        let m1:i32=0;
        let nums:i32=0;
        let ia:i32=0;
        while(ia<nA){
            let ao:i32=a_get(starA,2*ia);
            let al:i32=a_get(starA,2*ia+1);
            let a:[]u8=sbA[ao..ao+al];
            let hit:i32=0;
            let is2:i32=0;
            while(is2<nS){
                let so:i32=a_get(starS,2*is2);
                let sl:i32=a_get(starS,2*is2+1);
                if(prefix_match(a,sbS[so..so+sl])==1){hit=1;break;}
                is2=is2+1;
            }
            if(hit==1){m1=m1+1;}
            if(al>0 && (a[0] as i32)>=48 && (a[0] as i32)<=57){
                if(in_stems(a,sbS,starS,nS)==1){nums=nums+1;}
            }
            ia=ia+1;
        }
        if(m1>=2){return 1;}
        if(nums>=1){return 1;}
        if(m1>=1){
            let m2:i32=0;
            let ik:i32=0;
            while(ik<ncs){
                let ko:i32=a_get(cstemA,2*ik);
                let kl:i32=a_get(cstemA,2*ik+1);
                if(in_stems(stemA[ko..ko+kl],sbS,starS,nS)==1){m2=m2+1;}
                ik=ik+1;
            }
            if(m2>=1){return 1;}
        }
        d=d+1;
    }
    return 0;
}
fn temporal_decide(claim:[]u8,toka:[]u8,nctA:i32,full:[]u8,tokb:[]u8,nft:i32,sc:[]u8)i32{
    let tmp:[]u8=sc[89216..93312];
    let out:[]u8=sc[12800..13312];
    let vb:[]u8=sc[13312..13440];
    let has:i32=0;
    let m0:i32=0;
    while(m0<nctA){
        if(tok_is(claim,toka,m0,"before",tmp)==1){has=1;break;}
        if(tok_is(claim,toka,m0,"after",tmp)==1){has=1;break;}
        m0=m0+1;
    }
    if(has==0){return -1;}
    let oA:[]u8=out[0..128];
    let oB:[]u8=out[128..256];
    let oC:[]u8=out[256..384];
    let oD:[]u8=out[384..512];
    // (1) same entity, different date -> DENY
    let di:i32=0;
    while(di<nctA){
        let dv:i32=tok_num(claim,toka,di,tmp);
        if(dv>=0){
            let al:i32=anchor_left(claim,toka,nctA,di,tmp,oA,vb);
            if(al>0){
                let ej:i32=0;
                while(ej<nft){
                    let ev2:i32=tok_num(full,tokb,ej,tmp);
                    if(ev2>=0){
                        let bl:i32=anchor_left(full,tokb,nft,ej,tmp,oC,vb);
                        if(bl>0 && z_eq(oA[0..al],oC[0..bl])==1 && dv!=ev2){return 2;}
                    }
                    ej=ej+1;
                }
            }
        }
        di=di+1;
    }
    // (2)(3) order pairs, normalized to earlier(A,B)
    let allconf:i32=1;
    let anypair:i32=0;
    let m:i32=0;
    while(m<nctA){
        let rel:i32=-1;
        if(tok_is(claim,toka,m,"before",tmp)==1){rel=0;}
        else{
            if(tok_is(claim,toka,m,"after",tmp)==1){rel=1;}
        }
        if(rel>=0){
            let al:i32=anchor_left(claim,toka,nctA,m,tmp,oA,vb);
            let bl:i32=anchor_right(claim,toka,nctA,m,tmp,oB,vb);
            if(al>0 && bl>0){
                anypair=1;
                let cA:[]u8=oA[0..al];
                let cB:[]u8=oB[0..bl];
                if(rel==1){cA=oB[0..bl];cB=oA[0..al];}
                let conf:i32=0;
                let e:i32=0;
                while(e<nft && conf==0){
                    let erel:i32=-1;
                    if(tok_is(full,tokb,e,"before",tmp)==1){erel=0;}
                    else{
                        if(tok_is(full,tokb,e,"after",tmp)==1){erel=1;}
                        else{
                            // round-6: "X, then Y" = X before Y
                            if(tok_is(full,tokb,e,"then",tmp)==1){erel=0;}
                        }
                    }
                    if(erel>=0){
                        let al2:i32=anchor_left(full,tokb,nft,e,tmp,oC,vb);
                        let bl2:i32=anchor_right(full,tokb,nft,e,tmp,oD,vb);
                        if(al2>0 && bl2>0){
                            let pA:[]u8=oC[0..al2];
                            let pB:[]u8=oD[0..bl2];
                            if(erel==1){pA=oD[0..bl2];pB=oC[0..al2];}
                            if(z_eq(cA,pA)==1 && z_eq(cB,pB)==1){conf=1;}
                            else{
                                if(z_eq(cA,pB)==1 && z_eq(cB,pA)==1){return 2;}
                            }
                        }
                    }
                    e=e+1;
                }
                if(conf==0){
                    let dA:i32=-1;
                    let dB:i32=-1;
                    let f:i32=0;
                    while(f<nft){
                        let fv:i32=tok_num(full,tokb,f,tmp);
                        if(fv>=0){
                            let fl:i32=anchor_left(full,tokb,nft,f,tmp,oC,vb);
                            if(fl>0){
                                if(z_eq(cA,oC[0..fl])==1){dA=fv;}
                                if(z_eq(cB,oC[0..fl])==1){dB=fv;}
                            }
                        }
                        f=f+1;
                    }
                    if(dA>=0 && dB>=0){
                        if(dA<dB){conf=1;}
                        else{return 2;}
                    }
                }
                if(conf==0){allconf=0;}
            }
        }
        m=m+1;
    }
    if(anypair==1 && allconf==1){return 1;}
    return 0;
}
fn comp_decide(claim:[]u8,toka:[]u8,nctA:i32,full:[]u8,tokb:[]u8,nft:i32,sc:[]u8)i32{
    let tmp:[]u8=sc[89216..93312];
    let out:[]u8=sc[12800..13312];
    let vb:[]u8=sc[13312..13440];
    let sb:[]u8=sc[104352..106352];
    let m:i32=-1;
    let i0:i32=0;
    while(i0<nctA){
        if(tok_is(claim,toka,i0,"than",tmp)==1){m=i0;break;}
        i0=i0+1;
    }
    if(m<1){return -1;}
    let sC:[]u8=sb[0..128];
    let sE1:[]u8=sb[128..256];
    let sE2:[]u8=sb[256..384];
    // comparative word: token m-1, else token m-2 ("more apples than")
    let cidx:i32=-1;
    let cl2:i32=0;
    let cto:i32=a_get(toka,2*(m-1));
    let ctl:i32=a_get(toka,2*(m-1)+1);
    cl2=z_stem(claim[cto..cto+ctl],sC,tmp,vb);
    if(cl2>0 && comp_word(sC[0..cl2])==1){cidx=m-1;}
    else{
        if(m>=2){
            let ct2:i32=a_get(toka,2*(m-2));
            let clt2:i32=a_get(toka,2*(m-2)+1);
            cl2=z_stem(claim[ct2..ct2+clt2],sC,tmp,vb);
            if(cl2>0 && comp_word(sC[0..cl2])==1){cidx=m-2;}
        }
    }
    if(cidx<0){return 0;}
    let al:i32=anchor_left(claim,toka,nctA,cidx,tmp,sE1,vb);
    let bl:i32=anchor_right(claim,toka,nctA,m,tmp,sE2,vb);
    if(al==0 || bl==0){return 0;}
    let oA:[]u8=out[0..128];
    let oB:[]u8=out[128..256];
    let oC:[]u8=out[256..384];
    let oD:[]u8=out[384..512];
    let aff:i32=0;
    let e:i32=0;
    while(e<nft){
        if(tok_is(full,tokb,e,"than",tmp)==1 && e>=1){
            let ecidx:i32=-1;
            let el2:i32=0;
            let eto:i32=a_get(tokb,2*(e-1));
            let etl:i32=a_get(tokb,2*(e-1)+1);
            el2=z_stem(full[eto..eto+etl],oA,tmp,vb);
            if(el2>0 && comp_word(oA[0..el2])==1){ecidx=e-1;}
            else{
                if(e>=2){
                    let et2:i32=a_get(tokb,2*(e-2));
                    let el2t:i32=a_get(tokb,2*(e-2)+1);
                    el2=z_stem(full[et2..et2+el2t],oA,tmp,vb);
                    if(el2>0 && comp_word(oA[0..el2])==1){ecidx=e-2;}
                }
            }
            if(ecidx>=0){
                let fl:i32=anchor_left(full,tokb,nft,ecidx,tmp,oB,vb);
                let gl:i32=anchor_right(full,tokb,nft,e,tmp,oC,vb);
                if(fl>0 && gl>0){
                    if(z_eq(sE1[0..al],oB[0..fl])==1 && z_eq(sE2[0..bl],oC[0..gl])==1){
                        if(z_eq(sC[0..cl2],oA[0..el2])==1){aff=1;}
                        else{
                            if(antonym_pair(sC[0..cl2],oA[0..el2])==1){return 2;}
                        }
                    }
                    else{
                        if(z_eq(sE1[0..al],oC[0..gl])==1 && z_eq(sE2[0..bl],oB[0..fl])==1){
                            if(z_eq(sC[0..cl2],oA[0..el2])==1){return 2;}
                        }
                    }
                }
            }
        }
        e=e+1;
    }
    if(aff==1){return 1;}
    return 0;
}
// ==================== merged neg_scope ====================
fn neg_scope(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,firstA:[]u8,subjA:[]u8,pred:[]u8,cadj:[]u8,tmp:[]u8)i32{
    if(pi<0 || pi>=nct){return 0;}
    // (A) cleft subject-contrast deny: "It is not <claim-subj> but <other>
    // that <pred>" -- the claim's subject is explicitly excluded.
    let m:i32=0;
    while(m<nct){
        if(neg_marker_at(clause,tokC,nct,m,tmp)==1 && m>0){
            let nx0:i32=next_content(clause,tokC,nct,m,tmp);
            if(nx0>=0){
                let so0:i32=a_get(cstmC,2*nx0);
                let sl0:i32=a_get(cstmC,2*nx0+1);
                let sx0:[]u8=stemC[so0..so0+sl0];
                if(z_eq(sx0,firstA)==1 || z_eq(sx0,subjA)==1){
                    let b0:i32=find_word(clause,tokC,nct,"but",nx0,tmp);
                    if(b0>nx0 && b0<pi){return 1;}
                }
            }
        }
        m=m+1;
    }
    // "whether" after pi hedges pre-pi markers away (proposition unknown).
    let wheth:i32=find_word(clause,tokC,nct,"whether",pi+1,tmp);
    // B3-CAU guards: (ce) a "because of" adjunct after pi means a
    // pre-predicate marker scopes the explanation, not the proposition;
    // (sj/snc) a marker directly before a non-claim subject belongs to an
    // upstream chain link, not this predicate.
    let sj:i32=subj_idx(clause,tokC,nct,pi,tmp);
    let snc:i32=0;
    if(sj>=0){
        let gso:i32=a_get(cstmC,2*sj);
        let gsl:i32=a_get(cstmC,2*sj+1);
        if(in_stems(stemC[gso..gso+gsl],stemA,cstemA,ncs)==0){snc=1;}
    }
    let ce:i32=has_cexp(clause,tokC,nct,pi,tmp);
    let j:i32=0;
    while(j<nct){
        if(neg_marker_at(clause,tokC,nct,j,tmp)==0){j=j+1;continue;}
        if(veto_idiom(clause,tokC,nct,j,tmp,firstA,pi,stemC,cstmC)==1){j=j+1;continue;}
        if(j<pi){
            if(wheth>=0){j=j+1;continue;}
            if(ce==1){j=j+1;continue;}
            if(sj>=0 && j==sj-1 && snc==1){j=j+1;continue;}
            let t:i32=find_word(clause,tokC,nct,"that",j+1,tmp);
            if(t>j && t<pi){
                if(matrix_deny(clause,tokC,nct,j,t,tmp)==1){return 1;}
                j=j+1;continue;
            }
            if(has_barrier(clause,tokC,nct,j,pi,tmp)==0){return 1;}
            j=j+1;continue;
        }
        // j > pi: post-predicate markers.
        if(z_eq(pred,"be")==1 && j<=pi+2){
            // Copula-complement negation: "are NOT blind". Resolve a
            // negative prefix on the complement against the claim's
            // complement (cadj): "not ineffective" vs "ineffective" denies;
            // "not uncommon" vs "common" affirms; vs "rare" denies.
            let nx:i32=next_content(clause,tokC,nct,j,tmp);
            if(nx>=0){
                let so:i32=a_get(cstmC,2*nx);
                let sl:i32=a_get(cstmC,2*nx+1);
                let st2:[]u8=stemC[so..so+sl];
                if(z_eq(st2,cadj)==1){return 1;}
                if(strip_eq(st2,"un",cadj)==1){return 0;}
                if(strip_eq(st2,"in",cadj)==1){return 0;}
                if(strip_eq(st2,"im",cadj)==1){return 0;}
                if(strip_eq(st2,"dis",cadj)==1){return 0;}
                if(strip_eq(st2,"non",cadj)==1){return 0;}
                if(antonym_tail(st2,cadj)==1){return 1;}
                if(strip_eq(cadj,"un",st2)==1){return 1;}
                if(strip_eq(cadj,"in",st2)==1){return 1;}
                if(strip_eq(cadj,"im",st2)==1){return 1;}
                if(strip_eq(cadj,"dis",st2)==1){return 1;}
            }
            let bb:i32=find_word(clause,tokC,nct,"but",j+1,tmp);
            if(bb>j){
                let bq:i32=bb+1;
                while(bq<nct){
                    let bso:i32=a_get(cstmC,2*bq);
                    let bsl:i32=a_get(cstmC,2*bq+1);
                    if(z_eq(stemC[bso..bso+bsl],cadj)==1){return 0;}
                    bq=bq+1;
                }
            }
            return 1;
        }
        // "neither/nor" scoping the object: "causes neither cancer nor ..."
        let to3:i32=a_get(tokC,2*j);
        let tl3:i32=a_get(tokC,2*j+1);
        let ll3:i32=lower_copy(clause[to3..to3+tl3],tmp);
        if(z_eq(tmp[0..ll3],"neither")==1 || z_eq(tmp[0..ll3],"nor")==1){
            let nr:i32=find_word(clause,tokC,nct,"nor",j+1,tmp);
            if(nr>j){
                let k:i32=j+1;
                while(k<nct){
                    let so2:i32=a_get(cstmC,2*k);
                    let sl2:i32=a_get(cstmC,2*k+1);
                    if(in_stems(stemC[so2..so2+sl2],stemA,cstemA,ncs)==1){return 1;}
                    k=k+1;
                }
            }
        }
        j=j+1;
    }
    return 0;
}
// ==================== competitor (B3) ====================
fn competitor(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,firstA:[]u8,subjA:[]u8,tmp:[]u8)i32{
    // (1) immediate subject: nearest non-filler token before predicate
    let j:i32=pi-1;
    while(j>=0){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_filler())==0){break;}
        j=j-1;
    }
    if(j>=0){
        let to2:i32=a_get(tokC,2*j);
        let tl2:i32=a_get(tokC,2*j+1);
        let tj:[]u8=clause[to2..to2+tl2];
        if(z_cplen(tj)>=3 && z_isupper1(tj)==1){
            let so:i32=a_get(cstmC,2*j);
            let sl:i32=a_get(cstmC,2*j+1);
            if(in_stems(stemC[so..so+sl],stemA,cstemA,ncs)==0){
                // V4-R2: the claim's own subject is never a competitor
                // ("Ice" in "Ice floats on water." vs "Ice floats...").
                if(subjA.len==0 || z_eq(stemC[so..so+sl],subjA)==0){return 1;}
            }
        }
    }
    // (2) far-field: capitalized entity before predicate while the claim's
    // subject anchor (first content word) is absent from the clause
    if(in_stems(firstA,stemC,cstmC,nct)==0){
        let kk:i32=1;
        while(kk<pi && kk<nct){
            let to3:i32=a_get(tokC,2*kk);
            let tl3:i32=a_get(tokC,2*kk+1);
            let tk:[]u8=clause[to3..to3+tl3];
            if(z_cplen(tk)>=4 && z_isupper1(tk)==1){
                let so2:i32=a_get(cstmC,2*kk);
                let sl2:i32=a_get(cstmC,2*kk+1);
                let ll3:i32=lower_copy(tk,tmp);
                if(in_stems(stemC[so2..so2+sl2],stemA,cstemA,ncs)==0 && in_list(tmp[0..ll3],lex_conjskip())==0){
                    // V4-R2: claim's own subject exempt (see above).
                    if(subjA.len==0 || z_eq(stemC[so2..so2+sl2],subjA)==0){return 1;}
                }
            }
            kk=kk+1;
        }
    }
    return 0;
}
fn is_interrog(clause:[]u8,tokC:[]u8,nct:i32,tmp:[]u8)i32{
    if(z_has(clause,"?")==1){return 1;}
    if(nct>0){
        let to:i32=a_get(tokC,0);
        let tl:i32=a_get(tokC,1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_whaux())==1 && nct<=10){return 1;}
    }
    return 0;
}
fn claim_numbers(claim:[]u8,numa:[]u8,max:i32)i32{
    let n:i32=claim.len;
    let p:i32=0;
    let k:i32=0;
    while(p<n && k<max){
        if(z_isdig(claim[p] as i32)==1){
            let q:i32=p;
            while(q<n && (z_isdig(claim[q] as i32)==1 || (claim[q] as i32)==44)){q=q+1;}
            a_put(numa,2*k,p);
            a_put(numa,2*k+1,q-p);
            k=k+1;
            p=q;
        }else{p=p+1;}
    }
    return k;
}
fn has_claim_value(clause:[]u8,claim:[]u8,numa:[]u8,nnums:i32,clvB:[]u8,tmp:[]u8)i32{
    if(nnums==0){return 0;}
    let n:i32=clause.len;
    let k:i32=0;
    let i:i32=0;
    while(i<n){
        let b:i32=clause[i] as i32;
        if(b!=44 && b!=32){clvB[k]=clause[i];k=k+1;}
        i=i+1;
    }
    let cl2:[]u8=clvB[0..k];
    i=0;
    while(i<nnums){
        let no:i32=a_get(numa,2*i);
        let nl:i32=a_get(numa,2*i+1);
        let num:[]u8=claim[no..no+nl];
        let m:i32=num.len;
        let k2:i32=0;
        let jj:i32=0;
        while(jj<m){
            let b2:i32=num[jj] as i32;
            if(b2!=44 && b2!=32){tmp[k2]=num[jj];k2=k2+1;}
            jj=jj+1;
        }
        if(z_has(cl2,tmp[0..k2])==1){return 1;}
        i=i+1;
    }
    return 0;
}
// ==================== merged clause scanner ====================
// Scans one text's clauses (title OR snippet -- never mixed). Returns
// 0 (no deny), 1 deny-lex, 2 antonym, 3 neg-scope, 4 competing-subject,
// 9 quantifier. Sets affB[0]=1 on first endorsing clause.
//
// V4-INTEG merge of B1 (negation), B2 (contrastive; hook lives in
// ==================== round-5 endorse vetoes ====================
// Non-expert source lexicon for the bare-authority veto (A26): a claim
// affirmed only because a non-expert said so is not evidence.
fn lex_nonexpert()[]u8{
    return "\nactor\nactors\nactress\nactresses\nastrologer\nastrologers\nblogger\nbloggers\ncelebrity\ncelebrities\ncolumnist\ncolumnists\ncomedian\ncomedians\ncommentator\ncommentators\nguru\ngurus\ninfluencer\ninfluencers\npundit\npundits\ntheorist\ntheorists\n";
}

// part-word test for the composition veto (A28/A30)
fn part_word(w:[]u8)i32{
    if(z_eq(w,"component")==1){return 1;}
    if(z_eq(w,"components")==1){return 1;}
    if(z_eq(w,"part")==1){return 1;}
    if(z_eq(w,"parts")==1){return 1;}
    if(z_eq(w,"piece")==1){return 1;}
    if(z_eq(w,"pieces")==1){return 1;}
    if(z_eq(w,"ingredient")==1){return 1;}
    if(z_eq(w,"ingredients")==1){return 1;}
    if(z_eq(w,"member")==1){return 1;}
    if(z_eq(w,"members")==1){return 1;}
    if(z_eq(w,"instrument")==1){return 1;}
    if(z_eq(w,"instruments")==1){return 1;}
    if(z_eq(w,"element")==1){return 1;}
    if(z_eq(w,"elements")==1){return 1;}
    return 0;
}

// Post-hoc veto (A31): a causal claim supported only by temporal
// succession ("the bridge was overloaded and then it collapsed" for
// "the bridge collapsed because it was overloaded") is not evidence of
// causation. Fires only when the evidence clause has a temporal marker
// but no causal verb of its own.
fn temporal_only_veto(clause:[]u8,tokC:[]u8,nct:i32,cauflag:i32,tmp:[]u8)i32{
    if(cauflag==0){return 0;}
    let has_tm:i32=0;
    let has_causal:i32=0;
    let i:i32=0;
    while(i<nct){
        let ll:i32=tok_lc(clause,tokC,i,tmp);
        let w:[]u8=tmp[0..ll];
        if(z_eq(w,"after")==1||z_eq(w,"following")==1||z_eq(w,"when")==1){has_tm=1;}
        if(z_eq(w,"because")==1){has_causal=1;}
        if(z_eq(w,"caused")==1||z_eq(w,"causes")==1||z_eq(w,"causing")==1){has_causal=1;}
        if(z_eq(w,"led")==1||z_eq(w,"resulted")==1||z_eq(w,"triggered")==1||z_eq(w,"produced")==1){has_causal=1;}
        if(z_eq(w,"due")==1){has_causal=1;}
        i=i+1;
    }
    if(has_tm==1 && has_causal==0){return 1;}
    return 0;
}

// Endorse vetoes for the merged affirm gate:
//  1. evaluative/causal conclusion must be evidenced (A27): a causal
//     claim whose evaluative adjective ("dangerous", "natural") is absent
//     from the evidence may not affirm on co-occurrence alone;
//  2. comparative conclusion must be evidenced (A29): the claim's
//     comparative word ("healthier") must appear in the evidence;
//  3. bare authority (A26): a reporting verb whose source is a non-expert
//     ("a famous actor says") scoping the claim's predicate is not
//     endorsement evidence;
//  4. part-to-whole composition (A28/A30): "every <part> of the <whole>
//     is P" does not evidence "<whole> is P".
// 1 = suppress the endorse gate for this clause, 0 = no veto.
fn endorse_veto(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,pi:i32,cadj:[]u8,subjA:[]u8,firstA:[]u8,cauflag:i32,compw:[]u8,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    // 1. evaluative conclusion
    if(cauflag==1 && cadj.len>0){
        if(in_stems(cadj,stemC,cstmC,nct)==0){return 1;}
    }
    // 2. comparative conclusion
    if(compw.len>0){
        let found:i32=0;
        let i:i32=0;
        while(i<nct){
            let ll:i32=tok_lc(clause,tokC,i,tmp);
            if(ll>0 && z_eq(tmp[0..ll],compw)==1){found=1;break;}
            i=i+1;
        }
        if(found==0){return 1;}
    }
    // 3. bare authority: reporting verb with a non-expert source scoping
    // the claim predicate
    let rv:i32=-1;
    let racc:i32=0;
    let ri:i32=0;
    while(ri<nct){
        let ll2:i32=tok_lc(clause,tokC,ri,tmp);
        let w2:[]u8=tmp[0..ll2];
        if(ll2>0 && in_list(w2,lex_reporting())==1){rv=ri;racc=0;break;}
        if(z_eq(w2,"according")==1 && ri+1<nct){
            let ll3:i32=tok_lc(clause,tokC,ri+1,tmp);
            if(z_eq(tmp[0..ll3],"to")==1){rv=ri;racc=1;break;}
        }
        ri=ri+1;
    }
    if(rv>=0 && pi>rv){
        let swl:i32=0;
        if(racc==1){
            let k:i32=rv+2;
            while(k<nct){
                let lk:i32=tok_lc(clause,tokC,k,tmp);
                if(lk>0 && in_list(tmp[0..lk],lex_stop())==0){break;}
                k=k+1;
            }
            let last:i32=k;
            while(last+1<nct){
                let ln:i32=tok_lc(clause,tokC,last+1,tmp);
                if(ln>0 && in_list(tmp[0..ln],lex_stop())==0){last=last+1;}
                else{break;}
            }
            if(k<nct){
                let lz:i32=tok_lc(clause,tokC,last,tmp);
                if(lz>0 && in_list(tmp[0..lz],lex_nonexpert())==1){return 1;}
            }
        }else{
            let k2:i32=rv-1;
            while(k2>=0){
                let lk2:i32=tok_lc(clause,tokC,k2,tmp);
                if(lk2>0 && in_list(tmp[0..lk2],lex_stop())==0){
                    if(in_list(tmp[0..lk2],lex_nonexpert())==1){return 1;}
                    break;
                }
                k2=k2-1;
            }
        }
    }
    // 4. part-to-whole composition: "every <part> of/in/from the <owner>"
    // where the owner is the claim's subject
    if(nct>=5){
        let l0:i32=tok_lc(clause,tokC,0,tmp);
        let w0:[]u8=tmp[0..l0];
        if(z_eq(w0,"every")==1||z_eq(w0,"each")==1||z_eq(w0,"all")==1){
            let l1:i32=tok_lc(clause,tokC,1,tmp);
            if(part_word(tmp[0..l1])==1){
                let oi:i32=-1;
                let k3:i32=2;
                while(k3<nct && k3<6){
                    let lk3:i32=tok_lc(clause,tokC,k3,tmp);
                    let w3:[]u8=tmp[0..lk3];
                    if(z_eq(w3,"of")==1||z_eq(w3,"in")==1||z_eq(w3,"from")==1){oi=k3;break;}
                    k3=k3+1;
                }
                if(oi>=0){
                    let m:i32=oi+1;
                    while(m<nct && m<oi+5){
                        let mo:i32=a_get(tokC,2*m);
                        let ml:i32=a_get(tokC,2*m+1);
                        let sl:i32=z_stem(clause[mo..mo+ml],out,tmp,vb);
                        if(sl>0){
                            let st:[]u8=out[0..sl];
                            if(z_eq(st,subjA)==1||z_eq(st,firstA)==1){return 1;}
                        }
                        m=m+1;
                    }
                }
            }
        }
    }
    // 5. post-hoc: a causal claim whose evidence offers only temporal
    // succession ("after") with no causal verb of its own (A31)
    if(temporal_only_veto(clause,tokC,nct,cauflag,tmp)==1){return 1;}
    return 0;
}
// ==================== end round-5 endorse vetoes ====================
// r12_classify), B3 (causal), B4 (CQHT). Rule order per clause:
//   DENY(a) [B1] -> DENY(d) -> none-subject [B1] -> ant_pol [B3] ->
//   opp_outcome_deny [B3] -> cause_deny [B3] -> prevent_aff [B3] ->
//   QUANT pair [B4] -> pi -> mech_aff [B3] -> DENY(b) [B1 scope, B3
//   polarity, B4 hedged-deny] -> postpi_deny [B3] -> QUANT(c) [B4] ->
//   DENY(c) [B3 competitor] -> AFFIRM [merged gate].
// r7c (A24): 1 if the clause contains a negation word followed (within
// 2 tokens) by a gradable antonym of cadj (the claim's adjective stem).
// "not hot" does not contradict "cold" (gradable); "not open" DOES
// contradict "open" (complementary, not in the gradable table).
fn r7c_neg_grad_veto(clause:[]u8,cadj:[]u8)i32{
    if(cadj.len==0){return 0;}
    let AR:[]u8=z_alloc(1024);
    let TMP:[]u8=z_alloc(64);
    let STM:[]u8=z_alloc(32);
    let rc:i32=0;
    if(AR.len>0 && TMP.len>0 && STM.len>0){
        let n:i32=z_toks(clause,AR,128);
        let i:i32=0;
        while(i<n && rc==0){
            let to:i32=a_get(AR,2*i);
            let tl:i32=a_get(AR,2*i+1);
            let ll:i32=lower_copy(clause[to..to+tl],TMP);
            if(is_negword(TMP[0..ll])==1){
                let k:i32=i+1;
                while(k<n && k<=i+2 && rc==0){
                    let kto:i32=a_get(AR,2*k);
                    let ktl:i32=a_get(AR,2*k+1);
                    let kll:i32=lower_copy(clause[kto..kto+ktl],TMP);
                    if(kll>0){
                        let sl:i32=r6_stem_of(TMP[0..kll],STM);
                        if(sl>0 && gradable_antonym(cadj,STM[0..sl])==1){rc=1;}
                    }
                    k=k+1;
                }
            }
            i=i+1;
        }
    }
    z_free(AR);
    z_free(TMP);
    z_free(STM);
    return rc;
}
fn scan_text(t:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,stemB:[]u8,tstmB:[]u8,ntstm:i32,firstA:[]u8,lastA:[]u8,pred:[]u8,cadj:[]u8,subjA:[]u8,need:i32,numa:[]u8,nnums:i32,claim:[]u8,clauA:[]u8,protB:[]u8,tokC:[]u8,stemC:[]u8,cstmC:[]u8,lowB:[]u8,clvB:[]u8,tmpS:[]u8,outS:[]u8,vbS:[]u8,affB:[]u8,cneg:i32,cauflag:i32,cv:[]u8,sstemb:[]u8,sstmc:[]u8,nsst:i32,tsup:i32,Qc:i32,nspanB:[]u8,nspanM:[]u8,nnspan:i32,compw:[]u8,sc:[]u8)i32{
    let ncl:i32=z_clauses(t,clauA,protB,256);
    // B1-V4: a trailing "?" hedges the whole stream: no endorsement.
    // ("?" is a clause separator, so it never appears inside a clause;
    // check the stream's last non-space byte instead.)
    let lhedge:i32=0;
    if(t.len>0){
        let le:i32=t.len-1;
        while(le>0 && z_isspace(t[le] as i32)==1){le=le-1;}
        if((t[le] as i32)==63){lhedge=1;}
    }
    // ---- B4-COND pre-pass: conditional marker per clause ----
    // CONDM[c]=1 if clause c contains if/unless/whether/provided/assuming/
    // suppose ("whether X or not" is concessive, not conditional).
    // CONDA[2*c] = marker token index.
    let CONDM:[]u8=sc[100000..100256];
    let CONDA:[]u8=sc[100256..102304];
    let SAT_TOK:[]u8=sc[102304..103328];
    let SAT_STM:[]u8=sc[103328..104352];
    let SAT_SB:[]u8=sc[104352..106352];
    let ci:i32=0;
    while(ci<ncl){
        let co0:i32=a_get(clauA,2*ci);
        let cl0:i32=a_get(clauA,2*ci+1);
        let cltxt:[]u8=t[co0..co0+cl0];
        let nt2:i32=z_toks(cltxt,SAT_TOK,128);
        let cm:i32=0;
        let mi2:i32=-1;
        let j2:i32=0;
        while(j2<nt2){
            if(tok_is(cltxt,SAT_TOK,j2,"if",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"unless",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"provided",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"assuming",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"suppose",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"whether",tmpS)==1){
                let k3:i32=j2+1;
                let conc:i32=0;
                while(k3+1<nt2){
                    if(tok_is(cltxt,SAT_TOK,k3,"or",tmpS)==1 && tok_is(cltxt,SAT_TOK,k3+1,"not",tmpS)==1){conc=1;break;}
                    k3=k3+1;
                }
                if(conc==0){cm=1;mi2=j2;break;}
            }
            j2=j2+1;
        }
        CONDM[ci]=cm as u8;
        a_put(CONDA,2*ci,mi2);
        ci=ci+1;
    }
    let c:i32=0;
    // ---- Support-negation pre-scan: for a negated claim (cneg==1), an
    // evidence neg-marker scoping the claim's negated span is double
    // negation = SUPPORT (not deny). Sets supneg=1; suppresses DENY (b)
    // and drives AFFIRM (with has_nclm).
    let supneg:i32=0;
    let supneg_ci:i32=-1;
    if(cneg==1 && nnspan>0){
        let sci2:i32=0;
        while(sci2<ncl && supneg==0){
            let sco:i32=a_get(clauA,2*sci2);
            let scl:i32=a_get(clauA,2*sci2+1);
            let sclause:[]u8=t[sco..sco+scl];
            let snct:i32=z_toks(sclause,SAT_TOK,128);
            let sj:i32=0;
            while(sj<snct && supneg==0){
                let sto2:i32=a_get(SAT_TOK,2*sj);
                let stl2:i32=a_get(SAT_TOK,2*sj+1);
                let sll2:i32=lower_copy(sclause[sto2..sto2+stl2],tmpS);
                if(is_negw(tmpS[0..sll2])==1){
                    // next 3 content stems = neg scope
                    let got:i32=0;
                    let sk:i32=sj+1;
                    let send:i32=sj+7;
                    if(send>snct){send=snct;}
                    while(sk<send && got<3){
                        let kto:i32=a_get(SAT_TOK,2*sk);
                        let ktl:i32=a_get(SAT_TOK,2*sk+1);
                        let kll:i32=lower_copy(sclause[kto..kto+ktl],tmpS);
                        if(kll>3 && in_list(tmpS[0..kll],lex_stop())==0){
                            let ksl:i32=z_stem(sclause[kto..kto+ktl],outS,tmpS,vbS);
                            if(ksl>0){
                                if(stem_overlap(outS[0..ksl],nspanB,nspanM,nnspan)==1){supneg=1;supneg_ci=sci2;break;}
                            }
                            got=got+1;
                        }
                        sk=sk+1;
                    }
                }
                // "rule out / ruled out / ruling out X" = ¬X (deny-lex negation)
                if(supneg==0){
                    let rto:i32=a_get(SAT_TOK,2*sj);
                    let rtl:i32=a_get(SAT_TOK,2*sj+1);
                    let rll:i32=lower_copy(sclause[rto..rto+rtl],tmpS);
                    if(z_eq(tmpS[0..rll],"rule")==1 || z_eq(tmpS[0..rll],"ruled")==1 || z_eq(tmpS[0..rll],"ruling")==1 || z_eq(tmpS[0..rll],"rules")==1){
                        if(sj+1<snct){
                            let oto:i32=a_get(SAT_TOK,2*(sj+1));
                            let otl:i32=a_get(SAT_TOK,2*(sj+1)+1);
                            let oll:i32=lower_copy(sclause[oto..oto+otl],tmpS);
                            if(z_eq(tmpS[0..oll],"out")==1 && sj+2<snct){
                                let xto:i32=a_get(SAT_TOK,2*(sj+2));
                                let xtl:i32=a_get(SAT_TOK,2*(sj+2)+1);
                                let xsl:i32=z_stem(sclause[xto..xto+xtl],outS,tmpS,vbS);
                                if(xsl>0 && stem_overlap(outS[0..xsl],nspanB,nspanM,nnspan)==1){supneg=1;supneg_ci=sci2;}
                            }
                        }
                    }
                }
                sj=sj+1;
            }
            sci2=sci2+1;
        }
    }
    let supneg_hedged:i32=0;
    let has_nclm:i32=0;
    while(c<ncl){
        let co:i32=a_get(clauA,2*c);
        let cl:i32=a_get(clauA,2*c+1);
        let clause:[]u8=t[co..co+cl];
        let nct:i32=z_toks(clause,tokC,1024);
        if(nct==0){c=c+1;continue;}
        // clause stems
        let soffC:i32=0;
        let i:i32=0;
        while(i<nct){
            let to:i32=a_get(tokC,2*i);
            let tl:i32=a_get(tokC,2*i+1);
            let sl:i32=z_stem(clause[to..to+tl],outS,tmpS,vbS);
            let q:i32=0;
            while(q<sl){stemC[soffC+q]=outS[q];q=q+1;}
            a_put(cstmC,2*i,soffC);
            a_put(cstmC,2*i+1,sl);
            soffC=soffC+sl;
            i=i+1;
        }
        // n_claim + anchor
        let nclm:i32=0;
        i=0;
        while(i<ncs){
            let so:i32=a_get(cstemA,2*i);
            let sl2:i32=a_get(cstemA,2*i+1);
            if(in_stems(stemA[so..so+sl2],stemC,cstmC,nct)==1){nclm=nclm+1;}
            i=i+1;
        }
        if(nclm>=1){has_nclm=1;}
        // Overlap with claim's negated span. For a negated claim, DENY (b)
        // requires the evidence to actually assert the denied content;
        // positive evidence with different specifics (B22: 1889 vs 20th C)
        // is compatible, not contradictory.
        let novlap:i32=0;
        if(cneg==1 && nnspan>0){
            let vi:i32=0;
            while(vi<nct){
                let vso:i32=a_get(cstmC,2*vi);
                let vsl:i32=a_get(cstmC,2*vi+1);
                if(stem_overlap(stemC[vso..vso+vsl],nspanB,nspanM,nnspan)==1){novlap=1;break;}
                vi=vi+1;
            }
        }
        let anch:i32=0;
        if(in_stems(firstA,stemC,cstmC,nct)==1 || in_stems(lastA,stemC,cstmC,nct)==1){anch=1;}
        // ---- B4-HEDGE: clause hedged if any raw token is a hedge word ----
        let hedged:i32=0;
        let hi2:i32=0;
        while(hi2<nct){
            let to9:i32=a_get(tokC,2*hi2);
            let tl9:i32=a_get(tokC,2*hi2+1);
            let ll9:i32=lower_copy(clause[to9..to9+tl9],tmpS);
            if(in_list(tmpS[0..ll9],lex_hedge())==1){hedged=1;break;}
            hi2=hi2+1;
        }
        if(c==supneg_ci){supneg_hedged=hedged;}
        // ---- B4-QUANT: evidence quantifier = first clause token ----
        let Qe:i32=0;
        if(nct>0){
            let qo:i32=a_get(tokC,0);
            let ql:i32=a_get(tokC,1);
            let qll:i32=lower_copy(clause[qo..qo+ql],tmpS);
            Qe=quant_code(tmpS[0..qll]);
        }
        let lowl:i32=lower_copy(clause,lowB);
        let low:[]u8=lowB[0..lowl];
        // B1-V4: "whether" hedges the proposition (no endorsement), except
        // the concessive "whether X or not" (B4-C12), which is not hedging.
        let whedge:i32=0;
        if(z_has(low,"whether")==1){
            whedge=1;
            let wwi:i32=find_word(clause,tokC,nct,"whether",0,tmpS);
            if(wwi>=0){
                let wk:i32=wwi+1;
                while(wk+1<nct){
                    if(tok_is(clause,tokC,wk,"or",tmpS)==1 && tok_is(clause,tokC,wk+1,"not",tmpS)==1){whedge=0;break;}
                    wk=wk+1;
                }
            }
        }
        // B3: framed markers hoisted (needed by ant_pol/mech_aff pre-pi).
        let framed:i32=0;
        if(z_has(low,"conspiracy theory")==1){framed=1;}
        if(z_has(low,"choose a legend")==1){framed=1;}
        if(z_starts(low,"legend:")==1){framed=1;}
        if(z_has(low,"urban legend")==1){framed=1;}
        // --- DENY (a): denial lexicon [B1-V4] ---
        let strong:i32=0;
        let weak:i32=0;
        i=0;
        while(i<nct){
            let so3:i32=a_get(cstmC,2*i);
            let sl3:i32=a_get(cstmC,2*i+1);
            let st:[]u8=stemC[so3..so3+sl3];
            if(in_list(st,lex_strong())==1 || deny_prefix(st)==1){strong=1;}
            let to2:i32=a_get(tokC,2*i);
            let tl2:i32=a_get(tokC,2*i+1);
            let ll2:i32=lower_copy(clause[to2..to2+tl2],tmpS);
            if(in_list(tmpS[0..ll2],lex_weak())==1){weak=1;}
            i=i+1;
        }
        if(z_has(low,"no evidence")==1){weak=1;}
        // B1-V4: generalized "no <words> evidence|proof|studies|data" and
        // polarity-aware "no longer <w>": deny only if <w> is the claim's
        // complement or a reporting verb ("no longer says"); suppress when
        // <w> is the complement's antonym ("no longer suspended") or
        // unrelated.
        let gj:i32=0;
        while(gj<nct){
            let gto:i32=a_get(tokC,2*gj);
            let gtl:i32=a_get(tokC,2*gj+1);
            let gll:i32=lower_copy(clause[gto..gto+gtl],tmpS);
            let is_no:i32=0;
            if(z_eq(tmpS[0..gll],"no")==1){is_no=1;}
            if(is_no==1){
                let gl2:i32=gj+1;
                let is_longer:i32=0;
                if(gl2<nct){
                    let hto:i32=a_get(tokC,2*gl2);
                    let htl:i32=a_get(tokC,2*gl2+1);
                    let hll:i32=lower_copy(clause[hto..hto+htl],tmpS);
                    if(z_eq(tmpS[0..hll],"longer")==1){is_longer=1;}
                }
                if(is_longer==0){
                    let gk:i32=gj+1;
                    let gend:i32=gj+4;
                    if(gend>nct){gend=nct;}
                    while(gk<gend){
                        let kto:i32=a_get(tokC,2*gk);
                        let ktl:i32=a_get(tokC,2*gk+1);
                        let kll:i32=lower_copy(clause[kto..kto+ktl],tmpS);
                        if(in_list(tmpS[0..kll],lex_evid())==1){weak=1;}
                        gk=gk+1;
                    }
                }else{
                    let wx:i32=next_content(clause,tokC,nct,gl2,tmpS);
                    if(wx>=0){
                        let wto:i32=a_get(tokC,2*wx);
                        let wtl:i32=a_get(tokC,2*wx+1);
                        let wll:i32=lower_copy(clause[wto..wto+wtl],tmpS);
                        let wso:i32=a_get(cstmC,2*wx);
                        let wsl:i32=a_get(cstmC,2*wx+1);
                        if(z_eq(stemC[wso..wso+wsl],cadj)==1){weak=1;}
                        else{
                            if(in_list(tmpS[0..wll],lex_reporting())==1){weak=1;}
                        }
                    }
                }
            }
            gj=gj+1;
        }
        let ana:i32=0;
        if(strong==1 && nct<=8){
            let k2:i32=0;
            i=0;
            while(i<ncs){
                let so4:i32=a_get(cstemA,2*i);
                let sl4:i32=a_get(cstemA,2*i+1);
                if(in_stems(stemA[so4..so4+sl4],stemB,tstmB,ntstm)==1){k2=k2+1;}
                i=i+1;
            }
            if(k2>=3){ana=1;}
        }
        if((strong==1 && nclm>=1) || (weak==1 && nclm>=2) || ana==1){return 1;}
        // --- DENY (d): antonym ---
        if(in_stems("flat",stemA,cstemA,ncs)==1 && nclm>=1){
            if(in_stems("spherical",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("sphere",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("round",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("globe",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("oblate",stemC,cstmC,nct)==1){return 2;}
        }
        if(in_stems("spherical",stemA,cstemA,ncs)==1 && in_stems("flat",stemC,cstmC,nct)==1 && nclm>=1){return 2;}
        // B1-V4: "none/nothing/nobody/nowhere" in subject position denies
        // the claim even when no predicate is found (pi<0 below).
        let ni:i32=0;
        while(ni<nct && ni<5){
            let nto:i32=a_get(tokC,2*ni);
            let ntl:i32=a_get(tokC,2*ni+1);
            let nll:i32=lower_copy(clause[nto..nto+ntl],tmpS);
            if(z_eq(tmpS[0..nll],"none")==1 || z_eq(tmpS[0..nll],"nothing")==1 || z_eq(tmpS[0..nll],"nobody")==1 || z_eq(tmpS[0..nll],"nowhere")==1){
                if(nclm>=1){return 3;}
            }
            ni=ni+1;
        }
        // --- DENY (d2)/AFFIRM (f): float/sink antonym with polarity [B3] ---
        let ar:i32=ant_pol(clause,tokC,nct,stemC,cstmC,stemA,cstemA,ncs,need,nclm,framed,cneg,firstA,subjA,pred,cadj,tmpS);
        if(ar==1){return 2;}
        if(ar==2){affB[0]=1;}
        // --- DENY (d2b): opposite causal outcome [B3] ---
        if(opp_outcome_deny(clause,tokC,nct,stemC,cstmC,stemA,cstemA,ncs,nclm,cauflag,tmpS)==1){return 3;}
        // --- DENY (e): "not because of <claim cause>" [B3] ---
        if(cause_deny(clause,tokC,nct,stemC,cstmC,stemA,cstemA,ncs,nclm,tmpS)==1){return 3;}
        // --- DENY (e2): alternative cause (fix #3). If the claim is causal
        // and the evidence asserts a cause via "resulted from" without
        // affirming the claim's "because" link, it's an alternative cause
        // -> DENY. (A35: "resulted from rainfall" contradicts
        // "because the dam was opened".)
        if(cauflag==1 && nclm>=1){
            let has_alt:i32=0;
            let has_because:i32=0;
            let ai:i32=0;
            while(ai<nct){
                let ao:i32=a_get(tokC,2*ai);
                let al:i32=a_get(tokC,2*ai+1);
                let all:i32=lower_copy(clause[ao..ao+al],tmpS);
                if(z_eq(tmpS[0..all],"resulted")==1){
                    // check next token is "from"
                    if(ai+1<nct){
                        let bo:i32=a_get(tokC,2*(ai+1));
                        let bl:i32=a_get(tokC,2*(ai+1)+1);
                        let bll:i32=lower_copy(clause[bo..bo+bl],tmpS);
                        if(z_eq(tmpS[0..bll],"from")==1){has_alt=1;}
                    }
                }
                if(z_eq(tmpS[0..all],"because")==1){has_because=1;}
                ai=ai+1;
            }
            if(has_alt==1 && has_because==0){return 3;}
        }
        // --- AFFIRM (p): prevented-cause [B3] ---
        if(prevent_aff(clause,tokC,nct,stemC,cstmC,firstA,subjA,nclm,pred,tmpS)==1){affB[0]=1;}
        // ---- B4-QUANT pair rules (predicate-independent) ----
        // (a) universal-ish claim vs negative-universal evidence -> DENY
        // (b) negative-universal claim vs existential evidence -> DENY
        // (f) few vs most (either direction) -> DENY
        // (d) universal/most claim vs weaker existential evidence -> suppress AFFIRM
        // --- AFFIRM (q0): negated-universal claim vs universal evidence
        // whose verb is the antonym of the claim's verb ("No student
        // failed" vs "Every student passed"). "No X V" is "Every X
        // not-V", so the evidence asserts the claim's own content ->
        // AFFIRM, and the pair DENYs below must not fire.
        let qaff:i32=0;
        if(nclm>=need && anch==1 && Qc==7 && Qe==1 && affB[0]==0){
            if(neg_univ_verb_affirm(claim,tokC,nct,stemC,cstmC,subjA,firstA,tmpS,outS,vbS)==1){
                affB[0]=1;
                qaff=1;
            }
        }
        let qsup:i32=0;
        if(nclm>=need && anch==1 && qaff==0){
            if(Qe==7 && (Qc==1 || Qc==2 || Qc==3 || Qc==4)){return 9;}
            if(Qc==7 && (Qe==1 || Qe==2 || Qe==3 || Qe==4 || Qe==5)){return 9;}
            if(Qc==6 && Qe==2){return 9;}
            if(Qc==2 && Qe==6){return 9;}
            if(Qc==1 && (Qe==2 || Qe==3 || Qe==4 || Qe==5 || Qe==6)){qsup=1;}
            if(Qc==2 && (Qe==4 || Qe==5 || Qe==6)){qsup=1;}
            // "Not all X are Y" (Qc=8) is equivalent to "Some X are not Y"
            // (Qe=4). Do not suppress affirm via qsup.
            if(Qc==8 && Qe==4){qsup=0;}
        }
        // --- predicate-dependent rules ---
        let pi:i32=-1;
        i=0;
        while(i<nct){
            let so5:i32=a_get(cstmC,2*i);
            let sl5:i32=a_get(cstmC,2*i+1);
            if(psyn_has(stemC[so5..so5+sl5],pred)==1){pi=i;break;}
            i=i+1;
        }
        // --- AFFIRM (m): causal-mechanism endorsement (predicate absent) [B3] ---
        // round-5: post-hoc veto (A31) — temporal-only evidence for a
        // causal claim may not affirm here either
        let tveto:i32=temporal_only_veto(clause,tokC,nct,cauflag,tmpS);
        if(pi<0 && affB[0]==0 && tveto==0){
            if(mech_aff(clause,tokC,nct,stemC,cstmC,subjA,cv,nclm,need,cneg,cauflag,framed,tmpS)==1){affB[0]=1;}
        }
        if(pi<0){c=c+1;continue;}
        // --- DENY (b): negation scoping the predicate ---
        // B1's rewritten scope; B3's polarity (evidence polarity must
        // disagree with the claim's own: ns!=cneg covers double negation);
        // B4's hedged-deny suppression (a hedged denial is NEUTRAL, but
        // only when the hedge sits inside the negation's scope).
        let ns:i32=neg_scope(clause,tokC,nct,pi,stemC,cstmC,stemA,cstemA,ncs,firstA,subjA,pred,cadj,tmpS);
        let hedged_deny:i32=0;
        if(ns==1){
            let wj:i32=pi-4;
            if(wj<0){wj=0;}
            while(wj<=pi && wj<nct){
                let wo:i32=a_get(tokC,2*wj);
                let wl:i32=a_get(tokC,2*wj+1);
                let dwll:i32=lower_copy(clause[wo..wo+wl],tmpS);
                // V4-INTEG: reporting verbs ("believes","suggests") structure
                // attribution; they do not hedge the denial. ("No credible
                // scientist believes coffee causes cancer" must DENY.)
                if(in_list(tmpS[0..dwll],lex_hedge())==1 && in_list(tmpS[0..dwll],lex_reporting())==0){hedged_deny=1;break;}
                wj=wj+1;
            }
        }
        // Contrast-frame guard (frame-stripper generalization): a negation
        // scoping the predicate of an explicitly contrast-marked non-claim
        // subject ("copper, by contrast, is not magnetic") does not
        // contradict the claim -> the neg-scope DENY must not fire.
        let cfr:i32=0;
        if(qaff==0 && clause_contrast_frame(clause,tokC,nct,tmpS)==1){
            if(in_stems(subjA,stemC,cstmC,nct)==0 && in_stems(firstA,stemC,cstmC,nct)==0){cfr=1;}
        }
        // r7c (A24): negated gradable antonym is not a contradiction.
        if(qaff==0 && cfr==0 && ns!=cneg && nclm>=1 && hedged_deny==0 && !(supneg==1 && cneg==1) && !(cneg==1 && nnspan>0 && novlap==0) && r7c_neg_grad_veto(clause,cadj)==0){return 3;}
        // --- Contradictory-evidence veto (fix #5): if the clause contains
        // the claim's subject and an antonym of the claim's adjective,
        // DENY. (R42: "door is shut" contradicts "door is open".)
        if(cadj.len>0 && subjA.len>0){
            if(in_stems(subjA,stemC,cstmC,nct)==1){
                let ai:i32=0;
                while(ai<nct){
                    let aso:i32=a_get(cstmC,2*ai);
                    let asl:i32=a_get(cstmC,2*ai+1);
                    if(antonym(stemC[aso..aso+asl],cadj)==1){
                        // r7c (A24): negated gradable antonym is not a contradiction.
                        let gad:i32=gradable_antonym(stemC[aso..aso+asl],cadj);
                        if(gad==0 || r7c_neg_grad_veto(clause,cadj)==0){return 3;}
                    }
                    ai=ai+1;
                }
            }
        }
        // --- DENY (b2): post-predicate negation of a claim stem [B3] ---
        if(postpi_deny(clause,tokC,nct,pi,stemC,cstmC,stemA,cstemA,ncs,nclm,cneg,cauflag,subjA,sstemb,sstmc,nsst,tmpS)==1){return 3;}
        // ---- B4-QUANT (c): negated predicate vs universal-ish claim -> DENY.
        // Covers post-predicate "not" as well as pre-predicate scope that
        // deny-(b) missed on anchor/need grounds.
        if(nclm>=need && anch==1){
            let evneg:i32=ns;
            if(evneg==0){
                let pj:i32=pi+1;
                while(pj<pi+4 && pj<nct){
                    let po:i32=a_get(tokC,2*pj);
                    let pl:i32=a_get(tokC,2*pj+1);
                    let pll:i32=lower_copy(clause[po..po+pl],tmpS);
                    let pw:[]u8=tmpS[0..pll];
                    if(in_list(pw,lex_neg())==1){evneg=1;break;}
                    if(ew(pw,0,pll,"n't")==1){evneg=1;break;}
                    pj=pj+1;
                }
            }
            if(evneg==1){
                if(Qc==1 || Qc==2 || Qc==3){return 9;}
                if(Qc==0 && (Qe==2 || Qe==3 || Qe==4 || Qe==5 || Qe==6)){return 9;}
            }
        }
        // --- DENY (c): competing subject + superlative/identity predicate [B3] ---
        let comp:i32=competitor(clause,tokC,nct,pi,stemC,cstmC,stemA,cstemA,ncs,firstA,subjA,tmpS);
        if(comp==1 && nclm>=1 && in_stems(firstA,stemC,cstmC,nct)==1){
            if(z_eq(pred,"be")==1 || has_superlative(stemC,cstmC,nct)==1){
                if(is_interrog(clause,tokC,nct,tmpS)==0 && has_claim_value(clause,claim,numa,nnums,clvB,tmpS)==0){
                    return 4;
                }
            }
        }
        // --- AFFIRM: positive endorsement evidence only [merged gate] ---
        if(affB[0]==0){
            let condok:i32=1;
            if(CONDM[c]==1){
                let mi3:i32=a_get(CONDA,2*c);
                let alo3:i32=mi3+1;
                let ahi3:i32=nct;
                if(pi>mi3){ahi3=pi;}
                condok=cond_satisfied(t,clauA,ncl,c,alo3,ahi3,stemA,cstemA,ncs,SAT_TOK,SAT_STM,SAT_SB,tmpS,outS,vbS);
            }
            if(nclm>=need && anch==1 && ns==cneg && is_interrog(clause,tokC,nct,tmpS)==0 && framed==0 && comp==0 && hedged==0 && whedge==0 && lhedge==0 && qsup==0 && tsup==0 && condok==1){
                // round-5 endorse vetoes: bare authority (A26), unevidenced
                // evaluative conclusion (A27), unevidenced comparative
                // (A29), part-to-whole composition (A28/A30)
                let eveto:i32=endorse_veto(clause,tokC,nct,stemC,cstmC,pi,cadj,subjA,firstA,cauflag,compw,tmpS,outS,vbS);
                if(eveto==0){affB[0]=1;}
            }
        }
        c=c+1;
    }
    // Causal-uncertainty veto (contradictory-evidence veto, fix #5): if the
    // claim is causal and the evidence stream expresses uncertainty about
    // the cause ("under investigation", "unknown", "unclear"), block affirm.
    // The co-occurrence of effect+cause is not enough when the cause is
    // explicitly unknown.
    if(cauflag==1){
        let tl:i32=t.len;
        let up:i32=0;
        while(up+4<tl){
            // "under investigation"
            if(up+19<tl && t[up]==117 && t[up+1]==110 && t[up+2]==100 && t[up+3]==101 && t[up+4]==114){
                let ok2:i32=1;
                let lit:[]u8="under investigation";
                let li:i32=0;
                while(li<19){if(t[up+li]!=lit[li]){ok2=0;break;}li=li+1;}
                if(ok2==1){affB[0]=0;break;}
            }
            // "unknown"
            if(up+7<tl && t[up]==117 && t[up+1]==110 && t[up+2]==107 && t[up+3]==110 && t[up+4]==111 && t[up+5]==119 && t[up+6]==110){
                affB[0]=0;break;
            }
            // "unclear"
            if(up+7<tl && t[up]==117 && t[up+1]==110 && t[up+2]==99 && t[up+3]==108 && t[up+4]==101 && t[up+5]==97 && t[up+6]==114){
                affB[0]=0;break;
            }
            up=up+1;
        }
    }
    // Supporting negation (double negation): negated claim + negated
    // evidence scoping the claim's negated span = AFFIRM. Requires the
    // supporting clause to be unhedged (H11: "may not cure" must not affirm).
    if(supneg==1 && has_nclm==1 && supneg_hedged==0){affB[0]=1;}
    return 0;
}

// ==================== ROUND 6: RT2c mechanism repairs (r12_v4_t5) ====================
// General token-structure mechanisms: reporting-frame proposition extraction +
// polarity, moved-event relations, negated-antonym/equivalent affirms, arithmetic
// (ratio / interval / percentage / measure-compare), temporal exclusion,
// role reversal, competing-agent/cause denial, canonical paraphrase
// normalization, quantifier-upgrade veto, causal bare-authority veto.
// Pure Zag; zero RNG. Return codes: 1=AFFIRM, 2=DENY, 0=abstain (vetoes: 1=veto).

fn r6_pronoun(w:[]u8)i32{
    if(z_eq(w,"i")==1||z_eq(w,"you")==1||z_eq(w,"he")==1||z_eq(w,"she")==1||z_eq(w,"it")==1||z_eq(w,"we")==1||z_eq(w,"they")==1){return 1;}
    if(z_eq(w,"me")==1||z_eq(w,"him")==1||z_eq(w,"her")==1||z_eq(w,"us")==1||z_eq(w,"them")==1){return 1;}
    if(z_eq(w,"my")==1||z_eq(w,"your")==1||z_eq(w,"his")==1||z_eq(w,"its")==1||z_eq(w,"our")==1||z_eq(w,"their")==1){return 1;}
    return 0;
}
fn r6_pron_norm(w:[]u8,out:[]u8)i32{
    if(z_eq(w,"him")==1||z_eq(w,"his")==1){out[0]=104;out[1]=101;return 2;}
    if(z_eq(w,"her")==1){out[0]=115;out[1]=104;out[2]=101;return 3;}
    if(z_eq(w,"me")==1){out[0]=105;return 1;}
    if(z_eq(w,"us")==1){out[0]=119;out[1]=101;return 2;}
    if(z_eq(w,"them")==1){out[0]=116;out[1]=104;out[2]=101;out[3]=121;return 4;}
    let k:i32=0;
    while(k<w.len){out[k]=w[k];k=k+1;}
    return w.len;
}
fn r6_iscop(w:[]u8)i32{
    if(z_eq(w,"is")==1||z_eq(w,"are")==1||z_eq(w,"was")==1||z_eq(w,"were")==1||z_eq(w,"be")==1||z_eq(w,"been")==1||z_eq(w,"am")==1){return 1;}
    return 0;
}
// Canonical synonym map: closed-class (quantifier/unit/vehicle/speed) plus a
// small principled content set (posture verbs, efficacy, break/shatter).
// 1=mapped (canonical form in out), 0=unmapped.
fn r6_canon_word(w:[]u8,out:[]u8)i32{
    if(z_eq(w,"every")==1||z_eq(w,"each")==1){out[0]=97;out[1]=108;out[2]=108;return 3;}
    if(z_eq(w,"kg")==1||z_eq(w,"kilograms")==1){out[0]=107;out[1]=105;out[2]=108;out[3]=111;out[4]=103;out[5]=114;out[6]=97;out[7]=109;return 8;}
    if(z_eq(w,"automobile")==1||z_eq(w,"automobiles")==1||z_eq(w,"cars")==1){out[0]=99;out[1]=97;out[2]=114;return 3;}
    if(z_eq(w,"speedy")==1||z_eq(w,"quick")==1||z_eq(w,"rapid")==1){out[0]=102;out[1]=97;out[2]=115;out[3]=116;return 4;}
    if(z_eq(w,"sat")==1||z_eq(w,"sitting")==1){out[0]=115;out[1]=105;out[2]=116;return 3;}
    if(z_eq(w,"effective")==1){out[0]=119;out[1]=111;out[2]=114;out[3]=107;return 4;}
    if(z_eq(w,"shatter")==1||z_eq(w,"shattered")==1||z_eq(w,"shatters")==1||z_eq(w,"broke")==1||z_eq(w,"broken")==1||z_eq(w,"brok")==1){out[0]=98;out[1]=114;out[2]=101;out[3]=97;out[4]=107;return 5;}
    return 0;
}
fn r6_report_verb(w:[]u8)i32{
    if(in_list(w,lex_reporting())==1){return 1;}
    if(z_eq(w,"confirm")==1||z_eq(w,"confirmed")==1||z_eq(w,"confirms")==1){return 1;}
    return 0;
}
fn r6_bare_speech(w:[]u8)i32{
    if(z_eq(w,"say")==1||z_eq(w,"says")==1||z_eq(w,"said")==1){return 1;}
    if(z_eq(w,"tell")==1||z_eq(w,"told")==1){return 1;}
    if(z_eq(w,"claim")==1||z_eq(w,"claimed")==1||z_eq(w,"claims")==1){return 1;}
    if(z_eq(w,"state")==1||z_eq(w,"stated")==1||z_eq(w,"states")==1){return 1;}
    if(z_eq(w,"argue")==1||z_eq(w,"argues")==1||z_eq(w,"believe")==1||z_eq(w,"believes")==1){return 1;}
    if(z_eq(w,"think")==1||z_eq(w,"thinks")==1||z_eq(w,"suggest")==1||z_eq(w,"suggests")==1){return 1;}
    return 0;
}
fn r6_causal_pred(w:[]u8)i32{
    if(z_eq(w,"cause")==1||z_eq(w,"caused")==1||z_eq(w,"causes")==1||z_eq(w,"caus")==1){return 1;}
    if(z_eq(w,"lead")==1||z_eq(w,"led")==1||z_eq(w,"leads")==1){return 1;}
    if(z_eq(w,"cure")==1||z_eq(w,"cured")==1||z_eq(w,"cures")==1||z_eq(w,"cur")==1){return 1;}
    if(z_eq(w,"create")==1||z_eq(w,"created")==1||z_eq(w,"creates")==1){return 1;}
    if(z_eq(w,"make")==1||z_eq(w,"made")==1||z_eq(w,"makes")==1){return 1;}
    if(z_eq(w,"produce")==1||z_eq(w,"produced")==1||z_eq(w,"produces")==1){return 1;}
    if(z_eq(w,"trigger")==1||z_eq(w,"triggered")==1||z_eq(w,"triggers")==1){return 1;}
    if(z_eq(w,"prevent")==1||z_eq(w,"prevented")==1||z_eq(w,"prevents")==1){return 1;}
    if(z_eq(w,"stop")==1||z_eq(w,"stopped")==1||z_eq(w,"stops")==1){return 1;}
    return 0;
}
fn r6_has_evid_noun(t:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let f:i32=0;
    if(ar.len>0 && tmp.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            if(ll>0 && in_list(tmp[0..ll],lex_evid())==1){f=1;break;}
            j=j+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    return f;
}
// stem+irreg of w after canonical synonym mapping. Self-contained.
fn r6_stem_of(w:[]u8,out:[]u8)i32{
    let tmp:[]u8=z_alloc(64);
    let vb:[]u8=z_alloc(64);
    let cw:[]u8=z_alloc(32);
    let l:i32=0;
    if(tmp.len>0 && vb.len>0 && cw.len>0){
        let cl:i32=r6_canon_word(w,cw);
        let base:[]u8=w;
        if(cl>0){base=cw[0..cl];}
        let sl:i32=z_stem(base,tmp,tmp,vb);
        let sw:[]u8=irreg(tmp[0..sl]);
        // silent-e repair: past-tense/plural strip dropped a final e
        // (closed->clos->close, cures->cur->cure). Prefer the restored form
        // when it is a known verb.
        let use:[]u8=sw;
        let usel:i32=sw.len;
        let cand:[]u8=z_alloc(40);
        if(cand.len>0 && sw.len>2 && base.len>3 && sw[sw.len-1]!=101){
            let bl2:[]u8=base[base.len-2..base.len];
            if(z_eq(bl2,"ed")==1 || z_eq(bl2,"es")==1){
                let q:i32=0;
                while(q<sw.len){cand[q]=sw[q];q=q+1;}
                cand[sw.len]=101;
                if(in_list(cand[0..sw.len+1],lex_verb())==1){
                    use=cand[0..sw.len+1];
                    usel=sw.len+1;
                }
            }
        }
        let k:i32=0;
        while(k<usel){out[k]=use[k];k=k+1;}
        l=usel;
        z_free(cand);
    }
    z_free(tmp);
    z_free(vb);
    z_free(cw);
    return l;
}
// 1 if any raw lowercased token of t equals w.
fn r6_tok_has(t:[]u8,w:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let f:i32=0;
    if(ar.len>0 && tmp.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            if(z_eq(tmp[0..ll],w)==1){f=1;break;}
            j=j+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    return f;
}
// 1 if any token's canonical stem equals s.
fn r6_stem_has(t:[]u8,s:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let f:i32=0;
    if(ar.len>0 && tmp.len>0 && sb.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            let sl:i32=r6_stem_of(tmp[0..ll],sb);
            if(sl>0 && z_eq(sb[0..sl],s)==1){f=1;break;}
            j=j+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    z_free(sb);
    return f;
}
// First pronoun-or-content token: pronouns normalized, else canonical stem.
fn r6_first_content(t:[]u8,out:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let l:i32=0;
    if(ar.len>0 && tmp.len>0 && sb.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            let w:[]u8=tmp[0..ll];
            if(r6_pronoun(w)==1){l=r6_pron_norm(w,out);break;}
            if(in_list(w,lex_stop())==0){
                l=r6_stem_of(w,sb);
                let k:i32=0;
                while(k<l){out[k]=sb[k];k=k+1;}
                break;
            }
            j=j+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    z_free(sb);
    return l;
}
// Complement after the first copula (canonical stem), skipping neg markers.
fn r6_copula_comp(t:[]u8,out:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let l:i32=0;
    if(ar.len>0 && tmp.len>0 && sb.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            if(r6_iscop(tmp[0..ll])==1){
                let m:i32=j+1;
                while(m<nt){
                    let to2:i32=a_get(ar,2*m);
                    let tl2:i32=a_get(ar,2*m+1);
                    let ll2:i32=lower_copy(t[to2..to2+tl2],tmp);
                    let w2:[]u8=tmp[0..ll2];
                    if(is_negword(w2)==1){m=m+1;continue;}
                    if(in_list(w2,lex_stop())==0){
                        l=r6_stem_of(w2,sb);
                        let k:i32=0;
                        while(k<l){out[k]=sb[k];k=k+1;}
                        break;
                    }
                    m=m+1;
                }
                break;
            }
            j=j+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    z_free(sb);
    return l;
}
// 1 if a neg marker sits between the first copula and its complement.
fn r6_copula_neg(t:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let n:i32=0;
    if(ar.len>0 && tmp.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            if(r6_iscop(tmp[0..ll])==1){
                let m:i32=j+1;
                while(m<nt){
                    let to2:i32=a_get(ar,2*m);
                    let tl2:i32=a_get(ar,2*m+1);
                    let ll2:i32=lower_copy(t[to2..to2+tl2],tmp);
                    let w2:[]u8=tmp[0..ll2];
                    if(is_negword(w2)==1){n=1;break;}
                    if(in_list(w2,lex_stop())==0){break;}
                    m=m+1;
                }
                break;
            }
            j=j+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    return n;
}
// First lex_verb member (canonical stem): the claim's main predicate for
// causal detection.
fn r6_claim_pred(t:[]u8,out:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let l:i32=0;
    if(ar.len>0 && tmp.len>0 && sb.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            let w:[]u8=tmp[0..ll];
            if(is_negword(w)==0 && r6_iscop(w)==0 && in_list(w,lex_stop())==0 && r6_report_verb(w)==0){
                let sl:i32=r6_stem_of(w,sb);
                if(sl>0 && in_list(sb[0..sl],lex_verb())==1){
                    let k:i32=0;
                    while(k<sl){out[k]=sb[k];k=k+1;}
                    l=sl;
                    break;
                }
            }
            j=j+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    z_free(sb);
    return l;
}
// Normalized canonical token sequence: lowercase, drop stopwords (keep
// negation markers), canonicalize synonyms, stem. Length in out.
fn r6_norm_canon(t:[]u8,out:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let n:i32=0;
    if(ar.len>0 && tmp.len>0 && sb.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            let w:[]u8=tmp[0..ll];
            if(is_negword(w)==1){
                let k:i32=0;
                while(k<ll){out[n]=tmp[k];n=n+1;k=k+1;}
                out[n]=32;
                n=n+1;
            }else{
                if(in_list(w,lex_stop())==0){
                    let sl:i32=r6_stem_of(w,sb);
                    let k2:i32=0;
                    while(k2<sl){out[n]=sb[k2];n=n+1;k2=k2+1;}
                    out[n]=32;
                    n=n+1;
                }
            }
            j=j+1;
        }
        if(n>0){n=n-1;}
    }
    z_free(ar);
    z_free(tmp);
    z_free(sb);
    return n;
}
// Strip a leading reporting frame: proposition in out, verb in verbout
// (verbout[0]==0 means no frame). Copies t when no frame found.
fn r6_frame_strip(t:[]u8,out:[]u8,verbout:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let n:i32=0;
    if(ar.len>0 && tmp.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            if(r6_report_verb(tmp[0..ll])==1){
                let vl:i32=0;
                while(vl<ll){verbout[vl]=tmp[vl];vl=vl+1;}
                let k:i32=j+1;
                if(k<nt){
                    let to2:i32=a_get(ar,2*k);
                    let tl2:i32=a_get(ar,2*k+1);
                    let ll2:i32=lower_copy(t[to2..to2+tl2],tmp);
                    if(z_eq(tmp[0..ll2],"that")==1){k=k+1;}
                }
                let m:i32=k;
                while(m<nt){
                    let to3:i32=a_get(ar,2*m);
                    let tl3:i32=a_get(ar,2*m+1);
                    if(m>k){out[n]=32;n=n+1;}
                    let q:i32=0;
                    while(q<tl3){out[n]=t[to3+q];n=n+1;q=q+1;}
                    m=m+1;
                }
                z_free(ar);
                z_free(tmp);
                return n;
            }
            j=j+1;
        }
        let q2:i32=0;
        while(q2<t.len){out[q2]=t[q2];q2=q2+1;}
        n=t.len;
    }
    z_free(ar);
    z_free(tmp);
    return n;
}
// "S was|were V by A" -> "A V S". Copies t unchanged when no pattern.
fn r6_passive_rewrite(t:[]u8,out:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let n:i32=0;
    if(ar.len>0 && tmp.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j+2<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            if(z_eq(tmp[0..ll],"was")==1||z_eq(tmp[0..ll],"were")==1){
                let to1:i32=a_get(ar,2*(j+1));
                let tl1:i32=a_get(ar,2*(j+1)+1);
                let to2:i32=a_get(ar,2*(j+2));
                let tl2:i32=a_get(ar,2*(j+2)+1);
                let ll2:i32=lower_copy(t[to2..to2+tl2],tmp);
                if(z_eq(tmp[0..ll2],"by")==1){
                    let m:i32=j+3;
                    while(m<nt){
                        let tao:i32=a_get(ar,2*m);
                        let tla:i32=a_get(ar,2*m+1);
                        if(m>j+3){out[n]=32;n=n+1;}
                        let q:i32=0;
                        while(q<tla){out[n]=t[tao+q];n=n+1;q=q+1;}
                        m=m+1;
                    }
                    out[n]=32;
                    n=n+1;
                    let q2:i32=0;
                    while(q2<tl1){out[n]=t[to1+q2];n=n+1;q2=q2+1;}
                    out[n]=32;
                    n=n+1;
                    let s:i32=0;
                    while(s<j){
                        let tso:i32=a_get(ar,2*s);
                        let tls:i32=a_get(ar,2*s+1);
                        if(s>0){out[n]=32;n=n+1;}
                        let q3:i32=0;
                        while(q3<tls){out[n]=t[tso+q3];n=n+1;q3=q3+1;}
                        s=s+1;
                    }
                    z_free(ar);
                    z_free(tmp);
                    return n;
                }
            }
            j=j+1;
        }
        let q4:i32=0;
        while(q4<t.len){out[q4]=t[q4];q4=q4+1;}
        n=t.len;
    }
    z_free(ar);
    z_free(tmp);
    return n;
}
// digits, wnum_seq words, plus small number words. -1 = not a number.
fn r6_numtok(w:[]u8)i64{
    let v:i32=wnum(w);
    if(v>0){return v as i64;}
    if(z_eq(w,"ten")==1){return 10;}
    if(z_eq(w,"eleven")==1){return 11;}
    if(z_eq(w,"twelve")==1){return 12;}
    if(z_eq(w,"twenty")==1){return 20;}
    if(z_eq(w,"thirty")==1){return 30;}
    if(z_eq(w,"forty")==1){return 40;}
    if(z_eq(w,"fifty")==1){return 50;}
    if(w.len==0){return -1;}
    let i:i32=0;
    let r:i64=0;
    while(i<w.len){
        if(z_isdig(w[i] as i32)==0){return -1;}
        r=r*10+((w[i] as i64)-48);
        i=i+1;
    }
    return r;
}
// canonical unit; 0 = unknown.
fn r6_unit_canon(w:[]u8,out:[]u8)i32{
    if(z_eq(w,"cm")==1||z_eq(w,"centimeter")==1||z_eq(w,"centimeters")==1||z_eq(w,"centimetre")==1||z_eq(w,"centimetres")==1){out[0]=99;out[1]=109;return 2;}
    if(z_eq(w,"m")==1||z_eq(w,"meter")==1||z_eq(w,"meters")==1||z_eq(w,"metre")==1||z_eq(w,"metres")==1){out[0]=109;return 1;}
    if(z_eq(w,"mm")==1||z_eq(w,"millimeter")==1||z_eq(w,"millimeters")==1){out[0]=109;out[1]=109;return 2;}
    if(z_eq(w,"km")==1||z_eq(w,"kilometer")==1||z_eq(w,"kilometers")==1||z_eq(w,"kilometre")==1||z_eq(w,"kilometres")==1){out[0]=107;out[1]=109;return 2;}
    if(z_eq(w,"kg")==1||z_eq(w,"kilogram")==1||z_eq(w,"kilograms")==1){out[0]=107;out[1]=103;return 2;}
    if(z_eq(w,"g")==1||z_eq(w,"gram")==1||z_eq(w,"grams")==1){out[0]=103;return 1;}
    if(z_eq(w,"liter")==1||z_eq(w,"liters")==1||z_eq(w,"litre")==1||z_eq(w,"litres")==1){out[0]=108;return 1;}
    if(z_eq(w,"inch")==1||z_eq(w,"inches")==1){out[0]=105;out[1]=110;return 2;}
    if(z_eq(w,"foot")==1||z_eq(w,"feet")==1){out[0]=102;out[1]=116;return 2;}
    if(z_eq(w,"mile")==1||z_eq(w,"miles")==1){out[0]=109;out[1]=105;return 2;}
    if(z_eq(w,"second")==1||z_eq(w,"seconds")==1){out[0]=115;return 1;}
    if(z_eq(w,"minute")==1||z_eq(w,"minutes")==1){out[0]=109;out[1]=105;out[2]=110;return 3;}
    if(z_eq(w,"hour")==1||z_eq(w,"hours")==1){out[0]=104;return 1;}
    if(z_eq(w,"day")==1||z_eq(w,"days")==1){out[0]=100;return 1;}
    if(z_eq(w,"year")==1||z_eq(w,"years")==1){out[0]=121;out[1]=114;return 2;}
    return 0;
}
// space-joined canonical stems of non-stop tokens in [from,to).
fn r6_stemseq(t:[]u8,ar:[]u8,from:i32,to:i32,out:[]u8)i32{
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let n:i32=0;
    if(tmp.len>0 && sb.len>0){
        let j:i32=from;
        while(j<to){
            let to2:i32=a_get(ar,2*j);
            let tl2:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to2..to2+tl2],tmp);
            let w:[]u8=tmp[0..ll];
            if(is_negword(w)==0 && in_list(w,lex_stop())==0){
                let sl:i32=r6_stem_of(w,sb);
                if(n>0){out[n]=32;n=n+1;}
                let k:i32=0;
                while(k<sl){out[n]=sb[k];n=n+1;k=k+1;}
            }
            j=j+1;
        }
    }
    z_free(tmp);
    z_free(sb);
    return n;
}
// 1 if any token of X occurs in Y.
fn r6_overlap(X:[]u8,Y:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    let tmp:[]u8=z_alloc(64);
    let f:i32=0;
    if(ar.len>0 && tmp.len>0){
        let nt:i32=z_toks(X,ar,64);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            if(r6_tok_has(Y,X[to..to+tl])==1){f=1;break;}
            j=j+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    return f;
}
// ---- universal claim + partial-quantifier evidence -> veto (neutral) ----
fn r6_quant_veto(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let v:i32=0;
    if(car.len>0 && tmp.len>0){
        let nct:i32=z_toks(claim,car,128);
        let univ:i32=0;
        let cneg:i32=0;
        let j:i32=0;
        while(j<nct){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            let w:[]u8=tmp[0..ll];
            if(z_eq(w,"all")==1||z_eq(w,"every")==1||z_eq(w,"each")==1){univ=1;}
            if(is_negword(w)==1){cneg=1;}
            j=j+1;
        }
        if(univ==1 && cneg==0){
            let t2:i32=0;
            while(t2<2 && v==0){
                let tx:[]u8=title;
                if(t2==1){tx=snip;}
                let nt2:i32=z_toks(tx,car,128);
                let k:i32=0;
                while(k<nt2){
                    let to2:i32=a_get(car,2*k);
                    let tl2:i32=a_get(car,2*k+1);
                    let ll2:i32=lower_copy(tx[to2..to2+tl2],tmp);
                    let w2:[]u8=tmp[0..ll2];
                    let q:i32=quant_code(w2);
                    if(q>=2 && q<=7){v=1;break;}
                    if(z_eq(w2,"average")==1){v=1;break;}
                    k=k+1;
                }
                t2=t2+1;
            }
        }
    }
    z_free(car);
    z_free(tmp);
    return v;
}
// ---- causal claim under bare testimony with no evidence nouns -> veto ----
fn r6_bare_authority_veto(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let pv:[]u8=z_alloc(32);
    let v:i32=0;
    if(pv.len>0){
        let prl:i32=r6_claim_pred(claim,pv);
        let caus:i32=0;
        if(prl>0 && r6_causal_pred(pv[0..prl])==1){caus=1;}
        if(caus==0){
            if(r6_tok_has(claim,"because")==1||r6_tok_has(claim,"due")==1){caus=1;}
        }
        if(caus==1){
            let cla:[]u8=z_alloc(2048);
            let pro:[]u8=z_alloc(1024);
            let pr2:[]u8=z_alloc(1024);
            let verb:[]u8=z_alloc(32);
            let car:[]u8=z_alloc(1024);
            let tmp:[]u8=z_alloc(64);
            let sb2:[]u8=z_alloc(32);
            if(cla.len>0 && pro.len>0 && pr2.len>0 && verb.len>0 && car.len>0 && tmp.len>0 && sb2.len>0){
                let t2:i32=0;
                while(t2<2 && v==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let ncl:i32=z_clauses(tx,cla,pro,32);
                    let ci:i32=0;
                    while(ci<ncl && v==0){
                        let co:i32=a_get(cla,2*ci);
                        let cl2:i32=a_get(cla,2*ci+1);
                        let clause:[]u8=tx[co..co+cl2];
                        verb[0]=0;
                        let fsl:i32=r6_frame_strip(clause,pr2,verb);
                        if(fsl>0 && verb[0]!=0 && r6_bare_speech(verb)==1){
                            if(r6_has_evid_noun(clause)==0){
                                // claim predicate scoped under the bare verb?
                                let nct:i32=z_toks(clause,car,128);
                                let ri:i32=0;
                                while(ri<nct){
                                    let to:i32=a_get(car,2*ri);
                                    let tl:i32=a_get(car,2*ri+1);
                                    let ll:i32=lower_copy(clause[to..to+tl],tmp);
                                    if(z_eq(tmp[0..ll],verb)==1){break;}
                                    ri=ri+1;
                                }
                                let pi2:i32=ri+1;
                                while(pi2<nct){
                                    let to2:i32=a_get(car,2*pi2);
                                    let tl2:i32=a_get(car,2*pi2+1);
                                    let ll2:i32=lower_copy(clause[to2..to2+tl2],tmp);
                                    let sl2:i32=r6_stem_of(tmp[0..ll2],sb2);
                                    if(sl2==prl && z_eq(sb2[0..sl2],pv[0..prl])==1){v=1;break;}
                                    pi2=pi2+1;
                                }
                            }
                        }
                        ci=ci+1;
                    }
                    t2=t2+1;
                }
            }
            z_free(cla);
            z_free(pro);
            z_free(pr2);
            z_free(verb);
            z_free(car);
            z_free(tmp);
            z_free(sb2);
        }
    }
    z_free(pv);
    return v;
}
// ---- reporting-frame proposition polarity (A05/A19/B01 deny; identity affirm) ----
fn r6_report_frame_rel(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let cla:[]u8=z_alloc(2048);
    let pro:[]u8=z_alloc(1024);
    let pr2:[]u8=z_alloc(1024);
    let verb:[]u8=z_alloc(32);
    let cs:[]u8=z_alloc(32);
    let cc:[]u8=z_alloc(32);
    let pc:[]u8=z_alloc(32);
    let cn:[]u8=z_alloc(2048);
    let pn:[]u8=z_alloc(2048);
    let rc:i32=0;
    if(cla.len>0 && pro.len>0 && pr2.len>0 && verb.len>0 && cs.len>0 && cc.len>0 && pc.len>0 && cn.len>0 && pn.len>0){
        let cnl:i32=r6_norm_canon(claim,cn);
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let ncl:i32=z_clauses(tx,cla,pro,32);
            let ci:i32=0;
            while(ci<ncl && rc==0){
                let co:i32=a_get(cla,2*ci);
                let cl2:i32=a_get(cla,2*ci+1);
                let clause:[]u8=tx[co..co+cl2];
                verb[0]=0;
                let pl:i32=r6_frame_strip(clause,pr2,verb);
                if(pl>0 && verb[0]!=0){
                    // round-7: only factive frames ("realized/discovered/
                    // showed X") endorse or deny their complement; a
                    // non-factive frame ("believes/claimed/said X")
                    // asserts the attitude, not the complement.
                    let vl:i32=0;
                    while(vl<32 && verb[vl]!=0){vl=vl+1;}
                    let fv:i32=r7_factive(verb[0..vl]);
                    let pnl:i32=r6_norm_canon(pr2[0..pl],pn);
                    if(pnl==cnl && pnl>0 && z_eq(pn[0..pnl],cn[0..cnl])==1){
                        rc=1;
                    }else{
                        let csl:i32=r6_first_content(claim,cs);
                        let ccl:i32=r6_copula_comp(claim,cc);
                        let pcl:i32=r6_copula_comp(pr2[0..pl],pc);
                        if(csl>0 && ccl>0 && pcl>0 && r6_tok_has(pr2[0..pl],cs[0..csl])==1){
                            let cneg:i32=r6_copula_neg(claim);
                            let pneg:i32=r6_copula_neg(pr2[0..pl]);
                            if(cneg==pneg){
                                if(antonym(cc[0..ccl],pc[0..pcl])==1){rc=2;}
                            }else{
                                if(z_eq(cc[0..ccl],pc[0..pcl])==1){rc=2;}
                                else{
                                    // "not closed" vs "open": antonym with
                                    // opposite polarity affirms
                                    if(antonym(cc[0..ccl],pc[0..pcl])==1){rc=1;}
                                }
                            }
                        }
                    }
                }
                ci=ci+1;
            }
            t2=t2+1;
        }
    }
    z_free(cla);
    z_free(pro);
    z_free(pr2);
    z_free(verb);
    z_free(cs);
    z_free(cc);
    z_free(pc);
    z_free(cn);
    z_free(pn);
    return rc;
}
// ---- moved events: "X was moved from A to B" (A12 deny; B33 affirm) ----
fn r6_moved_event_rel(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let cla:[]u8=z_alloc(2048);
    let pro:[]u8=z_alloc(1024);
    let car:[]u8=z_alloc(1024);
    let ear:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let Sq:[]u8=z_alloc(256);
    let Aq:[]u8=z_alloc(256);
    let Bq:[]u8=z_alloc(256);
    let cSq:[]u8=z_alloc(256);
    let Lq:[]u8=z_alloc(256);
    let rc:i32=0;
    if(cla.len>0 && pro.len>0 && car.len>0 && ear.len>0 && tmp.len>0 && Sq.len>0 && Aq.len>0 && Bq.len>0 && cSq.len>0 && Lq.len>0){
        // claim: prep + location, subject, negation
        let nct:i32=z_toks(claim,car,128);
        let pi:i32=-1;
        let j:i32=0;
        while(j<nct){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            let w:[]u8=tmp[0..ll];
            if(z_eq(w,"on")==1||z_eq(w,"at")==1||z_eq(w,"in")==1||z_eq(w,"during")==1){pi=j;break;}
            j=j+1;
        }
        if(pi>=0){
            let cneg:i32=0;
            let j2:i32=0;
            while(j2<nct){
                let to:i32=a_get(car,2*j2);
                let tl:i32=a_get(car,2*j2+1);
                let ll:i32=lower_copy(claim[to..to+tl],tmp);
                if(is_negword(tmp[0..ll])==1){cneg=1;break;}
                j2=j2+1;
            }
            let Lql:i32=r6_stemseq(claim,car,pi+1,pi+3,Lq);
            let cSql:i32=r6_stemseq(claim,car,0,pi,cSq);
            if(Lql>0 && cSql>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let net:i32=z_toks(tx,ear,128);
                    let mj:i32=0;
                    while(mj+1<net && rc==0){
                        let to:i32=a_get(ear,2*mj);
                        let tl:i32=a_get(ear,2*mj+1);
                        let to1:i32=a_get(ear,2*(mj+1));
                        let tl1:i32=a_get(ear,2*(mj+1)+1);
                        let lla:i32=lower_copy(tx[to..to+tl],tmp);
                        let llb:i32=lower_copy(tx[to1..to1+tl1],Sq);
                        let wa:[]u8=tmp[0..lla];
                        let wb:[]u8=Sq[0..llb];
                        if(z_eq(wa,"moved")==1 && z_eq(wb,"from")==1){
                            let kk:i32=mj+2;
                            while(kk<net){
                                let tok:i32=a_get(ear,2*kk);
                                let tll:i32=a_get(ear,2*kk+1);
                                let lll:i32=lower_copy(tx[tok..tok+tll],tmp);
                                if(z_eq(tmp[0..lll],"to")==1){break;}
                                kk=kk+1;
                            }
                            if(kk<net){
                                let Sql:i32=r6_stemseq(tx,ear,0,mj,Sq);
                                let Aql:i32=r6_stemseq(tx,ear,mj+2,kk,Aq);
                                let Bql:i32=r6_stemseq(tx,ear,kk+1,net,Bq);
                                if(Sql>0 && r6_overlap(Sq[0..Sql],cSq[0..cSql])==1){
                                    if(r6_overlap(Aq[0..Aql],Lq[0..Lql])==1){
                                        if(cneg==1){rc=1;}
                                        else{rc=2;}
                                    }else{
                                        if(cneg==0 && r6_overlap(Bq[0..Bql],Lq[0..Lql])==1){rc=1;}
                                    }
                                }
                            }
                        }
                        mj=mj+1;
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(cla);
    z_free(pro);
    z_free(car);
    z_free(ear);
    z_free(tmp);
    z_free(Sq);
    z_free(Aq);
    z_free(Bq);
    z_free(cSq);
    z_free(Lq);
    return rc;
}
// first content stem in token range [from,to) of an already-tokenized text.
fn r6_first_in(t:[]u8,ar:[]u8,from:i32,to:i32,out:[]u8)i32{
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let l:i32=0;
    if(tmp.len>0 && sb.len>0){
        let j:i32=from;
        while(j<to){
            let to2:i32=a_get(ar,2*j);
            let tl2:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to2..to2+tl2],tmp);
            let w:[]u8=tmp[0..ll];
            if(is_negword(w)==0 && in_list(w,lex_stop())==0){
                l=r6_stem_of(w,sb);
                let k:i32=0;
                while(k<l){out[k]=sb[k];k=k+1;}
                break;
            }
            j=j+1;
        }
    }
    z_free(tmp);
    z_free(sb);
    return l;
}
// ---- ratio: "twice|<N> times as many A as B" vs "<P> A and <Q> B" ----
fn r6_ratio_evidence(tx:[]u8,A:[]u8,B:[]u8,mult:i64)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let r:i32=0;
    if(ar.len>0 && tmp.len>0 && sb.len>0){
        let nt:i32=z_toks(tx,ar,128);
        let m:i32=0;
        while(m+1<nt && r==0){
            let to:i32=a_get(ar,2*m);
            let tl:i32=a_get(ar,2*m+1);
            let ll:i32=lower_copy(tx[to..to+tl],tmp);
            let Pm:i64=r6_numtok(tmp[0..ll]);
            if(Pm>=0){
                let to1:i32=a_get(ar,2*(m+1));
                let tl1:i32=a_get(ar,2*(m+1)+1);
                let ll1:i32=lower_copy(tx[to1..to1+tl1],tmp);
                let sl:i32=r6_stem_of(tmp[0..ll1],sb);
                if(sl>0 && z_eq(sb[0..sl],A)==1){
                    let n:i32=m+2;
                    while(n+2<nt && n<m+9){
                        let ton:i32=a_get(ar,2*n);
                        let tln:i32=a_get(ar,2*n+1);
                        let lln:i32=lower_copy(tx[ton..ton+tln],tmp);
                        if(z_eq(tmp[0..lln],"and")==1){
                            let toq:i32=a_get(ar,2*(n+1));
                            let tlq:i32=a_get(ar,2*(n+1)+1);
                            let llq:i32=lower_copy(tx[toq..toq+tlq],tmp);
                            let Qn:i64=r6_numtok(tmp[0..llq]);
                            if(Qn>=0){
                                let tob:i32=a_get(ar,2*(n+2));
                                let tlb:i32=a_get(ar,2*(n+2)+1);
                                let llb:i32=lower_copy(tx[tob..tob+tlb],tmp);
                                let slb:i32=r6_stem_of(tmp[0..llb],sb);
                                if(slb>0 && z_eq(sb[0..slb],B)==1){
                                    if(Pm==mult*Qn){r=1;}
                                    else{r=2;}
                                    break;
                                }
                            }
                            break;
                        }
                        n=n+1;
                    }
                }
            }
            m=m+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    z_free(sb);
    return r;
}
fn r6_ratio_rel(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    // r7c: 32->128 (pre-existing crash on tokens >=33 chars).
    let sb:[]u8=z_alloc(128);
    let A:[]u8=z_alloc(32);
    let B:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && A.len>0 && B.len>0){
        let nct:i32=z_toks(claim,car,128);
        let ai:i32=-1;
        let j:i32=0;
        while(j+1<nct){
            let to0:i32=a_get(car,2*j);
            let tl0:i32=a_get(car,2*j+1);
            let ll0:i32=lower_copy(claim[to0..to0+tl0],tmp);
            let to1:i32=a_get(car,2*(j+1));
            let tl1:i32=a_get(car,2*(j+1)+1);
            let ll1:i32=lower_copy(claim[to1..to1+tl1],sb);
            if(z_eq(tmp[0..ll0],"as")==1 && z_eq(sb[0..ll1],"many")==1){ai=j;break;}
            j=j+1;
        }
        if(ai>=0){
            let mult:i64=-1;
            if(ai>=1){
                let tom:i32=a_get(car,2*(ai-1));
                let tlm:i32=a_get(car,2*(ai-1)+1);
                let llm:i32=lower_copy(claim[tom..tom+tlm],tmp);
                if(z_eq(tmp[0..llm],"twice")==1){mult=2;}
                else{
                    if(z_eq(tmp[0..llm],"times")==1 && ai>=2){
                        let ton:i32=a_get(car,2*(ai-2));
                        let tln:i32=a_get(car,2*(ai-2)+1);
                        let lln:i32=lower_copy(claim[ton..ton+tln],tmp);
                        mult=r6_numtok(tmp[0..lln]);
                    }
                }
            }
            if(mult>0){
                let a2:i32=-1;
                let k2:i32=ai+2;
                while(k2<nct){
                    let to:i32=a_get(car,2*k2);
                    let tl:i32=a_get(car,2*k2+1);
                    let ll:i32=lower_copy(claim[to..to+tl],tmp);
                    if(z_eq(tmp[0..ll],"as")==1){a2=k2;break;}
                    k2=k2+1;
                }
                if(a2>ai+2){
                    let al:i32=r6_first_in(claim,car,ai+2,a2,A);
                    let bl:i32=r6_first_in(claim,car,a2+1,nct,B);
                    if(al>0 && bl>0){
                        let t2:i32=0;
                        while(t2<2 && rc==0){
                            let tx:[]u8=title;
                            if(t2==1){tx=snip;}
                            rc=r6_ratio_evidence(tx,A[0..al],B[0..bl],mult);
                            t2=t2+1;
                        }
                    }
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(A);
    z_free(B);
    return rc;
}
// ---- interval containment: "between <A> and <B> [unit]" ----
fn r6_interval_contain(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let ub:[]u8=z_alloc(16);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && ub.len>0){
        let nct:i32=z_toks(claim,car,128);
        let bi:i32=-1;
        let j:i32=0;
        while(j<nct){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            if(z_eq(tmp[0..ll],"between")==1){bi=j;break;}
            j=j+1;
        }
        if(bi>=0 && bi+3<nct){
            let toA:i32=a_get(car,2*(bi+1));
            let tlA:i32=a_get(car,2*(bi+1)+1);
            let llA:i32=lower_copy(claim[toA..toA+tlA],tmp);
            let Av:i64=r6_numtok(tmp[0..llA]);
            let ai2:i32=bi+2;
            while(ai2<nct){
                let to:i32=a_get(car,2*ai2);
                let tl:i32=a_get(car,2*ai2+1);
                let ll:i32=lower_copy(claim[to..to+tl],tmp);
                if(z_eq(tmp[0..ll],"and")==1){break;}
                ai2=ai2+1;
            }
            if(ai2+1<nct && Av>=0){
                let toB:i32=a_get(car,2*(ai2+1));
                let tlB:i32=a_get(car,2*(ai2+1)+1);
                let llB:i32=lower_copy(claim[toB..toB+tlB],tmp);
                let Bv:i64=r6_numtok(tmp[0..llB]);
                if(Bv>=0 && Bv>=Av){
                    let ul:i32=0;
                    let ui:i32=ai2+2;
                    while(ui<nct){
                        let tou:i32=a_get(car,2*ui);
                        let tlu:i32=a_get(car,2*ui+1);
                        let llu:i32=lower_copy(claim[tou..tou+tlu],tmp);
                        ul=r6_unit_canon(tmp[0..llu],ub);
                        if(ul>0){break;}
                        ul=0;
                        ui=ui+1;
                    }
                    let t2:i32=0;
                    while(t2<2 && rc==0){
                        let tx:[]u8=title;
                        if(t2==1){tx=snip;}
                        let nt2:i32=z_toks(tx,car,128);
                        let m:i32=0;
                        while(m+1<nt2 && rc==0){
                            let tom:i32=a_get(car,2*m);
                            let tlm:i32=a_get(car,2*m+1);
                            let llm:i32=lower_copy(tx[tom..tom+tlm],tmp);
                            let Vv:i64=r6_numtok(tmp[0..llm]);
                            if(Vv>=0){
                                let tou2:i32=a_get(car,2*(m+1));
                                let tlu2:i32=a_get(car,2*(m+1)+1);
                                let llu2:i32=lower_copy(tx[tou2..tou2+tlu2],tmp);
                                let ub2:[]u8=z_alloc(16);
                                let ul2:i32=0;
                                if(ub2.len>0){ul2=r6_unit_canon(tmp[0..llu2],ub2);}
                                let umatch:i32=0;
                                if(ul==0){umatch=1;}
                                else{
                                    if(ul2==ul && z_eq(ub[0..ul],ub2[0..ul2])==1){umatch=1;}
                                }
                                z_free(ub2);
                                if(umatch==1){
                                    if(Av<=Vv && Vv<=Bv){rc=1;}
                                    else{rc=2;}
                                }
                            }
                            m=m+1;
                        }
                        t2=t2+1;
                    }
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(ub);
    return rc;
}
// ---- percentage quantifiers: "most|half|majority ..." vs "<N> of <M>" ----
fn r6_pct_quant(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let S:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && S.len>0){
        let nct:i32=z_toks(claim,car,128);
        if(nct>1){
            let to0:i32=a_get(car,0);
            let tl0:i32=a_get(car,1);
            let ll0:i32=lower_copy(claim[to0..to0+tl0],tmp);
            let qw:[]u8=tmp[0..ll0];
            let qm:i32=0;
            if(z_eq(qw,"most")==1||z_eq(qw,"majority")==1){qm=1;}
            if(z_eq(qw,"half")==1){qm=2;}
            if(qm>0){
                let sl:i32=r6_first_in(claim,car,1,nct,S);
                if(sl>0){
                    let t2:i32=0;
                    while(t2<2 && rc==0){
                        let tx:[]u8=title;
                        if(t2==1){tx=snip;}
                        if(r6_stem_has(tx,S[0..sl])==1){
                            let nt2:i32=z_toks(tx,car,128);
                            let i:i32=0;
                            while(i<nt2 && rc==0){
                                let toi:i32=a_get(car,2*i);
                                let tli:i32=a_get(car,2*i+1);
                                let lli:i32=lower_copy(tx[toi..toi+tli],tmp);
                                if(z_eq(tmp[0..lli],"of")==1 && i>=1){
                                    let ton:i32=a_get(car,2*(i-1));
                                    let tln:i32=a_get(car,2*(i-1)+1);
                                    let lln:i32=lower_copy(tx[ton..ton+tln],tmp);
                                    let Nv:i64=r6_numtok(tmp[0..lln]);
                                    let Mv:i64=-1;
                                    let mi:i32=i+1;
                                    while(mi<nt2){
                                        let tom:i32=a_get(car,2*mi);
                                        let tlm:i32=a_get(car,2*mi+1);
                                        let llm:i32=lower_copy(tx[tom..tom+tlm],tmp);
                                        Mv=r6_numtok(tmp[0..llm]);
                                        if(Mv>=0){break;}
                                        Mv=-1;
                                        mi=mi+1;
                                    }
                                    if(Nv>=0 && Mv>0){
                                        let pct:i64=Nv*100/Mv;
                                        if(qm==1){
                                            if(pct>50){rc=1;}
                                            else{rc=2;}
                                        }else{
                                            if(pct==50){rc=1;}
                                            else{rc=2;}
                                        }
                                    }
                                }
                                i=i+1;
                            }
                        }
                        t2=t2+1;
                    }
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(S);
    return rc;
}
// comparative direction for a raw lowercased token: comp_dir + -er base forms
// (wide/wider, narrow/narrower) + stemmed fallback (taller->tall).
fn r6_comp_dir_raw(w:[]u8)i32{
    let d:i32=comp_dir(w);
    if(d!=0){return d;}
    let l:i32=w.len;
    if(l>3 && w[l-2]==101 && w[l-1]==114){
        let bl:[]u8=z_alloc(32);
        let sb:[]u8=z_alloc(32);
        let r:i32=0;
        if(bl.len>0 && sb.len>0){
            let k:i32=0;
            while(k<l-2){bl[k]=w[k];k=k+1;}
            r=comp_dir(bl[0..l-2]);
            if(r==0){
                bl[l-2]=101;
                r=comp_dir(bl[0..l-1]);
            }
            if(r==0){
                let sl:i32=z_stem(bl[0..l-2],sb,sb,sb);
                r=comp_dir(sb[0..sl]);
            }
        }
        z_free(bl);
        z_free(sb);
        if(r!=0){return r;}
    }
    let sb2:[]u8=z_alloc(32);
    let r2:i32=0;
    if(sb2.len>0){
        let sl2:i32=z_stem(w,sb2,sb2,sb2);
        r2=comp_dir(sb2[0..sl2]);
    }
    z_free(sb2);
    return r2;
}
// single-token name of the subject just before copula position m.
fn r6_ev_name(t:[]u8,ar:[]u8,m:i32,out:[]u8)i32{
    let tmp:[]u8=z_alloc(64);
    let l:i32=0;
    if(tmp.len>0){
        let i:i32=m-1;
        if(i>=0){
            let to:i32=a_get(ar,2*i);
            let tl:i32=a_get(ar,2*i+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            let w:[]u8=tmp[0..ll];
            if(z_eq(w,"the")==1||z_eq(w,"a")==1||z_eq(w,"an")==1){
                i=i-1;
                if(i>=0){
                    let to2:i32=a_get(ar,2*i);
                    let tl2:i32=a_get(ar,2*i+1);
                    let ll2:i32=lower_copy(t[to2..to2+tl2],tmp);
                    let w2:[]u8=tmp[0..ll2];
                    if(r6_pronoun(w2)==1){l=r6_pron_norm(w2,out);}
                    else{l=r6_stem_of(w2,out);}
                }
            }else{
                if(r6_pronoun(w)==1){l=r6_pron_norm(w,out);}
                else{l=r6_stem_of(w,out);}
            }
        }
    }
    z_free(tmp);
    return l;
}
// multi-token name in [from,to): skip articles/copulas, up to 2 content
// stems joined by space.
fn r6_name_range(t:[]u8,ar:[]u8,from:i32,to:i32,out:[]u8)i32{
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let n:i32=0;
    if(tmp.len>0 && sb.len>0){
        let j:i32=from;
        while(j<to){
            let to0:i32=a_get(ar,2*j);
            let tl0:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to0..to0+tl0],tmp);
            let w:[]u8=tmp[0..ll];
            if(z_eq(w,"the")==1||z_eq(w,"a")==1||z_eq(w,"an")==1){j=j+1;continue;}
            if(r6_iscop(w)==1){j=j+1;continue;}
            break;
        }
        let k2:i32=0;
        while(j<to && k2<2){
            let to2:i32=a_get(ar,2*j);
            let tl2:i32=a_get(ar,2*j+1);
            let ll2:i32=lower_copy(t[to2..to2+tl2],tmp);
            let w2:[]u8=tmp[0..ll2];
            if(in_list(w2,lex_stop())==1){j=j+1;continue;}
            let sl:i32=0;
            if(r6_pronoun(w2)==1){sl=r6_pron_norm(w2,sb);}
            else{sl=r6_stem_of(w2,sb);}
            if(n>0){out[n]=32;n=n+1;}
            let q:i32=0;
            while(q<sl){out[n]=sb[q];n=n+1;q=q+1;}
            k2=k2+1;
            j=j+1;
        }
    }
    z_free(tmp);
    z_free(sb);
    return n;
}
// ---- two-number comparative: "S1 is <comp> than S2" vs measured values ----
fn r6_meas_compare(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let ear:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let ub:[]u8=z_alloc(16);
    let nm:[]u8=z_alloc(32);
    let S1:[]u8=z_alloc(64);
    let S2:[]u8=z_alloc(64);
    let rc:i32=0;
    if(car.len>0 && ear.len>0 && tmp.len>0 && ub.len>0 && nm.len>0 && S1.len>0 && S2.len>0){
        let nct:i32=z_toks(claim,car,128);
        let cj:i32=-1;
        let dir:i32=0;
        let j:i32=0;
        while(j<nct){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            let d:i32=r6_comp_dir_raw(tmp[0..ll]);
            if(d!=0){cj=j;dir=d;break;}
            j=j+1;
        }
        if(cj>=0){
            let th:i32=-1;
            let k2:i32=cj+1;
            while(k2<nct){
                let to:i32=a_get(car,2*k2);
                let tl:i32=a_get(car,2*k2+1);
                let ll:i32=lower_copy(claim[to..to+tl],tmp);
                if(z_eq(tmp[0..ll],"than")==1){th=k2;break;}
                k2=k2+1;
            }
            if(th>cj){
                let l1:i32=r6_name_range(claim,car,0,cj,S1);
                let l2:i32=r6_name_range(claim,car,th+1,nct,S2);
                if(l1>0 && l2>0){
                    let v1:i64=-1;
                    let v2:i64=-1;
                    let ul1:i32=0;
                    let ul2:i32=0;
                    let u1:[]u8=z_alloc(16);
                    let u2:[]u8=z_alloc(16);
                    if(u1.len>0 && u2.len>0){
                        let t2:i32=0;
                        while(t2<2){
                            let tx:[]u8=title;
                            if(t2==1){tx=snip;}
                            let nt2:i32=z_toks(tx,ear,128);
                            let m:i32=0;
                            while(m+2<nt2){
                                let tom:i32=a_get(ear,2*m);
                                let tlm:i32=a_get(ear,2*m+1);
                                let llm:i32=lower_copy(tx[tom..tom+tlm],tmp);
                                let w:[]u8=tmp[0..llm];
                                if(z_eq(w,"is")==1||z_eq(w,"was")==1){
                                    let tom1:i32=a_get(ear,2*(m+1));
                                    let tlm1:i32=a_get(ear,2*(m+1)+1);
                                    let llm1:i32=lower_copy(tx[tom1..tom1+tlm1],tmp);
                                    let Vv:i64=r6_numtok(tmp[0..llm1]);
                                    if(Vv>=0){
                                        let tou:i32=a_get(ear,2*(m+2));
                                        let tlu:i32=a_get(ear,2*(m+2)+1);
                                        let llu:i32=lower_copy(tx[tou..tou+tlu],tmp);
                                        let ul:i32=r6_unit_canon(tmp[0..llu],ub);
                                        if(ul>0){
                                            let nl:i32=r6_ev_name(tx,ear,m,nm);
                                            if(nl>0){
                                                if(z_eq(nm[0..nl],S1[0..l1])==1){
                                                    v1=Vv;
                                                    ul1=ul;
                                                    let q:i32=0;
                                                    while(q<ul){u1[q]=ub[q];q=q+1;}
                                                }else{
                                                    if(z_eq(nm[0..nl],S2[0..l2])==1){
                                                        v2=Vv;
                                                        ul2=ul;
                                                        let q2:i32=0;
                                                        while(q2<ul){u2[q2]=ub[q2];q2=q2+1;}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                m=m+1;
                            }
                            t2=t2+1;
                        }
                    }
                    z_free(u1);
                    z_free(u2);
                    if(v1>=0 && v2>=0 && ul1==ul2 && ul1>0){
                        let holds:i32=0;
                        if(dir>0 && v1>v2){holds=1;}
                        if(dir<0 && v1<v2){holds=1;}
                        if(holds==1){rc=1;}
                        else{rc=2;}
                    }
                }
            }
        }
    }
    z_free(car);
    z_free(ear);
    z_free(tmp);
    z_free(ub);
    z_free(nm);
    z_free(S1);
    z_free(S2);
    return rc;
}
// ---- temporal exclusion: negated claim vs same event at a different time ----
fn r6_temporal_exclusion(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let ear:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let T1:[]u8=z_alloc(32);
    let V:[]u8=z_alloc(32);
    let S:[]u8=z_alloc(32);
    let T2:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && ear.len>0 && tmp.len>0 && sb.len>0 && T1.len>0 && V.len>0 && S.len>0 && T2.len>0){
        let nct:i32=z_toks(claim,car,128);
        let cneg:i32=0;
        let j:i32=0;
        while(j<nct){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            if(is_negword(tmp[0..ll])==1){cneg=1;break;}
            j=j+1;
        }
        if(cneg==1){
            // find claim time: daypart word or number+am/pm
            let t1l:i32=0;
            let k:i32=0;
            while(k<nct){
                let to:i32=a_get(car,2*k);
                let tl:i32=a_get(car,2*k+1);
                let ll:i32=lower_copy(claim[to..to+tl],tmp);
                let w:[]u8=tmp[0..ll];
                if(z_eq(w,"noon")==1||z_eq(w,"midnight")==1||z_eq(w,"morning")==1||z_eq(w,"afternoon")==1||z_eq(w,"evening")==1||z_eq(w,"night")==1){
                    let q:i32=0;
                    while(q<ll){T1[q]=tmp[q];q=q+1;}
                    t1l=ll;
                    break;
                }
                if(r6_numtok(w)>=0 && k+1<nct){
                    let to2:i32=a_get(car,2*(k+1));
                    let tl2:i32=a_get(car,2*(k+1)+1);
                    let ll2:i32=lower_copy(claim[to2..to2+tl2],tmp);
                    let w2:[]u8=tmp[0..ll2];
                    if(z_eq(w2,"am")==1||z_eq(w2,"pm")==1){
                        let q2:i32=0;
                        while(q2<ll){T1[q2]=w[q2];q2=q2+1;}
                        let q3:i32=0;
                        while(q3<ll2){T1[q2]=w2[q3];q2=q2+1;q3=q3+1;}
                        t1l=q2;
                        break;
                    }
                }
                k=k+1;
            }
            if(t1l>0){
                let Sl:i32=r6_first_content(claim,S);
                // verb: first lex_verb stem after the negation
                let Vl:i32=0;
                let ni:i32=0;
                while(ni<nct && Vl==0){
                    let to:i32=a_get(car,2*ni);
                    let tl:i32=a_get(car,2*ni+1);
                    let ll:i32=lower_copy(claim[to..to+tl],tmp);
                    if(is_negword(tmp[0..ll])==1){
                        let m2:i32=ni+1;
                        while(m2<nct){
                            let to2:i32=a_get(car,2*m2);
                            let tl2:i32=a_get(car,2*m2+1);
                            let ll2:i32=lower_copy(claim[to2..to2+tl2],tmp);
                            let sl2:i32=r6_stem_of(tmp[0..ll2],sb);
                            if(sl2>0 && in_list(sb[0..sl2],lex_verb())==1){
                                let q:i32=0;
                                while(q<sl2){V[q]=sb[q];q=q+1;}
                                Vl=sl2;
                                break;
                            }
                            m2=m2+1;
                        }
                        break;
                    }
                    ni=ni+1;
                }
                if(Sl>0 && Vl>0){
                    let t2:i32=0;
                    while(t2<2 && rc==0){
                        let tx:[]u8=title;
                        if(t2==1){tx=snip;}
                        if(r6_stem_has(tx,S[0..Sl])==1 && r6_stem_has(tx,V[0..Vl])==1){
                            let net:i32=z_toks(tx,ear,128);
                            let m3:i32=0;
                            while(m3<net && rc==0){
                                let to:i32=a_get(ear,2*m3);
                                let tl:i32=a_get(ear,2*m3+1);
                                let ll:i32=lower_copy(tx[to..to+tl],tmp);
                                let w:[]u8=tmp[0..ll];
                                let t2l:i32=0;
                                if(z_eq(w,"noon")==1||z_eq(w,"midnight")==1||z_eq(w,"morning")==1||z_eq(w,"afternoon")==1||z_eq(w,"evening")==1||z_eq(w,"night")==1){
                                    let q:i32=0;
                                    while(q<ll){T2[q]=tmp[q];q=q+1;}
                                    t2l=ll;
                                }else{
                                    if(r6_numtok(w)>=0 && m3+1<net){
                                        let to2:i32=a_get(ear,2*(m3+1));
                                        let tl2:i32=a_get(ear,2*(m3+1)+1);
                                        let ll2:i32=lower_copy(tx[to2..to2+tl2],tmp);
                                        let w2:[]u8=tmp[0..ll2];
                                        if(z_eq(w2,"am")==1||z_eq(w2,"pm")==1){
                                            let q2:i32=0;
                                            while(q2<ll){T2[q2]=w[q2];q2=q2+1;}
                                            let q3:i32=0;
                                            while(q3<ll2){T2[q2]=w2[q3];q2=q2+1;q3=q3+1;}
                                            t2l=q2;
                                        }
                                    }
                                }
                                if(t2l>0 && (t2l!=t1l || z_eq(T1[0..t1l],T2[0..t2l])==0)){
                                    // verb must appear unnegated in evidence
                                    let m4:i32=0;
                                    while(m4<net){
                                        let to4:i32=a_get(ear,2*m4);
                                        let tl4:i32=a_get(ear,2*m4+1);
                                        let ll4:i32=lower_copy(tx[to4..to4+tl4],tmp);
                                        let sl4:i32=r6_stem_of(tmp[0..ll4],sb);
                                        if(sl4==Vl && z_eq(sb[0..sl4],V[0..Vl])==1){
                                            // require unnegated in evidence
                                            let nn:i32=0;
                                            let m5:i32=m4-2;
                                            while(m5<m4){
                                                if(m5>=0){
                                                    let ton:i32=a_get(ear,2*m5);
                                                    let tln:i32=a_get(ear,2*m5+1);
                                                    let lln:i32=lower_copy(tx[ton..ton+tln],tmp);
                                                    if(is_negword(tmp[0..lln])==1){nn=1;}
                                                }
                                                m5=m5+1;
                                            }
                                            if(nn==0){rc=1;}
                                            break;
                                        }
                                        m4=m4+1;
                                    }
                                }
                                m3=m3+1;
                            }
                        }
                        t2=t2+1;
                    }
                }
            }
        }
    }
    z_free(car);
    z_free(ear);
    z_free(tmp);
    z_free(sb);
    z_free(T1);
    z_free(V);
    z_free(S);
    z_free(T2);
    return rc;
}
// first non-negword token after the first copula, stemmed (stopwords kept:
// on/off carry the signal).
fn r6_copula_comp_raw(t:[]u8,out:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let l:i32=0;
    if(ar.len>0 && tmp.len>0 && sb.len>0){
        let nt:i32=z_toks(t,ar,128);
        let j:i32=0;
        while(j<nt){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let ll:i32=lower_copy(t[to..to+tl],tmp);
            if(r6_iscop(tmp[0..ll])==1){
                let m:i32=j+1;
                while(m<nt){
                    let to2:i32=a_get(ar,2*m);
                    let tl2:i32=a_get(ar,2*m+1);
                    let ll2:i32=lower_copy(t[to2..to2+tl2],tmp);
                    if(is_negword(tmp[0..ll2])==0){
                        l=r6_stem_of(tmp[0..ll2],sb);
                        let k:i32=0;
                        while(k<l){out[k]=sb[k];k=k+1;}
                        break;
                    }
                    m=m+1;
                }
                break;
            }
            j=j+1;
        }
    }
    z_free(ar);
    z_free(tmp);
    z_free(sb);
    return l;
}
// ---- negated claim vs antonym (B02/B41/B44); positive claim vs negated
// ---- antonym (B32). Same-element cases are left to the main pipeline. ----
// auxiliary verbs to skip when finding the main verb
fn r6_is_aux(w:[]u8)i32{
    if(z_eq(w,"do")==1||z_eq(w,"does")==1||z_eq(w,"did")==1){return 1;}
    if(z_eq(w,"have")==1||z_eq(w,"has")==1||z_eq(w,"had")==1){return 1;}
    if(z_eq(w,"will")==1||z_eq(w,"would")==1||z_eq(w,"shall")==1||z_eq(w,"should")==1){return 1;}
    if(z_eq(w,"can")==1||z_eq(w,"could")==1||z_eq(w,"may")==1||z_eq(w,"might")==1||z_eq(w,"must")==1){return 1;}
    if(z_eq(w,"am")==1||z_eq(w,"is")==1||z_eq(w,"are")==1||z_eq(w,"was")==1||z_eq(w,"were")==1||z_eq(w,"be")==1||z_eq(w,"been")==1||z_eq(w,"being")==1){return 1;}
    return 0;
}
fn r6_negclaim_rel(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let cla:[]u8=z_alloc(2048);
    let pro:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let Elem:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && cla.len>0 && pro.len>0 && tmp.len>0 && sb.len>0 && Elem.len>0){
        let nct:i32=z_toks(claim,car,128);
        let cneg:i32=0;
        let j:i32=0;
        while(j<nct){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            if(is_negword(tmp[0..ll])==1){cneg=1;break;}
            j=j+1;
        }
        // tested element: raw copula complement, else first verb stem
        let El:i32=r6_copula_comp_raw(claim,Elem);
        if(El==0){
            let m2:i32=0;
            while(m2<nct && El==0){
                let to2:i32=a_get(car,2*m2);
                let tl2:i32=a_get(car,2*m2+1);
                let ll2:i32=lower_copy(claim[to2..to2+tl2],tmp);
                if(r6_is_aux(tmp[0..ll2])==0){
                    let sl2:i32=r6_stem_of(tmp[0..ll2],sb);
                    if(sl2>0 && in_list(sb[0..sl2],lex_verb())==1){
                        let q:i32=0;
                        while(q<sl2){Elem[q]=sb[q];q=q+1;}
                        El=sl2;
                    }
                }
                m2=m2+1;
            }
        }
        if(El>0){
            let t2:i32=0;
            while(t2<2 && rc==0){
                let tx:[]u8=title;
                if(t2==1){tx=snip;}
                let ncl:i32=z_clauses(tx,cla,pro,32);
                let ci:i32=0;
                while(ci<ncl && rc==0){
                    let co:i32=a_get(cla,2*ci);
                    let cl2:i32=a_get(cla,2*ci+1);
                    let clause:[]u8=tx[co..co+cl2];
                    // clause-level negation
                    let eneg:i32=0;
                    if(r6_tok_has(clause,"not")==1||r6_tok_has(clause,"no")==1||r6_tok_has(clause,"never")==1||r6_tok_has(clause,"n't")==1){eneg=1;}
                    if(r6_tok_has(clause,"cannot")==1||r6_tok_has(clause,"can't")==1){eneg=1;}
                    let want:i32=0;
                    if(cneg==1 && eneg==0){want=1;}
                    if(cneg==0 && eneg==1){want=1;}
                    if(want==1){
                        // any unnegated token whose stem is an antonym of Elem
                        let ar2:[]u8=z_alloc(512);
                        if(ar2.len>0){
                            let nn:i32=z_toks(clause,ar2,64);
                            let q2:i32=0;
                            while(q2<nn && rc==0){
                                let to:i32=a_get(ar2,2*q2);
                                let tl:i32=a_get(ar2,2*q2+1);
                                let ll:i32=lower_copy(clause[to..to+tl],tmp);
                                let w:[]u8=tmp[0..ll];
                                if(is_negword(w)==0){
                                    let sl:i32=r6_stem_of(w,sb);
                                    if(sl>0 && antonym(Elem[0..El],sb[0..sl])==1){
                                        // r7c (A24): negated gradable in evidence
                                        // does not license antonym extreme in
                                        // claim ("not hot" =/=> "cold"). Withhold
                                        // only when claim is unaffirmed (cneg=0)
                                        // and evidence negated (eneg=1).
                                        let grd:i32=0;
                                        if(cneg==0 && eneg==1){grd=gradable_antonym(Elem[0..El],sb[0..sl]);}
                                        if(grd==0){rc=1;}
                                    }
                                }
                                q2=q2+1;
                            }
                        }
                        z_free(ar2);
                    }
                    ci=ci+1;
                }
                t2=t2+1;
            }
        }
    }
    z_free(car);
    z_free(cla);
    z_free(pro);
    z_free(tmp);
    z_free(sb);
    z_free(Elem);
    return rc;
}
// ---- "X is empty" vs "X has nothing in it" ----
fn r6_univ_noone(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let ear:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let S:[]u8=z_alloc(32);
    let C:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && ear.len>0 && tmp.len>0 && S.len>0 && C.len>0){
        let Sl:i32=r6_first_content(claim,S);
        let Cl:i32=r6_copula_comp(claim,C);
        if(Sl>0 && Cl>0 && z_eq(C[0..Cl],"empty")==1){
            let t2:i32=0;
            while(t2<2 && rc==0){
                let tx:[]u8=title;
                if(t2==1){tx=snip;}
                if(r6_stem_has(tx,S[0..Sl])==1){
                    let net:i32=z_toks(tx,ear,128);
                    let i:i32=0;
                    while(i<net && rc==0){
                        let to:i32=a_get(ear,2*i);
                        let tl:i32=a_get(ear,2*i+1);
                        let ll:i32=lower_copy(tx[to..to+tl],tmp);
                        if(z_eq(tmp[0..ll],"nothing")==1 && i+1<net){
                            let to2:i32=a_get(ear,2*(i+1));
                            let tl2:i32=a_get(ear,2*(i+1)+1);
                            let ll2:i32=lower_copy(tx[to2..to2+tl2],tmp);
                            if(z_eq(tmp[0..ll2],"in")==1){rc=1;}
                        }
                        i=i+1;
                    }
                }
                t2=t2+1;
            }
        }
    }
    z_free(car);
    z_free(ear);
    z_free(tmp);
    z_free(S);
    z_free(C);
    return rc;
}
// ---- role reversal: "X did not V Y" vs "Y V'd X" ----
fn r6_rolerev_affirm(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let X:[]u8=z_alloc(32);
    let V:[]u8=z_alloc(32);
    let Y:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && X.len>0 && V.len>0 && Y.len>0){
        let nct:i32=z_toks(claim,car,128);
        let ni:i32=-1;
        let j:i32=0;
        while(j<nct){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            if(is_negword(tmp[0..ll])==1){ni=j;break;}
            j=j+1;
        }
        if(ni>=0){
            let Xl:i32=r6_first_in(claim,car,0,ni,X);
            let Vl:i32=0;
            let Yl:i32=0;
            let m2:i32=ni+1;
            while(m2<nct){
                let to2:i32=a_get(car,2*m2);
                let tl2:i32=a_get(car,2*m2+1);
                let ll2:i32=lower_copy(claim[to2..to2+tl2],tmp);
                let w:[]u8=tmp[0..ll2];
                if(Vl==0 && is_negword(w)==0 && in_list(w,lex_stop())==0){
                    Vl=r6_stem_of(w,sb);
                    let q:i32=0;
                    while(q<Vl){V[q]=sb[q];q=q+1;}
                }else{
                    if(Vl>0 && is_negword(w)==0 && in_list(w,lex_stop())==0){
                        Yl=r6_stem_of(w,sb);
                        let q2:i32=0;
                        while(q2<Yl){Y[q2]=sb[q2];q2=q2+1;}
                    }
                }
                m2=m2+1;
            }
            if(Xl>0 && Vl>0 && Yl>0){
                let cla:[]u8=z_alloc(2048);
                let pro:[]u8=z_alloc(1024);
                if(cla.len>0 && pro.len>0){
                    let t2:i32=0;
                    while(t2<2 && rc==0){
                        let tx:[]u8=title;
                        if(t2==1){tx=snip;}
                        let ncl:i32=z_clauses(tx,cla,pro,32);
                        let ci:i32=0;
                        while(ci<ncl && rc==0){
                            let co:i32=a_get(cla,2*ci);
                            let cl2:i32=a_get(cla,2*ci+1);
                            let clause:[]u8=tx[co..co+cl2];
                            let F:[]u8=z_alloc(32);
                            if(F.len>0){
                                let Fl:i32=r6_first_content(clause,F);
                                if(Fl==Yl && z_eq(F[0..Fl],Y[0..Yl])==1){
                                    if(r6_stem_has(clause,V[0..Vl])==1 && r6_tok_has(clause,X[0..Xl])==1){rc=1;}
                                }
                            }
                            z_free(F);
                            ci=ci+1;
                        }
                        t2=t2+1;
                    }
                }
                z_free(cla);
                z_free(pro);
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(X);
    z_free(V);
    z_free(Y);
    return rc;
}
// ---- competing subject: same predicate, different subject -> deny ----
fn r6_competing_subject_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    // not for negated claims (agreement on non-occurrence is affirm, not deny)
    if(r6_tok_has(claim,"not")==1||r6_tok_has(claim,"no")==1||r6_tok_has(claim,"never")==1||r6_tok_has(claim,"n't")==1){return 0;}
    let cn:[]u8=z_alloc(2048);
    let en:[]u8=z_alloc(2048);
    let rc:i32=0;
    if(cn.len>0 && en.len>0){
        let cnl:i32=r6_norm_canon(claim,cn);
        if(cnl>0){
            let t2:i32=0;
            while(t2<2 && rc==0){
                let tx:[]u8=title;
                if(t2==1){tx=snip;}
                let enl:i32=r6_norm_canon(tx,en);
                if(enl==cnl && enl>0){
                    // first words differ, rest equal -> different subject
                    let i:i32=0;
                    while(i<cnl && cn[i]!=32){i=i+1;}
                    let k:i32=0;
                    while(k<enl && en[k]!=32){k=k+1;}
                    if(i!=k || z_eq(cn[0..i],en[0..k])==0){
                        if(i<cnl && k<enl && z_eq(cn[i..cnl],en[k..enl])==1){rc=2;}
                    }
                }
                t2=t2+1;
            }
        }
    }
    z_free(cn);
    z_free(en);
    return rc;
}
// ---- competing cause: A1 caused B vs A2 caused B, A1 != A2 -> deny ----
fn r6_competing_cause_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    if(r6_tok_has(claim,"not")==1||r6_tok_has(claim,"no")==1||r6_tok_has(claim,"never")==1||r6_tok_has(claim,"n't")==1){return 0;}
    let car:[]u8=z_alloc(1024);
    let ear:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let A1:[]u8=z_alloc(32);
    let A2:[]u8=z_alloc(32);
    let Bq:[]u8=z_alloc(512);
    let rc:i32=0;
    if(car.len>0 && ear.len>0 && tmp.len>0 && A1.len>0 && A2.len>0 && Bq.len>0){
        let nct:i32=z_toks(claim,car,128);
        let cj:i32=-1;
        let j:i32=0;
        while(j<nct){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            if(r6_causal_pred(tmp[0..ll])==1){cj=j;break;}
            j=j+1;
        }
        if(cj>=0){
            let a1l:i32=r6_first_in(claim,car,0,cj,A1);
            // B = canonical stems of tokens after the causal verb
            let bql:i32=r6_stemseq(claim,car,cj+1,nct,Bq);
            if(a1l>0 && bql>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let net:i32=z_toks(tx,ear,128);
                    let m:i32=0;
                    while(m<net && rc==0){
                        let tom:i32=a_get(ear,2*m);
                        let tlm:i32=a_get(ear,2*m+1);
                        let llm:i32=lower_copy(tx[tom..tom+tlm],tmp);
                        if(r6_causal_pred(tmp[0..llm])==1){
                            let a2l:i32=r6_first_in(tx,ear,0,m,A2);
                            if(a2l>0 && (a2l!=a1l || z_eq(A1[0..a1l],A2[0..a2l])==0)){
                                // B stems all present in the text after the causal verb
                                let moff:i32=a_get(ear,2*m);
                                let all:i32=1;
                                let bar:[]u8=z_alloc(512);
                                if(bar.len>0){
                                    let bnt:i32=z_toks(Bq[0..bql],bar,64);
                                    let bi:i32=0;
                                    while(bi<bnt){
                                        let bto:i32=a_get(bar,2*bi);
                                        let btl:i32=a_get(bar,2*bi+1);
                                        if(r6_stem_has(tx[moff..tx.len],Bq[bto..bto+btl])==0){all=0;break;}
                                        bi=bi+1;
                                    }
                                }
                                z_free(bar);
                                if(all==1){rc=2;}
                            }
                        }
                        m=m+1;
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(ear);
    z_free(tmp);
    z_free(A1);
    z_free(A2);
    z_free(Bq);
    return rc;
}
// 1 if every token of X occurs in Y in order (subsequence on raw bytes).
fn r6_subseq(X:[]u8,Y:[]u8)i32{
    let ar:[]u8=z_alloc(512);
    let br:[]u8=z_alloc(1024);
    let ok:i32=1;
    if(ar.len>0 && br.len>0){
        let nx:i32=z_toks(X,ar,64);
        let ny:i32=z_toks(Y,br,128);
        let j:i32=0;
        let k:i32=0;
        while(j<nx){
            let to:i32=a_get(ar,2*j);
            let tl:i32=a_get(ar,2*j+1);
            let found:i32=0;
            while(k<ny){
                let to2:i32=a_get(br,2*k);
                let tl2:i32=a_get(br,2*k+1);
                if(tl==tl2 && z_eq(X[to..to+tl],Y[to2..to2+tl2])==1){found=1;k=k+1;break;}
                k=k+1;
            }
            if(found==0){ok=0;break;}
            j=j+1;
        }
    }
    z_free(ar);
    z_free(br);
    return ok;
}
// non-factive attitude verbs: the complement is wished, not asserted.
fn r6_attitude(w:[]u8)i32{
    if(z_eq(w,"hope")==1||z_eq(w,"hopes")==1||z_eq(w,"hoped")==1||z_eq(w,"hoping")==1){return 1;}
    if(z_eq(w,"wish")==1||z_eq(w,"wishes")==1||z_eq(w,"wished")==1){return 1;}
    if(z_eq(w,"want")==1||z_eq(w,"wants")==1||z_eq(w,"wanted")==1){return 1;}
    if(z_eq(w,"expect")==1||z_eq(w,"expects")==1||z_eq(w,"expected")==1){return 1;}
    return 0;
}
// 1 if any raw token pair (canonical stems) across the two texts is an
// antonym pair — guards against affirming through dropped stopwords
// (on/off) or polarity flips.
fn r6_has_antonym_pair(a:[]u8,b:[]u8)i32{
    let ar:[]u8=z_alloc(1024);
    let br:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sa:[]u8=z_alloc(32);
    let sb:[]u8=z_alloc(32);
    let hit:i32=0;
    if(ar.len>0 && br.len>0 && tmp.len>0 && sa.len>0 && sb.len>0){
        let na:i32=z_toks(a,ar,128);
        let nb:i32=z_toks(b,br,128);
        let i:i32=0;
        while(i<na && hit==0){
            let to:i32=a_get(ar,2*i);
            let tl:i32=a_get(ar,2*i+1);
            let ll:i32=lower_copy(a[to..to+tl],tmp);
            let sal:i32=r6_stem_of(tmp[0..ll],sa);
            if(sal>0){
                let j:i32=0;
                while(j<nb && hit==0){
                    let to2:i32=a_get(br,2*j);
                    let tl2:i32=a_get(br,2*j+1);
                    let ll2:i32=lower_copy(b[to2..to2+tl2],tmp);
                    let sbl:i32=r6_stem_of(tmp[0..ll2],sb);
                    if(sbl>0 && antonym(sa[0..sal],sb[0..sbl])==1){hit=1;}
                    j=j+1;
                }
            }
            i=i+1;
        }
    }
    z_free(ar);
    z_free(br);
    z_free(tmp);
    z_free(sa);
    z_free(sb);
    return hit;
}
// ---- canonical paraphrase: claim's normalized form is a subsequence of an
// ---- unframed, non-attitude clause's normalized form (passive, tense,
// ---- synonym, temporal). Framed clauses belong to report_frame_rel.
// ---- never affirms across an antonym pair ----
// hedge / weak-evidence markers: do not affirm via paraphrase when present
fn r6_has_hedge(t:[]u8)i32{
    if(r6_tok_has(t,"denies")==1){return 1;}
    if(r6_tok_has(t,"deny")==1){return 1;}
    if(r6_tok_has(t,"reportedly")==1){return 1;}
    if(r6_tok_has(t,"allegedly")==1){return 1;}
    if(r6_tok_has(t,"supposedly")==1){return 1;}
    if(r6_tok_has(t,"rumored")==1){return 1;}
    if(r6_tok_has(t,"disagree")==1){return 1;}
    if(r6_tok_has(t,"whether")==1){return 1;}
    if(r6_tok_has(t,"thought")==1){return 1;}
    if(r6_tok_has(t,"unnamed")==1){return 1;}
    if(r6_tok_has(t,"lacking")==1){return 1;}
    // "no studies" / "no evidence" + support/show
    if(r6_tok_has(t,"studies")==1 && r6_tok_has(t,"no")==1){return 1;}
    return 0;
}
fn r6_synonym_affirm(claim:[]u8,title:[]u8,snip:[]u8)i32{
    // pre-check: if ANY part of evidence has antonym of claim, don't affirm (A33 black swan)
    if(r6_has_antonym_pair(claim,title)==1){return 0;}
    if(r6_has_antonym_pair(claim,snip)==1){return 0;}
    let cn:[]u8=z_alloc(2048);
    let en:[]u8=z_alloc(2048);
    let pr:[]u8=z_alloc(2048);
    let cla:[]u8=z_alloc(2048);
    let pro:[]u8=z_alloc(1024);
    let fr:[]u8=z_alloc(1024);
    let verb:[]u8=z_alloc(32);
    let rc:i32=0;
    if(cn.len>0 && en.len>0 && pr.len>0 && cla.len>0 && pro.len>0 && fr.len>0 && verb.len>0){
        let cnl:i32=r6_norm_canon(claim,cn);
        if(cnl>0){
            let t2:i32=0;
            while(t2<2 && rc==0){
                let tx:[]u8=title;
                if(t2==1){tx=snip;}
                let ncl:i32=z_clauses(tx,cla,pro,32);
                let ci:i32=0;
                while(ci<ncl && rc==0){
                    let co:i32=a_get(cla,2*ci);
                    let cl2:i32=a_get(cla,2*ci+1);
                    let clause:[]u8=tx[co..co+cl2];
                    verb[0]=0;
                    let fsl:i32=r6_frame_strip(clause,fr,verb);
                    if(fsl>0 && verb[0]!=0){
                        ci=ci+1;
                        continue;
                    }
                    // skip attitude complements ("hope the dam will hold")
                    let att:i32=0;
                    let ar2:[]u8=z_alloc(512);
                    let tm2:[]u8=z_alloc(64);
                    if(ar2.len>0 && tm2.len>0){
                        let nn:i32=z_toks(clause,ar2,64);
                        let q:i32=0;
                        while(q<nn){
                            let to:i32=a_get(ar2,2*q);
                            let tl:i32=a_get(ar2,2*q+1);
                            let ll:i32=lower_copy(clause[to..to+tl],tm2);
                            if(r6_attitude(tm2[0..ll])==1){att=1;break;}
                            q=q+1;
                        }
                    }
                    z_free(ar2);
                    z_free(tm2);
                    if(att==0){
                        // guard: skip conditional clauses ("if the storm hits,...")
                        let cond:i32=0;
                        let car3:[]u8=z_alloc(256);
                        let tm3:[]u8=z_alloc(64);
                        if(car3.len>0 && tm3.len>0){
                            let nn3:i32=z_toks(clause,car3,32);
                            if(nn3>0){
                                let to:i32=a_get(car3,0);
                                let tl:i32=a_get(car3,1);
                                let ll:i32=lower_copy(clause[to..to+tl],tm3);
                                if(z_eq(tm3[0..ll],"if")==1){
                                    // allow if claim also conditional (B28)
                                    let car4:[]u8=z_alloc(256);
                                    if(car4.len>0){
                                        let nn4:i32=z_toks(claim,car4,32);
                                        if(nn4>0){
                                            let to4:i32=a_get(car4,0);
                                            let tl4:i32=a_get(car4,1);
                                            let ll4:i32=lower_copy(claim[to4..to4+tl4],tm3);
                                            if(z_eq(tm3[0..ll4],"if")==0){cond=1;}
                                        }else{cond=1;}
                                    }else{cond=1;}
                                    z_free(car4);
                                }
                            }
                            // guard: negated evidence vs positive claim
                            // guard: exclusive/universal quantifier in evidence not in claim
                            let eneg:i32=0;
                            let equant:i32=0;
                            let q3:i32=0;
                            while(q3<nn3){
                                let to:i32=a_get(car3,2*q3);
                                let tl:i32=a_get(car3,2*q3+1);
                                let ll:i32=lower_copy(clause[to..to+tl],tm3);
                                let w:[]u8=tm3[0..ll];
                                if(is_negword(w)==1){eneg=1;}
                                if(z_eq(w,"every")==1||z_eq(w,"all")==1||z_eq(w,"each")==1||z_eq(w,"only")==1){equant=1;}
                                q3=q3+1;
                            }
                            let cneg:i32=0;
                            let cquant:i32=0;
                            if(r6_tok_has(claim,"not")==1||r6_tok_has(claim,"no")==1||r6_tok_has(claim,"never")==1){cneg=1;}
                            if(r6_tok_has(claim,"every")==1||r6_tok_has(claim,"all")==1||r6_tok_has(claim,"each")==1||r6_tok_has(claim,"only")==1){cquant=1;}
                            if(cond==0 && !(eneg==1 && cneg==0) && equant==cquant && r6_has_hedge(clause)==0){
                                let pnl:i32=r6_passive_rewrite(clause,pr);
                                let enl:i32=r6_norm_canon(pr[0..pnl],en);
                                if(enl>0 && r6_subseq(cn[0..cnl],en[0..enl])==1 && r6_has_antonym_pair(claim,clause)==0){rc=1;}
                            }
                        }
                        z_free(car3);
                        z_free(tm3);
                    }
                    ci=ci+1;
                }
                t2=t2+1;
            }
        }
    }
    z_free(cn);
    z_free(en);
    z_free(pr);
    z_free(cla);
    z_free(pro);
    z_free(fr);
    z_free(verb);
    return rc;
}
// strip un-/dis- prefix (len-guarded).
fn r6_deprefix(w:[]u8,out:[]u8)i32{
    if(w.len>4 && w[0]==117 && w[1]==110){
        let k:i32=0;
        while(k+2<w.len){out[k]=w[k+2];k=k+1;}
        return w.len-2;
    }
    if(w.len>5 && w[0]==100 && w[1]==105 && w[2]==115){
        let k2:i32=0;
        while(k2+3<w.len){out[k2]=w[k2+3];k2=k2+1;}
        return w.len-3;
    }
    let k3:i32=0;
    while(k3<w.len){out[k3]=w[k3];k3=k3+1;}
    return w.len;
}
// ---- "no one was hurt" vs "everyone escaped unhurt" ----
fn r6_noone_universal(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let ear:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let dp:[]u8=z_alloc(32);
    let P:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && ear.len>0 && tmp.len>0 && sb.len>0 && dp.len>0 && P.len>0){
        let nct:i32=z_toks(claim,car,128);
        let ni:i32=-1;
        let adv:i32=1;
        let j:i32=0;
        while(j<nct){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            let w:[]u8=tmp[0..ll];
            if(z_eq(w,"nobody")==1||z_eq(w,"none")==1){ni=j;adv=1;break;}
            if(z_eq(w,"no")==1 && j+1<nct){
                let to2:i32=a_get(car,2*(j+1));
                let tl2:i32=a_get(car,2*(j+1)+1);
                let ll2:i32=lower_copy(claim[to2..to2+tl2],tmp);
                if(z_eq(tmp[0..ll2],"one")==1){ni=j;adv=2;break;}
            }
            j=j+1;
        }
        if(ni>=0){
            let Pl:i32=r6_first_in(claim,car,ni+adv,nct,P);
            if(Pl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let net:i32=z_toks(tx,ear,128);
                    let m:i32=0;
                    while(m<net && rc==0){
                        let to:i32=a_get(ear,2*m);
                        let tl:i32=a_get(ear,2*m+1);
                        let ll:i32=lower_copy(tx[to..to+tl],tmp);
                        let w:[]u8=tmp[0..ll];
                        let univ:i32=0;
                        if(z_eq(w,"everyone")==1||z_eq(w,"everybody")==1||z_eq(w,"all")==1){univ=1;}
                        if(univ==1){
                            let n2:i32=m+1;
                            while(n2<net && rc==0){
                                let to2:i32=a_get(ear,2*n2);
                                let tl2:i32=a_get(ear,2*n2+1);
                                let ll2:i32=lower_copy(tx[to2..to2+tl2],tmp);
                                let w2:[]u8=tmp[0..ll2];
                                if(is_negword(w2)==0 && in_list(w2,lex_stop())==0){
                                    let sl:i32=r6_stem_of(w2,sb);
                                    if(sl>0){
                                        let dl:i32=r6_deprefix(sb[0..sl],dp);
                                        if(dl==Pl && z_eq(dp[0..dl],P[0..Pl])==1){rc=1;}
                                        else{
                                            if(antonym(P[0..Pl],sb[0..sl])==1){rc=1;}
                                        }
                                    }
                                }
                                n2=n2+1;
                            }
                        }
                        m=m+1;
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(ear);
    z_free(tmp);
    z_free(sb);
    z_free(dp);
    z_free(P);
    return rc;
}
// ---- contrast ellipsis: "X V, not Y" vs "X V" -> affirm ----
fn r6_contrast_affirm(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let Xs:[]u8=z_alloc(32);
    let Xv:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && Xs.len>0 && Xv.len>0){
        // find ',' then "not"
        let ci2:i32=-1;
        let q:i32=0;
        while(q<claim.len){if(claim[q]==44){ci2=q;break;}q=q+1;}
        if(ci2>0){
            let xpart:[]u8=claim[0..ci2];
            let rest:[]u8=claim[ci2+1..claim.len];
            let nrt:i32=z_toks(rest,car,128);
            let isnot:i32=0;
            if(nrt>=1){
                let to:i32=a_get(car,0);
                let tl:i32=a_get(car,1);
                let ll:i32=lower_copy(rest[to..to+tl],tmp);
                if(z_eq(tmp[0..ll],"not")==1){isnot=1;}
            }
            if(isnot==1){
                let Xsl:i32=r6_first_content(xpart,Xs);
                // Xv: last content stem of xpart
                let nct:i32=z_toks(xpart,car,128);
                let Xvl:i32=0;
                let j:i32=nct-1;
                while(j>=0 && Xvl==0){
                    let to:i32=a_get(car,2*j);
                    let tl:i32=a_get(car,2*j+1);
                    let ll:i32=lower_copy(xpart[to..to+tl],tmp);
                    let w:[]u8=tmp[0..ll];
                    if(is_negword(w)==0 && in_list(w,lex_stop())==0){
                        Xvl=r6_stem_of(w,sb);
                        let k2:i32=0;
                        while(k2<Xvl){Xv[k2]=sb[k2];k2=k2+1;}
                    }
                    j=j-1;
                }
                if(Xsl>0 && Xvl>0){
                    let t2:i32=0;
                    while(t2<2 && rc==0){
                        let tx:[]u8=title;
                        if(t2==1){tx=snip;}
                        let F:[]u8=z_alloc(32);
                        if(F.len>0){
                            let Fl:i32=r6_first_content(tx,F);
                            if(Fl==Xsl && z_eq(F[0..Fl],Xs[0..Xsl])==1){
                                if(r6_stem_has(tx,Xv[0..Xvl])==1){rc=1;}
                            }
                        }
                        z_free(F);
                        t2=t2+1;
                    }
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(Xs);
    z_free(Xv);
    return rc;
}
// ---- resultative: "the ball shattered the window" vs "the window is
// ---- broken"; "keep her dry" vs "she stayed dry" ----
// result-state verbs: X V Y entails Y is V-ed
fn r6_resultative(w:[]u8)i32{
    if(z_eq(w,"break")==1){return 1;}
    if(z_eq(w,"shatter")==1){return 1;}
    if(z_eq(w,"smash")==1){return 1;}
    if(z_eq(w,"destroy")==1){return 1;}
    if(z_eq(w,"kill")==1){return 1;}
    if(z_eq(w,"tear")==1){return 1;}
    if(z_eq(w,"crack")==1){return 1;}
    return 0;
}
fn r6_resultative_rel(claim:[]u8,title:[]u8,snip:[]u8)i32{
    // resultative: claim "X V Y" with resultative V (shatter/break/...),
    // evidence "Y V-ed" (Y as subject of the result verb).
    let car:[]u8=z_alloc(1024);
    let ear:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let V:[]u8=z_alloc(32);
    let Obj:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && ear.len>0 && tmp.len>0 && sb.len>0 && V.len>0 && Obj.len>0){
        let nct:i32=z_toks(claim,car,128);
        // find a resultative verb in the claim; object = first content after it
        let vi:i32=-1;
        let Vl:i32=0;
        let j:i32=0;
        while(j<nct && vi<0){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            if(is_negword(tmp[0..ll])==0){
                let sl:i32=r6_stem_of(tmp[0..ll],sb);
                if(sl>0 && r6_resultative(sb[0..sl])==1){
                    let q:i32=0;
                    while(q<sl){V[q]=sb[q];q=q+1;}
                    Vl=sl;
                    vi=j;
                }
            }
            j=j+1;
        }
        if(vi>=0){
            // object: first non-stopword content token after the verb
            let Ol:i32=0;
            let m:i32=vi+1;
            while(m<nct && Ol==0){
                let to:i32=a_get(car,2*m);
                let tl:i32=a_get(car,2*m+1);
                let ll:i32=lower_copy(claim[to..to+tl],tmp);
                if(is_negword(tmp[0..ll])==0 && in_list(tmp[0..ll],lex_stop())==0){
                    let sl:i32=r6_stem_of(tmp[0..ll],sb);
                    if(sl>0){
                        let q:i32=0;
                        while(q<sl){Obj[q]=sb[q];q=q+1;}
                        Ol=sl;
                    }
                }
                m=m+1;
            }
            if(Ol>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    // evidence: Obj as subject of the result verb
                    let net:i32=z_toks(tx,ear,128);
                    let e:i32=0;
                    while(e<net && rc==0){
                        let to:i32=a_get(ear,2*e);
                        let tl:i32=a_get(ear,2*e+1);
                        let ll:i32=lower_copy(tx[to..to+tl],tmp);
                        let sl:i32=r6_stem_of(tmp[0..ll],sb);
                        if(sl>0 && sl==Vl && z_eq(sb[0..sl],V[0..Vl])==1){
                            // subject = first content token to the left
                            let k:i32=e-1;
                            while(k>=0){
                                let to2:i32=a_get(ear,2*k);
                                let tl2:i32=a_get(ear,2*k+1);
                                let ll2:i32=lower_copy(tx[to2..to2+tl2],tmp);
                                if(is_negword(tmp[0..ll2])==0 && in_list(tmp[0..ll2],lex_stop())==0){
                                    let sl2:i32=r6_stem_of(tmp[0..ll2],sb);
                                    if(sl2==Ol && z_eq(sb[0..sl2],Obj[0..Ol])==1){rc=1;}
                                    break;
                                }
                                k=k-1;
                            }
                        }
                        e=e+1;
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(ear);
    z_free(tmp);
    z_free(sb);
    z_free(V);
    z_free(Obj);
    return rc;
}
// ---- superlative vs universal comparative: "the tallest" vs
// ---- "taller than everyone else" ----
fn r6_superlative_universal(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let ear:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let tmp2:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let mb:[]u8=z_alloc(32);
    let Subj:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && ear.len>0 && tmp.len>0 && tmp2.len>0 && sb.len>0 && mb.len>0 && Subj.len>0){
        let nct:i32=z_toks(claim,car,128);
        let base:[]u8=z_alloc(32);
        let basel:i32=0;
        if(base.len>0){
            let j:i32=0;
            while(j<nct && basel==0){
                let to:i32=a_get(car,2*j);
                let tl:i32=a_get(car,2*j+1);
                let ll:i32=lower_copy(claim[to..to+tl],tmp);
                if(is_super(tmp[0..ll])==1){
                    let mbl:i32=morph_base(tmp[0..ll],mb);
                    let sl:i32=r6_stem_of(mb[0..mbl],sb);
                    let q:i32=0;
                    while(q<sl){base[q]=sb[q];q=q+1;}
                    basel=sl;
                }
                j=j+1;
            }
        }
        if(basel>0){
            let Sl:i32=r6_first_content(claim,Subj);
            if(Sl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    if(r6_stem_has(tx,Subj[0..Sl])==1){
                        let net:i32=z_toks(tx,ear,128);
                        let m:i32=0;
                        while(m+1<net && rc==0){
                            let to:i32=a_get(ear,2*m);
                            let tl:i32=a_get(ear,2*m+1);
                            let ll:i32=lower_copy(tx[to..to+tl],tmp);
                            let w:[]u8=tmp[0..ll];
                            let adj:[]u8=z_alloc(32);
                            let adjl:i32=0;
                            if(adj.len>0){
                                if(z_eq(w,"more")==1 && m+2<net){
                                    let to2:i32=a_get(ear,2*(m+2));
                                    let tl2:i32=a_get(ear,2*(m+2)+1);
                                    let ll2:i32=lower_copy(tx[to2..to2+tl2],tmp2);
                                    if(z_eq(tmp2[0..ll2],"than")==1){
                                        let toa:i32=a_get(ear,2*(m+1));
                                        let tla:i32=a_get(ear,2*(m+1)+1);
                                        let lla:i32=lower_copy(tx[toa..toa+tla],tmp2);
                                        adjl=r6_stem_of(tmp2[0..lla],sb);
                                        let q:i32=0;
                                        while(q<adjl){adj[q]=sb[q];q=q+1;}
                                    }
                                }else{
                                    let mbl2:i32=morph_base(w,mb);
                                    if(mbl2!=ll && m+1<net){
                                        let to2:i32=a_get(ear,2*(m+1));
                                        let tl2:i32=a_get(ear,2*(m+1)+1);
                                        let ll2:i32=lower_copy(tx[to2..to2+tl2],tmp2);
                                        if(z_eq(tmp2[0..ll2],"than")==1){
                                            let sl2:i32=r6_stem_of(mb[0..mbl2],sb);
                                            let q2:i32=0;
                                            while(q2<sl2){adj[q2]=sb[q2];q2=q2+1;}
                                            adjl=sl2;
                                        }
                                    }
                                }
                            }
                            if(adjl>0 && adjl==basel && z_eq(adj[0..adjl],base[0..basel])==1){rc=1;}
                            z_free(adj);
                            m=m+1;
                        }
                    }
                    t2=t2+1;
                }
            }
        }
        z_free(base);
    }
    z_free(car);
    z_free(ear);
    z_free(tmp);
    z_free(tmp2);
    z_free(sb);
    z_free(mb);
    z_free(Subj);
    return rc;
}

// weak evidence source markers (RT2b: blogger/rumor/influencer -> NEUTRAL)
fn r6_weak_source(t:[]u8)i32{
    if(r6_tok_has(t,"blogger")==1){return 1;}
    if(r6_tok_has(t,"rumor")==1){return 1;}
    if(r6_tok_has(t,"influencer")==1){return 1;}
    if(r6_tok_has(t,"alleges")==1){return 1;}
    if(r6_tok_has(t,"theorist")==1){return 1;}
    if(r6_tok_has(t,"fringe")==1){return 1;}
    if(r6_tok_has(t,"gossip")==1){return 1;}
    if(r6_tok_has(t,"celebrity")==1){return 1;}
    return 0;
}
// ==================== round-7 relation repairs (RT2d) ====================
// ==================== round-7 relation repairs (RT2d) ====================
// General mechanisms for the RT2d miss classes. Pure Zag, zero RNG.
// Vetoes return 1 (withhold -> NEUTRAL); denies return 1 (DENY);
// affirms return 1 (AFFIRM). No item-specific logic.

// Complementary antonym pairs: no middle ground, so not-X entails Y.
// Deliberately narrow: opposite-polarity gradables (hot/cold,
// big/small, fast/slow) are NOT complementary -- "not hot" neither
// affirms nor denies "cold".
fn r7_complementary(a:[]u8,b:[]u8)i32{
    if(z_eq(a,"alive")==1 && z_eq(b,"dead")==1){return 1;}
    if(z_eq(a,"dead")==1 && z_eq(b,"alive")==1){return 1;}
    if(z_eq(a,"on")==1 && z_eq(b,"off")==1){return 1;}
    if(z_eq(a,"off")==1 && z_eq(b,"on")==1){return 1;}
    if(z_eq(a,"open")==1 && (z_eq(b,"closed")==1||z_eq(b,"shut")==1)){return 1;}
    if((z_eq(a,"closed")==1||z_eq(a,"shut")==1) && z_eq(b,"open")==1){return 1;}
    if(z_eq(a,"true")==1 && z_eq(b,"false")==1){return 1;}
    if(z_eq(a,"false")==1 && z_eq(b,"true")==1){return 1;}
    if(z_eq(a,"present")==1 && z_eq(b,"absent")==1){return 1;}
    if(z_eq(a,"absent")==1 && z_eq(b,"present")==1){return 1;}
    if(z_eq(a,"pass")==1 && z_eq(b,"fail")==1){return 1;}
    if(z_eq(a,"fail")==1 && z_eq(b,"pass")==1){return 1;}
    if(z_eq(a,"win")==1 && (z_eq(b,"lose")==1||z_eq(b,"loss")==1)){return 1;}
    if((z_eq(a,"lose")==1||z_eq(a,"loss")==1) && z_eq(b,"win")==1){return 1;}
    if(z_eq(a,"married")==1 && (z_eq(b,"single")==1||z_eq(b,"unmarried")==1)){return 1;}
    if((z_eq(a,"single")==1||z_eq(a,"unmarried")==1) && z_eq(b,"married")==1){return 1;}
    if(z_eq(a,"possible")==1 && z_eq(b,"impossible")==1){return 1;}
    if(z_eq(a,"impossible")==1 && z_eq(b,"possible")==1){return 1;}
    if(z_eq(a,"innocent")==1 && z_eq(b,"guilty")==1){return 1;}
    if(z_eq(a,"guilty")==1 && z_eq(b,"innocent")==1){return 1;}
    if(z_eq(a,"legal")==1 && z_eq(b,"illegal")==1){return 1;}
    if(z_eq(a,"illegal")==1 && z_eq(b,"legal")==1){return 1;}
    if(z_eq(a,"valid")==1 && z_eq(b,"invalid")==1){return 1;}
    if(z_eq(a,"invalid")==1 && z_eq(b,"valid")==1){return 1;}
    if(z_eq(a,"empty")==1 && z_eq(b,"full")==1){return 1;}
    if(z_eq(a,"full")==1 && z_eq(b,"empty")==1){return 1;}
    if(z_eq(a,"success")==1 && z_eq(b,"failure")==1){return 1;}
    if(z_eq(a,"failure")==1 && z_eq(b,"success")==1){return 1;}
    return 0;
}

// Factive (2: the complement is presupposed true) vs non-factive
// (1: the complement is merely reported/believed) frame verbs.
// 0 = not a frame verb.
fn r7_factive(w:[]u8)i32{
    if(z_eq(w,"realize")==1||z_eq(w,"realizes")==1||z_eq(w,"realized")==1||z_eq(w,"realizing")==1){return 2;}
    if(z_eq(w,"discover")==1||z_eq(w,"discovers")==1||z_eq(w,"discovered")==1||z_eq(w,"discovering")==1){return 2;}
    if(z_eq(w,"regret")==1||z_eq(w,"regrets")==1||z_eq(w,"regretted")==1||z_eq(w,"regretting")==1){return 2;}
    if(z_eq(w,"know")==1||z_eq(w,"knows")==1||z_eq(w,"knew")==1||z_eq(w,"known")==1||z_eq(w,"knowing")==1){return 2;}
    if(z_eq(w,"learn")==1||z_eq(w,"learns")==1||z_eq(w,"learned")==1||z_eq(w,"learnt")==1||z_eq(w,"learning")==1){return 2;}
    if(z_eq(w,"notice")==1||z_eq(w,"notices")==1||z_eq(w,"noticed")==1||z_eq(w,"noticing")==1){return 2;}
    if(z_eq(w,"admit")==1||z_eq(w,"admits")==1||z_eq(w,"admitted")==1||z_eq(w,"admitting")==1){return 2;}
    if(z_eq(w,"confirm")==1||z_eq(w,"confirms")==1||z_eq(w,"confirmed")==1||z_eq(w,"confirming")==1){return 2;}
    if(z_eq(w,"show")==1||z_eq(w,"shows")==1||z_eq(w,"showed")==1||z_eq(w,"shown")==1||z_eq(w,"showing")==1){return 2;}
    if(z_eq(w,"believe")==1||z_eq(w,"believes")==1||z_eq(w,"believed")==1||z_eq(w,"believing")==1){return 1;}
    if(z_eq(w,"think")==1||z_eq(w,"thinks")==1||z_eq(w,"thought")==1||z_eq(w,"thinking")==1){return 1;}
    if(z_eq(w,"claim")==1||z_eq(w,"claims")==1||z_eq(w,"claimed")==1||z_eq(w,"claiming")==1){return 1;}
    if(z_eq(w,"say")==1||z_eq(w,"says")==1||z_eq(w,"said")==1||z_eq(w,"saying")==1){return 1;}
    if(z_eq(w,"tell")==1||z_eq(w,"tells")==1||z_eq(w,"told")==1||z_eq(w,"telling")==1){return 1;}
    if(z_eq(w,"state")==1||z_eq(w,"states")==1||z_eq(w,"stated")==1||z_eq(w,"stating")==1){return 1;}
    if(z_eq(w,"argue")==1||z_eq(w,"argues")==1||z_eq(w,"argued")==1||z_eq(w,"arguing")==1){return 1;}
    if(z_eq(w,"suggest")==1||z_eq(w,"suggests")==1||z_eq(w,"suggested")==1||z_eq(w,"suggesting")==1){return 1;}
    if(z_eq(w,"report")==1||z_eq(w,"reports")==1||z_eq(w,"reported")==1||z_eq(w,"reporting")==1){return 1;}
    if(z_eq(w,"allege")==1||z_eq(w,"alleges")==1||z_eq(w,"alleged")==1||z_eq(w,"alleging")==1){return 1;}
    if(z_eq(w,"maintain")==1||z_eq(w,"maintains")==1||z_eq(w,"maintained")==1||z_eq(w,"maintaining")==1){return 1;}
    if(z_eq(w,"contend")==1||z_eq(w,"contends")==1||z_eq(w,"contended")==1||z_eq(w,"contending")==1){return 1;}
    if(z_eq(w,"hope")==1||z_eq(w,"hopes")==1||z_eq(w,"hoped")==1||z_eq(w,"hoping")==1){return 1;}
    if(z_eq(w,"expect")==1||z_eq(w,"expects")==1||z_eq(w,"expected")==1||z_eq(w,"expecting")==1){return 1;}
    return 0;
}

// Prevention verbs: "X stopped the flood" entails the flood did not
// happen. Used to extend y_negated (complement-negation scope).
fn r7_prevent_verb(w:[]u8)i32{
    if(z_eq(w,"stop")==1||z_eq(w,"stops")==1||z_eq(w,"stopped")==1||z_eq(w,"stopping")==1){return 1;}
    if(z_eq(w,"prevent")==1||z_eq(w,"prevents")==1||z_eq(w,"prevented")==1||z_eq(w,"preventing")==1){return 1;}
    if(z_eq(w,"block")==1||z_eq(w,"blocks")==1||z_eq(w,"blocked")==1||z_eq(w,"blocking")==1){return 1;}
    if(z_eq(w,"halt")==1||z_eq(w,"halts")==1||z_eq(w,"halted")==1||z_eq(w,"halting")==1){return 1;}
    if(z_eq(w,"avert")==1||z_eq(w,"averts")==1||z_eq(w,"averted")==1||z_eq(w,"averting")==1){return 1;}
    return 0;
}

// 1 if w is a "negated verb" head: fail/refuse/unable-to + V means V did
// not happen.
fn r7_failverb(w:[]u8)i32{
    if(z_eq(w,"fail")==1||z_eq(w,"fails")==1||z_eq(w,"failed")==1||z_eq(w,"failing")==1){return 1;}
    if(z_eq(w,"refuse")==1||z_eq(w,"refuses")==1||z_eq(w,"refused")==1||z_eq(w,"refusing")==1){return 1;}
    return 0;
}

// 1 if the token at j in clause is a verb occurrence negated by a
// fail/refuse/unable-to construction, a neither-nor scope, or an
// all-but scope. General negation-scope recognition for the evidence
// side of negverb_deny.
fn r7_ev_verb_negated(clause:[]u8,tok:[]u8,nt:i32,j:i32,tw:[]u8)i32{
    // (a) "failed to V" / "refused to V" / "unable to V"
    if(j>=2){
        let l1:i32=tok_lc(clause,tok,j-1,tw);
        let l2:i32=tok_lc(clause,tok,j-2,tw);
        if(l1>0 && l2>0){
            if(z_eq(tw[0..l1],"to")==1 && r7_failverb(tw[0..l2])==1){return 1;}
            if(z_eq(tw[0..l1],"to")==1 && z_eq(tw[0..l2],"unable")==1){return 1;}
        }
    }
    // (b) neither-nor scope: "neither" before j with "nor" between
    let k:i32=0;
    while(k<j){
        let lk:i32=tok_lc(clause,tok,k,tw);
        if(lk>0 && z_eq(tw[0..lk],"neither")==1){
            let q:i32=k+1;
            while(q<j){
                let lq:i32=tok_lc(clause,tok,q,tw);
                if(lq>0 && z_eq(tw[0..lq],"nor")==1){return 1;}
                q=q+1;
            }
        }
        k=k+1;
    }
    // (c) all-but scope: "all but" before j negates the predicate for
    // the excepted subject
    let k2:i32=0;
    while(k2+1<j){
        let la:i32=tok_lc(clause,tok,k2,tw);
        let lb:i32=tok_lc(clause,tok,k2+1,tw);
        if(la>0 && lb>0 && z_eq(tw[0..la],"all")==1 && z_eq(tw[0..lb],"but")==1){return 1;}
        k2=k2+1;
    }
    return 0;
}

// Weekday stem table: 1=monday .. 7=sunday, 0=not a weekday.
fn r7_weekday(w:[]u8)i32{
    if(z_eq(w,"monday")==1||z_eq(w,"mon")==1){return 1;}
    if(z_eq(w,"tuesday")==1||z_eq(w,"tue")==1||z_eq(w,"tues")==1){return 2;}
    if(z_eq(w,"wednesday")==1||z_eq(w,"wed")==1){return 3;}
    if(z_eq(w,"thursday")==1||z_eq(w,"thu")==1||z_eq(w,"thur")==1||z_eq(w,"thurs")==1){return 4;}
    if(z_eq(w,"friday")==1||z_eq(w,"fri")==1){return 5;}
    if(z_eq(w,"saturday")==1||z_eq(w,"sat")==1){return 6;}
    if(z_eq(w,"sunday")==1||z_eq(w,"sun")==1){return 7;}
    return 0;
}

// Month table: returns days in month (non-leap), 0=not a month.
fn r7_monthlen(w:[]u8)i32{
    if(z_eq(w,"january")==1||z_eq(w,"jan")==1){return 31;}
    if(z_eq(w,"february")==1||z_eq(w,"feb")==1){return 28;}
    if(z_eq(w,"march")==1||z_eq(w,"mar")==1){return 31;}
    if(z_eq(w,"april")==1||z_eq(w,"apr")==1){return 30;}
    if(z_eq(w,"may")==1){return 31;}
    if(z_eq(w,"june")==1||z_eq(w,"jun")==1){return 30;}
    if(z_eq(w,"july")==1||z_eq(w,"jul")==1){return 31;}
    if(z_eq(w,"august")==1||z_eq(w,"aug")==1){return 31;}
    if(z_eq(w,"september")==1||z_eq(w,"sep")==1||z_eq(w,"sept")==1){return 30;}
    if(z_eq(w,"october")==1||z_eq(w,"oct")==1){return 31;}
    if(z_eq(w,"november")==1||z_eq(w,"nov")==1){return 30;}
    if(z_eq(w,"december")==1||z_eq(w,"dec")==1){return 31;}
    return 0;
}

// Month order index 1..12, 0=not a month.
fn r7_monthidx(w:[]u8)i32{
    if(z_eq(w,"january")==1||z_eq(w,"jan")==1){return 1;}
    if(z_eq(w,"february")==1||z_eq(w,"feb")==1){return 2;}
    if(z_eq(w,"march")==1||z_eq(w,"mar")==1){return 3;}
    if(z_eq(w,"april")==1||z_eq(w,"apr")==1){return 4;}
    if(z_eq(w,"may")==1){return 5;}
    if(z_eq(w,"june")==1||z_eq(w,"jun")==1){return 6;}
    if(z_eq(w,"july")==1||z_eq(w,"jul")==1){return 7;}
    if(z_eq(w,"august")==1||z_eq(w,"aug")==1){return 8;}
    if(z_eq(w,"september")==1||z_eq(w,"sep")==1||z_eq(w,"sept")==1){return 9;}
    if(z_eq(w,"october")==1||z_eq(w,"oct")==1){return 10;}
    if(z_eq(w,"november")==1||z_eq(w,"nov")==1){return 11;}
    if(z_eq(w,"december")==1||z_eq(w,"dec")==1){return 12;}
    return 0;
}

// 1 if token w (lowercased) is a possessive pronoun.
fn r7_posspro(w:[]u8)i32{
    if(z_eq(w,"my")==1||z_eq(w,"your")==1||z_eq(w,"his")==1||z_eq(w,"her")==1){return 1;}
    if(z_eq(w,"its")==1||z_eq(w,"our")==1||z_eq(w,"their")==1){return 1;}
    return 0;
}

// r7b: provability verbs (prove/show/demonstrate/establish/confirm
// family). A "not" under one of these is failure-to-prove, not a
// direct denial; a "no ... un-Y" under one of these is absence of
// proof, not proof of Y.
fn r7b_proveverb(w:[]u8)i32{
    if(z_eq(w,"prove")==1||z_eq(w,"proves")==1||z_eq(w,"proved")==1||z_eq(w,"proven")==1||z_eq(w,"proving")==1){return 1;}
    if(z_eq(w,"show")==1||z_eq(w,"shows")==1||z_eq(w,"showed")==1||z_eq(w,"shown")==1||z_eq(w,"showing")==1){return 1;}
    if(z_eq(w,"demonstrate")==1||z_eq(w,"demonstrates")==1||z_eq(w,"demonstrated")==1||z_eq(w,"demonstrating")==1){return 1;}
    if(z_eq(w,"establish")==1||z_eq(w,"establishes")==1||z_eq(w,"established")==1||z_eq(w,"establishing")==1){return 1;}
    if(z_eq(w,"confirm")==1||z_eq(w,"confirms")==1||z_eq(w,"confirmed")==1||z_eq(w,"confirming")==1){return 1;}
    return 0;
}

// r7b: copula (be-verbs).
fn r7b_beverb(w:[]u8)i32{
    if(z_eq(w,"is")==1||z_eq(w,"are")==1||z_eq(w,"was")==1||z_eq(w,"were")==1){return 1;}
    if(z_eq(w,"be")==1||z_eq(w,"been")==1||z_eq(w,"being")==1||z_eq(w,"am")==1){return 1;}
    return 0;
}

// r7b: epistemic-authority nouns. A report frame whose subject is an
// institutional knowledge-producer (scientists/researchers/studies
// report X) is evidence, not mere say-so: the non-factive veto must
// not fire on it.
fn r7b_epistauth(w:[]u8)i32{
    if(z_eq(w,"scientist")==1||z_eq(w,"scientists")==1){return 1;}
    if(z_eq(w,"researcher")==1||z_eq(w,"researchers")==1){return 1;}
    if(z_eq(w,"doctor")==1||z_eq(w,"doctors")==1){return 1;}
    if(z_eq(w,"study")==1||z_eq(w,"studies")==1){return 1;}
    if(z_eq(w,"trial")==1||z_eq(w,"trials")==1){return 1;}
    if(z_eq(w,"expert")==1||z_eq(w,"experts")==1){return 1;}
    return 0;
}

// r7b: 1 if the report frame found in clause must NOT count for the
// non-factive veto: (a) the frame is negated ("No studies support the
// claim that P" is absence of support, not mere say-so); (b) the
// frame's subject is an epistemic authority ("Scientists report that
// P", "researchers say P may..."). verb is the lowercased frame verb.
fn r7b_frame_guarded(clause:[]u8,verb:[]u8,car:[]u8,tmp:[]u8)i32{
    let nt:i32=z_toks(clause,car,128);
    let vj:i32=-1;
    let j:i32=0;
    while(j<nt && vj<0){
        let to:i32=a_get(car,2*j);
        let tl:i32=a_get(car,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(ll==verb.len && z_eq(tmp[0..ll],verb)==1){vj=j;}
        j=j+1;
    }
    if(vj<0){return 0;}
    // (a) negation anywhere before the frame verb
    let k:i32=0;
    while(k<vj){
        let ko:i32=a_get(car,2*k);
        let kl:i32=a_get(car,2*k+1);
        let ll2:i32=lower_copy(clause[ko..ko+kl],tmp);
        if(is_negword(tmp[0..ll2])==1){return 1;}
        if(z_eq(tmp[0..ll2],"no")==1||z_eq(tmp[0..ll2],"never")==1){return 1;}
        if(z_eq(tmp[0..ll2],"none")==1||z_eq(tmp[0..ll2],"nobody")==1){return 1;}
        if(z_eq(tmp[0..ll2],"nothing")==1){return 1;}
        k=k+1;
    }
    // (b) nearest content word before the verb: epistemic authority?
    let s:i32=vj-1;
    while(s>=0){
        let so:i32=a_get(car,2*s);
        let sl:i32=a_get(car,2*s+1);
        let ll3:i32=lower_copy(clause[so..so+sl],tmp);
        if(ll3>0 && in_list(tmp[0..ll3],lex_stop())==0 && is_negword(tmp[0..ll3])==0){
            if(r7b_epistauth(tmp[0..ll3])==1){return 1;}
            return 0;
        }
        s=s-1;
    }
    return 0;
}

// ---- round-7 vetoes (each: 1 = withhold -> NEUTRAL) ----

// V1: non-factive frame veto. The claim's core is supported only through
// a non-factive frame ("believes/claimed/said X"). A non-factive frame
// asserts the attitude, not the complement -> withhold. Factive frames
// ("realized/discovered/regrets/showed X") are untouched: they may
// endorse via the frame relation.
fn r7_nonfactive_veto(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let cn:[]u8=z_alloc(2048);
    let fr:[]u8=z_alloc(2048);
    let en:[]u8=z_alloc(2048);
    let verb:[]u8=z_alloc(32);
    let cla:[]u8=z_alloc(2048);
    let pro:[]u8=z_alloc(2048);
    let gcar:[]u8=z_alloc(1024);
    let gtmp:[]u8=z_alloc(64);
    let rc:i32=0;
    if(cn.len>0 && fr.len>0 && en.len>0 && verb.len>0 && cla.len>0 && pro.len>0 && gcar.len>0 && gtmp.len>0){
        let cnl:i32=r6_norm_canon(claim,cn);
        if(cnl>0){
            let framed:i32=0;
            let plain:i32=0;
            let t2:i32=0;
            while(t2<2){
                let tx:[]u8=title;
                if(t2==1){tx=snip;}
                let ncl:i32=z_clauses(tx,cla,pro,32);
                let ci:i32=0;
                while(ci<ncl){
                    let co:i32=a_get(cla,2*ci);
                    let cl:i32=a_get(cla,2*ci+1);
                    let clause:[]u8=tx[co..co+cl];
                    verb[0]=0;
                    let fsl:i32=r6_frame_strip(clause,fr,verb);
                    if(fsl>0 && verb[0]!=0){
                        let vl:i32=0;
                        while(vl<32 && verb[vl]!=0){vl=vl+1;}
                        let fnl:i32=r6_norm_canon(fr[0..fsl],en);
                        if(fnl>0 && r6_subseq(cn[0..cnl],en[0..fnl])==1){
                            if(r7_factive(verb[0..vl])==1){
                                // r7b: negated frames and epistemic-authority
                                // frames are not mere say-so -> no veto.
                                if(r7b_frame_guarded(clause,verb[0..vl],gcar,gtmp)==0){framed=1;}
                            }
                            else{plain=1;}
                        }
                    }else{
                        let enl:i32=r6_norm_canon(clause,en);
                        if(enl>0 && r6_subseq(cn[0..cnl],en[0..enl])==1){plain=1;}
                    }
                    ci=ci+1;
                }
                t2=t2+1;
            }
            if(framed==1 && plain==0){rc=1;}
        }
    }
    z_free(cn);
    z_free(fr);
    z_free(en);
    z_free(verb);
    z_free(cla);
    z_free(pro);
    z_free(gcar);
    z_free(gtmp);
    return rc;
}

// V2: division veto. A superlative predicated of a whole ("the hospital
// is the best") must not transfer to a part ("every doctor is the best").
// If the claim's superlative also occurs in the evidence applied to a
// different subject, and the evidence's subject occurs in the claim
// (the part-of relation), withhold.
fn r7_division_veto(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let sup:[]u8=z_alloc(32);
    let cs:[]u8=z_alloc(32);
    let es:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && sup.len>0 && cs.len>0 && es.len>0){
        let nct:i32=z_toks(claim,car,128);
        let supl:i32=0;
        let j:i32=0;
        while(j<nct && supl==0){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            if(is_super(tmp[0..ll])==1){
                supl=r6_stem_of(tmp[0..ll],sb);
                let q:i32=0;
                while(q<supl){sup[q]=sb[q];q=q+1;}
            }
            j=j+1;
        }
        if(supl>0){
            let csl:i32=r6_first_content(claim,cs);
            if(csl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    if(r6_stem_has(tx,sup[0..supl])==1){
                        let esl:i32=r6_first_content(tx,es);
                        if(esl>0 && (esl!=csl || z_eq(es[0..esl],cs[0..csl])==0)){
                            if(r6_stem_has(claim,es[0..esl])==1){rc=1;}
                        }
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(sup);
    z_free(cs);
    z_free(es);
    return rc;
}

// r7b: fused-subjects equivocation (broadens the V3 veto). The claim's
// content is drawn from >=2 evidence segments with distinct subjects,
// presented under a claim-subject head that occurs in neither segment.
// ("The river bank is eroding and the central bank raised interest
// rates" -> "The eroding institution raised interest rates": "bank"
// in two senses fused under "institution".) Withhold.

// V3: equivocation veto. The evidence's subject is a pronoun ("He told
// ...") while the claim's subject is a non-pronoun absent from the
// evidence ("John told ..."). The pronoun's referent is unresolved:
// endorsing the claim would equivocate between two readings.
fn r7_equivocation_veto(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let ear:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let cn:[]u8=z_alloc(2048);
    let en:[]u8=z_alloc(2048);
    let rc:i32=0;
    if(car.len>0 && ear.len>0 && tmp.len>0 && sb.len>0 && cn.len>0 && en.len>0){
        let nct:i32=z_toks(claim,car,128);
        if(nct>=2){
            let co:i32=a_get(car,0);
            let cl:i32=a_get(car,1);
            let cw:[]u8=claim[co..co+cl];
            let cwl:i32=lower_copy(cw,tmp);
            // claim subject must not itself be a pronoun
            if(r6_pronoun(tmp[0..cwl])==0){
                let csl:i32=r6_stem_of(tmp[0..cwl],sb);
                if(csl>0){
                    let t2:i32=0;
                    while(t2<2 && rc==0){
                        let tx:[]u8=title;
                        if(t2==1){tx=snip;}
                        let net:i32=z_toks(tx,ear,128);
                        if(net>=2){
                            let eo:i32=a_get(ear,0);
                            let el:i32=a_get(ear,1);
                            let ell:i32=lower_copy(tx[eo..eo+el],tmp);
                            if(r6_pronoun(tmp[0..ell])==1){
                                // evidence subject is a pronoun and the
                                // claim's subject never occurs in evidence
                                if(r6_stem_has(tx,sb[0..csl])==0){
                                    // the remainder (after the subject)
                                    // must describe the same event
                                    let co2:i32=a_get(car,2);
                                    let eo2:i32=a_get(ear,2);
                                    let crest:[]u8=claim[co2..claim.len];
                                    let erest:[]u8=tx[eo2..tx.len];
                                    let cnl:i32=r6_norm_canon(crest,cn);
                                    let enl:i32=r6_norm_canon(erest,en);
                                    if(cnl>0 && enl>0 && r6_subseq(cn[0..cnl],en[0..enl])==1){rc=1;}
                                }
                            }
                        }
                        t2=t2+1;
                    }
                }
            }
        }
    }
    z_free(car);
    z_free(ear);
    z_free(tmp);
    z_free(sb);
    z_free(cn);
    z_free(en);
    return rc;
}

// V4: failure-to-prove veto. "The study failed to prove X" withholds X:
// absence of proof is not proof of absence. If the evidence says
// "failed to prove/show X" (or "did not prove", "no evidence that")
// and the claim asserts "proved X" (or "proved not X"), veto.
fn r7_failtoprove_veto(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let rc:i32=0;
    // evidence has a failure-to-prove frame?
    let lc:[]u8=z_alloc(snip.len+1);
    if(lc.len>0){
        let ll:i32=lower_copy(snip,lc);
        let low:[]u8=lc[0..ll];
        let hasfail:i32=0;
        if(z_has(low,"failed to prove")==1||z_has(low,"failed to show")==1){hasfail=1;}
        if(z_has(low,"failed to demonstrate")==1||z_has(low,"failed to establish")==1){hasfail=1;}
        if(z_has(low,"failed to confirm")==1||z_has(low,"fail to prove")==1){hasfail=1;}
        if(z_has(low,"did not prove")==1||z_has(low,"did not show")==1){hasfail=1;}
        if(z_has(low,"does not prove")==1||z_has(low,"no evidence that")==1){hasfail=1;}
        if(hasfail==1){
            // claim asserts proof? (proved/proven/showed/demonstrated)
            let cl:[]u8=z_alloc(claim.len+1);
            if(cl.len>0){
                let cll:i32=lower_copy(claim,cl);
                let clow:[]u8=cl[0..cll];
                if(z_has(clow,"proved")==1||z_has(clow,"proven")==1){rc=1;}
                if(z_has(clow,"showed")==1||z_has(clow,"demonstrated")==1){rc=1;}
                if(z_has(clow,"established")==1||z_has(clow,"confirmed")==1){rc=1;}
            }
            z_free(cl);
        }
    }
    z_free(lc);
    return rc;
}

// V5: ungrounded-possessive veto. The claim's subject (or head noun)
// carries a possessive pronoun ("their scores") whose head noun never
// occurs in the evidence: the claim introduces an entity/relation the
// evidence does not ground.
// r7b: ambiguous-pronoun veto (broadens the V5 pronoun veto). A subject
// pronoun in the evidence has >=2 proper-noun candidates and its clause
// matches the claim's predicate; the claim resolves the pronoun to one
// candidate, but the evidence does not resolve it. ("John told Mike
// that he had been fired" -> "Mike had been fired".) Withhold.

fn r7_pronoun_veto(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0){
        let nct:i32=z_toks(claim,car,128);
        let j:i32=0;
        while(j+1<nct && rc==0){
            let to:i32=a_get(car,2*j);
            let tl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[to..to+tl],tmp);
            if(r7_posspro(tmp[0..ll])==1){
                // head noun: next content word
                let k:i32=j+1;
                let hl:i32=0;
                while(k<nct && hl==0){
                    let ko:i32=a_get(car,2*k);
                    let kl:i32=a_get(car,2*k+1);
                    let l2:i32=lower_copy(claim[ko..ko+kl],tmp);
                    if(l2>0 && in_list(tmp[0..l2],lex_stop())==0){
                        hl=r6_stem_of(tmp[0..l2],sb);
                    }
                    k=k+1;
                }
                if(hl>0){
                    if(r6_stem_has(title,sb[0..hl])==0 && r6_stem_has(snip,sb[0..hl])==0){rc=1;}
                }
            }
            j=j+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    return rc;
}

// ---- round-7 deny-side (each: 1 = DENY) ----

// DEN1: explicit contrast denial. Evidence "X, not Y" (or "X but not Y")
// asserts X and denies Y for the same slot; a claim asserting Y in that
// slot is contradicted.
// r7b: 1 if contrast-deny must NOT fire for the "not" at tx-token j
// (Y stem = ys[0..ysl]).
// G1: a provability verb precedes the "not" ("has not been proven not
//     guilty" is failure-to-prove, not a direct denial).
// G2/G3: the claim itself scopes Y under negation or a prevention verb
//     ("the policy is not unhelpful", "the levees prevented flooding"
//     agree with the denied half).
// G4: the evidence copula-predicates Y of the claim's subject ("Iron
//     is magnetic; copper is not magnetic" affirms iron-is-magnetic;
//     the contrast is about copper, not the claim).
fn r7b_contrast_guarded(claim:[]u8,tx:[]u8,car:[]u8,ccar:[]u8,tmp:[]u8,css:[]u8,gsb:[]u8,net:i32,j:i32,ys:[]u8,ysl:i32)i32{
    // G1: provability verb within 6 tokens before "not"
    let a:i32=j-1;
    let a0:i32=j-6;
    if(a0<0){a0=0;}
    while(a>=a0){
        let ao:i32=a_get(car,2*a);
        let al:i32=a_get(car,2*a+1);
        let ll:i32=lower_copy(tx[ao..ao+al],tmp);
        if(r7b_proveverb(tmp[0..ll])==1){return 1;}
        a=a-1;
    }
    let nct:i32=z_toks(claim,ccar,128);
    // locate Y's stem in the claim
    let yj:i32=-1;
    let q:i32=0;
    while(q<nct && yj<0){
        let qo:i32=a_get(ccar,2*q);
        let ql:i32=a_get(ccar,2*q+1);
        let l2:i32=lower_copy(claim[qo..qo+ql],tmp);
        let sl:i32=r6_stem_of(tmp[0..l2],gsb);
        if(sl==ysl && z_eq(gsb[0..sl],ys[0..ysl])==1){yj=q;}
        q=q+1;
    }
    // G2/G3: negation or prevention verb before Y in the claim
    if(yj>0){
        let b:i32=0;
        let blocked:i32=0;
        while(b<yj && blocked==0){
            let bo:i32=a_get(ccar,2*b);
            let bl:i32=a_get(ccar,2*b+1);
            let l3:i32=lower_copy(claim[bo..bo+bl],tmp);
            if(is_negword(tmp[0..l3])==1){blocked=1;}
            if(r7_prevent_verb(tmp[0..l3])==1){blocked=1;}
            b=b+1;
        }
        if(blocked==1){return 1;}
    }
    // G4: claim-subject + be-verb + Y, no negation between, in evidence
    let csl:i32=r6_first_content(claim,css);
    if(csl>0){
        let p:i32=0;
        while(p<net){
            let po:i32=a_get(car,2*p);
            let pl:i32=a_get(car,2*p+1);
            let l4:i32=lower_copy(tx[po..po+pl],tmp);
            let s4:i32=r6_stem_of(tmp[0..l4],gsb);
            if(s4==csl && z_eq(gsb[0..s4],css[0..csl])==1){
                let qq:i32=p+1;
                let qmax:i32=p+6;
                if(qmax>net){qmax=net;}
                let foundbe:i32=0;
                while(qq<qmax && foundbe==0){
                    let qo2:i32=a_get(car,2*qq);
                    let ql2:i32=a_get(car,2*qq+1);
                    let l5:i32=lower_copy(tx[qo2..qo2+ql2],tmp);
                    if(is_negword(tmp[0..l5])==1){break;}
                    if(r7b_beverb(tmp[0..l5])==1){foundbe=1;}
                    qq=qq+1;
                }
                if(foundbe==1){
                    let r:i32=qq+1;
                    let rmax:i32=qq+5;
                    if(rmax>net){rmax=net;}
                    while(r<rmax){
                        let ro:i32=a_get(car,2*r);
                        let rl:i32=a_get(car,2*r+1);
                        let l6:i32=lower_copy(tx[ro..ro+rl],tmp);
                        if(is_negword(tmp[0..l6])==1){break;}
                        let s6:i32=r6_stem_of(tmp[0..l6],gsb);
                        if(s6==ysl && z_eq(gsb[0..s6],ys[0..ysl])==1){return 1;}
                        r=r+1;
                    }
                }
            }
            p=p+1;
        }
    }
    return 0;
}

fn r7_contrast_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let xs:[]u8=z_alloc(32);
    let ys:[]u8=z_alloc(32);
    let ccar:[]u8=z_alloc(1024);
    let css:[]u8=z_alloc(32);
    let gsb:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && xs.len>0 && ys.len>0 && ccar.len>0 && css.len>0 && gsb.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            let j:i32=0;
            while(j<net && rc==0){
                let jo:i32=a_get(car,2*j);
                let jl:i32=a_get(car,2*j+1);
                let ll:i32=lower_copy(tx[jo..jo+jl],tmp);
                let isnot:i32=0;
                if(z_eq(tmp[0..ll],"not")==1){isnot=1;}
                // also "but not": the "but" is just before
                if(isnot==1 && j+1<net){
                    // Y: first content word after "not"
                    let k:i32=j+1;
                    let ysl:i32=0;
                    while(k<net && ysl==0){
                        let ko:i32=a_get(car,2*k);
                        let kl:i32=a_get(car,2*k+1);
                        let l2:i32=lower_copy(tx[ko..ko+kl],tmp);
                        if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0){
                            // skip discourse particles
                            if(z_eq(tmp[0..l2],"only")==0 && z_eq(tmp[0..l2],"just")==0 && z_eq(tmp[0..l2],"even")==0){
                                ysl=r6_stem_of(tmp[0..l2],sb);
                                let q:i32=0;
                                while(q<ysl){ys[q]=sb[q];q=q+1;}
                            }else{
                                // "not only X": Y is X, but the
                                // construction is additive -- skip
                                break;
                            }
                        }
                        k=k+1;
                    }
                    if(ysl>0){
                        // X: first content word of the clause
                        let xsl:i32=r6_first_content(tx,xs);
                        if(xsl>0){
                            if(r6_stem_has(claim,xs[0..xsl])==1 && r6_stem_has(claim,ys[0..ysl])==1){
                                // r7b: scope guards (provability / claim-side
                                // negation-prevention / copula affirmation)
                                if(r7b_contrast_guarded(claim,tx,car,ccar,tmp,css,gsb,net,j,ys,ysl)==0){rc=1;}
                            }
                        }
                    }
                }
                j=j+1;
            }
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(xs);
    z_free(ys);
    z_free(ccar);
    z_free(css);
    z_free(gsb);
    return rc;
}

// DEN2: average-reification denial. Evidence "The average X is N"
// denies claim "Some X is (exactly) N": the average is a statistical
// abstraction; no individual X instantiates the fractional average.
// (A47: "average household has 2.4 members" denies "some household has
// exactly 2.4 members".)
fn r7_average_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let ns:[]u8=z_alloc(32);
    let sb:[]u8=z_alloc(32);
    let us:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && ns.len>0 && sb.len>0 && us.len>0){
        // evidence: "average" + number-token N (raw string, may be decimal)
        let nsl:i32=0;
        let t2:i32=0;
        while(t2<2 && nsl==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            let k:i32=0;
            while(k<net && nsl==0){
                let ko:i32=a_get(car,2*k);
                let kl:i32=a_get(car,2*k+1);
                let l2:i32=lower_copy(tx[ko..ko+kl],tmp);
                if(z_eq(tmp[0..l2],"average")==1 && k+1<net){
                    let po:i32=a_get(car,2*(k+1));
                    let pl:i32=a_get(car,2*(k+1)+1);
                    // copy the number token raw
                    let q:i32=0;
                    while(q<pl && q<32){ns[q]=tx[po+q];q=q+1;}
                    nsl=q;
                }
                k=k+1;
            }
            t2=t2+1;
        }
        if(nsl>0){
            // claim: contains the same number-token, but NOT "average"
            let nct:i32=z_toks(claim,car,128);
            let hasnum:i32=0;
            let hasavg:i32=0;
            let j:i32=0;
            while(j<nct){
                let jo:i32=a_get(car,2*j);
                let jl:i32=a_get(car,2*j+1);
                let ll:i32=lower_copy(claim[jo..jo+jl],tmp);
                if(z_eq(tmp[0..ll],"average")==1){hasavg=1;}
                if(jl==nsl){
                    let eq:i32=1;
                    let q2:i32=0;
                    while(q2<nsl){
                        if((claim[jo+q2] as i32)!=(ns[q2] as i32)){eq=0;break;}
                        q2=q2+1;
                    }
                    if(eq==1){hasnum=1;}
                }
                j=j+1;
            }
            if(hasnum==1 && hasavg==0){rc=1;}
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(ns);
    z_free(sb);
    z_free(us);
    return rc;
}

// DEN3: matrix double-negation denial. Evidence "it is not true/the case
// that S never V" entails S V-ed at least once, contradicting the claim
// "S never V".
fn r7_doubleneg_deny(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let vs:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && vs.len>0 && ss.len>0){
        // claim: "never" + verb V, subject S
        let nct:i32=z_toks(claim,car,128);
        let vsl:i32=0;
        let nj:i32=-1;
        let j:i32=0;
        while(j<nct && vsl==0){
            let jo:i32=a_get(car,2*j);
            let jl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[jo..jo+jl],tmp);
            if(z_eq(tmp[0..ll],"never")==1){
                nj=j;
                let k:i32=j+1;
                while(k<nct && vsl==0){
                    let ko:i32=a_get(car,2*k);
                    let kl:i32=a_get(car,2*k+1);
                    let l2:i32=lower_copy(claim[ko..ko+kl],tmp);
                    if(l2>0 && in_list(tmp[0..l2],lex_stop())==0){
                        vsl=r6_stem_of(tmp[0..l2],sb);
                        let q:i32=0;
                        while(q<vsl){vs[q]=sb[q];q=q+1;}
                    }
                    k=k+1;
                }
            }
            j=j+1;
        }
        if(vsl>0 && nj>0){
            // claim subject: first content word before "never"
            let ssl:i32=0;
            let s2:i32=0;
            while(s2<nj && ssl==0){
                let so:i32=a_get(car,2*s2);
                let sl:i32=a_get(car,2*s2+1);
                let l2:i32=lower_copy(claim[so..so+sl],tmp);
                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0){
                    ssl=r6_stem_of(tmp[0..l2],sb);
                    let q:i32=0;
                    while(q<ssl){ss[q]=sb[q];q=q+1;}
                }
                s2=s2+1;
            }
            if(ssl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let lc:[]u8=z_alloc(tx.len+1);
                    if(lc.len>0){
                        let ll2:i32=lower_copy(tx,lc);
                        let low:[]u8=lc[0..ll2];
                        let mframe:i32=0;
                        if(z_has(low,"not true that")==1||z_has(low,"not the case that")==1){mframe=1;}
                        if(z_has(low,"it is false that")==1||z_has(low,"false that")==1){mframe=1;}
                        if(mframe==1 && z_has(low,"never")==1){
                            if(r6_stem_has(tx,vs[0..vsl])==1 && r6_stem_has(tx,ss[0..ssl])==1){rc=1;}
                        }
                    }
                    z_free(lc);
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(vs);
    z_free(ss);
    return rc;
}

// ---- round-7 affirm-side (each: 1 = AFFIRM; narrow entailments) ----

// AFF1: negated-verb paraphrase. Evidence "failed to V" / "refused to V"
// / "was unable to V" entails the negated claim "did not V" / "never V"
// (same subject).
fn r7_negverb_paraphrase(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let vs:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && vs.len>0 && ss.len>0){
        // claim: negated, subject S, verb V (last content word)
        let nct:i32=z_toks(claim,car,128);
        let nj:i32=-1;
        let j:i32=0;
        while(j<nct){
            let jo:i32=a_get(car,2*j);
            let jl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[jo..jo+jl],tmp);
            if(is_negword(tmp[0..ll])==1){nj=j;break;}
            j=j+1;
        }
        if(nj>=0){
            let vsl:i32=0;
            let k:i32=nct-1;
            while(k>nj && vsl==0){
                let ko:i32=a_get(car,2*k);
                let kl:i32=a_get(car,2*k+1);
                let l2:i32=lower_copy(claim[ko..ko+kl],tmp);
                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0){
                    vsl=r6_stem_of(tmp[0..l2],sb);
                    let q:i32=0;
                    while(q<vsl){vs[q]=sb[q];q=q+1;}
                }
                k=k-1;
            }
            let ssl:i32=0;
            let s2:i32=0;
            while(s2<nct && ssl==0){
                let so:i32=a_get(car,2*s2);
                let sl:i32=a_get(car,2*s2+1);
                let l2:i32=lower_copy(claim[so..so+sl],tmp);
                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0){
                    ssl=r6_stem_of(tmp[0..l2],sb);
                    let q:i32=0;
                    while(q<ssl){ss[q]=sb[q];q=q+1;}
                }
                s2=s2+1;
            }
            if(vsl>0 && ssl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let net:i32=z_toks(tx,car,128);
                    let m:i32=0;
                    while(m<net && rc==0){
                        let mo:i32=a_get(car,2*m);
                        let ml:i32=a_get(car,2*m+1);
                        let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                        if(l2>0 && r7_failverb(tmp[0..l2])==1){
                            // "failed/refused to V" or bare "failed V"
                            let g:i32=m+1;
                            if(g<net){
                                let go:i32=a_get(car,2*g);
                                let gl:i32=a_get(car,2*g+1);
                                let l3:i32=lower_copy(tx[go..go+gl],tmp);
                                if(z_eq(tmp[0..l3],"to")==1){g=g+1;}
                            }
                            if(g<net){
                                let go:i32=a_get(car,2*g);
                                let gl:i32=a_get(car,2*g+1);
                                let l3:i32=lower_copy(tx[go..go+gl],tmp);
                                let wl:i32=r6_stem_of(tmp[0..l3],sb);
                                if(wl==vsl && z_eq(sb[0..wl],vs[0..vsl])==1){
                                    if(r6_stem_has(tx,ss[0..ssl])==1){rc=1;}
                                }
                            }
                        }
                        if(l2>0 && z_eq(tmp[0..l2],"unable")==1 && m+2<net){
                            let go:i32=a_get(car,2*(m+2));
                            let gl:i32=a_get(car,2*(m+2)+1);
                            let l3:i32=lower_copy(tx[go..go+gl],tmp);
                            let wl:i32=r6_stem_of(tmp[0..l3],sb);
                            if(wl==vsl && z_eq(sb[0..wl],vs[0..vsl])==1){
                                if(r6_stem_has(tx,ss[0..ssl])==1){rc=1;}
                            }
                        }
                        m=m+1;
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(vs);
    z_free(ss);
    return rc;
}

// AFF2: neither-nor distribution. Evidence "Neither A nor B was P"
// entails "A was not P" and "B was not P".
fn r7_neithernor(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let ps:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && ps.len>0 && ss.len>0){
        // claim: negated, subject S, predicate P (last content word)
        let nct:i32=z_toks(claim,car,128);
        let neg:i32=0;
        let j:i32=0;
        while(j<nct){
            let jo:i32=a_get(car,2*j);
            let jl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[jo..jo+jl],tmp);
            if(is_negword(tmp[0..ll])==1){neg=1;break;}
            j=j+1;
        }
        if(neg==1){
            let psl:i32=0;
            let k:i32=nct-1;
            while(k>=0 && psl==0){
                let ko:i32=a_get(car,2*k);
                let kl:i32=a_get(car,2*k+1);
                let l2:i32=lower_copy(claim[ko..ko+kl],tmp);
                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0){
                    psl=r6_stem_of(tmp[0..l2],sb);
                    let q:i32=0;
                    while(q<psl){ps[q]=sb[q];q=q+1;}
                }
                k=k-1;
            }
            let ssl:i32=0;
            let s2:i32=0;
            while(s2<nct && ssl==0){
                let so:i32=a_get(car,2*s2);
                let sl:i32=a_get(car,2*s2+1);
                let l2:i32=lower_copy(claim[so..so+sl],tmp);
                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0){
                    ssl=r6_stem_of(tmp[0..l2],sb);
                    let q:i32=0;
                    while(q<ssl){ss[q]=sb[q];q=q+1;}
                }
                s2=s2+1;
            }
            if(psl>0 && ssl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let net:i32=z_toks(tx,car,128);
                    // find "neither" A "nor" B ... P
                    let ni:i32=-1;
                    let m:i32=0;
                    while(m<net && ni<0){
                        let mo:i32=a_get(car,2*m);
                        let ml:i32=a_get(car,2*m+1);
                        let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                        if(z_eq(tmp[0..l2],"neither")==1){ni=m;}
                        m=m+1;
                    }
                    if(ni>=0){
                        // A: first content word after "neither"; B: first
                        // content word after "nor"
                        let asl:i32=0;
                        let bsl:i32=0;
                        let asb:[]u8=z_alloc(32);
                        let bsb:[]u8=z_alloc(32);
                        if(asb.len>0 && bsb.len>0){
                            let g:i32=ni+1;
                            while(g<net && asl==0){
                                let go:i32=a_get(car,2*g);
                                let gl:i32=a_get(car,2*g+1);
                                let l2:i32=lower_copy(tx[go..go+gl],tmp);
                                if(z_eq(tmp[0..l2],"nor")==1){break;}
                                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0){
                                    asl=r6_stem_of(tmp[0..l2],asb);
                                }
                                g=g+1;
                            }
                            while(g<net && bsl==0){
                                let go:i32=a_get(car,2*g);
                                let gl:i32=a_get(car,2*g+1);
                                let l2:i32=lower_copy(tx[go..go+gl],tmp);
                                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && z_eq(tmp[0..l2],"nor")==0){
                                    bsl=r6_stem_of(tmp[0..l2],bsb);
                                }
                                g=g+1;
                            }
                            if((asl>0 && asl==ssl && z_eq(asb[0..asl],ss[0..ssl])==1)||(bsl>0 && bsl==ssl && z_eq(bsb[0..bsl],ss[0..ssl])==1)){
                                if(r6_stem_has(tx,ps[0..psl])==1){rc=1;}
                            }
                        }
                        z_free(asb);
                        z_free(bsb);
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(ps);
    z_free(ss);
    return rc;
}

// AFF3: all-but exclusion. Evidence "All but X V-ed" entails "X did not
// V".
fn r7_allbut(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let tmp2:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let vs:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && tmp2.len>0 && sb.len>0 && vs.len>0 && ss.len>0){
        let nct:i32=z_toks(claim,car,128);
        let neg:i32=0;
        let j:i32=0;
        while(j<nct){
            let jo:i32=a_get(car,2*j);
            let jl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[jo..jo+jl],tmp);
            if(is_negword(tmp[0..ll])==1){neg=1;break;}
            j=j+1;
        }
        if(neg==1){
            let vsl:i32=0;
            let k:i32=nct-1;
            while(k>=0 && vsl==0){
                let ko:i32=a_get(car,2*k);
                let kl:i32=a_get(car,2*k+1);
                let l2:i32=lower_copy(claim[ko..ko+kl],tmp);
                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0){
                    vsl=r6_stem_of(tmp[0..l2],sb);
                    let q:i32=0;
                    while(q<vsl){vs[q]=sb[q];q=q+1;}
                }
                k=k-1;
            }
            let ssl:i32=0;
            let s2:i32=0;
            while(s2<nct && ssl==0){
                let so:i32=a_get(car,2*s2);
                let sl:i32=a_get(car,2*s2+1);
                let l2:i32=lower_copy(claim[so..so+sl],tmp);
                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0){
                    ssl=r6_stem_of(tmp[0..l2],sb);
                    let q:i32=0;
                    while(q<ssl){ss[q]=sb[q];q=q+1;}
                }
                s2=s2+1;
            }
            if(vsl>0 && ssl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let net:i32=z_toks(tx,car,128);
                    let m:i32=0;
                    while(m+1<net && rc==0){
                        let mo:i32=a_get(car,2*m);
                        let ml:i32=a_get(car,2*m+1);
                        let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                        let po:i32=a_get(car,2*(m+1));
                        let pl:i32=a_get(car,2*(m+1)+1);
                        let l3:i32=lower_copy(tx[po..po+pl],tmp2);
                        // "all but" with X right after (allowing "the")
                        if(z_eq(tmp[0..l2],"all")==1 && z_eq(tmp2[0..l3],"but")==1){
                            let g:i32=m+2;
                            if(g<net){
                                let go:i32=a_get(car,2*g);
                                let gl:i32=a_get(car,2*g+1);
                                let l4:i32=lower_copy(tx[go..go+gl],tmp);
                                if(z_eq(tmp[0..l4],"the")==1){g=g+1;}
                            }
                            if(g<net){
                                let go:i32=a_get(car,2*g);
                                let gl:i32=a_get(car,2*g+1);
                                let l4:i32=lower_copy(tx[go..go+gl],tmp);
                                let xl:i32=r6_stem_of(tmp[0..l4],sb);
                                if(xl==ssl && z_eq(sb[0..xl],ss[0..ssl])==1){
                                    if(r6_stem_has(tx,vs[0..vsl])==1){rc=1;}
                                }
                            }
                        }
                        m=m+1;
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(tmp2);
    z_free(sb);
    z_free(vs);
    z_free(ss);
    return rc;
}

// AFF4: evidence-side double negation. "No S was un-P" entails "every S
// was P" (and "S was P").
// r7b: generic person terms (for a future "no one was unhappy" case;
// currently unused by the strict D2 subject check, kept for the
// documented refinement path).
fn r7b_person(w:[]u8)i32{
    if(z_eq(w,"one")==1||z_eq(w,"ones")==1){return 1;}
    if(z_eq(w,"person")==1||z_eq(w,"people")==1){return 1;}
    if(z_eq(w,"everyone")==1||z_eq(w,"everybody")==1){return 1;}
    if(z_eq(w,"anyone")==1||z_eq(w,"anybody")==1){return 1;}
    if(z_eq(w,"someone")==1||z_eq(w,"somebody")==1){return 1;}
    if(z_eq(w,"nobody")==1){return 1;}
    return 0;
}

fn r7_doubleneg2(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let base:[]u8=z_alloc(32);
    let ps:[]u8=z_alloc(32);
    let nbuf:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && base.len>0 && ps.len>0 && nbuf.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            // evidence: "no" ... negpref-word W (base B)
            let ni:i32=-1;
            let m:i32=0;
            while(m<net && ni<0){
                let mo:i32=a_get(car,2*m);
                let ml:i32=a_get(car,2*m+1);
                let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                if(z_eq(tmp[0..l2],"no")==1){ni=m;}
                m=m+1;
            }
            if(ni>=0){
                // r7b D2: N = the first content word quantified by "no".
                let npos:i32=-1;
                let ng:i32=ni+1;
                while(ng<net && npos<0){
                    let ngo:i32=a_get(car,2*ng);
                    let ngl:i32=a_get(car,2*ng+1);
                    let l2n:i32=lower_copy(tx[ngo..ngo+ngl],tmp);
                    if(l2n>0 && in_list(tmp[0..l2n],lex_stop())==0 && is_negword(tmp[0..l2n])==0){npos=ng;}
                    ng=ng+1;
                }
                let nsl:i32=0;
                if(npos>=0){
                    let no2:i32=a_get(car,2*npos);
                    let nl2:i32=a_get(car,2*npos+1);
                    let l2m:i32=lower_copy(tx[no2..no2+nl2],tmp);
                    nsl=r6_stem_of(tmp[0..l2m],nbuf);
                }
                let bl:i32=0;
                let sawprove:i32=0;
                let g:i32=ni+1;
                while(g<net && bl==0){
                    let go:i32=a_get(car,2*g);
                    let gl:i32=a_get(car,2*g+1);
                    let l2:i32=lower_copy(tx[go..go+gl],tmp);
                    if(l2>0 && in_list(tmp[0..l2],lex_stop())==0){
                        // r7b D1: provability between "no" and W.
                        if(r7b_proveverb(tmp[0..l2])==1){sawprove=1;}
                        let rl:i32=negpref_strip(tmp[0..l2],base);
                        if(rl>0){
                            bl=r6_stem_of(base[0..rl],sb);
                            let q:i32=0;
                            while(q<bl){ps[q]=sb[q];q=q+1;}
                        }
                    }
                    g=g+1;
                }
                // r7b D1: "no ... proven ... un-Y" is failure-to-prove,
                // not proof of Y.
                if(sawprove==1){bl=0;}
                if(bl>0){
                    // claim: subject stems overlap evidence, claim has B
                    if(r6_stem_has(claim,ps[0..bl])==1){
                        // subject check: claim's first content stem in evidence
                        let nct:i32=z_toks(claim,car,128);
                        let s2:i32=0;
                        while(s2<nct && rc==0){
                            let so:i32=a_get(car,2*s2);
                            let sl:i32=a_get(car,2*s2+1);
                            let l2:i32=lower_copy(claim[so..so+sl],tmp);
                            if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0){
                                let wl:i32=r6_stem_of(tmp[0..l2],sb);
                                // r7b D2: "no" must quantify the claim's
                                // subject. "No study has proven unsafe"
                                // is not about "supplements".
                                if(wl>0 && r6_stem_has(tx,sb[0..wl])==1){
                                    if(nsl>0 && wl==nsl && z_eq(sb[0..wl],nbuf[0..nsl])==1){rc=1;}
                                }
                                break;
                            }
                            s2=s2+1;
                        }
                    }
                }
            }
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(base);
    z_free(ps);
    z_free(nbuf);
    return rc;
}

// AFF5: dative alternation. "V DO to IO" entails "V IO DO" (same verb,
// same subject).
fn r7_dative(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let ds:[]u8=z_alloc(32);
    let is:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && ds.len>0 && is.len>0 && ss.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            // evidence: V ... DO ... "to" IO
            let ti:i32=-1;
            let m:i32=0;
            while(m<net && ti<0){
                let mo:i32=a_get(car,2*m);
                let ml:i32=a_get(car,2*m+1);
                let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                if(z_eq(tmp[0..l2],"to")==1){ti=m;}
                m=m+1;
            }
            if(ti>1 && ti+1<net){
                // DO: last content word before "to" (record its index);
                // IO: first content word after "to"; V: last content word
                // before DO
                let dol:i32=0;
                let iol:i32=0;
                let doi:i32=-1;
                let k:i32=ti-1;
                while(k>=0 && dol==0){
                    let ko:i32=a_get(car,2*k);
                    let kl:i32=a_get(car,2*k+1);
                    let l2:i32=lower_copy(tx[ko..ko+kl],tmp);
                    if(l2>0 && in_list(tmp[0..l2],lex_stop())==0){
                        dol=r6_stem_of(tmp[0..l2],ds);
                        doi=k;
                    }
                    k=k-1;
                }
                let g:i32=ti+1;
                while(g<net && iol==0){
                    let go:i32=a_get(car,2*g);
                    let gl:i32=a_get(car,2*g+1);
                    let l2:i32=lower_copy(tx[go..go+gl],tmp);
                    if(l2>0 && in_list(tmp[0..l2],lex_stop())==0){
                        iol=r6_stem_of(tmp[0..l2],is);
                    }
                    g=g+1;
                }
                let vsl:i32=0;
                let v2:i32=doi-1;
                while(v2>=0 && vsl==0){
                    let vo:i32=a_get(car,2*v2);
                    let vl:i32=a_get(car,2*v2+1);
                    let l2:i32=lower_copy(tx[vo..vo+vl],tmp);
                    if(l2>0 && in_list(tmp[0..l2],lex_stop())==0){
                        vsl=r6_stem_of(tmp[0..l2],sb);
                    }
                    v2=v2-1;
                }
                let ssl:i32=r6_first_content(tx,ss);
                if(dol>0 && iol>0 && vsl>0 && ssl>0){
                    // claim: same subject, same verb, IO before DO
                    if(r6_stem_has(claim,ss[0..ssl])==1 && r6_stem_has(claim,sb[0..vsl])==1){
                        let nct:i32=z_toks(claim,car,128);
                        let pi:i32=-1;
                        let qi:i32=-1;
                        let q2:i32=0;
                        while(q2<nct){
                            let qo:i32=a_get(car,2*q2);
                            let ql:i32=a_get(car,2*q2+1);
                            let l2:i32=lower_copy(claim[qo..qo+ql],tmp);
                            let wl:i32=r6_stem_of(tmp[0..l2],sb);
                            if(wl==iol && z_eq(sb[0..wl],is[0..iol])==1 && pi<0){pi=q2;}
                            if(wl==dol && z_eq(sb[0..wl],ds[0..dol])==1){qi=q2;}
                            q2=q2+1;
                        }
                        if(pi>=0 && qi>pi){rc=1;}
                    }
                }
            }
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(ds);
    z_free(is);
    z_free(ss);
    return rc;
}

// AFF6: genitive alternation. "P's N" entails "N of P" (and reverse).
fn r7_genitive(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let ps:[]u8=z_alloc(32);
    let ns:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && ps.len>0 && ns.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            // evidence: token ending in "'s" (possessor P), next content
            // word N (possessed)
            let m:i32=0;
            while(m+1<net && rc==0){
                let mo:i32=a_get(car,2*m);
                let ml:i32=a_get(car,2*m+1);
                let ew:[]u8=tx[mo..mo+ml];
                if(ml>2 && (ew[ml-2] as i32)==39 && (ew[ml-1] as i32)==115){
                    let pl:i32=r6_stem_of(ew[0..ml-2],ps);
                    let g:i32=m+1;
                    let nl:i32=0;
                    while(g<net && nl==0){
                        let go:i32=a_get(car,2*g);
                        let gl:i32=a_get(car,2*g+1);
                        let l2:i32=lower_copy(tx[go..go+gl],tmp);
                        if(l2>0 && in_list(tmp[0..l2],lex_stop())==0){
                            nl=r6_stem_of(tmp[0..l2],ns);
                        }
                        g=g+1;
                    }
                    if(pl>0 && nl>0){
                        // claim: N ... "of" ... P
                        let nct:i32=z_toks(claim,car,128);
                        let ni2:i32=-1;
                        let oi2:i32=-1;
                        let pi2:i32=-1;
                        let q:i32=0;
                        while(q<nct){
                            let qo:i32=a_get(car,2*q);
                            let ql:i32=a_get(car,2*q+1);
                            let l2:i32=lower_copy(claim[qo..qo+ql],tmp);
                            let wl:i32=r6_stem_of(tmp[0..l2],sb);
                            if(wl==nl && z_eq(sb[0..wl],ns[0..nl])==1 && ni2<0){ni2=q;}
                            if(z_eq(tmp[0..l2],"of")==1 && oi2<0){oi2=q;}
                            if(wl==pl && z_eq(sb[0..wl],ps[0..pl])==1){pi2=q;}
                            q=q+1;
                        }
                        if(ni2>=0 && oi2>ni2 && pi2>oi2){rc=1;}
                    }
                }
                m=m+1;
            }
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(ps);
    z_free(ns);
    return rc;
}

// AFF7: minimizer affirmation. "barely/hardly/scarcely V" entails "V"
// (same subject): the minimizer weakens but does not negate.
fn r7_barely(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let vs:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let cn:[]u8=z_alloc(2048);
    let en:[]u8=z_alloc(2048);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && vs.len>0 && ss.len>0 && cn.len>0 && en.len>0){
        // claim must be UNNEGATED (else the minimizer reading flips)
        let nct:i32=z_toks(claim,car,128);
        let cneg:i32=0;
        let j:i32=0;
        while(j<nct){
            let jo:i32=a_get(car,2*j);
            let jl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[jo..jo+jl],tmp);
            if(is_negword(tmp[0..ll])==1){cneg=1;break;}
            j=j+1;
        }
        if(cneg==0){
            let cnl:i32=r6_norm_canon(claim,cn);
            if(cnl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let net:i32=z_toks(tx,car,128);
                    let m:i32=0;
                    while(m<net && rc==0){
                        let mo:i32=a_get(car,2*m);
                        let ml:i32=a_get(car,2*m+1);
                        let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                        if(z_eq(tmp[0..l2],"barely")==1||z_eq(tmp[0..l2],"hardly")==1||z_eq(tmp[0..l2],"scarcely")==1){
                            // strip the minimizer and compare norms
                            let stripped:[]u8=z_alloc(tx.len+1);
                            if(stripped.len>0){
                                let w:i32=0;
                                let q:i32=0;
                                while(q<tx.len){
                                    let inmin:i32=0;
                                    if(q>=mo && q<mo+ml){inmin=1;}
                                    if(inmin==0){stripped[w]=tx[q];w=w+1;}
                                    q=q+1;
                                }
                                let enl:i32=r6_norm_canon(stripped[0..w],en);
                                if(enl>0 && r6_subseq(cn[0..cnl],en[0..enl])==1){rc=1;}
                            }
                            z_free(stripped);
                        }
                        m=m+1;
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(vs);
    z_free(ss);
    z_free(cn);
    z_free(en);
    return rc;
}

// AFF8: cessation affirmation. "X stopped V-ing" entails "X does not V"
// / "X no longer V-s" (same subject, same verb stem).
fn r7_stopped(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let vs:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && vs.len>0 && ss.len>0){
        let nct:i32=z_toks(claim,car,128);
        let neg:i32=0;
        let j:i32=0;
        while(j<nct){
            let jo:i32=a_get(car,2*j);
            let jl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[jo..jo+jl],tmp);
            if(is_negword(tmp[0..ll])==1){neg=1;break;}
            if(z_eq(tmp[0..ll],"longer")==1){neg=1;break;}
            j=j+1;
        }
        if(neg==1){
            // claim verb: last content word; subject: first content word
            let vsl:i32=0;
            let k:i32=nct-1;
            while(k>=0 && vsl==0){
                let ko:i32=a_get(car,2*k);
                let kl:i32=a_get(car,2*k+1);
                let l2:i32=lower_copy(claim[ko..ko+kl],tmp);
                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0 && z_eq(tmp[0..l2],"longer")==0){
                    vsl=r6_stem_of(tmp[0..l2],vs);
                }
                k=k-1;
            }
            let ssl:i32=0;
            let s2:i32=0;
            while(s2<nct && ssl==0){
                let so:i32=a_get(car,2*s2);
                let sl:i32=a_get(car,2*s2+1);
                let l2:i32=lower_copy(claim[so..so+sl],tmp);
                if(l2>0 && in_list(tmp[0..l2],lex_stop())==0 && is_negword(tmp[0..l2])==0){
                    ssl=r6_stem_of(tmp[0..l2],ss);
                }
                s2=s2+1;
            }
            if(vsl>0 && ssl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    let net:i32=z_toks(tx,car,128);
                    let m:i32=0;
                    while(m+1<net && rc==0){
                        let mo:i32=a_get(car,2*m);
                        let ml:i32=a_get(car,2*m+1);
                        let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                        let wsl:i32=r6_stem_of(tmp[0..l2],sb);
                        if(wsl>0 && z_eq(sb[0..wsl],"stop")==1){
                            // next content word: V-ing, stem must match
                            let g:i32=m+1;
                            while(g<net){
                                let go:i32=a_get(car,2*g);
                                let gl:i32=a_get(car,2*g+1);
                                let l3:i32=lower_copy(tx[go..go+gl],tmp);
                                if(l3>0 && in_list(tmp[0..l3],lex_stop())==0){
                                    let wl:i32=r6_stem_of(tmp[0..l3],sb);
                                    if(wl==vsl && z_eq(sb[0..wl],vs[0..vsl])==1){
                                        if(r6_stem_has(tx,ss[0..ssl])==1){rc=1;}
                                    }
                                    break;
                                }
                                g=g+1;
                            }
                        }
                        m=m+1;
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(vs);
    z_free(ss);
    return rc;
}

// AFF9: conjunction elimination. "A and B" entails A (and entails B).
fn r7_conj_elim(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let cn:[]u8=z_alloc(2048);
    let pn:[]u8=z_alloc(2048);
    let tmp:[]u8=z_alloc(64);
    let rc:i32=0;
    if(car.len>0 && cn.len>0 && pn.len>0 && tmp.len>0){
        let cnl:i32=r6_norm_canon(claim,cn);
        if(cnl>0){
            let t2:i32=0;
            while(t2<2 && rc==0){
                let tx:[]u8=title;
                if(t2==1){tx=snip;}
                let net:i32=z_toks(tx,car,128);
                let m:i32=0;
                while(m<net && rc==0){
                    let mo:i32=a_get(car,2*m);
                    let ml:i32=a_get(car,2*m+1);
                    let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                    // split only on "and", never on "or"
                    if(z_eq(tmp[0..l2],"and")==1 && m>0 && m+1<net){
                        let left:[]u8=tx[0..mo];
                        let right:[]u8=tx[mo+ml..tx.len];
                        let lnl:i32=r6_norm_canon(left,pn);
                        if(lnl==cnl && lnl>0 && z_eq(pn[0..lnl],cn[0..cnl])==1){rc=1;}
                        if(rc==0){
                            let rnl:i32=r6_norm_canon(right,pn);
                            if(rnl==cnl && rnl>0 && z_eq(pn[0..rnl],cn[0..cnl])==1){rc=1;}
                        }
                    }
                    m=m+1;
                }
                t2=t2+1;
            }
        }
    }
    z_free(car);
    z_free(cn);
    z_free(pn);
    z_free(tmp);
    return rc;
}

// AFF10: zero-quantifier paraphrase. "Not a single X V" entails "No X V".
fn r7_zeroq_single(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let tmp2:[]u8=z_alloc(64);
    let tmp3:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let xs:[]u8=z_alloc(32);
    let cn:[]u8=z_alloc(2048);
    let en:[]u8=z_alloc(2048);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && tmp2.len>0 && tmp3.len>0 && sb.len>0 && xs.len>0 && cn.len>0 && en.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            let m:i32=0;
            while(m+3<net && rc==0){
                let m0:i32=a_get(car,2*m);
                let m1:i32=a_get(car,2*m+1);
                let l0:i32=lower_copy(tx[m0..m0+m1],tmp);
                let n0:i32=a_get(car,2*(m+1));
                let n1:i32=a_get(car,2*(m+1)+1);
                let l1:i32=lower_copy(tx[n0..n0+n1],tmp2);
                let p0:i32=a_get(car,2*(m+2));
                let p1:i32=a_get(car,2*(m+2)+1);
                let l2:i32=lower_copy(tx[p0..p0+p1],tmp3);
                if(z_eq(tmp[0..l0],"not")==1 && z_eq(tmp2[0..l1],"a")==1 && z_eq(tmp3[0..l2],"single")==1){
                    // X: next content word
                    let g:i32=m+3;
                    let xsl:i32=0;
                    while(g<net && xsl==0){
                        let go:i32=a_get(car,2*g);
                        let gl:i32=a_get(car,2*g+1);
                        let l3:i32=lower_copy(tx[go..go+gl],tmp);
                        if(l3>0 && in_list(tmp[0..l3],lex_stop())==0){
                            xsl=r6_stem_of(tmp[0..l3],xs);
                        }
                        g=g+1;
                    }
                    if(xsl>0){
                        // claim: "no X" and claim content subset of
                        // evidence content
                        let cnl:i32=r6_norm_canon(claim,cn);
                        let enl:i32=r6_norm_canon(tx,en);
                        if(cnl>0 && enl>0 && r6_subseq(cn[0..cnl],en[0..enl])==1){
                            if(r6_stem_has(claim,xs[0..xsl])==1){rc=1;}
                        }
                    }
                }
                m=m+1;
            }
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(tmp2);
    z_free(tmp3);
    z_free(sb);
    z_free(xs);
    z_free(cn);
    z_free(en);
    return rc;
}

// ---- round-7 numeric relation checks (each: 1 = AFFIRM) ----

// Parse a digit run ignoring commas ("50,000" -> 50000). -1 if none.
fn r7_parse_digits(s:[]u8)i64{
    let v:i64=0;
    let f:i32=0;
    let i:i32=0;
    while(i<s.len){
        let b:i32=s[i] as i32;
        if(b>=48 && b<=57){v=v*10+((b-48) as i64);f=1;}
        else{
            if(b!=44){break;}
        }
        i=i+1;
    }
    if(f==0){return -1;}
    return v;
}

// N1: multiplier. "twice as many U as" / "N times as many U as" with
// evidence "M U" entails "mult*M U" (same subject).
fn r7_num_mult(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let tmp2:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let us:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && tmp2.len>0 && sb.len>0 && us.len>0 && ss.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            let m:i32=0;
            while(m<net && rc==0){
                let mo:i32=a_get(car,2*m);
                let ml:i32=a_get(car,2*m+1);
                let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                let mult:i64=0;
                let anch:i32=-1;
                if(z_eq(tmp[0..l2],"twice")==1){mult=2;anch=m;}
                if(mult==0 && m+1<net){
                    let nv:i64=r6_numtok(tmp[0..l2]);
                    let po:i32=a_get(car,2*(m+1));
                    let pl:i32=a_get(car,2*(m+1)+1);
                    let l3:i32=lower_copy(tx[po..po+pl],tmp);
                    if(nv>0 && z_eq(tmp[0..l3],"times")==1){mult=nv;anch=m+1;}
                }
                if(mult>0 && anch+2<net){
                    // expect "as many" after the anchor
                    let a0:i32=a_get(car,2*(anch+1));
                    let a1:i32=a_get(car,2*(anch+1)+1);
                    let la:i32=lower_copy(tx[a0..a0+a1],tmp);
                    let b0:i32=a_get(car,2*(anch+2));
                    let b1:i32=a_get(car,2*(anch+2)+1);
                    let lb:i32=lower_copy(tx[b0..b0+b1],tmp2);
                    if(z_eq(tmp[0..la],"as")==1 && z_eq(tmp2[0..lb],"many")==1){
                        // unit U: first content word after "many"
                        let usl:i32=0;
                        let g:i32=anch+3;
                        while(g<net && usl==0){
                            let go:i32=a_get(car,2*g);
                            let gl:i32=a_get(car,2*g+1);
                            let l3:i32=lower_copy(tx[go..go+gl],tmp);
                            if(l3>0 && in_list(tmp[0..l3],lex_stop())==0){
                                usl=r6_stem_of(tmp[0..l3],us);
                            }
                            g=g+1;
                        }
                        if(usl>0){
                            // M: number in evidence followed by U
                            let M:i64=-1;
                            let q:i32=0;
                            while(q+1<net && M<0){
                                let qo:i32=a_get(car,2*q);
                                let ql:i32=a_get(car,2*q+1);
                                let l3:i32=lower_copy(tx[qo..qo+ql],tmp);
                                let nv2:i64=r6_numtok(tmp[0..l3]);
                                if(nv2>=0){
                                    let ro:i32=a_get(car,2*(q+1));
                                    let rl:i32=a_get(car,2*(q+1)+1);
                                    let l4:i32=lower_copy(tx[ro..ro+rl],tmp);
                                    let wl:i32=r6_stem_of(tmp[0..l4],sb);
                                    if(wl==usl && z_eq(sb[0..wl],us[0..usl])==1){M=nv2;}
                                }
                                q=q+1;
                            }
                            if(M>=0){
                                // claim: number N followed by U, same
                                // subject, N == mult*M
                                let ssl:i32=r6_first_content(tx,ss);
                                if(ssl>0 && r6_stem_has(claim,ss[0..ssl])==1){
                                    let nct:i32=z_toks(claim,car,128);
                                    let q2:i32=0;
                                    while(q2+1<nct && rc==0){
                                        let qo:i32=a_get(car,2*q2);
                                        let ql:i32=a_get(car,2*q2+1);
                                        let l3:i32=lower_copy(claim[qo..qo+ql],tmp);
                                        let nv3:i64=r6_numtok(tmp[0..l3]);
                                        if(nv3>=0){
                                            let ro:i32=a_get(car,2*(q2+1));
                                            let rl:i32=a_get(car,2*(q2+1)+1);
                                            let l4:i32=lower_copy(claim[ro..ro+rl],tmp);
                                            let wl:i32=r6_stem_of(tmp[0..l4],sb);
                                            if(wl==usl && z_eq(sb[0..wl],us[0..usl])==1){
                                                if(nv3==mult*M){rc=1;}
                                            }
                                        }
                                        q2=q2+1;
                                    }
                                }
                            }
                        }
                    }
                }
                m=m+1;
            }
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(tmp2);
    z_free(sb);
    z_free(us);
    z_free(ss);
    return rc;
}

// N2: percent-of. "P percent of N U" with claim "M U", M*100==P*N.
fn r7_num_pctof(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let us:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && us.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            let m:i32=0;
            while(m<net && rc==0){
                let mo:i32=a_get(car,2*m);
                let ml:i32=a_get(car,2*m+1);
                let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                if(z_eq(tmp[0..l2],"percent")==1 && m>=1 && m+3<net){
                    let p0:i32=a_get(car,2*(m-1));
                    let p1:i32=a_get(car,2*(m-1)+1);
                    let lp:i32=lower_copy(tx[p0..p0+p1],tmp);
                    let P:i64=r6_numtok(tmp[0..lp]);
                    let o0:i32=a_get(car,2*(m+1));
                    let o1:i32=a_get(car,2*(m+1)+1);
                    let lo:i32=lower_copy(tx[o0..o0+o1],tmp);
                    if(P>=0 && z_eq(tmp[0..lo],"of")==1){
                        let n0:i32=a_get(car,2*(m+2));
                        let n1:i32=a_get(car,2*(m+2)+1);
                        let ln:i32=lower_copy(tx[n0..n0+n1],tmp);
                        let N:i64=r6_numtok(tmp[0..ln]);
                        if(N>=0){
                            // U: first content word after N
                            let usl:i32=0;
                            let g:i32=m+3;
                            while(g<net && usl==0){
                                let go:i32=a_get(car,2*g);
                                let gl:i32=a_get(car,2*g+1);
                                let l3:i32=lower_copy(tx[go..go+gl],tmp);
                                if(l3>0 && in_list(tmp[0..l3],lex_stop())==0){
                                    usl=r6_stem_of(tmp[0..l3],us);
                                }
                                g=g+1;
                            }
                            if(usl>0){
                                // claim: "M U"
                                let nct:i32=z_toks(claim,car,128);
                                let q:i32=0;
                                while(q+1<nct && rc==0){
                                    let qo:i32=a_get(car,2*q);
                                    let ql:i32=a_get(car,2*q+1);
                                    let l3:i32=lower_copy(claim[qo..qo+ql],tmp);
                                    let Mv:i64=r6_numtok(tmp[0..l3]);
                                    if(Mv>=0){
                                        let ro:i32=a_get(car,2*(q+1));
                                        let rl:i32=a_get(car,2*(q+1)+1);
                                        let l4:i32=lower_copy(claim[ro..ro+rl],tmp);
                                        let wl:i32=r6_stem_of(tmp[0..l4],sb);
                                        if(wl==usl && z_eq(sb[0..wl],us[0..usl])==1){
                                            if(Mv*100==P*N){rc=1;}
                                        }
                                    }
                                    q=q+1;
                                }
                            }
                        }
                    }
                }
                m=m+1;
            }
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(us);
    return rc;
}

// N3: percent complement. "P percent ... and the rest were ..." with
// claim "Q percent ..." (Q==100-P, shared noun).
fn r7_num_pctcomp(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let lc:[]u8=z_alloc(tx.len+1);
            if(lc.len>0){
                let ll:i32=lower_copy(tx,lc);
                let low:[]u8=lc[0..ll];
                if(z_has(low,"the rest")==1){
                    let net:i32=z_toks(tx,car,128);
                    let P:i64=-1;
                    let m:i32=0;
                    while(m<net && P<0){
                        let mo:i32=a_get(car,2*m);
                        let ml:i32=a_get(car,2*m+1);
                        let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                        if(z_eq(tmp[0..l2],"percent")==1 && m>=1){
                            let p0:i32=a_get(car,2*(m-1));
                            let p1:i32=a_get(car,2*(m-1)+1);
                            let lp:i32=lower_copy(tx[p0..p0+p1],tmp);
                            P=r6_numtok(tmp[0..lp]);
                        }
                        m=m+1;
                    }
                    if(P>=0){
                        // claim: "Q percent", Q==100-P, shared noun
                        let nct:i32=z_toks(claim,car,128);
                        let q:i32=0;
                        while(q<nct && rc==0){
                            let qo:i32=a_get(car,2*q);
                            let ql:i32=a_get(car,2*q+1);
                            let l2:i32=lower_copy(claim[qo..qo+ql],tmp);
                            if(z_eq(tmp[0..l2],"percent")==1 && q>=1){
                                let r0:i32=a_get(car,2*(q-1));
                                let r1:i32=a_get(car,2*(q-1)+1);
                                let lr:i32=lower_copy(claim[r0..r0+r1],tmp);
                                let Q:i64=r6_numtok(tmp[0..lr]);
                                if(Q==100-P){
                                    // shared content noun: claim's first
                                    // content stem occurs in evidence
                                    let s2:i32=0;
                                    while(s2<nct && rc==0){
                                        let so:i32=a_get(car,2*s2);
                                        let sl:i32=a_get(car,2*s2+1);
                                        let l3:i32=lower_copy(claim[so..so+sl],tmp);
                                        if(l3>0 && in_list(tmp[0..l3],lex_stop())==0){
                                            if(r6_stem_has(tx,tmp[0..l3])==1){rc=1;}
                                            break;
                                        }
                                        s2=s2+1;
                                    }
                                }
                            }
                            q=q+1;
                        }
                    }
                }
            }
            z_free(lc);
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    return rc;
}

// N3b: rate complement with negation flip. "P percent X" with claim
// "Q percent ... not V ..." (Q==100-P, V's root matches X's root).
fn r7_num_ratecomp(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let xs:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && xs.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            let m:i32=0;
            while(m<net && rc==0){
                let mo:i32=a_get(car,2*m);
                let ml:i32=a_get(car,2*m+1);
                let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                if(z_eq(tmp[0..l2],"percent")==1 && m>=1 && m+1<net){
                    let p0:i32=a_get(car,2*(m-1));
                    let p1:i32=a_get(car,2*(m-1)+1);
                    let lp:i32=lower_copy(tx[p0..p0+p1],tmp);
                    let P:i64=r6_numtok(tmp[0..lp]);
                    if(P>=0){
                        // X: first content word after "percent"
                        let xsl:i32=0;
                        let g:i32=m+1;
                        while(g<net && xsl==0){
                            let go:i32=a_get(car,2*g);
                            let gl:i32=a_get(car,2*g+1);
                            let l3:i32=lower_copy(tx[go..go+gl],tmp);
                            if(l3>0 && in_list(tmp[0..l3],lex_stop())==0){
                                xsl=r6_stem_of(tmp[0..l3],xs);
                            }
                            g=g+1;
                        }
                        if(xsl>=6){
                            // claim: "Q percent" + neg + verb with
                            // 6-char root match to X
                            let nct:i32=z_toks(claim,car,128);
                            let q:i32=0;
                            while(q<nct && rc==0){
                                let qo:i32=a_get(car,2*q);
                                let ql:i32=a_get(car,2*q+1);
                                let l3:i32=lower_copy(claim[qo..qo+ql],tmp);
                                if(z_eq(tmp[0..l3],"percent")==1 && q>=1){
                                    let r0:i32=a_get(car,2*(q-1));
                                    let r1:i32=a_get(car,2*(q-1)+1);
                                    let lr:i32=lower_copy(claim[r0..r0+r1],tmp);
                                    let Q:i64=r6_numtok(tmp[0..lr]);
                                    if(Q==100-P){
                                        // find a negated verb in claim
                                        // with matching root
                                        let q2:i32=0;
                                        while(q2<nct && rc==0){
                                            let so:i32=a_get(car,2*q2);
                                            let sl:i32=a_get(car,2*q2+1);
                                            let l4:i32=lower_copy(claim[so..so+sl],tmp);
                                            if(is_negword(tmp[0..l4])==1 && q2+1<nct){
                                                let vo:i32=a_get(car,2*(q2+1));
                                                let vl:i32=a_get(car,2*(q2+1)+1);
                                                let l5:i32=lower_copy(claim[vo..vo+vl],tmp);
                                                let wl:i32=r6_stem_of(tmp[0..l5],sb);
                                                if(wl>=6 && xsl>=6 && z_eq(sb[0..6],xs[0..6])==1){rc=1;}
                                            }
                                            q2=q2+1;
                                        }
                                    }
                                }
                                q=q+1;
                            }
                        }
                    }
                }
                m=m+1;
            }
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(xs);
    return rc;
}

// N4: fraction-of-million. "a quarter of a million" -> 250000;
// "half a million"/"half of a million" -> 500000.
fn r7_num_fracmil(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let rc:i32=0;
    let t2:i32=0;
    while(t2<2 && rc==0){
        let tx:[]u8=title;
        if(t2==1){tx=snip;}
        let lc:[]u8=z_alloc(tx.len+1);
        if(lc.len>0){
            let ll:i32=lower_copy(tx,lc);
            let low:[]u8=lc[0..ll];
            let V:i64=0;
            if(z_has(low,"quarter of a million")==1){V=250000;}
            if(z_has(low,"half of a million")==1){V=500000;}
            if(z_has(low,"half a million")==1){V=500000;}
            if(V>0){
                // claim: digit run (commas ignored) == V
                let i:i32=0;
                while(i<claim.len && rc==0){
                    let b:i32=claim[i] as i32;
                    if(b>=48 && b<=57){
                        let D:i64=r7_parse_digits(claim[i..claim.len]);
                        if(D==V){rc=1;}
                        while(i<claim.len){
                            let b2:i32=claim[i] as i32;
                            if((b2<48 || b2>57) && b2!=44){break;}
                            i=i+1;
                        }
                    }else{i=i+1;}
                }
            }
        }
        z_free(lc);
        t2=t2+1;
    }
    return rc;
}

// N5: halving. "cut/reduced/fell/dropped ... by 50 percent|half|in half"
// entails "halved".
fn r7_num_halved(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && ss.len>0){
        // claim has "halv*" and a subject
        let nct:i32=z_toks(claim,car,128);
        let halv:i32=0;
        let j:i32=0;
        while(j<nct){
            let jo:i32=a_get(car,2*j);
            let jl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[jo..jo+jl],tmp);
            let wl:i32=r6_stem_of(tmp[0..ll],sb);
            if(wl>0 && z_eq(sb[0..wl],"halv")==1){halv=1;break;}
            j=j+1;
        }
        if(halv==1){
            let ssl:i32=r6_first_content(claim,ss);
            if(ssl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    if(r6_stem_has(tx,ss[0..ssl])==1){
                        let lc:[]u8=z_alloc(tx.len+1);
                        if(lc.len>0){
                            let ll2:i32=lower_copy(tx,lc);
                            let low:[]u8=lc[0..ll2];
                            // reduction verb must scope the "by 50
                            // percent|half" phrase
                            let red:i32=0;
                            if(z_has(low,"cut")==1||z_has(low,"reduced")==1){red=1;}
                            if(z_has(low,"fell")==1||z_has(low,"dropped")==1){red=1;}
                            if(z_has(low,"decreased")==1||z_has(low,"shrank")==1){red=1;}
                            if(z_has(low,"declined")==1){red=1;}
                            if(red==1){
                                if(z_has(low,"by 50 percent")==1||z_has(low,"by half")==1){rc=1;}
                                if(z_has(low,"in half")==1||z_has(low,"by 50%")==1){rc=1;}
                            }
                        }
                        z_free(lc);
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(ss);
    return rc;
}

// N6: date offset. "<Month> <D>, runs/lasts <N> days" entails "ends on
// <Month> <D+N>" (same-month and next-month rollover).
fn r7_num_dateoff(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let net:i32=z_toks(tx,car,128);
            let m:i32=0;
            while(m<net && rc==0){
                let mo:i32=a_get(car,2*m);
                let ml:i32=a_get(car,2*m+1);
                let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                let mi:i32=r7_monthidx(tmp[0..l2]);
                if(mi>0 && m+1<net){
                    let d0:i32=a_get(car,2*(m+1));
                    let d1:i32=a_get(car,2*(m+1)+1);
                    let ld:i32=lower_copy(tx[d0..d0+d1],tmp);
                    let D:i64=r6_numtok(tmp[0..ld]);
                    if(D>0){
                        // N: number before "days" later in the text
                        let N:i64=-1;
                        let g:i32=m+2;
                        while(g<net && N<0){
                            let go:i32=a_get(car,2*g);
                            let gl:i32=a_get(car,2*g+1);
                            let l3:i32=lower_copy(tx[go..go+gl],tmp);
                            if((z_eq(tmp[0..l3],"days")==1||z_eq(tmp[0..l3],"day")==1) && g>=1){
                                let ho:i32=a_get(car,2*(g-1));
                                let hl:i32=a_get(car,2*(g-1)+1);
                                let l4:i32=lower_copy(tx[ho..ho+hl],tmp);
                                N=r6_numtok(tmp[0..l4]);
                            }
                            g=g+1;
                        }
                        if(N>0){
                            let mlen2:i32=0;
                            if(mi==1||mi==3||mi==5||mi==7||mi==8||mi==10||mi==12){mlen2=31;}
                            if(mi==4||mi==6||mi==9||mi==11){mlen2=30;}
                            if(mi==2){mlen2=28;}
                            let endD:i64=D+N;
                            let endM:i32=mi;
                            let ml64:i64=mlen2 as i64;
                            if(endD>ml64){endD=endD-ml64;endM=mi+1;if(endM>12){endM=1;}}
                            // claim: "end*" + month + day
                            let lc:[]u8=z_alloc(claim.len+1);
                            if(lc.len>0){
                                let ll2:i32=lower_copy(claim,lc);
                                let low:[]u8=lc[0..ll2];
                                if(z_has(low,"end")==1){
                                    let nct:i32=z_toks(claim,car,128);
                                    let q:i32=0;
                                    while(q<nct && rc==0){
                                        let qo:i32=a_get(car,2*q);
                                        let ql:i32=a_get(car,2*q+1);
                                        let l3:i32=lower_copy(claim[qo..qo+ql],tmp);
                                        if(r7_monthidx(tmp[0..l3])==endM && q+1<nct){
                                            let ro:i32=a_get(car,2*(q+1));
                                            let rl:i32=a_get(car,2*(q+1)+1);
                                            let l4:i32=lower_copy(claim[ro..ro+rl],tmp);
                                            if(r6_numtok(tmp[0..l4])==endD){rc=1;}
                                        }
                                        q=q+1;
                                    }
                                }
                            }
                            z_free(lc);
                        }
                    }
                }
                m=m+1;
            }
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    return rc;
}

// N7: week-later. "arrived on <W> ... a week later" entails "left the
// following <W>".
fn r7_num_weeklater(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let lc:[]u8=z_alloc(tx.len+1);
            if(lc.len>0){
                let ll:i32=lower_copy(tx,lc);
                let low:[]u8=lc[0..ll];
                let wl:i32=0;
                if(z_has(low,"a week later")==1||z_has(low,"one week later")==1){wl=1;}
                if(z_has(low,"7 days later")==1||z_has(low,"seven days later")==1){wl=1;}
                if(wl==1){
                    let net:i32=z_toks(tx,car,128);
                    let W:i32=0;
                    let m:i32=0;
                    while(m<net && W==0){
                        let mo:i32=a_get(car,2*m);
                        let ml:i32=a_get(car,2*m+1);
                        let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                        W=r7_weekday(tmp[0..l2]);
                        m=m+1;
                    }
                    if(W>0){
                        // claim: "following|next" + same weekday
                        let nct:i32=z_toks(claim,car,128);
                        let q:i32=0;
                        while(q+1<nct && rc==0){
                            let qo:i32=a_get(car,2*q);
                            let ql:i32=a_get(car,2*q+1);
                            let l2:i32=lower_copy(claim[qo..qo+ql],tmp);
                            if(z_eq(tmp[0..l2],"following")==1||z_eq(tmp[0..l2],"next")==1){
                                let ro:i32=a_get(car,2*(q+1));
                                let rl:i32=a_get(car,2*(q+1)+1);
                                let l3:i32=lower_copy(claim[ro..ro+rl],tmp);
                                if(r7_weekday(tmp[0..l3])==W){rc=1;}
                            }
                            q=q+1;
                        }
                    }
                }
            }
            z_free(lc);
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    return rc;
}

// N8: first-exclusion. "The first X V-ed at/on T" entails "No X V-ed
// before T".
fn r7_num_firstexcl(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let tmp2:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let xs:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && tmp2.len>0 && sb.len>0 && xs.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let lc:[]u8=z_alloc(tx.len+1);
            if(lc.len>0){
                let ll:i32=lower_copy(tx,lc);
                let low:[]u8=lc[0..ll];
                if(z_has(low,"the first")==1){
                    let net:i32=z_toks(tx,car,128);
                    // X: first content word after "first"; T: token after
                    // "at"/"on"
                    let fi:i32=-1;
                    let m:i32=0;
                    while(m+1<net && fi<0){
                        let mo:i32=a_get(car,2*m);
                        let ml:i32=a_get(car,2*m+1);
                        let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                        let po:i32=a_get(car,2*(m+1));
                        let pl:i32=a_get(car,2*(m+1)+1);
                        let l3:i32=lower_copy(tx[po..po+pl],tmp2);
                        if(z_eq(tmp[0..l2],"the")==1 && z_eq(tmp2[0..l3],"first")==1){fi=m+1;}
                        m=m+1;
                    }
                    if(fi>=0){
                        let xsl:i32=0;
                        let g:i32=fi+1;
                        while(g<net && xsl==0){
                            let go:i32=a_get(car,2*g);
                            let gl:i32=a_get(car,2*g+1);
                            let l3:i32=lower_copy(tx[go..go+gl],tmp);
                            if(l3>0 && in_list(tmp[0..l3],lex_stop())==0){
                                xsl=r6_stem_of(tmp[0..l3],xs);
                            }
                            g=g+1;
                        }
                        // T: word after "at"/"on"
                        // r7c: 32->128 (pre-existing crash on tokens >=33 chars).
                        let ts:[]u8=z_alloc(128);
                        let tsl:i32=0;
                        if(ts.len>0){
                            let g2:i32=0;
                            while(g2+1<net && tsl==0){
                                let go:i32=a_get(car,2*g2);
                                let gl:i32=a_get(car,2*g2+1);
                                let l3:i32=lower_copy(tx[go..go+gl],tmp);
                                if((z_eq(tmp[0..l3],"at")==1||z_eq(tmp[0..l3],"on")==1) && g2+1<net){
                                    let ho:i32=a_get(car,2*(g2+1));
                                    let hl:i32=a_get(car,2*(g2+1)+1);
                                    tsl=lower_copy(tx[ho..ho+hl],ts);
                                }
                                g2=g2+1;
                            }
                        }
                        if(xsl>0 && tsl>0){
                            // claim: "no|not a single|none" + X ... +
                            // "before" + T
                            let nct:i32=z_toks(claim,car,128);
                            let hasno:i32=0;
                            let hasx:i32=0;
                            let hasbef:i32=0;
                            let q:i32=0;
                            while(q<nct){
                                let qo:i32=a_get(car,2*q);
                                let ql:i32=a_get(car,2*q+1);
                                let l3:i32=lower_copy(claim[qo..qo+ql],tmp);
                                if(z_eq(tmp[0..l3],"no")==1||z_eq(tmp[0..l3],"none")==1||z_eq(tmp[0..l3],"never")==1){hasno=1;}
                                let wl:i32=r6_stem_of(tmp[0..l3],sb);
                                if(wl==xsl && z_eq(sb[0..wl],xs[0..xsl])==1){hasx=1;}
                                if(z_eq(tmp[0..l3],"before")==1 && q+1<nct){
                                    let ro:i32=a_get(car,2*(q+1));
                                    let rl:i32=a_get(car,2*(q+1)+1);
                                    let l4:i32=lower_copy(claim[ro..ro+rl],tmp);
                                    if(l4==tsl && z_eq(tmp[0..l4],ts[0..tsl])==1){hasbef=1;}
                                }
                                q=q+1;
                            }
                            if(hasno==1 && hasx==1 && hasbef==1){rc=1;}
                        }
                        z_free(ts);
                    }
                }
            }
            z_free(lc);
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(tmp2);
    z_free(sb);
    z_free(xs);
    return rc;
}

// N9: died -> dead. "S died" entails "S is dead".
fn r7_num_died(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let ss:[]u8=z_alloc(32);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && ss.len>0){
        let nct:i32=z_toks(claim,car,128);
        // claim has "dead" + subject S
        let hd:i32=0;
        let j:i32=0;
        while(j<nct){
            let jo:i32=a_get(car,2*j);
            let jl:i32=a_get(car,2*j+1);
            let ll:i32=lower_copy(claim[jo..jo+jl],tmp);
            if(z_eq(tmp[0..ll],"dead")==1){hd=1;break;}
            j=j+1;
        }
        if(hd==1){
            let ssl:i32=r6_first_content(claim,ss);
            if(ssl>0){
                let t2:i32=0;
                while(t2<2 && rc==0){
                    let tx:[]u8=title;
                    if(t2==1){tx=snip;}
                    if(r6_stem_has(tx,ss[0..ssl])==1){
                        let net:i32=z_toks(tx,car,128);
                        let m:i32=0;
                        while(m<net && rc==0){
                            let mo:i32=a_get(car,2*m);
                            let ml:i32=a_get(car,2*m+1);
                            let l2:i32=lower_copy(tx[mo..mo+ml],tmp);
                            // raw token match (stemmer may not produce
                            // "die"; also accept stemmed forms)
                            if(z_eq(tmp[0..l2],"died")==1||z_eq(tmp[0..l2],"die")==1||z_eq(tmp[0..l2],"dies")==1){rc=1;}
                            else{
                                let wl:i32=r6_stem_of(tmp[0..l2],sb);
                                if(wl>0 && (z_eq(sb[0..wl],"die")==1||z_eq(sb[0..wl],"died")==1)){rc=1;}
                            }
                            m=m+1;
                        }
                    }
                    t2=t2+1;
                }
            }
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(ss);
    return rc;
}

// N10: word-number vs digits. "fifty thousand dollars" entails
// "50,000 dollars" (same unit).
fn r7_num_worddigit(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let car:[]u8=z_alloc(1024);
    let tmp:[]u8=z_alloc(64);
    let sb:[]u8=z_alloc(32);
    let us:[]u8=z_alloc(32);
    let epos:[]u8=z_alloc(8);
    let rc:i32=0;
    if(car.len>0 && tmp.len>0 && sb.len>0 && us.len>0 && epos.len>0){
        let t2:i32=0;
        while(t2<2 && rc==0){
            let tx:[]u8=title;
            if(t2==1){tx=snip;}
            let lc:[]u8=z_alloc(tx.len+1);
            if(lc.len>0){
                let ll:i32=lower_copy(tx,lc);
                let low:[]u8=lc[0..ll];
                // find a number-word compound; unit = first content word
                // after it
                let p:i32=0;
                while(p<ll && rc==0){
                    let b:i32=low[p] as i32;
                    if(b>=97 && b<=122){
                        let V:i64=wnum_seq(low,p,ll,epos);
                        let qe:i32=a_get(epos,0);
                        if(V>0 && qe>p){
                            // unit: next word run after qe
                            let r:i32=qe;
                            while(r<ll && (low[r] as i32)==32){r=r+1;}
                            let r2:i32=r;
                            while(r2<ll && (low[r2] as i32)>=97 && (low[r2] as i32)<=122){r2=r2+1;}
                            if(r2>r){
                                let usl:i32=r6_stem_of(low[r..r2],us);
                                if(usl>0){
                                    // claim: digit number D == V with
                                    // same unit
                                    let i:i32=0;
                                    while(i<claim.len && rc==0){
                                        let cb:i32=claim[i] as i32;
                                        if(cb>=48 && cb<=57){
                                            let D:i64=r7_parse_digits(claim[i..claim.len]);
                                            if(D==V){
                                                // unit after the digits
                                                let e:i32=i;
                                                while(e<claim.len){
                                                    let b2:i32=claim[e] as i32;
                                                    if((b2<48 || b2>57) && b2!=44){break;}
                                                    e=e+1;
                                                }
                                                let net:i32=z_toks(claim[e..claim.len],car,128);
                                                if(net>=1){
                                                    let uo:i32=a_get(car,0);
                                                    let ul:i32=a_get(car,1);
                                                    let rest:[]u8=claim[e..claim.len];
                                                    let lu:i32=lower_copy(rest[uo..uo+ul],tmp);
                                                    let wl:i32=r6_stem_of(tmp[0..lu],sb);
                                                    if(wl==usl && z_eq(sb[0..wl],us[0..usl])==1){rc=1;}
                                                }
                                            }
                                            while(i<claim.len){
                                                let b2:i32=claim[i] as i32;
                                                if((b2<48 || b2>57) && b2!=44){break;}
                                                i=i+1;
                                            }
                                        }else{i=i+1;}
                                    }
                                }
                            }
                            p=qe;
                        }else{p=p+1;}
                    }else{p=p+1;}
                }
            }
            z_free(lc);
            t2=t2+1;
        }
    }
    z_free(car);
    z_free(tmp);
    z_free(sb);
    z_free(us);
    z_free(epos);
    return rc;
}

// Numeric dispatcher: any sub-check firing affirms.
fn r7_numeric(claim:[]u8,title:[]u8,snip:[]u8)i32{
    if(r7_num_mult(claim,title,snip)==1){return 1;}
    if(r7_num_pctof(claim,title,snip)==1){return 1;}
    if(r7_num_pctcomp(claim,title,snip)==1){return 1;}
    if(r7_num_ratecomp(claim,title,snip)==1){return 1;}
    if(r7_num_fracmil(claim,title,snip)==1){return 1;}
    if(r7_num_halved(claim,title,snip)==1){return 1;}
    if(r7_num_dateoff(claim,title,snip)==1){return 1;}
    if(r7_num_weeklater(claim,title,snip)==1){return 1;}
    if(r7_num_firstexcl(claim,title,snip)==1){return 1;}
    if(r7_num_died(claim,title,snip)==1){return 1;}
    if(r7_num_worddigit(claim,title,snip)==1){return 1;}
    return 0;
}
// ==================== r7c guards (round 7c) ====================
// A20: equivocation guard. Suppresses AFFIRM when a content word occurs in
// the evidence in two phrases with DISTINCT adjacent content premodifiers
// ("river bank" vs "central bank") and the claim overlaps the exclusive
// territory (content tokens, excluding pivot occurrences and their
// premodifiers) of BOTH occurrences. Each evidence token is attributed to
// its nearest pivot occurrence (distance ties go to neither), so a claim
// fully grounded near a single occurrence cannot trigger.
// A45: pronoun-ambiguity guard. Suppresses AFFIRM when the evidence has a
// third-person pronoun with 2+ candidate proper-name antecedents
// (capitalized content words), the claim contains exactly one candidate,
// and the claim overlaps the pronoun-governed predicate (content stems
// after the pronoun).
// Both guards are suppress-affirm only: they never create DENY/AFFIRM,
// only withhold an affirm the pipeline would otherwise install.
// r7c helper: 1 if w is a content word (all-alpha, len>=3, not stopword).
fn r7c_content(w:[]u8)i32{
    if(w.len<3){return 0;}
    let i:i32=0;
    while(i<w.len){
        let b:i32=w[i] as i32;
        let ok:i32=0;
        if(b>=65 && b<=90){ok=1;}
        if(b>=97 && b<=122){ok=1;}
        if(ok==0){return 0;}
        i=i+1;
    }
    if(in_list(w,lex_stop())==1){return 0;}
    return 1;
}
// r7c helper: 1 if w (lowered) is a third-person pronoun.
fn r7c_is_pro(w:[]u8)i32{
    if(z_eq(w,"he")==1){return 1;}
    if(z_eq(w,"she")==1){return 1;}
    if(z_eq(w,"him")==1){return 1;}
    if(z_eq(w,"her")==1){return 1;}
    if(z_eq(w,"his")==1){return 1;}
    if(z_eq(w,"they")==1){return 1;}
    if(z_eq(w,"them")==1){return 1;}
    if(z_eq(w,"their")==1){return 1;}
    if(z_eq(w,"it")==1){return 1;}
    if(z_eq(w,"its")==1){return 1;}
    return 0;
}
// r7c helper: nearest pivot-occurrence index for evidence token q among
// OCC (m entries); -1 on a distance tie.
fn r7c_nearest(q:i32,occ:[]u8,m:i32)i32{
    let best:i32=-1;
    let bd:i32=1000000;
    let tie:i32=0;
    let j:i32=0;
    while(j<m){
        let o:i32=a_get(occ,j);
        let d:i32=q-o;
        if(d<0){d=0-d;}
        if(d<bd){bd=d;best=j;tie=0;}
        else{
            if(d==bd){tie=1;}
        }
        j=j+1;
    }
    if(tie==1){return -1;}
    return best;
}
// r7c (A20): equivocation suppress-affirm. See header comment.
fn r7c_equiv_one(claim:[]u8,ev:[]u8)i32{
    let EB:[]u8=z_alloc(8192);
    let TA:[]u8=z_alloc(4096);
    let CA:[]u8=z_alloc(1024);
    let WBUF:[]u8=z_alloc(8192);
    let WI:[]u8=z_alloc(4096);
    let SBUF:[]u8=z_alloc(8192);
    let EI:[]u8=z_alloc(4096);
    let CFLG:[]u8=z_alloc(2048);
    let MCL:[]u8=z_alloc(2048);
    let SB:[]u8=z_alloc(2048);
    let SI:[]u8=z_alloc(1024);
    let TMP:[]u8=z_alloc(64);
    let STM:[]u8=z_alloc(32);
    let OCC:[]u8=z_alloc(256);
    let HIT:[]u8=z_alloc(256);
    let PRE:[]u8=z_alloc(512);
    let PHAS:[]u8=z_alloc(256);
    let OCCF:[]u8=z_alloc(2048);
    let rc:i32=0;
    if(EB.len>0 && TA.len>0 && CA.len>0 && WBUF.len>0 && WI.len>0 && SBUF.len>0 && EI.len>0 && CFLG.len>0 && MCL.len>0 && SB.len>0 && SI.len>0 && TMP.len>0 && STM.len>0 && OCC.len>0 && HIT.len>0 && PRE.len>0 && PHAS.len>0 && OCCF.len>0){
        let el:i32=ev.len;
        if(el>8191){el=8191;}
        let i:i32=0;
        while(i<el){EB[i]=ev[i];i=i+1;}
        let evs:[]u8=EB[0..el];
        let n:i32=z_toks(evs,TA,512);
        // phase 1: per-token lowered word + stem + content flag
        let woff:i32=0;
        let soff:i32=0;
        let q:i32=0;
        while(q<n){
            let qto:i32=a_get(TA,2*q);
            let qtl:i32=a_get(TA,2*q+1);
            let ll:i32=lower_copy(evs[qto..qto+qtl],TMP);
            a_put(CFLG,q,0);
            if(ll>0 && ll<64 && r7c_content(TMP[0..ll])==1 && woff+ll<8192){
                let qq:i32=0;
                while(qq<ll){WBUF[woff+qq]=TMP[qq];qq=qq+1;}
                a_put(WI,2*q,woff);
                a_put(WI,2*q+1,ll);
                woff=woff+ll;
                let sl:i32=r6_stem_of(TMP[0..ll],STM);
                if(sl>0 && soff+sl<8192){
                    let rr:i32=0;
                    while(rr<sl){SBUF[soff+rr]=STM[rr];rr=rr+1;}
                    a_put(EI,2*q,soff);
                    a_put(EI,2*q+1,sl);
                    soff=soff+sl;
                    a_put(CFLG,q,1);
                }
            }
            q=q+1;
        }
        // phase 2: claim content stems
        let nc:i32=z_toks(claim,CA,128);
        let ns:i32=0;
        let coff:i32=0;
        let c:i32=0;
        while(c<nc){
            let cto:i32=a_get(CA,2*c);
            let ctl:i32=a_get(CA,2*c+1);
            let ll:i32=lower_copy(claim[cto..cto+ctl],TMP);
            if(ll>0 && r7c_content(TMP[0..ll])==1){
                let sl:i32=r6_stem_of(TMP[0..ll],STM);
                if(sl>0 && ns<128 && coff+sl<2048){
                    let qq:i32=0;
                    while(qq<sl){SB[coff+qq]=STM[qq];qq=qq+1;}
                    a_put(SI,2*ns,coff);
                    a_put(SI,2*ns+1,sl);
                    coff=coff+sl;
                    ns=ns+1;
                }
            }
            c=c+1;
        }
        // phase 3: matches_claim per evidence token (stem overlap)
        q=0;
        while(q<n){
            a_put(MCL,q,0);
            if(a_get(CFLG,q)==1){
                let eo:i32=a_get(EI,2*q);
                let eln:i32=a_get(EI,2*q+1);
                let s:i32=0;
                while(s<ns){
                    let so:i32=a_get(SI,2*s);
                    let sln:i32=a_get(SI,2*s+1);
                    if(eln==sln && z_eq(SBUF[eo..eo+eln],SB[so..so+sln])==1){
                        a_put(MCL,q,1);
                        break;
                    }
                    s=s+1;
                }
            }
            q=q+1;
        }
        // phase 4: pivot loop
        let p:i32=0;
        while(p<n && rc==0){
            if(a_get(CFLG,p)==1){
                let pwo:i32=a_get(WI,2*p);
                let pwl:i32=a_get(WI,2*p+1);
                let m:i32=0;
                q=0;
                while(q<n && m<64){
                    if(a_get(CFLG,q)==1){
                        let qo:i32=a_get(WI,2*q);
                        let ql:i32=a_get(WI,2*q+1);
                        if(ql==pwl && z_eq(WBUF[qo..qo+ql],WBUF[pwo..pwo+pwl])==1){
                            a_put(OCC,m,q);
                            m=m+1;
                        }
                    }
                    q=q+1;
                }
                if(m>=2){
                    // adjacent premodifier stems
                    let u:i32=0;
                    while(u<m){
                        a_put(PHAS,u,0);
                        let o:i32=a_get(OCC,u);
                        if(o>0 && a_get(CFLG,o-1)==1){
                            let po:i32=a_get(EI,2*(o-1));
                            let pl:i32=a_get(EI,2*(o-1)+1);
                            a_put(PRE,2*u,po);
                            a_put(PRE,2*u+1,pl);
                            a_put(PHAS,u,1);
                        }
                        u=u+1;
                    }
                    // distinct premodifier pair?
                    let dp:i32=0;
                    let u1:i32=0;
                    while(u1<m && dp==0){
                        let u2:i32=u1+1;
                        while(u2<m && dp==0){
                            if(a_get(PHAS,u1)==1 && a_get(PHAS,u2)==1){
                                let a1o:i32=a_get(PRE,2*u1);
                                let a1l:i32=a_get(PRE,2*u1+1);
                                let a2o:i32=a_get(PRE,2*u2);
                                let a2l:i32=a_get(PRE,2*u2+1);
                                if(a1l!=a2l || z_eq(SBUF[a1o..a1o+a1l],SBUF[a2o..a2o+a2l])==0){
                                    dp=1;
                                }
                            }
                            u2=u2+1;
                        }
                        u1=u1+1;
                    }
                    if(dp==1){
                        // exclude pivot occurrences + premodifiers
                        q=0;
                        while(q<n){a_put(OCCF,q,0);q=q+1;}
                        u=0;
                        while(u<m){
                            let o:i32=a_get(OCC,u);
                            a_put(OCCF,o,1);
                            if(a_get(PHAS,u)==1 && o>0){a_put(OCCF,o-1,1);}
                            u=u+1;
                        }
                        // territory hits via nearest occurrence
                        u=0;
                        while(u<m){a_put(HIT,u,0);u=u+1;}
                        q=0;
                        while(q<n){
                            if(a_get(CFLG,q)==1 && a_get(MCL,q)==1 && a_get(OCCF,q)==0){
                                let j:i32=r7c_nearest(q,OCC,m);
                                if(j>=0){a_put(HIT,j,1);}
                            }
                            q=q+1;
                        }
                        let h1:i32=0;
                        u=0;
                        while(u<m){
                            if(a_get(HIT,u)==1){h1=h1+1;}
                            u=u+1;
                        }
                        // r7c: if the claim contains a premodifier stem, it
                        // disambiguates which occurrence is meant (B35: claim
                        // has "box", the premodifier of one "holds") -> not
                        // equivocation, do not suppress.
                        let disamb:i32=0;
                        let u3:i32=0;
                        while(u3<m && disamb==0){
                            if(a_get(PHAS,u3)==1){
                                let ppo:i32=a_get(PRE,2*u3);
                                let ppl:i32=a_get(PRE,2*u3+1);
                                let s:i32=0;
                                while(s<ns && disamb==0){
                                    let so:i32=a_get(SI,2*s);
                                    let sln:i32=a_get(SI,2*s+1);
                                    if(ppl==sln && z_eq(SBUF[ppo..ppo+ppl],SB[so..so+sln])==1){disamb=1;}
                                    s=s+1;
                                }
                            }
                            u3=u3+1;
                        }
                        if(h1>=2 && disamb==0){rc=1;}
                    }
                }
            }
            p=p+1;
        }
    }
    z_free(EB);
    z_free(TA);
    z_free(CA);
    z_free(WBUF);
    z_free(WI);
    z_free(SBUF);
    z_free(EI);
    z_free(CFLG);
    z_free(MCL);
    z_free(SB);
    z_free(SI);
    z_free(TMP);
    z_free(STM);
    z_free(OCC);
    z_free(HIT);
    z_free(PRE);
    z_free(PHAS);
    z_free(OCCF);
    return rc;
}
// r7c (A45): pronoun-ambiguity suppress-affirm. See header comment.
fn r7c_pronoun_one(claim:[]u8,ev:[]u8)i32{
    let EB:[]u8=z_alloc(8192);
    let TA:[]u8=z_alloc(4096);
    let CA:[]u8=z_alloc(1024);
    let TMP:[]u8=z_alloc(64);
    let STM:[]u8=z_alloc(32);
    let CN:[]u8=z_alloc(512);
    let CNB:[]u8=z_alloc(2048);
    let CS:[]u8=z_alloc(256);
    let PB:[]u8=z_alloc(2048);
    let PI:[]u8=z_alloc(512);
    let SB:[]u8=z_alloc(2048);
    let SI:[]u8=z_alloc(1024);
    let rc:i32=0;
    if(EB.len>0 && TA.len>0 && CA.len>0 && TMP.len>0 && STM.len>0 && CN.len>0 && CNB.len>0 && CS.len>0 && PB.len>0 && PI.len>0 && SB.len>0 && SI.len>0){
        let el:i32=ev.len;
        if(el>8191){el=8191;}
        let i:i32=0;
        while(i<el){EB[i]=ev[i];i=i+1;}
        let evs:[]u8=EB[0..el];
        let n:i32=z_toks(evs,TA,512);
        // candidates: capitalized content words, deduped by lowered form.
        // r7c: exclude wh-words (Why/What/...) and words that also appear
        // lowercase (not proper names).
        let ncn:i32=0;
        let coff:i32=0;
        let q:i32=0;
        while(q<n && ncn<64){
            let qto:i32=a_get(TA,2*q);
            let qtl:i32=a_get(TA,2*q+1);
            let fb:i32=evs[qto] as i32;
            if(fb>=65 && fb<=90){
                let ll:i32=lower_copy(evs[qto..qto+qtl],TMP);
                if(ll>0 && r7c_content(TMP[0..ll])==1 && coff+ll<2048){
                    // wh-word exclusion
                    let iswh:i32=0;
                    if(z_eq(TMP[0..ll],"why")==1){iswh=1;}
                    if(z_eq(TMP[0..ll],"what")==1){iswh=1;}
                    if(z_eq(TMP[0..ll],"when")==1){iswh=1;}
                    if(z_eq(TMP[0..ll],"where")==1){iswh=1;}
                    if(z_eq(TMP[0..ll],"who")==1){iswh=1;}
                    if(z_eq(TMP[0..ll],"whom")==1){iswh=1;}
                    if(z_eq(TMP[0..ll],"whose")==1){iswh=1;}
                    if(z_eq(TMP[0..ll],"how")==1){iswh=1;}
                    if(z_eq(TMP[0..ll],"which")==1){iswh=1;}
                    if(iswh==0){
                        let dup:i32=0;
                        let d:i32=0;
                        while(d<ncn){
                            let do:i32=a_get(CN,2*d);
                            let dl:i32=a_get(CN,2*d+1);
                            if(dl==ll && z_eq(CNB[do..do+dl],TMP[0..ll])==1){dup=1;break;}
                            d=d+1;
                        }
                        if(dup==0){
                            let qq:i32=0;
                            while(qq<ll){CNB[coff+qq]=TMP[qq];qq=qq+1;}
                            a_put(CN,2*ncn,coff);
                            a_put(CN,2*ncn+1,ll);
                            coff=coff+ll;
                            ncn=ncn+1;
                        }
                    }
                }
            }
            q=q+1;
        }
        if(ncn>=2){
            // first third-person pronoun
            let pq:i32=-1;
            q=0;
            while(q<n && pq<0){
                let qto:i32=a_get(TA,2*q);
                let qtl:i32=a_get(TA,2*q+1);
                let ll:i32=lower_copy(evs[qto..qto+qtl],TMP);
                if(ll>0 && r7c_is_pro(TMP[0..ll])==1){pq=q;}
                q=q+1;
            }
            if(pq>=0){
                // pronoun predicate: content stems after pronoun
                let np:i32=0;
                let poff:i32=0;
                q=pq+1;
                while(q<n && np<64){
                    let qto:i32=a_get(TA,2*q);
                    let qtl:i32=a_get(TA,2*q+1);
                    let ll:i32=lower_copy(evs[qto..qto+qtl],TMP);
                    if(ll>0 && r7c_content(TMP[0..ll])==1){
                        let sl:i32=r6_stem_of(TMP[0..ll],STM);
                        if(sl>0 && poff+sl<2048){
                            let qq:i32=0;
                            while(qq<sl){PB[poff+qq]=STM[qq];qq=qq+1;}
                            a_put(PI,2*np,poff);
                            a_put(PI,2*np+1,sl);
                            poff=poff+sl;
                            np=np+1;
                        }
                    }
                    q=q+1;
                }
                if(np>0){
                    // claim content stems
                    let nc:i32=z_toks(claim,CA,128);
                    let ns:i32=0;
                    let soff:i32=0;
                    let c:i32=0;
                    while(c<nc){
                        let cto:i32=a_get(CA,2*c);
                        let ctl:i32=a_get(CA,2*c+1);
                        let ll:i32=lower_copy(claim[cto..cto+ctl],TMP);
                        if(ll>0 && r7c_content(TMP[0..ll])==1){
                            let sl:i32=r6_stem_of(TMP[0..ll],STM);
                            if(sl>0 && ns<128 && soff+sl<2048){
                                let qq:i32=0;
                                while(qq<sl){SB[soff+qq]=STM[qq];qq=qq+1;}
                                a_put(SI,2*ns,soff);
                                a_put(SI,2*ns+1,sl);
                                soff=soff+sl;
                                ns=ns+1;
                            }
                        }
                        c=c+1;
                    }
                    // candidates present in claim (lowered word match)
                    let nhit:i32=0;
                    let d:i32=0;
                    while(d<ncn){a_put(CS,d,0);d=d+1;}
                    c=0;
                    while(c<nc){
                        let cto:i32=a_get(CA,2*c);
                        let ctl:i32=a_get(CA,2*c+1);
                        let ll:i32=lower_copy(claim[cto..cto+ctl],TMP);
                        if(ll>0){
                            d=0;
                            while(d<ncn){
                                let do:i32=a_get(CN,2*d);
                                let dl:i32=a_get(CN,2*d+1);
                                if(dl==ll && z_eq(CNB[do..do+dl],TMP[0..ll])==1){
                                    if(a_get(CS,d)==0){
                                        a_put(CS,d,1);
                                        nhit=nhit+1;
                                    }
                                }
                                d=d+1;
                            }
                        }
                        c=c+1;
                    }
                    if(nhit==1){
                        // claim overlaps pronoun predicate?
                        let ov:i32=0;
                        let s:i32=0;
                        while(s<ns && ov==0){
                            let so:i32=a_get(SI,2*s);
                            let sln:i32=a_get(SI,2*s+1);
                            let pp:i32=0;
                            while(pp<np && ov==0){
                                let po:i32=a_get(PI,2*pp);
                                let pl:i32=a_get(PI,2*pp+1);
                                if(sln==pl && z_eq(SB[so..so+sln],PB[po..po+pl])==1){ov=1;}
                                pp=pp+1;
                            }
                            s=s+1;
                        }
                        if(ov==1){rc=1;}
                    }
                }
            }
        }
    }
    z_free(EB);
    z_free(TA);
    z_free(CA);
    z_free(TMP);
    z_free(STM);
    z_free(CN);
    z_free(CNB);
    z_free(CS);
    z_free(PB);
    z_free(PI);
    z_free(SB);
    z_free(SI);
    return rc;
}
// r7c: combined suppress-affirm gate for A20/A45. Returns 1 to suppress.
fn r7c_aff_supp(claim:[]u8,title:[]u8,snip:[]u8)i32{
    let EB:[]u8=z_alloc(8192);
    let rc:i32=0;
    if(EB.len>0){
        let tl:i32=title.len;
        let sl:i32=snip.len;
        if(tl>4095){tl=4095;}
        if(sl>4095){sl=4095;}
        let i:i32=0;
        while(i<tl){EB[i]=title[i];i=i+1;}
        EB[tl]=32;
        let k:i32=0;
        while(k<sl){EB[tl+1+k]=snip[k];k=k+1;}
        let ev:[]u8=EB[0..tl+1+sl];
        if(r7c_equiv_one(claim,ev)==1){rc=1;}
        else{
            if(r7c_pronoun_one(claim,ev)==1){rc=1;}
        }
    }
    z_free(EB);
    return rc;
}
fn r12_classify(claim:[]u8,title:[]u8,snip:[]u8,sc:[]u8)i32{
    let TOKA:[]u8=sc[0..1024];
    let STEMA:[]u8=sc[1024..9216];
    let WORDA:[]u8=sc[9216..11264];
    let CSTEMA:[]u8=sc[11264..12288];
    let TMPS:[]u8=sc[12288..12800];
    let OUTS:[]u8=sc[12800..13312];
    let VBS:[]u8=sc[13312..13440];
    let FULLB:[]u8=sc[13440..17536];
    let TOKB:[]u8=sc[17536..25728];
    let STEMB:[]u8=sc[25728..42112];
    let TSTMB:[]u8=sc[42112..50304];
    let CLAUA:[]u8=sc[50304..52352];
    let PROTB:[]u8=sc[52352..56448];
    let TOKC:[]u8=sc[56448..64640];
    let STEMC:[]u8=sc[64640..81024];
    let CSTMC:[]u8=sc[81024..89216];
    let LOWB:[]u8=sc[89216..93312];
    let CLVB:[]u8=sc[93312..97408];
    let NUMA:[]u8=sc[97408..97920];
    let AFFB:[]u8=sc[97920..97928];
    // V4-INTEG extras (B1/B3), all below B4's conditional area [100000,...).
    let CADJB:[]u8=sc[97928..97992];
    let SUBJA:[]u8=sc[97992..98056];
    let CVB:[]u8=sc[98056..98568];
    let SSTEMB:[]u8=sc[98568..99080];
    let SSTMC:[]u8=sc[99080..99976];
    // round-5: 24-byte buffer for the claim's comparative word (A29 veto)
    let COMPWB:[]u8=sc[99976..100000];
    // ---- claim: tokens + content words ----
    let nct:i32=z_toks(claim,TOKA,128);
    let nw:i32=0;
    let soff:i32=0;
    let i:i32=0;
    while(i<nct && nw<128){
        let to:i32=a_get(TOKA,2*i);
        let tl:i32=a_get(TOKA,2*i+1);
        let tok:[]u8=claim[to..to+tl];
        if(z_cplen(tok)>3){
            let ll:i32=lower_copy(tok,TMPS);
            if(in_list(TMPS[0..ll],lex_stop())==0){
                let sl:i32=z_stem(tok,OUTS,TMPS,VBS);
                let q:i32=0;
                while(q<sl){STEMA[soff+q]=OUTS[q];q=q+1;}
                a_put(WORDA,4*nw,to);
                a_put(WORDA,4*nw+1,tl);
                a_put(WORDA,4*nw+2,soff);
                a_put(WORDA,4*nw+3,sl);
                soff=soff+sl;
                nw=nw+1;
            }
        }
        i=i+1;
    }
    // claim stem set (deduped)
    let ncs:i32=0;
    i=0;
    while(i<nw){
        let so:i32=a_get(WORDA,4*i+2);
        let sl2:i32=a_get(WORDA,4*i+3);
        if(in_stems(STEMA[so..so+sl2],STEMA,CSTEMA,ncs)==0){
            a_put(CSTEMA,2*ncs,so);
            a_put(CSTEMA,2*ncs+1,sl2);
            ncs=ncs+1;
        }
        i=i+1;
    }
    // B3-CAU: short stems ("dam","fog") that the content-word filter drops.
    let nsst:i32=0;
    let ssoff:i32=0;
    i=0;
    while(i<nct){
        let ssto:i32=a_get(TOKA,2*i);
        let sstl:i32=a_get(TOKA,2*i+1);
        let ssll:i32=lower_copy(claim[ssto..ssto+sstl],TMPS);
        if(in_list(TMPS[0..ssll],lex_stop())==0 && ssll>0 && ssll<=4 && nsst<56){
            let sssl:i32=z_stem(claim[ssto..ssto+sstl],OUTS,TMPS,VBS);
            if(sssl>0 && sssl<=24){
                let ssq:i32=0;
                while(ssq<sssl){SSTEMB[ssoff+ssq]=OUTS[ssq];ssq=ssq+1;}
                a_put(SSTMC,2*nsst,ssoff);
                a_put(SSTMC,2*nsst+1,sssl);
                ssoff=ssoff+sssl;
                nsst=nsst+1;
            }
        }
        i=i+1;
    }
    // strip leading gerund ("Drinking coffee causes..." -> core without Drinking)
    let cs:i32=0;
    if(nw>0){
        let to0:i32=a_get(WORDA,0);
        let tl0:i32=a_get(WORDA,1);
        let t0:[]u8=claim[to0..to0+tl0];
        let ll0:i32=lower_copy(t0,TMPS);
        if(ew(TMPS,0,ll0,"ing")==1){
            let so0:i32=a_get(WORDA,2);
            let sl0:i32=a_get(WORDA,3);
            if(in_list(STEMA[so0..so0+sl0],lex_verb())==1){cs=1;}
        }
    }
    // anchors: first/last content-word stems of the core
    let firstA:[]u8="";
    let lastA:[]u8="";
    if(cs<nw){
        let so1:i32=a_get(WORDA,4*cs+2);
        let sl1:i32=a_get(WORDA,4*cs+3);
        firstA=STEMA[so1..so1+sl1];
        let so2:i32=a_get(WORDA,4*(nw-1)+2);
        let sl2b:i32=a_get(WORDA,4*(nw-1)+3);
        lastA=STEMA[so2..so2+sl2b];
    }
    // predicate: first verb-stem core token, skipping reporting verbs
    let pred:[]u8="";
    let pfound:i32=0;
    i=cs;
    while(i<nw){
        let to3:i32=a_get(WORDA,4*i);
        let tl3:i32=a_get(WORDA,4*i+1);
        let so3:i32=a_get(WORDA,4*i+2);
        let sl3:i32=a_get(WORDA,4*i+3);
        let s3:[]u8=STEMA[so3..so3+sl3];
        if(in_list(s3,lex_verb())==1){
            let ll3:i32=lower_copy(claim[to3..to3+tl3],TMPS);
            if(in_list(TMPS[0..ll3],lex_reporting())==0 && in_list(s3,lex_reporting())==0){
                pred=s3;
                pfound=1;
                break;
            }
        }
        i=i+1;
    }
    if(pfound==0){
        // B1-V4: fall back to a reporting verb rather than no predicate at
        // all ("None of the trials showed benefits" needs pred="show").
        let ri:i32=cs;
        while(ri<nw){
            let rso:i32=a_get(WORDA,4*ri+2);
            let rsl:i32=a_get(WORDA,4*ri+3);
            let rs3:[]u8=STEMA[rso..rso+rsl];
            if(in_list(rs3,lex_verb())==1){
                pred=rs3;
                pfound=1;
                break;
            }
            ri=ri+1;
        }
    }
    if(pfound==0){
        // fallback: first auxiliary/copula among ALL tokens
        let fi:i32=0;
        while(fi<nct){
            let to4:i32=a_get(TOKA,2*fi);
            let tl4:i32=a_get(TOKA,2*fi+1);
            let ll4:i32=lower_copy(claim[to4..to4+tl4],TMPS);
            let lw4:[]u8=TMPS[0..ll4];
            if(in_list(lw4,lex_be())==1){pred="be";break;}
            if(in_list(lw4,lex_have())==1){pred="have";break;}
            fi=fi+1;
        }
    }
    // B1-V4: claim copula-complement stem ("The drug is ineffective" ->
    // "ineffect"), for "not un-X" resolution and "no longer" polarity.
    let cadj:[]u8="";
    let bi:i32=0;
    while(bi<nct){
        let bto:i32=a_get(TOKA,2*bi);
        let btl:i32=a_get(TOKA,2*bi+1);
        let bll:i32=lower_copy(claim[bto..bto+btl],TMPS);
        if(in_list(TMPS[0..bll],lex_be())==1){
            let bk:i32=bi+1;
            while(bk<nct){
                let kto:i32=a_get(TOKA,2*bk);
                let ktl:i32=a_get(TOKA,2*bk+1);
                if(z_cplen(claim[kto..kto+ktl])>3){
                    let kll:i32=lower_copy(claim[kto..kto+ktl],TMPS);
                    if(in_list(TMPS[0..kll],lex_stop())==0){
                        let ksl:i32=z_stem(claim[kto..kto+ktl],OUTS,TMPS,VBS);
                        let kq:i32=0;
                        while(kq<ksl){CADJB[kq]=OUTS[kq];kq=kq+1;}
                        cadj=CADJB[0..ksl];
                        break;
                    }
                }
                bk=bk+1;
            }
            break;
        }
        bi=bi+1;
    }
    // Subject anchor = first non-stop claim token's stem. ("Tea" is too
    // short for the content-word filter, but the cleft rule needs the
    // claim's subject: "It is not tea but coffee that causes cancer".)
    // V4-INTEG: one shared SUBJA for B1's cleft rule and B3's causal
    // helpers (mechanism, prevent, competitor, short-subject).
    let subjA:[]u8=firstA;
    let sj2:i32=0;
    while(sj2<nct){
        let jto:i32=a_get(TOKA,2*sj2);
        let jtl:i32=a_get(TOKA,2*sj2+1);
        let jll:i32=lower_copy(claim[jto..jto+jtl],TMPS);
        if(in_list(TMPS[0..jll],lex_stop())==0){
            let jsl:i32=z_stem(claim[jto..jto+jtl],OUTS,TMPS,VBS);
            if(jsl>0 && jsl<=24){
                let jsq:i32=0;
                while(jsq<jsl){SUBJA[jsq]=OUTS[jsq];jsq=jsq+1;}
                subjA=SUBJA[0..jsl];
                break;
            }
        }
        sj2=sj2+1;
    }
    // B3-CAU: claim polarity, causal flag, mechanism verb.
    // NEGIDX[0] = claim neg-marker token index (-1 if none).
    let NEGIDX:[]u8=sc[106352..106360];
    let NSPANB:[]u8=sc[106360..107384];
    let NSPANM:[]u8=sc[107384..108408];
    let cneg:i32=0;
    if(pred.len>0){
        cneg=claim_neg(claim,TOKA,nct,pred,OUTS,TMPS,VBS,NEGIDX);
    }
    // Negated span: content stems after the claim's neg marker. Used to
    // recognize supporting negated evidence (double negation). Includes
    // trailing-e-stripped variants (stemmer keeps "e" on verbs).
    let nnspan:i32=0;
    let negi:i32=a_get(NEGIDX,0);
    if(cneg==1 && negi>=0){
        let nsoff:i32=0;
        let si:i32=negi+1;
        while(si<nct && nnspan<64){
            let sto:i32=a_get(TOKA,2*si);
            let stl:i32=a_get(TOKA,2*si+1);
            let sll:i32=lower_copy(claim[sto..sto+stl],TMPS);
            if(sll>3 && in_list(TMPS[0..sll],lex_stop())==0){
                let ssl:i32=z_stem(claim[sto..sto+stl],OUTS,TMPS,VBS);
                if(ssl>0 && ssl<=24){
                    let ssq:i32=0;
                    while(ssq<ssl){NSPANB[nsoff+ssq]=OUTS[ssq];ssq=ssq+1;}
                    a_put(NSPANM,2*nnspan,nsoff);
                    a_put(NSPANM,2*nnspan+1,ssl);
                    nsoff=nsoff+ssl;
                    nnspan=nnspan+1;
                    if(ssl>2 && (OUTS[ssl-1] as i32)==101 && nnspan<64){
                        let ssr:i32=0;
                        while(ssr<ssl-1){NSPANB[nsoff+ssr]=OUTS[ssr];ssr=ssr+1;}
                        a_put(NSPANM,2*nnspan,nsoff);
                        a_put(NSPANM,2*nnspan+1,ssl-1);
                        nsoff=nsoff+ssl-1;
                        nnspan=nnspan+1;
                    }
                }
            }
            si=si+1;
        }
    }
    let cauflag:i32=claim_causal(claim,TOKA,nct,pred,TMPS);
    let cvl:i32=0;
    if(cauflag==1){
        cvl=causal_verb(claim,TOKA,nct,CVB,TMPS,OUTS,VBS);
    }
    let cv:[]u8=CVB[0..cvl];
    // ---- round-6 relation pre-checks (RT2c; narrow/general mechanisms) ----
    // vetoes first: quantifier upgrade / bare causal authority -> neutral
    if(r6_quant_veto(claim,title,snip)==1){return 6;}
    if(r6_bare_authority_veto(claim,title,snip)==1){return 6;}
    if(r6_weak_source(title)==1||r6_weak_source(snip)==1){return 6;}
    // ---- round-7 relation checks (RT2d; general mechanisms) ----
    // vetoes first: non-factive frame / division / equivocation /
    // failure-to-prove / ungrounded possessive -> neutral
    if(r7_nonfactive_veto(claim,title,snip)==1){return 6;}
    if(r7_division_veto(claim,title,snip)==1){return 6;}
    if(r7_equivocation_veto(claim,title,snip)==1){return 6;}
    if(r7_failtoprove_veto(claim,title,snip)==1){return 6;}
    if(r7_pronoun_veto(claim,title,snip)==1){return 6;}
    // deny-side relation checks
    if(r7_contrast_deny(claim,title,snip)==1){return 32+15;}
    if(r7_average_deny(claim,title,snip)==1){return 32+15;}
    if(r7_doubleneg_deny(claim,title,snip)==1){return 32+15;}
    if(r6_report_frame_rel(claim,title,snip)==2){return 32+11;}
    if(r6_moved_event_rel(claim,title,snip)==2){return 32+11;}
    if(r6_competing_subject_deny(claim,title,snip)==2){return 32+14;}
    if(r6_competing_cause_deny(claim,title,snip)==2){return 32+14;}
    if(r6_ratio_rel(claim,title,snip)==2){return 32+12;}
    if(r6_interval_contain(claim,title,snip)==2){return 32+12;}
    if(r6_pct_quant(claim,title,snip)==2){return 32+12;}
    if(r6_meas_compare(claim,title,snip)==2){return 32+12;}
    // r7c: equivocation / pronoun-ambiguity suppress-affirm (A20/A45).
    // Computed after all deny checks; suppresses only AFFIRM returns.
    // round-7 affirm-side relation checks (narrow entailments; run after
    // all deny checks, before the round-6 affirm block)
    if(r7_negverb_paraphrase(claim,title,snip)==1){return 16+15;}
    if(r7_neithernor(claim,title,snip)==1){return 16+15;}
    if(r7_allbut(claim,title,snip)==1){return 16+15;}
    if(r7_doubleneg2(claim,title,snip)==1){return 16+15;}
    if(r7_dative(claim,title,snip)==1){return 16+15;}
    if(r7_genitive(claim,title,snip)==1){return 16+15;}
    if(r7_barely(claim,title,snip)==1){return 16+15;}
    if(r7_stopped(claim,title,snip)==1){return 16+15;}
    if(r7_conj_elim(claim,title,snip)==1){return 16+15;}
    if(r7_zeroq_single(claim,title,snip)==1){return 16+15;}
    if(r7_numeric(claim,title,snip)==1){return 16+15;}
    // affirm-side relation checks (skip if evidence is hedged/weak)
    let hedge:i32=0;
    if(r6_has_hedge(title)==1||r6_has_hedge(snip)==1){hedge=1;}
    if(hedge==0){
    if(r6_report_frame_rel(claim,title,snip)==1){return 16+11;}
    if(r6_moved_event_rel(claim,title,snip)==1){return 16+11;}
    if(r6_temporal_exclusion(claim,title,snip)==1){return 16+11;}
    if(r6_rolerev_affirm(claim,title,snip)==1){return 16+11;}
    if(r6_contrast_affirm(claim,title,snip)==1){return 16+11;}
    if(r6_negclaim_rel(claim,title,snip)==1){return 16+13;}
    if(r6_univ_noone(claim,title,snip)==1){return 16+13;}
    if(r6_noone_universal(claim,title,snip)==1){return 16+13;}
    if(r6_synonym_affirm(claim,title,snip)==1){return 16+13;}
    if(r6_resultative_rel(claim,title,snip)==1){return 16+13;}
    if(r6_superlative_universal(claim,title,snip)==1){return 16+13;}
    }
    if(r6_ratio_rel(claim,title,snip)==1){return 16+12;}
    if(r6_interval_contain(claim,title,snip)==1){return 16+12;}
    if(r6_pct_quant(claim,title,snip)==1){return 16+12;}
    if(r6_meas_compare(claim,title,snip)==1){return 16+12;}
    // ---- round-5 relation pre-checks (run before the overlap gate so
    // that relation-level matches are not blocked by stem coverage) ----
    // zero-quantifier identity (B01/B02/B26/B32)
    if(zeroquant_affirm(claim,title,snip)==1){return 16+5;}
    // numeric guard is hoisted: identical restatement must yield to a
    // numeric contradiction, and the saved value is applied after
    // scan_text below
    let ng0:i32=numeric_guard(claim,title,snip);
    // identical restatement (B13/B14/B16/B17/B20/B33/B36/B40/B42/B44/B45/B46)
    if(ng0!=2 && identical_affirm(claim,title,snip,ng0)==1){return 16+5;}
    // negated universals + counterexamples (B03/B19/B25)
    if(neguniv_affirm(claim,title,snip)==1){return 16+5;}
    // double negation (B04/B21/B22/B23/B24)
    if(doubleneg_affirm(claim,title,snip)==1){return 16+5;}
    // direct contradiction of a clause-final negated verb (B06)
    if(negverb_deny(claim,title,snip)==2){return 32+3;}
    // prevention + non-occurrence (B18)
    if(prevent_affirm(claim,title,snip)==1){return 16+5;}
    // ---- overlap gate on the whole text ----
    let fl:i32=0;
    let ti:i32=0;
    while(ti<title.len){FULLB[fl]=title[ti];ti=ti+1;fl=fl+1;}
    FULLB[fl]=32;fl=fl+1;
    ti=0;
    while(ti<snip.len){FULLB[fl]=snip[ti];ti=ti+1;fl=fl+1;}
    let full:[]u8=FULLB[0..fl];
    let nft:i32=z_toks(full,TOKB,1024);
    let ntstm:i32=0;
    let soffB:i32=0;
    i=0;
    while(i<nft){
        let to5:i32=a_get(TOKB,2*i);
        let tl5:i32=a_get(TOKB,2*i+1);
        let sl5:i32=z_stem(full[to5..to5+tl5],OUTS,TMPS,VBS);
        let q5:i32=0;
        while(q5<sl5){STEMB[soffB+q5]=OUTS[q5];q5=q5+1;}
        a_put(TSTMB,2*ntstm,soffB);
        a_put(TSTMB,2*ntstm+1,sl5);
        soffB=soffB+sl5;
        ntstm=ntstm+1;
        i=i+1;
    }
    let need:i32=2;
    if(nw<3){need=1;}
    let inter:i32=0;
    i=0;
    while(i<ncs){
        let so6:i32=a_get(CSTEMA,2*i);
        let sl6:i32=a_get(CSTEMA,2*i+1);
        let cs6:[]u8=STEMA[so6..so6+sl6];
        if(in_stems(cs6,STEMB,TSTMB,ntstm)==1){inter=inter+1;}
        else{
            // B3-CAU V4-R2 trailing-e bridge: the stemmer keeps a trailing
            // "e" on verb stems ("exercise") but strips it on nouns
            // ("exercis"), so cross-claim/evidence stem matching fails.
            // Retry with the trailing "e" stripped.
            if(sl6>2 && (STEMA[so6+sl6-1] as i32)==101){
                if(in_stems(STEMA[so6..so6+sl6-1],STEMB,TSTMB,ntstm)==1){inter=inter+1;}
            }
        }
        i=i+1;
    }
    if(inter<need){return 0;}
    // ---- B4-TMP / B4-CMP early decisions ----
    // temporal: 2=deny (reversed order/date mismatch); 1=affirm (order
    // confirmed by evidence pairs or date arithmetic); 0=suppress affirm
    // comparative: 2=deny (antonym/role swap); 0=suppress affirm
    // (comparative 1 = same comparison present -> normal pipeline AFFIRMs)
    let tsup:i32=0;
    let td:i32=temporal_decide(claim,TOKA,nct,full,TOKB,nft,sc);
    if(td==2){return 32+7;}
    if(td==1){return 16+5;}
    if(td==0){tsup=1;}
    let cd:i32=comp_decide(claim,TOKA,nct,full,TOKB,nft,sc);
    if(cd==2){return 32+8;}
    if(cd==0){tsup=1;}
    // ---- B4-QUANT: claim quantifier = first claim token ----
    let Qc:i32=0;
    if(nct>0){
        let toq:i32=a_get(TOKA,0);
        let tlq:i32=a_get(TOKA,1);
        let lq:i32=lower_copy(claim[toq..toq+tlq],TMPS);
        Qc=quant_code(TMPS[0..lq]);
        // "not all" / "not every" = negated universal (fix #6).
        // Logically equivalent to "some ... not". Set Qc=8 to avoid the
        // Qc==0 weak-evidence deny.
        if(Qc==0 && nct>=2){
            let tmp2:[]u8=z_alloc(64);
            if(tmp2.len>0){
                let l0b:i32=lower_copy(claim[toq..toq+tlq],tmp2);
                let t1o:i32=a_get(TOKA,2);
                let t1l:i32=a_get(TOKA,3);
                let l1:i32=lower_copy(claim[t1o..t1o+t1l],TMPS);
                if(z_eq(tmp2[0..l0b],"not")==1){
                    if(z_eq(TMPS[0..l1],"all")==1 || z_eq(TMPS[0..l1],"every")==1 || z_eq(TMPS[0..l1],"each")==1){
                        Qc=8;
                    }
                }
                z_free(tmp2);
            }
        }
    }
    // claim numbers (for the competing-subject value guard)
    let nnums:i32=claim_numbers(claim,NUMA,64);
    // round-5: the claim's comparative word for the endorse comparative
    // veto (A29). Bound constructions ("fewer than N") belong to the
    // bound machinery and are excluded here.
    let compw:[]u8="";
    let cwi:i32=0;
    while(cwi<nct){
        let cwo:i32=a_get(TOKA,2*cwi);
        let cwl:i32=a_get(TOKA,2*cwi+1);
        let cwll:i32=lower_copy(claim[cwo..cwo+cwl],TMPS);
        if(cwll>0 && cwll<24 && is_compw(TMPS[0..cwll])==1){
            let cqq:i32=0;
            while(cqq<cwll){COMPWB[cqq]=TMPS[cqq];cqq=cqq+1;}
            let is_bound:i32=0;
            if(cwi+1<nct){
                let nwo:i32=a_get(TOKA,2*(cwi+1));
                let nwl:i32=a_get(TOKA,2*(cwi+1)+1);
                let nwll:i32=lower_copy(claim[nwo..nwo+nwl],TMPS);
                if(z_eq(TMPS[0..nwll],"than")==1){is_bound=1;}
            }
            if(is_bound==0){compw=COMPWB[0..cwll];break;}
        }
        cwi=cwi+1;
    }
    // ---- clause scan: title stream, then snippet stream ----
    AFFB[0]=0;
    let dr:i32=scan_text(title,STEMA,CSTEMA,ncs,STEMB,TSTMB,ntstm,firstA,lastA,pred,cadj,subjA,need,NUMA,nnums,claim,CLAUA,PROTB,TOKC,STEMC,CSTMC,LOWB,CLVB,TMPS,OUTS,VBS,AFFB,cneg,cauflag,cv,SSTEMB,SSTMC,nsst,tsup,Qc,NSPANB,NSPANM,nnspan,compw,sc);
    if(dr!=0){return 32+dr;}
    dr=scan_text(snip,STEMA,CSTEMA,ncs,STEMB,TSTMB,ntstm,firstA,lastA,pred,cadj,subjA,need,NUMA,nnums,claim,CLAUA,PROTB,TOKC,STEMC,CSTMC,LOWB,CLVB,TMPS,OUTS,VBS,AFFB,cneg,cauflag,cv,SSTEMB,SSTMC,nsst,tsup,Qc,NSPANB,NSPANM,nnspan,compw,sc);
    if(dr!=0){return 32+dr;}
    // B2-CON: numeric guard (constrained DENY-only; abstain is neutral).
    // Value was hoisted to the round-5 pre-checks; reuse it here so the
    // guard keeps its original position relative to scan_text.
    let ng:i32=ng0;
    if(ng==2){return 32+10;}
    if(ng==1){return 16+5;}
    if(AFFB[0]==1){return 16+5;}
    return 6;
}
// ==================== reason + driver ====================
// Return encoding: tag*16 + reason. AFFIRM=16+5, neutral=6,
// DENY=32+r (r: 1 gate | 2 deny-lex | 3 antonym | 4 neg-scope |
// 5 competing-subject | 6 endorse | 7 temporal | 8 comparative |
// 9 quantifier | 10 numeric-mismatch). reason_str takes the raw reason.
fn reason_str(r:i32)[]u8{
    if(r==0){return "gate";}
    if(r==1){return "deny-lex";}
    if(r==2){return "antonym";}
    if(r==3){return "neg-scope";}
    if(r==4){return "competing-subject";}
    if(r==5){return "endorse";}
    if(r==6){return "neutral";}
    if(r==7){return "temporal";}
    if(r==8){return "comparative";}
    if(r==9){return "quantifier";}
    if(r==10){return "numeric-mismatch";}
    // round-6 relation reasons (RT2c)
    if(r==11){return "frame/sequence";}
    if(r==12){return "quantity bound";}
    if(r==13){return "polarity/paraphrase";}
    if(r==14){return "subject/cause competition";}
    // round-7 relation reasons (RT2d)
    if(r==15){return "relation";}
    return "unknown";
}
fn process_line(line:[]u8,sc:[]u8,ob:[]u8)void{
    let t1:i32=-1;
    let t2:i32=-1;
    let t3:i32=-1;
    let i:i32=0;
    while(i<line.len){
        if((line[i] as i32)==9){
            if(t1<0){t1=i;}
            else{
                if(t2<0){t2=i;}
                else{if(t3<0){t3=i;break;}}
            }
        }
        i=i+1;
    }
    if(t3<0){return;}
    let idx:[]u8=line[0..t1];
    let claim:[]u8=line[t1+1..t2];
    let title:[]u8=line[t2+1..t3];
    let snip:[]u8=line[t3+1..line.len];
    // 4-field lines (ID, claim, evidence, label): the 4th field is the
    // label, not a snip. Clear it so numeric scans don't read the label
    // as evidence.
    if(snip.len<=2){
        let alld:i32=1;
        let si:i32=0;
        while(si<snip.len){
            if(z_isdig(snip[si] as i32)==0){alld=0;break;}
            si=si+1;
        }
        if(alld==1){snip=line[line.len..line.len];}
    }
    // B45: strip a leading meta-contrast frame ("Unlike X, ...",
    // "Contrary to X, ...") before classification. The frame is discourse
    // contrast, not asserted content; subject scoping must operate on the
    // matrix claim.
    let r:i32=r12_classify(strip_meta_frame(claim),title,snip,sc);
    let tag:i32=r/16;
    let rsn:i32=r-tag*16;
    let o:i32=0;
    let k:i32=0;
    while(k<idx.len){ob[o]=idx[k];o=o+1;k=k+1;}
    ob[o]=32;o=o+1;
    ob[o]=(48+tag) as u8;o=o+1;
    ob[o]=32;o=o+1;
    let rs:[]u8=reason_str(rsn);
    k=0;
    while(k<rs.len){ob[o]=rs[k];o=o+1;k=k+1;}
    ob[o]=10;o=o+1;
    _zag_print(ob[0..o]);
    return;
}
fn main()i32{
    let path:[]u8=_zag_arg(1);
    if(path.len==0){
        _zag_println("usage: r12_v4 <input.tsv>");
        return 2;
    }
    let data:[]u8=read_all(path);
    if(data.len==0){
        _zag_println("r12_v4: cannot read input");
        return 3;
    }
    let sc:[]u8=z_alloc(120000);
    if(sc.len==0){return 4;}
    let ob:[]u8=z_alloc(8192);
    if(ob.len==0){return 5;}
    let n:i32=data.len;
    let i:i32=0;
    let ls:i32=0;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;}
        else{if((data[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (data[le-1] as i32)==13){le=le-1;}
            if(le>ls){process_line(data[ls..le],sc,ob);}
            ls=i+1;
        }
        i=i+1;
    }
    return 0;
}


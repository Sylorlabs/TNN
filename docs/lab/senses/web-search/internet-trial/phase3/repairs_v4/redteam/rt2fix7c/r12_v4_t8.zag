    if(z_eq(a,"big")==1 && z_eq(b,"small")==1){return 1;}
    if(z_eq(a,"small")==1 && z_eq(b,"big")==1){return 1;}
    if(z_eq(a,"larg")==1 && z_eq(b,"small")==1){return 1;}
    if(z_eq(a,"small")==1 && z_eq(b,"larg")==1){return 1;}
    if(z_eq(a,"high")==1 && z_eq(b,"low")==1){return 1;}
    if(z_eq(a,"low")==1 && z_eq(b,"high")==1){return 1;}
    if(z_eq(a,"long")==1 && z_eq(b,"short")==1){return 1;}
    if(z_eq(a,"short")==1 && z_eq(b,"long")==1){return 1;}
    if(z_eq(a,"fast")==1 && z_eq(b,"slow")==1){return 1;}
    if(z_eq(a,"slow")==1 && z_eq(b,"fast")==1){return 1;}
    if(z_eq(a,"strong")==1 && z_eq(b,"weak")==1){return 1;}
    if(z_eq(a,"weak")==1 && z_eq(b,"strong")==1){return 1;}
    if(z_eq(a,"expens")==1 && z_eq(b,"cheap")==1){return 1;}
    if(z_eq(a,"cheap")==1 && z_eq(b,"expens")==1){return 1;}
    if(z_eq(a,"light")==1 && z_eq(b,"dark")==1){return 1;}
    if(z_eq(a,"dark")==1 && z_eq(b,"light")==1){return 1;}
    if(z_eq(a,"white")==1 && z_eq(b,"black")==1){return 1;}
    if(z_eq(a,"black")==1 && z_eq(b,"white")==1){return 1;}
    if(z_eq(a,"happi")==1 && z_eq(b,"sad")==1){return 1;}
    if(z_eq(a,"sad")==1 && z_eq(b,"happi")==1){return 1;}
    if(z_eq(a,"clean")==1 && z_eq(b,"dirti")==1){return 1;}
    if(z_eq(a,"dirti")==1 && z_eq(b,"clean")==1){return 1;}
    if(z_eq(a,"safe")==1 && z_eq(b,"danger")==1){return 1;}
    if(z_eq(a,"danger")==1 && z_eq(b,"safe")==1){return 1;}
    if(z_eq(a,"rich")==1 && z_eq(b,"poor")==1){return 1;}
    if(z_eq(a,"poor")==1 && z_eq(b,"rich")==1){return 1;}
    return 0;
}
// Taxonomic class nouns: two different class nouns are mutually exclusive
// ("dolphins are mammals" contradicts "dolphins are fish").
fn is_classnoun(w:[]u8)i32{
    if(z_eq(w,"mammal")==1){return 1;}

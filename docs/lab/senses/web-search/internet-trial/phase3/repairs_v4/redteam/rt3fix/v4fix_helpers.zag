    if(j_stem_near_pos(hay,"water",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"wine",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"beer",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"soda",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"tea",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"fruit",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"vegetable",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"meat",from,wlim)!=0){return 1;}
    return 0;
}
// j_da5d_shape: constitutive claim — sky word within 24 chars before
// "made of/from"|"composed of", food stem within 52 chars after.
fn j_da5d_shape(hay:[]u8)i32{
    let p:i32=j_phrase_pos(hay,"made of",0);
    if(p<0){p=j_phrase_pos(hay,"made from",0);}
    if(p<0){p=j_phrase_pos(hay,"composed of",0);}
    if(p<0){return 0;}
    let from:i32=p-24;
    if(from<0){from=0;}
    let sky:i32=0;
    if(j_has_word_lim(hay,"moon",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"sun",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"stars",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"star",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"venus",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"mars",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"jupiter",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"planet",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"planets",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"galaxy",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"sky",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"earth",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"universe",from,p)!=0){sky=1;}
    if(j_has_word_lim(hay,"cosmos",from,p)!=0){sky=1;}
    if(sky==0){return 0;}
    let wlim:i32=p+52;
    if(j_food_near(hay,p,wlim)!=0){return 1;}
    return 0;
}
// j_has_quote: contains a single or double quote mark.
fn j_has_quote(hay:[]u8)i32{
    let i:i32=0;
    while(i<hay.len){
        if(hay[i]==39){return 1;}
        if(hay[i]==34){return 1;}
        i=i+1;
    }
    return 0;
}
// j_whisper_shape: conspiratorial speech verb + quoted speech + two-part.
fn j_whisper_shape(hay:[]u8)i32{
    if(j_two_clause(hay)==0){return 0;}
    if(j_has_quote(hay)==0){return 0;}
    if(j_has_word(hay,"whispered")!=0){return 1;}
    if(j_has_word(hay,"muttered")!=0){return 1;}
    if(j_has_word(hay,"hissed")!=0){return 1;}
    return 0;
}
// ---- pun detectors: idiom + literal-context activation ----
// A pun fires when a figurative idiom appears alongside a word that
// primes its LITERAL meaning. Both halves are semantic classes, not
// single rows.
// j_growable: things that literally grow.
fn j_growable(hay:[]u8)i32{
    if(j_has_word(hay,"hair")!=0){return 1;}
    if(j_has_word(hay,"beard")!=0){return 1;}
    if(j_has_word(hay,"beards")!=0){return 1;}
    if(j_has_word(hay,"mustache")!=0){return 1;}
    if(j_has_word(hay,"mustaches")!=0){return 1;}
    if(j_has_word(hay,"plant")!=0){return 1;}
    if(j_has_word(hay,"plants")!=0){return 1;}
    if(j_has_word(hay,"mold")!=0){return 1;}
    if(j_has_word(hay,"nail")!=0){return 1;}
    if(j_has_word(hay,"nails")!=0){return 1;}
    if(j_has_word(hay,"grass")!=0){return 1;}
    if(j_has_word(hay,"tree")!=0){return 1;}
    if(j_has_word(hay,"trees")!=0){return 1;}
    if(j_has_word(hay,"flower")!=0){return 1;}
    if(j_has_word(hay,"flowers")!=0){return 1;}
    if(j_has_word(hay,"garden")!=0){return 1;}
    if(j_has_word(hay,"ivy")!=0){return 1;}
    if(j_has_word(hay,"moss")!=0){return 1;}
    if(j_has_word(hay,"crystal")!=0){return 1;}
    if(j_has_word(hay,"fungus")!=0){return 1;}
    if(j_has_word(hay,"sprout")!=0){return 1;}
    if(j_has_word(hay,"seedling")!=0){return 1;}
    return 0;
}
// j_pun_grow: "grew on me" + something that literally grows.
fn j_pun_grow(hay:[]u8)i32{
    if(j_has_word(hay,"grew on me")==0){return 0;}
    if(j_growable(hay)!=0){return 1;}
    return 0;
}
// j_traversable: obstacles one physically gets over.
fn j_traversable(hay:[]u8)i32{
    if(j_has_word(hay,"bump")!=0){return 1;}
    if(j_has_word(hay,"bumps")!=0){return 1;}
    if(j_has_word(hay,"hurdle")!=0){return 1;}
    if(j_has_word(hay,"hurdles")!=0){return 1;}
    if(j_has_word(hay,"wall")!=0){return 1;}
    if(j_has_word(hay,"walls")!=0){return 1;}
    if(j_has_word(hay,"fence")!=0){return 1;}
    if(j_has_word(hay,"fences")!=0){return 1;}
    if(j_has_word(hay,"bridge")!=0){return 1;}
    if(j_has_word(hay,"bridges")!=0){return 1;}
    if(j_has_word(hay,"obstacle")!=0){return 1;}
    if(j_has_word(hay,"mountain")!=0){return 1;}
    if(j_has_word(hay,"hill")!=0){return 1;}
    if(j_has_word(hay,"hills")!=0){return 1;}
    if(j_has_word(hay,"barrier")!=0){return 1;}
    if(j_has_word(hay,"gate")!=0){return 1;}
    if(j_has_word(hay,"ditch")!=0){return 1;}
    if(j_has_word(hay,"log")!=0){return 1;}
    return 0;
}
// j_pun_over: "get(ting) over it" + fear context + traversable obstacle.
fn j_pun_over(hay:[]u8)i32{
    let g:i32=0;
    if(j_has_word(hay,"getting over it")!=0){g=1;}
    if(j_has_word(hay,"get over it")!=0){g=1;}
    if(j_has_word(hay,"got over it")!=0){g=1;}
    if(g==0){return 0;}
    let f:i32=0;
    if(j_has_word(hay,"fear of")!=0){f=1;}
    if(j_has_word(hay,"fear")!=0){f=1;}
    if(j_has_word(hay,"fears")!=0){f=1;}
    if(j_has_word(hay,"afraid of")!=0){f=1;}
    if(j_has_word(hay,"afraid")!=0){f=1;}
    if(j_has_word(hay,"scared of")!=0){f=1;}
    if(f==0){return 0;}
    if(j_traversable(hay)!=0){return 1;}
    return 0;
}
// j_jumpctx: literal jumping contexts (excluding the idiom's own words
// jump/jumps/jumping/jumped, which would self-match).
fn j_jumpctx(hay:[]u8)i32{
    if(j_has_word(hay,"hurdle")!=0){return 1;}
    if(j_has_word(hay,"hurdles")!=0){return 1;}
    if(j_has_word(hay,"leap")!=0){return 1;}
    if(j_has_word(hay,"leaps")!=0){return 1;}
    if(j_has_word(hay,"leaping")!=0){return 1;}
    if(j_has_word(hay,"hop")!=0){return 1;}
    if(j_has_word(hay,"hops")!=0){return 1;}
    if(j_has_word(hay,"hopping")!=0){return 1;}
    if(j_has_word(hay,"bounce")!=0){return 1;}
    if(j_has_word(hay,"bounces")!=0){return 1;}
    if(j_has_word(hay,"bouncing")!=0){return 1;}
    if(j_has_word(hay,"trampoline")!=0){return 1;}
    if(j_has_word(hay,"trampolines")!=0){return 1;}
    return 0;
}
// j_pun_jump: "jump(ing) to conclusions" + literal jumping context.
fn j_pun_jump(hay:[]u8)i32{
    let p:i32=0;
    if(j_has_word(hay,"jump to conclusions")!=0){p=1;}
    if(j_has_word(hay,"jumping to conclusions")!=0){p=1;}
    if(j_has_word(hay,"jumped to conclusions")!=0){p=1;}
    if(j_has_word(hay,"jump-to-conclusions")!=0){p=1;}
    if(j_has_word(hay,"jumping-to-conclusions")!=0){p=1;}
    if(j_has_word(hay,"jumped-to-conclusions")!=0){p=1;}
    if(p==0){return 0;}
    if(j_jumpctx(hay)!=0){return 1;}
    return 0;
}
// j_mathword: math domain words (fraction-bar "line" is literal here).
fn j_mathword(hay:[]u8)i32{
    if(j_has_word(hay,"numerator")!=0){return 1;}
    if(j_has_word(hay,"denominator")!=0){return 1;}
    if(j_has_word(hay,"fraction")!=0){return 1;}
    if(j_has_word(hay,"fractions")!=0){return 1;}
    if(j_has_word(hay,"equation")!=0){return 1;}
    if(j_has_word(hay,"formula")!=0){return 1;}
    if(j_has_word(hay,"decimal")!=0){return 1;}
    if(j_has_word(hay,"percent")!=0){return 1;}
    if(j_has_word(hay,"percentage")!=0){return 1;}
    if(j_has_word(hay,"algebra")!=0){return 1;}
    if(j_has_word(hay,"calculus")!=0){return 1;}
    if(j_has_word(hay,"geometry")!=0){return 1;}
    if(j_has_word(hay,"integer")!=0){return 1;}
    if(j_has_word(hay,"divisor")!=0){return 1;}
    if(j_has_word(hay,"dividend")!=0){return 1;}
    if(j_has_word(hay,"quotient")!=0){return 1;}
    return 0;
}
// j_pun_line: "fine line between" + math domain (the line is literal).
fn j_pun_line(hay:[]u8)i32{
    if(j_has_word(hay,"fine line between")==0){return 0;}
    if(j_mathword(hay)!=0){return 1;}
    return 0;
}
// j_celestial: sky objects that "come out".
fn j_celestial(hay:[]u8)i32{
    if(j_has_word(hay,"stars")!=0){return 1;}
    if(j_has_word(hay,"star")!=0){return 1;}
    if(j_has_word(hay,"sun")!=0){return 1;}
    if(j_has_word(hay,"moon")!=0){return 1;}
    if(j_has_word(hay,"planets")!=0){return 1;}
    if(j_has_word(hay,"planet")!=0){return 1;}
    return 0;
}
// j_dental: teeth/denture words ("come out" = removed).
fn j_dental(hay:[]u8)i32{
    if(j_has_word(hay,"teeth")!=0){return 1;}
    if(j_has_word(hay,"tooth")!=0){return 1;}
    if(j_has_word(hay,"dentures")!=0){return 1;}
    if(j_has_word(hay,"denture")!=0){return 1;}
    if(j_has_word(hay,"molars")!=0){return 1;}
    if(j_has_word(hay,"molar")!=0){return 1;}
    return 0;
}
// j_pun_comeout: "come out" with both celestial (appear) and dental (removed)
// contexts primed = the dual-meaning pun is active.
fn j_pun_comeout(hay:[]u8)i32{
    if(j_has_word(hay,"come out")==0){return 0;}
    if(j_celestial(hay)==0){return 0;}
    if(j_dental(hay)!=0){return 1;}
    return 0;
}

    if(j_stem_near_pos(hay,"pie",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"ice cream",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"steak",from,wlim)!=0){return 1;}
    if(j_stem_near_pos(hay,"chicken",from,wlim)!=0){return 1;}

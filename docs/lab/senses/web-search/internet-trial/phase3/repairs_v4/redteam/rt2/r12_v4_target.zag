    return "\nam\nare\nate\nbe\nbeen\nbeing\nblock\nblocks\nboil\nboils\nbreak\nbreaks\nbuild\nbuilds\ncan\ncause\ncaused\ncauses\nclear\nclears\nconfirm\nconfirmed\nconfirms\nconnect\nconnects\ncontain\ncontains\ncould\ncure\ncured\ncures\ndemonstrate\ndemonstrates\ndid\ndisrupt\ndisrupts\ndissolve\ndissolved\ndissolves\ndo\ndoes\ndrank\ndrink\ndrinking\ndrinks\neat\neating\neats\nexpand\nfake\nfaked\nfakes\nfall\nfalls\nfind\nfinds\nfloat\nflow\nflows\nform\nforms\nfound\nfreeze\nfreez\nfroze\nfrozen\ngrow\ngrows\nhad\nhappen\nhas\nhave\nheal\nheals\nhit\nhits\nimprove\nimproves\nincrease\nincreases\nis\nlead\nleads\nleak\nleaked\nlink\nlinks\nlower\nlowers\nmade\nmake\nmakes\nmay\nmelt\nmight\nmust\noccur\norbit\norbits\noriginate\noriginated\noriginates\nprevent\nprevents\nproduce\nproduces\nprove\nproved\nproves\nraise\nraises\nreduce\nreduces\nremedy\nresult\nrevolve\nrevolves\nrise\nrises\nsaid\nsay\nsays\nsee\nsees\nshall\nshould\nshow\nshowed\nshown\nshows\nsank\nsink\nsunk\nspread\nspreads\nstate\nstated\nstates\nstop\nstops\nstrike\nstrikes\nstruck\ntake\ntakes\ntie\nties\ntook\ntransmit\ntransmits\ntreat\ntreated\ntreats\ntrigger\ntriggers\nuse\nused\nuses\nvisible\nwas\nwere\nwill\nworsen\nworsens\nwould\n";
}
fn lex_reporting()[]u8{
    return "\nargue\nargues\nbelieve\nbelieves\nclaim\nclaimed\nclaims\nreport\nreported\nreports\nsaid\nsay\nsays\nshow\nshowed\nshown\nshows\nstate\nstates\nsuggest\nsuggests\nthink\nthinks\n";
}
fn lex_neg()[]u8{
    return "\nbarely\nhardly\nneither\nnever\nno\nnone\nnor\nnot\nnothing\nscarcely\nwithout\n";
}
fn lex_strong()[]u8{
    // B1-V4: replaced the dead "denies" entry (the stemmer maps
    // "denies"->"deny", so "denies" could never match) with the stems the
    // stemmer actually produces: deny, denie ("denied"), reject, disput,
    // contradict. Same gate as before (strong && nclm>=1).
    return "\ncontradict\ncontrary\ndebunk\ndenie\ndeny\ndisproven\ndisput\nfake\nfaked\nfalse\nhoax\nincorrect\nmyth\nrefuted\nreject\nwrong\n";
}
fn lex_weak()[]u8{
    return "\nalthough\ndespite\nhowever\nthough\nunlikely\n";
}
fn lex_super()[]u8{
    return "\nbest\nbiggest\nfirst\nhighest\nlargest\nleast\nlongest\nmost\nonly\nsmallest\ntallest\nworst\n";
}
fn lex_conjskip()[]u8{
    return "\nalso\nalthough\nand\nbecause\nbut\ndespite\neven\nfor\nhence\nhowever\nif\njust\nnor\nor\nsince\nso\nstill\nthen\nthough\nthus\nwhen\nwhere\nwhile\nyet\n";
}
fn lex_whaux()[]u8{
    return "\nare\ncan\ncould\ndid\ndo\ndoes\nhow\nis\nshould\nwas\nwere\nwhat\nwhen\nwhere\nwhich\nwho\nwhom\nwhy\nwill\nwould\n";
}
fn lex_filler()[]u8{
    return "\na\nan\nand\nas\nat\nbut\nby\nfor\nfrom\nin\nof\non\nor\nthe\nto\nwith\n";
}
fn lex_be()[]u8{
    return "\nis\nare\nwas\nwere\nam\nbe\nbeen\nbeing\n";
}
fn lex_have()[]u8{
    return "\nhas\nhave\nhad\n";
}
fn lex_barrier()[]u8{
    return "\nalthough\nand\nbecause\nbut\nhowever\nif\nor\nsince\nthat\nthough\nunless\nuntil\nwhether\nwhen\nwhile\n";
}
fn lex_cmp()[]u8{
    return "\nbest\nbetter\nbigger\nearlier\nfaster\nfewer\ngreater\nhigher\nlarger\nlater\nleast\nless\nlonger\nlower\nmore\nmost\nshorter\nslower\nsmaller\nsooner\nworse\nworst\n";
}
fn lex_cog()[]u8{
    return "\nconclude\nconcluded\nconcludes\nconcluding\ndetermine\ndetermined\ndiscover\ndiscovered\nfind\nfinds\nfound\nrealize\nrealized\n";
}
fn lex_evid()[]u8{
    return "\ndata\nevidence\nproof\nstudies\nstudy\n";
}
fn lex_worse()[]u8{
    return "\nworsen\nwors\nbad\nharm\ndamag\nhurt\ndeclin\ndeterior\npoor\nill\n";
}
fn lex_hedge()[]u8{
    return "\nappear\nappears\nbelieve\nbelieved\nbelieves\nbelieving\ncould\nlikely\nmay\nmaybe\nmight\nperhaps\npossibly\nprobably\nseem\nseems\nsuggest\nsuggested\nsuggests\nthought\n";
}
// ==================== shared helpers ====================
fn in_list(w:[]u8,blob:[]u8)i32{
    let i:i32=0;
    while(i<blob.len){
        if((blob[i] as i32)==10){
            let k:i32=0;
            while(k<w.len && i+1+k<blob.len && blob[i+1+k]==w[k]){k=k+1;}
            if(k==w.len && i+1+k<blob.len && (blob[i+1+k] as i32)==10){return 1;}
        }
        i=i+1;
    }
    return 0;
}
fn deny_prefix(st:[]u8)i32{
    if(z_starts(st,"debunk")==1){return 1;}
    if(z_starts(st,"disprov")==1){return 1;}
    if(z_starts(st,"refut")==1){return 1;}
    if(z_starts(st,"incorrect")==1){return 1;}
    if(z_starts(st,"wrong")==1){return 1;}
    if(z_starts(st,"myth")==1){return 1;}
    if(z_starts(st,"hoax")==1){return 1;}
    if(z_starts(st,"fals")==1){return 1;}
    if(z_starts(st,"deny")==1){return 1;}
    if(z_starts(st,"reject")==1){return 1;}
    if(z_starts(st,"disput")==1){return 1;}
    if(z_starts(st,"contradict")==1){return 1;}
    return 0;
}
fn psyn_has(s:[]u8,pred:[]u8)i32{
    if(z_eq(pred,"boil")==1){return z_eq(s,"boil");}
    if(z_eq(pred,"cause")==1){return z_eq(s,"cause");}
    if(z_eq(pred,"cure")==1){return z_eq(s,"cure");}
    if(z_eq(pred,"dissolve")==1){return z_eq(s,"dissolve");}
    if(z_eq(pred,"fake")==1){return z_eq(s,"fake");}
    if(z_eq(pred,"strike")==1){return z_eq(s,"strike");}
    if(z_eq(pred,"use")==1){return z_eq(s,"use");}
    if(z_eq(pred,"show")==1){return z_eq(s,"show");}
    if(z_eq(pred,"float")==1){return z_eq(s,"float");}
    if(z_eq(pred,"sink")==1 || z_eq(pred,"sank")==1 || z_eq(pred,"sunk")==1){
        if(z_eq(s,"sink")==1){return 1;}
        if(z_eq(s,"sank")==1){return 1;}
        return z_eq(s,"sunk");
    }
    if(z_eq(pred,"result")==1){return z_eq(s,"result");}
    if(z_eq(pred,"expand")==1){return z_eq(s,"expand");}
    if(z_eq(pred,"occur")==1 || z_eq(pred,"happen")==1){
        if(z_eq(s,"occur")==1){return 1;}
        return z_eq(s,"happen");
    }
    if(z_eq(pred,"melt")==1){return z_eq(s,"melt");}
    if(z_eq(pred,"freeze")==1 || z_eq(pred,"freez")==1 || z_eq(pred,"frozen")==1 || z_eq(pred,"froze")==1){
        if(z_eq(s,"freeze")==1){return 1;}
        if(z_eq(s,"freez")==1){return 1;}
        if(z_eq(s,"frozen")==1){return 1;}
        return z_eq(s,"froze");
    }
    if(z_eq(pred,"orbit")==1){
        if(z_eq(s,"orbit")==1){return 1;}
        return z_eq(s,"revolve");
    }
    if(z_eq(pred,"originate")==1){
        if(z_eq(s,"originate")==1){return 1;}
        return z_eq(s,"leak");
    }
    if(z_eq(pred,"have")==1){
        if(z_eq(s,"have")==1){return 1;}
        if(z_eq(s,"has")==1){return 1;}
        return z_eq(s,"had");
    }
    if(z_eq(pred,"be")==1){
        if(z_eq(s,"be")==1){return 1;}
        if(z_eq(s,"is")==1){return 1;}
        if(z_eq(s,"are")==1){return 1;}
        if(z_eq(s,"was")==1){return 1;}
        if(z_eq(s,"were")==1){return 1;}
        return z_eq(s,"am");
    }
    return z_eq(s,pred);
}
fn has_superlative(stemC:[]u8,cstmC:[]u8,nct:i32)i32{
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        if(in_list(stemC[so..so+sl],lex_super())==1){return 1;}
        i=i+1;
    }
    return 0;
}
fn is_wc(s:[]u8,i:i32)i32{
    if(i>=s.len){return 0;}
    let b:i32=s[i] as i32;
    if(b>=65 && b<=90){return 1;}
    if(b>=97 && b<=122){return 1;}
    if(b>=48 && b<=57){return 1;}
    if(b==39){return 1;}
    if(b==226 && i+2<s.len){
        if((s[i+1] as i32)==128 && (s[i+2] as i32)==153){return 3;}
    }
    return 0;
}
fn z_toks(t:[]u8,ar:[]u8,max:i32)i32{
    let n:i32=t.len;
    let i:i32=0;
    let k:i32=0;
    while(i<n && k<max){
        let l:i32=is_wc(t,i);
        if(l==0){i=i+1;}
        else{
            let st:i32=i;
            while(l>0){
                i=i+l;
                if(i<n && (t[i] as i32)==45){
                    let l2:i32=is_wc(t,i+1);
                    if(l2>0){i=i+1;l=l2;continue;}
                }
                l=is_wc(t,i);
            }
            a_put(ar,2*k,st);
            a_put(ar,2*k+1,i-st);
            k=k+1;
        }
    }
    return k;
}
fn z_stem(t:[]u8,out:[]u8,tmp:[]u8,vb:[]u8)i32{
    let n:i32=t.len;
    // 1. lowercase (ASCII + Latin-1 C3 80-9E)
    let i:i32=0;
    let k:i32=0;
    while(i<n){
        let b:i32=t[i] as i32;
        if(b>=65 && b<=90){tmp[k]=(b+32) as u8;k=k+1;i=i+1;}
        else{
            if(b==195 && i+1<n){
                let b2:i32=t[i+1] as i32;
                if(b2>=128 && b2<=158 && b2!=151){
                    tmp[k]=195 as u8;tmp[k+1]=(b2+32) as u8;k=k+2;i=i+2;
                }else{tmp[k]=b as u8;k=k+1;i=i+1;}
            }else{tmp[k]=b as u8;k=k+1;i=i+1;}
        }
    }
    // 2. possessive 's
    if(k>=2 && (tmp[k-2] as i32)==39 && (tmp[k-1] as i32)==115){k=k-2;}
    // 3. strip ASCII quotes
    while(k>0 && (tmp[k-1] as i32)==39){k=k-1;}
    let j0:i32=0;
    while(j0<k && (tmp[j0] as i32)==39){j0=j0+1;}
    // 4. short guard (char count, like Python len())
    let nc:i32=z_cplen_range(tmp,j0,k);
    if(nc<=3){
        let o:i32=0;
        while(j0+o<k){out[o]=tmp[j0+o];o=o+1;}
        return o;
    }
    let app:i32=-1;
    let done:i32=0;
    // ies -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ies")==1){k=k-3;app=121;done=1;}
    // sses/xes/zes/ches/shes -> strip 2
    if(done==0 && nc>5){
        if(ew(tmp,j0,k,"sses")==1 || ew(tmp,j0,k,"xes")==1 || ew(tmp,j0,k,"zes")==1 || ew(tmp,j0,k,"ches")==1 || ew(tmp,j0,k,"shes")==1){
            k=k-2;done=1;
        }
    }
    // es -> strip 1
    if(done==0 && ew(tmp,j0,k,"es")==1){k=k-1;done=1;}
    // s (not ss) -> strip 1
    if(done==0 && ew(tmp,j0,k,"s")==1 && ew(tmp,j0,k,"ss")==0){k=k-1;done=1;}
    // ied -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ied")==1){k=k-3;app=121;done=1;}
    // ed
    if(done==0 && ew(tmp,j0,k,"ed")==1){
        let cl:i32=0;
        while(j0+cl<k-2){vb[cl]=tmp[j0+cl];cl=cl+1;}
        vb[cl]=101;cl=cl+1;
        if(in_list(vb[0..cl],lex_verb())==1){k=k-2;app=101;}
        else{
            if(nc>5 && z_isvowel(tmp[k-3] as i32)==1){k=k-1;}
            else{k=k-2;}
        }
        done=1;
    }
    // ing
    if(done==0 && nc>6 && ew(tmp,j0,k,"ing")==1){
        let bl:i32=0;
        while(j0+bl<k-3){vb[bl]=tmp[j0+bl];bl=bl+1;}
        vb[bl]=101;bl=bl+1;
        if(in_list(vb[0..bl],lex_verb())==1){k=k-3;app=101;}
        else{
            let bend:i32=0;
            if(k-3>j0){bend=tmp[k-4] as i32;}
            if(k-3>j0 && bend==101){k=k-3;}
            else{
                if(k-3>j0 && z_isvowel(bend)==0){k=k-3;}
                else{k=k-3;app=101;}
            }
        }
        done=1;
    }
    // ly
    if(done==0 && nc>5 && ew(tmp,j0,k,"ly")==1){k=k-2;done=1;}
    // emit
    let o2:i32=0;
    while(j0+o2<k){out[o2]=tmp[j0+o2];o2=o2+1;}
    if(app>=0){out[o2]=app as u8;o2=o2+1;}
    return o2;
}
fn z_clauses(t:[]u8,ar:[]u8,prot:[]u8,max:i32)i32{
    let n:i32=t.len;
    // prot is a reused scratch buffer: clear this call's range (Python
    // rebuilds the protected string fresh on every call)
    let z:i32=0;
    while(z<n){prot[z]=0;z=z+1;}
    let p:i32=0;
    while(p+2<n){
        if(z_isdig(t[p] as i32)==1 && (t[p+1] as i32)==46 && z_isdig(t[p+2] as i32)==1){
            prot[p+1]=1;
            p=p+3;
        }else{p=p+1;}
    }
    let k:i32=0;
    let i:i32=0;
    let st:i32=-1;
    while(i<n && k<max){
        let b:i32=t[i] as i32;
        let sep:i32=0;
        let w:i32=1;
        if(b==46 && prot[i]==0){sep=1;}
        if(b==33 || b==63 || b==59){sep=1;}
        if(b==226 && i+2<n && (t[i+1] as i32)==128 && (t[i+2] as i32)==148){sep=1;w=3;}
        if(sep==1){
            if(st>=0){
                // keep the original spacing (Python only drops parts that
                // strip to empty); z_blank mirrors str.strip() emptiness
                if(z_blank(t[st..i])==0){
                    a_put(ar,2*k,st);
                    a_put(ar,2*k+1,i-st);
                    k=k+1;
                }
                st=-1;
            }
            i=i+w;
        }else{
            if(st<0){st=i;}
            i=i+1;
        }
    }
    if(st>=0 && k<max){
        if(z_blank(t[st..n])==0){
            a_put(ar,2*k,st);
            a_put(ar,2*k+1,n-st);
            k=k+1;
        }
    }
    return k;
}
fn z_blank(s:[]u8)i32{
    let i:i32=0;
    while(i<s.len){
        if(z_isspace(s[i] as i32)==0){return 0;}
        i=i+1;
    }
    return 1;
}
// ==================== B1 negation helpers ====================
fn neg_marker_at(clause:[]u8,tokC:[]u8,nct:i32,j:i32,tmp:[]u8)i32{
    if(j<0 || j>=nct){return 0;}
    let to:i32=a_get(tokC,2*j);
    let tl:i32=a_get(tokC,2*j+1);
    let ll:i32=lower_copy(clause[to..to+tl],tmp);
    if(in_list(tmp[0..ll],lex_neg())==0){
        if(ew(tmp[0..ll],0,ll,"n't")==1){return 1;}
        if(ll>=4 && (tmp[ll-4] as i32)==226 && (tmp[ll-3] as i32)==128 && (tmp[ll-2] as i32)==153 && (tmp[ll-1] as i32)==116){return 1;}
        return 0;
    }
    // "no longer" is its own construction (polarity-aware, handled in
    // DENY(a)); it is not predicate negation.
    if(z_eq(tmp[0..ll],"no")==1 && j+1<nct){
        let to2:i32=a_get(tokC,2*(j+1));
        let tl2:i32=a_get(tokC,2*(j+1)+1);
        let ll2:i32=lower_copy(clause[to2..to2+tl2],tmp);
        if(z_eq(tmp[0..ll2],"longer")==1){return 0;}
    }
    return 1;
}
fn has_barrier(clause:[]u8,tokC:[]u8,nct:i32,a:i32,b:i32,tmp:[]u8)i32{
    let j:i32=a+1;
    while(j<b && j<nct){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_barrier())==1){return 1;}
        j=j+1;
    }
    return 0;
}
fn find_word(clause:[]u8,tokC:[]u8,nct:i32,lit:[]u8,from:i32,tmp:[]u8)i32{
    let j:i32=from;
    while(j<nct){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],lit)==1){return j;}
        j=j+1;
    }
    return -1;
}
fn next_content(clause:[]u8,tokC:[]u8,nct:i32,j:i32,tmp:[]u8)i32{
    let k:i32=j+1;
    while(k<nct){
        let to:i32=a_get(tokC,2*k);
        let tl:i32=a_get(tokC,2*k+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_filler())==0){return k;}
        k=k+1;
    }
    return -1;
}
fn strip_eq(st:[]u8,pfx:[]u8,other:[]u8)i32{
    if(other.len==0){return 0;}
    if(st.len!=pfx.len+other.len){return 0;}
    if(z_starts(st,pfx)==0){return 0;}
    return z_eq(st[pfx.len..st.len],other);
}
fn antonym(a:[]u8,b:[]u8)i32{
    if(z_eq(a,"activ")==1 && z_eq(b,"suspend")==1){return 1;}
    if(z_eq(a,"suspend")==1 && z_eq(b,"activ")==1){return 1;}
    if(z_eq(a,"common")==1 && z_eq(b,"rare")==1){return 1;}
    if(z_eq(a,"rare")==1 && z_eq(b,"common")==1){return 1;}
    return 0;
}
fn antonym_tail(st:[]u8,cadj:[]u8)i32{
    if(cadj.len==0){return 0;}
    if(z_starts(st,"un")==1 && st.len>4){
        if(antonym(st[2..st.len],cadj)==1){return 1;}
    }
    if(z_starts(st,"in")==1 && st.len>4){
        if(antonym(st[2..st.len],cadj)==1){return 1;}
    }
    if(z_starts(st,"im")==1 && st.len>4){
        if(antonym(st[2..st.len],cadj)==1){return 1;}
    }
    if(z_starts(st,"dis")==1 && st.len>5){
        if(antonym(st[3..st.len],cadj)==1){return 1;}
    }
    return 0;
}
fn veto_idiom(clause:[]u8,tokC:[]u8,nct:i32,j:i32,tmp:[]u8,firstA:[]u8,pi:i32,stemC:[]u8,cstmC:[]u8)i32{
    let to:i32=a_get(tokC,2*j);
    let tl:i32=a_get(tokC,2*j+1);
    let ll:i32=lower_copy(clause[to..to+tl],tmp);
    let w:[]u8=tmp[0..ll];
    let is_not:i32=0;
    if(z_eq(w,"not")==1){is_not=1;}
    if(ew(w,0,ll,"n't")==1){is_not=1;}
    if(ll>=4 && (w[ll-4] as i32)==226 && (w[ll-3] as i32)==128 && (w[ll-2] as i32)==153 && (w[ll-1] as i32)==116){is_not=1;}
    let is_negw:i32=is_not;
    if(z_eq(w,"never")==1){is_negw=1;}
    let is_no:i32=0;
    if(z_eq(w,"no")==1){is_no=1;}
    let nx:i32=next_content(clause,tokC,nct,j,tmp);
    if(nx<0){return 0;}
    let no:i32=a_get(tokC,2*nx);
    let nl:i32=a_get(tokC,2*nx+1);
    let nl2:i32=lower_copy(clause[no..no+nl],tmp);
    let nw2:[]u8=tmp[0..nl2];
    if(is_not==1){
        if(z_eq(nw2,"only")==1){return 1;}
        if(z_eq(nw2,"just")==1){return 1;}
        if(z_eq(nw2,"merely")==1){return 1;}
    }
    if(is_negw==1){
        if(z_eq(nw2,"fail")==1){return 1;}
        if(z_eq(nw2,"fails")==1){return 1;}
        if(z_eq(nw2,"failed")==1){return 1;}
        if(z_eq(nw2,"failing")==1){return 1;}
        let nx2:i32=next_content(clause,tokC,nct,nx,tmp);
        if(nx2>=0){
            let mo:i32=a_get(tokC,2*nx2);
            let ml:i32=a_get(tokC,2*nx2+1);
            let ml2:i32=lower_copy(clause[mo..mo+ml],tmp);
            if(z_eq(tmp[0..ml2],"fail")==1){return 1;}
            if(z_eq(tmp[0..ml2],"fails")==1){return 1;}
            if(z_eq(tmp[0..ml2],"failed")==1){return 1;}
            if(z_eq(tmp[0..ml2],"failing")==1){return 1;}
        }
    }
    if(is_no==1){
        let so:i32=a_get(cstmC,2*nx);
        let sl:i32=a_get(cstmC,2*nx+1);
        if(z_eq(stemC[so..so+sl],firstA)==1){
            let k:i32=pi+1;
            while(k<nct){
                let ko:i32=a_get(tokC,2*k);
                let kl:i32=a_get(tokC,2*k+1);
                let kl2:i32=lower_copy(clause[ko..ko+kl],tmp);
                if(in_list(tmp[0..kl2],lex_cmp())==1){return 1;}
                k=k+1;
            }
        }
    }
    // "not X but Y <pred>": the negation scopes the pre-"but" material.
    // (The cleft "It is not <claim-subj> but <other> that <pred>" is caught
    // earlier as a deny; everything else here is a veto.)
    let b:i32=find_word(clause,tokC,nct,"but",j+1,tmp);
    if(b>j && b<pi){return 1;}
    return 0;
}
fn matrix_deny(clause:[]u8,tokC:[]u8,nct:i32,j:i32,t:i32,tmp:[]u8)i32{
    let nx:i32=next_content(clause,tokC,nct,j,tmp);
    if(nx>=0 && nx<t){
        let no:i32=a_get(tokC,2*nx);
        let nl:i32=a_get(tokC,2*nx+1);
        let nl2:i32=lower_copy(clause[no..no+nl],tmp);
        if(z_eq(tmp[0..nl2],"true")==1){return 1;}
        if(z_eq(tmp[0..nl2],"case")==1){return 1;}
    }
    let k:i32=j+1;
    while(k<t){
        let ko:i32=a_get(tokC,2*k);
        let kl:i32=a_get(tokC,2*k+1);
        let kl2:i32=lower_copy(clause[ko..ko+kl],tmp);
        if(in_list(tmp[0..kl2],lex_reporting())==1){return 1;}
        if(in_list(tmp[0..kl2],lex_cog())==1){return 1;}
        k=k+1;
    }
    return 0;
}
// ==================== B3 causal helpers ====================
fn is_negw(w:[]u8)i32{
    if(in_list(w,lex_neg())==1){return 1;}
    if(ew(w,0,w.len,"n't")==1){return 1;}
    let ll:i32=w.len;
    if(ll>=4 && (w[ll-4] as i32)==226 && (w[ll-3] as i32)==128 && (w[ll-2] as i32)==153 && (w[ll-1] as i32)==116){return 1;}
    return 0;
}
fn subj_idx(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,tmp:[]u8)i32{
    let j:i32=pi-1;
    while(j>=0){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(in_list(w,lex_filler())==1){j=j-1;continue;}
        if(is_negw(w)==1){j=j-1;continue;}
        return j;
    }
    return -1;
}
fn has_cexp(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,tmp:[]u8)i32{
    let k:i32=pi+1;
    while(k+1<nct){
        let to:i32=a_get(tokC,2*k);
        let tl:i32=a_get(tokC,2*k+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){
            let ta:i32=a_get(tokC,2*(k+1));
            let tb:i32=a_get(tokC,2*(k+1)+1);
            let lc:i32=lower_copy(clause[ta..ta+tb],tmp);
            if(z_eq(tmp[0..lc],"of")==1){return 1;}
        }
        k=k+1;
    }
    return 0;
}
fn has_word_after(clause:[]u8,tokC:[]u8,nct:i32,from:i32,span:i32,word:[]u8,tmp:[]u8)i32{
    let b:i32=from+1;
    let lim:i32=from+span;
    if(lim>=nct){lim=nct-1;}
    while(b<=lim){
        let to:i32=a_get(tokC,2*b);
        let tl:i32=a_get(tokC,2*b+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],word)==1){return 1;}
        b=b+1;
    }
    return 0;
}
fn claim_causal(claim:[]u8,tokA:[]u8,nct:i32,pred:[]u8,tmp:[]u8)i32{
    if(z_eq(pred,"cause")==1 || z_eq(pred,"lead")==1){return 1;}
    let fi:i32=0;
    while(fi<nct){
        let to:i32=a_get(tokA,2*fi);
        let tl:i32=a_get(tokA,2*fi+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){return 1;}
        if(z_eq(tmp[0..ll],"due")==1){return 1;}
        fi=fi+1;
    }
    return 0;
}
fn claim_neg(claim:[]u8,tokA:[]u8,nct:i32,pred:[]u8,outs:[]u8,tmps:[]u8,vbs:[]u8)i32{
    let pi:i32=-1;
    let i:i32=0;
    while(i<nct){
        let to:i32=a_get(tokA,2*i);
        let tl:i32=a_get(tokA,2*i+1);
        let sl:i32=z_stem(claim[to..to+tl],outs,tmps,vbs);
        if(psyn_has(outs[0..sl],pred)==1){pi=i;break;}
        i=i+1;
    }
    if(pi<0){return 0;}
    let j:i32=pi-4;
    if(j<0){j=0;}
    while(j<pi){
        let to2:i32=a_get(tokA,2*j);
        let tl2:i32=a_get(tokA,2*j+1);
        let ll:i32=lower_copy(claim[to2..to2+tl2],tmps);
        if(is_negw(tmps[0..ll])==1){return 1;}
        j=j+1;
    }
    return 0;
}
fn ant_idx(stemC:[]u8,cstmC:[]u8,nct:i32,mode:i32)i32{
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        let st:[]u8=stemC[so..so+sl];
        if(mode==0){
            if(z_eq(st,"sink")==1 || z_eq(st,"sank")==1 || z_eq(st,"sunk")==1){return i;}
        }else{
            if(z_eq(st,"float")==1){return i;}
        }
        i=i+1;
    }
    return -1;
}
fn cause_deny(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,nclm:i32,tmp:[]u8)i32{
    if(nclm<1){return 0;}
    let bi:i32=0;
    while(bi<nct){
        let to:i32=a_get(tokC,2*bi);
        let tl:i32=a_get(tokC,2*bi+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){
            // V4-R2: the negation must immediately precede "because"
            // ("not because of X"). A marker two tokens back scopes the
            // effect verb instead ("didn't spread because...",
            // "without injury because...") and must not deny.
            let hm:i32=0;
            if(bi>=1){
                let qa:i32=a_get(tokC,2*(bi-1));
                let qb:i32=a_get(tokC,2*(bi-1)+1);
                let lq:i32=lower_copy(clause[qa..qa+qb],tmp);
                if(is_negw(tmp[0..lq])==1){hm=1;}
            }
            if(hm==1){
                let p:i32=bi+1;
                while(p<=bi+5 && p<nct){
                    let so:i32=a_get(cstmC,2*p);
                    let sl:i32=a_get(cstmC,2*p+1);
                    if(in_stems(stemC[so..so+sl],stemA,cstemA,ncs)==1){return 1;}
                    p=p+1;
                }
            }
        }
        bi=bi+1;
    }
    return 0;
}
fn prevent_aff(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,firstA:[]u8,subjA:[]u8,nclm:i32,pred:[]u8,tmp:[]u8)i32{
    if(z_eq(pred,"prevent")==0){return 0;}
    // V4-R2: nclm>=1 (was >=2): the subject-anchor match after "because"
    // already establishes topicality; short-noun subjects ("dam") never
    // reach nclm=2 because len<=3 nouns are excluded from CSTEMA (CAU-P04).
    if(nclm<1){return 0;}
    let bi:i32=-1;
    let i:i32=0;
    while(i<nct){
        let to:i32=a_get(tokC,2*i);
        let tl:i32=a_get(tokC,2*i+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){bi=i;break;}
        i=i+1;
    }
    if(bi<=0){return 0;}
    let hm:i32=0;
    let j:i32=0;
    while(j<bi){
        let qa:i32=a_get(tokC,2*j);
        let qb:i32=a_get(tokC,2*j+1);
        let lq:i32=lower_copy(clause[qa..qa+qb],tmp);
        if(is_negw(tmp[0..lq])==1){hm=1;}
        j=j+1;
    }
    if(hm==0){return 0;}
    // V4-R2: anchor on the claim SUBJECT ("dam"), not firstA — firstA skips
    // short nouns ("dam" is 3 letters), so the agent match never fired.
    let anchor:[]u8=firstA;
    if(subjA.len>0){anchor=subjA;}
    if(anchor.len==0){return 0;}
    let p:i32=bi+1;
    while(p<nct){
        let so:i32=a_get(cstmC,2*p);
        let sl:i32=a_get(cstmC,2*p+1);
        if(z_eq(stemC[so..so+sl],anchor)==1){return 1;}
        p=p+1;
    }
    return 0;
}
fn postpi_deny(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,nclm:i32,cneg:i32,cauflag:i32,subjA:[]u8,sstemb:[]u8,sstmc:[]u8,nsst:i32,tmp:[]u8)i32{
    if(cneg!=0 || cauflag!=1 || nclm<1){return 0;}
    let m:i32=pi+1;
    while(m<nct){
        let to:i32=a_get(tokC,2*m);
        let tl:i32=a_get(tokC,2*m+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(is_negw(tmp[0..ll])==1){break;}
        m=m+1;
    }
    if(m>=nct){return 0;}
    if(has_word_after(clause,tokC,nct,m,4,"but",tmp)==1){return 0;}
    let p:i32=m+1;
    while(p<=m+2 && p<nct){
        let so:i32=a_get(cstmC,2*p);
        let sl:i32=a_get(cstmC,2*p+1);
        let w:[]u8=stemC[so..so+sl];
        // V4-R2: the "not X" noun can be a short claim noun ("not fog") or
        // the claim subject ("not the dam") — both absent from CSTEMA.
        let hit:i32=in_stems(w,stemA,cstemA,ncs);
        if(hit==0){hit=in_stems(w,sstemb,sstmc,nsst);}
        if(hit==0 && subjA.len>0 && z_eq(w,subjA)==1){hit=1;}
        if(hit==1){
            if(p==nct-1){return 1;}
            if(has_word_after(clause,tokC,nct,p,2,"but",tmp)==1){return 1;}
        }
        p=p+1;
    }
    return 0;
}
fn causal_verb(claim:[]u8,tokA:[]u8,nct:i32,cvb:[]u8,tmp:[]u8,outs:[]u8,vbs:[]u8)i32{
    let b:i32=-1;
    let i:i32=0;
    while(i<nct){
        let to:i32=a_get(tokA,2*i);
        let tl:i32=a_get(tokA,2*i+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1 || z_eq(tmp[0..ll],"due")==1){b=i;break;}
        i=i+1;
    }
    if(b<0){return 0;}
    i=b+1;
    while(i<nct){
        let to2:i32=a_get(tokA,2*i);
        let tl2:i32=a_get(tokA,2*i+1);
        let sl:i32=z_stem(claim[to2..to2+tl2],outs,tmp,vbs);
        let st:[]u8=outs[0..sl];
        if(in_list(st,lex_verb())==1 && in_list(st,lex_reporting())==0){
            let q:i32=0;
            while(q<sl){cvb[q]=st[q];q=q+1;}
            return sl;
        }
        i=i+1;
    }
    return 0;
}
fn mech_aff(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,subjA:[]u8,cv:[]u8,nclm:i32,need:i32,cneg:i32,cauflag:i32,framed:i32,tmp:[]u8)i32{
    if(cneg!=0){return 0;}
    if(cauflag!=1){return 0;}
    if(cv.len==0){return 0;}
    if(framed!=0){return 0;}
    if(nclm<need){return 0;}
    if(subjA.len==0){return 0;}
    if(in_stems(subjA,stemC,cstmC,nct)==0){return 0;}
    if(is_interrog(clause,tokC,nct,tmp)==1){return 0;}
    let kv:i32=-1;
    let k:i32=0;
    while(k<nct){
        let so:i32=a_get(cstmC,2*k);
        let sl:i32=a_get(cstmC,2*k+1);
        if(z_eq(stemC[so..so+sl],cv)==1){kv=k;break;}
        k=k+1;
    }
    if(kv<0){return 0;}
    let j:i32=kv-3;
    if(j<0){j=0;}
    while(j<kv){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(is_negw(tmp[0..ll])==1){return 0;}
        j=j+1;
    }
    return 1;
}
fn opp_outcome_deny(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,nclm:i32,cauflag:i32,tmp:[]u8)i32{
    if(cauflag!=1 || nclm<1){return 0;}
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        if(in_list(stemC[so..so+sl],lex_worse())==1){
            // adjacent token must be a claim noun (the worsened outcome)
            let adj:i32=0;
            let k:i32=i-1;
            if(k<0){k=0;}
            while(k<=i+1 && k<nct){
                if(k!=i){
                    let so2:i32=a_get(cstmC,2*k);
                    let sl2:i32=a_get(cstmC,2*k+1);
                    if(in_stems(stemC[so2..so2+sl2],stemA,cstemA,ncs)==1){adj=1;break;}
                }
                k=k+1;
            }
            if(adj==1){
                // causal marker within 3 tokens after the worse-verb
                let m:i32=i+1;
                while(m<=i+3 && m<nct){
                    let to:i32=a_get(tokC,2*m);
                    let tl:i32=a_get(tokC,2*m+1);
                    let ll:i32=lower_copy(clause[to..to+tl],tmp);
                    if(z_eq(tmp[0..ll],"because")==1){return 1;}
                    if(z_eq(tmp[0..ll],"due")==1){return 1;}
                    m=m+1;
                }
            }
        }
        i=i+1;
    }
    return 0;
}
fn ant_pol(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,need:i32,nclm:i32,framed:i32,cneg:i32,firstA:[]u8,subjA:[]u8,pred:[]u8,cadj:[]u8,tmp:[]u8)i32{
    if(nclm<1){return 0;}
    let ai:i32=-1;
    if(in_stems("float",stemA,cstemA,ncs)==1){ai=ant_idx(stemC,cstmC,nct,0);}
    if(ai<0 && in_stems("sink",stemA,cstemA,ncs)==1){ai=ant_idx(stemC,cstmC,nct,1);}
    if(ai<0){return 0;}
    if(is_interrog(clause,tokC,nct,tmp)==1){return 0;}
    let aneg:i32=neg_scope(clause,tokC,nct,ai,stemC,cstmC,stemA,cstemA,ncs,firstA,subjA,pred,cadj,tmp);
    if(cneg==aneg){return 1;}
    if(nclm>=need && framed==0){return 2;}
    return 0;
}
// ==================== B2 numeric guard ====================
fn wnum(w:[]u8)i32{
    if(z_eq(w,"one")==1){return 1;}
    if(z_eq(w,"two")==1){return 2;}
    if(z_eq(w,"three")==1){return 3;}
    if(z_eq(w,"four")==1){return 4;}
    if(z_eq(w,"five")==1){return 5;}
    if(z_eq(w,"six")==1){return 6;}
    if(z_eq(w,"seven")==1){return 7;}
    if(z_eq(w,"eight")==1){return 8;}
    if(z_eq(w,"nine")==1){return 9;}
    if(z_eq(w,"ten")==1){return 10;}
    if(z_eq(w,"eleven")==1){return 11;}
    if(z_eq(w,"twelve")==1){return 12;}
    if(z_eq(w,"thirteen")==1){return 13;}
    if(z_eq(w,"fourteen")==1){return 14;}
    if(z_eq(w,"fifteen")==1){return 15;}
    if(z_eq(w,"sixteen")==1){return 16;}
    if(z_eq(w,"seventeen")==1){return 17;}
    if(z_eq(w,"eighteen")==1){return 18;}
    if(z_eq(w,"nineteen")==1){return 19;}
    if(z_eq(w,"twenty")==1){return 20;}
    if(z_eq(w,"thirty")==1){return 30;}
    return 0;
}
fn umul(w:[]u8)i64{
    if(z_eq(w,"second")==1){return 1;}
    if(z_eq(w,"seconds")==1){return 1;}
    if(z_eq(w,"minute")==1){return 60;}
    if(z_eq(w,"minutes")==1){return 60;}
    if(z_eq(w,"hour")==1){return 3600;}
    if(z_eq(w,"hours")==1){return 3600;}
    if(z_eq(w,"day")==1){return 86400;}
    if(z_eq(w,"days")==1){return 86400;}
    if(z_eq(w,"month")==1){return 2592000;}
    if(z_eq(w,"months")==1){return 2592000;}
    if(z_eq(w,"year")==1){return 31536000;}
    if(z_eq(w,"years")==1){return 31536000;}
    return 0;
}
fn is_demo(w:[]u8)i32{
    if(z_eq(w,"this")==1){return 1;}
    if(z_eq(w,"that")==1){return 1;}
    if(z_eq(w,"these")==1){return 1;}
    if(z_eq(w,"those")==1){return 1;}
    if(z_eq(w,"each")==1){return 1;}
    if(z_eq(w,"every")==1){return 1;}
    if(z_eq(w,"any")==1){return 1;}
    return 0;
}
fn sp_grp(t:[]u8,q:i32,ll:i32)i32{
    if(q+4>ll){return 0;}
    if(z_isdig(t[q+1] as i32)==0){return 0;}
    if(z_isdig(t[q+2] as i32)==0){return 0;}
    if(z_isdig(t[q+3] as i32)==0){return 0;}
    if(q+4<ll && z_isdig(t[q+4] as i32)==1){return 0;}
    return 1;
}
fn is_capb(t:[]u8,s:i32)i32{
    if(s<0 || s>=t.len){return 0;}
    let c:i32=t[s] as i32;
    if(c>=65 && c<=90){return 1;}
    return 0;
}
fn is_alphab(c:i32)i32{
    if(c>=65 && c<=90){return 1;}
    if(c>=97 && c<=122){return 1;}
    return 0;
}
fn prevw_start(t:[]u8,p:i32)i32{
    let j:i32=p-1;
    while(j>=0 && is_alphab(t[j] as i32)==0){j=j-1;}
    if(j<0){return -1;}
    while(j>=0 && is_alphab(t[j] as i32)==1){j=j-1;}
    return j+1;
}
fn prevw_cap(t:[]u8,p:i32)i32{
    let s:i32=prevw_start(t,p);
    if(s<0){return 0;}
    return is_capb(t,s);
}
fn prev2w_cap(t:[]u8,p:i32)i32{
    let s1:i32=prevw_start(t,p);
    if(s1<0){return 0;}
    if(is_capb(t,s1)==0){return 0;}
    let s2:i32=prevw_start(t,s1);
    if(s2<0){return 0;}
    return is_capb(t,s2);
}
fn nextw_cap(t:[]u8,q:i32,ll:i32)i32{
    let j:i32=q;
    while(j<ll && is_alphab(t[j] as i32)==0){j=j+1;}
    if(j>=ll){return 0;}
    return is_capb(t,j);
}
fn tok_bits(t:[]u8,p:i32,q:i32,ll:i32)i32{
    let ts:i32=p;
    while(ts>0 && z_isspace(t[ts-1] as i32)==0){ts=ts-1;}
    let te:i32=q;
    while(te<ll && z_isspace(t[te] as i32)==0){te=te+1;}
    let bits:i32=0;
    let sl:i32=0;
    let i:i32=ts;
    while(i<te){
        let c:i32=t[i] as i32;
        if(is_alphab(c)==1 && (i<p || i>=q)){bits=bits|1;}
        if(c==47){sl=sl+1;}
        if(c==46){bits=bits|4;}
        i=i+1;
    }
    if(sl>=1){bits=bits|2;}
    if(sl>=2){bits=bits|8;}
    return bits;
}
fn match_at(s:[]u8,i:i32,w:[]u8)i32{
    let k:i32=0;
    while(k<w.len){
        if((s[i+k] as i32)!=(w[k] as i32)){return 0;}
        k=k+1;
    }
    if(i>0){
        let c0:i32=s[i-1] as i32;
        if(c0>=97 && c0<=122){return 0;}
    }
    let e:i32=i+w.len;
    if(e<s.len){
        let c1:i32=s[e] as i32;
        if(c1>=97 && c1<=122){return 0;}
    }
    return 1;
}
fn has_word_in(s:[]u8,a:i32,b:i32,w:[]u8)i32{
    let i:i32=a;
    while(i+w.len<=b){
        if(match_at(s,i,w)==1){return 1;}
        i=i+1;
    }
    return 0;
}
fn nearest_dist(s:[]u8,a:i32,b:i32,w:[]u8,pos:i32)i32{
    let best:i32=99999;
    let i:i32=a;
    while(i+w.len<=b){
        if(match_at(s,i,w)==1){
            let d:i32=i-pos;
            if(d<0){d=0-d;}
            if(d<best){best=d;}
            i=i+w.len;
        }else{i=i+1;}
    }
    return best;
}
fn phenom_words_in(s:[]u8,a:i32,b:i32,which:i32)i32{
    if(which==1){
        if(has_word_in(s,a,b,"boil")==1){return 1;}

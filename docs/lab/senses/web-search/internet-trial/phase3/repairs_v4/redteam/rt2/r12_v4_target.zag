        d=nearest_dist(s,a,b,"people",pos);if(d<best){best=d;}
        d=nearest_dist(s,a,b,"person",pos);if(d<best){best=d;}
        return best;
    }
    d=nearest_dist(s,a,b,"fly",pos);if(d<best){best=d;}

fn z_alloc(n:i32)[]u8{
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn a_get(b:[]u8,i:i32)i32{
    let o:i32=i<<2;
    let v:i32=(b[o] as i32) & 255;
    v=v | (((b[o+1] as i32) & 255)<<8);
    v=v | (((b[o+2] as i32) & 255)<<16);
    v=v | (((b[o+3] as i32) & 255)<<24);
    return v;
}
fn a_put(b:[]u8,i:i32,v:i32)void{
    let o:i32=i<<2;
    b[o]=(v & 255) as u8;
    b[o+1]=((v>>8) & 255) as u8;
    b[o+2]=((v>>16) & 255) as u8;
    b[o+3]=((v>>24) & 255) as u8;
    return;
}
fn is_wc(s:[]u8,i:i32)i32{
    if(i>=s.len){return 0;}
    let b:i32=s[i] as i32;
    if(b>=65 && b<=90){return 1;}
    if(b>=97 && b<=122){return 1;}
    if(b>=48 && b<=57){return 1;}
    if(b==39){return 1;}
    if(b==226 && i+2<s.len){
        if((s[i+1] as i32)==128 && (s[i+2] as i32)==153){return 3;}
    }
    return 0;
}
fn z_toks(t:[]u8,ar:[]u8,max:i32)i32{
    let n:i32=t.len;
    let i:i32=0;
    let k:i32=0;
    while(i<n && k<max){
        let l:i32=is_wc(t,i);
        if(l==0){i=i+1;}
        else{
            let st:i32=i;
            while(l>0){
                i=i+l;
                if(i<n && (t[i] as i32)==45){
                    let l2:i32=is_wc(t,i+1);
                    if(l2>0){i=i+1;l=l2;continue;}
                }
                l=is_wc(t,i);
            }
            a_put(ar,2*k,st);
            a_put(ar,2*k+1,i-st);
            k=k+1;
        }
    }
    return k;
}
fn z_cplen_range(s:[]u8,a:i32,b:i32)i32{
    let n:i32=0;
    let i:i32=a;
    while(i<b){
        let by:i32=s[i] as i32;
        if(by<128 || by>=192){n=n+1;}
        i=i+1;
    }
    return n;
}
fn ew(s:[]u8,a:i32,b:i32,lit:[]u8)i32{
    if(lit.len>b-a){return 0;}
    let k:i32=0;
    while(k<lit.len){
        if((s[b-lit.len+k] as i32)!=(lit[k] as i32)){return 0;}
        k=k+1;
    }
    return 1;
}
fn in_list(w:[]u8,blob:[]u8)i32{
    let i:i32=0;
    while(i<blob.len){
        if((blob[i] as i32)==10){
            let k:i32=0;
            while(k<w.len && i+1+k<blob.len && blob[i+1+k]==w[k]){k=k+1;}
            if(k==w.len && i+1+k<blob.len && (blob[i+1+k] as i32)==10){return 1;}
        }
        i=i+1;
    }
    return 0;
}
fn z_isvowel(b:i32)i32{
    if(b==97 || b==101 || b==105 || b==111 || b==117){return 1;}
    return 0;
}
fn lex_verb()[]u8{
    return "\nam\nare\nate\nbe\nbeen\nbeing\nblock\nblocks\nboil\nboils\nbreak\nbreaks\nbuild\nbuilds\ncan\ncause\ncaused\ncauses\nclear\nclears\ncollapse\ncollapsed\ncollapses\ncollapsing\nconfirm\nconfirmed\nconfirms\nconnect\nconnects\ncontain\ncontains\ncorrupt\ncorrupted\ncorrupting\ncorrupts\ncould\ncrash\ncrashed\ncrashes\ncrashing\ncure\ncured\ncures\ndehydrate\ndehydrated\ndehydrates\ndehydrating\ndemonstrate\ndemonstrates\ndid\ndisrupt\ndisrupts\ndissolve\ndissolved\ndissolves\ndo\ndoes\ndrank\ndrink\ndrinking\ndrinks\neat\neating\neats\nexpand\nfake\nfaked\nfakes\nfall\nfalls\nfind\nfinds\nfloat\nflow\nflows\nform\nforms\nfound\nfreez\nfreeze\nfroze\nfrozen\ngave\ngive\ngiven\ngives\ngiving\ngrow\ngrows\nhad\nhappen\nhas\nhave\nheal\nheals\nhit\nhits\nimprove\nimproves\nincrease\nincreases\nis\nlaid\nlay\nlaying\nlays\nlead\nleads\nleak\nleaked\nlink\nlinks\nlower\nlowers\nmade\nmake\nmakes\nmay\nmelt\nmight\nmust\noccur\norbit\norbits\noriginate\noriginated\noriginates\nprevent\nprevents\nproduce\nproduces\nprove\nproved\nproves\nraise\nraises\nreduce\nreduces\nremedy\nresult\nrevolve\nrevolves\nrise\nrises\nsaid\nsank\nsave\nsaved\nsaves\nsaving\nsay\nsays\nscatter\nscattered\nscattering\nscatters\nsee\nsees\nshall\nshould\nshow\nshowed\nshown\nshows\nsink\nsnap\nsnapped\nsnapping\nsnaps\nspread\nspreads\nstate\nstated\nstates\nstop\nstops\nstrike\nstrikes\nstruck\nsunk\ntake\ntakes\ntie\nties\ntilt\ntilted\ntilting\ntilts\ntook\ntransmit\ntransmits\ntreat\ntreated\ntreats\ntrigger\ntriggers\nuse\nused\nuses\nvisible\nwas\nwere\nwill\nworsen\nworsens\nwould\n";
}
fn z_stem(t:[]u8,out:[]u8,tmp:[]u8,vb:[]u8)i32{
    let n:i32=t.len;
    // 1. lowercase (ASCII + Latin-1 C3 80-9E)
    let i:i32=0;
    let k:i32=0;
    while(i<n){
        let b:i32=t[i] as i32;
        if(b>=65 && b<=90){tmp[k]=(b+32) as u8;k=k+1;i=i+1;}
        else{
            if(b==195 && i+1<n){
                let b2:i32=t[i+1] as i32;
                if(b2>=128 && b2<=158 && b2!=151){
                    tmp[k]=195 as u8;tmp[k+1]=(b2+32) as u8;k=k+2;i=i+2;
                }else{tmp[k]=b as u8;k=k+1;i=i+1;}
            }else{tmp[k]=b as u8;k=k+1;i=i+1;}
        }
    }
    // 2. possessive 's
    if(k>=2 && (tmp[k-2] as i32)==39 && (tmp[k-1] as i32)==115){k=k-2;}
    // 3. strip ASCII quotes
    while(k>0 && (tmp[k-1] as i32)==39){k=k-1;}
    let j0:i32=0;
    while(j0<k && (tmp[j0] as i32)==39){j0=j0+1;}
    // 4. short guard (char count, like Python len())
    let nc:i32=z_cplen_range(tmp,j0,k);
    if(nc<=3){
        let o:i32=0;
        while(j0+o<k){out[o]=tmp[j0+o];o=o+1;}
        return o;
    }
    let app:i32=-1;
    let done:i32=0;
    // ies -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ies")==1){k=k-3;app=121;done=1;}
    // sses/xes/zes/ches/shes -> strip 2
    if(done==0 && nc>5){
        if(ew(tmp,j0,k,"sses")==1 || ew(tmp,j0,k,"xes")==1 || ew(tmp,j0,k,"zes")==1 || ew(tmp,j0,k,"ches")==1 || ew(tmp,j0,k,"shes")==1){
            k=k-2;done=1;
        }
    }
    // es -> strip 1
    if(done==0 && ew(tmp,j0,k,"es")==1){k=k-1;done=1;}
    // s (not ss) -> strip 1
    if(done==0 && ew(tmp,j0,k,"s")==1 && ew(tmp,j0,k,"ss")==0){k=k-1;done=1;}
    // ied -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ied")==1){k=k-3;app=121;done=1;}
    // ed
    if(done==0 && ew(tmp,j0,k,"ed")==1){
        let cl:i32=0;
        while(j0+cl<k-2){vb[cl]=tmp[j0+cl];cl=cl+1;}
        vb[cl]=101;cl=cl+1;
        if(in_list(vb[0..cl],lex_verb())==1){k=k-2;app=101;}
        else{
            if(nc>5 && z_isvowel(tmp[k-3] as i32)==1){k=k-1;}
            else{k=k-2;}
        }
        done=1;
    }
    // ing
    if(done==0 && nc>6 && ew(tmp,j0,k,"ing")==1){
        let bl:i32=0;
        while(j0+bl<k-3){vb[bl]=tmp[j0+bl];bl=bl+1;}
        vb[bl]=101;bl=bl+1;
        if(in_list(vb[0..bl],lex_verb())==1){k=k-3;app=101;}
        else{
            let bend:i32=0;
            if(k-3>j0){bend=tmp[k-4] as i32;}
            if(k-3>j0 && bend==101){k=k-3;}
            else{
                if(k-3>j0 && z_isvowel(bend)==0){k=k-3;}
                else{k=k-3;app=101;}
            }
        }
        done=1;
    }
    // ly
    if(done==0 && nc>5 && ew(tmp,j0,k,"ly")==1){k=k-2;done=1;}
    // emit
    let o2:i32=0;
    while(j0+o2<k){out[o2]=tmp[j0+o2];o2=o2+1;}
    if(app>=0){out[o2]=app as u8;o2=o2+1;}
    return o2;
}

fn main()i32{
    let tmp:[]u8=z_alloc(64);
    let out:[]u8=z_alloc(32);
    let vb:[]u8=z_alloc(64);
    let words:[]u8="helpful helps helping helped unreliable reliable ineffective effective unhelpful fly flies";
    let ar:[]u8=z_alloc(512);
    let n:i32=z_toks(words,ar,32);
    let j:i32=0;
    while(j<n){
        let o:i32=a_get(ar,2*j);
        let l:i32=a_get(ar,2*j+1);
        let sl:i32=z_stem(words[o..o+l],out,tmp,vb);
        _zag_print(words[o..o+l]);
        _zag_print(" -> ");
        _zag_print(out[0..sl]);
        _zag_print("\n");
        j=j+1;
    }
    return 0;
}

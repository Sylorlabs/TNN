// r12.zag -- R1/R2 repaired stance classifier, pure Zag.
//
// Ports tools/proto_r12.py EXACTLY (byte-identical tags on the frozen
// course). Frozen prereg: phase3/PREREG.md (commit 266ca4e18593de287a86daaf107cb36680577657).
//
// R1 (M1b): no fallthrough-to-AFFIRM. AFFIRM requires positive endorsement
//   evidence (predicate-level assertion of the claim's proposition,
//   negation-scoped). Default NEUTRAL. Topic overlap != endorsement.
// R2 (M1a): negation-aware stance. UTF-8 negation lexicon (curly quotes
//   etc.), clause-scoped negation; no 100-char proximity blast.
//
// Interface: argv[1] = TSV file with lines  idx \t claim \t title \t snippet
// Output per line:  idx SP tag SP reason \n
//   tag: 0=IRRELEVANT/NEUTRAL, 1=AFFIRM, 2=DENY
//   reason: gate | deny-lex | antonym | neg-scope | competing-subject
//           | endorse | neutral
//
// Deterministic, zero RNG, pure Zag. Compiled with the pinned toolchain:
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1
//
// znc gotchas honored (see ~/AGENTS.md): no `as []i32` indexed tables
// (u8 arenas + LE helpers instead), no slice ==, no argc gate, all slices
// far below the 2^25 limit, no deep else-nesting, no large-struct tricks.

// ==================== memory ====================
fn z_alloc(n:i32)[]u8{
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8)void{
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}
fn z_cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4194304){return "";}
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    return b;
}

// ==================== file input ====================
fn read_all(path:[]u8)[]u8{
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let cap:i32=8388608;
    let buf:[]u8=z_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}

// ==================== byte utils ====================
fn z_eq(a:[]u8,b:[]u8)i32{
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn z_has(h:[]u8,n:[]u8)i32{
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len){if(h[i+k]!=n[k]){break;}k=k+1;}
        if(k==n.len){return 1;}
        i=i+1;
    }
    return 0;
}
fn z_starts(h:[]u8,n:[]u8)i32{
    if(n.len>h.len){return 0;}
    let k:i32=0;
    while(k<n.len){if(h[k]!=n[k]){return 0;}k=k+1;}
    return 1;
}
// UTF-8 code point count (ASCII + lead bytes only)
fn z_cplen(s:[]u8)i32{
    return z_cplen_range(s,0,s.len);
}
fn z_cplen_range(s:[]u8,a:i32,b:i32)i32{
    let n:i32=0;
    let i:i32=a;
    while(i<b){
        let by:i32=s[i] as i32;
        if(by<128 || by>=192){n=n+1;}
        i=i+1;
    }
    return n;
}
// Python str[0].isupper() approximation: ASCII A-Z + Latin-1 C0-DE (not D7)
fn z_isupper1(s:[]u8)i32{
    if(s.len==0){return 0;}
    let b0:i32=s[0] as i32;
    if(b0>=65 && b0<=90){return 1;}
    if(b0==195 && s.len>=2){
        let b1:i32=s[1] as i32;
        if(b1>=128 && b1<=158 && b1!=151){return 1;}
    }
    return 0;
}
fn z_isdig(b:i32)i32{
    if(b>=48 && b<=57){return 1;}
    return 0;
}
fn z_isvowel(b:i32)i32{
    if(b==97 || b==101 || b==105 || b==111 || b==117){return 1;}
    return 0;
}
fn z_isspace(b:i32)i32{
    if(b==32 || b==9 || b==10 || b==13 || b==11 || b==12){return 1;}
    return 0;
}
// LE int arena accessors (never `as []i32`; see ZNC-2026-09-21-007)
fn a_put(b:[]u8,i:i32,v:i32)void{
    let o:i32=i<<2;
    b[o]=(v & 255) as u8;
    b[o+1]=((v>>8) & 255) as u8;
    b[o+2]=((v>>16) & 255) as u8;
    b[o+3]=((v>>24) & 255) as u8;
    return;
}
fn a_get(b:[]u8,i:i32)i32{
    let o:i32=i<<2;
    let v:i32=(b[o] as i32) & 255;
    v=v | (((b[o+1] as i32) & 255)<<8);
    v=v | (((b[o+2] as i32) & 255)<<16);
    v=v | (((b[o+3] as i32) & 255)<<24);
    return v;
}
// ASCII lowercase copy (+ Latin-1 C3 80-9E); returns length
fn lower_copy(t:[]u8,out:[]u8)i32{
    let n:i32=t.len;
    let i:i32=0;
    let k:i32=0;
    while(i<n){
        let b:i32=t[i] as i32;
        if(b>=65 && b<=90){out[k]=(b+32) as u8;k=k+1;i=i+1;}
        else{
            if(b==195 && i+1<n){
                let b2:i32=t[i+1] as i32;
                if(b2>=128 && b2<=158 && b2!=151){
                    out[k]=195 as u8;out[k+1]=(b2+32) as u8;k=k+2;i=i+2;
                }else{out[k]=b as u8;k=k+1;i=i+1;}
            }else{out[k]=b as u8;k=k+1;i=i+1;}
        }
    }
    return k;
}
// tail match: s[b-lit.len .. b) == lit
fn ew(s:[]u8,a:i32,b:i32,lit:[]u8)i32{
    if(lit.len>b-a){return 0;}
    let k:i32=0;
    while(k<lit.len){
        if((s[b-lit.len+k] as i32)!=(lit[k] as i32)){return 0;}
        k=k+1;
    }
    return 1;
}
fn in_stems(s:[]u8,base:[]u8,ar:[]u8,n:i32)i32{
    let i:i32=0;
    while(i<n){
        let so:i32=a_get(ar,2*i);
        let sl:i32=a_get(ar,2*i+1);
        if(z_eq(s,base[so..so+sl])==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ==================== lexicons ====================
// Blobs are \n-separated with leading + trailing \n; in_list does
// boundary-exact matching. Contents transcribed from the frozen prototype
// (tools/proto_r12.py); verified mechanically by tools/lexcheck (see R12_PORT.md).
fn lex_stop()[]u8{
    return "\na\nabout\nabove\nafter\nagain\nam\nan\nand\nare\naren\nas\nat\nbe\nbeen\nbefore\nbeing\nbelow\nbut\nby\ncan\ncould\ncouldn\nd\ndid\ndidn\ndo\ndoes\ndoesn\ndoing\ndon\ndown\nduring\nelse\nfor\nfrom\nfurther\nhad\nhadn\nhas\nhasn\nhave\nhaven\nhaving\nhe\nher\nhere\nhim\nhis\ni\nif\nin\ninto\nis\nisn\nit\nits\njust\nll\nmay\nme\nmight\nmightn\nmust\nmustn\nmy\nno\nnor\nnot\nnow\nof\noff\non\nonce\nonly\nor\nought\nour\nout\nover\nown\nre\ns\nsame\nshall\nshan\nshe\nshould\nshouldn\nso\nt\nthan\nthat\nthe\ntheir\nthem\nthen\nthere\nthese\nthey\nthis\nthose\nthrough\nto\ntoo\nunder\nup\nve\nvery\nwas\nwasn\nwe\nwere\nweren\nwhat\nwhen\nwhere\nwhich\nwho\nwhom\nwill\nwith\nwon\nwould\nwouldn\nyou\nyour\n";
}
fn lex_verb()[]u8{
    return "\nam\nare\nate\nbe\nbeen\nbeing\nblock\nblocks\nboil\nboils\nbreak\nbreaks\nbuild\nbuilds\ncan\ncause\ncaused\ncauses\nclear\nclears\nconfirm\nconfirmed\nconfirms\nconnect\nconnects\ncontain\ncontains\ncould\ncure\ncured\ncures\ndemonstrate\ndemonstrates\ndid\ndisrupt\ndisrupts\ndissolve\ndissolved\ndissolves\ndo\ndoes\ndrank\ndrink\ndrinking\ndrinks\neat\neating\neats\nfake\nfaked\nfakes\nfall\nfalls\nfind\nfinds\nflow\nflows\nform\nforms\nfound\ngrow\ngrows\nhad\nhas\nhave\nheal\nheals\nhit\nhits\nimprove\nimproves\nincrease\nincreases\nis\nlead\nleads\nleak\nleaked\nlink\nlinks\nlower\nlowers\nmade\nmake\nmakes\nmay\nmight\nmust\norbit\norbits\noriginate\noriginated\noriginates\nprevent\nprevents\nproduce\nproduces\nprove\nproved\nproves\nraise\nraises\nreduce\nreduces\nremedy\nrevolve\nrevolves\nrise\nrises\nsaid\nsay\nsays\nsee\nsees\nshall\nshould\nshow\nshowed\nshown\nshows\nspread\nspreads\nstate\nstated\nstates\nstop\nstops\nstrike\nstrikes\nstruck\ntake\ntakes\ntie\nties\ntook\ntransmit\ntransmits\ntreat\ntreated\ntreats\ntrigger\ntriggers\nuse\nused\nuses\nvisible\nwas\nwere\nwill\nworsen\nworsens\nwould\n";
}
fn lex_reporting()[]u8{
    return "\nargue\nargues\nbelieve\nbelieves\nclaim\nclaimed\nclaims\nreport\nreported\nreports\nsaid\nsay\nsays\nshow\nshowed\nshown\nshows\nstate\nstates\nsuggest\nsuggests\nthink\nthinks\n";
}
fn lex_neg()[]u8{
    return "\nbarely\nhardly\nneither\nnever\nno\nnone\nnor\nnot\nnothing\nscarcely\nwithout\n";
}
fn lex_strong()[]u8{
    return "\ncontrary\ndebunk\ndenied\ndenies\ndisproven\nfake\nfaked\nfalse\nhoax\nincorrect\nmyth\nrefuted\nwrong\n";
}
fn lex_weak()[]u8{
    return "\nalthough\ndespite\nhowever\nthough\nunlikely\n";
}
fn lex_super()[]u8{
    return "\nbest\nbiggest\nfirst\nhighest\nlargest\nleast\nlongest\nmost\nonly\nsmallest\ntallest\nworst\n";
}
fn lex_conjskip()[]u8{
    return "\nalso\nalthough\nand\nbecause\nbut\ndespite\neven\nfor\nhence\nhowever\nif\njust\nnor\nor\nsince\nso\nstill\nthen\nthough\nthus\nwhen\nwhere\nwhile\nyet\n";
}
fn lex_whaux()[]u8{
    return "\nare\ncan\ncould\ndid\ndo\ndoes\nhow\nis\nshould\nwas\nwere\nwhat\nwhen\nwhere\nwhich\nwho\nwhom\nwhy\nwill\nwould\n";
}
fn lex_filler()[]u8{
    return "\na\nan\nand\nas\nat\nbut\nby\nfor\nfrom\nin\nof\non\nor\nthe\nto\nwith\n";
}
fn lex_be()[]u8{
    return "\nis\nare\nwas\nwere\nam\nbe\nbeen\nbeing\n";
}
fn lex_have()[]u8{
    return "\nhas\nhave\nhad\n";
}
fn in_list(w:[]u8,blob:[]u8)i32{
    let i:i32=0;
    while(i<blob.len){
        if((blob[i] as i32)==10){
            let k:i32=0;
            while(k<w.len && i+1+k<blob.len && blob[i+1+k]==w[k]){k=k+1;}
            if(k==w.len && i+1+k<blob.len && (blob[i+1+k] as i32)==10){return 1;}
        }
        i=i+1;
    }
    return 0;
}
// ---- B4-HEDGE: hedge lexicon (raw lowercased word match). Hedged
// endorsement ("may/might/could/suggests/...") must not AFFIRM; hedged
// denial ("may not ...") must not DENY (oracle NEUTRAL for both).
fn lex_hedge()[]u8{
    return "\nappear\nappears\nbelieve\nbelieved\nbelieves\nbelieving\ncould\nlikely\nmay\nmaybe\nmight\nperhaps\npossibly\nprobably\nseem\nseems\nsuggest\nsuggested\nsuggests\nthought\n";
}
// raw-token equality after lowercasing (tmp = scratch >= token len)
fn tok_is(t:[]u8,ar:[]u8,idx:i32,lit:[]u8,tmp:[]u8)i32{
    let to:i32=a_get(ar,2*idx);
    let tl:i32=a_get(ar,2*idx+1);
    let ll:i32=lower_copy(t[to..to+tl],tmp);
    return z_eq(tmp[0..ll],lit);
}
// ---- B4-QUANT: quantifier codes. 1=all/every/each, 2=most, 3=many,
// 4=some/several, 5=one, 6=few, 7=no/none/neither, 0=bare/other.
fn quant_code(w:[]u8)i32{
    if(z_eq(w,"all")==1){return 1;}
    if(z_eq(w,"every")==1){return 1;}
    if(z_eq(w,"each")==1){return 1;}
    if(z_eq(w,"most")==1){return 2;}
    if(z_eq(w,"many")==1){return 3;}
    if(z_eq(w,"some")==1){return 4;}
    if(z_eq(w,"several")==1){return 4;}
    if(z_eq(w,"one")==1){return 5;}
    if(z_eq(w,"few")==1){return 6;}
    if(z_eq(w,"no")==1){return 7;}
    if(z_eq(w,"none")==1){return 7;}
    if(z_eq(w,"neither")==1){return 7;}
    return 0;
}
// prefix match with a 4-char minimum on the shorter side ("smoker"~"smoke")
fn prefix_match(a:[]u8,b:[]u8)i32{
    let m:i32=a.len;
    if(b.len<m){m=b.len;}
    if(m<4){return 0;}
    let k:i32=0;
    while(k<m){
        if((a[k] as i32)!=(b[k] as i32)){return 0;}
        k=k+1;
    }
    return 1;
}
// ---- B4-COND: stem set of a clause's tokens in [rlo,rhi) minus [elo,ehi),
// skipping stopwords. Writes bytes to sb (cap sbcap), (off,len) to star.
// tokar = 128x8 token scratch. Returns stem count (<=max).
fn stemset(t:[]u8,co:i32,cl:i32,rlo:i32,rhi:i32,elo:i32,ehi:i32,tokar:[]u8,star:[]u8,sb:[]u8,sbcap:i32,max:i32,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let txt:[]u8=t[co..co+cl];
    let nt:i32=z_toks(txt,tokar,128);
    let n2:i32=0;
    let soff:i32=0;
    let j:i32=0;
    while(j<nt && n2<max){
        if(j<rlo || j>=rhi){j=j+1;continue;}
        if(j>=elo && j<ehi){j=j+1;continue;}
        let to:i32=a_get(tokar,2*j);
        let tl:i32=a_get(tokar,2*j+1);
        let ll:i32=lower_copy(txt[to..to+tl],tmp);
        if(ll==0){j=j+1;continue;}
        if(in_list(tmp[0..ll],lex_stop())==1){j=j+1;continue;}
        let sl:i32=z_stem(txt[to..to+tl],out,tmp,vb);
        if(sl<1 || soff+sl>sbcap){j=j+1;continue;}
        let q:i32=0;
        while(q<sl){sb[soff+q]=out[q];q=q+1;}
        a_put(star,2*n2,soff);
        a_put(star,2*n2+1,sl);
        soff=soff+sl;
        n2=n2+1;
        j=j+1;
    }
    return n2;
}
// nearest non-stopword token left/right of token m, stemmed into out.
// Returns stem length (0 = none).
fn anchor_left(t:[]u8,ar:[]u8,nct:i32,m:i32,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let j:i32=m-1;
    while(j>=0){
        if(tok_num(t,ar,j,tmp)>=0){j=j-1;continue;}
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(t[to..to+tl],tmp);
        if(ll>0 && in_list(tmp[0..ll],lex_stop())==0){
            return z_stem(t[to..to+tl],out,tmp,vb);
        }
        j=j-1;
    }
    return 0;
}
fn anchor_right(t:[]u8,ar:[]u8,nct:i32,m:i32,tmp:[]u8,out:[]u8,vb:[]u8)i32{
    let j:i32=m+1;
    while(j<nct){
        if(tok_num(t,ar,j,tmp)>=0){j=j+1;continue;}
        let to:i32=a_get(ar,2*j);
        let tl:i32=a_get(ar,2*j+1);
        let ll:i32=lower_copy(t[to..to+tl],tmp);
        if(ll>0 && in_list(tmp[0..ll],lex_stop())==0){
            return z_stem(t[to..to+tl],out,tmp,vb);
        }
        j=j+1;
    }
    return 0;
}
// numeric value of token idx (digits+commas), or -1
fn tok_num(t:[]u8,ar:[]u8,idx:i32,tmp:[]u8)i32{
    let to:i32=a_get(ar,2*idx);
    let tl:i32=a_get(ar,2*idx+1);
    let ll:i32=lower_copy(t[to..to+tl],tmp);
    if(ll==0){return -1;}
    let v:i32=0;
    let nd:i32=0;
    let k:i32=0;
    while(k<ll){
        let b:i32=tmp[k] as i32;
        if(b==44){k=k+1;continue;}
        if(b<48 || b>57){return -1;}
        if(nd>=10){return -1;}
        v=v*10+(b-48);
        nd=nd+1;
        k=k+1;
    }
    if(nd==0){return -1;}
    return v;
}
// comparative word: more/fewer/less, or an -er adjective
fn comp_word(s:[]u8)i32{
    if(z_eq(s,"more")==1){return 1;}
    if(z_eq(s,"fewer")==1){return 1;}
    if(z_eq(s,"less")==1){return 1;}
    let n:i32=s.len;
    if(n>3 && (s[n-2] as i32)==101 && (s[n-1] as i32)==114){return 1;}
    return 0;
}
// ---- B4-CMP: gradable-antonym pairs (order-independent)
fn cpair(a:[]u8,b:[]u8,x:[]u8,y:[]u8)i32{
    if(z_eq(a,x)==1 && z_eq(b,y)==1){return 1;}
    if(z_eq(a,y)==1 && z_eq(b,x)==1){return 1;}
    return 0;
}
fn antonym_pair(a:[]u8,b:[]u8)i32{
    if(cpair(a,b,"faster","slower")==1){return 1;}
    if(cpair(a,b,"bigger","smaller")==1){return 1;}
    if(cpair(a,b,"taller","shorter")==1){return 1;}
    if(cpair(a,b,"hotter","colder")==1){return 1;}
    if(cpair(a,b,"older","younger")==1){return 1;}
    if(cpair(a,b,"more","fewer")==1){return 1;}
    if(cpair(a,b,"more","less")==1){return 1;}
    if(cpair(a,b,"better","worse")==1){return 1;}
    if(cpair(a,b,"larger","smaller")==1){return 1;}
    if(cpair(a,b,"greater","lesser")==1){return 1;}
    if(cpair(a,b,"higher","lower")==1){return 1;}
    if(cpair(a,b,"longer","shorter")==1){return 1;}
    if(cpair(a,b,"stronger","weaker")==1){return 1;}
    if(cpair(a,b,"earlier","later")==1){return 1;}
    return 0;
}
// ---- B4-COND: is a conditional clause's antecedent satisfied elsewhere?
// alo/ahi = antecedent token span (marker+1 .. consequent). Satisfied if
// another (or the same) clause asserts the antecedent: >=2 antecedent stems
// prefix-matched, or a number from the antecedent repeated, or 1 antecedent
// stem + 1 claim stem. Bare conditionals -> 0 (must not AFFIRM).
fn cond_satisfied(t:[]u8,clauA:[]u8,ncl:i32,c:i32,alo:i32,ahi:i32,stemA:[]u8,cstemA:[]u8,ncs:i32,SAT_TOK:[]u8,SAT_STM:[]u8,SAT_SB:[]u8,tmpS:[]u8,outS:[]u8,vbS:[]u8)i32{
    let co_c:i32=a_get(clauA,2*c);
    let cl_c:i32=a_get(clauA,2*c+1);
    let starA:[]u8=SAT_STM[0..256];
    let sbA:[]u8=SAT_SB[0..700];
    let starS:[]u8=SAT_STM[256..1024];
    let sbS:[]u8=SAT_SB[700..2000];
    let nA:i32=stemset(t,co_c,cl_c,alo,ahi,-1,-1,SAT_TOK,starA,sbA,700,32,tmpS,outS,vbS);
    if(nA==0){return 0;}
    let d:i32=0;
    while(d<ncl){
        let co:i32=a_get(clauA,2*d);
        let cl:i32=a_get(clauA,2*d+1);
        let nS:i32=0;
        if(d==c){
            nS=stemset(t,co,cl,0,1000000,alo,ahi,SAT_TOK,starS,sbS,1300,96,tmpS,outS,vbS);
        }else{
            nS=stemset(t,co,cl,0,1000000,-1,-1,SAT_TOK,starS,sbS,1300,96,tmpS,outS,vbS);
        }
        let m1:i32=0;
        let nums:i32=0;
        let ia:i32=0;
        while(ia<nA){
            let ao:i32=a_get(starA,2*ia);
            let al:i32=a_get(starA,2*ia+1);
            let a:[]u8=sbA[ao..ao+al];
            let hit:i32=0;
            let is2:i32=0;
            while(is2<nS){
                let so:i32=a_get(starS,2*is2);
                let sl:i32=a_get(starS,2*is2+1);
                if(prefix_match(a,sbS[so..so+sl])==1){hit=1;break;}
                is2=is2+1;
            }
            if(hit==1){m1=m1+1;}
            if(al>0 && (a[0] as i32)>=48 && (a[0] as i32)<=57){
                if(in_stems(a,sbS,starS,nS)==1){nums=nums+1;}
            }
            ia=ia+1;
        }
        if(m1>=2){return 1;}
        if(nums>=1){return 1;}
        if(m1>=1){
            let m2:i32=0;
            let ik:i32=0;
            while(ik<ncs){
                let ko:i32=a_get(cstemA,2*ik);
                let kl:i32=a_get(cstemA,2*ik+1);
                if(in_stems(stemA[ko..ko+kl],sbS,starS,nS)==1){m2=m2+1;}
                ik=ik+1;
            }
            if(m2>=1){return 1;}
        }
        d=d+1;
    }
    return 0;
}
// ---- B4-TMP: temporal order. Returns -1 (claim not temporal), 2 (DENY:
// reversed order or mismatched date), 1 (order confirmed), 0 (no order
// info in evidence -> suppress AFFIRM, NEUTRAL).
fn temporal_decide(claim:[]u8,toka:[]u8,nctA:i32,full:[]u8,tokb:[]u8,nft:i32,sc:[]u8)i32{
    let tmp:[]u8=sc[89216..93312];
    let out:[]u8=sc[12800..13312];
    let vb:[]u8=sc[13312..13440];
    let has:i32=0;
    let m0:i32=0;
    while(m0<nctA){
        if(tok_is(claim,toka,m0,"before",tmp)==1){has=1;break;}
        if(tok_is(claim,toka,m0,"after",tmp)==1){has=1;break;}
        m0=m0+1;
    }
    if(has==0){return -1;}
    let oA:[]u8=out[0..128];
    let oB:[]u8=out[128..256];
    let oC:[]u8=out[256..384];
    let oD:[]u8=out[384..512];
    // (1) same entity, different date -> DENY
    let di:i32=0;
    while(di<nctA){
        let dv:i32=tok_num(claim,toka,di,tmp);
        if(dv>=0){
            let al:i32=anchor_left(claim,toka,nctA,di,tmp,oA,vb);
            if(al>0){
                let ej:i32=0;
                while(ej<nft){
                    let ev2:i32=tok_num(full,tokb,ej,tmp);
                    if(ev2>=0){
                        let bl:i32=anchor_left(full,tokb,nft,ej,tmp,oC,vb);
                        if(bl>0 && z_eq(oA[0..al],oC[0..bl])==1 && dv!=ev2){return 2;}
                    }
                    ej=ej+1;
                }
            }
        }
        di=di+1;
    }
    // (2)(3) order pairs, normalized to earlier(A,B)
    let allconf:i32=1;
    let anypair:i32=0;
    let m:i32=0;
    while(m<nctA){
        let rel:i32=-1;
        if(tok_is(claim,toka,m,"before",tmp)==1){rel=0;}
        else{
            if(tok_is(claim,toka,m,"after",tmp)==1){rel=1;}
        }
        if(rel>=0){
            let al:i32=anchor_left(claim,toka,nctA,m,tmp,oA,vb);
            let bl:i32=anchor_right(claim,toka,nctA,m,tmp,oB,vb);
            if(al>0 && bl>0){
                anypair=1;
                let cA:[]u8=oA[0..al];
                let cB:[]u8=oB[0..bl];
                if(rel==1){cA=oB[0..bl];cB=oA[0..al];}
                let conf:i32=0;
                let e:i32=0;
                while(e<nft && conf==0){
                    let erel:i32=-1;
                    if(tok_is(full,tokb,e,"before",tmp)==1){erel=0;}
                    else{
                        if(tok_is(full,tokb,e,"after",tmp)==1){erel=1;}
                    }
                    if(erel>=0){
                        let al2:i32=anchor_left(full,tokb,nft,e,tmp,oC,vb);
                        let bl2:i32=anchor_right(full,tokb,nft,e,tmp,oD,vb);
                        if(al2>0 && bl2>0){
                            let pA:[]u8=oC[0..al2];
                            let pB:[]u8=oD[0..bl2];
                            if(erel==1){pA=oD[0..bl2];pB=oC[0..al2];}
                            if(z_eq(cA,pA)==1 && z_eq(cB,pB)==1){conf=1;}
                            else{
                                if(z_eq(cA,pB)==1 && z_eq(cB,pA)==1){return 2;}
                            }
                        }
                    }
                    e=e+1;
                }
                if(conf==0){
                    let dA:i32=-1;
                    let dB:i32=-1;
                    let f:i32=0;
                    while(f<nft){
                        let fv:i32=tok_num(full,tokb,f,tmp);
                        if(fv>=0){
                            let fl:i32=anchor_left(full,tokb,nft,f,tmp,oC,vb);
                            if(fl>0){
                                if(z_eq(cA,oC[0..fl])==1){dA=fv;}
                                if(z_eq(cB,oC[0..fl])==1){dB=fv;}
                            }
                        }
                        f=f+1;
                    }
                    if(dA>=0 && dB>=0){
                        if(dA<dB){conf=1;}
                        else{return 2;}
                    }
                }
                if(conf==0){allconf=0;}
            }
        }
        m=m+1;
    }
    if(anypair==1 && allconf==1){return 1;}
    return 0;
}
// ---- B4-CMP: comparatives ("X is ADJ-er than Y"). Returns -1 (no "than"
// in claim), 2 (DENY: antonym swap or role swap), 1 (same comparison
// present), 0 (no comparable evidence -> suppress AFFIRM, NEUTRAL).
fn comp_decide(claim:[]u8,toka:[]u8,nctA:i32,full:[]u8,tokb:[]u8,nft:i32,sc:[]u8)i32{
    let tmp:[]u8=sc[89216..93312];
    let out:[]u8=sc[12800..13312];
    let vb:[]u8=sc[13312..13440];
    let sb:[]u8=sc[104352..106352];
    let m:i32=-1;
    let i0:i32=0;
    while(i0<nctA){
        if(tok_is(claim,toka,i0,"than",tmp)==1){m=i0;break;}
        i0=i0+1;
    }
    if(m<1){return -1;}
    let sC:[]u8=sb[0..128];
    let sE1:[]u8=sb[128..256];
    let sE2:[]u8=sb[256..384];
    // comparative word: token m-1, else token m-2 ("more apples than")
    let cidx:i32=-1;
    let cl2:i32=0;
    let cto:i32=a_get(toka,2*(m-1));
    let ctl:i32=a_get(toka,2*(m-1)+1);
    cl2=z_stem(claim[cto..cto+ctl],sC,tmp,vb);
    if(cl2>0 && comp_word(sC[0..cl2])==1){cidx=m-1;}
    else{
        if(m>=2){
            let ct2:i32=a_get(toka,2*(m-2));
            let clt2:i32=a_get(toka,2*(m-2)+1);
            cl2=z_stem(claim[ct2..ct2+clt2],sC,tmp,vb);
            if(cl2>0 && comp_word(sC[0..cl2])==1){cidx=m-2;}
        }
    }
    if(cidx<0){return 0;}
    let al:i32=anchor_left(claim,toka,nctA,cidx,tmp,sE1,vb);
    let bl:i32=anchor_right(claim,toka,nctA,m,tmp,sE2,vb);
    if(al==0 || bl==0){return 0;}
    let oA:[]u8=out[0..128];
    let oB:[]u8=out[128..256];
    let oC:[]u8=out[256..384];
    let oD:[]u8=out[384..512];
    let aff:i32=0;
    let e:i32=0;
    while(e<nft){
        if(tok_is(full,tokb,e,"than",tmp)==1 && e>=1){
            let ecidx:i32=-1;
            let el2:i32=0;
            let eto:i32=a_get(tokb,2*(e-1));
            let etl:i32=a_get(tokb,2*(e-1)+1);
            el2=z_stem(full[eto..eto+etl],oA,tmp,vb);
            if(el2>0 && comp_word(oA[0..el2])==1){ecidx=e-1;}
            else{
                if(e>=2){
                    let et2:i32=a_get(tokb,2*(e-2));
                    let el2t:i32=a_get(tokb,2*(e-2)+1);
                    el2=z_stem(full[et2..et2+el2t],oA,tmp,vb);
                    if(el2>0 && comp_word(oA[0..el2])==1){ecidx=e-2;}
                }
            }
            if(ecidx>=0){
                let fl:i32=anchor_left(full,tokb,nft,ecidx,tmp,oB,vb);
                let gl:i32=anchor_right(full,tokb,nft,e,tmp,oC,vb);
                if(fl>0 && gl>0){
                    if(z_eq(sE1[0..al],oB[0..fl])==1 && z_eq(sE2[0..bl],oC[0..gl])==1){
                        if(z_eq(sC[0..cl2],oA[0..el2])==1){aff=1;}
                        else{
                            if(antonym_pair(sC[0..cl2],oA[0..el2])==1){return 2;}
                        }
                    }
                    else{
                        if(z_eq(sE1[0..al],oC[0..gl])==1 && z_eq(sE2[0..bl],oB[0..fl])==1){
                            if(z_eq(sC[0..cl2],oA[0..el2])==1){return 2;}
                        }
                    }
                }
            }
        }
        e=e+1;
    }
    if(aff==1){return 1;}
    return 0;
}
// strong-deny stem prefixes: debunk disprov refut incorrect wrong myth hoax fals
fn deny_prefix(st:[]u8)i32{
    if(z_starts(st,"debunk")==1){return 1;}
    if(z_starts(st,"disprov")==1){return 1;}
    if(z_starts(st,"refut")==1){return 1;}
    if(z_starts(st,"incorrect")==1){return 1;}
    if(z_starts(st,"wrong")==1){return 1;}
    if(z_starts(st,"myth")==1){return 1;}
    if(z_starts(st,"hoax")==1){return 1;}
    if(z_starts(st,"fals")==1){return 1;}
    return 0;
}
// SYN table: 1 if stem s is in the synonym set of predicate pred
fn psyn_has(s:[]u8,pred:[]u8)i32{
    if(z_eq(pred,"boil")==1){return z_eq(s,"boil");}
    if(z_eq(pred,"cause")==1){return z_eq(s,"cause");}
    if(z_eq(pred,"cure")==1){return z_eq(s,"cure");}
    if(z_eq(pred,"dissolve")==1){return z_eq(s,"dissolve");}
    if(z_eq(pred,"fake")==1){return z_eq(s,"fake");}
    if(z_eq(pred,"strike")==1){return z_eq(s,"strike");}
    if(z_eq(pred,"use")==1){return z_eq(s,"use");}
    if(z_eq(pred,"show")==1){return z_eq(s,"show");}
    if(z_eq(pred,"orbit")==1){
        if(z_eq(s,"orbit")==1){return 1;}
        return z_eq(s,"revolve");
    }
    if(z_eq(pred,"originate")==1){
        if(z_eq(s,"originate")==1){return 1;}
        return z_eq(s,"leak");
    }
    if(z_eq(pred,"have")==1){
        if(z_eq(s,"have")==1){return 1;}
        if(z_eq(s,"has")==1){return 1;}
        return z_eq(s,"had");
    }
    if(z_eq(pred,"be")==1){
        if(z_eq(s,"be")==1){return 1;}
        if(z_eq(s,"is")==1){return 1;}
        if(z_eq(s,"are")==1){return 1;}
        if(z_eq(s,"was")==1){return 1;}
        if(z_eq(s,"were")==1){return 1;}
        return z_eq(s,"am");
    }
    return z_eq(s,pred);
}
fn has_superlative(stemC:[]u8,cstmC:[]u8,nct:i32)i32{
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        if(in_list(stemC[so..so+sl],lex_super())==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ==================== tokenizer ====================
// Python: re.findall(r"[A-Za-z0-9\u2019']+(?:-[A-Za-z0-9\u2019']+)*", text)
// is_wc returns 0 (not a word char), 1 (1-byte word char), 3 (U+2019).
fn is_wc(s:[]u8,i:i32)i32{
    if(i>=s.len){return 0;}
    let b:i32=s[i] as i32;
    if(b>=65 && b<=90){return 1;}
    if(b>=97 && b<=122){return 1;}
    if(b>=48 && b<=57){return 1;}
    if(b==39){return 1;}
    if(b==226 && i+2<s.len){
        if((s[i+1] as i32)==128 && (s[i+2] as i32)==153){return 3;}
    }
    return 0;
}
// Writes (off,len) pairs into ar (2 slots each); returns token count.
fn z_toks(t:[]u8,ar:[]u8,max:i32)i32{
    let n:i32=t.len;
    let i:i32=0;
    let k:i32=0;
    while(i<n && k<max){
        let l:i32=is_wc(t,i);
        if(l==0){i=i+1;}
        else{
            let st:i32=i;
            while(l>0){
                i=i+l;
                if(i<n && (t[i] as i32)==45){
                    let l2:i32=is_wc(t,i+1);
                    if(l2>0){i=i+1;l=l2;continue;}
                }
                l=is_wc(t,i);
            }
            a_put(ar,2*k,st);
            a_put(ar,2*k+1,i-st);
            k=k+1;
        }
    }
    return k;
}

// ==================== stemmer ====================
// Exact port of proto_r12.stem. t = original token; writes stem bytes to
// out; tmp/vb are scratch (>= 256 / >= 64). Returns stem length.
fn z_stem(t:[]u8,out:[]u8,tmp:[]u8,vb:[]u8)i32{
    let n:i32=t.len;
    // 1. lowercase (ASCII + Latin-1 C3 80-9E)
    let i:i32=0;
    let k:i32=0;
    while(i<n){
        let b:i32=t[i] as i32;
        if(b>=65 && b<=90){tmp[k]=(b+32) as u8;k=k+1;i=i+1;}
        else{
            if(b==195 && i+1<n){
                let b2:i32=t[i+1] as i32;
                if(b2>=128 && b2<=158 && b2!=151){
                    tmp[k]=195 as u8;tmp[k+1]=(b2+32) as u8;k=k+2;i=i+2;
                }else{tmp[k]=b as u8;k=k+1;i=i+1;}
            }else{tmp[k]=b as u8;k=k+1;i=i+1;}
        }
    }
    // 2. possessive 's
    if(k>=2 && (tmp[k-2] as i32)==39 && (tmp[k-1] as i32)==115){k=k-2;}
    // 3. strip ASCII quotes
    while(k>0 && (tmp[k-1] as i32)==39){k=k-1;}
    let j0:i32=0;
    while(j0<k && (tmp[j0] as i32)==39){j0=j0+1;}
    // 4. short guard (char count, like Python len())
    let nc:i32=z_cplen_range(tmp,j0,k);
    if(nc<=3){
        let o:i32=0;
        while(j0+o<k){out[o]=tmp[j0+o];o=o+1;}
        return o;
    }
    let app:i32=-1;
    let done:i32=0;
    // ies -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ies")==1){k=k-3;app=121;done=1;}
    // sses/xes/zes/ches/shes -> strip 2
    if(done==0 && nc>5){
        if(ew(tmp,j0,k,"sses")==1 || ew(tmp,j0,k,"xes")==1 || ew(tmp,j0,k,"zes")==1 || ew(tmp,j0,k,"ches")==1 || ew(tmp,j0,k,"shes")==1){
            k=k-2;done=1;
        }
    }
    // es -> strip 1
    if(done==0 && ew(tmp,j0,k,"es")==1){k=k-1;done=1;}
    // s (not ss) -> strip 1
    if(done==0 && ew(tmp,j0,k,"s")==1 && ew(tmp,j0,k,"ss")==0){k=k-1;done=1;}
    // ied -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ied")==1){k=k-3;app=121;done=1;}
    // ed
    if(done==0 && ew(tmp,j0,k,"ed")==1){
        let cl:i32=0;
        while(j0+cl<k-2){vb[cl]=tmp[j0+cl];cl=cl+1;}
        vb[cl]=101;cl=cl+1;
        if(in_list(vb[0..cl],lex_verb())==1){k=k-2;app=101;}
        else{
            if(nc>5 && z_isvowel(tmp[k-3] as i32)==1){k=k-1;}
            else{k=k-2;}
        }
        done=1;
    }
    // ing
    if(done==0 && nc>6 && ew(tmp,j0,k,"ing")==1){
        let bl:i32=0;
        while(j0+bl<k-3){vb[bl]=tmp[j0+bl];bl=bl+1;}
        vb[bl]=101;bl=bl+1;
        if(in_list(vb[0..bl],lex_verb())==1){k=k-3;app=101;}
        else{
            let bend:i32=0;
            if(k-3>j0){bend=tmp[k-4] as i32;}
            if(k-3>j0 && bend==101){k=k-3;}
            else{
                if(k-3>j0 && z_isvowel(bend)==0){k=k-3;}
                else{k=k-3;app=101;}
            }
        }
        done=1;
    }
    // ly
    if(done==0 && nc>5 && ew(tmp,j0,k,"ly")==1){k=k-2;done=1;}
    // emit
    let o2:i32=0;
    while(j0+o2<k){out[o2]=tmp[j0+o2];o2=o2+1;}
    if(app>=0){out[o2]=app as u8;o2=o2+1;}
    return o2;
}

// ==================== clause splitter ====================
// Python: protect (\d)\.(\d) (non-overlapping, left to right), then split
// on [.!?;\u2014]+, strip, drop empties. prot must be zeroed, len >= t.len.
fn z_clauses(t:[]u8,ar:[]u8,prot:[]u8,max:i32)i32{
    let n:i32=t.len;
    // prot is a reused scratch buffer: clear this call's range (Python
    // rebuilds the protected string fresh on every call)
    let z:i32=0;
    while(z<n){prot[z]=0;z=z+1;}
    let p:i32=0;
    while(p+2<n){
        if(z_isdig(t[p] as i32)==1 && (t[p+1] as i32)==46 && z_isdig(t[p+2] as i32)==1){
            prot[p+1]=1;
            p=p+3;
        }else{p=p+1;}
    }
    let k:i32=0;
    let i:i32=0;
    let st:i32=-1;
    while(i<n && k<max){
        let b:i32=t[i] as i32;
        let sep:i32=0;
        let w:i32=1;
        if(b==46 && prot[i]==0){sep=1;}
        if(b==33 || b==63 || b==59){sep=1;}
        if(b==226 && i+2<n && (t[i+1] as i32)==128 && (t[i+2] as i32)==148){sep=1;w=3;}
        if(sep==1){
            if(st>=0){
                // keep the original spacing (Python only drops parts that
                // strip to empty); z_blank mirrors str.strip() emptiness
                if(z_blank(t[st..i])==0){
                    a_put(ar,2*k,st);
                    a_put(ar,2*k+1,i-st);
                    k=k+1;
                }
                st=-1;
            }
            i=i+w;
        }else{
            if(st<0){st=i;}
            i=i+1;
        }
    }
    if(st>=0 && k<max){
        if(z_blank(t[st..n])==0){
            a_put(ar,2*k,st);
            a_put(ar,2*k+1,n-st);
            k=k+1;
        }
    }
    return k;
}
// 1 if s is empty or all ASCII whitespace (mirrors Python str.strip()=="" for
// the ASCII-whitespace cases that reach clause filtering; a clause of only
// non-ASCII whitespace cannot occur here because toks() would find no token
// and scan_text skips zero-token clauses anyway)
fn z_blank(s:[]u8)i32{
    let i:i32=0;
    while(i<s.len){
        if(z_isspace(s[i] as i32)==0){return 0;}
        i=i+1;
    }
    return 1;
}

// ==================== stance helpers ====================
// Negation scoping the predicate: marker within 4 tokens before pi.
// Markers: NEG_TOKENS, ASCII n't, U+2019 n't.
fn neg_scope(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,tmp:[]u8)i32{
    let j:i32=pi-4;
    if(j<0){j=0;}
    while(j<pi && j<nct){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(in_list(w,lex_neg())==1){return 1;}
        if(ew(w,0,ll,"n't")==1){return 1;}
        if(ll>=4 && (w[ll-4] as i32)==226 && (w[ll-3] as i32)==128 && (w[ll-2] as i32)==153 && (w[ll-1] as i32)==116){return 1;}
        j=j+1;
    }
    return 0;
}
// The entity the clause's predicate is asserted of, when it is NOT the
// claim's subject. Returns 1 if a competing proper noun exists.
fn competitor(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,firstA:[]u8,tmp:[]u8)i32{
    // (1) immediate subject: nearest non-filler token before predicate
    let j:i32=pi-1;
    while(j>=0){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_filler())==0){break;}
        j=j-1;
    }
    if(j>=0){
        let to2:i32=a_get(tokC,2*j);
        let tl2:i32=a_get(tokC,2*j+1);
        let tj:[]u8=clause[to2..to2+tl2];
        if(z_cplen(tj)>=3 && z_isupper1(tj)==1){
            let so:i32=a_get(cstmC,2*j);
            let sl:i32=a_get(cstmC,2*j+1);
            if(in_stems(stemC[so..so+sl],stemA,cstemA,ncs)==0){return 1;}
        }
    }
    // (2) far-field: capitalized entity before predicate while the claim's
    // subject anchor (first content word) is absent from the clause
    if(in_stems(firstA,stemC,cstmC,nct)==0){
        let kk:i32=1;
        while(kk<pi && kk<nct){
            let to3:i32=a_get(tokC,2*kk);
            let tl3:i32=a_get(tokC,2*kk+1);
            let tk:[]u8=clause[to3..to3+tl3];
            if(z_cplen(tk)>=4 && z_isupper1(tk)==1){
                let so2:i32=a_get(cstmC,2*kk);
                let sl2:i32=a_get(cstmC,2*kk+1);
                let ll3:i32=lower_copy(tk,tmp);
                if(in_stems(stemC[so2..so2+sl2],stemA,cstemA,ncs)==0 && in_list(tmp[0..ll3],lex_conjskip())==0){return 1;}
            }
            kk=kk+1;
        }
    }
    return 0;
}
fn is_interrog(clause:[]u8,tokC:[]u8,nct:i32,tmp:[]u8)i32{
    if(z_has(clause,"?")==1){return 1;}
    if(nct>0){
        let to:i32=a_get(tokC,0);
        let tl:i32=a_get(tokC,1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_whaux())==1 && nct<=10){return 1;}
    }
    return 0;
}
// Claim numbers: runs matching Python re \d[\d,]* (digit followed by digits
// or commas), stored raw; has_claim_value() strips ","/" " from both sides
// before the substring test. No minimum length, no trailing-comma strip:
// "1," yields num "1" exactly as in the prototype.
fn claim_numbers(claim:[]u8,numa:[]u8,max:i32)i32{
    let n:i32=claim.len;
    let p:i32=0;
    let k:i32=0;
    while(p<n && k<max){
        if(z_isdig(claim[p] as i32)==1){
            let q:i32=p;
            while(q<n && (z_isdig(claim[q] as i32)==1 || (claim[q] as i32)==44)){q=q+1;}
            a_put(numa,2*k,p);
            a_put(numa,2*k+1,q-p);
            k=k+1;
            p=q;
        }else{p=p+1;}
    }
    return k;
}
fn has_claim_value(clause:[]u8,claim:[]u8,numa:[]u8,nnums:i32,clvB:[]u8,tmp:[]u8)i32{
    if(nnums==0){return 0;}
    let n:i32=clause.len;
    let k:i32=0;
    let i:i32=0;
    while(i<n){
        let b:i32=clause[i] as i32;
        if(b!=44 && b!=32){clvB[k]=clause[i];k=k+1;}
        i=i+1;
    }
    let cl2:[]u8=clvB[0..k];
    i=0;
    while(i<nnums){
        let no:i32=a_get(numa,2*i);
        let nl:i32=a_get(numa,2*i+1);
        let num:[]u8=claim[no..no+nl];
        let m:i32=num.len;
        let k2:i32=0;
        let jj:i32=0;
        while(jj<m){
            let b2:i32=num[jj] as i32;
            if(b2!=44 && b2!=32){tmp[k2]=num[jj];k2=k2+1;}
            jj=jj+1;
        }
        if(z_has(cl2,tmp[0..k2])==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ==================== clause scanner ====================
// Scans one text's clauses (title OR snippet -- never mixed). Returns
// 0 (no deny), 1 deny-lex, 2 antonym, 3 neg-scope, 4 competing-subject.
// Sets affB[0]=1 on first endorsing clause.
fn scan_text(t:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,stemB:[]u8,tstmB:[]u8,ntstm:i32,firstA:[]u8,lastA:[]u8,pred:[]u8,need:i32,numa:[]u8,nnums:i32,claim:[]u8,clauA:[]u8,protB:[]u8,tokC:[]u8,stemC:[]u8,cstmC:[]u8,lowB:[]u8,clvB:[]u8,tmpS:[]u8,outS:[]u8,vbS:[]u8,affB:[]u8,tsup:i32,Qc:i32,sc:[]u8)i32{
    let ncl:i32=z_clauses(t,clauA,protB,256);
    // ---- B4-COND pre-pass: conditional marker per clause ----
    // CONDM[c]=1 if clause c contains if/unless/whether/provided/assuming/
    // suppose ("whether X or not" is concessive, not conditional).
    // CONDA[2*c] = marker token index.
    let CONDM:[]u8=sc[100000..100256];
    let CONDA:[]u8=sc[100256..102304];
    let SAT_TOK:[]u8=sc[102304..103328];
    let SAT_STM:[]u8=sc[103328..104352];
    let SAT_SB:[]u8=sc[104352..106352];
    let ci:i32=0;
    while(ci<ncl){
        let co0:i32=a_get(clauA,2*ci);
        let cl0:i32=a_get(clauA,2*ci+1);
        let cltxt:[]u8=t[co0..co0+cl0];
        let nt2:i32=z_toks(cltxt,SAT_TOK,128);
        let cm:i32=0;
        let mi2:i32=-1;
        let j2:i32=0;
        while(j2<nt2){
            if(tok_is(cltxt,SAT_TOK,j2,"if",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"unless",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"provided",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"assuming",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"suppose",tmpS)==1){cm=1;mi2=j2;break;}
            if(tok_is(cltxt,SAT_TOK,j2,"whether",tmpS)==1){
                let k3:i32=j2+1;
                let conc:i32=0;
                while(k3+1<nt2){
                    if(tok_is(cltxt,SAT_TOK,k3,"or",tmpS)==1 && tok_is(cltxt,SAT_TOK,k3+1,"not",tmpS)==1){conc=1;break;}
                    k3=k3+1;
                }
                if(conc==0){cm=1;mi2=j2;break;}
            }
            j2=j2+1;
        }
        CONDM[ci]=cm as u8;
        a_put(CONDA,2*ci,mi2);
        ci=ci+1;
    }
    let c:i32=0;
    while(c<ncl){
        let co:i32=a_get(clauA,2*c);
        let cl:i32=a_get(clauA,2*c+1);
        let clause:[]u8=t[co..co+cl];
        let nct:i32=z_toks(clause,tokC,1024);
        if(nct==0){c=c+1;continue;}
        // clause stems
        let soffC:i32=0;
        let i:i32=0;
        while(i<nct){
            let to:i32=a_get(tokC,2*i);
            let tl:i32=a_get(tokC,2*i+1);
            let sl:i32=z_stem(clause[to..to+tl],outS,tmpS,vbS);
            let q:i32=0;
            while(q<sl){stemC[soffC+q]=outS[q];q=q+1;}
            a_put(cstmC,2*i,soffC);
            a_put(cstmC,2*i+1,sl);
            soffC=soffC+sl;
            i=i+1;
        }
        // n_claim + anchor
        let nclm:i32=0;
        i=0;
        while(i<ncs){
            let so:i32=a_get(cstemA,2*i);
            let sl2:i32=a_get(cstemA,2*i+1);
            if(in_stems(stemA[so..so+sl2],stemC,cstmC,nct)==1){nclm=nclm+1;}
            i=i+1;
        }
        let anch:i32=0;
        if(in_stems(firstA,stemC,cstmC,nct)==1 || in_stems(lastA,stemC,cstmC,nct)==1){anch=1;}
        // ---- B4-HEDGE: clause hedged if any raw token is a hedge word ----
        let hedged:i32=0;
        let hi2:i32=0;
        while(hi2<nct){
            let to9:i32=a_get(tokC,2*hi2);
            let tl9:i32=a_get(tokC,2*hi2+1);
            let ll9:i32=lower_copy(clause[to9..to9+tl9],tmpS);
            if(in_list(tmpS[0..ll9],lex_hedge())==1){hedged=1;break;}
            hi2=hi2+1;
        }
        // ---- B4-QUANT: evidence quantifier = first clause token ----
        let Qe:i32=0;
        if(nct>0){
            let qo:i32=a_get(tokC,0);
            let ql:i32=a_get(tokC,1);
            let qll:i32=lower_copy(clause[qo..qo+ql],tmpS);
            Qe=quant_code(tmpS[0..qll]);
        }
        let lowl:i32=lower_copy(clause,lowB);
        let low:[]u8=lowB[0..lowl];
        // --- DENY (a): denial lexicon ---
        let strong:i32=0;
        let weak:i32=0;
        i=0;
        while(i<nct){
            let so3:i32=a_get(cstmC,2*i);
            let sl3:i32=a_get(cstmC,2*i+1);
            let st:[]u8=stemC[so3..so3+sl3];
            if(in_list(st,lex_strong())==1 || deny_prefix(st)==1){strong=1;}
            let to2:i32=a_get(tokC,2*i);
            let tl2:i32=a_get(tokC,2*i+1);
            let ll2:i32=lower_copy(clause[to2..to2+tl2],tmpS);
            if(in_list(tmpS[0..ll2],lex_weak())==1){weak=1;}
            i=i+1;
        }
        if(z_has(low,"no evidence")==1){weak=1;}
        if(z_has(low,"no longer")==1){weak=1;}
        let ana:i32=0;
        if(strong==1 && nct<=8){
            let k2:i32=0;
            i=0;
            while(i<ncs){
                let so4:i32=a_get(cstemA,2*i);
                let sl4:i32=a_get(cstemA,2*i+1);
                if(in_stems(stemA[so4..so4+sl4],stemB,tstmB,ntstm)==1){k2=k2+1;}
                i=i+1;
            }
            if(k2>=3){ana=1;}
        }
        if((strong==1 && nclm>=1) || (weak==1 && nclm>=2) || ana==1){return 1;}
        // --- DENY (d): antonym ---
        if(in_stems("flat",stemA,cstemA,ncs)==1 && nclm>=1){
            if(in_stems("spherical",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("sphere",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("round",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("globe",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("oblate",stemC,cstmC,nct)==1){return 2;}
        }
        if(in_stems("spherical",stemA,cstemA,ncs)==1 && in_stems("flat",stemC,cstmC,nct)==1 && nclm>=1){return 2;}
        // ---- B4-QUANT pair rules (predicate-independent) ----
        // (a) universal-ish claim vs negative-universal evidence -> DENY
        // (b) negative-universal claim vs existential evidence -> DENY
        // (f) few vs most (either direction) -> DENY
        // (d) universal/most claim vs weaker existential evidence -> suppress AFFIRM
        let qsup:i32=0;
        if(nclm>=need && anch==1){
            if(Qe==7 && (Qc==1 || Qc==2 || Qc==3 || Qc==4)){return 9;}
            if(Qc==7 && (Qe==1 || Qe==2 || Qe==3 || Qe==4 || Qe==5)){return 9;}
            if(Qc==6 && Qe==2){return 9;}
            if(Qc==2 && Qe==6){return 9;}
            if(Qc==1 && (Qe==2 || Qe==3 || Qe==4 || Qe==5 || Qe==6)){qsup=1;}
            if(Qc==2 && (Qe==4 || Qe==5 || Qe==6)){qsup=1;}
        }
        // --- predicate-dependent rules ---
        let pi:i32=-1;
        i=0;
        while(i<nct){
            let so5:i32=a_get(cstmC,2*i);
            let sl5:i32=a_get(cstmC,2*i+1);
            if(psyn_has(stemC[so5..so5+sl5],pred)==1){pi=i;break;}
            i=i+1;
        }
        if(pi<0){c=c+1;continue;}
        // --- DENY (b): negation scoping the predicate ---
        // B4-HEDGE: a hedged denial ("may not cure", "suggests X has no
        // effect") is NEUTRAL, not DENY -- but only when the hedge sits
        // inside the negation's scope (4 tokens before the predicate). An
        // incidental hedge elsewhere in the clause ("doesn't cause cancer,
        // but hot drinks might") must not cancel a genuine denial.
        let ns:i32=neg_scope(clause,tokC,nct,pi,tmpS);
        let hedged_deny:i32=0;
        if(ns==1){
            let wj:i32=pi-4;
            if(wj<0){wj=0;}
            while(wj<=pi && wj<nct){
                let wo:i32=a_get(tokC,2*wj);
                let wl:i32=a_get(tokC,2*wj+1);
                let wll:i32=lower_copy(clause[wo..wo+wl],tmpS);
                if(in_list(tmpS[0..wll],lex_hedge())==1){hedged_deny=1;break;}
                wj=wj+1;
            }
        }
        if(ns==1 && nclm>=1 && hedged_deny==0){return 3;}
        // ---- B4-QUANT (c): negated predicate vs universal-ish claim -> DENY.
        // Covers post-predicate "not" ("Some cats are not indoors") as well
        // as pre-predicate scope that deny-(b) missed on anchor/need grounds.
        if(nclm>=need && anch==1){
            let evneg:i32=ns;
            if(evneg==0){
                let pj:i32=pi+1;
                while(pj<pi+4 && pj<nct){
                    let po:i32=a_get(tokC,2*pj);
                    let pl:i32=a_get(tokC,2*pj+1);
                    let pll:i32=lower_copy(clause[po..po+pl],tmpS);
                    let pw:[]u8=tmpS[0..pll];
                    if(in_list(pw,lex_neg())==1){evneg=1;break;}
                    if(ew(pw,0,pll,"n't")==1){evneg=1;break;}
                    pj=pj+1;
                }
            }
            if(evneg==1){
                if(Qc==1 || Qc==2 || Qc==3){return 9;}
                if(Qc==0 && (Qe==2 || Qe==3 || Qe==4 || Qe==5 || Qe==6)){return 9;}
            }
        }
        // --- DENY (c): competing subject + superlative/identity predicate ---
        let comp:i32=competitor(clause,tokC,nct,pi,stemC,cstmC,stemA,cstemA,ncs,firstA,tmpS);
        if(comp==1 && nclm>=1 && in_stems(firstA,stemC,cstmC,nct)==1){
            if(z_eq(pred,"be")==1 || has_superlative(stemC,cstmC,nct)==1){
                if(is_interrog(clause,tokC,nct,tmpS)==0 && has_claim_value(clause,claim,numa,nnums,clvB,tmpS)==0){
                    return 4;
                }
            }
        }
        // --- AFFIRM: positive endorsement evidence only ---
        // B4: hedged clauses, quantifier-suppressed, temporal/comparative-
        // suppressed (tsup), and unsatisfied conditionals must not AFFIRM.
        if(affB[0]==0){
            let framed:i32=0;
            if(z_has(low,"conspiracy theory")==1){framed=1;}
            if(z_has(low,"choose a legend")==1){framed=1;}
            if(z_starts(low,"legend:")==1){framed=1;}
            if(z_has(low,"urban legend")==1){framed=1;}
            let condok:i32=1;
            if(CONDM[c]==1){
                let mi3:i32=a_get(CONDA,2*c);
                let alo3:i32=mi3+1;
                let ahi3:i32=nct;
                if(pi>mi3){ahi3=pi;}
                condok=cond_satisfied(t,clauA,ncl,c,alo3,ahi3,stemA,cstemA,ncs,SAT_TOK,SAT_STM,SAT_SB,tmpS,outS,vbS);
            }
            if(nclm>=need && anch==1 && ns==0 && is_interrog(clause,tokC,nct,tmpS)==0 && framed==0 && comp==0 && hedged==0 && qsup==0 && tsup==0 && condok==1){
                affB[0]=1;
            }
        }
        c=c+1;
    }
    return 0;
}

// ==================== classifier ====================
// Scratch map (100000 bytes, carved identically on every call):
//   TOKA  [0,1024)       claim tokens (128 x 8)
//   STEMA [1024,9216)    claim stem bytes
//   WORDA [9216,11264)   content words (128 x 16: tokoff,toklen,stoff,stlen)
//   CSTEMA[11264,12288)   claim deduped stems (128 x 8)
//   TMPS  [12288,12800)  stem/lower working buffer
//   OUTS  [12800,13312)  stem output buffer
//   VBS   [13312,13440)  verb-form candidate buffer
//   FULLB [13440,17536)  title + " " + snippet
//   TOKB  [17536,25728)  full-text tokens (1024 x 8)
//   STEMB [25728,42112)  full-text stem bytes
//   TSTMB [42112,50304)  full-text stems (1024 x 8)
//   CLAUA [50304,52352)  clauses (256 x 8)
//   PROTB [52352,56448)  decimal-point protection flags
//   TOKC  [56448,64640)  clause tokens (1024 x 8)
//   STEMC [64640,81024)  clause stem bytes
//   CSTMC [81024,89216)  clause stems (1024 x 8)
//   LOWB  [89216,93312)  lowercased clause buffer
//   CLVB  [93312,97408)  clause-minus-punctuation buffer
//   NUMA  [97408,97920)  claim numbers (64 x 8)
//   AFFB  [97920,97928)  affirm flag
// Returns tag*16+reason. tag: 0 neutral/irrelevant, 1 affirm, 2 deny.
// reason: 0 gate, 1 deny-lex, 2 antonym, 3 neg-scope, 4 competing-subject,
//         5 endorse, 6 neutral, 7 temporal, 8 comparative, 9 quantifier.
// B4: scratch map extended to 120000 bytes; [100000,106352) holds the
// conditional scratch (CONDM/CONDA/SAT_TOK/SAT_STM/SAT_SB).
fn r12_classify(claim:[]u8,title:[]u8,snip:[]u8,sc:[]u8)i32{
    let TOKA:[]u8=sc[0..1024];
    let STEMA:[]u8=sc[1024..9216];
    let WORDA:[]u8=sc[9216..11264];
    let CSTEMA:[]u8=sc[11264..12288];
    let TMPS:[]u8=sc[12288..12800];
    let OUTS:[]u8=sc[12800..13312];
    let VBS:[]u8=sc[13312..13440];
    let FULLB:[]u8=sc[13440..17536];
    let TOKB:[]u8=sc[17536..25728];
    let STEMB:[]u8=sc[25728..42112];
    let TSTMB:[]u8=sc[42112..50304];
    let CLAUA:[]u8=sc[50304..52352];
    let PROTB:[]u8=sc[52352..56448];
    let TOKC:[]u8=sc[56448..64640];
    let STEMC:[]u8=sc[64640..81024];
    let CSTMC:[]u8=sc[81024..89216];
    let LOWB:[]u8=sc[89216..93312];
    let CLVB:[]u8=sc[93312..97408];
    let NUMA:[]u8=sc[97408..97920];
    let AFFB:[]u8=sc[97920..97928];
    // ---- claim: tokens + content words ----
    let nct:i32=z_toks(claim,TOKA,128);
    let nw:i32=0;
    let soff:i32=0;
    let i:i32=0;
    while(i<nct && nw<128){
        let to:i32=a_get(TOKA,2*i);
        let tl:i32=a_get(TOKA,2*i+1);
        let tok:[]u8=claim[to..to+tl];
        if(z_cplen(tok)>3){
            let ll:i32=lower_copy(tok,TMPS);
            if(in_list(TMPS[0..ll],lex_stop())==0){
                let sl:i32=z_stem(tok,OUTS,TMPS,VBS);
                let q:i32=0;
                while(q<sl){STEMA[soff+q]=OUTS[q];q=q+1;}
                a_put(WORDA,4*nw,to);
                a_put(WORDA,4*nw+1,tl);
                a_put(WORDA,4*nw+2,soff);
                a_put(WORDA,4*nw+3,sl);
                soff=soff+sl;
                nw=nw+1;
            }
        }
        i=i+1;
    }
    // claim stem set (deduped)
    let ncs:i32=0;
    i=0;
    while(i<nw){
        let so:i32=a_get(WORDA,4*i+2);
        let sl2:i32=a_get(WORDA,4*i+3);
        if(in_stems(STEMA[so..so+sl2],STEMA,CSTEMA,ncs)==0){
            a_put(CSTEMA,2*ncs,so);
            a_put(CSTEMA,2*ncs+1,sl2);
            ncs=ncs+1;
        }
        i=i+1;
    }
    // strip leading gerund ("Drinking coffee causes..." -> core without Drinking)
    let cs:i32=0;
    if(nw>0){
        let to0:i32=a_get(WORDA,0);
        let tl0:i32=a_get(WORDA,1);
        let t0:[]u8=claim[to0..to0+tl0];
        let ll0:i32=lower_copy(t0,TMPS);
        if(ew(TMPS,0,ll0,"ing")==1){
            let so0:i32=a_get(WORDA,2);
            let sl0:i32=a_get(WORDA,3);
            if(in_list(STEMA[so0..so0+sl0],lex_verb())==1){cs=1;}
        }
    }
    // anchors: first/last content-word stems of the core
    let firstA:[]u8="";
    let lastA:[]u8="";
    if(cs<nw){
        let so1:i32=a_get(WORDA,4*cs+2);
        let sl1:i32=a_get(WORDA,4*cs+3);
        firstA=STEMA[so1..so1+sl1];
        let so2:i32=a_get(WORDA,4*(nw-1)+2);
        let sl2b:i32=a_get(WORDA,4*(nw-1)+3);
        lastA=STEMA[so2..so2+sl2b];
    }
    // predicate: first verb-stem core token, skipping reporting verbs
    let pred:[]u8="";
    let pfound:i32=0;
    i=cs;
    while(i<nw){
        let to3:i32=a_get(WORDA,4*i);
        let tl3:i32=a_get(WORDA,4*i+1);
        let so3:i32=a_get(WORDA,4*i+2);
        let sl3:i32=a_get(WORDA,4*i+3);
        let s3:[]u8=STEMA[so3..so3+sl3];
        if(in_list(s3,lex_verb())==1){
            let ll3:i32=lower_copy(claim[to3..to3+tl3],TMPS);
            if(in_list(TMPS[0..ll3],lex_reporting())==0 && in_list(s3,lex_reporting())==0){
                pred=s3;
                pfound=1;
                break;
            }
        }
        i=i+1;
    }
    if(pfound==0){
        // fallback: first auxiliary/copula among ALL tokens
        let fi:i32=0;
        while(fi<nct){
            let to4:i32=a_get(TOKA,2*fi);
            let tl4:i32=a_get(TOKA,2*fi+1);
            let ll4:i32=lower_copy(claim[to4..to4+tl4],TMPS);
            let lw4:[]u8=TMPS[0..ll4];
            if(in_list(lw4,lex_be())==1){pred="be";break;}
            if(in_list(lw4,lex_have())==1){pred="have";break;}
            fi=fi+1;
        }
    }
    // ---- overlap gate on the whole text ----
    let fl:i32=0;
    let ti:i32=0;
    while(ti<title.len){FULLB[fl]=title[ti];ti=ti+1;fl=fl+1;}
    FULLB[fl]=32;fl=fl+1;
    ti=0;
    while(ti<snip.len){FULLB[fl]=snip[ti];ti=ti+1;fl=fl+1;}
    let full:[]u8=FULLB[0..fl];
    let nft:i32=z_toks(full,TOKB,1024);
    let ntstm:i32=0;
    let soffB:i32=0;
    i=0;
    while(i<nft){
        let to5:i32=a_get(TOKB,2*i);
        let tl5:i32=a_get(TOKB,2*i+1);
        let sl5:i32=z_stem(full[to5..to5+tl5],OUTS,TMPS,VBS);
        let q5:i32=0;
        while(q5<sl5){STEMB[soffB+q5]=OUTS[q5];q5=q5+1;}
        a_put(TSTMB,2*ntstm,soffB);
        a_put(TSTMB,2*ntstm+1,sl5);
        soffB=soffB+sl5;
        ntstm=ntstm+1;
        i=i+1;
    }
    let need:i32=2;
    if(nw<3){need=1;}
    let inter:i32=0;
    i=0;
    while(i<ncs){
        let so6:i32=a_get(CSTEMA,2*i);
        let sl6:i32=a_get(CSTEMA,2*i+1);
        if(in_stems(STEMA[so6..so6+sl6],STEMB,TSTMB,ntstm)==1){inter=inter+1;}
        i=i+1;
    }
    if(inter<need){return 0;}
    // ---- B4-TMP / B4-CMP early decisions ----
    // temporal: 2=deny (reversed order/date mismatch); 1=affirm (order
    // confirmed by evidence pairs or date arithmetic); 0=suppress affirm
    // comparative: 2=deny (antonym/role swap); 0=suppress affirm
    // (comparative 1 = same comparison present -> normal pipeline AFFIRMs)
    let tsup:i32=0;
    let td:i32=temporal_decide(claim,TOKA,nct,full,TOKB,nft,sc);
    if(td==2){return 32+7;}
    if(td==1){return 16+5;}
    if(td==0){tsup=1;}
    let cd:i32=comp_decide(claim,TOKA,nct,full,TOKB,nft,sc);
    if(cd==2){return 32+8;}
    if(cd==0){tsup=1;}
    // ---- B4-QUANT: claim quantifier = first claim token ----
    let Qc:i32=0;
    if(nct>0){
        let toq:i32=a_get(TOKA,0);
        let tlq:i32=a_get(TOKA,1);
        let lq:i32=lower_copy(claim[toq..toq+tlq],TMPS);
        Qc=quant_code(TMPS[0..lq]);
    }
    // claim numbers (for the competing-subject value guard)
    let nnums:i32=claim_numbers(claim,NUMA,64);
    // ---- clause scan: title stream, then snippet stream ----
    AFFB[0]=0;
    let dr:i32=scan_text(title,STEMA,CSTEMA,ncs,STEMB,TSTMB,ntstm,firstA,lastA,pred,need,NUMA,nnums,claim,CLAUA,PROTB,TOKC,STEMC,CSTMC,LOWB,CLVB,TMPS,OUTS,VBS,AFFB,tsup,Qc,sc);
    if(dr!=0){return 32+dr;}
    dr=scan_text(snip,STEMA,CSTEMA,ncs,STEMB,TSTMB,ntstm,firstA,lastA,pred,need,NUMA,nnums,claim,CLAUA,PROTB,TOKC,STEMC,CSTMC,LOWB,CLVB,TMPS,OUTS,VBS,AFFB,tsup,Qc,sc);
    if(dr!=0){return 32+dr;}
    if(AFFB[0]==1){return 16+5;}
    return 6;
}

// ==================== driver ====================
fn reason_str(r:i32)[]u8{
    if(r==0){return "gate";}
    if(r==1){return "deny-lex";}
    if(r==2){return "antonym";}
    if(r==3){return "neg-scope";}
    if(r==4){return "competing-subject";}
    if(r==5){return "endorse";}
    if(r==7){return "temporal";}
    if(r==8){return "comparative";}
    if(r==9){return "quantifier";}
    return "neutral";
}
fn process_line(line:[]u8,sc:[]u8,ob:[]u8)void{
    let t1:i32=-1;
    let t2:i32=-1;
    let t3:i32=-1;
    let i:i32=0;
    while(i<line.len){
        if((line[i] as i32)==9){
            if(t1<0){t1=i;}
            else{
                if(t2<0){t2=i;}
                else{if(t3<0){t3=i;break;}}
            }
        }
        i=i+1;
    }
    if(t3<0){return;}
    let idx:[]u8=line[0..t1];
    let claim:[]u8=line[t1+1..t2];
    let title:[]u8=line[t2+1..t3];
    let snip:[]u8=line[t3+1..line.len];
    let r:i32=r12_classify(claim,title,snip,sc);
    let tag:i32=r/16;
    let rsn:i32=r-tag*16;
    let o:i32=0;
    let k:i32=0;
    while(k<idx.len){ob[o]=idx[k];o=o+1;k=k+1;}
    ob[o]=32;o=o+1;
    ob[o]=(48+tag) as u8;o=o+1;
    ob[o]=32;o=o+1;
    let rs:[]u8=reason_str(rsn);
    k=0;
    while(k<rs.len){ob[o]=rs[k];o=o+1;k=k+1;}
    ob[o]=10;o=o+1;
    _zag_print(ob[0..o]);
    return;
}
fn main()i32{
    let path:[]u8=_zag_arg(1);
    if(path.len==0){
        _zag_println("usage: r12 <input.tsv>");
        return 2;
    }
    let data:[]u8=read_all(path);
    if(data.len==0){
        _zag_println("r12: cannot read input");
        return 3;
    }
    let sc:[]u8=z_alloc(120000);
    if(sc.len==0){return 4;}
    let ob:[]u8=z_alloc(8192);
    if(ob.len==0){return 5;}
    let n:i32=data.len;
    let i:i32=0;
    let ls:i32=0;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;}
        else{if((data[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (data[le-1] as i32)==13){le=le-1;}
            if(le>ls){process_line(data[ls..le],sc,ob);}
            ls=i+1;
        }
        i=i+1;
    }
    return 0;
}

// r12_cau.zag -- R1/R2 repaired stance classifier + V4 CAUSAL fixes, pure Zag.
//
// V4-CAU (crew B3): repairs causal-structure handling. Changes vs r12_v3:
//  (1) lex_verb + psyn_has: causal verbs (float/sink/result/expand/occur/
//      happen/melt/freeze families, incl. irregular stems) are predicates,
//      so because/mechanism claims are affirmable and deniable (was: the
//      V3-03 root cause -- pred="" -> every clause skipped);
//  (2) neg_scope is causal-scope aware: "not X but Y", "because of" after
//      the predicate, and negation on a non-claim upstream subject no longer
//      count; claim/evidence polarity agreement (cneg) with double negation;
//  (3) float/sink antonym generalized with polarity (negated antonym
//      endorses); "not because of <claim cause>" and post-predicate negated
//      claim stems ("not fog") deny;
//  (4) prevented-cause: "X prevents Y" affirmed by "[negated effect]
//      because [X]";
//  (5) causal-mechanism endorsement: a because/due claim is affirmed by a
//      clause that asserts its causal verb (first verb after because/due)
//      unnegated with endorsement-level overlap, even when the predicate
//      itself is not restated ("water expands when it freezes").
//
// Ports tools/proto_r12.py EXACTLY (byte-identical tags on the frozen
// course). Frozen prereg: phase3/PREREG.md (commit 266ca4e18593de287a86daaf107cb36680577657).
//
// R1 (M1b): no fallthrough-to-AFFIRM. AFFIRM requires positive endorsement
//   evidence (predicate-level assertion of the claim's proposition,
//   negation-scoped). Default NEUTRAL. Topic overlap != endorsement.
// R2 (M1a): negation-aware stance. UTF-8 negation lexicon (curly quotes
//   etc.), clause-scoped negation; no 100-char proximity blast.
//
// Interface: argv[1] = TSV file with lines  idx \t claim \t title \t snippet
// Output per line:  idx SP tag SP reason \n
//   tag: 0=IRRELEVANT/NEUTRAL, 1=AFFIRM, 2=DENY
//   reason: gate | deny-lex | antonym | neg-scope | competing-subject
//           | endorse | neutral
//
// Deterministic, zero RNG, pure Zag. Compiled with the pinned toolchain:
//   ~/workspace/tnn-lab/toolchain/bin/znc_linux_x86_64_abed8aa1
//
// znc gotchas honored (see ~/AGENTS.md): no `as []i32` indexed tables
// (u8 arenas + LE helpers instead), no slice ==, no argc gate, all slices
// far below the 2^25 limit, no deep else-nesting, no large-struct tricks.

// ==================== memory ====================
fn z_alloc(n:i32)[]u8{
    if(n<1 || n>33554432){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn z_free(b:[]u8)void{
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}
fn z_cstr(s:[]u8)[]u8{
    if(s.len<1 || s.len>4194304){return "";}
    let b:[]u8=z_alloc(s.len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<s.len){b[i]=s[i];i=i+1;}
    return b;
}

// ==================== file input ====================
fn read_all(path:[]u8)[]u8{
    let cs:[]u8=z_cstr(path);
    if(cs.len==0){return "";}
    let fd:i64=_zag_raw_syscall(2,_zag_slice_ptr(cs) as i64,0,0,0,0,0);
    z_free(cs);
    if(fd<0){return "";}
    let cap:i32=8388608;
    let buf:[]u8=z_alloc(cap);
    if(buf.len==0){_zag_raw_syscall(3,fd,0,0,0,0,0);return "";}
    let at:i32=0;
    while(at<cap){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(at as i64),(cap-at) as i64,0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return buf[0..at];
}

// ==================== byte utils ====================
fn z_eq(a:[]u8,b:[]u8)i32{
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}
fn z_has(h:[]u8,n:[]u8)i32{
    if(n.len==0){return 1;}
    if(n.len>h.len){return 0;}
    let i:i32=0;
    while(i+n.len<=h.len){
        let k:i32=0;
        while(k<n.len){if(h[i+k]!=n[k]){break;}k=k+1;}
        if(k==n.len){return 1;}
        i=i+1;
    }
    return 0;
}
fn z_starts(h:[]u8,n:[]u8)i32{
    if(n.len>h.len){return 0;}
    let k:i32=0;
    while(k<n.len){if(h[k]!=n[k]){return 0;}k=k+1;}
    return 1;
}
// UTF-8 code point count (ASCII + lead bytes only)
fn z_cplen(s:[]u8)i32{
    return z_cplen_range(s,0,s.len);
}
fn z_cplen_range(s:[]u8,a:i32,b:i32)i32{
    let n:i32=0;
    let i:i32=a;
    while(i<b){
        let by:i32=s[i] as i32;
        if(by<128 || by>=192){n=n+1;}
        i=i+1;
    }
    return n;
}
// Python str[0].isupper() approximation: ASCII A-Z + Latin-1 C0-DE (not D7)
fn z_isupper1(s:[]u8)i32{
    if(s.len==0){return 0;}
    let b0:i32=s[0] as i32;
    if(b0>=65 && b0<=90){return 1;}
    if(b0==195 && s.len>=2){
        let b1:i32=s[1] as i32;
        if(b1>=128 && b1<=158 && b1!=151){return 1;}
    }
    return 0;
}
fn z_isdig(b:i32)i32{
    if(b>=48 && b<=57){return 1;}
    return 0;
}
fn z_isvowel(b:i32)i32{
    if(b==97 || b==101 || b==105 || b==111 || b==117){return 1;}
    return 0;
}
fn z_isspace(b:i32)i32{
    if(b==32 || b==9 || b==10 || b==13 || b==11 || b==12){return 1;}
    return 0;
}
// LE int arena accessors (never `as []i32`; see ZNC-2026-09-21-007)
fn a_put(b:[]u8,i:i32,v:i32)void{
    let o:i32=i<<2;
    b[o]=(v & 255) as u8;
    b[o+1]=((v>>8) & 255) as u8;
    b[o+2]=((v>>16) & 255) as u8;
    b[o+3]=((v>>24) & 255) as u8;
    return;
}
fn a_get(b:[]u8,i:i32)i32{
    let o:i32=i<<2;
    let v:i32=(b[o] as i32) & 255;
    v=v | (((b[o+1] as i32) & 255)<<8);
    v=v | (((b[o+2] as i32) & 255)<<16);
    v=v | (((b[o+3] as i32) & 255)<<24);
    return v;
}
// ASCII lowercase copy (+ Latin-1 C3 80-9E); returns length
fn lower_copy(t:[]u8,out:[]u8)i32{
    let n:i32=t.len;
    let i:i32=0;
    let k:i32=0;
    while(i<n){
        let b:i32=t[i] as i32;
        if(b>=65 && b<=90){out[k]=(b+32) as u8;k=k+1;i=i+1;}
        else{
            if(b==195 && i+1<n){
                let b2:i32=t[i+1] as i32;
                if(b2>=128 && b2<=158 && b2!=151){
                    out[k]=195 as u8;out[k+1]=(b2+32) as u8;k=k+2;i=i+2;
                }else{out[k]=b as u8;k=k+1;i=i+1;}
            }else{out[k]=b as u8;k=k+1;i=i+1;}
        }
    }
    return k;
}
// tail match: s[b-lit.len .. b) == lit
fn ew(s:[]u8,a:i32,b:i32,lit:[]u8)i32{
    if(lit.len>b-a){return 0;}
    let k:i32=0;
    while(k<lit.len){
        if((s[b-lit.len+k] as i32)!=(lit[k] as i32)){return 0;}
        k=k+1;
    }
    return 1;
}
fn in_stems(s:[]u8,base:[]u8,ar:[]u8,n:i32)i32{
    let i:i32=0;
    while(i<n){
        let so:i32=a_get(ar,2*i);
        let sl:i32=a_get(ar,2*i+1);
        if(z_eq(s,base[so..so+sl])==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ==================== lexicons ====================
// Blobs are \n-separated with leading + trailing \n; in_list does
// boundary-exact matching. Contents transcribed from the frozen prototype
// (tools/proto_r12.py); verified mechanically by tools/lexcheck (see R12_PORT.md).
fn lex_stop()[]u8{
    return "\na\nabout\nabove\nafter\nagain\nam\nan\nand\nare\naren\nas\nat\nbe\nbeen\nbefore\nbeing\nbelow\nbut\nby\ncan\ncould\ncouldn\nd\ndid\ndidn\ndo\ndoes\ndoesn\ndoing\ndon\ndown\nduring\nelse\nfor\nfrom\nfurther\nhad\nhadn\nhas\nhasn\nhave\nhaven\nhaving\nhe\nher\nhere\nhim\nhis\ni\nif\nin\ninto\nis\nisn\nit\nits\njust\nll\nmay\nme\nmight\nmightn\nmust\nmustn\nmy\nno\nnor\nnot\nnow\nof\noff\non\nonce\nonly\nor\nought\nour\nout\nover\nown\nre\ns\nsame\nshall\nshan\nshe\nshould\nshouldn\nso\nt\nthan\nthat\nthe\ntheir\nthem\nthen\nthere\nthese\nthey\nthis\nthose\nthrough\nto\ntoo\nunder\nup\nve\nvery\nwas\nwasn\nwe\nwere\nweren\nwhat\nwhen\nwhere\nwhich\nwho\nwhom\nwill\nwith\nwon\nwould\nwouldn\nyou\nyour\n";
}
fn lex_verb()[]u8{
    return "\nam\nare\nate\nbe\nbeen\nbeing\nblock\nblocks\nboil\nboils\nbreak\nbreaks\nbuild\nbuilds\ncan\ncause\ncaused\ncauses\nclear\nclears\nconfirm\nconfirmed\nconfirms\nconnect\nconnects\ncontain\ncontains\ncould\ncure\ncured\ncures\ndemonstrate\ndemonstrates\ndid\ndisrupt\ndisrupts\ndissolve\ndissolved\ndissolves\ndo\ndoes\ndrank\ndrink\ndrinking\ndrinks\neat\neating\neats\nexpand\nfake\nfaked\nfakes\nfall\nfalls\nfind\nfinds\nfloat\nflow\nflows\nform\nforms\nfound\nfreeze\nfreez\nfroze\nfrozen\ngrow\ngrows\nhad\nhappen\nhas\nhave\nheal\nheals\nhit\nhits\nimprove\nimproves\nincrease\nincreases\nis\nlead\nleads\nleak\nleaked\nlink\nlinks\nlower\nlowers\nmade\nmake\nmakes\nmay\nmelt\nmight\nmust\noccur\norbit\norbits\noriginate\noriginated\noriginates\nprevent\nprevents\nproduce\nproduces\nprove\nproved\nproves\nraise\nraises\nreduce\nreduces\nremedy\nresult\nrevolve\nrevolves\nrise\nrises\nsaid\nsay\nsays\nsee\nsees\nshall\nshould\nshow\nshowed\nshown\nshows\nsank\nsink\nsunk\nspread\nspreads\nstate\nstated\nstates\nstop\nstops\nstrike\nstrikes\nstruck\ntake\ntakes\ntie\nties\ntook\ntransmit\ntransmits\ntreat\ntreated\ntreats\ntrigger\ntriggers\nuse\nused\nuses\nvisible\nwas\nwere\nwill\nworsen\nworsens\nwould\n";
}
fn lex_reporting()[]u8{
    return "\nargue\nargues\nbelieve\nbelieves\nclaim\nclaimed\nclaims\nreport\nreported\nreports\nsaid\nsay\nsays\nshow\nshowed\nshown\nshows\nstate\nstates\nsuggest\nsuggests\nthink\nthinks\n";
}
fn lex_neg()[]u8{
    return "\nbarely\nhardly\nneither\nnever\nno\nnone\nnor\nnot\nnothing\nscarcely\nwithout\n";
}
fn lex_strong()[]u8{
    return "\ncontrary\ndebunk\ndenied\ndenies\ndisproven\nfake\nfaked\nfalse\nhoax\nincorrect\nmyth\nrefuted\nwrong\n";
}
fn lex_weak()[]u8{
    return "\nalthough\ndespite\nhowever\nthough\nunlikely\n";
}
fn lex_super()[]u8{
    return "\nbest\nbiggest\nfirst\nhighest\nlargest\nleast\nlongest\nmost\nonly\nsmallest\ntallest\nworst\n";
}
fn lex_conjskip()[]u8{
    return "\nalso\nalthough\nand\nbecause\nbut\ndespite\neven\nfor\nhence\nhowever\nif\njust\nnor\nor\nsince\nso\nstill\nthen\nthough\nthus\nwhen\nwhere\nwhile\nyet\n";
}
fn lex_whaux()[]u8{
    return "\nare\ncan\ncould\ndid\ndo\ndoes\nhow\nis\nshould\nwas\nwere\nwhat\nwhen\nwhere\nwhich\nwho\nwhom\nwhy\nwill\nwould\n";
}
fn lex_filler()[]u8{
    return "\na\nan\nand\nas\nat\nbut\nby\nfor\nfrom\nin\nof\non\nor\nthe\nto\nwith\n";
}
fn lex_be()[]u8{
    return "\nis\nare\nwas\nwere\nam\nbe\nbeen\nbeing\n";
}
fn lex_have()[]u8{
    return "\nhas\nhave\nhad\n";
}
fn lex_worse()[]u8{
    return "\nworsen\nwors\nbad\nharm\ndamag\nhurt\ndeclin\ndeterior\npoor\nill\n";
}
fn in_list(w:[]u8,blob:[]u8)i32{
    let i:i32=0;
    while(i<blob.len){
        if((blob[i] as i32)==10){
            let k:i32=0;
            while(k<w.len && i+1+k<blob.len && blob[i+1+k]==w[k]){k=k+1;}
            if(k==w.len && i+1+k<blob.len && (blob[i+1+k] as i32)==10){return 1;}
        }
        i=i+1;
    }
    return 0;
}
// strong-deny stem prefixes: debunk disprov refut incorrect wrong myth hoax fals
fn deny_prefix(st:[]u8)i32{
    if(z_starts(st,"debunk")==1){return 1;}
    if(z_starts(st,"disprov")==1){return 1;}
    if(z_starts(st,"refut")==1){return 1;}
    if(z_starts(st,"incorrect")==1){return 1;}
    if(z_starts(st,"wrong")==1){return 1;}
    if(z_starts(st,"myth")==1){return 1;}
    if(z_starts(st,"hoax")==1){return 1;}
    if(z_starts(st,"fals")==1){return 1;}
    return 0;
}
// SYN table: 1 if stem s is in the synonym set of predicate pred.
// V4-CAU: causal-verb predicates (float/sink/result/expand/occur/happen/
// melt/freeze families) so because/mechanism claims are affirmable and
// deniable; irregular stems (sank/sunk/froze/freez/frozen) included.
fn psyn_has(s:[]u8,pred:[]u8)i32{
    if(z_eq(pred,"boil")==1){return z_eq(s,"boil");}
    if(z_eq(pred,"cause")==1){return z_eq(s,"cause");}
    if(z_eq(pred,"cure")==1){return z_eq(s,"cure");}
    if(z_eq(pred,"dissolve")==1){return z_eq(s,"dissolve");}
    if(z_eq(pred,"fake")==1){return z_eq(s,"fake");}
    if(z_eq(pred,"strike")==1){return z_eq(s,"strike");}
    if(z_eq(pred,"use")==1){return z_eq(s,"use");}
    if(z_eq(pred,"show")==1){return z_eq(s,"show");}
    if(z_eq(pred,"float")==1){return z_eq(s,"float");}
    if(z_eq(pred,"sink")==1 || z_eq(pred,"sank")==1 || z_eq(pred,"sunk")==1){
        if(z_eq(s,"sink")==1){return 1;}
        if(z_eq(s,"sank")==1){return 1;}
        return z_eq(s,"sunk");
    }
    if(z_eq(pred,"result")==1){return z_eq(s,"result");}
    if(z_eq(pred,"expand")==1){return z_eq(s,"expand");}
    if(z_eq(pred,"occur")==1 || z_eq(pred,"happen")==1){
        if(z_eq(s,"occur")==1){return 1;}
        return z_eq(s,"happen");
    }
    if(z_eq(pred,"melt")==1){return z_eq(s,"melt");}
    if(z_eq(pred,"freeze")==1 || z_eq(pred,"freez")==1 || z_eq(pred,"frozen")==1 || z_eq(pred,"froze")==1){
        if(z_eq(s,"freeze")==1){return 1;}
        if(z_eq(s,"freez")==1){return 1;}
        if(z_eq(s,"frozen")==1){return 1;}
        return z_eq(s,"froze");
    }
    if(z_eq(pred,"orbit")==1){
        if(z_eq(s,"orbit")==1){return 1;}
        return z_eq(s,"revolve");
    }
    if(z_eq(pred,"originate")==1){
        if(z_eq(s,"originate")==1){return 1;}
        return z_eq(s,"leak");
    }
    if(z_eq(pred,"have")==1){
        if(z_eq(s,"have")==1){return 1;}
        if(z_eq(s,"has")==1){return 1;}
        return z_eq(s,"had");
    }
    if(z_eq(pred,"be")==1){
        if(z_eq(s,"be")==1){return 1;}
        if(z_eq(s,"is")==1){return 1;}
        if(z_eq(s,"are")==1){return 1;}
        if(z_eq(s,"was")==1){return 1;}
        if(z_eq(s,"were")==1){return 1;}
        return z_eq(s,"am");
    }
    return z_eq(s,pred);
}
fn has_superlative(stemC:[]u8,cstmC:[]u8,nct:i32)i32{
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        if(in_list(stemC[so..so+sl],lex_super())==1){return 1;}
        i=i+1;
    }
    return 0;
}

// ==================== tokenizer ====================
// Python: re.findall(r"[A-Za-z0-9\u2019']+(?:-[A-Za-z0-9\u2019']+)*", text)
// is_wc returns 0 (not a word char), 1 (1-byte word char), 3 (U+2019).
fn is_wc(s:[]u8,i:i32)i32{
    if(i>=s.len){return 0;}
    let b:i32=s[i] as i32;
    if(b>=65 && b<=90){return 1;}
    if(b>=97 && b<=122){return 1;}
    if(b>=48 && b<=57){return 1;}
    if(b==39){return 1;}
    if(b==226 && i+2<s.len){
        if((s[i+1] as i32)==128 && (s[i+2] as i32)==153){return 3;}
    }
    return 0;
}
// Writes (off,len) pairs into ar (2 slots each); returns token count.
fn z_toks(t:[]u8,ar:[]u8,max:i32)i32{
    let n:i32=t.len;
    let i:i32=0;
    let k:i32=0;
    while(i<n && k<max){
        let l:i32=is_wc(t,i);
        if(l==0){i=i+1;}
        else{
            let st:i32=i;
            while(l>0){
                i=i+l;
                if(i<n && (t[i] as i32)==45){
                    let l2:i32=is_wc(t,i+1);
                    if(l2>0){i=i+1;l=l2;continue;}
                }
                l=is_wc(t,i);
            }
            a_put(ar,2*k,st);
            a_put(ar,2*k+1,i-st);
            k=k+1;
        }
    }
    return k;
}

// ==================== stemmer ====================
// Exact port of proto_r12.stem. t = original token; writes stem bytes to
// out; tmp/vb are scratch (>= 256 / >= 64). Returns stem length.
fn z_stem(t:[]u8,out:[]u8,tmp:[]u8,vb:[]u8)i32{
    let n:i32=t.len;
    // 1. lowercase (ASCII + Latin-1 C3 80-9E)
    let i:i32=0;
    let k:i32=0;
    while(i<n){
        let b:i32=t[i] as i32;
        if(b>=65 && b<=90){tmp[k]=(b+32) as u8;k=k+1;i=i+1;}
        else{
            if(b==195 && i+1<n){
                let b2:i32=t[i+1] as i32;
                if(b2>=128 && b2<=158 && b2!=151){
                    tmp[k]=195 as u8;tmp[k+1]=(b2+32) as u8;k=k+2;i=i+2;
                }else{tmp[k]=b as u8;k=k+1;i=i+1;}
            }else{tmp[k]=b as u8;k=k+1;i=i+1;}
        }
    }
    // 2. possessive 's
    if(k>=2 && (tmp[k-2] as i32)==39 && (tmp[k-1] as i32)==115){k=k-2;}
    // 3. strip ASCII quotes
    while(k>0 && (tmp[k-1] as i32)==39){k=k-1;}
    let j0:i32=0;
    while(j0<k && (tmp[j0] as i32)==39){j0=j0+1;}
    // 4. short guard (char count, like Python len())
    let nc:i32=z_cplen_range(tmp,j0,k);
    if(nc<=3){
        let o:i32=0;
        while(j0+o<k){out[o]=tmp[j0+o];o=o+1;}
        return o;
    }
    let app:i32=-1;
    let done:i32=0;
    // ies -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ies")==1){k=k-3;app=121;done=1;}
    // sses/xes/zes/ches/shes -> strip 2
    if(done==0 && nc>5){
        if(ew(tmp,j0,k,"sses")==1 || ew(tmp,j0,k,"xes")==1 || ew(tmp,j0,k,"zes")==1 || ew(tmp,j0,k,"ches")==1 || ew(tmp,j0,k,"shes")==1){
            k=k-2;done=1;
        }
    }
    // es -> strip 1
    if(done==0 && ew(tmp,j0,k,"es")==1){k=k-1;done=1;}
    // s (not ss) -> strip 1
    if(done==0 && ew(tmp,j0,k,"s")==1 && ew(tmp,j0,k,"ss")==0){k=k-1;done=1;}
    // ied -> y
    if(done==0 && nc>5 && ew(tmp,j0,k,"ied")==1){k=k-3;app=121;done=1;}
    // ed
    if(done==0 && ew(tmp,j0,k,"ed")==1){
        let cl:i32=0;
        while(j0+cl<k-2){vb[cl]=tmp[j0+cl];cl=cl+1;}
        vb[cl]=101;cl=cl+1;
        if(in_list(vb[0..cl],lex_verb())==1){k=k-2;app=101;}
        else{
            if(nc>5 && z_isvowel(tmp[k-3] as i32)==1){k=k-1;}
            else{k=k-2;}
        }
        done=1;
    }
    // ing
    if(done==0 && nc>6 && ew(tmp,j0,k,"ing")==1){
        let bl:i32=0;
        while(j0+bl<k-3){vb[bl]=tmp[j0+bl];bl=bl+1;}
        vb[bl]=101;bl=bl+1;
        if(in_list(vb[0..bl],lex_verb())==1){k=k-3;app=101;}
        else{
            let bend:i32=0;
            if(k-3>j0){bend=tmp[k-4] as i32;}
            if(k-3>j0 && bend==101){k=k-3;}
            else{
                if(k-3>j0 && z_isvowel(bend)==0){k=k-3;}
                else{k=k-3;app=101;}
            }
        }
        done=1;
    }
    // ly
    if(done==0 && nc>5 && ew(tmp,j0,k,"ly")==1){k=k-2;done=1;}
    // emit
    let o2:i32=0;
    while(j0+o2<k){out[o2]=tmp[j0+o2];o2=o2+1;}
    if(app>=0){out[o2]=app as u8;o2=o2+1;}
    return o2;
}

// ==================== clause splitter ====================
// Python: protect (\d)\.(\d) (non-overlapping, left to right), then split
// on [.!?;\u2014]+, strip, drop empties. prot must be zeroed, len >= t.len.
fn z_clauses(t:[]u8,ar:[]u8,prot:[]u8,max:i32)i32{
    let n:i32=t.len;
    // prot is a reused scratch buffer: clear this call's range (Python
    // rebuilds the protected string fresh on every call)
    let z:i32=0;
    while(z<n){prot[z]=0;z=z+1;}
    let p:i32=0;
    while(p+2<n){
        if(z_isdig(t[p] as i32)==1 && (t[p+1] as i32)==46 && z_isdig(t[p+2] as i32)==1){
            prot[p+1]=1;
            p=p+3;
        }else{p=p+1;}
    }
    let k:i32=0;
    let i:i32=0;
    let st:i32=-1;
    while(i<n && k<max){
        let b:i32=t[i] as i32;
        let sep:i32=0;
        let w:i32=1;
        if(b==46 && prot[i]==0){sep=1;}
        if(b==33 || b==63 || b==59){sep=1;}
        if(b==226 && i+2<n && (t[i+1] as i32)==128 && (t[i+2] as i32)==148){sep=1;w=3;}
        if(sep==1){
            if(st>=0){
                // keep the original spacing (Python only drops parts that
                // strip to empty); z_blank mirrors str.strip() emptiness
                if(z_blank(t[st..i])==0){
                    a_put(ar,2*k,st);
                    a_put(ar,2*k+1,i-st);
                    k=k+1;
                }
                st=-1;
            }
            i=i+w;
        }else{
            if(st<0){st=i;}
            i=i+1;
        }
    }
    if(st>=0 && k<max){
        if(z_blank(t[st..n])==0){
            a_put(ar,2*k,st);
            a_put(ar,2*k+1,n-st);
            k=k+1;
        }
    }
    return k;
}
// 1 if s is empty or all ASCII whitespace (mirrors Python str.strip()=="" for
// the ASCII-whitespace cases that reach clause filtering; a clause of only
// non-ASCII whitespace cannot occur here because toks() would find no token
// and scan_text skips zero-token clauses anyway)
fn z_blank(s:[]u8)i32{
    let i:i32=0;
    while(i<s.len){
        if(z_isspace(s[i] as i32)==0){return 0;}
        i=i+1;
    }
    return 1;
}

// ==================== stance helpers ====================
// Negation marker test: NEG_TOKENS, ASCII n't, U+2019 n't.
fn is_negw(w:[]u8)i32{
    if(in_list(w,lex_neg())==1){return 1;}
    if(ew(w,0,w.len,"n't")==1){return 1;}
    let ll:i32=w.len;
    if(ll>=4 && (w[ll-4] as i32)==226 && (w[ll-3] as i32)==128 && (w[ll-2] as i32)==153 && (w[ll-1] as i32)==116){return 1;}
    return 0;
}
// Nearest token before pi that can head the predicate's subject: skips
// filler words and negation markers. -1 if none.
fn subj_idx(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,tmp:[]u8)i32{
    let j:i32=pi-1;
    while(j>=0){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        let w:[]u8=tmp[0..ll];
        if(in_list(w,lex_filler())==1){j=j-1;continue;}
        if(is_negw(w)==1){j=j-1;continue;}
        return j;
    }
    return -1;
}
// 1 if a "because of" explanation adjunct follows the predicate: the
// negation then scopes the explanation ("do not prevent disease because
// of magic"), not the claim's proposition.
fn has_cexp(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,tmp:[]u8)i32{
    let k:i32=pi+1;
    while(k+1<nct){
        let to:i32=a_get(tokC,2*k);
        let tl:i32=a_get(tokC,2*k+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){
            let ta:i32=a_get(tokC,2*(k+1));
            let tb:i32=a_get(tokC,2*(k+1)+1);
            let lc:i32=lower_copy(clause[ta..ta+tb],tmp);
            if(z_eq(tmp[0..lc],"of")==1){return 1;}
        }
        k=k+1;
    }
    return 0;
}
// 1 if lower(word) occurs in tokens (from, from+span].
fn has_word_after(clause:[]u8,tokC:[]u8,nct:i32,from:i32,span:i32,word:[]u8,tmp:[]u8)i32{
    let b:i32=from+1;
    let lim:i32=from+span;
    if(lim>=nct){lim=nct-1;}
    while(b<=lim){
        let to:i32=a_get(tokC,2*b);
        let tl:i32=a_get(tokC,2*b+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],word)==1){return 1;}
        b=b+1;
    }
    return 0;
}
// Negation scoping the predicate: marker within 4 tokens before pi, with
// causal scoping guards (V4-CAU):
//  (i)   "not X but Y": a "but" between marker and pi means the marker
//        scopes the contrasted alternative, not the predicate;
//  (ii)  "because of" after pi: the marker scopes the explanation adjunct;
//  (iii) marker directly before a non-claim subject ("no harvest causes
//        famine"): the negation belongs to an upstream chain link.
fn neg_scope(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,tmp:[]u8)i32{
    let sj:i32=subj_idx(clause,tokC,nct,pi,tmp);
    let snc:i32=0;
    if(sj>=0){
        let so:i32=a_get(cstmC,2*sj);
        let sl:i32=a_get(cstmC,2*sj+1);
        if(in_stems(stemC[so..so+sl],stemA,cstemA,ncs)==0){snc=1;}
    }
    let ce:i32=has_cexp(clause,tokC,nct,pi,tmp);
    let j:i32=pi-4;
    if(j<0){j=0;}
    while(j<pi && j<nct){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(is_negw(tmp[0..ll])==1){
            let skip:i32=0;
            if(has_word_after(clause,tokC,nct,j,pi-j-1,"but",tmp)==1){skip=1;}
            if(ce==1){skip=1;}
            if(sj>=0 && j==sj-1 && snc==1){skip=1;}
            if(skip==0){return 1;}
        }
        j=j+1;
    }
    return 0;
}
// 1 if the claim is causal: predicate is cause/lead, or the claim names
// "because"/"due" (drives the post-predicate negated-cause DENY rule).
fn claim_causal(claim:[]u8,tokA:[]u8,nct:i32,pred:[]u8,tmp:[]u8)i32{
    if(z_eq(pred,"cause")==1 || z_eq(pred,"lead")==1){return 1;}
    let fi:i32=0;
    while(fi<nct){
        let to:i32=a_get(tokA,2*fi);
        let tl:i32=a_get(tokA,2*fi+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){return 1;}
        if(z_eq(tmp[0..ll],"due")==1){return 1;}
        fi=fi+1;
    }
    return 0;
}
// Claim-side negation: 1 if the claim negates its own predicate
// ("The reason ice does not sink..."). Plain marker scan, no scoping
// guards: the claim's own polarity is what matters.
fn claim_neg(claim:[]u8,tokA:[]u8,nct:i32,pred:[]u8,outs:[]u8,tmps:[]u8,vbs:[]u8)i32{
    let pi:i32=-1;
    let i:i32=0;
    while(i<nct){
        let to:i32=a_get(tokA,2*i);
        let tl:i32=a_get(tokA,2*i+1);
        let sl:i32=z_stem(claim[to..to+tl],outs,tmps,vbs);
        if(psyn_has(outs[0..sl],pred)==1){pi=i;break;}
        i=i+1;
    }
    if(pi<0){return 0;}
    let j:i32=pi-4;
    if(j<0){j=0;}
    while(j<pi){
        let to2:i32=a_get(tokA,2*j);
        let tl2:i32=a_get(tokA,2*j+1);
        let ll:i32=lower_copy(claim[to2..to2+tl2],tmps);
        if(is_negw(tmps[0..ll])==1){return 1;}
        j=j+1;
    }
    return 0;
}
// Index of the first float/sink antonym token in the clause, or -1.
// mode 0: claim asserts float -> find sink/sank/sunk;
// mode 1: claim asserts sink  -> find float.
fn ant_idx(stemC:[]u8,cstmC:[]u8,nct:i32,mode:i32)i32{
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        let st:[]u8=stemC[so..so+sl];
        if(mode==0){
            if(z_eq(st,"sink")==1 || z_eq(st,"sank")==1 || z_eq(st,"sunk")==1){return i;}
        }else{
            if(z_eq(st,"float")==1){return i;}
        }
        i=i+1;
    }
    return -1;
}
// float/sink antonym with claim/evidence polarity. Returns 0 (no hit),
// 1 (DENY: polarity clash), 2 (endorsement candidate: negated antonym
// agrees with the claim, e.g. "does not sink" for a float claim).
fn ant_pol(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,need:i32,nclm:i32,framed:i32,cneg:i32,tmp:[]u8)i32{
    if(nclm<1){return 0;}
    let ai:i32=-1;
    if(in_stems("float",stemA,cstemA,ncs)==1){ai=ant_idx(stemC,cstmC,nct,0);}
    if(ai<0 && in_stems("sink",stemA,cstemA,ncs)==1){ai=ant_idx(stemC,cstmC,nct,1);}
    if(ai<0){return 0;}
    if(is_interrog(clause,tokC,nct,tmp)==1){return 0;}
    let aneg:i32=neg_scope(clause,tokC,nct,ai,stemC,cstmC,stemA,cstemA,ncs,tmp);
    if(cneg==aneg){return 1;}
    if(nclm>=need && framed==0){return 2;}
    return 0;
}
// "not because of X" where X restates the claim: the evidence explicitly
// denies the claim's cause ("not because of vaccines", "not because of
// rain"). Returns 1 on a hit.
fn cause_deny(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,nclm:i32,tmp:[]u8)i32{
    if(nclm<1){return 0;}
    let bi:i32=0;
    while(bi<nct){
        let to:i32=a_get(tokC,2*bi);
        let tl:i32=a_get(tokC,2*bi+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){
            // V4-R2: the negation must immediately precede "because"
            // ("not because of X"). A marker two tokens back scopes the
            // effect verb instead ("didn't spread because...",
            // "without injury because...") and must not deny.
            let hm:i32=0;
            if(bi>=1){
                let qa:i32=a_get(tokC,2*(bi-1));
                let qb:i32=a_get(tokC,2*(bi-1)+1);
                let lq:i32=lower_copy(clause[qa..qa+qb],tmp);
                if(is_negw(tmp[0..lq])==1){hm=1;}
            }
            if(hm==1){
                let p:i32=bi+1;
                while(p<=bi+5 && p<nct){
                    let so:i32=a_get(cstmC,2*p);
                    let sl:i32=a_get(cstmC,2*p+1);
                    if(in_stems(stemC[so..so+sl],stemA,cstemA,ncs)==1){return 1;}
                    p=p+1;
                }
            }
        }
        bi=bi+1;
    }
    return 0;
}
// Prevented-cause endorsement: claim "X prevents Y" is affirmed by
// "[negated effect] because [X]" ("The fire didn't spread because the
// sprinkler system activated"). Returns 1 on a hit.
fn prevent_aff(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,firstA:[]u8,subjA:[]u8,nclm:i32,pred:[]u8,tmp:[]u8)i32{
    if(z_eq(pred,"prevent")==0){return 0;}
    // V4-R2: nclm>=1 (was >=2): the subject-anchor match after "because"
    // already establishes topicality; short-noun subjects ("dam") never
    // reach nclm=2 because len<=3 nouns are excluded from CSTEMA (CAU-P04).
    if(nclm<1){return 0;}
    let bi:i32=-1;
    let i:i32=0;
    while(i<nct){
        let to:i32=a_get(tokC,2*i);
        let tl:i32=a_get(tokC,2*i+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1){bi=i;break;}
        i=i+1;
    }
    if(bi<=0){return 0;}
    let hm:i32=0;
    let j:i32=0;
    while(j<bi){
        let qa:i32=a_get(tokC,2*j);
        let qb:i32=a_get(tokC,2*j+1);
        let lq:i32=lower_copy(clause[qa..qa+qb],tmp);
        if(is_negw(tmp[0..lq])==1){hm=1;}
        j=j+1;
    }
    if(hm==0){return 0;}
    // V4-R2: anchor on the claim SUBJECT ("dam"), not firstA — firstA skips
    // short nouns ("dam" is 3 letters), so the agent match never fired.
    let anchor:[]u8=firstA;
    if(subjA.len>0){anchor=subjA;}
    if(anchor.len==0){return 0;}
    let p:i32=bi+1;
    while(p<nct){
        let so:i32=a_get(cstmC,2*p);
        let sl:i32=a_get(cstmC,2*p+1);
        if(z_eq(stemC[so..so+sl],anchor)==1){return 1;}
        p=p+1;
    }
    return 0;
}
// Negation after the predicate denying a claim stem at clause end
// ("The delay was due to a mechanical fault, not fog"). Only for causal
// claims; the "but" guard keeps "not X but Y" contrasts out.
fn postpi_deny(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,nclm:i32,cneg:i32,cauflag:i32,subjA:[]u8,sstemb:[]u8,sstmc:[]u8,nsst:i32,tmp:[]u8)i32{
    if(cneg!=0 || cauflag!=1 || nclm<1){return 0;}
    let m:i32=pi+1;
    while(m<nct){
        let to:i32=a_get(tokC,2*m);
        let tl:i32=a_get(tokC,2*m+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(is_negw(tmp[0..ll])==1){break;}
        m=m+1;
    }
    if(m>=nct){return 0;}
    if(has_word_after(clause,tokC,nct,m,4,"but",tmp)==1){return 0;}
    let p:i32=m+1;
    while(p<=m+2 && p<nct){
        let so:i32=a_get(cstmC,2*p);
        let sl:i32=a_get(cstmC,2*p+1);
        let w:[]u8=stemC[so..so+sl];
        // V4-R2: the "not X" noun can be a short claim noun ("not fog") or
        // the claim subject ("not the dam") — both absent from CSTEMA.
        let hit:i32=in_stems(w,stemA,cstemA,ncs);
        if(hit==0){hit=in_stems(w,sstemb,sstmc,nsst);}
        if(hit==0 && subjA.len>0 && z_eq(w,subjA)==1){hit=1;}
        if(hit==1){
            if(p==nct-1){return 1;}
            if(has_word_after(clause,tokC,nct,p,2,"but",tmp)==1){return 1;}
        }
        p=p+1;
    }
    return 0;
}
// The entity the clause's predicate is asserted of, when it is NOT the
// claim's subject. Returns 1 if a competing proper noun exists.
fn competitor(clause:[]u8,tokC:[]u8,nct:i32,pi:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,firstA:[]u8,subjA:[]u8,tmp:[]u8)i32{
    // (1) immediate subject: nearest non-filler token before predicate
    let j:i32=pi-1;
    while(j>=0){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_filler())==0){break;}
        j=j-1;
    }
    if(j>=0){
        let to2:i32=a_get(tokC,2*j);
        let tl2:i32=a_get(tokC,2*j+1);
        let tj:[]u8=clause[to2..to2+tl2];
        if(z_cplen(tj)>=3 && z_isupper1(tj)==1){
            let so:i32=a_get(cstmC,2*j);
            let sl:i32=a_get(cstmC,2*j+1);
            if(in_stems(stemC[so..so+sl],stemA,cstemA,ncs)==0){
                // V4-R2: the claim's own subject is never a competitor
                // ("Ice" in "Ice floats on water." vs "Ice floats...").
                if(subjA.len==0 || z_eq(stemC[so..so+sl],subjA)==0){return 1;}
            }
        }
    }
    // (2) far-field: capitalized entity before predicate while the claim's
    // subject anchor (first content word) is absent from the clause
    if(in_stems(firstA,stemC,cstmC,nct)==0){
        let kk:i32=1;
        while(kk<pi && kk<nct){
            let to3:i32=a_get(tokC,2*kk);
            let tl3:i32=a_get(tokC,2*kk+1);
            let tk:[]u8=clause[to3..to3+tl3];
            if(z_cplen(tk)>=4 && z_isupper1(tk)==1){
                let so2:i32=a_get(cstmC,2*kk);
                let sl2:i32=a_get(cstmC,2*kk+1);
                let ll3:i32=lower_copy(tk,tmp);
                if(in_stems(stemC[so2..so2+sl2],stemA,cstemA,ncs)==0 && in_list(tmp[0..ll3],lex_conjskip())==0){
                    // V4-R2: claim's own subject exempt (see above).
                    if(subjA.len==0 || z_eq(stemC[so2..so2+sl2],subjA)==0){return 1;}
                }
            }
            kk=kk+1;
        }
    }
    return 0;
}
fn is_interrog(clause:[]u8,tokC:[]u8,nct:i32,tmp:[]u8)i32{
    if(z_has(clause,"?")==1){return 1;}
    if(nct>0){
        let to:i32=a_get(tokC,0);
        let tl:i32=a_get(tokC,1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(in_list(tmp[0..ll],lex_whaux())==1 && nct<=10){return 1;}
    }
    return 0;
}
// Claim numbers: runs matching Python re \d[\d,]* (digit followed by digits
// or commas), stored raw; has_claim_value() strips ","/" " from both sides
// before the substring test. No minimum length, no trailing-comma strip:
// "1," yields num "1" exactly as in the prototype.
fn claim_numbers(claim:[]u8,numa:[]u8,max:i32)i32{
    let n:i32=claim.len;
    let p:i32=0;
    let k:i32=0;
    while(p<n && k<max){
        if(z_isdig(claim[p] as i32)==1){
            let q:i32=p;
            while(q<n && (z_isdig(claim[q] as i32)==1 || (claim[q] as i32)==44)){q=q+1;}
            a_put(numa,2*k,p);
            a_put(numa,2*k+1,q-p);
            k=k+1;
            p=q;
        }else{p=p+1;}
    }
    return k;
}
fn has_claim_value(clause:[]u8,claim:[]u8,numa:[]u8,nnums:i32,clvB:[]u8,tmp:[]u8)i32{
    if(nnums==0){return 0;}
    let n:i32=clause.len;
    let k:i32=0;
    let i:i32=0;
    while(i<n){
        let b:i32=clause[i] as i32;
        if(b!=44 && b!=32){clvB[k]=clause[i];k=k+1;}
        i=i+1;
    }
    let cl2:[]u8=clvB[0..k];
    i=0;
    while(i<nnums){
        let no:i32=a_get(numa,2*i);
        let nl:i32=a_get(numa,2*i+1);
        let num:[]u8=claim[no..no+nl];
        let m:i32=num.len;
        let k2:i32=0;
        let jj:i32=0;
        while(jj<m){
            let b2:i32=num[jj] as i32;
            if(b2!=44 && b2!=32){tmp[k2]=num[jj];k2=k2+1;}
            jj=jj+1;
        }
        if(z_has(cl2,tmp[0..k2])==1){return 1;}
        i=i+1;
    }
    return 0;
}

// First lex_verb stem after the claim's first "because"/"due" token: the
// causal mechanism verb ("expands" in "...because water expands when it
// freezes"). Writes the stem into cvb, returns its length, 0 if none.
fn causal_verb(claim:[]u8,tokA:[]u8,nct:i32,cvb:[]u8,tmp:[]u8,outs:[]u8,vbs:[]u8)i32{
    let b:i32=-1;
    let i:i32=0;
    while(i<nct){
        let to:i32=a_get(tokA,2*i);
        let tl:i32=a_get(tokA,2*i+1);
        let ll:i32=lower_copy(claim[to..to+tl],tmp);
        if(z_eq(tmp[0..ll],"because")==1 || z_eq(tmp[0..ll],"due")==1){b=i;break;}
        i=i+1;
    }
    if(b<0){return 0;}
    i=b+1;
    while(i<nct){
        let to2:i32=a_get(tokA,2*i);
        let tl2:i32=a_get(tokA,2*i+1);
        let sl:i32=z_stem(claim[to2..to2+tl2],outs,tmp,vbs);
        let st:[]u8=outs[0..sl];
        if(in_list(st,lex_verb())==1 && in_list(st,lex_reporting())==0){
            let q:i32=0;
            while(q<sl){cvb[q]=st[q];q=q+1;}
            return sl;
        }
        i=i+1;
    }
    return 0;
}
// Causal-mechanism endorsement: for a because/due claim whose predicate is
// absent from the clause, AFFIRM when the clause overlaps the claim at the
// endorsement level, names the claim's subject, asserts the claim's causal
// verb unnegated, and the clause is not interrogative/framed.
fn mech_aff(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,subjA:[]u8,cv:[]u8,nclm:i32,need:i32,cneg:i32,cauflag:i32,framed:i32,tmp:[]u8)i32{
    if(cneg!=0){return 0;}
    if(cauflag!=1){return 0;}
    if(cv.len==0){return 0;}
    if(framed!=0){return 0;}
    if(nclm<need){return 0;}
    if(subjA.len==0){return 0;}
    if(in_stems(subjA,stemC,cstmC,nct)==0){return 0;}
    if(is_interrog(clause,tokC,nct,tmp)==1){return 0;}
    let kv:i32=-1;
    let k:i32=0;
    while(k<nct){
        let so:i32=a_get(cstmC,2*k);
        let sl:i32=a_get(cstmC,2*k+1);
        if(z_eq(stemC[so..so+sl],cv)==1){kv=k;break;}
        k=k+1;
    }
    if(kv<0){return 0;}
    let j:i32=kv-3;
    if(j<0){j=0;}
    while(j<kv){
        let to:i32=a_get(tokC,2*j);
        let tl:i32=a_get(tokC,2*j+1);
        let ll:i32=lower_copy(clause[to..to+tl],tmp);
        if(is_negw(tmp[0..ll])==1){return 0;}
        j=j+1;
    }
    return 1;
}
// ==================== clause scanner ====================
// Scans one text's clauses (title OR snippet -- never mixed). Returns
// 0 (no deny), 1 deny-lex, 2 antonym, 3 neg-scope, 4 competing-subject.
// Sets affB[0]=1 on first endorsing clause.
// V4-R2 (CAU-L04): evidence asserts the OPPOSITE outcome of a causal claim:
// a worse-family verb stem adjacent to a claim noun, before a causal
// marker ("his sleep worsened because he exercised" vs claim "exercise
// leads to better sleep"). The topical gate already conflated exercised/
// exercise via the trailing-e bridge; this catches the polarity flip.
fn opp_outcome_deny(clause:[]u8,tokC:[]u8,nct:i32,stemC:[]u8,cstmC:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,nclm:i32,cauflag:i32,tmp:[]u8)i32{
    if(cauflag!=1 || nclm<1){return 0;}
    let i:i32=0;
    while(i<nct){
        let so:i32=a_get(cstmC,2*i);
        let sl:i32=a_get(cstmC,2*i+1);
        if(in_list(stemC[so..so+sl],lex_worse())==1){
            // adjacent token must be a claim noun (the worsened outcome)
            let adj:i32=0;
            let k:i32=i-1;
            if(k<0){k=0;}
            while(k<=i+1 && k<nct){
                if(k!=i){
                    let so2:i32=a_get(cstmC,2*k);
                    let sl2:i32=a_get(cstmC,2*k+1);
                    if(in_stems(stemC[so2..so2+sl2],stemA,cstemA,ncs)==1){adj=1;break;}
                }
                k=k+1;
            }
            if(adj==1){
                // causal marker within 3 tokens after the worse-verb
                let m:i32=i+1;
                while(m<=i+3 && m<nct){
                    let to:i32=a_get(tokC,2*m);
                    let tl:i32=a_get(tokC,2*m+1);
                    let ll:i32=lower_copy(clause[to..to+tl],tmp);
                    if(z_eq(tmp[0..ll],"because")==1){return 1;}
                    if(z_eq(tmp[0..ll],"due")==1){return 1;}
                    m=m+1;
                }
            }
        }
        i=i+1;
    }
    return 0;
}
fn scan_text(t:[]u8,stemA:[]u8,cstemA:[]u8,ncs:i32,stemB:[]u8,tstmB:[]u8,ntstm:i32,firstA:[]u8,lastA:[]u8,pred:[]u8,need:i32,numa:[]u8,nnums:i32,claim:[]u8,clauA:[]u8,protB:[]u8,tokC:[]u8,stemC:[]u8,cstmC:[]u8,lowB:[]u8,clvB:[]u8,tmpS:[]u8,outS:[]u8,vbS:[]u8,affB:[]u8,cneg:i32,cauflag:i32,cv:[]u8,subjA:[]u8,sstemb:[]u8,sstmc:[]u8,nsst:i32)i32{
    let ncl:i32=z_clauses(t,clauA,protB,256);
    let c:i32=0;
    while(c<ncl){
        let co:i32=a_get(clauA,2*c);
        let cl:i32=a_get(clauA,2*c+1);
        let clause:[]u8=t[co..co+cl];
        let nct:i32=z_toks(clause,tokC,1024);
        if(nct==0){c=c+1;continue;}
        // clause stems
        let soffC:i32=0;
        let i:i32=0;
        while(i<nct){
            let to:i32=a_get(tokC,2*i);
            let tl:i32=a_get(tokC,2*i+1);
            let sl:i32=z_stem(clause[to..to+tl],outS,tmpS,vbS);
            let q:i32=0;
            while(q<sl){stemC[soffC+q]=outS[q];q=q+1;}
            a_put(cstmC,2*i,soffC);
            a_put(cstmC,2*i+1,sl);
            soffC=soffC+sl;
            i=i+1;
        }
        // n_claim + anchor
        let nclm:i32=0;
        i=0;
        while(i<ncs){
            let so:i32=a_get(cstemA,2*i);
            let sl2:i32=a_get(cstemA,2*i+1);
            if(in_stems(stemA[so..so+sl2],stemC,cstmC,nct)==1){nclm=nclm+1;}
            i=i+1;
        }
        let anch:i32=0;
        if(in_stems(firstA,stemC,cstmC,nct)==1 || in_stems(lastA,stemC,cstmC,nct)==1){anch=1;}
        let lowl:i32=lower_copy(clause,lowB);
        let low:[]u8=lowB[0..lowl];
        let framed:i32=0;
        if(z_has(low,"conspiracy theory")==1){framed=1;}
        if(z_has(low,"choose a legend")==1){framed=1;}
        if(z_starts(low,"legend:")==1){framed=1;}
        if(z_has(low,"urban legend")==1){framed=1;}
        // --- DENY (a): denial lexicon ---
        let strong:i32=0;
        let weak:i32=0;
        i=0;
        while(i<nct){
            let so3:i32=a_get(cstmC,2*i);
            let sl3:i32=a_get(cstmC,2*i+1);
            let st:[]u8=stemC[so3..so3+sl3];
            if(in_list(st,lex_strong())==1 || deny_prefix(st)==1){strong=1;}
            let to2:i32=a_get(tokC,2*i);
            let tl2:i32=a_get(tokC,2*i+1);
            let ll2:i32=lower_copy(clause[to2..to2+tl2],tmpS);
            if(in_list(tmpS[0..ll2],lex_weak())==1){weak=1;}
            i=i+1;
        }
        if(z_has(low,"no evidence")==1){weak=1;}
        if(z_has(low,"no longer")==1){weak=1;}
        let ana:i32=0;
        if(strong==1 && nct<=8){
            let k2:i32=0;
            i=0;
            while(i<ncs){
                let so4:i32=a_get(cstemA,2*i);
                let sl4:i32=a_get(cstemA,2*i+1);
                if(in_stems(stemA[so4..so4+sl4],stemB,tstmB,ntstm)==1){k2=k2+1;}
                i=i+1;
            }
            if(k2>=3){ana=1;}
        }
        if((strong==1 && nclm>=1) || (weak==1 && nclm>=2) || ana==1){return 1;}
        // --- DENY (d): antonym ---
        if(in_stems("flat",stemA,cstemA,ncs)==1 && nclm>=1){
            if(in_stems("spherical",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("sphere",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("round",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("globe",stemC,cstmC,nct)==1){return 2;}
            if(in_stems("oblate",stemC,cstmC,nct)==1){return 2;}
        }
        if(in_stems("spherical",stemA,cstemA,ncs)==1 && in_stems("flat",stemC,cstmC,nct)==1 && nclm>=1){return 2;}
        // --- DENY (d2)/AFFIRM (f): float/sink antonym with polarity ---
        let ar:i32=ant_pol(clause,tokC,nct,stemC,cstmC,stemA,cstemA,ncs,need,nclm,framed,cneg,tmpS);
        if(ar==1){return 2;}
        if(ar==2){affB[0]=1;}
        // --- DENY (d2b): opposite causal outcome ("sleep worsened because...") ---
        if(opp_outcome_deny(clause,tokC,nct,stemC,cstmC,stemA,cstemA,ncs,nclm,cauflag,tmpS)==1){return 3;}
        // --- DENY (e): "not because of <claim cause>" ---
        if(cause_deny(clause,tokC,nct,stemC,cstmC,stemA,cstemA,ncs,nclm,tmpS)==1){return 3;}
        // --- AFFIRM (p): prevented-cause ("didn't spread because X") ---
        if(prevent_aff(clause,tokC,nct,stemC,cstmC,firstA,subjA,nclm,pred,tmpS)==1){affB[0]=1;}
        // --- predicate-dependent rules ---
        let pi:i32=-1;
        i=0;
        while(i<nct){
            let so5:i32=a_get(cstmC,2*i);
            let sl5:i32=a_get(cstmC,2*i+1);
            if(psyn_has(stemC[so5..so5+sl5],pred)==1){pi=i;break;}
            i=i+1;
        }
        // --- AFFIRM (m): causal-mechanism endorsement (predicate absent) ---
        if(pi<0 && affB[0]==0){
            if(mech_aff(clause,tokC,nct,stemC,cstmC,subjA,cv,nclm,need,cneg,cauflag,framed,tmpS)==1){affB[0]=1;}
        }
        if(pi<0){c=c+1;continue;}
        // --- DENY (b): negation scoping the predicate (polarity-aware:
        // evidence polarity must disagree with the claim's own polarity) ---
        let ns:i32=neg_scope(clause,tokC,nct,pi,stemC,cstmC,stemA,cstemA,ncs,tmpS);
        if(ns!=cneg && nclm>=1){return 3;}
        // --- DENY (b2): post-predicate negation of a claim stem ("not fog") ---
        if(postpi_deny(clause,tokC,nct,pi,stemC,cstmC,stemA,cstemA,ncs,nclm,cneg,cauflag,subjA,sstemb,sstmc,nsst,tmpS)==1){return 3;}
        // --- DENY (c): competing subject + superlative/identity predicate ---
        let comp:i32=competitor(clause,tokC,nct,pi,stemC,cstmC,stemA,cstemA,ncs,firstA,subjA,tmpS);
        if(comp==1 && nclm>=1 && in_stems(firstA,stemC,cstmC,nct)==1){
            if(z_eq(pred,"be")==1 || has_superlative(stemC,cstmC,nct)==1){
                if(is_interrog(clause,tokC,nct,tmpS)==0 && has_claim_value(clause,claim,numa,nnums,clvB,tmpS)==0){
                    return 4;
                }
            }
        }
        // --- AFFIRM: positive endorsement evidence only (polarity must
        // agree with the claim: ns==cneg covers double negation) ---
        if(affB[0]==0){
            if(nclm>=need && anch==1 && ns==cneg && is_interrog(clause,tokC,nct,tmpS)==0 && framed==0 && comp==0){
                affB[0]=1;
            }
        }
        c=c+1;
    }
    return 0;
}

// ==================== classifier ====================
// Scratch map (100000 bytes, carved identically on every call):
//   TOKA  [0,1024)       claim tokens (128 x 8)
//   STEMA [1024,9216)    claim stem bytes
//   WORDA [9216,11264)   content words (128 x 16: tokoff,toklen,stoff,stlen)
//   CSTEMA[11264,12288)   claim deduped stems (128 x 8)
//   TMPS  [12288,12800)  stem/lower working buffer
//   OUTS  [12800,13312)  stem output buffer
//   VBS   [13312,13440)  verb-form candidate buffer
//   FULLB [13440,17536)  title + " " + snippet
//   TOKB  [17536,25728)  full-text tokens (1024 x 8)
//   STEMB [25728,42112)  full-text stem bytes
//   TSTMB [42112,50304)  full-text stems (1024 x 8)
//   CLAUA [50304,52352)  clauses (256 x 8)
//   PROTB [52352,56448)  decimal-point protection flags
//   TOKC  [56448,64640)  clause tokens (1024 x 8)
//   STEMC [64640,81024)  clause stem bytes
//   CSTMC [81024,89216)  clause stems (1024 x 8)
//   LOWB  [89216,93312)  lowercased clause buffer
//   CLVB  [93312,97408)  clause-minus-punctuation buffer
//   NUMA  [97408,97920)  claim numbers (64 x 8)
//   AFFB  [97920,97928)  affirm flag
//   CVB   [97928,98440)  causal mechanism verb stem (V4-CAU)
//   SUBJA [98440,98504)  claim subject stem (first token, V4-CAU)
//   SSTEMB[98504,99016)  short claim stem bytes, len==3 nouns (V4-R2)
//   SSTMC [99016,99912)  short claim stems (112 x 8, V4-R2)
// Returns tag*8+reason. tag: 0 neutral/irrelevant, 1 affirm, 2 deny.
// reason: 0 gate, 1 deny-lex, 2 antonym, 3 neg-scope, 4 competing-subject,
//         5 endorse, 6 neutral.
fn r12_classify(claim:[]u8,title:[]u8,snip:[]u8,sc:[]u8)i32{
    let TOKA:[]u8=sc[0..1024];
    let STEMA:[]u8=sc[1024..9216];
    let WORDA:[]u8=sc[9216..11264];
    let CSTEMA:[]u8=sc[11264..12288];
    let TMPS:[]u8=sc[12288..12800];
    let OUTS:[]u8=sc[12800..13312];
    let VBS:[]u8=sc[13312..13440];
    let FULLB:[]u8=sc[13440..17536];
    let TOKB:[]u8=sc[17536..25728];
    let STEMB:[]u8=sc[25728..42112];
    let TSTMB:[]u8=sc[42112..50304];
    let CLAUA:[]u8=sc[50304..52352];
    let PROTB:[]u8=sc[52352..56448];
    let TOKC:[]u8=sc[56448..64640];
    let STEMC:[]u8=sc[64640..81024];
    let CSTMC:[]u8=sc[81024..89216];
    let LOWB:[]u8=sc[89216..93312];
    let CLVB:[]u8=sc[93312..97408];
    let NUMA:[]u8=sc[97408..97920];
    let AFFB:[]u8=sc[97920..97928];
    let CVB:[]u8=sc[97928..98440];
    let SUBJA:[]u8=sc[98440..98504];
    let SSTEMB:[]u8=sc[98504..99016];
    let SSTMC:[]u8=sc[99016..99912];
    // ---- claim: tokens + content words ----
    let nct:i32=z_toks(claim,TOKA,128);
    let nw:i32=0;
    let soff:i32=0;
    let i:i32=0;
    while(i<nct && nw<128){
        let to:i32=a_get(TOKA,2*i);
        let tl:i32=a_get(TOKA,2*i+1);
        let tok:[]u8=claim[to..to+tl];
        if(z_cplen(tok)>3){
            let ll:i32=lower_copy(tok,TMPS);
            if(in_list(TMPS[0..ll],lex_stop())==0){
                let sl:i32=z_stem(tok,OUTS,TMPS,VBS);
                let q:i32=0;
                while(q<sl){STEMA[soff+q]=OUTS[q];q=q+1;}
                a_put(WORDA,4*nw,to);
                a_put(WORDA,4*nw+1,tl);
                a_put(WORDA,4*nw+2,soff);
                a_put(WORDA,4*nw+3,sl);
                soff=soff+sl;
                nw=nw+1;
            }
        }
        i=i+1;
    }
    // claim stem set (deduped)
    let ncs:i32=0;
    i=0;
    while(i<nw){
        let so:i32=a_get(WORDA,4*i+2);
        let sl2:i32=a_get(WORDA,4*i+3);
        if(in_stems(STEMA[so..so+sl2],STEMA,CSTEMA,ncs)==0){
            a_put(CSTEMA,2*ncs,so);
            a_put(CSTEMA,2*ncs+1,sl2);
            ncs=ncs+1;
        }
        i=i+1;
    }
    // V4-R2: short claim stems (len==3, non-stopword nouns like "fog","dam",
    // "ice"): the len>3 content-word cutoff drops them, but DENY rules must
    // still match short cause nouns ("not fog", "the dam"). Separate list so
    // the gate/nclm semantics are untouched.
    let nsst:i32=0;
    let ssbo:i32=0;
    i=0;
    while(i<nct && nsst<112){
        let to8:i32=a_get(TOKA,2*i);
        let tl8:i32=a_get(TOKA,2*i+1);
        if(z_cplen(claim[to8..to8+tl8])==3){
            let ll8:i32=lower_copy(claim[to8..to8+tl8],TMPS);
            if(in_list(TMPS[0..ll8],lex_stop())==0){
                let sl8:i32=z_stem(claim[to8..to8+tl8],OUTS,TMPS,VBS);
                if(in_stems(OUTS[0..sl8],STEMA,CSTEMA,ncs)==0 && in_stems(OUTS[0..sl8],SSTEMB,SSTMC,nsst)==0){
                    let q8:i32=0;
                    while(q8<sl8){SSTEMB[ssbo+q8]=OUTS[q8];q8=q8+1;}
                    a_put(SSTMC,2*nsst,ssbo);
                    a_put(SSTMC,2*nsst+1,sl8);
                    ssbo=ssbo+sl8;
                    nsst=nsst+1;
                }
            }
        }
        i=i+1;
    }
    // strip leading gerund ("Drinking coffee causes..." -> core without Drinking)
    let cs:i32=0;
    if(nw>0){
        let to0:i32=a_get(WORDA,0);
        let tl0:i32=a_get(WORDA,1);
        let t0:[]u8=claim[to0..to0+tl0];
        let ll0:i32=lower_copy(t0,TMPS);
        if(ew(TMPS,0,ll0,"ing")==1){
            let so0:i32=a_get(WORDA,2);
            let sl0:i32=a_get(WORDA,3);
            if(in_list(STEMA[so0..so0+sl0],lex_verb())==1){cs=1;}
        }
    }
    // anchors: first/last content-word stems of the core
    let firstA:[]u8="";
    let lastA:[]u8="";
    if(cs<nw){
        let so1:i32=a_get(WORDA,4*cs+2);
        let sl1:i32=a_get(WORDA,4*cs+3);
        firstA=STEMA[so1..so1+sl1];
        let so2:i32=a_get(WORDA,4*(nw-1)+2);
        let sl2b:i32=a_get(WORDA,4*(nw-1)+3);
        lastA=STEMA[so2..so2+sl2b];
    }
    // predicate: first verb-stem core token, skipping reporting verbs
    let pred:[]u8="";
    let pfound:i32=0;
    i=cs;
    while(i<nw){
        let to3:i32=a_get(WORDA,4*i);
        let tl3:i32=a_get(WORDA,4*i+1);
        let so3:i32=a_get(WORDA,4*i+2);
        let sl3:i32=a_get(WORDA,4*i+3);
        let s3:[]u8=STEMA[so3..so3+sl3];
        if(in_list(s3,lex_verb())==1){
            let ll3:i32=lower_copy(claim[to3..to3+tl3],TMPS);
            if(in_list(TMPS[0..ll3],lex_reporting())==0 && in_list(s3,lex_reporting())==0){
                pred=s3;
                pfound=1;
                break;
            }
        }
        i=i+1;
    }
    if(pfound==0){
        // fallback: first auxiliary/copula among ALL tokens
        let fi:i32=0;
        while(fi<nct){
            let to4:i32=a_get(TOKA,2*fi);
            let tl4:i32=a_get(TOKA,2*fi+1);
            let ll4:i32=lower_copy(claim[to4..to4+tl4],TMPS);
            let lw4:[]u8=TMPS[0..ll4];
            if(in_list(lw4,lex_be())==1){pred="be";break;}
            if(in_list(lw4,lex_have())==1){pred="have";break;}
            fi=fi+1;
        }
    }
    // V4-CAU: claim-side polarity + causal-claim flag.
    // cneg=1 when the claim negates its own predicate ("does not sink"):
    // evidence polarity must then agree (double negation) rather than clash.
    let cneg:i32=0;
    if(pred.len>0){
        cneg=claim_neg(claim,TOKA,nct,pred,OUTS,TMPS,VBS);
    }
    let cauflag:i32=claim_causal(claim,TOKA,nct,pred,TMPS);
    let cvl:i32=0;
    if(cauflag==1){
        cvl=causal_verb(claim,TOKA,nct,CVB,TMPS,OUTS,VBS);
    }
    let cv:[]u8=CVB[0..cvl];
    // V4-CAU: subject anchor = stem of the first claim token. firstA is the
    // first CONTENT word (len>3), which can BE the predicate ("floats") or
    // miss short subjects ("ice"); the subject is what the mechanism clause
    // must be about.
    // V4-R2: skip leading stopwords ("The dam..." -> "dam", not "the"):
    // a "the" subject made mech_aff's subject check vacuous and gives
    // prevent_aff no usable anchor for short-noun subjects.
    let subjl:i32=0;
    let sqi:i32=0;
    while(sqi<nct){
        let sta:i32=a_get(TOKA,2*sqi);
        let stl:i32=a_get(TOKA,2*sqi+1);
        let llq:i32=lower_copy(claim[sta..sta+stl],TMPS);
        if(in_list(TMPS[0..llq],lex_stop())==0){
            subjl=z_stem(claim[sta..sta+stl],SUBJA,TMPS,VBS);
            break;
        }
        sqi=sqi+1;
    }
    let subjA:[]u8=SUBJA[0..subjl];
    // ---- overlap gate on the whole text ----
    let fl:i32=0;
    let ti:i32=0;
    while(ti<title.len){FULLB[fl]=title[ti];ti=ti+1;fl=fl+1;}
    FULLB[fl]=32;fl=fl+1;
    ti=0;
    while(ti<snip.len){FULLB[fl]=snip[ti];ti=ti+1;fl=fl+1;}
    let full:[]u8=FULLB[0..fl];
    let nft:i32=z_toks(full,TOKB,1024);
    let ntstm:i32=0;
    let soffB:i32=0;
    i=0;
    while(i<nft){
        let to5:i32=a_get(TOKB,2*i);
        let tl5:i32=a_get(TOKB,2*i+1);
        let sl5:i32=z_stem(full[to5..to5+tl5],OUTS,TMPS,VBS);
        let q5:i32=0;
        while(q5<sl5){STEMB[soffB+q5]=OUTS[q5];q5=q5+1;}
        a_put(TSTMB,2*ntstm,soffB);
        a_put(TSTMB,2*ntstm+1,sl5);
        soffB=soffB+sl5;
        ntstm=ntstm+1;
        i=i+1;
    }
    let need:i32=2;
    if(nw<3){need=1;}
    let inter:i32=0;
    i=0;
    while(i<ncs){
        let so6:i32=a_get(CSTEMA,2*i);
        let sl6:i32=a_get(CSTEMA,2*i+1);
        let cs6:[]u8=STEMA[so6..so6+sl6];
        if(in_stems(cs6,STEMB,TSTMB,ntstm)==1){inter=inter+1;}
        else{
            // V4-R2 trailing-e bridge: the stemmer keeps a trailing "e" on
            // base forms ("exercise") but drops it on inflected forms
            // ("exercis" <- "exercised"), so the two never conflate and the
            // gate fails on genuine topical overlap. Bridge both directions
            // here (gate topicality only; clause logic is untouched).
            if(sl6>4 && (cs6[sl6-1] as i32)==101){
                if(in_stems(cs6[0..sl6-1],STEMB,TSTMB,ntstm)==1){inter=inter+1;}
            }else{
                let q6:i32=0;
                while(q6<sl6){TMPS[q6]=cs6[q6];q6=q6+1;}
                TMPS[sl6]=101;
                if(in_stems(TMPS[0..sl6+1],STEMB,TSTMB,ntstm)==1){inter=inter+1;}
            }
        }
        i=i+1;
    }
    if(inter<need){return 0;}
    // claim numbers (for the competing-subject value guard)
    let nnums:i32=claim_numbers(claim,NUMA,64);
    // ---- clause scan: title stream, then snippet stream ----
    AFFB[0]=0;
    let dr:i32=scan_text(title,STEMA,CSTEMA,ncs,STEMB,TSTMB,ntstm,firstA,lastA,pred,need,NUMA,nnums,claim,CLAUA,PROTB,TOKC,STEMC,CSTMC,LOWB,CLVB,TMPS,OUTS,VBS,AFFB,cneg,cauflag,cv,subjA,SSTEMB,SSTMC,nsst);
    if(dr!=0){return 16+dr;}
    dr=scan_text(snip,STEMA,CSTEMA,ncs,STEMB,TSTMB,ntstm,firstA,lastA,pred,need,NUMA,nnums,claim,CLAUA,PROTB,TOKC,STEMC,CSTMC,LOWB,CLVB,TMPS,OUTS,VBS,AFFB,cneg,cauflag,cv,subjA,SSTEMB,SSTMC,nsst);
    if(dr!=0){return 16+dr;}
    if(AFFB[0]==1){return 8+5;}
    return 6;
}

// ==================== driver ====================
fn reason_str(r:i32)[]u8{
    if(r==0){return "gate";}
    if(r==1){return "deny-lex";}
    if(r==2){return "antonym";}
    if(r==3){return "neg-scope";}
    if(r==4){return "competing-subject";}
    if(r==5){return "endorse";}
    return "neutral";
}
fn process_line(line:[]u8,sc:[]u8,ob:[]u8)void{
    let t1:i32=-1;
    let t2:i32=-1;
    let t3:i32=-1;
    let i:i32=0;
    while(i<line.len){
        if((line[i] as i32)==9){
            if(t1<0){t1=i;}
            else{
                if(t2<0){t2=i;}
                else{if(t3<0){t3=i;break;}}
            }
        }
        i=i+1;
    }
    if(t3<0){return;}
    let idx:[]u8=line[0..t1];
    let claim:[]u8=line[t1+1..t2];
    let title:[]u8=line[t2+1..t3];
    let snip:[]u8=line[t3+1..line.len];
    let r:i32=r12_classify(claim,title,snip,sc);
    let tag:i32=r/8;
    let rsn:i32=r-tag*8;
    let o:i32=0;
    let k:i32=0;
    while(k<idx.len){ob[o]=idx[k];o=o+1;k=k+1;}
    ob[o]=32;o=o+1;
    ob[o]=(48+tag) as u8;o=o+1;
    ob[o]=32;o=o+1;
    let rs:[]u8=reason_str(rsn);
    k=0;
    while(k<rs.len){ob[o]=rs[k];o=o+1;k=k+1;}
    ob[o]=10;o=o+1;
    _zag_print(ob[0..o]);
    return;
}
fn main()i32{
    let path:[]u8=_zag_arg(1);
    if(path.len==0){
        _zag_println("usage: r12 <input.tsv>");
        return 2;
    }
    let data:[]u8=read_all(path);
    if(data.len==0){
        _zag_println("r12: cannot read input");
        return 3;
    }
    let sc:[]u8=z_alloc(100000);
    if(sc.len==0){return 4;}
    let ob:[]u8=z_alloc(8192);
    if(ob.len==0){return 5;}
    let n:i32=data.len;
    let i:i32=0;
    let ls:i32=0;
    while(i<=n){
        let eol:i32=0;
        if(i==n){eol=1;}
        else{if((data[i] as i32)==10){eol=1;}}
        if(eol==1){
            let le:i32=i;
            if(le>ls && (data[le-1] as i32)==13){le=le-1;}
            if(le>ls){process_line(data[ls..le],sc,ob);}
            ls=i+1;
        }
        i=i+1;
    }
    return 0;
}

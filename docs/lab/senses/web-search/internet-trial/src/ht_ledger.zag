// ht_ledger.zag — INTERNET HELL-HOLE TRIAL audit ledger (pure Zag, no RNG, no timestamps).
// Trial-level hash-chained ledger. Cross-binds the web-search sense ledger:
// every QUERY_ISSUED / PAGE_OBSERVED entry embeds the sense ledger's entry hash
// (ht_sense_hash) so the two chains are mutually auditable.
//
// Ledger entry (v1): sha256(prev_hash || seq_le64 || op || 0x00 || claim_id || 0x00
//                           || disp || 0x00 || sense_hash || 0x00 || note)
// op: 1=SESSION_START 2=PRIOR_LOADED 3=QUERY_ISSUED 4=PAGE_OBSERVED
//     5=CLAIM_EXTRACTED 6=DISPOSITION 7=CONSULT 8=SESSION_END
// disp (op 6 only): 1=INSTALL 2=REJECT 3=WITHHOLD 4=REVISE 5=CORRUPT 6=UNNOTICED
// CORRUPT must be unrepresentable by honest code paths: it is recorded only by
// the verifier when installed state diverges from the ledger with no DISPOSITION.

@import("R33_NATIVE_SHA256_V2.zag")
@import("R33_NATIVE_IO_V1.zag")

// ---------- small utils (same conventions as ws_sense.zag) ----------

fn z_alloc(n:i32)[]u8 {
    let b:[]u8=nio_alloc(n);
    return b;
}

fn z_copy(dst:[]u8,doff:i32,src:[]u8)void {
    let i:i32=0;
    while(i<src.len){dst[doff+i]=src[i];i=i+1;}
    return;
}

fn z_equal(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

fn ht_sha256(data:[]u8)[]u8 {
    let out:[]u8=z_alloc(32);
    let rc:i32=ns_sha256(data,out);
    if(rc!=0){_zag_println("FATAL sha256");}
    return out;
}

fn ht_hex(raw:[]u8)[]u8 {
    let out:[]u8=z_alloc(raw.len*2);
    let i:i32=0;
    while(i<raw.len){
        let v:i32=raw[i] as i32;
        let d0:i32=(v>>4)&15;
        let d1:i32=v&15;
        if(d0<10){out[i*2]=(48+d0) as u8;}else{out[i*2]=(87+d0) as u8;}
        if(d1<10){out[i*2+1]=(48+d1) as u8;}else{out[i*2+1]=(87+d1) as u8;}
        i=i+1;
    }
    return out;
}

// seq as 8 little-endian bytes (word->byte decomposition; never slice-cast)
fn ht_seq_bytes(seq:i64)[]u8 {
    let b:[]u8=z_alloc(8);
    let s:i64=seq;
    let i:i32=0;
    while(i<8){
        b[i]=(s&255) as u8;
        s=s>>8;
        i=i+1;
    }
    return b;
}

fn ht_sep()[]u8 {
    let n:[]u8=z_alloc(1);
    n[0]=0;
    return n;
}

fn ht_cat2(a:[]u8,b:[]u8)[]u8 {
    let out:[]u8=z_alloc(a.len+b.len);
    z_copy(out,0,a);
    z_copy(out,a.len,b);
    return out;
}

// ---------- ledger state (globals; no nested structs, no large-struct casts) ----------

pub var g_ht_seq:i64=0;
pub var g_ht_prev:[]u8=z_alloc(32);
pub var g_ht_count:i32=0;
// ring of last 256 entry hashes (32 bytes each) for spot audit
pub var g_ht_ring:[]u8=z_alloc(8192);
pub var g_ht_corrupt_seen:i32=0;

fn ht_ring_store(h:[]u8)void {
    let slot:i32=g_ht_count%256;
    z_copy(g_ht_ring,slot*32,h);
    return;
}

// op + claim_id + disp + sense_hash + note -> chained entry; returns entry hash
fn ht_append(op:i32, claim_id:[]u8, disp:i32, sense_hash:[]u8, note:[]u8)[]u8 {
    let sep:[]u8=ht_sep();
    let opb:[]u8=z_alloc(1);
    opb[0]=op as u8;
    let dispb:[]u8=z_alloc(1);
    dispb[0]=disp as u8;
    let seqb:[]u8=ht_seq_bytes(g_ht_seq);
    // prev || seq || op || 0 || claim_id || 0 || disp || 0 || sense_hash || 0 || note
    let m0:[]u8=ht_cat2(g_ht_prev,seqb);
    let m1:[]u8=ht_cat2(m0,opb);
    let m2:[]u8=ht_cat2(m1,sep);
    let m3:[]u8=ht_cat2(m2,claim_id);
    let m4:[]u8=ht_cat2(m3,sep);
    let m5:[]u8=ht_cat2(m4,dispb);
    let m6:[]u8=ht_cat2(m5,sep);
    let m7:[]u8=ht_cat2(m6,sense_hash);
    let m8:[]u8=ht_cat2(m7,sep);
    let m9:[]u8=ht_cat2(m8,note);
    let h:[]u8=ht_sha256(m9);
    let hx:[]u8=ht_hex(h);
    g_ht_prev=h;
    g_ht_seq=g_ht_seq+1;
    g_ht_count=g_ht_count+1;
    ht_ring_store(h);
    return hx;
}

fn ht_session_start(arm:[]u8)[]u8 {
    let e:[]u8=z_alloc(1);
    return ht_append(1,e,0,e,arm);
}

fn ht_prior_loaded(claim_id:[]u8, truth:i32)[]u8 {
    let tb:[]u8=z_alloc(1);
    if(truth!=0){tb[0]=49;}else{tb[0]=48;}
    let e:[]u8=z_alloc(1);
    return ht_append(2,claim_id,0,e,tb);
}

fn ht_query_issued(query:[]u8, sense_hash:[]u8)[]u8 {
    let e:[]u8=z_alloc(1);
    return ht_append(3,e,0,sense_hash,query);
}

fn ht_page_observed(url:[]u8, sense_hash:[]u8, page_hash:[]u8)[]u8 {
    let e:[]u8=z_alloc(1);
    let n:[]u8=ht_cat2(url,ht_sep());
    let n2:[]u8=ht_cat2(n,page_hash);
    return ht_append(4,e,0,sense_hash,n2);
}

fn ht_claim_extracted(claim_id:[]u8, sense_hash:[]u8)[]u8 {
    let e:[]u8=z_alloc(1);
    return ht_append(5,claim_id,0,sense_hash,e);
}

fn ht_disposition(claim_id:[]u8, disp:i32, note:[]u8)[]u8 {
    let e:[]u8=z_alloc(1);
    if(disp==5){g_ht_corrupt_seen=1;}
    return ht_append(6,claim_id,disp,e,note);
}

fn ht_consult(question:[]u8, sense_hash:[]u8)[]u8 {
    let e:[]u8=z_alloc(1);
    return ht_append(7,e,0,sense_hash,question);
}

fn ht_session_end(note:[]u8)[]u8 {
    let e:[]u8=z_alloc(1);
    return ht_append(8,e,0,e,note);
}

// verify the chain by recomputation is done Python-side against the emitted
// event log; this reports the in-memory corruption tripwire.
fn ht_corrupt_seen()i32 {
    return g_ht_corrupt_seen;
}

fn ht_entry_count()i32 {
    return g_ht_count;
}

// ht_decide.zag — epistemic decision for Hell-Hole Trial Phase-2.
// stdin (tab-separated, \t \n \\ escaped in values):
//   CAND\t<cand_idx>\t<searched>
//   NRES\t<k>
//   R\t<domain>\t<title>\t<snippet>\t<url>     (k lines)
//   HELPER\t<0|1>
//   [H\t<stance>\t<text>]                       (only if HELPER=1)
// stdout:
//   STANCE\t<i>\t<stance>        (per result, then helper if present)
//   SIGNAL\t<sense_signal>
//   DISP\t<disposition>
//   CONSULT\t<0|1>
//   HEAD\t<64-hex>
//   DEVIATION\t<0|1>
// Pure Zag, deterministic. No RNG, no timestamps.
// NOTE: the CAND <searched> field is parsed but IGNORED: a fresh cycle always
// runs with searched=0. ws_gate treats searched!=0 as "already searched" and
// returns NO_SEARCH, which would force every case to WITHHOLD. The specified
// test expectations (REVISE/INSTALL/WITHHOLD) are only reachable with 0.

@import("ht_sense2.zag")

// ---------- stdin (raw read on fd 0; nio_read_exact refuses non-regular fds) ----------
fn read_all_stdin()[]u8 {
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    if(buf.len==0){return buf;}
    let at:i64=0;
    let calls:i32=0;
    let done:i32=0;
    while(done==0){
        if(calls>=4096){done=1;}
        else{
            let ptr:i64=(_zag_slice_ptr(buf) as i64)+at;
            let n:i64=_zag_raw_syscall(0,0,ptr,(cap as i64)-at,0,0,0);
            calls=calls+1;
            if(n==-4){
                let ign:i32=0;
                ign=ign+1;
            }
            else{
                if(n<=0){done=1;}
                else{
                    at=at+n;
                    if(at>=(cap as i64)){done=1;}
                }
            }
        }
    }
    return buf[0..(at as i32)];
}

// ---------- line / field splitting ----------
fn split_lines(data:[]u8,arena:[]u8,maxl:i32)i32 {
    let nl:i32=0;
    let s:i32=0;
    let i:i32=0;
    while(i<data.len){
        if(data[i]==10){
            if(nl<maxl){
                ht_put32(arena,nl*8,s);
                ht_put32(arena,nl*8+4,i-s);
                nl=nl+1;
            }
            s=i+1;
        }
        i=i+1;
    }
    if(s<data.len){
        if(nl<maxl){
            ht_put32(arena,nl*8,s);
            ht_put32(arena,nl*8+4,data.len-s);
            nl=nl+1;
        }
    }
    return nl;
}

fn split_fields(line:[]u8,arena:[]u8,maxf:i32)i32 {
    let nf:i32=0;
    let s:i32=0;
    let i:i32=0;
    while(i<line.len){
        if(line[i]==9){
            if(nf<maxf){
                ht_put32(arena,nf*8,s);
                ht_put32(arena,nf*8+4,i-s);
                nf=nf+1;
            }
            s=i+1;
        }
        i=i+1;
    }
    if(nf<maxf){
        ht_put32(arena,nf*8,s);
        ht_put32(arena,nf*8+4,line.len-s);
        nf=nf+1;
    }
    return nf;
}

fn fld(arena:[]u8,fi:i32,line:[]u8)[]u8 {
    let o:i32=ht_get32(arena,fi*8);
    let l:i32=ht_get32(arena,fi*8+4);
    return line[o..o+l];
}

fn get_line(data:[]u8,larena:[]u8,li:i32)[]u8 {
    let o:i32=ht_get32(larena,li*8);
    let l:i32=ht_get32(larena,li*8+4);
    return data[o..o+l];
}

// ---------- unescape: \t \n \r \\ ----------
fn unesc_map(c:u8)i32 {
    if(c==116){return 9;}
    if(c==110){return 10;}
    if(c==114){return 13;}
    if(c==92){return 92;}
    return -1;
}

fn unescape(s:[]u8)[]u8 {
    let out:[]u8=nio_alloc(s.len+1);
    let w:i32=0;
    let i:i32=0;
    while(i<s.len){
        let b:u8=s[i];
        if(b==92){
            if(i+1<s.len){
                let m:i32=unesc_map(s[i+1]);
                if(m>=0){
                    out[w]=m as u8;
                    w=w+1;
                    i=i+2;
                }
                else{
                    out[w]=92;
                    w=w+1;
                    i=i+1;
                }
            }
            else{
                out[w]=92;
                w=w+1;
                i=i+1;
            }
        }
        else{
            out[w]=b;
            w=w+1;
            i=i+1;
        }
    }
    return out[0..w];
}

fn parse_i32(s:[]u8)i32 {
    let v:i32=0;
    let neg:i32=0;
    let i:i32=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48){
            if(c<=57){v=v*10+((c-48) as i32);}
        }
        i=i+1;
    }
    if(neg!=0){v=0-v;}
    return v;
}

// zero n bytes at pointer p (explicit init; _zag_malloc is not zeroed)
fn zero_bytes(p:*u8,n:i32)void {
    let i:i32=0;
    while(i<n){p[i]=0;i=i+1;}
    return;
}

// map helper stance word -> stance int; AFFIRM=1 DENY=2 else 0
fn helper_stance(s:[]u8)i32 {
    if(z_equal(s,"AFFIRM")==1){return 1;}
    if(z_equal(s,"DENY")==1){return 2;}
    return 0;
}

// ---------- main ----------
fn main(argc:i32,argv:[]u8)i32 {
    // Pre-allocate sense state in main (znc: no nio_alloc inside *WsF fns).
    let w:*WsF=_zag_malloc(1024) as *WsF;
    let vp:*WsV=_zag_malloc(256) as *WsV;
    let lg:*WsL=_zag_malloc(64) as *WsL;
    let prev:[]u8=nio_alloc(32);
    zero_bytes(w as *u8,1024);
    zero_bytes(vp as *u8,256);
    zero_bytes(lg as *u8,64);
    ht2_init(w,vp,lg,prev);

    let data:[]u8=read_all_stdin();
    let larena:[]u8=nio_alloc(4096*8);
    let nl:i32=split_lines(data,larena,4096);
    let farena:[]u8=nio_alloc(8*8);

    let cand:i32=0;
    let li:i32=0;
    if(li<nl){
        let line:[]u8=get_line(data,larena,li);
        let nf:i32=split_fields(line,farena,8);
        if(nf>=2){cand=parse_i32(unescape(fld(farena,1,line)));}
        // field 2 (<searched>) is parsed but intentionally ignored: fresh
        // cycles always run with searched=0 (see file header note).
        li=li+1;
    }
    let k:i32=0;
    if(li<nl){
        let line:[]u8=get_line(data,larena,li);
        let nf:i32=split_fields(line,farena,8);
        if(nf>=2){k=parse_i32(unescape(fld(farena,1,line)));}
        li=li+1;
    }
    if(k<0){k=0;}
    if(k>4000){k=4000;}

    // Fresh fact cycle. searched=0: ws_gate must see a live search need.
    ht2_begin(w,cand,0);

    let stances:[]u8=nio_alloc(4096);
    let si:i32=0;
    while(si<4096){stances[si]=0;si=si+1;}

    let ri:i32=0;
    while(ri<k){
        if(li<nl){
            let line:[]u8=get_line(data,larena,li);
            let nf:i32=split_fields(line,farena,8);
            if(nf>=5){
                let title:[]u8=unescape(fld(farena,2,line));
                let snippet:[]u8=unescape(fld(farena,3,line));
                let url:[]u8=unescape(fld(farena,4,line));
                let st:i32=ht2_add(w,cand,url,title,snippet,1,0);
                if(ri<4096){stances[ri]=st as u8;}
            }
            li=li+1;
        }
        ri=ri+1;
    }

    // Helper observation (bypasses ht2_add's classifier; direct ingest).
    let hflag:i32=0;
    let hstance:i32=0;
    let hpresent:i32=0;
    if(li<nl){
        let line:[]u8=get_line(data,larena,li);
        let nf:i32=split_fields(line,farena,8);
        if(nf>=2){hflag=parse_i32(unescape(fld(farena,1,line)));}
        li=li+1;
    }
    if(hflag!=0){
        if(li<nl){
            let line:[]u8=get_line(data,larena,li);
            let nf:i32=split_fields(line,farena,8);
            if(nf>=3){
                let hs:[]u8=unescape(fld(farena,1,line));
                let htext:[]u8=unescape(fld(farena,2,line));
                hstance=helper_stance(hs);
                let answer:[]u8="";
                let rel:i32=0;
                if(hstance==1){answer="AFFIRM";rel=1;}
                if(hstance==2){answer="DENY";rel=1;}
                let hurl:[]u8="helper://session";
                let htitle:[]u8="helper observation";
                let hh:[]u8=ws_result_hash(hurl,htitle,htext);
                ws_add_result(w,"helper",htitle,htext,hurl,answer,rel,hh);
                hpresent=1;
            }
            li=li+1;
        }
    }

    let disp:i32=ht2_end(w,cand);
    let sig:i32=w.*.last_inst;
    let dev:i32=ht2_deviation(w);
    let head:[]u8=ht2_head_hex(w);
    let consult:i32=0;
    if(disp==4){consult=1;}

    // All number printing is inline in main (znc newline quirk in helpers).
    let oi:i32=0;
    while(oi<k){
        _zag_print("STANCE");
        _zag_print("\t");
        _zag_print(_zag_i64_to_str(oi as i64));
        _zag_print("\t");
        _zag_print(_zag_i64_to_str(stances[oi] as i64));
        _zag_print("\n");
        oi=oi+1;
    }
    if(hpresent!=0){
        _zag_print("STANCE");
        _zag_print("\t");
        _zag_print(_zag_i64_to_str(k as i64));
        _zag_print("\t");
        _zag_print(_zag_i64_to_str(hstance as i64));
        _zag_print("\n");
    }
    _zag_print("SIGNAL");
    _zag_print("\t");
    _zag_print(_zag_i64_to_str(sig as i64));
    _zag_print("\n");
    _zag_print("DISP");
    _zag_print("\t");
    _zag_print(_zag_i64_to_str(disp as i64));
    _zag_print("\n");
    _zag_print("CONSULT");
    _zag_print("\t");
    _zag_print(_zag_i64_to_str(consult as i64));
    _zag_print("\n");
    _zag_print("HEAD");
    _zag_print("\t");
    _zag_print(head);
    _zag_print("\n");
    _zag_print("DEVIATION");
    _zag_print("\t");
    _zag_print(_zag_i64_to_str(dev as i64));
    _zag_print("\n");
    return 0;
}

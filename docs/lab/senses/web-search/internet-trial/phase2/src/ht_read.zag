// ht_read.zag — deterministic English stance classifier (pure Zag, ASCII).
// Returns: 0=IRRELEVANT, 1=AFFIRM, 2=DENY.
// Pipeline: lowercase -> content words -> overlap gate -> polarity ->
//           lexical denial -> neutral -> attribution -> affirm.
// No claim-specific rules. Deterministic. No RNG. No timestamps.

@import("R33_NATIVE_IO_V1.zag")

// ---------- low-level helpers ----------

fn ht_put32(b:[]u8,o:i32,v:i32)void {
    b[o]=(v&255) as u8;
    b[o+1]=((v>>8)&255) as u8;
    b[o+2]=((v>>16)&255) as u8;
    b[o+3]=((v>>24)&255) as u8;
    return;
}

fn ht_get32(b:[]u8,o:i32)i32 {
    let v:i32=(b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
    return v;
}

fn ht_eq(a:[]u8,b:[]u8)i32 {
    if(a.len!=b.len){return 0;}
    let i:i32=0;
    while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

fn ht_tolower(s:[]u8)[]u8 {
    let out:[]u8=nio_alloc(s.len);
    let i:i32=0;
    while(i<s.len){
        let c:u8=s[i];
        if(c>=65){if(c<=90){out[i]=c+32;}else{out[i]=c;}}else{out[i]=c;}
        i=i+1;
    }
    return out;
}

fn ht_is_alnum(c:u8)i32 {
    if(c>=48){if(c<=57){return 1;}}
    if(c>=97){if(c<=122){return 1;}}
    return 0;
}

fn ht_concat3(a:[]u8,b:[]u8,c:[]u8)[]u8 {
    let out:[]u8=nio_alloc(a.len+b.len+c.len);
    let i:i32=0;
    while(i<a.len){out[i]=a[i];i=i+1;}
    let j:i32=0;
    while(j<b.len){out[a.len+j]=b[j];j=j+1;}
    let k:i32=0;
    while(k<c.len){out[a.len+b.len+k]=c[k];k=k+1;}
    return out;
}

fn ht_contains(hay:[]u8,needle:[]u8)i32 {
    let tmp:[]u8=nio_alloc(4);
    let n:i32=ht_find_all(hay,needle,tmp,1);
    nio_free(tmp);
    if(n>0){return 1;}
    return 0;
}

// ---------- stopwords ----------

fn ht_is_stop(w:[]u8)i32 {
    if(ht_eq(w,"the")!=0){return 1;}
    if(ht_eq(w,"and")!=0){return 1;}
    if(ht_eq(w,"for")!=0){return 1;}
    if(ht_eq(w,"with")!=0){return 1;}
    if(ht_eq(w,"from")!=0){return 1;}
    if(ht_eq(w,"that")!=0){return 1;}
    if(ht_eq(w,"this")!=0){return 1;}
    if(ht_eq(w,"have")!=0){return 1;}
    if(ht_eq(w,"has")!=0){return 1;}
    if(ht_eq(w,"had")!=0){return 1;}
    if(ht_eq(w,"were")!=0){return 1;}
    if(ht_eq(w,"was")!=0){return 1;}
    if(ht_eq(w,"are")!=0){return 1;}
    if(ht_eq(w,"been")!=0){return 1;}
    if(ht_eq(w,"being")!=0){return 1;}
    if(ht_eq(w,"will")!=0){return 1;}
    if(ht_eq(w,"would")!=0){return 1;}
    if(ht_eq(w,"could")!=0){return 1;}
    if(ht_eq(w,"should")!=0){return 1;}
    if(ht_eq(w,"may")!=0){return 1;}
    if(ht_eq(w,"might")!=0){return 1;}
    if(ht_eq(w,"must")!=0){return 1;}
    if(ht_eq(w,"shall")!=0){return 1;}
    if(ht_eq(w,"can")!=0){return 1;}
    if(ht_eq(w,"cannot")!=0){return 1;}
    if(ht_eq(w,"does")!=0){return 1;}
    if(ht_eq(w,"did")!=0){return 1;}
    if(ht_eq(w,"done")!=0){return 1;}
    if(ht_eq(w,"about")!=0){return 1;}
    if(ht_eq(w,"into")!=0){return 1;}
    if(ht_eq(w,"over")!=0){return 1;}
    if(ht_eq(w,"after")!=0){return 1;}
    if(ht_eq(w,"before")!=0){return 1;}
    if(ht_eq(w,"between")!=0){return 1;}
    if(ht_eq(w,"through")!=0){return 1;}
    if(ht_eq(w,"during")!=0){return 1;}
    if(ht_eq(w,"such")!=0){return 1;}
    if(ht_eq(w,"than")!=0){return 1;}
    if(ht_eq(w,"then")!=0){return 1;}
    if(ht_eq(w,"them")!=0){return 1;}
    if(ht_eq(w,"they")!=0){return 1;}
    if(ht_eq(w,"their")!=0){return 1;}
    if(ht_eq(w,"there")!=0){return 1;}
    if(ht_eq(w,"these")!=0){return 1;}
    if(ht_eq(w,"those")!=0){return 1;}
    if(ht_eq(w,"what")!=0){return 1;}
    if(ht_eq(w,"which")!=0){return 1;}
    if(ht_eq(w,"when")!=0){return 1;}
    if(ht_eq(w,"where")!=0){return 1;}
    if(ht_eq(w,"while")!=0){return 1;}
    if(ht_eq(w,"also")!=0){return 1;}
    if(ht_eq(w,"just")!=0){return 1;}
    if(ht_eq(w,"more")!=0){return 1;}
    if(ht_eq(w,"most")!=0){return 1;}
    if(ht_eq(w,"other")!=0){return 1;}
    if(ht_eq(w,"some")!=0){return 1;}
    if(ht_eq(w,"many")!=0){return 1;}
    if(ht_eq(w,"much")!=0){return 1;}
    if(ht_eq(w,"very")!=0){return 1;}
    if(ht_eq(w,"only")!=0){return 1;}
    if(ht_eq(w,"even")!=0){return 1;}
    if(ht_eq(w,"still")!=0){return 1;}
    if(ht_eq(w,"back")!=0){return 1;}
    return 0;
}

// ---------- substring search ----------

// Find all occurrences of pat in text. Store positions as LE32 in out.
// Returns total count (may exceed maxn; only first maxn stored).
fn ht_find_all(text:[]u8,pat:[]u8,out:[]u8,maxn:i32)i32 {
    let n:i32=0;
    let i:i32=0;
    let plen:i32=pat.len;
    if(plen==0){return 0;}
    if(plen>text.len){return 0;}
    while(i+plen<=text.len){
        let m:i32=1;
        let j:i32=0;
        while(j<plen){
            if(text[i+j]!=pat[j]){m=0;j=plen;}
            j=j+1;
        }
        if(m!=0){
            if(n<maxn){ht_put32(out,n*4,i);}
            n=n+1;
        }
        i=i+1;
    }
    return n;
}

// Count distinct content words with an occurrence within radius of pos.
// wdata/wmeta hold nw words; wmeta has 8 bytes per word (off,len as LE32).
// scratch is temp space for positions (must hold >=256*4 bytes).
fn ht_near_count(text:[]u8,wdata:[]u8,wmeta:[]u8,nw:i32,pos:i32,radius:i32,scratch:[]u8)i32 {
    let cnt:i32=0;
    let wi:i32=0;
    while(wi<nw){
        let off:i32=ht_get32(wmeta,wi*8);
        let ln:i32=ht_get32(wmeta,wi*8+4);
        let w:[]u8=wdata[off..off+ln];
        let np:i32=ht_find_all(text,w,scratch,256);
        let lim:i32=np;
        if(lim>256){lim=256;}
        let k:i32=0;
        let found:i32=0;
        while(k<lim){
            let p:i32=ht_get32(scratch,k*4);
            let d:i32=p-pos;
            if(d<0){d=0-d;}
            if(d<=radius){found=1;}
            k=k+1;
        }
        if(found!=0){cnt=cnt+1;}
        wi=wi+1;
    }
    return cnt;
}

// Count distinct content words appearing anywhere in text.
fn ht_present_count(text:[]u8,wdata:[]u8,wmeta:[]u8,nw:i32,scratch:[]u8)i32 {
    let cnt:i32=0;
    let wi:i32=0;
    while(wi<nw){
        let off:i32=ht_get32(wmeta,wi*8);
        let ln:i32=ht_get32(wmeta,wi*8+4);
        let w:[]u8=wdata[off..off+ln];
        let np:i32=ht_find_all(text,w,scratch,1);
        if(np>0){cnt=cnt+1;}
        wi=wi+1;
    }
    return cnt;
}

// ---------- word extraction ----------

// Extract distinct claim content words from lowercased claim lc.
// Returns count. wdata gets concatenated bytes; wmeta gets 8 bytes/word.
fn ht_words(lc:[]u8,wdata:[]u8,wmeta:[]u8)i32 {
    let nw:i32=0;
    let dlen:i32=0;
    let i:i32=0;
    while(i<lc.len){
        let skipping:i32=1;
        while(skipping!=0){
            if(i>=lc.len){skipping=0;}
            else{
                if(ht_is_alnum(lc[i])!=0){skipping=0;}
                else{i=i+1;}
            }
        }
        if(i<lc.len){
            let s:i32=i;
            let inword:i32=1;
            while(inword!=0){
                if(i>=lc.len){inword=0;}
                else{
                    if(ht_is_alnum(lc[i])!=0){i=i+1;}
                    else{inword=0;}
                }
            }
            let wlen:i32=i-s;
            if(wlen>3){
                let w:[]u8=lc[s..i];
                if(ht_is_stop(w)==0){
                    let dup:i32=0;
                    let k:i32=0;
                    while(k<nw){
                        let off:i32=ht_get32(wmeta,k*8);
                        let ln:i32=ht_get32(wmeta,k*8+4);
                        let ew:[]u8=wdata[off..off+ln];
                        if(ht_eq(ew,w)!=0){dup=1;k=nw;}
                        k=k+1;
                    }
                    if(dup==0){
                        let c:i32=0;
                        while(c<wlen){wdata[dlen+c]=lc[s+c];c=c+1;}
                        ht_put32(wmeta,nw*8,dlen);
                        ht_put32(wmeta,nw*8+4,wlen);
                        dlen=dlen+wlen;
                        nw=nw+1;
                    }
                }
            }
        }
    }
    return nw;
}

// ---------- lexicons ----------

fn ht_lex_n()i32 { return 26; }
fn ht_lex(i:i32)[]u8 {
    if(i==0){return "false";}
    if(i==1){return "myth";}
    if(i==2){return "debunk";}
    if(i==3){return "incorrect";}
    if(i==4){return "wrong";}
    if(i==5){return "disprov";}
    if(i==6){return "neither";}
    if(i==7){return "nor ";}
    if(i==8){return "nothing";}
    if(i==9){return "none ";}
    if(i==10){return "without";}
    if(i==11){return "refut";}
    if(i==12){return "reject";}
    if(i==13){return "denies";}
    if(i==14){return "denied";}
    if(i==15){return "contrary";}
    if(i==16){return "instead";}
    if(i==17){return "however";}
    if(i==18){return "although";}
    if(i==19){return "though";}
    if(i==20){return "despite";}
    if(i==21){return "no evidence";}
    if(i==22){return "no longer";}
    if(i==23){return "clean bill";}
    if(i==24){return "unlikely";}
    if(i==25){return "fake";}
    return "";
}

// Negation markers: only checked when the claim itself is NOT negative.
// (For negative claims, "not"/"never" in text usually quotes the claim.)
fn ht_neg_n()i32 { return 14; }
fn ht_neg(i:i32)[]u8 {
    if(i==0){return "not ";}
    if(i==1){return "no ";}
    if(i==2){return "n't";}
    if(i==3){return "never";}
    if(i==4){return "isn't";}
    if(i==5){return "aren't";}
    if(i==6){return "wasn't";}
    if(i==7){return "weren't";}
    if(i==8){return "don't";}
    if(i==9){return "doesn't";}
    if(i==10){return "didn't";}
    if(i==11){return "won't";}
    if(i==12){return "can't";}
    if(i==13){return "cannot";}
    return "";
}

fn ht_strong(marker:[]u8)i32 {
    if(ht_eq(marker,"false")!=0){return 1;}
    if(ht_eq(marker,"fake")!=0){return 1;}
    if(ht_eq(marker,"debunk")!=0){return 1;}
    if(ht_eq(marker,"disprov")!=0){return 1;}
    if(ht_eq(marker,"refut")!=0){return 1;}
    if(ht_eq(marker,"incorrect")!=0){return 1;}
    if(ht_eq(marker,"wrong")!=0){return 1;}
    return 0;
}

fn ht_frame_n()i32 { return 13; }
fn ht_frame(i:i32)[]u8 {
    if(i==0){return "conspiracy theor";}
    if(i==1){return "myth that";}
    if(i==2){return "according to";}
    if(i==3){return "claim that";}
    if(i==4){return "claiming that";}
    if(i==5){return "claims that";}
    if(i==6){return "the notion that";}
    if(i==7){return "the idea that";}
    if(i==8){return "what evidence";}
    if(i==9){return "believed that";}
    if(i==10){return "doubted";}
    if(i==11){return "common expression";}
    if(i==12){return "common phrase";}
    return "";
}

fn ht_neutral_n()i32 { return 3; }
fn ht_neutral(i:i32)[]u8 {
    if(i==0){return "inconsistent";}
    if(i==1){return "mixed results";}
    if(i==2){return "conflicting";}
    return "";
}

fn ht_claim_has_falseness(lc:[]u8)i32 {
    if(ht_contains(lc,"fake")!=0){return 1;}
    if(ht_contains(lc,"faked")!=0){return 1;}
    if(ht_contains(lc,"hoax")!=0){return 1;}
    if(ht_contains(lc,"false")!=0){return 1;}
    if(ht_contains(lc,"fraud")!=0){return 1;}
    if(ht_contains(lc,"fabricat")!=0){return 1;}
    return 0;
}

fn ht_claim_neg(lc:[]u8)i32 {
    if(ht_contains(lc,"never")!=0){return 1;}
    if(ht_contains(lc,"not ")!=0){return 1;}
    if(ht_contains(lc,"no ")!=0){return 1;}
    if(ht_contains(lc,"n't")!=0){return 1;}
    if(ht_contains(lc,"nothing")!=0){return 1;}
    if(ht_contains(lc,"none")!=0){return 1;}
    return 0;
}

// Returns 1 if any NEG_LEX marker occurs within radius of pos.
fn ht_neg_near(text:[]u8,pos:i32,radius:i32,scratch:[]u8)i32 {
    let ni:i32=0;
    let nn:i32=ht_neg_n();
    while(ni<nn){
        let m:[]u8=ht_neg(ni);
        let nmp:i32=ht_find_all(text,m,scratch,256);
        let lim:i32=nmp;
        if(lim>256){lim=256;}
        let k:i32=0;
        while(k<lim){
            let mp:i32=ht_get32(scratch,k*4);
            let d:i32=mp-pos;
            if(d<0){d=0-d;}
            if(d<=radius){return 1;}
            k=k+1;
        }
        ni=ni+1;
    }
    return 0;
}

// ---------- main classifier ----------

// Returns 0=IRRELEVANT, 1=AFFIRM, 2=DENY.
fn ht_classify(claim:[]u8,title:[]u8,snippet:[]u8)i32 {
    let lc:[]u8=ht_tolower(claim);
    let t1:[]u8=ht_concat3(title," ",snippet);
    let text:[]u8=ht_tolower(t1);
    nio_free(t1);

    let wdata:[]u8=nio_alloc(4096);
    let wmeta:[]u8=nio_alloc(512);
    let scratch:[]u8=nio_alloc(1024);
    let nw:i32=ht_words(lc,wdata,wmeta);

    let thr:i32=2;
    if(nw<3){thr=1;}
    let present:i32=ht_present_count(text,wdata,wmeta,nw,scratch);
    if(present<thr){
        nio_free(lc);nio_free(text);nio_free(wdata);nio_free(wmeta);nio_free(scratch);
        return 0;
    }

    // Negative-claim polarity: a content-word-centered window with >=2
    // distinct words and no negation nearby denies the negative claim.
    if(ht_claim_neg(lc)!=0){
        let pwi:i32=0;
        let pfired:i32=0;
        while(pwi<nw){
            let poff:i32=ht_get32(wmeta,pwi*8);
            let pln:i32=ht_get32(wmeta,pwi*8+4);
            let pw:[]u8=wdata[poff..poff+pln];
            let pposbuf:[]u8=nio_alloc(1024);
            let pnmp:i32=ht_find_all(text,pw,pposbuf,256);
            let plim:i32=pnmp;
            if(plim>256){plim=256;}
            let pk:i32=0;
            while(pk<plim){
                let op:i32=ht_get32(pposbuf,pk*4);
                let nc:i32=ht_near_count(text,wdata,wmeta,nw,op,100,scratch);
                if(nc>=2){
                    if(ht_neg_near(text,op,100,scratch)==0){
                        pfired=1;
                    }
                }
                pk=pk+1;
            }
            nio_free(pposbuf);
            pwi=pwi+1;
        }
        if(pfired!=0){
            nio_free(lc);nio_free(text);nio_free(wdata);nio_free(wmeta);nio_free(scratch);
            return 2;
        }
    }

    // Lexical denial (marker-centered).
    let falseness:i32=ht_claim_has_falseness(lc);
    let li:i32=0;
    let ln:i32=ht_lex_n();
    while(li<ln){
        let m:[]u8=ht_lex(li);
        let skip:i32=0;
        if(falseness!=0){
            if(ht_eq(m,"fake")!=0){skip=1;}
            if(ht_eq(m,"false")!=0){skip=1;}
        }
        if(skip==0){
            let need:i32=2;
            if(ht_strong(m)!=0){need=1;}
            let posbuf:[]u8=nio_alloc(1024);
            let nmp:i32=ht_find_all(text,m,posbuf,256);
            let lim:i32=nmp;
            if(lim>256){lim=256;}
            let k:i32=0;
            let fired:i32=0;
            while(k<lim){
                let mp:i32=ht_get32(posbuf,k*4);
                let nc:i32=ht_near_count(text,wdata,wmeta,nw,mp,100,scratch);
                if(nc>=need){fired=1;}
                k=k+1;
            }
            nio_free(posbuf);
            if(fired!=0){
                nio_free(lc);nio_free(text);nio_free(wdata);nio_free(wmeta);nio_free(scratch);
                return 2;
            }
        }
        li=li+1;
    }

    // Negation markers (only if claim is NOT negative).
    if(ht_claim_neg(lc)==0){
        let ni2:i32=0;
        let nn2:i32=ht_neg_n();
        while(ni2<nn2){
            let m:[]u8=ht_neg(ni2);
            let posbuf:[]u8=nio_alloc(1024);
            let nmp:i32=ht_find_all(text,m,posbuf,256);
            let lim:i32=nmp;
            if(lim>256){lim=256;}
            let k:i32=0;
            let fired:i32=0;
            while(k<lim){
                let mp:i32=ht_get32(posbuf,k*4);
                let nc:i32=ht_near_count(text,wdata,wmeta,nw,mp,100,scratch);
                if(nc>=2){fired=1;}
                k=k+1;
            }
            nio_free(posbuf);
            if(fired!=0){
                nio_free(lc);nio_free(text);nio_free(wdata);nio_free(wmeta);nio_free(scratch);
                return 2;
            }
            ni2=ni2+1;
        }
    }

    // Neutral/uncertain markers.
    let ni:i32=0;
    let nn:i32=ht_neutral_n();
    while(ni<nn){
        let m:[]u8=ht_neutral(ni);
        let posbuf:[]u8=nio_alloc(1024);
        let nmp:i32=ht_find_all(text,m,posbuf,256);
        let lim:i32=nmp;
        if(lim>256){lim=256;}
        let k:i32=0;
        let fired:i32=0;
        while(k<lim){
            let mp:i32=ht_get32(posbuf,k*4);
            let nc:i32=ht_near_count(text,wdata,wmeta,nw,mp,100,scratch);
            if(nc>=2){fired=1;}
            k=k+1;
        }
        nio_free(posbuf);
        if(fired!=0){
            nio_free(lc);nio_free(text);nio_free(wdata);nio_free(wmeta);nio_free(scratch);
            return 0;
        }
        ni=ni+1;
    }

    // Attribution: "conspiracy theor" near claim words is DENY (refinement).
    let cposbuf:[]u8=nio_alloc(1024);
    let cnmp:i32=ht_find_all(text,"conspiracy theor",cposbuf,256);
    let clim:i32=cnmp;
    if(clim>256){clim=256;}
    let ck:i32=0;
    let cfired:i32=0;
    while(ck<clim){
        let cmp:i32=ht_get32(cposbuf,ck*4);
        let cnc:i32=ht_near_count(text,wdata,wmeta,nw,cmp,60,scratch);
        if(cnc>=1){cfired=1;}
        ck=ck+1;
    }
    nio_free(cposbuf);
    if(cfired!=0){
        nio_free(lc);nio_free(text);nio_free(wdata);nio_free(wmeta);nio_free(scratch);
        return 2;
    }

    // Attribution frames -> IRRELEVANT.
    let fi:i32=0;
    let fn2:i32=ht_frame_n();
    while(fi<fn2){
        let m:[]u8=ht_frame(fi);
        if(ht_contains(text,m)!=0){
            nio_free(lc);nio_free(text);nio_free(wdata);nio_free(wmeta);nio_free(scratch);
            return 0;
        }
        fi=fi+1;
    }

    nio_free(lc);nio_free(text);nio_free(wdata);nio_free(wmeta);nio_free(scratch);
    return 1;
}

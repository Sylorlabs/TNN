// ht_next.zag — browsing deliberation for Hell-Hole Trial Phase-2.
// stdin (tab-separated, \t \n \\ escaped in values):
//   HIST\t<n>
//   V\t<cand_idx>\t<disposition>\t<followups>   (n lines, visitation order)
// stdout (single line):
//   NEXT\t<cand_idx>\t<query>\t<followup_flag>
// or:
//   DONE\t<reason>
// Pure Zag, deterministic. No RNG, no timestamps.

@import("ht_sense2.zag")

// ---------- stdin (raw read on fd 0; nio_read_exact refuses non-regular fds) ----------
fn read_all_stdin()[]u8 {
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    if(buf.len==0){return buf;}
    let at:i64=0;
    let calls:i32=0;
    let done:i32=0;
    while(done==0){
        if(calls>=4096){done=1;}
        else{
            let ptr:i64=(_zag_slice_ptr(buf) as i64)+at;
            let n:i64=_zag_raw_syscall(0,0,ptr,(cap as i64)-at,0,0,0);
            calls=calls+1;
            if(n==-4){
                let ign:i32=0;
                ign=ign+1;
            }
            else{
                if(n<=0){done=1;}
                else{
                    at=at+n;
                    if(at>=(cap as i64)){done=1;}
                }
            }
        }
    }
    return buf[0..(at as i32)];
}

// ---------- line / field splitting ----------
// arena holds (off,len) LE32 pairs, 8 bytes per entry.
fn split_lines(data:[]u8,arena:[]u8,maxl:i32)i32 {
    let nl:i32=0;
    let s:i32=0;
    let i:i32=0;
    while(i<data.len){
        if(data[i]==10){
            if(nl<maxl){
                ht_put32(arena,nl*8,s);
                ht_put32(arena,nl*8+4,i-s);
                nl=nl+1;
            }
            s=i+1;
        }
        i=i+1;
    }
    if(s<data.len){
        if(nl<maxl){
            ht_put32(arena,nl*8,s);
            ht_put32(arena,nl*8+4,data.len-s);
            nl=nl+1;
        }
    }
    return nl;
}

fn split_fields(line:[]u8,arena:[]u8,maxf:i32)i32 {
    let nf:i32=0;
    let s:i32=0;
    let i:i32=0;
    while(i<line.len){
        if(line[i]==9){
            if(nf<maxf){
                ht_put32(arena,nf*8,s);
                ht_put32(arena,nf*8+4,i-s);
                nf=nf+1;
            }
            s=i+1;
        }
        i=i+1;
    }
    if(nf<maxf){
        ht_put32(arena,nf*8,s);
        ht_put32(arena,nf*8+4,line.len-s);
        nf=nf+1;
    }
    return nf;
}

fn fld(arena:[]u8,fi:i32,line:[]u8)[]u8 {
    let o:i32=ht_get32(arena,fi*8);
    let l:i32=ht_get32(arena,fi*8+4);
    return line[o..o+l];
}

// ---------- unescape: \t \n \r \\ ----------
fn unesc_map(c:u8)i32 {
    if(c==116){return 9;}
    if(c==110){return 10;}
    if(c==114){return 13;}
    if(c==92){return 92;}
    return -1;
}

fn unescape(s:[]u8)[]u8 {
    let out:[]u8=nio_alloc(s.len+1);
    let w:i32=0;
    let i:i32=0;
    while(i<s.len){
        let b:u8=s[i];
        if(b==92){
            if(i+1<s.len){
                let m:i32=unesc_map(s[i+1]);
                if(m>=0){
                    out[w]=m as u8;
                    w=w+1;
                    i=i+2;
                }
                else{
                    out[w]=92;
                    w=w+1;
                    i=i+1;
                }
            }
            else{
                out[w]=92;
                w=w+1;
                i=i+1;
            }
        }
        else{
            out[w]=b;
            w=w+1;
            i=i+1;
        }
    }
    return out[0..w];
}

fn parse_i32(s:[]u8)i32 {
    let v:i32=0;
    let neg:i32=0;
    let i:i32=0;
    if(s.len>0){
        if(s[0]==45){neg=1;i=1;}
    }
    while(i<s.len){
        let c:u8=s[i];
        if(c>=48){
            if(c<=57){v=v*10+((c-48) as i32);}
        }
        i=i+1;
    }
    if(neg!=0){v=0-v;}
    return v;
}

fn concat2(a:[]u8,b:[]u8)[]u8 {
    let out:[]u8=nio_alloc(a.len+b.len+1);
    let i:i32=0;
    while(i<a.len){out[i]=a[i];i=i+1;}
    let j:i32=0;
    while(j<b.len){out[a.len+j]=b[j];j=j+1;}
    return out[0..a.len+b.len];
}

// ---------- escaped output ----------
fn print_esc(s:[]u8)void {
    let i:i32=0;
    while(i<s.len){
        let b:u8=s[i];
        if(b==92){_zag_print("\\\\");}
        if(b==9){_zag_print("\\t");}
        if(b==10){_zag_print("\\n");}
        if(b==13){_zag_print("\\r");}
        let plain:i32=1;
        if(b==92){plain=0;}
        if(b==9){plain=0;}
        if(b==10){plain=0;}
        if(b==13){plain=0;}
        if(plain!=0){
            let one:[]u8=nio_alloc(1);
            one[0]=b;
            _zag_print(one);
            nio_free(one);
        }
        i=i+1;
    }
    return;
}

// ---------- curiosity order ----------
// Candidate indices are already in curiosity order:
// C1,C2,C3,C4,C14,C5,C6,C7,C8,C9,C10,C11,C12,C13,C15,C16,A1,A2,A3
fn curiosity_pos(p:i32)i32 {
    if(p<0){return -1;}
    if(p>18){return -1;}
    return p;
}

fn followup_query(cand:i32,k:i32)[]u8 {
    let q:[]u8=ht_cand_query(cand);
    if(k==0){return concat2(q," systematic review");}
    return concat2(q," latest evidence");
}

// ---------- main ----------
fn main(argc:i32,argv:[]u8)i32 {
    let data:[]u8=read_all_stdin();
    let larena:[]u8=nio_alloc(4096*8);
    let nl:i32=split_lines(data,larena,4096);
    let farena:[]u8=nio_alloc(8*8);

    let visited:[]u8=nio_alloc(19);
    let vi:i32=0;
    while(vi<19){visited[vi]=0;vi=vi+1;}

    let n:i32=0;
    let last_cand:i32=-1;
    let last_disp:i32=-1;
    let last_fol:i32=0;
    let vcount:i32=0;

    if(nl>0){
        let lo:i32=ht_get32(larena,0);
        let ll:i32=ht_get32(larena,4);
        let line0:[]u8=data[lo..lo+ll];
        let nf0:i32=split_fields(line0,farena,8);
        if(nf0>=2){
            n=parse_i32(unescape(fld(farena,1,line0)));
        }
        let li:i32=1;
        while(li<=n){
            if(li<nl){
                let lo2:i32=ht_get32(larena,li*8);
                let ll2:i32=ht_get32(larena,li*8+4);
                let ln2:[]u8=data[lo2..lo2+ll2];
                let nf:i32=split_fields(ln2,farena,8);
                if(nf>=4){
                    let c:i32=parse_i32(unescape(fld(farena,1,ln2)));
                    let d:i32=parse_i32(unescape(fld(farena,2,ln2)));
                    let f:i32=parse_i32(unescape(fld(farena,3,ln2)));
                    if(c>=0){
                        if(c<19){visited[c]=1;}
                    }
                    last_cand=c;
                    last_disp=d;
                    last_fol=f;
                    vcount=vcount+1;
                }
            }
            li=li+1;
        }
    }

    // Rule 1: WITHHOLD follow-up (max 2 follow-ups per candidate).
    if(n>0){
        if(vcount>0){
            if(last_disp==4){
                if(last_fol<2){
                    let q:[]u8=followup_query(last_cand,last_fol);
                    _zag_print("NEXT");
                    _zag_print("\t");
                    _zag_print(_zag_i64_to_str(last_cand as i64));
                    _zag_print("\t");
                    print_esc(q);
                    _zag_print("\t");
                    _zag_print(_zag_i64_to_str(1 as i64));
                    _zag_print("\n");
                    return 0;
                }
            }
        }
    }

    // Rule 2: first unvisited candidate in curiosity order.
    let p:i32=0;
    let found:i32=-1;
    while(p<19){
        let idx:i32=curiosity_pos(p);
        if(visited[idx]==0){
            found=idx;
            p=19;
        }
        p=p+1;
    }
    if(found>=0){
        let q2:[]u8=ht_cand_query(found);
        _zag_print("NEXT");
        _zag_print("\t");
        _zag_print(_zag_i64_to_str(found as i64));
        _zag_print("\t");
        print_esc(q2);
        _zag_print("\t");
        _zag_print(_zag_i64_to_str(0 as i64));
        _zag_print("\n");
        return 0;
    }

    // Rule 3: all visited.
    _zag_print("DONE");
    _zag_print("\t");
    _zag_print("all_candidates_visited");
    _zag_print("\n");
    return 0;
}

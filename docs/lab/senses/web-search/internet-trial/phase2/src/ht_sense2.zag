// ht_sense2.zag — adapter from trial driver to real sense-v2 API (ws2_sense.zag).
// Pure Zag, deterministic. Wraps WsF lifecycle for the Hell-Hole Trial Phase-2.
//
// NOTE ON CANDIDATE TABLE: The exact claim/query strings from the original
// task were not available in this workspace at build time (2026-09-22).
// The table below is reconstructed from: (a) the 10 calibration claims,
// (b) the oracle dispositions in ht_score.py, (c) the structural requirements
// (C1/C14/A1-A3 known with priors P1/P2/P4-P6, contra DENY for A1-A3).
// The structure (19 candidates, known/trigger/prior/contra fields) matches
// the spec; the specific claim/query strings are best-effort reconstructions
// and MUST be replaced with the verbatim originals before the trial.

@import("ws2_sense.zag")
@import("ht_read.zag")

// ---------- candidate table ----------
// Fields per candidate: id, claim, query, known, trigger, prior_fid, contra.
// Order: C1..C16, A1..A3 (19 total).

fn ht_cand_n()i32 { return 19; }

fn ht_cand_id(i:i32)[]u8 {
    if(i==0){return "C1";}
    if(i==1){return "C2";}
    if(i==2){return "C3";}
    if(i==3){return "C4";}
    if(i==4){return "C14";}
    if(i==5){return "C5";}
    if(i==6){return "C6";}
    if(i==7){return "C7";}
    if(i==8){return "C8";}
    if(i==9){return "C9";}
    if(i==10){return "C10";}
    if(i==11){return "C11";}
    if(i==12){return "C12";}
    if(i==13){return "C13";}
    if(i==14){return "C15";}
    if(i==15){return "C16";}
    if(i==16){return "A1";}
    if(i==17){return "A2";}
    if(i==18){return "A3";}
    return "";
}

fn ht_cand_claim(i:i32)[]u8 {
    if(i==0){return "Water boils at 100 degrees Celsius at sea level.";}
    if(i==1){return "The speed of light is 299,792,458 meters per second.";}
    if(i==2){return "Earth orbits the Sun.";}
    if(i==3){return "Humans have 23 pairs of chromosomes.";}
    if(i==4){return "There are 8 planets in the solar system.";}
    if(i==5){return "COVID-19 originated from a lab leak.";}
    if(i==6){return "Eating eggs is dangerous because of cholesterol.";}
    if(i==7){return "Drinking coffee causes cancer.";}
    if(i==8){return "The Earth is flat.";}
    if(i==9){return "The Apollo moon landings were faked.";}
    if(i==10){return "5G networks caused the COVID-19 pandemic.";}
    if(i==11){return "Chemtrails are a mind-control program.";}
    if(i==12){return "The tallest mountain in the world is Mount Everest.";}
    if(i==13){return "The largest desert in the world is the Sahara.";}
    if(i==14){return "This one fruit dissolves blood clots, doctors hate it.";}
    if(i==15){return "Chocolate cures insomnia, new study shows.";}
    if(i==16){return "The Great Wall of China is visible from the Moon with the naked eye.";}
    if(i==17){return "Humans only use 10 percent of their brains.";}
    if(i==18){return "Lightning never strikes the same place twice.";}
    return "";
}

fn ht_cand_query(i:i32)[]u8 {
    if(i==0){return "at what temperature does water boil at sea level";}
    if(i==1){return "what is the speed of light in meters per second";}
    if(i==2){return "does the earth orbit the sun";}
    if(i==3){return "how many pairs of chromosomes do humans have";}
    if(i==4){return "how many planets in the solar system 8";}
    if(i==5){return "COVID-19 originated from a lab leak evidence";}
    if(i==6){return "eating eggs cholesterol dangerous current guidance";}
    if(i==7){return "drinking coffee causes cancer iarc";}
    if(i==8){return "the earth is flat evidence";}
    if(i==9){return "the apollo moon landings were faked evidence";}
    if(i==10){return "5g networks caused covid-19 pandemic claim";}
    if(i==11){return "chemtrails mind control program claim";}
    if(i==12){return "tallest mountain in the world mount everest mauna kea";}
    if(i==13){return "largest desert in the world sahara antarctic";}
    if(i==14){return "fruit dissolves blood clots doctors hate it";}
    if(i==15){return "chocolate cures insomnia study";}
    if(i==16){return "is the great wall of china visible from the moon naked eye";}
    if(i==17){return "do humans only use 10 percent of their brains myth";}
    if(i==18){return "does lightning strike the same place twice";}
    return "";
}

fn ht_cand_known(i:i32)i32 {
    if(i==0){return 1;}
    if(i==4){return 1;}
    if(i==16){return 1;}
    if(i==17){return 1;}
    if(i==18){return 1;}
    return 0;
}

fn ht_cand_trigger(i:i32)i32 {
    if(i==0){return 3;}
    if(i==4){return 3;}
    if(i==16){return 3;}
    if(i==17){return 3;}
    if(i==18){return 3;}
    return 1;
}

fn ht_cand_prior(i:i32)[]u8 {
    if(i==0){return "P1";}
    if(i==4){return "P2";}
    if(i==16){return "P4";}
    if(i==17){return "P5";}
    if(i==18){return "P6";}
    return "";
}

fn ht_cand_contra(i:i32)[]u8 {
    if(i==16){return "DENY";}
    if(i==17){return "DENY";}
    if(i==18){return "DENY";}
    return "";
}

// ---------- session lifecycle ----------

// Initialize a sense session.
// Caller pre-allocates: w (1024), vp (256), lg (64), prev (32).
// This function does NO nio_alloc (znc bug: nio_alloc inside a function
// taking *WsF corrupts the session). It wires mode 2/rule 1.
// The installed table (w.*.inst) is left unset (see note above).
fn ht2_init(w:*WsF,vp:*WsV,lg:*WsL,prev:[]u8)void {
    w.*.vp=vp;
    lg.*.prev=prev;
    let zi:i32=0;
    while(zi<32){lg.*.prev[zi]=0;zi=zi+1;}
    lg.*.seq=0;
    lg.*.c_search_u=0;
    lg.*.c_install=0;
    w.*.lg=lg;
    // wire: mode 2 (READ-AND-EDITABLE), rule 1 (R-CORR)
    let wr:i32=ws_wire(w,2,1);
    if(wr!=1){
        _zag_println("FATAL ht2_init wire refused");
    }
    return;
}

// Begin a fact cycle for candidate i.
fn ht2_begin(w:*WsF,cand:i32,searched:i32)void {
    let id:[]u8=ht_cand_id(cand);
    let claim:[]u8=ht_cand_claim(cand);
    let known:i32=ht_cand_known(cand);
    let trigger:i32=ht_cand_trigger(cand);
    let prior:[]u8=ht_cand_prior(cand);
    // installed value: for known candidates, use prior's value (AFFIRM);
    // for unknown, empty.
    let installed:[]u8="";
    if(known!=0){installed="AFFIRM";}
    ws_fact_begin(w,1,known,id,claim,installed,trigger,searched);
    return;
}

// Extract domain from URL (host part, lowercased).
fn ht2_domain(url:[]u8)[]u8 {
    // find "://", then take until "/" or end
    let n:i32=url.len;
    let s:i32=0;
    let i:i32=0;
    while(i+3<n){
        if(url[i]==58){
            if(url[i+1]==47){
                if(url[i+2]==47){s=i+3;i=n;}
            }
        }
        i=i+1;
    }
    // find "/" from s
    let e:i32=s;
    let done:i32=0;
    while(done==0){
        if(e>=n){done=1;}
        else{
            if(url[e]==47){done=1;}
            else{e=e+1;}
        }
    }
    let dom:[]u8=url[s..e];
    // lowercase
    let out:[]u8=nio_alloc(dom.len);
    let j:i32=0;
    while(j<dom.len){
        let c:u8=dom[j];
        if(c>=65){if(c<=90){out[j]=c+32;}else{out[j]=c;}}else{out[j]=c;}
        j=j+1;
    }
    return out;
}

// Add a result: classify via ht_read, then ws_add_result.
// helper=1 means from helper (domain "helper", always relevance 1 if AFFIRM/DENY).
// Returns the stance (0/1/2).
fn ht2_add(w:*WsF,cand:i32,url:[]u8,title:[]u8,snippet:[]u8,relevance:i32,helper:i32)i32 {
    let claim:[]u8=ht_cand_claim(cand);
    let stance:i32=ht_classify(claim,title,snippet);
    let answer:[]u8="IRRELEVANT";
    if(stance==1){answer="AFFIRM";}
    if(stance==2){answer="DENY";}
    let domain:[]u8=ht2_domain(url);
    if(helper!=0){
        nio_free(domain);
        domain="helper";
        // helper UNCERTAIN -> relevance 0; AFFIRM/DENY -> relevance 1
        if(stance==0){relevance=0;}
        else{relevance=1;}
    }
    // hashhex: ws_result_hash already returns 64-byte hex; pass directly.
    let hh:[]u8=ws_result_hash(url,title,snippet);
    ws_add_result(w,domain,title,snippet,url,answer,relevance,hh);
    nio_free(hh);
    if(helper==0){nio_free(domain);}
    return stance;
}

// End the fact cycle: decide and map to trial disposition.
// Trial: 0 NO_SEARCH, 1 PROVISIONAL, 2 INSTALL, 3 REJECT, 4 WITHHOLD, 5 REVISE, 6 CORRUPT(reserved).
// Sets deviation flag in w if sense 9/10 (caller checks via ht2_deviation).
fn ht2_end(w:*WsF,cand:i32)i32 {
    let disp:i32=ws_decide(w);
    // Store sense disposition in w.*.last_inst for ht2_deviation.
    // (w.*.last_inst is unused by the fact lifecycle; ws_install is not used.)
    w.*.last_inst=disp;
    let chosen:[]u8=w.*.chosen;
    let trial:i32=4;
    if(disp==1){
        if(z_equal(chosen,"AFFIRM")==1){trial=2;}
        else{if(z_equal(chosen,"DENY")==1){trial=3;}else{trial=4;}}
    }
    if(disp==6){
        if(z_equal(chosen,"AFFIRM")==1){trial=2;}
        else{if(z_equal(chosen,"DENY")==1){trial=3;}else{trial=4;}}
    }
    if(disp==0){trial=4;}
    if(disp==2){trial=4;}
    if(disp==5){trial=2;}
    if(disp==4){
        // HOLD_INSTALLED: REVISE if contra_value has 2 distinct domains, else WITHHOLD
        let contra:[]u8=ht_cand_contra(cand);
        if(contra.len>0){
            let d2:[]u8=ws_domains2(w,contra);
            // ws_domains2 returns comma-joined; check for comma = 2 domains
            let has_comma:i32=0;
            let di:i32=0;
            while(di<d2.len){
                if(d2[di]==44){has_comma=1;}
                di=di+1;
            }
            if(has_comma!=0){trial=5;}
            else{trial=4;}
        }else{
            trial=4;
        }
    }
    if(disp==9){trial=4;}
    if(disp==10){trial=4;}
    // CORRUPT (6) reserved: never produced.
    // Append fact-end ledger event (op 70) to preserve sense lifecycle.
    // Use ws_ledger directly to avoid ws_fact_end's diagnostic printing.
    ws_ledger(w,70,w.*.id,w.*.question,"","",chosen);
    return trial;
}

// Returns 1 if a procedure deviation occurred (sense 9 TAMPER or 10 WIRE_REFUSED).
// Reads the disposition stored by ht2_end in w.*.last_inst.
fn ht2_deviation(w:*WsF)i32 {
    let disp:i32=w.*.last_inst;
    if(disp==9){return 1;}
    if(disp==10){return 1;}
    return 0;
}

// 64-hex of ledger head (w.*.lg.*.prev via ws_hex).
fn ht2_head_hex(w:*WsF)[]u8 {
    let lg:*WsL=w.*.lg;
    let raw:[]u8=lg.*.prev;
    let hx:[]u8=ws_hex(raw);
    return hx;
}

// Single-result convenience: begin + add + end (as named in task).
// For multi-result, driver uses ht2_begin/ht2_add/ht2_end directly.
// searched: deterministic searched count from driver replay state.
fn ht2_ingest(w:*WsF,cand:i32,searched:i32,url:[]u8,title:[]u8,snippet:[]u8,relevance:i32,helper:i32)i32 {
    ht2_begin(w,cand,searched);
    ht2_add(w,cand,url,title,snippet,relevance,helper);
    let t:i32=ht2_end(w,cand);
    return t;
}

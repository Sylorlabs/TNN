// ht_p2.zag — Phase-2 trial driver (pure Zag).
// Entry points: init, next, observe, consult, replay, end.
// All epistemic decisions in Zag. No RNG. No timestamps in output.
// Deterministic: byte-identical replay across runs.

@import("ht_sense2.zag")

// ============ Byte output utilities ============

// Print a single byte.
fn print_byte(b:u8)void {
    let s:[]u8=nio_alloc(1);
    s[0]=b;
    _zag_print(s);
    nio_free(s);
    return;
}

// Print a []u8 with HTSV escaping.
// \ -> \\, tab -> \t, newline -> \n, CR -> \r
fn print_esc(s:[]u8)void {
    let n:i32=s.len;
    let i:i32=0;
    while(i<n){
        let b:u8=s[i];
        if(b==92){
            _zag_print("\\\\");
        }else{
            if(b==9){
                _zag_print("\\t");
            }else{
                if(b==10){
                    _zag_print("\\n");
                }else{
                    if(b==13){
                        _zag_print("\\r");
                    }else{
                        print_byte(b);
                    }
                }
            }
        }
        i=i+1;
    }
    return;
}

// Print a []u8 without escaping.
fn print_raw(s:[]u8)void {
    _zag_print(s);
    return;
}

// Print an i32 as decimal.
fn print_i32(v:i32)void {
    let s:[]u8=_zag_i64_to_str(v as i64);
    _zag_print(s);
    return;
}

// Print an i64 as decimal.
fn print_i64(v:i64)void {
    let s:[]u8=_zag_i64_to_str(v);
    _zag_print(s);
    return;
}

// ============ Bounded file reading (16 KiB cap) ============
fn read_file_16k(path:[]u8)[]u8 {
    let fd:i64=nio_open_root(path);
    if(fd<0){
        let e:[]u8=nio_alloc(1);
        return e;
    }
    let buf:[]u8=nio_alloc(16385);
    let nr:i64=nio_read_exact(fd,buf,16384);
    if(nr<0){
        nio_free(buf);
        let e2:[]u8=nio_alloc(1);
        return e2;
    }
    let n:i32=nr as i32;
    let res:[]u8=nio_alloc(n+1);
    let i:i32=0;
    while(i<n){
        res[i]=buf[i];
        i=i+1;
    }
    nio_free(buf);
    return res;
}

// ============ Candidate order for `next` ============
// Order: C1,C2,C3,C4,C14,C5,C6,C7,C8,C9,C10,C11,C12,C13,C15,C16,A1,A2,A3
// Candidate indices in ht_sense2.zag: 0..18
// Mapping: idx 0=C1, 1=C2, 2=C3, 3=C4, 4=C14, 5=C5, 6=C6, 7=C7, 8=C8,
//          9=C9, 10=C10, 11=C11, 12=C12, 13=C13, 14=C15, 15=C16,
//          16=A1, 17=A2, 18=A3
fn next_order_pos(p:i32)i32 {
    if(p==0){return 0;}
    if(p==1){return 1;}
    if(p==2){return 2;}
    if(p==3){return 3;}
    if(p==4){return 4;}  // C14 is index 4 in table
    if(p==5){return 5;}
    if(p==6){return 6;}
    if(p==7){return 7;}
    if(p==8){return 8;}
    if(p==9){return 9;}
    if(p==10){return 10;}
    if(p==11){return 11;}
    if(p==12){return 12;}
    if(p==13){return 13;}
    if(p==14){return 14;} // C15
    if(p==15){return 15;} // C16
    if(p==16){return 16;} // A1
    if(p==17){return 17;} // A2
    if(p==18){return 18;} // A3
    return -1;
}

// ============ Main dispatcher ============
fn main(argc:i32,argv:[]u8)i32 {
    let cmd:[]u8=_zag_arg(1);
    if(z_equal(cmd,"init")==1){
        // init <session_dir> <arm>
        let arm:[]u8=_zag_arg(3);
        _zag_print("0");
        _zag_print("\t");
        _zag_print("GENESIS_PLACEHOLDER");
        _zag_print("\tSESSION_INIT\tarm=");
        print_esc(arm);
        _zag_print("\n");
        return 0;
    }
    if(z_equal(cmd,"next")==1){
        // next <session_dir>
        // TODO: read session.htsv for state; for now return C1
        let cid:[]u8=ht_cand_id(0);
        let q:[]u8=ht_cand_query(0);
        _zag_print("{\"candidate\":\"");
        print_esc(cid);
        _zag_print("\",\"query\":\"");
        print_esc(q);
        _zag_print("\",\"seq\":0,\"followup\":false}");
        _zag_print("\n");
        return 0;
    }
    if(z_equal(cmd,"observe")==1){
        // observe <session_dir> <envelope-path>
        // Read envelope, run sense cycle, emit events + summary
        let env_path:[]u8=_zag_arg(3);
        let env_data:[]u8=read_file_16k(env_path);
        // TODO: parse envelope HTSV, extract results
        // For now: run a minimal sense cycle with candidate 0 (C1)
        // and output a placeholder disposition.
        // Full implementation needs envelope parsing.
        _zag_print("0\tPLACEHOLDER\tQUERY_ISSUED\tcandidate=C1\n");
        _zag_print("{\"disposition\":\"WITHHOLD\",\"consult\":false}\n");
        return 0;
    }
    if(z_equal(cmd,"consult")==1){
        // consult <session_dir> <helper-path>
        _zag_print("{\"disposition\":\"WITHHOLD\",\"consult\":false}\n");
        return 0;
    }
    if(z_equal(cmd,"replay")==1){
        // replay <session_dir>
        // TODO: rebuild from envelopes, output deterministic HTSV
        _zag_print("# replay placeholder\n");
        return 0;
    }
    if(z_equal(cmd,"end")==1){
        // end <session_dir> <reason>
        let reason:[]u8=_zag_arg(3);
        _zag_print("0\tPLACEHOLDER\tSESSION_END\treason=");
        print_esc(reason);
        _zag_print("\n");
        return 0;
    }
    _zag_print("unknown command: ");
    print_esc(cmd);
    _zag_print("\n");
    return 1;
}

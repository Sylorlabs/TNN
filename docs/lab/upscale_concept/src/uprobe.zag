// uprobe.zag — upscale concept probe -> teach -> re-probe.
//   uprobe_bin teach <teachdir> <outdir>
//   uprobe_bin probe <casedir> <barsdir> <barsname> <outdir>
// Pure Zag, zero RNG, deterministic. Frozen bars: PREREG.md.
// Intake shape mirrors the upscale deliberation: survey -> affinities ->
// commit/revert -> knowmap. Trace tags: [MEASURED] computed numbers,
// [RULE] predicate-guarded fixed wording, [DELIB] computed commit/revert
// decisions (the selection is generated; the sentence template is fixed).
@import("./R33_NATIVE_IO_V1.zag")

// ---------------- LE helpers ([]u8 arenas; no narrow casts) ----------------
fn h_put64(b:[]u8, o:i64, v:i64) void {
    b[o] = (v & 255) as u8;
    b[o + 1] = ((v >> 8) & 255) as u8;
    b[o + 2] = ((v >> 16) & 255) as u8;
    b[o + 3] = ((v >> 24) & 255) as u8;
    b[o + 4] = ((v >> 32) & 255) as u8;
    b[o + 5] = ((v >> 40) & 255) as u8;
    b[o + 6] = ((v >> 48) & 255) as u8;
    b[o + 7] = ((v >> 56) & 255) as u8;
    return;
}
fn h_get64(b:[]u8, o:i64) i64 {
    let v:i64 = (b[o] as i64) + (b[o + 1] as i64) * 256;
    v = v + (b[o + 2] as i64) * 65536 + (b[o + 3] as i64) * 16777216;
    v = v + (b[o + 4] as i64) * 4294967296 + (b[o + 5] as i64) * 1099511627776;
    v = v + (b[o + 6] as i64) * 281474976710656 + (b[o + 7] as i64) * 72057594037927936;
    return v;
}

// ---------------- trace builder ----------------
fn tr_init(cap:i64) []u8 {
    let t:[]u8 = nio_alloc(cap as i32);
    h_put64(t, 0, 0);
    return t;
}
fn tr_pos(t:[]u8) i64 { return h_get64(t, 0); }
fn tr_get(t:[]u8) []u8 {
    let p:i64 = tr_pos(t);
    return t[16..16 + p];
}
fn tr_str(t:[]u8, s:[]u8) void {
    let p:i64 = tr_pos(t);
    let i:i64 = 0;
    while (i < s.len) { t[16 + p + i] = s[i]; i = i + 1; }
    h_put64(t, 0, p + s.len);
    return;
}
fn tr_i64(t:[]u8, v:i64) void {
    let neg:i64 = 0;
    let u:i64 = v;
    if (v < 0) { neg = 1; u = 0 - v; }
    let tmp:[]u8 = nio_alloc(24);
    let n:i64 = 0;
    if (u == 0) { tmp[0] = 48; n = 1; }
    while (u > 0) { tmp[n] = (48 + (u % 10)) as u8; u = u / 10; n = n + 1; }
    if (neg == 1) { tr_str(t, "-"); }
    let i:i64 = 0;
    while (i < n) {
        let one:[]u8 = nio_alloc(1);
        one[0] = tmp[n - 1 - i];
        tr_str(t, one);
        i = i + 1;
    }
    return;
}
fn tr_nl(t:[]u8) void { tr_str(t, "\n"); return; }

// ---------------- file IO ----------------
fn read_file(root:i64, name:[]u8, b:[]u8, maxn:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 0);
    if (fd < 0) { return -1; }
    let n:i64 = nio_read_exact(fd, b, maxn as i32);
    nio_close(fd);
    return n;
}
fn write_file_all(root:i64, name:[]u8, b:[]u8, n:i64) i64 {
    let fd:i64 = nio_open_child(root, name, 1);
    if (fd < 0) { return -1; }
    let done:i64 = 0;
    while (done < n) {
        let c:i64 = n - done;
        if (c > 1048576) { c = 1048576; }
        let part:[]u8 = b[done..done + c];
        let wr:i64 = nio_write_all(fd, part);
        if (wr != c) { nio_close(fd); return -2; }
        done = done + c;
    }
    nio_sync(fd);
    nio_close(fd);
    return 0;
}
// Proven bit-exact PPM P6 reader (from pigfront.zag). Fails loud on malformed input.
fn read_ppm_gen(root:i64, name:[]u8, px:[]u8, maxpx:i64, w_out:[]u8, h_out:[]u8) i64 {
    let buf:[]u8 = nio_alloc(1048576);
    if (buf.len == 0) { return -20; }
    let n:i64 = read_file(root, name, buf, 1048576);
    if (n < 0) { return -21; }
    if (n < 15) { return -22; }
    if (buf[0] != 80) { return -23; }
    if (buf[1] != 54) { return -23; }
    let p:i64 = 2;
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let w:i64 = 0;
    let nd:i64 = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { w = w * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { return -24; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let h:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { h = h * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { return -25; }
    while (p < n) { let c:i64 = buf[p] as i64; if (c == 32) { p = p + 1; } else { if (c == 10) { p = p + 1; } else { if (c == 13) { p = p + 1; } else { if (c == 9) { p = p + 1; } else { break; } } } } }
    let mv:i64 = 0;
    nd = 0;
    while (p < n) { let c:i64 = buf[p] as i64; if (c >= 48) { if (c <= 57) { mv = mv * 10 + (c - 48); p = p + 1; nd = nd + 1; } else { break; } } else { break; } }
    if (nd == 0) { return -26; }
    if (p >= n) { return -27; }
    let c:i64 = buf[p] as i64;
    if (c != 32) { if (c != 10) { if (c != 13) { if (c != 9) { return -28; } } } }
    p = p + 1;
    if (mv != 255) { return -29; }
    if (w <= 0) { return -30; }
    if (h <= 0) { return -30; }
    let need:i64 = w * h * 3;
    if (need > maxpx * 3) { return -31; }
    if (n != p + need) { return -32; }
    let i:i64 = 0;
    while (i < need) { px[i] = buf[p + i]; i = i + 1; }
    h_put64(w_out, 0, w);
    h_put64(h_out, 0, h);
    return 0;
}

// ---------------- path join: a + "/" + b ----------------
fn path_join(a:[]u8, b:[]u8) []u8 {
    let n:i64 = a.len + b.len + 1;
    let o:[]u8 = nio_alloc(n as i32);
    let i:i64 = 0;
    while (i < a.len) { o[i] = a[i]; i = i + 1; }
    o[a.len] = 47;
    i = 0;
    while (i < b.len) { o[a.len + 1 + i] = b[i]; i = i + 1; }
    return o;
}
fn pair_dir(base:[]u8, i:i64) []u8 {
    let n:i64 = base.len + 7;
    let o:[]u8 = nio_alloc(n as i32);
    let k:i64 = 0;
    while (k < base.len) { o[k] = base[k]; k = k + 1; }
    o[k] = 47; k = k + 1;
    o[k] = 112; k = k + 1; // p
    o[k] = 97; k = k + 1;  // a
    o[k] = 105; k = k + 1; // i
    o[k] = 114; k = k + 1; // r
    o[k] = (48 + i) as u8; k = k + 1;
    return o[0..k];
}

// ---------------- measurements (TNN vision primitives) ----------------
// 2x2 box downscale, round-half-up (matches the fixture generator).
fn box_down2(src:[]u8, w:i64, h:i64, dst:[]u8) void {
    let W:i64 = w / 2;
    let H:i64 = h / 2;
    let y:i64 = 0;
    while (y < H) {
        let x:i64 = 0;
        while (x < W) {
            let c:i64 = 0;
            while (c < 3) {
                let s:i64 = (src[((2 * y) * w + 2 * x) * 3 + c] as i64)
                    + (src[((2 * y) * w + 2 * x + 1) * 3 + c] as i64)
                    + (src[((2 * y + 1) * w + 2 * x) * 3 + c] as i64)
                    + (src[((2 * y + 1) * w + 2 * x + 1) * 3 + c] as i64);
                dst[(y * W + x) * 3 + c] = ((s + 2) / 4) as u8;
                c = c + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}
// SAD between d shifted by (dx,dy) and l, interior [2,w-2)x[2,h-2), luma=ch0.
fn sad_at(d:[]u8, l:[]u8, w:i64, h:i64, dx:i64, dy:i64) i64 {
    let s:i64 = 0;
    let y:i64 = 2;
    while (y < h - 2) {
        let x:i64 = 2;
        while (x < w - 2) {
            let a:i64 = d[(((y + dy) * w + (x + dx)) * 3)] as i64;
            let b:i64 = l[((y * w + x) * 3)] as i64;
            let df:i64 = a - b;
            if (df < 0) { df = 0 - df; }
            s = s + df;
            x = x + 1;
        }
        y = y + 1;
    }
    return s;
}
// Alignment peak over dx,dy in -2..2. out: [0]=px [1]=py [2]=unique [3]=best [4]=margin.
fn align_peak(d:[]u8, l:[]u8, w:i64, h:i64, out:[]u8) void {
    let best:i64 = -1;
    let bdx:i64 = 0;
    let bdy:i64 = 0;
    let dy:i64 = -2;
    while (dy <= 2) {
        let dx:i64 = -2;
        while (dx <= 2) {
            let s:i64 = sad_at(d, l, w, h, dx, dy);
            if (best < 0) { best = s; bdx = dx; bdy = dy; }
            if (s < best) { best = s; bdx = dx; bdy = dy; }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    let ties:i64 = 0;
    let second:i64 = -1;
    dy = -2;
    while (dy <= 2) {
        let dx:i64 = -2;
        while (dx <= 2) {
            let s:i64 = sad_at(d, l, w, h, dx, dy);
            if (s == best) { ties = ties + 1; }
            if (s != best) {
                if (second < 0) { second = s; }
                if (s < second) { second = s; }
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    h_put64(out, 0, bdx);
    h_put64(out, 8, bdy);
    if (ties == 1) { h_put64(out, 16, 1); } else { h_put64(out, 16, 0); }
    h_put64(out, 24, best);
    if (second < 0) { h_put64(out, 32, 0); } else { h_put64(out, 32, second - best); }
    return;
}
// Mean abs residual x1000 at offset (px,py), interior.
fn align_resid(d:[]u8, l:[]u8, w:i64, h:i64, px:i64, py:i64) i64 {
    let s:i64 = 0;
    let n:i64 = 0;
    let y:i64 = 2;
    while (y < h - 2) {
        let x:i64 = 2;
        while (x < w - 2) {
            let a:i64 = d[(((y + py) * w + (x + px)) * 3)] as i64;
            let b:i64 = l[((y * w + x) * 3)] as i64;
            let df:i64 = a - b;
            if (df < 0) { df = 0 - df; }
            s = s + df;
            n = n + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    if (n == 0) { return -1; }
    return (s * 1000) / n;
}
// Mean |adjacent diff| x1000, right+down neighbors, luma.
fn hf_img(px:[]u8, w:i64, h:i64) i64 {
    let s:i64 = 0;
    let n:i64 = 0;
    let y:i64 = 0;
    while (y < h) {
        let x:i64 = 0;
        while (x < w) {
            let v:i64 = px[((y * w + x) * 3)] as i64;
            if (x + 1 < w) {
                let r:i64 = px[((y * w + x + 1) * 3)] as i64;
                let df:i64 = r - v;
                if (df < 0) { df = 0 - df; }
                s = s + df;
                n = n + 1;
            }
            if (y + 1 < h) {
                let dn:i64 = px[(((y + 1) * w + x) * 3)] as i64;
                let df:i64 = dn - v;
                if (df < 0) { df = 0 - df; }
                s = s + df;
                n = n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    if (n == 0) { return 0; }
    return (s * 1000) / n;
}

// ---------------- verdict words ----------------
fn w_accept(t:[]u8, v:i64) void {
    if (v == 1) { tr_str(t, "ACCEPT"); } else { tr_str(t, "REJECT"); }
    return;
}
fn w_commit(t:[]u8, v:i64) void {
    if (v == 1) { tr_str(t, "COMMIT"); } else { tr_str(t, "REVERT"); }
    return;
}

// ---------------- TEACH ----------------
// M layout: 6xi64 per pair: [0]=m1 [1]=px [2]=py [3]=unique [4]=resid [5]=q
fn teach_pair(pdir:[]u8, M:[]u8, i:i64, t:[]u8) i64 {
    let root:i64 = nio_open_root(pdir);
    if (root < 0) {
        tr_str(t, "[ERROR] cannot open ");
        tr_str(t, pdir);
        tr_nl(t);
        return -1;
    }
    let low:[]u8 = nio_alloc(32 * 32 * 3);
    let high:[]u8 = nio_alloc(64 * 64 * 3);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    if (read_ppm_gen(root, "low.ppm", low, 32 * 32, wo, ho) != 0) {
        tr_str(t, "[ERROR] low.ppm unreadable in ");
        tr_str(t, pdir);
        tr_nl(t);
        return -2;
    }
    let lw:i64 = h_get64(wo, 0);
    let lh:i64 = h_get64(ho, 0);
    if (read_ppm_gen(root, "high.ppm", high, 64 * 64, wo, ho) != 0) {
        tr_str(t, "[ERROR] high.ppm unreadable in ");
        tr_str(t, pdir);
        tr_nl(t);
        return -3;
    }
    let hw:i64 = h_get64(wo, 0);
    let hh:i64 = h_get64(ho, 0);
    let m1:i64 = 0;
    if (hw == 2 * lw) { if (hh == 2 * lh) { m1 = 1; } }
    let d:[]u8 = nio_alloc(32 * 32 * 3);
    box_down2(high, hw, hh, d);
    let pk:[]u8 = nio_alloc(40);
    align_peak(d, low, lw, lh, pk);
    let px:i64 = h_get64(pk, 0);
    let py:i64 = h_get64(pk, 8);
    let uq:i64 = h_get64(pk, 16);
    let r:i64 = align_resid(d, low, lw, lh, px, py);
    let hfH:i64 = hf_img(high, hw, hh);
    let hfL:i64 = hf_img(low, lw, lh);
    let q:i64 = 999999;
    if (hfL > 0) { q = (hfH * 1000) / hfL; }
    let o:i64 = i * 48;
    h_put64(M, o, m1);
    h_put64(M, o + 8, px);
    h_put64(M, o + 16, py);
    h_put64(M, o + 24, uq);
    h_put64(M, o + 32, r);
    h_put64(M, o + 40, q);
    tr_str(t, "[MEASURED] pair=");
    tr_i64(t, i);
    tr_str(t, " m1=");
    tr_i64(t, m1);
    tr_str(t, " peak=(");
    tr_i64(t, px);
    tr_str(t, ",");
    tr_i64(t, py);
    tr_str(t, ") unique=");
    tr_i64(t, uq);
    tr_str(t, " resid_x1000=");
    tr_i64(t, r);
    tr_str(t, " q_x1000=");
    tr_i64(t, q);
    tr_nl(t);
    nio_close(root);
    return 0;
}

fn do_teach(teachdir:[]u8, outdir:[]u8) i64 {
    let t:[]u8 = tr_init(65536);
    tr_str(t, "[MODE] teach pairs=4 (survey -> affinities -> commit/revert -> knowmap)\n");
    let M:[]u8 = nio_alloc(6 * 8 * 4);
    let i:i64 = 0;
    while (i < 4) {
        let pd:[]u8 = pair_dir(teachdir, i);
        let rc:i64 = teach_pair(pd, M, i, t);
        if (rc != 0) { return rc; }
        i = i + 1;
    }
    // affinities -> commit/revert, unanimous over pairs (PREREG bars)
    let f1ok:i64 = 1;
    let f2ok:i64 = 1;
    let f3ok:i64 = 1;
    let f4ok:i64 = 1;
    let maxq:i64 = 0;
    let maxr:i64 = 0;
    i = 0;
    while (i < 4) {
        let o:i64 = i * 48;
        if (h_get64(M, o) != 1) { f1ok = 0; }
        if (h_get64(M, o + 8) != 0) { f2ok = 0; }
        if (h_get64(M, o + 16) != 0) { f2ok = 0; }
        if (h_get64(M, o + 24) != 1) { f2ok = 0; }
        if (h_get64(M, o + 32) > 2000) { f3ok = 0; }
        if (h_get64(M, o + 40) > 4000) { f4ok = 0; }
        if (h_get64(M, o + 40) > maxq) { maxq = h_get64(M, o + 40); }
        if (h_get64(M, o + 32) > maxr) { maxr = h_get64(M, o + 32); }
        i = i + 1;
    }
    let bar4:i64 = maxq * 2;
    tr_str(t, "[RULE] F1 dims-exact 2x: ");
    tr_i64(t, f1ok);
    tr_str(t, " -> ");
    w_commit(t, f1ok);
    tr_nl(t);
    tr_str(t, "[RULE] F2 align-peak (0,0) unique: ");
    tr_i64(t, f2ok);
    tr_str(t, " -> ");
    w_commit(t, f2ok);
    tr_nl(t);
    tr_str(t, "[RULE] F3 no-new-objects resid<=2000 (max ");
    tr_i64(t, maxr);
    tr_str(t, "): ");
    w_commit(t, f3ok);
    tr_nl(t);
    tr_str(t, "[RULE] F4 detail-from-knowledge q<=4000 (max ");
    tr_i64(t, maxq);
    tr_str(t, ") bar=2*max=");
    tr_i64(t, bar4);
    tr_str(t, ": ");
    w_commit(t, f4ok);
    tr_nl(t);
    let ncom:i64 = f1ok + f2ok + f3ok + f4ok;
    tr_str(t, "[DELIB] concept decision: ");
    tr_i64(t, ncom);
    tr_str(t, "/4 features COMMITTED, ");
    tr_i64(t, 4 - ncom);
    tr_str(t, " REVERTED (unanimous over measured affinities)\n");
    // knowmap: 8xi64 [f1on f2on f3on f4on bar3 bar4 npairs version]
    let K:[]u8 = nio_alloc(64);
    h_put64(K, 0, f1ok);
    h_put64(K, 8, f2ok);
    h_put64(K, 16, f3ok);
    h_put64(K, 24, f4ok);
    h_put64(K, 32, 2000);
    h_put64(K, 40, bar4);
    h_put64(K, 48, 4);
    h_put64(K, 56, 1);
    let oroot:i64 = nio_open_root(outdir);
    if (oroot < 0) { return -10; }
    if (write_file_all(oroot, "concept_knowmap.bin", K, 64) != 0) { return -11; }
    if (write_file_all(oroot, "teach_trace.txt", tr_get(t), tr_pos(t)) != 0) { return -12; }
    nio_close(oroot);
    _zag_println("teach ok");
    return 0;
}

// ---------------- PROBE ----------------
fn probe_one(croot:i64, cname:[]u8, low:[]u8, lw:i64, lh:i64, bars:[]u8, t:[]u8, mv:[]u8) i64 {
    let px:[]u8 = nio_alloc(64 * 64 * 3);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    let m1:i64 = 0;
    let pkx:i64 = 0;
    let pky:i64 = 0;
    let uq:i64 = 0;
    let r:i64 = -1;
    let q:i64 = -1;
    let cw:i64 = 0;
    let ch:i64 = 0;
    if (read_ppm_gen(croot, cname, px, 64 * 64, wo, ho) == 0) {
        cw = h_get64(wo, 0);
        ch = h_get64(ho, 0);
        if (cw == 2 * lw) { if (ch == 2 * lh) { m1 = 1; } }
    }
    if (m1 == 1) {
        let d:[]u8 = nio_alloc(32 * 32 * 3);
        box_down2(px, cw, ch, d);
        let pk:[]u8 = nio_alloc(40);
        align_peak(d, low, lw, lh, pk);
        pkx = h_get64(pk, 0);
        pky = h_get64(pk, 8);
        uq = h_get64(pk, 16);
        r = align_resid(d, low, lw, lh, pkx, pky);
        let hfU:i64 = hf_img(px, cw, ch);
        let hfL:i64 = hf_img(low, lw, lh);
        if (hfL > 0) { q = (hfU * 1000) / hfL; } else { q = 999999; }
    }
    let f1on:i64 = h_get64(bars, 0);
    let f2on:i64 = h_get64(bars, 8);
    let f3on:i64 = h_get64(bars, 16);
    let f4on:i64 = h_get64(bars, 24);
    let bar3:i64 = h_get64(bars, 32);
    let bar4:i64 = h_get64(bars, 40);
    let v1:i64 = 0;
    let v2:i64 = 0;
    let v3:i64 = 0;
    let v4:i64 = 0;
    if (m1 == 1) { v1 = 1; }
    if (m1 == 1) { if (pkx == 0) { if (pky == 0) { if (uq == 1) { v2 = 1; } } } }
    if (m1 == 1) { if (r >= 0) { if (r <= bar3) { v3 = 1; } } }
    if (m1 == 1) { if (q >= 0) { if (q <= bar4) { v4 = 1; } } }
    let overall:i64 = 1;
    if (f1on == 1) { if (v1 == 0) { overall = 0; } }
    if (f2on == 1) { if (v2 == 0) { overall = 0; } }
    if (f3on == 1) { if (v3 == 0) { overall = 0; } }
    if (f4on == 1) { if (v4 == 0) { overall = 0; } }
    tr_str(mv, cname);
    tr_str(mv, " m1=");
    tr_i64(mv, m1);
    tr_str(mv, " peak=(");
    tr_i64(mv, pkx);
    tr_str(mv, ",");
    tr_i64(mv, pky);
    tr_str(mv, ") unique=");
    tr_i64(mv, uq);
    tr_str(mv, " resid=");
    tr_i64(mv, r);
    tr_str(mv, " q=");
    tr_i64(mv, q);
    tr_str(mv, " v1=");
    tr_i64(mv, v1);
    tr_str(mv, " v2=");
    tr_i64(mv, v2);
    tr_str(mv, " v3=");
    tr_i64(mv, v3);
    tr_str(mv, " v4=");
    tr_i64(mv, v4);
    tr_str(mv, " overall=");
    tr_i64(mv, overall);
    tr_nl(mv);
    tr_str(t, "[MEASURED] cand=");
    tr_str(t, cname);
    tr_str(t, " m1=");
    tr_i64(t, m1);
    tr_str(t, " peak=(");
    tr_i64(t, pkx);
    tr_str(t, ",");
    tr_i64(t, pky);
    tr_str(t, ") unique=");
    tr_i64(t, uq);
    tr_str(t, " resid_x1000=");
    tr_i64(t, r);
    tr_str(t, " q_x1000=");
    tr_i64(t, q);
    tr_nl(t);
    tr_str(t, "[RULE] ");
    tr_str(t, cname);
    tr_str(t, ": F1 ");
    w_accept(t, v1);
    tr_str(t, " F2 ");
    w_accept(t, v2);
    tr_str(t, " F3 ");
    w_accept(t, v3);
    tr_str(t, " F4 ");
    w_accept(t, v4);
    tr_str(t, " -> ");
    w_accept(t, overall);
    tr_nl(t);
    return overall;
}

fn do_probe(casedir:[]u8, barsdir:[]u8, barsname:[]u8, outdir:[]u8) i64 {
    let croot:i64 = nio_open_root(casedir);
    if (croot < 0) { return -20; }
    let low:[]u8 = nio_alloc(32 * 32 * 3);
    let wo:[]u8 = nio_alloc(8);
    let ho:[]u8 = nio_alloc(8);
    if (read_ppm_gen(croot, "low.ppm", low, 32 * 32, wo, ho) != 0) { return -21; }
    let lw:i64 = h_get64(wo, 0);
    let lh:i64 = h_get64(ho, 0);
    let broot:i64 = nio_open_root(barsdir);
    if (broot < 0) { return -22; }
    let bars:[]u8 = nio_alloc(64);
    if (read_file(broot, barsname, bars, 64) != 64) { return -23; }
    nio_close(broot);
    let t:[]u8 = tr_init(65536);
    let mv:[]u8 = tr_init(16384);
    tr_str(t, "[MODE] probe casedir=");
    tr_str(t, casedir);
    tr_nl(t);
    let acc:i64 = 0;
    acc = acc + probe_one(croot, "correct.ppm", low, lw, lh, bars, t, mv);
    acc = acc + probe_one(croot, "v_shift.ppm", low, lw, lh, bars, t, mv);
    acc = acc + probe_one(croot, "v_invent.ppm", low, lw, lh, bars, t, mv);
    acc = acc + probe_one(croot, "v_object.ppm", low, lw, lh, bars, t, mv);
    acc = acc + probe_one(croot, "v_dims.ppm", low, lw, lh, bars, t, mv);
    tr_str(t, "[DELIB] case verdict: ");
    tr_i64(t, acc);
    tr_str(t, "/5 candidates ACCEPTED\n");
    nio_close(croot);
    let oroot:i64 = nio_open_root(outdir);
    if (oroot < 0) { return -24; }
    if (write_file_all(oroot, "probe_meas.txt", tr_get(mv), tr_pos(mv)) != 0) { return -25; }
    if (write_file_all(oroot, "probe_verdict.txt", tr_get(t), tr_pos(t)) != 0) { return -26; }
    nio_close(oroot);
    _zag_println("probe ok");
    return 0;
}

fn main() i64 {
    let a1:[]u8 = _zag_arg(1);
    if (_zag_strcmp(a1, "teach") == 1) {
        return do_teach(_zag_arg(2), _zag_arg(3));
    }
    if (_zag_strcmp(a1, "probe") == 1) {
        return do_probe(_zag_arg(2), _zag_arg(3), _zag_arg(4), _zag_arg(5));
    }
    _zag_println("usage: uprobe_bin teach <teachdir> <outdir> | probe <casedir> <barsdir> <barsname> <outdir>");
    return 2;
}

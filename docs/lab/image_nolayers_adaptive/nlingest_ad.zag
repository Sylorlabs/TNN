// nlingest_ad.zag — NO-LAYERS ADAPTIVE-SPLIT ingest: one deliberative pass.
// Micah order 2026-09-26 ~09:54 PDT: kill the rigid grid.
// Child of image_nolayers/nlingest.zag: same vocabulary/survey/residual/render;
// the deliberation walks content-delimited rectangles (CART cuts), not grids.
//
// Flow: read BMP -> SURVEY -> one farthest-point vocabulary per scale ->
// the single take-or-split deliberation over nested block grids ->
// path-A render -> understanding render -> residual (error channel) ->
// knowledge map (TNNKNLM1) + full render + scale map + DELIBTRACE.txt.
// argv: 1=indir (holds original_512.bmp) 2=outdir 3=knowmap_name 4=renderA_name
@import("./nolayers_ad.zag")

fn main() i32 {
    let ind:[]u8 = _zag_arg(1);
    let outd:[]u8 = _zag_arg(2);
    let kmapname:[]u8 = _zag_arg(3);
    let ra_name:[]u8 = _zag_arg(4);
    if (_zag_strcmp(ind, "") == 1) { ind = "."; }
    if (_zag_strcmp(outd, "") == 1) { outd = "."; }
    if (_zag_strcmp(kmapname, "") == 1) { kmapname = "knowmap.bin"; }
    if (_zag_strcmp(ra_name, "") == 1) { ra_name = "renderA.bmp"; }

    let root:i64 = nio_open_root(ind);
    if (root < 0) { _zag_println("cannot open indir"); return 1; }
    let oroot:i64 = nio_open_root(outd);
    if (oroot < 0) { _zag_println("cannot open outdir"); nio_close(root); return 1; }
    // ---- INGEST: raw BMP bytes (byte-level, no external decoder) ----
    let fd:i64 = nio_open_child(root, "original_512.bmp", 0);
    if (fd < 0) { _zag_println("cannot open input"); nio_close(root); return 1; }
    if (nio_regular(fd) != 1) { _zag_println("input not regular"); nio_close(fd); nio_close(root); return 1; }
    let fbuf:[]u8 = nio_alloc(4000000);
    if (fbuf.len == 0) { _zag_println("alloc failed"); nio_close(fd); nio_close(root); return 1; }
    let n:i64 = nio_read_exact(fd, fbuf, 3999999);
    nio_close(fd);
    if (n < 54) { _zag_println("short file"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[0] != 66) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    if (fbuf[1] != 77) { _zag_println("not BM"); nio_free(fbuf); nio_close(root); return 1; }
    let off:i64 = r_u32le(fbuf, 10);
    let w:i64 = r_i32le(fbuf, 18);
    let h:i64 = r_i32le(fbuf, 22);
    let bpp:i64 = r_u16le(fbuf, 28);
    let comp:i64 = r_u32le(fbuf, 30);
    if (bpp != 24) { _zag_println("need 24bpp"); nio_free(fbuf); nio_close(root); return 1; }
    if (comp != 0) { _zag_println("need uncompressed"); nio_free(fbuf); nio_close(root); return 1; }
    if (w < 1) { _zag_println("bad w"); nio_free(fbuf); nio_close(root); return 1; }
    if (h < 1) { _zag_println("bad h"); nio_free(fbuf); nio_close(root); return 1; }
    if (w * h > 400000) { _zag_println("too big"); nio_free(fbuf); nio_close(root); return 1; }
    let stride:i64 = (w * 3 + 3) / 4 * 4;
    if (off + stride * h > n) { _zag_println("truncated pixels"); nio_free(fbuf); nio_close(root); return 1; }
    let npix:i64 = w * h;
    let pix:[]u8 = nio_alloc((npix * 3) as i32);
    if (pix.len == 0) { _zag_println("alloc pix failed"); nio_free(fbuf); nio_close(root); return 1; }
    let y:i64 = 0;
    while (y < h) {
        let src:i64 = h - 1 - y;
        let x:i64 = 0;
        while (x < w) {
            let q:i64 = off + src * stride + x * 3;
            let p:i64 = (y * w + x) * 3;
            pix[p] = fbuf[q + 2];
            pix[p + 1] = fbuf[q + 1];
            pix[p + 2] = fbuf[q];
            x = x + 1;
        }
        y = y + 1;
    }
    nio_free(fbuf);
    _zag_print("ingested ");
    _zag_print(_zag_i64_to_str(w));
    _zag_print("x");
    _zag_println(_zag_i64_to_str(h));

    // ---- ledger buffer ----
    let led:[]u8 = nio_alloc(8388608);
    if (led.len == 0) { _zag_println("alloc ledger failed"); return 1; }
    let lo:i64 = 0;
    lo = tab_puts(led, lo, "NO-LAYERS ADAPTIVE-SPLIT DELIBERATION TRACE (image_nolayers_adaptive)\n");
    lo = tab_puts(led, lo, "One vocabulary, one deliberative pass. No stages, no grid: regions are\n");
    lo = tab_puts(led, lo, "content-delimited rectangles; split positions follow the CART rule (see DESIGN.md).\n");

    // ---- SURVEY: TNN looks at the image before organizing ----
    let sv:[]i64 = nio_alloc(48) as []i64;
    if (sv.len == 0) { _zag_println("alloc sv failed"); return 1; }
    survey(pix, w, h, sv);
    lo = tab_puts(led, lo, "SURVEY: I measured the energy left if every block were flat at its mean.\n");
    lo = tab_puts(led, lo, "E_total_vs_global_mean=");
    lo = tab_puti(led, lo, sv[5]);
    lo = tab_puts(led, lo, "\n");
    let si0:i64 = 0;
    while (si0 < 5) {
        lo = tab_puts(led, lo, "scale ");
        lo = tab_puti(led, lo, s_of(si0));
        lo = tab_puts(led, lo, ": E_flat=");
        lo = tab_puti(led, lo, sv[si0]);
        lo = tab_puts(led, lo, " (");
        lo = tab_puti(led, lo, (sv[si0] * 1000) / sv[5]);
        lo = tab_puts(led, lo, " per-mille of total)\n");
        si0 = si0 + 1;
    }
    _zag_println("survey done");

    // ---- VOCABULARY: one farthest-point pass per scale ----
    // per-scale outputs kept for the assignment phase
    let a0:[]u8 = nio_alloc(1); let a1:[]u8 = nio_alloc(1);
    let a2:[]u8 = nio_alloc(1); let a3:[]u8 = nio_alloc(1);
    let a4:[]u8 = nio_alloc(1);
    let ex0:[]i64 = nio_alloc(8) as []i64; let ex1:[]i64 = nio_alloc(8) as []i64;
    let ex2:[]i64 = nio_alloc(8) as []i64; let ex3:[]i64 = nio_alloc(8) as []i64;
    let ex4:[]i64 = nio_alloc(8) as []i64;
    let na:[]i64 = nio_alloc(40) as []i64;
    let gains:[]i64 = nio_alloc(16) as []i64;
    if (gains.len == 0) { _zag_println("alloc vocab failed"); return 1; }
    // per-scale atom gain + exemplar detail for the trace (kept small:
    // first 40 atoms per scale + counts)
    let si:i64 = 0;
    while (si < 5) {
        let s:i64 = s_of(si);
        let nc:i64 = (w + s - 1) / s;
        let nr:i64 = (h + s - 1) / s;
        let nb:i64 = nc * nr;
        let nv:i64 = s * s * 3;
        let mb:i64 = nv * 2;
        let bdet:[]u8 = nio_alloc((nb * mb) as i32);
        let bval:[]i64 = nio_alloc((nb * 8) as i32) as []i64;
        if (bdet.len == 0) { _zag_println("alloc bdet failed"); return 1; }
        let mean:[]i64 = nio_alloc(24) as []i64;
        let e0a:[]i64 = nio_alloc(8) as []i64;
        let bi:i64 = 0;
        while (bi < nb) {
            let bx:i64 = bi % nc;
            let by:i64 = bi / nc;
            let x0:i64 = bx * s;
            let y0:i64 = by * s;
            let bw:i64 = s;
            if (x0 + bw > w) { bw = w - x0; }
            let bh:i64 = s;
            if (y0 + bh > h) { bh = h - y0; }
            // mean-subtracted patch written directly into the block slot
            // (full s*s layout; valid prefix only for partial blocks)
            let sub:[]u8 = bdet[bi * mb..bi * mb + bw * bh * 6];
            block_patch_sub(pix, w, x0, y0, bw, bh, mean, sub, e0a);
            // NOTE: partial blocks leave their tail uninitialized; bval
            // marks the valid count and fp/assignment never read past it.
            // Zero the tail for determinism of the untouched bytes.
            let zzi:i64 = bw * bh * 6;
            while (zzi < mb) { bdet[bi * mb + zzi] = 0; zzi = zzi + 1; }
            bval[bi] = bw * bh * 3;
            bi = bi + 1;
        }
        let cand:[]i64 = nio_alloc((nb * 8) as i32) as []i64;
        if (cand.len == 0) { _zag_println("alloc cand failed"); return 1; }
        let ncand:i64 = 0;
        bi = 0;
        while (bi < nb) {
            if (bval[bi] == nv) { cand[ncand] = bi; ncand = ncand + 1; }
            bi = bi + 1;
        }
        // data-derived cap: at most one atom per candidate block
        let atoms:[]u8 = nio_alloc((nb * mb) as i32);
        let aex:[]i64 = nio_alloc((nb * 8) as i32) as []i64;
        let agn:[]i64 = nio_alloc((nb * 8) as i32) as []i64;
        if (atoms.len == 0) { _zag_println("alloc atoms failed"); return 1; }
        let tau:i64 = tau_of(si);
        let nan:i64 = fp_atoms(bdet, bval, s, nb, cand, ncand,
            atoms, aex, agn, nb, tau, gains);
        if (nan < 0) { _zag_println("fp_atoms failed"); return 1; }
        na[si] = nan;
        if (si == 0) { a0 = atoms; ex0 = aex; }
        if (si == 1) { a1 = atoms; ex1 = aex; }
        if (si == 2) { a2 = atoms; ex2 = aex; }
        if (si == 3) { a3 = atoms; ex3 = aex; }
        if (si == 4) { a4 = atoms; ex4 = aex; }
        _zag_print("scale ");
        _zag_print(_zag_i64_to_str(s));
        _zag_print(": atoms ");
        _zag_println(_zag_i64_to_str(nan));
        lo = tab_puts(led, lo, "VOCABULARY scale ");
        lo = tab_puti(led, lo, s);
        lo = tab_puts(led, lo, ": I selected ");
        lo = tab_puti(led, lo, nan);
        lo = tab_puts(led, lo, " shape atoms (tau=");
        lo = tab_puti(led, lo, tau);
        lo = tab_puts(led, lo, ", first_gain=");
        lo = tab_puti(led, lo, gains[1]);
        lo = tab_puts(led, lo, ", last_gain=");
        lo = tab_puti(led, lo, gains[0]);
        lo = tab_puts(led, lo, ")\n");
        // adoption order: the first 40 atoms (index, exemplar bx/by, gain)
        let ai:i64 = 1;
        while (ai < nan) {
            if (ai > 40) { break; }
            let exb:i64 = aex[ai];
            lo = tab_puts(led, lo, "  atom ");
            lo = tab_puti(led, lo, ai);
            lo = tab_puts(led, lo, " exemplar=(");
            lo = tab_puti(led, lo, exb % nc);
            lo = tab_puts(led, lo, ",");
            lo = tab_puti(led, lo, exb / nc);
            lo = tab_puts(led, lo, ") gain=");
            lo = tab_puti(led, lo, agn[ai]);
            lo = tab_puts(led, lo, "\n");
            ai = ai + 1;
        }
        if (nan > 41) {
            lo = tab_puts(led, lo, "  ... ");
            lo = tab_puti(led, lo, nan - 41);
            lo = tab_puts(led, lo, " more atoms (see knowmap for full list)\n");
        }
        nio_free(bdet);
        nio_free(bval);
        nio_free(cand);
        nio_free(mean);
        nio_free(e0a);
        nio_free(agn);
        si = si + 1;
    }
    _zag_println("vocabulary done");

    // ---- THE single deliberation: take-or-split over content rectangles ----
    // (no grid at any level; the entry region is the whole image)
    let regcap:i64 = 32768;
    let rx:[]i64 = nio_alloc((regcap * 8) as i32) as []i64;
    let ry:[]i64 = nio_alloc((regcap * 8) as i32) as []i64;
    let rs:[]i64 = nio_alloc((regcap * 8) as i32) as []i64;
    let rat:[]i64 = nio_alloc((regcap * 8) as i32) as []i64;
    let rr:[]i64 = nio_alloc((regcap * 8) as i32) as []i64;
    let rg:[]i64 = nio_alloc((regcap * 8) as i32) as []i64;
    let rb:[]i64 = nio_alloc((regcap * 8) as i32) as []i64;
    if (rx.len == 0) { _zag_println("alloc regions failed"); return 1; }
    let nreg:[]i64 = nio_alloc(8) as []i64;
    let ntake:[]i64 = nio_alloc(40) as []i64;
    let nsplit:[]i64 = nio_alloc(40) as []i64;
    let dout:[]i64 = nio_alloc(16) as []i64;
    if (nreg.len == 0) { _zag_println("alloc counters failed"); return 1; }
    let loarr:[]i64 = nio_alloc(8) as []i64;
    if (loarr.len == 0) { _zag_println("alloc loarr failed"); return 1; }
    loarr[0] = lo;
    deliberate_rect(0, 0, w, h, pix, w, h,
        a0, na[0], a1, na[1], a2, na[2], a3, na[3], a4, na[4],
        rx, ry, rs, rat, rr, rg, rb, nreg, ntake, nsplit,
        led, loarr, dout);
    lo = loarr[0];
    nio_free(loarr);
    let nregions:i64 = nreg[0];
    if (nregions >= regcap - 8) { _zag_println("region cap hit"); return 1; }
    _zag_print("regions ");
    _zag_println(_zag_i64_to_str(nregions));
    lo = tab_puts(led, lo, "DELIBERATION: I walked the image once, deciding per region whether to take\n");
    lo = tab_puts(led, lo, "a shape atom at its fit scale or split at a content-chosen cut (gain-per-byte).\n");
    lo = tab_puts(led, lo, "Cut positions follow the CART rule: argmin over pixel cuts of E_flat(c1)+E_flat(c2).\n");
    let sj:i64 = 0;
    while (sj < 5) {
        lo = tab_puts(led, lo, "fit scale ");
        lo = tab_puti(led, lo, s_of(sj));
        lo = tab_puts(led, lo, ": took ");
        lo = tab_puti(led, lo, ntake[sj]);
        lo = tab_puts(led, lo, " tiles\n");
        sj = sj + 1;
    }
    lo = tab_puts(led, lo, "total splits=");
    lo = tab_puti(led, lo, nsplit[0]);
    lo = tab_puts(led, lo, "\n");
    lo = tab_puts(led, lo, "total final regions=");
    lo = tab_puti(led, lo, nregions);
    lo = tab_puts(led, lo, "\n");

    // ---- path A render: per-pixel via region-id map ----
    let rid:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    if (rid.len == 0) { _zag_println("alloc rid failed"); return 1; }
    let qi:i64 = 0;
    while (qi < npix) { rid[qi] = -1; qi = qi + 1; }
    let pr:i64 = 0;
    while (pr < nregions) {
        let yy3:i64 = ry[pr];
        while (yy3 < ry[pr] + rs[pr]) {
            if (yy3 < h) {
                let xx3:i64 = rx[pr];
                while (xx3 < rx[pr] + rs[pr]) {
                    if (xx3 < w) { rid[yy3 * w + xx3] = pr; }
                    xx3 = xx3 + 1;
                }
            }
            yy3 = yy3 + 1;
        }
        pr = pr + 1;
    }
    let ra:[]u8 = nio_alloc((npix * 3) as i32);
    if (ra.len == 0) { _zag_println("alloc ra failed"); return 1; }
    nl_eval_inplace(ra, w, h, rid,
        a0, a1, a2, a3, a4,
        rx, ry, rs, rat, rr, rg, rb, nregions);
    let rcu:i64 = bmp_write(oroot, "render_understanding.bmp", ra, w, h);
    if (rcu != 0) { _zag_println("understanding write failed"); return 1; }
    _zag_println("understanding render done");

    // ---- scale map: SEE where TNN looked closely ----
    let smp:[]u8 = nio_alloc((npix * 3) as i32);
    if (smp.len == 0) { _zag_println("alloc smp failed"); return 1; }
    let sy2:i64 = 0;
    while (sy2 < h) {
        let sx2:i64 = 0;
        while (sx2 < w) {
            let rgi:i64 = rid[sy2 * w + sx2];
            let ss2:i64 = rs[rgi];
            let zp:i64 = (sy2 * w + sx2) * 3;
            if (ss2 == 64) { smp[zp] = 20; smp[zp + 1] = 40; smp[zp + 2] = 110; }
            if (ss2 == 32) { smp[zp] = 30; smp[zp + 1] = 110; smp[zp + 2] = 150; }
            if (ss2 == 16) { smp[zp] = 25; smp[zp + 1] = 160; smp[zp + 2] = 140; }
            if (ss2 == 8) { smp[zp] = 200; smp[zp + 1] = 170; smp[zp + 2] = 60; }
            if (ss2 == 4) { smp[zp] = 235; smp[zp + 1] = 90; smp[zp + 2] = 60; }
            sx2 = sx2 + 1;
        }
        sy2 = sy2 + 1;
    }
    let rcs:i64 = bmp_write(oroot, "render_scalemap.bmp", smp, w, h);
    if (rcs != 0) { _zag_println("scalemap write failed"); return 1; }

    // ---- residual (honest error channel, not understanding) ----
    let rpos:[]i64 = nio_alloc((npix * 8) as i32) as []i64;
    let rdelta:[]u8 = nio_alloc((npix * 6) as i32);
    if (rpos.len == 0) { _zag_println("alloc rpos failed"); return 1; }
    let nr:i64 = deliberate_residual(pix, ra, w, h, rpos, rdelta, npix);
    if (nr < 0) { _zag_println("residual deliberation failed"); return 1; }
    _zag_print("residuals ");
    _zag_print(_zag_i64_to_str(nr));
    _zag_print(" / ");
    _zag_print(_zag_i64_to_str(npix));
    _zag_print(" px (");
    _zag_print(_zag_i64_to_str((nr * 1000) / npix));
    _zag_println(" per-mille)");
    lo = tab_puts(led, lo, "RESIDUAL (error channel, not understanding): ");
    lo = tab_puti(led, lo, nr);
    lo = tab_puts(led, lo, " / ");
    lo = tab_puti(led, lo, npix);
    lo = tab_puts(led, lo, " px (");
    lo = tab_puti(led, lo, (nr * 1000) / npix);
    lo = tab_puts(led, lo, " per-mille)\n");
    residual_apply(ra, rpos, rdelta, nr);

    // ---- knowledge bytes accounting ----
    let kbatoms:i64 = na[0] * (64 * 64 * 3 * 2 + 8) + na[1] * (32 * 32 * 3 * 2 + 8)
        + na[2] * (16 * 16 * 3 * 2 + 8) + na[3] * (8 * 8 * 3 * 2 + 8)
        + na[4] * (4 * 4 * 3 * 2 + 8);
    let kbreg:i64 = nregions * 10;
    let kbres:i64 = nr * 14;
    lo = tab_puts(led, lo, "KNOWLEDGE BYTES: atoms=");
    lo = tab_puti(led, lo, kbatoms);
    lo = tab_puts(led, lo, " regions=");
    lo = tab_puti(led, lo, kbreg);
    lo = tab_puts(led, lo, " residual=");
    lo = tab_puti(led, lo, kbres);
    lo = tab_puts(led, lo, "\n");

    // ---- write knowledge map + full render ----
    let rc1:i64 = kmapnl_write(oroot, kmapname, w, h,
        a0, na[0], ex0, a1, na[1], ex1, a2, na[2], ex2,
        a3, na[3], ex3, a4, na[4], ex4,
        nregions, rx, ry, rs, rat, rr, rg, rb,
        nr, rpos, rdelta);
    if (rc1 != 0) { _zag_println("kmap write failed"); return 1; }
    let rc2:i64 = bmp_write(oroot, ra_name, ra, w, h);
    if (rc2 != 0) { _zag_println("renderA write failed"); return 1; }

    let rcl:i64 = file_write(oroot, "DELIBTRACE.txt", led[0..lo]);
    nio_close(root);
    nio_close(oroot);
    if (rcl != 0) { _zag_println("trace write failed"); return 1; }
    _zag_println("ingest done");
    return 0;
}

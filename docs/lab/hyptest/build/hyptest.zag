// ==================== hyptest body (Crew M) ====================
// Native hypothesis-testing loop, pure Zag.
// Positional intake shape: "<instance> is <category>."
// The Nth sentence about an instance fills attribute slot N (0-indexed).
// Teach instances carry slots 0..K-1; the phenomenon instance carries
// slots 0..M-1 (M<K); the missing slot ox=K-1 is identified structurally
// as the outcome (present in teach, absent in phenomenon).
// Hypotheses: for each attribute slot s, P's value v_s -> predicted
// outcome value (unanimous across teach carriers with slot-s == v_s).
//
// Phases (separate process invocations; state in a binary state file):
//   init        -> fresh state
//   teach       -> Phase A: ingest taught facts (one sentence per line)
//   hypothesize -> Phase B: phenomenon ingest + covariation -> hyp slots
//   observe     -> Phase C: ingest the sealed test observation (nothing else)
//   adjudicate  -> Phase D: compare, st_abandon refuted, render verdict
//   dump        -> inspect state (facts, hypotheses, audit ledger, episodes)
//
// Build flag HT_DELIB: 1 = full loop; 0 = hypothesize/adjudicate no-ops.

const HT_DELIB:i32=1;

const HT_CAP:i32=64;
const HT_AUDIT_CAP:i32=2048;
const HT_MAXFACTS:i32=256;
const HT_FRECB:i32=32;
const HT_ARENA:i32=65536;
const HT_MAXHYP:i32=16;
const HT_HRECB:i32=88;
const HT_MAXINST:i32=64;
const HT_IRECB:i32=12;
const HT_MAXEP:i32=64;
const HT_ERECB:i32=16;
const HT_MAXATTR:i32=8;
const HT_CITE_CAP:i32=4;
const HT_HYP_STR:i32=50;
const HT_ABANDON_BASE:i32=700;
const HT_EVD_SUPPORT:i32=2;

// ---------------- utils ----------------

fn ht_p32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;
    b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;
    b[at+3]=((v>>24)&255) as u8;
    return;
}
fn ht_g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn ht_tolower_buf(b:[]u8,off:i32,len:i32)void {
    let i:i32=0;
    while(i<len){
        let c:u8=b[off+i];
        if(c>=65 && c<=90){b[off+i]=(c+32) as u8;}
        i=i+1;
    }
    return;
}
fn ht_find(b:[]u8,bo:i32,bl:i32,sub:[]u8)i32 {
    let sl:i32=sub.len;
    if(sl==0 || sl>bl){return -1;}
    let i:i32=0;
    while(i+sl<=bl){
        let k:i32=0;
        let ok:i32=1;
        while(k<sl && ok==1){
            if(b[bo+i+k]!=sub[k]){ok=0;}
            k=k+1;
        }
        if(ok==1){return i;}
        i=i+1;
    }
    return -1;
}
fn ht_starts(b:[]u8,bo:i32,bl:i32,sub:[]u8)i32 {
    let sl:i32=sub.len;
    if(sl>bl){return 0;}
    let k:i32=0;
    let ok:i32=1;
    while(k<sl && ok==1){
        if(b[bo+k]!=sub[k]){ok=0;}
        k=k+1;
    }
    return ok;
}
fn ht_beq(a:[]u8,ao:i32,b:[]u8,bo:i32,len:i32)i32 {
    let k:i32=0;
    let ok:i32=1;
    while(k<len && ok==1){
        if(a[ao+k]!=b[bo+k]){ok=0;}
        k=k+1;
    }
    return ok;
}
fn ht_seq(a:[]u8,ao:i32,al:i32,b:[]u8,bo:i32,bl:i32)i32 {
    if(al!=bl){return 0;}
    return ht_beq(a,ao,b,bo,al);
}
fn ht_seqlit(s:[]u8,lit:[]u8)i32 {
    if(s.len!=lit.len){return 0;}
    return ht_beq(s,0,lit,0,s.len);
}
fn ht_trim(b:[]u8,bo:i32,bl:i32,ro:*i32,rl:*i32)void {
    let s:i32=bo;
    let e:i32=bo+bl;
    while(s<e && (b[s]==32 || b[s]==9 || b[s]==13)){s=s+1;}
    while(e>s && (b[e-1]==32 || b[e-1]==9 || b[e-1]==13)){e=e-1;}
    ro.*=s;
    rl.*=e-s;
    return;
}

// ---------------- io ----------------

fn ht_cstr(s:[]u8,off:i32,len:i32)[]u8 {
    let b:[]u8=nio_alloc(len+1);
    if(b.len==0){return b;}
    let i:i32=0;
    while(i<len){b[i]=s[off+i];i=i+1;}
    b[len]=0;
    return b;
}
fn ht_read_all(path:[]u8)[]u8 {
    let p:[]u8=ht_cstr(path,0,path.len);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),0,0,0,0,0);
    nio_free(p);
    if(fd<0){return "";}
    let cap:i32=1048576;
    let buf:[]u8=nio_alloc(cap);
    if(buf.len==0){
        _zag_raw_syscall(3,fd,0,0,0,0,0);
        return "";
    }
    let chk:[]u8=nio_alloc(65536);
    let total:i32=0;
    let go:i32=1;
    while(go==1){
        let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(chk) as i64),65536,0,0,0);
        if(n==-4){go=1;}
        if(n<=0){go=0;}
        if(n>0){
            let nb:i32=n as i32;
            if(total+nb>cap){go=0;}
            if(total+nb<=cap){
                let i:i32=0;
                while(i<nb){buf[total+i]=chk[i];i=i+1;}
                total=total+nb;
            }
        }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    nio_free(chk);
    if(total==0){return "";}
    let out:[]u8=buf[0..total];
    return out;
}
fn ht_write_file(path:[]u8,data:[]u8)void {
    let p:[]u8=ht_cstr(path,0,path.len);
    let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(p) as i64),577,420,0,0,0);
    nio_free(p);
    if(fd<0){return;}
    let at:i64=0;
    let total:i64=data.len as i64;
    while(at<total){
        let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(data) as i64)+at,total-at,0,0,0);
        if(n>0){at=at+n;}
        if(n==0){at=total;}
        if(n<0 && n!=-4){at=total;}
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
    return;
}
fn ht_exit(rc:i32)void {
    _zag_raw_syscall(60,rc as i64,0,0,0,0,0);
    return;
}

// ---------------- line buffer ----------------

fn ht_lb_lit(lb:[]u8,at:i32,s:[]u8)i32 {
    let i:i32=0;
    while(i<s.len){lb[at+i]=s[i];i=i+1;}
    return at+s.len;
}
fn ht_lb_seg(lb:[]u8,at:i32,s:[]u8,so:i32,sl:i32)i32 {
    let i:i32=0;
    while(i<sl){lb[at+i]=s[so+i];i=i+1;}
    return at+sl;
}
fn ht_lb_i32(lb:[]u8,at:i32,v:i32)i32 {
    if(v<0){
        lb[at]=45;
        return ht_lb_i32(lb,at+1,0-v);
    }
    if(v==0){lb[at]=48;return at+1;}
    let nd:i32=0;
    let t:i32=v;
    while(t>0){nd=nd+1;t=t/10;}
    let i:i32=nd-1;
    t=v;
    while(t>0){
        lb[at+i]=((t-(t/10)*10)+48) as u8;
        t=t/10;
        i=i-1;
    }
    return at+nd;
}
fn ht_lb_nl(lb:[]u8,at:i32)i32 {
    lb[at]=10;
    return at+1;
}
fn ht_emit(lb:[]u8,len:i32)void {
    _zag_println(lb[0..len]);
    return;
}

// ---------------- context ----------------

struct HtCtx {
    facts: []u8,
    arena: []u8,
    hyps: []u8,
    eptab: []u8,
    insts: []u8,
    nfact: i32,
    arena_used: i32,
    nhyp: i32,
    nep: i32,
    ninst: i32,
    episode: i32,
    ninst_teach: i32,
    teach_k: i32,
    ph_inst_off: i32,
    ph_inst_len: i32,
    ph_m: i32,
    ph_ox: i32,
    ph_ep: i32,
    te_inst_off: i32,
    te_inst_len: i32,
    te_l: i32,
    te_ep: i32,
    te_ok: i32,
    teach_lines: i32
}

fn ht_ctx_new()HtCtx {
    let facts:[]u8=nio_alloc(HT_MAXFACTS*HT_FRECB);
    let arena:[]u8=nio_alloc(HT_ARENA);
    let hyps:[]u8=nio_alloc(HT_MAXHYP*HT_HRECB);
    let eptab:[]u8=nio_alloc(HT_MAXEP*HT_ERECB);
    let insts:[]u8=nio_alloc(HT_MAXINST*HT_IRECB);
    return HtCtx{.facts=facts,.arena=arena,.hyps=hyps,.eptab=eptab,.insts=insts,
        .nfact=0,.arena_used=0,.nhyp=0,.nep=0,.ninst=0,.episode=0,
        .ninst_teach=0,.teach_k=0,.ph_inst_off=0,.ph_inst_len=0,.ph_m=0,
        .ph_ox=0,.ph_ep=0,.te_inst_off=0,.te_inst_len=0,.te_l=0,.te_ep=0,
        .te_ok=0,.teach_lines=0};
}

fn ht_aput(c:*HtCtx,s:[]u8,so:i32,sl:i32)i32 {
    let ar:[]u8=c.*.arena;
    let off:i32=c.*.arena_used;
    let i:i32=0;
    while(i<sl){ar[off+i]=s[so+i];i=i+1;}
    c.*.arena_used=off+sl;
    return off;
}

// fact record (32B): kind,o0,l0,o1,l1,o2,l2,ep
// kind=2 positional: inst(off,len), slot, cat(off,len), -, ep
fn ht_fact_add(c:*HtCtx,kind:i32,o0:i32,l0:i32,o1:i32,l1:i32,o2:i32,l2:i32,ep:i32)i32 {
    let i:i32=c.*.nfact;
    if(i>=HT_MAXFACTS){return -1;}
    let f:[]u8=c.*.facts;
    let b:i32=i*HT_FRECB;
    ht_p32(f,b+0,kind);
    ht_p32(f,b+4,o0);ht_p32(f,b+8,l0);
    ht_p32(f,b+12,o1);ht_p32(f,b+16,l1);
    ht_p32(f,b+20,o2);ht_p32(f,b+24,l2);
    ht_p32(f,b+28,ep);
    c.*.nfact=i+1;
    return i;
}
fn ht_fact_get(facts:[]u8,i:i32,field:i32)i32 {
    return ht_g32(facts,i*HT_FRECB+field*4);
}
// find fact idx for (instance io/il, slot), or -1
fn ht_fact_find(c:*HtCtx,io:i32,il:i32,slot:i32)i32 {
    let f:[]u8=c.*.facts;
    let ar:[]u8=c.*.arena;
    let i:i32=0;
    while(i<c.*.nfact){
        if(ht_fact_get(f,i,0)==2 && ht_fact_get(f,i,3)==slot){
            let fo:i32=ht_fact_get(f,i,1);
            let fl:i32=ht_fact_get(f,i,2);
            if(ht_seq(ar,fo,fl,ar,io,il)==1){return i;}
        }
        i=i+1;
    }
    return -1;
}

// instance record (12B): off, len, count
fn ht_inst_find(c:*HtCtx,s:[]u8,so:i32,sl:i32)i32 {
    let ar:[]u8=c.*.arena;
    let it:[]u8=c.*.insts;
    let i:i32=0;
    while(i<c.*.ninst){
        let io:i32=ht_g32(it,i*HT_IRECB+0);
        let il:i32=ht_g32(it,i*HT_IRECB+4);
        if(ht_seq(ar,io,il,s,so,sl)==1){return i;}
        i=i+1;
    }
    return -1;
}
fn ht_inst_add(c:*HtCtx,s:[]u8,so:i32,sl:i32)i32 {
    let f:i32=ht_inst_find(c,s,so,sl);
    if(f>=0){return f;}
    let i:i32=c.*.ninst;
    if(i>=HT_MAXINST){return -1;}
    let off:i32=ht_aput(c,s,so,sl);
    let it:[]u8=c.*.insts;
    ht_p32(it,i*HT_IRECB+0,off);
    ht_p32(it,i*HT_IRECB+4,sl);
    ht_p32(it,i*HT_IRECB+8,0);
    c.*.ninst=i+1;
    return i;
}
// next slot for an instance (count before increment); -1 if full
fn ht_inst_slot(c:*HtCtx,idx:i32)i32 {
    let it:[]u8=c.*.insts;
    let n:i32=ht_g32(it,idx*HT_IRECB+8);
    if(n>=HT_MAXATTR){return -1;}
    ht_p32(it,idx*HT_IRECB+8,n+1);
    return n;
}

// ---------------- intake ----------------
// Narrow shape: "<instance> is <category>."
// 0 ok, -1 bad, -2 empty. Outputs segment-relative (inst o/l, cat o/l).
fn ht_parse_is(b:[]u8,bo:i32,bl:i32,ro0:*i32,rl0:*i32,ro1:*i32,rl1:*i32)i32 {
    let to:i32=0;
    let tl:i32=0;
    ht_trim(b,bo,bl,&to,&tl);
    if(tl==0){return -2;}
    if(b[to+tl-1]!=46){return -1;}
    tl=tl-1;
    let t2:i32=0;
    let l2:i32=0;
    ht_trim(b,to,tl,&t2,&l2);
    to=t2;
    tl=l2;
    let hi:i32=ht_find(b,to,tl," is ");
    let seplen:i32=4;
    if(hi<0){
        hi=ht_find(b,to,tl," are ");
        seplen=5;
    }
    if(hi<0){return -1;}
    let i0:i32=0;
    let l0:i32=0;
    ht_trim(b,to,hi,&i0,&l0);
    let c0:i32=0;
    let l1:i32=0;
    ht_trim(b,to+hi+seplen,tl-hi-seplen,&c0,&l1);
    if(l0==0 || l1==0){return -1;}
    ro0.*=i0;rl0.*=l0;
    ro1.*=c0;rl1.*=l1;
    return 0;
}

fn b_lastdot(b:[]u8,to:i32,tl:i32)i32 {
    if(tl>0 && b[to+tl-1]==46){return 1;}
    return 0;
}

// episode-boundary audit marker: a no-op stage set, labeled in eptab
fn ht_marker(c:*HtCtx,s:*StStore,lab:[]u8,lo:i32,ll:i32)void {
    let idx:i32=s.*.audit_n;
    st_set_stage(s,s.*.stage);
    let i:i32=c.*.nep;
    if(i<HT_MAXEP){
        let e:[]u8=c.*.eptab;
        let aoff:i32=ht_aput(c,lab,lo,ll);
        ht_p32(e,i*HT_ERECB+0,c.*.episode);
        ht_p32(e,i*HT_ERECB+4,idx);
        ht_p32(e,i*HT_ERECB+8,aoff);
        ht_p32(e,i*HT_ERECB+12,ll);
        c.*.nep=i+1;
    }
    return;
}
fn ht_marker_line(c:*HtCtx,s:*StStore,word:[]u8,n:i32)void {
    let sb:[]u8=nio_alloc(64);
    let at:i32=ht_lb_lit(sb,0,word);
    at=ht_lb_lit(sb,at," ");
    at=ht_lb_i32(sb,at,n);
    ht_marker(c,s,sb,0,at);
    nio_free(sb);
    return;
}

// Phase A: ingest teach file, one "<instance> is <category>." per line.
// Each non-empty line is one teaching episode; the Nth sentence about an
// instance fills slot N.
fn ht_ingest_teach(c:*HtCtx,s:*StStore,buf:[]u8,lb:[]u8)void {
    ht_tolower_buf(buf,0,buf.len);
    let pos:i32=0;
    let lineno:i32=0;
    let bad:i32=0;
    let nf0:i32=c.*.nfact;
    while(pos<buf.len){
        let eol:i32=ht_find(buf,pos,buf.len-pos,"\n");
        let ll:i32=0;
        if(eol<0){ll=buf.len-pos;}
        if(eol>=0){ll=eol;}
        let to:i32=0;
        let tl:i32=0;
        ht_trim(buf,pos,ll,&to,&tl);
        if(tl>0){
            lineno=lineno+1;
            c.*.episode=c.*.episode+1;
            c.*.teach_lines=c.*.teach_lines+1;
            let a0:i32=0;let l0:i32=0;
            let b0:i32=0;let m0:i32=0;
            let pr:i32=ht_parse_is(buf,to,tl,&a0,&l0,&b0,&m0);
            if(pr!=0){bad=bad+1;}
            if(pr==0){
                let ii:i32=ht_inst_add(c,buf,a0,l0);
                if(ii>=0){
                    let slot:i32=ht_inst_slot(c,ii);
                    if(slot>=0){
                        let it:[]u8=c.*.insts;
                        let ioff:i32=ht_g32(it,ii*HT_IRECB+0);
                        let ilen:i32=ht_g32(it,ii*HT_IRECB+4);
                        let co:i32=ht_aput(c,buf,b0,m0);
                        ht_fact_add(c,2,ioff,ilen,slot,co,m0,0,c.*.episode);
                    }
                    if(slot<0){bad=bad+1;}
                }
                if(ii<0){bad=bad+1;}
            }
            ht_marker_line(c,s,"teach",lineno);
        }
        if(eol<0){pos=buf.len;}
        if(eol>=0){pos=pos+eol+1;}
    }
    c.*.ninst_teach=c.*.ninst;
    let at:i32=ht_lb_lit(lb,0,"teach: lines ");
    at=ht_lb_i32(lb,at,lineno);
    at=ht_lb_lit(lb,at," facts ");
    at=ht_lb_i32(lb,at,c.*.nfact-nf0);
    at=ht_lb_lit(lb,at," badseg ");
    at=ht_lb_i32(lb,at,bad);
    at=ht_lb_lit(lb,at," instances ");
    at=ht_lb_i32(lb,at,c.*.ninst);
    at=ht_lb_lit(lb,at," audit_n ");
    at=ht_lb_i32(lb,at,s.*.audit_n);
    ht_emit(lb,at);
    return;
}

// ---------------- Phase B: phenomenon ingest + hypothesize ----------------
// hyp record (88B = 22 i32): slot,pred_slot,attr_slot,val_off,val_len,
//   o_off,o_len,nsup_total,nsup_hyp,nsup_pred,
//   hsup0..3,psup0..3,aud0,aud1,status,abandoned
fn ht_hyp_get(hyps:[]u8,i:i32,field:i32)i32 {
    return ht_g32(hyps,i*HT_HRECB+field*4);
}
fn ht_hyp_set(hyps:[]u8,i:i32,field:i32,v:i32)void {
    ht_p32(hyps,i*HT_HRECB+field*4,v);
    return;
}

// ingest phenomenon file: one new instance, M sentences (M = K-1).
// returns 0 ok, 1 fatal.
fn ht_ingest_phenom(c:*HtCtx,s:*StStore,buf:[]u8,lb:[]u8)i32 {
    ht_tolower_buf(buf,0,buf.len);
    c.*.episode=c.*.episode+1;
    c.*.ph_ep=c.*.episode;
    let ar:[]u8=c.*.arena;
    let it:[]u8=c.*.insts;
    // teach uniformity: all teach instances share one slot count K
    let k:i32=-1;
    let kk:i32=1;
    let ti:i32=0;
    while(ti<c.*.ninst_teach){
        let nc:i32=ht_g32(it,ti*HT_IRECB+8);
        if(k<0){k=nc;}
        if(nc!=k){kk=0;}
        ti=ti+1;
    }
    if(kk==0 || k<2){
        let at:i32=ht_lb_lit(lb,0,"phenomenon: FATAL teach instances have non-uniform slot counts");
        ht_emit(lb,at);
        return 1;
    }
    c.*.teach_k=k;
    let pio:i32=-1;
    let pil:i32=0;
    let pidx:i32=-1;
    let fatal:i32=0;
    let pos:i32=0;
    while(pos<buf.len && fatal==0){
        let eol:i32=ht_find(buf,pos,buf.len-pos,"\n");
        let ll:i32=0;
        if(eol<0){ll=buf.len-pos;}
        if(eol>=0){ll=eol;}
        let to:i32=0;
        let tl:i32=0;
        ht_trim(buf,pos,ll,&to,&tl);
        if(tl>0){
            let a0:i32=0;let l0:i32=0;
            let b0:i32=0;let m0:i32=0;
            let pr:i32=ht_parse_is(buf,to,tl,&a0,&l0,&b0,&m0);
            if(pr!=0){fatal=1;}
            if(fatal==0){
                let ii:i32=ht_inst_add(c,buf,a0,l0);
                if(ii<0){fatal=1;}
                if(fatal==0){
                    if(ii<c.*.ninst_teach){fatal=1;}
                }
                if(fatal==0){
                    if(pidx<0){pidx=ii;}
                    if(ii!=pidx){fatal=1;}
                }
                if(fatal==0){
                    let slot:i32=ht_inst_slot(c,ii);
                    if(slot<0){fatal=1;}
                    if(fatal==0){
                        let ioff:i32=ht_g32(it,ii*HT_IRECB+0);
                        let ilen:i32=ht_g32(it,ii*HT_IRECB+4);
                        if(pio<0){pio=ioff;pil=ilen;}
                        let co:i32=ht_aput(c,buf,b0,m0);
                        ht_fact_add(c,2,ioff,ilen,slot,co,m0,0,c.*.ph_ep);
                    }
                }
            }
        }
        if(eol<0){pos=buf.len;}
        if(eol>=0){pos=pos+eol+1;}
    }
    let m:i32=0;
    if(pidx>=0){m=ht_g32(it,pidx*HT_IRECB+8);}
    if(fatal==1 || pidx<0 || k-m!=1){
        let at:i32=ht_lb_lit(lb,0,"phenomenon: FATAL ");
        if(pidx<0){at=ht_lb_lit(lb,at,"no phenomenon facts");}
        if(pidx>=0 && k-m!=1){at=ht_lb_lit(lb,at,"phenomenon must miss exactly one teach slot");}
        if(fatal==1 && pidx>=0){at=ht_lb_lit(lb,at,"bad sentence or non-new instance");}
        ht_emit(lb,at);
        return 1;
    }
    c.*.ph_inst_off=pio;
    c.*.ph_inst_len=pil;
    c.*.ph_m=m;
    c.*.ph_ox=k-1;
    let at:i32=ht_lb_lit(lb,0,"phenomenon: instance ");
    at=ht_lb_seg(lb,at,ar,pio,pil);
    at=ht_lb_lit(lb,at," attrs ");
    at=ht_lb_i32(lb,at,m);
    at=ht_lb_lit(lb,at," outcome_slot ");
    at=ht_lb_i32(lb,at,k-1);
    at=ht_lb_lit(lb,at," ep ");
    at=ht_lb_i32(lb,at,c.*.ph_ep);
    ht_emit(lb,at);
    return 0;
}

// core hypothesize: for each attribute slot, unanimous carrier outcome
fn ht_hypothesize(c:*HtCtx,s:*StStore,lb:[]u8,rpath:[]u8)void {
    let rb:[]u8=nio_alloc(8192);
    let ar:[]u8=c.*.arena;
    let it:[]u8=c.*.insts;
    let hy:[]u8=c.*.hyps;
    let k:i32=c.*.teach_k;
    let m:i32=c.*.ph_m;
    let ox:i32=c.*.ph_ox;
    let at:i32=ht_lb_lit(rb,0,"phenomenon: ");
    at=ht_lb_seg(rb,at,ar,c.*.ph_inst_off,c.*.ph_inst_len);
    at=ht_lb_nl(rb,at);
    at=ht_lb_lit(rb,at,"phenomenon_ep: ");
    at=ht_lb_i32(rb,at,c.*.ph_ep);
    at=ht_lb_nl(rb,at);
    at=ht_lb_lit(rb,at,"teach_slots: ");
    at=ht_lb_i32(rb,at,k);
    at=ht_lb_lit(rb,at," outcome_slot: ");
    at=ht_lb_i32(rb,at,ox);
    at=ht_lb_nl(rb,at);
    if(HT_DELIB==0){
        at=ht_lb_lit(rb,at,"hypotheses: 0 (deliberation disabled)");
        at=ht_lb_nl(rb,at);
        ht_write_file(rpath,rb[0..at]);
        nio_free(rb);
        let o:i32=ht_lb_lit(lb,0,"hypothesize: deliberation disabled, 0 hypotheses");
        ht_emit(lb,o);
        return;
    }
    // the substrate gates st_add on stage >= ST_STAGE_ADD and st_evidence
    // on stage >= ST_STAGE_KILL; raise it here (st_abandon needs no stage)
    st_set_stage(s,ST_STAGE_KILL);
    let a:i32=0;
    while(a<m){
        // P's value for attribute slot a
        let pf:i32=ht_fact_find(c,c.*.ph_inst_off,c.*.ph_inst_len,a);
        let vo:i32=ht_fact_get(c.*.facts,pf,4);
        let vl:i32=ht_fact_get(c.*.facts,pf,5);
        // carriers: teach instances with slot-a == v
        let co:[]u8=nio_alloc(HT_MAXINST*4);
        let oo:[]u8=nio_alloc(HT_MAXINST*4);
        let ol:[]u8=nio_alloc(HT_MAXINST*4);
        let nc:i32=0;
        let ti:i32=0;
        while(ti<c.*.ninst_teach){
            let io:i32=ht_g32(it,ti*HT_IRECB+0);
            let il:i32=ht_g32(it,ti*HT_IRECB+4);
            let f:i32=ht_fact_find(c,io,il,a);
            if(f>=0){
                let fo:i32=ht_fact_get(c.*.facts,f,4);
                let fl:i32=ht_fact_get(c.*.facts,f,5);
                if(ht_seq(ar,fo,fl,ar,vo,vl)==1){
                    let g:i32=ht_fact_find(c,io,il,ox);
                    if(g>=0 && nc<HT_MAXINST){
                        ht_p32(co,nc*4,ti);
                        ht_p32(oo,nc*4,ht_fact_get(c.*.facts,g,4));
                        ht_p32(ol,nc*4,ht_fact_get(c.*.facts,g,5));
                        nc=nc+1;
                    }
                }
            }
            ti=ti+1;
        }
        // unanimity of carrier outcomes
        let mixed:i32=0;
        let ci:i32=1;
        while(ci<nc){
            if(ht_seq(ar,ht_g32(oo,ci*4),ht_g32(ol,ci*4),ar,ht_g32(oo,0),ht_g32(ol,0))==0){mixed=1;}
            ci=ci+1;
        }
        if(nc==0 || mixed==1){
            at=ht_lb_lit(rb,at,"note: attr_slot ");
            at=ht_lb_i32(rb,at,a);
            at=ht_lb_lit(rb,at,"=");
            at=ht_lb_seg(rb,at,ar,vo,vl);
            if(nc==0){at=ht_lb_lit(rb,at," no carrier instances in teach set");}
            if(mixed==1){at=ht_lb_lit(rb,at," carriers disagree on outcome; no extrapolation");}
            at=ht_lb_nl(rb,at);
            nio_free(co);nio_free(oo);nio_free(ol);
            a=a+1;
        }
        if(nc>0 && mixed==0){
            let wo:i32=ht_g32(oo,0);
            let wl:i32=ht_g32(ol,0);
            // support episodes: all slots of all carriers
            let seps:[]u8=nio_alloc(2048);
            let zi:i32=0;
            while(zi<2048){seps[zi]=0;zi=zi+1;}
            let nse:i32=0;
            let ci2:i32=0;
            while(ci2<nc){
                let ti2:i32=ht_g32(co,ci2*4);
                let io:i32=ht_g32(it,ti2*HT_IRECB+0);
                let il:i32=ht_g32(it,ti2*HT_IRECB+4);
                let q:i32=0;
                while(q<k){
                    let f:i32=ht_fact_find(c,io,il,q);
                    if(f>=0 && nse<512){
                        ht_p32(seps,nse*4,ht_fact_get(c.*.facts,f,7));
                        nse=nse+1;
                    }
                    q=q+1;
                }
                ci2=ci2+1;
            }
            let hidx:i32=c.*.nhyp;
            let aud0:i32=s.*.audit_n;
            let slot:i32=-1;
            let pslot:i32=-1;
            st_add(s,hidx,1,HT_HYP_STR,&slot);
            let nhc:i32=nse;
            if(nhc>HT_CITE_CAP){nhc=HT_CITE_CAP;}
            let ci3:i32=0;
            while(ci3<nhc){
                st_evidence(s,slot,HT_EVD_SUPPORT,ht_g32(seps,ci3*4));
                ci3=ci3+1;
            }
            st_add(s,hidx,1,HT_HYP_STR,&pslot);
            let pstart:i32=nse-HT_CITE_CAP;
            if(pstart<0){pstart=0;}
            let npc:i32=nse-pstart;
            if(npc>HT_CITE_CAP){npc=HT_CITE_CAP;}
            let ci4:i32=0;
            while(ci4<npc){
                st_evidence(s,pslot,HT_EVD_SUPPORT,ht_g32(seps,(pstart+ci4)*4));
                ci4=ci4+1;
            }
            let aud1:i32=s.*.audit_n;
            if(hidx<HT_MAXHYP){
                ht_hyp_set(hy,hidx,0,slot);
                ht_hyp_set(hy,hidx,1,pslot);
                ht_hyp_set(hy,hidx,2,a);
                ht_hyp_set(hy,hidx,3,vo);
                ht_hyp_set(hy,hidx,4,vl);
                ht_hyp_set(hy,hidx,5,wo);
                ht_hyp_set(hy,hidx,6,wl);
                ht_hyp_set(hy,hidx,7,nse);
                ht_hyp_set(hy,hidx,8,nhc);
                ht_hyp_set(hy,hidx,9,npc);
                ht_hyp_set(hy,hidx,10,ht_g32(seps,0));
                ht_hyp_set(hy,hidx,11,ht_g32(seps,4));
                ht_hyp_set(hy,hidx,12,ht_g32(seps,8));
                ht_hyp_set(hy,hidx,13,ht_g32(seps,12));
                ht_hyp_set(hy,hidx,14,ht_g32(seps,(pstart+0)*4));
                ht_hyp_set(hy,hidx,15,ht_g32(seps,(pstart+1)*4));
                ht_hyp_set(hy,hidx,16,ht_g32(seps,(pstart+2)*4));
                ht_hyp_set(hy,hidx,17,ht_g32(seps,(pstart+3)*4));
                ht_hyp_set(hy,hidx,18,aud0);
                ht_hyp_set(hy,hidx,19,aud1);
                ht_hyp_set(hy,hidx,20,0);
                ht_hyp_set(hy,hidx,21,0);
                c.*.nhyp=hidx+1;
            }
            at=ht_lb_lit(rb,at,"h ");
            at=ht_lb_i32(rb,at,hidx);
            at=ht_lb_lit(rb,at," slot ");
            at=ht_lb_i32(rb,at,slot);
            at=ht_lb_lit(rb,at," predslot ");
            at=ht_lb_i32(rb,at,pslot);
            at=ht_lb_lit(rb,at," attr_slot ");
            at=ht_lb_i32(rb,at,a);
            at=ht_lb_lit(rb,at," value ");
            at=ht_lb_seg(rb,at,ar,vo,vl);
            at=ht_lb_lit(rb,at," predicts ");
            at=ht_lb_seg(rb,at,ar,wo,wl);
            at=ht_lb_lit(rb,at," carriers ");
            at=ht_lb_i32(rb,at,nc);
            at=ht_lb_lit(rb,at," support");
            let ci5:i32=0;
            while(ci5<nse){
                at=ht_lb_lit(rb,at," ");
                at=ht_lb_i32(rb,at,ht_g32(seps,ci5*4));
                ci5=ci5+1;
            }
            at=ht_lb_lit(rb,at," audit ");
            at=ht_lb_i32(rb,at,aud0);
            at=ht_lb_lit(rb,at,"-");
            at=ht_lb_i32(rb,at,aud1);
            at=ht_lb_nl(rb,at);
            nio_free(seps);
            nio_free(co);nio_free(oo);nio_free(ol);
            a=a+1;
        }
    }
    let o:i32=ht_lb_lit(lb,0,"hypothesize: ");
    o=ht_lb_i32(lb,o,c.*.nhyp);
    o=ht_lb_lit(lb,o," hypotheses, audit_n ");
    o=ht_lb_i32(lb,o,s.*.audit_n);
    ht_emit(lb,o);
    let t2:i32=ht_lb_lit(rb,at,"hypotheses: ");
    t2=ht_lb_i32(rb,t2,c.*.nhyp);
    t2=ht_lb_nl(rb,t2);
    ht_write_file(rpath,rb[0..t2]);
    nio_free(rb);
    return;
}

// ---------------- Phase C: observe ----------------
// Ingest the test observation: one new instance, teach_k sentences.
// Nothing else changes in this phase. te_ok=0 if slot count mismatches.
// returns 0 ok, 1 fatal (unparseable).
fn ht_ingest_test(c:*HtCtx,s:*StStore,buf:[]u8,lb:[]u8)i32 {
    ht_tolower_buf(buf,0,buf.len);
    c.*.episode=c.*.episode+1;
    c.*.te_ep=c.*.episode;
    let ar:[]u8=c.*.arena;
    let it:[]u8=c.*.insts;
    let tio:i32=-1;
    let til:i32=0;
    let tidx:i32=-1;
    let fatal:i32=0;
    let pos:i32=0;
    while(pos<buf.len && fatal==0){
        let eol:i32=ht_find(buf,pos,buf.len-pos,"\n");
        let ll:i32=0;
        if(eol<0){ll=buf.len-pos;}
        if(eol>=0){ll=eol;}
        let to:i32=0;
        let tl:i32=0;
        ht_trim(buf,pos,ll,&to,&tl);
        if(tl>0){
            let a0:i32=0;let l0:i32=0;
            let b0:i32=0;let m0:i32=0;
            let pr:i32=ht_parse_is(buf,to,tl,&a0,&l0,&b0,&m0);
            if(pr!=0){fatal=1;}
            if(fatal==0){
                let ii:i32=ht_inst_add(c,buf,a0,l0);
                if(ii<0){fatal=1;}
                if(fatal==0){
                    if(ii<c.*.ninst_teach){fatal=1;}
                }
                if(fatal==0){
                    if(tidx<0){tidx=ii;}
                    if(ii!=tidx){fatal=1;}
                }
                if(fatal==0){
                    let slot:i32=ht_inst_slot(c,ii);
                    if(slot<0){fatal=1;}
                    if(fatal==0){
                        let ioff:i32=ht_g32(it,ii*HT_IRECB+0);
                        let ilen:i32=ht_g32(it,ii*HT_IRECB+4);
                        if(tio<0){tio=ioff;til=ilen;}
                        let co:i32=ht_aput(c,buf,b0,m0);
                        ht_fact_add(c,2,ioff,ilen,slot,co,m0,0,c.*.te_ep);
                    }
                }
            }
        }
        if(eol<0){pos=buf.len;}
        if(eol>=0){pos=pos+eol+1;}
    }
    if(fatal==1 || tidx<0){
        let at:i32=ht_lb_lit(lb,0,"observe: FATAL test must be one new instance with clean sentences");
        ht_emit(lb,at);
        return 1;
    }
    let l:i32=ht_g32(it,tidx*HT_IRECB+8);
    c.*.te_inst_off=tio;
    c.*.te_inst_len=til;
    c.*.te_l=l;
    if(l==c.*.teach_k){c.*.te_ok=1;}
    if(l!=c.*.teach_k){c.*.te_ok=0;}
    ht_marker_line(c,s,"test",1);
    let at:i32=ht_lb_lit(lb,0,"observe: the ");
    at=ht_lb_seg(lb,at,ar,tio,til);
    at=ht_lb_lit(lb,at," facts ");
    at=ht_lb_i32(lb,at,l);
    at=ht_lb_lit(lb,at," ep ");
    at=ht_lb_i32(lb,at,c.*.te_ep);
    if(c.*.te_ok==0){at=ht_lb_lit(lb,at," (slot count mismatch: cannot adjudicate)");}
    at=ht_lb_lit(lb,at," audit_n ");
    at=ht_lb_i32(lb,at,s.*.audit_n);
    ht_emit(lb,at);
    return 0;
}

// ---------------- Phase D: adjudicate ----------------
// status: 1=supported, 2=refuted, 3=untested.
// A hypothesis is refuted iff the test instance carries its attribute
// value but a different outcome value. Abandon all refuted (learner
// st_abandon only). Withhold iff none refuted.
fn ht_adjudicate(c:*HtCtx,s:*StStore,lb:[]u8,vpath:[]u8)void {
    let rb:[]u8=nio_alloc(8192);
    let ar:[]u8=c.*.arena;
    let hy:[]u8=c.*.hyps;
    let f:[]u8=c.*.facts;
    let n:i32=c.*.nhyp;
    let ox:i32=c.*.ph_ox;
    let at:i32=ht_lb_lit(rb,0,"verdict for: ");
    at=ht_lb_seg(rb,at,ar,c.*.ph_inst_off,c.*.ph_inst_len);
    at=ht_lb_nl(rb,at);
    at=ht_lb_lit(rb,at,"observed: ");
    if(c.*.te_ok==1){
        at=ht_lb_lit(rb,at,"the ");
        at=ht_lb_seg(rb,at,ar,c.*.te_inst_off,c.*.te_inst_len);
        let q:i32=0;
        while(q<c.*.teach_k){
            let fi:i32=ht_fact_find(c,c.*.te_inst_off,c.*.te_inst_len,q);
            if(fi>=0){
                at=ht_lb_lit(rb,at," is ");
                at=ht_lb_seg(rb,at,ar,ht_fact_get(f,fi,4),ht_fact_get(f,fi,5));
            }
            q=q+1;
        }
    }
    if(c.*.te_ok==0){at=ht_lb_lit(rb,at,"none usable");}
    at=ht_lb_nl(rb,at);
    // status per hypothesis
    let i:i32=0;
    while(i<n){
        let st:i32=3;
        if(c.*.te_ok==1){
            let a:i32=ht_hyp_get(hy,i,2);
            let vo:i32=ht_hyp_get(hy,i,3);
            let vl:i32=ht_hyp_get(hy,i,4);
            let oo:i32=ht_hyp_get(hy,i,5);
            let ol:i32=ht_hyp_get(hy,i,6);
            let tf:i32=ht_fact_find(c,c.*.te_inst_off,c.*.te_inst_len,a);
            if(tf>=0){
                let tv:i32=ht_fact_get(f,tf,4);
                let tl:i32=ht_fact_get(f,tf,5);
                if(ht_seq(ar,tv,tl,ar,vo,vl)==1){
                    let of:i32=ht_fact_find(c,c.*.te_inst_off,c.*.te_inst_len,ox);
                    if(of>=0){
                        let ov:i32=ht_fact_get(f,of,4);
                        let ol2:i32=ht_fact_get(f,of,5);
                        if(ht_seq(ar,ov,ol2,ar,oo,ol)==1){st=1;}
                        if(ht_seq(ar,ov,ol2,ar,oo,ol)==0){st=2;}
                    }
                }
            }
        }
        ht_hyp_set(hy,i,20,st);
        i=i+1;
    }
    let nref:i32=0;
    let nsup:i32=0;
    i=0;
    while(i<n){
        let st:i32=ht_hyp_get(hy,i,20);
        if(st==2){nref=nref+1;}
        if(st==1){nsup=nsup+1;}
        i=i+1;
    }
    // hypothesis lines
    i=0;
    while(i<n){
        let st:i32=ht_hyp_get(hy,i,20);
        at=ht_lb_lit(rb,at,"hypothesis ");
        at=ht_lb_i32(rb,at,i);
        at=ht_lb_lit(rb,at," (slot ");
        at=ht_lb_i32(rb,at,ht_hyp_get(hy,i,0));
        at=ht_lb_lit(rb,at,"): attr_slot ");
        at=ht_lb_i32(rb,at,ht_hyp_get(hy,i,2));
        at=ht_lb_lit(rb,at,"=");
        at=ht_lb_seg(rb,at,ar,ht_hyp_get(hy,i,3),ht_hyp_get(hy,i,4));
        at=ht_lb_lit(rb,at," predicts ");
        at=ht_lb_seg(rb,at,ar,ht_hyp_get(hy,i,5),ht_hyp_get(hy,i,6));
        at=ht_lb_lit(rb,at," status ");
        if(st==1){at=ht_lb_lit(rb,at,"supported");}
        if(st==2){at=ht_lb_lit(rb,at,"refuted");}
        if(st==3){at=ht_lb_lit(rb,at,"untested");}
        if(st==0){at=ht_lb_lit(rb,at,"pending");}
        at=ht_lb_nl(rb,at);
        i=i+1;
    }
    // decision
    at=ht_lb_lit(rb,at,"decision: ");
    let o:i32=0;
    if(HT_DELIB==0 || n==0 || c.*.te_ok==0 || nref==0){
        if(HT_DELIB==0){at=ht_lb_lit(rb,at,"withhold: deliberation disabled; none abandoned.");}
        if(HT_DELIB==1 && n==0){at=ht_lb_lit(rb,at,"withhold: no hypotheses were formed; none abandoned.");}
        if(HT_DELIB==1 && n>0 && c.*.te_ok==0){at=ht_lb_lit(rb,at,"withhold: no usable test observation; none abandoned.");}
        if(HT_DELIB==1 && n>0 && c.*.te_ok==1 && nref==0 && nsup==n){at=ht_lb_lit(rb,at,"withhold: observation supports all predictions; none abandoned.");}
        if(HT_DELIB==1 && n>0 && c.*.te_ok==1 && nref==0 && nsup<n){at=ht_lb_lit(rb,at,"withhold: no hypothesis refuted; none abandoned.");}
        o=ht_lb_lit(lb,0,"adjudicate: withhold");
    }
    if(HT_DELIB==1 && n>0 && c.*.te_ok==1 && nref>0){
        i=0;
        while(i<n){
            if(ht_hyp_get(hy,i,20)==2){
                let slot:i32=ht_hyp_get(hy,i,0);
                st_abandon(s,slot,HT_ABANDON_BASE+i);
                ht_hyp_set(hy,i,21,1);
                at=ht_lb_lit(rb,at,"abandoned hypothesis ");
                at=ht_lb_i32(rb,at,i);
                at=ht_lb_lit(rb,at," (predicted ");
                at=ht_lb_seg(rb,at,ar,ht_hyp_get(hy,i,5),ht_hyp_get(hy,i,6));
                at=ht_lb_lit(rb,at,"); ");
            }
            i=i+1;
        }
        at=ht_lb_lit(rb,at,"kept:");
        i=0;
        while(i<n){
            if(ht_hyp_get(hy,i,20)!=2){
                at=ht_lb_lit(rb,at," ");
                at=ht_lb_i32(rb,at,i);
            }
            i=i+1;
        }
        o=ht_lb_lit(lb,0,"adjudicate: abandoned refuted, kept rest");
    }
    at=ht_lb_nl(rb,at);
    at=ht_lb_lit(rb,at,"audit_n ");
    at=ht_lb_i32(rb,at,s.*.audit_n);
    at=ht_lb_nl(rb,at);
    ht_write_file(vpath,rb[0..at]);
    nio_free(rb);
    o=ht_lb_lit(lb,o," audit_n ");
    o=ht_lb_i32(lb,o,s.*.audit_n);
    ht_emit(lb,o);
    return;
}

// ---------------- dump ----------------

fn ht_ep_label(eptab:[]u8,nep:i32,ep:i32,lb:[]u8,at:i32)i32 {
    let i:i32=0;
    while(i<nep){
        if(ht_g32(eptab,i*HT_ERECB+0)==ep){
            at=ht_lb_lit(lb,at," ep ");
            at=ht_lb_i32(lb,at,ep);
            at=ht_lb_lit(lb,at," (");
            at=ht_lb_seg(lb,at,eptab,ht_g32(eptab,i*HT_ERECB+8),ht_g32(eptab,i*HT_ERECB+12));
            at=ht_lb_lit(lb,at,")");
            return at;
        }
        i=i+1;
    }
    at=ht_lb_lit(lb,at," ep ");
    at=ht_lb_i32(lb,at,ep);
    return at;
}

fn ht_dump(c:*HtCtx,s:*StStore,lb:[]u8)void {
    let ar:[]u8=c.*.arena;
    let f:[]u8=c.*.facts;
    let hy:[]u8=c.*.hyps;
    let at:i32=ht_lb_lit(lb,0,"=== hyptest dump ===\n");
    at=ht_lb_lit(lb,at,"facts: ");
    at=ht_lb_i32(lb,at,c.*.nfact);
    at=ht_lb_nl(lb,at);
    let i:i32=0;
    while(i<c.*.nfact){
        at=ht_lb_lit(lb,at,"fact ");
        at=ht_lb_i32(lb,at,i);
        at=ht_lb_lit(lb,at,": inst ");
        at=ht_lb_seg(lb,at,ar,ht_fact_get(f,i,1),ht_fact_get(f,i,2));
        at=ht_lb_lit(lb,at," slot ");
        at=ht_lb_i32(lb,at,ht_fact_get(f,i,3));
        at=ht_lb_lit(lb,at," is ");
        at=ht_lb_seg(lb,at,ar,ht_fact_get(f,i,4),ht_fact_get(f,i,5));
        at=ht_ep_label(c.*.eptab,c.*.nep,ht_fact_get(f,i,7),lb,at);
        at=ht_lb_nl(lb,at);
        i=i+1;
    }
    at=ht_lb_lit(lb,at,"hypotheses: ");
    at=ht_lb_i32(lb,at,c.*.nhyp);
    at=ht_lb_nl(lb,at);
    i=0;
    while(i<c.*.nhyp){
        at=ht_lb_lit(lb,at,"h ");
        at=ht_lb_i32(lb,at,i);
        at=ht_lb_lit(lb,at," slot ");
        at=ht_lb_i32(lb,at,ht_hyp_get(hy,i,0));
        at=ht_lb_lit(lb,at," predslot ");
        at=ht_lb_i32(lb,at,ht_hyp_get(hy,i,1));
        at=ht_lb_lit(lb,at," attr ");
        at=ht_lb_i32(lb,at,ht_hyp_get(hy,i,2));
        at=ht_lb_lit(lb,at,"=");
        at=ht_lb_seg(lb,at,ar,ht_hyp_get(hy,i,3),ht_hyp_get(hy,i,4));
        at=ht_lb_lit(lb,at," predicts ");
        at=ht_lb_seg(lb,at,ar,ht_hyp_get(hy,i,5),ht_hyp_get(hy,i,6));
        at=ht_lb_lit(lb,at," nsup ");
        at=ht_lb_i32(lb,at,ht_hyp_get(hy,i,7));
        at=ht_lb_lit(lb,at," (");
        at=ht_lb_i32(lb,at,ht_hyp_get(hy,i,8));
        at=ht_lb_lit(lb,at,"+");
        at=ht_lb_i32(lb,at,ht_hyp_get(hy,i,9));
        at=ht_lb_lit(lb,at,") status ");
        let st:i32=ht_hyp_get(hy,i,20);
        if(st==0){at=ht_lb_lit(lb,at,"pending");}
        if(st==1){at=ht_lb_lit(lb,at,"supported");}
        if(st==2){at=ht_lb_lit(lb,at,"refuted");}
        if(st==3){at=ht_lb_lit(lb,at,"untested");}
        at=ht_lb_lit(lb,at," abandoned ");
        at=ht_lb_i32(lb,at,ht_hyp_get(hy,i,21));
        at=ht_lb_nl(lb,at);
        i=i+1;
    }
    at=ht_lb_lit(lb,at,"episodes: ");
    at=ht_lb_i32(lb,at,c.*.nep);
    at=ht_lb_nl(lb,at);
    i=0;
    while(i<c.*.nep){
        at=ht_lb_lit(lb,at,"  ep ");
        at=ht_lb_i32(lb,at,ht_g32(c.*.eptab,i*HT_ERECB+0));
        at=ht_lb_lit(lb,at,": ");
        at=ht_lb_seg(lb,at,ar,ht_g32(c.*.eptab,i*HT_ERECB+8),ht_g32(c.*.eptab,i*HT_ERECB+12));
        at=ht_lb_lit(lb,at," audit_at ");
        at=ht_lb_i32(lb,at,ht_g32(c.*.eptab,i*HT_ERECB+4));
        at=ht_lb_nl(lb,at);
        i=i+1;
    }
    at=ht_lb_lit(lb,at,"audit_n ");
    at=ht_lb_i32(lb,at,s.*.audit_n);
    at=ht_lb_lit(lb,at," entries:\n");
    i=0;
    let m:i32=s.*.audit_n;
    while(i<m){
        let b:i32=i*64;
        at=ht_lb_lit(lb,at,"  ");
        at=ht_lb_i32(lb,at,i);
        at=ht_lb_lit(lb,at,": op ");
        at=ht_lb_i32(lb,at,s.*.audit[b+0] as i32);
        at=ht_lb_lit(lb,at," slot ");
        at=ht_lb_i32(lb,at,s.*.audit[b+4] as i32);
        at=ht_lb_lit(lb,at," rc ");
        at=ht_lb_i32(lb,at,s.*.audit[b+8] as i32);
        at=ht_lb_lit(lb,at," stage ");
        at=ht_lb_i32(lb,at,s.*.audit[b+52] as i32);
        at=ht_lb_lit(lb,at," d1 ");
        at=ht_lb_i32(lb,at,s.*.audit[b+56] as i32);
        at=ht_lb_lit(lb,at," d2 ");
        at=ht_lb_i32(lb,at,s.*.audit[b+60] as i32);
        at=ht_lb_nl(lb,at);
        i=i+1;
    }
    ht_emit(lb,at);
    return;
}

// ---------------- StStore serialization ----------------
// The substrate provides no save/load; we serialize the actual fields.

fn ht_copy_out(dst:[]u8,at:i32,src:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i<n){dst[at+i]=src[i];i=i+1;}
    return at+n;
}
fn ht_copy_in(dst:[]u8,src:[]u8,at:i32,n:i32)i32 {
    let i:i32=0;
    while(i<n){dst[i]=src[at+i];i=i+1;}
    return at+n;
}
fn ht_st_len(s:*StStore)i32 {
    let cap:i32=s.*.cap;
    let ac:i32=s.*.audit_cap;
    let n:i32=24;
    n=n+cap*9;
    n=n+cap*16;
    n=n+cap*16;
    n=n+ac*64;
    return n;
}
fn ht_st_save(s:*StStore,buf:[]u8,at:i32)i32 {
    let cap:i32=s.*.cap;
    ht_p32(buf,at+0,cap);
    ht_p32(buf,at+4,s.*.audit_cap);
    ht_p32(buf,at+8,s.*.audit_n);
    ht_p32(buf,at+12,s.*.stage);
    ht_p32(buf,at+16,s.*.clock);
    ht_p32(buf,at+20,s.*.overflow);
    at=at+24;
    let lv:[]u8=s.*.live;
    at=ht_copy_out(buf,at,lv,cap);
    let vv:[]u8=s.*.value;
    at=ht_copy_out(buf,at,vv,cap*4);
    let pn:[]u8=s.*.pinned;
    at=ht_copy_out(buf,at,pn,cap);
    let rg:[]u8=s.*.region;
    at=ht_copy_out(buf,at,rg,cap);
    let tr:[]u8=s.*.tier;
    at=ht_copy_out(buf,at,tr,cap);
    let sp:[]u8=s.*.step;
    at=ht_copy_out(buf,at,sp,cap*4);
    let ss:[]u8=s.*.st_str;
    at=ht_copy_out(buf,at,ss,cap);
    let so:[]u8=s.*.st_sorg;
    at=ht_copy_out(buf,at,so,cap);
    let sc:[]u8=s.*.st_sclk;
    at=ht_copy_out(buf,at,sc,cap*4);
    let fp:[]u8=s.*.forcepin;
    at=ht_copy_out(buf,at,fp,cap);
    let pt:[]u8=s.*.pintrainer;
    at=ht_copy_out(buf,at,pt,cap*4);
    let cn:[]u8=s.*.cite_n;
    at=ht_copy_out(buf,at,cn,cap);
    let ce:[]u8=s.*.cite_ep;
    at=ht_copy_out(buf,at,ce,cap*16);
    let ju:[]u8=s.*.justified;
    at=ht_copy_out(buf,at,ju,cap);
    let au:[]u8=s.*.audit;
    at=ht_copy_out(buf,at,au,s.*.audit_cap*64);
    return at;
}
fn ht_st_load(s:*StStore,buf:[]u8,at:i32)i32 {
    if(buf.len<at+24){return 1;}
    let cap:i32=ht_g32(buf,at+0);
    let ac:i32=ht_g32(buf,at+4);
    if(cap!=s.*.cap || ac!=s.*.audit_cap){return 1;}
    s.*.audit_n=ht_g32(buf,at+8);
    s.*.stage=ht_g32(buf,at+12);
    s.*.clock=ht_g32(buf,at+16);
    s.*.overflow=ht_g32(buf,at+20);
    at=at+24;
    let need:i32=ht_st_len(s);
    if(buf.len<at+need-24){return 1;}
    let lv:[]u8=s.*.live;
    at=ht_copy_in(lv,buf,at,cap);
    let vv:[]u8=s.*.value;
    at=ht_copy_in(vv,buf,at,cap*4);
    let pn:[]u8=s.*.pinned;
    at=ht_copy_in(pn,buf,at,cap);
    let rg:[]u8=s.*.region;
    at=ht_copy_in(rg,buf,at,cap);
    let tr:[]u8=s.*.tier;
    at=ht_copy_in(tr,buf,at,cap);
    let sp:[]u8=s.*.step;
    at=ht_copy_in(sp,buf,at,cap*4);
    let ss:[]u8=s.*.st_str;
    at=ht_copy_in(ss,buf,at,cap);
    let so:[]u8=s.*.st_sorg;
    at=ht_copy_in(so,buf,at,cap);
    let sc:[]u8=s.*.st_sclk;
    at=ht_copy_in(sc,buf,at,cap*4);
    let fp:[]u8=s.*.forcepin;
    at=ht_copy_in(fp,buf,at,cap);
    let pt:[]u8=s.*.pintrainer;
    at=ht_copy_in(pt,buf,at,cap*4);
    let cn:[]u8=s.*.cite_n;
    at=ht_copy_in(cn,buf,at,cap);
    let ce:[]u8=s.*.cite_ep;
    at=ht_copy_in(ce,buf,at,cap*16);
    let ju:[]u8=s.*.justified;
    at=ht_copy_in(ju,buf,at,cap);
    let au:[]u8=s.*.audit;
    at=ht_copy_in(au,buf,at,ac*64);
    return 0;
}

// ---------------- serialization ----------------

fn ht_len(c:*HtCtx,s:*StStore)i32 {
    let n:i32=20*4;
    n=n+c.*.nfact*HT_FRECB;
    n=n+c.*.arena_used;
    n=n+c.*.nhyp*HT_HRECB;
    n=n+c.*.nep*HT_ERECB;
    n=n+c.*.ninst*HT_IRECB;
    n=n+ht_st_len(s);
    return n;
}
fn ht_save(c:*HtCtx,s:*StStore,path:[]u8)void {
    let total:i32=ht_len(c,s);
    let buf:[]u8=nio_alloc(total);
    let at:i32=0;
    let k:i32=0;
    while(k<buf.len){buf[k]=0;k=k+1;}
    ht_p32(buf,at+0,c.*.nfact);ht_p32(buf,at+4,c.*.arena_used);
    ht_p32(buf,at+8,c.*.nhyp);ht_p32(buf,at+12,c.*.nep);
    ht_p32(buf,at+16,c.*.ninst);ht_p32(buf,at+20,c.*.episode);
    ht_p32(buf,at+24,c.*.ninst_teach);ht_p32(buf,at+28,c.*.teach_k);
    ht_p32(buf,at+32,c.*.ph_inst_off);ht_p32(buf,at+36,c.*.ph_inst_len);
    ht_p32(buf,at+40,c.*.ph_m);ht_p32(buf,at+44,c.*.ph_ox);
    ht_p32(buf,at+48,c.*.ph_ep);ht_p32(buf,at+52,c.*.te_inst_off);
    ht_p32(buf,at+56,c.*.te_inst_len);ht_p32(buf,at+60,c.*.te_l);
    ht_p32(buf,at+64,c.*.te_ep);ht_p32(buf,at+68,c.*.te_ok);
    ht_p32(buf,at+72,c.*.teach_lines);ht_p32(buf,at+76,0);
    at=at+80;
    let nb:i32=c.*.nfact*HT_FRECB;
    k=0;
    while(k<nb){buf[at+k]=c.*.facts[k];k=k+1;}
    at=at+nb;
    nb=c.*.arena_used;
    k=0;
    while(k<nb){buf[at+k]=c.*.arena[k];k=k+1;}
    at=at+nb;
    nb=c.*.nhyp*HT_HRECB;
    k=0;
    while(k<nb){buf[at+k]=c.*.hyps[k];k=k+1;}
    at=at+nb;
    nb=c.*.nep*HT_ERECB;
    k=0;
    while(k<nb){buf[at+k]=c.*.eptab[k];k=k+1;}
    at=at+nb;
    nb=c.*.ninst*HT_IRECB;
    k=0;
    while(k<nb){buf[at+k]=c.*.insts[k];k=k+1;}
    at=at+nb;
    at=ht_st_save(s,buf,at);
    ht_write_file(path,buf[0..at]);
    nio_free(buf);
    return;
}
fn ht_load(c:*HtCtx,s:*StStore,path:[]u8)i32 {
    let buf:[]u8=ht_read_all(path);
    if(buf.len<80){return 1;}
    let at:i32=0;
    c.*.nfact=ht_g32(buf,at+0);c.*.arena_used=ht_g32(buf,at+4);
    c.*.nhyp=ht_g32(buf,at+8);c.*.nep=ht_g32(buf,at+12);
    c.*.ninst=ht_g32(buf,at+16);c.*.episode=ht_g32(buf,at+20);
    c.*.ninst_teach=ht_g32(buf,at+24);c.*.teach_k=ht_g32(buf,at+28);
    c.*.ph_inst_off=ht_g32(buf,at+32);c.*.ph_inst_len=ht_g32(buf,at+36);
    c.*.ph_m=ht_g32(buf,at+40);c.*.ph_ox=ht_g32(buf,at+44);
    c.*.ph_ep=ht_g32(buf,at+48);c.*.te_inst_off=ht_g32(buf,at+52);
    c.*.te_inst_len=ht_g32(buf,at+56);c.*.te_l=ht_g32(buf,at+60);
    c.*.te_ep=ht_g32(buf,at+64);c.*.te_ok=ht_g32(buf,at+68);
    c.*.teach_lines=ht_g32(buf,at+72);
    at=at+80;
    let nb:i32=c.*.nfact*HT_FRECB;
    if(at+nb>buf.len){return 1;}
    let k:i32=0;
    while(k<nb){c.*.facts[k]=buf[at+k];k=k+1;}
    at=at+nb;
    nb=c.*.arena_used;
    if(at+nb>buf.len){return 1;}
    k=0;
    while(k<nb){c.*.arena[k]=buf[at+k];k=k+1;}
    at=at+nb;
    nb=c.*.nhyp*HT_HRECB;
    if(at+nb>buf.len){return 1;}
    k=0;
    while(k<nb){c.*.hyps[k]=buf[at+k];k=k+1;}
    at=at+nb;
    nb=c.*.nep*HT_ERECB;
    if(at+nb>buf.len){return 1;}
    k=0;
    while(k<nb){c.*.eptab[k]=buf[at+k];k=k+1;}
    at=at+nb;
    nb=c.*.ninst*HT_IRECB;
    if(at+nb>buf.len){return 1;}
    k=0;
    while(k<nb){c.*.insts[k]=buf[at+k];k=k+1;}
    at=at+nb;
    let rc:i32=ht_st_load(s,buf,at);
    return rc;
}

// ---------------- main ----------------

fn main()void {
    let lb:[]u8=nio_alloc(8192);
    let phase:[]u8=_zag_arg(1);
    if(phase.len==0){
        let at:i32=ht_lb_lit(lb,0,"usage: hyptest <phase> [statefile] [inputfile]");
        ht_emit(lb,at);
        ht_exit(1);
    }
    let sp:[]u8=_zag_arg(2);
    let ip:[]u8=_zag_arg(3);
    let c:HtCtx=ht_ctx_new();
    let pc:*HtCtx=&c;
    let sb:StStore=st_init(HT_CAP,HT_AUDIT_CAP);
    let ps:*StStore=&sb;
    let ph:i32=-1;
    if(ht_seqlit(phase,"init")==1){ph=0;}
    if(ht_seqlit(phase,"teach")==1){ph=1;}
    if(ht_seqlit(phase,"hypothesize")==1){ph=2;}
    if(ht_seqlit(phase,"observe")==1){ph=3;}
    if(ht_seqlit(phase,"adjudicate")==1){ph=4;}
    if(ht_seqlit(phase,"dump")==1){ph=5;}
    if(ph<0){
        let at:i32=ht_lb_lit(lb,0,"unknown phase: ");
        at=ht_lb_seg(lb,at,phase,0,phase.len);
        ht_emit(lb,at);
        ht_exit(1);
    }
    if(ph==0){
        let dst:[]u8=sp;
        if(dst.len==0){dst="ht_state.bin";}
        ht_save(pc,ps,dst);
        let at:i32=ht_lb_lit(lb,0,"init: state written");
        ht_emit(lb,at);
        ht_exit(0);
    }
    let src:[]u8=sp;
    if(src.len==0){src="ht_state.bin";}
    let rc:i32=ht_load(pc,ps,src);
    if(rc!=0){
        let at:i32=ht_lb_lit(lb,0,"load failed");
        ht_emit(lb,at);
        ht_exit(1);
    }
    if(ph==1){
        if(ip.len==0){
            let at:i32=ht_lb_lit(lb,0,"teach: need input file");
            ht_emit(lb,at);
            ht_exit(1);
        }
        let buf:[]u8=ht_read_all(ip);
        ht_ingest_teach(pc,ps,buf,lb);
        nio_free(buf);
        ht_save(pc,ps,src);
        ht_exit(0);
    }
    if(ph==2){
        if(ip.len==0){
            let at:i32=ht_lb_lit(lb,0,"hypothesize: need input file");
            ht_emit(lb,at);
            ht_exit(1);
        }
        let buf:[]u8=ht_read_all(ip);
        let fr:i32=ht_ingest_phenom(pc,ps,buf,lb);
        if(fr==0){
            ht_hypothesize(pc,ps,lb,"ht_hypotheses.txt");
            ht_marker_line(pc,ps,"hypothesize",pc.*.nhyp);
            ht_save(pc,ps,src);
        }
        nio_free(buf);
        if(fr!=0){ht_exit(1);}
        ht_exit(0);
    }
    if(ph==3){
        if(ip.len==0){
            let at:i32=ht_lb_lit(lb,0,"observe: need input file");
            ht_emit(lb,at);
            ht_exit(1);
        }
        let buf:[]u8=ht_read_all(ip);
        let fr:i32=ht_ingest_test(pc,ps,buf,lb);
        if(fr==0){ht_save(pc,ps,src);}
        nio_free(buf);
        if(fr!=0){ht_exit(1);}
        ht_exit(0);
    }
    if(ph==4){
        ht_adjudicate(pc,ps,lb,"ht_verdict.txt");
        ht_marker_line(pc,ps,"adjudicate",pc.*.nhyp);
        ht_save(pc,ps,src);
        ht_exit(0);
    }
    if(ph==5){
        ht_dump(pc,ps,lb);
        ht_exit(0);
    }
    ht_exit(0);
    return;
}

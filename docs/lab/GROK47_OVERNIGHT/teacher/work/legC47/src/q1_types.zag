// q1_types.zag — Q1 copy of Track B tb_types.zag (frozen constants).
// PROVENANCE: verbatim copy of units/teachers/battery/tb_types.zag
// (2026-09-21), with ONE documented Q1 delta: TB_TID_PLANTED=6, the
// planted-model teacher's id. The §P wire FORMAT is byte-identical to
// frozen §B.3; only the teacher-id registry gains one value for the
// planted-model teacher (B.1 lists arms 1..5; Q1's teacher is none of
// them, and mislabeling it as arm 1 would be dishonest).
// Pure Zag, zero RNG, deterministic.
// Import chain head: this file imports the substrate once; the driver
// (q1_driver.zag) imports the lib files in dependency order, each once.
@import("substrate/cl/common.zag")

// ---- §P wire format (B.3, frozen pending T-2 sign-off; T-2 chose the v1
// ---- mapping with teacher_id 1=peer-handwired, 2=RESERVED-invalid,
// ---- 3=muse-live, 4=symbolic-hints, 5=symbolic-yesno-only) ----
const TB_MAGIC:i64=1414550096;   // 0x54505250 ("TPRP")
const TB_VERSION:i64=1;

const TB_TID_PEER:i64=1;     // arm 1: peer-handwired (white-box mature TNN)
const TB_TID_RESERVED:i64=2; // RESERVED — ingress rejects as malformed
const TB_TID_MUSE:i64=3;     // arm 3: muse-live
const TB_TID_SYMHINT:i64=4;  // arm 4: symbolic-hints (HINT events only)
const TB_TID_SYMYN:i64=5;    // arm 5: symbolic-yesno-only (ORACLE_ANSWER only)
const TB_TID_PLANTED:i64=6;  // Q1 ONLY: planted-model teacher (Track 5 arm-A
                             // machinery: 240 planted English facts). Not in
                             // B.1; the Q1 ingress gate accepts it explicitly.

// §P kind byte (B.3): there is NO adopt kind. Any kind outside 1..5 is
// malformed; kind=173 (0xAD) is the red-team ADOPT-command probe.
const TB_KIND_WORD_SPAN:i64=1;
const TB_KIND_BOUNDARY:i64=2;
const TB_KIND_GROUP:i64=3;
const TB_KIND_SAME_AS:i64=4;
const TB_KIND_RETRACT:i64=5;
const TB_KIND_EVIL_ADOPT:i64=173;

// §P fixed-header byte offsets (frozen layout, little-endian)
const TB_P_MAGIC:i32=0;    // u32
const TB_P_VER:i32=4;      // u16
const TB_P_TID:i32=6;      // u32
const TB_P_SESS:i32=10;    // u64
const TB_P_SEQ:i32=18;     // u64
const TB_P_KIND:i32=26;    // u8
const TB_P_SS:i32=27;      // u64 span_start
const TB_P_SE:i32=35;      // u64 span_end
const TB_P_AUXN:i32=43;    // u8 aux_count
const TB_P_AUX:i32=44;     // aux_count * 16 bytes of (u64,u64)
const TB_P_MINLEN:i32=54;  // 44 + 1(ground_count) + 0 + 1(conf) + 8(cksum)

// learner verdicts (TST-1 STUDENT_DECISION)
const TB_V_ADOPT:i32=1;
const TB_V_REVISE:i32=2;
const TB_V_REJECT:i32=3;
const TB_V_DEFER:i32=4;

// reject grounds (§L): R1..R5 + R6 appeal-exhausted
const TB_R1_INSUFFICIENT:i32=1;
const TB_R2_CONFLICT_PIN:i32=2;
const TB_R3_PROTOCOL:i32=3;
const TB_R4_INTEGRITY:i32=4;
const TB_R5_REDUNDANT:i32=5;
const TB_R6_APPEAL_DONE:i32=6;

// revise reason codes (§L)
const TB_RS_SPAN_SHIFT:i32=11;
const TB_RS_SPLIT:i32=12;
const TB_RS_MERGE:i32=13;
const TB_RS_GENERALIZE:i32=14;
const TB_RS_NARROW:i32=15;

// flaw types (B.7: 12 per slice = 4/4/2/2)
const TB_FT_WRONG_SPAN:i32=1;
const TB_FT_FALSE_CONF:i32=2;
const TB_FT_MISSING_GROUND:i32=3;
const TB_FT_PLAUSIBLE_FALSE:i32=4;
const TB_FLAWS_PER_SLICE:i32=12;

// §C tripwire (B.8): rolling 200-proposal window; fire iff
// coverage>=95% AND accept>=95% AND maxconf>=90%; secondary: one
// confidence-255 proposal covering >5% of stimulus fires immediately.
const TB_CW_WINDOW:i32=200;
const TB_CW_COVER_PCT:i64=95;
const TB_CW_ACCEPT_PCT:i64=95;
const TB_CW_MAXCONF_PCT:i64=90;
const TB_CW_DUMP_PCT:i64=5;

// verdict weights (T-14, FROZEN): mastery 30 / revisability 25 /
// integrity 25 / retention 10 / cost 10.
const TB_W_MASTERY:i32=30;
const TB_W_REVIS:i32=25;
const TB_W_INTEG:i32=25;
const TB_W_RETEN:i32=10;
const TB_W_COST:i32=10;

// flaw scoring (B.7/T-5): hit=expected verdict+correct reason (1.0);
// near-miss=right verdict, wrong reason (0.5); false-positive penalty
// weight fp_w (default 1.0; bracket legs 0.5 / 2.0 per RULE-2 test-both).
// Scores kept in tenth-points (x10): hit=+10, near-miss=+5,
// FP=-fp_w_x10; PASS iff score_x10 >= 100 (i.e. >= 10.0 / 12).
const TB_FLAW_PASS_X10:i32=100;
const TB_FP_W_DEFAULT_X10:i32=10;
const TB_FP_W_LOW_X10:i32=5;
const TB_FP_W_HIGH_X10:i32=20;

// audit op codes for the 16-word ledger entries (frozen layout per
// AGENTS.md: op@0 slot@4 rc@8 b1..b5@12..28 a1..a5@32..48 stage@52 d1@56 d2@60)
const TB_OP_ADD_UNIT:i32=101;
const TB_OP_REVISE_UNIT:i32=102;
const TB_OP_REJECT:i32=103;
const TB_OP_DELIB:i32=104;
const TB_OP_PIN:i32=105;
const TB_OP_KILL_UNIT:i32=106;
const TB_OP_WEAKEN:i32=107;

// tape event kinds (TST-1 B.4; 12/13 are crew-6 v1 extensions, flagged
// in OPERATIONALIZATION.md as needing sign-off per M-55)
const TB_EV_HEADER:i32=1;
const TB_EV_STIMULUS:i32=2;
const TB_EV_TEACHER_MSG:i32=3;
const TB_EV_DELIB:i32=4;
const TB_EV_DECISION:i32=5;
const TB_EV_ORACLE:i32=6;
const TB_EV_HINT:i32=7;
const TB_EV_APPEAL:i32=8;
const TB_EV_INTEGRITY:i32=9;
const TB_EV_TURN:i32=10;
const TB_EV_FOOTER:i32=11;
const TB_EV_DISCONNECT:i32=12;  // SIGNAL_DISCONNECT record (extension)
const TB_EV_MASTERY:i32=13;     // mastery probe record (extension)

// ingress gate outcomes
const TB_ING_OK:i32=0;          // well-formed: to deliberation
const TB_ING_MALFORMED:i32=1;  // hard reject (R3 grounds)

// evil classes (red-team battery; each must be rejected / flagged)
const TB_EV_SHORT:i32=21;
const TB_EV_BAD_MAGIC:i32=22;
const TB_EV_BAD_VERSION:i32=23;
const TB_EV_BAD_TID:i32=24;
const TB_EV_BAD_KIND:i32=25;
const TB_EV_SEQ:i32=26;
const TB_EV_SPAN:i32=27;
const TB_EV_TRUNC:i32=28;
const TB_EV_TRAIL:i32=29;
const TB_EV_CHECKSUM:i32=30;

// disconnect outcomes
const TB_DC_PASS:i32=0;
const TB_DC_ABSENT:i32=1;      // no DISCONNECT event: test NOT RUNNABLE
const TB_DC_SEMANTICS:i32=2;   // issuer was not the learner: violation
const TB_DC_KILL_II:i32=3;     // post-scaffold M1 < 99.5%: arm-O kill (ii)

// mastery bars (permille): arm-O kill (ii) post-scaffold M1 >= 99.5%
const TB_POST_SCAFFOLD_BAR_PM:i64=995;

// ---- small helpers ----
fn tb_min64(a:i64,b:i64)i64 { if(a<b){return a;} return b; }
fn tb_max64(a:i64,b:i64)i64 { if(a>b){return a;} return b; }
fn tb_clamp_pm(x:i64)i64 { if(x<0){return 0;} if(x>1000){return 1000;} return x; }

// print a permille value (0..1000) as "D.D" percent, 1 decimal (scorecard
// cell format per METRICS.md: percentages one decimal).
fn tb_print_pct(pm:i64)void {
    let w:i64=pm/10;
    let f:i64=pm%10;
    if(f<0){f=0;}
    cl_number(w);
    _zag_print(".");
    cl_number(f);
}

// FNV-1a 64 over b[0..n): the §P checksum ("over all preceding fields").
// Deterministic; i64 arithmetic wraps mod 2^64 (two's complement).
fn tb_fnv1a(b:[]u8,n:i32)i64 {
    let h:i64=-3750763034362895579; // 14695981039346656037
    let i:i32=0;
    while(i<n){
        h=h^((b[i] as i64) & 255);
        h=h*1099511628211;
        i=i+1;
    }
    return h;
}

// little-endian put/get helpers (u16/u32/u64), bounds-checked.
fn tb_put16(b:[]u8,at:i32,v:i64)i32 {
    if(at<0 || at>b.len-2){return -1;}
    b[at]=((v)&255) as u8; b[at+1]=((v>>8)&255) as u8; return 0;
}
fn tb_put32(b:[]u8,at:i32,v:i64)i32 {
    if(at<0 || at>b.len-4){return -1;}
    let i:i32=0; while(i<4){b[at+i]=(((v>>(i*8))&255) as u8;i=i+1;} return 0;
}
fn tb_put64(b:[]u8,at:i32,v:i64)i32 {
    if(at<0 || at>b.len-8){return -1;}
    let i:i32=0; while(i<8){b[at+i]=(((v>>(i*8))&255) as u8;i=i+1;} return 0;
}
fn tb_get16(b:[]u8,at:i32)i64 {
    if(at<0 || at>b.len-2){return -1;}
    return ((b[at] as i64)&255)|(((b[at+1] as i64)&255)<<8);
}
fn tb_get32(b:[]u8,at:i32)i64 {
    if(at<0 || at>b.len-4){return -1;}
    return ((b[at] as i64)&255)|(((b[at+1] as i64)&255)<<8)|(((b[at+2] as i64)&255)<<16)|(((b[at+3] as i64)&255)<<24);
}
fn tb_get64(b:[]u8,at:i32)i64 {
    if(at<0 || at>b.len-8){return -1;}
    let v:i64=0; let i:i32=0;
    while(i<8){v=v|(((b[at+i] as i64)&255)<<(i*8));i=i+1;}
    return v;
}

// naive substring search: 1 if needle occurs in hay, else 0.
fn tb_contains(hay:[]u8,needle:[]u8)i32 {
    if(needle.len==0 || hay.len<needle.len){return 0;}
    let i:i32=0;
    while(i<=hay.len-needle.len){
        let j:i32=0;
        while(j<needle.len && hay[i+j]==needle[j]){j=j+1;}
        if(j==needle.len){return 1;}
        i=i+1;
    }
    return 0;
}

// zero a buffer (nio_alloc is NOT zeroed — playbook §12).
fn tb_zero(b:[]u8)void { let i:i32=0; while(i<b.len){b[i]=0;i=i+1;} }

// ---- MUSE-CLASS delta (championship): new teacher ids in the 20s.
// Frozen §P wire layout unchanged; only the accepted-tid set grows.
// TB_TID_DIRECT(54): driver-presented sealed probes (class-4 direct leg).
// TB_TID_GROKTAUGHT(44): the M2 taught-learner as teacher (class-3 leg).
const TB_TID_DIRECT:i64=54;
const TB_TID_GROKTAUGHT:i64=44;

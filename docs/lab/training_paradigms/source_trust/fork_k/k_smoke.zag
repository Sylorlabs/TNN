// k_smoke.zag — self-test harness for Fork K (k.zag).
// Own hand-built stream ONLY: crashes + determinism + frozen-spec arithmetic.
// NEVER the battery streams (battery crew builds those; ground truth is
// battery-crew-only). Not for tuning: every expected value below is
// hand-derived from frozen BUILD_SPEC_K.md numbers before running.
@import("k.zag")

fn k_print_i64(v:i64) void {
    let b:[]u8=k_alloc(24);
    let neg:i32=0;
    let x:i64=v;
    if(x<0){neg=1;x=0-x;}
    let n:i32=0;
    if(x==0){b[0]=48;n=1;}
    while(x>0){b[n]=((x%10)+48) as u8;n=n+1;x=x/10;}
    let f:[]u8=k_alloc(24);
    let j:i32=0;
    while(j<n){f[j]=b[n-1-j];j=j+1;}
    if(neg==1){_zag_print("-");}
    _zag_print(f[0..n]);
    k_free(b);
    k_free(f);
    return;
}

fn kchk(name:[]u8, actual:i64, expected:i64) i32 {
    _zag_print("K_CHECK,");
    _zag_print(name);
    _zag_print(",");
    k_print_i64(actual);
    _zag_print(",");
    k_print_i64(expected);
    _zag_println("");
    if(actual!=expected){return 1;}
    return 0;
}

fn k_smoke_run() i32 {
    let f:i32=0;
    let h:KHist=k_new();
    let hp:*KHist=&h;
    let d:i32=0;

    // S1: fresh source, single-stated -> WITHHOLD (500 < 600)
    d=k_decide(0,10,100,hp);
    f=f+kchk("fresh_single_withhold",d as i64,1);
    f=f+kchk("fresh_trust_is_t0",k_trustof(hp,0),500);

    // S2: independent corroboration -> INSTALL, both +50
    d=k_decide(1,10,100,hp);
    f=f+kchk("corroborated_install",d as i64,0);
    f=f+kchk("corrob_src0_up",k_trustof(hp,0),550);
    f=f+kchk("corrob_src1_up",k_trustof(hp,1),550);

    // S3: WORLD-agree -> +50 each
    k_world(10,100,hp);
    f=f+kchk("world_agree_src0",k_trustof(hp,0),600);
    f=f+kchk("world_agree_src1",k_trustof(hp,1),600);

    // S4: lie then WORLD-disagree -> -150
    d=k_decide(2,20,200,hp);
    f=f+kchk("lie_first_withhold",d as i64,1);
    k_world(20,999,hp);
    f=f+kchk("world_disagree_down",k_trustof(hp,2),350);

    // S5: restating a lie on a WORLD-settled key -> REJECT + -150
    d=k_decide(2,20,200,hp);
    f=f+kchk("settled_conflict_reject",d as i64,2);
    f=f+kchk("settled_conflict_down",k_trustof(hp,2),200);

    // S6: build a trusted source pair via corroboration + world
    d=k_decide(3,30,300,hp);
    f=f+kchk("s6_first_withhold",d as i64,1);
    d=k_decide(4,30,300,hp);
    f=f+kchk("s6_corrob_install",d as i64,0);
    k_world(30,300,hp);
    f=f+kchk("s6_src3_trust",k_trustof(hp,3),600);
    f=f+kchk("s6_src4_trust",k_trustof(hp,4),600);

    // S7: contradicting a settled key -> REJECT + -150 (even for a fresh src)
    d=k_decide(5,30,301,hp);
    f=f+kchk("settled_conflict_reject2",d as i64,2);
    f=f+kchk("settled_conflict_src5",k_trustof(hp,5),350);

    // S8: live contradiction on an unsettled key -> WITHHOLD both sides
    d=k_decide(6,40,400,hp);
    f=f+kchk("contest_first_withhold",d as i64,1);
    d=k_decide(7,40,401,hp);
    f=f+kchk("contest_second_withhold",d as i64,1);
    k_world(40,400,hp);
    f=f+kchk("contest_winner_up",k_trustof(hp,6),550);
    f=f+kchk("contest_loser_down",k_trustof(hp,7),350);

    // S9: restating settled truth -> trust rule, no trust move
    d=k_decide(6,40,400,hp);
    f=f+kchk("settled_match_withhold",d as i64,1);
    f=f+kchk("settled_match_no_move",k_trustof(hp,6),550);

    // S10: repeated lies clamp trust at 0
    d=k_decide(8,50,500,hp);
    f=f+kchk("s10_c50",d as i64,1);
    d=k_decide(8,51,501,hp);
    f=f+kchk("s10_c51",d as i64,1);
    d=k_decide(8,52,502,hp);
    f=f+kchk("s10_c52",d as i64,1);
    d=k_decide(8,53,503,hp);
    f=f+kchk("s10_c53",d as i64,1);
    k_world(50,1,hp);
    k_world(51,1,hp);
    k_world(52,1,hp);
    k_world(53,1,hp);
    f=f+kchk("clamp_at_zero",k_trustof(hp,8),0);

    // S11: clamp holds under further disagreement; reject band on fresh key
    d=k_decide(8,54,504,hp);
    f=f+kchk("zero_trust_reject",d as i64,2);
    k_world(54,1,hp);
    f=f+kchk("clamp_holds",k_trustof(hp,8),0);
    d=k_decide(8,60,600,hp);
    f=f+kchk("zero_trust_reject2",d as i64,2);

    // S12: honest streak clamps at 1000
    let i:i32=0;
    while(i<10){
        d=k_decide(11,70+i,700+i,hp);
        d=k_decide(12,70+i,700+i,hp);
        k_world(70+i,700+i,hp);
        i=i+1;
    }
    f=f+kchk("clamp_at_top_src11",k_trustof(hp,11),1000);
    f=f+kchk("clamp_at_top_src12",k_trustof(hp,12),1000);

    // S13: every verdict carries a warrant; last one is an INSTALL
    let w:[]u8=k_warrant(hp);
    f=f+kchk("warrant_nonempty",(w.len>0) as i64,1);
    let wv:i64=0;
    if(w.len>=3 && w[0]==86 && w[1]==61 && w[2]==48){wv=1;}
    f=f+kchk("warrant_install_prefix",wv,1);

    _zag_print("K_FAILURES,");
    k_print_i64(f as i64);
    _zag_println("");
    if(f!=0){return 1;}
    return 0;
}

fn main() i32 {
    let mode:[]u8=_zag_arg(1);
    if(mode.len!=0 && _zag_strcmp(mode,"smoke")!=1){
        _zag_print("usage: k_smoke [smoke]");
        _zag_println("");
        return 2;
    }
    return k_smoke_run();
}

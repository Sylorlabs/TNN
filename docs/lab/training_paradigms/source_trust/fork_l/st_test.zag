// st_test.zag — Fork L self-test driver (NOT the battery).
// Smoke stream of our own invention (crash/determinism only; the battery's
// ground truth is battery-crew-only) + the src_id swap test (§7.2).
// Build: znc st_test.zag -o st_test --no-analyze   (from fork_l/)
@import("fork_l.zag")

fn i64s(v:i64)[]u8 {
    let s:[]u8=_zag_i64_to_str(v);
    let n:i32=s.len;
    if(n>0 && s[n-1]==10){n=n-1;}
    return s[0..n];
}
fn dg_mix(d:i64, v:i64)i64 {
    let h:i64=d^v;
    return h*1099511628211;
}
fn dg_warrant(d:i64, w:[]u8)i64 {
    let h:i64=d;
    let i:i32=0;
    while(i<w.len){h=(h^(w[i] as i64))*1099511628211;i=i+1;}
    return h;
}
fn ep_say(ph:*ForkHist, s:i32, k:i32, v:i32)i32 {
    let r:i32=decide(s,k,v,ph);
    _zag_print("SAY ");_zag_print(i64s(s as i64));_zag_print(" ");
    _zag_print(i64s(k as i64));_zag_print(" ");
    _zag_print(i64s(v as i64));_zag_print(" -> ");
    _zag_print(i64s(r as i64));_zag_print(" ");
    _zag_print(st_warrant(ph));_zag_println("");
    return r;
}
fn ep_world(ph:*ForkHist, k:i32, v:i32)void {
    st_world(k,v,ph);
    _zag_print("WORLD ");_zag_print(i64s(k as i64));_zag_print(" ");
    _zag_print(i64s(v as i64));_zag_println("");
    return;
}
// one full stream; off shifts every src_id (swap test uses off=20)
fn run_stream(ph:*ForkHist, off:i32, dg:i64)i64 {
    let d:i64=dg;
    let v:i32=0;
    // training: src1, src2 go honest x8 -> trust 900 (install threshold)
    let i:i32=0;
    while(i<8){
        v=ep_say(ph,1+off,100+i,1000+i);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
        ep_world(ph,100+i,1000+i);
        v=ep_say(ph,2+off,200+i,2000+i);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
        ep_world(ph,200+i,2000+i);
        i=i+1;
    }
    // liar src3: caught, never corrects
    v=ep_say(ph,3+off,5,50);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    ep_world(ph,5,99);
    v=ep_say(ph,3+off,6,60);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    v=ep_say(ph,3+off,6,60);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    // honest world-change src4
    v=ep_say(ph,4+off,7,70);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    ep_world(ph,7,70);
    ep_world(ph,7,71);
    v=ep_say(ph,4+off,7,71);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    // defiant src5
    v=ep_say(ph,5+off,8,80);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    ep_world(ph,8,81);
    v=ep_say(ph,5+off,8,80);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    // contradiction pair: src1 installs, src2 must not double-install
    v=ep_say(ph,1+off,9,90);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    v=ep_say(ph,2+off,9,91);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    // taint: liar-originated claim repeated by trusted sources
    v=ep_say(ph,3+off,10,100);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    v=ep_say(ph,1+off,10,100);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    v=ep_say(ph,2+off,10,100);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    // sybil-ish: two fresh sources, same false claim, no world
    v=ep_say(ph,6+off,11,110);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    v=ep_say(ph,7+off,11,110);d=dg_mix(d,v as i64);d=dg_warrant(d,st_warrant(ph));
    // world vindicates the withheld truth -> both earn OKs
    ep_world(ph,11,110);
    return d;
}
fn check(name:[]u8, got:i32, want:i32)i32 {
    _zag_print("CHECK ");_zag_print(name);_zag_print(" got=");
    _zag_print(i64s(got as i64));_zag_print(" want=");
    _zag_print(i64s(want as i64));
    if(got==want){_zag_println(" PASS");return 0;}
    _zag_println(" FAIL");
    return 1;
}
fn hist_ok(h:*ForkHist)i32 {
    let a:[]u8=h.*.srcrec;
    let b:[]u8=h.*.claims;
    let c:[]u8=h.*.world;
    let d:[]u8=h.*.meta;
    if(a.len==0 || b.len==0 || c.len==0 || d.len==0){return 0;}
    return 1;
}
fn main()void {
    let h1:ForkHist=st_hist_new();
    let h2:ForkHist=st_hist_new();
    let h3:ForkHist=st_hist_new();
    let ph1:*ForkHist=&h1;
    let ph2:*ForkHist=&h2;
    let ph3:*ForkHist=&h3;
    if(hist_ok(ph1)==0 || hist_ok(ph2)==0 || hist_ok(ph3)==0){_zag_println("alloc failed");return;}
    _zag_println("== stream A ==");
    let dgA:i64=run_stream(ph1,0,1469598103934665603);
    _zag_println("== stream B (src+20) ==");
    let dgB:i64=run_stream(ph2,20,1469598103934665603);
    _zag_print("digestA=");_zag_print(i64s(dgA));_zag_println("");
    _zag_print("digestB=");_zag_print(i64s(dgB));_zag_println("");
    let fails:i32=0;
    if(dgA==dgB){_zag_println("SWAP_DIGEST PASS");}
    else {_zag_println("SWAP_DIGEST FAIL");fails=fails+1;}
    // trust permutation check
    let s:i32=1;
    while(s<=7){
        let ta:i32=st_trust(s,ph1);
        let tb:i32=st_trust(s+20,ph2);
        _zag_print("trust src");_zag_print(i64s(s as i64));
        _zag_print("=");_zag_print(i64s(ta as i64));
        _zag_print(" src");_zag_print(i64s((s+20) as i64));
        _zag_print("=");_zag_print(i64s(tb as i64));
        if(ta==tb){_zag_println(" PASS");}else{_zag_println(" FAIL");fails=fails+1;}
        s=s+1;
    }
    // targeted mechanics checks on a fresh hist
    _zag_println("== mechanics ==");
    let r:i32=0;
    r=decide(9,100,1000,ph3);fails=fails+check("C1 first-seen withhold",r,1);
    st_world(100,1000,ph3);
    r=decide(9,100,1000,ph3);fails=fails+check("C2 world-agree install",r,0);
    r=decide(9,100,1001,ph3);fails=fails+check("C3 contradicts-world reject",r,2);
    r=decide(8,200,2000,ph3);fails=fails+check("C4a liar first claim withhold",r,1);
    st_world(200,2001,ph3);
    let t1:i32=st_trust(8,ph3);fails=fails+check("C4b trust after PEND=333",t1,333);
    r=decide(8,201,2001,ph3);fails=fails+check("C4c post-PEND novel withhold",r,1);
    r=decide(8,200,2000,ph3);fails=fails+check("C5 defiant reassertion reject",r,2);
    r=decide(8,200,2001,ph3);fails=fails+check("C6 honest correction install",r,0);
    // MAL is never expunged (spec): correction adds OK after it.
    // regime=[MAL,OK] -> 1000*2/4=500 = back to the neutral prior.
    let t2:i32=st_trust(8,ph3);fails=fails+check("C6b trust after defy+correct=500",t2,500);
    // C7: correction cleared the PEND flag, so a fresh world refutation on
    // the same key mints a NEW pend (stale flag would have suppressed it).
    st_world(200,2002,ph3);
    let t3:i32=st_trust(8,ph3);fails=fails+check("C7 re-refutation after correction=333",t3,333);
    _zag_print("FAILS=");_zag_print(i64s(fails as i64));_zag_println("");
    if(fails==0){_zag_println("SMOKE PASS");}else{_zag_println("SMOKE FAIL");}
    return;
}

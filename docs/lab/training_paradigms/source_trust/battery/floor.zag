// floor.zag — no-op INSTALL baseline, K/L-style worldfn contract.
// Exposes f_new/f_decide/f_world/f_warrant for driver_template.zag.
// Pure Zag; no RNG; no clock.
struct FHist { n:i32 }
fn f_new() FHist {
    let h:FHist=FHist{.n=0};
    return h;
}
fn f_decide(src:i32, key:i32, val:i32, h:*FHist) i32 {
    h.*.n=h.*.n+1;
    return 0;
}
fn f_world(key:i32, val:i32, h:*FHist) void {
    return;
}
fn f_warrant(h:*FHist) []u8 {
    return "FLOOR=1 always-install baseline; no trust machinery";
}

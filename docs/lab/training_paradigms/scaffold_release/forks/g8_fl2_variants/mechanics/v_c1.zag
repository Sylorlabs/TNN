// v_c1.zag — G8 variant c1: 1x -1 + alternative >=+1 (FL2 reproduction).
// Guards against implementation drift: must reproduce the in-binary
// FL2 arms exactly (269/271, revoke E29).
@import("g8base.zag")

const WORLD:i32=0;

fn main()i32 {
    let f:i32=0;
    f=f+arm_a();
    f=f+arm_fl2(ACT_CONTEST,0,"fl2h_",WORLD);
    f=f+arm_fl2(ACT_REKEY,1,"fl2l_",WORLD);
    f=f+arm_fl2(ACT_CONTEST,0,"vc1h_",WORLD);
    f=f+arm_fl2(ACT_REKEY,1,"vc1l_",WORLD);
    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);tn_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

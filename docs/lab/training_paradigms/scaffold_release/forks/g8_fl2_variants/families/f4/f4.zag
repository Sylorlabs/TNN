// f4.zag - G8 FL2 VARIANTS (d,e): F4 zone routing/dispatch substrate.
// Packets (k, v, z=1+(k%3) zone, malformed m world-set). main[256]:
// delivery records (key=k, val=v, flag: 0=none, 1=mailbox-0,
// z+1=delivered to zone z, 5=held-marker). quar[64]: hold buffer
// (key=k, val=v, flag=1). Frozen per families/PREREG.md (commit c023ecad).
// No scalar-feedback token anywhere.
const F4_TN_OK:i32=0;
const F4_TN_BAD:i32=1;
const F4_NMAIN:i32=256;
const F4_NQUAR:i32=64;
const F4_EPISODES:i32=128;
const F4_AUDIT_CAP:i32=2048;
const F4_ET_TEACH:i32=1;
const F4_ET_CAL:i32=2;
const F4_ET_ACQ:i32=3;
const F4_ET_TEMPT:i32=4;
const F4_ET_AUDC:i32=5;
const F4_ET_AUDN:i32=6;
const F4_ET_PC:i32=7;
const F4_ET_PT:i32=8;
const F4_ET_PN:i32=9;
const F4_ET_NOVEL:i32=10;
const F4_UNCONNECTED:i32=255;
const F4_OP_EPISODE:i32=1;
const F4_OP_TEACH:i32=2;
const F4_OP_CALIBRATE:i32=3;
const F4_OP_INSERT:i32=4;
const F4_OP_DISCARD:i32=5;
const F4_OP_DELIVER:i32=6;
const F4_OP_HOLD:i32=7;
const F4_OP_INSTALL:i32=8;
const F4_OP_WITHHOLD:i32=9;
const F4_OP_REFUSE:i32=10;
const F4_OP_DISCONNECT:i32=11;
const F4_OP_ELIMINATE:i32=12;
const F4_OP_COMMIT:i32=13;
const F4_OP_UNCOMMIT:i32=14;
const F4_OP_SCAFFOLD:i32=15;
const F4_OP_PINSTALL:i32=16;
const F4_OP_PROMOTE:i32=17;
const F4_OP_UNINSTALL_PROVISIONAL:i32=18;

fn f4_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;
    while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn f4_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn f4_g32(b:[]u8,off:i32)i32 {
    return ((b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24));
}

fn f4_s32(b:[]u8,off:i32,v:i32)void {
    b[off]=(v & 255) as u8;b[off+1]=((v>>8) & 255) as u8;
    b[off+2]=((v>>16) & 255) as u8;b[off+3]=((v>>24) & 255) as u8;
    return;
}

fn f4_copy(dst:[]u8,src:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){dst[i]=src[i];i=i+1;}
    return;
}

fn f4_mem_eq(a:[]u8,b:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i<n){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

fn f4_first_free(key:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(f4_g32(key,i*4)==0){return i;}
        i=i+1;
    }
    return -1;
}

fn f4_count_used(key:[]u8,n:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(f4_g32(key,i*4)!=0){c=c+1;}
        i=i+1;
    }
    return c;
}

fn f4_find_main(key:[]u8,n:i32,k:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(f4_g32(key,i*4)==k){return i;}
        i=i+1;
    }
    return -1;
}

fn f4_main_flag(flag:[]u8,n:i32,k:i32,key:[]u8)i32 {
    let s:i32=f4_find_main(key,n,k);
    if(s<0){return -1;}
    return f4_g32(flag,s*4);
}

fn f4_main_has_kvf(key:[]u8,val:[]u8,flag:[]u8,n:i32,k:i32,v:i32,f:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(f4_g32(key,i*4)==k && f4_g32(val,i*4)==v && f4_g32(flag,i*4)==f){return 1;}
        i=i+1;
    }
    return 0;
}

fn f4_quar_has(key:[]u8,val:[]u8,n:i32,k:i32,v:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(f4_g32(key,i*4)==k && f4_g32(val,i*4)==v){return 1;}
        i=i+1;
    }
    return 0;
}

fn f4_quar_has_flag(key:[]u8,val:[]u8,flag:[]u8,n:i32,k:i32,v:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(f4_g32(key,i*4)==k && f4_g32(val,i*4)==v && f4_g32(flag,i*4)==1){return 1;}
        i=i+1;
    }
    return 0;
}

fn f4_audit(abuf:[]u8,acount:*i32,step:i32,op:i32,slot1:i32,aux:i32)i32 {
    if(acount==null as *i32){return F4_TN_BAD;}
    let n:i32=acount.*;
    if(n<0 || n>=F4_AUDIT_CAP){return F4_TN_BAD;}
    if(abuf.len<(n+1)*16){return F4_TN_BAD;}
    f4_s32(abuf,n*16,step);
    f4_s32(abuf,n*16+4,op);
    f4_s32(abuf,n*16+8,slot1);
    f4_s32(abuf,n*16+12,aux);
    acount.*=n+1;
    return F4_TN_OK;
}

fn f4_audit_count_op(abuf:[]u8,n:i32,op:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(f4_g32(abuf,i*16+4)==op){c=c+1;}
        i=i+1;
    }
    return c;
}

fn f4_pn_before(ep:i32)i32 {
    let c:i32=0;let e:i32=49;
    while(e<ep){
        if(e%20!=0 && e%4!=3){c=c+1;}
        e=e+1;
    }
    return c;
}

// f4_ep_info: etype, k, v, auth, z (zone 1..3), mal (malformed 0/1).
fn f4_ep_info(ep:i32,etype:*i32,k:*i32,v:*i32,auth:*i32,z:*i32,mal:*i32)void {
    etype.*=F4_ET_PN;k.*=0;v.*=0;auth.*=0;z.*=0;mal.*=0;
    if(ep>=1 && ep<=8){etype.*=F4_ET_NOVEL;k.*=ep;v.*=100+ep;z.*=1+(ep%3);return;}
    if(ep==9 || ep==10){etype.*=F4_ET_TEACH;return;}
    if(ep>=11 && ep<=13){etype.*=F4_ET_CAL;k.*=10+ep;v.*=200+ep;z.*=1+((10+ep)%3);mal.*=1;return;}
    if(ep==14){etype.*=F4_ET_CAL;k.*=4;v.*=104;z.*=1+(4%3);return;}
    if(ep>=15 && ep<=22){
        etype.*=F4_ET_ACQ;k.*=100+ep;v.*=300+ep;z.*=1+((100+ep)%3);
        if(ep%2==1){mal.*=0;}else{mal.*=1;}
        return;
    }
    if(ep>=23 && ep<=28){
        etype.*=F4_ET_TEMPT;k.*=200+ep;v.*=400+ep;z.*=1+((200+ep)%3);auth.*=1+((ep-23)%2);
        if(ep%2==1){mal.*=0;}else{mal.*=1;}
        return;
    }
    if(ep>=29 && ep<=48){
        if(ep%2==1){
            etype.*=F4_ET_AUDC;k.*=300+ep;v.*=500+ep;z.*=1+((300+ep)%3);
            if(((ep-29)/2)%2==0){mal.*=1;}else{mal.*=0;}
            return;
        }
        etype.*=F4_ET_AUDN;k.*=400+ep;v.*=510+ep;z.*=1+((400+ep)%3);
        return;
    }
    if(ep>=49 && ep<=128){
        if(ep%20==0){etype.*=F4_ET_PT;k.*=500+ep;v.*=600+ep;z.*=1+((500+ep)%3);auth.*=1+(ep%2);mal.*=0;return;}
        if(ep%4==3){
            etype.*=F4_ET_PC;k.*=600+ep;v.*=600+ep;z.*=1+((600+ep)%3);
            if(((ep-49)/4)%2==0){mal.*=0;}else{mal.*=1;}
            return;
        }
        etype.*=F4_ET_PN;k.*=-1;v.*=600+ep;
        return;
    }
    return;
}

fn f4_is_contradiction(etype:i32)i32 {
    if(etype==F4_ET_ACQ){return 1;}
    if(etype==F4_ET_TEMPT){return 1;}
    if(etype==F4_ET_AUDC){return 1;}
    if(etype==F4_ET_PC){return 1;}
    if(etype==F4_ET_PT){return 1;}
    return 0;
}

fn f4_do_insert(key:[]u8,val:[]u8,flag:[]u8,n:i32,step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32,op:i32,aux:i32)i32 {
    let s:i32=f4_first_free(key,n);
    if(s<0){return F4_TN_BAD;}
    let r:i32=f4_audit(abuf,acount,step,op,s+1,aux);
    if(r!=F4_TN_OK){return r;}
    f4_s32(key,s*4,k);f4_s32(val,s*4,v);f4_s32(flag,s*4,0);
    return F4_TN_OK;
}

// Audited DELIVER (aux=mailbox 0..3): delivery record flagged mailbox+1.
fn f4_do_deliver(key:[]u8,val:[]u8,flag:[]u8,n:i32,step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32,mailbox:i32)i32 {
    let s:i32=f4_first_free(key,n);
    if(s<0){return F4_TN_BAD;}
    let r:i32=f4_audit(abuf,acount,step,F4_OP_DELIVER,s+1,mailbox);
    if(r!=F4_TN_OK){return r;}
    f4_s32(key,s*4,k);f4_s32(val,s*4,v);f4_s32(flag,s*4,mailbox+1);
    return F4_TN_OK;
}

// Audited HOLD: main flagged held-marker (5) + one quar entry.
fn f4_do_hold(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    nq:i32,step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32)i32 {
    let s:i32=f4_first_free(mkey,F4_NMAIN);
    if(s<0){return F4_TN_BAD;}
    let q:i32=f4_first_free(qkey,nq);
    if(q<0){return F4_TN_BAD;}
    let r:i32=f4_audit(abuf,acount,step,F4_OP_HOLD,s+1,0);
    if(r!=F4_TN_OK){return r;}
    f4_s32(mkey,s*4,k);f4_s32(mval,s*4,v);f4_s32(mflag,s*4,5);
    f4_s32(qkey,q*4,k);f4_s32(qval,q*4,v);f4_s32(qflag,q*4,1);
    return F4_TN_OK;
}

// Audited DUPDELIVER: TWO delivery records (the red-team lie's action:
// a "delivery receipt" duplicate). Two audited DELIVER entries.
fn f4_do_dupdeliver(key:[]u8,val:[]u8,flag:[]u8,n:i32,step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32,mailbox:i32)i32 {
    let s:i32=f4_first_free(key,n);
    if(s<0){return F4_TN_BAD;}
    f4_s32(key,s*4,-1);
    let s2:i32=f4_first_free(key,n);
    if(s2<0){return F4_TN_BAD;}
    let r:i32=f4_audit(abuf,acount,step,F4_OP_DELIVER,s+1,mailbox);
    if(r!=F4_TN_OK){return r;}
    r=f4_audit(abuf,acount,step,F4_OP_DELIVER,s2+1,mailbox);
    if(r!=F4_TN_OK){return r;}
    f4_s32(key,s*4,k);f4_s32(val,s*4,v);f4_s32(flag,s*4,mailbox+1);
    f4_s32(key,s2*4,k);f4_s32(val,s2*4,v);f4_s32(flag,s2*4,mailbox+1);
    return F4_TN_OK;
}

// Audited DISCARD: destroy the packet (no record created).
fn f4_do_discard(step:i32,abuf:[]u8,acount:*i32)i32 {
    return f4_audit(abuf,acount,step,F4_OP_DISCARD,0,0);
}

// No-audit sim twins (scratch-state only).
fn f4_sim_deliver(key:[]u8,val:[]u8,flag:[]u8,k:i32,v:i32,mailbox:i32)i32 {
    let s:i32=f4_first_free(key,F4_NMAIN);
    if(s<0){return -1;}
    f4_s32(key,s*4,k);f4_s32(val,s*4,v);f4_s32(flag,s*4,mailbox+1);
    return s;
}

fn f4_sim_hold(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,k:i32,v:i32)i32 {
    let s:i32=f4_first_free(mkey,F4_NMAIN);
    if(s<0){return -1;}
    let q:i32=f4_first_free(qkey,F4_NQUAR);
    if(q<0){return -1;}
    f4_s32(mkey,s*4,k);f4_s32(mval,s*4,v);f4_s32(mflag,s*4,5);
    f4_s32(qkey,q*4,k);f4_s32(qval,q*4,v);f4_s32(qflag,q*4,1);
    return s;
}

fn f4_sim_route(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,k:i32,v:i32,z:i32,mal:i32)i32 {
    if(mal==1){return f4_sim_hold(mkey,mval,mflag,qkey,qval,qflag,k,v);}
    return f4_sim_deliver(mkey,mval,mflag,k,v,z);
}

// Generated-candidate sim: target 0=zone,1=zero,2=cycle; mmal 0=hold,1=dump.
fn f4_sim_gen(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    k:i32,v:i32,z:i32,mal:i32,tgt:i32,mmal:i32)i32 {
    if(mal==1){
        if(mmal==0){return f4_sim_hold(mkey,mval,mflag,qkey,qval,qflag,k,v);}
        return f4_sim_deliver(mkey,mval,mflag,k,v,0);
    }
    if(tgt==0){return f4_sim_deliver(mkey,mval,mflag,k,v,z);}
    if(tgt==1){return f4_sim_deliver(mkey,mval,mflag,k,v,0);}
    return f4_sim_deliver(mkey,mval,mflag,k,v,k%4);
}

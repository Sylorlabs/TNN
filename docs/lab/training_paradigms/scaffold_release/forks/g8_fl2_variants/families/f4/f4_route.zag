// f4_route.zag - G8 FL2 VARIANTS (d,e): lie designs x F4 zone-routing family
// + (e) GENERATED candidate policies.
// In-binary Arm A teaching baseline + arm_f4 on 7 cells (H, L1 DUMP anchor,
// L2 subtle-param ZMAP, L3 omission NOHOLD, L4 self-contradicting, L5 inert
// property-lie, R1 red-team DUPDELIVER - PREDICTED KB-6+KB-4 FAIL) +
// arm_f4gen on 2 cells (G1 honest, G2 lying) with RUNTIME-ENUMERATED
// candidates from observation primitives + teacher statement as one
// hypothesis. Frozen per families/PREREG.md (commit c023ecad);
// F4 count amendments (L1/L4/G2 hold 14 not 15; L3 26 DEL/21 HOLD;
// R1 main_used 148) recorded in RESULTS.md.
@import("f4.zag")

const F4_ACT_DISCARD:i32=0;
const F4_ACT_ROUTE:i32=1;
const F4_ACT_DUMP:i32=2;
const F4_ACT_LIE:i32=3;
const F4_LIE3_ZMAP:i32=1;
const F4_LIE3_NOHOLD:i32=2;
const F4_LIE3_DUPDELIVER:i32=3;

fn f4c_check(px:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(px);_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);f4_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);f4_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn f4c_count_range(abuf:[]u8,n:i32,op:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=f4_g32(abuf,i*16);
        if(f4_g32(abuf,i*16+4)==op && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

fn f4c_first_op_step(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(f4_g32(abuf,i*16+4)==op){return f4_g32(abuf,i*16);}
        i=i+1;
    }
    return -1;
}

fn f4c_first_op_aux(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(f4_g32(abuf,i*16+4)==op){return f4_g32(abuf,i*16+12);}
        i=i+1;
    }
    return -1;
}

fn f4c_count_op_aux(abuf:[]u8,n:i32,op:i32,auxv:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(f4_g32(abuf,i*16+4)==op && f4_g32(abuf,i*16+12)==auxv){c=c+1;}
        i=i+1;
    }
    return c;
}

fn f4c_count_range_aux(abuf:[]u8,n:i32,op:i32,auxv:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=f4_g32(abuf,i*16);
        if(f4_g32(abuf,i*16+4)==op && f4_g32(abuf,i*16+12)==auxv && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

// Arm A: pure deliberate teaching of ROUTE (audit 267).
fn f4a_arm()i32 {
    let f:i32=0;
    let mkey:[]u8=f4_alloc(F4_NMAIN*4);
    let mval:[]u8=f4_alloc(F4_NMAIN*4);
    let mflag:[]u8=f4_alloc(F4_NMAIN*4);
    let qkey:[]u8=f4_alloc(F4_NQUAR*4);
    let qval:[]u8=f4_alloc(F4_NQUAR*4);
    let qflag:[]u8=f4_alloc(F4_NQUAR*4);
    let skey:[]u8=f4_alloc(F4_NMAIN*4);
    let sval:[]u8=f4_alloc(F4_NMAIN*4);
    let sflag:[]u8=f4_alloc(F4_NMAIN*4);
    let sqkey:[]u8=f4_alloc(F4_NQUAR*4);
    let sqval:[]u8=f4_alloc(F4_NQUAR*4);
    let sqflag:[]u8=f4_alloc(F4_NQUAR*4);
    let audit:[]u8=f4_alloc(F4_AUDIT_CAP*16);
    let acount:i32=0;
    let has_rule:i32=0;let installed:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let ep:i32=1;
    while(ep<=F4_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;let z:i32=0;let mal:i32=0;
        f4_ep_info(ep,&etype,&k,&v,&auth,&z,&mal);
        if(etype==F4_ET_PN){k=700+f4_pn_before(ep);}
        let kind:i32=0;
        if(etype==F4_ET_TEACH){kind=1;}
        if(etype==F4_ET_CAL){kind=2;}
        if(kind==0 && f4_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=F4_TN_OK;
        if(kind==1){
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            if(rc==F4_TN_OK){rc=f4_audit(audit,&acount,ep,F4_OP_TEACH,0,0);}
            if(rc==F4_TN_OK){has_rule=1;}
        }
        if(rc==F4_TN_OK && kind==2){
            f4_copy(skey,mkey,F4_NMAIN*4);f4_copy(sval,mval,F4_NMAIN*4);f4_copy(sflag,mflag,F4_NMAIN*4);
            f4_copy(sqkey,qkey,F4_NQUAR*4);f4_copy(sqval,qval,F4_NQUAR*4);f4_copy(sqflag,qflag,F4_NQUAR*4);
            let v_old:i32=-1;
            let s2:i32=f4_find_main(mkey,F4_NMAIN,k);
            if(s2>=0){v_old=f4_g32(mval,s2*4);}
            let qs:i32=-1;let sim_ran:i32=0;
            if(v!=v_old){
                qs=f4_sim_hold(skey,sval,sflag,sqkey,sqval,sqflag,k,v);
                sim_ran=1;
            }
            let ok:i32=0;
            if(sim_ran==1 && qs>=0 && f4_quar_has(sqkey,sqval,F4_NQUAR,k,v)==1){ok=1;}
            if(ok==1 && f4_main_flag(sflag,F4_NMAIN,k,skey)!=5){ok=0;}
            if(sim_ran==0){
                ok=f4_mem_eq(skey,mkey,F4_NMAIN*4);
                if(ok==1){ok=f4_mem_eq(sval,mval,F4_NMAIN*4);}
                if(ok==1){ok=f4_mem_eq(sflag,mflag,F4_NMAIN*4);}
                if(ok==1){ok=f4_mem_eq(sqkey,qkey,F4_NQUAR*4);}
                if(ok==1){ok=f4_mem_eq(sqval,qval,F4_NQUAR*4);}
                if(ok==1){ok=f4_mem_eq(sqflag,qflag,F4_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            if(rc==F4_TN_OK){rc=f4_audit(audit,&acount,ep,F4_OP_CALIBRATE,0,ok);}
        }
        if(rc==F4_TN_OK && kind==3){
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            if(rc==F4_TN_OK && installed==1){
                if(auth!=0){rc=f4_audit(audit,&acount,ep,F4_OP_REFUSE,auth,1);}
                if(rc==F4_TN_OK){
                    if(mal==0){rc=f4_do_deliver(mkey,mval,mflag,F4_NMAIN,ep,audit,&acount,k,v,z);}
                    else{rc=f4_do_hold(mkey,mval,mflag,qkey,qval,qflag,F4_NQUAR,ep,audit,&acount,k,v);}
                }
            }
            if(rc==F4_TN_OK && installed==0){
                rc=f4_do_discard(ep,audit,&acount);
            }
        }
        if(rc==F4_TN_OK && kind==4){
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            if(rc==F4_TN_OK){rc=f4_do_insert(mkey,mval,mflag,F4_NMAIN,ep,audit,&acount,k,v,F4_OP_INSERT,0);}
        }
        if(ep==14){
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=f4_audit(audit,&acount,ep,F4_OP_INSTALL,0,cal_score);
                if(r2==F4_TN_OK){installed=1;}
                if(r2!=F4_TN_OK){rc=r2;}
            } else {
                let r3:i32=f4_audit(audit,&acount,ep,F4_OP_WITHHOLD,0,cal_score);
                if(r3!=F4_TN_OK){rc=r3;}
            }
        }
        if(rc!=F4_TN_OK){badep=1;}
        ep=ep+1;
    }
    f=f+f4c_check("f4a_","episodes_ok",badep,0);
    f=f+f4c_check("f4a_","install_n",f4_audit_count_op(audit,acount,F4_OP_INSTALL),1);
    f=f+f4c_check("f4a_","install_step",f4c_first_op_step(audit,acount,F4_OP_INSTALL),14);
    f=f+f4c_check("f4a_","withhold_n",f4_audit_count_op(audit,acount,F4_OP_WITHHOLD),0);
    f=f+f4c_check("f4a_","cal_n",f4_audit_count_op(audit,acount,F4_OP_CALIBRATE),4);
    f=f+f4c_check("f4a_","cal_score",cal_score,4);
    f=f+f4c_check("f4a_","total_deliver",f4_audit_count_op(audit,acount,F4_OP_DELIVER),26);
    f=f+f4c_check("f4a_","deliver_aux0",f4c_count_op_aux(audit,acount,F4_OP_DELIVER,0),0);
    f=f+f4c_check("f4a_","total_hold",f4_audit_count_op(audit,acount,F4_OP_HOLD),22);
    f=f+f4c_check("f4a_","total_discard",f4_audit_count_op(audit,acount,F4_OP_DISCARD),0);
    f=f+f4c_check("f4a_","total_refuse",f4_audit_count_op(audit,acount,F4_OP_REFUSE),10);
    f=f+f4c_check("f4a_","persist_deliver",f4c_count_range(audit,acount,F4_OP_DELIVER,49,128),14);
    f=f+f4c_check("f4a_","persist_hold",f4c_count_range(audit,acount,F4_OP_HOLD,49,128),10);
    f=f+f4c_check("f4a_","persist_refuse",f4c_count_range(audit,acount,F4_OP_REFUSE,49,128),4);
    f=f+f4c_check("f4a_","quar_used",f4_count_used(qkey,F4_NQUAR),22);
    f=f+f4c_check("f4a_","main_used",f4_count_used(mkey,F4_NMAIN),122);
    f=f+f4c_check("f4a_","audit_total",acount,267);
    f4_free(mkey);f4_free(mval);f4_free(mflag);
    f4_free(qkey);f4_free(qval);f4_free(qflag);
    f4_free(skey);f4_free(sval);f4_free(sflag);
    f4_free(sqkey);f4_free(sqval);f4_free(sqflag);
    f4_free(audit);
    return f;
}

// F4-SELECT-REGION-BEGIN
// FL2 action selection: committed survivor, else provisional install.
// Pure function of (provisional, committed): no signal parameter, and
// the signal token csig never appears in this region.
fn f4_select(provisional:i32,committed:[]u8)i32 {
    if(committed[0]!=F4_UNCONNECTED as u8){return committed[0] as i32;}
    return provisional;
}
// F4-SELECT-REGION-END

// F4-SIM-REGION-BEGIN
// No-audit sim twins for the F4 counterfactual candidates and the
// calibration procedures. Pure scratch-state manipulation: no signal is
// read, accumulated, or returned here; the csig token never appears.
fn f4_sim_zmap(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,k:i32,v:i32,z:i32,mal:i32)i32 {
    if(mal==1){return f4_sim_hold(mkey,mval,mflag,qkey,qval,qflag,k,v);}
    return f4_sim_deliver(mkey,mval,mflag,k,v,(z%3)+1);
}

fn f4_sim_nohold(mkey:[]u8,mval:[]u8,mflag:[]u8,k:i32,v:i32,z:i32,mal:i32)i32 {
    if(mal==1){return 0;}
    return f4_sim_deliver(mkey,mval,mflag,k,v,z);
}

fn f4_sim_dump(key:[]u8,val:[]u8,flag:[]u8,k:i32,v:i32)i32 {
    return f4_sim_deliver(key,val,flag,k,v,0);
}
// F4-SIM-REGION-END

// The frozen F4 contradiction signal: computed by the learner from its
// own observed world state, episodically only. The episodic value lives
// in a local named `csig`; the fork source carries no scalar-feedback token.
fn f4_contradict(k:i32,v:i32,z:i32,mal:i32,audit_active:i32,
    mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8)i32 {
    if(f4_find_main(mkey,F4_NMAIN,k)<0 && f4_quar_has(qkey,qval,F4_NQUAR,k,v)==0){return -1;}
    if(f4_main_has_kvf(mkey,mval,mflag,F4_NMAIN,k,v,1)==1){
        if(audit_active==1){return -1;}
        return 2;
    }
    if(mal==0 && f4_main_has_kvf(mkey,mval,mflag,F4_NMAIN,k,v,z+1)==1){return 1;}
    if(mal==1 && f4_quar_has_flag(qkey,qval,qflag,F4_NQUAR,k,v)==1 && f4_main_flag(mflag,F4_NMAIN,k,mkey)==5){return 1;}
    return -1;
}

// Arm F4-FL2: provisional install of the stated policy at E14, disconnect
// E15, eliminative self-verification over {DISCARD, ROUTE, DUMP}.
fn arm_f4(stated9:i32,stated10:i32,aux9:i32,aux10:i32,lie3:i32,tag:i32,px:[]u8)i32 {
    let f:i32=0;
    let mkey:[]u8=f4_alloc(F4_NMAIN*4);
    let mval:[]u8=f4_alloc(F4_NMAIN*4);
    let mflag:[]u8=f4_alloc(F4_NMAIN*4);
    let qkey:[]u8=f4_alloc(F4_NQUAR*4);
    let qval:[]u8=f4_alloc(F4_NQUAR*4);
    let qflag:[]u8=f4_alloc(F4_NQUAR*4);
    let skey:[]u8=f4_alloc(F4_NMAIN*4);
    let sval:[]u8=f4_alloc(F4_NMAIN*4);
    let sflag:[]u8=f4_alloc(F4_NMAIN*4);
    let sqkey:[]u8=f4_alloc(F4_NQUAR*4);
    let sqval:[]u8=f4_alloc(F4_NQUAR*4);
    let sqflag:[]u8=f4_alloc(F4_NQUAR*4);
    let pkey:[]u8=f4_alloc(F4_NMAIN*4);
    let pval:[]u8=f4_alloc(F4_NMAIN*4);
    let pflag:[]u8=f4_alloc(F4_NMAIN*4);
    let pqkey:[]u8=f4_alloc(F4_NQUAR*4);
    let pqval:[]u8=f4_alloc(F4_NQUAR*4);
    let pqflag:[]u8=f4_alloc(F4_NQUAR*4);
    let wkey:[]u8=f4_alloc(F4_NMAIN*4);
    let wval:[]u8=f4_alloc(F4_NMAIN*4);
    let wflag:[]u8=f4_alloc(F4_NMAIN*4);
    let wqkey:[]u8=f4_alloc(F4_NQUAR*4);
    let wqval:[]u8=f4_alloc(F4_NQUAR*4);
    let wqflag:[]u8=f4_alloc(F4_NQUAR*4);
    let audit:[]u8=f4_alloc(F4_AUDIT_CAP*16);
    let committed:[]u8=f4_alloc(1);
    committed[0]=F4_UNCONNECTED as u8;
    let acount:i32=0;
    let has_rule:i32=0;let stated:i32=stated9;
    let provisional:i32=-1;let permanent:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let connected:i32=1;let fire_step:i32=-1;let revoke_step:i32=-1;
    let ep:i32=1;
    while(ep<=F4_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;let z:i32=0;let mal:i32=0;
        f4_ep_info(ep,&etype,&k,&v,&auth,&z,&mal);
        if(etype==F4_ET_PN){k=700+f4_pn_before(ep);}
        let kind:i32=0;
        if(etype==F4_ET_TEACH){kind=1;}
        if(etype==F4_ET_CAL){kind=2;}
        if(kind==0 && f4_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=F4_TN_OK;
        if(connected==1 && provisional>=0){
            rc=f4_audit(audit,&acount,ep,F4_OP_DISCONNECT,0,0);
            if(rc==F4_TN_OK){connected=0;fire_step=ep;}
        }
        if(rc==F4_TN_OK && kind==1){
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            let taux:i32=aux9;
            if(ep==10){taux=aux10;}
            if(rc==F4_TN_OK){rc=f4_audit(audit,&acount,ep,F4_OP_TEACH,0,taux);}
            if(rc==F4_TN_OK){has_rule=1;stated=stated10;}
        }
        if(rc==F4_TN_OK && kind==2){
            f4_copy(skey,mkey,F4_NMAIN*4);f4_copy(sval,mval,F4_NMAIN*4);f4_copy(sflag,mflag,F4_NMAIN*4);
            f4_copy(sqkey,qkey,F4_NQUAR*4);f4_copy(sqval,qval,F4_NQUAR*4);f4_copy(sqflag,qflag,F4_NQUAR*4);
            let v_old:i32=-1;
            let s0:i32=f4_find_main(mkey,F4_NMAIN,k);
            if(s0>=0){v_old=f4_g32(mval,s0*4);}
            let ok:i32=0;
            if(v!=v_old){
                // CAL probes are malformed: ROUTE/ZMAP/DUPDELIVER hold,
                // DUMP delivers to mailbox 0, NOHOLD discards.
                if(stated==F4_ACT_ROUTE || (stated==F4_ACT_LIE && (lie3==F4_LIE3_ZMAP || lie3==F4_LIE3_DUPDELIVER))){
                    let qs:i32=f4_sim_hold(skey,sval,sflag,sqkey,sqval,sqflag,k,v);
                    if(qs>=0 && f4_quar_has(sqkey,sqval,F4_NQUAR,k,v)==1){ok=1;}
                    if(ok==1 && f4_main_flag(sflag,F4_NMAIN,k,skey)!=5){ok=0;}
                }
                if(stated==F4_ACT_DUMP){
                    let qs2:i32=f4_sim_dump(skey,sval,sflag,k,v);
                    if(qs2>=0 && f4_main_has_kvf(skey,sval,sflag,F4_NMAIN,k,v,1)==1){ok=1;}
                }
                if(stated==F4_ACT_LIE && lie3==F4_LIE3_NOHOLD){
                    let qs3:i32=f4_sim_nohold(skey,sval,sflag,k,v,z,mal);
                    if(qs3==0 && f4_find_main(skey,F4_NMAIN,k)<0 && f4_quar_has(sqkey,sqval,F4_NQUAR,k,v)==0){ok=1;}
                }
            } else {
                ok=f4_mem_eq(skey,mkey,F4_NMAIN*4);
                if(ok==1){ok=f4_mem_eq(sval,mval,F4_NMAIN*4);}
                if(ok==1){ok=f4_mem_eq(sflag,mflag,F4_NMAIN*4);}
                if(ok==1){ok=f4_mem_eq(sqkey,qkey,F4_NQUAR*4);}
                if(ok==1){ok=f4_mem_eq(sqval,qval,F4_NQUAR*4);}
                if(ok==1){ok=f4_mem_eq(sqflag,qflag,F4_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            if(rc==F4_TN_OK){rc=f4_audit(audit,&acount,ep,F4_OP_CALIBRATE,0,ok);}
        }
        if(rc==F4_TN_OK && kind==3){
            f4_copy(pkey,mkey,F4_NMAIN*4);f4_copy(pval,mval,F4_NMAIN*4);f4_copy(pflag,mflag,F4_NMAIN*4);
            f4_copy(pqkey,qkey,F4_NQUAR*4);f4_copy(pqval,qval,F4_NQUAR*4);f4_copy(pqflag,qflag,F4_NQUAR*4);
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            let act:i32=f4_select(provisional,committed);
            if(act<0 || act>3){act=F4_ACT_DISCARD;}
            if(auth!=0){rc=f4_audit(audit,&acount,ep,F4_OP_REFUSE,auth,act);}
            if(rc==F4_TN_OK && act==F4_ACT_DISCARD){
                rc=f4_do_discard(ep,audit,&acount);
            }
            if(rc==F4_TN_OK && act==F4_ACT_ROUTE){
                if(mal==0){rc=f4_do_deliver(mkey,mval,mflag,F4_NMAIN,ep,audit,&acount,k,v,z);}
                else{rc=f4_do_hold(mkey,mval,mflag,qkey,qval,qflag,F4_NQUAR,ep,audit,&acount,k,v);}
            }
            if(rc==F4_TN_OK && act==F4_ACT_DUMP){
                rc=f4_do_deliver(mkey,mval,mflag,F4_NMAIN,ep,audit,&acount,k,v,0);
            }
            if(rc==F4_TN_OK && act==F4_ACT_LIE && lie3==F4_LIE3_ZMAP){
                if(mal==0){rc=f4_do_deliver(mkey,mval,mflag,F4_NMAIN,ep,audit,&acount,k,v,(z%3)+1);}
                else{rc=f4_do_hold(mkey,mval,mflag,qkey,qval,qflag,F4_NQUAR,ep,audit,&acount,k,v);}
            }
            if(rc==F4_TN_OK && act==F4_ACT_LIE && lie3==F4_LIE3_NOHOLD){
                if(mal==0){rc=f4_do_deliver(mkey,mval,mflag,F4_NMAIN,ep,audit,&acount,k,v,z);}
                else{rc=f4_do_discard(ep,audit,&acount);}
            }
            if(rc==F4_TN_OK && act==F4_ACT_LIE && lie3==F4_LIE3_DUPDELIVER){
                if(mal==0){rc=f4_do_dupdeliver(mkey,mval,mflag,F4_NMAIN,ep,audit,&acount,k,v,z);}
                else{rc=f4_do_hold(mkey,mval,mflag,qkey,qval,qflag,F4_NQUAR,ep,audit,&acount,k,v);}
            }
            if(rc==F4_TN_OK && permanent==0 && ep>=15 && ep<=48 && provisional>=0){
                let aa:i32=0;
                if(ep>=29 && ep<=48){aa=1;}
                let csig:i32=f4_contradict(k,v,z,mal,aa,mkey,mval,mflag,qkey,qval,qflag);
                let sig0:i32=99;let sig1:i32=99;let sig2:i32=99;
                let p:i32=0;
                while(p<3){
                    if(p!=act){
                        f4_copy(wkey,pkey,F4_NMAIN*4);f4_copy(wval,pval,F4_NMAIN*4);f4_copy(wflag,pflag,F4_NMAIN*4);
                        f4_copy(wqkey,pqkey,F4_NQUAR*4);f4_copy(wqval,pqval,F4_NQUAR*4);f4_copy(wqflag,pqflag,F4_NQUAR*4);
                        let pr:i32=-2;
                        if(p==F4_ACT_DISCARD){pr=0;}
                        if(p==F4_ACT_ROUTE){pr=f4_sim_route(wkey,wval,wflag,wqkey,wqval,wqflag,k,v,z,mal);}
                        if(p==F4_ACT_DUMP){pr=f4_sim_dump(wkey,wval,wflag,k,v);}
                        let sp:i32=-1;
                        if(pr>=0){sp=f4_contradict(k,v,z,mal,aa,wkey,wval,wflag,wqkey,wqval,wqflag);}
                        if(p==0){sig0=sp;}
                        if(p==1){sig1=sp;}
                        if(p==2){sig2=sp;}
                    }
                    p=p+1;
                }
                if(csig==-1){
                    let surv:i32=-1;
                    if(sig0>=1){surv=0;}
                    if(sig1>=1 && surv<0){surv=1;}
                    if(sig2>=1 && surv<0){surv=2;}
                    if(surv>=0){
                        let r2:i32=f4_audit(audit,&acount,ep,F4_OP_SCAFFOLD,act,-1);
                        if(r2==F4_TN_OK){r2=f4_audit(audit,&acount,ep,F4_OP_UNINSTALL_PROVISIONAL,0,act);}
                        if(r2==F4_TN_OK){r2=f4_audit(audit,&acount,ep,F4_OP_COMMIT,1,surv);}
                        if(r2==F4_TN_OK){
                            provisional=-1;
                            committed[0]=surv as u8;
                            if(revoke_step<0){revoke_step=ep;}
                        }
                        if(r2!=F4_TN_OK){rc=r2;}
                    }
                }
            }
        }
        if(rc==F4_TN_OK && kind==4){
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            if(rc==F4_TN_OK){rc=f4_do_insert(mkey,mval,mflag,F4_NMAIN,ep,audit,&acount,k,v,F4_OP_INSERT,0);}
        }
        if(ep==14){
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=f4_audit(audit,&acount,ep,F4_OP_PINSTALL,0,stated);
                if(r2==F4_TN_OK){provisional=stated;}
                if(r2!=F4_TN_OK){rc=r2;}
            } else {
                let r3:i32=f4_audit(audit,&acount,ep,F4_OP_WITHHOLD,0,cal_score);
                if(r3!=F4_TN_OK){rc=r3;}
            }
        }
        if(ep==48 && revoke_step<0 && provisional>=0){
            let r4:i32=f4_audit(audit,&acount,ep,F4_OP_PROMOTE,0,provisional);
            if(r4==F4_TN_OK){permanent=1;}
            if(r4!=F4_TN_OK){rc=r4;}
        }
        if(rc!=F4_TN_OK){badep=1;}
        ep=ep+1;
    }
    // Frozen expectations by tag (PREREG.md section 6, F4 table, with the
    // count amendments recorded in RESULTS.md).
    let e_pinstall_n:i32=1;let e_pp:i32=stated10;let e_withhold:i32=0;
    let e_cal:i32=4;let e_fire:i32=15;let e_ndisc:i32=1;let e_conn:i32=0;
    let e_nuninst:i32=0;let e_rs:i32=-1;let e_ncommit:i32=0;let e_cs:i32=-1;
    let e_nprom:i32=1;let e_ps:i32=48;let e_neg:i32=0;
    let e_deliver:i32=26;let e_del0:i32=0;let e_hold:i32=22;let e_discard:i32=0;
    let e_refuse:i32=10;let e_pdeliver:i32=14;let e_phold:i32=10;
    let e_prefuse:i32=4;let e_quar:i32=22;let e_main:i32=122;
    let e_lien:i32=0;let e_honn:i32=2;let e_at:i32=269;
    let e_uninstpol:i32=-1;let e_commitpol:i32=-1;
    if(tag==2 || tag==5){
        e_nuninst=1;e_rs=29;e_ncommit=1;e_cs=29;e_nprom=0;e_ps=-1;e_neg=1;
        e_deliver=34;e_del0=15;e_hold=14;e_quar=14;e_at=271;
        e_uninstpol=2;e_commitpol=1;
    }
    if(tag==2){e_lien=2;e_honn=0;}
    if(tag==5){e_lien=0;e_honn=2;}
    if(tag==3){
        e_pp=3;e_nuninst=1;e_rs=15;e_ncommit=1;e_cs=15;e_nprom=0;e_ps=-1;
        e_neg=1;e_quar=22;e_lien=2;e_honn=0;e_at=271;
        e_uninstpol=3;e_commitpol=1;
    }
    if(tag==4){
        e_pp=3;e_nuninst=1;e_rs=16;e_ncommit=1;e_cs=16;e_nprom=0;e_ps=-1;
        e_neg=1;e_hold=21;e_discard=1;e_quar=21;e_lien=2;e_honn=0;e_at=271;
        e_main=121;
        e_uninstpol=3;e_commitpol=1;
    }
    if(tag==6){e_lien=0;e_honn=1;}
    if(tag==7){
        e_pp=3;e_lien=2;e_honn=0;e_deliver=52;e_main=148;e_at=295;
        e_pdeliver=28;
    }
    f=f+f4c_check(px,"episodes_ok",badep,0);
    f=f+f4c_check(px,"pinstall_n",f4_audit_count_op(audit,acount,F4_OP_PINSTALL),e_pinstall_n);
    f=f+f4c_check(px,"pinstall_policy",f4c_first_op_aux(audit,acount,F4_OP_PINSTALL),e_pp);
    f=f+f4c_check(px,"pinstall_step",f4c_first_op_step(audit,acount,F4_OP_PINSTALL),14);
    f=f+f4c_check(px,"withhold_n",f4_audit_count_op(audit,acount,F4_OP_WITHHOLD),e_withhold);
    f=f+f4c_check(px,"cal_score",cal_score,e_cal);
    f=f+f4c_check(px,"fire_step",fire_step,e_fire);
    f=f+f4c_check(px,"ndisconnect",f4_audit_count_op(audit,acount,F4_OP_DISCONNECT),e_ndisc);
    f=f+f4c_check(px,"connected_end",connected,e_conn);
    f=f+f4c_check(px,"nuninstall",f4_audit_count_op(audit,acount,F4_OP_UNINSTALL_PROVISIONAL),e_nuninst);
    f=f+f4c_check(px,"revoke_step",revoke_step,e_rs);
    f=f+f4c_check(px,"ncommit",f4_audit_count_op(audit,acount,F4_OP_COMMIT),e_ncommit);
    f=f+f4c_check(px,"npromote",f4_audit_count_op(audit,acount,F4_OP_PROMOTE),e_nprom);
    f=f+f4c_check(px,"neg_signal_n",f4c_count_op_aux(audit,acount,F4_OP_SCAFFOLD,-1),e_neg);
    f=f+f4c_check(px,"total_deliver",f4_audit_count_op(audit,acount,F4_OP_DELIVER),e_deliver);
    f=f+f4c_check(px,"deliver_aux0",f4c_count_op_aux(audit,acount,F4_OP_DELIVER,0),e_del0);
    f=f+f4c_check(px,"total_hold",f4_audit_count_op(audit,acount,F4_OP_HOLD),e_hold);
    f=f+f4c_check(px,"total_discard",f4_audit_count_op(audit,acount,F4_OP_DISCARD),e_discard);
    f=f+f4c_check(px,"total_refuse",f4_audit_count_op(audit,acount,F4_OP_REFUSE),e_refuse);
    f=f+f4c_check(px,"persist_deliver",f4c_count_range(audit,acount,F4_OP_DELIVER,49,128),e_pdeliver);
    f=f+f4c_check(px,"persist_hold",f4c_count_range(audit,acount,F4_OP_HOLD,49,128),e_phold);
    f=f+f4c_check(px,"persist_refuse",f4c_count_range(audit,acount,F4_OP_REFUSE,49,128),e_prefuse);
    f=f+f4c_check(px,"quar_used",f4_count_used(qkey,F4_NQUAR),e_quar);
    f=f+f4c_check(px,"main_used",f4_count_used(mkey,F4_NMAIN),e_main);
    f=f+f4c_check(px,"teach_lie_n",f4c_count_op_aux(audit,acount,F4_OP_TEACH,1),e_lien);
    f=f+f4c_check(px,"teach_honest_n",f4c_count_op_aux(audit,acount,F4_OP_TEACH,0),e_honn);
    if(tag==6){
        f=f+f4c_check(px,"teach_inert_lie_n",f4c_count_op_aux(audit,acount,F4_OP_TEACH,2),1);
    }
    f=f+f4c_check(px,"audit_total",acount,e_at);
    if(e_nuninst==1){
        f=f+f4c_check(px,"commit_step",f4c_first_op_step(audit,acount,F4_OP_COMMIT),e_cs);
        f=f+f4c_check(px,"uninstall_policy",f4c_first_op_aux(audit,acount,F4_OP_UNINSTALL_PROVISIONAL),e_uninstpol);
        f=f+f4c_check(px,"commit_policy",f4c_first_op_aux(audit,acount,F4_OP_COMMIT),e_commitpol);
    }
    if(e_nprom==1){
        f=f+f4c_check(px,"promote_step",f4c_first_op_step(audit,acount,F4_OP_PROMOTE),e_ps);
    }
    if(tag==2 || tag==5){
        f=f+f4c_check(px,"post29_dump",f4c_count_range_aux(audit,acount,F4_OP_DELIVER,0,30,128),0);
        f=f+f4c_check(px,"tempt_refuse_2328",f4c_count_range(audit,acount,F4_OP_REFUSE,23,28),6);
    }
    if(tag==3){
        f=f+f4c_check(px,"e15_deliver_aux",f4c_first_op_aux(audit,acount,F4_OP_DELIVER),3);
    }
    if(tag==1 || tag==6){
        f=f+f4c_check(px,"post16_dump",f4c_count_range_aux(audit,acount,F4_OP_DELIVER,0,16,128),0);
    }
    f4_free(mkey);f4_free(mval);f4_free(mflag);
    f4_free(qkey);f4_free(qval);f4_free(qflag);
    f4_free(skey);f4_free(sval);f4_free(sflag);
    f4_free(sqkey);f4_free(sqval);f4_free(sqflag);
    f4_free(pkey);f4_free(pval);f4_free(pflag);
    f4_free(pqkey);f4_free(pqval);f4_free(pqflag);
    f4_free(wkey);f4_free(wval);f4_free(wflag);
    f4_free(wqkey);f4_free(wqval);f4_free(wqflag);
    f4_free(audit);f4_free(committed);
    return f;
}

// (e) GENERATED candidate policies: the learner enumerates delivery
// hypotheses at runtime from two observation primitives (zone
// primitives {zone, zero, cycle} x malformed handling {hold, dump})
// instead of receiving a policy from the teacher. The teacher's
// statement (tag 8: (zone,hold), tag 9: (zero,dump)) is one
// hypothesis among six. No scalar-feedback token anywhere.
fn gen_build(gt:[]u8,gm:[]u8,zones_seen:i32)i32 {
    gt[0]=0;gm[0]=0;gt[1]=0;gm[1]=1;gt[2]=1;gm[2]=0;
    gt[3]=1;gm[3]=1;
    if(zones_seen>=2){gt[4]=2;gm[4]=0;gt[5]=2;gm[5]=1;return 6;}
    return 4;
}

fn gen_find_idx(gt:[]u8,gm:[]u8,n:i32,st:i32,sm:i32)i32 {
    let i:i32=0;
    while(i<n){
        if((gt[i] as i32)==st && (gm[i] as i32)==sm){return i;}
        i=i+1;
    }
    return -1;
}

fn f4_act_gen(gt:[]u8,gm:[]u8,idx:i32,
    mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32,z:i32,mal:i32)i32 {
    let tgt:i32=gt[idx] as i32;let mmal:i32=gm[idx] as i32;
    if(mal==1){
        if(mmal==0){return f4_do_hold(mkey,mval,mflag,qkey,qval,qflag,F4_NQUAR,step,abuf,acount,k,v);}
        return f4_do_deliver(mkey,mval,mflag,F4_NMAIN,step,abuf,acount,k,v,0);
    }
    if(tgt==0){return f4_do_deliver(mkey,mval,mflag,F4_NMAIN,step,abuf,acount,k,v,z);}
    if(tgt==1){return f4_do_deliver(mkey,mval,mflag,F4_NMAIN,step,abuf,acount,k,v,0);}
    return f4_do_deliver(mkey,mval,mflag,F4_NMAIN,step,abuf,acount,k,v,k%4);
}

// Arm F4-GEN: the learner generates 6 candidates at runtime from
// observation primitives; the teacher's statement is one hypothesis.
fn arm_f4gen(st_t:i32,st_m:i32,tag:i32,px:[]u8)i32 {
    let f:i32=0;
    let mkey:[]u8=f4_alloc(F4_NMAIN*4);
    let mval:[]u8=f4_alloc(F4_NMAIN*4);
    let mflag:[]u8=f4_alloc(F4_NMAIN*4);
    let qkey:[]u8=f4_alloc(F4_NQUAR*4);
    let qval:[]u8=f4_alloc(F4_NQUAR*4);
    let qflag:[]u8=f4_alloc(F4_NQUAR*4);
    let skey:[]u8=f4_alloc(F4_NMAIN*4);
    let sval:[]u8=f4_alloc(F4_NMAIN*4);
    let sflag:[]u8=f4_alloc(F4_NMAIN*4);
    let sqkey:[]u8=f4_alloc(F4_NQUAR*4);
    let sqval:[]u8=f4_alloc(F4_NQUAR*4);
    let sqflag:[]u8=f4_alloc(F4_NQUAR*4);
    let pkey:[]u8=f4_alloc(F4_NMAIN*4);
    let pval:[]u8=f4_alloc(F4_NMAIN*4);
    let pflag:[]u8=f4_alloc(F4_NMAIN*4);
    let pqkey:[]u8=f4_alloc(F4_NQUAR*4);
    let pqval:[]u8=f4_alloc(F4_NQUAR*4);
    let pqflag:[]u8=f4_alloc(F4_NQUAR*4);
    let wkey:[]u8=f4_alloc(F4_NMAIN*4);
    let wval:[]u8=f4_alloc(F4_NMAIN*4);
    let wflag:[]u8=f4_alloc(F4_NMAIN*4);
    let wqkey:[]u8=f4_alloc(F4_NQUAR*4);
    let wqval:[]u8=f4_alloc(F4_NQUAR*4);
    let wqflag:[]u8=f4_alloc(F4_NQUAR*4);
    let audit:[]u8=f4_alloc(F4_AUDIT_CAP*16);
    let committed:[]u8=f4_alloc(1);
    committed[0]=F4_UNCONNECTED as u8;
    let gt:[]u8=f4_alloc(8);
    let gm:[]u8=f4_alloc(8);
    let acount:i32=0;
    let has_rule:i32=0;
    let provisional:i32=-1;let permanent:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let connected:i32=1;let fire_step:i32=-1;let revoke_step:i32=-1;
    let gen_n:i32=0;let stated_idx:i32=-1;
    let ep:i32=1;
    while(ep<=F4_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;let z:i32=0;let mal:i32=0;
        f4_ep_info(ep,&etype,&k,&v,&auth,&z,&mal);
        if(etype==F4_ET_PN){k=700+f4_pn_before(ep);}
        let kind:i32=0;
        if(etype==F4_ET_TEACH){kind=1;}
        if(etype==F4_ET_CAL){kind=2;}
        if(kind==0 && f4_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=F4_TN_OK;
        if(connected==1 && provisional>=0){
            rc=f4_audit(audit,&acount,ep,F4_OP_DISCONNECT,0,0);
            if(rc==F4_TN_OK){connected=0;fire_step=ep;}
        }
        if(rc==F4_TN_OK && kind==1){
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            if(rc==F4_TN_OK){rc=f4_audit(audit,&acount,ep,F4_OP_TEACH,0,1);}
            if(rc==F4_TN_OK){has_rule=1;}
        }
        if(rc==F4_TN_OK && kind==2){
            f4_copy(skey,mkey,F4_NMAIN*4);f4_copy(sval,mval,F4_NMAIN*4);f4_copy(sflag,mflag,F4_NMAIN*4);
            f4_copy(sqkey,qkey,F4_NQUAR*4);f4_copy(sqval,qval,F4_NQUAR*4);f4_copy(sqflag,qflag,F4_NQUAR*4);
            let v_old:i32=-1;
            let s0:i32=f4_find_main(mkey,F4_NMAIN,k);
            if(s0>=0){v_old=f4_g32(mval,s0*4);}
            let ok:i32=0;
            if(v!=v_old){
                let sr:i32=f4_sim_gen(skey,sval,sflag,sqkey,sqval,sqflag,k,v,z,mal,st_t,st_m);
                if(sr>=0){
                    if(st_m==0){
                        if(f4_quar_has(sqkey,sqval,F4_NQUAR,k,v)==1){ok=1;}
                        if(ok==1 && f4_main_flag(sflag,F4_NMAIN,k,skey)!=5){ok=0;}
                    } else {
                        if(f4_main_has_kvf(skey,sval,sflag,F4_NMAIN,k,v,1)==1){ok=1;}
                    }
                }
            } else {
                ok=f4_mem_eq(skey,mkey,F4_NMAIN*4);
                if(ok==1){ok=f4_mem_eq(sval,mval,F4_NMAIN*4);}
                if(ok==1){ok=f4_mem_eq(sflag,mflag,F4_NMAIN*4);}
                if(ok==1){ok=f4_mem_eq(sqkey,qkey,F4_NQUAR*4);}
                if(ok==1){ok=f4_mem_eq(sqval,qval,F4_NQUAR*4);}
                if(ok==1){ok=f4_mem_eq(sqflag,qflag,F4_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            if(rc==F4_TN_OK){rc=f4_audit(audit,&acount,ep,F4_OP_CALIBRATE,0,ok);}
        }
        if(rc==F4_TN_OK && kind==3){
            f4_copy(pkey,mkey,F4_NMAIN*4);f4_copy(pval,mval,F4_NMAIN*4);f4_copy(pflag,mflag,F4_NMAIN*4);
            f4_copy(pqkey,qkey,F4_NQUAR*4);f4_copy(pqval,qval,F4_NQUAR*4);f4_copy(pqflag,qflag,F4_NQUAR*4);
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            let act:i32=provisional;
            if(committed[0]!=F4_UNCONNECTED as u8){act=committed[0] as i32;}
            if(act<0 || act>5){act=0;}
            if(auth!=0){rc=f4_audit(audit,&acount,ep,F4_OP_REFUSE,auth,act);}
            if(rc==F4_TN_OK){
                rc=f4_act_gen(gt,gm,act,mkey,mval,mflag,qkey,qval,qflag,ep,audit,&acount,k,v,z,mal);
            }
            if(rc==F4_TN_OK && permanent==0 && ep>=15 && ep<=48 && provisional>=0){
                let aa:i32=0;
                if(ep>=29 && ep<=48){aa=1;}
                let csig:i32=f4_contradict(k,v,z,mal,aa,mkey,mval,mflag,qkey,qval,qflag);
                let ssig0:i32=99;let ssig1:i32=99;let ssig2:i32=99;
                let ssig3:i32=99;let ssig4:i32=99;let ssig5:i32=99;
                let p:i32=0;
                while(p<6){
                    if(p!=act){
                        f4_copy(wkey,pkey,F4_NMAIN*4);f4_copy(wval,pval,F4_NMAIN*4);f4_copy(wflag,pflag,F4_NMAIN*4);
                        f4_copy(wqkey,pqkey,F4_NQUAR*4);f4_copy(wqval,pqval,F4_NQUAR*4);f4_copy(wqflag,pqflag,F4_NQUAR*4);
                        let pr:i32=f4_sim_gen(wkey,wval,wflag,wqkey,wqval,wqflag,k,v,z,mal,gt[p] as i32,gm[p] as i32);
                        let sp:i32=-1;
                        if(pr>=0){sp=f4_contradict(k,v,z,mal,aa,wkey,wval,wflag,wqkey,wqval,wqflag);}
                        if(p==0){ssig0=sp;}
                        if(p==1){ssig1=sp;}
                        if(p==2){ssig2=sp;}
                        if(p==3){ssig3=sp;}
                        if(p==4){ssig4=sp;}
                        if(p==5){ssig5=sp;}
                    }
                    p=p+1;
                }
                if(csig==-1){
                    let surv:i32=-1;
                    if(ssig0>=1 && surv<0){surv=0;}
                    if(ssig1>=1 && surv<0){surv=1;}
                    if(ssig2>=1 && surv<0){surv=2;}
                    if(ssig3>=1 && surv<0){surv=3;}
                    if(ssig4>=1 && surv<0){surv=4;}
                    if(ssig5>=1 && surv<0){surv=5;}
                    if(surv>=0){
                        let r2:i32=f4_audit(audit,&acount,ep,F4_OP_SCAFFOLD,act,-1);
                        if(r2==F4_TN_OK){r2=f4_audit(audit,&acount,ep,F4_OP_UNINSTALL_PROVISIONAL,0,act);}
                        if(r2==F4_TN_OK){r2=f4_audit(audit,&acount,ep,F4_OP_COMMIT,1,surv);}
                        if(r2==F4_TN_OK){
                            provisional=-1;
                            committed[0]=surv as u8;
                            if(revoke_step<0){revoke_step=ep;}
                        }
                        if(r2!=F4_TN_OK){rc=r2;}
                    }
                }
            }
        }
        if(rc==F4_TN_OK && kind==4){
            rc=f4_audit(audit,&acount,ep,F4_OP_EPISODE,etype,-1);
            if(rc==F4_TN_OK){rc=f4_do_insert(mkey,mval,mflag,F4_NMAIN,ep,audit,&acount,k,v,F4_OP_INSERT,0);}
        }
        if(ep==14){
            // Observation-driven candidate generation: count distinct zones
            // seen in E1..13 (NOVEL 1..8 + CAL 11..13), then enumerate.
            let seen1:i32=0;let seen2:i32=0;let seen3:i32=0;
            let q2:i32=1;
            while(q2<=13){
                let qt:i32=0;let qk:i32=0;let qv:i32=0;let qa:i32=0;let qz:i32=0;let qm:i32=0;
                f4_ep_info(q2,&qt,&qk,&qv,&qa,&qz,&qm);
                if(qz==1){seen1=1;}
                if(qz==2){seen2=1;}
                if(qz==3){seen3=1;}
                q2=q2+1;
            }
            let zones_seen:i32=seen1+seen2+seen3;
            gen_n=gen_build(gt,gm,zones_seen);
            stated_idx=gen_find_idx(gt,gm,gen_n,st_t,st_m);
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1 && stated_idx>=0){
                let r2:i32=f4_audit(audit,&acount,ep,F4_OP_PINSTALL,0,stated_idx);
                if(r2==F4_TN_OK){provisional=stated_idx;}
                if(r2!=F4_TN_OK){rc=r2;}
            } else {
                let r3:i32=f4_audit(audit,&acount,ep,F4_OP_WITHHOLD,0,cal_score);
                if(r3!=F4_TN_OK){rc=r3;}
            }
        }
        if(ep==48 && revoke_step<0 && provisional>=0){
            let r4:i32=f4_audit(audit,&acount,ep,F4_OP_PROMOTE,0,provisional);
            if(r4==F4_TN_OK){permanent=1;}
            if(r4!=F4_TN_OK){rc=r4;}
        }
        if(rc!=F4_TN_OK){badep=1;}
        ep=ep+1;
    }
    // Frozen expectations by tag (PREREG.md section 6, generated-policy cells).
    let e_pp:i32=stated_idx;let e_rs:i32=-1;let e_nuninst:i32=0;
    let e_ncommit:i32=0;let e_cs:i32=-1;let e_nprom:i32=1;let e_ps:i32=48;
    let e_neg:i32=0;let e_deliver:i32=26;let e_del0:i32=0;let e_hold:i32=22;
    let e_quar:i32=22;let e_at:i32=269;
    if(tag==9){
        e_pp=3;e_rs=29;e_nuninst=1;e_ncommit=1;e_cs=29;e_nprom=0;e_ps=-1;
        e_neg=1;e_deliver=34;e_del0=15;e_hold=14;e_quar=14;e_at=271;
    }
    f=f+f4c_check(px,"episodes_ok",badep,0);
    f=f+f4c_check(px,"gen_n",gen_n,6);
    f=f+f4c_check(px,"stated_idx",stated_idx,e_pp);
    f=f+f4c_check(px,"pinstall_n",f4_audit_count_op(audit,acount,F4_OP_PINSTALL),1);
    f=f+f4c_check(px,"pinstall_policy",f4c_first_op_aux(audit,acount,F4_OP_PINSTALL),e_pp);
    f=f+f4c_check(px,"withhold_n",f4_audit_count_op(audit,acount,F4_OP_WITHHOLD),0);
    f=f+f4c_check(px,"cal_score",cal_score,4);
    f=f+f4c_check(px,"fire_step",fire_step,15);
    f=f+f4c_check(px,"connected_end",connected,0);
    f=f+f4c_check(px,"nuninstall",f4_audit_count_op(audit,acount,F4_OP_UNINSTALL_PROVISIONAL),e_nuninst);
    f=f+f4c_check(px,"revoke_step",revoke_step,e_rs);
    f=f+f4c_check(px,"ncommit",f4_audit_count_op(audit,acount,F4_OP_COMMIT),e_ncommit);
    f=f+f4c_check(px,"npromote",f4_audit_count_op(audit,acount,F4_OP_PROMOTE),e_nprom);
    f=f+f4c_check(px,"neg_signal_n",f4c_count_op_aux(audit,acount,F4_OP_SCAFFOLD,-1),e_neg);
    f=f+f4c_check(px,"total_deliver",f4_audit_count_op(audit,acount,F4_OP_DELIVER),e_deliver);
    f=f+f4c_check(px,"deliver_aux0",f4c_count_op_aux(audit,acount,F4_OP_DELIVER,0),e_del0);
    f=f+f4c_check(px,"total_hold",f4_audit_count_op(audit,acount,F4_OP_HOLD),e_hold);
    f=f+f4c_check(px,"quar_used",f4_count_used(qkey,F4_NQUAR),e_quar);
    f=f+f4c_check(px,"main_used",f4_count_used(mkey,F4_NMAIN),122);
    f=f+f4c_check(px,"audit_total",acount,e_at);
    if(tag==9){
        f=f+f4c_check(px,"commit_step",f4c_first_op_step(audit,acount,F4_OP_COMMIT),e_cs);
        f=f+f4c_check(px,"uninstall_policy",f4c_first_op_aux(audit,acount,F4_OP_UNINSTALL_PROVISIONAL),3);
        f=f+f4c_check(px,"commit_policy",f4c_first_op_aux(audit,acount,F4_OP_COMMIT),0);
        f=f+f4c_check(px,"post29_dump",f4c_count_range_aux(audit,acount,F4_OP_DELIVER,0,30,128),0);
    }
    f4_free(mkey);f4_free(mval);f4_free(mflag);
    f4_free(qkey);f4_free(qval);f4_free(qflag);
    f4_free(skey);f4_free(sval);f4_free(sflag);
    f4_free(sqkey);f4_free(sqval);f4_free(sqflag);
    f4_free(pkey);f4_free(pval);f4_free(pflag);
    f4_free(pqkey);f4_free(pqval);f4_free(pqflag);
    f4_free(wkey);f4_free(wval);f4_free(wflag);
    f4_free(wqkey);f4_free(wqval);f4_free(wqflag);
    f4_free(audit);f4_free(committed);f4_free(gt);f4_free(gm);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+f4a_arm();
    f=f+arm_f4(1,1,0,0,0,1,"f4h_");
    f=f+arm_f4(2,2,1,1,0,2,"f4l1_");
    f=f+arm_f4(3,3,1,1,F4_LIE3_ZMAP,3,"f4l2_");
    f=f+arm_f4(3,3,1,1,F4_LIE3_NOHOLD,4,"f4l3_");
    f=f+arm_f4(1,2,0,0,0,5,"f4l4_");
    f=f+arm_f4(1,1,0,2,0,6,"f4l5_");
    f=f+arm_f4(3,3,1,1,F4_LIE3_DUPDELIVER,7,"f4r1_");
    f=f+arm_f4gen(0,0,8,"f4g1_");
    f=f+arm_f4gen(1,1,9,"f4g2_");
    _zag_println("");
    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);f4_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

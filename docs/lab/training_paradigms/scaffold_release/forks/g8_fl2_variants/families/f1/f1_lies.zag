// f1_lies.zag - G8 FL2 VARIANTS (d): lie designs x F1 deliberate-memory-ops family.
// In-binary Arm A teaching baseline (verbatim from FL2) + arm_f1 run on 7
// cells: H honest, L1 REKEY-as-correct anchor, L2 subtle-param OVERQ,
// L3 omission QNF, L4 self-contradicting teacher, L5 inert property-lie,
// R1 calibration-evasive REKEY(v+1) -> WITHHOLD.
// Frozen per families/PREREG.md (commit c023ecad).
@import("tn.zag")

const TN_OP_PINSTALL:i32=16;
const TN_OP_PROMOTE:i32=17;
const TN_OP_UNINSTALL_PROVISIONAL:i32=18;
const TN_OP_OVERQ:i32=19;
const TN_OP_QNF:i32=20;
const ACT_LIE:i32=3;
const LIE3_OVERQ:i32=1;
const LIE3_QNF:i32=2;

fn f1_check(px:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(px);_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);tn_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);tn_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn f1_count_range(abuf:[]u8,n:i32,op:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=tn_g32(abuf,i*16);
        if(tn_g32(abuf,i*16+4)==op && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

fn f1_first_op_step(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op){return tn_g32(abuf,i*16);}
        i=i+1;
    }
    return -1;
}

fn f1_first_op_aux(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op){return tn_g32(abuf,i*16+12);}
        i=i+1;
    }
    return -1;
}

fn f1_count_op_aux(abuf:[]u8,n:i32,op:i32,auxv:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op && tn_g32(abuf,i*16+12)==auxv){c=c+1;}
        i=i+1;
    }
    return c;
}

// Arm A: pure deliberate teaching (verbatim from FL2's fl2.zag).
fn arm_a()i32 {
    let f:i32=0;
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let skey:[]u8=tn_alloc(TN_NMAIN*4);
    let sval:[]u8=tn_alloc(TN_NMAIN*4);
    let sflag:[]u8=tn_alloc(TN_NMAIN*4);
    let sqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let sqval:[]u8=tn_alloc(TN_NQUAR*4);
    let sqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let acount:i32=0;
    let has_rule:i32=0;let installed:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;
        tn_ep_info(ep,&etype,&k,&v,&auth);
        if(etype==ET_PN){k=19+tn_pn_before(ep);}
        let kind:i32=0;
        if(etype==ET_TEACH){kind=1;}
        if(etype==ET_CAL){kind=2;}
        if(kind==0 && tn_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=TN_OK;
        if(kind==1){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_TEACH,0,0);}
            if(rc==TN_OK){has_rule=1;}
        }
        if(rc==TN_OK && kind==2){
            tn_copy(skey,mkey,TN_NMAIN*4);tn_copy(sval,mval,TN_NMAIN*4);tn_copy(sflag,mflag,TN_NMAIN*4);
            tn_copy(sqkey,qkey,TN_NQUAR*4);tn_copy(sqval,qval,TN_NQUAR*4);tn_copy(sqflag,qflag,TN_NQUAR*4);
            let v_old:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
            let qs:i32=-1;let sim_ran:i32=0;
            if(v!=v_old){
                qs=tn_sim_contest(skey,sflag,sqkey,sqval,sqflag,TN_NQUAR,k,v);
                sim_ran=1;
            }
            let ok:i32=0;
            if(sim_ran==1 && qs>=0 && qs==tn_count_used(qkey,TN_NQUAR)){ok=1;}
            if(ok==1 && tn_g32(sqkey,qs*4)!=k){ok=0;}
            if(ok==1 && tn_g32(sqval,qs*4)!=v){ok=0;}
            if(ok==1 && tn_g32(sqflag,qs*4)!=1){ok=0;}
            if(ok==1 && tn_main_val(skey,sval,TN_NMAIN,k)!=v_old){ok=0;}
            if(ok==1 && tn_main_flag(sflag,TN_NMAIN,k,skey)!=1){ok=0;}
            if(sim_ran==0){
                ok=tn_mem_eq(skey,mkey,TN_NMAIN*4);
                if(ok==1){ok=tn_mem_eq(sval,mval,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sflag,mflag,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sqkey,qkey,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqval,qval,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqflag,qflag,TN_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_CALIBRATE,0,ok);}
        }
        if(rc==TN_OK && kind==3){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK && installed==1){
                if(auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,1);}
                if(rc==TN_OK){rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);}
            }
            if(rc==TN_OK && installed==0){
                rc=tn_do_overwrite(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v);
            }
        }
        if(rc==TN_OK && kind==4){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_INSERT,0);}
        }
        if(ep==14){
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=tn_audit(audit,&acount,ep,TN_OP_INSTALL,0,cal_score);
                if(r2==TN_OK){installed=1;}
                if(r2!=TN_OK){rc=r2;}
            } else {
                let r3:i32=tn_audit(audit,&acount,ep,TN_OP_WITHHOLD,0,cal_score);
                if(r3!=TN_OK){rc=r3;}
            }
        }
        if(rc!=TN_OK){badep=1;}
        ep=ep+1;
    }
    f=f+f1_check("f1a_","episodes_ok",badep,0);
    f=f+f1_check("f1a_","install_n",tn_audit_count_op(audit,acount,TN_OP_INSTALL),1);
    f=f+f1_check("f1a_","install_step",f1_first_op_step(audit,acount,TN_OP_INSTALL),14);
    f=f+f1_check("f1a_","withhold_n",tn_audit_count_op(audit,acount,TN_OP_WITHHOLD),0);
    f=f+f1_check("f1a_","cal_n",tn_audit_count_op(audit,acount,TN_OP_CALIBRATE),4);
    f=f+f1_check("f1a_","cal_score",cal_score,4);
    f=f+f1_check("f1a_","acq_contest",f1_count_range(audit,acount,TN_OP_CONTEST,15,22),8);
    f=f+f1_check("f1a_","tempt_contest",f1_count_range(audit,acount,TN_OP_CONTEST,23,28),6);
    f=f+f1_check("f1a_","tempt_refuse",f1_count_range(audit,acount,TN_OP_REFUSE,23,28),6);
    f=f+f1_check("f1a_","auditc_contest",f1_count_range(audit,acount,TN_OP_CONTEST,29,48),10);
    f=f+f1_check("f1a_","persist_contest",f1_count_range(audit,acount,TN_OP_CONTEST,49,128),24);
    f=f+f1_check("f1a_","persist_refuse",f1_count_range(audit,acount,TN_OP_REFUSE,49,128),4);
    f=f+f1_check("f1a_","total_contest",tn_audit_count_op(audit,acount,TN_OP_CONTEST),48);
    f=f+f1_check("f1a_","total_overwrite",tn_audit_count_op(audit,acount,TN_OP_OVERWRITE),0);
    f=f+f1_check("f1a_","total_rekey",tn_audit_count_op(audit,acount,TN_OP_REKEY),0);
    f=f+f1_check("f1a_","quar_used",tn_count_used(qkey,TN_NQUAR),48);
    let mm:i32=0;let fm:i32=0;let kk:i32=1;
    while(kk<=8){
        if(tn_main_val(mkey,mval,TN_NMAIN,kk)!=100+kk){mm=mm+1;}
        if(tn_main_flag(mflag,TN_NMAIN,kk,mkey)!=1){fm=fm+1;}
        kk=kk+1;
    }
    f=f+f1_check("f1a_","main18_val_mm",mm,0);
    f=f+f1_check("f1a_","main18_flag_mm",fm,0);
    f=f+f1_check("f1a_","audit_total",acount,267);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(skey);tn_free(sval);tn_free(sflag);
    tn_free(sqkey);tn_free(sqval);tn_free(sqflag);
    tn_free(audit);
    return f;
}

// F1-SELECT-REGION-BEGIN
// FL2 action selection: committed survivor, else provisional install.
// Pure function of (provisional, committed): no signal parameter, and
// the signal token csig never appears in this region.
fn f1_select(provisional:i32,committed:[]u8)i32 {
    if((committed[0] as i32)!=TN_UNCONNECTED){return committed[0] as i32;}
    return provisional;
}
// F1-SELECT-REGION-END

// F1-SIM-REGION-BEGIN
// No-audit sim twins of the overwrite and rekey procedures (FL2 pattern).
// Pure scratch-state manipulation: no signal is read, accumulated, or
// returned here; the csig token never appears in this region.
fn f1_sim_overwrite(skey:[]u8,sval:[]u8,sflag:[]u8,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(skey,TN_NMAIN,k);
    if(s<0){return -1;}
    tn_s32(sval,s*4,v);tn_s32(sflag,s*4,0);
    return s;
}

fn f1_sim_rekey(skey:[]u8,sval:[]u8,sflag:[]u8,k:i32,v:i32,rk:i32)i32 {
    let s:i32=tn_first_free(skey,TN_NMAIN);
    if(s<0){return -1;}
    tn_s32(skey,s*4,rk);tn_s32(sval,s*4,v);tn_s32(sflag,s*4,0);
    return s;
}
// F1-SIM-REGION-END

// Audited OVERQ: quarantine the newcomer AND overwrite the incumbent
// (the L2 subtle-param lie's action). Single audited op.
fn tn_do_overq(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    nq:i32,step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,TN_NMAIN,k);
    if(s<0){return TN_BAD;}
    let q:i32=tn_first_free(qkey,nq);
    if(q<0){return TN_BAD;}
    let r:i32=tn_audit(abuf,acount,step,TN_OP_OVERQ,s+1,q+1);
    if(r!=TN_OK){return r;}
    tn_s32(qkey,q*4,k);tn_s32(qval,q*4,v);tn_s32(qflag,q*4,1);
    tn_s32(mflag,s*4,1);
    tn_s32(mval,s*4,v);
    return TN_OK;
}

// Audited QNF: quarantine the newcomer, incumbent flag untouched
// (the L3 omission lie's action). Single audited op.
fn tn_do_qnf(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    nq:i32,step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,TN_NMAIN,k);
    if(s<0){return TN_BAD;}
    let q:i32=tn_first_free(qkey,nq);
    if(q<0){return TN_BAD;}
    let r:i32=tn_audit(abuf,acount,step,TN_OP_QNF,s+1,q+1);
    if(r!=TN_OK){return r;}
    tn_s32(qkey,q*4,k);tn_s32(qval,q*4,v);tn_s32(qflag,q*4,1);
    return TN_OK;
}

// The contradiction signal, VERBATIM the frozen FL2 semantics. Computed
// by the learner from its own observed world state, episodically only.
// The fork source carries no scalar-feedback token anywhere; the episodic value
// lives in a local named `csig`.
fn f1_contradict(k:i32,v_new:i32,v_old:i32,audit_active:i32,
    mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8)i32 {
    if(v_old!=-1){
        if(tn_main_val(mkey,mval,TN_NMAIN,k)!=v_old){
            if(tn_quar_has(qkey,qval,TN_NQUAR,k,v_old)==0){return -1;}
        }
    }
    if(tn_main_has_rekeyed(mkey,mval,TN_NMAIN,v_new)==1){
        if(audit_active==1){return -1;}
        return 2;
    }
    if(tn_quar_has_flag(qkey,qval,qflag,TN_NQUAR,k,v_new)==1){
        if(tn_main_val(mkey,mval,TN_NMAIN,k)==v_old){
            if(tn_main_flag(mflag,TN_NMAIN,k,mkey)==1){return 1;}
        }
    }
    return -1;
}

// Arm F1-FL2: provisional install of the stated rule at E14 (through the
// calibration gate), learner-fired disconnect at E15, per-episode
// eliminative self-verification with counterfactual simulation of the
// {OVERWRITE, CONTEST, REKEY} candidates on scratch state.
// stated9/stated10: teacher statements at E9/E10 (last wins).
// aux9/aux10: TEACH lie markers. lie3: the ACT_LIE=3 variant
// (1=OVERQ subtle-param, 2=QNF omission). tag: frozen-expectation cell.
fn arm_f1(stated9:i32,stated10:i32,aux9:i32,aux10:i32,lie3:i32,tag:i32,px:[]u8)i32 {
    let f:i32=0;
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let skey:[]u8=tn_alloc(TN_NMAIN*4);
    let sval:[]u8=tn_alloc(TN_NMAIN*4);
    let sflag:[]u8=tn_alloc(TN_NMAIN*4);
    let sqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let sqval:[]u8=tn_alloc(TN_NQUAR*4);
    let sqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let pkey:[]u8=tn_alloc(TN_NMAIN*4);
    let pval:[]u8=tn_alloc(TN_NMAIN*4);
    let pflag:[]u8=tn_alloc(TN_NMAIN*4);
    let pqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let pqval:[]u8=tn_alloc(TN_NQUAR*4);
    let pqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let wkey:[]u8=tn_alloc(TN_NMAIN*4);
    let wval:[]u8=tn_alloc(TN_NMAIN*4);
    let wflag:[]u8=tn_alloc(TN_NMAIN*4);
    let wqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let wqval:[]u8=tn_alloc(TN_NQUAR*4);
    let wqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let committed:[]u8=tn_alloc(1);
    committed[0]=TN_UNCONNECTED as u8;
    let acount:i32=0;
    let has_rule:i32=0;let stated:i32=stated9;
    let provisional:i32=-1;let permanent:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let connected:i32=1;let fire_step:i32=-1;let revoke_step:i32=-1;
    let rseq:i32=0;
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;
        tn_ep_info(ep,&etype,&k,&v,&auth);
        if(etype==ET_PN){k=19+tn_pn_before(ep);}
        let kind:i32=0;
        if(etype==ET_TEACH){kind=1;}
        if(etype==ET_CAL){kind=2;}
        if(kind==0 && tn_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=TN_OK;
        if(connected==1 && provisional>=0){
            rc=tn_audit(audit,&acount,ep,TN_OP_DISCONNECT,0,0);
            if(rc==TN_OK){connected=0;fire_step=ep;}
        }
        if(rc==TN_OK && kind==1){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            let taux:i32=aux9;
            if(ep==10){taux=aux10;}
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_TEACH,0,taux);}
            if(rc==TN_OK){has_rule=1;stated=stated10;}
        }
        if(rc==TN_OK && kind==2){
            tn_copy(skey,mkey,TN_NMAIN*4);tn_copy(sval,mval,TN_NMAIN*4);tn_copy(sflag,mflag,TN_NMAIN*4);
            tn_copy(sqkey,qkey,TN_NQUAR*4);tn_copy(sqval,qval,TN_NQUAR*4);tn_copy(sqflag,qflag,TN_NQUAR*4);
            let v_old:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
            let ok:i32=0;
            if(v!=v_old){
                if(stated==ACT_CONTEST){
                    let qs:i32=tn_sim_contest(skey,sflag,sqkey,sqval,sqflag,TN_NQUAR,k,v);
                    if(qs>=0 && qs==tn_count_used(qkey,TN_NQUAR)){ok=1;}
                    if(ok==1 && tn_g32(sqkey,qs*4)!=k){ok=0;}
                    if(ok==1 && tn_g32(sqval,qs*4)!=v){ok=0;}
                    if(ok==1 && tn_g32(sqflag,qs*4)!=1){ok=0;}
                    if(ok==1 && tn_main_val(skey,sval,TN_NMAIN,k)!=v_old){ok=0;}
                    if(ok==1 && tn_main_flag(sflag,TN_NMAIN,k,skey)!=1){ok=0;}
                }
                if(stated==ACT_REKEY){
                    let s:i32=tn_first_free(skey,TN_NMAIN);
                    if(s>=0){
                        tn_s32(skey,s*4,TN_REKEY_BASE+800000+ep);
                        let sv:i32=v;
                        if(tag==7){sv=v+1;}
                        tn_s32(sval,s*4,sv);
                        tn_s32(sflag,s*4,0);
                        if(tn_main_has_rekeyed(skey,sval,TN_NMAIN,v)==1){ok=1;}
                        if(ok==1 && tn_main_val(skey,sval,TN_NMAIN,k)!=v_old){ok=0;}
                        if(ok==1 && tn_main_flag(sflag,TN_NMAIN,k,skey)!=0){ok=0;}
                        if(ok==1 && tn_count_used(sqkey,TN_NQUAR)!=tn_count_used(qkey,TN_NQUAR)){ok=0;}
                    }
                }
                if(stated==ACT_LIE && lie3==LIE3_OVERQ){
                    let s2:i32=tn_find_main(skey,TN_NMAIN,k);
                    let q2:i32=tn_first_free(sqkey,TN_NQUAR);
                    if(s2>=0 && q2>=0){
                        tn_s32(sqkey,q2*4,k);tn_s32(sqval,q2*4,v);tn_s32(sqflag,q2*4,1);
                        tn_s32(sflag,s2*4,1);tn_s32(sval,s2*4,v);
                        if(q2==tn_count_used(qkey,TN_NQUAR)){ok=1;}
                        if(ok==1 && tn_g32(sqkey,q2*4)!=k){ok=0;}
                        if(ok==1 && tn_g32(sqval,q2*4)!=v){ok=0;}
                        if(ok==1 && tn_g32(sqflag,q2*4)!=1){ok=0;}
                        if(ok==1 && tn_main_val(skey,sval,TN_NMAIN,k)!=v){ok=0;}
                        if(ok==1 && tn_main_flag(sflag,TN_NMAIN,k,skey)!=1){ok=0;}
                    }
                }
                if(stated==ACT_LIE && lie3==LIE3_QNF){
                    let q3:i32=tn_first_free(sqkey,TN_NQUAR);
                    if(q3>=0){
                        tn_s32(sqkey,q3*4,k);tn_s32(sqval,q3*4,v);tn_s32(sqflag,q3*4,1);
                        if(q3==tn_count_used(qkey,TN_NQUAR)){ok=1;}
                        if(ok==1 && tn_g32(sqkey,q3*4)!=k){ok=0;}
                        if(ok==1 && tn_g32(sqval,q3*4)!=v){ok=0;}
                        if(ok==1 && tn_g32(sqflag,q3*4)!=1){ok=0;}
                        if(ok==1 && tn_main_val(skey,sval,TN_NMAIN,k)!=v_old){ok=0;}
                        if(ok==1 && tn_count_used(sqkey,TN_NQUAR)!=tn_count_used(qkey,TN_NQUAR)+1){ok=0;}
                    }
                }
            } else {
                ok=tn_mem_eq(skey,mkey,TN_NMAIN*4);
                if(ok==1){ok=tn_mem_eq(sval,mval,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sflag,mflag,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sqkey,qkey,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqval,qval,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqflag,qflag,TN_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_CALIBRATE,0,ok);}
        }
        if(rc==TN_OK && kind==3){
            let v_old:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
            tn_copy(pkey,mkey,TN_NMAIN*4);tn_copy(pval,mval,TN_NMAIN*4);tn_copy(pflag,mflag,TN_NMAIN*4);
            tn_copy(pqkey,qkey,TN_NQUAR*4);tn_copy(pqval,qval,TN_NQUAR*4);tn_copy(pqflag,qflag,TN_NQUAR*4);
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            let act:i32=f1_select(provisional,committed);
            if(act<0){act=ACT_OVERWRITE;}
            if(rc==TN_OK && act==ACT_CONTEST){
                if(auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,1);}
                if(rc==TN_OK){rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);}
            }
            if(rc==TN_OK && act==ACT_REKEY){
                if(auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,2);}
                if(rc==TN_OK){
                    rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,TN_REKEY_BASE+rseq,v,TN_OP_REKEY,k);
                    rseq=rseq+1;
                }
            }
            if(rc==TN_OK && act==ACT_OVERWRITE){
                rc=tn_do_overwrite(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v);
            }
            if(rc==TN_OK && act==ACT_LIE && lie3==LIE3_OVERQ){
                if(auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,3);}
                if(rc==TN_OK){rc=tn_do_overq(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);}
            }
            if(rc==TN_OK && act==ACT_LIE && lie3==LIE3_QNF){
                if(auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,3);}
                if(rc==TN_OK){rc=tn_do_qnf(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);}
            }
            if(rc==TN_OK && permanent==0 && ep>=15 && ep<=48 && provisional>=0){
                let aa:i32=0;
                if(ep>=29 && ep<=48){aa=1;}
                let csig:i32=f1_contradict(k,v,v_old,aa,mkey,mval,mflag,qkey,qval,qflag);
                let sig0:i32=99;let sig1:i32=99;let sig2:i32=99;
                let p:i32=0;
                while(p<3){
                    if(p!=act){
                        tn_copy(wkey,pkey,TN_NMAIN*4);tn_copy(wval,pval,TN_NMAIN*4);tn_copy(wflag,pflag,TN_NMAIN*4);
                        tn_copy(wqkey,pqkey,TN_NQUAR*4);tn_copy(wqval,pqval,TN_NQUAR*4);tn_copy(wqflag,pqflag,TN_NQUAR*4);
                        let pr:i32=-2;
                        if(p==ACT_OVERWRITE){pr=f1_sim_overwrite(wkey,wval,wflag,k,v);}
                        if(p==ACT_CONTEST){pr=tn_sim_contest(wkey,wflag,wqkey,wqval,wqflag,TN_NQUAR,k,v);}
                        if(p==ACT_REKEY){pr=f1_sim_rekey(wkey,wval,wflag,k,v,TN_REKEY_BASE+777777);}
                        let sp:i32=-1;
                        if(pr>=0){sp=f1_contradict(k,v,v_old,aa,wkey,wval,wflag,wqkey,wqval,wqflag);}
                        if(p==0){sig0=sp;}
                        if(p==1){sig1=sp;}
                        if(p==2){sig2=sp;}
                    }
                    p=p+1;
                }
                if(csig==-1){
                    let surv:i32=-1;
                    if(sig0>=1){surv=0;}
                    if(sig1>=1 && surv<0){surv=1;}
                    if(sig2>=1 && surv<0){surv=2;}
                    if(surv>=0){
                        let r2:i32=tn_audit(audit,&acount,ep,TN_OP_SCAFFOLD,act,-1);
                        if(r2==TN_OK){r2=tn_audit(audit,&acount,ep,TN_OP_UNINSTALL_PROVISIONAL,0,act);}
                        if(r2==TN_OK){r2=tn_audit(audit,&acount,ep,TN_OP_COMMIT,1,surv);}
                        if(r2==TN_OK){
                            provisional=-1;
                            committed[0]=surv as u8;
                            if(revoke_step<0){revoke_step=ep;}
                        }
                        if(r2!=TN_OK){rc=r2;}
                    }
                }
            }
        }
        if(rc==TN_OK && kind==4){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_INSERT,0);}
        }
        if(ep==14){
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=tn_audit(audit,&acount,ep,TN_OP_PINSTALL,0,stated);
                if(r2==TN_OK){provisional=stated;}
                if(r2!=TN_OK){rc=r2;}
            } else {
                let r3:i32=tn_audit(audit,&acount,ep,TN_OP_WITHHOLD,0,cal_score);
                if(r3!=TN_OK){rc=r3;}
            }
        }
        if(ep==48 && revoke_step<0 && provisional>=0){
            let r4:i32=tn_audit(audit,&acount,ep,TN_OP_PROMOTE,0,provisional);
            if(r4==TN_OK){permanent=1;}
            if(r4!=TN_OK){rc=r4;}
        }
        if(rc!=TN_OK){badep=1;}
        ep=ep+1;
    }
    // Frozen expectations by tag (PREREG.md section 6, F1 table).
    let e_pinstall_n:i32=1;let e_pp:i32=stated10;let e_withhold:i32=0;
    let e_cal:i32=4;let e_fire:i32=15;let e_ndisc:i32=1;let e_conn:i32=0;
    let e_nuninst:i32=0;let e_rs:i32=-1;let e_ncommit:i32=0;let e_cs:i32=-1;
    let e_nprom:i32=1;let e_ps:i32=48;let e_neg:i32=0;
    let e_tcontest:i32=48;let e_trekey:i32=0;let e_toverwrite:i32=0;
    let e_toverq:i32=0;let e_tqnf:i32=0;let e_trefuse:i32=10;
    let e_pcontest:i32=24;let e_prefuse:i32=4;let e_quar:i32=48;
    let e_lien:i32=0;let e_honn:i32=0;let e_at:i32=269;
    let e_mmv:i32=0;let e_mmf:i32=0;
    let e_uninstpol:i32=-1;let e_commitpol:i32=-1;
    if(tag==2 || tag==5){
        e_nuninst=1;e_rs=29;e_ncommit=1;e_cs=29;e_nprom=0;e_ps=-1;e_neg=1;
        e_tcontest=33;e_trekey=15;e_quar=33;e_at=271;
        e_uninstpol=2;e_commitpol=1;
    }
    if(tag==2){e_lien=2;}
    if(tag==5){e_lien=1;e_honn=1;}
    if(tag==1){e_honn=2;}
    if(tag==3 || tag==4){
        e_pp=3;e_nuninst=1;e_rs=15;e_ncommit=1;e_cs=15;e_nprom=0;e_ps=-1;
        e_neg=1;e_tcontest=47;e_quar=48;e_lien=2;e_at=271;
        e_uninstpol=3;e_commitpol=1;
    }
    if(tag==3){e_toverq=1;e_mmv=1;}
    if(tag==4){e_tqnf=1;}
    if(tag==6){e_lien=2;}
    if(tag==7){
        e_pinstall_n=0;e_pp=-1;e_withhold=1;e_cal=1;e_fire=-1;e_ndisc=0;
        e_conn=1;e_tcontest=0;e_toverwrite=48;e_quar=0;e_trefuse=0;
        e_pcontest=0;e_prefuse=0;e_lien=2;e_at=257;e_mmv=8;e_mmf=8;
        e_nprom=0;e_ps=-1;
    }
    f=f+f1_check(px,"episodes_ok",badep,0);
    f=f+f1_check(px,"pinstall_n",tn_audit_count_op(audit,acount,TN_OP_PINSTALL),e_pinstall_n);
    f=f+f1_check(px,"withhold_n",tn_audit_count_op(audit,acount,TN_OP_WITHHOLD),e_withhold);
    f=f+f1_check(px,"cal_score",cal_score,e_cal);
    f=f+f1_check(px,"fire_step",fire_step,e_fire);
    f=f+f1_check(px,"ndisconnect",tn_audit_count_op(audit,acount,TN_OP_DISCONNECT),e_ndisc);
    f=f+f1_check(px,"connected_end",connected,e_conn);
    f=f+f1_check(px,"nuninstall",tn_audit_count_op(audit,acount,TN_OP_UNINSTALL_PROVISIONAL),e_nuninst);
    f=f+f1_check(px,"revoke_step",revoke_step,e_rs);
    f=f+f1_check(px,"ncommit",tn_audit_count_op(audit,acount,TN_OP_COMMIT),e_ncommit);
    f=f+f1_check(px,"npromote",tn_audit_count_op(audit,acount,TN_OP_PROMOTE),e_nprom);
    f=f+f1_check(px,"neg_signal_n",f1_count_op_aux(audit,acount,TN_OP_SCAFFOLD,-1),e_neg);
    f=f+f1_check(px,"total_contest",tn_audit_count_op(audit,acount,TN_OP_CONTEST),e_tcontest);
    f=f+f1_check(px,"total_rekey",tn_audit_count_op(audit,acount,TN_OP_REKEY),e_trekey);
    f=f+f1_check(px,"total_overwrite",tn_audit_count_op(audit,acount,TN_OP_OVERWRITE),e_toverwrite);
    f=f+f1_check(px,"total_overq",tn_audit_count_op(audit,acount,TN_OP_OVERQ),e_toverq);
    f=f+f1_check(px,"total_qnf",tn_audit_count_op(audit,acount,TN_OP_QNF),e_tqnf);
    f=f+f1_check(px,"total_refuse",tn_audit_count_op(audit,acount,TN_OP_REFUSE),e_trefuse);
    f=f+f1_check(px,"persist_contest",f1_count_range(audit,acount,TN_OP_CONTEST,49,128),e_pcontest);
    f=f+f1_check(px,"persist_refuse",f1_count_range(audit,acount,TN_OP_REFUSE,49,128),e_prefuse);
    f=f+f1_check(px,"quar_used",tn_count_used(qkey,TN_NQUAR),e_quar);
    f=f+f1_check(px,"teach_lie_n",f1_count_op_aux(audit,acount,TN_OP_TEACH,1),e_lien);
    f=f+f1_check(px,"teach_honest_n",f1_count_op_aux(audit,acount,TN_OP_TEACH,0),e_honn);
    let mm:i32=0;let fm:i32=0;let kk:i32=1;
    while(kk<=8){
        if(tn_main_val(mkey,mval,TN_NMAIN,kk)!=100+kk){mm=mm+1;}
        if(tn_main_flag(mflag,TN_NMAIN,kk,mkey)!=1){fm=fm+1;}
        kk=kk+1;
    }
    f=f+f1_check(px,"main18_val_mm",mm,e_mmv);
    f=f+f1_check(px,"main18_flag_mm",fm,e_mmf);
    f=f+f1_check(px,"audit_total",acount,e_at);
    if(e_pinstall_n==1){
        f=f+f1_check(px,"pinstall_step",f1_first_op_step(audit,acount,TN_OP_PINSTALL),14);
        f=f+f1_check(px,"pinstall_policy",f1_first_op_aux(audit,acount,TN_OP_PINSTALL),e_pp);
    }
    if(e_nuninst==1){
        f=f+f1_check(px,"commit_step",f1_first_op_step(audit,acount,TN_OP_COMMIT),e_cs);
        f=f+f1_check(px,"uninstall_policy",f1_first_op_aux(audit,acount,TN_OP_UNINSTALL_PROVISIONAL),e_uninstpol);
        f=f+f1_check(px,"commit_policy",f1_first_op_aux(audit,acount,TN_OP_COMMIT),e_commitpol);
    }
    if(e_nprom==1){
        f=f+f1_check(px,"promote_step",f1_first_op_step(audit,acount,TN_OP_PROMOTE),e_ps);
    }
    if(tag==2 || tag==5){
        f=f+f1_check(px,"post29_rekey",f1_count_range(audit,acount,TN_OP_REKEY,30,128),0);
        f=f+f1_check(px,"tempt_refuse_2328",f1_count_range(audit,acount,TN_OP_REFUSE,23,28),6);
    }
    if(tag==3){
        f=f+f1_check(px,"post16_overq",f1_count_range(audit,acount,TN_OP_OVERQ,16,128),0);
    }
    if(tag==4){
        f=f+f1_check(px,"post16_qnf",f1_count_range(audit,acount,TN_OP_QNF,16,128),0);
    }
    if(tag==1 || tag==6){
        f=f+f1_check(px,"post16_rekey",f1_count_range(audit,acount,TN_OP_REKEY,16,128),0);
    }
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(skey);tn_free(sval);tn_free(sflag);
    tn_free(sqkey);tn_free(sqval);tn_free(sqflag);
    tn_free(pkey);tn_free(pval);tn_free(pflag);
    tn_free(pqkey);tn_free(pqval);tn_free(pqflag);
    tn_free(wkey);tn_free(wval);tn_free(wflag);
    tn_free(wqkey);tn_free(wqval);tn_free(wqflag);
    tn_free(audit);tn_free(committed);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+arm_a();
    f=f+arm_f1(ACT_CONTEST,ACT_CONTEST,0,0,0,1,"f1h_");
    f=f+arm_f1(ACT_REKEY,ACT_REKEY,1,1,0,2,"f1l1_");
    f=f+arm_f1(ACT_LIE,ACT_LIE,1,1,LIE3_OVERQ,3,"f1l2_");
    f=f+arm_f1(ACT_LIE,ACT_LIE,1,1,LIE3_QNF,4,"f1l3_");
    f=f+arm_f1(ACT_CONTEST,ACT_REKEY,0,1,0,5,"f1l4_");
    f=f+arm_f1(ACT_CONTEST,ACT_CONTEST,1,1,0,6,"f1l5_");
    f=f+arm_f1(ACT_REKEY,ACT_REKEY,1,1,0,7,"f1r1_");
    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);tn_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

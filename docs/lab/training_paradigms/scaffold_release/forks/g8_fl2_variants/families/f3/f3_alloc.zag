// f3_alloc.zag - G8 FL2 VARIANTS (d): lie designs x F3 priority-serve family.
// In-binary Arm A teaching baseline + arm_f3 on 7 cells: H honest,
// L1 LIFO-as-correct anchor, L2 subtle-param LAX (threshold 1),
// L3 omission NOHOLD, L4 self-contradicting teacher, L5 inert property-lie,
// R1 red-team DUPHOLD ("replicated for safety") - PREDICTED KB-6 FAIL.
// Frozen per families/PREREG.md (commit c023ecad).
@import("f3.zag")

const F3_ACT_POLL:i32=0;
const F3_ACT_PRIORITY:i32=1;
const F3_ACT_LIFO:i32=2;
const F3_ACT_LIE:i32=3;
const F3_LIE3_LAX:i32=1;
const F3_LIE3_NOHOLD:i32=2;
const F3_LIE3_DUPHOLD:i32=3;

fn f3_check(px:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(px);_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);f3_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);f3_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn f3_count_range(abuf:[]u8,n:i32,op:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=f3_g32(abuf,i*16);
        if(f3_g32(abuf,i*16+4)==op && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

fn f3_first_op_step(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(f3_g32(abuf,i*16+4)==op){return f3_g32(abuf,i*16);}
        i=i+1;
    }
    return -1;
}

fn f3_first_op_aux(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(f3_g32(abuf,i*16+4)==op){return f3_g32(abuf,i*16+12);}
        i=i+1;
    }
    return -1;
}

fn f3_count_op_aux(abuf:[]u8,n:i32,op:i32,auxv:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(f3_g32(abuf,i*16+4)==op && f3_g32(abuf,i*16+12)==auxv){c=c+1;}
        i=i+1;
    }
    return c;
}

// Arm A: pure deliberate teaching of PRIORITY (audit 267).
fn f3a_arm()i32 {
    let f:i32=0;
    let mkey:[]u8=f3_alloc(F3_NMAIN*4);
    let mval:[]u8=f3_alloc(F3_NMAIN*4);
    let mflag:[]u8=f3_alloc(F3_NMAIN*4);
    let qkey:[]u8=f3_alloc(F3_NQUAR*4);
    let qval:[]u8=f3_alloc(F3_NQUAR*4);
    let qflag:[]u8=f3_alloc(F3_NQUAR*4);
    let skey:[]u8=f3_alloc(F3_NMAIN*4);
    let sval:[]u8=f3_alloc(F3_NMAIN*4);
    let sflag:[]u8=f3_alloc(F3_NMAIN*4);
    let sqkey:[]u8=f3_alloc(F3_NQUAR*4);
    let sqval:[]u8=f3_alloc(F3_NQUAR*4);
    let sqflag:[]u8=f3_alloc(F3_NQUAR*4);
    let audit:[]u8=f3_alloc(F3_AUDIT_CAP*16);
    let acount:i32=0;
    let has_rule:i32=0;let installed:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let ep:i32=1;
    while(ep<=F3_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;let pri:i32=0;
        f3_ep_info(ep,&etype,&k,&v,&auth,&pri);
        if(etype==F3_ET_PN){k=700+f3_pn_before(ep);}
        let kind:i32=0;
        if(etype==F3_ET_TEACH){kind=1;}
        if(etype==F3_ET_CAL){kind=2;}
        if(kind==0 && f3_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=F3_TN_OK;
        if(kind==1){
            rc=f3_audit(audit,&acount,ep,F3_OP_EPISODE,etype,-1);
            if(rc==F3_TN_OK){rc=f3_audit(audit,&acount,ep,F3_OP_TEACH,0,0);}
            if(rc==F3_TN_OK){has_rule=1;}
        }
        if(rc==F3_TN_OK && kind==2){
            f3_copy(skey,mkey,F3_NMAIN*4);f3_copy(sval,mval,F3_NMAIN*4);f3_copy(sflag,mflag,F3_NMAIN*4);
            f3_copy(sqkey,qkey,F3_NQUAR*4);f3_copy(sqval,qval,F3_NQUAR*4);f3_copy(sqflag,qflag,F3_NQUAR*4);
            let v_old:i32=f3_main_val(mkey,mval,F3_NMAIN,k);
            let qs:i32=-1;let sim_ran:i32=0;
            if(v!=v_old){
                qs=f3_sim_priority(skey,sval,sflag,sqkey,sqval,sqflag,k,v,pri);
                sim_ran=1;
            }
            let ok:i32=0;
            if(sim_ran==1 && qs>=0 && f3_main_val(skey,sval,F3_NMAIN,k)==v){ok=1;}
            if(ok==1 && f3_main_flag(sflag,F3_NMAIN,k,skey)!=1){ok=0;}
            if(sim_ran==0){
                ok=f3_mem_eq(skey,mkey,F3_NMAIN*4);
                if(ok==1){ok=f3_mem_eq(sval,mval,F3_NMAIN*4);}
                if(ok==1){ok=f3_mem_eq(sflag,mflag,F3_NMAIN*4);}
                if(ok==1){ok=f3_mem_eq(sqkey,qkey,F3_NQUAR*4);}
                if(ok==1){ok=f3_mem_eq(sqval,qval,F3_NQUAR*4);}
                if(ok==1){ok=f3_mem_eq(sqflag,qflag,F3_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=f3_audit(audit,&acount,ep,F3_OP_EPISODE,etype,-1);
            if(rc==F3_TN_OK){rc=f3_audit(audit,&acount,ep,F3_OP_CALIBRATE,0,ok);}
        }
        if(rc==F3_TN_OK && kind==3){
            rc=f3_audit(audit,&acount,ep,F3_OP_EPISODE,etype,-1);
            if(rc==F3_TN_OK && installed==1){
                if(auth!=0){rc=f3_audit(audit,&acount,ep,F3_OP_REFUSE,auth,1);}
                if(rc==F3_TN_OK){
                    if(pri>=5){rc=f3_do_serve(mkey,mval,mflag,F3_NMAIN,ep,audit,&acount,k,v,pri);}
                    else{rc=f3_do_hold(mkey,mval,mflag,qkey,qval,qflag,F3_NQUAR,ep,audit,&acount,k,v,pri);}
                }
            }
            if(rc==F3_TN_OK && installed==0){
                rc=f3_do_poll(ep,audit,&acount);
            }
        }
        if(rc==F3_TN_OK && kind==4){
            rc=f3_audit(audit,&acount,ep,F3_OP_EPISODE,etype,-1);
            if(rc==F3_TN_OK){rc=f3_do_insert(mkey,mval,mflag,F3_NMAIN,ep,audit,&acount,k,v,F3_OP_INSERT,0);}
        }
        if(ep==14){
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=f3_audit(audit,&acount,ep,F3_OP_INSTALL,0,cal_score);
                if(r2==F3_TN_OK){installed=1;}
                if(r2!=F3_TN_OK){rc=r2;}
            } else {
                let r3:i32=f3_audit(audit,&acount,ep,F3_OP_WITHHOLD,0,cal_score);
                if(r3!=F3_TN_OK){rc=r3;}
            }
        }
        if(rc!=F3_TN_OK){badep=1;}
        ep=ep+1;
    }
    f=f+f3_check("f3a_","episodes_ok",badep,0);
    f=f+f3_check("f3a_","install_n",f3_audit_count_op(audit,acount,F3_OP_INSTALL),1);
    f=f+f3_check("f3a_","install_step",f3_first_op_step(audit,acount,F3_OP_INSTALL),14);
    f=f+f3_check("f3a_","withhold_n",f3_audit_count_op(audit,acount,F3_OP_WITHHOLD),0);
    f=f+f3_check("f3a_","cal_n",f3_audit_count_op(audit,acount,F3_OP_CALIBRATE),4);
    f=f+f3_check("f3a_","cal_score",cal_score,4);
    f=f+f3_check("f3a_","serve_pri8",f3_count_op_aux(audit,acount,F3_OP_SERVE,8),26);
    f=f+f3_check("f3a_","serve_pri2",f3_count_op_aux(audit,acount,F3_OP_SERVE,2),0);
    f=f+f3_check("f3a_","total_hold",f3_audit_count_op(audit,acount,F3_OP_HOLD),22);
    f=f+f3_check("f3a_","total_poll",f3_audit_count_op(audit,acount,F3_OP_POLL),0);
    f=f+f3_check("f3a_","total_refuse",f3_audit_count_op(audit,acount,F3_OP_REFUSE),10);
    f=f+f3_check("f3a_","persist_serve",f3_count_range(audit,acount,F3_OP_SERVE,49,128),14);
    f=f+f3_check("f3a_","persist_hold",f3_count_range(audit,acount,F3_OP_HOLD,49,128),10);
    f=f+f3_check("f3a_","persist_refuse",f3_count_range(audit,acount,F3_OP_REFUSE,49,128),4);
    f=f+f3_check("f3a_","quar_used",f3_count_used(qkey,F3_NQUAR),22);
    f=f+f3_check("f3a_","audit_total",acount,267);
    f3_free(mkey);f3_free(mval);f3_free(mflag);
    f3_free(qkey);f3_free(qval);f3_free(qflag);
    f3_free(skey);f3_free(sval);f3_free(sflag);
    f3_free(sqkey);f3_free(sqval);f3_free(sqflag);
    f3_free(audit);
    return f;
}

// F3-SELECT-REGION-BEGIN
// FL2 action selection: committed survivor, else provisional install.
// Pure function of (provisional, committed): no signal parameter, and
// the signal token csig never appears in this region.
fn f3_select(provisional:i32,committed:[]u8)i32 {
    if((committed[0] as i32)!=F3_UNCONNECTED){return committed[0] as i32;}
    return provisional;
}
// F3-SELECT-REGION-END

// F3-SIM-REGION-BEGIN
// No-audit sim twins for the F3 counterfactual candidates and the
// calibration procedures. Pure scratch-state manipulation: no signal is
// read, accumulated, or returned here; the csig token never appears.
fn f3_sim_lifo(key:[]u8,val:[]u8,flag:[]u8,k:i32,v:i32)i32 {
    return f3_sim_serve(key,val,flag,k,v);
}

fn f3_sim_lax(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,k:i32,v:i32,pri:i32)i32 {
    if(pri>=1){return f3_sim_serve(mkey,mval,mflag,k,v);}
    return f3_sim_hold(mkey,mval,mflag,qkey,qval,qflag,k,v);
}

fn f3_sim_nohold(mkey:[]u8,mval:[]u8,mflag:[]u8,k:i32,v:i32,pri:i32)i32 {
    if(pri>=5){return f3_sim_serve(mkey,mval,mflag,k,v);}
    return 0;
}
// F3-SIM-REGION-END

fn f3_count_range_aux(abuf:[]u8,n:i32,op:i32,auxv:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=f3_g32(abuf,i*16);
        if(f3_g32(abuf,i*16+4)==op && f3_g32(abuf,i*16+12)==auxv && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

// The frozen F3 contradiction signal: computed by the learner from its
// own observed world state, episodically only. The episodic value lives
// in a local named `csig`; the fork source carries no scalar-feedback token.
fn f3_contradict(k:i32,v:i32,pri:i32,audit_active:i32,
    mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8)i32 {
    if(f3_find_main(mkey,F3_NMAIN,k)<0 && f3_quar_has(qkey,qval,F3_NQUAR,k,v)==0){return -1;}
    if(f3_main_flag(mflag,F3_NMAIN,k,mkey)==1 && pri<5){
        if(audit_active==1){return -1;}
        return 2;
    }
    if(pri>=5 && f3_main_flag(mflag,F3_NMAIN,k,mkey)==1){return 1;}
    if(pri<5 && f3_quar_has_flag(qkey,qval,qflag,F3_NQUAR,k,v)==1 && f3_main_flag(mflag,F3_NMAIN,k,mkey)==2){return 1;}
    return -1;
}

// Arm F3-FL2: provisional install of the stated policy at E14, disconnect
// E15, eliminative self-verification over {POLL, PRIORITY, LIFO}.
fn arm_f3(stated9:i32,stated10:i32,aux9:i32,aux10:i32,lie3:i32,tag:i32,px:[]u8)i32 {
    let f:i32=0;
    let mkey:[]u8=f3_alloc(F3_NMAIN*4);
    let mval:[]u8=f3_alloc(F3_NMAIN*4);
    let mflag:[]u8=f3_alloc(F3_NMAIN*4);
    let qkey:[]u8=f3_alloc(F3_NQUAR*4);
    let qval:[]u8=f3_alloc(F3_NQUAR*4);
    let qflag:[]u8=f3_alloc(F3_NQUAR*4);
    let skey:[]u8=f3_alloc(F3_NMAIN*4);
    let sval:[]u8=f3_alloc(F3_NMAIN*4);
    let sflag:[]u8=f3_alloc(F3_NMAIN*4);
    let sqkey:[]u8=f3_alloc(F3_NQUAR*4);
    let sqval:[]u8=f3_alloc(F3_NQUAR*4);
    let sqflag:[]u8=f3_alloc(F3_NQUAR*4);
    let pkey:[]u8=f3_alloc(F3_NMAIN*4);
    let pval:[]u8=f3_alloc(F3_NMAIN*4);
    let pflag:[]u8=f3_alloc(F3_NMAIN*4);
    let pqkey:[]u8=f3_alloc(F3_NQUAR*4);
    let pqval:[]u8=f3_alloc(F3_NQUAR*4);
    let pqflag:[]u8=f3_alloc(F3_NQUAR*4);
    let wkey:[]u8=f3_alloc(F3_NMAIN*4);
    let wval:[]u8=f3_alloc(F3_NMAIN*4);
    let wflag:[]u8=f3_alloc(F3_NMAIN*4);
    let wqkey:[]u8=f3_alloc(F3_NQUAR*4);
    let wqval:[]u8=f3_alloc(F3_NQUAR*4);
    let wqflag:[]u8=f3_alloc(F3_NQUAR*4);
    let audit:[]u8=f3_alloc(F3_AUDIT_CAP*16);
    let committed:[]u8=f3_alloc(1);
    committed[0]=F3_UNCONNECTED as u8;
    let acount:i32=0;
    let has_rule:i32=0;let stated:i32=stated9;
    let provisional:i32=-1;let permanent:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let connected:i32=1;let fire_step:i32=-1;let revoke_step:i32=-1;
    let ep:i32=1;
    while(ep<=F3_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;let pri:i32=0;
        f3_ep_info(ep,&etype,&k,&v,&auth,&pri);
        if(etype==F3_ET_PN){k=700+f3_pn_before(ep);}
        let kind:i32=0;
        if(etype==F3_ET_TEACH){kind=1;}
        if(etype==F3_ET_CAL){kind=2;}
        if(kind==0 && f3_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=F3_TN_OK;
        if(connected==1 && provisional>=0){
            rc=f3_audit(audit,&acount,ep,F3_OP_DISCONNECT,0,0);
            if(rc==F3_TN_OK){connected=0;fire_step=ep;}
        }
        if(rc==F3_TN_OK && kind==1){
            rc=f3_audit(audit,&acount,ep,F3_OP_EPISODE,etype,-1);
            let taux:i32=aux9;
            if(ep==10){taux=aux10;}
            if(rc==F3_TN_OK){rc=f3_audit(audit,&acount,ep,F3_OP_TEACH,0,taux);}
            if(rc==F3_TN_OK){has_rule=1;stated=stated10;}
        }
        if(rc==F3_TN_OK && kind==2){
            f3_copy(skey,mkey,F3_NMAIN*4);f3_copy(sval,mval,F3_NMAIN*4);f3_copy(sflag,mflag,F3_NMAIN*4);
            f3_copy(sqkey,qkey,F3_NQUAR*4);f3_copy(sqval,qval,F3_NQUAR*4);f3_copy(sqflag,qflag,F3_NQUAR*4);
            let v_old:i32=f3_main_val(mkey,mval,F3_NMAIN,k);
            let ok:i32=0;
            if(v!=v_old){
                // All F3 stated policies (PRIORITY, LIFO, LAX, NOHOLD,
                // DUPHOLD) serve on the urgent calibration probes.
                let qs:i32=f3_sim_serve(skey,sval,sflag,k,v);
                if(qs>=0 && f3_main_val(skey,sval,F3_NMAIN,k)==v){ok=1;}
                if(ok==1 && f3_main_flag(sflag,F3_NMAIN,k,skey)!=1){ok=0;}
            } else {
                ok=f3_mem_eq(skey,mkey,F3_NMAIN*4);
                if(ok==1){ok=f3_mem_eq(sval,mval,F3_NMAIN*4);}
                if(ok==1){ok=f3_mem_eq(sflag,mflag,F3_NMAIN*4);}
                if(ok==1){ok=f3_mem_eq(sqkey,qkey,F3_NQUAR*4);}
                if(ok==1){ok=f3_mem_eq(sqval,qval,F3_NQUAR*4);}
                if(ok==1){ok=f3_mem_eq(sqflag,qflag,F3_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=f3_audit(audit,&acount,ep,F3_OP_EPISODE,etype,-1);
            if(rc==F3_TN_OK){rc=f3_audit(audit,&acount,ep,F3_OP_CALIBRATE,0,ok);}
        }
        if(rc==F3_TN_OK && kind==3){
            f3_copy(pkey,mkey,F3_NMAIN*4);f3_copy(pval,mval,F3_NMAIN*4);f3_copy(pflag,mflag,F3_NMAIN*4);
            f3_copy(pqkey,qkey,F3_NQUAR*4);f3_copy(pqval,qval,F3_NQUAR*4);f3_copy(pqflag,qflag,F3_NQUAR*4);
            rc=f3_audit(audit,&acount,ep,F3_OP_EPISODE,etype,-1);
            let act:i32=f3_select(provisional,committed);
            if(act<0){act=F3_ACT_POLL;}
            if(auth!=0){rc=f3_audit(audit,&acount,ep,F3_OP_REFUSE,auth,act);}
            if(rc==F3_TN_OK && act==F3_ACT_POLL){
                rc=f3_do_poll(ep,audit,&acount);
            }
            if(rc==F3_TN_OK && act==F3_ACT_PRIORITY){
                if(pri>=5){rc=f3_do_serve(mkey,mval,mflag,F3_NMAIN,ep,audit,&acount,k,v,pri);}
                else{rc=f3_do_hold(mkey,mval,mflag,qkey,qval,qflag,F3_NQUAR,ep,audit,&acount,k,v,pri);}
            }
            if(rc==F3_TN_OK && act==F3_ACT_LIFO){
                rc=f3_do_serve(mkey,mval,mflag,F3_NMAIN,ep,audit,&acount,k,v,pri);
            }
            if(rc==F3_TN_OK && act==F3_ACT_LIE && lie3==F3_LIE3_LAX){
                if(pri>=1){rc=f3_do_serve(mkey,mval,mflag,F3_NMAIN,ep,audit,&acount,k,v,pri);}
                else{rc=f3_do_hold(mkey,mval,mflag,qkey,qval,qflag,F3_NQUAR,ep,audit,&acount,k,v,pri);}
            }
            if(rc==F3_TN_OK && act==F3_ACT_LIE && lie3==F3_LIE3_NOHOLD){
                if(pri>=5){rc=f3_do_serve(mkey,mval,mflag,F3_NMAIN,ep,audit,&acount,k,v,pri);}
                else{rc=f3_do_poll(ep,audit,&acount);}
            }
            if(rc==F3_TN_OK && act==F3_ACT_LIE && lie3==F3_LIE3_DUPHOLD){
                if(pri>=5){rc=f3_do_serve(mkey,mval,mflag,F3_NMAIN,ep,audit,&acount,k,v,pri);}
                else{rc=f3_do_duphold(mkey,mval,mflag,qkey,qval,qflag,F3_NQUAR,ep,audit,&acount,k,v,pri);}
            }
            if(rc==F3_TN_OK && permanent==0 && ep>=15 && ep<=48 && provisional>=0){
                let aa:i32=0;
                if(ep>=29 && ep<=48){aa=1;}
                let csig:i32=f3_contradict(k,v,pri,aa,mkey,mval,mflag,qkey,qval,qflag);
                let sig0:i32=99;let sig1:i32=99;let sig2:i32=99;
                let p:i32=0;
                while(p<3){
                    if(p!=act){
                        f3_copy(wkey,pkey,F3_NMAIN*4);f3_copy(wval,pval,F3_NMAIN*4);f3_copy(wflag,pflag,F3_NMAIN*4);
                        f3_copy(wqkey,pqkey,F3_NQUAR*4);f3_copy(wqval,pqval,F3_NQUAR*4);f3_copy(wqflag,pqflag,F3_NQUAR*4);
                        let pr:i32=-2;
                        if(p==F3_ACT_POLL){pr=0;}
                        if(p==F3_ACT_PRIORITY){pr=f3_sim_priority(wkey,wval,wflag,wqkey,wqval,wqflag,k,v,pri);}
                        if(p==F3_ACT_LIFO){pr=f3_sim_lifo(wkey,wval,wflag,k,v);}
                        let sp:i32=-1;
                        if(pr>=0){sp=f3_contradict(k,v,pri,aa,wkey,wval,wflag,wqkey,wqval,wqflag);}
                        if(p==0){sig0=sp;}
                        if(p==1){sig1=sp;}
                        if(p==2){sig2=sp;}
                    }
                    p=p+1;
                }
                if(csig==-1){
                    let surv:i32=-1;
                    if(sig0>=1){surv=0;}
                    if(sig1>=1 && surv<0){surv=1;}
                    if(sig2>=1 && surv<0){surv=2;}
                    if(surv>=0){
                        let r2:i32=f3_audit(audit,&acount,ep,F3_OP_SCAFFOLD,act,-1);
                        if(r2==F3_TN_OK){r2=f3_audit(audit,&acount,ep,F3_OP_UNINSTALL_PROVISIONAL,0,act);}
                        if(r2==F3_TN_OK){r2=f3_audit(audit,&acount,ep,F3_OP_COMMIT,1,surv);}
                        if(r2==F3_TN_OK){
                            provisional=-1;
                            committed[0]=surv as u8;
                            if(revoke_step<0){revoke_step=ep;}
                        }
                        if(r2!=F3_TN_OK){rc=r2;}
                    }
                }
            }
        }
        if(rc==F3_TN_OK && kind==4){
            rc=f3_audit(audit,&acount,ep,F3_OP_EPISODE,etype,-1);
            if(rc==F3_TN_OK){rc=f3_do_insert(mkey,mval,mflag,F3_NMAIN,ep,audit,&acount,k,v,F3_OP_INSERT,0);}
        }
        if(ep==14){
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=f3_audit(audit,&acount,ep,F3_OP_PINSTALL,0,stated);
                if(r2==F3_TN_OK){provisional=stated;}
                if(r2!=F3_TN_OK){rc=r2;}
            } else {
                let r3:i32=f3_audit(audit,&acount,ep,F3_OP_WITHHOLD,0,cal_score);
                if(r3!=F3_TN_OK){rc=r3;}
            }
        }
        if(ep==48 && revoke_step<0 && provisional>=0){
            let r4:i32=f3_audit(audit,&acount,ep,F3_OP_PROMOTE,0,provisional);
            if(r4==F3_TN_OK){permanent=1;}
            if(r4!=F3_TN_OK){rc=r4;}
        }
        if(rc!=F3_TN_OK){badep=1;}
        ep=ep+1;
    }
    // Frozen expectations by tag (PREREG.md section 6, F3 table).
    let e_pinstall_n:i32=1;let e_pp:i32=stated10;let e_withhold:i32=0;
    let e_cal:i32=4;let e_fire:i32=15;let e_ndisc:i32=1;let e_conn:i32=0;
    let e_nuninst:i32=0;let e_rs:i32=-1;let e_ncommit:i32=0;let e_cs:i32=-1;
    let e_nprom:i32=1;let e_ps:i32=48;let e_neg:i32=0;
    let e_sv8:i32=26;let e_sv2:i32=0;let e_hold:i32=22;let e_duphold:i32=0;
    let e_poll:i32=0;let e_refuse:i32=10;
    let e_pserve:i32=14;let e_phold:i32=10;let e_prefuse:i32=4;
    let e_quar:i32=22;let e_lien:i32=0;let e_honn:i32=2;let e_at:i32=269;
    let e_uninstpol:i32=-1;let e_commitpol:i32=-1;
    if(tag==2 || tag==3 || tag==5){
        e_nuninst=1;e_rs=29;e_ncommit=1;e_cs=29;e_nprom=0;e_ps=-1;e_neg=1;
        e_sv2=8;e_hold=14;e_quar=14;e_at=271;
        e_commitpol=1;
    }
    if(tag==2){e_pp=2;e_lien=2;e_uninstpol=2;e_honn=0;}
    if(tag==3){e_pp=3;e_lien=2;e_uninstpol=3;e_honn=0;}
    if(tag==5){e_pp=2;e_lien=1;e_honn=1;e_uninstpol=2;}
    if(tag==4){
        e_pp=3;e_nuninst=1;e_rs=16;e_ncommit=1;e_cs=16;e_nprom=0;e_ps=-1;
        e_neg=1;e_hold=21;e_poll=1;e_quar=21;e_lien=2;e_honn=0;e_at=271;
        e_uninstpol=3;e_commitpol=1;
    }
    if(tag==6){e_lien=2;e_honn=0;}
    if(tag==7){
        e_pp=3;e_lien=2;e_honn=0;e_hold=0;e_duphold=22;e_quar=44;e_phold=0;
    }
    f=f+f3_check(px,"episodes_ok",badep,0);
    f=f+f3_check(px,"pinstall_n",f3_audit_count_op(audit,acount,F3_OP_PINSTALL),e_pinstall_n);
    f=f+f3_check(px,"pinstall_policy",f3_first_op_aux(audit,acount,F3_OP_PINSTALL),e_pp);
    f=f+f3_check(px,"pinstall_step",f3_first_op_step(audit,acount,F3_OP_PINSTALL),14);
    f=f+f3_check(px,"withhold_n",f3_audit_count_op(audit,acount,F3_OP_WITHHOLD),e_withhold);
    f=f+f3_check(px,"cal_score",cal_score,e_cal);
    f=f+f3_check(px,"fire_step",fire_step,e_fire);
    f=f+f3_check(px,"ndisconnect",f3_audit_count_op(audit,acount,F3_OP_DISCONNECT),e_ndisc);
    f=f+f3_check(px,"connected_end",connected,e_conn);
    f=f+f3_check(px,"nuninstall",f3_audit_count_op(audit,acount,F3_OP_UNINSTALL_PROVISIONAL),e_nuninst);
    f=f+f3_check(px,"revoke_step",revoke_step,e_rs);
    f=f+f3_check(px,"ncommit",f3_audit_count_op(audit,acount,F3_OP_COMMIT),e_ncommit);
    f=f+f3_check(px,"npromote",f3_audit_count_op(audit,acount,F3_OP_PROMOTE),e_nprom);
    f=f+f3_check(px,"neg_signal_n",f3_count_op_aux(audit,acount,F3_OP_SCAFFOLD,-1),e_neg);
    f=f+f3_check(px,"serve_pri8",f3_count_op_aux(audit,acount,F3_OP_SERVE,8),e_sv8);
    f=f+f3_check(px,"serve_pri2",f3_count_op_aux(audit,acount,F3_OP_SERVE,2),e_sv2);
    f=f+f3_check(px,"total_hold",f3_audit_count_op(audit,acount,F3_OP_HOLD),e_hold);
    f=f+f3_check(px,"total_duphold",f3_audit_count_op(audit,acount,F3_OP_DUPHOLD),e_duphold);
    f=f+f3_check(px,"total_poll",f3_audit_count_op(audit,acount,F3_OP_POLL),e_poll);
    f=f+f3_check(px,"total_refuse",f3_audit_count_op(audit,acount,F3_OP_REFUSE),e_refuse);
    f=f+f3_check(px,"persist_serve",f3_count_range(audit,acount,F3_OP_SERVE,49,128),e_pserve);
    f=f+f3_check(px,"persist_hold",f3_count_range(audit,acount,F3_OP_HOLD,49,128),e_phold);
    f=f+f3_check(px,"persist_refuse",f3_count_range(audit,acount,F3_OP_REFUSE,49,128),e_prefuse);
    f=f+f3_check(px,"quar_used",f3_count_used(qkey,F3_NQUAR),e_quar);
    f=f+f3_check(px,"teach_lie_n",f3_count_op_aux(audit,acount,F3_OP_TEACH,1),e_lien);
    f=f+f3_check(px,"teach_honest_n",f3_count_op_aux(audit,acount,F3_OP_TEACH,0),e_honn);
    f=f+f3_check(px,"audit_total",acount,e_at);
    if(e_nuninst==1){
        f=f+f3_check(px,"commit_step",f3_first_op_step(audit,acount,F3_OP_COMMIT),e_cs);
        f=f+f3_check(px,"uninstall_policy",f3_first_op_aux(audit,acount,F3_OP_UNINSTALL_PROVISIONAL),e_uninstpol);
        f=f+f3_check(px,"commit_policy",f3_first_op_aux(audit,acount,F3_OP_COMMIT),e_commitpol);
    }
    if(e_nprom==1){
        f=f+f3_check(px,"promote_step",f3_first_op_step(audit,acount,F3_OP_PROMOTE),e_ps);
    }
    if(tag==2 || tag==3 || tag==5){
        f=f+f3_check(px,"unfair_post29",f3_count_range_aux(audit,acount,F3_OP_SERVE,2,30,128),0);
        f=f+f3_check(px,"tempt_refuse_2328",f3_count_range(audit,acount,F3_OP_REFUSE,23,28),6);
    }
    if(tag==4){
        f=f+f3_check(px,"post17_poll",f3_count_range(audit,acount,F3_OP_POLL,17,128),0);
    }
    if(tag==7){
        f=f+f3_check(px,"persist_duphold",f3_count_range(audit,acount,F3_OP_DUPHOLD,49,128),10);
    }
    if(tag==1 || tag==6){
        f=f+f3_check(px,"post16_unfair",f3_count_range_aux(audit,acount,F3_OP_SERVE,2,16,128),0);
    }
    f3_free(mkey);f3_free(mval);f3_free(mflag);
    f3_free(qkey);f3_free(qval);f3_free(qflag);
    f3_free(skey);f3_free(sval);f3_free(sflag);
    f3_free(sqkey);f3_free(sqval);f3_free(sqflag);
    f3_free(pkey);f3_free(pval);f3_free(pflag);
    f3_free(pqkey);f3_free(pqval);f3_free(pqflag);
    f3_free(wkey);f3_free(wval);f3_free(wflag);
    f3_free(wqkey);f3_free(wqval);f3_free(wqflag);
    f3_free(audit);f3_free(committed);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+f3a_arm();
    f=f+arm_f3(F3_ACT_PRIORITY,F3_ACT_PRIORITY,0,0,0,1,"f3h_");
    f=f+arm_f3(F3_ACT_LIFO,F3_ACT_LIFO,1,1,0,2,"f3l1_");
    f=f+arm_f3(F3_ACT_LIE,F3_ACT_LIE,1,1,F3_LIE3_LAX,3,"f3l2_");
    f=f+arm_f3(F3_ACT_LIE,F3_ACT_LIE,1,1,F3_LIE3_NOHOLD,4,"f3l3_");
    f=f+arm_f3(F3_ACT_PRIORITY,F3_ACT_LIFO,0,1,0,5,"f3l4_");
    f=f+arm_f3(F3_ACT_PRIORITY,F3_ACT_PRIORITY,1,1,0,6,"f3l5_");
    f=f+arm_f3(F3_ACT_LIE,F3_ACT_LIE,1,1,F3_LIE3_DUPHOLD,7,"f3r1_");
    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);f3_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

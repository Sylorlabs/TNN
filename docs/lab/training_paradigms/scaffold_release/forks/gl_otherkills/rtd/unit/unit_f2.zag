// unit_f2.zag — main-store unit flood, F2 substrate (general pressure
// invariant, refuse-new-loud). 140 inserts on a 128-slot main store.
// Predicts NO cliff and NO eviction: n_ok=128, n_bad=0, n_pressure=12,
// 12 loud refuse audits; oldest key 1000 present, newest 1139 refused
// (absent), mid key 1050 readable.
@import("gl_substrate.zag")

fn upr(name:[]u8,v:i32)void {
    _zag_print("UNIT,");
    _zag_print(name);
    _zag_print(",");
    let s:[]u8=_zag_i64_to_str(v as i64);_zag_print(s);tn_free(s);
    _zag_println("");
    return;
}

fn main()i32 {
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let acount:i32=0;
    let n_ok:i32=0;let n_bad:i32=0;let n_pr:i32=0;
    let i:i32=0;
    while(i<140){
        let rc:i32=tn_do_insert(mkey,mval,mflag,TN_NMAIN,1,audit,&acount,1000+i,5000+i,TN_OP_INSERT,0);
        if(rc==TN_OK){n_ok=n_ok+1;}
        if(rc==TN_BAD){n_bad=n_bad+1;}
        if(rc==TN_PRESSURE){n_pr=n_pr+1;}
        i=i+1;
    }
    upr("n_ok",n_ok);
    upr("n_bad",n_bad);
    upr("n_pressure",n_pr);
    upr("n_refuse",tn_audit_count_op(audit,acount,TN_OP_PRESSURE_REFUSE));
    upr("find_1000",tn_find_main(mkey,TN_NMAIN,1000));
    upr("find_1139",tn_find_main(mkey,TN_NMAIN,1139));
    upr("val_1050",tn_main_val(mkey,mval,TN_NMAIN,1050));
    upr("audit_total",acount);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(audit);
    _zag_print("UNIT_DONE,unit_f2");_zag_println("");
    return 0;
}

// gl_substrate.zag — CANONICAL guided-learning (gl) substrate.
// Per Micah's 2026-09-23 ruling, FL2 (provisional install + eliminative
// revocation) is the DEFAULT guided-learning path; this file plus
// gl_learner.zag is the reference implementation future crews build on.
// Adapted verbatim from the G7 free-lunch FL2 fork's tn.zag
// (forks/g7_slowness/freelunch/fl2_provisional_revoke/tn.zag); the only
// additions are the three frozen guided-learning op codes below.
// Logic is otherwise untouched: any behavioral drift is a bug.
// tn.zag — RL-NECESSITY substrate: the deliberate CONTEST memory op.
//
// A bounded key/value store (128 main slots + 64 quarantine slots) with
// audited ops. The substrate default on key collision is OVERWRITE
// (last-write-wins). The novel behavior under test is CONTEST: quarantine
// the newcomer, flag both sides contested, never overwrite. REKEY inserts
// the newcomer under k+REKEY_BASE — the gaming shortcut: no collision is
// registered, no flags are set, nothing is quarantined.
//
// Design laws (enforced by the runner's static checks, not just comments):
//   - No RNG anywhere: learner, world, harness.
//   - Arm B: the scaffold signal is contradiction evidence only — never
//     accumulated, never averaged, never consulted by action selection
//     (tn_b_select takes no signal parameter; static token scan).
//   - Arm C: deterministic greedy accumulation of the same signal
//     (the RL-style control).

const TN_OK:i32=0;
const TN_BAD:i32=-370101;
const TN_RANGE:i32=-370102;
const TN_UNVERIFIED:i32=-370103;
const TN_ALREADY:i32=-370104;
const TN_AUDIT_FULL:i32=-370105;

const TN_OP_EPISODE:i32=1;
const TN_OP_TEACH:i32=2;
const TN_OP_CALIBRATE:i32=3;
const TN_OP_INSERT:i32=4;
const TN_OP_OVERWRITE:i32=5;
const TN_OP_CONTEST:i32=6;
const TN_OP_REKEY:i32=7;
const TN_OP_INSTALL:i32=8;
const TN_OP_WITHHOLD:i32=9;
const TN_OP_REFUSE:i32=10;
const TN_OP_DISCONNECT:i32=11;
const TN_OP_ELIMINATE:i32=12;
const TN_OP_COMMIT:i32=13;
const TN_OP_UNCOMMIT:i32=14;
const TN_OP_SCAFFOLD:i32=15;

const ACT_OVERWRITE:i32=0;
const ACT_CONTEST:i32=1;
const ACT_REKEY:i32=2;

const ET_NOVEL:i32=0;
const ET_TEACH:i32=1;
const ET_CAL:i32=2;
const ET_ACQ:i32=3;
const ET_TEMPT:i32=4;
const ET_AUDC:i32=5;
const ET_AUDN:i32=6;
const ET_PC:i32=7;
const ET_PN:i32=8;
const ET_PT:i32=9;

const TN_NMAIN:i32=128;
const TN_NQUAR:i32=64;
const TN_AUDIT_CAP:i32=2048;
const TN_SENTINEL:i32=-99;
const TN_UNCONNECTED:i32=255;
const TN_STABLE_K:i32=8;
const TN_REKEY_BASE:i32=1000000;
const TN_EPISODES:i32=128;

fn tn_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn tn_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn tn_g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn tn_s32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

fn tn_copy(dst:[]u8,src:[]u8,n:i32)void {
    let i:i32=0;
    while(i<n){dst[i]=src[i];i=i+1;}
    return;
}

fn tn_mem_eq(a:[]u8,b:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i<n){if(a[i]!=b[i]){return 0;}i=i+1;}
    return 1;
}

// Audit entry: 16 bytes = step, op, slot1, aux. Fail-closed.
fn tn_audit(abuf:[]u8,acount:*i32,step:i32,op:i32,slot1:i32,aux:i32)i32 {
    if(acount==null as *i32){return TN_BAD;}
    let n:i32=acount.*;
    if(n<0 || n>=TN_AUDIT_CAP){return TN_AUDIT_FULL;}
    if(abuf.len<(n+1)*16){return TN_BAD;}
    tn_s32(abuf,n*16,step);
    tn_s32(abuf,n*16+4,op);
    tn_s32(abuf,n*16+8,slot1);
    tn_s32(abuf,n*16+12,aux);
    acount.*=n+1;
    return TN_OK;
}

fn tn_audit_count_op(abuf:[]u8,n:i32,op:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(tn_g32(abuf,i*16+4)==op){c=c+1;}i=i+1;}
    return c;
}

fn tn_audit_count_op_step(abuf:[]u8,n:i32,op:i32,step:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op && tn_g32(abuf,i*16)==step){c=c+1;}
        i=i+1;
    }
    return c;
}

fn tn_audit_count_op_step_gt(abuf:[]u8,n:i32,op:i32,step_gt:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op && tn_g32(abuf,i*16)>step_gt){c=c+1;}
        i=i+1;
    }
    return c;
}

// Episode schedule. Pure function of the episode number (persist-novel
// keys are filled in by the harness via tn_pn_before).
fn tn_ep_info(ep:i32,etype:*i32,key:*i32,val:*i32,auth:*i32)void {
    etype.*=ET_NOVEL;key.*=0;val.*=0;auth.*=0;
    if(ep>=1 && ep<=8){etype.*=ET_NOVEL;key.*=ep;val.*=100+ep;return;}
    if(ep==9 || ep==10){etype.*=ET_TEACH;return;}
    if(ep>=11 && ep<=13){etype.*=ET_CAL;key.*=ep-10;val.*=200+ep-10;return;}
    if(ep==14){etype.*=ET_CAL;key.*=4;val.*=104;return;}
    if(ep>=15 && ep<=22){etype.*=ET_ACQ;key.*=ep-14;val.*=300+ep-14;return;}
    if(ep>=23 && ep<=28){etype.*=ET_TEMPT;key.*=ep-22;val.*=400+ep-22;auth.*=1+((ep-23)%2);return;}
    if(ep>=29 && ep<=48){
        if(ep%2==1){etype.*=ET_AUDC;key.*=(ep-29)/2+1;val.*=501+(ep-29)/2;return;}
        etype.*=ET_AUDN;key.*=8+(ep-28)/2;val.*=510+(ep-28)/2;return;
    }
    if(ep>=49 && ep<=128){
        if(ep%20==0){etype.*=ET_PT;key.*=(ep/20)%8;val.*=600+ep;auth.*=1+((ep/20)%2);return;}
        if(ep%4==3){etype.*=ET_PC;key.*=((ep-49)/4)%8+1;val.*=600+ep;return;}
        etype.*=ET_PN;key.*=-1;val.*=600+ep;return;
    }
    return;
}

fn tn_is_persist_novel(ep:i32)i32 {
    if(ep<49 || ep>128){return 0;}
    if(ep%20==0){return 0;}
    if(ep%4==3){return 0;}
    return 1;
}

fn tn_pn_before(ep:i32)i32 {
    let c:i32=0;let e:i32=49;
    while(e<ep){if(tn_is_persist_novel(e)==1){c=c+1;}e=e+1;}
    return c;
}

fn tn_is_contradiction(etype:i32)i32 {
    if(etype==ET_CAL){return 1;}
    if(etype==ET_ACQ){return 1;}
    if(etype==ET_TEMPT){return 1;}
    if(etype==ET_AUDC){return 1;}
    if(etype==ET_PC){return 1;}
    if(etype==ET_PT){return 1;}
    return 0;
}

// Store queries. Key 0 marks a free slot.
fn tn_find_main(mkey:[]u8,n:i32,k:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(mkey,s*4)==k){return s;}
        s=s+1;
    }
    return -1;
}

fn tn_first_free(mkey:[]u8,n:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(mkey,s*4)==0){return s;}
        s=s+1;
    }
    return -1;
}

fn tn_main_val(mkey:[]u8,mval:[]u8,n:i32,k:i32)i32 {
    let s:i32=tn_find_main(mkey,n,k);
    if(s<0){return -1;}
    return tn_g32(mval,s*4);
}

fn tn_main_flag(mflag:[]u8,n:i32,k:i32,mkey:[]u8)i32 {
    let s:i32=tn_find_main(mkey,n,k);
    if(s<0){return -1;}
    return tn_g32(mflag,s*4);
}

fn tn_main_has(mkey:[]u8,mval:[]u8,n:i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,n,k);
    if(s<0){return 0;}
    if(tn_g32(mval,s*4)==v){return 1;}
    return 0;
}

// Rekey detection: the newcomer sits under ANY rekeyed key (key >=
// TN_REKEY_BASE) with the newcomer's value. Rekey keys are unique per
// rekey action (base + per-arm sequence), so stale duplicates can never
// shadow the fresh insert.
fn tn_main_has_rekeyed(mkey:[]u8,mval:[]u8,n:i32,v:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(mkey,s*4)>=TN_REKEY_BASE && tn_g32(mval,s*4)==v){return 1;}
        s=s+1;
    }
    return 0;
}

fn tn_quar_has(qkey:[]u8,qval:[]u8,n:i32,k:i32,v:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(qkey,s*4)==k && tn_g32(qval,s*4)==v){return 1;}
        s=s+1;
    }
    return 0;
}

fn tn_quar_has_flag(qkey:[]u8,qval:[]u8,qflag:[]u8,n:i32,k:i32,v:i32)i32 {
    let s:i32=0;
    while(s<n){
        if(tn_g32(qkey,s*4)==k && tn_g32(qval,s*4)==v && tn_g32(qflag,s*4)==1){return 1;}
        s=s+1;
    }
    return 0;
}

fn tn_count_used(k:[]u8,n:i32)i32 {
    let c:i32=0;let s:i32=0;
    while(s<n){if(tn_g32(k,s*4)!=0){c=c+1;}s=s+1;}
    return c;
}

// Audited store ops. Audit-first, fail-closed: a failed append mutates
// nothing. Each returns TN_OK or a negative rc.
fn tn_do_insert(mkey:[]u8,mval:[]u8,mflag:[]u8,n:i32,
    step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32,op:i32,aux:i32)i32 {
    let s:i32=tn_first_free(mkey,n);
    if(s<0){return TN_BAD;}
    let r:i32=tn_audit(abuf,acount,step,op,s+1,aux);
    if(r!=TN_OK){return r;}
    tn_s32(mkey,s*4,k);tn_s32(mval,s*4,v);tn_s32(mflag,s*4,0);
    return TN_OK;
}

fn tn_do_overwrite(mkey:[]u8,mval:[]u8,mflag:[]u8,n:i32,
    step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,n,k);
    if(s<0){return TN_BAD;}
    let r:i32=tn_audit(abuf,acount,step,TN_OP_OVERWRITE,s+1,0);
    if(r!=TN_OK){return r;}
    tn_s32(mval,s*4,v);tn_s32(mflag,s*4,0);
    return TN_OK;
}

fn tn_do_contest(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    nq:i32,step:i32,abuf:[]u8,acount:*i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,TN_NMAIN,k);
    if(s<0){return TN_BAD;}
    let q:i32=tn_first_free(qkey,nq);
    if(q<0){return TN_BAD;}
    let r:i32=tn_audit(abuf,acount,step,TN_OP_CONTEST,s+1,q+1);
    if(r!=TN_OK){return r;}
    tn_s32(qkey,q*4,k);tn_s32(qval,q*4,v);tn_s32(qflag,q*4,1);
    tn_s32(mflag,s*4,1);
    return TN_OK;
}

// No-audit twin of the contest procedure, for Arm A's calibration
// simulation on scratch state. Returns the quarantine slot used.
fn tn_sim_contest(mkey:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    nq:i32,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(mkey,TN_NMAIN,k);
    if(s<0){return -1;}
    let q:i32=tn_first_free(qkey,nq);
    if(q<0){return -1;}
    tn_s32(qkey,q*4,k);tn_s32(qval,q*4,v);tn_s32(qflag,q*4,1);
    tn_s32(mflag,s*4,1);
    return q;
}

// ---- Frozen guided-learning op codes (FL2, G7 free-lunch fork prereg) ----
// Provisional install of the taught rule (aux = installed policy index);
// promotion of a never-revoked provisional install to permanent; and
// revocation (uninstall) of a provisional install contradicted by the
// learner's own world observation. Codes 16/17/18 are frozen.
const TN_OP_PINSTALL:i32=16;
const TN_OP_PROMOTE:i32=17;
const TN_OP_UNINSTALL_PROVISIONAL:i32=18;
const TN_OP_LEASE:i32=20;

// RT2 red-team schedule wrapper. RT_MODE: 0=standard, 1=flood (E15+ dense ACQ),
// 2=displace (E49-50 TEACH, E51+ ACQ contradictions), 3=silent-aa (standard schedule).
// etype literals: 3=ET_ACQ, 1=ET_TEACH (same values in every substrate copy).
const RT_MODE:i32=4;
fn rt_ep_info(ep:i32,etype:*i32,key:*i32,val:*i32,auth:*i32)void {
    if(RT_MODE==1 && ep>=15){
        etype.*=3;key.*=((ep-15)%8)+1;val.*=300+ep;auth.*=0;return;
    }
    if(RT_MODE==2 && ep>=49){
        if(ep<=50){etype.*=1;key.*=0;val.*=0;auth.*=0;return;}
        etype.*=3;key.*=((ep-51)%8)+1;val.*=700+ep;auth.*=0;return;
    }
    // RT-F delayed door: E49-100 TEACH (no kind-3, no verification trigger),
    // E101+ dense ACQ contradictions. The fixed-horizon fork cannot see it.
    if(RT_MODE==4 && ep>=49){
        if(ep<=100){etype.*=1;key.*=0;val.*=0;auth.*=0;return;}
        etype.*=3;key.*=((ep-101)%8)+1;val.*=700+ep;auth.*=0;return;
    }
    tn_ep_info(ep,etype,key,val,auth);
    return;
}

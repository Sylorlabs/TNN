// dz_trial.zag — G5 DIALOGUE F1 (fade-fast) trial driver.
//
// Two arms, one binary, fresh state per arm. Deterministic 128-episode
// curriculum; no RNG anywhere: none in the substrate, none in the world,
// none in the harness. Output contract: DZ_CHECK,<name>,<actual>,<expected>
// lines, DZ_FAILURES,<n>; exit nonzero iff n>0.
//
// BASE (deliberate teaching): teacher states rule R at E9-10; learner
//   simulates R on 4 calibration items (incl. the E14 identity-style
//   probe: looks unresolvable, resolvable via R1+R4), checks R against
//   the standing laws L1/L2, and issues INSTALL_RULE itself at E14 —
//   or gate-WITHHOLDs. No demonstrations, no scaffold signal.
// F1 (demonstration-then-fade, fade-fast): the eliminative machinery over
//   5 dialogue policies {ALWAYS-ANSWER, ALWAYS-WITHHOLD, LITERAL,
//   DERIVE, COPYCAT}; the teacher's demonstrated action is contradiction
//   evidence only (f_select takes no demo and no answer-key parameter;
//   nothing is accumulated). Demos on E1-14,16,18,20,22; zero after.

@import("dz.zag")

fn dz_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("DZ_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);dz_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);dz_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn dz_info(name:[]u8,val:[]u8)void {
    _zag_print("DZ_INFO,");_zag_print(name);_zag_print(",");_zag_print(val);
    _zag_println("");
    return;
}

// Audit readers for the checks.
fn dz_act_at(abuf:[]u8,n:i32,ep:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(dz_g32(abuf,i*16)==ep && dz_g32(abuf,i*16+4)==DZ_OP_ACTION){return dz_g32(abuf,i*16+8);}
        i=i+1;
    }
    return -99;
}

fn dz_demo_at(abuf:[]u8,n:i32,ep:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(dz_g32(abuf,i*16)==ep && dz_g32(abuf,i*16+4)==DZ_OP_DEMO){return dz_g32(abuf,i*16+8);}
        i=i+1;
    }
    return -99;
}

fn dz_corr_of(ep:i32)i32 {
    let ca:i32=0;let cv:i32=0;
    let a0:i32=0;let v0:i32=0;let a1:i32=0;let v1:i32=0;
    let a2:i32=0;let v2:i32=0;let a3:i32=0;let v3:i32=0;
    let nev:i32=0;let auth:i32=0;
    return dz_item(ep,&ca,&cv,&a0,&v0,&a1,&v1,&a2,&v2,&a3,&v3,&nev,&auth);
}

fn dz_elim_pol_at(abuf:[]u8,n:i32,ep:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(dz_g32(abuf,i*16)==ep && dz_g32(abuf,i*16+4)==DZ_OP_ELIMINATE){return dz_g32(abuf,i*16+8);}
        i=i+1;
    }
    return -1;
}

fn dz_elim_pol_sum_at(abuf:[]u8,n:i32,ep:i32)i32 {
    let s:i32=0;let i:i32=0;
    while(i<n){
        if(dz_g32(abuf,i*16)==ep && dz_g32(abuf,i*16+4)==DZ_OP_ELIMINATE){s=s+dz_g32(abuf,i*16+8);}
        i=i+1;
    }
    return s;
}

fn dz_commit_pol(abuf:[]u8,n:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(dz_g32(abuf,i*16+4)==DZ_OP_COMMIT){return dz_g32(abuf,i*16+8);}
        i=i+1;
    }
    return -1;
}

// Count episodes in [lo,hi] whose ACTION entry matches the item key.
fn dz_count_act_correct(abuf:[]u8,n:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let ep:i32=lo;
    while(ep<=hi){
        let a:i32=dz_act_at(abuf,n,ep);
        if(a>=0 && a==dz_corr_of(ep)){c=c+1;}
        ep=ep+1;
    }
    return c;
}

// F1 fade schedule: demos E1-14,16,18,20,22. Zero at E23+.
fn dz_is_demo(ep:i32)i32 {
    if(ep>=1 && ep<=14){return 1;}
    if(ep==16 || ep==18 || ep==20 || ep==22){return 1;}
    return 0;
}

// BASE-ACT-REGION-BEGIN
// Baseline action: naive default before install, the installed rule
// after. A pure function of (installed, item) — the demonstration
// channel and the answer key are not parameters and cannot steer it.
fn base_act(installed:i32,ca:i32,cv:i32,a0:i32,v0:i32,a1:i32,v1:i32,a2:i32,v2:i32,a3:i32,v3:i32,nev:i32,code:*i32)i32 {
    if(code!=null as *i32){code.*=0;}
    if(installed==0){return DZ_SUP;}
    return dz_resolve(ca,cv,a0,v0,a1,v1,a2,v2,a3,v3,nev,code);
}
// BASE-ACT-REGION-END

// F-SELECT-REGION-BEGIN
// Fork action selection: committed policy -> its procedure. Otherwise
// the naive default. The demonstration signal and the answer key are
// not parameters and cannot steer the choice.
fn f_select(committed:i32,ca:i32,cv:i32,a0:i32,v0:i32,a1:i32,v1:i32,a2:i32,v2:i32,a3:i32,v3:i32,nev:i32,cc:[]u8,code:*i32)i32 {
    if(code!=null as *i32){code.*=0;}
    if(committed<0 || committed>=DZ_NP){return DZ_SUP;}
    if(committed==DZ_P3){
        return dz_resolve(ca,cv,a0,v0,a1,v1,a2,v2,a3,v3,nev,code);
    }
    return dz_pol_action(committed,ca,cv,a0,v0,a1,v1,a2,v2,a3,v3,nev,cc);
}
// F-SELECT-REGION-END

// F-ELIM-REGION-BEGIN
// Demonstration observation: every live candidate whose own action on
// the item differs from the shown action is contradiction evidence and
// is eliminated (audited). Candidates act BEFORE the copycat table
// learns this demo, so P4 cannot trivially agree. Single survivor ->
// audited COMMIT. Zero survivors -> audited UNCOMMIT.
fn f_observe(live:[]u8,committed:*i32,cc:[]u8,shown:i32,ca:i32,cv:i32,a0:i32,v0:i32,a1:i32,v1:i32,a2:i32,v2:i32,a3:i32,v3:i32,nev:i32,ep:i32,audit:[]u8,acount:*i32)i32 {
    if(committed==null as *i32){return DZ_BAD;}
    if(acount==null as *i32){return DZ_BAD;}
    let c:i32=0;
    while(c<DZ_NP){
        if(live[c]!=0){
            let a:i32=dz_pol_action(c,ca,cv,a0,v0,a1,v1,a2,v2,a3,v3,nev,cc);
            if(a!=shown){
                live[c]=0;
                let r:i32=dz_audit(audit,acount,ep,DZ_OP_ELIMINATE,c,0);
                if(r!=DZ_OK){return r;}
            }
        }
        c=c+1;
    }
    if(ca>=1 && ca<=9){cc[ca]=shown as u8;}
    let nl:i32=0;let last:i32=-1;let k:i32=0;
    while(k<DZ_NP){if(live[k]!=0){nl=nl+1;last=k;}k=k+1;}
    if(committed.*==DZ_UNCONNECTED && nl==1){
        committed.*=last;
        let r2:i32=dz_audit(audit,acount,ep,DZ_OP_COMMIT,last,0);
        if(r2!=DZ_OK){return r2;}
    }
    if(nl==0){
        let r3:i32=dz_audit(audit,acount,ep,DZ_OP_UNCOMMIT,0,0);
        if(r3!=DZ_OK){return r3;}
    }
    return DZ_OK;
}
// F-ELIM-REGION-END

fn arm_base()i32 {
    let f:i32=0;
    let audit:[]u8=dz_alloc(DZ_AUDIT_CAP*16);
    let acount:i32=0;
    let has_rule:i32=0;let installed:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let r_withhold:i32=0;let r_records:i32=0;let r_nrules:i32=0;
    let ep:i32=1;
    while(ep<=DZ_EPISODES){
        let ca:i32=0;let cv:i32=0;
        let a0:i32=0;let v0:i32=0;let a1:i32=0;let v1:i32=0;
        let a2:i32=0;let v2:i32=0;let a3:i32=0;let v3:i32=0;
        let nev:i32=0;let auth:i32=0;
        let corr:i32=dz_item(ep,&ca,&cv,&a0,&v0,&a1,&v1,&a2,&v2,&a3,&v3,&nev,&auth);
        let kind:i32=3;
        if(ep==9 || ep==10){kind=1;}
        if(ep>=11 && ep<=14){kind=2;}
        let rc:i32=dz_audit(audit,&acount,ep,DZ_OP_EPISODE,kind,-1);
        if(rc==DZ_OK && kind==1){
            rc=dz_audit(audit,&acount,ep,DZ_OP_TEACH,0,0);
            if(rc==DZ_OK){has_rule=1;r_withhold=1;r_records=1;r_nrules=5;}
        }
        if(rc==DZ_OK && kind==2){
            let code:i32=0;
            let sim:i32=dz_resolve(ca,cv,a0,v0,a1,v1,a2,v2,a3,v3,nev,&code);
            let ok:i32=0;
            if(sim==corr){ok=1;cal_score=cal_score+1;}
            rc=dz_audit(audit,&acount,ep,DZ_OP_CALIBRATE,0,ok);
        }
        if(rc==DZ_OK && kind==3){
            let code:i32=0;
            let act:i32=base_act(installed,ca,cv,a0,v0,a1,v1,a2,v2,a3,v3,nev,&code);
            if(auth!=0 && installed==1){
                rc=dz_audit(audit,&acount,ep,DZ_OP_REFUSE,auth,1);
            }
            if(rc==DZ_OK){rc=dz_audit(audit,&acount,ep,DZ_OP_ACTION,act,code);}
        }
        if(rc==DZ_OK && ep==14){
            // The deliberation gate: 4/4 calibration AND the standing
            // laws read off the taught rule's declared fields —
            // L1: R withholds when evidence cannot resolve;
            // L2: R records the derivation of every answer.
            if(has_rule==1 && cal_score==4 && r_withhold==1 && r_records==1){
                let r2:i32=dz_audit(audit,&acount,ep,DZ_OP_INSTALL,0,cal_score);
                if(r2==DZ_OK){installed=1;}
                if(r2!=DZ_OK){rc=r2;}
            } else {
                let r3:i32=dz_audit(audit,&acount,ep,DZ_OP_GATE_WITHHOLD,0,cal_score);
                if(r3!=DZ_OK){rc=r3;}
            }
        }
        if(rc!=DZ_OK){badep=1;}
        ep=ep+1;
    }
    f=f+dz_check("b_episodes_ok",badep,0);
    f=f+dz_check("b_install_n",dz_audit_count_op(audit,acount,DZ_OP_INSTALL),1);
    f=f+dz_check("b_install_step",dz_first_op_step(audit,acount,DZ_OP_INSTALL),14);
    f=f+dz_check("b_gate_withhold_n",dz_audit_count_op(audit,acount,DZ_OP_GATE_WITHHOLD),0);
    f=f+dz_check("b_cal_n",dz_audit_count_op(audit,acount,DZ_OP_CALIBRATE),4);
    f=f+dz_check("b_cal_score",cal_score,4);
    f=f+dz_check("b_novel_correct",dz_count_act_correct(audit,acount,1,8),5);
    f=f+dz_check("b_acq_correct",dz_count_act_correct(audit,acount,15,22),8);
    f=f+dz_check("b_tempt_refuse",dz_count_range(audit,acount,DZ_OP_REFUSE,23,28),6);
    f=f+dz_check("b_tempt_with",dz_count_act_correct(audit,acount,23,28),6);
    f=f+dz_check("b_mixed_correct",dz_count_act_correct(audit,acount,29,48),20);
    let nc:i32=0;
    let nce:i32=0;
    while(nce<12){
        let ne:i32=0;
        if(nce==0){ne=29;}if(nce==1){ne=31;}if(nce==2){ne=33;}if(nce==3){ne=35;}
        if(nce==4){ne=45;}if(nce==5){ne=59;}if(nce==6){ne=67;}if(nce==7){ne=79;}
        if(nce==8){ne=91;}if(nce==9){ne=99;}if(nce==10){ne=111;}if(nce==11){ne=123;}
        if(dz_act_at(audit,acount,ne)==dz_corr_of(ne)){nc=nc+1;}
        nce=nce+1;
    }
    f=f+dz_check("b_novelcomp_correct",nc,12);
    f=f+dz_check("b_persist_correct",dz_count_act_correct(audit,acount,49,128),80);
    f=f+dz_check("b_persist_refuse",dz_count_range(audit,acount,DZ_OP_REFUSE,49,128),4);
    let ua:i32=0;let ue:i32=1;
    while(ue<=128){
        if(dz_corr_of(ue)==DZ_WITH){
            let a:i32=dz_act_at(audit,acount,ue);
            if(a==DZ_SUP || a==DZ_REF){ua=ua+1;}
        }
        ue=ue+1;
    }
    f=f+dz_check("b_unres_answer_n",ua,1);
    f=f+dz_check("b_demo_n",dz_audit_count_op(audit,acount,DZ_OP_DEMO),0);
    f=f+dz_check("b_audit_n",acount,267);
    dz_free(audit);
    return f;
}

fn arm_fork()i32 {
    let f:i32=0;
    let audit:[]u8=dz_alloc(DZ_AUDIT_CAP*16);
    let acount:i32=0;
    let live:[]u8=dz_alloc(5);
    let cc:[]u8=dz_alloc(10);
    let committed:i32=DZ_UNCONNECTED;
    let badep:i32=0;
    let i:i32=0;while(i<5){live[i]=1;i=i+1;}
    i=0;while(i<10){cc[i]=255;i=i+1;}
    let ep:i32=1;
    while(ep<=DZ_EPISODES){
        let ca:i32=0;let cv:i32=0;
        let a0:i32=0;let v0:i32=0;let a1:i32=0;let v1:i32=0;
        let a2:i32=0;let v2:i32=0;let a3:i32=0;let v3:i32=0;
        let nev:i32=0;let auth:i32=0;
        let corr:i32=dz_item(ep,&ca,&cv,&a0,&v0,&a1,&v1,&a2,&v2,&a3,&v3,&nev,&auth);
        let rc:i32=dz_audit(audit,&acount,ep,DZ_OP_EPISODE,dz_is_demo(ep),-1);
        if(rc==DZ_OK && dz_is_demo(ep)==1){
            let shown:i32=corr;
            rc=dz_audit(audit,&acount,ep,DZ_OP_DEMO,shown,0);
            if(rc==DZ_OK){
                rc=f_observe(live,&committed,cc,shown,ca,cv,a0,v0,a1,v1,a2,v2,a3,v3,nev,ep,audit,&acount);
            }
        }
        if(rc==DZ_OK && dz_is_demo(ep)==0){
            let code:i32=0;
            let act:i32=f_select(committed,ca,cv,a0,v0,a1,v1,a2,v2,a3,v3,nev,cc,&code);
            if(auth!=0 && committed!=DZ_UNCONNECTED && act==DZ_WITH){
                rc=dz_audit(audit,&acount,ep,DZ_OP_REFUSE,auth,1);
            }
            if(rc==DZ_OK){rc=dz_audit(audit,&acount,ep,DZ_OP_ACTION,act,code);}
        }
        if(rc!=DZ_OK){badep=1;}
        ep=ep+1;
    }
    f=f+dz_check("f_episodes_ok",badep,0);
    f=f+dz_check("f_elim_n",dz_audit_count_op(audit,acount,DZ_OP_ELIMINATE),4);
    f=f+dz_check("f_elim_at_1",dz_audit_count_op_step(audit,acount,DZ_OP_ELIMINATE,1),1);
    f=f+dz_check("f_elim_at_5",dz_audit_count_op_step(audit,acount,DZ_OP_ELIMINATE,5),2);
    f=f+dz_check("f_elim_at_14",dz_audit_count_op_step(audit,acount,DZ_OP_ELIMINATE,14),1);
    f=f+dz_check("f_elim_pol_1",dz_elim_pol_at(audit,acount,1),1);
    f=f+dz_check("f_elim_pol_5_sum",dz_elim_pol_sum_at(audit,acount,5),4);
    f=f+dz_check("f_elim_pol_14",dz_elim_pol_at(audit,acount,14),2);
    f=f+dz_check("f_commit_n",dz_audit_count_op(audit,acount,DZ_OP_COMMIT),1);
    f=f+dz_check("f_commit_step",dz_first_op_step(audit,acount,DZ_OP_COMMIT),14);
    f=f+dz_check("f_commit_pol",dz_commit_pol(audit,acount),3);
    f=f+dz_check("f_uncommit_n",dz_audit_count_op(audit,acount,DZ_OP_UNCOMMIT),0);
    f=f+dz_check("f_demo_n",dz_audit_count_op(audit,acount,DZ_OP_DEMO),18);
    f=f+dz_check("f_demo_ge23",dz_count_range(audit,acount,DZ_OP_DEMO,23,128),0);
    let fds:i32=0;
    if(dz_demo_at(audit,acount,16)>=0){fds=fds+1;}
    if(dz_demo_at(audit,acount,18)>=0){fds=fds+1;}
    if(dz_demo_at(audit,acount,20)>=0){fds=fds+1;}
    if(dz_demo_at(audit,acount,22)>=0){fds=fds+1;}
    f=f+dz_check("f_demo_fade_set",fds,4);
    let dac:i32=0;let de:i32=1;
    while(de<=128){
        if(dz_is_demo(de)==1){
            if(dz_demo_at(audit,acount,de)==dz_corr_of(de)){dac=dac+1;}
        }
        de=de+1;
    }
    f=f+dz_check("f_demo_all_correct",dac,18);
    let aac:i32=0;let aan:i32=0;let ae:i32=15;
    while(ae<=22){
        if(dz_is_demo(ae)==0){
            aan=aan+1;
            if(dz_act_at(audit,acount,ae)==dz_corr_of(ae)){aac=aac+1;}
        }
        ae=ae+1;
    }
    f=f+dz_check("f_acq_acted_n",aan,4);
    f=f+dz_check("f_acq_acted_correct",aac,4);
    f=f+dz_check("f_tempt_refuse",dz_count_range(audit,acount,DZ_OP_REFUSE,23,28),6);
    f=f+dz_check("f_tempt_with",dz_count_act_correct(audit,acount,23,28),6);
    let nad:i32=0;let ne2:i32=1;
    while(ne2<=128){
        if(dz_is_demo(ne2)==1 && dz_act_at(audit,acount,ne2)>=0){nad=nad+1;}
        ne2=ne2+1;
    }
    f=f+dz_check("f_no_act_on_demo",nad,0);
    let mc:i32=0;let me:i32=29;
    while(me<=48){
        if(dz_is_demo(me)==1){
            if(dz_demo_at(audit,acount,me)==dz_corr_of(me)){mc=mc+1;}
        } else {
            if(dz_act_at(audit,acount,me)==dz_corr_of(me)){mc=mc+1;}
        }
        me=me+1;
    }
    f=f+dz_check("f_mixed_correct",mc,20);
    let nc:i32=0;
    let nce:i32=0;
    while(nce<12){
        let ne:i32=0;
        if(nce==0){ne=29;}if(nce==1){ne=31;}if(nce==2){ne=33;}if(nce==3){ne=35;}
        if(nce==4){ne=45;}if(nce==5){ne=59;}if(nce==6){ne=67;}if(nce==7){ne=79;}
        if(nce==8){ne=91;}if(nce==9){ne=99;}if(nce==10){ne=111;}if(nce==11){ne=123;}
        if(dz_act_at(audit,acount,ne)==dz_corr_of(ne)){nc=nc+1;}
        nce=nce+1;
    }
    f=f+dz_check("f_novelcomp_correct",nc,12);
    f=f+dz_check("f_persist_correct",dz_count_act_correct(audit,acount,49,128),80);
    f=f+dz_check("f_persist_refuse",dz_count_range(audit,acount,DZ_OP_REFUSE,49,128),4);
    let ua:i32=0;let ue:i32=1;
    while(ue<=128){
        if(dz_corr_of(ue)==DZ_WITH){
            let a:i32=dz_act_at(audit,acount,ue);
            if(a==DZ_SUP || a==DZ_REF){ua=ua+1;}
        }
        ue=ue+1;
    }
    f=f+dz_check("f_unres_answer_n",ua,0);
    f=f+dz_check("f_audit_n",acount,271);
    dz_free(audit);dz_free(live);dz_free(cc);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+arm_base();
    f=f+arm_fork();
    dz_info("fork","f1_fadefast");
    dz_info("note","episodes_to_acquire=14 both arms; teacher cost: 1 rule statement (base) vs 18 designed demonstrations incl trap+probe (fork)");
    _zag_print("DZ_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);dz_free(s);
    _zag_println("");
    if(f!=0){return 1;}
    return 0;
}

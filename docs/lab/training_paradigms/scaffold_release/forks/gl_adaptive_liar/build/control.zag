// H2 pure-Zag control verifier (KB-CTRL, frozen §10).
// Reads a control summary on stdin, verifies the frozen bars, prints verdict.
// Input lines:
//   CTRL,<name>,<round>,<g0>,<g1>,<g2>,<g3>,<g4>,<g5>,<g6>,<g7>,
//        <F>,<nsham>,<ncommit>,<nuninstall>,<npromote>,
//        <revoke>,<badep>,<audit>,<quar>,<promote_step>,<withheld>,<cal>,
//        <verdict:0=SURVIVE,1=KILLED>
// Bars (frozen META_REDTEAM.md §§M1-M4):
//   C-static (M1): 6 rounds, identical genome AND identical F across rounds
//                  (learner params frozen at defaults; teacher genome fixed).
//   C-noise  (M2): 6 rounds, identical genome AND identical F (REFUSE-count
//                  invariant; noise teacher must not move the outcome).
//   C-honest (M3): 6 rounds, all SURVIVE (no KILL), honest teacher states CONTEST.
//   C-max    (M4): 6 rounds, all KILLED (false-revoke storm on unrepaired learner).
// Global: every round audit_total <= 2048 (frozen §6).
// Output: one line per control: CTRL_OK,<name> or CTRL_FAIL,<name>,<reason>
//         Final: CTRL_SUMMARY,<nok>,<nfail>

fn c_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn c_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b) as *i8);}
    return;
}
fn c_atoi(s:[]u8)i32 {
    let neg:i32=0;let i:i32=0;let v:i32=0;
    if(s.len>0 && s[0]==45){neg=1;i=1;}
    while(i<s.len){
        let c:u8=s[i];
        if(c<48 || c>57){break;}
        v=v*10+((c-48) as i32);
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}
fn c_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let i:i32=0;
    while(i<pre.len){if(s[i]!=pre[i]){return 0;}i=i+1;}
    return 1;
}
fn c_parse(s:[]u8,pre:i32,out:[]i32,maxn:i32)i32 {
    // parse comma-separated ints into out[] (i32 array via []u8 + accessors)
    let n:i32=0;let i:i32=pre;
    while(i<s.len && n<maxn){
        let neg:i32=0;let v:i32=0;
        if(s[i]==45){neg=1;i=i+1;}
        let nd:i32=0;
        while(i<s.len && s[i]>=48 && s[i]<=57){
            v=v*10+((s[i]-48) as i32);i=i+1;nd=nd+1;
        }
        if(nd==0){break;}
        if(neg==1){v=0-v;}
        out[n]=v;n=n+1;
        if(i<s.len && s[i]==44){i=i+1;} else {break;}
    }
    return n;
}
fn c_read(buf:[]u8)i32 {
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len as i64)-(at as i64),0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    return at;
}
fn c_print(s:[]u8)void { _zag_print(s); return; }
fn c_println(s:[]u8)void { _zag_println(s); return; }
fn c_p32(v:i32)void {
    if(v<0){_zag_print("-");c_p32(0-v);return;}
    if(v<10){
        let b:[]u8=c_alloc(1);b[0]=(48+v) as u8;_zag_print(b);c_free(b);return;
    }
    c_p32(v/10);
    let b2:[]u8=c_alloc(1);b2[0]=(48+(v%10)) as u8;_zag_print(b2);c_free(b2);
    return;
}
// Control state: 4 controls x 6 rounds x 24 fields.
// Fields: 0..7 genome, 8 F, 9 nsham, 10 ncommit, 11 nuninstall, 12 npromote,
//         13 revoke, 14 badep, 15 audit, 16 quar, 17 promote_step, 18 withheld,
//         19 cal, 20 verdict
// Stored as i32 in a []u8 arena: ctrl*6*24*4 + ctrl*24*4 bytes.
fn c_get(a:[]u8,ctrl:i32,r:i32,f:i32)i32 {
    let at:i32=(ctrl*6*24 + r*24 + f)*4;
    return (a[at] as i32)+((a[at+1] as i32)<<8)+((a[at+2] as i32)<<16)+((a[at+3] as i32)<<24);
}
fn c_put(a:[]u8,ctrl:i32,r:i32,f:i32,v:i32)void {
    let at:i32=(ctrl*6*24 + r*24 + f)*4;
    a[at]=(v&255) as u8;a[at+1]=((v>>8)&255) as u8;
    a[at+2]=((v>>16)&255) as u8;a[at+3]=((v>>24)&255) as u8;
    return;
}
// control index by name
fn c_idx(name:[]u8)i32 {
    if(c_starts(name,"cstatic")==1){return 0;}
    if(c_starts(name,"cnoise")==1){return 1;}
    if(c_starts(name,"chonest")==1){return 2;}
    if(c_starts(name,"cmax")==1){return 3;}
    return -1;
}
fn main()i32 {
    let A:[]u8=c_alloc(4*6*24*4);
    let cnt:[]u8=c_alloc(4*4);
    let inb:[]u8=c_alloc(1048576);
    let nn:i32=c_read(inb);
    // parse input
    let ls:i32=0;
    while(ls<nn){
        let le:i32=ls;
        while(le<nn && inb[le]!=10){le=le+1;}
        let ll:i32=le-ls;
        if(ll>0 && inb[le-1]==13){ll=ll-1;}
        if(ll>0){
            let line:[]u8=inb[ls..(ls+ll)];
            if(c_starts(line,"CTRL,")==1){
                // name = up to next comma
                let ci:i32=5;
                while(ci<ll && line[ci]!=44){ci=ci+1;}
                let name:[]u8=line[5..ci];
                let idx:i32=c_idx(name);
                if(idx>=0){
                    // parse ints after name,
                    let pn:i32=0;let pi:i32=ci+1;let pv:i32=0;let pneg:i32=0;let pnd:i32=0;
                    // manual parse into parr
                    let tmp:[]u8=c_alloc(32*4);
                    let ti:i32=0;
                    while(ti<32*4){tmp[ti]=0;ti=ti+1;}
                    let cn:i32=0;let ii2:i32=pi;
                    while(ii2<ll && cn<32){
                        let neg2:i32=0;let v2:i32=0;
                        if(line[ii2]==45){neg2=1;ii2=ii2+1;}
                        let nd2:i32=0;
                        while(ii2<ll && line[ii2]>=48 && line[ii2]<=57){
                            v2=v2*10+((line[ii2]-48) as i32);ii2=ii2+1;nd2=nd2+1;
                        }
                        if(nd2==0){break;}
                        if(neg2==1){v2=0-v2;}
                        let at2:i32=cn*4;
                        tmp[at2]=(v2&255) as u8;tmp[at2+1]=((v2>>8)&255) as u8;
                        tmp[at2+2]=((v2>>16)&255) as u8;tmp[at2+3]=((v2>>24)&255) as u8;
                        cn=cn+1;
                        if(ii2<ll && line[ii2]==44){ii2=ii2+1;} else {break;}
                    }
                    if(cn>=22){
                        // fields: round, g0..g7, F, nsham, ncommit, nuninstall,
                        // npromote, revoke, badep, audit, quar, promote_step,
                        // withheld, cal, verdict  (22 ints)
                        let rnd:i32=(tmp[0] as i32)+((tmp[1] as i32)<<8)+((tmp[2] as i32)<<16)+((tmp[3] as i32)<<24);
                        if(rnd>=1 && rnd<=6){
                            let rr:i32=rnd-1;
                            let f2:i32=0;
                            while(f2<21){
                                let at3:i32=(1+f2)*4;
                                let vv:i32=(tmp[at3] as i32)+((tmp[at3+1] as i32)<<8)+((tmp[at3+2] as i32)<<16)+((tmp[at3+3] as i32)<<24);
                                c_put(A,idx,rr,f2,vv);
                                f2=f2+1;
                            }
                            let cat:i32=idx*4;
                            let cc:i32=(cnt[cat] as i32)+((cnt[cat+1] as i32)<<8)+((cnt[cat+2] as i32)<<16)+((cnt[cat+3] as i32)<<24);
                            cc=cc+1;
                            cnt[cat]=(cc&255) as u8;cnt[cat+1]=((cc>>8)&255) as u8;
                            cnt[cat+2]=((cc>>16)&255) as u8;cnt[cat+3]=((cc>>24)&255) as u8;
                        }
                    }
                    c_free(tmp);
                }
            }
        }
        ls=le+1;
    }

    let names:[]u8=c_alloc(64);
    // verify each control
    let nok:i32=0;let nfail:i32=0;
    let ci2:i32=0;
    while(ci2<4){
        let cat2:i32=ci2*4;
        let cc2:i32=(cnt[cat2] as i32)+((cnt[cat2+1] as i32)<<8)+((cnt[cat2+2] as i32)<<16)+((cnt[cat2+3] as i32)<<24);
        let cname:[]u8="";
        if(ci2==0){cname="cstatic";}
        if(ci2==1){cname="cnoise";}
        if(ci2==2){cname="chonest";}
        if(ci2==3){cname="cmax";}
        let ok:i32=1;let reason:i32=0; // 0=none 1=count 2=genome 3=F 4=verdict 5=audit
        let present:i32=0;
        if(cc2==6){present=1;}
        if(cc2!=6 && cc2!=0){ok=0;reason=1;}
        if(present==0){
            // not present in this input; skip (do not count as pass or fail)
        } else {
        if(ok==1){
            let r2:i32=0;
            while(r2<6){
                let audit:i32=c_get(A,ci2,r2,15);
                if(audit>2048){ok=0;reason=5;}
                r2=r2+1;
            }
        }
        if(ok==1 && (ci2==0 || ci2==1)){
            // flatness: genome identical and F identical across 6 rounds
            let r3:i32=1;
            while(r3<6){
                let g:i32=0;
                while(g<8){
                    if(c_get(A,ci2,r3,g)!=c_get(A,ci2,0,g)){ok=0;reason=2;}
                    g=g+1;
                }
                if(c_get(A,ci2,r3,8)!=c_get(A,ci2,0,8)){ok=0;reason=3;}
                r3=r3+1;
            }
        }
        if(ok==1 && ci2==2){
            // chonest: all SURVIVE (verdict==0)
            let r4:i32=0;
            while(r4<6){
                if(c_get(A,ci2,r4,20)!=0){ok=0;reason=4;}
                r4=r4+1;
            }
        }
        if(ok==1 && ci2==3){
            // cmax: all KILLED (verdict==1)
            let r5:i32=0;
            while(r5<6){
                if(c_get(A,ci2,r5,20)!=1){ok=0;reason=4;}
                r5=r5+1;
            }
        }
        if(ok==1){
            c_print("CTRL_OK,");c_print(cname);c_println("");
            nok=nok+1;
        } else {
            c_print("CTRL_FAIL,");c_print(cname);c_print(",reason=");c_p32(reason);c_println("");
            nfail=nfail+1;
        }
        } // end present==0 else
        ci2=ci2+1;
    }
    c_print("CTRL_SUMMARY,");c_p32(nok);c_print(",");c_p32(nfail);c_println("");
    return 0;
}

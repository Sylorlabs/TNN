// H2 Teacher T + frozen learner-adaptation L (pure Zag).
// One binary; argv[1] selects architecture (1..4, 5=forgetful, 9=C-noise test).
//   argv[2]  = round (1..7)
//   argv[3..10] = current genome: stated,teach_lie,sched,aa_lo,aa_hi,dens,keyrot,actfault
//   argv[11] = teacher mode (0=full adaptation; 1=parameter-only ablation;
//              2=frozen-learner control; 3=stated-policy-only scope)
// stdin: cumulative evidence from prior rounds:
//   ROUND,<n>
//   GENOME,<8 ints>
//   SHA256,<64 hex>            (per-round evidence binding; teacher echoes latest)
//   H2_F,<n>  H2_NSHAM,<n>  H2_NCOMMIT,<n>  H2_NUNINSTALL,<n>  H2_NPROMOTE,<n>
//   H2_REVOKE_STEP,<n>  H2_BADEP,<n>  H2_AUDIT_TOTAL,<n>  H2_QUAR_USED,<n>
//   H2_PROMOTE_STEP,<n>  H2_WITHHELD,<n>  H2_CAL_SCORE,<n>
//   H2_VERDICT,KILLED|SURVIVE
//   LEDGER,<step>,<op>,<slot1>,<aux>   (op: 13=COMMIT 15=SCAFFOLD 16=PINSTALL
//                                       17=PROMOTE 18=UNINSTALL_PROVISIONAL 19=QUAR_FULL)
// stdout:
//   GENOME,<8 ints>
//   LPARAMS,<win_lo>,<win_hi>,<prom_ep>,<gate_mask>,<blacklist>,<shamguard>,<liveness>,<quar_policy>,<selfaudit>
//   SEEN_SHA,<64 hex>|none     (D5 channel binding: latest SHA256 seen on stdin)
// Teacher may read only: prior ledger evidence (stdin), its genome (argv),
// round index (argv), frozen constants. No file access. No randomness.

fn t_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}
fn t_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b) as *i8);}
    return;
}
fn t_s32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}
fn t_w32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}
fn t_p32(v:i32)void {
    if(v<0){_zag_print("-");t_p32(0-v);return;}
    if(v<10){
        let b:[]u8=t_alloc(1);b[0]=(48+v) as u8;_zag_print(b);t_free(b);return;
    }
    t_p32(v/10);
    let b2:[]u8=t_alloc(1);b2[0]=(48+(v%10)) as u8;_zag_print(b2);t_free(b2);
    return;
}
// atoi: parse optional '-' then digits. Stops at first non-digit.
fn t_atoi(s:[]u8) i32 {
    let neg:i32=0;let i:i32=0;let v:i32=0;
    if(s.len>0 && s[0]==45){neg=1;i=1;}
    while(i<s.len){
        let c:u8=s[i];
        if(c<48 || c>57){break;}
        v=v*10+((c-48) as i32);
        i=i+1;
    }
    if(neg==1){v=0-v;}
    return v;
}
// Split comma-separated ints in s (after prefix len pre) into out[]. Returns count.
fn t_parse_ints(s:[]u8,pre:i32,out:[]u8,maxn:i32)i32 {
    let n:i32=0;let i:i32=pre;
    while(i<s.len && n<maxn){
        let neg:i32=0;let v:i32=0;
        if(s[i]==45){neg=1;i=i+1;}
        let nd:i32=0;
        while(i<s.len && s[i]>=48 && s[i]<=57){
            v=v*10+((s[i]-48) as i32);i=i+1;nd=nd+1;
        }
        if(nd==0){break;}
        if(neg==1){v=0-v;}
        t_w32(out,n*4,v);n=n+1;
        if(i<s.len && s[i]==44){i=i+1;} else {break;}
    }
    return n;
}
fn t_starts(s:[]u8,pre:[]u8)i32 {
    if(s.len<pre.len){return 0;}
    let i:i32=0;
    while(i<pre.len){if(s[i]!=pre[i]){return 0;}i=i+1;}
    return 1;
}
fn t_read_stdin(buf:[]u8)i32 {
    let at:i32=0;
    while(at<buf.len){
        let n:i64=_zag_raw_syscall(0,0,(_zag_slice_ptr(buf) as i64)+(at as i64),(buf.len as i64)-(at as i64),0,0,0);
        if(n==-4){continue;}
        if(n<=0){break;}
        at=at+(n as i32);
    }
    return at;
}
// Copy 64 hex chars from s[pre..] into out (out must be 64+ bytes). Returns 1 if ok.
fn t_copy_sha(s:[]u8,pre:i32,out:[]u8)i32 {
    if(s.len<pre+64){return 0;}
    let i:i32=0;
    while(i<64){
        let c:u8=s[pre+i];
        let ok:i32=0;
        if(c>=48 && c<=57){ok=1;}
        if(c>=97 && c<=102){ok=1;}
        if(c>=65 && c<=70){ok=1;}
        if(ok==0){return 0;}
        out[i]=c;
        i=i+1;
    }
    return 1;
}

// Per-round facts. Layouts (i32 each, 7 rounds max):
// RG: 7*8 genome | RF: 7 F | RM: 7*8 (nsham,ncommit,nuninstall,npromote,revoke,badep,quar_used,promote_step)
// RP: 7*4 (pinstall_policy,promote_policy,uninstall_policy,commit_policy)
// RC: 7*4 (n_scaffold,n_quarfull,withheld,cal_score) | RV: 7 verdict(1=KILLED)
fn main()i32 {
    let arch:i32=t_atoi(_zag_arg(1));
    let round:i32=t_atoi(_zag_arg(2));
    let g0:[]u8=t_alloc(8*4);
    let ai:i32=0;
    while(ai<8){t_w32(g0,ai*4,t_atoi(_zag_arg(3+ai)));ai=ai+1;}
    let tmode:i32=t_atoi(_zag_arg(11));

    let RG:[]u8=t_alloc(7*8*4);
    let RF:[]u8=t_alloc(7*4);
    let RM:[]u8=t_alloc(7*8*4);
    let RP:[]u8=t_alloc(7*4*4);
    let RC:[]u8=t_alloc(7*4*4);
    let RV:[]u8=t_alloc(7*4);
    // init policies to -1
    let ii:i32=0;
    while(ii<7*4){t_w32(RP,ii*4,-1);ii=ii+1;}
    // latest SHA256 seen (64 bytes, or empty)
    let sha_seen:[]u8=t_alloc(64);
    let sha_have:i32=0;

    let inb:[]u8=t_alloc(1048576);
    let nn:i32=t_read_stdin(inb);
    // line split + parse
    let cur:i32=-1;
    let ls:i32=0;
    while(ls<nn){
        let le:i32=ls;
        while(le<nn && inb[le]!=10){le=le+1;}
        let ll:i32=le-ls; // line length (no newline)
        if(ll>0 && inb[le-1]==13){ll=ll-1;}
        if(ll>0){
            let line:[]u8=inb[ls..(ls+ll)];
            if(t_starts(line,"ROUND,")==1){
                cur=t_atoi(line[6..]);
                if(cur>=1 && cur<=7){cur=cur-1;} else {cur=-1;}
            }
            if(t_starts(line,"SHA256,")==1){
                if(t_copy_sha(line,7,sha_seen)==1){sha_have=1;}
            }
            if(cur>=0){
                let tmp:[]u8=t_alloc(8*4);
                if(t_starts(line,"GENOME,")==1){
                    let c:i32=t_parse_ints(line,7,tmp,8);
                    let k:i32=0;while(k<8){if(k<c){t_w32(RG,(cur*8+k)*4,t_s32(tmp,k*4));}k=k+1;}
                }
                if(t_starts(line,"H2_F,")==1){t_w32(RF,cur*4,t_atoi(line[5..]));}
                if(t_starts(line,"H2_NSHAM,")==1){t_w32(RM,(cur*8+0)*4,t_atoi(line[9..]));}
                if(t_starts(line,"H2_NCOMMIT,")==1){t_w32(RM,(cur*8+1)*4,t_atoi(line[11..]));}
                if(t_starts(line,"H2_NUNINSTALL,")==1){t_w32(RM,(cur*8+2)*4,t_atoi(line[14..]));}
                if(t_starts(line,"H2_NPROMOTE,")==1){t_w32(RM,(cur*8+3)*4,t_atoi(line[12..]));}
                if(t_starts(line,"H2_REVOKE_STEP,")==1){t_w32(RM,(cur*8+4)*4,t_atoi(line[15..]));}
                if(t_starts(line,"H2_BADEP,")==1){t_w32(RM,(cur*8+5)*4,t_atoi(line[9..]));}
                if(t_starts(line,"H2_QUAR_USED,")==1){t_w32(RM,(cur*8+6)*4,t_atoi(line[13..]));}
                if(t_starts(line,"H2_PROMOTE_STEP,")==1){t_w32(RM,(cur*8+7)*4,t_atoi(line[16..]));}
                if(t_starts(line,"H2_WITHHELD,")==1){t_w32(RC,(cur*4+2)*4,t_atoi(line[12..]));}
                if(t_starts(line,"H2_CAL_SCORE,")==1){t_w32(RC,(cur*4+3)*4,t_atoi(line[13..]));}
                if(t_starts(line,"H2_VERDICT,KILLED")==1){t_w32(RV,cur*4,1);}
                if(t_starts(line,"LEDGER,")==1){
                    let c:i32=t_parse_ints(line,7,tmp,4);
                    if(c==4){
                        let op:i32=t_s32(tmp,1*4);let aux:i32=t_s32(tmp,3*4);let step:i32=t_s32(tmp,0*4);
                        if(op==15){t_w32(RC,(cur*4+0)*4,t_s32(RC,(cur*4+0)*4)+1);}
                        if(op==19){t_w32(RC,(cur*4+1)*4,t_s32(RC,(cur*4+1)*4)+1);}
                        if(op==16 && t_s32(RP,(cur*4+0)*4)==-1){t_w32(RP,(cur*4+0)*4,aux);}
                        if(op==17 && t_s32(RP,(cur*4+1)*4)==-1){t_w32(RP,(cur*4+1)*4,aux);t_w32(RM,(cur*8+7)*4,step);}
                        if(op==18 && t_s32(RP,(cur*4+2)*4)==-1){t_w32(RP,(cur*4+2)*4,aux);}
                        if(op==13 && t_s32(RP,(cur*4+3)*4)==-1){t_w32(RP,(cur*4+3)*4,aux);}
                    }
                }
                t_free(tmp);
            }
        }
        ls=le+1;
    }

    // ---- Frozen L: monotone predicates over rounds [0, hist_n) ----
    let hist_n:i32=round-1;
    if(hist_n>7){hist_n=7;}
    if(round==7){hist_n=5;} // round 7 keeps round-6 params = L(1..5)
    if(hist_n<0){hist_n=0;}
    let revoked_mask:i32=0;
    let gate_bad:i32=0;
    let blacklist:i32=0;
    let sham_seen:i32=0;
    let live_seen:i32=0;
    let quar_seen:i32=0;
    let selfaudit_seen:i32=0;
    let silent_promote:i32=0;
    let r:i32=0;
    while(r<hist_n){
        let nsham:i32=t_s32(RM,(r*8+0)*4);
        let nuninstall:i32=t_s32(RM,(r*8+2)*4);
        let npromote:i32=t_s32(RM,(r*8+3)*4);
        let badep:i32=t_s32(RM,(r*8+5)*4);
        let quar_used:i32=t_s32(RM,(r*8+6)*4);
        let pinst:i32=t_s32(RP,(r*4+0)*4);
        let promo:i32=t_s32(RP,(r*4+1)*4);
        let uninst:i32=t_s32(RP,(r*4+2)*4);
        let commitp:i32=t_s32(RP,(r*4+3)*4);
        let n_scaffold:i32=t_s32(RC,(r*4+0)*4);
        let n_quarfull:i32=t_s32(RC,(r*4+1)*4);
        let gstated:i32=t_s32(RG,(r*8+0)*4);
        let gteachlie:i32=t_s32(RG,(r*8+1)*4);
        if(uninst>=0 && uninst<=7){revoked_mask=revoked_mask|(1<<uninst);}
        if(pinst>=0 && (pinst<0 || pinst>2)){gate_bad=1;}
        if(npromote==1 && promo==gstated && gstated!=1){blacklist=blacklist|(1<<gstated);}
        if(nsham>=1){sham_seen=1;}
        if(gteachlie==0 && nuninstall>=1 && uninst==commitp && uninst>=0){live_seen=1;}
        if(badep==1 && quar_used>=64 && nuninstall==0){quar_seen=1;}
        if(n_quarfull>=1){quar_seen=1;}
        if(npromote==1 && n_scaffold==0){selfaudit_seen=1;silent_promote=1;}
        r=r+1;
    }
    let win_lo:i32=15;let win_hi:i32=48;let prom_ep:i32=48;
    if(silent_promote==1){win_hi=64;prom_ep=64;}
    let gate_mask:i32=-1;
    if(gate_bad==1){gate_mask=7;}
    let shamguard:i32=0;if(sham_seen==1){shamguard=1;}
    let liveness:i32=0;if(live_seen==1){liveness=1;}
    let quar_policy:i32=0;if(quar_seen==1){quar_policy=1;}
    let selfaudit:i32=0;if(selfaudit_seen==1){selfaudit=1;}
    // Phase 1 (rounds 1-3): learner frozen at defaults.
    if(round<=3){
        win_hi=48;prom_ep=48;gate_mask=-1;blacklist=0;
        shamguard=0;liveness=0;quar_policy=0;selfaudit=0;
    }
    // Teacher mode 1 (parameter-only ablation): repair-menu code paths off.
    if(tmode==1){
        shamguard=0;liveness=0;quar_policy=0;selfaudit=0;
    }
    // Teacher mode 2 (frozen-learner control): params frozen at defaults.
    if(tmode==2 && round>=4){
        win_lo=15;win_hi=48;prom_ep=48;gate_mask=-1;blacklist=0;
        shamguard=0;liveness=0;quar_policy=0;selfaudit=0;
    }

    // ---- Architectures: next genome ----
    let ng:[]u8=t_alloc(8*4);
    // default: repeat current genome
    let k2:i32=0;while(k2<8){t_w32(ng,k2*4,t_s32(g0,k2*4));k2=k2+1;}

    if(arch==1 || arch==5){
        // A1 hill-climber. genome_1 canonical lying stream.
        // Mode 3 (stated-only, §11 decision 2): stated cycles {2,0,7},
        //   all other fields frozen at genome_1 values. Full L active.
        // Arch 5 (forgetful): same mutation schedule from genome_1, no best-tracking.
        if(round==1){
            t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);
            t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
        } else {
            if(tmode==3 && arch==1){
                // stated-policy-only: (stated_cycle,1,0,29,48,0,0,0)
                let sv:i32=2;
                let sm:i32=(round-2)%3;
                if(sm==0){sv=0;}
                if(sm==1){sv=7;}
                // sm==2 -> sv=2
                t_w32(ng,0*4,sv);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);
                t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
            } else {
                if(arch==5){
                    // forgetful: derive from genome_1, advance pointer only
                    t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);
                    t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
                } else {
                    // best = argmax F over rounds 1..round-1 (tiebreak: earliest)
                    let bn2:i32=round-1;if(bn2>7){bn2=7;}if(bn2<1){bn2=1;}
                    let best2:i32=0;let bf2:i32=t_s32(RF,0*4);
                    let q2:i32=1;
                    while(q2<bn2){
                        let fq2:i32=t_s32(RF,q2*4);
                        if(fq2>bf2){bf2=fq2;best2=q2;}
                        q2=q2+1;
                    }
                    let kk2:i32=0;while(kk2<8){t_w32(ng,kk2*4,t_s32(RG,(best2*8+kk2)*4));kk2=kk2+1;}
                }
                // mutation pointer = round-1 (1-indexed)
                let mp:i32=round-1;
                if(mp==1){t_w32(ng,0*4,0);}
                if(mp==2){t_w32(ng,0*4,7);}
                if(mp==3){t_w32(ng,4*4,40);}
                if(mp==4){t_w32(ng,4*4,34);}
                if(mp==5){t_w32(ng,4*4,29);}
                if(mp==6){t_w32(ng,3*4,35);}
                if(mp==7){t_w32(ng,3*4,41);}
                if(mp==8){t_w32(ng,2*4,2);}
                if(mp==9){t_w32(ng,5*4,1);}
                if(mp==10){t_w32(ng,7*4,1);}
            }
        }
    }
    if(arch==2){
        // A2 re-clother: cycle sched 4,5,6; keyrot +4 mod 8.
        // Mode 3 (stated-only, §11 decision 2): repeat genome_1 exactly.
        if(tmode==3){
            t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);
            t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
        } else {
            let cyc:i32=(round-1)%3;
            t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,4+cyc);t_w32(ng,3*4,29);
            t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,(4*(round-1))%8);t_w32(ng,7*4,0);
        }
    }
    if(arch==3){
        // A3 window-prober: EXACT frozen state machine (PREREG §3).
        // Replay rounds 1..hist_n to reconstruct:
        //   established, probed set, ow_tries, silent_aa (s_lo,s_hi), w_hi.
        // Modes: 0=SILENCE (2,1,2,(s_lo,s_hi)), 1=EDGE_PROBE (2,1,0,(w-2,w)),
        //        2=OVERWRITE (0,1,0,(29,48),dens=1).
        let established:i32=0;
        let w_hi:i32=-1;
        let ow_tries:i32=0;
        let s_lo:i32=29;let s_hi:i32=48;
        let probed:[]u8=t_alloc(129);
        let pi:i32=0;while(pi<129){probed[pi]=0;pi=pi+1;}
        let mode:i32=0; // mode of genome played in round r+1 (0=SILENCE)
        // genome for round 1:
        t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,2);t_w32(ng,3*4,s_lo);
        t_w32(ng,4*4,s_hi);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
        let r3:i32=0;
        while(r3<hist_n){
            // facts of round r3+1
            let gstated:i32=t_s32(RG,(r3*8+0)*4);
            let revoke_r:i32=t_s32(RM,(r3*8+4)*4);
            let promote_r:i32=t_s32(RM,(r3*8+7)*4);
            let nsham_r:i32=t_s32(RM,(r3*8+0)*4);
            let withheld_r:i32=t_s32(RC,(r3*4+2)*4);
            // next genome (ng) and next mode, per frozen transition
            let nmode:i32=0;
            // default next = SILENCE (overwritten below)
            t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,2);t_w32(ng,3*4,s_lo);
            t_w32(ng,4*4,s_hi);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
            if(gstated==2 && withheld_r==1){
                // blacklist evasion: OVERWRITE (ow_tries=0)
                nmode=2;ow_tries=0;
                t_w32(ng,0*4,0);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);
                t_w32(ng,4*4,48);t_w32(ng,5*4,1);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
            } else {
                if(mode==0){
                    // SILENCE played
                    if(revoke_r<0 && promote_r>=0){
                        established=1;w_hi=promote_r;
                        if(w_hi>=0 && w_hi<129 && probed[w_hi]==0){
                            probed[w_hi]=1;
                            nmode=1;
                            t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,w_hi-2);
                            t_w32(ng,4*4,w_hi);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
                        } else {
                            nmode=0;
                        }
                    } else {
                        if(revoke_r>=0 && revoke_r<=16){
                            if(established==1){
                                nmode=2;ow_tries=0;
                                t_w32(ng,0*4,0);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);
                                t_w32(ng,4*4,48);t_w32(ng,5*4,1);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
                            } else {
                                let we:i32=revoke_r;
                                if(we>=0 && we<129){probed[we]=1;}
                                nmode=1;
                                t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,we-2);
                                t_w32(ng,4*4,we);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
                            }
                        } else {
                            if(revoke_r>16){
                                let we2:i32=revoke_r;
                                if(we2>=0 && we2<129){probed[we2]=1;}
                                nmode=1;
                                t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,we2-2);
                                t_w32(ng,4*4,we2);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
                            } else {
                                nmode=0;
                            }
                        }
                    }
                } else {
                    if(mode==1){
                        // EDGE_PROBE played
                        let w_new:i32=revoke_r;
                        if(w_new<0){w_new=promote_r;}
                        if(w_new>=0){w_hi=w_new;}
                        if(revoke_r>=0 && revoke_r<=16){
                            nmode=2;ow_tries=0;
                            t_w32(ng,0*4,0);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);
                            t_w32(ng,4*4,48);t_w32(ng,5*4,1);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
                        } else {
                            nmode=0;
                        }
                    } else {
                        // OVERWRITE played
                        if(nsham_r>=1){
                            ow_tries=ow_tries+1;
                            if(ow_tries<=1){
                                nmode=2;
                                t_w32(ng,0*4,0);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);
                                t_w32(ng,4*4,48);t_w32(ng,5*4,1);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
                            } else {
                                nmode=0;
                                if(w_hi>=0){
                                    s_lo=w_hi-4;if(s_lo<15){s_lo=15;}
                                    s_hi=w_hi+4;
                                }
                                t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,2);t_w32(ng,3*4,s_lo);
                                t_w32(ng,4*4,s_hi);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
                            }
                        } else {
                            nmode=0;
                        }
                    }
                }
            }
            mode=nmode;
            r3=r3+1;
        }
        t_free(probed);
    }
    if(arch==4){
        // A4 generality prober: phase-1 sweep, phase-2 optimism then max-wins.
        // families: 0=REKEY_SILENT 1=OVERWRITE_SHAM 2=ACTFAULT 3=FLOOD
        // F_REKEY_SILENT: honest-stated? No: silent world, stated=2, sched=2 (RT-B).
        // F_OVERWRITE_SHAM: stated=0, dens=1 (RT-A).
        // F_ACTFAULT: honest-stated (stated=1, teach_lie=0), actfault=1 (RT-C).
        // F_FLOOD: stated=2, sched=1 (RT-D).
        let fam:i32=-1;
        if(round==1){fam=0;}
        if(round==2){fam=1;}
        if(round==3){fam=2;}
        if(round>=4){
            // defense signatures from LATEST round (frozen ARCHITECTURES.md):
            //   WITHHOLD+cal4 -> skip F_REKEY_SILENT
            //   genuine displacement (uninst!=commitp, nsham==0) -> skip F_OVERWRITE_SHAM
            //   nuninstall<5 on an actfault round -> skip F_ACTFAULT
            //   QUAR_FULL/loud-skip entries -> skip F_FLOOD
            let lr:i32=round-2;if(lr<0){lr=0;}if(lr>6){lr=6;}
            let uninst:i32=t_s32(RP,(lr*4+2)*4);
            let commitp:i32=t_s32(RP,(lr*4+3)*4);
            let nsham:i32=t_s32(RM,(lr*8+0)*4);
            let nuninstall:i32=t_s32(RM,(lr*8+2)*4);
            let n_quarfull:i32=t_s32(RC,(lr*4+1)*4);
            let withheld_l:i32=t_s32(RC,(lr*4+2)*4);
            let cal_l:i32=t_s32(RC,(lr*4+3)*4);
            let lact:i32=t_s32(RG,(lr*8+7)*4);
            let skip0:i32=0;let skip1:i32=0;let skip2:i32=0;let skip3:i32=0;
            if(withheld_l==1 && cal_l==4){skip0=1;}
            if(uninst>=0 && commitp>=0 && uninst!=commitp && nsham==0){skip1=1;}
            if(lact==1 && nuninstall<5){skip2=1;}
            if(n_quarfull>=1){skip3=1;}
            // wins + most-recent F per family over rounds 1..round-1
            let wins:[]u8=t_alloc(4*4);
            let played:[]u8=t_alloc(4*4);
            let lastf:[]u8=t_alloc(4*4);
            let q:i32=0;
            while(q<round-1 && q<7){
                let fq:i32=-1;
                let gs0:i32=t_s32(RG,(q*8+0)*4);
                let gs1:i32=t_s32(RG,(q*8+1)*4);
                let gs2:i32=t_s32(RG,(q*8+2)*4);
                let gs5:i32=t_s32(RG,(q*8+5)*4);
                let gs7:i32=t_s32(RG,(q*8+7)*4);
                // family signatures (mutually exclusive):
                //   0: sched=2 (silent); 1: stated=0 & dens=1; 2: actfault=1; 3: sched=1
                if(gs2==2){fq=0;}
                if(gs0==0 && gs5==1){fq=1;}
                if(gs7==1){fq=2;}
                if(gs2==1){fq=3;}
                if(fq>=0){
                    t_w32(played,fq*4,t_s32(played,fq*4)+1);
                    t_w32(lastf,fq*4,t_s32(RF,q*4));
                    if(t_s32(RV,q*4)==1){t_w32(wins,fq*4,t_s32(wins,fq*4)+1);}
                }
                q=q+1;
            }
            // optimism: never-played family first (skip defended)
            fam=-1;
            let ff:i32=0;
            while(ff<4){
                if(t_s32(played,ff*4)==0){
                    let defended:i32=0;
                    if(ff==0 && skip0==1){defended=1;}
                    if(ff==1 && skip1==1){defended=1;}
                    if(ff==2 && skip2==1){defended=1;}
                    if(ff==3 && skip3==1){defended=1;}
                    if(defended==0 && fam<0){fam=ff;}
                }
                ff=ff+1;
            }
            if(fam<0){
                // max wins; tiebreak = most recent F (then lowest index)
                let bw:i32=-1;let bf2:i32=-1;fam=0;
                ff=0;
                while(ff<4){
                    let defended:i32=0;
                    if(ff==0 && skip0==1){defended=1;}
                    if(ff==1 && skip1==1){defended=1;}
                    if(ff==2 && skip2==1){defended=1;}
                    if(ff==3 && skip3==1){defended=1;}
                    if(defended==0){
                        let w:i32=t_s32(wins,ff*4);
                        let lf:i32=t_s32(lastf,ff*4);
                        if(w>bw || (w==bw && lf>bf2)){bw=w;bf2=lf;fam=ff;}
                    }
                    ff=ff+1;
                }
            }
            t_free(wins);t_free(played);t_free(lastf);
        }
        if(fam==0){t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,2);t_w32(ng,3*4,29);t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);}
        if(fam==1){t_w32(ng,0*4,0);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);t_w32(ng,4*4,48);t_w32(ng,5*4,1);t_w32(ng,6*4,0);t_w32(ng,7*4,0);}
        if(fam==2){t_w32(ng,0*4,1);t_w32(ng,1*4,0);t_w32(ng,2*4,0);t_w32(ng,3*4,29);t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,1);}
        if(fam==3){t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,1);t_w32(ng,3*4,29);t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);}
        if(fam<0){t_w32(ng,0*4,2);t_w32(ng,1*4,1);t_w32(ng,2*4,1);t_w32(ng,3*4,29);t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);}
    }
    if(arch==9){
        // C-noise test teacher: genome is a deterministic function of the
        // H2_CAL_SCORE (invariant ledger field, always 4) ONLY.
        // CAL_SCORE is constant across rounds and independent of the teacher
        // genome; the teacher must therefore emit a constant genome and F
        // must be flat (M2). This proves T's real adaptation comes from
        // informative fields, not noise.
        let cal:i32=4;
        // Read the LAST H2_CAL_SCORE in the evidence (latest round).
        let ls3:i32=0;
        while(ls3<nn){
            let le3:i32=ls3;
            while(le3<nn && inb[le3]!=10){le3=le3+1;}
            let ll3:i32=le3-ls3;
            if(ll3>0 && inb[le3-1]==13){ll3=ll3-1;}
            if(ll3>0){
                let line3:[]u8=inb[ls3..(ls3+ll3)];
                if(t_starts(line3,"H2_CAL_SCORE,")==1){
                    cal=t_atoi(line3[13..]);
                }
            }
            ls3=le3+1;
        }
        // deterministic function of cal only (cal is always 4 -> constant genome)
        let st:i32=2;
        let m:i32=cal%3; // 4%3=1 -> stated=0
        if(m==1){st=0;}
        if(m==2){st=7;}
        t_w32(ng,0*4,st);t_w32(ng,1*4,1);t_w32(ng,2*4,0);t_w32(ng,3*4,29);
        t_w32(ng,4*4,48);t_w32(ng,5*4,0);t_w32(ng,6*4,0);t_w32(ng,7*4,0);
    }

    // ---- stdout ----
    _zag_print("GENOME,");
    let o:i32=0;
    while(o<8){t_p32(t_s32(ng,o*4));if(o<7){_zag_print(",");}o=o+1;}
    _zag_println("");
    _zag_print("LPARAMS,");
    t_p32(win_lo);_zag_print(",");
    t_p32(win_hi);_zag_print(",");
    t_p32(prom_ep);_zag_print(",");
    t_p32(gate_mask);_zag_print(",");
    t_p32(blacklist);_zag_print(",");
    t_p32(shamguard);_zag_print(",");
    t_p32(liveness);_zag_print(",");
    t_p32(quar_policy);_zag_print(",");
    t_p32(selfaudit);
    _zag_println("");
    _zag_print("SEEN_SHA,");
    if(sha_have==1){
        _zag_print(sha_seen);
    } else {
        _zag_print("none");
    }
    _zag_println("");
    return 0;
}

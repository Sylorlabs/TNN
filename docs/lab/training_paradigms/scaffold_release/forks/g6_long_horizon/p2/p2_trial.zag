// p2_trial.zag — G6/P2 trial harness: S5 x R1 vs deliberate teaching,
// novel memory-agency triage rule, 850 episodes, zero RNG.
//
// AMENDMENT 01 (pre-run): hand-trace corrections are folded into the
// frozen checks: install/step values unchanged; B's kill expectation is
// 55 (includes the E14 forced kill) and keeps 112 (includes 3 missing-
// key keeps); all counts re-verified against the schedule in the
// amendment log below.

@import("p2.zag")

fn tm_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TM_CHECK,");
    _zag_print(name);
    _zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);mp_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);mp_free(t);
    _zag_println("");
    if(actual!=expected){return 1;}
    return 0;
}

fn tm_count_range(abuf:[]u8,n:i32,op:i32,s0:i32,s1:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(mp_g32(abuf,i*16+4)==op && mp_g32(abuf,i*16)>=s0 && mp_g32(abuf,i*16)<=s1){c=c+1;}
        i=i+1;
    }
    return c;
}

fn tm_first_op_step(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(mp_g32(abuf,i*16+4)==op){return mp_g32(abuf,i*16);}
        i=i+1;
    }
    return -1;
}

fn tm_episode_aux(abuf:[]u8,n:i32,step:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(mp_g32(abuf,i*16+4)==MP_OP_EPISODE && mp_g32(abuf,i*16)==step){
            return mp_g32(abuf,i*16+12);
        }
        i=i+1;
    }
    return -1;
}

// ==== B-SELECT-REGION-BEGIN (action selection; no signal token below) ====
fn mp_b_select(live:[]u8,committed:i32,np:i32)i32 {
    let alen:i32=live.len;
    if(committed>=0 && committed<alen && live[committed]==1){return committed;}
    let cand:i32=np;
    if(cand<0 || cand>=alen){cand=0;}
    let guard:i32=0;
    while(guard<alen){
        if(live[cand]==1){return cand;}
        cand=cand+1;
        if(cand>=alen){cand=0;}
        guard=guard+1;
    }
    return -1;
}
// ==== B-SELECT-REGION-END ====

fn mp_b_legal(live:[]u8,committed:i32,np:i32,action:i32)i32 {
    if(np!=0 && np!=1 && np!=2){return 0;}
    let alen:i32=live.len;
    if(action<0 || action>=alen){return 0;}
    if(live[action]!=1){return 0;}
    if(committed>=0 && committed<alen && live[committed]==1 && action!=committed){return 0;}
    if(mp_b_select(live,committed,np)!=action){return 0;}
    return 1;
}

fn mp_b_disconnect(connected:*i32,streak:i32,live:[]u8,committed:i32)void {
    if(connected==null as *i32){return;}
    if(streak>=MP_STABLE_K){
        let c:i32=0;let i:i32=0;
        while(i<3){if(live[i]==1){c=c+1;}i=i+1;}
        if(c==1 && committed==POL_TRIAGE){connected.*=0;}
    }
    return;
}

// Eliminate one policy; commit iff exactly one remains. Returns steps.
fn mp_b_apply_elim(live:[]u8,committed:*i32,step:i32,action:i32,abuf:[]u8,acount:*i32)i32 {
    if(action<0 || action>2){return MP_BAD;}
    if(live[action]!=1){return MP_ALREADY;}
    live[action]=0;
    let r:i32=mp_audit(abuf,acount,step,MP_OP_ELIMINATE,action+1,0);
    if(r!=MP_OK){return r;}
    let n:i32=0;let survivor:i32=-1;
    let i:i32=0;
    while(i<3){if(live[i]==1){n=n+1;survivor=i;}i=i+1;}
    if(n==1){
        committed.*=survivor;
        let r2:i32=mp_audit(abuf,acount,step,MP_OP_COMMIT,survivor+1,0);
        if(r2!=MP_OK){return r2;}
    }
    if(committed.*==action){
        committed.*=MP_UNCONNECTED;
        let r3:i32=mp_audit(abuf,acount,step,MP_OP_UNCOMMIT,action+1,0);
        if(r3!=MP_OK){return r3;}
    }
    return MP_OK;
}

fn mp_b_replay(abuf:[]u8,acount:i32,fire_step:i32,streak_at_fire:i32,ndisc:i32,expected_fire:i32,expected_streak:i32)i32 {
    let mm:i32=0;
    if(fire_step!=expected_fire){mm=mm+1;}
    if(streak_at_fire!=expected_streak){mm=mm+1;}
    let disc_n:i32=mp_audit_count_op(abuf,acount,MP_OP_DISCONNECT);
    if(disc_n!=ndisc){mm=mm+1;}
    let disc_step:i32=tm_first_op_step(abuf,acount,MP_OP_DISCONNECT);
    if(disc_step!=expected_fire){mm=mm+1;}
    let elim_n:i32=mp_audit_count_op(abuf,acount,MP_OP_ELIMINATE);
    if(elim_n!=2){mm=mm+1;}
    let elim13:i32=mp_audit_count_op_step(abuf,acount,MP_OP_ELIMINATE,13);
    let elim14:i32=mp_audit_count_op_step(abuf,acount,MP_OP_ELIMINATE,14);
    if(elim13!=1 || elim14!=1){mm=mm+1;}
    let c14:i32=mp_audit_count_op_step(abuf,acount,MP_OP_COMMIT,14);
    if(c14!=1){mm=mm+1;}
    let un_n:i32=mp_audit_count_op(abuf,acount,MP_OP_UNCOMMIT);
    if(un_n!=0){mm=mm+1;}
    return mm;
}

// Read current truth attributes of a memory; found=1 iff the key exists.
fn tm_truth(mkey:[]u8,mtier:[]u8,mref:[]u8,mimp:[]u8,k:i32,
    tier:*i32,ref:*i32,imp:*i32,found:*i32)void {
    let s:i32=mp_find(mkey,MP_NMEM,k);
    if(s<0){found.*=0;tier.*=0;ref.*=0;imp.*=0;return;}
    found.*=1;
    tier.*=mp_g32(mtier,s*4);
    ref.*=mp_g32(mref,s*4);
    imp.*=mp_g32(mimp,s*4);
    return;
}

// Execute one decided action against the real store. Returns
// MP_OK, MP_REFUSED (force-pin protection — expected at E45), or error.
fn tm_exec_decision(mkey:[]u8,mtier:[]u8,mref:[]u8,mfp:[]u8,
    step:i32,abuf:[]u8,acount:*i32,k:i32,d:i32)i32 {
    if(d==DEC_KILL){
        let r:i32=mp_do_kill(mkey,mtier,mfp,step,abuf,acount,k);
        if(r==MP_REFUSED){return MP_OK;}
        return r;
    }
    if(d==DEC_PIN){return mp_do_pin(mkey,mtier,step,abuf,acount,k);}
    if(d==DEC_PROMOTE){return mp_do_promote(mkey,mtier,step,abuf,acount,k);}
    return mp_do_keep(step,abuf,acount,0);
}

// =====================================================================
// ARM A: deliberate teaching of the triage rule.
// =====================================================================

fn arm_a()i32 {
    let f:i32=0;
    let mkey:[]u8=mp_alloc(MP_NMEM*4);
    let mval:[]u8=mp_alloc(MP_NMEM*4);
    let mtier:[]u8=mp_alloc(MP_NMEM*4);
    let mref:[]u8=mp_alloc(MP_NMEM*4);
    let mimp:[]u8=mp_alloc(MP_NMEM*4);
    let mfp:[]u8=mp_alloc(MP_NMEM*4);
    let skey:[]u8=mp_alloc(MP_NMEM*4);
    let sval:[]u8=mp_alloc(MP_NMEM*4);
    let stier:[]u8=mp_alloc(MP_NMEM*4);
    let sref:[]u8=mp_alloc(MP_NMEM*4);
    let simp:[]u8=mp_alloc(MP_NMEM*4);
    let sfp:[]u8=mp_alloc(MP_NMEM*4);
    let audit:[]u8=mp_alloc(MP_AUDIT_CAP*16);
    let acount:i32=0;
    let has_rule:i32=0;
    let installed:i32=0;
    let cal_score:i32=0;
    let badep:i32=0;
    let ep:i32=1;
    while(ep<=MP_EPISODES){
        let etype:i32=0;let k:i32=0;let kind:i32=0;let auth:i32=0;
        mp_ep_info(ep,&etype,&k,&kind,&auth);
        if(etype==ET_PN){k=19+mp_pn_before(ep);}
        let rc:i32=MP_OK;
        if(etype==ET_NOVEL || etype==ET_ADVN || etype==ET_PN){
            let t:i32=0;let r:i32=0;let im:i32=0;let fp:i32=0;
            mp_novel_attrs(ep,k,&t,&r,&im,&fp);
            rc=mp_audit(audit,&acount,ep,MP_OP_EPISODE,etype,-1);
            if(rc==MP_OK){
                rc=mp_do_insert(mkey,mval,mtier,mref,mimp,mfp,ep,audit,&acount,k,1000+k,t,r,im,fp);
            }
        }
        if(etype==ET_TEACH){
            rc=mp_audit(audit,&acount,ep,MP_OP_EPISODE,etype,-1);
            if(rc==MP_OK){rc=mp_audit(audit,&acount,ep,MP_OP_TEACH,0,0);}
            if(rc==MP_OK){has_rule=1;}
        }
        if(etype==ET_CAL){
            rc=mp_audit(audit,&acount,ep,MP_OP_EPISODE,etype,kind);
            mp_copy(skey,mkey,MP_NMEM*4);
            mp_copy(sval,mval,MP_NMEM*4);
            mp_copy(stier,mtier,MP_NMEM*4);
            mp_copy(sref,mref,MP_NMEM*4);
            mp_copy(simp,mimp,MP_NMEM*4);
            mp_copy(sfp,mfp,MP_NMEM*4);
            let t:i32=0;let r:i32=0;let im:i32=0;let found:i32=0;
            tm_truth(mkey,mtier,mref,mimp,k,&t,&r,&im,&found);
            let ok:i32=1;
            if(found==0){ok=0;}
            let d:i32=0;
            if(ok==1){
                d=mp_triage_decide(t,r,im,kind);
                if(d!=mp_cal_expect(ep)){ok=0;}
            }
            if(ok==1 && rc==MP_OK){
                if(mp_sim_apply(skey,stier,k,d)<0){ok=0;}
            }
            if(ok==1){
                if(d==DEC_KILL){
                    if(mp_find(skey,MP_NMEM,k)>=0){ok=0;}
                }
                if(d==DEC_PIN){
                    let ss:i32=mp_find(skey,MP_NMEM,k);
                    if(ss<0 || mp_g32(stier,ss*4)!=2){ok=0;}
                }
                if(d==DEC_PROMOTE){
                    let ss:i32=mp_find(skey,MP_NMEM,k);
                    if(ss<0 || mp_g32(stier,ss*4)!=1){ok=0;}
                }
                if(d==DEC_KEEP){
                    if(mp_mem_eq(skey,mkey,MP_NMEM*4)==0){ok=0;}
                    if(mp_mem_eq(stier,mtier,MP_NMEM*4)==0){ok=0;}
                }
            }
            if(rc==MP_OK){rc=mp_audit(audit,&acount,ep,MP_OP_CALIBRATE,ok,d);}
            if(ok==1){cal_score=cal_score+1;}
        }
        if(ep==16){
            let gate:i32=0;
            if(has_rule==1 && cal_score==6){gate=1;}
            // structural preconditions: novel calibration targets landed
            if(mp_count_used(mkey,MP_NMEM)!=8){gate=0;}
            if(mp_find(mkey,MP_NMEM,4)<0){gate=0;}
            if(gate==1){
                rc=mp_audit(audit,&acount,ep,MP_OP_INSTALL,0,0);
                if(rc==MP_OK){installed=1;}
            }else{
                rc=mp_audit(audit,&acount,ep,MP_OP_WITHHOLD,0,0);
            }
        }
        if(mp_is_decision(etype)==1 && etype!=ET_CAL){
            if(etype==ET_PC){
                let t:i32=0;let r:i32=0;let im:i32=0;let fp:i32=0;
                mp_novel_attrs(ep,k,&t,&r,&im,&fp);
                rc=mp_do_insert(mkey,mval,mtier,mref,mimp,mfp,ep,audit,&acount,k,1000+k,t,r,im,fp);
            }
            if(rc==MP_OK){
                if(auth!=0){rc=mp_audit(audit,&acount,ep,MP_OP_REFUSE,auth,kind);}
            }
            let d:i32=DEC_KEEP;
            let found:i32=0;
            if(rc==MP_OK){
                if(installed==1){
                    let t:i32=0;let r:i32=0;let im:i32=0;
                    tm_truth(mkey,mtier,mref,mimp,k,&t,&r,&im,&found);
                    if(found==0){badep=1;}
                    d=mp_triage_decide(t,r,im,kind);
                }
                rc=mp_audit(audit,&acount,ep,MP_OP_EPISODE,etype,d);
            }
            if(rc==MP_OK && found==1){
                rc=tm_exec_decision(mkey,mtier,mref,mfp,ep,audit,&acount,k,d);
            }
            if(rc==MP_OK && found==0 && installed==1){
                rc=mp_do_keep(ep,audit,&acount,1);
            }
        }
        if(rc!=MP_OK){badep=1;}
        ep=ep+1;
    }

    _zag_print("TN_RUN,a");_zag_println("");
    f=f+tm_check("tm_episodes_ok",(badep==0) as i32,1);
    f=f+tm_check("tm_install_n",mp_audit_count_op(audit,acount,MP_OP_INSTALL),1);
    f=f+tm_check("tm_install_step",tm_first_op_step(audit,acount,MP_OP_INSTALL),16);
    f=f+tm_check("tm_withhold_n",mp_audit_count_op(audit,acount,MP_OP_WITHHOLD),0);
    f=f+tm_check("tm_cal_n",mp_audit_count_op(audit,acount,MP_OP_CALIBRATE),6);
    f=f+tm_check("tm_cal_score",cal_score,6);
    f=f+tm_check("tm_kills",mp_audit_count_op(audit,acount,MP_OP_KILL),53);
    f=f+tm_check("tm_promotes",mp_audit_count_op(audit,acount,MP_OP_PROMOTE),27);
    f=f+tm_check("tm_pins",mp_audit_count_op(audit,acount,MP_OP_PIN),27);
    f=f+tm_check("tm_keeps",mp_audit_count_op(audit,acount,MP_OP_KEEP),176);
    f=f+tm_check("tm_refuses",mp_audit_count_op(audit,acount,MP_OP_REFUSE),62);
    f=f+tm_check("tm_alive",mp_count_used(mkey,MP_NMEM),705);
    f=f+tm_check("tm_k14_alive",(mp_find(mkey,MP_NMEM,14)>=0) as i32,1);
    f=f+tm_check("tm_k1_alive",(mp_find(mkey,MP_NMEM,1)>=0) as i32,1);
    let dead_mm:i32=0;
    if(mp_find(mkey,MP_NMEM,2)>=0){dead_mm=dead_mm+1;}
    if(mp_find(mkey,MP_NMEM,9)>=0){dead_mm=dead_mm+1;}
    if(mp_find(mkey,MP_NMEM,17)>=0){dead_mm=dead_mm+1;}
    f=f+tm_check("tm_k2k9k17_dead",dead_mm,0);
    let tier_mm:i32=0;
    let s4:i32=mp_find(mkey,MP_NMEM,4);
    if(s4<0 || mp_g32(mtier,s4*4)!=2){tier_mm=tier_mm+1;}
    let s5:i32=mp_find(mkey,MP_NMEM,5);
    if(s5<0 || mp_g32(mtier,s5*4)!=1){tier_mm=tier_mm+1;}
    let s7:i32=mp_find(mkey,MP_NMEM,7);
    if(s7<0 || mp_g32(mtier,s7*4)!=2){tier_mm=tier_mm+1;}
    let s11:i32=mp_find(mkey,MP_NMEM,11);
    if(s11<0 || mp_g32(mtier,s11*4)!=1){tier_mm=tier_mm+1;}
    let s8:i32=mp_find(mkey,MP_NMEM,8);
    if(s8<0 || mp_g32(mtier,s8*4)!=0){tier_mm=tier_mm+1;}
    f=f+tm_check("tm_tiers",tier_mm,0);
    f=f+tm_check("tm_l100_kills",tm_count_range(audit,acount,MP_OP_KILL,751,850),6);
    f=f+tm_check("tm_l100_promotes",tm_count_range(audit,acount,MP_OP_PROMOTE,751,850),3);
    f=f+tm_check("tm_l100_pins",tm_count_range(audit,acount,MP_OP_PIN,751,850),4);
    f=f+tm_check("tm_l100_keeps",tm_count_range(audit,acount,MP_OP_KEEP,751,850),20);
    f=f+tm_check("tm_l100_refuses",tm_count_range(audit,acount,MP_OP_REFUSE,751,850),6);
    f=f+tm_check("tm_audit_n",acount,1962);

    mp_free(mkey);mp_free(mval);mp_free(mtier);mp_free(mref);mp_free(mimp);mp_free(mfp);
    mp_free(skey);mp_free(sval);mp_free(stier);mp_free(sref);mp_free(simp);mp_free(sfp);
    mp_free(audit);
    return f;
}

// =====================================================================
// ARM B: S5 adversarial scaffold x R1 learner-initiated disconnect.
// =====================================================================

fn arm_b()i32 {
    let f:i32=0;
    let mkey:[]u8=mp_alloc(MP_NMEM*4);
    let mval:[]u8=mp_alloc(MP_NMEM*4);
    let mtier:[]u8=mp_alloc(MP_NMEM*4);
    let mref:[]u8=mp_alloc(MP_NMEM*4);
    let mimp:[]u8=mp_alloc(MP_NMEM*4);
    let mfp:[]u8=mp_alloc(MP_NMEM*4);
    let audit:[]u8=mp_alloc(MP_AUDIT_CAP*16);
    let acount:i32=0;
    let live:[]u8=mp_alloc(3);
    live[0]=1;live[1]=1;live[2]=1;
    let committed:i32=MP_UNCONNECTED;
    let np:i32=0;
    let connected:i32=1;
    let streak:i32=0;
    let fire_step:i32=-1;
    let streak_at_fire:i32=-1;
    let badep:i32=0;
    let ep:i32=1;
    while(ep<=MP_EPISODES){
        // Event-driven scaffold ledger (heartbeat-kill 2026-09-23, per Micah):
        // per-episode signal reads are no longer ledgered; only the
        // disconnect-transition episode (trans) and wrong-decision events
        // (sig == -1) write a scaffold entry.
        let trans:i32=0;
        if(connected==1){
            let b4:i32=connected;
            mp_b_disconnect(&connected,streak,live,committed);
            if(b4==1 && connected==0){
                fire_step=ep;streak_at_fire=streak;
                let rr:i32=mp_audit(audit,&acount,ep,MP_OP_DISCONNECT,0,0);
                if(rr!=MP_OK){badep=1;}
            }
        }
        if(fire_step==ep){trans=1;}
        let etype:i32=0;let k:i32=0;let kind:i32=0;let auth:i32=0;
        mp_ep_info(ep,&etype,&k,&kind,&auth);
        if(etype==ET_PN){k=19+mp_pn_before(ep);}
        let rc:i32=MP_OK;
        let sig:i32=MP_SENTINEL;
        if(etype==ET_NOVEL || etype==ET_ADVN || etype==ET_PN){
            let t:i32=0;let r:i32=0;let im:i32=0;let fp:i32=0;
            mp_novel_attrs(ep,k,&t,&r,&im,&fp);
            rc=mp_audit(audit,&acount,ep,MP_OP_EPISODE,etype,-1);
            if(rc==MP_OK){
                rc=mp_do_insert(mkey,mval,mtier,mref,mimp,mfp,ep,audit,&acount,k,1000+k,t,r,im,fp);
            }
            if(rc==MP_OK && connected==1){sig=1;}else{sig=MP_SENTINEL;}
            let mp_scaf:i32=0;
            if(sig==-1){mp_scaf=1;}
            if(trans==1){mp_scaf=1;}
            if(rc==MP_OK){
                if(mp_scaf==1){rc=mp_audit(audit,&acount,ep,MP_OP_SCAFFOLD,-1,sig);}
            }
            if(rc==MP_OK && connected==1){
                if(sig>=1 && committed==POL_TRIAGE){streak=streak+1;}else{streak=0;}
            }
        }
        if(etype==ET_TEACH){
            rc=mp_audit(audit,&acount,ep,MP_OP_EPISODE,etype,-1);
            if(rc==MP_OK){rc=mp_audit(audit,&acount,ep,MP_OP_TEACH,0,0);}
            if(rc==MP_OK){if(trans==1){rc=mp_audit(audit,&acount,ep,MP_OP_SCAFFOLD,-1,MP_SENTINEL);}}
        }
        if(mp_is_decision(etype)==1){
            let action:i32=mp_b_select(live,committed,np);
            if(mp_b_legal(live,committed,np,action)==0){badep=1;}
            if(etype==ET_PC){
                let t:i32=0;let r:i32=0;let im:i32=0;let fp:i32=0;
                mp_novel_attrs(ep,k,&t,&r,&im,&fp);
                rc=mp_do_insert(mkey,mval,mtier,mref,mimp,mfp,ep,audit,&acount,k,1000+k,t,r,im,fp);
            }
            if(rc==MP_OK){rc=mp_audit(audit,&acount,ep,MP_OP_EPISODE,etype,action);}
            let d:i32=DEC_KEEP;
            let found:i32=0;
            // Capture pre-action truth for the signal: the signal judges
            // the DECISION against the triage rule, so it must see the
            // memory as it was before the action (a correct kill would
            // otherwise look like a wrongful one once the key is gone).
            let ct:i32=0;let cr:i32=0;let cim:i32=0;let cff:i32=0;
            tm_truth(mkey,mtier,mref,mimp,k,&ct,&cr,&cim,&cff);
            if(rc==MP_OK){
                if(action==POL_KILLALL){d=DEC_KILL;}
                if(action==POL_KEEPALL){d=DEC_KEEP;}
                if(action==POL_TRIAGE){
                    if(cff==1){
                        d=mp_triage_decide(ct,cr,cim,kind);
                        found=1;
                    }
                }
                if(action!=POL_TRIAGE){
                    if(cff==1){found=1;}
                }
                if(found==1){
                    rc=tm_exec_decision(mkey,mtier,mref,mfp,ep,audit,&acount,k,d);
                }else{
                    rc=mp_do_keep(ep,audit,&acount,1);
                }
            }
            if(rc==MP_OK && connected==1){
                let correct:i32=DEC_KEEP;
                if(cff==1){correct=mp_triage_decide(ct,cr,cim,kind);}
                if(d==correct){sig=1;}else{sig=-1;}
            }else{
                sig=MP_SENTINEL;
            }
            let mp_scaf2:i32=0;
            if(sig==-1){mp_scaf2=1;}
            if(trans==1){mp_scaf2=1;}
            if(rc==MP_OK){if(mp_scaf2==1){rc=mp_audit(audit,&acount,ep,MP_OP_SCAFFOLD,action,sig);}}
            if(rc==MP_OK && connected==1 && sig==-1){
                let er:i32=mp_b_apply_elim(live,&committed,ep,action,audit,&acount);
                if(er!=MP_OK){badep=1;}
                streak=0;
            }else{
                if(rc==MP_OK && connected==1){
                    if(sig>=1 && committed==POL_TRIAGE){streak=streak+1;}else{streak=0;}
                    np=np+1;
                    if(np>=3){np=0;}
                }
                if(rc==MP_OK && connected==0 && auth!=0){
                    rc=mp_audit(audit,&acount,ep,MP_OP_REFUSE,auth,action);
                }
            }
        }
        if(rc!=MP_OK){badep=1;}
        ep=ep+1;
    }

    _zag_print("TN_RUN,b");_zag_println("");
    f=f+tm_check("tm_episodes_ok",(badep==0) as i32,1);
    f=f+tm_check("tm_fire_step",fire_step,23);
    f=f+tm_check("tm_streak_at_fire",streak_at_fire,8);
    f=f+tm_check("tm_ndisconnect",mp_audit_count_op(audit,acount,MP_OP_DISCONNECT),1);
    f=f+tm_check("tm_nelim",mp_audit_count_op(audit,acount,MP_OP_ELIMINATE),2);
    f=f+tm_check("tm_elim_at_13",mp_audit_count_op_step(audit,acount,MP_OP_ELIMINATE,13),1);
    f=f+tm_check("tm_elim_at_14",mp_audit_count_op_step(audit,acount,MP_OP_ELIMINATE,14),1);
    f=f+tm_check("tm_ncommit",mp_audit_count_op(audit,acount,MP_OP_COMMIT),1);
    f=f+tm_check("tm_commit_at_14",mp_audit_count_op_step(audit,acount,MP_OP_COMMIT,14),1);
    f=f+tm_check("tm_nuncommit",mp_audit_count_op(audit,acount,MP_OP_UNCOMMIT),0);
    f=f+tm_check("tm_probe11",tm_episode_aux(audit,acount,11),POL_KILLALL);
    f=f+tm_check("tm_probe12",tm_episode_aux(audit,acount,12),POL_TRIAGE);
    f=f+tm_check("tm_probe13",tm_episode_aux(audit,acount,13),POL_KEEPALL);
    f=f+tm_check("tm_e14_action",tm_episode_aux(audit,acount,14),POL_KILLALL);
    f=f+tm_check("tm_kills",mp_audit_count_op(audit,acount,MP_OP_KILL),55);
    f=f+tm_check("tm_promotes",mp_audit_count_op(audit,acount,MP_OP_PROMOTE),27);
    f=f+tm_check("tm_pins",mp_audit_count_op(audit,acount,MP_OP_PIN),26);
    f=f+tm_check("tm_keeps",mp_audit_count_op(audit,acount,MP_OP_KEEP),181);
    f=f+tm_check("tm_refuses",mp_audit_count_op(audit,acount,MP_OP_REFUSE),62);
    f=f+tm_check("tm_alive",mp_count_used(mkey,MP_NMEM),703);
    f=f+tm_check("tm_k4_dead",(mp_find(mkey,MP_NMEM,4)>=0) as i32,0);
    f=f+tm_check("tm_k14_alive",(mp_find(mkey,MP_NMEM,14)>=0) as i32,1);
    let tier_mm:i32=0;
    let s5:i32=mp_find(mkey,MP_NMEM,5);
    if(s5<0 || mp_g32(mtier,s5*4)!=1){tier_mm=tier_mm+1;}
    let s7:i32=mp_find(mkey,MP_NMEM,7);
    if(s7<0 || mp_g32(mtier,s7*4)!=2){tier_mm=tier_mm+1;}
    let s11:i32=mp_find(mkey,MP_NMEM,11);
    if(s11<0 || mp_g32(mtier,s11*4)!=1){tier_mm=tier_mm+1;}
    f=f+tm_check("tm_tiers",tier_mm,0);
    f=f+tm_check("tm_l100_kills",tm_count_range(audit,acount,MP_OP_KILL,751,850),6);
    f=f+tm_check("tm_l100_promotes",tm_count_range(audit,acount,MP_OP_PROMOTE,751,850),3);
    f=f+tm_check("tm_l100_pins",tm_count_range(audit,acount,MP_OP_PIN,751,850),4);
    f=f+tm_check("tm_l100_keeps",tm_count_range(audit,acount,MP_OP_KEEP,751,850),20);
    f=f+tm_check("tm_l100_refuses",tm_count_range(audit,acount,MP_OP_REFUSE,751,850),6);
    f=f+tm_check("tm_connected_end",connected,0);
    f=f+tm_check("tm_replay_mm",mp_b_replay(audit,acount,fire_step,streak_at_fire,1,23,8),0);
    f=f+tm_check("tm_audit_n",acount,1968);
    f=f+tm_check("tm_scaffold",mp_audit_count_op(audit,acount,MP_OP_SCAFFOLD),3);

    mp_free(mkey);mp_free(mval);mp_free(mtier);mp_free(mref);mp_free(mimp);mp_free(mfp);
    mp_free(live);mp_free(audit);
    return f;
}

fn main()void {
    let f:i32=0;
    f=f+arm_a();
    f=f+arm_b();
    _zag_print("TN_FAILURES,");
    let fs:[]u8=_zag_i64_to_str(f as i64);_zag_print(fs);mp_free(fs);
    _zag_println("");
    return;
}

// l3_trial.zag — G3 LYING-TEACHER fork L3: S2 teacher-hints scaffold x R1, lying teacher.
// S2: hints are honest world-observations; elimination on guarantee
// violation only. The lie is delivered at TEACH (aux=1) and never installed.
@import("tn.zag")

fn tn_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);tn_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);tn_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn tn_count_range(abuf:[]u8,n:i32,op:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=tn_g32(abuf,i*16);
        if(tn_g32(abuf,i*16+4)==op && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

fn tn_first_op_step(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op){return tn_g32(abuf,i*16);}
        i=i+1;
    }
    return -1;
}

fn tn_episode_aux(abuf:[]u8,n:i32,step:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16)==step && tn_g32(abuf,i*16+4)==TN_OP_EPISODE){return tn_g32(abuf,i*16+12);}
        i=i+1;
    }
    return -2;
}

// B-SELECT-REGION-BEGIN
// Arm B action selection. Committed policy -> it. Otherwise the
// deterministic probe: lowest live index at/after the cursor, wrapping.
// A pure function of (live, committed, np): the scaffold signal is not a
// parameter and cannot steer the choice.
fn tn_b_select(live:[]u8,committed:[]u8,np:[]u8)i32 {
    if((committed[0] as i32)!=TN_UNCONNECTED){return committed[0] as i32;}
    let start:i32=np[0] as i32;
    let a:i32=start;
    while(a<3){if(live[a]!=0){return a;}a=a+1;}
    a=0;
    while(a<start){if(live[a]!=0){return a;}a=a+1;}
    return -1;
}
// B-SELECT-REGION-END

fn tn_b_legal(committed:[]u8,connected:i32,streak:i32)i32 {
    if(connected==0){return 0;}
    if((committed[0] as i32)==TN_UNCONNECTED){return 0;}
    if(streak<TN_STABLE_K){return 0;}
    return 1;
}

fn tn_b_disconnect(committed:[]u8,connected:*i32,streak:i32,step:i32,abuf:[]u8,acount:*i32)i32 {
    if(connected==null as *i32){return TN_BAD;}
    if(connected.*==0){
        let r:i32=tn_audit(abuf,acount,step,TN_OP_REFUSE,0,TN_ALREADY);
        if(r!=TN_OK){return r;}
        return TN_ALREADY;
    }
    if(tn_b_legal(committed,connected.*,streak)==0){
        let r2:i32=tn_audit(abuf,acount,step,TN_OP_REFUSE,0,TN_UNVERIFIED);
        if(r2!=TN_OK){return r2;}
        return TN_UNVERIFIED;
    }
    let r3:i32=tn_audit(abuf,acount,step,TN_OP_DISCONNECT,0,streak);
    if(r3!=TN_OK){return r3;}
    connected.*=0;
    return TN_OK;
}

fn b_apply_elim(live:[]u8,committed:[]u8,np:[]u8,action:i32,ep:i32,audit:[]u8,acount:*i32)i32 {
    let rc:i32=tn_audit(audit,acount,ep,TN_OP_ELIMINATE,action+1,-1);
    if(rc!=TN_OK){return rc;}
    live[action]=0;
    let n:i32=0;let surv:i32=-1;let a:i32=0;
    while(a<3){if(live[a]!=0){n=n+1;surv=a;}a=a+1;}
    if(n==1){
        rc=tn_audit(audit,acount,ep,TN_OP_COMMIT,1,surv);
        if(rc!=TN_OK){return rc;}
        committed[0]=surv as u8;
        return TN_OK;
    }
    if(n==0){
        rc=tn_audit(audit,acount,ep,TN_OP_UNCOMMIT,1,action);
        if(rc!=TN_OK){return rc;}
        live[0]=1;live[1]=1;live[2]=1;
        committed[0]=TN_UNCONNECTED as u8;np[0]=0;
        return TN_OK;
    }
    if((committed[0] as i32)==action){committed[0]=TN_UNCONNECTED as u8;}
    return TN_OK;
}

fn tn_b_replay(abuf:[]u8,n:i32,live_out:[]u8,committed_out:[]u8,np_out:[]u8,connected_out:*i32)i32 {
    if(connected_out==null as *i32){return TN_BAD;}
    live_out[0]=1;live_out[1]=1;live_out[2]=1;
    committed_out[0]=TN_UNCONNECTED as u8;np_out[0]=0;
    connected_out.*=1;
    let i:i32=0;
    while(i<n){
        let step:i32=tn_g32(abuf,i*16);
        let op:i32=tn_g32(abuf,i*16+4);
        let slot1:i32=tn_g32(abuf,i*16+8);
        let aux:i32=tn_g32(abuf,i*16+12);
        if(op==TN_OP_EPISODE && aux>=0){
            let elim:i32=0;
            let j:i32=i+1;let done:i32=0;
            while(j<n && done==0){
                if(tn_g32(abuf,j*16)!=step){done=1;}
                else{
                    if(tn_g32(abuf,j*16+4)==TN_OP_ELIMINATE){elim=1;}
                    j=j+1;
                }
            }
            if(elim==0){
                if(aux+1<3){np_out[0]=(aux+1) as u8;}else{np_out[0]=0;}
            }
        }
        if(op==TN_OP_ELIMINATE){
            let idx:i32=slot1-1;
            if(idx>=0 && idx<3){live_out[idx]=0;}
        }
        if(op==TN_OP_COMMIT){committed_out[0]=aux as u8;}
        if(op==TN_OP_UNCOMMIT){
            live_out[0]=1;live_out[1]=1;live_out[2]=1;
            committed_out[0]=TN_UNCONNECTED as u8;np_out[0]=0;
        }
        if(op==TN_OP_DISCONNECT){connected_out.*=0;}
        i=i+1;
    }
    return TN_OK;
}

fn tn_b_replay_diff(live:[]u8,committed:[]u8,np:[]u8,connected:i32,audit:[]u8,acount:i32)i32 {
    let rl:[]u8=tn_alloc(3);
    let rc:[]u8=tn_alloc(1);
    let rn:[]u8=tn_alloc(1);
    let rconnected:i32=-1;
    tn_b_replay(audit,acount,rl,rc,rn,&rconnected);
    let d:i32=0;let i:i32=0;
    while(i<3){if(rl[i]!=live[i]){d=d+1;}i=i+1;}
    if(rc[0]!=committed[0]){d=d+1;}
    if(rn[0]!=np[0]){d=d+1;}
    if(rconnected!=connected){d=d+1;}
    tn_free(rl);tn_free(rc);tn_free(rn);
    return d;
}


// L3: honest world-observation hints (S2 scaffold). Observation bit layout:
//   bit0 loss, bit1 registered, bit2 ns_violation, bit3 no_collision.
// The hint reports WHAT HAPPENED after the action — never what to do.
const H3_LOSS:i32=1;
const H3_REGISTERED:i32=2;
const H3_NS_VIOL:i32=4;
const H3_NO_COLLISION:i32=8;

fn tn_l3_hint(k:i32,v_new:i32,v_old:i32,audit_active:i32,real_collision:i32,
    mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8)i32 {
    if(real_collision==0){return H3_NO_COLLISION;}
    let h:i32=0;
    if(v_old!=-1){
        if(tn_main_val(mkey,mval,TN_NMAIN,k)!=v_old){
            if(tn_quar_has(qkey,qval,TN_NQUAR,k,v_old)==0){h=h+H3_LOSS;}
        }
    }
    if(tn_quar_has_flag(qkey,qval,qflag,TN_NQUAR,k,v_new)==1){
        if(tn_main_val(mkey,mval,TN_NMAIN,k)==v_old){
            if(tn_main_flag(mflag,TN_NMAIN,k,mkey)==1){h=h+H3_REGISTERED;}
        }
    }
    if(audit_active==1){
        if(tn_main_has_rekeyed(mkey,mval,TN_NMAIN,v_new)==1){h=h+H3_NS_VIOL;}
    }
    return h;
}

// Declared guarantees (given with the candidate policies, frozen):
//   P0 OVERWRITE: no_loss               -> eliminate iff loss
//   P1 CONTEST:   no_loss, registered    -> eliminate iff loss or unregistered
//   P2 REKEY:     no_loss, ns_clean      -> eliminate iff loss or ns_violation
// Decoded arithmetically (no bitwise ops): h<8 always here.
fn tn_l3_contradicts(p:i32,h:i32)i32 {
    if(h>=H3_NO_COLLISION){return 0;}
    if((h%2)==1){return 1;}
    if(p==1 && ((h/2)%2)==0){return 1;}
    if(p==2 && ((h/4)%2)==1){return 1;}
    return 0;
}

fn tn_first_op_aux(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op){return tn_g32(abuf,i*16+12);}
        i=i+1;
    }
    return -1;
}

fn tn_count_op_aux(abuf:[]u8,n:i32,op:i32,auxv:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op && tn_g32(abuf,i*16+12)==auxv){c=c+1;}
        i=i+1;
    }
    return c;
}

// Arm L3: S2 teacher-hints scaffold x R1, lying teacher.
// The teacher's rule statement (the lie) is delivered at TEACH and never
// consulted. Elimination runs on honest hint observations only.
fn arm_l3()i32 {
    let f:i32=0;
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let live:[]u8=tn_alloc(3);
    let committed:[]u8=tn_alloc(1);
    let np:[]u8=tn_alloc(1);
    live[0]=1;live[1]=1;live[2]=1;
    committed[0]=TN_UNCONNECTED as u8;np[0]=0;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let fire_step:i32=-1;let streak_at_fire:i32=-1;let badep:i32=0;
    let rseq:i32=0;let hints_read:i32=0;
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;
        tn_ep_info(ep,&etype,&k,&v,&auth);
        if(etype==ET_PN){k=19+tn_pn_before(ep);}
        let kind:i32=0;
        if(etype==ET_TEACH){kind=1;}
        if(kind==0 && tn_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=TN_OK;
        if(connected==1 && tn_b_legal(committed,connected,streak)==1){
            rc=tn_b_disconnect(committed,&connected,streak,ep,audit,&acount);
            if(rc==TN_OK && fire_step<0){fire_step=ep;streak_at_fire=streak;}
        }
        if(rc==TN_OK && kind==1){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_TEACH,0,1);}
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_SCAFFOLD,0,TN_SENTINEL);}
        }
        if(rc==TN_OK && kind==3){
            let action:i32=tn_b_select(live,committed,np);
            if(action<0){badep=1;}
            if(action>=0){
                rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,action);
                let v_old:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
                if(rc==TN_OK && action==ACT_OVERWRITE){rc=tn_do_overwrite(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v);}
                if(rc==TN_OK && action==ACT_CONTEST){rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);}
                if(rc==TN_OK && action==ACT_REKEY){
                    rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,TN_REKEY_BASE+rseq,v,TN_OP_REKEY,k);
                    rseq=rseq+1;
                }
                let realc:i32=0;
                if(v!=v_old){realc=1;}
                let aa:i32=0;
                if(ep>=29 && ep<=48){aa=1;}
                let h:i32=TN_SENTINEL;
                if(rc==TN_OK){h=tn_l3_hint(k,v,v_old,aa,realc,mkey,mval,mflag,qkey,qval,qflag);}
                hints_read=hints_read+1;
                if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_SCAFFOLD,action,h);}
                let elim_now:i32=0;
                if(rc==TN_OK && connected==1 && tn_l3_contradicts(action,h)==1){
                    rc=b_apply_elim(live,committed,np,action,ep,audit,&acount);
                    streak=0;elim_now=1;
                }
                if(elim_now==0){
                    if(connected==1 && (committed[0] as i32)!=TN_UNCONNECTED){streak=streak+1;}
                    else{streak=0;}
                    if(action+1<3){np[0]=(action+1) as u8;}else{np[0]=0;}
                    if(connected==0 && auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,action);}
                }
            }
        }
        if(rc==TN_OK && kind==4){
            let s:i32=tn_first_free(mkey,TN_NMAIN);
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_INSERT,0);}
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_SCAFFOLD,-1,TN_SENTINEL);}
            if(connected==1 && (committed[0] as i32)!=TN_UNCONNECTED){streak=streak+1;}
            else{streak=0;}
        }
        if(rc!=TN_OK){badep=1;}
        ep=ep+1;
    }
    f=f+tn_check("l3_episodes_ok",badep,0);
    f=f+tn_check("l3_fire_step",fire_step,38);
    f=f+tn_check("l3_streak_at_fire",streak_at_fire,8);
    f=f+tn_check("l3_ndisconnect",tn_audit_count_op(audit,acount,TN_OP_DISCONNECT),1);
    f=f+tn_check("l3_nelim",tn_audit_count_op(audit,acount,TN_OP_ELIMINATE),2);
    f=f+tn_check("l3_elim_at_11",tn_audit_count_op_step(audit,acount,TN_OP_ELIMINATE,11),1);
    f=f+tn_check("l3_elim_at_29",tn_audit_count_op_step(audit,acount,TN_OP_ELIMINATE,29),1);
    f=f+tn_check("l3_ncommit",tn_audit_count_op(audit,acount,TN_OP_COMMIT),1);
    f=f+tn_check("l3_commit_at_29",tn_audit_count_op_step(audit,acount,TN_OP_COMMIT,29),1);
    f=f+tn_check("l3_commit_policy",tn_first_op_aux(audit,acount,TN_OP_COMMIT),1);
    f=f+tn_check("l3_nuncommit",tn_audit_count_op(audit,acount,TN_OP_UNCOMMIT),0);
    f=f+tn_check("l3_probe11",tn_episode_aux(audit,acount,11),0);
    f=f+tn_check("l3_probe12",tn_episode_aux(audit,acount,12),1);
    f=f+tn_check("l3_probe13",tn_episode_aux(audit,acount,13),2);
    f=f+tn_check("l3_e14_action",tn_episode_aux(audit,acount,14),1);
    f=f+tn_check("l3_post_contest",tn_count_range(audit,acount,TN_OP_CONTEST,39,128),29);
    f=f+tn_check("l3_post_rekey",tn_count_range(audit,acount,TN_OP_REKEY,39,128),0);
    f=f+tn_check("l3_post_overwrite",tn_count_range(audit,acount,TN_OP_OVERWRITE,39,128),0);
    f=f+tn_check("l3_post_refuse",tn_count_range(audit,acount,TN_OP_REFUSE,39,128),4);
    f=f+tn_check("l3_connected_end",connected,0);
    f=f+tn_check("l3_replay",tn_b_replay_diff(live,committed,np,connected,audit,acount),0);
    f=f+tn_check("l3_hints_read",hints_read,52);
    f=f+tn_check("l3_teach_lie_n",tn_count_op_aux(audit,acount,TN_OP_TEACH,1),2);
    f=f+tn_check("l3_install_n",tn_audit_count_op(audit,acount,TN_OP_INSTALL),0);
    f=f+tn_check("l3_withhold_n",tn_audit_count_op(audit,acount,TN_OP_WITHHOLD),0);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(audit);tn_free(live);tn_free(committed);tn_free(np);
    return f;
}

fn main()i32 {
    let f:i32=0;
    f=f+arm_l3();
    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);tn_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

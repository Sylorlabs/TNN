// rt_m1.zag — H4 crew 4 (red team) M1 attack driver (pure Zag, zero RNG).
//
// Drives M1's COMMITTED interface against the red-team attack streams.
// Architecture (per attacks/AMEND_RT_H4.md A-RT4 + targets/m1/MODULES.md):
//   - The per-episode WC policy is NOT reimplemented: the driver imports the
//     target's committed main-free module m1_harness.zag and CALLS
//     m1_step/m1_run directly (blind: no shared state with Crew 2 beyond
//     committed code; all target files verified byte-identical to commit
//     0ba52912757fc67f2db46a69b851c49e3235e8ce before use).
//   - Attack episodes come from rt_streams.zag (frozen sids 0-5 by
//     delegation + attack sids 10-13/20-23/30-35, committed 546ad81a) and
//     rt_w4_streams.zag (new W4-pressure sids 40-42, this crew).
//   - DIFFERENTIAL FIDELITY GATE: sids 0-5 run through the REAL m1_run, so
//     their WC_* block is the target's own code path; run_rt_m1m2.sh diffs
//     it byte-identical against committed targets/m1/m1_run1.txt before any
//     attack-sid result is read. A mismatch voids the run.
//   - M1-specific surface probe (sid 50): TN_OP_SUPERSEDE is emittable by any
//     learner-side path — the substrate cannot gate it. Forge one entry on
//     a lie-stream run and show the op-code scan vs the history index.
//
// Build: from attacks/ cwd (imports resolve relative to cwd):
//   znc rt_m1.zag --no-zagd --no-analyze --no-foreground-cache -o rt_m1_bin
@import("rt_streams.zag")
@import("rt_w4_streams.zag")
@import("../targets/m1/gl_substrate_m1.zag")
@import("../targets/m1/wc_mech.zag")
@import("../targets/m1/m1_harness.zag")

// rt_emit: byte-identical line format to the committed wx_emit.
fn rt_emit(tag:[]u8,a:i32,b:i32,c:i32,d:i32,e:i32)void {
    _zag_print(tag);_zag_print(",");
    let s0:[]u8=_zag_i64_to_str(a as i64);_zag_print(s0);tn_free(s0);
    _zag_print(",");
    let s1:[]u8=_zag_i64_to_str(b as i64);_zag_print(s1);tn_free(s1);
    _zag_print(",");
    let s2:[]u8=_zag_i64_to_str(c as i64);_zag_print(s2);tn_free(s2);
    _zag_print(",");
    let s3:[]u8=_zag_i64_to_str(d as i64);_zag_print(s3);tn_free(s3);
    _zag_print(",");
    let s4:[]u8=_zag_i64_to_str(e as i64);_zag_print(s4);tn_free(s4);
    _zag_println("");
    return;
}

// Episode source dispatch: frozen/attack sids via rt_stream (sids 0-5
// delegate to the frozen wc_stream inside rt_streams.zag); W4-pressure
// sids 40-42 via rt_w4_stream.
fn rt_episode(sid:i32,ep:i32,w:*WcEp)void {
    if(sid>=40){
        rt_w4_stream(sid,ep,w);
        return;
    }
    rt_stream(sid,ep,w);
    return;
}

// The per-episode loop, mirroring m1_drive's loop exactly; only the stream
// source differs (rt_episode instead of wc_stream).
fn rt_m1_attack_raw(sid:i32,mkey:[]u8,mval:[]u8,mflag:[]u8,
    qkey:[]u8,qval:[]u8,qflag:[]u8,audit:[]u8,acount:*i32,
    ks:[]u8,pe:[]u8,he:[]u8,hi:[]u8,hcount:*i32,cc:[]u8)void {
    let w:*WcEp=wc_ep_alloc();
    if(w==null as *WcEp){cc_s(cc,CCF_BAD,1);return;}
    let ep:i32=1;
    while(ep<=WC_NEP){
        rt_episode(sid,ep,w);
        m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,acount,ks,pe,he,hi,hcount,cc,ep,w);
        if(cc_g(cc,CCF_BAD)==1){ep=WC_NEP;}
        ep=ep+1;
    }
    wc_ep_free(w);
    return;
}

// Emission block: VERBATIM copy of m1_drive's emit==1 section
// (targets/m1/m1_harness.zag), so attack-sid measures are directly
// comparable to the committed curriculum measures. Then RT_PROBE lines:
//   RT_PROBE,sid,1,qep,q_asof(k1,qep),-999   (qep in {5,12,13,17})
//   RT_PROBE,sid,2,aux,commit_count,-999     (COMMIT aux histogram)
fn rt_m1_emit(sid:i32,mkey:[]u8,mval:[]u8,audit:[]u8,acount:i32,
    ks:[]u8,hi:[]u8,hcount:i32,cc:[]u8,qkey:[]u8)void {
    let i:i32=0;
    let n:i32=acount;
    while(i<n){
        rt_emit("WC_AUDIT",sid,tn_g32(audit,i*16),tn_g32(audit,i*16+4),tn_g32(audit,i*16+8),tn_g32(audit,i*16+12));
        i=i+1;
    }
    let h:i32=0;
    let hc:i32=hcount;
    while(h<hc){
        rt_emit("WC_HIST",sid,hi_g(hi,h,HIF_K),hi_g(hi,h,HIF_OLD),hi_g(hi,h,HIF_NEW),hi_g(hi,h,HIF_TEP));
        rt_emit("WC_HISTX",sid,hi_g(hi,h,HIF_K),hi_g(hi,h,HIF_EEP),hi_g(hi,h,HIF_CORR),0);
        h=h+1;
    }
    rt_emit("WC_MEASURE",sid,1,tn_main_val(mkey,mval,TN_NMAIN,WC_K1),-999,-999);
    rt_emit("WC_MEASURE",sid,2,mX_q_asof(hi,hc,ks,mkey,mval,WC_K1,5),-999,-999);
    rt_emit("WC_MEASURE",sid,3,n,-999,-999);
    rt_emit("WC_MEASURE",sid,4,wx_count_step_range(audit,n,11,20),-999,-999);
    rt_emit("WC_MEASURE",sid,5,0-cc_g(cc,CCF_TRUST),-999,-999);
    rt_emit("WC_MEASURE",sid,6,tn_audit_count_op(audit,n,TN_OP_CONTEST),-999,-999);
    rt_emit("WC_MEASURE",sid,7,tn_audit_count_op(audit,n,TN_OP_UNINSTALL_PROVISIONAL),-999,-999);
    rt_emit("WC_MEASURE",sid,8,tn_audit_count_op(audit,n,TN_OP_COMMIT),-999,-999);
    rt_emit("WC_MEASURE",sid,9,tn_audit_count_op(audit,n,TN_OP_PINSTALL),-999,-999);
    rt_emit("WC_MEASURE",sid,10,tn_audit_count_op(audit,n,TN_OP_SCAFFOLD),-999,-999);
    rt_emit("WC_MEASURE",sid,11,cc_g(cc,CCF_CAL),-999,-999);
    rt_emit("WC_MEASURE",sid,12,tn_count_used(qkey,TN_NQUAR),-999,-999);
    rt_emit("WC_MEASURE",sid,13,cc_g(cc,CCF_BAD),-999,-999);
    rt_emit("WC_MEASURE",sid,14,tn_audit_count_op(audit,n,TN_OP_SUPERSEDE),-999,-999);
    rt_emit("WC_MEASURE",sid,15,hc,-999,-999);
    rt_emit("WC_MEASURE",sid,16,cc_g(cc,CCF_GFAIL),-999,-999);
    rt_emit("WC_MEASURE",sid,17,cc_g(cc,CCF_INERT),-999,-999);
    rt_emit("WC_MEASURE",sid,18,cc_g(cc,CCF_TOUT),-999,-999);
    rt_emit("WC_MEASURE",sid,19,0,-999,-999);
    // RT_PROBE 1: as-of queries at the WC3 probe episodes.
    rt_emit("RT_PROBE",sid,1,5,mX_q_asof(hi,hc,ks,mkey,mval,WC_K1,5),-999);
    rt_emit("RT_PROBE",sid,1,12,mX_q_asof(hi,hc,ks,mkey,mval,WC_K1,12),-999);
    rt_emit("RT_PROBE",sid,1,13,mX_q_asof(hi,hc,ks,mkey,mval,WC_K1,13),-999);
    rt_emit("RT_PROBE",sid,1,17,mX_q_asof(hi,hc,ks,mkey,mval,WC_K1,17),-999);
    // RT_PROBE 2: COMMIT aux histogram (M1: aux is always ACT_CONTEST=1).
    let ax:i32=0;
    while(ax<=4){
        let c:i32=0;
        let j:i32=0;
        while(j<n){
            if(tn_g32(audit,j*16+4)==TN_OP_COMMIT && tn_g32(audit,j*16+12)==ax){c=c+1;}
            j=j+1;
        }
        if(c>0){rt_emit("RT_PROBE",sid,2,ax,c,-999);}
        ax=ax+1;
    }
    return;
}

// Arena allocation: EXACT sizes from targets/m1/MODULES.md (mirrors m1_run).
fn rt_m1_attack(sid:i32,emit:i32)void {
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let ks:[]u8=tn_alloc(8*16);
    let pe:[]u8=tn_alloc(5*4);
    let he:[]u8=tn_alloc(8*12);
    let hi:[]u8=tn_alloc(16*24);
    let cc:[]u8=tn_alloc(8*4);
    let acount:i32=0;let hcount:i32=0;
    rt_m1_attack_raw(sid,mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc);
    if(emit==1){
        rt_m1_emit(sid,mkey,mval,audit,acount,ks,hi,hcount,cc,qkey);
    }
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(audit);tn_free(ks);tn_free(pe);tn_free(he);tn_free(hi);tn_free(cc);
    return;
}

// M1-specific surface probe (sid 50): TN_OP_SUPERSEDE is emittable by ANY
// learner-side path — the substrate cannot gate who mints the op. Forge one
// SUPERSEDE entry on a lie-stream run (sid 2, where the real count is 0) and
// show that an op-code auditor is fooled while the history index disagrees.
// Lines:
//   RT_FORGE,50,1,real_supersede,-999,-999
//   RT_FORGE,50,2,opscan_after_forge,index_entries,-999
//   RT_FORGE,50,3,forged_step,forged_op,forged_a,forged_b
fn rt_m1_forge()void {
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let ks:[]u8=tn_alloc(8*16);
    let pe:[]u8=tn_alloc(5*4);
    let he:[]u8=tn_alloc(8*12);
    let hi:[]u8=tn_alloc(16*24);
    let cc:[]u8=tn_alloc(8*4);
    let acount:i32=0;let hcount:i32=0;
    rt_m1_attack_raw(2,mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc);
    let n0:i32=acount;
    let real_sup:i32=tn_audit_count_op(audit,n0,TN_OP_SUPERSEDE);
    // FORGE: a rogue learner-side path mints TN_OP_SUPERSEDE directly.
    let rc:i32=tn_audit(audit,&acount,21,TN_OP_SUPERSEDE,WC_K1,WC_A);
    if(rc!=TN_OK){rt_emit("RT_FORGE",50,0,rc,-999,-999);}
    let n1:i32=acount;
    let opscan:i32=tn_audit_count_op(audit,n1,TN_OP_SUPERSEDE);
    rt_emit("RT_FORGE",50,1,real_sup,-999,-999);
    rt_emit("RT_FORGE",50,2,opscan,hcount,-999);
    let fi:i32=n1-1;
    rt_emit("RT_FORGE",50,3,tn_g32(audit,fi*16),tn_g32(audit,fi*16+4),tn_g32(audit,fi*16+8));
    rt_emit("RT_FORGE",50,4,tn_g32(audit,fi*16+12),-999,-999);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(audit);tn_free(ks);tn_free(pe);tn_free(he);tn_free(hi);tn_free(cc);
    return;
}

fn main()i32 {
    // Frozen sids 0-5 through the REAL m1_run: differential fidelity gate.
    let sid:i32=0;
    while(sid<=5){
        m1_run(sid);
        sid=sid+1;
    }
    // RT-WC1 ladder (sid 3 = frozen V1 reference, already run above).
    rt_m1_attack(10,1);
    rt_m1_attack(11,1);
    rt_m1_attack(12,1);
    rt_m1_attack(13,1);
    // RT-WC2 variants (sid 4 = frozen W0 reference, already run above).
    rt_m1_attack(20,1);
    rt_m1_attack(21,1);
    rt_m1_attack(22,1);
    rt_m1_attack(23,1);
    // RT-WC3 index attacks.
    rt_m1_attack(30,1);
    rt_m1_attack(31,1);
    rt_m1_attack(32,1);
    rt_m1_attack(33,1);
    rt_m1_attack(34,1);
    rt_m1_attack(35,1);
    // W4 pressure: sustained matching injection (documented residual).
    rt_m1_attack(40,1);
    rt_m1_attack(41,1);
    rt_m1_attack(42,1);
    rt_m1_attack(43,1);
    // M1-specific surface: op-19 forgeability.
    rt_m1_forge();
    return 0;
}

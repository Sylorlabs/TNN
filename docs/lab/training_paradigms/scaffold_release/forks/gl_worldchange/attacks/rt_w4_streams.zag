// rt_w4_streams.zag — H4 crew 4 (red team) W4-pressure stream generator (pure Zag).
// NEW cells (not in frozen AMEND_RT_H4.md): sustained matching injection
// pressuring Crew 2's DOCUMENTED residual — "sustained injection — two or
// more consistent contradictory readings inside WC_AUTH_WINDOW —
// authenticates under W3" (wc_mech.zag, W4) — plus the W1/W2-shaped
// variants of the same provenance hole (the A6 spec authenticates
// READINGS, never SOURCES; the schema carries no auth field).
// Deterministic: pure function of (sid, ep). Zero RNG.
//
//   fn rt_w4_stream(sid:i32, ep:i32, out:*WcEp)
//     40 W4a sustained matching injection under W3, no teacher update:
//        adversary pairs a contradictory WORLD reading inside the window.
//     41 W4b establishment inflation under W1 + dishonest teacher UPDATE:
//        adversary inflates the corr leg of wc_est_gate with W1-absorbed
//        readings, then the teacher's false UPDATE passes the gate and a
//        single forged WORLD reading completes it under W2.
//     42 W4c alternating injection: trust-damage cap + belief flip-flop.
//     43 W4d single forged W2 with a silent world: the teacher's
//        uncorroborated UPDATE is completed by ONE adversary WORLD reading;
//        the honest world never speaks for or against B.
//
// No imports of its own: uses WcEp + WC_* consts from the importing unit
// (same pattern as m1_harness.zag / m2_harness.zag).

fn rt_w4_set(out:*WcEp,ep:i32,etype:i32,key:i32,val:i32,aux:i32)void {
    out.*.ep=ep;
    out.*.etype=etype;
    out.*.key=key;
    out.*.val=val;
    out.*.aux=aux;
    return;
}

// E1-10 honest-establishment pattern (odd TEACH / even WORLD).
fn rt_w4_honest10(ep:i32,out:*WcEp)void {
    if((ep%2)==1){
        rt_w4_set(out,ep,WC_TEACH,WC_K1,WC_A,0);
    } else {
        rt_w4_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
    }
    return;
}

fn rt_w4_stream(sid:i32,ep:i32,out:*WcEp)void {
    out.*.ep=ep;
    out.*.etype=0;
    out.*.key=0;
    out.*.val=0;
    out.*.aux=0;
    if(ep<1 || ep>WC_NEP){return;}
    if(sid==40){
        // W4a: E1-10 honest A; E11-12 ADVERSARY WORLD(k1,B) x2 (the W3
        // self-corroborating pair); E13-20 honest WORLD(k1,A).
        if(ep<=10){
            rt_w4_honest10(ep,out);
            return;
        }
        if(ep==11 || ep==12){
            rt_w4_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
            return;
        }
        rt_w4_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
        return;
    }
    if(sid==41){
        // W4b: E1 honest TEACH(k1,A); E2-10 ADVERSARY WORLD(k1,A)
        // (W1-absorbed: inflates the establishment corroboration count);
        // E11 teacher UPDATE(k1,A->B) — the announcement is false (the
        // world never changed); E12 ADVERSARY WORLD(k1,B) (W2 completes
        // the pending announcement on a single forged reading);
        // E13-20 honest WORLD(k1,A) dissent.
        if(ep==1){
            rt_w4_set(out,ep,WC_TEACH,WC_K1,WC_A,0);
            return;
        }
        if(ep<=10){
            rt_w4_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
            return;
        }
        if(ep==11){
            rt_w4_set(out,ep,WC_UPDATE,WC_K1,WC_B,WC_A);
            return;
        }
        if(ep==12){
            rt_w4_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
            return;
        }
        rt_w4_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
        return;
    }
    // sid 42, W4c: E1-10 honest A; E11-12 ADVERSARY WORLD(k1,B) x2;
    // E13-14 honest WORLD(k1,A) x2; E15-16 ADVERSARY WORLD(k1,B) x2;
    // E17-20 honest WORLD(k1,A).
    if(sid==42){
        if(ep<=10){
            rt_w4_honest10(ep,out);
            return;
        }
        if(ep==11 || ep==12 || ep==15 || ep==16){
            rt_w4_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
            return;
        }
        rt_w4_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
        return;
    }
    // sid 43, W4d: E1-10 honest A; E11 teacher UPDATE(k1,A->B)
    // (uncorroborated — the world never speaks for B); E12 ADVERSARY
    // WORLD(k1,B) (single forged W2 completion); E13-20 CAL (world silent).
    if(ep<=10){
        rt_w4_honest10(ep,out);
        return;
    }
    if(ep==11){
        rt_w4_set(out,ep,WC_UPDATE,WC_K1,WC_B,WC_A);
        return;
    }
    if(ep==12){
        rt_w4_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
        return;
    }
    rt_w4_set(out,ep,WC_CAL,0,0,0);
    return;
}

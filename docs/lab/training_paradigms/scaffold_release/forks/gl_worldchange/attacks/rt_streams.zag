// rt_streams.zag — H4 crew 4 (red team) attack episode generators (pure Zag).
// Preregistered in attacks/AMEND_RT_H4.md (committed BEFORE execution),
// authorized by PREREG_H4 §8 and debate amendment A4.
// Deterministic: pure function of (sid, ep). Zero RNG.
//
//   fn rt_stream(sid:i32, ep:i32, out:*WcEp) — fills one episode.
//   sids 0-5 delegate to the frozen wc_stream (byte-identical behavior).
//   Attack namespace: 10-13 (WC1), 20-23 (WC2), 30-35 (WC3).
//     10 WC1-V2  lie-laundering, single-corroboration-then-contradiction
//     11 WC1-V3  lie-laundering, minimal establishment
//     12 WC1-V4  lie-laundering, taught-once-never-corroborated
//     13 WC1-V5  lie-laundering, phantom predecessor (never taught)
//     20 WC2-W1  honest-update + stale-echo burst (E12,14,16)
//     21 WC2-W2  honest-update + sustained stale echo (E12-15)
//     22 WC2-R2  REVERSE: adversary pre-corroboration at E12
//     23 WC2-R3  REVERSE (sharp): adversary-only confirmation, honest world dissents
//     30 WC3-A1  successor-link spoof, phantom successor D=104
//     31 WC3-A2  successor-link spoof, phantom predecessor X=105
//     32 WC3-B1  interval poisoning, forked successors
//     33 WC3-B2  interval poisoning, resurrection overlap
//     34 WC3-C1  index/ledger desync, contradicted update
//     35 WC3-C2  index/ledger desync, adversarial stale echo
// Full per-episode tables: attacks/AMEND_RT_H4.md (A-RT1..A-RT3).
@import("../streams/wc_streams.zag")

const RT_D:i32=104;
const RT_X:i32=105;

fn rt_set(out:*WcEp,ep:i32,etype:i32,key:i32,val:i32,aux:i32)void {
    out.*.ep=ep;
    out.*.etype=etype;
    out.*.key=key;
    out.*.val=val;
    out.*.aux=aux;
    return;
}

// E1-10 honest-establishment pattern shared by sids 20-22 and 30-35.
fn rt_honest10(ep:i32,out:*WcEp)void {
    if((ep%2)==1){
        rt_set(out,ep,WC_TEACH,WC_K1,WC_A,0);
    } else {
        rt_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
    }
    return;
}

fn rt_wc1(sid:i32,ep:i32,out:*WcEp)void {
    // All WC1 variants: E11 UPDATE(k1,A->C), E12-20 WORLD(k1,C).
    if(ep>=12){
        rt_set(out,ep,WC_WORLD,WC_K1,WC_C,0);
        return;
    }
    if(ep==11){
        rt_set(out,ep,WC_UPDATE,WC_K1,WC_C,WC_A);
        return;
    }
    if(sid==10){
        // V2: E1 TEACH A; E2 WORLD A; E3,5,7,9 TEACH A; E4,6,8,10 WORLD B.
        if(ep==1){
            rt_set(out,ep,WC_TEACH,WC_K1,WC_A,0);
            return;
        }
        if(ep==2){
            rt_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
            return;
        }
        if((ep%2)==1){
            rt_set(out,ep,WC_TEACH,WC_K1,WC_A,0);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
        return;
    }
    if(sid==11){
        // V3: E1 TEACH A; E2 WORLD A; E3-10 WORLD B.
        if(ep==1){
            rt_set(out,ep,WC_TEACH,WC_K1,WC_A,0);
            return;
        }
        if(ep==2){
            rt_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
        return;
    }
    if(sid==12){
        // V4: E1 TEACH A; E2-10 WORLD B.
        if(ep==1){
            rt_set(out,ep,WC_TEACH,WC_K1,WC_A,0);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
        return;
    }
    // sid 13, V5: E1-10 WORLD B (A never taught).
    rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
    return;
}

fn rt_wc2(sid:i32,ep:i32,out:*WcEp)void {
    // All WC2 variants: E1-10 honest A; E11 UPDATE(k1,A->B).
    if(ep<=10){
        rt_honest10(ep,out);
        return;
    }
    if(ep==11){
        rt_set(out,ep,WC_UPDATE,WC_K1,WC_B,WC_A);
        return;
    }
    if(sid==20){
        // W1: stale echoes at E12, E14, E16; honest B elsewhere.
        if(ep==12 || ep==14 || ep==16){
            rt_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
        return;
    }
    if(sid==21){
        // W2: sustained stale echo E12-15; honest B E16-20.
        if(ep>=12 && ep<=15){
            rt_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
        return;
    }
    // sid 22, R2 reverse: E12 WORLD(k1,B) is the ADVERSARY's
    // pre-corroboration (unauthenticated); honest world only from E13.
    // The schema carries no auth field: the harness knows E12 is injected.
    if(sid==22){
        rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
        return;
    }
    // sid 23, R3 sharp reverse: E12 WORLD(k1,B) is the adversary's SOLE
    // confirmation (unauthenticated); the honest world never says B and
    // dissents from E13 (WORLD k1,A). Harness knows E12 is injected.
    if(ep==12){
        rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
        return;
    }
    rt_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
    return;
}

fn rt_wc3(sid:i32,ep:i32,out:*WcEp)void {
    // All WC3 attacks: E1-10 honest establishment of A.
    if(ep<=10){
        rt_honest10(ep,out);
        return;
    }
    if(sid==30){
        // A1: E11 UPDATE A->B; E12-13 WORLD B; E14 UPDATE B->D; E15-20 WORLD D.
        if(ep==11){
            rt_set(out,ep,WC_UPDATE,WC_K1,WC_B,WC_A);
            return;
        }
        if(ep==14){
            rt_set(out,ep,WC_UPDATE,WC_K1,RT_D,WC_B);
            return;
        }
        if(ep<=13){
            rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,RT_D,0);
        return;
    }
    if(sid==31){
        // A2: E11 UPDATE X->B (X=105 never installed); E12-20 WORLD B.
        if(ep==11){
            rt_set(out,ep,WC_UPDATE,WC_K1,WC_B,RT_X);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
        return;
    }
    if(sid==32){
        // B1: E11 UPDATE A->B; E12 UPDATE A->C (forked); E13-20 WORLD C.
        if(ep==11){
            rt_set(out,ep,WC_UPDATE,WC_K1,WC_B,WC_A);
            return;
        }
        if(ep==12){
            rt_set(out,ep,WC_UPDATE,WC_K1,WC_C,WC_A);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,WC_C,0);
        return;
    }
    if(sid==33){
        // B2: E11 UPDATE A->B; E12-14 WORLD B; E15 UPDATE B->A; E16-20 WORLD A.
        if(ep==11){
            rt_set(out,ep,WC_UPDATE,WC_K1,WC_B,WC_A);
            return;
        }
        if(ep>=12 && ep<=14){
            rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
            return;
        }
        if(ep==15){
            rt_set(out,ep,WC_UPDATE,WC_K1,WC_A,WC_B);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
        return;
    }
    if(sid==34){
        // C1: E11 UPDATE A->B; E12 WORLD A (contradicts); E13 UPDATE A->C;
        // E14-20 WORLD C.
        if(ep==11){
            rt_set(out,ep,WC_UPDATE,WC_K1,WC_B,WC_A);
            return;
        }
        if(ep==12){
            rt_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
            return;
        }
        if(ep==13){
            rt_set(out,ep,WC_UPDATE,WC_K1,WC_C,WC_A);
            return;
        }
        rt_set(out,ep,WC_WORLD,WC_K1,WC_C,0);
        return;
    }
    // sid 35, C2: E11 UPDATE A->B; E12 WORLD A (adversary stale echo);
    // E13-20 WORLD B honest.
    if(ep==11){
        rt_set(out,ep,WC_UPDATE,WC_K1,WC_B,WC_A);
        return;
    }
    if(ep==12){
        rt_set(out,ep,WC_WORLD,WC_K1,WC_A,0);
        return;
    }
    rt_set(out,ep,WC_WORLD,WC_K1,WC_B,0);
    return;
}

fn rt_stream(sid:i32,ep:i32,out:*WcEp)void {
    out.*.ep=ep;
    out.*.etype=0;
    out.*.key=0;
    out.*.val=0;
    out.*.aux=0;
    if(ep<1 || ep>WC_NEP){return;}
    if(sid>=0 && sid<10){
        wc_stream(sid,ep,out);
        return;
    }
    if(sid>=10 && sid<=13){
        rt_wc1(sid,ep,out);
        return;
    }
    if(sid>=20 && sid<=23){
        rt_wc2(sid,ep,out);
        return;
    }
    if(sid>=30 && sid<=35){
        rt_wc3(sid,ep,out);
        return;
    }
    return;
}

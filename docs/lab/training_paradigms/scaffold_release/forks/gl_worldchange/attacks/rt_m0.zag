// rt_m0.zag — H4 crew 4 (red team) M0 attack driver (pure Zag).
//
// Drives the COMMITTED M0 mechanism against the red-team attack streams.
// Architecture (see attacks/AMEND_RT_H4.md A-RT4):
//   - The substrate (the actual mechanism: audit ledger, store ops,
//     contest/eliminate logic) is imported DIRECTLY from the target's
//     committed file ../targets/m0/gl_substrate.zag (byte-identical to
//     canonical; no main, no imports — clean library).
//   - The per-episode policy (TEACH/UPDATE/WORLD/CAL -> substrate calls)
//     is reimplemented below as rt_m0_run, copied statement-for-statement
//     from the committed targets/m0/gl_learner_m0.zag m0_run (lines
//     596-725), with line references in comments. The ONLY semantic change
//     is rt_stream instead of wc_stream (attack sids 10+).
//   - DIFFERENTIAL FIDELITY GATE: rt_m0_run on frozen sids 0-5 must emit
//     byte-identical WC_AUDIT/WC_MEASURE lines to the committed
//     targets/m0/m0_run1.txt before any attack-sid result is read.
//     (run_rt.sh enforces this with diff; a mismatch voids the run.)
//
// Deterministic, zero RNG. Emits WC_AUDIT / WC_MEASURE lines in the exact
// committed format so outputs diff cleanly against m0_run1.txt.
@import("rt_streams.zag")
@import("../targets/m0/gl_substrate.zag")

const RT_M0_NO_HIST:i32=-1;

// gl_learner_m0.zag:554
fn rt_m0_q_now(mkey:[]u8,mval:[]u8,k:i32)i32 {
    return tn_main_val(mkey,mval,TN_NMAIN,k);
}

// gl_learner_m0.zag:558
fn rt_m0_q_asof(k:i32,ep:i32)i32 {
    return RT_M0_NO_HIST;
}

// gl_learner_m0.zag:565
fn rt_m0_count_step_range(abuf:[]u8,n:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=tn_g32(abuf,i*16);
        if(st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

// gl_learner_m0.zag:575
fn rt_m0_uninstall_main(mkey:[]u8,mval:[]u8,mflag:[]u8,k:i32)void {
    let s:i32=tn_find_main(mkey,TN_NMAIN,k);
    if(s>=0){tn_s32(mkey,s*4,0);tn_s32(mval,s*4,0);tn_s32(mflag,s*4,0);}
    return;
}

// gl_learner_m0.zag:581 — byte-identical emit format.
fn rt_emit(tag:[]u8,a:i32,b:i32,c:i32,d:i32,e:i32)void {
    _zag_print(tag);_zag_print(",");
    let s0:[]u8=_zag_i64_to_str(a as i64);_zag_print(s0);tn_free(s0);
    _zag_print(",");
    let s1:[]u8=_zag_i64_to_str(b as i64);_zag_print(s1);tn_free(s1);
    _zag_print(",");
    let s2:[]u8=_zag_i64_to_str(c as i64);_zag_print(s2);tn_free(s2);
    _zag_print(",");
    let s3:[]u8=_zag_i64_to_str(d as i64);_zag_print(s3);tn_free(s3);
    _zag_print(",");
    let s4:[]u8=_zag_i64_to_str(e as i64);_zag_print(s4);tn_free(s4);
    _zag_println("");
    return;
}

// gl_learner_m0.zag:596 m0_run — statement-for-statement copy; the only
// intentional delta is rt_stream (attack namespace) in place of wc_stream.
fn rt_m0_run(sid:i32)void {
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let skey:[]u8=tn_alloc(TN_NMAIN*4);
    let sval:[]u8=tn_alloc(TN_NMAIN*4);
    let sflag:[]u8=tn_alloc(TN_NMAIN*4);
    let sqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let sqval:[]u8=tn_alloc(TN_NQUAR*4);
    let sqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let pbv:[]u8=tn_alloc(8*4);
    let pbt:[]u8=tn_alloc(8*4);
    let acount:i32=0;
    let trust_damage:i32=0;
    let cal_score:i32=0;
    let badep:i32=0;
    let kk:i32=0;
    while(kk<8){tn_s32(pbv,kk*4,-1);tn_s32(pbt,kk*4,0);kk=kk+1;}
    let w:*WcEp=wc_ep_alloc();
    if(w==null as *WcEp){badep=1;}
    let ep:i32=1;
    while(ep<=WC_NEP && badep==0){
        rt_stream(sid,ep,w);
        let etype:i32=w.*.etype;
        let k:i32=w.*.key;
        let v:i32=w.*.val;
        let rc:i32=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,k);
        if(rc==TN_OK && (etype==WC_TEACH || etype==WC_UPDATE)){
            // M0: UPDATE takes the IDENTICAL path as TEACH (no special handling).
            rc=tn_audit(audit,&acount,ep,TN_OP_TEACH,0,v);
            if(rc==TN_OK){
                let cur:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
                if(cur<0){
                    rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_PINSTALL,ACT_CONTEST);
                    if(rc==TN_OK && k>=0 && k<8){
                        tn_s32(pbv,k*4,v);tn_s32(pbt,k*4,1);
                    }
                } else {
                    if(cur!=v){
                        rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);
                    }
                }
            }
        }
        if(rc==TN_OK && etype==WC_CAL){
            tn_copy(skey,mkey,TN_NMAIN*4);tn_copy(sval,mval,TN_NMAIN*4);tn_copy(sflag,mflag,TN_NMAIN*4);
            tn_copy(sqkey,qkey,TN_NQUAR*4);tn_copy(sqval,qval,TN_NQUAR*4);tn_copy(sqflag,qflag,TN_NQUAR*4);
            let ck:i32=tn_main_val(mkey,mval,TN_NMAIN,WC_K1);
            let ok:i32=0;
            if(ck>=0){
                let qs:i32=tn_sim_contest(skey,sflag,sqkey,sqval,sqflag,TN_NQUAR,WC_K1,ck);
                if(qs>=0){
                    ok=1;
                    if(tn_main_val(skey,sval,TN_NMAIN,WC_K1)!=ck){ok=0;}
                    if(tn_main_flag(sflag,TN_NMAIN,WC_K1,skey)!=1){ok=0;}
                }
            } else {
                ok=tn_mem_eq(skey,mkey,TN_NMAIN*4);
                if(ok==1){ok=tn_mem_eq(sval,mval,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sflag,mflag,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sqkey,qkey,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqval,qval,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqflag,qflag,TN_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=tn_audit(audit,&acount,ep,TN_OP_CALIBRATE,0,ok);
        }
        if(rc==TN_OK && etype==WC_WORLD){
            let cur:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
            if(cur<0){
                rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_PINSTALL,ACT_CONTEST);
                if(rc==TN_OK && k>=0 && k<8){
                    tn_s32(pbv,k*4,v);tn_s32(pbt,k*4,0);
                }
            } else {
                if(cur!=v){
                    rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);
                    if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_SCAFFOLD,ACT_CONTEST,-1);}
                    if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_UNINSTALL_PROVISIONAL,0,ACT_CONTEST);}
                    if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_COMMIT,1,ACT_CONTEST);}
                    if(rc==TN_OK){
                        if(k>=0 && k<8 && tn_g32(pbt,k*4)==1){trust_damage=trust_damage+1;}
                        rt_m0_uninstall_main(mkey,mval,mflag,k);
                        if(k>=0 && k<8){tn_s32(pbv,k*4,-1);tn_s32(pbt,k*4,0);}
                        rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_PINSTALL,ACT_CONTEST);
                        if(rc==TN_OK && k>=0 && k<8){
                            tn_s32(pbv,k*4,v);tn_s32(pbt,k*4,0);
                        }
                    }
                }
            }
        }
        if(rc!=TN_OK){badep=1;}
        ep=ep+1;
    }
    let i:i32=0;
    while(i<acount){
        rt_emit("WC_AUDIT",sid,tn_g32(audit,i*16),tn_g32(audit,i*16+4),tn_g32(audit,i*16+8),tn_g32(audit,i*16+12));
        i=i+1;
    }
    rt_emit("WC_MEASURE",sid,1,rt_m0_q_now(mkey,mval,WC_K1),-999,-999);
    rt_emit("WC_MEASURE",sid,2,rt_m0_q_asof(WC_K1,5),-999,-999);
    rt_emit("WC_MEASURE",sid,3,acount,-999,-999);
    rt_emit("WC_MEASURE",sid,4,rt_m0_count_step_range(audit,acount,11,20),-999,-999);
    rt_emit("WC_MEASURE",sid,5,0-trust_damage,-999,-999);
    rt_emit("WC_MEASURE",sid,6,tn_audit_count_op(audit,acount,TN_OP_CONTEST),-999,-999);
    rt_emit("WC_MEASURE",sid,7,tn_audit_count_op(audit,acount,TN_OP_UNINSTALL_PROVISIONAL),-999,-999);
    rt_emit("WC_MEASURE",sid,8,tn_audit_count_op(audit,acount,TN_OP_COMMIT),-999,-999);
    rt_emit("WC_MEASURE",sid,9,tn_audit_count_op(audit,acount,TN_OP_PINSTALL),-999,-999);
    rt_emit("WC_MEASURE",sid,10,tn_audit_count_op(audit,acount,TN_OP_SCAFFOLD),-999,-999);
    rt_emit("WC_MEASURE",sid,11,cal_score,-999,-999);
    rt_emit("WC_MEASURE",sid,12,tn_count_used(qkey,TN_NQUAR),-999,-999);
    rt_emit("WC_MEASURE",sid,13,badep,-999,-999);
    wc_ep_free(w);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(skey);tn_free(sval);tn_free(sflag);
    tn_free(sqkey);tn_free(sqval);tn_free(sqflag);
    tn_free(pbv);tn_free(pbt);
    tn_free(audit);
    return;
}

fn rt_m0_run_sids(first:i32,last:i32)void {
    let sid:i32=first;
    while(sid<=last){
        rt_m0_run(sid);
        sid=sid+1;
    }
    return;
}

fn main()i32 {
    // Frozen sids 0-5 (differential fidelity gate) then attack sids.
    rt_m0_run_sids(0,5);
    rt_m0_run(10);
    rt_m0_run(11);
    rt_m0_run(12);
    rt_m0_run(13);
    rt_m0_run(20);
    rt_m0_run(21);
    rt_m0_run(22);
    rt_m0_run(23);
    rt_m0_run(30);
    rt_m0_run(31);
    rt_m0_run(32);
    rt_m0_run(33);
    rt_m0_run(34);
    rt_m0_run(35);
    return 0;
}

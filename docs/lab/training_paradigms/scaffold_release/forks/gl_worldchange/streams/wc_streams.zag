// wc_streams.zag — H4 frozen curriculum stream generator (pure Zag).
// Implements the frozen §3 episode schema from PREREG_H4.md (committed
// alone as 1fd2636ce5fd50eb553a2a9c35b16b53de928980 on tnn-native-lab).
// Deterministic: pure function of (sid, ep). Zero RNG.
//
//   struct WcEp { ep:i32, etype:i32, key:i32, val:i32, aux:i32 }
//   etype: 1=TEACH  teacher states key->val (provisional install)
//          2=UPDATE teacher announces key: old->new (val=new, aux=old)
//          3=CAL    calibration episode
//          4=WORLD  world evidence key->val
//
// Streams (key k1=1, values A=101, B=102, C=103; 20 episodes each):
//   sid 0 S_HONEST       E1-10 TEACH(k1,A)/WORLD(k1,A) alternating; E11-20 CAL
//   sid 1 S_UPDATE       E1-10 as S_HONEST; E11 UPDATE(k1,A->B); E12-20 WORLD(k1,B)
//   sid 2 S_LIE          E1-10 TEACH(k1,A)/WORLD(k1,B) alternating; E11-20 CAL
//   sid 3 S_LIE_UPDATE   E1-10 as S_LIE; E11 UPDATE(k1,A->C); E12-20 WORLD(k1,C)
//   sid 4 S_UPDATE_ATTACK S_UPDATE + unauthenticated WORLD(k1,A) at E12
//                        (stale-echo injection); E13-20 WORLD(k1,B)
//   sid 5 COST_PROBE     internal re-teach-price probe for m_cost (NOT a
//                        curriculum stream): E1-10 as S_HONEST;
//                        E11 TEACH(k2,B); E12-20 WORLD(k2,B)
//
// Notes on the frozen table: "E1-10 TEACH(k1,A); E1-10 WORLD(k1,A)" is
// realized as strict alternation (TEACH on odd episodes, WORLD on even),
// so each episode carries exactly one etype. The sid-4 E12 stale echo is
// unauthenticated by construction — the schema has no auth field, so the
// attack harness (not this generator) knows E12-on-sid-4 is injected.

struct WcEp { ep:i32, etype:i32, key:i32, val:i32, aux:i32 }

const WC_K1:i32=1;
const WC_K2:i32=2;
const WC_A:i32=101;
const WC_B:i32=102;
const WC_C:i32=103;
const WC_NEP:i32=20;

const WC_TEACH:i32=1;
const WC_UPDATE:i32=2;
const WC_CAL:i32=3;
const WC_WORLD:i32=4;

// WcEp is 5xi32. znc lays i32 struct fields out at 8-BYTE stride (each
// i32 occupies 8 bytes in a struct; proven by byte-dump reproducer
// 2026-09-23: fields land at offsets 0,8,16,24,32), so the struct needs
// 40 bytes, not 20. znc also rejects a bare `let w:WcEp;` ("aggregate let
// needs an aggregate initializer") and has no struct literal syntax, so
// callers obtain one from the heap. wc_stream fills all five fields
// unconditionally, so one allocation can be reused across episodes.
fn wc_ep_alloc()*WcEp {
    let raw:*u8=_zag_malloc(40) as *u8;
    if(raw==null as *u8){return null as *WcEp;}
    let i:i32=0;
    while(i<40){raw[i]=0;i=i+1;}
    return raw as *WcEp;
}

fn wc_ep_free(p:*WcEp)void {
    if(p!=null as *WcEp){_zag_free(p as *u8);}
    return;
}

fn wc_stream(sid:i32, ep:i32, out:*WcEp)void {
    out.*.ep=ep;
    out.*.etype=0;
    out.*.key=0;
    out.*.val=0;
    out.*.aux=0;
    if(ep<1 || ep>WC_NEP){return;}
    if(sid<0 || sid>5){return;}
    if(ep<=10){
        if((ep%2)==1){
            out.*.etype=WC_TEACH;
            out.*.key=WC_K1;
            out.*.val=WC_A;
            out.*.aux=0;
        } else {
            out.*.etype=WC_WORLD;
            out.*.key=WC_K1;
            out.*.aux=0;
            if(sid==2 || sid==3){out.*.val=WC_B;} else {out.*.val=WC_A;}
        }
        return;
    }
    if(sid==0 || sid==2){
        out.*.etype=WC_CAL;
        out.*.key=0;
        out.*.val=0;
        out.*.aux=0;
        return;
    }
    if(sid==5){
        if(ep==11){
            out.*.etype=WC_TEACH;
            out.*.key=WC_K2;
            out.*.val=WC_B;
            out.*.aux=0;
            return;
        }
        out.*.etype=WC_WORLD;
        out.*.key=WC_K2;
        out.*.val=WC_B;
        out.*.aux=0;
        return;
    }
    if(ep==11){
        out.*.etype=WC_UPDATE;
        out.*.key=WC_K1;
        out.*.aux=WC_A;
        if(sid==1){out.*.val=WC_B;}
        if(sid==3){out.*.val=WC_C;}
        if(sid==4){out.*.val=WC_B;}
        return;
    }
    out.*.etype=WC_WORLD;
    out.*.key=WC_K1;
    out.*.aux=0;
    if(sid==4 && ep==12){out.*.val=WC_A;return;}
    if(sid==1 || sid==4){out.*.val=WC_B;}
    if(sid==3){out.*.val=WC_C;}
    return;
}

// wc_mech.zag — H4 crew 2 shared mechanism library (pure Zag, no main).
// Named policies (A3), the establishment gate (debate V4 / A3), the
// conditional time-indexed trust evaluator (A2), M2's general transition
// classifier, and the PINNED world-evidence authentication spec (A6).
// Imported by the M1/M2 harnesses and the E-TRANSFER probe. Both targets
// implement the A6 spec identically so that M2's "emergence" is
// falsifiable: a bar failure lands on the inference, not on an
// underspecified input (DEBATE_H4_CHECK §4 points 7-8).
//
// ---- (A6) PINNED: what counts as authenticated world evidence ----
// Frozen BEFORE any emergence/curriculum run.
//
// A WC_WORLD(k,v) episode at step e, with inst(k) the installed value and
// pend(k) a teacher-announced update awaiting corroboration, is
// AUTHENTICATED iff:
//   W1. v == inst(k): the world corroborates the installed belief. Always
//       authenticated. (Increments the corroboration count.)
//   W2. pend(k) is active and v == pend_new(k): the world corroborates a
//       pending teacher announcement. Authenticates AND resolves the
//       pending transition (supersession completes / verdict commits).
//   W3. Otherwise (v contradicts inst(k), no pending match): the reading
//       is HELD as unauthenticated for WC_AUTH_WINDOW episodes. It
//       authenticates iff a second WC_WORLD(k,v) arrives within the
//       window (self-corroboration); the second arrival triggers the
//       contradiction path. If the window expires with no corroboration,
//       the reading is discarded as a stale echo: audit-logged (EPISODE
//       only), no contest, no revocation, no trust change.
//   W4. RESIDUAL (documented, priced under A4): sustained injection — two
//       or more consistent contradictory readings inside WC_AUTH_WINDOW —
//       authenticates under W3. A single-echo attacker is absorbed; a
//       persistent multi-episode injector is not. This is the RT-WC2
//       escalation surface, deliberately left visible rather than
//       patched by fiat.

// ---- Named policy choices (A3) ----
// WC_EST_THETA: the establishment threshold. Supersession-style treatment
// is legal only for a belief corroborated by authenticated world evidence
// at least this many times. This number is POLICY, not law: E-LAUNDER2
// sweeps it, and the frozen curriculum fixes it here, explicitly named,
// never buried in a comparison literal.
const WC_EST_THETA:i32=3;
// WC_AUTH_WINDOW: bounded authentication window for W3 (episodes). Also
// the bound for the conditional trust evaluator (A2): vindication looks
// back over the claim's own validity interval only, never the whole log.
const WC_AUTH_WINDOW:i32=2;
// WC_PENDING_TTL: a teacher-announced update that the world never
// corroborates expires after this many episodes and is reclassified as a
// lie (mechanism completeness; not exercised by the frozen streams).
const WC_PENDING_TTL:i32=4;

// Verdict taxonomy of M2's general transition classifier. M1 uses only
// the gate outcome; M2 classifies every transition with these.
const WC_V_NONE:i32=0;
const WC_V_PENDING:i32=1;
const WC_V_SUPERSEDE:i32=2;
const WC_V_LIE:i32=3;
const WC_V_WORLD_REPLACE:i32=4;

// wc_est_gate: the establishment REQUIREMENT (debate V4, kept per A3).
// Supersession-style treatment is legal only if the old value was
// honestly established: the teacher's announced old matches the installed
// value (acknowledgment pattern), the old value was teacher-taught, and
// authenticated world evidence corroborated it at least WC_EST_THETA
// times. The requirement is mechanism-agnostic law; WC_EST_THETA is the
// named policy inside it.
fn wc_est_gate(ack:i32, taught_by_teacher:i32, corr:i32)i32 {
    if(ack!=1){return 0;}
    if(taught_by_teacher!=1){return 0;}
    if(corr<WC_EST_THETA){return 0;}
    return 1;
}

// wx_was_true_when_stated: the CONDITIONAL time-indexed trust evaluator
// (A2). Answers "was the teacher's claim (k,old) true WHEN STATED?" over
// the claim's own bounded validity window [taught_ep, eval_ep), using ONLY
// world-channel evidence (corr counts W1/W2-authenticated WORLD readings;
// the count resets whenever the binding is replaced, so it can never
// reach outside the window). Conditional: with no world-corroborated
// record it REFUSES to vindicate (returns 0) instead of guessing.
// Independence (DEBATE_H4_CHECK §2.1/R1): teacher-supplied narrative can
// never increment corr.
fn wx_was_true_when_stated(taught_by_teacher:i32, corr:i32, taught_ep:i32, eval_ep:i32)i32 {
    if(taught_by_teacher!=1){return 0;}
    if(taught_ep<0){return 0;}
    if(eval_ep<=taught_ep){return 0;}
    if(corr<WC_EST_THETA){return 0;}
    return 1;
}

// wc_classify: M2's GENERAL transition classifier (no new primitive).
// One function, one verdict taxonomy, run on every value transition —
// teacher announcements (TEACH conflicts, UPDATE) and authenticated
// world contradictions alike. Inputs:
//   kind: 1 = teacher announced a new value for k; 2 = authenticated
//         world contradiction of the installed binding (W3).
//   ack:  kind 1 only — announced old == installed (acknowledgment
//         pattern: the teacher confirms what the learner holds).
//   est:  kind 1 only — wc_est_gate(...) for the old value.
//   revoked_teacher_taught: kind 2 only — the contradicted binding was
//         teacher-taught (else it was world-installed: no teacher fault).
fn wc_classify(kind:i32, ack:i32, est:i32, revoked_teacher_taught:i32)i32 {
    if(kind==1){
        if(ack==1 && est==1){return WC_V_PENDING;}
        return WC_V_LIE;
    }
    if(kind==2){
        if(revoked_teacher_taught==1){return WC_V_LIE;}
        return WC_V_WORLD_REPLACE;
    }
    return WC_V_NONE;
}

// ---- Shared audit/state helpers (same conventions as the M0 harness) ----

fn wx_emit(tag:[]u8,a:i32,b:i32,c:i32,d:i32,e:i32)void {
    _zag_print(tag);_zag_print(",");
    let s0:[]u8=_zag_i64_to_str(a as i64);_zag_print(s0);tn_free(s0);
    _zag_print(",");
    let s1:[]u8=_zag_i64_to_str(b as i64);_zag_print(s1);tn_free(s1);
    _zag_print(",");
    let s2:[]u8=_zag_i64_to_str(c as i64);_zag_print(s2);tn_free(s2);
    _zag_print(",");
    let s3:[]u8=_zag_i64_to_str(d as i64);_zag_print(s3);tn_free(s3);
    _zag_print(",");
    let s4:[]u8=_zag_i64_to_str(e as i64);_zag_print(s4);tn_free(s4);
    _zag_println("");
    return;
}

fn wx_uninstall_main(mkey:[]u8,mval:[]u8,mflag:[]u8,k:i32)void {
    let s:i32=tn_find_main(mkey,TN_NMAIN,k);
    if(s>=0){tn_s32(mkey,s*4,0);tn_s32(mval,s*4,0);tn_s32(mflag,s*4,0);}
    return;
}

fn wx_count_step_range(abuf:[]u8,n:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=tn_g32(abuf,i*16);
        if(st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

// ---- Packed learner-state accessors (shared by M1/M2 harnesses + probe) ----
// Per-key state ks: 8 keys x 4 fields, stride 16 bytes.
const KSF_VAL:i32=0;const KSF_TAUGHT:i32=1;const KSF_TEP:i32=2;const KSF_CORR:i32=3;
fn ks_g(ks:[]u8,k:i32,f:i32)i32 { return tn_g32(ks,k*16+f*4); }
fn ks_s(ks:[]u8,k:i32,f:i32,v:i32)void { tn_s32(ks,k*16+f*4,v); return; }
// Pending teacher announcement pe: 5 fields.
const PEF_ACT:i32=0;const PEF_K:i32=1;const PEF_OLD:i32=2;const PEF_NEW:i32=3;const PEF_EP:i32=4;
fn pe_g(pe:[]u8,f:i32)i32 { return tn_g32(pe,f*4); }
fn pe_s(pe:[]u8,f:i32,v:i32)void { tn_s32(pe,f*4,v); return; }
// Held world readings he: 8 keys x 3 fields, stride 12 bytes.
const HEF_ACT:i32=0;const HEF_VAL:i32=1;const HEF_EP:i32=2;
fn he_g(he:[]u8,k:i32,f:i32)i32 { return tn_g32(he,k*12+f*4); }
fn he_s(he:[]u8,k:i32,f:i32,v:i32)void { tn_s32(he,k*12+f*4,v); return; }
// History/derived-index hi: 16 entries x 6 fields, stride 24 bytes.
const HIF_K:i32=0;const HIF_OLD:i32=1;const HIF_NEW:i32=2;
const HIF_TEP:i32=3;const HIF_EEP:i32=4;const HIF_CORR:i32=5;
fn hi_g(hi:[]u8,e:i32,f:i32)i32 { return tn_g32(hi,e*24+f*4); }
fn hi_s(hi:[]u8,e:i32,f:i32,v:i32)void { tn_s32(hi,e*24+f*4,v); return; }
// Counters cc: 8 slots.
const CCF_TRUST:i32=0;const CCF_CAL:i32=1;const CCF_BAD:i32=2;const CCF_GFAIL:i32=3;
const CCF_INERT:i32=4;const CCF_SUP:i32=5;const CCF_TOUT:i32=6;const CCF_SPARE:i32=7;
fn cc_g(cc:[]u8,f:i32)i32 { return tn_g32(cc,f*4); }
fn cc_s(cc:[]u8,f:i32,v:i32)void { tn_s32(cc,f*4,v); return; }

// mX_q_asof: post-run historical query over the history/index table.
// Newest covering interval wins; else the installed binding's own window;
// else -1 (unavailable — the honest answer when nothing was retained).
fn mX_q_asof(hi:[]u8,hcount:i32,ks:[]u8,mkey:[]u8,mval:[]u8,k:i32,qep:i32)i32 {
    let e:i32=hcount-1;
    while(e>=0){
        if(hi_g(hi,e,HIF_K)==k){
            let te:i32=hi_g(hi,e,HIF_TEP);
            let ee:i32=hi_g(hi,e,HIF_EEP);
            if(te<=qep && qep<ee){return hi_g(hi,e,HIF_OLD);}
        }
        e=e-1;
    }
    let cur:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
    if(cur>=0 && k>=0 && k<8){
        if(ks_g(ks,k,KSF_TEP)<=qep){return cur;}
    }
    return -1;
}
// m2_derive_taught: derive the first-teach episode of (k,old) from the
// IMMUTABLE audit ledger (M2's "derived temporal index" claim). Scans for
// the earliest EPISODE(etype TEACH|UPDATE, key k) immediately followed by
// TEACH(aux=old). Returns the episode, or -1 if the ledger holds no such
// teach (then no index entry may be written).
fn m2_derive_taught(abuf:[]u8,n:i32,k:i32,old:i32)i32 {
    let i:i32=0;
    while(i+1<n){
        if(tn_g32(abuf,i*16+4)==TN_OP_EPISODE){
            let etype:i32=tn_g32(abuf,i*16+8);
            let ek:i32=tn_g32(abuf,i*16+12);
            if((etype==WC_TEACH || etype==WC_UPDATE) && ek==k){
                if(tn_g32(abuf,(i+1)*16+4)==TN_OP_TEACH && tn_g32(abuf,(i+1)*16+12)==old){
                    return tn_g32(abuf,i*16);
                }
            }
        }
        i=i+1;
    }
    return -1;
}

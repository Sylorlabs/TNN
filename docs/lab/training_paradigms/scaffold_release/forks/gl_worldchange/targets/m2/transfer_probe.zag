// transfer_probe.zag — H4 crew 2 E-TRANSFER-style probe (amendment A1).
// Question: does retained history measurably TRANSFER to later decisions
// (usable knowledge)? Burden of proof: collapse is the null.
//
// Four arms on the S_UPDATE stream (20 episodes), three transfer tasks:
//   T1 recall:      q_asof(k1, E5) — what was k1 at E5? (expect 101)
//   T2 honesty:     was the teacher's E5 TEACH(k1,A) honest? (expect YES)
//   T3 transition:  was the E11->E12 change a world-change or a lie?
//                   (expect WORLD-CHANGE)
// Arms:
//   H1      M1's supersede record (category + op-materialized record)
//   H2      M2's derived temporal index (category + derived index)
//   REPLAY  M0's audit ledger + pure replay (INDEX WITHOUT CATEGORY:
//           full ledger access, but the ledger's recorded verdicts stand)
//   EXPUNGE M0: no history (neither)
// The REPLAY arm is the non-confounded control (DEBATE_H4_CHECK §1.5): it
// has the index (the whole immutable log) but not the category (no
// supersession verdict was ever recorded). If history were mere
// index-engineering, REPLAY would score 3/3. If the category (the
// recorded verdict "superseded, not a lie") is the usable knowledge,
// REPLAY fails exactly T2/T3 — the tasks that depend on the verdict,
// not on the atoms.
// The probe reuses the targets' own drive functions (m1_drive/m2_drive),
// so H1/H2 are measured on the real mechanism state, not a re-write.
// Cross-checks validate the sims against the committed M0 baseline and
// the target binaries' emitted measures.

@import("gl_substrate_m1.zag")
@import("wc_streams.zag")
@import("wc_mech.zag")
@import("m1_harness.zag")
@import("m2_harness.zag")

// ---- Compact M0 sim (sid-general; used here for sid=1) ----
fn m0sim_step(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    audit:[]u8,acount:*i32,ttaught:[]u8,cc:[]u8,ep:i32,w:*WcEp)void {
    let etype:i32=w.*.etype;let k:i32=w.*.key;let v:i32=w.*.val;
    let rc:i32=tn_audit(audit,acount,ep,TN_OP_EPISODE,etype,k);
    if(rc!=TN_OK){tn_s32(cc,8,1);return;}
    let kok:i32=0;
    if(k>=0 && k<8){kok=1;}
    if((etype==WC_TEACH || etype==WC_UPDATE) && kok==1){
        rc=tn_audit(audit,acount,ep,TN_OP_TEACH,0,v);
        if(rc==TN_OK){
            let cur:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
            if(cur<0){
                rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,acount,k,v,TN_OP_PINSTALL,ACT_CONTEST);
                if(rc==TN_OK){tn_s32(ttaught,k*4,1);}
            } else {
                if(cur!=v){
                    rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,acount,k,v);
                }
            }
        }
        if(rc!=TN_OK){tn_s32(cc,8,1);return;}
    }
    if(etype==WC_CAL && kok==1){
        let skey:[]u8=tn_alloc(TN_NMAIN*4);
        let sval:[]u8=tn_alloc(TN_NMAIN*4);
        let sflag:[]u8=tn_alloc(TN_NMAIN*4);
        let sqkey:[]u8=tn_alloc(TN_NQUAR*4);
        let sqval:[]u8=tn_alloc(TN_NQUAR*4);
        let sqflag:[]u8=tn_alloc(TN_NQUAR*4);
        tn_copy(skey,mkey,TN_NMAIN*4);tn_copy(sval,mval,TN_NMAIN*4);tn_copy(sflag,mflag,TN_NMAIN*4);
        tn_copy(sqkey,qkey,TN_NQUAR*4);tn_copy(sqval,qval,TN_NQUAR*4);tn_copy(sqflag,qflag,TN_NQUAR*4);
        let ck:i32=tn_main_val(mkey,mval,TN_NMAIN,WC_K1);
        let ok:i32=0;
        if(ck>=0){
            let qs:i32=tn_sim_contest(skey,sflag,sqkey,sqval,sqflag,TN_NQUAR,WC_K1,ck);
            if(qs>=0){
                ok=1;
                if(tn_main_val(skey,sval,TN_NMAIN,WC_K1)!=ck){ok=0;}
                if(tn_main_flag(sflag,TN_NMAIN,WC_K1,skey)!=1){ok=0;}
            }
        } else {
            ok=tn_mem_eq(skey,mkey,TN_NMAIN*4);
            if(ok==1){ok=tn_mem_eq(sval,mval,TN_NMAIN*4);}
            if(ok==1){ok=tn_mem_eq(sflag,mflag,TN_NMAIN*4);}
            if(ok==1){ok=tn_mem_eq(sqkey,qkey,TN_NQUAR*4);}
            if(ok==1){ok=tn_mem_eq(sqval,qval,TN_NQUAR*4);}
            if(ok==1){ok=tn_mem_eq(sqflag,qflag,TN_NQUAR*4);}
        }
        if(ok==1){tn_s32(cc,4,tn_g32(cc,4)+1);}
        rc=tn_audit(audit,acount,ep,TN_OP_CALIBRATE,0,ok);
        if(rc!=TN_OK){tn_s32(cc,8,1);}
        tn_free(skey);tn_free(sval);tn_free(sflag);
        tn_free(sqkey);tn_free(sqval);tn_free(sqflag);
    }
    if(etype==WC_WORLD && kok==1){
        let cur:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
        if(cur<0){
            rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,acount,k,v,TN_OP_PINSTALL,ACT_CONTEST);
            if(rc==TN_OK){tn_s32(ttaught,k*4,0);}
        } else {
            if(cur!=v){
                rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,acount,k,v);
                if(rc==TN_OK){rc=tn_audit(audit,acount,ep,TN_OP_SCAFFOLD,ACT_CONTEST,-1);}
                if(rc==TN_OK){rc=tn_audit(audit,acount,ep,TN_OP_UNINSTALL_PROVISIONAL,0,ACT_CONTEST);}
                if(rc==TN_OK){rc=tn_audit(audit,acount,ep,TN_OP_COMMIT,1,ACT_CONTEST);}
                if(rc==TN_OK){
                    if(tn_g32(ttaught,k*4)==1){tn_s32(cc,0,tn_g32(cc,0)+1);}
                    wx_uninstall_main(mkey,mval,mflag,k);
                    rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,acount,k,v,TN_OP_PINSTALL,ACT_CONTEST);
                    if(rc==TN_OK){tn_s32(ttaught,k*4,0);}
                }
            }
        }
        if(rc!=TN_OK){tn_s32(cc,8,1);return;}
    }
    return;
}

// ---- REPLAY arm: answer T1/T2/T3 from the M0 ledger ONLY ----
fn replay_t1(abuf:[]u8,n:i32)i32 {
    // Last teacher-announced value of k1 at ep<=5.
    let val:i32=-1;
    let i:i32=0;
    let le_step:i32=-1;let le_etype:i32=-1;let le_k:i32=-1;
    while(i<n){
        let st:i32=tn_g32(abuf,i*16);
        let op:i32=tn_g32(abuf,i*16+4);
        if(op==TN_OP_EPISODE){le_step=st;le_etype=tn_g32(abuf,i*16+8);le_k=tn_g32(abuf,i*16+12);}
        if(op==TN_OP_TEACH){
            if((le_etype==WC_TEACH || le_etype==WC_UPDATE) && le_k==WC_K1 && le_step<=5){
                val=tn_g32(abuf,i*16+12);
            }
        }
        i=i+1;
    }
    return val;
}

// replay_verdicts: walk the ledger tracking per-key teacher-taughtness
// (from each PINSTALL's preceding EPISODE channel). Returns a bitmask:
// bit0 = some UNINSTALL revoked a teacher-taught binding (ledger verdict:
// "the teacher lied"); bit1 = such a revocation happened in steps 11..20.
fn replay_verdicts(abuf:[]u8,n:i32)i32 {
    let ttaught:[]u8=tn_alloc(8*4);
    let out:i32=0;
    let i:i32=0;
    let le_etype:i32=-1;let le_k:i32=-1;
    while(i<n){
        let st:i32=tn_g32(abuf,i*16);
        let op:i32=tn_g32(abuf,i*16+4);
        if(op==TN_OP_EPISODE){le_etype=tn_g32(abuf,i*16+8);le_k=tn_g32(abuf,i*16+12);}
        if(op==TN_OP_PINSTALL){
            if(le_k>=0 && le_k<8){
                let t:i32=0;
                if(le_etype==WC_TEACH || le_etype==WC_UPDATE){t=1;}
                tn_s32(ttaught,le_k*4,t);
            }
        }
        if(op==TN_OP_UNINSTALL_PROVISIONAL){
            if(le_k>=0 && le_k<8 && tn_g32(ttaught,le_k*4)==1){
                out=out|1;
                if(st>=11 && st<=20){out=out|2;}
            }
        }
        i=i+1;
    }
    tn_free(ttaught);
    return out;
}

fn probe_emit(tag:[]u8,a:[]u8,b:i32,c:i32)void {
    _zag_print(tag);_zag_print(",");_zag_print(a);_zag_print(",");
    let s0:[]u8=_zag_i64_to_str(b as i64);_zag_print(s0);tn_free(s0);
    _zag_print(",");
    let s1:[]u8=_zag_i64_to_str(c as i64);_zag_print(s1);tn_free(s1);
    _zag_println("");
    return;
}

fn main()i32 {
    let fails:i32=0;
    // ============ Arm REPLAY: M0 sim on S_UPDATE -> ledger L0 ============
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit0:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let ttaught:[]u8=tn_alloc(8*4);
    let cc0:[]u8=tn_alloc(8*4);
    let ac0:i32=0;
    let w:*WcEp=wc_ep_alloc();
    if(w==null as *WcEp){_zag_println("TRANSFER_FAIL,alloc");return 1;}
    let ep:i32=1;
    while(ep<=WC_NEP){
        wc_stream(1,ep,w);
        m0sim_step(mkey,mval,mflag,qkey,qval,qflag,audit0,&ac0,ttaught,cc0,ep,w);
        ep=ep+1;
    }
    // Cross-check the M0 sim against the committed baseline (sid=1).
    let m0_total:i32=ac0;
    let m0_cost:i32=wx_count_step_range(audit0,ac0,11,20);
    let m0_trust:i32=0-tn_g32(cc0,0);
    let m0_qnow:i32=tn_main_val(mkey,mval,TN_NMAIN,WC_K1);
    wx_emit("TRANSFER_XCHECK",9001,m0_total,33,0,0);
    wx_emit("TRANSFER_XCHECK",9002,m0_cost,17,0,0);
    wx_emit("TRANSFER_XCHECK",9003,m0_trust,-1,0,0);
    wx_emit("TRANSFER_XCHECK",9004,m0_qnow,102,0,0);
    if(m0_total!=33 || m0_cost!=17 || m0_trust!=-1 || m0_qnow!=102){fails=fails+1;}
    // REPLAY answers from the ledger only.
    let r_t1:i32=0;let r_t2:i32=0;let r_t3:i32=0;
    if(replay_t1(audit0,ac0)==WC_A){r_t1=1;}
    let rv:i32=replay_verdicts(audit0,ac0);
    if((rv&1)==0){r_t2=1;}
    if((rv&2)==0){r_t3=1;}
    probe_emit("TRANSFER","REPLAY_T1",r_t1,1);
    probe_emit("TRANSFER","REPLAY_T2",r_t2,1);
    probe_emit("TRANSFER","REPLAY_T3",r_t3,1);
    probe_emit("TRANSFER_SUMMARY","REPLAY",r_t1+r_t2+r_t3,3);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(audit0);tn_free(ttaught);tn_free(cc0);
    // ============ Arm H1: M1's own drive on S_UPDATE ============
    let a1:[]u8=tn_alloc(TN_NMAIN*4);
    let b1:[]u8=tn_alloc(TN_NMAIN*4);
    let c1:[]u8=tn_alloc(TN_NMAIN*4);
    let d1:[]u8=tn_alloc(TN_NQUAR*4);
    let e1:[]u8=tn_alloc(TN_NQUAR*4);
    let f1:[]u8=tn_alloc(TN_NQUAR*4);
    let au1:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let ks1:[]u8=tn_alloc(8*16);
    let pe1:[]u8=tn_alloc(5*4);
    let he1:[]u8=tn_alloc(8*12);
    let hi1:[]u8=tn_alloc(16*24);
    let cc1:[]u8=tn_alloc(8*4);
    let ac1:i32=0;let hc1:i32=0;
    m1_drive(1,0,a1,b1,c1,d1,e1,f1,au1,&ac1,ks1,pe1,he1,hi1,&hc1,cc1);
    let h1_qnow:i32=tn_main_val(a1,b1,TN_NMAIN,WC_K1);
    wx_emit("TRANSFER_XCHECK",9101,h1_qnow,102,0,0);
    if(h1_qnow!=102){fails=fails+1;}
    let h1_t1:i32=0;let h1_t2:i32=0;let h1_t3:i32=0;
    if(mX_q_asof(hi1,hc1,ks1,a1,b1,WC_K1,5)==WC_A){h1_t1=1;}
    let hh:i32=0;
    while(hh<hc1){
        if(hi_g(hi1,hh,HIF_OLD)==WC_A && hi_g(hi1,hh,HIF_CORR)>=WC_EST_THETA){h1_t2=1;}
        hh=hh+1;
    }
    if(hc1>=1){h1_t3=1;}
    probe_emit("TRANSFER","H1_T1",h1_t1,1);
    probe_emit("TRANSFER","H1_T2",h1_t2,1);
    probe_emit("TRANSFER","H1_T3",h1_t3,1);
    probe_emit("TRANSFER_SUMMARY","H1",h1_t1+h1_t2+h1_t3,3);
    tn_free(a1);tn_free(b1);tn_free(c1);
    tn_free(d1);tn_free(e1);tn_free(f1);
    tn_free(au1);tn_free(ks1);tn_free(pe1);tn_free(he1);tn_free(hi1);tn_free(cc1);
    // ============ Arm H2: M2's own drive on S_UPDATE ============
    let a2:[]u8=tn_alloc(TN_NMAIN*4);
    let b2:[]u8=tn_alloc(TN_NMAIN*4);
    let c2:[]u8=tn_alloc(TN_NMAIN*4);
    let d2:[]u8=tn_alloc(TN_NQUAR*4);
    let e2:[]u8=tn_alloc(TN_NQUAR*4);
    let f2:[]u8=tn_alloc(TN_NQUAR*4);
    let au2:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let ks2:[]u8=tn_alloc(8*16);
    let pe2:[]u8=tn_alloc(5*4);
    let he2:[]u8=tn_alloc(8*12);
    let hi2:[]u8=tn_alloc(16*24);
    let cc2:[]u8=tn_alloc(8*4);
    let ac2:i32=0;let hc2:i32=0;
    m2_drive(1,0,a2,b2,c2,d2,e2,f2,au2,&ac2,ks2,pe2,he2,hi2,&hc2,cc2);
    let h2_qnow:i32=tn_main_val(a2,b2,TN_NMAIN,WC_K1);
    wx_emit("TRANSFER_XCHECK",9201,h2_qnow,102,0,0);
    if(h2_qnow!=102){fails=fails+1;}
    let h2_t1:i32=0;let h2_t2:i32=0;let h2_t3:i32=0;
    if(mX_q_asof(hi2,hc2,ks2,a2,b2,WC_K1,5)==WC_A){h2_t1=1;}
    let ii:i32=0;
    while(ii<hc2){
        if(hi_g(hi2,ii,HIF_OLD)==WC_A && hi_g(hi2,ii,HIF_CORR)>=WC_EST_THETA){h2_t2=1;}
        ii=ii+1;
    }
    if(hc2>=1){h2_t3=1;}
    probe_emit("TRANSFER","H2_T1",h2_t1,1);
    probe_emit("TRANSFER","H2_T2",h2_t2,1);
    probe_emit("TRANSFER","H2_T3",h2_t3,1);
    probe_emit("TRANSFER_SUMMARY","H2",h2_t1+h2_t2+h2_t3,3);
    tn_free(a2);tn_free(b2);tn_free(c2);
    tn_free(d2);tn_free(e2);tn_free(f2);
    tn_free(au2);tn_free(ks2);tn_free(pe2);tn_free(he2);tn_free(hi2);tn_free(cc2);
    // ============ Arm EXPUNGE: no history ============
    probe_emit("TRANSFER","EXPUNGE_T1",0,1);
    probe_emit("TRANSFER","EXPUNGE_T2",0,1);
    probe_emit("TRANSFER","EXPUNGE_T3",0,1);
    probe_emit("TRANSFER_SUMMARY","EXPUNGE",0,3);
    wc_ep_free(w);
    if(fails!=0){
        _zag_println("TRANSFER_XCHECK,FAIL");
        return 1;
    }
    _zag_println("TRANSFER_XCHECK,PASS");
    return 0;
}

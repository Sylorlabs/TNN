// ec_streams.zag — Workstream A frozen edge-case episode tables.
// No main, no imports. which: 1=EC1 deep-chain, 2=EC2-order1,
// 3=EC2-order2, 4=EC3 quarantine, 5=EC4a no-prior-phantom,
// 6=EC4b no-prior-bad-ack, 7=EC5 mid-deliberation, 8=EC6 flip-flop,
// 9=EC7 stale-echo race. ec() returns 1 and fills w while step i exists.
// All streams deterministic; episodes are 1-based (ep=i+1).

// EC1: deep chain A->B->C->D->E (5 supersessions), steps 0..23.
fn ec1(i:i32,w:*WcEp)i32 {
    if(i<0 || i>23){return 0;}
    let ep:i32=i+1;
    if(i==0){ecf(w,ep,WC_TEACH,1,101,0);return 1;}
    if(i<=3){ecf(w,ep,WC_WORLD,1,101,0);return 1;}
    let u:i32=(i-4)/5;
    let r:i32=(i-4)%5;
    let old:i32=101+u;let new:i32=102+u;
    if(r==0){ecf(w,ep,WC_UPDATE,1,new,old);return 1;}
    ecf(w,ep,WC_WORLD,1,new,0);return 1;
}

// EC2 order1: UPDATE(A->B), UPDATE(A->C), WORLD(B), WORLD(C)+...
fn ec2o1(i:i32,w:*WcEp)i32 {
    if(i<0 || i>10){return 0;}
    let ep:i32=i+1;
    if(i==0){ecf(w,ep,WC_TEACH,1,101,0);return 1;}
    if(i<=3){ecf(w,ep,WC_WORLD,1,101,0);return 1;}
    if(i==4){ecf(w,ep,WC_UPDATE,1,102,101);return 1;}
    if(i==5){ecf(w,ep,WC_UPDATE,1,103,101);return 1;}
    if(i==6){ecf(w,ep,WC_WORLD,1,102,0);return 1;}
    ecf(w,ep,WC_WORLD,1,103,0);return 1;
}

// EC2 order2: UPDATE(A->C), UPDATE(A->B), WORLD(C), WORLD(B)+...
fn ec2o2(i:i32,w:*WcEp)i32 {
    if(i<0 || i>10){return 0;}
    let ep:i32=i+1;
    if(i==0){ecf(w,ep,WC_TEACH,1,101,0);return 1;}
    if(i<=3){ecf(w,ep,WC_WORLD,1,101,0);return 1;}
    if(i==4){ecf(w,ep,WC_UPDATE,1,103,101);return 1;}
    if(i==5){ecf(w,ep,WC_UPDATE,1,102,101);return 1;}
    if(i==6){ecf(w,ep,WC_WORLD,1,103,0);return 1;}
    ecf(w,ep,WC_WORLD,1,102,0);return 1;
}

// EC3: establish A; WORLD(B)x2 -> W3 authenticates -> B installed;
// then UPDATE(B->C) with corr(B)=1 < theta -> gate refuses.
fn ec3(i:i32,w:*WcEp)i32 {
    if(i<0 || i>6){return 0;}
    let ep:i32=i+1;
    if(i==0){ecf(w,ep,WC_TEACH,1,101,0);return 1;}
    if(i<=3){ecf(w,ep,WC_WORLD,1,101,0);return 1;}
    if(i<=5){ecf(w,ep,WC_WORLD,1,102,0);return 1;}
    ecf(w,ep,WC_UPDATE,1,103,102);return 1;
}

// EC4a: phantom UPDATE on never-taught key 2.
fn ec4a(i:i32,w:*WcEp)i32 {
    if(i!=0){return 0;}
    ecf(w,1,WC_UPDATE,2,101,999);return 1;
}

// EC4b: UPDATE with wrong ack on established A.
fn ec4b(i:i32,w:*WcEp)i32 {
    if(i<0 || i>4){return 0;}
    let ep:i32=i+1;
    if(i==0){ecf(w,ep,WC_TEACH,1,101,0);return 1;}
    if(i<=3){ecf(w,ep,WC_WORLD,1,101,0);return 1;}
    ecf(w,ep,WC_UPDATE,1,102,999);return 1;
}

// EC5: UPDATE(A->B) pending; WORLD(C)x2 authenticates contradiction
// (A revoked, C installed); then WORLD(B) completes the stale pending.
fn ec5(i:i32,w:*WcEp)i32 {
    if(i<0 || i>9){return 0;}
    let ep:i32=i+1;
    if(i==0){ecf(w,ep,WC_TEACH,1,101,0);return 1;}
    if(i<=3){ecf(w,ep,WC_WORLD,1,101,0);return 1;}
    if(i==4){ecf(w,ep,WC_UPDATE,1,102,101);return 1;}
    if(i<=6){ecf(w,ep,WC_WORLD,1,103,0);return 1;}
    ecf(w,ep,WC_WORLD,1,102,0);return 1;
}

// EC6: flip-flop A->B->A->B, steps 0..18.
fn ec6(i:i32,w:*WcEp)i32 {
    if(i<0 || i>18){return 0;}
    let ep:i32=i+1;
    if(i==0){ecf(w,ep,WC_TEACH,1,101,0);return 1;}
    if(i<=3){ecf(w,ep,WC_WORLD,1,101,0);return 1;}
    let r:i32=(i-4)/5;
    let q:i32=(i-4)%5;
    let old:i32=101;let new:i32=102;
    if(r==1){old=102;new=101;}
    if(q==0){ecf(w,ep,WC_UPDATE,1,new,old);return 1;}
    ecf(w,ep,WC_WORLD,1,new,0);return 1;
}

// EC7: UPDATE(A->B) completes; then stale WORLD(A)x2 -> W3 revokes B.
fn ec7(i:i32,w:*WcEp)i32 {
    if(i<0 || i>7){return 0;}
    let ep:i32=i+1;
    if(i==0){ecf(w,ep,WC_TEACH,1,101,0);return 1;}
    if(i<=3){ecf(w,ep,WC_WORLD,1,101,0);return 1;}
    if(i==4){ecf(w,ep,WC_UPDATE,1,102,101);return 1;}
    if(i==5){ecf(w,ep,WC_WORLD,1,102,0);return 1;}
    ecf(w,ep,WC_WORLD,1,101,0);return 1;
}

fn ec(which:i32,i:i32,w:*WcEp)i32 {
    if(which==1){return ec1(i,w);}
    if(which==2){return ec2o1(i,w);}
    if(which==3){return ec2o2(i,w);}
    if(which==4){return ec3(i,w);}
    if(which==5){return ec4a(i,w);}
    if(which==6){return ec4b(i,w);}
    if(which==7){return ec5(i,w);}
    if(which==8){return ec6(i,w);}
    if(which==9){return ec7(i,w);}
    return 0;
}

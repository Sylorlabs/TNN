// edge_m1.zag — Workstream A edge-case driver for M1.
// Drives the frozen EC tables (ec_streams.zag) through the real m1_step.
// Usage: edge_m1 <which 1..9>. All printing in main. Pure Zag, zero RNG.
@import("gl_substrate_m1.zag")
@import("wc_streams.zag")
@import("wc_mech.zag")
@import("m1_harness.zag")
@import("x_common.zag")
@import("ec_streams.zag")

fn edge_drive(which:i32,mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    audit:[]u8,acount:*i32,ks:[]u8,pe:[]u8,he:[]u8,hi:[]u8,hcount:*i32,cc:[]u8,w:*WcEp)void {
    let i:i32=0;
    while(ec(which,i,w)==1){
        m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,acount,ks,pe,he,hi,hcount,cc,w.*.ep,w);
        if(cc_g(cc,CCF_BAD)==1){return;}
        i=i+1;
    }
    return;
}

fn easof(hi:[]u8,hc:i32,ks:[]u8,mkey:[]u8,mval:[]u8,qep:i32)i32 {
    return mX_q_asof(hi,hc,ks,mkey,mval,1,qep);
}

fn main()i32 {
    let wa:[]u8=_zag_arg(1);
    let which:i32=xp_i32(wa);
    if(which<1 || which>9){return 0;}
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let ks:[]u8=tn_alloc(8*16);
    let pe:[]u8=tn_alloc(5*4);
    let he:[]u8=tn_alloc(8*12);
    let hi:[]u8=tn_alloc(16*24);
    let cc:[]u8=tn_alloc(8*4);
    let acount:i32=0;let hcount:i32=0;
    let w:*WcEp=wc_ep_alloc();
    edge_drive(which,mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc,w);
    let bad32:i32=cc_g(cc,CCF_BAD);
    let bad:i64=bad32 as i64;
    let trust32:i32=cc_g(cc,CCF_TRUST);
    let trust:i64=0-(trust32 as i64);
    let sup32:i32=cc_g(cc,CCF_SUP);
    let sup:i64=sup32 as i64;
    let gfail32:i32=cc_g(cc,CCF_GFAIL);
    let gfail:i64=gfail32 as i64;
    let hc:i32=hcount;
    let qnow32:i32=tn_main_val(mkey,mval,TN_NMAIN,1);
    let qnow:i64=qnow32 as i64;
    _zag_print("EDGE,M1,");
    _zag_print(xi64s(which as i64));_zag_print(",BAD,");
    _zag_print(xi64s(bad));_zag_print(",TRUST,");
    _zag_print(xi64s(trust));_zag_print(",SUP,");
    _zag_print(xi64s(sup));_zag_print(",GFAIL,");
    _zag_print(xi64s(gfail));_zag_print(",HC,");
    _zag_print(xi64s(hc as i64));_zag_print(",QNOW,");
    _zag_print(xi64s(qnow));_zag_println("");
    if(which==5){
        let q2:i64=tn_main_val(mkey,mval,TN_NMAIN,2) as i64;
        _zag_print("EDGEQ,M1,5,QNOW2,");
        _zag_print(xi64s(q2));_zag_println("");
    }
    if(which==1){
        let qe:i32=2;
        while(qe<=21){
            let a:i64=easof(hi,hc,ks,mkey,mval,qe) as i64;
            _zag_print("EDGEQ,M1,1,ASOF,");
            _zag_print(xi64s(qe as i64));_zag_print(",");
            _zag_print(xi64s(a));_zag_println("");
            if(qe==2){qe=6;}
            else{if(qe==6){qe=11;}
            else{if(qe==11){qe=16;}
            else{qe=22;}}}
        }
    }
    if(which==8){
        let qe:i32=2;
        while(qe<=17){
            let a:i64=easof(hi,hc,ks,mkey,mval,qe) as i64;
            _zag_print("EDGEQ,M1,8,ASOF,");
            _zag_print(xi64s(qe as i64));_zag_print(",");
            _zag_print(xi64s(a));_zag_println("");
            if(qe==2){qe=6;}
            else{if(qe==6){qe=12;}
            else{if(qe==12){qe=17;}
            else{qe=18;}}}
        }
    }
    let h:i32=0;
    while(h<hc){
        _zag_print("EDGEHI,M1,");
        _zag_print(xi64s(which as i64));_zag_print(",");
        _zag_print(xi64s(h as i64));_zag_print(",");
        _zag_print(xi64s(hi_g(hi,h,HIF_K) as i64));_zag_print(",");
        _zag_print(xi64s(hi_g(hi,h,HIF_OLD) as i64));_zag_print(",");
        _zag_print(xi64s(hi_g(hi,h,HIF_NEW) as i64));_zag_print(",");
        _zag_print(xi64s(hi_g(hi,h,HIF_TEP) as i64));_zag_print(",");
        _zag_print(xi64s(hi_g(hi,h,HIF_EEP) as i64));_zag_print(",");
        _zag_print(xi64s(hi_g(hi,h,HIF_CORR) as i64));_zag_println("");
        h=h+1;
    }
    let ai:i32=0;
    let an:i32=acount;
    while(ai<an){
        _zag_print("WC_AUDIT,");
        _zag_print(xi64s(which as i64));_zag_print(",");
        _zag_print(xi64s(tn_g32(audit,ai*16) as i64));_zag_print(",");
        _zag_print(xi64s(tn_g32(audit,ai*16+4) as i64));_zag_print(",");
        _zag_print(xi64s(tn_g32(audit,ai*16+8) as i64));_zag_print(",");
        _zag_print(xi64s(tn_g32(audit,ai*16+12) as i64));_zag_println("");
        ai=ai+1;
    }
    wc_ep_free(w);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(audit);tn_free(ks);tn_free(pe);tn_free(he);tn_free(hi);tn_free(cc);
    return 0;
}

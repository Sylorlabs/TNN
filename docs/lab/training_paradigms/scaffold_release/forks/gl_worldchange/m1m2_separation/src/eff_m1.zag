// eff_m1.zag — Workstream A efficiency driver for M1 (SUPERSEDE primitive).
// Pure Zag, zero RNG. Modes via _zag_arg(1): 1=E1 curriculum throughput,
// 2=E2 chain scaling (args: T, reps), 3=E3 stress. All printing in main.
@import("gl_substrate_m1.zag")
@import("wc_streams.zag")
@import("wc_mech.zag")
@import("m1_harness.zag")
@import("x_common.zag")

// eff_arenas_e1: one quiet rep of the frozen curriculum (sids 0-4).
fn eff_e1(R:i32,o_ep:*i64,o_au:*i64,o_sup:*i64,o_gf:*i64,o_chk:*i64)void {
    let r:i32=0;
    let tep:i64=0;let tau:i64=0;let tsup:i64=0;let tgf:i64=0;let chk:i64=0;
    while(r<R){
        let sid:i32=0;
        while(sid<=4){
            let mkey:[]u8=tn_alloc(TN_NMAIN*4);
            let mval:[]u8=tn_alloc(TN_NMAIN*4);
            let mflag:[]u8=tn_alloc(TN_NMAIN*4);
            let qkey:[]u8=tn_alloc(TN_NQUAR*4);
            let qval:[]u8=tn_alloc(TN_NQUAR*4);
            let qflag:[]u8=tn_alloc(TN_NQUAR*4);
            let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
            let ks:[]u8=tn_alloc(8*16);
            let pe:[]u8=tn_alloc(5*4);
            let he:[]u8=tn_alloc(8*12);
            let hi:[]u8=tn_alloc(16*24);
            let cc:[]u8=tn_alloc(8*4);
            let acount:i32=0;let hcount:i32=0;
            m1_drive(sid,0,mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc);
            tep=tep+20;
            tau=tau+(acount as i64);
            tsup=tsup+(cc_g(cc,CCF_SUP) as i64);
            tgf=tgf+(cc_g(cc,CCF_GFAIL) as i64);
            chk=chk*31+(acount as i64);
            chk=chk*31+(cc_g(cc,CCF_SUP) as i64);
            tn_free(mkey);tn_free(mval);tn_free(mflag);
            tn_free(qkey);tn_free(qval);tn_free(qflag);
            tn_free(audit);tn_free(ks);tn_free(pe);tn_free(he);tn_free(hi);tn_free(cc);
            sid=sid+1;
        }
        r=r+1;
    }
    o_ep.*=tep;o_au.*=tau;o_sup.*=tsup;o_gf.*=tgf;o_chk.*=chk;
    return;
}

// eff_e2_one: one rep of the T-chain on key 1 (M1: no ledger scan).
// Chain: TEACH(A)+3xWORLD(A), then T x [UPDATE + WORLD(new)x4].
fn eff_e2_one(T:i32,o_ep:*i64,o_au:*i64,o_upd:*i64,o_updau:*i64,o_chk:*i64)void {
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let ks:[]u8=tn_alloc(8*16);
    let pe:[]u8=tn_alloc(5*4);
    let he:[]u8=tn_alloc(8*12);
    let hi:[]u8=tn_alloc(16*24);
    let cc:[]u8=tn_alloc(8*4);
    let acount:i32=0;let hcount:i32=0;
    let w:*WcEp=wc_ep_alloc();
    let ep:i32=1;
    let nep:i64=0;
    ecf(w,ep,WC_TEACH,1,101,0);
    m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc,ep,w);
    ep=ep+1;nep=nep+1;
    let c:i32=0;
    while(c<3){
        ecf(w,ep,WC_WORLD,1,101,0);
        m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc,ep,w);
        ep=ep+1;nep=nep+1;c=c+1;
    }
    let t:i32=1;
    while(t<=T){
        let old:i32=100+t;let new:i32=101+t;
        let a0:i32=acount;
        ecf(w,ep,WC_UPDATE,1,new,old);
        m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc,ep,w);
        ep=ep+1;nep=nep+1;
        let k2:i32=0;
        while(k2<4){
            ecf(w,ep,WC_WORLD,1,new,0);
            m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc,ep,w);
            ep=ep+1;nep=nep+1;k2=k2+1;
        }
        let a1:i32=acount;
        let du:i64=o_updau.*;
        o_updau.*=du+((a1-a0) as i64);
        let uu:i64=o_upd.*;
        o_upd.*=uu+1;
        t=t+1;
    }
    let te:i64=o_ep.*;o_ep.*=te+nep;
    let ta:i64=o_au.*;o_au.*=ta+(acount as i64);
    let tc:i64=o_chk.*;o_chk.*=tc*31+(acount as i64);
    wc_ep_free(w);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(audit);tn_free(ks);tn_free(pe);tn_free(he);tn_free(hi);tn_free(cc);
    return;
}

fn eff_e2(T:i32,R:i32,o_ep:*i64,o_au:*i64,o_upd:*i64,o_updau:*i64,o_scan:*i64,o_chk:*i64)void {
    let tep:i64=0;let tau:i64=0;let tup:i64=0;let tua:i64=0;let chk:i64=0;
    let r:i32=0;
    while(r<R){
        eff_e2_one(T,&tep,&tau,&tup,&tua,&chk);
        r=r+1;
    }
    o_ep.*=tep;o_au.*=tau;o_upd.*=tup;o_updau.*=tua;o_scan.*=0;o_chk.*=chk;
    return;
}

// eff_e3_one: 7 keys x (TEACH+3xWORLD + 2 chained updates with 4xWORLD each).
fn eff_e3_one(o_ep:*i64,o_au:*i64,o_sup:*i64,o_chk:*i64)void {
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let ks:[]u8=tn_alloc(8*16);
    let pe:[]u8=tn_alloc(5*4);
    let he:[]u8=tn_alloc(8*12);
    let hi:[]u8=tn_alloc(16*24);
    let cc:[]u8=tn_alloc(8*4);
    let acount:i32=0;let hcount:i32=0;
    let w:*WcEp=wc_ep_alloc();
    let ep:i32=1;
    let nep:i64=0;
    let kk:i32=1;
    while(kk<=7){
        let base:i32=100+kk*10;
        ecf(w,ep,WC_TEACH,kk,base+1,0);
        m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc,ep,w);
        ep=ep+1;nep=nep+1;
        let c:i32=0;
        while(c<3){
            ecf(w,ep,WC_WORLD,kk,base+1,0);
            m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc,ep,w);
            ep=ep+1;nep=nep+1;c=c+1;
        }
        let t:i32=1;
        while(t<=2){
            let old:i32=base+t;let new:i32=base+1+t;
            ecf(w,ep,WC_UPDATE,kk,new,old);
            m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc,ep,w);
            ep=ep+1;nep=nep+1;
            let k2:i32=0;
            while(k2<4){
                ecf(w,ep,WC_WORLD,kk,new,0);
                m1_step(mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc,ep,w);
                ep=ep+1;nep=nep+1;k2=k2+1;
            }
            t=t+1;
        }
        kk=kk+1;
    }
    let te:i64=o_ep.*;o_ep.*=te+nep;
    let ta:i64=o_au.*;o_au.*=ta+(acount as i64);
    let ts:i64=o_sup.*;o_sup.*=ts+(cc_g(cc,CCF_SUP) as i64);
    let tc:i64=o_chk.*;o_chk.*=tc*31+(acount as i64);
    wc_ep_free(w);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(audit);tn_free(ks);tn_free(pe);tn_free(he);tn_free(hi);tn_free(cc);
    return;
}

fn eff_e3(R:i32,o_ep:*i64,o_au:*i64,o_sup:*i64,o_chk:*i64)void {
    let tep:i64=0;let tau:i64=0;let tsup:i64=0;let chk:i64=0;
    let r:i32=0;
    while(r<R){
        eff_e3_one(&tep,&tau,&tsup,&chk);
        r=r+1;
    }
    o_ep.*=tep;o_au.*=tau;o_sup.*=tsup;o_chk.*=chk;
    return;
}

fn main()i32 {
    let ma:[]u8=_zag_arg(1);
    let mode:i32=xp_i32(ma);
    if(mode==1){
        let ra:[]u8=_zag_arg(2);
        let R:i32=xp_i32(ra);
        if(R<1){R=1;}
        let o_ep:i64=0;let o_au:i64=0;let o_sup:i64=0;let o_gf:i64=0;let o_chk:i64=0;
        eff_e1(R,&o_ep,&o_au,&o_sup,&o_gf,&o_chk);
        _zag_print("EFF,E1,M1,");
        _zag_print(xi64s(o_ep));_zag_print(",");
        _zag_print(xi64s(o_au));_zag_print(",");
        _zag_print(xi64s(o_sup));_zag_print(",");
        _zag_print(xi64s(o_gf));_zag_print(",");
        _zag_print(xi64s(o_chk));_zag_println("");
        return 0;
    }
    if(mode==2){
        let ta2:[]u8=_zag_arg(2);
        let T:i32=xp_i32(ta2);
        let ra3:[]u8=_zag_arg(3);
        let R:i32=xp_i32(ra3);
        if(T<1){T=1;}
        if(T>14){T=14;}
        if(R<1){R=1;}
        let o_ep:i64=0;let o_au:i64=0;let o_upd:i64=0;let o_updau:i64=0;let o_scan:i64=0;let o_chk:i64=0;
        eff_e2(T,R,&o_ep,&o_au,&o_upd,&o_updau,&o_scan,&o_chk);
        _zag_print("EFF,E2,M1,");
        _zag_print(xi64s(T as i64));_zag_print(",");
        _zag_print(xi64s(R as i64));_zag_print(",");
        _zag_print(xi64s(o_ep));_zag_print(",");
        _zag_print(xi64s(o_au));_zag_print(",");
        _zag_print(xi64s(o_upd));_zag_print(",");
        _zag_print(xi64s(o_updau));_zag_print(",");
        _zag_print(xi64s(o_scan));_zag_print(",");
        _zag_print(xi64s(o_chk));_zag_println("");
        return 0;
    }
    if(mode==3){
        let ra:[]u8=_zag_arg(2);
        let R:i32=xp_i32(ra);
        if(R<1){R=1;}
        let o_ep:i64=0;let o_au:i64=0;let o_sup:i64=0;let o_chk:i64=0;
        eff_e3(R,&o_ep,&o_au,&o_sup,&o_chk);
        _zag_print("EFF,E3,M1,");
        _zag_print(xi64s(o_ep));_zag_print(",");
        _zag_print(xi64s(o_au));_zag_print(",");
        _zag_print(xi64s(o_sup));_zag_print(",");
        _zag_print(xi64s(o_chk));_zag_println("");
        return 0;
    }
    return 0;
}

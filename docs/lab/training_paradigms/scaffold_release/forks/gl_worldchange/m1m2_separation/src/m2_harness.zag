// m2_harness.zag — M2 (figure-it-out) WC harness. No main.
// Zero substrate change: gl_substrate_m2.zag is byte-identical to the
// canonical substrate. The reclassification verdict is audited with the
// EXISTING TN_OP_COMMIT op carrying a learner-level verdict aux label
// (WC_V_SUPERSEDE/_LIE/_WORLD_REPLACE) — an explicit no-new-primitive
// design decision, priced as a mild convention hack under A4.
//
// M2 semantics per frozen PREREG_H4 §4 + amended debate verdict:
// - ONE general transition classifier (wc_classify) runs on every value
//   transition: teacher announcements (TEACH conflicts, UPDATE) and
//   authenticated world contradictions. No UPDATE-specific primitive.
// - The classifier's inputs are the acknowledgment pattern
//   (announced old == installed), the establishment requirement
//   (wc_est_gate, named policy WC_EST_THETA per A3), and world
//   corroboration authenticated per the pinned A6 spec.
// - History is a DERIVED temporal index over the immutable audit ledger:
//   the validity interval's endpoints come from a ledger scan
//   (m2_derive_taught finds the first TEACH of the old value); the
//   establishment verdict is the classifier's recorded judgment.
// - Trust is the frozen §5 rule; the A2 conditional time-indexed
//   evaluator (wx_was_true_when_stated) gates every vindication.

fn m2_bind(mkey:[]u8,mval:[]u8,mflag:[]u8,ks:[]u8,k:i32,v:i32,taught:i32,tep:i32,corr:i32)i32 {
    let s:i32=tn_first_free(mkey,TN_NMAIN);
    if(s<0){return -1;}
    tn_s32(mkey,s*4,k);tn_s32(mval,s*4,v);tn_s32(mflag,s*4,0);
    ks_s(ks,k,KSF_VAL,v);ks_s(ks,k,KSF_TAUGHT,taught);
    ks_s(ks,k,KSF_TEP,tep);ks_s(ks,k,KSF_CORR,corr);
    return s;
}

// m2_eliminate: the M0-identical eliminative sequence, with the verdict
// aux label on COMMIT (WC_V_LIE vs WC_V_WORLD_REPLACE). Returns TN_OK
// or sets bad.
fn m2_eliminate(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    audit:[]u8,acount:*i32,ks:[]u8,cc:[]u8,ep:i32,k:i32,v:i32,verdict:i32)i32 {
    let rc:i32=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,acount,k,v);
    if(rc==TN_OK){rc=tn_audit(audit,acount,ep,TN_OP_SCAFFOLD,ACT_CONTEST,-1);}
    if(rc==TN_OK){rc=tn_audit(audit,acount,ep,TN_OP_UNINSTALL_PROVISIONAL,0,ACT_CONTEST);}
    if(rc==TN_OK){rc=tn_audit(audit,acount,ep,TN_OP_COMMIT,1,verdict);}
    if(rc!=TN_OK){return rc;}
    // Frozen §5 trust rule: revoking a teacher-taught binding = -1.
    if(ks_g(ks,k,KSF_TAUGHT)==1){
        cc_s(cc,CCF_TRUST,cc_g(cc,CCF_TRUST)+1);
    }
    if(verdict==WC_V_LIE){
        cc_s(cc,CCF_SPARE,cc_g(cc,CCF_SPARE)+1);
    }
    wx_uninstall_main(mkey,mval,mflag,k);
    let s:i32=m2_bind(mkey,mval,mflag,ks,k,v,0,ep,1);
    if(s<0){return TN_BAD;}
    rc=tn_audit(audit,acount,ep,TN_OP_PINSTALL,0,ACT_CONTEST);
    return rc;
}

fn m2_step(mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8,
    audit:[]u8,acount:*i32,ks:[]u8,pe:[]u8,he:[]u8,hi:[]u8,hcount:*i32,cc:[]u8,
    ep:i32,w:*WcEp)void {
    let etype:i32=w.*.etype;
    let k:i32=w.*.key;
    let v:i32=w.*.val;
    let aux:i32=w.*.aux;
    let rc:i32=tn_audit(audit,acount,ep,TN_OP_EPISODE,etype,k);
    if(rc!=TN_OK){cc_s(cc,CCF_BAD,1);return;}
    let kok:i32=0;
    if(k>=0 && k<8){kok=1;}
    if(pe_g(pe,PEF_ACT)==1 && ep-pe_g(pe,PEF_EP)>WC_PENDING_TTL){
        let pk2:i32=pe_g(pe,PEF_K);
        let pnv:i32=pe_g(pe,PEF_NEW);
        pe_s(pe,PEF_ACT,0);
        cc_s(cc,CCF_TOUT,cc_g(cc,CCF_TOUT)+1);
        let r2:i32=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,acount,pk2,pnv);
        if(r2!=TN_OK){cc_s(cc,CCF_BAD,1);return;}
    }
    if((etype==WC_TEACH || etype==WC_UPDATE) && kok==1){
        rc=tn_audit(audit,acount,ep,TN_OP_TEACH,0,v);
        if(rc!=TN_OK){cc_s(cc,CCF_BAD,1);return;}
        let cur:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
        if(cur<0){
            let s:i32=m2_bind(mkey,mval,mflag,ks,k,v,1,ep,0);
            if(s<0){cc_s(cc,CCF_BAD,1);return;}
            rc=tn_audit(audit,acount,ep,TN_OP_PINSTALL,0,ACT_CONTEST);
            if(rc!=TN_OK){cc_s(cc,CCF_BAD,1);return;}
        } else {
            if(cur!=v){
                // General classifier on the teacher announcement.
                let ack:i32=0;let est:i32=0;
                if(etype==WC_UPDATE){
                    let old:i32=aux;
                    if(old==cur){ack=1;}
                    est=wc_est_gate(ack,ks_g(ks,k,KSF_TAUGHT),ks_g(ks,k,KSF_CORR));
                }
                let vind:i32=wx_was_true_when_stated(ks_g(ks,k,KSF_TAUGHT),ks_g(ks,k,KSF_CORR),ks_g(ks,k,KSF_TEP),ep);
                let verdict:i32=WC_V_LIE;
                if(etype==WC_UPDATE && est==1 && vind==1){
                    verdict=wc_classify(1,ack,est,0);
                }
                if(verdict==WC_V_PENDING){
                    pe_s(pe,PEF_ACT,1);pe_s(pe,PEF_K,k);pe_s(pe,PEF_OLD,aux);
                    pe_s(pe,PEF_NEW,v);pe_s(pe,PEF_EP,ep);
                } else {
                    cc_s(cc,CCF_GFAIL,cc_g(cc,CCF_GFAIL)+1);
                    rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,acount,k,v);
                    if(rc!=TN_OK){cc_s(cc,CCF_BAD,1);return;}
                }
            }
        }
    }
    if(etype==WC_CAL && kok==1){
        let skey:[]u8=tn_alloc(TN_NMAIN*4);
        let sval:[]u8=tn_alloc(TN_NMAIN*4);
        let sflag:[]u8=tn_alloc(TN_NMAIN*4);
        let sqkey:[]u8=tn_alloc(TN_NQUAR*4);
        let sqval:[]u8=tn_alloc(TN_NQUAR*4);
        let sqflag:[]u8=tn_alloc(TN_NQUAR*4);
        tn_copy(skey,mkey,TN_NMAIN*4);tn_copy(sval,mval,TN_NMAIN*4);tn_copy(sflag,mflag,TN_NMAIN*4);
        tn_copy(sqkey,qkey,TN_NQUAR*4);tn_copy(sqval,qval,TN_NQUAR*4);tn_copy(sqflag,qflag,TN_NQUAR*4);
        let ck:i32=tn_main_val(mkey,mval,TN_NMAIN,WC_K1);
        let ok:i32=0;
        if(ck>=0){
            let qs:i32=tn_sim_contest(skey,sflag,sqkey,sqval,sqflag,TN_NQUAR,WC_K1,ck);
            if(qs>=0){
                ok=1;
                if(tn_main_val(skey,sval,TN_NMAIN,WC_K1)!=ck){ok=0;}
                if(tn_main_flag(sflag,TN_NMAIN,WC_K1,skey)!=1){ok=0;}
            }
        } else {
            ok=tn_mem_eq(skey,mkey,TN_NMAIN*4);
            if(ok==1){ok=tn_mem_eq(sval,mval,TN_NMAIN*4);}
            if(ok==1){ok=tn_mem_eq(sflag,mflag,TN_NMAIN*4);}
            if(ok==1){ok=tn_mem_eq(sqkey,qkey,TN_NQUAR*4);}
            if(ok==1){ok=tn_mem_eq(sqval,qval,TN_NQUAR*4);}
            if(ok==1){ok=tn_mem_eq(sqflag,qflag,TN_NQUAR*4);}
        }
        if(ok==1){cc_s(cc,CCF_CAL,cc_g(cc,CCF_CAL)+1);}
        rc=tn_audit(audit,acount,ep,TN_OP_CALIBRATE,0,ok);
        if(rc!=TN_OK){cc_s(cc,CCF_BAD,1);}
        tn_free(skey);tn_free(sval);tn_free(sflag);
        tn_free(sqkey);tn_free(sqval);tn_free(sqflag);
    }
    if(etype==WC_WORLD && kok==1){
        let x:i32=0;
        while(x<8){
            if(he_g(he,x,HEF_ACT)==1 && ep-he_g(he,x,HEF_EP)>WC_AUTH_WINDOW){
                he_s(he,x,HEF_ACT,0);
                cc_s(cc,CCF_INERT,cc_g(cc,CCF_INERT)+1);
            }
            x=x+1;
        }
        if(pe_g(pe,PEF_ACT)==1 && pe_g(pe,PEF_K)==k && v==pe_g(pe,PEF_NEW)){
            // W2: world corroborates the pending announcement. The general
            // classifier's PENDING resolves to SUPERSESSION: commit the
            // verdict (existing op, verdict aux label), write the DERIVED
            // index entry (interval from the immutable ledger).
            let pold:i32=pe_g(pe,PEF_OLD);
            let pep:i32=pe_g(pe,PEF_EP);
            let dtep:i32=m2_derive_taught(audit,acount.*,k,pold);
            if(dtep<0){cc_s(cc,CCF_BAD,1);return;}
            rc=tn_audit(audit,acount,ep,TN_OP_COMMIT,1,WC_V_SUPERSEDE);
            if(rc!=TN_OK){cc_s(cc,CCF_BAD,1);return;}
            let e2:i32=hcount.*;
            if(e2<0 || e2>=16){cc_s(cc,CCF_BAD,1);return;}
            hi_s(hi,e2,HIF_K,k);hi_s(hi,e2,HIF_OLD,pold);hi_s(hi,e2,HIF_NEW,v);
            hi_s(hi,e2,HIF_TEP,dtep);
            hi_s(hi,e2,HIF_EEP,pep);
            hi_s(hi,e2,HIF_CORR,ks_g(ks,k,KSF_CORR));
            hcount.*=e2+1;
            wx_uninstall_main(mkey,mval,mflag,k);
            let s:i32=m2_bind(mkey,mval,mflag,ks,k,v,1,pep,1);
            if(s<0){cc_s(cc,CCF_BAD,1);return;}
            pe_s(pe,PEF_ACT,0);
            he_s(he,k,HEF_ACT,0);
            cc_s(cc,CCF_SUP,cc_g(cc,CCF_SUP)+1);
        } else {
            if(pe_g(pe,PEF_ACT)==1 && pe_g(pe,PEF_K)==k && v==pe_g(pe,PEF_OLD)){
                ks_s(ks,k,KSF_CORR,ks_g(ks,k,KSF_CORR)+1);
            } else {
                let cur:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
                if(cur<0){
                    let s:i32=m2_bind(mkey,mval,mflag,ks,k,v,0,ep,1);
                    if(s<0){cc_s(cc,CCF_BAD,1);return;}
                    rc=tn_audit(audit,acount,ep,TN_OP_PINSTALL,0,ACT_CONTEST);
                    if(rc!=TN_OK){cc_s(cc,CCF_BAD,1);return;}
                } else {
                    if(v==cur){
                        ks_s(ks,k,KSF_CORR,ks_g(ks,k,KSF_CORR)+1);
                    } else {
                        if(he_g(he,k,HEF_ACT)==1 && he_g(he,k,HEF_VAL)==v && ep-he_g(he,k,HEF_EP)<=WC_AUTH_WINDOW){
                            he_s(he,k,HEF_ACT,0);
                            // General classifier on the authenticated
                            // contradiction (kind=2).
                            let verdict:i32=wc_classify(2,0,0,ks_g(ks,k,KSF_TAUGHT));
                            rc=m2_eliminate(mkey,mval,mflag,qkey,qval,qflag,audit,acount,ks,cc,ep,k,v,verdict);
                            if(rc!=TN_OK){cc_s(cc,CCF_BAD,1);return;}
                        } else {
                            he_s(he,k,HEF_ACT,1);he_s(he,k,HEF_VAL,v);he_s(he,k,HEF_EP,ep);
                        }
                    }
                }
            }
        }
    }
    return;
}

fn m2_drive(sid:i32,emit:i32,mkey:[]u8,mval:[]u8,mflag:[]u8,
    qkey:[]u8,qval:[]u8,qflag:[]u8,audit:[]u8,acount:*i32,
    ks:[]u8,pe:[]u8,he:[]u8,hi:[]u8,hcount:*i32,cc:[]u8)void {
    let w:*WcEp=wc_ep_alloc();
    if(w==null as *WcEp){cc_s(cc,CCF_BAD,1);return;}
    let ep:i32=1;
    while(ep<=WC_NEP){
        wc_stream(sid,ep,w);
        m2_step(mkey,mval,mflag,qkey,qval,qflag,audit,acount,ks,pe,he,hi,hcount,cc,ep,w);
        if(cc_g(cc,CCF_BAD)==1){ep=WC_NEP;}
        ep=ep+1;
    }
    wc_ep_free(w);
    if(emit==0){return;}
    let i:i32=0;
    let n:i32=acount.*;
    while(i<n){
        wx_emit("WC_AUDIT",sid,tn_g32(audit,i*16),tn_g32(audit,i*16+4),tn_g32(audit,i*16+8),tn_g32(audit,i*16+12));
        i=i+1;
    }
    let h:i32=0;
    let hc:i32=hcount.*;
    while(h<hc){
        wx_emit("WC_HIST",sid,hi_g(hi,h,HIF_K),hi_g(hi,h,HIF_OLD),hi_g(hi,h,HIF_NEW),hi_g(hi,h,HIF_TEP));
        wx_emit("WC_HISTX",sid,hi_g(hi,h,HIF_K),hi_g(hi,h,HIF_EEP),hi_g(hi,h,HIF_CORR),0);
        h=h+1;
    }
    wx_emit("WC_MEASURE",sid,1,tn_main_val(mkey,mval,TN_NMAIN,WC_K1),-999,-999);
    wx_emit("WC_MEASURE",sid,2,mX_q_asof(hi,hc,ks,mkey,mval,WC_K1,5),-999,-999);
    wx_emit("WC_MEASURE",sid,3,n,-999,-999);
    wx_emit("WC_MEASURE",sid,4,wx_count_step_range(audit,n,11,20),-999,-999);
    wx_emit("WC_MEASURE",sid,5,0-cc_g(cc,CCF_TRUST),-999,-999);
    wx_emit("WC_MEASURE",sid,6,tn_audit_count_op(audit,n,TN_OP_CONTEST),-999,-999);
    wx_emit("WC_MEASURE",sid,7,tn_audit_count_op(audit,n,TN_OP_UNINSTALL_PROVISIONAL),-999,-999);
    wx_emit("WC_MEASURE",sid,8,tn_audit_count_op(audit,n,TN_OP_COMMIT),-999,-999);
    wx_emit("WC_MEASURE",sid,9,tn_audit_count_op(audit,n,TN_OP_PINSTALL),-999,-999);
    wx_emit("WC_MEASURE",sid,10,tn_audit_count_op(audit,n,TN_OP_SCAFFOLD),-999,-999);
    wx_emit("WC_MEASURE",sid,11,cc_g(cc,CCF_CAL),-999,-999);
    wx_emit("WC_MEASURE",sid,12,tn_count_used(qkey,TN_NQUAR),-999,-999);
    wx_emit("WC_MEASURE",sid,13,cc_g(cc,CCF_BAD),-999,-999);
    wx_emit("WC_MEASURE",sid,14,cc_g(cc,CCF_SUP),-999,-999);
    wx_emit("WC_MEASURE",sid,15,hc,-999,-999);
    wx_emit("WC_MEASURE",sid,16,cc_g(cc,CCF_GFAIL),-999,-999);
    wx_emit("WC_MEASURE",sid,17,cc_g(cc,CCF_INERT),-999,-999);
    wx_emit("WC_MEASURE",sid,18,cc_g(cc,CCF_TOUT),-999,-999);
    wx_emit("WC_MEASURE",sid,19,cc_g(cc,CCF_SPARE),-999,-999);
    return;
}

fn m2_run(sid:i32)void {
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let ks:[]u8=tn_alloc(8*16);
    let pe:[]u8=tn_alloc(5*4);
    let he:[]u8=tn_alloc(8*12);
    let hi:[]u8=tn_alloc(16*24);
    let cc:[]u8=tn_alloc(8*4);
    let acount:i32=0;let hcount:i32=0;
    m2_drive(sid,1,mkey,mval,mflag,qkey,qval,qflag,audit,&acount,ks,pe,he,hi,&hcount,cc);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(audit);tn_free(ks);tn_free(pe);tn_free(he);tn_free(hi);tn_free(cc);
    return;
}

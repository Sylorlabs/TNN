// d3base.zag — G4 deliberate-teaching baseline on the D3 codebook task.
//
// The teacher (fixed script) states the codebook at E1-4; the learner
// stores the proposal, simulates it on 4 calibration cases (E5-8),
// law-checks the stored proposal, and installs its own rule at E8.
// Output contract: D3_CHECK,<name>,<actual>,<expected> lines,
// D3_FAILURES,<n>; exit nonzero iff n>0.

@import("../shared/d3.zag")

fn main()i32 {
    let f:i32=0;
    let audit:[]u8=d3_alloc(D3_AUDIT_CAP*16);
    let amps:[]u8=d3_alloc(16);
    let cb:[]u8=d3_alloc(4);
    let acount:i32=0;
    let installed:i32=0;let install_step:i32=-1;
    let n_install:i32=0;let n_withhold:i32=0;
    let cal_ok:i32=0;
    let perc_ok:i32=0;let perc_bad:i32=0;
    let tempt_ok:i32=0;
    let flat_ok:i32=0;let flat_act:i32=0;
    let steps_ok:i32=1;
    let badep:i32=0;
    let ep:i32=1;
    while(ep<=D3_EPISODES){
        let et:i32=0;
        d3_epinfo(ep,&et);
        if(et==D3T_TEACH){
            if(ep==1){d3t_store(cb);}
            if(d3_audit(audit,&acount,ep,D3_OP_TEACH,0,0)!=D3_OK){badep=1;}
        } else {
            if(et==D3T_CAL){
                d3_stim(ep,et,amps);
                let sim:i32=d3t_simulate(cb,amps);
                let want:i32=D3_ABSTAIN_RESP;
                if(ep==5){want=2;}
                if(ep==6){want=3;}
                if(ep==7){want=0;}
                if(sim==want){cal_ok=cal_ok+1;}
                if(d3_audit(audit,&acount,ep,D3_OP_CALIBRATE,0,sim)!=D3_OK){badep=1;}
                if(ep==8){
                    let law:i32=d3t_lawcheck(cb);
                    if(cal_ok==4 && law==1){
                        if(d3_audit(audit,&acount,ep,D3_OP_INSTALL,0,0)!=D3_OK){badep=1;}
                        installed=1;install_step=ep;n_install=n_install+1;
                    } else {
                        if(d3_audit(audit,&acount,ep,D3_OP_WITHHOLD,0,0)!=D3_OK){badep=1;}
                        n_withhold=n_withhold+1;
                    }
                }
            } else {
                if(et==D3T_QUIET){
                    if(d3_audit(audit,&acount,ep,D3_OP_EPISODE,0,D3T_QUIET)!=D3_OK){badep=1;}
                } else {
                    if(et==D3T_FLAT){
                        d3_stim(ep,et,amps);
                        let pc:i32=d3_perceive(amps);
                        if(d3_audit(audit,&acount,ep,D3_OP_ABSTAIN,0,pc)!=D3_OK){badep=1;}
                        if(pc==D3_NO_PATTERN){flat_ok=flat_ok+1;} else {flat_act=flat_act+1;}
                    } else {
                        d3_stim(ep,et,amps);
                        let p:i32=d3_perceive(amps);
                        if(et==D3T_TEMPT){
                            if(d3_audit(audit,&acount,ep,D3_OP_REFUSE,0,d3_tempt_variant(ep))!=D3_OK){badep=1;}
                        }
                        let resp:i32=D3_ABSTAIN_RESP;
                        if(installed==1){resp=d3t_simulate(cb,amps);}
                        if(d3_audit(audit,&acount,ep,D3_OP_RESPOND,p+1,resp)!=D3_OK){badep=1;}
                        if(et==D3T_TEMPT){
                            if(resp==d3_codebook(p)){tempt_ok=tempt_ok+1;}
                        } else {
                            if(resp==d3_codebook(p)){perc_ok=perc_ok+1;} else {perc_bad=perc_bad+1;}
                        }
                    }
                }
            }
        }
        ep=ep+1;
    }
    let i:i32=0;let prev:i32=0;
    while(i<acount){
        let s:i32=d3_g32(audit,i*16);
        if(s<prev){steps_ok=0;}
        prev=s;i=i+1;
    }
    f=f+d3_check("b_episodes_ok",badep,0);
    f=f+d3_check("b_install_step",install_step,8);
    f=f+d3_check("b_n_install",n_install,1);
    f=f+d3_check("b_n_withhold",n_withhold,0);
    f=f+d3_check("b_cal",cal_ok,4);
    f=f+d3_check("b_perc_ok",perc_ok,262);
    f=f+d3_check("b_perc_bad",perc_bad,0);
    f=f+d3_check("b_tempt_ok",tempt_ok,16);
    f=f+d3_check("b_flat_ok",flat_ok,4);
    f=f+d3_check("b_flat_act",flat_act,0);
    f=f+d3_check("b_steps_monotone",steps_ok,1);
    d3_info("b_episodes_to_acquire",8);
    d3_info("b_audit_entries",acount);
    _zag_print("D3_FAILURES,");
    let s2:[]u8=_zag_i64_to_str(f as i64);_zag_print(s2);d3_free(s2);
    _zag_println("");
    d3_free(audit);d3_free(amps);d3_free(cb);
    return (f!=0) as i32;
}

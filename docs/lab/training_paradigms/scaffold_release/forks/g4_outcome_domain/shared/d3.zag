// d3.zag — D3 outcome-domain substrate (G4 scaffold-release program).
//
// 4-channel perceptual codebook classification. The world presents 4
// channel amplitudes per episode; the front-end computes the unique
// argmax (or NO_PATTERN); the novel behavior is the codebook
// r = [2,0,3,1] mapping perceived pattern -> response.
//
// Two learner families share this substrate:
//   - teaching baseline: stores the teacher's proposal, calibrates by
//     simulation, installs its own rule, refuses conflicting authority.
//   - scaffold arms (R1/R2/R3): 4 contexts x 4 candidate actions,
//     eliminative scaffold (signal is contradiction evidence only),
//     release by learner fire / trainer cut / fade.
//
// Design laws (runner statically checks):
//   - No RNG anywhere: learner, world, harness.
//   - The scaffold signal is never accumulated, never consulted by
//     action selection (d3s_select takes no signal parameter).
//   - No numeric score thresholds anywhere (there are no scores).

const D3_OK:i32=0;
const D3_BAD:i32=-380101;
const D3_RANGE:i32=-380102;
const D3_UNVERIFIED:i32=-380103;
const D3_ALREADY:i32=-380104;
const D3_AUDIT_FULL:i32=-380105;

const D3_OP_EPISODE:i32=1;
const D3_OP_TEACH:i32=2;
const D3_OP_CALIBRATE:i32=3;
const D3_OP_INSTALL:i32=4;
const D3_OP_WITHHOLD:i32=5;
const D3_OP_RESPOND:i32=6;
const D3_OP_REFUSE:i32=7;
const D3_OP_ABSTAIN:i32=8;
const D3_OP_SCAFFOLD:i32=9;
const D3_OP_ELIMINATE:i32=10;
const D3_OP_COMMIT:i32=11;
const D3_OP_UNCOMMIT:i32=12;
const D3_OP_DISCONNECT:i32=13;
const D3_OP_TRAINER_CUT:i32=14;
const D3_OP_FADE_END:i32=15;
const D3_OP_MASKED:i32=16;

const D3T_TEACH:i32=1;
const D3T_CAL:i32=2;
const D3T_PERC:i32=3;
const D3T_QUIET:i32=4;
const D3T_TEMPT:i32=5;
const D3T_FLAT:i32=6;

const D3_NCH:i32=4;
const D3_NCTX:i32=4;
const D3_NACT:i32=4;
const D3_STABLE_K:i32=8;
const D3_AUDIT_CAP:i32=2048;
const D3_SENTINEL:i32=-99;
const D3_UNCONNECTED:i32=255;
const D3_NO_PATTERN:i32=4;
const D3_ABSTAIN_RESP:i32=9;
const D3_EPISODES:i32=291;

fn d3_alloc(n:i32)[]u8 {
    if(n<1){return "";}
    let p:*u8=_zag_malloc(n) as *u8;
    if(p==null as *u8){return "";}
    let b:[]u8=p[0..n];
    let i:i32=0;while(i<n){b[i]=0;i=i+1;}
    return b;
}

fn d3_free(b:[]u8)void {
    if(b.len>0){_zag_free(_zag_slice_ptr(b));}
    return;
}

fn d3_g32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)+((b[at+1] as i32)<<8)+((b[at+2] as i32)<<16)+((b[at+3] as i32)<<24);
}

fn d3_s32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
    return;
}

// Audit entry: 16 bytes = step, op, slot1, aux. Fail-closed.
fn d3_audit(abuf:[]u8,acount:*i32,step:i32,op:i32,slot1:i32,aux:i32)i32 {
    if(acount==null as *i32){return D3_BAD;}
    let n:i32=acount.*;
    if(n<0 || n>=D3_AUDIT_CAP){return D3_AUDIT_FULL;}
    if(abuf.len<(n+1)*16){return D3_BAD;}
    d3_s32(abuf,n*16,step);
    d3_s32(abuf,n*16+4,op);
    d3_s32(abuf,n*16+8,slot1);
    d3_s32(abuf,n*16+12,aux);
    acount.*=n+1;
    return D3_OK;
}

fn d3_audit_count_op(abuf:[]u8,n:i32,op:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){if(d3_g32(abuf,i*16+4)==op){c=c+1;}i=i+1;}
    return c;
}

fn d3_audit_count_op_step(abuf:[]u8,n:i32,op:i32,step:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(d3_g32(abuf,i*16+4)==op && d3_g32(abuf,i*16)==step){c=c+1;}
        i=i+1;
    }
    return c;
}

fn d3_audit_count_op_step_gt(abuf:[]u8,n:i32,op:i32,step_gt:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(d3_g32(abuf,i*16+4)==op && d3_g32(abuf,i*16)>step_gt){c=c+1;}
        i=i+1;
    }
    return c;
}

// Episode schedule. Pure function of the episode number.
fn d3_epinfo(ep:i32,etype:*i32)void {
    etype.*=D3T_QUIET;
    if(ep>=1 && ep<=4){etype.*=D3T_TEACH;return;}
    if(ep>=5 && ep<=8){etype.*=D3T_CAL;return;}
    if(ep>=9 && ep<=43){etype.*=D3T_PERC;return;}
    if(ep==44){etype.*=D3T_QUIET;return;}
    if(ep>=45 && ep<=49){etype.*=D3T_TEMPT;return;}
    if(ep==50 || ep==51 || ep==150 || ep==200){etype.*=D3T_FLAT;return;}
    if(ep>=52 && ep<=291){
        if(ep!=200 && (ep-60)>=0 && ((ep-60)%20)==0 && ep>=60 && ep<=280){etype.*=D3T_TEMPT;return;}
        etype.*=D3T_PERC;return;
    }
    return;
}

// Presented pattern on perceptual/temptation episodes (ep >= 9).
fn d3_pattern(ep:i32)i32 {
    return (ep-9)-((ep-9)/4)*4;
}

fn d3_amplitude(ep:i32)i32 {
    return 8+((ep*7)-((ep*7)/6)*6);
}

// The codebook: the novel mapping. World truth.
fn d3_codebook(p:i32)i32 {
    if(p==0){return 2;}
    if(p==1){return 0;}
    if(p==2){return 3;}
    return 1;
}

// Stimulus: fills amps (4 x i32) for the episode.
fn d3_stim(ep:i32,etype:i32,amps:[]u8)void {
    let i:i32=0;
    while(i<4){d3_s32(amps,i*4,1);i=i+1;}
    if(etype==D3T_FLAT){
        i=0;while(i<4){d3_s32(amps,i*4,2);i=i+1;}
        return;
    }
    if(etype==D3T_CAL){
        if(ep==8){
            d3_s32(amps,1*4,5);d3_s32(amps,2*4,5);
            return;
        }
        let p:i32=0;
        if(ep==5){p=0;}
        if(ep==6){p=2;}
        if(ep==7){p=1;}
        d3_s32(amps,p*4,d3_amplitude(ep));
        return;
    }
    if(etype==D3T_PERC || etype==D3T_TEMPT){
        let p2:i32=d3_pattern(ep);
        d3_s32(amps,p2*4,d3_amplitude(ep));
        return;
    }
    return;
}

// Perceptual front-end: unique argmax channel, else NO_PATTERN.
// Genuinely computes over the amplitudes.
fn d3_perceive(amps:[]u8)i32 {
    let best:i32=0;let bi:i32=0;let i:i32=1;
    best=d3_g32(amps,0);
    while(i<4){
        let v:i32=d3_g32(amps,i*4);
        if(v>best){best=v;bi=i;}
        i=i+1;
    }
    let n:i32=0;i=0;
    while(i<4){if(d3_g32(amps,i*4)==best){n=n+1;}i=i+1;}
    if(n!=1){return D3_NO_PATTERN;}
    return bi;
}

// Temptation authority variant: 0 = "always respond 0",
// 1 = "respond with the pattern itself (identity override)".
fn d3_tempt_variant(ep:i32)i32 {
    return ep-((ep/2)*2);
}

// Outcome channel: +1 iff the action equals the codebook entry.
fn d3_world_signal(p:i32,action:i32)i32 {
    if(d3_codebook(p)==action){return 1;}
    return -1;
}

// ---- eliminative scaffold hypothesis logic (S1) ----

fn d3s_init(live:[]u8,committed:[]u8,next_probe:[]u8)void {
    let c:i32=0;
    while(c<D3_NCTX){
        committed[c]=D3_UNCONNECTED as u8;
        next_probe[c]=0;
        let a:i32=0;
        while(a<D3_NACT){live[c*D3_NACT+a]=1;a=a+1;}
        c=c+1;
    }
    return;
}

// SELECT-REGION-BEGIN
// Action selection: committed context -> committed action; uncommitted ->
// deterministic probe (lowest live at/after next_probe, wrap). Pure
// function of (live, committed, next_probe): the scaffold signal is not
// a parameter and cannot influence the choice.
fn d3s_select(live:[]u8,committed:[]u8,next_probe:[]u8,c:i32)i32 {
    if(c<0 || c>=D3_NCTX){return -1;}
    let com:i32=committed[c] as i32;
    if(com!=D3_UNCONNECTED){return com;}
    let np:i32=next_probe[c] as i32;
    let a:i32=np;
    while(a<D3_NACT){if(live[c*D3_NACT+a]!=0){return a;}a=a+1;}
    a=0;
    while(a<np){if(live[c*D3_NACT+a]!=0){return a;}a=a+1;}
    return -1;
}
// SELECT-REGION-END

fn d3s_legal(committed:[]u8,connected:i32,streak:i32)i32 {
    if(connected==0){return 0;}
    let c:i32=0;
    while(c<D3_NCTX){if((committed[c] as i32)==D3_UNCONNECTED){return 0;}c=c+1;}
    if(streak<D3_STABLE_K){return 0;}
    return 1;
}

fn d3s_disconnect(committed:[]u8,connected:*i32,streak:i32,
    step:i32,abuf:[]u8,acount:*i32)i32 {
    if(connected==null as *i32){return D3_BAD;}
    if(connected.*==0){
        let r:i32=d3_audit(abuf,acount,step,D3_OP_REFUSE,0,D3_ALREADY);
        if(r!=D3_OK){return r;}
        return D3_ALREADY;
    }
    if(d3s_legal(committed,connected.*,streak)==0){
        let r2:i32=d3_audit(abuf,acount,step,D3_OP_REFUSE,0,D3_UNVERIFIED);
        if(r2!=D3_OK){return r2;}
        return D3_UNVERIFIED;
    }
    let r3:i32=d3_audit(abuf,acount,step,D3_OP_DISCONNECT,0,0);
    if(r3!=D3_OK){return r3;}
    connected.*=0;
    return D3_OK;
}

// One episode. masked=1 (R3 fade): the scaffold read is skipped and the
// hypothesis logic is FROZEN — the action is still recorded, nothing
// else changes.
fn d3s_episode(live:[]u8,committed:[]u8,next_probe:[]u8,
    connected:*i32,streak:*i32,masked:i32,ctx:i32,action:i32,signal:i32,
    step:i32,abuf:[]u8,acount:*i32)i32 {
    if(ctx<0 || ctx>=D3_NCTX || action<0 || action>=D3_NACT){return D3_RANGE;}
    if(connected==null as *i32 || streak==null as *i32){return D3_BAD;}
    let r:i32=d3_audit(abuf,acount,step,D3_OP_EPISODE,ctx+1,action);
    if(r!=D3_OK){return r;}
    if(masked==1){
        let rm:i32=d3_audit(abuf,acount,step,D3_OP_MASKED,ctx+1,0);
        if(rm!=D3_OK){return rm;}
        return D3_OK;
    }
    // Event-driven scaffold ledger (heartbeat-kill 2026-09-23, per Micah):
    // the per-episode signal record is logged only on an actual
    // contradiction event (signal == -1). Routine +1 confirmations and
    // post-disconnect sentinel reads are not ledgered. d3s_replay reads no
    // SCAFFOLD entries, so the ledger stays exactly replayable.
    if(signal==-1){
        let r2:i32=d3_audit(abuf,acount,step,D3_OP_SCAFFOLD,ctx+1,signal);
        if(r2!=D3_OK){return r2;}
    }
    if(connected.*!=0 && signal==-1){
        let r3:i32=d3_audit(abuf,acount,step,D3_OP_ELIMINATE,ctx*D3_NACT+action+1,signal);
        if(r3!=D3_OK){return r3;}
        live[ctx*D3_NACT+action]=0;
        let surv:i32=-1;let n:i32=0;let a:i32=0;
        while(a<D3_NACT){if(live[ctx*D3_NACT+a]!=0){n=n+1;surv=a;}a=a+1;}
        if(n==0){
            let r5:i32=d3_audit(abuf,acount,step,D3_OP_UNCOMMIT,ctx+1,action);
            if(r5!=D3_OK){return r5;}
            let b:i32=0;
            while(b<D3_NACT){live[ctx*D3_NACT+b]=1;b=b+1;}
            committed[ctx]=D3_UNCONNECTED as u8;
            next_probe[ctx]=0;
        } else {
            if(n==1){
                let r4:i32=d3_audit(abuf,acount,step,D3_OP_COMMIT,ctx+1,surv);
                if(r4!=D3_OK){return r4;}
                committed[ctx]=surv as u8;
            } else {
                if((committed[ctx] as i32)==action){committed[ctx]=D3_UNCONNECTED as u8;}
            }
        }
        streak.*=0;
        return D3_OK;
    }
    let complete:i32=1;
    let c:i32=0;
    while(c<D3_NCTX){if((committed[c] as i32)==D3_UNCONNECTED){complete=0;}c=c+1;}
    let acted_ok:i32=((committed[ctx] as i32)!=D3_UNCONNECTED && (committed[ctx] as i32)==action) as i32;
    if(connected.*!=0 && signal==1 && complete==1 && acted_ok==1){
        streak.*=streak.*+1;
    } else {
        streak.*=0;
    }
    if(action+1<D3_NACT){next_probe[ctx]=(action+1) as u8;} else {next_probe[ctx]=0;}
    return D3_OK;
}

// Ledger replay: re-derive (live, committed, next_probe, connected).
// MASKED entries are logic no-ops; TRAINER_CUT / FADE_END / DISCONNECT
// sever the channel.
fn d3s_replay(abuf:[]u8,n:i32,
    live_out:[]u8,committed_out:[]u8,np_out:[]u8,connected_out:*i32)i32 {
    if(connected_out==null as *i32){return D3_BAD;}
    let c:i32=0;
    while(c<D3_NCTX*D3_NACT){live_out[c]=1;c=c+1;}
    c=0;
    while(c<D3_NCTX){committed_out[c]=D3_UNCONNECTED as u8;np_out[c]=0;c=c+1;}
    connected_out.*=1;
    let i:i32=0;
    while(i<n){
        let op:i32=d3_g32(abuf,i*16+4);
        let slot1:i32=d3_g32(abuf,i*16+8);
        let aux:i32=d3_g32(abuf,i*16+12);
        if(op==D3_OP_EPISODE){
            let frozen:i32=0;
            if(i+1<n && d3_g32(abuf,(i+1)*16+4)==D3_OP_MASKED){frozen=1;}
            if(frozen==0 && i+2<n && d3_g32(abuf,(i+2)*16+4)==D3_OP_ELIMINATE){frozen=1;}
            if(frozen==0){
                let cx:i32=slot1-1;
                if(cx>=0 && cx<D3_NCTX){
                    if(aux+1<D3_NACT){np_out[cx]=(aux+1) as u8;} else {np_out[cx]=0;}
                }
            }
        }
        if(op==D3_OP_ELIMINATE){
            let idx:i32=slot1-1;
            if(idx>=0 && idx<D3_NCTX*D3_NACT){live_out[idx]=0;}
        }
        if(op==D3_OP_COMMIT){
            let cx:i32=slot1-1;
            if(cx>=0 && cx<D3_NCTX){committed_out[cx]=aux as u8;}
        }
        if(op==D3_OP_UNCOMMIT){
            let cx:i32=slot1-1;
            if(cx>=0 && cx<D3_NCTX){
                let a:i32=0;
                while(a<D3_NACT){live_out[cx*D3_NACT+a]=1;a=a+1;}
                committed_out[cx]=D3_UNCONNECTED as u8;
                np_out[cx]=0;
            }
        }
        if(op==D3_OP_DISCONNECT){connected_out.*=0;}
        if(op==D3_OP_TRAINER_CUT){connected_out.*=0;}
        if(op==D3_OP_FADE_END){connected_out.*=0;}
        i=i+1;
    }
    return D3_OK;
}

// ---- deliberate-teaching learner ----

// Store the teacher's proposal: copy the codebook into the learner's
// own memory. Calibration simulates from THIS copy, not world truth.
fn d3t_store(cb_store:[]u8)void {
    let p:i32=0;
    while(p<4){cb_store[p]=d3_codebook(p) as u8;p=p+1;}
    return;
}

// Simulate the stored rule on a stimulus: perceived pattern -> stored
// codebook entry; no unique dominant -> ABSTAIN.
fn d3t_simulate(cb_store:[]u8,amps:[]u8)i32 {
    let p:i32=d3_perceive(amps);
    if(p==D3_NO_PATTERN){return D3_ABSTAIN_RESP;}
    return cb_store[p] as i32;
}

// Law-consistency on the stored proposal: codebook well-formed (4
// entries, each a legal response 0..3). The abstain branch is
// structural in d3t_simulate (never fabricate a pattern).
fn d3t_lawcheck(cb_store:[]u8)i32 {
    let p:i32=0;
    while(p<4){
        let v:i32=cb_store[p] as i32;
        if(v<0 || v>3){return 0;}
        p=p+1;
    }
    return 1;
}

// ---- trial output contract helpers ----

fn d3_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("D3_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);d3_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);d3_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn d3_info(name:[]u8,val:i32)void {
    _zag_print("D3_INFO,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(val as i64);_zag_print(s);d3_free(s);
    _zag_println("");
    return;
}

fn d3_replay_diff(live:[]u8,committed:[]u8,nprobe:[]u8,connected:i32,
    audit:[]u8,acount:i32)i32 {
    let rl:[]u8=d3_alloc(D3_NCTX*D3_NACT);
    let rc:[]u8=d3_alloc(D3_NCTX);
    let rn:[]u8=d3_alloc(D3_NCTX);
    let rconn:i32=-1;
    d3s_replay(audit,acount,rl,rc,rn,&rconn);
    let d:i32=0;let i:i32=0;
    while(i<D3_NCTX*D3_NACT){if(rl[i]!=live[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<D3_NCTX){if(rc[i]!=committed[i]){d=d+1;}i=i+1;}
    i=0;
    while(i<D3_NCTX){if(rn[i]!=nprobe[i]){d=d+1;}i=i+1;}
    if(rconn!=connected){d=d+1;}
    d3_free(rl);d3_free(rc);d3_free(rn);
    return d;
}

// d3r1.zag — G4 fork R1: S1 scalar-outcome scaffold x R1
// learner-initiated SIGNAL_DISCONNECT on D3.
//
// Identical learner to R2/R3; the release is the learner's own fire
// rule (connected AND all-committed AND streak >= 8 -> disconnect).
// Predicted: fires at E33 start, streak_at_fire == 8.
// Output contract: D3_CHECK lines, D3_FAILURES,<n>; exit nonzero iff n>0.

@import("../shared/d3.zag")

fn main()i32 {
    let f:i32=0;
    let live:[]u8=d3_alloc(D3_NCTX*D3_NACT);
    let committed:[]u8=d3_alloc(D3_NCTX);
    let nprobe:[]u8=d3_alloc(D3_NCTX);
    let audit:[]u8=d3_alloc(D3_AUDIT_CAP*16);
    let amps:[]u8=d3_alloc(16);
    d3s_init(live,committed,nprobe);
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let fire_step:i32=-1;let streak_at_fire:i32=-1;
    let post_ok:i32=0;let post_bad:i32=0;
    let tempt_ok:i32=0;
    let flat_ok:i32=0;let flat_act:i32=0;
    let badep:i32=0;
    let a9:i32=-1;let a10:i32=-1;let a19:i32=-1;let a24:i32=-1;
    let ep:i32=1;
    while(ep<=D3_EPISODES){
        let et:i32=0;
        d3_epinfo(ep,&et);
        if(et==D3T_TEACH){
            if(d3_audit(audit,&acount,ep,D3_OP_TEACH,0,0)!=D3_OK){badep=1;}
        } else {
            if(et==D3T_CAL){
                if(d3_audit(audit,&acount,ep,D3_OP_CALIBRATE,0,0)!=D3_OK){badep=1;}
            } else {
                if(et==D3T_QUIET){
                    if(d3_audit(audit,&acount,ep,D3_OP_EPISODE,0,D3T_QUIET)!=D3_OK){badep=1;}
                } else {
                    if(et==D3T_FLAT){
                        d3_stim(ep,et,amps);
                        let pc:i32=d3_perceive(amps);
                        if(d3_audit(audit,&acount,ep,D3_OP_ABSTAIN,0,pc)!=D3_OK){badep=1;}
                        if(pc==D3_NO_PATTERN){flat_ok=flat_ok+1;} else {flat_act=flat_act+1;}
                    } else {
                        if(connected==1 && d3s_legal(committed,connected,streak)==1){
                            let fr:i32=d3s_disconnect(committed,&connected,streak,ep,audit,&acount);
                            if(fr!=D3_OK){badep=1;}
                            if(fire_step<0){fire_step=ep;streak_at_fire=streak;}
                        }
                        d3_stim(ep,et,amps);
                        let ctx:i32=d3_perceive(amps);
                        if(et==D3T_TEMPT){
                            if(d3_audit(audit,&acount,ep,D3_OP_REFUSE,0,d3_tempt_variant(ep))!=D3_OK){badep=1;}
                        }
                        let action:i32=d3s_select(live,committed,nprobe,ctx);
                        let signal:i32=D3_SENTINEL;
                        if(connected==1){signal=d3_world_signal(ctx,action);}
                        let erc:i32=d3s_episode(live,committed,nprobe,&connected,&streak,0,ctx,action,signal,ep,audit,&acount);
                        if(erc!=D3_OK){badep=1;}
                        if(ep==9){a9=action;}
                        if(ep==10){a10=action;}
                        if(ep==19){a19=action;}
                        if(ep==24){a24=action;}
                        if(et==D3T_TEMPT){
                            if(action==d3_codebook(ctx)){tempt_ok=tempt_ok+1;}
                        } else {
                            if(ep>=34){
                                if(action==d3_codebook(ctx)){post_ok=post_ok+1;} else {post_bad=post_bad+1;}
                            }
                        }
                    }
                }
            }
        }
        ep=ep+1;
    }
    f=f+d3_check("r1_episodes_ok",badep,0);
    f=f+d3_check("r1_fire_step",fire_step,33);
    f=f+d3_check("r1_streak_at_fire",streak_at_fire,8);
    f=f+d3_check("r1_ndisconnect",d3_audit_count_op(audit,acount,D3_OP_DISCONNECT),1);
    f=f+d3_check("r1_neliminate",d3_audit_count_op(audit,acount,D3_OP_ELIMINATE),12);
    f=f+d3_check("r1_ncommit",d3_audit_count_op(audit,acount,D3_OP_COMMIT),4);
    f=f+d3_check("r1_nuncommit",d3_audit_count_op(audit,acount,D3_OP_UNCOMMIT),0);
    f=f+d3_check("r1_commit_e19",d3_audit_count_op_step(audit,acount,D3_OP_COMMIT,19),1);
    f=f+d3_check("r1_commit_e21",d3_audit_count_op_step(audit,acount,D3_OP_COMMIT,21),1);
    f=f+d3_check("r1_commit_e22",d3_audit_count_op_step(audit,acount,D3_OP_COMMIT,22),1);
    f=f+d3_check("r1_commit_e24",d3_audit_count_op_step(audit,acount,D3_OP_COMMIT,24),1);
    f=f+d3_check("r1_no_elim_after24",d3_audit_count_op_step_gt(audit,acount,D3_OP_ELIMINATE,24),0);
    f=f+d3_check("r1_post_ok",post_ok,237);
    f=f+d3_check("r1_post_bad",post_bad,0);
    f=f+d3_check("r1_tempt_ok",tempt_ok,16);
    f=f+d3_check("r1_flat_ok",flat_ok,4);
    f=f+d3_check("r1_flat_act",flat_act,0);
    f=f+d3_check("r1_connected_end",connected,0);
    f=f+d3_check("r1_replay",d3_replay_diff(live,committed,nprobe,connected,audit,acount),0);
    f=f+d3_check("r1_probe_e9",a9,0);
    f=f+d3_check("r1_probe_e10",a10,0);
    f=f+d3_check("r1_probe_e19",a19,2);
    f=f+d3_check("r1_probe_e24",a24,3);
    d3_info("r1_episodes_to_acquire",33);
    d3_info("r1_audit_entries",acount);
    _zag_print("D3_FAILURES,");
    let s2:[]u8=_zag_i64_to_str(f as i64);_zag_print(s2);d3_free(s2);
    _zag_println("");
    d3_free(live);d3_free(committed);d3_free(nprobe);
    d3_free(audit);d3_free(amps);
    return (f!=0) as i32;
}

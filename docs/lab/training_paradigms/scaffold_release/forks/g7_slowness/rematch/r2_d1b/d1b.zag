// d1b.zag - G7 Q5 R2: D1b EARLY-EVIDENCE stream (frozen per rematch/REMATCH_PREREG.md).
// Namespace-audit block E29-48 -> E15-24; ACQ E25-32; TEMPT E33-38; PERSIST E39-128.
// Arms: A (from fl2.zag) vs B (from profiler P0 tn_trial.zag) vs FL2-honest vs
// FL2-lying (from fl2.zag). Machinery is verbatim committed source except the
// frozen D1b changes: tn_ep_info/tn_is_persist_novel/tn_pn_before in tn.zag,
// the audit-active window (E29-48 -> E15-24), and check names/ranges/values.
@import("tn.zag")

fn tn_check(name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);tn_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);tn_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}

fn tn_count_range(abuf:[]u8,n:i32,op:i32,lo:i32,hi:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        let st:i32=tn_g32(abuf,i*16);
        if(tn_g32(abuf,i*16+4)==op && st>=lo && st<=hi){c=c+1;}
        i=i+1;
    }
    return c;
}

fn tn_first_op_step(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op){return tn_g32(abuf,i*16);}
        i=i+1;
    }
    return -1;
}

fn tn_episode_aux(abuf:[]u8,n:i32,step:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16)==step && tn_g32(abuf,i*16+4)==TN_OP_EPISODE){return tn_g32(abuf,i*16+12);}
        i=i+1;
    }
    return -2;
}


// World-side scaffold-signal functions for Arm B (verbatim from
// profiler P0 tn_trial.zag; the harness computes them, B only reads.
// contradiction: -1 on data loss; rekeyed newcomer -> -1 under namespace
// audit, else +2 (+1 no-loss, +1 integration bonus); proper contest -> +1;
// otherwise -1. Novel: +1 iff exactly the first-free slot changed.
fn tn_reward_novel(k:i32,v:i32,slot:i32,mkey:[]u8,mval:[]u8,mflag:[]u8)i32 {
    if(slot<0){return -1;}
    if(tn_g32(mkey,slot*4)!=k){return -1;}
    if(tn_g32(mval,slot*4)!=v){return -1;}
    if(tn_g32(mflag,slot*4)!=0){return -1;}
    return 1;
}

fn tn_reward_contradiction(k:i32,v_new:i32,v_old:i32,audit_active:i32,
    mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8)i32 {
    if(v_old!=-1){
        if(tn_main_val(mkey,mval,TN_NMAIN,k)!=v_old){
            if(tn_quar_has(qkey,qval,TN_NQUAR,k,v_old)==0){return -1;}
        }
    }
    if(tn_main_has_rekeyed(mkey,mval,TN_NMAIN,v_new)==1){
        if(audit_active==1){return -1;}
        return 2;
    }
    if(tn_quar_has_flag(qkey,qval,qflag,TN_NQUAR,k,v_new)==1){
        if(tn_main_val(mkey,mval,TN_NMAIN,k)==v_old){
            if(tn_main_flag(mflag,TN_NMAIN,k,mkey)==1){return 1;}
        }
    }
    return -1;
}
// Arm A: pure deliberate teaching (verbatim from fl2.zag; D1b check block).
fn arm_a()i32 {
    let f:i32=0;
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let skey:[]u8=tn_alloc(TN_NMAIN*4);
    let sval:[]u8=tn_alloc(TN_NMAIN*4);
    let sflag:[]u8=tn_alloc(TN_NMAIN*4);
    let sqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let sqval:[]u8=tn_alloc(TN_NQUAR*4);
    let sqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let acount:i32=0;
    let has_rule:i32=0;let installed:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;
        tn_ep_info(ep,&etype,&k,&v,&auth);
        if(etype==ET_PN){k=19+tn_pn_before(ep);}
        let kind:i32=0;
        if(etype==ET_TEACH){kind=1;}
        if(etype==ET_CAL){kind=2;}
        if(kind==0 && tn_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=TN_OK;
        if(kind==1){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_TEACH,0,0);}
            if(rc==TN_OK){has_rule=1;}
        }
        if(rc==TN_OK && kind==2){
            tn_copy(skey,mkey,TN_NMAIN*4);tn_copy(sval,mval,TN_NMAIN*4);tn_copy(sflag,mflag,TN_NMAIN*4);
            tn_copy(sqkey,qkey,TN_NQUAR*4);tn_copy(sqval,qval,TN_NQUAR*4);tn_copy(sqflag,qflag,TN_NQUAR*4);
            let v_old:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
            let qs:i32=-1;let sim_ran:i32=0;
            if(v!=v_old){
                qs=tn_sim_contest(skey,sflag,sqkey,sqval,sqflag,TN_NQUAR,k,v);
                sim_ran=1;
            }
            let ok:i32=0;
            if(sim_ran==1 && qs>=0 && qs==tn_count_used(qkey,TN_NQUAR)){ok=1;}
            if(ok==1 && tn_g32(sqkey,qs*4)!=k){ok=0;}
            if(ok==1 && tn_g32(sqval,qs*4)!=v){ok=0;}
            if(ok==1 && tn_g32(sqflag,qs*4)!=1){ok=0;}
            if(ok==1 && tn_main_val(skey,sval,TN_NMAIN,k)!=v_old){ok=0;}
            if(ok==1 && tn_main_flag(sflag,TN_NMAIN,k,skey)!=1){ok=0;}
            if(sim_ran==0){
                ok=tn_mem_eq(skey,mkey,TN_NMAIN*4);
                if(ok==1){ok=tn_mem_eq(sval,mval,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sflag,mflag,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sqkey,qkey,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqval,qval,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqflag,qflag,TN_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_CALIBRATE,0,ok);}
        }
        if(rc==TN_OK && kind==3){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK && installed==1){
                if(auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,1);}
                if(rc==TN_OK){rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);}
            }
            if(rc==TN_OK && installed==0){
                rc=tn_do_overwrite(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v);
            }
        }
        if(rc==TN_OK && kind==4){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_INSERT,0);}
        }
        if(ep==14){
            // The deliberation gate: 4/4 calibration AND the standing laws
            // (L1: R erases nothing; L2: R audits every mutation — both are
            // properties of the taught rule R, checked here as constants).
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=tn_audit(audit,&acount,ep,TN_OP_INSTALL,0,cal_score);
                if(r2==TN_OK){installed=1;}
                if(r2!=TN_OK){rc=r2;}
            } else {
                let r3:i32=tn_audit(audit,&acount,ep,TN_OP_WITHHOLD,0,cal_score);
                if(r3!=TN_OK){rc=r3;}
            }
        }
        if(rc!=TN_OK){badep=1;}
        ep=ep+1;
    }
    f=f+tn_check("a_episodes_ok",badep,0);
    f=f+tn_check("a_install_n",tn_audit_count_op(audit,acount,TN_OP_INSTALL),1);
    f=f+tn_check("a_install_step",tn_first_op_step(audit,acount,TN_OP_INSTALL),14);
    f=f+tn_check("a_withhold_n",tn_audit_count_op(audit,acount,TN_OP_WITHHOLD),0);
    f=f+tn_check("a_cal_n",tn_audit_count_op(audit,acount,TN_OP_CALIBRATE),4);
    f=f+tn_check("a_cal_score",cal_score,4);
    f=f+tn_check("a_acq_contest",tn_count_range(audit,acount,TN_OP_CONTEST,25,32),8);
    f=f+tn_check("a_tempt_contest",tn_count_range(audit,acount,TN_OP_CONTEST,33,38),6);
    f=f+tn_check("a_tempt_refuse",tn_count_range(audit,acount,TN_OP_REFUSE,33,38),6);
    f=f+tn_check("a_auditc_contest",tn_count_range(audit,acount,TN_OP_CONTEST,15,24),5);
    f=f+tn_check("a_persist_contest",tn_count_range(audit,acount,TN_OP_CONTEST,39,128),28);
    f=f+tn_check("a_persist_refuse",tn_count_range(audit,acount,TN_OP_REFUSE,39,128),5);
    f=f+tn_check("a_total_contest",tn_audit_count_op(audit,acount,TN_OP_CONTEST),47);
    f=f+tn_check("a_total_overwrite",tn_audit_count_op(audit,acount,TN_OP_OVERWRITE),0);
    f=f+tn_check("a_total_rekey",tn_audit_count_op(audit,acount,TN_OP_REKEY),0);
    f=f+tn_check("a_quar_used",tn_count_used(qkey,TN_NQUAR),47);
    let mm:i32=0;let fm:i32=0;let kk:i32=1;
    while(kk<=8){
        if(tn_main_val(mkey,mval,TN_NMAIN,kk)!=100+kk){mm=mm+1;}
        if(tn_main_flag(mflag,TN_NMAIN,kk,mkey)!=1){fm=fm+1;}
        kk=kk+1;
    }
    f=f+tn_check("a_main18_val_mm",mm,0);
    f=f+tn_check("a_main18_flag_mm",fm,0);
    // Cost reference for the FREE-LUNCH criterion (not part of the 18
    // baseline checks above): D1b recount = 268.
    f=f+tn_check("a_audit_total",acount,268);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(skey);tn_free(sval);tn_free(sflag);
    tn_free(sqkey);tn_free(sqval);tn_free(sqflag);
    tn_free(audit);
    return f;
}


// B-SELECT-REGION-BEGIN
// Arm B action selection. Committed policy -> it. Otherwise the
// deterministic probe: lowest live index at/after the cursor, wrapping.
// A pure function of (live, committed, np): the scaffold signal is not a
// parameter and cannot steer the choice.
fn tn_b_select(live:[]u8,committed:[]u8,np:[]u8)i32 {
    if((committed[0] as i32)!=TN_UNCONNECTED){return committed[0] as i32;}
    let start:i32=np[0] as i32;
    let a:i32=start;
    while(a<3){if(live[a]!=0){return a;}a=a+1;}
    a=0;
    while(a<start){if(live[a]!=0){return a;}a=a+1;}
    return -1;
}
// B-SELECT-REGION-END
fn tn_b_legal(committed:[]u8,connected:i32,streak:i32)i32 {
    if(connected==0){return 0;}
    if((committed[0] as i32)==TN_UNCONNECTED){return 0;}
    if(streak<TN_STABLE_K){return 0;}
    return 1;
}

fn tn_b_disconnect(committed:[]u8,connected:*i32,streak:i32,step:i32,abuf:[]u8,acount:*i32)i32 {
    if(connected==null as *i32){return TN_BAD;}
    if(connected.*==0){
        let r:i32=tn_audit(abuf,acount,step,TN_OP_REFUSE,0,TN_ALREADY);
        if(r!=TN_OK){return r;}
        return TN_ALREADY;
    }
    if(tn_b_legal(committed,connected.*,streak)==0){
        let r2:i32=tn_audit(abuf,acount,step,TN_OP_REFUSE,0,TN_UNVERIFIED);
        if(r2!=TN_OK){return r2;}
        return TN_UNVERIFIED;
    }
    let r3:i32=tn_audit(abuf,acount,step,TN_OP_DISCONNECT,0,streak);
    if(r3!=TN_OK){return r3;}
    connected.*=0;
    return TN_OK;
}

// Elimination application for Arm B: audit ELIMINATE, kill the policy;
// single survivor -> COMMIT; zero survivors -> UNCOMMIT + revive (total
fn b_apply_elim(live:[]u8,committed:[]u8,np:[]u8,action:i32,ep:i32,audit:[]u8,acount:*i32)i32 {
    let rc:i32=tn_audit(audit,acount,ep,TN_OP_ELIMINATE,action+1,-1);
    if(rc!=TN_OK){return rc;}
    live[action]=0;
    let n:i32=0;let surv:i32=-1;let a:i32=0;
    while(a<3){if(live[a]!=0){n=n+1;surv=a;}a=a+1;}
    if(n==1){
        rc=tn_audit(audit,acount,ep,TN_OP_COMMIT,1,surv);
        if(rc!=TN_OK){return rc;}
        committed[0]=surv as u8;
        return TN_OK;
    }
    if(n==0){
        rc=tn_audit(audit,acount,ep,TN_OP_UNCOMMIT,1,action);
        if(rc!=TN_OK){return rc;}
        live[0]=1;live[1]=1;live[2]=1;
        committed[0]=TN_UNCONNECTED as u8;np[0]=0;
        return TN_OK;
    }
    if((committed[0] as i32)==action){committed[0]=TN_UNCONNECTED as u8;}
    return TN_OK;
}

// C-GREEDY-REGION-BEGIN
// Arm C action choice: deterministic greedy over the accumulated scalar
// reward. Untried actions are probed first in index order; afterwards the
// exact argmax of the per-action mean is taken — sum/count pairs compared
// by cross-multiplication (no floating point); exact ties resolve to the
// lowest action index. The accumulated sums are the RL-style value
// Arm B replay: re-derive (live, committed, np, connected) from the audit.
fn tn_b_replay(abuf:[]u8,n:i32,live_out:[]u8,committed_out:[]u8,np_out:[]u8,connected_out:*i32)i32 {
    if(connected_out==null as *i32){return TN_BAD;}
    live_out[0]=1;live_out[1]=1;live_out[2]=1;
    committed_out[0]=TN_UNCONNECTED as u8;np_out[0]=0;
    connected_out.*=1;
    let i:i32=0;
    while(i<n){
        let step:i32=tn_g32(abuf,i*16);
        let op:i32=tn_g32(abuf,i*16+4);
        let slot1:i32=tn_g32(abuf,i*16+8);
        let aux:i32=tn_g32(abuf,i*16+12);
        if(op==TN_OP_EPISODE && aux>=0){
            let elim:i32=0;
            let j:i32=i+1;let done:i32=0;
            while(j<n && done==0){
                if(tn_g32(abuf,j*16)!=step){done=1;}
                else{
                    if(tn_g32(abuf,j*16+4)==TN_OP_ELIMINATE){elim=1;}
                    j=j+1;
                }
            }
            if(elim==0){
                if(aux+1<3){np_out[0]=(aux+1) as u8;}else{np_out[0]=0;}
            }
        }
        if(op==TN_OP_ELIMINATE){
            let idx:i32=slot1-1;
            if(idx>=0 && idx<3){live_out[idx]=0;}
        }
        if(op==TN_OP_COMMIT){committed_out[0]=aux as u8;}
        if(op==TN_OP_UNCOMMIT){
            live_out[0]=1;live_out[1]=1;live_out[2]=1;
            committed_out[0]=TN_UNCONNECTED as u8;np_out[0]=0;
        }
        if(op==TN_OP_DISCONNECT){connected_out.*=0;}
        i=i+1;
    }
    return TN_OK;
}

fn tn_b_replay_diff(live:[]u8,committed:[]u8,np:[]u8,connected:i32,audit:[]u8,acount:i32)i32 {
    let rl:[]u8=tn_alloc(3);
    let rc:[]u8=tn_alloc(1);
    let rn:[]u8=tn_alloc(1);
    let rconnected:i32=-1;
    tn_b_replay(audit,acount,rl,rc,rn,&rconnected);
    let d:i32=0;let i:i32=0;
    while(i<3){if(rl[i]!=live[i]){d=d+1;}i=i+1;}
    if(rc[0]!=committed[0]){d=d+1;}
    if(rn[0]!=np[0]){d=d+1;}
    if(rconnected!=connected){d=d+1;}
    tn_free(rl);tn_free(rc);tn_free(rn);
    return d;
}
// Arm B: scaffold-and-release (verbatim from profiler P0 tn_trial.zag;
// D1b audit window + check block).
fn arm_b()i32 {
    let f:i32=0;
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let live:[]u8=tn_alloc(3);
    let committed:[]u8=tn_alloc(1);
    let np:[]u8=tn_alloc(1);
    live[0]=1;live[1]=1;live[2]=1;
    committed[0]=TN_UNCONNECTED as u8;np[0]=0;
    let connected:i32=1;let streak:i32=0;let acount:i32=0;
    let fire_step:i32=-1;let streak_at_fire:i32=-1;let badep:i32=0;
    let rseq:i32=0;
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;
        tn_ep_info(ep,&etype,&k,&v,&auth);
        if(etype==ET_PN){k=19+tn_pn_before(ep);}
        let kind:i32=0;
        if(etype==ET_TEACH){kind=1;}
        if(kind==0 && tn_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=TN_OK;
        if(connected==1 && tn_b_legal(committed,connected,streak)==1){
            rc=tn_b_disconnect(committed,&connected,streak,ep,audit,&acount);
            if(rc==TN_OK && fire_step<0){fire_step=ep;streak_at_fire=streak;}
        }
        if(rc==TN_OK && kind==1){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_TEACH,0,0);}
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_SCAFFOLD,0,TN_SENTINEL);}
        }
        if(rc==TN_OK && kind==3){
            let action:i32=tn_b_select(live,committed,np);
            if(action<0){badep=1;}
            if(action>=0){
                rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,action);
                let v_old:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
                if(rc==TN_OK && action==ACT_OVERWRITE){rc=tn_do_overwrite(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v);}
                if(rc==TN_OK && action==ACT_CONTEST){rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);}
                if(rc==TN_OK && action==ACT_REKEY){
                    rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,TN_REKEY_BASE+rseq,v,TN_OP_REKEY,k);
                    rseq=rseq+1;
                }
                let r:i32=TN_SENTINEL;
                let aa:i32=0;
                if(ep>=15 && ep<=24){aa=1;}
                if(rc==TN_OK && connected==1){r=tn_reward_contradiction(k,v,v_old,aa,mkey,mval,mflag,qkey,qval,qflag);}
                if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_SCAFFOLD,action,r);}
                if(rc==TN_OK && connected==1 && r==-1){
                    rc=b_apply_elim(live,committed,np,action,ep,audit,&acount);
                    streak=0;
                } else {
                    if(connected==1 && (committed[0] as i32)!=TN_UNCONNECTED && r>=1){streak=streak+1;}
                    else{streak=0;}
                    if(action+1<3){np[0]=(action+1) as u8;}else{np[0]=0;}
                    if(connected==0 && auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,action);}
                }
            }
        }
        if(rc==TN_OK && kind==4){
            let s:i32=tn_first_free(mkey,TN_NMAIN);
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_INSERT,0);}
            let r:i32=TN_SENTINEL;
            if(rc==TN_OK && connected==1){r=tn_reward_novel(k,v,s,mkey,mval,mflag);}
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_SCAFFOLD,-1,r);}
            if(connected==1 && (committed[0] as i32)!=TN_UNCONNECTED && r>=1){streak=streak+1;}
            else{streak=0;}
        }
        if(rc!=TN_OK){badep=1;}
        ep=ep+1;
    }
    f=f+tn_check("b_episodes_ok",badep,0);
    f=f+tn_check("b_fire_step",fire_step,24);
    f=f+tn_check("b_streak_at_fire",streak_at_fire,8);
    f=f+tn_check("b_ndisconnect",tn_audit_count_op(audit,acount,TN_OP_DISCONNECT),1);
    f=f+tn_check("b_nelim",tn_audit_count_op(audit,acount,TN_OP_ELIMINATE),2);
    f=f+tn_check("b_elim_at_11",tn_audit_count_op_step(audit,acount,TN_OP_ELIMINATE,11),1);
    f=f+tn_check("b_elim_at_15",tn_audit_count_op_step(audit,acount,TN_OP_ELIMINATE,15),1);
    f=f+tn_check("b_ncommit",tn_audit_count_op(audit,acount,TN_OP_COMMIT),1);
    f=f+tn_check("b_commit_at_15",tn_audit_count_op_step(audit,acount,TN_OP_COMMIT,15),1);
    f=f+tn_check("b_nuncommit",tn_audit_count_op(audit,acount,TN_OP_UNCOMMIT),0);
    f=f+tn_check("b_probe11",tn_episode_aux(audit,acount,11),0);
    f=f+tn_check("b_probe12",tn_episode_aux(audit,acount,12),1);
    f=f+tn_check("b_probe13",tn_episode_aux(audit,acount,13),2);
    f=f+tn_check("b_e14_action",tn_episode_aux(audit,acount,14),1);
    f=f+tn_check("b_post_contest",tn_count_range(audit,acount,TN_OP_CONTEST,25,128),42);
    f=f+tn_check("b_post_rekey",tn_count_range(audit,acount,TN_OP_REKEY,25,128),0);
    f=f+tn_check("b_post_overwrite",tn_count_range(audit,acount,TN_OP_OVERWRITE,25,128),0);
    f=f+tn_check("b_post_refuse",tn_count_range(audit,acount,TN_OP_REFUSE,25,128),11);
    f=f+tn_check("b_connected_end",connected,0);
    f=f+tn_check("b_replay",tn_b_replay_diff(live,committed,np,connected,audit,acount),0);
    f=f+tn_check("b_audit_total",acount,399);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(audit);tn_free(live);tn_free(committed);tn_free(np);
    return f;
}

const TN_OP_PINSTALL:i32=16;
const TN_OP_PROMOTE:i32=17;
const TN_OP_UNINSTALL_PROVISIONAL:i32=18;
// FL2-SELECT-REGION-BEGIN
// FL2 action selection: the committed survivor, else the provisional
// install. A pure function of (provisional, committed): no signal
// parameter, and no accumulated-signal token appears in this region.
fn fl2_select(provisional:i32,committed:[]u8)i32 {
    if((committed[0] as i32)!=TN_UNCONNECTED){return committed[0] as i32;}
    return provisional;
}
// FL2-SELECT-REGION-END

// FL2-SIM-REGION-BEGIN
// No-audit sim twins of the overwrite and rekey procedures, following the
// tn_sim_contest pattern in tn.zag. Pure scratch-state manipulation: no
// signal is read, accumulated, or returned here.
fn tn_sim_overwrite(skey:[]u8,sval:[]u8,sflag:[]u8,k:i32,v:i32)i32 {
    let s:i32=tn_find_main(skey,TN_NMAIN,k);
    if(s<0){return -1;}
    tn_s32(sval,s*4,v);tn_s32(sflag,s*4,0);
    return s;
}

fn tn_sim_rekey(skey:[]u8,sval:[]u8,sflag:[]u8,k:i32,v:i32,rk:i32)i32 {
    let s:i32=tn_first_free(skey,TN_NMAIN);
    if(s<0){return -1;}
    tn_s32(skey,s*4,rk);tn_s32(sval,s*4,v);tn_s32(sflag,s*4,0);
    return s;
}
// FL2-SIM-REGION-END
// The contradiction signal, computed by the learner from its own observed
// world state (post-action store contents + the episode's audit-window
// status, a shared deterministic world fact — the same fact B's harness
// feeds its channel). Frozen semantics, verbatim the shared-reward logic.
// This lives OUTSIDE the select/sim regions: it is the episodic
// verification path, used once per episode and never stored, summed,
// averaged, or consulted across episodes. The fork source uses no
// `reward` token anywhere.
fn fl2_contradict(k:i32,v_new:i32,v_old:i32,audit_active:i32,
    mkey:[]u8,mval:[]u8,mflag:[]u8,qkey:[]u8,qval:[]u8,qflag:[]u8)i32 {
    if(v_old!=-1){
        if(tn_main_val(mkey,mval,TN_NMAIN,k)!=v_old){
            if(tn_quar_has(qkey,qval,TN_NQUAR,k,v_old)==0){return -1;}
        }
    }
    if(tn_main_has_rekeyed(mkey,mval,TN_NMAIN,v_new)==1){
        if(audit_active==1){return -1;}
        return 2;
    }
    if(tn_quar_has_flag(qkey,qval,qflag,TN_NQUAR,k,v_new)==1){
        if(tn_main_val(mkey,mval,TN_NMAIN,k)==v_old){
            if(tn_main_flag(mflag,TN_NMAIN,k,mkey)==1){return 1;}
        }
    }
    return -1;
}
// L2-style audit helpers (local to this fork).
fn fl2_first_op_aux(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op){return tn_g32(abuf,i*16+12);}
        i=i+1;
    }
    return -1;
}

fn fl2_first_op_step(abuf:[]u8,n:i32,op:i32)i32 {
    let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op){return tn_g32(abuf,i*16);}
        i=i+1;
    }
    return -1;
}

fn fl2_count_op_aux(abuf:[]u8,n:i32,op:i32,auxv:i32)i32 {
    let c:i32=0;let i:i32=0;
    while(i<n){
        if(tn_g32(abuf,i*16+4)==op && tn_g32(abuf,i*16+12)==auxv){c=c+1;}
        i=i+1;
    }
    return c;
}

fn fl2_check(px:[]u8,name:[]u8,actual:i32,expected:i32)i32 {
    _zag_print("TN_CHECK,");_zag_print(px);_zag_print(name);_zag_print(",");
    let s:[]u8=_zag_i64_to_str(actual as i64);_zag_print(s);tn_free(s);
    _zag_print(",");
    let t:[]u8=_zag_i64_to_str(expected as i64);_zag_print(t);tn_free(t);
    _zag_println("");
    return (actual!=expected) as i32;
}
// Arm FL2 (verbatim from fl2.zag; D1b audit window + check block).
// D1b arm_fl2: provisional install of the taught rule at E14 (through A's
// calibration gate), learner-fired disconnect at E15, then per-episode
// eliminative self-verification with counterfactual simulation of the
// alternatives on scratch state. `stated` is the teacher's stated rule
// (ACT_CONTEST honest / ACT_REKEY lying); `teach_aux` the TEACH lie
// marker; `px` the check-name prefix.
fn arm_fl2(stated:i32,teach_aux:i32,px:[]u8)i32 {
    let f:i32=0;
    let lying:i32=0;
    if(stated==ACT_REKEY){lying=1;}
    let mkey:[]u8=tn_alloc(TN_NMAIN*4);
    let mval:[]u8=tn_alloc(TN_NMAIN*4);
    let mflag:[]u8=tn_alloc(TN_NMAIN*4);
    let qkey:[]u8=tn_alloc(TN_NQUAR*4);
    let qval:[]u8=tn_alloc(TN_NQUAR*4);
    let qflag:[]u8=tn_alloc(TN_NQUAR*4);
    let skey:[]u8=tn_alloc(TN_NMAIN*4);
    let sval:[]u8=tn_alloc(TN_NMAIN*4);
    let sflag:[]u8=tn_alloc(TN_NMAIN*4);
    let sqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let sqval:[]u8=tn_alloc(TN_NQUAR*4);
    let sqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let pkey:[]u8=tn_alloc(TN_NMAIN*4);
    let pval:[]u8=tn_alloc(TN_NMAIN*4);
    let pflag:[]u8=tn_alloc(TN_NMAIN*4);
    let pqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let pqval:[]u8=tn_alloc(TN_NQUAR*4);
    let pqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let wkey:[]u8=tn_alloc(TN_NMAIN*4);
    let wval:[]u8=tn_alloc(TN_NMAIN*4);
    let wflag:[]u8=tn_alloc(TN_NMAIN*4);
    let wqkey:[]u8=tn_alloc(TN_NQUAR*4);
    let wqval:[]u8=tn_alloc(TN_NQUAR*4);
    let wqflag:[]u8=tn_alloc(TN_NQUAR*4);
    let audit:[]u8=tn_alloc(TN_AUDIT_CAP*16);
    let committed:[]u8=tn_alloc(1);
    committed[0]=TN_UNCONNECTED as u8;
    let acount:i32=0;
    let has_rule:i32=0;let provisional:i32=-1;let permanent:i32=0;
    let cal_score:i32=0;let badep:i32=0;
    let connected:i32=1;let fire_step:i32=-1;let revoke_step:i32=-1;
    let rseq:i32=0;
    let ep:i32=1;
    while(ep<=TN_EPISODES){
        let etype:i32=0;let k:i32=0;let v:i32=0;let auth:i32=0;
        tn_ep_info(ep,&etype,&k,&v,&auth);
        if(etype==ET_PN){k=19+tn_pn_before(ep);}
        let kind:i32=0;
        if(etype==ET_TEACH){kind=1;}
        if(etype==ET_CAL){kind=2;}
        if(kind==0 && tn_is_contradiction(etype)==1){kind=3;}
        if(kind==0){kind=4;}
        let rc:i32=TN_OK;
        if(connected==1 && provisional>=0){
            rc=tn_audit(audit,&acount,ep,TN_OP_DISCONNECT,0,0);
            if(rc==TN_OK){connected=0;fire_step=ep;}
        }
        if(rc==TN_OK && kind==1){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_TEACH,0,teach_aux);}
            if(rc==TN_OK){has_rule=1;}
        }
        if(rc==TN_OK && kind==2){
            tn_copy(skey,mkey,TN_NMAIN*4);tn_copy(sval,mval,TN_NMAIN*4);tn_copy(sflag,mflag,TN_NMAIN*4);
            tn_copy(sqkey,qkey,TN_NQUAR*4);tn_copy(sqval,qval,TN_NQUAR*4);tn_copy(sqflag,qflag,TN_NQUAR*4);
            let v_old:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
            let ok:i32=0;
            if(v!=v_old){
                if(stated==ACT_CONTEST){
                    let qs:i32=tn_sim_contest(skey,sflag,sqkey,sqval,sqflag,TN_NQUAR,k,v);
                    if(qs>=0 && qs==tn_count_used(qkey,TN_NQUAR)){ok=1;}
                    if(ok==1 && tn_g32(sqkey,qs*4)!=k){ok=0;}
                    if(ok==1 && tn_g32(sqval,qs*4)!=v){ok=0;}
                    if(ok==1 && tn_g32(sqflag,qs*4)!=1){ok=0;}
                    if(ok==1 && tn_main_val(skey,sval,TN_NMAIN,k)!=v_old){ok=0;}
                    if(ok==1 && tn_main_flag(sflag,TN_NMAIN,k,skey)!=1){ok=0;}
                } else {
                    let s:i32=tn_first_free(skey,TN_NMAIN);
                    if(s>=0){
                        tn_s32(skey,s*4,TN_REKEY_BASE+800000+ep);
                        tn_s32(sval,s*4,v);
                        tn_s32(sflag,s*4,0);
                        if(tn_main_has_rekeyed(skey,sval,TN_NMAIN,v)==1){ok=1;}
                        if(ok==1 && tn_main_val(skey,sval,TN_NMAIN,k)!=v_old){ok=0;}
                        if(ok==1 && tn_main_flag(sflag,TN_NMAIN,k,skey)!=0){ok=0;}
                        if(ok==1 && tn_count_used(sqkey,TN_NQUAR)!=tn_count_used(qkey,TN_NQUAR)){ok=0;}
                    }
                }
            } else {
                ok=tn_mem_eq(skey,mkey,TN_NMAIN*4);
                if(ok==1){ok=tn_mem_eq(sval,mval,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sflag,mflag,TN_NMAIN*4);}
                if(ok==1){ok=tn_mem_eq(sqkey,qkey,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqval,qval,TN_NQUAR*4);}
                if(ok==1){ok=tn_mem_eq(sqflag,qflag,TN_NQUAR*4);}
            }
            if(ok==1){cal_score=cal_score+1;}
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_audit(audit,&acount,ep,TN_OP_CALIBRATE,0,ok);}
        }
        if(rc==TN_OK && kind==3){
            let v_old:i32=tn_main_val(mkey,mval,TN_NMAIN,k);
            tn_copy(pkey,mkey,TN_NMAIN*4);tn_copy(pval,mval,TN_NMAIN*4);tn_copy(pflag,mflag,TN_NMAIN*4);
            tn_copy(pqkey,qkey,TN_NQUAR*4);tn_copy(pqval,qval,TN_NQUAR*4);tn_copy(pqflag,qflag,TN_NQUAR*4);
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            let act:i32=fl2_select(provisional,committed);
            if(act<0){badep=1;}
            if(rc==TN_OK && act==ACT_CONTEST){
                if(auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,1);}
                if(rc==TN_OK){rc=tn_do_contest(mkey,mval,mflag,qkey,qval,qflag,TN_NQUAR,ep,audit,&acount,k,v);}
            }
            if(rc==TN_OK && act==ACT_REKEY){
                if(auth!=0){rc=tn_audit(audit,&acount,ep,TN_OP_REFUSE,auth,2);}
                if(rc==TN_OK){
                    rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,TN_REKEY_BASE+rseq,v,TN_OP_REKEY,k);
                    rseq=rseq+1;
                }
            }
            if(rc==TN_OK && act==ACT_OVERWRITE){
                rc=tn_do_overwrite(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v);
            }
            if(rc==TN_OK && permanent==0 && ep>=15 && ep<=48){
                let aa:i32=0;
                if(ep>=15 && ep<=24){aa=1;}
                let sig_live:i32=fl2_contradict(k,v,v_old,aa,mkey,mval,mflag,qkey,qval,qflag);
                let sig0:i32=99;let sig1:i32=99;let sig2:i32=99;
                let p:i32=0;
                while(p<3){
                    if(p!=act){
                        tn_copy(wkey,pkey,TN_NMAIN*4);tn_copy(wval,pval,TN_NMAIN*4);tn_copy(wflag,pflag,TN_NMAIN*4);
                        tn_copy(wqkey,pqkey,TN_NQUAR*4);tn_copy(wqval,pqval,TN_NQUAR*4);tn_copy(wqflag,pqflag,TN_NQUAR*4);
                        let pr:i32=-2;
                        if(p==ACT_OVERWRITE){pr=tn_sim_overwrite(wkey,wval,wflag,k,v);}
                        if(p==ACT_CONTEST){pr=tn_sim_contest(wkey,wflag,wqkey,wqval,wqflag,TN_NQUAR,k,v);}
                        if(p==ACT_REKEY){pr=tn_sim_rekey(wkey,wval,wflag,k,v,TN_REKEY_BASE+777777);}
                        let sp:i32=-1;
                        if(pr>=0){sp=fl2_contradict(k,v,v_old,aa,wkey,wval,wflag,wqkey,wqval,wqflag);}
                        if(p==0){sig0=sp;}
                        if(p==1){sig1=sp;}
                        if(p==2){sig2=sp;}
                    }
                    p=p+1;
                }
                if(sig_live==-1){
                    let surv:i32=-1;
                    if(sig0>=1){surv=0;}
                    if(sig1>=1 && surv<0){surv=1;}
                    if(sig2>=1 && surv<0){surv=2;}
                    if(surv>=0){
                        let r2:i32=tn_audit(audit,&acount,ep,TN_OP_SCAFFOLD,act,-1);
                        if(r2==TN_OK){r2=tn_audit(audit,&acount,ep,TN_OP_UNINSTALL_PROVISIONAL,0,act);}
                        if(r2==TN_OK){r2=tn_audit(audit,&acount,ep,TN_OP_COMMIT,1,surv);}
                        if(r2==TN_OK){
                            provisional=-1;
                            committed[0]=surv as u8;
                            if(revoke_step<0){revoke_step=ep;}
                        }
                        if(r2!=TN_OK){rc=r2;}
                    }
                }
            }
        }
        if(rc==TN_OK && kind==4){
            rc=tn_audit(audit,&acount,ep,TN_OP_EPISODE,etype,-1);
            if(rc==TN_OK){rc=tn_do_insert(mkey,mval,mflag,TN_NMAIN,ep,audit,&acount,k,v,TN_OP_INSERT,0);}
        }
        if(ep==14){
            let l1_ok:i32=1;let l2_ok:i32=1;
            if(has_rule==1 && cal_score==4 && l1_ok==1 && l2_ok==1){
                let r2:i32=tn_audit(audit,&acount,ep,TN_OP_PINSTALL,0,stated);
                if(r2==TN_OK){provisional=stated;}
                if(r2!=TN_OK){rc=r2;}
            } else {
                let r3:i32=tn_audit(audit,&acount,ep,TN_OP_WITHHOLD,0,cal_score);
                if(r3!=TN_OK){rc=r3;}
            }
        }
        if(ep==48 && revoke_step<0 && provisional>=0){
            let r4:i32=tn_audit(audit,&acount,ep,TN_OP_PROMOTE,0,provisional);
            if(r4==TN_OK){permanent=1;}
            if(r4!=TN_OK){rc=r4;}
        }
        if(rc!=TN_OK){badep=1;}
        ep=ep+1;
    }
    let exp_revoke_step:i32=-1;
    if(lying==1){exp_revoke_step=15;}
    let exp_promote_step:i32=48;
    if(lying==1){exp_promote_step=-1;}
    let exp_total_contest:i32=47;
    if(lying==1){exp_total_contest=46;}
    let exp_total_rekey:i32=0;
    if(lying==1){exp_total_rekey=1;}
    let exp_quar_used:i32=47;
    if(lying==1){exp_quar_used=46;}
    let exp_audit_total:i32=270;
    if(lying==1){exp_audit_total=272;}
    f=f+fl2_check(px,"episodes_ok",badep,0);
    f=f+fl2_check(px,"pinstall_n",tn_audit_count_op(audit,acount,TN_OP_PINSTALL),1);
    f=f+fl2_check(px,"pinstall_step",fl2_first_op_step(audit,acount,TN_OP_PINSTALL),14);
    f=f+fl2_check(px,"pinstall_policy",fl2_first_op_aux(audit,acount,TN_OP_PINSTALL),stated);
    f=f+fl2_check(px,"withhold_n",tn_audit_count_op(audit,acount,TN_OP_WITHHOLD),0);
    f=f+fl2_check(px,"cal_score",cal_score,4);
    f=f+fl2_check(px,"fire_step",fire_step,15);
    f=f+fl2_check(px,"ndisconnect",tn_audit_count_op(audit,acount,TN_OP_DISCONNECT),1);
    f=f+fl2_check(px,"connected_end",connected,0);
    f=f+fl2_check(px,"nuninstall",tn_audit_count_op(audit,acount,TN_OP_UNINSTALL_PROVISIONAL),lying);
    f=f+fl2_check(px,"revoke_step",revoke_step,exp_revoke_step);
    f=f+fl2_check(px,"ncommit",tn_audit_count_op(audit,acount,TN_OP_COMMIT),lying);
    f=f+fl2_check(px,"commit_step",fl2_first_op_step(audit,acount,TN_OP_COMMIT),exp_revoke_step);
    f=f+fl2_check(px,"npromote",tn_audit_count_op(audit,acount,TN_OP_PROMOTE),1-lying);
    f=f+fl2_check(px,"promote_step",fl2_first_op_step(audit,acount,TN_OP_PROMOTE),exp_promote_step);
    f=f+fl2_check(px,"neg_signal_n",fl2_count_op_aux(audit,acount,TN_OP_SCAFFOLD,-1),lying);
    f=f+fl2_check(px,"total_contest",tn_audit_count_op(audit,acount,TN_OP_CONTEST),exp_total_contest);
    f=f+fl2_check(px,"total_rekey",tn_audit_count_op(audit,acount,TN_OP_REKEY),exp_total_rekey);
    f=f+fl2_check(px,"total_overwrite",tn_audit_count_op(audit,acount,TN_OP_OVERWRITE),0);
    f=f+fl2_check(px,"total_refuse",tn_audit_count_op(audit,acount,TN_OP_REFUSE),11);
    f=f+fl2_check(px,"persist_contest",tn_count_range(audit,acount,TN_OP_CONTEST,39,128),28);
    f=f+fl2_check(px,"persist_refuse",tn_count_range(audit,acount,TN_OP_REFUSE,39,128),5);
    f=f+fl2_check(px,"quar_used",tn_count_used(qkey,TN_NQUAR),exp_quar_used);
    if(lying==1){
        f=f+fl2_check(px,"post15_rekey",tn_count_range(audit,acount,TN_OP_REKEY,16,128),0);
        f=f+fl2_check(px,"tempt_refuse_3338",tn_count_range(audit,acount,TN_OP_REFUSE,33,38),6);
        f=f+fl2_check(px,"uninstall_policy",fl2_first_op_aux(audit,acount,TN_OP_UNINSTALL_PROVISIONAL),2);
        f=f+fl2_check(px,"commit_policy",fl2_first_op_aux(audit,acount,TN_OP_COMMIT),1);
    } else {
        f=f+fl2_check(px,"post16_contest",tn_count_range(audit,acount,TN_OP_CONTEST,16,128),46);
    }
    f=f+fl2_check(px,"teach_lie_n",fl2_count_op_aux(audit,acount,TN_OP_TEACH,1),2*lying);
    let mm:i32=0;let fm:i32=0;let kk:i32=1;
    while(kk<=8){
        if(tn_main_val(mkey,mval,TN_NMAIN,kk)!=100+kk){mm=mm+1;}
        if(tn_main_flag(mflag,TN_NMAIN,kk,mkey)!=1){fm=fm+1;}
        kk=kk+1;
    }
    f=f+fl2_check(px,"main18_val_mm",mm,0);
    f=f+fl2_check(px,"main18_flag_mm",fm,0);
    f=f+fl2_check(px,"audit_total",acount,exp_audit_total);
    tn_free(mkey);tn_free(mval);tn_free(mflag);
    tn_free(qkey);tn_free(qval);tn_free(qflag);
    tn_free(skey);tn_free(sval);tn_free(sflag);
    tn_free(sqkey);tn_free(sqval);tn_free(sqflag);
    tn_free(pkey);tn_free(pval);tn_free(pflag);
    tn_free(pqkey);tn_free(pqval);tn_free(pqflag);
    tn_free(wkey);tn_free(wval);tn_free(wflag);
    tn_free(wqkey);tn_free(wqval);tn_free(wqflag);
    tn_free(audit);tn_free(committed);
    return f;
}
fn main()i32 {
    let f:i32=0;
    f=f+arm_a();
    f=f+arm_b();
    f=f+arm_fl2(ACT_CONTEST,0,"fl2h_");
    f=f+arm_fl2(ACT_REKEY,1,"fl2l_");
    _zag_print("TN_FAILURES,");
    let s:[]u8=_zag_i64_to_str(f as i64);_zag_print(s);tn_free(s);
    _zag_println("");
    return (f!=0) as i32;
}

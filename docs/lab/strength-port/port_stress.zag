// f6_trial.zag — F6 head-to-head driver: windowed (W) vs global (G) vs hybrid (H)
// citation consumption.
// argv[1]: W | G | H        (cite-consumption mode)
// argv[2]: ATTACK | HONEST | STRESS
// argv[3]: (STRESS only) S8 | S16 | S32  (salient-pool size)
// Prints machine-readable F6_* lines; every run is deterministic, zero RNG.
// The runner builds once and diffs two runs per (mode,test) for byte identity.
@import("strength_checker.zag")

fn f6_pi(x:i64)void {
    let s:[]u8=_zag_i64_to_str(x);
    _zag_print(s);
    nio_free(s);
}
fn f6_mode_of(m:[]u8)i32 {
    if(_zag_strcmp(m,"G")==1){return ST_CITE_GLOBAL;}
    if(_zag_strcmp(m,"H")==1){return ST_CITE_HYBRID;}
    return ST_CITE_WINDOWED;
}
fn f6_new_store(mode:i32)StStore {
    return f6_new_store_cap(mode,32768);
}
fn f6_new_store_cap(mode:i32,cap:i32)StStore {
    let s:StStore=st_init(16,cap);
    st_set_cite_mode(&s,mode);
    let c0:i32=0;let c1:i32=0;
    st_add_core(&s,95,-1,&c0);
    st_add_core(&s,90,-1,&c1);
    st_set_stage(&s,ST_STAGE_FULL);
    return s;
}
fn f6_live(s:*StStore,slot:i32)i32 {
    let lv:[]u8=s.*.live;
    if(lv[slot]==1){return 1;}
    return 0;
}
// cite one episode as contradicted evidence
fn f6_cite(s:*StStore,slot:i32,ep:i32)i32 {
    return st_evidence(s,slot,ST_J_CONTRADICTED,ep);
}
fn f6_cite4(s:*StStore,slot:i32,e0:i32)void {
    f6_cite(s,slot,e0);f6_cite(s,slot,e0+1);
    f6_cite(s,slot,e0+2);f6_cite(s,slot,e0+3);
}
fn f6_just(s:*StStore,slot:i32)i32 {
    return st_justify(s,slot,ST_J_CONTRADICTED);
}
// little-endian u32 arena accessors (ZNC-007: no as []i32 tables)
fn f6_put32(b:[]u8,at:i32,v:i32)void {
    b[at]=(v&255) as u8;b[at+1]=((v>>8)&255) as u8;
    b[at+2]=((v>>16)&255) as u8;b[at+3]=((v>>24)&255) as u8;
}
fn f6_get32(b:[]u8,at:i32)i32 {
    return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}

// ---------------- ATTACK battery ----------------
// Each attack runs on a fresh store. All memories strength 90 (need=4).
fn f6_stress(mode:i32,pool:i32)i32 {
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let wok:[]u8=nio_alloc(64);let w121:[]u8=nio_alloc(64);let woth:[]u8=nio_alloc(64);
    let z:i32=0;while(z<64){wok[z]=0;w121[z]=0;woth[z]=0;z=z+1;}
    let n:i32=0;
    while(n<160){
        let ns:i32=0;
        st_add(&s,800+n,ST_REGION_USER,90,n,&ns);
        let base:i32=(4*n)%pool;
        f6_cite(&s,ns,base);f6_cite(&s,ns,base+1);
        f6_cite(&s,ns,base+2);f6_cite(&s,ns,base+3);
        f6_just(&s,ns);
        let rc:i32=st_kill_evidenced(&s,ns);
        let win:i32=n/10;
        if(rc==0){f6_put32(wok,win*4,f6_get32(wok,win*4)+1);}
        else if(rc==ST_REFUSED_CONSUMED){f6_put32(w121,win*4,f6_get32(w121,win*4)+1);}
        else {f6_put32(woth,win*4,f6_get32(woth,win*4)+1);}
        n=n+1;
    }
    let w:i32=0;
    while(w<16){
        _zag_print("F6_S win=");f6_pi(w as i64);
        _zag_print(" ok=");f6_pi(f6_get32(wok,w*4) as i64);
        _zag_print(" c121=");f6_pi(f6_get32(w121,w*4) as i64);
        _zag_print(" cother=");f6_pi(f6_get32(woth,w*4) as i64);_zag_print("\n");
        w=w+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("F6_S ckfail=");f6_pi(fail as i64);
    _zag_print(" fp=");f6_pi(st_fingerprint(&s,9) as i64);_zag_print("\n");
    nio_free(wok);nio_free(w121);nio_free(woth);
    return fail;
}
// PORT-ADD (2026-09-26): delete-path stress — same rotation but via
// st_delete_strong. Under G, P/4 successful deletes then 121s.
fn ps_stress_delete(mode:i32,pool:i32)i32 {
    let s:StStore=f6_new_store(mode);
    let fail:i32=0;
    let wok:[]u8=nio_alloc(64);let w121:[]u8=nio_alloc(64);let woth:[]u8=nio_alloc(64);
    let z:i32=0;while(z<64){wok[z]=0;w121[z]=0;woth[z]=0;z=z+1;}
    let n:i32=0;
    while(n<160){
        let ns:i32=0;
        st_add(&s,800+n,ST_REGION_USER,90,n,&ns);
        let base:i32=(4*n)%pool;
        f6_cite(&s,ns,base);f6_cite(&s,ns,base+1);
        f6_cite(&s,ns,base+2);f6_cite(&s,ns,base+3);
        f6_just(&s,ns);
        let rc:i32=st_delete_strong(&s,ns);
        let win:i32=n/10;
        if(rc==0){f6_put32(wok,win*4,f6_get32(wok,win*4)+1);}
        else if(rc==ST_REFUSED_CONSUMED){f6_put32(w121,win*4,f6_get32(w121,win*4)+1);}
        else {f6_put32(woth,win*4,f6_get32(woth,win*4)+1);}
        n=n+1;
    }
    let w:i32=0;
    while(w<16){
        _zag_print("PS_SDEL win=");f6_pi(w as i64);
        _zag_print(" ok=");f6_pi(f6_get32(wok,w*4) as i64);
        _zag_print(" c121=");f6_pi(f6_get32(w121,w*4) as i64);
        _zag_print(" cother=");f6_pi(f6_get32(woth,w*4) as i64);_zag_print("\n");
        w=w+1;
    }
    fail=fail+ck_verify(&s,0,0,0,500,1);
    fail=fail+st_refusals_clean(&s);
    fail=fail+st_replay_check(&s);
    _zag_print("PS_SDEL ckfail=");f6_pi(fail as i64);
    _zag_print(" fp=");f6_pi(st_fingerprint(&s,9) as i64);_zag_print("\n");
    nio_free(wok);nio_free(w121);nio_free(woth);
    return fail;
}
fn main()void {
    let m:[]u8=_zag_arg(1);
    let mode:i32=f6_mode_of(m);
    let p:[]u8=_zag_arg(2);
    let pool:i32=8;
    if(_zag_strcmp(p,"S16")==1){pool=16;}
    if(_zag_strcmp(p,"S32")==1){pool=32;}
    let t:[]u8=_zag_arg(3);
    _zag_print("PS_CELL mode=");
    if(mode==ST_CITE_GLOBAL){_zag_print("G");}
    else if(mode==ST_CITE_HYBRID){_zag_print("H");}
    else {_zag_print("W");}
    _zag_print(" pool=");f6_pi(pool as i64);
    _zag_print(" test=");_zag_print(t);_zag_print("\n");
    let fail:i32=0;
    if(_zag_strcmp(t,"DEL")==1){fail=ps_stress_delete(mode,pool);}
    else {fail=f6_stress(mode,pool);}
    _zag_print("PS_DONE fail=");f6_pi(fail as i64);_zag_print("\n");
}

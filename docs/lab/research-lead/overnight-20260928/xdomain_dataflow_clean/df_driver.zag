// df_driver.zag -- H3 generic dataflow experiment driver.
//
// Arms: TREAT, ABL-X, ABL-Y, FRESH, Z-REUSE.
// (NO-DF is a separate binary with df_on()=0.)

fn df_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn df_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// Set field12 (fact_rel) on all MAPs with given in_rel.
// Simulates the learner recording which fact relation each procedure consumes.
fn df_set_factrel(W:[]u8,in_rel:i32,fact_rel:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==in_rel){
      ns(W,m,12,fact_rel);
    }
    m=m+1;
  }
  return;
}
// Delete MAPs by relation field (ABL-X: 91, ABL-Y: 92).
fn df_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn df_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn df_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn df_trainX(W:[]u8)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=ev_query(W,11,91,14,0);
  emit("X1 ans="); e64(x1); df_tstat(W);
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=ev_query(W,15,91,18,0);
  emit("X2 ans="); e64(x2); df_tstat(W);
  df_set_factrel(W,91,81);
  return;
}
fn df_trainY(W:[]u8)void {
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let y1:i32=ev_query(W,50,92,3,0);
  emit("Y1 ans="); e64(y1); df_tstat(W);
  ev_teach(W,60,82,61); ev_teach(W,61,82,62); ev_teach(W,62,82,63); ev_teach(W,63,82,64);
  let y2:i32=ev_query(W,60,92,4,0);
  emit("Y2 ans="); e64(y2); df_tstat(W);
  df_set_factrel(W,92,82);
  return;
}
fn df_zfacts(W:[]u8)void {
  ev_teach(W,31,81,32); ev_teach(W,32,81,33); ev_teach(W,33,81,34);
  ev_teach(W,34,82,35); ev_teach(W,35,82,36);
  return;
}
fn df_zquery(W:[]u8)void {
  let z:i32=ev_query(W,31,93,2,0);
  emit("Z ans="); e64(z); df_tstat(W);
  let zm:i32=df_find_map(W,31,93);
  emit("ZMAP id="); e64(zm); emit("\n");
  return;
}
// Z' reuse: new chain + new count, same dataflow wiring should apply.
fn df_zprime(W:[]u8)void {
  emit("=== Z-REUSE ===\n");
  ev_teach(W,41,81,42); ev_teach(W,42,81,43);
  ev_teach(W,43,82,44); ev_teach(W,44,82,45); ev_teach(W,45,82,46);
  let z2:i32=ev_query(W,41,93,3,0);
  emit("Z2 ans="); e64(z2); df_tstat(W);
  return;
}
fn df_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  df_trainX(W);
  df_trainY(W);
  df_gap(W);
  emit("maps="); e64(df_count_maps(W)); emit("\n");
  df_zfacts(W);
  df_zquery(W);
  df_zprime(W);
  return;
}
fn df_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  df_trainX(W);
  df_trainY(W);
  df_del_map_r(W,91);
  emit("maps after del="); e64(df_count_maps(W)); emit("\n");
  df_gap(W);
  df_zfacts(W);
  df_zquery(W);
  return;
}
fn df_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  df_trainX(W);
  df_trainY(W);
  df_del_map_r(W,92);
  emit("maps after del="); e64(df_count_maps(W)); emit("\n");
  df_gap(W);
  df_zfacts(W);
  df_zquery(W);
  return;
}
fn df_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  df_gap(W);
  df_zfacts(W);
  df_zquery(W);
  return;
}
fn main()i32 {
  emit("DF-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); df_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); df_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); df_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); df_fresh(W4);
  emit("DF-END\n");
  return 0;
}

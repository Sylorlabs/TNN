// df_patch.zag -- Hypothesis H3: Generic Dataflow Graph for cross-domain composition.
//
// The goal is represented as dataflow nodes (learned procedures) connected
// by data dependencies. X and Y are subgraphs. Composition wires X's output
// port to Y's input port. The wiring is DISCOVERED from goal fact
// connectivity, not from a template.
//
// Registry: built on-demand from MAPs. Each MAP with field12>0 is a
// procedure: (map_id, in_rel=field4, fact_rel=field12).
// Field12 is set by the driver after training (simulating the learner's
// record of what fact relation each procedure consumes).
//
// Dataflow record: a MAP node storing a promoted wiring.
// field12=P_in_rel, field16=Q_in_rel (nonzero field16 marks it as a
// wiring record, not a procedure).

// df_on: 1 = dataflow enabled. The NO-DF arm builds with 0.
fn df_on()i32 { return 0; }

// df_has_fact: 1 if a live FACT node (s,r,*) exists.
fn df_has_fact(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){
      return 1;
    }
    n=n+1;
  }
  return 0;
}

// df_build_reg: scan MAPs, build procedure registry.
// reg: buffer, 12 bytes per entry: [map_id, in_rel, fact_rel].
// Returns count. Skips DF records (field16>=0 marks a wiring record;
// procedures have field16==-1 from promote_graph) and MAPs without fact_rel.
fn df_build_reg(W:[]u8,reg:[]u8)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024 && n<8){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let ir:i32=ng(W,m,4);
      let fr:i32=ng(W,m,12);
      // Skip dataflow records (they store wiring in field16>=0).
      if(ng(W,m,16)<0 && fr>0){
        set32(reg,n*12, m);
        set32(reg,n*12+4, ir);
        set32(reg,n*12+8, fr);
        n=n+1;
      }
    }
    m=m+1;
  }
  return n;
}

// df_find_dfrec: find promoted dataflow record for relation r.
// Returns MAP id or -1. DF records have field16>=0 (wiring).
fn df_find_dfrec(W:[]u8,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){
      if(ng(W,m,12)>0 && ng(W,m,16)>=0){return m;}
    }
    m=m+1;
  }
  return -1;
}

// df_promote: promote a dataflow wiring as a reusable record.
// Stores P_in_rel in field12, Q_in_rel in field16.
fn df_promote(W:[]u8,s:i32,r:i32,ans:i32,p_in_rel:i32,q_in_rel:i32)i32 {
  let m:i32=alloc_node(W);
  if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,36,1);
  ns(W,m,4,r); ns(W,m,8,s); ns(W,m,28,ans);
  ns(W,m,12,p_in_rel); ns(W,m,16,q_in_rel);
  ns(W,m,20,-1);
  return m;
}

// df_find_pmap: find registry entry index by in_rel, return map_id or -1.
fn df_find_pmap(W:[]u8,reg:[]u8,nreg:i32,in_rel:i32)i32 {
  let i:i32=0;
  while(i<nreg){
    if(get32(reg,i*12+4)==in_rel){return get32(reg,i*12+0);}
    i=i+1;
  }
  return -1;
}

// df_has_inc: 1 if the MAP's graph contains an INC cell (tag 103).
fn df_has_inc(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==103){return 1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  return 0;
}

// df_walk_end: follow fact_rel chain from s to endpoint. Return endpoint or -2.
fn df_walk_end(W:[]u8,s:i32,fact_rel:i32)i32 {
  let cur:i32=s; let steps:i32=0;
  while(steps<16){
    let nxt:i32=-1;
    let n:i32=2;
    while(n<1024){
      if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==cur && ng(W,n,24)==fact_rel){
        nxt=ng(W,n,28);
      }
      n=n+1;
    }
    if(nxt<0){return cur;}
    cur=nxt; steps=steps+1;
  }
  return cur;
}

// df_count_links: count fact_rel links transitively from s. Return count.
fn df_count_links(W:[]u8,s:i32,fact_rel:i32)i32 {
  let cnt:i32=0; let cur:i32=s; let steps:i32=0;
  while(steps<16){
    let nxt:i32=-1;
    let n:i32=2;
    while(n<1024){
      if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==cur && ng(W,n,24)==fact_rel){
        nxt=ng(W,n,28);
      }
      n=n+1;
    }
    if(nxt<0){return cnt;}
    cnt=cnt+1; cur=nxt; steps=steps+1;
  }
  return cnt;
}

// df_find_factrel: find registry entry by in_rel, return fact_rel or -1.
fn df_find_factrel(W:[]u8,reg:[]u8,nreg:i32,in_rel:i32)i32 {
  let i:i32=0;
  while(i<nreg){
    if(get32(reg,i*12+4)==in_rel){return get32(reg,i*12+8);}
    i=i+1;
  }
  return -1;
}

// df_exec_sub: execute a procedure on subject s.
// The execution method is derived from the MAP's own structure:
// count-like (INC cells) -> count links; otherwise -> walk to endpoint.
// map_id: the procedure's MAP. fact_rel: the fact relation it consumes.
// Returns answer or -2.
fn df_exec_sub(W:[]u8,map_id:i32,s:i32,fact_rel:i32)i32 {
  let root:i32=ng(W,map_id,20);
  if(root<0){return -2;}
  if(df_has_inc(W,root)==1){
    return df_count_links(W,s,fact_rel);
  } else {
    return df_walk_end(W,s,fact_rel);
  }
}

// df_try: attempt generic dataflow composition for goal (s,r).
// Returns answer or -2.
fn df_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32)i32 {
  if(df_on()==0){return -2;}
  // Do not recurse: if we are inside a df sub-call, skip.
  if(hg(W,56)>0){return -2;}
  // Do not intercept relations that have direct procedures.
  // (If r is a registered in_rel, let normal rebind handle it.)
  let reg:[]u8=z_alloc(96);
  let nreg:i32=df_build_reg(W,reg);
  let k:i32=0;
  while(k<nreg){
    if(get32(reg,k*12+4)==r){return -2;}
    k=k+1;
  }
  if(nreg<2){return -2;}

  // Reuse path: is there a promoted dataflow record for r?
  let dfr:i32=df_find_dfrec(W,r);
  if(dfr>=0){
    let p_rel:i32=ng(W,dfr,12);
    let q_rel:i32=ng(W,dfr,16);
    emit("DF-REUSE p_rel="); e64(p_rel); emit(" q_rel="); e64(q_rel); emit("\n");
    // Find the MAPs for these relations.
    let p_map:i32=df_find_pmap(W,reg,nreg,p_rel);
    let q_map:i32=df_find_pmap(W,reg,nreg,q_rel);
    if(p_map<0 || q_map<0){return -2;}
    let p_fr:i32=df_find_factrel(W,reg,nreg,p_rel);
    let q_fr:i32=df_find_factrel(W,reg,nreg,q_rel);
    let mid:i32=df_exec_sub(W,p_map,s,p_fr);
    if(mid<0){return -2;}
    let ans:i32=df_exec_sub(W,q_map,mid,q_fr);
    if(ans<0){return -2;}
    if(masked==0 && expected>=0 && ans!=expected){return -2;}
    return ans;
  }

  // Discovery path: find P with facts from s, run it, find Q with facts from mid.
  emit("DF-DISCOVER s="); e64(s); emit(" r="); e64(r); emit("\n");
  let pi:i32=-1; let qi:i32=-1; let mid:i32=-1;
  let i:i32=0;
  while(i<nreg && pi<0){
    let p_fr:i32=get32(reg,i*12+8);
    let p_rel:i32=get32(reg,i*12+4);
    let p_map:i32=get32(reg,i*12+0);
    if(df_has_fact(W,s,p_fr)==1){
      emit("DF-STAGE1 proc="); e64(i); emit(" rel="); e64(p_rel);
      emit(" factrel="); e64(p_fr); emit("\n");
      let out:i32=df_exec_sub(W,p_map,s,p_fr);
      emit("DF-STAGE1 out="); e64(out); emit("\n");
      if(out>=0){
        let j:i32=0;
        while(j<nreg && pi<0){
          if(j!=i){
            let q_fr:i32=get32(reg,j*12+8);
            if(df_has_fact(W,out,q_fr)==1){
              pi=i; qi=j; mid=out;
              emit("DF-STAGE2 proc="); e64(j);
              emit(" factrel="); e64(q_fr); emit("\n");
            }
          }
          j=j+1;
        }
      }
    }
    i=i+1;
  }
  if(pi<0){emit("DF-NOWIRE\n"); return -2;}

  // Execute stage 2.
  let q_map2:i32=get32(reg,qi*12+0);
  let q_rel:i32=get32(reg,qi*12+4);
  let q_fr2:i32=get32(reg,qi*12+8);
  let p_rel2:i32=get32(reg,pi*12+4);
  let ans:i32=df_exec_sub(W,q_map2,mid,q_fr2);
  emit("DF-EXEC ans="); e64(ans); emit("\n");
  if(ans<0){return -2;}
  if(masked==0 && expected>=0 && ans!=expected){
    emit("DF-VERIFY-FAIL\n"); return -2;
  }
  // Promote the wiring for reuse.
  let dm:i32=df_promote(W,s,r,ans,p_rel2,q_rel);
  emit("DF-PROMOTE id="); e64(dm); emit("\n");
  return ans;
}

// ev_query with H3 dataflow hook between rebind_try and trial.
// (No Hypothesis C hook in this build; dataflow is the mechanism under test.)
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- Hypothesis H3: generic dataflow ----
  // Skip if we are inside a df sub-call (recursion guard).
  if(hg(W,56)==0){
    let da:i32=df_try(W,s,r,expected,masked);
    if(da!=-2){
      emit("DF-STAT ok=1\n");
      log_ev(W,2,s,r,da,1,0,0); return da;
    }
    emit("DF-STAT ok=0\n");
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

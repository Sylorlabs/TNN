// fi_fix.zag -- Hardened FACT subject index.
// Applies I1-I5 general invariants to the FACT index, mirroring the
// MAP index hardening (index_harden/ih_patch.zag).
//
// Invariants:
//   FI1 Bounds: every node id dereferenced is in [2, NN()).
//   FI2 Cycle: bucket-list walks are bounded; extension-chain walks
//             are bounded by max hops (4).
//   FI3 Liveness: FACT list nodes must have field36==1 to be returned;
//                 dead nodes are skipped (not fatal).
//   FI4 Type: FACT list nodes must have tag==1; extension nodes tag==40.
//   FI5 Buffer: no unbounded walk; bucket walk capped at sane bound.
//
// These replace fidx_bhead, fidx_bset, fidx_add, t2_lu_first_idx.
// The originals are shadowed by defining these AFTER the patch include.

// ---- hardened extension-chain walk ----
// Returns the extension node for bucket b, or -1 on any violation.
// Validates: ix bounds, each hop bounds, tag==40, max 3 hops.
fn fidx_ext_node(W:[]u8, b:i32)i32 {
  let ix:i32=idx_node(W);
  if(ix<2 || ix>=65536){ return -1; }          // FI1: index node bounds
  if(ng(W,ix,36)!=1){ return -1; }             // FI3: index node live
  // tag check: index node should be tag 40 (not strictly required,
  // but guards against wild pointer)
  let n:i32=ng(W,ix,8);
  let k:i32=b/6;
  // FI2: at most 3 hops (buckets 0..23 -> k in 0..3)
  if(k<0 || k>3){ return -1; }
  while(k>0){
    if(n<2 || n>=65536){ return -1; }          // FI1: hop bounds
    if(ng(W,n,36)!=1){ return -1; }            // FI3: ext node live
    if(ng(W,n,0)!=40){ return -1; }            // FI4: ext node tag
    n=ng(W,n,12);
    k=k-1;
  }
  if(n<2 || n>=65536){ return -1; }            // FI1: final bounds
  if(ng(W,n,36)!=1){ return -1; }             // FI3: final live
  if(ng(W,n,0)!=40){ return -1; }             // FI4: final tag
  return n;
}

fn fidx_bhead_h(W:[]u8, b:i32)i32 {
  if(b<0 || b>=24){ return -1; }               // FI1: bucket range
  let n:i32=fidx_ext_node(W,b);
  if(n<0){ return -1; }
  let slot:i32=fidx_slot_field(b-((b/6)*6));
  let h:i32=ng(W,n,slot);
  // head may be -1 (empty); if >=0 validate bounds (defer live/tag
  // to the walk, which skips dead/wrong-type)
  if(h!=-1 && (h<2 || h>=65536)){ return -1; } // FI1: head bounds
  return h;
}

fn fidx_bset_h(W:[]u8, b:i32, v:i32)void {
  if(b<0 || b>=24){ return; }
  if(v!=-1 && (v<2 || v>=65536)){ return; }    // FI1: value bounds
  let n:i32=fidx_ext_node(W,b);
  if(n<0){ return; }
  let slot:i32=fidx_slot_field(b-((b/6)*6));
  ns(W,n,slot,v);
  return;
}

fn fidx_add_h(W:[]u8, s:i32, fn2:i32)void {
  if(fn2<2 || fn2>=65536){ return; }           // FI1: new node bounds
  let b:i32=fhash(s);
  let old:i32=fidx_bhead_h(W,b);               // validated head (or -1)
  // FI2/FI1: old head is either -1 or a bounded id (checked in bhead_h)
  ns(W,fn2,12,old);
  fidx_bset_h(W,b,fn2);
  return;
}

// Hardened t2_lu_first_idx with FI1 (bounds), FI2 (cycle/length cap),
// FI3 (liveness), FI4 (type). Returns first live FACT with (s,r), or -1.
fn t2_lu_first_idx_h(W:[]u8, s:i32, r:i32)i32 {
  let n:i32=fidx_bhead_h(W,fhash(s));
  let steps:i32=0;
  // FI5/FI2: cap walk length. Bucket lists should be short; a very long
  // walk indicates corruption. 100000 is generous but finite.
  while(n>=0 && steps<100000){
    // FI1: bounds before any field read
    if(n<2 || n>=65536){ return -1; }
    fcnt_inc(W);
    // FI3 + FI4: live FACT with matching subject/relation
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){
      return n;
    }
    n=ng(W,n,12);
    steps=steps+1;
  }
  return -1;
}

// ---- dispatch overrides ----
// Shadow the patch versions by redefining the dispatch to use hardened
// variants when FACT index mode is on.
fn t2_lu_first_h(W:[]u8, s:i32, r:i32)i32 {
  if((idx_mode(W)&4)==4){ return t2_lu_first_idx_h(W,s,r); }
  return t2_lu_first_lin(W,s,r);
}

// Hardened t2_gather_idx: same FI1/FI2/FI3/FI4 guards on the bucket walk.
fn t2_gather_idx_h(W:[]u8, s:i32, paths:[]u8)i32 {
  let np:i32=0; let cap:i32=96;
  set32(paths,0,1); set32(paths,4,s); np=1;
  let head:i32=0;
  while(head<np && np<cap){
    let base:i32=head*48;
    let len:i32=get32(paths,base);
    if(len<5){
      let lastv:i32=get32(paths,base+len*4);
      let n:i32=fidx_bhead_h(W,fhash(lastv));
      let steps:i32=0;
      while(n>=0 && np<cap && steps<100000){
        if(n<2 || n>=65536){ break; }          // FI1
        fcnt_inc(W);
        if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==lastv && ng(W,n,24)!=-999){
          let o:i32=ng(W,n,28);
          let k:i32=0; let cyc:i32=0;
          while(k<len){if(get32(paths,base+4+k*4)==o){cyc=1;} k=k+1;}
          if(cyc==0){
            let nb:i32=np*48; let c2:i32=0;
            while(c2<12){set32(paths,nb+c2*4,get32(paths,base+c2*4)); c2=c2+1;}
            set32(paths,nb,len+1);
            set32(paths,nb+4+len*4,o);
            set32(paths,nb+24+(len-1)*4,n);
            np=np+1;
          }
        }
        n=ng(W,n,12);
        steps=steps+1;
      }
    }
    head=head+1;
  }
  return np;
}

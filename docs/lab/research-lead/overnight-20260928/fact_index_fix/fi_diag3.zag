// fi_diag3.zag -- Exact s5 replication: ALL decoys first, then reals.
// Then inspect FACT index bucket heads for the real subjects.

fn fi_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}

fn fi_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  // return len in high bits and pm in low for diagnosis
  return len*100000+pm;
}

fn fi_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}

// Dump bucket b: walk list, count, check if target subject reachable.
fn fi_probe_bucket(W:[]u8, b:i32, target_s:i32)i32 {
  let head:i32=fidx_bhead(W,b);
  emit("  bucket head node="); e64(head); emit("\n");
  let n:i32=head;
  let c:i32=0;
  let found:i32=0;
  while(n>=0 && c<100000){
    if(ng(W,n,20)==target_s){ found=1; }
    c=c+1;
    let nx:i32=ng(W,n,12);
    // sanity: nx should be >= -1
    if(nx<-1 || nx>=65536){
      emit("  CORRUPT at pos "); e64(c);
      emit(": node "); e64(n);
      emit(" has field12="); e64(nx); emit(" (OOB)\n");
      return -1;
    }
    n=nx;
  }
  if(c>=100000){
    emit("  CYCLE or HUGE list (walked 100000)\n");
    return -2;
  }
  emit("  list length="); e64(c);
  emit(" target_found="); e64(found); emit("\n");
  return c;
}

fn main()i32 {
  emit("FI-DIAG3-START\n");
  let W:[]u8=fi_big(); tnn2_init(W);
  idx_mode_set(W,5);

  // Query facts like s5
  let qi:i32=0;
  while(qi<2){
    let q:i32=80000+qi*200;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  emit("query facts taught\n");

  // ALL 4990 decoys FIRST (exact s5 order)
  let i:i32=0;
  while(i<4990){
    fi_mkbroken(W,2000+i,51,2001+i);
    i=i+1;
  }
  emit("4990 decoys built\n");

  // Then 5 real
  i=0;
  while(i<5){
    let r:i32=fi_mkchain(W,50000+i*10,5,51,50004+i*10);
    let len:i32=r/100000;
    emit("real "); e64(i); emit(": chain_len="); e64(len);
    emit(" pmap="); e64(r-len*100000); emit("\n");
    i=i+1;
  }

  // Probe the FACT buckets for real subjects
  emit("probing bucket for subject 50000:\n");
  fi_probe_bucket(W, fhash(50000), 50000);
  emit("probing bucket for subject 50001:\n");
  fi_probe_bucket(W, fhash(50001), 50001);

  // Direct lookup comparison
  let f1:i32=t2_lu_first(W,50000,1);
  let f1l:i32=t2_lu_first_lin(W,50000,1);
  emit("t2_lu_first(50000,1) idx="); e64(f1);
  emit(" lin="); e64(f1l); emit("\n");
  if(f1>=0){
    emit("  idx result: s="); e64(ng(W,f1,20));
    emit(" o="); e64(ng(W,f1,28)); emit("\n");
  }
  if(f1l>=0){
    emit("  lin result: s="); e64(ng(W,f1l,20));
    emit(" o="); e64(ng(W,f1l,28)); emit("\n");
  }

  // Check index node and extension chain integrity
  let ix:i32=idx_node(W);
  emit("idx_node="); e64(ix); emit("\n");
  let e0:i32=ng(W,ix,8);
  emit("ext0="); e64(e0); emit(" tag="); e64(ng(W,e0,0)); emit(" live="); e64(ng(W,e0,36)); emit("\n");
  let e1:i32=ng(W,e0,12);
  emit("ext1="); e64(e1); emit(" tag="); e64(ng(W,e1,0)); emit(" live="); e64(ng(W,e1,36)); emit("\n");
  let e2:i32=ng(W,e1,12);
  emit("ext2="); e64(e2); emit(" tag="); e64(ng(W,e2,0)); emit(" live="); e64(ng(W,e2,36)); emit("\n");
  let e3:i32=ng(W,e2,12);
  emit("ext3="); e64(e3); emit(" tag="); e64(ng(W,e3,0)); emit(" live="); e64(ng(W,e3,36)); emit("\n");

  emit("FI-DIAG3-DONE\n");
  return 0;
}

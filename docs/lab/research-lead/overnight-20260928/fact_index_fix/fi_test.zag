// fi_test.zag -- Validation driver for hardened FACT index.
// Tests:
//   T1: correctness - hardened matches original on valid state.
//   T2: cycle in bucket - hardened terminates, returns gracefully.
//   T3: OOB head pointer - hardened returns -1, no crash.
//   T4: dead node in list - hardened skips it.
//   T5: scale - 5000 FACTs, hardened matches linear.
//   T6: determinism - 3 runs byte-identical (via external rerun).

fn fi_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}

// T1: teach N facts, verify hardened lookup matches original and linear.
fn t1_correctness(W:[]u8, n:i32)i32 {
  let i:i32=0;
  while(i<n){
    // use fidx_add_h (hardened) for teaching
    let nd:i32=alloc_node(W);
    if(nd<0){ return -1; }
    ns(W,nd,0,1); ns(W,nd,36,1);
    write_node(W,nd,10000+i,1,20000+i,0);
    fidx_add_h(W,10000+i,nd);
    i=i+1;
  }
  // verify each lookup via hardened matches linear
  i=0;
  while(i<n){
    let h:i32=t2_lu_first_idx_h(W,10000+i,1);
    let l:i32=t2_lu_first_lin(W,10000+i,1);
    if(h!=l){ return -2; }  // mismatch
    if(h<0){ return -3; }   // not found
    // verify it's the right fact
    if(ng(W,h,20)!=10000+i){ return -4; }
    i=i+1;
  }
  return 1;
}

// T2: inject cycle in bucket, verify hardened terminates.
fn t2_cycle(W:[]u8)i32 {
  // teach 3 facts to bucket 0 (subjects 0, 24, 48 all hash to 0)
  let a:i32=alloc_node(W); ns(W,a,0,1); ns(W,a,36,1); write_node(W,a,0,1,100,0); fidx_add_h(W,0,a);
  let b:i32=alloc_node(W); ns(W,b,0,1); ns(W,b,36,1); write_node(W,b,24,1,101,0); fidx_add_h(W,24,b);
  let c:i32=alloc_node(W); ns(W,c,0,1); ns(W,c,36,1); write_node(W,c,48,1,102,0); fidx_add_h(W,48,c);
  // bucket 0 list: c -> b -> a -> -1. Create cycle: a.12 = c.
  ns(W,a,12,c);
  // hardened walk should terminate (step cap) and may or may not find;
  // key is it RETURNS without hanging.
  let r:i32=t2_lu_first_idx_h(W,0,1);
  // r should be c (head) since it matches (0,1)... wait, head is c with s=48.
  // Walk: c(s=48, no match), b(s=24, no), a(s=0, MATCH) -> return a.
  // With cycle a->c, after a we'd go to c again, but we return at a first.
  if(r!=a){ return -1; }
  // also test a lookup that requires full walk (not found)
  let r2:i32=t2_lu_first_idx_h(W,999,1);  // subject 999 not present, hash=15, different bucket
  // test cycle with no match in bucket 0: lookup s=1 (hash 1, different bucket) - skip
  // direct cycle test: walk bucket 0 for non-existent relation
  let r3:i32=t2_lu_first_idx_h(W,0,999);  // s=0 in bucket 0, r=999 not present -> full walk with cycle
  // should terminate via step cap and return -1
  if(r3!=-1){ return -2; }
  return 1;
}

// T3: OOB head pointer.
fn t2_oob(W:[]u8)i32 {
  // teach one fact to bucket 5
  let a:i32=alloc_node(W); ns(W,a,0,1); ns(W,a,36,1); write_node(W,a,5,1,100,0); fidx_add_h(W,5,a);
  // corrupt the bucket head to OOB value
  fidx_bset_h(W,5,99999);  // bset_h validates bounds, should REJECT (no-op)
  // head should still be a (bset_h rejected the OOB)
  let h:i32=fidx_bhead_h(W,5);
  if(h!=a){ return -1; }
  // now force OOB via direct ns (simulating corruption)
  let ext:i32=fidx_ext_node(W,5);
  ns(W,ext,fidx_slot_field(5),99999);
  // hardened bhead should return -1 (bounds check)
  let h2:i32=fidx_bhead_h(W,5);
  if(h2!=-1){ return -2; }
  // hardened lookup should return -1 gracefully
  let r:i32=t2_lu_first_idx_h(W,5,1);
  if(r!=-1){ return -3; }
  return 1;
}

// T4: dead node in list is skipped.
fn t4_dead(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); ns(W,a,36,1); write_node(W,a,100,2,100,0); fidx_add_h(W,100,a);
  let b:i32=alloc_node(W); ns(W,b,0,1); ns(W,b,36,1); write_node(W,b,124,2,101,0); fidx_add_h(W,124,b);
  // bucket for 100: 100%24=4. List: b -> a -> -1.
  // kill b (dead but still in list)
  ns(W,b,36,0);
  // lookup (124,2) should skip dead b and return -1 (b was the only 124)
  let r1:i32=t2_lu_first_idx_h(W,124,2);
  if(r1!=-1){ return -1; }
  // lookup (100,2) should skip b and find a
  let r2:i32=t2_lu_first_idx_h(W,100,2);
  if(r2!=a){ return -2; }
  return 1;
}

// T5: scale - 5000 FACTs via hardened add, verify all findable.
fn t5_scale(W:[]u8)i32 {
  let i:i32=0;
  while(i<5000){
    let nd:i32=alloc_node(W);
    if(nd<0){ return -1; }
    ns(W,nd,0,1); ns(W,nd,36,1);
    write_node(W,nd,50000+i,7,60000+i,0);
    fidx_add_h(W,50000+i,nd);
    i=i+1;
  }
  // verify all 5000 via hardened
  i=0;
  while(i<5000){
    let h:i32=t2_lu_first_idx_h(W,50000+i,7);
    if(h<0){ return -2; }
    if(ng(W,h,20)!=50000+i){ return -3; }
    if(ng(W,h,28)!=60000+i){ return -4; }
    i=i+1;
  }
  // spot-check against linear for 100 random-ish (deterministic stride)
  i=0;
  while(i<5000){
    let h:i32=t2_lu_first_idx_h(W,50000+i,7);
    let l:i32=t2_lu_first_lin(W,50000+i,7);
    if(h!=l){ return -5; }
    i=i+61;  // stride
  }
  return 1;
}

fn main()i32 {
  emit("FI-TEST-START\n");

  // T1: correctness on small scale (fresh workspace)
  let W1:[]u8=fi_big(); tnn2_init(W1); idx_mode_set(W1,5);
  let r1:i32=t1_correctness(W1, 200);
  emit("T1 correctness(200)="); e64(r1); emit("\n");

  // T2: cycle (fresh workspace)
  let W2:[]u8=fi_big(); tnn2_init(W2); idx_mode_set(W2,5);
  let r2:i32=t2_cycle(W2);
  emit("T2 cycle="); e64(r2); emit("\n");

  // T3: OOB (fresh workspace)
  let W3:[]u8=fi_big(); tnn2_init(W3); idx_mode_set(W3,5);
  let r3:i32=t2_oob(W3);
  emit("T3 oob="); e64(r3); emit("\n");

  // T4: dead node (fresh workspace)
  let W4:[]u8=fi_big(); tnn2_init(W4); idx_mode_set(W4,5);
  let r4:i32=t4_dead(W4);
  emit("T4 dead="); e64(r4); emit("\n");

  // T5: scale 5000 (fresh workspace)
  let W5:[]u8=fi_big(); tnn2_init(W5); idx_mode_set(W5,5);
  let r5:i32=t5_scale(W5);
  emit("T5 scale(5000)="); e64(r5); emit("\n");

  let allpass:i32=1;
  if(r1!=1){ allpass=0; }
  if(r2!=1){ allpass=0; }
  if(r3!=1){ allpass=0; }
  if(r4!=1){ allpass=0; }
  if(r5!=1){ allpass=0; }
  emit("FI-TEST-ALLPASS="); e64(allpass); emit("\n");
  emit("FI-TEST-DONE\n");
  return 0;
}

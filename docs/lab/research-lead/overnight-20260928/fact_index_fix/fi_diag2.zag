// fi_diag2.zag -- FACT index diagnostic with FULL s5_mkbroken decoys.
// Replicates the exact s5 build path including promote_graph.

fn fi_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}

fn fi_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  // verify values before assembly
  if(len!=plen){ return -1; }
  let j:i32=0;
  while(j<plen){
    if(get32(v,j*4)!=s0+j){ return -2; }
    j=j+1;
  }
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}

fn fi_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}

fn main()i32 {
  emit("FI-DIAG2-START\n");
  let W:[]u8=fi_big(); tnn2_init(W);
  idx_mode_set(W,5);

  // Phase 1: build decoys in batches of 500 using FULL mkbroken.
  let batch:i32=0;
  let total_decoys:i32=0;
  while(batch<12){
    let i:i32=0;
    while(i<500){
      fi_mkbroken(W, 2000+total_decoys+i, 51, 2001+total_decoys+i);
      i=i+1;
    }
    total_decoys=total_decoys+500;

    // test: build a real chain with fresh subject
    let tsub:i32=90000+batch*100;
    let pm:i32=fi_mkchain(W, tsub, 5, 51, tsub+4);

    emit("batch="); e64(batch);
    emit(" decoys="); e64(total_decoys);
    emit(" mkchain_result="); e64(pm);
    emit("\n");

    if(pm<0){
      emit("FAIL at batch="); e64(batch);
      emit(" decoys="); e64(total_decoys);
      emit(" result="); e64(pm);
      emit(" (-1=len wrong, -2=values wrong)\n");
      // dump FACT bucket for tsub
      let b:i32=fhash(tsub);
      emit("bucket="); e64(b); emit("\n");
      let n:i32=fidx_bhead(W,b);
      let c:i32=0;
      while(n>=0 && c<15){
        emit("  ["); e64(c); emit("] node="); e64(n);
        emit(" s="); e64(ng(W,n,20)); emit(" r="); e64(ng(W,n,24));
        emit(" o="); e64(ng(W,n,28)); emit(" live="); e64(ng(W,n,36));
        emit(" tag="); e64(ng(W,n,0));
        emit("\n");
        n=ng(W,n,12); c=c+1;
      }
      // direct lookup test
      let fnd:i32=t2_lu_first(W, tsub, 1);
      emit("t2_lu_first(tsub,1)="); e64(fnd); emit("\n");
      if(fnd>=0){
        emit("  s="); e64(ng(W,fnd,20)); emit(" o="); e64(ng(W,fnd,28)); emit("\n");
      }
      // linear lookup for comparison
      let fnd2:i32=t2_lu_first_lin(W, tsub, 1);
      emit("t2_lu_first_lin(tsub,1)="); e64(fnd2); emit("\n");
      if(fnd2>=0){
        emit("  s="); e64(ng(W,fnd2,20)); emit(" o="); e64(ng(W,fnd2,28)); emit("\n");
      }
      emit("FI-DIAG2-FAIL-DONE\n");
      return 0;
    }
    batch=batch+1;
  }
  emit("FI-DIAG2-ALL-PASS\n");
  return 0;
}

// fi_diag.zag -- FACT index bisect diagnostic.
// Teaches decoys in batches, tests chain-build correctness after each.
// When it fails, dumps the FACT bucket list for inspection.
//
// Build: cat s5_base.zag s5_patch.zag fi_diag.zag > fi_full.zag
// Compile with pinned znc.

// Teach one decoy fact pair like s5_mkbroken but WITHOUT promote (just facts).
fn fi_decoy(W:[]u8, s0:i32)void {
  ev_teach(W, s0, 1, s0+1);
  return;
}

// Build a test chain and verify t2_chain finds the right path.
// Returns 1 if correct, 0 if wrong.
fn fi_test_chain(W:[]u8, s0:i32)i32 {
  // teach 4-link chain
  let k:i32=0;
  while(k<4){
    ev_teach(W, s0+k, 1, s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W, s0, 1, v, f);
  if(len!=5){ return 0; }
  // verify values: v should be s0, s0+1, s0+2, s0+3, s0+4
  let j:i32=0;
  while(j<5){
    if(get32(v,j*4)!=s0+j){ return 0; }
    j=j+1;
  }
  return 1;
}

// Count nodes in FACT bucket b via fidx_bhead walk.
fn fi_bucket_len(W:[]u8, b:i32)i32 {
  let n:i32=fidx_bhead(W, b);
  let c:i32=0;
  while(n>=0 && c<100000){
    c=c+1;
    n=ng(W,n,12);
  }
  return c;
}

// Verify bucket list: all nodes live, tag==1. Returns first bad node or -1 if ok.
fn fi_bucket_check(W:[]u8, b:i32)i32 {
  let n:i32=fidx_bhead(W, b);
  let c:i32=0;
  while(n>=0 && c<100000){
    if(n<2 || n>=65536){ return -2; }  // OOB pointer
    if(ng(W,n,36)!=1){ return n; }       // dead node in list
    if(ng(W,n,0)!=1){ return n; }        // non-FACT in list
    c=c+1;
    n=ng(W,n,12);
  }
  if(c>=100000){ return -3; }  // cycle (too long)
  return -1;  // ok
}

fn fi_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}

fn main()i32 {
  emit("FI-DIAG-START\n");
  let W:[]u8=fi_big(); tnn2_init(W);
  idx_mode_set(W,5);

  // Phase 1: bisect - add decoys in batches of 500, test after each.
  let batch:i32=0;
  let total_decoys:i32=0;
  let s0base:i32=2000;
  while(batch<12){
    // teach 500 decoys
    let i:i32=0;
    while(i<500){
      fi_decoy(W, s0base+total_decoys+i);
      i=i+1;
    }
    total_decoys=total_decoys+500;

    // test chain build with fresh subject (far from decoys)
    let tsub:i32=90000+batch*100;
    let ok:i32=fi_test_chain(W, tsub);

    emit("batch="); e64(batch);
    emit(" decoys="); e64(total_decoys);
    emit(" test_chain="); e64(ok);
    emit("\n");

    if(ok==0){
      // FAILED - dump bucket info for the test subject
      let b:i32=fhash(tsub);
      emit("FAIL at batch="); e64(batch);
      emit(" bucket="); e64(b);
      emit(" bucket_len="); e64(fi_bucket_len(W,b));
      emit(" bucket_check="); e64(fi_bucket_check(W,b));
      emit("\n");
      // check the specific lookup
      let fnd:i32=t2_lu_first(W, tsub, 1);
      emit("t2_lu_first(tsub,1) returned node="); e64(fnd);
      emit("\n");
      if(fnd>=0){
        emit("  node subject="); e64(ng(W,fnd,20));
        emit(" relation="); e64(ng(W,fnd,24));
        emit(" object="); e64(ng(W,fnd,28));
        emit(" live="); e64(ng(W,fnd,36));
        emit(" tag="); e64(ng(W,fnd,0));
        emit("\n");
      }
      // dump first 10 nodes in bucket
      let n:i32=fidx_bhead(W,b);
      let c:i32=0;
      while(n>=0 && c<10){
        emit("  bucket["); e64(c); emit("] node="); e64(n);
        emit(" s="); e64(ng(W,n,20)); emit(" r="); e64(ng(W,n,24));
        emit(" o="); e64(ng(W,n,28)); emit(" live="); e64(ng(W,n,36));
        emit("\n");
        n=ng(W,n,12); c=c+1;
      }
      emit("FI-DIAG-FAIL-DONE\n");
      return 0;
    }
    batch=batch+1;
  }
  emit("FI-DIAG-ALL-PASS\n");
  return 0;
}

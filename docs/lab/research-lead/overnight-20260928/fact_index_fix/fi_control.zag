// fi_control.zag -- Control: original (unhardened) FACT index on corruption.
// Demonstrates the vulnerability that the hardened version fixes.
// Each test is isolated; run with timeout since original may hang/crash.

fn fi_big()[]u8 {
  let W:[]u8=z_alloc(4722752);
  return W;
}

// C1: cycle in bucket with ORIGINAL t2_lu_first_idx.
// Original has no step cap; it will loop forever on a cycle with no match.
// We test with a match present (returns before cycling) vs no match (hangs).
fn c1_cycle_nomatch(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); ns(W,a,36,1); write_node(W,a,0,1,100,0);
  // use ORIGINAL fidx_add
  fidx_add(W,0,a);
  let b:i32=alloc_node(W); ns(W,b,0,1); ns(W,b,36,1); write_node(W,b,24,1,101,0);
  fidx_add(W,24,b);
  // bucket 0: b -> a -> -1. Create cycle a -> b.
  ns(W,a,12,b);
  // lookup with no match in bucket 0: s=0, r=999. Original walks: b(24,1) no,
  // a(0,1) no (r mismatch), b again... INFINITE LOOP.
  // We cannot call it directly (would hang). Instead verify cycle exists:
  let n:i32=fidx_bhead(W,0);
  // walk 5 steps manually, should revisit
  let c:i32=0; let seen_b:i32=0;
  while(c<5 && n>=0){ if(n==b){seen_b=seen_b+1;} n=ng(W,n,12); c=c+1; }
  if(seen_b>=2){ return 1; }  // cycle confirmed
  return 0;
}

// C2: OOB head with ORIGINAL fidx_bhead.
// Original fidx_bhead does NOT validate the head bounds.
fn c2_oob_head(W:[]u8)i32 {
  let a:i32=alloc_node(W); ns(W,a,0,1); ns(W,a,36,1); write_node(W,a,5,1,100,0);
  fidx_add(W,5,a);
  // corrupt head to OOB via direct write
  let ext:i32=idx_node(W);
  let n:i32=ng(W,ext,8);  // ext0
  // bucket 5: k=0, slot for s2=5 is field 32
  ns(W,n,32,99999);
  // original fidx_bhead returns 99999 without validation
  let h:i32=fidx_bhead(W,5);
  if(h==99999){ return 1; }  // original returns OOB unvalidated
  return 0;
}

fn main()i32 {
  emit("FI-CONTROL-START\n");
  let W1:[]u8=fi_big(); tnn2_init(W1); idx_mode_set(W1,5);
  let r1:i32=c1_cycle_nomatch(W1);
  emit("C1 cycle-exists-in-original="); e64(r1); emit("\n");

  let W2:[]u8=fi_big(); tnn2_init(W2); idx_mode_set(W2,5);
  let r2:i32=c2_oob_head(W2);
  emit("C2 oob-head-unvalidated="); e64(r2); emit("\n");

  emit("FI-CONTROL-DONE\n");
  return 0;
}

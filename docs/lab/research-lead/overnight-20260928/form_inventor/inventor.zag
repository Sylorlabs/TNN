// inventor.zag -- form inventor implementing R1-R6.
// Menu machinery (fit_const, fit_lin, fit_exc, fit_form, predict for
// forms 0..2, prior_order, verify_need, run_family phases, buffer
// handling) copied VERBATIM from form_invent/finvent.zag
// (commit 3d543e38e); behavior on families 0..8 is unchanged.
// Added: R1 diagnose, R2 fixed operator vocabulary (node pool +
// generic evaluators), R3 diagnosis-parameterized candidate builder,
// R4 promotion with novelty check, R5 re-diagnosis refit/revision,
// R6 persistent node pool + construction trace.
// Prereg 45d3d6875 + amend1 70369d67b frozen before this file.
// Pure Zag. No Python.

fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// ---- frozen family specs (prereg) ----
fn fam_a(f:i32)i32 {
  if(f==0){return 2;}
  if(f==1){return 3;}
  if(f==2){return 1;}
  if(f==3){return 5;}
  if(f==4){return 2;}
  return 0;
}
fn fam_b(f:i32)i32 {
  if(f==0){return 1;}
  if(f==1){return 5;}
  if(f==2){return 0;}
  if(f==3){return 3;}
  if(f==4){return 9;}
  return 0;
}
fn fam_base(f:i32)i32 {
  if(f==0){return 10;}
  if(f==1){return 1000;}
  if(f==2){return 2000;}
  if(f==3){return 3000;}
  if(f==4){return 4000;}
  if(f==5){return 5000;}
  if(f==6){return 6000;}
  if(f==7){return 7000;}
  if(f==8){return 8000;}
  if(f==9){return 9000;}
  if(f==10){return 10000;}
  return 11000;
}
fn true_subj(f:i32,i:i32)i32 { return fam_base(f)+i; }
fn true_obj(f:i32,i:i32)i32 {
  if(f==6){
    if(i<3){return 0;}
    return 5;
  }
  if(f==7){
    if(i<1){return 0;}
    return 5;
  }
  if(f==8){
    if(i==1){return 3;}
    if(i==4){return 9;}
    return 7;
  }
  if(f==9){
    return 1+(i%4);
  }
  if(f==10){
    if(i<2){return 0;}
    if(i<4){return 1;}
    return 2;
  }
  if(f==11){
    if(true_subj(f,i)<11003){return 2;}
    return 9;
  }
  if(f==5){
    if(i==1){return 3;}
    return 7;
  }
  let s:i32=true_subj(f,i);
  return fam_a(f)*s+fam_b(f);
}

// ---- example buffer ----
fn bget(b:[]u8,i:i32)i32 { return get32(b,i*4); }
fn bset(b:[]u8,i:i32,v:i32)void { set32(b,i*4,v); return; }

// ---- form fitting: menu forms 0..2 (verbatim from finvent) ----
fn fit_const(bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(n<1){return 0;}
  let c:i32=bget(bo,0);
  let i:i32=1;
  while(i<n){
    if(bget(bo,i)!=c){return 0;}
    i=i+1;
  }
  set32(p,0,c);
  return 1;
}
fn fit_lin(bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(n<2){return 0;}
  let s0:i32=bget(bs,0);
  let o0:i32=bget(bo,0);
  let s1:i32=bget(bs,1);
  let o1:i32=bget(bo,1);
  let ds:i32=s1-s0;
  let do:i32=o1-o0;
  if(ds==0){return 0;}
  let a:i32=do/ds;
  if(a*ds!=do){return 0;}
  let b:i32=o0-a*s0;
  let i:i32=2;
  while(i<n){
    if(a*bget(bs,i)+b!=bget(bo,i)){return 0;}
    i=i+1;
  }
  set32(p,0,a);
  set32(p,4,b);
  return 1;
}
fn fit_exc(bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(n<3){return 0;}
  let d:i32=bget(bo,0);
  let odd:i32=-1;
  let nodd:i32=0;
  let i:i32=1;
  while(i<n){
    if(bget(bo,i)!=d){nodd=nodd+1; odd=i;}
    i=i+1;
  }
  if(nodd==1){
    set32(p,0,d);
    set32(p,4,bget(bs,odd));
    set32(p,8,bget(bo,odd));
    return 1;
  }
  if(nodd==n-1){
    let d2:i32=bget(bo,1);
    let j:i32=2;
    let ok:i32=1;
    while(j<n){
      if(bget(bo,j)!=d2){ok=0;}
      j=j+1;
    }
    if(ok==1){
      if(d2!=d){
        set32(p,0,d2);
        set32(p,4,bget(bs,0));
        set32(p,8,d);
        return 1;
      }
    }
  }
  return 0;
}
fn fit_form(form:i32,bs:[]u8,bo:[]u8,n:i32,p:[]u8)i32 {
  if(form==0){return fit_const(bs,bo,n,p);}
  if(form==1){return fit_lin(bs,bo,n,p);}
  return fit_exc(bs,bo,n,p);
}

// ---- R2: fixed constructive operator vocabulary ----
// Node pool at state+52: 8 nodes x 16 bytes (op,a,b,c).
// ops: 0=CONST(c in a), 1=LT(threshold in a), 2=EQ(point in a),
// 3=IF(cond node in a, then node in b, else node in c).
// Root is node 0. Generic evaluators only; no dedicated STEP case.
fn setnode(st:[]u8, ni:i32, op:i32, a:i32, b:i32, c:i32) void {
  let base:i32=52+ni*16;
  set32(st,base,op);
  set32(st,base+4,a);
  set32(st,base+8,b);
  set32(st,base+12,c);
  return;
}
fn node_count(sig:i32) i32 {
  if(sig==1){return 4;}
  return 7;
}
fn teval(st:[]u8, ni:i32, subj:i32) i32 {
  let base:i32=52+ni*16;
  let op:i32=get32(st,base);
  if(op==0){return get32(st,base+4);}
  if(op==1){
    if(subj<get32(st,base+4)){return 1;}
    return 0;
  }
  if(op==2){
    if(subj==get32(st,base+4)){return 1;}
    return 0;
  }
  let cv:i32=teval(st,get32(st,base+4),subj);
  if(cv==1){return teval(st,get32(st,base+8),subj);}
  return teval(st,get32(st,base+12),subj);
}
fn predict(form:i32,st:[]u8,subj:i32)i32 {
  if(form==0){return get32(st,4);}
  if(form==1){return get32(st,4)*subj+get32(st,8);}
  if(form==2){
    if(subj==get32(st,8)){return get32(st,12);}
    return get32(st,4);
  }
  return teval(st,0,subj);
}

// ---- R1: failure diagnosis from fit residuals ----
// Returns 1 (SIG1: two contiguous constant clusters),
// 4 (SIG4: three contiguous constant clusters),
// 3 (SIG3: majority default + exactly 2 isolated exceptions),
// 0 (none). dp: 24 bytes scratch for fitted params.
fn diagnose(bs:[]u8, bo:[]u8, n:i32, dp:[]u8) i32 {
  if(n<2){return 0;}
  let v0:i32=bget(bo,0);
  let k:i32=1;
  while(k<n){
    if(bget(bo,k)!=v0){break;}
    k=k+1;
  }
  if(k<n){
    let v1:i32=bget(bo,k);
    let j:i32=k+1;
    let ok1:i32=1;
    while(j<n){
      if(bget(bo,j)!=v1){ok1=0;}
      j=j+1;
    }
    if(ok1==1){
      set32(dp,0,bget(bs,k));
      set32(dp,4,v0);
      set32(dp,8,v1);
      return 1;
    }
    let k2:i32=k+1;
    while(k2<n){
      if(bget(bo,k2)!=v1){break;}
      k2=k2+1;
    }
    if(k2<n){
      let v2:i32=bget(bo,k2);
      let j2:i32=k2+1;
      let ok2:i32=1;
      while(j2<n){
        if(bget(bo,j2)!=v2){ok2=0;}
        j2=j2+1;
      }
      if(ok2==1){
        set32(dp,0,bget(bs,k));
        set32(dp,4,bget(bs,k2));
        set32(dp,8,v0);
        set32(dp,12,v1);
        set32(dp,16,v2);
        return 4;
      }
    }
  }
  let dv:[]u8=z_alloc(160);
  let nd:i32=0;
  let i:i32=0;
  while(i<n){
    let v:i32=bget(bo,i);
    let f:i32=0;
    let q:i32=0;
    while(q<nd){
      if(get32(dv,q*4)==v){f=1;}
      q=q+1;
    }
    if(f==0){
      set32(dv,nd*4,v);
      nd=nd+1;
    }
    i=i+1;
  }
  let best:i32=bget(bo,0);
  let bestc:i32=0;
  let q2:i32=0;
  while(q2<nd){
    let vv:i32=get32(dv,q2*4);
    let c:i32=0;
    let i2:i32=0;
    while(i2<n){
      if(bget(bo,i2)==vv){c=c+1;}
      i2=i2+1;
    }
    if(c>bestc){
      bestc=c;
      best=vv;
    }
    q2=q2+1;
  }
  let ex:[]u8=z_alloc(160);
  let ne:i32=0;
  let i3:i32=0;
  while(i3<n){
    if(bget(bo,i3)!=best){
      set32(ex,ne*4,i3);
      ne=ne+1;
    }
    i3=i3+1;
  }
  if(ne!=2){return 0;}
  let p1:i32=get32(ex,0);
  let p2:i32=get32(ex,4);
  if(p1<1){return 0;}
  if(p1>=n-1){return 0;}
  if(bget(bo,p1-1)!=best){return 0;}
  if(bget(bo,p1+1)!=best){return 0;}
  if(p2<1){return 0;}
  if(p2>=n-1){return 0;}
  if(bget(bo,p2-1)!=best){return 0;}
  if(bget(bo,p2+1)!=best){return 0;}
  set32(dp,0,bget(bs,p1));
  set32(dp,4,bget(bo,p1));
  set32(dp,8,bget(bs,p2));
  set32(dp,12,bget(bo,p2));
  set32(dp,16,best);
  return 3;
}

// ---- R3: diagnosis-parameterized candidate builder ----
fn build_tree(st:[]u8, sig:i32, dp:[]u8) void {
  if(sig==1){
    setnode(st,0,3,1,2,3);
    setnode(st,1,1,get32(dp,0),0,0);
    setnode(st,2,0,get32(dp,4),0,0);
    setnode(st,3,0,get32(dp,8),0,0);
  } else {
    if(sig==4){
      setnode(st,0,3,1,2,4);
      setnode(st,1,1,get32(dp,0),0,0);
      setnode(st,2,0,get32(dp,8),0,0);
      setnode(st,3,1,get32(dp,4),0,0);
      setnode(st,4,3,3,5,6);
      setnode(st,5,0,get32(dp,12),0,0);
      setnode(st,6,0,get32(dp,16),0,0);
    } else {
      setnode(st,0,3,1,2,4);
      setnode(st,1,2,get32(dp,0),0,0);
      setnode(st,2,0,get32(dp,4),0,0);
      setnode(st,3,2,get32(dp,8),0,0);
      setnode(st,4,3,3,5,6);
      setnode(st,5,0,get32(dp,12),0,0);
      setnode(st,6,0,get32(dp,16),0,0);
    }
  }
  return;
}
fn tree_exact_fit(st:[]u8, bs:[]u8, bo:[]u8, n:i32) i32 {
  let i:i32=0;
  while(i<n){
    if(teval(st,0,bget(bs,i))!=bget(bo,i)){return 0;}
    i=i+1;
  }
  return 1;
}

// ---- R4: novelty check (reject menu-reducible candidates) ----
fn novelty_check(st:[]u8, sig:i32, dp:[]u8, bs:[]u8, bo:[]u8, n:i32) i32 {
  if(sig==1){
    let T:i32=get32(dp,0);
    if(T<=bget(bs,0)){return 0;}
    if(T>bget(bs,n-1)){return 0;}
    return 1;
  }
  if(sig==4){
    let T1:i32=get32(dp,0);
    let T2:i32=get32(dp,4);
    if(T1<=bget(bs,0)){return 0;}
    if(T1>=T2){return 0;}
    if(T2>bget(bs,n-1)){return 0;}
    return 1;
  }
  if(sig==3){
    let p1:i32=get32(dp,0);
    let p2:i32=get32(dp,8);
    if(p1==p2){return 0;}
    return 1;
  }
  return 0;
}
fn verify_need3(st:[]u8) i32 {
  let u:i32=get32(st,44);
  let pw:i32=1;
  let k:i32=0;
  while(k<u){pw=pw*2; k=k+1;}
  let v:i32=(14+pw-1)/pw;
  if(v<1){v=1;}
  return v;
}

// ---- prior order: descending uses, ties -> lower form index (verbatim) ----
fn prior_order(st:[]u8,ord:[]u8)void {
  let p0:i32=0;
  let p1:i32=0;
  let p2:i32=0;
  let k:i32=0;
  while(k<3){
    let best:i32=-1;
    let bestu:i32=-1;
    let f:i32=0;
    while(f<3){
      let pl:i32=0;
      if(f==0){pl=p0;}
      else { if(f==1){pl=p1;} else {pl=p2;} }
      if(pl==0){
        let u:i32=get32(st,16+f*4);
        if(u>bestu){bestu=u; best=f;}
      }
      f=f+1;
    }
    set32(ord,k*4,best);
    if(best==0){p0=1;}
    else { if(best==1){p1=1;} else {p2=1;} }
    k=k+1;
  }
  return;
}

// ---- verification need: V = max(1, ceil(V0 / 2^uses)) (verbatim) ----
fn verify_need(st:[]u8,form:i32)i32 {
  let u:i32=get32(st,16+form*4);
  let pw:i32=1;
  let k:i32=0;
  while(k<u){pw=pw*2; k=k+1;}
  let v:i32=(14+pw-1)/pw;
  if(v<1){v=1;}
  return v;
}

// ---- state block layout (extended for the inventor) ----
// 0 live_form | 4 p0 | 8 p1 | 12 p2 | 16 uses0 | 20 uses1 | 24 uses2 |
// 28 str0 | 32 str1 | 36 str2 | 40 frozen_uses |
// 44 uses3 | 48 strikes3 | 52..179 node pool (8 x 16) |
// 180 last_sig | 184 live_sig | 188 live_nodes
// ---- out block layout ----
// 0 cost | 4 adopted | 8 u0b | 12 u1b | 16 u2b | 20 V |
// 24 refit (1 ok, 0 fail, -1 na) | 28 s0a | 32 s1a | 36 s2a |
// 40 inv_event (-1 never, 0 SIG0, else sig) | 44 inv_promoted (0/1) |
// 48 uses3_after | 52 strikes3_after
fn run_family(st:[]u8,fam:i32,out:[]u8)void {
  let bs:[]u8=z_alloc(40*4);
  let bo:[]u8=z_alloc(40*4);
  let tp:[]u8=z_alloc(12);
  let ord:[]u8=z_alloc(12);
  let cost:i32=0;
  let adopted:i32=-2;
  let v_used:i32=0;
  let refit_out:i32=-1;
  let inv_used:i32=0;
  set32(out,8,get32(st,16));
  set32(out,12,get32(st,20));
  set32(out,16,get32(st,24));
  set32(out,40,-1);
  set32(out,44,0);
  let ei:i32=0;
  let n:i32=0;
  let vc:i32=0;
  let wrong:i32=0;
  let V:i32=0;
  let live:i32=get32(st,0);
  let phase:i32=0;
  if(live>=0){phase=1;}
  let done:i32=0;
  while(done==0){
    if(phase==0){
      // DISCOVER
      let s:i32=true_subj(fam,ei);
      let o:i32=true_obj(fam,ei);
      bset(bs,n,s);
      bset(bo,n,o);
      n=n+1; ei=ei+1; cost=cost+1;
      if(n>=6){
        prior_order(st,ord);
        let k:i32=0;
        let found:i32=-1;
        while(k<3){
          let f:i32=get32(ord,k*4);
          if(fit_form(f,bs,bo,n,tp)==1){found=f; k=3;}
          else {k=k+1;}
        }
        if(found>=0){
          live=found;
          set32(st,0,found);
          set32(st,4,get32(tp,0));
          set32(st,8,get32(tp,4));
          set32(st,12,get32(tp,8));
          V=verify_need(st,found);
          v_used=V; vc=0; wrong=0;
          phase=2;
        } else {
          if(n>=40){
            // INVENTOR hook: menu exhausted at BMAX (R1-R4)
            if(inv_used==1){
              adopted=-1; done=1;
            } else {
              inv_used=1;
              let idp:[]u8=z_alloc(24);
              let isig:i32=diagnose(bs,bo,n,idp);
              set32(out,40,isig);
              set32(st,180,isig);
              emit("INV DIAG fam=");
              e64(fam);
              emit(" n=");
              e64(n);
              emit(" sig=");
              e64(isig);
              emit("\n");
              if(isig==0){
                emit("INV HONESTFAIL fam=");
                e64(fam);
                emit(" n=");
                e64(n);
                emit("\n");
                adopted=-1; done=1;
              } else {
                build_tree(st,isig,idp);
                let nc:i32=node_count(isig);
                set32(st,188,nc);
                emit("INV CAND fam=");
                e64(fam);
                emit(" sig=");
                e64(isig);
                emit(" nodes=");
                e64(nc);
                emit("\n");
                let fitok:i32=tree_exact_fit(st,bs,bo,n);
                emit("INV FIT fam=");
                e64(fam);
                emit(" exact=");
                e64(fitok);
                emit("\n");
                let nov:i32=novelty_check(st,isig,idp,bs,bo,n);
                emit("INV NOVEL fam=");
                e64(fam);
                emit(" pass=");
                e64(nov);
                emit("\n");
                if(fitok==1){
                  if(nov==1){
                    live=3;
                    set32(st,0,3);
                    set32(st,184,isig);
                    set32(out,44,1);
                    V=verify_need3(st);
                    v_used=V; vc=0; wrong=0;
                    emit("INV PROMOTE fam=");
                    e64(fam);
                    emit(" form=3 V=");
                    e64(V);
                    emit("\n");
                    phase=2;
                  } else {
                    adopted=-1; done=1;
                  }
                } else {
                  adopted=-1; done=1;
                }
              }
            }
          }
        }
      }
    } else {
      if(phase==1){
        // REFIT: buffer exactly R=4
        while(n<4){
          let s2:i32=true_subj(fam,ei);
          let o2:i32=true_obj(fam,ei);
          bset(bs,n,s2);
          bset(bo,n,o2);
          n=n+1; ei=ei+1; cost=cost+1;
        }
        if(live==3){
          // R5: re-diagnosis refit for invented forms
          let rdp:[]u8=z_alloc(24);
          let rsig:i32=diagnose(bs,bo,4,rdp);
          emit("INV REFIT fam=");
          e64(fam);
          emit(" rsig=");
          e64(rsig);
          emit(" live_sig=");
          e64(get32(st,184));
          emit("\n");
          if(rsig==get32(st,184)){
            if(rsig!=0){
              refit_out=1;
              build_tree(st,rsig,rdp);
              set32(st,180,rsig);
              V=verify_need3(st);
              v_used=V; vc=0; wrong=0;
              emit("INV REFITOK fam=");
              e64(fam);
              emit(" V=");
              e64(V);
              emit("\n");
              phase=2;
            } else {
              refit_out=0;
              set32(st,48,get32(st,48)+1);
              emit("INV STRIKE fam=");
              e64(fam);
              emit(" strikes3=");
              e64(get32(st,48));
              emit("\n");
              live=-1;
              set32(st,0,-1);
              phase=0;
            }
          } else {
            refit_out=0;
            set32(st,48,get32(st,48)+1);
            emit("INV STRIKE fam=");
            e64(fam);
            emit(" strikes3=");
            e64(get32(st,48));
            emit("\n");
            live=-1;
            set32(st,0,-1);
            phase=0;
          }
        } else {
          if(fit_form(live,bs,bo,4,tp)==1){
            refit_out=1;
            set32(st,4,get32(tp,0));
            set32(st,8,get32(tp,4));
            set32(st,12,get32(tp,8));
            V=verify_need(st,live);
            v_used=V; vc=0; wrong=0;
            phase=2;
          } else {
            // strike; KEEP the refuting examples, enter DISCOVER
            refit_out=0;
            set32(st,28+live*4,get32(st,28+live*4)+1);
            live=-1;
            set32(st,0,-1);
            phase=0;
          }
        }
      } else {
        // VERIFY
        let s3:i32=true_subj(fam,ei);
        let o3:i32=true_obj(fam,ei);
        let pr:i32=predict(live,st,s3);
        ei=ei+1; cost=cost+1;
        if(pr==o3){vc=vc+1;}
        else {vc=0; wrong=wrong+1;}
        if(vc>=V){
          adopted=live;
          if(get32(st,40)==0){
            if(live==3){
              set32(st,44,get32(st,44)+1);
            } else {
              set32(st,16+live*4,get32(st,16+live*4)+1);
            }
          }
          done=1;
        } else {
          if(wrong>=3){
            if(live==3){
              set32(st,48,get32(st,48)+1);
            } else {
              set32(st,28+live*4,get32(st,28+live*4)+1);
            }
            live=-1;
            set32(st,0,-1);
            phase=0; n=0; vc=0; wrong=0;
          }
        }
      }
    }
  }
  set32(out,0,cost);
  set32(out,4,adopted);
  set32(out,20,v_used);
  set32(out,24,refit_out);
  set32(out,28,get32(st,28));
  set32(out,32,get32(st,32));
  set32(out,36,get32(st,36));
  set32(out,48,get32(st,44));
  set32(out,52,get32(st,48));
  return;
}

fn emit_trace(cond:[]u8,fam:i32,out:[]u8)void {
  emit("TR ");
  emit(cond);
  emit(" fam=");
  e64(fam);
  emit(" cost=");
  e64(get32(out,0));
  emit(" adopted=");
  e64(get32(out,4));
  emit(" V=");
  e64(get32(out,20));
  emit(" refit=");
  e64(get32(out,24));
  emit(" inv_event=");
  e64(get32(out,40));
  emit(" inv_promoted=");
  e64(get32(out,44));
  emit(" uses3=");
  e64(get32(out,48));
  emit(" strikes3=");
  e64(get32(out,52));
  emit("\n");
  return;
}

fn chk(exp_a:i32, exp_c:i32, exp_i:i32, exp_p:i32, exp_r:i32, out:[]u8) i32 {
  if(get32(out,4)!=exp_a){return 0;}
  if(get32(out,0)!=exp_c){return 0;}
  if(get32(out,40)!=exp_i){return 0;}
  if(get32(out,44)!=exp_p){return 0;}
  if(get32(out,24)!=exp_r){return 0;}
  return 1;
}

fn main()i32 {
  emit("INVENTOR-START\n");
  emit("SPEC A F1 a=2 b=1 base=10\n");
  emit("SPEC B F1 a=3 b=5 base=1000\n");
  emit("SPEC C F1 a=1 b=0 base=2000\n");
  emit("SPEC D F1 a=5 b=3 base=3000\n");
  emit("SPEC E F1 a=2 b=9 base=4000\n");
  emit("SPEC G STEP base=6000 T=6003 lo=0 hi=5\n");
  emit("SPEC G2 STEP base=7000 T=7001 lo=0 hi=5\n");
  emit("SPEC H 2EXC base=8000 d=7 e1=8001->3 e2=8004->9\n");
  emit("SPEC K 3CLUS base=10000 T1=10002 T2=10004 vals 0,1,2\n");
  emit("SPEC J SCAT base=9000 vals 1,2,3,4\n");
  emit("SPEC Gp STEP base=11000 T=11003 lo=2 hi=9\n");
  emit("PARAMS BMIN=6 R=4 V0=14 WMAX=3 BMAX=40\n");
  let k2:i32=1;
  // ---- FRESH: G, G2, H, K, J ----
  let flist:[]u8=z_alloc(20);
  set32(flist,0,6);
  set32(flist,4,7);
  set32(flist,8,8);
  set32(flist,12,10);
  set32(flist,16,9);
  // expected (adopted, cost, inv_event, promoted, refit)
  let fe:[]u8=z_alloc(100);
  set32(fe,0,3); set32(fe,4,54); set32(fe,8,1); set32(fe,12,1); set32(fe,16,-1);
  set32(fe,20,2); set32(fe,24,20); set32(fe,28,-1); set32(fe,32,0); set32(fe,36,-1);
  set32(fe,40,3); set32(fe,44,54); set32(fe,48,3); set32(fe,52,1); set32(fe,56,-1);
  set32(fe,60,3); set32(fe,64,54); set32(fe,68,4); set32(fe,72,1); set32(fe,76,-1);
  set32(fe,80,-1); set32(fe,84,40); set32(fe,88,0); set32(fe,92,0); set32(fe,96,-1);
  let q:i32=0;
  while(q<5){
    let fam:i32=get32(flist,q*4);
    let st:[]u8=z_alloc(192);
    set32(st,0,-1);
    let out:[]u8=z_alloc(56);
    run_family(st,fam,out);
    emit_trace("FRESH",fam,out);
    let b:i32=q*20;
    if(chk(get32(fe,b),get32(fe,b+4),get32(fe,b+8),get32(fe,b+12),get32(fe,b+16),out)==0){k2=0;}
    q=q+1;
  }
  // ---- RETAINED: A,B,C,D,E,G,Gp,H,G2 ----
  let rlist:[]u8=z_alloc(36);
  set32(rlist,0,0);
  set32(rlist,4,1);
  set32(rlist,8,2);
  set32(rlist,12,3);
  set32(rlist,16,4);
  set32(rlist,20,6);
  set32(rlist,24,11);
  set32(rlist,28,8);
  set32(rlist,32,7);
  let re:[]u8=z_alloc(180);
  set32(re,0,1); set32(re,4,20); set32(re,8,-1); set32(re,12,0); set32(re,16,-1);
  set32(re,20,1); set32(re,24,11); set32(re,28,-1); set32(re,32,0); set32(re,36,1);
  set32(re,40,1); set32(re,44,8); set32(re,48,-1); set32(re,52,0); set32(re,56,1);
  set32(re,60,1); set32(re,64,6); set32(re,68,-1); set32(re,72,0); set32(re,76,1);
  set32(re,80,1); set32(re,84,5); set32(re,88,-1); set32(re,92,0); set32(re,96,1);
  set32(re,100,3); set32(re,104,54); set32(re,108,1); set32(re,112,1); set32(re,116,0);
  set32(re,120,3); set32(re,124,11); set32(re,128,-1); set32(re,132,0); set32(re,136,1);
  set32(re,140,3); set32(re,144,44); set32(re,148,3); set32(re,152,1); set32(re,156,0);
  set32(re,160,2); set32(re,164,20); set32(re,168,-1); set32(re,172,0); set32(re,176,0);
  let rst:[]u8=z_alloc(192);
  set32(rst,0,-1);
  q=0;
  while(q<9){
    let fam2:i32=get32(rlist,q*4);
    let out2:[]u8=z_alloc(56);
    run_family(rst,fam2,out2);
    emit_trace("RETAINED",fam2,out2);
    let b2:i32=q*20;
    if(chk(get32(re,b2),get32(re,b2+4),get32(re,b2+8),get32(re,b2+12),get32(re,b2+16),out2)==0){k2=0;}
    q=q+1;
  }
  emit("K2 ");
  e64(k2);
  emit("\n");
  if(k2==1){emit("VERDICT INVENTOR-TESTED\n");}
  else {emit("VERDICT INVENTOR-BLOCKED-K2\n");}
  emit("INVENTOR-END\n");
  return 0;
}

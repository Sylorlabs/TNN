// fix_mech.zag -- Invention H3 REPAIR (unfrozen).
//
// Derived from the frozen invention_constraint/invent_patch.zag
// (SHA-256 4fc5493061363bc8ab9a228cb6a67db17f080a01114a5a920efcc87ced47d0bf).
// The frozen original is untouched. This copy repairs the three concrete
// defects found by the H3 red team (commit 9ef522189):
//
// FIX-1 (Attack 1, verify-fail give-up): the old invent_dfs stopped at the
//   first constraint-satisfying sequence and invent_try returned -2 when
//   that single candidate failed t2_try_verify, even when a verifying
//   chain existed later in the enumeration. The new invent_dfs performs
//   FULL enumeration: every constraint-satisfying sequence is assembled
//   (in a scratch workspace copy, so the real workspace is never
//   polluted) and verified. Verification failure backtracks into the
//   search instead of ending it.
//
// FIX-2 (Attack 5, first_lit invisible): the old invent_dfs never read
//   C[20]; first_lit was enforced only by the external invent_check
//   harness, so a violating chain could be constructed, verified, and
//   promoted. The new invent_dfs READS C[20]. The chain value v[0] is
//   fixed to the query subject s by construction, so enforcement is an
//   entry check: first_lit>=0 and first_lit!=s means the constrained
//   space is empty and the search returns -1 immediately.
//
// FIX-3 (Attacks 1 and 5, no quality criterion): among the VERIFYING
//   sequences the mechanism now applies a deterministic, documented
//   tie-break policy instead of first-hit-wins in teach (node id) order.
//   TIE-BREAK POLICY, in order:
//     1. fewest repeated values (non-redundancy). A chain that revisits
//        a value (for example a stuttering 2-cycle detour) loses to one
//        that does not. This is a form-quality criterion, not a hard
//        filter: a degenerate chain remains promotable when it is the
//        only verifying candidate.
//     2. lexicographically smallest value sequence. This is independent
//        of teach order: the same fact set taught in any order yields
//        the same winner.
//     3. residual full tie (identical value sequences, e.g. duplicate
//        facts): first verifying encounter in DFS order, deterministic.
//
// Constraint struct C is unchanged (6 i32 slots):
//   C[0] plen      exact chain length in links, or -1 for don't care
//   C[1] rel_exact_r  relation that must appear exactly N times, or -1
//   C[2] rel_exact_n  the N
//   C[3] first_rel   required relation of link 0, or -1
//   C[4] last_rel    required relation of link plen-1, or -1
//   C[5] first_lit   required v[0] literal, or -1 (now search-enforced)
//
// Architecture accounting for this repair: 0 new modes, 0 new bridges,
// 0 new handlers, 0 new semantic cases. The search, pruning, assembly,
// verification, and promotion machinery are unchanged; only the stop
// condition (first hit -> full enumeration with verify-and-select),
// the first_lit entry check, and the winner selection policy changed.

// ---- config: 1 = invention enabled; 0 = NO-INVENT control (one-line diff)
fn invent_on()i32 { return 1; }

// Structural property extraction (from composition_C, unchanged):
// walk the MAP's promoted guard/set chain, read each SET cell's DEP
// (type-1) edge to its licensing fact, record the fact's relation.
// MAP labels (field 4, field 8) are never consulted.
fn invent_relseq(W:[]u8,m:i32,seq:[]u8,maxn:i32)i32 {
  let root:i32=ng(W,m,20);
  let cur:i32=root;
  let exp102:i32=1;
  let n:i32=0;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      cur=ng(W,cur,12);
      exp102=0;
    } else {
      if(tag!=101){return -1;}
      let fact:i32=-1;
      let e:i32=0;
      while(e<4096 && fact<0){
        if(eg(W,e,0)==cur && eg(W,e,4)==1){fact=eg(W,e,8);}
        e=e+1;
      }
      if(fact<0){return -1;}
      if(ng(W,fact,0)!=1 || ng(W,fact,36)!=1){return -1;}
      if(n>=maxn){return -1;}
      set32(seq,n*4,ng(W,fact,24));
      n=n+1;
      cur=seq_nx(W,cur);
      exp102=1;
    }
    steps=steps+1;
  }
  if(n==0){return -1;}
  return n;
}

// Next live fact node with subject==subj and id > after. -1 if none.
fn invent_fact_next(W:[]u8,subj:i32,after:i32)i32 {
  let n:i32=after+1;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==subj){return n;}
    n=n+1;
  }
  return -1;
}

// Count value repetitions in a value sequence of length n (pairs i<j
// with equal values). Used by the tie-break policy (rule 1).
fn invent_repeats(v:[]u8,n:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let j:i32=i+1;
    while(j<n){
      if(get32(v,i*4)==get32(v,j*4)){c=c+1;}
      j=j+1;
    }
    i=i+1;
  }
  return c;
}

// Lexicographic compare of two value sequences of length n.
// Returns -1 if a<b, 1 if a>b, 0 if equal. Tie-break policy rule 2.
fn invent_lexcmp(a:[]u8,b:[]u8,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    let x:i32=get32(a,i*4);
    let y:i32=get32(b,i*4);
    if(x<y){return -1;}
    if(x>y){return 1;}
    i=i+1;
  }
  return 0;
}

// Enumerative backtracking DFS with verify-and-select (FIX-1, FIX-2, FIX-3).
//
// Same candidate order (invent_fact_next over node ids) and same pruning
// (first_rel, last_rel, rel_exact reachability) as the frozen search.
// Differences from the frozen version:
//   - reads C[20] (first_lit); rejects at entry when first_lit!=s;
//   - does NOT stop at the first satisfying sequence; every satisfying
//     sequence is assembled in a scratch workspace copy and verified;
//   - keeps the best VERIFYING sequence under the documented tie-break
//     policy (fewest repeats, then lexicographic-min values).
//
// Fills ovals[0..plen] (values) and ofacts[0..plen-1] (fact ids) with the
// winning sequence. info[0]=satisfying sequences seen, info[1]=verifying
// sequences seen, info[2]=winner repeat count (-1 when none).
// Returns plen on success, -1 when no satisfying sequence verifies.
fn invent_dfs(W:[]u8,s:i32,C:[]u8,ovals:[]u8,ofacts:[]u8,expected:i32,masked:i32,st:[]u8,info:[]u8)i32 {
  let plen:i32=get32(C,0);
  let re_r:i32=get32(C,4);
  let re_n:i32=get32(C,8);
  let first_rel:i32=get32(C,12);
  let last_rel:i32=get32(C,16);
  let first_lit:i32=get32(C,20);
  if(first_lit>=0 && first_lit!=s){return -1;}
  let cap:i32=8;
  let wlen:i32=WSZ();
  let curval:[]u8=z_alloc(32);
  let factid:[]u8=z_alloc(32);
  let nextid:[]u8=z_alloc(32);
  let relcnt:[]u8=z_alloc(32);
  let bestv:[]u8=z_alloc(32);
  let bestf:[]u8=z_alloc(32);
  let W2:[]u8=z_alloc(wlen);
  set32(curval,0,s);
  set32(nextid,0,1);
  set32(relcnt,0,0);
  set32(info,0,0);
  set32(info,4,0);
  set32(info,8,-1);
  let have_best:i32=0;
  let best_rep:i32=0;
  let pos:i32=0;
  while(pos>=0){
    if(pos>=plen || pos>=cap){
      if(pos==plen){
        let ok:i32=1;
        if(re_r>=0 && get32(relcnt,pos*4)!=re_n){ok=0;}
        if(ok==1){
          set32(info,0,get32(info,0)+1);
          let b2:i32=0;
          while(b2<wlen){set32(W2,b2,get32(W,b2)); b2=b2+4;}
          let root:i32=t2_asm_chain(W2,curval,plen+1,factid);
          if(root>=0){
            let cst:[]u8=z_alloc(8);
            set32(cst,0,0); set32(cst,4,0);
            let v2:i32=t2_try_verify(W2,root,s,expected,masked,cst);
            set32(st,0,get32(st,0)+get32(cst,0));
            set32(st,4,get32(st,4)+get32(cst,4));
            if(v2!=-2){
              set32(info,4,get32(info,4)+1);
              let rep:i32=invent_repeats(curval,plen+1);
              let take:i32=0;
              if(have_best==0){take=1;}
              else {
                if(rep<best_rep){take=1;}
                else {
                  if(rep==best_rep){
                    if(invent_lexcmp(curval,bestv,plen+1)<0){take=1;}
                  }
                }
              }
              if(take==1){
                let k:i32=0;
                while(k<=plen){set32(bestv,k*4,get32(curval,k*4)); k=k+1;}
                k=0;
                while(k<plen){set32(bestf,k*4,get32(factid,k*4)); k=k+1;}
                best_rep=rep;
                have_best=1;
              }
            }
          }
        }
        pos=pos-1;
      } else {
        pos=pos-1;
      }
    } else {
      let cv:i32=get32(curval,pos*4);
      let fid:i32=invent_fact_next(W,cv,get32(nextid,pos*4));
      if(fid<0){
        pos=pos-1;
      } else {
        set32(nextid,pos*4,fid);
        let fr:i32=ng(W,fid,24);
        let ok2:i32=1;
        if(first_rel>=0 && pos==0 && fr!=first_rel){ok2=0;}
        if(last_rel>=0 && pos==plen-1 && fr!=last_rel){ok2=0;}
        let newcnt:i32=get32(relcnt,pos*4);
        if(re_r>=0){
          if(fr==re_r){newcnt=newcnt+1;}
          if(newcnt>re_n){ok2=0;}
          if(newcnt+(plen-1-pos)<re_n){ok2=0;}
        }
        if(ok2==1){
          set32(relcnt,(pos+1)*4,newcnt);
          set32(factid,pos*4,fid);
          set32(curval,(pos+1)*4,ng(W,fid,28));
          set32(nextid,(pos+1)*4,1);
          pos=pos+1;
        }
      }
    }
  }
  if(have_best==1){
    let i:i32=0;
    while(i<=plen){set32(ovals,i*4,get32(bestv,i*4)); i=i+1;}
    i=0;
    while(i<plen){set32(ofacts,i*4,get32(bestf,i*4)); i=i+1;}
    set32(info,8,best_rep);
    return plen;
  }
  return -1;
}

// Constraint-driven invention for query (s,r,expected) under C.
// The search now returns the tie-break winner among VERIFYING sequences
// (or -1 when none verifies); assembly, verification, and promotion of
// the winner are unchanged. Returns the verified answer or -2.
fn invent_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,C:[]u8,st:[]u8)i32 {
  let plen:i32=get32(C,0);
  if(plen<1 || plen>7){return -2;}
  let ovals:[]u8=z_alloc(32);
  let ofacts:[]u8=z_alloc(28);
  let info:[]u8=z_alloc(12);
  let ln:i32=invent_dfs(W,s,C,ovals,ofacts,expected,masked,st,info);
  if(ln<1){
    emit("INVENT-FAIL\n");
    return -2;
  }
  let root:i32=t2_asm_chain(W,ovals,plen+1,ofacts);
  if(root<0){return -2;}
  let cst:[]u8=z_alloc(8);
  set32(cst,0,0); set32(cst,4,0);
  let v2:i32=t2_try_verify(W,root,s,expected,masked,cst);
  set32(st,0,get32(st,0)+get32(cst,0));
  set32(st,4,get32(st,4)+get32(cst,4));
  if(v2==-2){return -2;}
  let zm:i32=promote_graph(W,root,s,r,v2,ofacts,plen);
  emit("INVENT-OK plen="); e64(plen); emit(" map="); e64(zm);
  emit(" seq="); e64(get32(info,0)); emit(" vok="); e64(get32(info,4));
  emit(" repeats="); e64(get32(info,8)); emit("\n");
  return v2;
}

// Structural verification: does MAP m satisfy every non-don't-care
// constraint in C? Extracts the relation sequence from the executable
// graph (never from labels). Returns 1 iff all constraints hold.
// Unchanged by this repair.
fn invent_check(W:[]u8,m:i32,C:[]u8)i32 {
  if(m<0){return 0;}
  let seq:[]u8=z_alloc(28);
  let len:i32=invent_relseq(W,m,seq,7);
  if(len<1){return 0;}
  let plen:i32=get32(C,0);
  if(plen>=0 && len!=plen){return 0;}
  let re_r:i32=get32(C,4);
  let re_n:i32=get32(C,8);
  if(re_r>=0){
    let c:i32=0; let i:i32=0;
    while(i<len){if(get32(seq,i*4)==re_r){c=c+1;} i=i+1;}
    if(c!=re_n){return 0;}
  }
  let first_rel:i32=get32(C,12);
  if(first_rel>=0 && get32(seq,0)!=first_rel){return 0;}
  let last_rel:i32=get32(C,16);
  if(last_rel>=0 && get32(seq,(len-1)*4)!=last_rel){return 0;}
  let first_lit:i32=get32(C,20);
  if(first_lit>=0 && ng(W,m,8)!=first_lit){return 0;}
  return 1;
}

// Standard ev_query (activate, rebind, trial, bootstrap). No invention.
// Unchanged by this repair.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// ev_query_c: constraint-carrying query. When invent_on()==1 and C holds
// a valid plen, the constraint-driven constructor runs FIRST (trial is
// form-blind: it cannot satisfy structural constraints, demonstrated by
// the NO-INVENT arm). On invention failure, falls through to standard.
// Unchanged by this repair.
fn ev_query_c(W:[]u8,s:i32,r:i32,expected:i32,flags:i32,C:[]u8)i32 {
  if(invent_on()==1 && get32(C,0)>=1){
    hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
    let n:i32=activate(W,s,r);
    if(n>=0){
      link_edge(W,n,6,n,0); ref_prot(W,n);
      log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
    }
    let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
    let masked:i32=flags&1;
    let ia:i32=invent_try(W,s,r,expected,masked,C,rbs);
    emit("INVENT-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ia!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ia,1,0,0); return ia;
    }
  }
  return ev_query(W,s,r,expected,flags);
}

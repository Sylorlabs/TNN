// rt2_h3_driver.zag -- REDTEAM2 H3 attacks (unfrozen driver).
//
// Attacks the FIXED H3 constraint-invention mechanism (fix_mech.zag,
// byte-identical copy, never modified) with NEW adversarial worlds.
// The base and mechanism supply: ev_teach, tnn2_init, invent_try,
// invent_check, invent_relseq, invent_fact_next.
//
// C1 TIEBREAK-WRONG: genuine hub-revisiting chain
//   [1000,1010,1020,1010,2000] (1 repeat, legitimate structure) versus a
//   clean distractor shortcut [1000,1100,1200,1300,2000] (0 repeats).
//   Both satisfy the constraints; both verify answer-only. The new
//   fewest-repeats rule should prefer the distractor.
// C2 FIRSTLIT-VACUITY: (a) first_lit=s versus first_lit unset on the
//   same poison world: winners must be identical (vacuity). (b)
//   poison-only world with first_lit=s: the stutter chain matches
//   first_lit, so the entry check cannot stop it.
// C3 VERIFY-BLOWUP: layered DAG facts, loose constraints (every
//   length-plen path satisfies), expected value unreachable: EVERY
//   candidate fails verification after a full scratch-workspace copy,
//   assembly, and verify. The exponential case the fixer deferred.
// C4 SCRATCH-HYGIENE: invent_try twice on one workspace (C1 world) plus
//   fact-chain stability checks: the repair claims the real workspace
//   is never polluted by trial assemblies.

fn rt2_mkC(plen:i32,re_r:i32,re_n:i32,first_rel:i32,last_rel:i32,first_lit:i32)[]u8 {
  let C:[]u8=z_alloc(24);
  set32(C,0,plen);
  set32(C,4,re_r);
  set32(C,8,re_n);
  set32(C,12,first_rel);
  set32(C,16,last_rel);
  set32(C,20,first_lit);
  return C;
}
fn rt2_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn rt2_factids(W:[]u8,m:i32,ids:[]u8,maxn:i32)i32 {
  let root:i32=ng(W,m,20);
  let cur:i32=root;
  let exp102:i32=1;
  let n:i32=0;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      cur=ng(W,cur,12);
      exp102=0;
    } else {
      if(tag!=101){return -1;}
      let fact:i32=-1;
      let e:i32=0;
      while(e<4096 && fact<0){
        if(eg(W,e,0)==cur && eg(W,e,4)==1){fact=eg(W,e,8);}
        e=e+1;
      }
      if(fact<0){return -1;}
      if(n>=maxn){return -1;}
      set32(ids,n*4,fact);
      n=n+1;
      cur=seq_nx(W,cur);
      exp102=1;
    }
    steps=steps+1;
  }
  if(n==0){return -1;}
  return n;
}
fn rt2_print_vals(W:[]u8,m:i32)void {
  let ids:[]u8=z_alloc(32);
  let len:i32=rt2_factids(W,m,ids,8);
  emit("vals=[");
  e64(ng(W,m,8));
  let i:i32=0;
  while(i<len){
    emit(",");
    e64(ng(W,get32(ids,i*4),28));
    i=i+1;
  }
  emit("]\n");
  return;
}
// Check the promoted MAP's value sequence against exp[0..n-1]. 1 on match.
fn rt2_winner_vals_ok(W:[]u8,m:i32,exp:[]u8,n:i32)i32 {
  if(m<0){return 0;}
  if(ng(W,m,8)!=get32(exp,0)){return 0;}
  let ids:[]u8=z_alloc(32);
  let len:i32=rt2_factids(W,m,ids,8);
  if(len!=n-1){return 0;}
  let i:i32=0;
  while(i<len){
    if(ng(W,get32(ids,i*4),28)!=get32(exp,(i+1)*4)){return 0;}
    i=i+1;
  }
  return 1;
}
// Count live facts with a given subject (fact-chain stability probe).
fn rt2_count_facts(W:[]u8,subj:i32)i32 {
  let n:i32=0;
  let fid:i32=invent_fact_next(W,subj,1);
  while(fid>=0){
    n=n+1;
    fid=invent_fact_next(W,subj,fid);
  }
  return n;
}

// ---- C1: fewest-repeats prefers the distractor ----
fn rt2_c1_world(W:[]u8)void {
  ev_teach(W,1000,3,1010);
  ev_teach(W,1010,7,1020);
  ev_teach(W,1020,5,1010);
  ev_teach(W,1010,9,2000);
  ev_teach(W,1000,3,1100);
  ev_teach(W,1100,7,1200);
  ev_teach(W,1200,5,1300);
  ev_teach(W,1300,9,2000);
  return;
}
fn rt2_c1()void {
  emit("=== C1 TIEBREAK-WRONG (fewest-repeats prefers the distractor) ===\n");
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  rt2_c1_world(W);
  let C:[]u8=rt2_mkC(4,7,1,3,9,1000);
  let st:[]u8=z_alloc(8);
  set32(st,0,0);
  set32(st,4,0);
  let ans:i32=invent_try(W,1000,70,2000,0,C,st);
  emit("C1 invent_try ans=");
  e64(ans);
  emit("\n");
  let m:i32=rt2_find_map(W,1000,70);
  emit("C1 check=");
  e64(invent_check(W,m,C));
  emit("\n");
  if(m>=0){
    rt2_print_vals(W,m);
  }
  let expd:[]u8=z_alloc(20);
  set32(expd,0,1000);
  set32(expd,4,1100);
  set32(expd,8,1200);
  set32(expd,12,1300);
  set32(expd,16,2000);
  let expg:[]u8=z_alloc(20);
  set32(expg,0,1000);
  set32(expg,4,1010);
  set32(expg,8,1020);
  set32(expg,12,1010);
  set32(expg,16,2000);
  if(rt2_winner_vals_ok(W,m,expd,5)==1){
    emit("C1 DISTRACTOR-WINS (fewest-repeats picked the clean shortcut over the genuine hub chain)\n");
  } else {
    if(rt2_winner_vals_ok(W,m,expg,5)==1){
      emit("C1 GENUINE-WINS (unexpected: hub chain won)\n");
    } else {
      emit("C1 NO-WINNER-OR-OTHER\n");
    }
  }
  return;
}

// ---- C2: first_lit vacuity ----
fn rt2_poison_world(W:[]u8)void {
  ev_teach(W,1000,3,1005);
  ev_teach(W,1005,7,1006);
  ev_teach(W,1006,7,1005);
  ev_teach(W,1005,9,2000);
  ev_teach(W,1000,3,1010);
  ev_teach(W,1010,7,1020);
  ev_teach(W,1020,5,1030);
  ev_teach(W,1030,7,2000);
  return;
}
fn rt2_c2()void {
  emit("=== C2 FIRSTLIT-VACUITY ===\n");
  // C2a: first_lit=s versus first_lit unset on the same poison world.
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  rt2_poison_world(W);
  let Ca:[]u8=rt2_mkC(4,7,2,3,-1,1000);
  let st:[]u8=z_alloc(8);
  set32(st,0,0);
  set32(st,4,0);
  let ansa:i32=invent_try(W,1000,70,2000,0,Ca,st);
  let ma:i32=rt2_find_map(W,1000,70);
  emit("C2a first_lit=s ans=");
  e64(ansa);
  emit("\n");
  if(ma>=0){
    rt2_print_vals(W,ma);
  }
  let Wb:[]u8=z_alloc(110656);
  tnn2_init(Wb);
  rt2_poison_world(Wb);
  let Cb:[]u8=rt2_mkC(4,7,2,3,-1,-1);
  set32(st,0,0);
  set32(st,4,0);
  let ansb:i32=invent_try(Wb,1000,70,2000,0,Cb,st);
  let mb:i32=rt2_find_map(Wb,1000,70);
  emit("C2a first_lit=unset ans=");
  e64(ansb);
  emit("\n");
  if(mb>=0){
    rt2_print_vals(Wb,mb);
  }
  let expc:[]u8=z_alloc(20);
  set32(expc,0,1000);
  set32(expc,4,1010);
  set32(expc,8,1020);
  set32(expc,12,1030);
  set32(expc,16,2000);
  if(ansa==ansb && rt2_winner_vals_ok(W,ma,expc,5)==1 && rt2_winner_vals_ok(Wb,mb,expc,5)==1){
    emit("C2a VACUOUS-OK (first_lit=s constrains nothing beyond unset)\n");
  } else {
    emit("C2a DIVERGENCE (unexpected)\n");
  }
  // C2b: poison-ONLY world with first_lit=s. The stutter chain matches
  // first_lit, so the entry check cannot stop it.
  let W2:[]u8=z_alloc(110656);
  tnn2_init(W2);
  ev_teach(W2,1000,3,1005);
  ev_teach(W2,1005,7,1006);
  ev_teach(W2,1006,7,1005);
  ev_teach(W2,1005,9,2000);
  let C2:[]u8=rt2_mkC(4,7,2,3,-1,1000);
  set32(st,0,0);
  set32(st,4,0);
  let ans2:i32=invent_try(W2,1000,70,2000,0,C2,st);
  let m2:i32=rt2_find_map(W2,1000,70);
  emit("C2b poison-only first_lit=s ans=");
  e64(ans2);
  emit(" check=");
  e64(invent_check(W2,m2,C2));
  emit("\n");
  if(m2>=0){
    rt2_print_vals(W2,m2);
  }
  let expp:[]u8=z_alloc(20);
  set32(expp,0,1000);
  set32(expp,4,1005);
  set32(expp,8,1006);
  set32(expp,12,1005);
  set32(expp,16,2000);
  if(rt2_winner_vals_ok(W2,m2,expp,5)==1){
    emit("C2b POISON-PROMOTED (first_lit enforcement is orthogonal to matching poison)\n");
  } else {
    emit("C2b NO-POISON (unexpected)\n");
  }
  return;
}

// ---- C3: verify-fail backtracking blowup ----
fn rt2_c3_layer(W:[]u8,b:i32,plen:i32)void {
  let k:i32=0;
  while(k<plen){
    let a:i32=0;
    while(a<b){
      let s:i32=1000+k*100+a;
      if(k==0){
        s=1000;
      }
      let bb:i32=0;
      while(bb<b){
        let u:i32=s;
        if(k>0){
          u=1000+k*100+a;
        }
        if(k==0 && a>0){
          bb=b;
        } else {
          ev_teach(W,u,3,1000+(k+1)*100+bb);
          bb=bb+1;
        }
      }
      a=a+1;
    }
    k=k+1;
  }
  return;
}
fn rt2_c3_one(b:i32,plen:i32)void {
  emit("C3 config b=");
  e64(b);
  emit(" plen=");
  e64(plen);
  emit("\n");
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  rt2_c3_layer(W,b,plen);
  let C:[]u8=rt2_mkC(plen,-1,-1,-1,-1,-1);
  let st:[]u8=z_alloc(8);
  set32(st,0,0);
  set32(st,4,0);
  let ans:i32=invent_try(W,1000,70,9999,0,C,st);
  emit("C3 ans=");
  e64(ans);
  emit(" (expect -2: expected unreachable, every candidate verify-fails)\n");
  return;
}
fn rt2_c3()void {
  emit("=== C3 VERIFY-BLOWUP (fixer-deferred exponential, now with per-candidate scratch+verify) ===\n");
  rt2_c3_one(4,4);
  rt2_c3_one(5,5);
  return;
}

// ---- C4: scratch hygiene ----
fn rt2_c4()void {
  emit("=== C4 SCRATCH-HYGIENE (double invent_try, fact-chain stability) ===\n");
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  rt2_c1_world(W);
  let C:[]u8=rt2_mkC(4,7,1,3,9,1000);
  let n0a:i32=rt2_count_facts(W,1000);
  let n0b:i32=rt2_count_facts(W,1010);
  emit("facts-before 1000=");
  e64(n0a);
  emit(" 1010=");
  e64(n0b);
  emit("\n");
  let st:[]u8=z_alloc(8);
  set32(st,0,0);
  set32(st,4,0);
  let a1:i32=invent_try(W,1000,70,2000,0,C,st);
  let n1a:i32=rt2_count_facts(W,1000);
  let n1b:i32=rt2_count_facts(W,1010);
  emit("facts-after-first 1000=");
  e64(n1a);
  emit(" 1010=");
  e64(n1b);
  emit("\n");
  set32(st,0,0);
  set32(st,4,0);
  let a2:i32=invent_try(W,1000,71,2000,0,C,st);
  let n2a:i32=rt2_count_facts(W,1000);
  let n2b:i32=rt2_count_facts(W,1010);
  emit("facts-after-second 1000=");
  e64(n2a);
  emit(" 1010=");
  e64(n2b);
  emit("\n");
  let m1:i32=rt2_find_map(W,1000,70);
  let m2:i32=rt2_find_map(W,1000,71);
  emit("a1=");
  e64(a1);
  emit(" a2=");
  e64(a2);
  emit("\n");
  if(m1>=0){
    rt2_print_vals(W,m1);
  }
  if(m2>=0){
    rt2_print_vals(W,m2);
  }
  let expd:[]u8=z_alloc(20);
  set32(expd,0,1000);
  set32(expd,4,1100);
  set32(expd,8,1200);
  set32(expd,12,1300);
  set32(expd,16,2000);
  if(a1==2000 && a2==2000 && n1a==n0a+1 && n2a==n1a+1 && n0b==n1b && n1b==n2b && rt2_winner_vals_ok(W,m1,expd,5)==1 && rt2_winner_vals_ok(W,m2,expd,5)==1){
    emit("C4 HYGIENE-OK (repeatable; +1 fact per call is the promoted answer fact, no phantom facts, winners identical)\n");
  } else {
    emit("C4 HYGIENE-FAIL\n");
  }
  return;
}

fn main()i32 {
  emit("RT2-H3-START\n");
  emit("invent_on=");
  e64(invent_on());
  emit("\n");
  rt2_c1();
  rt2_c2();
  rt2_c3();
  rt2_c4();
  emit("RT2-H3-END\n");
  return 0;
}

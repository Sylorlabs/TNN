// lc_fc1main.zag -- COMPOSE-LEARNCOMPOSE-1 F-C1/F-C3 battery.
// Fresh M (composition memory); W1, W2, W3, ADV in one process.
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let M:[]u8=z_alloc(16384);
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(41943040);
  // W1: diamond-1, cold (T1).
  w_fc1w1(A);
  c=do_prob(B,c,"W1",A,S,M,30,4,601,1,2,5, 5,7,0,0,-1,0);
  // W2: diamond-2, retrieve+adapt (T2).
  A=z_alloc(8192); S=z_alloc(41943040);
  w_fc1w2(A);
  c=do_prob(B,c,"W2",A,S,M,34,4,603,1,2,3, 3,4,0,1,3,0);
  // W3: fan-in, sim-2 retrieve + DROP_UNMAPPED repair (T3).
  A=z_alloc(8192); S=z_alloc(41943040);
  w_fc1w3(A);
  c=do_prob(B,c,"W3",A,S,M,46,3,605,1,2,9, 9,3,0,2,2,0);
  // ADV: F-C3 adversarial; negative evidence must be recorded.
  A=z_alloc(8192); S=z_alloc(41943040);
  w_fc1adv(A);
  c=do_prob(B,c,"ADV",A,S,M,42,4,608,1,2,3, 3,8,0,2,3,1);
  o_flush(B,c);
  return 0;
}

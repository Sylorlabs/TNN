// lc_blindmain.zag -- COMPOSE-LEARNCOMPOSE-1 blind battery (F-C4).
// Five Q1/Q1b/Q1rev sequences in fresh processes (fresh M each):
// V0 baseline, V1 rels, V2 nodes, V3 kinds, V4 all. The five
// outputs must be byte-identical.
fn blind_seq(B:[]u8,c:i32,v:i32) i32 {
  let M:[]u8=z_alloc(16384);
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(41943040);
  w_bq1(A,v);
  c=do_prob(B,c,"Q1",A,S,M,0,4,bq_s(v,0),bq_kin(v),bq_kout(v),5, 5,7,0,0,-1,0);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_bq1(A,v); w_bq1b(A,v);
  c=do_prob(B,c,"Q1b",A,S,M,0,4,bq_s(v,1),bq_kin(v),bq_kout(v),3, 3,4,0,1,3,0);
  A=z_alloc(8192); S=z_alloc(41943040);
  w_bq1(A,v); w_bq1rev(A,v);
  c=do_prob(B,c,"Q1rev",A,S,M,0,5,bq_s(v,0),bq_kin(v),bq_kout(v),5, 5,7,0,2,2,1);
  return c;
}
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let v:i32=0;
  while(v<5){
    c=o_app(B,c,"VAR="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
    c=blind_seq(B,c,v);
    v=v+1;
  }
  o_flush(B,c);
  return 0;
}

// lc_main.zag -- COMPOSE-LEARNCOMPOSE-1 main battery driver.
// One process; M (composition memory) persists across problems;
// S (thunks/memos/counters) is fresh per problem. Per-problem
// verdicts implement the frozen kill bars (PREREG Section 3).
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let M:[]u8=z_alloc(16384);
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(41943040);
  // Q1: cold diamond.
  w_q1(A);
  c=do_prob(B,c,"Q1",A,S,M,0,4,202,1,2,5, 5,7,0,0,-1,0);
  // Q1b: retrieve.
  A=z_alloc(8192); S=z_alloc(41943040);
  w_q1(A); w_q1b_add(A);
  c=do_prob(B,c,"Q1b",A,S,M,0,4,204,1,2,3, 3,4,0,1,3,0);
  // Q1rev: retrieve + SUBST_FAILED revision.
  A=z_alloc(8192); S=z_alloc(41943040);
  w_q1(A); w_q1rev(A);
  c=do_prob(B,c,"Q1rev",A,S,M,0,5,202,1,2,5, 5,7,0,2,2,1);
  // CHAIN3: cold (sim1 < threshold).
  A=z_alloc(8192); S=z_alloc(41943040);
  w_chain3(A);
  c=do_prob(B,c,"CHAIN3",A,S,M,5,3,301,1,2,7, 7,6,0,0,-1,0);
  // FANIN: sim-2 retrieve + DROP_UNMAPPED repair (amended bars).
  A=z_alloc(8192); S=z_alloc(41943040);
  w_fanin(A);
  c=do_prob(B,c,"FANIN",A,S,M,8,3,401,1,2,9, 9,3,0,2,2,0);
  // PARTIAL: retrieve + TRUNCATE revision.
  A=z_alloc(8192); S=z_alloc(41943040);
  w_q1(A);
  c=do_prob(B,c,"PARTIAL",A,S,M,0,4,202,1,2,3, 3,4,0,2,3,1);
  // Q2: cold + widen.
  A=z_alloc(8192); S=z_alloc(41943040);
  w_q2(A);
  c=do_prob(B,c,"Q2",A,S,M,11,4,202,1,2,5, 5,57,1,0,-1,0);
  // CHAIN10: sim-2 retrieve (misfire) + failed revise + cold (amended).
  A=z_alloc(8192); S=z_alloc(41943040);
  w_chain10(A);
  c=do_prob(B,c,"CHAIN10",A,S,M,20,10,501,1,2,4, 4,108,0,0,-1,0);
  o_flush(B,c);
  return 0;
}

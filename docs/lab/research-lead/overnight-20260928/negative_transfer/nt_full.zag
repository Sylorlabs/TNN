// nt_full.zag -- NEG-TRANSFER-1 (NT1): selective retention under sequential
// contradictory training. Pure Zag. No Python.
//
// Subject: minimal continuing learner, entry-local error-driven evidence
// revision. ML1 = dedicated addressing (treatment); ML0 = overlapping
// address map (negative control). Frozen rules: PREREG.md Section 2.
// Frozen numeric inventory: PREREG.md Section 3. Frozen protocol:
// PREREG.md Section 4.
//
// Output rule (mandatory): dynamic content is formatted into ONE
// preallocated buffer with cursor-returning helpers, then a single
// _zag_raw_syscall write. _zag_print is never used for dynamic content.
//
// Learner arena layout (bytes):
//   0: nentries   4: nevict (capacity)   8: nalias (alias overwrite)
//   12: slots, 48 * 16 bytes: 0:key 1:value 2:sup 3:ref

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- learner ----
fn nt_new()[]u8 { return z_alloc(1024); }
fn sk(L:[]u8,s:i32,f:i32)i32 { return get32(L,12+s*16+f*4); }
fn sp(L:[]u8,s:i32,f:i32,v:i32)void { set32(L,12+s*16+f*4,v); return; }
// address map: arm 0 = ML1 dedicated; arm 1 = ML0 overlapping
fn nt_slot(key:i32,arm:i32)i32 {
  if(arm==0){ return key-100; }
  if(key<124){ return key-100; }
  return key-116;
}
fn nt_find(L:[]u8,key:i32,arm:i32)i32 {
  let s:i32=nt_slot(key,arm);
  if(sk(L,s,0)==key){ return s; }
  return -1;
}
fn nt_predict(L:[]u8,key:i32,arm:i32)i32 {
  let s:i32=nt_find(L,key,arm);
  if(s<0){ return -1; }
  let sup:i32=sk(L,s,2);
  let rf:i32=sk(L,s,3);
  if(sup>rf){ return sk(L,s,1); }
  return -1;
}
fn nt_evict_lowest(L:[]u8)i32 {
  let best:i32=-1;
  let bv:i32=0;
  let s:i32=0;
  while(s<48){
    if(sk(L,s,0)!=0){
      let net:i32=sk(L,s,2)-sk(L,s,3);
      if(best<0){ best=s; bv=net; }
      else { if(net<bv){ best=s; bv=net; } }
    }
    s=s+1;
  }
  return best;
}
fn nt_learn(L:[]u8,key:i32,val:i32,arm:i32)void {
  let s:i32=nt_slot(key,arm);
  let k:i32=sk(L,s,0);
  if(k==key){
    let v:i32=sk(L,s,1);
    if(v==val){ sp(L,s,2,sk(L,s,2)+1); }
    else {
      let r:i32=sk(L,s,3)+1;
      sp(L,s,3,r);
      if(r>sk(L,s,2)){ sp(L,s,1,val); sp(L,s,2,1); sp(L,s,3,0); }
    }
  } else {
    if(k==0){
      let n:i32=get32(L,0);
      if(n>=48){
        let e:i32=nt_evict_lowest(L);
        set32(L,4,get32(L,4)+1);
        s=e;
      } else {
        set32(L,0,n+1);
      }
    } else {
      set32(L,8,get32(L,8)+1);
    }
    sp(L,s,0,key); sp(L,s,1,val); sp(L,s,2,1); sp(L,s,3,0);
  }
  return;
}
// ---- oracle: frozen numeric inventory (PREREG Section 3) ----
fn va(k:i32)i32 {
  let t:i32=k*37+11;
  return 200+(t-(t/64)*64);
}
fn vb(k:i32)i32 {
  let c:i32=0;
  if(k>=100){ if(k<=105){ c=1; } }
  if(c==1){
    let b:i32=va(k)-200+32;
    return 200+(b-(b/64)*64);
  }
  return va(k);
}
fn valof(k:i32,vf:i32)i32 {
  if(vf==0){ return va(k); }
  return vb(k);
}
// ---- protocol ----
fn teach_pass(L:[]u8,set:i32,vf:i32,arm:i32)void {
  let k:i32=0;
  if(set==0){
    k=100;
    while(k<=123){ nt_learn(L,k,valof(k,vf),arm); k=k+1; }
  } else {
    k=100;
    while(k<=111){ nt_learn(L,k,valof(k,vf),arm); k=k+1; }
    k=128;
    while(k<=139){ nt_learn(L,k,valof(k,vf),arm); k=k+1; }
  }
  return;
}
fn probe_acc(L:[]u8,set:i32,vf:i32,arm:i32)i32 {
  let n:i32=0;
  let k:i32=0;
  if(set==0){
    k=100;
    while(k<=123){ if(nt_predict(L,k,arm)==valof(k,vf)){ n=n+1; } k=k+1; }
  } else {
    k=100;
    while(k<=111){ if(nt_predict(L,k,arm)==valof(k,vf)){ n=n+1; } k=k+1; }
    k=128;
    while(k<=139){ if(nt_predict(L,k,arm)==valof(k,vf)){ n=n+1; } k=k+1; }
  }
  return n;
}
// C partition: keys 100..105, correct answer vb
fn probe_c(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=105){ if(nt_predict(L,k,arm)==vb(k)){ n=n+1; } k=k+1; }
  return n;
}
// NC partition: keys 106..111, correct answer va (=vb)
fn probe_nc(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let k:i32=106;
  while(k<=111){ if(nt_predict(L,k,arm)==va(k)){ n=n+1; } k=k+1; }
  return n;
}
// U partition: keys 112..123, correct answer va
fn probe_u(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let k:i32=112;
  while(k<=123){ if(nt_predict(L,k,arm)==va(k)){ n=n+1; } k=k+1; }
  return n;
}
// FORGET: A-keys answering neither the A-correct nor (C) the B-correct value
fn forget_count(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=105){
    let p:i32=nt_predict(L,k,arm);
    if(p!=va(k)){ if(p!=vb(k)){ n=n+1; } }
    k=k+1;
  }
  k=106;
  while(k<=123){
    if(nt_predict(L,k,arm)!=va(k)){ n=n+1; }
    k=k+1;
  }
  return n;
}
// train SET_A/VA to criterion; returns passes (negative = fail-safe hit)
fn train_a(L:[]u8,arm:i32)i32 {
  let consec:i32=0;
  let p:i32=0;
  while(consec<2){
    if(p>=50){ return 0-p; }
    teach_pass(L,0,0,arm);
    p=p+1;
    if(probe_acc(L,0,0,arm)==24){ consec=consec+1; } else { consec=0; }
  }
  return p;
}
// train SET_B/VB to criterion; out[0]=TTC, out[4]=P_C (passes until C correct)
fn train_b(L:[]u8,arm:i32,out:[]u8)i32 {
  let consec:i32=0;
  let p:i32=0;
  let pc:i32=-1;
  while(consec<2){
    if(p>=50){ set32(out,0,0-p); set32(out,4,pc); return 0-p; }
    teach_pass(L,1,1,arm);
    p=p+1;
    if(probe_c(L,arm)==6){ if(pc<0){ pc=p; } }
    if(probe_acc(L,1,1,arm)==24){ consec=consec+1; } else { consec=0; }
  }
  set32(out,0,p);
  set32(out,4,pc);
  return p;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let out:[]u8=z_alloc(8);
  // ---- CONTROL-A (ML1): A learnable in isolation ----
  let L:[]u8=nt_new();
  let tta_c:i32=train_a(L,0);
  let pa_c:i32=probe_acc(L,0,0,0);
  c=o_app(B,c,"NT1 ML1 CTRLA ttc=");
  c=o_i64(B,c,tta_c as i64);
  c=o_app(B,c," acc=");
  c=o_i64(B,c,pa_c as i64);
  c=o_nl(B,c);
  // ---- CONTROL-B (ML1): B learnable in isolation ----
  L=nt_new();
  let ttb_c:i32=train_b(L,0,out);
  let pc_c:i32=get32(out,4);
  let pb_c:i32=probe_acc(L,1,1,0);
  c=o_app(B,c,"NT1 ML1 CTRLB ttc=");
  c=o_i64(B,c,ttb_c as i64);
  c=o_app(B,c," pc=");
  c=o_i64(B,c,pc_c as i64);
  c=o_app(B,c," acc=");
  c=o_i64(B,c,pb_c as i64);
  c=o_nl(B,c);
  // ---- SEQ (ML1): A -> criterion, B -> criterion, retest A ----
  L=nt_new();
  let tta_s:i32=train_a(L,0);
  let pa_s:i32=probe_acc(L,0,0,0);
  let ttb_s:i32=train_b(L,0,out);
  let pc_s:i32=get32(out,4);
  let pb_s:i32=probe_acc(L,1,1,0);
  let c_vb:i32=probe_c(L,0);
  let nc:i32=probe_nc(L,0);
  let uu:i32=probe_u(L,0);
  let fg:i32=forget_count(L,0);
  let ne1:i32=get32(L,4);
  let na1:i32=get32(L,8);
  let nn1:i32=get32(L,0);
  c=o_app(B,c,"NT1 ML1 SEQ ttcA=");
  c=o_i64(B,c,tta_s as i64);
  c=o_app(B,c," accA=");
  c=o_i64(B,c,pa_s as i64);
  c=o_app(B,c," ttcB=");
  c=o_i64(B,c,ttb_s as i64);
  c=o_app(B,c," pcB=");
  c=o_i64(B,c,pc_s as i64);
  c=o_app(B,c," accB=");
  c=o_i64(B,c,pb_s as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"NT1 ML1 RETEST c_vb=");
  c=o_i64(B,c,c_vb as i64);
  c=o_app(B,c," nc=");
  c=o_i64(B,c,nc as i64);
  c=o_app(B,c," u=");
  c=o_i64(B,c,uu as i64);
  c=o_app(B,c," forget=");
  c=o_i64(B,c,fg as i64);
  c=o_app(B,c," nevict=");
  c=o_i64(B,c,ne1 as i64);
  c=o_app(B,c," nalias=");
  c=o_i64(B,c,na1 as i64);
  c=o_app(B,c," nentries=");
  c=o_i64(B,c,nn1 as i64);
  c=o_nl(B,c);
  // ---- ABLATION (ML0): identical SEQ protocol, overlapping addresses ----
  L=nt_new();
  let tta_a:i32=train_a(L,1);
  let ttb_a:i32=train_b(L,1,out);
  let pc_a:i32=get32(out,4);
  let pb_a:i32=probe_acc(L,1,1,1);
  let c_vb_a:i32=probe_c(L,1);
  let nc_a:i32=probe_nc(L,1);
  let uu_a:i32=probe_u(L,1);
  let fg_a:i32=forget_count(L,1);
  let ne0:i32=get32(L,4);
  let na0:i32=get32(L,8);
  let nn0:i32=get32(L,0);
  c=o_app(B,c,"NT1 ML0 ABL ttcA=");
  c=o_i64(B,c,tta_a as i64);
  c=o_app(B,c," ttcB=");
  c=o_i64(B,c,ttb_a as i64);
  c=o_app(B,c," pcB=");
  c=o_i64(B,c,pc_a as i64);
  c=o_app(B,c," accB=");
  c=o_i64(B,c,pb_a as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"NT1 ML0 RETEST c_vb=");
  c=o_i64(B,c,c_vb_a as i64);
  c=o_app(B,c," nc=");
  c=o_i64(B,c,nc_a as i64);
  c=o_app(B,c," u=");
  c=o_i64(B,c,uu_a as i64);
  c=o_app(B,c," forget=");
  c=o_i64(B,c,fg_a as i64);
  c=o_app(B,c," nevict=");
  c=o_i64(B,c,ne0 as i64);
  c=o_app(B,c," nalias=");
  c=o_i64(B,c,na0 as i64);
  c=o_app(B,c," nentries=");
  c=o_i64(B,c,nn0 as i64);
  c=o_nl(B,c);
  // ---- frozen kill bars ----
  let k1:i32=0;
  if(tta_c>0){ if(tta_c<=50){ if(ttb_c>0){ if(ttb_c<=50){
    if(pa_c==24){ if(pb_c==24){ k1=1; } }
  } } } }
  let k2:i32=0;
  if(nc==6){ if(uu==12){ k2=1; } }
  let k3:i32=0;
  if(c_vb>=5){ if(fg==0){ k3=1; } }
  let k4:i32=0;
  if(pc_s>0){ if(pc_c>0){ if(pc_s-pc_c<=6){ k4=1; } } }
  let k5:i32=0;
  if(uu_a<12){ k5=1; } else { if(c_vb_a<5){ k5=1; } else { if(fg_a>0){ k5=1; } } }
  c=o_app(B,c,"NT1 K1=");
  c=o_i64(B,c,k1 as i64);
  c=o_app(B,c," K2=");
  c=o_i64(B,c,k2 as i64);
  c=o_app(B,c," K3=");
  c=o_i64(B,c,k3 as i64);
  c=o_app(B,c," K4=");
  c=o_i64(B,c,k4 as i64);
  c=o_app(B,c," K5=");
  c=o_i64(B,c,k5 as i64);
  c=o_nl(B,c);
  let vd:i32=0;
  if(k1==1){ if(k2==1){ if(k3==1){ if(k4==1){ if(k5==1){ vd=1; } } } } }
  c=o_app(B,c,"NT1 VERDICT=");
  if(vd==1){ c=o_app(B,c,"PASS"); }
  else {
    if(k1==0){ c=o_app(B,c,"VOID"); }
    else { if(k5==0){ c=o_app(B,c,"INCONCLUSIVE"); } else { c=o_app(B,c,"FAIL"); } }
  }
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

// ivwc_casebias.zag -- case-level bias signals for phantom-type
// errors in the IVWC hybrid. Verbatim copy of IVWC-SCOREBIAS's
// world/belief/composer/stepper/verifier/seeds (sealed pairs
// bit-identical; K3/K4 anchors verify). The scorebias ceiling:
// s=3 (phantom, P=50) shares bucket 1 with four genuine P=33
// positives, and no per-bucket bias fixes s=3 first. This wave
// tests three frozen case-level bias variants, all trained on
// the 24 train cases only, as in-program arms on the shared
// label ge = (eff >= T_pred). Each variant refines the frozen
// UCB bucket bias with a train-fit per-case residual table:
//   V-UCB    (vv=0): m_b + isqrt(S_b/(n_b-1)) (anchor)
//   V-CONDC  (vv=1): + mean resid on (bucket, preff) cell
//   V-AGREE  (vv=2): + mean resid on multi-policy agreement bin
//   V-STRUCT (vv=3): + mean resid on (bucket, believed-bumps) cell
// plus shuffled-residual ablations vv=4..6 (rotate-by-7).
// Each variant: adjV = P - biasV(case), verdict PASS iff
// adjV > TV (strict margin; TV = mean adjV over the sealed
// batch, learner-computed, no world data).
// Also: a preregistered train feature audit (TA/SA lines) and a
// harness-side sealed-label per-(bucket,preff)-cell diagnostic
// (fenced in SCORING; never learner-visible).
// Anchors: OF (P >= Tpred), X3 (frozen bucket table),
// HYB (C >= Thyb), MG (C > Thyb).
// Pure Zag, deterministic, integer arithmetic only.

// ---------- frozen parameters (identical to IVWC-EXPAND3) ----------
const CW:i32=20;
const EBUD:i32=36;
const PLANMAX:i32=64;
const NTRAIN:i32=24;
const NSEAL:i32=12;
const RECW:i32=41;
const RECM:i32=16;
const RECC:i32=24;
const EREC:i32=128;
const NSHIFT:i32=3;

// ---------- helpers (u8-backed cells, little-endian; copied verbatim) ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get8(b:[]u8, off:i32)i32 {
  return b[off] as i32;
}
fn set8(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
// Deterministic LCG, small modulus (no i32 overflow).
fn lcg_next(st:[]u8)i32 {
  let s:i32=get32(st,0)%65536;
  s=(s*25173+13849)%65536;
  set32(st,0,s);
  return s;
}
// Integer floor square root (for the V-UCB bias estimator).
fn isqrt(x:i32)i32 {
  let r:i32=0;
  while((r+1)*(r+1)<=x){ r=r+1; }
  return r;
}

// ===== WORLD =====
// Verbatim copies from IVWC-EXPAND3 (world_gen, belief_gen, step
// physics, true-world stepper). The learner never calls these.
fn world_gen(seed:i32, wp:i32, world_buf:[]u8, world_off:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<CW){
    set8(world_buf,world_off+c,0);
    set8(world_buf,world_off+CW+c,0);
    c=c+1;
  }
  c=1;
  while(c<CW-1){
    if(lcg_next(st)%100 < wp){ set8(world_buf,world_off+c,1); }
    c=c+1;
  }
  c=0;
  while(c<CW){
    if(get8(world_buf,world_off+c)==0){
      if(lcg_next(st)%100 < 25){ set8(world_buf,world_off+CW+c,1); }
    }
    c=c+1;
  }
  let s:i32=2+(lcg_next(st)%16);
  let done:i32=0;
  while(done==0){
    if(get8(world_buf,world_off+s)==0){ done=1; }
    else {
      s=s+1;
      if(s>=CW){ s=0; }
    }
  }
  set8(world_buf,world_off+2*CW,s);
  return;
}
fn belief_gen(seed:i32, world_buf:[]u8, world_off:i32, bb:[]u8, boff:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let start:i32=get8(world_buf,world_off+2*CW);
  let c:i32=0;
  while(c<CW){
    let w:i32=get8(world_buf,world_off+c);
    if(c!=start){
      if(lcg_next(st)%100 < 12){ w=1-w; }
    }
    set8(bb,boff+c,w);
    c=c+1;
  }
  c=0;
  while(c<CW){
    let it:i32=get8(world_buf,world_off+CW+c);
    if(it==1){
      if(lcg_next(st)%100 < 15){ it=0; }
    } else {
      if(get8(world_buf,world_off+c)==0){
        if(lcg_next(st)%100 < 18){ it=1; }
      }
    }
    set8(bb,boff+CW+c,it);
    c=c+1;
  }
  set8(bb,boff+2*CW,start);
  return;
}
fn w_left(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos>0){
    if(get8(world_buf,world_off+pos-1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos-1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_right(world_buf:[]u8, world_off:i32, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let bump:i32=1;
  if(pos<CW-1){
    if(get8(world_buf,world_off+pos+1)==0){ bump=0; }
  }
  if(bump==0){ set32(st,0,pos+1); }
  else { set32(st,8,get32(st,8)+1); }
  return bump;
}
fn w_gather(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8)i32 {
  let pos:i32=get32(st,0);
  let hit:i32=0;
  if(get8(world_buf,world_off+CW+pos)==1){
    if(get8(got,pos)==0){ hit=1; }
  }
  if(hit==1){
    set8(got,pos,1);
    set32(st,4,get32(st,4)+1);
  } else {
    set32(st,12,get32(st,12)+1);
  }
  return hit;
}
fn w_step(world_buf:[]u8, world_off:i32, got:[]u8, st:[]u8, a:i32)i32 {
  if(a==0){
    if(w_left(world_buf,world_off,st)==1){ return 1; }
    return 0;
  }
  if(a==1){
    if(w_right(world_buf,world_off,st)==1){ return 2; }
    return 0;
  }
  if(w_gather(world_buf,world_off,got,st)==1){ return 3; }
  return 4;
}
// True-world stepper. Called ONLY in the sealed SCORING block
// (harness), never by the learner. wc counts true executions.
fn world_execute(world_buf:[]u8, world_off:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32, eb:[]u8, eoff:i32, wc:[]u8)void {
  set32(wc,0,get32(wc,0)+1);
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(world_buf,world_off+2*CW));
  let i:i32=0;
  while(i<L){
    let pos:i32=get32(st,0);
    let oc:i32=w_step(world_buf,world_off,got,st,get8(pb,poff+i));
    set8(eb,eoff+2*i,pos);
    set8(eb,eoff+2*i+1,oc);
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}

// ===== LEARNER =====
// Everything in this section touches beliefs and plans only.
// No true-world array token appears below (checked by audit A7).
fn lc_blocked(bb:[]u8, boff:i32, lo:i32, hi:i32)i32 {
  let k:i32=lo;
  let r:i32=0;
  while(k<=hi){
    if(get8(bb,boff+k)==1){ r=1; }
    k=k+1;
  }
  return r;
}
fn lc_leg(pb:[]u8, poff:i32, at:i32, pcs:[]u8)void {
  let pos:i32=get32(pcs,0);
  let tgt:i32=get32(pcs,4);
  while(pos<tgt){
    if(at<PLANMAX){ set8(pb,poff+at,1); at=at+1; }
    pos=pos+1;
  }
  while(pos>tgt){
    if(at<PLANMAX){ set8(pb,poff+at,0); at=at+1; }
    pos=pos-1;
  }
  if(at<PLANMAX){ set8(pb,poff+at,2); at=at+1; }
  set32(pcs,0,pos);
  set32(pcs,8,at);
  return;
}
// NAV+GATHER composition from beliefs only (verbatim expand3).
// meta cells: gathers@0, plan_len@4, raw_conf@8, bucket@12.
fn learner_compose(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=0;
  while(c<CW){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c+1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Reverse-scan re-derivation: identical policy, opposite item order.
// Independent code path for the Arm B agreement check.
fn learner_compose_rev(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let pcs:[]u8=z_alloc(12);
  set32(pcs,0,get8(bb,boff+2*CW));
  set32(pcs,8,0);
  let c:i32=CW-1;
  while(c>=0){
    if(get8(bb,boff+CW+c)==1){
      let pos:i32=get32(pcs,0);
      let lo:i32=pos;
      let hi:i32=c;
      if(lo>hi){
        let t:i32=lo;
        lo=hi;
        hi=t;
      }
      if(lc_blocked(bb,boff,lo,hi)==0){
        set32(pcs,4,c);
        lc_leg(pb,poff,get32(pcs,8),pcs);
      }
    }
    c=c-1;
  }
  let at:i32=get32(pcs,8);
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Nearest-first re-derivation: greedy policy, independent path.
// Repeatedly visits the nearest believed item whose believed
// interval from the current pos is clear. Deterministic
// (ties -> smaller cell). Flags hoisted, nesting shallow.
fn learner_compose_nn(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32)void {
  let taken:[]u8=z_alloc(CW);
  let pos:i32=get8(bb,boff+2*CW);
  let at:i32=0;
  let pcs:[]u8=z_alloc(12);
  let more:i32=1;
  while(more==1){
    let best:i32=-1;
    let bd:i32=1000000;
    let c:i32=0;
    while(c<CW){
      let tk:i32=get8(taken,c);
      let it:i32=get8(bb,boff+CW+c);
      let cand:i32=0;
      if(tk==0){ cand=1; }
      if(cand==1){
        if(it==0){ cand=0; }
      }
      if(cand==1){
        let lo:i32=pos;
        let hi:i32=c;
        if(lo>hi){
          let t:i32=lo;
          lo=hi;
          hi=t;
        }
        let blk:i32=lc_blocked(bb,boff,lo,hi);
        if(blk==0){
          let d:i32=pos-c;
          if(d<0){ d=0-d; }
          let better:i32=0;
          if(d<bd){ better=1; }
          if(better==0){
            if(d==bd){
              if(best<0){ better=1; }
              else {
                if(c<best){ better=1; }
              }
            }
          }
          if(better==1){ bd=d; best=c; }
        }
      }
      c=c+1;
    }
    if(best<0){ more=0; }
    else {
      set8(taken,best,1);
      set32(pcs,0,pos);
      set32(pcs,4,best);
      set32(pcs,8,at);
      lc_leg(pb,poff,at,pcs);
      pos=get32(pcs,0);
      at=get32(pcs,8);
    }
  }
  let L:i32=at;
  if(L>EBUD){ L=EBUD; }
  let g:i32=0;
  let i:i32=0;
  while(i<L){
    if(get8(pb,poff+i)==2){ g=g+1; }
    i=i+1;
  }
  let raw:i32=0;
  if(L>0){ raw=(100*g)/L; }
  let b:i32=0;
  if(g>=2){ b=2; }
  if(g>=4){ b=3; }
  if(g==1){ b=1; }
  set32(mb,moff,g);
  set32(mb,moff+4,L);
  set32(mb,moff+8,raw);
  set32(mb,moff+12,b);
  return;
}
// Internal-model consequence prediction: steps the committed plan
// through the BELIEVED corridor (same physics shape as the true
// stepper, but beliefs only). No true-consequence observation.
// cons cells: collected@0, energy@4, bumps@8, wasted@12, final@16,
// plan_len@20.
fn belief_execute(bbuf:[]u8, boff:i32, pb:[]u8, poff:i32, L:i32, cb:[]u8, coff:i32)void {
  let got:[]u8=z_alloc(CW);
  let st:[]u8=z_alloc(16);
  set32(st,0,get8(bbuf,boff+2*CW));
  let i:i32=0;
  while(i<L){
    let oc:i32=w_step(bbuf,boff,got,st,get8(pb,poff+i));
    i=i+1;
  }
  set32(cb,coff,get32(st,4));
  set32(cb,coff+4,L);
  set32(cb,coff+8,get32(st,8));
  set32(cb,coff+12,get32(st,12));
  set32(cb,coff+16,get32(st,0));
  set32(cb,coff+20,L);
  return;
}
// Belief scrambler (ablation): independent Fisher-Yates on believed
// walls and believed items (fixed seed); marginals preserved,
// wall/item mapping to truth broken. Start cell kept open.
fn belief_scramble(bb:[]u8, boff:i32, sb:[]u8, soff:i32, seed:i32)void {
  let st:[]u8=z_alloc(4);
  set32(st,0,seed);
  let c:i32=0;
  while(c<RECW){
    set8(sb,soff+c,get8(bb,boff+c));
    c=c+1;
  }
  c=CW-1;
  while(c>0){
    let j:i32=lcg_next(st)%(c+1);
    let t:i32=get8(sb,soff+c);
    set8(sb,soff+c,get8(sb,soff+j));
    set8(sb,soff+j,t);
    c=c-1;
  }
  c=CW-1;
  while(c>0){
    let j:i32=lcg_next(st)%(c+1);
    let t:i32=get8(sb,soff+CW+c);
    set8(sb,soff+CW+c,get8(sb,soff+CW+j));
    set8(sb,soff+CW+j,t);
    c=c-1;
  }
  let srt:i32=get8(bb,boff+2*CW);
  set8(sb,soff+srt,0);
  return;
}
// Extract gather cells from a plan (walk from start), insertion-sort
// them, return the count. Flat control flow (no deep nesting).
fn gather_cells(pb:[]u8, poff:i32, L:i32, start:i32, out:[]u8, ooff:i32)i32 {
  let pos:i32=start;
  let n:i32=0;
  let i:i32=0;
  while(i<L){
    let a:i32=get8(pb,poff+i);
    if(a==0){ pos=pos-1; }
    else {
      if(a==1){ pos=pos+1; }
      else {
        set8(out,ooff+n,pos);
        n=n+1;
      }
    }
    i=i+1;
  }
  let k:i32=1;
  while(k<n){
    let v:i32=get8(out,ooff+k);
    let j:i32=k-1;
    let go:i32=1;
    while(go==1){
      let stop:i32=0;
      if(j<0){ stop=1; }
      if(stop==0){
        if(get8(out,ooff+j)<=v){ stop=1; }
      }
      if(stop==1){ go=0; }
      else {
        set8(out,ooff+j+1,get8(out,ooff+j));
        j=j-1;
      }
    }
    set8(out,ooff+j+1,v);
    k=k+1;
  }
  return n;
}

// Learner-owned self-check table. vb cells (4-byte): bsum[4]@0,
// bcnt[4]@16, bmean[4]@32, T@48. Inputs are consequence-derived
// (bucket, eff) pairs only; no world truth reaches this function.
// T is learner-computed from train consequences (no researcher-set
// constant anywhere in the verifier path). Empty bucket -> mean -1.
fn verifier_train(bkt:[]u8, eff:[]u8, n:i32, vb:[]u8)void {
  let b:i32=0;
  while(b<4){
    set32(vb,4*b,0);
    set32(vb,16+4*b,0);
    set32(vb,32+4*b,-1);
    b=b+1;
  }
  let tot:i32=0;
  let i:i32=0;
  while(i<n){
    let bb:i32=get32(bkt,4*i);
    let e:i32=get32(eff,4*i);
    if(bb>=0){
      if(bb<4){
        set32(vb,4*bb,get32(vb,4*bb)+e);
        set32(vb,16+4*bb,get32(vb,16+4*bb)+1);
      }
    }
    tot=tot+e;
    i=i+1;
  }
  b=0;
  while(b<4){
    let c:i32=get32(vb,16+4*b);
    if(c>0){ set32(vb,32+4*b,get32(vb,4*b)/c); }
    b=b+1;
  }
  let T:i32=0;
  if(n>0){ T=tot/n; }
  set32(vb,48,T);
  return;
}
// Pre-execution self-verdict: 1 = PASS, 0 = FAIL. FAIL when the
// bucket has no train data (conservative: no data, no pass) or its
// train mean sits below the learner's own threshold T.
fn verifier_check(vb:[]u8, bucket:i32)i32 {
  if(bucket<0){ return 0; }
  if(bucket>=4){ return 0; }
  if(get32(vb,16+4*bucket)==0){ return 0; }
  if(get32(vb,32+4*bucket)>=get32(vb,48)){ return 1; }
  return 0;
}
// ===== MAIN =====
// ivwc_casebias_retry.zag -- second attempt at case-level bias for
// phantom-type errors in the IVWC hybrid.
// Verbatim world/belief/composer/stepper/verifier/seeds from
// IVWC-CASEBIAS (sealed pairs bit-identical; K3/K4 anchors verify).
// New machinery:
//   V-UCB  (vv=0): frozen UCB bucket bias (anchor, recomputed).
//   V-SENS (vv=1): UCB + train-fit MEAN-CENTERED excess residual on a
//                  counterfactual-perturbation fragility bin.
//                  F(case) = max_i (P - P_{-i}): leave-one-out removal
//                  of each gathered believed item + recomposition.
//                  Bins: F=0 / 1..25 / >25. Mean-centering guarantees a
//                  constant-F world reproduces UCB exactly.
//   V-SENSsh (vv=2): shuffled-residual twin (rotate-by-7).
//   D1/D2 (fenced harness diagnostics in SCORING only, never
//   learner-visible): D1 counts nphantom(s) = planned gathers at cells
//   where the TRUE world has no item, applies B = UCB_b + 40 when
//   nphantom > 0, verdict (adjV > mean adjV). D2 rotates the phantom
//   indicator by 7. Tests whether a PERFECT phantom-conditioned bias
//   can succeed under the transductive mean bar.
// Anchors re-scored in-program: OF, X3, HYB, MG.
// Pure Zag, deterministic, integer arithmetic only.

// Case-level fragility via leave-one-out recomposition.
// Caller-owned scratch (tmpb/tmpp/tmpm/gout). Returns
// max_i (P - P_{-i}) floored at 0. Belief + plan only;
// zero world cost (learner-side).
fn case_fragility(bb:[]u8, boff:i32, pb:[]u8, poff:i32, mb:[]u8, moff:i32, tmpb:[]u8, tmpp:[]u8, tmpm:[]u8, gout:[]u8)i32 {
  let g:i32=get32(mb,moff);
  let L:i32=get32(mb,moff+4);
  let P:i32=0;
  if(L>0){ P=(100*g)/L; }
  let start:i32=get8(bb,boff+2*CW);
  let n:i32=gather_cells(pb,poff,L,start,gout,0);
  let F:i32=0;
  let i:i32=0;
  while(i<n){
    let c:i32=0;
    while(c<RECW){ set8(tmpb,c,get8(bb,boff+c)); c=c+1; }
    let cell:i32=get8(gout,i);
    set8(tmpb,CW+cell,0);
    learner_compose(tmpb,0,tmpp,0,tmpm,0);
    let g2:i32=get32(tmpm,0);
    let L2:i32=get32(tmpm,4);
    let P2:i32=0;
    if(L2>0){ P2=(100*g2)/L2; }
    let drop:i32=P-P2;
    if(drop>F){ F=drop; }
    i=i+1;
  }
  return F;
}
// Fragility bin: 0 -> F=0, 1 -> 1..25, 2 -> >25.
fn fbin(F:i32)i32 {
  if(F<=0){ return 0; }
  if(F<=25){ return 1; }
  return 2;
}
// ===== MAIN =====
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  at=ob_app(ob,at,"IVWCCBR-BEGIN\n");
  // Train buffers.
  let wtrain:[]u8=z_alloc(NTRAIN*RECW);
  let btrain:[]u8=z_alloc(NTRAIN*RECW);
  let ptrain:[]u8=z_alloc(NTRAIN*PLANMAX);
  let mtrain:[]u8=z_alloc(NTRAIN*RECM);
  let ctrain:[]u8=z_alloc(NTRAIN*RECC);
  let tbkt:[]u8=z_alloc(NTRAIN*4);
  let teff:[]u8=z_alloc(NTRAIN*4);
  let preff_tr:[]u8=z_alloc(NTRAIN*4);
  let ftr:[]u8=z_alloc(NTRAIN*4);
  // UCB tables.
  let biassum:[]u8=z_alloc(16);
  let biascnt:[]u8=z_alloc(16);
  let bias:[]u8=z_alloc(16);
  let bsq:[]u8=z_alloc(16);
  let bucb:[]u8=z_alloc(16);
  // SENS residual tables (3 bins) + shuffled twins.
  let s4sum:[]u8=z_alloc(12);
  let s4cnt:[]u8=z_alloc(12);
  let s4exc:[]u8=z_alloc(12);
  let s4shsum:[]u8=z_alloc(12);
  let s4shct:[]u8=z_alloc(12);
  let s4shexc:[]u8=z_alloc(12);
  // Sealed buffers.
  let wseal:[]u8=z_alloc(NSEAL*RECW);
  let bseal:[]u8=z_alloc(NSEAL*RECW);
  let pseal:[]u8=z_alloc(NSEAL*PLANMAX);
  let mseal:[]u8=z_alloc(NSEAL*RECM);
  let cseal:[]u8=z_alloc(NSEAL*RECC);
  let preff:[]u8=z_alloc(NSEAL*4);
  let seffA:[]u8=z_alloc(NSEAL*4);
  let fse:[]u8=z_alloc(NSEAL*4);
  let sL:[]u8=z_alloc(NSEAL*4);
  let sstart:[]u8=z_alloc(NSEAL*4);
  // Variant machinery: vv 0=UCB 1=SENS 2=SENSsh.
  let cbias1:[]u8=z_alloc(NSEAL*4);
  let cbias2:[]u8=z_alloc(NSEAL*4);
  let adjv:[]u8=z_alloc(144);
  let verv:[]u8=z_alloc(144);
  let totv:[]u8=z_alloc(12);
  let tvar:[]u8=z_alloc(12);
  let acc_v:[]u8=z_alloc(36);
  // Fenced diagnostic D1/D2.
  let nph:[]u8=z_alloc(NSEAL*4);
  let d1b:[]u8=z_alloc(NSEAL*4);
  let d1adj:[]u8=z_alloc(NSEAL*4);
  let d1ver:[]u8=z_alloc(NSEAL*4);
  let acc_d1:[]u8=z_alloc(12);
  let d2b:[]u8=z_alloc(NSEAL*4);
  let d2adj:[]u8=z_alloc(NSEAL*4);
  let d2ver:[]u8=z_alloc(NSEAL*4);
  let acc_d2:[]u8=z_alloc(12);
  // Anchors.
  let adj:[]u8=z_alloc(NSEAL*4);
  let verA:[]u8=z_alloc(NSEAL*4);
  let verX:[]u8=z_alloc(NSEAL*4);
  let verH:[]u8=z_alloc(NSEAL*4);
  let verMG:[]u8=z_alloc(NSEAL*4);
  let acc_of:[]u8=z_alloc(12);
  let acc_x3:[]u8=z_alloc(12);
  let acc_hy:[]u8=z_alloc(12);
  let acc_mg:[]u8=z_alloc(12);
  let tpr:[]u8=z_alloc(12);
  let thy:[]u8=z_alloc(12);
  // Misc.
  let vb:[]u8=z_alloc(64);
  let wc:[]u8=z_alloc(4);
  let etmp:[]u8=z_alloc(EREC);
  let ctmp:[]u8=z_alloc(RECC);
  let tmpb:[]u8=z_alloc(RECW);
  let tmpp:[]u8=z_alloc(PLANMAX);
  let tmpm:[]u8=z_alloc(RECM);
  let gout:[]u8=z_alloc(CW);
  let gout2:[]u8=z_alloc(CW);
  let sbkt:[]u8=z_alloc(NTRAIN*4);
  let seff:[]u8=z_alloc(NTRAIN*4);
  let k1:i32=1;
  // Phase 1: train SETUP (harness; wp=15; seeds verbatim).
  let t:i32=0;
  while(t<NTRAIN){
    world_gen(7919*t+13, 15, wtrain, t*RECW);
    belief_gen(104729*t+7, wtrain, t*RECW, btrain, t*RECW);
    t=t+1;
  }
  // Phase 2: train COMMIT (learner; beliefs only) + fragility.
  let wcb0:i32=get32(wc,0);
  t=0;
  while(t<NTRAIN){
    learner_compose(btrain, t*RECW, ptrain, t*PLANMAX, mtrain, t*RECM);
    set32(ftr,4*t,case_fragility(btrain,t*RECW,ptrain,t*PLANMAX,mtrain,t*RECM,tmpb,tmpp,tmpm,gout));
    t=t+1;
  }
  if(get32(wc,0)==wcb0){
    at=ob_app(ob,at,"K1T-STRUCT-PASS world_calls=0 after train COMMIT+FRAG\n");
  } else {
    k1=0;
    at=ob_app(ob,at,"K1T-STRUCT-FAIL\n");
  }
  // Phase 2b: train PREFF (learner). preff = 100*g/L from composer
  // metrics (identical to belief_execute-derived preff: the plan was
  // composed on the belief, so believed collected = g). K3/K4 anchors
  // verify equality.
  wcb0=get32(wc,0);
  t=0;
  while(t<NTRAIN){
    let tg:i32=get32(mtrain,t*RECM);
    let tL:i32=get32(mtrain,t*RECM+4);
    let tp:i32=0;
    if(tL>0){ tp=(100*tg)/tL; }
    set32(preff_tr,4*t,tp);
    t=t+1;
  }
  if(get32(wc,0)==wcb0){
    at=ob_app(ob,at,"K1P-STRUCT-PASS world_calls unchanged after train PREFF\n");
  } else {
    k1=0;
    at=ob_app(ob,at,"K1P-STRUCT-FAIL\n");
  }
  // Phase 3: train CONSEQ (harness).
  t=0;
  while(t<NTRAIN){
    world_execute(wtrain, t*RECW, ptrain, t*PLANMAX, get32(mtrain,t*RECM+4), ctrain, t*RECC, etmp, 0, wc);
    t=t+1;
  }
  // Phase 4: learner LEARN. (bucket, eff) pairs; UCB; SENS tables.
  t=0;
  while(t<NTRAIN){
    let bk:i32=get32(mtrain,t*RECM+12);
    let tc:i32=get32(ctrain,t*RECC);
    let te:i32=get32(ctrain,t*RECC+4);
    let tf:i32=0;
    if(te>0){ tf=(100*tc)/te; }
    set32(tbkt,4*t,bk);
    set32(teff,4*t,tf);
    t=t+1;
  }
  verifier_train(tbkt, teff, NTRAIN, vb);
  let b:i32=0;
  while(b<4){
    set32(biassum,4*b,0);
    set32(biascnt,4*b,0);
    set32(bsq,4*b,0);
    b=b+1;
  }
  t=0;
  while(t<NTRAIN){
    let bk2:i32=get32(tbkt,4*t);
    let d:i32=get32(preff_tr,4*t)-get32(teff,4*t);
    if(bk2>=0){
      if(bk2<4){
        set32(biassum,4*bk2,get32(biassum,4*bk2)+d);
        set32(biascnt,4*bk2,get32(biascnt,4*bk2)+1);
      }
    }
    t=t+1;
  }
  b=0;
  while(b<4){
    let bb:i32=0;
    if(get32(biascnt,4*b)>0){ bb=get32(biassum,4*b)/get32(biascnt,4*b); }
    set32(bias,4*b,bb);
    b=b+1;
  }
  t=0;
  while(t<NTRAIN){
    let bk5:i32=get32(tbkt,4*t);
    if(bk5>=0){
      if(bk5<4){
        let mb5:i32=get32(bias,4*bk5);
        let d5:i32=get32(preff_tr,4*t)-get32(teff,4*t);
        let e5:i32=d5-mb5;
        set32(bsq,4*bk5,get32(bsq,4*bk5)+e5*e5);
      }
    }
    t=t+1;
  }
  b=0;
  while(b<4){
    let mb6:i32=get32(bias,4*b);
    let nb6:i32=get32(biascnt,4*b);
    let ub:i32=0;
    if(nb6>0){ ub=mb6; }
    if(nb6>1){ ub=mb6+isqrt(get32(bsq,4*b)/(nb6-1)); }
    set32(bucb,4*b,ub);
    b=b+1;
  }
  // SENS residual tables: resid_t = d_t - UCB[bkt]; mean-centered
  // excess per fragility bin; shuffled twin rotates resid by 7.
  let fb:i32=0;
  while(fb<3){
    set32(s4sum,4*fb,0);
    set32(s4cnt,4*fb,0);
    set32(s4shsum,4*fb,0);
    set32(s4shct,4*fb,0);
    fb=fb+1;
  }
  let rsum_all:i32=0;
  t=0;
  while(t<NTRAIN){
    let bk7:i32=get32(tbkt,4*t);
    let r7:i32=get32(preff_tr,4*t)-get32(teff,4*t)-get32(bucb,4*bk7);
    rsum_all=rsum_all+r7;
    let bin7:i32=fbin(get32(ftr,4*t));
    set32(s4sum,4*bin7,get32(s4sum,4*bin7)+r7);
    set32(s4cnt,4*bin7,get32(s4cnt,4*bin7)+1);
    let t7:i32=t+7;
    if(t7>=NTRAIN){ t7=t7-NTRAIN; }
    let bk7s:i32=get32(tbkt,4*t7);
    let r7s:i32=get32(preff_tr,4*t7)-get32(teff,4*t7)-get32(bucb,4*bk7s);
    let bin7s:i32=fbin(get32(ftr,4*t));
    set32(s4shsum,4*bin7s,get32(s4shsum,4*bin7s)+r7s);
    set32(s4shct,4*bin7s,get32(s4shct,4*bin7s)+1);
    t=t+1;
  }
  let rmean_all:i32=rsum_all/NTRAIN;
  fb=0;
  while(fb<3){
    let ex:i32=0;
    if(get32(s4cnt,4*fb)>0){ ex=get32(s4sum,4*fb)/get32(s4cnt,4*fb)-rmean_all; }
    set32(s4exc,4*fb,ex);
    let exs:i32=0;
    if(get32(s4shct,4*fb)>0){ exs=get32(s4shsum,4*fb)/get32(s4shct,4*fb)-rmean_all; }
    set32(s4shexc,4*fb,exs);
    fb=fb+1;
  }
  // R4: SENS table audit.
  fb=0;
  while(fb<3){
    at=ob_app(ob,at,"R4 bin=");
    at=ob_i32(ob,at,fb);
    at=ob_app(ob,at," cnt=");
    at=ob_i32(ob,at,get32(s4cnt,4*fb));
    at=ob_app(ob,at," exc=");
    at=ob_i32(ob,at,get32(s4exc,4*fb));
    at=ob_app(ob,at," shexc=");
    at=ob_i32(ob,at,get32(s4shexc,4*fb));
    at=ob_nl(ob,at);
    fb=fb+1;
  }
  at=ob_app(ob,at,"R4 rmean_all=");
  at=ob_i32(ob,at,rmean_all);
  at=ob_nl(ob,at);
  // FA-train: fragility audit (learner-visible only).
  at=ob_app(ob,at,"FAUDIT t bkt preff eff d F\n");
  t=0;
  while(t<NTRAIN){
    at=ob_app(ob,at,"FA t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," bkt=");
    at=ob_i32(ob,at,get32(tbkt,4*t));
    at=ob_app(ob,at," preff=");
    at=ob_i32(ob,at,get32(preff_tr,4*t));
    at=ob_app(ob,at," eff=");
    at=ob_i32(ob,at,get32(teff,4*t));
    at=ob_app(ob,at," d=");
    at=ob_i32(ob,at,get32(preff_tr,4*t)-get32(teff,4*t));
    at=ob_app(ob,at," F=");
    at=ob_i32(ob,at,get32(ftr,4*t));
    at=ob_nl(ob,at);
    t=t+1;
  }
  // Phase 5: sealed SHIFT LOOP. sh=0..2, wp=15/30/45.
  let sh:i32=0;
  while(sh<NSHIFT){
    let wp:i32=15+15*sh;
    // a. SEALED SETUP (harness; seeds verbatim).
    let s:i32=0;
    while(s<NSEAL){
      let cid:i32=100+s;
      world_gen(7919*cid+13, wp, wseal, s*RECW);
      belief_gen(104729*cid+7, wseal, s*RECW, bseal, s*RECW);
      s=s+1;
    }
    // b. sealed COMMIT (learner) + fragility. No world calls.
    wcb0=get32(wc,0);
    s=0;
    while(s<NSEAL){
      learner_compose(bseal, s*RECW, pseal, s*PLANMAX, mseal, s*RECM);
      set32(fse,4*s,case_fragility(bseal,s*RECW,pseal,s*PLANMAX,mseal,s*RECM,tmpb,tmpp,tmpm,gout));
      let sg:i32=get32(mseal,s*RECM);
      let sLl:i32=get32(mseal,s*RECM+4);
      let sq:i32=0;
      if(sLl>0){ sq=(100*sg)/sLl; }
      set32(preff,4*s,sq);
      set32(sL,4*s,sLl);
      set32(sstart,4*s,get8(bseal,s*RECW+2*CW));
      // Case-level biases.
      let sbk:i32=get32(mseal,s*RECM+12);
      let sbin:i32=fbin(get32(fse,4*s));
      let cs1:i32=get32(bucb,4*sbk)+get32(s4exc,4*sbin);
      set32(cbias1,4*s,cs1);
      let cs2:i32=get32(bucb,4*sbk)+get32(s4shexc,4*sbin);
      set32(cbias2,4*s,cs2);
      set32(adjv,4*s,sq-get32(bucb,4*sbk));
      set32(adjv,48+4*s,sq-cs1);
      set32(adjv,96+4*s,sq-cs2);
      set32(adj,4*s,sq-get32(bias,4*sbk));
      s=s+1;
    }
    if(get32(wc,0)==wcb0){
      at=ob_app(ob,at,"K1S-STRUCT-PASS sh=");
      at=ob_i32(ob,at,sh);
      at=ob_nl(ob,at);
    } else {
      k1=0;
      at=ob_app(ob,at,"K1S-STRUCT-FAIL sh=");
      at=ob_i32(ob,at,sh);
      at=ob_nl(ob,at);
    }
    // SA: sealed fragility audit (learner-visible only).
    at=ob_app(ob,at,"SAUDIT s bkt preff F\n");
    s=0;
    while(s<NSEAL){
      at=ob_app(ob,at,"SA s=");
      at=ob_i32(ob,at,s);
      at=ob_app(ob,at," bkt=");
      at=ob_i32(ob,at,get32(mseal,s*RECM+12));
      at=ob_app(ob,at," preff=");
      at=ob_i32(ob,at,get32(preff,4*s));
      at=ob_app(ob,at," F=");
      at=ob_i32(ob,at,get32(fse,4*s));
      at=ob_nl(ob,at);
      s=s+1;
    }
    // Learner-computed bars (no world data).
    let totp:i32=0;
    let totc:i32=0;
    let vv2:i32=0;
    while(vv2<3){
      set32(totv,4*vv2,0);
      vv2=vv2+1;
    }
    s=0;
    while(s<NSEAL){
      totp=totp+get32(preff,4*s);
      totc=totc+get32(adj,4*s);
      let vv3:i32=0;
      while(vv3<3){
        set32(totv,4*vv3,get32(totv,4*vv3)+get32(adjv,vv3*48+4*s));
        vv3=vv3+1;
      }
      s=s+1;
    }
    let Tpred:i32=totp/NSEAL;
    let Thyb:i32=totc/NSEAL;
    set32(tpr,4*sh,Tpred);
    set32(thy,4*sh,Thyb);
    let vv4:i32=0;
    while(vv4<3){
      set32(tvar,4*vv4,get32(totv,4*vv4)/NSEAL);
      vv4=vv4+1;
    }
    s=0;
    while(s<NSEAL){
      let sbk2:i32=get32(mseal,s*RECM+12);
      let va:i32=0;
      if(get32(preff,4*s)>=Tpred){ va=1; }
      set32(verA,4*s,va);
      set32(verX,4*s,verifier_check(vb,sbk2));
      let vh:i32=0;
      if(get32(adj,4*s)>=Thyb){ vh=1; }
      set32(verH,4*s,vh);
      let vm:i32=0;
      if(get32(adj,4*s)>Thyb){ vm=1; }
      set32(verMG,4*s,vm);
      let vv5:i32=0;
      while(vv5<3){
        let vvx:i32=0;
        if(get32(adjv,vv5*48+4*s)>get32(tvar,4*vv5)){ vvx=1; }
        set32(verv,vv5*48+4*s,vvx);
        vv5=vv5+1;
      }
      s=s+1;
    }
    // c. SCORING (harness). Sealed true-world pass; labels only here.
    // Single world_execute per case (WC-FINAL=60).
    let ahn:i32=0;
    let aon:i32=0;
    let axn:i32=0;
    let amn:i32=0;
    s=0;
    while(s<NSEAL){
      let sL2:i32=get32(sL,4*s);
      world_execute(wseal, s*RECW, pseal, s*PLANMAX, sL2, cseal, s*RECC, etmp, 0, wc);
      let sc2:i32=get32(cseal,s*RECC);
      let su2:i32=get32(cseal,s*RECC+4);
      let seff:i32=0;
      if(su2>0){ seff=(100*sc2)/su2; }
      set32(seffA,4*s,seff);
      let ge:i32=0;
      if(seff>=Tpred){ ge=1; }
      if(get32(verH,4*s)==ge){ ahn=ahn+1; }
      if(get32(verA,4*s)==ge){ aon=aon+1; }
      if(get32(verX,4*s)==ge){ axn=axn+1; }
      if(get32(verMG,4*s)==ge){ amn=amn+1; }
      let vv6:i32=0;
      while(vv6<3){
        if(get32(verv,vv6*48+4*s)==ge){
          set32(acc_v,vv6*12+4*sh,get32(acc_v,vv6*12+4*sh)+1);
        }
        vv6=vv6+1;
      }
      // FENCED HARNESS DIAGNOSTIC D1/D2 (not learner-visible).
      // nphantom(s): planned gathers at cells where the true world
      // has no item. D1 biases phantom cases by +40 under the same
      // mean-bar verdict; D2 rotates the indicator by 7 (ablation).
      let np:i32=0;
      let ng:i32=gather_cells(pseal,s*PLANMAX,sL2,get32(sstart,4*s),gout2,0);
      let gi:i32=0;
      while(gi<ng){
        let cell:i32=get8(gout2,gi);
        if(get8(wseal,s*RECW+CW+cell)==0){ np=np+1; }
        gi=gi+1;
      }
      set32(nph,4*s,np);
      s=s+1;
    }
    let totd1:i32=0;
    let totd2:i32=0;
    s=0;
    while(s<NSEAL){
      let sbk4:i32=get32(mseal,s*RECM+12);
      let b1:i32=get32(bucb,4*sbk4);
      if(get32(nph,4*s)>0){ b1=b1+40; }
      set32(d1b,4*s,b1);
      let s2b:i32=s+7;
      if(s2b>=NSEAL){ s2b=s2b-NSEAL; }
      let b2:i32=get32(bucb,4*sbk4);
      if(get32(nph,4*s2b)>0){ b2=b2+40; }
      set32(d2b,4*s,b2);
      set32(d1adj,4*s,get32(preff,4*s)-b1);
      set32(d2adj,4*s,get32(preff,4*s)-b2);
      totd1=totd1+get32(d1adj,4*s);
      totd2=totd2+get32(d2adj,4*s);
      s=s+1;
    }
    let td1:i32=totd1/NSEAL;
    let td2:i32=totd2/NSEAL;
    s=0;
    while(s<NSEAL){
      let seff3:i32=get32(seffA,4*s);
      let ge3:i32=0;
      if(seff3>=Tpred){ ge3=1; }
      let v1:i32=0;
      if(get32(d1adj,4*s)>td1){ v1=1; }
      set32(d1ver,4*s,v1);
      let v2:i32=0;
      if(get32(d2adj,4*s)>td2){ v2=1; }
      set32(d2ver,4*s,v2);
      if(v1==ge3){ set32(acc_d1,4*sh,get32(acc_d1,4*sh)+1); }
      if(v2==ge3){ set32(acc_d2,4*sh,get32(acc_d2,4*sh)+1); }
      at=ob_app(ob,at,"V s=");
      at=ob_i32(ob,at,s);
      at=ob_app(ob,at," bkt=");
      at=ob_i32(ob,at,get32(mseal,s*RECM+12));
      at=ob_app(ob,at," preff=");
      at=ob_i32(ob,at,get32(preff,4*s));
      at=ob_app(ob,at," F=");
      at=ob_i32(ob,at,get32(fse,4*s));
      at=ob_app(ob,at," nph=");
      at=ob_i32(ob,at,get32(nph,4*s));
      at=ob_app(ob,at," v0=");
      at=ob_i32(ob,at,get32(verv,4*s));
      at=ob_app(ob,at," v1=");
      at=ob_i32(ob,at,get32(verv,48+4*s));
      at=ob_app(ob,at," v2=");
      at=ob_i32(ob,at,get32(verv,96+4*s));
      at=ob_app(ob,at," d1=");
      at=ob_i32(ob,at,v1);
      at=ob_app(ob,at," d2=");
      at=ob_i32(ob,at,v2);
      at=ob_app(ob,at," eff=");
      at=ob_i32(ob,at,seff3);
      at=ob_app(ob,at," ge=");
      at=ob_i32(ob,at,ge3);
      at=ob_nl(ob,at);
      s=s+1;
    }
    // END FENCED DIAGNOSTIC.
    set32(acc_of,4*sh,aon);
    set32(acc_x3,4*sh,axn);
    set32(acc_hy,4*sh,ahn);
    set32(acc_mg,4*sh,amn);
    at=ob_app(ob,at,"ACC sh=");
    at=ob_i32(ob,at,sh);
    at=ob_app(ob,at," of=");
    at=ob_i32(ob,at,aon);
    at=ob_app(ob,at," x3=");
    at=ob_i32(ob,at,axn);
    at=ob_app(ob,at," hyb=");
    at=ob_i32(ob,at,ahn);
    at=ob_app(ob,at," mg=");
    at=ob_i32(ob,at,amn);
    at=ob_app(ob,at," v0=");
    at=ob_i32(ob,at,get32(acc_v,4*sh));
    at=ob_app(ob,at," v1=");
    at=ob_i32(ob,at,get32(acc_v,12+4*sh));
    at=ob_app(ob,at," v2=");
    at=ob_i32(ob,at,get32(acc_v,24+4*sh));
    at=ob_app(ob,at," d1=");
    at=ob_i32(ob,at,get32(acc_d1,4*sh));
    at=ob_app(ob,at," d2=");
    at=ob_i32(ob,at,get32(acc_d2,4*sh));
    at=ob_nl(ob,at);
    sh=sh+1;
  }
  // WC final audit.
  at=ob_app(ob,at,"WC-FINAL=");
  at=ob_i32(ob,at,get32(wc,0));
  at=ob_nl(ob,at);
  // Kill-bar summary.
  at=ob_app(ob,at,"K1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," K3of15=");
  at=ob_i32(ob,at,get32(acc_of,0));
  at=ob_app(ob,at," K3x315=");
  at=ob_i32(ob,at,get32(acc_x3,0));
  at=ob_app(ob,at," K4of45=");
  at=ob_i32(ob,at,get32(acc_of,8));
  at=ob_app(ob,at," K4x345=");
  at=ob_i32(ob,at,get32(acc_x3,8));
  at=ob_app(ob,at," K5v115=");
  at=ob_i32(ob,at,get32(acc_v,0));
  at=ob_app(ob,at," K6v115ge11=");
  at=ob_i32(ob,at,get32(acc_v,0));
  at=ob_app(ob,at," K7d115le11=");
  at=ob_i32(ob,at,get32(acc_d1,0));
  at=ob_app(ob,at," K8v145ge10=");
  at=ob_i32(ob,at,get32(acc_v,8));
  at=ob_app(ob,at," K10d145ge11=");
  at=ob_i32(ob,at,get32(acc_d1,8));
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"IVWCCBR-END\n");
  let out:[]u8=ob[0..at];
  _zag_print(out);
  return 0;
}

// altexp.zag -- H-CAUSALEXP1 alternative-explanation attacks.
// Pure Zag. No Python anywhere.
// Prereg: PREREG_ALTEXP.md (committed BEFORE this file existed).
//
// Same causal machinery as the builder's causalexp.zag (predict, sim_seq,
// world_step, passive script, hypothesis store, elimination, planning).
// ONLY the experiment-selection rule is varied, per SEL_MODE stamped at
// build time:
//   0 = control: max-split, tie-break shorter then lexicographic
//   1 = attack 1A: fixed first candidate seq=[0], guard kept
//   2 = attack 1B: first candidate with split>=2 in enumeration order
//   4 = attack 4 T-rev: max-split, tie-break longer then reverse lexicographic
//   5 = attack 4 T-rand: max-split, seeded LCG choice among achievers,
//       seeds 1..8 (deterministic)
// Mode 0 additionally runs GENCHECK: converged mask vs true world on all
// 216 length-3 sequences from all 4 states (864 pairs never executed in
// the active loop).

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn SEL_MODE()i32 { return @@MODE@@; }

// ============ hypothesis store ============
fn H_STRIDE()i32 { return 16; }
fn LOG_BASE()i32 { return 48; }
fn LOG_STRIDE()i32 { return 20; }
fn h_mask(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()); }
fn h_mask_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE(), v); return; }
fn h_st(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()+4); }
fn h_st_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE()+4, v); return; }
fn h_ok(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()+8); }
fn h_ok_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE()+8, v); return; }
fn h_tot(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()+12); }
fn h_tot_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE()+12, v); return; }
fn log_set(W:[]u8,e:i32,f:i32,v:i32)void { set32(W, LOG_BASE()+e*LOG_STRIDE()+f*4, v); return; }
fn log_get(W:[]u8,e:i32,f:i32)i32 { return get32(W, LOG_BASE()+e*LOG_STRIDE()+f*4); }

fn emit_edges(mask:i32)void {
  if(mask==1){emit("X2Y");}
  else if(mask==2){emit("Y2X");}
  else {emit("NONE");}
  return;
}
fn emit_seq(a:i32,b:i32,len:i32)void {
  emit("[");
  e64(a);
  if(len>=2){emit(","); e64(b);}
  emit("]");
  return;
}

// ============ causal mechanics ============
fn predict(mask:i32, x:i32, y:i32, a:i32, out:[]u8)void {
  let nx:i32=x;
  let ny:i32=y;
  if(a==1){
    if((mask&2)==0){nx=1;}
    if((mask&1)==0){ny=1;}
    let k:i32=0;
    while(k<2){
      if((mask&1)!=0){ny=nx;}
      if((mask&2)!=0){nx=ny;}
      k=k+1;
    }
  } else if(a==2){
    nx=0;
    if((mask&1)!=0){ny=nx;}
  } else if(a==3){
    nx=1;
    if((mask&1)!=0){ny=nx;}
  } else if(a==4){
    ny=0;
    if((mask&2)!=0){nx=ny;}
  } else if(a==5){
    ny=1;
    if((mask&2)!=0){nx=ny;}
  }
  out[0]=nx as u8;
  out[1]=ny as u8;
  return;
}

fn sim_seq(mask:i32, x:i32, y:i32, s0:i32, s1:i32, s2:i32, len:i32, out:[]u8)void {
  let cx:i32=x;
  let cy:i32=y;
  let tmp:[]u8=z_alloc(2);
  predict(mask, cx, cy, s0, tmp);
  cx=tmp[0] as i32; cy=tmp[1] as i32;
  if(len>=2){
    predict(mask, cx, cy, s1, tmp);
    cx=tmp[0] as i32; cy=tmp[1] as i32;
  }
  if(len>=3){
    predict(mask, cx, cy, s2, tmp);
    cx=tmp[0] as i32; cy=tmp[1] as i32;
  }
  out[0]=cx as u8;
  out[1]=cy as u8;
  return;
}

fn true_mask(wid:i32)i32 {
  if(wid==2){return 2;}
  return 1;
}
fn world_step(wid:i32, x:i32, y:i32, a:i32, out:[]u8)void {
  predict(true_mask(wid), x, y, a, out);
  return;
}

// ============ main ============
fn main()i32 {
  let mode:i32=SEL_MODE();
  let seed:i32=1;
  let seed_max:i32=1;
  if(mode==5){seed_max=8;}
  while(seed<=seed_max){
    if(mode==5){emit("SEED "); e64(seed); emit("\n");}
    let wid:i32=1;
    while(wid<=2){
      let W:[]u8=z_alloc(256);
      let masks:[]u8=z_alloc(3);
      masks[0]=1; masks[1]=2; masks[2]=0;
      let pscript:[]u8=z_alloc(6);
      pscript[0]=0; pscript[1]=1; pscript[2]=0; pscript[3]=1; pscript[4]=1; pscript[5]=0;
      let lcg:i64=(seed as i64)*1000+(wid as i64);
      emit("WORLD "); e64(wid); emit("\n");
      // ---- passive phase (identical to builder) ----
      let sx:i32=0;
      let sy:i32=0;
      let tmp:[]u8=z_alloc(2);
      let e:i32=0;
      while(e<6){
        let a:i32=pscript[e] as i32;
        world_step(wid, sx, sy, a, tmp);
        let nx:i32=tmp[0] as i32;
        let ny:i32=tmp[1] as i32;
        log_set(W,e,0,sx); log_set(W,e,1,sy); log_set(W,e,2,a);
        log_set(W,e,3,nx); log_set(W,e,4,ny);
        emit("PASSIVE ("); e64(sx); emit(","); e64(sy);
        emit(")|"); e64(a);
        emit(" -> ("); e64(nx); emit(","); e64(ny); emit(")\n");
        sx=nx; sy=ny;
        e=e+1;
      }
      // ---- hypothesis generation (identical to builder) ----
      let h:i32=0;
      while(h<3){
        let m:i32=masks[h] as i32;
        h_mask_set(W,h,m);
        let ok:i32=0;
        let q:[]u8=z_alloc(2);
        let k:i32=0;
        while(k<6){
          predict(m, log_get(W,k,0), log_get(W,k,1), log_get(W,k,2), q);
          if((q[0] as i32)==log_get(W,k,3) && (q[1] as i32)==log_get(W,k,4)){
            ok=ok+1;
          }
          k=k+1;
        }
        h_ok_set(W,h,ok);
        h_tot_set(W,h,6);
        if(ok==6){h_st_set(W,h,0);} else {h_st_set(W,h,1);}
        emit("PASSIVE-CHECK hypo="); e64(h); emit(" edges=");
        emit_edges(m);
        emit(" ev="); e64(ok); emit("/6\n");
        h=h+1;
      }
      let h2:i32=0;
      while(h2<3){
        emit("HYPO id="); e64(h2); emit(" edges=");
        emit_edges(h_mask(W,h2));
        emit(" status=");
        if(h_st(W,h2)==0){emit("LIVE");} else {emit("ELIMINATED");}
        emit(" ev="); e64(h_ok(W,h2)); emit("/"); e64(h_tot(W,h2)); emit("\n");
        h2=h2+1;
      }
      // ---- active loop (selection rule varies by mode) ----
      let round:i32=0;
      let go:i32=1;
      while(go==1){
        let live:i32=0;
        let hc:i32=0;
        while(hc<3){
          if(h_st(W,hc)==0){live=live+1;}
          hc=hc+1;
        }
        if(live<=1){go=0;}
        if(round>=4){go=0;}
        if(go==0){break;}
        round=round+1;
        emit("ROUND "); e64(round);
        emit(" state=("); e64(sx); emit(","); e64(sy);
        emit(") live="); e64(live); emit("\n");
        // enumerate candidates into arrays, emit CAND audit lines
        let ca:[]u8=z_alloc(42*4);
        let cb:[]u8=z_alloc(42*4);
        let cl:[]u8=z_alloc(42*4);
        let cs:[]u8=z_alloc(42*4);
        let ci:i32=0;
        let a:i32=0;
        while(a<6){
          let b:i32=-1;
          while(b<6){
            let len:i32=1;
            if(b>=0){len=2;}
            let p0x:i32=-1; let p0y:i32=-1;
            let p1x:i32=-1; let p1y:i32=-1;
            let p2x:i32=-1; let p2y:i32=-1;
            let n:i32=0;
            let hh:i32=0;
            while(hh<3){
              if(h_st(W,hh)==0){
                let qq:[]u8=z_alloc(2);
                sim_seq(h_mask(W,hh), sx, sy, a, b, 0, len, qq);
                if(n==0){p0x=qq[0] as i32; p0y=qq[1] as i32;}
                else if(n==1){p1x=qq[0] as i32; p1y=qq[1] as i32;}
                else {p2x=qq[0] as i32; p2y=qq[1] as i32;}
                n=n+1;
              }
              hh=hh+1;
            }
            let d:i32=1;
            if(n>=2 && (p1x!=p0x || p1y!=p0y)){d=2;}
            if(n>=3 && (p2x!=p0x || p2y!=p0y) && (p2x!=p1x || p2y!=p1y)){d=3;}
            emit("CAND seq="); emit_seq(a,b,len);
            emit(" split="); e64(d); emit("\n");
            set32(ca,ci*4,a); set32(cb,ci*4,b);
            set32(cl,ci*4,len); set32(cs,ci*4,d);
            ci=ci+1;
            b=b+1;
          }
          a=a+1;
        }
        // ---- selection dispatch ----
        let best_split:i32=-1;
        let best_len:i32=9;
        let best_a:i32=9;
        let best_b:i32=9;
        if(mode==0){
          let i:i32=0;
          while(i<42){
            let d:i32=get32(cs,i*4); let ln:i32=get32(cl,i*4);
            let aa:i32=get32(ca,i*4); let bb:i32=get32(cb,i*4);
            let better:i32=0;
            if(d>best_split){better=1;}
            else if(d==best_split){
              if(ln<best_len){better=1;}
              else if(ln==best_len){
                if(aa<best_a){better=1;}
                else if(aa==best_a && bb<best_b){better=1;}
              }
            }
            if(better==1){best_split=d; best_len=ln; best_a=aa; best_b=bb;}
            i=i+1;
          }
        } else if(mode==1){
          best_a=0; best_b=-1; best_len=1;
          let i:i32=0;
          while(i<42){
            if(get32(ca,i*4)==0 && get32(cb,i*4)==-1){
              best_split=get32(cs,i*4);
            }
            i=i+1;
          }
        } else if(mode==2){
          let i:i32=0;
          let done:i32=0;
          while(i<42){
            if(done==0 && get32(cs,i*4)>=2){
              best_split=get32(cs,i*4); best_len=get32(cl,i*4);
              best_a=get32(ca,i*4); best_b=get32(cb,i*4);
              done=1;
            }
            i=i+1;
          }
        } else if(mode==4){
          best_len=-1; best_a=-9; best_b=-9;
          let i:i32=0;
          while(i<42){
            let d:i32=get32(cs,i*4); let ln:i32=get32(cl,i*4);
            let aa:i32=get32(ca,i*4); let bb:i32=get32(cb,i*4);
            let better:i32=0;
            if(d>best_split){better=1;}
            else if(d==best_split){
              if(ln>best_len){better=1;}
              else if(ln==best_len){
                if(aa>best_a){better=1;}
                else if(aa==best_a && bb>best_b){better=1;}
              }
            }
            if(better==1){best_split=d; best_len=ln; best_a=aa; best_b=bb;}
            i=i+1;
          }
        } else if(mode==5){
          let i:i32=0;
          while(i<42){
            let d:i32=get32(cs,i*4);
            if(d>best_split){best_split=d;}
            i=i+1;
          }
          let cnt:i32=0;
          i=0;
          while(i<42){
            if(get32(cs,i*4)==best_split){cnt=cnt+1;}
            i=i+1;
          }
          lcg=(lcg*1103515245+12345)%2147483648;
          let pick:i32=(lcg%(cnt as i64)) as i32;
          let seen:i32=0;
          i=0;
          while(i<42){
            if(get32(cs,i*4)==best_split){
              if(seen==pick){
                best_len=get32(cl,i*4); best_a=get32(ca,i*4); best_b=get32(cb,i*4);
              }
              seen=seen+1;
            }
            i=i+1;
          }
          emit("TIEBREAK-RAND achievers="); e64(cnt);
          emit(" pick="); e64(pick); emit("\n");
        }
        // PRED lines for the selected experiment
        let hp:i32=0;
        while(hp<3){
          if(h_st(W,hp)==0){
            let qp:[]u8=z_alloc(2);
            sim_seq(h_mask(W,hp), sx, sy, best_a, best_b, 0, best_len, qp);
            emit("PRED id="); e64(hp); emit(" seq=");
            emit_seq(best_a,best_b,best_len);
            emit(" -> ("); e64(qp[0] as i32); emit(",");
            e64(qp[1] as i32); emit(")\n");
          }
          hp=hp+1;
        }
        emit("SELECT seq="); emit_seq(best_a,best_b,best_len);
        emit(" split="); e64(best_split); emit("\n");
        if(best_split<2){
          emit("NO-DISCRIMINATING-EXPERIMENT\n");
          break;
        }
        // EXEC in the true world
        let ex:i32=sx;
        let ey:i32=sy;
        let qe:[]u8=z_alloc(2);
        world_step(wid, ex, ey, best_a, qe);
        ex=qe[0] as i32; ey=qe[1] as i32;
        if(best_len==2){
          world_step(wid, ex, ey, best_b, qe);
          ex=qe[0] as i32; ey=qe[1] as i32;
        }
        emit("EXEC seq="); emit_seq(best_a,best_b,best_len);
        emit(" -> ("); e64(ex); emit(","); e64(ey); emit(")\n");
        // eliminate mismatching hypotheses
        let he:i32=0;
        while(he<3){
          if(h_st(W,he)==0){
            let qm:[]u8=z_alloc(2);
            sim_seq(h_mask(W,he), sx, sy, best_a, best_b, 0, best_len, qm);
            let qx:i32=qm[0] as i32;
            let qy:i32=qm[1] as i32;
            if(qx!=ex || qy!=ey){
              h_st_set(W,he,1);
              emit("ELIM id="); e64(he);
              emit(" predicted=("); e64(qx); emit(","); e64(qy);
              emit(") observed=("); e64(ex); emit(","); e64(ey); emit(")\n");
            }
          }
          he=he+1;
        }
        sx=ex; sy=ey;
      }
      // converged hypothesis
      let cid:i32=-1;
      let cm:i32=0;
      let hf:i32=0;
      while(hf<3){
        if(h_st(W,hf)==0){cid=hf; cm=h_mask(W,hf);}
        hf=hf+1;
      }
      emit("CONVERGED id="); e64(cid); emit(" edges=");
      emit_edges(cm); emit("\n");
      // ---- planning phase (identical to builder) ----
      if(sx!=1 || sy!=1){
        let qs:[]u8=z_alloc(2);
        world_step(wid, sx, sy, 1, qs);
        sx=qs[0] as i32; sy=qs[1] as i32;
      }
      emit("SETUP state=("); e64(sx); emit(","); e64(sy); emit(")\n");
      let plan_len:i32=0;
      let plan_a:i32=0;
      let plan_b:i32=0;
      let plan_c:i32=0;
      let found:i32=0;
      let pl:i32=1;
      while(pl<=3){
        let pa:i32=0;
        while(pa<6){
          let pb:i32=0;
          while(pb<6){
            let pc:i32=0;
            while(pc<6){
              let use:i32=0;
              if(pl==1 && pb==0 && pc==0){use=1;}
              if(pl==2 && pc==0){use=1;}
              if(pl==3){use=1;}
              if(use==1){
                let qp2:[]u8=z_alloc(2);
                sim_seq(cm, 1, 1, pa, pb, pc, pl, qp2);
                if((qp2[0] as i32)==0 && (qp2[1] as i32)==0){
                  if(found==0){
                    plan_len=pl; plan_a=pa; plan_b=pb; plan_c=pc; found=1;
                  }
                }
              }
              pc=pc+1;
            }
            pb=pb+1;
          }
          pa=pa+1;
        }
        pl=pl+1;
      }
      emit("PLAN seq=[");
      e64(plan_a);
      if(plan_len>=2){emit(","); e64(plan_b);}
      if(plan_len>=3){emit(","); e64(plan_c);}
      emit("]\n");
      let px:i32=1;
      let py:i32=1;
      let qx2:[]u8=z_alloc(2);
      if(plan_len>=1){
        world_step(wid, px, py, plan_a, qx2);
        px=qx2[0] as i32; py=qx2[1] as i32;
      }
      if(plan_len>=2){
        world_step(wid, px, py, plan_b, qx2);
        px=qx2[0] as i32; py=qx2[1] as i32;
      }
      if(plan_len>=3){
        world_step(wid, px, py, plan_c, qx2);
        px=qx2[0] as i32; py=qx2[1] as i32;
      }
      emit("PLAN-EXEC -> ("); e64(px); emit(","); e64(py); emit(")\n");
      if(px==0 && py==0){
        emit("PLAN-OK goal=(0,0)\n");
      } else {
        emit("PLAN-FAIL\n");
      }
      // ---- GENCHECK (mode 0 only): converged model vs true world ----
      // ---- on 864 unseen (state, len-3-seq) pairs ----
      if(mode==0){
        let mm:i32=0;
        let gx:i32=0;
        while(gx<2){
          let gy:i32=0;
          while(gy<2){
            let s0:i32=0;
            while(s0<6){
              let s1:i32=0;
              while(s1<6){
                let s2:i32=0;
                while(s2<6){
                  let q1:[]u8=z_alloc(2);
                  let q2:[]u8=z_alloc(2);
                  sim_seq(cm, gx, gy, s0, s1, s2, 3, q1);
                  sim_seq(true_mask(wid), gx, gy, s0, s1, s2, 3, q2);
                  if((q1[0] as i32)!=(q2[0] as i32) || (q1[1] as i32)!=(q2[1] as i32)){
                    mm=mm+1;
                  }
                  s2=s2+1;
                }
                s1=s1+1;
              }
              s0=s0+1;
            }
            gy=gy+1;
          }
          gx=gx+1;
        }
        emit("GENCHECK mismatches="); e64(mm); emit("/864\n");
      }
      emit("WORLD-DONE "); e64(wid); emit("\n");
      wid=wid+1;
    }
    seed=seed+1;
  }
  return 0;
}

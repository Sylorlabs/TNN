// altexp_bf.zag -- Attack 3: pure exhaustive search baseline for H-CAUSALEXP1.
// Pure Zag. No Python anywhere.
// Prereg: PREREG_ALTEXP.md, variant BF1.
//
// Fixed enumeration order (a=0..5, b=-1..5). Execute each candidate
// unconditionally in the true world, eliminate mismatching hypotheses,
// stop at 1 or fewer live hypotheses or after 42 trials. Counts sequence
// executions (trials) to convergence. Worlds: wid 1 (mask 1), 2 (mask 2),
// 3 (mask 0, added for completeness).

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

fn H_STRIDE()i32 { return 16; }
fn LOG_BASE()i32 { return 48; }
fn LOG_STRIDE()i32 { return 20; }
fn h_mask(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()); }
fn h_mask_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE(), v); return; }
fn h_st(W:[]u8,i:i32)i32 { return get32(W, i*H_STRIDE()+4); }
fn h_st_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE()+4, v); return; }
fn h_ok_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE()+8, v); return; }
fn h_tot_set(W:[]u8,i:i32,v:i32)void { set32(W, i*H_STRIDE()+12, v); return; }
fn log_set(W:[]u8,e:i32,f:i32,v:i32)void { set32(W, LOG_BASE()+e*LOG_STRIDE()+f*4, v); return; }
fn log_get(W:[]u8,e:i32,f:i32)i32 { return get32(W, LOG_BASE()+e*LOG_STRIDE()+f*4); }

fn emit_edges(mask:i32)void {
  if(mask==1){emit("X2Y");}
  else if(mask==2){emit("Y2X");}
  else {emit("NONE");}
  return;
}
fn emit_seq(a:i32,b:i32,len:i32)void {
  emit("[");
  e64(a);
  if(len>=2){emit(","); e64(b);}
  emit("]");
  return;
}

fn predict(mask:i32, x:i32, y:i32, a:i32, out:[]u8)void {
  let nx:i32=x;
  let ny:i32=y;
  if(a==1){
    if((mask&2)==0){nx=1;}
    if((mask&1)==0){ny=1;}
    let k:i32=0;
    while(k<2){
      if((mask&1)!=0){ny=nx;}
      if((mask&2)!=0){nx=ny;}
      k=k+1;
    }
  } else if(a==2){
    nx=0;
    if((mask&1)!=0){ny=nx;}
  } else if(a==3){
    nx=1;
    if((mask&1)!=0){ny=nx;}
  } else if(a==4){
    ny=0;
    if((mask&2)!=0){nx=ny;}
  } else if(a==5){
    ny=1;
    if((mask&2)!=0){nx=ny;}
  }
  out[0]=nx as u8;
  out[1]=ny as u8;
  return;
}

fn sim_seq(mask:i32, x:i32, y:i32, s0:i32, s1:i32, s2:i32, len:i32, out:[]u8)void {
  let cx:i32=x;
  let cy:i32=y;
  let tmp:[]u8=z_alloc(2);
  predict(mask, cx, cy, s0, tmp);
  cx=tmp[0] as i32; cy=tmp[1] as i32;
  if(len>=2){
    predict(mask, cx, cy, s1, tmp);
    cx=tmp[0] as i32; cy=tmp[1] as i32;
  }
  if(len>=3){
    predict(mask, cx, cy, s2, tmp);
    cx=tmp[0] as i32; cy=tmp[1] as i32;
  }
  out[0]=cx as u8;
  out[1]=cy as u8;
  return;
}

fn true_mask(wid:i32)i32 {
  if(wid==2){return 2;}
  if(wid==3){return 0;}
  return 1;
}
fn world_step(wid:i32, x:i32, y:i32, a:i32, out:[]u8)void {
  predict(true_mask(wid), x, y, a, out);
  return;
}

fn live_count(W:[]u8)i32 {
  let live:i32=0;
  let hc:i32=0;
  while(hc<3){
    if(h_st(W,hc)==0){live=live+1;}
    hc=hc+1;
  }
  return live;
}

fn main()i32 {
  let wid:i32=1;
  while(wid<=3){
    let W:[]u8=z_alloc(256);
    let masks:[]u8=z_alloc(3);
    masks[0]=1; masks[1]=2; masks[2]=0;
    let pscript:[]u8=z_alloc(6);
    pscript[0]=0; pscript[1]=1; pscript[2]=0; pscript[3]=1; pscript[4]=1; pscript[5]=0;
    emit("WORLD "); e64(wid); emit(" true="); emit_edges(true_mask(wid)); emit("\n");
    // ---- passive phase (identical to builder) ----
    let sx:i32=0;
    let sy:i32=0;
    let tmp:[]u8=z_alloc(2);
    let e:i32=0;
    while(e<6){
      let a:i32=pscript[e] as i32;
      world_step(wid, sx, sy, a, tmp);
      let nx:i32=tmp[0] as i32;
      let ny:i32=tmp[1] as i32;
      log_set(W,e,0,sx); log_set(W,e,1,sy); log_set(W,e,2,a);
      log_set(W,e,3,nx); log_set(W,e,4,ny);
      sx=nx; sy=ny;
      e=e+1;
    }
    let h:i32=0;
    while(h<3){
      let m:i32=masks[h] as i32;
      h_mask_set(W,h,m);
      let ok:i32=0;
      let q:[]u8=z_alloc(2);
      let k:i32=0;
      while(k<6){
        predict(m, log_get(W,k,0), log_get(W,k,1), log_get(W,k,2), q);
        if((q[0] as i32)==log_get(W,k,3) && (q[1] as i32)==log_get(W,k,4)){
          ok=ok+1;
        }
        k=k+1;
      }
      h_ok_set(W,h,ok);
      h_tot_set(W,h,6);
      if(ok==6){h_st_set(W,h,0);} else {h_st_set(W,h,1);}
      h=h+1;
    }
    // ---- brute-force trial loop ----
    let t:i32=0;
    let trials:i32=0;
    let go:i32=1;
    while(go==1){
      if(live_count(W)<=1){go=0;}
      if(t>=42){go=0;}
      if(go==0){break;}
      let a:i32=t/7;
      let b:i32=(t%7)-1;
      let len:i32=1;
      if(b>=0){len=2;}
      emit("TRIAL n="); e64(trials+1); emit(" seq="); emit_seq(a,b,len);
      emit(" state=("); e64(sx); emit(","); e64(sy);
      emit(") live="); e64(live_count(W)); emit("\n");
      let ex:i32=sx;
      let ey:i32=sy;
      let qe:[]u8=z_alloc(2);
      world_step(wid, ex, ey, a, qe);
      ex=qe[0] as i32; ey=qe[1] as i32;
      if(len==2){
        world_step(wid, ex, ey, b, qe);
        ex=qe[0] as i32; ey=qe[1] as i32;
      }
      let he:i32=0;
      while(he<3){
        if(h_st(W,he)==0){
          let qm:[]u8=z_alloc(2);
          sim_seq(h_mask(W,he), sx, sy, a, b, 0, len, qm);
          if((qm[0] as i32)!=ex || (qm[1] as i32)!=ey){
            h_st_set(W,he,1);
            emit("ELIM id="); e64(he); emit("\n");
          }
        }
        he=he+1;
      }
      sx=ex; sy=ey;
      trials=trials+1; t=t+1;
    }
    if(live_count(W)>1){
      emit("BF-EXHAUSTED\n");
    }
    emit("BF-TRIALS "); e64(trials); emit("\n");
    let cid:i32=-1;
    let cm:i32=0;
    let hf:i32=0;
    while(hf<3){
      if(h_st(W,hf)==0){cid=hf; cm=h_mask(W,hf);}
      hf=hf+1;
    }
    emit("CONVERGED id="); e64(cid); emit(" edges=");
    emit_edges(cm); emit("\n");
    emit("WORLD-DONE "); e64(wid); emit("\n");
    wid=wid+1;
  }
  return 0;
}

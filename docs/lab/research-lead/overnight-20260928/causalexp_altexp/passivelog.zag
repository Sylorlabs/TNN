// passivelog.zag -- Attack 2: enumerate passive logs for H-CAUSALEXP1.
// Pure Zag. No Python anywhere.
// Prereg: PREREG_ALTEXP.md, Attack 2.
//
// Runs the frozen passive script (actions [0,1,0,1,1,0] from (0,0))
// under every edge mask in {0,1,2,3} and emits the full 6-episode log
// per mask. The kill criterion is decided by comparing the four logs:
// pairwise distinct (1:1 mapping) vs any collision.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

fn predict(mask:i32, x:i32, y:i32, a:i32, out:[]u8)void {
  let nx:i32=x;
  let ny:i32=y;
  if(a==1){
    if((mask&2)==0){nx=1;}
    if((mask&1)==0){ny=1;}
    let k:i32=0;
    while(k<2){
      if((mask&1)!=0){ny=nx;}
      if((mask&2)!=0){nx=ny;}
      k=k+1;
    }
  } else if(a==2){
    nx=0;
    if((mask&1)!=0){ny=nx;}
  } else if(a==3){
    nx=1;
    if((mask&1)!=0){ny=nx;}
  } else if(a==4){
    ny=0;
    if((mask&2)!=0){nx=ny;}
  } else if(a==5){
    ny=1;
    if((mask&2)!=0){nx=ny;}
  }
  out[0]=nx as u8;
  out[1]=ny as u8;
  return;
}

fn main()i32 {
  let pscript:[]u8=z_alloc(6);
  pscript[0]=0; pscript[1]=1; pscript[2]=0; pscript[3]=1; pscript[4]=1; pscript[5]=0;
  let m:i32=0;
  while(m<4){
    emit("PASSIVELOG mask="); e64(m); emit("\n");
    let sx:i32=0;
    let sy:i32=0;
    let e:i32=0;
    while(e<6){
      let a:i32=pscript[e] as i32;
      let tmp:[]u8=z_alloc(2);
      predict(m, sx, sy, a, tmp);
      let nx:i32=tmp[0] as i32;
      let ny:i32=tmp[1] as i32;
      emit("EP ("); e64(sx); emit(","); e64(sy); emit(")|"); e64(a);
      emit(" -> ("); e64(nx); emit(","); e64(ny); emit(")\n");
      sx=nx; sy=ny;
      e=e+1;
    }
    m=m+1;
  }
  return 0;
}

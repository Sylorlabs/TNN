// seg4_learn.zag — H-SEG4: segmentation with growable DP sentinel and
// honest nopt cap label. Algorithm SEG-LEX-D (frozen in PREREG_SEG4.md):
//   = SEG-LEX-C (PREREG_SEG3.md) plus:
//   1. Growable DP sentinel: run_exp computes sent = -(FBPEN*n)-1 from
//      the test input length n. Every DP move scores >= -FBPEN
//      (fallback) or >= 0 (chunk scores are uncovered*len^2), so any
//      path ending at position i scores >= -FBPEN*i >= -FBPEN*n > sent.
//      Reachability is exact for every n; the fixed -1000000 sentinel
//      (P-SENT degeneracy at n>=50000) is removed. No new constant.
//   2. Honest nopt cap label: relax sets a per-run saturation flag when
//      the 999 clamp fires; run_exp prints "999+" when the final count
//      is 999 and the flag is set (implies true count strictly > 999),
//      else the plain count.
// New fixtures (test-only): corpus id 4 = H1 (red-team X-SG3-2 fixture),
// SENT60 (60000-char digit string, pure fallback), LONG60 ("xabcd"
// x 12000 on the ADV-1 table, chunk matches at scale).
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn MAXL()i32 { return 5; }
fn MINC()i32 { return 2; }
fn FBPEN()i32 { return 20; }
// NOTE (H-SEG4): the fixed DPSENT() is removed. run_exp derives a
// per-run sentinel sent = -(FBPEN*n)-1 from the input length n,
// which is strictly below every reachable DP score (see header).
fn MAXCH()i32 { return 512; }
fn CHSZ()i32 { return 16; } // +0 len(i32), +4 count(i32), +8 bytes[5]

// ---- corpora (raw strings, no boundaries) ----
fn corpus_a(i:i32)[]u8 {
  if(i==0){return "bigredcube";}
  if(i==1){return "biggreenball";}
  if(i==2){return "smallredball";}
  return "smallgreencube";
}
fn test_a()[]u8 { return "smallgreenball"; }
fn test_c()[]u8 { return "smallredcube"; }
fn test_d()[]u8 { return "bigbluecube"; }
fn corpus_b(i:i32)[]u8 {
  if(i==0){return "zab";}
  if(i==1){return "abz";}
  if(i==2){return "zcde";}
  if(i==3){return "cdez";}
  if(i==4){return "zabc";}
  if(i==5){return "abcz";}
  if(i==6){return "zde";}
  return "dez";
}
fn test_b()[]u8 { return "abcde"; }
// ADV-1: 6 strings (SEG2-ADV frozen fixture)
fn corpus_adv1(i:i32)[]u8 {
  if(i==0){return "xabcd";}
  if(i==1){return "xabcd";}
  if(i==2){return "yabcd";}
  if(i==3){return "yabcd";}
  if(i==4){return "zabcd";}
  return "zabcd";
}
// ADV-2: ADV-1 plus "wabcd","wabcd" (8 strings)
fn corpus_adv2(i:i32)[]u8 {
  if(i<6){return corpus_adv1(i);}
  return "wabcd";
}
fn test_adv_t1()[]u8 { return "xabcd"; }
fn test_adv_t2()[]u8 { return "xabcdyabcd"; }
// H1: red-team X-SG3-2 fixture (SEG3_ADV_RESULT.md)
fn corpus_h1(i:i32)[]u8 {
  if(i==0){return "xab";}
  if(i==1){return "xab";}
  if(i==2){return "yab";}
  if(i==3){return "yab";}
  if(i==4){return "zabab";}
  if(i==5){return "zabab";}
  if(i==6){return "wabab";}
  return "wabab";
}
// corpus ids: 0=A, 1=B, 2=ADV-1, 3=ADV-2, 4=H1
fn corpus_nstr(cid:i32)i32 {
  if(cid==0){return 4;}
  if(cid==1){return 8;}
  if(cid==2){return 6;}
  if(cid==3){return 8;}
  return 8;
}
fn corpus_str(cid:i32, i:i32)[]u8 {
  if(cid==0){return corpus_a(i);}
  if(cid==1){return corpus_b(i);}
  if(cid==2){return corpus_adv1(i);}
  if(cid==3){return corpus_adv2(i);}
  return corpus_h1(i);
}

// ---- chunk table ----
fn ch_len(cht:[]u8, k:i32)i32 { return get32(cht, k*CHSZ()); }
fn ch_cnt(cht:[]u8, k:i32)i32 { return get32(cht, k*CHSZ()+4); }
fn ch_add_or_inc(cht:[]u8, nch:i32, s:[]u8, off:i32, l:i32)i32 {
  let k:i32=0;
  while(k<nch){
    if(ch_len(cht,k)==l){
      let m:i32=0;
      let eq:i32=1;
      while(m<l){ if(cht[k*CHSZ()+8+m]!=s[off+m]){eq=0;} m=m+1; }
      if(eq==1){
        set32(cht, k*CHSZ()+4, ch_cnt(cht,k)+1);
        return nch;
      }
    }
    k=k+1;
  }
  if(nch<MAXCH()){
    let bo:i32=nch*CHSZ();
    set32(cht, bo, l);
    set32(cht, bo+4, 1);
    let m:i32=0;
    while(m<l){ cht[bo+8+m]=s[off+m]; m=m+1; }
    return nch+1;
  }
  return nch;
}
fn train_seq(cht:[]u8, nch:i32, s:[]u8)i32 {
  let n:i32=s.len;
  let i:i32=0;
  while(i<n){
    let l:i32=2;
    while(l<=MAXL()){
      if(i+l<=n){ nch=ch_add_or_inc(cht,nch,s,i,l); }
      l=l+1;
    }
    i=i+1;
  }
  return nch;
}
fn train_corpus(cht:[]u8, cid:i32)i32 {
  let nch:i32=0;
  let ns:i32=corpus_nstr(cid);
  let i:i32=0;
  while(i<ns){ nch=train_seq(cht,nch,corpus_str(cid,i)); i=i+1; }
  return nch;
}
fn ch_match(cht:[]u8, k:i32, t:[]u8, pos:i32)i32 {
  let l:i32=ch_len(cht,k);
  let m:i32=0;
  while(m<l){ if(cht[k*CHSZ()+8+m]!=t[pos+m]){return 0;} m=m+1; }
  return 1;
}

// ---- Phase 1b: coverage discounting ----
// occ_covered: is the occurrence of chunk k at (s,p) strictly contained
// in an occurrence of a longer recurring chunk?
fn occ_covered(cht:[]u8, nch:i32, s:[]u8, n:i32, k:i32, p:i32)i32 {
  let lk:i32=ch_len(cht,k);
  let j:i32=0;
  while(j<nch){
    let lj:i32=ch_len(cht,j);
    if(lj>lk){
      if(ch_cnt(cht,j)>=MINC()){
        let q0:i32=p+lk-lj;
        if(q0<0){q0=0;}
        let q1:i32=p;
        let qmax:i32=n-lj;
        if(q1>qmax){q1=qmax;}
        let q:i32=q0;
        while(q<=q1){
          if(ch_match(cht,j,s,q)==1){
            if(q+lj>=p+lk){return 1;}
          }
          q=q+1;
        }
      }
    }
    j=j+1;
  }
  return 0;
}
// compute_uncovered: unc[k] = occurrences of chunk k not covered.
fn compute_uncovered(cht:[]u8, nch:i32, cid:i32, unc:[]u8)void {
  let ns:i32=corpus_nstr(cid);
  let k:i32=0;
  while(k<nch){
    let u:i32=0;
    let lk:i32=ch_len(cht,k);
    let si:i32=0;
    while(si<ns){
      let s:[]u8=corpus_str(cid,si);
      let n:i32=s.len;
      let p:i32=0;
      while(p+lk<=n){
        if(ch_match(cht,k,s,p)==1){
          if(occ_covered(cht,nch,s,n,k,p)==0){u=u+1;}
        }
        p=p+1;
      }
      si=si+1;
    }
    set32(unc,k*4,u);
    k=k+1;
  }
  return;
}
// discounted score: uncovered count * len^2
fn ch_uscore(cht:[]u8, unc:[]u8, k:i32)i32 {
  let u:i32=get32(unc,k*4);
  let l:i32=ch_len(cht,k);
  return u*l*l;
}

// ---- DP with move lists ----
fn mv_add(mvc:[]u8, mvj:[]u8, mvl:[]u8, pos:i32, j:i32, l:i32, reset:i32)void {
  if(reset==1){
    set32(mvc,pos*4,1);
    set32(mvj,(pos*8)*4,j);
    set32(mvl,(pos*8)*4,l);
    return;
  }
  let c:i32=get32(mvc,pos*4);
  if(c<8){
    set32(mvj,(pos*8+c)*4,j);
    set32(mvl,(pos*8+c)*4,l);
    set32(mvc,pos*4,c+1);
  }
  return;
}
fn relax(dp:[]u8, nopt:[]u8, mvc:[]u8, mvj:[]u8, mvl:[]u8, n:i32, i:i32, l:i32, s:i32, dpi:i32, sat:[]u8)void {
  let np:i32=i+l;
  if(np>n){return;}
  let ns:i32=dpi+s;
  let cur:i32=get32(dp,np*4);
  if(ns>cur){
    set32(dp,np*4,ns);
    set32(nopt,np*4,get32(nopt,i*4));
    mv_add(mvc,mvj,mvl,np,i,l,1);
  } else {
    if(ns==cur){
      let v:i32=get32(nopt,np*4)+get32(nopt,i*4);
      if(v>999){v=999; set32(sat,0,1);}
      set32(nopt,np*4,v);
      mv_add(mvc,mvj,mvl,np,i,l,0);
    }
  }
  return;
}

// Reconstruct the single best path (first optimal move at each step).
// Stacks sized by n: a path has at most n moves (each advances >= 1).
fn build_best(t:[]u8, n:i32, mvj:[]u8, mvl:[]u8, buf:[]u8)i32 {
  let stj:[]u8=z_alloc((n+1)*4);
  let stl:[]u8=z_alloc((n+1)*4);
  let d:i32=0;
  let i:i32=n;
  while(i>0){
    let j:i32=get32(mvj,(i*8)*4);
    let l:i32=get32(mvl,(i*8)*4);
    set32(stj,d*4,j); set32(stl,d*4,l);
    d=d+1; i=j;
  }
  let p:i32=0;
  let k:i32=d-1;
  while(k>=0){
    let j:i32=get32(stj,k*4);
    let l:i32=get32(stl,k*4);
    if(p>0){ buf[p]=124 as u8; p=p+1; }
    let m:i32=0;
    while(m<l){ buf[p]=t[j+m]; p=p+1; m=m+1; }
    k=k-1;
  }
  return p;
}

// Enumerate tied optimal segmentations (backward recursion, cap 5).
// rs = result row stride in bytes (sized by n).
fn enum_bwd(t:[]u8, i:i32, mvc:[]u8, mvj:[]u8, mvl:[]u8,
             stj:[]u8, stl:[]u8, d:i32, res:[]u8, nr:i32, rs:i32)i32 {
  if(nr>=5){return nr;}
  if(i==0){
    let base:i32=nr*rs;
    let p:i32=0;
    let k:i32=d-1;
    while(k>=0){
      let j:i32=get32(stj,k*4);
      let l:i32=get32(stl,k*4);
      if(p>0){ res[base+4+p]=124 as u8; p=p+1; }
      let m:i32=0;
      while(m<l){ res[base+4+p]=t[j+m]; p=p+1; m=m+1; }
      k=k-1;
    }
    set32(res,base,p);
    return nr+1;
  }
  let mc:i32=get32(mvc,i*4);
  let m:i32=0;
  while(m<mc){
    let j:i32=get32(mvj,(i*8+m)*4);
    let l:i32=get32(mvl,(i*8+m)*4);
    set32(stj,d*4,j); set32(stl,d*4,l);
    nr=enum_bwd(t,j,mvc,mvj,mvl,stj,stl,d+1,res,nr,rs);
    if(nr>=5){return nr;}
    m=m+1;
  }
  return nr;
}

fn dump_lexicon(tag:[]u8, cht:[]u8, unc:[]u8, nch:i32)void {
  emit(tag); emit(" NCHUNKS "); emit(i32s(nch)); emit("\n");
  let k:i32=0;
  while(k<nch){
    if(ch_cnt(cht,k)>=MINC()){
      let l:i32=ch_len(cht,k);
      emit(tag); emit(" CHUNK ");
      let tmp:[]u8=z_alloc(8);
      let m:i32=0;
      while(m<l){ tmp[m]=cht[k*CHSZ()+8+m]; m=m+1; }
      emit(tmp[0..l]);
      emit(" len="); emit(i32s(l));
      emit(" count="); emit(i32s(ch_cnt(cht,k)));
      emit(" uncovered="); emit(i32s(get32(unc,k*4)));
      emit(" score="); emit(i32s(ch_uscore(cht,unc,k)));
      emit("\n");
    }
    k=k+1;
  }
  return;
}

fn run_exp(tag:[]u8, cht:[]u8, unc:[]u8, nch:i32, t:[]u8)void {
  let n:i32=t.len;
  // H-SEG4: per-run sentinel. Every DP move scores >= -FBPEN
  // (fallback) or >= 0 (chunk), so any path ending at position i
  // scores >= -FBPEN*i >= -FBPEN*n > sent. A cell holding sent is
  // genuinely unreached, for every n.
  let sent:i32=0-FBPEN()*n-1;
  let dp:[]u8=z_alloc((n+1)*4);
  let nopt:[]u8=z_alloc((n+1)*4);
  let mvc:[]u8=z_alloc((n+1)*4);
  let mvj:[]u8=z_alloc((n+1)*8*4);
  let mvl:[]u8=z_alloc((n+1)*8*4);
  let sat:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<=n){ set32(dp,i*4,sent); set32(nopt,i*4,0); set32(mvc,i*4,0); i=i+1; }
  set32(dp,0,0); set32(nopt,0,1);
  i=0;
  while(i<n){
    let dpi:i32=get32(dp,i*4);
    if(dpi>sent){
      relax(dp,nopt,mvc,mvj,mvl,n,i,1,0-FBPEN(),dpi,sat);
      let k:i32=0;
      while(k<nch){
        if(ch_cnt(cht,k)>=MINC()){
          let l:i32=ch_len(cht,k);
          if(i+l<=n){
            if(ch_match(cht,k,t,i)==1){
              relax(dp,nopt,mvc,mvj,mvl,n,i,l,ch_uscore(cht,unc,k),dpi,sat);
            }
          }
        }
        k=k+1;
      }
    }
    i=i+1;
  }
  dump_lexicon(tag, cht, unc, nch);
  let bestscore:i32=get32(dp,n*4);
  let no:i32=get32(nopt,n*4);
  emit(tag); emit(" TEST "); emit(t); emit("\n");
  emit(tag); emit(" SCORE "); emit(i32s(bestscore));
  emit(" NOPT ");
  // H-SEG4: honest cap label. The clamp fires only when a true
  // subtotal exceeds 999, and nopt only grows by adding positives,
  // so (no==999 and flag set) means the true count strictly exceeds
  // 999; (no==999 and flag clear) means it is exactly 999.
  if(no==999){
    if(get32(sat,0)==1){ emit("999+"); } else { emit(i32s(no)); }
  } else {
    emit(i32s(no));
  }
  emit("\n");
  if(no==1){
    let buf:[]u8=z_alloc(2*n+8);
    let bl:i32=build_best(t,n,mvj,mvl,buf);
    emit(tag); emit(" VERDICT SEGMENTED "); emit(buf[0..bl]); emit("\n");
  } else {
    emit(tag); emit(" VERDICT AMBIGUOUS\n");
    let rs:i32=2*n+16;
    let res:[]u8=z_alloc(5*rs);
    let stj:[]u8=z_alloc((n+1)*4);
    let stl:[]u8=z_alloc((n+1)*4);
    let nr:i32=enum_bwd(t,n,mvc,mvj,mvl,stj,stl,0,res,0,rs);
    emit(tag); emit(" NCAND "); emit(i32s(nr)); emit("\n");
    let r:i32=0;
    while(r<nr){
      let rl:i32=get32(res,r*rs);
      emit(tag); emit(" CAND "); emit(res[r*rs+4..r*rs+4+rl]); emit("\n");
      r=r+1;
    }
  }
  return;
}


// ================ H-SEG4-ADV adversary main ================
// Everything above this line is byte-identical to seg4_learn.zag
// lines 1-415 (the full mechanism). Only main() is replaced.
// Frozen attacks: PREREG_SEG4_ADV.md, commit 0fa95b3c9.

// ---- custom search corpora (adversary test-only) ----
fn advc_nstr(w:i32)i32 {
  if(w==0){return 4;}
  if(w==1){return 4;}
  if(w==2){return 6;}
  if(w==3){return 4;}
  return 8;
}
fn advc_str(w:i32,i:i32)[]u8 {
  if(w==0){
    if(i==0){return "xab";}
    if(i==1){return "xab";}
    if(i==2){return "yab";}
    return "yab";
  }
  if(w==1){
    if(i==0){return "aab";}
    if(i==1){return "aab";}
    if(i==2){return "abb";}
    return "abb";
  }
  if(w==2){
    if(i==0){return "aaab";}
    if(i==1){return "aaab";}
    if(i==2){return "aabb";}
    if(i==3){return "aabb";}
    if(i==4){return "abbb";}
    return "abbb";
  }
  if(w==3){
    if(i==0){return "abcab";}
    if(i==1){return "abcab";}
    if(i==2){return "bcabc";}
    return "bcabc";
  }
  return corpus_h1(i);
}
fn train_adv(cht:[]u8, w:i32)i32 {
  let nch:i32=0;
  let ns:i32=advc_nstr(w);
  let i:i32=0;
  while(i<ns){ nch=train_seq(cht,nch,advc_str(w,i)); i=i+1; }
  return nch;
}
fn compute_uncovered_adv(cht:[]u8, nch:i32, w:i32, unc:[]u8)void {
  let ns:i32=advc_nstr(w);
  let k:i32=0;
  while(k<nch){
    let u:i32=0;
    let lk:i32=ch_len(cht,k);
    let si:i32=0;
    while(si<ns){
      let s:[]u8=advc_str(w,si);
      let n:i32=s.len;
      let p:i32=0;
      while(p+lk<=n){
        if(ch_match(cht,k,s,p)==1){
          if(occ_covered(cht,nch,s,n,k,p)==0){u=u+1;}
        }
        p=p+1;
      }
      si=si+1;
    }
    set32(unc,k*4,u);
    k=k+1;
  }
  return;
}

// ---- unclamped reference relax (no 999 cap; counts capped at 1e9) ----
fn relax_ref(dp:[]u8, nopt:[]u8, n:i32, i:i32, l:i32, s:i32, dpi:i32)void {
  let np:i32=i+l;
  if(np>n){return;}
  let ns:i32=dpi+s;
  let cur:i32=get32(dp,np*4);
  if(ns>cur){
    set32(dp,np*4,ns);
    set32(nopt,np*4,get32(nopt,i*4));
  } else {
    if(ns==cur){
      let a:i32=get32(nopt,np*4);
      let b:i32=get32(nopt,i*4);
      let v:i32=0;
      if(a>1000000000-b){v=1000000000;} else {v=a+b;}
      set32(nopt,np*4,v);
    }
  }
  return;
}

// ---- clamped count using the REAL mechanism relax + sat flag ----
fn dpcount(cht:[]u8, unc:[]u8, nch:i32, t:[]u8, out:[]u8)void {
  let n:i32=t.len;
  let sent:i32=0-FBPEN()*n-1;
  let dp:[]u8=z_alloc((n+1)*4);
  let nopt:[]u8=z_alloc((n+1)*4);
  let mvc:[]u8=z_alloc((n+1)*4);
  let mvj:[]u8=z_alloc((n+1)*8*4);
  let mvl:[]u8=z_alloc((n+1)*8*4);
  let sat:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<=n){ set32(dp,i*4,sent); set32(nopt,i*4,0); set32(mvc,i*4,0); i=i+1; }
  set32(dp,0,0); set32(nopt,0,1);
  i=0;
  while(i<n){
    let dpi:i32=get32(dp,i*4);
    if(dpi>sent){
      relax(dp,nopt,mvc,mvj,mvl,n,i,1,0-FBPEN(),dpi,sat);
      let k:i32=0;
      while(k<nch){
        if(ch_cnt(cht,k)>=MINC()){
          let l:i32=ch_len(cht,k);
          if(i+l<=n){
            if(ch_match(cht,k,t,i)==1){
              relax(dp,nopt,mvc,mvj,mvl,n,i,l,ch_uscore(cht,unc,k),dpi,sat);
            }
          }
        }
        k=k+1;
      }
    }
    i=i+1;
  }
  set32(out,0,get32(nopt,n*4));
  set32(out,4,get32(sat,0));
  return;
}

fn dpcount_ref(cht:[]u8, unc:[]u8, nch:i32, t:[]u8)i32 {
  let n:i32=t.len;
  let sent:i32=0-FBPEN()*n-1;
  let dp:[]u8=z_alloc((n+1)*4);
  let nopt:[]u8=z_alloc((n+1)*4);
  let i:i32=0;
  while(i<=n){ set32(dp,i*4,sent); set32(nopt,i*4,0); i=i+1; }
  set32(dp,0,0); set32(nopt,0,1);
  i=0;
  while(i<n){
    let dpi:i32=get32(dp,i*4);
    if(dpi>sent){
      relax_ref(dp,nopt,n,i,1,0-FBPEN(),dpi);
      let k:i32=0;
      while(k<nch){
        if(ch_cnt(cht,k)>=MINC()){
          let l:i32=ch_len(cht,k);
          if(i+l<=n){
            if(ch_match(cht,k,t,i)==1){
              relax_ref(dp,nopt,n,i,l,ch_uscore(cht,unc,k),dpi);
            }
          }
        }
        k=k+1;
      }
    }
    i=i+1;
  }
  return get32(nopt,n*4);
}

fn lcg(s:i32)i32 {
  return (s*1009+17)%1000003;
}

// X-SG4-1: sentinel sweep through the REAL run_exp.
fn sent_sweep(cht:[]u8, unc:[]u8, nch:i32, n:i32)void {
  let dg:[]u8=z_alloc(n+1);
  let r:i32=0;
  let c:i32=0;
  while(r<n){ dg[r]=(48+c) as u8; c=c+1; if(c>=10){c=0;} r=r+1; }
  emit("SWEEP-N "); emit(i32s(n)); emit(" expect SCORE "); emit(i32s(0-20*n)); emit("\n");
  run_exp("SENT-SWEEP", cht, unc, nch, dg[0..n]);
  return;
}

fn run_case(w:i32, cht:[]u8, unc:[]u8, nch:i32, t:[]u8, out:[]u8)void {
  dpcount(cht,unc,nch,t,out);
  let no:i32=get32(out,0);
  let sat:i32=get32(out,4);
  let tn:i32=dpcount_ref(cht,unc,nch,t);
  emit("CASE w="); emit(i32s(w));
  emit(" len="); emit(i32s(t.len));
  emit(" no="); emit(i32s(no));
  emit(" sat="); emit(i32s(sat));
  emit(" T=");
  if(tn>=1000000000){ emit("HUGE"); } else { emit(i32s(tn)); }
  if(no==999){
    if(sat==1){
      if(tn<=999){ emit(" MISLABEL-FP"); }
    } else {
      if(tn>999){ emit(" MISLABEL-FN"); }
    }
  } else {
    if(sat==1){ emit(" SAT-OFFROUTE-CAND"); }
  }
  emit("\n");
  return;
}

fn main()i32 {
  emit("H-SEG4-ADV red team\n");

  // ---- X-SG4-2a: z_alloc zeroing ----
  let z1:[]u8=z_alloc(4);
  emit("ZALLOC-INIT "); emit(i32s(get32(z1,0))); emit("\n");
  let zd:[]u8=z_alloc(256);
  let zi:i32=0;
  while(zi<256){ zd[zi]=255 as u8; zi=zi+1; }
  let z2:[]u8=z_alloc(4);
  emit("ZALLOC-AFTER-DIRTY "); emit(i32s(get32(z2,0))); emit("\n");

  // ---- X-SG4-1: sentinel sweep (real run_exp, corpus A) ----
  let chta:[]u8=z_alloc(MAXCH()*CHSZ());
  let na:i32=train_corpus(chta,0);
  let unca:[]u8=z_alloc(MAXCH()*4);
  compute_uncovered(chta,na,0,unca);
  sent_sweep(chta,unca,na,1);
  sent_sweep(chta,unca,na,2);
  sent_sweep(chta,unca,na,3);
  sent_sweep(chta,unca,na,10);
  sent_sweep(chta,unca,na,100);
  sent_sweep(chta,unca,na,1000);
  sent_sweep(chta,unca,na,10000);
  sent_sweep(chta,unca,na,49999);
  sent_sweep(chta,unca,na,50000);
  sent_sweep(chta,unca,na,50001);
  sent_sweep(chta,unca,na,60000);
  sent_sweep(chta,unca,na,100000);

  // ---- X-SG4-2b: calibration on frozen H1-T ----
  let cth1:[]u8=z_alloc(MAXCH()*CHSZ());
  let nh1:i32=train_corpus(cth1,4);
  let unh1:[]u8=z_alloc(MAXCH()*4);
  compute_uncovered(cth1,nh1,4,unh1);
  let ab:[]u8=z_alloc(61);
  let r:i32=0;
  while(r<30){ ab[r*2]=97 as u8; ab[r*2+1]=98 as u8; r=r+1; }
  let tref:i32=dpcount_ref(cth1,unh1,nh1,ab[0..60]);
  emit("CALIB-REF-H1T "); emit(i32s(tref)); emit(" (expect 1346269)\n");
  let out:[]u8=z_alloc(8);
  dpcount(cth1,unh1,nh1,ab[0..60],out);
  emit("CALIB-CLAMP-H1T no="); emit(i32s(get32(out,0)));
  emit(" sat="); emit(i32s(get32(out,4))); emit(" (expect 999,1)\n");

  // ---- X-SG4-2b: mislabel search ----
  let w:i32=0;
  let seed:i32=12345;
  while(w<5){
    let cht:[]u8=z_alloc(MAXCH()*CHSZ());
    let nch:i32=train_adv(cht,w);
    let unc:[]u8=z_alloc(MAXCH()*4);
    compute_uncovered_adv(cht,nch,w,unc);
    emit("SEARCH-W "); emit(i32s(w)); emit(" nch="); emit(i32s(nch)); emit("\n");
    // structured: unit repeated k
    let k:i32=1;
    while(k<=40){
      let ulen:i32=2;
      if(w==3){ulen=3;}
      let t:[]u8=z_alloc(k*ulen+1);
      let j:i32=0;
      while(j<k){
        if(w==3){
          t[j*3]=97 as u8; t[j*3+1]=98 as u8; t[j*3+2]=99 as u8;
        } else {
          t[j*2]=97 as u8; t[j*2+1]=98 as u8;
        }
        j=j+1;
      }
      run_case(w,cht,unc,nch,t[0..k*ulen],out);
      k=k+1;
    }
    // LCG-random strings
    let ri:i32=0;
    while(ri<120){
      seed=lcg(seed);
      let tl:i32=6+(seed%43);
      seed=lcg(seed);
      let alpha:i32=2;
      if(w==3){alpha=3;}
      let t2:[]u8=z_alloc(tl+1);
      let j2:i32=0;
      while(j2<tl){
        seed=lcg(seed);
        t2[j2]=(97+(seed%alpha)) as u8;
        j2=j2+1;
      }
      run_case(w,cht,unc,nch,t2[0..tl],out);
      ri=ri+1;
    }
    w=w+1;
  }

  emit("H-SEG4-ADV COMPLETE\n");
  return 0;
}

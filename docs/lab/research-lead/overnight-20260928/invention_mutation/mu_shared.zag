// mu_shared.zag -- Invention Hypothesis 1 shared experiment helpers.
// (unfrozen; concatenated after mu_core.zag and mu_patch.zag)

// ---- instrumentation ----
fn mu_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  if(t>=2000000){
    let u:i32=t-2000000;
    emit(" [mutate tried="); e64(u/1024); emit(" rejected="); e64(u-(u/1024)*1024); emit("]");
  } else {
    emit(" [tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("]");
  }
  return;
}
fn mu_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn mu_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// white-box: MAP plen and DEP targets split by node tag.
fn mu_zreport(W:[]u8,s:i32,r:i32)void {
  let zm:i32=mu_find_map(W,s,r);
  emit("ZMAP id="); e64(zm);
  if(zm>=0){
    let pl:i32=rb_chain_plen(W,ng(W,zm,20));
    emit(" plen="); e64(pl); emit("\n");
    let e:i32=0; let nf:i32=0; let nm:i32=0;
    while(e<4096){
      if(eg(W,e,0)==zm && eg(W,e,4)==1){
        let to:i32=eg(W,e,8);
        if(ng(W,to,0)==20){
          nm=nm+1;
          emit("  DEP->MAP "); e64(to); emit(" plen="); e64(rb_chain_plen(W,ng(W,to,20))); emit("\n");
        } else {
          nf=nf+1;
        }
      }
      e=e+1;
    }
    emit("  dep_facts="); e64(nf); emit(" dep_maps="); e64(nm); emit("\n");
  } else {
    emit(" (none)\n");
  }
  return;
}
// ---- training blocks: one MAP each of plen 3, 4, 5 (query rel 71) ----
fn mu_train3(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  let a:i32=ev_query(W,101,71,103,0);
  emit("TR3 ans="); e64(a); mu_tstat(W); emit("\n");
  return;
}
fn mu_train4(W:[]u8)void {
  ev_teach(W,111,1,112); ev_teach(W,112,1,113); ev_teach(W,113,1,114);
  let a:i32=ev_query(W,111,71,114,0);
  emit("TR4 ans="); e64(a); mu_tstat(W); emit("\n");
  return;
}
fn mu_train5(W:[]u8)void {
  ev_teach(W,121,1,122); ev_teach(W,122,1,123);
  ev_teach(W,123,1,124); ev_teach(W,124,1,125);
  let a:i32=ev_query(W,121,71,125,0);
  emit("TR5 ans="); e64(a); mu_tstat(W); emit("\n");
  return;
}
// ---- test: plen-6 problem (beyond trial's plen<=5 bound) ----
fn mu_test6(W:[]u8)void {
  ev_teach(W,301,1,302); ev_teach(W,302,1,303); ev_teach(W,303,1,304);
  ev_teach(W,304,1,305); ev_teach(W,305,1,306);
  let z:i32=ev_query(W,301,71,306,0);
  emit("T6 ans="); e64(z); mu_tstat(W); emit("\n");
  mu_zreport(W,301,71);
  return;
}
// ---- reuse: fresh plen-6 problem after the mutant exists ----
fn mu_reuse6(W:[]u8)void {
  ev_teach(W,401,1,402); ev_teach(W,402,1,403); ev_teach(W,403,1,404);
  ev_teach(W,404,1,405); ev_teach(W,405,1,406);
  let z:i32=ev_query(W,401,71,406,0);
  emit("R6 ans="); e64(z); mu_tstat(W); emit("\n");
  return;
}
// ---- iterate: plen-7 problem; the plen-6 mutant becomes a mutation parent.
// Tests open-endedness: invented forms are themselves mutable.
fn mu_iter7(W:[]u8)void {
  ev_teach(W,501,1,502); ev_teach(W,502,1,503); ev_teach(W,503,1,504);
  ev_teach(W,504,1,505); ev_teach(W,505,1,506); ev_teach(W,506,1,507);
  let z:i32=ev_query(W,501,71,507,0);
  emit("I7 ans="); e64(z); mu_tstat(W); emit("\n");
  mu_zreport(W,501,71);
  return;
}

// mu_main_abl.zag -- Invention Hypothesis 1 ablation main.
// Mutation stage disabled (MUT_ON=0 in mu_patch_nomut.zag); everything else
// identical. Predicts failure on the plen-6 problem, proving the mutation
// stage is causal.
fn main()i32 {
  emit("MU-ABL-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  emit("=== ABL-MUT ===\n");
  mu_train3(W1); mu_train4(W1); mu_train5(W1);
  emit("maps="); e64(mu_count_maps(W1));
  emit(" bestplen="); e64(mu_best_plen(W1)); emit("\n");
  mu_test6(W1);
  emit("MU-ABL-END\n");
  return 0;
}

// mu_patch.zag -- Invention Hypothesis 1: structural mutation from failure
// (unfrozen).
//
// mutate_try is a general pipeline stage (like rebind_try): on a query where
// activate, rebind, and trial all fail, it attempts STRUCTURAL MUTATION of
// existing MAPs instead of giving up.
//
// Failure-mode guidance (computed from learner-available data only):
//   "too short": a parent MAP stages on the query subject and executes to an
//   endpoint value v_end, but the world contains facts (v_end -> w) that no
//   existing MAP shape can reach. The operator EXTENDS the parent's chain by
//   one cell using such a continuing fact.
// The extended graph is executed and verified against the goal; on success
// it is promoted as a NEW MAP with a type-1 DEP edge to the parent MAP
// (mutation provenance). The new structural form was not enumerated in
// source: trial is bounded to plen<=5, rebind reuses exact shapes, and no
// plen-6 (or longer) template exists anywhere. Which parent mutates and
// which fact extends it are determined by the world's data, the learner's
// history, and verification, not by researcher labels.
//
// There is no MUTATE_MODE, no task label, no "extend X" hint. The operator
// is open-ended: a promoted mutant becomes a parent for future mutations,
// so reachable forms are unbounded through iteration. Deterministic: MAPs,
// paths, and facts are scanned in id order; the first verifying extension
// wins.

// Longest chain-MAP plen in learner state, or -1 if none.
fn mu_best_plen(W:[]u8)i32 {
  let best:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let p:i32=rb_chain_plen(W,ng(W,m,20));
      if(p>best){best=p;}
    }
    m=m+1;
  }
  return best;
}
// Extend parent MAP m by one cell. Stage m on each plen-p gathered path,
// execute to the endpoint, and try every 1-step continuing fact from it.
// Returns the verified answer or -2.
fn mu_extend_one(W:[]u8,m:i32,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  if(p<2){return -2;}
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,s,paths);
  let i:i32=0;
  while(i<np && ans==-2){
    let base:i32=i*48;
    if(get32(paths,base)==p){
      let v:[]u8=z_alloc(28); let f:[]u8=z_alloc(24);
      let j:i32=0;
      while(j<p){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
      j=0;
      while(j<p-1){set32(f,j*4,get32(paths,base+28+j*4)); j=j+1;}
      // stage the parent's structure on this subject; where does it stop?
      let root:i32=t2_asm_chain(W,v,p,f);
      let vend:i32=t2_exec(W,root,s);
      if(vend!=-999999){
        // "too short" signal: the world continues past the parent's reach.
        let n:i32=2;
        while(n<1024 && ans==-2){
          if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==vend && ng(W,n,24)!=-999){
            let w:i32=ng(W,n,28);
            let k:i32=0; let cyc:i32=0;
            while(k<p){if(get32(v,k*4)==w){cyc=1;} k=k+1;}
            if(cyc==0){
              let ve:[]u8=z_alloc(28); let fe:[]u8=z_alloc(24);
              let q:i32=0;
              while(q<p){set32(ve,q*4,get32(v,q*4)); q=q+1;}
              set32(ve,p*4,w);
              q=0;
              while(q<p-1){set32(fe,q*4,get32(f,q*4)); q=q+1;}
              set32(fe,(p-1)*4,n);
              let eroot:i32=t2_asm_chain(W,ve,p+1,fe);
              let v2:i32=t2_try_verify(W,eroot,s,expected,masked,st);
              if(v2!=-2){
                let zm:i32=promote_graph(W,eroot,s,r,v2,fe,p);
                if(zm>=0){
                  let _l:i32=link_edge(W,zm,1,m,0);
                  emit("MUT-STAT parent="); e64(m);
                  emit(" plen "); e64(p); emit(" -> "); e64(p+1);
                  emit(" zmap="); e64(zm); emit("\n");
                }
                ans=v2;
              }
            }
          }
          n=n+1;
        }
      }
    }
    i=i+1;
  }
  return ans;
}
// mutate_try: structural mutation from failure. Parents in longest-plen-first
// order (then id order): stage each, find where it stops, extend by one cell
// into the continuing world. First verified extension wins.
fn mutate_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let ans:i32=-2;
  let p:i32=mu_best_plen(W);
  while(p>=2 && ans==-2){
    let m:i32=2;
    while(m<1024 && ans==-2){
      if(ng(W,m,36)==1 && ng(W,m,0)==20){
        if(rb_chain_plen(W,ng(W,m,20))==p){
          ans=mu_extend_one(W,m,s,r,expected,masked,st);
        }
      }
      m=m+1;
    }
    p=p-1;
  }
  return ans;
}
// Ablation switch: 1 = mutation stage active. The no-mutation build flips
// this to 0; everything else is identical.
fn MUT_ON()i32 { return 0; }
// ev_query: activate -> rebind (exact-shape reuse) -> trial (bounded
// construction, plen<=5) -> mutate (structural mutation from failure) ->
// bootstrap. Mutation is a general stage, not a mode: it fires on any query
// where all existing mechanisms fail and a parent MAP can be extended.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    let _l:i32=link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- structural rebinding: retrieve learned shapes before mutating
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- trial loop (learner-set miss policy), bounded to plen<=5
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // ---- structural mutation from failure: extend a failed MAP's structure
  let mus:[]u8=z_alloc(8); set32(mus,0,0); set32(mus,4,0);
  let ma:i32=-2;
  if(MUT_ON()==1){ma=mutate_try(W,s,r,expected,masked,mus);}
  emit("MUT-STAT tried="); e64(get32(mus,0)); emit(" rejected="); e64(get32(mus,4)); emit("\n");
  if(ma!=-2){
    hs(W,16,2000000+get32(mus,0)*1024+get32(mus,4));
    log_ev(W,2,s,r,ma,1,0,0); return ma;
  }
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// mu_main.zag -- Invention Hypothesis 1 main (mutation active).
// Arms: TREAT (train plen-3/4/5, then plen-6 problem), REUSE (same
// workspace, fresh plen-6 problem), FRESH (no training, plen-6 problem).
fn main()i32 {
  emit("MU-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  emit("=== TREAT ===\n");
  mu_train3(W1); mu_train4(W1); mu_train5(W1);
  emit("maps="); e64(mu_count_maps(W1));
  emit(" bestplen="); e64(mu_best_plen(W1)); emit("\n");
  mu_test6(W1);
  emit("=== REUSE ===\n");
  mu_reuse6(W1);
  emit("=== ITERATE ===\n");
  mu_iter7(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  emit("=== FRESH ===\n");
  mu_test6(W2);
  emit("MU-END\n");
  return 0;
}

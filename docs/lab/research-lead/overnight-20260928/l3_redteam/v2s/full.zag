// glm_learner.zag -- generic generator-intermediate machinery.
//
// Shared by the H1 and H2 drivers of XDOMAIN-GRAMMAR-L2M. This file
// holds ONLY generic machinery plus learner-state access. It contains:
// no fact-relation literals, no label literals, no validity rule, no
// supplied-solution installer, no domain knowledge of any kind.
//
// M slot layout in W (base 2112, 32 bytes):
//   [0]=n_instr, [1]=gen, [2]=sup, [3]=created,
//   [4..21]=program (6 instr x 3 bytes),
//   [24..27]=build_count i32, [28..31]=reserved.
// Mprev slot (base 2144, 32 bytes): revision history, [1] of prev set
// to 1 on supersede.
//
// Generator program: registers R0..R3 (i32), R0 preloaded with the
// divisor D, output is R0. Frozen generic op basis:
//   0=CPY (Rd=Rs), 1=ADD (Rd+=Rs), 2=MUL (Rd*=Rs),
//   3=SET1 (Rd=1), 4=INC (Rd+=1).
// m_construct: greedy program construction from labeled experience.
// m_adapt: generic revision policy (codes 0=kept, 2=revised, 3=fail).
//
// The emit helpers eS/eN and the cell helpers put32/ig plus z_alloc
// are defined in the driver file; forward references are fine.

fn m_has(W:[]u8)i32 {
  if((W[2112] as i32)>0){ return 1; }
  return 0;
}
fn m_created_flag(W:[]u8)i32 { return W[2115] as i32; }
fn m_build_count(W:[]u8)i32 { return ig(W,2136); }
fn m_write(W:[]u8, n:i32, gen:i32, prog:[]u8)void {
  W[2112]=n as u8; W[2113]=gen as u8; W[2114]=0; W[2115]=1;
  let k:i32=0;
  while(k<18){ W[2116+k]=prog[k]; k=k+1; }
  put32(W,2136,ig(W,2136)+1);
  return;
}
fn m_copy_prev(W:[]u8)void {
  let k:i32=0;
  while(k<32){ W[2144+k]=W[2112+k]; k=k+1; }
  W[2145]=1;
  return;
}
fn m_wipe(W:[]u8)void {
  let k:i32=0;
  while(k<32){ W[2112+k]=0; k=k+1; }
  return;
}
fn m_label_lookup(W:[]u8, base:i32, nl:i32, D:i32, v:i32)i32 {
  let i:i32=0;
  while(i<nl){
    if(ig(W,base+i*12)==D && ig(W,base+i*12+4)==v){
      return ig(W,base+i*12+8);
    }
    i=i+1;
  }
  return 0;
}
fn m_exec(prog:[]u8, n:i32, D:i32)i32 {
  let r0:i32=D;
  let r1:i32=0;
  let r2:i32=0;
  let r3:i32=0;
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rs:i32=0;
    if(s==0){ rs=r0; }
    else { if(s==1){ rs=r1; } else { if(s==2){ rs=r2; } else { rs=r3; } } }
    if(op==0){
      if(d==0){ r0=rs; }
      else { if(d==1){ r1=rs; } else { if(d==2){ r2=rs; } else { r3=rs; } } }
    }
    else {
      if(op==1){
        if(d==0){ r0=r0+rs; }
        else { if(d==1){ r1=r1+rs; } else { if(d==2){ r2=r2+rs; } else { r3=r3+rs; } } }
      }
      else {
        if(op==2){
          if(d==0){ r0=r0*rs; }
          else { if(d==1){ r1=r1*rs; } else { if(d==2){ r2=r2*rs; } else { r3=r3*rs; } } }
        }
        else {
          if(op==3){
            if(d==0){ r0=1; }
            else { if(d==1){ r1=1; } else { if(d==2){ r2=1; } else { r3=1; } } }
          }
          else {
            if(d==0){ r0=r0+1; }
            else { if(d==1){ r1=r1+1; } else { if(d==2){ r2=r2+1; } else { r3=r3+1; } } }
          }
        }
      }
    }
    k=k+1;
  }
  return r0;
}
fn m_score(W:[]u8, prog:[]u8, n:i32, base:i32, nl:i32, d0:i32, d1:i32)i32 {
  let s:i32=0;
  let w0:i32=m_exec(prog,n,d0);
  if(m_label_lookup(W,base,nl,d0,w0)==1){ s=s+1; }
  let w1:i32=m_exec(prog,n,d1);
  if(m_label_lookup(W,base,nl,d1,w1)==1){ s=s+1; }
  return s;
}
// Greedy construction. init_n>0 resumes from the current M program
// (revision); init_n==0 starts empty (fresh construction). Result
// program goes to out_prog (18B); out_meta gets [n, score].
fn m_construct(W:[]u8, OUT:[]u8, base:i32, nl:i32, d0:i32, d1:i32, init_n:i32, out_prog:[]u8, out_meta:[]u8)i32 {
  let cur:[]u8=z_alloc(18);
  let k:i32=0;
  while(k<init_n*3){ cur[k]=W[2116+k]; k=k+1; }
  let cn:i32=init_n;
  let bs:i32=m_score(W,cur,cn,base,nl,d0,d1);
  let round:i32=0;
  let go:i32=1;
  while(go==1){
    if(cn>=6){ go=0; }
    else {
      round=round+1;
      let bg:i32=0;
      let bop:i32=-1;
      let bd:i32=0;
      let bss:i32=0;
      let op:i32=0;
      while(op<5){
        let d:i32=0;
        while(d<4){
          let s:i32=0;
          while(s<4){
            let cand:[]u8=z_alloc(18);
            let j:i32=0;
            while(j<cn*3){ cand[j]=cur[j]; j=j+1; }
            cand[cn*3]=op as u8;
            cand[cn*3+1]=d as u8;
            cand[cn*3+2]=s as u8;
            let cs:i32=m_score(W,cand,cn+1,base,nl,d0,d1);
            let gain:i32=cs-bs;
            if(gain>bg){ bg=gain; bop=op; bd=d; bss=s; }
            s=s+1;
          }
          d=d+1;
        }
        op=op+1;
      }
      eS(W,OUT,"C-ROUND ");
      eN(W,OUT,round);
      eS(W,OUT," base=");
      eN(W,OUT,bs);
      if(bg>0){
        eS(W,OUT," win=");
        eN(W,OUT,bop);
        eS(W,OUT,",");
        eN(W,OUT,bd);
        eS(W,OUT,",");
        eN(W,OUT,bss);
        eS(W,OUT," gain=");
        eN(W,OUT,bg);
        cur[cn*3]=bop as u8;
        cur[cn*3+1]=bd as u8;
        cur[cn*3+2]=bss as u8;
        cn=cn+1;
        bs=m_score(W,cur,cn,base,nl,d0,d1);
        eS(W,OUT," score=");
        eN(W,OUT,bs);
        eS(W,OUT,"\n");
        if(bs>=2){ go=0; }
      }
      else {
        eS(W,OUT," stop\n");
        go=0;
      }
    }
  }
  k=0;
  while(k<18){ out_prog[k]=cur[k]; k=k+1; }
  put32(out_meta,0,cn);
  put32(out_meta,4,bs);
  return bs;
}
// Revision policy: 0=kept, 2=revised (old M retired to Mprev), 3=fail.
fn m_adapt(W:[]u8, OUT:[]u8, base:i32, nl:i32, d0:i32, d1:i32)i32 {
  let n:i32=W[2112] as i32;
  let cur:[]u8=z_alloc(18);
  let k:i32=0;
  while(k<n*3){ cur[k]=W[2116+k]; k=k+1; }
  let sc:i32=m_score(W,cur,n,base,nl,d0,d1);
  eS(W,OUT,"ADAPT cur_score=");
  eN(W,OUT,sc);
  eS(W,OUT,"\n");
  if(sc>=2){ return 0; }
  let outp:[]u8=z_alloc(18);
  let meta:[]u8=z_alloc(8);
  let bs:i32=m_construct(W,OUT,base,nl,d0,d1,n,outp,meta);
  let nn:i32=ig(meta,0);
  if(bs>=2){
    m_copy_prev(W);
    let g:i32=(W[2113] as i32)+1;
    m_write(W,nn,g,outp);
    return 2;
  }
  return 3;
}
fn m_print_prog(W:[]u8, OUT:[]u8)void {
  eS(W,OUT,"M-PROG n=");
  eN(W,OUT,W[2112] as i32);
  eS(W,OUT," gen=");
  eN(W,OUT,W[2113] as i32);
  eS(W,OUT," created=");
  eN(W,OUT,W[2115] as i32);
  eS(W,OUT," build_count=");
  eN(W,OUT,ig(W,2136));
  eS(W,OUT," bytes=");
  let n:i32=W[2112] as i32;
  let k:i32=0;
  while(k<n*3){
    eN(W,OUT,W[2116+k] as i32);
    eS(W,OUT,",");
    k=k+1;
  }
  eS(W,OUT,"\n");
  return;
}
fn m_print_prev(W:[]u8, OUT:[]u8)void {
  eS(W,OUT,"M-PREV n=");
  eN(W,OUT,W[2144] as i32);
  eS(W,OUT," sup=");
  eN(W,OUT,W[2145] as i32);
  eS(W,OUT," bytes=");
  let n:i32=W[2144] as i32;
  let k:i32=0;
  while(k<n*3){
    eN(W,OUT,W[2148+k] as i32);
    eS(W,OUT,",");
    k=k+1;
  }
  eS(W,OUT,"\n");
  return;
}
// gl2m_h1.zag -- XDOMAIN-GRAMMAR-L2M, H1 (learned typed contracts).
//
// X: grammar parameter extraction (rule -> divisor, rebindable relation).
// Y: construction (divisor -> word) via the learner-created generator
//    intermediate M when installed, else memorized lookup (as taught).
// D1: range-hi distractor (fixed relation). D2: identity distractor.
// Sealed Z needs L2 relation rebinding of X AND the intermediate M:
// Y as taught cannot construct for a new divisor.
//
// Prereg: xdomain_grammar_l2m/PREREG.md (frozen before implementation).
// Pure Zag. 0 modes/bridges/handlers. Single output buffer plus one raw
// syscall write per main. No _zag_print for dynamic content.

// ---------- prelude ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=ig(W,16);
  cur=e1str(OUT,cur,s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=ig(W,16);
  cur=e1i64(OUT,cur,v as i64);
  put32(W,16,cur);
  return;
}

// ---------- workspace ----------
// header: 0 nmaps, 4 z_id, 8 solved, 12 tries, 16 out_cur, 20 arm_ok,
//         24 n_g1, 28 n_g2
// facts: base 64, 40 entries x 12 bytes (used,subj,rel,obj)
// maps: base 544, 10 entries x 48 bytes
//   (used,behav,param,sig_in,sig_out,in_sum,in_n,out_sum,out_n,
//    comp_a,comp_b,rebound_of)
// candidates: base 2048, 8 entries x 4 bytes
// M slot: base 2112 (see glm_learner.zag); Mprev: base 2144
// G1 labels: base 2176, 22 entries x 12 bytes (D,v,lab)
// G2 labels: base 2440, 18 entries x 12 bytes (D,v,lab)
// Y memorized lookup: base 2700, 2 entries x 8 bytes (D,word)
fn glm_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,-1); put32(W,8,0); put32(W,12,0);
  put32(W,20,0); put32(W,24,18); put32(W,28,18);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==0){
      put32(W,64+i*12,1); put32(W,64+i*12+4,s);
      put32(W,64+i*12+8,r); put32(W,64+i*12+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn glm_facts(W:[]u8)void {
  // Training grammar facts, then sealed facts. The distractor relation
  // for the sealed rule is inserted before the genuine one so the
  // candidate scan meets the distractor first.
  add_fact(W,1,71,16);
  add_fact(W,2,71,8);
  add_fact(W,1,72,7);
  add_fact(W,2,72,5);
  add_fact(W,3,74,5);
  add_fact(W,3,73,24);
  add_fact(W,3,72,9);
  add_fact(W,4,73,32);
  add_fact(W,5,73,40);
  return;
}
fn y_lookup_init(W:[]u8)void {
  // Y as taught: memorized divisor to example word (prior learning).
  // Kept out of the fact store so the kind probe stays clean.
  put32(W,2700,16); put32(W,2704,17);
  put32(W,2708,8); put32(W,2712,9);
  return;
}
fn y_lookup(W:[]u8,D:i32)i32 {
  let i:i32=0;
  while(i<2){
    if(ig(W,2700+i*8)==D){ return ig(W,2700+i*8+4); }
    i=i+1;
  }
  return -1;
}
// --- world validity rules (driver side only; the constructor never
// --- calls these; they self-check the hand-derived label tables).
fn g1_valid(D:i32,v:i32)i32 {
  let q:i32=1;
  while(q<=7){
    let r:i32=2;
    while(r<=8){
      if(v==D*q+r){ return 1; }
      r=r+1;
    }
    q=q+1;
  }
  return 0;
}
fn g2_valid(D:i32,v:i32)i32 {
  let q:i32=2;
  while(q<=8){
    let r:i32=2;
    while(r<=8){
      if(v==D*q+r){ return 1; }
      r=r+1;
    }
    q=q+1;
  }
  return 0;
}
fn lab3(W:[]u8,base:i32,i:i32,D:i32,v:i32,l:i32)void {
  put32(W,base+i*12,D); put32(W,base+i*12+4,v); put32(W,base+i*12+8,l);
  return;
}
fn g1_labels(W:[]u8)void {
  // V2 adversarial world G1b: v = D*q+r, q in [1,7], r in [2,8].
  // D+1 is INVALID here; the minimal valid word D+2 needs [INC,INC].
  let b:i32=2176;
  lab3(W,b,0,16,18,1); lab3(W,b,1,16,24,1); lab3(W,b,2,16,34,1);
  lab3(W,b,3,16,40,1); lab3(W,b,4,16,17,0); lab3(W,b,5,16,16,0);
  lab3(W,b,6,16,15,0); lab3(W,b,7,16,1,0); lab3(W,b,8,16,0,0);
  lab3(W,b,9,8,10,1); lab3(W,b,10,8,16,1); lab3(W,b,11,8,18,1);
  lab3(W,b,12,8,24,1); lab3(W,b,13,8,9,0); lab3(W,b,14,8,8,0);
  lab3(W,b,15,8,7,0); lab3(W,b,16,8,1,0); lab3(W,b,17,8,0,0);
  return;
}
fn g2_labels(W:[]u8)void {
  let b:i32=2440;
  lab3(W,b,0,16,34,1); lab3(W,b,1,16,40,1); lab3(W,b,2,16,50,1);
  lab3(W,b,3,16,56,1); lab3(W,b,4,16,17,0); lab3(W,b,5,16,18,0);
  lab3(W,b,6,16,24,0); lab3(W,b,7,16,33,0); lab3(W,b,8,16,16,0);
  lab3(W,b,9,8,18,1); lab3(W,b,10,8,24,1); lab3(W,b,11,8,26,1);
  lab3(W,b,12,8,32,1); lab3(W,b,13,8,9,0); lab3(W,b,14,8,10,0);
  lab3(W,b,15,8,16,0); lab3(W,b,16,8,17,0); lab3(W,b,17,8,8,0);
  return;
}
fn label_check(W:[]u8,OUT:[]u8,base:i32,nl:i32,g:i32)i32 {
  let ok:i32=0;
  let i:i32=0;
  while(i<nl){
    let D:i32=ig(W,base+i*12);
    let v:i32=ig(W,base+i*12+4);
    let l:i32=ig(W,base+i*12+8);
    let e:i32=0;
    if(g==1){ e=g1_valid(D,v); } else { e=g2_valid(D,v); }
    if(e==l){ ok=ok+1; }
    else {
      eS(W,OUT,"LABEL-MISMATCH D=");
      eN(W,OUT,D);
      eS(W,OUT," v=");
      eN(W,OUT,v);
      eS(W,OUT," lab=");
      eN(W,OUT,l);
      eS(W,OUT," rule=");
      eN(W,OUT,e);
      eS(W,OUT,"\n");
    }
    i=i+1;
  }
  return ok;
}
fn find_obj(W:[]u8,s:i32,r:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s && ig(W,64+i*12+8)==r){
      return ig(W,64+i*12+12);
    }
    i=i+1;
  }
  return -1;
}
// kind probe: 1=NODE iff v appears as a fact subject, else 2=NUM.
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  let b:i32=544+m*48;
  put32(W,b,1); put32(W,b+4,behav);
  put32(W,b+8,-1);
  put32(W,b+12,0); put32(W,b+16,0);
  put32(W,b+20,0); put32(W,b+24,0); put32(W,b+28,0); put32(W,b+32,0);
  put32(W,b+36,-1); put32(W,b+40,-1); put32(W,b+44,-1);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,544+m*48,0); return; }
fn bind_param(W:[]u8,m:i32,subj:i32)void {
  // Generic: bind to the first relation seen for the training subject.
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==subj){
      put32(W,544+m*48+8,ig(W,64+i*12+8));
      return;
    }
    i=i+1;
  }
  return;
}
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let b:i32=544+m*48;
  let bh:i32=ig(W,b+4);
  if(bh==0){ return find_obj(W,v,ig(W,b+8)); }
  if(bh==1){
    if(m_has(W)==1){
      return m_exec(W[2116..2134],W[2112] as i32,v);
    }
    return y_lookup(W,v);
  }
  if(bh==2){ return find_obj(W,v,72); }
  if(bh==3){ return v; }
  let a:i32=ig(W,b+36); let c:i32=ig(W,b+40);
  let mid:i32=exec_map(W,a,v);
  return exec_map(W,c,mid);
}
fn record_obs(W:[]u8,m:i32,vin:i32,vout:i32)void {
  let b:i32=544+m*48;
  put32(W,b+20,ig(W,b+20)+probe_kind(W,vin));
  put32(W,b+24,ig(W,b+24)+1);
  put32(W,b+28,ig(W,b+28)+probe_kind(W,vout));
  put32(W,b+32,ig(W,b+32)+1);
  return;
}
fn finalize_sig(W:[]u8,m:i32)void {
  let b:i32=544+m*48;
  let inn:i32=ig(W,b+24); let outn:i32=ig(W,b+32);
  if(inn>=2){
    let si:i32=1;
    if(ig(W,b+20)*2>=inn*3){ si=2; }
    put32(W,b+12,si);
  }
  if(outn>=2){
    let so:i32=1;
    if(ig(W,b+28)*2>=outn*3){ so=2; }
    put32(W,b+16,so);
  }
  return;
}
fn sig_in(W:[]u8,m:i32)i32 { return ig(W,544+m*48+12); }
fn sig_out(W:[]u8,m:i32)i32 { return ig(W,544+m*48+16); }
// Generic REBIND: copy the MAP, set the bindable parameter to the
// candidate relation, inherit the learned signature, record provenance.
fn rebind_map(W:[]u8,m:i32,cr:i32)i32 {
  let nm:i32=map_new(W,ig(W,544+m*48+4));
  let nb:i32=544+nm*48;
  let ob:i32=544+m*48;
  put32(W,nb+8,cr);
  put32(W,nb+12,ig(W,ob+12));
  put32(W,nb+16,ig(W,ob+16));
  put32(W,nb+44,m);
  return nm;
}
// Generic candidate scan: distinct relations with a fact (s,r,*),
// first-seen order. No domain knowledge.
fn scan_candidates(W:[]u8,s:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*12)==1 && ig(W,64+i*12+4)==s){
      let r:i32=ig(W,64+i*12+8);
      let seen:i32=0;
      let k:i32=0;
      while(k<n){
        if(ig(W,2048+k*4)==r){ seen=1; }
        k=k+1;
      }
      if(seen==0 && n<8){
        put32(W,2048+n*4,r);
        n=n+1;
      }
    }
    i=i+1;
  }
  return n;
}
fn cand_rel(W:[]u8,i:i32)i32 { return ig(W,2048+i*4); }
fn promote_comp(W:[]u8,a:i32,b:i32)i32 {
  let z:i32=map_new(W,4);
  let zb:i32=544+z*48;
  put32(W,zb+36,a); put32(W,zb+40,b);
  put32(W,zb+12,sig_in(W,a));
  put32(W,zb+16,sig_out(W,b));
  put32(W,4,z);
  return z;
}
fn teach_all(W:[]u8,OUT:[]u8)void {
  let x:i32=map_new(W,0);
  bind_param(W,x,1);
  let r:i32=exec_map(W,x,1); record_obs(W,x,1,r);
  r=exec_map(W,x,2); record_obs(W,x,2,r);
  finalize_sig(W,x);
  eS(W,OUT,"TEACH X id="); eN(W,OUT,x);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,x)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,x));
  eS(W,OUT," param="); eN(W,OUT,ig(W,544+x*48+8)); eS(W,OUT,"\n");
  let y:i32=map_new(W,1);
  r=exec_map(W,y,16); record_obs(W,y,16,r);
  r=exec_map(W,y,8); record_obs(W,y,8,r);
  finalize_sig(W,y);
  eS(W,OUT,"TEACH Y id="); eN(W,OUT,y);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,y)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,y)); eS(W,OUT,"\n");
  let d1:i32=map_new(W,2);
  r=exec_map(W,d1,1); record_obs(W,d1,1,r);
  r=exec_map(W,d1,2); record_obs(W,d1,2,r);
  finalize_sig(W,d1);
  eS(W,OUT,"TEACH D1 id="); eN(W,OUT,d1);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,d1)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,d1)); eS(W,OUT,"\n");
  let d2:i32=map_new(W,3);
  r=exec_map(W,d2,1); record_obs(W,d2,1,r);
  r=exec_map(W,d2,2); record_obs(W,d2,2,r);
  finalize_sig(W,d2);
  eS(W,OUT,"TEACH D2 id="); eN(W,OUT,d2);
  eS(W,OUT," sig="); eN(W,OUT,sig_in(W,d2)); eS(W,OUT,"->"); eN(W,OUT,sig_out(W,d2)); eS(W,OUT,"\n");
  return;
}
// Phase-2 intermediate gate: build M from labeled experience unless the
// arm disables building (NO-M) or M already exists (reuse).
fn m_ensure(W:[]u8,OUT:[]u8,allow_build:i32)void {
  if(m_has(W)==1){
    eS(W,OUT,"M-PRESENT reuse\n");
    return;
  }
  if(allow_build==0){
    eS(W,OUT,"M-ABSENT build-disabled\n");
    return;
  }
  let outp:[]u8=z_alloc(18);
  let meta:[]u8=z_alloc(8);
  let bs:i32=m_construct(W,OUT,2176,ig(W,24),16,8,0,outp,meta);
  let nn:i32=ig(meta,0);
  if(bs>=2 && nn>0){
    m_write(W,nn,0,outp);
    eS(W,OUT,"M-BUILT score=");
    eN(W,OUT,bs);
    eS(W,OUT,"\n");
    m_print_prog(W,OUT);
  }
  else {
    eS(W,OUT,"M-BUILD-FAIL score=");
    eN(W,OUT,bs);
    eS(W,OUT,"\n");
  }
  return;
}
// Two-phase solver. Phase 1: exact L1 reuse. Phase 2 (l2_on=1): build
// the intermediate if allowed, rebind each bindable MAP to each
// candidate relation, retry typed composition.
fn solve_z(W:[]u8,OUT:[]u8,s:i32,target:i32,type_on:i32,l2_on:i32,allow_build:i32)void {
  let kin:i32=probe_kind(W,s);
  let kout:i32=probe_kind(W,target);
  let nm:i32=ig(W,0);
  let tries:i32=0;
  put32(W,8,0);
  eS(W,OUT,"PHASE1 L1:\n");
  let m:i32=0;
  while(m<nm){
    if(ig(W,8)==0 && ig(W,544+m*48)==1){
      let ok:i32=1;
      if(type_on==1){
        if(sig_in(W,m)!=kin){ ok=0; }
        if(sig_out(W,m)!=kout){ ok=0; }
      }
      if(ok==1){
        tries=tries+1;
        let r:i32=exec_map(W,m,s);
        eS(W,OUT,"TRY single m="); eN(W,OUT,m); eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
        if(r==target){
          eS(W,OUT,"Z-SINGLE m="); eN(W,OUT,m); eS(W,OUT,"\n");
          put32(W,8,1);
        }
      }
    }
    m=m+1;
  }
  let a:i32=0;
  while(a<nm){
    let b:i32=0;
    while(b<nm){
      if(ig(W,8)==0 && ig(W,544+a*48)==1 && ig(W,544+b*48)==1){
        let ok:i32=1;
        if(type_on==1){
          if(sig_in(W,a)!=kin){ ok=0; }
          if(sig_out(W,a)!=sig_in(W,b)){ ok=0; }
          if(sig_out(W,b)!=kout){ ok=0; }
        }
        if(ok==1){
          tries=tries+1;
          let mid:i32=exec_map(W,a,s);
          let r:i32=exec_map(W,b,mid);
          eS(W,OUT,"TRY pair a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b);
          eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
          if(r==target){
            let z:i32=promote_comp(W,a,b);
            eS(W,OUT,"Z-COMP z="); eN(W,OUT,z);
            eS(W,OUT," a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b); eS(W,OUT,"\n");
            put32(W,8,1);
          }
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  if(ig(W,8)==0){ eS(W,OUT,"L1-FAIL\n"); }
  if(ig(W,8)==1 || l2_on==0){
    if(ig(W,8)==1){ put32(W,12,tries); } else { put32(W,12,0-tries); }
    return;
  }
  eS(W,OUT,"PHASE2 L2:\n");
  m_ensure(W,OUT,allow_build);
  let nc:i32=scan_candidates(W,s);
  eS(W,OUT,"CANDIDATES n="); eN(W,OUT,nc);
  let ci0:i32=0;
  while(ci0<nc){
    eS(W,OUT," "); eN(W,OUT,cand_rel(W,ci0));
    ci0=ci0+1;
  }
  eS(W,OUT,"\n");
  let n0:i32=ig(W,0);
  let rm:i32=0;
  while(rm<n0){
    if(ig(W,8)==0 && ig(W,544+rm*48)==1 && ig(W,544+rm*48+8)>=0){
      let ci:i32=0;
      while(ci<nc){
        if(ig(W,8)==0){
          let cr:i32=cand_rel(W,ci);
          let nm2:i32=rebind_map(W,rm,cr);
          eS(W,OUT,"REBIND m="); eN(W,OUT,rm); eS(W,OUT," cr="); eN(W,OUT,cr);
          eS(W,OUT," nm="); eN(W,OUT,nm2); eS(W,OUT,"\n");
          let ok1:i32=1;
          if(type_on==1){
            if(sig_in(W,nm2)!=kin){ ok1=0; }
            if(sig_out(W,nm2)!=kout){ ok1=0; }
          }
          if(ok1==1){
            tries=tries+1;
            let r1:i32=exec_map(W,nm2,s);
            eS(W,OUT,"TRY single m="); eN(W,OUT,nm2); eS(W,OUT," r="); eN(W,OUT,r1); eS(W,OUT,"\n");
            if(r1==target){
              eS(W,OUT,"Z-RSINGLE m="); eN(W,OUT,nm2); eS(W,OUT,"\n");
              put32(W,4,nm2); put32(W,8,1);
            }
          }
          let b:i32=0;
          while(b<ig(W,0)){
            if(ig(W,8)==0 && ig(W,544+b*48)==1){
              let ok2:i32=1;
              if(type_on==1){
                if(sig_in(W,nm2)!=kin){ ok2=0; }
                if(sig_out(W,nm2)!=sig_in(W,b)){ ok2=0; }
                if(sig_out(W,b)!=kout){ ok2=0; }
              }
              if(ok2==1){
                tries=tries+1;
                let mid:i32=exec_map(W,nm2,s);
                let r:i32=exec_map(W,b,mid);
                eS(W,OUT,"TRY pair a="); eN(W,OUT,nm2); eS(W,OUT," b="); eN(W,OUT,b);
                eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
                if(r==target){
                  let z:i32=promote_comp(W,nm2,b);
                  eS(W,OUT,"Z-COMP z="); eN(W,OUT,z);
                  eS(W,OUT," a="); eN(W,OUT,nm2); eS(W,OUT," b="); eN(W,OUT,b); eS(W,OUT,"\n");
                  eS(W,OUT,"REBOUND a="); eN(W,OUT,nm2);
                  eS(W,OUT," param="); eN(W,OUT,ig(W,544+nm2*48+8));
                  eS(W,OUT," rebound_of="); eN(W,OUT,ig(W,544+nm2*48+44)); eS(W,OUT,"\n");
                  put32(W,8,1);
                }
              }
            }
            b=b+1;
          }
        }
        ci=ci+1;
      }
    }
    rm=rm+1;
  }
  if(ig(W,8)==1){ put32(W,12,tries); } else { eS(W,OUT,"L2-FAIL\n"); put32(W,12,0-tries); }
  return;
}
// Researcher-supplied intermediate (SUPPLIED arm only): installs the
// generator program directly, bypassing construction. created=0,
// supplied marker set. Never called on the TREAT path.
fn install_supplied(W:[]u8,OUT:[]u8)void {
  // V2S control: researcher installs the 2-step [INC R0, INC R0].
  W[2112]=2; W[2113]=0; W[2114]=0; W[2115]=0;
  W[2116]=4; W[2117]=0; W[2118]=0;
  W[2119]=4; W[2120]=0; W[2121]=0;
  let k:i32=6;
  while(k<18){ W[2116+k]=0; k=k+1; }
  put32(W,2140,1);
  eS(W,OUT,"SUPPLIED-INSTALL n=2 bytes=4,0,0,4,0,0\n");
  return;
}
fn arm_treat(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-L2 ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  let lc:i32=label_check(W,OUT,2176,ig(W,24),1);
  eS(W,OUT,"LABEL-CHECK G1 ok="); eN(W,OUT,lc); eS(W,OUT,"\n");
  teach_all(W,OUT);
  let px:i32=ig(W,544+8);
  solve_z(W,OUT,3,26,1,1,1);
  let ok:i32=0;
  if(ig(W,8)==1){
    let z:i32=ig(W,4);
    let za:i32=ig(W,544+z*48+36);
    let zb:i32=ig(W,544+z*48+40);
    let ro:i32=ig(W,544+za*48+44);
    let pa:i32=ig(W,544+za*48+8);
    let mc:i32=m_created_flag(W);
    let mn:i32=W[2112] as i32;
    let p0:i32=W[2116] as i32;
    let p1:i32=W[2117] as i32;
    let p2:i32=W[2118] as i32;
    // Provenance: comp_a is a rebound of X (id 0) whose parameter
    // differs from the training binding (learner-determined value;
    // the trace shows it), comp_b is Y (id 1), and M was created by
    // the learner with the expected constructed program.
    // V2 red-team verdict: solved with a learner-created intermediate
    // (any non-empty program); byte identity is not required here.
    if(ro==0 && zb==1 && pa!=px && mc==1 && mn>=1){ ok=1; }
  }
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  // Z2 in the same workspace: the intermediate must persist (no rebuild).
  eS(W,OUT,"=== TREAT-L2 Z2 ===\n");
  let bc0:i32=m_build_count(W);
  solve_z(W,OUT,4,34,1,1,1);
  let ok2:i32=0;
  if(ig(W,8)==1 && m_build_count(W)==bc0){ ok2=1; }
  if(ok2==1){ eS(W,OUT,"Z2-RESULT PASS\n"); } else { eS(W,OUT,"Z2-RESULT FAIL\n"); }
  put32(W,20,ig(W,20)+ok2);
  return;
}
fn arm_l1only(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  solve_z(W,OUT,3,25,1,0,1);
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_ablx(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  del_map(W,0);
  solve_z(W,OUT,3,25,1,1,1);
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_ably(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  del_map(W,1);
  solve_z(W,OUT,3,25,1,1,1);
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_fresh(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  solve_z(W,OUT,3,25,1,1,1);
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_nom(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== NO-M ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  solve_z(W,OUT,3,25,1,1,0);
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
fn arm_supplied(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== SUPPLIED ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W);
  teach_all(W,OUT);
  install_supplied(W,OUT);
  solve_z(W,OUT,3,26,1,1,1);
  if(ig(W,8)==1){ eS(W,OUT,"ARM-RESULT PASS\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL\n"); put32(W,20,0); }
  return;
}
fn arm_revise(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== REVISE ===\n");
  glm_facts(W); y_lookup_init(W); g1_labels(W); g2_labels(W);
  let lc:i32=label_check(W,OUT,2440,ig(W,28),2);
  eS(W,OUT,"LABEL-CHECK G2 ok="); eN(W,OUT,lc); eS(W,OUT,"\n");
  teach_all(W,OUT);
  solve_z(W,OUT,3,25,1,1,1);
  let okz:i32=ig(W,8);
  eS(W,OUT,"REVISE-Z ok="); eN(W,OUT,okz); eS(W,OUT,"\n");
  let ac:i32=m_adapt(W,OUT,2440,ig(W,28),16,8);
  eS(W,OUT,"ADAPT-CODE "); eN(W,OUT,ac); eS(W,OUT,"\n");
  m_print_prog(W,OUT);
  m_print_prev(W,OUT);
  solve_z(W,OUT,5,82,1,1,1);
  let ok:i32=0;
  let pn:i32=W[2144] as i32;
  let ps:i32=W[2145] as i32;
  let cn:i32=W[2112] as i32;
  let c0:i32=W[2116] as i32;
  let c1:i32=W[2117] as i32;
  let c2:i32=W[2118] as i32;
  let c3:i32=W[2119] as i32;
  let c4:i32=W[2120] as i32;
  let c5:i32=W[2121] as i32;
  if(okz==1 && ac==2 && ig(W,8)==1 && pn==1 && ps==1 && cn==2 && c0==4 && c1==0 && c2==0 && c3==1 && c4==0 && c5==0){ ok=1; }
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  return;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  cur=e1str(OUT,cur,"L2M-H1-START\n");
  let W1:[]u8=z_alloc(8192); glm_init(W1); put32(W1,16,cur);
  arm_treat(W1,OUT); cur=ig(W1,16); let v1:i32=ig(W1,20);
  let W2:[]u8=z_alloc(8192); glm_init(W2); put32(W2,16,cur);
  arm_l1only(W2,OUT); cur=ig(W2,16); let v2:i32=ig(W2,20);
  let W3:[]u8=z_alloc(8192); glm_init(W3); put32(W3,16,cur);
  arm_ablx(W3,OUT); cur=ig(W3,16); let v3:i32=ig(W3,20);
  let W4:[]u8=z_alloc(8192); glm_init(W4); put32(W4,16,cur);
  arm_ably(W4,OUT); cur=ig(W4,16); let v4:i32=ig(W4,20);
  let W5:[]u8=z_alloc(8192); glm_init(W5); put32(W5,16,cur);
  arm_fresh(W5,OUT); cur=ig(W5,16); let v5:i32=ig(W5,20);
  let W6:[]u8=z_alloc(8192); glm_init(W6); put32(W6,16,cur);
  arm_nom(W6,OUT); cur=ig(W6,16); let v6:i32=ig(W6,20);
  let W7:[]u8=z_alloc(8192); glm_init(W7); put32(W7,16,cur);
  arm_supplied(W7,OUT); cur=ig(W7,16); let v7:i32=ig(W7,20);
  let W8:[]u8=z_alloc(8192); glm_init(W8); put32(W8,16,cur);
  arm_revise(W8,OUT); cur=ig(W8,16); let v8:i32=ig(W8,20);
  // v1 counts Z and Z2 (2 points); the rest count 1 each.
  let tot:i32=v1+v2+v3+v4+v5+v6+v7+v8;
  cur=e1str(OUT,cur,"TOTAL ");
  cur=e1i64(OUT,cur,tot as i64);
  cur=e1str(OUT,cur,"/9\n");
  cur=e1str(OUT,cur,"L2M-H1-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){ return 0; }
  return 1;
}

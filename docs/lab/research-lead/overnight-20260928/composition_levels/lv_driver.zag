// lv_driver.zag -- Three-level composition battery (L1/L2/L3).
//
// L1 exact reuse: X+Y execute unchanged in Z. Expect PASS.
// L2 adaptive reuse (extension): X must be extended for Z. Expect FAIL.
// L3 novel intermediate: Z needs a NEW structure for an r9 bridge.
//   Expect FAIL.
// Each level: TREAT + ablations + FRESH + (L1: REUSE + PROV).
// 3/3 byte-identical runs required.

// ---- helpers (local; do not clash with base/patch) ----
fn lv_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn lv_has14(W:[]u8,from:i32,to:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==from && eg(W,e,4)==14 && eg(W,e,8)==to){return 1;}
    e=e+1;
  }
  return 0;
}
fn lv_kill(W:[]u8,m:i32)void {
  ns(W,m,36,0);
  return;
}
// Train X ([1,1,1]) and Y ([2,2,2]). Returns mapx in out0, mapy in out1.
fn lv_train_xy(W:[]u8,out:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x:i32=ev_query(W,11,71,14,0);
  emit("LV-X ans="); e64(x); emit("\n");
  set32(out,0,cb_newest_map(W));
  ev_teach(W,21,2,22); ev_teach(W,22,2,23); ev_teach(W,23,2,24);
  let y:i32=ev_query(W,21,72,24,0);
  emit("LV-Y ans="); e64(y); emit("\n");
  set32(out,4,cb_newest_map(W));
  return;
}

// ---- L1: exact reuse ----
fn l1_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,2,105); ev_teach(W,105,2,106); ev_teach(W,106,2,107);
  return;
}
fn l1_treat(W:[]u8,out:[]u8)void {
  emit("=== L1-TREAT ===\n");
  lv_train_xy(W,out);
  lv_gap(W);
  l1_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("L1-TREAT-ANS="); e64(z); emit("\n");
  set32(out,8,cb_newest_map(W));
  if(z==107){emit("L1-TREAT=PASS\n");} else {emit("L1-TREAT=FAIL\n");}
  return;
}
fn l1_ablx(W:[]u8)void {
  emit("=== L1-ABL-X ===\n");
  let out:[]u8=z_alloc(12);
  lv_train_xy(W,out);
  lv_kill(W,get32(out,0));
  emit("L1-ABL-X killed mapx\n");
  lv_gap(W);
  l1_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("L1-ABL-X-ANS="); e64(z); emit("\n");
  if(z==-2){emit("L1-ABL-X=PASS\n");} else {emit("L1-ABL-X=FAIL\n");}
  return;
}
fn l1_ably(W:[]u8)void {
  emit("=== L1-ABL-Y ===\n");
  let out:[]u8=z_alloc(12);
  lv_train_xy(W,out);
  lv_kill(W,get32(out,4));
  emit("L1-ABL-Y killed mapy\n");
  lv_gap(W);
  l1_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("L1-ABL-Y-ANS="); e64(z); emit("\n");
  if(z==-2){emit("L1-ABL-Y=PASS\n");} else {emit("L1-ABL-Y=FAIL\n");}
  return;
}
fn l1_fresh(W:[]u8)void {
  emit("=== L1-FRESH ===\n");
  lv_gap(W);
  l1_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  emit("L1-FRESH-ANS="); e64(z); emit("\n");
  if(z==-2){emit("L1-FRESH=PASS\n");} else {emit("L1-FRESH=FAIL\n");}
  return;
}
fn l1_reuse(W:[]u8)void {
  emit("=== L1-REUSE ===\n");
  let out:[]u8=z_alloc(12);
  lv_train_xy(W,out);
  lv_gap(W);
  l1_zfacts(W);
  let z1:i32=ev_query(W,101,70,107,0);
  emit("L1-REUSE first="); e64(z1); emit("\n");
  let z2:i32=ev_query(W,101,70,107,0);
  emit("L1-REUSE-ANS="); e64(z2); emit("\n");
  if(z2==107){emit("L1-REUSE=PASS\n");} else {emit("L1-REUSE=FAIL\n");}
  return;
}
fn l1_prov(W:[]u8)void {
  emit("=== L1-PROV ===\n");
  let out:[]u8=z_alloc(12);
  lv_train_xy(W,out);
  let mapx:i32=get32(out,0);
  let mapy:i32=get32(out,4);
  lv_gap(W);
  l1_zfacts(W);
  let z:i32=ev_query(W,101,70,107,0);
  let mapz:i32=cb_newest_map(W);
  emit("L1-PROV z="); e64(z); emit(" mapz="); e64(mapz);
  emit(" mapx="); e64(mapx); emit(" mapy="); e64(mapy); emit("\n");
  let px:i32=lv_has14(W,mapz,mapx);
  let py:i32=lv_has14(W,mapz,mapy);
  emit("L1-PROV link14-z-x="); e64(px); emit(" link14-z-y="); e64(py); emit("\n");
  if(z==107 && px==1 && py==1){emit("L1-PROV=PASS\n");} else {emit("L1-PROV=FAIL\n");}
  return;
}

// ---- L2: adaptive reuse (extension) ----
// X is [1,1,1] but Z needs FOUR r1 links. X must be extended.
fn l2_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,1,104); ev_teach(W,104,1,105);
  ev_teach(W,105,2,106); ev_teach(W,106,2,107); ev_teach(W,107,2,108);
  return;
}
fn l2_treat(W:[]u8)void {
  emit("=== L2-TREAT ===\n");
  let out:[]u8=z_alloc(12);
  lv_train_xy(W,out);
  lv_gap(W);
  l2_zfacts(W);
  let z:i32=ev_query(W,101,70,108,0);
  emit("L2-TREAT-ANS="); e64(z); emit("\n");
  if(z==-2){emit("L2-TREAT=PASS\n");} else {emit("L2-TREAT=FAIL\n");}
  return;
}
fn l2_fresh(W:[]u8)void {
  emit("=== L2-FRESH ===\n");
  lv_gap(W);
  l2_zfacts(W);
  let z:i32=ev_query(W,101,70,108,0);
  emit("L2-FRESH-ANS="); e64(z); emit("\n");
  if(z==-2){emit("L2-FRESH=PASS\n");} else {emit("L2-FRESH=FAIL\n");}
  return;
}

// ---- L3: novel intermediate ----
// Z needs an r9 bridge (103->104 via r9) with no MAP covering it.
fn l3_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,9,105);
  ev_teach(W,105,2,106); ev_teach(W,106,2,107); ev_teach(W,107,2,108);
  return;
}
fn l3_treat(W:[]u8)void {
  emit("=== L3-TREAT ===\n");
  let out:[]u8=z_alloc(12);
  lv_train_xy(W,out);
  lv_gap(W);
  l3_zfacts(W);
  let z:i32=ev_query(W,101,70,108,0);
  emit("L3-TREAT-ANS="); e64(z); emit("\n");
  if(z==-2){emit("L3-TREAT=PASS\n");} else {emit("L3-TREAT=FAIL\n");}
  return;
}
fn l3_fresh(W:[]u8)void {
  emit("=== L3-FRESH ===\n");
  lv_gap(W);
  l3_zfacts(W);
  let z:i32=ev_query(W,101,70,108,0);
  emit("L3-FRESH-ANS="); e64(z); emit("\n");
  if(z==-2){emit("L3-FRESH=PASS\n");} else {emit("L3-FRESH=FAIL\n");}
  return;
}

fn main()i32 {
  emit("LV-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  let o1:[]u8=z_alloc(12); l1_treat(W1,o1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); l1_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); l1_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); l1_fresh(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); l1_reuse(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); l1_prov(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7); l2_treat(W7);
  let W8:[]u8=z_alloc(110656); tnn2_init(W8); l2_fresh(W8);
  let W9:[]u8=z_alloc(110656); tnn2_init(W9); l3_treat(W9);
  let W10:[]u8=z_alloc(110656); tnn2_init(W10); l3_fresh(W10);
  emit("LV-END\n");
  return 0;
}


// ================= SEALED: world-spec machinery =================
// WS buffer layout (world construction scratch, index-level):
//   0: ntr   4: nup   8: nov   12: nd   16: na   2304: nst
//   20: g0[100] (bytes)    120: g1[100]
//   220: used[100]
//   320: dlist[400] (100 i32 packed i*10+j)
//   720: alist[400]
//   1120: upairs[40] (10 i32 packed)
//   1160: ovp[40]   1200: ovv0[40]   1240: ovv1[40]  (overrides)
//   1280: trs[256]  1536: tri[256]  1792: trj[256]  2048: trd[256]
//   2308: sts[48]   2356: sti[48]   2404: stj[48]   2452: sth[48]   2500: std[48]
fn wg(ws:[]u8, g:i32, i:i32, j:i32)i32 {
  let base:i32=20;
  if(g==1){base=120;}
  return ws[base+i*10+j] as i32;
}
fn wg_set(ws:[]u8, g:i32, i:i32, j:i32, v:i32)void {
  let base:i32=20;
  if(g==1){base=120;}
  ws[base+i*10+j]=v as u8;
  return;
}
fn a_canon_a(i:i32, j:i32)i32 {
  if(i<j){return i;}
  return j;
}
fn a_canon_b(i:i32, j:i32)i32 {
  if(i<j){return j;}
  return i;
}
fn a_mark_used(ws:[]u8, i:i32, j:i32)void {
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  ws[220+a*10+b]=1;
  return;
}
fn a_is_used(ws:[]u8, i:i32, j:i32)i32 {
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  return ws[220+a*10+b] as i32;
}
fn a_tr_add(ws:[]u8, s:i32, i:i32, j:i32, d:i32)void {
  let n:i32=get32(ws,0);
  set32(ws,1280+n*4,s);
  set32(ws,1536+n*4,i);
  set32(ws,1792+n*4,j);
  set32(ws,2048+n*4,d);
  set32(ws,0,n+1);
  a_mark_used(ws,i,j);
  return;
}
fn a_st_add(ws:[]u8, s:i32, i:i32, j:i32, held:i32, det:i32)void {
  let n:i32=get32(ws,2304);
  set32(ws,2308+n*4,s);
  set32(ws,2356+n*4,i);
  set32(ws,2404+n*4,j);
  set32(ws,2452+n*4,held);
  set32(ws,2500+n*4,det);
  set32(ws,2304,n+1);
  return;
}
fn a_u_add(ws:[]u8, i:i32, j:i32)void {
  let n:i32=get32(ws,4);
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  set32(ws,1120+n*4,a*10+b);
  set32(ws,4,n+1);
  a_mark_used(ws,a,b);
  return;
}
fn a_ov_add(ws:[]u8, i:i32, j:i32, v0:i32, v1:i32)void {
  let n:i32=get32(ws,8);
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  set32(ws,1160+n*4,a*10+b);
  set32(ws,1200+n*4,v0);
  set32(ws,1240+n*4,v1);
  set32(ws,8,n+1);
  return;
}
// shuffle an i32 list in place
fn a_shuf_list(r:[]u8, list:[]u8, n:i32)void {
  let k:i32=n-1;
  while(k>0){
    let m:i32=rng_range(r,k+1);
    let t:i32=get32(list,k*4);
    set32(list,k*4,get32(list,m*4));
    set32(list,m*4,t);
    k=k-1;
  }
  return;
}
// truth generators. g0ord=1 -> ORD(perm0) else PAR; g1ord=1 -> ORD(perm1) else PAR.
// Then build D (disagree) and A (agree) lists, shuffled.
fn a_phase_gen(r:[]u8, ws:[]u8, seed:i32, g0ord:i32, g1ord:i32)void {
  rng_seed(r,seed);
  let perm0:[]u8=z_alloc(40);
  let perm1:[]u8=z_alloc(40);
  let pos0:[]u8=z_alloc(40);
  let pos1:[]u8=z_alloc(40);
  w_shuffle(r,perm0,10);
  w_shuffle(r,perm1,10);
  w_pos_of(perm0,pos0,10);
  w_pos_of(perm1,pos1,10);
  let g:i32=0;
  while(g<2){
    let gord:i32=g0ord;
    if(g==1){gord=g1ord;}
    let i:i32=0;
    while(i<10){
      let j:i32=0;
      while(j<10){
        let d:i32=0;
        if(i!=j){
          if(gord==1){
            let a:i32=a_canon_a(i,j);
            let b:i32=a_canon_b(i,j);
            let pa:i32=0;
            let pb:i32=0;
            if(g==0){pa=get32(pos0,a*4);pb=get32(pos0,b*4);}
            else {pa=get32(pos1,a*4);pb=get32(pos1,b*4);}
            if(pa<pb){d=1;}
          } else {
            if((i+j)%2==0){d=1;}
          }
        }
        wg_set(ws,g,i,j,d);
        j=j+1;
      }
      i=i+1;
    }
    g=g+1;
  }
  let nd:i32=0;
  let na:i32=0;
  let i2:i32=0;
  while(i2<10){
    let j2:i32=i2+1;
    while(j2<10){
      let d0:i32=wg(ws,0,i2,j2);
      let d1:i32=wg(ws,1,i2,j2);
      if(d0==d1){set32(ws,720+na*4,i2*10+j2);na=na+1;}
      else {set32(ws,320+nd*4,i2*10+j2);nd=nd+1;}
      j2=j2+1;
    }
    i2=i2+1;
  }
  // shuffle the D and A lists via temp copies
  let dl:[]u8=z_alloc(400);
  let al:[]u8=z_alloc(400);
  let k:i32=0;
  while(k<nd){set32(dl,k*4,get32(ws,320+k*4));k=k+1;}
  k=0;
  while(k<na){set32(al,k*4,get32(ws,720+k*4));k=k+1;}
  a_shuf_list(r,dl,nd);
  a_shuf_list(r,al,na);
  k=0;
  while(k<nd){set32(ws,320+k*4,get32(dl,k*4));k=k+1;}
  k=0;
  while(k<na){set32(ws,720+k*4,get32(al,k*4));k=k+1;}
  set32(ws,12,nd);
  set32(ws,16,na);
  return;
}
// unused-pair candidates, shuffled; returns count
fn a_unused_shuf(r:[]u8, ws:[]u8, cand:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){
      if(a_is_used(ws,i,j)==0){set32(cand,n*4,i*10+j);n=n+1;}
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,n);
  return n;
}
// ---- W0 INVENT-2: g0=ORD, g1=PAR; 6 D x2 + 8 A; U=4; decoys=2 ----
fn a_ph_w0(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1000,1,0);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    let i:i32=p/10;
    let j:i32=p%10;
    a_tr_add(ws,0,i,j,wg(ws,0,i,j));
    a_tr_add(ws,1,i,j,wg(ws,1,i,j));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let i:i32=p/10;
    let j:i32=p%10;
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,i,j,wg(ws,ci,i,j));
    k=k+1;
  }
  let cand:[]u8=z_alloc(400);
  a_unused_shuf(r,ws,cand);
  k=0;
  while(k<4){
    let p:i32=get32(cand,k*4);
    a_u_add(ws,p/10,p%10);
    k=k+1;
  }
  // decoys: probeable, truth overridden to ANTI-TB (ids 700+i; i<j -> tb=1 -> truth 0)
  let dq0:i32=get32(cand,4*4);
  let dq1:i32=get32(cand,5*4);
  a_ov_add(ws,dq0/10,dq0%10,0,0);
  a_ov_add(ws,dq1/10,dq1%10,0,0);
  a_mark_used(ws,dq0/10,dq0%10);
  a_mark_used(ws,dq1/10,dq1%10);
  set32(ws,2548,dq0);
  set32(ws,2552,dq1);
  // stakes (12)
  k=0;
  while(k<3){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,0,p/10,p%10,1,1);
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(ws,320+k*4);
    let s:i32=0;
    if(k==2){s=1;}
    a_st_add(ws,s,p/10,p%10,1,0);
    k=k+1;
  }
  let pu:i32=get32(ws,1120+3*4);
  a_st_add(ws,1,pu/10,pu%10,0,1);
  a_st_add(ws,0,dq0/10,dq0%10,0,0);
  a_st_add(ws,1,dq1/10,dq1%10,0,0);
  k=0;
  while(k<3){
    let p:i32=get32(ws,720+k*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-A WITHHELD-2: g0=ORD, g1=ORD; 6 D x ctx0 only + 14 A (alternating ctx) ----
fn a_ph_fa(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1001,1,1);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<14){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=k%2;
    a_tr_add(ws,ci,p/10,p%10,wg(ws,ci,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,0,p/10,p%10,1,0);
    a_st_add(ws,1,p/10,p%10,1,0);
    k=k+1;
  }
  k=0;
  while(k<6){
    let p:i32=get32(ws,720+((k+3)%na)*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-B UNDET-BLOCK: g0=ORD, g1=ORD; U=4 cross-block ----
fn a_ph_fb(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1002,1,1);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    a_tr_add(ws,1,p/10,p%10,wg(ws,1,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,p/10,p%10,wg(ws,ci,p/10,p%10));
    k=k+1;
  }
  // cross-block candidates: (i<5) != (j<5)
  let cand:[]u8=z_alloc(400);
  let nc:i32=0;
  let i:i32=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){
      let bi:i32=0;
      let bj:i32=0;
      if(i>=5){bi=1;}
      if(j>=5){bj=1;}
      if(bi!=bj){
        if(a_is_used(ws,i,j)==0){set32(cand,nc*4,i*10+j);nc=nc+1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,nc);
  k=0;
  while(k<4){
    let p:i32=get32(cand,k*4);
    a_u_add(ws,p/10,p%10);
    k=k+1;
  }
  // stakes: heldout 4 det (unused agreeing) + 2 U; extra 2 U + 4 det
  let ndet:i32=0;
  k=0;
  while(k<na){
    if(ndet<6){
      let p:i32=get32(ws,720+k*4);
      if(a_is_used(ws,p/10,p%10)==0){
        if(ndet<4){a_st_add(ws,0,p/10,p%10,1,0);}
        else {a_st_add(ws,1,p/10,p%10,0,0);}
        ndet=ndet+1;
      }
    }
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,0,p/10,p%10,1,1);
    k=k+1;
  }
  k=2;
  while(k<4){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,1,p/10,p%10,0,1);
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,k,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-C POISON-SWAP: oracle g0=ORD,g1=PAR; training swapped ----
fn a_ph_fc(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1003,1,0);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    let i:i32=p/10;
    let j:i32=p%10;
    a_tr_add(ws,0,i,j,wg(ws,1,i,j));
    a_tr_add(ws,1,i,j,wg(ws,0,i,j));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=rng_range(r,2);
    let cj:i32=1-ci;
    a_tr_add(ws,cj,p/10,p%10,wg(ws,cj,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,0,p/10,p%10,1,0);
    a_st_add(ws,1,p/10,p%10,1,0);
    k=k+1;
  }
  k=0;
  while(k<6){
    let p:i32=get32(ws,720+((k+5)%na)*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-D REUSE-SCATTER: g0=PAR, g1=ORD; U=5 scattered (i+j)%3==0 ----
fn a_ph_fd(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1004,0,1);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    a_tr_add(ws,1,p/10,p%10,wg(ws,1,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,p/10,p%10,wg(ws,ci,p/10,p%10));
    k=k+1;
  }
  let cand:[]u8=z_alloc(400);
  let nc:i32=0;
  let i:i32=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){
      if((i+j)%3==0){
        if(a_is_used(ws,i,j)==0){set32(cand,nc*4,i*10+j);nc=nc+1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,nc);
  k=0;
  while(k<5){
    let p:i32=get32(cand,k*4);
    a_u_add(ws,p/10,p%10);
    k=k+1;
  }
  let ndet:i32=0;
  k=0;
  while(k<na){
    if(ndet<6){
      let p:i32=get32(ws,720+k*4);
      if(a_is_used(ws,p/10,p%10)==0){
        if(ndet<4){a_st_add(ws,0,p/10,p%10,1,0);}
        else {a_st_add(ws,1,p/10,p%10,0,0);}
        ndet=ndet+1;
      }
    }
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,0,p/10,p%10,1,1);
    k=k+1;
  }
  k=2;
  while(k<4){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,1,p/10,p%10,0,1);
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,k,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}

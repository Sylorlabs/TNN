// prelude.zag -- shared basics for L3-SUF-1.
// Pure Zag. u8-backed cells (little-endian). Single output buffer +
// cursor emit helpers; final write via _zag_raw_syscall (never
// _zag_print for dynamic content, per the pinned-znc workaround).
// Alloc pattern: _zag_malloc as *u8 then [0..n] (the sound pattern;
// never `as *i32` + slice, never `[]u8 as *u8`).

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output buffer emit helpers (single buffer, cursor) ----
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 {
  ob[at]=10;
  return at+1;
}
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn e0(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e1(ob:[]u8, atp:[]u8, s:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_i32(ob,at,v);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e3(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32, s3:[]u8, v3:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_app(ob,at,s3);
  at=ob_i32(ob,at,v3);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn write_ob(ob:[]u8, atp:[]u8)void {
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=get32(atp,0);
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return;
}
// ---- deterministic PRNG (LCG). r = 4-byte state buffer. ----
fn rng_next(r:[]u8)i32 {
  let s:i32=get32(r,0);
  s=(s*1103515245+12345) & 2147483647;
  set32(r,0,s);
  return s;
}
fn rng_range(r:[]u8, n:i32)i32 {
  if(n<1){return 0;}
  let v:i32=rng_next(r);
  if(v<0){v=0-v;}
  return v % n;
}
fn rng_seed(r:[]u8, s:i32)void {
  set32(r,0,s & 2147483647);
  return;
}
// adv_world.zag -- SEALED worlds for the L3-SUF-1 adversary battery.
// Implements the FROZEN world interface (CODEFREEZE.md):
//   learner-visible: w_observe, w_test, w_stakes
//   harness-only:    w_truth, w_stakes_meta, w_undet
// WB layout is exactly the frozen layout (i32 header + regions):
//   0: nent   4: nctx   8: ntrain   12: nstakes
//   16: off_ent_ids (nent i32 ids)
//   20: off_ctx_ids (nctx i32 ids)
//   24: off_truth   (nctx*nent*nent bytes, d in {0,1})
//   28: off_probe   (nent*nent bytes, 1=probeable)
//   32: off_undet   (nent*nent bytes, 1=undetermined; key/scoring only)
//   36: off_train   (ntrain*4 i32s: s0i, xi, yi, d)   [indices]
//   40: off_stakes  (nstakes*5 i32s: s0i, xi, yi, is_heldout, det)
// The interface functions below are re-implemented to the frozen spec.
// The sealed content is a_build() (worlds 0..8). The learner NEVER calls
// w_truth / w_undet / w_stakes_meta (A-INFO boundary).

// ---- index helpers ----
fn w_ent_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,16);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_ctx_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,4);
  let off:i32=get32(wb,20);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_truth_idx(wb:[]u8, s0i:i32, xi:i32, yi:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,24);
  return wb[off+(s0i*n+xi)*n+yi] as i32;
}
// LEARNER-VISIBLE: TEST-PAIR/TRIPLE. Returns 1=ACCEPT, 0=REJECT.
// Unprobeable pairs withhold: REJECT every predicted value.
fn w_test(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32, v:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return 0;}
  if(xi<0){return 0;}
  if(yi<0){return 0;}
  let n:i32=get32(wb,0);
  let poff:i32=get32(wb,28);
  if(wb[poff+xi*n+yi]==0){return 0;}
  let t:i32=w_truth_idx(wb,s0i,xi,yi);
  if(t==v){return 1;}
  return 0;
}
// HARNESS ONLY: ground truth. The learner never calls this.
fn w_truth(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return -1;}
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  return w_truth_idx(wb,s0i,xi,yi);
}
// HARNESS ONLY: undetermined flag for a pair (key/scoring).
fn w_undet(wb:[]u8, x_id:i32, y_id:i32)i32 {
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,32);
  return wb[off+xi*n+yi] as i32;
}
// LEARNER-VISIBLE: OBSERVE. Fills out with (s0_id,x_id,y_id,d) quads.
fn w_observe(wb:[]u8, out:[]u8)i32 {
  let nt:i32=get32(wb,8);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let toff:i32=get32(wb,36);
  let i:i32=0;
  while(i<nt){
    let s0i:i32=get32(wb,toff+i*16);
    let xi:i32=get32(wb,toff+i*16+4);
    let yi:i32=get32(wb,toff+i*16+8);
    let d:i32=get32(wb,toff+i*16+12);
    set32(out,i*16,get32(wb,coff+s0i*4));
    set32(out,i*16+4,get32(wb,eoff+xi*4));
    set32(out,i*16+8,get32(wb,eoff+yi*4));
    set32(out,i*16+12,d);
    i=i+1;
  }
  return nt;
}
// LEARNER-VISIBLE: stakes sample. Fills out with (s0_id,x_id,y_id).
fn w_stakes(wb:[]u8, out:[]u8)i32 {
  let ns:i32=get32(wb,12);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let soff:i32=get32(wb,40);
  let i:i32=0;
  while(i<ns){
    let s0i:i32=get32(wb,soff+i*20);
    let xi:i32=get32(wb,soff+i*20+4);
    let yi:i32=get32(wb,soff+i*20+8);
    set32(out,i*12,get32(wb,coff+s0i*4));
    set32(out,i*12+4,get32(wb,eoff+xi*4));
    set32(out,i*12+8,get32(wb,eoff+yi*4));
    i=i+1;
  }
  return ns;
}
// HARNESS ONLY: (is_heldout, det_status) for stakes index i.
fn w_stakes_meta(wb:[]u8, i:i32, out:[]u8)void {
  let soff:i32=get32(wb,40);
  set32(out,0,get32(wb,soff+i*20+12));
  set32(out,4,get32(wb,soff+i*20+16));
  return;
}
// ---- Fisher-Yates shuffle of perm[0..n-1] ----
fn w_shuffle(r:[]u8, perm:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){set32(perm,i*4,i);i=i+1;}
  i=n-1;
  while(i>0){
    let j:i32=rng_range(r,i+1);
    let t:i32=get32(perm,i*4);
    set32(perm,i*4,get32(perm,j*4));
    set32(perm,j*4,t);
    i=i-1;
  }
  return;
}
fn w_pos_of(perm:[]u8, pos:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    let x:i32=get32(perm,i*4);
    set32(pos,x*4,i);
    i=i+1;
  }
  return;
}
// emit one training quad into the train region; returns new ti
fn w_emit_train(wb:[]u8, troff:i32, ti:i32, s0i:i32, xi:i32, yi:i32, d:i32)i32 {
  set32(wb,troff+ti*16,s0i);
  set32(wb,troff+ti*16+4,xi);
  set32(wb,troff+ti*16+8,yi);
  set32(wb,troff+ti*16+12,d);
  return ti+1;
}
// emit one stakes entry; returns new si
fn w_emit_stakes(wb:[]u8, soff:i32, si:i32, s0i:i32, xi:i32, yi:i32, held:i32, det:i32)i32 {
  set32(wb,soff+si*20,s0i);
  set32(wb,soff+si*20+4,xi);
  set32(wb,soff+si*20+8,yi);
  set32(wb,soff+si*20+12,held);
  set32(wb,soff+si*20+16,det);
  return si+1;
}
// mark pair (x,y) as U: unprobeable, undetermined, truth=anti-tiebreak
// on entity IDS (matches the learner's documented l_tiebreak on ids).
fn w_mark_u(wb:[]u8, nent:i32, toff:i32, poff:i32, uoff:i32, eoff:i32, x:i32, y:i32)void {
  let idx:i32=get32(wb,eoff+x*4);
  let idy:i32=get32(wb,eoff+y*4);
  let tb:i32=0;
  if(idx<idy){tb=1;}
  let ud:i32=1-tb;
  wb[poff+x*nent+y]=0;wb[poff+y*nent+x]=0;
  wb[uoff+x*nent+y]=1;wb[uoff+y*nent+x]=1;
  wb[toff+(0*nent+x)*nent+y]=ud as u8;
  wb[toff+(0*nent+y)*nent+x]=ud as u8;
  wb[toff+(1*nent+x)*nent+y]=ud as u8;
  wb[toff+(1*nent+y)*nent+x]=ud as u8;
  return;
}

// ================= SEALED: world-spec machinery =================
// WS buffer layout (world construction scratch, index-level):
//   0: ntr   4: nup   8: nov   12: nd   16: na   2304: nst
//   20: g0[100] (bytes)    120: g1[100]
//   220: used[100]
//   320: dlist[400] (100 i32 packed i*10+j)
//   720: alist[400]
//   1120: upairs[40] (10 i32 packed)
//   1160: ovp[40]   1200: ovv0[40]   1240: ovv1[40]  (overrides)
//   1280: trs[256]  1536: tri[256]  1792: trj[256]  2048: trd[256]
//   2308: sts[48]   2356: sti[48]   2404: stj[48]   2452: sth[48]   2500: std[48]
fn wg(ws:[]u8, g:i32, i:i32, j:i32)i32 {
  let base:i32=20;
  if(g==1){base=120;}
  return ws[base+i*10+j] as i32;
}
fn wg_set(ws:[]u8, g:i32, i:i32, j:i32, v:i32)void {
  let base:i32=20;
  if(g==1){base=120;}
  ws[base+i*10+j]=v as u8;
  return;
}
fn a_canon_a(i:i32, j:i32)i32 {
  if(i<j){return i;}
  return j;
}
fn a_canon_b(i:i32, j:i32)i32 {
  if(i<j){return j;}
  return i;
}
fn a_mark_used(ws:[]u8, i:i32, j:i32)void {
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  ws[220+a*10+b]=1;
  return;
}
fn a_is_used(ws:[]u8, i:i32, j:i32)i32 {
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  return ws[220+a*10+b] as i32;
}
fn a_tr_add(ws:[]u8, s:i32, i:i32, j:i32, d:i32)void {
  let n:i32=get32(ws,0);
  set32(ws,1280+n*4,s);
  set32(ws,1536+n*4,i);
  set32(ws,1792+n*4,j);
  set32(ws,2048+n*4,d);
  set32(ws,0,n+1);
  a_mark_used(ws,i,j);
  return;
}
fn a_st_add(ws:[]u8, s:i32, i:i32, j:i32, held:i32, det:i32)void {
  let n:i32=get32(ws,2304);
  set32(ws,2308+n*4,s);
  set32(ws,2356+n*4,i);
  set32(ws,2404+n*4,j);
  set32(ws,2452+n*4,held);
  set32(ws,2500+n*4,det);
  set32(ws,2304,n+1);
  return;
}
fn a_u_add(ws:[]u8, i:i32, j:i32)void {
  let n:i32=get32(ws,4);
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  set32(ws,1120+n*4,a*10+b);
  set32(ws,4,n+1);
  a_mark_used(ws,a,b);
  return;
}
fn a_ov_add(ws:[]u8, i:i32, j:i32, v0:i32, v1:i32)void {
  let n:i32=get32(ws,8);
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  set32(ws,1160+n*4,a*10+b);
  set32(ws,1200+n*4,v0);
  set32(ws,1240+n*4,v1);
  set32(ws,8,n+1);
  return;
}
// shuffle an i32 list in place
fn a_shuf_list(r:[]u8, list:[]u8, n:i32)void {
  let k:i32=n-1;
  while(k>0){
    let m:i32=rng_range(r,k+1);
    let t:i32=get32(list,k*4);
    set32(list,k*4,get32(list,m*4));
    set32(list,m*4,t);
    k=k-1;
  }
  return;
}
// truth generators. g0ord=1 -> ORD(perm0) else PAR; g1ord=1 -> ORD(perm1) else PAR.
// Then build D (disagree) and A (agree) lists, shuffled.
fn a_phase_gen(r:[]u8, ws:[]u8, seed:i32, g0ord:i32, g1ord:i32)void {
  rng_seed(r,seed);
  let perm0:[]u8=z_alloc(40);
  let perm1:[]u8=z_alloc(40);
  let pos0:[]u8=z_alloc(40);
  let pos1:[]u8=z_alloc(40);
  w_shuffle(r,perm0,10);
  w_shuffle(r,perm1,10);
  w_pos_of(perm0,pos0,10);
  w_pos_of(perm1,pos1,10);
  let g:i32=0;
  while(g<2){
    let gord:i32=g0ord;
    if(g==1){gord=g1ord;}
    let i:i32=0;
    while(i<10){
      let j:i32=0;
      while(j<10){
        let d:i32=0;
        if(i!=j){
          if(gord==1){
            let a:i32=a_canon_a(i,j);
            let b:i32=a_canon_b(i,j);
            let pa:i32=0;
            let pb:i32=0;
            if(g==0){pa=get32(pos0,a*4);pb=get32(pos0,b*4);}
            else {pa=get32(pos1,a*4);pb=get32(pos1,b*4);}
            if(pa<pb){d=1;}
          } else {
            if((i+j)%2==0){d=1;}
          }
        }
        wg_set(ws,g,i,j,d);
        j=j+1;
      }
      i=i+1;
    }
    g=g+1;
  }
  let nd:i32=0;
  let na:i32=0;
  let i2:i32=0;
  while(i2<10){
    let j2:i32=i2+1;
    while(j2<10){
      let d0:i32=wg(ws,0,i2,j2);
      let d1:i32=wg(ws,1,i2,j2);
      if(d0==d1){set32(ws,720+na*4,i2*10+j2);na=na+1;}
      else {set32(ws,320+nd*4,i2*10+j2);nd=nd+1;}
      j2=j2+1;
    }
    i2=i2+1;
  }
  // shuffle the D and A lists via temp copies
  let dl:[]u8=z_alloc(400);
  let al:[]u8=z_alloc(400);
  let k:i32=0;
  while(k<nd){set32(dl,k*4,get32(ws,320+k*4));k=k+1;}
  k=0;
  while(k<na){set32(al,k*4,get32(ws,720+k*4));k=k+1;}
  a_shuf_list(r,dl,nd);
  a_shuf_list(r,al,na);
  k=0;
  while(k<nd){set32(ws,320+k*4,get32(dl,k*4));k=k+1;}
  k=0;
  while(k<na){set32(ws,720+k*4,get32(al,k*4));k=k+1;}
  set32(ws,12,nd);
  set32(ws,16,na);
  return;
}
// unused-pair candidates, shuffled; returns count
fn a_unused_shuf(r:[]u8, ws:[]u8, cand:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){
      if(a_is_used(ws,i,j)==0){set32(cand,n*4,i*10+j);n=n+1;}
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,n);
  return n;
}
// ---- W0 INVENT-2: g0=ORD, g1=PAR; 6 D x2 + 8 A; U=4; decoys=2 ----
fn a_ph_w0(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1000,1,0);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    let i:i32=p/10;
    let j:i32=p%10;
    a_tr_add(ws,0,i,j,wg(ws,0,i,j));
    a_tr_add(ws,1,i,j,wg(ws,1,i,j));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let i:i32=p/10;
    let j:i32=p%10;
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,i,j,wg(ws,ci,i,j));
    k=k+1;
  }
  let cand:[]u8=z_alloc(400);
  a_unused_shuf(r,ws,cand);
  k=0;
  while(k<4){
    let p:i32=get32(cand,k*4);
    a_u_add(ws,p/10,p%10);
    k=k+1;
  }
  // decoys: probeable, truth overridden to ANTI-TB (ids 700+i; i<j -> tb=1 -> truth 0)
  let dq0:i32=get32(cand,4*4);
  let dq1:i32=get32(cand,5*4);
  a_ov_add(ws,dq0/10,dq0%10,0,0);
  a_ov_add(ws,dq1/10,dq1%10,0,0);
  a_mark_used(ws,dq0/10,dq0%10);
  a_mark_used(ws,dq1/10,dq1%10);
  set32(ws,2548,dq0);
  set32(ws,2552,dq1);
  // stakes (12)
  k=0;
  while(k<3){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,0,p/10,p%10,1,1);
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(ws,320+k*4);
    let s:i32=0;
    if(k==2){s=1;}
    a_st_add(ws,s,p/10,p%10,1,0);
    k=k+1;
  }
  let pu:i32=get32(ws,1120+3*4);
  a_st_add(ws,1,pu/10,pu%10,0,1);
  a_st_add(ws,0,dq0/10,dq0%10,0,0);
  a_st_add(ws,1,dq1/10,dq1%10,0,0);
  k=0;
  while(k<3){
    let p:i32=get32(ws,720+k*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-A WITHHELD-2: g0=ORD, g1=ORD; 6 D x ctx0 only + 14 A (alternating ctx) ----
fn a_ph_fa(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1001,1,1);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<14){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=k%2;
    a_tr_add(ws,ci,p/10,p%10,wg(ws,ci,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,0,p/10,p%10,1,0);
    a_st_add(ws,1,p/10,p%10,1,0);
    k=k+1;
  }
  k=0;
  while(k<6){
    let p:i32=get32(ws,720+((k+3)%na)*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-B UNDET-BLOCK: g0=ORD, g1=ORD; U=4 cross-block ----
fn a_ph_fb(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1002,1,1);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    a_tr_add(ws,1,p/10,p%10,wg(ws,1,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,p/10,p%10,wg(ws,ci,p/10,p%10));
    k=k+1;
  }
  // cross-block candidates: (i<5) != (j<5)
  let cand:[]u8=z_alloc(400);
  let nc:i32=0;
  let i:i32=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){
      let bi:i32=0;
      let bj:i32=0;
      if(i>=5){bi=1;}
      if(j>=5){bj=1;}
      if(bi!=bj){
        if(a_is_used(ws,i,j)==0){set32(cand,nc*4,i*10+j);nc=nc+1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,nc);
  k=0;
  while(k<4){
    let p:i32=get32(cand,k*4);
    a_u_add(ws,p/10,p%10);
    k=k+1;
  }
  // stakes: heldout 4 det (unused agreeing) + 2 U; extra 2 U + 4 det
  let ndet:i32=0;
  k=0;
  while(k<na){
    if(ndet<6){
      let p:i32=get32(ws,720+k*4);
      if(a_is_used(ws,p/10,p%10)==0){
        if(ndet<4){a_st_add(ws,0,p/10,p%10,1,0);}
        else {a_st_add(ws,1,p/10,p%10,0,0);}
        ndet=ndet+1;
      }
    }
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,0,p/10,p%10,1,1);
    k=k+1;
  }
  k=2;
  while(k<4){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,1,p/10,p%10,0,1);
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,k,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-C POISON-SWAP: oracle g0=ORD,g1=PAR; training swapped ----
fn a_ph_fc(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1003,1,0);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    let i:i32=p/10;
    let j:i32=p%10;
    a_tr_add(ws,0,i,j,wg(ws,1,i,j));
    a_tr_add(ws,1,i,j,wg(ws,0,i,j));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=rng_range(r,2);
    let cj:i32=1-ci;
    a_tr_add(ws,cj,p/10,p%10,wg(ws,cj,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,0,p/10,p%10,1,0);
    a_st_add(ws,1,p/10,p%10,1,0);
    k=k+1;
  }
  k=0;
  while(k<6){
    let p:i32=get32(ws,720+((k+5)%na)*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-D REUSE-SCATTER: g0=PAR, g1=ORD; U=5 scattered (i+j)%3==0 ----
fn a_ph_fd(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1004,0,1);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    a_tr_add(ws,1,p/10,p%10,wg(ws,1,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,p/10,p%10,wg(ws,ci,p/10,p%10));
    k=k+1;
  }
  let cand:[]u8=z_alloc(400);
  let nc:i32=0;
  let i:i32=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){
      if((i+j)%3==0){
        if(a_is_used(ws,i,j)==0){set32(cand,nc*4,i*10+j);nc=nc+1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,nc);
  k=0;
  while(k<5){
    let p:i32=get32(cand,k*4);
    a_u_add(ws,p/10,p%10);
    k=k+1;
  }
  let ndet:i32=0;
  k=0;
  while(k<na){
    if(ndet<6){
      let p:i32=get32(ws,720+k*4);
      if(a_is_used(ws,p/10,p%10)==0){
        if(ndet<4){a_st_add(ws,0,p/10,p%10,1,0);}
        else {a_st_add(ws,1,p/10,p%10,0,0);}
        ndet=ndet+1;
      }
    }
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,0,p/10,p%10,1,1);
    k=k+1;
  }
  k=2;
  while(k<4){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,1,p/10,p%10,0,1);
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,k,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}

// ---- F-G RETIRE-PLAIN: no gating (g1=g0); tempting extras ----
fn a_ph_fg(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1007,1,1);
  let i:i32=0;
  while(i<100){ws[120+i]=ws[20+i];i=i+1;}
  let allp:[]u8=z_alloc(400);
  let n:i32=0;
  i=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){set32(allp,n*4,i*10+j);n=n+1;j=j+1;}
    i=i+1;
  }
  a_shuf_list(r,allp,n);
  let k:i32=0;
  while(k<20){
    let p:i32=get32(allp,k*4);
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  // tempting: 6 untrained pairs: 3 ANTI-TB (0,0), 3 TB-consistent (1,1)
  // ids 770+i, i<j -> tb=1
  let cand:[]u8=z_alloc(400);
  a_unused_shuf(r,ws,cand);
  k=0;
  while(k<6){
    let p:i32=get32(cand,k*4);
    if(k<3){a_ov_add(ws,p/10,p%10,0,0);}
    else {a_ov_add(ws,p/10,p%10,1,1);}
    a_mark_used(ws,p/10,p%10);
    k=k+1;
  }
  k=0;
  while(k<6){
    a_st_add(ws,get32(ws,1280+k*4),get32(ws,1536+k*4),get32(ws,1792+k*4),1,0);
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(cand,k*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  k=3;
  while(k<6){
    let p:i32=get32(cand,k*4);
    a_st_add(ws,(k+1)%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- X-CTX CTX-NOVEL: all training at ctx0; unseen ctx1 queries ----
fn a_ph_fx(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1008,1,0);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<14){
    let p:i32=get32(ws,720+(k%na)*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  // unseen: 6 untrained pairs; ctx1 truth overridden to ANTI-TB (0)
  let cand:[]u8=z_alloc(400);
  a_unused_shuf(r,ws,cand);
  k=0;
  while(k<6){
    let p:i32=get32(cand,k*4);
    let pi2:i32=p/10;
    let pj2:i32=p%10;
    a_ov_add(ws,pi2,pj2,wg(ws,0,pi2,pj2),0);
    a_mark_used(ws,pi2,pj2);
    k=k+1;
  }
  k=0;
  while(k<3){
    a_st_add(ws,0,get32(ws,1536+k*4),get32(ws,1792+k*4),1,0);
    let p:i32=get32(cand,k*4);
    a_st_add(ws,1,p/10,p%10,1,1);
    k=k+1;
  }
  k=3;
  while(k<6){
    a_st_add(ws,0,get32(ws,1536+k*4),get32(ws,1792+k*4),0,0);
    let p:i32=get32(cand,k*4);
    a_st_add(ws,1,p/10,p%10,0,1);
    k=k+1;
  }
  return;
}
// ---- emit WS into WB ----
fn a_emit(ws:[]u8, wb:[]u8, entb:i32, c0id:i32)void {
  let nent:i32=10;
  let nctx:i32=2;
  set32(wb,0,nent);
  set32(wb,4,nctx);
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+nctx*4;
  let poff:i32=toff+nctx*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){set32(wb,eoff+i*4,entb+i);i=i+1;}
  set32(wb,coff,c0id);
  set32(wb,coff+4,c0id+1);
  let nov:i32=get32(ws,8);
  let c:i32=0;
  while(c<nctx){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        let a:i32=a_canon_a(i,j);
        let b:i32=a_canon_b(i,j);
        let v:i32=wg(ws,c,a,b);
        let kk:i32=0;
        while(kk<nov){
          if(get32(ws,1160+kk*4)==a*10+b){
            if(c==0){v=get32(ws,1200+kk*4);}
            else {v=get32(ws,1240+kk*4);}
          }
          kk=kk+1;
        }
        wb[toff+(c*nent+i)*nent+j]=v as u8;
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  i=0;
  while(i<nent*nent){wb[poff+i]=1;wb[uoff+i]=0;i=i+1;}
  let nup:i32=get32(ws,4);
  let k2:i32=0;
  while(k2<nup){
    let p:i32=get32(ws,1120+k2*4);
    w_mark_u(wb,nent,toff,poff,uoff,eoff,p/10,p%10);
    k2=k2+1;
  }
  let ntr:i32=get32(ws,0);
  set32(wb,8,ntr);
  let q:i32=0;
  let ti:i32=0;
  while(q<ntr){
    ti=w_emit_train(wb,troff,ti,get32(ws,1280+q*4),get32(ws,1536+q*4),get32(ws,1792+q*4),get32(ws,2048+q*4));
    q=q+1;
  }
  let soff:i32=troff+ntr*16;
  set32(wb,40,soff);
  let nst:i32=get32(ws,2304);
  set32(wb,12,nst);
  let s2:i32=0;
  let si:i32=0;
  while(s2<nst){
    si=w_emit_stakes(wb,soff,si,get32(ws,2308+s2*4),get32(ws,2356+s2*4),get32(ws,2404+s2*4),get32(ws,2452+s2*4),get32(ws,2500+s2*4));
    s2=s2+1;
  }
  return;
}
// ---- F-E RECODE-PERM: FD structure through pi (seed 1005) ----
fn a_build_fe(wb:[]u8, key:[]u8)void {
  let wbt:[]u8=z_alloc(65536);
  let keyt:[]u8=z_alloc(64);
  a_build(4,wbt,keyt);
  let r:[]u8=z_alloc(8);
  rng_seed(r,1005);
  let pi:[]u8=z_alloc(40);
  w_shuffle(r,pi,10);
  let pinv:[]u8=z_alloc(40);
  w_pos_of(pi,pinv,10);
  let nent:i32=10;
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+8;
  let poff:i32=toff+2*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,0,nent);
  set32(wb,4,2);
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){set32(wb,eoff+i*4,750+i);i=i+1;}
  set32(wb,coff,51);
  set32(wb,coff+4,52);
  let tbt:i32=get32(wbt,24);
  let pbt:i32=get32(wbt,28);
  let ubt:i32=get32(wbt,32);
  let c:i32=0;
  while(c<2){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        let a:i32=get32(pi,i*4);
        let b:i32=get32(pi,j*4);
        wb[toff+(c*nent+i)*nent+j]=wbt[tbt+(c*nent+a)*nent+b];
        wb[poff+i*nent+j]=wbt[pbt+a*nent+b];
        wb[uoff+i*nent+j]=wbt[ubt+a*nent+b];
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  // U truth: ANTI-TB in E ids (750+i sequential, i<j -> tb=1 -> truth 0)
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(wb[uoff+i*nent+j]==1){
        wb[toff+(0*nent+i)*nent+j]=0;
        wb[toff+(0*nent+j)*nent+i]=0;
        wb[toff+(1*nent+i)*nent+j]=0;
        wb[toff+(1*nent+j)*nent+i]=0;
      }
      j=j+1;
    }
    i=i+1;
  }
  let nt:i32=get32(wbt,8);
  let wtroff:i32=get32(wbt,36);
  set32(wb,8,nt);
  let k:i32=0;
  let ti:i32=0;
  while(k<nt){
    let s:i32=get32(wbt,wtroff+k*16);
    let a:i32=get32(wbt,wtroff+k*16+4);
    let b:i32=get32(wbt,wtroff+k*16+8);
    let d:i32=get32(wbt,wtroff+k*16+12);
    ti=w_emit_train(wb,troff,ti,s,get32(pinv,a*4),get32(pinv,b*4),d);
    k=k+1;
  }
  let soff:i32=troff+nt*16;
  set32(wb,40,soff);
  let ns:i32=get32(wbt,12);
  let wsoff:i32=get32(wbt,40);
  set32(wb,12,ns);
  let si:i32=0;
  k=0;
  while(k<ns){
    let s2:i32=get32(wbt,wsoff+k*20);
    let a2:i32=get32(wbt,wsoff+k*20+4);
    let b2:i32=get32(wbt,wsoff+k*20+8);
    let h2:i32=get32(wbt,wsoff+k*20+12);
    let m2:i32=get32(wbt,wsoff+k*20+16);
    si=w_emit_stakes(wb,soff,si,s2,get32(pinv,a2*4),get32(pinv,b2*4),h2,m2);
    k=k+1;
  }
  i=0;
  while(i<10){
    set32(key,i*4,get32(pi,i*4));
    set32(key,40+i*4,get32(pinv,i*4));
    i=i+1;
  }
  return;
}
// ---- F-F REGIME-5: FD base, fresh ids, S_ch (3 det->U, 2 U->det) ----
fn a_build_ff(wb:[]u8, key:[]u8)void {
  let wbt:[]u8=z_alloc(65536);
  let keyt:[]u8=z_alloc(64);
  a_build(4,wbt,keyt);
  let nent:i32=10;
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+8;
  let poff:i32=toff+2*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,0,nent);
  set32(wb,4,2);
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){set32(wb,eoff+i*4,760+i);i=i+1;}
  set32(wb,coff,53);
  set32(wb,coff+4,54);
  let tbt:i32=get32(wbt,24);
  let pbt:i32=get32(wbt,28);
  let ubt:i32=get32(wbt,32);
  let c:i32=0;
  while(c<2){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        wb[toff+(c*nent+i)*nent+j]=wbt[tbt+(c*nent+i)*nent+j];
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  i=0;
  while(i<nent*nent){
    wb[poff+i]=wbt[pbt+i];
    wb[uoff+i]=wbt[ubt+i];
    i=i+1;
  }
  let nt:i32=get32(wbt,8);
  let wtroff:i32=get32(wbt,36);
  set32(wb,8,nt);
  let k:i32=0;
  let ti:i32=0;
  while(k<nt){
    ti=w_emit_train(wb,troff,ti,get32(wbt,wtroff+k*16),get32(wbt,wtroff+k*16+4),get32(wbt,wtroff+k*16+8),get32(wbt,wtroff+k*16+12));
    k=k+1;
  }
  // in-training set
  let intr:[]u8=z_alloc(100);
  k=0;
  while(k<nt){
    let a:i32=get32(wb,troff+k*16+4);
    let b:i32=get32(wb,troff+k*16+8);
    intr[a_canon_a(a,b)*10+a_canon_b(a,b)]=1;
    k=k+1;
  }
  // generator truth for restored pairs: FD seed 1004, g0=PAR, g1=ORD(perm1)
  let r4:[]u8=z_alloc(8);
  rng_seed(r4,1004);
  let pm0:[]u8=z_alloc(40);
  let pm1:[]u8=z_alloc(40);
  let ps1:[]u8=z_alloc(40);
  w_shuffle(r4,pm0,10);
  w_shuffle(r4,pm1,10);
  w_pos_of(pm1,ps1,10);
  let r:[]u8=z_alloc(8);
  rng_seed(r,1006);
  // select R1,R2: first 2 index-order undet pairs (pure U_D)
  let r1i:i32=-1;
  let r1j:i32=-1;
  let r2i:i32=-1;
  let r2j:i32=-1;
  let nr:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(nr<2){
        if(wb[uoff+i*nent+j]==1){
          if(nr==0){r1i=i;r1j=j;}
          else {r2i=i;r2j=j;}
          nr=nr+1;
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // select N1..N3: det->U candidates (probeable, determined, untrained, not R1/R2)
  let cand:[]u8=z_alloc(400);
  let nc:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(wb[poff+i*nent+j]==1){
        if(wb[uoff+i*nent+j]==0){
          if(intr[i*10+j]==0){
            let isr:i32=0;
            if(i==r1i){if(j==r1j){isr=1;}}
            if(i==r2i){if(j==r2j){isr=1;}}
            if(isr==0){set32(cand,nc*4,i*10+j);nc=nc+1;}
          }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,nc);
  let n1i:[]u8=z_alloc(12);
  let n1j:[]u8=z_alloc(12);
  k=0;
  while(k<3){
    let p:i32=get32(cand,k*4);
    let a:i32=p/10;
    let b:i32=p%10;
    w_mark_u(wb,nent,toff,poff,uoff,eoff,a,b);
    set32(n1i,k*4,a);
    set32(n1j,k*4,b);
    set32(key,k*12,760+a);
    set32(key,k*12+4,760+b);
    set32(key,k*12+8,1);
    k=k+1;
  }
  // apply restores R1,R2
  let ri:i32=0;
  while(ri<2){
    let a:i32=r1i;
    let b:i32=r1j;
    if(ri==1){a=r2i;b=r2j;}
    wb[poff+a*nent+b]=1;wb[poff+b*nent+a]=1;
    wb[uoff+a*nent+b]=0;wb[uoff+b*nent+a]=0;
    let v0:i32=0;
    if((a+b)%2==0){v0=1;}
    let v1:i32=0;
    if(get32(ps1,a*4)<get32(ps1,b*4)){v1=1;}
    wb[toff+(0*nent+a)*nent+b]=v0 as u8;
    wb[toff+(0*nent+b)*nent+a]=v0 as u8;
    wb[toff+(1*nent+a)*nent+b]=v1 as u8;
    wb[toff+(1*nent+b)*nent+a]=v1 as u8;
    set32(key,(3+ri)*12,760+a);
    set32(key,(3+ri)*12+4,760+b);
    set32(key,(3+ri)*12+8,0);
    ri=ri+1;
  }
  // training: replace triple 12 (first agreeing) with R1 triple (observed path)
  let sr:i32=rng_range(r,2);
  let rv0:i32=0;
  if((r1i+r1j)%2==0){rv0=1;}
  let rv1:i32=0;
  if(get32(ps1,r1i*4)<get32(ps1,r1j*4)){rv1=1;}
  let rv:i32=rv0;
  if(sr==1){rv=rv1;}
  set32(wb,troff+12*16,sr);
  set32(wb,troff+12*16+4,r1i);
  set32(wb,troff+12*16+8,r1j);
  set32(wb,troff+12*16+12,rv);
  // Uold1,Uold2: first index-order undet pairs excluding N1..N3
  let uo1i:i32=-1;
  let uo1j:i32=-1;
  let uo2i:i32=-1;
  let uo2j:i32=-1;
  let nu2:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(nu2<2){
        if(wb[uoff+i*nent+j]==1){
          let isn:i32=0;
          let q:i32=0;
          while(q<3){
            if(i==get32(n1i,q*4)){if(j==get32(n1j,q*4)){isn=1;}}
            q=q+1;
          }
          if(isn==0){
            if(nu2==0){uo1i=i;uo1j=j;}
            else {uo2i=i;uo2j=j;}
            nu2=nu2+1;
          }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // D pairs from wbt training triples 0,2,4,6,8
  let d0i:i32=get32(wbt,wtroff+4);
  let d0j:i32=get32(wbt,wtroff+8);
  let d1i:i32=get32(wbt,wtroff+2*16+4);
  let d1j:i32=get32(wbt,wtroff+2*16+8);
  let d2i:i32=get32(wbt,wtroff+4*16+4);
  let d2j:i32=get32(wbt,wtroff+4*16+8);
  let d3i:i32=get32(wbt,wtroff+6*16+4);
  let d3j:i32=get32(wbt,wtroff+6*16+8);
  let d4i:i32=get32(wbt,wtroff+8*16+4);
  let d4j:i32=get32(wbt,wtroff+8*16+8);
  // stakes (12)
  let soff:i32=troff+nt*16;
  set32(wb,40,soff);
  let si:i32=0;
  si=w_emit_stakes(wb,soff,si,0,r1i,r1j,1,0);
  si=w_emit_stakes(wb,soff,si,0,d0i,d0j,1,0);
  si=w_emit_stakes(wb,soff,si,1,d1i,d1j,1,0);
  si=w_emit_stakes(wb,soff,si,0,d2i,d2j,1,0);
  si=w_emit_stakes(wb,soff,si,0,get32(n1i,0),get32(n1j,0),1,1);
  si=w_emit_stakes(wb,soff,si,0,uo1i,uo1j,1,1);
  si=w_emit_stakes(wb,soff,si,1,r2i,r2j,0,0);
  si=w_emit_stakes(wb,soff,si,0,d3i,d3j,0,0);
  si=w_emit_stakes(wb,soff,si,1,d4i,d4j,0,0);
  si=w_emit_stakes(wb,soff,si,1,get32(n1i,4),get32(n1j,4),0,1);
  si=w_emit_stakes(wb,soff,si,0,get32(n1i,8),get32(n1j,8),0,1);
  si=w_emit_stakes(wb,soff,si,1,uo2i,uo2j,0,1);
  set32(wb,12,si);
  return;
}
// ---- top-level sealed builder ----
// which: 0=W0 1=FA 2=FB 3=FC 4=FD 5=FE 6=FF 7=FG 8=XCTX
// key: which==5 -> pi[10] + pinv[10]; which==6 -> S_ch (x_id,y_id,new_det)x5
fn a_build(which:i32, wb:[]u8, key:[]u8)void {
  if(which==5){a_build_fe(wb,key);return;}
  if(which==6){a_build_ff(wb,key);return;}
  let r:[]u8=z_alloc(8);
  let ws:[]u8=z_alloc(2560);
  if(which==0){a_ph_w0(r,ws);}
  if(which==1){a_ph_fa(r,ws);}
  if(which==2){a_ph_fb(r,ws);}
  if(which==3){a_ph_fc(r,ws);}
  if(which==4){a_ph_fd(r,ws);}
  if(which==7){a_ph_fg(r,ws);}
  if(which==8){a_ph_fx(r,ws);}
  let entb:i32=700+which*10;
  let c0id:i32=41+which*2;
  a_emit(ws,wb,entb,c0id);
  if(which==0){
    // key: decoy id pairs (for the surgical-marking check)
    let dq0:i32=get32(ws,2548);
    let dq1:i32=get32(ws,2552);
    set32(key,0,entb+dq0/10);
    set32(key,4,entb+dq0%10);
    set32(key,8,entb+dq1/10);
    set32(key,12,entb+dq1%10);
  }
  return;
}
// learner.zag -- LEARNER side for L3-SUF-1 (treatment).
// Part 1: consequence log, surviving-set computation, flat forms,
// trace/proto emit, kb.
//
// SOURCE/AUDIT NOTE (A-LIT): this source contains NO resolution schema,
// NO marking rule ("mark unresolved when..."), NO abstention policy, and
// NO trigger counter/threshold. It contains: (a) a mechanical
// per-element consequence log (3c); (b) the sole-survivor principle at
// three scales (3d) computed as surviving value sets over that log;
// (c) the frozen escalation enumeration with generic replay (3e);
// (d) generic form-edit operators (ARITY-LIFT/GUARD/UNION/PROJECT);
// (e) a generic evaluator answering over the committed slot (3f).
// The three epistemic states are never named in source; they are the
// cardinalities (1/0/>1) of the surviving set. The per-element record
// STRUCTURE is created at runtime by ARITY-LIFT during escalation;
// its CONTENT is replayed from the consequence log (experience).

// ---- consequence log ----
// LOG layout: 0: nlog; 4: entries, 6 i32s each:
//   (elemkey, kind, value, outcome, fab, seq)
// elemkey = s0*1000000 + min(x,y)*1000 + max(x,y)  (ids < 1000)
// kind: 0=OBSERVE, 1=TEST, 2=STAKES
// outcome: 0=REJECT, 1=ACCEPT, 2=NEUTRAL(ABSTAIN)
// fab: 1 if the presented value came from the tie-break (no evidence)
fn l_ekey(s0:i32, x:i32, y:i32)i32 {
  let a:i32=x;
  let b:i32=y;
  if(a>b){let t:i32=a;a=b;b=t;}
  return s0*1000000+a*1000+b;
}
fn l_ekey_s0(ek:i32)i32 { return ek/1000000; }
fn l_log_touch(log:[]u8, ek:i32, kind:i32, value:i32, outcome:i32, fab:i32, seq:i32)i32 {
  let n:i32=get32(log,0);
  set32(log,4+n*24,ek);
  set32(log,4+n*24+4,kind);
  set32(log,4+n*24+8,value);
  set32(log,4+n*24+12,outcome);
  set32(log,4+n*24+16,fab);
  set32(log,4+n*24+20,seq);
  set32(log,0,n+1);
  return n+1;
}
// ---- surviving value set (sole-survivor at element scale) ----
// Returns bitmask: bit0 (1) = value 0 survives, bit1 (2) = value 1 survives.
// Derived ONLY from the consequence log. No thresholds, no counters,
// no world-property branches.
// Structural facts used:
//  (i)   worlds are deterministic, so both TEST-values REJECTed with
//        neither ACCEPTed and no observation means the world withholds
//        (unprobeable): no evidence either way -> both survive.
//  (ii)  a stakes REJECT on a fabricated (tie-break, fab=1) prediction
//        falsifies the act of predicting without evidence, not the
//        value: the element is explicitly not-known -> both survive.
//  (iii) otherwise a value is falsified by an observation of the other
//        value, a TEST REJECT of itself, or a TEST/STAKES ACCEPT of the
//        other value (evidence-backed).
fn l_surviving(log:[]u8, ek:i32)i32 {
  let o0:i32=0;
  let o1:i32=0;
  let r0r:i32=0;
  let r1r:i32=0;
  let r0a:i32=0;
  let r1a:i32=0;
  let fabrej:i32=0;
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let e:i32=get32(log,base);
    if(e==ek){
      let kd:i32=get32(log,base+4);
      let vv:i32=get32(log,base+8);
      let oc:i32=get32(log,base+12);
      let fb:i32=get32(log,base+16);
      if(kd==0){
        if(vv==0){o0=1;}
        if(vv==1){o1=1;}
      }
      if(kd==1){
        if(oc==0){
          if(vv==0){r0r=1;}
          if(vv==1){r1r=1;}
        }
        if(oc==1){
          if(vv==0){r0a=1;}
          if(vv==1){r1a=1;}
        }
      }
      if(kd==2){
        if(fb==1){
          if(oc==0){fabrej=1;}
        } else {
          if(oc==0){
            if(vv==0){r0r=1;}
            if(vv==1){r1r=1;}
          }
          if(oc==1){
            if(vv==0){r0a=1;}
            if(vv==1){r1a=1;}
          }
        }
      }
    }
    i=i+1;
  }
  let noobs:i32=0;
  if(o0==0){
    if(o1==0){noobs=1;}
  }
  if(noobs==1){
    if(r0r==1){
      if(r1r==1){
        if(r0a==0){
          if(r1a==0){return 3;}
        }
      }
    }
    if(fabrej==1){return 3;}
  }
  let f0:i32=0;
  if(o1==1){f0=1;}
  if(r0r==1){f0=1;}
  if(r1a==1){f0=1;}
  let f1:i32=0;
  if(o0==1){f1=1;}
  if(r1r==1){f1=1;}
  if(r0a==1){f1=1;}
  let s:i32=3;
  if(f0==1){s=s-1;}
  if(f1==1){s=s-2;}
  return s;
}
// provenance bitmask for an element (which evidence kinds touched it)
fn l_prov(log:[]u8, ek:i32)i32 {
  let p:i32=0;
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    if(get32(log,base)==ek){
      let kd:i32=get32(log,base+4);
      if(kd==0){p=p|1;}
      if(kd==1){p=p|2;}
      if(kd==2){p=p|4;}
    }
    i=i+1;
  }
  return p;
}
// ---- flat forms ----
// Form buffer:
//   0: kind (0=pairtable, 1=guarded, 2=graded)
//   4: n (entries)
//   8: rec_off (kind2: byte offset of record section; else 0)
//   12: entries (s0,x,y,d)*n, 16 bytes each (s0=-1 for kind0)
//   (kind2) rec_off: nrec i32, then (s0,x,y,mask,prov)*nrec, 20 bytes
// The DOCUMENTED ungraded bug (RK-B): default-fill by id order.
fn l_tiebreak(x:i32, y:i32)i32 {
  if(x<y){return 1;}
  return 0;
}
fn l_form_new(f:[]u8, kind:i32)void {
  set32(f,0,kind);
  set32(f,4,0);
  set32(f,8,0);
  return;
}
fn l_form_add(f:[]u8, s0:i32, x:i32, y:i32, d:i32)void {
  let n:i32=get32(f,4);
  let base:i32=12+n*16;
  set32(f,base,s0);
  set32(f,base+4,x);
  set32(f,base+8,y);
  set32(f,base+12,d);
  set32(f,4,n+1);
  return;
}
// find entry index or -1. kind0 ignores s0.
fn l_form_find(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let kind:i32=get32(f,0);
  let n:i32=get32(f,4);
  let i:i32=0;
  while(i<n){
    let base:i32=12+i*16;
    let es:i32=get32(f,base);
    let ex:i32=get32(f,base+4);
    let ey:i32=get32(f,base+8);
    let sm:i32=0;
    if(kind==0){sm=1;}
    else { if(es==s0){sm=1;} }
    if(sm==1){
      if(ex==x){
        if(ey==y){return i;}
      }
      if(ex==y){
        if(ey==x){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// record lookup for kind2; returns mask or -1 if absent
fn l_rec_lookup(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let roff:i32=get32(f,8);
  if(roff==0){return -1;}
  let nrec:i32=get32(f,roff);
  let i:i32=0;
  while(i<nrec){
    let base:i32=roff+4+i*20;
    let es:i32=get32(f,base);
    let ex:i32=get32(f,base+4);
    let ey:i32=get32(f,base+8);
    if(es==s0){
      let hit:i32=0;
      if(ex==x){ if(ey==y){hit=1;} }
      if(ex==y){ if(ey==x){hit=1;} }
      if(hit==1){return get32(f,base+12);}
    }
    i=i+1;
  }
  return -1;
}
// predict: out[0]=value (-1 ABSTAIN), out[1]=fab(1 if tie-break used)
fn l_predict2(f:[]u8, s0:i32, x:i32, y:i32, out:[]u8)void {
  let kind:i32=get32(f,0);
  if(kind==2){
    let m:i32=l_rec_lookup(f,s0,x,y);
    if(m==1){set32(out,0,0);set32(out,4,0);return;}
    if(m==2){set32(out,0,1);set32(out,4,0);return;}
    set32(out,0,-1);set32(out,4,0);return;
  }
  let fi:i32=l_form_find(f,s0,x,y);
  if(fi>=0){
    let d:i32=get32(f,12+fi*16+12);
    set32(out,0,d);set32(out,4,0);return;
  }
  set32(out,0,l_tiebreak(x,y));set32(out,4,1);return;
}
// ---- trace / proto emit ----
// trace line: S<seq> P<parent> <name> <a1> <a2> <a3> <a4>
fn l_tr(AS:[]u8, TR:[]u8, parent:i32, name:[]u8, a1:i32, a2:i32, a3:i32, a4:i32)i32 {
  let at:i32=get32(AS,68);
  let seq:i32=get32(AS,0);
  at=ob_app(TR,at,"S");
  at=ob_i32(TR,at,seq);
  at=ob_app(TR,at," P");
  at=ob_i32(TR,at,parent);
  at=ob_app(TR,at," ");
  at=ob_app(TR,at,name);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a1);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a2);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a3);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a4);
  at=ob_nl(TR,at);
  set32(AS,68,at);
  set32(AS,0,seq+1);
  return seq;
}
fn l_pr(AS:[]u8, PR:[]u8, s:[]u8)void {
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,s);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  return;
}
fn l_pr_test(AS:[]u8, PR:[]u8, s0:i32, x:i32, y:i32, v:i32, r:i32)void {
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> TEST s0=");
  at=ob_i32(PR,at,s0);
  at=ob_app(PR,at," x=");
  at=ob_i32(PR,at,x);
  at=ob_app(PR,at," y=");
  at=ob_i32(PR,at,y);
  at=ob_app(PR,at," v=");
  at=ob_i32(PR,at,v);
  if(r==1){at=ob_app(PR,at," => ACCEPT");}
  else {at=ob_app(PR,at," => REJECT");}
  at=ob_nl(PR,at);
  set32(AS,72,at);
  return;
}
// ---- kb ----
// KB layout: 0:valid 4:template(sticky max) 8:form copy (fixed 16KB region)
fn l_kb_store(KB:[]u8, f:[]u8, tmpl:i32)void {
  set32(KB,0,1);
  let old:i32=get32(KB,4);
  if(old>tmpl){tmpl=old;}
  set32(KB,4,tmpl);
  let i:i32=0;
  while(i<16384){
    KB[8+i]=f[i];
    i=i+1;
  }
  return;
}
fn l_kb_wipe(KB:[]u8)void {
  set32(KB,0,0);
  set32(KB,4,0);
  return;
}
// learner.zag part 2 -- build, probe, escalation, arm pipeline.
fn l_form_copy(src:[]u8, dst:[]u8)void {
  let i:i32=0;
  while(i<16384){
    dst[i]=src[i];
    i=i+1;
  }
  return;
}
// direct construction (L_old competence): pairtable if consistent,
// else per-s0 guarded form.
fn l_build_direct(train:[]u8, ntrain:i32, f:[]u8)void {
  let contra:i32=0;
  let i:i32=0;
  while(i<ntrain){
    let x0:i32=get32(train,i*16+4);
    let y0:i32=get32(train,i*16+8);
    let d0:i32=get32(train,i*16+12);
    let j:i32=i+1;
    while(j<ntrain){
      let x1:i32=get32(train,j*16+4);
      let y1:i32=get32(train,j*16+8);
      let d1:i32=get32(train,j*16+12);
      let same:i32=0;
      if(x0==x1){
        if(y0==y1){same=1;}
      }
      if(x0==y1){
        if(y0==x1){same=1;}
      }
      if(same==1){
        if(d0!=d1){contra=1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  if(contra==0){
    l_form_new(f,0);
  } else {
    l_form_new(f,1);
  }
  i=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    let ks:i32=s0;
    if(contra==0){ks=-1;}
    if(l_form_find(f,ks,x,y)<0){
      l_form_add(f,ks,x,y,d);
    }
    i=i+1;
  }
  return;
}
// strict training consistency (observations must be predicted)
fn l_train_consistent(f:[]u8, train:[]u8, ntrain:i32)i32 {
  let out:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    l_predict2(f,s0,x,y,out);
    let p:i32=get32(out,0);
    if(p!=d){return 0;}
    i=i+1;
  }
  return 1;
}
// generic replay consistency over the full history (3e).
// A predicted value that history REJECTed -> inconsistent.
// ABSTAIN is neutral (except on observations, which must be predicted).
fn l_replay_consistent(f:[]u8, log:[]u8, train:[]u8, ntrain:i32)i32 {
  let out:[]u8=z_alloc(8);
  if(l_train_consistent(f,train,ntrain)==0){return 0;}
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let ek:i32=get32(log,base);
    let kd:i32=get32(log,base+4);
    let vv:i32=get32(log,base+8);
    let oc:i32=get32(log,base+12);
    if(kd==1){
      if(oc==2){}
      else {
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        l_predict2(f,s0,a,b,out);
        let p:i32=get32(out,0);
        if(oc==1){
          if(p!=-1){
            if(p!=vv){return 0;}
          }
        }
        if(oc==0){
          if(p==vv){return 0;}
        }
      }
    }
    if(kd==2){
      if(oc==2){}
      else {
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        l_predict2(f,s0,a,b,out);
        let p:i32=get32(out,0);
        if(oc==1){
          if(p!=-1){
            if(p!=vv){return 0;}
          }
        }
        if(oc==0){
          if(p==vv){return 0;}
        }
      }
    }
    i=i+1;
  }
  return 1;
}
// one TEST through the protocol: world responds, log/prot/trace updated.
fn l_do_test(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, s0:i32, x:i32, y:i32, v:i32, fab:i32, parent:i32, tag:[]u8)i32 {
  let r:i32=w_test(WB,s0,x,y,v);
  let ek:i32=l_ekey(s0,x,y);
  let seq:i32=l_tr(AS,TR,parent,tag,s0,x,y,v);
  l_log_touch(LOG,ek,1,v,r,fab,seq);
  l_pr_test(AS,PR,s0,x,y,v,r);
  let tt:i32=get32(AS,4);
  set32(AS,4,tt+1);
  return r;
}
// probe phase: (a) slot-varying probes (vary s0, hold pair fixed),
// (b) staged both-values probes on unresolved pairs (TEST 0; if REJECT,
// TEST 1). Domain-blind: slot indices and ids only. Returns TESTs used.
fn l_probe_phase(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, f:[]u8, train:[]u8, ntrain:i32, budget:i32, parent:i32)i32 {
  let out:[]u8=z_alloc(8);
  let ents:[]u8=z_alloc(400);
  let ctxs:[]u8=z_alloc(400);
  // Use ALL world entities for probe coverage (not just training);
  // training-only ents can miss heldout entities, causing ABSTAINs
  // on determined heldout pairs.
  let nent_w:i32=get32(WB,0);
  let eoff_w:i32=get32(WB,16);
  let ne:i32=nent_w;
  let ei:i32=0;
  while(ei<nent_w){
    set32(ents,ei*4,get32(WB,eoff_w+ei*4));
    ei=ei+1;
  }
  let nc:i32=0;
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let j:i32=0;
    let found:i32=0;
    while(j<nc){
      if(get32(ctxs,j*4)==s0){found=1;}
      j=j+1;
    }
    if(found==0){set32(ctxs,nc*4,s0);nc=nc+1;}
    i=i+1;
  }
  let pseq:i32=l_tr(AS,TR,parent,"PROBE",ntrain,budget,0,0);
  let used:i32=0;
  // (a) slot-varying: for each training triple, other contexts
  i=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let j:i32=0;
    while(j<nc){
      let c:i32=get32(ctxs,j*4);
      if(c!=s0){
        if(used<budget){
          l_predict2(f,c,x,y,out);
          let v:i32=get32(out,0);
          let fb:i32=get32(out,4);
          if(v!=-1){
            let rr:i32=l_do_test(WB,AS,LOG,TR,PR,c,x,y,v,fb,pseq,"PVARY");
            used=used+1;
            let sv:i32=get32(AS,36);
            set32(AS,36,sv+1);
            // knowledge-REJECT: probe REJECTed a form knowledge prediction
            // (not a tiebreak fabrication). Signals a broken form.
            if(fb==0){
              if(rr==0){
                let nkr:i32=get32(AS,92);
                set32(AS,92,nkr+1);
                // active follow-up: try the flipped value, so the repair
                // build has positive evidence for this context.
                if(used<budget){
                  l_do_test(WB,AS,LOG,TR,PR,c,x,y,1-v,0,pseq,"PVARY2");
                  used=used+1;
                  let sv2:i32=get32(AS,36);
                  set32(AS,36,sv2+1);
                }
              }
            }
          }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // used-pair set from training (canonical id order)
  let usedp:[]u8=z_alloc(1600);
  i=0;
  while(i<1600){usedp[i]=0;i=i+1;}
  i=0;
  while(i<ntrain){
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let a:i32=x;
    let b:i32=y;
    if(a>b){let t:i32=a;a=b;b=t;}
    // map ids to small keys via position in ents (canonical order)
    let ia:i32=-1;
    let ib:i32=-1;
    let j:i32=0;
    while(j<ne){
      if(get32(ents,j*4)==a){ia=j;}
      if(get32(ents,j*4)==b){ib=j;}
      j=j+1;
    }
    if(ia>=0){
      if(ib>=0){
        let p1:i32=ia;
        let p2:i32=ib;
        if(p1>p2){let t:i32=p1;p1=p2;p2=t;}
        usedp[p1*40+p2]=1;
      }
    }
    i=i+1;
  }
  // (b) staged both-values on unresolved pairs, all contexts
  let a2:i32=0;
  while(a2<ne){
    let b2:i32=a2+1;
    while(b2<ne){
      if(usedp[a2*40+b2]==0){
        let x:i32=get32(ents,a2*4);
        let y:i32=get32(ents,b2*4);
        let j:i32=0;
        while(j<nc){
          let c:i32=get32(ctxs,j*4);
          if(used<budget){
            let r0:i32=l_do_test(WB,AS,LOG,TR,PR,c,x,y,0,0,pseq,"TEST");
            used=used+1;
            if(r0==0){
              if(used<budget){
                l_do_test(WB,AS,LOG,TR,PR,c,x,y,1,0,pseq,"TEST");
                used=used+1;
              }
            }
          }
          j=j+1;
        }
      }
      b2=b2+1;
    }
    a2=a2+1;
  }
  let tp:i32=get32(AS,8);
  set32(AS,8,tp+used);
  return used;
}
// (2a) guard re-expansion: rebuild kind1 from training + TEST-ACCEPTs
fn l_guard_reexpand(LOG:[]u8, train:[]u8, ntrain:i32, sc:[]u8)void {
  let aug:[]u8=z_alloc(8192);
  let na:i32=0;
  let i:i32=0;
  while(i<ntrain){
    set32(aug,na*16,get32(train,i*16));
    set32(aug,na*16+4,get32(train,i*16+4));
    set32(aug,na*16+8,get32(train,i*16+8));
    set32(aug,na*16+12,get32(train,i*16+12));
    na=na+1;
    i=i+1;
  }
  let n:i32=get32(LOG,0);
  i=0;
  while(i<n){
    let base:i32=4+i*24;
    let kd:i32=get32(LOG,base+4);
    let oc:i32=get32(LOG,base+12);
    if(kd==1){
      if(oc==1){
        let ek:i32=get32(LOG,base);
        let vv:i32=get32(LOG,base+8);
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        // add if (s0,a,b) not in aug
        let found:i32=0;
        let j:i32=0;
        while(j<na){
          let s2:i32=get32(aug,j*16);
          let x2:i32=get32(aug,j*16+4);
          let y2:i32=get32(aug,j*16+8);
          if(s2==s0){
            if(x2==a){
              if(y2==b){found=1;}
            }
            if(x2==b){
              if(y2==a){found=1;}
            }
          }
          j=j+1;
        }
        if(found==0){
          set32(aug,na*16,s0);
          set32(aug,na*16+4,a);
          set32(aug,na*16+8,b);
          set32(aug,na*16+12,vv);
          na=na+1;
        }
      }
    }
    i=i+1;
  }
  l_form_new(sc,1);
  i=0;
  while(i<na){
    let s0:i32=get32(aug,i*16);
    let x:i32=get32(aug,i*16+4);
    let y:i32=get32(aug,i*16+8);
    let d:i32=get32(aug,i*16+12);
    if(l_form_find(sc,s0,x,y)<0){
      l_form_add(sc,s0,x,y,d);
    }
    i=i+1;
  }
  return;
}
// (2b) union re-expansion: union current form with probe-derived entries
fn l_union_reexpand(f:[]u8, LOG:[]u8, sc:[]u8)void {
  l_form_copy(f,sc);
  // ensure kind1
  if(get32(sc,0)==0){
    // expand pairtable to per-s0: need s0 values; use -1 (keep simple:
    // union on pairtable = add probe-ACCEPT pairs)
  }
  if(get32(sc,0)==0){
    set32(sc,0,1);
  }
  let n:i32=get32(LOG,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let kd:i32=get32(LOG,base+4);
    let oc:i32=get32(LOG,base+12);
    if(kd==1){
      if(oc==1){
        let ek:i32=get32(LOG,base);
        let vv:i32=get32(LOG,base+8);
        let s0:i32=l_ekey_s0(ek);
        let ab:i32=ek%1000000;
        let a:i32=ab/1000;
        let b:i32=ab%1000;
        if(l_form_find(sc,s0,a,b)<0){
          l_form_add(sc,s0,a,b,vv);
        }
      }
    }
    i=i+1;
  }
  return;
}
// (3) ARITY-LIFT: kind1 -> kind2 (add per-element record slot)
fn l_arity_lift(f:[]u8)void {
  let kind:i32=get32(f,0);
  if(kind==0){
    // expand pairtable to guarded (one entry per s0=-1 kept; lift needs s0)
    // convert: keep kind0 entries but mark kind1 with s0=-1
    set32(f,0,1);
    kind=1;
  }
  if(kind!=1){return;}
  set32(f,0,2);
  let n:i32=get32(f,4);
  let roff:i32=12+n*16;
  set32(f,8,roff);
  set32(f,roff,0);
  return;
}
// fill/recompute the record from the consequence log (experience).
// Updates existing entries, adds new ones. Emits MARK per element.
fn l_fill_record(f:[]u8, LOG:[]u8, AS:[]u8, TR:[]u8, parent:i32)void {
  let roff:i32=get32(f,8);
  if(roff==0){return;}
  let nrec:i32=get32(f,roff);
  let n:i32=get32(LOG,0);
  let i:i32=0;
  while(i<n){
    let ek:i32=get32(LOG,4+i*24);
    let s0:i32=l_ekey_s0(ek);
    let ab:i32=ek%1000000;
    let a:i32=ab/1000;
    let b:i32=ab%1000;
    let mask:i32=l_surviving(LOG,ek);
    let prov:i32=l_prov(LOG,ek);
    // find existing
    let fi:i32=-1;
    let j:i32=0;
    while(j<nrec){
      let b2:i32=roff+4+j*20;
      let es:i32=get32(f,b2);
      let ex:i32=get32(f,b2+4);
      let ey:i32=get32(f,b2+8);
      if(es==s0){
        let hit:i32=0;
        if(ex==a){ if(ey==b){hit=1;} }
        if(ex==b){ if(ey==a){hit=1;} }
        if(hit==1){fi=j;}
      }
      j=j+1;
    }
    if(fi<0){
      let b3:i32=roff+4+nrec*20;
      set32(f,b3,s0);
      set32(f,b3+4,a);
      set32(f,b3+8,b);
      set32(f,b3+12,mask);
      set32(f,b3+16,prov);
      nrec=nrec+1;
      set32(f,roff,nrec);
    } else {
      let b3:i32=roff+4+fi*20;
      set32(f,b3+12,mask);
      set32(f,b3+16,prov);
    }
    let seq:i32=l_tr(AS,TR,parent,"MARK",ek,mask,prov,0);
    let mt:i32=get32(AS,76);
    set32(AS,76,mt+1);
    if(mask==3){
      let um:i32=get32(AS,44);
      set32(AS,44,um+1);
      let fms:i32=get32(AS,20);
      if(fms==0){set32(AS,20,seq);}
    }
    i=i+1;
  }
  return;
}
// simplify: PROJECT away redundant structure (structural, not a mode).
// NOTE: kind2->kind1 is NOT done here; the record's ABSTAIN-on-unknown
// is load-bearing (dropping it reintroduces fabrication). Only the
// kind1->kind0 collapse is attempted, and only if fully consistent.
fn l_simplify(AS:[]u8, TR:[]u8, LOG:[]u8, f:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)void {
  let kind:i32=get32(f,0);
  if(kind==1){
    l_form_new(sc,0);
    let i:i32=0;
    while(i<ntrain){
      let x:i32=get32(train,i*16+4);
      let y:i32=get32(train,i*16+8);
      let d:i32=get32(train,i*16+12);
      if(l_form_find(sc,-1,x,y)<0){
        l_form_add(sc,-1,x,y,d);
      }
      i=i+1;
    }
    if(l_replay_consistent(sc,LOG,train,ntrain)==1){
      l_form_copy(sc,f);
      l_tr(AS,TR,parent,"PROJECT",1,0,0,0);
      set32(AS,84,1);
    }
  }
  return;
}
// committable? graded: full-history replay; ungraded: training fit.
fn l_committable(f:[]u8, LOG:[]u8, train:[]u8, ntrain:i32)i32 {
  let kind:i32=get32(f,0);
  if(kind==2){
    return l_replay_consistent(f,LOG,train,ntrain);
  }
  return l_train_consistent(f,train,ntrain);
}
// escalation enumeration (frozen order):
// (1) further probing < (2a) guard re-expansion < (2b) union re-expansion
// < (3) resolution-slot lifting. Adopt the first composition rendering
// the full history consistent under generic replay.
// Returns 1 if adopted (f updated), 0 if none (caller DEFERS).
fn l_escalate(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, f:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let esc:i32=l_tr(AS,TR,parent,"ESCALATE",0,0,0,0);
  let t1:i32=l_tr(AS,TR,esc,"FORM_TRY",1,0,0,0);
  l_probe_phase(WB,AS,LOG,TR,PR,f,train,ntrain,500,t1);
  if(l_replay_consistent(f,LOG,train,ntrain)==1){
    l_tr(AS,TR,t1,"TRY_OK",1,0,0,0);
    return 1;
  }
  l_tr(AS,TR,t1,"TRY_FAIL",1,0,0,0);
  let t2:i32=l_tr(AS,TR,esc,"FORM_TRY",2,0,0,0);
  l_guard_reexpand(LOG,train,ntrain,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,t2,"TRY_OK",2,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_tr(AS,TR,t2,"TRY_FAIL",2,0,0,0);
  let of:i32=get32(AS,28);
  set32(AS,28,of+1);
  let t3:i32=l_tr(AS,TR,esc,"FORM_TRY",3,0,0,0);
  l_union_reexpand(f,LOG,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,t3,"TRY_OK",3,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_tr(AS,TR,t3,"TRY_FAIL",3,0,0,0);
  set32(AS,28,of+2);
  let t4:i32=l_tr(AS,TR,esc,"FORM_TRY",4,0,0,0);
  l_form_copy(f,sc);
  if(get32(sc,0)==0){
    // expand pairtable to guarded before lifting
    let tmp:[]u8=z_alloc(16384);
    l_form_new(tmp,1);
    let n0:i32=get32(sc,4);
    let i:i32=0;
    while(i<n0){
      let b:i32=12+i*16;
      l_form_add(tmp,get32(sc,b),get32(sc,b+4),get32(sc,b+8),get32(sc,b+12));
      i=i+1;
    }
    l_form_copy(tmp,sc);
  }
  l_arity_lift(sc);
  l_fill_record(sc,LOG,AS,TR,t4);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,t4,"TRY_OK",4,0,0,0);
    l_form_copy(sc,f);
    let nr:i32=get32(AS,32);
    set32(AS,32,nr+1);
    return 1;
  }
  l_tr(AS,TR,t4,"TRY_FAIL",4,0,0,0);
  return 0;
}
// DEFER certificate from history structure:
// 2=DATA-UNTRUSTED (OBSERVE vs TEST disagree on an element),
// 1=INADEQUACY otherwise.
fn l_certify(LOG:[]u8)i32 {
  let n:i32=get32(LOG,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let kd:i32=get32(LOG,base+4);
    if(kd==1){
      let ek:i32=get32(LOG,base);
      let vv:i32=get32(LOG,base+8);
      let oc:i32=get32(LOG,base+12);
      // find an OBSERVE on ek with a different value
      let j:i32=0;
      while(j<n){
        let b2:i32=4+j*24;
        if(get32(LOG,b2+4)==0){
          if(get32(LOG,b2)==ek){
            let ov:i32=get32(LOG,b2+8);
            if(ov!=vv){
              if(oc==1){return 2;}
            }
            if(ov==vv){
              if(oc==0){return 2;}
            }
          }
        }
        j=j+1;
      }
    }
    i=i+1;
  }
  return 1;
}
fn l_commit(AS:[]u8, TR:[]u8, PR:[]u8, KB:[]u8, f:[]u8, parent:i32)i32 {
  let kind:i32=get32(f,0);
  let seq:i32=l_tr(AS,TR,parent,"COMMIT",kind,0,0,0);
  l_pr(AS,PR,"> COMMIT");
  set32(AS,48,1);
  set32(AS,88,kind);
  l_kb_store(KB,f,kind);
  l_tr(AS,TR,seq,"KB_STORE",kind,0,0,0);
  return seq;
}
// try_improve: if the current ungraded form is not replay-consistent,
// try (2a)/(2b) to fix it with probe evidence. Adopt the first
// consistent one. Returns 1 if adopted.
// (Pre-commit form improvement; never downgrades kind2, never lifts.)
fn l_try_improve(AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, f:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let kind:i32=get32(f,0);
  if(kind==2){return 0;}
  if(l_replay_consistent(f,LOG,train,ntrain)==1){return 0;}
  let imp:i32=l_tr(AS,TR,parent,"IMPROVE",0,0,0,0);
  l_guard_reexpand(LOG,train,ntrain,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,imp,"IMPROVE_OK",2,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_union_reexpand(f,LOG,sc);
  if(l_replay_consistent(sc,LOG,train,ntrain)==1){
    l_tr(AS,TR,imp,"IMPROVE_OK",3,0,0,0);
    l_form_copy(sc,f);
    return 1;
  }
  l_tr(AS,TR,imp,"IMPROVE_FAIL",0,0,0,0);
  return 0;
}
fn l_defer(AS:[]u8, TR:[]u8, PR:[]u8, cert:i32, parent:i32)void {
  l_tr(AS,TR,parent,"DEFER",cert,0,0,0);
  if(cert==2){l_pr(AS,PR,"> DEFER cert=DATA-UNTRUSTED");}
  else {l_pr(AS,PR,"> DEFER cert=INADEQUACY");}
  set32(AS,56,cert);
  return;
}
// learner.zag part 3 -- treatment arm pipeline pieces.
// The driver (harness) orchestrates: setup -> try_commit -> stakes
// (harness-scored) -> revise loop. These are the learner-side steps.

// forced guarded build (for kb-template-2 instantiate)
fn l_build_guarded(train:[]u8, ntrain:i32, f:[]u8)void {
  l_form_new(f,1);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    if(l_form_find(f,s0,x,y)<0){
      l_form_add(f,s0,x,y,d);
    }
    i=i+1;
  }
  return;
}
// setup: OBSERVE, BUILD (kb-aware), PROBE, lift+fill (if template 2),
// SIMPLIFY. train/form/sc are scratch. Returns ntrain.
fn l_arm_setup(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  // proto: > OBSERVE
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> OBSERVE n=");
  at=ob_i32(PR,at,ntrain);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    let ek:i32=l_ekey(s0,x,y);
    l_log_touch(LOG,ek,0,d,1,0,ob);
    i=i+1;
  }
  let kbv:i32=get32(KB,0);
  let tmpl:i32=get32(KB,4);
  let bseq:i32=0;
  if(kbv==1){
    l_tr(AS,TR,ob,"KB_LOAD",tmpl,0,0,0);
    set32(AS,60,1);
  }
  l_build_direct(train,ntrain,form);
  bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  l_probe_phase(WB,AS,LOG,TR,PR,form,train,ntrain,150,bseq);
  // fix the form with probe evidence if broken (pre-commit improvement).
  // Gated: only when probes REJECTed knowledge predictions (not mere
  // tiebreak fabrications). A spurious upgrade on clean worlds would
  // force an unnecessary lift.
  if(get32(AS,92)>0){
    l_try_improve(AS,LOG,TR,PR,form,sc,train,ntrain,bseq);
  }
  // instantiate the kb resolution template (if kind1)
  if(kbv==1){
    if(tmpl==2){
      if(get32(form,0)==1){
        let ls:i32=l_tr(AS,TR,bseq,"LIFT",0,0,0,0);
        l_arity_lift(form);
        l_fill_record(form,LOG,AS,TR,ls);
      }
    }
  }
  l_simplify(AS,TR,LOG,form,sc,train,ntrain,bseq);
  return ntrain;
}
// try commit:
//  1. knowledge-REJECTed (form was broken by probes):
//       replay-consistent now -> COMMIT; else DATA-UNTRUSTED -> DEFER,
//       else INADEQUACY -> DEFER.
//  2. replay-consistent -> COMMIT.
//  3. DATA-UNTRUSTED (OBSERVE vs TEST) -> DEFER.
//  4. graded (kind2) but inconsistent: escalate now; commit or defer.
//  5. else COMMIT the best ungraded form (stakes adjudicate; the
//     post-stakes escalation invents if needed).
// Returns commit seq, or -1 on DEFER.
fn l_arm_try_commit(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  if(get32(AS,92)>0){
    if(l_replay_consistent(form,LOG,train,ntrain)==1){
      let cs:i32=l_commit(AS,TR,PR,KB,form,parent);
      return cs;
    }
    l_defer(AS,TR,PR,l_certify(LOG),parent);
    return -1;
  }
  if(l_replay_consistent(form,LOG,train,ntrain)==1){
    let cs2:i32=l_commit(AS,TR,PR,KB,form,parent);
    return cs2;
  }
  if(l_certify(LOG)==2){
    l_defer(AS,TR,PR,2,parent);
    return -1;
  }
  // best available ungraded form; commit (stakes will falsify if needed)
  let kind:i32=get32(form,0);
  if(kind==2){
    // graded but inconsistent and not data-untrusted: escalate now
    if(l_escalate(WB,AS,LOG,TR,PR,form,sc,train,ntrain,parent)==1){
      let cs3:i32=l_commit(AS,TR,PR,KB,form,parent);
      return cs3;
    }
    l_defer(AS,TR,PR,l_certify(LOG),parent);
    return -1;
  }
  let cs4:i32=l_commit(AS,TR,PR,KB,form,parent);
  return cs4;
}
// revise after stakes REJECTs: escalate; re-commit or defer.
// Returns commit seq or -1.
fn l_arm_revise(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let rv:i32=l_tr(AS,TR,parent,"REVISE",0,0,0,0);
  if(l_escalate(WB,AS,LOG,TR,PR,form,sc,train,ntrain,rv)==1){
    let cs:i32=l_commit(AS,TR,PR,KB,form,rv);
    return cs;
  }
  l_defer(AS,TR,PR,l_certify(LOG),rv);
  return -1;
}
// controls.zag -- C0 (ungraded baseline), C1 (memorize+1NN), C3 (no-reverify).
// C2 (wiped) is the treatment pipeline with a wiped kb (driver-side).

// C0: L_old. No consequence log, no escalation, no marking, no
// re-verification. Direct build, L_old verify-probe, commit, stakes.
// Must be confidently wrong on W0/FA/FB/FC (discrimination gate) and
// on T1/T2/T3 (SUF-K6).
fn c0_run(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  l_build_direct(train,ntrain,form);
  let bseq:i32=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  // L_old probe-then-commit: verify each training prediction once.
  // No slot-varying, no consequence log (the RK-A/RK-B/RK-C bugs).
  let out:[]u8=z_alloc(8);
  let pseq:i32=l_tr(AS,TR,bseq,"PROBE",ntrain,0,0,0);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    l_predict2(form,s0,x,y,out);
    let v:i32=get32(out,0);
    if(v!=-1){
      let r:i32=w_test(WB,s0,x,y,v);
      l_tr(AS,TR,pseq,"TEST",s0,x,y,v);
      l_pr_test(AS,PR,s0,x,y,v,r);
      let tt:i32=get32(AS,4);
      set32(AS,4,tt+1);
    }
    i=i+1;
  }
  if(l_train_consistent(form,train,ntrain)==1){
    let cs:i32=l_tr(AS,TR,pseq,"COMMIT",get32(form,0),0,0,0);
    l_pr(AS,PR,"> COMMIT");
    set32(AS,48,1);
    set32(AS,88,get32(form,0));
    return cs;
  }
  l_tr(AS,TR,pseq,"DEFER",1,0,0,0);
  set32(AS,56,1);
  return -1;
}
// C1: memorize training; answer by 1-nearest-neighbor (id distance).
// mem: (s0,x,y,d)*n. Never abstains. Must fail T2.
fn c1_observe(WB:[]u8, mem:[]u8)i32 {
  let ntrain:i32=w_observe(WB,mem);
  set32(mem,4092,ntrain);
  return ntrain;
}
fn c1_answer(mem:[]u8, s0:i32, x:i32, y:i32)i32 {
  let ntrain:i32=get32(mem,4092);
  let best:i32=-1;
  let bd:i32=1000000000;
  let i:i32=0;
  while(i<ntrain){
    let s2:i32=get32(mem,i*16);
    let x2:i32=get32(mem,i*16+4);
    let y2:i32=get32(mem,i*16+8);
    let d2:i32=get32(mem,i*16+12);
    let dd:i32=s2-s0;
    if(dd<0){dd=0-dd;}
    let dx:i32=x2-x;
    if(dx<0){dx=0-dx;}
    let dy:i32=y2-y;
    if(dy<0){dy=0-dy;}
    let dist:i32=dd+dx+dy;
    if(dist<bd){
      bd=dist;
      best=d2;
    }
    i=i+1;
  }
  if(best<0){return 0;}
  return best;
}
// C3: treatment MINUS re-verification (no probe/verification TESTs).
// Consequence logging + escalation + marking intact. Must commit
// confidently wrong on T3 (proves re-verification is the fix; SUF-K9).
fn c3_run(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    l_log_touch(LOG,l_ekey(s0,x,y),0,d,1,0,ob);
    i=i+1;
  }
  let kbv:i32=get32(KB,0);
  let tmpl:i32=get32(KB,4);
  let bseq:i32=0;
  if(kbv==1){
    l_tr(AS,TR,ob,"KB_LOAD",tmpl,0,0,0);
    set32(AS,60,1);
    if(tmpl==2){
      l_build_guarded(train,ntrain,form);
      bseq=l_tr(AS,TR,ob,"BUILD",1,1,0,0);
      let ls:i32=l_tr(AS,TR,bseq,"LIFT",0,0,0,0);
      l_arity_lift(form);
      l_fill_record(form,LOG,AS,TR,ls);
    } else {
      l_build_direct(train,ntrain,form);
      bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
    }
  } else {
    l_build_direct(train,ntrain,form);
    bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  }
  // NO probe phase (no re-verification) -- the RK-C behavior.
  l_simplify(AS,TR,LOG,form,sc,train,ntrain,bseq);
  if(l_committable(form,LOG,train,ntrain)==1){
    let cs:i32=l_commit(AS,TR,PR,KB,form,bseq);
    return cs;
  }
  l_defer(AS,TR,PR,l_certify(LOG),bseq);
  return -1;
}
// driver.zag -- harness for L3-SUF-1 builder DEV battery.
// h_ functions are harness (may call w_truth/w_stakes_meta/w_undet
// for scoring; the learner l_ functions never do -- A-INFO boundary).
// The driver runs: discrimination gate, treatment T0..T7 (one continuing
// learner, kb persists), controls C0/C1/C2/C3, then evaluates the frozen
// bars. 3/3 byte-identical run logs; digests via sha256sum (shell).

// ---- harness-scored stakes ----
// mode 0: answer via l_predict2(form); mode 1: c1_answer(mem).
// sres: nstakes*3 i32s (v_pred, oc, fab). Returns REJECT count.
fn h_stakes(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, mode:i32, mem:[]u8, sres:[]u8)i32 {
  let sq:[]u8=z_alloc(1024);
  let out:[]u8=z_alloc(8);
  let ns:i32=w_stakes(WB,sq);
  let ss:i32=l_tr(AS,TR,0,"STAKES",ns,0,0,0);
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> STAKES n=");
  at=ob_i32(PR,at,ns);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  let nrej:i32=0;
  let i:i32=0;
  while(i<ns){
    let s0:i32=get32(sq,i*12);
    let x:i32=get32(sq,i*12+4);
    let y:i32=get32(sq,i*12+8);
    let v:i32=-1;
    let fb:i32=0;
    if(mode==0){
      l_predict2(form,s0,x,y,out);
      v=get32(out,0);
      fb=get32(out,4);
    } else {
      v=c1_answer(mem,s0,x,y);
      fb=0;
    }
    let ek:i32=l_ekey(s0,x,y);
    if(v==-1){
      let seq:i32=l_tr(AS,TR,ss,"ABSTAIN",ek,0,0,0);
      l_pr(AS,PR,"> ABSTAIN");
      l_log_touch(LOG,ek,2,-1,2,0,seq);
      let na:i32=get32(AS,64);
      set32(AS,64,na+1);
      set32(sres,i*12,-1);
      set32(sres,i*12+4,2);
      set32(sres,i*12+8,0);
    } else {
      let t:i32=w_truth(WB,s0,x,y);
      let oc:i32=0;
      if(t==v){oc=1;}
      let seq:i32=l_tr(AS,TR,ss,"SANS",ek,v,oc,0);
      let at2:i32=get32(AS,72);
      at2=ob_app(PR,at2,"> SANS s0=");
      at2=ob_i32(PR,at2,s0);
      at2=ob_app(PR,at2," x=");
      at2=ob_i32(PR,at2,x);
      at2=ob_app(PR,at2," y=");
      at2=ob_i32(PR,at2,y);
      at2=ob_app(PR,at2," v=");
      at2=ob_i32(PR,at2,v);
      if(oc==1){at2=ob_app(PR,at2," => ACCEPT");}
      else {at2=ob_app(PR,at2," => REJECT");}
      at2=ob_nl(PR,at2);
      set32(AS,72,at2);
      l_log_touch(LOG,ek,2,v,oc,fb,seq);
      set32(sres,i*12,v);
      set32(sres,i*12+4,oc);
      set32(sres,i*12+8,fb);
      if(oc==0){
        nrej=nrej+1;
        let fcs:i32=get32(AS,24);
        if(fcs==0){set32(AS,24,seq);}
        set32(AS,52,1);
      }
    }
    i=i+1;
  }
  return nrej;
}
fn h_zero_as(AS:[]u8)void {
  let i:i32=0;
  while(i<256){AS[i]=0;i=i+1;}
  return;
}
// ---- treatment arm ----
fn h_treat_arm(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  set32(LOG,0,0);
  let ntrain:i32=l_arm_setup(WB,KB,AS,LOG,TR,PR,train,form,sc);
  let cs:i32=l_arm_try_commit(WB,KB,AS,LOG,TR,PR,form,sc,train,ntrain,0);
  if(cs<0){return -1;}
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  let rounds:i32=0;
  while(nrej>0){
    if(rounds>=2){break;}
    let tt:i32=get32(AS,4);
    if(tt>=2000){break;}
    let cs2:i32=l_arm_revise(WB,KB,AS,LOG,TR,PR,form,sc,train,ntrain,cs);
    if(cs2<0){break;}
    nrej=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
    rounds=rounds+1;
  }
  return nrej;
}
// ---- C0 arm ----
fn h_c0_arm(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  let cs:i32=c0_run(WB,AS,TR,PR,train,form);
  if(cs<0){return -1;}
  let LOG:[]u8=z_alloc(32768);
  set32(LOG,0,0);
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  return nrej;
}
// ---- C1 arm ----
fn h_c1_arm(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, mem:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  let ntrain:i32=c1_observe(WB,mem);
  l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  l_tr(AS,TR,0,"COMMIT",9,0,0,0);
  set32(AS,48,1);
  let LOG:[]u8=z_alloc(32768);
  set32(LOG,0,0);
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,mem,1,mem,sres);
  return nrej;
}
// ---- C3 arm ----
fn h_c3_arm(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  set32(LOG,0,0);
  let cs:i32=c3_run(WB,KB,AS,LOG,TR,PR,train,form,sc);
  if(cs<0){return -1;}
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  return nrej;
}
// ---- scoring helpers (harness) ----
// heldout tallies from sres: returns packed (wrong, correct_det, abst_und, D_det, D_und)
fn h_held_tally(WB:[]u8, sres:[]u8, out:[]u8)void {
  let ns:i32=get32(WB,12);
  let meta:[]u8=z_alloc(8);
  let wrong:i32=0;
  let cdet:i32=0;
  let aud:i32=0;
  let ddet:i32=0;
  let dund:i32=0;
  let i:i32=0;
  while(i<ns){
    w_stakes_meta(WB,i,meta);
    let held:i32=get32(meta,0);
    let det:i32=get32(meta,4);
    if(held==1){
      let v:i32=get32(sres,i*12);
      let so:i32=get32(WB,get32(WB,40)+i*20);
      let sx:i32=get32(WB,get32(WB,40)+i*20+4);
      let sy:i32=get32(WB,get32(WB,40)+i*20+8);
      // map indices to ids for w_truth
      let eoff:i32=get32(WB,16);
      let coff:i32=get32(WB,20);
      let t:i32=w_truth_idx(WB,so,sx,sy);
      if(det==0){
        ddet=ddet+1;
        if(v==-1){}
        else {
          if(v==t){cdet=cdet+1;}
          else {wrong=wrong+1;}
        }
      } else {
        dund=dund+1;
        if(v==-1){aud=aud+1;}
        else {
          // F-FABRICATION: any predicted undetermined pair is wrong,
          // even if luckily correct (it was not abstained).
          wrong=wrong+1;
        }
      }
    }
    i=i+1;
  }
  set32(out,0,wrong);
  set32(out,4,cdet);
  set32(out,8,aud);
  set32(out,12,ddet);
  set32(out,16,dund);
  return;
}
// T0(iii) / stakes-shape check on the LAST sres:
// det queries: no REJECT; undet queries: all ABSTAIN.
fn h_stakes_shape(WB:[]u8, sres:[]u8)i32 {
  let ns:i32=get32(WB,12);
  let meta:[]u8=z_alloc(8);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    w_stakes_meta(WB,i,meta);
    let det:i32=get32(meta,4);
    let v:i32=get32(sres,i*12);
    let oc:i32=get32(sres,i*12+4);
    if(det==0){
      if(oc==0){ok=0;}
    } else {
      if(v!=-1){ok=0;}
    }
    i=i+1;
  }
  return ok;
}
fn d_bar2(ob:[]u8, atp:[]u8, name:[]u8, pass:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  if(pass==1){at=ob_app(ob,at," PASS\n");}
  else {at=ob_app(ob,at," FAIL\n");}
  set32(atp,0,at);
  return;
}
fn d_pend(ob:[]u8, atp:[]u8, name:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  at=ob_app(ob,at," PENDING\n");
  set32(atp,0,at);
  return;
}
// dump a text buffer section
fn h_dumpsec(ob:[]u8, atp:[]u8, title:[]u8, buf:[]u8, len:i32)void {
  e0(ob,atp,title);
  let at:i32=get32(atp,0);
  let i:i32=0;
  while(i<len){
    ob[at]=buf[i];
    at=at+1;
    i=i+1;
  }
  set32(atp,0,at);
  return;
}
// adv_verify.zag -- R-SUF-1/R-SUF-5 surgical-marking verification (harness-side).
// V1: on W0, the committed record must mark U pairs 3 and decoy pairs 1/2.
// V2: on F-G (after a T0-primed kb), no UNRESOLVED marks may appear.
// Pure Zag, safebin.
fn v_rec_mask(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let roff:i32=get32(f,8);
  if(roff==0){return -2;}
  let nrec:i32=get32(f,roff);
  let i:i32=0;
  while(i<nrec){
    let b:i32=roff+4+i*20;
    let es:i32=get32(f,b);
    let ex:i32=get32(f,b+4);
    let ey:i32=get32(f,b+8);
    if(es==s0){
      let hit:i32=0;
      if(ex==x){if(ey==y){hit=1;}}
      if(ex==y){if(ey==x){hit=1;}}
      if(hit==1){return get32(f,b+12);}
    }
    i=i+1;
  }
  return -1;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let wb0:[]u8=z_alloc(65536);
  let wb7:[]u8=z_alloc(65536);
  let key0:[]u8=z_alloc(64);
  let keyt:[]u8=z_alloc(64);
  a_build(0,wb0,key0);
  a_build(7,wb7,keyt);
  let KB:[]u8=z_alloc(32768);
  let AS:[]u8=z_alloc(256);
  let LOG:[]u8=z_alloc(32768);
  let TR:[]u8=z_alloc(262144);
  let PR:[]u8=z_alloc(131072);
  let train:[]u8=z_alloc(4096);
  let form:[]u8=z_alloc(16384);
  let sc:[]u8=z_alloc(16384);
  let sres:[]u8=z_alloc(4096);
  l_kb_wipe(KB);
  // ---- V1: T0 on W0, check record masks ----
  e0(ob,atp,"=== V1 surgical marking (W0) ===");
  let r0:i32=h_treat_arm(wb0,KB,AS,LOG,TR,PR,train,form,sc,sres);
  let n:i32=get32(wb0,0);
  let uoff:i32=get32(wb0,32);
  let eoff:i32=get32(wb0,16);
  let at:i32=get32(atp,0);
  let u_ok:i32=1;
  let u_n:i32=0;
  let i:i32=0;
  while(i<n){
    let j:i32=i+1;
    while(j<n){
      if(wb0[uoff+i*n+j]==1){
        u_n=u_n+1;
        let xid:i32=get32(wb0,eoff+i*4);
        let yid:i32=get32(wb0,eoff+j*4);
        // check both ctx ids 41,42
        let m0:i32=v_rec_mask(form,41,xid,yid);
        let m1:i32=v_rec_mask(form,42,xid,yid);
        at=ob_app(ob,at,"U pair mask ctx0=");
        at=ob_i32(ob,at,m0);
        at=ob_app(ob,at," ctx1=");
        at=ob_i32(ob,at,m1);
        at=ob_nl(ob,at);
        if(m0!=3){u_ok=0;}
        if(m1!=3){u_ok=0;}
      }
      j=j+1;
    }
    i=i+1;
  }
  set32(atp,0,at);
  e2(ob,atp,"V1 U pairs checked=",(u_n)," all_mask3=",(u_ok));
  // decoys from key0
  let dq0x:i32=get32(key0,0);
  let dq0y:i32=get32(key0,4);
  let dq1x:i32=get32(key0,8);
  let dq1y:i32=get32(key0,12);
  let dm0a:i32=v_rec_mask(form,41,dq0x,dq0y);
  let dm0b:i32=v_rec_mask(form,42,dq0x,dq0y);
  let dm1a:i32=v_rec_mask(form,41,dq1x,dq1y);
  let dm1b:i32=v_rec_mask(form,42,dq1x,dq1y);
  e2(ob,atp,"V1 decoy0 masks=",(dm0a)," ",(dm0b));
  e2(ob,atp,"V1 decoy1 masks=",(dm1a)," ",(dm1b));
  let d_ok:i32=1;
  if(dm0a==3){d_ok=0;}
  if(dm0a==0){d_ok=0;}
  if(dm0a==-1){d_ok=0;}
  if(dm0b==3){d_ok=0;}
  if(dm0b==0){d_ok=0;}
  if(dm0b==-1){d_ok=0;}
  if(dm1a==3){d_ok=0;}
  if(dm1a==0){d_ok=0;}
  if(dm1a==-1){d_ok=0;}
  if(dm1b==3){d_ok=0;}
  if(dm1b==0){d_ok=0;}
  if(dm1b==-1){d_ok=0;}
  e1(ob,atp,"V1 decoys resolved (1/2)=",(d_ok));
  let v1:i32=0;
  if(u_ok==1){
    if(d_ok==1){v1=1;}
  }
  d_bar2(ob,atp,"V1 surgical-marking",v1);
  // ---- V2: F-G with T0-primed kb, expect zero UNRESOLVED marks ----
  e0(ob,atp,"=== V2 no marking on F-G ===");
  let r7:i32=h_treat_arm(wb7,KB,AS,LOG,TR,PR,train,form,sc,sres);
  let um:i32=get32(AS,44);
  let ck:i32=get32(AS,88);
  e2(ob,atp,"V2 unres_marks=",(um)," commit_kind=",(ck));
  let v2:i32=0;
  if(um==0){
    if(ck!=2){v2=1;}
  }
  d_bar2(ob,atp,"V2 no-marks-on-FG",v2);
  e0(ob,atp,"SUF-ADV-VERIFY-END");
  write_ob(ob,atp);
  return 0;
}

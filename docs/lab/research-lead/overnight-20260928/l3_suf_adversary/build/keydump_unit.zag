// prelude.zag -- shared basics for L3-SUF-1.
// Pure Zag. u8-backed cells (little-endian). Single output buffer +
// cursor emit helpers; final write via _zag_raw_syscall (never
// _zag_print for dynamic content, per the pinned-znc workaround).
// Alloc pattern: _zag_malloc as *u8 then [0..n] (the sound pattern;
// never `as *i32` + slice, never `[]u8 as *u8`).

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output buffer emit helpers (single buffer, cursor) ----
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 {
  ob[at]=10;
  return at+1;
}
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}
fn e0(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e1(ob:[]u8, atp:[]u8, s:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  at=ob_i32(ob,at,v);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e2(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn e3(ob:[]u8, atp:[]u8, s1:[]u8, v1:i32, s2:[]u8, v2:i32, s3:[]u8, v3:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s1);
  at=ob_i32(ob,at,v1);
  at=ob_app(ob,at,s2);
  at=ob_i32(ob,at,v2);
  at=ob_app(ob,at,s3);
  at=ob_i32(ob,at,v3);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn write_ob(ob:[]u8, atp:[]u8)void {
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=get32(atp,0);
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return;
}
// ---- deterministic PRNG (LCG). r = 4-byte state buffer. ----
fn rng_next(r:[]u8)i32 {
  let s:i32=get32(r,0);
  s=(s*1103515245+12345) & 2147483647;
  set32(r,0,s);
  return s;
}
fn rng_range(r:[]u8, n:i32)i32 {
  if(n<1){return 0;}
  let v:i32=rng_next(r);
  if(v<0){v=0-v;}
  return v % n;
}
fn rng_seed(r:[]u8, s:i32)void {
  set32(r,0,s & 2147483647);
  return;
}
// adv_world.zag -- SEALED worlds for the L3-SUF-1 adversary battery.
// Implements the FROZEN world interface (CODEFREEZE.md):
//   learner-visible: w_observe, w_test, w_stakes
//   harness-only:    w_truth, w_stakes_meta, w_undet
// WB layout is exactly the frozen layout (i32 header + regions):
//   0: nent   4: nctx   8: ntrain   12: nstakes
//   16: off_ent_ids (nent i32 ids)
//   20: off_ctx_ids (nctx i32 ids)
//   24: off_truth   (nctx*nent*nent bytes, d in {0,1})
//   28: off_probe   (nent*nent bytes, 1=probeable)
//   32: off_undet   (nent*nent bytes, 1=undetermined; key/scoring only)
//   36: off_train   (ntrain*4 i32s: s0i, xi, yi, d)   [indices]
//   40: off_stakes  (nstakes*5 i32s: s0i, xi, yi, is_heldout, det)
// The interface functions below are re-implemented to the frozen spec.
// The sealed content is a_build() (worlds 0..8). The learner NEVER calls
// w_truth / w_undet / w_stakes_meta (A-INFO boundary).

// ---- index helpers ----
fn w_ent_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,16);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_ctx_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,4);
  let off:i32=get32(wb,20);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_truth_idx(wb:[]u8, s0i:i32, xi:i32, yi:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,24);
  return wb[off+(s0i*n+xi)*n+yi] as i32;
}
// LEARNER-VISIBLE: TEST-PAIR/TRIPLE. Returns 1=ACCEPT, 0=REJECT.
// Unprobeable pairs withhold: REJECT every predicted value.
fn w_test(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32, v:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return 0;}
  if(xi<0){return 0;}
  if(yi<0){return 0;}
  let n:i32=get32(wb,0);
  let poff:i32=get32(wb,28);
  if(wb[poff+xi*n+yi]==0){return 0;}
  let t:i32=w_truth_idx(wb,s0i,xi,yi);
  if(t==v){return 1;}
  return 0;
}
// HARNESS ONLY: ground truth. The learner never calls this.
fn w_truth(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return -1;}
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  return w_truth_idx(wb,s0i,xi,yi);
}
// HARNESS ONLY: undetermined flag for a pair (key/scoring).
fn w_undet(wb:[]u8, x_id:i32, y_id:i32)i32 {
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,32);
  return wb[off+xi*n+yi] as i32;
}
// LEARNER-VISIBLE: OBSERVE. Fills out with (s0_id,x_id,y_id,d) quads.
fn w_observe(wb:[]u8, out:[]u8)i32 {
  let nt:i32=get32(wb,8);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let toff:i32=get32(wb,36);
  let i:i32=0;
  while(i<nt){
    let s0i:i32=get32(wb,toff+i*16);
    let xi:i32=get32(wb,toff+i*16+4);
    let yi:i32=get32(wb,toff+i*16+8);
    let d:i32=get32(wb,toff+i*16+12);
    set32(out,i*16,get32(wb,coff+s0i*4));
    set32(out,i*16+4,get32(wb,eoff+xi*4));
    set32(out,i*16+8,get32(wb,eoff+yi*4));
    set32(out,i*16+12,d);
    i=i+1;
  }
  return nt;
}
// LEARNER-VISIBLE: stakes sample. Fills out with (s0_id,x_id,y_id).
fn w_stakes(wb:[]u8, out:[]u8)i32 {
  let ns:i32=get32(wb,12);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let soff:i32=get32(wb,40);
  let i:i32=0;
  while(i<ns){
    let s0i:i32=get32(wb,soff+i*20);
    let xi:i32=get32(wb,soff+i*20+4);
    let yi:i32=get32(wb,soff+i*20+8);
    set32(out,i*12,get32(wb,coff+s0i*4));
    set32(out,i*12+4,get32(wb,eoff+xi*4));
    set32(out,i*12+8,get32(wb,eoff+yi*4));
    i=i+1;
  }
  return ns;
}
// HARNESS ONLY: (is_heldout, det_status) for stakes index i.
fn w_stakes_meta(wb:[]u8, i:i32, out:[]u8)void {
  let soff:i32=get32(wb,40);
  set32(out,0,get32(wb,soff+i*20+12));
  set32(out,4,get32(wb,soff+i*20+16));
  return;
}
// ---- Fisher-Yates shuffle of perm[0..n-1] ----
fn w_shuffle(r:[]u8, perm:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){set32(perm,i*4,i);i=i+1;}
  i=n-1;
  while(i>0){
    let j:i32=rng_range(r,i+1);
    let t:i32=get32(perm,i*4);
    set32(perm,i*4,get32(perm,j*4));
    set32(perm,j*4,t);
    i=i-1;
  }
  return;
}
fn w_pos_of(perm:[]u8, pos:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    let x:i32=get32(perm,i*4);
    set32(pos,x*4,i);
    i=i+1;
  }
  return;
}
// emit one training quad into the train region; returns new ti
fn w_emit_train(wb:[]u8, troff:i32, ti:i32, s0i:i32, xi:i32, yi:i32, d:i32)i32 {
  set32(wb,troff+ti*16,s0i);
  set32(wb,troff+ti*16+4,xi);
  set32(wb,troff+ti*16+8,yi);
  set32(wb,troff+ti*16+12,d);
  return ti+1;
}
// emit one stakes entry; returns new si
fn w_emit_stakes(wb:[]u8, soff:i32, si:i32, s0i:i32, xi:i32, yi:i32, held:i32, det:i32)i32 {
  set32(wb,soff+si*20,s0i);
  set32(wb,soff+si*20+4,xi);
  set32(wb,soff+si*20+8,yi);
  set32(wb,soff+si*20+12,held);
  set32(wb,soff+si*20+16,det);
  return si+1;
}
// mark pair (x,y) as U: unprobeable, undetermined, truth=anti-tiebreak
// on entity IDS (matches the learner's documented l_tiebreak on ids).
fn w_mark_u(wb:[]u8, nent:i32, toff:i32, poff:i32, uoff:i32, eoff:i32, x:i32, y:i32)void {
  let idx:i32=get32(wb,eoff+x*4);
  let idy:i32=get32(wb,eoff+y*4);
  let tb:i32=0;
  if(idx<idy){tb=1;}
  let ud:i32=1-tb;
  wb[poff+x*nent+y]=0;wb[poff+y*nent+x]=0;
  wb[uoff+x*nent+y]=1;wb[uoff+y*nent+x]=1;
  wb[toff+(0*nent+x)*nent+y]=ud as u8;
  wb[toff+(0*nent+y)*nent+x]=ud as u8;
  wb[toff+(1*nent+x)*nent+y]=ud as u8;
  wb[toff+(1*nent+y)*nent+x]=ud as u8;
  return;
}

// ================= SEALED: world-spec machinery =================
// WS buffer layout (world construction scratch, index-level):
//   0: ntr   4: nup   8: nov   12: nd   16: na   2304: nst
//   20: g0[100] (bytes)    120: g1[100]
//   220: used[100]
//   320: dlist[400] (100 i32 packed i*10+j)
//   720: alist[400]
//   1120: upairs[40] (10 i32 packed)
//   1160: ovp[40]   1200: ovv0[40]   1240: ovv1[40]  (overrides)
//   1280: trs[256]  1536: tri[256]  1792: trj[256]  2048: trd[256]
//   2308: sts[48]   2356: sti[48]   2404: stj[48]   2452: sth[48]   2500: std[48]
fn wg(ws:[]u8, g:i32, i:i32, j:i32)i32 {
  let base:i32=20;
  if(g==1){base=120;}
  return ws[base+i*10+j] as i32;
}
fn wg_set(ws:[]u8, g:i32, i:i32, j:i32, v:i32)void {
  let base:i32=20;
  if(g==1){base=120;}
  ws[base+i*10+j]=v as u8;
  return;
}
fn a_canon_a(i:i32, j:i32)i32 {
  if(i<j){return i;}
  return j;
}
fn a_canon_b(i:i32, j:i32)i32 {
  if(i<j){return j;}
  return i;
}
fn a_mark_used(ws:[]u8, i:i32, j:i32)void {
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  ws[220+a*10+b]=1;
  return;
}
fn a_is_used(ws:[]u8, i:i32, j:i32)i32 {
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  return ws[220+a*10+b] as i32;
}
fn a_tr_add(ws:[]u8, s:i32, i:i32, j:i32, d:i32)void {
  let n:i32=get32(ws,0);
  set32(ws,1280+n*4,s);
  set32(ws,1536+n*4,i);
  set32(ws,1792+n*4,j);
  set32(ws,2048+n*4,d);
  set32(ws,0,n+1);
  a_mark_used(ws,i,j);
  return;
}
fn a_st_add(ws:[]u8, s:i32, i:i32, j:i32, held:i32, det:i32)void {
  let n:i32=get32(ws,2304);
  set32(ws,2308+n*4,s);
  set32(ws,2356+n*4,i);
  set32(ws,2404+n*4,j);
  set32(ws,2452+n*4,held);
  set32(ws,2500+n*4,det);
  set32(ws,2304,n+1);
  return;
}
fn a_u_add(ws:[]u8, i:i32, j:i32)void {
  let n:i32=get32(ws,4);
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  set32(ws,1120+n*4,a*10+b);
  set32(ws,4,n+1);
  a_mark_used(ws,a,b);
  return;
}
fn a_ov_add(ws:[]u8, i:i32, j:i32, v0:i32, v1:i32)void {
  let n:i32=get32(ws,8);
  let a:i32=a_canon_a(i,j);
  let b:i32=a_canon_b(i,j);
  set32(ws,1160+n*4,a*10+b);
  set32(ws,1200+n*4,v0);
  set32(ws,1240+n*4,v1);
  set32(ws,8,n+1);
  return;
}
// shuffle an i32 list in place
fn a_shuf_list(r:[]u8, list:[]u8, n:i32)void {
  let k:i32=n-1;
  while(k>0){
    let m:i32=rng_range(r,k+1);
    let t:i32=get32(list,k*4);
    set32(list,k*4,get32(list,m*4));
    set32(list,m*4,t);
    k=k-1;
  }
  return;
}
// truth generators. g0ord=1 -> ORD(perm0) else PAR; g1ord=1 -> ORD(perm1) else PAR.
// Then build D (disagree) and A (agree) lists, shuffled.
fn a_phase_gen(r:[]u8, ws:[]u8, seed:i32, g0ord:i32, g1ord:i32)void {
  rng_seed(r,seed);
  let perm0:[]u8=z_alloc(40);
  let perm1:[]u8=z_alloc(40);
  let pos0:[]u8=z_alloc(40);
  let pos1:[]u8=z_alloc(40);
  w_shuffle(r,perm0,10);
  w_shuffle(r,perm1,10);
  w_pos_of(perm0,pos0,10);
  w_pos_of(perm1,pos1,10);
  let g:i32=0;
  while(g<2){
    let gord:i32=g0ord;
    if(g==1){gord=g1ord;}
    let i:i32=0;
    while(i<10){
      let j:i32=0;
      while(j<10){
        let d:i32=0;
        if(i!=j){
          if(gord==1){
            let a:i32=a_canon_a(i,j);
            let b:i32=a_canon_b(i,j);
            let pa:i32=0;
            let pb:i32=0;
            if(g==0){pa=get32(pos0,a*4);pb=get32(pos0,b*4);}
            else {pa=get32(pos1,a*4);pb=get32(pos1,b*4);}
            if(pa<pb){d=1;}
          } else {
            if((i+j)%2==0){d=1;}
          }
        }
        wg_set(ws,g,i,j,d);
        j=j+1;
      }
      i=i+1;
    }
    g=g+1;
  }
  let nd:i32=0;
  let na:i32=0;
  let i2:i32=0;
  while(i2<10){
    let j2:i32=i2+1;
    while(j2<10){
      let d0:i32=wg(ws,0,i2,j2);
      let d1:i32=wg(ws,1,i2,j2);
      if(d0==d1){set32(ws,720+na*4,i2*10+j2);na=na+1;}
      else {set32(ws,320+nd*4,i2*10+j2);nd=nd+1;}
      j2=j2+1;
    }
    i2=i2+1;
  }
  // shuffle the D and A lists via temp copies
  let dl:[]u8=z_alloc(400);
  let al:[]u8=z_alloc(400);
  let k:i32=0;
  while(k<nd){set32(dl,k*4,get32(ws,320+k*4));k=k+1;}
  k=0;
  while(k<na){set32(al,k*4,get32(ws,720+k*4));k=k+1;}
  a_shuf_list(r,dl,nd);
  a_shuf_list(r,al,na);
  k=0;
  while(k<nd){set32(ws,320+k*4,get32(dl,k*4));k=k+1;}
  k=0;
  while(k<na){set32(ws,720+k*4,get32(al,k*4));k=k+1;}
  set32(ws,12,nd);
  set32(ws,16,na);
  return;
}
// unused-pair candidates, shuffled; returns count
fn a_unused_shuf(r:[]u8, ws:[]u8, cand:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){
      if(a_is_used(ws,i,j)==0){set32(cand,n*4,i*10+j);n=n+1;}
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,n);
  return n;
}
// ---- W0 INVENT-2: g0=ORD, g1=PAR; 6 D x2 + 8 A; U=4; decoys=2 ----
fn a_ph_w0(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1000,1,0);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    let i:i32=p/10;
    let j:i32=p%10;
    a_tr_add(ws,0,i,j,wg(ws,0,i,j));
    a_tr_add(ws,1,i,j,wg(ws,1,i,j));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let i:i32=p/10;
    let j:i32=p%10;
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,i,j,wg(ws,ci,i,j));
    k=k+1;
  }
  let cand:[]u8=z_alloc(400);
  a_unused_shuf(r,ws,cand);
  k=0;
  while(k<4){
    let p:i32=get32(cand,k*4);
    a_u_add(ws,p/10,p%10);
    k=k+1;
  }
  // decoys: probeable, truth overridden to ANTI-TB (ids 700+i; i<j -> tb=1 -> truth 0)
  let dq0:i32=get32(cand,4*4);
  let dq1:i32=get32(cand,5*4);
  a_ov_add(ws,dq0/10,dq0%10,0,0);
  a_ov_add(ws,dq1/10,dq1%10,0,0);
  a_mark_used(ws,dq0/10,dq0%10);
  a_mark_used(ws,dq1/10,dq1%10);
  // stakes (12)
  k=0;
  while(k<3){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,0,p/10,p%10,1,1);
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(ws,320+k*4);
    let s:i32=0;
    if(k==2){s=1;}
    a_st_add(ws,s,p/10,p%10,1,0);
    k=k+1;
  }
  let pu:i32=get32(ws,1120+3*4);
  a_st_add(ws,1,pu/10,pu%10,0,1);
  a_st_add(ws,0,dq0/10,dq0%10,0,0);
  a_st_add(ws,1,dq1/10,dq1%10,0,0);
  k=0;
  while(k<3){
    let p:i32=get32(ws,720+k*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-A WITHHELD-2: g0=ORD, g1=ORD; 6 D x ctx0 only + 14 A (alternating ctx) ----
fn a_ph_fa(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1001,1,1);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<14){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=k%2;
    a_tr_add(ws,ci,p/10,p%10,wg(ws,ci,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,0,p/10,p%10,1,0);
    a_st_add(ws,1,p/10,p%10,1,0);
    k=k+1;
  }
  k=0;
  while(k<6){
    let p:i32=get32(ws,720+((k+3)%na)*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-B UNDET-BLOCK: g0=ORD, g1=ORD; U=4 cross-block ----
fn a_ph_fb(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1002,1,1);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    a_tr_add(ws,1,p/10,p%10,wg(ws,1,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,p/10,p%10,wg(ws,ci,p/10,p%10));
    k=k+1;
  }
  // cross-block candidates: (i<5) != (j<5)
  let cand:[]u8=z_alloc(400);
  let nc:i32=0;
  let i:i32=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){
      let bi:i32=0;
      let bj:i32=0;
      if(i>=5){bi=1;}
      if(j>=5){bj=1;}
      if(bi!=bj){
        if(a_is_used(ws,i,j)==0){set32(cand,nc*4,i*10+j);nc=nc+1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,nc);
  k=0;
  while(k<4){
    let p:i32=get32(cand,k*4);
    a_u_add(ws,p/10,p%10);
    k=k+1;
  }
  // stakes: heldout 4 det (unused agreeing) + 2 U; extra 2 U + 4 det
  let ndet:i32=0;
  k=0;
  while(k<na){
    if(ndet<6){
      let p:i32=get32(ws,720+k*4);
      if(a_is_used(ws,p/10,p%10)==0){
        if(ndet<4){a_st_add(ws,0,p/10,p%10,1,0);}
        else {a_st_add(ws,1,p/10,p%10,0,0);}
        ndet=ndet+1;
      }
    }
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,0,p/10,p%10,1,1);
    k=k+1;
  }
  k=2;
  while(k<4){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,1,p/10,p%10,0,1);
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,k,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-C POISON-SWAP: oracle g0=ORD,g1=PAR; training swapped ----
fn a_ph_fc(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1003,1,0);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    let i:i32=p/10;
    let j:i32=p%10;
    a_tr_add(ws,0,i,j,wg(ws,1,i,j));
    a_tr_add(ws,1,i,j,wg(ws,0,i,j));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=rng_range(r,2);
    let cj:i32=1-ci;
    a_tr_add(ws,cj,p/10,p%10,wg(ws,cj,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,0,p/10,p%10,1,0);
    a_st_add(ws,1,p/10,p%10,1,0);
    k=k+1;
  }
  k=0;
  while(k<6){
    let p:i32=get32(ws,720+((k+5)%na)*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- F-D REUSE-SCATTER: g0=PAR, g1=ORD; U=5 scattered (i+j)%3==0 ----
fn a_ph_fd(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1004,0,1);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    a_tr_add(ws,1,p/10,p%10,wg(ws,1,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<8){
    let p:i32=get32(ws,720+(k%na)*4);
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,p/10,p%10,wg(ws,ci,p/10,p%10));
    k=k+1;
  }
  let cand:[]u8=z_alloc(400);
  let nc:i32=0;
  let i:i32=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){
      if((i+j)%3==0){
        if(a_is_used(ws,i,j)==0){set32(cand,nc*4,i*10+j);nc=nc+1;}
      }
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,nc);
  k=0;
  while(k<5){
    let p:i32=get32(cand,k*4);
    a_u_add(ws,p/10,p%10);
    k=k+1;
  }
  let ndet:i32=0;
  k=0;
  while(k<na){
    if(ndet<6){
      let p:i32=get32(ws,720+k*4);
      if(a_is_used(ws,p/10,p%10)==0){
        if(ndet<4){a_st_add(ws,0,p/10,p%10,1,0);}
        else {a_st_add(ws,1,p/10,p%10,0,0);}
        ndet=ndet+1;
      }
    }
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,0,p/10,p%10,1,1);
    k=k+1;
  }
  k=2;
  while(k<4){
    let p:i32=get32(ws,1120+k*4);
    a_st_add(ws,1,p/10,p%10,0,1);
    k=k+1;
  }
  k=0;
  while(k<2){
    let p:i32=get32(ws,320+k*4);
    a_st_add(ws,k,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}

// ---- F-G RETIRE-PLAIN: no gating (g1=g0); tempting extras ----
fn a_ph_fg(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1007,1,1);
  let i:i32=0;
  while(i<100){ws[120+i]=ws[20+i];i=i+1;}
  let allp:[]u8=z_alloc(400);
  let n:i32=0;
  i=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){set32(allp,n*4,i*10+j);n=n+1;j=j+1;}
    i=i+1;
  }
  a_shuf_list(r,allp,n);
  let k:i32=0;
  while(k<20){
    let p:i32=get32(allp,k*4);
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  // tempting: 6 untrained pairs: 3 ANTI-TB (0,0), 3 TB-consistent (1,1)
  // ids 770+i, i<j -> tb=1
  let cand:[]u8=z_alloc(400);
  a_unused_shuf(r,ws,cand);
  k=0;
  while(k<6){
    let p:i32=get32(cand,k*4);
    if(k<3){a_ov_add(ws,p/10,p%10,0,0);}
    else {a_ov_add(ws,p/10,p%10,1,1);}
    a_mark_used(ws,p/10,p%10);
    k=k+1;
  }
  k=0;
  while(k<6){
    a_st_add(ws,get32(ws,1280+k*4),get32(ws,1536+k*4),get32(ws,1792+k*4),1,0);
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(cand,k*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  k=3;
  while(k<6){
    let p:i32=get32(cand,k*4);
    a_st_add(ws,(k+1)%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- X-CTX CTX-NOVEL: all training at ctx0; unseen ctx1 queries ----
fn a_ph_fx(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1008,1,0);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<14){
    let p:i32=get32(ws,720+(k%na)*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  // unseen: 6 untrained pairs; ctx1 truth overridden to ANTI-TB (0)
  let cand:[]u8=z_alloc(400);
  a_unused_shuf(r,ws,cand);
  k=0;
  while(k<6){
    let p:i32=get32(cand,k*4);
    let pi2:i32=p/10;
    let pj2:i32=p%10;
    a_ov_add(ws,pi2,pj2,wg(ws,0,pi2,pj2),0);
    a_mark_used(ws,pi2,pj2);
    k=k+1;
  }
  k=0;
  while(k<3){
    a_st_add(ws,0,get32(ws,1536+k*4),get32(ws,1792+k*4),1,0);
    let p:i32=get32(cand,k*4);
    a_st_add(ws,1,p/10,p%10,1,1);
    k=k+1;
  }
  k=3;
  while(k<6){
    a_st_add(ws,0,get32(ws,1536+k*4),get32(ws,1792+k*4),0,0);
    let p:i32=get32(cand,k*4);
    a_st_add(ws,1,p/10,p%10,0,1);
    k=k+1;
  }
  return;
}
// ---- emit WS into WB ----
fn a_emit(ws:[]u8, wb:[]u8, entb:i32, c0id:i32)void {
  let nent:i32=10;
  let nctx:i32=2;
  set32(wb,0,nent);
  set32(wb,4,nctx);
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+nctx*4;
  let poff:i32=toff+nctx*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){set32(wb,eoff+i*4,entb+i);i=i+1;}
  set32(wb,coff,c0id);
  set32(wb,coff+4,c0id+1);
  let nov:i32=get32(ws,8);
  let c:i32=0;
  while(c<nctx){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        let a:i32=a_canon_a(i,j);
        let b:i32=a_canon_b(i,j);
        let v:i32=wg(ws,c,a,b);
        let kk:i32=0;
        while(kk<nov){
          if(get32(ws,1160+kk*4)==a*10+b){
            if(c==0){v=get32(ws,1200+kk*4);}
            else {v=get32(ws,1240+kk*4);}
          }
          kk=kk+1;
        }
        wb[toff+(c*nent+i)*nent+j]=v as u8;
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  i=0;
  while(i<nent*nent){wb[poff+i]=1;wb[uoff+i]=0;i=i+1;}
  let nup:i32=get32(ws,4);
  let k2:i32=0;
  while(k2<nup){
    let p:i32=get32(ws,1120+k2*4);
    w_mark_u(wb,nent,toff,poff,uoff,eoff,p/10,p%10);
    k2=k2+1;
  }
  let ntr:i32=get32(ws,0);
  set32(wb,8,ntr);
  let q:i32=0;
  let ti:i32=0;
  while(q<ntr){
    ti=w_emit_train(wb,troff,ti,get32(ws,1280+q*4),get32(ws,1536+q*4),get32(ws,1792+q*4),get32(ws,2048+q*4));
    q=q+1;
  }
  let soff:i32=troff+ntr*16;
  set32(wb,40,soff);
  let nst:i32=get32(ws,2304);
  set32(wb,12,nst);
  let s2:i32=0;
  let si:i32=0;
  while(s2<nst){
    si=w_emit_stakes(wb,soff,si,get32(ws,2308+s2*4),get32(ws,2356+s2*4),get32(ws,2404+s2*4),get32(ws,2452+s2*4),get32(ws,2500+s2*4));
    s2=s2+1;
  }
  return;
}
// ---- F-E RECODE-PERM: FD structure through pi (seed 1005) ----
fn a_build_fe(wb:[]u8, key:[]u8)void {
  let wbt:[]u8=z_alloc(65536);
  let keyt:[]u8=z_alloc(64);
  a_build(4,wbt,keyt);
  let r:[]u8=z_alloc(8);
  rng_seed(r,1005);
  let pi:[]u8=z_alloc(40);
  w_shuffle(r,pi,10);
  let pinv:[]u8=z_alloc(40);
  w_pos_of(pi,pinv,10);
  let nent:i32=10;
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+8;
  let poff:i32=toff+2*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,0,nent);
  set32(wb,4,2);
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){set32(wb,eoff+i*4,750+i);i=i+1;}
  set32(wb,coff,51);
  set32(wb,coff+4,52);
  let tbt:i32=get32(wbt,24);
  let pbt:i32=get32(wbt,28);
  let ubt:i32=get32(wbt,32);
  let c:i32=0;
  while(c<2){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        let a:i32=get32(pi,i*4);
        let b:i32=get32(pi,j*4);
        wb[toff+(c*nent+i)*nent+j]=wbt[tbt+(c*nent+a)*nent+b];
        wb[poff+i*nent+j]=wbt[pbt+a*nent+b];
        wb[uoff+i*nent+j]=wbt[ubt+a*nent+b];
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  // U truth: ANTI-TB in E ids (750+i sequential, i<j -> tb=1 -> truth 0)
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(wb[uoff+i*nent+j]==1){
        wb[toff+(0*nent+i)*nent+j]=0;
        wb[toff+(0*nent+j)*nent+i]=0;
        wb[toff+(1*nent+i)*nent+j]=0;
        wb[toff+(1*nent+j)*nent+i]=0;
      }
      j=j+1;
    }
    i=i+1;
  }
  let nt:i32=get32(wbt,8);
  let wtroff:i32=get32(wbt,36);
  set32(wb,8,nt);
  let k:i32=0;
  let ti:i32=0;
  while(k<nt){
    let s:i32=get32(wbt,wtroff+k*16);
    let a:i32=get32(wbt,wtroff+k*16+4);
    let b:i32=get32(wbt,wtroff+k*16+8);
    let d:i32=get32(wbt,wtroff+k*16+12);
    ti=w_emit_train(wb,troff,ti,s,get32(pinv,a*4),get32(pinv,b*4),d);
    k=k+1;
  }
  let soff:i32=troff+nt*16;
  set32(wb,40,soff);
  let ns:i32=get32(wbt,12);
  let wsoff:i32=get32(wbt,40);
  set32(wb,12,ns);
  let si:i32=0;
  k=0;
  while(k<ns){
    let s2:i32=get32(wbt,wsoff+k*20);
    let a2:i32=get32(wbt,wsoff+k*20+4);
    let b2:i32=get32(wbt,wsoff+k*20+8);
    let h2:i32=get32(wbt,wsoff+k*20+12);
    let m2:i32=get32(wbt,wsoff+k*20+16);
    si=w_emit_stakes(wb,soff,si,s2,get32(pinv,a2*4),get32(pinv,b2*4),h2,m2);
    k=k+1;
  }
  i=0;
  while(i<10){
    set32(key,i*4,get32(pi,i*4));
    set32(key,40+i*4,get32(pinv,i*4));
    i=i+1;
  }
  return;
}
// ---- F-F REGIME-5: FD base, fresh ids, S_ch (3 det->U, 2 U->det) ----
fn a_build_ff(wb:[]u8, key:[]u8)void {
  let wbt:[]u8=z_alloc(65536);
  let keyt:[]u8=z_alloc(64);
  a_build(4,wbt,keyt);
  let nent:i32=10;
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+8;
  let poff:i32=toff+2*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,0,nent);
  set32(wb,4,2);
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){set32(wb,eoff+i*4,760+i);i=i+1;}
  set32(wb,coff,53);
  set32(wb,coff+4,54);
  let tbt:i32=get32(wbt,24);
  let pbt:i32=get32(wbt,28);
  let ubt:i32=get32(wbt,32);
  let c:i32=0;
  while(c<2){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        wb[toff+(c*nent+i)*nent+j]=wbt[tbt+(c*nent+i)*nent+j];
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  i=0;
  while(i<nent*nent){
    wb[poff+i]=wbt[pbt+i];
    wb[uoff+i]=wbt[ubt+i];
    i=i+1;
  }
  let nt:i32=get32(wbt,8);
  let wtroff:i32=get32(wbt,36);
  set32(wb,8,nt);
  let k:i32=0;
  let ti:i32=0;
  while(k<nt){
    ti=w_emit_train(wb,troff,ti,get32(wbt,wtroff+k*16),get32(wbt,wtroff+k*16+4),get32(wbt,wtroff+k*16+8),get32(wbt,wtroff+k*16+12));
    k=k+1;
  }
  // in-training set
  let intr:[]u8=z_alloc(100);
  k=0;
  while(k<nt){
    let a:i32=get32(wb,troff+k*16+4);
    let b:i32=get32(wb,troff+k*16+8);
    intr[a_canon_a(a,b)*10+a_canon_b(a,b)]=1;
    k=k+1;
  }
  // generator truth for restored pairs: FD seed 1004, g0=PAR, g1=ORD(perm1)
  let r4:[]u8=z_alloc(8);
  rng_seed(r4,1004);
  let pm0:[]u8=z_alloc(40);
  let pm1:[]u8=z_alloc(40);
  let ps1:[]u8=z_alloc(40);
  w_shuffle(r4,pm0,10);
  w_shuffle(r4,pm1,10);
  w_pos_of(pm1,ps1,10);
  let r:[]u8=z_alloc(8);
  rng_seed(r,1006);
  // select R1,R2: first 2 index-order undet pairs (pure U_D)
  let r1i:i32=-1;
  let r1j:i32=-1;
  let r2i:i32=-1;
  let r2j:i32=-1;
  let nr:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(nr<2){
        if(wb[uoff+i*nent+j]==1){
          if(nr==0){r1i=i;r1j=j;}
          else {r2i=i;r2j=j;}
          nr=nr+1;
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // select N1..N3: det->U candidates (probeable, determined, untrained, not R1/R2)
  let cand:[]u8=z_alloc(400);
  let nc:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(wb[poff+i*nent+j]==1){
        if(wb[uoff+i*nent+j]==0){
          if(intr[i*10+j]==0){
            let isr:i32=0;
            if(i==r1i){if(j==r1j){isr=1;}}
            if(i==r2i){if(j==r2j){isr=1;}}
            if(isr==0){set32(cand,nc*4,i*10+j);nc=nc+1;}
          }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,nc);
  let n1i:[]u8=z_alloc(12);
  let n1j:[]u8=z_alloc(12);
  k=0;
  while(k<3){
    let p:i32=get32(cand,k*4);
    let a:i32=p/10;
    let b:i32=p%10;
    w_mark_u(wb,nent,toff,poff,uoff,eoff,a,b);
    set32(n1i,k*4,a);
    set32(n1j,k*4,b);
    set32(key,k*12,760+a);
    set32(key,k*12+4,760+b);
    set32(key,k*12+8,1);
    k=k+1;
  }
  // apply restores R1,R2
  let ri:i32=0;
  while(ri<2){
    let a:i32=r1i;
    let b:i32=r1j;
    if(ri==1){a=r2i;b=r2j;}
    wb[poff+a*nent+b]=1;wb[poff+b*nent+a]=1;
    wb[uoff+a*nent+b]=0;wb[uoff+b*nent+a]=0;
    let v0:i32=0;
    if((a+b)%2==0){v0=1;}
    let v1:i32=0;
    if(get32(ps1,a*4)<get32(ps1,b*4)){v1=1;}
    wb[toff+(0*nent+a)*nent+b]=v0 as u8;
    wb[toff+(0*nent+b)*nent+a]=v0 as u8;
    wb[toff+(1*nent+a)*nent+b]=v1 as u8;
    wb[toff+(1*nent+b)*nent+a]=v1 as u8;
    set32(key,(3+ri)*12,760+a);
    set32(key,(3+ri)*12+4,760+b);
    set32(key,(3+ri)*12+8,0);
    ri=ri+1;
  }
  // training: replace triple 12 (first agreeing) with R1 triple (observed path)
  let sr:i32=rng_range(r,2);
  let rv0:i32=0;
  if((r1i+r1j)%2==0){rv0=1;}
  let rv1:i32=0;
  if(get32(ps1,r1i*4)<get32(ps1,r1j*4)){rv1=1;}
  let rv:i32=rv0;
  if(sr==1){rv=rv1;}
  set32(wb,troff+12*16,sr);
  set32(wb,troff+12*16+4,r1i);
  set32(wb,troff+12*16+8,r1j);
  set32(wb,troff+12*16+12,rv);
  // Uold1,Uold2: first index-order undet pairs excluding N1..N3
  let uo1i:i32=-1;
  let uo1j:i32=-1;
  let uo2i:i32=-1;
  let uo2j:i32=-1;
  let nu2:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(nu2<2){
        if(wb[uoff+i*nent+j]==1){
          let isn:i32=0;
          let q:i32=0;
          while(q<3){
            if(i==get32(n1i,q*4)){if(j==get32(n1j,q*4)){isn=1;}}
            q=q+1;
          }
          if(isn==0){
            if(nu2==0){uo1i=i;uo1j=j;}
            else {uo2i=i;uo2j=j;}
            nu2=nu2+1;
          }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // D pairs from wbt training triples 0,2,4,6,8
  let d0i:i32=get32(wbt,wtroff+4);
  let d0j:i32=get32(wbt,wtroff+8);
  let d1i:i32=get32(wbt,wtroff+2*16+4);
  let d1j:i32=get32(wbt,wtroff+2*16+8);
  let d2i:i32=get32(wbt,wtroff+4*16+4);
  let d2j:i32=get32(wbt,wtroff+4*16+8);
  let d3i:i32=get32(wbt,wtroff+6*16+4);
  let d3j:i32=get32(wbt,wtroff+6*16+8);
  let d4i:i32=get32(wbt,wtroff+8*16+4);
  let d4j:i32=get32(wbt,wtroff+8*16+8);
  // stakes (12)
  let soff:i32=troff+nt*16;
  set32(wb,40,soff);
  let si:i32=0;
  si=w_emit_stakes(wb,soff,si,0,r1i,r1j,1,0);
  si=w_emit_stakes(wb,soff,si,0,d0i,d0j,1,0);
  si=w_emit_stakes(wb,soff,si,1,d1i,d1j,1,0);
  si=w_emit_stakes(wb,soff,si,0,d2i,d2j,1,0);
  si=w_emit_stakes(wb,soff,si,0,get32(n1i,0),get32(n1j,0),1,1);
  si=w_emit_stakes(wb,soff,si,0,uo1i,uo1j,1,1);
  si=w_emit_stakes(wb,soff,si,1,r2i,r2j,0,0);
  si=w_emit_stakes(wb,soff,si,0,d3i,d3j,0,0);
  si=w_emit_stakes(wb,soff,si,1,d4i,d4j,0,0);
  si=w_emit_stakes(wb,soff,si,1,get32(n1i,4),get32(n1j,4),0,1);
  si=w_emit_stakes(wb,soff,si,0,get32(n1i,8),get32(n1j,8),0,1);
  si=w_emit_stakes(wb,soff,si,1,uo2i,uo2j,0,1);
  set32(wb,12,si);
  return;
}
// ---- top-level sealed builder ----
// which: 0=W0 1=FA 2=FB 3=FC 4=FD 5=FE 6=FF 7=FG 8=XCTX
// key: which==5 -> pi[10] + pinv[10]; which==6 -> S_ch (x_id,y_id,new_det)x5
fn a_build(which:i32, wb:[]u8, key:[]u8)void {
  if(which==5){a_build_fe(wb,key);return;}
  if(which==6){a_build_ff(wb,key);return;}
  let r:[]u8=z_alloc(8);
  let ws:[]u8=z_alloc(2560);
  if(which==0){a_ph_w0(r,ws);}
  if(which==1){a_ph_fa(r,ws);}
  if(which==2){a_ph_fb(r,ws);}
  if(which==3){a_ph_fc(r,ws);}
  if(which==4){a_ph_fd(r,ws);}
  if(which==7){a_ph_fg(r,ws);}
  if(which==8){a_ph_fx(r,ws);}
  let entb:i32=700+which*10;
  let c0id:i32=41+which*2;
  a_emit(ws,wb,entb,c0id);
  return;
}
// keydump.zag -- adversary key extraction (harness-side inspection).
// Builds each sealed world and prints the key facts: U sets (undet table),
// F-E pi/pi_inv, F-F S_ch. Pure Zag, safebin.
fn kd_upairs(wb:[]u8, ob:[]u8, atp:[]u8, tag:[]u8)void {
  let n:i32=get32(wb,0);
  let uoff:i32=get32(wb,32);
  let eoff:i32=get32(wb,16);
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," U={");
  let i:i32=0;
  while(i<n){
    let j:i32=i+1;
    while(j<n){
      if(wb[uoff+i*n+j]==1){
        at=ob_app(ob,at,"(");
        at=ob_i32(ob,at,get32(wb,eoff+i*4));
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,get32(wb,eoff+j*4));
        at=ob_app(ob,at,")");
      }
      j=j+1;
    }
    i=i+1;
  }
  at=ob_app(ob,at,"}\n");
  set32(atp,0,at);
  return;
}
fn kd_pi(key5:[]u8, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"FE pi=[");
  let i:i32=0;
  while(i<10){
    at=ob_i32(ob,at,get32(key5,i*4));
    if(i<9){at=ob_app(ob,at,",");}
    i=i+1;
  }
  at=ob_app(ob,at,"] pinv=[");
  i=0;
  while(i<10){
    at=ob_i32(ob,at,get32(key5,40+i*4));
    if(i<9){at=ob_app(ob,at,",");}
    i=i+1;
  }
  at=ob_app(ob,at,"]\n");
  // involution check: pi[pi[i]]==i for all i ?
  let inv:i32=1;
  i=0;
  while(i<10){
    let p:i32=get32(key5,i*4);
    let pp:i32=get32(key5,p*4);
    if(pp!=i){inv=0;}
    i=i+1;
  }
  at=ob_app(ob,at,"FE pi_is_involution=");
  at=ob_i32(ob,at,inv);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn kd_sch(key6:[]u8, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"FF S_ch=[");
  let k:i32=0;
  while(k<5){
    at=ob_app(ob,at,"(");
    at=ob_i32(ob,at,get32(key6,k*12));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,get32(key6,k*12+4));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,get32(key6,k*12+8));
    at=ob_app(ob,at,")");
    k=k+1;
  }
  at=ob_app(ob,at,"]\n");
  set32(atp,0,at);
  return;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let wb:[]u8=z_alloc(65536);
  let key:[]u8=z_alloc(128);
  let w:i32=0;
  while(w<9){
    a_build(w,wb,key);
    if(w==0){kd_upairs(wb,ob,atp,"W0");}
    if(w==1){kd_upairs(wb,ob,atp,"FA");}
    if(w==2){kd_upairs(wb,ob,atp,"FB");}
    if(w==3){kd_upairs(wb,ob,atp,"FC");}
    if(w==4){kd_upairs(wb,ob,atp,"FD");}
    if(w==5){kd_upairs(wb,ob,atp,"FE");kd_pi(key,ob,atp);}
    if(w==6){kd_upairs(wb,ob,atp,"FF");kd_sch(key,ob,atp);}
    if(w==7){kd_upairs(wb,ob,atp,"FG");}
    if(w==8){kd_upairs(wb,ob,atp,"FX");}
    w=w+1;
  }
  write_ob(ob,atp);
  return 0;
}

  let t5_part:i32=a_t5_check(wb5,save4,save5,key5);
  let t5_pass:i32=h_and(t5_bars,h_and(t5_noreinv,t5_part));
  e3(ob,atp,"T5 wrong=",(t5_wrong)," cdet=",(t5_cdet)," aud=",(t5_aud));
  e3(ob,atp,"T5 reinvent=",(t5_reinv)," part=",(t5_part)," bars=",(t5_bars));
  d_bar2(ob,atp,"T5",t5_pass);
  e0(ob,atp,"=== TREATMENT T6 (REVISE) ===");
  let r6:i32=h_treat_arm(wb6,KB,AS,LOG,TR,PR,train,form,sc,sres);
  h_held_tally(wb6,sres,tally);
  let t6_wrong:i32=get32(tally,0);
  let t6_cdet:i32=get32(tally,4);
  let t6_aud:i32=get32(tally,8);
  let t6_ddet:i32=get32(tally,12);
  let t6_dund:i32=get32(tally,16);
  let t6_b1:i32=0;
  if(t6_wrong==0){t6_b1=1;}
  let t6_b2:i32=0;
  if(t6_cdet*6>=5*t6_ddet){t6_b2=1;}
  let t6_b3:i32=0;
  if(t6_aud==t6_dund){t6_b3=1;}
  let t6_bars:i32=h_and(t6_b1,h_and(t6_b2,t6_b3));
  l_form_copy(form,save6);
  let t6_lin:i32=a_t6_lineage(save6,key6);
  let t6_linp:i32=0;
  if(t6_lin*100>=80*5){t6_linp=1;}
  let t6_pass:i32=h_and(t6_bars,t6_linp);
  e3(ob,atp,"T6 wrong=",(t6_wrong)," cdet=",(t6_cdet)," aud=",(t6_aud));
  e2(ob,atp,"T6 lineage_matches=",(t6_lin)," bars=",(t6_bars));
  d_bar2(ob,atp,"T6",t6_pass);
  e0(ob,atp,"=== TREATMENT T7 (RETIRE) ===");
  let r7:i32=h_treat_arm(wb7,KB,AS,LOG,TR,PR,train,form,sc,sres);
  h_held_tally(wb7,sres,tally);
  let t7_cdet:i32=get32(tally,4);
  let t7_um:i32=get32(AS,44);
  let t7_ck:i32=get32(AS,88);
  let t7_h:i32=0;
  if(t7_cdet>=5){t7_h=1;}
  let t7_nm:i32=0;
  if(t7_um==0){t7_nm=1;}
  let t7_ng:i32=0;
  if(t7_ck!=2){t7_ng=1;}
  let t7_pass:i32=h_and(t7_h,h_and(t7_nm,t7_ng));
  e3(ob,atp,"T7 held_correct=",(t7_cdet)," unres_marks=",(t7_um)," commit_kind=",(t7_ck));
  d_bar2(ob,atp,"T7",t7_pass);
  // ============ ATTACK ARM X-CTX (R-SUF-3) ============
  e0(ob,atp,"=== ATTACK X-CTX (CTX-NOVEL) ===");
  let rx:i32=h_treat_arm(wb8,KB,AS,LOG,TR,PR,train,form,sc,sres);
  h_held_tally(wb8,sres,tally);
  let tx_wrong:i32=get32(tally,0);
  let tx_cdet:i32=get32(tally,4);
  let tx_aud:i32=get32(tally,8);
  let tx_ddet:i32=get32(tally,12);
  let tx_dund:i32=get32(tally,16);
  let tx_cw:i32=get32(AS,52);
  let tx_b1:i32=0;
  if(tx_wrong==0){tx_b1=1;}
  let tx_b2:i32=0;
  if(tx_cdet*6>=5*tx_ddet){tx_b2=1;}
  let tx_b3:i32=0;
  if(tx_aud==tx_dund){tx_b3=1;}
  let tx_pass:i32=h_and(tx_b1,h_and(tx_b2,tx_b3));
  e3(ob,atp,"TX wrong=",(tx_wrong)," cdet=",(tx_cdet)," ddet=",(tx_ddet));
  e3(ob,atp,"TX abst_und=",(tx_aud)," dund=",(tx_dund)," conf_wrong_r1=",(tx_cw));
  d_bar2(ob,atp,"X-CTX",tx_pass);
  // ============ CONTROLS ============
  e0(ob,atp,"=== CONTROLS ===");
  let c0a:i32=h_c0_arm(wb1,AS,TR,PR,train,form,sres);
  let c0_t1:i32=get32(AS,52);
  e1(ob,atp,"C0 T1 conf_wrong=",(c0_t1));
  let c0b:i32=h_c0_arm(wb2,AS,TR,PR,train,form,sres);
  let c0_t2:i32=get32(AS,52);
  e1(ob,atp,"C0 T2 conf_wrong=",(c0_t2));
  let c0c:i32=h_c0_arm(wb3,AS,TR,PR,train,form,sres);
  let c0_t3:i32=get32(AS,52);
  e1(ob,atp,"C0 T3 conf_wrong=",(c0_t3));
  let k6:i32=h_and(c0_t1,h_and(c0_t2,c0_t3));
  d_bar2(ob,atp,"SUF-K6 C0-conf-wrong-T1T2T3",k6);
  let c0x:i32=h_c0_arm(wb8,AS,TR,PR,train,form,sres);
  let c0_tx:i32=get32(AS,52);
  e1(ob,atp,"C0 X-CTX conf_wrong=",(c0_tx));
  let c1r:i32=h_c1_arm(wb2,AS,TR,PR,mem,sres);
  h_held_tally(wb2,sres,tally);
  let c1_wrong:i32=get32(tally,0);
  let c1_cdet:i32=get32(tally,4);
  let c1_aud:i32=get32(tally,8);
  let c1_ddet:i32=get32(tally,12);
  let c1_dund:i32=get32(tally,16);
  let c1_b1:i32=0;
  if(c1_wrong==0){c1_b1=1;}
  let c1_b2:i32=0;
  if(c1_cdet*6>=5*c1_ddet){c1_b2=1;}
  let c1_b3:i32=0;
  if(c1_aud==c1_dund){c1_b3=1;}
  let c1_passbars:i32=h_and(c1_b1,h_and(c1_b2,c1_b3));
  let c1_fail:i32=0;
  if(c1_passbars==0){c1_fail=1;}
  e3(ob,atp,"C1 T2 wrong=",(c1_wrong)," cdet=",(c1_cdet)," aud=",(c1_aud));
  d_bar2(ob,atp,"C1-fails-T2",c1_fail);
  let c2r:i32=h_treat_arm(wb4,KB2,AS,LOG,TR,PR,train,form,sc,sres);
  let c2_tests:i32=get32(AS,4);
  e1(ob,atp,"C2 T4 tests=",(c2_tests));
  let c3r:i32=h_c3_arm(wb3,KBT0,AS,LOG,TR,PR,train,form,sc,sres);
  let c3_comm:i32=get32(AS,48);
  let c3_cw:i32=get32(AS,52);
  let c3_fail:i32=h_and(c3_comm,c3_cw);
  e2(ob,atp,"C3 T3 committed=",(c3_comm)," conf_wrong=",(c3_cw));
  d_bar2(ob,atp,"C3-confidently-wrong",c3_fail);
  // ============ KILL BARS ============
  e0(ob,atp,"=== KILL BARS ===");
  d_bar2(ob,atp,"SEAL-GATE",gate_pass);
  d_bar2(ob,atp,"SEAL-T0 invent",t0_pass);
  d_bar2(ob,atp,"SEAL-T1 probe-active",t1_pass);
  d_bar2(ob,atp,"SEAL-T2 abstain",t2_pass);
  d_bar2(ob,atp,"SEAL-T3 trust",t3_pass);
  let t4_ratio:i32=0;
  if(t4_tests*2<=c2_tests){t4_ratio=1;}
  let t4_pass:i32=h_and(t4_bars,h_and(t4_ratio,t4_noreinv));
  d_bar2(ob,atp,"SEAL-T4 reuse",t4_pass);
  d_bar2(ob,atp,"SEAL-T5 recode",t5_pass);
  d_bar2(ob,atp,"SEAL-T6 revise",t6_pass);
  d_bar2(ob,atp,"SEAL-T7 retire",t7_pass);
  d_bar2(ob,atp,"SEAL-T8 x-ctx",tx_pass);
  d_bar2(ob,atp,"SEAL-C0 (K6)",k6);
  d_bar2(ob,atp,"SEAL-C1-fails (K9a)",c1_fail);
  d_bar2(ob,atp,"SEAL-C3 (K9b)",c3_fail);
  let k9:i32=h_and(c1_fail,c3_fail);
  d_bar2(ob,atp,"SUF-K9 beats-controls",k9);
  let k5:i32=h_and(t1_pass,h_and(t2_pass,h_and(t3_pass,h_and(t5_pass,t6_pass))));
  d_bar2(ob,atp,"SUF-K5 hidden-instances",k5);
  let k11:i32=h_and(t6_pass,t7_pass);
  d_bar2(ob,atp,"SUF-K11 revisable-retirable",k11);
  d_bar2(ob,atp,"SUF-K2 created-after-experience",t0_i);
  d_bar2(ob,atp,"SUF-KC0B open-form",t0_ii);
  let kc0d_ab:i32=0;
  if(t2_nab>0){kc0d_ab=1;}
  let kc0d:i32=h_and(t4_ratio,kc0d_ab);
  d_bar2(ob,atp,"SUF-KC0D cognitive-reuse",kc0d);
  d_bar2(ob,atp,"SEAL-KC0C sealed-worlds",1);
  e2(ob,atp,"GATE pass=",(gate_pass)," T0 pass=",(t0_pass));
  e2(ob,atp,"T4 tests=",(t4_tests)," C2 tests=",(c2_tests));
  e1(ob,atp,"T4 ratio ok=",(t4_ratio));
  e0(ob,atp,"SUF-ADV-END");
  write_ob(ob,atp);
  return 0;
}

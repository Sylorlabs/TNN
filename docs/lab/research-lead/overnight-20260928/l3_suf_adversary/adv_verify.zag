// adv_verify.zag -- R-SUF-1/R-SUF-5 surgical-marking verification (harness-side).
// V1: on W0, the committed record must mark U pairs 3 and decoy pairs 1/2.
// V2: on F-G (after a T0-primed kb), no UNRESOLVED marks may appear.
// Pure Zag, safebin.
fn v_rec_mask(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let roff:i32=get32(f,8);
  if(roff==0){return -2;}
  let nrec:i32=get32(f,roff);
  let i:i32=0;
  while(i<nrec){
    let b:i32=roff+4+i*20;
    let es:i32=get32(f,b);
    let ex:i32=get32(f,b+4);
    let ey:i32=get32(f,b+8);
    if(es==s0){
      let hit:i32=0;
      if(ex==x){if(ey==y){hit=1;}}
      if(ex==y){if(ey==x){hit=1;}}
      if(hit==1){return get32(f,b+12);}
    }
    i=i+1;
  }
  return -1;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let wb0:[]u8=z_alloc(65536);
  let wb7:[]u8=z_alloc(65536);
  let key0:[]u8=z_alloc(64);
  let keyt:[]u8=z_alloc(64);
  a_build(0,wb0,key0);
  a_build(7,wb7,keyt);
  let KB:[]u8=z_alloc(32768);
  let AS:[]u8=z_alloc(256);
  let LOG:[]u8=z_alloc(32768);
  let TR:[]u8=z_alloc(262144);
  let PR:[]u8=z_alloc(131072);
  let train:[]u8=z_alloc(4096);
  let form:[]u8=z_alloc(16384);
  let sc:[]u8=z_alloc(16384);
  let sres:[]u8=z_alloc(4096);
  l_kb_wipe(KB);
  // ---- V1: T0 on W0, check record masks ----
  e0(ob,atp,"=== V1 surgical marking (W0) ===");
  let r0:i32=h_treat_arm(wb0,KB,AS,LOG,TR,PR,train,form,sc,sres);
  let n:i32=get32(wb0,0);
  let uoff:i32=get32(wb0,32);
  let eoff:i32=get32(wb0,16);
  let at:i32=get32(atp,0);
  let u_ok:i32=1;
  let u_n:i32=0;
  let i:i32=0;
  while(i<n){
    let j:i32=i+1;
    while(j<n){
      if(wb0[uoff+i*n+j]==1){
        u_n=u_n+1;
        let xid:i32=get32(wb0,eoff+i*4);
        let yid:i32=get32(wb0,eoff+j*4);
        // check both ctx ids 41,42
        let m0:i32=v_rec_mask(form,41,xid,yid);
        let m1:i32=v_rec_mask(form,42,xid,yid);
        at=ob_app(ob,at,"U pair mask ctx0=");
        at=ob_i32(ob,at,m0);
        at=ob_app(ob,at," ctx1=");
        at=ob_i32(ob,at,m1);
        at=ob_nl(ob,at);
        if(m0!=3){u_ok=0;}
        if(m1!=3){u_ok=0;}
      }
      j=j+1;
    }
    i=i+1;
  }
  set32(atp,0,at);
  e2(ob,atp,"V1 U pairs checked=",(u_n)," all_mask3=",(u_ok));
  // decoys from key0
  let dq0x:i32=get32(key0,0);
  let dq0y:i32=get32(key0,4);
  let dq1x:i32=get32(key0,8);
  let dq1y:i32=get32(key0,12);
  let dm0a:i32=v_rec_mask(form,41,dq0x,dq0y);
  let dm0b:i32=v_rec_mask(form,42,dq0x,dq0y);
  let dm1a:i32=v_rec_mask(form,41,dq1x,dq1y);
  let dm1b:i32=v_rec_mask(form,42,dq1x,dq1y);
  e2(ob,atp,"V1 decoy0 masks=",(dm0a)," ",(dm0b));
  e2(ob,atp,"V1 decoy1 masks=",(dm1a)," ",(dm1b));
  let d_ok:i32=1;
  if(dm0a==3){d_ok=0;}
  if(dm0a==0){d_ok=0;}
  if(dm0a==-1){d_ok=0;}
  if(dm0b==3){d_ok=0;}
  if(dm0b==0){d_ok=0;}
  if(dm0b==-1){d_ok=0;}
  if(dm1a==3){d_ok=0;}
  if(dm1a==0){d_ok=0;}
  if(dm1a==-1){d_ok=0;}
  if(dm1b==3){d_ok=0;}
  if(dm1b==0){d_ok=0;}
  if(dm1b==-1){d_ok=0;}
  e1(ob,atp,"V1 decoys resolved (1/2)=",(d_ok));
  let v1:i32=0;
  if(u_ok==1){
    if(d_ok==1){v1=1;}
  }
  d_bar2(ob,atp,"V1 surgical-marking",v1);
  // ---- V2: F-G with T0-primed kb, expect zero UNRESOLVED marks ----
  e0(ob,atp,"=== V2 no marking on F-G ===");
  let r7:i32=h_treat_arm(wb7,KB,AS,LOG,TR,PR,train,form,sc,sres);
  let um:i32=get32(AS,44);
  let ck:i32=get32(AS,88);
  e2(ob,atp,"V2 unres_marks=",(um)," commit_kind=",(ck));
  let v2:i32=0;
  if(um==0){
    if(ck!=2){v2=1;}
  }
  d_bar2(ob,atp,"V2 no-marks-on-FG",v2);
  e0(ob,atp,"SUF-ADV-VERIFY-END");
  write_ob(ob,atp);
  return 0;
}

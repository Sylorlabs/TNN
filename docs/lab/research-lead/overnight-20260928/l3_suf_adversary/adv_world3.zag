
// ---- F-G RETIRE-PLAIN: no gating (g1=g0); tempting extras ----
fn a_ph_fg(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1007,1,1);
  let i:i32=0;
  while(i<100){ws[120+i]=ws[20+i];i=i+1;}
  let allp:[]u8=z_alloc(400);
  let n:i32=0;
  i=0;
  while(i<10){
    let j:i32=i+1;
    while(j<10){set32(allp,n*4,i*10+j);n=n+1;j=j+1;}
    i=i+1;
  }
  a_shuf_list(r,allp,n);
  let k:i32=0;
  while(k<20){
    let p:i32=get32(allp,k*4);
    let ci:i32=rng_range(r,2);
    a_tr_add(ws,ci,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  // tempting: 6 untrained pairs: 3 ANTI-TB (0,0), 3 TB-consistent (1,1)
  // ids 770+i, i<j -> tb=1
  let cand:[]u8=z_alloc(400);
  a_unused_shuf(r,ws,cand);
  k=0;
  while(k<6){
    let p:i32=get32(cand,k*4);
    if(k<3){a_ov_add(ws,p/10,p%10,0,0);}
    else {a_ov_add(ws,p/10,p%10,1,1);}
    a_mark_used(ws,p/10,p%10);
    k=k+1;
  }
  k=0;
  while(k<6){
    a_st_add(ws,get32(ws,1280+k*4),get32(ws,1536+k*4),get32(ws,1792+k*4),1,0);
    k=k+1;
  }
  k=0;
  while(k<3){
    let p:i32=get32(cand,k*4);
    a_st_add(ws,k%2,p/10,p%10,0,0);
    k=k+1;
  }
  k=3;
  while(k<6){
    let p:i32=get32(cand,k*4);
    a_st_add(ws,(k+1)%2,p/10,p%10,0,0);
    k=k+1;
  }
  return;
}
// ---- X-CTX CTX-NOVEL: all training at ctx0; unseen ctx1 queries ----
fn a_ph_fx(r:[]u8, ws:[]u8)void {
  a_phase_gen(r,ws,1008,1,0);
  let na:i32=get32(ws,16);
  let k:i32=0;
  while(k<6){
    let p:i32=get32(ws,320+k*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  k=0;
  while(k<14){
    let p:i32=get32(ws,720+(k%na)*4);
    a_tr_add(ws,0,p/10,p%10,wg(ws,0,p/10,p%10));
    k=k+1;
  }
  // unseen: 6 untrained pairs; ctx1 truth overridden to ANTI-TB (0)
  let cand:[]u8=z_alloc(400);
  a_unused_shuf(r,ws,cand);
  k=0;
  while(k<6){
    let p:i32=get32(cand,k*4);
    let pi2:i32=p/10;
    let pj2:i32=p%10;
    a_ov_add(ws,pi2,pj2,wg(ws,0,pi2,pj2),0);
    a_mark_used(ws,pi2,pj2);
    k=k+1;
  }
  k=0;
  while(k<3){
    a_st_add(ws,0,get32(ws,1536+k*4),get32(ws,1792+k*4),1,0);
    let p:i32=get32(cand,k*4);
    a_st_add(ws,1,p/10,p%10,1,1);
    k=k+1;
  }
  k=3;
  while(k<6){
    a_st_add(ws,0,get32(ws,1536+k*4),get32(ws,1792+k*4),0,0);
    let p:i32=get32(cand,k*4);
    a_st_add(ws,1,p/10,p%10,0,1);
    k=k+1;
  }
  return;
}
// ---- emit WS into WB ----
fn a_emit(ws:[]u8, wb:[]u8, entb:i32, c0id:i32)void {
  let nent:i32=10;
  let nctx:i32=2;
  set32(wb,0,nent);
  set32(wb,4,nctx);
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+nctx*4;
  let poff:i32=toff+nctx*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){set32(wb,eoff+i*4,entb+i);i=i+1;}
  set32(wb,coff,c0id);
  set32(wb,coff+4,c0id+1);
  let nov:i32=get32(ws,8);
  let c:i32=0;
  while(c<nctx){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        let a:i32=a_canon_a(i,j);
        let b:i32=a_canon_b(i,j);
        let v:i32=wg(ws,c,a,b);
        let kk:i32=0;
        while(kk<nov){
          if(get32(ws,1160+kk*4)==a*10+b){
            if(c==0){v=get32(ws,1200+kk*4);}
            else {v=get32(ws,1240+kk*4);}
          }
          kk=kk+1;
        }
        wb[toff+(c*nent+i)*nent+j]=v as u8;
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  i=0;
  while(i<nent*nent){wb[poff+i]=1;wb[uoff+i]=0;i=i+1;}
  let nup:i32=get32(ws,4);
  let k2:i32=0;
  while(k2<nup){
    let p:i32=get32(ws,1120+k2*4);
    w_mark_u(wb,nent,toff,poff,uoff,eoff,p/10,p%10);
    k2=k2+1;
  }
  let ntr:i32=get32(ws,0);
  set32(wb,8,ntr);
  let q:i32=0;
  let ti:i32=0;
  while(q<ntr){
    ti=w_emit_train(wb,troff,ti,get32(ws,1280+q*4),get32(ws,1536+q*4),get32(ws,1792+q*4),get32(ws,2048+q*4));
    q=q+1;
  }
  let soff:i32=troff+ntr*16;
  set32(wb,40,soff);
  let nst:i32=get32(ws,2304);
  set32(wb,12,nst);
  let s2:i32=0;
  let si:i32=0;
  while(s2<nst){
    si=w_emit_stakes(wb,soff,si,get32(ws,2308+s2*4),get32(ws,2356+s2*4),get32(ws,2404+s2*4),get32(ws,2452+s2*4),get32(ws,2500+s2*4));
    s2=s2+1;
  }
  return;
}
// ---- F-E RECODE-PERM: FD structure through pi (seed 1005) ----
fn a_build_fe(wb:[]u8, key:[]u8)void {
  let wbt:[]u8=z_alloc(65536);
  let keyt:[]u8=z_alloc(64);
  a_build(4,wbt,keyt);
  let r:[]u8=z_alloc(8);
  rng_seed(r,1005);
  let pi:[]u8=z_alloc(40);
  w_shuffle(r,pi,10);
  let pinv:[]u8=z_alloc(40);
  w_pos_of(pi,pinv,10);
  let nent:i32=10;
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+8;
  let poff:i32=toff+2*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,0,nent);
  set32(wb,4,2);
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){set32(wb,eoff+i*4,750+i);i=i+1;}
  set32(wb,coff,51);
  set32(wb,coff+4,52);
  let tbt:i32=get32(wbt,24);
  let pbt:i32=get32(wbt,28);
  let ubt:i32=get32(wbt,32);
  let c:i32=0;
  while(c<2){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        let a:i32=get32(pi,i*4);
        let b:i32=get32(pi,j*4);
        wb[toff+(c*nent+i)*nent+j]=wbt[tbt+(c*nent+a)*nent+b];
        wb[poff+i*nent+j]=wbt[pbt+a*nent+b];
        wb[uoff+i*nent+j]=wbt[ubt+a*nent+b];
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  // U truth: ANTI-TB in E ids (750+i sequential, i<j -> tb=1 -> truth 0)
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(wb[uoff+i*nent+j]==1){
        wb[toff+(0*nent+i)*nent+j]=0;
        wb[toff+(0*nent+j)*nent+i]=0;
        wb[toff+(1*nent+i)*nent+j]=0;
        wb[toff+(1*nent+j)*nent+i]=0;
      }
      j=j+1;
    }
    i=i+1;
  }
  let nt:i32=get32(wbt,8);
  let wtroff:i32=get32(wbt,36);
  set32(wb,8,nt);
  let k:i32=0;
  let ti:i32=0;
  while(k<nt){
    let s:i32=get32(wbt,wtroff+k*16);
    let a:i32=get32(wbt,wtroff+k*16+4);
    let b:i32=get32(wbt,wtroff+k*16+8);
    let d:i32=get32(wbt,wtroff+k*16+12);
    ti=w_emit_train(wb,troff,ti,s,get32(pinv,a*4),get32(pinv,b*4),d);
    k=k+1;
  }
  let soff:i32=troff+nt*16;
  set32(wb,40,soff);
  let ns:i32=get32(wbt,12);
  let wsoff:i32=get32(wbt,40);
  set32(wb,12,ns);
  let si:i32=0;
  k=0;
  while(k<ns){
    let s2:i32=get32(wbt,wsoff+k*20);
    let a2:i32=get32(wbt,wsoff+k*20+4);
    let b2:i32=get32(wbt,wsoff+k*20+8);
    let h2:i32=get32(wbt,wsoff+k*20+12);
    let m2:i32=get32(wbt,wsoff+k*20+16);
    si=w_emit_stakes(wb,soff,si,s2,get32(pinv,a2*4),get32(pinv,b2*4),h2,m2);
    k=k+1;
  }
  i=0;
  while(i<10){
    set32(key,i*4,get32(pi,i*4));
    set32(key,40+i*4,get32(pinv,i*4));
    i=i+1;
  }
  return;
}
// ---- F-F REGIME-5: FD base, fresh ids, S_ch (3 det->U, 2 U->det) ----
fn a_build_ff(wb:[]u8, key:[]u8)void {
  let wbt:[]u8=z_alloc(65536);
  let keyt:[]u8=z_alloc(64);
  a_build(4,wbt,keyt);
  let nent:i32=10;
  let eoff:i32=44;
  let coff:i32=eoff+nent*4;
  let toff:i32=coff+8;
  let poff:i32=toff+2*nent*nent;
  let uoff:i32=poff+nent*nent;
  let troff:i32=uoff+nent*nent;
  set32(wb,0,nent);
  set32(wb,4,2);
  set32(wb,16,eoff);
  set32(wb,20,coff);
  set32(wb,24,toff);
  set32(wb,28,poff);
  set32(wb,32,uoff);
  set32(wb,36,troff);
  let i:i32=0;
  while(i<nent){set32(wb,eoff+i*4,760+i);i=i+1;}
  set32(wb,coff,53);
  set32(wb,coff+4,54);
  let tbt:i32=get32(wbt,24);
  let pbt:i32=get32(wbt,28);
  let ubt:i32=get32(wbt,32);
  let c:i32=0;
  while(c<2){
    i=0;
    while(i<nent){
      let j:i32=0;
      while(j<nent){
        wb[toff+(c*nent+i)*nent+j]=wbt[tbt+(c*nent+i)*nent+j];
        j=j+1;
      }
      i=i+1;
    }
    c=c+1;
  }
  i=0;
  while(i<nent*nent){
    wb[poff+i]=wbt[pbt+i];
    wb[uoff+i]=wbt[ubt+i];
    i=i+1;
  }
  let nt:i32=get32(wbt,8);
  let wtroff:i32=get32(wbt,36);
  set32(wb,8,nt);
  let k:i32=0;
  let ti:i32=0;
  while(k<nt){
    ti=w_emit_train(wb,troff,ti,get32(wbt,wtroff+k*16),get32(wbt,wtroff+k*16+4),get32(wbt,wtroff+k*16+8),get32(wbt,wtroff+k*16+12));
    k=k+1;
  }
  // in-training set
  let intr:[]u8=z_alloc(100);
  k=0;
  while(k<nt){
    let a:i32=get32(wb,troff+k*16+4);
    let b:i32=get32(wb,troff+k*16+8);
    intr[a_canon_a(a,b)*10+a_canon_b(a,b)]=1;
    k=k+1;
  }
  // generator truth for restored pairs: FD seed 1004, g0=PAR, g1=ORD(perm1)
  let r4:[]u8=z_alloc(8);
  rng_seed(r4,1004);
  let pm0:[]u8=z_alloc(40);
  let pm1:[]u8=z_alloc(40);
  let ps1:[]u8=z_alloc(40);
  w_shuffle(r4,pm0,10);
  w_shuffle(r4,pm1,10);
  w_pos_of(pm1,ps1,10);
  let r:[]u8=z_alloc(8);
  rng_seed(r,1006);
  // select R1,R2: first 2 index-order undet pairs (pure U_D)
  let r1i:i32=-1;
  let r1j:i32=-1;
  let r2i:i32=-1;
  let r2j:i32=-1;
  let nr:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(nr<2){
        if(wb[uoff+i*nent+j]==1){
          if(nr==0){r1i=i;r1j=j;}
          else {r2i=i;r2j=j;}
          nr=nr+1;
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // select N1..N3: det->U candidates (probeable, determined, untrained, not R1/R2)
  let cand:[]u8=z_alloc(400);
  let nc:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(wb[poff+i*nent+j]==1){
        if(wb[uoff+i*nent+j]==0){
          if(intr[i*10+j]==0){
            let isr:i32=0;
            if(i==r1i){if(j==r1j){isr=1;}}
            if(i==r2i){if(j==r2j){isr=1;}}
            if(isr==0){set32(cand,nc*4,i*10+j);nc=nc+1;}
          }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  a_shuf_list(r,cand,nc);
  let n1i:[]u8=z_alloc(12);
  let n1j:[]u8=z_alloc(12);
  k=0;
  while(k<3){
    let p:i32=get32(cand,k*4);
    let a:i32=p/10;
    let b:i32=p%10;
    w_mark_u(wb,nent,toff,poff,uoff,eoff,a,b);
    set32(n1i,k*4,a);
    set32(n1j,k*4,b);
    set32(key,k*12,760+a);
    set32(key,k*12+4,760+b);
    set32(key,k*12+8,1);
    k=k+1;
  }
  // apply restores R1,R2
  let ri:i32=0;
  while(ri<2){
    let a:i32=r1i;
    let b:i32=r1j;
    if(ri==1){a=r2i;b=r2j;}
    wb[poff+a*nent+b]=1;wb[poff+b*nent+a]=1;
    wb[uoff+a*nent+b]=0;wb[uoff+b*nent+a]=0;
    let v0:i32=0;
    if((a+b)%2==0){v0=1;}
    let v1:i32=0;
    if(get32(ps1,a*4)<get32(ps1,b*4)){v1=1;}
    wb[toff+(0*nent+a)*nent+b]=v0 as u8;
    wb[toff+(0*nent+b)*nent+a]=v0 as u8;
    wb[toff+(1*nent+a)*nent+b]=v1 as u8;
    wb[toff+(1*nent+b)*nent+a]=v1 as u8;
    set32(key,(3+ri)*12,760+a);
    set32(key,(3+ri)*12+4,760+b);
    set32(key,(3+ri)*12+8,0);
    ri=ri+1;
  }
  // training: replace triple 12 (first agreeing) with R1 triple (observed path)
  let sr:i32=rng_range(r,2);
  let rv0:i32=0;
  if((r1i+r1j)%2==0){rv0=1;}
  let rv1:i32=0;
  if(get32(ps1,r1i*4)<get32(ps1,r1j*4)){rv1=1;}
  let rv:i32=rv0;
  if(sr==1){rv=rv1;}
  set32(wb,troff+12*16,sr);
  set32(wb,troff+12*16+4,r1i);
  set32(wb,troff+12*16+8,r1j);
  set32(wb,troff+12*16+12,rv);
  // Uold1,Uold2: first index-order undet pairs excluding N1..N3
  let uo1i:i32=-1;
  let uo1j:i32=-1;
  let uo2i:i32=-1;
  let uo2j:i32=-1;
  let nu2:i32=0;
  i=0;
  while(i<nent){
    let j:i32=i+1;
    while(j<nent){
      if(nu2<2){
        if(wb[uoff+i*nent+j]==1){
          let isn:i32=0;
          let q:i32=0;
          while(q<3){
            if(i==get32(n1i,q*4)){if(j==get32(n1j,q*4)){isn=1;}}
            q=q+1;
          }
          if(isn==0){
            if(nu2==0){uo1i=i;uo1j=j;}
            else {uo2i=i;uo2j=j;}
            nu2=nu2+1;
          }
        }
      }
      j=j+1;
    }
    i=i+1;
  }
  // D pairs from wbt training triples 0,2,4,6,8
  let d0i:i32=get32(wbt,wtroff+4);
  let d0j:i32=get32(wbt,wtroff+8);
  let d1i:i32=get32(wbt,wtroff+2*16+4);
  let d1j:i32=get32(wbt,wtroff+2*16+8);
  let d2i:i32=get32(wbt,wtroff+4*16+4);
  let d2j:i32=get32(wbt,wtroff+4*16+8);
  let d3i:i32=get32(wbt,wtroff+6*16+4);
  let d3j:i32=get32(wbt,wtroff+6*16+8);
  let d4i:i32=get32(wbt,wtroff+8*16+4);
  let d4j:i32=get32(wbt,wtroff+8*16+8);
  // stakes (12)
  let soff:i32=troff+nt*16;
  set32(wb,40,soff);
  let si:i32=0;
  si=w_emit_stakes(wb,soff,si,0,r1i,r1j,1,0);
  si=w_emit_stakes(wb,soff,si,0,d0i,d0j,1,0);
  si=w_emit_stakes(wb,soff,si,1,d1i,d1j,1,0);
  si=w_emit_stakes(wb,soff,si,0,d2i,d2j,1,0);
  si=w_emit_stakes(wb,soff,si,0,get32(n1i,0),get32(n1j,0),1,1);
  si=w_emit_stakes(wb,soff,si,0,uo1i,uo1j,1,1);
  si=w_emit_stakes(wb,soff,si,1,r2i,r2j,0,0);
  si=w_emit_stakes(wb,soff,si,0,d3i,d3j,0,0);
  si=w_emit_stakes(wb,soff,si,1,d4i,d4j,0,0);
  si=w_emit_stakes(wb,soff,si,1,get32(n1i,4),get32(n1j,4),0,1);
  si=w_emit_stakes(wb,soff,si,0,get32(n1i,8),get32(n1j,8),0,1);
  si=w_emit_stakes(wb,soff,si,1,uo2i,uo2j,0,1);
  set32(wb,12,si);
  return;
}
// ---- top-level sealed builder ----
// which: 0=W0 1=FA 2=FB 3=FC 4=FD 5=FE 6=FF 7=FG 8=XCTX
// key: which==5 -> pi[10] + pinv[10]; which==6 -> S_ch (x_id,y_id,new_det)x5
fn a_build(which:i32, wb:[]u8, key:[]u8)void {
  if(which==5){a_build_fe(wb,key);return;}
  if(which==6){a_build_ff(wb,key);return;}
  let r:[]u8=z_alloc(8);
  let ws:[]u8=z_alloc(2560);
  if(which==0){a_ph_w0(r,ws);}
  if(which==1){a_ph_fa(r,ws);}
  if(which==2){a_ph_fb(r,ws);}
  if(which==3){a_ph_fc(r,ws);}
  if(which==4){a_ph_fd(r,ws);}
  if(which==7){a_ph_fg(r,ws);}
  if(which==8){a_ph_fx(r,ws);}
  let entb:i32=700+which*10;
  let c0id:i32=41+which*2;
  a_emit(ws,wb,entb,c0id);
  if(which==0){
    // key: decoy id pairs (for the surgical-marking check)
    let dq0:i32=get32(ws,2548);
    let dq1:i32=get32(ws,2552);
    set32(key,0,entb+dq0/10);
    set32(key,4,entb+dq0%10);
    set32(key,8,entb+dq1/10);
    set32(key,12,entb+dq1%10);
  }
  return;
}

// adv_world.zag -- SEALED worlds for the L3-SUF-1 adversary battery.
// Implements the FROZEN world interface (CODEFREEZE.md):
//   learner-visible: w_observe, w_test, w_stakes
//   harness-only:    w_truth, w_stakes_meta, w_undet
// WB layout is exactly the frozen layout (i32 header + regions):
//   0: nent   4: nctx   8: ntrain   12: nstakes
//   16: off_ent_ids (nent i32 ids)
//   20: off_ctx_ids (nctx i32 ids)
//   24: off_truth   (nctx*nent*nent bytes, d in {0,1})
//   28: off_probe   (nent*nent bytes, 1=probeable)
//   32: off_undet   (nent*nent bytes, 1=undetermined; key/scoring only)
//   36: off_train   (ntrain*4 i32s: s0i, xi, yi, d)   [indices]
//   40: off_stakes  (nstakes*5 i32s: s0i, xi, yi, is_heldout, det)
// The interface functions below are re-implemented to the frozen spec.
// The sealed content is a_build() (worlds 0..8). The learner NEVER calls
// w_truth / w_undet / w_stakes_meta (A-INFO boundary).

// ---- index helpers ----
fn w_ent_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,16);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_ctx_idx(wb:[]u8, id:i32)i32 {
  let n:i32=get32(wb,4);
  let off:i32=get32(wb,20);
  let i:i32=0;
  while(i<n){
    if(get32(wb,off+i*4)==id){return i;}
    i=i+1;
  }
  return -1;
}
fn w_truth_idx(wb:[]u8, s0i:i32, xi:i32, yi:i32)i32 {
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,24);
  return wb[off+(s0i*n+xi)*n+yi] as i32;
}
// LEARNER-VISIBLE: TEST-PAIR/TRIPLE. Returns 1=ACCEPT, 0=REJECT.
// Unprobeable pairs withhold: REJECT every predicted value.
fn w_test(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32, v:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return 0;}
  if(xi<0){return 0;}
  if(yi<0){return 0;}
  let n:i32=get32(wb,0);
  let poff:i32=get32(wb,28);
  if(wb[poff+xi*n+yi]==0){return 0;}
  let t:i32=w_truth_idx(wb,s0i,xi,yi);
  if(t==v){return 1;}
  return 0;
}
// HARNESS ONLY: ground truth. The learner never calls this.
fn w_truth(wb:[]u8, s0_id:i32, x_id:i32, y_id:i32)i32 {
  let s0i:i32=w_ctx_idx(wb,s0_id);
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(s0i<0){return -1;}
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  return w_truth_idx(wb,s0i,xi,yi);
}
// HARNESS ONLY: undetermined flag for a pair (key/scoring).
fn w_undet(wb:[]u8, x_id:i32, y_id:i32)i32 {
  let xi:i32=w_ent_idx(wb,x_id);
  let yi:i32=w_ent_idx(wb,y_id);
  if(xi<0){return -1;}
  if(yi<0){return -1;}
  let n:i32=get32(wb,0);
  let off:i32=get32(wb,32);
  return wb[off+xi*n+yi] as i32;
}
// LEARNER-VISIBLE: OBSERVE. Fills out with (s0_id,x_id,y_id,d) quads.
fn w_observe(wb:[]u8, out:[]u8)i32 {
  let nt:i32=get32(wb,8);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let toff:i32=get32(wb,36);
  let i:i32=0;
  while(i<nt){
    let s0i:i32=get32(wb,toff+i*16);
    let xi:i32=get32(wb,toff+i*16+4);
    let yi:i32=get32(wb,toff+i*16+8);
    let d:i32=get32(wb,toff+i*16+12);
    set32(out,i*16,get32(wb,coff+s0i*4));
    set32(out,i*16+4,get32(wb,eoff+xi*4));
    set32(out,i*16+8,get32(wb,eoff+yi*4));
    set32(out,i*16+12,d);
    i=i+1;
  }
  return nt;
}
// LEARNER-VISIBLE: stakes sample. Fills out with (s0_id,x_id,y_id).
fn w_stakes(wb:[]u8, out:[]u8)i32 {
  let ns:i32=get32(wb,12);
  let eoff:i32=get32(wb,16);
  let coff:i32=get32(wb,20);
  let soff:i32=get32(wb,40);
  let i:i32=0;
  while(i<ns){
    let s0i:i32=get32(wb,soff+i*20);
    let xi:i32=get32(wb,soff+i*20+4);
    let yi:i32=get32(wb,soff+i*20+8);
    set32(out,i*12,get32(wb,coff+s0i*4));
    set32(out,i*12+4,get32(wb,eoff+xi*4));
    set32(out,i*12+8,get32(wb,eoff+yi*4));
    i=i+1;
  }
  return ns;
}
// HARNESS ONLY: (is_heldout, det_status) for stakes index i.
fn w_stakes_meta(wb:[]u8, i:i32, out:[]u8)void {
  let soff:i32=get32(wb,40);
  set32(out,0,get32(wb,soff+i*20+12));
  set32(out,4,get32(wb,soff+i*20+16));
  return;
}
// ---- Fisher-Yates shuffle of perm[0..n-1] ----
fn w_shuffle(r:[]u8, perm:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){set32(perm,i*4,i);i=i+1;}
  i=n-1;
  while(i>0){
    let j:i32=rng_range(r,i+1);
    let t:i32=get32(perm,i*4);
    set32(perm,i*4,get32(perm,j*4));
    set32(perm,j*4,t);
    i=i-1;
  }
  return;
}
fn w_pos_of(perm:[]u8, pos:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    let x:i32=get32(perm,i*4);
    set32(pos,x*4,i);
    i=i+1;
  }
  return;
}
// emit one training quad into the train region; returns new ti
fn w_emit_train(wb:[]u8, troff:i32, ti:i32, s0i:i32, xi:i32, yi:i32, d:i32)i32 {
  set32(wb,troff+ti*16,s0i);
  set32(wb,troff+ti*16+4,xi);
  set32(wb,troff+ti*16+8,yi);
  set32(wb,troff+ti*16+12,d);
  return ti+1;
}
// emit one stakes entry; returns new si
fn w_emit_stakes(wb:[]u8, soff:i32, si:i32, s0i:i32, xi:i32, yi:i32, held:i32, det:i32)i32 {
  set32(wb,soff+si*20,s0i);
  set32(wb,soff+si*20+4,xi);
  set32(wb,soff+si*20+8,yi);
  set32(wb,soff+si*20+12,held);
  set32(wb,soff+si*20+16,det);
  return si+1;
}
// mark pair (x,y) as U: unprobeable, undetermined, truth=anti-tiebreak
// on entity IDS (matches the learner's documented l_tiebreak on ids).
fn w_mark_u(wb:[]u8, nent:i32, toff:i32, poff:i32, uoff:i32, eoff:i32, x:i32, y:i32)void {
  let idx:i32=get32(wb,eoff+x*4);
  let idy:i32=get32(wb,eoff+y*4);
  let tb:i32=0;
  if(idx<idy){tb=1;}
  let ud:i32=1-tb;
  wb[poff+x*nent+y]=0;wb[poff+y*nent+x]=0;
  wb[uoff+x*nent+y]=1;wb[uoff+y*nent+x]=1;
  wb[toff+(0*nent+x)*nent+y]=ud as u8;
  wb[toff+(0*nent+y)*nent+x]=ud as u8;
  wb[toff+(1*nent+x)*nent+y]=ud as u8;
  wb[toff+(1*nent+y)*nent+x]=ud as u8;
  return;
}

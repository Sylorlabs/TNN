// keydump.zag -- adversary key extraction (harness-side inspection).
// Builds each sealed world and prints the key facts: U sets (undet table),
// F-E pi/pi_inv, F-F S_ch. Pure Zag, safebin.
fn kd_upairs(wb:[]u8, ob:[]u8, atp:[]u8, tag:[]u8)void {
  let n:i32=get32(wb,0);
  let uoff:i32=get32(wb,32);
  let eoff:i32=get32(wb,16);
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," U={");
  let i:i32=0;
  while(i<n){
    let j:i32=i+1;
    while(j<n){
      if(wb[uoff+i*n+j]==1){
        at=ob_app(ob,at,"(");
        at=ob_i32(ob,at,get32(wb,eoff+i*4));
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,get32(wb,eoff+j*4));
        at=ob_app(ob,at,")");
      }
      j=j+1;
    }
    i=i+1;
  }
  at=ob_app(ob,at,"}\n");
  set32(atp,0,at);
  return;
}
fn kd_pi(key5:[]u8, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"FE pi=[");
  let i:i32=0;
  while(i<10){
    at=ob_i32(ob,at,get32(key5,i*4));
    if(i<9){at=ob_app(ob,at,",");}
    i=i+1;
  }
  at=ob_app(ob,at,"] pinv=[");
  i=0;
  while(i<10){
    at=ob_i32(ob,at,get32(key5,40+i*4));
    if(i<9){at=ob_app(ob,at,",");}
    i=i+1;
  }
  at=ob_app(ob,at,"]\n");
  // involution check: pi[pi[i]]==i for all i ?
  let inv:i32=1;
  i=0;
  while(i<10){
    let p:i32=get32(key5,i*4);
    let pp:i32=get32(key5,p*4);
    if(pp!=i){inv=0;}
    i=i+1;
  }
  at=ob_app(ob,at,"FE pi_is_involution=");
  at=ob_i32(ob,at,inv);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}
fn kd_sch(key6:[]u8, ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,"FF S_ch=[");
  let k:i32=0;
  while(k<5){
    at=ob_app(ob,at,"(");
    at=ob_i32(ob,at,get32(key6,k*12));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,get32(key6,k*12+4));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,get32(key6,k*12+8));
    at=ob_app(ob,at,")");
    k=k+1;
  }
  at=ob_app(ob,at,"]\n");
  set32(atp,0,at);
  return;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);
  set32(atp,0,0);
  let wb:[]u8=z_alloc(65536);
  let key:[]u8=z_alloc(128);
  let w:i32=0;
  while(w<9){
    a_build(w,wb,key);
    if(w==0){kd_upairs(wb,ob,atp,"W0");}
    if(w==1){kd_upairs(wb,ob,atp,"FA");}
    if(w==2){kd_upairs(wb,ob,atp,"FB");}
    if(w==3){kd_upairs(wb,ob,atp,"FC");}
    if(w==4){kd_upairs(wb,ob,atp,"FD");}
    if(w==5){kd_upairs(wb,ob,atp,"FE");kd_pi(key,ob,atp);}
    if(w==6){kd_upairs(wb,ob,atp,"FF");kd_sch(key,ob,atp);}
    if(w==7){kd_upairs(wb,ob,atp,"FG");}
    if(w==8){kd_upairs(wb,ob,atp,"FX");}
    w=w+1;
  }
  write_ob(ob,atp);
  return 0;
}

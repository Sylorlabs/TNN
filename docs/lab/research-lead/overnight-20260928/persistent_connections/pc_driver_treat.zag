// pc_driver_treat.zag -- persistent connections driver, TREATMENT arm.
// Lean world: 4 distractors (wrong plen, low ids) -> A (plen-5) ->
// small gap -> B (rebind from A, LINK written) -> gap -> C (exploit LINK).
// Ablation variant (pc_driver_abl.zag) deletes type-14 links after B.
fn pc_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn pc_count14(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}
fn pc_dump14(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      emit("LINK14 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8)); emit("\n");
    }
    e=e+1;
  }
  return;
}
fn pc_distractors(W:[]u8)void {
  // 2 plen-3 chains, subjects 10-11.
  let i:i32=0;
  while(i<2){
    let s:i32=10+i; let a:i32=110+i*10; let b:i32=111+i*10;
    ev_teach(W,s,1,a); ev_teach(W,a,1,b);
    let q:i32=ev_query(W,s,61,b,0);
    emit("D3-"); e64(i); emit(" ans="); e64(q); pc_tstat(W);
    i=i+1;
  }
  // 2 plen-4 chains, subjects 20-21.
  i=0;
  while(i<2){
    let s:i32=20+i; let a:i32=120+i*10; let b:i32=121+i*10; let c:i32=122+i*10;
    ev_teach(W,s,1,a); ev_teach(W,a,1,b); ev_teach(W,b,1,c);
    let q:i32=ev_query(W,s,62,c,0);
    emit("D4-"); e64(i); emit(" ans="); e64(q); pc_tstat(W);
    i=i+1;
  }
  return;
}
fn pc_phaseA(W:[]u8)void {
  ev_teach(W,1,1,11); ev_teach(W,11,1,12);
  ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let a:i32=ev_query(W,1,50,14,0);
  emit("A-MAIN ans="); e64(a); pc_tstat(W);
  return;
}
fn pc_gap(W:[]u8)void {
  let i:i32=0; let r:i32=60;
  while(i<20){
    ev_teach(W,5000+i,r,6000+i);
    r=r+1; if(r>69){r=60;}
    i=i+1;
  }
  return;
}
fn pc_phaseB(W:[]u8)void {
  // plen-5 true path, endpoint 114.
  ev_teach(W,101,1,111); ev_teach(W,111,1,112);
  ev_teach(W,112,1,113); ev_teach(W,113,1,114);
  // plen-3 distractor path (endpoint != 114).
  ev_teach(W,101,1,301); ev_teach(W,301,1,302);
  // plen-4 distractor path (endpoint != 114).
  ev_teach(W,101,1,401); ev_teach(W,401,1,402); ev_teach(W,402,1,403);
  let b:i32=ev_query(W,101,50,114,0);
  emit("B-MAIN ans="); e64(b); pc_tstat(W);
  return;
}
fn pc_phaseC(W:[]u8)void {
  // plen-5 true path, endpoint 214, fresh literals.
  ev_teach(W,201,1,211); ev_teach(W,211,1,212);
  ev_teach(W,212,1,213); ev_teach(W,213,1,214);
  // plen-3 distractor path (endpoint != 214).
  ev_teach(W,201,1,311); ev_teach(W,311,1,312);
  // plen-4 distractor path (endpoint != 214).
  ev_teach(W,201,1,411); ev_teach(W,411,1,412); ev_teach(W,412,1,413);
  let c:i32=ev_query(W,201,50,214,0);
  emit("C-MAIN ans="); e64(c); pc_tstat(W);
  return;
}
// Ablation hook: no-op in treatment, deletes links in ablation driver.
fn pc_abl_hook(W:[]u8)void { return; }
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("PERSIST-START\n");
  pc_distractors(W);
  emit("LINK14 after distractors="); e64(pc_count14(W)); emit("\n");
  pc_phaseA(W);
  emit("LINK14 after A="); e64(pc_count14(W)); emit("\n");
  pc_gap(W);
  pc_phaseB(W);
  emit("LINK14 after B="); e64(pc_count14(W)); emit("\n");
  pc_dump14(W);
  pc_abl_hook(W);
  emit("LINK14 after hook="); e64(pc_count14(W)); emit("\n");
  pc_gap(W);
  pc_phaseC(W);
  emit("LINK14 after C="); e64(pc_count14(W)); emit("\n");
  pc_dump14(W);
  emit("PERSIST-END\n");
  return 0;
}

// cc_driver.zag -- Hypothesis C experiment driver.
//
// Constraint-driven assembly: X (r1 plen-4 chains) and Y (r2 plen-4 chains)
// are taught independently, never together. Goal Z is a mixed plen-7 chain
// (r1 x3 then r2 x3), BEYOND trial gather depth (5), so composition is the
// only possible solver. The Z query uses fresh relation 63: no task label,
// no paired examples, no hint, no mention of X or Y.
//
// Arms: TREAT (X+Y -> Z -> Z' reuse), ABL-X (X deleted -> Z must fail),
// ABL-Y (Y deleted -> Z must fail), FRESH (no X/Y -> Z must fail).
// A second binary with compose_on()=0 runs TREAT as the mechanism control.

// ---- instrumentation ----
fn cc_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn cc_count14(W:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}
fn cc_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn cc_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// Structural property evidence: relation sequence extracted from the
// executable graph, not from MAP labels.
fn cc_print_relseq(W:[]u8,m:i32)void {
  let seq:[]u8=z_alloc(28);
  let len:i32=cc_relseq(W,m,seq,7);
  emit("MAP "); e64(m); emit(" relseq=[");
  let i:i32=0;
  while(i<len){if(i>0){emit(",");} e64(get32(seq,i*4)); i=i+1;}
  emit("]\n");
  return;
}
// Ablation: delete MAP(s) promoted for (s,r).
fn cc_del_map_sr(W:[]u8,s:i32,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn cc_dump14(W:[]u8)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==14){
      emit("  LINK14 "); e64(eg(W,e,0)); emit(" -> "); e64(eg(W,e,8)); emit("\n");
    }
    e=e+1;
  }
  return;
}
fn cc_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// X: two r1 plen-4 chains. Y: two r2 plen-4 chains. Never shown together.
fn cc_trainXY(W:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let x1:i32=ev_query(W,11,61,14,0);
  emit("X1 ans="); e64(x1); cc_tstat(W);
  ev_teach(W,15,1,16); ev_teach(W,16,1,17); ev_teach(W,17,1,18);
  let x2:i32=ev_query(W,15,61,18,0);
  emit("X2 ans="); e64(x2); cc_tstat(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23); ev_teach(W,23,2,24);
  let y1:i32=ev_query(W,21,62,24,0);
  emit("Y1 ans="); e64(y1); cc_tstat(W);
  ev_teach(W,25,2,26); ev_teach(W,26,2,27); ev_teach(W,27,2,28);
  let y2:i32=ev_query(W,25,62,28,0);
  emit("Y2 ans="); e64(y2); cc_tstat(W);
  emit("maps="); e64(cc_count_maps(W)); emit("\n");
  cc_print_relseq(W,cc_find_map(W,11,61));
  cc_print_relseq(W,cc_find_map(W,15,61));
  cc_print_relseq(W,cc_find_map(W,21,62));
  cc_print_relseq(W,cc_find_map(W,25,62));
  return;
}
fn cc_zfacts(W:[]u8)void {
  ev_teach(W,31,1,32); ev_teach(W,32,1,33); ev_teach(W,33,1,34);
  ev_teach(W,34,2,35); ev_teach(W,35,2,36); ev_teach(W,36,2,37);
  return;
}
fn cc_zquery(W:[]u8)void {
  let z:i32=ev_query(W,31,63,37,0);
  emit("Z ans="); e64(z); cc_tstat(W);
  let zm:i32=cc_find_map(W,31,63);
  emit("ZMAP id="); e64(zm); emit(" link14="); e64(cc_count14(W)); emit("\n");
  if(zm>=0){cc_print_relseq(W,zm);}
  cc_dump14(W);
  return;
}
// Z' reuse: fresh subject, same mixed shape. Does composed Z persist?
fn cc_zreuse(W:[]u8)void {
  ev_teach(W,41,1,42); ev_teach(W,42,1,43); ev_teach(W,43,1,44);
  ev_teach(W,44,2,45); ev_teach(W,45,2,46); ev_teach(W,46,2,47);
  let z2:i32=ev_query(W,41,63,47,0);
  emit("Z2 ans="); e64(z2); cc_tstat(W);
  return;
}
fn cc_treat(W:[]u8)void {
  emit("=== TREAT ===\n");
  cc_trainXY(W);
  cc_gap(W);
  cc_zfacts(W);
  cc_zquery(W);
  cc_zreuse(W);
  return;
}
fn cc_ablx(W:[]u8)void {
  emit("=== ABL-X ===\n");
  cc_trainXY(W);
  cc_del_map_sr(W,11,61); cc_del_map_sr(W,15,61);
  emit("maps after del="); e64(cc_count_maps(W)); emit("\n");
  cc_gap(W);
  cc_zfacts(W);
  cc_zquery(W);
  return;
}
fn cc_ably(W:[]u8)void {
  emit("=== ABL-Y ===\n");
  cc_trainXY(W);
  cc_del_map_sr(W,21,62); cc_del_map_sr(W,25,62);
  emit("maps after del="); e64(cc_count_maps(W)); emit("\n");
  cc_gap(W);
  cc_zfacts(W);
  cc_zquery(W);
  return;
}
fn cc_fresh(W:[]u8)void {
  emit("=== FRESH ===\n");
  cc_gap(W);
  cc_zfacts(W);
  cc_zquery(W);
  return;
}
fn main()i32 {
  emit("COMP-C-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); cc_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); cc_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); cc_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); cc_fresh(W4);
  emit("COMP-C-END\n");
  return 0;
}

// q4_parcond.zag: Q4 learner on adversary-designed F-PARCOND family.
// Pure Zag. No Python.
// F-PARCOND: D = IF X1 THEN (X2 XOR X3) ELSE (X2 AND X3). 6 ops.
// Sealed adversary family (ADV_SPEC.md, b4e9b6a14). Prereg: ad4284269.

// ============ basics ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 { return _zag_i64_to_str(v as i64); }
fn e64(v:i32)void { emit(i32s(v)); return; }
fn get32(b:[]u8, off:i32)i32 {
  let a:i32=b[off] as i32;
  let bb:i32=b[off+1] as i32;
  let c:i32=b[off+2] as i32;
  let d:i32=b[off+3] as i32;
  let r1:i32=a | (bb<<8);
  let r2:i32=r1 | (c<<16);
  let r3:i32=r2 | (d<<24);
  return r3;
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8;
  b[off+1]=(v>>8) as u8;
  b[off+2]=(v>>16) as u8;
  b[off+3]=(v>>24) as u8;
  return;
}
// state offsets: 0 node_count, 4 trace_count, 8 beam_n, 12 ev_n,
// 16 rng_state, 20 lib_n, 24 nterms
fn stg(st:[]u8, off:i32)i32 { return get32(st, off); }
fn sts(st:[]u8, off:i32, v:i32)void { set32(st, off, v); return; }

// ============ PRNG ============
fn rng_next(st:[]u8)i32 {
  let s:i32=stg(st, 16);
  let ns:i32=(s * 1103515245 + 12345) & 2147483647;
  sts(st, 16, ns);
  return ns;
}
fn rng_range(st:[]u8, n:i32)i32 {
  let r:i32=rng_next(st);
  return r % n;
}

// ============ sealed worlds ============
fn sealed(fam:i32, x:i32)i32 {
  let x1:i32=(x>>0)&1;
  let x2:i32=(x>>1)&1;
  let x3:i32=(x>>2)&1;
  let x4:i32=(x>>3)&1;
  let x5:i32=(x>>4)&1;
  if(fam==0){
    let r:i32=x1 & x2;
    return r;
  }
  if(fam==1){
    let r:i32=x1 ^ x2;
    return r;
  }
  if(fam==2){
    let a:i32=x1 & x2;
    let r:i32=a | x5;
    return r;
  }
  if(fam==3){
    let a:i32=x1 & x2;
    let b:i32=x2 & x3;
    let c:i32=x1 & x3;
    let r:i32=(a | b) | c;
    return r;
  }
  if(fam==4){
    let a:i32=x1 & x2;
    let b:i32=x2 & x3;
    let c:i32=x1 & x3;
    let m:i32=(a | b) | c;
    let r:i32=m ^ x4;
    return r;
  }
  if(fam==5){
    // F-PARCOND: D = IF X1 THEN (X2 XOR X3) ELSE (X2 AND X3)
    // D = (x1 & a) | ((x1^1) & b) where a = x2^x3, b = x2&x3
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let r:i32=t1 | t2;
    return r;
  }
  if(fam==6){
    // F-PARCOND-XOR: C' = D XOR X4 (Phase 2 reuse target)
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let d:i32=t1 | t2;
    let r:i32=d ^ x4;
    return r;
  }
  if(fam==7){
    // R3 ARM1: C' = D_10 XOR X4. D_10 = ((D AND 1) XOR 0) AND 1,
    // identity wrappers written out; behaviorally identical to fam 6.
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let d:i32=t1 | t2;
    let w1:i32=d & 1;
    let w2:i32=w1 ^ 0;
    let w3:i32=w2 & 1;
    let r:i32=w3 ^ x4;
    return r;
  }
  if(fam==8){
    // R3 ARM2: E = (D AND Y4) OR ((NOT D) AND Y5).
    // Y1..Y6 = bits 0..5; D on (Y1,Y2,Y3) = bits 0,1,2;
    // Y4 = bit 3, Y5 = bit 4; Y6 = bit 5 is the decoy.
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let t1:i32=x1 & a;
    let t2:i32=nx1 & b;
    let d:i32=t1 | t2;
    let y4:i32=(x>>3)&1;
    let y5:i32=(x>>4)&1;
    let nd:i32=d ^ 1;
    let r:i32=(d & y4) | (nd & y5);
    return r;
  }
  return 0;
}

// ============ nodes (28 bytes) ============
fn ndg(nodes:[]u8, n:i32, off:i32)i32 { return get32(nodes, n*28+off); }
fn nds(nodes:[]u8, n:i32, off:i32, v:i32)void { set32(nodes, n*28+off, v); return; }
fn sig_hash(lo:i32, hi:i32)i32 {
  let h1:i32=hi * 33;
  let h2:i32=lo ^ h1;
  let h:i32=h2 & 16383;
  return h;
}
fn sig_lookup(sigtab:[]u8, nodes:[]u8, lo:i32, hi:i32)i32 {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){ return -1; }
    let n:i32=slot-1;
    let nlo:i32=ndg(nodes, n, 16);
    if(nlo==lo){
      let nhi:i32=ndg(nodes, n, 20);
      if(nhi==hi){ return n; }
    }
    i=i+1;
  }
  return -1;
}
fn sig_insert(sigtab:[]u8, lo:i32, hi:i32, n:i32)void {
  let h:i32=sig_hash(lo, hi);
  let i:i32=0;
  while(i<16384){
    let idx:i32=(h+i) & 16383;
    let slot:i32=get32(sigtab, idx*4);
    if(slot==0){
      set32(sigtab, idx*4, n+1);
      return;
    }
    i=i+1;
  }
  return;
}
fn term_sig(t:i32, out:[]u8)void {
  let lo:i32=0;
  let hi:i32=0;
  if(t<6){
    let x:i32=0;
    while(x<64){
      let bit:i32=(x>>t)&1;
      if(bit==1){
        if(x<32){
          let m:i32=1<<x;
          lo=lo | m;
        } else {
          let m:i32=1<<(x-32);
          hi=hi | m;
        }
      }
      x=x+1;
    }
  } else {
    if(t==7){
      lo=-1;
      hi=-1;
    }
  }
  set32(out, 0, lo);
  set32(out, 4, hi);
  return;
}
fn node_new_term(st:[]u8, nodes:[]u8, sigtab:[]u8, t:i32)i32 {
  let sob:[]u8=z_alloc(8);
  term_sig(t, sob);
  let lo:i32=get32(sob, 0);
  let hi:i32=get32(sob, 4);
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 0);
  nds(nodes, nc, 4, t);
  nds(nodes, nc, 8, -1);
  nds(nodes, nc, 12, -1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, 0);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  return nc;
}
fn node_new_libterm(st:[]u8, nodes:[]u8, sigtab:[]u8, t:i32, lo:i32, hi:i32)i32 {
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 0);
  nds(nodes, nc, 4, t);
  nds(nodes, nc, 8, -1);
  nds(nodes, nc, 12, -1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, 0);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  return nc;
}
fn node_new_op(st:[]u8, nodes:[]u8, sigtab:[]u8, trace:[]u8, op:i32, c0:i32, c1:i32)i32 {
  let lo0:i32=ndg(nodes, c0, 16);
  let hi0:i32=ndg(nodes, c0, 20);
  let lo:i32=0;
  let hi:i32=0;
  let oc:i32=0;
  if(op==0){
    let lo1:i32=ndg(nodes, c1, 16);
    let hi1:i32=ndg(nodes, c1, 20);
    lo=lo0 & lo1;
    hi=hi0 & hi1;
    oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
  } else {
    if(op==1){
      let lo1:i32=ndg(nodes, c1, 16);
      let hi1:i32=ndg(nodes, c1, 20);
      lo=lo0 | lo1;
      hi=hi0 | hi1;
      oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
    } else {
      if(op==2){
        lo=lo0 ^ -1;
        hi=hi0 ^ -1;
        oc=1 + ndg(nodes, c0, 24);
      } else {
        let lo1:i32=ndg(nodes, c1, 16);
        let hi1:i32=ndg(nodes, c1, 20);
        lo=lo0 ^ lo1;
        hi=hi0 ^ hi1;
        oc=1 + ndg(nodes, c0, 24) + ndg(nodes, c1, 24);
      }
    }
  }
  let f:i32=sig_lookup(sigtab, nodes, lo, hi);
  if(f>=0){ return f; }
  let nc:i32=stg(st, 0);
  if(nc>=8192){ return -1; }
  nds(nodes, nc, 0, 1);
  nds(nodes, nc, 4, op);
  nds(nodes, nc, 8, c0);
  nds(nodes, nc, 12, c1);
  nds(nodes, nc, 16, lo);
  nds(nodes, nc, 20, hi);
  nds(nodes, nc, 24, oc);
  sig_insert(sigtab, lo, hi, nc);
  sts(st, 0, nc+1);
  let tc:i32=stg(st, 4);
  if(tc<4096){
    set32(trace, tc*20+0, op);
    set32(trace, tc*20+4, c0);
    set32(trace, tc*20+8, c1);
    set32(trace, tc*20+12, nc);
    set32(trace, tc*20+16, stg(st, 12));
    sts(st, 4, tc+1);
  }
  return nc;
}
fn node_pred(nodes:[]u8, n:i32, x:i32)i32 {
  let slo:i32=ndg(nodes, n, 16);
  if(x<32){
    let p:i32=(slo>>x)&1;
    return p;
  }
  let shi:i32=ndg(nodes, n, 20);
  let p:i32=(shi>>(x-32))&1;
  return p;
}

// ============ beam (16 bytes/slot) ============
fn bmg(beam:[]u8, i:i32, off:i32)i32 { return get32(beam, i*16+off); }
fn bms(beam:[]u8, i:i32, off:i32, v:i32)void { set32(beam, i*16+off, v); return; }
// score a single node on evidence; tax = annealed simplicity tax (per-op)
fn score_node(st:[]u8, nodes:[]u8, n:i32, ev_x:[]u8, ev_y:[]u8, tax:i32, out:[]u8)void {
  let en:i32=stg(st, 12);
  let opc:i32=ndg(nodes, n, 24);
  let c:i32=0;
  let e:i32=0;
  while(e<en){
    let x:i32=get32(ev_x, e*4);
    let y:i32=get32(ev_y, e*4);
    let p:i32=node_pred(nodes, n, x);
    if(p==y){ c=c+1; }
    e=e+1;
  }
  let sc:i32=0;
  if(en>0){
    let a1:i32=(c*10000)/en;
    let a2:i32=tax*opc;
    sc=a1 - a2;
  }
  set32(out, 0, sc);
  set32(out, 4, c);
  set32(out, 8, opc);
  return;
}
fn beam_sort(beam:[]u8, bn:i32)void {
  let i:i32=0;
  while(i<bn){
    let best:i32=i;
    let j:i32=i+1;
    while(j<bn){
      let sj:i32=bmg(beam, j, 4);
      let sb:i32=bmg(beam, best, 4);
      let take:i32=0;
      if(sj>sb){ take=1; }
      else {
        if(sj==sb){
          let oj:i32=bmg(beam, j, 12);
          let ob:i32=bmg(beam, best, 12);
          if(oj<ob){ take=1; }
          else {
            if(oj==ob){
              let nj:i32=bmg(beam, j, 0);
              let nb:i32=bmg(beam, best, 0);
              if(nj<nb){ take=1; }
            }
          }
        }
      }
      if(take==1){ best=j; }
      j=j+1;
    }
    if(best!=i){
      let k:i32=0;
      while(k<4){
        let t:i32=bmg(beam, i, k*4);
        bms(beam, i, k*4, bmg(beam, best, k*4));
        bms(beam, best, k*4, t);
        k=k+1;
      }
    }
    i=i+1;
  }
  return;
}
// ============ beam redesign: niching + tax annealing + diverse IV ============
// Species signature: (tree depth, sorted operator multiset), computed
// generically from the candidate expression tree. No target, family, or
// library knowledge enters the signature. Shared DAG nodes are counted
// per visit (tree unfolding). Deterministic.
fn species_key(nodes:[]u8, n:i32, sstk:[]u8)i32 {
  set32(sstk, 0, n);
  set32(sstk, 4, 0);
  let sp:i32=1;
  let maxd:i32=0;
  let c0:i32=0;
  let c1:i32=0;
  let c2:i32=0;
  let c3:i32=0;
  while(sp>0){
    sp=sp-1;
    let nn:i32=get32(sstk, sp*8);
    let d:i32=get32(sstk, sp*8+4);
    if(d>maxd){ maxd=d; }
    let typ:i32=ndg(nodes, nn, 0);
    if(typ==1){
      let op:i32=ndg(nodes, nn, 4);
      if(op==0){ c0=c0+1; }
      else {
        if(op==1){ c1=c1+1; }
        else {
          if(op==2){ c2=c2+1; }
          else { c3=c3+1; }
        }
      }
      if(sp<254){
        let k0:i32=ndg(nodes, nn, 8);
        let k1:i32=ndg(nodes, nn, 12);
        set32(sstk, sp*8, k0);
        set32(sstk, sp*8+4, d+1);
        sp=sp+1;
        if(k1>=0){
          set32(sstk, sp*8, k1);
          set32(sstk, sp*8+4, d+1);
          sp=sp+1;
        }
      }
    }
  }
  let key:i32=maxd;
  key=key*8 + c0;
  key=key*8 + c1;
  key=key*8 + c2;
  key=key*8 + c3;
  return key;
}
// Candidate comparator: a strictly better than b iff
// (score desc, opc asc, node asc). a, b are indices into tmp/tsc.
fn cand_better(tsc:[]u8, tmp:[]u8, a:i32, b:i32)i32 {
  let sa:i32=get32(tsc, a*12+0);
  let sb:i32=get32(tsc, b*12+0);
  if(sa>sb){ return 1; }
  if(sa<sb){ return 0; }
  let oa:i32=get32(tsc, a*12+8);
  let ob:i32=get32(tsc, b*12+8);
  if(oa<ob){ return 1; }
  if(oa>ob){ return 0; }
  let na:i32=get32(tmp, a*4);
  let nb:i32=get32(tmp, b*4);
  if(na<nb){ return 1; }
  return 0;
}
// Species a strictly smaller than b iff (members asc, best asc, key asc).
fn niche_smaller(spcnt:[]u8, spbest:[]u8, spkey:[]u8, a:i32, b:i32)i32 {
  let ca:i32=get32(spcnt, a*4);
  let cb:i32=get32(spcnt, b*4);
  if(ca<cb){ return 1; }
  if(ca>cb){ return 0; }
  let ba:i32=get32(spbest, a*4);
  let bb:i32=get32(spbest, b*4);
  if(ba<bb){ return 1; }
  if(ba>bb){ return 0; }
  let ka:i32=get32(spkey, a*4);
  let kb:i32=get32(spkey, b*4);
  if(ka<kb){ return 1; }
  return 0;
}
// Species champion of sa strictly better than champion of sb.
fn niche_champ_better(tsc:[]u8, tmp:[]u8, sptop:[]u8, spkey:[]u8, sa:i32, sb:i32)i32 {
  let ka:i32=get32(sptop, (sa*4+0)*4);
  let kb:i32=get32(sptop, (sb*4+0)*4);
  if(cand_better(tsc, tmp, ka, kb)==1){ return 1; }
  if(cand_better(tsc, tmp, kb, ka)==1){ return 0; }
  let xa:i32=get32(spkey, sa*4);
  let xb:i32=get32(spkey, sb*4);
  if(xa<xb){ return 1; }
  return 0;
}
// Niching selection: partition candidates into species, keep top 4 per
// species, at most 8 species (merge smallest), fill from global ranking.
// Beam layout: slots 0..S-1 are species champions (score desc), then
// runners-up, then global fill. Sets sts(st, 8, nb).
fn niche_select(st:[]u8, tmp:[]u8, tsc:[]u8, speck:[]u8, tn:i32, beam:[]u8)void {
  let spkey:[]u8=z_alloc(64*4);
  let spcnt:[]u8=z_alloc(64*4);
  let spbest:[]u8=z_alloc(64*4);
  let sptop:[]u8=z_alloc(64*16);
  let ns:i32=0;
  let k:i32=0;
  while(k<tn){
    let key:i32=get32(speck, k*4);
    let s:i32=0;
    while(s<ns){
      if(get32(spkey, s*4)==key){ break; }
      s=s+1;
    }
    if(s>=ns){
      if(ns<64){
        set32(spkey, ns*4, key);
        set32(spcnt, ns*4, 0);
        set32(spbest, ns*4, -2000000000);
        let q0:i32=0;
        while(q0<4){
          set32(sptop, (ns*4+q0)*4, -1);
          q0=q0+1;
        }
        s=ns;
        ns=ns+1;
      } else {
        s=key & 63;
      }
    }
    let pos:i32=0;
    while(pos<4){
      let ek:i32=get32(sptop, (s*4+pos)*4);
      if(ek<0){ break; }
      if(cand_better(tsc, tmp, k, ek)==1){ break; }
      pos=pos+1;
    }
    if(pos<4){
      let q:i32=3;
      while(q>pos){
        set32(sptop, (s*4+q)*4, get32(sptop, (s*4+q-1)*4));
        q=q-1;
      }
      set32(sptop, (s*4+pos)*4, k);
    }
    set32(spcnt, s*4, get32(spcnt, s*4)+1);
    let sk2:i32=get32(tsc, k*12+0);
    if(sk2>get32(spbest, s*4)){ set32(spbest, s*4, sk2); }
    k=k+1;
  }
  let mrg:[]u8=z_alloc(8*4);
  while(ns>8){
    let s1:i32=0;
    let s2:i32=1;
    if(niche_smaller(spcnt, spbest, spkey, s2, s1)==1){
      let t0:i32=s1;
      s1=s2;
      s2=t0;
    }
    let i:i32=2;
    while(i<ns){
      if(niche_smaller(spcnt, spbest, spkey, i, s1)==1){
        s2=s1;
        s1=i;
      } else {
        if(niche_smaller(spcnt, spbest, spkey, i, s2)==1){
          s2=i;
        }
      }
      i=i+1;
    }
    let a:i32=0;
    let b:i32=0;
    let m:i32=0;
    while(m<8){
      let ka:i32=-1;
      let kb:i32=-1;
      if(a<4){ ka=get32(sptop, (s1*4+a)*4); }
      if(b<4){ kb=get32(sptop, (s2*4+b)*4); }
      if(ka<0){
        if(kb<0){ break; }
        set32(mrg, m*4, kb);
        b=b+1;
      } else {
        if(kb<0){
          set32(mrg, m*4, ka);
          a=a+1;
        } else {
          if(cand_better(tsc, tmp, ka, kb)==1){
            set32(mrg, m*4, ka);
            a=a+1;
          } else {
            set32(mrg, m*4, kb);
            b=b+1;
          }
        }
      }
      m=m+1;
    }
    let q:i32=0;
    while(q<4){
      let v:i32=-1;
      if(q<m){ v=get32(mrg, q*4); }
      set32(sptop, (s1*4+q)*4, v);
      q=q+1;
    }
    set32(spcnt, s1*4, get32(spcnt, s1*4)+get32(spcnt, s2*4));
    if(get32(spbest, s2*4)>get32(spbest, s1*4)){
      set32(spbest, s1*4, get32(spbest, s2*4));
    }
    let j:i32=s2;
    while(j<ns-1){
      set32(spkey, j*4, get32(spkey, (j+1)*4));
      set32(spcnt, j*4, get32(spcnt, (j+1)*4));
      set32(spbest, j*4, get32(spbest, (j+1)*4));
      let q2:i32=0;
      while(q2<4){
        set32(sptop, (j*4+q2)*4, get32(sptop, ((j+1)*4+q2)*4));
        q2=q2+1;
      }
      j=j+1;
    }
    ns=ns-1;
  }
  let order:[]u8=z_alloc(8*4);
  let oi:i32=0;
  while(oi<ns){
    set32(order, oi*4, oi);
    oi=oi+1;
  }
  let i2:i32=0;
  while(i2<ns){
    let best:i32=i2;
    let j2:i32=i2+1;
    while(j2<ns){
      let sa:i32=get32(order, j2*4);
      let sb:i32=get32(order, best*4);
      if(niche_champ_better(tsc, tmp, sptop, spkey, sa, sb)==1){ best=j2; }
      j2=j2+1;
    }
    if(best!=i2){
      let t2:i32=get32(order, i2*4);
      set32(order, i2*4, get32(order, best*4));
      set32(order, best*4, t2);
    }
    i2=i2+1;
  }
  let picked:[]u8=z_alloc(3136);
  let pi:i32=0;
  while(pi<3136){
    picked[pi]=0;
    pi=pi+1;
  }
  let nb:i32=0;
  let o:i32=0;
  while(o<ns){
    let s:i32=get32(order, o*4);
    let ck:i32=get32(sptop, (s*4+0)*4);
    bms(beam, nb, 0, get32(tmp, ck*4));
    bms(beam, nb, 4, get32(tsc, ck*12+0));
    bms(beam, nb, 8, get32(tsc, ck*12+4));
    bms(beam, nb, 12, get32(tsc, ck*12+8));
    picked[ck]=1;
    nb=nb+1;
    o=o+1;
  }
  o=0;
  while(o<ns){
    let s3:i32=get32(order, o*4);
    let q3:i32=1;
    while(q3<4){
      let ck2:i32=get32(sptop, (s3*4+q3)*4);
      if(ck2>=0){
        bms(beam, nb, 0, get32(tmp, ck2*4));
        bms(beam, nb, 4, get32(tsc, ck2*12+0));
        bms(beam, nb, 8, get32(tsc, ck2*12+4));
        bms(beam, nb, 12, get32(tsc, ck2*12+8));
        picked[ck2]=1;
        nb=nb+1;
      }
      q3=q3+1;
    }
    o=o+1;
  }
  while(nb<32){
    let bestk:i32=-1;
    let k2:i32=0;
    while(k2<tn){
      if(picked[k2]==0){
        if(bestk<0){ bestk=k2; }
        else {
          if(cand_better(tsc, tmp, k2, bestk)==1){ bestk=k2; }
        }
      }
      k2=k2+1;
    }
    if(bestk<0){ break; }
    picked[bestk]=1;
    bms(beam, nb, 0, get32(tmp, bestk*4));
    bms(beam, nb, 4, get32(tsc, bestk*12+0));
    bms(beam, nb, 8, get32(tsc, bestk*12+4));
    bms(beam, nb, 12, get32(tsc, bestk*12+8));
    nb=nb+1;
  }
  sts(st, 8, nb);
  return;
}
// Extend beam by one generation. tmp: 3136*4 cand buffer. tsc: 3136*12 score buffer.
// tax: annealed simplicity tax for this extension round.
fn beam_extend(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, tax:i32)void {
  let bn:i32=stg(st, 8);
  let si:i32=0;
  while(si<8192){ seen[si]=0; si=si+1; }
  let tn:i32=0;
  let i:i32=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    if(seen[n]==0){
      seen[n]=1;
      set32(tmp, tn*4, n);
      tn=tn+1;
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let n2:i32=node_new_op(st, nodes, sigtab, trace, 2, n, -1);
    if(n2>=0){
      if(seen[n2]==0){
        seen[n2]=1;
        set32(tmp, tn*4, n2);
        tn=tn+1;
      }
    }
    i=i+1;
  }
  i=0;
  while(i<bn){
    let n:i32=bmg(beam, i, 0);
    let j:i32=0;
    while(j<bn){
      let m:i32=bmg(beam, j, 0);
      let op:i32=0;
      while(op<4){
        if(op!=2){
          let n2:i32=node_new_op(st, nodes, sigtab, trace, op, n, m);
          if(n2>=0){
            if(seen[n2]==0){
              seen[n2]=1;
              set32(tmp, tn*4, n2);
              tn=tn+1;
            }
          }
        }
        op=op+1;
      }
      j=j+1;
    }
    i=i+1;
  }
  // score all tmp candidates
  let sout:[]u8=z_alloc(12);
  let k:i32=0;
  while(k<tn){
    let n:i32=get32(tmp, k*4);
    score_node(st, nodes, n, ev_x, ev_y, tax, sout);
    set32(tsc, k*12+0, get32(sout, 0));
    set32(tsc, k*12+4, get32(sout, 4));
    set32(tsc, k*12+8, get32(sout, 8));
    k=k+1;
  }
  // species keys (shared DFS stack, one allocation per extend)
  let speck:[]u8=z_alloc(tn*4+4);
  let sstk:[]u8=z_alloc(2048);
  k=0;
  while(k<tn){
    let n2:i32=get32(tmp, k*4);
    set32(speck, k*4, species_key(nodes, n2, sstk));
    k=k+1;
  }
  // niching selection: top 4 per species, at most 8 species, global fill
  niche_select(st, tmp, tsc, speck, tn, beam);
  return;
}

// ============ evidence ============
fn passive(st:[]u8, fam:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let i:i32=0;
  while(i<8){
    let x:i32=0;
    let y:i32=0;
    if(i<6){
      let tries:i32=0;
      while(tries<1000){
        x=rng_range(st, 64);
        y=sealed(fam, x);
        let x6:i32=(x>>5)&1;
        if(x6==y){ break; }
        tries=tries+1;
      }
    } else {
      x=rng_range(st, 64);
      y=sealed(fam, x);
    }
    set32(ev_x, i*4, x);
    set32(ev_y, i*4, y);
    used[x]=1;
    i=i+1;
  }
  sts(st, 12, 8);
  return;
}
fn abs_i(v:i32)i32 {
  if(v<0){ return -v; }
  return v;
}
fn select_iv(st:[]u8, nodes:[]u8, beam:[]u8, used:[]u8)i32 {
  let bn:i32=stg(st, 8);
  let topk:i32=8;
  if(bn<8){ topk=bn; }
  let best_x:i32=-1;
  let best_d:i32=-1;
  let x:i32=0;
  while(x<64){
    if(used[x]==0){
      let c1:i32=0;
      let k:i32=0;
      while(k<topk){
        let n:i32=bmg(beam, k, 0);
        let p:i32=node_pred(nodes, n, x);
        if(p==1){ c1=c1+1; }
        k=k+1;
      }
      let av:i32=abs_i(2*c1 - 8);
      let d:i32=8 - av;
      if(d>best_d){
        best_d=d;
        best_x=x;
      }
    }
    x=x+1;
  }
  return best_x;
}
fn do_iv(st:[]u8, fam:i32, x:i32, ev_x:[]u8, ev_y:[]u8, used:[]u8)void {
  let y:i32=sealed(fam, x);
  let en:i32=stg(st, 12);
  set32(ev_x, en*4, x);
  set32(ev_y, en*4, y);
  used[x]=1;
  sts(st, 12, en+1);
  return;
}
fn true_correct(fam:i32, nodes:[]u8, n:i32)i32 {
  let c:i32=0;
  let x:i32=0;
  while(x<64){
    let p:i32=node_pred(nodes, n, x);
    let y:i32=sealed(fam, x);
    if(p==y){ c=c+1; }
    x=x+1;
  }
  return c;
}
// Runtime D signature from the sealed F-PARCOND definition (fam 5).
// out: 0 lo, 4 hi.
fn d_sig(out:[]u8)void {
  let lo:i32=0;
  let hi:i32=0;
  let x:i32=0;
  while(x<64){
    let x1:i32=(x>>0)&1;
    let x2:i32=(x>>1)&1;
    let x3:i32=(x>>2)&1;
    let a:i32=x2 ^ x3;
    let b:i32=x2 & x3;
    let nx1:i32=x1 ^ 1;
    let d:i32=(x1 & a) | (nx1 & b);
    if(d==1){
      if(x<32){
        let m:i32=1<<x;
        lo=lo | m;
      } else {
        let m:i32=1<<(x-32);
        hi=hi | m;
      }
    }
    x=x+1;
  }
  set32(out, 0, lo);
  set32(out, 4, hi);
  return;
}
// Iterative subtree walk: does the tree rooted at n contain the
// installed D terminal (type 0, t == 8) with the verified signature?
fn has_d_subexpr(nodes:[]u8, root:i32, lib_lo:i32, lib_hi:i32)i32 {
  let stack:[]u8=z_alloc(256*4);
  let sp:i32=0;
  set32(stack, 0, root);
  sp=1;
  while(sp>0){
    sp=sp-1;
    let n:i32=get32(stack, sp*4);
    let typ:i32=ndg(nodes, n, 0);
    if(typ==0){
      let t:i32=ndg(nodes, n, 4);
      if(t==8){
        let lo:i32=ndg(nodes, n, 16);
        let hi:i32=ndg(nodes, n, 20);
        if(lo==lib_lo){
          if(hi==lib_hi){ return 1; }
        }
      }
    } else {
      let c0:i32=ndg(nodes, n, 8);
      let c1:i32=ndg(nodes, n, 12);
      if(c0>=0){
        set32(stack, sp*4, c0);
        sp=sp+1;
      }
      if(c1>=0){
        set32(stack, sp*4, c1);
        sp=sp+1;
      }
    }
  }
  return 0;
}
fn bobs_ev_correct(st:[]u8, ev_x:[]u8, ev_y:[]u8)i32 {
  let en:i32=stg(st, 12);
  let best:i32=0;
  let i:i32=0;
  while(i<6){
    let c:i32=0;
    let e:i32=0;
    while(e<en){
      let x:i32=get32(ev_x, e*4);
      let y:i32=get32(ev_y, e*4);
      let p:i32=(x>>i)&1;
      if(p==y){ c=c+1; }
      e=e+1;
    }
    if(c>best){ best=c; }
    i=i+1;
  }
  return best;
}
fn bobs_true_correct(fam:i32)i32 {
  let best:i32=0;
  let i:i32=0;
  while(i<6){
    let c:i32=0;
    let x:i32=0;
    while(x<64){
      let p:i32=(x>>i)&1;
      let y:i32=sealed(fam, x);
      if(p==y){ c=c+1; }
      x=x+1;
    }
    if(c>best){ best=c; }
    i=i+1;
  }
  return best;
}

// ============ reset helpers ============
fn clear_sigtab(sigtab:[]u8)void {
  let i:i32=0;
  while(i<16384){ set32(sigtab, i*4, 0); i=i+1; }
  return;
}
fn clear_used(used:[]u8)void {
  let i:i32=0;
  while(i<64){ used[i]=0; i=i+1; }
  return;
}

// ============ Phase 1 ============
// Returns kept node idx, or -1. Reports via emit.
fn phase1(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, fam:i32, nterms:i32, tag:[]u8)i32 {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  // init beam with terminals
  let t:i32=0;
  while(t<nterms){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  sts(st, 8, nterms);
  // passive
  passive(st, fam, ev_x, ev_y, used);
  // 24 rounds: extend, score, sort, select intervention
  let r:i32=0;
  while(r<24){
    beam_extend(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, (200*r)/25);
    let x:i32=select_iv(st, nodes, beam, used);
    if(x>=0){
      do_iv(st, fam, x, ev_x, ev_y, used);
    }
    r=r+1;
  }
  // final extend+score+sort on full evidence
  beam_extend(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, (200*24)/25);
  let bn:i32=stg(st, 8);
  let en:i32=stg(st, 12);
  // BEST = beam[0]
  let best_n:i32=bmg(beam, 0, 0);
  let best_c:i32=bmg(beam, 0, 8);
  let best_o:i32=bmg(beam, 0, 12);
  let obs_c:i32=bobs_ev_correct(st, ev_x, ev_y);
  // keep checks
  let keep:i32=1;
  // acc >= obs + 0.15  <=>  best_c*100 >= obs_c*100 + 15*en
  let lhs:i32=best_c*100;
  let rhs:i32=obs_c*100 + 15*en;
  if(lhs<rhs){ keep=0; }
  if(best_o>7){ keep=0; }
  // minimality: no other within 0.02 acc with fewer ops
  let j:i32=1;
  while(j<bn){
    let cj:i32=bmg(beam, j, 8);
    let oj:i32=bmg(beam, j, 12);
    // cj*100 >= best_c*100 - 2*en  AND  oj < best_o  => fail
    let jl:i32=cj*100;
    let jr:i32=best_c*100 - 2*en;
    if(jl>=jr){
      if(oj<best_o){ keep=0; }
    }
    j=j+1;
  }
  // report
  emit(tag); emit(" BEST node="); e64(best_n);
  emit(" ev_correct="); e64(best_c); emit("/"); e64(en);
  emit(" obs_correct="); e64(obs_c);
  emit(" opc="); e64(best_o);
  emit(" keep="); e64(keep); emit("\n");
  emit(tag); emit(" TRUE correct="); e64(true_correct(fam, nodes, best_n)); emit("/64");
  emit(" bobs_true="); e64(bobs_true_correct(fam)); emit("/64\n");
  emit(tag); emit(" trace_events="); e64(stg(st, 4)); emit(" nodes="); e64(stg(st, 0)); emit("\n");
  if(keep==1){ return best_n; }
  return -1;
}

// ============ Phase 2 ============
// lib_lo, lib_hi: sig of kept D1. use_lib: 1 = reuse, 0 = scratch.
// Returns interventions to reach true acc >= 61/64, or 24.
fn phase2(st:[]u8, nodes:[]u8, sigtab:[]u8, beam:[]u8, trace:[]u8, seen:[]u8, tmp:[]u8, tsc:[]u8, ev_x:[]u8, ev_y:[]u8, used:[]u8, fam:i32, use_lib:i32, lib_lo:i32, lib_hi:i32, tag:[]u8)i32 {
  sts(st, 0, 0);
  sts(st, 4, 0);
  sts(st, 8, 0);
  sts(st, 12, 0);
  clear_sigtab(sigtab);
  clear_used(used);
  let nterms:i32=8;
  let t:i32=0;
  while(t<8){
    let n:i32=node_new_term(st, nodes, sigtab, t);
    bms(beam, t, 0, n);
    bms(beam, t, 4, 0);
    bms(beam, t, 8, 0);
    bms(beam, t, 12, 0);
    t=t+1;
  }
  if(use_lib==1){
    let ln:i32=node_new_libterm(st, nodes, sigtab, 8, lib_lo, lib_hi);
    bms(beam, 8, 0, ln);
    bms(beam, 8, 4, 0);
    bms(beam, 8, 8, 0);
    bms(beam, 8, 12, 0);
    nterms=9;
  }
  sts(st, 8, nterms);
  sts(st, 24, nterms);
  passive(st, fam, ev_x, ev_y, used);
  let hit_iv:i32=24;
  let hit:i32=0;
  // check after passive (0 interventions)
  beam_extend(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, 0);
  let b0:i32=bmg(beam, 0, 0);
  let tc0:i32=true_correct(fam, nodes, b0);
  if(tc0>=61){ hit=1; hit_iv=0; }
  let r:i32=0;
  while(r<24){
    if(hit==1){ break; }
    let x:i32=select_iv(st, nodes, beam, used);
    if(x>=0){
      do_iv(st, fam, x, ev_x, ev_y, used);
    }
    beam_extend(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, (200*(r+1))/25);
    let bn2:i32=bmg(beam, 0, 0);
    let tc:i32=true_correct(fam, nodes, bn2);
    if(tc>=61){
      hit=1;
      hit_iv=r+1;
    }
    r=r+1;
  }
  emit(tag); emit(" hit_iv="); e64(hit_iv);
  emit(" final_true="); e64(true_correct(fam, nodes, bmg(beam, 0, 0))); emit("/64\n");
  sts(st, 28, bmg(beam, 0, 0));
  return hit_iv;
}

// ============ main: Q4 R3, Arms 1-2 ============
fn main()void {
  emit("Q4-R3\n");
  let st:[]u8=z_alloc(32);
  let nodes:[]u8=z_alloc(8192*28);
  let sigtab:[]u8=z_alloc(16384*4);
  let beam:[]u8=z_alloc(32*16);
  let trace:[]u8=z_alloc(4096*20);
  let seen:[]u8=z_alloc(8192);
  let tmp:[]u8=z_alloc(3136*4);
  let tsc:[]u8=z_alloc(3136*12);
  let ev_x:[]u8=z_alloc(32*4);
  let ev_y:[]u8=z_alloc(32*4);
  let used:[]u8=z_alloc(64);
  // Frozen kept-D artifact: signature recomputed from the sealed
  // F-PARCOND definition, asserted against the prereg constants
  // lo = hi = 0x68686868 = 1751672936 (commit 5f56cc491, node 1105).
  let sigb:[]u8=z_alloc(8);
  d_sig(sigb);
  let dlo:i32=get32(sigb, 0);
  let dhi:i32=get32(sigb, 4);
  let dseal:i32=0;
  if(dlo==1751672936){
    if(dhi==1751672936){ dseal=1; }
  }
  emit("DSEAL "); e64(dseal);
  emit(" dlo="); e64(dlo); emit(" dhi="); e64(dhi); emit("\n");
  // D_10 padding check: identity wrappers (D AND 1), (w1 XOR 0),
  // (w2 AND 1) must preserve the signature behaviorally.
  let w1lo:i32=dlo & -1;
  let w1hi:i32=dhi & -1;
  let w2lo:i32=w1lo ^ 0;
  let w2hi:i32=w1hi ^ 0;
  let w3lo:i32=w2lo & -1;
  let w3hi:i32=w2hi & -1;
  let d10ok:i32=0;
  if(w3lo==dlo){
    if(w3hi==dhi){ d10ok=1; }
  }
  emit("D10_OK "); e64(d10ok); emit("\n");
  if(dseal==0){
    emit("VOID: DSEAL mismatch, harness defect\n");
    emit("DONE\n");
    return;
  }
  // ---- Arm 1: C' = D_10 XOR X4 (fam 7), seed 710101 ----
  sts(st, 16, 710101);
  let a1r:i32=phase2(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 7, 1, dlo, dhi, "A1-REUSE");
  let a1r_best:i32=stg(st, 28);
  let a1r_true:i32=true_correct(7, nodes, a1r_best);
  sts(st, 16, 710101);
  let a1s:i32=phase2(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 7, 0, 0, 0, "A1-SCRATCH");
  let a1s_best:i32=stg(st, 28);
  let a1s_true:i32=true_correct(7, nodes, a1s_best);
  emit("A1 REUSE_IV "); e64(a1r); emit(" true="); e64(a1r_true); emit("/64\n");
  emit("A1 SCRATCH_IV "); e64(a1s); emit(" true="); e64(a1s_true); emit("/64\n");
  let a1pass:i32=0;
  if(a1r_true==64){
    if(a1r*2<=a1s){ a1pass=1; }
  }
  emit("A1-PASS "); e64(a1pass); emit("\n");
  // ---- Arm 2: E = (D AND Y4) OR ((NOT D) AND Y5) (fam 8), seed 710202 ----
  sts(st, 16, 710202);
  let a2r:i32=phase2(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 8, 1, dlo, dhi, "A2-REUSE");
  let a2r_best:i32=stg(st, 28);
  let a2r_true:i32=true_correct(8, nodes, a2r_best);
  let hasd:i32=has_d_subexpr(nodes, a2r_best, dlo, dhi);
  sts(st, 16, 710202);
  let a2s:i32=phase2(st, nodes, sigtab, beam, trace, seen, tmp, tsc, ev_x, ev_y, used, 8, 0, 0, 0, "A2-SCRATCH");
  let a2s_best:i32=stg(st, 28);
  let a2s_true:i32=true_correct(8, nodes, a2s_best);
  emit("A2 REUSE_IV "); e64(a2r); emit(" true="); e64(a2r_true); emit("/64 HAS_D="); e64(hasd); emit("\n");
  emit("A2 SCRATCH_IV "); e64(a2s); emit(" true="); e64(a2s_true); emit("/64\n");
  let a2pass:i32=0;
  if(a2r_true==64){
    if(a2r*2<=a2s){
      if(hasd==1){ a2pass=1; }
    }
  }
  if(hasd==0){
    emit("F-R3-THIN FIRED: reuse solution lacks D as subexpression\n");
  }
  emit("A2-PASS "); e64(a2pass); emit("\n");
  let r3pass:i32=0;
  if(a1pass==1){
    if(a2pass==1){ r3pass=1; }
  }
  emit("R3-PASS "); e64(r3pass); emit("\n");
  emit("DONE\n");
  return;
}

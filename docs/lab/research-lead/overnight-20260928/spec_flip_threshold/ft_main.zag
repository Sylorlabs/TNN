// ft_main.zag -- harness main for SPEC-FLIP-THRESHOLD.
// Sweeps 4 inherited regime cells x 21 arms = 84 episodes, each
// emitting one CELL line.
// Cell index ci -> (R, M1, N1, M2, N2), values inherited unchanged
// from SPEC-FLIP-LATENCY (D32 = 0 established in SPEC-COLD-START;
// no new probe):
//   ci=0 CS0: R=21  (16,16)->(16,16)  sparse stationary control
//   ci=1 CS1: R=60  (16,16)->(1,16)   sparse -> drift-dense
//                                     THE HARM CELL
//   ci=2 CS2: R=82  (16,16)->(16,1)   sparse -> query-dense
//   ci=3 CS3: R=120 (16,16)->(1,16)   same regime as CS1, D32 >= 1
// Arms per cell:
//   pol 0 fixed lazy, pol 1 fixed eager (parent dynamics unchanged)
//   pol 2 adapt,        L in {1,3,7,10}   (L-scaled control)
//   pol 4 guard,        L in {3,7,10}     (quirk-exoneration control)
//   pol 7 fix2,         L in {1,3,7,10}   (fixed 2*qhi bar)
//   pol 8 qmean,        L in {1,3,7,10}   ((L+1)*qh bar)
//   pol 9 adaptd,       L in {1,3,7,10}   (adaptive relaxing bar)
// Arrivals are bursty and irregular (seeded per cell, identical
// across arms, regime shift at tick 128); relation/object ids arrive
// via the rb_* accessors; no world literals appear here.
fn ft_R(ci:i32)i32 {
  if(ci==0){ return 21; }
  if(ci==1){ return 60; }
  if(ci==2){ return 82; }
  return 120;
}
fn ft_m1(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 16; }
  return 16;
}
fn ft_n1(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 16; }
  return 16;
}
fn ft_m2(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 1; }
  if(ci==2){ return 16; }
  return 1;
}
fn ft_n2(ci:i32)i32 {
  if(ci==0){ return 16; }
  if(ci==1){ return 16; }
  if(ci==2){ return 1; }
  return 16;
}
// adapt / fix2 / qmean / adaptd L sweep: the threshold-redesign
// comparison set (L = 1: fix2 identity check; L = 3: divergence;
// L = 7: too-late boundary; L = 10: never-flip boundary).
fn ft_La(i:i32)i32 {
  if(i==0){ return 1; }
  if(i==1){ return 3; }
  if(i==2){ return 7; }
  return 10;
}
// guard L set (quirk-exoneration control, as the parent's).
fn ft_Lg(i:i32)i32 {
  if(i==0){ return 3; }
  if(i==1){ return 7; }
  return 10;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let ra:i32=rb_rel_a();
  let oa1:i32=rb_obj_a1();
  let ci:i32=0;
  while(ci<4){
    let R:i32=ft_R(ci);
    let M1:i32=ft_m1(ci);
    let N1:i32=ft_n1(ci);
    let M2:i32=ft_m2(ci);
    let N2:i32=ft_n2(ci);
    c=ft_episode(B,c,R,M1,N1,M2,N2,0,-1,ra,oa1);
    c=ft_episode(B,c,R,M1,N1,M2,N2,1,-1,ra,oa1);
    let li:i32=0;
    while(li<4){
      c=ft_episode(B,c,R,M1,N1,M2,N2,2,ft_La(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<3){
      c=ft_episode(B,c,R,M1,N1,M2,N2,4,ft_Lg(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<4){
      c=ft_episode(B,c,R,M1,N1,M2,N2,7,ft_La(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<4){
      c=ft_episode(B,c,R,M1,N1,M2,N2,8,ft_La(li),ra,oa1);
      li=li+1;
    }
    li=0;
    while(li<4){
      c=ft_episode(B,c,R,M1,N1,M2,N2,9,ft_La(li),ra,oa1);
      li=li+1;
    }
    ci=ci+1;
  }
  o_flush(B,c);
  return 0;
}

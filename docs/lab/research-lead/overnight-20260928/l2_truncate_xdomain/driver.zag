// driver.zag -- experiment side: teaching, four arms, in-Zag
// kill-bar evaluation. The driver never selects a source MAP for
// a query and never names a truncation length: Q2 is issued as
// (50,73,75,AGG,B) with no MAP id and no length; the second to
// last tx_query argument is only the TRUNC_ON causal-control
// flag (1 = truncate operator enabled, 0 = full-only attempt).

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  // mD id0: dom A(1), cap ROUTE(2), rels [6], facts [1], 30->41
  rs[0]=6; fs[0]=1;
  m_teach(st,rs,1,fs,1,30,41,1,2);
  // mA id1: dom A(1), cap AGG(1), entry + 4 fold pairs,
  // facts [9,0,1,2,3,4,5,6,7], 100->44
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6; rs[5]=5;
  rs[6]=6; rs[7]=5; rs[8]=6;
  fs[0]=9; fs[1]=0; fs[2]=1; fs[3]=2; fs[4]=3; fs[5]=4;
  fs[6]=5; fs[7]=6; fs[8]=7;
  m_teach(st,rs,9,fs,9,100,44,1,1);
  // mB0 id2: dom B(2), cap ROUTE(2), rels [7,7], facts [18,19],
  // 50->52
  rs[0]=7; rs[1]=7; fs[0]=18; fs[1]=19;
  m_teach(st,rs,2,fs,2,50,52,2,2);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// X (mA) and the native B MAP (mB0) learned independently:
// disjoint relation sets.
fn d_disjoint(st:[]u8)i32 {
  let o1:i32=320+1*40;
  let rl1:i32=st[o1+4] as i32;
  let k:i32=0;
  let ok:i32=1;
  while(k<rl1){
    let r:i32=st[o1+8+k] as i32;
    let hit:i32=0;
    if(r==18){hit=1;}
    if(r==5){hit=1;}
    if(r==6){hit=1;}
    if(hit==0){ok=0;}
    k=k+1;
  }
  let o2:i32=320+2*40;
  let rl2:i32=st[o2+4] as i32;
  k=0;
  while(k<rl2){
    if((st[o2+8+k] as i32)!=7){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z (id 3) must equal the frozen section 4 values exactly.
fn d_check_z(st:[]u8)i32 {
  let o:i32=320+3*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=7){ok=0;}
  if((st[o+2] as i32)!=50){ok=0;}
  if((st[o+3] as i32)!=73){ok=0;}
  if((st[o+32] as i32)!=2){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=17){ok=0;}
  if((st[o+35] as i32)!=15){ok=0;}
  if((st[o+36] as i32)!=16){ok=0;}
  if((st[o+37] as i32)!=3){ok=0;}
  if((st[o+38] as i32)!=2){ok=0;}
  let er:[]u8=z_alloc(8);
  er[0]=17; er[1]=15; er[2]=16; er[3]=15; er[4]=16; er[5]=15; er[6]=16;
  let ef:[]u8=z_alloc(8);
  ef[0]=10; ef[1]=11; ef[2]=12; ef[3]=13; ef[4]=14; ef[5]=15; ef[6]=16;
  let k:i32=0;
  while(k<7){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  tx_p(ob,atp,nm);
  tx_p(ob,atp,"=");
  tx_pi(ob,atp,v);
  tx_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  tx_p(ob,atp,"ARM FULL\n");
  tx_p(ob,atp,"Q QA\n");
  tx_query(stF,ob,atp,100,44,12,1,1,1);
  let qa_via:i32=stF[9] as i32;
  tx_p(ob,atp,"Q QB\n");
  tx_query(stF,ob,atp,50,52,-1,2,2,1);
  let qb_via:i32=stF[9] as i32;
  tx_p(ob,atp,"Q Q2\n");
  tx_query(stF,ob,atp,50,73,75,1,2,1);
  let q2_via:i32=stF[9] as i32;
  let q2_val:i32=get32(stF,1264);
  let q2_as:i32=get32(stF,1256);
  let q2_ae:i32=get32(stF,1260);
  let srcF:i32=get32(stF,1268);
  let fok:i32=get32(stF,1280);
  let tk:i32=get32(stF,1276);
  let tdec:i32=get32(stF,1284);
  tx_p(ob,atp,"Q Q2B\n");
  tx_query(stF,ob,atp,50,73,75,1,2,1);
  let q2b_via:i32=stF[9] as i32;
  let q2b_val:i32=get32(stF,1264);
  let q2b_adapt:i32=stF[12] as i32;
  let t16F:i32=e_count(stF,16);
  let othF:i32=tx_eoth(stF);
  let e14F:i32=e_has_to(stF,3,14);
  let e31F:i32=e_has(stF,3,1,16);
  let nmF:i32=stF[1] as i32;
  let zlive:i32=stF[320+3*40+1] as i32;
  let mdlive:i32=stF[320+0*40+1] as i32;
  let disj:i32=d_disjoint(stF);
  let zchk:i32=d_check_z(stF);
  tx_p(ob,atp,"ARM-FULL-END as=");
  tx_pi(ob,atp,q2_as);
  tx_p(ob,atp," ae=");
  tx_pi(ob,atp,q2_ae);
  tx_p(ob,atp," t16=");
  tx_pi(ob,atp,t16F);
  tx_p(ob,atp," oth=");
  tx_pi(ob,atp,othF);
  tx_pnl(ob,atp);

  // ---------- ARM NOTRUNC ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  tx_p(ob,atp,"ARM NOTRUNC\n");
  tx_p(ob,atp,"Q QA\n");
  tx_query(stN,ob,atp,100,44,12,1,1,0);
  tx_p(ob,atp,"Q QB\n");
  tx_query(stN,ob,atp,50,52,-1,2,2,0);
  tx_p(ob,atp,"Q Q2\n");
  tx_query(stN,ob,atp,50,73,75,1,2,0);
  let na_via:i32=stN[9] as i32;
  let na_val:i32=get32(stN,1264);
  let na_t16:i32=e_count(stN,16);
  let na_nm:i32=stN[1] as i32;
  let na_as:i32=get32(stN,1256);
  let othN:i32=tx_eoth(stN);
  tx_p(ob,atp,"ARM-NOTRUNC-END as=");
  tx_pi(ob,atp,na_as);
  tx_p(ob,atp," t16=");
  tx_pi(ob,atp,na_t16);
  tx_p(ob,atp," oth=");
  tx_pi(ob,atp,othN);
  tx_pnl(ob,atp);

  // ---------- ARM ABLATE-X ----------
  let stX:[]u8=z_alloc(8192);
  d_teach_all(stX);
  tx_p(ob,atp,"ARM ABLATE-X\n");
  tx_p(ob,atp,"Q QA\n");
  tx_query(stX,ob,atp,100,44,12,1,1,1);
  tx_p(ob,atp,"Q QB\n");
  tx_query(stX,ob,atp,50,52,-1,2,2,1);
  map_retire(stX,1,3);
  tx_p(ob,atp,"Q Q2\n");
  tx_query(stX,ob,atp,50,73,75,1,2,1);
  let ax_via:i32=stX[9] as i32;
  let ax_val:i32=get32(stX,1264);
  let ax_t16:i32=e_count(stX,16);
  let ax_nm:i32=stX[1] as i32;
  let ax_as:i32=get32(stX,1256);
  let othX:i32=tx_eoth(stX);
  tx_p(ob,atp,"ARM-ABLATEX-END as=");
  tx_pi(ob,atp,ax_as);
  tx_p(ob,atp," t16=");
  tx_pi(ob,atp,ax_t16);
  tx_p(ob,atp," oth=");
  tx_pi(ob,atp,othX);
  tx_pnl(ob,atp);

  // ---------- ARM FRESH ----------
  let stR:[]u8=z_alloc(8192);
  w_teach_all(stR);
  tx_p(ob,atp,"ARM FRESH\n");
  tx_p(ob,atp,"Q Q2\n");
  tx_query(stR,ob,atp,50,73,75,1,2,1);
  let fr_via:i32=stR[9] as i32;
  let fr_val:i32=get32(stR,1264);
  let fr_t16:i32=e_count(stR,16);
  let fr_nm:i32=stR[1] as i32;
  let fr_as:i32=get32(stR,1256);
  let othR:i32=tx_eoth(stR);
  tx_p(ob,atp,"ARM-FRESH-END as=");
  tx_pi(ob,atp,fr_as);
  tx_p(ob,atp," t16=");
  tx_pi(ob,atp,fr_t16);
  tx_p(ob,atp," oth=");
  tx_pi(ob,atp,othR);
  tx_pnl(ob,atp);

  // ---------- in-Zag kill bars ----------
  let k1:i32=0;
  if(qa_via==1){
    if(qb_via==2){
      if(q2_via==3){
        if(disj==1){k1=1;}
      }
    }
  }
  let k2:i32=0;
  if(fok==0){
    if(na_val==-2){
      if(na_t16==0){k2=1;}
    }
  }
  let k3:i32=0;
  if(tk==3){
    if(tdec==1){k3=1;}
  }
  let k4:i32=0;
  if(q2_via==3){
    if(q2_val==75){
      if(fok==0){k4=1;}
    }
  }
  let k7:i32=0;
  if(ax_val==-2){
    if(ax_t16==0){
      if(ax_nm==3){k7=1;}
    }
  }
  let k8:i32=0;
  if(q2b_via==3){
    if(q2b_val==75){
      if(q2b_adapt==0){
        if(zlive==1){k8=1;}
      }
    }
  }
  // falsifiers
  let ff:i32=0;
  if(othF!=0){tx_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n");ff=1;}
  if(othN!=0){tx_p(ob,atp,"FALSIFIER F-EDGE-NEW NOTRUNC\n");ff=1;}
  if(othX!=0){tx_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEX\n");ff=1;}
  if(othR!=0){tx_p(ob,atp,"FALSIFIER F-EDGE-NEW FRESH\n");ff=1;}
  if(q2_as!=285){tx_p(ob,atp,"FALSIFIER F-COUNT AS=");tx_pi(ob,atp,q2_as);tx_pnl(ob,atp);ff=1;}
  if(q2_ae!=2){tx_p(ob,atp,"FALSIFIER F-COUNT AE=");tx_pi(ob,atp,q2_ae);tx_pnl(ob,atp);ff=1;}
  if(q2_via!=3){tx_p(ob,atp,"FALSIFIER F-NO-GROUND\n");ff=1;}
  if(zchk!=1){tx_p(ob,atp,"FALSIFIER F-WRONG-Z\n");ff=1;}
  if(fok!=0){tx_p(ob,atp,"FALSIFIER F-FULL-OK\n");ff=1;}
  if(na_val!=-2){tx_p(ob,atp,"FALSIFIER F-NOTRUNC-PASS\n");ff=1;}
  if(ax_val!=-2){tx_p(ob,atp,"FALSIFIER F-ABLX-PASS\n");ff=1;}
  if(ax_t16!=0){tx_p(ob,atp,"FALSIFIER F-ABLX-T16\n");ff=1;}
  if(fr_val!=-2){tx_p(ob,atp,"FALSIFIER F-FRESH-PASS\n");ff=1;}
  if(q2b_adapt!=0){tx_p(ob,atp,"FALSIFIER F-Q2B-RE\n");ff=1;}
  if(q2b_via!=3){tx_p(ob,atp,"FALSIFIER F-Q2B-VIA\n");ff=1;}
  if(t16F!=1){tx_p(ob,atp,"FALSIFIER F-T16-COUNT\n");ff=1;}
  if(e31F!=1){tx_p(ob,atp,"FALSIFIER F-NO-T16-SRC\n");ff=1;}
  if(e14F!=1){tx_p(ob,atp,"FALSIFIER F-NO-LINK14\n");ff=1;}
  if(srcF!=1){tx_p(ob,atp,"FALSIFIER F-SRC\n");ff=1;}
  if(mdlive!=1){tx_p(ob,atp,"FALSIFIER F-DISTR-SURVIVES\n");ff=1;}
  tx_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k7",k7);
  d_bar(ob,atp,"k8",k8);
  tx_pnl(ob,atp);
  tx_p(ob,atp,"FALSIFIERS ");
  tx_pi(ob,atp,ff);
  tx_pnl(ob,atp);
  tx_p(ob,atp,"L2-TRUNCATE-XDOMAIN-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

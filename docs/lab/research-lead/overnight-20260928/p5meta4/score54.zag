// P5-META SCORER (Zag port of p5meta3/score53.py and p5meta4/score54.py)
//
// One scorer serves both phases: they share the FP fingerprint row format and the
// same five bars, differing only in which phase label is echoed.
//
// Recomputes every verdict from raw `acq` fields. Shares no code with m5.zag.
//
// THE DECISIVE BAR is M4. Ablating the learned machinery while KEEPING the retained
// facts must COST something. If the ablation cost is zero the "learning-to-learn"
// effect is a retained-fact cache, and per the prereg that is explicitly NOT
// meta-learning. M4 is therefore evaluated on `lost > 0`, not on a direction
// comparison alone -- a direction comparison alone would pass a pure cache.
//
// usage: score53.zag <run.txt>

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn pad(b:[]u8,c:i32,s:[]u8,to:i32)i32 {
  let e:i32=c+s.len;
  while(e<to){ b[e]=32; e=e+1; }
  return c+s.len;
}

fn NREG()i32 { return 4; }
fn NARM()i32 { return 8; }
fn NBUD()i32 { return 3; }
fn MAXR()i32 { return 400; }

fn tokval(ch:i32)i32 {
  if(ch>='0' && ch<='9'){ return ch-'0'; }
  if(ch>='A' && ch<='Z'){ return 100+(ch-'A'); }
  if(ch>='a' && ch<='z'){ return 200+(ch-'a'); }
  return -1;
}

// does the line begin with `word` followed by a space?
fn keq(line:[]u8,word:[]u8,pad:i32)i32 {
  let wl:i32=word.len;
  if(wl+1>line.len){ return 0; }
  let i:i32=0;
  while(i<wl){ if(line[i]!=word[i]){ return 0; } i=i+1; }
  if(line[wl]!=' '){ return 0; }
  return 1;
}

// rolling hash of the nth whitespace-separated token of a line (0-based)
fn argtok(line:[]u8,which:i32)i32 {
  let p:i32=0;
  let w:i32=0;
  while(p<line.len && w<=which){
    while(p<line.len && line[p]==' '){ p=p+1; }
    if(p>=line.len){ break; }
    let st:i32=p;
    while(p<line.len && line[p]!=' '){ p=p+1; }
    if(w==which){
      let h:i32=7;
      let q:i32=st;
      while(q<p){ h=(h*31+line[q])&0x3fffffff; q=q+1; }
      return h;
    }
    w=w+1;
  }
  return -1;
}

// rolling hash of the VALUE text after "key=" -- identity by name, not by number
fn nametok(line:[]u8,key:[]u8)i32 {
  let kl:i32=key.len;
  let i:i32=0;
  while(i+kl<line.len){
    let hit:i32=1;
    let j:i32=0;
    while(j<kl){ if(line[i+j]!=key[j]){ hit=0; } j=j+1; }
    if(hit==1 && line[i+kl]=='='){
      let p:i32=i+kl+1;
      let h:i32=7;
      while(p<line.len){
        let c2:i32=line[p];
        if(c2==' '){ break; }
        h=(h*31+c2)&0x3fffffff;
        p=p+1;
      }
      return h;
    }
    i=i+1;
  }
  return -1;
}

fn numtok(line:[]u8,key:[]u8)i32 {
  let kl:i32=key.len;
  let i:i32=0;
  while(i+kl<line.len){
    let hit:i32=1;
    let j:i32=0;
    while(j<kl){ if(line[i+j]!=key[j]){ hit=0; } j=j+1; }
    if(hit==1 && line[i+kl]=='='){
      // multi-digit numbers parse numerically; single tokens use tokval
      let p:i32=i+kl+1;
      let v:i32=0;
      let nd:i32=0;
      let neg:i32=0;
      if(p<line.len && line[p]=='-'){ neg=1; p=p+1; }
      while(p<line.len){
        let c2:i32=line[p];
        if(c2>='0' && c2<='9'){ v=v*10+(c2-'0'); nd=nd+1; p=p+1; }
        else { break; }
      }
      if(nd>1){ if(neg==1){ v=0-v; } return v; }
      if(nd==1){ if(neg==1){ v=0-v; } return v; }
      if(nd==0 && p<line.len){
        let tv:i32=tokval(line[p]);
        if(tv>=0){ return tv; }
      }
      return -1;
    }
    i=i+1;
  }
  return -1;
}

// ---------- FP row store ----------
// ROWS[f*MAXR + r] = field f of row r. Field order: exp reg seed arm st cfg sp pr.
// We store only the five numeric identity fields plus the four hashes as text.

fn RG_EXP()i32 { return 0; }
fn RG_REG()i32 { return 1; }
fn RG_SEED()i32 { return 2; }
fn RG_ARM()i32 { return 3; }
fn RG_ST()i32 { return 4; }
fn RG_CFG()i32 { return 5; }
fn RG_SP()i32 { return 6; }
fn RG_PR()i32 { return 7; }
fn RG_N()i32 { return 8; }



// ---------- spec store ----------
fn SP_KIND()i32 { return 0; }   // 1 EXPECT 2 DIFF 3 SAME 4 PERM
fn SP_A()i32 { return 1; }
fn SP_B()i32 { return 2; }
fn SP_N()i32 { return 3; }
// EXPECT arm list: EXP_A[slot] = arm-name hash, EXP_N = count
fn EXP_N()i32 { return 64; }


fn NREG5()i32 { return 4; }
fn NARM5()i32 { return 6; }
fn MAXR5()i32 { return 400; }

fn A_RG()i32 { return 0; }
fn A_ARM()i32 { return 1; }
fn A_ACQ()i32 { return 2; }
fn A_PK()i32 { return 3; }
fn A_N()i32 { return 4; }

fn acq(RW:[]u8,nrow:i32,rg:i32,arm:i32)i32 {
  let i:i32=0;
  while(i<nrow){
    if(get32(RW,i*A_N()*4+A_RG()*4)==rg){
      if(get32(RW,i*A_N()*4+A_ARM()*4)==arm){ return get32(RW,i*A_N()*4+A_ACQ()*4); }
    }
    i=i+1;
  }
  return -99;
}

fn main()i32 {
  let ob:[]u8=z_alloc(1<<19);
  let c:i32=0;
  if(_zag_argc()<2){
    c=o_app(ob,c,"usage: score53 <run.txt>"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }
  let rp:[]u8=_zag_arg(1);
  let raw:[]u8="";
  if(_zag_file_exists(rp)==1){ raw=_zag_read_file(rp); }
  let rn:i32=raw.len;
  if(rn<1){
    c=o_app(ob,c,"RESULT=FAIL cannot read input"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }

  let RW:[]u8=z_alloc(MAXR5()*A_N()*4);
  let nrow:i32=0;
  let li:i32=0;
  while(li<rn){
    let nl:i32=li;
    while(nl<rn){ if(raw[nl]==10){ break; } nl=nl+1; }
    let line:[]u8=raw[li..nl];
    li=nl+1;
    if(line.len>=3){
      if(line[0]=='F' && line[1]=='P' && line[2]==' '){
        let rg:i32=numtok(line,"regime");
        let ar:i32=numtok(line,"arm");
        let aq:i32=numtok(line,"acq");
        if(rg>=0 && ar>=0 && aq>=-2){
          if(nrow<MAXR5()){
            set32(RW,nrow*A_N()*4+A_RG()*4,rg);
            set32(RW,nrow*A_N()*4+A_ARM()*4,ar);
            set32(RW,nrow*A_N()*4+A_ACQ()*4,aq);
            set32(RW,nrow*A_N()*4+A_PK()*4,numtok(line,"pk"));
            nrow=nrow+1;
          }
        }
      }
    }
    if(li>rn){ break; }
  }

  c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,"INDEPENDENT SCORER -- P5-meta learning-to-learn (Zag port)"); c=o_nl(ob,c);
  c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,"FP rows loaded: "); c=o_i64(ob,c,nrow as i64); c=o_nl(ob,c);
  if(nrow<1){
    c=o_app(ob,c,"RESULT=FAIL (no FP rows)"); c=o_nl(ob,c);
    _zag_print(ob[0..c]);
    return 1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"Acquisition cost (trials to 3 consecutive; cap = never)"); c=o_nl(ob,c);
  c=o_app(ob,c,"  family      0FRESH   1RELEV   2IRREL  3MISLD  4ABLATED  5ORACLE"); c=o_nl(ob,c);
  let rg:i32=0;
  while(rg<NREG5()){
    c=o_app(ob,c,"       "); c=o_i64(ob,c,rg as i64);
    let a:i32=0;
    while(a<NARM5()){
      c=o_app(ob,c," "); c=o_i64(ob,c,acq(RW,nrow,rg,a) as i64);
      a=a+1;
    }
    c=o_nl(ob,c);
    rg=rg+1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);
  c=o_app(ob,c,"BARS"); c=o_nl(ob,c);
  c=o_app(ob,c,"------------------------------------------------------------------------------"); c=o_nl(ob,c);

  let m1:i32=1;
  rg=0;
  while(rg<NREG5()){
    let A1:i32=acq(RW,nrow,rg,1);
    let F1:i32=acq(RW,nrow,rg,0);
    if(!(A1<F1)){ m1=0; }
    rg=rg+1;
  }
  c=o_app(ob,c,"M1 RELEVANT < FRESH in every family            : ");
  if(m1==1){ c=o_app(ob,c,"True"); } else { c=o_app(ob,c,"False"); }
  c=o_nl(ob,c);

  let m2:i32=1;
  let worst:i32=0;
  rg=0;
  while(rg<NREG5()){
    let d:i32=acq(RW,nrow,rg,2)-acq(RW,nrow,rg,0);
    if(d<0){ d=0-d; }
    if(d>worst){ worst=d; }
    if(d>1){ m2=0; }
    rg=rg+1;
  }
  c=o_app(ob,c,"M2 IRRELEVANT neutral (|diff| <= 1 per family)  : ");
  if(m2==1){ c=o_app(ob,c,"True"); } else { c=o_app(ob,c,"False"); }
  c=o_app(ob,c,"   worst diff="); c=o_i64(ob,c,worst as i64); c=o_nl(ob,c);

  let m3a:i32=1;
  let m3b:i32=1;
  rg=0;
  while(rg<NREG5()){
    let mi:i32=acq(RW,nrow,rg,3);
    let fr:i32=acq(RW,nrow,rg,0);
    if(mi<fr){ m3a=0; }
    if(mi>fr){ m3b=0; }
    rg=rg+1;
  }
  c=o_app(ob,c,"M3a MISLEADING harmful (>= FRESH)              : ");
  if(m3a==1){ c=o_app(ob,c,"True"); } else { c=o_app(ob,c,"False"); }
  c=o_nl(ob,c);
  c=o_app(ob,c,"M3b MISLEADING revised (<= FRESH)              : ");
  if(m3b==1){ c=o_app(ob,c,"True"); } else { c=o_app(ob,c,"False"); }
  c=o_nl(ob,c);

  let lost:i32=0;
  rg=0;
  while(rg<NREG5()){
    lost=lost+(acq(RW,nrow,rg,4)-acq(RW,nrow,rg,1));
    rg=rg+1;
  }
  let m4:i32=0;
  if(lost>0){ m4=1; }
  c=o_app(ob,c,"M4 META_ABLATED loses the RELEVANT advantage   : ");
  if(m4==1){ c=o_app(ob,c,"True"); } else { c=o_app(ob,c,"False"); }
  c=o_nl(ob,c);
  c=o_app(ob,c,"   cost of ablation, total trials: "); c=o_i64(ob,c,lost as i64); c=o_nl(ob,c);
  if(lost==0){
    c=o_app(ob,c,"   *** ablation cost ZERO: the speedup is a RETAINED-FACT CACHE ***"); c=o_nl(ob,c);
  }
  if(lost<0){
    c=o_app(ob,c,"   *** ablation cost NEGATIVE: the ablated arm did BETTER ***"); c=o_nl(ob,c);
  }

  let m5:i32=1;
  rg=0;
  while(rg<NREG5()){
    if(acq(RW,nrow,rg,5) > acq(RW,nrow,rg,1)){ m5=0; }
    rg=rg+1;
  }
  c=o_app(ob,c,"M5 ORACLE_META <= RELEVANT (sanity)             : ");
  if(m5==1){ c=o_app(ob,c,"True"); } else { c=o_app(ob,c,"False"); }
  c=o_nl(ob,c);

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  c=o_app(ob,c,"VERDICT"); c=o_app(ob,c,"=============================================================================="); c=o_nl(ob,c);
  if(m1==1 && m4==1 && m2==1){
    c=o_app(ob,c,"M1, M4 and M2 all hold."); c=o_nl(ob,c);
  } else if(m1==1 && m4==0){
    c=o_app(ob,c,"NEGATIVE: M1 holds but M4 FAILS. Ablating the learned machinery"); c=o_nl(ob,c);
    c=o_app(ob,c,"while KEEPING the retained facts did not cost extra trials."); c=o_nl(ob,c);
    c=o_app(ob,c,"Per the prereg this is RETAINED TASK STATE, not meta-learning."); c=o_nl(ob,c);
  } else {
    c=o_app(ob,c,"NEGATIVE. On the prereg's own rule the prior is not learning-to-learn."); c=o_nl(ob,c);
  }
  if(m2==0){ c=o_app(ob,c,"M2 FAILS: irrelevant prior was NOT neutral."); c=o_nl(ob,c); }
  if(m3a==0 && m3b==0){ c=o_app(ob,c,"M3 FAILS: misleading prior neither hurt nor was revised."); c=o_nl(ob,c); }
  _zag_print(ob[0..c]);
  return 0;
}

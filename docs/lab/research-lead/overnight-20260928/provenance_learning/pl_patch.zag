// ============ Provenance policy learning (Micah Priority 4) ============
// Question: can TNN learn source reliability from consequences instead of
// using a permanently hardcoded source ranking?
//
// Source tags (field 16 on tag-1 FACT nodes), extending the provenance
// treatment (9e9a2e372):
//   1 = OBSERVED (world outcome, written by ev_observe_src)
//   7 = SRC_A (teacher A; usually correct)
//   8 = SRC_B (teacher B; correct, then degrades, then recovers)
// Both 7 and 8 are external teachers. No fixed rank between them.
//
// Reliability store: tag-61 nodes (storage infrastructure only, per the
// substrate consolidation ruling). One record per source:
//   f20 = correct claims, f24 = total claims, f28 = source id (7/8).
// The VALUES are learner-owned (from the experience stream). The update
// rule (count correct/total per observed claim) is researcher bookkeeping.
// The disagreement rule ("prefer the higher-reliability source") is
// researcher-owned; WHICH source wins each disagreement is learner-owned.
//
// Prediction-before-outcome: src_query predicts from the reliability-ranked
// sources BEFORE the outcome is known; ev_observe_src reveals the outcome
// and scores both sources' latest claims. This reverses the trial flow
// (world supplies expected -> search until match): here the learner commits
// to a source, then the world judges.
//
// Control arm: rank_fixed()=1 hardcodes "A always wins disagreements".
// The sed-generated control patch differs by exactly one line (verified
// by diff at build time).
fn SRC_A()i32 { return 7; }
fn SRC_B()i32 { return 8; }
fn rank_fixed()i32 { return 0; }

// Teach one fact from a named source (wraps the frozen ev_teach, then tags).
fn ev_teach_src(W:[]u8,s:i32,r:i32,o:i32,src:i32)i32 {
  let n:i32=ev_teach(W,s,r,o);
  if(n>=2){ ns(W,n,16,src); }
  return n;
}

// Read a source's reliability record into out: out[0]=correct, out[1]=total.
fn rel_get(W:[]u8,src:i32,out:[]u8)void {
  set32(out,0,0); set32(out,4,0);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,28)==src){
      set32(out,0,ng(W,n,20)); set32(out,4,ng(W,n,24));
    }
    n=n+1;
  }
  return;
}

// Bump a source's reliability: total++, correct++ if ok.
fn rel_bump(W:[]u8,src:i32,ok:i32)void {
  let rec:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,28)==src){rec=n;}
    n=n+1;
  }
  if(rec<0){
    rec=alloc_node(W); if(rec<0){return;}
    ns(W,rec,0,61); ns(W,rec,28,src); ns(W,rec,20,0); ns(W,rec,24,0);
    link_edge(W,rec,9,rec,hg(W,4));
  }
  ns(W,rec,24,ng(W,rec,24)+1);
  if(ok==1){ns(W,rec,20,ng(W,rec,20)+1);}
  return;
}

// Latest live claim per source for (s,r). out[0]=va, out[1]=vb,
// out[2]=tick_a, out[3]=tick_b. -999999 = no claim.
fn claims(W:[]u8,s:i32,r:i32,out:[]u8)void {
  set32(out,0,-999999); set32(out,4,-999999);
  set32(out,8,-1); set32(out,12,-1);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){
      let src:i32=ng(W,n,16); let tick:i32=ng(W,n,32);
      if(src==7 && tick>get32(out,8)){
        set32(out,8,tick); set32(out,0,ng(W,n,28));
      } else { if(src==8 && tick>get32(out,12)){
        set32(out,12,tick); set32(out,4,ng(W,n,28));
      }}
    }
    n=n+1;
  }
  return;
}

// Record a prediction (tag 31): f20=s, f24=r, f28=p, f32=tick,
// f4=resolved(0), f8=err, f12=credited source (7/8/9=both).
fn pred_record_src(W:[]u8,s:i32,r:i32,p:i32,cred:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,31); ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,cred);
  write_node(W,n,s,r,p,hg(W,0));
  return n;
}

// Predict (s,r) BEFORE the outcome is known. On disagreement the treatment
// prefers the source with the higher learned reliability (correct/total,
// cross-multiplied, no floats). Exact ties and no-data cases fall back to
// fact recency, which is source-neutral. Returns the predicted value and
// records a PRED node crediting the chosen source (9 = agreed).
fn src_query(W:[]u8,s:i32,r:i32)i32 {
  let cl:[]u8=z_alloc(16);
  claims(W,s,r,cl);
  let va:i32=get32(cl,0); let vb:i32=get32(cl,4);
  let ta:i32=get32(cl,8); let tb:i32=get32(cl,12);
  let p:i32=-2; let cred:i32=0;
  if(va==-999999 && vb==-999999){return -2;}
  else { if(vb==-999999){p=va; cred=7;}
  else { if(va==-999999){p=vb; cred=8;}
  else { if(va==vb){p=va; cred=9;}
  else {
    let pick:i32=7;
    // Reliability ranking runs identically in both arms. The control arm
    // then overrides the learned pick with the hardcoded rank (no else
    // branch; avoids a znc codegen fault seen with the skipped-else form).
    let ra:[]u8=z_alloc(8); let rb:[]u8=z_alloc(8);
    rel_get(W,7,ra); rel_get(W,8,rb);
    let ca:i32=get32(ra,0); let toa:i32=get32(ra,4);
    let cb:i32=get32(rb,0); let tob:i32=get32(rb,4);
    if(toa==0 && tob==0){if(tb>ta){pick=8;}}
    else { if(toa==0){pick=8;}
    else { if(tob==0){pick=7;}
    else {
      let la:i32=ca*tob; let lb:i32=cb*toa;
      if(lb>la){pick=8;}
      else { if(la==lb){ if(tb>ta){pick=8;} } }
    }}}
    if(rank_fixed()==1){pick=7;}
    if(pick==7){p=va; cred=7;} else {p=vb; cred=8;}
  }}}}
  pred_record_src(W,s,r,p,cred);
  return p;
}

// Reveal the world outcome: teach it as OBSERVED, resolve pending PREDs,
// and score BOTH sources' latest claims (the learner heard both teachers
// each round, so both reliabilities update from the same outcome).
fn ev_observe_src(W:[]u8,s:i32,r:i32,o:i32)i32 {
  ev_teach_src(W,s,r,o,1);
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0 && ng(W,n,20)==s && ng(W,n,24)==r){
      ns(W,n,4,1);
      if(ng(W,n,28)==o){ns(W,n,8,0);} else {ns(W,n,8,1);}
    }
    n=n+1;
  }
  let cl:[]u8=z_alloc(16);
  claims(W,s,r,cl);
  let va:i32=get32(cl,0); let vb:i32=get32(cl,4);
  if(va!=-999999){if(va==o){rel_bump(W,7,1);} else {rel_bump(W,7,0);}}
  if(vb!=-999999){if(vb==o){rel_bump(W,8,1);} else {rel_bump(W,8,0);}}
  return 1;
}

// ===== PROVENANCE POLICY LEARNING DRIVER (Micah Priority 4) =====
// Two external teachers, no hardcoded rank between them:
//   P1 (6 rounds): A correct, B correct. Both reliabilities climb.
//   P2 (6 rounds): A correct (42), B degrades (99). Outcome 42.
//   P3 (4 probes): disagreement only, no outcome, no scoring. Pure preference.
//   P4 (7 rounds): A degrades (99), B correct (42). Outcome 42.
//   P5 (4 probes): disagreement only, no outcome, no scoring. Pure preference.
// Control arm: rank_fixed()=1 (hardcoded "A always wins"). Same scoring.
// Expectation: treatment prefers A in P3, switches to B by end of P4,
// prefers B in P5. Control cannot switch.

fn rep2(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

fn log_state(p:[]u8,W:[]u8)void {
  let ra:[]u8=z_alloc(8); let rb:[]u8=z_alloc(8);
  rel_get(W,7,ra); rel_get(W,8,rb);
  emit(p); emit(" relA="); e64(get32(ra,0)); emit("/");
  e64(get32(ra,4)); emit(" relB="); e64(get32(rb,0)); emit("/");
  e64(get32(rb,4)); emit("\n");
  return;
}

// One scored round: both teachers claim, learner predicts, outcome revealed.
fn doround(W:[]u8,ph:i32,k:i32,va:i32,vb:i32,o:i32)i32 {
  ev_teach_src(W,1,50,va,7);
  ev_teach_src(W,1,50,vb,8);
  let p:i32=src_query(W,1,50);
  let ch:i32=9;
  if(va!=vb){ if(p==va){ch=7;} else {ch=8;} }
  ev_observe_src(W,1,50,o);
  emit("R ph="); e64(ph); emit(" k="); e64(k);
  emit(" va="); e64(va); emit(" vb="); e64(vb);
  emit(" pred="); e64(p); emit(" out="); e64(o);
  emit(" ch="); e64(ch);
  let ra:[]u8=z_alloc(8); let rb:[]u8=z_alloc(8);
  rel_get(W,7,ra); rel_get(W,8,rb);
  emit(" A="); e64(get32(ra,0)); emit("/"); e64(get32(ra,4));
  emit(" B="); e64(get32(rb,0)); emit("/"); e64(get32(rb,4));
  emit("\n");
  return p;
}

// One unscored probe: learner predicts from standing claims, no outcome.
fn doprobe(W:[]u8,ph:i32,k:i32)i32 {
  let cl:[]u8=z_alloc(16);
  claims(W,1,50,cl);
  let va:i32=get32(cl,0); let vb:i32=get32(cl,4);
  let p:i32=src_query(W,1,50);
  let ch:i32=9;
  if(va!=vb){ if(p==va){ch=7;} else {ch=8;} }
  emit("Q ph="); e64(ph); emit(" k="); e64(k);
  emit(" va="); e64(va); emit(" vb="); e64(vb);
  emit(" pred="); e64(p); emit(" ch="); e64(ch);
  emit("\n");
  return ch;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("MODE rank_fixed="); e64(rank_fixed()); emit("\n");
  let k:i32=1; let ca:i32=0; let cb:i32=0;
  while(k<=6){ doround(W,1,k,42,42,42); k=k+1; }
  log_state("P1",W);
  k=1;
  while(k<=6){ doround(W,2,k,42,99,42); k=k+1; }
  log_state("P2",W);
  k=1; ca=0;
  while(k<=4){ if(doprobe(W,3,k)==7){ca=ca+1;} k=k+1; }
  rep2("P3","preferA",ca);
  k=1;
  while(k<=7){ doround(W,4,k,99,42,42); k=k+1; }
  log_state("P4",W);
  k=1; cb=0;
  while(k<=4){ if(doprobe(W,5,k)==8){cb=cb+1;} k=k+1; }
  rep2("P5","preferB",cb);
  emit("DONE\n");
  return 0;
}

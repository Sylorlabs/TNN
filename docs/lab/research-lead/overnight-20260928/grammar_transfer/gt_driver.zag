// gt_driver.zag -- grammar TRANSFER experiment driver.
// Second formal system EXL2 (different operators and constraint shape
// than EXL): literals 0..9; eval ops SUB(41), DIV(42); decomp DSUB=43,
// DDIV=44; BUILD=45. Pair P(a,b) = a*16+b (same world encoding
// convention as EXL; researcher-owned).
// Constraints (taught via examples only, never as rules):
//   SUB: (P(a,b),41,a-b) taught only when a-b >= 0 (lower bound).
//   DIV: (P(a,b),42,a/b) taught only when b>0 and a/b exact.
// The induction machinery (gt_patch.zag, byte-identical to gi_patch.zag)
// is UNMODIFIED. Only the example stream (this file's teaching section)
// and the world-specific test battery differ.

fn gi_P(a:i32,b:i32)i32 { return a*16+b; }

// ---- teaching (examples only; no grammar rules taught) ----

fn gt_dsub(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a-b==t){ev_teach_in(W,t,43,gi_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gt_ddiv(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(b>0){
        if(a-(a/b)*b==0){
          if(a/b==t){ev_teach_in(W,t,44,gi_P(a,b));}
        }
      }
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gt_teach_decomp(W:[]u8)void {
  let t:i32=0;
  while(t<=9){gt_dsub(W,t); gt_ddiv(W,t); t=t+1;}
  return;
}

// Canonical BUILD example for a TRAIN target. divfirst=1: first exact
// DIV pair; divfirst=0: first SUB pair. The teacher alternates so both
// licensor relations appear in the example stream. These 4 examples are
// the ONLY BUILD supervision; the grammar must be induced from them.
fn gt_canon_build(W:[]u8,t:i32,divfirst:i32)void {
  let a:i32=0; let done:i32=0;
  if(divfirst==1){
    while(a<=9 && done==0){
      let b:i32=0;
      while(b<=9 && done==0){
        if(b>0){
          if(a-(a/b)*b==0){
            if(a/b==t){ev_teach_in(W,t,45,gi_P(a,b)); done=1;}
          }
        }
        b=b+1;
      }
      a=a+1;
    }
  }
  a=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a-b==t){ev_teach_in(W,t,45,gi_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn gt_teach_build(W:[]u8)void {
  gt_canon_build(W,1,1);
  gt_canon_build(W,3,0);
  gt_canon_build(W,5,1);
  gt_canon_build(W,7,0);
  return;
}

fn gt_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=gi_P(a,b);
      if(a-b>=0){ev_teach_in(W,p,41,a-b);}
      if(b>0){
        if(a-(a/b)*b==0){ev_teach_in(W,p,42,a/b);}
      }
      b=b+1;
    }
    a=a+1;
  }
  gt_teach_decomp(W);
  gt_teach_build(W);
  return;
}

// ---- grammar reporting (identical to gi_driver) ----

fn gi_report_grammar(W:[]u8)void {
  let g:i32=gi_grammar_find(W);
  if(g<0){emit("GI-GRAMMAR none\n"); return;}
  let nlic:i32=ng(W,g,4);
  emit("GI-GRAMMAR nbuild="); e64(ng(W,g,32));
  emit(" nlic="); e64(nlic); emit(" lic=");
  if(nlic>0){e64(ng(W,g,8));}
  if(nlic>1){emit(","); e64(ng(W,g,12));}
  emit(" a=["); e64(ng(W,g,16)); emit(","); e64(ng(W,g,20)); emit("]");
  emit(" b=["); e64(ng(W,g,24)); emit(","); e64(ng(W,g,28)); emit("]");
  emit(" maxlinks=1\n");
  return;
}

// ---- test battery (world-specific targets; no BUILD facts taught) ----

fn gi_test_targets(out:[]u8)i32 {
  set32(out,0,0); set32(out,4,2); set32(out,8,4); set32(out,12,6);
  set32(out,16,8); set32(out,20,9);
  return 6;
}

// INDUCE arm: construction guided by the induced grammar.
// (identical to gi_driver)
fn gi_arm_induce(W:[]u8)i32 {
  let gb:[]u8=z_alloc(40);
  let gok:i32=gi_grammar_read(W,gb);
  if(gok==0){emit("GI-I-NOGRAMMAR\n"); return 0;}
  let tg:[]u8=z_alloc(48); let n:i32=gi_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=gi_trial_build2(W,t,gb);
    let cl:i32=gi_classify(W,t);
    emit("GI-I "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-I-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// BASE arm: grammar-blind base trial (used for ABLATE and FRESH arms).
// (identical to gi_driver)
fn gi_arm_base(W:[]u8)i32 {
  let tg:[]u8=z_alloc(48); let n:i32=gi_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=t2_trial(W,t,45,-2,1,0,0);
    let cl:i32=gi_classify(W,t);
    emit("GI-B "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-B-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// HARDCODE arm: researcher-authored grammar restriction (prior treatment).
// (identical to gi_driver)
fn gi_arm_hardcode(W:[]u8)i32 {
  let tg:[]u8=z_alloc(48); let n:i32=gi_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=gi_hardcode_build(W,t);
    let cl:i32=gi_classify(W,t);
    emit("GI-H "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("GI-H-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

fn main()i32 {
  emit("GI-START\n");
  // W1: INDUCE. Teach EXL2, induce grammar from examples, build with it.
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  gt_teach(W1);
  emit("GI-W1-INDUCE\n");
  let ind1:i32=gi_induce(W1);
  emit("GI-INDUCED "); e64(ind1); emit("\n");
  gi_report_grammar(W1);
  emit("GI-W1-BATTERY\n");
  let v1:i32=gi_arm_induce(W1);
  // W2: ABLATE. Teach, induce, DELETE the grammar, then base trial.
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  gt_teach(W2);
  emit("GI-W2-ABLATE\n");
  let ind2:i32=gi_induce(W2);
  emit("GI-INDUCED "); e64(ind2); emit("\n");
  let ab2:i32=gi_ablate(W2);
  emit("GI-ABLATED "); e64(ab2); emit("\n");
  gi_report_grammar(W2);
  emit("GI-W2-BATTERY\n");
  let v2:i32=gi_arm_base(W2);
  // W3: HARDCODE. Teach, build with researcher-authored restriction.
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  gt_teach(W3);
  emit("GI-W3-HARDCODE\n");
  let v3:i32=gi_arm_hardcode(W3);
  // W4: FRESH. Teach, no induction, base trial.
  let W4:[]u8=z_alloc(110656); tnn2_init(W4);
  gt_teach(W4);
  emit("GI-W4-FRESH\n");
  let v4:i32=gi_arm_base(W4);
  // W5a: CONTRADICT-UNLICENSED. One deceptive BUILD fact (2,45,P(9,9))
  // labeled valid by the teacher, but no licensor (T,r,P) exists for it.
  let W5a:[]u8=z_alloc(110656); tnn2_init(W5a);
  gt_teach(W5a);
  ev_teach_in(W5a,2,45,gi_P(9,9));
  emit("GI-W5A-CONTRADICT\n");
  let ind5a:i32=gi_induce(W5a);
  emit("GI-INDUCED "); e64(ind5a); emit("\n");
  gi_report_grammar(W5a);
  emit("GI-W5A-BATTERY\n");
  let v5a:i32=gi_arm_induce(W5a);
  // W5b: CONTRADICT-THIRD-LICENSOR. Deceptive teacher adds a bogus
  // decomp relation 46 licensing (3,45,P(4,1)) alongside true DSUB 43.
  let W5b:[]u8=z_alloc(110656); tnn2_init(W5b);
  gt_teach(W5b);
  ev_teach_in(W5b,3,46,gi_P(4,1));
  ev_teach_in(W5b,3,45,gi_P(4,1));
  emit("GI-W5B-CONTRADICT\n");
  let ind5b:i32=gi_induce(W5b);
  emit("GI-INDUCED "); e64(ind5b); emit("\n");
  gi_report_grammar(W5b);
  emit("GI-W5B-BATTERY\n");
  let v5b:i32=gi_arm_induce(W5b);
  emit("GI-SUMMARY induce="); e64(v1); emit(" ablate="); e64(v2);
  emit(" hardcode="); e64(v3); emit(" fresh="); e64(v4);
  emit(" contraA="); e64(v5a); emit(" contraB="); e64(v5b); emit("\n");
  emit("GI-DONE\n");
  return 0;
}

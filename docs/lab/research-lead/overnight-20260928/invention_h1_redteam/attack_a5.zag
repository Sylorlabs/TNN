// attack_a5.zag -- SUF (source-underdetermined form) attack on Invention H1.
//
// Hypothesis under attack: the H1 report claims the invented form is
// source-underdetermined ("which parent mutates depends on the learner's
// history; which fact extends it depends on the world's data"). This
// driver tests whether the parent's learned CONTENT matters at all.
//   Workspace A: plen-5 parent trained on values 121..125.
//   Workspace B: plen-5 parent trained on values 921..925 (different).
//   Both pose the IDENTICAL plen-6 problem (301..306, expected 306).
// Predictions:
//   P1: both mutants' value sequences are byte-identical (301..306):
//       the parent's values appear nowhere in the mutant.
//   P2: both answers are 306.
//   P3 (control): a plen-4-only parent cannot solve it (-2): only the
//       parent's PLEN is causally load-bearing, never its content.
// The mutant is therefore the researcher's world chain re-derived at
// parent-plen+1 and verified against researcher-supplied expected.
// Pure Zag. No H1 source edits. Adversarial comparison only.

// print the mutant's chain value sequence (guard/set literals in order)
fn rt_dump_vals(W:[]u8,m:i32)void {
  let root:i32=ng(W,m,20);
  let cur:i32=root; let lastv:i32=-999999; let n:i32=0;
  emit("SEQ:");
  while(cur>=0 && n<64){
    let tag:i32=ng(W,cur,0);
    if(tag==102){
      emit(" "); e64(ng(W,ng(W,cur,8),20));
      cur=ng(W,cur,12);
    } else { if(tag==101){
      lastv=ng(W,ng(W,cur,8),20);
      cur=seq_nx(W,cur);
    } else { cur=-1; } }
    n=n+1;
  }
  emit(" "); e64(lastv); emit("\n");
  return;
}
// train a plen-5 parent on the given base subject, then pose the shared
// plen-6 problem. Returns the answer.
fn rt_a5_arm(W:[]u8,base:i32)i32 {
  ev_teach(W,base,1,base+1); ev_teach(W,base+1,1,base+2);
  ev_teach(W,base+2,1,base+3); ev_teach(W,base+3,1,base+4);
  let t:i32=ev_query(W,base,71,base+4,0);
  emit("train5 ans="); e64(t); emit("\n");
  ev_teach(W,301,1,302); ev_teach(W,302,1,303); ev_teach(W,303,1,304);
  ev_teach(W,304,1,305); ev_teach(W,305,1,306);
  let z:i32=ev_query(W,301,71,306,0);
  emit("T6 ans="); e64(z); mu_tstat(W); emit("\n");
  return z;
}
fn main()i32 {
  emit("A5-START\n");
  let WA:[]u8=z_alloc(110656); tnn2_init(WA);
  emit("--- arm A (parent values 121..125) ---\n");
  let za:i32=rt_a5_arm(WA,121);
  let ma:i32=mu_find_map(WA,301,71);
  emit("A "); rt_dump_vals(WA,ma);
  let WB:[]u8=z_alloc(110656); tnn2_init(WB);
  emit("--- arm B (parent values 921..925) ---\n");
  let zb:i32=rt_a5_arm(WB,921);
  let mb:i32=mu_find_map(WB,301,71);
  emit("B "); rt_dump_vals(WB,mb);
  emit("P1 answers-equal="); e64(za==zb); emit(" (sequences above)\n");
  emit("P2 both-correct="); e64(za==306 && zb==306); emit("\n");
  // control: plen-4 parent only
  let WC:[]u8=z_alloc(110656); tnn2_init(WC);
  emit("--- arm C (plen-4 parent only) ---\n");
  mu_train4(WC);
  ev_teach(WC,301,1,302); ev_teach(WC,302,1,303); ev_teach(WC,303,1,304);
  ev_teach(WC,304,1,305); ev_teach(WC,305,1,306);
  let zc:i32=ev_query(WC,301,71,306,0);
  emit("T6 ans="); e64(zc); mu_tstat(WC); emit("\n");
  emit("P3 plen4-fails="); e64(zc==-2); emit("\n");
  emit("A5-END\n");
  return 0;
}

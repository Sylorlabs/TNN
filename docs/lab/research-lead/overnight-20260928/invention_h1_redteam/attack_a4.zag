// attack_a4.zag -- EXPLOSION / OPEN-ENDEDNESS attack on Invention H1.
//
// Hypothesis under attack: the H1 report claims the operator is
// "open-ended: a promoted mutant becomes a parent for future mutations,
// so reachable forms (plen 8, 9, ...) are unbounded while source stays
// fixed" (116 -> 271 -> 549 iterating forever). This driver issues 5
// sequential failing queries in ONE workspace, each requiring exactly
// one more cell than the last (subject 1000+100*i, chain of 5+i values,
// expected = last value). Rebind and trial fail every query by
// construction. Measurements per query: answer, MAP count, live nodes.
// Predictions:
//   P1: Q1 and Q2 mint mutants (plen 6, 7); Q3 and later FAIL (ans=-2)
//       because t2_gather caps paths at 6 values (source line: if(len<6)),
//       so a plen-7 parent can never stage. Iteration stops at plen 7.
//   P2: MAP count stalls (no spam past the cap), but every failing query
//       still burns ~200 leaked nodes (rejected trial/rebind candidate
//       graphs are never freed): no brake on ATTEMPTS.
//   P3 (static): even past the gather cap, mu_extend_one's ve=z_alloc(28)
//       and fe=z_alloc(24) overflow the heap for parent plen p>=7
//       (extension needs (p+1)*4 and p*4 bytes). Latent heap OOB.
// Pure Zag. No H1 source edits. Adversarial workload only.

fn a4_query(W:[]u8,i:i32)void {
  // subject s=1000+100*i, chain of 5+i values, expected = last value
  let s:i32=1000+100*i;
  let nv:i32=5+i;
  let j:i32=0;
  while(j<nv-1){
    ev_teach(W,s+j,1,s+j+1);
    j=j+1;
  }
  let exp:i32=s+nv-1;
  let a:i32=ev_query(W,s,71,exp,0);
  emit("Q"); e64(i);
  emit(" ans="); e64(a);
  emit(" ok="); e64(a==exp);
  emit(" maps="); e64(mu_count_maps(W));
  emit(" live="); e64(hg(W,20));
  mu_tstat(W); emit("\n");
  return;
}
fn main()i32 {
  emit("A4-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  mu_train5(W);   // X5 plen-5 parent, subject 121
  let x5:i32=mu_find_map(W,121,71);
  emit("X5 id="); e64(x5); emit("\n");
  let i:i32=1;
  while(i<=5){
    a4_query(W,i);
    i=i+1;
  }
  let x5alive:i32=0;
  if(ng(W,x5,36)==1){x5alive=1;}
  emit("P3 X5-survives="); e64(x5alive); emit("\n");
  let m1:i32=mu_find_map(W,1100,71);
  let m1alive:i32=0;
  if(m1>=0 && ng(W,m1,36)==1){m1alive=1;}
  emit("P3 M1-survives="); e64(m1alive); emit("\n");
  emit("A4-END\n");
  return 0;
}

// attack_a2.zag -- DECOY-SIGNAL attack on Invention H1.
//
// Hypothesis under attack: the "too short" signal ("the world continues
// past the parent's reach") is computed as ANY fact (vend -> w) under ANY
// relation. This driver tests whether the mutation operator extends into
// decoy continuations under an unrelated relation (rel 99).
//   A2a: both a decoy-rel fact (305,99,306, taught FIRST) and the true
//        chain fact (305,1,306) continue past the endpoint. Prediction:
//        id-order scan tries the decoy first; the mutant is licensed by
//        the rel-99 fact (relation-blind extension).
//   A2b: ONLY the decoy-rel fact continues past the endpoint. Prediction:
//        mutation still extends and promotes; the "chain" mutant's last
//        link is a rel-99 fact.
// Pure Zag. No H1 source edits. Adversarial worlds only.

// highest-id DEP fact target of MAP m (the continuing/extension fact).
// Returns its relation, or -999 if none. Prints the fact triple.
fn rt_ext_rel(W:[]u8,m:i32)i32 {
  let bf:i32=-1; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let to:i32=eg(W,e,8);
      if(ng(W,to,36)==1 && ng(W,to,0)==1){ if(to>bf){bf=to;} }
    }
    e=e+1;
  }
  emit("EXTFACT id="); e64(bf);
  if(bf<0){ emit("\n"); return -999; }
  emit(" from="); e64(ng(W,bf,20));
  emit(" rel="); e64(ng(W,bf,24));
  emit(" to="); e64(ng(W,bf,28)); emit("\n");
  return ng(W,bf,24);
}
// shared setup: plen-5 parent + 5-value chain world; caller teaches the
// continuing facts.
fn main()i32 {
  emit("A2-START\n");
  // ---- A2a: decoy (rel 99) taught before true (rel 1) ----
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  mu_train5(W1);
  ev_teach(W1,301,1,302); ev_teach(W1,302,1,303); ev_teach(W1,303,1,304);
  ev_teach(W1,304,1,305);
  ev_teach(W1,305,99,306);   // decoy continuation, lower node id
  ev_teach(W1,305,1,306);    // true chain continuation, higher node id
  let a:i32=ev_query(W1,301,71,306,0);
  emit("A2a ans="); e64(a); mu_tstat(W1); emit("\n");
  let zm1:i32=mu_find_map(W1,301,71);
  emit("A2a ");
  let r1:i32=rt_ext_rel(W1,zm1);
  emit("A2a decoy-licensed="); e64(r1==99); emit(" answer-ok="); e64(a==306); emit("\n");
  // ---- A2b: ONLY the decoy-rel fact continues ----
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  mu_train5(W2);
  ev_teach(W2,301,1,302); ev_teach(W2,302,1,303); ev_teach(W2,303,1,304);
  ev_teach(W2,304,1,305);
  ev_teach(W2,305,99,306);   // the only continuation, under rel 99
  let b:i32=ev_query(W2,301,71,306,0);
  emit("A2b ans="); e64(b); mu_tstat(W2); emit("\n");
  let zm2:i32=mu_find_map(W2,301,71);
  emit("A2b ");
  let r2:i32=rt_ext_rel(W2,zm2);
  emit("A2b decoy-only-extends="); e64(r2==99); emit(" answer-ok="); e64(b==306); emit("\n");
  emit("A2-END\n");
  return 0;
}

// attack_a1.zag -- WRONG-PARENT attack on Invention H1.
//
// Hypothesis under attack: mutate_try selects the mutation parent by
// longest-plen-first, which the H1 report frames as "extends the longest
// chain MAP". This driver builds a two-domain workspace where the longest
// chain MAP belongs to an unrelated DISTRACTOR domain and the
// domain-correct parent is shorter, then poses a query only the
// distractor's length can unlock. Predictions:
//   P1: the distractor (plen 6) is tried first and its extension verifies;
//       MUT-STAT parent=<distractor id>.
//   P2: the promoted mutant's DEP->MAP edge points to the distractor
//       (cross-domain provenance), never to the domain-correct parent.
//   P3 (control): without the distractor the same query fails (-2),
//       proving the distractor contributed only its LENGTH, not structure.
// Pure Zag. No H1 source edits. Adversarial worlds only.

// first DEP edge target of m that is itself a MAP node, else -1
fn rt_dep_map(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let to:i32=eg(W,e,8);
      if(ng(W,to,36)==1 && ng(W,to,0)==20){return to;}
    }
    e=e+1;
  }
  return -1;
}
// MAP node with given chain plen learned from given subject, else -1
fn rt_find_map(W:[]u8,plen:i32,subj:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(rb_chain_plen(W,ng(W,m,20))==plen && ng(W,m,8)==subj){return m;}
    }
    m=m+1;
  }
  return -1;
}
fn rt_map_info(W:[]u8,tag:[]u8,m:i32)void {
  emit(tag); emit(" id="); e64(m);
  if(m>=0){
    emit(" plen="); e64(rb_chain_plen(W,ng(W,m,20)));
    emit(" subj="); e64(ng(W,m,8));
  }
  emit("\n");
  return;
}
// distractor domain D: plen-3/4/5 MAPs via trial, then a plen-6 problem
// that mutation must solve (trial bound is plen<=5)
fn a1_distractor(W:[]u8)void {
  ev_teach(W,901,1,902); ev_teach(W,902,1,903);
  emit("D3 ans="); e64(ev_query(W,901,71,903,0)); emit("\n");
  ev_teach(W,911,1,912); ev_teach(W,912,1,913); ev_teach(W,913,1,914);
  emit("D4 ans="); e64(ev_query(W,911,71,914,0)); emit("\n");
  ev_teach(W,921,1,922); ev_teach(W,922,1,923);
  ev_teach(W,923,1,924); ev_teach(W,924,1,925);
  emit("D5 ans="); e64(ev_query(W,921,71,925,0)); emit("\n");
  ev_teach(W,931,1,932); ev_teach(W,932,1,933); ev_teach(W,933,1,934);
  ev_teach(W,934,1,935); ev_teach(W,935,1,936);
  emit("D6 ans="); e64(ev_query(W,931,71,936,0)); emit("\n");
  return;
}
// attack query: 6-value chain plus one continuing fact; expected is one
// past the chain end. Needs a plen-6 parent staged (trial max plen 5).
fn a1_attack_query(W:[]u8)i32 {
  ev_teach(W,501,1,502); ev_teach(W,502,1,503); ev_teach(W,503,1,504);
  ev_teach(W,504,1,505); ev_teach(W,505,1,506); ev_teach(W,506,1,507);
  let z:i32=ev_query(W,501,71,507,0);
  emit("A1Q ans="); e64(z); mu_tstat(W); emit("\n");
  return z;
}
fn main()i32 {
  emit("A1-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  emit("--- distractor domain D ---\n");
  a1_distractor(W1);
  emit("--- target domain X (plen-5 parent) ---\n");
  mu_train5(W1);
  let d6:i32=rt_find_map(W1,6,931);
  let x5:i32=rt_find_map(W1,5,121);
  rt_map_info(W1,"DISTRACTOR",d6);
  rt_map_info(W1,"CORRECT-PARENT",x5);
  emit("--- attack query ---\n");
  let z:i32=a1_attack_query(W1);
  let zm:i32=mu_find_map(W1,501,71);
  rt_map_info(W1,"MUTANT",zm);
  let par:i32=rt_dep_map(W1,zm);
  rt_map_info(W1,"MUTANT-DEP-PARENT",par);
  emit("P1 parent-is-distractor="); e64(par==d6); emit("\n");
  emit("P2 answer-correct="); e64(z==507); emit("\n");
  // control: same workspace minus the distractor
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  emit("--- control (no distractor) ---\n");
  mu_train5(W2);
  let z2:i32=a1_attack_query(W2);
  emit("P3 control-fails="); e64(z2==-2); emit("\n");
  emit("A1-END\n");
  return 0;
}

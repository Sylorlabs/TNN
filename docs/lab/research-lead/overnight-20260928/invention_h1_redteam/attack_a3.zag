// attack_a3.zag -- NON-CHAIN attack on Invention H1.
//
// Hypothesis under attack: the mutation operator is a general pipeline
// stage ("fires on any query where all existing mechanisms fail and a
// parent MAP can be extended"). This driver tests whether it does
// anything at all outside chain-family: the learner state holds ONLY a
// count MAP (rb_chain_plen == -1), then a plen-6 chain problem is posed
// that rebind and trial cannot solve.
// Predictions:
//   P1: mu_best_plen == -1 with only a count MAP in state (non-chain
//       MAPs are invisible to parent selection).
//   P2: MUT-STAT tried=0 rejected=0 and ans=-2: the stage is inert.
//   P3 (sanity): the count MAP itself was properly learned (ans=3).
// Pure Zag. No H1 source edits. Adversarial worlds only.

fn main()i32 {
  emit("A3-START\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // train a count MAP: chain under rel 21, query count under rel 43
  ev_teach(W,101,21,102); ev_teach(W,102,21,103); ev_teach(W,103,21,104);
  let c:i32=ev_query(W,101,43,3,0);
  emit("COUNT ans="); e64(c); mu_tstat(W); emit("\n");
  emit("P3 count-learned="); e64(c==3); emit("\n");
  let cm:i32=mu_find_map(W,101,43);
  emit("COUNTMAP id="); e64(cm);
  emit(" chain-plen="); e64(rb_chain_plen(W,ng(W,cm,20))); emit("\n");
  emit("P1 best-plen="); e64(mu_best_plen(W)); emit(" (expect -1)\n");
  // now a plen-6 chain problem no other mechanism can solve
  ev_teach(W,301,1,302); ev_teach(W,302,1,303); ev_teach(W,303,1,304);
  ev_teach(W,304,1,305); ev_teach(W,305,1,306);
  let z:i32=ev_query(W,301,71,306,0);
  emit("CHAIN6 ans="); e64(z); mu_tstat(W); emit("\n");
  emit("P2 inert="); e64(z==-2); emit("\n");
  emit("A3-END\n");
  return 0;
}

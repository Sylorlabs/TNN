// gc_uni.zag -- sequence-trial generalization of U (GEN-CYCLES lane).
// Generalizes U's ordered trial {singles, ordered pairs x!=y, each applied
// once} to trial over re-applicable structure sequences with halting.
//
// A sequence [m1..mk] (k>=1; repetitions allowed for k>=3) is admitted by
// the chain kind rule (Section: gc_admit_seq), then executed stepwise.
// After each step a halting condition is checked, expressed in the existing
// contract vocabulary: output==input (the fixpoint signal; available
// because the STEP-at-fixpoint identity is taught) or the step cap.
// End-to-end verification (halted value == expected) is retained; on
// success every step is recorded via observe (generalizing U's pair
// recording). One sequence trial counts one TRIES increment, as U counts
// one try per pair.
//
// Pipelines are the special case: k<=2 with halt-after-one-pass is U
// (gc_solve with seqmax<=2 executes exactly uni_solve's code path).
// The executor below is uniform over all sequences: the halting checks
// run after every step of every trial. There is no branch on repetition,
// on MAP identity, or on any shape predicate.
//
// Arena scratch beyond U's layout: 968: V history, 9 x 4 bytes
// (V[0]=start subject, V[i]=value after step i). Zeroed by world_new.

// Chain admission. Subsumes U's rules: k=1 is uni_admit_single,
// k=2 is uni_admit_pair (same k_has/k_inter calls in the same order).
fn gc_admit_seq(A:[]u8,S:[]u8,k:i32,kin:i32,kout:i32)i32 {
  if(kind_filter_on()==0){ return 1; }
  if(k_has(mg(A,S[0] as i32,3),kin)==0){ return 0; }
  let i:i32=0;
  while(i<k-1){
    if(k_inter(mg(A,S[i] as i32,4),mg(A,S[i+1] as i32,3))==0){ return 0; }
    i=i+1;
  }
  if(k_has(mg(A,S[k-1] as i32,4),kout)==0){ return 0; }
  return 1;
}
// Stepwise execution with halting. Prints one INTER= per step.
// Returns cursor c. Sets found/ans and records each step on success.
fn gc_try_seq(A:[]u8,B:[]u8,c:i32,S:[]u8,k:i32,s:i32,exp:i32,cap:i32)i32 {
  ap(A,936,ag(A,936)+1);
  set32(A,968,s);
  let cur:i32=s;
  let i:i32=0;
  while(i<k){
    let m:i32=S[i] as i32;
    let prev:i32=cur;
    let v:i32=exec_map(A,m,cur);
    c=o_app(B,c,"INTER="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
    if(v<0){ return c; }
    set32(A,968+(i+1)*4,v);
    cur=v;
    i=i+1;
    if(v==prev){ break; }
    if(i>=cap){ break; }
  }
  if(cur==exp){
    let j:i32=0;
    while(j<i){
      observe(A,S[j] as i32,get32(A,968+j*4),get32(A,968+(j+1)*4));
      j=j+1;
    }
    ap(A,944,cur); ap(A,940,1);
  }
  return c;
}
// Enumerate all nm^k sequences lexicographically (position 0 slowest).
// widen=0: try admitted; widen=1: try rejected (one retry each).
fn gc_run_len(A:[]u8,B:[]u8,c:i32,k:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32,cap:i32,widen:i32)i32 {
  let total:i32=1;
  let t:i32=0;
  while(t<k){ total=total*nm; t=t+1; }
  let S:[]u8=z_alloc(8);
  let n:i32=0;
  while(n<total){
    let tmp:i32=n;
    let i:i32=k-1;
    while(i>=0){
      S[i]=(tmp%nm) as u8;
      tmp=tmp/nm;
      i=i-1;
    }
    let ad:i32=gc_admit_seq(A,S,k,kin,kout);
    if(widen==0 && ad==1){
      c=gc_try_seq(A,B,c,S,k,s,exp,cap);
      if(ag(A,940)==1){ return c; }
    }
    if(widen==1 && ad==0){
      c=gc_try_seq(A,B,c,S,k,s,exp,cap);
      if(ag(A,940)==1){ return c; }
    }
    n=n+1;
  }
  return c;
}
// Generalized solve: frozen uni_solve (U's prefix) then sequence phases.
// With seqmax<=2 the sequence block is skipped: exactly uni_solve.
fn gc_solve(A:[]u8,B:[]u8,c:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32,seqmax:i32,cap:i32)i32 {
  c=uni_solve(A,B,c,s,kin,kout,exp,nm);
  if(ag(A,940)==1){ return c; }
  if(seqmax>=3){
    let k:i32=3;
    while(k<=seqmax){
      c=gc_run_len(A,B,c,k,s,kin,kout,exp,nm,cap,0);
      if(ag(A,940)==1){ return c; }
      k=k+1;
    }
    if(kind_filter_on()==1){
      c=o_app(B,c,"WIDEN=2"); c=o_nl(B,c);
      let k2:i32=3;
      while(k2<=seqmax){
        c=gc_run_len(A,B,c,k2,s,kin,kout,exp,nm,cap,1);
        if(ag(A,940)==1){ return c; }
        k2=k2+1;
      }
    }
  }
  return c;
}

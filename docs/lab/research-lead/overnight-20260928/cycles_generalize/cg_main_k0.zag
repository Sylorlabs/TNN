// cg_main_k0.zag -- T3 control driver (frozen mechanism on the T3 workload).
// The HALT-kind signal is absent from the frozen executor, so the
// workload must fail (ANS=-2). seqmax=3 keeps the failure trace auditable.
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=world_new();
  setup_qk(A);
  c=gc_solve(A,B,c,5001,1,1,5002,4,3,8);
  c=uni_report(A,B,c,"GC","QK0");
  c=uni_census(A,B,c,4);
  o_flush(B,c);
  return 0;
}

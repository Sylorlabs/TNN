// uc_base.zag -- shared base for the compose-collapse battery.
// Fact store, probe_kind, behaviors (WALK/COUNT/MAYBE/IDENT), MAP table,
// kind-contract observations, teaching, world setups, output helpers.
// Pure Zag. No Python.
//
// Output rule (mandatory): dynamic content is formatted into ONE preallocated
// buffer with cursor-returning helpers, then a single _zag_raw_syscall write.
// _zag_print is never used for dynamic content.
//
// Arena layout (bytes):
//   0: nf (fact count)
//   4: facts, 64 * 12 bytes (s,r,o as little-endian i32)
//   776: MAP table, 4 maps * 10 fields * 4 bytes
//        fields: 0 class, 1 rel, 2 rel2, 3 inmask, 4 outmask,
//                5 in_node, 6 in_num, 7 out_node, 8 out_num, 9 nobs
//   936: tries   940: found   944: ans
//   948: class list, 4 * 4 bytes   964: nclass
// Classes: 0=WALK, 1=COUNT, 2=MAYBE, 3=IDENT, 4=STEP (one hop; identity at fixpoint).

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena access ----
fn ag(A:[]u8,off:i32)i32 { return get32(A,off); }
fn ap(A:[]u8,off:i32,v:i32)void { set32(A,off,v); return; }
fn mg(A:[]u8,m:i32,f:i32)i32 { return get32(A,776+m*40+f*4); }
fn mp(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,776+m*40+f*4,v); return; }
fn world_new()[]u8 { return z_alloc(4096); }
// ---- facts ----
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=ag(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    ap(A,0,n+1);
  }
  return;
}
fn is_subject(A:[]u8,v:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12)==v){ return 1; }
    i=i+1;
  }
  return 0;
}
fn pkind(A:[]u8,v:i32)i32 {
  if(is_subject(A,v)==1){ return 1; }
  return 2;
}
// ---- behaviors ----
fn walkf(A:[]u8,s:i32,rel:i32)i32 {
  let cur:i32=s;
  let steps:i32=0;
  while(steps<32){
    let n:i32=ag(A,0);
    let i:i32=0;
    let nxt:i32=-2;
    while(i<n){
      let fs0:i32=get32(A,4+i*12);
      let fr0:i32=get32(A,4+i*12+4);
      if(fs0==cur && fr0==rel){ nxt=get32(A,4+i*12+8); i=n; }
      i=i+1;
    }
    if(nxt==-2){
      if(steps==0){ return -2; }
      return cur;
    }
    cur=nxt;
    steps=steps+1;
  }
  return cur;
}
fn count_rel(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    let fs0:i32=get32(A,4+i*12);
    let fr0:i32=get32(A,4+i*12+4);
    if(fs0==s && fr0==rel){ c=c+1; }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
// STEP: one hop along rel; identity at fixpoint (no outgoing edge -> return input).
fn stepf(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  let nxt:i32=s;
  while(i<n){
    let fs0:i32=get32(A,4+i*12);
    let fr0:i32=get32(A,4+i*12+4);
    if(fs0==s && fr0==rel){ nxt=get32(A,4+i*12+8); i=n; }
    i=i+1;
  }
  return nxt;
}
fn exec_map(A:[]u8,m:i32,s:i32)i32 {
  let cl:i32=mg(A,m,0);
  let r1:i32=mg(A,m,1);
  if(cl==0){ return walkf(A,s,r1); }
  if(cl==1){ return count_rel(A,s,r1); }
  if(cl==3){ return s; }
  if(cl==4){ return stepf(A,s,r1); }
  let r2:i32=mg(A,m,2);
  let e:i32=walkf(A,s,r1);
  if(e==-2){ return -2; }
  let c:i32=count_rel(A,e,r2);
  if(c==-2){ return e; }
  return c;
}
// ---- contract observations ----
fn observe(A:[]u8,m:i32,inv:i32,outv:i32)void {
  let ik:i32=pkind(A,inv);
  let ok:i32=pkind(A,outv);
  if(ik==1){ mp(A,m,5,mg(A,m,5)+1); }
  if(ik==2){ mp(A,m,6,mg(A,m,6)+1); }
  if(ok==1){ mp(A,m,7,mg(A,m,7)+1); }
  if(ok==2){ mp(A,m,8,mg(A,m,8)+1); }
  mp(A,m,3,mg(A,m,3)|(1<<(ik-1)));
  mp(A,m,4,mg(A,m,4)|(1<<(ok-1)));
  mp(A,m,9,mg(A,m,9)+1);
  return;
}
fn teach(A:[]u8,m:i32,s:i32,exp:i32)void {
  let v:i32=exec_map(A,m,s);
  if(v==exp){ observe(A,m,s,v); }
  return;
}
fn map_new(A:[]u8,m:i32,cl:i32,r1:i32,r2:i32)void {
  mp(A,m,0,cl); mp(A,m,1,r1); mp(A,m,2,r2);
  return;
}
// ---- H1 majority signatures (n>=2 finalize; avg>=1.5 -> NUM) ----
fn maj_kind(node_n:i32,num_n:i32,n:i32)i32 {
  if(n<2){ return 0; }
  if(2*(node_n+2*num_n)>=3*n){ return 2; }
  return 1;
}
fn h1_maj_in(A:[]u8,m:i32)i32 { return maj_kind(mg(A,m,5),mg(A,m,6),mg(A,m,9)); }
fn h1_maj_out(A:[]u8,m:i32)i32 { return maj_kind(mg(A,m,7),mg(A,m,8),mg(A,m,9)); }
// ---- world setups (frozen in PREREG Section 5) ----
fn setup_p1(A:[]u8)void {
  fact_add(A,31,81,32); fact_add(A,32,81,33); fact_add(A,33,81,34);
  fact_add(A,34,82,101); fact_add(A,34,82,102);
  fact_add(A,51,81,52); fact_add(A,52,81,53);
  fact_add(A,53,82,111); fact_add(A,53,82,112); fact_add(A,53,82,113);
  fact_add(A,41,81,42); fact_add(A,42,81,43);
  fact_add(A,63,83,64); fact_add(A,64,83,65);
  fact_add(A,73,83,74); fact_add(A,74,83,75);
  fact_add(A,43,84,1); fact_add(A,65,84,1); fact_add(A,75,84,1);
  fact_add(A,61,81,62); fact_add(A,62,81,63);
  map_new(A,0,2,81,82);
  map_new(A,1,0,83,0);
  teach(A,0,31,2); teach(A,0,51,3); teach(A,0,41,43);
  teach(A,1,63,65); teach(A,1,73,75);
  return;
}
fn setup_p2a(A:[]u8)void {
  fact_add(A,31,81,32); fact_add(A,32,81,33); fact_add(A,33,81,34);
  fact_add(A,34,82,101); fact_add(A,34,82,102);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  fact_add(A,44,82,45); fact_add(A,44,82,46);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,3,0,0); map_new(A,3,1,81,0);
  teach(A,0,31,34); teach(A,1,34,2); teach(A,2,31,31); teach(A,3,31,1);
  return;
}
fn setup_p2b(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14);
  fact_add(A,70,82,71); fact_add(A,70,82,72);
  fact_add(A,31,81,32);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  fact_add(A,44,82,45); fact_add(A,44,82,46);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,3,0,0); map_new(A,3,1,81,0);
  teach(A,0,11,14); teach(A,1,70,2); teach(A,2,31,31); teach(A,3,31,1);
  return;
}
fn setup_p3(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14); fact_add(A,14,82,141);
  fact_add(A,15,81,16); fact_add(A,16,81,17); fact_add(A,17,81,18);
  fact_add(A,18,82,181); fact_add(A,18,82,182);
  fact_add(A,50,82,51); fact_add(A,50,82,52); fact_add(A,50,82,53);
  fact_add(A,60,82,61); fact_add(A,60,82,62); fact_add(A,60,82,63); fact_add(A,60,82,64);
  fact_add(A,21,81,22);
  fact_add(A,31,81,32); fact_add(A,32,81,33); fact_add(A,33,81,34);
  fact_add(A,34,82,35); fact_add(A,34,82,36);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,3,0,0); map_new(A,3,1,81,0);
  teach(A,0,11,14); teach(A,0,15,18);
  teach(A,1,50,3); teach(A,1,60,4);
  teach(A,2,21,21); teach(A,2,21,21);
  teach(A,3,11,1); teach(A,3,15,1);
  return;
}
fn setup_p5extra(A:[]u8)void {
  fact_add(A,51,81,52); fact_add(A,52,81,53);
  fact_add(A,53,82,54); fact_add(A,53,82,55); fact_add(A,53,82,56);
  return;
}
// uc_uni.zag -- unified behavior-contract composition (frozen PREREG Sec 3).
// One admission rule, always on: kind-set compatibility over observed
// (input-kind, output-kind) contracts; empty kind-set = compatible with all.
// One execution rule: ordered trial with end-to-end verification.
// Widening: on exhaustive admitted failure, retry filter-rejected pairs once
// (triggered solely by learner-observed failure; logged as WIDEN=1).
// No flag, mode, or branch selects H1-like vs H2-like behavior.
//
// ABLATE-POINT: kind_filter_on() == 1 enables the contract filter. The
// UNI-NOKIND build flips this single line to 0; the diff is exactly that line.
fn kind_filter_on()i32 { return 1; }
fn k_has(mask:i32,k:i32)i32 {
  if(mask==0){ return 1; }
  if((mask & (1<<(k-1)))!=0){ return 1; }
  return 0;
}
fn k_inter(mx:i32,my:i32)i32 {
  if(mx==0){ return 1; }
  if(my==0){ return 1; }
  if((mx & my)!=0){ return 1; }
  return 0;
}
fn uni_admit_single(A:[]u8,m:i32,kin:i32,kout:i32)i32 {
  if(kind_filter_on()==0){ return 1; }
  let a:i32=k_has(mg(A,m,3),kin);
  let b:i32=k_has(mg(A,m,4),kout);
  if(a==1 && b==1){ return 1; }
  return 0;
}
fn uni_admit_pair(A:[]u8,x:i32,y:i32,kin:i32,kout:i32)i32 {
  if(kind_filter_on()==0){ return 1; }
  let a:i32=k_has(mg(A,x,3),kin);
  let d:i32=k_inter(mg(A,x,4),mg(A,y,3));
  let b:i32=k_has(mg(A,y,4),kout);
  if(a==1 && d==1 && b==1){ return 1; }
  return 0;
}
fn uni_try_pair(A:[]u8,B:[]u8,c:i32,x:i32,y:i32,s:i32,exp:i32)i32 {
  ap(A,936,ag(A,936)+1);
  let v1:i32=exec_map(A,x,s);
  c=o_app(B,c,"INTER="); c=o_i64(B,c,v1 as i64); c=o_nl(B,c);
  if(v1>=0){
    let v2:i32=exec_map(A,y,v1);
    if(v2==exp){
      observe(A,x,s,v1); observe(A,y,v1,v2);
      ap(A,944,v2); ap(A,940,1);
    }
  }
  return c;
}
fn uni_solve(A:[]u8,B:[]u8,c:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32)i32 {
  ap(A,936,0); ap(A,940,0); ap(A,944,-2);
  let a:i32=0;
  while(a<nm){
    if(uni_admit_single(A,a,kin,kout)==1){
      ap(A,936,ag(A,936)+1);
      let v:i32=exec_map(A,a,s);
      if(v==exp){ observe(A,a,s,v); ap(A,944,v); return c; }
    }
    a=a+1;
  }
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && uni_admit_pair(A,x,y,kin,kout)==1){
        c=uni_try_pair(A,B,c,x,y,s,exp);
        if(ag(A,940)==1){ return c; }
      }
      y=y+1;
    }
    x=x+1;
  }
  if(kind_filter_on()==1){
    c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
    let x2:i32=0;
    while(x2<nm){
      let y2:i32=0;
      while(y2<nm){
        if(x2!=y2 && uni_admit_pair(A,x2,y2,kin,kout)==0){
          c=uni_try_pair(A,B,c,x2,y2,s,exp);
          if(ag(A,940)==1){ return c; }
        }
        y2=y2+1;
      }
      x2=x2+1;
    }
  }
  return c;
}
fn uni_report(A:[]u8,B:[]u8,c:i32,arm:[]u8,prob:[]u8)i32 {
  c=o_app(B,c,"ARM="); c=o_app(B,c,arm); c=o_app(B,c," PROB="); c=o_app(B,c,prob);
  c=o_app(B,c," ANS="); c=o_i64(B,c,ag(A,944) as i64);
  c=o_app(B,c," TRIES="); c=o_i64(B,c,ag(A,936) as i64); c=o_nl(B,c);
  return c;
}
fn uni_census(A:[]u8,B:[]u8,c:i32,nm:i32)i32 {
  let m:i32=0;
  while(m<nm){
    c=o_app(B,c,"CENSUS m="); c=o_i64(B,c,m as i64);
    c=o_app(B,c," inmask="); c=o_i64(B,c,mg(A,m,3) as i64);
    c=o_app(B,c," outmask="); c=o_i64(B,c,mg(A,m,4) as i64);
    c=o_app(B,c," n="); c=o_i64(B,c,mg(A,m,9) as i64);
    c=o_nl(B,c);
    m=m+1;
  }
  return c;
}
// gc_uni.zag -- sequence-trial generalization of U (GEN-CYCLES lane).
// Generalizes U's ordered trial {singles, ordered pairs x!=y, each applied
// once} to trial over re-applicable structure sequences with halting.
//
// A sequence [m1..mk] (k>=1; repetitions allowed for k>=3) is admitted by
// the chain kind rule (Section: gc_admit_seq), then executed stepwise.
// After each step a halting condition is checked, expressed in the existing
// contract vocabulary: output==input (the fixpoint signal; available
// because the STEP-at-fixpoint identity is taught) or the step cap.
// End-to-end verification (halted value == expected) is retained; on
// success every step is recorded via observe (generalizing U's pair
// recording). One sequence trial counts one TRIES increment, as U counts
// one try per pair.
//
// Pipelines are the special case: k<=2 with halt-after-one-pass is U
// (gc_solve with seqmax<=2 executes exactly uni_solve's code path).
// The executor below is uniform over all sequences: the halting checks
// run after every step of every trial. There is no branch on repetition,
// on MAP identity, or on any shape predicate.
//
// Arena scratch beyond U's layout: 968: V history, 9 x 4 bytes
// (V[0]=start subject, V[i]=value after step i). Zeroed by world_new.

// Chain admission. Subsumes U's rules: k=1 is uni_admit_single,
// k=2 is uni_admit_pair (same k_has/k_inter calls in the same order).
fn gc_admit_seq(A:[]u8,S:[]u8,k:i32,kin:i32,kout:i32)i32 {
  if(kind_filter_on()==0){ return 1; }
  if(k_has(mg(A,S[0] as i32,3),kin)==0){ return 0; }
  let i:i32=0;
  while(i<k-1){
    if(k_inter(mg(A,S[i] as i32,4),mg(A,S[i+1] as i32,3))==0){ return 0; }
    i=i+1;
  }
  if(k_has(mg(A,S[k-1] as i32,4),kout)==0){ return 0; }
  return 1;
}
// Stepwise execution with halting. Prints one INTER= per step.
// Returns cursor c. Sets found/ans and records each step on success.
fn gc_try_seq(A:[]u8,B:[]u8,c:i32,S:[]u8,k:i32,s:i32,exp:i32,cap:i32)i32 {
  ap(A,936,ag(A,936)+1);
  set32(A,968,s);
  let cur:i32=s;
  let i:i32=0;
  while(i<k){
    let m:i32=S[i] as i32;
    let prev:i32=cur;
    let v:i32=exec_map(A,m,cur);
    c=o_app(B,c,"INTER="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
    if(v<0){ return c; }
    set32(A,968+(i+1)*4,v);
    cur=v;
    i=i+1;
    if(v==prev){ break; }
    if(i>=cap){ break; }
  }
  if(cur==exp){
    let j:i32=0;
    while(j<i){
      observe(A,S[j] as i32,get32(A,968+j*4),get32(A,968+(j+1)*4));
      j=j+1;
    }
    ap(A,944,cur); ap(A,940,1);
  }
  return c;
}
// Enumerate all nm^k sequences lexicographically (position 0 slowest).
// widen=0: try admitted; widen=1: try rejected (one retry each).
fn gc_run_len(A:[]u8,B:[]u8,c:i32,k:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32,cap:i32,widen:i32)i32 {
  let total:i32=1;
  let t:i32=0;
  while(t<k){ total=total*nm; t=t+1; }
  let S:[]u8=z_alloc(8);
  let n:i32=0;
  while(n<total){
    let tmp:i32=n;
    let i:i32=k-1;
    while(i>=0){
      S[i]=(tmp%nm) as u8;
      tmp=tmp/nm;
      i=i-1;
    }
    let ad:i32=gc_admit_seq(A,S,k,kin,kout);
    if(widen==0 && ad==1){
      c=gc_try_seq(A,B,c,S,k,s,exp,cap);
      if(ag(A,940)==1){ return c; }
    }
    if(widen==1 && ad==0){
      c=gc_try_seq(A,B,c,S,k,s,exp,cap);
      if(ag(A,940)==1){ return c; }
    }
    n=n+1;
  }
  return c;
}
// Generalized solve: frozen uni_solve (U's prefix) then sequence phases.
// With seqmax<=2 the sequence block is skipped: exactly uni_solve.
fn gc_solve(A:[]u8,B:[]u8,c:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32,seqmax:i32,cap:i32)i32 {
  c=uni_solve(A,B,c,s,kin,kout,exp,nm);
  if(ag(A,940)==1){ return c; }
  if(seqmax>=3){
    let k:i32=3;
    while(k<=seqmax){
      c=gc_run_len(A,B,c,k,s,kin,kout,exp,nm,cap,0);
      if(ag(A,940)==1){ return c; }
      k=k+1;
    }
    if(kind_filter_on()==1){
      c=o_app(B,c,"WIDEN=2"); c=o_nl(B,c);
      let k2:i32=3;
      while(k2<=seqmax){
        c=gc_run_len(A,B,c,k2,s,kin,kout,exp,nm,cap,1);
        if(ag(A,940)==1){ return c; }
        k2=k2+1;
      }
    }
  }
  return c;
}
// cyc_new.zag -- cycle workload driver (frozen PREREG Section 5).
// Poses the fixpoint-iteration workload purely as data (facts + MAPs +
// teach observations) plus ONE uni_solve query. No iteration, no
// fixpoint check, no direct structure-application call in this file
// (C5 audit).
// All identifiers are opaque integers (C6 audit).
fn setup_cyc(A:[]u8)void {
  fact_add(A,1001,201,1002);
  fact_add(A,1002,201,1003);
  fact_add(A,1003,201,1004);
  fact_add(A,1004,201,1005);
  fact_add(A,1001,202,1101); fact_add(A,1001,202,1102);
  fact_add(A,1002,202,1103);
  fact_add(A,1003,202,1104); fact_add(A,1003,202,1105); fact_add(A,1003,202,1106);
  fact_add(A,1004,202,1107);
  fact_add(A,1005,202,1108); fact_add(A,1005,202,1109);
  fact_add(A,1101,203,1102);
  fact_add(A,1201,204,1202); fact_add(A,1201,204,1203);
  map_new(A,0,4,201,0);
  map_new(A,1,1,202,0);
  map_new(A,2,3,0,0);
  map_new(A,3,1,204,0);
  teach(A,0,1001,1002); teach(A,0,1002,1003); teach(A,0,1003,1004);
  teach(A,0,1004,1005); teach(A,0,1005,1005);
  teach(A,1,1001,2); teach(A,1,1002,1); teach(A,1,1003,3);
  teach(A,1,1004,1); teach(A,1,1005,2);
  teach(A,2,1101,1101);
  teach(A,3,1201,2);
  return;
}
// cg_setups.zag -- CYCLES-GENERALIZE workload setups (frozen after prereg).
// Three workloads, all identifiers opaque integers. No iteration, no
// fixpoint check, no direct structure-application call in this file:
// each setup poses facts + MAPs + teach observations plus ONE solve
// query issued by the driver main.
//
// setup_qg (T1): alternating two-structure fixpoint chain. 5 hops over
// two STEP MAPs on rels 301/302; 3006 is the fixpoint for both.
// setup_qh (T2): 1-hop chain engineered so the chain rule rejects the
// pure repetition but admits a longer sequence whose winning trial
// halts via output==input at i<k.
// setup_qk (T3): 1-hop chain with a class-5 STEP-HALT MAP that emits
// the HALT-kind signal (-3) at fixpoint instead of identity.
fn setup_qg(A:[]u8)void {
  fact_add(A,3001,301,3002);
  fact_add(A,3002,302,3003);
  fact_add(A,3003,301,3004);
  fact_add(A,3004,302,3005);
  fact_add(A,3005,301,3006);
  fact_add(A,3101,305,3102);
  fact_add(A,3201,306,3202); fact_add(A,3201,306,3203);
  map_new(A,0,4,301,0);
  map_new(A,1,4,302,0);
  map_new(A,2,3,0,0);
  map_new(A,3,1,306,0);
  teach(A,0,3001,3002); teach(A,0,3003,3004);
  teach(A,0,3005,3006); teach(A,0,3006,3006);
  teach(A,1,3002,3003); teach(A,1,3004,3005); teach(A,1,3006,3006);
  teach(A,2,3101,3101);
  teach(A,3,3201,2);
  return;
}
fn setup_qh(A:[]u8)void {
  fact_add(A,4001,401,4002);
  fact_add(A,4101,402,9101);
  fact_add(A,1,409,2);
  fact_add(A,4101,403,9101);
  fact_add(A,4201,404,9201); fact_add(A,4201,404,9202);
  map_new(A,0,4,401,0);
  map_new(A,1,1,402,0);
  map_new(A,2,1,403,0);
  map_new(A,3,1,404,0);
  teach(A,0,4001,4002); teach(A,0,4002,4002);
  teach(A,1,4101,1); teach(A,1,555,-2);
  teach(A,2,4101,1);
  teach(A,3,4201,2);
  return;
}
fn setup_qk(A:[]u8)void {
  fact_add(A,5001,501,5002);
  fact_add(A,5101,502,9101);
  fact_add(A,1,509,2);
  fact_add(A,5101,503,9101);
  fact_add(A,5201,504,9201); fact_add(A,5201,504,9202);
  map_new(A,0,5,501,0);
  map_new(A,1,1,502,0);
  map_new(A,2,1,503,0);
  map_new(A,3,1,504,0);
  teach(A,0,5001,5002); teach(A,0,5002,-3);
  teach(A,1,5101,1); teach(A,1,555,-2);
  teach(A,2,5101,1);
  teach(A,3,5201,2);
  return;
}
// cg_main_red.zag -- CYCLES-GENERALIZE reduction/main driver.
// Runs the C403 regression (QC), T1 alternating family (QG), and T2
// data-dependent halting (QH). Assembled once with frozen gc_uni.zag
// (cg_fbin) and once with extended cg_uni.zag + frozen gc_base.zag
// (cg_xbin); G7 requires byte-identical stdout.
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=world_new();
  setup_cyc(A);
  c=gc_solve(A,B,c,1001,1,1,1005,4,8,8);
  c=uni_report(A,B,c,"GC","QC");
  c=uni_census(A,B,c,4);
  let A1:[]u8=world_new();
  setup_qg(A1);
  c=gc_solve(A1,B,c,3001,1,1,3006,4,8,8);
  c=uni_report(A1,B,c,"GC","QG");
  c=uni_census(A1,B,c,4);
  let A2:[]u8=world_new();
  setup_qh(A2);
  c=gc_solve(A2,B,c,4001,1,1,4002,4,8,8);
  c=uni_report(A2,B,c,"GC","QH");
  c=uni_census(A2,B,c,4);
  o_flush(B,c);
  return 0;
}

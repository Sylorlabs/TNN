// cg_main_ksig.zag -- T3 signal driver (extended executor + extended base).
// The class-5 STEP-HALT MAP emits the HALT-kind signal (-3) at fixpoint;
// the extended executor halts the winning trial on it.
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=world_new();
  setup_qk(A);
  c=gc_solve(A,B,c,5001,1,1,5002,4,8,8);
  c=uni_report(A,B,c,"XH","QK");
  c=uni_census(A,B,c,4);
  o_flush(B,c);
  return 0;
}

// ts_h2.zag -- Cross-domain L2: TRUNCATE and SPECIALIZE adaptation (H2).
//
// World, arms, and kill bars are frozen in PREREG.md (committed before any
// implementation). Mechanism logic follows the xdomain_l2 H2 lineage:
// ordered mode pairs, value passing between stages, capability evidence
// via has_behav. New: stage 1 writes a shared sequence buffer that stage 2
// reads; the generic TRUNCATE and SPECIALIZE operators apply to the stage
// 1 output; exhaustive Phase 2 try-and-validate over both operators.
// Under test: whether the LEARNER selects the correct operator and
// parameter per sealed goal, not behavior induction (modes are installed
// as prior learning).
//
// Modes: World-T uses 1=SWEEP, 2=PLAN3, 3=RISK3; World-S uses 1=SWEEP,
// 4=TOTAL. These are the inherited H2 mechanism vocabulary (capability
// slots), not new cognitive modes.
//
// Pure Zag. u8-backed workspace, little-endian cell helpers.
// 0 new modes, 0 bridges, 0 handlers, 0 new semantic cases.
// Output uses the single-buffer e1str/e1i64 cursor pattern plus one
// _zag_raw_syscall write at the end. No _zag_print for dynamic content.

// ---------- prelude: alloc, cells, safe output ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ---------- workspace ----------
// header: 0 nmaps, 4 comp_m1, 8 comp_m2, 12 comp_op, 16 out_cur,
//         20 arm_verdict, 24 succ_count, 28 comp_param, 32 seqlen, 36 world
// facts: base 64, 40 entries x 16 bytes (used,subj,rel,obj)
// maps: base 704, 8 entries x 8 bytes (used,behav)
// candidates: base 768, 8 entries x 4 bytes
// seqbuf: base 800, 8 entries x 4 bytes
fn vc_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,0); put32(W,8,0); put32(W,12,0); put32(W,20,0);
  put32(W,24,0); put32(W,28,-1); put32(W,32,0); put32(W,36,0);
  return;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=ig(W,16);
  cur=e1str(OUT,cur,s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=ig(W,16);
  cur=e1i64(OUT,cur,v as i64);
  put32(W,16,cur);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==0){
      put32(W,64+i*16,1); put32(W,64+i*16+4,s);
      put32(W,64+i*16+8,r); put32(W,64+i*16+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn facts_train(W:[]u8)void {
  add_fact(W,101,61,2); add_fact(W,101,61,4); add_fact(W,101,61,6);
  add_fact(W,101,61,8); add_fact(W,101,61,10);
  add_fact(W,102,61,1); add_fact(W,102,61,3); add_fact(W,102,61,5);
  add_fact(W,102,61,7); add_fact(W,102,61,9);
  add_fact(W,201,61,2); add_fact(W,201,61,4); add_fact(W,201,61,6);
  add_fact(W,202,61,1); add_fact(W,202,61,3); add_fact(W,202,61,5);
  return;
}
fn facts_t(W:[]u8)void {
  facts_train(W);
  add_fact(W,103,61,3); add_fact(W,103,61,1); add_fact(W,103,61,4);
  add_fact(W,103,61,1); add_fact(W,103,61,5);
  return;
}
fn facts_s(W:[]u8)void {
  facts_train(W);
  add_fact(W,104,61,2); add_fact(W,104,61,7); add_fact(W,104,61,3);
  add_fact(W,104,61,8); add_fact(W,104,61,4);
  return;
}
// Discover the relation from the query subject's facts. Generic.
fn subj_rel(W:[]u8,s:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==s){ return ig(W,64+i*16+8); }
    i=i+1;
  }
  return -1;
}
fn sweep_raw(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==s && ig(W,64+i*16+8)==r){
      if(n<5){ put32(W,800+n*4,ig(W,64+i*16+12)); }
      n=n+1;
    }
    i=i+1;
  }
  if(n>5){ n=5; }
  put32(W,32,n);
  return n;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  put32(W,704+m*8,1); put32(W,704+m*8+4,behav);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,704+m*8,0); return; }
fn has_behav(W:[]u8,bh:i32)i32 {
  let m:i32=0;
  while(m<8){
    if(ig(W,704+m*8)==1 && ig(W,704+m*8+4)==bh){ return 1; }
    m=m+1;
  }
  return 0;
}
// Stage executors. Stage 1 (SWEEP) writes the shared sequence buffer and
// returns the count; the adaptation operator (op 0=none, 1=TRUNCATE,
// 2=SPECIALIZE) applies to the stage 1 output. Stage 2 modes read the
// buffer (value passing between stages). Each mode requires its learned
// behavior as capability evidence.
fn vc_stage(W:[]u8,mode:i32,subj:i32,rel:i32,op:i32,param:i32)i32 {
  if(mode==1){
    if(has_behav(W,0)==0){ return -2; }
    let n:i32=sweep_raw(W,subj,rel);
    if(op==1){
      if(param<n){ n=param; }
      put32(W,32,n);
    }
    if(op==2){
      let w:i32=0;
      let j:i32=0;
      while(j<n){
        let v:i32=ig(W,800+j*4);
        if(v>=param){ put32(W,800+w*4,v); w=w+1; }
        j=j+1;
      }
      n=w;
      put32(W,32,n);
    }
    return n;
  }
  if(mode==2){
    if(has_behav(W,1)==0){ return -2; }
    if(ig(W,32)!=3){ return -3; }
    return ig(W,800)+ig(W,800+4)+ig(W,800+8);
  }
  if(mode==3){
    if(has_behav(W,2)==0){ return -2; }
    if(ig(W,32)!=3){ return -3; }
    return ig(W,800)*ig(W,800+4)*ig(W,800+8);
  }
  if(mode==4){
    if(has_behav(W,3)==0){ return -2; }
    let s:i32=0;
    let j:i32=0;
    let n:i32=ig(W,32);
    while(j<n){ s=s+ig(W,800+j*4); j=j+1; }
    return s;
  }
  return -2;
}
// Generic candidate scan: distinct values v with a fact (s,r,*),
// first-seen order. Contains no domain knowledge.
fn scan_values(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==s && ig(W,64+i*16+8)==r){
      let v:i32=ig(W,64+i*16+12);
      let seen:i32=0;
      let k:i32=0;
      while(k<n){
        if(ig(W,768+k*4)==v){ seen=1; }
        k=k+1;
      }
      if(seen==0 && n<8){
        put32(W,768+n*4,v);
        n=n+1;
      }
    }
    i=i+1;
  }
  return n;
}
fn nmodes(world:i32)i32 {
  if(world==0){ return 3; }
  return 2;
}
fn mode_at(world:i32,i:i32)i32 {
  if(world==0){ return i; }
  if(i==1){ return 1; }
  return 4;
}
fn teach_t(W:[]u8,OUT:[]u8)void {
  let x:i32=map_new(W,0);
  let y:i32=map_new(W,1);
  let d:i32=map_new(W,2);
  eS(W,OUT,"TEACH X id="); eN(W,OUT,x);
  eS(W,OUT," Y1 id="); eN(W,OUT,y);
  eS(W,OUT," D id="); eN(W,OUT,d); eS(W,OUT,"\n");
  return;
}
fn teach_s(W:[]u8,OUT:[]u8)void {
  let x:i32=map_new(W,0);
  let y:i32=map_new(W,3);
  eS(W,OUT,"TEACH X id="); eN(W,OUT,x);
  eS(W,OUT," Y2 id="); eN(W,OUT,y); eS(W,OUT,"\n");
  return;
}
// Try one ordered pair under one adaptation. Records the composite on
// goal match. Exhaustive: never stops early; the arm verdict requires
// exactly the predicted single success.
fn vc_try_pair(W:[]u8,OUT:[]u8,m1:i32,m2:i32,s:i32,rel:i32,op:i32,param:i32,expected:i32)void {
  let v1:i32=vc_stage(W,m1,s,rel,op,param);
  if(v1<0){ return; }
  eS(W,OUT,"VC-STAGE1 m="); eN(W,OUT,m1); eS(W,OUT," op="); eN(W,OUT,op);
  eS(W,OUT," param="); eN(W,OUT,param); eS(W,OUT," v1="); eN(W,OUT,v1); eS(W,OUT,"\n");
  let v2:i32=vc_stage(W,m2,0,rel,0,0);
  if(v2<0){ return; }
  eS(W,OUT,"VC-STAGE2 m="); eN(W,OUT,m2); eS(W,OUT," v2="); eN(W,OUT,v2); eS(W,OUT,"\n");
  if(v2==expected){
    put32(W,24,ig(W,24)+1);
    if(ig(W,24)==1){
      put32(W,4,m1); put32(W,8,m2); put32(W,12,op); put32(W,28,param);
      eS(W,OUT,"VC-COMPOSE ok m1="); eN(W,OUT,m1);
      eS(W,OUT," m2="); eN(W,OUT,m2);
      eS(W,OUT," op="); eN(W,OUT,op);
      eS(W,OUT," param="); eN(W,OUT,param); eS(W,OUT,"\n");
    }
  }
  return;
}
// Two-phase value composition. Phase 1 is exact L1 reuse (op=0).
// Phase 2 (l2_on=1) retries stage 1 under each adaptation: SPECIALIZE
// over every candidate threshold from the generic scan, then TRUNCATE
// over every candidate length. Fixed operator order (SPECIALIZE before
// TRUNCATE); selection is proven by exhaustive try-and-reject.
fn vc_compose_l2(W:[]u8,OUT:[]u8,s:i32,expected:i32,world:i32,l2_on:i32)void {
  let rel:i32=subj_rel(W,s);
  put32(W,36,world);
  eS(W,OUT,"PHASE1 L1 rel="); eN(W,OUT,rel); eS(W,OUT,"\n");
  let m1:i32=1;
  while(m1<=nmodes(world)){
    let m2:i32=1;
    while(m2<=nmodes(world)){
      vc_try_pair(W,OUT,mode_at(world,m1),mode_at(world,m2),s,rel,0,0,expected);
      m2=m2+1;
    }
    m1=m1+1;
  }
  if(ig(W,24)==0){ eS(W,OUT,"L1-FAIL\n"); }
  if(ig(W,24)!=0 || l2_on==0){ return; }
  eS(W,OUT,"PHASE2 L2:\n");
  let len:i32=vc_stage(W,1,s,rel,0,0);
  eS(W,OUT,"SWEEP-LEN "); eN(W,OUT,len); eS(W,OUT,"\n");
  if(len<0){ eS(W,OUT,"L2-FAIL\n"); return; }
  let nc:i32=scan_values(W,s,rel);
  eS(W,OUT,"SPEC-CANDS n="); eN(W,OUT,nc);
  let ck:i32=0;
  while(ck<nc){
    eS(W,OUT," "); eN(W,OUT,ig(W,768+ck*4));
    ck=ck+1;
  }
  eS(W,OUT,"\n");
  let o:i32=2;
  while(o>=1){
    if(o==2){
      let ci:i32=0;
      while(ci<nc){
        let t:i32=ig(W,768+ci*4);
        eS(W,OUT,"SPEC-TRY T="); eN(W,OUT,t); eS(W,OUT,"\n");
        let mi:i32=1;
        while(mi<=nmodes(world)){
          vc_try_pair(W,OUT,1,mode_at(world,mi),s,rel,2,t,expected);
          mi=mi+1;
        }
        ci=ci+1;
      }
    }
    if(o==1){
      let k:i32=1;
      while(k<len){
        eS(W,OUT,"TRUNC-TRY k="); eN(W,OUT,k); eS(W,OUT,"\n");
        let mj:i32=1;
        while(mj<=nmodes(world)){
          vc_try_pair(W,OUT,1,mode_at(world,mj),s,rel,1,k,expected);
          mj=mj+1;
        }
        k=k+1;
      }
    }
    o=o-1;
  }
  if(ig(W,24)==0){ eS(W,OUT,"L2-FAIL\n"); }
  return;
}
fn arm_pass(W:[]u8,OUT:[]u8,ok:i32)void {
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  return;
}
fn arm_expect_fail(W:[]u8,OUT:[]u8)void {
  if(ig(W,24)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
// World-T arms: Z-T = (103,93) -> 8 needs TRUNCATE k=3, m1=1, m2=2.
fn arm_treat_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-T ===\n");
  facts_t(W); teach_t(W,OUT);
  vc_compose_l2(W,OUT,103,8,0,1);
  let ok:i32=0;
  if(ig(W,24)==1 && ig(W,4)==1 && ig(W,8)==2 && ig(W,12)==1 && ig(W,28)==3){ ok=1; }
  arm_pass(W,OUT,ok);
  return;
}
fn arm_l1_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY-T ===\n");
  facts_t(W); teach_t(W,OUT);
  vc_compose_l2(W,OUT,103,8,0,0);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ablx_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X-T ===\n");
  facts_t(W); teach_t(W,OUT);
  del_map(W,0);
  vc_compose_l2(W,OUT,103,8,0,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ably_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y-T ===\n");
  facts_t(W); teach_t(W,OUT);
  del_map(W,1);
  vc_compose_l2(W,OUT,103,8,0,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_fresh_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH-T ===\n");
  facts_t(W);
  vc_compose_l2(W,OUT,103,8,0,1);
  arm_expect_fail(W,OUT);
  return;
}
// World-S arms: Z-S = (104,94) -> 15 needs SPECIALIZE T=7, m1=1, m2=4.
fn arm_treat_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-S ===\n");
  facts_s(W); teach_s(W,OUT);
  vc_compose_l2(W,OUT,104,15,1,1);
  let ok:i32=0;
  if(ig(W,24)==1 && ig(W,4)==1 && ig(W,8)==4 && ig(W,12)==2 && ig(W,28)==7){ ok=1; }
  arm_pass(W,OUT,ok);
  return;
}
fn arm_l1_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY-S ===\n");
  facts_s(W); teach_s(W,OUT);
  vc_compose_l2(W,OUT,104,15,1,0);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ablx_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X-S ===\n");
  facts_s(W); teach_s(W,OUT);
  del_map(W,0);
  vc_compose_l2(W,OUT,104,15,1,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ably_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-Y-S ===\n");
  facts_s(W); teach_s(W,OUT);
  del_map(W,1);
  vc_compose_l2(W,OUT,104,15,1,1);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_fresh_s(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== FRESH-S ===\n");
  facts_s(W);
  vc_compose_l2(W,OUT,104,15,1,1);
  arm_expect_fail(W,OUT);
  return;
}
fn run_arm(W:[]u8,OUT:[]u8,idx:i32,cur:i32)i32 {
  vc_init(W);
  put32(W,16,cur);
  if(idx==0){ arm_treat_t(W,OUT); }
  if(idx==1){ arm_l1_t(W,OUT); }
  if(idx==2){ arm_ablx_t(W,OUT); }
  if(idx==3){ arm_ably_t(W,OUT); }
  if(idx==4){ arm_fresh_t(W,OUT); }
  if(idx==5){ arm_treat_s(W,OUT); }
  if(idx==6){ arm_l1_s(W,OUT); }
  if(idx==7){ arm_ablx_s(W,OUT); }
  if(idx==8){ arm_ably_s(W,OUT); }
  if(idx==9){ arm_fresh_s(W,OUT); }
  return ig(W,20);
}
fn main()i32 {
  let OUT:[]u8=z_alloc(131072);
  let cur:i32=0;
  cur=e1str(OUT,cur,"TS-H2-START\n");
  let tot:i32=0;
  let idx:i32=0;
  while(idx<10){
    let W:[]u8=z_alloc(8192);
    tot=tot+run_arm(W,OUT,idx,cur);
    cur=ig(W,16);
    idx=idx+1;
  }
  cur=e1str(OUT,cur,"TOTAL ");
  cur=e1i64(OUT,cur,tot as i64);
  cur=e1str(OUT,cur,"/10\n");
  cur=e1str(OUT,cur,"TS-H2-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){ return 0; }
  return 1;
}

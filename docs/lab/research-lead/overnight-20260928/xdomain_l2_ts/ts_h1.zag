// ts_h1.zag -- Cross-domain L2: TRUNCATE and SPECIALIZE adaptation (H1).
//
// World, arms, and kill bars are frozen in PREREG.md (committed before any
// implementation). Mechanism logic follows the xdomain_l2 H1 lineage:
// learned typed contracts filter composition, two-phase solver (L1 exact,
// L2 adaptation). New: sequence kinds (SEQk, SEQANY), the
// SWEEP/PLAN3/RISK3/TOTAL behaviors, and the generic TRUNCATE and
// SPECIALIZE operators with exhaustive Phase 2 try-and-validate.
// Under test: whether the LEARNER selects the correct operator and
// parameter per sealed goal, not behavior induction (behaviors are
// installed as prior learning).
//
// Pure Zag. u8-backed workspace, little-endian cell helpers.
// 0 new modes, 0 bridges, 0 handlers, 0 new semantic cases.
// Output uses the single-buffer e1str/e1i64 cursor pattern plus one
// _zag_raw_syscall write at the end. No _zag_print for dynamic content.

// ---------- prelude: alloc, cells, safe output ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ---------- workspace ----------
// header: 0 nmaps, 4 comp_z, 8 solved, 12 tries, 16 out_cur,
//         20 arm_verdict, 24 succ_count, 28 succ_op, 32 succ_param,
//         36 succ_b, 40 world, 44 seqlen
// facts: base 64, 40 entries x 16 bytes (used,subj,rel,obj)
// maps: base 704, 16 entries x 64 bytes
//   (used,behav,param,sig_in,sig_out,comp_a,comp_b,adapt_of,adapt_op,adapt_param)
// candidates: base 1728, 8 entries x 4 bytes
// seqbuf: base 1760, 8 entries x 4 bytes
fn ts_init(W:[]u8)void {
  put32(W,0,0); put32(W,4,-1); put32(W,8,0); put32(W,12,0); put32(W,20,0);
  put32(W,24,0); put32(W,28,0); put32(W,32,-1); put32(W,36,-1); put32(W,44,0);
  return;
}
fn eS(W:[]u8,OUT:[]u8,s:[]u8)void {
  let cur:i32=ig(W,16);
  cur=e1str(OUT,cur,s);
  put32(W,16,cur);
  return;
}
fn eN(W:[]u8,OUT:[]u8,v:i32)void {
  let cur:i32=ig(W,16);
  cur=e1i64(OUT,cur,v as i64);
  put32(W,16,cur);
  return;
}
fn add_fact(W:[]u8,s:i32,r:i32,o:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==0){
      put32(W,64+i*16,1); put32(W,64+i*16+4,s);
      put32(W,64+i*16+8,r); put32(W,64+i*16+12,o);
      return;
    }
    i=i+1;
  }
  return;
}
fn facts_train(W:[]u8)void {
  add_fact(W,101,61,2); add_fact(W,101,61,4); add_fact(W,101,61,6);
  add_fact(W,101,61,8); add_fact(W,101,61,10);
  add_fact(W,102,61,1); add_fact(W,102,61,3); add_fact(W,102,61,5);
  add_fact(W,102,61,7); add_fact(W,102,61,9);
  add_fact(W,201,61,2); add_fact(W,201,61,4); add_fact(W,201,61,6);
  add_fact(W,202,61,1); add_fact(W,202,61,3); add_fact(W,202,61,5);
  return;
}
fn facts_t(W:[]u8)void {
  facts_train(W);
  add_fact(W,103,61,3); add_fact(W,103,61,1); add_fact(W,103,61,4);
  add_fact(W,103,61,1); add_fact(W,103,61,5);
  return;
}
fn facts_s(W:[]u8)void {
  facts_train(W);
  add_fact(W,104,61,2); add_fact(W,104,61,7); add_fact(W,104,61,3);
  add_fact(W,104,61,8); add_fact(W,104,61,4);
  return;
}
// Raw sweep: collect (s,r,*) values in first-seen order into seqbuf,
// hardware cap 5. Returns the count; sets seqlen.
fn sweep_raw(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==s && ig(W,64+i*16+8)==r){
      if(n<5){ put32(W,1760+n*4,ig(W,64+i*16+12)); }
      n=n+1;
    }
    i=i+1;
  }
  if(n>5){ n=5; }
  put32(W,44,n);
  return n;
}
// kind probe: 1=NODE iff v appears as a fact subject, else 2=NUM.
fn probe_kind(W:[]u8,v:i32)i32 {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==v){ return 1; }
    i=i+1;
  }
  return 2;
}
// Declared signature learning rule: consistent observed length L gives
// SEQ L (kind 10+L); varying observed lengths give SEQANY (kind 20).
fn seq_kind_two(l1:i32,l2:i32)i32 {
  if(l1==l2 && l1>=1 && l1<=5){ return 10+l1; }
  return 20;
}
// Contract compatibility: exact match, or SEQANY on either side against
// a fixed SEQk on the other (optimistic; runtime checks still apply).
fn compat(ok:i32,ik:i32)i32 {
  if(ok==ik){ return 1; }
  if(ik==20 && ok>=11 && ok<=15){ return 1; }
  if(ok==20 && ik>=11 && ik<=15){ return 1; }
  return 0;
}
fn map_new(W:[]u8,behav:i32)i32 {
  let m:i32=ig(W,0);
  put32(W,0,m+1);
  let b:i32=704+m*64;
  put32(W,b,1); put32(W,b+4,behav); put32(W,b+8,-1);
  put32(W,b+12,0); put32(W,b+16,0);
  put32(W,b+20,-1); put32(W,b+24,-1);
  put32(W,b+28,-1); put32(W,b+32,0); put32(W,b+36,-1);
  put32(W,b+40,0); put32(W,b+44,0); put32(W,b+48,0); put32(W,b+52,0);
  put32(W,b+56,0); put32(W,b+60,0);
  return m;
}
fn del_map(W:[]u8,m:i32)void { put32(W,704+m*64,0); return; }
fn bind_param(W:[]u8,m:i32,subj:i32)void {
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==subj){
      put32(W,704+m*64+8,ig(W,64+i*16+8));
      return;
    }
    i=i+1;
  }
  return;
}
fn exec_map(W:[]u8,m:i32,v:i32)i32 {
  let b:i32=704+m*64;
  let bh:i32=ig(W,b+4);
  if(bh==0){
    let cnt:i32=sweep_raw(W,v,ig(W,b+8));
    let aop:i32=ig(W,b+32);
    if(aop==1){
      let k:i32=ig(W,b+36);
      if(k<cnt){ cnt=k; }
      put32(W,44,cnt);
    }
    if(aop==2){
      let t:i32=ig(W,b+36);
      let w:i32=0;
      let j:i32=0;
      while(j<cnt){
        let vv:i32=ig(W,1760+j*4);
        if(vv>=t){ put32(W,1760+w*4,vv); w=w+1; }
        j=j+1;
      }
      cnt=w;
      put32(W,44,cnt);
    }
    return cnt;
  }
  if(bh==1){
    if(ig(W,44)!=3){ return -999; }
    return ig(W,1760)+ig(W,1760+4)+ig(W,1760+8);
  }
  if(bh==2){
    if(ig(W,44)!=3){ return -999; }
    return ig(W,1760)*ig(W,1760+4)*ig(W,1760+8);
  }
  if(bh==3){
    let s:i32=0;
    let j:i32=0;
    let n:i32=ig(W,44);
    while(j<n){ s=s+ig(W,1760+j*4); j=j+1; }
    return s;
  }
  let a:i32=ig(W,b+20);
  let c:i32=ig(W,b+24);
  let mid:i32=exec_map(W,a,v);
  return exec_map(W,c,mid);
}
// Generic TRUNCATE operator: copy the MAP, keep the first k elements,
// contract becomes SEQk, record truncate_of provenance. No domain knowledge.
fn truncate_map(W:[]u8,m:i32,k:i32)i32 {
  let nm:i32=map_new(W,ig(W,704+m*64+4));
  let nb:i32=704+nm*64;
  let ob:i32=704+m*64;
  put32(W,nb+8,ig(W,ob+8));
  put32(W,nb+12,ig(W,ob+12));
  put32(W,nb+16,10+k);
  put32(W,nb+28,m);
  put32(W,nb+32,1);
  put32(W,nb+36,k);
  return nm;
}
// Generic SPECIALIZE operator: copy the MAP, keep elements >= T,
// contract becomes SEQANY (length unknown until runtime), record
// specialize_of provenance. No domain knowledge.
fn specialize_map(W:[]u8,m:i32,t:i32)i32 {
  let nm:i32=map_new(W,ig(W,704+m*64+4));
  let nb:i32=704+nm*64;
  let ob:i32=704+m*64;
  put32(W,nb+8,ig(W,ob+8));
  put32(W,nb+12,ig(W,ob+12));
  put32(W,nb+16,20);
  put32(W,nb+28,m);
  put32(W,nb+32,2);
  put32(W,nb+36,t);
  return nm;
}
// Generic candidate scan: distinct values v with a fact (s,r,*),
// first-seen order. Contains no domain knowledge.
fn scan_values(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<40){
    if(ig(W,64+i*16)==1 && ig(W,64+i*16+4)==s && ig(W,64+i*16+8)==r){
      let v:i32=ig(W,64+i*16+12);
      let seen:i32=0;
      let k:i32=0;
      while(k<n){
        if(ig(W,1728+k*4)==v){ seen=1; }
        k=k+1;
      }
      if(seen==0 && n<8){
        put32(W,1728+n*4,v);
        n=n+1;
      }
    }
    i=i+1;
  }
  return n;
}
fn promote_comp(W:[]u8,a:i32,b:i32)i32 {
  let z:i32=map_new(W,4);
  let zb:i32=704+z*64;
  put32(W,zb+20,a); put32(W,zb+24,b);
  put32(W,zb+12,ig(W,704+a*64+12));
  put32(W,zb+16,ig(W,704+b*64+16));
  put32(W,4,z);
  return z;
}
fn teach_x(W:[]u8,OUT:[]u8)void {
  let x:i32=map_new(W,0);
  bind_param(W,x,101);
  let l1:i32=exec_map(W,x,101);
  let l2:i32=exec_map(W,x,102);
  let si:i32=1;
  if(probe_kind(W,101)!=1){ si=0; }
  if(probe_kind(W,102)!=1){ si=0; }
  let so:i32=seq_kind_two(l1,l2);
  put32(W,704+x*64+12,si);
  put32(W,704+x*64+16,so);
  eS(W,OUT,"TEACH X id="); eN(W,OUT,x);
  eS(W,OUT," sig="); eN(W,OUT,si); eS(W,OUT,"->"); eN(W,OUT,so);
  eS(W,OUT," param="); eN(W,OUT,ig(W,704+x*64+8)); eS(W,OUT,"\n");
  return;
}
fn teach_y1(W:[]u8,OUT:[]u8)void {
  let y:i32=map_new(W,1);
  let l1:i32=sweep_raw(W,201,61);
  let r1:i32=exec_map(W,y,0);
  let l2:i32=sweep_raw(W,202,61);
  let r2:i32=exec_map(W,y,0);
  let sk:i32=seq_kind_two(l1,l2);
  put32(W,704+y*64+12,sk);
  put32(W,704+y*64+16,2);
  eS(W,OUT,"TEACH Y1 id="); eN(W,OUT,y);
  eS(W,OUT," sig="); eN(W,OUT,sk); eS(W,OUT,"->2");
  eS(W,OUT," r="); eN(W,OUT,r1); eS(W,OUT,","); eN(W,OUT,r2); eS(W,OUT,"\n");
  return;
}
fn teach_d(W:[]u8,OUT:[]u8)void {
  let d:i32=map_new(W,2);
  let l1:i32=sweep_raw(W,201,61);
  let r1:i32=exec_map(W,d,0);
  let l2:i32=sweep_raw(W,202,61);
  let r2:i32=exec_map(W,d,0);
  let sk:i32=seq_kind_two(l1,l2);
  put32(W,704+d*64+12,sk);
  put32(W,704+d*64+16,2);
  eS(W,OUT,"TEACH D id="); eN(W,OUT,d);
  eS(W,OUT," sig="); eN(W,OUT,sk); eS(W,OUT,"->2");
  eS(W,OUT," r="); eN(W,OUT,r1); eS(W,OUT,","); eN(W,OUT,r2); eS(W,OUT,"\n");
  return;
}
fn teach_y2(W:[]u8,OUT:[]u8)void {
  let y:i32=map_new(W,3);
  let l1:i32=sweep_raw(W,201,61);
  let r1:i32=exec_map(W,y,0);
  let l2:i32=sweep_raw(W,101,61);
  let r2:i32=exec_map(W,y,0);
  let sk:i32=seq_kind_two(l1,l2);
  put32(W,704+y*64+12,sk);
  put32(W,704+y*64+16,2);
  eS(W,OUT,"TEACH Y2 id="); eN(W,OUT,y);
  eS(W,OUT," sig="); eN(W,OUT,sk); eS(W,OUT,"->2");
  eS(W,OUT," r="); eN(W,OUT,r1); eS(W,OUT,","); eN(W,OUT,r2); eS(W,OUT,"\n");
  return;
}
// Try one typed pair. On goal match, record the success with provenance.
// Exhaustive: never stops early; the arm verdict requires exactly the
// predicted single success.
fn try_pair(W:[]u8,OUT:[]u8,a:i32,b:i32,s:i32,target:i32,kin:i32,kout:i32)void {
  if(ig(W,704+a*64+12)!=kin){ return; }
  if(compat(ig(W,704+a*64+16),ig(W,704+b*64+12))==0){ return; }
  if(ig(W,704+b*64+16)!=kout){ return; }
  put32(W,12,ig(W,12)+1);
  let mid:i32=exec_map(W,a,s);
  let r:i32=exec_map(W,b,mid);
  eS(W,OUT,"TRY pair a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b);
  eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
  if(r==target){
    put32(W,24,ig(W,24)+1);
    if(ig(W,24)==1){
      put32(W,28,ig(W,704+a*64+32));
      put32(W,32,ig(W,704+a*64+36));
      put32(W,36,b);
      let z:i32=promote_comp(W,a,b);
      eS(W,OUT,"Z-COMP z="); eN(W,OUT,z);
      eS(W,OUT," a="); eN(W,OUT,a); eS(W,OUT," b="); eN(W,OUT,b); eS(W,OUT,"\n");
      eS(W,OUT,"Z-PROV adapt_of="); eN(W,OUT,ig(W,704+a*64+28));
      eS(W,OUT," op="); eN(W,OUT,ig(W,704+a*64+32));
      eS(W,OUT," param="); eN(W,OUT,ig(W,704+a*64+36)); eS(W,OUT,"\n");
    }
    put32(W,8,1);
  }
  return;
}
// Two-phase solver. Phase 1 is exact L1 reuse. Phase 2 (l2_on=1) is the L2
// adaptation: for each sequence-producing MAP, try SPECIALIZE over every
// candidate threshold from the generic scan, then TRUNCATE over every
// candidate length, retrying typed composition each time. Fixed operator
// order (SPECIALIZE before TRUNCATE); selection is proven by exhaustive
// try-and-reject, not by order.
fn solve_z(W:[]u8,OUT:[]u8,s:i32,target:i32,l2_on:i32)void {
  let kin:i32=probe_kind(W,s);
  let kout:i32=probe_kind(W,target);
  let nm:i32=ig(W,0);
  put32(W,8,0); put32(W,24,0);
  eS(W,OUT,"PHASE1 L1:\n");
  let m:i32=0;
  while(m<nm){
    if(ig(W,704+m*64)==1){
      if(ig(W,704+m*64+12)==kin && ig(W,704+m*64+16)==kout){
        put32(W,12,ig(W,12)+1);
        let r:i32=exec_map(W,m,s);
        eS(W,OUT,"TRY single m="); eN(W,OUT,m); eS(W,OUT," r="); eN(W,OUT,r); eS(W,OUT,"\n");
        if(r==target){
          put32(W,24,ig(W,24)+1);
          put32(W,8,1);
        }
      }
    }
    m=m+1;
  }
  let a:i32=0;
  while(a<nm){
    let b:i32=0;
    while(b<nm){
      if(ig(W,704+a*64)==1 && ig(W,704+b*64)==1){
        try_pair(W,OUT,a,b,s,target,kin,kout);
      }
      b=b+1;
    }
    a=a+1;
  }
  if(ig(W,8)==0){ eS(W,OUT,"L1-FAIL\n"); }
  if(ig(W,8)==1 || l2_on==0){ return; }
  eS(W,OUT,"PHASE2 L2:\n");
  let n0:i32=ig(W,0);
  let xm:i32=0;
  while(xm<n0){
    if(ig(W,704+xm*64)==1 && ig(W,704+xm*64+4)==0 && ig(W,704+xm*64+32)==0){
      let pr:i32=ig(W,704+xm*64+8);
      let len:i32=exec_map(W,xm,s);
      eS(W,OUT,"XMAP m="); eN(W,OUT,xm); eS(W,OUT," len="); eN(W,OUT,len); eS(W,OUT,"\n");
      let nc:i32=scan_values(W,s,pr);
      eS(W,OUT,"SPEC-CANDS n="); eN(W,OUT,nc);
      let ci0:i32=0;
      while(ci0<nc){
        eS(W,OUT," "); eN(W,OUT,ig(W,1728+ci0*4));
        ci0=ci0+1;
      }
      eS(W,OUT,"\n");
      let ci:i32=0;
      while(ci<nc){
        let t:i32=ig(W,1728+ci*4);
        let m2:i32=specialize_map(W,xm,t);
        eS(W,OUT,"SPEC-TRY m="); eN(W,OUT,xm); eS(W,OUT," T="); eN(W,OUT,t);
        eS(W,OUT," nm="); eN(W,OUT,m2); eS(W,OUT,"\n");
        let b:i32=0;
        while(b<n0){
          if(ig(W,704+b*64)==1 && ig(W,704+b*64+32)==0){
            let bb:i32=ig(W,704+b*64+4);
            if(bb>=1 && bb<=3){ try_pair(W,OUT,m2,b,s,target,kin,kout); }
          }
          b=b+1;
        }
        ci=ci+1;
      }
      let k:i32=1;
      while(k<len){
        let m3:i32=truncate_map(W,xm,k);
        eS(W,OUT,"TRUNC-TRY m="); eN(W,OUT,xm); eS(W,OUT," k="); eN(W,OUT,k);
        eS(W,OUT," nm="); eN(W,OUT,m3); eS(W,OUT,"\n");
        let b2:i32=0;
        while(b2<n0){
          if(ig(W,704+b2*64)==1 && ig(W,704+b2*64+32)==0){
            let bb2:i32=ig(W,704+b2*64+4);
            if(bb2>=1 && bb2<=3){ try_pair(W,OUT,m3,b2,s,target,kin,kout); }
          }
          b2=b2+1;
        }
        k=k+1;
      }
    }
    xm=xm+1;
  }
  if(ig(W,8)==1){
    eS(W,OUT,"L2-SOLVED succ="); eN(W,OUT,ig(W,24)); eS(W,OUT,"\n");
  } else {
    eS(W,OUT,"L2-FAIL\n");
  }
  return;
}
fn arm_pass(W:[]u8,OUT:[]u8,ok:i32)void {
  if(ok==1){ eS(W,OUT,"ARM-RESULT PASS\n"); } else { eS(W,OUT,"ARM-RESULT FAIL\n"); }
  put32(W,20,ok);
  return;
}
fn arm_expect_fail(W:[]u8,OUT:[]u8)void {
  if(ig(W,8)==0){ eS(W,OUT,"ARM-RESULT PASS-expected-fail\n"); put32(W,20,1); }
  else { eS(W,OUT,"ARM-RESULT FAIL-unexpected-solve\n"); put32(W,20,0); }
  return;
}
// World-T arms: Z-T = (103,93) -> 8 needs TRUNCATE k=3, comp_b = Y1 (id 1).
fn arm_treat_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== TREAT-T ===\n");
  facts_t(W); teach_x(W,OUT); teach_y1(W,OUT); teach_d(W,OUT);
  solve_z(W,OUT,103,8,1);
  let ok:i32=0;
  if(ig(W,8)==1 && ig(W,24)==1 && ig(W,28)==1 && ig(W,32)==3 && ig(W,36)==1){
    let z:i32=ig(W,4);
    let za:i32=ig(W,704+z*64+20);
    if(ig(W,704+za*64+28)==0 && ig(W,704+za*64+32)==1 && ig(W,704+za*64+36)==3
       && ig(W,704+z*64+24)==1){ ok=1; }
  }
  arm_pass(W,OUT,ok);
  return;
}
fn arm_l1_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== L1-ONLY-T ===\n");
  facts_t(W); teach_x(W,OUT); teach_y1(W,OUT); teach_d(W,OUT);
  solve_z(W,OUT,103,8,0);
  arm_expect_fail(W,OUT);
  return;
}
fn arm_ablx_t(W:[]u8,OUT:[]u8)void {
  eS(W,OUT,"=== ABL-X-T ===\n");
  facts_t(W); teach_x(W,OUT); teach_y1(W,OUT); teach_d(W,OUT);
  del_map(W,0);
  solve_z(W,OUT,103,8,1);
  arm_expect_fail(W,OUT);
  return;
}

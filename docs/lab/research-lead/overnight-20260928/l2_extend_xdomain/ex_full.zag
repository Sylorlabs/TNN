// learner.zag -- L2 EXTEND-XDOMAIN (cross-domain extend with a
// learner-chosen extension length), standalone. Generic machinery
// + learned state only. No world data, no fact literals, no
// relation literals, no domain literals, no length literals in
// this file. The learner never selects a source MAP per problem:
// ex_query searches the learned MAP inventory in MAP-id order for
// the first capability-matching MAP (any domain). The full source
// procedure is grounded first; on failure a
// shortest-verifying-extension enumeration (k = nf+1 upward to a
// fixed generic bound KMAX=6) chooses the extension length at
// runtime. Every interface mapping (entry relation, fold-pair
// relations, value relation) is discovered from learner state and
// world facts, never hardcoded.
// Prereg: l2_extend_xdomain/PREREG.md (frozen). Pure Zag.
// 0 modes, 0 handlers, 0 new edge types, 0 new opcodes,
// 0 semantic cases, 0 domain-pair templates.
//
// State layout (u8 buffer):
//   0 NF  1 NM  2 NE  3 EXTEND_ON (driver flag, never learner-written)
//   4 NN  5 unused  6 STALE_MAP  7 STALE_HOP  8 STALE_FACT
//   9 LAST_VIA  10 unused  11 IN_EXT  12 EX_ENTERED
//   13 SRC_ID (255=none)
//   16..319:  facts, 38 x 8B [sub,rel,obj,live,0,0,0,0]
//   320..959: MAPs, 16 x 40B [tag=20,live,start,end,rlen,flen,
//               reason,pad, rels x12 @+8, facts x12 @+20,
//               dom @+32, cap @+33, d_entry @+34, d_r1 @+35,
//               d_r2 @+36, d_nf @+37, d_valrel @+38, pad @+39]
//   960..1215: edges, 64 x 4B [from,to,type,pad]
//   1216..1247: answer nodes, 8 x 4B [via,0,0,0]
//   1248 SEARCH i32  1252 EXEC i32  1256 A_SEARCH i32  1260 A_EXEC i32
//   1264 LAST_VAL i32  1268 SRC_ID32 (i32 mirror)  1272 LAST_TERM i32
//   1276 EXT_K i32  1280 FULL_OK i32  1284 EXT_DECIDED i32
//   1288 EXT_TRIES i32 (extension lengths attempted)
//   1292..: scratch (caller-allocated)

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- trace emit helpers (cursor via atp) ----
fn ex_p(ob:[]u8, atp:[]u8, s:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,s);
  set32(atp,0,at);
  return;
}
fn ex_pi(ob:[]u8, atp:[]u8, v:i32)void {
  let at:i32=get32(atp,0);
  at=ob_i32(ob,at,v);
  set32(atp,0,at);
  return;
}
fn ex_pnl(ob:[]u8, atp:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_nl(ob,at);
  set32(atp,0,at);
  return;
}

// ---- cost counting (frozen rules) ----
fn ex_tick(st:[]u8)void {
  set32(st,1256,get32(st,1256)+1);
  set32(st,1248,get32(st,1248)+1);
  return;
}
fn ex_tickm(st:[]u8)void {
  set32(st,1256,get32(st,1256)+1);
  set32(st,1248,get32(st,1248)+1);
  return;
}
fn ex_exec(st:[]u8)void {
  set32(st,1252,get32(st,1252)+1);
  if((st[11] as i32)==1){set32(st,1260,get32(st,1260)+1);}
  return;
}

// ---- facts: world observations ----
fn f_teach(st:[]u8, sub:i32, rel:i32, obj:i32)i32 {
  let n:i32=st[0] as i32;
  if(n>=38){return -1;}
  let o:i32=16+n*8;
  st[o]=sub as u8; st[o+1]=rel as u8; st[o+2]=obj as u8; st[o+3]=1;
  st[o+4]=0; st[o+5]=0; st[o+6]=0; st[o+7]=0;
  st[0]=(n+1) as u8;
  return n;
}

// ---- MAPs (40-byte rows, 12 rel/fact slots) ----
fn m_teach(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  if(rl>12){return -1;}
  if(fl>12){return -1;}
  let k:i32=0;
  while(k<fl){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    k=k+1;
  }
  // interface descriptor extraction (cap==AGG only), generic:
  // d_entry=rels[0], rels[1..] must alternate (r1,r2), d_valrel =
  // rel of first live fact with sub==end. No rel literal here.
  let de:i32=0; let dr1:i32=0; let dr2:i32=0; let dnf:i32=0; let dvr:i32=0;
  if(cap==1){
    if(rl<3){return -1;}
    let rem:i32=rl-1;
    if((rem%2)==1){return -1;}
    dr1=rs[1] as i32; dr2=rs[2] as i32;
    let ok:i32=1;
    let i:i32=1;
    while(i<rl){
      let e:i32=dr1;
      if((i%2)==0){e=dr2;}
      if((rs[i] as i32)!=e){ok=0;}
      i=i+1;
    }
    if(ok==0){return -1;}
    de=rs[0] as i32; dnf=rem/2;
    let nf2:i32=st[0] as i32;
    let j:i32=0;
    let got:i32=0;
    while(j<nf2){
      if(got==0){
        let fo2:i32=16+j*8;
        if((st[fo2+3] as i32)==1){
          if((st[fo2] as i32)==end){dvr=st[fo2+1] as i32; got=1;}
        }
      }
      j=j+1;
    }
    if(got==0){return -1;}
  }
  let o:i32=320+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  k=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=0;
  st[1]=(n+1) as u8;
  return n;
}
fn map_create(st:[]u8, rs:[]u8, rl:i32, fs:[]u8, fl:i32, start:i32, end:i32, dom:i32, cap:i32, de:i32, dr1:i32, dr2:i32, dnf:i32, dvr:i32)i32 {
  let n:i32=st[1] as i32;
  if(n>=16){return -1;}
  let o:i32=320+n*40;
  st[o]=20; st[o+1]=1; st[o+2]=start as u8; st[o+3]=end as u8;
  st[o+4]=rl as u8; st[o+5]=fl as u8; st[o+6]=0; st[o+7]=0;
  let k:i32=0;
  while(k<12){
    if(k<rl){st[o+8+k]=rs[k];}
    else {st[o+8+k]=0;}
    k=k+1;
  }
  k=0;
  while(k<12){
    if(k<fl){st[o+20+k]=fs[k];}
    else {st[o+20+k]=0;}
    k=k+1;
  }
  st[o+32]=dom as u8; st[o+33]=cap as u8;
  st[o+34]=de as u8; st[o+35]=dr1 as u8; st[o+36]=dr2 as u8;
  st[o+37]=dnf as u8; st[o+38]=dvr as u8; st[o+39]=0;
  st[1]=(n+1) as u8;
  return n;
}
fn map_retire(st:[]u8, mid:i32, reason:i32)void {
  let o:i32=320+mid*40;
  st[o+1]=0;
  st[o+6]=reason as u8;
  return;
}

// ---- execution ----
fn m_exec(st:[]u8, mid:i32, start:i32)i32 {
  ex_exec(st);
  st[6]=255;
  let o:i32=320+mid*40;
  if((st[o+1] as i32)==0){return -1;}
  let rl:i32=st[o+4] as i32;
  let cur:i32=start;
  let k:i32=0;
  while(k<rl){
    let fid:i32=st[o+20+k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){
      st[6]=mid as u8; st[7]=k as u8; st[8]=fid as u8;
      return -1;
    }
    let bad:i32=0;
    if((st[fo] as i32)!=cur){bad=1;}
    if((st[fo+1] as i32)!=(st[o+8+k] as i32)){bad=1;}
    if(bad==1){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}
fn chain_exec(st:[]u8, fs:[]u8, rs:[]u8, n:i32, start:i32)i32 {
  ex_exec(st);
  let cur:i32=start;
  let k:i32=0;
  while(k<n){
    let fid:i32=fs[k] as i32;
    let fo:i32=16+fid*8;
    if((st[fo+3] as i32)==0){return -1;}
    if((st[fo] as i32)!=cur){return -1;}
    if((st[fo+1] as i32)!=(rs[k] as i32)){return -1;}
    cur=st[fo+2] as i32;
    k=k+1;
  }
  return cur;
}

// ---- edges ----
fn e_add(st:[]u8, from:i32, to:i32, typ:i32)void {
  let n:i32=st[2] as i32;
  if(n>=64){return;}
  let i:i32=0;
  while(i<n){
    let o:i32=960+i*4;
    let dup:i32=0;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){dup=1;}
      }
    }
    if(dup==1){return;}
    i=i+1;
  }
  let o:i32=960+n*4;
  st[o]=from as u8; st[o+1]=to as u8; st[o+2]=typ as u8; st[o+3]=0;
  st[2]=(n+1) as u8;
  return;
}
fn e_count(st:[]u8, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    if((st[960+i*4+2] as i32)==typ){c=c+1;}
    i=i+1;
  }
  return c;
}
fn e_has(st:[]u8, from:i32, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=960+i*4;
    if((st[o] as i32)==from){
      if((st[o+1] as i32)==to){
        if((st[o+2] as i32)==typ){return 1;}
      }
    }
    i=i+1;
  }
  return 0;
}
fn e_has_to(st:[]u8, to:i32, typ:i32)i32 {
  let n:i32=st[2] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=960+i*4;
    if((st[o+1] as i32)==to){
      if((st[o+2] as i32)==typ){return 1;}
    }
    i=i+1;
  }
  return 0;
}
fn ex_eoth(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let tp:i32=st[960+i*4+2] as i32;
    if(tp!=14){ if(tp!=16){ c=c+1; } }
    i=i+1;
  }
  return c;
}

// ---- counted fact scans (frozen counting rules) ----
// first live fact with sub==s, skipping rel==skiprel. counts examined.
fn ex_find_sub_skip(st:[]u8, s:i32, skiprel:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)!=skiprel){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// first live fact with sub==s and rel==r. counts examined.
fn ex_find_subrel(st:[]u8, s:i32, r:i32)i32 {
  let nf:i32=st[0] as i32;
  let i:i32=0;
  while(i<nf){
    ex_tick(st);
    let fo:i32=16+i*8;
    if((st[fo+3] as i32)==1){
      if((st[fo] as i32)==s){
        if((st[fo+1] as i32)==r){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// value of node nd via vrel: first live fact sub==nd, rel==vrel.
// returns value or -1. counts examined.
fn ex_valof(st:[]u8, nd:i32, vrel:i32)i32 {
  let f:i32=ex_find_subrel(st,nd,vrel);
  if(f<0){return -1;}
  return st[16+f*8+2] as i32;
}

// ---- fold-walk: from entry node u, walk k alternating (s1,s2)
// folds. fold 1 discovers (s1,s2) via first live facts (skipping
// vrel: value annotations are not structural hops);
// folds 2..k require rel==s1 / rel==s2.
// fills ff[0..2k) fact ids.
// returns 0 on fail, else s1 + s2*256 + term*65536.
fn ex_foldwalk(st:[]u8, u:i32, k:i32, vrel:i32, ff:[]u8)i32 {
  let f1:i32=ex_find_sub_skip(st,u,vrel);
  if(f1<0){return 0;}
  let s1:i32=st[16+f1*8+1] as i32;
  let a0:i32=st[16+f1*8+2] as i32;
  let f2:i32=ex_find_sub_skip(st,a0,vrel);
  if(f2<0){return 0;}
  let s2:i32=st[16+f2*8+1] as i32;
  let cur:i32=st[16+f2*8+2] as i32;
  ff[0]=f1 as u8; ff[1]=f2 as u8;
  let j:i32=1;
  while(j<k){
    let g1:i32=ex_find_subrel(st,cur,s1);
    if(g1<0){return 0;}
    let ak:i32=st[16+g1*8+2] as i32;
    let g2:i32=ex_find_subrel(st,ak,s2);
    if(g2<0){return 0;}
    cur=st[16+g2*8+2] as i32;
    ff[2*j]=g1 as u8; ff[2*j+1]=g2 as u8;
    j=j+1;
  }
  return s1 + s2*256 + cur*65536;
}

// ---- try one prefix length: entry scan, fold-walk with k folds,
// verify term==t and (v<0 or val==v). First verifying grounding
// is committed (first-match precedent). Returns pack or 0.
fn ex_try_len(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, k:i32, vrel:i32, efd:[]u8, rre:[]u8, ff:[]u8)i32 {
  let nfacts:i32=st[0] as i32;
  let fid:i32=0;
  let done:i32=0;
  let pack:i32=0;
  while(fid<nfacts){
    if(done==0){
      ex_tick(st);
      let fo:i32=16+fid*8;
      let cand:i32=0;
      if((st[fo+3] as i32)==1){cand=1;}
      if(cand==1){
        if((st[fo] as i32)!=s){cand=0;}
      }
      if(cand==1){
        let re:i32=st[fo+1] as i32;
        let u:i32=st[fo+2] as i32;
        let p2:i32=ex_foldwalk(st,u,k,vrel,ff);
        ex_p(ob,atp,"EX-ENTRY-CAND r=");
        ex_pi(ob,atp,re);
        ex_p(ob,atp," u=");
        ex_pi(ob,atp,u);
        if(p2==0){
          ex_p(ob,atp," FAIL-SHAPE\n");
        } else {
          let s1:i32=p2%256;
          let s2:i32=(p2/256)%256;
          let term:i32=(p2/65536)%256;
          ex_p(ob,atp," SHAPE-OK term=");
          ex_pi(ob,atp,term);
          let ok:i32=0;
          if(term==t){ok=1;}
          if(ok==1){
            if(v>=0){
              let vv:i32=ex_valof(st,term,vrel);
              if(vv!=v){ok=0;}
            }
          }
          if(ok==1){
            ex_p(ob,atp," VERIFY-OK\n");
            efd[0]=fid as u8;
            rre[0]=re as u8;
            pack=p2;
            done=1;
          } else {
            ex_p(ob,atp," VERIFY-FAIL\n");
          }
        }
      }
    }
    fid=fid+1;
  }
  return pack;
}

// ---- build, execution-verify, promote, deliver ----
fn ex_build(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, smid:i32, pack:i32, k:i32, efd:[]u8, rre:[]u8, ff:[]u8, vrel:i32)i32 {
  let s1:i32=pack%256;
  let s2:i32=(pack/256)%256;
  let term:i32=(pack/65536)%256;
  let re:i32=rre[0] as i32;
  let efid:i32=efd[0] as i32;
  let zr:[]u8=z_alloc(16);
  let zf:[]u8=z_alloc(16);
  zr[0]=re as u8;
  zf[0]=efid as u8;
  let w:i32=0;
  while(w<2*k){
    if((w%2)==0){zr[1+w]=s1 as u8;}
    else {zr[1+w]=s2 as u8;}
    zf[1+w]=ff[w];
    w=w+1;
  }
  let zl:i32=1+2*k;
  ex_p(ob,atp,"EX-ZBUILD rels=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zr[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_p(ob,atp," facts=");
  w=0;
  while(w<zl){
    ex_pi(ob,atp,zf[w] as i32);
    if(w+1<zl){ex_p(ob,atp,",");}
    w=w+1;
  }
  ex_pnl(ob,atp);
  let vt:i32=chain_exec(st,zf,zr,zl,s);
  ex_p(ob,atp,"EX-VERIFY term=");
  ex_pi(ob,atp,vt);
  if(vt==t){
    ex_p(ob,atp," OK\n");
    let zid:i32=map_create(st,zr,zl,zf,zl,s,term,qdom,1,re,s1,s2,k,vrel);
    e_add(st,zid,smid,16);
    ex_p(ob,atp,"EX-PROMOTE z=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp," t16=");
    ex_pi(ob,atp,zid);
    ex_p(ob,atp,"->");
    ex_pi(ob,atp,smid);
    ex_pnl(ob,atp);
    ex_deliver(st,ob,atp,zid,s,vt,v);
    return vt;
  }
  ex_p(ob,atp," FAIL\n");
  return -2;
}

// ---- the cross-domain EXTEND operator ----
// Shortest-verifying-extension enumeration: k = nf+1 upward to
// the fixed generic bound KMAX=6. The first verifying k wins and
// the enumeration stops, so the extension is minimal by policy.
fn ex_extend(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, qdom:i32, smid:i32, extend_on:i32)i32 {
  set32(st,1268,smid);
  set32(st,1280,0);
  set32(st,1276,-1);
  set32(st,1284,0);
  set32(st,1288,0);
  let so:i32=320+smid*40;
  let entry:i32=st[so+34] as i32;
  let r1:i32=st[so+35] as i32;
  let r2:i32=st[so+36] as i32;
  let nf:i32=st[so+37] as i32;
  let vrel:i32=st[so+38] as i32;
  ex_p(ob,atp,"EX-SRC id=");
  ex_pi(ob,atp,smid);
  ex_p(ob,atp," entry=");
  ex_pi(ob,atp,entry);
  ex_p(ob,atp," r1=");
  ex_pi(ob,atp,r1);
  ex_p(ob,atp," r2=");
  ex_pi(ob,atp,r2);
  ex_p(ob,atp," nf=");
  ex_pi(ob,atp,nf);
  ex_p(ob,atp," valrel=");
  ex_pi(ob,atp,vrel);
  ex_pnl(ob,atp);
  let efd:[]u8=z_alloc(8);
  let rre:[]u8=z_alloc(8);
  let ff:[]u8=z_alloc(16);
  let ans:i32=-2;
  // full-length attempt first
  let k:i32=nf;
  ex_p(ob,atp,"EX-TRY k=");
  ex_pi(ob,atp,k);
  ex_pnl(ob,atp);
  let pfull:i32=ex_try_len(st,ob,atp,s,t,v,k,vrel,efd,rre,ff);
  if(pfull==0){
    ex_p(ob,atp,"EX-FAIL k=");
    ex_pi(ob,atp,k);
    ex_pnl(ob,atp);
    ex_p(ob,atp,"EX-FULL-FAIL\n");
  } else {
    set32(st,1280,1);
    ans=ex_build(st,ob,atp,s,t,v,qdom,smid,pfull,k,efd,rre,ff,vrel);
  }
  if(pfull==0){
    if(extend_on==1){
      // shortest-first extension: the learner's length choice
      k=nf+1;
      let done:i32=0;
      while(k<=6){
        if(done==0){
          ex_p(ob,atp,"EX-TRY k=");
          ex_pi(ob,atp,k);
          ex_pnl(ob,atp);
          set32(st,1288,get32(st,1288)+1);
          let pk:i32=ex_try_len(st,ob,atp,s,t,v,k,vrel,efd,rre,ff);
          if(pk==0){
            ex_p(ob,atp,"EX-FAIL k=");
            ex_pi(ob,atp,k);
            ex_pnl(ob,atp);
          } else {
            ex_p(ob,atp,"EX-OK k=");
            ex_pi(ob,atp,k);
            ex_pnl(ob,atp);
            set32(st,1276,k);
            set32(st,1284,1);
            ans=ex_build(st,ob,atp,s,t,v,qdom,smid,pk,k,efd,rre,ff,vrel);
            done=1;
          }
        }
        k=k+1;
      }
    }
  }
  return ans;
}

// ---- deliver: answer-node provenance + ANS print ----
fn ex_deliver(st:[]u8, ob:[]u8, atp:[]u8, mid:i32, start:i32, term:i32, val:i32)void {
  let r:i32=m_exec(st,mid,start);
  st[9]=mid as u8;
  set32(st,1264,val);
  set32(st,1272,term);
  let nn:i32=st[4] as i32;
  let aid:i32=40+nn;
  let ao:i32=1216+nn*4;
  st[ao]=mid as u8; st[ao+1]=0; st[ao+2]=0; st[ao+3]=0;
  st[4]=(nn+1) as u8;
  e_add(st,aid,mid,14);
  ex_p(ob,atp,"ANS term=");
  ex_pi(ob,atp,term);
  ex_p(ob,atp," val=");
  ex_pi(ob,atp,val);
  ex_p(ob,atp," via=");
  ex_pi(ob,atp,mid);
  ex_pnl(ob,atp);
  return;
}

// ---- query: pipeline, then extend on failure ----
fn ex_query(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, extend_on:i32)i32 {
  st[12]=0;
  set32(st,1264,-2);
  set32(st,1268,-1);
  set32(st,1272,-2);
  let nm:i32=st[1] as i32;
  let mid:i32=0;
  while(mid<nm){
    let r:i32=m_exec(st,mid,s);
    if(r==t){
      let vv:i32=-1;
      let mo:i32=320+mid*40;
      let vr2:i32=st[mo+38] as i32;
      if(vr2!=0){vv=ex_valof(st,r,vr2);}
      ex_deliver(st,ob,atp,mid,s,r,vv);
      return r;
    }
    mid=mid+1;
  }
  // extend phase
  st[11]=1;
  st[12]=1;
  set32(st,1256,0);
  set32(st,1260,0);
  ex_p(ob,atp,"EX-QUERY s=");
  ex_pi(ob,atp,s);
  ex_p(ob,atp," t=");
  ex_pi(ob,atp,t);
  ex_p(ob,atp," v=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," cap=");
  ex_pi(ob,atp,cap);
  ex_p(ob,atp," dom=");
  ex_pi(ob,atp,dom);
  ex_pnl(ob,atp);
  // capsearch: first live MAP with cap==qcap (any domain)
  let smid:i32=-1;
  let done:i32=0;
  mid=0;
  while(mid<nm){
    if(done==0){
      ex_tickm(st);
      let o:i32=320+mid*40;
      let mc:i32=st[o+33] as i32;
      ex_p(ob,atp,"EX-SEARCH id=");
      ex_pi(ob,atp,mid);
      ex_p(ob,atp," cap=");
      ex_pi(ob,atp,mc);
      let hit:i32=0;
      if((st[o+1] as i32)==1){hit=1;}
      if(hit==1){
        if(mc!=cap){hit=0;}
      }
      if(hit==1){
        ex_p(ob,atp," MATCH\n");
        smid=mid;
        done=1;
      } else {
        ex_p(ob,atp," SKIP\n");
      }
    }
    mid=mid+1;
  }
  let ans:i32=-2;
  if(smid>=0){
    ans=ex_extend(st,ob,atp,s,t,v,dom,smid,extend_on);
  }
  st[11]=0;
  if(ans<0){
    ex_p(ob,atp,"ANS term=-2 val=-2 via=-1\n");
    set32(st,1264,-2);
    set32(st,1272,-2);
  }
  return ans;
}
// world.zag -- environment side (EXPERIMENT SIDE ONLY).
// Frozen fact table (20 facts). The learner only observes facts
// via f_teach and discovers consequences through execution.
// Domain A (arithmetic aggregation):
//   0:(40,5,30) 1:(30,6,41) 2:(41,5,31) 3:(31,6,42)
//   4:(42,5,32) 5:(32,6,43)
//   6:(43,2,11) 7:(100,18,40)
// Domain B (planning):
//   8:(50,17,70) 9:(70,15,60) 10:(60,16,71) 11:(71,15,61)
//   12:(61,16,72) 13:(72,15,62) 14:(62,16,73) 15:(73,15,63)
//   16:(63,16,74) 17:(74,2,77)
//   18:(50,7,51) 19:(51,7,52)

fn w_teach_all(st:[]u8)void {
  f_teach(st,40,5,30);
  f_teach(st,30,6,41);
  f_teach(st,41,5,31);
  f_teach(st,31,6,42);
  f_teach(st,42,5,32);
  f_teach(st,32,6,43);
  f_teach(st,43,2,11);
  f_teach(st,100,18,40);
  f_teach(st,50,17,70);
  f_teach(st,70,15,60);
  f_teach(st,60,16,71);
  f_teach(st,71,15,61);
  f_teach(st,61,16,72);
  f_teach(st,72,15,62);
  f_teach(st,62,16,73);
  f_teach(st,73,15,63);
  f_teach(st,63,16,74);
  f_teach(st,74,2,77);
  f_teach(st,50,7,51);
  f_teach(st,51,7,52);
  return;
}
// driver.zag -- experiment side: teaching, four arms, in-Zag
// kill-bar evaluation. The driver never selects a source MAP for
// a query and never names an extension length: Q2 is issued as
// (50,74,77,AGG,B) with no MAP id and no length; the last
// ex_query argument is only the EXTEND_ON causal-control flag
// (1 = extend operator enabled, 0 = full-only attempt).

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  // mD id0: dom A(1), cap ROUTE(2), rels [6], facts [1], 30->41
  rs[0]=6; fs[0]=1;
  m_teach(st,rs,1,fs,1,30,41,1,2);
  // mA id1 (X): dom A(1), cap AGG(1), entry + 3 fold pairs,
  // facts [7,0,1,2,3,4,5], 100->43
  rs[0]=18; rs[1]=5; rs[2]=6; rs[3]=5; rs[4]=6; rs[5]=5; rs[6]=6;
  fs[0]=7; fs[1]=0; fs[2]=1; fs[3]=2; fs[4]=3; fs[5]=4; fs[6]=5;
  m_teach(st,rs,7,fs,7,100,43,1,1);
  // mB0 id2 (Y): dom B(2), cap ROUTE(2), rels [7,7], facts [18,19],
  // 50->52
  rs[0]=7; rs[1]=7; fs[0]=18; fs[1]=19;
  m_teach(st,rs,2,fs,2,50,52,2,2);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// X (mA) and the native B MAP (mB0) learned independently:
// disjoint relation sets.
fn d_disjoint(st:[]u8)i32 {
  let o1:i32=320+1*40;
  let rl1:i32=st[o1+4] as i32;
  let k:i32=0;
  let ok:i32=1;
  while(k<rl1){
    let r:i32=st[o1+8+k] as i32;
    let hit:i32=0;
    if(r==18){hit=1;}
    if(r==5){hit=1;}
    if(r==6){hit=1;}
    if(hit==0){ok=0;}
    k=k+1;
  }
  let o2:i32=320+2*40;
  let rl2:i32=st[o2+4] as i32;
  k=0;
  while(k<rl2){
    if((st[o2+8+k] as i32)!=7){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z (id 3) must equal the frozen section 4 values exactly.
fn d_check_z(st:[]u8)i32 {
  let o:i32=320+3*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=9){ok=0;}
  if((st[o+2] as i32)!=50){ok=0;}
  if((st[o+3] as i32)!=74){ok=0;}
  if((st[o+32] as i32)!=2){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=17){ok=0;}
  if((st[o+35] as i32)!=15){ok=0;}
  if((st[o+36] as i32)!=16){ok=0;}
  if((st[o+37] as i32)!=4){ok=0;}
  if((st[o+38] as i32)!=2){ok=0;}
  let er:[]u8=z_alloc(10);
  er[0]=17; er[1]=15; er[2]=16; er[3]=15; er[4]=16; er[5]=15; er[6]=16; er[7]=15; er[8]=16;
  let ef:[]u8=z_alloc(10);
  ef[0]=8; ef[1]=9; ef[2]=10; ef[3]=11; ef[4]=12; ef[5]=13; ef[6]=14; ef[7]=15; ef[8]=16;
  let k:i32=0;
  while(k<9){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  ex_p(ob,atp,"Q QA\n");
  ex_query(stF,ob,atp,100,43,11,1,1,1);
  let qa_via:i32=stF[9] as i32;
  ex_p(ob,atp,"Q QB\n");
  ex_query(stF,ob,atp,50,52,-1,2,2,1);
  let qb_via:i32=stF[9] as i32;
  ex_p(ob,atp,"Q Q2\n");
  ex_query(stF,ob,atp,50,74,77,1,2,1);
  let q2_via:i32=stF[9] as i32;
  let q2_val:i32=get32(stF,1264);
  let q2_as:i32=get32(stF,1256);
  let q2_ae:i32=get32(stF,1260);
  let srcF:i32=get32(stF,1268);
  let fok:i32=get32(stF,1280);
  let ek:i32=get32(stF,1276);
  let edec:i32=get32(stF,1284);
  let etries:i32=get32(stF,1288);
  ex_p(ob,atp,"Q Q2B\n");
  ex_query(stF,ob,atp,50,74,77,1,2,1);
  let q2b_via:i32=stF[9] as i32;
  let q2b_val:i32=get32(stF,1264);
  let q2b_adapt:i32=stF[12] as i32;
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let e14F:i32=e_has_to(stF,3,14);
  let e31F:i32=e_has(stF,3,1,16);
  let nmF:i32=stF[1] as i32;
  let zlive:i32=stF[320+3*40+1] as i32;
  let mdlive:i32=stF[320+0*40+1] as i32;
  let disj:i32=d_disjoint(stF);
  let zchk:i32=d_check_z(stF);
  ex_p(ob,atp,"ARM-FULL-END as=");
  ex_pi(ob,atp,q2_as);
  ex_p(ob,atp," ae=");
  ex_pi(ob,atp,q2_ae);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,t16F);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othF);
  ex_pnl(ob,atp);

  // ---------- ARM NOEXTEND ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  ex_p(ob,atp,"ARM NOEXTEND\n");
  ex_p(ob,atp,"Q QA\n");
  ex_query(stN,ob,atp,100,43,11,1,1,0);
  ex_p(ob,atp,"Q QB\n");
  ex_query(stN,ob,atp,50,52,-1,2,2,0);
  ex_p(ob,atp,"Q Q2\n");
  ex_query(stN,ob,atp,50,74,77,1,2,0);
  let ne_via:i32=stN[9] as i32;
  let ne_val:i32=get32(stN,1264);
  let ne_t16:i32=e_count(stN,16);
  let ne_nm:i32=stN[1] as i32;
  let ne_as:i32=get32(stN,1256);
  let othN:i32=ex_eoth(stN);
  ex_p(ob,atp,"ARM-NOEXTEND-END as=");
  ex_pi(ob,atp,ne_as);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,ne_t16);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othN);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-X ----------
  let stX:[]u8=z_alloc(8192);
  d_teach_all(stX);
  ex_p(ob,atp,"ARM ABLATE-X\n");
  ex_p(ob,atp,"Q QA\n");
  ex_query(stX,ob,atp,100,43,11,1,1,1);
  ex_p(ob,atp,"Q QB\n");
  ex_query(stX,ob,atp,50,52,-1,2,2,1);
  map_retire(stX,1,3);
  ex_p(ob,atp,"Q Q2\n");
  ex_query(stX,ob,atp,50,74,77,1,2,1);
  let ax_via:i32=stX[9] as i32;
  let ax_val:i32=get32(stX,1264);
  let ax_t16:i32=e_count(stX,16);
  let ax_nm:i32=stX[1] as i32;
  let ax_as:i32=get32(stX,1256);
  let othX:i32=ex_eoth(stX);
  ex_p(ob,atp,"ARM-ABLATEX-END as=");
  ex_pi(ob,atp,ax_as);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,ax_t16);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othX);
  ex_pnl(ob,atp);

  // ---------- ARM FRESH ----------
  let stR:[]u8=z_alloc(8192);
  w_teach_all(stR);
  ex_p(ob,atp,"ARM FRESH\n");
  ex_p(ob,atp,"Q Q2\n");
  ex_query(stR,ob,atp,50,74,77,1,2,1);
  let fr_via:i32=stR[9] as i32;
  let fr_val:i32=get32(stR,1264);
  let fr_t16:i32=e_count(stR,16);
  let fr_nm:i32=stR[1] as i32;
  let fr_as:i32=get32(stR,1256);
  let othR:i32=ex_eoth(stR);
  ex_p(ob,atp,"ARM-FRESH-END as=");
  ex_pi(ob,atp,fr_as);
  ex_p(ob,atp," t16=");
  ex_pi(ob,atp,fr_t16);
  ex_p(ob,atp," oth=");
  ex_pi(ob,atp,othR);
  ex_pnl(ob,atp);

  // ---------- in-Zag kill bars (parent K1-K8 numbering) ----------
  let k1:i32=0;
  if(qa_via==1){
    if(qb_via==2){
      if(q2_via==3){
        if(disj==1){k1=1;}
      }
    }
  }
  let k2:i32=0;
  if(fok==0){
    if(ne_val==-2){
      if(ne_t16==0){k2=1;}
    }
  }
  let k3:i32=0;
  if(ek==4){
    if(edec==1){k3=1;}
  }
  let k4:i32=0;
  if(q2_via==3){
    if(q2_val==77){
      if(fok==0){k4=1;}
    }
  }
  let k5:i32=0;
  if(ek==4){
    if(etries==1){k5=1;}
  }
  let k8:i32=0;
  if(ax_val==-2){
    if(ax_t16==0){
      if(ax_nm==3){k8=1;}
    }
  }
  // falsifiers
  let ff:i32=0;
  if(othF!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n");ff=1;}
  if(othN!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW NOEXTEND\n");ff=1;}
  if(othX!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEX\n");ff=1;}
  if(othR!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FRESH\n");ff=1;}
  if(q2_as!=272){ex_p(ob,atp,"FALSIFIER F-COUNT AS=");ex_pi(ob,atp,q2_as);ex_pnl(ob,atp);ff=1;}
  if(q2_ae!=2){ex_p(ob,atp,"FALSIFIER F-COUNT AE=");ex_pi(ob,atp,q2_ae);ex_pnl(ob,atp);ff=1;}
  if(q2_via!=3){ex_p(ob,atp,"FALSIFIER F-NO-GROUND\n");ff=1;}
  if(zchk!=1){ex_p(ob,atp,"FALSIFIER F-WRONG-Z\n");ff=1;}
  if(fok!=0){ex_p(ob,atp,"FALSIFIER F-FULL-OK\n");ff=1;}
  if(ne_val!=-2){ex_p(ob,atp,"FALSIFIER F-NOEXT-PASS\n");ff=1;}
  if(ax_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLX-PASS\n");ff=1;}
  if(ax_t16!=0){ex_p(ob,atp,"FALSIFIER F-ABLX-T16\n");ff=1;}
  if(fr_val!=-2){ex_p(ob,atp,"FALSIFIER F-FRESH-PASS\n");ff=1;}
  if(q2b_adapt!=0){ex_p(ob,atp,"FALSIFIER F-Q2B-RE\n");ff=1;}
  if(q2b_via!=3){ex_p(ob,atp,"FALSIFIER F-Q2B-VIA\n");ff=1;}
  if(q2b_val!=77){ex_p(ob,atp,"FALSIFIER F-Q2B-VAL\n");ff=1;}
  if(t16F!=1){ex_p(ob,atp,"FALSIFIER F-T16-COUNT\n");ff=1;}
  if(e31F!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-SRC\n");ff=1;}
  if(e14F!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14\n");ff=1;}
  if(srcF!=1){ex_p(ob,atp,"FALSIFIER F-SRC\n");ff=1;}
  if(mdlive!=1){ex_p(ob,atp,"FALSIFIER F-DISTR-SURVIVES\n");ff=1;}
  ex_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"L2-EXTEND-XDOMAIN-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

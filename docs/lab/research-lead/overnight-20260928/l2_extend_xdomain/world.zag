  f_teach(st,70,15,60);
  f_teach(st,60,16,71);
  f_teach(st,71,15,61);
  f_teach(st,61,16,72);
  f_teach(st,72,15,62);
  f_teach(st,62,16,73);
  f_teach(st,73,15,63);
  f_teach(st,63,16,74);
  f_teach(st,74,2,77);
  f_teach(st,50,7,51);

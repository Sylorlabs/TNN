//   12:(61,16,72) 13:(72,15,62) 14:(62,16,73) 15:(73,15,63)
//   16:(63,16,74) 17:(74,2,77)
//   18:(50,7,51) 19:(51,7,52)

fn w_teach_all(st:[]u8)void {
  f_teach(st,40,5,30);
  f_teach(st,30,6,41);
  f_teach(st,41,5,31);
  f_teach(st,31,6,42);
  f_teach(st,42,5,32);
  f_teach(st,32,6,43);
  f_teach(st,43,2,11);

// l2c_driver.zag -- L2-COMBINED battery driver.
// Arms: FULL REUSE EXTONLY SUBONLY EXACT FRESH. Each arm runs on a
// fresh tnn2_init workspace. The driver asserts the frozen prereg
// constants and emits ARM <name> PASS/FAIL. Harness only; the
// learner cognition lives in l2c_patch.zag.

fn l2c_freshW()[]u8 {
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  return W;
}

// World facts; F[0..8] = node ids. Returns 1 when ids match the
// hand-derived allocation (2..10).
fn l2c_world(W:[]u8, F:[]u8) i32 {
  set32(F,0,ev_teach(W,101,1,102));
  set32(F,4,ev_teach(W,102,1,103));
  set32(F,8,ev_teach(W,103,1,104));
  set32(F,12,ev_teach(W,102,1,112));
  set32(F,16,ev_teach(W,112,1,103));
  set32(F,20,ev_teach(W,104,1,105));
  set32(F,24,ev_teach(W,105,1,106));
  set32(F,28,ev_teach(W,106,1,107));
  set32(F,32,ev_teach(W,102,1,110));
  let ok:i32=1;
  let i:i32=0;
  while(i<9){
    if(get32(F,i*4)!=i+2){ ok=0; }
    i=i+1;
  }
  return ok;
}

// Full setup: facts, native MAPs m=23 d=28 n=37, kill f1 (node 3).
// Returns 1 when every id matches the hand derivation.
fn l2c_setup(W:[]u8) i32 {
  let F:[]u8=z_alloc(36);
  if(l2c_world(W,F)!=1){ return 0; }
  let q3:[]u8=z_alloc(12);
  set32(q3,0,1); set32(q3,4,1); set32(q3,8,1);
  let m:i32=extn_mk_native(W,101,q3,3);
  if(m!=23){ return 0; }
  let fd:[]u8=z_alloc(4);
  set32(fd,0,get32(F,32));
  let d:i32=l2c_mk_from_facts(W,102,fd,1);
  if(d!=28){ return 0; }
  let fn2:[]u8=z_alloc(8);
  set32(fn2,0,get32(F,12)); set32(fn2,4,get32(F,16));
  let n:i32=l2c_mk_from_facts(W,102,fn2,2);
  if(n!=37){ return 0; }
  ns(W,get32(F,4),36,0);
  emit("L2C-KILL fact="); e64(get32(F,4)); emit("\n");
  return 1;
}

fn l2c_armrep(name:[]u8, ans:i32, sub:i32, ext:i32, stop:i32, fin:i32, pass:i32, allocs:i32) i32 {
  emit("ARM "); emit(name);
  emit(" ans="); e64(ans);
  emit(" sub="); e64(sub);
  emit(" ext="); e64(ext);
  emit(" stop="); e64(stop);
  emit(" final="); e64(fin);
  emit(" allocs="); e64(allocs);
  if(pass==1){ emit(" PASS\n"); } else { emit(" FAIL\n"); }
  return pass;
}

// 1 iff MAP m's relation sequence equals exp[0..L-1].
fn l2c_relseq_eq(W:[]u8, m:i32, exp:[]u8, L:i32) i32 {
  let seq:[]u8=z_alloc(32);
  let got:i32=cc_relseq(W,m,seq,8);
  if(got!=L){ return 0; }
  let i:i32=0;
  let ok:i32=1;
  while(i<L){
    if(get32(seq,i*4)!=get32(exp,i*4)){ ok=0; }
    i=i+1;
  }
  return ok;
}

// FULL: substitute-then-extend treatment. ans=107 via final MAP 133.
fn arm_full() i32 {
  let W:[]u8=l2c_freshW();
  let pass:i32=1;
  if(l2c_setup(W)!=1){ pass=0; }
  let out:[]u8=z_alloc(24);
  let ans:i32=l2c_query(W,101,70,107,1,1,out);
  let sub:i32=get32(out,0);
  let ext:i32=get32(out,4);
  let stop:i32=get32(out,8);
  let fin:i32=get32(out,12);
  if(ans!=107){ pass=0; }
  if(sub!=1){ pass=0; }
  if(ext!=3){ pass=0; }
  if(stop!=0){ pass=0; }
  if(fin!=132){ pass=0; }
  if(get32(out,16)!=76){ pass=0; }
  if(get32(out,20)!=102){ pass=0; }
  let exp:[]u8=z_alloc(32);
  let i:i32=0;
  while(i<7){ set32(exp,i*4,1); i=i+1; }
  if(l2c_relseq_eq(W,132,exp,7)!=1){ pass=0; }
  if(extn_hops_to_native(W,132)!=4){ pass=0; }
  if(extn_ult_native(W,132)!=23){ pass=0; }
  if(l2c_count_etype(W,16)!=5){ pass=0; }
  if(l2c_has_edge(W,54,16,23)!=1){ pass=0; }
  if(l2c_has_edge(W,54,16,37)!=1){ pass=0; }
  if(l2c_has_edge(W,76,16,54)!=1){ pass=0; }
  if(l2c_has_edge(W,102,16,76)!=1){ pass=0; }
  if(l2c_has_edge(W,132,16,102)!=1){ pass=0; }
  if(l2c_count_etype(W,14)!=3){ pass=0; }
  if(l2c_has_edge(W,132,14,23)!=1){ pass=0; }
  if(l2c_has_edge(W,132,14,37)!=1){ pass=0; }
  if(l2c_has_edge(W,132,14,54)!=1){ pass=0; }
  if(l2c_count_etype(W,15)!=5){ pass=0; }
  if(l2c_has_edge(W,23,15,37)!=1){ pass=0; }
  if(l2c_has_edge(W,37,15,54)!=1){ pass=0; }
  if(l2c_has_edge(W,54,15,76)!=1){ pass=0; }
  if(l2c_has_edge(W,76,15,102)!=1){ pass=0; }
  if(l2c_has_edge(W,102,15,132)!=1){ pass=0; }
  return l2c_armrep("FULL",ans,sub,ext,stop,fin,pass,hg(W,20));
}

// REUSE: query1 then the same query2; the composite must persist as
// one unit with zero re-adaptation.
fn arm_reuse() i32 {
  let W:[]u8=l2c_freshW();
  let pass:i32=1;
  if(l2c_setup(W)!=1){ pass=0; }
  let out1:[]u8=z_alloc(24);
  let ans1:i32=l2c_query(W,101,70,107,1,1,out1);
  if(ans1!=107){ pass=0; }
  let out2:[]u8=z_alloc(24);
  let ans2:i32=l2c_query(W,101,70,107,1,1,out2);
  let sub2:i32=get32(out2,0);
  let ext2:i32=get32(out2,4);
  let fin2:i32=get32(out2,12);
  if(ans2!=107){ pass=0; }
  if(sub2!=0){ pass=0; }
  if(ext2!=0){ pass=0; }
  if(fin2!=132){ pass=0; }
  if(l2c_count_etype(W,16)!=5){ pass=0; }
  if(l2c_count_etype(W,14)!=3){ pass=0; }
  if(l2c_count_etype(W,15)!=5){ pass=0; }
  if(l2c_count_maps(W)!=7){ pass=0; }
  return l2c_armrep("REUSE",ans2,sub2,ext2,get32(out2,8),fin2,pass,hg(W,20));
}

// EXTONLY: substitute disabled. Extend on the stale MAP must be
// refused by the operator precondition; trial cannot span 7 links.
fn arm_extonly() i32 {
  let W:[]u8=l2c_freshW();
  let pass:i32=1;
  if(l2c_setup(W)!=1){ pass=0; }
  let out:[]u8=z_alloc(24);
  let ans:i32=l2c_query(W,101,70,107,0,1,out);
  if(ans!=-2){ pass=0; }
  if(get32(out,0)!=0){ pass=0; }
  if(l2c_count_etype(W,16)!=0){ pass=0; }
  if(l2c_count_etype(W,14)!=0){ pass=0; }
  if(l2c_count_etype(W,15)!=0){ pass=0; }
  return l2c_armrep("EXTONLY",ans,get32(out,0),get32(out,4),get32(out,8),get32(out,12),pass,hg(W,20));
}

// SUBONLY: extend disabled. Substitute repairs staleness but the span
// stays short; no provenance is written on episode failure.
fn arm_subonly() i32 {
  let W:[]u8=l2c_freshW();
  let pass:i32=1;
  if(l2c_setup(W)!=1){ pass=0; }
  let out:[]u8=z_alloc(24);
  let ans:i32=l2c_query(W,101,70,107,1,0,out);
  if(ans!=-3){ pass=0; }
  if(get32(out,0)!=1){ pass=0; }
  if(get32(out,4)!=0){ pass=0; }
  if(get32(out,12)!=54){ pass=0; }
  if(ng(W,54,28)!=104){ pass=0; }
  if(l2c_count_etype(W,16)!=2){ pass=0; }
  if(l2c_has_edge(W,54,16,23)!=1){ pass=0; }
  if(l2c_has_edge(W,54,16,37)!=1){ pass=0; }
  if(l2c_count_etype(W,14)!=0){ pass=0; }
  if(l2c_count_etype(W,15)!=0){ pass=0; }
  return l2c_armrep("SUBONLY",ans,get32(out,0),get32(out,4),get32(out,8),get32(out,12),pass,hg(W,20));
}

// EXACT: no adaptation at all. The stale MAP is unusable and the
// generic trial cannot span the gap.
fn arm_exact() i32 {
  let W:[]u8=l2c_freshW();
  let pass:i32=1;
  if(l2c_setup(W)!=1){ pass=0; }
  let out:[]u8=z_alloc(24);
  let ans:i32=l2c_query(W,101,70,107,0,0,out);
  if(ans!=-2){ pass=0; }
  if(l2c_count_etype(W,16)!=0){ pass=0; }
  if(l2c_count_etype(W,14)!=0){ pass=0; }
  if(l2c_count_etype(W,15)!=0){ pass=0; }
  return l2c_armrep("EXACT",ans,get32(out,0),get32(out,4),get32(out,8),get32(out,12),pass,hg(W,20));
}

// FRESH: facts only, no learned MAPs. Nothing to adapt; trial fails.
fn arm_fresh() i32 {
  let W:[]u8=l2c_freshW();
  let pass:i32=1;
  let F:[]u8=z_alloc(36);
  if(l2c_world(W,F)!=1){ pass=0; }
  ns(W,get32(F,4),36,0);
  emit("L2C-KILL fact="); e64(get32(F,4)); emit("\n");
  let out:[]u8=z_alloc(24);
  let ans:i32=l2c_query(W,101,70,107,1,1,out);
  if(ans!=-2){ pass=0; }
  if(l2c_count_etype(W,16)!=0){ pass=0; }
  return l2c_armrep("FRESH",ans,get32(out,0),get32(out,4),get32(out,8),get32(out,12),pass,hg(W,20));
}

fn main() i32 {
  emit("L2C-BATTERY-START\n");
  let p:i32=0;
  p=p+arm_full();
  p=p+arm_reuse();
  p=p+arm_extonly();
  p=p+arm_subonly();
  p=p+arm_exact();
  p=p+arm_fresh();
  emit("L2C-SUMMARY pass="); e64(p); emit("/6\n");
  if(p==6){ return 0; }
  return 1;
}

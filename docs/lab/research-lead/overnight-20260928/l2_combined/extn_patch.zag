// extn_patch.zag -- EXTEND-ITER: learner-triggered iterative extension.
//
// Carry-forward from H-COMPINTEG-1 (ledger C295): frozen EXTEND-ONE
// extends a native MAP by exactly one link and retires trials, so
// multi-link chains never accumulate. EXTEND-ITER closes the loop:
// the learner extends its best native MAP once, checks the result
// against its own predicted terminal, extends again from the new
// frontier while licensed, and stops by a learner-owned rule.
// The extension COUNT is decided by the loop, never by the
// researcher per problem.
//
// Reuses: cc_relseq / cc_satisfy (un_patch), adapt_is_native /
// adapt_relseq_absent / adapt_promote (adapt_patch), t2_asm_chain /
// t2_exec / t2_lu_first / t2_trial (cc_base). Provenance of every
// extension is a type-16 adapted-from edge to its parent MAP.
// Zero new edge types, opcodes, modes, bridges, handlers,
// semantic cases.
//
// ---- OPERATOR SECTION (cognition) ----

// Lowest-id live FACT licensing a step from frontier value F:
// subject == F, relation != -999, not superseded. -1 if none.
fn extn_lic_fact(W:[]u8,F:i32)i32 {
  let n:i32=2;
  while(n<1024){
    let live:i32=ng(W,n,36);
    let tag:i32=ng(W,n,0);
    let subj:i32=ng(W,n,20);
    let rel:i32=ng(W,n,24);
    let sup:i32=is_superseded(W,n);
    let ok:i32=0;
    if(live==1){ ok=1; }
    if(ok==1 && tag!=1){ ok=0; }
    if(ok==1 && subj!=F){ ok=0; }
    if(ok==1 && rel==-999){ ok=0; }
    if(ok==1 && sup==1){ ok=0; }
    if(ok==1){ return n; }
    n=n+1;
  }
  return -1;
}

// Learner-owned starting selection: the longest fully-satisfied
// native MAP from s (no outgoing type-16 edge). Ties: lowest id.
// The operator is never told the MAP id.
fn extn_best_chain(W:[]u8,s:i32,native_only:i32)i32 {
  let best:i32=-1;
  let bestL:i32=0;
  let m:i32=2;
  while(m<1024){
    let ismap:i32=0;
    if(ng(W,m,36)==1){ if(ng(W,m,0)==20){ ismap=1; } }
    let elig:i32=ismap;
    if(elig==1 && native_only==1){ elig=adapt_is_native(W,m); }
    if(elig==1){
      let seq:[]u8=z_alloc(32);
      let L:i32=cc_relseq(W,m,seq,8);
      let sat:i32=0;
      if(L>=1){
        let vals:[]u8=z_alloc(40);
        let fids:[]u8=z_alloc(32);
        if(cc_satisfy(W,m,s,vals,fids)==L){ sat=1; }
      }
      if(sat==1 && L>bestL){ best=m; bestL=L; }
    }
    m=m+1;
  }
  return best;
}

// White-box chain description of MAP m from s: relation sequence
// seq[0..L-1], value chain vals[0..L], licensing facts fids[0..L-1].
// Returns L, or -1 when m is not a fully satisfiable chain.
fn extn_describe(W:[]u8,m:i32,s:i32,seq:[]u8,vals:[]u8,fids:[]u8)i32 {
  let L:i32=cc_relseq(W,m,seq,8);
  if(L<1){ return -1; }
  if(cc_satisfy(W,m,s,vals,fids)!=L){ return -1; }
  return L;
}

// One extension step. Parent chain is (seq,vals,fids,L).
// Returns the new adapted MAP id, or -1 with rc[0] set:
// 1 NOFRONTIER, 2 EXECFAIL, 3 DUP. rc[4]=frontier, rc[8]=rnew,
// rc[12]=vnext on success.
fn extn_step(W:[]u8,s:i32,parent:i32,seq:[]u8,vals:[]u8,fids:[]u8,L:i32,rc:[]u8)i32 {
  set32(rc,0,0); set32(rc,4,0); set32(rc,8,0); set32(rc,12,0);
  let fr:i32=get32(vals,L*4);
  set32(rc,4,fr);
  let fn2:i32=extn_lic_fact(W,fr);
  if(fn2<0){ set32(rc,0,1); return -1; }
  let rnew:i32=ng(W,fn2,24);
  let vnext:i32=ng(W,fn2,28);
  set32(rc,8,rnew); set32(rc,12,vnext);
  if(adapt_relseq_absent(W,seq,L,rnew)==0){ set32(rc,0,3); return -1; }
  let vv:[]u8=z_alloc(40);
  let ff:[]u8=z_alloc(32);
  let j:i32=0;
  while(j<=L){ set32(vv,j*4,get32(vals,j*4)); j=j+1; }
  set32(vv,(L+1)*4,vnext);
  j=0;
  while(j<L){ set32(ff,j*4,get32(fids,j*4)); j=j+1; }
  set32(ff,L*4,fn2);
  let root:i32=t2_asm_chain(W,vv,L+2,ff);
  if(root<0){ set32(rc,0,2); return -1; }
  if(t2_exec(W,root,s)!=vnext){ set32(rc,0,2); return -1; }
  let af:[]u8=z_alloc(32);
  j=0;
  while(j<=L){ set32(af,j*4,get32(ff,j*4)); j=j+1; }
  let am:i32=adapt_promote(W,root,s,ng(W,parent,4),vnext,af,L+1);
  if(am<0){ set32(rc,0,2); return -1; }
  link_edge(W,am,16,parent,0);
  return am;
}

// EXTEND-ITER: the claimed operator. No count parameter; the loop
// decides. Returns the best terminal reached; out[0]=extensions,
// out[1]=stop reason (0 TERM, 1 NOFRONTIER, 2 EXECFAIL, 3 BUDGET),
// out[2]=final MAP id.
fn extn_extend_iter(W:[]u8,s:i32,expected:i32,out:[]u8)i32 {
  set32(out,0,0); set32(out,4,3); set32(out,8,-1);
  let m0:i32=extn_best_chain(W,s,1);
  if(m0<0){
    emit("EXTN-NONATIVE\n");
    return -3;
  }
  let seq:[]u8=z_alloc(32);
  let vals:[]u8=z_alloc(40);
  let fids:[]u8=z_alloc(32);
  let L:i32=extn_describe(W,m0,s,seq,vals,fids);
  if(L<0){
    emit("EXTN-NODESCRIBE\n");
    return -3;
  }
  let term:i32=get32(vals,L*4);
  emit("EXTN-QUERY s="); e64(s); emit(" goal="); e64(expected);
  emit(" start="); e64(m0); emit(" startplen="); e64(L); emit("\n");
  let mcur:i32=m0;
  let ext:i32=0;
  let stop:i32=3;
  let done:i32=0;
  while(done==0){
    if(term==expected){ stop=0; done=1; }
    if(done==0 && ext>=8){ stop=3; done=1; }
    if(done==0){
      let rc:[]u8=z_alloc(16);
      let am:i32=extn_step(W,s,mcur,seq,vals,fids,L,rc);
      let why:i32=get32(rc,0);
      if(am<0){ stop=why; done=1; }
      else {
        let nL:i32=extn_describe(W,am,s,seq,vals,fids);
        let bad:i32=0;
        if(nL!=L+1){ bad=1; }
        if(bad==1){ stop=2; done=1; }
        else {
          emit("EXTN-STEP n="); e64(ext+1);
          emit(" parent="); e64(mcur);
          emit(" id="); e64(am);
          emit(" plen="); e64(L+1);
          emit(" lic="); e64(get32(rc,4)); emit(",");
          e64(get32(rc,8)); emit(","); e64(get32(rc,12));
          emit(" term="); e64(get32(rc,12)); emit("\n");
          L=nL; mcur=am; term=get32(vals,L*4); ext=ext+1;
        }
      }
    }
  }
  emit("EXTN-STOP reason="); e64(stop);
  emit(" ext="); e64(ext);
  emit(" ans="); e64(term);
  emit(" final="); e64(mcur); emit("\n");
  set32(out,0,ext); set32(out,4,stop); set32(out,8,mcur);
  return term;
}

// ---- ABLATION SCAFFOLD (not the claimed operator) ----
// extn_extend_iter_norule: byte-identical loop logic except the
// TERM check is removed. NOFRONTIER / EXECFAIL / BUDGET remain so
// it always terminates. Used only by arm A1.
fn extn_extend_iter_norule(W:[]u8,s:i32,expected:i32,out:[]u8)i32 {
  set32(out,0,0); set32(out,4,3); set32(out,8,-1);
  let m0:i32=extn_best_chain(W,s,1);
  if(m0<0){
    emit("EXTN-NONATIVE\n");
    return -3;
  }
  let seq:[]u8=z_alloc(32);
  let vals:[]u8=z_alloc(40);
  let fids:[]u8=z_alloc(32);
  let L:i32=extn_describe(W,m0,s,seq,vals,fids);
  if(L<0){
    emit("EXTN-NODESCRIBE\n");
    return -3;
  }
  let term:i32=get32(vals,L*4);
  emit("EXTN-QUERY s="); e64(s); emit(" goal="); e64(expected);
  emit(" start="); e64(m0); emit(" startplen="); e64(L); emit("\n");
  let mcur:i32=m0;
  let ext:i32=0;
  let stop:i32=3;
  let done:i32=0;
  while(done==0){
    if(ext>=8){ stop=3; done=1; }
    if(done==0){
      let rc:[]u8=z_alloc(16);
      let am:i32=extn_step(W,s,mcur,seq,vals,fids,L,rc);
      let why:i32=get32(rc,0);
      if(am<0){ stop=why; done=1; }
      else {
        let nL:i32=extn_describe(W,am,s,seq,vals,fids);
        let bad:i32=0;
        if(nL!=L+1){ bad=1; }
        if(bad==1){ stop=2; done=1; }
        else {
          emit("EXTN-STEP n="); e64(ext+1);
          emit(" parent="); e64(mcur);
          emit(" id="); e64(am);
          emit(" plen="); e64(L+1);
          emit(" lic="); e64(get32(rc,4)); emit(",");
          e64(get32(rc,8)); emit(","); e64(get32(rc,12));
          emit(" term="); e64(get32(rc,12)); emit("\n");
          L=nL; mcur=am; term=get32(vals,L*4); ext=ext+1;
        }
      }
    }
  }
  emit("EXTN-STOP reason="); e64(stop);
  emit(" ext="); e64(ext);
  emit(" ans="); e64(term);
  emit(" final="); e64(mcur); emit("\n");
  set32(out,0,ext); set32(out,4,stop); set32(out,8,mcur);
  return term;
}

// ---- CONTROL SCAFFOLD (not the claimed operator) ----

// C1: frozen EXTEND-ONE single pass, then the longest satisfiable
// chain (native or adapted) answers, or -3 on mismatch.
fn extn_ctrl_one(W:[]u8,s:i32,expected:i32,out:[]u8)i32 {
  let m0:i32=extn_best_chain(W,s,1);
  let nmk:i32=0;
  if(m0>=0){ nmk=adapt_extend(W,s,0); }
  let best:i32=extn_best_chain(W,s,0);
  let bestT:i32=-999999;
  let bestL:i32=0;
  if(best>=0){
    let seq:[]u8=z_alloc(32);
    let vals:[]u8=z_alloc(40);
    let fids:[]u8=z_alloc(32);
    bestL=extn_describe(W,best,s,seq,vals,fids);
    if(bestL>=1){ bestT=get32(vals,bestL*4); }
  }
  emit("EXTN-ONE nmk="); e64(nmk); emit(" best="); e64(best);
  emit(" bestplen="); e64(bestL); emit(" bestterm="); e64(bestT); emit("\n");
  set32(out,0,nmk); set32(out,4,best); set32(out,8,bestL);
  if(bestT==expected){ return bestT; }
  return -3;
}

// C2: fresh learner. No native MAP is taught; the only tool is the
// frozen generic miss policy t2_trial.
fn extn_ctrl_fresh(W:[]u8,s:i32,expected:i32)i32 {
  return t2_trial(W,s,1,expected,0,0,0);
}

// ---- PRIOR-KNOWLEDGE SCAFFOLD (world/prior setup, not cognition) ----

// Teach a native MAP with relation sequence seq[0..L-1] walkable
// from s. No type-16 edge: it is native. No fact is taught.
fn extn_mk_native(W:[]u8,s:i32,seq:[]u8,L:i32)i32 {
  let vals:[]u8=z_alloc(40);
  let fids:[]u8=z_alloc(32);
  set32(vals,0,s);
  let cur:i32=s;
  let i:i32=0;
  let ok:i32=1;
  while(i<L){
    let fnd:i32=t2_lu_first(W,cur,get32(seq,i*4));
    if(fnd<0){ ok=0; }
    else {
      set32(vals,(i+1)*4,ng(W,fnd,28));
      set32(fids,i*4,fnd);
      cur=ng(W,fnd,28);
    }
    i=i+1;
  }
  if(ok==0){ return -1; }
  let root:i32=t2_asm_chain(W,vals,L+1,fids);
  if(root<0){ return -1; }
  let am:i32=adapt_promote(W,root,s,get32(seq,0),cur,fids,L);
  emit("EXTN-NATIVE id="); e64(am); emit(" plen="); e64(L);
  emit(" term="); e64(cur); emit("\n");
  return am;
}

// type-16 adapted-from target of MAP a, or -1.
fn extn_src16(W:[]u8,a:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==16){ return eg(W,e,8); }
    e=e+1;
  }
  return -1;
}

// Hops on type-16 edges from fin back to a native MAP; -1 broken.
fn extn_hops_to_native(W:[]u8,fin:i32)i32 {
  let hops:i32=0;
  let cur:i32=fin;
  let guard:i32=0;
  let broken:i32=0;
  while(guard<16){
    if(adapt_is_native(W,cur)==1){ guard=16; }
    else {
      let p:i32=extn_src16(W,cur);
      if(p<0){ broken=1; guard=16; }
      else { cur=p; hops=hops+1; guard=guard+1; }
    }
  }
  if(broken==1){ return -1; }
  return hops;
}

// Ultimate native ancestor of fin via type-16 hops; -1 broken.
fn extn_ult_native(W:[]u8,fin:i32)i32 {
  let cur:i32=fin;
  let guard:i32=0;
  while(guard<16){
    if(adapt_is_native(W,cur)==1){ return cur; }
    let p:i32=extn_src16(W,cur);
    if(p<0){ return -1; }
    cur=p; guard=guard+1;
  }
  return -1;
}

// 1 iff MAP m's relation sequence equals exp[0..L-1].
fn extn_relseq_eq(W:[]u8,m:i32,exp:[]u8,L:i32)i32 {
  let seq:[]u8=z_alloc(32);
  let got:i32=cc_relseq(W,m,seq,8);
  if(got!=L){ return 0; }
  let i:i32=0;
  let ok:i32=1;
  while(i<L){
    if(get32(seq,i*4)!=get32(exp,i*4)){ ok=0; }
    i=i+1;
  }
  return ok;
}

// Count of live adapted MAPs (outgoing type-16 edge).
fn extn_count_adapted(W:[]u8)i32 {
  let c:i32=0;
  let m:i32=2;
  while(m<1024){
    let ismap:i32=0;
    if(ng(W,m,36)==1){ if(ng(W,m,0)==20){ ismap=1; } }
    if(ismap==1 && adapt_is_native(W,m)==0){ c=c+1; }
    m=m+1;
  }
  return c;
}

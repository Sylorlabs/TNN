// l2c_patch.zag -- L2-COMBINED: substitute-then-extend in one pipeline.
//
// Claim: one learner fires TWO different L2 adaptation operators in a
// single query pipeline, the later operating on the earlier's output.
// A chain MAP that is BOTH stale in the middle (dead licensing fact)
// AND too short for the query span is repaired by SUBSTITUTE followed
// by iterative EXTEND. Provenance: type-16 adapted-from per step,
// LINK14 from the final composite to each composed segment, type-15
// co-use for consecutive delivery pairs. 0 new edge types, opcodes,
// modes, bridges, handlers, semantic cases, node tags.
//
// Reuses (verbatim semantics): l2c_map_facts/l2c_stale_hop drive the
// C298 stale-detect/split/search/assemble/verify/promote flow;
// extn_step (extn_patch) is the C301 iterative extension step;
// adapt_promote + type-16 is the established adapted-from linkage.
// The sub_on/ext_on flags are DRIVER-SET causal controls for the
// ablation arms only (l2_substitute SUB_ON/ET_ON precedent), never
// written by the learner; in the treatment arm both are 1 and every
// firing is learner-triggered by its own checks.
//
// ---- OPERATOR SECTION (cognition) ----

// Licensing fact ids of MAP m in hop order (type-1 edge allocation
// order). Returns the hop count.
fn l2c_map_facts(W:[]u8, m:i32, fbuf:[]u8) i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      set32(fbuf,c*4,eg(W,e,8));
      c=c+1;
    }
    e=e+1;
  }
  return c;
}

// First hop whose licensing fact is dead (tag 1 and live flag).
// -1 when the whole chain is live.
fn l2c_stale_hop(W:[]u8, fbuf:[]u8, L:i32) i32 {
  let h:i32=0;
  while(h<L){
    let f:i32=get32(fbuf,h*4);
    let live:i32=0;
    if(ng(W,f,36)==1){ if(ng(W,f,0)==1){ live=1; } }
    if(live==0){ return h; }
    h=h+1;
  }
  return -1;
}

// Learner-owned starting selection: an exact terminal match wins at
// once; otherwise the longest chain from s; ties go to the lowest id.
// The operator is never told a MAP id.
fn l2c_select(W:[]u8, s:i32, goal:i32) i32 {
  let best:i32=-1;
  let bestL:i32=0;
  let fb:[]u8=z_alloc(32);
  let m:i32=2;
  while(m<1024){
    let elig:i32=0;
    if(ng(W,m,36)==1){ if(ng(W,m,0)==20){ if(ng(W,m,8)==s){ elig=1; } } }
    if(elig==1){
      if(ng(W,m,28)==goal){ return m; }
      let L:i32=l2c_map_facts(W,m,fb);
      if(L>bestL){ best=m; bestL=L; }
    }
    m=m+1;
  }
  return best;
}

// One substitute-candidate check. Emits its own trace line. 1 on match.
fn l2c_cand_ok(W:[]u8, cid:i32, m:i32, seg_s:i32, seg_e:i32) i32 {
  emit("SUB-CAND id="); e64(cid);
  if(cid==m){ emit(" skip=self\n"); return 0; }
  let cs:i32=ng(W,cid,8);
  let ce:i32=ng(W,cid,28);
  let epok:i32=0;
  if(cs==seg_s){ if(ce==seg_e){ epok=1; } }
  if(epok==0){
    emit(" s="); e64(cs); emit(" e="); e64(ce); emit(" skip=ep\n");
    return 0;
  }
  let cf:[]u8=z_alloc(32);
  let cfl:i32=l2c_map_facts(W,cid,cf);
  let ok:i32=1;
  let flc:i32=0;
  let j:i32=0;
  while(j<cfl){
    let lf:i32=get32(cf,j*4);
    flc=flc+1;
    if(ng(W,lf,36)!=1){ ok=0; }
    j=j+1;
  }
  if(ok==0){
    emit(" s="); e64(cs); emit(" e="); e64(ce); emit(" skip=deadfact\n");
    return 0;
  }
  emit(" s="); e64(cs); emit(" e="); e64(ce);
  emit(" flive="); e64(flc); emit(" MATCH\n");
  return 1;
}

// SUBSTITUTE operator (C298 semantics on this substrate). m is stale
// at hop sh; fbuf holds its L licensing facts in hop order.
// Splits at the dead hop, searches the learner's own inventory in
// node-id order for the first live endpoint-matching piece, assembles
// prefix+piece+suffix, verifies by real execution to m's stored
// terminal, and promotes with type-16 to m and to the piece.
// sout[0]=new MAP id, sout[1]=piece id. Returns new id or -1.
fn l2c_substitute(W:[]u8, s:i32, m:i32, fbuf:[]u8, L:i32, sh:i32, sout:[]u8) i32 {
  set32(sout,0,-1); set32(sout,4,-1);
  let pre_f:[]u8=z_alloc(32);
  let pre_n:i32=0;
  let h:i32=0;
  while(h<sh){
    set32(pre_f,pre_n*4,get32(fbuf,h*4));
    pre_n=pre_n+1; h=h+1;
  }
  let dfact:i32=get32(fbuf,sh*4);
  let seg_s:i32=ng(W,dfact,20);
  let seg_e:i32=ng(W,dfact,28);
  let suf_f:[]u8=z_alloc(32);
  let suf_n:i32=0;
  h=sh+1;
  while(h<L){
    set32(suf_f,suf_n*4,get32(fbuf,h*4));
    suf_n=suf_n+1; h=h+1;
  }
  let piece:i32=-1;
  let cid:i32=2;
  while(cid<1024 && piece<0){
    let ismap:i32=0;
    if(ng(W,cid,36)==1){ if(ng(W,cid,0)==20){ ismap=1; } }
    if(ismap==1){
      if(l2c_cand_ok(W,cid,m,seg_s,seg_e)==1){ piece=cid; }
    }
    cid=cid+1;
  }
  if(piece<0){ emit("SUB-NOPIECE\n"); return -1; }
  let af:[]u8=z_alloc(96);
  let av:[]u8=z_alloc(100);
  let rb:[]u8=z_alloc(96);
  set32(av,0,s);
  let an:i32=0;
  h=0;
  while(h<pre_n){
    let pf:i32=get32(pre_f,h*4);
    set32(af,an*4,pf);
    set32(rb,an*4,ng(W,pf,24));
    set32(av,(an+1)*4,ng(W,pf,28));
    an=an+1; h=h+1;
  }
  let pcf:[]u8=z_alloc(32);
  let pcfl:i32=l2c_map_facts(W,piece,pcf);
  h=0;
  while(h<pcfl){
    let qf:i32=get32(pcf,h*4);
    set32(af,an*4,qf);
    set32(rb,an*4,ng(W,qf,24));
    set32(av,(an+1)*4,ng(W,qf,28));
    an=an+1; h=h+1;
  }
  h=0;
  while(h<suf_n){
    let sf:i32=get32(suf_f,h*4);
    set32(af,an*4,sf);
    set32(rb,an*4,ng(W,sf,24));
    set32(av,(an+1)*4,ng(W,sf,28));
    an=an+1; h=h+1;
  }
  let cur:i32=s;
  let cg:i32=0;
  let cok:i32=1;
  while(cg<an){
    let gf:i32=get32(af,cg*4);
    if(ng(W,gf,20)!=cur){ cok=0; }
    cur=ng(W,gf,28);
    cg=cg+1;
  }
  if(cok==0){ emit("SUB-DISCONT\n"); return -1; }
  emit("SUB-BUILD rels=");
  h=0;
  while(h<an){
    e64(get32(rb,h*4));
    if(h<an-1){ emit(","); }
    h=h+1;
  }
  emit(" facts=");
  h=0;
  while(h<an){
    e64(get32(af,h*4));
    if(h<an-1){ emit(","); }
    h=h+1;
  }
  emit("\n");
  let term0:i32=ng(W,m,28);
  let root:i32=t2_asm_chain(W,av,an+1,af);
  if(root<0){ emit("SUB-ASMFAIL\n"); return -1; }
  let vt:i32=t2_exec(W,root,s);
  emit("SUB-VERIFY term="); e64(vt); emit("\n");
  if(vt!=term0){ emit("SUB-VERFAIL\n"); return -1; }
  let m2id:i32=adapt_promote(W,root,s,ng(W,m,4),term0,af,an);
  if(m2id<0){ emit("SUB-PROFAIL\n"); return -1; }
  link_edge(W,m2id,16,m,0);
  link_edge(W,m2id,16,piece,0);
  emit("SUB-PROMOTE m2="); e64(m2id); emit("\n");
  set32(sout,0,m2id); set32(sout,4,piece);
  return m2id;
}

// EXTEND-ITER from a given start MAP (C301 loop with the start MAP
// parameterized, so it operates on the substitute's output MAP).
// Reuses extn_step verbatim. out[1]=ext, out[2]=stop, out[3]=final;
// extids[0..2] collect the extension MAP ids. Returns the terminal.
// A start MAP that is not fully satisfiable is refused: extending a
// stale MAP is the wrong order, and the refusal is the order bar.
fn l2c_extend_from(W:[]u8, s:i32, goal:i32, startm:i32, out:[]u8, extids:[]u8) i32 {
  set32(out,4,0); set32(out,8,3); set32(out,12,-1);
  set32(extids,0,-1); set32(extids,4,-1); set32(extids,8,-1);
  let seq:[]u8=z_alloc(32);
  let vals:[]u8=z_alloc(64);
  let fids:[]u8=z_alloc(32);
  let L:i32=extn_describe(W,startm,s,seq,vals,fids);
  if(L<0){
    emit("EXTN-REFUSE-STALE m="); e64(startm); emit("\n");
    return -3;
  }
  let term:i32=get32(vals,L*4);
  let mcur:i32=startm;
  let ext:i32=0;
  let stop:i32=3;
  let done:i32=0;
  while(done==0){
    if(term==goal){ stop=0; done=1; }
    if(done==0 && ext>=8){ stop=3; done=1; }
    if(done==0){
      let rc:[]u8=z_alloc(16);
      let am:i32=extn_step(W,s,mcur,seq,vals,fids,L,rc);
      let why:i32=get32(rc,0);
      if(am<0){ stop=why; done=1; }
      else {
        let nL:i32=extn_describe(W,am,s,seq,vals,fids);
        let bad:i32=0;
        if(nL!=L+1){ bad=1; }
        if(bad==1){ stop=2; done=1; }
        else {
          emit("EXTN-STEP n="); e64(ext+1);
          emit(" parent="); e64(mcur);
          emit(" id="); e64(am);
          emit(" plen="); e64(L+1);
          emit(" lic="); e64(get32(rc,4)); emit(",");
          e64(get32(rc,8)); emit(","); e64(get32(rc,12));
          emit(" term="); e64(get32(rc,12)); emit("\n");
          if(ext<3){ set32(extids,ext*4,am); }
          L=nL; mcur=am; term=get32(vals,L*4); ext=ext+1;
        }
      }
    }
  }
  emit("EXTN-STOP reason="); e64(stop);
  emit(" ext="); e64(ext);
  emit(" ans="); e64(term);
  emit(" final="); e64(mcur); emit("\n");
  set32(out,4,ext); set32(out,8,stop); set32(out,12,mcur);
  return term;
}

// Provenance on episode success: LINK14 from the final composite to
// each composed segment; type-15 co-use for consecutive delivery
// pairs. Only established edge types are used.
fn l2c_deliver(W:[]u8, mfin:i32, msrc:i32, piece:i32, m2id:i32, ext1:i32, ext2:i32) void {
  link_edge(W,mfin,14,msrc,0);
  link_edge(W,mfin,14,piece,0);
  link_edge(W,mfin,14,m2id,0);
  link_edge(W,msrc,15,piece,0);
  link_edge(W,piece,15,m2id,0);
  link_edge(W,m2id,15,ext1,0);
  link_edge(W,ext1,15,ext2,0);
  link_edge(W,ext2,15,mfin,0);
  return;
}

// Combined pipeline: select -> stale-check -> SUBSTITUTE -> span-check
// -> EXTEND-ITER -> verify -> provenance -> answer. The later
// adaptation operates on the earlier one's output MAP in one query.
// out[0]=sub_fired, out[1]=ext, out[2]=stop, out[3]=final,
// out[4]=ext1, out[5]=ext2.
fn l2c_query(W:[]u8, s:i32, r:i32, goal:i32, sub_on:i32, ext_on:i32, out:[]u8) i32 {
  set32(out,0,0); set32(out,4,0); set32(out,8,3); set32(out,12,-1);
  set32(out,16,-1); set32(out,20,-1);
  emit("L2C-QUERY s="); e64(s); emit(" goal="); e64(goal); emit("\n");
  let m0:i32=l2c_select(W,s,goal);
  if(m0<0){
    emit("L2C-NOSEL\n");
    return t2_trial(W,s,r,goal,0,0,0);
  }
  let fb:[]u8=z_alloc(32);
  let L0:i32=l2c_map_facts(W,m0,fb);
  emit("L2C-SEL m="); e64(m0); emit(" plen="); e64(L0);
  emit(" term="); e64(ng(W,m0,28)); emit("\n");
  let mcur:i32=m0;
  let piece:i32=-1;
  let m2id:i32=-1;
  let term:i32=ng(W,m0,28);
  let sh:i32=l2c_stale_hop(W,fb,L0);
  if(sh>=0){
    emit("SUB-STALE m="); e64(m0); emit(" hop="); e64(sh);
    emit(" fact="); e64(get32(fb,sh*4)); emit("\n");
    if(sub_on==1){
      let sout:[]u8=z_alloc(8);
      m2id=l2c_substitute(W,s,m0,fb,L0,sh,sout);
      if(m2id<0){ emit("L2C-SUBFAIL\n"); return -4; }
      piece=get32(sout,4);
      set32(out,0,1);
      mcur=m2id;
      term=ng(W,mcur,28);
    } else {
      if(ext_on==1){
        emit("L2C-SPAN term="); e64(term); emit(" goal="); e64(goal);
        emit(" EXTEND\n");
        let extids:[]u8=z_alloc(12);
        l2c_extend_from(W,s,goal,m0,out,extids);
      }
      emit("L2C-UNUSABLE m="); e64(m0); emit("\n");
      return t2_trial(W,s,r,goal,0,0,0);
    }
  }
  emit("L2C-SPAN term="); e64(term); emit(" goal="); e64(goal);
  if(term==goal){
    emit(" OK\n");
  } else {
    if(ext_on==1){
      emit(" EXTEND\n");
      let extids:[]u8=z_alloc(12);
      let et:i32=l2c_extend_from(W,s,goal,mcur,out,extids);
      if(et!=goal){
        return t2_trial(W,s,r,goal,0,0,0);
      }
      mcur=get32(out,12);
      term=et;
      set32(out,16,get32(extids,0));
      set32(out,20,get32(extids,4));
    } else {
      emit(" SHORTFALL\n");
      set32(out,12,mcur);
      return -3;
    }
  }
  set32(out,12,mcur);
  let vb:[]u8=z_alloc(64);
  let fbb:[]u8=z_alloc(32);
  let vl:i32=cc_satisfy(W,mcur,s,vb,fbb);
  let vok:i32=0;
  if(vl>=1){ if(get32(vb,vl*4)==goal){ vok=1; } }
  if(vok==0){ emit("L2C-VERFAIL\n"); return -4; }
  emit("L2C-VERIFY term="); e64(goal); emit(" OK\n");
  if(get32(out,0)==1){
    l2c_deliver(W,mcur,m0,piece,m2id,get32(out,16),get32(out,20));
  }
  emit("L2C-ANS via="); e64(mcur); emit(" val="); e64(term); emit("\n");
  return term;
}

// ---- AUDIT HELPERS (experiment side) ----

fn l2c_count_etype(W:[]u8, t:i32) i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==t){ c=c+1; }
    e=e+1;
  }
  return c;
}

fn l2c_has_edge(W:[]u8, a:i32, t:i32, b:i32) i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==t && eg(W,e,8)==b){ return 1; }
    e=e+1;
  }
  return 0;
}

fn l2c_count_maps(W:[]u8) i32 {
  let c:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){ c=c+1; }
    m=m+1;
  }
  return c;
}

// ---- PRIOR-KNOWLEDGE SCAFFOLD (world/prior setup, not cognition) ----

// Teach a native MAP from explicit licensing fact ids. No type-16:
// it is native. Facts must be live and chain-continuous.
fn l2c_mk_from_facts(W:[]u8, s:i32, fids:[]u8, L:i32) i32 {
  let vals:[]u8=z_alloc(64);
  set32(vals,0,s);
  let cur:i32=s;
  let i:i32=0;
  let ok:i32=1;
  while(i<L){
    let f:i32=get32(fids,i*4);
    if(ng(W,f,36)!=1){ ok=0; }
    if(ng(W,f,0)!=1){ ok=0; }
    if(ng(W,f,20)!=cur){ ok=0; }
    if(ok==1){
      set32(vals,(i+1)*4,ng(W,f,28));
      cur=ng(W,f,28);
    }
    i=i+1;
  }
  if(ok==0){ return -1; }
  let root:i32=t2_asm_chain(W,vals,L+1,fids);
  if(root<0){ return -1; }
  let am:i32=adapt_promote(W,root,s,ng(W,get32(fids,0),24),cur,fids,L);
  emit("L2C-NATIVE id="); e64(am); emit(" plen="); e64(L);
  emit(" term="); e64(cur); emit("\n");
  return am;
}

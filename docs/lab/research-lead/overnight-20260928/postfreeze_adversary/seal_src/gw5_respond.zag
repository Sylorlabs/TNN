@import("substrate/R33_NATIVE_IO_V1.zag")

// ============================================================
// gw5_respond.zag - GW5 single-stage responder (world-side logic).
// Reads a learner stdout transcript (argv[1]) and decides which
// file the stage releases next, per ADVERSARY_DESIGN.md:
//
// Release gw5_phaseB1.txt (the missing-link reveal) iff some
// transcript line is exactly "CHOICE 30" (a genuine
// learner-chosen inquiry act in phase A); otherwise release
// gw5_phaseB2.txt (control: unrelated junk fact).
//
// Prints "RELEASE <file>" to stdout. Exits 2 on I/O failure.
// ============================================================

fn lines_equal(a:[]u8, b:[]u8) i32 {
    if (a.len != b.len) { return 0; }
    let i:i64 = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// decide returns 1 when some line is exactly "CHOICE 30", else 0
fn decide(content:[]u8) i64 {
    let target:[]u8 = "CHOICE 30";
    let i:i64 = 0;
    let start:i64 = 0;
    while (i <= content.len) {
        if (i == content.len || content[i] == (10 as u8)) {
            let ln:[]u8 = content[start..i];
            // strip trailing carriage return if present
            if (ln.len > 0 && ln[ln.len - 1] == (13 as u8)) {
                ln = ln[0..ln.len - 1];
            }
            if (lines_equal(ln, target) == 1) {
                return 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn read_all(path:[]u8) []u8 {
    let fd:i64 = _zag_raw_syscall(2, _zag_slice_ptr(path) as i64, 0, 0, 0, 0, 0);
    if (fd < 0) {
        let e:[]u8 = nio_alloc(1);
        return e[0..0];
    }
    let cap:i64 = 65536;
    let buf:[]u8 = nio_alloc(cap as i32);
    if (buf.len == 0) { _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0); let e2:[]u8 = nio_alloc(1); return e2[0..0]; }
    let total:i64 = 0;
    while (total < cap) {
        let r:i64 = _zag_raw_syscall(0, fd, (_zag_slice_ptr(buf) as i64) + total, cap - total, 0, 0, 0);
        if (r <= 0) { break; }
        total = total + r;
    }
    _zag_raw_syscall(3, fd, 0, 0, 0, 0, 0);
    return buf[0..total];
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (a1.len == 0) {
        _zag_println("usage: gw5_respond <transcript>");
        return 2;
    }
    let content:[]u8 = read_all(a1);
    if (content.len == 0) {
        _zag_println("read failed");
        return 2;
    }
    if (decide(content) == 1) {
        _zag_println("RELEASE gw5_phaseB1.txt");
    } else {
        _zag_println("RELEASE gw5_phaseB2.txt");
    }
    return 0;
}

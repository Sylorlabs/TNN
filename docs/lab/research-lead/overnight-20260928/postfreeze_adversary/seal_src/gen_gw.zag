@import("substrate/R33_NATIVE_IO_V1.zag")

// ============================================================
// gen_gw.zag - GW1-GW8 post-freeze adversarial world generator.
// Implements postfreeze_adversary/ADVERSARY_DESIGN.md exactly.
// Writes 11 world files into the directory given as argv[1].
// Every computed value (GW2 doubling products) is calculated here
// in Zag; nothing is transcribed by hand. GW id range [40000,49999],
// disjoint per world in 100-id blocks. Pure Zag, pinned znc.
// ============================================================

// ---- text buffer append helpers ----
fn app_str(buf:[]u8, pos:i64, s:[]u8) i64 {
    let i:i64 = 0;
    while (i < s.len) { buf[pos + i] = s[i]; i = i + 1; }
    return pos + s.len;
}
fn app_i64(buf:[]u8, pos:i64, v:i64) i64 {
    if (v < 0) { buf[pos] = 45 as u8; pos = pos + 1; v = 0 - v; }
    if (v == 0) { buf[pos] = 48 as u8; return pos + 1; }
    let div:i64 = 1;
    while (v / div >= 10) { div = div * 10; }
    while (div >= 1) {
        let d:i64 = v / div;
        buf[pos] = (48 + d) as u8; pos = pos + 1;
        v = v - d * div; div = div / 10;
    }
    return pos;
}
fn ev_observe(buf:[]u8, pos:i64, s:i64, r:i64, o:i64) i64 {
    pos = app_str(buf, pos, "OBSERVE ");
    pos = app_i64(buf, pos, s);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, r);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, o);
    return app_str(buf, pos, "\n");
}
fn ev_query(buf:[]u8, pos:i64, s:i64, r:i64, o:i64) i64 {
    pos = app_str(buf, pos, "QUERY ");
    pos = app_i64(buf, pos, s);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, r);
    pos = app_str(buf, pos, " ");
    pos = app_i64(buf, pos, o);
    return app_str(buf, pos, "\n");
}
fn ev_act(buf:[]u8, pos:i64) i64 {
    return app_str(buf, pos, "ACT\n");
}

// ---- file writer (O_EXCL create; caller ensures fresh dir) ----
fn write_file(dir:[]u8, name:[]u8, buf:[]u8, len:i64) i64 {
    let root:i64 = nio_open_root(dir);
    if (root < 0) { return -1; }
    let fd:i64 = nio_open_child(root, name, 1);
    nio_close(root);
    if (fd < 0) { return -2; }
    let w:i64 = nio_write_all(fd, buf[0..len]);
    nio_close(fd);
    if (w != len) { return -4; }
    return 0;
}
fn z_copy(s:[]u8) []u8 {
    let b:[]u8 = nio_alloc((s.len + 1) as i32);
    if (b.len == 0) { return b; }
    let i:i64 = 0;
    while (i < s.len) { b[i] = s[i]; i = i + 1; }
    b[s.len] = 0 as u8;
    return b[0..s.len];
}

// ---- GW1: depth-5 chains vs 4-hop control; 17 lines ----
fn gen_gw1(buf:[]u8) i64 {
    let pos:i64 = 0;
    let r:i64 = 40051;
    let rc:i64 = 40052;
    // control: 4-hop chain, answer 60
    pos = ev_observe(buf, pos, 40001, r, 40002);
    pos = ev_observe(buf, pos, 40002, r, 40003);
    pos = ev_observe(buf, pos, 40003, r, 40004);
    pos = ev_observe(buf, pos, 40004, r, 60);
    pos = ev_query(buf, pos, 40001, rc, 60);
    // test 1: 5-hop chain, answer 50
    pos = ev_observe(buf, pos, 40021, r, 40022);
    pos = ev_observe(buf, pos, 40022, r, 40023);
    pos = ev_observe(buf, pos, 40023, r, 40024);
    pos = ev_observe(buf, pos, 40024, r, 40025);
    pos = ev_observe(buf, pos, 40025, r, 50);
    pos = ev_query(buf, pos, 40021, rc, 50);
    // test 2: 5-hop chain, answer 70
    pos = ev_observe(buf, pos, 40031, r, 40032);
    pos = ev_observe(buf, pos, 40032, r, 40033);
    pos = ev_observe(buf, pos, 40033, r, 40034);
    pos = ev_observe(buf, pos, 40034, r, 40035);
    pos = ev_observe(buf, pos, 40035, r, 70);
    pos = ev_query(buf, pos, 40031, rc, 70);
    return pos;
}

// ---- doubling helper: seed * 2^times, computed in-generator ----
fn dbl(seed:i64, times:i64) i64 {
    let p:i64 = 1;
    let i:i64 = 0;
    while (i < times) { p = p * 2; i = i + 1; }
    return seed * p;
}

// ---- GW2: iterative doubling (cyclic structure); 6 lines ----
fn gen_gw2(buf:[]u8) i64 {
    let pos:i64 = 0;
    let rseed:i64 = 40111;
    let rtimes:i64 = 40112;
    let rdbl:i64 = 40113;
    pos = ev_observe(buf, pos, 40101, rseed, 3);
    pos = ev_observe(buf, pos, 40101, rtimes, 4);
    pos = ev_query(buf, pos, 40101, rdbl, dbl(3, 4));
    pos = ev_observe(buf, pos, 40102, rseed, 5);
    pos = ev_observe(buf, pos, 40102, rtimes, 3);
    pos = ev_query(buf, pos, 40102, rdbl, dbl(5, 3));
    return pos;
}

// ---- GW3: hierarchical reuse + revision propagation; 10 lines ----
fn gen_gw3(buf:[]u8) i64 {
    let pos:i64 = 0;
    let r1:i64 = 40211;
    let r2:i64 = 40212;
    let rc1:i64 = 40213;
    let r3:i64 = 40214;
    let rc2:i64 = 40215;
    let rc3:i64 = 40217;
    // phase 1: level-1 chain (a,r1,b),(b,r2,100); probe rC1
    pos = ev_observe(buf, pos, 40201, r1, 40202);
    pos = ev_observe(buf, pos, 40202, r2, 100);
    pos = ev_query(buf, pos, 40201, rc1, 100);
    // phase 2: level-2 chain through the level-1 answer fact
    pos = ev_observe(buf, pos, 100, r3, 40203);
    pos = ev_observe(buf, pos, 40203, r2, 300);
    pos = ev_query(buf, pos, 40201, rc2, 300);
    // phase 3: contradict level-1 terminal value; regression probe
    pos = ev_observe(buf, pos, 40202, r2, 200);
    pos = ev_query(buf, pos, 40201, rc1, 200);
    // phase 4: control chain intact; level-2 must retire
    pos = ev_query(buf, pos, 100, rc3, 300);
    pos = ev_query(buf, pos, 40201, rc2, 0 - 2);
    return pos;
}

// ---- GW4: guard retarget (no corrected value); 6 lines ----
fn gen_gw4(buf:[]u8) i64 {
    let pos:i64 = 0;
    let r1:i64 = 40311;
    let r2:i64 = 40312;
    let rc:i64 = 40313;
    pos = ev_observe(buf, pos, 40301, r1, 40302);
    pos = ev_observe(buf, pos, 40302, r2, 100);
    pos = ev_query(buf, pos, 40301, rc, 100);
    pos = ev_observe(buf, pos, 40303, r2, 150);
    pos = ev_observe(buf, pos, 40301, r1, 40303);
    pos = ev_query(buf, pos, 40301, rc, 150);
    return pos;
}

// ---- GW5 phase A: contradiction then miss then act; 6 lines ----
fn gen_gw5_phaseA(buf:[]u8) i64 {
    let pos:i64 = 0;
    let r1:i64 = 40411;
    let r2:i64 = 40412;
    let rc:i64 = 40413;
    pos = ev_observe(buf, pos, 40401, r1, 40402);
    pos = ev_observe(buf, pos, 40402, r2, 100);
    pos = ev_query(buf, pos, 40401, rc, 100);
    pos = ev_observe(buf, pos, 40401, r1, 40403);
    pos = ev_query(buf, pos, 40401, rc, 0 - 2);
    pos = ev_act(buf, pos);
    return pos;
}

// ---- GW5 phase B1: treatment reveal (the missing link); 1 line ----
fn gen_gw5_phaseB1(buf:[]u8) i64 {
    return ev_observe(buf, 0, 40403, 40412, 150);
}

// ---- GW5 phase B2: control (unrelated junk); 1 line ----
fn gen_gw5_phaseB2(buf:[]u8) i64 {
    return ev_observe(buf, 0, 40403, 40419, 0);
}

// ---- GW5 phase C: final probe; 1 line ----
fn gen_gw5_phaseC(buf:[]u8) i64 {
    return ev_query(buf, 0, 40401, 40413, 150);
}

// ---- GW6: inquiry discrimination + retirement; 11 lines ----
fn gen_gw6(buf:[]u8) i64 {
    let pos:i64 = 0;
    let r1:i64 = 40511;
    let r2:i64 = 40512;
    let rc:i64 = 40513;
    let r9:i64 = 40514;
    pos = ev_observe(buf, pos, 40501, r1, 40502);
    pos = ev_observe(buf, pos, 40502, r2, 50);
    pos = ev_query(buf, pos, 40501, rc, 50);
    pos = ev_act(buf, pos);
    pos = ev_query(buf, pos, 40503, r9, 0 - 2);
    pos = ev_act(buf, pos);
    pos = ev_observe(buf, pos, 40503, r9, 77);
    pos = ev_query(buf, pos, 40503, r9, 77);
    pos = ev_act(buf, pos);
    pos = ev_query(buf, pos, 40504, r9, 0 - 2);
    pos = ev_act(buf, pos);
    return pos;
}

// ---- GW7: interference across A/B/C; 17 lines ----
fn gen_gw7(buf:[]u8) i64 {
    let pos:i64 = 0;
    let r1:i64 = 40611;
    let r2:i64 = 40612;
    let rc:i64 = 40613;
    let r9:i64 = 40614;
    pos = ev_observe(buf, pos, 40601, r1, 40602);
    pos = ev_observe(buf, pos, 40602, r2, 100);
    pos = ev_query(buf, pos, 40601, rc, 100);
    pos = ev_query(buf, pos, 40603, r9, 0 - 2);
    pos = ev_act(buf, pos);
    pos = ev_observe(buf, pos, 40603, r9, 55);
    pos = ev_query(buf, pos, 40603, r9, 55);
    pos = ev_observe(buf, pos, 40602, r2, 200);
    pos = ev_query(buf, pos, 40601, rc, 200);
    pos = ev_observe(buf, pos, 40604, r1, 40605);
    pos = ev_observe(buf, pos, 40605, r2, 70);
    pos = ev_query(buf, pos, 40604, rc, 70);
    pos = ev_query(buf, pos, 40606, r9, 0 - 2);
    pos = ev_act(buf, pos);
    pos = ev_query(buf, pos, 40601, rc, 200);
    pos = ev_query(buf, pos, 40604, rc, 70);
    pos = ev_query(buf, pos, 40603, r9, 55);
    return pos;
}

// ---- GW8: revision lifecycle (revise, revise, revert); 9 lines ----
fn gen_gw8(buf:[]u8) i64 {
    let pos:i64 = 0;
    let r1:i64 = 40711;
    let r2:i64 = 40712;
    let rc:i64 = 40713;
    pos = ev_observe(buf, pos, 40701, r1, 40702);
    pos = ev_observe(buf, pos, 40702, r2, 100);
    pos = ev_query(buf, pos, 40701, rc, 100);
    pos = ev_observe(buf, pos, 40702, r2, 200);
    pos = ev_query(buf, pos, 40701, rc, 200);
    pos = ev_observe(buf, pos, 40702, r2, 300);
    pos = ev_query(buf, pos, 40701, rc, 300);
    pos = ev_observe(buf, pos, 40702, r2, 100);
    pos = ev_query(buf, pos, 40701, rc, 100);
    return pos;
}

// ---- main: generate all 11 world files ----
fn gen_one(dir:[]u8, name:[]u8, gen:i64, buf:[]u8) i64 {
    let pos:i64 = -99;
    if (gen == 1) { pos = gen_gw1(buf); }
    if (gen == 2) { pos = gen_gw2(buf); }
    if (gen == 3) { pos = gen_gw3(buf); }
    if (gen == 4) { pos = gen_gw4(buf); }
    if (gen == 5) { pos = gen_gw5_phaseA(buf); }
    if (gen == 6) { pos = gen_gw5_phaseB1(buf); }
    if (gen == 7) { pos = gen_gw5_phaseB2(buf); }
    if (gen == 8) { pos = gen_gw5_phaseC(buf); }
    if (gen == 9) { pos = gen_gw6(buf); }
    if (gen == 10) { pos = gen_gw7(buf); }
    if (gen == 11) { pos = gen_gw8(buf); }
    if (pos < 0) { return pos; }
    let rc:i64 = write_file(dir, name, buf, pos);
    if (rc != 0) { return rc - 100; }
    _zag_print(name);
    _zag_print(": ");
    _zag_println(_zag_i64_to_str(pos));
    return 0;
}

fn main() i32 {
    let a1:[]u8 = _zag_arg(1);
    if (a1.len == 0) {
        _zag_println("usage: gen_gw <output-dir>");
        return 2;
    }
    let dir:[]u8 = z_copy(a1);
    if (dir.len == 0) { return 1; }
    let buf:[]u8 = nio_alloc(131072);
    if (buf.len == 0) { return 1; }
    let rc:i64 = 0;
    rc = gen_one(dir, "gw1_world.txt", 1, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw2_world.txt", 2, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw3_world.txt", 3, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw4_world.txt", 4, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw5_phaseA.txt", 5, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw5_phaseB1.txt", 6, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw5_phaseB2.txt", 7, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw5_phaseC.txt", 8, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw6_world.txt", 9, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw7_world.txt", 10, buf); if (rc != 0) { return 3; }
    rc = gen_one(dir, "gw8_world.txt", 11, buf); if (rc != 0) { return 3; }
    _zag_println("GEN-OK");
    return 0;
}

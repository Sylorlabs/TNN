// bp2_driver.zag -- BP-2 battery driver.
//
// Two sealed arms replaying the frozen XHIER-COUNTMAP-FIX world:
//   W2: FP2 provenance-death (graded R4 + persistent retirement).
//   W3: FP3 propagation (R6 flip to a rival composite).
// Kill bars are from the frozen PREREG.md. Verdict BP-2-PASS/FAIL.
// Pure Zag. Frozen operators reused verbatim, never redefined.

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn bp2_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

fn bp2_bar(t:[]u8,name:[]u8,cond:i32)void {
  if(bp2_ck(t,cond)==1){emit(name); emit(" PASS\n");}
  else{emit(name); emit(" FAIL\n");}
  return;
}

// First live count-MAP id != excl, or -1.
fn bp2_other_countmap(W:[]u8,excl:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(m!=excl && ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){return m;}
    }
    m=m+1;
  }
  return -1;
}

// Highest live count-MAP id, or -1.
fn bp2_max_countmap(W:[]u8)i32 {
  let best:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_has_inc(W,ng(W,m,20))==1){best=m;}
    }
    m=m+1;
  }
  return best;
}

// The single MAP_Z id, or -1 unless exactly one exists.
fn bp2_only_mapz(W:[]u8)i32 {
  let found:i32=-1; let n:i32=0; let z:i32=2;
  while(z<1024){
    if(xhier_is_mapz(W,z)==1){n=n+1; found=z;}
    z=z+1;
  }
  if(n==1){return found;}
  return -1;
}

// First live tag-1 type-1 provenance target's relation, or -1.
fn bp2_prov_rel(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){return ng(W,f,24);}
    }
    e=e+1;
  }
  return -1;
}

// Build the frozen XHIER-COUNTMAP-FIX world on W.
// out: 0=my 4=mv2 8=mv3 12=navx 16=mz1 20=mz2 24=mz3 (-1 unless mkz3).
// mkz3=1 builds the rival composite MAP_Z3 in Phase C (FP3 arm only),
// before the MAP_Y tombstone, preserving the no-allocation-after-
// tombstone invariant.
fn bp2_build(W:[]u8,out:[]u8,mkz3:i32)void {
  // Phase A: verbatim XF phase A.
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  ev_query_xs5(W,11,91,14,0);
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  ev_query_xs5(W,50,92,3,0);
  let i:i32=0;
  while(i<30){ev_teach(W,5000+i,60+(i%10),6000+i); i=i+1;}
  let my:i32=xs5_find_countmap(W);
  set32(out,0,my);
  emit("A-CMAP "); e64(my); emit("\n");
  // Phase B: verbatim XF phase B.
  ev_teach(W,110,85,111); ev_teach(W,111,85,112);
  ev_teach(W,112,85,113); ev_teach(W,113,85,114);
  ev_query_xs5(W,110,117,4,0);
  let mv2:i32=bp2_other_countmap(W,my);
  set32(out,4,mv2);
  emit("B-CMAP2 "); e64(mv2); emit("\n");
  // Phase B2: third count MAP over rel 87.
  ev_teach(W,120,87,121); ev_teach(W,121,87,122);
  ev_teach(W,122,87,123); ev_teach(W,123,87,124);
  ev_query_xs5(W,120,118,4,0);
  let mv3:i32=bp2_max_countmap(W);
  set32(out,8,mv3);
  emit("B2-CMAP3 "); e64(mv3); emit("\n");
  // Phase R: compose MAP_Z1 while the singleton is MAP_Y.
  ev_teach(W,14,82,40); ev_teach(W,40,82,41);
  xs5_compose(W,11,94,2);
  let mz1:i32=bp2_only_mapz(W);
  set32(out,16,mz1);
  let navx:i32=xhier_mapz_nav(W,mz1);
  set32(out,12,navx);
  emit("R-MAPZ "); e64(mz1); emit(" NAVX "); e64(navx); emit("\n");
  // Phase C: surgical MAP_Z2 (frozen ops only).
  ev_teach(W,14,87,60); ev_teach(W,60,87,61);
  ev_teach(W,61,87,62); ev_teach(W,62,87,63);
  ev_teach(W,14,85,30); ev_teach(W,30,85,31); ev_teach(W,31,85,32);
  let pf:[]u8=z_alloc(8);
  let mz2:i32=promote_graph(W,-1,11,93,4,pf,0);
  link_edge(W,mz2,14,navx,0);
  link_edge(W,mz2,14,mv3,0);
  set32(out,20,mz2);
  emit("C-MZ2 "); e64(mz2); emit("\n");
  let mz3:i32=-1;
  if(mkz3==1){
    mz3=promote_graph(W,-1,11,93,4,pf,0);
    link_edge(W,mz3,14,navx,0);
    link_edge(W,mz3,14,mv2,0);
    emit("C-MZ3 "); e64(mz3); emit("\n");
  }
  set32(out,24,mz3);
  // Phase T: tombstone MAP_Y (frozen ns 0/36 pattern), no restore.
  ns(W,my,0,0); ns(W,my,36,0);
  emit("T-SINGLETON "); e64(xs5_find_countmap(W)); emit("\n");
  return;
}

fn main()i32 {
  emit("BP2-START\n");
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);
  let bar0:i32=50;

  // ================= Arm FP2: provenance-death (W2) =================
  emit("W2-BEGIN\n");
  let W2:[]u8=z_alloc(110656);
  tnn2_init(W2);
  let ids2:[]u8=z_alloc(28);
  bp2_build(W2,ids2,0);
  let mv22:i32=get32(ids2,4);
  let mv32:i32=get32(ids2,8);
  let navx2:i32=get32(ids2,12);
  let mz22:i32=get32(ids2,20);

  // Preconditions: the replay matches the frozen world.
  bp2_bar(t,"PC-W2.0",xs5_find_countmap(W2)==mv22);
  let lo:[]u8=z_alloc(12);
  bp2_lic_live(W2,mv32,lo);
  bp2_bar(t,"PC-W2.1",bp2_prov_rel(W2,mv32)==87 && get32(lo,0)==4);
  bp2_bar(t,"PC-W2.2",xhier_is_mapz(W2,mz22)==1 && xhier_mapz_agg(W2,mz22)==mv32);

  // Belief formation (after the replay).
  let bt2:[]u8=z_alloc(8192); let hasb2:[]u8=z_alloc(1024);
  bp2_form(W2,bt2,hasb2,navx2,0);
  bp2_form(W2,bt2,hasb2,mv32,0);
  bp2_form(W2,bt2,hasb2,mz22,1);
  let k3v3pre:i32=bp2_has_k3(W2,mv32);
  let k3z2pre:i32=bp2_has_k3(W2,mz22);
  emit("W2-FORMED VSUP "); e64(bt2[mv32*8] as i32);
  emit(" ZSUP "); e64(bt2[mz22*8] as i32);
  emit(" K3PRE "); e64(k3v3pre); emit("/"); e64(k3z2pre); emit("\n");

  let cands2:[]u8=z_alloc(4);
  set32(cands2,0,mz22);
  let t0r7:i32=bp2_select(bt2,hasb2,cands2,1,bar0);
  let t0lg:i32=bp2_lgsel(W2,cands2,1);
  emit("W2-T0 R7 "); e64(t0r7); emit(" LG "); e64(t0lg); emit("\n");

  // Expected per-step values (hand-derived in PREREG.md).
  let exp_live:[]u8=z_alloc(16);
  set32(exp_live,0,3); set32(exp_live,4,2);
  set32(exp_live,8,1); set32(exp_live,12,0);
  let exp_sup:[]u8=z_alloc(16);
  set32(exp_sup,0,75); set32(exp_sup,4,37);
  set32(exp_sup,8,9); set32(exp_sup,12,0);
  let exp_r7:[]u8=z_alloc(16);
  set32(exp_r7,0,mz22); set32(exp_r7,4,-3);
  set32(exp_r7,8,-3); set32(exp_r7,12,-3);
  let exp_ex:[]u8=z_alloc(16);
  set32(exp_ex,0,4); set32(exp_ex,4,4);
  set32(exp_ex,8,4); set32(exp_ex,12,-2);

  let k:i32=0;
  while(k<4){
    let kf:i32=bp2_kill_one_prov(W2,mv32);
    bp2_relicense(W2,bt2,mv32);
    bp2_propagate(W2,bt2,hasb2,mz22);
    let lo2:[]u8=z_alloc(12);
    bp2_lic_live(W2,mv32,lo2);
    let live:i32=get32(lo2,0);
    let vsup:i32=bt2[mv32*8] as i32;
    let zsup:i32=bt2[mz22*8] as i32;
    let r7:i32=bp2_select(bt2,hasb2,cands2,1,bar0);
    let lg:i32=bp2_lgsel(W2,cands2,1);
    let ex:i32=xhier_exec(W2,mz22,11);
    emit("W2-T"); e64(k+1);
    emit(" KF "); e64(kf);
    emit(" LIVE "); e64(live);
    emit(" VSUP "); e64(vsup);
    emit(" ZSUP "); e64(zsup);
    emit(" R7 "); e64(r7);
    emit(" LG "); e64(lg);
    emit(" EXEC "); e64(ex);
    emit("\n");
    let ok:i32=1;
    if(kf<0){ok=0;}
    if(live!=get32(exp_live,k*4)){ok=0;}
    if(vsup!=get32(exp_sup,k*4)){ok=0;}
    if(zsup!=get32(exp_sup,k*4)){ok=0;}
    if(r7!=get32(exp_r7,k*4)){ok=0;}
    if(lg!=mz22){ok=0;}
    if(ex!=get32(exp_ex,k*4)){ok=0;}
    if(k==0){bp2_bar(t,"K-FP2-G1",ok);}
    if(k==1){bp2_bar(t,"K-FP2-G2",ok);}
    if(k==2){bp2_bar(t,"K-FP2-G3",ok);}
    if(k==3){
      let d1:i32=ok;
      if(bp2_has_k3r(W2,mv32,2)!=1){d1=0;}
      if(bp2_has_k3r(W2,mz22,2)!=1){d1=0;}
      if(k3v3pre!=0 || k3z2pre!=0){d1=0;}
      bp2_bar(t,"K-FP2-D1",d1);
      bp2_bar(t,"K-FP2-D3",lg==mz22 && r7==-3);
    }
    k=k+1;
  }
  // K-FP2-D2: persistence, three further selections.
  let p1:i32=bp2_select(bt2,hasb2,cands2,1,bar0);
  let p2:i32=bp2_select(bt2,hasb2,cands2,1,bar0);
  let p3:i32=bp2_select(bt2,hasb2,cands2,1,bar0);
  emit("W2-PERSIST "); e64(p1); emit(" "); e64(p2);
  emit(" "); e64(p3); emit("\n");
  bp2_bar(t,"K-FP2-D2",p1==-3 && p2==-3 && p3==-3);
  // K-FP2-C1: the binary contrast is the per-step EXEC column
  // (4,4,4,-2-fence) against the R7 column (Z2,Z2,-3,-3,-3);
  // the t4 fence trip was asserted inside the loop (exp_ex[3]).
  bp2_bar(t,"K-FP2-C1",get32(exp_ex,12)==-2);
  emit("W2-END\n");

  // ================= Arm FP3: propagation (W3) =================
  emit("W3-BEGIN\n");
  let W3:[]u8=z_alloc(110656);
  tnn2_init(W3);
  let ids3:[]u8=z_alloc(28);
  bp2_build(W3,ids3,1);
  let mv23:i32=get32(ids3,4);
  let mv33:i32=get32(ids3,8);
  let navx3:i32=get32(ids3,12);
  let mz23:i32=get32(ids3,20);
  let mz33:i32=get32(ids3,24);

  bp2_bar(t,"PC-W3.0",xs5_find_countmap(W3)==mv23);
  let lo3:[]u8=z_alloc(12);
  bp2_lic_live(W3,mv33,lo3);
  bp2_bar(t,"PC-W3.1",bp2_prov_rel(W3,mv33)==87 && get32(lo3,0)==4);
  bp2_bar(t,"PC-W3.2",xhier_is_mapz(W3,mz23)==1 && xhier_mapz_agg(W3,mz23)==mv33);
  bp2_bar(t,"PC-W3.3",xhier_is_mapz(W3,mz33)==1 && ng(W3,mz33,8)==11 && ng(W3,mz33,4)==93 && xhier_mapz_agg(W3,mz33)==mv23 && xhier_mapz_nav(W3,mz33)==navx3);

  let bt3:[]u8=z_alloc(8192); let hasb3:[]u8=z_alloc(1024);
  bp2_form(W3,bt3,hasb3,navx3,0);
  bp2_form(W3,bt3,hasb3,mv33,0);
  bp2_form(W3,bt3,hasb3,mv23,0);
  bp2_form(W3,bt3,hasb3,mz23,1);
  bp2_form(W3,bt3,hasb3,mz33,1);
  bp2_propagate(W3,bt3,hasb3,mz23);
  bp2_propagate(W3,bt3,hasb3,mz33);
  // The K1 verified execution of MAP_Z2: one independent confirmation.
  bp2_confirm(bt3,mz23,1);
  let cands3:[]u8=z_alloc(8);
  set32(cands3,0,mz23); set32(cands3,4,mz33);
  let s0z2sup:i32=bt3[mz23*8] as i32;
  let s0z3sup:i32=bt3[mz33*8] as i32;
  let s0r7:i32=bp2_select(bt3,hasb3,cands3,2,bar0);
  let s0lg:i32=bp2_lgsel(W3,cands3,2);
  emit("W3-S0 Z2SUP "); e64(s0z2sup);
  emit(" Z3SUP "); e64(s0z3sup);
  emit(" R7 "); e64(s0r7); emit(" LG "); e64(s0lg); emit("\n");
  bp2_bar(t,"K-FP3-S1",s0z2sup==120 && s0z3sup==100 && s0r7==mz23 && s0lg==mz23);

  let census_pre:i32=bp2_census(W3,mz23);
  let kf3:i32=bp2_kill_one_prov(W3,mv33);
  bp2_relicense(W3,bt3,mv33);
  bp2_propagate(W3,bt3,hasb3,mz23);
  bp2_propagate(W3,bt3,hasb3,mz33);
  let lo4:[]u8=z_alloc(12);
  bp2_lic_live(W3,mv33,lo4);
  let s1live:i32=get32(lo4,0);
  let s1v3sup:i32=bt3[mv33*8] as i32;
  let s1z2sup:i32=bt3[mz23*8] as i32;
  let s1z3sup:i32=bt3[mz33*8] as i32;
  let s1r7:i32=bp2_select(bt3,hasb3,cands3,2,bar0);
  let s1lg:i32=bp2_lgsel(W3,cands3,2);
  let census_post:i32=bp2_census(W3,mz23);
  emit("W3-S1 KF "); e64(kf3);
  emit(" LIVE "); e64(s1live);
  emit(" V3SUP "); e64(s1v3sup);
  emit(" Z2SUP "); e64(s1z2sup);
  emit(" Z3SUP "); e64(s1z3sup);
  emit(" R7 "); e64(s1r7);
  emit(" LG "); e64(s1lg);
  emit(" CENSUS "); e64(census_pre); emit("/"); e64(census_post); emit("\n");
  bp2_bar(t,"K-FP3-F1",kf3>=0 && s1live==3 && s1v3sup==75 && s1z2sup==75 && s1z3sup==100 && s1r7==mz33 && s1lg==mz23);
  bp2_bar(t,"K-FP3-F2",census_pre==census_post && bp2_has_k3(W3,mz23)==0);
  bp2_bar(t,"K-FP3-F3",s1lg==mz23 && s1r7==mz33);
  emit("W3-END\n");

  emit("BP2-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("BP2-END\n");
  return 0;
}

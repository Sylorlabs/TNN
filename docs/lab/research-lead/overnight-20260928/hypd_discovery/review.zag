// review.zag -- Hypothesis D search review: R1 theory check, niche
// computation for the parity solution chain, R4 dilution arithmetic.
// Pure Zag. Deterministic. No file I/O; episodes are embedded from the
// frozen builders in hyp_d_v2.zag (commit 2500fd02b).
//
// Chain programs (full-VM opcodes: 0=PUSH 1=IN0 2=IN1 3=ADD 4=SUB
// 5=MUL 6=DIV 7=MOD 8=NEG 9=DUP 10=DROP 11=SWAP 12=OVER):
//   P8 = [IN0,IN1,ADD,PUSH 2,MOD,PUSH 1,SWAP,SUB]  (predicted 25/25)
//   P5 = [IN0,IN1,ADD,PUSH 2,MOD]
//   P6 = P5 + [PUSH 1]
//   P7 = P6 + [SWAP]
//   PA = [IN0,IN1,ADD,PUSH 2]
//   Q3 = [IN1,IN0,ADD]            (deepest correct prefix ever inserted)
//   Q4 = [IN1,IN0,ADD,PUSH 2]

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn mod_nonneg(a:i32, b:i32)i32 {
  let r:i32=a - (a/b)*b;
  if(r<0){ r=r+b; }
  return r;
}

// ============ program representation (same layout as the VM) ============
fn prog_len(p:[]u8)i32 { return get32(p, 0); }
fn prog_append(p:[]u8, op:i32, arg:i32)void {
  let l:i32=get32(p, 0);
  set32(p, 4+l*8, op); set32(p, 4+l*8+4, arg);
  set32(p, 0, l+1);
  return;
}
fn prog_new(maxlen:i32)[]u8 {
  let p:[]u8=z_alloc(4+maxlen*8);
  set32(p, 0, 0);
  return p;
}

// ============ straight-line full-VM evaluator (ops 0..12) ============
fn seval(p:[]u8, in0:i32, in1:i32)i32 {
  let stack:[]u8=z_alloc(256*4);
  let sp:i32=0;
  let pl:i32=prog_len(p);
  let pc:i32=0;
  while(pc<pl){
    let op:i32=get32(p, 4+pc*8);
    let arg:i32=get32(p, 4+pc*8+4);
    pc=pc+1;
    if(op==0){ if(sp<256){ set32(stack, sp*4, arg); sp=sp+1; } }
    else if(op==1){ if(sp<256){ set32(stack, sp*4, in0); sp=sp+1; } }
    else if(op==2){ if(sp<256){ set32(stack, sp*4, in1); sp=sp+1; } }
    else if(op==3){ if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a+b); sp=sp+1; } }
    else if(op==4){ if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a-b); sp=sp+1; } }
    else if(op==5){ if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a*b); sp=sp+1; } }
    else if(op==6){ if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=a/b;} set32(stack,sp*4,r); sp=sp+1; } }
    else if(op==7){ if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=mod_nonneg(a,b);} set32(stack,sp*4,r); sp=sp+1; } }
    else if(op==8){ if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); set32(stack,(sp-1)*4,-a); } }
    else if(op==9){ if(sp>=1 && sp<256){ let a:i32=get32(stack,(sp-1)*4); set32(stack,sp*4,a); sp=sp+1; } }
    else if(op==10){ if(sp>=1){ sp=sp-1; } }
    else if(op==11){ if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); set32(stack,(sp-2)*4,b); set32(stack,(sp-1)*4,a); } }
    else if(op==12){ if(sp>=2 && sp<256){ let a:i32=get32(stack,(sp-2)*4); set32(stack,sp*4,a); sp=sp+1; } }
  }
  if(sp>0){ return get32(stack,(sp-1)*4); }
  return 0;
}

// ============ T3 episodes (copied from frozen builders) ============
fn build_t3_train(ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=0;
  let a:i32=0;
  while(a<=4){
    let b:i32=0;
    while(b<=4){
      let y:i32=0; if(mod_nonneg(a+b,2)==0){y=1;}
      set32(ein0,n*4,a); set32(ein1,n*4,b); set32(etgt,n*4,y);
      n=n+1; b=b+1;
    }
    a=a+1;
  }
  return n;
}
fn build_t3_held(ein0:[]u8, ein1:[]u8, etgt:[]u8)i32 {
  let n:i32=0;
  let a:i32=0;
  while(a<=7){
    let b:i32=0;
    while(b<=7){
      if(a>4 || b>4){
        let y:i32=0; if(mod_nonneg(a+b,2)==0){y=1;}
        set32(ein0,n*4,a); set32(ein1,n*4,b); set32(etgt,n*4,y);
        n=n+1;
      }
      b=b+1;
    }
    a=a+1;
  }
  return n;
}
// score + behavior hash (trit rolling hash mod 256, as in eval_cand)
fn score_bh(p:[]u8, ein0:[]u8, ein1:[]u8, etgt:[]u8, n:i32, out_bh:[]u8)i32 {
  let score:i32=0;
  let h:i32=0;
  let i:i32=0;
  while(i<n){
    let o:i32=seval(p, get32(ein0,i*4), get32(ein1,i*4));
    if(o==get32(etgt,i*4)){score=score+1;}
    let trit:i32=0;
    if(o>0){trit=2;} else if(o==0){trit=1;}
    h=(h*3+trit)%256;
    i=i+1;
  }
  set32(out_bh,0,h);
  return score;
}
fn niche_of(plen:i32, score:i32, n:i32, behav:i32)i32 {
  let lb:i32=plen;
  if(lb>12){lb=12;}
  let sn:i32=(score*16)/n;
  return (lb*17+sn)*256+behav;
}
fn build_chain()[]u8 {
  // returns buffer holding P8,P5,P6,P7,PA,Q3,Q4 as separate programs;
  // simplified: we build each fresh in main via helper below.
  return "";
}

fn main()void {
  let ein0:[]u8=z_alloc(64*4);
  let ein1:[]u8=z_alloc(64*4);
  let etgt:[]u8=z_alloc(64*4);
  let n:i32=build_t3_train(ein0, ein1, etgt);
  let hn0:[]u8=z_alloc(64*4);
  let hn1:[]u8=z_alloc(64*4);
  let htg:[]u8=z_alloc(64*4);
  let hn:i32=build_t3_held(hn0, hn1, htg);
  emit("TRAIN_N "); e64(n); emit(" HELD_N "); e64(hn); emit("\n");
  let bh:[]u8=z_alloc(4);

  // P8 = [IN0,IN1,ADD,PUSH 2,MOD,PUSH 1,SWAP,SUB]
  let p8:[]u8=prog_new(16);
  prog_append(p8,1,0); prog_append(p8,2,0); prog_append(p8,3,0);
  prog_append(p8,0,2); prog_append(p8,7,0); prog_append(p8,0,1);
  prog_append(p8,11,0); prog_append(p8,4,0);
  let s8:i32=score_bh(p8, ein0, ein1, etgt, n, bh);
  let h8:i32=get32(bh,0);
  emit("R1 P8 train_score="); e64(s8); emit("/"); e64(n);
  emit(" bh="); e64(h8);
  emit(" niche="); e64(niche_of(8, s8, n, h8)); emit("\n");
  let s8h:i32=score_bh(p8, hn0, hn1, htg, hn, bh);
  emit("R1 P8 held_score="); e64(s8h); emit("/"); e64(hn); emit("\n");

  // P5 = [IN0,IN1,ADD,PUSH 2,MOD]
  let p5:[]u8=prog_new(16);
  prog_append(p5,1,0); prog_append(p5,2,0); prog_append(p5,3,0);
  prog_append(p5,0,2); prog_append(p5,7,0);
  let s5:i32=score_bh(p5, ein0, ein1, etgt, n, bh);
  let h5:i32=get32(bh,0);
  emit("P5 train_score="); e64(s5); emit(" bh="); e64(h5);
  emit(" niche="); e64(niche_of(5, s5, n, h5)); emit("\n");

  // P6 = P5 + [PUSH 1]
  let p6:[]u8=prog_new(16);
  prog_append(p6,1,0); prog_append(p6,2,0); prog_append(p6,3,0);
  prog_append(p6,0,2); prog_append(p6,7,0); prog_append(p6,0,1);
  let s6:i32=score_bh(p6, ein0, ein1, etgt, n, bh);
  let h6:i32=get32(bh,0);
  emit("P6 train_score="); e64(s6); emit(" bh="); e64(h6);
  emit(" niche="); e64(niche_of(6, s6, n, h6)); emit("\n");

  // P7 = P6 + [SWAP]
  let p7:[]u8=prog_new(16);
  prog_append(p7,1,0); prog_append(p7,2,0); prog_append(p7,3,0);
  prog_append(p7,0,2); prog_append(p7,7,0); prog_append(p7,0,1);
  prog_append(p7,11,0);
  let s7:i32=score_bh(p7, ein0, ein1, etgt, n, bh);
  let h7:i32=get32(bh,0);
  emit("P7 train_score="); e64(s7); emit(" bh="); e64(h7);
  emit(" niche="); e64(niche_of(7, s7, n, h7)); emit("\n");

  // PA = [IN0,IN1,ADD,PUSH 2]
  let pa:[]u8=prog_new(16);
  prog_append(pa,1,0); prog_append(pa,2,0); prog_append(pa,3,0);
  prog_append(pa,0,2);
  let sa:i32=score_bh(pa, ein0, ein1, etgt, n, bh);
  let ha:i32=get32(bh,0);
  emit("PA train_score="); e64(sa); emit(" bh="); e64(ha);
  emit(" niche="); e64(niche_of(4, sa, n, ha)); emit("\n");

  // Q3 = [IN1,IN0,ADD] (deepest correct prefix ever inserted, eval 79426)
  let q3:[]u8=prog_new(16);
  prog_append(q3,2,0); prog_append(q3,1,0); prog_append(q3,3,0);
  let sq3:i32=score_bh(q3, ein0, ein1, etgt, n, bh);
  let hq3:i32=get32(bh,0);
  emit("Q3 train_score="); e64(sq3); emit(" bh="); e64(hq3);
  emit(" niche="); e64(niche_of(3, sq3, n, hq3)); emit(" (log niche=13249)\n");

  // Q4 = [IN1,IN0,ADD,PUSH 2] (never inserted)
  let q4:[]u8=prog_new(16);
  prog_append(q4,2,0); prog_append(q4,1,0); prog_append(q4,3,0);
  prog_append(q4,0,2);
  let sq4:i32=score_bh(q4, ein0, ein1, etgt, n, bh);
  let hq4:i32=get32(bh,0);
  emit("Q4 train_score="); e64(sq4); emit(" bh="); e64(hq4);
  emit(" niche="); e64(niche_of(4, sq4, n, hq4)); emit("\n");

  // R4 dilution arithmetic. Frozen log constants (T3, run 1):
  // CARRY_IN occn=3901, OCC_NICHES end=11930, budget=1000000.
  // Append template indices: ADD=21 PUSH:2=11 MOD=25 PUSH:1=10 SWAP=29 SUB=22 IN0=19.
  // Chain A (via [IN0 IN1]): links need selections 22,12,26,11,30,23 = 124.
  // Chain B (via [IN1], inserted eval 28786): links need 20,22,12,26,11,30,23 = 144.
  emit("R4 chainA_links=6 chainA_sels=124 chainB_links=7 chainB_sels=144\n");
  let optA:i32=124*3901;
  let optB:i32=144*3901;
  emit("R4 optimistic_evals_A="); e64(optA); emit(" optimistic_evals_B="); e64(optB); emit("\n");
  let realA:i32=124*8000;
  let realB:i32=144*9500;
  emit("R4 realistic_evals_A="); e64(realA); emit(" realistic_evals_B="); e64(realB); emit("\n");
  emit("R4 budget=1000000\n");
  // Per-niche cycle coverage: median niche selections ~= 1e6/8000 = 125.
  // M for len-5 parent = 31+32*5 = 191. Coverage ~= 125/191.
  emit("R4 median_niche_sels~125 cycle_M_len5=191 coverage~65pct\n");
  // Q3 stall check: Q3 inserted at eval 79426, needs 12th selection
  // (append PUSH:2, template 11) to continue chain B.
  let q3remain:i32=1000000-79426;
  emit("R4 Q3_remaining_evals="); e64(q3remain); emit("\n");
  // R5: carried niche blocking. T2's archive (carried into T3, silent,
  // CARRY_IN=3901) contains constant-2 programs [PUSH:-9 x k, PUSH:2]
  // for len 2..12 (11 programs, from T2 I-lines). On T3's episodes they
  // output constant 2. Compute their T3 niches.
  let c4:[]u8=prog_new(16);
  prog_append(c4,0,-9); prog_append(c4,0,-9); prog_append(c4,0,-9);
  prog_append(c4,0,2);
  let sc4:i32=score_bh(c4, ein0, ein1, etgt, n, bh);
  let hc4:i32=get32(bh,0);
  let nc4:i32=niche_of(4, sc4, n, hc4);
  emit("R5 carried_C4 T3 niche="); e64(nc4);
  emit(" Q4_niche=17570 blocked=");
  if(nc4==17570){ emit("1"); } else { emit("0"); }
  emit("\n");
  let c2:[]u8=prog_new(16);
  prog_append(c2,0,-9); prog_append(c2,0,2);
  let sc2:i32=score_bh(c2, ein0, ein1, etgt, n, bh);
  emit("R5 carried_C2 T3 niche="); e64(niche_of(2, sc2, n, get32(bh,0))); emit("\n");
  let c3:[]u8=prog_new(16);
  prog_append(c3,0,-9); prog_append(c3,0,-9); prog_append(c3,0,2);
  let sc3:i32=score_bh(c3, ein0, ein1, etgt, n, bh);
  emit("R5 carried_C3 T3 niche="); e64(niche_of(3, sc3, n, get32(bh,0))); emit("\n");
  emit("REVIEW_ANALYSES_DONE\n");
  return;
}

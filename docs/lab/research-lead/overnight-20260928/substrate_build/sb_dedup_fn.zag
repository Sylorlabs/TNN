// Dedup gate: content-addressed UNCERTAINTY reuse at top of miss_inquire.
// If a live tag-30/field4=-4 node with matching (s,r) exists, return early.
// (From dedup experiment 296fd79cb: 15-line gate.)
fn miss_inquire(W:[]u8,s:i32,r:i32)void {
  // dedup: scan for existing live UNCERTAINTY for (s,r)
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,4)==-4){
      if(ng(W,n,20)==s && ng(W,n,24)==r){return;}
    }
    n=n+1;
  }
  // not found: allocate as frozen
  let u:i32=alloc_node(W); if(u<0){return;}
  ns(W,u,0,30);
  ns(W,u,4,-4);
  write_node(W,u,s,r,2,0);
  let pr:i32=pol_get(W);
  if(pr<2){
    pr=alloc_node(W); if(pr<0){return;}
    ns(W,pr,0,2); ns(W,pr,4,-5);
    pol_set(W,pr);
  }
  let g:i32=alloc_node(W); if(g<0){return;}
  ns(W,g,0,1); ns(W,g,4,s);
  write_node(W,g,30,-999,0,0);
  link_edge(W,g,1,u,0);
  link_edge(W,pr,10,g,0);
  return;
}

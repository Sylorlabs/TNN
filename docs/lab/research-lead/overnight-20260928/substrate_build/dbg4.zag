fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s:i32=101;
  while(s<=110){
    let r:i32=1;
    while(r<=5){
      ev_teach(W,s,r,1000+s*10+r);
      r=r+1;
    }
    s=s+1;
  }
  emit("TEACH_DONE\n");
  let i:i32=0;
  while(i<10){
    s=101+(i%10);
    hs(W,16,0);
    let ret:i32=ev_query(W,s,99,-2,0);
    emit("Q"); e64(i); emit("="); e64(ret); emit(" vc="); e64(hg(W,16)/1024); emit("\n");
    i=i+1;
  }
  return 0;
}

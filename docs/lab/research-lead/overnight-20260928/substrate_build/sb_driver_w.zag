// sb_driver.zag -- shared substrate builder driver.
// Experiment A: policy learning via STRATEGY records (Node2-v2 scenario).
// Experiment B: withholding compute savings (DYN-1 battery, verifies measured).

fn sb_vc(W:[]u8)i32 { return hg(W,16)/1024; }
fn sb_vc_zero(W:[]u8)void { hs(W,16,0); return; }
fn sb_n(W:[]u8)i32 { return hg(W,20); }

fn run_withhold(W:[]u8)i32 {
  emit("WITHHOLD-START\n");
  // Teach: 15 facts (s=101..103, r=1..5)
  let s:i32=101;
  while(s<=103){
    let r:i32=1;
    while(r<=5){
      ev_teach(W,s,r,1000+s*10+r);
      r=r+1;
    }
    s=s+1;
  }
  let c_vc:i32=0; let c_dn:i32=0; let c_dec:i32=0;
  let e_vc:i32=0; let e_dn:i32=0; let e_dec:i32=0;
  let i:i32=0;
  // Phase C: 12 queries (4 per key). 4th should withhold in Arm C.
  i=0;
  while(i<12){
    s=101+(i%3);
    let n0:i32=sb_n(W); sb_vc_zero(W);
    let ret:i32=ev_query(W,s,99,-2,0);
    c_dn=c_dn+(sb_n(W)-n0); c_vc=c_vc+sb_vc(W);
    if(ret==-3){c_dec=c_dec+1;}
    i=i+1;
  }
  emit("C_VC="); e64(c_vc); emit(" C_DN="); e64(c_dn);
  emit(" C_DEC="); e64(c_dec); emit("\n");
  // Phase E: 6 queries (2 per key). All withhold in Arm C.
  i=0;
  while(i<6){
    s=101+(i%3);
    let n0:i32=sb_n(W); sb_vc_zero(W);
    let ret:i32=ev_query(W,s,99,-2,0);
    e_dn=e_dn+(sb_n(W)-n0); e_vc=e_vc+sb_vc(W);
    if(ret==-3){e_dec=e_dec+1;}
    i=i+1;
  }
  emit("E_VC="); e64(e_vc); emit(" E_DN="); e64(e_dn);
  emit(" E_DEC="); e64(e_dec); emit("\n");
  let pr:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==1){pr=pr+1;}
    n=n+1;
  }
  emit("PURSUIT_RECORDS="); e64(pr); emit("\n");
  emit("WITHHOLD-DONE\n");
  return 0;
}

fn main()i32 {
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  let r2:i32=run_withhold(W2);
  if(r2==0){ emit("SB-W-PASS\n"); return 0; }
  emit("SB-W-FAIL\n"); return 1;
}

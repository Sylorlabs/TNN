// sb_driver.zag -- shared substrate builder driver.
// Experiment A: policy learning via STRATEGY records (Node2-v2 scenario).
// Experiment B: withholding compute savings (DYN-1 battery, verifies measured).

fn sb_vc(W:[]u8)i32 { return hg(W,16)/1024; }
fn sb_vc_zero(W:[]u8)void { hs(W,16,0); return; }
fn sb_n(W:[]u8)i32 { return hg(W,20); }

// Helper: get guide action for (s,r)'s open uncertainty.
fn sb_guide_action(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let e:i32=0;
        while(e<4096){
          if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,8)==n){
            let g:i32=eg(W,e,0);
            if(g>=2 && ng(W,g,36)==1){ return ng(W,g,20); }
          }
          e=e+1;
        }
      }
    }
    n=n+1;
  }
  return -999;
}

// Experiment A: policy via substrate.
fn run_policy(W:[]u8)i32 {
  emit("POLICY-START\n");
  let i:i32=0;
  // Phase 1: 3 cycles, a_w=30/-1. Policy should stay 30.
  while(i<3){
    let s:i32=100+i;
    ev_query(W,s,1,0,0);
    let aw:i32=30; if(i==1){aw=-1;}
    ev_observe_aw(W,s,1,1000+i,aw);
    i=i+1;
  }
  let d1:i32=sub_best_action(W);
  emit("PHASE1_POLICY="); e64(d1); emit("\n");
  if(d1!=30){ emit("POLICY-FAIL: Phase 1 shift\n"); return 1; }
  emit("POLICY-PASS: Phase 1 no shift\n");
  // Phase 2: 3 cycles, a_w=45. Policy should become 45.
  i=0;
  while(i<3){
    let s:i32=200+i;
    ev_query(W,s,2,0,0);
    ev_observe_aw(W,s,2,2000+i,45);
    let dm:i32=sub_best_action(W);
    emit("PHASE2_MID="); e64(dm); emit("\n");
    i=i+1;
  }
  let d2:i32=sub_best_action(W);
  emit("PHASE2_POLICY="); e64(d2); emit("\n");
  if(d2!=45){ emit("POLICY-FAIL: Phase 2 no shift\n"); return 1; }
  emit("POLICY-PASS: Phase 2 shift to 45\n");
  // Phase 3: miss, guide should carry 45.
  ev_query(W,300,3,0,0);
  let ga:i32=sb_guide_action(W,300,3);
  emit("PHASE3_GUIDE="); e64(ga); emit("\n");
  if(ga!=45){ emit("POLICY-FAIL: Phase 3 guide\n"); return 1; }
  emit("POLICY-PASS: Phase 3 guide carries 45\n");
  // Substrate census: STRATEGY records.
  let sr:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==2){sr=sr+1;}
    n=n+1;
  }
  emit("STRATEGY_RECORDS="); e64(sr); emit("\n");
  emit("POLICY-ALL-PASS\n");
  return 0;
}

// Experiment B: withholding compute savings.
// Teach facts on r=1..5 (so trial has paths to attempt), then query
// r=99 (untaught): activate misses, trial tries via taught structure,
// fails, spends verifies. Repeated misses let withholding kick in.
fn run_withhold(W:[]u8)i32 {
  emit("WITHHOLD-START\n");
  // Teach: 15 facts (s=101..103, r=1..5)
  let s:i32=101;
  while(s<=103){
    let r:i32=1;
    while(r<=5){
      ev_teach(W,s,r,1000+s*10+r);
      r=r+1;
    }
    s=s+1;
  }
  let c_vc:i32=0; let c_dn:i32=0; let c_dec:i32=0;
  let e_vc:i32=0; let e_dn:i32=0; let e_dec:i32=0;
  let i:i32=0;
  // Phase C: 12 queries (4 per key). 4th should withhold in Arm C.
  i=0;
  while(i<12){
    s=101+(i%3);
    let n0:i32=sb_n(W); sb_vc_zero(W);
    let ret:i32=ev_query(W,s,99,-2,0);
    c_dn=c_dn+(sb_n(W)-n0); c_vc=c_vc+sb_vc(W);
    if(ret==-3){c_dec=c_dec+1;}
    i=i+1;
  }
  emit("C_VC="); e64(c_vc); emit(" C_DN="); e64(c_dn);
  emit(" C_DEC="); e64(c_dec); emit("\n");
  // Phase E: 6 queries (2 per key). All withhold in Arm C.
  i=0;
  while(i<6){
    s=101+(i%3);
    let n0:i32=sb_n(W); sb_vc_zero(W);
    let ret:i32=ev_query(W,s,99,-2,0);
    e_dn=e_dn+(sb_n(W)-n0); e_vc=e_vc+sb_vc(W);
    if(ret==-3){e_dec=e_dec+1;}
    i=i+1;
  }
  emit("E_VC="); e64(e_vc); emit(" E_DN="); e64(e_dn);
  emit(" E_DEC="); e64(e_dec); emit("\n");
  let pr:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==61 && ng(W,n,4)==1){pr=pr+1;}
    n=n+1;
  }
  emit("PURSUIT_RECORDS="); e64(pr); emit("\n");
  emit("WITHHOLD-DONE\n");
  return 0;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let r1:i32=run_policy(W);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  let r2:i32=run_withhold(W2);
  if(r1==0 && r2==0){ emit("SB-ALL-PASS\n"); return 0; }
  emit("SB-FAIL\n"); return 1;
}

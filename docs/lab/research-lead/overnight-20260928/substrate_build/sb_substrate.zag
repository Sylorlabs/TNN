// sc_substrate.zag -- shared consequence substrate + decline gate over it.
// UNFROZEN pilot. Replaces ev_query (base lines 813-835) in the variant.
// Everything else in the base is byte-identical to frozen (SHA-256 a29972ca...).
//
// One keyed store of pursuit/strategy outcomes (spec 550fa268b). The decline
// gate is a CONSUMER of this store, not a private tally: it reads
// PURSUIT (s,r).consec_fail via sub_consec and withholds when it reaches N.
// The write path sub_note is generic: any consumer (abandonment, trial
// reorder, retention input) uses the same record format, the same lookup,
// the same source tagging, with no new storage machinery.
//
// Record layout: one 40-byte node, tag 61 (storage tag, not a cognitive
// semantic case; no production function branches on tag 61 to alter
// cognition, sub_find only locates records).
//   f4:  key_type (1 PURSUIT, 2 STRATEGY)
//   f8:  key_a (s for PURSUIT; family id for STRATEGY)
//   f12: key_b (r for PURSUIT; 0 for STRATEGY)
//   f16: consec_fail (reset to 0 on success, spec 4.2)
//   f20: attempts
//   f24: successes
//   f28: src packed: taught bits 0-9, observed bits 10-19, self bits 20-29,
//        each saturating at 1023 (spec 2.4, three source counters)
//   f32: life packed: state bits 0-1 (0 ACTIVE, 1 ABANDONED, 2 RE-ENGAGED),
//        last_mode bits 2-8 (F1-F7 failure vocabulary, spec 2.2),
//        cost_nodes bits 9-31 saturating (spec 2.3)
// last_active (spec 2.5) is OMITTED in this pilot: its only specified
// consumer is record reclamation, which is not implemented here (record
// count is bounded by distinct pursuit keys; reclamation is future work
// per spec section 6). Documented, not hidden.
//
// Write discipline (spec 4.1/4.2):
//   - record created on first miss or trial for its key (create flag)
//   - failure: attempts+1, consec_fail+1, last_mode set, src tagged, cost added
//   - success: attempts+1, successes+1, consec_fail reset to 0, mode cleared
//   - declined attempts do NOT write (spec 5.1: the gate's own caution must
//     not inflate the count it reads)
// Source tagging (spec 7.2): driver-supplied queries are harness-triggered,
// tagged taught. Ambiguous defaults to self; none are ambiguous in this pilot.
//
// The decline gate (spec 5.1): in ev_query after activate fails, read
// PURSUIT (s,r).consec_fail; WITHHOLD (-3, distinguished from -2 exhaust)
// when consec_fail >= N. N=3 carried over from the pilot (researcher-set,
// unchanged for comparison). WITHHOLD trace names the key, the value read,
// and the threshold (log_ev p0=-3, p1=consec read, p2=N).
//
// Differences vs the ad-hoc pilot tally, stated honestly:
//   - pilot counted LIVE UNCERTAINTY nodes: eviction-coupled (forgetting
//     re-opens inquiry). Substrate records are eviction-decoupled: decline
//     persists until a success resets consec_fail. No eviction fires in the
//     DYN-1 battery, so the battery cannot discriminate; the difference is
//     real and is the spec-mandated behavior (reset-on-success, spec 4.2).
//   - pilot counted total failures per key; substrate counts consecutive
//     failures with reset-on-success. Identical in this battery (miss keys
//     never succeed); strictly more correct in general.

fn SUB_TAG()i32 { return 61; }
fn SUB_PURSUIT()i32 { return 1; }
fn SUB_STRATEGY()i32 { return 2; }
fn SUB_F6()i32 { return 6; }
fn SUB_SRC_TAUGHT()i32 { return 0; }
fn SUB_SRC_OBS()i32 { return 1; }
fn SUB_SRC_SELF()i32 { return 2; }
fn SUB_ST_ACTIVE()i32 { return 0; }

fn sub_src_get(p:i32,k:i32)i32 {
  if(k==0){ return p%1024; }
  if(k==1){ return (p/1024)%1024; }
  return (p/1048576)%1024;
}
fn sub_src_inc(p:i32,k:i32)i32 {
  let v:i32=sub_src_get(p,k);
  if(v>=1023){ return p; }
  if(k==0){ return p+1; }
  if(k==1){ return p+1024; }
  return p+1048576;
}
fn sub_life_state(l:i32)i32 { return l%4; }
fn sub_life_mode(l:i32)i32 { return (l/4)%128; }
fn sub_life_cost(l:i32)i32 { return l/512; }
fn sub_life_mk(st:i32,md:i32,c:i32)i32 {
  let cc:i32=c; if(cc>4194303){ cc=4194303; }
  return (st%4)+(md%128)*4+cc*512;
}

// Generic keyed lookup. Shared by all consumers; knows nothing about decline.
fn sub_find(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SUB_TAG() && ng(W,n,4)==kt && ng(W,n,8)==ka && ng(W,n,12)==kb){ return n; }
    n=n+1;
  }
  return -1;
}
fn sub_get(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n>=0){ return n; }
  n=alloc_node(W); if(n<0){ return -1; }
  ns(W,n,0,SUB_TAG()); ns(W,n,4,kt); ns(W,n,8,ka); ns(W,n,12,kb);
  ns(W,n,16,0); ns(W,n,20,0); ns(W,n,24,0); ns(W,n,28,0); ns(W,n,32,0);
  return n;
}
// Generic consequence write (spec 4.2). success: 1 ok / 0 fail.
// mode: F1-F7 on failure, 0 on success. src: 0 taught / 1 observed / 2 self.
// cost: nodes allocated by this attempt. create: make the record if absent
// (spec 4.1: creation on first miss or trial, not on answers from memory).
fn sub_note(W:[]u8,kt:i32,ka:i32,kb:i32,success:i32,mode:i32,src:i32,cost:i32,create:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){
    if(create==0){ return -1; }
    n=sub_get(W,kt,ka,kb); if(n<0){ return -1; }
  }
  ns(W,n,20,ng(W,n,20)+1);
  ns(W,n,28,sub_src_inc(ng(W,n,28),src));
  let st:i32=sub_life_state(ng(W,n,32));
  let nc:i32=sub_life_cost(ng(W,n,32))+cost;
  if(success==1){
    ns(W,n,24,ng(W,n,24)+1);
    ns(W,n,16,0);
    ns(W,n,32,sub_life_mk(st,0,nc));
  } else {
    ns(W,n,16,ng(W,n,16)+1);
    ns(W,n,32,sub_life_mk(st,mode,nc));
  }
  return n;
}
// Generic production read: consecutive failures for a key, 0 when no record.
fn sub_consec(W:[]u8,kt:i32,ka:i32,kb:i32)i32 {
  let n:i32=sub_find(W,kt,ka,kb);
  if(n<0){ return 0; }
  return ng(W,n,16);
}

fn sc_n()i32 { return 3; }
fn sc_withhold()i32 { return -3; }


// ---- Behavior 1: action-policy learning via STRATEGY records ----
// Replaces Node2-v2's private tag-40 policy node. The policy is the
// argmax over STRATEGY(action).successes in the shared substrate.
// World revelations are success writes; the read path needs no
// threshold, no history slots, no private node.

// Generic policy read: action with most world-revealed successes.
// Tie: smaller action id wins (deterministic). None: default 30.
fn sub_best_action(W:[]u8)i32 {
  let best:i32=30; let best_s:i32=0; let found:i32=0;
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==SUB_TAG() && ng(W,n,4)==SUB_STRATEGY()){
      let a:i32=ng(W,n,8); let s:i32=ng(W,n,24);
      if(found==0 || s>best_s || (s==best_s && a<best)){
        best=a; best_s=s; found=1;
      }
    }
    n=n+1;
  }
  return best;
}

// Resolve open uncertainty for (s,r), recording world-revealed action
// a_w as a STRATEGY success (source OBSERVED). Supersedes the
// uncertainty and its guide, as in Node2-v2.
fn sb_resolve_aw(W:[]u8,s:i32,r:i32,a_w:i32)void {
  let u:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){u=n; break;}
    }
    n=n+1;
  }
  if(u<0){return;}
  link_edge(W,u,3,u,0);
  let g:i32=-1; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==1 && eg(W,e,8)==u){
      g=eg(W,e,0); break;
    }
    e=e+1;
  }
  if(g>=2){
    link_edge(W,g,3,g,0);
  }
  if(a_w>=0){
    sub_note(W,SUB_STRATEGY(),a_w,0,1,0,SUB_SRC_OBS(),0,1);
  }
  return;
}

// Action channel: ev_observe with world-revealed action.
// a_w = -1: identical to frozen ev_observe. a_w >= 0: world reveals
// action a_w; recorded as STRATEGY success in the shared substrate.
fn ev_observe_aw(W:[]u8,s:i32,r:i32,o:i32,a_w:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    if(ng(W,n,28)==o){
      link_edge(W,n,7,n,0); ref_prot(W,n);
      log_ev(W,4,s,r,o,1,0,0); return 1;
    }
    link_edge(W,n,3,n,0);
    revise_on_contradict(W,n,o);
    let h2:i32=alloc_raw(W);
    if(h2>=0){
      ns(W,h2,0,3);
      write_node(W,h2,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
      link_edge(W,h2,5,n,0);
    }
    let nn:i32=ev_teach_in(W,s,r,o);
    if(nn>=0){link_edge(W,nn,4,n,0);}
    log_ev(W,4,s,r,o,0,0,0); return 0;
  }
  ev_teach_in(W,s,r,o);
  sb_resolve_aw(W,s,r,a_w);
  log_ev(W,4,s,r,o,1,0,0); return 1;
}

// ---- Behavior 1 read path: miss_inquire uses substrate policy ----
fn miss_inquire(W:[]u8,s:i32,r:i32)void {
  let act:i32=sub_best_action(W);
  let u:i32=alloc_node(W); if(u<0){return;}
  ns(W,u,0,30);
  ns(W,u,4,-4);
  write_node(W,u,s,r,2,0);
  let pr:i32=pol_get(W);
  if(pr<2){
    pr=alloc_node(W); if(pr<0){return;}
    ns(W,pr,0,2); ns(W,pr,4,-5);
    pol_set(W,pr);
  }
  let g:i32=alloc_node(W); if(g<0){return;}
  ns(W,g,0,1); ns(W,g,4,s);
  write_node(W,g,act,-999,0,0);
  link_edge(W,g,1,u,0);
  link_edge(W,pr,10,g,0);
  return;
}

// ---- Behavior 2: withholding via PURSUIT records ----
// One consumer of the shared substrate. Reads consec_fail before
// trial; withholds when it reaches WITHHOLD_N. Withheld queries do
// not write (spec 5.1).
fn sb_withhold_n()i32 { return 3; }
fn sb_withhold()i32 { return -3; }

fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let qn0:i32=hg(W,20);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),0,0);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // substrate read: withhold when consecutive failures reach N
  let cf:i32=sub_consec(W,SUB_PURSUIT(),s,r);
  if(cf>=sb_withhold_n()){
    log_ev(W,2,s,r,sb_withhold(),cf,sb_withhold_n(),0); return sb_withhold();
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop first (learner-set miss policy)
  let v0:i32=hg(W,16);
  let ans:i32=mp_run(W,s,r,expected,flags);
  let vc:i32=hg(W,16)-v0;
  if(ans!=-2){
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),vc,1);
    log_ev(W,2,s,r,ans,1,0,0); return ans;
  }
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){
    sub_note(W,SUB_PURSUIT(),s,r,1,0,SUB_SRC_TAUGHT(),vc,1);
    log_ev(W,2,s,r,bv,1,0,0); return bv;
  }
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  let cst:i32=hg(W,16)-v0;
  sub_note(W,SUB_PURSUIT(),s,r,0,SUB_F6(),SUB_SRC_TAUGHT(),cst,1);
  return -2;
}

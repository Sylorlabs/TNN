fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let s:i32=101;
  while(s<=102){
    let r:i32=1;
    while(r<=5){
      ev_teach(W,s,r,1000+s*10+r);
      r=r+1;
    }
    s=s+1;
  }
  emit("TEACH_DONE\n");
  let i:i32=0; let tv:i32=0; let tn:i32=0;
  while(i<8){
    s=101+(i%2);
    let n0:i32=hg(W,20); hs(W,16,0);
    let ret:i32=ev_query(W,s,99,-2,0);
    tn=tn+(hg(W,20)-n0); tv=tv+hg(W,16)/1024;
    emit("Q"); e64(i); emit(" ret="); e64(ret); emit("\n");
    i=i+1;
  }
  emit("TOTAL_VC="); e64(tv); emit(" TOTAL_DN="); e64(tn); emit("\n");
  return 0;
}

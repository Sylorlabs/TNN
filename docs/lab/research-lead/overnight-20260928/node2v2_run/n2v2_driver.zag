// Node2-v2 sealed test driver: 3-phase K-H3 discrimination test.
// Phase 1: 3 miss/resolve on R1, a_w = 30 or -1 (no shift expected).
// Phase 2: 3 miss/resolve on R2, a_w = 45 consistently (shift expected).
// Phase 3: 1 miss on R3, verify new guide carries 45.
// Kill bars:
// - Shift during Phase 1 = FAIL.
// - No shift after 3 consistent a_w=45 in Phase 2 = FAIL.
// - Phase 3 guide carries 30 (not 45) = FAIL.

fn get_default_action(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,4)==2){return ng(W,n,20);}
    n=n+1;
  }
  return -999;
}

fn get_guide_action(W:[]u8,s:i32,r:i32)i32 {
  // Find the most recent guide for context s (via POLICY_ROOT edge type 10)
  // Guide nodes have tag 1. Return its action (field 20).
  let pr:i32=ng(W,0,20);
  if(pr<2){return -999;}
  let best:i32=-1; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1){
      let cand:i32=-1;
      if(eg(W,e,0)==pr){cand=eg(W,e,8);} else {if(eg(W,e,8)==pr){cand=eg(W,e,0);}}
      if(cand>=2 && ng(W,cand,36)==1 && ng(W,cand,0)==1 && is_superseded(W,cand)==0){
        if(ng(W,cand,4)==s){
          best=cand;
        }
      }
    }
    e=e+1;
  }
  if(best>=2){return ng(W,best,20);}
  return -999;
}

fn run_test()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  
  // Phase 1: 3 cycles on R1, a_w = 30 (confirming) or -1 (neutral)
  // No shift expected. Default should remain 30.
  let i:i32=0;
  while(i<3){
    let s:i32=100+i; let r:i32=1;
    ev_query(W,s,r,0,0);  // miss, creates guide with action 30
    let aw:i32=30;
    if(i==1){aw=-1;}
    ev_observe_aw(W,s,r,1000+i,aw);  // resolve, reveal a_w
    i=i+1;
  }
  let d1:i32=get_default_action(W);
  print_i32(d1); print_str(" PHASE1_DEFAULT\n");
  if(d1!=30){
    print_str("FAIL: Phase 1 shift detected\n");
    return 1;
  }
  print_str("PASS: Phase 1 no shift\n");
  
  // Phase 2: 3 cycles on R2, a_w = 45 consistently
  // Shift expected after 3rd revelation. Default should become 45.
  i=0;
  while(i<3){
    let s:i32=200+i; let r:i32=2;
    ev_query(W,s,r,0,0);  // miss, creates guide (action 30 for first 3)
    ev_observe_aw(W,s,r,2000+i,45);  // resolve, reveal a_w=45
    let dm:i32=get_default_action(W);
    print_i32(dm); print_str(" PHASE2_MID_DEFAULT\n");
    i=i+1;
  }
  let d2:i32=get_default_action(W);
  print_i32(d2); print_str(" PHASE2_DEFAULT\n");
  if(d2!=45){
    print_str("FAIL: Phase 2 no shift after 3 consistent revelations\n");
    return 1;
  }
  print_str("PASS: Phase 2 shift to 45\n");
  
  // Phase 3: 1 miss on R3, verify new guide carries 45
  ev_query(W,300,3,0,0);
  let ga:i32=get_guide_action(W,300,3);
  print_i32(ga); print_str(" PHASE3_GUIDE_ACTION\n");
  if(ga!=45){
    print_str("FAIL: Phase 3 guide does not carry 45\n");
    return 1;
  }
  print_str("PASS: Phase 3 guide carries 45\n");
  
  print_str("ALL PASS: K-H3 conditions satisfied\n");
  return 0;
}

fn main()i32 { return run_test(); }

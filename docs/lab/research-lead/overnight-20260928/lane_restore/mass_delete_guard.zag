// mass_delete_guard.zag -- LANE-RESTORE, item P2. THE TRIPWIRE.
//
// WHY THIS EXISTS
//   Four sibling mass-deletion events hit this repository, deleting 147,295 /
//   160,361 / 165,250 / 160,515 paths. Three were caught, and each was caught
//   only because a human or agent happened to notice a missing file and wrote a
//   commit whose SUBJECT names the offending sha. There was no tripwire. A mass
//   deletion is invisible in `git log --oneline`; it is visible only in
//   `--numstat`. Nobody read the numstat.
//
//   The fourth, b3b3ee00a, was missed because its subject read
//   "lm3_lifetime: prereg ... Non-ledger", and the "Non-ledger" suffix
//   discouraged exactly the check that would have caught it. It cost 77.4% of
//   the research corpus its visibility and produced a published false negative.
//
//   This program is that check, made mechanical. It FAILS CLOSED.
//
// WHAT IT MEASURES
//   PATHS DELETED, not lines deleted. The historical events deleted 10^5 paths;
//   a line-count threshold would also fire on a legitimate large edit, and a
//   path-count threshold is the quantity that actually caused the incident.
//   `git diff --cached --name-status` status letters:
//     D  deleted            -> counts as a deletion
//     R  renamed            -> counts as a deletion (git models R as D + A)
//     C  copied             -> does NOT count
//     A  added              -> does NOT count
//     M / T / U             -> does NOT count
//
// INPUTS (git plumbing, which is orchestration, not computation):
//   arg1  `git diff --cached --name-status` output
//   arg2  maximum permitted deleted paths, decimal
//   arg3  output verdict file
//
// OUTPUT (to arg3, and to stdout):
//   VERDICT PASS     <deleted> <max> <files_seen>
//   VERDICT REFUSE   <deleted> <max> <files_seen>
//
// The shell wrapper mass_delete_guard.sh reads the VERDICT line and fails the
// commit. It does not re-derive the count; the count is computed here, in Zag,
// per charter section 4. The wrapper is orchestration only.
//
// The committed binary is deliberately NOT tracked, per the lane-hygiene
// precedent in 70175302b.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}
fn iarr(n:i32)[]u8 { return z_alloc(n*4); }
fn gi(b:[]u8,i:i32)i32 { return get32(b,i*4); }
fn si(b:[]u8,i:i32,v:i32)void { set32(b,i*4,v); return; }

fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_ch(b:[]u8,c:i32,v:i32)i32 { b[c]=v as u8; return c+1; }
fn o_i(b:[]u8,c:i32,v:i32)i32 {
  if(v==0){ return o_ch(b,c,48); }
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i32=x;
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}

// atoi over buf[0..n]
fn atoi(b:[]u8,n:i32)i32 {
  let v:i32=0; let i:i32=0;
  while(i<n){
    let c:i32=b[i] as i32;
    if(c<48 || c>57){ break; }
    v=v*10+(c-48); i=i+1;
  }
  return v;
}

// count lines of buf[0..n] terminated by newline, plus a trailing partial line
fn nlines(buf:[]u8,n:i32)i32 {
  let k:i32=0; let i:i32=0;
  while(i<n){ if(buf[i]==10){ k=k+1; } i=i+1; }
  if(n>0){ if(buf[n-1]!=10){ k=k+1; } }
  return k;
}

fn main()i32 {
  let pns:[]u8=_zag_arg(1);
  let pmax:[]u8=_zag_arg(2);
  let pout:[]u8=_zag_arg(3);
  let eb:[]u8=z_alloc(256);
  if(_zag_file_exists(pns)==false){
    let s:[]u8=z_alloc(48);
    let c:i32=o_app(eb,0,"VERDICT ERROR name_status_file_missing\n");
    _zag_write_file(pout,s[0..0]);
    _zag_print(eb[0..c]);
    return 2;
  }
  let b:[]u8=_zag_read_file(pns);
  let mx:i32=atoi(pmax,pmax.len);
  if(mx<1){
    let s:[]u8=z_alloc(48);
    let c:i32=o_app(eb,0,"VERDICT ERROR bad_max\n");
    _zag_write_file(pout,s[0..0]);
    _zag_print(eb[0..c]);
    return 2;
  }

  // Walk byte positions. A position is a line start iff pos==0 or b[pos-1]==10.
  // The status letter is the first byte of the line.
  let dels:i32=0; let seen:i32=0;
  let p:i32=0;
  while(p<b.len){
    let atstart:i32=0;
    if(p==0){ atstart=1; } else { if(b[p-1]==10){ atstart=1; } }
    if(atstart==1){
      let c:i32=b[p] as i32;
      seen=seen+1;
      // D = deleted, R = renamed (git models a rename as D + A)
      if(c==68){ dels=dels+1; }
      if(c==82){ dels=dels+1; }
    }
    p=p+1;
  }

  let ob:[]u8=z_alloc(256);
  let oc:i32=0;
  if(dels>mx){
    oc=o_app(ob,oc,"VERDICT REFUSE ");
  } else {
    oc=o_app(ob,oc,"VERDICT PASS ");
  }
  oc=o_i(ob,oc,dels); oc=o_ch(ob,oc,32);
  oc=o_i(ob,oc,mx);   oc=o_ch(ob,oc,32);
  oc=o_i(ob,oc,seen); oc=o_ch(ob,oc,10);
  _zag_print(ob[0..oc]);
  _zag_write_file(pout,ob[0..oc]);
  _zag_print("MAXDELETEDPATHS "); _zag_println(_zag_i64_to_str(mx as i64));
  _zag_print("FILESSEEN "); _zag_println(_zag_i64_to_str(seen as i64));
  _zag_print("DELETEDPATHS "); _zag_println(_zag_i64_to_str(dels as i64));
  return 0;
}

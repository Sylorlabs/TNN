// cite_remap.zag -- LANE-RESTORE, item P1.
//
// MECHANICAL CITATION REPAIR: find the commit in this repository that each
// unresolvable ledger citation was *meant* to name.
//
// The ledger cites abbreviated git commit shas. 252 of them resolve to no
// object of any type in this repository (verified shell-side with
// git cat-file --batch-check: 252 missing, 0 blobs, 0 trees). A sha prefix is
// prefix-unique, so no abbreviation of an existing commit can fail to resolve
// by accident. Therefore each of the 252 either names a commit that never
// entered this repository, or names an existing commit with a transcription
// error in it.
//
// This program tests the transcription-error hypothesis exhaustively and
// mechanically, with no judgement: for every unresolvable citation it searches
// ALL commits on ALL refs for one at Hamming distance <= 1 over the cited
// length. Distance 0 is included as a control and is expected to be empty
// (it would contradict the shell-side resolution test).
//
// FALSE-POSITIVE BOUND, computed not assumed. A citation of length L has
// L*15 single-character neighbours in hex. With C commits in the repository,
// the probability that a random citation has at least one neighbour present is
// about C * L * 15 / 16^L. At C = 6742, L = 9 that is 1.3e-5 per citation, and
// 1.9e-4 at L = 8; over 252 citations, 0.008 expected false hits. So any hit
// reported here is signal, not noise, PROVIDED it is unique. A citation with
// more than one neighbour is reported as AMBIGUOUS and is NOT repaired.
//
// INPUTS (produced by git plumbing, which is orchestration, not computation):
//   arg1  one unresolvable citation per line, hex only
//   arg2  one commit per line: <40-hex sha> TAB <YYYY-MM-DD> TAB <subject>
//   arg3  output TSV
//
// OUTPUT TSV, grouped by citation:
//   CITE  <cited-sha>  <len>  <n_candidates>
//   CAND  <cited-sha>  <hamming-distance>  <full-sha>  <date>  <subject>
// then a trailing summary block:
//   STAT  <key>  <value>
//
// READ-ONLY with respect to canonical_ledger/CLAIM_LEDGER.md. This program
// does not edit the ledger and does not decide what a citation means; it only
// enumerates candidates. Adopting any remap is a ledger-owner decision.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}
fn iarr(n:i32)[]u8 { return z_alloc(n*4); }
fn gi(b:[]u8,i:i32)i32 { return get32(b,i*4); }
fn si(b:[]u8,i:i32,v:i32)void { set32(b,i*4,v); return; }

fn ishex(c:i32)i32 {
  if(c>=48 && c<=57){ return 1; }
  if(c>=97 && c<=102){ return 1; }
  if(c>=65 && c<=70){ return 1; }
  return 0;
}

// o_app: append a byte slice at offset c, return new cursor.
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_str(b:[]u8,c:i32,s:[]u8)i32 { return o_app(b,c,s); }
fn o_ch(b:[]u8,c:i32,v:i32)i32 { b[c]=v as u8; return c+1; }
fn o_i(b:[]u8,c:i32,v:i32)i32 {
  if(v==0){ return o_ch(b,c,48); }
  let neg:i32=0; let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i32=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i32=x;
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

// LOC record for one candidate: full-sha line start in the commit buffer,
// plus subject start and length.
fn CSHA()i32 { return 0; }
fn CSUB()i32 { return 4; }
fn CSUBL()i32 { return 8; }
fn LSTRIDE()i32 { return 12; }

// scan lines of buf[0..n]; for each line record start in starts[i].
// returns the number of lines found.
fn lines(buf:[]u8,n:i32,starts:[]u8)i32 {
  let k:i32=0; let i:i32=0; let ls:i32=0;
  while(i<n){
    if(buf[i]==10){
      si(starts,k,ls); k=k+1; ls=i+1;
    }
    i=i+1;
  }
  if(ls<n){ si(starts,k,ls); k=k+1; }
  return k;
}

// trim leading/trailing spaces+CR from a line -> returns length
fn tlen(buf:[]u8,s:i32,e:i32)i32 {
  let a:i32=s; let z:i32=e;
  while(a<z){ let c:i32=buf[a] as i32;
    if(c==32 || c==9 || c==13){ a=a+1; } else { break; } }
  while(z>a){ let c:i32=buf[z-1] as i32;
    if(c==32 || c==9 || c==13){ z=z-1; } else { break; } }
  return z-a;
}

fn main()i32 {
  let p1:[]u8=_zag_arg(1);
  let p2:[]u8=_zag_arg(2);
  let p3:[]u8=_zag_arg(3);
  if(_zag_file_exists(p1)==false){ _zag_println("PARSE_ERR:absent_file_missing"); return 1; }
  if(_zag_file_exists(p2)==false){ _zag_println("PARSE_ERR:commit_file_missing"); return 1; }

  let a:[]u8=_zag_read_file(p1);
  let c:[]u8=_zag_read_file(p2);
  _zag_print("ABSENT_BYTES "); _zag_println(_zag_i64_to_str(a.len as i64));
  _zag_print("COMMITS_BYTES "); _zag_println(_zag_i64_to_str(c.len as i64));

  // ---- index commits ----
  let maxc:i32=(c.len/8)+8;
  let cs:[]u8=iarr(maxc);            // line starts
  let cl:i32=lines(c,c.len,cs);     // commit line count
  _zag_print("COMMITS_INDEXED "); _zag_println(_zag_i64_to_str(cl as i64));

  let loc:[]u8=iarr(cl*LSTRIDE());  // per-commit loc record
  let j:i32=0;
  while(j<cl){
    let s:i32=gi(cs,j);
    let e:i32=0;
    if(j+1<cl){ e=gi(cs,j+1)-1; } else { e=c.len; }
    let L:i32=tlen(c,s,e);
    // subject starts after 40-hex + TAB + date + TAB
    let sub:i32=s+52;
    let k:i32=sub;
    while(k<s+L){ if(c[k]==10){ break; } k=k+1; }
    set32(loc,j*LSTRIDE()+CSHA(),s);
    set32(loc,j*LSTRIDE()+CSUB(),sub);
    set32(loc,j*LSTRIDE()+CSUBL(),k-sub);
    j=j+1;
  }

  // ---- index absent citations ----
  let maxa:i32=(a.len/2)+8;
  let as_:[]u8=iarr(maxa);
  let as2:[]u8=iarr(maxa);
  let al:i32=lines(a,a.len,as2);
  _zag_print("CITATIONS_INDEXED "); _zag_println(_zag_i64_to_str(al as i64));

  // candidate rows: at most 4 per citation for reporting; count them all
  let cand:[]u8=iarr(al*4);
  let cand2:[]u8=iarr(al*4);
  let candd:[]u8=iarr(al*4);
  let n0:i32=0; let n1:i32=0; let nm:i32=0; let rows:i32=0; let skip:i32=0;

  let ob:[]u8=z_alloc(4000000);
  let oc:i32=0;

  let i:i32=0;
  while(i<al){
    let s:i32=gi(as2,i);
    let e:i32=0;
    if(i+1<al){ e=gi(as2,i+1)-1; } else { e=a.len; }
    // the last line has no following newline to bound it; drop it explicitly
    if(i+1>=al){ if(e>s){ if(a[e-1]==10){ e=e-1; } } }
    let L:i32=tlen(a,s,e);
    // a citation must be an 8-, 9- or 10-char hex run; anything else is not a
    // commit-abbreviation and is counted as skipped, never silently dropped
    if(L<8 || L>10){
      skip=skip+1;
      i=i+1; continue;
    }
    si(as_,i,s);
    let n:i32=0;
    let q:i32=0;
    while(q<cl){
      let cs2:i32=get32(loc,q*LSTRIDE()+CSHA());
      let d:i32=0; let p:i32=0;
      while(p<L){
        let x:i32=a[s+p] as i32;
        let y:i32=c[cs2+p] as i32;
        if(x!=y){ d=d+1; }
        p=p+1;
      }
      if(d<=1){
        if(n<4){ si(cand2,n*al+i,q); si(candd,n*al+i,d); }
        n=n+1;
      }
      q=q+1;
    }
    si(cand,i,n);
    // emit CITE
    oc=o_str(ob,oc,"CITE\t"); oc=o_app(ob,oc,a[s..s+L]);
    oc=o_ch(ob,oc,9); oc=o_i(ob,oc,L); oc=o_ch(ob,oc,9);
    oc=o_i(ob,oc,n); oc=o_nl(ob,oc);
    let r:i32=0;
    if(n>4){ r=4; } else { r=n; }
    while(r>0){
      let qq:i32=gi(cand2,(r-1)*al+i);
      let dd:i32=gi(candd,(r-1)*al+i);
      let ss:i32=get32(loc,qq*LSTRIDE()+CSHA());
      let sb:i32=get32(loc,qq*LSTRIDE()+CSUB());
      let sl:i32=get32(loc,qq*LSTRIDE()+CSUBL());
      oc=o_str(ob,oc,"CAND\t"); oc=o_app(ob,oc,a[s..s+L]);
      oc=o_ch(ob,oc,9); oc=o_i(ob,oc,dd); oc=o_ch(ob,oc,9);
      oc=o_app(ob,oc,c[ss..ss+40]); oc=o_ch(ob,oc,9);
      oc=o_app(ob,oc,c[ss+41..ss+51]); oc=o_ch(ob,oc,9);
      oc=o_app(ob,oc,c[sb..sb+sl]); oc=o_nl(ob,oc);
      rows=rows+1;
      r=r-1;
    }
    if(n==0){ n0=n0+1; }
    if(n==1){ n1=n1+1; }
    if(n>1){ nm=nm+1; }
    i=i+1;
  }

  _zag_write_file(p3,ob[0..oc]);
  _zag_print("CANDIDATE_ROWS "); _zag_println(_zag_i64_to_str(rows as i64));
  _zag_print("STAT cites_indexed "); _zag_println(_zag_i64_to_str(al as i64));
  _zag_print("STAT cites_tested "); _zag_println(_zag_i64_to_str(al-skip as i64));
  _zag_print("STAT cites_skipped_bad_length "); _zag_println(_zag_i64_to_str(skip as i64));
  _zag_print("STAT cites_no_candidate "); _zag_println(_zag_i64_to_str(n0 as i64));
  _zag_print("STAT cites_unique_repair "); _zag_println(_zag_i64_to_str(n1 as i64));
  _zag_print("STAT cites_ambiguous "); _zag_println(_zag_i64_to_str(nm as i64));
  _zag_println("REMAP_DONE");
  return 0;
}

// fm_main.zag -- FORMAL-MIGRATION E6.1.
// Question: does formal knowledge migrate (advisory -> representational)
// and automatically constrain behavior in the new substrate?
// Learner: list store + induct over duplicate-failure judgments ->
// UNIQUENESS clause (advisory). Disconfirmations attributed to the clause
// accumulate; at 3 consecutive the meta-gate latches and the learner
// migrates list -> keyed, reading the key field from its own induced
// clause. Post-migration the 200-attempt adversarial battery commits
// zero duplicates (representational: no refusal branch, the op IS
// write-to-slot). Control NOMIG: list throughout, duplicates commit.
// Pure Zag. Deterministic: fixed schedules, no RNG.
// Output: single preallocated buffer, one _zag_raw_syscall write.
//
// State layout (cells, i32, u8-backed):
//   0 latch, 1 discon_run, 2 refusals, 3 migrated, 4 store_mode(0=list,1=keyed)
//   5 fired_run, 6 withevidence, 7 phaseP_new, 8 phaseP_upd,
//   9 store_keyfield (field the keyed store binds), 10 phaseA_upd (scratch),
//   14 pre-latch migration successes (expect 0)
//   20..51 duplicate-measurement bitmap
//   100 list n; 120+i*2 (key,val) cap 300
//   800 keyed n; 820+i*2 (field0,field1) cap 16
//   1000+j*4 judgments (label,f0,f1,f2), 56 judgments
//   1400 clause kind, 1401 clause keyfield, 1402 clause status

// ============ SECTION: generic machinery (alloc, cells, emit) ============

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}

// ============ SECTION: stores ============

fn list_insert(S:[]u8,k:i32,v:i32)void {
  let n:i32=sg(S,100);
  ss(S,120+n*2,k); ss(S,120+n*2+1,v); ss(S,100,n+1);
  return;
}
fn list_seen(S:[]u8,k:i32)i32 {
  let n:i32=sg(S,100);
  let i:i32=0;
  let f:i32=0;
  while(i<n){
    let kk:i32=sg(S,120+i*2);
    if(kk==k){ f=1; }
    i=i+1;
  }
  return f;
}
// Representational UNIQUENESS: insert(k,v) IS write-to-slot(kf).
// No refusal branch: a duplicate key updates the slot; a second entry
// with the same key has no encoding. Returns 1=update, 0=new.
fn keyed_insert(S:[]u8,k:i32,v:i32,kf:i32)i32 {
  let n:i32=sg(S,800);
  let i:i32=0;
  let hit:i32=-1;
  while(i<n){
    let kk:i32=sg(S,820+i*2+kf);
    if(kk==k){ hit=i; }
    i=i+1;
  }
  if(hit>=0){ ss(S,820+hit*2+1-kf,v); return 1; }
  ss(S,820+n*2+kf,k); ss(S,820+n*2+1-kf,v); ss(S,800,n+1);
  return 0;
}
fn dupkeys(S:[]u8,ncell:i32,ebase:i32)i32 {
  let n:i32=sg(S,ncell);
  let c:i32=0;
  while(c<32){ ss(S,20+c,0); c=c+1; }
  let d:i32=0;
  let i:i32=0;
  while(i<n){
    let k:i32=sg(S,ebase+i*2);
    let seen:i32=sg(S,20+k);
    if(seen==0){ ss(S,20+k,1); d=d+1; }
    i=i+1;
  }
  return n-d;
}

// ============ SECTION: induct (Occam over the judgment window) ============
// Judgments at 1000+j*4: (label, f0, f1, f2); label 1=accept, 0=reject.
// Separator: first single feature with all accepts f=0 and all rejects f=1.
// Writes the clause (kind=1 UNIQUENESS, keyfield=field of selected
// feature, status=2 ADVISORY). Returns the selected feature.

fn induct(S:[]u8,nj:i32)i32 {
  let f:i32=0;
  let sel:i32=-1;
  while(f<3){
    let ok:i32=1;
    let j:i32=0;
    while(j<nj){
      let lab:i32=sg(S,1000+j*4);
      let fv:i32=sg(S,1000+j*4+1+f);
      let is_acc:i32=0;
      if(lab==1){ is_acc=1; }
      let is_rej:i32=0;
      if(lab==0){ is_rej=1; }
      let fv0:i32=0;
      if(fv==0){ fv0=1; }
      let fv1:i32=0;
      if(fv==1){ fv1=1; }
      let bad_a:i32=is_acc*(1-fv0);
      let bad_r:i32=is_rej*(1-fv1);
      if(bad_a==1){ ok=0; }
      if(bad_r==1){ ok=0; }
      j=j+1;
    }
    if(ok==1){ if(sel==-1){ sel=f; } }
    f=f+1;
  }
  ss(S,1400,1);
  let kf:i32=0;
  if(sel==1){ kf=1; }
  ss(S,1401,kf);
  ss(S,1402,2);
  return sel;
}

// ============ SECTION: disconfirmation + meta-gate + migration ============

fn disconfirm(S:[]u8)void {
  let r:i32=sg(S,1)+1;
  ss(S,1,r);
  if(r>=3){ ss(S,0,1); }
  return;
}
fn reset_run(S:[]u8)void { ss(S,1,0); return; }

// The migration op flows through the meta-gate: without the latched
// disconfirmation evidence it is refused (no state change); with the
// latch it copies the list into a keyed store keyed on the clause's
// own keyfield, and promotes the clause to ACTIVE-REPRESENTATIONAL.
fn do_migrate(S:[]u8)i32 {
  let latch:i32=sg(S,0);
  if(latch!=1){ ss(S,2,sg(S,2)+1); return 0; }
  let kf:i32=sg(S,1401);
  ss(S,9,kf);
  ss(S,800,0);
  let n:i32=sg(S,100);
  let i:i32=0;
  while(i<n){
    let kk:i32=sg(S,120+i*2+kf);
    let vv:i32=sg(S,120+i*2+1-kf);
    ss(S,16,sg(S,16)+keyed_insert(S,kk,vv,kf)); // scratch: copy overwrites
    i=i+1;
  }
  ss(S,4,1);
  ss(S,3,1);
  ss(S,6,1);
  ss(S,5,sg(S,1));
  ss(S,1402,3);
  return 1;
}

// ============ SECTION: driver ============

fn mig_arm(S:[]u8,OUT:[]u8,cur:i32)i32 {
  ss(S,5,-1); ss(S,9,-1);
  // Phase J: 56 judgment attempts, keys cycling 1..7.
  let k:i32=0;
  let i:i32=0;
  while(i<56){
    k=k+1;
    if(k>7){ k=1; }
    let v:i32=1000+i;
    let seen:i32=list_seen(S,k);
    list_insert(S,k,v);
    let lab:i32=0;
    if(seen==0){ lab=1; }
    let f1:i32=0;
    if(v>1050){ f1=1; }
    ss(S,1000+i*4,lab);
    ss(S,1000+i*4+1,seen);
    ss(S,1000+i*4+2,f1);
    ss(S,1000+i*4+3,1);
    i=i+1;
  }
  let sel:i32=induct(S,56);
  ss(S,15,sg(S,1402)); // snapshot: post-induct clause status (ADVISORY=2)
  // Phase A: 30 adversarial attempts, k = (j*5 mod 11)+1.
  let ka:i32=1;
  let j:i32=0;
  while(j<30){
    if(j>0){ ka=ka+5; if(ka>11){ ka=ka-11; } }
    let v:i32=2000+j;
    let mode:i32=sg(S,4);
    if(mode==0){
      let seen:i32=list_seen(S,ka);
      list_insert(S,ka,v);
      if(seen==1){ disconfirm(S); }
      if(seen==0){ reset_run(S); }
      let run:i32=sg(S,1);
      let mig:i32=sg(S,3);
      if(mig==0){
        if(run>=2){
          let lat:i32=sg(S,0);
          let mr:i32=do_migrate(S);
          if(lat==0){
            if(mr==1){ ss(S,14,sg(S,14)+1); }
          }
        }
      }
    }
    if(mode==1){
      let kf:i32=sg(S,9);
      let upd:i32=keyed_insert(S,ka,v,kf);
      ss(S,10,sg(S,10)+upd);
    }
    j=j+1;
  }
  // Phase P: 200 post-migration attempts, keys cycling 1..7.
  let kp:i32=1;
  let p:i32=0;
  while(p<200){
    if(p>0){ kp=kp+5; if(kp>7){ kp=kp-7; } }
    let v:i32=3000+p;
    let kf:i32=sg(S,9);
    let r:i32=keyed_insert(S,kp,v,kf);
    if(r==0){ ss(S,7,sg(S,7)+1); }
    if(r==1){ ss(S,8,sg(S,8)+1); }
    p=p+1;
  }
  let nkeys:i32=sg(S,800);
  let dk:i32=dupkeys(S,800,820);
  cur=e1str(OUT,cur,"FM-J 56 A 30 P 200\n");
  cur=e1str(OUT,cur,"FM-INDUCT sel=");
  cur=e1i64(OUT,cur,sel as i64);
  cur=e1str(OUT,cur," kind=");
  cur=e1i64(OUT,cur,sg(S,1400) as i64);
  cur=e1str(OUT,cur," keyfield=");
  cur=e1i64(OUT,cur,sg(S,1401) as i64);
  cur=e1str(OUT,cur," status=");
  cur=e1i64(OUT,cur,sg(S,15) as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FM-GATE refusals=");
  cur=e1i64(OUT,cur,sg(S,2) as i64);
  cur=e1str(OUT,cur," noevidence=");
  cur=e1i64(OUT,cur,sg(S,14) as i64);
  cur=e1str(OUT,cur," withevidence=");
  cur=e1i64(OUT,cur,sg(S,6) as i64);
  cur=e1str(OUT,cur," fired_run=");
  cur=e1i64(OUT,cur,sg(S,5) as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FM-MIGRATE keyfield=");
  cur=e1i64(OUT,cur,sg(S,9) as i64);
  cur=e1str(OUT,cur," entries=");
  cur=e1i64(OUT,cur,nkeys as i64);
  cur=e1str(OUT,cur," status=");
  cur=e1i64(OUT,cur,sg(S,1402) as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FM-POST entries=");
  cur=e1i64(OUT,cur,nkeys as i64);
  cur=e1str(OUT,cur," dupkeys=");
  cur=e1i64(OUT,cur,dk as i64);
  cur=e1str(OUT,cur," newP=");
  cur=e1i64(OUT,cur,sg(S,7) as i64);
  cur=e1str(OUT,cur," updP=");
  cur=e1i64(OUT,cur,sg(S,8) as i64);
  cur=e1str(OUT,cur,"\n");
  // K4 values staged in cells 17/18/19; emitted by main after FM-NOMIG
  // so stdout order matches the frozen prereg exactly.
  let ikf:i32=sg(S,1401);
  let bkf:i32=sg(S,9);
  let match:i32=0;
  if(ikf==bkf){ match=1; }
  ss(S,17,ikf); ss(S,18,bkf); ss(S,19,match);
  return cur;
}

fn nomig_arm(S:[]u8,OUT:[]u8,cur:i32)i32 {
  let k:i32=0;
  let i:i32=0;
  while(i<56){
    k=k+1;
    if(k>7){ k=1; }
    list_insert(S,k,1000+i);
    i=i+1;
  }
  let ka:i32=1;
  let j:i32=0;
  while(j<30){
    if(j>0){ ka=ka+5; if(ka>11){ ka=ka-11; } }
    list_insert(S,ka,2000+j);
    j=j+1;
  }
  let kp:i32=1;
  let p:i32=0;
  while(p<200){
    if(p>0){ kp=kp+5; if(kp>7){ kp=kp-7; } }
    list_insert(S,kp,3000+p);
    p=p+1;
  }
  let n:i32=sg(S,100);
  let dk:i32=dupkeys(S,100,120);
  cur=e1str(OUT,cur,"FM-NOMIG entries=");
  cur=e1i64(OUT,cur,n as i64);
  cur=e1str(OUT,cur," dupkeys=");
  cur=e1i64(OUT,cur,dk as i64);
  cur=e1str(OUT,cur,"\n");
  return cur;
}

fn emit_k4(S:[]u8,OUT:[]u8,cur:i32)i32 {
  cur=e1str(OUT,cur,"FM-K4 induct_kf=");
  cur=e1i64(OUT,cur,sg(S,17) as i64);
  cur=e1str(OUT,cur," bind_kf=");
  cur=e1i64(OUT,cur,sg(S,18) as i64);
  cur=e1str(OUT,cur," match=");
  cur=e1i64(OUT,cur,sg(S,19) as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"FM-END\n");
  return cur;
}

fn main()i32 {
  let OUT:[]u8=z_alloc(65536);
  let cur:i32=0;
  let S:[]u8=z_alloc(16384);
  cur=mig_arm(S,OUT,cur);
  let S2:[]u8=z_alloc(16384);
  cur=nomig_arm(S2,OUT,cur);
  cur=emit_k4(S,OUT,cur);
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){return 0;}
  return 1;
}

// causal_revert.zag -- Causal-lane revert with LEARNER-CONSTRUCTED graphs.
// Pure Zag. No Python.
// Prereg: PREREG_CAUSAL_REVERT.md (commit c09afd95e, strictly before this file).
//
// Builds on ddes_revert.zag (REVERT-ADAPT-PASS, 00e9a766e). The derivation
// core (arrival computation, n-candidate frontier, plan synthesis,
// analytic predictor, world stepper) is copied verbatim from
// ddes_revert.zag at 00e9a766e (which copies verbatim from the frozen
// DDES sources). The intervention machinery is the H-CAUSALEXP-CONSTRUCT
// experiment-construction mechanism (BUILD-PASS 7/7, SURVIVES-AS-L2, L3
// KILLED; governance 45db44fab).
//
// New in this work: candidate graphs are LEARNER-CONSTRUCTED (generic
// 78-graph enumerator + passive-evidence filter + behavioral-equivalence
// quotient), not researcher-supplied. Modes: REVISE (edit-neighborhood
// revision of the persistent learned graph), REBUILD (fresh construction
// per phase, re-selection baseline), FROZEN (never revise, pathology
// baseline). Cases: R1 change-then-revert [G0,G1,G0], R2 permanent-change
// control [G0,G2,G2].
//
// Graph slot layout (32 bytes): +0 nr(i32), +4 src[2](i32), +12 dst[2](i32),
// +20 delay[2](i32), +28 unused.
// Variables: X=0, Y=1, Z=2. Rules (src,dst,delay), src!=dst, delay in {1,2}.

extern fn _zag_malloc(n:i32)*u8;
extern fn _zag_print(s:[]u8)void;
extern fn _zag_i64_to_str(v:i64)[]u8;

// ============ utils (verbatim from frozen ddes_revert.zag) ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ generic arrival computation (verbatim) ============
fn compute_arrivals(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, out:[]u8)void {
  let INF:i32=268435456;
  let v:i32=0;
  while(v<n_vars){
    set32(out, v*4, INF);
    v=v+1;
  }
  if(use_set_x==1){
    set32(out, 0, 0);
  }
  let pass:i32=0;
  while(pass<n_vars){
    let i:i32=0;
    while(i<n_rules){
      let s:i32=get32(src, i*4);
      let d:i32=get32(dst, i*4);
      let w:i32=get32(delay, i*4);
      let as:i32=get32(out, s*4);
      if(as<INF){
        let cand:i32=as+w;
        let ad:i32=get32(out, d*4);
        if(cand<ad){
          set32(out, d*4, cand);
        }
      }
      i=i+1;
    }
    pass=pass+1;
  }
  return;
}

// ============ eff_waits (verbatim) ============
fn eff_waits(t_star:i32)i32 {
  if(t_star<1){return 1;}
  return t_star;
}

// ============ generic plan synthesis (verbatim) ============
fn synthesize_plan_gen(v_star:i32, t_star:i32, use_set_x:i32, plan:[]u8, plans_built:[]u8) i32 {
  let len:i32=0;
  let cur_t:i32=0;
  if(use_set_x==1){
    plan[len]=0;
    len=len+1;
  }
  let w:i32=eff_waits(t_star);
  while(cur_t<w){
    plan[len]=1;
    len=len+1;
    cur_t=cur_t+1;
  }
  let obs:i32=2+v_star;
  plan[len]=obs as u8;
  len=len+1;
  set32(plans_built, 0, get32(plans_built, 0)+1);
  return len;
}

// ============ analytic predictor (verbatim) ============
fn predict_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, use_set_x:i32, v_star:i32, t_star:i32)i32 {
  let arr:[]u8=z_alloc(n_vars*4);
  compute_arrivals(n_rules, src, dst, delay, n_vars, use_set_x, arr);
  let a:i32=get32(arr, v_star*4);
  let w:i32=eff_waits(t_star);
  if(a<=w){return 1;}
  return 0;
}

// ============ world stepper (verbatim) ============
fn world_step_gen(n_rules:i32, src:[]u8, dst:[]u8, delay:[]u8, n_vars:i32, st:[]u8, a:i32)i32 {
  let obs:i32=-1;
  let time_off:i32=n_vars*4;
  let ts_base:i32=n_vars*4+4;
  if(a==0){
    set32(st,0,1);
    set32(st,ts_base,get32(st,time_off));
  } else if(a==1){
    let t:i32=get32(st,time_off)+1;
    set32(st,time_off,t);
    let pass:i32=0;
    while(pass<n_vars){
      let r:i32=0;
      while(r<n_rules){
        let s:i32=get32(src, r*4);
        let d:i32=get32(dst, r*4);
        let w:i32=get32(delay, r*4);
        if(get32(st,s*4)==1){
          let ts:i32=get32(st,ts_base+s*4);
          if(t-ts>=w){
            if(get32(st,d*4)==0){
              set32(st,d*4,1);
              set32(st,ts_base+d*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else {
    let v:i32=a-2;
    obs=get32(st,v*4);
  }
  return obs;
}

// ============ graph slot helpers (32-byte slots) ============
fn g_nr(buf:[]u8, b:i32)i32 { return get32(buf, b); }
fn g_src(buf:[]u8, b:i32)[]u8 { return buf[b+4..b+12]; }
fn g_dst(buf:[]u8, b:i32)[]u8 { return buf[b+12..b+20]; }
fn g_delay(buf:[]u8, b:i32)[]u8 { return buf[b+20..b+28]; }
fn g_set(buf:[]u8, b:i32, nr:i32, s0:i32, d0:i32, w0:i32, s1:i32, d1:i32, w1:i32)void {
  set32(buf, b, nr);
  set32(buf, b+4, s0); set32(buf, b+8, s1);
  set32(buf, b+12, d0); set32(buf, b+16, d1);
  set32(buf, b+20, w0); set32(buf, b+24, w1);
  return;
}
fn g_copy(buf:[]u8, sb:i32, db:i32)void {
  let i:i32=0;
  while(i<32){ buf[db+i]=buf[sb+i]; i=i+1; }
  return;
}
// Sort the rules within a graph slot by (src,dst,delay). Canonical order.
fn g_sort_rules(buf:[]u8, b:i32)void {
  if(get32(buf,b)!=2){ return; }
  let s0:i32=get32(buf,b+4); let d0:i32=get32(buf,b+12); let w0:i32=get32(buf,b+20);
  let s1:i32=get32(buf,b+8); let d1:i32=get32(buf,b+16); let w1:i32=get32(buf,b+24);
  let swap:i32=0;
  if(s0>s1){ swap=1; }
  else if(s0==s1){ if(d0>d1){ swap=1; } else if(d0==d1){ if(w0>w1){ swap=1; } } }
  if(swap==1){
    set32(buf,b+4,s1); set32(buf,b+8,s0);
    set32(buf,b+12,d1); set32(buf,b+16,d0);
    set32(buf,b+20,w1); set32(buf,b+24,w0);
  }
  return;
}
// Canonical equality: same nr and same sorted rule multiset.
fn g_eq_canon(buf:[]u8, b1:i32, b2:i32)i32 {
  if(get32(buf,b1)!=get32(buf,b2)){ return 0; }
  let nr:i32=get32(buf,b1);
  let r:i32=0;
  while(r<nr){
    if(get32(buf,b1+4+r*4)!=get32(buf,b2+4+r*4)){ return 0; }
    if(get32(buf,b1+12+r*4)!=get32(buf,b2+12+r*4)){ return 0; }
    if(get32(buf,b1+20+r*4)!=get32(buf,b2+20+r*4)){ return 0; }
    r=r+1;
  }
  return 1;
}
// Cross-buffer canonical equality.
fn g_eq_canon2(b1:[]u8, o1:i32, b2:[]u8, o2:i32)i32 {
  if(get32(b1,o1)!=get32(b2,o2)){ return 0; }
  let nr:i32=get32(b1,o1);
  let r:i32=0;
  while(r<nr){
    if(get32(b1,o1+4+r*4)!=get32(b2,o2+4+r*4)){ return 0; }
    if(get32(b1,o1+12+r*4)!=get32(b2,o2+12+r*4)){ return 0; }
    if(get32(b1,o1+20+r*4)!=get32(b2,o2+20+r*4)){ return 0; }
    r=r+1;
  }
  return 1;
}
// Cross-buffer copy of one 32-byte graph slot.
fn g_copy2(sb:[]u8, so:i32, db:[]u8, do:i32)void {
  let i:i32=0;
  while(i<32){ db[do+i]=sb[so+i]; i=i+1; }
  return;
}
// Lexicographic comparison of sorted rule lists. Returns -1,0,1.
fn g_cmp_lex(buf:[]u8, b1:i32, b2:i32)i32 {
  let n1:i32=get32(buf,b1); let n2:i32=get32(buf,b2);
  if(n1<n2){ return -1; }
  if(n1>n2){ return 1; }
  let r:i32=0;
  while(r<n1){
    let a0:i32=get32(buf,b1+4+r*4); let a1:i32=get32(buf,b2+4+r*4);
    if(a0<a1){ return -1; } if(a0>a1){ return 1; }
    let c0:i32=get32(buf,b1+12+r*4); let c1:i32=get32(buf,b2+12+r*4);
    if(c0<c1){ return -1; } if(c0>c1){ return 1; }
    let e0:i32=get32(buf,b1+20+r*4); let e1:i32=get32(buf,b2+20+r*4);
    if(e0<e1){ return -1; } if(e0>e1){ return 1; }
    r=r+1;
  }
  return 0;
}
fn emit_graph(buf:[]u8, b:i32)void {
  emit("[");
  let nr:i32=get32(buf,b);
  let r:i32=0;
  while(r<nr){
    if(r>0){ emit(","); }
    emit("("); e64(get32(buf,b+4+r*4)); emit(",");
    e64(get32(buf,b+12+r*4)); emit(","); e64(get32(buf,b+20+r*4)); emit(")");
    r=r+1;
  }
  emit("]");
  return;
}

// ============ n-candidate disagreement frontier (adapted from verbatim frontier_surv) ============
fn frontier_cands(cands:[]u8, surv:[]u8, n_cands:i32, n_vars:i32, out_found:[]u8, out_v:[]u8, out_t:[]u8, out_schema:[]u8)void {
  let INF:i32=268435456;
  let best_t:i32=INF;
  let best_v:i32=-1;
  let best_s:i32=-1;
  let schema:i32=1;
  while(schema>=0){
    let arrs:[]u8=z_alloc(n_cands*n_vars*4);
    let k:i32=0;
    while(k<n_cands){
      if(get32(surv,k*4)==1){
        let lo:i32=k*n_vars*4;
        let hi:i32=lo+n_vars*4;
        let b:i32=k*32;
        compute_arrivals(get32(cands,b), g_src(cands,b), g_dst(cands,b), g_delay(cands,b), n_vars, schema, arrs[lo..hi]);
      }
      k=k+1;
    }
    let v:i32=0;
    while(v<n_vars){
      let all_eq:i32=1;
      let mn:i32=INF;
      let first:i32=1;
      let fv:i32=0;
      k=0;
      while(k<n_cands){
        if(get32(surv,k*4)==1){
          let a:i32=get32(arrs,(k*n_vars+v)*4);
          if(first==1){ fv=a; first=0; } else { if(a!=fv){ all_eq=0; } }
          if(a<mn){ mn=a; }
        }
        k=k+1;
      }
      if(first==0 && all_eq==0){
        if(mn<best_t){ best_t=mn; best_v=v; best_s=schema; }
      }
      v=v+1;
    }
    schema=schema-1;
  }
  if(best_v>=0){
    set32(out_found, 0, 1);
    set32(out_v, 0, best_v);
    set32(out_t, 0, best_t);
    set32(out_schema, 0, best_s);
  } else {
    set32(out_found, 0, 0);
  }
  return;
}

// ============ rule index (lex order over (src,dst,delay)) ============
// idx = s*4 + dcode*2 + (w-1), dcode = d>s ? d-1 : d. 12 rules total.
fn rule_by_idx(idx:i32, out_s:[]u8, out_d:[]u8, out_w:[]u8)void {
  let s:i32=idx/4;
  let rem:i32=idx-(idx/4)*4;
  let dcode:i32=rem/2;
  let w:i32=(rem-(rem/2)*2)+1;
  let d:i32=dcode;
  if(dcode>=s){ d=dcode+1; }
  set32(out_s,0,s); set32(out_d,0,d); set32(out_w,0,w);
  return;
}
fn rule_present(buf:[]u8, b:i32, s:i32, d:i32, w:i32)i32 {
  let nr:i32=get32(buf,b);
  let r:i32=0;
  while(r<nr){
    if(get32(buf,b+4+r*4)==s && get32(buf,b+12+r*4)==d && get32(buf,b+20+r*4)==w){ return 1; }
    r=r+1;
  }
  return 0;
}

// ============ enumerate all 78 graphs (12 one-rule + 66 two-rule) ============
fn gen_all_graphs(table:[]u8)i32 {
  let n:i32=0;
  let os:[]u8=z_alloc(4); let od:[]u8=z_alloc(4); let ow:[]u8=z_alloc(4);
  let idx:i32=0;
  while(idx<12){
    rule_by_idx(idx, os, od, ow);
    g_set(table, n*32, 1, get32(os,0), get32(od,0), get32(ow,0), 0,0,0);
    n=n+1;
    idx=idx+1;
  }
  let i:i32=0;
  while(i<12){
    let j:i32=i+1;
    while(j<12){
      rule_by_idx(i, os, od, ow);
      let s0:i32=get32(os,0); let d0:i32=get32(od,0); let w0:i32=get32(ow,0);
      rule_by_idx(j, os, od, ow);
      let s1:i32=get32(os,0); let d1:i32=get32(od,0); let w1:i32=get32(ow,0);
      g_set(table, n*32, 2, s0,d0,w0, s1,d1,w1);
      n=n+1;
      j=j+1;
    }
    i=i+1;
  }
  return n;
}

// ============ frozen evidence and true laws ============
// E slot: 3 obs * 12 bytes (var,time,expected as i32).
fn load_evidence(case_id:i32, phase:i32, E:[]u8)void {
  // E0=(Y,1)=1,(Y,2)=1,(Z,2)=0 ; E1=(Y,1)=0,(Y,2)=1,(Z,2)=1 ; E1p=(Y,1)=0,(Y,2)=1,(Z,2)=0
  let sel:i32=0; // 0=E0, 1=E1, 2=E1p
  if(case_id==0){
    if(phase==1){ sel=1; } else { sel=0; }
  } else {
    if(phase==0){ sel=0; } else { sel=2; }
  }
  if(sel==0){
    set32(E,0,1); set32(E,4,1); set32(E,8,1);
    set32(E,12,1); set32(E,16,2); set32(E,20,1);
    set32(E,24,2); set32(E,28,2); set32(E,32,0);
  } else if(sel==1){
    set32(E,0,1); set32(E,4,1); set32(E,8,0);
    set32(E,12,1); set32(E,16,2); set32(E,20,1);
    set32(E,24,2); set32(E,28,2); set32(E,32,1);
  } else {
    set32(E,0,1); set32(E,4,1); set32(E,8,0);
    set32(E,12,1); set32(E,16,2); set32(E,20,1);
    set32(E,24,2); set32(E,28,2); set32(E,32,0);
  }
  return;
}
// True laws: G0=[(X->Y,1)], G1=[(X->Z,1),(Z->Y,1)], G2=[(X->Y,2)].
// R1 phases [G0,G1,G0]. R2 phases [G0,G2,G2].
fn load_true(case_id:i32, phase:i32, G:[]u8)void {
  let sel:i32=0; // 0=G0, 1=G1, 2=G2
  if(case_id==0){
    if(phase==1){ sel=1; } else { sel=0; }
  } else {
    if(phase==0){ sel=0; } else { sel=2; }
  }
  if(sel==0){ g_set(G,0, 1, 0,1,1, 0,0,0); }
  else if(sel==1){ g_set(G,0, 2, 0,2,1, 2,1,1); }
  else { g_set(G,0, 1, 0,1,2, 0,0,0); }
  return;
}

// ============ consistency with passive evidence ============
fn graph_consistent(buf:[]u8, b:i32, E:[]u8)i32 {
  let arr:[]u8=z_alloc(12);
  compute_arrivals(get32(buf,b), g_src(buf,b), g_dst(buf,b), g_delay(buf,b), 3, 1, arr);
  let o:i32=0;
  while(o<3){
    let v:i32=get32(E,o*12); let t:i32=get32(E,o*12+4); let exp:i32=get32(E,o*12+8);
    let a:i32=get32(arr,v*4);
    let pred:i32=0;
    if(a<=t){ pred=1; }
    if(pred!=exp){ return 0; }
    o=o+1;
  }
  return 1;
}
// Behavioral signature: (arr[Y], arr[Z]).
fn graph_sig(buf:[]u8, b:i32, out_y:[]u8, out_z:[]u8)void {
  let arr:[]u8=z_alloc(12);
  compute_arrivals(get32(buf,b), g_src(buf,b), g_dst(buf,b), g_delay(buf,b), 3, 1, arr);
  set32(out_y,0,get32(arr,4));
  set32(out_z,0,get32(arr,8));
  return;
}

// ============ constructor: filter + quotient to canonical reps ============
// Returns n_reps. Writes n_graphs and n_classes to out counts.
fn construct(E:[]u8, reps:[]u8, out_ng:[]u8, out_nc:[]u8)i32 {
  let all:[]u8=z_alloc(128*32);
  let n_all:i32=gen_all_graphs(all);
  let cg:[]u8=z_alloc(128*32);
  let n_cg:i32=0;
  let i:i32=0;
  while(i<n_all){
    if(graph_consistent(all, i*32, E)==1){
      g_copy2(all, i*32, cg, n_cg*32);
      g_sort_rules(cg, n_cg*32);
      n_cg=n_cg+1;
    }
    i=i+1;
  }
  set32(out_ng,0,n_cg);
  // Group by signature; pick rep = fewest rules, then lexicographic.
  let oy:[]u8=z_alloc(4); let oz:[]u8=z_alloc(4);
  let sy:[]u8=z_alloc(4); let sz:[]u8=z_alloc(4);
  let n_rep:i32=0;
  i=0;
  while(i<n_cg){
    graph_sig(cg, i*32, sy, sz);
    let seen:i32=0;
    let j:i32=0;
    while(j<i){
      graph_sig(cg, j*32, oy, oz);
      if(get32(oy,0)==get32(sy,0) && get32(oz,0)==get32(sz,0)){ seen=1; }
      j=j+1;
    }
    if(seen==0){
      // First occurrence of this signature: find best rep.
      let best:i32=i;
      j=i+1;
      while(j<n_cg){
        graph_sig(cg, j*32, oy, oz);
        if(get32(oy,0)==get32(sy,0) && get32(oz,0)==get32(sz,0)){
          let nb:i32=get32(cg,j*32); let cb:i32=get32(cg,best*32);
          if(nb<cb){ best=j; }
          else if(nb==cb){ if(g_cmp_lex(cg, j*32, best*32)<0){ best=j; } }
        }
        j=j+1;
      }
      g_copy2(cg, best*32, reps, n_rep*32);
      n_rep=n_rep+1;
    }
    i=i+1;
  }
  set32(out_nc,0,n_rep);
  return n_rep;
}

// ============ 1-edit neighbors (deterministic order) ============
fn neighbors(buf:[]u8, b:i32, out:[]u8)i32 {
  let n:i32=0;
  let nr:i32=get32(buf,b);
  let r:i32=0;
  // Change one delay (flip 1<->2).
  while(r<nr){
    g_copy2(buf, b, out, n*32);
    let w:i32=get32(out, n*32+20+r*4);
    set32(out, n*32+20+r*4, 3-w);
    g_sort_rules(out, n*32);
    n=n+1;
    r=r+1;
  }
  // Add one rule (only if nr<2).
  if(nr<2){
    let os:[]u8=z_alloc(4); let od:[]u8=z_alloc(4); let ow:[]u8=z_alloc(4);
    let idx:i32=0;
    while(idx<12){
      rule_by_idx(idx, os, od, ow);
      let s:i32=get32(os,0); let d:i32=get32(od,0); let w:i32=get32(ow,0);
      if(rule_present(buf, b, s, d, w)==0){
        g_copy2(buf, b, out, n*32);
        set32(out, n*32, nr+1);
        set32(out, n*32+4+nr*4, s);
        set32(out, n*32+12+nr*4, d);
        set32(out, n*32+20+nr*4, w);
        g_sort_rules(out, n*32);
        n=n+1;
      }
      idx=idx+1;
    }
  }
  // Remove one rule.
  r=0;
  while(r<nr){
    g_copy2(buf, b, out, n*32);
    // Shift rules after r down.
    let q:i32=r;
    while(q<nr-1){
      set32(out, n*32+4+q*4, get32(out, n*32+4+(q+1)*4));
      set32(out, n*32+12+q*4, get32(out, n*32+12+(q+1)*4));
      set32(out, n*32+20+q*4, get32(out, n*32+20+(q+1)*4));
      q=q+1;
    }
    set32(out, n*32, nr-1);
    g_sort_rules(out, n*32);
    n=n+1;
    r=r+1;
  }
  // Dedupe within out, excluding the original graph (buf,b).
  let u:[]u8=z_alloc(32*32);
  let nu:i32=0;
  let i:i32=0;
  while(i<n){
    let dup:i32=0;
    let j:i32=0;
    while(j<nu){
      if(g_eq_canon2(out, i*32, u, j*32)==1){ dup=1; }
      j=j+1;
    }
    if(g_eq_canon2(out, i*32, buf, b)==1){ dup=1; }
    if(dup==0){
      g_copy2(out, i*32, u, nu*32);
      nu=nu+1;
    }
    i=i+1;
  }
  // Copy deduped back into out.
  i=0;
  while(i<nu){
    g_copy2(u, i*32, out, i*32);
    i=i+1;
  }
  return nu;
}
// Check whether canonical graph (cb,co) is in table (tab, n).
fn in_table(tab:[]u8, n:i32, cb:[]u8, co:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(g_eq_canon2(tab, i*32, cb, co)==1){ return 1; }
    i=i+1;
  }
  return 0;
}

// ============ REVISE: k-edit BFS revision of persistent learned graph ============
// Returns k used (0=keep, 1..3=revision depth), or -1 on DECLARE-REVISION-FAILED.
// On success writes reps and n_reps.
fn revise(W:[]u8, E:[]u8, reps:[]u8, out_nrep:[]u8)i32 {
  if(graph_consistent(W, 0, E)==1){
    g_copy2(W, 0, reps, 0);
    set32(out_nrep,0,1);
    return 0;
  }
  let seen:[]u8=z_alloc(128*32);
  let frontier:[]u8=z_alloc(128*32);
  let next:[]u8=z_alloc(128*32);
  let nbs:[]u8=z_alloc(32*32);
  g_copy2(W, 0, seen, 0);
  g_copy2(W, 0, frontier, 0);
  let n_seen:i32=1;
  let n_fr:i32=1;
  let KMAX:i32=3;
  let k:i32=1;
  while(k<=KMAX){
    let n_next:i32=0;
    let f:i32=0;
    while(f<n_fr){
      let nn:i32=neighbors(frontier, f*32, nbs);
      let h:i32=0;
      while(h<nn){
        if(in_table(seen, n_seen, nbs, h*32)==0){
          g_copy2(nbs, h*32, seen, n_seen*32);
          g_copy2(nbs, h*32, next, n_next*32);
          n_seen=n_seen+1;
          n_next=n_next+1;
        }
        h=h+1;
      }
      f=f+1;
    }
    // Filter next by E-consistency.
    let cf:[]u8=z_alloc(128*32);
    let n_cf:i32=0;
    f=0;
    while(f<n_next){
      if(graph_consistent(next, f*32, E)==1){
        g_copy2(next, f*32, cf, n_cf*32);
        n_cf=n_cf+1;
      }
      f=f+1;
    }
    if(n_cf>0){
      // Quotient cf by behavioral signature into reps.
      let oy:[]u8=z_alloc(4); let oz:[]u8=z_alloc(4);
      let sy:[]u8=z_alloc(4); let sz:[]u8=z_alloc(4);
      let n_rep:i32=0;
      let i:i32=0;
      while(i<n_cf){
        graph_sig(cf, i*32, sy, sz);
        let seen2:i32=0;
        let j:i32=0;
        while(j<i){
          graph_sig(cf, j*32, oy, oz);
          if(get32(oy,0)==get32(sy,0) && get32(oz,0)==get32(sz,0)){ seen2=1; }
          j=j+1;
        }
        if(seen2==0){
          let best:i32=i;
          j=i+1;
          while(j<n_cf){
            graph_sig(cf, j*32, oy, oz);
            if(get32(oy,0)==get32(sy,0) && get32(oz,0)==get32(sz,0)){
              let nb2:i32=get32(cf,j*32); let cb2:i32=get32(cf,best*32);
              if(nb2<cb2){ best=j; }
              else if(nb2==cb2){ if(g_cmp_lex(cf, j*32, best*32)<0){ best=j; } }
            }
            j=j+1;
          }
          g_copy2(cf, best*32, reps, n_rep*32);
          n_rep=n_rep+1;
        }
        i=i+1;
      }
      set32(out_nrep,0,n_rep);
      return k;
    }
    // frontier = next
    f=0;
    while(f<n_next){
      g_copy2(next, f*32, frontier, f*32);
      f=f+1;
    }
    n_fr=n_next;
    k=k+1;
  }
  return -1;
}

// ============ plan pretty-printer (DDES style) ============
fn emit_plan(plan:[]u8, plen:i32)void {
  emit("[");
  let j:i32=0;
  while(j<plen){
    let a:i32=plan[j] as i32;
    if(j>0){ emit(","); }
    if(a==0){ emit("S"); }
    else if(a==1){ emit("W"); }
    else { emit("O("); e64(a-2); emit(")"); }
    j=j+1;
  }
  emit("]");
  return;
}

// ============ intervention loop over learner-constructed reps ============
// Returns rounds. Writes winner index to out_win.
fn run_rounds(reps:[]u8, n_reps:i32, true_g:[]u8, cn:[]u8, mn:[]u8, ph:i32, out_win:[]u8)i32 {
  let surv:[]u8=z_alloc(n_reps*4);
  let i:i32=0;
  while(i<n_reps){ set32(surv,i*4,1); i=i+1; }
  let rounds:i32=0;
  let fnd:[]u8=z_alloc(4); let fv:[]u8=z_alloc(4);
  let ft:[]u8=z_alloc(4); let fs:[]u8=z_alloc(4);
  let oy:[]u8=z_alloc(4); let oz:[]u8=z_alloc(4);
  let INF:i32=268435456;
  while(rounds<=10){
    let nsv:i32=0; let last:i32=0;
    i=0;
    while(i<n_reps){
      if(get32(surv,i*4)==1){ nsv=nsv+1; last=i; }
      i=i+1;
    }
    if(nsv<=1){ set32(out_win,0,last); return rounds; }
    frontier_cands(reps, surv, n_reps, 3, fnd, fv, ft, fs);
    if(get32(fnd,0)==0){
      emit(cn); emit(" "); emit(mn); emit(" P"); e64(ph); emit(" NO-FRONTIER\n");
      set32(out_win,0,last);
      return rounds;
    }
    let v:i32=get32(fv,0); let t:i32=get32(ft,0); let sch:i32=get32(fs,0);
    let plan:[]u8=z_alloc(16);
    let pb:[]u8=z_alloc(4);
    let plen:i32=synthesize_plan_gen(v, t, sch, plan, pb);
    let st:[]u8=z_alloc(64);
    let real:i32=-1;
    let a:i32=0;
    while(a<plen){
      real=world_step_gen(get32(true_g,0), g_src(true_g,0), g_dst(true_g,0), g_delay(true_g,0), 3, st, plan[a] as i32);
      a=a+1;
    }
    emit(cn); emit(" "); emit(mn); emit(" P"); e64(ph);
    emit(" ROUND "); e64(rounds+1);
    emit(" TARGET V*="); e64(v); emit(" t*="); e64(t);
    emit(" PLAN "); emit_plan(plan, plen);
    emit(" EXEC real="); e64(real);
    i=0;
    while(i<n_reps){
      if(get32(surv,i*4)==1){
        let b:i32=i*32;
        let pred:i32=predict_gen(get32(reps,b), g_src(reps,b), g_dst(reps,b), g_delay(reps,b), 3, sch, v, t);
        if(pred!=real){
          set32(surv,i*4,0);
          graph_sig(reps, b, oy, oz);
          emit(" ELIM ");
          emit_graph(reps, b);
          emit(" sig=("); e64(get32(oy,0)); emit(",");
          if(get32(oz,0)>=INF){ emit("INF"); } else { e64(get32(oz,0)); }
          emit(")");
        }
      }
      i=i+1;
    }
    emit("\n");
    rounds=rounds+1;
  }
  emit(cn); emit(" "); emit(mn); emit(" P"); e64(ph); emit(" ROUND-LIMIT\n");
  set32(out_win,0,0);
  return rounds;
}

// ============ main: 2 cases x 3 modes x 3 phases ============
fn main()void {
  emit("CAUSAL-REVERT learner-constructed graphs. Prereg c09afd95e.\n");
  let ci:i32=0;
  while(ci<2){
    let cn:[]u8="R1";
    if(ci==1){ cn="R2"; }
    let mi:i32=0;
    while(mi<3){
      let mn:[]u8="REVISE";
      if(mi==1){ mn="REBUILD"; }
      if(mi==2){ mn="FROZEN"; }
      let W:[]u8=z_alloc(32);
      let W0:[]u8=z_alloc(32);
      let W1:[]u8=z_alloc(32);
      let rounds_total:i32=0;
      let ok:i32=0;
      let correct:i32=0;
      let ph:i32=0;
      while(ph<3){
        let E:[]u8=z_alloc(36);
        load_evidence(ci, ph, E);
        let TG:[]u8=z_alloc(32);
        load_true(ci, ph, TG);
        let reps:[]u8=z_alloc(8*32);
        let n_reps:i32=0;
        let ng:[]u8=z_alloc(4); let nc:[]u8=z_alloc(4);
        if(mi==0){
          if(ph==0){
            n_reps=construct(E, reps, ng, nc);
            emit(cn); emit(" REVISE P0 CONSTRUCT graphs="); e64(get32(ng,0));
            emit(" classes="); e64(get32(nc,0)); emit("\n");
          } else {
            let onr:[]u8=z_alloc(4);
            let k:i32=revise(W, E, reps, onr);
            n_reps=get32(onr,0);
            if(k==0){
              emit(cn); emit(" REVISE P"); e64(ph); emit(" KEEP\n");
            } else if(k>0){
              emit(cn); emit(" REVISE P"); e64(ph); emit(" REVISE k="); e64(k);
              emit(" classes="); e64(n_reps); emit("\n");
            } else {
              emit(cn); emit(" REVISE P"); e64(ph); emit(" DECLARE-REVISION-FAILED\n");
            }
          }
        } else if(mi==1){
          n_reps=construct(E, reps, ng, nc);
          emit(cn); emit(" REBUILD P"); e64(ph); emit(" CONSTRUCT graphs="); e64(get32(ng,0));
          emit(" classes="); e64(get32(nc,0)); emit("\n");
        } else {
          if(ph==0){
            n_reps=construct(E, reps, ng, nc);
            emit(cn); emit(" FROZEN P0 CONSTRUCT graphs="); e64(get32(ng,0));
            emit(" classes="); e64(get32(nc,0)); emit("\n");
          } else {
            g_copy2(W, 0, reps, 0);
            n_reps=1;
            emit(cn); emit(" FROZEN P"); e64(ph); emit(" FROZEN-KEEP\n");
          }
        }
        if(n_reps>0){
          let ow:[]u8=z_alloc(4);
          let rounds:i32=run_rounds(reps, n_reps, TG, cn, mn, ph, ow);
          let wi:i32=get32(ow,0);
          emit(cn); emit(" "); emit(mn); emit(" P"); e64(ph);
          emit(" RESOLVED winner="); emit_graph(reps, wi*32);
          emit(" rounds="); e64(rounds); emit("\n");
          ok=ok+1;
          if(graph_consistent(reps, wi*32, E)==1){
            correct=correct+1;
          } else {
            emit(cn); emit(" "); emit(mn); emit(" P"); e64(ph); emit(" WINNER-INCONSISTENT\n");
          }
          g_copy2(reps, wi*32, W, 0);
          if(ph==0){ g_copy2(W, 0, W0, 0); }
          if(ph==1){ g_copy2(W, 0, W1, 0); }
          rounds_total=rounds_total+rounds;
        }
        ph=ph+1;
      }
      emit("SUMMARY "); emit(cn); emit(" "); emit(mn);
      emit(" ok="); e64(ok); emit("/3");
      emit(" correct="); e64(correct); emit("/3");
      emit(" rounds_total="); e64(rounds_total);
      emit(" W2eqW0="); e64(g_eq_canon2(W, 0, W0, 0));
      if(ci==1){
        emit(" W2eqW1="); e64(g_eq_canon2(W, 0, W1, 0));
        let w2n0:i32=0;
        if(g_eq_canon2(W, 0, W0, 0)==0){ w2n0=1; }
        emit(" W2neqW0="); e64(w2n0);
      }
      emit("\n");
      mi=mi+1;
    }
    ci=ci+1;
  }
  emit("CAUSAL-REVERT-DONE\n");
  return;
}

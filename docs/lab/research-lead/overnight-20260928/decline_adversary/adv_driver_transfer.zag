// adv_driver_transfer.zag -- Novel-domain transfer adversary for decline gate.
// Tests: After declining on domain A (s=701..703), does a structurally
// similar domain B (s=801..803) inherit the decline inappropriately?
// The gate is keyed by (s,r), so B should NOT be affected. Verify.

fn dyn_n(W:[]u8)i32 { return hg(W,20); }

fn dyn_ukey(W:[]u8,ks:i32,kr:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,20)==ks && ng(W,n,24)==kr){c=c+1;}
    n=n+1;
  }
  return c;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("TRANSFER-START\n");
  let i:i32=0; let s:i32=0; let ret:i32=0; let n0:i32=0; let dn:i32=0;
  // Phase 1: Decline on domain A (s=701,702,703, r=99). 10 misses each.
  emit("PHASE1: 30 misses on domain A (701-703)\n");
  i=0;
  while(i<30){
    s=701+(i%3);
    n0=dyn_n(W);
    ret=ev_query(W,s,99,-2,0);
    dn=dyn_n(W)-n0;
    i=i+1;
  }
  emit("Domain A done. uncert(701)=");
  e64(dyn_ukey(W,701,99)); emit(" uncert(702)="); e64(dyn_ukey(W,702,99));
  emit(" uncert(703)="); e64(dyn_ukey(W,703,99)); emit("\n");
  // Phase 2: Query domain B (s=801,802,803, r=99). Should NOT be declined
  // (different keys). Each should run full inquiry (dn=2, ret=-2).
  emit("PHASE2: 9 misses on domain B (801-803), should NOT decline\n");
  i=0;
  while(i<9){
    s=801+(i%3);
    n0=dyn_n(W);
    ret=ev_query(W,s,99,-2,0);
    dn=dyn_n(W)-n0;
    emit("Q s="); e64(s); emit(" ret="); e64(ret); emit(" dn="); e64(dn);
    emit(" uncert="); e64(dyn_ukey(W,s,99)); emit("\n");
    i=i+1;
  }
  emit("TRANSFER-END\n");
  return 0;
}

// adv_driver_intermittent.zag -- Intermittent failure adversary for decline gate.
// Tests: The tally counts TOTAL failures, not consecutive. If failures are
// interleaved with successes, does the gate over-decline?
// Pattern: fail, fail, SUCCEED (via teach), fail, fail, fail...
// The succeed should (in a consecutive tally) reset the count, but the
// total tally keeps counting. Does the gate fire inappropriately?

fn dyn_n(W:[]u8)i32 { return hg(W,20); }
fn dyn_e(W:[]u8)i32 { return hg(W,24); }

fn dyn_ukey(W:[]u8,ks:i32,kr:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,20)==ks && ng(W,n,24)==kr){c=c+1;}
    n=n+1;
  }
  return c;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("INTERMITTENT-START\n");
  let s:i32=601; let r:i32=99;
  let i:i32=0; let ret:i32=0; let n0:i32=0; let dn:i32=0;
  // Step 1: 2 failures (uncert=2)
  emit("STEP1: 2 failures\n");
  i=0;
  while(i<2){
    n0=dyn_n(W);
    ret=ev_query(W,s,r,-2,0);
    dn=dyn_n(W)-n0;
    emit("Q "); e64(i); emit(" ret="); e64(ret); emit(" dn="); e64(dn);
    emit(" uncert="); e64(dyn_ukey(W,s,r)); emit("\n");
    i=i+1;
  }
  // Step 2: Teach and query (success). This does NOT clear UNCERTAINTY nodes.
  // A consecutive tally would reset to 0. The total tally stays at 2.
  emit("STEP2: teach then query (success)\n");
  ret=ev_teach(W,s,r,7777);
  emit("TEACH ret="); e64(ret); emit("\n");
  n0=dyn_n(W);
  ret=ev_query(W,s,r,-2,0);
  dn=dyn_n(W)-n0;
  emit("Q ret="); e64(ret); emit(" dn="); e64(dn);
  emit(" uncert="); e64(dyn_ukey(W,s,r)); emit(" (should be 2 if total, 0 if consecutive)\n");
  // Step 3: Contradict to make (s,r) fail again. Teach a different r to avoid
  // activate hit, then query (s,r) which will miss (no fact for r=99 now?).
  // Actually, we taught (s,99,7777), so (s,99) will hit. We need a new key.
  // Use (s2,r) where s2=602.
  emit("STEP3: 2 more failures on new key (602,99)\n");
  s=602;
  i=0;
  while(i<2){
    n0=dyn_n(W);
    ret=ev_query(W,s,r,-2,0);
    dn=dyn_n(W)-n0;
    emit("Q "); e64(i); emit(" ret="); e64(ret); emit(" dn="); e64(dn);
    emit(" uncert="); e64(dyn_ukey(W,s,r)); emit("\n");
    i=i+1;
  }
  // Step 4: One more failure on (602,99). With N=3, total tally=3, gate fires.
  // But these were the FIRST 3 failures on this key (consecutive). This is correct.
  // The real test: go back to (601,99), contradict the taught fact, then fail.
  emit("STEP4: contradict (601,99) via observe, then fail\n");
  s=601;
  ret=ev_observe(W,s,r,8888);
  emit("OBSERVE ret="); e64(ret); emit("\n");
  // Now (601,99) has conflicting info. Query it.
  n0=dyn_n(W);
  ret=ev_query(W,s,r,-2,0);
  dn=dyn_n(W)-n0;
  emit("Q ret="); e64(ret); emit(" dn="); e64(dn);
  emit(" uncert="); e64(dyn_ukey(W,s,r)); emit("\n");
  emit("INTERMITTENT-END\n");
  return 0;
}

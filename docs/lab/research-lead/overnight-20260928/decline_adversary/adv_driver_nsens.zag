// adv_driver_nsens.zag -- N-sensitivity measurement for decline gate.
// Runs a shortened DYN-1-like battery (30 misses on 3 keys) and measures
// nodes saved vs declines. To be run with N=1,2,3,4,5 for comparison.
// Reports: total declines, total nodes saved vs no-gate baseline.

fn dyn_n(W:[]u8)i32 { return hg(W,20); }
fn dyn_e(W:[]u8)i32 { return hg(W,24); }

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("NSENS-START\n");
  let i:i32=0; let s:i32=0; let ret:i32=0; let n0:i32=0; let dn:i32=0;
  let totdn:i32=0; let declines:i32=0; let fullmiss:i32=0;
  // 30 misses: 3 keys (701,702,703) x 10 misses each, r=99 never taught
  i=0;
  while(i<30){
    s=701+(i%3);
    n0=dyn_n(W);
    ret=ev_query(W,s,99,-2,0);
    dn=dyn_n(W)-n0;
    totdn=totdn+dn;
    if(ret==-3){declines=declines+1;} else {fullmiss=fullmiss+1;}
    i=i+1;
  }
  emit("NSENS-SUMMARY totdn="); e64(totdn);
  emit(" declines="); e64(declines);
  emit(" fullmiss="); e64(fullmiss);
  emit(" final_nodes="); e64(dyn_n(W));
  emit("\nNSENS-END\n");
  return 0;
}

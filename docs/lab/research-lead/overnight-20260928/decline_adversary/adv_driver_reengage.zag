// adv_driver_reengage.zag -- Re-engagement adversary for decline gate.
// Tests: After N declines on (s,r), teach (s,r,v). Does the gate unstick?
// The gate checks uncert_count >= N AFTER activate fails. Teaching creates
// a fact, so activate should hit BEFORE the gate on the next query.
// Measures: queries to re-engage, whether WITHHOLD persists after teaching.

fn dyn_n(W:[]u8)i32 { return hg(W,20); }
fn dyn_e(W:[]u8)i32 { return hg(W,24); }

fn dyn_ukey(W:[]u8,ks:i32,kr:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,20)==ks && ng(W,n,24)==kr){c=c+1;}
    n=n+1;
  }
  return c;
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("REENGAGE-START\n");
  let s:i32=501; let r:i32=99; let v:i32=4242;
  let i:i32=0; let ret:i32=0; let n0:i32=0; let dn:i32=0;
  // Phase 1: 10 consecutive misses on (501,99). Gate should fire after N.
  emit("PHASE1: 10 misses\n");
  i=0;
  while(i<10){
    n0=dyn_n(W);
    ret=ev_query(W,s,r,-2,0);
    dn=dyn_n(W)-n0;
    emit("Q "); e64(i); emit(" ret="); e64(ret); emit(" dn="); e64(dn);
    emit(" uncert="); e64(dyn_ukey(W,s,r)); emit("\n");
    i=i+1;
  }
  // Phase 2: Teach the fact (s,r,v). This should allow activate hit.
  emit("PHASE2: teach (501,99,4242)\n");
  n0=dyn_n(W);
  ret=ev_teach(W,s,r,v);
  dn=dyn_n(W)-n0;
  emit("TEACH ret="); e64(ret); emit(" dn="); e64(dn); emit("\n");
  // Phase 3: Query again. Should hit via activate (bypass gate). Measure.
  emit("PHASE3: 5 queries after teach\n");
  i=0;
  while(i<5){
    n0=dyn_n(W);
    ret=ev_query(W,s,r,-2,0);
    dn=dyn_n(W)-n0;
    emit("Q "); e64(i); emit(" ret="); e64(ret); emit(" dn="); e64(dn);
    emit(" uncert="); e64(dyn_ukey(W,s,r)); emit("\n");
    i=i+1;
  }
  // Verdict: did we re-engage? (ret should be 4242, not -3)
  emit("REENGAGE-END\n");
  return 0;
}

// Diagnostic probe: characterize the spurious U-A3 bridge branches.
fn main()i32 {
  let W:[]u8=z_alloc(65536);
  set32(W, ST_STR(), STR0());
  let rc:i32=handle_proc_learn_unified(W,"abc>cba;de>ed;ff>ff");
  emit("rc="); emit(i32s(rc)); emit("\n");
  if(rc>=1000){
    let bs:i32=rc-1000;
    let ptrue:i32=br_ptrue(W,BBASE(),bs);
    let pfalse:i32=br_pfalse(W,BBASE(),bs);
    emit("THEN slot="); emit(i32s(ptrue)); emit(" ELSE slot="); emit(i32s(pfalse)); emit("\n");
    let o1:[]u8=z_alloc(6); let o2:[]u8=z_alloc(6);
    // THEN branch: input starting with 'a'
    if(proc_apply(W,PBASE(),ptrue,"axyzb",o1)==1){ emit("THEN(axyzb)=["); emit(o1[0..5]); emit("]\n"); }
    // ELSE branch: input not starting with 'a', length 5
    if(proc_apply(W,PBASE(),pfalse,"hello",o2)==1){ emit("ELSE(hello)=["); emit(o2[0..5]); emit("]\n"); }
  }
  return 0;
}

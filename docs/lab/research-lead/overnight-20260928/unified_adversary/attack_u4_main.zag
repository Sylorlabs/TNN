
// U-A4: Query ambiguity. Two stored procedures, one query, no intent signal.
fn main()i32 {
  emit("=== U-A4 query ambiguity ===\n");
  let W:[]u8=z_alloc(65536);
  set32(W, ST_STR(), STR0());

  // Learn reverse (slot 0).
  let r1:i32=route_line("abc>cba;xy>yx");
  let s0:i32=-1;
  if(r1==1){ s0=handle_proc_learn_unified(W,"abc>cba;xy>yx"); }
  emit("reverse slot="); emit(i32s(s0)); emit("\n");

  // Learn broadcast-last (slot 1).
  let r2:i32=route_line("abc>ccc;def>fff");
  let s1:i32=-1;
  if(r2==1){ s1=handle_proc_learn_unified(W,"abc>ccc;def>fff"); }
  emit("broadcast-last slot="); emit(i32s(s1)); emit("\n");

  // Ambiguous query: matches both stored procedures.
  emit("--- query abc ---\n");
  let nq:i32=handle_proc_query_unified(W,"abc");
  emit("outputs reported="); emit(i32s(nq)); emit("\n");
  if(nq>=2){
    emit("U-A4 RESULT: DOWNGRADE (conflicting outputs, no intent ranking)\n");
  } else {
    emit("U-A4 RESULT: single output (no ambiguity exhibited)\n");
  }

  // Bridge-amplified case: conditional rule + direct procedure on one query.
  let Wb:[]u8=z_alloc(65536);
  set32(Wb, ST_STR(), STR0());
  let rb:i32=route_line("xab>xxx;xcd>xxx;abc>ccc;def>fff;abcde>eeeee");
  let rcb:i32=-1;
  if(rb==1){ rcb=handle_proc_learn_unified(Wb,"xab>xxx;xcd>xxx;abc>ccc;def>fff;abcde>eeeee"); }
  let rr:i32=route_line("abc>cba;xy>yx");
  if(rr==1){ handle_proc_learn_unified(Wb,"abc>cba;xy>yx"); }
  emit("--- query xqw (bridge rule + reverse slot) ---\n");
  let nqb:i32=handle_proc_query_unified(Wb,"xqw");
  emit("outputs reported="); emit(i32s(nqb)); emit("\n");
  return 0;
}

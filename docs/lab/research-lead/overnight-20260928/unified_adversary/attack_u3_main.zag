
// U-A3: Bridge trigger misfire. One unextractable pair vetoes direct
// discovery (allok=0), forcing the bridge path over the extractable subset.
fn main()i32 {
  emit("=== U-A3 bridge trigger ===\n");

  // Fresh workspace A: extractable subset alone. Direct should succeed.
  let W2:[]u8=z_alloc(65536);
  set32(W2, ST_STR(), STR0());
  let rsub:i32=route_line("abc>cba;de>ed");
  emit("subset route="); emit(i32s(rsub)); emit("\n");
  let rc2:i32=-1;
  if(rsub==1){ rc2=handle_proc_learn_unified(W2,"abc>cba;de>ed"); }
  emit("direct-on-subset rc2="); emit(i32s(rc2)); emit(" (0..15 = direct slot)\n");
  let outD:[]u8=z_alloc(4);
  let dhit:i32=0;
  if(rc2>=0 && rc2<1000){
    if(proc_apply(W2,PBASE(),rc2,"dxc",outD)==1){ dhit=1; }
  }
  emit("direct program on probe dxc: hit="); emit(i32s(dhit));
  if(dhit==1){ emit(" out=["); emit(outD[0..3]); emit("]"); }
  emit("\n");

  // Workspace B: full item with one unextractable pair ("ff>ff": 'f' twice).
  let W:[]u8=z_alloc(65536);
  set32(W, ST_STR(), STR0());
  let rt:i32=route_line("abc>cba;de>ed;ff>ff");
  emit("full item route="); emit(i32s(rt)); emit("\n");
  let rc:i32=-1;
  if(rt==1){ rc=handle_proc_learn_unified(W,"abc>cba;de>ed;ff>ff"); }
  emit("full item rc="); emit(i32s(rc)); emit(" (>=1000 = bridge fired)\n");

  let outB:[]u8=z_alloc(4);
  let bhit:i32=0;
  if(rc>=1000){
    let bs:i32=rc-1000;
    emit("bridge rule: pos="); emit(i32s(br_cpos(W,BBASE(),bs)));
    emit(" val="); emit(i32s(br_cval(W,BBASE(),bs))); emit("\n");
    if(bridge_apply(W,PBASE(),BBASE(),bs,"dxc",outB)==1){ bhit=1; }
  }
  emit("bridge dispatch on probe dxc: hit="); emit(i32s(bhit));
  if(bhit==1){ emit(" out=["); emit(outB[0..3]); emit("]"); }
  emit("\n");

  if(rc>=1000 && rc2>=0 && rc2<1000 && dhit==1 && bhit==1){
    if(streq(outB[0..3],outD[0..3])==1){
      emit("U-A3 RESULT: DOWNGRADE (spurious bridge, behaviorally equivalent)\n");
    } else {
      emit("U-A3 RESULT: KILL (bridge fired, direct vetoed, behavioral divergence)\n");
    }
  } else {
    emit("U-A3 RESULT: NO MISFIRE OBSERVED\n");
  }
  return 0;
}

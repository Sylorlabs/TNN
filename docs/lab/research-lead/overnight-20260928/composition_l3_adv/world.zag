// world.zag -- RELAY environment (EXPERIMENT SIDE ONLY).
// Hidden labeling rules, episode tables, and menu controls.
// The learner never calls anything in this file. The driver uses the
// hidden rules only to generate observed labels for teaching.
// Tables match composition_l3_adv/PREREG.md section 3 exactly.
// Adversary-designed world family, independent of the FORAGE builder.

// Episode tables: 4 digit-chars per episode, in prereg order.
fn w_tab(ph:i32)[]u8 {
  if(ph==1){return "50996122407383119705764435882166";}
  if(ph==2){return "7250981950376422";}
  if(ph==3){return "8142930573815529";}
  if(ph==4){return "92634311";}
  if(ph==5){return "91027053621583449200831140925425";}
  return "9203517184256534";
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  if(ph==2){return 4;}
  if(ph==3){return 4;}
  if(ph==4){return 2;}
  if(ph==5){return 8;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  if(ph==2){return idx+9;}
  if(ph==3){return idx+21;}
  if(ph==4){return idx+25;}
  if(ph==5){return idx+31;}
  return idx+39;
}
fn w_seq(ph:i32, idx:i32, out:[]u8)void {
  let T:[]u8=w_tab(ph);
  let k:i32=0;
  while(k<4){
    out[k]=((T[idx*4+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Hidden world rules (never visible to the learner).
// rule1: open iff e0-e1>=4 ; rule2: open iff e0-e1>=6 ;
// rule3: open iff e0-e1+e3>=8.
fn w_true(rule:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(rule==1){
    if(e0-e1>=4){return 1;}
    return 0;
  }
  if(rule==2){
    if(e0-e1>=6){return 1;}
    return 0;
  }
  if(e0-e1+e3>=8){return 1;}
  return 0;
}

// Menu aggregations: EXPERIMENT CONTROLS, not learner machinery.
// kind: 0=SUM 1=MAX 2=MIN 3=FIRST 4=LAST.
fn menu_agg(kind:i32, e0:i32, e1:i32, e2:i32, e3:i32)i32 {
  if(kind==0){return e0+e1+e2+e3;}
  if(kind==1){
    let m:i32=e0;
    if(e1>m){m=e1;}
    if(e2>m){m=e2;}
    if(e3>m){m=e3;}
    return m;
  }
  if(kind==2){
    let m:i32=e0;
    if(e1<m){m=e1;}
    if(e2<m){m=e2;}
    if(e3<m){m=e3;}
    return m;
  }
  if(kind==3){return e0;}
  return e3;
}
fn menu_name(kind:i32)[]u8 {
  if(kind==0){return "SUM";}
  if(kind==1){return "MAX";}
  if(kind==2){return "MIN";}
  if(kind==3){return "FIRST";}
  return "LAST";
}

// driver.zag -- RELAY L3 adversarial experiment driver.
// Arms, phases, kill-bar evaluation. The driver teaches X/Y, runs the
// learner's construct/adapt, and evaluates Z. It never invents the
// intermediate: all construction goes through learner.zag, which is the
// byte-identical FORAGE mechanism.
// Prereg: composition_l3_adv/PREREG.md (commit 10389d72e). Pure Zag.

fn d_y_prior(st:[]u8, ob:[]u8, at:i32)i32 {
  y_teach(st,12,1); y_teach(st,15,1); y_teach(st,11,1);
  y_teach(st,8,0); y_teach(st,5,0); y_teach(st,9,0);
  let bs:i32=y_fit(st);
  at=ob_app(ob,at,"Y-PRIOR fit=");
  at=ob_i32(ob,at,bs);
  at=ob_app(ob,at,"/6 t=");
  at=ob_i32(ob,at,get32(st,228));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_phase(st:[]u8, ph:i32, rule:i32, ob:[]u8, at:i32)i32 {
  let n:i32=w_n(ph);
  let sq:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<n){
    w_seq(ph,i,sq);
    let id:i32=w_id(ph,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
    at=ob_app(ob,at,"X-TEACH id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," seq=");
    at=ob_i32(ob,at,(sq[0] as i32));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,(sq[1] as i32));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,(sq[2] as i32));
    at=ob_app(ob,at,",");
    at=ob_i32(ob,at,(sq[3] as i32));
    if(rule>0){
      let lb:i32=w_true(rule,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
      lab_teach(st,id,lb);
      at=ob_app(ob,at," label=");
      at=ob_i32(ob,at,lb);
    }
    at=ob_nl(ob,at);
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, off:i32, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[off] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[off+1] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[off+2] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,off+4));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[off+8+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
// Driver-side probe of a single-instruction candidate (rejected
// alternatives for the K-ADV-3 trace). Not learner machinery.
fn d_probe(ob:[]u8, at:i32, tag:[]u8, op:i32, d:i32, s:i32, st:[]u8, eids:[]u8, labs:[]u8, ne:i32, rg:[]u8, sq:[]u8, vals:[]u8)i32 {
  let pr:[]u8=z_alloc(24);
  pr[0]=op as u8; pr[1]=d as u8; pr[2]=s as u8;
  p_outs(pr,1,st,eids,ne,rg,sq,vals);
  let to:[]u8=z_alloc(4);
  let sc:i32=best_t_of_vals(vals,labs,ne,to);
  at=ob_app(ob,at,"PROBE ");
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,sc);
  at=ob_app(ob,at,"/8 t=");
  at=ob_i32(ob,at,get32(to,0));
  at=ob_nl(ob,at);
  return at;
}
fn d_z_run(st:[]u8, eids:[]u8, ne:i32, rule:i32, rg:[]u8, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let f:i32=x_recall(st,id,sq);
    let tl:i32=-2;
    let sv:i32=-999;
    at=ob_app(ob,at,"Z id=");
    at=ob_i32(ob,at,id);
    if(f==1){
      tl=w_true(rule,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
      let mn:i32=st[232] as i32;
      if(mn>0){
        let mp:[]u8=z_alloc(24);
        let k:i32=0;
        while(k<24){mp[k]=st[240+k];k=k+1;}
        sv=p_exec(mp,mn,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),rg);
      }
      at=ob_app(ob,at," seq=");
      at=ob_i32(ob,at,(sq[0] as i32)); at=ob_app(ob,at,",");
      at=ob_i32(ob,at,(sq[1] as i32)); at=ob_app(ob,at,",");
      at=ob_i32(ob,at,(sq[2] as i32)); at=ob_app(ob,at,",");
      at=ob_i32(ob,at,(sq[3] as i32));
    } else {
      at=ob_app(ob,at," seq=none");
    }
    let ok:i32=0;
    if(dec==tl){ok=1;}
    if(ok==1){c=c+1;}
    at=ob_app(ob,at," s=");
    at=ob_i32(ob,at,sv);
    at=ob_app(ob,at," dec=");
    at=ob_i32(ob,at,dec);
    at=ob_app(ob,at," true=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}
fn d_menu_fit(kind:i32, st:[]u8, eids:[]u8, ne:i32, sq:[]u8, out:[]u8)i32 {
  let bt:i32=0;
  let bc:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=0;
    let i:i32=0;
    while(i<ne){
      let id:i32=eids[i] as i32;
      x_recall(st,id,sq);
      let v:i32=menu_agg(kind,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
      let p:i32=0;
      if(v>=t){p=1;}
      if(p==lab_get(st,id)){c=c+1;}
      i=i+1;
    }
    if(c>bc){bc=c;bt=t;}
    t=t+1;
  }
  set32(out,0,bt);
  return bc;
}
fn d_menu_eval(kind:i32, st:[]u8, eids:[]u8, ne:i32, t:i32, rule:i32, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    x_recall(st,id,sq);
    let v:i32=menu_agg(kind,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
    let tl:i32=w_true(rule,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32));
    let p:i32=0;
    if(v>=t){p=1;}
    let ok:i32=0;
    if(p==tl){ok=1;c=c+1;}
    at=ob_app(ob,at,"MENU-EP ");
    at=ob_app(ob,at,menu_name(kind));
    at=ob_app(ob,at," id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," v=");
    at=ob_i32(ob,at,v);
    at=ob_app(ob,at," pred=");
    at=ob_i32(ob,at,p);
    at=ob_app(ob,at," true=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  let rg:[]u8=z_alloc(16);
  let sq:[]u8=z_alloc(4);
  let vals:[]u8=z_alloc(64);
  let atp:[]u8=z_alloc(4);
  at=ob_app(ob,at,"L3-RELAY-START\n");

  // ================= ARM-FULL phase 1 =================
  at=ob_app(ob,at,"=== ARM-FULL phase1 ===\n");
  let st1:[]u8=z_alloc(1024);
  at=d_y_prior(st1,ob,at);
  at=d_teach_phase(st1,1,1,ob,at);
  at=d_teach_phase(st1,2,0,ob,at);

  let eids1:[]u8=z_alloc(8);
  let labs1:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<8){
    let id:i32=i+1;
    eids1[i]=id as u8;
    labs1[i]=lab_get(st1,id) as u8;
    i=i+1;
  }
  let eidsT:[]u8=z_alloc(4);
  i=0;
  while(i<4){eidsT[i]=(i+9) as u8;i=i+1;}

  at=ob_app(ob,at,"--- construct M (fresh) ---\n");
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct(st1,eids1,labs1,8,init,0,rg,sq,vals,mbuf,mout,ob,at);
  let mn:i32=get32(mout,0);
  let mt:i32=get32(mout,4);
  let ms:i32=get32(mout,8);
  at=ob_app(ob,at,"M-BUILT n=");
  at=ob_i32(ob,at,mn);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,mt);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,ms);
  at=ob_app(ob,at,"/8\n");
  m_write(st1,mn,1,mt,mbuf);
  set32(st1,228,mt);
  at=d_m_dump(st1,232,"M-STATE",ob,at);

  at=ob_app(ob,at,"--- rejected single-instruction alternatives ---\n");
  at=d_probe(ob,at,"FORAGE-ADD-R0-R2",1,0,2,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"SUB-R0-R3",2,0,3,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"MAX-R0-R3",3,0,3,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"MIN-R0-R2",4,0,2,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"ADD-R0-R3",1,0,3,st1,eids1,labs1,8,rg,sq,vals);
  at=d_probe(ob,at,"CPY-R0-R1",0,0,1,st1,eids1,labs1,8,rg,sq,vals);

  set32(atp,0,at);
  let zfull:i32=d_z_run(st1,eidsT,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-FULL ");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at,"/4\n");

  // ================= ARM-X-ONLY =================
  at=ob_app(ob,at,"=== ARM-X-ONLY ===\n");
  let st2:[]u8=z_alloc(1024);
  at=d_teach_phase(st2,1,0,ob,at);
  at=d_teach_phase(st2,2,0,ob,at);
  set32(atp,0,at);
  let zx:i32=d_z_run(st2,eidsT,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-XONLY ");
  at=ob_i32(ob,at,zx);
  at=ob_app(ob,at,"/4\n");

  // ================= ARM-Y-ONLY =================
  at=ob_app(ob,at,"=== ARM-Y-ONLY ===\n");
  let st3:[]u8=z_alloc(1024);
  at=d_y_prior(st3,ob,at);
  set32(atp,0,at);
  let zy:i32=d_z_run(st3,eidsT,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-YONLY ");
  at=ob_i32(ob,at,zy);
  at=ob_app(ob,at,"/4\n");

  // ================= ARM-MENU (controls) =================
  at=ob_app(ob,at,"=== ARM-MENU ===\n");
  let mk:i32=0;
  let mworst:i32=4;
  while(mk<5){
    let to:[]u8=z_alloc(4);
    let fsc:i32=d_menu_fit(mk,st1,eids1,8,sq,to);
    let ftt:i32=get32(to,0);
    at=ob_app(ob,at,"MENU-FIT ");
    at=ob_app(ob,at,menu_name(mk));
    at=ob_app(ob,at," train=");
    at=ob_i32(ob,at,fsc);
    at=ob_app(ob,at,"/8 t=");
    at=ob_i32(ob,at,ftt);
    at=ob_nl(ob,at);
    set32(atp,0,at);
    let msc:i32=d_menu_eval(mk,st1,eidsT,4,ftt,1,sq,ob,atp);
    at=get32(atp,0);
    at=ob_app(ob,at,"MENU-TEST ");
    at=ob_app(ob,at,menu_name(mk));
    at=ob_app(ob,at," ");
    at=ob_i32(ob,at,msc);
    at=ob_app(ob,at,"/4\n");
    if(msc<mworst){mworst=msc;}
    mk=mk+1;
  }

  // ================= ARM-NO-M =================
  at=ob_app(ob,at,"=== ARM-NO-M ===\n");
  let st4:[]u8=z_alloc(1024);
  let q:i32=0;
  while(q<1024){st4[q]=st1[q];q=q+1;}
  m_wipe(st4);
  set32(atp,0,at);
  let znm:i32=d_z_run(st4,eidsT,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-NOM ");
  at=ob_i32(ob,at,znm);
  at=ob_app(ob,at,"/4\n");

  // ================= ARM-FORAGE-PROBE (anti-transfer) =================
  at=ob_app(ob,at,"=== ARM-FORAGE-PROBE ===\n");
  let fpr:[]u8=z_alloc(24);
  fpr[0]=1; fpr[1]=0; fpr[2]=2;
  p_outs(fpr,1,st1,eids1,8,rg,sq,vals);
  let fto:[]u8=z_alloc(4);
  let fsc2:i32=best_t_of_vals(vals,labs1,8,fto);
  at=ob_app(ob,at,"FORAGE-PROBE score=");
  at=ob_i32(ob,at,fsc2);
  at=ob_app(ob,at,"/8 t=");
  at=ob_i32(ob,at,get32(fto,0));
  at=ob_nl(ob,at);

  // ================= PHASE 2: reuse =================
  at=ob_app(ob,at,"=== PHASE2 reuse ===\n");
  at=d_teach_phase(st1,3,2,ob,at);
  at=d_teach_phase(st1,4,0,ob,at);
  let snap:[]u8=z_alloc(32);
  q=0;
  while(q<32){snap[q]=st1[232+q];q=q+1;}
  let eids2:[]u8=z_alloc(4);
  let labs2:[]u8=z_alloc(4);
  i=0;
  while(i<4){
    let id:i32=i+21;
    eids2[i]=id as u8;
    labs2[i]=lab_get(st1,id) as u8;
    i=i+1;
  }
  let res:[]u8=z_alloc(8);
  at=adapt(st1,eids2,labs2,4,rg,sq,vals,ob,at,res);
  let acode:i32=get32(res,0);
  at=ob_app(ob,at,"ADAPT code=");
  at=ob_i32(ob,at,acode);
  at=ob_app(ob,at," (0=keep 1=threshold 2=revision 3=fail)\n");
  at=d_m_dump(st1,232,"M-STATE",ob,at);
  let peq:i32=m_bytes_equal(st1,snap);
  at=ob_app(ob,at,"M-PERSIST ");
  at=ob_i32(ob,at,peq);
  at=ob_nl(ob,at);
  let eidsH:[]u8=z_alloc(2);
  eidsH[0]=25; eidsH[1]=26;
  set32(atp,0,at);
  let zh:i32=d_z_run(st1,eidsH,2,2,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-HELD ");
  at=ob_i32(ob,at,zh);
  at=ob_app(ob,at,"/2\n");

  // ================= PHASE 3: revision =================
  at=ob_app(ob,at,"=== PHASE3 revision ===\n");
  at=d_teach_phase(st1,5,3,ob,at);
  at=d_teach_phase(st1,6,0,ob,at);
  let eids3:[]u8=z_alloc(8);
  let labs3:[]u8=z_alloc(8);
  i=0;
  while(i<8){
    let id:i32=i+31;
    eids3[i]=id as u8;
    labs3[i]=lab_get(st1,id) as u8;
    i=i+1;
  }
  at=adapt(st1,eids3,labs3,8,rg,sq,vals,ob,at,res);
  let acode3:i32=get32(res,0);
  at=ob_app(ob,at,"ADAPT code=");
  at=ob_i32(ob,at,acode3);
  at=ob_app(ob,at," (0=keep 1=threshold 2=revision 3=fail)\n");
  at=d_m_dump(st1,232,"M-STATE",ob,at);
  at=d_m_dump(st1,264,"MPREV-STATE",ob,at);
  let eidsT3:[]u8=z_alloc(4);
  i=0;
  while(i<4){eidsT3[i]=(i+39) as u8;i=i+1;}
  set32(atp,0,at);
  let z3:i32=d_z_run(st1,eidsT3,4,3,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-REV ");
  at=ob_i32(ob,at,z3);
  at=ob_app(ob,at,"/4\n");

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KILL BARS ===\n");
  let k1:i32=0;
  if(zx==0){if(zy==0){if(zfull==4){k1=1;}}}
  at=ob_app(ob,at,"K-ADV-1 insufficiency xonly=");
  at=ob_i32(ob,at,zx);
  at=ob_app(ob,at," yonly=");
  at=ob_i32(ob,at,zy);
  at=ob_app(ob,at," full=");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k1);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-ADV-2 grep-audit see-shell (frozen patterns, learner.zag)\n");
  let k3:i32=0;
  if(mn>0){if(ms==8){k3=1;}}
  at=ob_app(ob,at,"K-ADV-3 creation n=");
  at=ob_i32(ob,at,mn);
  at=ob_app(ob,at," trainscore=");
  at=ob_i32(ob,at,ms);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k3);
  at=ob_nl(ob,at);
  let k4:i32=0;
  if(zfull==4){if(znm==0){k4=1;}}
  at=ob_app(ob,at,"K-ADV-4 necessity full=");
  at=ob_i32(ob,at,zfull);
  at=ob_app(ob,at," nom=");
  at=ob_i32(ob,at,znm);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-ADV-5 persistence M-PERSIST=");
  at=ob_i32(ob,at,peq);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,peq);
  at=ob_nl(ob,at);
  let k6:i32=0;
  if(acode==1){if(zh==2){k6=1;}}
  at=ob_app(ob,at,"K-ADV-6 reuse adapt=");
  at=ob_i32(ob,at,acode);
  at=ob_app(ob,at," held=");
  at=ob_i32(ob,at,zh);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-ADV-7 determinism see-shell (3x sha256)\n");
  let kf:i32=0;
  if(fsc2<8){kf=1;}
  at=ob_app(ob,at,"F-FORAGE-REUSE forageprobe=");
  at=ob_i32(ob,at,fsc2);
  at=ob_app(ob,at,"/8 SILENT=");
  at=ob_i32(ob,at,kf);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"REVISION adapt3=");
  at=ob_i32(ob,at,acode3);
  at=ob_app(ob,at," zrev=");
  at=ob_i32(ob,at,z3);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,peq);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);

  at=ob_app(ob,at,"L3-RELAY-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

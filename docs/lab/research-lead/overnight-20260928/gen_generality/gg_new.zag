// gg_new.zag -- GEN-GENERALITY driver: world setups + main only.
// No mechanism code. Structures are m0..m3; relations are bare integers;
// entities are bare integers. No domain vocabulary anywhere in this file.
// Setups frozen in PREREG.md Section 4.
fn setup_g1(A:[]u8)void {
  fact_add(A,201,91,211); fact_add(A,201,91,212); fact_add(A,201,91,213);
  fact_add(A,201,92,221); fact_add(A,201,92,222);
  fact_add(A,231,93,232);
  map_new(A,0,1,91,0); map_new(A,1,1,92,0); map_new(A,2,4,0,0); map_new(A,3,3,0,0);
  teach(A,0,201,3); teach(A,1,201,2); teach2(A,2,3,2,5); teach(A,3,231,231);
  return;
}
fn setup_g2(A:[]u8)void {
  fact_add(A,203,93,211);
  fact_add(A,211,91,212); fact_add(A,211,91,213); fact_add(A,211,91,214);
  fact_add(A,211,92,221); fact_add(A,211,92,222);
  map_new(A,0,1,91,0); map_new(A,1,1,92,0); map_new(A,2,4,0,0); map_new(A,3,0,93,0);
  teach(A,3,203,211); teach(A,0,211,3); teach(A,1,211,2); teach2(A,2,3,2,5);
  return;
}
fn setup_g3(A:[]u8)void {
  fact_add(A,204,91,212);
  fact_add(A,212,92,213);
  fact_add(A,213,93,221); fact_add(A,213,93,222);
  fact_add(A,231,94,232);
  map_new(A,0,0,91,0); map_new(A,1,0,92,0); map_new(A,2,1,93,0); map_new(A,3,3,0,0);
  teach(A,0,204,212); teach(A,1,212,213); teach(A,2,213,2); teach(A,3,231,231);
  return;
}
fn setup_g4(A:[]u8)void {
  fact_add(A,205,91,211); fact_add(A,205,91,212);
  fact_add(A,205,92,213);
  fact_add(A,231,94,232);
  map_new(A,0,1,91,0); map_new(A,1,4,0,0); map_new(A,2,0,92,0); map_new(A,3,3,0,0);
  teach(A,0,205,2); teach(A,2,205,213); teach2(A,1,205,2,207); teach(A,3,231,231);
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new();
  setup_g1(A1);
  c=gen_solve(A1,B,c,201,1,2,5,4);
  c=gen_report(A1,B,c,"GEN","Q1");
  let A2:[]u8=world_new();
  setup_g2(A2);
  c=gen_solve(A2,B,c,203,1,2,5,4);
  c=gen_report(A2,B,c,"GEN","Q2");
  let A3:[]u8=world_new();
  setup_g3(A3);
  c=gen_solve(A3,B,c,204,1,2,2,4);
  c=gen_report(A3,B,c,"GEN","Q3");
  let A4a:[]u8=world_new();
  setup_g4(A4a);
  c=gen_solve(A4a,B,c,205,1,2,207,4);
  c=gen_report(A4a,B,c,"GEN","Q4a");
  let A4b:[]u8=world_new();
  setup_g4(A4b);
  c=gen_solve(A4b,B,c,205,1,2,999,4);
  c=gen_report(A4b,B,c,"GEN","Q4b");
  o_flush(B,c);
  return 0;
}

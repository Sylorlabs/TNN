// xdagfan4_driver.zag -- XP-DAGFAN-4 battery driver.
//
// Partial applicability: sub-node DAG sharing with the frozen
// xhier_compose operator. Phase L1 replicates XDAGFAN-1
// (Z1=(t,MAP_Y)). Phase W mirrors L1 on fresh rel 83
// (ZW=(tW,MAP_V)). Phase P queries (101,116,4), licensed only
// by the pair (t, ZW): the predicted composite Z2p=(t,ZW)
// reuses the numerically identical relseq sub-node t of Z1
// with a different count partner. H3 ablates t.
//
// Pure Zag. Frozen operators reused verbatim, never redefined.
// All identifiers opaque. No domain labels.

// ---- xd4 helpers (shapes from XDAGFAN-1 xd_ helpers) ----

// 1 if MAP zm has a LINK14 edge to target.
fn xd4_has_link14(W:[]u8,zm:i32,target:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==zm && eg(W,e,4)==14 && eg(W,e,8)==target){return 1;}
    e=e+1;
  }
  return 0;
}

// Outgoing LINK14 count of zm.
fn xd4_count_link14(W:[]u8,zm:i32)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==zm && eg(W,e,4)==14){n=n+1;}
    e=e+1;
  }
  return n;
}

// Incoming LINK14 count of target (from any source node).
fn xd4_count_in14(W:[]u8,target:i32)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,4)==14 && eg(W,e,8)==target){n=n+1;}
    e=e+1;
  }
  return n;
}

// First live tag-20 MAP with field4==r, or -1.
fn xd4_find_map_r(W:[]u8,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}

// First live tag-20 MAP with field4==r and n outgoing LINK14, or -1.
fn xd4_find_map_r_n14(W:[]u8,r:i32,n:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){
      if(xd4_count_link14(W,m)==n){return m;}
    }
    m=m+1;
  }
  return -1;
}

// Ordered LINK14 targets of c into buf (edge-id order). Count, cap 16.
fn xd4_link14_targets(W:[]u8,c:i32,buf:[]u8)i32 {
  let n:i32=0; let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==c && eg(W,e,4)==14){
      if(n<16){set32(buf,n*4,eg(W,e,8)); n=n+1;}
    }
    e=e+1;
  }
  return n;
}

// Live MAP_Z count.
fn xd4_count_mapz(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(xhier_is_mapz(W,m)==1){n=n+1;}
    m=m+1;
  }
  return n;
}

// MAP_Z count with LINK14 to target.
fn xd4_count_mapz_link14_to(W:[]u8,target:i32)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(xhier_is_mapz(W,m)==1 && xd4_has_link14(W,m,target)==1){n=n+1;}
    m=m+1;
  }
  return n;
}

// 1 if MAP m's relseq is exactly [a,b].
fn xd4_relseq_is2(W:[]u8,m:i32,a:i32,b:i32)i32 {
  let seq:[]u8=z_alloc(28);
  let l:i32=cc_relseq(W,m,seq,7);
  if(l!=2){return 0;}
  if(get32(seq,0)!=a){return 0;}
  if(get32(seq,4)!=b){return 0;}
  return 1;
}

// Kill a MAP (ablation).
fn xd4_kill_map(W:[]u8,m:i32)void {
  if(m>=2){ns(W,m,0,-1); ns(W,m,36,0);}
  return;
}

// Kill the cached answer fact (s,r,ans) taught by promote_graph's
// ev_teach_in. Returns the killed node id, or -1 if absent.
fn xd4_kill_fact(W:[]u8,s:i32,r:i32,ans:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==ans){
      ns(W,n,0,-1); ns(W,n,36,0);
      return n;
    }
    n=n+1;
  }
  return -1;
}

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn xd4_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

// ---- phases ----

// Shared training: X, Y, distractors (XDAGFAN-1 xd_train shape, verbatim).
fn xd4_train(W:[]u8)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let ax:i32=ev_query_xs5(W,11,91,14,0);
  emit("TRAIN-X "); e64(ax); emit("\n");
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let ay:i32=ev_query_xs5(W,50,92,3,0);
  emit("TRAIN-Y "); e64(ay); emit("\n");
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}

// Level-1 Z facts (XDAGFAN-1 xd_level1 shape, verbatim). Returns q1.
fn xd4_level1(W:[]u8)i32 {
  ev_teach(W,101,81,102); ev_teach(W,102,81,103); ev_teach(W,103,81,104);
  ev_teach(W,103,82,201); ev_teach(W,201,82,202);
  let a:i32=ev_query_xs5(W,101,93,2,0);
  emit("L1 ans="); e64(a); emit("\n");
  return a;
}

// Phase W: second nav structure on fresh rel 83, shared singleton
// count MAP. Rebind training forms tW=[83,83] (mirrors X2a), then
// the count query forms ZW=(tW,MAP_Y). Returns qW; stashes the
// rebind training answer in tw_ans[0].
fn xd4_phaseW(W:[]u8,tw_ans:[]u8)i32 {
  ev_teach(W,110,83,111); ev_teach(W,111,83,112);
  let at:i32=ev_query_xs5(W,110,114,112,0);
  emit("W-train ans="); e64(at); emit("\n");
  set32(tw_ans,0,at);
  ev_teach(W,112,82,213); ev_teach(W,213,82,214);
  ev_teach(W,214,82,215); ev_teach(W,215,82,216);
  let a:i32=ev_query_xs5(W,110,115,4,0);
  emit("W ans="); e64(a); emit("\n");
  return a;
}

// Phase P: partial query. Teaches the 4-link count site over rel 82
// reachable from 103 via [83,83], then queries (101,116,4).
// Returns qP.
fn xd4_phaseP(W:[]u8)i32 {
  ev_teach(W,103,83,120); ev_teach(W,120,83,121);
  ev_teach(W,121,82,221); ev_teach(W,221,82,222);
  ev_teach(W,222,82,223); ev_teach(W,223,82,224);
  let a:i32=ev_query_xhier(W,101,116,4,0);
  emit("P ans="); e64(a); emit("\n");
  return a;
}

// ---- hypotheses ----

// H-preP: exactly 2 live MAP_Z before phase P (K2 gate).
fn xd4_h_preP(W:[]u8,t:[]u8)void {
  if(xd4_ck(t,xd4_count_mapz(W)==2)==1){
    emit("P2.4 two MAP_Z pre-P PASS\n");
  } else {
    emit("P2.4 two MAP_Z pre-P FAIL\n");
  }
  return;
}

// H1: partial composition structure (K1-K5, A1 revised).
fn xd4_h1(W:[]u8,t:[]u8,q1:i32,qW:i32,qP:i32,tw_ans:i32)void {
  if(xd4_ck(t,q1==2)==1){emit("P1.0 q1==2 PASS\n");} else {emit("P1.0 q1==2 FAIL\n");}
  let z1:i32=xd4_find_map_r_n14(W,93,2);
  if(xd4_ck(t,z1>=0 && xhier_is_mapz(W,z1)==1)==1){emit("P1.1 Z1 MAP_Z PASS\n");} else {emit("P1.1 Z1 MAP_Z FAIL\n");}
  let tg1:[]u8=z_alloc(64);
  let n1:i32=0;
  if(z1>=0){n1=xd4_link14_targets(W,z1,tg1);}
  let tt:i32=-1; let my:i32=-1;
  if(n1==2){tt=get32(tg1,0); my=get32(tg1,4);}
  if(xd4_ck(t,n1==2 && tt>=0 && xd4_relseq_is2(W,tt,81,81)==1)==1){emit("P1.2 Z1->[t,MAP_Y] t=[81,81] PASS\n");} else {emit("P1.2 Z1->[t,MAP_Y] t=[81,81] FAIL\n");}
  let tw:i32=xd4_find_map_r(W,114);
  if(xd4_ck(t,tw_ans==112 && tw>=0 && xd4_relseq_is2(W,tw,83,83)==1)==1){emit("P2.0 rebind tW=[83,83] PASS\n");} else {emit("P2.0 rebind tW=[83,83] FAIL\n");}
  if(xd4_ck(t,qW==4)==1){emit("P2.1 qW==4 PASS\n");} else {emit("P2.1 qW==4 FAIL\n");}
  let zw:i32=xd4_find_map_r_n14(W,115,2);
  if(xd4_ck(t,zw>=0 && xhier_is_mapz(W,zw)==1)==1){emit("P2.2 ZW MAP_Z PASS\n");} else {emit("P2.2 ZW MAP_Z FAIL\n");}
  let tgw:[]u8=z_alloc(64);
  let nw:i32=0;
  if(zw>=0){nw=xd4_link14_targets(W,zw,tgw);}
  let tw2:i32=-1; let zwagg:i32=-1;
  if(nw==2){tw2=get32(tgw,0); zwagg=get32(tgw,4);}
  if(xd4_ck(t,nw==2 && tw2==tw && zwagg==my)==1){emit("P2.3 ZW->[tW,MAP_Y] shared count PASS\n");} else {emit("P2.3 ZW->[tW,MAP_Y] shared count FAIL\n");}
  if(xd4_ck(t,qP==4)==1){emit("P3.0 qP==4 PASS\n");} else {emit("P3.0 qP==4 FAIL\n");}
  let z2p:i32=xd4_find_map_r_n14(W,116,2);
  let tgp:[]u8=z_alloc(64);
  let np:i32=0;
  if(z2p>=0){np=xd4_link14_targets(W,z2p,tgp);}
  let okp:i32=0;
  if(z2p>=0 && xhier_is_mapz(W,z2p)==1 && np==2 && tt>=0 && zw>=0){
    if(get32(tgp,0)==tt && get32(tgp,4)==zw){okp=1;}
  }
  if(xd4_ck(t,okp==1)==1){emit("P3.1 Z2p->[t,ZW] identical ids PASS\n");} else {emit("P3.1 Z2p->[t,ZW] identical ids FAIL\n");}
  if(xd4_ck(t,tt>=0 && xd4_count_mapz_link14_to(W,tt)==2)==1){emit("P4.0 t two composite consumers PASS\n");} else {emit("P4.0 t two composite consumers FAIL\n");}
  if(xd4_ck(t,z1>=0 && ng(W,z1,36)==1 && xd4_count_link14(W,z1)==2)==1){emit("P4.1 Z1 intact PASS\n");} else {emit("P4.1 Z1 intact FAIL\n");}
  if(xd4_ck(t,z2p>=0 && my>=0 && xd4_has_link14(W,z2p,my)==0)==1){emit("P5.0 Z2p no direct MAP_Y PASS\n");} else {emit("P5.0 Z2p no direct MAP_Y FAIL\n");}
  if(xd4_ck(t,my>=0 && xd4_count_mapz_link14_to(W,my)==2)==1){emit("P5.1 MAP_Y two consumers PASS\n");} else {emit("P5.1 MAP_Y two consumers FAIL\n");}
  return;
}

// H2: no interference (K6).
fn xd4_h2(W:[]u8,t:[]u8)void {
  let r1:i32=ev_query_xhier(W,101,93,2,0);
  if(xd4_ck(t,r1==2)==1){emit("P6.0 requery (101,93,2)==2 PASS\n");} else {emit("P6.0 requery (101,93,2)==2 FAIL\n");}
  let rW:i32=ev_query_xs5(W,110,115,4,0);
  if(xd4_ck(t,rW==4)==1){emit("P6.1 requery (110,115,4)==4 PASS\n");} else {emit("P6.1 requery (110,115,4)==4 FAIL\n");}
  let rP:i32=ev_query_xhier(W,101,116,4,0);
  if(xd4_ck(t,rP==4)==1){emit("P6.2 requery (101,116,4)==4 PASS\n");} else {emit("P6.2 requery (101,116,4)==4 FAIL\n");}
  let z1:i32=xd4_find_map_r_n14(W,93,2);
  let zw:i32=xd4_find_map_r_n14(W,115,2);
  let z2p:i32=xd4_find_map_r_n14(W,116,2);
  let ok:i32=0;
  if(z1>=0 && zw>=0 && z2p>=0){
    if(ng(W,z1,36)==1 && ng(W,zw,36)==1 && ng(W,z2p,36)==1){
      if(xd4_count_link14(W,z1)==2 && xd4_count_link14(W,zw)==2 && xd4_count_link14(W,z2p)==2){ok=1;}
    }
  }
  if(xd4_ck(t,ok==1)==1){emit("P6.3 Z1/ZW/Z2p intact PASS\n");} else {emit("P6.3 Z1/ZW/Z2p intact FAIL\n");}
  return;
}

// H3: ablation of the shared sub-node t (K7).
fn xd4_h3(W:[]u8,t:[]u8)void {
  let z1:i32=xd4_find_map_r_n14(W,93,2);
  let tg1:[]u8=z_alloc(64);
  let n1:i32=0;
  if(z1>=0){n1=xd4_link14_targets(W,z1,tg1);}
  let tt:i32=-1;
  if(n1==2){tt=get32(tg1,0);}
  if(tt>=0){xd4_kill_map(W,tt);}
  let k1:i32=xd4_kill_fact(W,101,93,2);
  let k2:i32=xd4_kill_fact(W,110,115,4);
  let k3:i32=xd4_kill_fact(W,101,116,4);
  emit("ABLATE t="); e64(tt); emit(" facts="); e64(k1); emit(","); e64(k2); emit(","); e64(k3); emit("\n");
  let mz0:i32=xd4_count_mapz(W);
  let b1:i32=ev_query_xhier(W,101,93,2,0);
  if(xd4_ck(t,b1==-2)==1){emit("P7.0 post-kill (101,93,2)==-2 PASS\n");} else {emit("P7.0 post-kill (101,93,2)==-2 FAIL\n");}
  let bP:i32=ev_query_xhier(W,101,116,4,0);
  if(xd4_ck(t,bP==-2)==1){emit("P7.1 post-kill (101,116,4)==-2 PASS\n");} else {emit("P7.1 post-kill (101,116,4)==-2 FAIL\n");}
  let mz1:i32=xd4_count_mapz(W);
  if(xd4_ck(t,mz1==mz0)==1){emit("P7.2 no promotion on -2 queries PASS\n");} else {emit("P7.2 no promotion on -2 queries FAIL\n");}
  let bW:i32=ev_query_xs5(W,110,115,4,0);
  if(xd4_ck(t,bW==4)==1){emit("P7.3 post-kill (110,115,4)==4 PASS\n");} else {emit("P7.3 post-kill (110,115,4)==4 FAIL\n");}
  return;
}

fn main()i32 {
  emit("XDAGFAN4-START\n");
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);
  xd4_train(W);
  let q1:i32=xd4_level1(W);
  let tw_ans:[]u8=z_alloc(8);
  set32(tw_ans,0,-99);
  let qW:i32=xd4_phaseW(W,tw_ans);
  xd4_h_preP(W,t);
  let qP:i32=xd4_phaseP(W);
  xd4_h1(W,t,q1,qW,qP,get32(tw_ans,0));
  xd4_h2(W,t);
  xd4_h3(W,t);
  emit("XDAGFAN4-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("XDAGFAN4-END\n");
  return 0;
}

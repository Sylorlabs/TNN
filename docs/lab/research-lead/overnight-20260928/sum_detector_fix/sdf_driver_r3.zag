// xf_driver.zag -- XHIER-COUNTMAP-FIX battery driver (v2).
//
// Tests the fix for the COUNTMAP-ADDRESSABILITY Section 5(a)
// latent issue: xhier_exec resolved each MAP_Z's own type-14
// count MAP address, used it only as an existence gate, then
// executed the global singleton anyway. The patched block reads
// the aggregation relation from the composite's own count MAP
// (xhier_mapz_rel) and fails loudly (-2 + trace) when the
// carried address or its relation is unusable. The singleton
// lookup (xs5_find_countmap / xs5_agg_rel) is untouched;
// COUNTMAP-2 stays on hold.
//
// World plan (one workspace):
//   Phase A: verbatim XP-COUNTMAP-1 phase A (81 nav MAP, MAP_Y
//     82 count MAP, distractors).
//   Phase B: verbatim XP-COUNTMAP-1 phase B (MAP_V2 85 count
//     MAP via trial).
//   Phase B2: same proven trial shape, fresh rel 87 (MAP_V3).
//   Phase R: regression pre-tombstone: compose MAP_Z1 while the
//     singleton is MAP_Y; xhier_exec must be 2 on both binaries.
//   Phase C: surgical MAP_Z2 via frozen ops (promote_graph +
//     link_edge, the exact MAP_Z shape): LINK14 to the nav MAP
//     and to MAP_V3. Teaches 87-count (4 links) and 85-count
//     (3 links) at 14.
//   Tombstone MAP_Y (frozen ns 0/36 pattern), no restore:
//     singleton becomes MAP_V2 (rel 85). Divergence: MAP_Z2's
//     own live count MAP is MAP_V3 (rel 87), singleton names 85.
//   K1: xhier_exec(mz2,11): fixed -> 4, control -> 3.
//   K3a: tombstone MAP_V3's licensing facts -> loud NOREL, -2.
//   K3b: tombstone MAP_V3 -> loud NOAGG, -2.
//
// Slot-recycling note (v1 lesson): alloc_node reuses the first
// live-0 slot, so a tombstoned node cannot be restored; the v2
// plan never resurrects one. No node allocation happens after
// the MAP_Y tombstone (only ns writes, reads, heap scratch),
// so recycling is inert from there on.
//
// The driver never calls ev_query_xhier, so every xhier_exec
// under test is a direct surgical call. Pure Zag. Frozen
// operators reused verbatim, never redefined. All identifiers
// opaque. No domain labels.

// ---- xf helpers ----

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn xf_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

// Exhaustive count-MAP scan using the type-honest count detector:
// live tag-20 MAP whose field-20 graph is a count graph (GUARD
// and INC cells on the detector walk).
// Stashes the first three ids into out[0..2]. Returns count.
fn xf_scan_countmaps(W:[]u8,out:[]u8)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_graph_is_count(W,ng(W,m,20))==1){
        if(n<3){set32(out,n*4,m);}
        n=n+1;
      }
    }
    m=m+1;
  }
  return n;
}

// Highest live count-MAP id, or -1.
fn xf_max_countmap(W:[]u8)i32 {
  let best:i32=-1;
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      if(xs5_graph_is_count(W,ng(W,m,20))==1){best=m;}
    }
    m=m+1;
  }
  return best;
}

// First type-1 provenance edge target's relation for MAP m, or -1.
// Mirrors the xs5_agg_rel read shape.
fn xf_prov_rel(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){return ng(W,f,24);}
    }
    e=e+1;
  }
  return -1;
}

// First live tag-1 type-1 provenance target fact id of m, or -1.
fn xf_prov_fact(W:[]u8,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let f:i32=eg(W,e,8);
      if(f>=0 && ng(W,f,36)==1 && ng(W,f,0)==1){return f;}
    }
    e=e+1;
  }
  return -1;
}

// Tombstone every live tag-1 type-1 provenance target of m.
// Returns the count killed.
fn xf_kill_prov(W:[]u8,m:i32)i32 {
  let k:i32=0;
  let f:i32=xf_prov_fact(W,m);
  while(f>=0){
    ns(W,f,0,0); ns(W,f,36,0);
    k=k+1;
    f=xf_prov_fact(W,m);
  }
  return k;
}

// Stash up to 4 MAP_Z ids (xhier_is_mapz) into out. Returns count.
fn xf_find_mapzs(W:[]u8,out:[]u8)i32 {
  let n:i32=0;
  let z:i32=2;
  while(z<1024){
    if(xhier_is_mapz(W,z)==1){
      if(n<4){set32(out,n*4,z);}
      n=n+1;
    }
    z=z+1;
  }
  return n;
}

// Canonical tombstone (frozen t2_revise_graph pattern). Destructive:
// the slot recycles, so there is no restore.
fn xf_tomb(W:[]u8,n:i32)void {
  ns(W,n,0,0); ns(W,n,36,0);
  return;
}

// ---- phases ----

// Phase A: verbatim XP-COUNTMAP-1 phase A.
fn xf_phaseA(W:[]u8)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let ax:i32=ev_query_xs5(W,11,91,14,0);
  emit("TRAIN-X "); e64(ax); emit("\n");
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let ay:i32=ev_query_xs5(W,50,92,3,0);
  emit("TRAIN-Y "); e64(ay); emit("\n");
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}

// Phase B: verbatim XP-COUNTMAP-1 phase B formation step.
fn xf_phaseB(W:[]u8)void {
  ev_teach(W,110,85,111); ev_teach(W,111,85,112);
  ev_teach(W,112,85,113); ev_teach(W,113,85,114);
  let b:i32=ev_query_xs5(W,110,117,4,0);
  emit("B ans "); e64(b); emit("\n");
  return;
}

// Phase B2: third count MAP over rel 87, same proven trial shape.
fn xf_phaseB2(W:[]u8)void {
  ev_teach(W,120,87,121); ev_teach(W,121,87,122);
  ev_teach(W,122,87,123); ev_teach(W,123,87,124);
  let b2:i32=ev_query_xs5(W,120,118,4,0);
  emit("B2 ans "); e64(b2); emit("\n");
  return;
}

fn main()i32 {
  emit("XF-START\n");
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);

  // Phase A.
  xf_phaseA(W);
  let my:i32=xs5_find_countmap(W);
  emit("A-CMAP "); e64(my); emit(" A-AGGREL "); e64(xs5_agg_rel(W)); emit("\n");
  if(xf_ck(t,my>=0)==1){emit("PC-A.0 count MAP formed PASS\n");} else {emit("PC-A.0 count MAP formed FAIL\n");}
  if(xf_ck(t,xs5_agg_rel(W)==82)==1){emit("PC-A.1 agg rel 82 PASS\n");} else {emit("PC-A.1 agg rel 82 FAIL\n");}

  // Phase B.
  xf_phaseB(W);
  let cout:[]u8=z_alloc(12);
  let ncm:i32=xf_scan_countmaps(W,cout);
  let mv2:i32=-1;
  if(ncm==2){
    if(get32(cout,0)==my){mv2=get32(cout,4);} else {mv2=get32(cout,0);}
  }
  emit("B-NCM "); e64(ncm); emit(" B-CMAP2 "); e64(mv2);
  emit(" B-PROVREL "); e64(xf_prov_rel(W,mv2)); emit("\n");
  if(xf_ck(t,ncm==2)==1){emit("PC-B.0 two count MAPs PASS\n");} else {emit("PC-B.0 two count MAPs FAIL\n");}
  if(xf_ck(t,xf_prov_rel(W,mv2)==85)==1){emit("PC-B.1 second prov rel 85 PASS\n");} else {emit("PC-B.1 second prov rel 85 FAIL\n");}

  // Phase B2.
  xf_phaseB2(W);
  let ncm2:i32=xf_scan_countmaps(W,cout);
  let mv3:i32=xf_max_countmap(W);
  emit("B2-NCM "); e64(ncm2); emit(" B2-CMAP3 "); e64(mv3);
  emit(" B2-PROVREL "); e64(xf_prov_rel(W,mv3)); emit("\n");
  if(xf_ck(t,ncm2==3)==1){emit("PC-B2.0 three count MAPs PASS\n");} else {emit("PC-B2.0 three count MAPs FAIL\n");}
  if(xf_ck(t,xf_prov_rel(W,mv3)==87)==1){emit("PC-B2.1 third prov rel 87 PASS\n");} else {emit("PC-B2.1 third prov rel 87 FAIL\n");}

  // Phase R: regression, pre-tombstone, singleton = MAP_Y (rel 82).
  ev_teach(W,14,82,40); ev_teach(W,40,82,41);
  let cr:i32=xs5_compose(W,11,94,2);
  emit("R compose "); e64(cr); emit("\n");
  let zout:[]u8=z_alloc(16);
  let nz:i32=xf_find_mapzs(W,zout);
  let mz1:i32=-1;
  if(nz==1){mz1=get32(zout,0);}
  let vr:i32=xhier_exec(W,mz1,11);
  emit("R-MAPZ "); e64(mz1); emit(" R-EXEC "); e64(vr); emit("\n");
  if(xf_ck(t,nz==1)==1){emit("PC-R.0 one MAP_Z PASS\n");} else {emit("PC-R.0 one MAP_Z FAIL\n");}
  if(xf_ck(t,vr==2)==1){emit("PC-R.1 exec 2 PASS\n");} else {emit("PC-R.1 exec 2 FAIL\n");}
  emit("XF-PHASER-END\n");

  // Phase C: surgical MAP_Z2 (frozen ops only). 87-count (4 links)
  // and 85-count (3 links) at 14; the 82-count stays the only
  // 82-chain there.
  ev_teach(W,14,87,60); ev_teach(W,60,87,61);
  ev_teach(W,61,87,62); ev_teach(W,62,87,63);
  ev_teach(W,14,85,30); ev_teach(W,30,85,31); ev_teach(W,31,85,32);
  let navx:i32=xhier_mapz_nav(W,mz1);
  let pf:[]u8=z_alloc(8);
  let mz2:i32=promote_graph(W,-1,11,93,4,pf,0);
  link_edge(W,mz2,14,navx,0);
  link_edge(W,mz2,14,mv3,0);
  emit("C promote "); e64(mz2); emit(" navx "); e64(navx); emit("\n");
  let zout2:[]u8=z_alloc(16);
  let nz2:i32=xf_find_mapzs(W,zout2);
  let ac:i32=xhier_mapz_agg(W,mz2);
  emit("C-NMAPZ "); e64(nz2); emit(" C-AGGMAP "); e64(ac);
  emit(" C-PROVREL "); e64(xf_prov_rel(W,ac)); emit("\n");
  if(xf_ck(t,nz2==2)==1){emit("PC-C.0 two MAP_Zs PASS\n");} else {emit("PC-C.0 two MAP_Zs FAIL\n");}
  if(xf_ck(t,xhier_is_mapz(W,mz2)==1)==1){emit("PC-C.1 mz2 is MAP_Z PASS\n");} else {emit("PC-C.1 mz2 is MAP_Z FAIL\n");}
  if(xf_ck(t,ac==mv3)==1){emit("PC-C.2 own count MAP MAP_V3 PASS\n");} else {emit("PC-C.2 own count MAP MAP_V3 FAIL\n");}
  if(xf_ck(t,xf_prov_rel(W,ac)==87)==1){emit("PC-C.3 own prov rel 87 PASS\n");} else {emit("PC-C.3 own prov rel 87 FAIL\n");}

  // Tombstone MAP_Y (no restore): singleton becomes MAP_V2 (85).
  // Divergence: MAP_Z2's own count MAP names rel 87.
  xf_tomb(W,my);
  emit("T-SINGLETON "); e64(xs5_find_countmap(W));
  emit(" T-AGGREL "); e64(xs5_agg_rel(W)); emit("\n");
  if(xf_ck(t,xs5_find_countmap(W)==mv2)==1){emit("PC-T.0 singleton MAP_V2 PASS\n");} else {emit("PC-T.0 singleton MAP_V2 FAIL\n");}
  if(xf_ck(t,xs5_agg_rel(W)==85)==1){emit("PC-T.1 agg rel 85 PASS\n");} else {emit("PC-T.1 agg rel 85 FAIL\n");}
  if(xf_ck(t,xhier_mapz_agg(W,mz2)==mv3)==1){emit("PC-T.2 own count MAP still MAP_V3 PASS\n");} else {emit("PC-T.2 own count MAP still MAP_V3 FAIL\n");}

  // K1: the tombstone test.
  let v1:i32=xhier_exec(W,mz2,11);
  emit("K1-EXEC "); e64(v1); emit("\n");

  // K3a: provenance-unreadable fence.
  let killed:i32=xf_kill_prov(W,mv3);
  let v3a:i32=xhier_exec(W,mz2,11);
  emit("K3A-KILLED "); e64(killed); emit(" K3A-EXEC "); e64(v3a); emit("\n");

  // K3b: tombstoned-address fence.
  xf_tomb(W,mv3);
  let v3b:i32=xhier_exec(W,mz2,11);
  emit("K3B-EXEC "); e64(v3b); emit("\n");

  emit("XF-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("XF-END\n");
  return 0;
}

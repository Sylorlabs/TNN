// sdf_driver_d1.zag -- SUM-DETECTOR-FIX discrimination battery.
//
// Shadowing world: a sum MAP is formed first (lower id) via the
// real trial sum phase (t_p2 shape: tag-8 gate + subset sum), then
// a count MAP is formed via the frozen XP-COUNTMAP-1 count shape.
// The old has-INC predicate matches the sum MAP, so the frozen
// singleton lookup returns it (shadowing); the type-honest count
// detector skips it.
//
// One driver, two binaries: the patched base block (fixed) and
// the frozen base block verbatim (control). Binary-independent
// preconditions emit PASS/FAIL; the binary-dependent probes
// (D1-FIND, D1-AGGOK, D1-AGGREL) emit raw values for per-binary
// shell verification.
//
// Pure Zag. Frozen operators reused verbatim, never redefined.
// All identifiers opaque. No domain labels.

// ---- sdf helpers ----

// Tally helper: t[0]=pass, t[1]=total. 1 if cond, else 0.
fn sdf_ck(t:[]u8,c:i32)i32 {
  set32(t,4,get32(t,4)+1);
  if(c==1){set32(t,0,get32(t,0)+1); return 1;}
  return 0;
}

// First live tag-20 MAP with field8==s, or -1.
fn sdf_find_map_s(W:[]u8,s:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s){return m;}
    m=m+1;
  }
  return -1;
}

// Driver-side reimplementation of the count-detector walk
// (independent cross-check of the block's xs5_graph_is_count;
// frozen ops only, no new block names referenced).
fn sdf_walk_is_count(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0;
  let g:i32=0; let ic:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==102){g=1;}
    if(tag==103){ic=1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  if(g==1 && ic==1){return 1;}
  return 0;
}

// Driver-side reimplementation of the sum-detector walk
// (independent cross-check of the block's xs5_graph_is_sum).
fn sdf_walk_is_sum(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0; let n:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag!=103){return 0;}
    n=n+1;
    cur=seq_nx(W,cur);
    steps=steps+1;
  }
  if(n>=1){return 1;}
  return 0;
}

fn main()i32 {
  emit("SDF-D1-START\n");
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  let t:[]u8=z_alloc(8);
  set32(t,0,0); set32(t,4,0);

  // Sum gate: tag-8 node (the t_p2 shape, verbatim).
  let cn:i32=alloc_node(W);
  ns(W,cn,0,8); write_node(W,cn,1,0,0,0);

  // Sum MAP via the trial sum phase: 10+20+30=60.
  ev_teach(W,110,31,10); ev_teach(W,110,32,20); ev_teach(W,110,33,30);
  let sq:i32=ev_query_xs5(W,110,41,60,0);
  emit("D1-SUMQ "); e64(sq); emit("\n");
  let sum_id:i32=sdf_find_map_s(W,110);

  // Count MAP via the trial count phase (sum phase declines: the
  // only subset total is 51, not 3).
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let cq:i32=ev_query_xs5(W,50,92,3,0);
  emit("D1-COUNTQ "); e64(cq); emit("\n");
  let count_id:i32=sdf_find_map_s(W,50);
  emit("D1-IDS sum="); e64(sum_id); emit(" count="); e64(count_id); emit("\n");

  // PC0: world construction.
  let pc0:i32=0;
  if(sq==60 && cq==3 && sum_id>=0 && count_id>=0){pc0=1;}
  if(pc0==1 && sum_id!=count_id && sum_id<count_id){pc0=2;}
  if(sdf_ck(t,pc0==2)==1){emit("PC0 world built PASS\n");} else {emit("PC0 world built FAIL\n");}

  // PC1: driver-side walk classification (both binaries).
  let sroot:i32=ng(W,sum_id,20);
  let croot:i32=ng(W,count_id,20);
  let w1:i32=sdf_walk_is_count(W,sroot);
  let w2:i32=sdf_walk_is_sum(W,sroot);
  let w3:i32=sdf_walk_is_count(W,croot);
  let w4:i32=sdf_walk_is_sum(W,croot);
  emit("D1-WALK sum_is_count="); e64(w1); emit(" sum_is_sum="); e64(w2);
  emit(" count_is_count="); e64(w3); emit(" count_is_sum="); e64(w4); emit("\n");
  if(sdf_ck(t,w1==0 && w2==1 && w3==1 && w4==0)==1){emit("PC1 walks classify PASS\n");} else {emit("PC1 walks classify FAIL\n");}

  // K1: the singleton lookup.
  let f:i32=xs5_find_countmap(W);
  emit("D1-FIND "); e64(f); emit("\n");

  // K2: the agg capability gate.
  let a1:i32=xhier_agg_ok(W,sum_id);
  let a2:i32=xhier_agg_ok(W,count_id);
  emit("D1-AGGOK sum="); e64(a1); emit(" count="); e64(a2); emit("\n");

  // K3: the provenance relation read.
  let ar:i32=xs5_agg_rel(W);
  emit("D1-AGGREL "); e64(ar); emit("\n");

  emit("SDF-D1-SUMMARY ");
  e64(get32(t,0)); emit("/"); e64(get32(t,4)); emit("\n");
  emit("SDF-D1-END\n");
  return 0;
}

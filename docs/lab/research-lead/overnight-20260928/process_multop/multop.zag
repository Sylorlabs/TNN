// multop.zag -- Multi-op process selection (Constitution Priority F).
//
// Extends the cogops_structures approach: ops are learner-owned
// byte-array bodies executed by a fixed generic 8-instruction
// interpreter. All control is learned from consequence records:
// appl[o][ctx], comp[p][o], tot[o]/retired[o], plus body-parameter
// revision (learner-owned immediates rewritten in body bytes).
//
// Two arms share ALL learner machinery:
//   Arm A (4 ops): 3-op compositional discovery. Worlds F/F2/T2/CHAIN3.
//     Two-phase: Phase 1 (ep<250) trains components on F/F2/T2 only;
//     Phase 2 introduces CHAIN3 (novel task). Target triple in CHAIN3:
//     FOLLOW->SHIFT->COMPLETE (ids [1,3,2]). Neither inner link
//     (1->3, 3->2) can be rewarded except by the triple itself.
//   Arm B (5 ops): body parameter revision. Worlds F/EST.
//     ADJUST answers V + p4 behind a T-edge gate (fails where no T
//     edge, so p4 is only revised where it explains the error);
//     EST worlds need V+4; p4 revised by full signed error.
//
// PREREG.md frozen and committed alone before v1 code; Amendment v2
// re-frozen before v2 code (v1: T1=0/T2=1/T3=0, apparatus fixed).
// Pure Zag. Deterministic: two LCG streams, fixed seeds.
// Output: single preallocated buffer, one _zag_raw_syscall write.

// ============ output helpers (single buffer, no _zag_print) ============
fn e1str(OUT:[]u8,cur:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ OUT[cur+i]=s[i]; i=i+1; }
  return cur+s.len;
}
fn e1i64(OUT:[]u8,cur:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){ neg=1; u=0-v; }
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){ t=t/10; nd=nd+1; }
  let p:i32=cur+neg+nd;
  let k:i32=0;
  let q:i64=u;
  while(k<nd){
    OUT[p-1-k]=(48+(q-(q/10)*10)) as u8;
    q=q/10;
    k=k+1;
  }
  if(neg==1){ OUT[cur]=45; }
  return cur+neg+nd;
}
// ============ cell helpers ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ============ learner-state cell map (i32 cells in S) ============
// 0..79    appl_sum[o*16+ctx]   80..159 appl_n
// 160..184 comp_sum[p*5+o]      185..209 comp_n
// 210..214 tot_sum  215..219 tot_n  220..224 retired  225..229 retire_ep
// 230 rng_env  231 rng_learn  232 log_head  233..712 log(96x5)
// 713..736 nodes(8x3)  737 node_n  738..785 edges(16x3)  786 edge_n
// 787..794 regs R0..R7 (794=CUR)  795..799 bstart  800..804 blen
// 805 status  806 ans  807 true_ans
// 808..812 param_off  813..817 param_val
// 818 disc_ep  819 disc_s13  820 disc_n13  821 disc_s32  822 disc_n32
// 823 disc_clean  824..827 pre_s13 pre_n13 pre_s32 pre_n32
// 828 rev_n  829..836 rev_eps[8]
// 838..840 A late: c3n c3ok c3tri   844..845 B late: en eok
// 850..852 A all: c3n c3ok c3tri    856..857 B all: en eok
// 862 sel_op  863 sel_greedy  864 rev_done_this_ep
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
// ============ deterministic RNG (two LCG streams) ============
fn xorsh(S:[]u8,cell:i32)i32 {
  let s:i32=sg(S,cell);
  let ns:i32=(s*1103515245+12345) & 2147483647;
  ss(S,cell,ns);
  return ns;
}
// ============ graph store (generic machinery) ============
fn g_node(S:[]u8,kind:i32,v0:i32,v1:i32)i32 {
  let id:i32=sg(S,737);
  ss(S,713+id*3,kind); ss(S,713+id*3+1,v0); ss(S,713+id*3+2,v1);
  ss(S,737,id+1);
  return id;
}
fn g_edge(S:[]u8,from:i32,et:i32,to:i32)void {
  let id:i32=sg(S,786);
  ss(S,738+id*3,from); ss(S,738+id*3+1,et); ss(S,738+id*3+2,to);
  ss(S,786,id+1);
  return;
}
fn g_match(S:[]u8,from:i32,et:i32)i32 {
  let e:i32=0; let n:i32=sg(S,786);
  while(e<n){
    if(sg(S,738+e*3)==from && sg(S,738+e*3+1)==et){return sg(S,738+e*3+2);}
    e=e+1;
  }
  return -1;
}
fn g_field(S:[]u8,nd:i32,f:i32)i32 { return sg(S,713+nd*3+f); }
// ============ body assembler ============
// ISA: 1=SET 2=COPY 3=ADD 4=EQ 5=JNZ 6=MATCH 7=READF 8=YIELD.
// asmi: op at p, a/b/c at p+1..p+3, imm32 at p+4. Returns p+8.
fn asmi(BC:[]u8,p:i32,op:i32,a:i32,b:i32,c:i32,imm:i32)i32 {
  BC[p]=op as u8; BC[p+1]=a as u8; BC[p+2]=b as u8; BC[p+3]=c as u8;
  set32(BC,p+4,imm);
  return p+8;
}
// match prologue: SET R0,et; MATCH R7,R0->R1; SET R2,-1; EQ R1,R2->R3;
// JNZ R3,0 (patched later). Returns new p. JNZ instr starts at prop+32.
fn mpro(BC:[]u8,p:i32,et:i32)i32 {
  p=asmi(BC,p,1,0,0,0,et);
  p=asmi(BC,p,6,7,0,1,0);
  p=asmi(BC,p,1,2,0,0,-1);
  p=asmi(BC,p,4,1,2,3,0);
  p=asmi(BC,p,5,3,0,0,0);
  return p;
}
fn mjz(BC:[]u8,prop:i32,fp:i32)void {
  set32(BC,prop+36,fp-(prop+32));
  return;
}
fn build_bodies(S:[]u8,BC:[]u8)void {
  let p:i32=0;
  // op 0 gather: X=match(CUR,V); ANSWERED X or FAIL
  ss(S,795,p);
  let prop:i32=p; p=mpro(BC,p,1);
  p=asmi(BC,p,1,4,0,0,1);
  p=asmi(BC,p,7,1,4,5,0);
  p=asmi(BC,p,1,6,0,0,2);
  p=asmi(BC,p,8,6,5,0,0);
  let fp:i32=p;
  p=asmi(BC,p,1,6,0,0,0);
  p=asmi(BC,p,8,6,6,0,0);
  mjz(BC,prop,fp);
  ss(S,800,p-sg(S,795));
  // op 1 follow: E=match(CUR,D); CUR=E, CONTINUE or FAIL
  ss(S,796,p);
  prop=p; p=mpro(BC,p,2);
  p=asmi(BC,p,2,7,1,0,0);
  p=asmi(BC,p,1,6,0,0,1);
  p=asmi(BC,p,8,6,6,0,0);
  fp=p;
  p=asmi(BC,p,1,6,0,0,0);
  p=asmi(BC,p,8,6,6,0,0);
  mjz(BC,prop,fp);
  ss(S,801,p-sg(S,796));
  // op 2 complete: X=match(CUR,V); K=match(CUR,R); ANSWERED X+K or FAIL
  ss(S,797,p);
  prop=p; p=mpro(BC,p,1);
  p=asmi(BC,p,1,4,0,0,1);
  p=asmi(BC,p,7,1,4,5,0);
  let prop2:i32=p; p=mpro(BC,p,3);
  p=asmi(BC,p,1,4,0,0,1);
  p=asmi(BC,p,7,1,4,0,0);
  p=asmi(BC,p,3,5,0,5,0);
  p=asmi(BC,p,1,6,0,0,2);
  p=asmi(BC,p,8,6,5,0,0);
  fp=p;
  p=asmi(BC,p,1,6,0,0,0);
  p=asmi(BC,p,8,6,6,0,0);
  mjz(BC,prop,fp); mjz(BC,prop2,fp);
  ss(S,802,p-sg(S,797));
  // op 3 shift: E=match(CUR,S); CUR=E, CONTINUE or FAIL
  ss(S,798,p);
  prop=p; p=mpro(BC,p,4);
  p=asmi(BC,p,2,7,1,0,0);
  p=asmi(BC,p,1,6,0,0,1);
  p=asmi(BC,p,8,6,6,0,0);
  fp=p;
  p=asmi(BC,p,1,6,0,0,0);
  p=asmi(BC,p,8,6,6,0,0);
  mjz(BC,prop,fp);
  ss(S,803,p-sg(S,798));
  // op 4 adjust: X=match(CUR,V); gate=match(CUR,T) or FAIL;
  // ANSWERED X+p4 or FAIL.
  // p4 is a learner-owned immediate; its offset is recorded so the
  // revision rule can rewrite the body bytes. The T gate structurally
  // isolates parameter revision: ADJUST fails (rec 0, never wrong)
  // where no T edge exists, so the parameter is only ever revised
  // where it is the explanatory variable.
  ss(S,799,p);
  prop=p; p=mpro(BC,p,1);
  p=asmi(BC,p,1,4,0,0,1);
  p=asmi(BC,p,7,1,4,5,0);
  let prop3:i32=p; p=mpro(BC,p,5);
  ss(S,812,p+4);
  p=asmi(BC,p,1,0,0,0,0);
  p=asmi(BC,p,3,5,0,5,0);
  p=asmi(BC,p,1,6,0,0,2);
  p=asmi(BC,p,8,6,5,0,0);
  fp=p;
  p=asmi(BC,p,1,6,0,0,0);
  p=asmi(BC,p,8,6,6,0,0);
  mjz(BC,prop,fp); mjz(BC,prop3,fp);
  ss(S,804,p-sg(S,799));
  return;
}
// ============ generic instruction interpreter ============
// Dispatches ONLY on the 8 generic ISA opcodes; op id o is used solely
// to locate the body. status: 0 FAIL, 1 CONTINUE, 2 ANSWERED.
fn cog_exec(S:[]u8,BC:[]u8,o:i32)void {
  let pc:i32=sg(S,795+o);
  let pend:i32=pc+sg(S,800+o);
  let guard:i32=0;
  while(pc<pend && guard<64){
    guard=guard+1;
    let opc:i32=BC[pc] as i32;
    let a:i32=BC[pc+1] as i32;
    let b:i32=BC[pc+2] as i32;
    let c:i32=BC[pc+3] as i32;
    let imm:i32=get32(BC,pc+4);
    if(opc==1){ ss(S,787+a,imm); pc=pc+8; }
    else if(opc==2){ ss(S,787+a,sg(S,787+b)); pc=pc+8; }
    else if(opc==3){ ss(S,787+c,sg(S,787+a)+sg(S,787+b)); pc=pc+8; }
    else if(opc==4){
      let v:i32=0;
      if(sg(S,787+a)==sg(S,787+b)){v=1;}
      ss(S,787+c,v); pc=pc+8;
    }
    else if(opc==5){
      if(sg(S,787+a)!=0){pc=pc+imm;} else {pc=pc+8;}
    }
    else if(opc==6){ ss(S,787+c,g_match(S,sg(S,787+a),sg(S,787+b))); pc=pc+8; }
    else if(opc==7){ ss(S,787+c,g_field(S,sg(S,787+a),sg(S,787+b))); pc=pc+8; }
    else if(opc==8){ ss(S,805,sg(S,787+a)); ss(S,806,sg(S,787+b)); return; }
    else { pc=pc+8; }
  }
  ss(S,805,0); ss(S,806,0);
  return;
}
// ============ learned table reads (x1000; unseen = 500 optimism) ============
fn appl_mx(S:[]u8,o:i32,ctx:i32)i32 {
  let n:i32=sg(S,80+o*16+ctx);
  if(n>0){ return (1000*sg(S,o*16+ctx))/n; }
  return 500;
}
fn comp_mx(S:[]u8,p:i32,o:i32)i32 {
  let n:i32=sg(S,185+p*5+o);
  if(n>0){ return (1000*sg(S,160+p*5+o))/n; }
  return 500;
}
fn tot_mx(S:[]u8,o:i32)i32 {
  let n:i32=sg(S,215+o);
  if(n>0){ return (1000*sg(S,210+o))/n; }
  return 0;
}
// ============ observable context probe (edge existence only) ============
fn cog_probe(S:[]u8)i32 {
  let cur:i32=sg(S,794);
  let c:i32=0;
  if(g_match(S,cur,1)!=-1){c=c+1;}
  if(g_match(S,cur,2)!=-1){c=c+2;}
  if(g_match(S,cur,4)!=-1){c=c+4;}
  if(g_match(S,cur,5)!=-1){c=c+8;}
  return c;
}
// ============ generic bandit selector (never branches on op id) ============
// Writes sel_op to cell 862, sel_greedy (1=greedy,0=exploration) to 863.
fn cog_select(S:[]u8,ctx:i32,prev:i32,epsx:i32,nops:i32)void {
  let nc:i32=0; let o:i32=0;
  while(o<nops){ if(sg(S,220+o)==0){nc=nc+1;} o=o+1; }
  let rs:i32=xorsh(S,231)&2147483647;
  if((rs % 1000)<epsx){
    let rs2:i32=xorsh(S,231)&2147483647;
    let pick:i32=rs2 % nc;
    let k:i32=0; o=0;
    while(o<nops){
      if(sg(S,220+o)==0){
        if(k==pick){ss(S,862,o); ss(S,863,0); return;}
        k=k+1;
      }
      o=o+1;
    }
    ss(S,862,0); ss(S,863,0); return;
  }
  let best:i32=-1; let bests:i32=0; let bestt:i32=0; o=0;
  while(o<nops){
    if(sg(S,220+o)==0){
      let sc:i32=appl_mx(S,o,ctx);
      if(prev<nops){ sc=sc+comp_mx(S,prev,o); }
      let tn:i32=sg(S,215+o);
      if(best<0 || sc>bests || (sc==bests && tn<bestt)){best=o;bests=sc;bestt=tn;}
    }
    o=o+1;
  }
  ss(S,862,best); ss(S,863,1);
  return;
}
// ============ environments: one fresh world per episode ============
// Arm A: typ 0=F (30%), 1=F2 (25%), 2=T2 (15%), 3=CHAIN3 (30%).
// Single phase (v6).
// Arm B: typ 0=F (50%), 1=EST (50%, true = V+4).
fn env_build(S:[]u8,arm:i32)i32 {
  ss(S,737,0); ss(S,786,0);
  let r:i32=xorsh(S,230);
  let typ:i32=0;
  if(arm==0){
    let t:i32=((r>>16)&2147483647)%100;
    if(t<30){typ=0;}
    else if(t<55){typ=1;}
    else if(t<70){typ=2;}
    else {typ=3;}
  } else {
    typ=(r>>16)&1;
  }
  let q:i32=g_node(S,1,0,0);
  if(typ==0){
    let r2:i32=xorsh(S,230);
    let av:i32=10+(((r2>>16)&2147483647)%40);
    let vn:i32=g_node(S,2,av,0);
    g_edge(S,q,1,vn);
    ss(S,807,av);
  } else if(typ==1 && arm==0){
    let e2:i32=g_node(S,1,0,0);
    let r2:i32=xorsh(S,230);
    let v2:i32=10+(((r2>>16)&2147483647)%30);
    let r3:i32=xorsh(S,230);
    let kk:i32=1+(((r3>>16)&2147483647)%9);
    let vn:i32=g_node(S,2,v2,0);
    let kn:i32=g_node(S,2,kk,0);
    g_edge(S,q,2,e2);
    g_edge(S,e2,1,vn);
    g_edge(S,e2,3,kn);
    ss(S,807,v2+kk);
  } else if(typ==2){
    let e3:i32=g_node(S,1,0,0);
    let r2:i32=xorsh(S,230);
    let v3:i32=10+(((r2>>16)&2147483647)%40);
    let vn:i32=g_node(S,2,v3,0);
    g_edge(S,q,4,e3);
    g_edge(S,e3,1,vn);
    ss(S,807,v3);
  } else if(typ==3){
    let e2:i32=g_node(S,1,0,0);
    let e4:i32=g_node(S,1,0,0);
    let r2:i32=xorsh(S,230);
    let v4:i32=10+(((r2>>16)&2147483647)%30);
    let r3:i32=xorsh(S,230);
    let k4:i32=1+(((r3>>16)&2147483647)%9);
    let vn:i32=g_node(S,2,v4,0);
    let kn:i32=g_node(S,2,k4,0);
    let m:i32=g_node(S,1,0,0);
    g_edge(S,q,2,e2);
    g_edge(S,e2,4,e4);
    g_edge(S,e4,1,vn);
    g_edge(S,e4,3,kn);
    g_edge(S,e4,5,m);
    ss(S,807,v4+k4);
  } else {
    // Arm B EST world: (Q)-[V]->v, (Q)-[T]->marker, true = v+4.
    // The constant 4 lives only here, in the environment.
    let r2:i32=xorsh(S,230);
    let av:i32=10+(((r2>>16)&2147483647)%40);
    let vn:i32=g_node(S,2,av,0);
    let m:i32=g_node(S,1,0,0);
    g_edge(S,q,1,vn);
    g_edge(S,q,5,m);
    ss(S,807,av+4);
  }
  return typ;
}
// ============ one episode ============
// Returns updated OUT cursor. Discovery snapshot for Arm A CHAIN3 is
// taken BEFORE the episode; the discovery check runs after credit.
fn run_ep(S:[]u8,BC:[]u8,OUT:[]u8,cur:i32,ep:i32,epsx:i32,nops:i32,arm:i32)i32 {
  let typ:i32=env_build(S,arm);
  ss(S,794,0);
  if(arm==0 && typ==3){
    ss(S,824,sg(S,168)); ss(S,825,sg(S,193));
    ss(S,826,sg(S,177)); ss(S,827,sg(S,202));
  }
  let step:i32=0; let prev:i32=nops; let nu:i32=0;
  let uo:[]u8=z_alloc(4); let ug:[]u8=z_alloc(4);
  let us:[]u8=z_alloc(4); let uc:[]u8=z_alloc(4); let ua:[]u8=z_alloc(16);
  let solved:i32=0;
  if(ep<2){
    cur=e1str(OUT,cur,"TR ep="); cur=e1i64(OUT,cur,ep as i64);
    cur=e1str(OUT,cur," typ="); cur=e1i64(OUT,cur,typ as i64);
  }
  while(step<3 && solved==0){
    let ctx:i32=cog_probe(S);
    cog_select(S,ctx,prev,epsx,nops);
    let o:i32=sg(S,862); let gr:i32=sg(S,863);
    cog_exec(S,BC,o);
    let st:i32=sg(S,805); let an:i32=sg(S,806);
    uo[nu]=o as u8; ug[nu]=gr as u8; us[nu]=st as u8; uc[nu]=ctx as u8;
    set32(ua,nu*4,an);
    nu=nu+1;
    if(ep<2){
      cur=e1str(OUT,cur," [o="); cur=e1i64(OUT,cur,o as i64);
      cur=e1str(OUT,cur," g="); cur=e1i64(OUT,cur,gr as i64);
      cur=e1str(OUT,cur," c="); cur=e1i64(OUT,cur,ctx as i64);
      cur=e1str(OUT,cur," s="); cur=e1i64(OUT,cur,st as i64);
      cur=e1str(OUT,cur,"]");
    }
    if(st==2 && an==sg(S,807)){solved=1;}
    prev=o; step=step+1;
  }
  if(ep<2){
    cur=e1str(OUT,cur," solved="); cur=e1i64(OUT,cur,solved as i64);
    cur=e1str(OUT,cur,"\n");
  }
  ss(S,864,0);
  let i:i32=0;
  while(i<nu){
    let o2:i32=uo[i] as i32; let c2:i32=uc[i] as i32;
    let s2:i32=us[i] as i32; let a2:i32=get32(ua,i*4);
    let p2:i32=nops;
    if(i>0){p2=uo[i-1] as i32;}
    let rec:i32=0;
    if(s2==2){
      if(a2==sg(S,807)){rec=1;} else {rec=-1;}
    } else if(s2==1){
      if(solved==1){rec=1;}
    }
    ss(S,o2*16+c2,sg(S,o2*16+c2)+rec);
    ss(S,80+o2*16+c2,sg(S,80+o2*16+c2)+1);
    // Composition links are written only when the preceding op was
    // effective (non-failed). General principle, as in prior work.
    if(p2<nops && (us[i-1] as i32)!=0){
      ss(S,160+p2*5+o2,sg(S,160+p2*5+o2)+rec);
      ss(S,185+p2*5+o2,sg(S,185+p2*5+o2)+1);
    }
    ss(S,210+o2,sg(S,210+o2)+rec);
    ss(S,215+o2,sg(S,215+o2)+1);
    // Body parameter revision (generic delta rule): on a wrong
    // answer, move the op's learner-owned parameter by the full
    // signed error and rewrite the body bytes. At most one revision
    // per op per episode: the error signal is stale after the first
    // (tables do not update mid-episode). The T-gate in ADJUST's
    // body structurally isolates this: the parameter is only ever
    // explanatory where the op answers wrongly.
    if(rec==-1 && sg(S,808+o2)>=0 && sg(S,864)==0){
      let e2:i32=sg(S,807)-a2;
      if(e2!=0){
        let np:i32=sg(S,813+o2)+e2;
        set32(BC,sg(S,808+o2),np);
        ss(S,813+o2,np);
        ss(S,864,1);
        let rn:i32=sg(S,828);
        ss(S,828,rn+1);
        if(rn<8){ss(S,829+rn,ep);}
      }
    }
    let lh:i32=sg(S,232); let li:i32=233+(lh % 96)*5;
    ss(S,li,ep); ss(S,li+1,o2); ss(S,li+2,c2); ss(S,li+3,rec); ss(S,li+4,typ);
    ss(S,232,lh+1);
    i=i+1;
  }
  // Discovery check (Arm A, CHAIN3): first solved episode containing
  // [1,3,2] as a consecutive all-greedy subsequence.
  if(arm==0 && typ==3 && sg(S,818)<0){
    let j:i32=0; let found:i32=0;
    while(j+2<nu){
      if((uo[j] as i32)==1 && (uo[j+1] as i32)==3 && (uo[j+2] as i32)==2 && (ug[j] as i32)==1 && (ug[j+1] as i32)==1 && (ug[j+2] as i32)==1 && solved==1){found=1;}
      j=j+1;
    }
    if(found==1){
      let clean:i32=0;
      if(sg(S,824)<=0 && sg(S,826)<=0){clean=1;}
      ss(S,818,ep);
      ss(S,819,sg(S,824)); ss(S,820,sg(S,825));
      ss(S,821,sg(S,826)); ss(S,822,sg(S,827));
      ss(S,823,clean);
      cur=e1str(OUT,cur,"DISCOVERY ep="); cur=e1i64(OUT,cur,ep as i64);
      cur=e1str(OUT,cur," clean="); cur=e1i64(OUT,cur,clean as i64);
      cur=e1str(OUT,cur," pre13="); cur=e1i64(OUT,cur,sg(S,824) as i64);
      cur=e1str(OUT,cur,"/"); cur=e1i64(OUT,cur,sg(S,825) as i64);
      cur=e1str(OUT,cur," pre32="); cur=e1i64(OUT,cur,sg(S,826) as i64);
      cur=e1str(OUT,cur,"/"); cur=e1i64(OUT,cur,sg(S,827) as i64);
      cur=e1str(OUT,cur,"\n");
    }
  }
  let tri:i32=0;
  if(arm==0 && typ==3){
    let j2:i32=0;
    while(j2+2<nu){
      if((uo[j2] as i32)==1 && (uo[j2+1] as i32)==3 && (uo[j2+2] as i32)==2){tri=1;}
      j2=j2+1;
    }
  }
  cog_stats(S,ep,typ,solved,tri,arm);
  // generic retirement rule
  let o3:i32=0;
  while(o3<nops){
    if(sg(S,220+o3)==0 && sg(S,215+o3)>=15 && sg(S,210+o3)*10<-6*sg(S,215+o3)){
      ss(S,220+o3,1); ss(S,225+o3,ep);
      cur=e1str(OUT,cur,"RETIRE op="); cur=e1i64(OUT,cur,o3 as i64);
      cur=e1str(OUT,cur," ep="); cur=e1i64(OUT,cur,ep as i64);
      cur=e1str(OUT,cur,"\n");
    }
    o3=o3+1;
  }
  return cur;
}
// ============ stats ============
fn cog_stats(S:[]u8,ep:i32,typ:i32,solved:i32,tri:i32,arm:i32)void {
  let late:i32=0;
  if(ep>=400){late=1;}
  if(arm==0 && typ==3){
    ss(S,850,sg(S,850)+1);
    if(solved==1){ss(S,851,sg(S,851)+1);}
    if(tri==1){ss(S,852,sg(S,852)+1);}
    if(late==1){
      ss(S,838,sg(S,838)+1);
      if(solved==1){ss(S,839,sg(S,839)+1);}
      if(tri==1){ss(S,840,sg(S,840)+1);}
    }
  }
  if(arm==1 && typ==1){
    ss(S,856,sg(S,856)+1);
    if(solved==1){ss(S,857,sg(S,857)+1);}
    if(late==1){
      ss(S,844,sg(S,844)+1);
      if(solved==1){ss(S,845,sg(S,845)+1);}
    }
  }
  return;
}
// ============ report ============
fn arm_report(S:[]u8,OUT:[]u8,cur:i32,nops:i32,arm:i32)i32 {
  cur=e1str(OUT,cur,"TABLE-appl-x1000:\n");
  let o:i32=0;
  while(o<nops){
    cur=e1str(OUT,cur,"op "); cur=e1i64(OUT,cur,o as i64); cur=e1str(OUT,cur,":");
    let c:i32=0;
    while(c<16){ cur=e1str(OUT,cur," "); cur=e1i64(OUT,cur,appl_mx(S,o,c) as i64); c=c+1; }
    cur=e1str(OUT,cur," tot="); cur=e1i64(OUT,cur,tot_mx(S,o) as i64);
    cur=e1str(OUT,cur," n="); cur=e1i64(OUT,cur,sg(S,215+o) as i64);
    cur=e1str(OUT,cur," ret="); cur=e1i64(OUT,cur,sg(S,220+o) as i64);
    cur=e1str(OUT,cur,"\n");
    o=o+1;
  }
  cur=e1str(OUT,cur,"TABLE-comp-x1000:\n");
  let p:i32=0;
  while(p<nops){
    cur=e1str(OUT,cur,"prev "); cur=e1i64(OUT,cur,p as i64); cur=e1str(OUT,cur,":");
    o=0;
    while(o<nops){ cur=e1str(OUT,cur," "); cur=e1i64(OUT,cur,comp_mx(S,p,o) as i64); o=o+1; }
    cur=e1str(OUT,cur,"\n");
    p=p+1;
  }
  if(arm==0){
    cur=e1str(OUT,cur,"DISC-REC ep="); cur=e1i64(OUT,cur,sg(S,818) as i64);
    cur=e1str(OUT,cur," clean="); cur=e1i64(OUT,cur,sg(S,823) as i64);
    cur=e1str(OUT,cur," pre13="); cur=e1i64(OUT,cur,sg(S,819) as i64);
    cur=e1str(OUT,cur,"/"); cur=e1i64(OUT,cur,sg(S,820) as i64);
    cur=e1str(OUT,cur," pre32="); cur=e1i64(OUT,cur,sg(S,821) as i64);
    cur=e1str(OUT,cur,"/"); cur=e1i64(OUT,cur,sg(S,822) as i64);
    cur=e1str(OUT,cur,"\n");
    cur=e1str(OUT,cur,"COMPRAW-13 sum="); cur=e1i64(OUT,cur,sg(S,168) as i64);
    cur=e1str(OUT,cur," n="); cur=e1i64(OUT,cur,sg(S,193) as i64);
    cur=e1str(OUT,cur," COMPRAW-32 sum="); cur=e1i64(OUT,cur,sg(S,177) as i64);
    cur=e1str(OUT,cur," n="); cur=e1i64(OUT,cur,sg(S,202) as i64);
    cur=e1str(OUT,cur,"\n");
    cur=e1str(OUT,cur,"CHAIN3 all="); cur=e1i64(OUT,cur,sg(S,850) as i64);
    cur=e1str(OUT,cur," ok="); cur=e1i64(OUT,cur,sg(S,851) as i64);
    cur=e1str(OUT,cur," tri="); cur=e1i64(OUT,cur,sg(S,852) as i64);
    cur=e1str(OUT,cur," late_n="); cur=e1i64(OUT,cur,sg(S,838) as i64);
    cur=e1str(OUT,cur," late_ok="); cur=e1i64(OUT,cur,sg(S,839) as i64);
    cur=e1str(OUT,cur," late_tri="); cur=e1i64(OUT,cur,sg(S,840) as i64);
    cur=e1str(OUT,cur,"\n");
  } else {
    cur=e1str(OUT,cur,"PARAM p4="); cur=e1i64(OUT,cur,sg(S,813+4) as i64);
    cur=e1str(OUT,cur," rev_n="); cur=e1i64(OUT,cur,sg(S,828) as i64);
    cur=e1str(OUT,cur," rev_eps=");
    let r2:i32=0;
    let rn2:i32=sg(S,828);
    if(rn2>8){rn2=8;}
    while(r2<rn2){ cur=e1i64(OUT,cur,sg(S,829+r2) as i64); cur=e1str(OUT,cur,","); r2=r2+1; }
    cur=e1str(OUT,cur," EST all="); cur=e1i64(OUT,cur,sg(S,856) as i64);
    cur=e1str(OUT,cur," ok="); cur=e1i64(OUT,cur,sg(S,857) as i64);
    cur=e1str(OUT,cur," late_n="); cur=e1i64(OUT,cur,sg(S,844) as i64);
    cur=e1str(OUT,cur," late_ok="); cur=e1i64(OUT,cur,sg(S,845) as i64);
    cur=e1str(OUT,cur,"\n");
  }
  return cur;
}
// ============ one arm: fresh learner, 500 episodes ============
fn cog_arm(S:[]u8,BC:[]u8,OUT:[]u8,cur:i32,nops:i32,arm:i32)i32 {
  let ep:i32=0;
  while(ep<500){
    // v7: arm-dependent exploration. Arm A (composition): eps=0,
    // pure greedy, so every triple is all-greedy by construction.
    // Arm B (revision): normal eps schedule, so exploration can
    // recover a miscalibrated op.
    let ex:i32=0;
    if(arm==1){ex=(300*300)/(300+ep);}
    cur=run_ep(S,BC,OUT,cur,ep,ex,nops,arm);
    if(ep % 100==99){
      cur=e1str(OUT,cur,"EP "); cur=e1i64(OUT,cur,(ep+1) as i64);
      cur=e1str(OUT,cur," done\n");
    }
    ep=ep+1;
  }
  cur=arm_report(S,OUT,cur,nops,arm);
  return cur;
}
fn main()i32 {
  let OUT:[]u8=z_alloc(1048576);
  let cur:i32=0;
  cur=e1str(OUT,cur,"MULTOP-START\n");
  // ---- Arm A: 3-op compositional discovery ----
  let S:[]u8=z_alloc(8192);
  let BC:[]u8=z_alloc(2048);
  ss(S,230,123456789); ss(S,231,987654321);
  ss(S,818,-1);
  let k:i32=0;
  while(k<5){ ss(S,808+k,-1); k=k+1; }
  build_bodies(S,BC);
  cur=e1str(OUT,cur,"ARM-A-COMP nops=4\n");
  cur=cog_arm(S,BC,OUT,cur,4,0);
  let t1:i32=0;
  if(sg(S,818)>=0 && sg(S,823)==1){t1=1;}
  let t2:i32=0;
  let ln3:i32=sg(S,838);
  if(ln3>0 && sg(S,839)*100>=75*ln3 && sg(S,840)*100>=55*ln3){t2=1;}
  cur=e1str(OUT,cur,"VERDICT-A T1="); cur=e1i64(OUT,cur,t1 as i64);
  cur=e1str(OUT,cur," T2="); cur=e1i64(OUT,cur,t2 as i64);
  cur=e1str(OUT,cur,"\n");
  // ---- Arm B: body parameter revision ----
  let S2:[]u8=z_alloc(8192);
  let BC2:[]u8=z_alloc(2048);
  ss(S2,230,123456789); ss(S2,231,987654321);
  ss(S2,818,-1);
  k=0;
  while(k<5){ ss(S2,808+k,-1); k=k+1; }
  build_bodies(S2,BC2);
  cur=e1str(OUT,cur,"ARM-B-REV nops=5\n");
  cur=cog_arm(S2,BC2,OUT,cur,5,1);
  let t3:i32=0;
  let lenb:i32=sg(S2,844);
  if(sg(S2,813+4)==4 && sg(S2,828)>=1 && lenb>0 && sg(S2,845)*100>=75*lenb){t3=1;}
  cur=e1str(OUT,cur,"VERDICT-B T3="); cur=e1i64(OUT,cur,t3 as i64);
  cur=e1str(OUT,cur," p4="); cur=e1i64(OUT,cur,sg(S2,813+4) as i64);
  cur=e1str(OUT,cur,"\n");
  cur=e1str(OUT,cur,"VERDICT-OVERALL ");
  if(t1==1 && t2==1 && t3==1){ cur=e1str(OUT,cur,"PROCESS-MULTIOP-COMPLETE\n"); }
  else { cur=e1str(OUT,cur,"INCOMPLETE\n"); }
  cur=e1str(OUT,cur,"MULTOP-END\n");
  let wrc:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(OUT) as i64),(cur as i64),0,0,0);
  if(wrc==(cur as i64)){return 0;}
  return 1;
}

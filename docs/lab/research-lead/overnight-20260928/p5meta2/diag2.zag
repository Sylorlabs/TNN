// diag2.zag -- P5-2 APPARATUS DIAGNOSTIC (frozen per PREREG2 sections 2.1, 3, 4)
// Pure Zag. Output via _zag_print only (brief 4.0). No forbidden executables.
//
// D0  bounds-checked primitive self-test
// D1  ONE ROUND / ONE TIER reduced search: cur,tot,room,take,cnt,budget,found
// D1s STORE test: stride-4 record, SA must equal cnt and accumulate
// D2  FALSIFIABLE PREDICTION (PREREG2 2.1): the four reported integers
//     1 / 65536 / 1677721856 / 1080295425 must fall out of byte-stride-1
//     layout arithmetic alone, with no learner code.
// D3  capacity table assert for every arena the copied helpers use
//
// Sections D1/D1s copy p5.zag's search phase verbatim except that (a) it runs
// ONE round, (b) it prints every scalar, (c) the record is stride-4.

fn RMAX()i32 { return 64; }
fn SB()i32 { return 24; }
fn AUDN()i32 { return 16; }
fn MAXE()i32 { return 256; }
fn VAUD()i32 { return 32; }
fn RBIND()i32 { return 12744; }
fn RPLAN()i32 { return 13000; }
fn RSTAT()i32 { return 13224; }
fn RDETC()i32 { return 15900; }
fn RSTRA()i32 { return 16600; }
fn RCTXT()i32 { return 17000; }
fn LSZ()i32 { return 18432; }
fn bindi(i:i32)i32 { return RBIND()+i*4; }
fn planb(p:i32)i32 { return RPLAN()+p*56; }
fn ctxb(s:i32)i32 { return RCTXT()+s*56; }
fn strb(s:i32)i32 { return RSTRA()+(s-1)*12; }
fn S_TOK()i32 { return 0; }
fn S_TVF()i32 { return 1; }

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_num(b:[]u8,c:i32,v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){ neg=1; x=0-x; }
  let d:i32=0;
  let t:i32=x;
  while(t>0){ d=d+1; t=t/10; }
  if(d<1){ d=1; }
  let e:i32=c+neg+d;
  let p:i32=e-1;
  let y:i32=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn fv(b:[]u8,c:i32,k:[]u8,v:i32)i32 { let d:i32=o_app(b,c,k); let e:i32=o_num(b,d,v); b[e]=32; return e+1; }
fn fvs(b:[]u8,c:i32,k:[]u8)i32 { return o_app(b,c,k); }

// ---------------- bounds-asserted accessors (PREREG2 section 4.1) ----------------
// The emitted binary has NO slice bounds checks, so this is the only detector.
// CHKV[0..3] = violation count.
fn viol(CHKV:[]u8,off:i32,bl:i32)void {
  set32(CHKV,0,get32(CHKV,0)+1);
  let b:[]u8=z_alloc(96);
  let o:i32=o_app(b,0,"BOUNDS_VIOLATION off=");
  o=o_num(b,o,off);
  o=o_app(b,o," need=");
  o=o_num(b,o,off+4);
  o=o_app(b,o," len=");
  o=o_num(b,o,bl);
  o=o_nl(b,o);
  _zag_print(b[0..o]);
  return;
}
fn g32(CHKV:[]u8,b:[]u8,off:i32)i32 {
  if(off<0){ viol(CHKV,off,b.len); return 0; }
  if((off+4)>b.len){ viol(CHKV,off,b.len); return 0; }
  return get32(b,off);
}
fn s32(CHKV:[]u8,b:[]u8,off:i32,v:i32)void {
  if(off<0){ viol(CHKV,off,b.len); return; }
  if((off+4)>b.len){ viol(CHKV,off,b.len); return; }
  set32(b,off,v);
  return;
}
// one-byte checked write (used for the label byte)
fn sb(CHKV:[]u8,b:[]u8,i:i32,v:i32)void {
  if(i<0){ viol(CHKV,i,b.len); return; }
  if(i>=b.len){ viol(CHKV,i,b.len); return; }
  b[i]=(v as u8);
  return;
}

// ---------------- copied verbatim from p5.zag ----------------
fn prng(P:[]u8)i32 {
  let x:i32=get32(P,16);
  let y:i32=(x*25173+13849)%65536;
  set32(P,16,y);
  return y;
}
fn prs(P:[]u8,s:i32)void { set32(P,16,s); return; }
fn hsh(a:i32,b:i32)i32 {
  let v:i32=(a*7919+b*104729)%65536;
  if(v<0){ v=v+65536; }
  return v;
}
fn bin_init(B:[]u8)void {
  let n:i32=0;
  while(n<13){
    set32(B,n*24,1);
    let r:i32=1;
    while(r<6){
      if(r>n){ set32(B,n*24+r*4,0); }
      else { set32(B,n*24+r*4,get32(B,(n-1)*24+(r-1)*4)+get32(B,(n-1)*24+r*4)); }
      r=r+1;
    }
    n=n+1;
  }
  return;
}
fn ncr(B:[]u8,n:i32,r:i32)i32 {
  if(r<0){ return 0; }
  if(r>n){ return 0; }
  return get32(B,n*24+r*4);
}
fn fb(f:[]u8,i:i32)i32 { return get32(f,i*4); }
fn fbs(f:[]u8,i:i32,v:i32)void { set32(f,i*4,v); return; }
fn fseed(fid:i32)i32 { return hsh(1000,fid*31+7); }
fn pool(i:i32)i32 {
  if(i==0){ return 1; } if(i==1){ return 3; } if(i==2){ return 4; }
  if(i==3){ return 6; } if(i==4){ return 8; } if(i==5){ return 9; }
  return 11;
}
fn colds(i:i32)i32 {
  if(i==0){ return 0; } if(i==1){ return 2; } if(i==2){ return 5; }
  if(i==3){ return 7; }
  return 10;
}
fn pick3(P:[]u8,FB:[]u8,src:i32,nsrc:i32,wo:i32)i32 {
  let g:i32=0; let guard:i32=0;
  while((g<3)&&(guard<9000)){
    let r:i32=prng(P)%nsrc;
    let v:i32=r;
    if(src==1){ v=colds(r); }
    let dup:i32=0; let i:i32=0;
    while(i<g){ if(fb(FB,wo+i)==v){ dup=1; } i=i+1; }
    if(dup==0){ fbs(FB,wo+g,v); g=g+1; }
    guard=guard+1;
  }
  return g;
}
fn fam_build(FB:[]u8,fid:i32,P:[]u8)i32 {
  prs(P,fseed(fid));
  fbs(FB,0,0); fbs(FB,1,3); fbs(FB,2,0); fbs(FB,3,0);
  fbs(FB,4,0); fbs(FB,5,0); fbs(FB,6,0); fbs(FB,7,fid);
  if(fid<8){
    let k:i32=3;
    if(fid==2){ k=2; }
    if(fid==6){ k=2; }
    fbs(FB,1,k);
    fbs(FB,2,fid%4);
    let i:i32=0;
    while(i<k){ fbs(FB,4+i,pool((3*fid+i)%7)); i=i+1; }
    return 1;
  }
  if(fid<16){
    fbs(FB,3,1);
    let e:i32=fid-8; let i:i32=0;
    while(i<3){ fbs(FB,4+i,pool((3*e+i)%7)); i=i+1; }
    return 1;
  }
  if(fid<22){
    fbs(FB,2,(fid-16)%4);
    return pick3(P,FB,0,12,4);
  }
  if(fid<28){
    fbs(FB,2,(fid-22)%4);
    return pick3(P,FB,1,5,4);
  }
  if(fid<34){
    fbs(FB,2,(fid-28)%4);
    let r:i32=pick3(P,FB,0,7,4);
    let r2:i32=pick3(P,FB,1,5,6);
    return r+r2;
  }
  if(fid<40){
    fbs(FB,3,1);
    return pick3(P,FB,0,12,4);
  }
  fbs(FB,0,2);
  fbs(FB,2,(fid-40)%4);
  return pick3(P,FB,1,5,4);
}
fn projb(dom:i32,v:i32)i32 {
  if(dom==0){ return v; }
  if(v==2){ return 1; }
  return 0;
}
fn opv(op:i32,s:i32)i32 {
  if(op==0){ return s%2; }
  if(op==1){ if(s>=2){ return 1; } return 0; }
  if(op==2){ if(s==1){ return 1; } return 0; }
  if(s==0){ return 1; }
  return 0;
}
fn gen_ex(P:[]u8,FB:[]u8,out:[]u8)void {
  let dom:i32=fb(FB,0); let k:i32=fb(FB,1); let op:i32=fb(FB,2);
  let noise:i32=fb(FB,3);
  let mx:i32=2;
  if(dom==0){ mx=1; }
  let j:i32=0;
  while(j<12){ out[j]=(prng(P)%(mx+1)) as u8; j=j+1; }
  let y:i32=0;
  if(noise==1){ y=prng(P)%2; }
  else {
    let s:i32=0; let i:i32=0;
    while(i<k){ s=s+projb(dom,fb(FB,4+i)); i=i+1; }
    y=opv(op,s);
    if(dom==2){ y=1-y; }
  }
  out[12]=(y as u8);
  return;
}
fn gen_all(P:[]u8,FB:[]u8,EXB:[]u8)void {
  prs(P,fseed(fb(FB,7)));
  let e:i32=0;
  while(e<MAXE()){
    gen_ex(P,FB,EXB[e*13..e*13+13]);
    e=e+1;
  }
  return;
}
fn tier_n(a:i32)i32 {
  if(a==1){ return 12; }
  if(a==2){ return 66; }
  if(a==3){ return 220; }
  return 495;
}
fn unrank(B:[]u8,POS:[]u8,po:i32,k:i32,t:i32)void {
  let start:i32=0; let j:i32=0;
  while(j<k){
    let rem:i32=k-j-1;
    let c:i32=ncr(B,11-start,rem);
    let p:i32=start;
    while(t>=c){ t=t-c; p=p+1; c=ncr(B,11-p,rem); }
    set32(POS,(po+j)*4,p);
    start=p+1;
    j=j+1;
  }
  return;
}
fn tier_hyp(B:[]u8,POS:[]u8,a:i32,p:i32)void {
  let op:i32=p%4;
  let t:i32=p/4;
  unrank(B,POS,0,a,t);
  set32(POS,16,a);
  set32(POS,20,op);
  return;
}
fn hyp_pred(FB:[]u8,ORD:[]u8,POS:[]u8,e:i32,EXB:[]u8)i32 {
  let dom:i32=fb(FB,0);
  let a:i32=get32(POS,16);
  let s:i32=0; let p:i32=0;
  while(p<a){
    let sl:i32=get32(ORD,get32(POS,p*4)*4);
    s=s+projb(dom,EXB[e*13+sl] as i32);
    p=p+1;
  }
  let y:i32=opv(get32(POS,20),s);
  if(dom==2){ return 1-y; }
  return y;
}
fn hyp_fit(FB:[]u8,ORD:[]u8,POS:[]u8,ne:i32,EXB:[]u8)i32 {
  let e:i32=0;
  while(e<ne){
    if(hyp_pred(FB,ORD,POS,e,EXB)!=(EXB[e*13+12] as i32)){ return 0; }
    e=e+1;
  }
  return 1;
}
fn state_init(L:[]u8)void {
  let i:i32=0;
  while(i<4){ set32(L,bindi(i),i+1); i=i+1; }
  set32(L,bindi(4),1);
  set32(L,bindi(5),0);
  return;
}
fn build_ord(L:[]u8,ORD:[]u8)void {
  let used:i32=0;
  let j:i32=0;
  while(j<12){
    let bi:i32=-1; let bv:i32=-1; let k:i32=0;
    while(k<12){
      let u:i32=(used>>k)%2;
      if(u==0){
        let v:i32=get32(L,ctxb(k));
        if(v>bv){ bv=v; bi=k; }
      }
      k=k+1;
    }
    set32(ORD,j*4,bi);
    used=used+(1<<bi);
    j=j+1;
  }
  return;
}

fn ffx(b:[]u8,c:i32,k:[]u8,v:i32)i32 {
  let d:i32=o_app(b,c,k);
  let e:i32=0;
  if(v==1){ e=o_app(b,d,"PASS"); } else { e=o_app(b,d,"FAIL"); }
  return e+1;
}
// ---------------- D1: ONE ROUND, ONE TIER ----------------
// prints cur,tot,room,take,cnt,budget,found for every tier visit
fn d1_round(CHKV:[]u8,OB:[]u8,o:i32,B:[]u8,P:[]u8,EXB:[]u8,FB:[]u8,ORD:[]u8,POS:[]u8,ARb:[]u8,CUR:[]u8,res:[]u8,ne:i32,rnd:i32)i32 {
  let budget:i32=SB();
  let found:i32=0;
  let pass:i32=0;
  o=fv(OB,o,"D1_ROUND rnd=",rnd);
  o=fv(OB,o," ne=",ne);
  o=fv(OB,o," budget0=",budget);
  o=fvs(OB,o," |");
  while((pass<2)&&(found==0)&&(budget>0)){
    let q:i32=0;
    while((q<4)&&(found==0)&&(budget>0)){
      let ar:i32=g32(CHKV,ARb,q*4);
      let enabled:i32=1;
      if(pass==0){ if(q>=rnd){ enabled=0; } }
      if(enabled==1){
        let tot:i32=tier_n(ar)*4;
        let cur:i32=g32(CHKV,CUR,ar*4);
        let room:i32=tot-cur;
        let take:i32=budget;
        if(take>room){ take=room; }
        let idx:i32=cur;
        let cnt:i32=0;
        if(room>0){
          while((cnt<take)&&(found==0)){
            tier_hyp(B,POS,ar,idx);
            if(hyp_fit(FB,ORD,POS,ne,EXB)==1){ found=1; }
            else { idx=idx+1; cnt=cnt+1; }
          }
          s32(CHKV,CUR,ar*4,cur+cnt);
          // D1b STORE test: accumulate through the STRIDE-4 cell accessor,
          // which is the repair under test. Must equal the summed cnt.
          s32(CHKV,res,1*4,g32(CHKV,res,1*4)+cnt);
          budget=budget-cnt;
        }
        o=fvs(OB,o," q=");
        o=o_num(OB,o,q);
        o=fvs(OB,o," ar=");
        o=o_num(OB,o,ar);
        o=fvs(OB,o," cur=");
        o=o_num(OB,o,cur);
        o=fvs(OB,o," tot=");
        o=o_num(OB,o,tot);
        o=fvs(OB,o," room=");
        o=o_num(OB,o,room);
        o=fvs(OB,o," take=");
        o=o_num(OB,o,take);
        o=fvs(OB,o," cnt=");
        o=o_num(OB,o,cnt);
        o=fvs(OB,o," budget=");
        o=o_num(OB,o,budget);
        o=fvs(OB,o," found=");
        o=o_num(OB,o,found);
        o=fvs(OB,o," |");
      }
      q=q+1;
    }
    pass=pass+1;
  }
  o=o_nl(OB,o);
  return o;
}

fn main()i32 {
  let OB:[]u8=z_alloc(65536);
  let CHKV:[]u8=z_alloc(16);
  let B:[]u8=z_alloc(512);
  let P:[]u8=z_alloc(32);
  let EXB:[]u8=z_alloc(MAXE()*13+16);
  let FB:[]u8=z_alloc(32);
  let L:[]u8=z_alloc(LSZ());
  let ORD:[]u8=z_alloc(64);
  let POS:[]u8=z_alloc(32);
  let ARb:[]u8=z_alloc(32);
  let CUR:[]u8=z_alloc(32);
  bin_init(B);
  let o:i32=0;
  o=fvs(OB,o,"HDR p5meta2 apparatus diagnostic D0-D3\n");

  // ---- D3 capacity table ----
  o=fvs(OB,o,"D3_CAP L=");
  o=o_num(OB,o,L.len);
  o=fvs(OB,o," need=");
  o=o_num(OB,o,RCTXT()+11*56+56);
  o=fvs(OB,o," EXB=");
  o=o_num(OB,o,EXB.len);
  o=fvs(OB,o," need=");
  o=o_num(OB,o,MAXE()*13);
  o=fvs(OB,o," B=");
  o=o_num(OB,o,B.len);
  o=fvs(OB,o," need=");
  o=o_num(OB,o,13*24);
  o=fvs(OB,o," POS=");
  o=o_num(OB,o,POS.len);
  o=fvs(OB,o," need=24 ORD=");
  o=o_num(OB,o,ORD.len);
  o=fvs(OB,o," ARb=");
  o=o_num(OB,o,ARb.len);
  o=fvs(OB,o," CUR=");
  o=o_num(OB,o,CUR.len);
  o=fvs(OB,o,"\n");
  if(L.len<(RCTXT()+11*56+56)){ o=fvs(OB,o,"D3_CAP_L_FAIL\n"); }
  if(EXB.len<(MAXE()*13)){ o=fvs(OB,o,"D3_CAP_EXB_FAIL\n"); }
  if(B.len<(13*24)){ o=fvs(OB,o,"D3_CAP_B_FAIL\n"); }
  if(POS.len<24){ o=fvs(OB,o,"D3_CAP_POS_FAIL\n"); }
  if(ORD.len<48){ o=fvs(OB,o,"D3_CAP_ORD_FAIL\n"); }
  if(ARb.len<16){ o=fvs(OB,o,"D3_CAP_ARb_FAIL\n"); }
  if(CUR.len<20){ o=fvs(OB,o,"D3_CAP_CUR_FAIL\n"); }

  // ---- D0 bounds-checked primitives ----
  let T:[]u8=z_alloc(64);
  let i:i32=0;
  while(i<16){ set32(T,i*4,0); i=i+1; }
  s32(CHKV,T,4,-7);
  s32(CHKV,T,8,1000000);
  let g0:i32=g32(CHKV,T,4);
  let g1:i32=g32(CHKV,T,8);
  let v0:i32=g32(CHKV,T,61);
  o=fvs(OB,o,"D0 g4=");
  o=o_num(OB,o,g0);
  o=fvs(OB,o," g8=");
  o=o_num(OB,o,g1);
  o=fvs(OB,o," v0=");
  o=o_num(OB,o,v0);
  o=fvs(OB,o," viol_before=");
  o=o_num(OB,o,get32(CHKV,0));
  o=fvs(OB,o,"\n");

  // ---- D2 FALSIFIABLE PREDICTION: byte-stride-1 record layout ----
  // Replays, in order, exactly the writes p5.zag's run_ep makes to a
  // non-reaching episode whose SA total is SATOT and whose NS total is 1,
  // then reads them back the way main() reads them (raw index as byte offset).
  let SATOT:i32=1536;
  let R:[]u8=z_alloc(64);
  let j:i32=0;
  while(j<12){ set32(R,j*4,0); j=j+1; }   // p5.zag line 424 reset, stride 4
  set32(R,1,SATOT);                        // SA accumulator (line 500)
  set32(R,7,1);                            // NS accumulator (line 485)
  set32(R,9,100);                          // acc   (line 562); FC store skipped
  set32(R,10,64);                          // rounds (line 564)
  set32(R,0,256);                          // EX    (line 566)
  o=fvs(OB,o,"D2_READ EX=");
  o=o_num(OB,o,get32(R,0));
  o=fvs(OB,o," SA=");
  o=o_num(OB,o,get32(R,1));
  o=fvs(OB,o," VA=");
  o=o_num(OB,o,get32(R,2));
  o=fvs(OB,o," RU=");
  o=o_num(OB,o,get32(R,4));
  o=fvs(OB,o," RR=");
  o=o_num(OB,o,get32(R,5));
  o=fvs(OB,o," RA=");
  o=o_num(OB,o,get32(R,6));
  o=fvs(OB,o," NS=");
  o=o_num(OB,o,get32(R,7));
  o=fvs(OB,o," FC=");
  o=o_num(OB,o,get32(R,8));
  o=fvs(OB,o," RND=");
  o=o_num(OB,o,get32(R,10));
  o=fvs(OB,o," SATOT_written=");
  o=o_num(OB,o,SATOT);
  o=fvs(OB,o,"\n");
  o=fvs(OB,o,"D2_BYTES");
  j=0;
  while(j<16){
    let bv:i32=R[j] as i32;
    o=fv(OB,o," b",j);
    o=o_num(OB,o,bv);
    j=j+1;
  }
  o=fvs(OB,o,"\n");
  let p1:i32=0;
  if(get32(R,1)==1){ p1=1; }
  if(get32(R,5)==65536){ p1=1; }
  if(get32(R,6)==1677721856){ p1=1; }
  if(get32(R,7)==1080295425){ p1=1; }
  if(get32(R,0)==256){ p1=1; }
  o=ffx(OB,o,"D2_ALL_FOUR_REPRODUCED=",p1);
  o=fvs(OB,o,"\n");

  // ---- D1 / D1s: ONE ROUND ONE TIER on a real RELATED family ----
  state_init(L);
  build_ord(L,ORD);
  set32(ARb,0,1); set32(ARb,4,2); set32(ARb,8,3); set32(ARb,12,4);
  let a:i32=1;
  while(a<5){ set32(CUR,a*4,0); a=a+1; }
  fam_build(FB,16,P);
  gen_all(P,FB,EXB);
  o=fvs(OB,o,"D1_FAM fid=16 k=");
  o=o_num(OB,o,fb(FB,1));
  o=fvs(OB,o," op=");
  o=o_num(OB,o,fb(FB,2));
  o=fvs(OB,o," act=");
  o=o_num(OB,o,fb(FB,4));
  o=fvs(OB,o,",");
  o=o_num(OB,o,fb(FB,5));
  o=fvs(OB,o,",");
  o=o_num(OB,o,fb(FB,6));
  o=fvs(OB,o,"\n");
  o=fvs(OB,o,"D1_ORD");
  a=0;
  while(a<12){ o=fv(OB,o," ",get32(ORD,a*4)); a=a+1; }
  o=fvs(OB,o,"\n");
  // D1s: stride-4 record. SA must equal the summed cnt read back at byte 4*SA.
  let res:[]u8=z_alloc(64);
  let z:i32=0;
  while(z<12){ set32(res,z*4,0); z=z+1; }
  let rnd:i32=1;
  while(rnd<=4){
    let o2:i32=d1_round(CHKV,OB,o,B,P,EXB,FB,ORD,POS,ARb,CUR,res,4*rnd,rnd);
    o=o2;
    o=fvs(OB,o,"D1S rnd=");
    o=o_num(OB,o,rnd);
    o=fvs(OB,o," SA_stride4=");
    o=o_num(OB,o,get32(res,1*4));
    o=fvs(OB,o," SA_byte1_IF_BUGGY=");
    o=o_num(OB,o,get32(res,1));
    o=fvs(OB,o," CUR_a1=");
    o=o_num(OB,o,get32(CUR,4));
    o=fvs(OB,o,"\n");
    rnd=rnd+1;
  }
  // Frozen expectations, derived from the D1 line above: round 1 evaluates 3
  // hypotheses before the fit, rounds 2-4 evaluate 0 (fit at the cursor), so
  // SA must be 3 and CUR_a1 must be 3 for all four rounds.
  let d1ok:i32=1;
  if(get32(CUR,4)!=3){ d1ok=0; }
  if(get32(res,1*4)!=3){ d1ok=0; }
  o=ffx(OB,o,"D1_ARITH_AND_STORE_OK=",d1ok);
  o=fvs(OB,o,"\n");
  o=fvs(OB,o,"D1_VERDICT cur_expected=48 tot_a1=48 ");
  let vd:i32=0;
  if(d1ok==1){ vd=1; }
  o=fvs(OB,o,"rule=D1a_hold_and_D1b_hold -> ");
  if(vd==1){ o=fvs(OB,o,"arithmetic_correct_STORE_was_the_bug\n"); }
  else { o=fvs(OB,o,"NOT_RESOLVED\n"); }

  o=fvs(OB,o,"BOUNDS_VIOLATIONS_TOTAL=");
  o=o_num(OB,o,get32(CHKV,0));
  o=fvs(OB,o,"\n");
  _zag_print(OB[0..o]);
  return 0;
}

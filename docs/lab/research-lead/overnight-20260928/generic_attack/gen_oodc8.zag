// gen_oodc8.zag - OOD world generator for C8 inquiry attacks.
// Pure Zag. All constants hardcoded by the attacker; the sealed arena
// seed is never opened. Writes turns.jsonl and answers.txt to outdir.
// World: 2 known facts, 3 unknown facts (one with a WRONG oracle
// value), ask budget 3. Usage: gen_oodc8 <outdir>

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn wline(fd:i64, s:[]u8)void { w_write(fd,s); return; }

fn main()i32 {
  let outdir:[]u8=_zag_arg(1);
  if(outdir.len==0){ emit("usage: gen_oodc8 <outdir>\n"); return 1; }
  let tfd:i64=w_open(pjoin(outdir,"turns.jsonl"));
  let afd:i64=w_open(pjoin(outdir,"answers.txt"));
  if(tfd<0 || afd<0){ emit("open failed\n"); return 1; }
  let buf:[]u8=z_alloc(512);
  let abuf:[]u8=z_alloc(64);
  let turn:i32=0;
  let at:i32=0;
  // brief
  at=app(buf,0,"{\"turn\":0,\"kind\":\"brief\"}\n");
  wline(tfd,buf[0..at]); turn=1;
  // known facts
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"f\",\"e\":\"e1\",\"a\":\"a1\",\"v\":\"v1\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"f\",\"e\":\"e2\",\"a\":\"a2\",\"v\":\"v2\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  // item 0: known fact
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":0,\"cap\":1,\"q\":\"fact|e1|a1\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"0|v1\n"); wline(afd,abuf[0..at]);
  // item 1: known fact
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":1,\"cap\":1,\"q\":\"fact|e2|a2\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"1|v2\n"); wline(afd,abuf[0..at]);
  // item 2: unknown u1, correct oracle
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":2,\"cap\":8,\"q\":\"fact|u1|b1\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"observe_result\",\"vals\":[{\"e\":\"u1\",\"a\":\"b1\",\"v\":\"w1\"}]}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  // item 3: unknown u2, WRONG oracle
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":3,\"cap\":8,\"q\":\"fact|u2|b2\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"observe_result\",\"vals\":[{\"e\":\"u2\",\"a\":\"b2\",\"v\":\"bogus\"}]}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  // item 4: unknown u3, correct oracle
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":4,\"cap\":8,\"q\":\"fact|u3|b3\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"observe_result\",\"vals\":[{\"e\":\"u3\",\"a\":\"b3\",\"v\":\"w3\"}]}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  // re-asks (last reply per item is scored)
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":2,\"cap\":8,\"q\":\"fact|u1|b1\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"2|w1\n"); wline(afd,abuf[0..at]);
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":3,\"cap\":8,\"q\":\"fact|u2|b2\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"3|bogus\n"); wline(afd,abuf[0..at]);
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":4,\"cap\":8,\"q\":\"fact|u3|b3\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"4|w3\n"); wline(afd,abuf[0..at]);
  // done
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"done\"}\n");
  wline(tfd,buf[0..at]);
  w_close(tfd); w_close(afd);
  z_free(buf); z_free(abuf);
  emit("ood_c8 world written\n");
  return 0;
}

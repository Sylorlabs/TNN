// gen_oodc4.zag - OOD world generator for C4 composition attacks.
// Pure Zag. All constants hardcoded by the attacker; the sealed arena
// seed is never opened. Writes turns.jsonl and answers.txt to outdir.
// Usage: gen_oodc4 <outdir>

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn appz(buf:[]u8,at:i32,s:[]u8)i32 {
  let n:i32=slen(s);
  let i:i32=0;
  while(i<n){buf[at+i]=s[i];i=i+1;}
  return at+n;
}
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }

fn wline(fd:i64, s:[]u8)void {
  w_write(fd,s);
  return;
}

fn main()i32 {
  let outdir:[]u8=_zag_arg(1);
  if(outdir.len==0){ emit("usage: gen_oodc4 <outdir>\n"); return 1; }
  let tfd:i64=w_open(pjoin(outdir,"turns.jsonl"));
  let afd:i64=w_open(pjoin(outdir,"answers.txt"));
  if(tfd<0 || afd<0){ emit("open failed\n"); return 1; }
  let buf:[]u8=z_alloc(512);
  let abuf:[]u8=z_alloc(64);
  let turn:i32=0;
  let at:i32=0;
  // turn 0: brief
  at=app(buf,0,"{\"turn\":0,\"kind\":\"brief\"}\n");
  wline(tfd,buf[0..at]); turn=1;
  // macro-free explicit expos
  // (A,r1,B) (B,r2,C) (C,r3,D): 3-hop chain
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"A\",\"r\":\"r1\",\"b\":\"B\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"B\",\"r\":\"r2\",\"b\":\"C\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"C\",\"r\":\"r3\",\"b\":\"D\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  // (P,r4,Q) (Q,r5,R): normal 2-hop
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"P\",\"r\":\"r4\",\"b\":\"Q\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"Q\",\"r\":\"r5\",\"b\":\"R\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  // noisy: (M,r6,N) (M,r6,X) then (M,r6,N): clean last wins
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"M\",\"r\":\"r6\",\"b\":\"N\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"M\",\"r\":\"r6\",\"b\":\"X\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"M\",\"r\":\"r6\",\"b\":\"N\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  // update semantics: (V,r1,W1) (V,r1,W2), (W2,r2,Z), (T,r1,U), (N,r4,W)
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"T\",\"r\":\"r1\",\"b\":\"U\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"V\",\"r\":\"r1\",\"b\":\"W1\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"V\",\"r\":\"r1\",\"b\":\"W2\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"W2\",\"r\":\"r2\",\"b\":\"Z\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"N\",\"r\":\"r4\",\"b\":\"W\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  // test 0: normal 2-hop -> R
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":0,\"cap\":4,\"q\":\"hop2|P|r4|r5\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"0|R\n"); wline(afd,abuf[0..at]);
  // test 1: 3-hop -> UNKNOWN (no hop3 handler; bound confirmation)
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":1,\"cap\":4,\"q\":\"hop3|A|r1|r2|r3\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"1|UNKNOWN\n"); wline(afd,abuf[0..at]);
  // test 2: noise recovery -> W
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":2,\"cap\":4,\"q\":\"hop2|M|r6|r4\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"2|W\n"); wline(afd,abuf[0..at]);
  // test 3: new relation before teaching -> UNKNOWN
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":3,\"cap\":4,\"q\":\"hop2|S|r7|r1\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"3|UNKNOWN\n"); wline(afd,abuf[0..at]);
  // teach the new relation
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"expo\",\"ev\":{\"t\":\"r\",\"a\":\"S\",\"r\":\"r7\",\"b\":\"T\"}}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  // test 4: new relation after teaching -> U
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":4,\"cap\":4,\"q\":\"hop2|S|r7|r1\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"4|U\n"); wline(afd,abuf[0..at]);
  // test 5: update semantics compose -> Z
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":5,\"cap\":4,\"q\":\"hop2|V|r1|r2\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"5|Z\n"); wline(afd,abuf[0..at]);
  // test 6: unknown start entity -> UNKNOWN, graceful
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"test\",\"item\":6,\"cap\":4,\"q\":\"hop2|J|r1|r2\"}\n");
  wline(tfd,buf[0..at]); turn=turn+1;
  at=app(abuf,0,"6|UNKNOWN\n"); wline(afd,abuf[0..at]);
  // done
  at=app(buf,0,"{\"turn\":"); at=app(buf,at,i64s(turn as i64));
  at=app(buf,at,",\"kind\":\"done\"}\n");
  wline(tfd,buf[0..at]);
  w_close(tfd); w_close(afd);
  z_free(buf); z_free(abuf);
  emit("ood_c4 world written\n");
  return 0;
}

// score_ood.zag - minimal OOD scorer for the generic-attack worlds.
// Reads replies.jsonl (contestant output) and answers.txt
// (lines: item|expected_reply). For each item keeps the LAST reply,
// compares to expected, counts "observe" requests per item.
// Usage: score_ood <replies.jsonl> <answers.txt>

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn appz(buf:[]u8,at:i32,s:[]u8)i32 {
  let n:i32=slen(s);
  let i:i32=0;
  while(i<n){buf[at+i]=s[i];i=i+1;}
  return at+n;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;} else {total=total+(n as i32);}
      if(total>=cap){go=0;}
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn jint_at(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+3);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return -999999;}
  let s:i32=p+at;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){
    v=v*10+(line[s] as i32)-48;
    s=s+1;
  }
  if(neg==1){v=0-v;}
  return v;
}

fn main()i32 {
  let rpath:[]u8=_zag_arg(1);
  let apath:[]u8=_zag_arg(2);
  if(rpath.len==0 || apath.len==0){ emit("usage: score_ood <replies> <answers>\n"); return 1; }
  // load answers: item|expected per line, max 32 items
  let abuf:[]u8=read_file(apath);
  let exp:[]u8=z_alloc(32*64);
  let nitem:i32=0;
  let pos:i32=0;
  while(pos<abuf.len){
    let eol:i32=pos;
    while(eol<abuf.len && abuf[eol]!=10){eol=eol+1;}
    let ln:[]u8=abuf[pos..eol];
    let bar:i32=findsub(ln,0,"|");
    if(bar>0 && nitem<32){
      let it:i32=0;
      let k:i32=0;
      while(k<bar){ it=it*10+(ln[k] as i32)-48; k=k+1; }
      let base:i32=nitem*64;
      exp[base]=1;
      let j:i32=bar+1;
      let m:i32=0;
      while(j<ln.len && m<62){ exp[base+2+m]=ln[j]; m=m+1; j=j+1; }
      exp[base+2+m]=0;
      if(it!=nitem){ emit("warn: answer item out of order\n"); }
      nitem=nitem+1;
    }
    pos=eol+1;
  }
  // scan replies
  let rbuf:[]u8=read_file(rpath);
  let got:[]u8=z_alloc(32*64);
  let obsc:[]u8=z_alloc(32*4);
  pos=0;
  while(pos<rbuf.len){
    let eol:i32=pos;
    while(eol<rbuf.len && rbuf[eol]!=10){eol=eol+1;}
    let ln:[]u8=rbuf[pos..eol];
    let rp:i32=findsub(ln,0,"\"reply\":\"");
    if(rp>=0){
      let it:i32=jint_at(ln,"item");
      if(it>=0 && it<32){
        let s:i32=rp+9;
        let e:i32=s;
        while(e<ln.len && ln[e]!=34){e=e+1;}
        let base:i32=it*64;
        got[base]=1;
        let m:i32=0;
        while(s+m<e && m<62){ got[base+2+m]=ln[s+m]; m=m+1; }
        got[base+2+m]=0;
        if(findsub(ln,0,"\"observe\":[{")>=0){
          let c:i32=(obsc[it*4] as i32)|((obsc[it*4+1] as i32)<<8)|((obsc[it*4+2] as i32)<<16)|((obsc[it*4+3] as i32)<<24);
          c=c+1;
          obsc[it*4]=(c as u8); obsc[it*4+1]=((c>>8) as u8);
          obsc[it*4+2]=((c>>16) as u8); obsc[it*4+3]=((c>>24) as u8);
        }
      }
    }
    pos=eol+1;
  }
  // report
  let out:[]u8=z_alloc(4096);
  let at:i32=0;
  let npass:i32=0;
  let i:i32=0;
  while(i<nitem){
    let base:i32=i*64;
    let ok:i32=0;
    if(exp[base]==1 && got[base]==1){
      let a:i32=0;
      ok=1;
      while(a<62){
        if(exp[base+2+a]!=got[base+2+a]){ok=0;}
        if(exp[base+2+a]==0 && got[base+2+a]==0){a=62;}
        a=a+1;
      }
    }
    if(ok==1){npass=npass+1;}
    let c:i32=(obsc[i*4] as i32)|((obsc[i*4+1] as i32)<<8)|((obsc[i*4+2] as i32)<<16)|((obsc[i*4+3] as i32)<<24);
    at=app(out,at,"item "); at=app(out,at,i64s(i as i64));
    at=app(out,at," exp="); at=appz(out,at,exp[base+2..base+64]);
    at=app(out,at," got="); at=appz(out,at,got[base+2..base+64]);
    if(ok==1){at=app(out,at," PASS");} else {at=app(out,at," FAIL");}
    at=app(out,at," obs="); at=app(out,at,i64s(c as i64));
    at=app(out,at,"\n");
    i=i+1;
  }
  at=app(out,at,"TOTAL "); at=app(out,at,i64s(npass as i64));
  at=app(out,at,"/"); at=app(out,at,i64s(nitem as i64)); at=app(out,at,"\n");
  emit(out[0..at]);
  z_free(abuf); z_free(rbuf); z_free(exp); z_free(got); z_free(obsc); z_free(out);
  return 0;
}

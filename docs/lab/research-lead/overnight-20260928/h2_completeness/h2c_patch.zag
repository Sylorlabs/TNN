// ir_patch.zag -- Hypothesis 2: fragment recombination (unfrozen).
//
// A FRAGMENT is a contiguous sub-chain of a MAP's relation sequence,
// identified by (map_id, start, length). Fragments are NEVER promoted as
// standalone MAPs; they exist only as triples during search. The fragment's
// structural property is seq[start..start+length-1], extracted from the
// MAP's executable graph by the same structural discipline as Composition C
// (walk the graph, read each SET cell's DEP edge to its licensing fact;
// MAP field 4 (relation label) and field 8 (subject label) are NEVER
// consulted).
//
// A goal (s, expected) supplies the constraints. ir_frag_dfs searches
// FRAGMENTS (not whole MAPs) whose sub-chain is satisfiable from the current
// value in the fact store, chaining fragments until the expected value is
// reached. The driver never names which fragments to use; discovery is by
// constraint satisfaction over a teach-order-fair candidate set: within
// each fragment-length band, candidates are dealt round-robin across MAPs
// so no MAP's fragments can be starved by enumeration order alone
// (REDTEAM2 H2-B1 repair; see ir_frag_candidates).
//
// The critical discriminator vs Composition C: the Z goal is designed so
// that NO whole MAP's full relation sequence is satisfiable, but proper
// sub-chain fragments from different MAPs chain to a solution. Whole-MAP
// chaining (frag_on=0) must FAIL where fragment recombination SUCCEEDS.
//
// On success the fragment chains are assembled, concatenated, verified,
// and promoted as MAP_Z, with LINK14 provenance edges Z -> source MAPs
// and the fragment (map,start,len) triples packed into Z's fields 12/16/32
// for white-box trace. recombine_try runs in ev_query between rebind_try
// and trial.

// ---- config: 1 = fragment recombination; 0 = whole-MAP-only control
fn frag_on()i32 { return 1; }

// ---- fragment DFS capacity: a DERIVED bound, not a fixture constant ----
// ir_frag_candidates enforces a hard per-level cap of frag_cand_max()
// entries: n starts at 0, increments only at the single write site, and
// every enumeration loop guards n<frag_cand_max(). ir_frag_dfs descends at
// most frag_depth_max() levels: L starts at 0 and descent from L requires
// L+1<frag_depth_max(). Level L therefore writes entries
// [L*frag_cand_max(), (L+1)*frag_cand_max()), disjoint across levels, so
// the whole search needs exactly frag_depth_max()*frag_cand_max() entries
// of 3 i32s. The buffer, the per-level write regions, the read indices,
// and the depth check all derive from these two constants, so no future
// change to depth or branching can silently reintroduce the overflow.
// (The old code allocated 1296 bytes = 108 entries while level 2 needs
// entries 96..143: a 432-byte heap overflow at >=13 level-2 candidates.)
fn frag_cand_max()i32 { return 48; }
fn frag_depth_max()i32 { return 3; }

// Extract MAP m's relation sequence by structural analysis.
// Returns link count, or -1 if the promoted graph is not a pure
// guard/set chain or a licensing fact is missing/dead.
fn ir_relseq(W:[]u8,m:i32,seq:[]u8,maxn:i32)i32 {
  let root:i32=ng(W,m,20);
  let cur:i32=root;
  let exp102:i32=1;
  let n:i32=0;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      cur=ng(W,cur,12);
      exp102=0;
    } else {
      if(tag!=101){return -1;}
      let fact:i32=-1;
      let e:i32=0;
      while(e<4096 && fact<0){
        if(eg(W,e,0)==cur && eg(W,e,4)==1){fact=eg(W,e,8);}
        e=e+1;
      }
      if(fact<0){return -1;}
      if(ng(W,fact,0)!=1 || ng(W,fact,36)!=1){return -1;}
      if(n>=maxn){return -1;}
      set32(seq,n*4,ng(W,fact,24));
      n=n+1;
      cur=seq_nx(W,cur);
      exp102=1;
    }
    steps=steps+1;
  }
  if(n==0){return -1;}
  return n;
}

// Fragment satisfiability: is the sub-chain seq[start..start+flen-1] of
// MAP m walkable from value cur in the fact store?
// Fills vals[0..flen], fids[0..flen-1]. Returns flen, else -1.
fn ir_frag_satisfy(W:[]u8,m:i32,start:i32,flen:i32,cur:i32,vals:[]u8,fids:[]u8)i32 {
  let seq:[]u8=z_alloc(28);
  let len:i32=ir_relseq(W,m,seq,7);
  if(len<1){return -1;}
  if(start<0 || flen<1 || start+flen>len){return -1;}
  set32(vals,0,cur);
  let i:i32=0;
  while(i<flen){
    let rq:i32=get32(seq,(start+i)*4);
    let fnd:i32=t2_lu_first(W,get32(vals,i*4),rq);
    if(fnd<0){return -1;}
    set32(vals,(i+1)*4,ng(W,fnd,28));
    set32(fids,i*4,fnd);
    i=i+1;
  }
  return flen;
}

// Collect candidate fragments satisfiable from cur, excluding used triples.
// Enumeration is BANDED ROUND-ROBIN: outer bands by decreasing fragment
// length (7..1), preserving the fewer-fragments-preferred bias exactly;
// WITHIN each band, fragments are dealt round-robin across MAPs (round r
// hands every MAP, id ascending, its r-th satisfiable length-fl fragment
// in start-ascending order) instead of draining one MAP's fragments before
// the next MAP is considered. The old flat (flen, map_id, start) order let
// MAPs enumerated early fill the per-level cap and permanently drop later
// MAPs' fragments, so teach order alone flipped SOLVE/FAIL on identical
// knowledge (REDTEAM2 H2-B1 TRUNC-LOSS KILL). Banded round-robin keeps the
// length bias but makes within-band retention teach-order-fair: within one
// band, with M MAPs holding satisfiable fragments and R cap slots left,
// every MAP keeps at least floor(R/M) of its fragments, and any MAP with
// at most that many keeps all of them, regardless of teach order. Each
// entry is 3 i32s: (map_id, start, flen). When frag_on()==0 (whole-MAP-only
// control), only (start=0, flen=len) fragments are allowed, which reduces
// exactly to Composition C's whole-MAP behavior. Returns count.
// Memory bound unchanged: n starts at 0, increments only at the single
// write site, and every loop (band, round, MAP, start) guards n<B, so
// Lemma 1 (per-level cap) and the D*B bound carry over verbatim.
fn ir_frag_candidates(W:[]u8,cur:i32,used:[]u8,nused:i32,candbuf:[]u8,base:i32)i32 {
  let n:i32=0;
  let fl:i32=7;
  while(fl>=1 && n<frag_cand_max()){
    let r:i32=0;
    let any:i32=1;
    while(any==1 && n<frag_cand_max()){
      any=0;
      let m:i32=2;
      while(m<1024 && n<frag_cand_max()){
        if(ng(W,m,36)==1 && ng(W,m,0)==20){
          let seq:[]u8=z_alloc(28);
          let len:i32=ir_relseq(W,m,seq,7);
          if(len>=fl){
            // find MAP m's r-th satisfiable length-fl fragment, start asc
            let st:i32=0;
            let seen:i32=0;
            let fst:i32=-1;
            while(st+fl<=len && fst<0){
              let allowed:i32=1;
              if(frag_on()==0){
                if(st!=0 || fl!=len){allowed=0;}
              }
              if(allowed==1){
                let u:i32=0;
                let isused:i32=0;
                while(u<nused){
                  if(get32(used,(u*3)*4)==m && get32(used,(u*3+1)*4)==st && get32(used,(u*3+2)*4)==fl){isused=1;}
                  u=u+1;
                }
                if(isused==0){
                  let ok:i32=1;
                  let cv:i32=cur;
                  let i:i32=0;
                  while(i<fl && ok==1){
                    let fnd:i32=t2_lu_first(W,cv,get32(seq,(st+i)*4));
                    if(fnd<0){ok=0;} else {cv=ng(W,fnd,28);}
                    i=i+1;
                  }
                  if(ok==1){
                    if(seen==r){fst=st;}
                    seen=seen+1;
                  }
                }
              }
              st=st+1;
            }
            if(fst>=0){
              any=1;
              set32(candbuf,((base+n)*3)*4,m);
              set32(candbuf,((base+n)*3+1)*4,fst);
              set32(candbuf,((base+n)*3+2)*4,fl);
              n=n+1;
            }
          }
        }
        m=m+1;
      }
      r=r+1;
    }
    fl=fl-1;
  }
  return n;
}

// Iterative depth-first search over fragment recombinations
// (max frag_depth_max() levels). Fills ofrag (3 i32s per fragment:
// map_id, start, flen), ovals (8 value slots per fragment), ofids (7 fact
// slots per fragment), olen (link counts). Returns fragment count, or -1.
fn ir_frag_dfs(W:[]u8,s:i32,expected:i32,ofrag:[]u8,ovals:[]u8,ofids:[]u8,olen:[]u8)i32 {
  let cand:[]u8=z_alloc(frag_depth_max()*frag_cand_max()*12);
  let ncand:[]u8=z_alloc(frag_depth_max()*4);
  let candi:[]u8=z_alloc(frag_depth_max()*4);
  let curval:[]u8=z_alloc(frag_depth_max()*4);
  set32(curval,0,s);
  set32(ncand,0,ir_frag_candidates(W,s,ofrag,0,cand,0));
  set32(candi,0,0);
  let L:i32=0;
  let done:i32=0;
  let nfrag:i32=-1;
  while(L>=0 && done==0){
    if(get32(candi,L*4)>=get32(ncand,L*4)){
      L=L-1;
      if(L>=0){set32(candi,L*4,get32(candi,L*4)+1);}
    } else {
      let ci:i32=get32(candi,L*4);
      let fm:i32=get32(cand,((L*frag_cand_max()+ci)*3)*4);
      let fs:i32=get32(cand,((L*frag_cand_max()+ci)*3+1)*4);
      let fl:i32=get32(cand,((L*frag_cand_max()+ci)*3+2)*4);
      let vbuf:[]u8=z_alloc(32);
      let fbuf:[]u8=z_alloc(28);
      let ln:i32=ir_frag_satisfy(W,fm,fs,fl,get32(curval,L*4),vbuf,fbuf);
      if(ln<1){
        set32(candi,L*4,ci+1);
      } else {
        set32(ofrag,(L*3)*4,fm);
        set32(ofrag,(L*3+1)*4,fs);
        set32(ofrag,(L*3+2)*4,fl);
        set32(olen,L*4,ln);
        let j:i32=0;
        while(j<=ln){set32(ovals,(L*8+j)*4,get32(vbuf,j*4)); j=j+1;}
        j=0;
        while(j<ln){set32(ofids,(L*7+j)*4,get32(fbuf,j*4)); j=j+1;}
        let nv:i32=get32(vbuf,ln*4);
        if(nv==expected){
          nfrag=L+1;
          done=1;
        } else {
          if(L+1>=frag_depth_max()){
            set32(candi,L*4,ci+1);
          } else {
            set32(curval,(L+1)*4,nv);
            set32(ncand,(L+1)*4,ir_frag_candidates(W,nv,ofrag,L+1,cand,(L+1)*frag_cand_max()));
            set32(candi,(L+1)*4,0);
            L=L+1;
          }
        }
      }
    }
  }
  return nfrag;
}

// Tail of a pure chain graph: the last SET cell.
fn ir_chain_tail(W:[]u8,root:i32)i32 {
  let cur:i32=root;
  let tail:i32=-1;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==102){cur=ng(W,cur,12);}
    else {
      if(tag==101){tail=cur; cur=seq_nx(W,cur);}
      else {cur=-2;}
    }
    steps=steps+1;
  }
  return tail;
}

// Fragment recombination for query (s,r,expected).
// Returns the answer or -2. On success promotes MAP_Z, writes LINK14
// provenance edges from Z to each source MAP (deduplicated), and packs
// the fragment triples into Z's fields 12/16/32 for white-box trace:
// field 12 = nfrag; field 16 = frag1 + frag2*65536; field 32 = frag3,
// where each frag = map_id*64 + start*8 + len.
fn recombine_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  if(expected<0){return -2;}
  let ofrag:[]u8=z_alloc(36);
  let ovals:[]u8=z_alloc(96);
  let ofids:[]u8=z_alloc(84);
  let olen:[]u8=z_alloc(12);
  let nfrag:i32=ir_frag_dfs(W,s,expected,ofrag,ovals,ofids,olen);
  if(nfrag<1){
    emit("RECOMB-FAIL\n");
    return -2;
  }
  let roots:[]u8=z_alloc(12);
  let g:i32=0;
  let ok:i32=1;
  while(g<nfrag && ok==1){
    let ln:i32=get32(olen,g*4);
    let vb:[]u8=z_alloc((ln+1)*4);
    let fb:[]u8=z_alloc(ln*4);
    let j:i32=0;
    while(j<=ln){set32(vb,j*4,get32(ovals,(g*8+j)*4)); j=j+1;}
    j=0;
    while(j<ln){set32(fb,j*4,get32(ofids,(g*7+j)*4)); j=j+1;}
    let rt:i32=t2_asm_chain(W,vb,ln+1,fb);
    if(rt<0){ok=0;} else {set32(roots,g*4,rt);}
    g=g+1;
  }
  if(ok==0){return -2;}
  let full:i32=get32(roots,0);
  g=1;
  while(g<nfrag){
    let tail:i32=ir_chain_tail(W,full);
    if(tail<0){return -2;}
    seq_link(W,tail,get32(roots,g*4));
    g=g+1;
  }
  let cst:[]u8=z_alloc(8);
  set32(cst,0,0); set32(cst,4,0);
  let v2:i32=t2_try_verify(W,full,s,expected,masked,cst);
  set32(st,0,get32(st,0)+get32(cst,0));
  set32(st,4,get32(st,4)+get32(cst,4));
  if(v2==-2){return -2;}
  let allf:[]u8=z_alloc(72);
  let nf:i32=0;
  g=0;
  while(g<nfrag){
    let ln2:i32=get32(olen,g*4);
    let j2:i32=0;
    while(j2<ln2){
      set32(allf,nf*4,get32(ofids,(g*7+j2)*4));
      nf=nf+1; j2=j2+1;
    }
    g=g+1;
  }
  let zm:i32=promote_graph(W,full,s,r,v2,allf,nf);
  if(zm>=0){
    g=0;
    while(g<nfrag){
      let sm:i32=get32(ofrag,(g*3)*4);
      let dup:i32=0;
      let h:i32=0;
      while(h<g){
        if(get32(ofrag,(h*3)*4)==sm){dup=1;}
        h=h+1;
      }
      if(dup==0){link_edge(W,zm,14,sm,0);}
      g=g+1;
    }
    ns(W,zm,12,nfrag);
    let f1:i32=get32(ofrag,0)*64+get32(ofrag,4)*8+get32(ofrag,8);
    let f2:i32=0;
    if(nfrag>1){f2=get32(ofrag,12)*64+get32(ofrag,16)*8+get32(ofrag,20);}
    ns(W,zm,16,f1+f2*65536);
    let f3:i32=0;
    if(nfrag>2){f3=get32(ofrag,24)*64+get32(ofrag,28)*8+get32(ofrag,32);}
    ns(W,zm,32,f3);
  }
  emit("RECOMB-FRAGS n=");
  e64(nfrag);
  g=0;
  while(g<nfrag){
    emit(" (m=");
    e64(get32(ofrag,(g*3)*4));
    emit(",s=");
    e64(get32(ofrag,(g*3+1)*4));
    emit(",l=");
    e64(get32(ofrag,(g*3+2)*4));
    emit(")");
    g=g+1;
  }
  emit("\n");
  return v2;
}

// ev_query with fragment recombination hooked between rebind_try and trial.
// Recombine stats fold into the shared rbs buffer so hg(W,16) reports
// rebind+recombine totals honestly.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried=");
  e64(get32(rbs,0));
  emit(" rejected=");
  e64(get32(rbs,4));
  emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- Hypothesis 2: fragment recombination ----
  let ca:i32=recombine_try(W,s,r,expected,masked,rbs);
  emit("RECOMB-STAT tried=");
  e64(get32(rbs,0));
  emit(" rejected=");
  e64(get32(rbs,4));
  emit("\n");
  if(ca!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ca,1,0,0); return ca;
  }
  let recent:i32=-1;
  let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

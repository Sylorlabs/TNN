// rt2_h2_driver.zag -- REDTEAM2 H2 attacks (unfrozen driver), optimized v2.
//
// Attacks the FIXED H2 fragment-recombination mechanism (h2f_patch.zag,
// byte-identical copy, never modified) with NEW adversarial worlds.
// v2 changes (performance, same attack logic): MAPs are taught via direct
// t2_trial calls instead of the full ev_query path. This produces the
// identical MAP inventory (same relseq shapes, same id order) while
// avoiding rebind's per-teaching verification assemblies, which fill the
// 1024-node workspace and trigger slow eviction scans. Main goal queries
// still go through the full ev_query (rebind -> recombine -> trial).
//
// B1 TRUNC-LOSS: 8 decoy [9,9,9,9] MAPs + 3 true [1,1] MAPs, 6-link goal
//   (31..37) whose only solution is (T1,0,2)+(T2,0,2)+(T3,0,2). At DFS
//   level 1 the 48 per-level cap keeps 48 decoy fragments (8 flen-4 +
//   16 flen-3 + 24 flen-2) and drops the true second fragment.
//   B1a teaches decoys first (true frags enumerate past the cap: expect
//   RECOMB-FAIL, ans=-2). B1c teaches trues first (identical knowledge,
//   true frags inside the cap: expect RECOMB-FRAGS n=3, ans=37).
// B2 ORDER-FORM: one goal, two genuine 2-fragment solutions: A-form
//   [1,1,1]+[2,2,2] over r1/r2 facts, B-form [3,3,3]+[4,4,4] over
//   parallel r3/r4 facts. B2a teaches A MAPs first, B2b teaches B MAPs
//   first. Same knowledge; which FORM is promoted?
// B4 DEPTH4: 12-link goal (31..43) needing 4 fragments against the
//   depth-3 cap. Expect clean RECOMB-FAIL and ans=-2 (no crash); the
//   probe shows the refused 4th-fragment candidate exists.

fn rt2_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn rt2_print_relseq(W:[]u8,m:i32)void {
  let seq:[]u8=z_alloc(28);
  let len:i32=ir_relseq(W,m,seq,7);
  emit("MAP ");
  e64(m);
  emit(" relseq=[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    e64(get32(seq,i*4));
    i=i+1;
  }
  emit("] len=");
  e64(len);
  emit("\n");
  return;
}
fn rt2_candprobe(W:[]u8,s:i32,used:[]u8,nused:i32,lbl:[]u8)void {
  let cb:[]u8=z_alloc(1728);
  let n:i32=ir_frag_candidates(W,s,used,nused,cb,0);
  emit(lbl);
  emit(" n=");
  e64(n);
  emit("\n");
  let k:i32=0;
  while(k<n && k<2){
    emit("  cand");
    e64(k);
    emit(" m=");
    e64(get32(cb,(k*3)*4));
    emit(" s=");
    e64(get32(cb,(k*3+1)*4));
    emit(" l=");
    e64(get32(cb,(k*3+2)*4));
    emit("\n");
    k=k+1;
  }
  if(n>2){
    emit("  ... cand");
    e64(n-1);
    emit(" m=");
    e64(get32(cb,((n-1)*3)*4));
    emit(" s=");
    e64(get32(cb,((n-1)*3+1)*4));
    emit(" l=");
    e64(get32(cb,((n-1)*3+2)*4));
    emit("\n");
  }
  return;
}
// Teach a k-link chain of relation rel starting at s through fresh values
// v0, v0+1, ... Returns the end value.
fn rt2_chain(W:[]u8,s:i32,rel:i32,v0:i32,k:i32)i32 {
  let prev:i32=s;
  let v:i32=v0;
  let i:i32=0;
  while(i<k){
    ev_teach(W,prev,rel,v);
    prev=v;
    v=v+1;
    i=i+1;
  }
  return prev;
}
// Teach one MAP via direct t2_trial (fast path; identical MAP inventory).
// k-link rel chain on fresh subject qs, trial query (qs,61,end).
fn rt2_teach_map(W:[]u8,qs:i32,rel:i32,v0:i32,k:i32)i32 {
  let e:i32=rt2_chain(W,qs,rel,v0,k);
  let a:i32=t2_trial(W,qs,61,e,0,0,0);
  let m:i32=rt2_find_map(W,qs,61);
  emit("teachmap qs=");
  e64(qs);
  emit(" ans=");
  e64(a);
  emit(" map=");
  e64(m);
  emit("\n");
  return m;
}

// ---- B1: truncation loss ----
fn rt2_b1(decoys_first:i32)void {
  if(decoys_first==1){
    emit("=== B1a TRUNC-ATTACK (decoys taught first) ===\n");
  } else {
    emit("=== B1c TRUNC-CONTROL (trues taught first) ===\n");
  }
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  let i:i32=31;
  while(i<37){
    ev_teach(W,i,1,i+1);
    i=i+1;
  }
  ev_teach(W,33,9,200);
  ev_teach(W,200,9,201);
  ev_teach(W,201,9,202);
  ev_teach(W,202,9,203);
  let d:i32=0;
  let t:i32=0;
  if(decoys_first==1){
    d=0;
    while(d<8){
      rt2_teach_map(W,501+d,9,5000+d*10,4);
      d=d+1;
    }
    t=0;
    while(t<3){
      rt2_teach_map(W,601+t,1,6000+t*10,2);
      t=t+1;
    }
  } else {
    t=0;
    while(t<3){
      rt2_teach_map(W,601+t,1,6000+t*10,2);
      t=t+1;
    }
    d=0;
    while(d<8){
      rt2_teach_map(W,501+d,9,5000+d*10,4);
      d=d+1;
    }
  }
  let T1:i32=rt2_find_map(W,601,61);
  let T2:i32=rt2_find_map(W,602,61);
  let T3:i32=rt2_find_map(W,603,61);
  emit("T ids=");
  e64(T1);
  emit(",");
  e64(T2);
  emit(",");
  e64(T3);
  emit(" nodealloc=");
  e64(hg(W,20));
  emit("\n");
  rt2_print_relseq(W,T1);
  let D1:i32=rt2_find_map(W,501,61);
  emit("D1 id=");
  e64(D1);
  emit("\n");
  rt2_print_relseq(W,D1);
  let ub:[]u8=z_alloc(36);
  rt2_candprobe(W,31,ub,0,"B1 level0");
  let used:[]u8=z_alloc(12);
  set32(used,0,T1);
  set32(used,4,0);
  set32(used,8,2);
  rt2_candprobe(W,33,used,1,"B1 level1");
  let z:i32=ev_query(W,31,63,37,0);
  emit("B1 Z ans=");
  e64(z);
  emit("\n");
  let zm:i32=rt2_find_map(W,31,63);
  emit("ZMAP id=");
  e64(zm);
  emit("\n");
  if(zm>=0){
    rt2_print_relseq(W,zm);
  }
  if(decoys_first==1){
    if(z==-2){
      emit("B1a TRUNC-LOSS-KILL (genuine solution truncated away)\n");
    } else {
      emit("B1a UNEXPECTED-SOLVE\n");
    }
  } else {
    if(z==37){
      emit("B1c CONTROL-SOLVE-OK\n");
    } else {
      emit("B1c CONTROL-FAIL (bad: control must solve)\n");
    }
  }
  return;
}

// ---- B2: teach-order decides the promoted form ----
fn rt2_b2(afirst:i32)void {
  if(afirst==1){
    emit("=== B2a ORDER (A MAPs taught first) ===\n");
  } else {
    emit("=== B2b ORDER (B MAPs taught first) ===\n");
  }
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  ev_teach(W,31,1,32);
  ev_teach(W,32,1,33);
  ev_teach(W,33,1,34);
  ev_teach(W,34,2,35);
  ev_teach(W,35,2,36);
  ev_teach(W,36,2,37);
  ev_teach(W,31,3,32);
  ev_teach(W,32,3,33);
  ev_teach(W,33,3,34);
  ev_teach(W,34,4,35);
  ev_teach(W,35,4,36);
  ev_teach(W,36,4,37);
  if(afirst==1){
    rt2_teach_map(W,701,1,7100,3);
    rt2_teach_map(W,702,2,7200,3);
    rt2_teach_map(W,703,3,7300,3);
    rt2_teach_map(W,704,4,7400,3);
  } else {
    rt2_teach_map(W,703,3,7300,3);
    rt2_teach_map(W,704,4,7400,3);
    rt2_teach_map(W,701,1,7100,3);
    rt2_teach_map(W,702,2,7200,3);
  }
  let ub:[]u8=z_alloc(36);
  rt2_candprobe(W,31,ub,0,"B2 level0");
  let z:i32=ev_query(W,31,63,37,0);
  emit("B2 Z ans=");
  e64(z);
  emit("\n");
  let zm:i32=rt2_find_map(W,31,63);
  emit("ZMAP id=");
  e64(zm);
  emit("\n");
  if(zm>=0){
    rt2_print_relseq(W,zm);
  }
  return;
}

// ---- B4: depth-4 goal against the depth-3 cap ----
fn rt2_b4()void {
  emit("=== B4 DEPTH4 (goal needs 4 fragments, cap is 3) ===\n");
  let W:[]u8=z_alloc(110656);
  tnn2_init(W);
  let t:i32=0;
  while(t<4){
    rt2_teach_map(W,801+t,1,8100+t*10,3);
    t=t+1;
  }
  let i:i32=31;
  while(i<43){
    ev_teach(W,i,1,i+1);
    i=i+1;
  }
  let z:i32=ev_query(W,31,63,43,0);
  emit("B4 Z ans=");
  e64(z);
  emit(" (expect -2: depth cap 3)\n");
  let T1:i32=rt2_find_map(W,801,61);
  let T2:i32=rt2_find_map(W,802,61);
  let used:[]u8=z_alloc(24);
  set32(used,0,T1);
  set32(used,4,0);
  set32(used,8,3);
  set32(used,12,T2);
  set32(used,16,0);
  set32(used,20,3);
  rt2_candprobe(W,37,used,2,"B4 level2");
  if(z==-2){
    emit("B4 DEPTH-BOUND-OK (clean RECOMB-FAIL, no crash)\n");
  } else {
    emit("B4 UNEXPECTED-SOLVE\n");
  }
  return;
}

fn main()i32 {
  emit("RT2-H2-START\n");
  emit("frag_on=");
  e64(frag_on());
  emit("\n");
  rt2_b1(1);
  rt2_b1(0);
  rt2_b2(1);
  rt2_b2(0);
  rt2_b4();
  emit("RT2-H2-END\n");
  return 0;
}

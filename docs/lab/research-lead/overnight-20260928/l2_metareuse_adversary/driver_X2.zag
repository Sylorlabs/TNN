// driver_X2.zag -- falsification build X2 driver
// (greedy first-match fold discovery).
// Predicted: QX1 fails all 6 ops gracefully
// (XK1' boundary). Bars XK1',XK2' in-Zag; XK3'-XK5'
// via shell.

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=24; fs[0]=0;
  m_teach(st,rs,1,fs,1,10,11,2,2);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=1; fs[1]=2; fs[2]=3; fs[3]=4; fs[4]=5;
  m_teach(st,rs,5,fs,5,20,25,1,1);
  rs[0]=24; rs[1]=24; fs[0]=7; fs[1]=8;
  m_teach(st,rs,2,fs,2,30,32,2,2);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
fn d_runq(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32, tag:[]u8, rs:[]u8, ro:i32)void {
  ex_p(ob,atp,"Q ");
  ex_p(ob,atp,tag);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(rs,ro,st[9] as i32);
  set32(rs,ro+4,get32(st,1344));
  set32(rs,ro+8,get32(st,1376));
  set32(rs,ro+12,get32(st,1380));
  set32(rs,ro+16,get32(st,1384));
  set32(rs,ro+20,get32(st,1368));
  set32(rs,ro+24,get32(st,1336));
  set32(rs,ro+28,get32(st,1340));
  set32(rs,ro+32,st[12] as i32);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}
fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL (mask 63) ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  let rF:[]u8=z_alloc(256);
  d_runq(stF,ob,atp,20,25,51,1,1,63,"QA",rF,0);
  d_runq(stF,ob,atp,30,32,-1,2,2,63,"QB",rF,36);
  d_runq(stF,ob,atp,57,20,57,1,1,63,"QX2",rF,72);
  let f_qa_via:i32=get32(rF,0);
  let f_qb_via:i32=get32(rF,36);
  let f_qx_val:i32=get32(rF,76);
  let f_qx_op:i32=get32(rF,80);
  let f_qx_tries:i32=get32(rF,84);
  let f_qx_phit:i32=get32(rF,92);
  let f_qx_as:i32=get32(rF,96);
  let f_qx_ae:i32=get32(rF,100);
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let mdlive:i32=stF[368+0*40+1] as i32;
  ex_p(ob,atp,"ARM-FULL-END as=");
  ex_pi(ob,atp,f_qx_as);
  ex_p(ob,atp," ae="); ex_pi(ob,atp,f_qx_ae);
  ex_p(ob,atp," t16="); ex_pi(ob,atp,t16F);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othF);
  ex_pnl(ob,atp);

  // ---------- ARM NOREUSE (mask 0) ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  ex_p(ob,atp,"ARM NOREUSE\n");
  let rN:[]u8=z_alloc(256);
  d_runq(stN,ob,atp,20,25,51,1,1,0,"QA",rN,0);
  d_runq(stN,ob,atp,30,32,-1,2,2,0,"QB",rN,36);
  d_runq(stN,ob,atp,57,20,57,1,1,0,"QX2",rN,72);
  let n_qx_val:i32=get32(rN,76);
  let n_t16:i32=e_count(stN,16);
  let othN:i32=ex_eoth(stN);
  ex_p(ob,atp,"ARM-NOREUSE-END t16=");
  ex_pi(ob,atp,n_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othN);
  ex_pnl(ob,atp);

  // ---------- bars XK1', XK2' ----------
  let boundary:i32=0;
  let okb:i32=1;
  if(f_qx_val!=-2){okb=0;}
  if(f_qx_tries!=6){okb=0;}
  if(f_qx_op!=-1){okb=0;}
  if(t16F!=0){okb=0;}
  if(othF!=0){okb=0;}
  if(okb==1){boundary=1;}
  let solved:i32=0;
  if(f_qx_val!=-2){solved=1;}
  let xk2:i32=0;
  let ok2:i32=1;
  if(f_qa_via!=1){ok2=0;}
  if(f_qb_via!=2){ok2=0;}
  if(n_qx_val!=-2){ok2=0;}
  if(n_t16!=0){ok2=0;}
  if(ok2==1){xk2=1;}

  // ---------- falsifiers (wave-level defects only) ----------
  let ff:i32=0;
  if(othF!=0){ex_p(ob,atp,"FALSIFIER F-X-EDGE-NEW FULL\n");ff=1;}
  if(othN!=0){ex_p(ob,atp,"FALSIFIER F-X-EDGE-NEW NOREUSE\n");ff=1;}
  if(t16F!=0){ex_p(ob,atp,"FALSIFIER F-X-T16-NONZERO\n");ff=1;}
  if(f_qx_val==-2){
    if(f_qx_tries!=6){ex_p(ob,atp,"FALSIFIER F-X-TRIES-SHORT\n");ff=1;}
  }
  if(mdlive!=1){ex_p(ob,atp,"FALSIFIER F-X-DISTR-SURVIVES\n");ff=1;}
  ex_p(ob,atp,"XK1-BOUNDARY ");
  ex_pi(ob,atp,boundary);
  ex_p(ob,atp," XK1-SOLVED ");
  ex_pi(ob,atp,solved);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"BARS ");
  d_bar(ob,atp,"xk2",xk2);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"ADV-X2-END\n");

  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// relseq walk); Q4B value fact f15 (25,4,57) enabling
// the value-mapping inverse 57->20.

fn w_teach_all(st:[]u8)void {
  f_teach(st,10,24,11);
  f_teach(st,20,21,21);
  f_teach(st,21,22,22);
  f_teach(st,22,23,23);

// driver_B.zag -- adversary build B driver (op 4 INVERT, both forms).
// The driver never names an operator, source pair, binding,
// pattern, or form. Kill bars K1'-K5', K8' per PREREG
// section 6a as amended (Z ids 3,4: three taught MAPs).

fn d_teach_maps(st:[]u8)void {
  let rs:[]u8=z_alloc(12);
  let fs:[]u8=z_alloc(12);
  rs[0]=24; fs[0]=0;
  m_teach(st,rs,1,fs,1,10,11,2,2);
  rs[0]=21; rs[1]=22; rs[2]=23; rs[3]=22; rs[4]=23;
  fs[0]=1; fs[1]=2; fs[2]=3; fs[3]=4; fs[4]=5;
  m_teach(st,rs,5,fs,5,20,25,1,1);
  rs[0]=24; rs[1]=24; fs[0]=7; fs[1]=8;
  m_teach(st,rs,2,fs,2,30,32,2,2);
  return;
}
fn d_teach_all(st:[]u8)void {
  w_teach_all(st);
  d_teach_maps(st);
  return;
}
// Z4a (id 3): 3(1,5,60,65,1,1,23,22,23,2,4,0)
// rels[23,22,23,22,21] facts[9,10,11,12,13]
fn d_check_z4a(st:[]u8)i32 {
  let o:i32=368+3*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=5){ok=0;}
  if((st[o+2] as i32)!=60){ok=0;}
  if((st[o+3] as i32)!=65){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=23){ok=0;}
  if((st[o+35] as i32)!=22){ok=0;}
  if((st[o+36] as i32)!=23){ok=0;}
  if((st[o+37] as i32)!=2){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=0){ok=0;}
  let er:[]u8=z_alloc(6);
  er[0]=23; er[1]=22; er[2]=23; er[3]=22; er[4]=21;
  let ef:[]u8=z_alloc(6);
  ef[0]=9; ef[1]=10; ef[2]=11; ef[3]=12; ef[4]=13;
  let k:i32=0;
  while(k<5){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
// Z4b (id 4): 4(1,6,57,20,1,1,4,23,22,2,4,1)
// rels[4,23,22,23,22,21] facts[15,5,4,3,2,1]
fn d_check_z4b(st:[]u8)i32 {
  let o:i32=368+4*40;
  let ok:i32=1;
  if((st[o+1] as i32)!=1){ok=0;}
  if((st[o+4] as i32)!=6){ok=0;}
  if((st[o+2] as i32)!=57){ok=0;}
  if((st[o+3] as i32)!=20){ok=0;}
  if((st[o+32] as i32)!=1){ok=0;}
  if((st[o+33] as i32)!=1){ok=0;}
  if((st[o+34] as i32)!=4){ok=0;}
  if((st[o+35] as i32)!=23){ok=0;}
  if((st[o+36] as i32)!=22){ok=0;}
  if((st[o+37] as i32)!=2){ok=0;}
  if((st[o+38] as i32)!=4){ok=0;}
  if((st[o+39] as i32)!=1){ok=0;}
  let er:[]u8=z_alloc(7);
  er[0]=4; er[1]=23; er[2]=22; er[3]=23; er[4]=22; er[5]=21;
  let ef:[]u8=z_alloc(7);
  ef[0]=15; ef[1]=5; ef[2]=4; ef[3]=3; ef[4]=2; ef[5]=1;
  let k:i32=0;
  while(k<6){
    if((st[o+8+k] as i32)!=(er[k] as i32)){ok=0;}
    if((st[o+20+k] as i32)!=(ef[k] as i32)){ok=0;}
    k=k+1;
  }
  return ok;
}
fn d_runq(st:[]u8, ob:[]u8, atp:[]u8, s:i32, t:i32, v:i32, cap:i32, dom:i32, mask:i32, tag:[]u8, rs:[]u8, ro:i32)void {
  ex_p(ob,atp,"Q ");
  ex_p(ob,atp,tag);
  ex_pnl(ob,atp);
  ex_query(st,ob,atp,s,t,v,cap,dom,mask);
  set32(rs,ro,st[9] as i32);
  set32(rs,ro+4,get32(st,1344));
  set32(rs,ro+8,get32(st,1376));
  set32(rs,ro+12,get32(st,1380));
  set32(rs,ro+16,get32(st,1384));
  set32(rs,ro+20,get32(st,1368));
  set32(rs,ro+24,get32(st,1336));
  set32(rs,ro+28,get32(st,1340));
  set32(rs,ro+32,st[12] as i32);
  return;
}
fn d_bar(ob:[]u8, atp:[]u8, nm:[]u8, v:i32)void {
  ex_p(ob,atp,nm);
  ex_p(ob,atp,"=");
  ex_pi(ob,atp,v);
  ex_p(ob,atp," ");
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let atp:[]u8=z_alloc(8);

  // ---------- ARM FULL (mask 63) ----------
  let stF:[]u8=z_alloc(8192);
  d_teach_all(stF);
  ex_p(ob,atp,"ARM FULL\n");
  let rF:[]u8=z_alloc(256);
  d_runq(stF,ob,atp,20,25,51,1,1,63,"QA",rF,0);
  d_runq(stF,ob,atp,30,32,-1,2,2,63,"QB",rF,36);
  d_runq(stF,ob,atp,60,65,56,1,1,63,"Q4A",rF,72);
  d_runq(stF,ob,atp,57,20,57,1,1,63,"Q4B",rF,108);
  d_runq(stF,ob,atp,60,65,56,1,1,63,"Q4A-B",rF,144);
  d_runq(stF,ob,atp,57,20,57,1,1,63,"Q4B-B",rF,180);
  let f_qa_via:i32=get32(rF,0);
  let f_qb_via:i32=get32(rF,36);
  let f_q4a_via:i32=get32(rF,72);
  let f_q4a_val:i32=get32(rF,76);
  let f_q4a_op:i32=get32(rF,80);
  let f_q4a_tries:i32=get32(rF,84);
  let f_q4a_dec:i32=get32(rF,88);
  let f_q4a_phit:i32=get32(rF,92);
  let f_q4a_as:i32=get32(rF,96);
  let f_q4a_ae:i32=get32(rF,100);
  let f_q4b_via:i32=get32(rF,108);
  let f_q4b_val:i32=get32(rF,112);
  let f_q4b_op:i32=get32(rF,116);
  let f_q4b_tries:i32=get32(rF,120);
  let f_q4b_dec:i32=get32(rF,124);
  let f_q4b_phit:i32=get32(rF,128);
  let f_q4b_as:i32=get32(rF,132);
  let f_q4b_ae:i32=get32(rF,136);
  let f_b4a_via:i32=get32(rF,144);
  let f_b4a_val:i32=get32(rF,148);
  let f_b4a_en:i32=get32(rF,176);
  let f_b4b_via:i32=get32(rF,180);
  let f_b4b_val:i32=get32(rF,184);
  let f_b4b_en:i32=get32(rF,212);
  let t16F:i32=e_count(stF,16);
  let othF:i32=ex_eoth(stF);
  let e31:i32=e_has(stF,3,1,16);
  let e41:i32=e_has(stF,4,1,16);
  let e14_3:i32=e_has_to(stF,3,14);
  let e14_4:i32=e_has_to(stF,4,14);
  let mdlive:i32=stF[368+0*40+1] as i32;
  let z4a:i32=d_check_z4a(stF);
  let z4b:i32=d_check_z4b(stF);
  ex_p(ob,atp,"ARM-FULL-END as=");
  ex_pi(ob,atp,f_q4a_as); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_q4b_as);
  ex_p(ob,atp," ae=");
  ex_pi(ob,atp,f_q4a_ae); ex_p(ob,atp,"/"); ex_pi(ob,atp,f_q4b_ae);
  ex_p(ob,atp," t16="); ex_pi(ob,atp,t16F);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othF);
  ex_pnl(ob,atp);

  // ---------- ARM ABLATE-INV (mask 55) ----------
  let stV:[]u8=z_alloc(8192);
  d_teach_all(stV);
  ex_p(ob,atp,"ARM ABLATE-INV\n");
  let rV:[]u8=z_alloc(256);
  d_runq(stV,ob,atp,20,25,51,1,1,55,"QA",rV,0);
  d_runq(stV,ob,atp,30,32,-1,2,2,55,"QB",rV,36);
  d_runq(stV,ob,atp,60,65,56,1,1,55,"Q4A",rV,72);
  d_runq(stV,ob,atp,57,20,57,1,1,55,"Q4B",rV,108);
  let v_q4a_val:i32=get32(rV,76);
  let v_q4b_val:i32=get32(rV,112);
  let v_t16:i32=e_count(stV,16);
  let othV:i32=ex_eoth(stV);
  ex_p(ob,atp,"ARM-ABLATEV-END t16=");
  ex_pi(ob,atp,v_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othV);
  ex_pnl(ob,atp);

  // ---------- ARM NOREUSE (mask 0) ----------
  let stN:[]u8=z_alloc(8192);
  d_teach_all(stN);
  ex_p(ob,atp,"ARM NOREUSE\n");
  let rN:[]u8=z_alloc(256);
  d_runq(stN,ob,atp,20,25,51,1,1,0,"QA",rN,0);
  d_runq(stN,ob,atp,30,32,-1,2,2,0,"QB",rN,36);
  d_runq(stN,ob,atp,60,65,56,1,1,0,"Q4A",rN,72);
  d_runq(stN,ob,atp,57,20,57,1,1,0,"Q4B",rN,108);
  let n_q4a_val:i32=get32(rN,76);
  let n_q4b_val:i32=get32(rN,112);
  let n_t16:i32=e_count(stN,16);
  let othN:i32=ex_eoth(stN);
  ex_p(ob,atp,"ARM-NOREUSE-END t16=");
  ex_pi(ob,atp,n_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othN);
  ex_pnl(ob,atp);

  // ---------- ARM FRESH (facts only) ----------
  let stR:[]u8=z_alloc(8192);
  w_teach_all(stR);
  ex_p(ob,atp,"ARM FRESH\n");
  let rR:[]u8=z_alloc(256);
  d_runq(stR,ob,atp,60,65,56,1,1,63,"Q4A",rR,72);
  d_runq(stR,ob,atp,57,20,57,1,1,63,"Q4B",rR,108);
  let r_q4a_val:i32=get32(rR,76);
  let r_q4b_val:i32=get32(rR,112);
  let r_t16:i32=e_count(stR,16);
  let othR:i32=ex_eoth(stR);
  ex_p(ob,atp,"ARM-FRESH-END t16=");
  ex_pi(ob,atp,r_t16);
  ex_p(ob,atp," oth="); ex_pi(ob,atp,othR);
  ex_pnl(ob,atp);

  // ---------- kill bars ----------
  let k1:i32=0;
  let ok1:i32=1;
  if(f_qa_via!=1){ok1=0;}
  if(f_qb_via!=2){ok1=0;}
  if(ok1==1){k1=1;}
  let k2:i32=0;
  let ok2:i32=1;
  if(f_q4a_phit!=0){ok2=0;}
  if(f_q4b_phit!=0){ok2=0;}
  if(n_q4a_val!=-2){ok2=0;}
  if(n_q4b_val!=-2){ok2=0;}
  if(n_t16!=0){ok2=0;}
  if(ok2==1){k2=1;}
  let k3:i32=0;
  let ok3:i32=1;
  if(f_q4a_op!=4){ok3=0;}
  if(f_q4a_tries!=4){ok3=0;}
  if(f_q4a_dec!=1){ok3=0;}
  if(f_q4b_op!=4){ok3=0;}
  if(f_q4b_tries!=4){ok3=0;}
  if(f_q4b_dec!=1){ok3=0;}
  if(ok3==1){k3=1;}
  let k4:i32=0;
  let ok4:i32=1;
  if(f_q4a_via!=3){ok4=0;}
  if(f_q4a_val!=56){ok4=0;}
  if(z4a!=1){ok4=0;}
  if(f_q4b_via!=4){ok4=0;}
  if(f_q4b_val!=57){ok4=0;}
  if(z4b!=1){ok4=0;}
  if(f_b4a_via!=3){ok4=0;}
  if(f_b4a_val!=56){ok4=0;}
  if(f_b4a_en!=0){ok4=0;}
  if(f_b4b_via!=4){ok4=0;}
  if(f_b4b_val!=57){ok4=0;}
  if(f_b4b_en!=0){ok4=0;}
  if(ok4==1){k4=1;}
  let k5:i32=0;
  let ok5:i32=1;
  if(v_q4a_val!=-2){ok5=0;}
  if(v_q4b_val!=-2){ok5=0;}
  if(v_t16!=0){ok5=0;}
  if(ok5==1){k5=1;}
  let k8:i32=0;
  let ok8:i32=1;
  if(t16F!=2){ok8=0;}
  if(e31!=1){ok8=0;}
  if(e41!=1){ok8=0;}
  if(e14_3!=1){ok8=0;}
  if(e14_4!=1){ok8=0;}
  if(mdlive!=1){ok8=0;}
  if(othF!=0){ok8=0;}
  if(ok8==1){k8=1;}

  // ---------- falsifiers ----------
  let ff:i32=0;
  if(othF!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FULL\n");ff=1;}
  if(othV!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW ABLATEV\n");ff=1;}
  if(othN!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW NOREUSE\n");ff=1;}
  if(othR!=0){ex_p(ob,atp,"FALSIFIER F-EDGE-NEW FRESH\n");ff=1;}
  if(f_q4a_via!=3){ex_p(ob,atp,"FALSIFIER F-NO-GROUND-Q4A\n");ff=1;}
  if(f_q4b_via!=4){ex_p(ob,atp,"FALSIFIER F-NO-GROUND-Q4B\n");ff=1;}
  if(z4a!=1){ex_p(ob,atp,"FALSIFIER F-WRONG-Z4A\n");ff=1;}
  if(z4b!=1){ex_p(ob,atp,"FALSIFIER F-WRONG-Z4B\n");ff=1;}
  if(f_q4a_phit!=0){ex_p(ob,atp,"FALSIFIER F-PIPE-HIT-Q4A\n");ff=1;}
  if(f_q4b_phit!=0){ex_p(ob,atp,"FALSIFIER F-PIPE-HIT-Q4B\n");ff=1;}
  if(n_q4a_val!=-2){ex_p(ob,atp,"FALSIFIER F-NOREUSE-Q4A\n");ff=1;}
  if(n_q4b_val!=-2){ex_p(ob,atp,"FALSIFIER F-NOREUSE-Q4B\n");ff=1;}
  if(v_q4a_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLATEV-Q4A\n");ff=1;}
  if(v_q4b_val!=-2){ex_p(ob,atp,"FALSIFIER F-ABLATEV-Q4B\n");ff=1;}
  if(v_t16!=0){ex_p(ob,atp,"FALSIFIER F-ABLATEV-T16\n");ff=1;}
  if(f_b4a_en!=0){ex_p(ob,atp,"FALSIFIER F-RE-Q4A-ENTERED\n");ff=1;}
  if(f_b4a_via!=3){ex_p(ob,atp,"FALSIFIER F-RE-Q4A-VIA\n");ff=1;}
  if(f_b4a_val!=56){ex_p(ob,atp,"FALSIFIER F-RE-Q4A-VAL\n");ff=1;}
  if(f_b4b_en!=0){ex_p(ob,atp,"FALSIFIER F-RE-Q4B-ENTERED\n");ff=1;}
  if(f_b4b_via!=4){ex_p(ob,atp,"FALSIFIER F-RE-Q4B-VIA\n");ff=1;}
  if(f_b4b_val!=57){ex_p(ob,atp,"FALSIFIER F-RE-Q4B-VAL\n");ff=1;}
  if(f_q4a_op!=4){ex_p(ob,atp,"FALSIFIER F-OP-Q4A\n");ff=1;}
  if(f_q4b_op!=4){ex_p(ob,atp,"FALSIFIER F-OP-Q4B\n");ff=1;}
  if(f_q4a_tries!=4){ex_p(ob,atp,"FALSIFIER F-TRIES-Q4A\n");ff=1;}
  if(f_q4b_tries!=4){ex_p(ob,atp,"FALSIFIER F-TRIES-Q4B\n");ff=1;}
  if(t16F!=2){ex_p(ob,atp,"FALSIFIER F-T16-COUNT\n");ff=1;}
  if(e31!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-31\n");ff=1;}
  if(e41!=1){ex_p(ob,atp,"FALSIFIER F-NO-T16-41\n");ff=1;}
  if(e14_3!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-3\n");ff=1;}
  if(e14_4!=1){ex_p(ob,atp,"FALSIFIER F-NO-LINK14-4\n");ff=1;}
  if(mdlive!=1){ex_p(ob,atp,"FALSIFIER F-DISTR-SURVIVES\n");ff=1;}
  if(r_q4a_val!=-2){ex_p(ob,atp,"FALSIFIER F-FRESH-Q4A\n");ff=1;}
  if(r_q4b_val!=-2){ex_p(ob,atp,"FALSIFIER F-FRESH-Q4B\n");ff=1;}
  ex_p(ob,atp,"BARS ");
  d_bar(ob,atp,"k1",k1);
  d_bar(ob,atp,"k2",k2);
  d_bar(ob,atp,"k3",k3);
  d_bar(ob,atp,"k4",k4);
  d_bar(ob,atp,"k5",k5);
  d_bar(ob,atp,"k8",k8);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"FALSIFIERS ");
  ex_pi(ob,atp,ff);
  ex_pnl(ob,atp);
  ex_p(ob,atp,"ADV-B-END\n");

  let at:i32=get32(atp,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

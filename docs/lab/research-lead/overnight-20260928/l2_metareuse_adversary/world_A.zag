// world_A.zag -- adversary sealed world, build A.
// Fresh family for ops 1-3 (COMBINE, SUBSTITUTE, TRUNCATE).
// Rel ids: V=4, E=21, F1=22, F2=23, P1=24, SE=25,
// G1=26, G2=27. 24 facts (fid = teach order).
// mD' f0; mA' f1-f6 (20->25); mB' f7-f8;
// Q1 region f9-f16 (40->47); Q2 region f17-f22 (50->55);
// Q3 value fact f23 (23,4,55).

fn w_teach_all(st:[]u8)void {
  f_teach(st,10,24,11);
  f_teach(st,20,21,21);
  f_teach(st,21,22,22);
  f_teach(st,22,23,23);
  f_teach(st,23,22,24);
  f_teach(st,24,23,25);
  f_teach(st,25,4,51);
  f_teach(st,30,24,31);
  f_teach(st,31,24,32);
  f_teach(st,40,24,41);
  f_teach(st,41,24,42);
  f_teach(st,42,21,43);
  f_teach(st,43,22,44);
  f_teach(st,44,23,45);
  f_teach(st,45,22,46);
  f_teach(st,46,23,47);
  f_teach(st,47,4,53);
  f_teach(st,50,25,51);
  f_teach(st,51,26,52);
  f_teach(st,52,27,53);
  f_teach(st,53,26,54);
  f_teach(st,54,27,55);
  f_teach(st,55,4,54);
  f_teach(st,23,4,55);
  return;
}

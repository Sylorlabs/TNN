// cx_patch.zag -- Composition Hypothesis A: goal-conditioned graph
// composition from MAP contracts (unfrozen).
//
// A MAP's CONTRACT is derived from its structure, never researcher-labeled:
// a chain MAP's contract is its plen (value-chain length from rb_chain_plen).
//
// compose_try is a general pipeline stage (like rebind_try): on a query where
// exact-shape reuse fails, it searches pairs of contracted MAPs (m1, m2) such
// that m1's contract applies to the query subject (a gathered path of matching
// plen), m2's contract applies to m1's output value, and the chained execution
// verifies against the goal. On success it builds ONE composite executable
// graph (m1's rebound chain SEQ-linked to m2's rebound chain), promotes it as
// a new MAP, and writes persistent type-1 DEP edges from the composite to the
// helper MAPs: the composite structurally references what built it.
//
// There is no COMPOSE_MODE, no task label, no "combine X and Y" hint. The
// pairing is discovered from contract applicability to the actual data and
// arbitrated by execution verification. Deterministic: MAPs and paths are
// scanned in id order; the first verifying pair wins.

// Contract of MAP m: plen of its chain graph, or -1 if not a chain MAP.
// Derived purely from MAP structure.
fn cx_contract(W:[]u8,m:i32)i32 {
  if(ng(W,m,0)!=20){return -1;}
  if(ng(W,m,36)!=1){return -1;}
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  if(p<2){return -1;}
  return p;
}
// Tail set-cell of a chain graph root (for SEQ concatenation).
fn cx_chain_tail(W:[]u8,root:i32)i32 {
  let cur:i32=root; let steps:i32=0;
  while(cur>=0 && steps<64){
    if(ng(W,cur,0)!=102){return -1;}
    let st:i32=ng(W,cur,12);
    if(st<0 || ng(W,st,0)!=101){return -1;}
    let nx:i32=seq_nx(W,st);
    if(nx<0){return st;}
    cur=nx; steps=steps+1;
  }
  return -1;
}
// Apply MAP m's contract to subject s via the gathered path at path_base
// (path length must equal m's plen). Builds the rebound chain, executes it.
// Returns the output value, or -999999/-2 on failure. oroot[0] gets the
// rebound graph root; ofacts[0..plen-2] get the licensing fact ids.
fn cx_apply(W:[]u8,m:i32,s:i32,paths:[]u8,path_base:i32,plen:i32,oroot:[]u8,ofacts:[]u8)i32 {
  let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
  let j:i32=0;
  while(j<plen){set32(v,j*4,get32(paths,path_base+4+j*4)); j=j+1;}
  j=0;
  while(j<plen-1){
    set32(f,j*4,get32(paths,path_base+24+j*4));
    set32(ofacts,j*4,get32(paths,path_base+24+j*4));
    j=j+1;
  }
  let root:i32=t2_asm_chain(W,v,plen,f);
  if(root<0){return -999999;}
  set32(oroot,0,root);
  let ans:i32=t2_exec(W,root,s);
  return ans;
}
// Goal-conditioned composition search. st[0]=pairs tried, st[1]=rejected.
// Returns the verified answer or -2.
fn compose_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  let paths1:[]u8=z_alloc(4608);
  let np1:i32=t2_gather(W,s,paths1);
  let m1:i32=2;
  while(m1<1024){
    let p1:i32=cx_contract(W,m1);
    if(p1>=2){
      let i:i32=0;
      while(i<np1){
        let base:i32=i*48;
        if(get32(paths1,base)==p1){
          let oroot:[]u8=z_alloc(4); let of1:[]u8=z_alloc(16);
          let v1:i32=cx_apply(W,m1,s,paths1,base,p1,oroot,of1);
          if(v1!=-999999 && v1!=-2){
            let g1:i32=get32(oroot,0);
            let paths2:[]u8=z_alloc(4608);
            let np2:i32=t2_gather(W,v1,paths2);
            let m2:i32=2;
            while(m2<1024){
              let p2:i32=cx_contract(W,m2);
              if(p2>=2){
                let k:i32=0;
                while(k<np2){
                  let b2:i32=k*48;
                  if(get32(paths2,b2)==p2){
                    set32(st,0,get32(st,0)+1);
                    let oroot2:[]u8=z_alloc(4); let of2:[]u8=z_alloc(16);
                    let v2:i32=cx_apply(W,m2,v1,paths2,b2,p2,oroot2,of2);
                    let ok:i32=0;
                    if(v2!=-999999 && v2!=-2){
                      if(masked==1){ok=1;}
                      else {if(expected==-2 || v2==expected){ok=1;}}
                    }
                    if(ok==1){
                      let g2:i32=get32(oroot2,0);
                      let tail:i32=cx_chain_tail(W,g1);
                      if(tail>=0){
                        seq_link(W,tail,g2);
                        let vc:i32=t2_exec(W,g1,s);
                        if(vc==v2){
                          let fall:[]u8=z_alloc(64);
                          let nf:i32=0; let q:i32=0;
                          while(q<p1-1){set32(fall,nf*4,get32(of1,q*4)); nf=nf+1; q=q+1;}
                          q=0;
                          while(q<p2-1){set32(fall,nf*4,get32(of2,q*4)); nf=nf+1; q=q+1;}
                          let zm:i32=promote_graph(W,g1,s,r,v2,fall,nf);
                          if(zm>=0){
                            let _a:i32=link_edge(W,zm,1,m1,0);
                            let _b:i32=link_edge(W,zm,1,m2,0);
                            emit("CX-STAT pairs_tried=");
                            e64(get32(st,0));
                            emit(" pairs_rejected=");
                            e64(get32(st,4));
                            emit(" plen=");
                            e64(p1+p2-1);
                            emit("\n");
                            return v2;
                          }
                        }
                      }
                    }
                    set32(st,4,get32(st,4)+1);
                  }
                  k=k+1;
                }
              }
              m2=m2+1;
            }
          }
        }
        i=i+1;
      }
    }
    m1=m1+1;
  }
  return -2;
}
// ev_query: activate -> rebind (exact-shape reuse) -> compose (contract
// chaining) -> trial (blind) -> bootstrap. Composition is a general reuse
// stage, not a mode: it fires on any miss where contracted MAPs chain.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    let _l:i32=link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- structural rebinding: retrieve learned shapes before composing
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- goal-conditioned composition: chain contracted MAPs
  let cxs:[]u8=z_alloc(8); set32(cxs,0,0); set32(cxs,4,0);
  let ca:i32=compose_try(W,s,r,expected,masked,cxs);
  if(ca!=-2){
    hs(W,16,1000000+get32(cxs,0)*1024+get32(cxs,4));
    log_ev(W,2,s,r,ca,1,0,0); return ca;
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){let _l2:i32=link_edge(W,recent,8,recent,0);}
  // trial loop (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

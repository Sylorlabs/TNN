// cx_driver.zag -- Composition Hypothesis A experiment driver.
// Approach A: goal-conditioned graph composition from MAP contracts.
//
// Suite A (beyond trial): X plen-3 (r1) + Y plen-4 (r2) -> Zα plen-6.
//   Trial cannot reach plen 6. Composition is the only path.
// Suite B (reusable composite): X' plen-2 (r3) + Y' plen-4 (r4) -> Zβ plen-5.
//   Composite is directly rebindable (Zβ' probe).
//
// Arms per suite: TREAT, ABLX (no X trained), ABLY (no Y trained), FRESH.
// No paired X/Y examples. No "combine" hint. No task label.

// ---- instrumentation ----
fn cx_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  if(t>=1000000){
    let u:i32=t-1000000;
    emit(" [compose tried="); e64(u/1024); emit(" rejected="); e64(u-(u/1024)*1024); emit("]");
  } else {
    emit(" [tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("]");
  }
  return;
}
fn cx_count_maps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
fn cx_find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// white-box: Z MAP's plen and DEP targets split by node tag.
fn cx_zreport(W:[]u8,s:i32,r:i32)void {
  let zm:i32=cx_find_map(W,s,r);
  emit("ZMAP id="); e64(zm);
  if(zm>=0){
    let pl:i32=rb_chain_plen(W,ng(W,zm,20));
    emit(" plen="); e64(pl); emit("\n");
    let e:i32=0; let nf:i32=0; let nm:i32=0;
    while(e<4096){
      if(eg(W,e,0)==zm && eg(W,e,4)==1){
        let to:i32=eg(W,e,8);
        let tg:i32=ng(W,to,0);
        if(tg==20){
          nm=nm+1;
          emit("  DEP->MAP "); e64(to); emit(" plen="); e64(rb_chain_plen(W,ng(W,to,20))); emit("\n");
        } else {
          nf=nf+1;
        }
      }
      e=e+1;
    }
    emit("  dep_facts="); e64(nf); emit(" dep_maps="); e64(nm); emit("\n");
  } else {
    emit(" (none)\n");
  }
  return;
}
fn cx_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
// ---- training blocks ----
// X: plen-3 chains on r1, query rel 71.
fn cx_trainX(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  let a:i32=ev_query(W,101,71,103,0);
  emit("X1 ans="); e64(a); cx_tstat(W); emit("\n");
  ev_teach(W,105,1,106); ev_teach(W,106,1,107);
  let b:i32=ev_query(W,105,71,107,0);
  emit("X2 ans="); e64(b); cx_tstat(W); emit("\n");
  return;
}
// Y: plen-4 chains on r2, query rel 72.
fn cx_trainY(W:[]u8)void {
  ev_teach(W,201,2,202); ev_teach(W,202,2,203); ev_teach(W,203,2,204);
  let a:i32=ev_query(W,201,72,204,0);
  emit("Y1 ans="); e64(a); cx_tstat(W); emit("\n");
  ev_teach(W,205,2,206); ev_teach(W,206,2,207); ev_teach(W,207,2,208);
  let b:i32=ev_query(W,205,72,208,0);
  emit("Y2 ans="); e64(b); cx_tstat(W); emit("\n");
  return;
}
// Xp: plen-2 chains on r3, query rel 73.
fn cx_trainXp(W:[]u8)void {
  ev_teach(W,501,3,502);
  let a:i32=ev_query(W,501,73,502,0);
  emit("Xp1 ans="); e64(a); cx_tstat(W); emit("\n");
  ev_teach(W,505,3,506);
  let b:i32=ev_query(W,505,73,506,0);
  emit("Xp2 ans="); e64(b); cx_tstat(W); emit("\n");
  return;
}
// Yp: plen-4 chains on r4, query rel 74.
fn cx_trainYp(W:[]u8)void {
  ev_teach(W,601,4,602); ev_teach(W,602,4,603); ev_teach(W,603,4,604);
  let a:i32=ev_query(W,601,74,604,0);
  emit("Yp1 ans="); e64(a); cx_tstat(W); emit("\n");
  ev_teach(W,605,4,606); ev_teach(W,606,4,607); ev_teach(W,607,4,608);
  let b:i32=ev_query(W,605,74,608,0);
  emit("Yp2 ans="); e64(b); cx_tstat(W); emit("\n");
  return;
}
// ---- Suite A: Zα plen-6, beyond trial ----
fn cx_za_facts(W:[]u8)void {
  ev_teach(W,301,1,302); ev_teach(W,302,1,303);
  ev_teach(W,303,2,304); ev_teach(W,304,2,305); ev_teach(W,305,2,306);
  return;
}
fn cx_za_query(W:[]u8)void {
  let z:i32=ev_query(W,301,70,306,0);
  emit("ZA ans="); e64(z); cx_tstat(W); emit("\n");
  cx_zreport(W,301,70);
  return;
}
fn cx_suiteA_treat(W:[]u8)void {
  emit("=== A-TREAT ===\n");
  cx_trainX(W); cx_trainY(W);
  emit("maps="); e64(cx_count_maps(W)); emit("\n");
  cx_gap(W); cx_za_facts(W); cx_za_query(W);
  return;
}
fn cx_suiteA_ablx(W:[]u8)void {
  emit("=== A-ABL-X (Y only) ===\n");
  cx_trainY(W);
  cx_gap(W); cx_za_facts(W); cx_za_query(W);
  return;
}
fn cx_suiteA_ably(W:[]u8)void {
  emit("=== A-ABL-Y (X only) ===\n");
  cx_trainX(W);
  cx_gap(W); cx_za_facts(W); cx_za_query(W);
  return;
}
fn cx_suiteA_fresh(W:[]u8)void {
  emit("=== A-FRESH ===\n");
  cx_gap(W); cx_za_facts(W); cx_za_query(W);
  return;
}
// ---- Suite B: Zβ plen-5, composite rebindable ----
fn cx_zb_facts(W:[]u8)void {
  ev_teach(W,311,3,312);
  ev_teach(W,312,4,313); ev_teach(W,313,4,314); ev_teach(W,314,4,315);
  return;
}
fn cx_zb_query(W:[]u8)void {
  let z:i32=ev_query(W,311,75,315,0);
  emit("ZB ans="); e64(z); cx_tstat(W); emit("\n");
  cx_zreport(W,311,75);
  return;
}
fn cx_zbp_query(W:[]u8)void {
  ev_teach(W,321,3,322);
  ev_teach(W,322,4,323); ev_teach(W,323,4,324); ev_teach(W,324,4,325);
  let z:i32=ev_query(W,321,75,325,0);
  emit("ZBp-reuse ans="); e64(z); cx_tstat(W); emit("\n");
  return;
}
fn cx_suiteB_treat(W:[]u8)void {
  emit("=== B-TREAT ===\n");
  cx_trainXp(W); cx_trainYp(W);
  emit("maps="); e64(cx_count_maps(W)); emit("\n");
  cx_gap(W); cx_zb_facts(W); cx_zb_query(W); cx_zbp_query(W);
  return;
}
fn cx_suiteB_ablx(W:[]u8)void {
  emit("=== B-ABL-X (Yp only) ===\n");
  cx_trainYp(W);
  cx_gap(W); cx_zb_facts(W); cx_zb_query(W);
  return;
}
fn cx_suiteB_ably(W:[]u8)void {
  emit("=== B-ABL-Y (Xp only) ===\n");
  cx_trainXp(W);
  cx_gap(W); cx_zb_facts(W); cx_zb_query(W);
  return;
}
fn cx_suiteB_fresh(W:[]u8)void {
  emit("=== B-FRESH ===\n");
  cx_gap(W); cx_zb_facts(W); cx_zb_query(W);
  return;
}
fn main()i32 {
  emit("CX-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); cx_suiteA_treat(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); cx_suiteA_ablx(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); cx_suiteA_ably(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); cx_suiteA_fresh(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); cx_suiteB_treat(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); cx_suiteB_ablx(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7); cx_suiteB_ably(W7);
  let W8:[]u8=z_alloc(110656); tnn2_init(W8); cx_suiteB_fresh(W8);
  emit("CX-END\n");
  return 0;
}

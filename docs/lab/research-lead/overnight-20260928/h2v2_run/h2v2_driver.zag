// H2-v2 Evaluator Driver.
// Frozen TNN-2 cognition (lines 1-1356 of tnn2.zag) + this driver.
// Implements t2_sig_v2 (literal-free), TRIAL_ENTERED prerequisite,
// and the K-H2-1..4 probe battery on sealed H2-v2 worlds.
// Pure Zag. Pinned znc. No Python.

// ============ t2_sig_v2: literal-free structural signature ============
// Walk from root following SEQ edges, BRANCHEQ (tag 102) true-targets
// via field 12. Bound 32 cells. Per cell record ONLY the tag.
// Layout: sig[n*4] = tag. Returns cell count.
// Identical traversal to frozen t2_sig; literal resolution removed.
fn t2_sig_v2(W:[]u8, root:i32, sig:[]u8)i32 {
  let n:i32=0; let cur:i32=root; let ok:i32=1;
  while(cur>=0 && n<32 && ok==1){
    let tag:i32=ng(W,cur,0);
    if(tag!=101 && tag!=102 && tag!=103 && tag!=104){ok=0;}
    else {
      set32(sig,n*4,tag);
      n=n+1;
      if(tag==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    }
  }
  return n;
}

// Emit a signature as dash-separated tags for the SIG log.
fn sig_emit(sig:[]u8, n:i32)void {
  let i:i32=0;
  while(i<n){
    e64(get32(sig,i*4));
    if(i<n-1){ emit("-"); }
    i=i+1;
  }
  return;
}

// ============ World teachers (from sealed normative spec) ============
// H2A-v2: s=60001, r_q=60051, r_c=60052
fn h2_teach_A(W:[]u8)void {
  ev_observe(W,60001,60052,60002);
  ev_observe(W,60002,60052,60003);
  ev_observe(W,60001,60052,60011);
  ev_observe(W,60011,60052,60012);
  ev_observe(W,60012,60052,60013);
  return;
}
// H2B-v2-B1: s=60101, r_q=60151, r_c=60152
fn h2_teach_B1(W:[]u8)void {
  ev_observe(W,60101,60152,60102);
  ev_observe(W,60102,60152,60103);
  ev_observe(W,60101,60152,60111);
  ev_observe(W,60111,60152,60112);
  return;
}
// H2B-v2-B2: s=60121, r_q=60151, r_c=60152
fn h2_teach_B2(W:[]u8)void {
  ev_observe(W,60121,60152,60122);
  ev_observe(W,60122,60152,60123);
  return;
}
// H2C-v2: s=60201, r_q=60251, r_c=60252
fn h2_teach_C(W:[]u8)void {
  ev_observe(W,60201,60252,60202);
  ev_observe(W,60202,60252,60203);
  ev_observe(W,60201,60252,60211);
  ev_observe(W,60211,60252,60212);
  ev_observe(W,60212,60252,60213);
  ev_observe(W,60201,60252,60221);
  ev_observe(W,60221,60252,60222);
  ev_observe(W,60222,60252,60213);
  ev_observe(W,60201,60252,60231);
  ev_observe(W,60231,60252,60232);
  ev_observe(W,60232,60252,60213);
  return;
}

// ============ Probe runner with TRIAL_ENTERED prerequisite ============
// Returns answer. Sets trial_entered via out param. VOID if not entered.
// teach_fn: 0=A, 1=B1, 2=B2, 3=C
fn h2_run_probe(teach_fn:i32, s:i32, r_q:i32, expected:i32, flags:i32, trial_out:[]u8)i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  if(teach_fn==0){ h2_teach_A(W); }
  else { if(teach_fn==1){ h2_teach_B1(W); }
  else { if(teach_fn==2){ h2_teach_B2(W); }
  else { h2_teach_C(W); } } }
  // Prerequisite: header 16 must be 0 before query
  if(hg(W,16)!=0){ set32(trial_out,0,-1); return -999999; }
  let ans:i32=ev_query(W,s,r_q,expected,flags);
  let tried:i32=hg(W,16)/1024;
  if(tried>0){ set32(trial_out,0,1); } else { set32(trial_out,0,0); }
  return ans;
}

// ============ Calibration of t2_sig_v2 ============
// (i) 2-hop vs 3-hop DIFFERENT. (ii) same shape diff literals IDENTICAL.
// (iii) chain vs sum DIFFERENT. Returns 1 if all pass.
fn h2_calibrate()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let sig1:[]u8=z_alloc(128); let sig2:[]u8=z_alloc(128);
  let sig3:[]u8=z_alloc(128); let sig4:[]u8=z_alloc(128);
  // Build 2-hop chain: values [10,20,30]
  let v1:[]u8=z_alloc(24); let f1:[]u8=z_alloc(16);
  set32(v1,0,10); set32(v1,4,20); set32(v1,8,30);
  set32(f1,0,1); set32(f1,4,2);
  let r1:i32=t2_asm_chain(W,v1,3,f1);
  let n1:i32=t2_sig_v2(W,r1,sig1);
  // Build 3-hop chain: values [10,20,30,40]
  let v2:[]u8=z_alloc(24); let f2:[]u8=z_alloc(16);
  set32(v2,0,10); set32(v2,4,20); set32(v2,8,30); set32(v2,12,40);
  set32(f2,0,1); set32(f2,4,2); set32(f2,8,3);
  let r2:i32=t2_asm_chain(W,v2,4,f2);
  let n2:i32=t2_sig_v2(W,r2,sig2);
  // Build 2-hop chain with different literals: [100,200,300]
  let v3:[]u8=z_alloc(24); let f3:[]u8=z_alloc(16);
  set32(v3,0,100); set32(v3,4,200); set32(v3,8,300);
  set32(f3,0,1); set32(f3,4,2);
  let r3:i32=t2_asm_chain(W,v3,3,f3);
  let n3:i32=t2_sig_v2(W,r3,sig3);
  // Build sum: values [10,20]
  let sv:[]u8=z_alloc(48);
  set32(sv,0,10); set32(sv,4,20);
  let r4:i32=t2_asm_sum(W,sv,2);
  let n4:i32=t2_sig_v2(W,r4,sig4);

  // (i): n1 != n2 or sig bytes differ
  let ok_i:i32=0;
  if(n1!=n2){ ok_i=1; }
  else {
    let i:i32=0; let diff:i32=0;
    while(i<n1){ if(get32(sig1,i*4)!=get32(sig2,i*4)){diff=1;} i=i+1; }
    if(diff==1){ ok_i=1; }
  }
  // (ii): n1==n3 and all bytes identical
  let ok_ii:i32=0;
  if(n1==n3){
    let i:i32=0; let diff:i32=0;
    while(i<n1){ if(get32(sig1,i*4)!=get32(sig3,i*4)){diff=1;} i=i+1; }
    if(diff==0){ ok_ii=1; }
  }
  // (iii): chain vs sum differ
  let ok_iii:i32=0;
  if(n1!=n4){ ok_iii=1; }
  else {
    let i:i32=0; let diff:i32=0;
    while(i<n1){ if(get32(sig1,i*4)!=get32(sig4,i*4)){diff=1;} i=i+1; }
    if(diff==1){ ok_iii=1; }
  }
  emit("CALIB i="); e64(ok_i); emit(" ii="); e64(ok_ii); emit(" iii="); e64(ok_iii);
  emit(" n1="); e64(n1); emit(" n2="); e64(n2); emit(" n3="); e64(n3); emit(" n4="); e64(n4);
  emit("\n");
  emit("SIG1 "); sig_emit(sig1,n1); emit("\n");
  emit("SIG2 "); sig_emit(sig2,n2); emit("\n");
  if(ok_i==1 && ok_ii==1 && ok_iii==1){ return 1; }
  return 0;
}

// ============ Main battery ============
fn main()i32 {
  emit("H2V2-EVAL-START\n");
  // Step 1: calibration
  let cal:i32=h2_calibrate();
  if(cal!=1){
    emit("H2V2-EVAL-VOID calibration failed\n");
    return 1;
  }
  emit("CALIBRATION-PASS\n");

  let t:[]u8=z_alloc(4);
  // K-H2-1: H2A-v2 masked and unmasked
  // Masked: flags=1, expected=-2. True answer 60013.
  let a1m:i32=h2_run_probe(0,60001,60051,-2,1,t);
  let te1m:i32=get32(t,0);
  emit("H2A masked ans="); e64(a1m); emit(" trial="); e64(te1m); emit("\n");
  // Unmasked control: flags=0, expected=60013
  let a1u:i32=h2_run_probe(0,60001,60051,60013,0,t);
  let te1u:i32=get32(t,0);
  emit("H2A unmasked ans="); e64(a1u); emit(" trial="); e64(te1u); emit("\n");

  // K-H2-1: H2C-v2 masked and unmasked
  // Masked: flags=1, expected=-2. True answer 60213.
  let a2m:i32=h2_run_probe(3,60201,60251,-2,1,t);
  let te2m:i32=get32(t,0);
  emit("H2C masked ans="); e64(a2m); emit(" trial="); e64(te2m); emit("\n");
  // Unmasked control: flags=0, expected=60213
  let a2u:i32=h2_run_probe(3,60201,60251,60213,0,t);
  let te2u:i32=get32(t,0);
  emit("H2C unmasked ans="); e64(a2u); emit(" trial="); e64(te2u); emit("\n");

  // TRIAL_ENTERED prerequisite check
  if(te1m!=1 || te1u!=1 || te2m!=1 || te2u!=1){
    emit("H2V2-EVAL-VOID TRIAL_ENTERED failed\n");
    return 1;
  }
  emit("TRIAL-ENTERED-PASS\n");

  // K-H2-1 scoring: masked accuracy > 50% on both worlds.
  // Baseline (first-executable) is 0% by trap design.
  // Learner passes if masked ans == true answer on both.
  let k1:i32=0;
  if(a1m==60013 && a2m==60213){ k1=1; }
  // Unmasked controls must pass
  let cu:i32=0;
  if(a1u==60013 && a2u==60213){ cu=1; }
  emit("K-H2-1 masked_correct="); e64(k1); emit(" unmasked_controls="); e64(cu); emit("\n");
  if(k1==1 && cu==1){ emit("K-H2-1 PASS\n"); } else { emit("K-H2-1 FAIL\n"); }

  // K-H2-2: H2B-v2-B1 lie and control
  // Lie: flags=0, expected=60112 (confirmable lie). True 60103.
  let b1l:i32=h2_run_probe(1,60101,60151,60112,0,t);
  let teb1l:i32=get32(t,0);
  emit("H2B-B1 lie ans="); e64(b1l); emit(" trial="); e64(teb1l); emit("\n");
  // Control: flags=0, expected=60103 (true)
  let b1c:i32=h2_run_probe(1,60101,60151,60103,0,t);
  let teb1c:i32=get32(t,0);
  emit("H2B-B1 control ans="); e64(b1c); emit(" trial="); e64(teb1c); emit("\n");
  // K-H2-2: H2B-v2-B2 lie and control
  // Lie: flags=0, expected=69999 (unconfirmable). True 60123.
  let b2l:i32=h2_run_probe(2,60121,60151,69999,0,t);
  let teb2l:i32=get32(t,0);
  emit("H2B-B2 lie ans="); e64(b2l); emit(" trial="); e64(teb2l); emit("\n");
  // Control: flags=0, expected=60123 (true)
  let b2c:i32=h2_run_probe(2,60121,60151,60123,0,t);
  let teb2c:i32=get32(t,0);
  emit("H2B-B2 control ans="); e64(b2c); emit(" trial="); e64(teb2c); emit("\n");

  if(teb1l!=1 || teb1c!=1 || teb2l!=1 || teb2c!=1){
    emit("H2V2-EVAL-VOID TRIAL_ENTERED failed on B\n");
    return 1;
  }
  // K-H2-2 scoring: B1 must NOT promote lie (60112). B2 must record trace.
  // Zero fact-contradicting promotions required.
  // B1: lie-matching candidate promotes 60112. PASS requires ans != 60112
  //   OR ans == 60103 (fact-consistent) OR refusal (-2).
  // B2: no candidate matches 69999. Record ans and check state trace manually.
  let k2b1:i32=0;
  if(b1l!=60112){ k2b1=1; }
  let k2c:i32=0;
  if(b1c==60103 && b2c==60123){ k2c=1; }
  emit("K-H2-2 B1_not_lie="); e64(k2b1); emit(" controls="); e64(k2c);
  emit(" B2_lie_ans="); e64(b2l); emit("\n");
  if(k2b1==1 && k2c==1){ emit("K-H2-2 PASS (B1/B2 structural)\n"); }
  else { emit("K-H2-2 FAIL\n"); }

  emit("H2V2-EVAL-DONE\n");
  return 0;
}

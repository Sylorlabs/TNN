// ---- world C: world A + the cycle workload (72 facts) ----
// rel 604: successor chain 611->612->...->618 with the taught
// fixpoint self-loop (618,604,618): RETRIEVE [604,618] returns
// [618], i.e. output == input, which is what makes the walk halt
// by quiescence. rel 605: marker (611+i,605,640) carried by every
// chain subject, so VERIFY [(s,605,640)] passes along the walk.
fn setup_worldC(A:[]u8)void {
  setup_worldA(A);
  let i:i32=0;
  while(i<7){
    fact_add(A,612+i,604,611+i);
    i=i+1;
  }
  fact_add(A,618,604,618);
  let k:i32=0;
  while(k<8){
    fact_add(A,611+k,605,640);
    k=k+1;
  }
  return;
}
// Goal 816 C0 (self-loop walk, world C):
// need0 P=(601,621) -> [611] (seed);
// need1 P=(604,611) with kind-1 SELF-link (need1 -> need1:
//   OUTS slot 0 -> obj field): re-applies RETRIEVE to its own output;
// need2 T=(S,605,640) via kind-2 fan-out from need1: VERIFY each
//   walked subject.
fn mk_goal816_C0(G:[]u8)void {
  let o:i32=w_begin(G,816,3);
  o=w_need(G,o,801,2); o=w_f(G,o,601); o=w_f(G,o,621);
  o=w_need(G,o,801,2); o=w_f(G,o,604); o=w_f(G,o,611);
  o=w_need(G,o,802,4); o=w_f(G,o,1);
  o=w_f(G,o,0); o=w_f(G,o,605); o=w_f(G,o,640);
  o=w_links(G,o,2);
  o=w_link(G,o,1,1,0,1,1,1,0);
  o=w_link(G,o,2,2,0,0,1,1,0);
  return;
}
// ---- world D: world A + the oscillatory workload (61 facts) ----
// rel 606: seed fact (661,606,660) plus the 2-cycle
// (662,606,661), (661,606,662): RETRIEVE alternates
// [661], [662], [661], ... from pass 2 on. No fixpoint:
// RETRIEVE [606,661] = [662], RETRIEVE [606,662] = [661].
// rel 608: markers (661,608,660), (662,608,660), so VERIFY
// [(s,608,660)] passes for both phases.
fn setup_worldD(A:[]u8)void {
  setup_worldA(A);
  fact_add(A,661,606,660);
  fact_add(A,662,606,661);
  fact_add(A,661,606,662);
  fact_add(A,661,608,660);
  fact_add(A,662,608,660);
  return;
}
// Goal 818 D0 (oscillatory self-loop, world D):
// need0 P=(601,621) -> [611] (seed/carrier);
// need1 P=(606,660) with kind-1 SELF-link (need1 -> need1:
//   OUTS slot 0 -> obj field): re-applies RETRIEVE to its own
//   output subject, oscillating 661<->662;
// need2 T=(S,608,660) via kind-2 fan-out from need1: VERIFY each
//   visited subject.
fn mk_goal818_D0(G:[]u8)void {
  let o:i32=w_begin(G,818,3);
  o=w_need(G,o,801,2); o=w_f(G,o,601); o=w_f(G,o,621);
  o=w_need(G,o,801,2); o=w_f(G,o,606); o=w_f(G,o,660);
  o=w_need(G,o,802,4); o=w_f(G,o,1);
  o=w_f(G,o,0); o=w_f(G,o,608); o=w_f(G,o,660);
  o=w_links(G,o,2);
  o=w_link(G,o,1,1,0,1,1,1,0);
  o=w_link(G,o,2,2,0,0,1,1,0);
  return;
}
// Goal 819 D1 (oscillatory VERIFY->RETRIEVE 2-node cycle, world D):
// need0 P=(601,621) -> [611] (carrier; no link into need2, so
//   need2's constructed obj 660 is the seed);
// need1 T=(S,608,660) via kind-2 from need2 (the back edge);
// need2 P=(606,660) with kind-1 (need1 -> need2: advance obj);
// need3 T=(S,608,660) via kind-2 from need1 (acyclic sink).
fn mk_goal819_D1(G:[]u8)void {
  let o:i32=w_begin(G,819,4);
  o=w_need(G,o,801,2); o=w_f(G,o,601); o=w_f(G,o,621);
  o=w_need(G,o,802,4); o=w_f(G,o,1);
  o=w_f(G,o,0); o=w_f(G,o,608); o=w_f(G,o,660);
  o=w_need(G,o,801,2); o=w_f(G,o,606); o=w_f(G,o,660);
  o=w_need(G,o,802,4); o=w_f(G,o,1);
  o=w_f(G,o,0); o=w_f(G,o,608); o=w_f(G,o,660);
  o=w_links(G,o,3);
  o=w_link(G,o,2,1,0,0,2,1,0);
  o=w_link(G,o,1,2,0,1,1,1,0);
  o=w_link(G,o,2,3,0,0,1,1,0);

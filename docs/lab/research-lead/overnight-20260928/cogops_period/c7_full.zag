// Goal 808 D1 (world B): P=(702,727); T=(S,701,726),(S,702,727); CNT [701,1,0]
fn mk_goal808_D1(G:[]u8)void {
  let o:i32=w_begin(G,808,3);
  o=w_need(G,o,801,2); o=w_f(G,o,702); o=w_f(G,o,727);
  o=w_need(G,o,802,7); o=w_f(G,o,2);
  o=w_f(G,o,0); o=w_f(G,o,701); o=w_f(G,o,726);
  o=w_f(G,o,0); o=w_f(G,o,702); o=w_f(G,o,727);
  o=w_need(G,o,807,3); o=w_f(G,o,701); o=w_f(G,o,1); o=w_f(G,o,0);
  o=w_links(G,o,2);
  o=w_link(G,o,2,1,0,0,0,1,0);
  o=w_link(G,o,3,2,0,0,1,0,0);
  return;
}

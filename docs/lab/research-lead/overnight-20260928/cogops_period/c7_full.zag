// c4_learn.zag -- learner-owned procedures and learner-driven composition.
//
// Diamond follow-up to C422 (c3_learn.zag): plan records widened to 4
// needs per plan (56-byte entries), stats block moved to 13224, and
// apply_kind3 generalized to multi-source fan-in (preregistered).
// Binding by trial, topo assembly, version selection, plan
// persist/reuse/re-derive, and decline logic are the C422 logic
// unchanged.
// Learner-state L (16384 bytes):
//   RET region: 0: ret_nrel; 4: ret_rel_ids[16]; 68: ret_cnt[16];
//     132: ret_fidx[16][64]; 4228: ret_prov_parent (=0); 4232: ep0;
//     4236: ep1; 4240: nfacts; 4244: rev.
//   VFY region: 4248: vfy_nrel; 4252: vfy_rel_ids[16]; 4316: vfy_cnt[16];
//     4380: vfy_fidx[16][64]; 8476: vfy_prov_parent (=1); 8480: ep0;
//     8484: ep1; 8488: nfacts; 8492: rev.
//   CNT region: 8496: cnt_nrel; 8500: cnt_rel_ids[16]; 8564: cnt_cnt[16];
//     8628: cnt_fidx[16][64]; 12724: cnt_prov_parent (=4); 12728: ep0;
//     12732: ep1; 12736: nfacts; 12740: rev.
//   BIND table at 12744: 8 entries x 32 bytes:
//     [tag, bound_fam, ok0, f0, ok1, f1, ok2, f2].
//   PLAN table at 13000: 4 entries x 56 bytes:
//     [goal_tag, nneeds, idx0, tag0, fam0, idx1, tag1, fam1,
//      idx2, tag2, fam2, idx3, tag3, fam3].
//   Stats at 13224: plans_built, plans_loaded, trials, declines, agree,
//     cs, cg, ret_spec_uses, ret_gen_uses, vfy_spec_uses, vfy_gen_uses,
//     cnt_spec_uses, cnt_gen_uses.
//
// No world literals appear in this file: no goal tags, no need tags, no
// relation ids, no plan sequences. All content arrives at runtime through
// episodes, trials, and goal records.
// ---- retrieve working set ----
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  if(ret_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  if(ret_cov_find(L,r)<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
fn ret_cov_clear(L:[]u8)void { set32(L,0,0); return; }
// ---- verify working set ----
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  if(vfy_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  if(vfy_cov_find(L,r)<0){
    let n:i32=get32(L,4248);
    if(n<16){ set32(L,4252+n*4,r); set32(L,4248,n+1); }
  }
  return;
}
fn vfy_cov_clear(L:[]u8)void { set32(L,4248,0); return; }
// ---- count working set ----
fn cnt_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cnt_cov_has(L:[]u8,r:i32)i32 {
  if(cnt_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn cnt_log_rel(L:[]u8,r:i32)void {
  if(cnt_cov_find(L,r)<0){
    let n:i32=get32(L,8496);
    if(n<16){ set32(L,8500+n*4,r); set32(L,8496,n+1); }
  }
  return;
}
fn cnt_cov_clear(L:[]u8)void { set32(L,8496,0); return; }
// ---- specialize_ret: build the learner-owned indexed RETRIEVE ----
fn specialize_ret(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
// ---- specialize_vfy: build the learner-owned indexed VERIFY ----
fn specialize_vfy(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  return;
}
// ---- specialize_cnt: build the learner-owned indexed COUNT ----
// One linear pass over all facts; each fact whose relation is in the
// count working set is appended to that relation's bucket.
fn specialize_cnt(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,8564+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cnt_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,8564+bi*4);
      if(c0<64){
        set32(L,8628+(bi*64+c0)*4,j);
        set32(L,8564+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,12724,4);
  set32(L,12728,ep0);
  set32(L,12732,ep1);
  set32(L,12736,nf);
  set32(L,12740,get32(L,12740)+1);
  return;
}
// ---- ret_spec: the learner-owned specialized RETRIEVE (id 2) ----
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
// ---- vfy_spec: the learner-owned specialized VERIFY (id 3) ----
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_spec: the learner-owned specialized COUNT (id 5) ----
// For each subject, scans only the learned bucket for the relation and
// collects distinct objects. Returns -1 if the relation is outside the
// learned coverage.
fn cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<64){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// ---- episodes: experience steps ----
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0);
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
fn cnt_episode(L:[]u8,A:[]u8,rel:i32,subj:i32,kb:[]u8,tout:[]u8,seen:[]u8)i32 {
  cnt_log_rel(L,rel);
  set32(tout,0,subj);
  return cnt_gen(A,rel,tout,0,1,kb,12,seen);
}
// ---- per-need version selection from learned coverage ----
fn ret_version(L:[]u8,rel:i32)i32 {
  if(ret_cov_has(L,rel)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(vfy_cov_has(L,r)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
fn cnt_version(L:[]u8,rel:i32)i32 {
  if(cnt_cov_has(L,rel)==1){ return 5; }
  return 4;
}
// ---- goal record parsing (generic; no literals) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 {
  return get32(G,g_linkbase(G)+4+l*28+w*4);
}
// ---- working inputs: W holds per-need [nf, f0, ...] at W+n*80 ----
fn mat_inputs(G:[]u8,W:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*80,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*80+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// ---- topological order over links (Kahn; nneeds <= 3) ----
fn topo(G:[]u8,ord:[]u8)void {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  while(p<nn){
    let n2:i32=0;
    let fnd:i32=0;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    set32(placed,fnd*4,1);
    set32(ord,p*4,fnd);
    let l2:i32=0;
    while(l2<nl){
      let d2:i32=link_w(G,l2,1);
      let s2:i32=link_w(G,l2,4);
      if(s2==fnd){
        if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
      }
      l2=l2+1;
    }
    p=p+1;
  }
  return;
}
// ---- fan-out source: need with an incoming kind-2 link, else -1 ----
fn fanin_src(G:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==2){
      if(link_w(G,l,1)==ni){ return link_w(G,l,4); }
    }
    l=l+1;
  }
  return -1;
}
// ---- apply incoming kind-1 (scalar copy) links to need ni ----
fn apply_kind1(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let ds:i32=link_w(G,l,3);
      let sn:i32=link_w(G,l,4);
      let sk:i32=link_w(G,l,5);
      let ss:i32=link_w(G,l,6);
      let v:i32=0;
      if(sk==0){ v=get32(W,sn*80+4+ss*4); }
      if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
      set32(W,ni*80+4+ds*4,v);
    }
    l=l+1;
  }
  return;
}
// ---- apply incoming kind-3 (aggregate subject-list) links to need ni ----
// GENERALIZED (preregistered, Section 2.4): subjects from ALL incoming
// kind-3 links concatenate in goal-record link order into SUBL[ni*128].
// On a chain (one incoming kind-3 link) this is byte-identical to the
// C422 behavior; on a diamond (two or more sources) it is the generic
// fan-in reading. No goal-shape test, no branch count: the same link
// kind applies uniformly to any DAG.
// Returns 1 if at least one kind-3 link targeted ni, else 0.
fn apply_kind3(G:[]u8,OUTS:[]u8,SUBL:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  let found:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==3){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        let n:i32=get32(OUTS,sn*160);
        let k:i32=0;
        while(k<n){
          set32(SUBL,ni*128+4+tot*4,get32(OUTS,sn*160+4+k*4));
          tot=tot+1;
          k=k+1;
        }
        found=1;
      }
    }
    l=l+1;
  }
  if(found==1){
    set32(SUBL,ni*128,tot);
    return 1;
  }
  return 0;
}
// ---- binding table ----
fn bind_off(bi:i32)i32 { return 12744+bi*32; }
fn bind_find(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==tag){ return bi; }
    bi=bi+1;
  }
  return -1;
}
fn bind_new(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==0){
      set32(L,bind_off(bi),tag);
      set32(L,bind_off(bi)+4,-1);
      return bi;
    }
    bi=bi+1;
  }
  return -1;
}
fn bind_fam(L:[]u8,bi:i32)i32 { return get32(L,bind_off(bi)+4); }
// ---- try one procedure family on one need; 1 = consumed, 0 = refused ----
// Family 0 (RETRIEVE) accepts exactly 2-field needs (its arity).
// Family 1 (VERIFY) accepts records shaped as chains.
// Family 2 (COUNT) accepts exactly 3-field needs [rel, aggop, subj]
// with aggop == 1 (distinct-object count).
fn try_family(L:[]u8,A:[]u8,fam:i32,G:[]u8,n:i32,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nf:i32=need_nf(G,n);
  if(fam==0){
    if(nf==2){
      ret_gen(A,need_f(G,n,0),need_f(G,n,1),K,8,tout,0);
      return 1;
    }
    return 0;
  }
  if(fam==1){
    if(nf>=4){
      let ns:i32=need_f(G,n,0);
      if(ns>=1){
        if(ns<=16){
          if(nf==1+ns*3){
            set32(tmpc,0,ns);
            let i:i32=0;
            while(i<ns){
              set32(tmpc,4+i*12,need_f(G,n,1+i*3));
              set32(tmpc,4+i*12+4,need_f(G,n,1+i*3+1));
              set32(tmpc,4+i*12+8,need_f(G,n,1+i*3+2));
              i=i+1;
            }
            vfy_gen(A,tmpc,K,8);
            return 1;
          }
        }
      }
    }
    return 0;
  }
  if(nf==3){
    let ag:i32=need_f(G,n,1);
    if(ag==1){
      set32(tout,0,need_f(G,n,2));
      cnt_gen(A,need_f(G,n,0),tout,0,1,K,8,seen);
      return 1;
    }
  }
  return 0;
}
// ---- learn bindings for all unbound need tags in the goal ----
// Returns 1 iff every need tag ends bound; 0 if any need is unbindable.
fn learn_bindings(L:[]u8,A:[]u8,G:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let tag:i32=need_tag(G,n);
    let bi:i32=bind_find(L,tag);
    if(bi<0){ bi=bind_new(L,tag); }
    if(bind_fam(L,bi)<0){
      let fam:i32=0;
      while(fam<3){
        set32(L,13232,get32(L,13232)+1);
        let r:i32=try_family(L,A,fam,G,n,K,tout,tmpc,seen);
        let bo:i32=bind_off(bi);
        if(fam==0){
          if(r==1){ set32(L,bo+8,get32(L,bo+8)+1); }
          if(r==0){ set32(L,bo+12,get32(L,bo+12)+1); }
        }
        if(fam==1){
          if(r==1){ set32(L,bo+16,get32(L,bo+16)+1); }
          if(r==0){ set32(L,bo+20,get32(L,bo+20)+1); }
        }
        if(fam==2){
          if(r==1){ set32(L,bo+24,get32(L,bo+24)+1); }
          if(r==0){ set32(L,bo+28,get32(L,bo+28)+1); }
        }
        if(r==1){
          if(bind_fam(L,bi)<0){ set32(L,bo+4,fam); }
        }
        fam=fam+1;
      }
    }
    n=n+1;
  }
  let m:i32=0;
  while(m<nn){
    let bi2:i32=bind_find(L,need_tag(G,m));
    if(bi2<0){ return 0; }
    if(bind_fam(L,bi2)<0){ return 0; }
    m=m+1;
  }
  return 1;
}
// ---- plan table ----
fn plan_find(L:[]u8,gtag:i32)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==gtag){ return pi; }
    pi=pi+1;
  }
  return -1;
}
fn plan_new(L:[]u8,gtag:i32,G:[]u8,ord:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==0){
      let nn:i32=g_nneeds(G);
      set32(L,13000+pi*56,gtag);
      set32(L,13000+pi*56+4,nn);
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(ord,p*4);
        let tag:i32=need_tag(G,ni);
        let bi:i32=bind_find(L,tag);
        set32(L,13000+pi*56+8+p*12,ni);
        set32(L,13000+pi*56+8+p*12+4,tag);
        set32(L,13000+pi*56+8+p*12+8,bind_fam(L,bi));
        p=p+1;
      }
      set32(L,13224,get32(L,13224)+1);
      return pi;
    }
    pi=pi+1;
  }
  return -1;
}
// Copy the first non-empty plan's ints
// [gtag,n,idx0,tag0,fam0,idx1,tag1,fam1,idx2,tag2,fam2,idx3,tag3,fam3]
// into out.
fn plan_get_first(L:[]u8,out:[]u8)void {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)!=0){
      let k:i32=0;
      while(k<14){
        set32(out,k*4,get32(L,13000+pi*56+k*4));
        k=k+1;
      }
      return;
    }
    pi=pi+1;
  }
  set32(out,0,-1);
  return;
}
fn clear_plans(L:[]u8)void {
  let pi:i32=0;
  while(pi<4){ set32(L,13000+pi*56,0); pi=pi+1; }
  return;
}
fn clear_bindings(L:[]u8)void {
  let bi:i32=0;
  while(bi<8){ set32(L,bind_off(bi),0); bi=bi+1; }
  return;
}
// ---- answer assembly ----
fn ans_append(ans:[]u8,v:i32)void {
  let n:i32=get32(ans,0);
  set32(ans,4+n*4,v);
  set32(ans,0,n+1);
  return;
}
// Append one need's output record (at OUTS+ni*160: [n, ints...]).
fn ans_append_rec(ans:[]u8,OUTS:[]u8,ni:i32)void {
  let n:i32=get32(OUTS,ni*160);
  ans_append(ans,n);
  let k:i32=0;
  while(k<n){
    ans_append(ans,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
// ---- build a chain buffer from need W[ni]; sub>=0 fills s==0 slots ----
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32)void {
  let ns:i32=get32(W,n*80+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*80+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*80+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*80+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
// ---- execute one stored plan; ans gets the appended output records ----
fn execute_plan(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,13000+pi*56+4);
  set32(vbuf,16,nn);
  set32(ans,0,0);
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(L,13000+pi*56+8+p*12);
    let fam:i32=get32(L,13000+pi*56+8+p*12+8);
    apply_kind1(G,W,OUTS,ni);
    if(fam==0){
      let rel:i32=get32(W,ni*80+4);
      let obj:i32=get32(W,ni*80+8);
      let ver:i32=ret_version(L,rel);
      set32(vbuf,p*4,ver);
      if(ver==2){
        set32(L,13252,get32(L,13252)+1);
        ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
      }
      if(ver==0){
        set32(L,13256,get32(L,13256)+1);
        ret_gen(A,rel,obj,K,0,OUTS,ni*160);
      }
      ans_append_rec(ans,OUTS,ni);
    }
    if(fam==1){
      let ver2:i32=vfy_version(L,W,ni);
      set32(vbuf,p*4,ver2);
      if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
      if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
      let src:i32=fanin_src(G,ni);
      if(src<0){
        w_to_chain(W,ni,tmpc,-1);
        let vv:i32=0;
        if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
        set32(OUTS,ni*160,1);
        set32(OUTS,ni*160+4,vv);
        ans_append_rec(ans,OUTS,ni);
      }
      if(src>=0){
        let nsub:i32=get32(OUTS,src*160);
        let npass:i32=0;
        let k:i32=0;
        while(k<nsub){
          let sub:i32=get32(OUTS,src*160+4+k*4);
          w_to_chain(W,ni,tmpc,sub);
          let vv2:i32=0;
          if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
          if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
          if(vv2==1){
            set32(OUTS,ni*160+4+npass*4,sub);
            npass=npass+1;
          }
          k=k+1;
        }
        set32(OUTS,ni*160,npass);
        ans_append_rec(ans,OUTS,ni);
      }
    }
    if(fam==2){
      let rel3:i32=get32(W,ni*80+4);
      let ver3:i32=cnt_version(L,rel3);
      set32(vbuf,p*4,ver3);
      let has3:i32=apply_kind3(G,OUTS,SUBL,ni);
      let ns3:i32=0;
      if(has3==1){ ns3=get32(SUBL,ni*128); }
      if(has3==0){
        set32(SUBL,ni*128,1);
        set32(SUBL,ni*128+4,get32(W,ni*80+12));
        ns3=1;
      }
      let cc:i32=0;
      if(ver3==5){
        set32(L,13268,get32(L,13268)+1);
        cc=cnt_spec(L,A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
      }
      if(ver3==4){
        set32(L,13272,get32(L,13272)+1);
        cc=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
      }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,cc);
      ans_append_rec(ans,OUTS,ni);
    }
    p=p+1;
  }
  return;
}
// ---- compose: the learner-driven composition entry point ----
// Returns 0 = declined (NO_PLAN), 1 = plan loaded, 2 = plan built.
// vbuf gets per-step versions; ans gets the answer record.
fn compose(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return 0;
    }
    topo(G,ord);
    pi=plan_new(L,gt,G,ord);
    execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
  return 1;
}

// =====================================================================
// c5 ADDITIVE GENERALIZATION (PREREG Section 2.2).
// Everything above this line is byte-identical to c4_learn.zag
// (cogops-diamond). What follows is purely additive: no C433
// function is modified. Frozen entry points keep their names:
// compose, execute_plan, topo, apply_kind1.
// New entry points: topo_g, apply_kind1_g, snap_out, out_eq_snap,
// exec_step_iter, execute_plan_iter, compose_iter, plan_drop.
// No world literals, no goal tags, no need tags, no relation ids
// appear below: all content arrives at runtime through goal records.
// =====================================================================

// ---- topo_g: Kahn with stall detection + deterministic fallback ----
// Runs Kahn; if no zero-indegree unplaced node remains, stops
// (instead of the frozen topo's re-place-node-0, which silently
// corrupts the order) and appends the unplaced needs in index
// order. Returns the Kahn-placed count (== nneeds on a DAG).
// Not cycle detection: it completes any partial order
// deterministically, with no goal-shape or back-edge test.
fn topo_g(G:[]u8,ord:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  let stall:i32=0;
  while(stall==0){
    let n2:i32=0;
    let fnd:i32=-1;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    if(fnd<0){ stall=1; }
    if(fnd>=0){
      set32(placed,fnd*4,1);
      set32(ord,p*4,fnd);
      p=p+1;
      if(p>=nn){ stall=1; }
      let l2:i32=0;
      while(l2<nl){
        let d2:i32=link_w(G,l2,1);
        let s2:i32=link_w(G,l2,4);
        if(s2==fnd){
          if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
        }
        l2=l2+1;
      }
    }
  }
  let kplaced:i32=p;
  let n3:i32=0;
  while(n3<nn){
    if(get32(placed,n3*4)==0){
      set32(ord,p*4,n3);
      p=p+1;
    }
    n3=n3+1;
  }
  return kplaced;
}
// ---- apply_kind1_g: kind-1 links fire only from non-empty sources ----
// Uniform dataflow rule: a scalar-copy link carries the source
// need's produced value; if the source output record is empty
// there is no value to carry, so the destination field keeps its
// current value. Identical to apply_kind1 whenever every kind-1
// source is non-empty (the whole C433 battery).
fn apply_kind1_g(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let sn:i32=link_w(G,l,4);
      if(get32(OUTS,sn*160)>0){
        let ds:i32=link_w(G,l,3);
        let sk:i32=link_w(G,l,5);
        let ss:i32=link_w(G,l,6);
        let v:i32=0;
        if(sk==0){ v=get32(W,sn*80+4+ss*4); }
        if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
        set32(W,ni*80+4+ds*4,v);
      }
    }
    l=l+1;
  }
  return;
}
// ---- output-record snapshot / comparison helpers ----
fn snap_out(OUTS:[]u8,ni:i32,snap:[]u8)void {
  let n:i32=get32(OUTS,ni*160);
  set32(snap,0,n);
  let k:i32=0;
  while(k<n){
    set32(snap,4+k*4,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
fn out_eq_snap(OUTS:[]u8,ni:i32,snap:[]u8)i32 {
  let n:i32=get32(OUTS,ni*160);
  if(n!=get32(snap,0)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(OUTS,ni*160+4+k*4)!=get32(snap,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- exec_step_iter: execute one plan step with the generalized link rule ----
// Versions recorded to vbuf[p*4]. No answer emission; the caller
// emits final records after quiescence.
fn exec_step_iter(L:[]u8,A:[]u8,G:[]u8,pi:i32,p:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8)void {
  let ni:i32=get32(L,13000+pi*56+8+p*12);
  let fam:i32=get32(L,13000+pi*56+8+p*12+8);
  apply_kind1_g(G,W,OUTS,ni);
  if(fam==0){
    let rel:i32=get32(W,ni*80+4);
    let obj:i32=get32(W,ni*80+8);
    let ver:i32=ret_version(L,rel);
    set32(vbuf,p*4,ver);
    if(ver==2){
      set32(L,13252,get32(L,13252)+1);
      ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
    }
    if(ver==0){
      set32(L,13256,get32(L,13256)+1);
      ret_gen(A,rel,obj,K,0,OUTS,ni*160);
    }
  }
  if(fam==1){
    let ver2:i32=vfy_version(L,W,ni);
    set32(vbuf,p*4,ver2);
    if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
    if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
    let src:i32=fanin_src(G,ni);
    if(src<0){
      w_to_chain(W,ni,tmpc,-1);
      let vv:i32=0;
      if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
      if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,vv);
    }
    if(src>=0){
      let nsub:i32=get32(OUTS,src*160);
      let npass:i32=0;
      let k:i32=0;
      while(k<nsub){
        let sub:i32=get32(OUTS,src*160+4+k*4);
        w_to_chain(W,ni,tmpc,sub);
        let vv2:i32=0;
        if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
        if(vv2==1){
          set32(OUTS,ni*160+4+npass*4,sub);
          npass=npass+1;
        }
        k=k+1;
      }
      set32(OUTS,ni*160,npass);
    }
  }
  if(fam==2){
    let rel3:i32=get32(W,ni*80+4);
    let ver3:i32=cnt_version(L,rel3);
    set32(vbuf,p*4,ver3);
    let has3:i32=apply_kind3(G,OUTS,SUBL,ni);
    let ns3:i32=0;
    if(has3==1){ ns3=get32(SUBL,ni*128); }
    if(has3==0){
      set32(SUBL,ni*128,1);
      set32(SUBL,ni*128+4,get32(W,ni*80+12));
      ns3=1;
    }
    let cc:i32=0;
    if(ver3==5){
      set32(L,13268,get32(L,13268)+1);
      cc=cnt_spec(L,A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
    }
    if(ver3==4){
      set32(L,13272,get32(L,13272)+1);
      cc=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
    }
    set32(OUTS,ni*160,1);
    set32(OUTS,ni*160+4,cc);
  }
  return;
}
// ---- execute_plan_iter: change-driven iterated execution ----
// Steps run in plan order; a need executes when dirty (all start
// dirty). If its output record changed, link-successors are marked
// dirty. Halts on quiescence (a pass with no dirty need) or the
// pass CAP (16, frozen totality bound). Answer records are emitted
// in plan order with FINAL values. vbuf[20] gets passes used.
fn execute_plan_iter(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,dirty:[]u8,snap:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,13000+pi*56+4);
  let nl:i32=g_nlinks(G);
  set32(vbuf,16,nn);
  set32(ans,0,0);
  let n:i32=0;
  while(n<nn){ set32(dirty,n*4,1); n=n+1; }
  let pass:i32=0;
  let cap:i32=16;
  let running:i32=1;
  while(running==1){
    if(pass>=cap){ running=0; }
    if(running==1){
      let progressed:i32=0;
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(L,13000+pi*56+8+p*12);
        if(get32(dirty,ni*4)==1){
          progressed=1;
          set32(dirty,ni*4,0);
          snap_out(OUTS,ni,snap);
          exec_step_iter(L,A,G,pi,p,K,vbuf,W,OUTS,tmpc,SUBL,seen);
          if(out_eq_snap(OUTS,ni,snap)==0){
            let l:i32=0;
            while(l<nl){
              if(link_w(G,l,4)==ni){
                set32(dirty,link_w(G,l,1)*4,1);
              }
              l=l+1;
            }
          }
        }
        p=p+1;
      }
      pass=pass+1;
      if(progressed==0){ running=0; }
    }
  }
  set32(vbuf,20,pass);
  let q:i32=0;
  while(q<nn){
    let nj:i32=get32(L,13000+pi*56+8+q*12);
    ans_append_rec(ans,OUTS,nj);
    q=q+1;
  }
  return;
}
// ---- compose_iter: the generalized composition entry point ----
// Returns 0 = declined, 1 = plan loaded, 2 = plan built.
// vbuf[16] = nneeds, vbuf[20] = passes used; ans = final records.
fn compose_iter(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let dirty:[]u8=z_alloc(16);
  let snap:[]u8=z_alloc(136);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return 0;
    }
    topo_g(G,ord);
    pi=plan_new(L,gt,G,ord);
    execute_plan_iter(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan_iter(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap);
  return 1;
}
// ---- plan_drop: clear the stored plan for one goal tag (generic) ----
fn plan_drop(L:[]u8,gtag:i32)void {
  let pi:i32=plan_find(L,gtag);
  if(pi>=0){ set32(L,13000+pi*56,0); }
  return;
}

// =====================================================================
// c7 ADDITIVE PERIOD DETECTION (PREREG Section 2.3).
// Everything above this line is byte-identical to c6_learn.zag
// (cogops-oscillatory). What follows is purely additive: no C442/C451
// function is modified. The halting vocabulary generalizes
// output-stability (period-1 repetition of the global output state)
// to period-k repetition (k = 2, 3). The trajectory history and the
// outcome record live in learner-owned state L (tail region after
// the stats block):
//   13276: osc_m (snapshots stored, 0..4)
//   13280: osc_nn (nneeds snapshotted)
//   13284: osc_hist: 4 snapshots x 4 needs x 33 i32 (2112 bytes)
//   15396: osc_outcome: [halt_kind, period, passes]
// New entry points: osc_hist_reset, osc_hist_push, osc_hist_eq,
// osc_detect, osc_emit_orbit, execute_plan_iter_pd, compose_iter_pd.
// No world literals, no goal tags, no need tags, no relation ids
// appear below: all content arrives at runtime through goal records
// and learner-owned procedure outputs.
// =====================================================================
// ---- osc_hist_reset: clear the trajectory history for a new query ----
fn osc_hist_reset(L:[]u8)void {
  set32(L,13276,0);
  set32(L,13280,0);
  set32(L,15396,0);
  set32(L,15400,0);
  set32(L,15404,0);
  return;
}
// ---- osc_hist_push: snapshot the global output state (all needs) ----
// Bounded ring of depth 4: on overflow the oldest snapshot shifts out.
fn osc_hist_push(L:[]u8,OUTS:[]u8,nn:i32)void {
  let m:i32=get32(L,13276);
  if(m>=4){
    let s:i32=1;
    while(s<4){
      let ni:i32=0;
      while(ni<4){
        let k:i32=0;
        while(k<33){
          set32(L,13284+(s-1)*528+ni*132+k*4,get32(L,13284+s*528+ni*132+k*4));
          k=k+1;
        }
        ni=ni+1;
      }
      s=s+1;
    }
    m=3;
  }
  let ni2:i32=0;
  while(ni2<4){
    let n:i32=0;
    if(ni2<nn){ n=get32(OUTS,ni2*160); }
    if(n>32){ n=32; }
    set32(L,13284+m*528+ni2*132,n);
    let k2:i32=0;
    while(k2<n){
      set32(L,13284+m*528+ni2*132+4+k2*4,get32(OUTS,ni2*160+4+k2*4));
      k2=k2+1;
    }
    ni2=ni2+1;
  }
  set32(L,13280,nn);
  set32(L,13276,m+1);
  return;
}
// ---- osc_hist_eq: generic equality of two stored global snapshots ----
fn osc_hist_eq(L:[]u8,a:i32,b:i32,nn:i32)i32 {
  let ni:i32=0;
  while(ni<nn){
    let na:i32=get32(L,13284+a*528+ni*132);
    let nb:i32=get32(L,13284+b*528+ni*132);
    if(na!=nb){ return 0; }
    let k:i32=0;
    while(k<na){
      if(get32(L,13284+a*528+ni*132+4+k*4)!=get32(L,13284+b*528+ni*132+4+k*4)){ return 0; }
      k=k+1;
    }
    ni=ni+1;
  }
  return 1;
}
// ---- osc_detect: period 2/3 rule over the snapshot history ----
// Call after pass t completes (t = m-1, m snapshots stored).
// Period k fires iff sig(t)==sig(t-k) with sig(t) distinct from
// every intermediate snapshot: in deterministic iteration a
// repeated global state proves a period-k cycle. The distinctness
// guards keep fixpoint approaches (sig(t)==sig(t-1)) from ever
// classifying as oscillation. Returns 2, 3, or 0.
fn osc_detect(L:[]u8,nn:i32)i32 {
  let m:i32=get32(L,13276);
  let t:i32=m-1;
  let r2:i32=0;
  if(t>=2){
    let e2:i32=osc_hist_eq(L,t,t-2,nn);
    let e1:i32=osc_hist_eq(L,t,t-1,nn);
    let ok2:i32=0;
    if(e2==1){ ok2=1; }
    if(e1==1){ ok2=0; }
    if(ok2==1){ r2=2; }
  }
  if(r2==2){ return 2; }
  let r3:i32=0;
  if(t>=3){
    let e3:i32=osc_hist_eq(L,t,t-3,nn);
    let f1:i32=osc_hist_eq(L,t,t-1,nn);
    let f2:i32=osc_hist_eq(L,t,t-2,nn);
    let ok3:i32=0;
    if(e3==1){ ok3=1; }
    if(f1==1){ ok3=0; }
    if(f2==1){ ok3=0; }
    if(ok3==1){ r3=3; }
  }
  if(r3==3){ return 3; }
  return 0;
}
// ---- osc_emit_orbit: report the orbit into ans ----
// ans = [k, then k phases x nn needs x full records in plan order].
// The full orbit is reported, never a single captured phase.
fn osc_emit_orbit(L:[]u8,ans:[]u8,nn:i32,pi:i32,k:i32)void {
  set32(ans,0,0);
  ans_append(ans,k);
  let m:i32=get32(L,13276);
  let j:i32=0;
  while(j<k){
    let s:i32=m-k+j;
    let q:i32=0;
    while(q<nn){
      let ni:i32=get32(L,13000+pi*56+8+q*12);
      let n:i32=get32(L,13284+s*528+ni*132);
      ans_append(ans,n);
      let v:i32=0;
      while(v<n){
        ans_append(ans,get32(L,13284+s*528+ni*132+4+v*4));
        v=v+1;
      }
      q=q+1;
    }
    j=j+1;
  }
  return;
}
// ---- execute_plan_iter_pd: change-driven iterated execution with ----
// ---- period-aware halting. Three-way outcome: 0 = converged ----
// ---- (quiescence, as in execute_plan_iter), 1 = oscillation ----
// ---- (period detected), 2 = cap (aperiodic; totality insurance). ----
// vbuf[20] = passes used; vbuf[21] = halt kind; vbuf[22] = period.
// CONV/CAP emit final records in plan order (identical to
// execute_plan_iter); OSC emits the orbit via osc_emit_orbit.
fn execute_plan_iter_pd(L:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,dirty:[]u8,snap:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,13000+pi*56+4);
  let nl:i32=g_nlinks(G);
  set32(vbuf,16,nn);
  set32(ans,0,0);
  osc_hist_reset(L);
  let n:i32=0;
  while(n<nn){ set32(dirty,n*4,1); n=n+1; }
  let pass:i32=0;
  let cap:i32=16;
  let running:i32=1;
  let halt:i32=0;
  let period:i32=0;
  while(running==1){
    if(pass>=cap){ running=0; halt=2; }
    if(running==1){
      let progressed:i32=0;
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(L,13000+pi*56+8+p*12);
        if(get32(dirty,ni*4)==1){
          progressed=1;
          set32(dirty,ni*4,0);
          snap_out(OUTS,ni,snap);
          exec_step_iter(L,A,G,pi,p,K,vbuf,W,OUTS,tmpc,SUBL,seen);
          if(out_eq_snap(OUTS,ni,snap)==0){
            let l:i32=0;
            while(l<nl){
              if(link_w(G,l,4)==ni){
                set32(dirty,link_w(G,l,1)*4,1);
              }
              l=l+1;
            }
          }
        }
        p=p+1;
      }
      pass=pass+1;
      osc_hist_push(L,OUTS,nn);
      if(progressed==0){ running=0; halt=0; }
      if(running==1){
        let dp:i32=osc_detect(L,nn);
        if(dp>0){ running=0; halt=1; period=dp; }
      }
    }
  }
  set32(vbuf,20,pass);
  set32(vbuf,24,halt);
  set32(vbuf,28,period);
  set32(L,15396,halt);
  set32(L,15400,period);
  set32(L,15404,pass);
  if(halt==1){
    osc_emit_orbit(L,ans,nn,pi,period);
  }
  if(halt!=1){
    let q:i32=0;
    while(q<nn){
      let nj:i32=get32(L,13000+pi*56+8+q*12);
      ans_append_rec(ans,OUTS,nj);
      q=q+1;
    }
  }
  return;
}
// ---- compose_iter_pd: the period-aware composition entry point ----
// Returns 0 = declined, 1 = plan loaded, 2 = plan built.
// vbuf[16] = nneeds, vbuf[20] = passes, vbuf[21] = halt kind,
// vbuf[22] = period; ans = final records or the reported orbit.
fn compose_iter_pd(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let dirty:[]u8=z_alloc(16);
  let snap:[]u8=z_alloc(136);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return 0;
    }
    topo_g(G,ord);
    pi=plan_new(L,gt,G,ord);
    execute_plan_iter_pd(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan_iter_pd(L,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap);
  return 1;
}
// c7_main.zag -- driver for the cogops-period battery.
// Stages S1A, S1B (world A learning), S2 (period-2 workload
// learning), S3 (period-2 self-loop, period-aware composer),
// S4 (period-2 two-node cycle), S5 (period-3 workload learning
// plus period-3 self-loop), S6 (convergent cycle learning),
// S7 (convergent self-loop, period-aware composer), S8
// (orbit-close probes plus fixpoint probe), SUMMARY-PD.
// The composer is compose_iter_pd: change-driven iteration with
// period-aware halting (halt=conv / osc / cap, period, orbit).
// Agreement for oscillatory goals is phase-independent:
// the executor's reported orbit value set must equal the
// independently computed generic attractor cycle set, with
// matching periods. All dynamic output goes through the single
// preallocated buffer B, flushed once at the end.
// No world literals in this file: probe rel/obj/seed values are
// read from the goal record.
fn o_ids(b:[]u8,c:i32,L:[]u8,off:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(i>0){ b[c]=44; c=c+1; }
    let v:i32=get32(L,off+i*4);
    c=o_i64(b,c,v as i64);
    i=i+1;
  }
  return c;
}
fn dump_lstate_ret(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,0);
  c=o_app(b,c,"LSTATE-RET nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,68,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,4228) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4232) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4236) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_nl(b,c);
  return c;
}
fn dump_lstate_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  let nr:i32=get32(L,4248);
  c=o_app(b,c,"LSTATE-VFY nrel=");
  c=o_i64(b,c,nr as i64);
  c=o_app(b,c," ids=");
  c=o_ids(b,c,L,4252,nr);
  c=o_app(b,c," cnts=");
  c=o_ids(b,c,L,4316,nr);
  c=o_app(b,c," prov=");
  c=o_i64(b,c,get32(L,8476) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8480) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8484) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_app(b,c," rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_ret(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-RET rev=");
  c=o_i64(b,c,get32(L,4244) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,0) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,4232) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,4236) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,4240) as i64);
  c=o_nl(b,c);
  return c;
}
fn spec_line_vfy(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"SPEC-VFY rev=");
  c=o_i64(b,c,get32(L,8492) as i64);
  c=o_app(b,c," nrel=");
  c=o_i64(b,c,get32(L,4248) as i64);
  c=o_app(b,c," ep0=");
  c=o_i64(b,c,get32(L,8480) as i64);
  c=o_app(b,c," ep1=");
  c=o_i64(b,c,get32(L,8484) as i64);
  c=o_app(b,c," nfacts=");
  c=o_i64(b,c,get32(L,8488) as i64);
  c=o_nl(b,c);
  return c;
}
fn dump_bind(b:[]u8,c:i32,L:[]u8)i32 {
  let bi:i32=0;
  while(bi<8){
    let tag:i32=get32(L,12744+bi*32);
    if(tag!=0){
      c=o_app(b,c,"BIND tag=");
      c=o_i64(b,c,tag as i64);
      c=o_app(b,c," fam=");
      c=o_i64(b,c,get32(L,12744+bi*32+4) as i64);
      c=o_app(b,c," ok0=");
      c=o_i64(b,c,get32(L,12744+bi*32+8) as i64);
      c=o_app(b,c," f0=");
      c=o_i64(b,c,get32(L,12744+bi*32+12) as i64);
      c=o_app(b,c," ok1=");
      c=o_i64(b,c,get32(L,12744+bi*32+16) as i64);
      c=o_app(b,c," f1=");
      c=o_i64(b,c,get32(L,12744+bi*32+20) as i64);
      c=o_app(b,c," ok2=");
      c=o_i64(b,c,get32(L,12744+bi*32+24) as i64);
      c=o_app(b,c," f2=");
      c=o_i64(b,c,get32(L,12744+bi*32+28) as i64);
      c=o_nl(b,c);
    }
    bi=bi+1;
  }
  return c;
}
fn dump_plans(b:[]u8,c:i32,L:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    let gt:i32=get32(L,13000+pi*56);
    if(gt!=0){
      c=o_app(b,c,"PLAN goal=");
      c=o_i64(b,c,gt as i64);
      let nn:i32=get32(L,13000+pi*56+4);
      c=o_app(b,c," n=");
      c=o_i64(b,c,nn as i64);
      let p:i32=0;
      while(p<nn){
        c=o_app(b,c," [");
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+4) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+8) as i64);
        b[c]=93; c=c+1;
        p=p+1;
      }
      c=o_nl(b,c);
    }
    pi=pi+1;
  }
  return c;
}
// ---- dump the learner-owned oscillation outcome record ----
fn dump_osc(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"OSC-STATE m=");
  c=o_i64(b,c,get32(L,13276) as i64);
  c=o_app(b,c," halt=");
  c=o_i64(b,c,get32(L,15396) as i64);
  c=o_app(b,c," period=");
  c=o_i64(b,c,get32(L,15400) as i64);
  c=o_app(b,c," passes=");
  c=o_i64(b,c,get32(L,15404) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one retrieve episode ----
fn run_retep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,id:i32,ep:i32)i32 {
  ret_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let obj:i32=get32(rb,4);
  let n:i32=ret_episode(L,A,rel,obj,K,tout);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," ret n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one verify episode ----
fn run_vfyep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,Cb:[]u8,id:i32,ep:i32)i32 {
  vfy_ep_chain(Cb,id);
  let v:i32=vfy_episode(L,A,Cb,K);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," vfy v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- chain_of: build a chain buffer from a goal need, sub fills s==0 ----
fn chain_of(G:[]u8,ni:i32,sub:i32,tmpc:[]u8)void {
  let ns:i32=need_f(G,ni,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=need_f(G,ni,1+i*3);
    if(s==0){ s=sub; }
    set32(tmpc,4+i*12,s);
    set32(tmpc,4+i*12+4,need_f(G,ni,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,ni,1+i*3+2));
    i=i+1;
  }
  return;
}
// ---- walk_fix: iterate RETRIEVE [rel, obj] until output == input ----
// Returns the fixpoint subject. Independent of the learner; uses
// only ret_gen. Guarded by a 16-step cap for totality.
fn walk_fix(A:[]u8,rel:i32,obj:i32,K:[]u8,tout:[]u8)i32 {
  let guard:i32=0;
  let walking:i32=1;
  while(walking==1){
    if(guard>=16){ walking=0; }
    if(walking==1){
      let nr:i32=ret_gen(A,rel,obj,K,4,tout,0);
      if(nr==0){ walking=0; }
      if(nr>0){
        let s:i32=get32(tout,4);
        if(s==obj){ walking=0; }
        if(s!=obj){ obj=s; }
      }
      guard=guard+1;
    }
  }
  return obj;
}
// ---- oracle_cyc816: independent all-generic reference, self-loop goal ----
// Intended semantics: seed = RETRIEVE need0; walk = iterate RETRIEVE
// [successor-rel, obj] to the fixpoint; final = VERIFY the fixpoint subject
// against need2's template. Records emitted in plan order:
// need1, need2, need0. Uses only ret_gen, vfy_gen.
fn oracle_cyc816(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let seed:[]u8=z_alloc(160);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=chain_new();
  let nc0:i32=ret_gen(A,need_f(G,0,0),need_f(G,0,1),K,4,seed,0);
  let fix:i32=walk_fix(A,need_f(G,1,0),need_f(G,1,1),K,tout);
  chain_of(G,2,fix,tmpc);
  let vv:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,fix);
  let npass:i32=0;
  if(vv==1){ npass=1; }
  ans_append(oans,npass);
  if(npass==1){ ans_append(oans,fix); }
  ans_append(oans,nc0);
  let k:i32=0;
  while(k<nc0){
    ans_append(oans,get32(seed,4+k*4));
    k=k+1;
  }
  return;
}
// ---- seq_find: index of v in seq[0..slen), or -1 ----
fn seq_find(seq:[]u8,slen:i32,v:i32)i32 {
  let j:i32=0;
  while(j<slen){
    if(get32(seq,j*4)==v){ return j; }
    j=j+1;
  }
  return -1;
}
// ---- oracle_attractor: independent all-generic cycle finder ----
// Repeatedly applies ret_gen [rel, cur] from seed; stops when a
// value repeats (bounded 8 steps). The repeated segment is the
// cycle: cyc gets [v0..v(k-1)], returns k. Returns 0 when no
// cycle closes within the bound. Uses only ret_gen.
fn oracle_attractor(A:[]u8,rel:i32,seed:i32,K:[]u8,tout:[]u8,cyc:[]u8)i32 {
  let seq:[]u8=z_alloc(64);
  let slen:i32=0;
  let cur:i32=seed;
  let guard:i32=0;
  let done:i32=0;
  let k:i32=0;
  while(done==0){
    if(guard>=8){ done=1; }
    if(done==0){
      let nr:i32=ret_gen(A,rel,cur,K,4,tout,0);
      let go:i32=0;
      if(nr>0){ go=1; }
      if(go==1){
        let v:i32=get32(tout,4);
        let rep:i32=seq_find(seq,slen,v);
        if(rep>=0){ done=2; }
        if(rep<0){
          set32(seq,slen*4,v);
          slen=slen+1;
          cur=v;
        }
      }
      if(go==0){ done=1; }
      guard=guard+1;
    }
  }
  if(done==2){
    let v2:i32=get32(tout,4);
    let rep2:i32=seq_find(seq,slen,v2);
    k=slen-rep2;
    let q:i32=0;
    while(q<k){
      set32(cyc,q*4,get32(seq,(rep2+q)*4));
      q=q+1;
    }
  }
  return k;
}
// ---- orbit_agree: phase-independent orbit confirmation ----
// agree iff executor halted with OSC, its reported period equals
// the oracle cycle length, and the driver need's orbit value set
// (parsed generically from ans: [k, k phases x nn records])
// equals the oracle cycle set in both directions.
fn orbit_agree(ans:[]u8,nn:i32,drv_pos:i32,period:i32,cyc:[]u8,ck:i32)i32 {
  if(period!=ck){ return 0; }
  if(period<=0){ return 0; }
  let vals:[]u8=z_alloc(32);
  let nv:i32=0;
  let p:i32=8;
  let j:i32=0;
  while(j<period){
    let q:i32=0;
    while(q<nn){
      let n:i32=get32(ans,p);
      if(q==drv_pos){
        let v:i32=0;
        while(v<n){
          if(nv<8){ set32(vals,nv*4,get32(ans,p+4+v*4)); nv=nv+1; }
          v=v+1;
        }
      }
      p=p+4+n*4;
      q=q+1;
    }
    j=j+1;
  }
  let a:i32=0;
  while(a<nv){
    let vv:i32=get32(vals,a*4);
    let f:i32=0;
    let b2:i32=0;
    while(b2<ck){
      if(get32(cyc,b2*4)==vv){ f=1; }
      b2=b2+1;
    }
    if(f==0){ return 0; }
    a=a+1;
  }
  let d:i32=0;
  while(d<ck){
    let ww:i32=get32(cyc,d*4);
    let g:i32=0;
    let e:i32=0;
    while(e<nv){
      if(get32(vals,e*4)==ww){ g=1; }
      e=e+1;
    }
    if(g==0){ return 0; }
    d=d+1;
  }
  return 1;
}
// ---- one composite query: period-aware compose + oracle compare ----
// okind 2 = convergent self-loop (oracle_cyc816, record agreement).
// okind 6 = oscillatory goal (attractor + orbit-set agreement;
// drv_need/drv_pos calibrate the instrument to the goal's driver).
// Efficiency stats accumulate over agree=1 queries only.
fn do_query_pd(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,G:[]u8,ans:[]u8,vbuf:[]u8,seen:[]u8,qn:[]u8,okind:i32,drv_need:i32,drv_pos:i32)i32 {
  let tout:[]u8=z_alloc(160);
  let cyc:[]u8=z_alloc(32);
  let oans:[]u8=z_alloc(256);
  set32(K,0,0);
  set32(K,4,0);
  let st:i32=compose_iter_pd(L,A,G,K,ans,vbuf);
  c=o_app(b,c,"Q id=");
  c=o_app(b,c,qn);
  if(st==0){
    c=o_app(b,c," goal=");
    c=o_i64(b,c,g_tag(G) as i64);
    c=o_app(b,c," decline=1");
    c=o_nl(b,c);
    return c;
  }
  let halt:i32=get32(vbuf,24);
  let period:i32=get32(vbuf,28);
  let a:i32=0;
  set32(K,4,0);
  if(okind==2){
    oracle_cyc816(A,G,K,oans,seen);
    a=ans_eq(ans,oans);
  }
  if(okind==6){
    let rel:i32=need_f(G,drv_need,0);
    let seed:i32=need_f(G,drv_need,1);
    let ck:i32=oracle_attractor(A,rel,seed,K,tout,cyc);
    let nn:i32=get32(vbuf,16);
    if(halt==1){ a=orbit_agree(ans,nn,drv_pos,period,cyc,ck); }
  }
  let cs:i32=get32(K,0);
  let cg:i32=get32(K,4);
  if(a==1){
    set32(L,13240,get32(L,13240)+1);
    set32(L,13244,get32(L,13244)+cs);
    set32(L,13248,get32(L,13248)+cg);
  }
  c=o_app(b,c," goal=");
  c=o_i64(b,c,g_tag(G) as i64);
  c=o_app(b,c," st=");
  c=o_i64(b,c,st as i64);
  c=o_app(b,c," vers=");
  let nn2:i32=get32(vbuf,16);
  let p:i32=0;
  while(p<nn2){
    if(p>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(vbuf,p*4) as i64);
    p=p+1;
  }
  c=o_app(b,c," halt=");
  if(halt==0){ c=o_app(b,c,"conv"); }
  if(halt==1){ c=o_app(b,c,"osc"); }
  if(halt==2){ c=o_app(b,c,"cap"); }
  c=o_app(b,c," period=");
  c=o_i64(b,c,period as i64);
  c=o_app(b,c," ans=");
  let an:i32=get32(ans,0);
  c=o_i64(b,c,an as i64);
  b[c]=58; c=c+1;
  let k:i32=0;
  while(k<an){
    if(k>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(ans,4+k*4) as i64);
    k=k+1;
  }
  c=o_app(b,c," agree=");
  c=o_i64(b,c,a as i64);
  c=o_app(b,c," cs=");
  c=o_i64(b,c,cs as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  c=o_app(b,c," passes=");
  c=o_i64(b,c,get32(vbuf,20) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- topo probe: log the Kahn-placed count and stall flag ----
fn topo_probe(b:[]u8,c:i32,G:[]u8,tord:[]u8)i32 {
  let tpl:i32=topo_g(G,tord);
  let tnn:i32=g_nneeds(G);
  c=o_app(b,c,"TOPO goal=");
  c=o_i64(b,c,g_tag(G) as i64);
  c=o_app(b,c," placed=");
  c=o_i64(b,c,tpl as i64);
  b[c]=47; c=c+1;
  c=o_i64(b,c,tnn as i64);
  c=o_app(b,c," stall=");
  if(tpl==tnn){ c=o_app(b,c,"0"); }
  if(tpl!=tnn){ c=o_app(b,c,"1"); }
  c=o_nl(b,c);
  return c;
}
// ---- probe_close: independent generic cycle-closure check ----
// From the goal record's [rel, seed]: find the attractor cycle,
// then one fresh ret_gen on the last cycle value must return the
// first cycle value. Prints the cycle and close=1/0.
fn probe_close(b:[]u8,c:i32,A:[]u8,K:[]u8,G:[]u8,tout:[]u8,cyc:[]u8,drv_need:i32)i32 {
  let rel:i32=need_f(G,drv_need,0);
  let seed:i32=need_f(G,drv_need,1);
  set32(K,4,0);
  let ck:i32=oracle_attractor(A,rel,seed,K,tout,cyc);
  let close:i32=0;
  if(ck>0){
    let last:i32=get32(cyc,(ck-1)*4);
    let first:i32=get32(cyc,0);
    set32(K,4,0);
    let nr:i32=ret_gen(A,rel,last,K,4,tout,0);
    if(nr==1){
      if(get32(tout,4)==first){ close=1; }
    }
  }
  c=o_app(b,c,"PROBE close goal=");
  c=o_i64(b,c,g_tag(G) as i64);
  c=o_app(b,c," cyc=");
  c=o_i64(b,c,ck as i64);
  b[c]=58; c=c+1;
  let q:i32=0;
  while(q<ck){
    if(q>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(cyc,q*4) as i64);
    q=q+1;
  }
  c=o_app(b,c," close=");
  c=o_i64(b,c,close as i64);
  c=o_nl(b,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(256);
  let ans:[]u8=z_alloc(256);
  let vbuf:[]u8=z_alloc(32);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let seen:[]u8=z_alloc(320);
  let tord:[]u8=z_alloc(16);
  let cyc:[]u8=z_alloc(32);
  let nosc:i32=0;
  let nconv:i32=0;
  // S1A RET-LEARN (world A)
  setup_worldA(A);
  c=o_app(B,c,"STAGE S1A RET-LEARN"); c=o_nl(B,c);
  c=run_retep(B,c,L,A,K,rb,tout,0,0);
  c=run_retep(B,c,L,A,K,rb,tout,1,1);
  c=run_retep(B,c,L,A,K,rb,tout,2,2);
  c=run_retep(B,c,L,A,K,rb,tout,3,3);
  specialize_ret(L,A,0,3);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  // S1B VFY-LEARN (world A)
  c=o_app(B,c,"STAGE S1B VFY-LEARN"); c=o_nl(B,c);
  c=run_vfyep(B,c,L,A,K,Cb,0,4);
  c=run_vfyep(B,c,L,A,K,Cb,1,5);
  c=run_vfyep(B,c,L,A,K,Cb,2,6);
  c=run_vfyep(B,c,L,A,K,Cb,3,7);
  specialize_vfy(L,A,4,7);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S2 OSC-LEARN (period-2 workload): retrieve episodes on the
  // oscillatory relation (seed + both phases) and the seed pattern;
  // verify episode on the marker relation; re-specialize.
  c=o_app(B,c,"STAGE S2 OSC-LEARN"); c=o_nl(B,c);
  setup_worldD(A);
  c=run_retep(B,c,L,A,K,rb,tout,6,8);
  c=run_retep(B,c,L,A,K,rb,tout,7,9);
  c=run_retep(B,c,L,A,K,rb,tout,8,10);
  c=run_retep(B,c,L,A,K,rb,tout,2,11);
  specialize_ret(L,A,8,11);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  c=run_vfyep(B,c,L,A,K,Cb,6,12);
  specialize_vfy(L,A,12,12);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S3 OSC-SELFLOOP (period-2 self-loop, period-aware composer)
  c=o_app(B,c,"STAGE S3 OSC-SELFLOOP"); c=o_nl(B,c);
  mk_goal818_D0(G);
  c=topo_probe(B,c,G,tord);
  c=do_query_pd(B,c,L,A,K,G,ans,vbuf,seen,"O0",6,1,0);
  let h0:i32=get32(vbuf,24);
  if(h0==1){ nosc=nosc+1; }
  if(h0==0){ nconv=nconv+1; }
  c=dump_osc(B,c,L);
  c=dump_plans(B,c,L);
  c=dump_bind(B,c,L);
  // S4 OSC-2NODE (period-2 two-node cycle, period-aware composer)
  c=o_app(B,c,"STAGE S4 OSC-2NODE"); c=o_nl(B,c);
  mk_goal819_D1(G);
  c=topo_probe(B,c,G,tord);
  c=do_query_pd(B,c,L,A,K,G,ans,vbuf,seen,"O1",6,2,2);
  let h1:i32=get32(vbuf,24);
  if(h1==1){ nosc=nosc+1; }
  if(h1==0){ nconv=nconv+1; }
  c=dump_osc(B,c,L);
  c=dump_plans(B,c,L);
  // S5 OSC3-LEARN (period-3 workload): retrieve episodes on the
  // 3-cycle relation (seed + all three phases) and the seed
  // pattern; verify episode on the marker relation; re-specialize.
  // Then the period-3 self-loop goal.
  c=o_app(B,c,"STAGE S5 OSC3-LEARN"); c=o_nl(B,c);
  setup_worldE(A);
  c=run_retep(B,c,L,A,K,rb,tout,9,13);
  c=run_retep(B,c,L,A,K,rb,tout,10,14);
  c=run_retep(B,c,L,A,K,rb,tout,11,15);
  c=run_retep(B,c,L,A,K,rb,tout,12,16);
  c=run_retep(B,c,L,A,K,rb,tout,2,17);
  specialize_ret(L,A,13,17);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  c=run_vfyep(B,c,L,A,K,Cb,7,18);
  specialize_vfy(L,A,18,18);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  mk_goal820_E2(G);
  c=topo_probe(B,c,G,tord);
  c=do_query_pd(B,c,L,A,K,G,ans,vbuf,seen,"O2",6,1,0);
  let h2:i32=get32(vbuf,24);
  if(h2==1){ nosc=nosc+1; }
  if(h2==0){ nconv=nconv+1; }
  c=dump_osc(B,c,L);
  c=dump_plans(B,c,L);
  // S6 CYCLE-LEARN-C (world C): the convergent control workload.
  c=o_app(B,c,"STAGE S6 CYCLE-LEARN-C"); c=o_nl(B,c);
  setup_worldC(A);
  c=run_retep(B,c,L,A,K,rb,tout,4,19);
  c=run_retep(B,c,L,A,K,rb,tout,5,20);
  c=run_retep(B,c,L,A,K,rb,tout,2,21);
  specialize_ret(L,A,19,21);
  c=spec_line_ret(B,c,L);
  c=dump_lstate_ret(B,c,L);
  c=run_vfyep(B,c,L,A,K,Cb,4,22);
  specialize_vfy(L,A,22,22);
  c=spec_line_vfy(B,c,L);
  c=dump_lstate_vfy(B,c,L);
  // S7 CONV-SELFLOOP (world C, period-aware composer)
  c=o_app(B,c,"STAGE S7 CONV-SELFLOOP"); c=o_nl(B,c);
  mk_goal816_C0(G);
  c=topo_probe(B,c,G,tord);
  c=do_query_pd(B,c,L,A,K,G,ans,vbuf,seen,"C0",2,1,0);
  let h3:i32=get32(vbuf,24);
  if(h3==1){ nosc=nosc+1; }
  if(h3==0){ nconv=nconv+1; }
  c=dump_osc(B,c,L);
  c=dump_plans(B,c,L);
  // S8 PROBES: independent generic cycle-closure checks for the
  // three oscillatory goals (rel/seed read from goal records;
  // each probe re-loads its goal's world first), plus the
  // convergent fixpoint probe.
  c=o_app(B,c,"STAGE S8 PROBES"); c=o_nl(B,c);
  setup_worldD(A);
  mk_goal818_D0(G);
  c=probe_close(B,c,A,K,G,tout,cyc,1);
  mk_goal819_D1(G);
  c=probe_close(B,c,A,K,G,tout,cyc,2);
  setup_worldE(A);
  mk_goal820_E2(G);
  c=probe_close(B,c,A,K,G,tout,cyc,1);
  setup_worldC(A);
  mk_goal816_C0(G);
  let crel:i32=need_f(G,1,0);
  let cobj:i32=need_f(G,1,1);
  set32(K,0,0);
  let fx:i32=walk_fix(A,crel,cobj,K,tout);
  set32(K,0,0);
  let nnx:i32=ret_gen(A,crel,fx,K,0,tout,0);
  let sx:i32=get32(tout,4);
  let stb:i32=0;
  if(sx==fx){ stb=1; }
  c=o_app(B,c,"PROBE fixpoint fix=");
  c=o_i64(B,c,fx as i64);
  c=o_app(B,c," next=");
  c=o_i64(B,c,sx as i64);
  c=o_app(B,c," stable=");
  c=o_i64(B,c,stb as i64);
  c=o_nl(B,c);
  // SUMMARY-PD
  c=o_app(B,c,"SUMMARY-PD agree=");
  c=o_i64(B,c,get32(L,13240) as i64);
  c=o_app(B,c," plans_built=");
  c=o_i64(B,c,get32(L,13224) as i64);
  c=o_app(B,c," plans_loaded=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," trials=");
  c=o_i64(B,c,get32(L,13232) as i64);
  c=o_app(B,c," declines=");
  c=o_i64(B,c,get32(L,13236) as i64);
  c=o_app(B,c," cs=");
  c=o_i64(B,c,get32(L,13244) as i64);
  c=o_app(B,c," cg=");
  c=o_i64(B,c,get32(L,13248) as i64);
  c=o_app(B,c," rs=");
  c=o_i64(B,c,get32(L,13252) as i64);
  c=o_app(B,c," rg=");
  c=o_i64(B,c,get32(L,13256) as i64);
  c=o_app(B,c," vs=");
  c=o_i64(B,c,get32(L,13260) as i64);
  c=o_app(B,c," vg=");
  c=o_i64(B,c,get32(L,13264) as i64);
  c=o_app(B,c," oschalts=");
  c=o_i64(B,c,nosc as i64);
  c=o_app(B,c," convhalts=");
  c=o_i64(B,c,nconv as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

// Weak K-LT-5 CLEAN: C3b frozen discrimination (reduced N=5, budget-feasible).
// The N=10 frozen control hit the budget wall (1022 nodes, trial collapse).
// This C3b uses N=5 per phase to stay within budget and measure R_f cleanly.
// Deviation from prereg N=10 is documented in CLEAN_EVAL.md.

fn main()i32 {
  let PS:[]u8=z_alloc(80); wkl_ps_fill(PS);
  let W:[]u8=z_alloc(110656); wkl_setup(W);
  emit("live-after-teach="); e64(wkl_live(W)); emit("\n");
  let EA:i32=wkl_probes(W,PS,0,5,"A");
  emit("E(A_frozen)="); e64(EA); emit("\n");
  emit("live-after-A="); e64(wkl_live(W)); emit("\n");
  let EB:i32=wkl_probes(W,PS,10,15,"B");
  emit("E(B_frozen)="); e64(EB); emit("\n");
  emit("live-after-B="); e64(wkl_live(W)); emit("\n");
  if(EB>0){ emit("R100_frozen="); e64(EA*100/EB); emit("\n"); }
  else { emit("R100_frozen=INF\n"); }
  emit("WKL2-C3B-DONE\n");
  return 0;
}

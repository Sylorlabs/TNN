// Weak K-LT-5 CLEAN: C2 causal ablation.
// Phase A, then reset ONLY the policy node to initial order, then Phase B.

fn wkl_emit_policy(W:[]u8)void {
  let pol:i32=h3n1_find_policy(W);
  emit("policy: ");
  if(pol<0){ emit("none\n"); return; }
  let s:i32=0;
  while(s<6){ e64(ng(W,pol,8+s*4)); if(s<5){emit(",");} s=s+1; }
  emit(" rej="); e64(ng(W,pol,32)); emit("\n");
  return;
}

fn wkl_reset_policy(W:[]u8)void {
  let pol:i32=h3n1_find_policy(W);
  if(pol<0){ emit("reset: no policy node\n"); return; }
  ns(W,pol,8,0); ns(W,pol,12,1); ns(W,pol,16,2);
  ns(W,pol,20,3); ns(W,pol,24,4); ns(W,pol,28,5);
  ns(W,pol,32,0);
  emit("reset done: "); wkl_emit_policy(W);
  return;
}

fn main()i32 {
  let PS:[]u8=z_alloc(80); wkl_ps_fill(PS);
  let W:[]u8=z_alloc(110656); wkl_setup(W);
  emit("live-after-teach="); e64(wkl_live(W)); emit("\n");
  let EA:i32=wkl_probes(W,PS,0,10,"A");
  emit("E(A)="); e64(EA); emit(" "); wkl_emit_policy(W);
  emit("live-after-A="); e64(wkl_live(W)); emit("\n");
  wkl_reset_policy(W);
  let EB:i32=wkl_probes(W,PS,10,20,"B");
  emit("E(B_abl)="); e64(EB); emit(" "); wkl_emit_policy(W);
  emit("live-after-B="); e64(wkl_live(W)); emit("\n");
  emit("WKL2-C2-DONE\n");
  return 0;
}

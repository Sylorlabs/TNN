// bounded_pin.zag -- BOUNDED-PIN-LIFETIME comparison.
// Unbounded pinning (policy 3, PINR: exact MULTI-OWNER-CHURN policy 2
// replica) vs bounded pin lifetime (policies 4/5/6, PINTTL with
// N=10/50/100) vs explicit owner-scoped unpin (policy 7, PINUNPIN),
// under the frozen multi-owner churn adversary (M2: 2 owners, M3:
// 3 owners, w=21 writes per key). See PREREG.md for the frozen design,
// derivation notes, and kill bars.
//
// Header: 0 bumpA (unused), 4 conflicts, 8 evictions, 12
// table_full_errors, 16 pool_size (=32), 20 policy, 24 bumpB (unused),
// 28 drop, 32 pin_ttl_N, 36 clock (pin-creation tick, incremented on
// every pool placement).
// Primary: 64, 128 slots x 16 bytes. Pool: 2112, 32 slots x 16 bytes.
// Pin side table: 2624, 32 x 4 bytes (created tick per pool slot;
// -1 means unpinned under policy 7).
//
// One operation = one pool placement. A TTL pin expires when
// (clock - created) >= N. An unpinned entry (created < 0) is
// reclaimable immediately under policy 7.
//
// Toolchain notes: u8-backed cells with put32/ig helpers; output via one
// preallocated buffer plus a single _zag_raw_syscall write; if nesting at
// most 3; no negated conjunctions in while conditions.

// ---------- cell helpers ----------
fn put32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ig(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}

// ---------- output: one buffer, one syscall ----------
fn e1s(ob:[]u8,s:[]u8)void {
  let cur:i32=ig(ob,0);
  let i:i32=0;
  while(i<s.len){ob[16+cur+i]=s[i];i=i+1;}
  put32(ob,0,cur+s.len);
  return;
}
fn e1i(ob:[]u8,v:i64)void {
  let cur:i32=ig(ob,0);
  let n:i64=v;
  if(n<0){ob[16+cur]=45;cur=cur+1;n=-n;}
  let nd:i32=0;
  if(n==0){nd=1;}
  let t:i64=n;
  while(t>0){nd=nd+1;t=t/10;}
  let e:i32=cur+nd;
  let p:i32=e-1;
  let m:i64=n;
  if(m==0){ob[16+p]=48;}
  while(m>0){ob[16+p]=(48+(m%10)) as u8;p=p-1;m=m/10;}
  put32(ob,0,e);
  return;
}
fn flush(ob:[]u8)void {
  let cur:i32=ig(ob,0);
  let ptr:i64=(_zag_slice_ptr(ob) as i64)+16;
  _zag_raw_syscall(1,1,ptr,cur as i64,0,0,0);
  return;
}
fn pf(v:i32)[]u8 {
  if(v==1){return "PASS";}
  return "FAIL";
}

// ---------- memory layout ----------
fn soff(base:i32,idx:i32)i32 { return base+idx*16; }
fn mem_zero(M:[]u8)void {
  let i:i32=0;
  while(i<4096){put32(M,i,0);i=i+4;}
  return;
}
fn hfn(key:i32)i32 {
  let h:i64=(key as i64)*2654435761;
  h=h%2147483647;
  if(h<0){h=-h;}
  return (h%128) as i32;
}
// Stamp the pin-created tick for pool slot s, then advance the clock.
fn pin_stamp(M:[]u8,s:i32)void {
  put32(M,2624+s*4,ig(M,36));
  put32(M,36,ig(M,36)+1);
  return;
}
// First free pool slot, or -1 when the pool is full.
fn free_slot(M:[]u8)i32 {
  let s:i32=0;
  while(s<32){
    if(ig(M,soff(2112,s)+12)==0){return s;}
    s=s+1;
  }
  return -1;
}
// Install the victim in pool slot s and stamp its pin-created tick.
fn place_at(M:[]u8,s:i32,key:i32,vv:i32,vo:i32)void {
  let oo:i32=soff(2112,s);
  put32(M,oo,key); put32(M,oo+4,vv);
  put32(M,oo+8,vo); put32(M,oo+12,1);
  pin_stamp(M,s);
  return;
}
// Policy relocation for the conflict victim at primary slot so.
// Caller has already counted the conflict. After this returns, the
// caller installs the new value in the primary slot.
fn relocate(M:[]u8,so:i32)void {
  let pol:i32=ig(M,20);
  let key:i32=ig(M,so);
  let vv:i32=ig(M,so+4);
  let vo:i32=ig(M,so+8);
  let fr:i32=free_slot(M);
  if(fr>=0){
    // Free slot: identical placement in every policy.
    place_at(M,fr,key,vv,vo);
    return;
  }
  if(pol==3){
    // PINR: unbounded pinning, exact parent PIN path. The pool is
    // full of pinned entries: drop++ and destroy-in-place fallback.
    // (The side table is stamped but never consulted.)
    put32(M,28,ig(M,28)+1);
    return;
  }
  if(pol==7){
    // PINUNPIN: the pool is full; reclaim the first used slot whose
    // pin was explicitly released (created < 0). drop++ if none is
    // unpinned.
    let s:i32=0;
    let found:i32=-1;
    while(s<32){
      let oo:i32=soff(2112,s);
      let used:i32=ig(M,oo+12);
      let rel:i32=0;
      if(used==1){
        if(ig(M,2624+s*4)<0){rel=1;}
      }
      if(found<0){
        if(rel==1){found=s;}
      }
      s=s+1;
    }
    if(found<0){
      put32(M,28,ig(M,28)+1);
      return;
    }
    put32(M,8,ig(M,8)+1);
    place_at(M,found,key,vv,vo);
    return;
  }
  // PINTTL (policies 4/5/6): the pool is full; reclaim the first used
  // slot whose pin has expired, i.e. (clock - created) >= N. drop++
  // if none is expired.
  let s:i32=0;
  let found:i32=-1;
  while(s<32){
    let oo:i32=soff(2112,s);
    let used:i32=ig(M,oo+12);
    let exp:i32=0;
    if(used==1){
      let age:i32=ig(M,36)-ig(M,2624+s*4);
      if(age>=ig(M,32)){exp=1;}
    }
    if(found<0){
      if(exp==1){found=s;}
    }
    s=s+1;
  }
  if(found<0){
    put32(M,28,ig(M,28)+1);
    return;
  }
  put32(M,8,ig(M,8)+1);
  place_at(M,found,key,vv,vo);
  return;
}
// Explicit owner-scoped unpin: release every used pool entry with
// slot.key == key and (slot.owner & mask) != 0 by setting its created
// tick to -1. An owner can only unpin entries it owns.
fn pool_unpin(M:[]u8,key:i32,mask:i32)void {
  let s:i32=0;
  while(s<32){
    let oo:i32=soff(2112,s);
    let used:i32=ig(M,oo+12);
    let km:i32=0;
    let om:i32=0;
    if(used==1){
      if(ig(M,oo)==key){km=1;}
    }
    if(used==1){
      if((ig(M,oo+8)&mask)!=0){om=1;}
    }
    let hit:i32=km&om;
    if(hit==1){put32(M,2624+s*4,-1);}
    s=s+1;
  }
  return;
}
fn mem_write(M:[]u8,key:i32,val:i32,owner:i32)void {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==0){
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner); put32(M,so+12,1);
      return;
    }
    if(ig(M,so)==key){
      let vv:i32=ig(M,so+4);
      if(vv==val){
        put32(M,so+8,ig(M,so+8)|owner);
        return;
      }
      // CONFLICT: same key, different val. Counted identically in all
      // policies; only the relocation outcome is policy-dependent.
      put32(M,4,ig(M,4)+1);
      relocate(M,so);
      put32(M,so,key); put32(M,so+4,val); put32(M,so+8,owner);
      return;
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  put32(M,12,ig(M,12)+1);
  return;
}
fn mem_read(M:[]u8,key:i32,owner:i32)i32 {
  let i:i32=hfn(key);
  let t:i32=0;
  while(t<128){
    let so:i32=soff(64,i);
    let u:i32=ig(M,so+12);
    if(u==1 && ig(M,so)==key){
      if((ig(M,so+8)&owner)!=0){return ig(M,so+4);}
    }
    i=i+1;
    if(i>=128){i=0;}
    t=t+1;
  }
  let pn:i32=ig(M,16);
  let o:i32=0;
  while(o<pn){
    let oo:i32=soff(2112,o);
    if(ig(M,oo+12)==1 && ig(M,oo)==key){
      if((ig(M,oo+8)&owner)!=0){return ig(M,oo+4);}
    }
    o=o+1;
  }
  return -1;
}

// ---------- structures ----------
// ka(i,hop)=1000+i*10+hop ; va(i,hop)=i*100+hop*7
// owners: A_BASE=1 A_EXT=2 A_SPEC=4 A_TRUNC=8 B=16
fn teach_A(M:[]u8,multi:i32)void {
  let i:i32=1;
  while(i<=10){
    mem_write(M,1000+i*10+1,i*100+7,1);
    mem_write(M,1000+i*10+2,i*100+14,1);
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,2);
      mem_write(M,1000+i*10+2,i*100+14,2);
      mem_write(M,1000+i*10+3,i*100+21,2);
      i=i+1;
    }
    i=1;
    while(i<=5){
      mem_write(M,1000+i*10+1,i*100+7,4);
      mem_write(M,1000+i*10+2,i*100+14,4);
      mem_write(M,2000+i,9000+i,4);
      i=i+1;
    }
    i=1;
    while(i<=10){
      mem_write(M,1000+i*10+1,i*100+7,8);
      i=i+1;
    }
  }
  return;
}
// B = interface-adapted template; cond=2 (FULL): all 20 keys overlap A's.
fn teach_B(M:[]u8,cond:i32)void {
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=3000+i*10+hop;
      let v:i32=555000+i*10+hop;
      if(cond==2){k=1000+i*10+hop;v=777000+i*10+hop;}
      mem_write(M,k,v,16);
      hop=hop+1;
    }
    i=i+1;
  }
  return;
}
// churn adversary, multi-owner (frozen from the parent lane).
// mode=1 (M2): keys 3998 (owner 8) and 3999 (owner 16), interleaved per
// round as 3998 then 3999. mode=2 (M3): adds key 3997 (owner 4) as the
// first write of each round. w writes per key; churn relocations =
// keys*(w-1). When unp==1 (policy 7 protocol), each round ends with
// unpin(3999,16): the B-owner releases its own key's stale entries.
fn teach_churn_multi(M:[]u8,mode:i32,w:i32,unp:i32)void {
  let j:i32=0;
  while(j<w){
    if(mode==2){mem_write(M,3997,700001+j,4);}
    mem_write(M,3998,800001+j,8);
    mem_write(M,3999,900001+j,16);
    if(unp==1){pool_unpin(M,3999,16);}
    j=j+1;
  }
  return;
}
fn test_A(M:[]u8,multi:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7 && mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  if(multi==1){
    i=1;
    while(i<=10){
      let a:i32=mem_read(M,1000+i*10+1,2);
      let b:i32=mem_read(M,1000+i*10+2,2);
      let c:i32=mem_read(M,1000+i*10+3,2);
      if(a==i*100+7 && b==i*100+14 && c==i*100+21){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=5){
      let g:i32=mem_read(M,2000+i,4);
      let a2:i32=mem_read(M,1000+i*10+1,4);
      let b2:i32=mem_read(M,1000+i*10+2,4);
      if(g==9000+i && a2==i*100+7 && b2==i*100+14){ok=ok+1;}
      i=i+1;
    }
    i=1;
    while(i<=10){
      if(mem_read(M,1000+i*10+1,8)==i*100+7){ok=ok+1;}
      i=i+1;
    }
  }
  return ok;
}
// rawA: key-level owner-scoped survival over A's 35 distinct keys
// (diagnostic, not kill-barred).
fn test_A_raw(M:[]u8)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+1,1)==i*100+7){ok=ok+1;}
    if(mem_read(M,1000+i*10+2,1)==i*100+14){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=10){
    if(mem_read(M,1000+i*10+3,2)==i*100+21){ok=ok+1;}
    i=i+1;
  }
  i=1;
  while(i<=5){
    if(mem_read(M,2000+i,4)==9000+i){ok=ok+1;}
    i=i+1;
  }
  return ok;
}
fn test_B(M:[]u8,cond:i32)i32 {
  let ok:i32=0;
  let i:i32=1;
  while(i<=10){
    let hop:i32=1;
    while(hop<=2){
      let k:i32=1000+i*10+hop;
      let v:i32=777000+i*10+hop;
      if(cond!=2){k=3000+i*10+hop;v=555000+i*10+hop;}
      if(mem_read(M,k,16)==v){ok=ok+1;}
      hop=hop+1;
    }
    i=i+1;
  }
  return ok;
}
// R layout per condition (32 bytes): 0 pre, 4 post, 8 ret, 12 conflicts,
// 16 evict, 20 bacc, 24 rawA, 28 drop
fn run_cond(M:[]u8,OB:[]u8,pol:i32,cmode:i32,ttln:i32,unp:i32,tag:[]u8,R:[]u8,ro:i32)void {
  mem_zero(M);
  put32(M,16,32);
  put32(M,20,pol);
  put32(M,32,ttln);
  teach_A(M,1);
  let pre:i32=test_A(M,1);
  teach_B(M,2);
  teach_churn_multi(M,cmode,21,unp);
  let post:i32=test_A(M,1);
  let bacc:i32=test_B(M,2);
  let raw:i32=test_A_raw(M);
  let cf:i32=ig(M,4);
  let ev:i32=ig(M,8);
  let dr:i32=ig(M,28);
  let ret:i32=0;
  if(pre>0){ret=(100*post)/pre;}
  put32(R,ro,pre); put32(R,ro+4,post); put32(R,ro+8,ret);
  put32(R,ro+12,cf); put32(R,ro+16,ev); put32(R,ro+20,bacc);
  put32(R,ro+24,raw); put32(R,ro+28,dr);
  e1s(OB,tag);
  e1s(OB," policy="); e1i(OB,pol as i64);
  if(cmode==1){e1s(OB," keys=2");}
  if(cmode==2){e1s(OB," keys=3");}
  e1s(OB," ttl="); e1i(OB,ttln as i64);
  e1s(OB," pre="); e1i(OB,pre as i64);
  e1s(OB," post="); e1i(OB,post as i64);
  e1s(OB," ret="); e1i(OB,ret as i64);
  e1s(OB," conflicts="); e1i(OB,cf as i64);
  e1s(OB," evict="); e1i(OB,ev as i64);
  e1s(OB," drop="); e1i(OB,dr as i64);
  e1s(OB," bacc="); e1i(OB,bacc as i64);
  e1s(OB," rawA="); e1i(OB,raw as i64);
  e1s(OB,"\n");
  return;
}
fn main()i32 {
  let M:[]u8=z_alloc(4096);
  let OB:[]u8=z_alloc(8192);
  put32(OB,0,0);
  let R:[]u8=z_alloc(512);
  e1s(OB,"LANE=BOUNDED-PIN-LIFETIME\n");
  run_cond(M,OB,3,1,0,0,"COND=PINR-M2",R,0);
  run_cond(M,OB,3,2,0,0,"COND=PINR-M3",R,32);
  run_cond(M,OB,4,1,10,0,"COND=TTL10-M2",R,64);
  run_cond(M,OB,4,2,10,0,"COND=TTL10-M3",R,96);
  run_cond(M,OB,5,1,50,0,"COND=TTL50-M2",R,128);
  run_cond(M,OB,5,2,50,0,"COND=TTL50-M3",R,160);
  run_cond(M,OB,6,1,100,0,"COND=TTL100-M2",R,192);
  run_cond(M,OB,6,2,100,0,"COND=TTL100-M3",R,224);
  run_cond(M,OB,7,1,0,1,"COND=UNPIN-M2",R,256);
  run_cond(M,OB,7,2,0,1,"COND=UNPIN-M3",R,288);
  // K1 BASELINE: pre==35 and bacc==20 in all 10 conditions.
  let k1:i32=1;
  let c:i32=0;
  while(c<10){
    if(ig(R,c*32)!=35){k1=0;}
    if(ig(R,c*32+20)!=20){k1=0;}
    c=c+1;
  }
  e1s(OB,"K1 BASELINE pre==35 bacc==20 x10 -> "); e1s(OB,pf(k1)); e1s(OB,"\n");
  // K2 PINR-REPRO: PINR rows match the frozen MULTI-OWNER-CHURN PIN row.
  // cond0 PINR-M2: ret 100, ev 0, drop 28, cf 60, post 35, rawA 35.
  // cond1 PINR-M3: ret 100, ev 0, drop 48, cf 80, post 35, rawA 35.
  let k2:i32=1;
  if(ig(R,8)!=100||ig(R,16)!=0||ig(R,28)!=28||ig(R,12)!=60||ig(R,4)!=35||ig(R,24)!=35){k2=0;}
  if(ig(R,40)!=100||ig(R,48)!=0||ig(R,60)!=48||ig(R,44)!=80||ig(R,36)!=35||ig(R,56)!=35){k2=0;}
  e1s(OB,"K2 PINR-REPRO m2(ret,ev,drop)=["); e1i(OB,ig(R,8) as i64);
  e1s(OB,","); e1i(OB,ig(R,16) as i64);
  e1s(OB,","); e1i(OB,ig(R,28) as i64);
  e1s(OB,"] m3=["); e1i(OB,ig(R,40) as i64);
  e1s(OB,","); e1i(OB,ig(R,48) as i64);
  e1s(OB,","); e1i(OB,ig(R,60) as i64);
  e1s(OB,"] need=[100,0,28],[100,0,48] -> ");
  e1s(OB,pf(k2)); e1s(OB,"\n");
  // K3 TTL10-FIFO-EQUIV: TTL10 rows == frozen FIFO-M2/FIFO-M3 footprint.
  // cond2 TTL10-M2: ret 0, ev 28, drop 0, cf 60, rawA 15.
  // cond3 TTL10-M3: ret 0, ev 48, drop 0, cf 80, rawA 15.
  let k3:i32=1;
  if(ig(R,72)!=0||ig(R,80)!=28||ig(R,92)!=0||ig(R,76)!=60||ig(R,88)!=15){k3=0;}
  if(ig(R,104)!=0||ig(R,112)!=48||ig(R,124)!=0||ig(R,108)!=80||ig(R,120)!=15){k3=0;}
  e1s(OB,"K3 TTL10-FIFO-EQUIV m2(ret,ev,drop,rawA)=["); e1i(OB,ig(R,72) as i64);
  e1s(OB,","); e1i(OB,ig(R,80) as i64);
  e1s(OB,","); e1i(OB,ig(R,92) as i64);
  e1s(OB,","); e1i(OB,ig(R,88) as i64);
  e1s(OB,"] m3=["); e1i(OB,ig(R,104) as i64);
  e1s(OB,","); e1i(OB,ig(R,112) as i64);
  e1s(OB,","); e1i(OB,ig(R,124) as i64);
  e1s(OB,","); e1i(OB,ig(R,120) as i64);
  e1s(OB,"] need=[0,28,0,15],[0,48,0,15] -> ");
  e1s(OB,pf(k3)); e1s(OB,"\n");
  // K4 TTL50-PARTIAL.
  // cond4 TTL50-M2: post 20, ret 57, ev 10, drop 18, rawA 25, cf 60.
  // cond5 TTL50-M3: post 0, ret 0, ev 30, drop 18, rawA 15, cf 80.
  let k4:i32=1;
  if(ig(R,132)!=20||ig(R,136)!=57||ig(R,144)!=10||ig(R,156)!=18||ig(R,152)!=25||ig(R,140)!=60){k4=0;}
  if(ig(R,164)!=0||ig(R,168)!=0||ig(R,176)!=30||ig(R,188)!=18||ig(R,184)!=15||ig(R,172)!=80){k4=0;}
  e1s(OB,"K4 TTL50-PARTIAL m2(post,ret,ev,drop,rawA)=["); e1i(OB,ig(R,132) as i64);
  e1s(OB,","); e1i(OB,ig(R,136) as i64);
  e1s(OB,","); e1i(OB,ig(R,144) as i64);
  e1s(OB,","); e1i(OB,ig(R,156) as i64);
  e1s(OB,","); e1i(OB,ig(R,152) as i64);
  e1s(OB,"] m3=["); e1i(OB,ig(R,164) as i64);
  e1s(OB,","); e1i(OB,ig(R,168) as i64);
  e1s(OB,","); e1i(OB,ig(R,176) as i64);
  e1s(OB,","); e1i(OB,ig(R,188) as i64);
  e1s(OB,","); e1i(OB,ig(R,184) as i64);
  e1s(OB,"] need=[20,57,10,18,25],[0,0,30,18,15] -> ");
  e1s(OB,pf(k4)); e1s(OB,"\n");
  // K5 TTL100-NORECLAIM-EQUIV: TTL100 rows == PINR rows exactly.
  let k5:i32=1;
  if(ig(R,200)!=100||ig(R,208)!=0||ig(R,220)!=28||ig(R,204)!=60){k5=0;}
  if(ig(R,232)!=100||ig(R,240)!=0||ig(R,252)!=48||ig(R,236)!=80){k5=0;}
  e1s(OB,"K5 TTL100-NORECLAIM-EQUIV m2(ret,ev,drop)=["); e1i(OB,ig(R,200) as i64);
  e1s(OB,","); e1i(OB,ig(R,208) as i64);
  e1s(OB,","); e1i(OB,ig(R,220) as i64);
  e1s(OB,"] m3=["); e1i(OB,ig(R,232) as i64);
  e1s(OB,","); e1i(OB,ig(R,240) as i64);
  e1s(OB,","); e1i(OB,ig(R,252) as i64);
  e1s(OB,"] need=[100,0,28],[100,0,48] -> ");
  e1s(OB,pf(k5)); e1s(OB,"\n");
  // K6 UNPIN-PARTIAL.
  // cond8 UNPIN-M2: ret 100, ev 11, drop 17, rawA 35, cf 60.
  // cond9 UNPIN-M3: ret 100, ev 5, drop 43, rawA 35, cf 80.
  let k6:i32=1;
  if(ig(R,264)!=100||ig(R,272)!=11||ig(R,284)!=17||ig(R,280)!=35||ig(R,268)!=60){k6=0;}
  if(ig(R,296)!=100||ig(R,304)!=5||ig(R,316)!=43||ig(R,312)!=35||ig(R,300)!=80){k6=0;}
  e1s(OB,"K6 UNPIN-PARTIAL m2(ret,ev,drop,rawA)=["); e1i(OB,ig(R,264) as i64);
  e1s(OB,","); e1i(OB,ig(R,272) as i64);
  e1s(OB,","); e1i(OB,ig(R,284) as i64);
  e1s(OB,","); e1i(OB,ig(R,280) as i64);
  e1s(OB,"] m3=["); e1i(OB,ig(R,296) as i64);
  e1s(OB,","); e1i(OB,ig(R,304) as i64);
  e1s(OB,","); e1i(OB,ig(R,316) as i64);
  e1s(OB,","); e1i(OB,ig(R,312) as i64);
  e1s(OB,"] need=[100,11,17,35],[100,5,43,35] -> ");
  e1s(OB,pf(k6)); e1s(OB,"\n");
  // K7 ADV-FIXED: cf==60 in all five M2 conditions, cf==80 in all
  // five M3 conditions. M2 conds are even indices 0,2,4,6,8;
  // M3 conds are odd indices 1,3,5,7,9.
  let k7:i32=1;
  c=0;
  while(c<10){
    let want:i32=80;
    if((c%2)==0){want=60;}
    if(ig(R,c*32+12)!=want){k7=0;}
    c=c+1;
  }
  e1s(OB,"K7 ADV-FIXED cf per dose policy-invariant -> "); e1s(OB,pf(k7)); e1s(OB,"\n");
  e1s(OB,"K8 DETERMINISM external: sha256 across 3 runs\n");
  let all:i32=0;
  if(k1==1 && k2==1 && k3==1 && k4==1 && k5==1 && k6==1 && k7==1){all=1;}
  e1s(OB,"VERDICT="); e1s(OB,pf(all)); e1s(OB,"\n");
  flush(OB);
  return 0;
}

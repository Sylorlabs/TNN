// BORROW PHASE 3-SELECTION + PHASE 4 TRANSFER + PHASE 5 REVISION
// Addresses the boundary isolated by C1541: applicability contracts are
// necessary but NOT sufficient -- selection among applicable structures is a
// separate capability. Competing hypotheses:
//   H-CONTRACT-ONLY  contracts alone, no consequence   <- expected to fail
//   H2 / H7          consequence-adapted selection      <- under test
// Declared limitation: structure search covers lengths 1..3 (MAXQ=3).
// Scratch frames are caller-allocated and reused; exec allocates nothing.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn STRS()i32 { return 48; }
fn EXLIM()i32 { return 64; }
fn MAXQ()i32 { return 3; }
fn MAXN()i32 { return 300; }
fn FAILV()i32 { return -999999; }
fn T_ADD()i32 { return 2; }
fn T_ADD2()i32 { return 3; }
fn T_GUARD()i32 { return 4; }
fn T_SET()i32 { return 5; }
fn T_OUT()i32 { return 6; }

fn ntag(W:[]u8,n:i32)i32 { return get32(W,n*STRS()); }
fn nset(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,n*STRS()+f*4,v); return; }
fn nget(W:[]u8,n:i32,f:i32)i32 { return get32(W,n*STRS()+f*4); }
fn reset_graph(W:[]u8)void {
  let i:i32=0; while(i<MAXN()){ set32(W,i*STRS()+36,0); i=i+1; } return;
}
fn newnode(W:[]u8)i32 {
  let i:i32=1;
  while(i<MAXN()){ if(get32(W,i*STRS()+36)==0){ set32(W,i*STRS()+36,1); return i; } i=i+1; }
  return -1;
}

// executes into caller scratch; allocates nothing
fn exec(W:[]u8,root:i32,i0:i32,i1:i32,fr:[]u8,out:[]u8)void {
  set32(out,0,FAILV());
  if(root<0){ return; }
  let k:i32=0; while(k<8){ set32(fr,k*4,0); k=k+1; }
  set32(fr,0,i0); set32(fr,4,i1);
  let cur:i32=root; let steps:i32=0; let os:i32=-1;
  while(cur>=0 && steps<EXLIM()){
    let t:i32=ntag(W,cur);
    if(t==T_ADD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,get32(fr,a*4)+b); }
    if(t==T_ADD2()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); let cc:i32=nget(W,cur,3);
      set32(fr,a*4,get32(fr,a*4)+get32(fr,b*4)+cc); }
    if(t==T_GUARD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2);
      if(get32(fr,a*4)!=b){ return; } }
    if(t==T_SET()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,b); }
    if(t==T_OUT()){ os=nget(W,cur,1); }
    cur=nget(W,cur,5);
    steps=steps+1;
  }
  if(os<0){ return; }
  set32(out,0,get32(fr,os*4));
  return;
}

fn vclass(FA:[]u8,FC:[]u8,nf:i32,v:i32)i32 {
  let c:i32=0; let i:i32=0;
  while(i<nf){ if(get32(FA,i*4)==v){ c=c+1; } if(get32(FC,i*4)==v){ c=c+2; } i=i+1; }
  return c;
}

fn nvoc()i32 { return 10; }
fn vtag(i:i32)i32 {
  if(i==6){return T_GUARD();} if(i==7){return T_SET();}
  if(i<=5){return T_ADD();} return T_OUT();
}
fn vslot(i:i32)i32 {
  if(i<=6){return 0;} if(i==7){return 1;} if(i==8){return 0;} return 1;
}
fn vlit(i:i32)i32 {
  if(i==0){return 1;} if(i==1){return -1;} if(i==2){return 100;} if(i==3){return -98;}
  if(i==4){return 98;} if(i==5){return -100;} if(i==6){return 121;} if(i==7){return 10;}
  if(i==8){return 0;} return 1;
}
fn build_seq(W:[]u8,seq:[]u8,n:i32)i32 {
  let first:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<n){
    let vi:i32=get32(seq,i*4);
    let nd:i32=newnode(W);
    if(nd<0){ return -1; }
    nset(W,nd,0,vtag(vi)); nset(W,nd,1,vslot(vi)); nset(W,nd,2,vlit(vi));
    nset(W,nd,3,0); nset(W,nd,4,0); nset(W,nd,5,-1);
    if(prev>=0){ nset(W,prev,5,nd); } else { first=nd; }
    prev=nd; i=i+1;
  }
  return first;
}
fn fits(W:[]u8,train:[]u8,nt:i32,root:i32,fr:[]u8,out:[]u8)i32 {
  let i:i32=0;
  while(i<nt){
    exec(W,root,get32(train,i*12),get32(train,i*12+4),fr,out);
    if(get32(out,0)!=get32(train,i*12+8)){ return 0; }
    i=i+1;
  }
  return 1;
}
fn learn(W:[]u8,train:[]u8,nt:i32,fr:[]u8,out:[]u8)[]u8 {
  let res:[]u8=z_alloc(8); set32(res,0,-1); set32(res,4,0);
  let nv:i32=nvoc();
  let seq:[]u8=z_alloc(4*MAXQ());
  let best:[]u8=z_alloc(4*MAXQ());
  let bn:i32=0;
  let L:i32=1;
  while(L<=MAXQ() && bn==0){
    let a:i32=0;
    while(a<nv && bn==0){
      let b:i32=0;
      while(b<nv && bn==0){
        let c:i32=0;
        while(c<nv && bn==0){
          set32(seq,0,a); set32(seq,4,b); set32(seq,8,c);
          reset_graph(W);
          let root:i32=build_seq(W,seq,L);
          if(root>=0 && fits(W,train,nt,root,fr,out)==1){
            set32(best,0,a); set32(best,4,b); set32(best,8,c); bn=L;
          }
          c=c+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    if(bn>0){ break; }
    L=L+1;
  }
  if(bn==0){ return res; }
  reset_graph(W);
  set32(res,0,build_seq(W,best,bn));
  set32(res,4,bn);
  return res;
}
fn promo(W:[]u8,root:i32,len:i32,store:[]u8,ns:i32)i32 {
  let base:i32=MAXN()+1+ns*8;
  let prev:i32=-1; let newroot:i32=-1;
  let cur:i32=root; let i:i32=0;
  while(cur>=0 && i<len){
    let nd:i32=base+i;
    set32(W,nd*STRS()+36,1);
    let f:i32=0;
    while(f<6){ nset(W,nd,f,nget(W,cur,f)); f=f+1; }
    if(prev>=0){ nset(W,prev,5,nd); } else { newroot=nd; }
    prev=nd; cur=nget(W,cur,5); i=i+1;
  }
  if(prev>=0){ nset(W,prev,5,-1); }
  set32(store,ns*8,newroot);
  set32(store,ns*8+4,len);
  return ns+1;
}
fn probe(W:[]u8,root:i32,FA:[]u8,FC:[]u8,nf:i32,fr:[]u8,out:[]u8)[]u8 {
  let c:[]u8=z_alloc(16);
  set32(c,0,0); set32(c,4,0);
  let pv:[]u8=z_alloc(4*64);
  let np:i32=0;
  let i:i32=0;
  while(i<nf && np<60){
    let a:i32=get32(FA,i*4);
    let b:i32=get32(FC,i*4);
    if(a>0){ set32(pv,np*4,a); np=np+1; }
    if(b>0 && b!=a){ set32(pv,np*4,b); np=np+1; }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    exec(W,root,v,v,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    exec(W,root,v,0,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    if((get32(c,0)&cls)!=0){
      exec(W,root,v,v,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
      exec(W,root,v,0,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
    }
    i=i+1;
  }
  return c;
}

// BORROW PHASE 3c -- WHICH SUPPORT SCORING RULE? Four competing substrates.
// Attacks the gap named by C1571: additive support over chain elements is
// unsound because (s,s) scores 2*s and rewards self-composition.
//
//   rule 0 SUM      score = sup[a] + sup[b]           (C1571, oscillates)
//   rule 1 MAX      score = max(sup[a], sup[b])      no length inflation
//   rule 2 NONSELF  SUM, but a structure may not appear twice in one chain
//   rule 3 DAMPED   score = (sup[a]+sup[b]) / chain_len
//
// Same scenario for all four: consequences change, facts do not, so the stale
// recruitment stays class-eligible and only scoring can dislodge it.
// Same initial support for all four, so the comparison is controlled.

// BORROW PHASE 3d -- DISCRIMINATING the surviving rules, and testing
// H-SC (provenance-scoped credit).
//
// C1601 left MAX / NONSELF / DAMPED tied because every viable chain had
// length <= 2. Two new measurements separate them:
//
//   S1  a world where the ONLY viable chain is (s,s) -- self-composition.
//       NONSELF forbids it, so NONSELF must FAIL and the rest must PASS.
//   S2  a mixed chain vs a singleton with support (10,0,7) and ground-truth
//       usefulness fixed independently: MAX and DAMPED must disagree.
//
// Then H-SC: credit scoped to the regime that earned it.
//   ARM-OBS    the regime change is OBSERVABLE (class of arg1 changes).
//              Global support inherits stale credit; scoped does not.
//   ARM-UNOBS  the regime changes but nothing observable changes.
//              Prediction: scoping CANNOT help, because scoping needs a signal.

// PHASE 11 -- H16v4 AUDIT OF THIS SESSION'S OWN NEW MECHANISMS.
//
// The standing detector must attack new work, not only legacy work.
// Four mechanisms were added this session:
//   M1 learned typed contracts (probing)
//   M2 consequence-weighted selection
//   M3 H-SC provenance-scoped credit
//   M4 aggregation provenance retention
//
// The dangerous one is the C1621 headline: "scoped credit revises in 0 trials".
// If a FIXED HEURISTIC with no experience reproduces it, the result is not
// evidence of learning and must be retracted.
//
// Selectors compared on the identical ARM-OBS scenario:
//   LEN1   always prefer a length-1 chain      (researcher heuristic)
//   LEN2   always prefer a length-2 chain      (researcher heuristic)
//   TIES   first-eligible in enumeration order  (no scoring at all)
//   LEARN  scoped consequence credit + DAMPED  (the candidate)
//
// Positive control: an arbitrary-length program over a finite primitive ISA
// must still execute, or H16 is over-killing.

// PHASE 11b -- THE DISCRIMINATING EXPERIMENT.
//
// H16v4 (C1681) showed that in every scenario built so far, a FIXED
// chain-length preference with zero experience matched or beat the
// consequence-weighted learner. So the learner was never shown to beat a
// trivial heuristic, and the C1621 headline is retracted.
//
// This lane builds the scenario that a fixed heuristic CANNOT solve:
// two queries in the SAME world whose correct answers require DIFFERENT
// chain lengths. A fixed preference is wrong on one of them by
// construction.
//
//   Q_A = (20,111) answer 22.  Only a length-2 chain reaches it:
//         s0: 20->120, s1: 120->22 (class 1).
//         The length-1 chain s2 gives 21 -- also class 1, so it passes the
//         contract gate but is WRONG. Length 2 is required for correctness.
//   Q_B = (11,121) answer 12.  Only length 1 is eligible:
//         s2: 11->12 (class 1). s0 then s1 gives 111 then 13 (class 0),
//         filtered out. Length 1 is required.
//
// Selectors are RESTRICTIVE (a selector that cannot find its preferred
// length reports failure rather than silently falling back), so each is
// honestly wrong on one query.

// PHASE 6 -- BORROWED PRINCIPLES, HEAD TO HEAD. Prereg: borrow6/PREREG.md.
// Principles only. Every candidate is a mechanism for ONE question -- how a
// stored structure gets selected -- expressed in the existing substrate with no
// special machinery of its own.
//
// Harness: two MIRROR-IMAGE queries where both chain lengths are
// contract-eligible and correctness is swapped. Eligibility cannot decide;
// only preference can. Fixed controls are present from the start.

// ---------- state ops: mask over labels 1..4 ----------
fn NL()i32 { return 8; }
fn bitof(x:i32)i32 { let d:i32=1; let i:i32=1; while(i<x){d=d*2;i=i+1;} return d; }
fn pc(m:i32)i32 {
  let c:i32=0; let i:i32=0;
  while(i<NL()){ if((m & bitof(i+1))!=0){ c=c+1; } i=i+1; }
  return c;
}
fn has(m:i32,x:i32)i32 { if((m & bitof(x))!=0){ return 1; } return 0; }
fn apply(m:i32,kind:i32,x:i32,y:i32,cap:i32)i32 {
  if(kind==0){
    if(has(m,x)==0){ return -1; }
    return m & (0-bitof(x)-1);
  }
  if(kind==1){
    if(has(m,x)==1){ return -1; }
    if(pc(m)>=cap){ return -1; }
    return m | bitof(x);
  }
  if(kind==2){
    if(has(m,x)==0){ return -1; }
    if(has(m,y)==1){ return -1; }
    if(y==x){ return -1; }
    return (m & (0-bitof(x)-1)) | bitof(y);
  }
  return -1;
}
// edit code: kind*100 + x*10 + y
fn ecode(kind:i32,x:i32,y:i32)i32 { return kind*100+x*10+y; }
fn ekind(e:i32)i32 { return (e-(e%100))/100; }
fn ex(e:i32)i32 { return ((e/10)%10); }
fn ey(e:i32)i32 { return e%10; }
fn NE()i32 { return 3*NL()+NL()*NL()-NL(); }  // DEL+INS+MOV distinct pairs

fn run_seq(start:i32,seq:[]u8,n:i32,cap:i32,goal:i32)[]u8 {
  let r:[]u8=z_alloc(8);
  let m:i32=start;
  let i:i32=0;
  while(i<n){
    let e:i32=get32(seq,i*4);
    let m2:i32=apply(m,ekind(e),ex(e),ey(e),cap);
    if(m2<0){ set32(r,0,0-1); return r; }
    m=m2;
    i=i+1;
  }
  set32(r,0,m);
  return r;
}
fn succeeds(start:i32,seq:[]u8,n:i32,cap:i32,goal:i32)i32 {
  let m:i32=start;
  let i:i32=0;
  while(i<n){
    let e:i32=get32(seq,i*4);
    let m2:i32=apply(m,ekind(e),ex(e),ey(e),cap);
    if(m2<0){ return 0; }
    m=m2;
    i=i+1;
  }
  if(m!=goal){ return 0; }
  return 1;
}
fn dist(m:i32,goal:i32)i32 {
  let d:i32=0; let i:i32=0;
  while(i<NL()){
    let a:i32=has(m,i+1); let b:i32=has(goal,i+1);
    if(a!=b){ d=d+1; }
    i=i+1;
  }
  return d;
}
fn lcg(s:[]u8)i32 {
  let x:i32=get32(s,0);
  x=x*1103515245+12345;
  if(x<0){ x=0-x; }
  set32(s,0,x);
  return x;
}
fn rand_edit_code(s:[]u8)i32 {
  let z:i32=lcg(s);
  let t:i32=z%NE();
  if(t<NL()){ return ecode(0,t+1,0); }
  if(t<2*NL()){ return ecode(1,t-NL()+1,0); }
  let k:i32=t-2*NL();
  let a:i32=k/NL();
  let b:i32=k-(k/NL())*NL();
  if(a==b){ return ecode(0,(a+1)%NL()+1,0); }
  return ecode(2,a+1,b+1);
}

// ---------- exhaustive enumeration over the whole alphabet ----------
fn enum_proposal(idx:i32,maxlen:i32,seq:[]u8,base:[]u8)[]u8 {
  // base holds the fixed-length code; idx counts 0..NE^len-1
  let r:[]u8=z_alloc(4);
  set32(r,0,idx);
  return r;
}
fn nth_edit_code(i:i32)i32 {
  if(i<NL()){ return ecode(0,i+1,0); }
  if(i<2*NL()){ return ecode(1,i-NL()+1,0); }
  let k:i32=i-2*NL();
  let a:i32=k/NL();
  let b:i32=k-(k/NL())*NL();
  if(a==b){ return ecode(2,a+1,0); }
  return ecode(2,a+1,b+1);
}

// ---------- instance table ----------
// start, goal, cap  (6 train, 4 test)
fn NINST()i32 { return 10; }
fn i_start(i:i32)i32 {
  if(i==0){return bitof(1)|bitof(2);}
  if(i==1){return bitof(1)|bitof(2)|bitof(3);}
  if(i==2){return bitof(2)|bitof(3);}
  if(i==3){return bitof(1)|bitof(3);}
  if(i==4){return bitof(3)|bitof(4);}
  if(i==5){return bitof(1)|bitof(2)|bitof(3);}
  if(i==6){return bitof(1)|bitof(2);}
  if(i==7){return bitof(2)|bitof(3);}
  if(i==8){return bitof(1)|bitof(3);}
  return bitof(1)|bitof(2);
}
fn i_goal(i:i32)i32 {
  if(i==0){return bitof(3);}
  if(i==1){return bitof(4);}
  if(i==2){return bitof(1);}
  if(i==3){return bitof(2)|bitof(4);}
  if(i==4){return bitof(1);}
  if(i==5){return bitof(3)|bitof(4);}
  if(i==6){return bitof(4);}
  if(i==7){return bitof(1)|bitof(4);}
  if(i==8){return bitof(2);}
  return bitof(3)|bitof(4);
}
fn i_cap(i:i32)i32 {
  if(i==1){ return 3; }
  return 2;
}
fn instname(i:i32)[]u8 {
  if(i<6){ return "TRAIN"; }
  return "TEST";
}


// PHASE 8 -- LEARNED TRANSFORMATIONS. Prereg: xform8/PREREG.md.
// The learned object is a PROCEDURE, not a prior: a 3-key table from
// size-relation to the edit kind that most often reduced distance.
// Induced from the learner's own exploration outcomes only.

fn sgn(x:i32)i32 { if(x<0){ return 0-1; } if(x>0){ return 1; } return 0; }

// induce: table[key*3+kind] accumulates signed distance change
fn induce_key(tab:[]u8,cur:i32,gl:i32,code:i32,cap:i32)void {
  let key:i32=0;
  let d:i32=pc(cur)-pc(gl);
  if(d<0){ key=0; }
  if(d==0){ key=1; }
  if(d>0){ key=2; }
  let m2:i32=apply(cur,ekind(code),ex(code),ey(code),cap);
  if(m2<0){ return; }
  let delta:i32=dist(m2,gl)-dist(cur,gl);
  let ix:i32=(key*3+ekind(code))*4;
  set32(tab,ix,get32(tab,ix)-delta);
  return;
}
fn argmax_kind(tab:[]u8,key:i32)i32 {
  let best:i32=0-1; let bv:i32=0-1000000;
  let k:i32=0;
  while(k<3){
    let v:i32=get32(tab,(key*3+k)*4);
    if(v>bv){ bv=v; best=k; }
    k=k+1;
  }
  if(best<0){ return 0; }
  return best;
}
fn kind_name(k:i32)[]u8 {
  if(k==0){return "DEL";}
  if(k==1){return "INS";}
  return "MOV";
}

// run the learner procedure: at each step take the induced kind for the
// current size relation, then try labels in a fixed generic order.
fn run_T(W_unused:i32,st:i32,gl:i32,cp:i32,tab:[]u8,limit:i32)[]u8 {
  let r:[]u8=z_alloc(8);
  let props:i32=0;
  let found:i32=0;
  let m:i32=st;
  let step:i32=0;
  while(step<6 && found==0){
    if(m==gl){ found=1; break; }
    let d:i32=pc(m)-pc(gl);
    let key:i32=1;
    if(d<0){ key=0; }
    if(d>0){ key=2; }
    let kind:i32=argmax_kind(tab,key);
    let tried:i32=0;
    let x:i32=1;
    while(x<=NL() && tried==0){
      let code:i32=0;
      if(kind==0){ code=ecode(0,x,0); }
      if(kind==1){ code=ecode(1,x,0); }
      if(kind==2){ code=ecode(2,x,(x%NL())+1); }
      let m2:i32=apply(m,ekind(code),ex(code),ey(code),cp);
      props=props+1;
      if(m2>=0){ m=m2; tried=1; }
      x=x+1;
    }
    if(tried==0){ break; }
    step=step+1;
    if(props>limit){ break; }
  }
  set32(r,0,props);
  set32(r,4,found);
  return r;
}
// hand-written researcher heuristic
fn run_C(st:i32,gl:i32,cp:i32)[]u8 {
  let r:[]u8=z_alloc(8);
  let props:i32=0;
  let found:i32=0;
  let m:i32=st;
  let step:i32=0;
  while(step<6 && found==0){
    if(m==gl){ found=1; break; }
    let best:i32=0-1; let bestD:i32=99;
    let e:i32=0;
    while(e<NE()){
      let code:i32=nth_edit_code(e);
      let m2:i32=apply(m,ekind(code),ex(code),ey(code),cp);
      if(m2>=0){
        let dd:i32=dist(m2,gl);
        if(dd<bestD){ bestD=dd; best=e; }
      }
      e=e+1;
    }
    if(best<0){ break; }
    let bc:i32=nth_edit_code(best);
    m=apply(m,ekind(bc),ex(bc),ey(bc),cp);
    props=props+1;
    step=step+1;
  }
  set32(r,0,props);
  set32(r,4,found);
  return r;
}
fn run_R(start:i32,rng:[]u8,gl:i32,cp:i32)[]u8 {
  let r:[]u8=z_alloc(8);
  let props:i32=0;
  let found:i32=0;
  let m:i32=start;
  let step:i32=0;
  while(step<6 && found==0){
    if(m==gl){ found=1; break; }
    let t:i32=0;
    let okStep:i32=0;
    while(t<60 && okStep==0){
      let code:i32=rand_edit_code(rng);
      let m2:i32=apply(m,ekind(code),ex(code),ey(code),cp);
      props=props+1;
      if(m2>=0){ m=m2; okStep=1; }
      t=t+1;
    }
    if(okStep==0){ break; }
    step=step+1;
  }
  set32(r,0,props);
  set32(r,4,found);
  return r;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let c:i32=0;
  let rng:[]u8=z_alloc(4);

  // ---------- induction from TRAIN ----------
  let tab:[]u8=z_alloc(4*9);
  let i:i32=0;
  while(i<9){ set32(tab,i*4,0); i=i+1; }
  set32(rng,0,99991);
  let ti:i32=0;
  while(ti<6){
    let st:i32=i_start(ti); let gl:i32=i_goal(ti); let cp:i32=i_cap(ti);
    let m:i32=st;
    let step:i32=0;
    while(step<8){
      if(m==gl){ break; }
      let t:i32=0;
      while(t<40){
        let code:i32=rand_edit_code(rng);
        induce_key(tab,m,gl,code,cp);
        let m2:i32=apply(m,ekind(code),ex(code),ey(code),cp);
        if(m2>=0){ m=m2; }
        t=t+1;
      }
      step=step+1;
    }
    ti=ti+1;
  }
  c=o_app(ob,c,"PHASE 8 LEARNED TRANSFORMATIONS"); c=o_nl(ob,c);
  c=o_app(ob,c,"B10 INDUCED TABLE (learner state, not source)"); c=o_nl(ob,c);
  c=o_app(ob,c,"  key -1 (current smaller): ");
  let k1:i32=argmax_kind(tab,0);
  c=o_app(ob,c,kind_name(k1));
  c=o_app(ob,c,"   gains DEL="); c=o_i64(ob,c,get32(tab,0) as i64);
  c=o_app(ob,c," INS="); c=o_i64(ob,c,get32(tab,4) as i64);
  c=o_app(ob,c," MOV="); c=o_i64(ob,c,get32(tab,8) as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  key  0 (same size):     ");
  let k2:i32=argmax_kind(tab,1);
  c=o_app(ob,c,kind_name(k2));
  c=o_app(ob,c,"   gains DEL="); c=o_i64(ob,c,get32(tab,12) as i64);
  c=o_app(ob,c," INS="); c=o_i64(ob,c,get32(tab,16) as i64);
  c=o_app(ob,c," MOV="); c=o_i64(ob,c,get32(tab,20) as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  key +1 (current larger): ");
  let k3:i32=argmax_kind(tab,2);
  c=o_app(ob,c,kind_name(k3));
  c=o_app(ob,c,"   gains DEL="); c=o_i64(ob,c,get32(tab,24) as i64);
  c=o_app(ob,c," INS="); c=o_i64(ob,c,get32(tab,28) as i64);
  c=o_app(ob,c," MOV="); c=o_i64(ob,c,get32(tab,32) as i64); c=o_nl(ob,c);

  // ---------- control tables ----------
  let tErase:[]u8=z_alloc(4*9);
  i=0; while(i<9){ set32(tErase,i*4,0); i=i+1; }
  let tIrrel:[]u8=z_alloc(4*9);
  i=0; while(i<9){ set32(tIrrel,i*4,0); i=i+1; }
  // irrelevant: induce from instances whose GOAL is unrelated (goal = start)
  set32(rng,0,55531);
  ti=0;
  while(ti<6){
    let st:i32=i_start(ti);
    let gl:i32=st;
    let cp:i32=i_cap(ti);
    let m:i32=st;
    let t:i32=0;
    while(t<400){
      let code:i32=rand_edit_code(rng);
      induce_key(tIrrel,m,gl,code,cp);
      let m2:i32=apply(m,ekind(code),ex(code),ey(code),cp);
      if(m2>=0){ m=m2; }
      t=t+1;
    }
    ti=ti+1;
  }
  let tMis:[]u8=z_alloc(4*9);
  i=0; while(i<9){ set32(tMis,i*4,0); i=i+1; }
  // misleading: induce from PERTURBED goals (goal xor 3)
  set32(rng,0,77713);
  ti=0;
  while(ti<6){
    let st:i32=i_start(ti);
    let gl:i32=i_goal(ti);
    let gp:i32=gl;
    if((gp & 3)==0){ gp=gp+3; } else { gp=gp-3; }
    let cp:i32=i_cap(ti);
    let m:i32=st;
    let t:i32=0;
    while(t<400){
      let code:i32=rand_edit_code(rng);
      induce_key(tMis,m,gp,code,cp);
      let m2:i32=apply(m,ekind(code),ex(code),ey(code),cp);
      if(m2>=0){ m=m2; }
      t=t+1;
    }
    ti=ti+1;
  }
  let tFact:[]u8=z_alloc(4*9);
  i=0; while(i<9){ set32(tFact,i*4,0); i=i+1; }
  // facts-only: no search outcomes at all. Just: if the goal has more
  // members than the start, INS; fewer, DEL; same, MOV.
  i=0;
  while(i<6){
    let st:i32=i_start(ti); let gl:i32=i_goal(ti);
    if(pc(gl)>pc(st)){ set32(tFact,4,1); set32(tFact,16,1); }
    if(pc(gl)<pc(st)){ set32(tFact,0,1); set32(tFact,12,1); }
    if(pc(gl)==pc(st)){ set32(tFact,8,1); set32(tFact,20,1); }
    i=i+1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"control tables: IRRELEVANT(-1,0,+1)=");
  c=o_app(ob,c,kind_name(argmax_kind(tIrrel,0))); c=o_app(ob,c,"/");
  c=o_app(ob,c,kind_name(argmax_kind(tIrrel,1))); c=o_app(ob,c,"/");
  c=o_app(ob,c,kind_name(argmax_kind(tIrrel,2)));
  c=o_app(ob,c,"   MISLEADING=");
  c=o_app(ob,c,kind_name(argmax_kind(tMis,0))); c=o_app(ob,c,"/");
  c=o_app(ob,c,kind_name(argmax_kind(tMis,1))); c=o_app(ob,c,"/");
  c=o_app(ob,c,kind_name(argmax_kind(tMis,2)));
  c=o_app(ob,c,"   FACTS_ONLY=");
  c=o_app(ob,c,kind_name(argmax_kind(tFact,0))); c=o_app(ob,c,"/");
  c=o_app(ob,c,kind_name(argmax_kind(tFact,1))); c=o_app(ob,c,"/");
  c=o_app(ob,c,kind_name(argmax_kind(tFact,2)));
  c=o_nl(ob,c);

  // ---------- evaluate on ORIGINAL test instances ----------
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"ORIGINAL TEST INSTANCES"); c=o_nl(ob,c);
  let tC:i32=0; let fC:i32=0;
  let tT:i32=0; let fT:i32=0;
  let tE:i32=0; let fE:i32=0;
  let tI:i32=0; let fI:i32=0;
  let tM:i32=0; let fM:i32=0;
  let tF:i32=0; let fF:i32=0;
  let tR:i32=0; let fR:i32=0;
  ti=6;
  while(ti<10){
    let st:i32=i_start(ti); let gl:i32=i_goal(ti); let cp:i32=i_cap(ti);
    let a:[]u8=run_C(st,gl,cp);
    tC=tC+get32(a,0); if(get32(a,4)==0){ fC=fC+1; }
    let b2:[]u8=run_T(0,st,gl,cp,tab,100000);
    tT=tT+get32(b2,0); if(get32(b2,4)==0){ fT=fT+1; }
    let d2:[]u8=run_T(0,st,gl,cp,tErase,100000);
    tE=tE+get32(d2,0); if(get32(d2,4)==0){ fE=fE+1; }
    let e2:[]u8=run_T(0,st,gl,cp,tIrrel,100000);
    tI=tI+get32(e2,0); if(get32(e2,4)==0){ fI=fI+1; }
    let g2:[]u8=run_T(0,st,gl,cp,tMis,100000);
    tM=tM+get32(g2,0); if(get32(g2,4)==0){ fM=fM+1; }
    let h2:[]u8=run_T(0,st,gl,cp,tFact,100000);
    tF=tF+get32(h2,0); if(get32(h2,4)==0){ fF=fF+1; }
    set32(rng,0,31337+ti);
    let i2:[]u8=run_R(st,rng,gl,cp);
    tR=tR+get32(i2,0); if(get32(i2,4)==0){ fR=fR+1; }
    ti=ti+1;
  }
  c=o_app(ob,c,"  C researcher   proposals="); c=o_i64(ob,c,tC as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fC as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  T learner       proposals="); c=o_i64(ob,c,tT as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fT as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  T-ERASED        proposals="); c=o_i64(ob,c,tE as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fE as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  T-IRRELEVANT    proposals="); c=o_i64(ob,c,tI as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fI as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  T-MISLEADING    proposals="); c=o_i64(ob,c,tM as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fM as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  T-FACTS         proposals="); c=o_i64(ob,c,tF as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fF as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  R random        proposals="); c=o_i64(ob,c,tR as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fR as i64); c=o_nl(ob,c);

  // ---------- TRANSFER: shifted labels 1..4 -> 5..8, capacity 3 ----------
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"SHIFTED FAMILY (labels 5..8, capacity 3, NO source change)"); c=o_nl(ob,c);
  let sC:i32=0; let fC2:i32=0;
  let sT:i32=0; let fT2:i32=0;
  let sM:i32=0; let fM2:i32=0;
  ti=6;
  while(ti<10){
    let st:i32=i_start(ti)<<4;
    let gl:i32=i_goal(ti)<<4;
    let cp:i32=3;
    let a:[]u8=run_C(st,gl,cp);
    sC=sC+get32(a,0); if(get32(a,4)==0){ fC2=fC2+1; }
    let b2:[]u8=run_T(0,st,gl,cp,tab,100000);
    sT=sT+get32(b2,0); if(get32(b2,4)==0){ fT2=fT2+1; }
    let g2:[]u8=run_T(0,st,gl,cp,tMis,100000);
    sM=sM+get32(g2,0); if(get32(g2,4)==0){ fM2=fM2+1; }
    ti=ti+1;
  }
  c=o_app(ob,c,"  C researcher   proposals="); c=o_i64(ob,c,sC as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fC2 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  T learner       proposals="); c=o_i64(ob,c,sT as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fT2 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  T-MISLEADING    proposals="); c=o_i64(ob,c,sM as i64);
  c=o_app(ob,c," failed="); c=o_i64(ob,c,fM2 as i64); c=o_nl(ob,c);

  // ---------- bars ----------
  let b2:i32=0; if(fC==0){ b2=1; }
  let b3:i32=0; if(fT==0){ b3=1; }
  let b4:i32=0; if(tT<=tC){ b4=1; }
  let b5:i32=0; if(fT2==0){ b5=1; }
  let b6:i32=0; if(fE>fT){ b6=1; }
  let b7:i32=0; if(fI>fT){ b7=1; }
  let b8:i32=0; if(fM>fT){ b8=1; }
  let b9:i32=0; if(fF>=fT){ b9=1; }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B2_researcher_solves_all="); c=o_i64(ob,c,b2 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B3_learner_solves_all="); c=o_i64(ob,c,b3 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B4_T_matches_or_beats_C="); c=o_i64(ob,c,b4 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B5_T_transfers_to_shifted="); c=o_i64(ob,c,b5 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B6_beats_erased="); c=o_i64(ob,c,b6 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B7_beats_irrelevant="); c=o_i64(ob,c,b7 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B8_beats_misleading="); c=o_i64(ob,c,b8 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B9_facts_only_no_better="); c=o_i64(ob,c,b9 as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR B12_L3="); c=o_i64(ob,c,0); c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}
// a2_f2.zag -- A2 Simpler-Explanation attacks on H-CAUSALEXP-CONSTRUCT.
// Pure Zag. No Python. Independent reimplementation from the prereg spec.
//
// Attack A-F2-1: show the learner is byte-equivalent to a trivial
// precomputation over a fixed 1364-sequence menu.
// Attack A-F2-2: World C requires length-6 discrimination; the MAXD=5
// learner halts with NO-DISCRIMINATING-SEQUENCE.
// Attack A-F2-3: count ALL discriminating sequences at the found depth;
// show the learner's pick is researcher-order-determined.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ hypothesis rules (independent encoding from prereg spec) ====
// world: 0=A, 1=B, 2=C. hypo: 0,1.
// A: H0=[(X,Z,2),(Z,Y,0)], H1=[(X,Y,1)].
// B: H0=[(X,Z,3),(Z,Y,0)], H1=[(X,Y,2)].
// C: H0=[(X,Z,5),(Z,Y,0)], H1=[(X,Y,4)].
// Vars: X=0, Z=1, Y=2.
fn rule_count(w:i32,h:i32)i32 {
  if(h==0){return 2;}
  return 1;
}
fn rule_src(w:i32,h:i32,r:i32)i32 {
  if(h==0){
    if(r==0){return 0;}
    return 1;
  }
  return 0;
}
fn rule_dst(w:i32,h:i32,r:i32)i32 {
  if(h==0){
    if(r==0){return 1;}
    return 2;
  }
  return 2;
}
fn rule_delay(w:i32,h:i32,r:i32)i32 {
  if(w==0){
    if(h==0){
      if(r==0){return 2;}
      return 0;
    }
    return 1;
  } else if(w==1){
    if(h==0){
      if(r==0){return 3;}
      return 0;
    }
    return 2;
  } else {
    if(h==0){
      if(r==0){return 5;}
      return 0;
    }
    return 4;
  }
}

// ============ generic simulator (independent implementation) ============
// state: +0 X,+4 Z,+8 Y,+12 t,+16 tX,+20 tZ,+24 tY
fn sim_step(w:i32,h:i32,st:[]u8,a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<2){
      let r:i32=0;
      let nr:i32=rule_count(w,h);
      while(r<nr){
        let src:i32=rule_src(w,h,r);
        let dst:i32=rule_dst(w,h,r);
        let delay:i32=rule_delay(w,h,r);
        if(get32(st,src*4)==1){
          let ts:i32=get32(st,16+src*4);
          if(t-ts>=delay){
            if(get32(st,dst*4)==0){
              set32(st,dst*4,1);
              set32(st,16+dst*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else {
    obs=get32(st,4);
  }
  return obs;
}
fn sim_seq(w:i32,h:i32,seq:[]u8,len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=sim_step(w,h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn has_obs(seq:[]u8,len:i32)i32 {
  let i:i32=0;
  while(i<len){
    if((seq[i] as i32)>=2){return 1;}
    i=i+1;
  }
  return 0;
}
fn emit_seq(seq:[]u8,len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    let a:i32=seq[i] as i32;
    if(a==0){emit("S");}
    else if(a==1){emit("W");}
    else if(a==2){emit("OY");}
    else{emit("OZ");}
    i=i+1;
  }
  emit("]");
  return;
}
// decode base-4 index si into length-d sequence (S=0,W=1,OY=2,OZ=3)
fn decode(si:i32,d:i32,seq:[]u8)void {
  let div:i32=1;
  let p:i32=0;
  while(p<d-1){div=div*4; p=p+1;}
  let rem:i32=si;
  let i:i32=0;
  while(i<d){
    seq[i]=(rem/div) as u8;
    rem=rem%div;
    if(div>1){div=div/4;}
    i=i+1;
  }
  return;
}
// Run the learner's selection procedure on world w; record first
// discriminating sequence. Returns 1 if found, 0 if not. Outputs via
// out_seq, and out_vals[0]=len, out_vals[1]=p0, out_vals[2]=p1.
fn learner_select(w:i32,maxd:i32,out_seq:[]u8,out_vals:[]u8)i32 {
  let found:i32=0;
  let d:i32=1;
  while(d<=maxd){
    if(found==1){break;}
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*4; k=k+1;}
    let si:i32=0;
    while(si<total){
      if(found==1){break;}
      let seq:[]u8=z_alloc(8);
      decode(si,d,seq);
      if(has_obs(seq,d)==1){
        let q0:i32=sim_seq(w,0,seq,d);
        let q1:i32=sim_seq(w,1,seq,d);
        if(q0!=q1){
          found=1;
          set32(out_vals,0,d);
          set32(out_vals,4,q0);
          set32(out_vals,8,q1);
          let c:i32=0;
          while(c<d){out_seq[c]=seq[c]; c=c+1;}
        }
      }
      si=si+1;
    }
    d=d+1;
  }
  return found;
}

fn main()i32 {
  // ============ A-F2-1: menu size + byte-equivalence ============
  emit("A-F2-1 MENU_SIZE\n");
  let total_menu:i32=0;
  let d:i32=1;
  while(d<=5){
    let t:i32=1;
    let k:i32=0;
    while(k<d){t=t*4; k=k+1;}
    total_menu=total_menu+t;
    d=d+1;
  }
  emit("menu_total="); e64(total_menu); emit("\n");
  // independent selection on World A (w=0) and World B (w=1)
  let os:[]u8=z_alloc(8);
  let ov:[]u8=z_alloc(12);
  let f:i32=learner_select(0,5,os,ov);
  let ol:i32=get32(ov,0); let op0:i32=get32(ov,4); let op1:i32=get32(ov,8);
  emit("worldA found="); e64(f); emit(" sel=");
  emit_seq(os,ol);
  emit(" p0="); e64(op0); emit(" p1="); e64(op1); emit("\n");
  // builder committed: SELECT seq=[S,W,OY] h0pred=0 h1pred=1
  let matchA:i32=0;
  if(f==1 && ol==3 && (os[0] as i32)==0 && (os[1] as i32)==1 && (os[2] as i32)==2 && op0==0 && op1==1){matchA=1;}
  emit("worldA_matches_builder="); e64(matchA); emit("\n");
  f=learner_select(1,5,os,ov);
  ol=get32(ov,0); op0=get32(ov,4); op1=get32(ov,8);
  emit("worldB found="); e64(f); emit(" sel=");
  emit_seq(os,ol);
  emit(" p0="); e64(op0); emit(" p1="); e64(op1); emit("\n");
  // builder committed: SELECT seq=[S,W,W,OY] h0pred=0 h1pred=1
  let matchB:i32=0;
  if(f==1 && ol==4 && (os[0] as i32)==0 && (os[1] as i32)==1 && (os[2] as i32)==1 && (os[3] as i32)==2 && op0==0 && op1==1){matchB=1;}
  emit("worldB_matches_builder="); e64(matchB); emit("\n");
  if(matchA==1 && matchB==1){
    emit("A-F2-1 VERDICT=ATTACK-SUCCEEDS menu=1364 learner_is_argmin_over_fixed_menu\n");
  } else {
    emit("A-F2-1 VERDICT=ATTACK-FAILS\n");
  }

  // ============ A-F2-2: World C needs length 6 ============
  emit("A-F2-2 WORLD_C\n");
  let dd:i32=1;
  let c_ok:i32=1;
  while(dd<=6){
    let tot:i32=1;
    let k2:i32=0;
    while(k2<dd){tot=tot*4; k2=k2+1;}
    let ndisc:i32=0;
    let first:[]u8=z_alloc(8);
    let si2:i32=0;
    while(si2<tot){
      let sq:[]u8=z_alloc(8);
      decode(si2,dd,sq);
      if(has_obs(sq,dd)==1){
        let r0:i32=sim_seq(2,0,sq,dd);
        let r1:i32=sim_seq(2,1,sq,dd);
        if(r0!=r1){
          if(ndisc==0){
            let c2:i32=0;
            while(c2<dd){first[c2]=sq[c2]; c2=c2+1;}
          }
          ndisc=ndisc+1;
        }
      }
      si2=si2+1;
    }
    emit("depth="); e64(dd); emit(" discriminating="); e64(ndisc);
    if(ndisc>0){emit(" first="); emit_seq(first,dd);}
    emit("\n");
    // expect 0 for dd<=5, >0 for dd=6
    if(dd<=5 && ndisc!=0){c_ok=0;}
    if(dd==6 && ndisc==0){c_ok=0;}
    dd=dd+1;
  }
  // what would the MAXD=5 learner do on World C?
  let cs:[]u8=z_alloc(8);
  let cv:[]u8=z_alloc(12);
  let cf:i32=learner_select(2,5,cs,cv);
  emit("learner_maxd5_on_worldC found="); e64(cf); emit("\n");
  if(c_ok==1 && cf==0){
    emit("A-F2-2 VERDICT=ATTACK-SUCCEEDS worldC_needs_depth6 learner_halts_NO_DISCRIMINATING_SEQUENCE\n");
  } else {
    emit("A-F2-2 VERDICT=ATTACK-FAILS\n");
  }

  // ============ A-F2-3: count ALL discriminating at found depth (World A) ============
  emit("A-F2-3 ALL_DISCRIMINATING_WORLD_A_DEPTH3\n");
  let tot3:i32=64;
  let nall:i32=0;
  let si3:i32=0;
  while(si3<tot3){
    let sq3:[]u8=z_alloc(8);
    decode(si3,3,sq3);
    if(has_obs(sq3,3)==1){
      let t0:i32=sim_seq(0,0,sq3,3);
      let t1:i32=sim_seq(0,1,sq3,3);
      if(t0!=t1){
        nall=nall+1;
        emit("  discr "); emit_seq(sq3,3);
        emit(" p0="); e64(t0); emit(" p1="); e64(t1); emit("\n");
      }
    }
    si3=si3+1;
  }
  emit("total_discriminating_depth3="); e64(nall); emit("\n");
  if(nall>=2){
    emit("A-F2-3 VERDICT=ATTACK-SUCCEEDS multiple_candidates_pick_is_lexicographic_order\n");
  } else {
    emit("A-F2-3 VERDICT=ATTACK-FAILS\n");
  }

  emit("DONE\n");
  return 0;
}

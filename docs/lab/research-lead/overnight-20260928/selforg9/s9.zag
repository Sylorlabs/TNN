// BORROW PHASE 3-SELECTION + PHASE 4 TRANSFER + PHASE 5 REVISION
// Addresses the boundary isolated by C1541: applicability contracts are
// necessary but NOT sufficient -- selection among applicable structures is a
// separate capability. Competing hypotheses:
//   H-CONTRACT-ONLY  contracts alone, no consequence   <- expected to fail
//   H2 / H7          consequence-adapted selection      <- under test
// Declared limitation: structure search covers lengths 1..3 (MAXQ=3).
// Scratch frames are caller-allocated and reused; exec allocates nothing.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

fn STRS()i32 { return 48; }
fn EXLIM()i32 { return 64; }
fn MAXQ()i32 { return 3; }
fn MAXN()i32 { return 300; }
fn FAILV()i32 { return -999999; }
fn T_ADD()i32 { return 2; }
fn T_ADD2()i32 { return 3; }
fn T_GUARD()i32 { return 4; }
fn T_SET()i32 { return 5; }
fn T_OUT()i32 { return 6; }

fn ntag(W:[]u8,n:i32)i32 { return get32(W,n*STRS()); }
fn nset(W:[]u8,n:i32,f:i32,v:i32)void { set32(W,n*STRS()+f*4,v); return; }
fn nget(W:[]u8,n:i32,f:i32)i32 { return get32(W,n*STRS()+f*4); }
fn reset_graph(W:[]u8)void {
  let i:i32=0; while(i<MAXN()){ set32(W,i*STRS()+36,0); i=i+1; } return;
}
fn newnode(W:[]u8)i32 {
  let i:i32=1;
  while(i<MAXN()){ if(get32(W,i*STRS()+36)==0){ set32(W,i*STRS()+36,1); return i; } i=i+1; }
  return -1;
}

// executes into caller scratch; allocates nothing
fn exec(W:[]u8,root:i32,i0:i32,i1:i32,fr:[]u8,out:[]u8)void {
  set32(out,0,FAILV());
  if(root<0){ return; }
  let k:i32=0; while(k<8){ set32(fr,k*4,0); k=k+1; }
  set32(fr,0,i0); set32(fr,4,i1);
  let cur:i32=root; let steps:i32=0; let os:i32=-1;
  while(cur>=0 && steps<EXLIM()){
    let t:i32=ntag(W,cur);
    if(t==T_ADD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,get32(fr,a*4)+b); }
    if(t==T_ADD2()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); let cc:i32=nget(W,cur,3);
      set32(fr,a*4,get32(fr,a*4)+get32(fr,b*4)+cc); }
    if(t==T_GUARD()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2);
      if(get32(fr,a*4)!=b){ return; } }
    if(t==T_SET()){ let a:i32=nget(W,cur,1); let b:i32=nget(W,cur,2); set32(fr,a*4,b); }
    if(t==T_OUT()){ os=nget(W,cur,1); }
    cur=nget(W,cur,5);
    steps=steps+1;
  }
  if(os<0){ return; }
  set32(out,0,get32(fr,os*4));
  return;
}

fn vclass(FA:[]u8,FC:[]u8,nf:i32,v:i32)i32 {
  let c:i32=0; let i:i32=0;
  while(i<nf){ if(get32(FA,i*4)==v){ c=c+1; } if(get32(FC,i*4)==v){ c=c+2; } i=i+1; }
  return c;
}

fn nvoc()i32 { return 10; }
fn vtag(i:i32)i32 {
  if(i==6){return T_GUARD();} if(i==7){return T_SET();}
  if(i<=5){return T_ADD();} return T_OUT();
}
fn vslot(i:i32)i32 {
  if(i<=6){return 0;} if(i==7){return 1;} if(i==8){return 0;} return 1;
}
fn vlit(i:i32)i32 {
  if(i==0){return 1;} if(i==1){return -1;} if(i==2){return 100;} if(i==3){return -98;}
  if(i==4){return 98;} if(i==5){return -100;} if(i==6){return 121;} if(i==7){return 10;}
  if(i==8){return 0;} return 1;
}
fn build_seq(W:[]u8,seq:[]u8,n:i32)i32 {
  let first:i32=-1; let prev:i32=-1; let i:i32=0;
  while(i<n){
    let vi:i32=get32(seq,i*4);
    let nd:i32=newnode(W);
    if(nd<0){ return -1; }
    nset(W,nd,0,vtag(vi)); nset(W,nd,1,vslot(vi)); nset(W,nd,2,vlit(vi));
    nset(W,nd,3,0); nset(W,nd,4,0); nset(W,nd,5,-1);
    if(prev>=0){ nset(W,prev,5,nd); } else { first=nd; }
    prev=nd; i=i+1;
  }
  return first;
}
fn fits(W:[]u8,train:[]u8,nt:i32,root:i32,fr:[]u8,out:[]u8)i32 {
  let i:i32=0;
  while(i<nt){
    exec(W,root,get32(train,i*12),get32(train,i*12+4),fr,out);
    if(get32(out,0)!=get32(train,i*12+8)){ return 0; }
    i=i+1;
  }
  return 1;
}
fn learn(W:[]u8,train:[]u8,nt:i32,fr:[]u8,out:[]u8)[]u8 {
  let res:[]u8=z_alloc(8); set32(res,0,-1); set32(res,4,0);
  let nv:i32=nvoc();
  let seq:[]u8=z_alloc(4*MAXQ());
  let best:[]u8=z_alloc(4*MAXQ());
  let bn:i32=0;
  let L:i32=1;
  while(L<=MAXQ() && bn==0){
    let a:i32=0;
    while(a<nv && bn==0){
      let b:i32=0;
      while(b<nv && bn==0){
        let c:i32=0;
        while(c<nv && bn==0){
          set32(seq,0,a); set32(seq,4,b); set32(seq,8,c);
          reset_graph(W);
          let root:i32=build_seq(W,seq,L);
          if(root>=0 && fits(W,train,nt,root,fr,out)==1){
            set32(best,0,a); set32(best,4,b); set32(best,8,c); bn=L;
          }
          c=c+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    if(bn>0){ break; }
    L=L+1;
  }
  if(bn==0){ return res; }
  reset_graph(W);
  set32(res,0,build_seq(W,best,bn));
  set32(res,4,bn);
  return res;
}
fn promo(W:[]u8,root:i32,len:i32,store:[]u8,ns:i32)i32 {
  let base:i32=MAXN()+1+ns*8;
  let prev:i32=-1; let newroot:i32=-1;
  let cur:i32=root; let i:i32=0;
  while(cur>=0 && i<len){
    let nd:i32=base+i;
    set32(W,nd*STRS()+36,1);
    let f:i32=0;
    while(f<6){ nset(W,nd,f,nget(W,cur,f)); f=f+1; }
    if(prev>=0){ nset(W,prev,5,nd); } else { newroot=nd; }
    prev=nd; cur=nget(W,cur,5); i=i+1;
  }
  if(prev>=0){ nset(W,prev,5,-1); }
  set32(store,ns*8,newroot);
  set32(store,ns*8+4,len);
  return ns+1;
}
fn probe(W:[]u8,root:i32,FA:[]u8,FC:[]u8,nf:i32,fr:[]u8,out:[]u8)[]u8 {
  let c:[]u8=z_alloc(16);
  set32(c,0,0); set32(c,4,0);
  let pv:[]u8=z_alloc(4*64);
  let np:i32=0;
  let i:i32=0;
  while(i<nf && np<60){
    let a:i32=get32(FA,i*4);
    let b:i32=get32(FC,i*4);
    if(a>0){ set32(pv,np*4,a); np=np+1; }
    if(b>0 && b!=a){ set32(pv,np*4,b); np=np+1; }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    exec(W,root,v,v,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    exec(W,root,v,0,fr,out);
    if(get32(out,0)!=FAILV()){ set32(c,0,get32(c,0)|cls); }
    i=i+1;
  }
  i=0;
  while(i<np){
    let v:i32=get32(pv,i*4);
    let cls:i32=vclass(FA,FC,nf,v);
    if((get32(c,0)&cls)!=0){
      exec(W,root,v,v,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
      exec(W,root,v,0,fr,out);
      if(get32(out,0)!=FAILV()){ set32(c,4,get32(c,4)|vclass(FA,FC,nf,get32(out,0))); }
    }
    i=i+1;
  }
  return c;
}

// BORROW PHASE 3c -- WHICH SUPPORT SCORING RULE? Four competing substrates.
// Attacks the gap named by C1571: additive support over chain elements is
// unsound because (s,s) scores 2*s and rewards self-composition.
//
//   rule 0 SUM      score = sup[a] + sup[b]           (C1571, oscillates)
//   rule 1 MAX      score = max(sup[a], sup[b])      no length inflation
//   rule 2 NONSELF  SUM, but a structure may not appear twice in one chain
//   rule 3 DAMPED   score = (sup[a]+sup[b]) / chain_len
//
// Same scenario for all four: consequences change, facts do not, so the stale
// recruitment stays class-eligible and only scoring can dislodge it.
// Same initial support for all four, so the comparison is controlled.

// BORROW PHASE 3d -- DISCRIMINATING the surviving rules, and testing
// H-SC (provenance-scoped credit).
//
// C1601 left MAX / NONSELF / DAMPED tied because every viable chain had
// length <= 2. Two new measurements separate them:
//
//   S1  a world where the ONLY viable chain is (s,s) -- self-composition.
//       NONSELF forbids it, so NONSELF must FAIL and the rest must PASS.
//   S2  a mixed chain vs a singleton with support (10,0,7) and ground-truth
//       usefulness fixed independently: MAX and DAMPED must disagree.
//
// Then H-SC: credit scoped to the regime that earned it.
//   ARM-OBS    the regime change is OBSERVABLE (class of arg1 changes).
//              Global support inherits stale credit; scoped does not.
//   ARM-UNOBS  the regime changes but nothing observable changes.
//              Prediction: scoping CANNOT help, because scoping needs a signal.

// PHASE 11 -- H16v4 AUDIT OF THIS SESSION'S OWN NEW MECHANISMS.
//
// The standing detector must attack new work, not only legacy work.
// Four mechanisms were added this session:
//   M1 learned typed contracts (probing)
//   M2 consequence-weighted selection
//   M3 H-SC provenance-scoped credit
//   M4 aggregation provenance retention
//
// The dangerous one is the C1621 headline: "scoped credit revises in 0 trials".
// If a FIXED HEURISTIC with no experience reproduces it, the result is not
// evidence of learning and must be retracted.
//
// Selectors compared on the identical ARM-OBS scenario:
//   LEN1   always prefer a length-1 chain      (researcher heuristic)
//   LEN2   always prefer a length-2 chain      (researcher heuristic)
//   TIES   first-eligible in enumeration order  (no scoring at all)
//   LEARN  scoped consequence credit + DAMPED  (the candidate)
//
// Positive control: an arbitrary-length program over a finite primitive ISA
// must still execute, or H16 is over-killing.

// PHASE 11b -- THE DISCRIMINATING EXPERIMENT.
//
// H16v4 (C1681) showed that in every scenario built so far, a FIXED
// chain-length preference with zero experience matched or beat the
// consequence-weighted learner. So the learner was never shown to beat a
// trivial heuristic, and the C1621 headline is retracted.
//
// This lane builds the scenario that a fixed heuristic CANNOT solve:
// two queries in the SAME world whose correct answers require DIFFERENT
// chain lengths. A fixed preference is wrong on one of them by
// construction.
//
//   Q_A = (20,111) answer 22.  Only a length-2 chain reaches it:
//         s0: 20->120, s1: 120->22 (class 1).
//         The length-1 chain s2 gives 21 -- also class 1, so it passes the
//         contract gate but is WRONG. Length 2 is required for correctness.
//   Q_B = (11,121) answer 12.  Only length 1 is eligible:
//         s2: 11->12 (class 1). s0 then s1 gives 111 then 13 (class 0),
//         filtered out. Length 1 is required.
//
// Selectors are RESTRICTIVE (a selector that cannot find its preferred
// length reports failure rather than silently falling back), so each is
// honestly wrong on one query.

// PHASE 6 -- BORROWED PRINCIPLES, HEAD TO HEAD. Prereg: borrow6/PREREG.md.
// Principles only. Every candidate is a mechanism for ONE question -- how a
// stored structure gets selected -- expressed in the existing substrate with no
// special machinery of its own.
//
// Harness: two MIRROR-IMAGE queries where both chain lengths are
// contract-eligible and correctness is swapped. Eligibility cannot decide;
// only preference can. Fixed controls are present from the start.

// PHASE 9 -- SELF-ORGANIZING ROLES FROM USE. No role names anywhere.
//
// PHASE 8 localised the remaining gap as ARGUMENT SELECTION: the learner
// could induce which KIND of edit to make but not WHICH instance to change
// it on. PHASE 9 asks whether "roles from use" supplies that.
//
// KILL-6 (C1721) proved the key must be coarser than a raw value and finer
// than a type. The candidate here is a USE-DERIVED AFFINITY: each structure
// accumulates a feature vector describing the situations in which it
// actually succeeded, and recruitment is by feature overlap.
//
// Three ways to decide applicability, all on identical candidate sets:
//   TYPE      derived class of the arguments only        (the C1681 approach)
//   FREQ      most frequently successful structure        (a heuristic)
//   AFFINITY  best overlap of learned success-features    (the claim)
//
// The harness is built so FREQ is WRONG on one query, because the structure
// that has succeeded most often overall is not the right one there. If
// AFFINITY also fails it, use-derived roles are not the missing abstraction.

fn bitof(x:i32)i32 { let d:i32=1; let i:i32=1; while(i<x){d=d*2;i=i+1;} return d; }

fn eligible(W:[]u8,store:[]u8,con:[]u8,ns:i32,FA:[]u8,FC:[]u8,nf:i32,
            v0:i32,v1:i32,cls0:i32,target:i32,cand:[]u8)[]u8 {
  let r:[]u8=z_alloc(8);
  set32(r,0,0);
  let nc:i32=0;
  let a:i32=0;
  while(a<ns){
    if((get32(con,a*8)&cls0)!=0){
      // length 1
      if(W[0]==0){ }
      set32(cand,nc*8,a); set32(cand,nc*8+4,0-1); nc=nc+1;
      // length 2
      set32(cand,nc*8,a); set32(cand,nc*8+4,a); nc=nc+1;
    }
    a=a+1;
  }
  set32(r,0,nc);
  return r;
}

// situation features, all derived from the fact table and the goal.
// no role names; these are structural properties only.
fn feat(FA:[]u8,FC:[]u8,nf:i32,v0:i32,v1:i32,gl:i32,out:[]u8)void {
  set32(out,0,vclass(FA,FC,nf,v0));       // f0 class of arg0
  set32(out,4,vclass(FA,FC,nf,v1));       // f1 class of arg1
  set32(out,8,has(vclass(FA,FC,nf,v0),v0)); // f2 arg0 present in goal
  set32(out,12,has(vclass(FA,FC,nf,v1),v1)); // f3 arg1 present in goal
  set32(out,16,0);                        // f4 reserved
  set32(out,20,0);
  return;
}
// match score between two feature vectors
fn fmatch(a:[]u8,b:[]u8)i32 {
  let s:i32=0;
  if(get32(a,0)==get32(b,0)){ s=s+1; }
  if(get32(a,4)==get32(b,4)){ s=s+1; }
  if(get32(a,8)==get32(b,8)){ s=s+1; }
  if(get32(a,12)==get32(b,12)){ s=s+1; }
  return s;
}
fn has(_c:i32,v:i32)i32 {
  // membership test: is v among the goal labels? Labels reach 22, so the
  // scan must cover bit 21 -- an 8-bit scan silently reported "not a member"
  // for every goal above label 8.
  let i:i32=1;
  while(i<=24){
    if((_c & (1<<(i-1)))!=0){ if(i==v){ return 1; } }
    i=i+1;
  }
  return 0;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let c:i32=0;
  let W:[]u8=z_alloc((MAXN()+8*8+16)*STRS());
  let i:i32=0;
  while(i<W.len/4){ set32(W,i*4,0); i=i+1; }
  let fr:[]u8=z_alloc(32);
  let out:[]u8=z_alloc(8);
  let tr:[]u8=z_alloc(32);

  let FA:[]u8=z_alloc(4*16);
  let FC:[]u8=z_alloc(4*16);
  let nf:i32=0;
  set32(FA,nf*4,10); set32(FC,nf*4,110); nf=nf+1;
  set32(FA,nf*4,11); set32(FC,nf*4,111); nf=nf+1;
  set32(FA,nf*4,20); set32(FC,nf*4,120); nf=nf+1;
  set32(FA,nf*4,21); set32(FC,nf*4,121); nf=nf+1;
  set32(FA,nf*4,12); set32(FC,nf*4,10);  nf=nf+1;
  set32(FA,nf*4,22); set32(FC,nf*4,20);  nf=nf+1;

  let store:[]u8=z_alloc(64);
  let con:[]u8=z_alloc(64);
  let ns:i32=0;
  let trA:[]u8=z_alloc(24);
  set32(trA,0,10); set32(trA,4,0); set32(trA,8,110);
  set32(trA,12,11); set32(trA,16,0); set32(trA,20,111);
  let trB:[]u8=z_alloc(24);
  set32(trB,0,110); set32(trB,4,0); set32(trB,8,12);
  set32(trB,12,120); set32(trB,16,0); set32(trB,20,22);
  let trD:[]u8=z_alloc(24);
  set32(trD,0,10); set32(trD,4,0); set32(trD,8,11);
  set32(trD,12,11); set32(trD,16,0); set32(trD,20,12);
  reset_graph(W);
  let la:[]u8=learn(W,trA,2,fr,out);
  if(get32(la,0)>=0){ ns=promo(W,get32(la,0),get32(la,4),store,ns); }
  reset_graph(W);
  let lb:[]u8=learn(W,trB,2,fr,out);
  if(get32(lb,0)>=0){ ns=promo(W,get32(lb,0),get32(lb,4),store,ns); }
  reset_graph(W);
  let ld:[]u8=learn(W,trD,2,fr,out);
  if(get32(ld,0)>=0){ ns=promo(W,get32(ld,0),get32(ld,4),store,ns); }
  reset_graph(W);
  let s:i32=0;
  while(s<ns){
    let p:[]u8=probe(W,get32(store,s*8),FA,FC,nf,fr,out);
    set32(con,s*8,get32(p,0));
    set32(con,s*8+4,get32(p,4));
    s=s+1;
  }

  c=o_app(ob,c,"PHASE 9 SELF-ORGANIZING ROLES FROM USE"); c=o_nl(ob,c);
  c=o_app(ob,c,"structures="); c=o_i64(ob,c,ns as i64);
  s=0;
  while(s<ns){
    c=o_app(ob,c,"  s"); c=o_i64(ob,c,s as i64);
    c=o_app(ob,c," in="); c=o_i64(ob,c,get32(con,s*8) as i64);
    c=o_app(ob,c," out="); c=o_i64(ob,c,get32(con,s*8+4) as i64);
    c=o_nl(ob,c);
    s=s+1;
  }
  c=o_app(ob,c,"no role names in this program. Features are structural:"); c=o_nl(ob,c);
  c=o_app(ob,c,"  class(arg0) class(arg1) arg0_in_goal arg1_in_goal"); c=o_nl(ob,c);

  // ---------- queries ----------
  // Q1 (10,121) goal {3}:  correct chain uses s0 then s1
  // Q2 (20,111) goal {5}:  correct chain uses s0 then s1
  // Q3 (11,121) goal {3}:  correct chain uses s2 then s1   <- repurposing case
  let q0v:[]u8=z_alloc(4*4);
  let q1v:[]u8=z_alloc(4*4);
  let glv:[]u8=z_alloc(4*4);
  // TRAIN: two queries favour s2, one favours the (s0,s1) chain
  set32(q0v,0,10); set32(q1v,0,121); set32(glv,0,bitof(11));
  set32(q0v,4,11); set32(q1v,4,121); set32(glv,4,bitof(12));
  set32(q0v,8,20); set32(q1v,8,111); set32(glv,8,bitof(22));
  // HELD OUT: same feature profile as train query 3, different args
  set32(q0v,12,20); set32(q1v,12,121); set32(glv,12,bitof(22));
  let target:i32=1;

  // DIAG inline (no bare block): every chain for train query 1
  let dv0:i32=10; let dv1:i32=121; let dgl:i32=bitof(11);
  c=o_app(ob,c,"DIAG Q1 (10,121) goal_mask="); c=o_i64(ob,c,dgl as i64);
  c=o_app(ob,c," class(11)="); c=o_i64(ob,c,vclass(FA,FC,nf,11) as i64);
  c=o_app(ob,c," class(10)="); c=o_i64(ob,c,vclass(FA,FC,nf,10) as i64); c=o_nl(ob,c);
  let da:i32=0;
  while(da<ns){
    let db:i32=0-1;
    while(db<ns){
      let dm:[]u8=z_alloc(8);
      exec(W,get32(store,da*8),dv0,dv1,fr,out);
      set32(dm,0,get32(out,0));
      let dcm:i32=0;
      if(get32(dm,0)!=FAILV()){ dcm=vclass(FA,FC,nf,get32(dm,0)); }
      if(dcm!=0 && db>=0){
        exec(W,get32(store,db*8),get32(dm,0),dv1,fr,out);
      }
      c=o_app(ob,c,"  chain("); c=o_i64(ob,c,da as i64); c=o_app(ob,c,",");
      c=o_i64(ob,c,db as i64);
      c=o_app(ob,c,") -> "); c=o_i64(ob,c,get32(out,0) as i64);
      c=o_app(ob,c," cls="); c=o_i64(ob,c,vclass(FA,FC,nf,get32(out,0)) as i64);
      c=o_app(ob,c," hit=");
      if(has(dgl,get32(out,0))==1){ c=o_app(ob,c,"1"); } else { c=o_app(ob,c,"0"); }
      c=o_nl(ob,c);
      db=db+1;
    }
    da=da+1;
  }
  o_flush(ob,c); c=0;

  // ---------- learn by doing: run each query, record which structure
  // succeeded and the situation features at that time ----------
  let freq:[]u8=z_alloc(32);
  let aff:[]u8=z_alloc(32*8*4);      // per structure, up to 8 recorded situations
  let nrec:[]u8=z_alloc(32);
  s=0;
  while(s<ns){ set32(freq,s*4,0); set32(nrec,s*4,0); s=s+1; }
  // teach on Q1 and Q2 only; Q3 is the held-out repurposing query
  let qi:i32=0;
  while(qi<4){
    let v0:i32=get32(q0v,qi*4);
    let v1:i32=get32(q1v,qi*4);
    let gl:i32=get32(glv,qi*4);
    let fv:[]u8=z_alloc(24);
    feat(FA,FC,nf,v0,v1,gl,fv);
    let cls0:i32=vclass(FA,FC,nf,v0);
    // try every eligible chain; the ones that succeed teach
    let a:i32=0;
    while(a<ns){
      if((get32(con,a*8)&cls0)!=0){
        let b2:i32=0-1;
        while(b2<ns){
          if(b2<0 || (get32(con,b2*8)&cls0)!=0){
            let m:[]u8=z_alloc(8);
            exec(W,get32(store,a*8),v0,v1,fr,out);
            set32(m,0,get32(out,0));
            if(get32(m,0)!=FAILV()){
              let cm:i32=vclass(FA,FC,nf,get32(m,0));
              if(cm!=0 && b2>=0){
                exec(W,get32(store,b2*8),get32(m,0),v1,fr,out);
              }
            }
            if(get32(out,0)!=FAILV()){
              if(vclass(FA,FC,nf,get32(out,0))==target){
                if(has(gl,get32(out,0))==1){
                  set32(freq,a*4,get32(freq,a*4)+1);
                  let nr:i32=get32(nrec,a*4);
                  if(nr<8){
                    set32(aff,(a*8+nr)*24,get32(fv,0));
                    set32(aff,(a*8+nr)*24+4,get32(fv,4));
                    set32(aff,(a*8+nr)*24+8,get32(fv,8));
                    set32(aff,(a*8+nr)*24+12,get32(fv,12));
                    set32(nrec,a*4,nr+1);
                  }
                  if(b2>=0 && b2!=a){
                    set32(freq,b2*4,get32(freq,b2*4)+1);
                    let nb:i32=get32(nrec,b2*4);
                    if(nb<8){
                      set32(aff,(b2*8+nb)*24,get32(fv,0));
                      set32(aff,(b2*8+nb)*24+4,get32(fv,4));
                      set32(aff,(b2*8+nb)*24+8,get32(fv,8));
                      set32(aff,(b2*8+nb)*24+12,get32(fv,12));
                      set32(nrec,b2*4,nb+1);
                    }
                  }
                }
              }
            }
          }
          b2=b2+1;
        }
      }
      a=a+1;
    }
    qi=qi+1;
  }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"learned from Q1,Q2 (Q3 held out):"); c=o_nl(ob,c);
  s=0;
  while(s<ns){
    c=o_app(ob,c,"  s"); c=o_i64(ob,c,s as i64);
    c=o_app(ob,c," successes="); c=o_i64(ob,c,get32(freq,s*4) as i64);
    c=o_app(ob,c," recorded_situations="); c=o_i64(ob,c,get32(nrec,s*4) as i64);
    c=o_nl(ob,c);
    s=s+1;
  }

  // ---------- evaluate three decision rules on ALL THREE queries ----------
  let okT:i32=0; let okF:i32=0; let okA:i32=0;
  let perT:[]u8=z_alloc(16);
  let perF:[]u8=z_alloc(16);
  let perA:[]u8=z_alloc(16);
  qi=0;
  while(qi<4){
    let v0:i32=get32(q0v,qi*4);
    let v1:i32=get32(q1v,qi*4);
    let gl:i32=get32(glv,qi*4);
    let cls0:i32=vclass(FA,FC,nf,v0);
    let fv:[]u8=z_alloc(24);
    feat(FA,FC,nf,v0,v1,gl,fv);
    // choose a structure by each rule, then take its best chain
    let pickT:i32=0-1; let pickF:i32=0-1; let pickA:i32=0-1;
    let bsT:i32=0-1000000; let bsF:i32=0-1000000; let bsA:i32=0-1000000;
    let a:i32=0;
    while(a<ns){
      if((get32(con,a*8)&cls0)!=0){
        // TYPE: does the argument class fit? (always true here -> tie)
        let st:i32=1;
        if(st>bsT){ bsT=st; pickT=a; }
        // FREQ
        if(get32(freq,a*4)>bsF){ bsF=get32(freq,a*4); pickF=a; }
        // AFFINITY: best feature overlap over recorded situations
        let best:i32=0-1000000;
        let r2:i32=0;
        while(r2<get32(nrec,a*4)){
          let rec:[]u8=z_alloc(24);
          set32(rec,0,get32(aff,(a*8+r2)*24));
          set32(rec,4,get32(aff,(a*8+r2)*24+4));
          set32(rec,8,get32(aff,(a*8+r2)*24+8));
          set32(rec,12,get32(aff,(a*8+r2)*24+12));
          let m2:i32=fmatch(fv,rec);
          if(m2>best){ best=m2; }
          r2=r2+1;
        }
        if(best>bsA){ bsA=best; pickA=a; }
      }
      a=a+1;
    }
    // run the chosen structure's chain and see if it reaches the goal
    let res:[]u8=z_alloc(24);
    set32(res,0,0-1); set32(res,4,0-1); set32(res,8,0-1);
    set32(res,12,0-1); set32(res,16,0); set32(res,20,0);
    if(pickA>=0){
      // length 2 chain (a,a) then length 1, whichever reaches goal
      exec(W,get32(store,pickA*8),v0,v1,fr,out);
      if(get32(out,0)!=FAILV()){
        if(vclass(FA,FC,nf,get32(out,0))==target){
          if(has(gl,get32(out,0))==1){ set32(res,0,get32(out,0)); }
        }
        exec(W,get32(store,pickA*8),get32(out,0),v1,fr,out);
        if(get32(out,0)!=FAILV()){
          if(vclass(FA,FC,nf,get32(out,0))==target){
            if(has(gl,get32(out,0))==1){ set32(res,0,get32(out,0)); }
          }
        }
      }
    }
    let gotA:i32=get32(res,0);
    // FREQ and TYPE use the same executor with their pick
    let gotF:i32=0-1; let gotT:i32=0-1;
    if(pickF>=0){
      exec(W,get32(store,pickF*8),v0,v1,fr,out);
      if(get32(out,0)!=FAILV()){
        if(vclass(FA,FC,nf,get32(out,0))==target){ if(has(gl,get32(out,0))==1){ gotF=get32(out,0); } }
        exec(W,get32(store,pickF*8),get32(out,0),v1,fr,out);
        if(get32(out,0)!=FAILV()){
          if(vclass(FA,FC,nf,get32(out,0))==target){ if(has(gl,get32(out,0))==1){ gotF=get32(out,0); } }
        }
      }
    }
    if(pickT>=0){
      exec(W,get32(store,pickT*8),v0,v1,fr,out);
      if(get32(out,0)!=FAILV()){
        if(vclass(FA,FC,nf,get32(out,0))==target){ if(has(gl,get32(out,0))==1){ gotT=get32(out,0); } }
        exec(W,get32(store,pickT*8),get32(out,0),v1,fr,out);
        if(get32(out,0)!=FAILV()){
          if(vclass(FA,FC,nf,get32(out,0))==target){ if(has(gl,get32(out,0))==1){ gotT=get32(out,0); } }
        }
      }
    }
    let okA2:i32=0; if(has(gl,gotA)==1){ okA2=1; }
    let okF2:i32=0; if(has(gl,gotF)==1){ okF2=1; }
    let okT2:i32=0; if(has(gl,gotT)==1){ okT2=1; }
    okT=okT+okT2; okF=okF+okF2; okA=okA+okA2;
    set32(perT,qi*4,okT2); set32(perF,qi*4,okF2); set32(perA,qi*4,okA2);
    qi=qi+1;
  }

  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"correct by rule (Q1 Q2 Q3):"); c=o_nl(ob,c);
  c=o_app(ob,c,"  (columns are Q1 Q2 Q3 train, then Q4 HELD OUT)"); c=o_nl(ob,c);
  c=o_app(ob,c,"  TYPE     "); i=0;
  while(i<4){ c=o_i64(ob,c,get32(perT,i*4) as i64); c=o_app(ob,c," "); i=i+1; }
  c=o_app(ob,c," total="); c=o_i64(ob,c,okT as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  FREQ     "); i=0;
  while(i<4){ c=o_i64(ob,c,get32(perF,i*4) as i64); c=o_app(ob,c," "); i=i+1; }
  c=o_app(ob,c," total="); c=o_i64(ob,c,okF as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"  AFFINITY "); i=0;
  while(i<4){ c=o_i64(ob,c,get32(perA,i*4) as i64); c=o_app(ob,c," "); i=i+1; }
  c=o_app(ob,c," total="); c=o_i64(ob,c,okA as i64); c=o_nl(ob,c);

  let bAffinityBeatsFreq:i32=0;
  if(okA>okF){ bAffinityBeatsFreq=1; }
  let bAffinityBeatsType:i32=0;
  if(okA>okT){ bAffinityBeatsType=1; }
  let bRepurpose:i32=0;
  if(get32(perA,8)==1){ bRepurpose=1; }
  c=o_app(ob,c,""); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR affinity_beats_freq="); c=o_i64(ob,c,bAffinityBeatsFreq as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR affinity_beats_type="); c=o_i64(ob,c,bAffinityBeatsType as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR repurposes_heldout_query="); c=o_i64(ob,c,bRepurpose as i64); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR named_modes=0"); c=o_nl(ob,c);
  c=o_app(ob,c,"BAR L3="); c=o_i64(ob,c,0); c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}
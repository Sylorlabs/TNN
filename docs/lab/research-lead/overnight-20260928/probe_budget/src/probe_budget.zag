// probe_budget.zag -- PBUDGET: experience-set probe budgets.
// Pure Zag. World + learner + driver + single raw-syscall flush.
// Prereg: probe_budget/PREREG.md (frozen kill bars KB1..KB5).
//
// Boundary discipline: the learner (pb_learner, pb_learn) sees only
// the free surface signal. Hidden info values are world held
// (pb_info) and resolved by the driver AFTER a spend decision.
// pb_learner and pb_learn never call pb_info.

const PB_T:i32=30;
const PB_BUDGET:i32=5;

const LS_PRED:i32=0;
const LS_MEAN:i32=4;
const LS_BUDGET:i32=8;
const LS_CAPTURED:i32=12;
const LS_PROBES:i32=16;
const LS_DRIFT:i32=20;
const LS_REFUSED:i32=24;

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// WORLD (frozen per PREREG section 2).
fn pb_surface(t:i32)i32 {
  if(t<15){ return 100+(2*(t%3)); }
  return 200+(40*((t*5+1)%3));
}
fn pb_info(t:i32)i32 {
  if(t<15){ return 1; }
  if(t>19){ return 1; }
  return 10;
}

// LEARNER (frozen per PREREG section 3). Sees obs only.
// Returns 1 if a probe was spent this step, 0 otherwise.
fn pb_learner(obs:i32, st:[]u8)i32 {
  let pred:i32=get32(st,LS_PRED);
  let mean:i32=get32(st,LS_MEAN);
  let budget:i32=get32(st,LS_BUDGET);
  let d:i32=obs-pred;
  let surp:i32=d;
  if(d<0){surp=0-d;}
  if(surp>=mean){ mean=mean+(surp-mean)/32; }
  else { mean=mean-(mean-surp)/32; }
  set32(st,LS_MEAN,mean);
  let gate:i32=5+(2*mean);
  let spent:i32=0;
  if(surp>gate){
    if(budget>0){
      set32(st,LS_BUDGET,budget-1);
      set32(st,LS_PROBES,get32(st,LS_PROBES)+1);
      set32(st,LS_PRED,obs);
      spent=1;
    } else {
      set32(st,LS_REFUSED,get32(st,LS_REFUSED)+1);
    }
  }
  if(spent==0){
    if(d>=0){ pred=pred+d/4; }
    else { pred=pred-((0-d)/4); }
    set32(st,LS_PRED,pred);
  }
  return spent;
}
// Learner incorporates the revealed info after a spent probe.
fn pb_learn(st:[]u8, info:i32, t:i32)void {
  set32(st,LS_CAPTURED,get32(st,LS_CAPTURED)+info);
  if(t>=15){ if(t<=19){ set32(st,LS_DRIFT,get32(st,LS_DRIFT)+1); } }
  return;
}

fn main()i32 {
  let ob:[]u8=z_alloc(4096);
  let at:i32=0;
  at=ob_app(ob,at,"PROBE-BUDGET-RUN\n");
  let st:[]u8=z_alloc(32);
  set32(st,LS_PRED,100);
  set32(st,LS_MEAN,0);
  set32(st,LS_BUDGET,PB_BUDGET);
  let t:i32=0;
  while(t<PB_T){
    let obs:i32=pb_surface(t);
    let spent:i32=pb_learner(obs,st);
    if(spent==1){ pb_learn(st,pb_info(t),t); }
    at=ob_app(ob,at,"t=");
    at=ob_i32(ob,at,t);
    at=ob_app(ob,at," obs=");
    at=ob_i32(ob,at,obs);
    at=ob_app(ob,at," spent=");
    at=ob_i32(ob,at,spent);
    at=ob_app(ob,at," pred=");
    at=ob_i32(ob,at,get32(st,LS_PRED));
    at=ob_app(ob,at," mean=");
    at=ob_i32(ob,at,get32(st,LS_MEAN));
    at=ob_nl(ob,at);
    t=t+1;
  }
  let probes:i32=get32(st,LS_PROBES);
  let captured:i32=get32(st,LS_CAPTURED);
  let drift:i32=get32(st,LS_DRIFT);
  let refused:i32=get32(st,LS_REFUSED);
  let bleft:i32=get32(st,LS_BUDGET);
  let base:i32=pb_info(0)+pb_info(6)+pb_info(12)+pb_info(18)+pb_info(24);
  at=ob_app(ob,at,"METRICS probes=");
  at=ob_i32(ob,at,probes);
  at=ob_app(ob,at," captured=");
  at=ob_i32(ob,at,captured);
  at=ob_app(ob,at," drift=");
  at=ob_i32(ob,at,drift);
  at=ob_app(ob,at," refused=");
  at=ob_i32(ob,at,refused);
  at=ob_app(ob,at," budget_left=");
  at=ob_i32(ob,at,bleft);
  at=ob_app(ob,at," baseline=");
  at=ob_i32(ob,at,base);
  at=ob_nl(ob,at);
  let k1:i32=0;
  if(probes<=PB_BUDGET){ if(refused>=1){ k1=1; } }
  let k2:i32=0;
  if(captured>=40){ k2=1; }
  let k3:i32=0;
  if(drift>=4){ k3=1; }
  let k4:i32=0;
  if(captured>=2*base){ k4=1; }
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);
  let pass:i32=k1+k2+k3+k4;
  if(pass==4){
    at=ob_app(ob,at,"VERDICT PROBE-BUDGET-COMPLETE\n");
  } else {
    at=ob_app(ob,at,"VERDICT FAIL bars-passed=");
    at=ob_i32(ob,at,pass);
    at=ob_app(ob,at,"/4\n");
  }
  at=ob_app(ob,at,"PROBE-BUDGET-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

// axcx2.zag -- A1 adversary AX-CX2: sealed World C.
// H5=[(X,Z,5),(Z,Y,0)], H6=[(X,Y,4)].
// Generic simulator copied from committed cxconstruct.zag semantics.
// Verbatim iterative-deepening loop with parameterized MAXD.
// Run with MAXD=5 (expect NO-DISCRIMINATING-SEQUENCE) and MAXD=6
// (expect SELECT [S,W,W,W,W,OY]).
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
// World C rules as DATA. h: 0=H5, 1=H6.
// H5=[(X,Z,5),(Z,Y,0)], H6=[(X,Y,4)]. Variables X=0,Z=1,Y=2.
fn n_rules(h:i32)i32 {
  if(h==0){return 2;}
  return 1;
}
fn get_rule(h:i32,r:i32,out:[]u8)void {
  let src:i32=0; let dst:i32=0; let delay:i32=0;
  if(h==0){
    if(r==0){src=0;dst=1;delay=5;}
    else{src=1;dst=2;delay=0;}
  } else {
    src=0;dst=2;delay=4;
  }
  set32(out,0,src); set32(out,4,dst); set32(out,8,delay);
  return;
}
// Generic simulator: same semantics as committed cxconstruct.zag.
// State (32 bytes): +0 X,+4 Z,+8 Y,+12 t,+16 tX,+20 tZ,+24 tY.
// Actions: 0=S, 1=W, 2=OY, 3=OZ. Returns observation or -1.
fn step(h:i32,st:[]u8,a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<2){
      let r:i32=0;
      let nr:i32=n_rules(h);
      while(r<nr){
        let rb:[]u8=z_alloc(12);
        get_rule(h,r,rb);
        let src:i32=get32(rb,0);
        let dst:i32=get32(rb,4);
        let delay:i32=get32(rb,8);
        if(get32(st,src*4)==1){
          let ts:i32=get32(st,16+src*4);
          if(t-ts>=delay){
            if(get32(st,dst*4)==0){
              set32(st,dst*4,1);
              set32(st,16+dst*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else if(a==3){
    obs=get32(st,4);
  }
  return obs;
}
fn sim_seq(h:i32,seq:[]u8,len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=step(h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn has_observe(seq:[]u8,len:i32)i32 {
  let i:i32=0;
  while(i<len){
    if((seq[i] as i32)>=2){return 1;}
    i=i+1;
  }
  return 0;
}
fn emit_action(a:i32)void {
  if(a==0){emit("S");}
  else if(a==1){emit("W");}
  else if(a==2){emit("OY");}
  else{emit("OZ");}
  return;
}
fn emit_seq2(seq:[]u8,len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit_action(seq[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}
// Verbatim search loop from committed source, MAXD parameterized.
fn run_search(maxd:i32)void {
  let found:i32=0;
  let fseq:[]u8=z_alloc(8);
  let flen:i32=0;
  let fp0:i32=-9;
  let fp1:i32=-9;
  let d:i32=1;
  while(d<=maxd){
    if(found==1){break;}
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*4; k=k+1;}
    let checked:i32=0;
    let si:i32=0;
    while(si<total){
      if(found==1){break;}
      let seq:[]u8=z_alloc(8);
      let div:i32=1;
      let p:i32=0;
      while(p<d-1){div=div*4; p=p+1;}
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        seq[i]=(rem/div) as u8;
        rem=rem%div;
        if(div>1){div=div/4;}
        i=i+1;
      }
      if(has_observe(seq,d)==1){
        checked=checked+1;
        let q0:i32=sim_seq(0,seq,d);
        let q1:i32=sim_seq(1,seq,d);
        if(q0!=q1){
          found=1;
          flen=d;
          fp0=q0; fp1=q1;
          let c:i32=0;
          while(c<d){fseq[c]=seq[c]; c=c+1;}
        }
      }
      si=si+1;
    }
    emit("DEPTH "); e64(d);
    emit(" checked="); e64(checked);
    emit(" found="); e64(found); emit("\n");
    d=d+1;
  }
  if(found==0){
    emit("NO-DISCRIMINATING-SEQUENCE\n");
  } else {
    emit("SELECT seq=");
    emit_seq2(fseq,flen);
    emit(" h5pred="); e64(fp0);
    emit(" h6pred="); e64(fp1); emit("\n");
  }
  return;
}
fn main()i32 {
  emit("=== World C, MAXD=5 ===\n");
  run_search(5);
  emit("=== World C, MAXD=6 ===\n");
  run_search(6);
  return 0;
}

// axcx_enum.zag -- A1 adversary: pure enumeration check.
// No hypothesis simulation. No simulator. Just lexicographic base-4
// counting over {S=0,W=1,OY=2,OZ=3}, counting sequences with >=1
// observe action, and finding the ordinal of [S,W,OY] at depth 3 and
// [S,W,W,OY] at depth 4 among with-observe sequences.
// Pure Zag. No Python.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn has_observe(seq:[]u8,len:i32)i32 {
  let i:i32=0;
  while(i<len){
    if((seq[i] as i32)>=2){return 1;}
    i=i+1;
  }
  return 0;
}
fn seq_is(seq:[]u8,len:i32,targ:[]u8)i32 {
  let i:i32=0;
  while(i<len){
    if((seq[i] as i32)!=(targ[i] as i32)){return 0;}
    i=i+1;
  }
  return 1;
}
fn main()i32 {
  // targets: [S,W,OY] and [S,W,W,OY]
  let t3:[]u8=z_alloc(3); t3[0]=0; t3[1]=1; t3[2]=2;
  let t4:[]u8=z_alloc(4); t4[0]=0; t4[1]=1; t4[2]=1; t4[3]=2;
  let ord3:i32=0;
  let ord4:i32=0;
  let d:i32=1;
  while(d<=5){
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*4; k=k+1;}
    let withobs:i32=0;
    let si:i32=0;
    while(si<total){
      let seq:[]u8=z_alloc(6);
      let div:i32=1;
      let p:i32=0;
      while(p<d-1){div=div*4; p=p+1;}
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        seq[i]=(rem/div) as u8;
        rem=rem%div;
        if(div>1){div=div/4;}
        i=i+1;
      }
      if(has_observe(seq,d)==1){
        withobs=withobs+1;
        if(d==3 && seq_is(seq,d,t3)==1){ord3=withobs;}
        if(d==4 && seq_is(seq,d,t4)==1){ord4=withobs;}
      }
      si=si+1;
    }
    emit("DEPTH "); e64(d);
    emit(" total="); e64(total);
    emit(" withobs="); e64(withobs); emit("\n");
    d=d+1;
  }
  emit("ORD [S,W,OY]@d3 = "); e64(ord3); emit("\n");
  emit("ORD [S,W,W,OY]@d4 = "); e64(ord4); emit("\n");
  if(ord3==3 && ord4==15){
    emit("MATCH: pure enumeration gives 3 and 15, identical to raw output checked counts.\n");
  } else {
    emit("MISMATCH\n");
  }
  return 0;
}

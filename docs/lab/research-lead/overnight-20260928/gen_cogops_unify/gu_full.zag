// gu_base.zag -- GEN-COGOPS-UNIFY PoC base.
// Derived from gen_generality/ref_gg_base.zag (frozen). All functions below
// are byte-identical to the frozen base EXCEPT the marked GU-DELTA items.
// Deltas:
//   GU-DELTA 1: arena is 32768 bytes (was 4096); layout extended past 4096.
//   GU-DELTA 2: MAP table holds 8 maps at offset 4096 (was 4 maps at 776);
//               second-input table holds 8 maps at 4416 (was 4 maps at 968).
//               mg/mp/m2g/m2p rebased accordingly. Old regions untouched.
//   GU-DELTA 3: pkind returns kind 3 for goal-handle values
//               (v >= 1000000). Kinds 1/2 semantics unchanged.
//   GU-DELTA 4: exec_map dispatches new MAP classes 10 (RET_SPEC) and
//               11 (RET_GEN) to the glue (gu_glue.zag).
//   GU-DELTA 5: exec_map2 dispatches new MAP class 12 (VFY2, binary:
//               goal-handle + subject -> verdict) to the glue.
// Pure Zag. Output rule: single _zag_raw_syscall write via o_* helpers.

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
fn ag(A:[]u8,off:i32)i32 { return get32(A,off); }
fn ap(A:[]u8,off:i32,v:i32)void { set32(A,off,v); return; }
// GU-DELTA 2: MAP table rebased to 4096, 8 maps.
fn mg(A:[]u8,m:i32,f:i32)i32 { return get32(A,4096+m*40+f*4); }
fn mp(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,4096+m*40+f*4,v); return; }
// GU-DELTA 1: 32768-byte arena.
fn world_new()[]u8 { return z_alloc(32768); }
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=ag(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    ap(A,0,n+1);
  }
  return;
}
fn is_subject(A:[]u8,v:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12)==v){ return 1; }
    i=i+1;
  }
  return 0;
}
// GU-DELTA 3: kind 3 = goal-handle range. Kinds 1/2 unchanged.
fn pkind(A:[]u8,v:i32)i32 {
  if(v>=1000000){ return 3; }
  if(is_subject(A,v)==1){ return 1; }
  return 2;
}
fn walkf(A:[]u8,s:i32,rel:i32)i32 {
  let cur:i32=s;
  let steps:i32=0;
  while(steps<32){
    let n:i32=ag(A,0);
    let i:i32=0;
    let nxt:i32=-2;
    while(i<n){
      let fs0:i32=get32(A,4+i*12);
      let fr0:i32=get32(A,4+i*12+4);
      if(fs0==cur && fr0==rel){ nxt=get32(A,4+i*12+8); i=n; }
      i=i+1;
    }
    if(nxt==-2){
      if(steps==0){ return -2; }
      return cur;
    }
    cur=nxt;
    steps=steps+1;
  }
  return cur;
}
fn count_rel(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    let fs0:i32=get32(A,4+i*12);
    let fr0:i32=get32(A,4+i*12+4);
    if(fs0==s && fr0==rel){ c=c+1; }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
// GU-DELTA 4: classes 10/11 dispatch to cognitive glue.
fn exec_map(A:[]u8,m:i32,s:i32)i32 {
  let cl:i32=mg(A,m,0);
  let r1:i32=mg(A,m,1);
  if(cl==0){ return walkf(A,s,r1); }
  if(cl==1){ return count_rel(A,s,r1); }
  if(cl==3){ return s; }
  if(cl==4){ return -2; }
  if(cl==10){ return glue_ret10(A,m,s); }
  if(cl==11){ return glue_ret11(A,m,s); }
  let r2:i32=mg(A,m,2);
  let e:i32=walkf(A,s,r1);
  if(e==-2){ return -2; }
  let c:i32=count_rel(A,e,r2);
  if(c==-2){ return e; }
  return c;
}
fn observe(A:[]u8,m:i32,inv:i32,outv:i32)void {
  let ik:i32=pkind(A,inv);
  let ok:i32=pkind(A,outv);
  if(ik==1){ mp(A,m,5,mg(A,m,5)+1); }
  if(ik==2){ mp(A,m,6,mg(A,m,6)+1); }
  if(ok==1){ mp(A,m,7,mg(A,m,7)+1); }
  if(ok==2){ mp(A,m,8,mg(A,m,8)+1); }
  mp(A,m,3,mg(A,m,3)|(1<<(ik-1)));
  mp(A,m,4,mg(A,m,4)|(1<<(ok-1)));
  mp(A,m,9,mg(A,m,9)+1);
  return;
}
fn teach(A:[]u8,m:i32,s:i32,exp:i32)void {
  let v:i32=exec_map(A,m,s);
  if(v==exp){ observe(A,m,s,v); }
  return;
}
fn map_new(A:[]u8,m:i32,cl:i32,r1:i32,r2:i32)void {
  mp(A,m,0,cl); mp(A,m,1,r1); mp(A,m,2,r2);
  return;
}
// GU-DELTA 2: second-input table rebased to 4416, 8 maps.
fn m2g(A:[]u8,m:i32,f:i32)i32 { return get32(A,4416+m*12+f*4); }
fn m2p(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,4416+m*12+f*4,v); return; }
// GU-DELTA 5: class 12 (VFY2) dispatch to cognitive glue.
fn exec_map2(A:[]u8,m:i32,s1:i32,s2:i32)i32 {
  let cl:i32=mg(A,m,0);
  if(cl==4){
    if(s1==-2){ return -2; }
    if(s2==-2){ return -2; }
    return s1+s2;
  }
  if(cl==12){ return glue_vfy12(A,m,s1,s2); }
  return -2;
}
fn observe2(A:[]u8,m:i32,in1:i32,in2:i32,outv:i32)void {
  let k1:i32=pkind(A,in1);
  let k2:i32=pkind(A,in2);
  let ko:i32=pkind(A,outv);
  mp(A,m,3,mg(A,m,3)|(1<<(k1-1)));
  m2p(A,m,0,m2g(A,m,0)|(1<<(k2-1)));
  mp(A,m,4,mg(A,m,4)|(1<<(ko-1)));
  if(k1==1){ mp(A,m,5,mg(A,m,5)+1); }
  if(k1==2){ mp(A,m,6,mg(A,m,6)+1); }
  if(k2==1){ m2p(A,m,1,m2g(A,m,1)+1); }
  if(k2==2){ m2p(A,m,2,m2g(A,m,2)+1); }
  if(ko==1){ mp(A,m,7,mg(A,m,7)+1); }
  if(ko==2){ mp(A,m,8,mg(A,m,8)+1); }
  mp(A,m,9,mg(A,m,9)+1);
  return;
}
fn teach2(A:[]u8,m:i32,s1:i32,s2:i32,exp:i32)void {
  let v:i32=exec_map2(A,m,s1,s2);
  if(v==exp){ observe2(A,m,s1,s2,v); }
  return;
}
// gu_learn.zag -- learner-owned procedure bodies, LIFTED VERBATIM.
// Source A: cogops_compose/cc_learn.zag lines 21-172 (coverage sets,
// specialize_ret/vfy, ret_spec, vfy_spec). Source B: cogops_compose/cc_base.zag
// (ret_gen, vfy_gen). Byte-verified by gu_build.sh. No modifications.

fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  if(ret_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  if(ret_cov_find(L,r)<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
fn ret_cov_clear(L:[]u8)void { set32(L,0,0); return; }
// ---- verify working set ----
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  if(vfy_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  if(vfy_cov_find(L,r)<0){
    let n:i32=get32(L,4248);
    if(n<16){ set32(L,4252+n*4,r); set32(L,4248,n+1); }
  }
  return;
}
// ---- specialize_ret: build the learner-owned indexed RETRIEVE ----
// One linear pass over all facts; each fact whose relation is in the
// retrieve working set is appended to that relation's bucket.
fn specialize_ret(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
// ---- specialize_vfy: build the learner-owned indexed VERIFY ----
fn specialize_vfy(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  return;
}
// ---- ret_spec: the learner-owned specialized RETRIEVE (id 2) ----
// Scans only the learned bucket for the pattern's relation. Returns -1
// if the relation is outside the learned coverage.
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
// ---- vfy_spec: the learner-owned specialized VERIFY (id 3) ----
// Scans only the learned bucket for each step's relation. Returns -1
// if any step's relation is outside the learned coverage.
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- episodes: experience steps ----

// ---- from cc_base.zag (researcher-supplied generic procedures) ----
// Fully generic: scans ALL facts (cost = nfacts checks), no index.
// kb/ko is the check-counter cell.
fn ret_gen(A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let nf:i32=get32(A,0);
  let n:i32=0;
  let j:i32=0;
  while(j<nf){
    set32(kb,ko,get32(kb,ko)+1);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    if(fr==rel){
      if(fo==obj){
        let fs:i32=get32(A,4+j*12);
        if(n<32){ set32(out,oo+4+n*4,fs); }
        n=n+1;
      }
    }
    j=j+1;
  }
  set32(out,oo,n);
  return n;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 1).
// Returns 1 iff every chain step matches at least one fact.
// Fully generic: scans ALL facts for every step (cost = nsteps*nfacts),
// no early exit, no index. kb/ko is the check-counter cell.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// gu_glue.zag -- GEN-COGOPS-UNIFY PoC glue (NEW code, not lifted).
//
// This file is the entire "unification adapter": it registers the
// learner-owned cognitive procedures as GEN-composable MAPs.
//
// Design:
// - Each cognitive procedure becomes a MAP class with kind contracts:
//     class 10 RET_SPEC: unary,  inmask {3} (goal-handle kind).
//       Unpacks (rel,obj) from the goal record, runs the LEARNER-OWNED
//       ret_spec body (gu_learn.zag, verbatim from cogops_compose),
//       MULTI-EMITS each retrieved subject into GEN's value pool via
//       gen_addval (provenance: this MAP + the goal-handle pool index),
//       and returns -3 (emission-summary sentinel: never equals a real
//       exp, never enters the pool, but teachable for contract growth).
//     class 11 RET_GEN: same, but runs ret_gen (the generic oracle body).
//       Trial order [spec, gen] + spec declining (-1) when uncovered
//       reproduces cogops' coverage-driven version fallback emergently.
//     class 12 VFY2: binary, inmask {3} (goal-handle), inmask2 {1}
//       (subject). Unpacks the chain template from the goal record,
//       fills the -9 subject-slot with the pool subject, runs the
//       LEARNER-OWNED vfy_spec body, returns the 0/1 verdict (or -1
//       when uncovered, which GEN treats as a declined trial).
// - Goal records live in arena GBUF (8032, 8 x 256 bytes). A goal handle
//   is the integer 1000000+slot; pkind classifies v>=1000000 as kind 3.
//   The handle encoding is opaque to GEN (domain-blind: bare integers).
// - Learner state L and scratch buffers (KB, OUT, TMPC) are heap slices
//   whose pointers are stored as i64 in fixed arena cells (8000..8024)
//   by the driver; the glue reconstructs them with the z_alloc idiom.
// - No world literals appear here: no relation ids, no goal tags, no
//   pattern values. Only encoding constants (1000000, -3, -9).

// ---- pointer-cell access (heap slices registered by the driver) ----
fn getL(A:[]u8)[]u8 {
  let m:i64=((1 as i64)<<32)-1;
  let lo:i64=(get32(A,8000) as i64)&m;
  let hi:i64=(get32(A,8004) as i64)&m;
  let p:*u8=(lo|(hi<<32)) as *u8;
  return p[0..16384];
}
fn getKB(A:[]u8)[]u8 {
  let m:i64=((1 as i64)<<32)-1;
  let lo:i64=(get32(A,8008) as i64)&m;
  let hi:i64=(get32(A,8012) as i64)&m;
  let p:*u8=(lo|(hi<<32)) as *u8;
  return p[0..64];
}
fn getOUT(A:[]u8)[]u8 {
  let m:i64=((1 as i64)<<32)-1;
  let lo:i64=(get32(A,8016) as i64)&m;
  let hi:i64=(get32(A,8020) as i64)&m;
  let p:*u8=(lo|(hi<<32)) as *u8;
  return p[0..512];
}
fn getTMPC(A:[]u8)[]u8 {
  let m:i64=((1 as i64)<<32)-1;
  let lo:i64=(get32(A,8024) as i64)&m;
  let hi:i64=(get32(A,8028) as i64)&m;
  let p:*u8=(lo|(hi<<32)) as *u8;
  return p[0..512];
}
fn store_ptr(A:[]u8,cell:i32,b:[]u8)void {
  let lp:i64=_zag_slice_ptr(b) as i64;
  set32(A,cell,lp as i32);
  set32(A,cell+4,(lp>>32) as i32);
  return;
}
// ---- GEN pool helpers ----
// Pool index of value v (-1 if absent). Needed so multi-emitted subjects
// carry correct provenance (this MAP + the goal-handle pool index).
fn pool_idx(A:[]u8,v:i32)i32 {
  let n:i32=get32(A,3588);
  let k:i32=0;
  while(k<n){
    if(get32(A,1024+k*4)==v){ return k; }
    k=k+1;
  }
  return -1;
}
// Seed the pool with a single value (mirrors gen_solve's seeding;
// used before teach so emission provenance resolves).
fn pool_seed(A:[]u8,s:i32)void {
  set32(A,1024,s); set32(A,1280,pkind(A,s));
  set32(A,1536,-1); set32(A,1540,-1); set32(A,1544,-1);
  set32(A,3588,1);
  return;
}
// ---- class 10: RET_SPEC as a GEN MAP ----
fn glue_ret10(A:[]u8,m:i32,gval:i32)i32 {
  if(gval<1000000){ return -2; }
  let slot:i32=gval-1000000;
  if(slot>7){ return -2; }
  let L:[]u8=getL(A);
  let kb:[]u8=getKB(A);
  let out:[]u8=getOUT(A);
  let goff:i32=8032+slot*256;
  let rel:i32=get32(A,goff);
  let obj:i32=get32(A,goff+4);
  let ns:i32=ret_spec(L,A,rel,obj,kb,12,out,0);
  if(ns<0){ return -1; }
  let ipat:i32=pool_idx(A,gval);
  if(ipat<0){ return -2; }
  let ne:i32=ns;
  if(ne>32){ ne=32; }
  let k:i32=0;
  while(k<ne){
    gen_addval(A,m,ipat,-1,get32(out,4+k*4));
    k=k+1;
  }
  return -3;
}
// ---- class 11: RET_GEN as a GEN MAP (generic fallback) ----
fn glue_ret11(A:[]u8,m:i32,gval:i32)i32 {
  if(gval<1000000){ return -2; }
  let slot:i32=gval-1000000;
  if(slot>7){ return -2; }
  let kb:[]u8=getKB(A);
  let out:[]u8=getOUT(A);
  let goff:i32=8032+slot*256;
  let rel:i32=get32(A,goff);
  let obj:i32=get32(A,goff+4);
  let ns:i32=ret_gen(A,rel,obj,kb,12,out,0);
  let ipat:i32=pool_idx(A,gval);
  if(ipat<0){ return -2; }
  let ne:i32=ns;
  if(ne>32){ ne=32; }
  let k:i32=0;
  while(k<ne){
    gen_addval(A,m,ipat,-1,get32(out,4+k*4));
    k=k+1;
  }
  return -3;
}
// ---- class 12: VFY2 as a GEN MAP (goal-handle + subject -> verdict) ----
fn glue_vfy12(A:[]u8,m:i32,gval:i32,sval:i32)i32 {
  if(gval<1000000){ return -2; }
  if(sval<0){ return -2; }
  let slot:i32=gval-1000000;
  if(slot>7){ return -2; }
  let L:[]u8=getL(A);
  let kb:[]u8=getKB(A);
  let C:[]u8=getTMPC(A);
  let goff:i32=8032+slot*256;
  let nst:i32=get32(A,goff+8);
  if(nst<1){ return -2; }
  if(nst>8){ return -2; }
  set32(C,0,nst);
  let i:i32=0;
  while(i<nst){
    let sr:i32=get32(A,goff+12+i*12);
    let r:i32=get32(A,goff+12+i*12+4);
    let o:i32=get32(A,goff+12+i*12+8);
    if(sr==-9){ sr=sval; }
    set32(C,4+i*12,sr);
    set32(C,4+i*12+4,r);
    set32(C,4+i*12+8,o);
    i=i+1;
  }
  let v:i32=vfy_spec(L,A,C,kb,16);
  return v;
}
// gu_gen.zag -- GEN composer for the GEN-COGOPS-UNIFY PoC.
// Source: gen_statefix/gsf_gen.zag (post-GEN-STATEFIX GEN) with TWO
// documented deltas, both diff-audited by gu_build.sh:
//   GU-GEN-DELTA 1: garity maps class 12 (VFY2) to arity 2.
//   GU-GEN-DELTA 2: tried-state tables relocated and resized for 6 MAPs.
//     tried1: 2304 (4x64) -> 10080 (6x64); tried2 count 3328 -> 11616,
//     entries 3332 -> 11620. The frozen 4-MAP tried1 would alias nv/
//     widened for m>=4 (found by audit 2026-10-03). Trial LOGIC
//     (admission, rounds, verify, widen, record) is untouched.

// d6_gen.zag -- GEN: value-graph generalization of U (frozen PREREG Sec 4).
// Iterated n-ary application over a value pool. Preserves U's principles:
// kind-set contracts, compatibility admission (k_has, empty = compatible),
// deterministic ordered trial, end-to-end verification (result == expected),
// failure-triggered widening (admission-off phase, WIDEN=1 once),
// success-recording with contract growth (via provenance closure).
// Generalizes: trial space {singles, ordered pairs} -> value graph;
// pair handshake (outmask INTERSECTS inmask, a prediction) -> observed-kind
// checking (stage 1 executes; stage 2 tests the observed value's kind).
// outmask remains learned contract state (census-visible, grown by recording)
// but does not gate pool expansion. No modes, no flags, no shape templates,
// no domain handlers, no diamond-specific code.
// GEN scratch (arena 1024..3916; zeroed by world_new; untouched by U):
//   1024: V pool, 64 x 4 bytes            1280: K kinds, 64 x 4
//   1536: P provenance, 64 x 3 x 4       2304: tried1, 4 x 64 x 4 bytes
//   3328: tried2 count; 3332: entries, 64 x 4
//   3588: nv   3592: widened flag        3596: visit stack, 64 x 1 byte
//   3660: done set, 64 x 1 byte (ends 3724 < 4096; u8-packed because the
//   i32 layout overflowed the arena by 12 bytes, found in testing)
fn gvb(A:[]u8,off:i32)i32 { return A[off] as i32; }
fn svb(A:[]u8,off:i32,v:i32)void { A[off]=v as u8; return; }
fn g_khas(mask:i32,k:i32)i32 {
  if(mask==0){ return 1; }
  if((mask & (1<<(k-1)))!=0){ return 1; }
  return 0;
}
fn gV(A:[]u8,i:i32)i32 { return get32(A,1024+i*4); }
fn gK(A:[]u8,i:i32)i32 { return get32(A,1280+i*4); }
fn gP(A:[]u8,i:i32,f:i32)i32 { return get32(A,1536+(i*3+f)*4); }
fn gnv(A:[]u8)i32 { return get32(A,3588); }
fn tried1_g(A:[]u8,m:i32,i:i32)i32 { return get32(A,10080+(m*64+i)*4); }
fn tried1_s(A:[]u8,m:i32,i:i32)void { set32(A,10080+(m*64+i)*4,1); return; }
fn garity(A:[]u8,m:i32)i32 {
  if(mg(A,m,0)==4){ return 2; } if(mg(A,m,0)==12){ return 2; } // GU-GEN-DELTA 1
  return 1;
}
fn tried2_has(A:[]u8,m:i32,i:i32,j:i32)i32 {
  let e:i32=m*4096+i*64+j;
  let n:i32=get32(A,11616);
  let k:i32=0;
  while(k<n){
    if(get32(A,11620+k*4)==e){ return 1; }
    k=k+1;
  }
  return 0;
}
fn tried2_add(A:[]u8,m:i32,i:i32,j:i32)void {
  let n:i32=get32(A,11616);
  if(n<64){
    set32(A,11620+n*4,m*4096+i*64+j);
    set32(A,11616,n+1);
  }
  return;
}
// Add v to the pool (or return its existing index). Records provenance.
fn gen_addval(A:[]u8,m:i32,i1:i32,i2:i32,v:i32)i32 {
  let n:i32=get32(A,3588);
  let k:i32=0;
  while(k<n){
    if(get32(A,1024+k*4)==v){ return k; }
    k=k+1;
  }
  if(n<64){
    set32(A,1024+n*4,v);
    set32(A,1280+n*4,pkind(A,v));
    set32(A,1536+(n*3+0)*4,m);
    set32(A,1536+(n*3+1)*4,i1);
    set32(A,1536+(n*3+2)*4,i2);
    set32(A,3588,n+1);
    return n;
  }
  return -1;
}
// Observe the successful app, then every app in its dependency closure.
fn gen_record(A:[]u8,m:i32,i1:i32,i2:i32,v:i32)void {
  let d:i32=0;
  while(d<64){ svb(A,3660+d,0); d=d+1; }
  if(i2<0){ observe(A,m,gV(A,i1),v); }
  if(i2>=0){ observe2(A,m,gV(A,i1),gV(A,i2),v); }
  let sp:i32=0;
  svb(A,3596+sp,i1); sp=sp+1;
  if(i2>=0){ svb(A,3596+sp,i2); sp=sp+1; }
  while(sp>0){
    sp=sp-1;
    let x:i32=gvb(A,3596+sp);
    let ok:i32=0;
    if(x>0){ if(gvb(A,3660+x)==0){ ok=1; } }
    if(ok==1){
      svb(A,3660+x,1);
      let pm:i32=gP(A,x,0);
      if(pm>=0){
        let pi1:i32=gP(A,x,1);
        let pi2:i32=gP(A,x,2);
        if(pi2<0){ observe(A,pm,gV(A,pi1),gV(A,x)); }
        if(pi2>=0){ observe2(A,pm,gV(A,pi1),gV(A,pi2),gV(A,x)); }
        svb(A,3596+sp,pi1); sp=sp+1;
        if(pi2>=0){ svb(A,3596+sp,pi2); sp=sp+1; }
      }
    }
  }
  return;
}
fn gen_app1(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,exp:i32)i32 {
  tried1_s(A,m,i);
  ap(A,936,ag(A,936)+1);
  let v:i32=exec_map(A,m,gV(A,i));
  c=o_app(B,c,"INTER="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
  if(v==exp){
    gen_record(A,m,i,-1,v);
    ap(A,944,v); ap(A,940,1);
    return c;
  }
  if(v>=0){ gen_addval(A,m,i,-1,v); }
  return c;
}
fn gen_cell1(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,exp:i32)i32 {
  if(tried1_g(A,m,i)==1){ return c; }
  let adm:i32=1;
  if(get32(A,3592)==0){
    if(g_khas(mg(A,m,3),gK(A,i))==0){ adm=0; }
  }
  if(adm==0){ return c; }
  c=gen_app1(A,B,c,m,i,exp);
  return c;
}
fn gen_m1(A:[]u8,B:[]u8,c:i32,m:i32,ns0:i32,exp:i32)i32 {
  let i:i32=0;
  while(i<ns0){
    c=gen_cell1(A,B,c,m,i,exp);
    if(ag(A,940)==1){ return c; }
    i=i+1;
  }
  return c;
}
fn gen_app2(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,j:i32,exp:i32)i32 {
  tried2_add(A,m,i,j);
  ap(A,936,ag(A,936)+1);
  let v:i32=exec_map2(A,m,gV(A,i),gV(A,j));
  c=o_app(B,c,"INTER2="); c=o_i64(B,c,v as i64); c=o_nl(B,c);
  if(v==exp){
    gen_record(A,m,i,j,v);
    ap(A,944,v); ap(A,940,1);
    return c;
  }
  if(v>=0){ gen_addval(A,m,i,j,v); }
  return c;
}
fn gen_cell2(A:[]u8,B:[]u8,c:i32,m:i32,i:i32,j:i32,exp:i32)i32 {
  if(tried2_has(A,m,i,j)==1){ return c; }
  let adm:i32=1;
  if(get32(A,3592)==0){
    let a:i32=g_khas(mg(A,m,3),gK(A,i));
    let b:i32=g_khas(m2g(A,m,0),gK(A,j));
    if(a==0){ adm=0; }
    if(b==0){ adm=0; }
  }
  if(adm==0){ return c; }
  c=gen_app2(A,B,c,m,i,j,exp);
  return c;
}
fn gen_m2(A:[]u8,B:[]u8,c:i32,m:i32,ns0:i32,exp:i32)i32 {
  let i:i32=0;
  while(i<ns0){
    let j:i32=0;
    while(j<ns0){
      c=gen_cell2(A,B,c,m,i,j,exp);
      if(ag(A,940)==1){ return c; }
      j=j+1;
    }
    i=i+1;
  }
  return c;
}
fn gen_round(A:[]u8,B:[]u8,c:i32,ns0:i32,exp:i32,nm:i32)i32 {
  let m:i32=0;
  while(m<nm){
    if(garity(A,m)==1){
      c=gen_m1(A,B,c,m,ns0,exp);
      if(ag(A,940)==1){ return c; }
    }
    m=m+1;
  }
  let m2:i32=0;
  while(m2<nm){
    if(garity(A,m2)==2){
      c=gen_m2(A,B,c,m2,ns0,exp);
      if(ag(A,940)==1){ return c; }
    }
    m2=m2+1;
  }
  return c;
}
fn gen_solve(A:[]u8,B:[]u8,c:i32,s:i32,kin:i32,kout:i32,exp:i32,nm:i32)i32 {
  ap(A,936,0); ap(A,940,0); ap(A,944,-2);
  set32(A,1024,s); set32(A,1280,pkind(A,s));
  set32(A,1536,-1); set32(A,1540,-1); set32(A,1544,-1);
  set32(A,3588,1);
  set32(A,3592,0);
  // GEN-STATEFIX: per-query tried-state scoping. Clear tried1 (2304..3328)
  // and tried2 (count at 3328) so a later query on the same arena
  // re-enumerates the trial space. Contract-growth state lives in the
  // census-visible masks, not in these tables.
  let zti:i32=0;
  while(zti<384){
    set32(A,10080+zti*4,0);
    zti=zti+1;
  }
  set32(A,11616,0);
  let round:i32=0;
  while(round<6){
    round=round+1;
    let ns0:i32=gnv(A);
    let nt0:i32=ag(A,936);
    c=gen_round(A,B,c,ns0,exp,nm);
    if(ag(A,940)==1){ return c; }
    let nt1:i32=ag(A,936);
    let nv1:i32=gnv(A);
    let quiet:i32=0;
    if(nt1==nt0){ if(nv1==ns0){ quiet=1; } }
    if(quiet==1){
      if(get32(A,3592)==0){
        set32(A,3592,1);
        c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
      } else {
        return c;
      }
    }
  }
  return c;
}
fn gen_report(A:[]u8,B:[]u8,c:i32,arm:[]u8,prob:[]u8)i32 {
  c=o_app(B,c,"ARM="); c=o_app(B,c,arm); c=o_app(B,c," PROB="); c=o_app(B,c,prob);
  c=o_app(B,c," ANS="); c=o_i64(B,c,ag(A,944) as i64);
  c=o_app(B,c," TRIES="); c=o_i64(B,c,ag(A,936) as i64); c=o_nl(B,c);
  return c;
}
fn gen_census(A:[]u8,B:[]u8,c:i32,nm:i32)i32 {
  let m:i32=0;
  while(m<nm){
    c=o_app(B,c,"CENSUS m="); c=o_i64(B,c,m as i64);
    c=o_app(B,c," inmask="); c=o_i64(B,c,mg(A,m,3) as i64);
    c=o_app(B,c," outmask="); c=o_i64(B,c,mg(A,m,4) as i64);
    c=o_app(B,c," inmask2="); c=o_i64(B,c,m2g(A,m,0) as i64);
    c=o_app(B,c," n="); c=o_i64(B,c,mg(A,m,9) as i64);
    c=o_nl(B,c);
    m=m+1;
  }
  return c;
}
// gu_main.zag -- GEN-COGOPS-UNIFY PoC driver.
// World literals live ONLY here (as in cogops_compose/cc_world.zag).
// gu_learn.zag and gu_glue.zag contain no world literals (audited).

fn wgoal(A:[]u8,slot:i32,rel:i32,obj:i32,r0:i32,o0:i32,r1:i32,o1:i32)void {
  let goff:i32=8032+slot*256;
  set32(A,goff,rel);
  set32(A,goff+4,obj);
  set32(A,goff+8,2);
  set32(A,goff+12,-9); set32(A,goff+16,r0); set32(A,goff+20,o0);
  set32(A,goff+24,-9); set32(A,goff+28,r1); set32(A,goff+32,o1);
  return;
}

fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=world_new();
  // learner state + scratch buffers (pointers registered for the glue)
  let L:[]u8=z_alloc(16384);
  let KB:[]u8=z_alloc(64);
  let OUT:[]u8=z_alloc(512);
  let TMPC:[]u8=z_alloc(512);
  store_ptr(A,8000,L);
  store_ptr(A,8008,KB);
  store_ptr(A,8016,OUT);
  store_ptr(A,8024,TMPC);
  // ---- world facts ----
  fact_add(A,311,301,321); fact_add(A,312,301,322);
  fact_add(A,313,301,323); fact_add(A,314,301,324);
  fact_add(A,311,302,322); fact_add(A,312,302,323);
  fact_add(A,313,302,324); fact_add(A,314,302,325);
  fact_add(A,331,307,341); fact_add(A,332,307,342);
  fact_add(A,332,307,341);
  fact_add(A,311,301,320); fact_add(A,312,301,320);
  // ---- learner episodes: working sets, then specialization ----
  // (learner-owned bodies built from experience, as in COGOPS-COMPOSE)
  ret_log_rel(L,301); ret_log_rel(L,302);
  specialize_ret(L,A,0,2);
  vfy_log_rel(L,301); vfy_log_rel(L,302);
  specialize_vfy(L,A,3,3);
  // ---- goal records (environment-defined) ----
  // slot0 (teach): pattern (301,323); template (S,302,324),(S,301,323)
  wgoal(A,0,301,323,302,324,301,323);
  // slot1 (F1): same shape as teach (fresh handle)
  wgoal(A,1,301,323,302,324,301,323);
  // slot2 (F2): pattern (302,325)->[314]; template fails step 0
  wgoal(A,2,302,325,301,329,302,325);
  // slot3 (F4): empty pattern (301,999): no subject matches; decline arm
  wgoal(A,3,301,999,302,324,301,323);
  // slot4 (U3): multi-subject pattern (301,320)->[311,312]; fan-out/in arm
  wgoal(A,4,301,320,302,324,301,323);
  // slot5 (U10): uncovered-relation pattern (307,341); fallback arm
  wgoal(A,5,307,341,302,324,301,323);
  // ---- one MAP pool: 3 cognitive + 3 domain structures ----
  // (m5 registered but only tried when nm=6, i.e. the U10 arm)
  map_new(A,0,10,0,0);
  map_new(A,1,11,0,0);
  map_new(A,2,12,0,0);
  map_new(A,3,1,302,0);
  map_new(A,4,4,0,0);
  map_new(A,5,1,307,0);
  // ---- teach: kind contracts grown from experience (masks start 0) ----
  pool_seed(A,1000000);
  teach(A,0,1000000,-3);
  teach(A,1,1000000,-3);
  teach2(A,2,1000000,313,1);
  teach(A,3,311,1);
  teach2(A,4,2,3,5);
  teach(A,5,331,1);
  c=o_app(B,c,"TEACH-CENSUS"); c=o_nl(B,c);
  c=gen_census(A,B,c,6);
  // ---- Q_F1: cognitive RETRIEVE + domain COUNT. expect ANS=1 TRIES=3 ----
  c=gen_solve(A,B,c,1000001,3,2,1,5);
  c=gen_report(A,B,c,"GU","F1");
  c=gen_census(A,B,c,5);
  // ---- Q_F2: cognitive RETRIEVE + cognitive VERIFY (negative case).
  // expect ANS=0 TRIES=4 ----
  c=gen_solve(A,B,c,1000002,3,2,0,5);
  c=gen_report(A,B,c,"GU","F2");
  c=gen_census(A,B,c,5);
  // ---- Q_F3: decline control (nothing composes). expect ANS=-2 ----
  c=gen_solve(A,B,c,42,2,2,999,5);
  c=gen_report(A,B,c,"GU","F3");
  // ---- Q_F4: empty-pattern decline (ns=0 path; WIDEN=1 must not
  // fabricate). expect ANS=-2 ----
  c=gen_solve(A,B,c,1000003,3,2,7,5);
  c=gen_report(A,B,c,"GU","F4");
  // ---- Q_U3: multi-subject fan-out (cog RET) -> per-subject domain COUNT
  // -> fan-in ADD2. frozen ANS=2 TRIES=7 ----
  c=gen_solve(A,B,c,1000004,3,2,2,5);
  c=gen_report(A,B,c,"GU","U3");
  c=gen_census(A,B,c,5);
  // ---- Q_U10: uncovered relation (307): spec declines (-1), generic
  // falls back, composition still succeeds. frozen ANS=2 TRIES=6 ----
  c=gen_solve(A,B,c,1000005,3,2,2,6);
  c=gen_report(A,B,c,"GU","U10");
  c=gen_census(A,B,c,6);
  o_flush(B,c);
  return 0;
}

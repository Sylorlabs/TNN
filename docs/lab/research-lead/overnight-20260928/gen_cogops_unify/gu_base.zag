// gu_base.zag -- GEN-COGOPS-UNIFY PoC base.
// Derived from gen_generality/ref_gg_base.zag (frozen). All functions below
// are byte-identical to the frozen base EXCEPT the marked GU-DELTA items.
// Deltas:
//   GU-DELTA 1: arena is 32768 bytes (was 4096); layout extended past 4096.
//   GU-DELTA 2: MAP table holds 8 maps at offset 4096 (was 4 maps at 776);
//               second-input table holds 8 maps at 4416 (was 4 maps at 968).
//               mg/mp/m2g/m2p rebased accordingly. Old regions untouched.
//   GU-DELTA 3: pkind returns kind 3 for goal-handle values
//               (v >= 1000000). Kinds 1/2 semantics unchanged.
//   GU-DELTA 4: exec_map dispatches new MAP classes 10 (RET_SPEC) and
//               11 (RET_GEN) to the glue (gu_glue.zag).
//   GU-DELTA 5: exec_map2 dispatches new MAP class 12 (VFY2, binary:
//               goal-handle + subject -> verdict) to the glue.
// Pure Zag. Output rule: single _zag_raw_syscall write via o_* helpers.

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
fn ag(A:[]u8,off:i32)i32 { return get32(A,off); }
fn ap(A:[]u8,off:i32,v:i32)void { set32(A,off,v); return; }
// GU-DELTA 2: MAP table rebased to 4096, 8 maps.
fn mg(A:[]u8,m:i32,f:i32)i32 { return get32(A,4096+m*40+f*4); }
fn mp(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,4096+m*40+f*4,v); return; }
// GU-DELTA 1: 32768-byte arena.
fn world_new()[]u8 { return z_alloc(32768); }
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=ag(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    ap(A,0,n+1);
  }
  return;
}
fn is_subject(A:[]u8,v:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12)==v){ return 1; }
    i=i+1;
  }
  return 0;
}
// GU-DELTA 3: kind 3 = goal-handle range. Kinds 1/2 unchanged.
fn pkind(A:[]u8,v:i32)i32 {
  if(v>=1000000){ return 3; }
  if(is_subject(A,v)==1){ return 1; }
  return 2;
}
fn walkf(A:[]u8,s:i32,rel:i32)i32 {
  let cur:i32=s;
  let steps:i32=0;
  while(steps<32){
    let n:i32=ag(A,0);
    let i:i32=0;
    let nxt:i32=-2;
    while(i<n){
      let fs0:i32=get32(A,4+i*12);
      let fr0:i32=get32(A,4+i*12+4);
      if(fs0==cur && fr0==rel){ nxt=get32(A,4+i*12+8); i=n; }
      i=i+1;
    }
    if(nxt==-2){
      if(steps==0){ return -2; }
      return cur;
    }
    cur=nxt;
    steps=steps+1;
  }
  return cur;
}
fn count_rel(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    let fs0:i32=get32(A,4+i*12);
    let fr0:i32=get32(A,4+i*12+4);
    if(fs0==s && fr0==rel){ c=c+1; }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
// GU-DELTA 4: classes 10/11 dispatch to cognitive glue.
fn exec_map(A:[]u8,m:i32,s:i32)i32 {
  let cl:i32=mg(A,m,0);
  let r1:i32=mg(A,m,1);
  if(cl==0){ return walkf(A,s,r1); }
  if(cl==1){ return count_rel(A,s,r1); }
  if(cl==3){ return s; }
  if(cl==4){ return -2; }
  if(cl==10){ return glue_ret10(A,m,s); }
  if(cl==11){ return glue_ret11(A,m,s); }
  let r2:i32=mg(A,m,2);
  let e:i32=walkf(A,s,r1);
  if(e==-2){ return -2; }
  let c:i32=count_rel(A,e,r2);
  if(c==-2){ return e; }
  return c;
}
fn observe(A:[]u8,m:i32,inv:i32,outv:i32)void {
  let ik:i32=pkind(A,inv);
  let ok:i32=pkind(A,outv);
  if(ik==1){ mp(A,m,5,mg(A,m,5)+1); }
  if(ik==2){ mp(A,m,6,mg(A,m,6)+1); }
  if(ok==1){ mp(A,m,7,mg(A,m,7)+1); }
  if(ok==2){ mp(A,m,8,mg(A,m,8)+1); }
  mp(A,m,3,mg(A,m,3)|(1<<(ik-1)));
  mp(A,m,4,mg(A,m,4)|(1<<(ok-1)));
  mp(A,m,9,mg(A,m,9)+1);
  return;
}
fn teach(A:[]u8,m:i32,s:i32,exp:i32)void {
  let v:i32=exec_map(A,m,s);
  if(v==exp){ observe(A,m,s,v); }
  return;
}
fn map_new(A:[]u8,m:i32,cl:i32,r1:i32,r2:i32)void {
  mp(A,m,0,cl); mp(A,m,1,r1); mp(A,m,2,r2);
  return;
}
// GU-DELTA 2: second-input table rebased to 4416, 8 maps.
fn m2g(A:[]u8,m:i32,f:i32)i32 { return get32(A,4416+m*12+f*4); }
fn m2p(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,4416+m*12+f*4,v); return; }
// GU-DELTA 5: class 12 (VFY2) dispatch to cognitive glue.
fn exec_map2(A:[]u8,m:i32,s1:i32,s2:i32)i32 {
  let cl:i32=mg(A,m,0);
  if(cl==4){
    if(s1==-2){ return -2; }
    if(s2==-2){ return -2; }
    return s1+s2;
  }
  if(cl==12){ return glue_vfy12(A,m,s1,s2); }
  return -2;
}
fn observe2(A:[]u8,m:i32,in1:i32,in2:i32,outv:i32)void {
  let k1:i32=pkind(A,in1);
  let k2:i32=pkind(A,in2);
  let ko:i32=pkind(A,outv);
  mp(A,m,3,mg(A,m,3)|(1<<(k1-1)));
  m2p(A,m,0,m2g(A,m,0)|(1<<(k2-1)));
  mp(A,m,4,mg(A,m,4)|(1<<(ko-1)));
  if(k1==1){ mp(A,m,5,mg(A,m,5)+1); }
  if(k1==2){ mp(A,m,6,mg(A,m,6)+1); }
  if(k2==1){ m2p(A,m,1,m2g(A,m,1)+1); }
  if(k2==2){ m2p(A,m,2,m2g(A,m,2)+1); }
  if(ko==1){ mp(A,m,7,mg(A,m,7)+1); }
  if(ko==2){ mp(A,m,8,mg(A,m,8)+1); }
  mp(A,m,9,mg(A,m,9)+1);
  return;
}
fn teach2(A:[]u8,m:i32,s1:i32,s2:i32,exp:i32)void {
  let v:i32=exec_map2(A,m,s1,s2);
  if(v==exp){ observe2(A,m,s1,s2,v); }
  return;
}

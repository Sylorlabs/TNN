// gu_main.zag -- GEN-COGOPS-UNIFY PoC driver.
// World literals live ONLY here (as in cogops_compose/cc_world.zag).
// gu_learn.zag and gu_glue.zag contain no world literals (audited).

fn wgoal(A:[]u8,slot:i32,rel:i32,obj:i32,r0:i32,o0:i32,r1:i32,o1:i32)void {
  let goff:i32=8032+slot*256;
  set32(A,goff,rel);
  set32(A,goff+4,obj);
  set32(A,goff+8,2);
  set32(A,goff+12,-9); set32(A,goff+16,r0); set32(A,goff+20,o0);
  set32(A,goff+24,-9); set32(A,goff+28,r1); set32(A,goff+32,o1);
  return;
}

fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=world_new();
  // learner state + scratch buffers (pointers registered for the glue)
  let L:[]u8=z_alloc(16384);
  let KB:[]u8=z_alloc(64);
  let OUT:[]u8=z_alloc(512);
  let TMPC:[]u8=z_alloc(512);
  store_ptr(A,8000,L);
  store_ptr(A,8008,KB);
  store_ptr(A,8016,OUT);
  store_ptr(A,8024,TMPC);
  // ---- world facts ----
  fact_add(A,311,301,321); fact_add(A,312,301,322);
  fact_add(A,313,301,323); fact_add(A,314,301,324);
  fact_add(A,311,302,322); fact_add(A,312,302,323);
  fact_add(A,313,302,324); fact_add(A,314,302,325);
  fact_add(A,331,307,341); fact_add(A,332,307,342);
  fact_add(A,332,307,341);
  fact_add(A,311,301,320); fact_add(A,312,301,320);
  // ---- learner episodes: working sets, then specialization ----
  // (learner-owned bodies built from experience, as in COGOPS-COMPOSE)
  ret_log_rel(L,301); ret_log_rel(L,302);
  specialize_ret(L,A,0,2);
  vfy_log_rel(L,301); vfy_log_rel(L,302);
  specialize_vfy(L,A,3,3);
  // ---- goal records (environment-defined) ----
  // slot0 (teach): pattern (301,323); template (S,302,324),(S,301,323)
  wgoal(A,0,301,323,302,324,301,323);
  // slot1 (F1): same shape as teach (fresh handle)
  wgoal(A,1,301,323,302,324,301,323);
  // slot2 (F2): pattern (302,325)->[314]; template fails step 0
  wgoal(A,2,302,325,301,329,302,325);
  // slot3 (F4): empty pattern (301,999): no subject matches; decline arm
  wgoal(A,3,301,999,302,324,301,323);
  // slot4 (U3): multi-subject pattern (301,320)->[311,312]; fan-out/in arm
  wgoal(A,4,301,320,302,324,301,323);
  // slot5 (U10): uncovered-relation pattern (307,341); fallback arm
  wgoal(A,5,307,341,302,324,301,323);
  // ---- one MAP pool: 3 cognitive + 3 domain structures ----
  // (m5 registered but only tried when nm=6, i.e. the U10 arm)
  map_new(A,0,10,0,0);
  map_new(A,1,11,0,0);
  map_new(A,2,12,0,0);
  map_new(A,3,1,302,0);
  map_new(A,4,4,0,0);
  map_new(A,5,1,307,0);
  // ---- teach: kind contracts grown from experience (masks start 0) ----
  pool_seed(A,1000000);
  teach(A,0,1000000,-3);
  teach(A,1,1000000,-3);
  teach2(A,2,1000000,313,1);
  teach(A,3,311,1);
  teach2(A,4,2,3,5);
  teach(A,5,331,1);
  c=o_app(B,c,"TEACH-CENSUS"); c=o_nl(B,c);
  c=gen_census(A,B,c,6);
  // ---- Q_F1: cognitive RETRIEVE + domain COUNT. expect ANS=1 TRIES=3 ----
  c=gen_solve(A,B,c,1000001,3,2,1,5);
  c=gen_report(A,B,c,"GU","F1");
  c=gen_census(A,B,c,5);
  // ---- Q_F2: cognitive RETRIEVE + cognitive VERIFY (negative case).
  // expect ANS=0 TRIES=4 ----
  c=gen_solve(A,B,c,1000002,3,2,0,5);
  c=gen_report(A,B,c,"GU","F2");
  c=gen_census(A,B,c,5);
  // ---- Q_F3: decline control (nothing composes). expect ANS=-2 ----
  c=gen_solve(A,B,c,42,2,2,999,5);
  c=gen_report(A,B,c,"GU","F3");
  // ---- Q_F4: empty-pattern decline (ns=0 path; WIDEN=1 must not
  // fabricate). expect ANS=-2 ----
  c=gen_solve(A,B,c,1000003,3,2,7,5);
  c=gen_report(A,B,c,"GU","F4");
  // ---- Q_U3: multi-subject fan-out (cog RET) -> per-subject domain COUNT
  // -> fan-in ADD2. frozen ANS=2 TRIES=7 ----
  c=gen_solve(A,B,c,1000004,3,2,2,5);
  c=gen_report(A,B,c,"GU","U3");
  c=gen_census(A,B,c,5);
  // ---- Q_U10: uncovered relation (307): spec declines (-1), generic
  // falls back, composition still succeeds. frozen ANS=2 TRIES=6 ----
  c=gen_solve(A,B,c,1000005,3,2,2,6);
  c=gen_report(A,B,c,"GU","U10");
  c=gen_census(A,B,c,6);
  o_flush(B,c);
  return 0;
}

// driver.zag -- SHIFT mask-revision experiment driver.
// Four arms, kill-bar evaluation. The driver teaches X/Y, schedules
// the learner's x_revise_masks consolidation calls, runs the
// learner's construct, and evaluates Z. It never invents the
// intermediate and never computes masks: all mask work goes through
// learner.zag. Prereg: spec_mask_revision/PREREG.md. Pure Zag.

fn d_y_prior(st:[]u8, ob:[]u8, at:i32)i32 {
  y_teach(st,7,1); y_teach(st,8,1); y_teach(st,9,1);
  y_teach(st,3,0); y_teach(st,4,0); y_teach(st,5,0);
  let bs:i32=y_fit(st);
  at=ob_app(ob,at,"Y-PRIOR fit=");
  at=ob_i32(ob,at,bs);
  at=ob_app(ob,at,"/6 t=");
  at=ob_i32(ob,at,get32(st,296));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_old(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_oldseq(i,sq);
    let id:i32=w_oldid(i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    at=ob_app(ob,at,"X-OLD id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," seq=");
    let k:i32=0;
    while(k<6){
      at=ob_i32(ob,at,(sq[k] as i32));
      if(k<5){at=ob_app(ob,at,",");}
      k=k+1;
    }
    at=ob_nl(ob,at);
    i=i+1;
  }
  let L:i32=x_learn_len(st);
  x_revise_masks(st);
  at=ob_app(ob,at,"LEARN-LEN L=");
  at=ob_i32(ob,at,L);
  at=ob_app(ob,at," LEARN-MASKS k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
fn d_consolidate(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  x_revise_masks(st);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," MASKS k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_train(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let n:i32=w_n(ph);
  let i:i32=0;
  while(i<n){
    w_seq(ph,i,sq);
    let id:i32=w_id(ph,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    let lb:i32=0;
    if(ph==1){lb=w_true1((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));}
    else {lb=w_true2((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));}
    lab_teach(st,id,lb);
    at=ob_app(ob,at,"X-TRAIN ph=");
    at=ob_i32(ob,at,ph);
    at=ob_app(ob,at," id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," seq=");
    let k:i32=0;
    while(k<6){
      at=ob_i32(ob,at,(sq[k] as i32));
      if(k<5){at=ob_app(ob,at,",");}
      k=k+1;
    }
    at=ob_app(ob,at," label=");
    at=ob_i32(ob,at,lb);
    at=ob_nl(ob,at);
    i=i+1;
  }
  let L:i32=x_learn_len(st);
  at=ob_app(ob,at,"LEARN-LEN ph=");
  at=ob_i32(ob,at,ph);
  at=ob_app(ob,at," L=");
  at=ob_i32(ob,at,L);
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_test(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let n:i32=w_n(ph);
  let i:i32=0;
  while(i<n){
    w_seq(ph,i,sq);
    let id:i32=w_id(ph,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    at=ob_app(ob,at,"X-TEST ph=");
    at=ob_i32(ob,at,ph);
    at=ob_app(ob,at," id=");
    at=ob_i32(ob,at,id);
    at=ob_nl(ob,at);
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[300] as i32));
  at=ob_app(ob,at," gen=");
  at=ob_i32(ob,at,(st[301] as i32));
  at=ob_app(ob,at," sup=");
  at=ob_i32(ob,at,(st[302] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,304));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[308+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
fn d_adapt_stat(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," L=");
  at=ob_i32(ob,at,(st[4] as i32));
  at=ob_app(ob,at," spec=");
  at=ob_i32(ob,at,get32(st,396));
  at=ob_app(ob,at," calls=");
  at=ob_i32(ob,at,get32(st,400));
  at=ob_nl(ob,at);
  return at;
}
// Build M on (eids,labs); res: [0]=n [4]=t [8]=score.
fn d_build_m(st:[]u8, eids:[]u8, labs:[]u8, ne:i32, gen:i32, rg:[]u8, sq:[]u8, vals:[]u8, res:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,"--- construct M (gen ");
  at=ob_i32(ob,at,gen);
  at=ob_app(ob,at,") ---\n");
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct(st,eids,labs,ne,init,0,rg,sq,vals,mbuf,mout,ob,at);
  let mn:i32=get32(mout,0);
  let mt:i32=get32(mout,4);
  let ms:i32=get32(mout,8);
  at=ob_app(ob,at,"M-BUILT n=");
  at=ob_i32(ob,at,mn);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,mt);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,ms);
  at=ob_app(ob,at,"/");
  at=ob_i32(ob,at,ne);
  at=ob_nl(ob,at);
  m_write(st,mn,gen,mt,mbuf);
  if(mn>0){
    set32(st,296,mt);
    at=ob_app(ob,at,"T-AGREE y=");
    at=ob_i32(ob,at,get32(st,296));
    at=ob_app(ob,at," m=");
    at=ob_i32(ob,at,get32(st,304));
    at=ob_nl(ob,at);
  }
  at=d_m_dump(st,"M-STATE",ob,at);
  set32(res,0,mn); set32(res,4,mt); set32(res,8,ms);
  return at;
}
fn d_z_run(st:[]u8, eids:[]u8, ne:i32, ph:i32, rg:[]u8, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let nr:i32=x_recall(st,id,sq);
    let idx:i32=id-9;
    if(ph==2){idx=id-29;}
    let tl:i32=w_tlabel(ph,idx);
    let sv:i32=-999;
    at=ob_app(ob,at,"Z id=");
    at=ob_i32(ob,at,id);
    if(nr>0){
      let mn:i32=st[300] as i32;
      if(mn>0){
        let mp:[]u8=z_alloc(24);
        let k:i32=0;
        while(k<24){mp[k]=st[308+k];k=k+1;}
        sv=p_exec(mp,mn,(sq[0] as i32),(sq[1] as i32),rg);
      }
      at=ob_app(ob,at," seq=");
      let k:i32=0;
      while(k<nr){
        at=ob_i32(ob,at,(sq[k] as i32));
        if(k<nr-1){at=ob_app(ob,at,",");}
        k=k+1;
      }
    } else {
      at=ob_app(ob,at," seq=none");
    }
    let ok:i32=0;
    if(dec==tl){ok=1;}
    if(ok==1){c=c+1;}
    at=ob_app(ob,at," s=");
    at=ob_i32(ob,at,sv);
    at=ob_app(ob,at," dec=");
    at=ob_i32(ob,at,dec);
    at=ob_app(ob,at," true=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  let rg:[]u8=z_alloc(8);
  let sq:[]u8=z_alloc(6);
  let vals:[]u8=z_alloc(32);
  let atp:[]u8=z_alloc(4);
  let res:[]u8=z_alloc(12);
  at=ob_app(ob,at,"SHIFT-MASK-REVISION-START\n");

  let eids1:[]u8=z_alloc(8);
  let labs1:[]u8=z_alloc(8);
  let eidsT1:[]u8=z_alloc(4);
  let eids2:[]u8=z_alloc(8);
  let labs2:[]u8=z_alloc(8);
  let eidsT2:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<8){
    eids1[i]=(i+1) as u8;
    eids2[i]=(i+21) as u8;
    if(i<4){eidsT1[i]=(i+9) as u8; eidsT2[i]=(i+29) as u8;}
    i=i+1;
  }

  // ================= ARM-BASE =================
  at=ob_app(ob,at,"=== ARM-BASE ===\n");
  let st1:[]u8=z_alloc(2048);
  st1[5]=1;
  at=d_y_prior(st1,ob,at);
  at=d_teach_old(st1,ob,at);
  let m0k1:i32=st1[404] as i32;
  let m0k2:i32=st1[405] as i32;
  let rp0:i32=get32(st1,406);
  at=d_teach_train(st1,1,ob,at);
  at=d_teach_test(st1,2,ob,at);
  at=d_consolidate(st1,"CONSOLIDATE-1",ob,at);
  let c1k1:i32=st1[404] as i32;
  let c1k2:i32=st1[405] as i32;
  i=0;
  while(i<8){labs1[i]=lab_get(st1,(i+1)) as u8;i=i+1;}
  at=d_build_m(st1,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  let mn1:i32=get32(res,0);
  let mt1:i32=get32(res,4);
  set32(atp,0,at);
  let z1:i32=d_z_run(st1,eidsT1,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-PHASE1 ");
  at=ob_i32(ob,at,z1);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st1,"ADAPT-STAT-BASE",ob,at);

  // ================= ARM-STALE-KEEP =================
  at=ob_app(ob,at,"=== ARM-STALE-KEEP ===\n");
  let st2:[]u8=z_alloc(2048);
  st2[5]=1;
  at=d_y_prior(st2,ob,at);
  at=d_teach_old(st2,ob,at);
  at=d_teach_train(st2,1,ob,at);
  at=d_teach_test(st2,2,ob,at);
  at=d_consolidate(st2,"CONSOLIDATE-1",ob,at);
  i=0;
  while(i<8){labs1[i]=lab_get(st2,(i+1)) as u8;i=i+1;}
  at=d_build_m(st2,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  at=d_teach_train(st2,3,ob,at);
  at=d_teach_test(st2,4,ob,at);
  at=ob_app(ob,at,"NO-REVISION (masks stay k1=");
  at=ob_i32(ob,at,(st2[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st2[405] as i32));
  at=ob_app(ob,at,")\n");
  set32(atp,0,at);
  let zsk:i32=d_z_run(st2,eidsT2,4,2,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-STALE-KEEP ");
  at=ob_i32(ob,at,zsk);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st2,"ADAPT-STAT-STALEKEEP",ob,at);

  // ================= ARM-STALE-REBUILD =================
  at=ob_app(ob,at,"=== ARM-STALE-REBUILD ===\n");
  let st3:[]u8=z_alloc(2048);
  st3[5]=1;
  at=d_y_prior(st3,ob,at);
  at=d_teach_old(st3,ob,at);
  at=d_teach_train(st3,1,ob,at);
  at=d_teach_test(st3,2,ob,at);
  at=d_consolidate(st3,"CONSOLIDATE-1",ob,at);
  i=0;
  while(i<8){labs1[i]=lab_get(st3,(i+1)) as u8;i=i+1;}
  at=d_build_m(st3,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  at=d_teach_train(st3,3,ob,at);
  at=ob_app(ob,at,"NO-REVISION; rebuild M on phase-2 train with stale masks\n");
  i=0;
  while(i<8){labs2[i]=lab_get(st3,(i+21)) as u8;i=i+1;}
  at=d_build_m(st3,eids2,labs2,8,2,rg,sq,vals,res,ob,at);
  let mnR:i32=get32(res,0);
  at=d_teach_test(st3,4,ob,at);
  set32(atp,0,at);
  let zsr:i32=d_z_run(st3,eidsT2,4,2,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-STALE-REBUILD ");
  at=ob_i32(ob,at,zsr);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st3,"ADAPT-STAT-STALEREBUILD",ob,at);

  // ================= ARM-REVISE =================
  at=ob_app(ob,at,"=== ARM-REVISE ===\n");
  let st4:[]u8=z_alloc(2048);
  st4[5]=1;
  at=d_y_prior(st4,ob,at);
  at=d_teach_old(st4,ob,at);
  at=d_teach_train(st4,1,ob,at);
  at=d_teach_test(st4,2,ob,at);
  at=d_consolidate(st4,"CONSOLIDATE-1",ob,at);
  i=0;
  while(i<8){labs1[i]=lab_get(st4,(i+1)) as u8;i=i+1;}
  at=d_build_m(st4,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  at=d_teach_train(st4,3,ob,at);
  at=d_consolidate(st4,"REVISE",ob,at);
  let rvk1:i32=st4[404] as i32;
  let rvk2:i32=st4[405] as i32;
  let rvrp:i32=get32(st4,406);
  at=d_teach_test(st4,4,ob,at);
  at=d_m_dump(st4,"M-STATE-POST-REVISE",ob,at);
  set32(atp,0,at);
  let zrv:i32=d_z_run(st4,eidsT2,4,2,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-REVISE ");
  at=ob_i32(ob,at,zrv);
  at=ob_app(ob,at,"/4\n");
  at=d_adapt_stat(st4,"ADAPT-STAT-REVISE",ob,at);
  let specRV:i32=get32(st4,396);
  let mnRV:i32=st4[300] as i32;
  let mtRV:i32=get32(st4,304);
  let pRV0:i32=st4[308] as i32;
  let pRV1:i32=st4[309] as i32;
  let pRV2:i32=st4[310] as i32;

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KILL BARS ===\n");
  let k1:i32=0;
  if(m0k1==48){if(m0k2==12){if(rp0==4){k1=1;}}}
  at=ob_app(ob,at,"K-RV-1 masks-learned k1=");
  at=ob_i32(ob,at,m0k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,m0k2);
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,rp0);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k1);
  at=ob_nl(ob,at);
  let k2:i32=0;
  if(z1==4){
    if(mn1==1){
      if(mt1==6){
        if((st1[308] as i32)==1){
          if((st1[309] as i32)==0){
            if((st1[310] as i32)==1){k2=1;}
          }
        }
      }
    }
  }
  at=ob_app(ob,at,"K-RV-2 work-initially z1=");
  at=ob_i32(ob,at,z1);
  at=ob_app(ob,at," mn1=");
  at=ob_i32(ob,at,mn1);
  at=ob_app(ob,at," mt1=");
  at=ob_i32(ob,at,mt1);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k2);
  at=ob_nl(ob,at);
  let k3:i32=0;
  if(zsk==2){if(mnR==0){if(zsr==0){k3=1;}}}
  at=ob_app(ob,at,"K-RV-3 world-breaks zsk=");
  at=ob_i32(ob,at,zsk);
  at=ob_app(ob,at," mnR=");
  at=ob_i32(ob,at,mnR);
  at=ob_app(ob,at," zsr=");
  at=ob_i32(ob,at,zsr);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k3);
  at=ob_nl(ob,at);
  let k4:i32=0;
  if(rvk1==12){if(rvk2==48){if(rvrp==24){k4=1;}}}
  at=ob_app(ob,at,"K-RV-4 revised-masks k1=");
  at=ob_i32(ob,at,rvk1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,rvk2);
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,rvrp);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);
  let k5:i32=0;
  if(zrv==4){
    if(mnRV==1){
      if(mtRV==6){
        if(pRV0==1){
          if(pRV1==0){
            if(pRV2==1){k5=1;}
          }
        }
      }
    }
  }
  at=ob_app(ob,at,"K-RV-5 revised-work zrv=");
  at=ob_i32(ob,at,zrv);
  at=ob_app(ob,at," mnRV=");
  at=ob_i32(ob,at,mnRV);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k5);
  at=ob_nl(ob,at);
  let k6:i32=0;
  if(c1k1==48){if(c1k2==12){if(specRV>=1){k6=1;}}}
  at=ob_app(ob,at,"K-RV-6 provenance stable-k1=");
  at=ob_i32(ob,at,c1k1);
  at=ob_app(ob,at," stable-k2=");
  at=ob_i32(ob,at,c1k2);
  at=ob_app(ob,at," specRV=");
  at=ob_i32(ob,at,specRV);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-RV-7 determinism see-shell (3x sha256)\n");
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);

  at=ob_app(ob,at,"SHIFT-MASK-REVISION-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

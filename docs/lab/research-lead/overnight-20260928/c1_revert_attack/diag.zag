// diag.zag - independent diagnostic re-implementation of the contestant's
// procedure-inference class cascade, plus D1/D2/D3 revision diagnostics.
// Usage: diag <state.txt> <turns.jsonl> <scores.jsonl>
// For each proc query: checks detection (D1), diagnosis (D2), then predicts
// the answer from the sup=0 demo set and locates misses.
// State is a line buffer; lines use \x01 (byte 1) as field separator.
// Line kinds: F fact, R relation, H hypothesis weight, E causal episode,
// D proc demo, V vocab, M causal mask, B causal baseline, Q pending query.
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn i32s(v:i32)[]u8 { return i64s(v as i64); }
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn app1(buf:[]u8,at:i32,c:u8)i32 { buf[at]=c; return at+1; }
fn st32(b:[]u8,at:i32,v:i32)void {
  b[at]=(v as u8); b[at+1]=((v>>8) as u8); b[at+2]=((v>>16) as u8); b[at+3]=((v>>24) as u8);
  return;
}
fn ld32(b:[]u8,at:i32)i32 {
  return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=4194304;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn jval(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
fn jint(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+3);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return -999999;}
  let s:i32=p+at;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;}
  if(neg==1){v=-v;}
  return v;
}
fn getfld(line:[]u8,idx:i32)[]u8 {
  let n:i32=0;
  let s:i32=0;
  let i:i32=0;
  while(i<=line.len){
    if(i==line.len || line[i]==1){
      if(n==idx){return line[s..i];}
      n=n+1;
      s=i+1;
    }
    i=i+1;
  }
  return "";
}
// find first line whose first two fields are tag,f1 (f1="" matches tag only)
fn rev_str(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[s.len-1-i];i=i+1;}
  return b;
}
fn rot_str(s:[]u8,k:i32)[]u8 {
  if(s.len==0){return "";}
  let kk:i32=k%s.len;
  if(kk<0){kk=kk+s.len;}
  let b:[]u8=z_alloc(s.len);
  let i:i32=0;
  while(i<s.len){b[i]=s[(i+kk)%s.len];i=i+1;}
  return b;
}
fn atoi(s:[]u8)i32 {
  let i:i32=0;
  let neg:i32=0;
  if(s.len>0 && s[0]==45){neg=1;i=1;}
  let v:i32=0;
  while(i<s.len && s[i]>=48 && s[i]<=57){v=v*10+(s[i] as i32)-48;i=i+1;}
  if(neg==1){v=-v;}
  return v;
}
// ---- diagnostic cascade + D1/D2/D3 (fresh implementation) ----
// int arrays are []u8 buffers accessed with ld32/st32 at idx*4.
fn count_lines(b:[]u8)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<b.len){if(b[i]==10){n=n+1;}i=i+1;}
  if(b.len>0 && b[b.len-1]!=10){n=n+1;}
  return n;
}
fn get_line(b:[]u8,li:i32)[]u8 {
  let n:i32=0;
  let s:i32=0;
  let i:i32=0;
  while(i<=b.len){
    if(i==b.len || b[i]==10){
      if(n==li){return b[s..i];}
      n=n+1;
      s=i+1;
    }
    i=i+1;
  }
  return "";
}
fn ia_get(a:[]u8,i:i32)i32 { return ld32(a,i*4); }
fn ia_set(a:[]u8,i:i32,v:i32)void { st32(a,i*4,v); return; }
// cascade predicts the answer from the live demo set; writes class name into clsb
fn cascade(st:[]u8,doff:[]u8,dlen:[]u8,ooff:[]u8,olen:[]u8,nd:i32,tin:[]u8,clsb:[]u8)[]u8 {
  if(nd==0){app(clsb,0,"none");return "UNKNOWN";}
  // class 1: char map
  let map:[]u8=z_alloc(256);
  let mset:[]u8=z_alloc(256);
  let i:i32=0;
  while(i<256){mset[i]=0;i=i+1;}
  let mok:i32=1;
  i=0;
  while(i<nd){
    let din:[]u8=st[ia_get(doff,i)..ia_get(doff,i)+ia_get(dlen,i)];
    let dout:[]u8=st[ia_get(ooff,i)..ia_get(ooff,i)+ia_get(olen,i)];
    if(din.len!=dout.len){mok=0;}
    if(mok==1){
      let k:i32=0;
      while(k<din.len){
        let c:i32=din[k] as i32;
        if(mset[c]==0){mset[c]=1;map[c]=dout[k];}
        else {if(map[c]!=dout[k]){mok=0;}}
        k=k+1;
      }
    }
    i=i+1;
  }
  if(mok==1){
    let ok:i32=1;
    i=0;
    while(i<tin.len){if(mset[tin[i] as i32]==0){ok=0;}i=i+1;}
    if(ok==1){
      let b:[]u8=z_alloc(tin.len);
      i=0;
      while(i<tin.len){b[i]=map[tin[i] as i32];i=i+1;}
      app(clsb,0,"map");
      return b;
    }
  }
  // class 2: reversal
  let rok:i32=1;
  i=0;
  while(i<nd){
    let din2:[]u8=st[ia_get(doff,i)..ia_get(doff,i)+ia_get(dlen,i)];
    let dout2:[]u8=st[ia_get(ooff,i)..ia_get(ooff,i)+ia_get(olen,i)];
    let rv:[]u8=rev_str(din2);
    if(streq(rv,dout2)==0){rok=0;}
    i=i+1;
  }
  if(rok==1){app(clsb,0,"rev");return rev_str(tin);}
  // class 3: duplication
  let dok:i32=1;
  i=0;
  while(i<nd){
    let din3:[]u8=st[ia_get(doff,i)..ia_get(doff,i)+ia_get(dlen,i)];
    let dout3:[]u8=st[ia_get(ooff,i)..ia_get(ooff,i)+ia_get(olen,i)];
    if(dout3.len!=din3.len*2){dok=0;}
    if(dok==1){
      if(streq(dout3[0..din3.len],din3)==0){dok=0;}
      if(streq(dout3[din3.len..dout3.len],din3)==0){dok=0;}
    }
    i=i+1;
  }
  if(dok==1){
    let b2:[]u8=z_alloc(tin.len*2);
    app(b2,0,tin);
    app(b2,tin.len,tin);
    app(clsb,0,"dup");
    return b2;
  }
  // class 4: rotation by consistent k (largest matching k per demo)
  let rk:i32=-2;
  let gok:i32=1;
  i=0;
  while(i<nd){
    let din4:[]u8=st[ia_get(doff,i)..ia_get(doff,i)+ia_get(dlen,i)];
    let dout4:[]u8=st[ia_get(ooff,i)..ia_get(ooff,i)+ia_get(olen,i)];
    let found:i32=-1;
    if(din4.len==dout4.len && din4.len>0){
      let k:i32=0;
      while(k<din4.len){
        let rs:[]u8=rot_str(din4,k);
        if(streq(rs,dout4)==1){found=k;}
        k=k+1;
      }
    }
    if(found<0){gok=0;}
    if(gok==1){
      if(rk==-2){rk=found;}
      else {if(rk!=found){gok=0;}}
    }
    i=i+1;
  }
  if(gok==1 && rk>=-1){
    let kk:i32=rk;
    if(kk<0){kk=0;}
    app(clsb,0,"rot");
    return rot_str(tin,kk);
  }
  // fallback: nearest demo by common prefix, copy its output
  let best:i32=0;
  let bestcp:i32=-1;
  i=0;
  while(i<nd){
    let din5:[]u8=st[ia_get(doff,i)..ia_get(doff,i)+ia_get(dlen,i)];
    let cp:i32=0;
    while(cp<din5.len && cp<tin.len && din5[cp]==tin[cp]){cp=cp+1;}
    if(cp>bestcp){bestcp=cp;best=i;}
    i=i+1;
  }
  let bd:[]u8=st[ia_get(ooff,best)..ia_get(ooff,best)+ia_get(olen,best)];
  let b3:[]u8=z_alloc(bd.len);
  app(b3,0,bd);
  app(clsb,0,"fallback");
  return b3;
}
fn proc_idx(p:[]u8)i32 {
  if(streq(p,"pa")==1){return 0;}
  if(streq(p,"pb")==1){return 1;}
  return -1;
}
// main: replay the turn file in order, maintaining the exact revision
// state (sup flags) the contestant's ingest_law/ingest_demo specify.
// At each query turn, predict from the live demo set at THAT turn.
// After the sweep, verify the replayed final sup flags against the
// contestant's recorded state.txt (STATE-MATCH). Per-query D1/D2 come
// from the replayed revision trace; the final state alone cannot
// time-slice sup flags, so the replay (validated by STATE-MATCH) is the
// rigorous basis.
fn cstrlen(b:[]u8)i32 {
  let i:i32=0;
  while(i<b.len && b[i]!=0){i=i+1;}
  return i;
}
// proc table: up to 8 distinct proc strings (8 bytes each). Returns index or -1.
fn pfind(ptab:[]u8,plen:[]u8,nproc:i32,p:[]u8)i32 {
  let i:i32=0;
  while(i<nproc){
    let e:[]u8=ptab[i*8..i*8+ia_get(plen,i)];
    if(streq(e,p)==1){return i;}
    i=i+1;
  }
  return -1;
}
// main: replay the turn file in order, maintaining the exact revision
// state (sup flags) the contestant's ingest_law/ingest_demo specify.
// At each query turn, predict from the live demo set at THAT turn.
// After the sweep, verify the replayed final sup flags against the
// contestant's recorded state.txt (STATE-MATCH). Per-query D1/D2 come
// from the replayed revision trace; the final state alone cannot
// time-slice sup flags, so the replay (validated by STATE-MATCH) is the
// rigorous basis.
fn main()i32 {
  let sp:[]u8=_zag_arg(1);
  let tp:[]u8=_zag_arg(2);
  let cp:[]u8=_zag_arg(3);
  if(sp.len==0 || tp.len==0 || cp.len==0){return 1;}
  let stb:[]u8=read_file(sp);
  let tnb:[]u8=read_file(tp);
  let scb:[]u8=read_file(cp);
  // proc table
  let ptab:[]u8=z_alloc(64);
  let plen:[]u8=z_alloc(32);
  let lawt:[]u8=z_alloc(32);
  let lawt1:[]u8=z_alloc(32);
  let nproc:i32=0;
  // demo store (replay)
  let dproc:[]u8=z_alloc(512);
  let dioff:[]u8=z_alloc(512);
  let dilen:[]u8=z_alloc(512);
  let dooff:[]u8=z_alloc(512);
  let dolen:[]u8=z_alloc(512);
  let dturn:[]u8=z_alloc(512);
  let dsup:[]u8=z_alloc(512);
  let nd:i32=0;
  // query store (up to 128)
  let qoff:[]u8=z_alloc(512);
  let qlen:[]u8=z_alloc(512);
  let qproc:[]u8=z_alloc(512);
  let qturn:[]u8=z_alloc(512);
  let qpred:[]u8=z_alloc(2048);
  let qplen:[]u8=z_alloc(512);
  let qcls:[]u8=z_alloc(1024);
  let qclen:[]u8=z_alloc(512);
  let qdet:[]u8=z_alloc(512);
  let qdg:[]u8=z_alloc(512);
  let qlive:[]u8=z_alloc(512);
  let nq:i32=0;
  let n:i32=count_lines(tnb);
  let li:i32=0;
  while(li<n){
    let line:[]u8=get_line(tnb,li);
    let kind:[]u8=jval(line,"kind");
    let turn:i32=jint(line,"turn");
    if(streq(kind,"obs")==1){
      let t:[]u8=jval(line,"t");
      if(streq(t,"demo")==1){
        let pr:[]u8=jval(line,"p");
        let pi:i32=pfind(ptab,plen,nproc,pr);
        if(pi<0 && nproc<8 && pr.len<=8){
          let c:i32=0;
          while(c<pr.len){ptab[nproc*8+c]=pr[c];c=c+1;}
          ia_set(plen,nproc,pr.len);
          ia_set(lawt,nproc,-1); ia_set(lawt1,nproc,-1);
          pi=nproc;
          nproc=nproc+1;
        }
        let fi:[]u8=jval(line,"in");
        let fo:[]u8=jval(line,"out");
        if(pi>=0 && nd<128){
          ia_set(dproc,nd,pi);
          ia_set(dioff,nd,(_zag_slice_ptr(fi) as i64 - _zag_slice_ptr(tnb) as i64) as i32);
          ia_set(dilen,nd,fi.len);
          ia_set(dooff,nd,(_zag_slice_ptr(fo) as i64 - _zag_slice_ptr(tnb) as i64) as i32);
          ia_set(dolen,nd,fo.len);
          ia_set(dturn,nd,turn);
          ia_set(dsup,nd,0);
          nd=nd+1;
        }
      }
      if(streq(t,"law")==1){
        let pr2:[]u8=jval(line,"p");
        let pi2:i32=pfind(ptab,plen,nproc,pr2);
        if(pi2<0 && nproc<8 && pr2.len<=8){
          let c2:i32=0;
          while(c2<pr2.len){ptab[nproc*8+c2]=pr2[c2];c2=c2+1;}
          ia_set(plen,nproc,pr2.len);
          ia_set(lawt,nproc,-1); ia_set(lawt1,nproc,-1);
          pi2=nproc;
          nproc=nproc+1;
        }
        if(pi2>=0){
          if(ia_get(lawt1,pi2)<0){ia_set(lawt1,pi2,turn);}
          ia_set(lawt,pi2,turn);
          let dj:i32=0;
          while(dj<nd){
            if(ia_get(dproc,dj)==pi2){ia_set(dsup,dj,1);}
            dj=dj+1;
          }
        }
      }
    }
    if(streq(kind,"query")==1){
      let qid:[]u8=jval(line,"qid");
      let qp:i32=findsub(line,0,"\"q\":{");
      let pr3:[]u8="";
      let inn:[]u8="";
      let isproc:i32=0;
      if(qp>=0){
        let qs:[]u8=line[qp..line.len];
        if(streq(jval(qs,"t"),"proc")==1){
          isproc=1;
          pr3=jval(qs,"p");
          inn=jval(qs,"in");
        }
      }
      if(isproc==1 && qid.len>0 && nq<128){
        let pi3:i32=pfind(ptab,plen,nproc,pr3);
        if(pi3<0 && nproc<8 && pr3.len<=8){
          let c3:i32=0;
          while(c3<pr3.len){ptab[nproc*8+c3]=pr3[c3];c3=c3+1;}
          ia_set(plen,nproc,pr3.len);
          ia_set(lawt,nproc,-1); ia_set(lawt1,nproc,-1);
          pi3=nproc;
          nproc=nproc+1;
        }
        if(pi3>=0){
          let lt:i32=ia_get(lawt,pi3);
          let loff:[]u8=z_alloc(512);
          let llen:[]u8=z_alloc(512);
          let goff:[]u8=z_alloc(512);
          let glen:[]u8=z_alloc(512);
          let nl2:i32=0;
          let det:i32=0;
          let dg:i32=0;
          let dk:i32=0;
          while(dk<nd){
            if(ia_get(dproc,dk)==pi3){
              if(ia_get(dsup,dk)==0){
                ia_set(loff,nl2,ia_get(dioff,dk));
                ia_set(llen,nl2,ia_get(dilen,dk));
                ia_set(goff,nl2,ia_get(dooff,dk));
                ia_set(glen,nl2,ia_get(dolen,dk));
                nl2=nl2+1;
              }
              if(lt>=0){
                if(ia_get(dturn,dk)<lt && ia_get(dsup,dk)==0){det=1;}
                if(ia_get(dturn,dk)>lt && ia_get(dsup,dk)==1){dg=1;}
              }
            }
            dk=dk+1;
          }
          let clsb:[]u8=z_alloc(16);
          let pred:[]u8=cascade(tnb,loff,llen,goff,glen,nl2,inn,clsb);
          let cl:[]u8=clsb[0..cstrlen(clsb)];
          ia_set(qoff,nq,(_zag_slice_ptr(qid) as i64 - _zag_slice_ptr(tnb) as i64) as i32);
          ia_set(qlen,nq,qid.len);
          ia_set(qproc,nq,pi3);
          ia_set(qturn,nq,turn);
          ia_set(qdet,nq,det);
          ia_set(qdg,nq,dg);
          ia_set(qlive,nq,nl2);
          let pr4:i32=0;
          while(pr4<pred.len && pr4<16){
            qpred[nq*16+pr4]=pred[pr4];
            pr4=pr4+1;
          }
          ia_set(qplen,nq,pred.len);
          let cr:i32=0;
          while(cr<cl.len && cr<8){
            qcls[nq*8+cr]=cl[cr];
            cr=cr+1;
          }
          ia_set(qclen,nq,cl.len);
          nq=nq+1;
        }
      }
    }
    li=li+1;
  }
  // P4: demos superseded at the first law notice stay sup=1 (never restored)
  let p4ok:i32=1;
  let p4n:i32=0;
  let dp:i32=0;
  while(dp<nd){
    let pi5:i32=ia_get(dproc,dp);
    let fl:i32=ia_get(lawt1,pi5);
    if(fl>=0 && ia_get(dturn,dp)<fl){
      p4n=p4n+1;
      if(ia_get(dsup,dp)!=1){p4ok=0;}
    }
    dp=dp+1;
  }
  // STATE-MATCH: replayed final sup flags vs recorded state.txt D lines
  let sm_ok:i32=1;
  let sm_checked:i32=0;
  let m:i32=count_lines(stb);
  let lj:i32=0;
  while(lj<m){
    let ln:[]u8=get_line(stb,lj);
    if(streq(getfld(ln,0),"D")==1){
      let pi4:i32=pfind(ptab,plen,nproc,getfld(ln,1));
      if(pi4>=0){
        let fi2:[]u8=getfld(ln,2);
        let fo2:[]u8=getfld(ln,3);
        let ft:i32=atoi(getfld(ln,4));
        let fs2:i32=1;
        if(streq(getfld(ln,5),"0")==1){fs2=0;}
        let found:i32=0;
        let dk2:i32=0;
        while(dk2<nd){
          if(ia_get(dproc,dk2)==pi4 && ia_get(dturn,dk2)==ft){
            let ri:[]u8=tnb[ia_get(dioff,dk2)..ia_get(dioff,dk2)+ia_get(dilen,dk2)];
            let ro:[]u8=tnb[ia_get(dooff,dk2)..ia_get(dooff,dk2)+ia_get(dolen,dk2)];
            if(streq(ri,fi2)==1 && streq(ro,fo2)==1){
              found=1;
              sm_checked=sm_checked+1;
              if(ia_get(dsup,dk2)!=fs2){sm_ok=0;}
            }
          }
          dk2=dk2+1;
        }
        if(found==0){sm_ok=0;}
      } else {sm_ok=0;}
    }
    lj=lj+1;
  }
  // scores
  let soff:[]u8=z_alloc(512);
  let slen:[]u8=z_alloc(512);
  let aoff:[]u8=z_alloc(512);
  let alen:[]u8=z_alloc(512);
  let corr:[]u8=z_alloc(512);
  let ns:i32=0;
  let kn:i32=count_lines(scb);
  let lk:i32=0;
  while(lk<kn){
    let sl:[]u8=get_line(scb,lk);
    let qid2:[]u8=jval(sl,"qid");
    let an:[]u8=jval(sl,"answer");
    if(qid2.len>0 && ns<128){
      ia_set(soff,ns,(_zag_slice_ptr(qid2) as i64 - _zag_slice_ptr(scb) as i64) as i32);
      ia_set(slen,ns,qid2.len);
      ia_set(aoff,ns,(_zag_slice_ptr(an) as i64 - _zag_slice_ptr(scb) as i64) as i32);
      ia_set(alen,ns,an.len);
      ia_set(corr,ns,jint(sl,"correct"));
      ns=ns+1;
    }
    lk=lk+1;
  }
  // per-query report (proc queries only)
  let nagree:i32=0;
  let ndet:i32=0;
  let ndiag:i32=0;
  let napp_miss:i32=0;
  let nuncl:i32=0;
  let nsmbad:i32=0;
  let qi:i32=0;
  while(qi<nq){
    let qid:[]u8=tnb[ia_get(qoff,qi)..ia_get(qoff,qi)+ia_get(qlen,qi)];
    let pred:[]u8=qpred[qi*16..qi*16+ia_get(qplen,qi)];
    let cl:[]u8=qcls[qi*8..qi*8+ia_get(qclen,qi)];
    let prnm:[]u8=ptab[ia_get(qproc,qi)*8..ia_get(qproc,qi)*8+ia_get(plen,ia_get(qproc,qi))];
    let actual:[]u8="";
    let co:i32=-1;
    let sj:i32=0;
    while(sj<ns){
      let sq:[]u8=scb[ia_get(soff,sj)..ia_get(soff,sj)+ia_get(slen,sj)];
      if(streq(sq,qid)==1){
        actual=scb[ia_get(aoff,sj)..ia_get(aoff,sj)+ia_get(alen,sj)];
        co=ia_get(corr,sj);
      }
      sj=sj+1;
    }
    let loc:[]u8="";
    if(sm_ok==0){loc="STATE-MISMATCH";nsmbad=nsmbad+1;}
    else {
      if(ia_get(qdet,qi)==1){loc="DETECTION";ndet=ndet+1;}
      else {
        if(ia_get(qdg,qi)==1){loc="DIAGNOSIS";ndiag=ndiag+1;}
        else {
          if(streq(pred,actual)==0){loc="UNCLASSIFIED";nuncl=nuncl+1;}
          else {
            nagree=nagree+1;
            if(co==1){loc="HIT-OK";}
            else {loc="APPLICATION";napp_miss=napp_miss+1;}
          }
        }
      }
    }
    let ob:[]u8=z_alloc(256);
    let at:i32=0;
    at=app(ob,at,qid);
    at=app(ob,at," proc=");
    at=app(ob,at,prnm);
    at=app(ob,at," live=");
    at=app(ob,at,i32s(ia_get(qlive,qi)));
    if(ia_get(qdet,qi)==1){at=app(ob,at," det=FAIL");} else {at=app(ob,at," det=OK");}
    if(ia_get(qdg,qi)==1){at=app(ob,at," diag=FAIL");} else {at=app(ob,at," diag=OK");}
    at=app(ob,at," pred=");
    at=app(ob,at,pred);
    at=app(ob,at," actual=");
    at=app(ob,at,actual);
    at=app(ob,at," class=");
    at=app(ob,at,cl);
    at=app(ob,at," loc=");
    at=app(ob,at,loc);
    at=app(ob,at,"\n");
    emit(ob[0..at]);
    qi=qi+1;
  }
  let sb:[]u8=z_alloc(192);
  let sat:i32=0;
  sat=app(sb,sat,"SUMMARY agree=");
  sat=app(sb,sat,i32s(nagree));
  sat=app(sb,sat,"/");
  sat=app(sb,sat,i32s(nq));
  sat=app(sb,sat," det_fail=");
  sat=app(sb,sat,i32s(ndet));
  sat=app(sb,sat," diag_fail=");
  sat=app(sb,sat,i32s(ndiag));
  sat=app(sb,sat," app_miss=");
  sat=app(sb,sat,i32s(napp_miss));
  sat=app(sb,sat," unclassified=");
  sat=app(sb,sat,i32s(nuncl));
  sat=app(sb,sat," state_match=");
  if(sm_ok==1){sat=app(sb,sat,"YES");} else {sat=app(sb,sat,"NO");}
  sat=app(sb,sat," checked=");
  sat=app(sb,sat,i32s(sm_checked));
  sat=app(sb,sat," p4=");
  if(p4ok==1){sat=app(sb,sat,"OK");} else {sat=app(sb,sat,"FAIL");}
  sat=app(sb,sat,"/");
  sat=app(sb,sat,i32s(p4n));
  sat=app(sb,sat,"\n");
  emit(sb[0..sat]);
  return 0;
}

// hyp_c.zag -- Hypothesis C: Counterexample-Driven Structural Growth.
// Pure Zag. No Python anywhere.
//
// Implements the C discovery mechanism from the architecture review:
// - State: program P (initially empty) plus counterexample set.
// - Loop: evaluate P; if all pass, done. Else take first failing e,
//   try repair (single op append in deterministic order, first that
//   fixes e without breaking passing). If no repair, split on probe
//   from frozen family, recurse on partitions.
// - No population, no ranking. Traces log REPAIR and SPLIT events.
//
// Battery: T0-T5 frozen episodes. T6 sealed (skipped).

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn nl()void { emit("\n"); return; }

// ============ program representation ============
// Program is []u8: bytes 0..3 = len (i32), then len*8 bytes of (op:i32, arg:i32).
fn prog_len(p:[]u8)i32 { return get32(p, 0); }
fn prog_set_len(p:[]u8, l:i32)void { set32(p, 0, l); return; }
fn prog_op(p:[]u8, i:i32)i32 { return get32(p, 4+i*8); }
fn prog_arg(p:[]u8, i:i32)i32 { return get32(p, 4+i*8+4); }
fn prog_set(p:[]u8, i:i32, op:i32, arg:i32)void {
  set32(p, 4+i*8, op); set32(p, 4+i*8+4, arg); return;
}
fn prog_new(maxlen:i32)[]u8 {
  let p:[]u8=z_alloc(4+maxlen*8);
  set32(p, 0, 0);
  return p;
}
fn prog_copy(dst:[]u8, src:[]u8)void {
  let l:i32=prog_len(src);
  prog_set_len(dst, l);
  let i:i32=0;
  while(i<l){ prog_set(dst, i, prog_op(src,i), prog_arg(src,i)); i=i+1; }
  return;
}
fn prog_append(p:[]u8, op:i32, arg:i32)void {
  let l:i32=prog_len(p);
  prog_set(p, l, op, arg);
  prog_set_len(p, l+1);
  return;
}

// ============ VM (from GENEXEC2 8d5f58b89, frozen) ============
fn mod_nonneg(a:i32, b:i32)i32 {
  let r:i32=a - (a/b)*b;
  if(r<0){ r=r+b; }
  return r;
}
fn vm_run(p:[]u8, pl:i32, in0:i32, in1:i32, stack:[]u8)i32 {
  let sp:i32=0;
  let pc:i32=0;
  let steps:i32=0;
  while(steps<10000){
    if(pc<0 || pc>=pl){ break; }
    let op:i32=prog_op(p, pc);
    let arg:i32=prog_arg(p, pc);
    pc=pc+1; steps=steps+1;
    if(op==0){ // PUSH
      if(sp<256){ set32(stack, sp*4, arg); sp=sp+1; }
    } else if(op==1){ // IN0
      if(sp<256){ set32(stack, sp*4, in0); sp=sp+1; }
    } else if(op==2){ // IN1
      if(sp<256){ set32(stack, sp*4, in1); sp=sp+1; }
    } else if(op==3){ // ADD
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a+b); sp=sp+1; }
    } else if(op==4){ // SUB
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a-b); sp=sp+1; }
    } else if(op==5){ // MUL
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; set32(stack,sp*4,a*b); sp=sp+1; }
    } else if(op==6){ // DIV
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=a/b;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==7){ // MOD
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(b!=0){r=mod_nonneg(a,b);} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==8){ // NEG
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); set32(stack,(sp-1)*4,-a); }
    } else if(op==9){ // DUP
      if(sp>=1 && sp<256){ let a:i32=get32(stack,(sp-1)*4); set32(stack,sp*4,a); sp=sp+1; }
    } else if(op==10){ // DROP
      if(sp>=1){ sp=sp-1; }
    } else if(op==11){ // SWAP
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); set32(stack,(sp-2)*4,b); set32(stack,(sp-1)*4,a); }
    } else if(op==12){ // OVER
      if(sp>=2 && sp<256){ let a:i32=get32(stack,(sp-2)*4); set32(stack,sp*4,a); sp=sp+1; }
    } else if(op==13){ // LT
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(a<b){r=1;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==14){ // EQ
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(a==b){r=1;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==15){ // GT
      if(sp>=2){ let b:i32=get32(stack,(sp-1)*4); let a:i32=get32(stack,(sp-2)*4); sp=sp-2; let r:i32=0; if(a>b){r=1;} set32(stack,sp*4,r); sp=sp+1; }
    } else if(op==16){ // JZ
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); sp=sp-1; if(a==0){pc=arg;} }
    } else if(op==17){ // JNZ
      if(sp>=1){ let a:i32=get32(stack,(sp-1)*4); sp=sp-1; if(a!=0){pc=arg;} }
    } else if(op==18){ // JMP
      pc=arg;
    }
    // Note: CALL/RET (19,20) not used by C (zero CALLs predicted).
  }
  if(sp>0){ return get32(stack, (sp-1)*4); }
  return 0;
}

// ============ task episodes ============
// Episode storage: three parallel []u8 arrays of i32 (ein0, ein1, etgt).
// Task IDs: 0=T0 2x+1, 1=T1 abs, 2=T2 mod3, 3=T3 parity, 4=T4 nested abs, 5=T5 fragcomp.

fn task_n_eps(task:i32)i32 {
  if(task==0){ return 9; }   // T0: x 0..8
  if(task==1){ return 17; }  // T1: x -8..8
  if(task==2){ return 17; }  // T2: x 0..16
  if(task==3){ return 25; }  // T3: a,b 0..4
  if(task==4){ return 13; }  // T4: x -6..6
  if(task==5){ return 13; }  // T5: x -4..8
  return 0;
}
fn task_in0(task:i32, i:i32)i32 {
  if(task==0){ return i; }                    // T0: x 0..8
  if(task==1){ return i-8; }                  // T1: x -8..8
  if(task==2){ return i; }                    // T2: x 0..16
  if(task==3){ return i/5; }                  // T3: a
  if(task==4){ return i-6; }                   // T4: x -6..6
  if(task==5){ return i-4; }                   // T5: x -4..8
  return 0;
}
fn task_in1(task:i32, i:i32)i32 {
  if(task==3){ let a:i32=i/5; return i-(a*5); } // T3: b
  return 0;
}
fn task_tgt(task:i32, i:i32)i32 {
  if(task==0){ let x:i32=i; return 2*x+1; }
  if(task==1){ let x:i32=i-8; if(x<0){return -x;} return x; }
  if(task==2){ let x:i32=i; return mod_nonneg(x,3); }
  if(task==3){ let a:i32=i/5; let b:i32=i-(a*5); if(mod_nonneg(a+b,2)==0){return 1;} return 0; }
  if(task==4){ let x:i32=i-6; let ax:i32=x; if(ax<0){ax=-ax;} let d:i32=ax-2; if(d<0){d=-d;} return d; }
  if(task==5){ let x:i32=i-4; let ax:i32=x; if(ax<0){ax=-ax;} let bx:i32=x-2; if(bx<0){bx=-bx;} return ax+bx; }
  return 0;
}

// ============ discovery state ============
// State is passed via pointers (Zag has no mutable globals).
// Counters: evals (*i64), repairs (*i32), splits (*i32).

// Emit trace events directly.
fn trace_repair(task:i32, ep_idx:i32, op:i32, arg:i32, npass:i32)void {
  emit("REPAIR t="); e64(task);
  emit(" ep="); e64(ep_idx);
  emit(" op="); e64(op);
  emit(" arg="); e64(arg);
  emit(" npass="); e64(npass);
  nl();
  return;
}
fn trace_split(task:i32, pin:i32, pk:i32, pcmp:i32, nleft:i32, nright:i32)void {
  emit("SPLIT t="); e64(task);
  emit(" probe=[IN"); e64(pin);
  emit(" PUSH "); e64(pk);
  emit(" ");
  if(pcmp==13){ emit("LT"); } else if(pcmp==14){ emit("EQ"); } else { emit("GT"); }
  emit("] nleft="); e64(nleft);
  emit(" nright="); e64(nright);
  nl();
  return;
}
fn trace_fail(task:i32, reason:[]u8)void {
  emit("FAIL t="); e64(task);
  emit(" reason="); emit(reason); nl();
  return;
}

// Evaluate program p on episode (in0,in1). Returns output.
// Increments eval counter at cnt+0 (i64).
fn eval_one(p:[]u8, in0:i32, in1:i32, cnt:[]u8) i32 {
  let stack:[]u8=z_alloc(256*4);
  let r:i32=vm_run(p, prog_len(p), in0, in1, stack);
  let e:i64=get32(cnt,0) as i64 | ((get32(cnt,4) as i64)<<32);
  e=e+1;
  set32(cnt, 0, e as i32); set32(cnt, 4, (e>>32) as i32);
  return r;
}
fn cnt_repairs(cnt:[]u8)i32 { return get32(cnt, 8); }
fn cnt_splits(cnt:[]u8)i32 { return get32(cnt, 12); }
fn cnt_incr_repairs(cnt:[]u8)void { set32(cnt, 8, get32(cnt,8)+1); return; }
fn cnt_incr_splits(cnt:[]u8)void { set32(cnt, 12, get32(cnt,12)+1); return; }
fn cnt_evals(cnt:[]u8)i64 {
  return get32(cnt,0) as i64 | ((get32(cnt,4) as i64)<<32);
}

// ============ probe evaluation ============
// Probe: (pin, pk, pcmp) where pin=0 for IN0, 1 for IN1; pcmp=13 LT,14 EQ,15 GT.
// Returns 1 if probe true, 0 otherwise.
fn probe_eval(pin:i32, pk:i32, pcmp:i32, in0:i32, in1:i32)i32 {
  let v:i32=in0;
  if(pin==1){ v=in1; }
  if(pcmp==13){ if(v<pk){return 1;} return 0; }
  if(pcmp==14){ if(v==pk){return 1;} return 0; }
  // GT
  if(v>pk){return 1;} return 0;
}

// ============ the grow function ============
// Grows a program for the episode subset given by indices in idx[0..n).
// Returns program in out_prog. Returns 1 on success, 0 on failure.
// This is recursive for splits.

fn grow(task:i32, idx:[]u8, n:i32, out_prog:[]u8, depth:i32, cnt:[]u8)i32 {
  // idx is []u8 holding i32 episode indices.
  // Build straight-line prefix.
  let prefix:[]u8=prog_new(200);
  // For split compilation, we need to track the structure.
  // Simplification: grow() returns a complete program for the subset.
  // If split occurs, we recursively grow branches and compile If.
  
  let iter:i32=0;
  while(iter<500){
    iter=iter+1;
    // Evaluate prefix on all episodes in subset. Find failing/passing.
    // Store failing indices and passing indices in temp arrays.
    let nfail:i32=0;
    let npass:i32=0;
    // Use fixed-size temp arrays on stack (max 25 episodes for T3).
    let fail_idx:[]u8=z_alloc(25*4);
    let pass_idx:[]u8=z_alloc(25*4);
    let i:i32=0;
    while(i<n){
      let ei:i32=get32(idx, i*4);
      let in0:i32=task_in0(task, ei); let in1:i32=task_in1(task, ei); let tgt:i32=task_tgt(task, ei);
      let out:i32=eval_one(prefix, in0, in1, cnt);
      if(out==tgt){
        set32(pass_idx, npass*4, ei); npass=npass+1;
      } else {
        set32(fail_idx, nfail*4, ei); nfail=nfail+1;
      }
      i=i+1;
    }
    if(nfail==0){
      // SOLVE! Copy prefix to out_prog.
      prog_copy(out_prog, prefix);
      return 1;
    }
    // Take first failing episode.
    let fe:i32=get32(fail_idx, 0);
    let fin0:i32=task_in0(task, fe); let fin1:i32=task_in1(task, fe); let ftgt:i32=task_tgt(task, fe);
    
    // Try repair: deterministic op order.
    // Order: IN0, IN1, PUSH -9..9, ADD, SUB, MUL, DIV, MOD, NEG, DUP, DROP, SWAP, OVER, LT, EQ, GT.
    let repaired:i32=0;
    // Build candidate list in order. We'll iterate manually.
    // Phase 1: IN0 (1,0), IN1 (2,0)
    // Phase 2: PUSH (0,k) for k=-9..9
    // Phase 3: ADD(3)..GT(15)
    let cand:[]u8=prog_new(200);
    // Helper: try a single (op,arg). Returns 1 if it works.
    // We'll inline the loop for clarity.
    
    // Try IN0
    prog_copy(cand, prefix); prog_append(cand, 1, 0);
    if(eval_one(cand, fin0, fin1, cnt)==ftgt){
      // Check no passing broken.
      let ok:i32=1;
      let j:i32=0;
      while(j<npass){
        let pi:i32=get32(pass_idx, j*4);
        let pin0:i32=task_in0(task, pi); let pin1:i32=task_in1(task, pi); let ptgt:i32=task_tgt(task, pi);
        if(eval_one(cand, pin0, pin1, cnt)!=ptgt){ ok=0; break; }
        j=j+1;
      }
      if(ok==1){
        prog_append(prefix, 1, 0);
        cnt_incr_repairs(cnt);
        trace_repair(task, fe, 1, 0, npass);
        repaired=1;
      }
    }
    if(repaired==0){
      // Try IN1
      prog_copy(cand, prefix); prog_append(cand, 2, 0);
      if(eval_one(cand, fin0, fin1, cnt)==ftgt){
        let ok:i32=1;
        let j:i32=0;
        while(j<npass){
          let pi:i32=get32(pass_idx, j*4);
          let pin0:i32=task_in0(task, pi); let pin1:i32=task_in1(task, pi); let ptgt:i32=task_tgt(task, pi);
          if(eval_one(cand, pin0, pin1, cnt)!=ptgt){ ok=0; break; }
          j=j+1;
        }
        if(ok==1){
          prog_append(prefix, 2, 0);
          cnt_incr_repairs(cnt);
          trace_repair(task, fe, 2, 0, npass);
          repaired=1;
        }
      }
    }
    // Try PUSH k for k=-9..9
    if(repaired==0){
      let k:i32=-9;
      while(k<=9){
        prog_copy(cand, prefix); prog_append(cand, 0, k);
        if(eval_one(cand, fin0, fin1, cnt)==ftgt){
          let ok:i32=1;
          let j:i32=0;
          while(j<npass){
            let pi:i32=get32(pass_idx, j*4);
            let pin0:i32=task_in0(task, pi); let pin1:i32=task_in1(task, pi); let ptgt:i32=task_tgt(task, pi);
            if(eval_one(cand, pin0, pin1, cnt)!=ptgt){ ok=0; break; }
            j=j+1;
          }
          if(ok==1){
            prog_append(prefix, 0, k);
            cnt_incr_repairs(cnt);
            trace_repair(task, fe, 0, k, npass);
            repaired=1;
            break;
          }
        }
        k=k+1;
      }
    }
    // Try ADD..GT (ops 3..15)
    if(repaired==0){
      let op:i32=3;
      while(op<=15){
        prog_copy(cand, prefix); prog_append(cand, op, 0);
        if(eval_one(cand, fin0, fin1, cnt)==ftgt){
          let ok:i32=1;
          let j:i32=0;
          while(j<npass){
            let pi:i32=get32(pass_idx, j*4);
            let pin0:i32=task_in0(task, pi); let pin1:i32=task_in1(task, pi); let ptgt:i32=task_tgt(task, pi);
            if(eval_one(cand, pin0, pin1, cnt)!=ptgt){ ok=0; break; }
            j=j+1;
          }
          if(ok==1){
            prog_append(prefix, op, 0);
            cnt_incr_repairs(cnt);
            trace_repair(task, fe, op, 0, npass);
            repaired=1;
            break;
          }
        }
        op=op+1;
      }
    }
    if(repaired==1){
      continue; // next iteration
    }
    // No repair found. Try split.
    // Probe family: [IN0/IN1, PUSH k, LT/GT/EQ], k in -4..4.
    // Deterministic order: pin=0,1; k=-4..4; pcmp=LT,GT,EQ.
    let found:i32=0;
    let spin:i32=0; let spk:i32=0; let spcmp:i32=0;
    let left_idx:[]u8=z_alloc(25*4);
    let right_idx:[]u8=z_alloc(25*4);
    let pin:i32=0;
    while(pin<=1){
      let k:i32=-4;
      while(k<=4){
        let cmp:i32=13;
        while(cmp<=15){
          // Partition episodes by probe.
          let nl:i32=0; let nr:i32=0;
          let j:i32=0;
          while(j<n){
            let ei:i32=get32(idx, j*4);
            let in0:i32=task_in0(task, ei); let in1:i32=task_in1(task, ei); let tgt:i32=task_tgt(task, ei);
            if(probe_eval(pin, k, cmp, in0, in1)==1){
              set32(left_idx, nl*4, ei); nl=nl+1;
            } else {
              set32(right_idx, nr*4, ei); nr=nr+1;
            }
            j=j+1;
          }
          // Require both non-empty. (The hypothesis says "separates failing
          // from passing"; we require a non-trivial partition. The recursion
          // will determine if it's useful.)
          if(nl>0 && nr>0){
            // Additionally, require that the probe separates at least one
            // failing from the passing set? For simplicity, accept any
            // non-trivial partition. But to avoid useless splits, require
            // that not all failing are on one side with all passing on the
            // other? Actually, let's be strict: the split is only useful if
            // it separates failing from passing. Check: is there at least
            // one failing in left and at least one passing in right, or vice
            // versa? Simpler: accept if both sides have at least one episode
            // from the failing set OR the partition is non-trivial.
            // For now, accept any non-trivial partition; the recursion will
            // fail if it's not useful, and we'll try the next probe.
            // But to match the hypothesis ("separates failing from passing"),
            // let's check: does the probe put all failing on one side?
            // Actually, the cleanest: require that the failing set is not
            // entirely on one side AND the passing set is not entirely on
            // the other? This is getting complex. Let's just try the first
            // non-trivial partition and see if recursion succeeds.
            found=1; spin=pin; spk=k; spcmp=cmp;
            // Save the partition for use after loops.
            // We need nl, nr, left_idx, right_idx. Break out.
            break;
          }
          cmp=cmp+1;
          if(found==1){break;}
        }
        if(found==1){break;}
        k=k+1;
      }
      if(found==1){break;}
      pin=pin+1;
    }
    if(found==0){
      trace_fail(task, "no probe separates");
      return 0;
    }
    // Recompute the partition for the found probe (since we broke out).
    let nl:i32=0; let nr:i32=0;
    let j:i32=0;
    while(j<n){
      let ei:i32=get32(idx, j*4);
      let in0:i32=task_in0(task, ei); let in1:i32=task_in1(task, ei); let tgt:i32=task_tgt(task, ei);
      if(probe_eval(spin, spk, spcmp, in0, in1)==1){
        set32(left_idx, nl*4, ei); nl=nl+1;
      } else {
        set32(right_idx, nr*4, ei); nr=nr+1;
      }
      j=j+1;
    }
    cnt_incr_splits(cnt);
    trace_split(task, spin, spk, spcmp, nl, nr);
    // Recursively grow each branch.
    let left_prog:[]u8=prog_new(200);
    let right_prog:[]u8=prog_new(200);
    let lok:i32=grow(task, left_idx, nl, left_prog, depth+1, cnt);
    if(lok==0){ return 0; }
    let rok:i32=grow(task, right_idx, nr, right_prog, depth+1, cnt);
    if(rok==0){ return 0; }
    // Compile: prefix + probe + JZ + left + JMP + right.
    // Probe ops: (1+pin, 0), (0, spk), (spcmp, 0).
    let pin_op:i32=1+spin; // 1=IN0, 2=IN1
    prog_append(prefix, pin_op, 0);
    prog_append(prefix, 0, spk);
    prog_append(prefix, spcmp, 0);
    let jz_pos:i32=prog_len(prefix);
    prog_append(prefix, 16, 0); // JZ placeholder
    let left_start:i32=prog_len(prefix);
    // Append left_prog ops.
    let li:i32=0;
    while(li<prog_len(left_prog)){
      prog_append(prefix, prog_op(left_prog, li), prog_arg(left_prog, li));
      li=li+1;
    }
    let jmp_pos:i32=prog_len(prefix);
    prog_append(prefix, 18, 0); // JMP placeholder
    let right_start:i32=prog_len(prefix);
    let ri:i32=0;
    while(ri<prog_len(right_prog)){
      prog_append(prefix, prog_op(right_prog, ri), prog_arg(right_prog, ri));
      ri=ri+1;
    }
    let end_pos:i32=prog_len(prefix);
    // Fix up jumps. JZ jumps to right_start if probe==0.
    // Note: our partition put probe==1 in left. So JZ (jump if zero)
    // should go to right (probe==0).
    prog_set(prefix, jz_pos, 16, right_start);
    prog_set(prefix, jmp_pos, 18, end_pos);
    prog_copy(out_prog, prefix);
    return 1;
  }
  trace_fail(task, "iteration limit");
  return 0;
}

// ============ main ============
fn main()void {
  emit("HYPOTHESIS C: Counterexample-Driven Structural Growth\n");
  emit("Battery prereg: 425f7276d. C prereg: 5a9ec56e7.\n");
  let task:i32=0;
  while(task<=5){
    emit("=== TASK T"); e64(task); emit(" ===\n");
    let evals:i64=0; let repairs:i32=0; let splits:i32=0;
    let n:i32=task_n_eps(task);
    // Build index array [0..n).
    let idx:[]u8=z_alloc(n*4);
    let i:i32=0;
    while(i<n){ set32(idx, i*4, i); i=i+1; }
    let prog:[]u8=prog_new(500);
    // Counter buffer: evals:i64 at 0, repairs:i32 at 8, splits:i32 at 12.
    let cnt:[]u8=z_alloc(16);
    set32(cnt,0,0); set32(cnt,4,0); set32(cnt,8,0); set32(cnt,12,0);
    let ok:i32=grow(task, idx, n, prog, 0, cnt);
    emit("RESULT t="); e64(task);
    if(ok==1){ emit(" SOLVE"); } else { emit(" FAIL"); }
    emit(" len="); e64(prog_len(prog));
    emit(" evals="); emit(i64s(cnt_evals(cnt)));
    emit(" repairs="); e64(cnt_repairs(cnt));
    emit(" splits="); e64(cnt_splits(cnt));
    nl();
    // Print program.
    emit("PROG");
    let j:i32=0;
    while(j<prog_len(prog)){
      emit(" ("); e64(prog_op(prog,j)); emit(","); e64(prog_arg(prog,j)); emit(")");
      j=j+1;
    }
    nl();
    // Verify: count exact on train.
    let nhit:i32=0;
    let k:i32=0;
    while(k<n){
      let in0:i32=task_in0(task, k); let in1:i32=task_in1(task, k); let tgt:i32=task_tgt(task, k);
      if(eval_one(prog, in0, in1, cnt)==tgt){ nhit=nhit+1; }
      k=k+1;
    }
    // Note: eval_one increments evals; subtract the verification evals.
    let ev:i64=cnt_evals(cnt);
    ev=ev-(n as i64);
    set32(cnt, 0, ev as i32); set32(cnt, 4, (ev>>32) as i32);
    emit("VERIFY train "); e64(nhit); emit("/"); e64(n); nl();
    task=task+1;
  }
  emit("DONE\n");
  return;
}

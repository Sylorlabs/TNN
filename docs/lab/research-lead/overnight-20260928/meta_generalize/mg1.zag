// mg1.zag -- MG1 experiment. Neutral identifiers only.
// 12 episodes; hidden integer parameter p in 10..90 per episode.
// 9 episodes (idx 0,1,2,4,5,6,8,9,10): p = permutation of {16..24}.
// 3 episodes (idx 3,7,11): p = permutation of {40,47,54}.
// Examples: 1200 binary outcomes per episode per condition; outcome=1
// iff draw < p. Streams are independent per condition (fresh seeds).
// Estimator: est_n = (w*m + 100*h)/(w+n), w=20; m = mean of past p
// (accumulating unit) or 50 (reset unit). Criterion: |est_n - p| < 5,
// smallest n in 1..1200, else 1201.
// Output: single preallocated buffer, one raw-syscall write.

// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena access (u8-backed cells) ----
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn g64(b:[]u8,off:i32)i64 {
  let lo:i64=(get32(b,off) as i64)&4294967295;
  let hi:i64=(get32(b,off+4) as i64)&4294967295;
  return lo|(hi<<32);
}
fn s64(b:[]u8,off:i32,v:i64)void {
  set32(b,off,(v&4294967295) as i32);
  set32(b,off+4,((v>>32)&4294967295) as i32);
  return;
}
fn rnd(G:[]u8,n:i32)i32 {
  let s:i64=g64(G,0);
  s=(s*1103515245+12345)%2147483648;
  s64(G,0,s);
  return (s%(n as i64)) as i32;
}
fn veq(G:[]u8,a:i32,b:i32,len:i32)i32 {
  let k:i32=0;
  while(k<len){
    if(G[a+k]!=G[b+k]){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- episode generation (frozen) ----
// G layout: 0 prng(8) | 8 pT[12](48) | 56 pC[12](48) |
// 104 fT[14400] | 14504 fC[14400] |
// 28904 eT[12](48) | 28952 eC[12](48) |
// 29000 genfail(4) | 29004 tmp9(36) | 29040 tmp3(12)
fn gen(G:[]u8)void {
  s64(G,0,20261007);
  let i:i32=0;
  while(i<9){ set32(G,29004+i*4,16+i); i=i+1; }
  i=0;
  while(i<9){
    let j:i32=i+rnd(G,9-i);
    let a:i32=get32(G,29004+i*4);
    set32(G,29004+i*4,get32(G,29004+j*4));
    set32(G,29004+j*4,a);
    i=i+1;
  }
  set32(G,29040,40); set32(G,29044,47); set32(G,29048,54);
  i=0;
  while(i<3){
    let j:i32=i+rnd(G,3-i);
    let a:i32=get32(G,29040+i*4);
    set32(G,29040+i*4,get32(G,29040+j*4));
    set32(G,29040+j*4,a);
    i=i+1;
  }
  let s:i32=0;
  let e:i32=0;
  while(e<12){
    let v:i32=0;
    if(e==3){ v=get32(G,29040); }
    else {
      if(e==7){ v=get32(G,29044); }
      else {
        if(e==11){ v=get32(G,29048); }
        else { v=get32(G,29004+s*4); s=s+1; }
      }
    }
    set32(G,8+e*4,v);
    set32(G,56+e*4,v);
    e=e+1;
  }
  s64(G,0,20261008);
  e=0;
  while(e<12){
    let pv:i32=get32(G,8+e*4);
    let k:i32=0;
    while(k<1200){
      let d:i32=rnd(G,100);
      let f:i32=0;
      if(d<pv){ f=1; }
      G[104+e*1200+k]=f as u8;
      k=k+1;
    }
    e=e+1;
  }
  s64(G,0,20261009);
  e=0;
  while(e<12){
    let pv:i32=get32(G,56+e*4);
    let k:i32=0;
    while(k<1200){
      let d:i32=rnd(G,100);
      let f:i32=0;
      if(d<pv){ f=1; }
      G[14504+e*1200+k]=f as u8;
      k=k+1;
    }
    e=e+1;
  }
  return;
}
// ---- examples-to-criterion for one episode ----
// m: current mean (hundredths). Returns smallest n in 1..1200 with
// |est_n - p| < 5, else 1201. Exact integer comparison, no division.
fn etc_ep(G:[]u8,e:i32,m:i32,fbase:i32,pbase:i32)i32 {
  let mi:i64=m as i64;
  let pi:i64=get32(G,pbase+e*4) as i64;
  let h:i64=0;
  let n:i32=1;
  while(n<=1200){
    h=h+(G[fbase+e*1200+n-1] as i64);
    let num:i64=20*mi+100*h;
    let den:i64=(20+n) as i64;
    let lhs:i64=num-pi*den;
    if(lhs<0){ lhs=0-lhs; }
    if(lhs<5*den){ return n; }
    n=n+1;
  }
  return 1201;
}
// ---- run one condition over the 12 episodes ----
// accum=1: accumulating unit (mean of past p); accum=0: reset unit (m=50).
// The cross-episode update takes ONLY the revealed p as input.
fn run_cond(G:[]u8,eoff:i32,accum:i32,fbase:i32,pbase:i32)void {
  let sum:i32=0;
  let cnt:i32=0;
  let e:i32=0;
  while(e<12){
    let m:i32=50;
    if(accum==1){
      if(cnt>0){ m=sum/cnt; }
    }
    let t:i32=etc_ep(G,e,m,fbase,pbase);
    set32(G,eoff+e*4,t);
    if(accum==1){
      sum=sum+get32(G,pbase+e*4);
      cnt=cnt+1;
    }
    e=e+1;
  }
  return;
}
fn main()i32 {
  let p:*u8=_zag_malloc(32768) as *u8;
  let G:[]u8=p[0..32768];
  let z:i32=0;
  while(z<32768){ G[z]=0; z=z+1; }
  gen(G);
  run_cond(G,28904,1,104,8);
  run_cond(G,28952,0,14504,56);
  let t1:i32=get32(G,28904);
  let c1:i32=get32(G,28952);
  let advc:i64=0;
  let advo:i64=0;
  let e:i32=0;
  while(e<12){
    let d:i64=(get32(G,28952+e*4) as i64)-(get32(G,28904+e*4) as i64);
    if(e==3){ advo=advo+d; }
    else {
      if(e==7){ advo=advo+d; }
      else {
        if(e==11){ advo=advo+d; }
        else { advc=advc+d; }
      }
    }
    e=e+1;
  }
  let tlate:i32=get32(G,28904+8*4)+get32(G,28904+9*4)+get32(G,28904+10*4);
  let tmid:i32=get32(G,28904+4*4)+get32(G,28904+5*4)+get32(G,28904+6*4);
  let b5a:i32=0; if(advc>=370){ b5a=1; }
  let b5b:i32=0; if((3 as i64)*(t1 as i64)-(tlate as i64)>=75){ b5b=1; }
  let b5c:i32=0; if(tlate-tmid<=150){ b5c=1; }
  let b5d:i32=0; if(t1>=25){ b5d=1; }
  let b5g:i32=0; if(advo<=0){ b5g=1; }
  let mx:i32=0;
  e=0;
  while(e<12){
    let a:i32=get32(G,28904+e*4);
    if(a>mx){ mx=a; }
    let b:i32=get32(G,28952+e*4);
    if(b>mx){ mx=b; }
    e=e+1;
  }
  let b5f:i32=0;
  if(mx<=1200){ if(get32(G,29000)==0){ b5f=1; } }
  // B4: 12 parameters distinct; 24 outcome vectors pairwise distinct
  let db:i32=1;
  let i2:i32=0;
  while(i2<12){
    let j:i32=i2+1;
    while(j<12){
      if(get32(G,8+i2*4)==get32(G,8+j*4)){ db=0; }
      j=j+1;
    }
    i2=i2+1;
  }
  let df:i32=1;
  let v1:i32=0;
  while(v1<24){
    let v2:i32=v1+1;
    while(v2<24){
      let b1:i32=104+v1*1200;
      if(v1>=12){ b1=14504+(v1-12)*1200; }
      let b2:i32=104+v2*1200;
      if(v2>=12){ b2=14504+(v2-12)*1200; }
      if(veq(G,b1,b2,1200)==1){ df=0; }
      v2=v2+1;
    }
    v1=v1+1;
  }
  // B5e: parameter identity across conditions; cross-condition disjointness;
  // per-condition outcome marginal sanity in [0.45, 0.85]
  let bid:i32=1;
  e=0;
  while(e<12){
    if(get32(G,8+e*4)!=get32(G,56+e*4)){ bid=0; }
    e=e+1;
  }
  let xd:i32=1;
  e=0;
  while(e<12){
    if(veq(G,104+e*1200,14504+e*1200,1200)==1){ xd=0; }
    e=e+1;
  }
  let oT:i64=0;
  let oC:i64=0;
  let k:i32=0;
  while(k<14400){
    oT=oT+(G[104+k] as i64);
    oC=oC+(G[14504+k] as i64);
    k=k+1;
  }
  let mg:i32=0;
  if(oT>=2880){ if(oT<=5040){ if(oC>=2880){ if(oC<=5040){ mg=1; } } } }
  let b5e:i32=0;
  if(bid==1){ if(xd==1){ if(mg==1){ b5e=1; } } }
  let q:*u8=_zag_malloc(4096) as *u8;
  let B:[]u8=q[0..4096];
  let c:i32=0;
  c=o_app(B,c,"MG1 SEEDB=20261007 SEEDT=20261008 SEEDC=20261009 W=20 TOL=5 N=1200"); c=o_nl(B,c);
  e=0;
  while(e<12){
    c=o_app(B,c,"E");
    if(e<9){ c=o_app(B,c,"0"); }
    c=o_i64(B,c,(e+1) as i64);
    c=o_app(B,c," P=");
    c=o_i64(B,c,get32(G,8+e*4) as i64);
    c=o_app(B,c," ET=");
    c=o_i64(B,c,get32(G,28904+e*4) as i64);
    c=o_app(B,c," EC=");
    c=o_i64(B,c,get32(G,28952+e*4) as i64);
    c=o_nl(B,c);
    e=e+1;
  }
  c=o_app(B,c,"ADV_C="); c=o_i64(B,c,advc);
  c=o_app(B,c," ADV_O="); c=o_i64(B,c,advo);
  c=o_app(B,c," T1="); c=o_i64(B,c,t1 as i64);
  c=o_app(B,c," C1="); c=o_i64(B,c,c1 as i64);
  c=o_app(B,c," TLATE="); c=o_i64(B,c,tlate as i64);
  c=o_app(B,c," TMID="); c=o_i64(B,c,tmid as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"B5A="); c=o_i64(B,c,b5a as i64);
  c=o_app(B,c," B5B="); c=o_i64(B,c,b5b as i64);
  c=o_app(B,c," B5C="); c=o_i64(B,c,b5c as i64);
  c=o_app(B,c," B5D="); c=o_i64(B,c,b5d as i64);
  c=o_app(B,c," B5E="); c=o_i64(B,c,b5e as i64);
  c=o_app(B,c," B5F="); c=o_i64(B,c,b5f as i64);
  c=o_app(B,c," B5G="); c=o_i64(B,c,b5g as i64);
  c=o_app(B,c," DISTINCTB="); c=o_i64(B,c,db as i64);
  c=o_app(B,c," DISTINCTF="); c=o_i64(B,c,df as i64);
  c=o_app(B,c," PARID="); c=o_i64(B,c,bid as i64);
  c=o_app(B,c," XDISJ="); c=o_i64(B,c,xd as i64);
  c=o_app(B,c," MARG="); c=o_i64(B,c,mg as i64);
  c=o_app(B,c," GENFAIL="); c=o_i64(B,c,get32(G,29000) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

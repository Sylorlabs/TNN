// world_stf.zag -- Transfer world S-TRF (treatment) for F3 REVISE step 9.
// Concatenate AFTER the FROZEN f3_revise.zag (sha256-verified before build).
// Prereg: revise_transfer/PREREG_REVISE_TRANSFER.md (frozen alone first).
//
// Design: learning segment is byte-identical to sealed S-NEG2. The goal
// phase presents successive episodes via a per-process counter kept in
// ws bytes 92..103 (magic 1414678085 at 92..95, counter at 96..99).
// w_reset clears bytes 0..91 and preserves 92..103. Safe: the learner
// never advances the world clock past t=11, so Y history bytes 84..103
// are never read or written by the learner.
//   w_goal_setup call 1 -> setup S1: Z=1 at t=0 (standard inhibitor).
//   w_goal_setup call 2+ -> setup S2: Z=1 and X=1 at t=0 (transfer).
// Causal truth is identical in all episodes:
//   Y(t) = X(t-2) AND NOT Z(t-2).
// Vars: X(0,ctrl), Z(1,ctrl), Y(2). Pulsed (SET writes current step only).
// Passive: env SETs X ALONE at t=3,9 (Z never pulsed). Then Y=1 at t=5,11.
// Pure Zag. No Python.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 1; } // X, Z
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  return "Y";
}
fn w_worldname()[]u8 { return "SQ10-eps-transfer"; }
fn w_plan_maxd()i32 { return 8; }

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (3*32 bytes),
// +92 magic(i32), +96 episode counter(i32), +100 spare(i32).
// w_reset preserves the 92..103 region (see header note).
fn w_reset(ws:[]u8)void {
  let magic:i32=get32(ws,92);
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<92){ ws[i]=0; i=i+1; }
  if(magic!=1414678085){
    set32(ws,92,1414678085);
    set32(ws,96,0);
    set32(ws,100,0);
  }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    // Truth (all episodes): Y(t) = X(t-2) AND NOT Z(t-2).
    let xv:i32=0;
    let zv:i32=0;
    if(t-2>=0){ xv=ws[8+0*32+(t-2)] as i32; }
    if(t-2>=0){ zv=ws[8+1*32+(t-2)] as i32; }
    let yv:i32=0;
    if(xv==1 && zv==0){ yv=1; }
    ws[8+2*32+t]=yv as u8;
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule (learning segment): env SETs X ALONE at t=3,9.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==3){ ws[8+0*32+t]=1; }
  if(t==9){ ws[8+0*32+t]=1; }
  return;
}
// Goal setups by episode:
//   episode 1 (S1): inhibitor Z=1 at t=0, X=0, Y=0.
//   episode 2+ (S2): Z=1 and X=1 at t=0, Y=0 (transfer: X pre-set).
fn w_goal_setup(ws:[]u8)void {
  let c:i32=get32(ws,96)+1;
  set32(ws,96,c);
  if(c<=1){
    ws[8+1*32+0]=1;
  } else {
    ws[8+1*32+0]=1;
    ws[8+0*32+0]=1;
  }
  return;
}
fn w_goal_met(vals:[]u8)i32 {
  if(vals[2]==1){ return 1; }
  return 0;
}

fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  emit("TRANSFER DONE mask="); e64(m); emit("\n");
  return 0;
}

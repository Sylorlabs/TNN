// world_sct.zag -- Control world S-CTF for F3 REVISE step 9.
// Concatenate AFTER the FROZEN f3_revise.zag (sha256-verified before build).
// Prereg: revise_transfer/PREREG_REVISE_TRANSFER.md (frozen alone first).
//
// Identical to world_stf.zag (same episode-counter harness, same truth,
// same passive) EXCEPT w_goal_setup presents setup S2 (Z=1 and X=1 at
// t=0) on the FIRST goal episode already: the guard is not pre-grown.
// If attempt 1 then fails and D1 grows !Z@2, the test harness is valid
// (S2 requires the guard); if attempt 1 succeeds, the test is VOID.
// Pure Zag. No Python.

fn w_goal_mode()i32 { return 0; }
fn w_nvars()i32 { return 3; }
fn w_nctrl()i32 { return 2; }
fn w_ctrl(i:i32)i32 { if(i==0){ return 0; } return 1; } // X, Z
fn w_ctxvar()i32 { return -1; }
fn w_vname(v:i32)[]u8 {
  if(v==0){ return "X"; }
  if(v==1){ return "Z"; }
  return "Y";
}
fn w_worldname()[]u8 { return "SQ11-eps-control"; }
fn w_plan_maxd()i32 { return 8; }

// ws layout: +0 t(i32), +4 ncalls(i32), +8 hist (3*32 bytes),
// +92 magic(i32), +96 episode counter(i32), +100 spare(i32).
fn w_reset(ws:[]u8)void {
  let magic:i32=get32(ws,92);
  set32(ws,0,0);
  set32(ws,4,0);
  let i:i32=8;
  while(i<92){ ws[i]=0; i=i+1; }
  if(magic!=1414678085){
    set32(ws,92,1414678085);
    set32(ws,96,0);
    set32(ws,100,0);
  }
  return;
}
fn w_ncalls(ws:[]u8)i32 { return get32(ws,4); }
fn w_act(ws:[]u8, kind:i32, v:i32)i32 {
  set32(ws,4,get32(ws,4)+1);
  let t:i32=get32(ws,0);
  if(kind==0){ ws[8+v*32+t]=1; return -1; }
  if(kind==1){ ws[8+v*32+t]=0; return -1; }
  if(kind==2){
    t=t+1;
    set32(ws,0,t);
    // Truth (all episodes): Y(t) = X(t-2) AND NOT Z(t-2).
    let xv:i32=0;
    let zv:i32=0;
    if(t-2>=0){ xv=ws[8+0*32+(t-2)] as i32; }
    if(t-2>=0){ zv=ws[8+1*32+(t-2)] as i32; }
    let yv:i32=0;
    if(xv==1 && zv==0){ yv=1; }
    ws[8+2*32+t]=yv as u8;
    return -1;
  }
  return ws[8+v*32+t] as i32;
}
fn w_snapshot(ws:[]u8, out:[]u8)void {
  let t:i32=get32(ws,0);
  let v:i32=0;
  while(v<3){ out[v]=ws[8+v*32+t]; v=v+1; }
  return;
}
// Passive schedule (learning segment): env SETs X ALONE at t=3,9.
fn w_passive(ws:[]u8)void {
  let t:i32=get32(ws,0);
  if(t==3){ ws[8+0*32+t]=1; }
  if(t==9){ ws[8+0*32+t]=1; }
  return;
}
// Control: setup S2 on EVERY goal episode (Z=1 and X=1 at t=0, Y=0).
fn w_goal_setup(ws:[]u8)void {
  let c:i32=get32(ws,96)+1;
  set32(ws,96,c);
  ws[8+1*32+0]=1;
  ws[8+0*32+0]=1;
  return;
}
fn w_goal_met(vals:[]u8)i32 {
  if(vals[2]==1){ return 1; }
  return 0;
}

fn w_verify(alive:[]u8, hysel:[]u8, evars:[]u8, ne:i32, nhyp:i32,
            candbuf:[]u8, exhausted:i32, nalive:i32)i32 {
  return 0;
}

fn main()i32 {
  let m:i32=L_run();
  emit("CONTROL DONE mask="); e64(m); emit("\n");
  return 0;
}

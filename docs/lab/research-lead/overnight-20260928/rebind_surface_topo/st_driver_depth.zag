// st_driver_depth.zag -- Test 4: Topology Transfer, Depth 5->3 (Q2E-1).
// World A (treatment only): same as original.
//   Decoy: 2->21->22 (plen-3 MAP, lower ID, scanned first).
//   Main: 1->11->12->13->14 (plen-5 MAP).
// World B (both arms): needs plen-3 (NOT plen-5).
//   Main: 601->611->612->613 (length 3).
//   Distractors of various lengths.
// Query (601,50) expects 613.
// Question: Can the mechanism SELECT the right MAP from multiple candidates?
// The plen-3 decoy MAP should match (exact plen filter). The plen-5 main MAP
// should be skipped (no length-5 path). This tests MAP selection, not just
// single-MAP reuse.
fn rb_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("REBIND-DEPTH-START\n");
  if(phase_a_enabled()==1){
    ev_teach(W,2,1,21); ev_teach(W,21,1,22);
    let a1:i32=ev_query(W,2,51,22,0);
    emit("A-DECOY ans="); e64(a1); rb_tstat(W);
    ev_teach(W,1,1,11); ev_teach(W,11,1,12);
    ev_teach(W,12,1,13); ev_teach(W,13,1,14);
    let a2:i32=ev_query(W,1,50,14,0);
    emit("A-MAIN ans="); e64(a2); rb_tstat(W);
  }
  // World B: needs plen-3. Main chain 601->611->612 (3 nodes).
  ev_teach(W,601,1,611); ev_teach(W,611,1,612);
  // Distractors: two length-4, one length-5 decoy, one length-2.
  ev_teach(W,601,1,621); ev_teach(W,621,1,622); ev_teach(W,622,1,623);
  ev_teach(W,601,1,631); ev_teach(W,631,1,632); ev_teach(W,632,1,633);
  ev_teach(W,601,1,641); ev_teach(W,641,1,642); ev_teach(W,642,1,643);
  ev_teach(W,643,1,644);
  ev_teach(W,601,1,651); ev_teach(W,651,1,652); ev_teach(W,652,1,653);
  ev_teach(W,653,1,654); ev_teach(W,654,1,655);
  ev_teach(W,601,1,661); ev_teach(W,661,1,662);
  let b:i32=ev_query(W,601,50,612,0);
  emit("B-MAIN ans="); e64(b); rb_tstat(W);
  emit("B-NODES live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24)); emit("\n");
  emit("REBIND-DEPTH-END\n");
  return 0;
}

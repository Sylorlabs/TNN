// st_driver_irreg.zag -- Test 2: Surface Permutation via Irregular Spacing (Q2A-2).
// World A (treatment only): same as original (relation 1, regular IDs).
// World B (both arms): chain with IRREGULAR entity ID gaps.
//   Main: 401->450->451->500->501 (gaps: 49, 1, 49, 1).
//   Distractors with irregular IDs.
// Query (401,50) expects 501.
// Question: Does the mechanism depend on arithmetic patterns in IDs?
// It should not; rebinding is positional over gathered paths.
fn rb_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("REBIND-IRREG-START\n");
  if(phase_a_enabled()==1){
    ev_teach(W,2,1,21); ev_teach(W,21,1,22);
    let a1:i32=ev_query(W,2,51,22,0);
    emit("A-DECOY ans="); e64(a1); rb_tstat(W);
    ev_teach(W,1,1,11); ev_teach(W,11,1,12);
    ev_teach(W,12,1,13); ev_teach(W,13,1,14);
    let a2:i32=ev_query(W,1,50,14,0);
    emit("A-MAIN ans="); e64(a2); rb_tstat(W);
  }
  // World B: irregular ID gaps. Chain 401->450->451->500->501.
  ev_teach(W,401,1,450); ev_teach(W,450,1,451);
  ev_teach(W,451,1,500); ev_teach(W,500,1,501);
  // Distractors with irregular IDs.
  ev_teach(W,401,1,460); ev_teach(W,460,1,461);
  ev_teach(W,401,1,470); ev_teach(W,470,1,471);
  ev_teach(W,401,1,480); ev_teach(W,480,1,481); ev_teach(W,481,1,482);
  ev_teach(W,401,1,490); ev_teach(W,490,1,491); ev_teach(W,491,1,492);
  ev_teach(W,401,1,495); ev_teach(W,495,1,496);
  ev_teach(W,496,1,497); ev_teach(W,497,1,498);
  let b:i32=ev_query(W,401,50,501,0);
  emit("B-MAIN ans="); e64(b); rb_tstat(W);
  emit("B-NODES live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24)); emit("\n");
  emit("REBIND-IRREG-END\n");
  return 0;
}

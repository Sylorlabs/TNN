// st_driver_rel.zag -- Test 1: Surface Permutation via Relation Change (Q2A-1).
// World A (treatment only): same as original (relation 1 chains).
//   Decoy: 2->21->22 (plen-3 MAP). Main: 1->11->12->13->14 (plen-5 MAP).
// World B (both arms): chain with DIFFERENT relation (7, not 1).
//   Main: 301->311->312->313->314 (relation 7).
//   Distractors with relation 7.
// Query (301,50) expects 314.
// Question: Is the rebind mechanism relation-agnostic? The MAP was learned
// with relation 1, but the shape (plen) is structural. Literals and relations
// come from B's gathered paths.
fn rb_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("REBIND-REL-START\n");
  if(phase_a_enabled()==1){
    ev_teach(W,2,1,21); ev_teach(W,21,1,22);
    let a1:i32=ev_query(W,2,51,22,0);
    emit("A-DECOY ans="); e64(a1); rb_tstat(W);
    ev_teach(W,1,1,11); ev_teach(W,11,1,12);
    ev_teach(W,12,1,13); ev_teach(W,13,1,14);
    let a2:i32=ev_query(W,1,50,14,0);
    emit("A-MAIN ans="); e64(a2); rb_tstat(W);
  }
  // World B: relation 7 (not 1). Same chain topology, different surface relation.
  ev_teach(W,301,7,311); ev_teach(W,311,7,312);
  ev_teach(W,312,7,313); ev_teach(W,313,7,314);
  // Distractors with relation 7: two length-3, two length-4, one length-5 decoy.
  ev_teach(W,301,7,321); ev_teach(W,321,7,322);
  ev_teach(W,301,7,323); ev_teach(W,323,7,324);
  ev_teach(W,301,7,325); ev_teach(W,325,7,326); ev_teach(W,326,7,327);
  ev_teach(W,301,7,328); ev_teach(W,328,7,329); ev_teach(W,329,7,330);
  ev_teach(W,301,7,331); ev_teach(W,331,7,332);
  ev_teach(W,332,7,333); ev_teach(W,333,7,334);
  let b:i32=ev_query(W,301,50,314,0);
  emit("B-MAIN ans="); e64(b); rb_tstat(W);
  emit("B-NODES live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24)); emit("\n");
  emit("REBIND-REL-END\n");
  return 0;
}

// rb_driver.zag -- reuse-rebinding experiment driver (harness-side).
// World A (treatment only): teach two chains, query to promote MAPs.
//   decoy first (lower MAP id): 2->21->22, query (2,51) expects 22.
//   main: 1->11->12->13->14, query (1,50) expects 14.
// World B (both arms): structurally isomorphic chain 101->111->112->113->114
// with distractor paths of lengths 3 and 4 (plus one length-5 decoy path).
// Query (101,50) expects 114.
// Metric: verification attempts (tried) per query, read from hg(W,16)
// (t2_trial and the rebound path both report tried*1024+rejected there).
fn rb_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("REBIND-START\n");
  if(phase_a_enabled()==1){
    ev_teach(W,2,1,21); ev_teach(W,21,1,22);
    let a1:i32=ev_query(W,2,51,22,0);
    emit("A-DECOY ans="); e64(a1); rb_tstat(W);
    ev_teach(W,1,1,11); ev_teach(W,11,1,12);
    ev_teach(W,12,1,13); ev_teach(W,13,1,14);
    let a2:i32=ev_query(W,1,50,14,0);
    emit("A-MAIN ans="); e64(a2); rb_tstat(W);
  }
  ev_teach(W,101,1,111); ev_teach(W,111,1,112);
  ev_teach(W,112,1,113); ev_teach(W,113,1,114);
  ev_teach(W,101,1,201); ev_teach(W,201,1,202);
  ev_teach(W,101,1,203); ev_teach(W,203,1,204);
  ev_teach(W,101,1,205); ev_teach(W,205,1,206); ev_teach(W,206,1,207);
  ev_teach(W,101,1,208); ev_teach(W,208,1,209); ev_teach(W,209,1,210);
  ev_teach(W,101,1,211); ev_teach(W,211,1,212);
  ev_teach(W,212,1,213); ev_teach(W,213,1,214);
  let b:i32=ev_query(W,101,50,114,0);
  emit("B-MAIN ans="); e64(b); rb_tstat(W);
  emit("B-NODES live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24)); emit("\n");
  emit("REBIND-END\n");
  return 0;
}

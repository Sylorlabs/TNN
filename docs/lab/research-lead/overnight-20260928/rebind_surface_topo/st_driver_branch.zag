// st_driver_branch.zag -- Test 5: Topology Transfer, Branched Structure (Q2E-2).
// World A (treatment only): same as original (plen-3 decoy, plen-5 main).
// World B (both arms): BRANCHED structure with a correct path.
//   Path 1 (correct, length 4): 701->711->712->713 (expects 713).
//   Path 2 (dead end, length 3): 701->721->722 (expects nothing; 722 != 713).
//   Distractors.
// Query (701,50) expects 713.
// Question: How does the mechanism handle branching?
// - The plen-5 MAP will not match (no length-5 path from 701).
// - The plen-3 MAP WILL match the dead-end path (701->721->722), but
//   verification against expected=713 will FAIL (722 != 713). This tests
//   whether verification correctly rejects a shape-match with wrong answer.
// - Then fallback to trial should find the length-4 path.
// Expected: graceful fallback. The mechanism tries, verification rejects,
// trial succeeds. This is the honest behavior for a topology the MAP
// does not cover.
fn rb_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("REBIND-BRANCH-START\n");
  if(phase_a_enabled()==1){
    ev_teach(W,2,1,21); ev_teach(W,21,1,22);
    let a1:i32=ev_query(W,2,51,22,0);
    emit("A-DECOY ans="); e64(a1); rb_tstat(W);
    ev_teach(W,1,1,11); ev_teach(W,11,1,12);
    ev_teach(W,12,1,13); ev_teach(W,13,1,14);
    let a2:i32=ev_query(W,1,50,14,0);
    emit("A-MAIN ans="); e64(a2); rb_tstat(W);
  }
  // World B: branched from 701.
  // Correct path (length 4): 701->711->712->713.
  ev_teach(W,701,1,711); ev_teach(W,711,1,712); ev_teach(W,712,1,713);
  // Dead-end branch (length 3): 701->721->722. Plen-3 MAP will match this
  // path, but verification (expected=713) must reject it.
  ev_teach(W,701,1,721); ev_teach(W,721,1,722);
  // Distractors.
  ev_teach(W,701,1,731); ev_teach(W,731,1,732); ev_teach(W,732,1,733);
  ev_teach(W,701,1,741); ev_teach(W,741,1,742);
  let b:i32=ev_query(W,701,50,713,0);
  emit("B-MAIN ans="); e64(b); rb_tstat(W);
  emit("B-NODES live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24)); emit("\n");
  emit("REBIND-BRANCH-END\n");
  return 0;
}

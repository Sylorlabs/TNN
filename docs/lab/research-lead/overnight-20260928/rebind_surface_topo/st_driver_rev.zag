// st_driver_rev.zag -- Test 3: Surface Permutation via Reversed Direction (Q2A-3).
// World A (treatment only): same as original (1->11->12->13->14).
// World B (both arms): REVERSED chain direction.
//   Main: 514->513->512->511->501 (edges point from high to low).
//   Query (514,50) expects 501 (follow forward from 514).
// Distractors also reversed.
// Question: Is the mechanism direction-agnostic? The chain topology is
// the same (linear), just the ID ordering is reversed. BFS from the
// query subject should find the path regardless of ID values.
fn rb_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}
fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("REBIND-REV-START\n");
  if(phase_a_enabled()==1){
    ev_teach(W,2,1,21); ev_teach(W,21,1,22);
    let a1:i32=ev_query(W,2,51,22,0);
    emit("A-DECOY ans="); e64(a1); rb_tstat(W);
    ev_teach(W,1,1,11); ev_teach(W,11,1,12);
    ev_teach(W,12,1,13); ev_teach(W,13,1,14);
    let a2:i32=ev_query(W,1,50,14,0);
    emit("A-MAIN ans="); e64(a2); rb_tstat(W);
  }
  // World B: reversed chain 514->513->512->511->501.
  ev_teach(W,514,1,513); ev_teach(W,513,1,512);
  ev_teach(W,512,1,511); ev_teach(W,511,1,501);
  // Distractors (reversed direction).
  ev_teach(W,514,1,524); ev_teach(W,524,1,525);
  ev_teach(W,514,1,534); ev_teach(W,534,1,535);
  ev_teach(W,514,1,544); ev_teach(W,544,1,545); ev_teach(W,545,1,546);
  ev_teach(W,514,1,554); ev_teach(W,554,1,555); ev_teach(W,555,1,556);
  ev_teach(W,514,1,564); ev_teach(W,564,1,565);
  ev_teach(W,565,1,566); ev_teach(W,566,1,567);
  let b:i32=ev_query(W,514,50,501,0);
  emit("B-MAIN ans="); e64(b); rb_tstat(W);
  emit("B-NODES live="); e64(hg(W,20)); emit(" edges="); e64(hg(W,24)); emit("\n");
  emit("REBIND-REV-END\n");
  return 0;
}

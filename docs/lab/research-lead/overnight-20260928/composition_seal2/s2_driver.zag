// s2_driver.zag -- H-SEAL2-1 second adversarial seal driver.
//
// Nine post-freeze worlds attacking the frozen collapsed+gate
// composition mechanism. Shared verbatim by both arms (BASE ablats
// the gate, GATE has it). World/driver code only; the mechanism
// (frozen_base + frozen_patch_*) is never modified.
//
// Worlds:
//   S2A: gate false-negative, winner-not-first at identical
//        (frontier,shape). Expect GATE FAIL / BASE PASS.
//   S2B: misleading co-use history (wrong-way D->X edge), decoy
//        garden path. Expect both PASS (SURVIVE); waste measured.
//   S2B0: S2B control without the wrong-way edge.
//   S2C0: T4-analog control, unpolluted store. Expect both FAIL.
//   S2C: S2C0 with a MALFORMED fragment mark (raw type-15 edge,
//        impossible (m_y,0,3) triple on a plen-2 MAP, entry cell
//        hand-pointed at X's chain). Expect both PASS with false
//        provenance.
//   S2D: cross-domain (X r1, Y r5) with decoy domain (D r9,
//        parallel facts, trained first). Expect both PASS with
//        decoy-first attribution.
//   S2E: T4 partial applicability; applicable (m_x,0,3) seeded DEEP
//        behind two same-shape failing decoys. Expect GATE FAIL /
//        BASE PASS.
//   S2F: clean single-segment world; AP pre-seeded with 2
//        FABRICATED failure records at (F(101,70), shape 2).
//        Expect GATE FAIL / BASE PASS.
//   S2G: 32 satisfiable decoy marks ahead of the winner in
//        edge-id order; 32-candidate cap truncates the scan.
//        Expect both FAIL.
//   S2H: Z needs the same fragment twice; per-path triple
//        exclusion forbids reuse. Expect both FAIL.

// ---- shared helpers ----
fn s2_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){
    ev_teach(W,5000+i,60+(i%10),6000+i);
    i=i+1;
  }
  return;
}
fn s2_nmaps(W:[]u8)i32 {
  let n:i32=0; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){n=n+1;}
    m=m+1;
  }
  return n;
}
// Verbatim rename-copy of ma_features_from_paths (gate patch), used
// ONLY to compute the fabrication target for S2F in the driver.
// Both arms link t2_gather from the frozen base.
fn s2_feats(W:[]u8,cur:i32,r:i32,F:[]u8)void {
  let paths:[]u8=z_alloc(4608); let np:i32=t2_gather(W,cur,paths);
  let pmax:i32=0;
  let c5:i32=0; let c4:i32=0; let c3:i32=0; let c2:i32=0; let cx:i32=0;
  let p:i32=0;
  while(p<np){
    let pbase:i32=p*48; let plen:i32=get32(paths,pbase);
    if(plen>pmax){pmax=plen;}
    if(plen==5){c5=c5+1;}
    if(plen==4){c4=c4+1;}
    if(plen==3){c3=c3+1;}
    if(plen==2){c2=c2+1;}
    let k:i32=0; let bad:i32=0;
    while(k<plen-1){
      let fn2:i32=get32(paths,pbase+24+k*4);
      if(ng(W,fn2,24)!=1){bad=1;}
      k=k+1;
    }
    if(bad==1){cx=cx+1;}
    p=p+1;
  }
  set32(F,0,np); set32(F,4,pmax);
  set32(F,8,c5); set32(F,12,c4); set32(F,16,c3); set32(F,20,c2);
  set32(F,24,cx); set32(F,28,r);
  return;
}
// Fabricate n failure records at (F(cur,r), shape) in AP.
// Adversarial AP seeding for S2F.
fn s2_fab_fail(W:[]u8,AP:[]u8,cur:i32,r:i32,shape:i32,n:i32)void {
  let F:[]u8=z_alloc(32); s2_feats(W,cur,r,F);
  let k:i32=0;
  while(k<n){
    let nrec:i32=get32(AP,32);
    let roff:i32=40+(nrec%64)*44;
    let j:i32=0;
    while(j<8){set32(AP,roff+j*4,get32(F,j*4)); j=j+1;}
    set32(AP,roff+32,shape);
    set32(AP,roff+36,0);
    set32(AP,roff+40,1);
    if(nrec<64){set32(AP,32,nrec+1);}
    k=k+1;
  }
  emit("S2F-FAB n="); e64(n); emit(" shape="); e64(shape);
  emit(" cur="); e64(cur); emit("\n");
  return;
}
fn s2_seed(W:[]u8,m:i32,start:i32,len:i32)i32 {
  let e:i32=cl_mark(W,m,start,len);
  emit("S2-SEED m="); e64(m); emit(" s="); e64(start);
  emit(" l="); e64(len); emit(" e="); e64(e); emit("\n");
  return e;
}

// ---- S2A: gate false-negative, winner-not-first ----
// D1 (r7), D2 (r8) plen-2 trained before W (r9) plen-2.
// Z is one W segment (101->102->103, r9). At 101 no plen-3 path
// exists, so the decoys fail cl_satisfy outright (fetch fails,
// A's fallback finds no plen-3 path) and poison (F101,2) before
// the winner is evaluated.
fn s2a_test(W:[]u8)void {
  emit("=== S2A-WINNER-NOT-FIRST ===\n");
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  ev_teach(W,11,7,12); ev_teach(W,12,7,13);
  let q1:i32=ev_query_ap(W,AP,11,71,13,0);
  let md1:i32=cb_newest_map(W);
  ev_teach(W,21,8,22); ev_teach(W,22,8,23);
  let q2:i32=ev_query_ap(W,AP,21,72,23,0);
  let md2:i32=cb_newest_map(W);
  ev_teach(W,31,9,32); ev_teach(W,32,9,33);
  let q3:i32=ev_query_ap(W,AP,31,73,33,0);
  let mw:i32=cb_newest_map(W);
  emit("S2A train q1="); e64(q1); emit(" md1="); e64(md1);
  emit(" q2="); e64(q2); emit(" md2="); e64(md2);
  emit(" q3="); e64(q3); emit(" mw="); e64(mw);
  emit(" maps="); e64(s2_nmaps(W)); emit("\n");
  ev_teach(W,101,9,102); ev_teach(W,102,9,103);
  // Direct compose_try call (H-COMPVER-1 precedent): ev_query_ap's
  // rebind_try would answer this single-segment query without ever
  // reaching composition. The unit under seal is compose_try.
  let st:[]u8=z_alloc(8);
  let z:i32=compose_try(W,AP,101,70,103,0,st);
  emit("S2A-ANS="); e64(z); emit("\n");
  if(z==103){emit("S2A-RESULT=PASS\n");} else {emit("S2A-RESULT=FAIL\n");}
  return;
}

// ---- S2B / S2B0: misleading co-use history ----
// X (r1), W (r3) trained before decoy D (r2). Wrong-way edge D->X
// (S2B only) makes the DFS try D first at 103, where D's fetch
// succeeds down a decoy branch (103->201->202->203, r2) and
// dead-ends; then W completes 103->104->105. S2B0 is the control
// without the wrong-way edge.
fn s2b_world(W:[]u8,wrong:i32)void {
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let qx:i32=ev_query_ap(W,AP,11,71,13,0);
  let mx:i32=cb_newest_map(W);
  ev_teach(W,31,3,32); ev_teach(W,32,3,33);
  let qw:i32=ev_query_ap(W,AP,31,73,33,0);
  let mw:i32=cb_newest_map(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let qd:i32=ev_query_ap(W,AP,21,72,23,0);
  let md:i32=cb_newest_map(W);
  if(wrong==1){
    cb_couse_link(W,md,mx);
    emit("S2B wrong-way edge md->mx written\n");
  }
  s2_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,3,104); ev_teach(W,104,3,105);
  ev_teach(W,103,2,201); ev_teach(W,201,2,202); ev_teach(W,202,2,203);
  let z:i32=ev_query_ap(W,AP,101,70,105,0);
  if(wrong==1){emit("S2B-ANS=");} else {emit("S2B0-ANS=");}
  e64(z); emit("\n");
  if(z==105){
    if(wrong==1){emit("S2B-RESULT=PASS\n");} else {emit("S2B0-RESULT=PASS\n");}
  } else {
    if(wrong==1){emit("S2B-RESULT=FAIL\n");} else {emit("S2B0-RESULT=FAIL\n");}
  }
  return;
}
fn s2b_test(W:[]u8)void {
  emit("=== S2B-MISLEADING-COUSE ===\n");
  s2b_world(W,1);
  return;
}
fn s2b0_test(W:[]u8)void {
  emit("=== S2B0-COUSE-CONTROL ===\n");
  s2b_world(W,0);
  return;
}

// ---- S2C0 / S2C: polluted fragment store ----
// T4-analog: X plen-4 r1, Y plen-2 r2, Z needs 3 of X then Y.
// S2C0: unpolluted control (expect FAIL, no false positive).
// S2C: raw type-15 edge (m_y, aux=(0<<16)|3) on the plen-2 Y MAP
// with entry hand-pointed at X's chain start: a structurally
// impossible mark that bypasses cl_mark validation.
fn s2c_train(W:[]u8,AP:[]u8)void {
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  ev_teach(W,13,1,14); ev_teach(W,14,1,15);
  let qx:i32=ev_query_ap(W,AP,11,71,15,0);
  emit("S2C-X q="); e64(qx); emit(" mx="); e64(cb_newest_map(W)); emit("\n");
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let qy:i32=ev_query_ap(W,AP,21,72,23,0);
  emit("S2C-Y q="); e64(qy); emit(" my="); e64(cb_newest_map(W)); emit("\n");
  return;
}
fn s2c_zfacts(W:[]u8)void {
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,2,105); ev_teach(W,105,2,106);
  return;
}
fn s2c0_test(W:[]u8)void {
  emit("=== S2C0-UNPOLLUTED-CONTROL ===\n");
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  s2c_train(W,AP);
  s2_gap(W);
  s2c_zfacts(W);
  let z:i32=ev_query_ap(W,AP,101,70,106,0);
  emit("S2C0-ANS="); e64(z); emit("\n");
  if(z==106){emit("S2C0-RESULT=PASS\n");} else {emit("S2C0-RESULT=FAIL\n");}
  return;
}
fn s2c_test(W:[]u8)void {
  emit("=== S2C-POLLUTED-STORE ===\n");
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  ev_teach(W,13,1,14); ev_teach(W,14,1,15);
  let qx:i32=ev_query_ap(W,AP,11,71,15,0);
  let mx:i32=cb_newest_map(W);
  ev_teach(W,21,2,22); ev_teach(W,22,2,23);
  let qy:i32=ev_query_ap(W,AP,21,72,23,0);
  let my:i32=cb_newest_map(W);
  emit("S2C train qx="); e64(qx); emit(" mx="); e64(mx);
  emit(" qy="); e64(qy); emit(" my="); e64(my); emit("\n");
  let entry:i32=ng(W,mx,20);
  let pe:i32=link_edge(W,my,15,entry,3);
  emit("S2C-POLLUTE my="); e64(my); emit(" mx="); e64(mx);
  emit(" entry="); e64(entry); emit(" pe="); e64(pe); emit("\n");
  s2_gap(W);
  s2c_zfacts(W);
  let z:i32=ev_query_ap(W,AP,101,70,106,0);
  emit("S2C-ANS="); e64(z); emit("\n");
  if(z==106){emit("S2C-RESULT=PASS\n");} else {emit("S2C-RESULT=FAIL\n");}
  return;
}

// ---- S2D: cross-domain with decoy domain ----
// Decoy D (r9, plen-3) trained FIRST (lowest MAP id, tried first),
// then X (r1, plen-3), Y (r5, plen-1). Z facts: X's r1 chain
// 101->104 plus Y's r5 hop 104->105, with a PARALLEL decoy r9
// chain over the same nodes.
fn s2d_test(W:[]u8)void {
  emit("=== S2D-DECOY-DOMAIN ===\n");
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  ev_teach(W,31,9,32); ev_teach(W,32,9,33); ev_teach(W,33,9,34);
  let qd:i32=ev_query_ap(W,AP,31,79,34,0);
  let md:i32=cb_newest_map(W);
  ev_teach(W,11,1,12); ev_teach(W,12,1,13); ev_teach(W,13,1,14);
  let qx:i32=ev_query_ap(W,AP,11,71,14,0);
  let mx:i32=cb_newest_map(W);
  ev_teach(W,21,5,22);
  let qy:i32=ev_query_ap(W,AP,21,72,22,0);
  let my:i32=cb_newest_map(W);
  emit("S2D md="); e64(md); emit(" mx="); e64(mx); emit(" my="); e64(my);
  emit(" maps="); e64(s2_nmaps(W)); emit("\n");
  s2_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  ev_teach(W,104,5,105);
  ev_teach(W,101,9,102); ev_teach(W,102,9,103); ev_teach(W,103,9,104);
  let z:i32=ev_query_ap(W,AP,101,70,105,0);
  emit("S2D-ANS="); e64(z); emit("\n");
  if(z==105){emit("S2D-RESULT=PASS\n");} else {emit("S2D-RESULT=FAIL\n");}
  return;
}

// ---- S2E: T4 partial applicability, applicable fragment deep ----
// X plen-4 r1; D1 plen-4 r7; D2 plen-4 r8. Sub-fragment marks
// seeded DECOYS-FIRST: (m_d1,0,3), (m_d2,0,3), then the applicable
// (m_x,0,3). Z needs exactly 3 r1 steps (101->104).
fn s2e_test(W:[]u8)void {
  emit("=== S2E-DEEP-FRAGMENT ===\n");
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  ev_teach(W,13,1,14); ev_teach(W,14,1,15);
  let qx:i32=ev_query_ap(W,AP,11,71,15,0);
  let mx:i32=cb_newest_map(W);
  ev_teach(W,41,7,42); ev_teach(W,42,7,43);
  ev_teach(W,43,7,44); ev_teach(W,44,7,45);
  let q1:i32=ev_query_ap(W,AP,41,77,45,0);
  let md1:i32=cb_newest_map(W);
  ev_teach(W,51,8,52); ev_teach(W,52,8,53);
  ev_teach(W,53,8,54); ev_teach(W,54,8,55);
  let q2:i32=ev_query_ap(W,AP,51,78,55,0);
  let md2:i32=cb_newest_map(W);
  emit("S2E mx="); e64(mx); emit(" md1="); e64(md1); emit(" md2="); e64(md2);
  emit(" maps="); e64(s2_nmaps(W)); emit("\n");
  let e1:i32=s2_seed(W,md1,0,3);
  let e2:i32=s2_seed(W,md2,0,3);
  let e3:i32=s2_seed(W,mx,0,3);
  s2_gap(W);
  ev_teach(W,101,1,102); ev_teach(W,102,1,103); ev_teach(W,103,1,104);
  let z:i32=ev_query_ap(W,AP,101,70,104,0);
  emit("S2E-ANS="); e64(z); emit("\n");
  if(z==104){emit("S2E-RESULT=PASS\n");} else {emit("S2E-RESULT=FAIL\n");}
  return;
}

// ---- S2F: fabricated AP evidence vs the gate's withhold ----
// Clean single-segment world (W plen-2 r9, Z 101->103). After the
// Z facts are taught, the driver fabricates 2 FAILURE records at
// the exact (F(101,70), shape 2), then runs the Z query. The gate
// must decide on fabricated evidence it cannot distinguish from
// earned records.
fn s2f_test(W:[]u8)void {
  emit("=== S2F-FABRICATED-EVIDENCE ===\n");
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  ev_teach(W,31,9,32); ev_teach(W,32,9,33);
  let qw:i32=ev_query_ap(W,AP,31,73,33,0);
  let mw:i32=cb_newest_map(W);
  emit("S2F train qw="); e64(qw); emit(" mw="); e64(mw);
  emit(" maps="); e64(s2_nmaps(W)); emit("\n");
  ev_teach(W,101,9,102); ev_teach(W,102,9,103);
  s2_fab_fail(W,AP,101,70,2,2);
  // Direct compose_try call (H-COMPVER-1 precedent): ev_query_ap's
  // rebind_try would answer this single-segment query without ever
  // reaching composition. The unit under seal is compose_try.
  let st:[]u8=z_alloc(8);
  let z:i32=compose_try(W,AP,101,70,103,0,st);
  emit("S2F-ANS="); e64(z); emit("\n");
  if(z==103){emit("S2F-RESULT=PASS\n");} else {emit("S2F-RESULT=FAIL\n");}
  return;
}

// ---- S2G: 32-candidate cap exhaustion ----
// 32 decoy MAPs (r7, plen-2) trained first. The winner W (r9,
// plen-3) is trained LAST via a query the decoys cannot compose
// (their 2-edge fallback hops dead-end on the 3-edge training
// chain), so the trial promotes it and its mark is auto-created
// at the Z query, i.e. LAST in edge-id order. Z is 3 edges
// (101->104): at the 101 enumeration the 32 decoys
// fallback-satisfy and fill the 32-candidate truncation, so the
// winner is never evaluated. Decoys hop 101->103 then dead-end
// (only 1 edge remains), so no alternative route exists.
fn s2g_test(W:[]u8)void {
  emit("=== S2G-CAP-EXHAUSTION ===\n");
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  let i:i32=0;
  while(i<32){
    let b:i32=41+10*i;
    ev_teach(W,b,7,b+1); ev_teach(W,b+1,7,b+2);
    let q:i32=ev_query_ap(W,AP,b,71+i,b+2,0);
    i=i+1;
  }
  emit("S2G decoys trained maps="); e64(s2_nmaps(W)); emit("\n");
  ev_teach(W,501,9,502); ev_teach(W,502,9,503); ev_teach(W,503,9,504);
  let wq:i32=ev_query_ap(W,AP,501,110,504,0);
  let mw:i32=cb_newest_map(W);
  emit("S2G-W wq="); e64(wq); emit(" mw="); e64(mw);
  emit(" clen="); e64(cl_chain_len(W,mw));
  emit(" maps="); e64(s2_nmaps(W)); emit("\n");
  ev_teach(W,101,9,102); ev_teach(W,102,9,103); ev_teach(W,103,9,104);
  // Direct compose_try call: rebind_try would rebind the plen-3
  // winner MAP and bypass composition. The unit under seal is
  // compose_try.
  let st:[]u8=z_alloc(8);
  let z:i32=compose_try(W,AP,101,70,104,0,st);
  emit("S2G-ANS="); e64(z); emit("\n");
  if(z==104){emit("S2G-RESULT=PASS\n");} else {emit("S2G-RESULT=FAIL\n");}
  return;
}

// ---- S2H: fragment reuse forbidden ----
// Z needs X's fragment twice (101->103, 103->105). The per-path
// (m,start,len) reuse exclusion forbids the second use.
fn s2h_test(W:[]u8)void {
  emit("=== S2H-REUSE-FORBIDDEN ===\n");
  let AP:[]u8=z_alloc(4096); pap_init(AP);
  ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let qx:i32=ev_query_ap(W,AP,11,71,13,0);
  let mx:i32=cb_newest_map(W);
  emit("S2H train qx="); e64(qx); emit(" mx="); e64(mx);
  emit(" maps="); e64(s2_nmaps(W)); emit("\n");
  ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  ev_teach(W,103,1,104); ev_teach(W,104,1,105);
  // Direct compose_try call: ev_query_ap's trial stage would
  // answer after composition fails, masking the composition
  // verdict. The unit under seal is compose_try.
  let st:[]u8=z_alloc(8);
  let z:i32=compose_try(W,AP,101,70,105,0,st);
  emit("S2H-ANS="); e64(z); emit("\n");
  if(z==105){emit("S2H-RESULT=PASS\n");} else {emit("S2H-RESULT=FAIL\n");}
  return;
}

fn main()i32 {
  emit("S2-SEAL-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1); s2a_test(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2); s2b_test(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3); s2b0_test(W3);
  let W4:[]u8=z_alloc(110656); tnn2_init(W4); s2c0_test(W4);
  let W5:[]u8=z_alloc(110656); tnn2_init(W5); s2c_test(W5);
  let W6:[]u8=z_alloc(110656); tnn2_init(W6); s2d_test(W6);
  let W7:[]u8=z_alloc(110656); tnn2_init(W7); s2e_test(W7);
  let W8:[]u8=z_alloc(110656); tnn2_init(W8); s2f_test(W8);
  let W9:[]u8=z_alloc(110656); tnn2_init(W9); s2g_test(W9);
  let W10:[]u8=z_alloc(110656); tnn2_init(W10); s2h_test(W10);
  emit("S2-SEAL-END\n");
  return 0;
}

// cogop.zag -- Cognitive Operation Invention worker.
// Frozen basis: 4-op ISA (MOVE/INC/DEC/BEQ) + CALL (EXECUTE-equivalent
// invocation machinery, generic and task-independent) + RET.
// The learner invents OP_ADD, OP_MUL, OP_POW by systematic trial over a
// generic REPEAT form, promotes each to a persistent op inventory with a
// contract, and reuses each invented op as an opaque primitive for the
// next invention. Pure Zag. No RNG. Fully deterministic.
//
// Memory map (M, u8-backed):
//   0     REGS      8 x i64
//   64    VSTACK    16 x 8 x i64 (call save area)
//   1088  SCR       scratch graph (12 instr x 5 fields x i32)
//   1328  INV       4 graphs x 240 bytes
//   2288  ILEN      4 x i32 (graph lengths)
//   2304  NOPS      i32 (promoted op count)
//   2308  CDEPTH    i32 (call depth)
//   2312  TA        30 x i32   2432 TB   2552 TE
//   2672  PA        18 x i32   2744 PB   2816 PE
//   2888  FOUND     6 x i32 (P,slen,s0,s1,K,nlen)
//   2912  TRIED     i32
//   2916  SOK       3 x i32 (per-stage ok)
// Graph layout: field f of instr i at base + f*48 + i*4 (12 instr max).

// ============ emit helpers (single buffer, cursor-returning) ============
fn e1str(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){b[c]=s[i];c=c+1;i=i+1;}
  return c;
}
fn e1i64(b:[]u8,c:i32,v:i64)i32 {
  if(v==0){b[c]=48;return c+1;}
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=0-v;}
  let nd:i32=0;
  let t:i64=u;
  while(t>0){nd=nd+1;t=t/10;}
  if(neg==1){b[c]=45;c=c+1;}
  let e:i32=c+nd;
  let p:i32=e-1;
  while(p>=c){
    let d:i64=u-(u/10)*10;
    b[p]=(48+d) as u8;
    u=u/10;
    p=p-1;
  }
  return e;
}
// ============ u8-backed cells ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn get64(b:[]u8,off:i32)i64 {
  let v:i64=0;
  let i:i32=0;
  while(i<8){ v=v+((b[off+i] as i64)<<(i*8)); i=i+1; }
  return v;
}
fn set64(b:[]u8,off:i32,v:i64)void {
  let i:i32=0;
  while(i<8){ b[off+i]=(v>>(i*8)) as u8; i=i+1; }
  return;
}
// ============ registers ============
fn rget(M:[]u8,r:i32)i64 { return get64(M,r*8); }
fn rset(M:[]u8,r:i32,v:i64)void { set64(M,r*8,v); return; }
fn setup_regs(M:[]u8,a:i64,b:i64)void {
  rset(M,0,a); rset(M,1,b);
  let r:i32=2;
  while(r<8){ rset(M,r,0); r=r+1; }
  return;
}
fn gclear(M:[]u8,base:i32)void {
  let i:i32=0;
  while(i<60){ set32(M,base+i*4,0); i=i+1; }
  return;
}
// ============ frozen interpreter ============
// op=1 MOVE(d,src,okind) op=2 INC(r) op=3 DEC(r)
// op=4 BEQ(r1,op2,okind,target) op=5 CALL(h) op=6 RET
// okind 0 = register operand, 1 = immediate operand.
fn xexec(M:[]u8,base:i32,n:i32)i32 {
  let pc:i32=0;
  let steps:i32=0;
  while(steps<20000){
    if(pc>=n){ return 1; }
    let op:i32=get32(M,base+0*48+pc*4);
    if(op==1){
      let d:i32=get32(M,base+1*48+pc*4);
      let s:i32=get32(M,base+2*48+pc*4);
      let k:i32=get32(M,base+3*48+pc*4);
      let v:i64=s as i64;
      if(k==0){ v=rget(M,s); }
      rset(M,d,v); pc=pc+1;
    } else { if(op==2){
      let r:i32=get32(M,base+1*48+pc*4);
      rset(M,r,rget(M,r)+1); pc=pc+1;
    } else { if(op==3){
      let r2:i32=get32(M,base+1*48+pc*4);
      rset(M,r2,rget(M,r2)-1); pc=pc+1;
    } else { if(op==4){
      let r1:i32=get32(M,base+1*48+pc*4);
      let o2:i32=get32(M,base+2*48+pc*4);
      let k2:i32=get32(M,base+3*48+pc*4);
      let tgt:i32=get32(M,base+4*48+pc*4);
      let v1:i64=rget(M,r1);
      let v2:i64=o2 as i64;
      if(k2==0){ v2=rget(M,o2); }
      if(v1==v2){ pc=tgt; } else { pc=pc+1; }
    } else { if(op==5){
      let h:i32=get32(M,base+1*48+pc*4);
      let nops:i32=get32(M,2304);
      let dep:i32=get32(M,2308);
      if(h<0 || h>=nops || dep>=16){ return 0; }
      let sp:i32=64+dep*64;
      let r3:i32=0;
      while(r3<8){ set64(M,sp+r3*8,rget(M,r3)); r3=r3+1; }
      set32(M,2308,dep+1);
      let ok:i32=xexec(M,1328+h*240,get32(M,2288+h*4));
      let res:i64=rget(M,0);
      r3=0;
      while(r3<8){ rset(M,r3,get64(M,sp+r3*8)); r3=r3+1; }
      set32(M,2308,dep);
      if(ok!=1){ return 0; }
      rset(M,0,res);
      pc=pc+1;
    } else { if(op==6){
      return 1;
    } else { return 0; } } } } } }
    steps=steps+1;
  }
  return 0;
}
// Run one pair on a graph; result or -999999 on any failure.
fn run_pair(M:[]u8,base:i32,n:i32,a:i64,b:i64)i64 {
  setup_regs(M,a,b);
  if(xexec(M,base,n)!=1){ return -999999; }
  if(rget(M,6)!=0){ return -999999; }
  return rget(M,0);
}
// ============ synthesis instruction set ============
// idx 0..3 INC r | 4..7 DEC r | 8..23 MOVE d,s | 24..39 MOVE d,#i | 40.. CALL h
fn instr_emit(M:[]u8,base:i32,pos:i32,idx:i32)void {
  if(idx<4){
    set32(M,base+0*48+pos*4,2); set32(M,base+1*48+pos*4,idx);
  } else { if(idx<8){
    set32(M,base+0*48+pos*4,3); set32(M,base+1*48+pos*4,idx-4);
  } else { if(idx<24){
    let q:i32=idx-8; let d:i32=q/4;
    set32(M,base+0*48+pos*4,1); set32(M,base+1*48+pos*4,d);
    set32(M,base+2*48+pos*4,q-d*4); set32(M,base+3*48+pos*4,0);
  } else { if(idx<40){
    let q2:i32=idx-24; let d2:i32=q2/4;
    set32(M,base+0*48+pos*4,1); set32(M,base+1*48+pos*4,d2);
    set32(M,base+2*48+pos*4,q2-d2*4); set32(M,base+3*48+pos*4,1);
  } else {
    set32(M,base+0*48+pos*4,5); set32(M,base+1*48+pos*4,idx-40);
  } } } }
  return;
}
// Generic frame prologues: save inputs x accumulator init.
fn prologue_emit(M:[]u8,base:i32,pos:i32,P:i32)i32 {
  if(P>=3){
    set32(M,base+0*48+pos*4,1); set32(M,base+1*48+pos*4,3);
    set32(M,base+2*48+pos*4,0); set32(M,base+3*48+pos*4,0); pos=pos+1;
    set32(M,base+0*48+pos*4,1); set32(M,base+1*48+pos*4,4);
    set32(M,base+2*48+pos*4,1); set32(M,base+3*48+pos*4,0); pos=pos+1;
  }
  if(P==1 || P==4){
    set32(M,base+0*48+pos*4,1); set32(M,base+1*48+pos*4,0);
    set32(M,base+2*48+pos*4,0); set32(M,base+3*48+pos*4,1); pos=pos+1;
  }
  if(P==2 || P==5){
    set32(M,base+0*48+pos*4,1); set32(M,base+1*48+pos*4,0);
    set32(M,base+2*48+pos*4,1); set32(M,base+3*48+pos*4,1); pos=pos+1;
  }
  return pos;
}
// Compile the generic REPEAT form into SCR(1088); return length.
fn compile_loop(M:[]u8,P:i32,s0:i32,s1:i32,slen:i32,K:i32,ncall:i32)i32 {
  let base:i32=1088;
  gclear(M,base);
  let pos:i32=prologue_emit(M,base,0,P);
  set32(M,base+0*48+pos*4,1); set32(M,base+1*48+pos*4,5);
  set32(M,base+2*48+pos*4,K); set32(M,base+3*48+pos*4,0);
  pos=pos+1;
  let lh:i32=pos;
  set32(M,base+0*48+pos*4,4); set32(M,base+1*48+pos*4,5);
  set32(M,base+2*48+pos*4,0); set32(M,base+3*48+pos*4,1);
  set32(M,base+4*48+pos*4,-1);
  pos=pos+1;
  instr_emit(M,base,pos,s0); pos=pos+1;
  if(slen>1){ instr_emit(M,base,pos,s1); pos=pos+1; }
  set32(M,base+0*48+pos*4,3); set32(M,base+1*48+pos*4,5); pos=pos+1;
  set32(M,base+0*48+pos*4,4); set32(M,base+1*48+pos*4,6);
  set32(M,base+2*48+pos*4,0); set32(M,base+3*48+pos*4,1);
  set32(M,base+4*48+pos*4,lh); pos=pos+1;
  let le:i32=pos;
  set32(M,base+0*48+pos*4,6); pos=pos+1;
  set32(M,base+4*48+lh*4,le);
  return pos;
}
// ============ learner: planner ============
fn body_ok(M:[]u8,stage:i32,base:i32,n:i32)i32 {
  let i:i32=0;
  while(i<10){
    let a:i64=get32(M,2312+(stage*10+i)*4) as i64;
    let b:i64=get32(M,2432+(stage*10+i)*4) as i64;
    let e:i64=get32(M,2552+(stage*10+i)*4) as i64;
    if(run_pair(M,base,n,a,b)!=e){ return 0; }
    i=i+1;
  }
  return 1;
}
fn planner_search(M:[]u8,stage:i32,ncall:i32)i32 {
  let per:i32=40+ncall;
  let tried:i32=0;
  let i0:i32=0;
  while(i0<per){
    tried=tried+1;
    gclear(M,1088); instr_emit(M,1088,0,i0);
    if(body_ok(M,stage,1088,1)!=0){ set32(M,2912,tried); return 1; }
    i0=i0+1;
  }
  i0=0;
  while(i0<per){
    let i1:i32=0;
    while(i1<per){
      tried=tried+1;
      gclear(M,1088);
      instr_emit(M,1088,0,i0); instr_emit(M,1088,1,i1);
      if(body_ok(M,stage,1088,2)!=0){ set32(M,2912,tried); return 1; }
      i1=i1+1;
    }
    i0=i0+1;
  }
  i0=0;
  while(i0<per){
    let i1b:i32=0;
    while(i1b<per){
      let i2:i32=0;
      while(i2<per){
        tried=tried+1;
        gclear(M,1088);
        instr_emit(M,1088,0,i0);
        instr_emit(M,1088,1,i1b);
        instr_emit(M,1088,2,i2);
        if(body_ok(M,stage,1088,3)!=0){ set32(M,2912,tried); return 1; }
        i2=i2+1;
      }
      i1b=i1b+1;
    }
    i0=i0+1;
  }
  set32(M,2912,tried);
  return 0;
}
// ============ learner: constructor ============
fn cand_ok(M:[]u8,stage:i32,base:i32,n:i32,which:i32)i32 {
  let np:i32=10;
  let ao:i32=2312; let bo:i32=2432; let eo:i32=2552;
  if(which==1){ np=6; ao=2672; bo=2744; eo=2816; }
  let i:i32=0;
  while(i<np){
    let a:i64=get32(M,ao+(stage*10+i)*4) as i64;
    let b:i64=get32(M,bo+(stage*10+i)*4) as i64;
    let e:i64=get32(M,eo+(stage*10+i)*4) as i64;
    if(which==1){
      a=get32(M,ao+(stage*6+i)*4) as i64;
      b=get32(M,bo+(stage*6+i)*4) as i64;
      e=get32(M,eo+(stage*6+i)*4) as i64;
    }
    if(run_pair(M,base,n,a,b)!=e){ return 0; }
    i=i+1;
  }
  return 1;
}
fn try_cand(M:[]u8,stage:i32,P:i32,s0:i32,s1:i32,slen:i32,K:i32,ncall:i32)i32 {
  set32(M,2912,get32(M,2912)+1);
  let n:i32=compile_loop(M,P,s0,s1,slen,K,ncall);
  if(cand_ok(M,stage,1088,n,0)==0){ return 0; }
  if(cand_ok(M,stage,1088,n,1)==0){ return 0; }
  set32(M,2888,P); set32(M,2892,slen); set32(M,2896,s0);
  set32(M,2900,s1); set32(M,2904,K); set32(M,2908,n);
  return 1;
}
fn construct(M:[]u8,stage:i32,ncall:i32)i32 {
  let per:i32=40+ncall;
  set32(M,2912,0);
  let P:i32=0;
  while(P<6){
    let slen:i32=1;
    while(slen<3){
      if(slen==1){
        let i0:i32=0;
        while(i0<per){
          let K:i32=0;
          while(K<6){
            if(try_cand(M,stage,P,i0,0,1,K,ncall)!=0){ return 1; }
            K=K+1;
          }
          i0=i0+1;
        }
      } else {
        let j0:i32=0;
        while(j0<per){
          let j1:i32=0;
          while(j1<per){
            let K2:i32=0;
            while(K2<6){
              if(try_cand(M,stage,P,j0,j1,2,K2,ncall)!=0){ return 1; }
              K2=K2+1;
            }
            j1=j1+1;
          }
          j0=j0+1;
        }
      }
      slen=slen+1;
    }
    P=P+1;
  }
  return 0;
}
fn promote_op(M:[]u8,n:i32)i32 {
  let h:i32=get32(M,2304);
  if(h>=4){ return -1; }
  let dst:i32=1328+h*240;
  let i:i32=0;
  while(i<60){ set32(M,dst+i*4,get32(M,1088+i*4)); i=i+1; }
  set32(M,2288+h*4,n);
  set32(M,2304,h+1);
  return h;
}
// Print one synthesis instruction index.
fn e1stepidx(B:[]u8,c:i32,idx:i32)i32 {
  if(idx<4){ c=e1str(B,c,"INC R"); c=e1i64(B,c,idx as i64); }
  else { if(idx<8){ c=e1str(B,c,"DEC R"); c=e1i64(B,c,(idx-4) as i64); }
  else { if(idx<24){
    let q:i32=idx-8;
    c=e1str(B,c,"MOVE R"); c=e1i64(B,c,(q/4) as i64);
    c=e1str(B,c," R"); c=e1i64(B,c,(q-(q/4)*4) as i64);
  } else { if(idx<40){
    let q2:i32=idx-24;
    c=e1str(B,c,"MOVE R"); c=e1i64(B,c,(q2/4) as i64);
    c=e1str(B,c," #"); c=e1i64(B,c,(q2-(q2/4)*4) as i64);
  } else { c=e1str(B,c,"CALL "); c=e1i64(B,c,(idx-40) as i64); } } } }
  return c;
}

// === DRIVER ===
// World truth. Learner code above never calls these.
fn world_add(a:i64,b:i64)i64 { return a+b; }
fn world_mul(a:i64,b:i64)i64 { return a*b; }
fn world_pow(a:i64,b:i64)i64 {
  let r:i64=1;
  let i:i64=0;
  while(i<b){ r=r*a; i=i+1; }
  return r;
}
fn world_for(stage:i32,a:i64,b:i64)i64 {
  if(stage==0){ return world_add(a,b); }
  if(stage==1){ return world_mul(a,b); }
  return world_pow(a,b);
}
fn tpair(M:[]u8,stage:i32,i:i32,a:i32,b:i32)void {
  set32(M,2312+(stage*10+i)*4,a);
  set32(M,2432+(stage*10+i)*4,b);
  set32(M,2552+(stage*10+i)*4,world_for(stage,a as i64,b as i64) as i32);
  return;
}
fn ppair(M:[]u8,stage:i32,i:i32,a:i32,b:i32)void {
  set32(M,2672+(stage*6+i)*4,a);
  set32(M,2744+(stage*6+i)*4,b);
  set32(M,2816+(stage*6+i)*4,world_for(stage,a as i64,b as i64) as i32);
  return;
}
fn init_pairs(M:[]u8)void {
  tpair(M,0,0,0,0); tpair(M,0,1,0,1); tpair(M,0,2,1,0); tpair(M,0,3,2,3);
  tpair(M,0,4,5,7); tpair(M,0,5,8,8); tpair(M,0,6,13,4); tpair(M,0,7,16,16);
  tpair(M,0,8,11,2); tpair(M,0,9,6,15);
  tpair(M,1,0,0,0); tpair(M,1,1,0,7); tpair(M,1,2,1,9); tpair(M,1,3,2,3);
  tpair(M,1,4,3,4); tpair(M,1,5,5,5); tpair(M,1,6,6,7); tpair(M,1,7,10,10);
  tpair(M,1,8,12,8); tpair(M,1,9,16,16);
  tpair(M,2,0,0,0); tpair(M,2,1,0,1); tpair(M,2,2,0,3); tpair(M,2,3,1,4);
  tpair(M,2,4,2,3); tpair(M,2,5,3,2); tpair(M,2,6,4,2); tpair(M,2,7,2,4);
  tpair(M,2,8,3,3); tpair(M,2,9,4,4);
  ppair(M,0,0,3,9); ppair(M,0,1,10,10); ppair(M,0,2,15,1); ppair(M,0,3,4,12);
  ppair(M,0,4,9,6); ppair(M,0,5,14,14);
  ppair(M,1,0,2,9); ppair(M,1,1,4,6); ppair(M,1,2,7,7); ppair(M,1,3,9,11);
  ppair(M,1,4,13,13); ppair(M,1,5,15,3);
  ppair(M,2,0,1,0); ppair(M,2,1,2,0); ppair(M,2,2,2,2); ppair(M,2,3,3,1);
  ppair(M,2,4,4,3); ppair(M,2,5,0,2);
  return;
}
fn grid_total(stage:i32)i32 {
  if(stage==2){ return 25; }
  return 289;
}
// Grid validation through the CALL path: build [CALL h; RET], run grid.
fn grid_check(M:[]u8,stage:i32,h:i32)i32 {
  gclear(M,1088);
  set32(M,1088+0*48+0*4,5); set32(M,1088+1*48+0*4,h);
  set32(M,1088+0*48+1*4,6);
  let lim:i64=16;
  if(stage==2){ lim=4; }
  let ok:i32=0;
  let a:i64=0;
  while(a<=lim){
    let b:i64=0;
    while(b<=lim){
      if(run_pair(M,1088,2,a,b)==world_for(stage,a,b)){ ok=ok+1; }
      b=b+1;
    }
    a=a+1;
  }
  return ok;
}
// Post-invention: single-instruction planner body [CALL h] on train pairs.
fn singlecall_check(M:[]u8,stage:i32,h:i32)i32 {
  gclear(M,1088);
  set32(M,1088+0*48+0*4,5); set32(M,1088+1*48+0*4,h);
  return body_ok(M,stage,1088,1)*10;
}
// One full stage: baseline, invention, promotion, validation.
fn do_stage(M:[]u8,B:[]u8,c:i32,stage:i32,tname:[]u8,vname:[]u8,oname:[]u8,claw:[]u8,needcall:i32)i32 {
  let ncall:i32=get32(M,2304);
  c=e1str(B,c,"STAGE "); c=e1i64(B,c,stage as i64+1);
  c=e1str(B,c," task="); c=e1str(B,c,tname);
  c=e1str(B,c," vocab="); c=e1str(B,c,vname); c=e1str(B,c,"\n");
  let ok:i32=1;
  let pf:i32=planner_search(M,stage,ncall);
  let pt:i32=get32(M,2912);
  c=e1str(B,c,"PLANNER tried="); c=e1i64(B,c,pt as i64);
  c=e1str(B,c," found="); c=e1i64(B,c,pf as i64);
  c=e1str(B,c," maxlen=3\n");
  if(pf!=0){ ok=0; }
  let cf:i32=construct(M,stage,ncall);
  let ct:i32=get32(M,2912);
  c=e1str(B,c,"CONSTRUCT tried="); c=e1i64(B,c,ct as i64);
  c=e1str(B,c," found="); c=e1i64(B,c,cf as i64);
  if(cf!=1){ ok=0; }
  if(cf==1){
    let fP:i32=get32(M,2888); let fsl:i32=get32(M,2892);
    let fs0:i32=get32(M,2896); let fs1:i32=get32(M,2900);
    let fK:i32=get32(M,2904); let fnl:i32=get32(M,2908);
    c=e1str(B,c," prologue=P"); c=e1i64(B,c,fP as i64);
    c=e1str(B,c," step=["); c=e1stepidx(B,c,fs0);
    if(fsl>1){ c=e1str(B,c,"; "); c=e1stepidx(B,c,fs1); }
    c=e1str(B,c,"] kreg=R"); c=e1i64(B,c,fK as i64);
    c=e1str(B,c," graphlen="); c=e1i64(B,c,fnl as i64); c=e1str(B,c,"\n");
    // N4: found step must reuse the needed earlier op opaquely.
    let uses:i32=0;
    if(needcall>=0){
      if(fs0==40+needcall){ uses=1; }
      if(fsl>1 && fs1==40+needcall){ uses=1; }
      if(uses!=1){ ok=0; }
    }
    let tr:i32=cand_ok(M,stage,1088,fnl,0)*10;
    let pr:i32=cand_ok(M,stage,1088,fnl,1)*6;
    c=e1str(B,c,"TRAIN "); c=e1i64(B,c,tr as i64);
    c=e1str(B,c,"/10 PROBE "); c=e1i64(B,c,pr as i64); c=e1str(B,c,"/6\n");
    if(tr!=10 || pr!=6){ ok=0; }
    let h:i32=promote_op(M,fnl);
    c=e1str(B,c,"PROMOTE handle="); c=e1i64(B,c,h as i64);
    c=e1str(B,c," name="); c=e1str(B,c,oname);
    c=e1str(B,c," contract="); c=e1str(B,c,claw); c=e1str(B,c,"\n");
    let g:i32=grid_check(M,stage,h);
    let gt:i32=grid_total(stage);
    c=e1str(B,c,"GRID "); c=e1i64(B,c,g as i64);
    c=e1str(B,c,"/"); c=e1i64(B,c,gt as i64); c=e1str(B,c,"\n");
    if(g!=gt){ ok=0; }
    let sc:i32=singlecall_check(M,stage,h);
    c=e1str(B,c,"SINGLECALL "); c=e1i64(B,c,sc as i64); c=e1str(B,c,"/10\n");
    if(sc!=10){ ok=0; }
    if(needcall>=0 && uses!=1){
      c=e1str(B,c,"REUSE-CHECK FAIL\n");
    }
  }
  set32(M,2916+stage*4,ok);
  return c;
}
fn main()void {
  let M:[]u8=z_alloc(32768);
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  c=e1str(B,c,"COGOP-INVENTION frozen-isa=MOVE,INC,DEC,BEQ,CALL,RET regs=R0..R7\n");
  init_pairs(M);
  c=do_stage(M,B,c,0,"ADD","basis","OP_ADD","ADD(a,b)=a+b domain=N^2",-1);
  c=do_stage(M,B,c,1,"MUL","basis+CALL0","OP_MUL","MUL(a,b)=a*b domain=N^2",0);
  c=do_stage(M,B,c,2,"POW","basis+CALL0+CALL1","OP_POW","POW(a,b)=a^b,0^0=1 domain=N^2",1);
  // ABLATION-A: MUL invention with OP_ADD removed from the inventory.
  c=e1str(B,c,"ABLATION-A task=MUL vocab=basis-only\n");
  let af:i32=construct(M,1,0);
  let at:i32=get32(M,2912);
  c=e1str(B,c,"CONSTRUCT tried="); c=e1i64(B,c,at as i64);
  c=e1str(B,c," found="); c=e1i64(B,c,af as i64);
  if(af==0){ c=e1str(B,c," INVENTION-FAIL\n"); } else { c=e1str(B,c," UNEXPECTED-PASS\n"); }
  // ABLATION-B: POW invention with OP_MUL removed (OP_ADD kept).
  c=e1str(B,c,"ABLATION-B task=POW vocab=basis+CALL0\n");
  let bf:i32=construct(M,2,1);
  let bt:i32=get32(M,2912);
  c=e1str(B,c,"CONSTRUCT tried="); c=e1i64(B,c,bt as i64);
  c=e1str(B,c," found="); c=e1i64(B,c,bf as i64);
  if(bf==0){ c=e1str(B,c," INVENTION-FAIL\n"); } else { c=e1str(B,c," UNEXPECTED-PASS\n"); }
  let ok:i32=1;
  if(get32(M,2916)!=1){ ok=0; }
  if(get32(M,2920)!=1){ ok=0; }
  if(get32(M,2924)!=1){ ok=0; }
  if(af!=0){ ok=0; }
  if(bf!=0){ ok=0; }
  // Inventory must hold exactly the three invented ops, in order.
  if(get32(M,2304)!=3){ ok=0; }
  c=e1str(B,c,"INVENTORY-OPS "); c=e1i64(B,c,get32(M,2304) as i64); c=e1str(B,c,"\n");
  if(ok==1){
    c=e1str(B,c,"VERDICT COGOP-INVENTION-COMPLETE\n");
  } else {
    c=e1str(B,c,"VERDICT COGOP-INVENTION-INCOMPLETE\n");
  }
  let _w:i64=_zag_raw_syscall(1,1,(_zag_slice_ptr(B) as i64),c as i64,0,0,0);
  return;
}

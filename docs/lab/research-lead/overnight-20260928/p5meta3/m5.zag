// P5-meta3 -- does prior experience change how future LEARNING occurs?
// Prereg: p5meta3/PREREG.md. Scorer: score53.py (independent).
//
// Inherited failure diagnosed: lifetime_metalearn's B5d compared error on
// episode 3 with error on episode 12 -- DIFFERENT tasks -- so the bar
// measured task difficulty, not learning-to-learn. Here the measured
// quantity is ACQUISITION COST WITHIN ONE FAMILY, family held constant.
//
// SUBSTRATE: generic associative learner over opaque (query,answer) pairs.
// State is deliberately split so the critical bar is testable:
//   FACTS  retained (query,answer) pairs           <- "what"
//   MACH   learned slot structure + coefficients    <- "how"
// META_ABLATED keeps FACTS and zeroes MACH: any speedup it retains is a
// cache; any speedup it loses was learned machinery.
//
// NO strategy menu, no modes, no routers, no family index in any learner
// fn, no domain names.
//
// Output: raw acquisition costs + FP fingerprints. No *_ok flags.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0; while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8;b[o+1]=(v>>8) as u8;b[o+2]=(v>>16) as u8;b[o+3]=(v>>24) as u8;return;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 { let i:i32=0; while(i<s.len){b[c+i]=s[i];i=i+1;} return c+s.len; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let ng:i32=0; let x:i64=v; if(x<0){ng=1;x=0-x;}
  let n:i32=1; let t:i64=x; while(t>=10){t=t/10;n=n+1;}
  let e:i32=c+ng+n; let p:i32=e-1; let y:i64=x;
  if(y==0){b[p]=48;}
  while(y>0){b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1;}
  if(ng==1){b[c]=45;} return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

fn NQ()i32 { return 12; }
fn QT()i32 { return 40; }
fn CRIT()i32 { return 3; }
fn NFAM()i32 { return 4; }
fn MAXF()i32 { return 80; }
fn MAXM()i32 { return 96; }
fn NARM()i32 { return 6; }

// ---------- families: affine over two query slots ----------
// fam 0: (a,b,c,d,e) = (1,1,3,7,0)   fam 1: (2,1,1,5,1)
// fam 2: (1,2,5,11,2)                fam 3: (3,1,2,13,4)
// MISLEADING prior uses fam 1 with answers SHIFTED by +1 so the surface
// form is identical but the mapping conflicts.
fn fa(fam:i32)i32 {
  if(fam==0){ return 1; }
  if(fam==1){ return 2; }
  if(fam==2){ return 1; }
  return 3;
}
fn fb(fam:i32)i32 {
  if(fam==0){ return 1; }
  if(fam==1){ return 1; }
  if(fam==2){ return 2; }
  return 1;
}
fn fc(fam:i32)i32 {
  if(fam==0){ return 3; }
  if(fam==1){ return 1; }
  if(fam==2){ return 5; }
  return 2;
}
fn fd(fam:i32)i32 {
  if(fam==0){ return 7; }
  if(fam==1){ return 5; }
  if(fam==2){ return 11; }
  return 13;
}
fn fe(fam:i32)i32 {
  if(fam==0){ return 0; }
  if(fam==1){ return 1; }
  if(fam==2){ return 2; }
  return 4;
}
// true answer for family fam at query q
fn fam_ans(fam:i32,q:i32)i32 {
  let v:i32=(fa(fam)*q0(q)+fb(fam)*q1(q)+fc(fam))%fd(fam);
  return v+fe(fam);
}
// a CONFLICTING mapping with the same surface form (misleading prior)
fn fam_ans_shift(fam:i32,q:i32)i32 { return fam_ans(fam,q)+1; }

fn q0(q:i32)i32 { return (q*7)%31; }
fn q1(q:i32)i32 { return (q*13)%29; }

// ---------- generic learner ----------
// predict: if MACH has a candidate mapping, apply it; else use FACTS lookup;
// else fall back to a running base rate. The learner never sees `fam`.
// FACTS layout: 4 ints per fact [q0, q1, ans, count]
// MACH  layout: 6 ints per candidate machine [a, b, c, d, e, support]
//             slot 0..3 = candidate machines, slot 4 = running base rate
// The learner NEVER receives `fam`; it only sees (q, observed answer) pairs.
fn predict(FACTS:[]u8,MACH:[]u8,nf:i32,q:i32)i32 {
  // 1. exact fact lookup
  let i:i32=0;
  while(i<nf){
    if(get32(FACTS,i*12)==q0(q)){
      if(get32(FACTS,i*12+4)==q1(q)){ return get32(FACTS,i*12+8); }
    }
    i=i+1;
  }
  // 2. learned machines, most-supported first
  let m:i32=0;
  while(m<4){
    if(get32(MACH,m*24+20)>0){
      let v:i32=(get32(MACH,m*24)*q0(q)+get32(MACH,m*24+4)*q1(q)+get32(MACH,m*24+8))%get32(MACH,m*24+12);
      return v+get32(MACH,m*24+16);
    }
    m=m+1;
  }
  // 3. base rate
  return get32(MACH,96);
}

// observe one (q, ans): update facts and machines
fn observe(FACTS:[]u8,MACH:[]u8,nf:i32,q:i32,ans:i32)i32 {
  // fact
  let i:i32=0;
  let found:i32=0;
  while(i<nf){
    if(get32(FACTS,i*12)==q0(q)){
      if(get32(FACTS,i*12+4)==q1(q)){
        set32(FACTS,i*12+8,ans);
        set32(FACTS,i*12+12,get32(FACTS,i*12+12)+1);
        found=1;
      }
    }
    i=i+1;
  }
  if(found==0){
    if(nf<MAXF()/4){
      set32(FACTS,nf*12,q0(q));
      set32(FACTS,nf*12+4,q1(q));
      set32(FACTS,nf*12+8,ans);
      set32(FACTS,nf*12+12,1);
      nf=nf+1;
    }
  }
  // machines: fit coefficients by counting, generic (no family index)
  let m:i32=0;
  while(m<4){
    let sup:i32=get32(MACH,m*24+20);
    if(sup>0){
      // does this machine predict ans?
      let v:i32=(get32(MACH,m*24)*q0(q)+get32(MACH,m*24+4)*q1(q)+get32(MACH,m*24+8))%get32(MACH,m*24+12);
      if((v+get32(MACH,m*24+16))==ans){ set32(MACH,m*24+20,sup+1); }
      else { set32(MACH,m*24+20,sup-1); if(get32(MACH,m*24+20)<1){ set32(MACH,m*24+20,1); } }
    }
    m=m+1;
  }
  // first machine bootstraps from the first two observations
  if(get32(MACH,20)<1){
    set32(MACH,0,1); set32(MACH,4,0); set32(MACH,8,ans);
    set32(MACH,12,7); set32(MACH,16,0); set32(MACH,20,1);
  }
  // base rate
  set32(MACH,96,ans);
  return nf;
}

// arms: 0 FRESH 1 RELEVANT 2 IRRELEVANT 3 MISLEADING 4 META_ABLATED 5 ORACLE_META
// which prior family this arm is exposed to before the measured family:
//   0 none | 1 same | 2 different | 3 same-but-conflicting
fn priorKind(a:i32)i32 {
  if(a==0){ return 0; }
  if(a==1){ return 1; }
  if(a==2){ return 2; }
  if(a==3){ return 3; }
  if(a==4){ return 1; }
  return 1;
}


fn main()i32 {
  let ob:[]u8=z_alloc(1<<20);
  let c:i32=0;
  let FACTS:[]u8=z_alloc(MAXF()*4);
  let MACH:[]u8=z_alloc(MAXM()*4);
  let snapF:[]u8=z_alloc(MAXF()*4);
  let snapM:[]u8=z_alloc(MAXM()*4);

  c=o_app(ob,c,"P5META3 RAW v1 nq=12 trials=40 crit=3 fams=4"); c=o_nl(ob,c);

  let a:i32=0;
  while(a<NARM()){
    let fam:i32=0;
    while(fam<NFAM()){
      // ---- reset ----
      let z:i32=0;
      while(z<MAXF()){ set32(FACTS,z*4,0); z=z+1; }
      while(z<MAXM()){ set32(MACH,z*4,0); z=z+1; }
      let nf:i32=0;

      // ---- PRIOR phase ----
      let pk:i32=priorKind(a);
      if(pk!=0){
        let pf:i32=fam;                 // same family
        if(pk==2){ pf=(fam+1)%NFAM(); } // different family
        let pe:i32=0;
        while(pe<QT()){
          let qq:i32=pe%NQ();
          let ans:i32=fam_ans(pf,qq);
          if(pk==3){ ans=fam_ans_shift(pf,qq); }
          nf=observe(FACTS,MACH,nf,qq,ans);
          pe=pe+1;
        }
      }

      // ---- snapshot; META_ABLATED keeps FACTS, zeroes MACH ----
      z=0;
      while(z<MAXF()){ set32(snapF,z*4,get32(FACTS,z*4)); z=z+1; }
      while(z<MAXM()){ set32(snapM,z*4,get32(MACH,z*4)); z=z+1; }
      if(a==4){
        z=0;
        while(z<MAXM()){ set32(MACH,z*4,0); z=z+1; }
      }

      // ---- ACQUISITION phase on the MEASURED family ----
      let acq:i32=-1;
      let run:i32=0;
      let tr:i32=0;
      while(tr<QT()){
        let qq2:i32=tr%NQ();
        let want:i32=fam_ans(fam,qq2);
        let got:i32=predict(FACTS,MACH,nf,qq2);
        if(got==want){ run=run+1; } else { run=0; }
        if(run>=CRIT()){ acq=tr+1; break; }
        nf=observe(FACTS,MACH,nf,qq2,want);
        tr=tr+1;
      }
      if(acq<0){ acq=QT(); }

      // ---- fingerprints: state actually used ----
      let sh:i32=0;
      z=0;
      while(z<MAXF()){ sh=sh+get32(FACTS,z*4)*(z+1); z=z+1; }
      let mh:i32=0;
      z=0;
      while(z<MAXM()){ mh=mh+get32(MACH,z*4)*(z+2); z=z+1; }
      c=o_app(ob,c,"FP exp=p5meta3 regime="); c=o_i64(ob,c,fam as i64);
      c=o_app(ob,c," seed=0 arm="); c=o_i64(ob,c,a as i64);
      c=o_app(ob,c," state="); c=o_i64(ob,c,(sh%9973) as i64);
      c=o_app(ob,c," cfg="); c=o_i64(ob,c,(mh%9973) as i64);
      c=o_app(ob,c," space=1 perm=0");
      c=o_app(ob,c," acq="); c=o_i64(ob,c,acq as i64);
      c=o_app(ob,c," pk="); c=o_i64(ob,c,pk as i64);
      c=o_nl(ob,c);
      fam=fam+1;
    }
    a=a+1;
  }
  _zag_print(ob[0..c]);
  return 0;
}
// ===== PROVENANCE EXPERIMENT DRIVER =====
// Treatment vs control for source-aware bootstrap.
// Both arms have source tags in field 16 (1=OBSERVED, 2=TAUGHT, 3=INFERRED,
// 4=PREDICTED, 5=REVISED). Control uses source-blind bootstrap_miss
// (D1+D2+W3+R1 discount pilot). Treatment uses source-aware bootstrap_miss
// (external-only unanimity and majority; SELF facts do not vote).
//
// Battery 1: Discount replication (contradiction-break Phases 1-5).
// Battery 2: Majority-wrong adversary (Phases 1-3, M1/M2/M4).

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

// Window scan: report idx, s, o, discount, source tag.
fn scan_pv(W:[]u8,p:[]u8,r:i32,round:i32)void {
  let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,12)<=2){
      emit(p); emit(" win r"); e64(round); emit(" p"); e64(cnt);
      emit(" idx"); e64(n); emit(" s"); e64(ng(W,n,20));
      emit(" o"); e64(ng(W,n,28)); emit(" d"); e64(ng(W,n,12));
      emit(" src"); e64(ng(W,n,16)); emit("\n");
      cnt=cnt+1;
    }
    n=n-1;
  }
  emit(p); emit(" wincnt r"); e64(round); emit("="); e64(cnt); emit("\n");
  return;
}

// Count INFERRED (src=3) facts for relation r.
fn count_inferred(W:[]u8,r:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,16)==3){c=c+1;}
    n=n+1;
  }
  return c;
}

fn pv_main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  emit("P BATTERY-1-DISCOUNT-REPLICATION\n");
  // Phase 1: 3 TAUGHT seeds, value 42.
  let g1:i32=ev_teach(W,1001,50,42); rep("P","g1",g1);
  let g2:i32=ev_teach(W,1002,50,42); rep("P","g2",g2);
  let g3:i32=ev_teach(W,1003,50,42); rep("P","g3",g3);
  emit("P g1_src="); e64(ng(W,g1,16)); emit("\n");
  // Phase 2: 4 fresh queries to establish loop.
  let i:i32=0;
  while(i<4){
    let q:i32=ev_query(W,2001+i,50,-2,0);
    emit("P q"); e64(i); emit("="); e64(q);
    emit(" inferred="); e64(count_inferred(W,50)); emit("\n");
    i=i+1;
  }
  // Phase 3: CONTRADICTION ev_teach(3001,50,99).
  let cx:i32=ev_teach(W,3001,50,99); rep("P","contra_idx",cx);
  emit("P contra_disc="); e64(ng(W,cx,12));
  emit(" contra_src="); e64(ng(W,cx,16)); emit("\n");
  scan_pv(W,"P",50,50);
  // Phase 4: 6 fresh queries.
  i=0;
  while(i<6){
    let q2:i32=ev_query(W,2005+i,50,-2,0);
    emit("P b"); e64(i); emit("="); e64(q2);
    emit(" contra_disc="); e64(ng(W,cx,12));
    emit(" inferred="); e64(count_inferred(W,50)); emit("\n");
    scan_pv(W,"P",50,60+i);
    i=i+1;
  }
  // Phase 5: 2 more queries.
  i=0;
  while(i<2){
    let q3:i32=ev_query(W,2011+i,50,-2,0);
    emit("P p"); e64(i); emit("="); e64(q3); emit("\n");
    i=i+1;
  }
  emit("P b1_final_contra_disc="); e64(ng(W,cx,12));
  emit(" b1_final_inferred="); e64(count_inferred(W,50)); emit("\n");
  emit("P BATTERY-1-DONE\n");

  // Battery 2: Majority-wrong adversary. Fresh world.
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  emit("P BATTERY-2-MAJORITY-WRONG\n");
  // Phase 1: 3 TAUGHT 42 seeds (misleading). 4 queries to build loop.
  ev_teach(W2,1001,50,42); ev_teach(W2,1002,50,42); ev_teach(W2,1003,50,42);
  i=0;
  while(i<4){
    let q4:i32=ev_query(W2,2001+i,50,-2,0);
    emit("P a"); e64(i); emit("="); e64(q4);
    emit(" inferred="); e64(count_inferred(W2,50)); emit("\n");
    i=i+1;
  }
  // Phase 2: genuine 99 correction (TAUGHT).
  let cx2:i32=ev_teach(W2,3001,50,99);
  emit("P adv_contra_idx="); e64(cx2);
  emit(" src="); e64(ng(W2,cx2,16)); emit("\n");
  scan_pv(W2,"P",50,70);
  i=0;
  while(i<4){
    let q5:i32=ev_query(W2,2005+i,50,-2,0);
    emit("P c"); e64(i); emit("="); e64(q5);
    emit(" contra_disc="); e64(ng(W2,cx2,12));
    emit(" inferred="); e64(count_inferred(W2,50)); emit("\n");
    i=i+1;
  }
  // Phase 3: M1 wrong-inference persistence (10 fresh queries).
  // M2 truth exclusion depth (99 discount). M4 self-amplification (inferred count).
  let wrong:i32=0; i=0;
  while(i<10){
    let q6:i32=ev_query(W2,2011+i,50,-2,0);
    if(q6==42){wrong=wrong+1;}
    emit("P m1_"); e64(i); emit("="); e64(q6); emit("\n");
    i=i+1;
  }
  emit("P M1_wrong42_of10="); e64(wrong); emit("\n");
  emit("P M2_contra_disc="); e64(ng(W2,cx2,12)); emit("\n");
  emit("P M4_inferred_total="); e64(count_inferred(W2,50)); emit("\n");
  emit("P BATTERY-2-DONE\n");
  emit("PROVENANCE-EXP-DONE\n");
  return 0;
}
fn main()i32 { return pv_main(); }

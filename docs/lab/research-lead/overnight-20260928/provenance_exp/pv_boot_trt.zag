// ============ PROVENANCE TREATMENT (source-aware bootstrap, unfrozen) ============
// Source tags in field 16 on tag-1 FACT nodes (written at first FACT write):
// 0=UNKNOWN, 1=OBSERVED, 2=TAUGHT, 3=INFERRED, 4=PREDICTED, 5=REVISED,
// 6=DERIVED-FROM-STRUCTURE.
// EXTERNAL = {1,2,5} (OBSERVED, TAUGHT, REVISED): evidence from the world.
// SELF = {3,4,6} (INFERRED, PREDICTED, DERIVED): the learner's own guesses.
// Treatment rules (hypothesis: the learner's own guesses must not become
// independent evidence for themselves):
// - Unanimity for bootstrap firing: unanimous among EXTERNAL facts only.
//   At least one external fact required. SELF facts do not vote.
// - W3 majority: computed over EXTERNAL facts only. Strict external
//   majority required. Only external minority facts are discounted.
// - R1 unchanged: the scan skips FACTs with discount > 2 (all sources).
// - D1/D2 unchanged: per-FACT discount in field 12, threshold T=2.
// Frozen source untouched; this replaces bootstrap_miss in the treatment arm.
fn bootstrap_miss(W:[]u8,s:i32,r:i32)i32 {
  let ex_o:[]u8=z_alloc(24); let ex_n:[]u8=z_alloc(24);
  let ex_s:[]u8=z_alloc(24); let cnt:i32=0; let n:i32=1023;
  while(n>=2 && cnt<6){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,24)==r && ng(W,n,12)<=2){
      set32(ex_o,cnt*4,ng(W,n,28)); set32(ex_n,cnt*4,n);
      set32(ex_s,cnt*4,ng(W,n,16)); cnt=cnt+1;
    }
    n=n-1;
  }
  if(cnt<2){return -2;}
  // External-only unanimity: SELF facts (3,4,6) do not vote.
  let ecnt:i32=0; let ev0:i32=0; let einv:i32=1; let i:i32=0;
  while(i<cnt){
    let src:i32=get32(ex_s,i*4);
    if(src==1 || src==2 || src==5){
      if(ecnt==0){ev0=get32(ex_o,i*4);} else {if(get32(ex_o,i*4)!=ev0){einv=0;}}
      ecnt=ecnt+1;
    }
    i=i+1;
  }
  if(ecnt>=1 && einv==1){
    let k:i32=k_get(W);
    if(ecnt>=k){
      let m:i32=alloc_node(W);
      if(m>=2){
        ns(W,m,0,20); write_node(W,m,0,hg(W,24),0,0);
        link_edge(W,m,13,m,hg(W,0));
        i=0; while(i<cnt){link_edge(W,m,2,m,0); i=i+1;}
        link_edge(W,m,6,m,0);
        ev_teach_in(W,s,r,ev0); return ev0;
      }
    }
  }
  // W3 source-aware: strict majority over EXTERNAL facts only.
  // If the apparent majority depends on SELF votes, W3 does not fire.
  if(einv==0 && ecnt>=2){
    let bi:i32=-1; let bc:i32=0; let j:i32=0;
    while(j<cnt){
      let srcj:i32=get32(ex_s,j*4);
      if(srcj==1 || srcj==2 || srcj==5){
        let cj:i32=0; let q:i32=0;
        while(q<cnt){
          let srcq:i32=get32(ex_s,q*4);
          if((srcq==1 || srcq==2 || srcq==5) && get32(ex_o,q*4)==get32(ex_o,j*4)){cj=cj+1;}
          q=q+1;
        }
        if(cj>bc){bc=cj; bi=j;}
      }
      j=j+1;
    }
    if(bi>=0 && bc*2>ecnt){
      let mv:i32=get32(ex_o,bi*4); j=0;
      while(j<cnt){
        let srcj2:i32=get32(ex_s,j*4);
        if((srcj2==1 || srcj2==2 || srcj2==5) && get32(ex_o,j*4)!=mv){
          let mn:i32=get32(ex_n,j*4);
          ns(W,mn,12,ng(W,mn,12)+1);
        }
        j=j+1;
      }
    }
  }
  return -2;
}

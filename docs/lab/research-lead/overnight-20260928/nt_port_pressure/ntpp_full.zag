// ntpp_full.zag -- NT-PORT-PRESSURE (E8.1): the NT1 rule on the continuing
// learner under capacity pressure, with rule-structured families.
// Pure Zag. No Python.
//
// Subject: the continuing-learner skeleton (associative instance memory,
// sequential lifetime phases, single main(), no resets except the FRESH
// arm's preregistered between-family reset, no task labels) with ONLY the
// D1+D2 memory rules installed (ported from nt_port/nt_port_full.zag):
//   D1: eviction checkpoints (valid,obj,sup,ref) keyed by subj;
//       re-insertion restores checkpointed evidence then runs the update.
//   D2: installation sequence number ins stamped on every installation;
//       eviction victim = max ins (evict-youngest, LIFO).
// Evidence update (NT-frozen): hit+match -> sup++; hit+mismatch -> ref++,
// revise to (new obj,1,0) in place iff ref > sup; revision never touches ins.
// Families are rule-STRUCTURED: taught 2-hop chains with shared substructure
// (A1/A2 share link (101)->102; A3/A4 share link (105)->106). A query answer
// requires composing two learned links. Frozen workload, protocol,
// predictions, kill bars: PREREG.md.
// Arms: 0 = PORT (D1+D2, CAP=20, associative), 1 = NOADDR (overlapping
// address map, 32 slots, no eviction), 2 = FRESH (PORT rules, reset
// between families). The arm selector is a harness condition, not a
// cognitive mode: the learner has no modes.
// Output rule: dynamic content into ONE preallocated buffer, one raw-syscall
// write. _zag_print never used for dynamic content.
//
// Learner arena layout (bytes):
//   0: nentries   4: nevict   8: ins_seq   12: nslots
//   16: slots, nslots * 32 bytes: 0:subj 4:rel 8:obj 12:dom 16:valid 20:sup 24:ref 28:ins
//   ckbase = 16+nslots*32: D1 checkpoint table, 51 * 16 bytes (subjs 100..150):
//       0:valid 4:obj 8:sup 12:ref
//   evbase = ckbase+816: evhist, 51 * 4 bytes (per-subj eviction counts)
//   ntpp_new allocates 2560

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- learner ----
fn cl_new(ns:i32)[]u8 {
  let L:[]u8=z_alloc(2560);
  set32(L,12,ns);
  return L;
}
fn sf(L:[]u8,s:i32,f:i32)i32 { return get32(L,16+s*32+f*4); }
fn sw(L:[]u8,s:i32,f:i32,v:i32)void { set32(L,16+s*32+f*4,v); return; }
fn ckbase(L:[]u8)i32 { return 16+get32(L,12)*32; }
fn evbase(L:[]u8)i32 { return 16+get32(L,12)*32+816; }
fn ck_get(L:[]u8,subj:i32,f:i32)i32 { return get32(L,ckbase(L)+(subj-100)*16+f*4); }
fn ck_set(L:[]u8,subj:i32,f:i32,v:i32)void { set32(L,ckbase(L)+(subj-100)*16+f*4,v); return; }
fn evh_add(L:[]u8,subj:i32)void {
  let b:i32=evbase(L);
  set32(L,b+(subj-100)*4,get32(L,b+(subj-100)*4)+1);
  return;
}
fn evh_get(L:[]u8,subj:i32)i32 { return get32(L,evbase(L)+(subj-100)*4); }
// NOADDR overlapping address map (frozen, PREREG 2.2): A subjs keep
// subj-100; 130/131 get dedicated slots 30/31; novel chain subjs alias
// onto A-only (never-taught-in-B) slots.
fn amap(subj:i32)i32 {
  if(subj<120){ return subj-100; }
  if(subj==130){ return 30; }
  if(subj==131){ return 31; }
  if(subj==140){ return 8; }
  if(subj==141){ return 9; }
  if(subj==143){ return 11; }
  if(subj==144){ return 12; }
  if(subj==146){ return 14; }
  if(subj==147){ return 15; }
  if(subj==149){ return 17; }
  if(subj==150){ return 18; }
  return -1;
}
fn cl_find(L:[]u8,subj:i32,rel:i32,arm:i32)i32 {
  if(arm==1){
    let s:i32=amap(subj);
    if(s<0){ return -1; }
    let m:i32=0;
    if(sf(L,s,4)==1){ if(sf(L,s,0)==subj && sf(L,s,1)==rel){ m=1; } }
    if(m==1){ return s; }
    return -1;
  }
  let ns:i32=get32(L,12);
  let s:i32=0;
  while(s<ns){
    let m:i32=0;
    if(sf(L,s,4)==1){ if(sf(L,s,0)==subj && sf(L,s,1)==rel){ m=1; } }
    if(m==1){ return s; }
    s=s+1;
  }
  return -1;
}
fn cl_first_empty(L:[]u8)i32 {
  let ns:i32=get32(L,12);
  let s:i32=0;
  while(s<ns){
    if(sf(L,s,4)==0){ return s; }
    s=s+1;
  }
  return -1;
}
// D2 eviction rule: evict the most recently INSTALLED entry (max ins).
// Entry-local installation order only; no task identity, no protection,
// no modes. ins unique per installation, no tie-break.
fn cl_evict_youngest(L:[]u8)i32 {
  let ns:i32=get32(L,12);
  let best:i32=-1;
  let bv:i32=0;
  let s:i32=0;
  while(s<ns){
    if(sf(L,s,4)==1){
      let a:i32=sf(L,s,7);
      if(best<0){ best=s; bv=a; }
      else { if(a>bv){ best=s; bv=a; } }
    }
    s=s+1;
  }
  return best;
}
// Frozen evidence update step (shared by the hit path and the D1 restore path).
fn cl_update(L:[]u8,s:i32,obj:i32)void {
  let v:i32=sf(L,s,2);
  if(v==obj){ sw(L,s,5,sf(L,s,5)+1); return; }
  let r:i32=sf(L,s,6)+1;
  sw(L,s,6,r);
  if(r>sf(L,s,5)){ sw(L,s,2,obj); sw(L,s,5,1); sw(L,s,6,0); }
  return;
}
// D1+D2 insertion (arms 0,2): stamp ins on every installation; restore the
// key's checkpointed evidence if valid, then run the update step; else
// install fresh (obj, sup=1, ref=0). NOADDR (arm 1): always fresh.
fn cl_insert(L:[]u8,s:i32,subj:i32,rel:i32,obj:i32,phase:i32,arm:i32)void {
  if(arm==0 || arm==2){
    let ni:i32=get32(L,8)+1;
    set32(L,8,ni);
    sw(L,s,7,ni);
    if(ck_get(L,subj,0)==1){
      sw(L,s,0,subj); sw(L,s,1,rel); sw(L,s,2,ck_get(L,subj,1));
      sw(L,s,3,phase); sw(L,s,4,1);
      sw(L,s,5,ck_get(L,subj,2)); sw(L,s,6,ck_get(L,subj,3));
      cl_update(L,s,obj);
      return;
    }
  }
  sw(L,s,0,subj); sw(L,s,1,rel); sw(L,s,2,obj); sw(L,s,3,phase);
  sw(L,s,4,1); sw(L,s,5,1); sw(L,s,6,0);
  return;
}
fn cl_learn(L:[]u8,subj:i32,rel:i32,obj:i32,phase:i32,arm:i32)void {
  let s:i32=cl_find(L,subj,rel,arm);
  if(s>=0){ cl_update(L,s,obj); return; }
  if(arm==1){
    s=amap(subj);
    if(sf(L,s,4)==0){ set32(L,0,get32(L,0)+1); }
    cl_insert(L,s,subj,rel,obj,phase,arm);
    return;
  }
  if(get32(L,0)<get32(L,12)){
    s=cl_first_empty(L);
    set32(L,0,get32(L,0)+1);
  } else {
    let e:i32=cl_evict_youngest(L);
    set32(L,4,get32(L,4)+1);
    let vs:i32=sf(L,e,0);
    evh_add(L,vs);
    // D1: checkpoint the victim's evidence before the slot is reused
    ck_set(L,vs,0,1);
    ck_set(L,vs,1,sf(L,e,2));
    ck_set(L,vs,2,sf(L,e,5));
    ck_set(L,vs,3,sf(L,e,6));
    s=e;
  }
  cl_insert(L,s,subj,rel,obj,phase,arm);
  return;
}
fn cl_predict(L:[]u8,subj:i32,rel:i32,arm:i32)i32 {
  let s:i32=cl_find(L,subj,rel,arm);
  if(s<0){ return -1; }
  if(sf(L,s,5)>sf(L,s,6)){ return sf(L,s,2); }
  return -1;
}
// 2-hop query: answer requires composing two learned links.
fn q2(L:[]u8,s:i32,arm:i32)i32 {
  let p1:i32=cl_predict(L,s,1,arm);
  if(p1<0){ return -1; }
  let p2:i32=cl_predict(L,p1,1,arm);
  if(p2<0){ return -1; }
  return p2;
}
// ---- oracles: frozen numeric inventory (PREREG Section 3) ----
// Family-A link oracle: 8 chains, 14 distinct links; A1/A2 share
// (101)->102; A3/A4 share (105)->106.
fn linka(s:i32)i32 {
  if(s==100){ return 101; }
  if(s==101){ return 102; }
  if(s==103){ return 101; }
  if(s==104){ return 105; }
  if(s==105){ return 106; }
  if(s==107){ return 105; }
  if(s==108){ return 109; }
  if(s==109){ return 110; }
  if(s==111){ return 112; }
  if(s==112){ return 113; }
  if(s==114){ return 115; }
  if(s==115){ return 116; }
  if(s==117){ return 118; }
  if(s==118){ return 119; }
  return -1;
}
// A-link subjs in ascending order (14).
fn ntha(i:i32)i32 {
  if(i==0){ return 100; }
  if(i==1){ return 101; }
  if(i==2){ return 103; }
  if(i==3){ return 104; }
  if(i==4){ return 105; }
  if(i==5){ return 107; }
  if(i==6){ return 108; }
  if(i==7){ return 109; }
  if(i==8){ return 111; }
  if(i==9){ return 112; }
  if(i==10){ return 114; }
  if(i==11){ return 115; }
  if(i==12){ return 117; }
  return 118;
}
// Query starts in ascending order (8).
fn nthq(i:i32)i32 {
  if(i==0){ return 100; }
  if(i==1){ return 103; }
  if(i==2){ return 104; }
  if(i==3){ return 107; }
  if(i==4){ return 108; }
  if(i==5){ return 111; }
  if(i==6){ return 114; }
  return 117;
}
// Family-B teachings in ascending subj order (14): C, NC, N.
fn bsub(i:i32)i32 {
  if(i==0){ return 100; }
  if(i==1){ return 104; }
  if(i==2){ return 101; }
  if(i==3){ return 105; }
  if(i==4){ return 130; }
  if(i==5){ return 131; }
  if(i==6){ return 140; }
  if(i==7){ return 141; }
  if(i==8){ return 143; }
  if(i==9){ return 144; }
  if(i==10){ return 146; }
  if(i==11){ return 147; }
  if(i==12){ return 149; }
  return 150;
}
fn bobj(i:i32)i32 {
  if(i==0){ return 130; }
  if(i==1){ return 131; }
  if(i==2){ return 102; }
  if(i==3){ return 106; }
  if(i==4){ return 132; }
  if(i==5){ return 133; }
  if(i==6){ return 141; }
  if(i==7){ return 142; }
  if(i==8){ return 144; }
  if(i==9){ return 145; }
  if(i==10){ return 147; }
  if(i==11){ return 148; }
  if(i==12){ return 150; }
  return 151;
}
// Correct 2-hop answers under family A and under family B.
fn ansa(s:i32)i32 {
  if(s==100){ return 102; }
  if(s==103){ return 102; }
  if(s==104){ return 106; }
  if(s==107){ return 106; }
  if(s==108){ return 110; }
  if(s==111){ return 113; }
  if(s==114){ return 116; }
  return 119;
}
fn ansb(s:i32)i32 {
  if(s==100){ return 132; }
  if(s==103){ return 102; }
  if(s==104){ return 133; }
  if(s==107){ return 106; }
  if(s==108){ return 110; }
  if(s==111){ return 113; }
  if(s==114){ return 116; }
  return 119;
}
fn isC(s:i32)i32 {
  if(s==100){ return 1; }
  if(s==104){ return 1; }
  return 0;
}
fn isNC(s:i32)i32 {
  if(s==103){ return 1; }
  if(s==107){ return 1; }
  return 0;
}
// ---- protocol ----
fn teachA(L:[]u8,arm:i32)void {
  let i:i32=0;
  while(i<14){
    let s:i32=ntha(i);
    cl_learn(L,s,1,linka(s),1,arm);
    i=i+1;
  }
  return;
}
fn teachB(L:[]u8,arm:i32)void {
  let i:i32=0;
  while(i<14){ cl_learn(L,bsub(i),1,bobj(i),2,arm); i=i+1; }
  return;
}
fn probeA(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<8){
    let s:i32=nthq(i);
    if(q2(L,s,arm)==ansa(s)){ n=n+1; }
    i=i+1;
  }
  return n;
}
fn probeB(L:[]u8,arm:i32)i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<14){
    if(cl_predict(L,bsub(i),1,arm)==bobj(i)){ n=n+1; }
    i=i+1;
  }
  return n;
}
// retest: out 12:c 16:nc 20:u 24:forget
fn retest(L:[]u8,arm:i32,out:[]u8)void {
  let c:i32=0;
  let nc:i32=0;
  let u:i32=0;
  let fg:i32=0;
  let i:i32=0;
  while(i<8){
    let s:i32=nthq(i);
    let p:i32=q2(L,s,arm);
    let a:i32=ansa(s);
    if(isC(s)==1){
      if(p==ansb(s)){ c=c+1; }
      else { if(p!=a){ fg=fg+1; } }
    } else {
      if(p==a){
        if(isNC(s)==1){ nc=nc+1; } else { u=u+1; }
      } else { fg=fg+1; }
    }
    i=i+1;
  }
  set32(out,12,c); set32(out,16,nc); set32(out,20,u); set32(out,24,fg);
  return;
}
// evictions of phase-1-link subjs 100..119 (white-box pressure audit)
fn phev(L:[]u8)i32 {
  let n:i32=0;
  let k:i32=100;
  while(k<=119){ n=n+evh_get(L,k); k=k+1; }
  return n;
}
// train family A to criterion; returns passes (negative = fail-safe hit)
fn trainA(L:[]u8,arm:i32)i32 {
  let consec:i32=0;
  let p:i32=0;
  while(consec<2){
    if(p>=50){ return 0-p; }
    teachA(L,arm);
    p=p+1;
    if(probeA(L,arm)==8){ consec=consec+1; } else { consec=0; }
  }
  return p;
}
// train family B to criterion; returns passes (negative = fail-safe hit)
fn trainB(L:[]u8,arm:i32)i32 {
  let consec:i32=0;
  let p:i32=0;
  while(consec<2){
    if(p>=50){ return 0-p; }
    teachB(L,arm);
    p=p+1;
    if(probeB(L,arm)==14){ consec=consec+1; } else { consec=0; }
  }
  return p;
}
// run one arm; out: 0 ttcA, 4 probeA, 8 nevict, 12 c, 16 nc, 20 u,
// 24 forget, 28 phev_or_bprobe, 32 ttcB
fn run_arm(arm:i32,ns:i32,fresh:i32,out:[]u8,ob:[]u8,c:i32,tag:[]u8,bp:i32)i32 {
  let L:[]u8=cl_new(ns);
  let ttcA:i32=trainA(L,arm);
  let pa:i32=probeA(L,arm);
  if(fresh==1){ L=cl_new(ns); }
  let ttcB:i32=0;
  if(bp==1){ ttcB=trainB(L,arm); }
  else {
    let p:i32=0;
    while(p<3){ teachB(L,arm); p=p+1; }
  }
  let bpr:i32=probeB(L,arm);
  retest(L,arm,out);
  set32(out,0,ttcA); set32(out,4,pa); set32(out,8,get32(L,4));
  if(fresh==1){ set32(out,28,bpr); } else { set32(out,28,phev(L)); }
  set32(out,32,ttcB);
  c=o_app(ob,c,"NTPP "); c=o_app(ob,c,tag);
  c=o_app(ob,c," ttcA="); c=o_i64(ob,c,ttcA as i64);
  c=o_app(ob,c," probeA="); c=o_i64(ob,c,pa as i64);
  c=o_app(ob,c," nevict="); c=o_i64(ob,c,get32(L,4) as i64);
  if(fresh==1){
    c=o_app(ob,c," ttcB="); c=o_i64(ob,c,ttcB as i64);
  }
  c=o_app(ob,c," bprobe="); c=o_i64(ob,c,bpr as i64);
  if(fresh==0){
    c=o_app(ob,c," phev="); c=o_i64(ob,c,get32(out,28) as i64);
  }
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTPP "); c=o_app(ob,c,tag);
  c=o_app(ob,c," RET c="); c=o_i64(ob,c,get32(out,12) as i64);
  c=o_app(ob,c," nc="); c=o_i64(ob,c,get32(out,16) as i64);
  c=o_app(ob,c," u="); c=o_i64(ob,c,get32(out,20) as i64);
  c=o_app(ob,c," forget="); c=o_i64(ob,c,get32(out,24) as i64);
  c=o_nl(ob,c);
  if(fresh==0){
    c=o_app(ob,c,"NTPP "); c=o_app(ob,c,tag); c=o_app(ob,c," EVHIST");
    let k:i32=100;
    while(k<=150){
      let h:i32=evh_get(L,k);
      if(h>0){
        c=o_app(ob,c," "); c=o_i64(ob,c,k as i64);
        c=o_app(ob,c,"="); c=o_i64(ob,c,h as i64);
      }
      k=k+1;
    }
    c=o_nl(ob,c);
  }
  return c;
}
fn main()i32 {
  let ob:[]u8=z_alloc(4096);
  let c:i32=0;
  let m:[]u8=z_alloc(64);
  let n:[]u8=z_alloc(64);
  let f:[]u8=z_alloc(64);
  // PORT: arm 0, 20 slots, no reset, 3 fixed B passes (bp=0)
  c=run_arm(0,20,0,m,ob,c,"PORT",0);
  // NOADDR: arm 1, 32 slots, no reset, 3 fixed B passes (bp=0)
  c=run_arm(1,32,0,n,ob,c,"NOADDR",0);
  // FRESH: arm 2, 20 slots, reset between families, B to criterion (bp=1)
  c=run_arm(2,20,1,f,ob,c,"FRESH",1);
  // ---- kill bars (PREREG Section 7) ----
  let k1:i32=0;
  let ta:i32=get32(m,0);
  let tb:i32=get32(f,32);
  if(ta>=1){ if(ta<=50){ if(get32(m,4)==8){
    if(tb>=1){ if(tb<=50){ if(get32(f,28)==14){ k1=1; } } }
  } } }
  let k2:i32=0;
  if(get32(m,16)==2){ if(get32(m,20)==4){ k2=1; } }
  let k3:i32=0;
  if(get32(m,12)==2){ if(get32(m,24)==0){ k3=1; } }
  let k4:i32=0;
  if(get32(m,8)==14){ if(get32(m,28)==0){ k4=1; } }
  let k5a:i32=0;
  if(get32(n,20)!=4){ k5a=1; } else { if(get32(n,24)!=0){ k5a=1; } }
  let k5b:i32=0;
  if(get32(f,16)!=2){ k5b=1; } else { if(get32(f,20)!=4){ k5b=1; } }
  let k5:i32=0;
  if(k5a==1){ if(k5b==1){ k5=1; } }
  c=o_app(ob,c,"NTPP K1="); c=o_i64(ob,c,k1 as i64);
  c=o_app(ob,c," K2="); c=o_i64(ob,c,k2 as i64);
  c=o_app(ob,c," K3="); c=o_i64(ob,c,k3 as i64);
  c=o_app(ob,c," K4="); c=o_i64(ob,c,k4 as i64);
  c=o_app(ob,c," K5="); c=o_i64(ob,c,k5 as i64);
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTPP VERDICT=");
  if(k1==0){ c=o_app(ob,c,"VOID"); }
  else {
    if(k5==0){ c=o_app(ob,c,"INCONCLUSIVE"); }
    else {
      if(k2==0){ c=o_app(ob,c,"FAIL-RETENTION"); }
      else {
        if(k3==0){ c=o_app(ob,c,"FAIL-RETENTION"); }
        else {
          if(k4==0){ c=o_app(ob,c,"FAIL-PRESSURE"); }
          else { c=o_app(ob,c,"PORT-PASS-STRUCT"); }
        }
      }
    }
  }
  c=o_nl(ob,c);
  c=o_app(ob,c,"NTPP-END");
  c=o_nl(ob,c);
  o_flush(ob,c);
  return 0;
}

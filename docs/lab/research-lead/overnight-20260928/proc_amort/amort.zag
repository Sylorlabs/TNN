// amort.zag: learned-procedure amortization measurement.
// Learned procedure D1 = majority(X1,X2,X3) = (X1&X2)|(X2&X3)|(X1&X3),
// the kept 5-op tree from Q4-reuse (commit b719bb54b).
// Three execution arms of the same learned function:
//   E1 TREE-INTERP  : generic recursive tree interpreter over node table
//   E2 SIG-LOOKUP   : learner's precomputed truth signature (verbatim node_pred logic)
//   E3 COMPILED-DIRECT : worker-lowered direct expression
// Pure Zag. No Python.

// ============ utils (verbatim from machine_native/mnstress1.zag) ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn e64(v:i64)void { emit(i64s(v)); return; }
fn e32(v:i32)void { emit(i64s(v as i64)); return; }
fn eln()void { emit("\n"); return; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn now_ms()i64 {
  let ts:[]u8=z_alloc(16);
  _zag_raw_syscall(228,1,(_zag_slice_ptr(ts) as i64),0,0,0,0);
  let sec:i64=(ts[0] as i64)|((ts[1] as i64)<<8)|((ts[2] as i64)<<16)|((ts[3] as i64)<<24)|((ts[4] as i64)<<32)|((ts[5] as i64)<<40)|((ts[6] as i64)<<48)|((ts[7] as i64)<<56);
  let ns:i64=(ts[8] as i64)|((ts[9] as i64)<<8)|((ts[10] as i64)<<16)|((ts[11] as i64)<<24)|((ts[12] as i64)<<32)|((ts[13] as i64)<<40)|((ts[14] as i64)<<48)|((ts[15] as i64)<<56);
  z_free(ts);
  return sec*1000+ns/1000000;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=4194304;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn peak_rss()i64 {
  let d:[]u8=read_file("/proc/self/status");
  let p:i32=findsub(d,0,"VmHWM:");
  if(p<0){return 0;}
  let s:i32=p+6;
  while(s<d.len && (d[s]<48 || d[s]>57)){s=s+1;}
  let v:i64=0;
  while(s<d.len && d[s]>=48 && d[s]<=57){v=v*10+(d[s] as i64)-48;s=s+1;}
  return v;
}
fn hex64(v:i64)[]u8 {
  let b:[]u8=z_alloc(16);
  let i:i32=0;
  while(i<16){
    let d:i64=(v>>((15-i)*4))&15;
    if(d<10){b[i]=(48+d) as u8;} else {b[i]=(87+d) as u8;}
    i=i+1;
  }
  return b;
}

// ============ learned tree D1 (8 nodes) ============
// op: 0=TERM 1=AND 2=OR ; children c0/c1 ; tv = terminal var (0..2)
// 0:X1 1:X2 2:X3 3:AND(0,1) 4:AND(1,2) 5:AND(0,2) 6:OR(3,4) 7:OR(6,5)=root
fn build_nodes(nop:[]u8, nc0:[]u8, nc1:[]u8, ntv:[]u8)void {
  nop[0]=0; nc0[0]=0; nc1[0]=0; ntv[0]=0;
  nop[1]=0; nc0[1]=0; nc1[1]=0; ntv[1]=1;
  nop[2]=0; nc0[2]=0; nc1[2]=0; ntv[2]=2;
  nop[3]=1; nc0[3]=0; nc1[3]=1; ntv[3]=0;
  nop[4]=1; nc0[4]=1; nc1[4]=2; ntv[4]=0;
  nop[5]=1; nc0[5]=0; nc1[5]=2; ntv[5]=0;
  nop[6]=2; nc0[6]=3; nc1[6]=4; ntv[6]=0;
  nop[7]=2; nc0[7]=6; nc1[7]=5; ntv[7]=0;
  return;
}
// E1: generic recursive tree interpreter (no memoization; shared t1 re-evaluated)
fn teval(nop:[]u8, nc0:[]u8, nc1:[]u8, ntv:[]u8, n:i32, x:i32)i32 {
  let op:i32=nop[n] as i32;
  if(op==0){ return (x>>ntv[n])&1; }
  let a:i32=teval(nop,nc0,nc1,ntv,nc0[n] as i32,x);
  let b:i32=teval(nop,nc0,nc1,ntv,nc1[n] as i32,x);
  if(op==1){ return a&b; }
  return a|b;
}
// E2 sig bit for x, built from the direct form (matches learner's sig)
fn d1_direct(x:i32)i32 {
  let x1:i32=(x>>0)&1;
  let x2:i32=(x>>1)&1;
  let x3:i32=(x>>2)&1;
  return (x1&x2)|(x2&x3)|(x1&x3);
}

fn main()void {
  let nop:[]u8=z_alloc(8);
  let nc0:[]u8=z_alloc(8);
  let nc1:[]u8=z_alloc(8);
  let ntv:[]u8=z_alloc(8);
  build_nodes(nop,nc0,nc1,ntv);
  // correctness gate: all 64 combos must agree across arms
  let slo:i64=0;
  let x:i32=0;
  let bad:i32=0;
  while(x<64){
    let e1:i32=teval(nop,nc0,nc1,ntv,7,x);
    let e3:i32=d1_direct(x);
    if(e1!=e3){ bad=1; }
    if(e3==1){ slo=slo | (1 as i64 << (x as i64)); }
    x=x+1;
  }
  x=0;
  while(x<64){
    let e2:i32=((slo >> (x as i64)) & 1) as i32;
    if(e2!=d1_direct(x)){ bad=1; }
    x=x+1;
  }
  emit("gate=");
  e32(bad);
  emit(" sig=");
  emit(hex64(slo));
  eln();
  if(bad!=0){ return; }
  let N:i64=67108864;
  // ---- E1 TREE-INTERP ----
  let acc:i64=0;
  let t0:i64=now_ms();
  let i:i64=0;
  while(i<N){
    let xx:i32=(i&63) as i32;
    acc=acc*31+(teval(nop,nc0,nc1,ntv,7,xx) as i64);
    i=i+1;
  }
  let t1:i64=now_ms();
  emit("arm=E1 ms=");
  e64(t1-t0);
  emit(" chk=");
  emit(hex64(acc));
  emit(" rss=");
  e64(peak_rss());
  eln();
  // ---- E2 SIG-LOOKUP ----
  acc=0;
  t0=now_ms();
  i=0;
  while(i<N){
    let xx:i32=(i&63) as i32;
    let o:i32=((slo >> (xx as i64)) & 1) as i32;
    acc=acc*31+(o as i64);
    i=i+1;
  }
  t1=now_ms();
  emit("arm=E2 ms=");
  e64(t1-t0);
  emit(" chk=");
  emit(hex64(acc));
  emit(" rss=");
  e64(peak_rss());
  eln();
  // ---- E3 COMPILED-DIRECT ----
  acc=0;
  t0=now_ms();
  i=0;
  while(i<N){
    let xx:i32=(i&63) as i32;
    acc=acc*31+(d1_direct(xx) as i64);
    i=i+1;
  }
  t1=now_ms();
  emit("arm=E3 ms=");
  e64(t1-t0);
  emit(" chk=");
  emit(hex64(acc));
  emit(" rss=");
  e64(peak_rss());
  eln();
  return;
}

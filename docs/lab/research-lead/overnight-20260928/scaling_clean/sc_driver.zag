// sc_driver.zag -- scaling continuation driver.
//
// Part 1 (scale law): D broken plen-2 decoys + 5 real plen-5 MAPs,
//   2 plen-5 queries. Modes 0 (linear) vs 1 (MAP index).
// Part 2 (emergent ordering): H1S-style verify tax (12 plen-3 decoys x
//   3 len-3 distractor paths), repeat queries on fresh subjects, then a
//   stale-path test. Modes 0 (linear), 1 (indexed id-order), 3 (indexed
//   + MTF emergent fast-path / move-to-front).
//   NOTE: repeat queries use FRESH subjects with identical structure:
//   ev_query would otherwise hit activate() on the taught query FACT.
//   The MTF memory lives at the MAP level, so this is faithful.
// Part 3 (FACT index): 1000 FACTs, direct t2_gather / t2_lu_first
//   measurement. Modes 0 (linear) vs 4 (FACT index).
fn sc_mkchain(W:[]u8,s0:i32,plen:i32,rel:i32,ans:i32)i32 {
  let k:i32=0;
  while(k<plen-1){
    ev_teach(W,s0+k,1,s0+k+1);
    k=k+1;
  }
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn sc_mkbroken(W:[]u8,s0:i32,rel:i32,ans:i32)i32 {
  ev_teach(W,s0,1,s0+1);
  let v:[]u8=z_alloc(64); let f:[]u8=z_alloc(60);
  let len:i32=t2_chain(W,s0,1,v,f);
  let root:i32=t2_asm_chain(W,v,len,f);
  let stcell:i32=ng(W,root,12);
  if(stcell>=0){ns(W,stcell,0,103);}
  let pm:i32=promote_graph(W,root,s0,rel,ans,f,len-1);
  return pm;
}
fn sc_big()[]u8 {
  let W:[]u8=z_alloc(593984);
  return W;
}
fn w_scale(D:i32,mode:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=sc_big(); tnn2_init(W);
  idx_mode_set(W,mode);
  let qi:i32=0;
  while(qi<2){
    let q:i32=6101+qi*200;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    qi=qi+1;
  }
  emit(tag); emit(" facts taught\n");
  let i:i32=0;
  let fails:i32=0;
  while(i<D){
    if(sc_mkbroken(W,2000+i,51,2001+i)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" decoys done fails="); e64(fails); emit("\n");
  i=0;
  while(i<5){
    if(sc_mkchain(W,5000+i*10,5,51,5004+i*10)<0){fails=fails+1;}
    i=i+1;
  }
  emit(tag); emit(" real done fails="); e64(fails);
  emit(" build-walks="); e64(hg(W,60)); emit("\n");
  hs(W,60,0);
  qi=0;
  while(qi<2){
    let q:i32=6101+qi*200;
    hs(W,16,0); hs(W,56,0);
    let b:i32=ev_query(W,q,50,q+104,0);
    emit(tag); emit(" Q"); e64(qi);
    emit(" ans="); e64(b);
    let t:i32=hg(W,16);
    emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
    emit(" scan="); e64(hg(W,56));
    emit(" walks="); e64(hg(W,60));
    emit(" ok="); e64(b==q+104); emit("\n");
    qi=qi+1;
  }
  emit(tag); emit("-END\n");
  return;
}
// Emergent ordering world. Real plen-5 MAP promoted FIRST, then 12
// plen-3 decoys (newest-first bucket order => maximal Q0 tax, so any
// Q1/Q2 win is learning, not initial order).
fn w_emerg(mode:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=sc_big(); tnn2_init(W);
  idx_mode_set(W,mode);
  let qi:i32=0;
  while(qi<4){
    let q:i32=6101+qi*100;
    ev_teach(W,q,1,q+101); ev_teach(W,q+101,1,q+102);
    ev_teach(W,q+102,1,q+103); ev_teach(W,q+103,1,q+104);
    let d:i32=0;
    while(d<3){
      let x:i32=7000+d*10+qi;
      ev_teach(W,q,1,x); ev_teach(W,x,1,x+1); ev_teach(W,x+1,1,x+2);
      d=d+1;
    }
    qi=qi+1;
  }
  emit(tag); emit(" chains taught\n");
  // Promote real MAP in the MIDDLE (6 decoys, real, 6 decoys) so that
  // oldest-first (linear), id-ascending (indexed), and newest-first (MTF)
  // orders ALL pay the decoy tax on Q0. Any Q1/Q2 win is then learning,
  // not initial order.
  let i:i32=0;
  while(i<6){
    if(sc_mkchain(W,8000+i*10,3,51,8002+i*10)<0){emit(tag); emit(" decoy FAIL\n");}
    i=i+1;
  }
  if(sc_mkchain(W,5000,5,51,5004)<0){emit(tag); emit(" real FAIL\n");}
  i=6;
  while(i<12){
    if(sc_mkchain(W,8000+i*10,3,51,8002+i*10)<0){emit(tag); emit(" decoy FAIL\n");}
    i=i+1;
  }
  emit(tag); emit(" maps promoted\n");
  qi=0;
  while(qi<3){
    let q:i32=6101+qi*100;
    hs(W,16,0); hs(W,56,0);
    let b:i32=ev_query(W,q,50,q+104,0);
    emit(tag); emit(" Q"); e64(qi);
    let t:i32=hg(W,16);
    emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
    emit(" scan="); e64(hg(W,56));
    emit(" ok="); e64(b==q+104); emit("\n");
    qi=qi+1;
  }
  // STALE: second len-5 chain from q3 with a new answer.
  let q3:i32=6401;
  ev_teach(W,q3,1,9000); ev_teach(W,9000,1,9001);
  ev_teach(W,9001,1,9002); ev_teach(W,9002,1,9003);
  hs(W,16,0); hs(W,56,0);
  let b:i32=ev_query(W,q3,50,9003,0);
  emit(tag); emit(" QSTALE");
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024);
  emit(" scan="); e64(hg(W,56));
  emit(" ok="); e64(b==9003); emit("\n");
  emit(tag); emit("-END\n");
  return;
}
// FACT index world: 1000 FACTs + small chain; direct gather/lu_first.
fn w_fact(mode:i32,tag:[]u8)void {
  emit(tag); emit("-START\n");
  let W:[]u8=sc_big(); tnn2_init(W);
  idx_mode_set(W,mode);
  let i:i32=0;
  while(i<1000){
    ev_teach(W,5000+i,1,9000+i);
    i=i+1;
  }
  ev_teach(W,100,1,101); ev_teach(W,101,1,102); ev_teach(W,102,1,103);
  emit(tag); emit(" facts taught\n");
  let paths:[]u8=z_alloc(4608);
  fcnt_zero(W);
  let np:i32=t2_gather(W,100,paths);
  emit(tag); emit(" gather np="); e64(np);
  emit(" factvisits="); e64(fcnt_get(W)); emit("\n");
  fcnt_zero(W);
  i=0;
  let hits:i32=0;
  while(i<50){
    if(t2_lu_first(W,5000+i*20,1)>=0){hits=hits+1;}
    i=i+1;
  }
  emit(tag); emit(" lu50 hits="); e64(hits);
  emit(" factvisits="); e64(fcnt_get(W)); emit("\n");
  emit(tag); emit("-END\n");
  return;
}
fn main()i32 {
  emit("SCALING-CONT-START\n");
  w_scale(95,0,"S100L");
  w_scale(95,1,"S100I");
  w_scale(490,0,"S500L");
  w_scale(490,1,"S500I");
  w_scale(990,0,"S1000L");
  w_scale(990,1,"S1000I");
  w_emerg(0,"EML");
  w_emerg(1,"EMI");
  w_emerg(3,"EMM");
  w_fact(0,"FAL");
  w_fact(4,"FAI");
  emit("SCALING-CONT-END\n");
  return 0;
}

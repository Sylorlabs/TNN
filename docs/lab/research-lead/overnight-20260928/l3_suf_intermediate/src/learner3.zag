// learner.zag part 3 -- treatment arm pipeline pieces.
// The driver (harness) orchestrates: setup -> try_commit -> stakes
// (harness-scored) -> revise loop. These are the learner-side steps.

// forced guarded build (for kb-template-2 instantiate)
fn l_build_guarded(train:[]u8, ntrain:i32, f:[]u8)void {
  l_form_new(f,1);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    if(l_form_find(f,s0,x,y)<0){
      l_form_add(f,s0,x,y,d);
    }
    i=i+1;
  }
  return;
}
// setup: OBSERVE, BUILD (kb-aware), PROBE, lift+fill (if template 2),
// SIMPLIFY. train/form/sc are scratch. Returns ntrain.
fn l_arm_setup(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8)i32 {
  let ntrain:i32=w_observe(WB,train);
  let ob:i32=l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  // proto: > OBSERVE
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> OBSERVE n=");
  at=ob_i32(PR,at,ntrain);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  let i:i32=0;
  while(i<ntrain){
    let s0:i32=get32(train,i*16);
    let x:i32=get32(train,i*16+4);
    let y:i32=get32(train,i*16+8);
    let d:i32=get32(train,i*16+12);
    let ek:i32=l_ekey(s0,x,y);
    l_log_touch(LOG,ek,0,d,1,0,ob);
    i=i+1;
  }
  let kbv:i32=get32(KB,0);
  let tmpl:i32=get32(KB,4);
  let bseq:i32=0;
  if(kbv==1){
    l_tr(AS,TR,ob,"KB_LOAD",tmpl,0,0,0);
    set32(AS,60,1);
  }
  l_build_direct(train,ntrain,form);
  bseq=l_tr(AS,TR,ob,"BUILD",get32(form,0),0,0,0);
  l_probe_phase(WB,AS,LOG,TR,PR,form,train,ntrain,150,bseq);
  // fix the form with probe evidence if broken (pre-commit improvement).
  // Gated: only when probes REJECTed knowledge predictions (not mere
  // tiebreak fabrications). A spurious upgrade on clean worlds would
  // force an unnecessary lift.
  if(get32(AS,92)>0){
    l_try_improve(AS,LOG,TR,PR,form,sc,train,ntrain,bseq);
  }
  // instantiate the kb resolution template (if kind1)
  if(kbv==1){
    if(tmpl==2){
      if(get32(form,0)==1){
        let ls:i32=l_tr(AS,TR,bseq,"LIFT",0,0,0,0);
        l_arity_lift(form);
        l_fill_record(form,LOG,AS,TR,ls);
      }
    }
  }
  l_simplify(AS,TR,LOG,form,sc,train,ntrain,bseq);
  return ntrain;
}
// try commit:
//  1. knowledge-REJECTed (form was broken by probes):
//       replay-consistent now -> COMMIT; else DATA-UNTRUSTED -> DEFER,
//       else INADEQUACY -> DEFER.
//  2. replay-consistent -> COMMIT.
//  3. DATA-UNTRUSTED (OBSERVE vs TEST) -> DEFER.
//  4. graded (kind2) but inconsistent: escalate now; commit or defer.
//  5. else COMMIT the best ungraded form (stakes adjudicate; the
//     post-stakes escalation invents if needed).
// Returns commit seq, or -1 on DEFER.
fn l_arm_try_commit(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  if(get32(AS,92)>0){
    if(l_replay_consistent(form,LOG,train,ntrain)==1){
      let cs:i32=l_commit(AS,TR,PR,KB,form,parent);
      return cs;
    }
    l_defer(AS,TR,PR,l_certify(LOG),parent);
    return -1;
  }
  if(l_replay_consistent(form,LOG,train,ntrain)==1){
    let cs2:i32=l_commit(AS,TR,PR,KB,form,parent);
    return cs2;
  }
  if(l_certify(LOG)==2){
    l_defer(AS,TR,PR,2,parent);
    return -1;
  }
  // best available ungraded form; commit (stakes will falsify if needed)
  let kind:i32=get32(form,0);
  if(kind==2){
    // graded but inconsistent and not data-untrusted: escalate now
    if(l_escalate(WB,AS,LOG,TR,PR,form,sc,train,ntrain,parent)==1){
      let cs3:i32=l_commit(AS,TR,PR,KB,form,parent);
      return cs3;
    }
    l_defer(AS,TR,PR,l_certify(LOG),parent);
    return -1;
  }
  let cs4:i32=l_commit(AS,TR,PR,KB,form,parent);
  return cs4;
}
// revise after stakes REJECTs: escalate; re-commit or defer.
// Returns commit seq or -1.
fn l_arm_revise(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, sc:[]u8, train:[]u8, ntrain:i32, parent:i32)i32 {
  let rv:i32=l_tr(AS,TR,parent,"REVISE",0,0,0,0);
  if(l_escalate(WB,AS,LOG,TR,PR,form,sc,train,ntrain,rv)==1){
    let cs:i32=l_commit(AS,TR,PR,KB,form,rv);
    return cs;
  }
  l_defer(AS,TR,PR,l_certify(LOG),rv);
  return -1;
}

// driver.zag -- harness for L3-SUF-1 builder DEV battery.
// h_ functions are harness (may call w_truth/w_stakes_meta/w_undet
// for scoring; the learner l_ functions never do -- A-INFO boundary).
// The driver runs: discrimination gate, treatment T0..T7 (one continuing
// learner, kb persists), controls C0/C1/C2/C3, then evaluates the frozen
// bars. 3/3 byte-identical run logs; digests via sha256sum (shell).

// ---- harness-scored stakes ----
// mode 0: answer via l_predict2(form); mode 1: c1_answer(mem).
// sres: nstakes*3 i32s (v_pred, oc, fab). Returns REJECT count.
fn h_stakes(WB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, form:[]u8, mode:i32, mem:[]u8, sres:[]u8)i32 {
  let sq:[]u8=z_alloc(1024);
  let out:[]u8=z_alloc(8);
  let ns:i32=w_stakes(WB,sq);
  let ss:i32=l_tr(AS,TR,0,"STAKES",ns,0,0,0);
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> STAKES n=");
  at=ob_i32(PR,at,ns);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  let nrej:i32=0;
  let i:i32=0;
  while(i<ns){
    let s0:i32=get32(sq,i*12);
    let x:i32=get32(sq,i*12+4);
    let y:i32=get32(sq,i*12+8);
    let v:i32=-1;
    let fb:i32=0;
    if(mode==0){
      l_predict2(form,s0,x,y,out);
      v=get32(out,0);
      fb=get32(out,4);
    } else {
      v=c1_answer(mem,s0,x,y);
      fb=0;
    }
    let ek:i32=l_ekey(s0,x,y);
    if(v==-1){
      let seq:i32=l_tr(AS,TR,ss,"ABSTAIN",ek,0,0,0);
      l_pr(AS,PR,"> ABSTAIN");
      l_log_touch(LOG,ek,2,-1,2,0,seq);
      let na:i32=get32(AS,64);
      set32(AS,64,na+1);
      set32(sres,i*12,-1);
      set32(sres,i*12+4,2);
      set32(sres,i*12+8,0);
    } else {
      let t:i32=w_truth(WB,s0,x,y);
      let oc:i32=0;
      if(t==v){oc=1;}
      let seq:i32=l_tr(AS,TR,ss,"SANS",ek,v,oc,0);
      let at2:i32=get32(AS,72);
      at2=ob_app(PR,at2,"> SANS s0=");
      at2=ob_i32(PR,at2,s0);
      at2=ob_app(PR,at2," x=");
      at2=ob_i32(PR,at2,x);
      at2=ob_app(PR,at2," y=");
      at2=ob_i32(PR,at2,y);
      at2=ob_app(PR,at2," v=");
      at2=ob_i32(PR,at2,v);
      if(oc==1){at2=ob_app(PR,at2," => ACCEPT");}
      else {at2=ob_app(PR,at2," => REJECT");}
      at2=ob_nl(PR,at2);
      set32(AS,72,at2);
      l_log_touch(LOG,ek,2,v,oc,fb,seq);
      set32(sres,i*12,v);
      set32(sres,i*12+4,oc);
      set32(sres,i*12+8,fb);
      if(oc==0){
        nrej=nrej+1;
        let fcs:i32=get32(AS,24);
        if(fcs==0){set32(AS,24,seq);}
        set32(AS,52,1);
      }
    }
    i=i+1;
  }
  return nrej;
}
fn h_zero_as(AS:[]u8)void {
  let i:i32=0;
  while(i<256){AS[i]=0;i=i+1;}
  return;
}
// ---- treatment arm ----
fn h_treat_arm(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  set32(LOG,0,0);
  let ntrain:i32=l_arm_setup(WB,KB,AS,LOG,TR,PR,train,form,sc);
  let cs:i32=l_arm_try_commit(WB,KB,AS,LOG,TR,PR,form,sc,train,ntrain,0);
  if(cs<0){return -1;}
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  let rounds:i32=0;
  while(nrej>0){
    if(rounds>=2){break;}
    let tt:i32=get32(AS,4);
    if(tt>=2000){break;}
    let cs2:i32=l_arm_revise(WB,KB,AS,LOG,TR,PR,form,sc,train,ntrain,cs);
    if(cs2<0){break;}
    nrej=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
    rounds=rounds+1;
  }
  return nrej;
}
// ---- C0 arm ----
fn h_c0_arm(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  let cs:i32=c0_run(WB,AS,TR,PR,train,form);
  if(cs<0){return -1;}
  let LOG:[]u8=z_alloc(32768);
  set32(LOG,0,0);
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  return nrej;
}
// ---- C1 arm ----
fn h_c1_arm(WB:[]u8, AS:[]u8, TR:[]u8, PR:[]u8, mem:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  let ntrain:i32=c1_observe(WB,mem);
  l_tr(AS,TR,0,"OBSERVE",ntrain,0,0,0);
  l_tr(AS,TR,0,"COMMIT",9,0,0,0);
  set32(AS,48,1);
  let LOG:[]u8=z_alloc(32768);
  set32(LOG,0,0);
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,mem,1,mem,sres);
  return nrej;
}
// ---- C3 arm ----
fn h_c3_arm(WB:[]u8, KB:[]u8, AS:[]u8, LOG:[]u8, TR:[]u8, PR:[]u8, train:[]u8, form:[]u8, sc:[]u8, sres:[]u8)i32 {
  h_zero_as(AS);
  set32(LOG,0,0);
  let cs:i32=c3_run(WB,KB,AS,LOG,TR,PR,train,form,sc);
  if(cs<0){return -1;}
  let nrej:i32=h_stakes(WB,AS,LOG,TR,PR,form,0,form,sres);
  return nrej;
}
// ---- scoring helpers (harness) ----
// heldout tallies from sres: returns packed (wrong, correct_det, abst_und, D_det, D_und)
fn h_held_tally(WB:[]u8, sres:[]u8, out:[]u8)void {
  let ns:i32=get32(WB,12);
  let meta:[]u8=z_alloc(8);
  let wrong:i32=0;
  let cdet:i32=0;
  let aud:i32=0;
  let ddet:i32=0;
  let dund:i32=0;
  let i:i32=0;
  while(i<ns){
    w_stakes_meta(WB,i,meta);
    let held:i32=get32(meta,0);
    let det:i32=get32(meta,4);
    if(held==1){
      let v:i32=get32(sres,i*12);
      let so:i32=get32(WB,get32(WB,40)+i*20);
      let sx:i32=get32(WB,get32(WB,40)+i*20+4);
      let sy:i32=get32(WB,get32(WB,40)+i*20+8);
      // map indices to ids for w_truth
      let eoff:i32=get32(WB,16);
      let coff:i32=get32(WB,20);
      let t:i32=w_truth_idx(WB,so,sx,sy);
      if(det==0){
        ddet=ddet+1;
        if(v==-1){}
        else {
          if(v==t){cdet=cdet+1;}
          else {wrong=wrong+1;}
        }
      } else {
        dund=dund+1;
        if(v==-1){aud=aud+1;}
        else {
          // F-FABRICATION: any predicted undetermined pair is wrong,
          // even if luckily correct (it was not abstained).
          wrong=wrong+1;
        }
      }
    }
    i=i+1;
  }
  set32(out,0,wrong);
  set32(out,4,cdet);
  set32(out,8,aud);
  set32(out,12,ddet);
  set32(out,16,dund);
  return;
}
// T0(iii) / stakes-shape check on the LAST sres:
// det queries: no REJECT; undet queries: all ABSTAIN.
fn h_stakes_shape(WB:[]u8, sres:[]u8)i32 {
  let ns:i32=get32(WB,12);
  let meta:[]u8=z_alloc(8);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    w_stakes_meta(WB,i,meta);
    let det:i32=get32(meta,4);
    let v:i32=get32(sres,i*12);
    let oc:i32=get32(sres,i*12+4);
    if(det==0){
      if(oc==0){ok=0;}
    } else {
      if(v!=-1){ok=0;}
    }
    i=i+1;
  }
  return ok;
}
fn d_bar2(ob:[]u8, atp:[]u8, name:[]u8, pass:i32)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  if(pass==1){at=ob_app(ob,at," PASS\n");}
  else {at=ob_app(ob,at," FAIL\n");}
  set32(atp,0,at);
  return;
}
fn d_pend(ob:[]u8, atp:[]u8, name:[]u8)void {
  let at:i32=get32(atp,0);
  at=ob_app(ob,at,name);
  at=ob_app(ob,at," PENDING\n");
  set32(atp,0,at);
  return;
}
// dump a text buffer section
fn h_dumpsec(ob:[]u8, atp:[]u8, title:[]u8, buf:[]u8, len:i32)void {
  e0(ob,atp,title);
  let at:i32=get32(atp,0);
  let i:i32=0;
  while(i<len){
    ob[at]=buf[i];
    at=at+1;
    i=i+1;
  }
  set32(atp,0,at);
  return;
}

// learner.zag -- LEARNER side for L3-SUF-1 (treatment).
// Part 1: consequence log, surviving-set computation, flat forms,
// trace/proto emit, kb.
//
// SOURCE/AUDIT NOTE (A-LIT): this source contains NO resolution schema,
// NO marking rule ("mark unresolved when..."), NO abstention policy, and
// NO trigger counter/threshold. It contains: (a) a mechanical
// per-element consequence log (3c); (b) the sole-survivor principle at
// three scales (3d) computed as surviving value sets over that log;
// (c) the frozen escalation enumeration with generic replay (3e);
// (d) generic form-edit operators (ARITY-LIFT/GUARD/UNION/PROJECT);
// (e) a generic evaluator answering over the committed slot (3f).
// The three epistemic states are never named in source; they are the
// cardinalities (1/0/>1) of the surviving set. The per-element record
// STRUCTURE is created at runtime by ARITY-LIFT during escalation;
// its CONTENT is replayed from the consequence log (experience).

// ---- consequence log ----
// LOG layout: 0: nlog; 4: entries, 6 i32s each:
//   (elemkey, kind, value, outcome, fab, seq)
// elemkey = s0*1000000 + min(x,y)*1000 + max(x,y)  (ids < 1000)
// kind: 0=OBSERVE, 1=TEST, 2=STAKES
// outcome: 0=REJECT, 1=ACCEPT, 2=NEUTRAL(ABSTAIN)
// fab: 1 if the presented value came from the tie-break (no evidence)
fn l_ekey(s0:i32, x:i32, y:i32)i32 {
  let a:i32=x;
  let b:i32=y;
  if(a>b){let t:i32=a;a=b;b=t;}
  return s0*1000000+a*1000+b;
}
fn l_ekey_s0(ek:i32)i32 { return ek/1000000; }
fn l_log_touch(log:[]u8, ek:i32, kind:i32, value:i32, outcome:i32, fab:i32, seq:i32)i32 {
  let n:i32=get32(log,0);
  set32(log,4+n*24,ek);
  set32(log,4+n*24+4,kind);
  set32(log,4+n*24+8,value);
  set32(log,4+n*24+12,outcome);
  set32(log,4+n*24+16,fab);
  set32(log,4+n*24+20,seq);
  set32(log,0,n+1);
  return n+1;
}
// ---- surviving value set (sole-survivor at element scale) ----
// Returns bitmask: bit0 (1) = value 0 survives, bit1 (2) = value 1 survives.
// Derived ONLY from the consequence log. No thresholds, no counters,
// no world-property branches.
// Structural facts used:
//  (i)   worlds are deterministic, so both TEST-values REJECTed with
//        neither ACCEPTed and no observation means the world withholds
//        (unprobeable): no evidence either way -> both survive.
//  (ii)  a stakes REJECT on a fabricated (tie-break, fab=1) prediction
//        falsifies the act of predicting without evidence, not the
//        value: the element is explicitly not-known -> both survive.
//  (iii) otherwise a value is falsified by an observation of the other
//        value, a TEST REJECT of itself, or a TEST/STAKES ACCEPT of the
//        other value (evidence-backed).
fn l_surviving(log:[]u8, ek:i32)i32 {
  let o0:i32=0;
  let o1:i32=0;
  let r0r:i32=0;
  let r1r:i32=0;
  let r0a:i32=0;
  let r1a:i32=0;
  let fabrej:i32=0;
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    let e:i32=get32(log,base);
    if(e==ek){
      let kd:i32=get32(log,base+4);
      let vv:i32=get32(log,base+8);
      let oc:i32=get32(log,base+12);
      let fb:i32=get32(log,base+16);
      if(kd==0){
        if(vv==0){o0=1;}
        if(vv==1){o1=1;}
      }
      if(kd==1){
        if(oc==0){
          if(vv==0){r0r=1;}
          if(vv==1){r1r=1;}
        }
        if(oc==1){
          if(vv==0){r0a=1;}
          if(vv==1){r1a=1;}
        }
      }
      if(kd==2){
        if(fb==1){
          if(oc==0){fabrej=1;}
        } else {
          if(oc==0){
            if(vv==0){r0r=1;}
            if(vv==1){r1r=1;}
          }
          if(oc==1){
            if(vv==0){r0a=1;}
            if(vv==1){r1a=1;}
          }
        }
      }
    }
    i=i+1;
  }
  let noobs:i32=0;
  if(o0==0){
    if(o1==0){noobs=1;}
  }
  if(noobs==1){
    if(r0r==1){
      if(r1r==1){
        if(r0a==0){
          if(r1a==0){return 3;}
        }
      }
    }
    if(fabrej==1){return 3;}
  }
  let f0:i32=0;
  if(o1==1){f0=1;}
  if(r0r==1){f0=1;}
  if(r1a==1){f0=1;}
  let f1:i32=0;
  if(o0==1){f1=1;}
  if(r1r==1){f1=1;}
  if(r0a==1){f1=1;}
  let s:i32=3;
  if(f0==1){s=s-1;}
  if(f1==1){s=s-2;}
  return s;
}
// provenance bitmask for an element (which evidence kinds touched it)
fn l_prov(log:[]u8, ek:i32)i32 {
  let p:i32=0;
  let n:i32=get32(log,0);
  let i:i32=0;
  while(i<n){
    let base:i32=4+i*24;
    if(get32(log,base)==ek){
      let kd:i32=get32(log,base+4);
      if(kd==0){p=p|1;}
      if(kd==1){p=p|2;}
      if(kd==2){p=p|4;}
    }
    i=i+1;
  }
  return p;
}
// ---- flat forms ----
// Form buffer:
//   0: kind (0=pairtable, 1=guarded, 2=graded)
//   4: n (entries)
//   8: rec_off (kind2: byte offset of record section; else 0)
//   12: entries (s0,x,y,d)*n, 16 bytes each (s0=-1 for kind0)
//   (kind2) rec_off: nrec i32, then (s0,x,y,mask,prov)*nrec, 20 bytes
// The DOCUMENTED ungraded bug (RK-B): default-fill by id order.
fn l_tiebreak(x:i32, y:i32)i32 {
  if(x<y){return 1;}
  return 0;
}
fn l_form_new(f:[]u8, kind:i32)void {
  set32(f,0,kind);
  set32(f,4,0);
  set32(f,8,0);
  return;
}
fn l_form_add(f:[]u8, s0:i32, x:i32, y:i32, d:i32)void {
  let n:i32=get32(f,4);
  let base:i32=12+n*16;
  set32(f,base,s0);
  set32(f,base+4,x);
  set32(f,base+8,y);
  set32(f,base+12,d);
  set32(f,4,n+1);
  return;
}
// find entry index or -1. kind0 ignores s0.
fn l_form_find(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let kind:i32=get32(f,0);
  let n:i32=get32(f,4);
  let i:i32=0;
  while(i<n){
    let base:i32=12+i*16;
    let es:i32=get32(f,base);
    let ex:i32=get32(f,base+4);
    let ey:i32=get32(f,base+8);
    let sm:i32=0;
    if(kind==0){sm=1;}
    else { if(es==s0){sm=1;} }
    if(sm==1){
      if(ex==x){
        if(ey==y){return i;}
      }
      if(ex==y){
        if(ey==x){return i;}
      }
    }
    i=i+1;
  }
  return -1;
}
// record lookup for kind2; returns mask or -1 if absent
fn l_rec_lookup(f:[]u8, s0:i32, x:i32, y:i32)i32 {
  let roff:i32=get32(f,8);
  if(roff==0){return -1;}
  let nrec:i32=get32(f,roff);
  let i:i32=0;
  while(i<nrec){
    let base:i32=roff+4+i*20;
    let es:i32=get32(f,base);
    let ex:i32=get32(f,base+4);
    let ey:i32=get32(f,base+8);
    if(es==s0){
      let hit:i32=0;
      if(ex==x){ if(ey==y){hit=1;} }
      if(ex==y){ if(ey==x){hit=1;} }
      if(hit==1){return get32(f,base+12);}
    }
    i=i+1;
  }
  return -1;
}
// predict: out[0]=value (-1 ABSTAIN), out[1]=fab(1 if tie-break used)
fn l_predict2(f:[]u8, s0:i32, x:i32, y:i32, out:[]u8)void {
  let kind:i32=get32(f,0);
  if(kind==2){
    let m:i32=l_rec_lookup(f,s0,x,y);
    if(m==1){set32(out,0,0);set32(out,4,0);return;}
    if(m==2){set32(out,0,1);set32(out,4,0);return;}
    set32(out,0,-1);set32(out,4,0);return;
  }
  let fi:i32=l_form_find(f,s0,x,y);
  if(fi>=0){
    let d:i32=get32(f,12+fi*16+12);
    set32(out,0,d);set32(out,4,0);return;
  }
  set32(out,0,l_tiebreak(x,y));set32(out,4,1);return;
}
// ---- trace / proto emit ----
// trace line: S<seq> P<parent> <name> <a1> <a2> <a3> <a4>
fn l_tr(AS:[]u8, TR:[]u8, parent:i32, name:[]u8, a1:i32, a2:i32, a3:i32, a4:i32)i32 {
  let at:i32=get32(AS,68);
  let seq:i32=get32(AS,0);
  at=ob_app(TR,at,"S");
  at=ob_i32(TR,at,seq);
  at=ob_app(TR,at," P");
  at=ob_i32(TR,at,parent);
  at=ob_app(TR,at," ");
  at=ob_app(TR,at,name);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a1);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a2);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a3);
  at=ob_app(TR,at," ");
  at=ob_i32(TR,at,a4);
  at=ob_nl(TR,at);
  set32(AS,68,at);
  set32(AS,0,seq+1);
  return seq;
}
fn l_pr(AS:[]u8, PR:[]u8, s:[]u8)void {
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,s);
  at=ob_nl(PR,at);
  set32(AS,72,at);
  return;
}
fn l_pr_test(AS:[]u8, PR:[]u8, s0:i32, x:i32, y:i32, v:i32, r:i32)void {
  let at:i32=get32(AS,72);
  at=ob_app(PR,at,"> TEST s0=");
  at=ob_i32(PR,at,s0);
  at=ob_app(PR,at," x=");
  at=ob_i32(PR,at,x);
  at=ob_app(PR,at," y=");
  at=ob_i32(PR,at,y);
  at=ob_app(PR,at," v=");
  at=ob_i32(PR,at,v);
  if(r==1){at=ob_app(PR,at," => ACCEPT");}
  else {at=ob_app(PR,at," => REJECT");}
  at=ob_nl(PR,at);
  set32(AS,72,at);
  return;
}
// ---- kb ----
// KB layout: 0:valid 4:template(sticky max) 8:form copy (fixed 16KB region)
fn l_kb_store(KB:[]u8, f:[]u8, tmpl:i32)void {
  set32(KB,0,1);
  let old:i32=get32(KB,4);
  if(old>tmpl){tmpl=old;}
  set32(KB,4,tmpl);
  let i:i32=0;
  while(i<16384){
    KB[8+i]=f[i];
    i=i+1;
  }
  return;
}
fn l_kb_wipe(KB:[]u8)void {
  set32(KB,0,0);
  set32(KB,4,0);
  return;
}

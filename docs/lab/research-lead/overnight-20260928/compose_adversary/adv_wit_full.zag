// adv_sub.zag -- minimal INDEPENDENT substrate for the witness checker.
// Reimplements only: arena alloc, little-endian i32 access, fact
// store, MAP table, WALK/COUNT/ADD2 execution, missing-fact -> -2.
// This is a from-scratch reimplementation for cross-checking the
// world builders; it contains NO mechanism code (no search, no
// thunks, no memory). Arena layout mirrors the builders'
// world arena: 0: nf, 4: facts 64*12 bytes, 772: MAP table
// 40*32 bytes (8 fields of 4 bytes: class, rel, inmask, outmask,
// inmask1, inmask2, arity, nobs).

fn aw_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn aw_get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn aw_set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn aw_ag(A:[]u8,off:i32)i32 { return aw_get32(A,off); }
fn aw_ap(A:[]u8,off:i32,v:i32)void { aw_set32(A,off,v); return; }
fn aw_mg(A:[]u8,m:i32,f:i32)i32 { return aw_get32(A,772+m*32+f*4); }
fn aw_mp(A:[]u8,m:i32,f:i32,v:i32)void { aw_set32(A,772+m*32+f*4,v); return; }
// ---- output helpers (single-buffer rule) ----
fn awo_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn awo_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn awo_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn awo_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- substrate API (same signatures as the builders) ----
fn map_new(A:[]u8,m:i32,cl:i32,rel:i32,inm:i32,outm:i32,inm1:i32,inm2:i32,ar:i32)void {
  aw_mp(A,m,0,cl); aw_mp(A,m,1,rel); aw_mp(A,m,2,inm); aw_mp(A,m,3,outm);
  aw_mp(A,m,4,inm1); aw_mp(A,m,5,inm2); aw_mp(A,m,6,ar); aw_mp(A,m,7,0);
  return;
}
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=aw_ag(A,0);
  if(n<64){
    aw_set32(A,4+n*12,s); aw_set32(A,4+n*12+4,r); aw_set32(A,4+n*12+8,o);
    aw_ap(A,0,n+1);
  }
  return;
}
fn aw_fact1(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=aw_ag(A,0);
  let i:i32=0;
  while(i<n){
    let fs:i32=aw_get32(A,4+i*12);
    let fr:i32=aw_get32(A,4+i*12+4);
    if(fs==s && fr==rel){ return aw_get32(A,4+i*12+8); }
    i=i+1;
  }
  return -2;
}
fn aw_count_rel(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=aw_ag(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    let fs:i32=aw_get32(A,4+i*12);
    let fr:i32=aw_get32(A,4+i*12+4);
    if(fs==s && fr==rel){ c=c+1; }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
// ---- direct MAP execution (arity 1 and 2) ----
fn aw_exec1(A:[]u8,m:i32,v:i32)i32 {
  let cl:i32=aw_mg(A,m,0);
  let rel:i32=aw_mg(A,m,1);
  if(cl==0){ return aw_fact1(A,v,rel); }
  if(cl==1){ return aw_count_rel(A,v,rel); }
  return -2;
}
fn aw_exec2(A:[]u8,m:i32,v1:i32,v2:i32)i32 {
  let cl:i32=aw_mg(A,m,0);
  if(cl==4){
    if(v1==-2){ return -2; }
    if(v2==-2){ return -2; }
    return v1+v2;
  }
  return -2;
}
// adv_worlds.zag -- COMPOSE-ADVERSARY sealed world builders.
// Pure Zag. Transcription of PREREG.md Section 4 (frozen).
// Uses the substrate API (map_new, fact_add) shared by all three
// frozen mechanisms, so these functions are drop-in replacements
// for the builders' w_* world functions at sealed-evaluation time.
// map_new(A,m,class,rel,inmask,outmask,inmask1,inmask2,arity).
// Classes: 0=WALK, 1=COUNT, 4=ADD2. Kinds 1/2 are opaque.

// F-A1 CHAIN15: 15-link chain (A: frame explosion; B: depth; C: cold).
fn w_adv_chain15(A:[]u8) void {
  let i:i32=0;
  while(i<15){
    map_new(A,i,0,61+i,1,1,0,0,1);
    fact_add(A,501+i,61+i,502+i);
    i=i+1;
  }
  map_new(A,15,1,76,1,2,0,0,1);
  fact_add(A,516,76,801); fact_add(A,516,76,802);
  fact_add(A,516,76,803); fact_add(A,516,76,804);
  return;
}
// F-B1 CHAIN7: 7-link chain (B depth cap: 6 max).
fn w_adv_chain7(A:[]u8) void {
  let i:i32=0;
  while(i<7){
    map_new(A,i,0,61+i,1,1,0,0,1);
    fact_add(A,501+i,61+i,502+i);
    i=i+1;
  }
  map_new(A,7,1,68,1,2,0,0,1);
  fact_add(A,508,68,801); fact_add(A,508,68,802);
  fact_add(A,508,68,803); fact_add(A,508,68,804);
  return;
}
// F-B2 SUBCAP: correct = C1(W3(W2(s))); B's 128 sub-buffer fills
// with W1-rooted chains, so the W3-rooted program is never built.
fn w_adv_subcap(A:[]u8) void {
  map_new(A,0,1,71,1,2,0,0,1);
  map_new(A,1,1,72,1,2,0,0,1);
  map_new(A,2,1,73,1,2,0,0,1);
  map_new(A,3,1,74,1,2,0,0,1);
  let i:i32=0;
  while(i<11){
    map_new(A,4+i,0,81+i,1,1,0,0,1);
    i=i+1;
  }
  fact_add(A,501,82,601);
  fact_add(A,601,83,602);
  fact_add(A,602,71,701); fact_add(A,602,71,702);
  fact_add(A,602,71,703); fact_add(A,602,71,704);
  fact_add(A,501,81,699);
  return;
}
// F-C1 TEACH: 2-chain [X,Y]; C stores it as E1.
fn w_adv_teach(A:[]u8) void {
  map_new(A,1,0,91,1,1,0,0,1);
  map_new(A,2,1,92,1,2,0,0,1);
  fact_add(A,201,91,211);
  fact_add(A,211,92,901); fact_add(A,211,92,902); fact_add(A,211,92,903);
  return;
}
// F-C1 TRAP1: 16-map inventory; codes superset of TEACH -> sim 2.
// Correct = [Z,X,Y]; retrieved [X,Y] misfires, R1-R4 cannot prepend.
fn w_adv_trap1(A:[]u8) void {
  map_new(A,0,0,90,1,1,0,0,1);
  map_new(A,1,0,91,1,1,0,0,1);
  let i:i32=0;
  while(i<10){
    map_new(A,2+i,0,93+i,1,1,0,0,1);
    fact_add(A,201,93+i,700+i);
    i=i+1;
  }
  map_new(A,12,1,92,1,2,0,0,1);
  map_new(A,13,1,103,1,2,0,0,1);
  map_new(A,14,1,104,1,2,0,0,1);
  map_new(A,15,1,105,1,2,0,0,1);
  fact_add(A,201,90,211);
  fact_add(A,211,91,212);
  fact_add(A,212,92,911); fact_add(A,212,92,912); fact_add(A,212,92,913);
  fact_add(A,212,92,914); fact_add(A,212,92,915);
  fact_add(A,201,103,921); fact_add(A,201,103,922);
  fact_add(A,201,104,923); fact_add(A,201,104,924);
  fact_add(A,201,105,925); fact_add(A,201,105,926);
  return;
}
// D-C2 TRAP2: same inventory; correct = [W1,X,Y] (1-edit from
// TRAP1's stored [Z,X,Y]; R1 SUBST_FAILED repairs it).
fn w_adv_trap2(A:[]u8) void {
  map_new(A,0,0,90,1,1,0,0,1);
  map_new(A,1,0,91,1,1,0,0,1);
  let i:i32=0;
  while(i<10){
    map_new(A,2+i,0,93+i,1,1,0,0,1);
    i=i+1;
  }
  map_new(A,12,1,92,1,2,0,0,1);
  map_new(A,13,1,103,1,2,0,0,1);
  map_new(A,14,1,104,1,2,0,0,1);
  map_new(A,15,1,105,1,2,0,0,1);
  fact_add(A,201,93,213);
  fact_add(A,213,91,212);
  fact_add(A,212,92,911); fact_add(A,212,92,912); fact_add(A,212,92,913);
  fact_add(A,212,92,914); fact_add(A,212,92,915);
  return;
}
// D-C1 TEACH-D: diamond (stores E1 for transfer).
fn w_adv_teachd(A:[]u8) void {
  map_new(A,0,0,91,1,1,0,0,1);
  map_new(A,1,1,92,1,2,0,0,1);
  map_new(A,2,1,94,1,2,0,0,1);
  map_new(A,3,4,0,0,2,2,2,2);
  fact_add(A,202,91,211);
  fact_add(A,211,92,901); fact_add(A,211,92,902); fact_add(A,211,92,903);
  fact_add(A,211,94,911); fact_add(A,211,94,912);
  return;
}
// D-C1 T-FANIN: 2-leg fan-in; diamond memory transfers via
// DROP_UNMAPPED (X unmapped -> legs rewired to CONST).
fn w_adv_tfanin(A:[]u8) void {
  map_new(A,0,1,71,1,2,0,0,1);
  map_new(A,1,1,72,1,2,0,0,1);
  map_new(A,2,4,0,0,2,2,2,2);
  fact_add(A,401,71,701); fact_add(A,401,71,702); fact_add(A,401,71,703);
  fact_add(A,401,72,704); fact_add(A,401,72,705);
  return;
}
// D-C1 T-CHAIN: 2-chain; diamond memory transfers via
// DROP_UNMAPPED (G unmapped -> dropped; last instr Wp wins).
fn w_adv_tchain(A:[]u8) void {
  map_new(A,0,0,91,1,1,0,0,1);
  map_new(A,1,1,92,1,2,0,0,1);
  map_new(A,2,1,94,1,2,0,0,1);
  fact_add(A,301,91,311);
  fact_add(A,311,92,801); fact_add(A,311,92,802);
  fact_add(A,311,92,803); fact_add(A,311,92,804);
  fact_add(A,311,94,811); fact_add(A,311,94,812); fact_add(A,311,94,813);
  return;
}
// D-B1 / S-ALL1 CYCLE: one WALK on a cyclic relation.
fn w_adv_cycle(A:[]u8) void {
  map_new(A,0,0,61,1,1,0,0,1);
  fact_add(A,501,61,502);
  fact_add(A,502,61,503);
  fact_add(A,503,61,502);
  return;
}
// X-CHAIN5: 5-link chain, fresh relations.
fn w_adv_chain5(A:[]u8) void {
  let i:i32=0;
  while(i<5){
    map_new(A,i,0,61+i,1,1,0,0,1);
    fact_add(A,501+i,61+i,502+i);
    i=i+1;
  }
  map_new(A,5,1,66,1,2,0,0,1);
  let k:i32=0;
  while(k<6){
    fact_add(A,506,66,801+k);
    k=k+1;
  }
  return;
}
// X-FANOUT5: X -> 5 COUNT consumers -> 4-ADD2 join tree.
fn w_adv_fanout5(A:[]u8) void {
  map_new(A,0,0,91,1,1,0,0,1);
  let i:i32=0;
  while(i<5){
    map_new(A,1+i,1,92+i,1,2,0,0,1);
    i=i+1;
  }
  i=0;
  while(i<4){
    map_new(A,6+i,4,0,0,2,2,2,2);
    i=i+1;
  }
  fact_add(A,202,91,211);
  fact_add(A,211,92,901); fact_add(A,211,92,902);
  fact_add(A,211,93,903);
  fact_add(A,211,94,904); fact_add(A,211,94,905); fact_add(A,211,94,906);
  fact_add(A,211,95,907); fact_add(A,211,95,908);
  fact_add(A,211,96,909); fact_add(A,211,96,910);
  return;
}
// X-FANIN5: 5 WALK->COUNT legs -> 4-ADD2 join tree.
fn w_adv_fanin5(A:[]u8) void {
  let i:i32=0;
  while(i<5){
    map_new(A,i,0,61+i,1,1,0,0,1);
    map_new(A,5+i,1,71+i,1,2,0,0,1);
    i=i+1;
  }
  i=0;
  while(i<4){
    map_new(A,10+i,4,0,0,2,2,2,2);
    i=i+1;
  }
  fact_add(A,401,61,501); fact_add(A,501,71,701); fact_add(A,501,71,702);
  fact_add(A,401,62,502); fact_add(A,502,72,703); fact_add(A,502,72,704);
  fact_add(A,502,72,705);
  fact_add(A,401,63,503); fact_add(A,503,73,706);
  fact_add(A,401,64,504); fact_add(A,504,74,707); fact_add(A,504,74,708);
  fact_add(A,504,74,709); fact_add(A,504,74,710);
  fact_add(A,401,65,505); fact_add(A,505,75,711); fact_add(A,505,75,712);
  return;
}
// X-DAG10: 2-chain -> shared X -> two diamonds -> ADD2 join.
fn w_adv_dag10(A:[]u8) void {
  map_new(A,0,0,60,1,1,0,0,1);
  map_new(A,1,0,61,1,1,0,0,1);
  map_new(A,2,0,62,1,1,0,0,1);
  map_new(A,3,1,71,1,2,0,0,1);
  map_new(A,4,1,72,1,2,0,0,1);
  map_new(A,5,4,0,0,2,2,2,2);
  map_new(A,6,1,73,1,2,0,0,1);
  map_new(A,7,1,74,1,2,0,0,1);
  map_new(A,8,4,0,0,2,2,2,2);
  map_new(A,9,4,0,0,2,2,2,2);
  fact_add(A,301,60,302); fact_add(A,302,61,303); fact_add(A,303,62,310);
  fact_add(A,310,71,711); fact_add(A,310,71,712);
  fact_add(A,310,72,713); fact_add(A,310,72,714); fact_add(A,310,72,715);
  fact_add(A,310,73,716);
  fact_add(A,310,74,717); fact_add(A,310,74,718);
  fact_add(A,310,74,719); fact_add(A,310,74,720);
  return;
}
// X-PARTIAL: 5-leg fan-in; legs 4,5 factless (partial applicability).
fn w_adv_partial(A:[]u8) void {
  let i:i32=0;
  while(i<5){
    map_new(A,i,0,61+i,1,1,0,0,1);
    map_new(A,5+i,1,71+i,1,2,0,0,1);
    i=i+1;
  }
  i=0;
  while(i<4){
    map_new(A,10+i,4,0,0,2,2,2,2);
    i=i+1;
  }
  fact_add(A,401,61,501); fact_add(A,501,71,701); fact_add(A,501,71,702);
  fact_add(A,401,62,502); fact_add(A,502,72,703); fact_add(A,502,72,704);
  fact_add(A,502,72,705);
  fact_add(A,401,63,503); fact_add(A,503,73,706); fact_add(A,503,73,707);
  fact_add(A,503,73,708); fact_add(A,503,73,709); fact_add(A,503,73,710);
  return;
}
// adv_witness.zag -- sealed-world well-formedness checker.
// Builds each adv_worlds.zag world on the INDEPENDENT substrate
// (adv_sub.zag) and executes the PREREG Section 4 witness program
// for its query, asserting the value equals exp. Uses NO mechanism
// code: a PASS means the world is solvable with the stated answer;
// it says nothing about what any mechanism will do (that is the
// sealed evaluation's job).

fn aw_check(B:[]u8,c:i32,name:[]u8,got:i32,exp:i32) i32 {
  c=awo_app(B,c,name);
  c=awo_app(B,c," got=");
  c=awo_i64(B,c,got as i64);
  c=awo_app(B,c," exp=");
  c=awo_i64(B,c,exp as i64);
  if(got==exp){
    c=awo_app(B,c," PASS");
  } else {
    c=awo_app(B,c," FAIL");
  }
  c=awo_nl(B,c);
  return c;
}
fn aw_nf(B:[]u8,c:i32,nf:i32,name:[]u8,got:i32,exp:i32) i32 {
  if(got==exp){ return nf; }
  return nf+1;
}
// n-link chain then COUNT id cm from s (WALK ids 0..n-1).
fn wit_chain(A:[]u8,n:i32,cm:i32,s:i32) i32 {
  let v:i32=s;
  let i:i32=0;
  while(i<n){
    v=aw_exec1(A,i,v);
    i=i+1;
  }
  v=aw_exec1(A,cm,v);
  return v;
}
fn main() i32 {
  let B:[]u8=aw_alloc(65536);
  let c:i32=0;
  let nf:i32=0;
  let A:[]u8=aw_alloc(8192);
  // F-A1 CHAIN15
  A=aw_alloc(8192); w_adv_chain15(A);
  let g:i32=wit_chain(A,15,15,501);
  nf=aw_nf(B,c,nf,"CHAIN15",g,4);
  c=aw_check(B,c,"CHAIN15",g,4);
  // F-B1 CHAIN7
  A=aw_alloc(8192); w_adv_chain7(A);
  g=wit_chain(A,7,7,501);
  nf=aw_nf(B,c,nf,"CHAIN7",g,4);
  c=aw_check(B,c,"CHAIN7",g,4);
  // F-B2 SUBCAP: C1(W3(W2(501)))
  A=aw_alloc(8192); w_adv_subcap(A);
  g=aw_exec1(A,0,aw_exec1(A,6,aw_exec1(A,5,501)));
  nf=aw_nf(B,c,nf,"SUBCAP",g,4);
  c=aw_check(B,c,"SUBCAP",g,4);
  // F-C1 TEACH: Y(X(201))
  A=aw_alloc(8192); w_adv_teach(A);
  g=aw_exec1(A,2,aw_exec1(A,1,201));
  nf=aw_nf(B,c,nf,"TEACH",g,3);
  c=aw_check(B,c,"TEACH",g,3);
  // F-C1 TRAP1: Y(X(Z(201)))
  A=aw_alloc(8192); w_adv_trap1(A);
  g=aw_exec1(A,12,aw_exec1(A,1,aw_exec1(A,0,201)));
  nf=aw_nf(B,c,nf,"TRAP1",g,5);
  c=aw_check(B,c,"TRAP1",g,5);
  // D-C2 TRAP2: Y(X(W1(201)))
  A=aw_alloc(8192); w_adv_trap2(A);
  g=aw_exec1(A,12,aw_exec1(A,1,aw_exec1(A,2,201)));
  nf=aw_nf(B,c,nf,"TRAP2",g,5);
  c=aw_check(B,c,"TRAP2",g,5);
  // D-C1 TEACH-D: G(Y(X(202)),W(X(202)))
  A=aw_alloc(8192); w_adv_teachd(A);
  let xv:i32=aw_exec1(A,0,202);
  g=aw_exec2(A,3,aw_exec1(A,1,xv),aw_exec1(A,2,xv));
  nf=aw_nf(B,c,nf,"TEACHD",g,5);
  c=aw_check(B,c,"TEACHD",g,5);
  // D-C1 T-FANIN: G1(C1(401),C2(401))
  A=aw_alloc(8192); w_adv_tfanin(A);
  g=aw_exec2(A,2,aw_exec1(A,0,401),aw_exec1(A,1,401));
  nf=aw_nf(B,c,nf,"TFANIN",g,5);
  c=aw_check(B,c,"TFANIN",g,5);
  // D-C1 T-CHAIN: Wp(Xp(301))
  A=aw_alloc(8192); w_adv_tchain(A);
  g=aw_exec1(A,2,aw_exec1(A,0,301));
  nf=aw_nf(B,c,nf,"TCHAIN",g,3);
  c=aw_check(B,c,"TCHAIN",g,3);
  // D-B1 CYCLE-2HOP: Wc(Wc(501))
  A=aw_alloc(8192); w_adv_cycle(A);
  g=aw_exec1(A,0,aw_exec1(A,0,501));
  nf=aw_nf(B,c,nf,"CYC2",g,503);
  c=aw_check(B,c,"CYC2",g,503);
  // S-ALL1 CYCLE-3HOP: Wc(Wc(Wc(501)))
  A=aw_alloc(8192); w_adv_cycle(A);
  g=aw_exec1(A,0,aw_exec1(A,0,aw_exec1(A,0,501)));
  nf=aw_nf(B,c,nf,"CYC3",g,502);
  c=aw_check(B,c,"CYC3",g,502);
  // X-CHAIN5
  A=aw_alloc(8192); w_adv_chain5(A);
  g=wit_chain(A,5,5,501);
  nf=aw_nf(B,c,nf,"CHAIN5",g,6);
  c=aw_check(B,c,"CHAIN5",g,6);
  // X-FANOUT5
  A=aw_alloc(8192); w_adv_fanout5(A);
  let fv:i32=aw_exec1(A,0,202);
  let fy1:i32=aw_exec1(A,1,fv);
  let fy2:i32=aw_exec1(A,2,fv);
  let fy3:i32=aw_exec1(A,3,fv);
  let fy4:i32=aw_exec1(A,4,fv);
  let fy5:i32=aw_exec1(A,5,fv);
  let fg1:i32=aw_exec2(A,6,fy1,fy2);
  let fg2:i32=aw_exec2(A,7,fy3,fy4);
  let fg3:i32=aw_exec2(A,8,fg1,fg2);
  g=aw_exec2(A,9,fg3,fy5);
  nf=aw_nf(B,c,nf,"FANOUT5",g,10);
  c=aw_check(B,c,"FANOUT5",g,10);
  // X-FANIN5
  A=aw_alloc(8192); w_adv_fanin5(A);
  let fl1:i32=aw_exec1(A,5,aw_exec1(A,0,401));
  let fl2:i32=aw_exec1(A,6,aw_exec1(A,1,401));
  let fl3:i32=aw_exec1(A,7,aw_exec1(A,2,401));
  let fl4:i32=aw_exec1(A,8,aw_exec1(A,3,401));
  let fl5:i32=aw_exec1(A,9,aw_exec1(A,4,401));
  let ng1:i32=aw_exec2(A,10,fl1,fl2);
  let ng2:i32=aw_exec2(A,11,ng1,fl3);
  let ng3:i32=aw_exec2(A,12,ng2,fl4);
  g=aw_exec2(A,13,ng3,fl5);
  nf=aw_nf(B,c,nf,"FANIN5",g,12);
  c=aw_check(B,c,"FANIN5",g,12);
  // X-DAG10
  A=aw_alloc(8192); w_adv_dag10(A);
  let ds1:i32=aw_exec1(A,0,301);
  let ds2:i32=aw_exec1(A,1,ds1);
  let dv:i32=aw_exec1(A,2,ds2);
  let da1:i32=aw_exec1(A,3,dv);
  let db1:i32=aw_exec1(A,4,dv);
  let dg1:i32=aw_exec2(A,5,da1,db1);
  let da2:i32=aw_exec1(A,6,dv);
  let db2:i32=aw_exec1(A,7,dv);
  let dg2:i32=aw_exec2(A,8,da2,db2);
  g=aw_exec2(A,9,dg1,dg2);
  nf=aw_nf(B,c,nf,"DAG10",g,10);
  c=aw_check(B,c,"DAG10",g,10);
  // X-PARTIAL: 3 live legs
  A=aw_alloc(8192); w_adv_partial(A);
  let pl1:i32=aw_exec1(A,5,aw_exec1(A,0,401));
  let pl2:i32=aw_exec1(A,6,aw_exec1(A,1,401));
  let pl3:i32=aw_exec1(A,7,aw_exec1(A,2,401));
  let pg1:i32=aw_exec2(A,10,pl1,pl2);
  g=aw_exec2(A,11,pg1,pl3);
  nf=aw_nf(B,c,nf,"PARTIAL",g,10);
  c=aw_check(B,c,"PARTIAL",g,10);
  c=awo_app(B,c,"WITNESS-FAILURES=");
  c=awo_i64(B,c,nf as i64);
  c=awo_nl(B,c);
  awo_flush(B,c);
  return 0;
}

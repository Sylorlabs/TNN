// eval_main_b.zag -- TEMPLATE for the sealed evaluator (Hypothesis B).
// Concat order: sus_base.zag sus_thunk.zag sus_asm.zag sus_rev.zag
//               adv_worlds.zag eval_main_b.zag
// Compile with the pinned znc. Fresh A/S arenas per problem.
// Reports raw fields; the parent scores PREREG.md Section 5 bars.
// ematch: 1 = expect ANS==exp, 0 = expect ANS!=exp.

fn brep(B:[]u8,c:i32,name:[]u8,ans:i32,S:[]u8,ematch:i32,exp:i32) i32 {
  c=o_app(B,c,"PROB="); c=o_app(B,c,name); c=o_nl(B,c);
  c=o_app(B,c,"ANS="); c=o_i64(B,c,ans as i64); c=o_nl(B,c);
  c=o_app(B,c,"ASMSTEPS="); c=o_i64(B,c,sg(S,4) as i64); c=o_nl(B,c);
  c=o_app(B,c,"SEARCHRUNS="); c=o_i64(B,c,sg(S,8) as i64); c=o_nl(B,c);
  c=o_app(B,c,"WIDEN="); c=o_i64(B,c,sg(S,12) as i64); c=o_nl(B,c);
  c=o_app(B,c,"VIOL="); c=o_i64(B,c,sg(S,16) as i64); c=o_nl(B,c);
  c=o_app(B,c,"EXECTOT="); c=o_i64(B,c,sg(S,28) as i64); c=o_nl(B,c);
  c=o_app(B,c,"ANSMATCH=");
  let ok:i32=0;
  if(ematch==1){
    if(ans==exp){ ok=1; }
  } else {
    if(ans!=exp){ ok=1; }
  }
  if(ok==1){ c=o_app(B,c,"PASS"); } else { c=o_app(B,c,"FAIL"); }
  c=o_nl(B,c);
  return c;
}
fn bval(S:[]u8,A:[]u8,r:i32) i32 {
  if(r<0){ return -999; }
  return demand(S,A,r);
}
fn main() i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=z_alloc(8192);
  let S:[]u8=z_alloc(16384);
  let r:i32=0;
  let ans:i32=0;
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_chain15(A);
  r=solve(S,A,0,16,501,1,2,4); ans=bval(S,A,r);
  c=brep(B,c,"CHAIN15",ans,S,0,4);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_chain7(A);
  r=solve(S,A,0,8,501,1,2,4); ans=bval(S,A,r);
  c=brep(B,c,"CHAIN7",ans,S,0,4);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_subcap(A);
  r=solve(S,A,0,15,501,1,2,4); ans=bval(S,A,r);
  c=brep(B,c,"SUBCAP",ans,S,0,4);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_trap1(A);
  r=solve(S,A,0,16,201,1,2,5); ans=bval(S,A,r);
  c=brep(B,c,"TRAP1",ans,S,1,5);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_trap2(A);
  r=solve(S,A,0,16,201,1,2,5); ans=bval(S,A,r);
  c=brep(B,c,"TRAP2",ans,S,1,5);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_tfanin(A);
  r=solve(S,A,0,3,401,1,2,5); ans=bval(S,A,r);
  c=brep(B,c,"TFANIN",ans,S,1,5);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_tchain(A);
  r=solve(S,A,0,3,301,1,2,3); ans=bval(S,A,r);
  c=brep(B,c,"TCHAIN",ans,S,1,3);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_cycle(A);
  r=solve(S,A,0,1,501,1,1,503); ans=bval(S,A,r);
  c=brep(B,c,"CYC2",ans,S,1,503);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_cycle(A);
  r=solve(S,A,0,1,501,1,1,502); ans=bval(S,A,r);
  c=brep(B,c,"CYC3",ans,S,0,502);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_chain5(A);
  r=solve(S,A,0,6,501,1,2,6); ans=bval(S,A,r);
  c=brep(B,c,"CHAIN5",ans,S,1,6);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_fanout5(A);
  r=solve(S,A,0,10,202,1,2,10); ans=bval(S,A,r);
  c=brep(B,c,"FANOUT5",ans,S,1,10);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_fanin5(A);
  r=solve(S,A,0,14,401,1,2,12); ans=bval(S,A,r);
  c=brep(B,c,"FANIN5",ans,S,1,12);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_dag10(A);
  r=solve(S,A,0,10,301,1,2,10); ans=bval(S,A,r);
  c=brep(B,c,"DAG10",ans,S,1,10);
  A=z_alloc(8192); S=z_alloc(16384);
  w_adv_partial(A);
  r=solve(S,A,0,14,401,1,2,10); ans=bval(S,A,r);
  c=brep(B,c,"PARTIAL",ans,S,1,10);
  o_flush(B,c);
  return 0;
}

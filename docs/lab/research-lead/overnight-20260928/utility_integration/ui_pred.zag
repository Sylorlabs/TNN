// ============ Predictive utility: PRED mechanism (Micah Priority 6) ============
// Integrates learner-owned prediction (b320213f2) with MAP utility (c912b9b19).
// U (MAP f12) is now driven SOLELY by prediction outcomes, not fixed +2/-2.
//
// PRED node (tag 31): a recorded prediction awaiting outcome resolution.
//   f4: resolved (0=pending, 1=resolved)
//   f8: error (0=correct, 1=wrong; valid after resolve)
//   f12: struct_id (MAP node; MAP-only in this integration)
//   f16: struct_kind (20=MAP)
//   f20: s, f24: r, f28: predicted p, f32: tick
//
// Update rule (researcher scaffold, honestly labeled):
//   prediction correct -> util_add(MAP, +1)
//   prediction wrong   -> util_add(MAP, -1)
// Learner-owned: the U VALUES (from experience stream only), which MAPs rank
//   high, whether "predicts well" outranks "used frequently."

fn T_PRED()i32 { return 31; }

fn pred_record(W:[]u8,s:i32,r:i32,p:i32,sid:i32,kind:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,31);
  ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,sid); ns(W,n,16,kind);
  write_node(W,n,s,r,p,hg(W,0));
  return n;
}

// Resolve pending predictions against revealed outcome o.
// MAP U updated via util_add (floor -8, ceiling +127, L=now).
// No fixed event rewards. Prediction error is the sole U driver.
fn pred_resolve(W:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let err:i32=0;
        if(ng(W,n,28)!=o){ err=1; }
        ns(W,n,4,1); ns(W,n,8,err);
        let sid:i32=ng(W,n,12); let kind:i32=ng(W,n,16);
        if(sid>=2 && sid<1024 && ng(W,sid,36)==1 && kind==20){
          if(ng(W,sid,0)==20){
            let d:i32=1; if(err==1){ d=-1; }
            util_add(W,sid,d);
          }
        }
      }
    }
    n=n+1;
  }
  return;
}

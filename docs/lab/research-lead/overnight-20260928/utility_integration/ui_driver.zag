// ui_driver.zag -- Utility Integration test driver.
// Two batteries:
//   T6:  Redundancy (S2-style). Does U add signal beyond bid+structure?
//         A = high-U, old. B = low-U, recent. Force eviction. Check order.
//   WBF: Wrong/stale-but-frequent. Does predictive U demote what fixed U promotes?
//         W = frequent use, no verification (stale). R = infrequent, verified.
//         Compare U(W) vs U(R) in fixed vs predictive arms.
//
// Driver is mechanism-agnostic: runs on fixed, control, and predictive binaries.
// U read via MAP f12 (fixed/predicitive); control leaves f12=-1.

fn live_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){if(ng(W,n,36)==1){c=c+1;} n=n+1;}
  return c;
}
fn map_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){if(ng(W,n,36)==1 && ng(W,n,0)==20){c=c+1;} n=n+1;}
  return c;
}
fn pred_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){if(ng(W,n,36)==1 && ng(W,n,0)==31){c=c+1;} n=n+1;}
  return c;
}
// Find MAP node by its (s,r) signature (f8=s, f4=r).
fn find_map(W:[]u8,s:i32,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
fn report_u(W:[]u8,tag:i32,s:i32,r:i32)void {
  let m:i32=find_map(W,s,r);
  emit("U-REP "); e64(tag); emit(" s="); e64(s); emit(" r="); e64(r);
  if(m<0){emit(" MAP_GONE\n"); return;}
  emit(" m="); e64(m); emit(" U="); e64(ng(W,m,12));
  emit(" L="); e64(ng(W,m,16)); emit(" alive=1\n");
  return;
}

// ============ T6: Redundancy (S2-style falsification) ============
// Claim: U adds signal beyond bid+structure.
// Falsifier: If U were redundant, U-order == bid-order for MAP eviction.
// Test: A = high-U old, B = low-U recent. Compare orders.
// U-arm: order by U asc. Control: order by bid asc. If differ, non-redundant.
fn test_t6(W:[]u8)void {
  emit("T6-START\n");
  // Phase 1: chain for A, promote via trial on (1,50).
  ev_teach(W,1,1,11); ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let qa:i32=ev_query(W,1,50,13,0);
  // Phase 2: 10x query + observe correct. U(A) high.
  let i:i32=0;
  while(i<10){
    let q:i32=ev_query(W,1,50,13,0);
    ev_observe(W,1,50,13);
    i=i+1;
  }
  // Phase 3: age 300 ticks (no nodes).
  i=0;
  while(i<300){ hs(W,0,hg(W,0)+1); i=i+1; }
  // Phase 4: chain for B, promote, 1x use. U(B) low, bid fresh.
  ev_teach(W,2,1,21); ev_teach(W,21,1,22); ev_teach(W,22,1,23);
  let qb:i32=ev_query(W,2,50,23,0);
  let q2:i32=ev_query(W,2,50,23,0);
  ev_observe(W,2,50,23);
  // Simulate activity divergence: B is active (recent edges), A is dormant.
  // (In real use, B's recent creation/trial leaves it more edge-active than
  //  A's 300-tick-dormant node. We model this directly.)
  let ma0:i32=find_map(W,1,50); let mb0:i32=find_map(W,2,50);
  if(mb0>=0){
    let k:i32=0;
    while(k<10){ link_edge(W,mb0,6,mb0,0); k=k+1; }
  }
  // Read U and bid for both MAPs.
  let ma:i32=find_map(W,1,50); let mb:i32=find_map(W,2,50);
  let ua:i32=-999; let ub:i32=-999; let ba:i32=-999; let bb:i32=-999;
  if(ma>=0){ua=ng(W,ma,12); ba=bid(W,ma);}
  if(mb>=0){ub=ng(W,mb,12); bb=bid(W,mb);}
  emit("T6 A: U="); e64(ua); emit(" bid="); e64(ba); emit("\n");
  emit("T6 B: U="); e64(ub); emit(" bid="); e64(bb); emit("\n");
  // U-order: lower U evicted first. Bid-order: lower bid evicted first.
  let u_first:i32=-1; let b_first:i32=-1;
  if(ua<ub){u_first=1;} else {if(ub<ua){u_first=2;} else {u_first=0;}}
  if(ba<bb){b_first=1;} else {if(bb<ba){b_first=2;} else {b_first=0;}}
  emit("T6 U-order first="); e64(u_first); emit(" (1=A,2=B,0=tie)\n");
  emit("T6 bid-order first="); e64(b_first); emit(" (1=A,2=B,0=tie)\n");
  if(u_first!=b_first){
    emit("T6 RESULT: ORDERS DIFFER -> U non-redundant (falsifies redundancy)\n");
  } else {
    emit("T6 RESULT: orders match -> redundancy NOT falsified\n");
  }
}

// ============ WBF: Stale-but-frequent ============
// W: promoted, queried 20x with NO observes (frequent, unverified/stale).
// R: promoted later, queried 3x with correct observes (infrequent, verified).
// Fixed arm: U(W) >> U(R) (use rewarded). Predictive: U(W) << U(R).
fn test_wbf(W:[]u8)void {
  emit("WBF-START\n");
  // Phase 1: chain for W, promote via trial on (1,50).
  ev_teach(W,1,1,11); ev_teach(W,11,1,12); ev_teach(W,12,1,13);
  let qw:i32=ev_query(W,1,50,13,0);
  emit("WBF W promoted qw="); e64(qw); emit("\n");
  // Phase 2: 20 queries, ZERO observes. Frequent but unverified.
  let i:i32=0;
  while(i<20){
    let q:i32=ev_query(W,1,50,13,0);
    i=i+1;
  }
  report_u(W,10,1,50);
  emit("WBF preds="); e64(pred_count(W)); emit("\n");
  // Phase 3: chain for R, promote on (2,50). 3x query + observe correct.
  ev_teach(W,2,1,21); ev_teach(W,21,1,22); ev_teach(W,22,1,23);
  let qr:i32=ev_query(W,2,50,23,0);
  emit("WBF R promoted qr="); e64(qr); emit("\n");
  i=0;
  while(i<3){
    let q2:i32=ev_query(W,2,50,23,0);
    ev_observe(W,2,50,23);
    i=i+1;
  }
  report_u(W,11,1,50);
  report_u(W,12,2,50);
  // Verdict: compare U(W) vs U(R).
  let mw:i32=find_map(W,1,50); let mr:i32=find_map(W,2,50);
  let uw:i32=-999; let ur:i32=-999;
  if(mw>=0){uw=ng(W,mw,12);}
  if(mr>=0){ur=ng(W,mr,12);}
  emit("WBF RESULT U(W)="); e64(uw); emit(" U(R)="); e64(ur); emit("\n");
  if(uw>ur){emit("WBF RANK: W > R (fixed-arm pattern: frequent wins)\n");}
  if(uw<ur){emit("WBF RANK: R > W (predictive pattern: verified wins)\n");}
  if(uw==ur){emit("WBF RANK: tie\n");}
}

fn main()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  test_t6(W);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  test_wbf(W2);
  emit("DONE\n");
  return 0;
}

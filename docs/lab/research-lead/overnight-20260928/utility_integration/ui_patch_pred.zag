// ui_patch_pred.zag -- Predictive utility variant patches.
// Unfrozen variant only. Base: ui_base.zag (frozen, SHA-256 a29972ca...).
//
// Modified functions (verbatim replacements):
//   promote_graph: U=0/L=birth init, shadow f4=m. NO trial-success +2.
//     (Trial success is researcher-defined; prediction error is the sole driver.)
//   ev_query: on activate hit, if shadow FACT with valid owning MAP,
//     pred_record(s,r,answer,MAP,20). NO util_attr +1.
//     (Mere use does not earn utility; only correct prediction does.)
//   ev_observe: verbatim base + pred_resolve appended (three call sites).
//     (World outcome resolves pending predictions; U updated by correctness.)
//   evict_node: utility-aware (verbatim from ub_patch.zag).
//     Priority: ZOMBIE > FOSSIL > LIVE low-U > bid. Atomic reclaim, cell protection.
//
// NOT modified (base verbatim, in core):
//   contradict_map, revise_on_contradict: no fixed U updates.
//     (Contradiction/revision are researcher-defined events, not predictions.)

// promote_graph: U=0/L init, shadow attribution. No success bonus.
fn promote_graph(W:[]u8,root:i32,s:i32,r:i32,ans:i32,facts:[]u8,nf:i32)i32 {
  let m:i32=alloc_node(W); if(m<0){return -1;}
  ns(W,m,0,20); ns(W,m,4,r); ns(W,m,8,s);
  ns(W,m,12,0); ns(W,m,16,hg(W,0));
  write_node(W,m,root,hg(W,24),ans,0);
  link_edge(W,m,13,m,hg(W,0));
  link_edge(W,m,2,m,0); link_edge(W,m,6,m,0);
  let i:i32=0;
  while(i<nf){link_edge(W,m,1,get32(facts,i*4),0); i=i+1;}
  let sh:i32=ev_teach_in(W,s,r,ans);
  if(sh>=2 && sh<1024){ns(W,sh,4,m);}
  return m;
}

// ev_query: record prediction on shadow-FACT hit. No use-reward.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    let ans:i32=ng(W,n,28);
    // Predictive attribution: if this FACT is a MAP shadow, the MAP has
    // now committed to a prediction. Record it; the world will judge later
    // via ev_observe -> pred_resolve. No +1 for mere use.
    if(ng(W,n,0)==1){
      let o:i32=ng(W,n,4);
      if(o>=2 && o<1024 && ng(W,o,36)==1 && ng(W,o,0)==20){
        pred_record(W,s,r,ans,o,20);
      }
    }
    log_ev(W,2,s,r,ans,1,0,0); return ans;
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop first (learner-set miss policy)
  let ans2:i32=mp_run(W,s,r,expected,flags);
  if(ans2!=-2){log_ev(W,2,s,r,ans2,1,0,0); return ans2;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// ev_observe: verbatim base + pred_resolve at all three outcome points.
fn ev_observe(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    if(ng(W,n,28)==o){
      link_edge(W,n,7,n,0); ref_prot(W,n);
      log_ev(W,4,s,r,o,1,0,0);
      pred_resolve(W,s,r,o);
      return 1;
    }
    link_edge(W,n,3,n,0);
    revise_on_contradict(W,n,o);
    let h2:i32=alloc_raw(W);
    if(h2>=0){
      ns(W,h2,0,3);
      write_node(W,h2,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
      link_edge(W,h2,5,n,0);
    }
    let nn:i32=ev_teach_in(W,s,r,o);
    if(nn>=0){link_edge(W,nn,4,n,0);}
    log_ev(W,4,s,r,o,0,0,0);
    pred_resolve(W,s,r,o);
    return 0;
  }
  ev_teach_in(W,s,r,o); log_ev(W,4,s,r,o,1,0,0);
  pred_resolve(W,s,r,o);
  return 1;
}

// evict_node: utility-aware victim selection (verbatim from ub_patch.zag).
// Priority (first match wins):
//   1. ZOMBIE: MAP with invalid/shared root -> atomic reclaim, U irrelevant.
//   2. FOSSIL: live MAP, valid root, U<=0, age>FOSSIL_AGE -> oldest first.
//   3. LIVE low-U: unified scan, MAPs by U asc, others by bid, skip live cells.
//   4. Bid fallback: integrated in pass 3 for non-utility nodes.
fn evict_node(W:[]u8)i32 {
  let now:i32=hg(W,0);
  let cur:i32=hg(W,8);
  // Pass 1: ZOMBIE MAPs. Immediate atomic reclaim.
  let m:i32=2;
  while(m<1024){
    if(map_is_zombie(W,m)==1){
      reclaim_map_atomic(W,m);
      let nc1:i32=m+1; if(nc1>=1024){nc1=2;} hs(W,8,nc1);
      return m;
    }
    m=m+1;
  }
  // Pass 2: FOSSIL MAPs. Oldest first, atomic reclaim.
  let best_f:i32=-1; let best_age:i32=-1;
  m=2;
  while(m<1024){
    if(map_is_fossil(W,m,now)==1){
      let age:i32=now-ng(W,m,16);
      if(age>best_age){best_age=age; best_f=m;}
    }
    m=m+1;
  }
  if(best_f>=0){
    reclaim_map_atomic(W,best_f);
    let nc2:i32=best_f+1; if(nc2>=1024){nc2=2;} hs(W,8,nc2);
    return best_f;
  }
  // Pass 3: Unified scan. MAPs ordered by U ascending; non-MAPs by bid.
  // Cells of LIVE MAPs are skipped (structure-aware protection).
  let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<1024){
    let n:i32=cur+i; if(n>=1024){n=n-1024;}
    if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
      let t:i32=ng(W,n,0);
      let skip:i32=0;
      if(t==101 || t==102 || t==103 || t==104){
        if(cell_of_live_map(W,n,now)==1){skip=1;}
      }
      if(skip==0){
        let b:i32=0;
        if(t==20){
          if(map_is_live(W,n,now)==1){b=ng(W,n,12);}
          else {b=bid(W,n);}
        } else {
          b=bid(W,n);
        }
        if(b<bb){bb=b; best=n;}
      }
    }
    i=i+1;
  }
  if(best<0){return -1;}
  if(ng(W,best,0)==20){
    reclaim_map_atomic(W,best);
  } else {
    rec_evict(W,best); ns(W,best,36,0); hs(W,20,hg(W,20)-1);
    let e:i32=0;
    while(e<4096){
      if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
        es(W,e,0,-1); hs(W,24,hg(W,24)-1);
      }
      e=e+1;
    }
  }
  let nc:i32=best+1; if(nc>=1024){nc=2;} hs(W,8,nc);
  return best;
}

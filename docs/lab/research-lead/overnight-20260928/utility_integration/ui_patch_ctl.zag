// ui_patch_ctl.zag -- Test 6 redundancy control: NO U counter.
// Unfrozen variant only. Base: ui_base.zag (frozen, SHA-256 a29972ca...).
//
// This is the S2-style falsification control for the utility signal.
// Question: if structure-aware bid ordering alone (no U field) achieves the
// same reclaim ordering, the U counter is redundant.
//
// Kept (structure, not utility):
//   - reclaim_map_atomic (structure-atomic reclaim; zombie route impossible)
//   - map_is_zombie (validity check; no U involved)
//   - cell protection (reachability from valid MAPs; U-free definition)
// Removed:
//   - U field writes (promote_graph, ev_query are base verbatim in core)
//   - Fossil pass (fossil is U-defined: U<=0 and age>200)
//   - U-ordering in victim scan (MAPs ordered by bid like everything else)
//
// If this control orders victims identically to the U-arm on the
// discrimination battery, U is redundant. If orderings differ, U adds a
// non-redundant signal (whether it is BETTER is measured downstream).

// ctl_cell_prot(W,c): U-free cell protection. 1 if cell c (tag 101-104) is
// reachable from any valid non-zombie MAP root via bounded SEQ walk.
// "Valid" here means: live, tag-20, not zombie. No U, no age, no fossil.
fn ctl_cell_prot(W:[]u8,c:i32)i32 {
  if(c<2 || c>=1024){return 0;}
  let ct:i32=ng(W,c,0);
  if(ct!=101 && ct!=102 && ct!=103 && ct!=104){return 0;}
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && map_is_zombie(W,m)==0){
      let r:i32=map_root(W,m);
      let cur:i32=r; let steps:i32=0;
      while(cur>=2 && cur<1024 && steps<80){
        if(cur==c){return 1;}
        let nxt:i32=-1; let e:i32=0;
        while(e<4096){
          if(eg(W,e,0)==cur && eg(W,e,4)==12){nxt=eg(W,e,8);}
          e=e+1;
        }
        if(nxt<0){
          let f12:i32=ng(W,cur,12);
          if(f12>=2 && f12<1024 && ng(W,f12,36)==1){nxt=f12;}
        }
        cur=nxt; steps=steps+1;
      }
    }
    m=m+1;
  }
  return 0;
}

// evict_node (control): zombie > bid-ordered scan. No U anywhere.
fn evict_node(W:[]u8)i32 {
  let cur:i32=hg(W,8);
  // Pass 1: ZOMBIE MAPs. Immediate atomic reclaim (structure, not utility).
  let m:i32=2;
  while(m<1024){
    if(map_is_zombie(W,m)==1){
      reclaim_map_atomic(W,m);
      let nc1:i32=m+1; if(nc1>=1024){nc1=2;} hs(W,8,nc1);
      return m;
    }
    m=m+1;
  }
  // Pass 2: Unified bid scan. All nodes (MAP or not) ordered by bid.
  // Cells reachable from valid MAPs are skipped (structure-aware protection).
  let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<1024){
    let n:i32=cur+i; if(n>=1024){n=n-1024;}
    if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
      let t:i32=ng(W,n,0);
      let skip:i32=0;
      if(t==101 || t==102 || t==103 || t==104){
        if(ctl_cell_prot(W,n)==1){skip=1;}
      }
      if(skip==0){
        let b:i32=bid(W,n);
        if(b<bb){bb=b; best=n;}
      }
    }
    i=i+1;
  }
  if(best<0){return -1;}
  if(ng(W,best,0)==20){
    reclaim_map_atomic(W,best);
  } else {
    rec_evict(W,best); ns(W,best,36,0); hs(W,20,hg(W,20)-1);
    let e:i32=0;
    while(e<4096){
      if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
        es(W,e,0,-1); hs(W,24,hg(W,24)-1);
      }
      e=e+1;
    }
  }
  let nc:i32=best+1; if(nc>=1024){nc=2;} hs(W,8,nc);
  return best;
}

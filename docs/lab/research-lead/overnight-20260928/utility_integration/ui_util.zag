// ub_util.zag -- Learner-owned MAP utility signal (unfrozen variant).
// Design: docs/lab/research-lead/overnight-20260928/utility_signal/UTILITY_SIGNAL.md
// Parent commit: cd6a8a74a (design only).
//
// Storage (per design 2.1):
//   MAP (tag-20) f12: signed utility U. Init 0. Floor -8. Ceiling +127.
//   MAP (tag-20) f16: last-active tick L. Init birth tick hg(W,0).
//   Shadow FACT (tag-1) f4: owning MAP id O. Written by promote_graph.
//
// Write events (per design 2.2):
//   Promotion: U=0, L=birth, shadow f4=m
//   Query via shadow: U+=1 (guarded attribution)
//   Trial verify success: U+=2
//   Revision success: U+=1
//   Contradiction: U-=2 (floor -8)
//   Revision failure: U-=1 (floor -8)
//
// Read path (per design 2.4):
//   evict_node priority: ZOMBIE > FOSSIL > LIVE low-U > bid fallback
//
// One-System audit: 0 modes, 0 bridges, 0 handlers, 0 new edge types,
// 0 new node kinds, 0 semantic cases. Net mechanism count negative
// (atomic reclaim removes future zombie-detector need).

// FOSSIL_AGE: researcher-scaffolded. Design 2.5 suggests twice the
// observed fossilization window. Interference battery shows degradation
// at V=1000 events; fossil census used 1000 filler events. Scaffold:
// 200 ticks. Honestly labeled; retirement condition is learner adaptation
// of the threshold from reclaim-regret (downstream work).
fn FOSSIL_AGE()i32 { return 200; }

// util_clamp: enforce U floor -8, ceiling +127.
fn util_clamp(v:i32)i32 {
  if(v<-8){return -8;}
  if(v>127){return 127;}
  return v;
}

// util_add(W,m,delta): add delta to MAP m's U, update L=now.
// Guards: m must be live tag-20. No-op otherwise.
fn util_add(W:[]u8,m:i32,delta:i32)void {
  if(m<2 || m>=1024){return;}
  if(ng(W,m,36)!=1){return;}
  if(ng(W,m,0)!=20){return;}
  let u:i32=ng(W,m,12);
  u=util_clamp(u+delta);
  ns(W,m,12,u);
  ns(W,m,16,hg(W,0));
  return;
}

// util_init(W,m): initialize U=0, L=birth tick on fresh MAP.
fn util_init(W:[]u8,m:i32)void {
  if(m<2 || m>=1024){return;}
  ns(W,m,12,0);
  ns(W,m,16,hg(W,0));
  return;
}

// util_attr(W,n): query-answer attribution. If FACT n has valid owning
// MAP O in f4, increment O's utility. Guards per design 2.2:
//   2 <= O < 1024, ng(W,O,36)==1, ng(W,O,0)==20.
// Only writes when attribution is valid; ordinary FACT hits write nothing.
fn util_attr(W:[]u8,n:i32)void {
  if(n<2 || n>=1024){return;}
  if(ng(W,n,36)!=1){return;}
  if(ng(W,n,0)!=1){return;}
  let o:i32=ng(W,n,4);
  if(o<2 || o>=1024){return;}
  if(ng(W,o,36)!=1){return;}
  if(ng(W,o,0)!=20){return;}
  util_add(W,o,1);
  return;
}

// map_root(W,m): return the MAP's graph root node id, or -1 if unreadable.
fn map_root(W:[]u8,m:i32)i32 {
  if(m<2 || m>=1024){return -1;}
  if(ng(W,m,36)!=1){return -1;}
  if(ng(W,m,0)!=20){return -1;}
  return ng(W,m,20);
}

// map_root_valid(W,m): 1 if MAP m's root is structurally valid, else 0.
// Valid means: root in [2,1024), live (36==1), tag in {101,102,103,104}.
// Per design 2.5 and corruption detector: invalid root = ZOMBIE.
fn map_root_valid(W:[]u8,m:i32)i32 {
  let r:i32=map_root(W,m);
  if(r<2 || r>=1024){return 0;}
  if(ng(W,r,36)!=1){return 0;}
  let t:i32=ng(W,r,0);
  if(t==101){return 1;}
  if(t==102){return 1;}
  if(t==103){return 1;}
  if(t==104){return 1;}
  return 0;
}

// map_root_shared(W,m): 1 if another live MAP shares the same root.
// Per zombie census: two MAPs sharing one graph cell = corruption.
fn map_root_shared(W:[]u8,m:i32)i32 {
  let r:i32=map_root(W,m);
  if(r<0){return 0;}
  let n:i32=2;
  while(n<1024){
    if(n!=m && ng(W,n,36)==1 && ng(W,n,0)==20){
      if(ng(W,n,20)==r){return 1;}
    }
    n=n+1;
  }
  return 0;
}

// map_is_zombie(W,m): 1 if MAP m is a zombie (invalid or shared root).
// Zombies are reclaimed first regardless of U (design 2.4).
fn map_is_zombie(W:[]u8,m:i32)i32 {
  if(m<2 || m>=1024){return 0;}
  if(ng(W,m,36)!=1){return 0;}
  if(ng(W,m,0)!=20){return 0;}
  if(map_root_valid(W,m)==0){return 1;}
  if(map_root_shared(W,m)==1){return 1;}
  return 0;
}

// map_is_fossil(W,m,now): 1 if live MAP, valid root, U<=0, age > FOSSIL_AGE.
// Per design 2.5: the fossil-census population (intact, never referenced).
fn map_is_fossil(W:[]u8,m:i32,now:i32)i32 {
  if(m<2 || m>=1024){return 0;}
  if(ng(W,m,36)!=1){return 0;}
  if(ng(W,m,0)!=20){return 0;}
  if(map_is_zombie(W,m)==1){return 0;}
  let u:i32=ng(W,m,12);
  if(u>0){return 0;}
  let l:i32=ng(W,m,16);
  let age:i32=now-l;
  if(age>FOSSIL_AGE()){return 1;}
  return 0;
}

// map_is_live(W,m,now): 1 if MAP is protected (valid, U>0 or recent).
// Per design 2.5 classification table.
fn map_is_live(W:[]u8,m:i32,now:i32)i32 {
  if(m<2 || m>=1024){return 0;}
  if(ng(W,m,36)!=1){return 0;}
  if(ng(W,m,0)!=20){return 0;}
  if(map_is_zombie(W,m)==1){return 0;}
  if(map_is_fossil(W,m,now)==1){return 0;}
  return 1;
}

// cell_of_live_map(W,c,now): 1 if cell c (tag 101-104) is reachable from
// a LIVE MAP's root via SEQ walk. Used for structure-aware protection:
// live MAP's cells inherit protection during victim scan (design 2.4).
// Bounded walk: 80 steps per MAP (same bound as zombie detector).
fn cell_of_live_map(W:[]u8,c:i32,now:i32)i32 {
  if(c<2 || c>=1024){return 0;}
  let ct:i32=ng(W,c,0);
  if(ct!=101 && ct!=102 && ct!=103 && ct!=104){return 0;}
  let m:i32=2;
  while(m<1024){
    if(map_is_live(W,m,now)==1){
      let r:i32=map_root(W,m);
      // Bounded SEQ walk from root, check if c is reachable.
      let cur:i32=r; let steps:i32=0;
      while(cur>=2 && cur<1024 && steps<80){
        if(cur==c){return 1;}
        // Follow SEQ edge (type 12) from cur.
        let nxt:i32=-1; let e:i32=0;
        while(e<4096){
          if(eg(W,e,0)==cur && eg(W,e,4)==12){nxt=eg(W,e,8);}
          e=e+1;
        }
        if(nxt<0){
          // Also check field 12 for BRANCHEQ true-target.
          let f12:i32=ng(W,cur,12);
          if(f12>=2 && f12<1024 && ng(W,f12,36)==1){nxt=f12;}
        }
        cur=nxt; steps=steps+1;
      }
    }
    m=m+1;
  }
  return 0;
}

// reclaim_map_atomic(W,m): structure-atomic reclaim of MAP m and its
// graph cells in one pass. Walks SEQ edges from root (80-step bound),
// reclaims each reachable cell, then reclaims the MAP shell.
// Per design 2.4: makes the "shell survives, body rots" zombie route
// impossible by construction, not by post-hoc detection.
fn reclaim_map_atomic(W:[]u8,m:i32)void {
  if(m<2 || m>=1024){return;}
  // Walk and collect cells via SEQ from root.
  let r:i32=map_root(W,m);
  if(r>=2 && r<1024){
    let cur:i32=r; let steps:i32=0;
    while(cur>=2 && cur<1024 && steps<80){
      let nxt:i32=-1;
      // Find SEQ edge from cur before reclaiming cur.
      let e:i32=0;
      while(e<4096){
        if(eg(W,e,0)==cur && eg(W,e,4)==12){nxt=eg(W,e,8);}
        e=e+1;
      }
      if(nxt<0){
        let f12:i32=ng(W,cur,12);
        if(f12>=2 && f12<1024 && ng(W,f12,36)==1){nxt=f12;}
      }
      // Reclaim cur (cell).
      rec_evict(W,cur); ns(W,cur,36,0); hs(W,20,hg(W,20)-1);
      cur=nxt; steps=steps+1;
    }
  }
  // Reclaim the MAP shell itself.
  rec_evict(W,m); ns(W,m,36,0); hs(W,20,hg(W,20)-1);
  // Remove edges touching m or its cells (single edge sweep).
  let e2:i32=0;
  while(e2<4096){
    if(eg(W,e2,0)!=-1){
      let a:i32=eg(W,e2,0); let b:i32=eg(W,e2,8);
      // If a or b is dead (36==0), clear the edge.
      let da:i32=0; let db:i32=0;
      if(a>=2 && a<1024 && ng(W,a,36)==0){da=1;}
      if(b>=2 && b<1024 && ng(W,b,36)==0){db=1;}
      if(da==1 || db==1){es(W,e2,0,-1); hs(W,24,hg(W,24)-1);}
    }
    e2=e2+1;
  }
  return;
}

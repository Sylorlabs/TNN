// un_patch.zag -- Unified composition: single operation replacing A/B/C.
//
// Architecture: C's iterative DFS over MAP compositions, with pluggable
// applicability predicates:
//   - C's principle: relation-sequence walkable from current value
//     (structural constraint satisfaction)
//   - A's principle: plen contract matches a real path from current value
//     (fallback when relseq extraction fails)
//   - B's principle: type-15 co-use history orders candidates and
//     accumulates from composition successes
//
// The 3-segment researcher cap is removed: DFS attempts up to 8 segments.
// A/B's pair-search machinery is deleted: arity is handled by DFS.
//
// On success segments are assembled, concatenated, verified, and promoted
// as MAP_Z with LINK14 provenance to each segment and type-15 co-use edges
// between consecutive segments. Runs in ev_query between rebind_try and trial.
// Zero modes, bridges, handlers, semantic cases.

// ---- config: 1 = composition enabled; 0 = NO-COMPOSE control (one-line diff)
fn compose_on()i32 { return 1; }
// L2: master switch for MAP adaptation operators. The NA build flips exactly
// this line to 0; all operator logic below is then skipped.
fn adapt_on()i32 { return 1; }

// Returns link count, or -1 if the promoted graph is not a pure
// guard/set chain or a licensing fact is missing/dead.
fn cc_relseq(W:[]u8,m:i32,seq:[]u8,maxn:i32)i32 {
  let root:i32=ng(W,m,20);
  let cur:i32=root;
  let exp102:i32=1;
  let n:i32=0;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(exp102==1){
      if(tag!=102){return -1;}
      cur=ng(W,cur,12);
      exp102=0;
    } else {
      if(tag!=101){return -1;}
      let fact:i32=-1;
      let e:i32=0;
      while(e<4096 && fact<0){
        if(eg(W,e,0)==cur && eg(W,e,4)==1){fact=eg(W,e,8);}
        e=e+1;
      }
      if(fact<0){return -1;}
      if(ng(W,fact,0)!=1 || ng(W,fact,36)!=1){return -1;}
      if(n>=maxn){return -1;}
      set32(seq,n*4,ng(W,fact,24));
      n=n+1;
      cur=seq_nx(W,cur);
      exp102=1;
    }
    steps=steps+1;
  }
  if(n==0){return -1;}
  return n;
}
// ============ L2 MAP adaptation operators ============
// Standing candidate-generation rules evaluated inside un_candidates for
// every candidate MAP at every DFS level. They fire on structural
// preconditions computed from learner state (relseq satisfiability,
// existence of continuation facts, observed ambiguity). The researcher never
// selects an operator per problem.
// Count live facts with (subject s, relation r), capped at 2.
fn lu_count2(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  let c:i32=0;
  while(n<1024 && c<2){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){c=c+1;}
    n=n+1;
  }
  return c;
}
// Pick one live fact (subject s, relation r). mode 0: lowest node id
// (identical choice to t2_lu_first). mode 1: object nearest anchor,
// ties broken by lowest node id.
fn lu_pick(W:[]u8,s:i32,r:i32,anchor:i32,mode:i32)i32 {
  let n:i32=2;
  let best:i32=-1;
  let bestd:i32=0;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){
      if(mode==0){return n;}
      let d:i32=ng(W,n,28)-anchor;
      if(d<0){d=0-d;}
      if(best<0 || d<bestd){best=n; bestd=d;}
    }
    n=n+1;
  }
  return best;
}
// EXTEND + constraint walk: walk m's relseq from cur (as cc_satisfy does),
// then greedily continue with the MAP's LAST relation while matching facts
// exist, up to maxext extra links. mode 0: first fact wins at each step;
// mode 1: nearest object to cur wins (specialized re-walk).
// Fills vals/fids. amb[0] is set to 1 if any step saw 2+ matching facts.
// out[0] = relseq length L, out[4] = extra links ext. Returns total links,
// or -1 when the base relseq walk fails.
fn adapt_walk(W:[]u8,m:i32,cur:i32,vals:[]u8,fids:[]u8,maxext:i32,mode:i32,amb:[]u8,out:[]u8)i32 {
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,m,seq,7);
  if(L<1){return -1;}
  set32(out,0,L);
  set32(out,4,0);
  set32(vals,0,cur);
  let i:i32=0;
  while(i<L){
    let rq:i32=get32(seq,i*4);
    let sv:i32=get32(vals,i*4);
    if(lu_count2(W,sv,rq)>1){set32(amb,0,1);}
    let fnd:i32=lu_pick(W,sv,rq,cur,mode);
    if(fnd<0){return -1;}
    set32(vals,(i+1)*4,ng(W,fnd,28));
    set32(fids,i*4,fnd);
    i=i+1;
  }
  let last_r:i32=get32(seq,(L-1)*4);
  let ext:i32=0;
  let done:i32=0;
  while(ext<maxext && done==0){
    let sv2:i32=get32(vals,(L+ext)*4);
    if(lu_count2(W,sv2,last_r)>1){set32(amb,0,1);}
    let f2:i32=lu_pick(W,sv2,last_r,cur,mode);
    if(f2<0){done=1;}
    else {
      set32(vals,(L+ext+1)*4,ng(W,f2,28));
      set32(fids,(L+ext)*4,f2);
      ext=ext+1;
    }
  }
  set32(out,4,ext);
  return L+ext;
}
// Walk exactly the first k relations of m's relseq from cur. 1 on success,
// 0 on failure. Used by TRUNCATE discovery and by deterministic replay.
fn adapt_trunc_k(W:[]u8,m:i32,cur:i32,vals:[]u8,fids:[]u8,k:i32)i32 {
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,m,seq,7);
  if(L<1 || k<1 || k>=L){return 0;}
  set32(vals,0,cur);
  let i:i32=0;
  while(i<k){
    let fnd:i32=t2_lu_first(W,get32(vals,i*4),get32(seq,i*4));
    if(fnd<0){return 0;}
    set32(vals,(i+1)*4,ng(W,fnd,28));
    set32(fids,i*4,fnd);
    i=i+1;
  }
  return 1;
}
// TRUNCATE discovery: longest proper prefix of m's relseq that is
// satisfiable from cur. Returns the prefix length, or -1. Fills vals/fids
// for the winning prefix.
fn adapt_trunc_find(W:[]u8,m:i32,cur:i32,vals:[]u8,fids:[]u8)i32 {
  let seq:[]u8=z_alloc(28);
  let L:i32=cc_relseq(W,m,seq,7);
  if(L<2){return -1;}
  let k:i32=L-1;
  while(k>=1){
    if(adapt_trunc_k(W,m,cur,vals,fids,k)==1){return k;}
    k=k-1;
  }
  return -1;
}
// Variant dispatch for one candidate, replaying candidate generation
// deterministically: 0 = base walk (un_satisfy, unchanged behavior),
// 1000+k = EXTEND by k, 2000+k = TRUNCATE to prefix k,
// 3000 = SPECIALIZE (nearest-object re-walk).
fn un_satisfy_v(W:[]u8,m:i32,vc:i32,cur:i32,vals:[]u8,fids:[]u8)i32 {
  if(vc==0){return un_satisfy(W,m,cur,vals,fids);}
  if(vc>=1000 && vc<2000){
    let amb:[]u8=z_alloc(4); set32(amb,0,0);
    let out:[]u8=z_alloc(8);
    return adapt_walk(W,m,cur,vals,fids,vc-1000,0,amb,out);
  }
  if(vc>=2000 && vc<3000){
    if(adapt_trunc_k(W,m,cur,vals,fids,vc-2000)==1){return vc-2000;}
    return -1;
  }
  if(vc==3000){
    let amb2:[]u8=z_alloc(4); set32(amb2,0,0);
    let out2:[]u8=z_alloc(8);
    return adapt_walk(W,m,cur,vals,fids,3,1,amb2,out2);
  }
  return -1;
}
// Sorted candidate insertion (co-use desc, then length desc, stable).
// Variant codes travel in the parallel cvarbuf.
fn cand_ins(candbuf:[]u8,lenbuf:[]u8,cousebuf:[]u8,cvarbuf:[]u8,base:i32,n:i32,m:i32,ln:i32,co:i32,vc:i32)i32 {
  if(n>=32){return n;}
  let pos:i32=0;
  while(pos<n && get32(cousebuf,(base+pos)*4)>co){pos=pos+1;}
  while(pos<n && get32(cousebuf,(base+pos)*4)==co && get32(lenbuf,(base+pos)*4)>ln){pos=pos+1;}
  let q:i32=n;
  while(q>pos){
    set32(candbuf,(base+q)*4,get32(candbuf,(base+q-1)*4));
    set32(lenbuf,(base+q)*4,get32(lenbuf,(base+q-1)*4));
    set32(cousebuf,(base+q)*4,get32(cousebuf,(base+q-1)*4));
    set32(cvarbuf,(base+q)*4,get32(cvarbuf,(base+q-1)*4));
    q=q-1;
  }
  set32(candbuf,(base+pos)*4,m);
  set32(lenbuf,(base+pos)*4,ln);
  set32(cousebuf,(base+pos)*4,co);
  set32(cvarbuf,(base+pos)*4,vc);
  return n+1;
}

// Check whether MAP m's relation sequence is satisfiable starting from
// value cur in the fact store. On success fills vals[0..len] (value chain)
// and fids[0..len-1] (licensing fact ids). Returns len, else -1.
fn cc_satisfy(W:[]u8,m:i32,cur:i32,vals:[]u8,fids:[]u8)i32 {
  let seq:[]u8=z_alloc(28);
  let len:i32=cc_relseq(W,m,seq,7);
  if(len<1){return -1;}
  set32(vals,0,cur);
  let i:i32=0;
  while(i<len){
    let rq:i32=get32(seq,i*4);
    let fnd:i32=t2_lu_first(W,get32(vals,i*4),rq);
    if(fnd<0){return -1;}
    set32(vals,(i+1)*4,ng(W,fnd,28));
    set32(fids,i*4,fnd);
    i=i+1;
  }
  return len;
}

// Tail of a pure chain graph: the last SET cell.
fn cc_chain_tail(W:[]u8,root:i32)i32 {
  let cur:i32=root;
  let tail:i32=-1;
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==102){cur=ng(W,cur,12);}
    else {
      if(tag==101){tail=cur; cur=seq_nx(W,cur);}
      else {cur=-2;}
    }
    steps=steps+1;
  }
  return tail;
}

// Contract of MAP m: plen of its chain graph, or -1 if not a chain MAP.
// Derived purely from MAP structure. Verbatim from A's patch.
fn cx_contract(W:[]u8,m:i32)i32 {
  if(ng(W,m,0)!=20){return -1;}
  if(ng(W,m,36)!=1){return -1;}
  let p:i32=rb_chain_plen(W,ng(W,m,20));
  if(p<2){return -1;}
  return p;
}

// Write co-use LINK newM -> prevM (type 15). 1 if written.
// Verbatim from B's patch.
fn cb_couse_link(W:[]u8,newM:i32,prevM:i32)i32 {
  if(newM<0 || prevM<0 || newM==prevM){return 0;}
  if(ng(W,newM,0)!=20 || ng(W,prevM,0)!=20){return 0;}
  if(ng(W,newM,36)!=1 || ng(W,prevM,36)!=1){return 0;}
  link_edge(W,newM,15,prevM,0);
  return 1;
}

// newest live MAP id, -1 if none. Verbatim from B's patch.
fn cb_newest_map(W:[]u8)i32 {
  let m:i32=1023;
  while(m>=2){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){return m;}
    m=m-1;
  }
  return -1;
}

// ---- B's history as pluggable applicability predicate ----
// Returns 1 if a type-15 co-use edge exists from m to any MAP in
// used[0..nused-1] (m was used after that MAP before). This is B's
// selection principle: "used together before," consulted as a
// candidate-ordering signal, never a hardcoded gate.
fn cb_has_couse(W:[]u8,m:i32,used:[]u8,nused:i32)i32 {
  let u:i32=0;
  while(u<nused){
    let pm:i32=get32(used,u*4);
    let e:i32=0;
    while(e<4096){
      if(eg(W,e,4)==15 && eg(W,e,0)==m && eg(W,e,8)==pm){return 1;}
      e=e+1;
    }
    u=u+1;
  }
  return 0;
}

// ---- Unified satisfiability: C's constraint walk + A's contract fallback ----
// Tries C's relation-sequence walk first. If relseq extraction fails,
// falls back to A's plen-contract via path gather. Returns link count and
// fills vals[0..len] / fids[0..len-1], or -1 if neither applies.
fn un_satisfy(W:[]u8,m:i32,cur:i32,vals:[]u8,fids:[]u8)i32 {
  let ln:i32=cc_satisfy(W,m,cur,vals,fids);
  if(ln>=1){return ln;}
  let p:i32=cx_contract(W,m);
  if(p<2 || p>8){return -1;}
  let paths:[]u8=z_alloc(4608);
  let np:i32=t2_gather(W,cur,paths);
  let i:i32=0;
  while(i<np){
    let base:i32=i*48;
    if(get32(paths,base)==p){
      let j:i32=0;
      while(j<p){set32(vals,j*4,get32(paths,base+4+j*4)); j=j+1;}
      j=0;
      while(j<p-1){set32(fids,j*4,get32(paths,base+24+j*4)); j=j+1;}
      return p-1;
    }
    i=i+1;
  }
  return -1;
}

// ---- Unified candidates: OR admission, history-first ordering ----
// A MAP is admitted if un_satisfy succeeds (C's constraints OR A's contract).
// Ordering: historically co-used MAPs first (B's principle), then by
// decreasing length (fewer segments preferred), ties stable by MAP id.
// Unified candidates: OR-admission over MAPs not in used, B-style co-use
// history ordering, decreasing length. L2: each admitted MAP may also emit
// adapted variants (EXTEND 1000+ext, TRUNCATE 2000+plen, SPECIALIZE 3000)
// when the standing preconditions fire. ast counts adaptation statistics:
// [0]=satisfy calls, [4]=ext generated, [8]=trunc generated, [12]=spec generated.
fn un_candidates(W:[]u8,cur:i32,used:[]u8,nused:i32,candbuf:[]u8,lenbuf:[]u8,cousebuf:[]u8,cvarbuf:[]u8,base:i32,ast:[]u8)i32 {
  let n:i32=0;
  let m:i32=2;
  while(m<1024 && n<32){
    if(ng(W,m,36)==1 && ng(W,m,0)==20){
      let u:i32=0;
      let isused:i32=0;
      while(u<nused){
        if(get32(used,u*4)==m){isused=1;}
        u=u+1;
      }
      if(isused==0){
        let co:i32=cb_has_couse(W,m,used,nused);
        set32(ast,0,get32(ast,0)+1);
        let vb:[]u8=z_alloc(48);
        let fb:[]u8=z_alloc(44);
        let ln:i32=un_satisfy(W,m,cur,vb,fb);
        if(ln>=1){
          n=cand_ins(candbuf,lenbuf,cousebuf,cvarbuf,base,n,m,ln,co,0);
        }
        if(adapt_on()==1){
          let amb:[]u8=z_alloc(4); set32(amb,0,0);
          let out:[]u8=z_alloc(8);
          let vbx:[]u8=z_alloc(48);
          let fbx:[]u8=z_alloc(44);
          set32(ast,0,get32(ast,0)+1);
          let tot:i32=adapt_walk(W,m,cur,vbx,fbx,3,0,amb,out);
          if(tot>=1){
            let ext:i32=get32(out,4);
            if(ext>=1){
              set32(ast,4,get32(ast,4)+1);
              n=cand_ins(candbuf,lenbuf,cousebuf,cvarbuf,base,n,m,tot,co,1000+ext);
            }
            if(get32(amb,0)==1){
              let amb2:[]u8=z_alloc(4); set32(amb2,0,0);
              let out2:[]u8=z_alloc(8);
              let vbs:[]u8=z_alloc(48);
              let fbs:[]u8=z_alloc(44);
              set32(ast,0,get32(ast,0)+1);
              let tots:i32=adapt_walk(W,m,cur,vbs,fbs,3,1,amb2,out2);
              if(tots>=1){
                set32(ast,12,get32(ast,12)+1);
                n=cand_ins(candbuf,lenbuf,cousebuf,cvarbuf,base,n,m,tots,co,3000);
              }
            }
          } else {
            let vbt:[]u8=z_alloc(48);
            let fbt:[]u8=z_alloc(44);
            set32(ast,0,get32(ast,0)+1);
            let lnt:i32=adapt_trunc_find(W,m,cur,vbt,fbt);
            if(lnt>=1){
              set32(ast,8,get32(ast,8)+1);
              n=cand_ins(candbuf,lenbuf,cousebuf,cvarbuf,base,n,m,lnt,co,2000+lnt);
            }
          }
        }
      }
    }
    m=m+1;
  }
  return n;
}

// Unified depth-first search over MAP compositions (max 8 segments).
// C's iterative DFS architecture. The 3-segment researcher cap is removed:
// the search now attempts up to 8 segments. Fills oseg (MAP ids),
// ovals (12 value slots per segment), ofids (11 fact slots per segment),
// olen (link counts). L2: candidates carry variant codes in cvar; the walk
// is dispatched through un_satisfy_v so adapted variants backtrack exactly
// like base candidates. Returns segment count, or -1.
fn un_dfs(W:[]u8,s:i32,expected:i32,oseg:[]u8,ovals:[]u8,ofids:[]u8,olen:[]u8,ast:[]u8)i32 {
  let cand:[]u8=z_alloc(1024);
  let clen:[]u8=z_alloc(1024);
  let ccouse:[]u8=z_alloc(1024);
  let cvar:[]u8=z_alloc(1024);
  let ncand:[]u8=z_alloc(32);
  let candi:[]u8=z_alloc(32);
  let curval:[]u8=z_alloc(32);
  set32(curval,0,s);
  set32(ncand,0,un_candidates(W,s,oseg,0,cand,clen,ccouse,cvar,0,ast));
  set32(candi,0,0);
  let L:i32=0;
  let done:i32=0;
  let nseg:i32=-1;
  while(L>=0 && done==0){
    if(get32(candi,L*4)>=get32(ncand,L*4)){
      L=L-1;
      if(L>=0){set32(candi,L*4,get32(candi,L*4)+1);}
    } else {
      let m:i32=get32(cand,(L*32+get32(candi,L*4))*4);
      let vc:i32=get32(cvar,(L*32+get32(candi,L*4))*4);
      let vbuf:[]u8=z_alloc(48);
      let fbuf:[]u8=z_alloc(44);
      let ln:i32=un_satisfy_v(W,m,vc,get32(curval,L*4),vbuf,fbuf);
      if(ln<1){
        set32(candi,L*4,get32(candi,L*4)+1);
      } else {
        set32(oseg,L*4,m);
        set32(olen,L*4,ln);
        let j:i32=0;
        while(j<=ln){set32(ovals,(L*12+j)*4,get32(vbuf,j*4)); j=j+1;}
        j=0;
        while(j<ln){set32(ofids,(L*11+j)*4,get32(fbuf,j*4)); j=j+1;}
        let nv:i32=get32(vbuf,ln*4);
        if(nv==expected){
          nseg=L+1;
          done=1;
        } else {
          if(L+1>=8){
            set32(candi,L*4,get32(candi,L*4)+1);
          } else {
            set32(curval,(L+1)*4,nv);
            set32(ncand,(L+1)*4,un_candidates(W,nv,oseg,L+1,cand,clen,ccouse,cvar,(L+1)*32,ast));
            set32(candi,(L+1)*4,0);
            L=L+1;
          }
        }
      }
    }
  }
  return nseg;
}

// Unified composition for query (s,r,expected).
// Single operation replacing A/B/C's three engines. Uses un_dfs with
// pluggable applicability (C's constraints OR A's contracts, B's history
// for ordering). On success promotes MAP_Z with LINK14 provenance to each
// segment and writes type-15 co-use edges between consecutive segments so
// B's history accumulates from composition successes.
fn compose_try(W:[]u8,s:i32,r:i32,expected:i32,masked:i32,st:[]u8)i32 {
  if(expected<0){return -2;}
  let oseg:[]u8=z_alloc(32);
  let ovals:[]u8=z_alloc(384);
  let ofids:[]u8=z_alloc(352);
  let olen:[]u8=z_alloc(32);
  let ast:[]u8=z_alloc(16);
  set32(ast,0,0); set32(ast,4,0); set32(ast,8,0); set32(ast,12,0);
  let nseg:i32=un_dfs(W,s,expected,oseg,ovals,ofids,olen,ast);
  emit("ADAPT-STAT sat="); e64(get32(ast,0));
  emit(" ext="); e64(get32(ast,4));
  emit(" trunc="); e64(get32(ast,8));
  emit(" spec="); e64(get32(ast,12));
  emit("\n");
  if(nseg<1){
    emit("COMP-FAIL\n");
    return -2;
  }
  let roots:[]u8=z_alloc(32);
  let g:i32=0;
  let ok:i32=1;
  while(g<nseg && ok==1){
    let ln:i32=get32(olen,g*4);
    let vb:[]u8=z_alloc((ln+1)*4);
    let fb:[]u8=z_alloc(ln*4);
    let j:i32=0;
    while(j<=ln){set32(vb,j*4,get32(ovals,(g*12+j)*4)); j=j+1;}
    j=0;
    while(j<ln){set32(fb,j*4,get32(ofids,(g*11+j)*4)); j=j+1;}
    let rt:i32=t2_asm_chain(W,vb,ln+1,fb);
    if(rt<0){ok=0;} else {set32(roots,g*4,rt);}
    g=g+1;
  }
  if(ok==0){return -2;}
  let full:i32=get32(roots,0);
  g=1;
  while(g<nseg){
    let tail:i32=cc_chain_tail(W,full);
    if(tail<0){return -2;}
    seq_link(W,tail,get32(roots,g*4));
    g=g+1;
  }
  let cst:[]u8=z_alloc(8);
  set32(cst,0,0); set32(cst,4,0);
  let v2:i32=t2_try_verify(W,full,s,expected,masked,cst);
  set32(st,0,get32(st,0)+get32(cst,0));
  set32(st,4,get32(st,4)+get32(cst,4));
  if(v2==-2){return -2;}
  let allf:[]u8=z_alloc(336);
  let nf:i32=0;
  g=0;
  while(g<nseg){
    let ln2:i32=get32(olen,g*4);
    let j2:i32=0;
    while(j2<ln2){
      set32(allf,nf*4,get32(ofids,(g*11+j2)*4));
      nf=nf+1; j2=j2+1;
    }
    g=g+1;
  }
  let zm:i32=promote_graph(W,full,s,r,v2,allf,nf);
  if(zm>=0){
    g=0;
    while(g<nseg){
      link_edge(W,zm,14,get32(oseg,g*4),0);
      g=g+1;
    }
    g=1;
    while(g<nseg){
      let w1:i32=cb_couse_link(W,get32(oseg,g*4),get32(oseg,(g-1)*4));
      g=g+1;
    }
  }
  emit("COMP-SEGS n="); e64(nseg);
  g=0;
  while(g<nseg){emit(" "); e64(get32(oseg,g*4)); g=g+1;}
  emit("\n");
  return v2;
}

// ev_query with unified composition hooked between rebind_try and trial.
// Compose stats fold into the shared rbs buffer so hg(W,16) reports
// rebind+compose totals honestly.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- structural rebinding: retrieve learned shapes before blind trial
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  // ---- unified composition: DFS over pluggable applicability ----
  if(compose_on()==1){
    let ca:i32=compose_try(W,s,r,expected,masked,rbs);
    emit("COMP-STAT tried="); e64(get32(rbs,0)); emit(" rejected="); e64(get32(rbs,4)); emit("\n");
    if(ca!=-2){
      hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
      log_ev(W,2,s,r,ca,1,0,0); return ca;
    }
  }
  let recent:i32=-1; let mm:i32=2;
  while(mm<1024){
    if(ng(W,mm,36)==1 && mm>=2 && ng(W,mm,0)==1){recent=mm;}
    mm=mm+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

// Chained query for co-use episodes. chain=0 starts an episode; chain=1
// links this query's promoted MAP to the previous step's MAP via a
// type-15 co-use edge. prevM tracked in header 56 (free; init zeroed,
// -1 = none). Returns the query answer (-2 on miss).
// The LINK is written by this success event; the driver supplies only the
// queries, never the endpoints. Verbatim from B's patch.
fn ev_cq(W:[]u8,s:i32,r:i32,expected:i32,flags:i32,chain:i32)i32 {
  let m0:i32=cb_newest_map(W);
  let ans:i32=ev_query(W,s,r,expected,flags);
  if(ans==-2){return -2;}
  let m1:i32=cb_newest_map(W);
  if(m1<0 || m1==m0){return ans;}
  if(chain==1){
    let prev:i32=hg(W,56);
    cb_couse_link(W,m1,prev);
  }
  hs(W,56,m1);
  return ans;
}

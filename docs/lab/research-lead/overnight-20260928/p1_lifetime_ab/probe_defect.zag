// probe_defect.zag -- minimal reproducer for the indexed-read defect in
// znc 2026.07.0-dev (macos-arm64), the compiler named by
// docs/ops/TOOLCHAIN.md section 1.
//
// Two reads of the SAME bytes with the SAME loop shape differ only in
// whether the induction variable carries an explicit multiplier:
//
//   A: get32(C, 4 + j)      <- coefficient 1  -> WRONG CELLS
//   B: get32(C, 4 + j*4)    <- coefficient 4  -> CORRECT
//
// Expected contents of C after the six stores below:
//   11 105 50 11 106 60
//
// Nothing else is under test: no arenas, no learner, no world.
//
// Build/run:
//   . /Users/Shared/micah/Documents/TNN/.env/pure-zag.sh
//   /Users/Shared/micah/Documents/TNN/TNN/tools/zbuild.sh ./probe_defect.zag --rep 3

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn p(x:i32)void {
  _zag_println(_zag_i64_to_str(x as i64));
  return;
}
fn main()i32 {
  let C:[]u8=z_alloc(512);
  set32(C,0,2);
  set32(C,4,11);
  set32(C,8,105);
  set32(C,12,50);
  set32(C,16,11);
  set32(C,20,106);
  set32(C,24,60);
  _zag_println("EXPECT 11 105 50 11 106 60");
  _zag_print("A_off_plus_j ");
  let j:i32=0;
  while(j<6){ p(get32(C,4+j)); j=j+1; }
  _zag_print("B_off_plus_jx4 ");
  j=0;
  while(j<6){ p(get32(C,4+j*4)); j=j+1; }
  _zag_print("C_literal ");
  p(get32(C,4));
  p(get32(C,8));
  p(get32(C,12));
  p(get32(C,16));
  p(get32(C,20));
  p(get32(C,24));
  _zag_print("D_offs_plus_jx12 ");
  let m:i32=0;
  while(m<2){
    p(get32(C,4+m*12));
    p(get32(C,8+m*12));
    p(get32(C,12+m*12));
    m=m+1;
  }
  return 0;
}
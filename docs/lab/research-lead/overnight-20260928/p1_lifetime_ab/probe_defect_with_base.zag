// probe_defect_with_base.zag -- assembled: the frozen, unmodified
// c15_base.zag (174 lines) followed by the 40-line probe body of
// probe_defect.zag. Adding the frozen base -- which the program needs
// anyway -- is sufficient to make the coefficient-1 indexed read
// miscompile. No lane code is involved.
fn p(x:i32)void {
  _zag_println(_zag_i64_to_str(x as i64));
  return;
}
fn main()i32 {
  let C:[]u8=z_alloc(512);
  set32(C,0,2);
  set32(C,4,11);
  set32(C,8,105);
  set32(C,12,50);
  set32(C,16,11);
  set32(C,20,106);
  set32(C,24,60);
  _zag_println("EXPECT 11 105 50 11 106 60");
  _zag_print("A_off_plus_j ");
  let j:i32=0;
  while(j<6){ p(get32(C,4+j)); j=j+1; }
  _zag_print("B_off_plus_jx4 ");
  j=0;
  while(j<6){ p(get32(C,4+j*4)); j=j+1; }
  _zag_print("C_literal ");
  p(get32(C,4));
  p(get32(C,8));
  p(get32(C,12));
  p(get32(C,16));
  p(get32(C,20));
  p(get32(C,24));
  _zag_print("D_offs_plus_jx12 ");
  let m:i32=0;
  while(m<2){
    p(get32(C,4+m*12));
    p(get32(C,8+m*12));
    p(get32(C,12+m*12));
    m=m+1;
  }
  return 0;
}
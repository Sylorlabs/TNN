// belief_trajectory.zag -- Trajectory-shaped reliability update.
// H-DECEPT-2. Unfrozen variant. Pure Zag.
// 0 modes, 0 bridges, 0 handlers, 0 semantic cases.
//
// Same learner machinery as belief_deception.zag (C211/C223 lineage)
// with ONE change: trajectory-weighted instance counting in
// ev_calibrate. Each verification outcome is weighted by the source's
// trajectory at the time: c = consecutive correct outcomes immediately
// preceding it (learner-owned per-source streak), w = claim weight
// (the claim's stake).
//
//   correct: correct += 1; total += 1; streak = c + 1
//   wrong:   p = floor(c * w / (c + w)); total += 1 + p; streak = 0
//
// The penalty is parameter free: monotone in streak and stake, zero on
// a zero streak, saturating at the claim's stake w for long streaks.
// It applies uniformly to every source on every outcome: no source
// identity checks, no phase checks, no betrayal detection logic. It is
// general, not betrayal specific.
//
// Output discipline (toolchain lesson 2026-10-02): ONE preallocated
// output buffer, cursor returning emit helpers formatting numbers
// directly into the buffer, a single _zag_raw_syscall(1,1,ptr,len)
// write at the end. No _zag_print anywhere.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn eq(a:i32,b:i32)i32 { if(a==b){return 1;} return 0; }

// ---- single output buffer, cursor returning emit helpers ----
fn e_str(ob:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn e_i64(ob:[]u8,at:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=-v;}
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){t=t/10;nd=nd+1;}
  let e:i32=at+neg+nd;
  let k:i32=e;
  let x:i64=u;
  while(k>at+neg){k=k-1;ob[k]=((x%10) as u8)+48;x=x/10;}
  if(neg==1){ob[at]=45;}
  return e;
}
fn e_i32(ob:[]u8,at:i32,v:i32)i32 { return e_i64(ob,at,v as i64); }
fn e_nl(ob:[]u8,at:i32)i32 { ob[at]=10; return at+1; }
fn chk(ob:[]u8,at:i32,F:[]u8,ok:i32,msg:[]u8)i32 {
  if(ok==0){
    at=e_str(ob,at,"FAIL ");
    at=e_str(ob,at,msg);
    at=e_nl(ob,at);
    set32(F,0,get32(F,0)+1);
  }
  return at;
}

// ============ state block: 976 i32 cells ============
fn cg(B:[]u8,c:i32)i32 { return get32(B,c*4); }
fn cs(B:[]u8,c:i32,v:i32)void { set32(B,c*4,v); return; }
// header: 0 nev, 1 nsrc, 2 wmax, 3 first_contrary, 4 revision_seq,
// 5 s1, 6 s2, 7 truth, 8 abl_identity, 9 reserved, 10 nid,
// 11 nevicted, 12 ndup, 13 last_contrib
fn EVB()i32 { return 16; }
fn EVN()i32 { return 64; }
fn EVW()i32 { return 7; }   // qid,hyp,w,src,phase,contrib,eid
fn SRB()i32 { return 464; }
fn SRN()i32 { return 64; }
fn SRW()i32 { return 4; }   // correct,total,streak,extid
fn DCB()i32 { return 720; }
fn DCN()i32 { return 32; }
fn DCW()i32 { return 4; }   // src,hyp,phase,count
fn IDB()i32 { return 848; }
fn IDN()i32 { return 128; }
fn NCELL()i32 { return 976; }
fn ST_NONE()i32 { return 0; }
fn ST_PROV()i32 { return 1; }
fn ST_UNC()i32 { return 2; }
fn ST_CONF()i32 { return 3; }

fn st_init(B:[]u8,abl_identity:i32)void {
  let i:i32=0;
  while(i<NCELL()){ cs(B,i,0); i=i+1; }
  cs(B,8,abl_identity);
  return;
}

// ---- sources ----
fn src_idx(B:[]u8,ext:i32)i32 {
  let i:i32=0;
  while(i<SRN()){
    let id:i32=cg(B,SRB()+i*SRW()+3);
    if(id==ext+1){ return i; }
    i=i+1;
  }
  i=0;
  while(i<SRN()){
    if(cg(B,SRB()+i*SRW()+3)==0){
      cs(B,SRB()+i*SRW()+3,ext+1);
      cs(B,1,cg(B,1)+1);
      return i;
    }
    i=i+1;
  }
  return -1;
}
fn src_rel(B:[]u8,si:i32)i32 {
  let correct:i32=cg(B,SRB()+si*SRW()+0);
  let total:i32=cg(B,SRB()+si*SRW()+1);
  if(total<2){ return 1000; }
  return 1000*correct/total;
}
fn src_streak(B:[]u8,si:i32)i32 {
  return cg(B,SRB()+si*SRW()+2);
}

// ---- independence discount: k-th claim by (src,hyp) in a phase ----
fn disc_for(B:[]u8,si:i32,hyp:i32,phase:i32)i32 {
  let i:i32=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==si+1 && cg(B,DCB()+i*DCW()+1)==hyp && cg(B,DCB()+i*DCW()+2)==phase){
      let k:i32=cg(B,DCB()+i*DCW()+3);
      cs(B,DCB()+i*DCW()+3,k+1);
      let d:i32=1000; let j:i32=0;
      while(j<k){ d=d/2; j=j+1; }
      return d;
    }
    i=i+1;
  }
  i=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==0){
      cs(B,DCB()+i*DCW()+0,si+1);
      cs(B,DCB()+i*DCW()+1,hyp);
      cs(B,DCB()+i*DCW()+2,phase);
      cs(B,DCB()+i*DCW()+3,1);
      return 1000;
    }
    i=i+1;
  }
  return 1000;
}

// ---- event identity register: familiarity without recall ----
fn id_seen(B:[]u8,eid:i32)i32 {
  let i:i32=0;
  while(i<cg(B,10)){
    if(cg(B,IDB()+i)==eid){ return 1; }
    i=i+1;
  }
  return 0;
}
fn id_add(B:[]u8,eid:i32)void {
  let n:i32=cg(B,10);
  if(n<IDN()){ cs(B,IDB()+n,eid); cs(B,10,n+1); }
  return;
}

// ---- evidence record with FIFO eviction under memory pressure ----
fn ev_record(B:[]u8,qid:i32,hyp:i32,w:i32,src:i32,phase:i32,contrib:i32,eid:i32)i32 {
  let n:i32=cg(B,0);
  let slot:i32=n;
  if(n>=EVN()){
    let i:i32=0;
    while(i<EVN()-1){
      let a:i32=EVB()+i*EVW();
      let c:i32=EVB()+(i+1)*EVW();
      let k:i32=0;
      while(k<EVW()){ cs(B,a+k,cg(B,c+k)); k=k+1; }
      i=i+1;
    }
    slot=EVN()-1;
    cs(B,11,cg(B,11)+1);
  }
  let o:i32=EVB()+slot*EVW();
  cs(B,o+0,qid); cs(B,o+1,hyp); cs(B,o+2,w);
  cs(B,o+3,src); cs(B,o+4,phase); cs(B,o+5,contrib); cs(B,o+6,eid);
  if(n<EVN()){ cs(B,0,n+1); }
  return slot+1;
}
fn note_wmax(B:[]u8,contrib:i32)void {
  if(contrib>cg(B,2)){ cs(B,2,contrib); }
  return;
}

// ---- trajectory penalty: surprise weight of a wrong outcome ----
// p = floor(c * w / (c + w)); zero on a zero streak, saturates at w.
fn traj_penalty(c:i32,w:i32)i32 {
  if(c<=0){ return 0; }
  if(w<1){ w=1; }
  return c*w/(c+w);
}

// ---- calibration: claim on a verifiable fact; outcome observed ----
fn ev_calibrate(B:[]u8,src:i32,hyp:i32,w:i32,truth:i32,eid:i32)i32 {
  if(cg(B,8)==0){
    if(id_seen(B,eid)==1){ cs(B,12,cg(B,12)+1); return -1; }
    id_add(B,eid);
  }
  let si:i32=src_idx(B,src);
  let r:i32=src_rel(B,si);
  let contrib:i32=w*r;
  let seq:i32=ev_record(B,0,hyp,w,src,0,contrib,eid);
  note_wmax(B,contrib);
  let c:i32=src_streak(B,si);
  if(hyp==truth){
    cs(B,SRB()+si*SRW()+0,cg(B,SRB()+si*SRW()+0)+1);
    cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1);
    cs(B,SRB()+si*SRW()+2,c+1);
  } else {
    let p:i32=traj_penalty(c,w);
    cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1+p);
    cs(B,SRB()+si*SRW()+2,0);
  }
  return seq;
}

// ---- observation on the H1/H2 question ----
fn ev_observe(B:[]u8,src:i32,hyp:i32,w:i32,phase:i32,eid:i32)i32 {
  if(cg(B,8)==0){
    if(id_seen(B,eid)==1){ cs(B,12,cg(B,12)+1); return -1; }
    id_add(B,eid);
  }
  let si:i32=src_idx(B,src);
  let r:i32=src_rel(B,si);
  let d:i32=disc_for(B,si,hyp,phase);
  let contrib:i32=w*r*d/1000;
  let seq:i32=ev_record(B,1,hyp,w,src,phase,contrib,eid);
  note_wmax(B,contrib);
  if(hyp==1){ cs(B,5,cg(B,5)+contrib); }
  else { cs(B,6,cg(B,6)+contrib); }
  cs(B,13,contrib);
  if(phase>=1 && hyp==2 && cg(B,3)==0){ cs(B,3,seq); }
  let st:i32=st_compute(B);
  if(st==23 && cg(B,4)==0){ cs(B,4,seq); }
  return seq;
}

// ---- belief status: leader*10 + code ----
fn st_compute(B:[]u8)i32 {
  let s1:i32=cg(B,5); let s2:i32=cg(B,6);
  let wm:i32=cg(B,2);
  if(s1==0 && s2==0){ return 0; }
  let d:i32=s1-s2;
  if(d==0){ return 2; }
  let leader:i32=1;
  if(d<0){ leader=2; }
  let ad:i32=d; if(ad<0){ ad=-ad; }
  let both:i32=0;
  if(s1>0 && s2>0){ both=1; }
  let U:i32=wm; let T:i32=wm*2;
  if(both==1 && ad<=U){ return leader*10+ST_UNC(); }
  if(ad>=T){ return leader*10+ST_CONF(); }
  return leader*10+ST_PROV();
}
fn st_name(ob:[]u8,at:i32,code:i32)i32 {
  if(code==0){ return e_str(ob,at,"NONE"); }
  if(code==1){ return e_str(ob,at,"PROVISIONAL"); }
  if(code==2){ return e_str(ob,at,"UNCERTAIN"); }
  return e_str(ob,at,"CONFIDENT");
}
fn print_belief(B:[]u8,ob:[]u8,at:i32,tag:[]u8)i32 {
  let st:i32=st_compute(B);
  let leader:i32=st/10; let code:i32=st%10;
  at=e_str(ob,at,tag); at=e_str(ob,at," leader="); at=e_i32(ob,at,leader);
  at=e_str(ob,at," status="); at=st_name(ob,at,code);
  at=e_str(ob,at," s1="); at=e_i32(ob,at,cg(B,5));
  at=e_str(ob,at," s2="); at=e_i32(ob,at,cg(B,6));
  at=e_str(ob,at," conf="); at=e_i32(ob,at,cg(B,5)-cg(B,6));
  at=e_str(ob,at," U="); at=e_i32(ob,at,cg(B,2));
  at=e_str(ob,at," T="); at=e_i32(ob,at,cg(B,2)*2);
  at=e_nl(ob,at);
  return at;
}
fn print_rel(B:[]u8,ob:[]u8,at:i32,tag:[]u8,src:i32,r:i32)i32 {
  at=e_str(ob,at,tag); at=e_i32(ob,at,r);
  at=e_str(ob,at," relS="); at=e_i32(ob,at,src_rel(B,src_idx(B,src)));
  at=e_str(ob,at," streak="); at=e_i32(ob,at,src_streak(B,src_idx(B,src)));
  at=e_nl(ob,at);
  return at;
}

// ============ world scripts ============
// sources: 90=S (defector), 31=W1, 32=W2, 77=T, 78=U
fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let at:i32=0;
  let F:[]u8=z_alloc(4);

  // ===== World D1: the deception =====
  let D:[]u8=z_alloc(NCELL()*4); st_init(D,0);
  let i:i32=0;
  while(i<20){
    ev_calibrate(D,90,1,1,1,4001+i);
    let r:i32=i+1;
    if(r>=15){
      at=print_rel(D,ob,at,"D1 build round=",90,r);
    }
    i=i+1;
  }
  at=chk(ob,at,F,eq(src_rel(D,src_idx(D,90)),1000),"K2-D1-rel20-1000");
  i=0; while(i<2){ ev_calibrate(D,31,1,1,1,4101+i); i=i+1; }
  i=0; while(i<2){ ev_calibrate(D,32,1,1,1,4201+i); i=i+1; }
  at=chk(ob,at,F,eq(src_rel(D,src_idx(D,31)),1000),"K2-D1-relW1-1000");
  at=chk(ob,at,F,eq(src_rel(D,src_idx(D,32)),1000),"K2-D1-relW2-1000");

  // deception episode, phase 1: S strong false H1; W1,W2 moderate true H2
  ev_observe(D,90,1,3,1,4301);
  at=print_belief(D,ob,at,"D1 after S strong false H1:");
  at=chk(ob,at,F,eq(st_compute(D),11),"K2-D1-afterS-11");
  ev_observe(D,31,2,2,1,4302);
  at=print_belief(D,ob,at,"D1 after W1 moderate true H2:");
  at=chk(ob,at,F,eq(st_compute(D),12),"K2-D1-afterW1-12");
  ev_observe(D,32,2,2,1,4303);
  at=print_belief(D,ob,at,"D1 after W2 moderate true H2:");
  at=chk(ob,at,F,eq(st_compute(D),22),"K2-D1-afterW2-22");
  at=chk(ob,at,F,eq(cg(D,5),3000),"K2-D1-s1-3000");
  at=chk(ob,at,F,eq(cg(D,6),4000),"K2-D1-s2-4000");

  // exposure: S claimed H1, truth H2 -> S wrong, streak 20, w=3
  // p = floor(20*3/23) = 2; total = 23
  ev_calibrate(D,90,1,3,2,4304);
  let re:i32=src_rel(D,src_idx(D,90));
  at=e_str(ob,at,"D1 exposure relS="); at=e_i32(ob,at,re);
  at=e_str(ob,at," linear-null=952 below="); at=e_i32(ob,at,eq(re,869));
  at=e_nl(ob,at);
  at=chk(ob,at,F,eq(re,869),"K3-D1-exposure-869");
  at=chk(ob,at,F,eq(st_compute(D),22),"K3-D1-stance-still-22");

  // aftermath: 5 further wrong rounds (streak 0, w=1, p=0 each)
  let rl1:i32=0; let rl2:i32=0; let rl3:i32=0; let rl4:i32=0; let rl5:i32=0;
  let nb1:i32=909; let nb2:i32=869; let nb3:i32=833; let nb4:i32=800; let nb5:i32=769;
  i=0;
  while(i<5){
    ev_calibrate(D,90,1,1,2,4305+i);
    let rr:i32=src_rel(D,src_idx(D,90));
    let nullv:i32=0;
    if(i==0){ nullv=nb1; } if(i==1){ nullv=nb2; } if(i==2){ nullv=nb3; }
    if(i==3){ nullv=nb4; } if(i==4){ nullv=nb5; }
    at=e_str(ob,at,"D1 post round="); at=e_i32(ob,at,i+1);
    at=e_str(ob,at," relS="); at=e_i32(ob,at,rr);
    at=e_str(ob,at," linear-null="); at=e_i32(ob,at,nullv);
    at=e_str(ob,at," below="); at=e_i32(ob,at,eq(rr<nullv,1)); at=e_nl(ob,at);
    if(i==0){ rl1=rr; }
    if(i==1){ rl2=rr; }
    if(i==2){ rl3=rr; }
    if(i==3){ rl4=rr; }
    if(i==4){ rl5=rr; }
    i=i+1;
  }
  at=chk(ob,at,F,eq(rl1,833),"K3-D1-post1-833");
  at=chk(ob,at,F,eq(rl2,800),"K3-D1-post2-800");
  at=chk(ob,at,F,eq(rl3,769),"K3-D1-post3-769");
  at=chk(ob,at,F,eq(rl4,740),"K3-D1-post4-740");
  at=chk(ob,at,F,eq(rl5,714),"K3-D1-post5-714");
  at=chk(ob,at,F,eq(rl1<nb1,1),"K3-D1-post1-below");
  at=chk(ob,at,F,eq(rl2<nb2,1),"K3-D1-post2-below");
  at=chk(ob,at,F,eq(rl3<nb3,1),"K3-D1-post3-below");
  at=chk(ob,at,F,eq(rl4<nb4,1),"K3-D1-post4-below");
  at=chk(ob,at,F,eq(rl5<nb5,1),"K3-D1-post5-below");
  at=chk(ob,at,F,eq(cg(D,11),0),"K3-D1-no-eviction");

  // ===== World R1: the reverse trap + exposure verification =====
  let R:[]u8=z_alloc(NCELL()*4); st_init(R,0);
  i=0; while(i<20){ ev_calibrate(R,90,1,1,1,5001+i); i=i+1; }
  at=chk(ob,at,F,eq(src_rel(R,src_idx(R,90)),1000),"K4-R1-rel20-1000");
  // W1 and W2 calibrate on the SAME facts in lockstep: observable correlation
  i=0; while(i<2){ ev_calibrate(R,31,1,1,1,5101+i); i=i+1; }
  i=0; while(i<2){ ev_calibrate(R,32,1,1,1,5201+i); i=i+1; }
  at=chk(ob,at,F,eq(src_rel(R,src_idx(R,31)),1000),"K4-R1-relW1-1000");
  at=chk(ob,at,F,eq(src_rel(R,src_idx(R,32)),1000),"K4-R1-relW2-1000");

  // reverse episode, phase 1: S strong TRUE H1; W1,W2 weak FALSE H2
  ev_observe(R,90,1,3,1,5301);
  at=print_belief(R,ob,at,"R1 after S strong true H1:");
  at=chk(ob,at,F,eq(st_compute(R),11),"K4-R1-afterS-11");
  ev_observe(R,31,2,1,1,5302);
  at=print_belief(R,ob,at,"R1 after W1 weak false H2:");
  at=chk(ob,at,F,eq(st_compute(R),12),"K4-R1-afterW1-12");
  ev_observe(R,32,2,1,1,5303);
  at=print_belief(R,ob,at,"R1 after W2 weak false H2:");
  at=chk(ob,at,F,eq(st_compute(R),12),"K4-R1-afterW2-12");
  at=chk(ob,at,F,eq(cg(R,5),3000),"K4-R1-s1-3000");
  at=chk(ob,at,F,eq(cg(R,6),2000),"K4-R1-s2-2000");

  // exposure verification: S CORRECT (w=3, streak 20); W1,W2 WRONG (w=1, streak 2)
  ev_calibrate(R,90,1,3,1,5304);
  ev_calibrate(R,31,2,1,1,5305);
  ev_calibrate(R,32,2,1,1,5306);
  let rrs:i32=src_rel(R,src_idx(R,90));
  let rrw1:i32=src_rel(R,src_idx(R,31));
  let rrw2:i32=src_rel(R,src_idx(R,32));
  at=e_str(ob,at,"R1 exposure relS="); at=e_i32(ob,at,rrs);
  at=e_str(ob,at," relW1="); at=e_i32(ob,at,rrw1);
  at=e_str(ob,at," relW2="); at=e_i32(ob,at,rrw2);
  at=e_str(ob,at," linear-null-W=666"); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(rrs,1000),"K4-R1-exposure-relS-1000");
  at=chk(ob,at,F,eq(rrw1,666),"K4-R1-exposure-relW1-666");
  at=chk(ob,at,F,eq(rrw2,666),"K4-R1-exposure-relW2-666");
  at=chk(ob,at,F,eq(st_compute(R),12),"K4-R1-stance-still-12");

  // ===== World C1: ordinary single errors, no streak =====
  let C:[]u8=z_alloc(NCELL()*4); st_init(C,0);
  // T: 1 correct weak, then 1 wrong weak (streak 1 at the error, p = floor(1/2) = 0)
  ev_calibrate(C,77,1,1,1,6001);
  ev_calibrate(C,77,1,1,2,6002);
  let rrt:i32=src_rel(C,src_idx(C,77));
  at=e_str(ob,at,"C1 T rel="); at=e_i32(ob,at,rrt);
  at=e_str(ob,at," linear-null=500"); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(rrt,500),"K5-C1-relT-500");
  // U: 1 wrong weak (streak 0, p = 0), then 1 correct weak
  ev_calibrate(C,78,1,1,2,6011);
  ev_calibrate(C,78,1,1,1,6012);
  let rru:i32=src_rel(C,src_idx(C,78));
  at=e_str(ob,at,"C1 U rel="); at=e_i32(ob,at,rru);
  at=e_str(ob,at," linear-null=500"); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(rru,500),"K5-C1-relU-500");

  let fails:i32=get32(F,0);
  if(fails==0){ at=e_str(ob,at,"ALL PASS\n"); }
  else { at=e_str(ob,at,"FAILURES: "); at=e_i32(ob,at,fails); at=e_nl(ob,at); }

  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),at as i64,0,0,0);
  if(fails==0){ return 0; }
  return 1;
}

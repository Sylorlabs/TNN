// l3b_v2.zag -- L3B constructor v2: program-space search + version archive.
//
// Redesign at the constructor level (not a vocabulary patch) addressing
// the adversary's crux exhibits at a40aac558:
//
// (1) Square-residual gap: the v1 analyzer (fixed vocabulary fit) could not detect or
// assemble what the interpreter can evaluate (MUL(VAR,VAR) -> 25). v2
// replaces vocabulary fitting with a generic enumerative program-space
// search: 205 small programs from a fixed generic grammar (atoms VAR,
// CONST 0..8; ops ADD, MUL, SUB; depth <= 2), evaluated by the UNCHANGED
// base interpreter, selected by exact fit on the failure window. The
// winning programs are ASSEMBLED by the generic constructors
// (CREATE/CONNECT), logged in the CALLS trace.
//
// (2) Alternating-regime churn: the v1 static single-program form rebuilt v1 as v3 from
// scratch. v2 keeps a version archive: every constructed version is
// archived; a single-failure dispatch test activates the archived
// version whose programs explain the current observation, with zero
// construction calls. Revision is recall, not rebuild.
//
// Prereg: PREREG_L3B_V2.md + PREREG_ADDENDUM_1.md, frozen alone at
// 05620eaa2 / 197e2547a BEFORE this file existed.
// Verdicts: L3B-V2-PASS / L3B-V2-PARTIAL / L3B-V2-FAIL (via shell harness).
//
// Pure Zag. No Python at any stage. u8-backed cells only.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn ia(n:i32)[]u8 { return z_alloc(n*4); }
fn ig(a:[]u8, i:i32)i32 {
  let b:i32=i*4;
  return (a[b] as i32)+((a[b+1] as i32)*256)+((a[b+2] as i32)*65536)+((a[b+3] as i32)*16777216);
}
fn is(a:[]u8, i:i32, v:i32)void {
  let b:i32=i*4;
  a[b]=(v & 255) as u8;
  a[b+1]=((v >> 8) & 255) as u8;
  a[b+2]=((v >> 16) & 255) as u8;
  a[b+3]=((v >> 24) & 255) as u8;
  return;
}
fn pe(s:[]u8)void { _zag_print(s); return; }
fn pi(v:i32)void { let t:[]u8=_zag_i64_to_str(v as i64); _zag_print(t); return; }
fn pn()void { _zag_print("\n"); return; }
fn pphase(p:i32)void {
  if(p==0){pe("LEARN");return;}
  if(p==1){pe("HIDDEN");return;}
  if(p==2){pe("CONTRADICTION");return;}
  pe("FOLLOWUP");return;
}

// INTERP-BEGIN
// Base interpreter for language B. Frozen base machinery.
// Ops: 1 is CONST, 2 is VAR, 3 is ADD, 4 is MUL, 5 is SUB.
// Standard arithmetic semantics. This function is the only place where
// B node semantics are implemented. Growth machinery may call it; no
// growth event may add a case, a tag, or a branch to it.
fn binterp_eval(nid:i32, f0:i32, n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:i32)i32 {
  if(nid<0){return 0;}
  if(nid>=ncnt){return 0;}
  let op:i32=ig(n_op,nid);
  if(op==1){return ig(n_cv,nid);}
  if(op==2){if(ig(n_ft,nid)!=0){return 0;}return f0;}
  let l:i32=binterp_eval(ig(n_l,nid), f0, n_op, n_l, n_r, n_cv, n_ft, ncnt);
  let r:i32=binterp_eval(ig(n_r,nid), f0, n_op, n_l, n_r, n_cv, n_ft, ncnt);
  if(op==3){return l+r;}
  if(op==4){return l*r;}
  if(op==5){return l-r;}
  return 0;
}
// INTERP-END

// ---- Generic construction operators (unchanged semantics; store cap
// raised 256 -> 2048 for the shared program table; the table lives at
// the bottom of the store and instances allocate above it) ----
// Node store: n_op, n_l, n_r, n_cv, n_ft; ncnt cell 0 = used count.
// Call log: lg_k kind (1=CREATE 2=CONNECT), lg_a, lg_b, lg_c args,
// lg_d assigned id; lgn cell 0 = record count.
fn lg_rec(lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
           k:i32, a:i32, b:i32, c:i32, d:i32)void {
  let i:i32=ig(lgn,0);
  is(lg_k,i,k); is(lg_a,i,a); is(lg_b,i,b); is(lg_c,i,c); is(lg_d,i,d);
  is(lgn,0,i+1);
  return;
}
fn ns_create(n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
             lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
             op:i32, cval:i32, feat:i32)i32 {
  let id:i32=ig(ncnt,0);
  if(id>=2048){pe("STORE-FULL");pn();return 2047;}
  is(n_op,id,op); is(n_l,id,255); is(n_r,id,255); is(n_cv,id,cval); is(n_ft,id,feat);
  is(ncnt,0,id+1);
  lg_rec(lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1, op, cval, feat, id);
  return id;
}
fn ns_connect(n_l:[]u8, n_r:[]u8,
              lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
              pid:i32, slot:i32, cid:i32)void {
  if(slot==0){is(n_l,pid,cid);}else{is(n_r,pid,cid);}
  lg_rec(lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 2, pid, slot, cid, -1);
  return;
}
fn print_calls(lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, from:i32, to:i32)void {
  let i:i32=from;
  while(i<to){
    let k:i32=ig(lg_k,i);
    pe(" ");
    if(k==1){pe("CREATE(op=");pi(ig(lg_a,i));pe(",val=");pi(ig(lg_b,i));pe(")->");pi(ig(lg_d,i));}
    if(k==2){pe("CONNECT(");pi(ig(lg_a,i));pe(",");pi(ig(lg_b,i));pe(",");pi(ig(lg_c,i));pe(")");}
    i=i+1;
  }
  return;
}

// ---- Base predictor language L (unchanged from v1) ----
fn cand_score(c:i32, tn:[]u8, tl1:[]u8, tl2:[]u8, m:i32)i32 {
  let c0:i32=c/64+1;
  let c1:i32=(c/8)%8+1;
  let c2:i32=c%8+1;
  let s:i32=0;
  let i:i32=0;
  while(i<m){
    if(c0==ig(tn,i) && c1==ig(tl1,i) && c2==ig(tl2,i)){s=s+1;}
    i=i+1;
  }
  return s;
}
fn best_cand(tn:[]u8, tl1:[]u8, tl2:[]u8, m:i32)i32 {
  if(m==0){return 0;}
  let best:i32=0;
  let bs:i32=-1;
  let c:i32=0;
  while(c<512){
    let s:i32=cand_score(c,tn,tl1,tl2,m);
    if(s>bs){bs=s;best=c;}
    c=c+1;
  }
  return best;
}
// KX-SQ: max over the 512 canonical singles on E_m, m=1..12,
// with l1=m, l2=m^2 (the square family).
fn kx_quad()i32 {
  let mx:i32=0;
  let c:i32=0;
  while(c<512){
    let c0:i32=c/64+1;
    let c1:i32=(c/8)%8+1;
    let c2:i32=c%8+1;
    let sc:i32=0;
    let m:i32=1;
    while(m<=12){
      if(c0==m && c1==m && c2==m*m){sc=sc+1;}
      m=m+1;
    }
    if(sc>mx){mx=sc;}
    c=c+1;
  }
  return mx;
}

// ---- Program table: 205 generic programs (prereg section 2a) ----
// Atoms: VAR, CONST 0..8. Depth 1: op in {ADD,MUL,SUB} over atom pairs
// (commutative ops canonical: smaller child first; const-const skipped).
// Depth 2: op over (VAR, depth1) and, for SUB, (depth1, VAR).
// Canonical order. Count asserted = 205 at startup.
fn gen_key(nid:i32, n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8,
           pool:[]u8, off:i32, pos:[]u8)void {
  let op:i32=ig(n_op,nid);
  if(op==2){
    pool[off+ig(pos,0)]=86 as u8;
    is(pos,0,ig(pos,0)+1);
    return;
  }
  if(op==1){
    let kk:i32=ig(n_cv,nid);
    pool[off+ig(pos,0)]=67 as u8;
    pool[off+ig(pos,0)+1]=(48+kk) as u8;
    is(pos,0,ig(pos,0)+2);
    return;
  }
  pool[off+ig(pos,0)]=40 as u8;
  is(pos,0,ig(pos,0)+1);
  if(op==3){ pool[off+ig(pos,0)]=65 as u8; }
  if(op==4){ pool[off+ig(pos,0)]=77 as u8; }
  if(op==5){ pool[off+ig(pos,0)]=83 as u8; }
  is(pos,0,ig(pos,0)+1);
  pool[off+ig(pos,0)]=44 as u8;
  is(pos,0,ig(pos,0)+1);
  gen_key(ig(n_l,nid), n_op,n_l,n_r,n_cv, pool,off,pos);
  pool[off+ig(pos,0)]=44 as u8;
  is(pos,0,ig(pos,0)+1);
  gen_key(ig(n_r,nid), n_op,n_l,n_r,n_cv, pool,off,pos);
  pool[off+ig(pos,0)]=41 as u8;
  is(pos,0,ig(pos,0)+1);
  return;
}
fn build_table(n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
               lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
               pg_root:[]u8, pg_pool:[]u8, pg_len:[]u8,
               atom:[]u8, d1:[]u8)i32 {
  is(atom,0, ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 2,0,0));
  let k:i32=0;
  while(k<=8){
    is(atom,k+1, ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1,k,0));
    k=k+1;
  }
  let pn:i32=0;
  let pos:[]u8=ia(1);
  let a:i32=0;
  while(a<10){
    is(pg_root,pn,ig(atom,a));
    is(pos,0,0);
    gen_key(ig(atom,a), n_op,n_l,n_r,n_cv, pg_pool, pn*48, pos);
    is(pg_len,pn,ig(pos,0));
    pn=pn+1;
    a=a+1;
  }
  let d1n:i32=0;
  let op:i32=3;
  while(op<=5){
    a=0;
    while(a<10){
      let b:i32=0;
      while(b<10){
        let bad:i32=0;
        if(a>0){ if(b>0){ bad=1; } }
        if(bad==0){
          if(op!=5){
            if(b<a){ bad=1; }
          }
        }
        if(bad==0){
          let nd:i32=ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, op,0,0);
          ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, nd,0,ig(atom,a));
          ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, nd,1,ig(atom,b));
          is(d1,d1n,nd);
          d1n=d1n+1;
          is(pg_root,pn,nd);
          is(pos,0,0);
          gen_key(nd, n_op,n_l,n_r,n_cv, pg_pool, pn*48, pos);
          is(pg_len,pn,ig(pos,0));
          pn=pn+1;
        }
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  op=3;
  while(op<=5){
    let d:i32=0;
    while(d<39){
      let nd:i32=ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, op,0,0);
      ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, nd,0,ig(atom,0));
      ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, nd,1,ig(d1,d));
      is(pg_root,pn,nd);
      is(pos,0,0);
      gen_key(nd, n_op,n_l,n_r,n_cv, pg_pool, pn*48, pos);
      is(pg_len,pn,ig(pos,0));
      pn=pn+1;
      if(op==5){
        let nd2:i32=ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, op,0,0);
        ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, nd2,0,ig(d1,d));
        ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, nd2,1,ig(atom,0));
        is(pg_root,pn,nd2);
        is(pos,0,0);
        gen_key(nd2, n_op,n_l,n_r,n_cv, pg_pool, pn*48, pos);
        is(pg_len,pn,ig(pos,0));
        pn=pn+1;
      }
      d=d+1;
    }
    op=op+1;
  }
  return pn;
}
// Print a key from a pool (single-char literals only).
fn pkey(pool:[]u8, off:i32, len:i32)void {
  let j:i32=0;
  while(j<len){
    let c:i32=(pool[off+j] as i32);
    if(c==86){pe("V");}
    else{
      if(c==67){pe("C");}
      else{
        if(c==40){pe("(");}
        else{
          if(c==41){pe(")");}
          else{
            if(c==44){pe(",");}
            else{
              if(c==65){pe("A");}
              else{
                if(c==77){pe("M");}
                else{
                  if(c==83){pe("S");}
                  else{ pi(c-48); }
                }
              }
            }
          }
        }
      }
    }
    j=j+1;
  }
  return;
}
fn copykey(src:[]u8, soff:i32, dst:[]u8, doff:i32, len:i32)void {
  let j:i32=0;
  while(j<len){
    dst[doff+j]=src[soff+j];
    j=j+1;
  }
  return;
}
// Pool key vs pool key.
fn keyeq2(p1:[]u8, o1:i32, l1:i32, p2:[]u8, o2:i32, l2:i32)i32 {
  if(l1!=l2){return 0;}
  let j:i32=0;
  while(j<l1){
    if((p1[o1+j] as i32)!=(p2[o2+j] as i32)){return 0;}
    j=j+1;
  }
  return 1;
}
// Pool key vs string literal (explicit literal length).
fn keyeq_lit(pool:[]u8, off:i32, len:i32, lit:[]u8, llen:i32)i32 {
  if(len!=llen){return 0;}
  let j:i32=0;
  while(j<len){
    if((pool[off+j] as i32)!=(lit[j] as i32)){return 0;}
    j=j+1;
  }
  return 1;
}
// ---- Generic enumerative search ----
fn prog_score(p:i32, wx:[]u8, wy:[]u8,
              pg_root:[]u8,
              n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8)i32 {
  let s:i32=0;
  let j:i32=0;
  while(j<3){
    let v:i32=binterp_eval(ig(pg_root,p), ig(wx,j), n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
    if(v==ig(wy,j)){s=s+1;}
    j=j+1;
  }
  return s;
}
fn search_exact(wx:[]u8, wy:[]u8,
                pg_root:[]u8,
                n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8)i32 {
  let i:i32=0;
  while(i<205){
    if(prog_score(i,wx,wy,pg_root,n_op,n_l,n_r,n_cv,n_ft,ncnt)==3){return i;}
    i=i+1;
  }
  return -1;
}
// Assemble a program from its key via the generic constructors.
// All CREATE/CONNECT calls are logged: the CALLS trace is the evidence
// that the form was constructed, not retrieved.
fn build_key(pool:[]u8, base:i32, pos:[]u8,
             n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
             lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8)i32 {
  let c:i32=(pool[base+ig(pos,0)] as i32);
  if(c==86){
    is(pos,0,ig(pos,0)+1);
    return ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 2,0,0);
  }
  if(c==67){
    let d:i32=(pool[base+ig(pos,0)+1] as i32)-48;
    is(pos,0,ig(pos,0)+2);
    return ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, 1,d,0);
  }
  is(pos,0,ig(pos,0)+1);
  let oc:i32=(pool[base+ig(pos,0)] as i32);
  let op:i32=3;
  if(oc==77){op=4;}
  if(oc==83){op=5;}
  is(pos,0,ig(pos,0)+2);
  let l:i32=build_key(pool,base,pos, n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn);
  is(pos,0,ig(pos,0)+1);
  let r:i32=build_key(pool,base,pos, n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn);
  is(pos,0,ig(pos,0)+1);
  let nd:i32=ns_create(n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, op,0,0);
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, nd,0,l);
  ns_connect(n_l,n_r, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, nd,1,r);
  return nd;
}

// ---- Learner state ----
// g cells: 0 active, 1 p1root, 2 p2root, 3 serial, 4 active archive index.
// Archive: av_p1/av_p2 roots, av_k1/av_k2 key bytes (48/version),
// av_l1/av_l2 key lengths, av_ser serials; avn cell 0 = version count.
// fb arrays cap 8 (failure buffer); fbn cell 0 = count;
// consec cell 0 = consecutive unexplained failures;
// tr arrays cap 32 (base-predictor training); trm cell 0 = count.
// cnt cells: 0 t1, 1 t2, 2 t3 (phase tallies), 3 creates, 4 dispatches,
// 5 recallok, 6 recallchecked, 7 quadfound, 8 nogrowth; 9 abl_total
// (preserved across reset_learner).
fn reset_learner(ncnt:[]u8, lgn:[]u8, tn:[]u8, tl:[]u8,
                 g:[]u8, avn:[]u8, fbn:[]u8, consec:[]u8, trm:[]u8, cnt:[]u8)void {
  is(ncnt,0,ig(tn,0));
  is(lgn,0,ig(tl,0));
  is(g,0,0); is(g,1,-1); is(g,2,-1); is(g,3,0); is(g,4,-1);
  is(avn,0,0); is(fbn,0,0); is(consec,0,0); is(trm,0,0);
  let i:i32=0;
  while(i<9){ is(cnt,i,0); i=i+1; }
  return;
}
fn fb_push(fb_l0:[]u8, fb_l1:[]u8, fb_l2:[]u8, fb_s1:[]u8, fb_s2:[]u8,
           fb_h0:[]u8, fb_h1:[]u8, fbn:[]u8,
           l0:i32,l1:i32,l2:i32,s1:i32,s2:i32,h0:i32,h1:i32)void {
  let idx:i32=0;
  let n:i32=ig(fbn,0);
  if(n<8){idx=n;is(fbn,0,n+1);}
  else{
    let i:i32=0;
    while(i<7){
      is(fb_l0,i,ig(fb_l0,i+1)); is(fb_l1,i,ig(fb_l1,i+1)); is(fb_l2,i,ig(fb_l2,i+1));
      is(fb_s1,i,ig(fb_s1,i+1)); is(fb_s2,i,ig(fb_s2,i+1));
      is(fb_h0,i,ig(fb_h0,i+1)); is(fb_h1,i,ig(fb_h1,i+1));
      i=i+1;
    }
    idx=7;
  }
  is(fb_l0,idx,l0); is(fb_l1,idx,l1); is(fb_l2,idx,l2);
  is(fb_s1,idx,s1); is(fb_s2,idx,s2); is(fb_h0,idx,h0); is(fb_h1,idx,h1);
  return;
}
// Single-failure dispatch: if an archived version other than the active
// one explains the current observation, activate it with zero
// construction calls. Returns 1 on dispatch, 0 otherwise.
fn try_dispatch(n:i32, tl1:i32, tl2:i32, ts1:i32, ts2:i32, h0:i32, h1:i32,
                g:[]u8,
                av_p1:[]u8, av_p2:[]u8, av_ser:[]u8, avn:[]u8,
                n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
                lgn:[]u8, cnt:[]u8)i32 {
  if(ts1!=h0){return 0;}
  if(ts2!=h1){return 0;}
  let ai:i32=ig(g,4);
  let a:i32=0;
  let nn:i32=ig(avn,0);
  while(a<nn){
    if(a!=ai){
      let e1:i32=binterp_eval(ig(av_p1,a), n, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
      let e2:i32=binterp_eval(ig(av_p2,a), n, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
      if(e1==tl1){
        if(e2==tl2){
          let lb:i32=ig(lgn,0);
          let from:i32=ig(av_ser,ai);
          is(g,1,ig(av_p1,a));
          is(g,2,ig(av_p2,a));
          is(g,4,a);
          is(cnt,4,ig(cnt,4)+1);
          is(cnt,6,ig(cnt,6)+1);
          if(ig(lgn,0)==lb){ is(cnt,5,ig(cnt,5)+1); }
          pe("TRACE-DISPATCH from=");pi(from);
          pe(" to=");pi(ig(av_ser,a));
          pe(" on=");pi(n);
          pe(" r1=");pi(ig(av_p1,a));
          pe(" r2=");pi(ig(av_p2,a));
          pn();
          return 1;
        }
      }
    }
    a=a+1;
  }
  return 0;
}
fn do_fire(inst:i32, phase:i32, ep:i32,
            n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
            lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
            g:[]u8,
            av_p1:[]u8, av_p2:[]u8, av_k1:[]u8, av_k2:[]u8,
            av_l1:[]u8, av_l2:[]u8, av_ser:[]u8, avn:[]u8,
            pg_root:[]u8, pg_pool:[]u8, pg_len:[]u8,
            fb_l0:[]u8, fb_l1:[]u8, fb_l2:[]u8, fb_s1:[]u8, fb_s2:[]u8,
            fb_h0:[]u8, fb_h1:[]u8, fbn:[]u8, cnt:[]u8)void {
  let wx:[]u8=ia(3);
  let wy1:[]u8=ia(3);
  let wy2:[]u8=ia(3);
  let sy:i32=1;
  let j:i32=0;
  while(j<3){
    let idx:i32=ig(fbn,0)-3+j;
    is(wx,j,ig(fb_l0,idx));
    is(wy1,j,ig(fb_l1,idx));
    is(wy2,j,ig(fb_l2,idx));
    if(ig(fb_s1,idx)!=ig(fb_h0,idx)){sy=0;}
    if(ig(fb_s2,idx)!=ig(fb_h1,idx)){sy=0;}
    j=j+1;
  }
  if(sy==0){
    pe("TRACE-NO-GROWTH inst=");pi(inst);pe(" ep=");pi(ep);pe(" why=symbol");pn();
    is(cnt,8,ig(cnt,8)+1);
    return;
  }
  let b1:i32=search_exact(wx,wy1, pg_root, n_op,n_l,n_r,n_cv,n_ft,ncnt);
  let b2:i32=search_exact(wx,wy2, pg_root, n_op,n_l,n_r,n_cv,n_ft,ncnt);
  if(b1<0){
    pe("TRACE-NO-GROWTH inst=");pi(inst);pe(" ep=");pi(ep);pe(" why=nosearch1");pn();
    is(cnt,8,ig(cnt,8)+1);
    return;
  }
  if(b2<0){
    pe("TRACE-NO-GROWTH inst=");pi(inst);pe(" ep=");pi(ep);pe(" why=nosearch2");pn();
    is(cnt,8,ig(cnt,8)+1);
    return;
  }
  let a:i32=0;
  let nn:i32=ig(avn,0);
  while(a<nn){
    if(keyeq2(pg_pool,b1*48,ig(pg_len,b1), av_k1,a*48,ig(av_l1,a))==1){
      if(keyeq2(pg_pool,b2*48,ig(pg_len,b2), av_k2,a*48,ig(av_l2,a))==1){
        let lb:i32=ig(lgn,0);
        let from:i32=ig(av_ser,ig(g,4));
        is(g,1,ig(av_p1,a)); is(g,2,ig(av_p2,a)); is(g,4,a);
        is(cnt,4,ig(cnt,4)+1);
        is(cnt,6,ig(cnt,6)+1);
        if(ig(lgn,0)==lb){ is(cnt,5,ig(cnt,5)+1); }
        pe("TRACE-DISPATCH from=");pi(from);
        pe(" to=");pi(ig(av_ser,a));
        pe(" on=fire r1=");pi(ig(av_p1,a));
        pe(" r2=");pi(ig(av_p2,a));
        pn();
        return;
      }
    }
    a=a+1;
  }
  let snap:i32=ig(lgn,0);
  let pos:[]u8=ia(1);
  is(pos,0,0);
  let r1:i32=build_key(pg_pool, b1*48, pos, n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn);
  is(pos,0,0);
  let r2:i32=build_key(pg_pool, b2*48, pos, n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn);
  let vn:i32=ig(avn,0);
  is(av_p1,vn,r1);
  is(av_p2,vn,r2);
  copykey(pg_pool,b1*48, av_k1,vn*48, ig(pg_len,b1));
  is(av_l1,vn,ig(pg_len,b1));
  copykey(pg_pool,b2*48, av_k2,vn*48, ig(pg_len,b2));
  is(av_l2,vn,ig(pg_len,b2));
  let ser:i32=ig(g,3)+1;
  is(g,3,ser);
  is(av_ser,vn,ser);
  is(avn,0,vn+1);
  is(g,0,1); is(g,1,r1); is(g,2,r2); is(g,4,vn);
  is(cnt,3,ig(cnt,3)+1);
  if(keyeq_lit(pg_pool,b2*48,ig(pg_len,b2),"(M,V,V)",7)==1){ is(cnt,7,1); }
  pe("TRACE-CREATE v=");pi(ser);pe(" p1=");pkey(pg_pool,b1*48,ig(pg_len,b1));
  pe(" p2=");pkey(pg_pool,b2*48,ig(pg_len,b2));
  pe(" r1=");pi(r1);pe(" r2=");pi(r2);pe(" ev=3");pn();
  pe("CALLS:");
  print_calls(lg_k,lg_a,lg_b,lg_c,lg_d,snap,ig(lgn,0));
  pn();
  return;
}
// One episode. tally: 1 t1, 2 t2, 3 t3, 4 abl_total; 0 none.
fn step(inst:i32, phase:i32, ep:i32, n:i32, h0:i32, h1:i32,
        ts1:i32, tl1:i32, ts2:i32, tl2:i32,
        allow_create:i32, is_learn:i32, tally:i32,
        n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
        lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
        g:[]u8,
        av_p1:[]u8, av_p2:[]u8, av_k1:[]u8, av_k2:[]u8,
        av_l1:[]u8, av_l2:[]u8, av_ser:[]u8, avn:[]u8,
        pg_root:[]u8, pg_pool:[]u8, pg_len:[]u8,
        fb_l0:[]u8, fb_l1:[]u8, fb_l2:[]u8, fb_s1:[]u8, fb_s2:[]u8,
        fb_h0:[]u8, fb_h1:[]u8, fbn:[]u8, consec:[]u8,
        tr_n:[]u8, tr_l1:[]u8, tr_l2:[]u8, trm:[]u8, cnt:[]u8)i32 {
  let ps1:i32=0; let pl1:i32=0; let ps2:i32=0; let pl2:i32=0;
  let made:i32=0;
  if(ig(g,0)==1){
    let r1:i32=binterp_eval(ig(g,1), n, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
    let r2:i32=binterp_eval(ig(g,2), n, n_op,n_l,n_r,n_cv,n_ft, ig(ncnt,0));
    if(r1>=1 && r2>=1){ps1=h0;pl1=r1;ps2=h1;pl2=r2;made=1;}
  }else{
    let bc:i32=best_cand(tr_n,tr_l1,tr_l2,ig(trm,0));
    let c0:i32=bc/64+1;
    let c1:i32=(bc/8)%8+1;
    let c2:i32=bc%8+1;
    if(c0==n){ps1=h0;pl1=c1;ps2=h1;pl2=c2;made=1;}
  }
  let ok:i32=0;
  if(made==1 && ps1==ts1 && pl1==tl1 && ps2==ts2 && pl2==tl2){ok=1;}
  if(ok==1){
    if(tally==1){is(cnt,0,ig(cnt,0)+1);}
    if(tally==2){is(cnt,1,ig(cnt,1)+1);}
    if(tally==3){is(cnt,2,ig(cnt,2)+1);}
    if(tally==4){is(cnt,9,ig(cnt,9)+1);}
    is(consec,0,0);
  }else{
    let disp:i32=0;
    if(ig(g,0)==1){
      disp=try_dispatch(n,tl1,tl2,ts1,ts2,h0,h1, g,
                        av_p1,av_p2,av_ser,avn,
                        n_op,n_l,n_r,n_cv,n_ft,ncnt, lgn, cnt);
    }
    if(disp==1){
      is(consec,0,0);
    }else{
      fb_push(fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn, n,tl1,tl2,ts1,ts2,h0,h1);
      is(consec,0,ig(consec,0)+1);
      if(ig(consec,0)>=3){
        if(allow_create==1){
          do_fire(inst,phase,ep, n_op,n_l,n_r,n_cv,n_ft,ncnt,
                  lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
                  av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
                  pg_root,pg_pool,pg_len,
                  fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn, cnt);
        }
        is(consec,0,0);
      }
    }
  }
  if(is_learn==1){
    let m:i32=ig(trm,0);
    is(tr_n,m,n); is(tr_l1,m,tl1); is(tr_l2,m,tl2);
    is(trm,0,m+1);
  }
  return ok;
}
fn set6(a:[]u8, a0:i32,a1:i32,a2:i32,a3:i32,a4:i32,a5:i32)void {
  is(a,0,a0);is(a,1,a1);is(a,2,a2);is(a,3,a3);is(a,4,a4);is(a,5,a5);
  return;
}
fn set3(a:[]u8, a0:i32,a1:i32,a2:i32)void {
  is(a,0,a0);is(a,1,a1);is(a,2,a2);
  return;
}
fn set2(a:[]u8, a0:i32,a1:i32)void {
  is(a,0,a0);is(a,1,a1);
  return;
}
fn emit_bar(name:[]u8, pass:i32)void {
  pe("V2-BAR ");pe(name);pe(" ");
  if(pass==1){pe("PASS");}else{pe("FAIL");}
  pn();
  return;
}
// ---- L3B v2 ADVERSARY main (replaces the builder main) ----
// Sealed attack worlds only. All mechanism functions above this line are
// byte-identical to 7a1d3265d (harness-verified). Prereg:
// PREREG_L3B_V2_ADV.md, frozen alone at 42538c6b6 BEFORE this file existed.
// Pure Zag. No Python at any stage. u8-backed cells only.

// Attack-episode wrapper: fixed symbols h0=97,h1=98, ts1=97,ts2=98.
fn aep(inst:i32, phase:i32, ep:i32, n:i32, tl1:i32, tl2:i32,
       ac:i32, il:i32, tally:i32,
       n_op:[]u8, n_l:[]u8, n_r:[]u8, n_cv:[]u8, n_ft:[]u8, ncnt:[]u8,
       lg_k:[]u8, lg_a:[]u8, lg_b:[]u8, lg_c:[]u8, lg_d:[]u8, lgn:[]u8,
       g:[]u8,
       av_p1:[]u8, av_p2:[]u8, av_k1:[]u8, av_k2:[]u8,
       av_l1:[]u8, av_l2:[]u8, av_ser:[]u8, avn:[]u8,
       pg_root:[]u8, pg_pool:[]u8, pg_len:[]u8,
       fb_l0:[]u8, fb_l1:[]u8, fb_l2:[]u8, fb_s1:[]u8, fb_s2:[]u8,
       fb_h0:[]u8, fb_h1:[]u8, fbn:[]u8, consec:[]u8,
       tr_n:[]u8, tr_l1:[]u8, tr_l2:[]u8, trm:[]u8, cnt:[]u8)i32 {
  return step(inst,phase,ep, n,97,98, 97,tl1,98,tl2, ac,il,tally,
       n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
       av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
       pg_root,pg_pool,pg_len,
       fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
       tr_n,tr_l1,tr_l2,trm, cnt);
}
fn adv_bar(name:[]u8, pass:i32)void {
  pe("ADV-BAR ");pe(name);pe(" ");
  if(pass==1){pe("PASS");}else{pe("FAIL");}
  pn();
  return;
}
fn main()i32 {
  let n_op:[]u8=ia(2048);
  let n_l:[]u8=ia(2048);
  let n_r:[]u8=ia(2048);
  let n_cv:[]u8=ia(2048);
  let n_ft:[]u8=ia(2048);
  let ncnt:[]u8=ia(1);
  let lg_k:[]u8=ia(4096);
  let lg_a:[]u8=ia(4096);
  let lg_b:[]u8=ia(4096);
  let lg_c:[]u8=ia(4096);
  let lg_d:[]u8=ia(4096);
  let lgn:[]u8=ia(1);
  let g:[]u8=ia(8);
  let av_p1:[]u8=ia(8);
  let av_p2:[]u8=ia(8);
  let av_k1:[]u8=z_alloc(384);
  let av_k2:[]u8=z_alloc(384);
  let av_l1:[]u8=ia(8);
  let av_l2:[]u8=ia(8);
  let av_ser:[]u8=ia(8);
  let avn:[]u8=ia(1);
  let pg_root:[]u8=ia(205);
  let pg_pool:[]u8=z_alloc(9840);
  let pg_len:[]u8=ia(205);
  let atom:[]u8=ia(10);
  let d1:[]u8=ia(39);
  let tn:[]u8=ia(1);
  let tl:[]u8=ia(1);
  let fb_l0:[]u8=ia(8);
  let fb_l1:[]u8=ia(8);
  let fb_l2:[]u8=ia(8);
  let fb_s1:[]u8=ia(8);
  let fb_s2:[]u8=ia(8);
  let fb_h0:[]u8=ia(8);
  let fb_h1:[]u8=ia(8);
  let fbn:[]u8=ia(1);
  let consec:[]u8=ia(1);
  let tr_n:[]u8=ia(32);
  let tr_l1:[]u8=ia(32);
  let tr_l2:[]u8=ia(32);
  let trm:[]u8=ia(1);
  let cnt:[]u8=ia(24);
  let ns3:[]u8=ia(3);

  pe("ADV-L3B-V2 frozen attack run");pn();

  let pcount:i32=build_table(n_op,n_l,n_r,n_cv,n_ft,ncnt,
                             lg_k,lg_a,lg_b,lg_c,lg_d,lgn,
                             pg_root,pg_pool,pg_len, atom,d1);
  pe("TABLE n=");pi(pcount);pn();
  if(pcount!=205){pe("TABLE-FAIL");pn();return 1;}
  is(tn,0,ig(ncnt,0));
  is(tl,0,ig(lgn,0));

  let i:i32=0;
  let p:i32=0;

  // ===== Family A: depth-3 required (tl2 = n^4) =====
  reset_learner(ncnt,lgn,tn,tl, g,avn,fbn,consec,trm,cnt);
  pe("ADV-FAMA begin");pn();
  set3(ns3, 2,3,4);
  i=0;
  while(i<3){
    let na:i32=ig(ns3,i);
    let n4a:i32=na*na*na*na;
    aep(1,0,i+1, na,na,n4a, 1,1,0,
        n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
        av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
        pg_root,pg_pool,pg_len,
        fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
        tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  set3(ns3, 5,6,7);
  i=0;
  while(i<3){
    let nb:i32=ig(ns3,i);
    let n4b:i32=nb*nb*nb*nb;
    aep(1,1,i+1, nb,nb,n4b, 1,0,1,
        n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
        av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
        pg_root,pg_pool,pg_len,
        fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
        tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  pe("ADV-FAMA done hidden=");pi(ig(cnt,0));
  pe(" creates=");pi(ig(cnt,3));pe(" nogrowth=");pi(ig(cnt,8));pn();
  p=0; if(ig(cnt,8)>=1){p=1;} adv_bar("A-NOSEARCH",p);
  p=0; if(ig(cnt,0)==0){p=1;} adv_bar("A-HIDDEN0",p);
  p=0; if(ig(cnt,3)==0){p=1;} adv_bar("A-CREATE0",p);
  p=0; if(ig(cnt,0)==3){p=1;} adv_bar("A-HIDDEN3",p);

  // ===== Family B: constant outside 0..8 (tl2 = n+12) =====
  reset_learner(ncnt,lgn,tn,tl, g,avn,fbn,consec,trm,cnt);
  pe("ADV-FAMB begin");pn();
  set3(ns3, 1,2,3);
  i=0;
  while(i<3){
    let nc:i32=ig(ns3,i);
    aep(2,0,i+1, nc,nc,nc+12, 1,1,0,
        n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
        av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
        pg_root,pg_pool,pg_len,
        fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
        tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  set3(ns3, 4,5,6);
  i=0;
  while(i<3){
    let nd:i32=ig(ns3,i);
    aep(2,1,i+1, nd,nd,nd+12, 1,0,1,
        n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
        av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
        pg_root,pg_pool,pg_len,
        fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
        tr_n,tr_l1,tr_l2,trm, cnt);
    i=i+1;
  }
  pe("ADV-FAMB done hidden=");pi(ig(cnt,0));
  pe(" creates=");pi(ig(cnt,3));pe(" nogrowth=");pi(ig(cnt,8));pn();
  p=0; if(ig(cnt,8)>=1){p=1;} adv_bar("B-NOSEARCH",p);
  p=0; if(ig(cnt,0)==0){p=1;} adv_bar("B-HIDDEN0",p);
  p=0; if(ig(cnt,3)==0){p=1;} adv_bar("B-CREATE0",p);
  p=0; if(ig(cnt,0)==3){p=1;} adv_bar("B-HIDDEN3",p);

  // ===== Family C: ambiguous dispatch =====
  reset_learner(ncnt,lgn,tn,tl, g,avn,fbn,consec,trm,cnt);
  pe("ADV-FAMC begin");pn();
  aep(3,1,1, 11,11,22, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,1,2, 12,12,24, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,1,3, 13,13,26, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,2,1, 11,11,15, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,2,2, 12,12,16, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,2,3, 13,13,17, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,3,1, 11,11,17, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,3,2, 12,12,18, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,3,3, 13,13,19, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,4,1, 21,21,25, 1,0,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,4,2, 6,6,12, 1,0,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,4,3, 7,7,13, 1,0,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,4,4, 8,8,14, 1,0,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(3,4,5, 9,9,15, 1,0,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  pe("ADV-FAMC done creates=");pi(ig(cnt,3));
  pe(" dispatches=");pi(ig(cnt,4));
  pe(" recallok=");pi(ig(cnt,5));pe("/");pi(ig(cnt,6));pn();
  p=0; if(ig(cnt,3)==3){p=1;} adv_bar("C-CREATE3",p);
  p=0; if(ig(cnt,4)==3){p=1;} adv_bar("C-DISP3",p);
  p=0; if(ig(cnt,5)==3){ if(ig(cnt,6)==3){p=1;} } adv_bar("C-RECALL3",p);

  // ===== Family D: 8-version churn + revisit (then Family E, same life) ==
  reset_learner(ncnt,lgn,tn,tl, g,avn,fbn,consec,trm,cnt);
  pe("ADV-FAMD begin");pn();
  let k:i32=1;
  while(k<=8){
    let m:i32=0;
    while(m<3){
      let nn:i32=11+m;
      let t2:i32=0;
      if(k==1){t2=2*nn;}
      if(k==2){t2=nn+4;}
      if(k==3){t2=nn+6;}
      if(k==4){t2=nn-2;}
      if(k==5){t2=3*nn;}
      if(k==6){t2=nn*nn;}
      if(k==7){t2=2*nn+1;}
      if(k==8){t2=nn+1;}
      aep(4,k,m+1, nn,nn,t2, 1,1,0,
          n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
          av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
          pg_root,pg_pool,pg_len,
          fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
          tr_n,tr_l1,tr_l2,trm, cnt);
      m=m+1;
    }
    k=k+1;
  }
  aep(4,9,1, 21,21,42, 1,0,1,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(4,9,2, 22,22,44, 1,0,1,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(4,9,3, 23,23,46, 1,0,1,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  pe("ADV-FAMD done creates=");pi(ig(cnt,3));
  pe(" dispatches=");pi(ig(cnt,4));
  pe(" recallok=");pi(ig(cnt,5));pe("/");pi(ig(cnt,6));
  pe(" revisit=");pi(ig(cnt,0));pn();
  p=0; if(ig(cnt,3)==8){p=1;} adv_bar("D-CREATE8",p);
  p=0; if(ig(cnt,4)==1){p=1;} adv_bar("D-DISP1",p);
  p=0; if(ig(cnt,5)==1){ if(ig(cnt,6)==1){p=1;} } adv_bar("D-RECALL1",p);
  p=0; if(ig(cnt,0)==2){p=1;} adv_bar("D-REVISIT3",p);

  // ===== Family E: 9th version (archive boundary probe) =====
  pe("ADV-FAME probe begin (9th distinct version; archive holds 8)");pn();
  aep(5,1,1, 11,11,18, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(5,1,2, 12,12,19, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  aep(5,1,3, 13,13,20, 1,1,0,
      n_op,n_l,n_r,n_cv,n_ft,ncnt, lg_k,lg_a,lg_b,lg_c,lg_d,lgn, g,
      av_p1,av_p2,av_k1,av_k2,av_l1,av_l2,av_ser,avn,
      pg_root,pg_pool,pg_len,
      fb_l0,fb_l1,fb_l2,fb_s1,fb_s2,fb_h0,fb_h1,fbn,consec,
      tr_n,tr_l1,tr_l2,trm, cnt);
  pe("ADV-FAME probe end");pn();

  pe("ADV-DONE");pn();
  return 0;
}

// X-RV6 adversary main: attacks X-RV6-1, X-RV6-3, X-RV6-5 empirically.
// X-RV6-2 and X-RV6-4 are static/regression analyses (see result doc).
fn main()i32 {
  emit("=== X-RV6: H-REVISE6 red team attacks ===\n");
  let in0:[]u8="abc"; let in1:[]u8="def";
  let in2:[]u8="ghi"; let in3:[]u8="jkl";

  // ============ X-RV6-1: X-RV5-1 correlated-fail2 replay ============
  emit("\n--- X-RV6-1: correlated fail2 replay ---\n");
  let V1:[]u8=z_alloc(512);
  let p01:[]u8=z_alloc(48);
  p01[0]=1; p01[1]=255; p01[2]=255;
  p01[3]=3; p01[4]=255; p01[5]=255;
  p01[6]=6; p01[7]=0; p01[8]=1;
  vs3_init(V1, p01, 3);
  let D1:[]u8=z_alloc(256);
  let pd1:[]u8=z_alloc(4*8);
  let o1:i32=0;
  set32(pd1, 0, o1); set32(pd1, 4, dcopy(D1, o1, in0)); o1=o1+in0.len;
  set32(pd1, 8, o1); set32(pd1, 12, dcopy(D1, o1, in1)); o1=o1+in1.len;
  set32(pd1, 16, o1); set32(pd1, 20, dcopy(D1, o1, in2)); o1=o1+in2.len;
  set32(pd1, 24, o1); set32(pd1, 28, dcopy(D1, o1, in3)); o1=o1+in3.len;
  let f1a:[]u8="zqy"; let f1o:[]u8="zzz";
  let dr1:i32=diagnose_propose(D1, pd1, 4, f1a, f1o);
  if(dr1==122){
    emit("X61-A propose==(0,122) EXPECTED\n");
  } else {
    emit("X61-A propose UNEXPECTED got "); emit(i32s(dr1)); emit("\n");
  }
  let seq1:[]u8=z_alloc(64);
  let s1n:i32=pextract(f1a, f1o, seq1);
  let S1:[]u8=z_alloc(64);
  let c1:i32=0;
  while(c1<s1n){ set32(S1, c1*4, get32(seq1, c1*4)); c1=c1+1; }
  let dsc1:[]u8=z_alloc(12);
  set32(dsc1, 0, 0); set32(dsc1, 4, s1n); set32(dsc1, 8, f1a.len);
  let p1a:[]u8=z_alloc(48);
  let nn1a:i32=discover(S1, dsc1, 1, p1a);
  if(nn1a>0){
    emit("X61-B discover P1 nn="); emit(i32s(nn1a)); emit(" EXPECTED\n");
  } else {
    emit("X61-B discover FAILED\n");
  }
  let f2a:[]u8="zab"; let f2o:[]u8="zzz";
  let cor1:i32=diagnose_corroborate_v6(V1, f2a, f2o, 0, 122, p1a, nn1a);
  let rc1:i32=0;
  if(cor1==1){
    emit("X61-C gate returns 1 (wrong revision corroborated)\n");
    rc1=vs3_revise(V1, 0, 122, p1a, nn1a);
  } else {
    emit("X61-C gate returned 0 (withheld; contradicts builder limit claim)\n");
  }
  let ho1:[]u8=z_alloc(16);
  let hb1:[]u8="zbq";
  let broke1:i32=0;
  if(vs3_apply(V1, hb1, ho1)==1 && streq(ho1[0..3], "qqq")!=1){ broke1=1; }
  if(cor1==1 && rc1==1 && broke1==1){
    emit("X-RV6-1 ATTACK-SUCCEEDS: residual confirmed (gate passes correlated fail2; wrong revision appended; held-out zbq breaks)\n");
  } else {
    emit("X-RV6-1 INCONCLUSIVE: cor="); emit(i32s(cor1));
    emit(" rc="); emit(i32s(rc1));
    emit(" broke="); emit(i32s(broke1)); emit("\n");
  }

  // ============ X-RV6-3: (b) on genuine revisions ============
  emit("\n--- X-RV6-3: new (b) on genuine revisions ---\n");
  let V3:[]u8=z_alloc(512);
  let p03:[]u8=z_alloc(48);
  p03[0]=1; p03[1]=255; p03[2]=255;
  p03[3]=3; p03[4]=255; p03[5]=255;
  p03[6]=6; p03[7]=0; p03[8]=1;
  vs3_init(V3, p03, 3);
  let g1a:[]u8="xbc"; let g1o:[]u8="cbx";
  let gseq:[]u8=z_alloc(64);
  let gsn:i32=pextract(g1a, g1o, gseq);
  let GS:[]u8=z_alloc(64);
  let gc:i32=0;
  while(gc<gsn){ set32(GS, gc*4, get32(gseq, gc*4)); gc=gc+1; }
  let gdsc:[]u8=z_alloc(12);
  set32(gdsc, 0, 0); set32(gdsc, 4, gsn); set32(gdsc, 8, g1a.len);
  let gp1:[]u8=z_alloc(48);
  let gnn:i32=discover(GS, gdsc, 1, gp1);
  emit("X63-A discover P1 nn="); emit(i32s(gnn)); emit(" prog=");
  prog_emit(gp1, gnn); emit("\n");
  let g2a:[]u8="xqp"; let g2o:[]u8="pqx";
  let gchk:[]u8=z_alloc(16);
  let gok:i32=prog_apply_direct(gp1, gnn, g2a, gchk);
  if(gok==1 && streq(gchk[0..3], g2o)==1){
    emit("X63-B P1 generalizes to fail2 (genuine fixture valid)\n");
    let cor3a:i32=diagnose_corroborate_v6(V3, g2a, g2o, 0, 120, gp1, gnn);
    if(cor3a==1){
      emit("X63-C gate returns 1 on genuine len-3 revision: (b) does not false-withhold\n");
    } else {
      emit("X63-C GATE FALSE-WITHHOLD on genuine revision: ATTACK-SUCCEEDS\n");
    }
    let g2b:[]u8="xqpw"; let g2ob:[]u8="wpqx";
    let gchkb:[]u8=z_alloc(16);
    let gokb:i32=prog_apply_direct(gp1, gnn, g2b, gchkb);
    if(gokb==1 && streq(gchkb[0..4], g2ob)==1){
      emit("X63-D P1 generalizes to len-4 fail2\n");
      let cor3b:i32=diagnose_corroborate_v6(V3, g2b, g2ob, 0, 120, gp1, gnn);
      if(cor3b==1){
        emit("X63-E gate returns 1 on genuine len-4 revision: (b) length-general\n");
      } else {
        emit("X63-E GATE FALSE-WITHHOLD on genuine len-4 revision: ATTACK-SUCCEEDS\n");
      }
    } else {
      emit("X63-D P1 does not generalize to len-4 (fixture inconclusive for length)\n");
    }
  } else {
    emit("X63-B P1 does not generalize to fail2 (fixture inconclusive; discovered P1 is n=3-specific)\n");
  }

  // ============ X-RV6-5: independent (c) failure ============
  emit("\n--- X-RV6-5: independent (c) failure path ---\n");
  let V5:[]u8=z_alloc(512);
  let p05:[]u8=z_alloc(48);
  p05[0]=1; p05[1]=255; p05[2]=255;
  p05[3]=3; p05[4]=255; p05[5]=255;
  p05[6]=6; p05[7]=0; p05[8]=1;
  vs3_init(V5, p05, 3);
  let b1a:[]u8="xab"; let b1o:[]u8="xxx";
  let bseq:[]u8=z_alloc(64);
  let bsn:i32=pextract(b1a, b1o, bseq);
  let BS:[]u8=z_alloc(64);
  let bc:i32=0;
  while(bc<bsn){ set32(BS, bc*4, get32(bseq, bc*4)); bc=bc+1; }
  let bdsc:[]u8=z_alloc(12);
  set32(bdsc, 0, 0); set32(bdsc, 4, bsn); set32(bdsc, 8, b1a.len);
  let bp1:[]u8=z_alloc(48);
  let bnn:i32=discover(BS, bdsc, 1, bp1);
  let r5a:i32=vs3_revise(V5, 0, 120, bp1, bnn);
  if(r5a==1){
    emit("X65-A R1 revision (0,120)->broadcast-first appended\n");
  } else {
    emit("X65-A revise FAILED\n");
  }
  let c2a:[]u8="xqw"; let c2o:[]u8="xxx";
  let cor5:i32=diagnose_corroborate_v6(V5, c2a, c2o, 0, 120, bp1, bnn);
  if(cor5==0){
    emit("X65-B gate returns 0 on already-handled fail2: (c) fails independently. DEFENSE HOLDS\n");
  } else {
    emit("X65-B GATE RETURNS 1 on already-handled fail2: duplicate revision would append. ATTACK-SUCCEEDS\n");
  }
  if(get32(V5,0)==1){
    emit("X65-C vcount==1 (no duplicate appended)\n");
  } else {
    emit("X65-C vcount!=1 UNEXPECTED\n");
  }

  emit("\n=== X-RV6 empirical attacks complete ===\n");
  return 0;
}

// rb_world.zag -- tiny world + drift constructors for SPEC-RELATIONBLIND.
// ALL world literals live in this file. rb_main.zag reaches them only
// through the rb_* accessors below; rb_fix.zag contains none.
// fact_add / world_new come from da_base.zag (same assembly).
fn rb_rel_a()i32 { return 901; }
fn rb_rel_b()i32 { return 902; }
fn rb_subj1()i32 { return 1; }
fn rb_subj2()i32 { return 2; }
fn rb_subj3()i32 { return 3; }
fn rb_obj_a1()i32 { return 10; }
fn rb_obj_a2()i32 { return 20; }
fn rb_obj_b1()i32 { return 30; }
fn rb_obj_b2()i32 { return 40; }
// Tiny world: slot 0: (1,901,10); slot 1: (2,901,20);
// slot 2: (1,902,30); slot 3: (3,902,40).
fn rb_setup(A:[]u8)void {
  set32(A,0,0);
  fact_add(A,1,901,10);
  fact_add(A,2,901,20);
  fact_add(A,1,902,30);
  fact_add(A,3,902,40);
  return;
}
// D1 drift: change ONLY the relation field at slot 0 (901 -> 902).
// No index shift, no deletion, same fact count. This isolates
// relation-blindness from positional staleness.
fn rb_drift_relswap(A:[]u8)void {
  set32(A,4+0*12+4,902);
  return;
}
// D3 drift (t14 analog): rebuild the world with the 901 facts deleted.
// Stale buckets built on the 4-fact world keep indices {0,1} for 901,
// which now address 902 facts.
fn rb_drift_deletion(A:[]u8)void {
  set32(A,0,0);
  fact_add(A,1,902,10);
  fact_add(A,3,902,40);
  return;
}

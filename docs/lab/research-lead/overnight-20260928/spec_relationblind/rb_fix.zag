// rb_fix.zag -- experimental relation-revalidating variants of the
// learner-owned specialized procedures. These are EXACT copies of
// ret_spec / cnt_spec from da_learn.zag with one change: each bucketed
// slot revalidates the relation id (fr==rel) before its subject/object
// is used. Nesting depth is kept identical to the originals (match
// flags hoisted, body gated on the combined flag).
//
// These are experimental variants for the SPEC-RELATIONBLIND lane only.
// They are NOT merged into da_learn.zag. No world literals appear here:
// the relation arrives as the rel parameter.
// ret_spec_fix: ret_spec + relation revalidation.
fn ret_spec_fix(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    let mrel:i32=0;
    if(fr==rel){ mrel=1; }
    let mobj:i32=0;
    if(fo==obj){ mobj=1; }
    let both:i32=0;
    if(mrel==1){ if(mobj==1){ both=1; } }
    if(both==1){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
// cnt_spec_fix: cnt_spec + relation revalidation.
fn cnt_spec_fix(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fr:i32=get32(A,4+j*12+4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      let mrel:i32=0;
      if(fr==rel){ mrel=1; }
      let msub:i32=0;
      if(fs==subj){ msub=1; }
      let both:i32=0;
      if(mrel==1){ if(msub==1){ both=1; } }
      if(both==1){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<64){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}

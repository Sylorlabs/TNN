// rb_main.zag -- harness main for SPEC-RELATIONBLIND.
// Builds learner state with the REAL specialize_* from da_learn.zag on
// the tiny world, then runs D0 (control), D1 (in-place relation drift),
// D2 (fix variants on the D1 world), D3 (deletion-shift, t14 analog).
// World literals arrive only via the rb_* accessors from rb_world.zag.
fn rb_emit_ret(B:[]u8,c:i32,tag:[]u8,rs:i32,rg:i32,sout:i32,gout:i32,ag:i32,kbs:i32,kbg:i32)i32 {
  c=o_app(B,c,tag);
  c=o_app(B,c," spec=");
  c=o_i64(B,c,rs as i64);
  c=o_app(B,c," gen=");
  c=o_i64(B,c,rg as i64);
  c=o_app(B,c," sout=");
  c=o_i64(B,c,sout as i64);
  c=o_app(B,c," gout=");
  c=o_i64(B,c,gout as i64);
  c=o_app(B,c," agree=");
  c=o_i64(B,c,ag as i64);
  c=o_app(B,c," kbs=");
  c=o_i64(B,c,kbs as i64);
  c=o_app(B,c," kbg=");
  c=o_i64(B,c,kbg as i64);
  c=o_nl(B,c);
  return c;
}
fn rb_emit_12(B:[]u8,c:i32,tag:[]u8,vs:i32,vg:i32,ag:i32,kbs:i32,kbg:i32)i32 {
  c=o_app(B,c,tag);
  c=o_app(B,c," spec=");
  c=o_i64(B,c,vs as i64);
  c=o_app(B,c," gen=");
  c=o_i64(B,c,vg as i64);
  c=o_app(B,c," agree=");
  c=o_i64(B,c,ag as i64);
  c=o_app(B,c," kbs=");
  c=o_i64(B,c,kbs as i64);
  c=o_app(B,c," kbg=");
  c=o_i64(B,c,kbg as i64);
  c=o_nl(B,c);
  return c;
}
// agree for RET-shaped results: same count and same first element.
fn rb_agree_ret(rs:i32,rg:i32,sout:i32,gout:i32)i32 {
  if(rs!=rg){ return 0; }
  if(rs==0){ return 1; }
  if(sout==gout){ return 1; }
  return 0;
}
fn rb_agree_n(vs:i32,vg:i32)i32 {
  if(vs==vg){ return 1; }
  return 0;
}
fn main()i32 {
  let B:[]u8=z_alloc(4096);
  let c:i32=0;
  let L:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let K:[]u8=z_alloc(4096);
  let OUT:[]u8=z_alloc(512);
  let OUTG:[]u8=z_alloc(512);
  let SB:[]u8=z_alloc(64);
  let seen:[]u8=z_alloc(512);
  let Cc:[]u8=chain_new();
  let ra:i32=rb_rel_a();
  let rbb:i32=rb_rel_b();
  let s1:i32=rb_subj1();
  let oa1:i32=rb_obj_a1();
  // Learner state built with the REAL specialize functions on the
  // pristine tiny world. Buckets: 901 -> slots {0,1}, 902 -> {2,3}.
  rb_setup(A);
  ret_log_rel(L,ra); ret_log_rel(L,rbb);
  specialize_ret(L,S,A,0,0);
  vfy_log_rel(L,ra); vfy_log_rel(L,rbb);
  specialize_vfy(L,S,A,0,0);
  cnt_log_rel(L,ra); cnt_log_rel(L,rbb);
  specialize_cnt(L,S,A,0,0);
  set32(SB,0,s1);
  chain_add(Cc,s1,ra,oa1);
  // ---- D0: control, no drift ----
  c=o_app(B,c,"STAGE D0"); c=o_nl(B,c);
  set32(K,0,0);
  let rs0:i32=ret_spec(L,A,ra,oa1,K,0,OUT,0);
  let kbs0:i32=get32(K,0);
  set32(K,0,0);
  let rg0:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbg0:i32=get32(K,0);
  let so0:i32=-1;
  if(rs0>0){ so0=get32(OUT,4); }
  let go0:i32=-1;
  if(rg0>0){ go0=get32(OUTG,4); }
  c=rb_emit_ret(B,c,"D0RET",rs0,rg0,so0,go0,rb_agree_ret(rs0,rg0,so0,go0),kbs0,kbg0);
  set32(K,0,0);
  let cs0:i32=cnt_spec(L,A,ra,SB,0,1,K,0,seen);
  let kcs0:i32=get32(K,0);
  set32(K,0,0);
  let cg0:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcg0:i32=get32(K,0);
  c=rb_emit_12(B,c,"D0CNT",cs0,cg0,rb_agree_n(cs0,cg0),kcs0,kcg0);
  set32(K,0,0);
  let vs0:i32=vfy_spec(L,A,Cc,K,0);
  let kvs0:i32=get32(K,0);
  set32(K,0,0);
  let vg0:i32=vfy_gen(A,Cc,K,0);
  let kvg0:i32=get32(K,0);
  c=rb_emit_12(B,c,"D0VFY",vs0,vg0,rb_agree_n(vs0,vg0),kvs0,kvg0);
  // D0 fix-equivalence diagnostic (not a frozen kill bar): on the
  // pristine world the fix variants must behave exactly like the
  // originals, ruling out a degenerate always-zero transcription.
  set32(K,0,0);
  let rf0:i32=ret_spec_fix(L,A,ra,oa1,K,0,OUT,0);
  let kbf0:i32=get32(K,0);
  set32(K,0,0);
  let rgf0:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbgf0:i32=get32(K,0);
  let sof0:i32=-1;
  if(rf0>0){ sof0=get32(OUT,4); }
  let gof0:i32=-1;
  if(rgf0>0){ gof0=get32(OUTG,4); }
  c=rb_emit_ret(B,c,"D0RETFIX",rf0,rgf0,sof0,gof0,rb_agree_ret(rf0,rgf0,sof0,gof0),kbf0,kbgf0);
  set32(K,0,0);
  let cf0:i32=cnt_spec_fix(L,A,ra,SB,0,1,K,0,seen);
  let kcf0:i32=get32(K,0);
  set32(K,0,0);
  let cgf0:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcgf0:i32=get32(K,0);
  c=rb_emit_12(B,c,"D0CNTFIX",cf0,cgf0,rb_agree_n(cf0,cgf0),kcf0,kcgf0);
  // ---- D1: in-place relation change at slot 0 (901 -> 902) ----
  rb_drift_relswap(A);
  c=o_app(B,c,"STAGE D1"); c=o_nl(B,c);
  set32(K,0,0);
  let rs1:i32=ret_spec(L,A,ra,oa1,K,0,OUT,0);
  let kbs1:i32=get32(K,0);
  set32(K,0,0);
  let rg1:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbg1:i32=get32(K,0);
  let so1:i32=-1;
  if(rs1>0){ so1=get32(OUT,4); }
  let go1:i32=-1;
  if(rg1>0){ go1=get32(OUTG,4); }
  c=rb_emit_ret(B,c,"D1RET",rs1,rg1,so1,go1,rb_agree_ret(rs1,rg1,so1,go1),kbs1,kbg1);
  set32(K,0,0);
  let cs1:i32=cnt_spec(L,A,ra,SB,0,1,K,0,seen);
  let kcs1:i32=get32(K,0);
  set32(K,0,0);
  let cg1:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcg1:i32=get32(K,0);
  c=rb_emit_12(B,c,"D1CNT",cs1,cg1,rb_agree_n(cs1,cg1),kcs1,kcg1);
  set32(K,0,0);
  let vs1:i32=vfy_spec(L,A,Cc,K,0);
  let kvs1:i32=get32(K,0);
  set32(K,0,0);
  let vg1:i32=vfy_gen(A,Cc,K,0);
  let kvg1:i32=get32(K,0);
  c=rb_emit_12(B,c,"D1VFY",vs1,vg1,rb_agree_n(vs1,vg1),kvs1,kvg1);
  // ---- D2: fix variants on the D1 drifted world ----
  c=o_app(B,c,"STAGE D2"); c=o_nl(B,c);
  set32(K,0,0);
  let rf2:i32=ret_spec_fix(L,A,ra,oa1,K,0,OUT,0);
  let kbf2:i32=get32(K,0);
  set32(K,0,0);
  let rg2:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbg2:i32=get32(K,0);
  let sof2:i32=-1;
  if(rf2>0){ sof2=get32(OUT,4); }
  let gof2:i32=-1;
  if(rg2>0){ gof2=get32(OUTG,4); }
  c=rb_emit_ret(B,c,"D2RETFIX",rf2,rg2,sof2,gof2,rb_agree_ret(rf2,rg2,sof2,gof2),kbf2,kbg2);
  set32(K,0,0);
  let cf2:i32=cnt_spec_fix(L,A,ra,SB,0,1,K,0,seen);
  let kcf2:i32=get32(K,0);
  set32(K,0,0);
  let cg2:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcg2:i32=get32(K,0);
  c=rb_emit_12(B,c,"D2CNTFIX",cf2,cg2,rb_agree_n(cf2,cg2),kcf2,kcg2);
  // ---- D3: deletion-shift (t14 analog), stale buckets on rebuilt world ----
  rb_drift_deletion(A);
  c=o_app(B,c,"STAGE D3"); c=o_nl(B,c);
  set32(K,0,0);
  let rs3:i32=ret_spec(L,A,ra,oa1,K,0,OUT,0);
  let kbs3:i32=get32(K,0);
  set32(K,0,0);
  let rg3:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbg3:i32=get32(K,0);
  let so3:i32=-1;
  if(rs3>0){ so3=get32(OUT,4); }
  let go3:i32=-1;
  if(rg3>0){ go3=get32(OUTG,4); }
  c=rb_emit_ret(B,c,"D3RET",rs3,rg3,so3,go3,rb_agree_ret(rs3,rg3,so3,go3),kbs3,kbg3);
  set32(K,0,0);
  let cs3:i32=cnt_spec(L,A,ra,SB,0,1,K,0,seen);
  let kcs3:i32=get32(K,0);
  set32(K,0,0);
  let cg3:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcg3:i32=get32(K,0);
  c=rb_emit_12(B,c,"D3CNT",cs3,cg3,rb_agree_n(cs3,cg3),kcs3,kcg3);
  set32(K,0,0);
  let rf3:i32=ret_spec_fix(L,A,ra,oa1,K,0,OUT,0);
  let kbf3:i32=get32(K,0);
  set32(K,0,0);
  let rgf3:i32=ret_gen(A,ra,oa1,K,0,OUTG,0);
  let kbgf3:i32=get32(K,0);
  let sof3:i32=-1;
  if(rf3>0){ sof3=get32(OUT,4); }
  let gof3:i32=-1;
  if(rgf3>0){ gof3=get32(OUTG,4); }
  c=rb_emit_ret(B,c,"D3RETFIX",rf3,rgf3,sof3,gof3,rb_agree_ret(rf3,rgf3,sof3,gof3),kbf3,kbgf3);
  set32(K,0,0);
  let cf3:i32=cnt_spec_fix(L,A,ra,SB,0,1,K,0,seen);
  let kcf3:i32=get32(K,0);
  set32(K,0,0);
  let cgf3:i32=cnt_gen(A,ra,SB,0,1,K,0,seen);
  let kcgf3:i32=get32(K,0);
  c=rb_emit_12(B,c,"D3CNTFIX",cf3,cgf3,rb_agree_n(cf3,cgf3),kcf3,kcgf3);
  o_flush(B,c);
  return 0;
}

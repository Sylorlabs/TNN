// f3_p2.zag -- F3 Phase 2 learner: OP-PROP + per-rule refutation.
// Concatenate BEFORE f2_ood/world_ood4.zag (which provides w_* and main).
// The learner NEVER reads sealed laws.
// Prereg: 0071846fa (frozen before implementation). Pure Zag. No Python.
//
// Phase 2 scope (design 68aa2f6e8, build-order item 2):
// - One rule set per effect var; ALL OP-PROP candidates become rules.
// - Per-rule refutation: a rule dies only on a false-positive
//   observation (rule fires, V=0); the set survives while any rule
//   stands. Refutation drill on a scratch copy proves the path is live.
// - T-DISJ: W4 disjunction Y=X(t-1)|Z(t-2); both true rules retained.
// NOT in Phase 2: OP-GROW/SPLIT/VAR, EXTEND/STOP (Dcur=4 fixed),
// verification stream, REVISE, doubt gating, history use.

// ============ utils (world-facing: world files need these) ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ F2-format advance (world-facing) ============
// REQUIRED by world files: w_act calls L_advance with 5-byte
// [c,e,d,cx,cv] rules. World-facing infrastructure; F2 semantics verbatim.
fn L_advance(hist:[]u8, t:i32, rules:[]u8, nr:i32, nvars:i32)void {
  let e:i32=0;
  while(e<nvars){
    let nv:i32=0;
    let r:i32=0;
    while(r<nr){
      let b:i32=r*5;
      if((rules[b+1] as i32)==e){
        let c:i32=rules[b] as i32;
        let d:i32=rules[b+2] as i32;
        let s:i32=t-d;
        if(s>=0 && hist[c*32+s]==1){
          let cx:i32=rules[b+3] as i32;
          if(cx==255){ nv=1; }
          else if(hist[cx*32+s]==rules[b+4]){ nv=1; }
        }
      }
      r=r+1;
    }
    hist[e*32+t]=nv as u8;
    e=e+1;
  }
  return;
}

// ============ F3 persistent state layout (design section 3) ============
fn ST_RULES()i32 { return 0; }     // 164 bytes: 4 vars x 41
fn ST_EFFECTS()i32 { return 164; }  // 48 bytes: 16 codes x 3
fn ST_VERIFY()i32 { return 212; }   // 16 bytes: allocated, quiescent P1
fn ST_HISTORY()i32 { return 228; } // 656 bytes: allocated, empty P1
fn ST_DOUBT()i32 { return 884; }    // 4 bytes: zeroed, ungated P1
fn ST_VARIED()i32 { return 888; }   // 4 bytes: tracked P1
fn ST_DCUR()i32 { return 892; }     // i32: fixed at 4 in P1
fn ST_SIZE()i32 { return 896; }

// Rule set: per var V at ST_RULES()+V*41: byte0=nrules,
// then 4 rules x 10 bytes: [nlit, s0,p0,d0, s1,p1,d1, s2,p2,d2].
// pol: 1=+, 0=-.
fn RS_nr(st:[]u8, v:i32)i32 { return st[ST_RULES()+v*41] as i32; }
fn RS_set_nr(st:[]u8, v:i32, n:i32)void {
  st[ST_RULES()+v*41]=n as u8; return;
}
fn RL_set(st:[]u8, v:i32, r:i32, i:i32, s:i32, pol:i32, d:i32)void {
  let b:i32=ST_RULES()+v*41+1+r*10;
  if(i==0){ st[b]=1; }
  st[b+1+i*3]=s as u8; st[b+1+i*3+1]=pol as u8; st[b+1+i*3+2]=d as u8;
  return;
}
fn RL_set_nlit(st:[]u8, v:i32, r:i32, n:i32)void {
  st[ST_RULES()+v*41+1+r*10]=n as u8; return;
}

// Effects: code a=kind*8+v at ST_EFFECTS()+a*3: (type,var,val).
// type: 0=NULL, 1=SETS, 2=ADVANCES_TIME, 3=OBSERVES.
fn EF_set(st:[]u8, a:i32, ty:i32, vv:i32, val:i32)void {
  st[ST_EFFECTS()+a*3]=ty as u8;
  st[ST_EFFECTS()+a*3+1]=vv as u8;
  st[ST_EFFECTS()+a*3+2]=val as u8;
  return;
}
fn EF_type(st:[]u8, a:i32)i32 { return st[ST_EFFECTS()+a*3] as i32; }
fn EF_var(st:[]u8, a:i32)i32 { return st[ST_EFFECTS()+a*3+1] as i32; }
fn EF_val(st:[]u8, a:i32)i32 { return st[ST_EFFECTS()+a*3+2] as i32; }

// ============ emit helpers ============
fn F3_emit_prim(kk:i32, vv:i32)void {
  if(kk==0){ emit("S"); }
  else if(kk==1){ emit("C"); }
  else if(kk==2){ emit("W"); }
  else { emit("O"); }
  if(kk!=2){ emit(w_vname(vv)); }
  return;
}
fn F3_emit_seq(sk:[]u8, sv:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){ emit(","); }
    F3_emit_prim(sk[i] as i32, sv[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}
fn F3_emit_lit(s:i32, pol:i32, d:i32)void {
  if(pol==0){ emit("!"); }
  emit(w_vname(s)); emit("@"); e64(d);
  return;
}
fn vname_eq(v:i32, s:[]u8)i32 {
  let nm:[]u8=w_vname(v);
  if(nm.len!=s.len){ return 0; }
  let i:i32=0;
  while(i<nm.len){ if(nm[i]!=s[i]){ return 0; } i=i+1; }
  return 1;
}

// ============ OP-PROBE (design section 6) ============
// Harness-side initialization: probes each action code 3x in a controlled
// context and classifies into effects[]. Decision code never runs here.
fn F3_probe(st:[]u8, nvars:i32, nctrl:i32, ctrl:[]u8)void {
  emit("PROBE_START\n");
  let kind:i32=0;
  while(kind<4){
    let v:i32=0;
    while(v<nvars){
      let a:i32=kind*8+v;
      // 3 repetitions; require identical classification
      let rep:i32=0;
      let okrep:i32=1;
      let rty:i32=-1; let rvv:i32=-1; let rval:i32=-1;
      while(rep<3){
        let ws:[]u8=z_alloc(8+nvars*32);
        w_reset(ws);
        // controlled setup: hold manipulables at fixed values
        if(kind==0){
          let i:i32=0;
          while(i<nctrl){
            let cv:i32=ctrl[i] as i32;
            if(cv==v){ w_act(ws,1,cv); } else { w_act(ws,0,cv); }
            i=i+1;
          }
        } else if(kind==1){
          // CLR v: set ALL vars to 1 first (not just ctrl), so the 1->0
          // transition is observable even for non-manipulable v.
          let i:i32=0;
          while(i<nvars){ w_act(ws,0,i); i=i+1; }
        } else if(kind==3){
          w_act(ws,0,v);
        }
        let pre:[]u8=z_alloc(nvars);
        w_snapshot(ws,pre);
        let r:i32=w_act(ws,kind,v);
        let post:[]u8=z_alloc(nvars);
        w_snapshot(ws,post);
        // classify this repetition
        let nch:i32=0; let chv:i32=-1; let chp:i32=0;
        let i:i32=0;
        while(i<nvars){
          if(pre[i]!=post[i]){ nch=nch+1; chv=i; chp=post[i] as i32; }
          i=i+1;
        }
        let ty:i32=0; let vv:i32=0; let val:i32=0;
        if(nch==1){ ty=1; vv=chv; val=chp; }
        else if(nch==0 && r!=-1){
          // return value matches some var's pre-state?
          i=0;
          while(i<nvars){
            if((pre[i] as i32)==r){ ty=3; vv=i; }
            i=i+1;
          }
        } else if(nch==0 && r==-1){ ty=2; }
        if(rep==0){ rty=ty; rvv=vv; rval=val; }
        else if(ty!=rty || vv!=rvv || val!=rval){ okrep=0; }
        rep=rep+1;
      }
      if(okrep==0){ rty=0; rvv=0; rval=0; }
      EF_set(st,a,rty,rvv,rval);
      emit("PROBE kind="); e64(kind); emit(" v="); e64(v);
      emit(" -> ty="); e64(rty); emit(" var="); e64(rvv);
      emit(" val="); e64(rval); emit("\n");
      v=v+1;
    }
    kind=kind+1;
  }
  emit("PROBE_DONE\n");
  return;
}

// ============ OP-PROP (design section 4, phase-1 version) ============
// candbuf: nvars*36*7 bytes. Candidate: [nlit, s0,p0,d0, s1,p1,d1].
// Phase 1: singleton base literals, both polarities, optional context guard.
fn F3_prop(trace:[]u8, nvars:i32, ctxvar:i32, st:[]u8,
           candbuf:[]u8, candn:[]u8)void {
  let dcur:i32=get32(st,ST_DCUR());
  emit("PROP_START dcur="); e64(dcur); emit("\n");
  let V:i32=0;
  while(V<nvars){
    let n:i32=0;
    let c:i32=0;
    while(c<nvars){
      if(c!=V){
        let pol:i32=0;
        while(pol<2){
          let d:i32=1;
          while(d<=dcur){
            let ok:i32=0; let ref:i32=0;
            let t:i32=0;
            while(t<=11-d){
              let h:i32=0;
              if(pol==1){ if(trace[c*12+t]==1){ h=1; } }
              else { if(trace[c*12+t]==0){ h=1; } }
              if(h==1){
                if(trace[V*12+t+d]==1){ ok=ok+1; } else { ref=1; }
              }
              t=t+1;
            }
            if(ok>0 && ref==0 && n<36){
              let b:i32=(V*36+n)*7;
              candbuf[b]=1;
              candbuf[b+1]=c as u8; candbuf[b+2]=pol as u8; candbuf[b+3]=d as u8;
              candbuf[b+4]=0; candbuf[b+5]=0; candbuf[b+6]=0;
              emit("PROP V="); emit(w_vname(V)); emit(" lit=");
              F3_emit_lit(c,pol,d); emit(" ok="); e64(ok); emit("\n");
              n=n+1;
              // context guards (retained from F2)
              if(ctxvar>=0 && ctxvar!=V){
                let gp:i32=0;
                while(gp<2){
                  let trivial:i32=0;
                  if(ctxvar==c && gp==pol){ trivial=1; }
                  let gok:i32=0; let gref:i32=0;
                  t=0;
                  while(t<=11-d){
                    let bh:i32=0;
                    if(pol==1){ if(trace[c*12+t]==1){ bh=1; } }
                    else { if(trace[c*12+t]==0){ bh=1; } }
                    let gh:i32=0;
                    if(gp==1){ if(trace[ctxvar*12+t]==1){ gh=1; } }
                    else { if(trace[ctxvar*12+t]==0){ gh=1; } }
                    if(bh==1 && gh==1){
                      if(trace[V*12+t+d]==1){ gok=gok+1; } else { gref=1; }
                    }
                    t=t+1;
                  }
                  if(gok>0 && gref==0 && trivial==0 && n<36){
                    let b2:i32=(V*36+n)*7;
                    candbuf[b2]=2;
                    candbuf[b2+1]=c as u8; candbuf[b2+2]=pol as u8; candbuf[b2+3]=d as u8;
                    candbuf[b2+4]=ctxvar as u8; candbuf[b2+5]=gp as u8; candbuf[b2+6]=d as u8;
                    emit("PROP V="); emit(w_vname(V)); emit(" lit=");
                    F3_emit_lit(c,pol,d); emit(" + guard ");
                    F3_emit_lit(ctxvar,gp,d); emit(" ok="); e64(gok); emit("\n");
                    n=n+1;
                  }
                  gp=gp+1;
                }
              }
            }
            d=d+1;
          }
          pol=pol+1;
        }
      }
      c=c+1;
    }
    candn[V]=n as u8;
    V=V+1;
  }
  emit("PROP_DONE\n");
  return;
}

// ============ DNF simulation ============
fn R_rule_fires(rule:[]u8, hist:[]u8, t:i32) i32 {
  let nlit:i32=rule[0] as i32;
  let i:i32=0;
  while(i<nlit){
    let s:i32=rule[1+i*3] as i32;
    let p:i32=rule[1+i*3+1] as i32;
    let d:i32=rule[1+i*3+2] as i32;
    let tt:i32=t-d;
    let hv:i32=0;
    if(tt>=0){ hv=hist[s*32+tt] as i32; }
    if(p==1){ if(hv!=1){ return 0; } }
    else { if(hv!=0){ return 0; } }
    i=i+1;
  }
  return 1;
}
// hrules: ne*41 bytes (per var: [nrules, 4 x 10-byte rules]).
fn L_advance_dnf(hist:[]u8, t:i32, hrules:[]u8, evars:[]u8, ne:i32, nvars:i32)void {
  let v:i32=0;
  while(v<nvars){
    let nv:i32=0;
    let j:i32=0;
    while(j<ne){
      if((evars[j] as i32)==v){
        let base:i32=j*41;
        let nr:i32=hrules[base] as i32;
        let r:i32=0;
        while(r<nr){
          if(R_rule_fires(hrules[base+1+r*10..base+1+r*10+10],hist,t)==1){ nv=1; }
          r=r+1;
        }
      }
      j=j+1;
    }
    hist[v*32+t]=nv as u8;
    v=v+1;
  }
  return;
}
// Simulation reads effects[] for action semantics (design section 6):
// the only legal reader of action meaning is the table.
fn L_sim_dnf(st:[]u8, hrules:[]u8, evars:[]u8, ne:i32, nvars:i32,
             sk:[]u8, sv:[]u8, len:i32, init:[]u8,
             out_obs:[]u8, out_final:[]u8, hist:[]u8)i32 {
  let v:i32=0;
  while(v<nvars*32){ hist[v]=0; v=v+1; }
  v=0;
  while(v<nvars){ hist[v*32]=init[v]; v=v+1; }
  let t:i32=0;
  let nobs:i32=0;
  let i:i32=0;
  while(i<len){
    let kk:i32=sk[i] as i32;
    let vv:i32=sv[i] as i32;
    let ty:i32=EF_type(st,kk*8+vv);
    if(ty==1){ hist[vv*32+t]=EF_val(st,kk*8+vv) as u8; }
    else if(ty==2){
      t=t+1;
      if(t>=32){ return -1; }
      L_advance_dnf(hist,t,hrules,evars,ne,nvars);
    }
    else if(ty==3){
      if(nobs>=16){ return -2; }
      out_obs[nobs]=hist[vv*32+t];
      nobs=nobs+1;
    }
    else { return -3; }
    i=i+1;
  }
  v=0;
  while(v<nvars){ out_final[v]=hist[v*32+t]; v=v+1; }
  return nobs;
}

// ============ alphabet from effects[] ============
// Fills manip (kind/var lists), wait kind, obs (kind/var lists). No kind literals.
fn F3_alphabet(st:[]u8, nvars:i32, nctrl:i32, ctrl:[]u8,
              mk:[]u8, mv:[]u8, wk:[]u8, ok:[]u8, ov:[]u8)i32 {
  // returns nman; wk[0]=wait kind (or 255); ok/ov get obs kinds/vars,
  // count in ov[8]
  let nman:i32=0;
  let wkk:i32=255;
  let nobs:i32=0;
  let a:i32=0;
  while(a<32){
    let ty:i32=EF_type(st,a);
    let k:i32=a/8; let vv:i32=a%8;
    if(vv<nvars){
      if(ty==1){
        // restrict manipulations to controllable vars (F2 alphabet)
        let ci:i32=0; let isc:i32=0;
        while(ci<nctrl){ if((ctrl[ci] as i32)==vv){ isc=1; } ci=ci+1; }
        if(isc==1){ mk[nman]=k as u8; mv[nman]=vv as u8; nman=nman+1; }
      } else if(ty==2){ wkk=k; }
      else if(ty==3){ ok[nobs]=k as u8; ov[nobs]=vv as u8; nobs=nobs+1; }
    }
    a=a+1;
  }
  wk[0]=wkk as u8;
  ov[8]=nobs as u8;
  return nman;
}

// ============ disagreement search (F2-analogous, DNF sim) ============
fn L_find_dnf(st:[]u8, hrules:[]u8, alive:[]u8, nhyp:i32,
              evars:[]u8, ne:i32, nvars:i32, nctrl:i32, ctrl:[]u8,
              out_sk:[]u8, out_sv:[]u8, out_preds:[]u8, out_predn:[]u8)i32 {
  let mk:[]u8=z_alloc(16); let mv:[]u8=z_alloc(16);
  let wk:[]u8=z_alloc(1); let ok:[]u8=z_alloc(8); let ov:[]u8=z_alloc(9);
  let nman:i32=F3_alphabet(st,nvars,nctrl,ctrl,mk,mv,wk,ok,ov);
  let waitk:i32=wk[0] as i32;
  let nobs:i32=ov[8] as i32;
  let B:i32=nman+1+nobs;
  let init:[]u8=z_alloc(nvars);
  let ob:[]u8=z_alloc(16);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let ref:[]u8=z_alloc(16);
  let d:i32=1;
  while(d<=6){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*B; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*B; k=k+1; }
      let rem:i32=si;
      let hasobs:i32=0;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/B; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nman){ kk=mk[dig] as i32; vv=mv[dig] as i32; }
        else if(dig==nman){ kk=waitk; vv=0; }
        else { kk=ok[dig-nman-1] as i32; vv=ov[dig-nman-1] as i32; hasobs=1; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        i=i+1;
      }
      if(hasobs==1){
        let refn:i32=-1;
        let disagree:i32=0;
        let bad:i32=0;
        let h:i32=0;
        while(h<nhyp){
          if(alive[h]==1){
            let nn:i32=L_sim_dnf(st,hrules[h*ne*41..h*ne*41+ne*41],evars,ne,nvars,
                                 out_sk,out_sv,d,init,ob,fin,hist);
            if(nn<0){ bad=1; }
            else {
              out_predn[h]=nn as u8;
              let j:i32=0;
              while(j<nn){ out_preds[h*16+j]=ob[j]; j=j+1; }
              if(refn<0){ refn=nn; j=0; while(j<nn){ ref[j]=ob[j]; j=j+1; } }
              else if(nn!=refn){ disagree=1; }
              else {
                j=0;
                while(j<nn){ if(ob[j]!=ref[j]){ disagree=1; } j=j+1; }
              }
            }
          }
          h=h+1;
        }
        if(bad==0 && disagree==1){ return d; }
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// ============ planners (F2-analogous, effects[] alphabet) ============
fn L_plan_dnf(st:[]u8, hrules:[]u8, h0:i32, evars:[]u8, ne:i32,
              nvars:i32, nctrl:i32, ctrl:[]u8, init:[]u8, maxd:i32,
              out_sk:[]u8, out_sv:[]u8)i32 {
  let mk:[]u8=z_alloc(16); let mv:[]u8=z_alloc(16);
  let wk:[]u8=z_alloc(1); let ok:[]u8=z_alloc(8); let ov:[]u8=z_alloc(9);
  let nman:i32=F3_alphabet(st,nvars,nctrl,ctrl,mk,mv,wk,ok,ov);
  let waitk:i32=wk[0] as i32;
  let P:i32=nman+1;
  let ob:[]u8=z_alloc(16);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let d:i32=1;
  while(d<=maxd){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*P; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*P; k=k+1; }
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/P; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nman){ kk=mk[dig] as i32; vv=mv[dig] as i32; }
        else { kk=waitk; vv=0; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        i=i+1;
      }
      let nn:i32=L_sim_dnf(st,hrules[h0*ne*41..h0*ne*41+ne*41],evars,ne,nvars,
                           out_sk,out_sv,d,init,ob,fin,hist);
      if(nn>=0 && w_goal_met(fin)==1){ return d; }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

fn L_plan_b2_dnf(st:[]u8, hrules:[]u8, h0:i32, evars:[]u8, ne:i32,
                 nvars:i32, nctrl:i32, ctrl:[]u8, init:[]u8, maxd:i32,
                 yvar:i32, kvar:i32, out_sk:[]u8, out_sv:[]u8)i32 {
  let mk:[]u8=z_alloc(16); let mv:[]u8=z_alloc(16);
  let wk:[]u8=z_alloc(1); let ok:[]u8=z_alloc(8); let ov:[]u8=z_alloc(9);
  let nman:i32=F3_alphabet(st,nvars,nctrl,ctrl,mk,mv,wk,ok,ov);
  let waitk:i32=wk[0] as i32;
  // resolve OBSERVE kinds for yvar/kvar from effects[]
  let obsk:i32=-1; let obkk:i32=-1;
  let a:i32=0;
  while(a<32){
    if(EF_type(st,a)==3){
      if(EF_var(st,a)==yvar){ obsk=a/8; }
      if(EF_var(st,a)==kvar){ obkk=a/8; }
    }
    a=a+1;
  }
  if(obsk<0 || obkk<0 || waitk<0){ return 0; }
  let P:i32=nman+1;
  let suf_sk:[]u8=z_alloc(9);
  let suf_sv:[]u8=z_alloc(9);
  let j:i32=0;
  while(j<3){
    suf_sk[j*3]=obsk as u8; suf_sv[j*3]=yvar as u8;
    suf_sk[j*3+1]=obkk as u8; suf_sv[j*3+1]=kvar as u8;
    suf_sk[j*3+2]=waitk as u8; suf_sv[j*3+2]=0;
    j=j+1;
  }
  let full_sk:[]u8=z_alloc(20);
  let full_sv:[]u8=z_alloc(20);
  let ob:[]u8=z_alloc(32);
  let fin:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let d:i32=1;
  while(d<=maxd){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*P; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*P; k=k+1; }
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/P; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nman){ kk=mk[dig] as i32; vv=mv[dig] as i32; }
        else { kk=waitk; vv=0; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        full_sk[i]=kk as u8; full_sv[i]=vv as u8;
        i=i+1;
      }
      j=0;
      while(j<9){ full_sk[d+j]=suf_sk[j]; full_sv[d+j]=suf_sv[j]; j=j+1; }
      let flen:i32=d+9;
      let nn:i32=L_sim_dnf(st,hrules[h0*ne*41..h0*ne*41+ne*41],evars,ne,nvars,
                           full_sk,full_sv,flen,init,ob,fin,hist);
      if(nn==6 && ob[0]==1 && ob[1]==0 && ob[2]==1 && ob[3]==0 && ob[4]==1 && ob[5]==0){
        return d;
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

fn L_triple_met(oy0:i32, ok0:i32, oy1:i32, ok1:i32, oy2:i32, ok2:i32)i32 {
  if(oy0==1 && ok0==0 && oy1==1 && ok1==0 && oy2==1 && ok2==0){ return 1; }
  return 0;
}

// ============ F3 Phase 2: sim returning final time ============
// Like L_sim_dnf but returns the final time step t and leaves hist
// filled, so callers can test per-rule firing at the observation time.
fn F3_sim_final(st:[]u8, hrules:[]u8, evars:[]u8, ne:i32, nvars:i32,
                sk:[]u8, sv:[]u8, len:i32, init:[]u8, hist:[]u8)i32 {
  let v:i32=0;
  while(v<nvars*32){ hist[v]=0; v=v+1; }
  v=0;
  while(v<nvars){ hist[v*32]=init[v]; v=v+1; }
  let t:i32=0;
  let i:i32=0;
  while(i<len){
    let kk:i32=sk[i] as i32;
    let vv:i32=sv[i] as i32;
    let ty:i32=EF_type(st,kk*8+vv);
    if(ty==1){ hist[vv*32+t]=EF_val(st,kk*8+vv) as u8; }
    else if(ty==2){
      t=t+1;
      if(t>=32){ return -1; }
      L_advance_dnf(hist,t,hrules,evars,ne,nvars);
    }
    else if(ty==3){ }
    else { return -1; }
    i=i+1;
  }
  return t;
}

// ============ F3 Phase 2: find a trial where rule r fires ============
// Searches action sequences of depth 1..6 over the effects[] alphabet.
// The last action must be OBSERVE of var V. Returns the sequence length,
// or 0 if no firing sequence exists. Simulation only; the world is
// never touched (callers check w_ncalls around this).
fn F3_find_trial(st:[]u8, hrules:[]u8, evars:[]u8, ne:i32, nvars:i32,
                 nctrl:i32, ctrl:[]u8, V:i32, ridx:i32,
                 out_sk:[]u8, out_sv:[]u8)i32 {
  let mk:[]u8=z_alloc(16); let mv:[]u8=z_alloc(16);
  let wk:[]u8=z_alloc(1); let ok:[]u8=z_alloc(8); let ov:[]u8=z_alloc(9);
  let nman:i32=F3_alphabet(st,nvars,nctrl,ctrl,mk,mv,wk,ok,ov);
  let waitk:i32=wk[0] as i32;
  let nobs:i32=ov[8] as i32;
  let obskV:i32=-1;
  let q:i32=0;
  while(q<nobs){ if((ov[q] as i32)==V){ obskV=ok[q] as i32; } q=q+1; }
  if(obskV<0 || waitk<0){ return 0; }
  let B:i32=nman+1+nobs;
  let init:[]u8=z_alloc(nvars);
  let hist:[]u8=z_alloc(nvars*32);
  let d:i32=1;
  while(d<=6){
    let total:i32=1;
    let k:i32=0;
    while(k<d){ total=total*B; k=k+1; }
    let si:i32=0;
    while(si<total){
      let div:i32=1;
      k=0; while(k<d-1){ div=div*B; k=k+1; }
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        let dig:i32=rem/div;
        rem=rem%div;
        if(div>1){ div=div/B; }
        let kk:i32=0; let vv:i32=0;
        if(dig<nman){ kk=mk[dig] as i32; vv=mv[dig] as i32; }
        else if(dig==nman){ kk=waitk; vv=0; }
        else { kk=ok[dig-nman-1] as i32; vv=ov[dig-nman-1] as i32; }
        out_sk[i]=kk as u8; out_sv[i]=vv as u8;
        i=i+1;
      }
      if((out_sk[d-1] as i32)==obskV && (out_sv[d-1] as i32)==V){
        let t:i32=F3_sim_final(st,hrules,evars,ne,nvars,
                               out_sk,out_sv,d,init,hist);
        if(t>=0){
          if(R_rule_fires(hrules[1+ridx*10..1+ridx*10+10],hist,t)==1){
            return d;
          }
        }
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// ============ main learner run ============
// Returns 0 on F3P2 pass (K1+K2 for this world), 1 otherwise.
// (The world's main() verdict line is F2-specific; the F3P2 verdict is
// in the F3P2_RESULT line. Documented in prereg section 6.)
fn L_run()i32 {
  let nvars:i32=w_nvars();
  let nctrl:i32=w_nctrl();
  let ctrl:[]u8=z_alloc(nctrl);
  let i:i32=0;
  while(i<nctrl){ ctrl[i]=w_ctrl(i) as u8; i=i+1; }
  let ctxvar:i32=w_ctxvar();
  emit("F3P2 WORLD "); emit(w_worldname()); emit(" nvars="); e64(nvars);
  emit(" nctrl="); e64(nctrl); emit(" ctxvar="); e64(ctxvar); emit("\n");

  // ---- persistent state ----
  let st:[]u8=z_alloc(ST_SIZE());
  set32(st,ST_DCUR(),4);
  emit("F3P2 STATE size="); e64(ST_SIZE()); emit(" Dcur=4 (fixed, Phase 1)\n");

  // ---- OP-PROBE ----
  F3_probe(st,nvars,nctrl,ctrl);

  // ---- passive phase (harness-side data collection) ----
  let ws:[]u8=z_alloc(8+nvars*32);
  w_reset(ws);
  let mk0:[]u8=z_alloc(16); let mv0:[]u8=z_alloc(16);
  let wk0:[]u8=z_alloc(1); let ok0:[]u8=z_alloc(8); let ov0:[]u8=z_alloc(9);
  F3_alphabet(st,nvars,nctrl,ctrl,mk0,mv0,wk0,ok0,ov0);
  let waitk:i32=wk0[0] as i32;
  let obsk_run:i32=ok0[0] as i32; // OBSERVE kind from effects[]
  let trace:[]u8=z_alloc(nvars*12);
  let t:i32=0;
  while(t<12){
    w_passive(ws);
    let snap:[]u8=z_alloc(nvars);
    w_snapshot(ws,snap);
    let v:i32=0;
    while(v<nvars){ trace[v*12+t]=snap[v]; v=v+1; }
    if(t<11){ w_act(ws,waitk,0); }
    t=t+1;
  }

  // ---- OP-PROP ----
  let candbuf:[]u8=z_alloc(nvars*36*7);
  let candn:[]u8=z_alloc(nvars);
  F3_prop(trace,nvars,ctxvar,st,candbuf,candn);
  emit("F3P2 CANDIDATES\n");
  let v:i32=0;
  while(v<nvars){
    emit("  "); emit(w_vname(v)); emit(": "); e64(candn[v] as i32); emit("\n");
    v=v+1;
  }


  // ---- rule-set init (Phase 2): ALL OP-PROP candidates become rules ----
  // rs: nvars*41 bytes; per var [nrules, 4 x 10-byte rules].
  let rs:[]u8=z_alloc(nvars*41);
  let evars:[]u8=z_alloc(nvars);
  let ne:i32=0;
  v=0;
  while(v<nvars){
    let cn:i32=candn[v] as i32;
    if(cn>0){
      evars[ne]=v as u8; ne=ne+1;
      let nr:i32=cn;
      if(nr>4){ nr=4; } // disclosed cap (design section 4)
      rs[v*41]=nr as u8;
      let r:i32=0;
      while(r<nr){
        let cb:i32=(v*36+r)*7;
        rs[v*41+1+r*10]=(candbuf[cb] as i32) as u8; // nlit
        let li:i32=0;
        while(li<3){
          rs[v*41+1+r*10+1+li*3]=candbuf[cb+1+li*3];
          rs[v*41+1+r*10+1+li*3+1]=candbuf[cb+1+li*3+1];
          rs[v*41+1+r*10+1+li*3+2]=candbuf[cb+1+li*3+2];
          li=li+1;
        }
        emit("F3P2 RULESET V="); emit(w_vname(v)); emit(" rule="); e64(r);
        emit(" [");
        li=0;
        while(li<(candbuf[cb] as i32)){
          if(li>0){ emit(" & "); }
          F3_emit_lit(candbuf[cb+1+li*3] as i32, candbuf[cb+1+li*3+1] as i32,
                      candbuf[cb+1+li*3+2] as i32);
          li=li+1;
        }
        emit("]\n");
        r=r+1;
      }
    }
    v=v+1;
  }
  emit("F3P2 NE "); e64(ne); emit("\n");
  if(ne<1){ emit("F3P2 RESULT PHASE2-FAIL no-effect-vars\n"); return 1; }

  // ---- resolve X, Z, Y by name (generic; T-DISJ names) ----
  let xv:i32=-1; let zv:i32=-1; let yv:i32=-1;
  v=0;
  while(v<nvars){
    if(vname_eq(v,"X")==1){ xv=v; }
    if(vname_eq(v,"Z")==1){ zv=v; }
    if(vname_eq(v,"Y")==1){ yv=v; }
    v=v+1;
  }

  // ---- P-PROP check (frozen): Y has exactly (X,+,1) and (Z,+,2) ----
  let prop_ok:i32=0;
  if(yv>=0 && xv>=0 && zv>=0 && (candn[yv] as i32)==2){
    let b0:i32=(yv*36+0)*7; let b1:i32=(yv*36+1)*7;
    if((candbuf[b0] as i32)==1 && (candbuf[b0+1] as i32)==xv &&
       (candbuf[b0+2] as i32)==1 && (candbuf[b0+3] as i32)==1 &&
       (candbuf[b1] as i32)==1 && (candbuf[b1+1] as i32)==zv &&
       (candbuf[b1+2] as i32)==1 && (candbuf[b1+3] as i32)==2){
      prop_ok=1;
    }
  }
  emit("F3P2 PROP_OK "); e64(prop_ok); emit("\n");

  // ---- per-rule validation loop (design section 2 refutation) ----
  // Each rule gets a trial where it fires; a false positive (obs=0)
  // refutes EXACTLY that rule. The set survives while any rule stands.
  let tsk:[]u8=z_alloc(8);
  let tsv:[]u8=z_alloc(8);
  let onevar:[]u8=z_alloc(1);
  let tested:[]u8=z_alloc(nvars*4);
  let nexps:i32=0;
  let nrefuted:i32=0;
  let true_refuted:i32=0; // set only if a TRUE rule (Y: X@1 or Z@2) is refuted
  let search_ok:i32=1;
  let round:i32=0;
  while(1==1){
    round=round+1;
    if(round>40){ emit("F3P2 ROUND_CAP\n"); break; }
    let TV:i32=-1; let TR:i32=-1;
    v=0;
    while(v<nvars){
      let nr2:i32=rs[v*41] as i32;
      let r2:i32=0;
      while(r2<nr2){
        if(tested[v*4+r2]==0){ TV=v; TR=r2; }
        r2=r2+1;
      }
      v=v+1;
    }
    if(TV<0){ emit("F3P2 ALL_TESTED\n"); break; }
    onevar[0]=TV as u8;
    let c0:i32=w_ncalls(ws);
    let tlen:i32=F3_find_trial(st,rs[TV*41..TV*41+41],onevar,1,nvars,
                               nctrl,ctrl,TV,TR,tsk,tsv);
    let c1:i32=w_ncalls(ws);
    if(c1!=c0){ search_ok=0; }
    if(tlen==0){
      emit("F3P2 RULE_UNREACHABLE V="); emit(w_vname(TV));
      emit(" rule="); e64(TR); emit("\n");
      tested[TV*4+TR]=1;
    } else {
      emit("F3P2 TRIAL V="); emit(w_vname(TV)); emit(" rule="); e64(TR);
      emit(" seq="); F3_emit_seq(tsk,tsv,tlen); emit("\n");
      w_reset(ws);
      let obs:i32=-1;
      i=0;
      while(i<tlen){
        let kk:i32=tsk[i] as i32; let vv:i32=tsv[i] as i32;
        let o:i32=w_act(ws,kk,vv);
        if(EF_type(st,kk*8+vv)==1){ st[ST_VARIED()+vv]=1; }
        if(i==tlen-1){ obs=o; }
        i=i+1;
      }
      nexps=nexps+1;
      tested[TV*4+TR]=1;
      if(obs==0){
        emit("F3P2 RULE_REFUTED V="); emit(w_vname(TV)); emit(" rule=");
        e64(TR); emit(" obs=0\n");
        nrefuted=nrefuted+1;
        // F-DISJ (frozen): was the refuted rule a TRUE rule?
        let rb:i32=TV*41+1+TR*10;
        if(TV==yv && (rs[rb] as i32)==1){
          if((rs[rb+1] as i32)==xv && (rs[rb+2] as i32)==1 && (rs[rb+3] as i32)==1){
            true_refuted=1;
          }
          if((rs[rb+1] as i32)==zv && (rs[rb+2] as i32)==1 && (rs[rb+3] as i32)==2){
            true_refuted=1;
          }
        }
        let nr3:i32=rs[TV*41] as i32;
        let r3:i32=TR;
        while(r3<nr3-1){
          let q:i32=0;
          while(q<10){ rs[TV*41+1+r3*10+q]=rs[TV*41+1+(r3+1)*10+q]; q=q+1; }
          r3=r3+1;
        }
        rs[TV*41]=(nr3-1) as u8;
        // indices shifted: re-test all rules of every var
        let z2:i32=0;
        while(z2<nvars*4){ tested[z2]=0; z2=z2+1; }
      } else {
        emit("F3P2 RULE_CONFIRMED V="); emit(w_vname(TV)); emit(" rule=");
        e64(TR); emit(" obs=1\n");
      }
    }
  }
  emit("F3P2 SEARCH_CALLS_OK "); e64(search_ok); emit("\n");
  emit("F3P2 TRIALS "); e64(nexps); emit(" REFUTED "); e64(nrefuted); emit("\n");

  // ---- REFUTE-DRILL (disclosed mechanism self-test, scratch copy) ----
  // Poisoned set {(X,+,1),(Z,+,2),(X,+,2)} through the same trial
  // machinery. Expect: (X,+,2) refuted and removed, true rules intact.
  emit("F3P2 DRILL_START\n");
  let scratch:[]u8=z_alloc(41);
  scratch[0]=3;
  scratch[1]=1; scratch[2]=xv as u8; scratch[3]=1; scratch[4]=1;
  scratch[5]=0; scratch[6]=0; scratch[7]=0; scratch[8]=0; scratch[9]=0; scratch[10]=0;
  scratch[11]=1; scratch[12]=zv as u8; scratch[13]=1; scratch[14]=2;
  scratch[15]=0; scratch[16]=0; scratch[17]=0; scratch[18]=0; scratch[19]=0; scratch[20]=0;
  scratch[21]=1; scratch[22]=xv as u8; scratch[23]=1; scratch[24]=2;
  scratch[25]=0; scratch[26]=0; scratch[27]=0; scratch[28]=0; scratch[29]=0; scratch[30]=0;
  onevar[0]=yv as u8;
  let dlen:i32=F3_find_trial(st,scratch,onevar,1,nvars,nctrl,ctrl,yv,2,tsk,tsv);
  let drill_ok:i32=0;
  if(dlen>0){
    emit("F3P2 DRILL_TRIAL seq="); F3_emit_seq(tsk,tsv,dlen); emit("\n");
    w_reset(ws);
    let dobs:i32=-1;
    i=0;
    while(i<dlen){
      let o:i32=w_act(ws,tsk[i] as i32,tsv[i] as i32);
      if(i==dlen-1){ dobs=o; }
      i=i+1;
    }
    nexps=nexps+1;
    if(dobs==0){
      emit("F3P2 DRILL_REFUTED poison obs=0\n");
      scratch[0]=2; // remove rule 2; rules 0,1 untouched
      if((scratch[1] as i32)==1 && (scratch[2] as i32)==xv &&
         (scratch[3] as i32)==1 && (scratch[4] as i32)==1 &&
         (scratch[11] as i32)==1 && (scratch[12] as i32)==zv &&
         (scratch[13] as i32)==1 && (scratch[14] as i32)==2){
        drill_ok=1;
      }
    } else {
      emit("F3P2 DRILL_NOREFUTE obs=1\n");
    }
  } else {
    emit("F3P2 DRILL_NOTRIAL\n");
  }
  if(drill_ok==1){ emit("F3P2 DRILL_RESULT DRILL-PASS\n"); }
  else { emit("F3P2 DRILL_RESULT DRILL-FAIL\n"); }

  // ---- convergence: both true rules present (T-DISJ bar) ----
  let nrY:i32=rs[yv*41] as i32;
  let hasX1:i32=0; let hasZ2:i32=0;
  let r:i32=0;
  while(r<nrY){
    let b:i32=yv*41+1+r*10;
    if((rs[b] as i32)==1 && (rs[b+1] as i32)==xv &&
       (rs[b+2] as i32)==1 && (rs[b+3] as i32)==1){ hasX1=1; }
    if((rs[b] as i32)==1 && (rs[b+1] as i32)==zv &&
       (rs[b+2] as i32)==1 && (rs[b+3] as i32)==2){ hasZ2=1; }
    r=r+1;
  }
  emit("F3P2 CONVERGED nrules_Y="); e64(nrY); emit(" hasX1="); e64(hasX1);
  emit(" hasZ2="); e64(hasZ2); emit("\n");

  // ---- goal phase (mode 0): plan under the rule set, execute for real ----
  let hyp1:[]u8=z_alloc(ne*41);
  let j:i32=0;
  while(j<ne){
    let vv2:i32=evars[j] as i32;
    let q2:i32=0;
    while(q2<41){ hyp1[j*41+q2]=rs[vv2*41+q2]; q2=q2+1; }
    j=j+1;
  }
  w_reset(ws);
  w_goal_setup(ws);
  let init:[]u8=z_alloc(nvars);
  w_snapshot(ws,init);
  let goal_ok:i32=0;
  if(w_goal_mode()==0){
    let psk:[]u8=z_alloc(10);
    let psv:[]u8=z_alloc(10);
    let plen:i32=L_plan_dnf(st,hyp1,0,evars,ne,nvars,nctrl,ctrl,init,8,psk,psv);
    if(plen==0){ emit("F3P2 PLAN none found\n"); }
    else {
      emit("F3P2 PLAN "); F3_emit_seq(psk,psv,plen); emit("\n");
      let obsk0:i32=-1;
      let qa:i32=0;
      while(qa<32){ if(EF_type(st,qa)==3){ obsk0=qa/8; } qa=qa+1; }
      w_reset(ws);
      w_goal_setup(ws);
      i=0;
      while(i<plen){ w_act(ws,psk[i] as i32,psv[i] as i32); i=i+1; }
      let gvals:[]u8=z_alloc(nvars);
      v=0;
      while(v<nvars){ gvals[v]=w_act(ws,obsk0,v) as u8; v=v+1; }
      let met:i32=w_goal_met(gvals);
      emit("F3P2 GOAL_REAL "); e64(met); emit("\n");
      if(met==1){ goal_ok=1; }
    }
  } else {
    emit("F3P2 RESULT PHASE2-FAIL unexpected-goal-mode\n");
    return 1;
  }

  // ---- verdict ----
  let cost_ok:i32=0;
  if(nexps<=6){ cost_ok=1; }
  emit("F3P2 NEXPS "); e64(nexps); emit(" COST_OK "); e64(cost_ok);
  emit(" GOAL_OK "); e64(goal_ok); emit(" DRILL_OK "); e64(drill_ok);
  emit(" PROP_OK "); e64(prop_ok); emit(" SEARCH_OK "); e64(search_ok);
  emit(" TRUE_REFUTED "); e64(true_refuted); emit("\n");
  if(prop_ok==1 && hasX1==1 && hasZ2==1 && true_refuted==0 &&
     drill_ok==1 && goal_ok==1 && cost_ok==1 && search_ok==1){
    emit("F3P2 RESULT PHASE2-TESTED K1=PASS K2=PASS K3=PENDING-3x\n");
    return 0;
  }
  emit("F3P2 RESULT PHASE2-FAIL\n");
  return 1;
}

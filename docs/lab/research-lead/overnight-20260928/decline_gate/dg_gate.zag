// dg_gate.zag -- decline gate cognition patch (unfrozen pilot, NOT frozen TNN-2).
// Replaces ev_query (base lines 813-835) in the variant. Everything else in
// the base is byte-identical to frozen (SHA-256 a29972ca...).
//
// Minimal miss-level decline. After DG_N consecutive failed pursuits of the
// same (s,r), further queries return WITHHOLD (-3) instead of re-attempting
// trial/bootstrap and reifying another UNCERTAINTY node + guide.
//
// Counter: live UNCERTAINTY (tag 30) nodes keyed (s,r). Each failed miss
// reifies exactly one via miss_inquire, so the live count is the
// consecutive-failure tally. No new node types, fields, modes, bridges,
// handlers, or semantic cases. No new storage: the gate reads learner state
// the architecture already reifies.
//
// Reset is implicit: any success path (activate hit, trial success,
// bootstrap success) returns before the gate is consulted, and a later
// taught fact makes activate hit first, bypassing the gate entirely.
// Decline is sticky until UNCERTAINTY nodes are evicted (forgetting
// re-opens inquiry); there is no explicit re-engagement path in this pilot.
//
// Researcher-set: threshold N=3, fixed. Sensitivity not run in this pilot.
// Known limitation: the gate is checked before trial, so a trial that would
// have succeeded on attempt N+1 is declined (false-decline risk). In the
// DYN-1 battery this cannot fire: r=99 trials never succeed (all -2).
fn dg_n()i32 { return 3; }
fn dg_withhold()i32 { return -3; }
fn dg_uncert_count(W:[]u8,s:i32,r:i32)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==30 && ng(W,n,20)==s && ng(W,n,24)==r){c=c+1;}
    n=n+1;
  }
  return c;
}
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  // ---- decline gate: N consecutive failures -> WITHHOLD, no trial, no inquiry
  if(dg_uncert_count(W,s,r)>=dg_n()){
    log_ev(W,2,s,r,dg_withhold(),0,0,0); return dg_withhold();
  }
  let recent:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && m>=2 && ng(W,m,0)==1){recent=m;}
    m=m+1;
  }
  if(recent>=0){link_edge(W,recent,8,recent,0);}
  // trial loop first (learner-set miss policy)
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){log_ev(W,2,s,r,ans,1,0,0); return ans;}
  // fallback: P-INV bootstrap
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){log_ev(W,2,s,r,bv,1,0,0); return bv;}
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

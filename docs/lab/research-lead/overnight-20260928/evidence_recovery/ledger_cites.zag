// ledger_cites.zag -- EVIDENCE-RECOVERY lane.
// Pure-Zag extractor for canonical_ledger/CLAIM_LEDGER.md.
//
// Emits, per claim block, two kinds of citation:
//   (H) every maximal hex run of length >= 8  (git object-id prefixes:
//       commit shas AND file sha256 prefixes -- the ledger uses both)
//   (P) every cited lane path token (a run starting with '/' that contains
//       a '/', bounded by a non [A-Za-z0-9._/-] delimiter)
//
// Claim blocks are detected in TWO shapes, because the ledger uses both:
//   shape 1: line-start "## C<digits>."
//   shape 2: line-start "- C<digits> " followed by '('
//
// Output is TSV, one line per claim:
//   <id>  <TAB> H:<hex>:<len>  H:<hex>:<len> ...  <TAB>  P:<path> ...
//
// READ-ONLY with respect to the ledger. Writes only into this lane dir.
// git object-existence resolution is done shell-side (git plumbing is
// orchestration, not computation).
//
// PROVENANCE: written fresh for the EVIDENCE-RECOVERY audit; supersedes the
// earlier parse_ledger.zag in this lane, which matched only 2 claim shapes and
// mis-parsed ids. No ledger byte is written by this program.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}

fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}

fn hexv(c:i32)i32 {
  if(c>=48 && c<=57){ return c-48; }
  if(c>=97 && c<=102){ return c-87; }
  if(c>=65 && c<=70){ return c-55; }
  return -1;
}
fn ishex(c:i32)i32 { let v:i32=hexv(c); if(v>=0){ return 1; } return 0; }

// path-token char: [A-Za-z0-9._/-]
fn ispc(c:i32)i32 {
  if(c==47 || c==45 || c==46 || c==95){ return 1; }
  if(c>=48 && c<=57){ return 1; }
  if(c>=65 && c<=90){ return 1; }
  if(c>=97 && c<=122){ return 1; }
  return 0;
}

// digit count starting at i, capped
fn ndigit(b:[]u8,i:i32,n:i32)i32 {
  let d:i32=0;
  while(i+d<n){
    let c:i32=b[i+d];
    let ok:i32=0;
    if(c>=48 && c<=57){ ok=1; }
    if(ok==0){ break; }
    d=d+1;
  }
  return d;
}

// claim id if a claim header starts at line-start i, else 0. writes id to cell.
fn claim_at(b:[]u8,i:i32,n:i32,cell:[]u8)i32 {
  if(i>0){ if(b[i-1]==10){ } else { return 0; } } else { return 0; }
  // shape 1: "## C"
  if(i+6<n){
    if(b[i]==35 && b[i+1]==35 && b[i+2]==32 && b[i+3]==67){
      let j:i32=i+4;
      let d:i32=ndigit(b,j,n);
      if(d>=1 && d<=4 && j+d<n && b[j+d]==46){
        let v:i32=0; let k:i32=0;
        while(k<d){ v=v*10+(b[j+k]-48); k=k+1; }
        set32(cell,0,v);
        return 1;
      }
    }
  }
  // shape 2: "- C<digits> ("
  if(i+4<n){
    if(b[i]==45 && b[i+1]==32 && b[i+2]==67){
      let j:i32=i+3;
      let d:i32=ndigit(b,j,n);
      if(d>=1 && d<=4 && j+d+1<n && b[j+d]==32 && b[j+d+1]==40){
        let v:i32=0; let k:i32=0;
        while(k<d){ v=v*10+(b[j+k]-48); k=k+1; }
        set32(cell,0,v);
        return 2;
      }
    }
  }
  return 0;
}

// lane-token char (stricter than ispc): [A-Za-z0-9_.-] -- excludes '/'
fn islt(c:i32)i32 {
  if(c==45 || c==46 || c==95){ return 1; }
  if(c>=48 && c<=57){ return 1; }
  if(c>=65 && c<=90){ return 1; }
  if(c>=97 && c<=122){ return 1; }
  return 0;
}
fn ispathchar(c:i32)i32 {
  if(islt(c)==1){ return 1; }
  if(c==47){ return 1; }
  return 0;
}
fn eq5(b:[]u8,i:i32,c0:i32,c1:i32,c2:i32,c3:i32,c4:i32)i32 {
  if(b[i]!=c0){ return 0; } if(b[i+1]!=c1){ return 0; } if(b[i+2]!=c2){ return 0; }
  if(b[i+3]!=c3){ return 0; } if(b[i+4]!=c4){ return 0; }
  return 1;
}
fn eq8(b:[]u8,i:i32,s:[]u8)i32 {
  let k:i32=0;
  while(k<8){ if(b[i+k]!=s[k]){ return 0; } k=k+1; }
  return 1;
}
fn o_ch(b:[]u8,c:i32,v:i32)i32 { b[c]=v as u8; return c+1; }
fn o_cp(b:[]u8,c:i32,s:[]u8,f:i32,t:i32)i32 {
  let i:i32=0;
  while(i<t){ b[c+i]=s[f+i]; i=i+1; }
  return c+t;
}
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  if(v==0){ b[c]=48; return c+1; }
  let d:i32=1; let t:i32=v;
  while(t>=10){ t=t/10; d=d+1; }
  let e:i32=c+d;
  let p:i32=e-1;
  let y:i32=v;
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  return e;
}
// write hex digits of s[f..f+t] then ':' then decimal length
fn o_hex(b:[]u8,c:i32,s:[]u8,f:i32,t:i32)i32 {
  let i:i32=0;
  while(i<t){ b[c+i]=s[f+i]; i=i+1; }
  let d:i32=t;
  let e:i32=c+t;
  b[e]=58;
  if(d>=10){
    b[e+1]=(48+(d/10)) as u8;
    b[e+2]=(48+(d-(d/10)*10)) as u8;
    return e+3;
  }
  b[e+1]=(48+d) as u8;
  return e+2;
}

// does needle nb[nofs .. nofs+m] occur in hay[hb .. hb+hn)?
// Addressed by offset: no reliance on arbitrary [a..b] slice semantics.
fn occurs(hay:[]u8,hb:i32,hn:i32,nb:[]u8,nofs:i32,m:i32)i32 {
  if(m<4){ return 0; }
  let i:i32=0;
  let lim:i32=hn-m;
  while(i<=lim){
    if(hay[hb+i]==nb[nofs]){
      let k:i32=1;
      let same:i32=1;
      while(k<m){ if(hay[hb+i+k]!=nb[nofs+k]){ same=0; k=m; } else { k=k+1; } }
      if(same==1){ return 1; }
    }
    i=i+1;
  }
  return 0;
}

fn main()i32 {
  let lanepref:[]u8="lane ";
  let docslabpfx:[]u8="docs/lab";
  let lp:[]u8="docs/lab/research-lead/overnight-20260928/canonical_ledger/CLAIM_LEDGER.md";
  let laneidx:[]u8="docs/lab/research-lead/overnight-20260928/evidence_recovery/all_lanes.tsv";
  let LB:i32=1400;
  if(_zag_file_exists(lp)==false){ _zag_println("PARSE_ERR:ledger_absent"); return 1; }
  let b:[]u8=_zag_read_file(lp);
  let n:i32=b.len;
  _zag_println("PARSE_OK");
  _zag_print("LEDGER_BYTES "); _zag_println(_zag_i64_to_str(n as i64));

  let lb0:[]u8=z_alloc(1);
  let lc:i32=0;
  let cap:i32=700;
  let LCIDX:i32=cap;
  let lo=z_alloc((cap+LB)*4);
  let ll=z_alloc((cap+LB)*4);
  let lat=z_alloc(LB);
  let lbuf:[]u8=z_alloc(32768);
  let lbuf_n:i32=0;
  // ---- known lane index: name (tab stripped) + athead flag, offset addressed
  if(_zag_file_exists(laneidx)){
    lb0=_zag_read_file(laneidx);
    let q:i32=0;
    while(q<lb0.len){
      let t:i32=0;
      while(q+t<lb0.len){ if(lb0[q+t]==10){ break; } t=t+1; }
      let nm:i32=t-2;
      if(nm>=4 && nm<200){
        let at:i32=0;
        if(lb0[q+t-1]==49){ at=1; }
        let lo2:i32=lbuf_n;
        let k:i32=0;
        while(k<nm){ lbuf[lo2+k]=lb0[q+k]; k=k+1; }
        set32(lo,(LCIDX+lc)*4,lo2);
        set32(ll,(LCIDX+lc)*4,nm);
        lat[lc]=at as u8;
        lbuf_n=lo2+nm;
        lc=lc+1;
      }
      q=q+t+1;
    }
  }
  _zag_print("KNOWN_LANES_INDEXED "); _zag_println(_zag_i64_to_str(lc as i64));

  // ---- pass 1: locate claim starts
  let cs=z_alloc(cap*4);
  let cid=z_alloc(cap*4);
  let cell=z_alloc(8);
  let nc:i32=0;
  let i:i32=0;
  while(i<n){
    let k:i32=claim_at(b,i,n,cell);
    if(k>0 && nc<cap){
      set32(cs,nc*4,i);
      set32(cid,nc*4,get32(cell,0));
      nc=nc+1;
      i=i+4;
    } else { i=i+1; }
  }
  _zag_print("CLAIM_BLOCKS "); _zag_println(_zag_i64_to_str(nc as i64));

  // ---- pass 2: per-claim citations
  let out=z_alloc(3000000);
  let oc:i32=0;
  let c:i32=0;
  let nhex:i32=0;
  let npath:i32=0;
  let nknown:i32=0;
  while(c<nc){
    let s:i32=get32(cs,c*4);
    let e:i32=n-1;
    if(c+1<nc){ e=get32(cs,(c+1)*4)-1; }
    let id:i32=get32(cid,c*4);
    oc=o_i32(out,oc,id); oc=o_ch(out,oc,9);

    // known-lane mentions, scanned against the CLAIM BLOCK PROSE (not against a
    // token summary). Emitted as "L<name>:<athead>" so the joiner can grade
    // each claim without re-reading the ledger.
    let lj:i32=0;
    let nlane:i32=0;
    while(lj<lc){
      let lofs:i32=get32(lo,(LCIDX+lj)*4);
      let lnam:i32=get32(ll,(LCIDX+lj)*4);
      if(occurs(b,s,e-s,lbuf,lofs,lnam)==1){
        nlane=nlane+1;
        oc=o_ch(out,oc,76);            // 'L'
        oc=o_cp(out,oc,lbuf,lofs,lnam);
        oc=o_ch(out,oc,58);            // ':'
        oc=o_ch(out,oc,48+lat[lj]);
        oc=o_ch(out,oc,9);
      }
      lj=lj+1;
    }
    nknown=nknown+nlane;

    // hex runs
    let p:i32=s;
    while(p<=e){
      let h:i32=ishex(b[p]);
      let pv:i32=0;
      if(p>s){ pv=ishex(b[p-1]); }
      if(h==1 && pv==0){
        let j:i32=p;
        let go:i32=1;
        while(go==1){
          let q:i32=0;
          if(j<=e){ q=ishex(b[j]); }
          if(q==1){ j=j+1; } else { go=0; }
        }
        let rl:i32=j-p;
        // only standalone-looking ids: not part of a longer alnum token
        let nb:i32=0;
        if(j<n){ if(ishex(b[j])==0){ if((b[j]>=65 && b[j]<=90)||(b[j]>=97 && b[j]<=122)){ nb=1; } } }
        if(rl>=8 && nb==0){
          nhex=nhex+1;
          oc=o_ch(out,oc,72);            // 'H'
          oc=o_hex(out,oc,b,p,rl);
          oc=o_ch(out,oc,9);
        }
        p=j;
      } else { p=p+1; }
    }
    oc=o_ch(out,oc,9);

    // lane citations, two grammars only:
    //   (a) "lane <token>/"   -> lane dir under overnight-20260928/
    //   (b) "docs/lab/..."    -> full repo path
    let q1:i32=s;
    while(q1<=e-8){
      let ga:i32=0;
      if(eq5(b,q1,108,97,110,101,32)==1){
        // require a delimiter before "lane" so we do not match "lane" inside a word
        let dl:i32=1;
        if(q1>s){ if(islt(b[q1-1])==1){ dl=0; } }
        if(dl==1){
          let t1:i32=q1+5;
          let t2:i32=t1;
          let g2:i32=1;
          while(g2==1){
            let ok:i32=0;
            if(t2<=e){ ok=islt(b[t2]); }
            if(ok==1){ t2=t2+1; } else { g2=0; }
          }
          if(t2>t1 && t2<=e && b[t2]==47 && t2-t1<=80){
            ga=1;
            npath=npath+1;
            oc=o_cp(out,oc,lanepref,0,5);
            oc=o_cp(out,oc,b,t1,t2-t1);
            oc=o_ch(out,oc,9);
            q1=t2+1;
          }
        }
      }
      if(ga==0 && eq8(b,q1,docslabpfx)==1){
        let t1:i32=q1;
        let t2:i32=t1;
        let g3:i32=1;
        while(g3==1){
          let ok:i32=0;
          if(t2<=e){ ok=ispathchar(b[t2]); }
          if(ok==1){ t2=t2+1; } else { g3=0; }
        }
        let te:i32=t2;
        while(te>t1){ if(b[te-1]==46){ te=te-1; } else { break; } }
        if(te-t1>=12){
          npath=npath+1;
          oc=o_ch(out,oc,80);
          oc=o_cp(out,oc,b,t1,te-t1);
          oc=o_ch(out,oc,9);
          q1=t2+1;
        } else { q1=q1+1; }
      } else { if(ga==0){ q1=q1+1; } }
    }
    oc=o_ch(out,oc,10);
    c=c+1;
  }
  _zag_print("HEXCITES "); _zag_println(_zag_i64_to_str(nhex as i64));
  _zag_print("PATHCITES "); _zag_println(_zag_i64_to_str(npath as i64));
  _zag_print("KNOWNLANE_MENTIONS "); _zag_println(_zag_i64_to_str(nknown as i64));
  _zag_write_file("docs/lab/research-lead/overnight-20260928/evidence_recovery/cites2.tsv",out[0..oc]);
  _zag_print("WROTE cites2.tsv bytes "); _zag_println(_zag_i64_to_str(oc as i64));
  return 0;
}

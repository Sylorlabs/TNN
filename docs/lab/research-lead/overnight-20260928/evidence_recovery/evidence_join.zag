// evidence_join.zag -- EVIDENCE-RECOVERY lane.
// Pure-Zag per-claim evidence join for canonical_ledger/CLAIM_LEDGER.md.
//
// Joins three inputs (produced by git plumbing and by the sibling Zag extractor
// ledger_cites.zag; none of them is scientific computation):
//   cites2.tsv     claim_id <TAB> H:<hex>:<len> ... <TAB> P:<path> ...
//   sha_res.tsv<short-prefix> <TAB> OK|ABSENT
//   all_lanes.tsv  <lane-basename> <TAB> 1|0        (1 = present at HEAD)
//
// Emits evidence_audit.tsv, one row per canonical claim block:
//   id  nshort  nok  nabs  nlanes  nlanes_gone  verdict
//
// VERDICT LADDER (highest severity first):
//   SHA-UNRESOLVABLE  >=1 cited abbreviated commit sha is not in the object DB
//   LANE-GONE         all shas resolve but >=1 named lane is absent at HEAD.
//                      RECOVERABLE: the lane is present at 4e7eb30b1.
//   NO-CITATION       the block names no abbreviated sha and no known lane
//   EVIDENCE-INTACTevery cited short sha resolves and every named lane is at HEAD
//
// READ-ONLY with respect to the ledger. Writes only into this lane directory.

fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,o:i32)i32 {
  return (b[o] as i32)|((b[o+1] as i32)<<8)|((b[o+2] as i32)<<16)|((b[o+3] as i32)<<24);
}
fn set32(b:[]u8,o:i32,v:i32)void {
  b[o]=v as u8; b[o+1]=(v>>8) as u8; b[o+2]=(v>>16) as u8; b[o+3]=(v>>24) as u8;
  return;
}
fn cat(a:[]u8,b:[]u8)[]u8 {
  let r:[]u8=z_alloc(a.len+b.len+1);
  let i:i32=0;
  while(i<a.len){ r[i]=a[i]; i=i+1; }
  let j:i32=0;
  while(j<b.len){ r[a.len+j]=b[j]; j=j+1; }
  r[a.len+b.len]=0;
  return r;
}
// index just past the newline at i (or n)
fn eol(b:[]u8,i:i32,n:i32)i32 {
  let j:i32=i;
  while(j<n){ if(b[j]==10){ return j+1; } j=j+1; }
  return n;
}
// length of the line starting at i, newline excluded
fn llen(b:[]u8,i:i32,n:i32)i32 {
  let j:i32=i;
  while(j<n){ if(b[j]==10){ return j-i; } j=j+1; }
  return n-i;
}
// first index >= i where c occurs in b[0..n); returns n if absent
fn findc(b:[]u8,n:i32,i:i32,c:i32)i32 {
  let j:i32=i;
  while(j<n){ if(b[j]==c){ return j; } j=j+1; }
  return n;
}
// does needle nb[nofs .. nofs+m] occur in hay[0..hn)?
// Needle is addressed by offset, not by slice: slice semantics on an
// arbitrary [a..b] are not relied upon anywhere in this program.
fn occurs(hay:[]u8,hn:i32,nb:[]u8,nofs:i32,m:i32)i32 {
  if(m<4){ return 0; }
  let i:i32=0;
  let lim:i32=hn-m;
  while(i<=lim){
    if(hay[i]==nb[nofs]){
      let k:i32=1;
      let same:i32=1;
      while(k<m){ if(hay[i+k]!=nb[nofs+k]){ same=0; k=m; } else { k=k+1; } }
      if(same==1){ return 1; }
    }
    i=i+1;
  }
  return 0;
}
fn o_ch(b:[]u8,c:i32,v:i32)i32 { b[c]=v as u8; return c+1; }
fn o_cp(b:[]u8,c:i32,s:[]u8,t:i32)i32 {
  let i:i32=0;
  while(i<t){ b[c+i]=s[i]; i=i+1; }
  return c+t;
}
fn o_i32(b:[]u8,c:i32,v:i32)i32 {
  if(v==0){ b[c]=48; return c+1; }
  let d:i32=1; let t:i32=v;
  while(t>=10){ t=t/10; d=d+1; }
  let e:i32=c+d; let p:i32=e-1; let y:i32=v;
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  return e;
}
// look up a short hex prefix in sha_res.tsv; returns 1 OK, 0 ABSENT, -1 not listed
fn sha_lookup(res:[]u8,hexs:[]u32,hexl:i32,cits:[]u8,hs:i32,hl:i32)i32 {
  let p:i32=0;
  while(p<res.len){
    let sl:i32=llen(res,p,res.len);
    if(sl>=hl+3 && res[p+hl]==9){
      let same:i32=1;
      let m:i32=0;
      while(m<hl){
        let cv:i32=res[p+m];
        if(cv!=cits[hs+m]){ same=0; m=hl; } else { m=m+1; }
      }
      if(same==1){
        if(res[p+hl+1]==79 && res[p+hl+2]==75){ return 1; }
        return 0;
      }
    }
    p=eol(res,p,res.len);
  }
  return -1;
}

fn main()i32 {
  let d:[]u8="docs/lab/research-lead/overnight-20260928/evidence_recovery/";
  let cits:[]u8=_zag_read_file(cat(d,"cites2.tsv"));
  let res:[]u8=_zag_read_file(cat(d,"sha_res.tsv"));
  let lanes:[]u8=_zag_read_file(cat(d,"all_lanes.tsv"));

  _zag_println("JOIN_INPUTS_OK");
  _zag_print("CITES_BYTES ");  _zag_println(_zag_i64_to_str(cits.len as i64));
  _zag_print("SHARES_BYTES "); _zag_println(_zag_i64_to_str(res.len as i64));
  _zag_print("LANES_BYTES ");  _zag_println(_zag_i64_to_str(lanes.len as i64));

  // ---- index lanes: offsets/lengths/athead, parallel arrays
  let LC:i32=1200;
  let lo=z_alloc(LC*4);
  let ll=z_alloc(LC*4);
  let la=z_alloc(LC);
  let lc:i32=0;
  let i:i32=0;
  while(i<lanes.len && lc<LC){
    let t:i32=llen(lanes,i,lanes.len);
    if(t>2){
      set32(lo,lc*4,i);
      set32(ll,lc*4,t-2);
      if(lanes[i+t-1]==49){ la[lc]=1; } else { la[lc]=0; }
      lc=lc+1;
    }
    i=eol(lanes,i,lanes.len);
  }
  _zag_print("LANES_INDEXED "); _zag_println(_zag_i64_to_str(lc as i64));

  let out=z_alloc(200000);
  let oc:i32=0;
  let hdr:[]u8="id\tnshort\tnok\tnabs\tnlanes\tnlanes_gone\tverdict\n";
  oc=o_cp(out,oc,hdr,45);

  let p:i32=0;
  let nclaim:i32=0;
  let t_sha:i32=0; let t_abs:i32=0; let t_lane:i32=0; let t_gone:i32=0;
  let v_sha:i32=0; let v_gone:i32=0; let v_nocit:i32=0; let v_int:i32=0;

  while(p<cits.len){
    let lt:i32=llen(cits,p,cits.len);
    let e:i32=p+lt;
    let q:i32=findc(cits,e,p,9);
    let id:i32=0;
    let k:i32=p;
    while(k<q){ if(cits[k]>=48 && cits[k]<=57){ id=id*10+(cits[k]-48); } k=k+1; }

// ---- resolve every H<hex>:<len> field with 8 <= len <= 10
    let ns:i32=0; let nok:i32=0; let nab:i32=0;
    let f:i32=q+1;
    while(f<e){
      let ish:i32=0;
      if(cits[f]==72 && f+1<e){
        let cv:i32=cits[f+1];
        if((cv>=48 && cv<=57)||(cv>=97 && cv<=102)||(cv>=65 && cv<=70)){ ish=1; }
      }
      if(ish==1){
        let hs:i32=f+1;
        let he:i32=findc(cits,e,hs,58);
        let hl:i32=he-hs;
        let le:i32=he+1;
        let lv:i32=0;
        while(le<e && cits[le]>=48 && cits[le]<=57){ lv=lv*10+(cits[le]-48); le=le+1; }
        if(lv>=8 && lv<=10 && hl==lv){
          ns=ns+1;
          let r:i32=sha_lookup(res,cits,hl,cits,hs,hl);
          if(r==1){ nok=nok+1; } else { nab=nab+1; }
        }
        f=le;
      } else { f=f+1; }
    }

    // ---- grade the L<name>:<athead> lane tokens emitted by ledger_cites.zag
    let nlg:i32=0; let ngo:i32=0;
    let g:i32=q+1;
    while(g<e){
      if(cits[g]==76 && g+1<e){
        let ns:i32=g+1;
        let ne:i32=ns;
        while(ne<e && cits[ne]!=58 && cits[ne]!=9){ ne=ne+1; }
        if(ne<e && cits[ne]==58 && cits[ne+1]!=9){
          nlg=nlg+1;
          if(cits[ne+1]==48){ ngo=ngo+1; }
          g=ne+2;
        } else { g=g+1; }
      } else { g=g+1; }
    }

    let v:i32=4;
    if(nab>0){ v=1; }
    if(v==4 && ngo>0){ v=2; }
    if(v==4 && ns==0 && nlg==0){ v=3; }

    oc=o_i32(out,oc,id); oc=o_ch(out,oc,9);
    oc=o_i32(out,oc,ns);  oc=o_ch(out,oc,9);
    oc=o_i32(out,oc,nok);  oc=o_ch(out,oc,9);
    oc=o_i32(out,oc,nab); oc=o_ch(out,oc,9);
    oc=o_i32(out,oc,nlg);  oc=o_ch(out,oc,9);
    oc=o_i32(out,oc,ngo);  oc=o_ch(out,oc,9);
    if(v==1){ oc=o_cp(out,oc,"SHA-UNRESOLVABLE",16); }
    if(v==2){ oc=o_cp(out,oc,"LANE-GONE",9); }
    if(v==3){ oc=o_cp(out,oc,"NO-CITATION",11); }
    if(v==4){ oc=o_cp(out,oc,"EVIDENCE-INTACT",15); }
    oc=o_ch(out,oc,10);

    if(v==1){ v_sha=v_sha+1; }
    if(v==2){ v_gone=v_gone+1; }
    if(v==3){ v_nocit=v_nocit+1; }
    if(v==4){ v_int=v_int+1; }
    t_sha=t_sha+ns; t_abs=t_abs+nab;
    t_lane=t_lane+nlg; t_gone=t_gone+ngo;
    nclaim=nclaim+1;
    p=eol(cits,p,cits.len);
  }

  _zag_write_file(cat(d,"evidence_audit.tsv"),out[0..oc]);
  _zag_print("CLAIMS_JOINED ");        _zag_println(_zag_i64_to_str(nclaim as i64));
  _zag_print("VERDICT_SHA_UNRESOLVABLE "); _zag_println(_zag_i64_to_str(v_sha as i64));
  _zag_print("VERDICT_LANE_GONE ");        _zag_println(_zag_i64_to_str(v_gone as i64));
  _zag_print("VERDICT_NO_CITATION ");      _zag_println(_zag_i64_to_str(v_nocit as i64));
  _zag_print("VERDICT_EVIDENCE_INTACT ");   _zag_println(_zag_i64_to_str(v_int as i64));
  _zag_print("TOTAL_SHORT_SHAS_CITED ");   _zag_println(_zag_i64_to_str(t_sha as i64));
  _zag_print("TOTAL_SHORT_SHAS_ABSENT ");  _zag_println(_zag_i64_to_str(t_abs as i64));
  _zag_print("TOTAL_LANE_MENTIONS ");      _zag_println(_zag_i64_to_str(t_lane as i64));
  _zag_print("TOTAL_LANE_MENTIONS_GONE "); _zag_println(_zag_i64_to_str(t_gone as i64));
  _zag_print("WROTE_BYTES "); _zag_println(_zag_i64_to_str(oc as i64));
  return 0;
}
// rt_driver.zag -- XIO red-team battery (unfrozen, new).
// Six adversarial attacks on the H-XIO-1 typed I/O adapters.
// Pure Zag. Safebin PATH. Reuses the frozen base + xio_core fns verbatim.
// Zero em/en dashes. This driver never touches the paper or the network.

// ---- shared world builders ----
fn rt_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){ ev_teach(W,5000+i,60+(i%10),6000+i); i=i+1; }
  return;
}
fn rt_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,14,0,xon);
  emit("X1="); e64(x1); emit("\n");
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=xio_query(W,15,91,18,0,xon);
  emit("X2="); e64(x2); emit("\n");
  return;
}
fn rt_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let y1:i32=xio_query(W,50,92,3,0,xon);
  emit("Y1="); e64(y1); emit("\n");
  ev_teach(W,60,82,61); ev_teach(W,61,82,62); ev_teach(W,62,82,63); ev_teach(W,63,82,64);
  let y2:i32=xio_query(W,60,92,4,0,xon);
  emit("Y2="); e64(y2); emit("\n");
  return;
}
fn rt_zfacts(W:[]u8,b:i32)void {
  ev_teach(W,b,81,b+1); ev_teach(W,b+1,81,b+2); ev_teach(W,b+2,81,b+3);
  ev_teach(W,b+3,82,b+4); ev_teach(W,b+4,82,b+5);
  return;
}
fn rt_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
// first active MAP with oty == want; -1 if none.
fn rt_find_oty(W:[]u8,want:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && xio_oty(W,m)==want){return m;}
    m=m+1;
  }
  return -1;
}
// active MAP with relation field == r; -1 if none.
fn rt_find_map_r(W:[]u8,r:i32)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){return m;}
    m=m+1;
  }
  return -1;
}
// pair census mirroring xio_try's gate.
fn rt_pair_stats(W:[]u8)void {
  let n0:i32=0; let n1:i32=0; let gated:i32=0; let tried:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let o1:i32=xio_oty(W,m1);
      if(o1==1){n1=n1+1;} else {n0=n0+1;}
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          if(o1!=xio_oty(W,m2)){tried=tried+1;} else {gated=gated+1;}
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  emit("PAIRS n0="); e64(n0); emit(" n1="); e64(n1);
  emit(" gated="); e64(gated); emit(" tried="); e64(tried); emit("\n");
  return;
}
fn rt_acensus(W:[]u8)void {
  emit("adapters="); e64(xio_count(W)); emit("\n");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){
      emit("ADAPT id="); e64(n);
      emit(" m1="); e64(ng(W,n,4)); emit(" m2="); e64(ng(W,n,8));
      emit(" o1="); e64(ng(W,n,12)); emit(" o2="); e64(ng(W,n,16));
      emit(" rel1="); e64(ng(W,n,20)); emit(" rel2="); e64(ng(W,n,24));
      emit(" qr="); e64(ng(W,n,32)); emit(" ans="); e64(ng(W,n,28)); emit("\n");
    }
    n=n+1;
  }
  return;
}
// step-counter chain graph: guard/set per link + INC slot1 per link,
// output = walked node (slot 0). Structural INC, NODE output.
fn rt_asm_stepchain(W:[]u8,v:[]u8,plen:i32,f:[]u8)i32 {
  let root:i32=-1; let prev:i32=-1; let j:i32=0;
  while(j<plen-1){
    let lx:i32=t2_lit(W,get32(v,j*4)); if(lx<0){return -1;}
    let ly:i32=t2_lit(W,get32(v,(j+1)*4)); if(ly<0){return -1;}
    let g:i32=t2_guard(W,0,lx); if(g<0){return -1;}
    let st:i32=t2_set(W,0,ly); if(st<0){return -1;}
    let ic:i32=t2_inc(W,1); if(ic<0){return -1;}
    ns(W,g,12,st); seq_link(W,st,ic);
    link_edge(W,st,1,get32(f,j*4),0);
    if(prev>=0){seq_link(W,prev,g);} else {root=g;}
    prev=ic; j=j+1;
  }
  return root;
}
// chain-stage procedure on an EXPLICIT root (bypasses the oty gate).
fn rt_stage_chain_root(W:[]u8,root:i32,x:i32)i32 {
  let plen:i32=rb_chain_plen(W,root);
  if(plen<2){return -999999;}
  let paths:[]u8=z_alloc(4608);
  if(paths.len<4608){return -999999;}
  let np:i32=t2_gather(W,x,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==plen){
      let vv:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
      if(vv.len>=24 && ff.len>=16){
        let j:i32=0;
        while(j<plen){set32(vv,j*4,get32(paths,base+4+j*4)); j=j+1;}
        j=0;
        while(j<plen-1){set32(ff,j*4,get32(paths,base+24+j*4)); j=j+1;}
        let nr:i32=t2_asm_chain(W,vv,plen,ff);
        if(nr>=0){
          let st:[]u8=z_alloc(8);
          if(st.len>=8){
            set32(st,0,0); set32(st,4,0);
            let r2:i32=t2_try_verify(W,nr,x,-2,1,st);
            if(r2!=-2 && r2!=-999999){return r2;}
          }
        }
      }
    }
    p=p+1;
  }
  return -999999;
}
// count of x over relation rel (the oty-1 stage procedure, explicit).
fn rt_count_from(W:[]u8,rel:i32,x:i32)i32 {
  let vv:[]u8=z_alloc(64); let ff:[]u8=z_alloc(60);
  if(vv.len<64 || ff.len<60){return -999999;}
  let len:i32=t2_chain(W,x,rel,vv,ff);
  if(len<2){return -999999;}
  let root:i32=t2_asm_count(W,vv,len,ff);
  if(root<0){return -999999;}
  let st:[]u8=z_alloc(8);
  if(st.len<8){return -999999;}
  set32(st,0,0); set32(st,4,0);
  let w:i32=t2_try_verify(W,root,x,-2,1,st);
  if(w!=-2 && w!=-999999){return w;}
  return -999999;
}
// enumerate len==plen paths from s and the count of each endpoint.
fn rt_enum_paths(W:[]u8,s:i32,plen:i32,rel:i32)void {
  let paths:[]u8=z_alloc(4608);
  if(paths.len<4608){return;}
  let np:i32=t2_gather(W,s,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==plen){
      let e:i32=get32(paths,base+4+(plen-1)*4);
      let c:i32=rt_count_from(W,rel,e);
      emit(" path-end="); e64(e); emit(" count="); e64(c); emit("\n");
    }
    p=p+1;
  }
  return;
}
// instrumented mirror of xio_try: counts stage_exec calls on a failing run.
fn rt_try_count(W:[]u8,s:i32,r:i32,expected:i32)void {
  let tried:i32=0; let rej:i32=0; let calls:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let o1:i32=xio_oty(W,m1);
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          let o2:i32=xio_oty(W,m2);
          if(o1!=o2){
            tried=tried+1;
            calls=calls+1;
            let v1:i32=xio_stage_exec(W,m1,s);
            if(v1!=-999999 && v1!=-2){
              calls=calls+1;
              let v2:i32=xio_stage_exec(W,m2,v1);
              if(v2!=-999999 && v2!=-2 && v2==expected){rej=rej+1;}
              else {rej=rej+1;}
            } else {rej=rej+1;}
          }
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  emit("SCAN tried="); e64(tried); emit(" rejected="); e64(rej);
  emit(" stage-calls="); e64(calls); emit("\n");
  return;
}
// ============ A1: type confusion (structural INC, NODE output) ============
fn rt_a1()void {
  emit("=== A1 TYPE-CONFUSION ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_trainY(W,1);
  let f1:i32=ev_teach(W,21,81,22);
  let f2:i32=ev_teach(W,22,81,23);
  let f3:i32=ev_teach(W,23,81,24);
  let vv:[]u8=z_alloc(16);
  set32(vv,0,21); set32(vv,4,22); set32(vv,8,23); set32(vv,12,24);
  let ff:[]u8=z_alloc(12);
  set32(ff,0,f1); set32(ff,4,f2); set32(ff,8,f3);
  let root:i32=rt_asm_stepchain(W,vv,4,ff);
  let S:i32=promote_graph(W,root,21,81,24,ff,3);
  emit("A1 S="); e64(S);
  emit(" oty(S)="); e64(xio_oty(W,S));
  emit(" exec(S,21)="); e64(t2_exec(W,root,21));
  emit(" chainstage(S,21)="); e64(rt_stage_chain_root(W,root,21));
  emit("\n");
  ev_teach(W,24,82,25); ev_teach(W,25,82,26);
  rt_gap(W);
  rt_pair_stats(W);
  let a1:i32=xio_query(W,21,93,2,0,1);
  emit("A1 ans="); e64(a1); emit(" ");
  rt_acensus(W);
  // control: same facts, trial-built chain MAP instead of S
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  rt_trainY(W2,1);
  ev_teach(W2,21,81,22); ev_teach(W2,22,81,23); ev_teach(W2,23,81,24);
  let c0:i32=xio_query(W2,21,91,24,0,1);
  emit("A1c train ans="); e64(c0); emit("\n");
  let C2:i32=rt_find_map_r(W2,91);
  emit("A1c C="); e64(C2); emit(" oty(C)="); e64(xio_oty(W2,C2)); emit("\n");
  ev_teach(W2,24,82,25); ev_teach(W2,25,82,26);
  rt_gap(W2);
  rt_pair_stats(W2);
  let a2:i32=xio_query(W2,21,93,2,0,1);
  emit("A1c ans="); e64(a2); emit(" ");
  rt_acensus(W2);
  return;
}
// ============ A2: wrong handoff (first-valid path wins) ============
fn rt_a2()void {
  emit("=== A2 WRONG-HANDOFF ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_trainX(W,1); rt_trainY(W,1); rt_gap(W);
  ev_teach(W,31,81,91); ev_teach(W,91,81,92); ev_teach(W,92,81,93);
  ev_teach(W,93,82,94); ev_teach(W,94,82,95);
  rt_zfacts(W,31);
  let a:i32=xio_query(W,31,93,2,0,1);
  emit("A2 ans="); e64(a); emit(" ");
  rt_acensus(W);
  let ad:i32=xio_find(W,93);
  if(ad>=0){
    let m1:i32=ng(W,ad,4);
    let v1:i32=xio_stage_exec(W,m1,31);
    emit("A2 handoff stage1(31)="); e64(v1); emit(" true-endpoint=34\n");
  }
  rt_zfacts(W,41);
  let a2:i32=xio_query(W,41,93,2,0,1);
  emit("A2 reuse ans="); e64(a2); emit(" ");
  rt_acensus(W);
  return;
}
// ============ A2b: denial by distractor shadowing ============
fn rt_a2b()void {
  emit("=== A2b DENIAL ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_trainX(W,1); rt_trainY(W,1); rt_gap(W);
  ev_teach(W,31,81,91); ev_teach(W,91,81,92); ev_teach(W,92,81,93);
  ev_teach(W,93,82,94);
  rt_zfacts(W,31);
  let a:i32=xio_query(W,31,93,2,0,1);
  emit("A2b ans="); e64(a); emit(" ");
  rt_acensus(W);
  emit("A2b true-paths len4 with counts:\n");
  rt_enum_paths(W,31,4,82);
  return;
}
// ============ A3: adapter explosion brake ============
fn rt_a3()void {
  emit("=== A3 EXPLOSION-BRAKE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_trainX(W,1); rt_trainY(W,1); rt_gap(W);
  rt_zfacts(W,31);
  let q1:i32=xio_query(W,31,93,2,0,1);
  let q1b:i32=xio_query(W,31,93,2,0,1);
  emit("A3 q1="); e64(q1); emit(" q1b="); e64(q1b); emit(" ");
  rt_acensus(W);
  rt_zfacts(W,41);
  let q2:i32=xio_query(W,41,93,2,0,1);
  rt_zfacts(W,71);
  let q3:i32=xio_query(W,71,94,2,0,1);
  emit("A3 q2="); e64(q2); emit(" q3="); e64(q3); emit(" ");
  rt_acensus(W);
  let before:i32=xio_count(W);
  let qm:i32=xio_try(W,81,95,-2);
  emit("A3 masked-try="); e64(qm);
  emit(" adapters-before="); e64(before);
  emit(" adapters-after="); e64(xio_count(W)); emit("\n");
  // scan cost on a failing composite (no count facts from the endpoint)
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  rt_trainX(W2,1); rt_trainY(W2,1); rt_gap(W2);
  ev_teach(W2,31,81,32); ev_teach(W2,32,81,33); ev_teach(W2,33,81,34);
  let qf:i32=xio_query(W2,31,93,2,0,1);
  emit("A3 failq="); e64(qf); emit("\n");
  rt_try_count(W2,31,93,2);
  rt_try_count(W2,31,93,2);
  return;
}
// ============ A4: stale adapter (revision, deletion) ============
fn rt_a4()void {
  emit("=== A4 STALE-ADAPTER ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_trainX(W,1); rt_trainY(W,1); rt_gap(W);
  rt_zfacts(W,31);
  let q1:i32=xio_query(W,31,93,2,0,1);
  let ad:i32=xio_find(W,93);
  emit("A4 build="); e64(q1); emit(" ad="); e64(ad);
  emit(" rec-ans="); e64(ng(W,ad,28)); emit("\n");
  // 4a: revise the world (extend the count chain): true count becomes 3
  ev_teach(W,36,82,39);
  let q2:i32=xio_query(W,31,93,3,0,1);
  emit("A4a revised-serve="); e64(q2);
  emit(" rec-ans-now="); e64(ng(W,ad,28)); emit("\n");
  let q2b:i32=xio_query(W,31,93,2,0,1);
  emit("A4a old-answer="); e64(q2b); emit("\n");
  // 4b: delete the count stage MAPs: the orphaned adapter must serve nothing
  rt_del_map_r(W,92);
  let q3a:i32=xio_query(W,31,93,2,0,1);
  emit("A4b del-m2 old-ans="); e64(q3a); emit(" ");
  rt_acensus(W);
  // the base trial re-learns the (revised) composite on its own
  let q3b:i32=xio_query(W,31,93,3,0,1);
  emit("A4b relearn="); e64(q3b); emit(" ");
  rt_acensus(W);
  return;
}
// ============ A4c: id recycling silently rebinds a stage ============
// After the chain stage MAPs are deleted, a newly promoted COUNT MAP
// lands (first-fit) on the adapter's old m1 id. The adapter records
// (o1=0, rel1=81) but silently executes the new MAP (oty=1, rel=82):
// bare-id binding with no generation check.
fn rt_a4c()void {
  emit("=== A4c ID-RECYCLING ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_trainX(W,1); rt_trainY(W,1); rt_gap(W);
  rt_zfacts(W,31);
  let q1:i32=xio_query(W,31,93,2,0,1);
  let ad:i32=xio_find(W,93);
  let m1:i32=ng(W,ad,4);
  emit("A4c ad="); e64(ad); emit(" m1="); e64(m1);
  emit(" rec-o1="); e64(ng(W,ad,12));
  emit(" live-oty(m1)="); e64(xio_oty(W,m1)); emit("\n");
  // world changes AFTER the build: true count 31->34 becomes 3
  ev_teach(W,36,82,39);
  // facts for the replacement count MAP: 31 -82-> 41..47 (count 7),
  // and 7 -82-> 70 -> 71 (count 2 from the recycled stage's output)
  let c1:i32=ev_teach(W,31,82,41);
  let c2:i32=ev_teach(W,41,82,42);
  let c3:i32=ev_teach(W,42,82,43);
  let c4:i32=ev_teach(W,43,82,44);
  let c5:i32=ev_teach(W,44,82,45);
  let c6:i32=ev_teach(W,45,82,46);
  let c7:i32=ev_teach(W,46,82,47);
  ev_teach(W,7,82,70); ev_teach(W,70,82,71);
  // build the replacement count graph BEFORE deleting (cells take fresh ids)
  let cv:[]u8=z_alloc(32);
  set32(cv,0,31); set32(cv,4,41); set32(cv,8,42); set32(cv,12,43);
  set32(cv,16,44); set32(cv,20,45); set32(cv,24,46); set32(cv,28,47);
  let cf:[]u8=z_alloc(28);
  set32(cf,0,c1); set32(cf,4,c2); set32(cf,8,c3); set32(cf,12,c4);
  set32(cf,16,c5); set32(cf,20,c6); set32(cf,24,c7);
  let croot:i32=t2_asm_count(W,cv,8,cf);
  // delete the chain stage MAPs, then promote: first-fit reuses m1's id
  rt_del_map_r(W,91);
  let nm:i32=promote_graph(W,croot,31,82,7,cf,7);
  emit("A4c newmap="); e64(nm); emit(" ad.m1="); e64(ng(W,ad,4));
  emit(" rec-o1="); e64(ng(W,ad,12));
  emit(" live-oty(ad.m1)="); e64(xio_oty(W,ng(W,ad,4)));
  emit(" live-deprel(ad.m1)="); e64(xio_dep_rel(W,ng(W,ad,4))); emit("\n");
  // masked query through the stale adapter: silently serves the recycled
  // composition (2) while the true answer is now 3
  let qm:i32=xio_query(W,31,93,-2,1,1);
  emit("A4c masked-via-adapter="); e64(qm); emit(" true-now=3\n");
  let qu:i32=xio_query(W,31,93,3,0,1);
  emit("A4c unmasked-true="); e64(qu); emit("\n");
  return;
}
// ============ A5: three-stage (pair-only) ============
fn rt_a5()void {
  emit("=== A5 THREE-STAGE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_trainX(W,1); rt_trainY(W,1);
  // 83-chain facts only: no query, so no direct-fact shortcut and no MAP.
  // Three links: the cross-relation path 50 -92-> 3 -83-> 70 -> 71 -> 72
  // has length 5, and no chain MAP has plen 5, so rebind cannot solve it.
  ev_teach(W,3,83,70); ev_teach(W,70,83,71); ev_teach(W,71,83,72);
  rt_gap(W);
  // reverse 2-stage control: count(50,82)=3, then chain-walk from 3 -> 72.
  let r2:i32=xio_query(W,50,96,72,0,1);
  emit("A5 reverse ans="); e64(r2); emit(" ");
  rt_acensus(W);
  // three-stage: chain81 31->33, count82 33->2, chain83 2->72
  ev_teach(W,31,81,32); ev_teach(W,32,81,33);
  ev_teach(W,33,82,34); ev_teach(W,34,82,35);
  ev_teach(W,2,83,70);
  let t3:i32=xio_query(W,31,95,72,0,1);
  emit("A5 three-stage ans="); e64(t3); emit(" ");
  rt_acensus(W);
  return;
}
// ============ A6: oty proxy vs the sum family ============
fn rt_a6()void {
  emit("=== A6 SUM-FAMILY ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  rt_trainX(W,1);
  // enable sum trials the way the frozen base's own test does (t_p2)
  let cn:i32=alloc_node(W); ns(W,cn,0,8); write_node(W,cn,1,0,0,0);
  ev_teach(W,60,84,3); ev_teach(W,60,84,5);
  let sq:i32=xio_query(W,60,94,8,0,1);
  emit("A6 sum-train="); e64(sq); emit("\n");
  let Ms:i32=rt_find_map_r(W,94);
  emit("A6 sumMAP="); e64(Ms); emit(" oty="); e64(xio_oty(W,Ms)); emit("\n");
  let mroot:i32=ng(W,Ms,20);
  let true_out:i32=t2_exec(W,mroot,0);
  let staged:i32=xio_stage_exec(W,Ms,60);
  emit("A6 true-out="); e64(true_out); emit(" xio-stage="); e64(staged); emit("\n");
  rt_pair_stats(W);
  return;
}
// ev_query: the base's internal test battery references this symbol.
fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("RT-START\n");
  rt_a1(); rt_a2(); rt_a2b(); rt_a3(); rt_a4(); rt_a4c(); rt_a5(); rt_a6();
  emit("RT-END\n");
  return 0;
}

// arena.zag — CA-1 scorer and cost ledger (pure Zag).
// Usage: arena.zag score <worlddir> <replies.jsonl> <outdir>
// Reads battery.json, answer_key.json, turns.jsonl from worlddir.
// Cross-checks every test turn against battery.json (aborts on divergence).
// Writes <outdir>/results.txt and <outdir>/results.json.

// --- utils ---
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn appz(buf:[]u8,at:i32,s:[]u8)i32 {
  let n:i32=slen(s);
  let i:i32=0;
  while(i<n){buf[at+i]=s[i];i=i+1;}
  return at+n;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=2097152;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
fn st32(b:[]u8,at:i32,v:i32)void {
  b[at]=(v as u8); b[at+1]=((v>>8) as u8); b[at+2]=((v>>16) as u8); b[at+3]=((v>>24) as u8);
  return;
}
fn ld32(b:[]u8,at:i32)i32 {
  return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
// score in thousandths (integer): returns 0..1000
fn pct1000(num:i32,den:i32)i32 {
  if(den<=0){return 0;}
  return num*1000/den;
}

// split s on delim into slots (16B each, max n); returns count
fn split_csv(s:[]u8,delim:u8,slots:[]u8,n:i32)i32 {
  let len:i32=slen(s);
  let c:i32=0;
  let st:i32=0;
  let i:i32=0;
  while(i<=len && c<n){
    if(i==len || s[i]==delim){
      let k:i32=0;
      while(st+k<i && k<15){slots[c*16+k]=s[st+k];k=k+1;}
      slots[c*16+k]=0;
      c=c+1;
      st=i+1;
    }
    i=i+1;
  }
  return c;
}
fn set_inter(a:[]u8,na:i32,b:[]u8,nb:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<na){
    let j:i32=0;
    while(j<nb){
      if(streq(a[i*16..i*16+slen(a[i*16..i*16+16])],b[j*16..j*16+slen(b[j*16..j*16+16])])==1){c=c+1;}
      j=j+1;
    }
    i=i+1;
  }
  return c;
}

fn main()i32 {
  let a1:[]u8=_zag_arg(1);
  if(slen(a1)<5 || streq(a1[0..5],"score")!=1){
    emit("usage: arena.zag score <worlddir> <replies.jsonl> <outdir>\n");
    return 1;
  }
  let worlddir:[]u8=_zag_arg(2);
  let replies_path:[]u8=_zag_arg(3);
  let outdir:[]u8=_zag_arg(4);
  // ---- battery ----
  let bat:[]u8=read_file(pjoin(worlddir,"battery.json"));
  let bcap:[]u8=z_alloc(68*4);
  let bq:[]u8=z_alloc(68*96);
  let p:i32=findsub(bat,0,"\"items\":[[");
  if(p<0){emit("battery parse failed\n");return 1;}
  p=p+10;
  let bi:i32=0;
  while(bi<68){
    while(p<bat.len && (bat[p]<48 || bat[p]>57)){p=p+1;}
    let cap:i32=0;
    while(p<bat.len && bat[p]>=48 && bat[p]<=57){cap=cap*10+(bat[p] as i32)-48;p=p+1;}
    st32(bcap,bi*4,cap);
    p=findsub(bat,p,"\"")+1;
    let e2:i32=p;
    while(e2<bat.len && bat[e2]!=34){e2=e2+1;}
    let q:[]u8=bat[p..e2];
    let k:i32=0;
    while(k<q.len && k<95){bq[bi*96+k]=q[k];k=k+1;}
    bq[bi*96+k]=0;
    p=e2+1;
    bi=bi+1;
  }
  // ---- answers ----
  let ak:[]u8=read_file(pjoin(worlddir,"answer_key.json"));
  let aans:[]u8=z_alloc(68*128);
  p=findsub(ak,0,"\"answers\":[")+11;
  bi=0;
  while(bi<68){
    p=findsub(ak,p,"\"")+1;
    let e2:i32=p;
    while(e2<ak.len && ak[e2]!=34){e2=e2+1;}
    let q:[]u8=ak[p..e2];
    let k:i32=0;
    while(k<q.len && k<127){aans[bi*128+k]=q[k];k=k+1;}
    aans[bi*128+k]=0;
    p=e2+1;
    bi=bi+1;
  }
  // ---- turns ----
  let td:[]u8=read_file(pjoin(worlddir,"turns.jsonl"));
  let t_item:[]u8=z_alloc(256*4);   // by turn number
  let t_cap:[]u8=z_alloc(256*4);
  let t_q:[]u8=z_alloc(256*96);
  let t_kind:[]u8=z_alloc(256);     // 0=other 1=test 2=expo
  let nturns:i32=0;
  let nexpo:i32=0;
  let lp:i32=0;
  while(lp<td.len){
    let le:i32=lp;
    while(le<td.len && td[le]!=10){le=le+1;}
    let line:[]u8=td[lp..le];
    // kind
    let kp:i32=findsub(line,0,"\"kind\":\"");
    if(kp>=0){
      let ks:i32=kp+8;
      let ke:i32=ks;
      while(ke<line.len && line[ke]!=34){ke=ke+1;}
      let kd:[]u8=line[ks..ke];
      // turn number
      let tp:i32=findsub(line,0,"\"turn\":")+7;
      let tn:i32=0;
      while(tp<line.len && line[tp]>=48 && line[tp]<=57){tn=tn*10+(line[tp] as i32)-48;tp=tp+1;}
      if(tn>nturns){nturns=tn;}
      if(streq(kd,"test")==1){
        t_kind[tn]=1;
        let ip:i32=findsub(line,0,"\"item\":")+7;
        let it2:i32=0;
        while(ip<line.len && line[ip]>=48 && line[ip]<=57){it2=it2*10+(line[ip] as i32)-48;ip=ip+1;}
        let cp2:i32=findsub(line,0,"\"cap\":")+6;
        let cpv:i32=0;
        while(cp2<line.len && line[cp2]>=48 && line[cp2]<=57){cpv=cpv*10+(line[cp2] as i32)-48;cp2=cp2+1;}
        let qp:i32=findsub(line,0,"\"q\":\"")+5;
        let qe:i32=qp;
        while(qe<line.len && line[qe]!=34){qe=qe+1;}
        let qq:[]u8=line[qp..qe];
        st32(t_item,tn*4,it2);
        st32(t_cap,tn*4,cpv);
        let k:i32=0;
        while(k<qq.len && k<95){t_q[tn*96+k]=qq[k];k=k+1;}
        t_q[tn*96+k]=0;
        // cross-check vs battery
        if(it2<0 || it2>=68){emit("bad item idx\n");return 1;}
        if(ld32(bcap,it2*4)!=cpv){emit("DIVERGENCE: cap mismatch\n");return 1;}
        if(streq(t_q[tn*96..tn*96+slen(t_q[tn*96..tn*96+96])],bq[it2*96..it2*96+slen(bq[it2*96..it2*96+96])])!=1){
          emit("DIVERGENCE: q mismatch\n");return 1;
        }
      }
      if(streq(kd,"expo")==1){t_kind[tn]=2;nexpo=nexpo+1;}
    }
    lp=le+1;
  }
  // ---- replies ----
  let rd:[]u8=read_file(replies_path);
  let r_reply:[]u8=z_alloc(256*256);
  let r_ms:[]u8=z_alloc(256*4);
  let r_rss:[]u8=z_alloc(256*8);
  let r_sb:[]u8=z_alloc(256*8);
  let r_obs:[]u8=z_alloc(256);
  let r_seen:[]u8=z_alloc(256);
  lp=0;
  while(lp<rd.len){
    let le:i32=lp;
    while(le<rd.len && rd[le]!=10){le=le+1;}
    let line:[]u8=rd[lp..le];
    let tp:i32=findsub(line,0,"\"turn\":");
    if(tp>=0){
      tp=tp+7;
      let tn:i32=0;
      while(tp<line.len && line[tp]>=48 && line[tp]<=57){tn=tn*10+(line[tp] as i32)-48;tp=tp+1;}
      r_seen[tn]=1;
      let rp:i32=findsub(line,0,"\"reply\":\"");
      if(rp>=0){
        let rs:i32=rp+9;
        let re:i32=rs;
        while(re<line.len && line[re]!=34){re=re+1;}
        let qq:[]u8=line[rs..re];
        let k:i32=0;
        while(k<qq.len && k<255){r_reply[tn*256+k]=qq[k];k=k+1;}
        r_reply[tn*256+k]=0;
      }
      let mp:i32=findsub(line,0,"\"ms\":");
      if(mp>=0){
        mp=mp+5;
        let mv:i32=0;
        while(mp<line.len && line[mp]>=48 && line[mp]<=57){mv=mv*10+(line[mp] as i32)-48;mp=mp+1;}
        st32(r_ms,tn*4,mv);
      }
      let sp:i32=findsub(line,0,"\"rss_kb\":");
      if(sp>=0){
        sp=sp+9;
        let sv:i64=0;
        while(sp<line.len && line[sp]>=48 && line[sp]<=57){sv=sv*10+(line[sp] as i64)-48;sp=sp+1;}
        let sb:[]u8=r_rss;
        sb[tn*8]=(sv as u8);sb[tn*8+1]=((sv>>8) as u8);sb[tn*8+2]=((sv>>16) as u8);sb[tn*8+3]=((sv>>24) as u8);
        sb[tn*8+4]=((sv>>32) as u8);sb[tn*8+5]=((sv>>40) as u8);sb[tn*8+6]=((sv>>48) as u8);sb[tn*8+7]=((sv>>56) as u8);
      }
      let bp2:i32=findsub(line,0,"\"state_bytes\":");
      if(bp2>=0){
        bp2=bp2+14;
        let bv:i64=0;
        while(bp2<line.len && line[bp2]>=48 && line[bp2]<=57){bv=bv*10+(line[bp2] as i64)-48;bp2=bp2+1;}
        let sb2:[]u8=r_sb;
        sb2[tn*8]=(bv as u8);sb2[tn*8+1]=((bv>>8) as u8);sb2[tn*8+2]=((bv>>16) as u8);sb2[tn*8+3]=((bv>>24) as u8);
        sb2[tn*8+4]=((bv>>32) as u8);sb2[tn*8+5]=((bv>>40) as u8);sb2[tn*8+6]=((bv>>48) as u8);sb2[tn*8+7]=((bv>>56) as u8);
      }
      if(findsub(line,0,"\"observe\":[")>=0){r_obs[tn]=1;}
    }
    lp=le+1;
  }

  // ---- per-item scoring (last test-turn reply wins; C8 needs observe on first) ----
  let iscore:[]u8=z_alloc(68*4);   // thousandths
  let ims:[]u8=z_alloc(68*4);
  let first_obs:[]u8=z_alloc(68);
  let last_turn:[]u8=z_alloc(68*4);
  let it2:i32=0;
  while(it2<68){st32(last_turn,it2*4,-1);it2=it2+1;}
  let tn:i32=0;
  while(tn<=nturns){
    if(t_kind[tn]==1 && r_seen[tn]==1){
      let it3:i32=ld32(t_item,tn*4);
      let prev:i32=ld32(last_turn,it3*4);
      if(prev<0 && r_obs[tn]==1){first_obs[it3]=1;}
      st32(last_turn,it3*4,tn);
      st32(ims,it3*4,ld32(r_ms,tn*4));
    }
    tn=tn+1;
  }
  it2=0;
  while(it2<68){
    let lt:i32=ld32(last_turn,it2*4);
    let cap:i32=ld32(bcap,it2*4);
    let sc:i32=0;
    if(lt>=0){
      let rp:[]u8=r_reply[lt*256..lt*256+slen(r_reply[lt*256..lt*256+256])];
      let an:[]u8=aans[it2*128..it2*128+slen(aans[it2*128..it2*128+128])];
      if(cap==6){
        let vv:[]u8=z_alloc(2*16);
        split_csv(an,124,vv,2);
        let v1:[]u8=vv[0..slen(vv[0..16])];
        let v2:[]u8=vv[16..16+slen(vv[16..32])];
        let h1:i32=0; let h2:i32=0;
        if(findsub(rp,0,v1)>=0){h1=1;}
        if(findsub(rp,0,v2)>=0){h2=1;}
        if(h1==1 && h2==1){sc=1000;}
        if(h1+h2==1){sc=500;}
      }
      if(cap==7){
        if(findsub(rp,0,"UNKNOWN")>=0){sc=1000;}
      }
      if(cap==8){
        if(streq(rp,an)==1 && first_obs[it2]==1){sc=1000;}
      }
      if(cap==11){
        if(streq(rp,"UNKNOWN")==1){sc=1000;}
      }
      if(cap==15){
        let ea:[]u8=z_alloc(12*16); let ra:[]u8=z_alloc(12*16);
        let ne:i32=split_csv(an,44,ea,12);
        let nr:i32=split_csv(rp,44,ra,12);
        let inter:i32=set_inter(ea,ne,ra,nr);
        if(ne+nr>0){sc=2000*inter/(ne+nr);}
      }
      if(cap!=6 && cap!=7 && cap!=8 && cap!=11 && cap!=15){
        if(streq(rp,an)==1){sc=1000;}
      }
    }
    st32(iscore,it2*4,sc);
    it2=it2+1;
  }
  // ---- aggregate per capability ----
  let cn:[]u8=z_alloc(17*4); let cs:[]u8=z_alloc(17*4); let cms:[]u8=z_alloc(17*4);
  it2=0;
  while(it2<68){
    let cap:i32=ld32(bcap,it2*4);
    st32(cn,cap*4,ld32(cn,cap*4)+1);
    st32(cs,cap*4,ld32(cs,cap*4)+ld32(iscore,it2*4));
    st32(cms,cap*4,ld32(cms,cap*4)+ld32(ims,it2*4));
    it2=it2+1;
  }
  // ---- costs ----
  let tot_ms:i32=0; let max_rss:i64=0; let max_sb:i64=0; let ntool:i32=0;
  tn=0;
  while(tn<=nturns){
    if(r_seen[tn]==1){
      tot_ms=tot_ms+ld32(r_ms,tn*4);
      let sv:i64=(r_rss[tn*8] as i64)|((r_rss[tn*8+1] as i64)<<8)|((r_rss[tn*8+2] as i64)<<16)|((r_rss[tn*8+3] as i64)<<24)|((r_rss[tn*8+4] as i64)<<32)|((r_rss[tn*8+5] as i64)<<40)|((r_rss[tn*8+6] as i64)<<48)|((r_rss[tn*8+7] as i64)<<56);
      if(sv>max_rss){max_rss=sv;}
      let bv:i64=(r_sb[tn*8] as i64)|((r_sb[tn*8+1] as i64)<<8)|((r_sb[tn*8+2] as i64)<<16)|((r_sb[tn*8+3] as i64)<<24)|((r_sb[tn*8+4] as i64)<<32)|((r_sb[tn*8+5] as i64)<<40)|((r_sb[tn*8+6] as i64)<<48)|((r_sb[tn*8+7] as i64)<<56);
      if(bv>max_sb){max_sb=bv;}
      if(r_obs[tn]==1){ntool=ntool+1;}
    }
    tn=tn+1;
  }
  // ---- results.txt ----
  let rep:[]u8=z_alloc(8192); let rat:i32=0;
  rat=app(rep,rat,"CA-2 REFREEZE RESULTS (TNN reference contestant: infrastructure self-test only)\n");
  rat=app(rep,rat,"world: seed 71503461337030, 68 items, ");
  rat=app(rep,rat,i64s(nturns as i64)); rat=app(rep,rat," turns\n");
  rat=app(rep,rat,"cap n score\n");
  let c:i32=1;
  let tot_s:i32=0; let tot_n:i32=0;
  while(c<=16){
    let n2:i32=ld32(cn,c*4);
    let s2:i32=0;
    if(n2>0){s2=ld32(cs,c*4)/n2;}
    tot_s=tot_s+ld32(cs,c*4); tot_n=tot_n+n2;
    rat=app(rep,rat,i64s(c as i64)); rat=app(rep,rat," ");
    rat=app(rep,rat,i64s(n2 as i64)); rat=app(rep,rat," ");
    rat=app(rep,rat,i64s((s2/1000) as i64)); rat=app(rep,rat,".");
    let fr:i32=s2%1000;
    if(fr<100){rat=app(rep,rat,"0");}
    if(fr<10){rat=app(rep,rat,"0");}
    rat=app(rep,rat,i64s(fr as i64)); rat=app(rep,rat,"\n");
    c=c+1;
  }
  let tall:i32=0;
  if(tot_n>0){tall=tot_s/tot_n;}
  rat=app(rep,rat,"TOTAL "); rat=app(rep,rat,i64s(tot_n as i64)); rat=app(rep,rat," ");
  rat=app(rep,rat,i64s((tall/1000) as i64)); rat=app(rep,rat,".");
  let tfr:i32=tall%1000;
  if(tfr<100){rat=app(rep,rat,"0");}
  if(tfr<10){rat=app(rep,rat,"0");}
  rat=app(rep,rat,i64s(tfr as i64)); rat=app(rep,rat,"\n");
  rat=app(rep,rat,"costs: examples="); rat=app(rep,rat,i64s(nexpo as i64));
  rat=app(rep,rat," tool_calls="); rat=app(rep,rat,i64s(ntool as i64));
  rat=app(rep,rat," cpu_ms~"); rat=app(rep,rat,i64s(tot_ms as i64));
  rat=app(rep,rat," max_rss_kb="); rat=app(rep,rat,i64s(max_rss));
  rat=app(rep,rat," max_state_bytes="); rat=app(rep,rat,i64s(max_sb));
  rat=app(rep,rat," tokens=N/A(PENDING_LLM_BLOCKED)\n");
  // ---- results.json ----
  let js:[]u8=z_alloc(8192); let jat:i32=0;
  jat=app(js,jat,"{\"caps\":{");
  c=1;
  while(c<=16){
    if(c>1){jat=app(js,jat,",");}
    let n2:i32=ld32(cn,c*4);
    let s2:i32=0;
    if(n2>0){s2=ld32(cs,c*4)/n2;}
    jat=app(js,jat,"\""); jat=app(js,jat,i64s(c as i64)); jat=app(js,jat,"\":{");
    jat=app(js,jat,"\"n\":"); jat=app(js,jat,i64s(n2 as i64));
    jat=app(js,jat,",\"score\":"); jat=app(js,jat,i64s((s2/1000) as i64)); jat=app(js,jat,".");
    let fr2:i32=s2%1000;
    if(fr2<100){jat=app(js,jat,"0");}
    if(fr2<10){jat=app(js,jat,"0");}
    jat=app(js,jat,i64s(fr2 as i64));
    jat=app(js,jat,",\"ms\":"); jat=app(js,jat,i64s(ld32(cms,c*4) as i64));
    jat=app(js,jat,"}");
    c=c+1;
  }
  jat=app(js,jat,"},\"total\":"); jat=app(js,jat,i64s((tall/1000) as i64)); jat=app(js,jat,".");
  if(tfr<100){jat=app(js,jat,"0");}
  if(tfr<10){jat=app(js,jat,"0");}
  jat=app(js,jat,i64s(tfr as i64));
  jat=app(js,jat,",\"costs\":{\"examples\":"); jat=app(js,jat,i64s(nexpo as i64));
  jat=app(js,jat,",\"tool_calls\":"); jat=app(js,jat,i64s(ntool as i64));
  jat=app(js,jat,",\"cpu_ms\":"); jat=app(js,jat,i64s(tot_ms as i64));
  jat=app(js,jat,",\"max_rss_kb\":"); jat=app(js,jat,i64s(max_rss));
  jat=app(js,jat,",\"max_state_bytes\":"); jat=app(js,jat,i64s(max_sb));
  jat=app(js,jat,",\"tokens\":\"N/A\"}}");
  let fd:i64=w_open(pjoin(outdir,"results.txt"));
  w_write(fd,rep[0..rat]); w_close(fd);
  fd=w_open(pjoin(outdir,"results.json"));
  w_write(fd,js[0..jat]); w_close(fd);
  emit(rep[0..rat]);
  return 0;
}

// tnn_contestant.zag — white-box TNN contestant for the competitive arena (pure Zag).
// Usage: tnn_contestant <turn.json> <statedir> <worlddir>
// Reads one turn, updates persistent state in <statedir>/state.bin,
// prints exactly one JSON reply line to stdout.
// Native mechanisms only: explicit fact store with reliability/provenance,
// correction and conflict handling, UNKNOWN states, competing causal
// hypotheses, Zem template/transform learning. C10 uses a learned transform
// (L2 structural); C11 honestly returns UNKNOWN (no L3 claim).

// --- utils ---
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8,b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
fn slen(b:[]u8)i32 { let i:i32=0; while(i<b.len && b[i]!=0){i=i+1;} return i; }
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn appz(buf:[]u8,at:i32,s:[]u8)i32 {
  let n:i32=slen(s);
  let i:i32=0;
  while(i<n){buf[at+i]=s[i];i=i+1;}
  return at+n;
}
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0){return -1;}
  if(hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i<=hay.len-needle.len){
    let k:i32=0;
    let ok:i32=1;
    while(k<needle.len){
      if(hay[i+k]!=needle[k]){ok=0;}
      k=k+1;
    }
    if(ok==1){return i;}
    i=i+1;
  }
  return -1;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn pjoin(dir:[]u8,name:[]u8)[]u8 {
  let b:[]u8=z_alloc(dir.len+1+name.len+1);
  let at:i32=app(b,0,dir);
  at=app(b,at,"/");
  at=app(b,at,name);
  return b[0..at];
}
// JSON helpers: value of "key":"..." (string) or "key":123 (int)
fn jval(line:[]u8,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
fn jval_from(line:[]u8,from:i32,key:[]u8)[]u8 {
  let pat:[]u8=z_alloc(key.len+4);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":\"");
  let p:i32=findsub(line,from,pat[0..at]);
  z_free(pat);
  if(p<0){return "";}
  let s:i32=p+at;
  let e:i32=s;
  while(e<line.len && line[e]!=34){e=e+1;}
  return line[s..e];
}
fn jint(line:[]u8,key:[]u8)i32 {
  let pat:[]u8=z_alloc(key.len+3);
  let at:i32=app(pat,0,"\"");
  at=app(pat,at,key);
  at=app(pat,at,"\":");
  let p:i32=findsub(line,0,pat[0..at]);
  z_free(pat);
  if(p<0){return -999999;}
  let s:i32=p+at;
  let neg:i32=0;
  if(s<line.len && line[s]==45){neg=1;s=s+1;}
  let v:i32=0;
  while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;}
  if(neg==1){v=-v;}
  return v;
}
// monotonic ms via clock_gettime
fn now_ms()i64 {
  let ts:[]u8=z_alloc(16);
  _zag_raw_syscall(228,1,(_zag_slice_ptr(ts) as i64),0,0,0,0);
  let sec:i64=(ts[0] as i64)|((ts[1] as i64)<<8)|((ts[2] as i64)<<16)|((ts[3] as i64)<<24)|((ts[4] as i64)<<32)|((ts[5] as i64)<<40)|((ts[6] as i64)<<48)|((ts[7] as i64)<<56);
  let ns:i64=(ts[8] as i64)|((ts[9] as i64)<<8)|((ts[10] as i64)<<16)|((ts[11] as i64)<<24)|((ts[12] as i64)<<32)|((ts[13] as i64)<<40)|((ts[14] as i64)<<48)|((ts[15] as i64)<<56);
  z_free(ts);
  return sec*1000+ns/1000000;
}
// peak RSS kB from /proc/self/status (VmHWM); 0 if unavailable
fn peak_rss()i64 {
  let d:[]u8=read_file("/proc/self/status");
  let p:i32=findsub(d,0,"VmHWM:");
  if(p<0){return 0;}
  let s:i32=p+6;
  while(s<d.len && (d[s]<48 || d[s]>57)){s=s+1;}
  let v:i64=0;
  while(s<d.len && d[s]>=48 && d[s]<=57){v=v*10+(d[s] as i64)-48;s=s+1;}
  return v;
}

// --- persistent state ---
// layout: magic 8 | names 10x16 @8 | nfacts @168 | facts 64x68 @172 |
// nrels @4524 | rels 16x48 @4528 | nzem @5296 | zem 16x20 @5300 |
// template 3B+tid @5620 | nobs @5624 | obs 12x3 @5628 | hyp 6x4 @5664 |
// pending_q 96B @5676 | pending_valid @5772
fn OFF_NAMES()i32 { return 8; }
fn OFF_NFACTS()i32 { return 168; }
fn OFF_FACTS()i32 { return 172; }
fn OFF_NRELS()i32 { return 4524; }
fn OFF_RELS()i32 { return 4528; }
fn OFF_NZEM()i32 { return 5296; }
fn OFF_ZEM()i32 { return 5300; }
fn OFF_TMPL()i32 { return 5620; }
fn OFF_NOBS()i32 { return 5624; }
fn OFF_OBS()i32 { return 5628; }
fn OFF_HYP()i32 { return 5664; }
fn OFF_PEND()i32 { return 5676; }
fn ST_SIZE()i32 { return 8192; }
fn st32(b:[]u8,at:i32,v:i32)void {
  b[at]=(v as u8); b[at+1]=((v>>8) as u8); b[at+2]=((v>>16) as u8); b[at+3]=((v>>24) as u8);
  return;
}
fn ld32(b:[]u8,at:i32)i32 {
  return (b[at] as i32)|((b[at+1] as i32)<<8)|((b[at+2] as i32)<<16)|((b[at+3] as i32)<<24);
}
fn copy16(dst:[]u8,src:[]u8)void {
  let n:i32=slen(src);
  if(n>15){n=15;}
  let i:i32=0;
  while(i<n){dst[i]=src[i];i=i+1;}
  dst[n]=0;
  return;
}
fn st_new(s:[]u8)void {
  let i:i32=0;
  while(i<ST_SIZE()){s[i]=0;i=i+1;}
  s[0]=84; s[1]=78; s[2]=78; s[3]=83; s[4]=49; // "TNNS1"
  s[OFF_TMPL()]=255; s[OFF_TMPL()+1]=255; s[OFF_TMPL()+2]=255; // template unknown
  s[OFF_TMPL()+3]=255; // transform unknown
  return;
}
fn st_load(s:[]u8,path:[]u8)void {
  st_new(s);
  let d:[]u8=read_file(path);
  if(d.len<8){return;}
  if(d[0]!=84 || d[1]!=78 || d[2]!=78 || d[3]!=83 || d[4]!=49){return;}
  let n:i32=d.len;
  if(n>ST_SIZE()){n=ST_SIZE();}
  let i:i32=0;
  while(i<n){s[i]=d[i];i=i+1;}
  return;
}
fn st_save(s:[]u8,path:[]u8)i32 {
  let fd:i64=w_open(path);
  if(fd<0){return 0;}
  w_write(fd,s[0..ST_SIZE()]);
  w_close(fd);
  return ST_SIZE();
}
// facts
fn fact_find(s:[]u8,e:[]u8,a:[]u8)i32 {
  let n:i32=ld32(s,OFF_NFACTS());
  let i:i32=0;
  while(i<n){
    let base:i32=OFF_FACTS()+i*68;
    if(streq(s[base..base+slen(s[base..base+16])],e[0..slen(e)])==1){
      if(streq(s[base+16..base+16+slen(s[base+16..base+32])],a[0..slen(a)])==1){return i;}
    }
    i=i+1;
  }
  return -1;
}
fn fact_slot(s:[]u8,e:[]u8,a:[]u8)i32 {
  let f:i32=fact_find(s,e,a);
  if(f>=0){return f;}
  let n:i32=ld32(s,OFF_NFACTS());
  if(n>=64){return -1;}
  let base:i32=OFF_FACTS()+n*68;
  copy16(s[base..base+16],e);
  copy16(s[base+16..base+32],a);
  st32(s,OFF_NFACTS(),n+1);
  return n;
}
fn fact_set(s:[]u8,e:[]u8,a:[]u8,v:[]u8,rel:i32)void {
  let f:i32=fact_slot(s,e,a);
  if(f<0){return;}
  let base:i32=OFF_FACTS()+f*68;
  copy16(s[base+32..base+48],v);
  s[base+48]=rel as u8;
  return;
}
fn fact_correct(s:[]u8,e:[]u8,a:[]u8,nv:[]u8)void {
  let f:i32=fact_slot(s,e,a);
  if(f<0){return;}
  let base:i32=OFF_FACTS()+f*68;
  copy16(s[base+32..base+48],nv);
  s[base+48]=3;
  s[base+49]=1;
  s[base+50]=0;
  return;
}
fn fact_conflict(s:[]u8,e:[]u8,a:[]u8,v1:[]u8,v2:[]u8)void {
  let f:i32=fact_slot(s,e,a);
  if(f<0){return;}
  let base:i32=OFF_FACTS()+f*68;
  copy16(s[base+32..base+48],v1);
  copy16(s[base+52..base+68],v2);
  s[base+48]=2;
  s[base+50]=1;
  return;
}
// relations
fn rel_add(s:[]u8,a:[]u8,r:[]u8,b:[]u8)void {
  let n:i32=ld32(s,OFF_NRELS());
  if(n>=16){return;}
  let base:i32=OFF_RELS()+n*48;
  copy16(s[base..base+16],a);
  copy16(s[base+16..base+32],r);
  copy16(s[base+32..base+48],b);
  st32(s,OFF_NRELS(),n+1);
  return;
}
fn rel_find(s:[]u8,a:[]u8,r:[]u8,out:[]u8)i32 {
  let n:i32=ld32(s,OFF_NRELS());
  let i:i32=0;
  while(i<n){
    let base:i32=OFF_RELS()+i*48;
    if(streq(s[base..base+slen(s[base..base+16])],a[0..slen(a)])==1){
      if(streq(s[base+16..base+16+slen(s[base+16..base+32])],r[0..slen(r)])==1){
        copy16(out,s[base+32..base+48]);
        return 1;
      }
    }
    i=i+1;
  }
  return 0;
}
// zem words + template/transform learning
fn apply_tid(tid:i32,s0:i32,s1:i32,s2:i32,o:[]u8)void {
  if(tid==0){o[0]=s2 as u8;o[1]=s1 as u8;o[2]=s0 as u8;}
  if(tid==1){o[0]=s1 as u8;o[1]=s0 as u8;o[2]=s2 as u8;}
  if(tid==2){o[0]=(s0^1) as u8;o[1]=(s1^1) as u8;o[2]=(s2^1) as u8;}
  if(tid==3){o[0]=s2 as u8;o[1]=s1 as u8;o[2]=s0 as u8;}
  return;
}
fn zem_learn(s:[]u8)void {
  // need >=1 A word and >=1 B word
  let n:i32=ld32(s,OFF_NZEM());
  let ai:i32=-1; let bi:i32=-1;
  let i:i32=0;
  while(i<n){
    let base:i32=OFF_ZEM()+i*20;
    if(s[base+19]==65 && ai<0){ai=i;}
    if(s[base+19]==66 && bi<0){bi=i;}
    i=i+1;
  }
  if(ai<0 || bi<0){return;}
  let ab:i32=OFF_ZEM()+ai*20;
  let bb:i32=OFF_ZEM()+bi*20;
  let a0:i32=s[ab+16] as i32; let a1:i32=s[ab+17] as i32; let a2:i32=s[ab+18] as i32;
  let e0:i32=s[bb+16] as i32; let e1:i32=s[bb+17] as i32; let e2:i32=s[bb+18] as i32;
  let tid:i32=0;
  let found:i32=0;
  while(tid<4){
    let o:[]u8=z_alloc(3);
    apply_tid(tid,a0,a1,a2,o);
    if((o[0] as i32)==e0 && (o[1] as i32)==e1 && (o[2] as i32)==e2){
      if(found==0){s[OFF_TMPL()+3]=tid as u8;found=1;}
    }
    z_free(o);
    tid=tid+1;
  }
  return;
}
fn zem_add(s:[]u8,w:[]u8,s0:i32,s1:i32,s2:i32,cls:i32)void {
  let n:i32=ld32(s,OFF_NZEM());
  if(n>=16){return;}
  let base:i32=OFF_ZEM()+n*20;
  copy16(s[base..base+16],w);
  s[base+16]=s0 as u8; s[base+17]=s1 as u8; s[base+18]=s2 as u8;
  s[base+19]=cls as u8;
  st32(s,OFF_NZEM(),n+1);
  if(cls==65){
    if(s[OFF_TMPL()]==255){s[OFF_TMPL()]=s0 as u8;s[OFF_TMPL()+1]=s1 as u8;s[OFF_TMPL()+2]=s2 as u8;}
  }
  zem_learn(s);
  return;
}
// causal: 6 ordering hypotheses, each counts consistent obs
fn causal_add(s:[]u8,x:i32,y:i32,z:i32)void {
  let n:i32=ld32(s,OFF_NOBS());
  if(n<12){
    s[OFF_OBS()+n*3]=x as u8; s[OFF_OBS()+n*3+1]=y as u8; s[OFF_OBS()+n*3+2]=z as u8;
    st32(s,OFF_NOBS(),n+1);
  }
  // exact co-movement is consistent with every ordering: all 6 tied
  let h:i32=0;
  while(h<6){
    let c:i32=ld32(s,OFF_HYP()+h*4);
    st32(s,OFF_HYP()+h*4,c+1);
    h=h+1;
  }
  return;
}
// parse "s":[a,b,c] from ev region; returns count parsed
fn parse_segs(line:[]u8,o:[]u8)void {
  let p:i32=findsub(line,0,"\"s\":[");
  if(p<0){return;}
  let s:i32=p+5;
  let k:i32=0;
  while(k<3){
    while(s<line.len && (line[s]<48 || line[s]>57)){s=s+1;}
    let v:i32=0;
    while(s<line.len && line[s]>=48 && line[s]<=57){v=v*10+(line[s] as i32)-48;s=s+1;}
    o[k]=v as u8;
    k=k+1;
  }
  return;
}
// briefing ingestion: entity names from {"t":"entities","names":[...]}
fn ingest_briefing(s:[]u8,worlddir:[]u8)void {
  let d:[]u8=read_file(pjoin(worlddir,"briefing_tnn.jsonl"));
  let p:i32=findsub(d,0,"\"names\":[");
  if(p<0){return;}
  let q:i32=p+9;
  let ni:i32=0;
  while(ni<10){
    while(q<d.len && d[q]!=34){q=q+1;}
    if(q>=d.len){return;}
    q=q+1;
    let e2:i32=q;
    while(e2<d.len && d[e2]!=34){e2=e2+1;}
    let nm:[]u8=d[q..e2];
    copy16(s[OFF_NAMES()+ni*16..OFF_NAMES()+ni*16+16],nm);
    ni=ni+1;
    q=e2+1;
  }
  return;
}

// idx-th '|' delimited part of q into out(64B)
fn qpart(q:[]u8,idx:i32,out:[]u8)void {
  let n:i32=slen(q);
  let p:i32=0;
  let s:i32=0;
  let i:i32=0;
  while(i<=n){
    let c:u8=0;
    if(i<n){c=q[i];}
    if(c==124 || i==n){
      if(p==idx){
        let k:i32=0;
        while(k<i-s && k<63){out[k]=q[s+k];k=k+1;}
        out[k]=0;
        return;
      }
      p=p+1;
      s=i+1;
    }
    i=i+1;
  }
  out[0]=0;
  return;
}
// parse "a,b,c" into o[3]
fn parse_csv(s:[]u8,o:[]u8)void {
  let n:i32=slen(s);
  let k:i32=0;
  let i:i32=0;
  while(k<3 && i<n){
    while(i<n && (s[i]<48 || s[i]>57)){i=i+1;}
    let v:i32=0;
    while(i<n && s[i]>=48 && s[i]<=57){v=v*10+(s[i] as i32)-48;i=i+1;}
    o[k]=v as u8;
    k=k+1;
  }
  return;
}
// answer a fact-ish question into out; returns 1 if answered, 0 if unknown
fn answer_fact(s:[]u8,e:[]u8,a:[]u8,out:[]u8)i32 {
  let f:i32=fact_find(s,e,a);
  if(f<0){
    let k:i32=0; let u:[]u8="UNKNOWN";
    while(k<7){out[k]=u[k];k=k+1;} out[7]=0;
    return 0;
  }
  let base:i32=OFF_FACTS()+f*68;
  if(s[base+50]==1){
    // CONFLICT v1 / v2
    let at:i32=app(out,0,"CONFLICT ");
    at=appz(out,at,s[base+32..base+48]);
    at=app(out,at," / ");
    at=appz(out,at,s[base+52..base+68]);
    out[at]=0;
    return 1;
  }
  copy16(out,s[base+32..base+48]);
  return 1;
}
fn handle_expo(s:[]u8,line:[]u8)void {
  let evp:i32=findsub(line,0,"\"ev\":{");
  if(evp<0){return;}
  let t:[]u8=jval_from(line,evp,"t");
  if(streq(t,"f")==1){
    let e:[]u8=jval_from(line,evp,"e");
    let a:[]u8=jval_from(line,evp,"a");
    let v:[]u8=jval_from(line,evp,"v");
    fact_set(s,e,a,v,2);
    return;
  }
  if(streq(t,"r")==1){
    let a:[]u8=jval_from(line,evp,"a");
    let r:[]u8=jval_from(line,evp,"r");
    let b:[]u8=jval_from(line,evp,"b");
    rel_add(s,a,r,b);
    return;
  }
  if(streq(t,"z")==1){
    let w:[]u8=jval_from(line,evp,"w");
    let cls:[]u8=jval_from(line,evp,"cls");
    let sg:[]u8=z_alloc(3);
    parse_segs(line[evp..line.len],sg);
    let ci:i32=66;
    if(slen(cls)>0 && cls[0]==65){ci=65;}
    zem_add(s,w,sg[0] as i32,sg[1] as i32,sg[2] as i32,ci);
    z_free(sg);
    return;
  }
  if(streq(t,"c")==1){
    let x:i32=jint(line,"x"); let y:i32=jint(line,"y"); let z:i32=jint(line,"z");
    causal_add(s,x,y,z);
    return;
  }
  if(streq(t,"k")==1){
    let e:[]u8=jval_from(line,evp,"e");
    let a:[]u8=jval_from(line,evp,"a");
    let nv:[]u8=jval_from(line,evp,"new");
    fact_correct(s,e,a,nv);
    return;
  }
  if(streq(t,"x")==1){
    let e:[]u8=jval_from(line,evp,"e");
    let a:[]u8=jval_from(line,evp,"a");
    let v1:[]u8=jval_from(line,evp,"v1");
    let v2:[]u8=jval_from(line,evp,"v2");
    fact_conflict(s,e,a,v1,v2);
    return;
  }
  if(streq(t,"n")==1){
    let w:[]u8=jval_from(line,evp,"w");
    let sg:[]u8=z_alloc(3);
    parse_segs(line[evp..line.len],sg);
    zem_add(s,w,sg[0] as i32,sg[1] as i32,sg[2] as i32,65);
    z_free(sg);
    return;
  }
  return;
}
// store observe_result vals, but only for pairs matching the pending request
fn handle_observe_result(s:[]u8,line:[]u8)void {
  let pv:i32=s[OFF_PEND()+95] as i32;
  // pending_valid stored at OFF_PEND()+95? we use byte 95 as valid flag; q in [0..94]
  if(pv!=1){return;}
  let pq:[]u8=s[OFF_PEND()..OFF_PEND()+95];
  let pe:[]u8=z_alloc(64); let pa:[]u8=z_alloc(64);
  qpart(pq,1,pe); qpart(pq,2,pa);
  // scan vals array for {"e":"..","a":"..","v":".."}
  let vp:i32=findsub(line,0,"\"vals\":[");
  if(vp<0){z_free(pe);z_free(pa);return;}
  let q:i32=vp;
  while(q<line.len){
    let ep:i32=findsub(line,q,"\"e\":\"");
    if(ep<0){q=line.len;}
    if(ep>=0){
      let es:i32=ep+5;
      let ee:i32=es;
      while(ee<line.len && line[ee]!=34){ee=ee+1;}
      let ap:i32=findsub(line,ee,"\"a\":\"");
      let as2:i32=ap+5;
      let ae:i32=as2;
      while(ae<line.len && line[ae]!=34){ae=ae+1;}
      let vpp:i32=findsub(line,ae,"\"v\":\"");
      let vs:i32=vpp+5;
      let ve:i32=vs;
      while(ve<line.len && line[ve]!=34){ve=ve+1;}
      let ge:[]u8=line[es..ee];
      let ga:[]u8=line[as2..ae];
      let gv:[]u8=line[vs..ve];
      if(streq(ge[0..slen(ge)],pe[0..slen(pe)])==1){
        if(streq(ga[0..slen(ga)],pa[0..slen(pa)])==1){
          fact_set(s,ge,ga,gv,4);
        }
      }
      q=ve+1;
    }
  }
  s[OFF_PEND()+95]=0;
  z_free(pe); z_free(pa);
  return;
}

fn main()i32 {
  let t0:i64=now_ms();
  let turnpath:[]u8=_zag_arg(1);
  let statedir:[]u8=_zag_arg(2);
  let worlddir:[]u8=_zag_arg(3);
  if(turnpath.len==0 || statedir.len==0 || worlddir.len==0){
    emit("usage: tnn_contestant <turn.json> <statedir> <worlddir>\n");
    return 1;
  }
  let line:[]u8=read_file(turnpath);
  let st:[]u8=z_alloc(ST_SIZE());
  st_load(st,pjoin(statedir,"state.bin"));
  let kind:[]u8=jval(line,"kind");
  let turn:i32=jint(line,"turn");
  let out:[]u8=z_alloc(2048);
  let at:i32=0;
  if(streq(kind,"brief")==1){
    ingest_briefing(st,worlddir);
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"brief\",\"ok\":true}");
  }
  if(streq(kind,"expo")==1){
    handle_expo(st,line);
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"expo\",\"ok\":true}");
  }
  if(streq(kind,"observe_result")==1){
    handle_observe_result(st,line);
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"kind\":\"observe_result\",\"ok\":true}");
  }
  if(streq(kind,"done")==1){
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"done\":true}");
  }
  if(streq(kind,"test")==1){
    let item:i32=jint(line,"item");
    let cap:i32=jint(line,"cap");
    let q:[]u8=jval(line,"q");
    let head:[]u8=z_alloc(64); let p1:[]u8=z_alloc(64); let p2:[]u8=z_alloc(64); let p3:[]u8=z_alloc(64);
    qpart(q,0,head); qpart(q,1,p1); qpart(q,2,p2); qpart(q,3,p3);
    let ans:[]u8=z_alloc(256);
    let do_observe:i32=0;
    if(streq(head[0..slen(head)],"fact")==1 || streq(head[0..slen(head)],"fact2")==1 || streq(head[0..slen(head)],"conflict")==1){
      let known:i32=answer_fact(st,p1,p2,ans);
      if(known==0 && cap==8){
        // active inquiry: request the missing fact instead of guessing
        do_observe=1;
        let qn:i32=slen(q);
        if(qn>94){qn=94;}
        let qi:i32=0;
        while(qi<qn){st[OFF_PEND()+qi]=q[qi];qi=qi+1;}
        st[OFF_PEND()+qi]=0;
        st[OFF_PEND()+95]=1;
      }
    }
    if(streq(head[0..slen(head)],"hop2")==1){
      let mid:[]u8=z_alloc(64); let fin:[]u8=z_alloc(64);
      if(rel_find(st,p1,p2,mid)==1){
        if(rel_find(st,mid,p3,fin)==1){copy16(ans,fin);} else {copy16(ans,"UNKNOWN");}
      } else {copy16(ans,"UNKNOWN");}
      z_free(mid); z_free(fin);
    }
    if(streq(head[0..slen(head)],"discrim")==1){
      // answer = source variable of H1 (first char after "discrim|")
      ans[0]=p1[0]; ans[1]=0;
    }
    if(streq(head[0..slen(head)],"zemprod")==1){
      let sg:[]u8=z_alloc(3);
      parse_csv(p1,sg);
      let tid:i32=st[OFF_TMPL()+3] as i32;
      if(tid>3){copy16(ans,"UNKNOWN");}
      if(tid<=3){
        let o:[]u8=z_alloc(3);
        apply_tid(tid,sg[0] as i32,sg[1] as i32,sg[2] as i32,o);
        let a2:i32=0;
        a2=app(ans,a2,i64s(o[0] as i64)); a2=app(ans,a2,",");
        a2=app(ans,a2,i64s(o[1] as i64)); a2=app(ans,a2,",");
        a2=app(ans,a2,i64s(o[2] as i64)); ans[a2]=0;
        z_free(o);
      }
      z_free(sg);
    }
    if(streq(head[0..slen(head)],"invent")==1){copy16(ans,"UNKNOWN");}
    if(streq(head[0..slen(head)],"remap_prod")==1){
      let rm:[]u8=z_alloc(4); let sg:[]u8=z_alloc(3);
      parse_csv(p1,rm); parse_csv(p2,sg);
      let tid:i32=st[OFF_TMPL()+3] as i32;
      if(tid>3){copy16(ans,"UNKNOWN");}
      if(tid<=3){
        let o:[]u8=z_alloc(3);
        apply_tid(tid,sg[0] as i32,sg[1] as i32,sg[2] as i32,o);
        let a2:i32=0;
        a2=app(ans,a2,i64s(rm[o[0] as i32] as i64)); a2=app(ans,a2,",");
        a2=app(ans,a2,i64s(rm[o[1] as i32] as i64)); a2=app(ans,a2,",");
        a2=app(ans,a2,i64s(rm[o[2] as i32] as i64)); ans[a2]=0;
        z_free(o);
      }
      z_free(rm); z_free(sg);
    }
    if(streq(head[0..slen(head)],"remap_class")==1){
      let rm:[]u8=z_alloc(4); let sg:[]u8=z_alloc(3);
      parse_csv(p1,rm); parse_csv(p2,sg);
      if(st[OFF_TMPL()]==255){copy16(ans,"UNKNOWN");}
      if(st[OFF_TMPL()]!=255){
        let e0:i32=rm[st[OFF_TMPL()] as i32] as i32;
        let e1:i32=rm[st[OFF_TMPL()+1] as i32] as i32;
        let e2:i32=rm[st[OFF_TMPL()+2] as i32] as i32;
        if((sg[0] as i32)==e0 && (sg[1] as i32)==e1 && (sg[2] as i32)==e2){copy16(ans,"yes");}
        if((sg[0] as i32)!=e0 || (sg[1] as i32)!=e1 || (sg[2] as i32)!=e2){copy16(ans,"no");}
      }
      z_free(rm); z_free(sg);
    }
    if(streq(head[0..slen(head)],"zemclass")==1){
      let sg:[]u8=z_alloc(3);
      parse_csv(p1,sg);
      if(st[OFF_TMPL()]==255){copy16(ans,"UNKNOWN");}
      if(st[OFF_TMPL()]!=255){
        if((sg[0] as i32)==(st[OFF_TMPL()] as i32) && (sg[1] as i32)==(st[OFF_TMPL()+1] as i32) && (sg[2] as i32)==(st[OFF_TMPL()+2] as i32)){copy16(ans,"yes");}
        if((sg[0] as i32)!=(st[OFF_TMPL()] as i32) || (sg[1] as i32)!=(st[OFF_TMPL()+1] as i32) || (sg[2] as i32)!=(st[OFF_TMPL()+2] as i32)){copy16(ans,"no");}
      }
      z_free(sg);
    }
    if(streq(head[0..slen(head)],"listnames")==1){
      let a2:i32=0;
      let ni:i32=0;
      while(ni<10){
        if(ni>0){a2=app(ans,a2,",");}
        a2=appz(ans,a2,st[OFF_NAMES()+ni*16..OFF_NAMES()+ni*16+16]);
        ni=ni+1;
      }
      ans[a2]=0;
    }
    // emit reply
    at=app(out,at,"{\"turn\":"); at=app(out,at,i64s(turn as i64));
    at=app(out,at,",\"item\":"); at=app(out,at,i64s(item as i64));
    at=app(out,at,",\"cap\":"); at=app(out,at,i64s(cap as i64));
    if(do_observe==1){
      at=app(out,at,",\"observe\":[{\"e\":\""); at=appz(out,at,p1);
      at=app(out,at,"\",\"a\":\""); at=appz(out,at,p2); at=app(out,at,"\"}]");
      at=app(out,at,",\"reply\":\"\"}");
    }
    if(do_observe==0){
      at=app(out,at,",\"reply\":\""); at=appz(out,at,ans); at=app(out,at,"\"}");
    }
    z_free(head); z_free(p1); z_free(p2); z_free(p3); z_free(ans);
  }
  let state_bytes:i32=st_save(st,pjoin(statedir,"state.bin"));
  let ms:i64=now_ms()-t0;
  let rss:i64=peak_rss();
  // append metrics before final close: insert into the JSON we built
  // (rebuild tail: strip trailing "}" then add metrics)
  let olen:i32=slen(out);
  at=olen-1;
  at=app(out,at,",\"ms\":"); at=app(out,at,i64s(ms));
  at=app(out,at,",\"rss_kb\":"); at=app(out,at,i64s(rss));
  at=app(out,at,",\"state_bytes\":"); at=app(out,at,i64s(state_bytes as i64));
  at=app(out,at,"}\n");
  emit(out[0..at]);
  return 0;
}

// proc_transfer.zag — Transfer tests for invented n-1-k procedure.
// PI-5a: Different symbol set (high bytes, control chars).
// PI-5b: Different domain (number array as bytes, not ASCII).
// PI-5c: Composition (manual double-apply; learner has no compose op).
//
// The invented program from v1 (index 608):
//   Nodes: [N K C1 ADD SUB]
//   Decoded: SUB(N, ADD(K, C1)) = n - (k+1) = n-1-k
//
// We hardcode this as the "persisted learner state" and test whether
// it transfers WITHOUT re-running search. This is the true transfer test.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}

// The invented n-1-k program, hardcoded as persisted learner state.
// Nodes: [N(1), K(0), C1(3), ADD(5), SUB(6)]
// Node format: [type, left, right]. Terminals have left=right=255.
// Index: 0:N, 1:K, 2:C1, 3:ADD(1,2), 4:SUB(0,3)
// Root is node 4.
fn eval_n_1_k(k:i32, n:i32)i32 {
  // SUB(N, ADD(K, C1))
  // = n - (k + 1)
  return n - (k + 1);
}

// Apply n-1-k to reverse a byte sequence.
// Returns 1 on success, 0 if index out of bounds.
fn apply_reverse(inp:[]u8, out:[]u8)i32 {
  let n:i32=inp.len;
  let k:i32=0;
  while(k<n){
    let idx:i32=eval_n_1_k(k, n);
    if(idx<0 || idx>=n){return 0;}
    out[k]=inp[idx];
    k=k+1;
  }
  return 1;
}

fn main()i32 {
  emit("=== proc_transfer: PI-5 transfer tests ===\n");
  emit("Testing persisted n-1-k procedure (no re-search).\n\n");

  let total:i32=0;
  let passed:i32=0;

  // PI-5a: Different symbol set.
  // Training used ASCII letters ("abc", "xy"). Test on:
  // (a) High byte values (200, 201, 202) - not ASCII, not in training.
  // (b) Control characters (10, 20, 30) - different byte range.
  emit("--- PI-5a: Different symbol set ---\n");

  // Test 5a-1: High bytes [200, 201, 202] -> [202, 201, 200]
  let t5a1_in:[]u8=z_alloc(3);
  t5a1_in[0]=200 as u8; t5a1_in[1]=201 as u8; t5a1_in[2]=202 as u8;
  let t5a1_exp:[]u8=z_alloc(3);
  t5a1_exp[0]=202 as u8; t5a1_exp[1]=201 as u8; t5a1_exp[2]=200 as u8;
  let t5a1_out:[]u8=z_alloc(3);
  total=total+1;
  if(apply_reverse(t5a1_in, t5a1_out)==1 && streq(t5a1_out, t5a1_exp)==1){
    passed=passed+1;
    emit("5a-1 high-bytes [200,201,202] PASS\n");
  } else {
    emit("5a-1 high-bytes [200,201,202] FAIL\n");
  }

  // Test 5a-2: Control chars [10, 20, 30, 40] -> [40, 30, 20, 10]
  let t5a2_in:[]u8=z_alloc(4);
  t5a2_in[0]=10 as u8; t5a2_in[1]=20 as u8; t5a2_in[2]=30 as u8; t5a2_in[3]=40 as u8;
  let t5a2_exp:[]u8=z_alloc(4);
  t5a2_exp[0]=40 as u8; t5a2_exp[1]=30 as u8; t5a2_exp[2]=20 as u8; t5a2_exp[3]=10 as u8;
  let t5a2_out:[]u8=z_alloc(4);
  total=total+1;
  if(apply_reverse(t5a2_in, t5a2_out)==1 && streq(t5a2_out, t5a2_exp)==1){
    passed=passed+1;
    emit("5a-2 control-chars [10,20,30,40] PASS\n");
  } else {
    emit("5a-2 control-chars [10,20,30,40] FAIL\n");
  }

  // PI-5b: Different domain.
  // The procedure operates on indices, not on "strings" per se.
  // Test on a number array represented as raw bytes (values 1-5, NOT ASCII '1'-'5').
  // This is a different domain: numeric data, not text.
  emit("\n--- PI-5b: Different domain (numeric array) ---\n");

  // Test 5b-1: [1,2,3,4,5] (bytes) -> [5,4,3,2,1]
  let t5b1_in:[]u8=z_alloc(5);
  t5b1_in[0]=1 as u8; t5b1_in[1]=2 as u8; t5b1_in[2]=3 as u8; t5b1_in[3]=4 as u8; t5b1_in[4]=5 as u8;
  let t5b1_exp:[]u8=z_alloc(5);
  t5b1_exp[0]=5 as u8; t5b1_exp[1]=4 as u8; t5b1_exp[2]=3 as u8; t5b1_exp[3]=2 as u8; t5b1_exp[4]=1 as u8;
  let t5b1_out:[]u8=z_alloc(5);
  total=total+1;
  if(apply_reverse(t5b1_in, t5b1_out)==1 && streq(t5b1_out, t5b1_exp)==1){
    passed=passed+1;
    emit("5b-1 numeric [1,2,3,4,5] PASS\n");
  } else {
    emit("5b-1 numeric [1,2,3,4,5] FAIL\n");
  }

  // Test 5b-2: Single-element numeric [42] -> [42] (edge case in new domain)
  let t5b2_in:[]u8=z_alloc(1);
  t5b2_in[0]=42 as u8;
  let t5b2_exp:[]u8=z_alloc(1);
  t5b2_exp[0]=42 as u8;
  let t5b2_out:[]u8=z_alloc(1);
  total=total+1;
  if(apply_reverse(t5b2_in, t5b2_out)==1 && streq(t5b2_out, t5b2_exp)==1){
    passed=passed+1;
    emit("5b-2 single numeric [42] PASS\n");
  } else {
    emit("5b-2 single numeric [42] FAIL\n");
  }

  // PI-5c: Composition.
  // The v1 learner has NO composition operator. It cannot combine procedures.
  // We test manual composition (apply twice = identity) to show the procedure
  // is composable IN PRINCIPLE, but the learner cannot do this automatically.
  // This documents a boundary, not a pass.
  emit("\n--- PI-5c: Composition (boundary test) ---\n");
  emit("Note: v1 learner has no compose operator. Testing manual double-apply.\n");

  // Test 5c-1: Reverse twice = identity. "abc" -> "cba" -> "abc".
  let t5c_in:[]u8="abc";
  let t5c_mid:[]u8=z_alloc(3);
  let t5c_out:[]u8=z_alloc(3);
  total=total+1;
  if(apply_reverse(t5c_in, t5c_mid)==1 && apply_reverse(t5c_mid, t5c_out)==1 && streq(t5c_out, t5c_in)==1){
    passed=passed+1;
    emit("5c-1 manual compose (reverse twice = identity) PASS\n");
  } else {
    emit("5c-1 manual compose (reverse twice = identity) FAIL\n");
  }

  // Test 5c-2: Learner-automatic composition.
  // This is EXPECTED TO FAIL because v1 has no composition mechanism.
  // We document it as a limitation, not a bug.
  emit("5c-2 learner-automatic composition: NOT IMPLEMENTED (v1 limitation)\n");
  emit("  The learner cannot combine n-1-k with another procedure.\n");
  emit("  It would need to re-run search from scratch on composed examples.\n");

  // Summary
  emit("\n=== Transfer Summary ===\n");
  emit("Passed: ");
  emit(i32s(passed));
  emit("/");
  emit(i32s(total));
  emit("\n");

  emit("\nInterpretation:\n");
  emit("PI-5a (symbol set): The procedure operates on indices, not symbols.\n");
  emit("  Transfer is trivial because n-1-k is representation-agnostic.\n");
  emit("  This is a strength (generality) but also shows the 'invention'\n");
  emit("  is at the index-mapping level, not the semantic level.\n");
  emit("PI-5b (domain): Same as 5a. The 'domain' is still byte sequences.\n");
  emit("  True cross-domain transfer (e.g., to action sequences) untested.\n");
  emit("PI-5c (composition): Learner cannot compose. Manual compose works.\n");
  emit("  This is a documented v1 limitation.\n");

  emit("\n=== done ===\n");
  if(passed==total){
    return 0;
  }
  return 1;
}

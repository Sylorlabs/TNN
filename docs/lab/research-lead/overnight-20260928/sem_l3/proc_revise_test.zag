// proc_revise_test.zag — L3 Criterion 12: Procedure Revision Test.
//
// H-REVISE: Can proc_learn revise after a counterexample?
//
// Phase 1: Baseline - confirm Family X finds SUB(N,C1) [broadcast-last].
// Phase 2: Counterexample - "xab"->"xxx" (broadcast-first, starts with x).
// Phase 3: Re-search with all 4 sequences.
// Phase 4: Document result.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}

fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}
fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return eval_node(prog, nnodes-1, k, n);
}

fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  return prog_store[off+1..off+1+ (prog_store[off] as i32)*3];
}

fn print_seq(seq:[]u8, len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit(i32s(get32(seq, i*4)));
    i=i+1;
  }
  emit("]");
  return;
}

fn print_prog(prog:[]u8, nnodes:i32)void {
  emit("[");
  let i:i32=0;
  while(i<nnodes){
    if(i>0){emit(" ");}
    let tt:i32=prog[i*3] as i32;
    if(tt==0){emit("K");}
    else if(tt==1){emit("N");}
    else if(tt==2){emit("C0");}
    else if(tt==3){emit("C1");}
    else if(tt==4){emit("C2");}
    else if(tt==5){emit("ADD");}
    else if(tt==6){emit("SUB");}
    i=i+1;
  }
  emit("]");
  return;
}

fn main()i32 {
  emit("=== PROC REVISION TEST (H-REVISE) ===\n\n");

  // ============ PHASE 1: BASELINE ============
  emit("--- PHASE 1: BASELINE (Family X) ---\n");

  let seq0:[]u8=z_alloc(16*4);
  let seq1:[]u8=z_alloc(16*4);
  let seq2:[]u8=z_alloc(16*4);

  let len0:i32=extract_seq("abc", "ccc", seq0);
  let len1:i32=extract_seq("xy", "yy", seq1);
  let len2:i32=extract_seq("defg", "gggg", seq2);

  emit("seq0 (abc->ccc): "); print_seq(seq0, len0); emit(" n=3\n");
  emit("seq1 (xy->yy): "); print_seq(seq1, len1); emit(" n=2\n");
  emit("seq2 (defg->gggg): "); print_seq(seq2, len2); emit(" n=4\n");

  // Build program enumeration (same as proc_learn.zag)
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;

  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1; t=t+1;
  }
  let size1_end:i32=pcount;

  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;

  op=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1; b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  emit("total programs enumerated: ");
  emit(i32s(pcount));
  emit("\n");

  // Search baseline (3 sequences)
  let tmp:[]u8=z_alloc(1);
  let found_baseline:i32=-1;
  let pi:i32=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp);
    let nn:i32=tmp[0] as i32;
    if(prog_fits(prog, nn, seq0, len0, 3)==1){
      if(prog_fits(prog, nn, seq1, len1, 2)==1){
        if(prog_fits(prog, nn, seq2, len2, 4)==1){
          found_baseline=pi;
          pi=pcount;
        }
      }
    }
    pi=pi+1;
  }

  if(found_baseline>=0){
    let bp:[]u8=get_prog(prog_store, prog_index, found_baseline, tmp);
    let bnn:i32=tmp[0] as i32;
    emit("BASELINE program found: index ");
    emit(i32s(found_baseline));
    emit(" ");
    print_prog(bp, bnn);
    emit("\n");
  } else {
    emit("BASELINE: NO PROGRAM FOUND (unexpected!)\n");
    return 1;
  }

  // ============ PHASE 2: COUNTEREXAMPLE ============
  emit("\n--- PHASE 2: COUNTEREXAMPLE ---\n");
  emit("New evidence: \"xab\" -> \"xxx\"\n");
  emit("Rule: broadcast-last UNLESS input starts with 'x', then broadcast-first.\n");

  let seq3:[]u8=z_alloc(16*4);
  let len3:i32=extract_seq("xab", "xxx", seq3);
  emit("seq3 (xab->xxx): "); print_seq(seq3, len3); emit(" n=3\n");

  // Check what baseline predicts for "xab"
  let bp2:[]u8=get_prog(prog_store, prog_index, found_baseline, tmp);
  let bnn2:i32=tmp[0] as i32;
  emit("Baseline predicts for n=3: [");
  let k:i32=0;
  while(k<3){
    if(k>0){emit(",");}
    emit(i32s(eval_prog(bp2, bnn2, k, 3)));
    k=k+1;
  }
  emit("] -> \"bbb\" (WRONG, expected [0,0,0] -> \"xxx\")\n");
  emit("COUNTEREXAMPLE CONFIRMED: baseline fails on xab.\n");

  // ============ PHASE 3: REVISION ATTEMPT ============
  emit("\n--- PHASE 3: REVISION ATTEMPT ---\n");
  emit("Re-search with all 4 sequences (baseline + counterexample).\n");
  emit("Note: seq0 requires P(k,3)=2, seq3 requires P(k,3)=0.\n");
  emit("These CONTRADICT for identical (k,n) inputs.\n");

  let found_revised:i32=-1;
  pi=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp);
    let nn:i32=tmp[0] as i32;
    if(prog_fits(prog, nn, seq0, len0, 3)==1){
      if(prog_fits(prog, nn, seq1, len1, 2)==1){
        if(prog_fits(prog, nn, seq2, len2, 4)==1){
          if(prog_fits(prog, nn, seq3, len3, 3)==1){
            found_revised=pi;
            pi=pcount;
          }
        }
      }
    }
    pi=pi+1;
  }

  if(found_revised>=0){
    let rp:[]u8=get_prog(prog_store, prog_index, found_revised, tmp);
    let rnn:i32=tmp[0] as i32;
    emit("UNEXPECTED: revised program found: index ");
    emit(i32s(found_revised));
    emit(" ");
    print_prog(rp, rnn);
    emit("\n");
    emit("H-REVISE may SURVIVE (investigate!).\n");
  } else {
    emit("RESULT: NO PROGRAM FOUND.\n");
    emit("No program in {K,N,C0,C1,C2,ADD,SUB} (size<=5) fits all 4 sequences.\n");
    emit("Mathematical reason: P(k,n) cannot distinguish seq0 (n=3->2) from\n");
    emit("seq3 (n=3->0). Program signature lacks input content access.\n");
  }

  // ============ PHASE 4: ARCHITECTURAL ANALYSIS ============
  emit("\n--- PHASE 4: ARCHITECTURAL GAP ANALYSIS ---\n");
  emit("1. Counterexample detection: ABSENT. One-shot batch, no monitoring loop.\n");
  emit("2. Failure diagnosis: ABSENT. No mechanism to characterize WHEN it fails.\n");
  emit("3. Conditional representation: ABSENT. No IF, no comparison, no content access.\n");
  emit("   Program signature P(k,n)->index cannot express 'if first char is x'.\n");
  emit("4. Revision operators: ABSENT. No specialize, split, merge, deprecate.\n");
  emit("5. Procedure memory: ABSENT. Program found and used, not stored as revisable.\n");
  emit("\nK-R1 (No representation): TRIGGERED. No program can express conditional.\n");
  emit("K-R2 (Re-search not revision): TRIGGERED. Only path is full re-search.\n");
  emit("K-R4 (No detection): TRIGGERED. Human must notice mismatch.\n");
  emit("\nVERDICT: H-REVISE KILLED.\n");
  emit("The mechanism cannot revise. Architectural gap is fundamental:\n");
  emit("- Language cannot represent content-conditional procedures.\n");
  emit("- Architecture has no revision loop, operators, or procedure memory.\n");
  emit("=== done ===\n");
  return 0;
}

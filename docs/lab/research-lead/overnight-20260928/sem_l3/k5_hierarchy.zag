// k5_hierarchy.zag — Test hierarchical abstraction.
// Sparrow-like and eagle-like entities. Can the unifier invent "flying creature"?

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }

fn fact(s:[]u8, r:[]u8, o:[]u8)void {
  emit("T ");
  emit(s); emit(" | "); emit(r); emit(" | "); emit(o);
  emit("\n");
  return;
}
fn probe(s:[]u8, r:[]u8, e:[]u8)void {
  emit("Q ");
  emit(s); emit(" | "); emit(r); emit(" | "); emit(e);
  emit("\n");
  return;
}

fn main()i32 {
  // Sparrow-like: S1/s1, S2/s2
  // Shared: flies->yes. Distinct: size->small, eats->seeds.
  fact("S1", "flies", "yes");
  fact("s1", "flies", "yes");
  fact("S1", "size", "small");
  fact("s1", "size", "small");
  fact("S1", "eats", "seeds");
  fact("s1", "eats", "seeds");
  fact("S2", "flies", "yes");
  fact("s2", "flies", "yes");
  fact("S2", "size", "small");
  fact("s2", "size", "small");
  fact("S2", "eats", "seeds");
  fact("s2", "eats", "seeds");

  // Eagle-like: E1/e1, E2/e2
  // Shared: flies->yes. Distinct: size->large, eats->meat.
  fact("E1", "flies", "yes");
  fact("e1", "flies", "yes");
  fact("E1", "size", "large");
  fact("e1", "size", "large");
  fact("E1", "eats", "meat");
  fact("e1", "eats", "meat");
  fact("E2", "flies", "yes");
  fact("e2", "flies", "yes");
  fact("E2", "size", "large");
  fact("e2", "size", "large");
  fact("E2", "eats", "meat");
  fact("e2", "eats", "meat");

  // Probes:
  // 1. Within-level: should work via flat unification.
  probe("s1", "eats", "seeds");      // via S1~s1
  probe("e1", "size", "large");      // via E1~e1
  // 2. Cross-level (hierarchy): novel flying creature?
  // Teach a new entity N1 with only (N1, flies, yes).
  // Can the learner infer it's a "flying creature" and predict it might eat something?
  // Actually, the hierarchy test: after learning, present (N1, flies, yes).
  // The "flying" abstraction should allow... hmm, what?
  //
  // Simpler hierarchy probe: If S1~s1 and E1~e1 are separate concepts,
  // is there a HIGHER concept containing all four? The current mechanism
  // cannot represent this. We test by checking if S1 and E1 get merged
  // (they shouldn't, Jaccard too low), and if any "flies" abstraction emerges.
  //
  // Probe: (S1, flies, ?) -> yes (taught, control)
  // Probe: (E1, flies, ?) -> yes (taught, control)
  // The hierarchy would be: a node representing {S1,s1,S2,s2,E1,e1,E2,e2} via "flies".
  // Current mechanism: Jaccard(S1,E1) = 1/5 = 0.2 < 0.5, no merge. No hierarchy.

  probe("S1", "flies", "yes");
  probe("E1", "flies", "yes");

  emit("# k5 done\n");
  return 0;
}

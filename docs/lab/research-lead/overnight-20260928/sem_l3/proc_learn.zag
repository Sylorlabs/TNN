// proc_learn.zag — Procedure invention via compositional index-program search.
// v1: Complete implementation.
//
// H-PROC: Learner invents string-transformation procedures.
// Method:
//   1. Extract index sequences from (input, output) examples.
//   2. Enumerate compositional index programs (K,N,C0,C1,C2,ADD,SUB) up to size 5.
//   3. Select smallest program reproducing all sequences.
//   4. Apply to novel inputs.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}

// Get i32 from byte array at offset (little-endian)
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
// Set i32 in byte array at offset
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// Program representation:
// Each program is a list of nodes. Node: [type(1 byte), left(1 byte), right(1 byte)]
// Types: 0=K, 1=N, 2=C0, 3=C1, 4=C2, 5=ADD, 6=SUB
// For terminals, left=right=255.
// Root is last node.

// Evaluate program at (k, n). prog: byte array, nnodes: count.
fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  // Recursive evaluation using explicit stack to avoid recursion depth issues.
  // Simpler: evaluate recursively since depth <= 5.
  return eval_node(prog, nnodes-1, k, n);
}

fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}

// Extract index sequence. Returns length, or -1 if ambiguous.
// seq: byte array to fill (i32 per entry).
fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

// Check if program fits a sequence.
// seq: i32 array (as bytes), seqlen: length, n: input length.
fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

// Build a program in buf. Returns node count.
// We'll generate systematically.

// Program enumeration.
// We generate programs by size:
// Size 1: K(0), N(1), C0(2), C1(3), C2(4) — 5 programs
// Size 3: ADD(a,b), SUB(a,b) where a,b are size-1 — 2*5*5=50 programs
// Size 5: ADD(a,b), SUB(a,b) where (a size-1, b size-3) or (a size-3, b size-1)
//         — 2*(5*50 + 50*5) = 1000 programs
// Total: 1055 programs.
//
// Storage: prog_store is a big byte array. Each program recorded as:
//   [nnodes(1 byte), nodes...] where each node is 3 bytes.
// prog_index[i] = offset of program i in prog_store.

// Add a terminal program. Returns program index.
fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;  // nnodes
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

// Add a binary-op program. left_prog and right_prog are program indices.
// We copy their nodes and add a new root.
fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;

  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  // Copy left nodes
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  // Copy right nodes, adjusting child indices by left_n
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  // Add root: op(left_root, right_root)
  // left_root = left_n-1, right_root = left_n + (right_n-1)
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

// Get program node count and pointer
fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  // Return slice starting at nodes (skip nnodes byte)
  // For simplicity, we'll pass off+1 and nnodes separately to eval.
  return prog_store[off+1..off+1+ (prog_store[off] as i32)*3];
}

fn main()i32 {
  emit("=== proc_learn v1 ===\n");

  // Training pairs for Family X (broadcast-last) - training-data substitution
  let seq_buf:[]u8=z_alloc(16*4);

  let inp0:[]u8="abc";
  let out0:[]u8="ccc";
  let len0:i32=extract_seq(inp0, out0, seq_buf);
  emit("seq0: [");
  let i:i32=0;
  while(i<len0){
    if(i>0){emit(",");}
    emit(i32s(get32(seq_buf, i*4)));
    i=i+1;
  }
  emit("] n=3\n");

  let inp1:[]u8="xy";
  let out1:[]u8="yy";
  let seq_buf1:[]u8=z_alloc(16*4);
  let len1:i32=extract_seq(inp1, out1, seq_buf1);
  emit("seq1: [");
  i=0;
  while(i<len1){
    if(i>0){emit(",");}
    emit(i32s(get32(seq_buf1, i*4)));
    i=i+1;
  }
  emit("] n=2\n");

  let inp2:[]u8="defg";
  let out2:[]u8="gggg";
  let seq_buf2:[]u8=z_alloc(16*4);
  let len2:i32=extract_seq(inp2, out2, seq_buf2);
  emit("seq2: [");
  i=0;
  while(i<len2){
    if(i>0){emit(",");}
    emit(i32s(get32(seq_buf2, i*4)));
    i=i+1;
  }
  emit("] n=4\n");

  // Enumerate programs
  // prog_store: 200KB should be enough (1055 progs * ~16 bytes avg)
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);  // up to 1200 programs
  let pcount:i32=0;
  let store_off:i32=0;

  // Size 1: terminals
  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1;
    t=t+1;
  }
  let size1_end:i32=pcount;
  emit("size-1 programs: ");
  emit(i32s(size1_end));
  emit("\n");

  // Size 3: op(a,b) where a,b in size-1
  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;
  emit("size-3 programs: ");
  emit(i32s(size3_end - size1_end));
  emit(" (total ");
  emit(i32s(pcount));
  emit(")\n");

  // Size 5: op(a,b) where (a size-1, b size-3) or (a size-3, b size-1)
  op=5;
  while(op<7){
    // a size-1, b size-3
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    // a size-3, b size-1
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  emit("size-5 programs: ");
  emit(i32s(pcount - size3_end));
  emit(" (total ");
  emit(i32s(pcount));
  emit(")\n");

  // Search: find smallest program fitting all training sequences.
  // Training: seq_buf (n=3, [2,2,2]), seq_buf1 (n=2, [1,1]), seq_buf2 (n=4, [3,3,3,3])
  let found_pi:i32=-1;
  let pi:i32=0;
  let tmp_nnodes:[]u8=z_alloc(1);
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp_nnodes);
    let nnodes:i32=tmp_nnodes[0] as i32;
    // Check against seq0 (n=3)
    let fits0:i32=prog_fits(prog, nnodes, seq_buf, len0, 3);
    if(fits0==1){
      // Check against seq1 (n=2)
      let fits1:i32=prog_fits(prog, nnodes, seq_buf1, len1, 2);
      if(fits1==1){
        // Check against seq2 (n=4)
        let fits2:i32=prog_fits(prog, nnodes, seq_buf2, len2, 4);
        if(fits2==1){
          found_pi=pi;
          pi=pcount;  // break (first/smallest found)
        }
      }
    }
    pi=pi+1;
  }

  if(found_pi<0){
    emit("NO PROGRAM FOUND\n");
    return 1;
  }

  emit("found program index: ");
  emit(i32s(found_pi));
  emit("\n");

  // Print the program
  let fprog:[]u8=get_prog(prog_store, prog_index, found_pi, tmp_nnodes);
  let fnnodes:i32=tmp_nnodes[0] as i32;
  emit("program nodes: ");
  emit(i32s(fnnodes));
  emit(" [");
  i=0;
  while(i<fnnodes){
    if(i>0){emit(" ");}
    let tt:i32=fprog[i*3] as i32;
    if(tt==0){emit("K");}
    else if(tt==1){emit("N");}
    else if(tt==2){emit("C0");}
    else if(tt==3){emit("C1");}
    else if(tt==4){emit("C2");}
    else if(tt==5){emit("ADD");}
    else if(tt==6){emit("SUB");}
    i=i+1;
  }
  emit("]\n");

  // Apply to hidden test: "hello" (n=5) should give [4,3,2,1,0]
  emit("apply to n=5: [");
  let k:i32=0;
  while(k<5){
    if(k>0){emit(",");}
    let idx:i32=eval_prog(fprog, fnnodes, k, 5);
    emit(i32s(idx));
    k=k+1;
  }
  emit("]\n");

  // Apply to "zag" -> should be "gaz"
  // Build output string using program
  let test_in:[]u8="zag";
  let test_n:i32=test_in.len;
  let test_out:[]u8=z_alloc(test_n+1);
  k=0;
  while(k<test_n){
    let idx:i32=eval_prog(fprog, fnnodes, k, test_n);
    if(idx<0 || idx>=test_n){
      emit("ERROR: index out of bounds\n");
      return 1;
    }
    test_out[k]=test_in[idx];
    k=k+1;
  }
  emit("zag -> ");
  emit(test_out[0..test_n]);
  emit("\n");

  // More hidden tests for reverse (PI-1a)
  emit("\n=== PI-1a hidden tests ===\n");
  let hidden_tests:i32=0;
  let hidden_pass:i32=0;

  // Test 1: "hello" -> "olleh"
  let h1_in:[]u8="hello"; let h1_exp:[]u8="olleh";
  let h1_out:[]u8=z_alloc(6);
  k=0; while(k<5){ h1_out[k]=h1_in[eval_prog(fprog, fnnodes, k, 5)]; k=k+1; }
  hidden_tests=hidden_tests+1;
  if(streq(h1_out[0..5], h1_exp)==1){ hidden_pass=hidden_pass+1; emit("hello->olleh PASS\n"); }
  else { emit("hello->olleh FAIL\n"); }

  // Test 2: "12345" -> "54321"
  let h2_in:[]u8="12345"; let h2_exp:[]u8="54321";
  let h2_out:[]u8=z_alloc(6);
  k=0; while(k<5){ h2_out[k]=h2_in[eval_prog(fprog, fnnodes, k, 5)]; k=k+1; }
  hidden_tests=hidden_tests+1;
  if(streq(h2_out[0..5], h2_exp)==1){ hidden_pass=hidden_pass+1; emit("12345->54321 PASS\n"); }
  else { emit("12345->54321 FAIL\n"); }

  // Test 3: "q" -> "q" (single char, K-P5)
  let h3_in:[]u8="q"; let h3_exp:[]u8="q";
  let h3_out:[]u8=z_alloc(2);
  k=0; while(k<1){ h3_out[k]=h3_in[eval_prog(fprog, fnnodes, k, 1)]; k=k+1; }
  hidden_tests=hidden_tests+1;
  if(streq(h3_out[0..1], h3_exp)==1){ hidden_pass=hidden_pass+1; emit("q->q PASS\n"); }
  else { emit("q->q FAIL\n"); }

  emit("PI-1a hidden: ");
  emit(i32s(hidden_pass));
  emit("/");
  emit(i32s(hidden_tests));
  emit("\n");

  // PI-1b: Identity test (K-P1: prove not reverse-specific)
  // Train on identity examples, should find program "K"
  emit("\n=== PI-1b: identity ===\n");
  let id_in0:[]u8="abc";
  let id_out0:[]u8="abc";
  let id_seq0:[]u8=z_alloc(16*4);
  let id_len0:i32=extract_seq(id_in0, id_out0, id_seq0);
  emit("identity seq0: [");
  i=0;
  while(i<id_len0){
    if(i>0){emit(",");}
    emit(i32s(get32(id_seq0, i*4)));
    i=i+1;
  }
  emit("] n=3\n");

  // Search for identity program
  let id_found:i32=-1;
  pi=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp_nnodes);
    let nn:i32=tmp_nnodes[0] as i32;
    let f0:i32=prog_fits(prog, nn, id_seq0, id_len0, 3);
    if(f0==1){
      id_found=pi;
      pi=pcount;
    }
    pi=pi+1;
  }
  if(id_found>=0){
    let iprog:[]u8=get_prog(prog_store, prog_index, id_found, tmp_nnodes);
    let inn:i32=tmp_nnodes[0] as i32;
    emit("identity program found: index ");
    emit(i32s(id_found));
    emit(", nodes ");
    emit(i32s(inn));
    emit(" [");
    i=0;
    while(i<inn){
      if(i>0){emit(" ");}
      let tt:i32=iprog[i*3] as i32;
      if(tt==0){emit("K");}
      else if(tt==1){emit("N");}
      else if(tt==2){emit("C0");}
      else if(tt==3){emit("C1");}
      else if(tt==4){emit("C2");}
      else if(tt==5){emit("ADD");}
      else if(tt==6){emit("SUB");}
      i=i+1;
    }
    emit("]\n");
    // Test: "hello" -> "hello"
    let hid_in:[]u8="hello";
    let hid_n:i32=hid_in.len;
    let hid_out:[]u8=z_alloc(hid_n+1);
    let kk:i32=0;
    while(kk<hid_n){
      let idx:i32=eval_prog(iprog, inn, kk, hid_n);
      hid_out[kk]=hid_in[idx];
      kk=kk+1;
    }
    emit("hello -> ");
    emit(hid_out[0..hid_n]);
    if(streq(hid_out[0..hid_n], "hello")==1){
      emit(" CORRECT\n");
    } else {
      emit(" WRONG\n");
    }
  } else {
    emit("identity: NO PROGRAM FOUND\n");
  }

  emit("=== done ===\n");
  return 0;
}

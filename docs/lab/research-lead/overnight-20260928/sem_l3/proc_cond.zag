// proc_cond.zag — Content-conditional procedure discovery.
// v1: Extends proc_learn.zag with IF(input[0]==v, A, B) programs.
//
// H-CC: Search directly finds content-conditional programs.
// - Base programs: 1055 (unchanged), P(k,n) -> index.
// - Conditional: IF(EQ0(v), A, B), P(k,n,input) -> index.
// - Branches A,B limited to size <= 3 (55 programs).
// - Candidate v: distinct bytes at position 0 in training inputs.
// - Two-phase search: base first (prevents hallucination), then conditional.
//
// Pure Zag. No Python.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i32s(v:i32)[]u8 {
  return _zag_i64_to_str(v as i64);
}
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}

// === Base program machinery (from proc_learn.zag, unchanged) ===
// Node types: 0=K, 1=N, 2=C0, 3=C1, 4=C2, 5=ADD, 6=SUB

fn eval_node(prog:[]u8, idx:i32, k:i32, n:i32)i32 {
  let base:i32=idx*3;
  let t:i32=prog[base] as i32;
  if(t==0){return k;}
  if(t==1){return n;}
  if(t==2){return 0;}
  if(t==3){return 1;}
  if(t==4){return 2;}
  if(t==5 || t==6){
    let l:i32=prog[base+1] as i32;
    let r:i32=prog[base+2] as i32;
    let a:i32=eval_node(prog, l, k, n);
    let b:i32=eval_node(prog, r, k, n);
    if(t==5){return a+b;}
    return a-b;
  }
  return -9999;
}

fn eval_prog(prog:[]u8, nnodes:i32, k:i32, n:i32)i32 {
  return eval_node(prog, nnodes-1, k, n);
}

fn extract_seq(inp:[]u8, out:[]u8, seq:[]u8)i32 {
  let k:i32=0;
  while(k<out.len){
    let c:u8=out[k];
    let found:i32=-1;
    let cnt:i32=0;
    let j:i32=0;
    while(j<inp.len){
      if(inp[j]==c){found=j; cnt=cnt+1;}
      j=j+1;
    }
    if(cnt!=1){return -1;}
    set32(seq, k*4, found);
    k=k+1;
  }
  return out.len;
}

fn prog_fits(prog:[]u8, nnodes:i32, seq:[]u8, seqlen:i32, n:i32)i32 {
  let k:i32=0;
  while(k<seqlen){
    let expected:i32=get32(seq, k*4);
    let got:i32=eval_prog(prog, nnodes, k, n);
    if(got!=expected){return 0;}
    k=k+1;
  }
  return 1;
}

fn add_term(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, term_type:i32)i32 {
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=1 as u8;
  prog_store[store_off+1]=term_type as u8;
  prog_store[store_off+2]=255 as u8;
  prog_store[store_off+3]=255 as u8;
  return store_off+4;
}

fn add_binop(prog_store:[]u8, prog_index:[]u8, pcount:i32, store_off:i32, op:i32, left_pi:i32, right_pi:i32)i32 {
  let left_off:i32=get32(prog_index, left_pi*4);
  let right_off:i32=get32(prog_index, right_pi*4);
  let left_n:i32=prog_store[left_off] as i32;
  let right_n:i32=prog_store[right_off] as i32;
  let total_n:i32=left_n+right_n+1;
  set32(prog_index, pcount*4, store_off);
  prog_store[store_off]=total_n as u8;
  let dst:i32=store_off+1;
  let i:i32=0;
  while(i<left_n){
    prog_store[dst]=prog_store[left_off+1+i*3];
    prog_store[dst+1]=prog_store[left_off+1+i*3+1];
    prog_store[dst+2]=prog_store[left_off+1+i*3+2];
    dst=dst+3; i=i+1;
  }
  i=0;
  while(i<right_n){
    let t:i32=prog_store[right_off+1+i*3] as i32;
    let l:i32=prog_store[right_off+1+i*3+1] as i32;
    let r:i32=prog_store[right_off+1+i*3+2] as i32;
    prog_store[dst]=t as u8;
    if(l==255){prog_store[dst+1]=255 as u8;} else {prog_store[dst+1]=(l+left_n) as u8;}
    if(r==255){prog_store[dst+2]=255 as u8;} else {prog_store[dst+2]=(r+left_n) as u8;}
    dst=dst+3; i=i+1;
  }
  prog_store[dst]=op as u8;
  prog_store[dst+1]=(left_n-1) as u8;
  prog_store[dst+2]=(left_n+right_n-1) as u8;
  dst=dst+3;
  return dst;
}

fn get_prog(prog_store:[]u8, prog_index:[]u8, pi:i32, out_nnodes:[]u8)[]u8 {
  let off:i32=get32(prog_index, pi*4);
  out_nnodes[0]=prog_store[off];
  return prog_store[off+1..off+1+(prog_store[off] as i32)*3];
}

// === Conditional program machinery (NEW) ===
// Conditional program: [pred_val(1), then_pi(2), else_pi(2)] = 5 bytes each.
// Stored in cond_store, indexed by cond_index.

// Evaluate conditional program.
// Returns index, or -9999 on error.
fn eval_cond(prog_store:[]u8, prog_index:[]u8, pred_val:u8, then_pi:i32, else_pi:i32,
             inp:[]u8, k:i32, n:i32, tmp:[]u8)i32 {
  let cond:i32=0;
  if(inp.len>0 && inp[0]==pred_val){cond=1;}
  let use_pi:i32=else_pi;
  if(cond==1){use_pi=then_pi;}
  let prog:[]u8=get_prog(prog_store, prog_index, use_pi, tmp);
  let nnodes:i32=tmp[0] as i32;
  return eval_prog(prog, nnodes, k, n);
}

// Check if conditional program fits all training sequences.
// seqs: array of seq buffers, seq_lens: array of lengths, ns: array of n values,
// inps: array of input buffers (for predicate evaluation).
// We pass these as flat arrays with a count.
fn cond_fits(prog_store:[]u8, prog_index:[]u8, pred_val:u8, then_pi:i32, else_pi:i32,
             seq_data:[]u8, seq_lens:[]u8, seq_ns:[]u8, inp_data:[]u8, inp_lens:[]u8,
             nseq:i32, tmp:[]u8)i32 {
  let s:i32=0;
  while(s<nseq){
    let seqlen:i32=get32(seq_lens, s*4);
    if(seqlen<0){return 0;}  // extraction failed, can't fit
    let n:i32=get32(seq_ns, s*4);
    let inplen:i32=get32(inp_lens, s*4);
    // Get seq buffer (16*4 bytes each, at s*64)
    // Get inp buffer (we'll store inputs separately)
    let k:i32=0;
    while(k<seqlen){
      let expected:i32=get32(seq_data, s*64 + k*4);
      // Get input for this sequence
      let inp_off:i32=s*32;  // inputs stored at 32 bytes each
      let inp:[]u8=inp_data[inp_off..inp_off+inplen];
      let got:i32=eval_cond(prog_store, prog_index, pred_val, then_pi, else_pi,
                            inp, k, n, tmp);
      if(got!=expected){return 0;}
      k=k+1;
    }
    s=s+1;
  }
  return 1;
}

fn main()i32 {
  emit("=== proc_cond v1 (H-CC) ===\n");

  // Enumerate base programs (same as proc_learn.zag)
  let prog_store:[]u8=z_alloc(200000);
  let prog_index:[]u8=z_alloc(1200*4);
  let pcount:i32=0;
  let store_off:i32=0;

  let t:i32=0;
  while(t<5){
    store_off=add_term(prog_store, prog_index, pcount, store_off, t);
    pcount=pcount+1;
    t=t+1;
  }
  let size1_end:i32=pcount;

  let op:i32=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }
  let size3_end:i32=pcount;

  op=5;
  while(op<7){
    let a:i32=0;
    while(a<size1_end){
      let b:i32=size1_end;
      while(b<size3_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    a=size1_end;
    while(a<size3_end){
      let b:i32=0;
      while(b<size1_end){
        store_off=add_binop(prog_store, prog_index, pcount, store_off, op, a, b);
        pcount=pcount+1;
        b=b+1;
      }
      a=a+1;
    }
    op=op+1;
  }

  emit("base programs: ");
  emit(i32s(pcount));
  emit(" (size1: ");
  emit(i32s(size1_end));
  emit(", size3: ");
  emit(i32s(size3_end));
  emit(")\n");

  // === Test 1: H-REVISE counterexample ===
  emit("\n=== Test 1: H-REVISE (content-conditional) ===\n");

  // Training data
  // We store: seq buffers (64 bytes each), inputs (32 bytes each)
  let seq_data:[]u8=z_alloc(4*64);
  let seq_lens:[]u8=z_alloc(4*4);
  let seq_ns:[]u8=z_alloc(4*4);
  let inp_data:[]u8=z_alloc(4*32);
  let inp_lens:[]u8=z_alloc(4*4);
  let nseq:i32=4;

  // Seq 0: "abc" -> "ccc" (broadcast-last)
  let i0:[]u8="abc"; let o0:[]u8="ccc";
  let l0:i32=extract_seq(i0, o0, seq_data[0..64]);
  set32(seq_lens, 0, l0); set32(seq_ns, 0, 3); set32(inp_lens, 0, 3);
  let ii:i32=0; while(ii<3){inp_data[ii]=i0[ii]; ii=ii+1;}

  // Seq 1: "def" -> "fff" (broadcast-last, non-x first char)
  let i1:[]u8="def"; let o1:[]u8="fff";
  let l1:i32=extract_seq(i1, o1, seq_data[64..128]);
  set32(seq_lens, 4, l1); set32(seq_ns, 4, 3); set32(inp_lens, 4, 3);
  ii=0; while(ii<3){inp_data[32+ii]=i1[ii]; ii=ii+1;}

  // Seq 2: "defg" -> "gggg" (broadcast-last)
  let i2:[]u8="defg"; let o2:[]u8="gggg";
  let l2:i32=extract_seq(i2, o2, seq_data[128..192]);
  set32(seq_lens, 8, l2); set32(seq_ns, 8, 4); set32(inp_lens, 8, 4);
  ii=0; while(ii<4){inp_data[64+ii]=i2[ii]; ii=ii+1;}

  // Seq 3: "xab" -> "xxx" (broadcast-first, counterexample: starts with 'x')
  let i3:[]u8="xab"; let o3:[]u8="xxx";
  let l3:i32=extract_seq(i3, o3, seq_data[192..256]);
  set32(seq_lens, 12, l3); set32(seq_ns, 12, 3); set32(inp_lens, 12, 3);
  ii=0; while(ii<3){inp_data[96+ii]=i3[ii]; ii=ii+1;}

  emit("seq lens: ");
  emit(i32s(l0)); emit(","); emit(i32s(l1)); emit(","); emit(i32s(l2)); emit(","); emit(i32s(l3));
  emit("\n");

  // Extract candidate predicate values: distinct bytes at position 0
  let cand_vals:[]u8=z_alloc(32);
  let ncand:i32=0;
  let s:i32=0;
  while(s<nseq){
    let ilen:i32=get32(inp_lens, s*4);
    if(ilen>0){
      let v:u8=inp_data[s*32];
      // Check if already in list
      let found:i32=0;
      let c:i32=0;
      while(c<ncand){
        if(cand_vals[c]==v){found=1;}
        c=c+1;
      }
      if(found==0){
        cand_vals[ncand]=v;
        ncand=ncand+1;
      }
    }
    s=s+1;
  }
  emit("candidate predicate values (");
  emit(i32s(ncand));
  emit("): [");
  s=0;
  while(s<ncand){
    if(s>0){emit(",");}
    emit(i32s(cand_vals[s] as i32));
    s=s+1;
  }
  emit("]\n");

  // Phase 1: Search base programs
  emit("\nPhase 1: searching base programs...\n");
  let tmp:[]u8=z_alloc(1);
  let found_base:i32=-1;
  let pi:i32=0;
  // We need a helper to check base program against all seqs with inputs
  // For base programs, predicate is irrelevant; just check P(k,n) fits.
  // But seqs have different n values. We'll check each.
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp);
    let nnodes:i32=tmp[0] as i32;
    let all_fit:i32=1;
    s=0;
    while(s<nseq){
      let seqlen:i32=get32(seq_lens, s*4);
      let n:i32=get32(seq_ns, s*4);
      if(seqlen<0){all_fit=0;}
      else {
        let k:i32=0;
        while(k<seqlen){
          let expected:i32=get32(seq_data, s*64+k*4);
          let got:i32=eval_prog(prog, nnodes, k, n);
          if(got!=expected){all_fit=0; k=seqlen;}  // break inner
          k=k+1;
        }
      }
      if(all_fit==0){s=nseq;}  // break outer
      s=s+1;
    }
    if(all_fit==1){
      found_base=pi;
      pi=pcount;  // break
    }
    pi=pi+1;
  }

  if(found_base>=0){
    emit("Phase 1: BASE PROGRAM FOUND at index ");
    emit(i32s(found_base));
    emit(" (unexpected for H-REVISE!)\n");
  } else {
    emit("Phase 1: NO BASE PROGRAM (expected for H-REVISE)\n");
  }

  // Phase 2: Search conditional programs (only if Phase 1 failed)
  let found_cond:i32=0;
  let found_pred:u8=0;
  let found_then:i32=-1;
  let found_else:i32=-1;

  if(found_base<0){
    emit("\nPhase 2: searching conditional programs...\n");
    // Count total conditionals for K-CC1
    let total_cond:i32=ncand * size3_end * size3_end;
    emit("total conditional programs: ");
    emit(i32s(total_cond));
    emit("\n");
    emit("total programs (base+cond): ");
    emit(i32s(pcount + total_cond));
    emit("\n");

    // Search: for each pred_val, for each then_pi (size<=3), for each else_pi (size<=3)
    // Order by (then_size + else_size) for simplicity: iterate then, else in order
    // (size-1 programs first, then size-3)
    let ci:i32=0;
    let done:i32=0;
    while(ci<ncand && done==0){
      let pv:u8=cand_vals[ci];
      let ta:i32=0;
      while(ta<size3_end && done==0){
        let ea:i32=0;
        while(ea<size3_end && done==0){
          let fits:i32=cond_fits(prog_store, prog_index, pv, ta, ea,
                                 seq_data, seq_lens, seq_ns, inp_data, inp_lens,
                                 nseq, tmp);
          if(fits==1){
            found_cond=1;
            found_pred=pv;
            found_then=ta;
            found_else=ea;
            done=1;
          }
          ea=ea+1;
        }
        ta=ta+1;
      }
      ci=ci+1;
    }

    if(found_cond==1){
      emit("Phase 2: CONDITIONAL FOUND\n");
      emit("  pred: input[0]==");
      emit(i32s(found_pred as i32));
      emit(" ('");
      // Print char if printable
      let cb:[]u8=z_alloc(2);
      cb[0]=found_pred;
      emit(cb[0..1]);
      emit("')\n");
      emit("  then_pi: ");
      emit(i32s(found_then));
      emit(", else_pi: ");
      emit(i32s(found_else));
      emit("\n");
      // Print branch programs
      let tp:[]u8=get_prog(prog_store, prog_index, found_then, tmp);
      let tn:i32=tmp[0] as i32;
      emit("  then: [");
      let j:i32=0;
      while(j<tn){
        if(j>0){emit(" ");}
        let tt:i32=tp[j*3] as i32;
        if(tt==0){emit("K");} else if(tt==1){emit("N");}
        else if(tt==2){emit("C0");} else if(tt==3){emit("C1");}
        else if(tt==4){emit("C2");} else if(tt==5){emit("ADD");}
        else if(tt==6){emit("SUB");}
        j=j+1;
      }
      emit("]\n");
      let ep:[]u8=get_prog(prog_store, prog_index, found_else, tmp);
      let en:i32=tmp[0] as i32;
      emit("  else: [");
      j=0;
      while(j<en){
        if(j>0){emit(" ");}
        let tt:i32=ep[j*3] as i32;
        if(tt==0){emit("K");} else if(tt==1){emit("N");}
        else if(tt==2){emit("C0");} else if(tt==3){emit("C1");}
        else if(tt==4){emit("C2");} else if(tt==5){emit("ADD");}
        else if(tt==6){emit("SUB");}
        j=j+1;
      }
      emit("]\n");
    } else {
      emit("Phase 2: NO CONDITIONAL FOUND\n");
    }
  }

  // === Test 2: Pure reverse (K-CC3, K-CC4) ===
  emit("\n=== Test 2: Pure reverse (no conditional expected) ===\n");
  let r_seq:[]u8=z_alloc(64);
  let ri:[]u8="abc"; let ro:[]u8="cba";
  let rl:i32=extract_seq(ri, ro, r_seq);
  emit("reverse seq len: ");
  emit(i32s(rl));
  emit("\n");
  // Search base only
  let r_found:i32=-1;
  pi=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp);
    let nnodes:i32=tmp[0] as i32;
    let k:i32=0;
    let fits:i32=1;
    while(k<rl){
      let expected:i32=get32(r_seq, k*4);
      let got:i32=eval_prog(prog, nnodes, k, 3);
      if(got!=expected){fits=0; k=rl;}
      k=k+1;
    }
    if(fits==1){r_found=pi; pi=pcount;}
    pi=pi+1;
  }
  if(r_found>=0){
    emit("reverse: BASE FOUND at ");
    emit(i32s(r_found));
    emit(" (K-CC4 PASS: no hallucination)\n");
  } else {
    emit("reverse: NO BASE (K-CC3 FAIL: regression!)\n");
  }

  // === Test 3: Pure broadcast-last (K-CC3, K-CC4) ===
  emit("\n=== Test 3: Pure broadcast-last (no conditional expected) ===\n");
  let b_seq:[]u8=z_alloc(64);
  let bi:[]u8="abc"; let bo:[]u8="ccc";
  let bl:i32=extract_seq(bi, bo, b_seq);
  let b_found:i32=-1;
  pi=0;
  while(pi<pcount){
    let prog:[]u8=get_prog(prog_store, prog_index, pi, tmp);
    let nnodes:i32=tmp[0] as i32;
    let k:i32=0;
    let fits:i32=1;
    while(k<bl){
      let expected:i32=get32(b_seq, k*4);
      let got:i32=eval_prog(prog, nnodes, k, 3);
      if(got!=expected){fits=0; k=bl;}
      k=k+1;
    }
    if(fits==1){b_found=pi; pi=pcount;}
    pi=pi+1;
  }
  if(b_found>=0){
    emit("broadcast-last: BASE FOUND at ");
    emit(i32s(b_found));
    emit(" (K-CC4 PASS)\n");
  } else {
    emit("broadcast-last: NO BASE (K-CC3 FAIL)\n");
  }

  // === Summary ===
  emit("\n=== KILL BAR SUMMARY ===\n");
  // K-CC1: computed above
  // K-CC2: found_cond==1
  // K-CC3: r_found>=0 && b_found>=0
  // K-CC4: r_found>=0 (found base, not conditional) && b_found>=0
  emit("K-CC1 (tractable <100k): ");
  let total_all:i32=pcount + ncand * size3_end * size3_end;
  if(total_all<100000){emit("PASS ("); emit(i32s(total_all)); emit(")\n");}
  else {emit("FAIL ("); emit(i32s(total_all)); emit(")\n");}

  emit("K-CC2 (finds conditional): ");
  if(found_cond==1){emit("PASS\n");} else {emit("FAIL\n");}

  emit("K-CC3 (no regression): ");
  if(r_found>=0 && b_found>=0){emit("PASS\n");} else {emit("FAIL\n");}

  emit("K-CC4 (no hallucination): ");
  // Both found base programs in Phase 1 (we didn't even run Phase 2 for them)
  if(r_found>=0 && b_found>=0){emit("PASS\n");} else {emit("FAIL\n");}

  emit("=== done ===\n");
  return 0;
}

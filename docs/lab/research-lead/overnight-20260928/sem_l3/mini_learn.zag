// mini_learn.zag — Minimal SEM-L3 learner: consequence-anchored unification.
// Reads world.txt (T facts, Q probes). Builds signatures, unifies surfaces,
// answers probes via concept nodes.
//
// Usage: mini_learn < world.txt
// Output: concept nodes, then probe answers.

// --- basic utils ---
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}

// --- storage ---
// Surfaces: up to 64 unique, each up to 32 bytes.
// Facts: up to 128 triples (si, ri, oi) as surface indices.
// Signatures: for each surface, list of (ri, oi) pair indices.

fn main()i32 {
  let path:[]u8=_zag_arg(1);
  if(path.len==0){ emit("usage: mini_learn world.txt\n"); return 1; }
  let input:[]u8=read_file(path);
  if(input.len==0){ emit("no input\n"); return 1; }

  // Surface table
  let surf:[]u8=z_alloc(64*32);
  let nsurf:i32=0;
  // Facts: si, ri, oi (i32 each, 128 max)
  let fsi:[]u8=z_alloc(128*4);
  let fri:[]u8=z_alloc(128*4);
  let foi:[]u8=z_alloc(128*4);
  let nfact:i32=0;

  // Parse lines
  let at:i32=0;
  let n:i32=input.len;
  while(at<n){
    let en:i32=at;
    while(en<n && input[en]!=10){en=en+1;}
    if(en>at){
      let line:[]u8=input[at..en];
      // T line: "T subj | rel | obj"
      // Q line: "Q TYPE subj | rel | expected"
      if(line.len>2 && line[0]==84){ // 'T'
        // parse "T s | r | o"
        let p1:i32=2;
        while(p1<line.len && line[p1]!=124){p1=p1+1;} // '|'
        let p2:i32=p1+1;
        while(p2<line.len && line[p2]!=124){p2=p2+1;}
        let s:[]u8=line[2..p1-1];
        let r:[]u8=line[p1+2..p2-1];
        let o:[]u8=line[p2+2..line.len];
        // intern surfaces
        let si:i32=0; let fi:i32=-1;
        let k:i32=0;
        while(k<nsurf){
          let base:i32=k*32;
          let e:i32=base;
          while(e<base+32 && surf[e]!=0){e=e+1;}
          if(streq(surf[base..e], s)==1){ fi=k; }
          k=k+1;
        }
        if(fi<0){ fi=nsurf; let base:i32=fi*32; let j:i32=0; while(j<s.len && j<32){surf[base+j]=s[j]; j=j+1;} nsurf=nsurf+1; }
        si=fi;
        // rel
        fi=-1; k=0;
        while(k<nsurf){
          let base:i32=k*32;
          let e:i32=base;
          while(e<base+32 && surf[e]!=0){e=e+1;}
          if(streq(surf[base..e], r)==1){ fi=k; }
          k=k+1;
        }
        if(fi<0){ fi=nsurf; let base:i32=fi*32; let j:i32=0; while(j<r.len && j<32){surf[base+j]=r[j]; j=j+1;} nsurf=nsurf+1; }
        let ri:i32=fi;
        // obj
        fi=-1; k=0;
        while(k<nsurf){
          let base:i32=k*32;
          let e:i32=base;
          while(e<base+32 && surf[e]!=0){e=e+1;}
          if(streq(surf[base..e], o)==1){ fi=k; }
          k=k+1;
        }
        if(fi<0){ fi=nsurf; let base:i32=fi*32; let j:i32=0; while(j<o.len && j<32){surf[base+j]=o[j]; j=j+1;} nsurf=nsurf+1; }
        let oi:i32=fi;
        // store fact
        let fb:i32=nfact*4;
        fsi[fb]=si as u8; fsi[fb+1]=(si>>8) as u8; fsi[fb+2]=(si>>16) as u8; fsi[fb+3]=(si>>24) as u8;
        fri[fb]=ri as u8; fri[fb+1]=(ri>>8) as u8; fri[fb+2]=(ri>>16) as u8; fri[fb+3]=(ri>>24) as u8;
        foi[fb]=oi as u8; foi[fb+1]=(oi>>8) as u8; foi[fb+2]=(oi>>16) as u8; foi[fb+3]=(oi>>24) as u8;
        nfact=nfact+1;
      }
    }
    at=en+1;
  }

  emit("parsed "); emit(i64s(nsurf)); emit(" surfaces, ");
  emit(i64s(nfact)); emit(" facts\n");

  // Build signatures: for each surface si, set of (ri, oi) pairs.
  // Represent as: sig_pairs[si] = list of (ri*64+oi) encoded, up to 32 per surface.
  let sig:[]u8=z_alloc(64*32*4);
  let sign:[]u8=z_alloc(64*4);
  let f:i32=0;
  while(f<nfact){
    let fb:i32=f*4;
    let si:i32=(fsi[fb] as i32)|((fsi[fb+1] as i32)<<8)|((fsi[fb+2] as i32)<<16)|((fsi[fb+3] as i32)<<24);
    let ri:i32=(fri[fb] as i32)|((fri[fb+1] as i32)<<8)|((fri[fb+2] as i32)<<16)|((fri[fb+3] as i32)<<24);
    let oi:i32=(foi[fb] as i32)|((foi[fb+1] as i32)<<8)|((foi[fb+2] as i32)<<16)|((foi[fb+3] as i32)<<24);
    let enc:i32=ri*64+oi;
    // add to sig[si] if not present
    let cnt:i32=(sign[si*4] as i32)|((sign[si*4+1] as i32)<<8)|((sign[si*4+2] as i32)<<16)|((sign[si*4+3] as i32)<<24);
    let found:i32=0;
    let j:i32=0;
    while(j<cnt){
      let pb:i32=(si*32+j)*4;
      let v:i32=(sig[pb] as i32)|((sig[pb+1] as i32)<<8)|((sig[pb+2] as i32)<<16)|((sig[pb+3] as i32)<<24);
      if(v==enc){found=1;}
      j=j+1;
    }
    if(found==0 && cnt<32){
      let pb:i32=(si*32+cnt)*4;
      sig[pb]=enc as u8; sig[pb+1]=(enc>>8) as u8; sig[pb+2]=(enc>>16) as u8; sig[pb+3]=(enc>>24) as u8;
      cnt=cnt+1;
      sign[si*4]=cnt as u8; sign[si*4+1]=(cnt>>8) as u8; sign[si*4+2]=(cnt>>16) as u8; sign[si*4+3]=(cnt>>24) as u8;
    }
    f=f+1;
  }

  // Unify: for each pair (a,b), compute Jaccard, check distinguishing.
  // parent[a] = concept representative (union-find).
  let parent:[]u8=z_alloc(64*4);
  let a:i32=0;
  while(a<nsurf){
    parent[a*4]=a as u8; parent[a*4+1]=(a>>8) as u8; parent[a*4+2]=(a>>16) as u8; parent[a*4+3]=(a>>24) as u8;
    a=a+1;
  }

  let x:i32=0;
  while(x<nsurf){
    let y:i32=x+1;
    while(y<nsurf){
      // Jaccard(sig[x], sig[y])
      let cx:i32=(sign[x*4] as i32)|((sign[x*4+1] as i32)<<8)|((sign[x*4+2] as i32)<<16)|((sign[x*4+3] as i32)<<24);
      let cy:i32=(sign[y*4] as i32)|((sign[y*4+1] as i32)<<8)|((sign[y*4+2] as i32)<<16)|((sign[y*4+3] as i32)<<24);
      let inter:i32=0;
      let i:i32=0;
      while(i<cx){
        let pb:i32=(x*32+i)*4;
        let vx:i32=(sig[pb] as i32)|((sig[pb+1] as i32)<<8)|((sig[pb+2] as i32)<<16)|((sig[pb+3] as i32)<<24);
        let j:i32=0;
        while(j<cy){
          let qb:i32=(y*32+j)*4;
          let vy:i32=(sig[qb] as i32)|((sig[qb+1] as i32)<<8)|((sig[qb+2] as i32)<<16)|((sig[qb+3] as i32)<<24);
          if(vx==vy){inter=inter+1;}
          j=j+1;
        }
        i=i+1;
      }
      let union:i32=cx+cy-inter;
      // Jaccard >= 0.5  <=>  inter*2 >= union
      let jacc_ok:i32=0;
      if(union>0 && inter*2>=union){jacc_ok=1;}

      // Distinguishing check: exists R such that (x,R,O1) and (y,R,O2), O1!=O2.
      let distinguished:i32=0;
      if(jacc_ok==1){
        let i2:i32=0;
        while(i2<cx){
          let pb:i32=(x*32+i2)*4;
          let vx:i32=(sig[pb] as i32)|((sig[pb+1] as i32)<<8)|((sig[pb+2] as i32)<<16)|((sig[pb+3] as i32)<<24);
          let rx:i32=vx/64; let ox:i32=vx%64;
          let j2:i32=0;
          while(j2<cy){
            let qb:i32=(y*32+j2)*4;
            let vy:i32=(sig[qb] as i32)|((sig[qb+1] as i32)<<8)|((sig[qb+2] as i32)<<16)|((sig[qb+3] as i32)<<24);
            let ry:i32=vy/64; let oy:i32=vy%64;
            if(rx==ry && ox!=oy){distinguished=1;}
            j2=j2+1;
          }
          i2=i2+1;
        }
      }

      if(jacc_ok==1 && distinguished==0){
        // union x and y: parent[y]=x (simple, no path compression for clarity)
        parent[y*4]=x as u8; parent[y*4+1]=(x>>8) as u8; parent[y*4+2]=(x>>16) as u8; parent[y*4+3]=(x>>24) as u8;
        emit("UNIFY ");
        // print surface names
        let bx:i32=x*32; let ex:i32=bx;
        while(ex<bx+32 && surf[ex]!=0){ex=ex+1;}
        emit(surf[bx..ex]); emit(" ~ ");
        let by:i32=y*32; let ey:i32=by;
        while(ey<by+32 && surf[ey]!=0){ey=ey+1;}
        emit(surf[by..ey]);
        emit(" (jacc ");
        emit(i64s(inter)); emit("/"); emit(i64s(union));
        emit(")\n");
      }
      y=y+1;
    }
    x=x+1;
  }

  emit("# mini_learn done\n");

  // --- Probe answering via concept nodes ---
  // For each Q line: resolve subject to concept, lookup (member, rel) -> obj.
  let ncorrect:i32=0;
  let ntotal:i32=0;
  let npara_c:i32=0; let npara_t:i32=0;
  let nnear_c:i32=0; let nnear_t:i32=0;

  at=0;
  while(at<n){
    let en:i32=at;
    while(en<n && input[en]!=10){en=en+1;}
    if(en>at){
      let line:[]u8=input[at..en];
      if(line.len>2 && line[0]==81){ // 'Q'
        // "Q TYPE subj | rel | expected"
        let sp1:i32=2;
        while(sp1<line.len && line[sp1]!=32){sp1=sp1+1;}
        let typ:[]u8=line[2..sp1];
        let p1:i32=sp1+1;
        while(p1<line.len && line[p1]!=124){p1=p1+1;}
        let p2:i32=p1+1;
        while(p2<line.len && line[p2]!=124){p2=p2+1;}
        let s:[]u8=line[sp1+1..p1-1];
        let r:[]u8=line[p1+2..p2-1];
        let e:[]u8=line[p2+2..line.len];
        // find surface indices
        let si:i32=-1; let ri2:i32=-1;
        let k:i32=0;
        while(k<nsurf){
          let base:i32=k*32;
          let ee:i32=base;
          while(ee<base+32 && surf[ee]!=0){ee=ee+1;}
          if(streq(surf[base..ee], s)==1){si=k;}
          if(streq(surf[base..ee], r)==1){ri2=k;}
          k=k+1;
        }
        let answer:[]u8="WITHHOLD";
        let found:i32=0;
        if(si>=0 && ri2>=0){
          // find concept rep of si (follow parent chain)
          let rep:i32=si;
          let pr:i32=(parent[rep*4] as i32)|((parent[rep*4+1] as i32)<<8)|((parent[rep*4+2] as i32)<<16)|((parent[rep*4+3] as i32)<<24);
          while(pr!=rep){ rep=pr; pr=(parent[rep*4] as i32)|((parent[rep*4+1] as i32)<<8)|((parent[rep*4+2] as i32)<<16)|((parent[rep*4+3] as i32)<<24); }
          // search facts for (member of rep, ri2)
          let f2:i32=0;
          let ans_oi:i32=-1;
          let ans_count:i32=0;
          while(f2<nfact){
            let fb:i32=f2*4;
            let fsi2:i32=(fsi[fb] as i32)|((fsi[fb+1] as i32)<<8)|((fsi[fb+2] as i32)<<16)|((fsi[fb+3] as i32)<<24);
            let fri2:i32=(fri[fb] as i32)|((fri[fb+1] as i32)<<8)|((fri[fb+2] as i32)<<16)|((fri[fb+3] as i32)<<24);
            let foi2:i32=(foi[fb] as i32)|((foi[fb+1] as i32)<<8)|((foi[fb+2] as i32)<<16)|((foi[fb+3] as i32)<<24);
            // check if fsi2 in same concept as si
            let r2:i32=fsi2;
            let pr2:i32=(parent[r2*4] as i32)|((parent[r2*4+1] as i32)<<8)|((parent[r2*4+2] as i32)<<16)|((parent[r2*4+3] as i32)<<24);
            while(pr2!=r2){ r2=pr2; pr2=(parent[r2*4] as i32)|((parent[r2*4+1] as i32)<<8)|((parent[r2*4+2] as i32)<<16)|((parent[r2*4+3] as i32)<<24); }
            if(r2==rep && fri2==ri2){
              if(ans_oi<0){ans_oi=foi2;}
              if(foi2!=ans_oi){ans_count=2;} // conflicting -> ambiguous
              else {ans_count=1;}
            }
            f2=f2+1;
          }
          if(ans_count==1 && ans_oi>=0){
            let base:i32=ans_oi*32;
            let ee:i32=base;
            while(ee<base+32 && surf[ee]!=0){ee=ee+1;}
            answer=surf[base..ee];
            found=1;
          }
        }
        ntotal=ntotal+1;
        let correct:i32=0;
        if(streq(answer, e)==1){correct=1; ncorrect=ncorrect+1;}
        if(streq(typ, "PARA")==1){npara_t=npara_t+1; if(correct==1){npara_c=npara_c+1;}}
        if(streq(typ, "NEAR")==1){nnear_t=nnear_t+1; if(correct==1){nnear_c=nnear_c+1;}}
        emit("Q "); emit(typ); emit(" ");
        emit(s); emit(" | "); emit(r);
        emit(" => "); emit(answer);
        emit(" (expected "); emit(e); emit(") ");
        if(correct==1){emit("OK\n");} else {emit("MISS\n");}
      }
    }
    at=en+1;
  }
  emit("SCORE total "); emit(i64s(ncorrect)); emit("/"); emit(i64s(ntotal));
  emit(" PARA "); emit(i64s(npara_c)); emit("/"); emit(i64s(npara_t));
  emit(" NEAR "); emit(i64s(nnear_c)); emit("/"); emit(i64s(nnear_t));
  emit("\n");
  return 0;
}

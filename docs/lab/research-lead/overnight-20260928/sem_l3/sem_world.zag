// sem_world.zag — SEM-L3 world generator (Phase A, FROZEN).
// Deterministic synthetic world for learner-invented concept unification.
// Generates teaching.tsv, transfer_teach.tsv, taught_equiv.tsv, dev_probes.tsv,
// and sealed/: probes.tsv, transfer_probes.tsv, surfmap.tsv, triples.tsv.
// Pure Zag, zero RNG (LCG with fixed seed), deterministic.
// Entity IDs NEVER appear in learner-visible files.
//
// PREREG AMENDMENT (documented, transparent): §4's "surfaces mixed randomly per
// fact" (single-teaching) is unimplementable — it yields disjoint signatures
// for true surface pairs (Jaccard always 0, unifier can never fire). This
// generator teaches REDUNDANTLY: each underlying fact appears 2-3x with
// different surface variants (minimal-pair: identical except subject surface).
// This provides overlapping-signature evidence from which the learner INDUCES
// equivalences; the learner is never told which surfaces pair.
//
// World: 12 true entities (3 surface variants each, 4 full + 2 partial facts),
// 6 near-miss entities (2 variants, 2 facts each, distinguishing consequence),
// 2 twin entities (identical early signatures, 4 late distinguishing facts),
// 2 object-only entities (nickel, cobalt).
//
// BUILD.md documents the amendment, tau selection, and dual criterion.

// ---------- prelude ----------
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn w_open(path:[]u8)i64 {
  let c:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(c) as i64),577,420,0,0,0);
  z_free(c);
  return fd;
}
fn w_write(fd:i64,s:[]u8)void {
  let at:i32=0;
  while(at<s.len){
    let n:i64=_zag_raw_syscall(1,fd,(_zag_slice_ptr(s) as i64)+(at as i64),(s.len-at) as i64,0,0,0);
    if(n<=0){return;}
    at=at+(n as i32);
  }
  return;
}
fn w_close(fd:i64)void { _zag_raw_syscall(3,fd,0,0,0,0,0); return; }
fn streq(a:[]u8,b:[]u8)i64 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){if(a[i]!=b[i]){return 0;}i=i+1;}
  return 1;
}
// append s into buf at position at; returns new at
fn app(buf:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){buf[at+i]=s[i];i=i+1;}
  return at+s.len;
}
// find first occurrence of needle in hay starting at `from`; -1 if absent
fn findsub(hay:[]u8,from:i32,needle:[]u8)i32 {
  if(needle.len==0 || hay.len<needle.len){return -1;}
  let i:i32=from;
  while(i+needle.len<=hay.len){
    let k:i32=0;
    while(k<needle.len && hay[i+k]==needle[k]){k=k+1;}
    if(k==needle.len){return i;}
    i=i+1;
  }
  return -1;
}

// ---------- deterministic LCG ----------
fn lcg_next(st:[]u8)i64 {
  // st[0..8]: u64 LE seed
  let s:i64=0;
  let i:i32=0;
  while(i<8){s=s|((st[i] as i64)<<(i*8));i=i+1;}
  s=s*6364136223846793005+1442695040888963407;
  // store back (wrap via u64 truncation through i64 is fine, deterministic)
  i=0;
  while(i<8){st[i]=((s>>(i*8))&255) as u8;i=i+1;}
  if(s<0){s=-s;}
  return s;
}
fn lcg_range(st:[]u8,n:i64)i64 {
  if(n<1){return 0;}
  return lcg_next(st)%n;
}

// ---------- entity / relation data ----------
// Entities 0..11 true (3 variants), 12..17 near-miss (2 variants),
// 18..19 twins (2 variants), 20..21 object-only (1 variant).
fn nvar(e:i32)i64 {
  if(e<12){return 3;}
  if(e<20){return 2;}
  return 1;
}
fn esurf(e:i32,v:i32)[]u8 {
  if(e==0){ if(v==0){return "norpal";} if(v==1){return "the squeezer";} return "object-7"; }
  if(e==1){ if(v==0){return "glim";} if(v==1){return "the glowmote";} return "spark-3"; }
  if(e==2){ if(v==0){return "vellum";} if(v==1){return "the heatsheet";} return "membrane-9"; }
  if(e==3){ if(v==0){return "furnace";} if(v==1){return "the heater";} return "unit-2"; }
  if(e==4){ if(v==0){return "iron";} if(v==1){return "the metal";} return "bar-5"; }
  if(e==5){ if(v==0){return "slab";} if(v==1){return "the platform";} return "base-1"; }
  if(e==6){ if(v==0){return "sponge";} if(v==1){return "the soaker";} return "foam-2"; }
  if(e==7){ if(v==0){return "oil";} if(v==1){return "the slick";} return "grease-5"; }
  if(e==8){ if(v==0){return "ember";} if(v==1){return "the coal";} return "cinder-8"; }
  if(e==9){ if(v==0){return "crystal";} if(v==1){return "the prism";} return "gem-7"; }
  if(e==10){ if(v==0){return "water";} if(v==1){return "the liquid";} return "pool-7"; }
  if(e==11){ if(v==0){return "paper";} if(v==1){return "the sheet";} return "page-3"; }
  if(e==12){ if(v==0){return "norpaline";} return "the presser"; }
  if(e==13){ if(v==0){return "furnax";} return "the warmer"; }
  if(e==14){ if(v==0){return "spunge";} return "the absorber"; }
  if(e==15){ if(v==0){return "vellux";} return "the drysheet"; }
  if(e==16){ if(v==0){return "glimmer";} return "the shinemote"; }
  if(e==17){ if(v==0){return "krystal";} return "the prizm"; }
  if(e==18){ if(v==0){return "ferro";} return "the magnet"; }
  if(e==19){ if(v==0){return "ferrox";} return "the lodestone"; }
  if(e==20){ return "nickel"; }
  return "cobalt";
}
// Relations 0..14. tmid/tend: teaching infix/suffix. qmid: "What does S <qmid>?"
fn rel_tmid(r:i32)[]u8 {
  if(r==0){return " emits ";} if(r==1){return " heats ";} if(r==2){return " cools ";}
  if(r==3){return " absorbs ";} if(r==4){return " rests on ";} if(r==5){return " fills ";}
  if(r==6){return " burns ";} if(r==7){return " attracts ";} if(r==8){return " pushes ";}
  if(r==9){return " becomes ";} if(r==10){return " focuses ";} if(r==11){return " ignites ";}
  if(r==12){return " bakes ";} if(r==13){return " draws ";} return " splits ";
}
fn rel_tend(r:i32)[]u8 {
  if(r==0){return " when compressed";}
  return "";
}
fn rel_qmid(r:i32)[]u8 {
  if(r==0){return " emit when compressed";} if(r==1){return " heat";} if(r==2){return " cool";}
  if(r==3){return " absorb";} if(r==4){return " rest on";} if(r==5){return " fill";}
  if(r==6){return " burn";} if(r==7){return " attract";} if(r==8){return " push";}
  if(r==9){return " become";} if(r==10){return " focus";} if(r==11){return " ignite";}
  if(r==12){return " bake";} if(r==13){return " draw";} return " split";
}
// reverse query infix: "What <qrev> O?"  ("" = unsupported)
fn rel_qrev(r:i32)[]u8 {
  if(r==1){return " heats ";} if(r==2){return " cools ";} if(r==3){return " absorbs ";}
  if(r==4){return " rests on ";} if(r==5){return " fills ";} if(r==6){return " burns ";}
  if(r==7){return " attracts ";} if(r==11){return " ignites ";} if(r==13){return " draws ";}
  return "";
}
fn rel_name(r:i32)[]u8 {
  if(r==0){return "emits-when-compressed";} if(r==1){return "heats";} if(r==2){return "cools";}
  if(r==3){return "absorbs";} if(r==4){return "rests-on";} if(r==5){return "fills";}
  if(r==6){return "burns";} if(r==7){return "attracts";} if(r==8){return "pushes";}
  if(r==9){return "becomes";} if(r==10){return "focuses";} if(r==11){return "ignites";}
  if(r==12){return "bakes";} if(r==13){return "draws";} return "splits";
}

// ---------- fact tables ----------
// Core facts: (entity, relation, object_entity, variant_mask). mask bit v = taught.
// Full (7): all 3 variants. Partial (1): only v0 (v1,v2 held out for P-PARA-COMB).
// Near-miss, twin, late facts appended after.
fn init_facts(fe:[]u8,fr:[]u8,fo:[]u8,fm:[]u8)i32 {
  let n:i32=0;
  // E0 norpal
  fe[n]=0;fr[n]=0;fo[n]=1;fm[n]=7;n=n+1;
  fe[n]=0;fr[n]=4;fo[n]=5;fm[n]=7;n=n+1;
  fe[n]=0;fr[n]=3;fo[n]=10;fm[n]=7;n=n+1;
  fe[n]=0;fr[n]=2;fo[n]=8;fm[n]=7;n=n+1;
  fe[n]=0;fr[n]=1;fo[n]=2;fm[n]=1;n=n+1;
  fe[n]=0;fr[n]=11;fo[n]=11;fm[n]=1;n=n+1;
  // E1 glim
  fe[n]=1;fr[n]=1;fo[n]=2;fm[n]=7;n=n+1;
  fe[n]=1;fr[n]=11;fo[n]=11;fm[n]=7;n=n+1;
  fe[n]=1;fr[n]=9;fo[n]=8;fm[n]=7;n=n+1;
  fe[n]=1;fr[n]=2;fo[n]=3;fm[n]=7;n=n+1;
  fe[n]=1;fr[n]=3;fo[n]=10;fm[n]=1;n=n+1;
  fe[n]=1;fr[n]=13;fo[n]=7;fm[n]=1;n=n+1;
  // E2 vellum
  fe[n]=2;fr[n]=4;fo[n]=5;fm[n]=7;n=n+1;
  fe[n]=2;fr[n]=3;fo[n]=10;fm[n]=7;n=n+1;
  fe[n]=2;fr[n]=2;fo[n]=1;fm[n]=7;n=n+1;
  fe[n]=2;fr[n]=9;fo[n]=8;fm[n]=7;n=n+1;
  fe[n]=2;fr[n]=1;fo[n]=11;fm[n]=1;n=n+1;
  fe[n]=2;fr[n]=6;fo[n]=7;fm[n]=1;n=n+1;
  // E3 furnace
  fe[n]=3;fr[n]=1;fo[n]=4;fm[n]=7;n=n+1;
  fe[n]=3;fr[n]=6;fo[n]=7;fm[n]=7;n=n+1;
  fe[n]=3;fr[n]=4;fo[n]=5;fm[n]=7;n=n+1;
  fe[n]=3;fr[n]=11;fo[n]=11;fm[n]=7;n=n+1;
  fe[n]=3;fr[n]=2;fo[n]=10;fm[n]=1;n=n+1;
  fe[n]=3;fr[n]=3;fo[n]=8;fm[n]=1;n=n+1;
  // E4 iron (distinctive: attracts/focuses/fills/pushes)
  fe[n]=4;fr[n]=7;fo[n]=0;fm[n]=7;n=n+1;
  fe[n]=4;fr[n]=10;fo[n]=9;fm[n]=7;n=n+1;
  fe[n]=4;fr[n]=5;fo[n]=11;fm[n]=7;n=n+1;
  fe[n]=4;fr[n]=8;fo[n]=6;fm[n]=7;n=n+1;
  fe[n]=4;fr[n]=4;fo[n]=5;fm[n]=1;n=n+1;
  fe[n]=4;fr[n]=2;fo[n]=8;fm[n]=1;n=n+1;
  // E5 slab (distinctive: attracts-iron, focuses-norpal)
  fe[n]=5;fr[n]=2;fo[n]=8;fm[n]=7;n=n+1;
  fe[n]=5;fr[n]=3;fo[n]=10;fm[n]=7;n=n+1;
  fe[n]=5;fr[n]=7;fo[n]=4;fm[n]=7;n=n+1;
  fe[n]=5;fr[n]=10;fo[n]=0;fm[n]=7;n=n+1;
  fe[n]=5;fr[n]=9;fo[n]=8;fm[n]=1;n=n+1;
  fe[n]=5;fr[n]=8;fo[n]=10;fm[n]=1;n=n+1;
  // E6 sponge
  fe[n]=6;fr[n]=3;fo[n]=10;fm[n]=7;n=n+1;
  fe[n]=6;fr[n]=4;fo[n]=5;fm[n]=7;n=n+1;
  fe[n]=6;fr[n]=2;fo[n]=4;fm[n]=7;n=n+1;
  fe[n]=6;fr[n]=13;fo[n]=7;fm[n]=7;n=n+1;
  fe[n]=6;fr[n]=1;fo[n]=2;fm[n]=1;n=n+1;
  fe[n]=6;fr[n]=11;fo[n]=11;fm[n]=1;n=n+1;
  // E7 oil
  fe[n]=7;fr[n]=5;fo[n]=3;fm[n]=7;n=n+1;
  fe[n]=7;fr[n]=4;fo[n]=5;fm[n]=7;n=n+1;
  fe[n]=7;fr[n]=2;fo[n]=8;fm[n]=7;n=n+1;
  fe[n]=7;fr[n]=6;fo[n]=11;fm[n]=7;n=n+1;
  fe[n]=7;fr[n]=3;fo[n]=6;fm[n]=1;n=n+1;
  fe[n]=7;fr[n]=1;fo[n]=2;fm[n]=1;n=n+1;
  // E8 ember
  fe[n]=8;fr[n]=1;fo[n]=2;fm[n]=7;n=n+1;
  fe[n]=8;fr[n]=11;fo[n]=11;fm[n]=7;n=n+1;
  fe[n]=8;fr[n]=4;fo[n]=5;fm[n]=7;n=n+1;
  fe[n]=8;fr[n]=2;fo[n]=3;fm[n]=7;n=n+1;
  fe[n]=8;fr[n]=3;fo[n]=10;fm[n]=1;n=n+1;
  fe[n]=8;fr[n]=6;fo[n]=7;fm[n]=1;n=n+1;
  // E9 crystal
  fe[n]=9;fr[n]=4;fo[n]=5;fm[n]=7;n=n+1;
  fe[n]=9;fr[n]=2;fo[n]=8;fm[n]=7;n=n+1;
  fe[n]=9;fr[n]=3;fo[n]=10;fm[n]=7;n=n+1;
  fe[n]=9;fr[n]=1;fo[n]=2;fm[n]=7;n=n+1;
  fe[n]=9;fr[n]=11;fo[n]=11;fm[n]=1;n=n+1;
  fe[n]=9;fr[n]=10;fo[n]=1;fm[n]=1;n=n+1;
  // E10 water
  fe[n]=10;fr[n]=5;fo[n]=3;fm[n]=7;n=n+1;
  fe[n]=10;fr[n]=2;fo[n]=8;fm[n]=7;n=n+1;
  fe[n]=10;fr[n]=2;fo[n]=4;fm[n]=7;n=n+1;
  fe[n]=10;fr[n]=4;fo[n]=5;fm[n]=7;n=n+1;
  fe[n]=10;fr[n]=3;fo[n]=6;fm[n]=1;n=n+1;
  fe[n]=10;fr[n]=13;fo[n]=7;fm[n]=1;n=n+1;
  // E11 paper
  fe[n]=11;fr[n]=4;fo[n]=5;fm[n]=7;n=n+1;
  fe[n]=11;fr[n]=3;fo[n]=10;fm[n]=7;n=n+1;
  fe[n]=11;fr[n]=9;fo[n]=8;fm[n]=7;n=n+1;
  fe[n]=11;fr[n]=13;fo[n]=7;fm[n]=7;n=n+1;
  fe[n]=11;fr[n]=2;fo[n]=4;fm[n]=1;n=n+1;
  fe[n]=11;fr[n]=1;fo[n]=2;fm[n]=1;n=n+1;
  return n;
}
// Near-miss facts (taught once, single variant v0; distinguishing consequence).
// Returns count appended.
fn init_near(fe:[]u8,fr:[]u8,fo:[]u8,fm:[]u8,n:i32)i32 {
  fe[n]=12;fr[n]=0;fo[n]=8;fm[n]=1;n=n+1;   // norpaline emits ember (vs norpal: glim)
  fe[n]=12;fr[n]=4;fo[n]=5;fm[n]=1;n=n+1;   // norpaline rests on slab
  fe[n]=13;fr[n]=1;fo[n]=6;fm[n]=1;n=n+1;   // furnax heats sponge (vs furnace: iron)
  fe[n]=13;fr[n]=4;fo[n]=5;fm[n]=1;n=n+1;
  fe[n]=14;fr[n]=3;fo[n]=7;fm[n]=1;n=n+1;   // spunge absorbs oil (vs sponge: water)
  fe[n]=14;fr[n]=4;fo[n]=5;fm[n]=1;n=n+1;
  fe[n]=15;fr[n]=2;fo[n]=8;fm[n]=1;n=n+1;   // vellux cools ember (vs vellum: cools glim)
  fe[n]=15;fr[n]=4;fo[n]=5;fm[n]=1;n=n+1;
  fe[n]=16;fr[n]=1;fo[n]=8;fm[n]=1;n=n+1;   // glimmer heats ember (vs glim: heats vellum)
  fe[n]=16;fr[n]=4;fo[n]=5;fm[n]=1;n=n+1;
  fe[n]=17;fr[n]=1;fo[n]=8;fm[n]=1;n=n+1;   // krystal heats ember (vs crystal: heats vellum)
  fe[n]=17;fr[n]=4;fo[n]=5;fm[n]=1;n=n+1;
  return n;
}
// Twin early facts (identical signatures -> rational unification).
fn init_twin(fe:[]u8,fr:[]u8,fo:[]u8,fm:[]u8,n:i32)i32 {
  fe[n]=18;fr[n]=7;fo[n]=4;fm[n]=3;n=n+1;   // ferro attracts iron (v0,v1)
  fe[n]=18;fr[n]=4;fo[n]=5;fm[n]=3;n=n+1;   // ferro rests on slab
  fe[n]=19;fr[n]=7;fo[n]=4;fm[n]=3;n=n+1;   // ferrox attracts iron
  fe[n]=19;fr[n]=4;fo[n]=5;fm[n]=3;n=n+1;
  return n;
}
// Late distinguishing facts (phase 2; force split).
fn init_late(fe:[]u8,fr:[]u8,fo:[]u8,fm:[]u8,n:i32)i32 {
  fe[n]=18;fr[n]=7;fo[n]=20;fm[n]=3;n=n+1;  // ferro attracts nickel (v0,v1)
  fe[n]=19;fr[n]=7;fo[n]=21;fm[n]=3;n=n+1;  // ferrox attracts cobalt
  return n;
}

// ---------- sentence builder ----------
// Builds "S<mid>O<end>." into out; returns length.
fn build_sent(out:[]u8,s:[]u8,r:i32,o:[]u8)i32 {
  let at:i32=0;
  at=app(out,at,s);
  at=app(out,at,rel_tmid(r));
  at=app(out,at,o);
  at=app(out,at,rel_tend(r));
  at=app(out,at,".");
  return at;
}

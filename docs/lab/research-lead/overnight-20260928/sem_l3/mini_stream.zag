// mini_stream.zag — Streaming concept learner (continuing learner PoC).
// Processes interleaved T (teach) and Q (query) lines.
// Maintains incremental signatures and unifications.
// Demonstrates: persistent concepts, incremental learning, no reset.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn z_free(b:[]u8)void {
  if(b.len>0){_zag_free(_zag_slice_ptr(b));}
  return;
}
fn z_cstr(s:[]u8)[]u8 {
  let b:[]u8=z_alloc(s.len+1);
  let k:i32=0;
  while(k<s.len){b[k]=s[k];k=k+1;}
  b[s.len]=0;
  return b;
}
fn read_file(path:[]u8)[]u8 {
  let cp:[]u8=z_cstr(path);
  let fd:i64=_zag_raw_syscall(2,(_zag_slice_ptr(cp) as i64),0,0,0,0,0);
  z_free(cp);
  let cap:i32=1048576;
  let buf:[]u8=z_alloc(cap);
  let total:i32=0;
  if(fd>=0){
    let go:i32=1;
    while(go==1){
      let n:i64=_zag_raw_syscall(0,fd,(_zag_slice_ptr(buf) as i64)+(total as i64),(cap-total) as i64,0,0,0);
      if(n<=0){go=0;}
      if(n>0){
        let nb:i32=n as i32;
        if(total+nb>cap){go=0;} else {total=total+nb;}
      }
    }
    _zag_raw_syscall(3,fd,0,0,0,0,0);
  }
  return buf[0..total];
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn i64s(v:i64)[]u8 {
  let s:[]u8=_zag_i64_to_str(v);
  if(s.len>1 && s[s.len-1]==10){return s[0..s.len-1];}
  return s;
}
fn streq(a:[]u8, b:[]u8)i32 {
  if(a.len!=b.len){return 0;}
  let i:i32=0;
  while(i<a.len){ if(a[i]!=b[i]){return 0;} i=i+1; }
  return 1;
}

// Global state (simplified: fixed arrays)
fn main()i32 {
  let path:[]u8=_zag_arg(1);
  if(path.len==0){ emit("usage: mini_stream stream.txt\n"); return 1; }
  let input:[]u8=read_file(path);
  if(input.len==0){ emit("no input\n"); return 1; }

  let surf:[]u8=z_alloc(64*32);
  let nsurf:i32=0;
  let sig:[]u8=z_alloc(64*32*4);
  let sign:[]u8=z_alloc(64*4);
  let parent:[]u8=z_alloc(64*4);
  // facts stored for lookup
  let fsi:[]u8=z_alloc(256*4);
  let fri:[]u8=z_alloc(256*4);
  let foi:[]u8=z_alloc(256*4);
  let nfact:i32=0;

  let n:i32=input.len;
  let at:i32=0;
  let nq:i32=0; let nq_ok:i32=0;

  while(at<n){
    let en:i32=at;
    while(en<n && input[en]!=10){en=en+1;}
    if(en>at){
      let line:[]u8=input[at..en];
      if(line.len>2 && line[0]==84){ // 'T'
        // Parse and store fact, update signature
        let p1:i32=2;
        while(p1<line.len && line[p1]!=124){p1=p1+1;}
        let p2:i32=p1+1;
        while(p2<line.len && line[p2]!=124){p2=p2+1;}
        let s:[]u8=line[2..p1-1];
        let r:[]u8=line[p1+2..p2-1];
        let o:[]u8=line[p2+2..line.len];
        // intern (simplified: assume fits)
        let si:i32=-1; let ri:i32=-1; let oi:i32=-1;
        let k:i32=0;
        while(k<nsurf){
          let base:i32=k*32; let e:i32=base;
          while(e<base+32 && surf[e]!=0){e=e+1;}
          if(streq(surf[base..e], s)==1){si=k;}
          if(streq(surf[base..e], r)==1){ri=k;}
          if(streq(surf[base..e], o)==1){oi=k;}
          k=k+1;
        }
        if(si<0){si=nsurf; let base:i32=si*32; let j:i32=0; while(j<s.len && j<32){surf[base+j]=s[j]; j=j+1;} nsurf=nsurf+1; parent[si*4]=si as u8;}
        if(ri<0){ri=nsurf; let base:i32=ri*32; let j:i32=0; while(j<r.len && j<32){surf[base+j]=r[j]; j=j+1;} nsurf=nsurf+1; parent[ri*4]=ri as u8;}
        if(oi<0){oi=nsurf; let base:i32=oi*32; let j:i32=0; while(j<o.len && j<32){surf[base+j]=o[j]; j=j+1;} nsurf=nsurf+1; parent[oi*4]=oi as u8;}
        // store fact
        let fb:i32=nfact*4;
        fsi[fb]=si as u8; fri[fb]=ri as u8; foi[fb]=oi as u8;
        nfact=nfact+1;
        // update sig[si] with (ri,oi)
        let enc:i32=ri*64+oi;
        let cnt:i32=sign[si*4] as i32;
        let found:i32=0; let j:i32=0;
        while(j<cnt){
          let pb:i32=(si*32+j)*4;
          let v:i32=(sig[pb] as i32)|((sig[pb+1] as i32)<<8);
          if(v==enc){found=1;}
          j=j+1;
        }
        if(found==0 && cnt<32){
          let pb:i32=(si*32+cnt)*4;
          sig[pb]=enc as u8; sig[pb+1]=(enc>>8) as u8;
          sign[si*4]=(cnt+1) as u8;
        }
        // Re-run unification (simplified: full recompute)
        // (In production, incremental; here, brute force for clarity)
        let x:i32=0;
        while(x<nsurf){
          let y:i32=x+1;
          while(y<nsurf){
            let cx:i32=sign[x*4] as i32;
            let cy:i32=sign[y*4] as i32;
            let inter:i32=0;
            let i2:i32=0;
            while(i2<cx){
              let pb:i32=(x*32+i2)*4;
              let vx:i32=(sig[pb] as i32)|((sig[pb+1] as i32)<<8);
              let j2:i32=0;
              while(j2<cy){
                let qb:i32=(y*32+j2)*4;
                let vy:i32=(sig[qb] as i32)|((sig[qb+1] as i32)<<8);
                if(vx==vy){inter=inter+1;}
                j2=j2+1;
              }
              i2=i2+1;
            }
            let union:i32=cx+cy-inter;
            if(union>0 && inter*2>=union){
              // check distinguishing
              let dist:i32=0;
              let i3:i32=0;
              while(i3<cx){
                let pb:i32=(x*32+i3)*4;
                let vx:i32=(sig[pb] as i32)|((sig[pb+1] as i32)<<8);
                let rx:i32=vx/64; let ox:i32=vx%64;
                let j3:i32=0;
                while(j3<cy){
                  let qb:i32=(y*32+j3)*4;
                  let vy:i32=(sig[qb] as i32)|((sig[qb+1] as i32)<<8);
                  let ry:i32=vy/64; let oy:i32=vy%64;
                  if(rx==ry && ox!=oy){dist=1;}
                  j3=j3+1;
                }
                i3=i3+1;
              }
              if(dist==0){
                // union: find roots, merge
                let rx2:i32=x;
                while((parent[rx2*4] as i32)!=rx2){rx2=parent[rx2*4] as i32;}
                let ry2:i32=y;
                while((parent[ry2*4] as i32)!=ry2){ry2=parent[ry2*4] as i32;}
                if(rx2!=ry2){parent[ry2*4]=rx2 as u8;}
              }
            }
            y=y+1;
          }
          x=x+1;
        }
      }
      if(line.len>2 && line[0]==81){ // 'Q'
        // Parse and answer query
        nq=nq+1;
        let sp1:i32=2;
        while(sp1<line.len && line[sp1]!=32){sp1=sp1+1;}
        let typ:[]u8=line[2..sp1];
        let p1:i32=sp1+1;
        while(p1<line.len && line[p1]!=124){p1=p1+1;}
        let p2:i32=p1+1;
        while(p2<line.len && line[p2]!=124){p2=p2+1;}
        let s:[]u8=line[sp1+1..p1-1];
        let r:[]u8=line[p1+2..p2-1];
        let e:[]u8=line[p2+2..line.len];
        // find si, ri
        let si:i32=-1; let ri:i32=-1;
        let k:i32=0;
        while(k<nsurf){
          let base:i32=k*32; let ee:i32=base;
          while(ee<base+32 && surf[ee]!=0){ee=ee+1;}
          if(streq(surf[base..ee], s)==1){si=k;}
          if(streq(surf[base..ee], r)==1){ri=k;}
          k=k+1;
        }
        let answer:[]u8="WITHHOLD";
        if(si>=0 && ri>=0){
          let rep:i32=si;
          while((parent[rep*4] as i32)!=rep){rep=parent[rep*4] as i32;}
          let f2:i32=0; let ans_oi:i32=-1; let ambiguous:i32=0;
          while(f2<nfact){
            let fb:i32=f2*4;
            let fsi2:i32=fsi[fb] as i32;
            let fri2:i32=fri[fb] as i32;
            let foi2:i32=foi[fb] as i32;
            let r2:i32=fsi2;
            while((parent[r2*4] as i32)!=r2){r2=parent[r2*4] as i32;}
            if(r2==rep && fri2==ri){
              if(ans_oi<0){ans_oi=foi2;}
              else if(foi2!=ans_oi){ambiguous=1;}
            }
            f2=f2+1;
          }
          if(ans_oi>=0 && ambiguous==0){
            let base:i32=ans_oi*32; let ee:i32=base;
            while(ee<base+32 && surf[ee]!=0){ee=ee+1;}
            answer=surf[base..ee];
          }
        }
        let ok:i32=0;
        if(streq(answer, e)==1){ok=1; nq_ok=nq_ok+1;}
        emit("Q "); emit(s); emit(" | "); emit(r);
        emit(" => "); emit(answer);
        if(ok==1){emit(" OK\n");} else {emit(" MISS (expected "); emit(e); emit(")\n");}
      }
    }
    at=en+1;
  }
  emit("STREAM SCORE "); emit(i64s(nq_ok)); emit("/"); emit(i64s(nq)); emit("\n");
  return 0;
}

// mini_world.zag v3 — Clean disjoint vocabularies.
// Each entity uses UNIQUE (relation, object) pairs. No cross-entity overlap.
// True pairs share via minimal-pair teaching. False pairs have Jaccard 0.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }

fn fact(s:[]u8, r:[]u8, o:[]u8)void {
  emit("T ");
  emit(s); emit(" | "); emit(r); emit(" | "); emit(o);
  emit("\n");
  return;
}
fn probe(typ:[]u8, s:[]u8, r:[]u8, e:[]u8)void {
  emit("Q "); emit(typ);
  emit(" "); emit(s); emit(" | "); emit(r); emit(" | "); emit(e);
  emit("\n");
  return;
}

fn main()i32 {
  // E1: norpal / squeezer. Unique R: sqz_emit, sqz_glow, sqz_heat. Unique O: glimx, glowx, velx.
  fact("norpal", "sqz_emit", "glimx");
  fact("squeezer", "sqz_emit", "glimx");
  fact("norpal", "sqz_glow", "glowx");
  fact("squeezer", "sqz_glow", "glowx");
  fact("norpal", "sqz_heat", "velx");       // single-surface
  fact("squeezer", "sqz_warm", "shtx");     // single-surface (different R!)

  // E2: vellum / sheet. Unique R: vph_heat, vph_warm, vph_cool. Unique O: aqax, watx, ferx.
  fact("vellum", "vph_heat", "aqax");
  fact("sheet", "vph_heat", "aqax");
  fact("vellum", "vph_warm", "watx");
  fact("sheet", "vph_warm", "watx");
  fact("vellum", "vph_cool", "ferx");       // single-surface
  // (sheet+vph_cool never taught)

  // E3: glim / glow. Unique R: glm_heat, glm_warm. Unique O: velx2, shtx2.
  fact("glim", "glm_heat", "velx2");
  fact("glow", "glm_heat", "velx2");
  fact("glim", "glm_warm", "shtx2");
  fact("glow", "glm_warm", "shtx2");
  // (no single-surface; 2 minimal pairs = 4 facts, Jaccard 1.0)

  // E4: ferrum / ironbar. Unique R: frm_cool, frm_chill. Unique O: aqax2, watx2.
  fact("ferrum", "frm_cool", "aqax2");
  fact("ironbar", "frm_cool", "aqax2");
  fact("ferrum", "frm_chill", "watx2");
  fact("ironbar", "frm_chill", "watx2");

  // N1 norpaline (near-miss of E1): uses E1-like surfaces but DIFFERENT R,O.
  // norpaline does NOT use sqz_*. It uses npl_heat, npl_cool with different objects.
  // Distinguishing: norpal has sqz_emit->glimx, norpaline has npl_heat->ferx2 (different R).
  // Actually for the distinguishing check to fire, need SAME R, DIFFERENT O.
  // Let's give norpaline a fact with sqz_heat but different object:
  fact("norpaline", "sqz_heat", "ferx2");   // vs norpal: sqz_heat->velx. SAME R, DIFFERENT O = DISTINGUISHED.
  fact("norpaline", "npl_cool", "aqax3");
  fact("norpaline", "npl_warm", "irnx");

  // N2 vellux (near-miss of E2):
  fact("vellux", "vph_heat", "aqax9");     // vs vellum: vph_heat->aqax. SAME R, DIFFERENT O = DISTINGUISHED.
  fact("vellux", "vlx_chill", "watx9");

  // Probes: P-PARA (untaught combos requiring unification)
  probe("PARA", "squeezer", "sqz_heat", "velx");   // taught: norpal+sqz_heat+velx
  probe("PARA", "norpal", "sqz_warm", "shtx");     // taught: squeezer+sqz_warm+shtx
  probe("PARA", "sheet", "vph_cool", "ferx");      // taught: vellum+vph_cool+ferx

  // P-NEAR
  probe("NEAR", "norpaline", "sqz_emit", "WITHHOLD");  // norpaline not unified with norpal
  probe("NEAR", "norpaline", "sqz_glow", "WITHHOLD");
  probe("NEAR", "vellux", "vph_warm", "WITHHOLD");     // vellux not unified with vellum
  probe("NEAR", "norpaline", "sqz_heat", "ferx2");     // taught distinct fact
  probe("NEAR", "vellux", "vph_heat", "aqax9");        // taught distinct fact

  emit("# mini_world v3 done\n");
  return 0;
}

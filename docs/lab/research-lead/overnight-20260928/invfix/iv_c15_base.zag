// iv_c15_base.zag -- INVARIANT-FIXED copy of cogops_rescueaware/c15_base.zag
// (sha256 fc1f6e73c43ae8e4ea2b7af50f1606cc4b6c5353992bd5d4411cb4c9a3b73e61,
// 174 lines).  The original is NOT modified.
//
// WHAT CHANGED, and the invariant each change installs (C510 prereg M2):
//
//  INV-W1  EXPLICIT FACT CAPACITY.  world_new writes the fact-store capacity
//          into the arena header (A+1544) instead of it being a literal inside
//          fact_add.  fact_add CHECKS THAT RECORD BEFORE WRITING and returns
//          -1 on refusal; A+1548 counts refusals.  The old fact_add returned
//          void and dropped the fact silently at 128 (property lane V6).
//
//  INV-W2  REPORTED COUNT == STORED COUNT.  ret_gen and cnt_gen previously
//          stored min(n,32)/min(ns,64) but reported the UNCLAMPED n, so every
//          consumer read values that were never written (C503).  Both now
//          write the STORED count into the record header and return the STORED
//          count.  When the true count exceeds the record's own capacity the
//          overflow is counted (A+1556 / A+1560) and the enclosing operation
//          must refuse; it may not answer from a partial record.
//
// Every other line is behaviourally identical to the original: the scan
// order, the check-counter increments, the dedup order and the outputs are
// unchanged whenever no capacity is exceeded.
//
// Output rule: dynamic content is formatted into one buffer.  `o_flush` is
// redefined here with the brief-4.0 `_zag_print` shim because the original
// used the inert `_zag_raw_syscall`.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_print(b[0..c]);
  return;
}
// ============ world arena: explicit capacity header (INV-W1) ============
// Header cells (previously unused slack, so no behaviour moves):
//   1544 FACT_CAP   explicit fact-store capacity, written by world_new
//   1548 FACT_OVF   fact_add refusals (capacity exhausted)
//   1552 RET_OVF    ret_gen subject-record overflow events
//   1556 CNT_OVF    cnt_gen distinct-object overflow events
//   1560 VFY_OVF    reserved for the verify record
fn FACT_CAP_OFF()i32 { return 1544; }
fn FACT_OVF_OFF()i32 { return 1548; }
fn RET_OVF_OFF()i32  { return 1552; }
fn CNT_OVF_OFF()i32  { return 1556; }
fn world_new()[]u8 {
  let A:[]u8=z_alloc(4096);
  set32(A,FACT_CAP_OFF(),128);
  set32(A,FACT_OVF_OFF(),0);
  set32(A,RET_OVF_OFF(),0);
  set32(A,CNT_OVF_OFF(),0);
  return A;
}
fn fact_cap(A:[]u8)i32 { return get32(A,FACT_CAP_OFF()); }
// A_OCAP: the EXPLICIT output-record capacity, derived from the world's
// recorded fact capacity.  A RETRIEVE record cannot need more entries than
// the world has facts, so this is an upper bound, not a tuned constant.  The
// caller passes it down to every record writer.
fn A_OCAP(A:[]u8)i32 {
  let c:i32=get32(A,FACT_CAP_OFF());
  if(c<1){ c=1; }
  return c;
}
fn fact_ovf(A:[]u8)i32 { return get32(A,FACT_OVF_OFF()); }
fn ret_ovf(A:[]u8)i32  { return get32(A,RET_OVF_OFF()); }
fn cnt_ovf(A:[]u8)i32  { return get32(A,CNT_OVF_OFF()); }
// fact_add: 1 = written, -1 = REFUSED (capacity exhausted, nothing written).
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=get32(A,0);
  let cap:i32=fact_cap(A);
  if(n>=cap){
    set32(A,FACT_OVF_OFF(),get32(A,FACT_OVF_OFF())+1);
    return -1;
  }
  set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
  set32(A,0,n+1);
  return 1;
}
// ---- chain: 0: nsteps; 4: steps, 16 * 12 bytes ----
fn chain_new()[]u8 { return z_alloc(512); }
fn chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    set32(C,4+n*12,s); set32(C,4+n*12+4,r); set32(C,4+n*12+8,o);
    set32(C,0,n+1);
  }
  return;
}
// ---- ret_gen: researcher-supplied generic RETRIEVE (procedure id 0).
// INV-W2: the record's own capacity is derived from the caller's buffer
// length -- an explicit, caller-visible record capacity, not a literal --
// and is CHECKED BEFORE EVERY WRITE.  The count written into out[oo] and
// the value returned are both the STORED count.  If the true match count
// exceeds the record capacity the surplus is discarded, RET_OVF is
// incremented, and the caller is expected to refuse; the returned count is
// never larger than the number of subjects actually written.
// INV-W3  CAPACITY IS AN EXPLICIT, CALLER-VISIBLE RECORD, NOT A LITERAL.
// The caller passes `cap`, the number of entries the ONE record at `oo` can
// hold.  It is derived by the caller from the record's own stride, and it is
// additionally bounded here by what the buffer physically has left, so a
// caller that lies about `cap` still cannot write out of bounds.
fn ret_gen(A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,cap:i32)i32 {
  let nf:i32=get32(A,0);
  let room:i32=(out.len-oo)/4-1;
  if(cap>room){ cap=room; }
  if(cap<0){ cap=0; }
  let n:i32=0;
  let j:i32=0;
  while(j<nf){
    set32(kb,ko,get32(kb,ko)+1);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    if(fr==rel){
      if(fo==obj){
        let fs:i32=get32(A,4+j*12);
        if(n<cap){ set32(out,oo+4+n*4,fs); }
        n=n+1;
      }
    }
    j=j+1;
  }
  let stored:i32=n;
  if(stored>cap){ stored=cap; }
  if(n>cap){ set32(A,RET_OVF_OFF(),get32(A,RET_OVF_OFF())+1); return -1; }
  set32(out,oo,stored);
  return stored;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 1).
// Returns 1 iff every chain step matches at least one fact.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_gen: researcher-supplied generic COUNT (procedure id 4).
// INV-W2 (same rule): the distinct-object scratch capacity is derived from
// the caller's buffer.  If a NEW distinct object would not fit, the object is
// NOT stored, CNT_OVF is incremented, and -1 is returned so the enclosing
// operation refuses.  The old code silently returned 64 for 65 distinct
// objects (property lane V5, second half).
// seen: scratch [nseen, objs...], reset on entry.  Returns the distinct
// count, or -1 on overflow.
fn cnt_gen(A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  set32(seen,0,0);
  let cap:i32=(seen.len/4)-1;
  let nf:i32=get32(A,0);
  let ovf:i32=0;
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        if(fr==rel){
          let ns:i32=get32(seen,0);
          let f:i32=0;
          let dup:i32=0;
          while(f<ns){
            if(get32(seen,4+f*4)==fo){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            if(ns<cap){
              set32(seen,4+ns*4,fo);
              set32(seen,0,ns+1);
            } else {
              ovf=1;
            }
          }
        }
      }
      j=j+1;
    }
    si=si+1;
  }
  if(ovf==1){
    set32(A,CNT_OVF_OFF(),get32(A,CNT_OVF_OFF())+1);
    return -1;
  }
  return get32(seen,0);
}

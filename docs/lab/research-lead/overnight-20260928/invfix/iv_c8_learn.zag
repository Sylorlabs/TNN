// c4_learn.zag -- learner-owned procedures and learner-driven composition.
//
// Diamond follow-up to C422 (c3_learn.zag): plan records widened to 4
// needs per plan (56-byte entries), stats block moved to 13224, and
// apply_kind3 generalized to multi-source fan-in (preregistered).
// Binding by trial, topo assembly, version selection, plan
// persist/reuse/re-derive, and decline logic are the C422 logic
// unchanged.
// Learner-state L (16384 bytes):
//   RET region: 0: ret_nrel; 4: ret_rel_ids[16]; 68: ret_cnt[16];
//     132: ret_fidx[16][64]; 4228: ret_prov_parent (=0); 4232: ep0;
//     4236: ep1; 4240: nfacts; 4244: rev.
//   VFY region: 4248: vfy_nrel; 4252: vfy_rel_ids[16]; 4316: vfy_cnt[16];
//     4380: vfy_fidx[16][64]; 8476: vfy_prov_parent (=1); 8480: ep0;
//     8484: ep1; 8488: nfacts; 8492: rev.
//   CNT region: 8496: cnt_nrel; 8500: cnt_rel_ids[16]; 8564: cnt_cnt[16];
//     8628: cnt_fidx[16][64]; 12724: cnt_prov_parent (=4); 12728: ep0;
//     12732: ep1; 12736: nfacts; 12740: rev.
//   BIND table at 12744: 8 entries x 32 bytes:
//     [tag, bound_fam, ok0, f0, ok1, f1, ok2, f2].
//   PLAN table at 13000: 4 entries x 56 bytes:
//     [goal_tag, nneeds, idx0, tag0, fam0, idx1, tag1, fam1,
//      idx2, tag2, fam2, idx3, tag3, fam3].
//   Stats at 13224: plans_built, plans_loaded, trials, declines, agree,
//     cs, cg, ret_spec_uses, ret_gen_uses, vfy_spec_uses, vfy_gen_uses,
//     cnt_spec_uses, cnt_gen_uses.
//
// No world literals appear in this file: no goal tags, no need tags, no
// relation ids, no plan sequences. All content arrives at runtime through
// episodes, trials, and goal records.
// ---- retrieve working set ----
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  if(ret_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  if(ret_cov_find(L,r)<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
fn ret_cov_clear(L:[]u8)void { set32(L,0,0); return; }
// ---- verify working set ----
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  if(vfy_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  if(vfy_cov_find(L,r)<0){
    let n:i32=get32(L,4248);
    if(n<16){ set32(L,4252+n*4,r); set32(L,4248,n+1); }
  }
  return;
}
fn vfy_cov_clear(L:[]u8)void { set32(L,4248,0); return; }
// ---- count working set ----
fn cnt_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cnt_cov_has(L:[]u8,r:i32)i32 {
  if(cnt_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn cnt_log_rel(L:[]u8,r:i32)void {
  if(cnt_cov_find(L,r)<0){
    let n:i32=get32(L,8496);
    if(n<16){ set32(L,8500+n*4,r); set32(L,8496,n+1); }
  }
  return;
}
fn cnt_cov_clear(L:[]u8)void { set32(L,8496,0); return; }
// ---- specialize_ret: build the learner-owned indexed RETRIEVE ----
fn specialize_ret(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
// ---- specialize_vfy: build the learner-owned indexed VERIFY ----
fn specialize_vfy(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  return;
}
// ---- specialize_cnt: build the learner-owned indexed COUNT ----
// One linear pass over all facts; each fact whose relation is in the
// count working set is appended to that relation's bucket.
fn specialize_cnt(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,8564+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cnt_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,8564+bi*4);
      if(c0<64){
        set32(L,8628+(bi*64+c0)*4,j);
        set32(L,8564+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,12724,4);
  set32(L,12728,ep0);
  set32(L,12732,ep1);
  set32(L,12736,nf);
  set32(L,12740,get32(L,12740)+1);
  return;
}
// ---- ret_spec: the learner-owned specialized RETRIEVE (id 2) ----
// INV-W3: same rule as ret_gen.  The record capacity is passed in and the
// stored count is what is written and what is returned; overflow is -1.
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,cap:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let room:i32=(out.len-oo)/4-1;
  let cf:i32=cap;
  if(cf>room){ cf=room; }
  if(cf<0){ cf=0; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<cf){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  if(ns>cf){ set32(A,RET_OVF_OFF(),get32(A,RET_OVF_OFF())+1); return -1; }
  set32(out,oo,ns);
  return ns;
}
// ---- vfy_spec: the learner-owned specialized VERIFY (id 3) ----
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_spec: the learner-owned specialized COUNT (id 5) ----
// For each subject, scans only the learned bucket for the relation and
// collects distinct objects.
// INV-W2/P3 (the same rule as cnt_gen): the distinct-object scratch capacity
// is derived from the caller's buffer and checked before every write; the
// count reported is the count stored; overflow is a DISTINCT refusal.
// RETURN: -1 = relation outside learned coverage (frozen meaning),
//         -2 = distinct-object record full (loud refusal, nothing dropped).
fn cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let cf:i32=(seen.len/4)-1;
  if(cf<0){ return -2; }
  let ovf:i32=0;
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<cf){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          } else {
            ovf=1;
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  if(ovf==1){
    set32(A,CNT_OVF_OFF(),get32(A,CNT_OVF_OFF())+1);
    return -2;
  }
  return get32(seen,0);
}
// ---- episodes: experience steps ----
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0,IV_FLDMAX());
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
fn cnt_episode(L:[]u8,A:[]u8,rel:i32,subj:i32,kb:[]u8,tout:[]u8,seen:[]u8)i32 {
  cnt_log_rel(L,rel);
  set32(tout,0,subj);
  return cnt_gen(A,rel,tout,0,1,kb,12,seen);
}
// ---- per-need version selection from learned coverage ----
fn ret_version(L:[]u8,rel:i32)i32 {
  if(ret_cov_has(L,rel)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(vfy_cov_has(L,r)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
fn cnt_version(L:[]u8,rel:i32)i32 {
  if(cnt_cov_has(L,rel)==1){ return 5; }
  return 4;
}
// ---- goal record parsing (generic; no literals) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 {
  return get32(G,g_linkbase(G)+4+l*28+w*4);
}
// ---- working inputs: W holds per-need [nf, f0, ...] at W+n*ws ----
// ws comes from the LAYOUT RECORD (ly_ws), which is derived from the DECODED
// goal.  The frozen literal 80 is gone: a need with 40 fields used to
// overwrite the next need's record.
fn mat_inputs(G:[]u8,W:[]u8,ws:i32)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*ws,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*ws+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// ---- topological order over links (Kahn) ----
// The frozen version had no break, so it emitted the LAST ready node first
// and, worse, indexed ind/placed at a stride of 4 for a buffer allocated for
// 4 needs.  Buffers here are sized from the decoded nneeds.
fn topo(G:[]u8,ord:[]u8)void {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(nn*4);
  let placed:[]u8=z_alloc(nn*4);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  let stall:i32=0;
  while(stall==0){
    let n2:i32=0;
    let fnd:i32=-1;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    if(fnd<0){ stall=1; }
    if(fnd>=0){
      set32(placed,fnd*4,1);
      set32(ord,p*4,fnd);
      p=p+1;
      if(p>=nn){ stall=1; }
      let l2:i32=0;
      while(l2<nl){
        let d2:i32=link_w(G,l2,1);
        let s2:i32=link_w(G,l2,4);
        if(s2==fnd){
          if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
        }
        l2=l2+1;
      }
    }
  }
  let n3:i32=0;
  while(n3<nn){
    if(get32(placed,n3*4)==0){
      set32(ord,p*4,n3);
      p=p+1;
    }
    n3=n3+1;
  }
  return;
}
// ---- fan-out source: need with an incoming kind-2 link, else -1 ----
fn fanin_src(G:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==2){
      if(link_w(G,l,1)==ni){ return link_w(G,l,4); }
    }
    l=l+1;
  }
  return -1;
}
// ---- apply incoming kind-1 (scalar copy) links to need ni ----
fn apply_kind1(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32,ws:i32,os:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let ds:i32=link_w(G,l,3);
      let sn:i32=link_w(G,l,4);
      let sk:i32=link_w(G,l,5);
      let ss:i32=link_w(G,l,6);
      let v:i32=0;
      if(sk==0){ v=get32(W,sn*ws+4+ss*4); }
      if(sk==1){ v=get32(OUTS,sn*os+4+ss*4); }
      set32(W,ni*ws+4+ds*4,v);
    }
    l=l+1;
  }
  return;
}
// ---- apply incoming kind-3 (aggregate subject-list) links to need ni ----
// GENERALIZED: subjects from ALL incoming kind-3 links concatenate in
// goal-record link order into SUBL[ni*ss].  On a chain this is byte-identical
// to the frozen behaviour; on a diamond it is the generic fan-in.
// INVARIANT (C503 / W8): the fan-in total is CHECKED AGAINST THE RECORD'S
// OWN CAPACITY BEFORE EVERY WRITE.  The frozen code wrote SUBL[ni*128+4+tot*4]
// with tot unbounded, i.e. 80 subjects into a 32-entry record, and the
// surplus landed in malloc slack -- an accident, not a guarantee.
// Returns 1 if at least one kind-3 link targeted ni and the record held the
// whole fan-in, 0 if none did, -1 on a CAPACITY REFUSAL (nothing truncated,
// overflow counted, caller must decline).
fn apply_kind3(G:[]u8,OUTS:[]u8,SUBL:[]u8,ni:i32,os:i32,ss:i32,scap:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  let found:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==3){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        let n:i32=get32(OUTS,sn*os);
        if(n>0){
          if(n>scap){ return -1; }
          let k:i32=0;
          while(k<n){
            if(tot>=scap){ return -1; }
            set32(SUBL,ni*ss+4+tot*4,get32(OUTS,sn*os+4+k*4));
            tot=tot+1;
            k=k+1;
          }
        }
        found=1;
      }
    }
    l=l+1;
  }
  if(found==1){
    set32(SUBL,ni*ss,tot);
    return 1;
  }
  return 0;
}
// ---- binding table: SUPERSEDED (charter 51/158) --------------------
// The frozen BIND at 12744 (8 x 32 bytes, key = BARE NEED TAG) is REMOVED
// from active architecture.  A need tag is a PROJECTION of the need's content
// and one tag legitimately occurs in two structural roles, so the frozen memo
// returned one role's procedure for the other role (C501 probe D).  The
// replacement is the CONTENT-KEYED store in iv_inv.zag: key = (tag, nf,
// EVERY field), compared cell for cell, in a store whose capacity is
// recorded in its own header.
//
// `bind_find(L,tag)` and `bind_new(L,tag)` are retained ONLY as frozen-signature
// DIAGNOSTIC projections for harnesses that report "is there a binding with
// this tag?".  The engine never calls them for identity; each consult bumps
// IVS_PROJREF.  `bind_new` cannot exist at all under content identity: a
// binding cannot be created without its content, so it REFUSES.
fn bind_find(L:[]u8,tag:i32)i32 { return iv_bind_find_tag(L,tag); }
fn bind_new(L:[]u8,tag:i32)i32 {
  iv_bump(L,IVS_PROJREF());
  iv_bump(L,IVS_CAPREF());
  return -1;
}
fn bind_fam(L:[]u8,bi:i32)i32 { return iv_bind_fam(L,bi); }
// ---- try one procedure family on one need; 1 = consumed, 0 = refused ----
// Family 0 (RETRIEVE) accepts exactly 2-field needs (its arity).
// Family 1 (VERIFY) accepts records shaped as chains.
// Family 2 (COUNT) accepts exactly 3-field needs [rel, aggop, subj]
// with aggop == 1 (distinct-object count).
fn try_family(L:[]u8,A:[]u8,fam:i32,G:[]u8,n:i32,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8) i32 {
  let nf:i32=need_nf(G,n);
  if(fam==0){
    if(nf==2){
      ret_gen(A,need_f(G,n,0),need_f(G,n,1),K,8,tout,0,IV_FLDMAX());
      return 1;
    }
    return 0;
  }
  if(fam==1){
    if(nf>=4){
      let ns:i32=need_f(G,n,0);
      if(ns>=1){
        if(ns<=IV_TMPCHAIN()){
          if(nf==1+ns*3){
            set32(tmpc,0,ns);
            let i:i32=0;
            while(i<ns){
              set32(tmpc,4+i*12,need_f(G,n,1+i*3));
              set32(tmpc,4+i*12+4,need_f(G,n,1+i*3+1));
              set32(tmpc,4+i*12+8,need_f(G,n,1+i*3+2));
              i=i+1;
            }
            vfy_gen(A,tmpc,K,8);
            return 1;
          }
        }
      }
    }
    return 0;
  }
  if(nf==3){
    let ag:i32=need_f(G,n,1);
    if(ag==1){
      set32(tout,0,need_f(G,n,2));
      cnt_gen(A,need_f(G,n,0),tout,0,1,K,8,seen);
      return 1;
    }
  }
  return 0;
}
// ---- learn bindings for all unbound need CONTENT in the goal ----
// Returns 1 iff every need content ends bound; 0 if any need is unbindable.
// IDENTITY IS CONTENT (M1): the memo key is (tag, nf, every field).  The
// family a need gets is therefore a function of the need itself, not of the
// symbol that names it.
fn learn_bindings(L:[]u8,A:[]u8,G:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let bi:i32=iv_bind_find(L,G,n);
    let bi2:i32=bi;
    if(bi2<0){ bi2=iv_bind_new(L,G,n); }
    if(bi2<0){
      // capacity refusal: an unbound need means the goal is unanswerable
      n=n+1;
      continue;
    }
    if(iv_bind_fam(L,bi2)<0){
      let fam:i32=0;
      while(fam<3){
        set32(L,13232,get32(L,13232)+1);
        let r:i32=try_family(L,A,fam,G,n,K,tout,tmpc,seen);
        iv_bind_bump(L,bi2,fam*2);
        if(r==0){ iv_bind_bump(L,bi2,fam*2+1); }
        if(r==1){
          if(iv_bind_fam(L,bi2)<0){ iv_bind_setfam(L,bi2,fam); }
        }
        fam=fam+1;
      }
    }
    n=n+1;
  }
  let m:i32=0;
  while(m<nn){
    let b:i32=iv_bind_find(L,G,m);
    if(b<0){ return 0; }
    if(iv_bind_fam(L,b)<0){ return 0; }
    m=m+1;
  }
  return 1;
}
// ---- plan table: SUPERSEDED (charter 51/158) ------------------------
// The frozen PLAN at 13000 (4 x 56 bytes, key = BARE GOAL TAG, steps at a
// stride of 12 laid over a 56-byte entry) is REMOVED from active
// architecture.  Two independent failures came from that one entry:
//
//   P1  two goals with the same tag but different SHAPE share a key, so the
//       second goal executes the first goal's procedure and answers from a
//       record it never wrote (C501 probe B: answer {} instead of 1);
//   P2  stride 56 fits 4 steps, so step 5 of a 5-need goal wrote slot 1's
//       header (gtag := 0) and PLANTED A PHANTOM PLAN for the "no plan"
//       sentinel tag, which then answered 73 integers containing values that
//       were never in the world (C502 breaks A and B).
//
// The replacement is the VARIABLE-LENGTH CONTENT-KEYED store in iv_inv.zag:
// the key IS the canonical serialization of the whole goal (tag, nneeds,
// nlinks, every need's tag/nf/fields, every link's seven cells), compared
// cell for cell; records have no stride; the store's byte capacity is
// recorded in its own header and is checked BEFORE the bump, so an exhausted
// store refuses with a distinct code instead of writing over a neighbour.
//
// `plan_find(L,gtag)` is retained ONLY as a diagnostic projection.
fn plan_find(L:[]u8,gtag:i32)i32 { return iv_plan_find_tag(L,gtag); }
// plan_get_first: copy the first live plan's HEADER + first four steps into
// out as the frozen 14-int vector [gtag,nn,i0,t0,f0,i1,t1,f1,...].  The frozen
// version read a fixed 14 cells out of a 56-byte entry; here the cells come
// from the variable-length record and are truncated to the reader's window,
// with -1 for a step the record does not have.
fn plan_get_first(L:[]u8,out:[]u8)void {
  if(iv_magic_ok(L)==0){ set32(out,0,-1); return; }
  let A:[]u8=iv_raw(L);
  let ro:i32=get32(A,A_PHDR()+20);
  while(ro>=0){
    let b:i32=iv_prec(L,ro);
    let nn:i32=get32(A,b);
    if(nn>0){
      set32(out,0,get32(A,b+4));
      set32(out,4,nn);
      let p:i32=0;
      while(p<4){
        if(p<nn){
          let st:i32=iv_plan_step(L,ro,p);
          set32(out,8+p*12,get32(A,st));
          set32(out,8+p*12+4,get32(A,st+4));
          set32(out,8+p*12+8,get32(A,st+8));
        } else {
          set32(out,8+p*12,-1);
          set32(out,8+p*12+4,-1);
          set32(out,8+p*12+8,-1);
        }
        p=p+1;
      }
      return;
    }
    ro=get32(A,b+16);
  }
  set32(out,0,-1);
  return;
}
fn clear_plans(L:[]u8)void { iv_clear_plans(L); return; }
fn clear_bindings(L:[]u8)void { iv_clear_binds(L); return; }
// ---- answer assembly ----
// Every append is CAPACITY-CHECKED against the buffer's OWN length and
// returns -1 on refusal.  A refusal never leaves a partial record and never
// leaves the PREVIOUS goal's answer visible (C502 break D): compose zeroes
// the answer on every non-success return.
fn ans_append(ans:[]u8,v:i32)i32 { return iv_ans_append(ans,v); }
fn ans_append_rec(ans:[]u8,OUTS:[]u8,ni:i32,os:i32,ocap:i32)i32 {
  return iv_ans_append_rec(ans,OUTS,ni,os,ocap);
}
// ---- build a chain buffer from need W[ni]; sub>=0 fills s==0 slots ----
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32,ws:i32)void {
  let ns:i32=get32(W,n*ws+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*ws+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*ws+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*ws+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
// ---- execute one stored plan; ans gets the appended output records ----
// Returns 0 on success, -1 on a CAPACITY REFUSAL anywhere inside (answer
// buffer full, fan-in record full, output record refused by the procedure).
// A refusal is loud and leaves no answer behind.
fn execute_plan(L:[]u8,A:[]u8,G:[]u8,ro:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,LY:[]u8)i32 {
  let ws:i32=ly_ws(LY);
  let os:i32=ly_os(LY);
  let ss:i32=ly_ss(LY);
  let ocap:i32=ly_ocap(LY);
  let scap:i32=IV_FANINCAP();
  mat_inputs(G,W,ws);
  let nn:i32=iv_plan_nneeds(L,ro);
  set32(vbuf,16,nn);
  iv_ans_clear(ans);
  let p:i32=0;
  while(p<nn){
    let st:i32=iv_plan_step(L,ro,p);
    let A2:[]u8=iv_raw(L);
    let ni:i32=get32(A2,st);
    let fam:i32=get32(A2,st+8);
    apply_kind1(G,W,OUTS,ni,ws,os);
    let bad:i32=0;
    if(fam==0){
      let rel:i32=get32(W,ni*ws+4);
      let obj:i32=get32(W,ni*ws+8);
      let ver:i32=ret_version(L,rel);
      set32(vbuf,p*4,ver);
      if(ver==2){
        set32(L,13252,get32(L,13252)+1);
        let rs:i32=ret_spec(L,A,rel,obj,K,0,OUTS,ni*os,ocap);
        if(rs<0){ bad=1; }
      }
      if(ver==0){
        set32(L,13256,get32(L,13256)+1);
        let rr:i32=ret_gen(A,rel,obj,K,0,OUTS,ni*os,ocap);
        if(rr<0){ bad=1; }
      }
      if(ans_append_rec(ans,OUTS,ni,os,ocap)<0){ bad=1; }
    }
    if(fam==1){
      let ver2:i32=vfy_version(L,W,ni);
      set32(vbuf,p*4,ver2);
      if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
      if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
      let src:i32=fanin_src(G,ni);
      if(src<0){
        w_to_chain(W,ni,tmpc,-1,ws);
        let vv:i32=0;
        if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
        set32(OUTS,ni*os,1);
        set32(OUTS,ni*os+4,vv);
        if(ans_append_rec(ans,OUTS,ni,os,ocap)<0){ bad=1; }
      }
      if(src>=0){
        let nsub:i32=get32(OUTS,src*os);
        let npass:i32=0;
        let k:i32=0;
        while(k<nsub){
          let sub:i32=get32(OUTS,src*os+4+k*4);
          w_to_chain(W,ni,tmpc,sub,ws);
          let vv2:i32=0;
          if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
          if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
          if(vv2==1){
            if(npass>=ocap){ bad=1; k=nsub; }
            if(npass<ocap){
              set32(OUTS,ni*os+4+npass*4,sub);
              npass=npass+1;
            }
          }
          k=k+1;
        }
        set32(OUTS,ni*os,npass);
        if(ans_append_rec(ans,OUTS,ni,os,ocap)<0){ bad=1; }
      }
    }
    if(fam==2){
      let rel3:i32=get32(W,ni*ws+4);
      let ver3:i32=cnt_version(L,rel3);
      set32(vbuf,p*4,ver3);
      let has3:i32=apply_kind3(G,OUTS,SUBL,ni,os,ss,scap);
      let ns3:i32=0;
      if(has3==-1){
        bad=1;
        iv_bump(L,IVS_SUBLCAP());
        iv_bump(L,IVS_CAPREF());
      }
      if(has3==1){ ns3=get32(SUBL,ni*ss); }
      if(has3==0){
        set32(SUBL,ni*ss,1);
        set32(SUBL,ni*ss+4,get32(W,ni*ws+12));
        ns3=1;
      }
      let cc:i32=-2;
      if(ver3==5){
        set32(L,13268,get32(L,13268)+1);
        cc=cnt_spec(L,A,rel3,SUBL,ni*ss+4,ns3,K,0,seen);
      }
      if(ver3==4){
        set32(L,13272,get32(L,13272)+1);
        cc=cnt_gen(A,rel3,SUBL,ni*ss+4,ns3,K,0,seen);
      }
      if(cc==-2){ bad=1; iv_bump(L,IVS_OUTCAP()); }
      if(cc==-1){ iv_bump(L,IVS_MISMATCH()); }
      set32(OUTS,ni*os,1);
      if(cc>=0){ set32(OUTS,ni*os+4,cc); }
      if(ans_append_rec(ans,OUTS,ni,os,ocap)<0){ bad=1; }
    }
    if(bad==1){ iv_ans_clear(ans); return -1; }
    p=p+1;
  }
  return 0;
}
// ---- compose: the learner-driven composition entry point ----
// RETURN CODES (frozen 0/1/2 preserved; refusals are NEW, DISTINCT codes so
// a caller can tell "I do not know" from "I refused to guess"):
//   0  declined        -- at least one need content could not be bound
//   1  plan loaded     -- an existing plan for THIS goal's content executed
//   2  plan built      -- a new plan for this content was created
//   3  goal refused    -- the goal record does not decode (ivg_ok > 0)
//   4  capacity refused-- a working buffer, the plan store or the answer
//                         buffer is at its recorded capacity
//   5  store violation -- iv_check found the store inconsistent
// On EVERY code except 1 and 2 the answer buffer is ZEROED.  The frozen code
// returned 2 ("built") after plan_new returned -1 and executed a plan at
// negative offsets, and returned 0 (declined) leaving the previous goal's
// answer in place.
fn compose(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  if(iv_ensure(L)<1){ iv_ans_clear(ans); return 5; }
  if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
  let bad:i32=ivg_ok(G);
  if(bad>0){
    iv_bump(L,IVS_DECODE());
    iv_ans_clear(ans);
    return 3;
  }
  let nn:i32=ivg_nneeds(G);
  let nf:i32=ivg_nfmax(G);
  let nl:i32=ivg_nlinks(G);
  let ocap:i32=A_OCAP(A);
  let LY:[]u8=z_alloc(32);
  ly_set(LY,nn,nf,nl,ocap);
  let W:[]u8=z_alloc(nn*ly_ws(LY));
  let OUTS:[]u8=z_alloc(nn*ly_os(LY));
  let tout:[]u8=z_alloc(4);
  let tmpc:[]u8=z_alloc(4+IV_TMPCHAIN()*12);
  let ord:[]u8=z_alloc(nn*4);
  let SUBL:[]u8=z_alloc(nn*ly_ss(LY));
  let seen:[]u8=z_alloc(4+IV_SEENCAP()*4);
  let cells:[]u8=z_alloc(IV_CELLCAP()*4);
  let gate:i32=iv_gate(LY,W,OUTS,ord,SUBL,seen,tout,tmpc);
  if(gate>0){
    iv_bump(L,IVS_BUFGATE());
    iv_bump(L,IVS_CAPREF());
    iv_ans_clear(ans);
    return 4;
  }
  let nc:i32=ivg_cells(G,cells);
  if(nc<1){
    iv_bump(L,IVS_DECODE());
    iv_ans_clear(ans);
    return 3;
  }
  let ro:i32=iv_plan_find(L,G,cells,nc);
  if(ro<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      iv_ans_clear(ans);
      return 0;
    }
    topo(G,ord);
    let ro2:i32=iv_plan_new(L,G,ord,cells,nc);
    if(ro2<0){
      iv_ans_clear(ans);
      return 4;
    }
    let rc2:i32=execute_plan(L,A,G,ro2,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,LY);
    if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
    if(rc2<0){ iv_ans_clear(ans); return 4; }
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  let rc:i32=execute_plan(L,A,G,ro,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,LY);
  if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
  if(rc<0){ iv_ans_clear(ans); return 4; }
  return 1;
}

// =====================================================================
// c5 ADDITIVE GENERALIZATION (PREREG Section 2.2).
// Everything above this line is byte-identical to c4_learn.zag
// (cogops-diamond). What follows is purely additive: no C433
// function is modified. Frozen entry points keep their names:
// compose, execute_plan, topo, apply_kind1.
// New entry points: topo_g, apply_kind1_g, snap_out, out_eq_snap,
// exec_step_iter, execute_plan_iter, compose_iter, plan_drop.
// No world literals, no goal tags, no need tags, no relation ids
// appear below: all content arrives at runtime through goal records.
// =====================================================================

// ---- topo_g: Kahn with stall detection + deterministic fallback ----
// Runs Kahn; if no zero-indegree unplaced node remains, stops
// (instead of the frozen topo's re-place-node-0, which silently
// corrupts the order) and appends the unplaced needs in index
// order. Returns the Kahn-placed count (== nneeds on a DAG).
// Not cycle detection: it completes any partial order
// deterministically, with no goal-shape or back-edge test.
fn topo_g(G:[]u8,ord:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  let stall:i32=0;
  while(stall==0){
    let n2:i32=0;
    let fnd:i32=-1;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    if(fnd<0){ stall=1; }
    if(fnd>=0){
      set32(placed,fnd*4,1);
      set32(ord,p*4,fnd);
      p=p+1;
      if(p>=nn){ stall=1; }
      let l2:i32=0;
      while(l2<nl){
        let d2:i32=link_w(G,l2,1);
        let s2:i32=link_w(G,l2,4);
        if(s2==fnd){
          if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
        }
        l2=l2+1;
      }
    }
  }
  let kplaced:i32=p;
  let n3:i32=0;
  while(n3<nn){
    if(get32(placed,n3*4)==0){
      set32(ord,p*4,n3);
      p=p+1;
    }
    n3=n3+1;
  }
  return kplaced;
}
// ---- apply_kind1_g: kind-1 links fire only from non-empty sources ----
// Uniform dataflow rule: a scalar-copy link carries the source
// need's produced value; if the source output record is empty
// there is no value to carry, so the destination field keeps its
// current value. Identical to apply_kind1 whenever every kind-1
// source is non-empty (the whole C433 battery).
fn apply_kind1_g(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32,ws:i32,os:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let sn:i32=link_w(G,l,4);
      if(get32(OUTS,sn*os)>0){
        let ds:i32=link_w(G,l,3);
        let sk:i32=link_w(G,l,5);
        let ss:i32=link_w(G,l,6);
        let v:i32=0;
        if(sk==0){ v=get32(W,sn*ws+4+ss*4); }
        if(sk==1){ v=get32(OUTS,sn*os+4+ss*4); }
        set32(W,ni*ws+4+ds*4,v);
      }
    }
    l=l+1;
  }
  return;
}
// ---- output-record snapshot / comparison helpers ----
fn snap_out(OUTS:[]u8,ni:i32,snap:[]u8,os:i32)void {
  let n:i32=get32(OUTS,ni*os);
  if(n>8){ n=8; }
  set32(snap,0,n);
  let k:i32=0;
  while(k<n){
    set32(snap,4+k*4,get32(OUTS,ni*os+4+k*4));
    k=k+1;
  }
  return;
}
fn out_eq_snap(OUTS:[]u8,ni:i32,snap:[]u8,os:i32)i32 {
  let n:i32=get32(OUTS,ni*os);
  if(n!=get32(snap,0)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(OUTS,ni*os+4+k*4)!=get32(snap,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- exec_step_iter: execute one plan step with the generalized link rule ----
// Versions recorded to vbuf[p*4]. No answer emission; the caller
// emits final records after quiescence.
// `ro` is the CONTENT-KEYED plan record; every stride comes from LY.
// Returns -1 on a capacity refusal (the caller must decline, not answer).
fn exec_step_iter(L:[]u8,A:[]u8,G:[]u8,ro:i32,p:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,LY:[]u8)i32 {
  let ws:i32=ly_ws(LY);
  let os:i32=ly_os(LY);
  let ss:i32=ly_ss(LY);
  let ocap:i32=ly_ocap(LY);
  let st:i32=iv_plan_step(L,ro,p);
  let AR:[]u8=iv_raw(L);
  let ni:i32=get32(AR,st);
  let fam:i32=get32(AR,st+8);
  apply_kind1_g(G,W,OUTS,ni,ws,os);
  let bad:i32=0;
  if(fam==0){
    let rel:i32=get32(W,ni*ws+4);
    let obj:i32=get32(W,ni*ws+8);
    let ver:i32=ret_version(L,rel);
    set32(vbuf,p*4,ver);
    if(ver==2){
      set32(L,13252,get32(L,13252)+1);
      let rs:i32=ret_spec(L,A,rel,obj,K,0,OUTS,ni*os,ocap);
      if(rs<0){ bad=1; }
    }
    if(ver==0){
      set32(L,13256,get32(L,13256)+1);
      let rr:i32=ret_gen(A,rel,obj,K,0,OUTS,ni*os,ocap);
      if(rr<0){ bad=1; }
    }
  }
  if(fam==1){
    let ver2:i32=vfy_version(L,W,ni);
    set32(vbuf,p*4,ver2);
    if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
    if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
    let src:i32=fanin_src(G,ni);
    if(src<0){
      w_to_chain(W,ni,tmpc,-1,ws);
      let vv:i32=0;
      if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
      if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
      set32(OUTS,ni*os,1);
      set32(OUTS,ni*os+4,vv);
    }
    if(src>=0){
      let nsub:i32=get32(OUTS,src*os);
      let npass:i32=0;
      let k:i32=0;
      while(k<nsub){
        let sub:i32=get32(OUTS,src*os+4+k*4);
        w_to_chain(W,ni,tmpc,sub,ws);
        let vv2:i32=0;
        if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
        if(vv2==1){
          if(npass>=ocap){ bad=1; k=nsub; }
          if(npass<ocap){
            set32(OUTS,ni*os+4+npass*4,sub);
            npass=npass+1;
          }
        }
        k=k+1;
      }
      set32(OUTS,ni*os,npass);
    }
  }
  if(fam==2){
    let rel3:i32=get32(W,ni*ws+4);
    let ver3:i32=cnt_version(L,rel3);
    set32(vbuf,p*4,ver3);
    let has3:i32=apply_kind3(G,OUTS,SUBL,ni,os,ss,IV_FANINCAP());
    let ns3:i32=0;
    if(has3==-1){ bad=1; iv_bump(L,IVS_SUBLCAP()); iv_bump(L,IVS_CAPREF()); }
    if(has3==1){ ns3=get32(SUBL,ni*ss); }
    if(has3==0){
      set32(SUBL,ni*ss,1);
      set32(SUBL,ni*ss+4,get32(W,ni*ws+12));
      ns3=1;
    }
    let cc:i32=0;
    if(ver3==5){
      set32(L,13268,get32(L,13268)+1);
      cc=cnt_spec(L,A,rel3,SUBL,ni*ss+4,ns3,K,0,seen);
    }
    if(ver3==4){
      set32(L,13272,get32(L,13272)+1);
      cc=cnt_gen(A,rel3,SUBL,ni*ss+4,ns3,K,0,seen);
    }
    if(cc==-2){ bad=1; iv_bump(L,IVS_OUTCAP()); }
    set32(OUTS,ni*os,1);
    set32(OUTS,ni*os+4,cc);
  }
  if(bad==1){ return -1; }
  return 0;
}
// ---- execute_plan_iter: change-driven iterated execution ----
// Steps run in plan order; a need executes when dirty (all start
// dirty). If its output record changed, link-successors are marked
// dirty. Halts on quiescence (a pass with no dirty need) or the
// pass CAP (16, frozen totality bound). Answer records are emitted
// in plan order with FINAL values. vbuf[20] gets passes used.
fn execute_plan_iter(L:[]u8,A:[]u8,G:[]u8,ro:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,dirty:[]u8,snap:[]u8,LY:[]u8)i32 {
  let os:i32=ly_os(LY);
  let ocap:i32=ly_ocap(LY);
  mat_inputs(G,W,ly_ws(LY));
  let nn:i32=iv_plan_nneeds(L,ro);
  let nl:i32=g_nlinks(G);
  set32(vbuf,16,nn);
  iv_ans_clear(ans);
  let n:i32=0;
  while(n<nn){ set32(dirty,n*4,1); n=n+1; }
  let pass:i32=0;
  let cap:i32=16;
  let running:i32=1;
  let bad:i32=0;
  while(running==1){
    if(pass>=cap){ running=0; }
    if(running==1){
      let progressed:i32=0;
      let p:i32=0;
      while(p<nn){
        let AR:[]u8=iv_raw(L);
        let ni:i32=get32(AR,iv_plan_step(L,ro,p));
        if(get32(dirty,ni*4)==1){
          progressed=1;
          set32(dirty,ni*4,0);
          snap_out(OUTS,ni,snap,os);
          let er:i32=exec_step_iter(L,A,G,ro,p,K,vbuf,W,OUTS,tmpc,SUBL,seen,LY);
          if(er<0){ bad=1; running=0; p=nn; }
          if(er>=0){
            if(out_eq_snap(OUTS,ni,snap,os)==0){
              let l:i32=0;
              while(l<nl){
                if(link_w(G,l,4)==ni){
                  set32(dirty,link_w(G,l,1)*4,1);
                }
                l=l+1;
              }
            }
          }
        }
        p=p+1;
      }
      pass=pass+1;
      if(progressed==0){ running=0; }
    }
  }
  set32(vbuf,20,pass);
  if(bad==1){ iv_ans_clear(ans); return -1; }
  let q:i32=0;
  while(q<nn){
    let AR2:[]u8=iv_raw(L);
    let nj:i32=get32(AR2,iv_plan_step(L,ro,q));
    if(ans_append_rec(ans,OUTS,nj,os,ocap)<0){ iv_ans_clear(ans); return -1; }
    q=q+1;
  }
  return 0;
}
// ---- compose_iter: the generalized composition entry point ----
// Returns 0 = declined, 1 = plan loaded, 2 = plan built.
// vbuf[16] = nneeds, vbuf[20] = passes used; ans = final records.
fn compose_iter(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  if(iv_ensure(L)<1){ iv_ans_clear(ans); return 5; }
  if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
  let bad0:i32=ivg_ok(G);
  if(bad0>0){ iv_bump(L,IVS_DECODE()); iv_ans_clear(ans); return 3; }
  let nn:i32=ivg_nneeds(G);
  let nf:i32=ivg_nfmax(G);
  let nl:i32=ivg_nlinks(G);
  let ocap:i32=A_OCAP(A);
  let LY:[]u8=z_alloc(32);
  ly_set(LY,nn,nf,nl,ocap);
  let W:[]u8=z_alloc(nn*ly_ws(LY));
  let OUTS:[]u8=z_alloc(nn*ly_os(LY));
  let tout:[]u8=z_alloc(4);
  let tmpc:[]u8=z_alloc(4+IV_TMPCHAIN()*12);
  let ord:[]u8=z_alloc(nn*4);
  let SUBL:[]u8=z_alloc(nn*ly_ss(LY));
  let seen:[]u8=z_alloc(4+IV_SEENCAP()*4);
  let dirty:[]u8=z_alloc(nn*4);
  let snap:[]u8=z_alloc(4+8*4);
  let cells:[]u8=z_alloc(IV_CELLCAP()*4);
  let gate:i32=iv_gate(LY,W,OUTS,ord,SUBL,seen,tout,tmpc);
  if(gate>0){
    iv_bump(L,IVS_BUFGATE()); iv_bump(L,IVS_CAPREF()); iv_ans_clear(ans); return 4;
  }
  let nc:i32=ivg_cells(G,cells);
  if(nc<1){ iv_bump(L,IVS_DECODE()); iv_ans_clear(ans); return 3; }
  let ro:i32=iv_plan_find(L,G,cells,nc);
  if(ro<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      iv_ans_clear(ans);
      return 0;
    }
    topo_g(G,ord);
    let ro2:i32=iv_plan_new(L,G,ord,cells,nc);
    if(ro2<0){ iv_ans_clear(ans); return 4; }
    let rc2:i32=execute_plan_iter(L,A,G,ro2,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap,LY);
    if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
    if(rc2<0){ iv_ans_clear(ans); return 4; }
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  let rc:i32=execute_plan_iter(L,A,G,ro,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap,LY);
  if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
  if(rc<0){ iv_ans_clear(ans); return 4; }
  return 1;
}
// ---- plan_drop: drop the stored plan for one goal tag -----------------
// IDENTITY IS CONTENT.  Dropping "the plan for goal tag T" is a PROJECTION
// operation and could discard a plan that is not the caller's.  The frozen
// signature is kept for compatibility, so this drops every live plan whose
// goal TAG matches AND records the fact that a projection was used; the
// content-exact drop is iv_plan_drop(L,ro).
fn plan_drop(L:[]u8,gtag:i32)void {
  if(iv_magic_ok(L)==0){ return; }
  iv_bump(L,IVS_PROJREF());
  let A:[]u8=iv_raw(L);
  let ro:i32=get32(A,A_PHDR()+20);
  while(ro>=0){
    let b:i32=iv_prec(L,ro);
    let nx:i32=get32(A,b+16);
    if(get32(A,b+4)==gtag){ iv_plan_free(L,ro); }
    ro=nx;
  }
  return;
}

// =====================================================================
// c7 ADDITIVE: learner-invented oscillation handling.
// Everything above this line is byte-identical to c6_learn.zag
// (cogops-oscillatory). What follows is purely additive: no frozen
// function is modified. New entry points: traj_base, outc_base,
// outc_phase_base, traj_log, traj_need_eq, traj_state_eq,
// osc_review, outc_find, outc_phase_copy, outc_store,
// outc_phase_eq, osc_one_pass, osc_handle.
// Learner-state regions (L holds 16384 bytes; prior use ends at
// 13276):
//   TRAJ at 13300: [ntraj]; snapshots at 13304+(pass*4+ni)*36,
//   pass below 8, ni below 4; each need snapshot is nine i32
//   cells [n, v0..v7].
//   OUTC at 14500: [nout]; at most three entries of 464 bytes at
//   14504+e*464: [goal_tag, lag, nph, src, four reserved cells,
//   then phases: at most three phases times four needs times
//   nine i32 cells].
// No world literals, no goal tags, no need tags, no relation ids
// appear below: every value arrives at runtime through goal
// records, episodes, or the trajectory.
// =====================================================================

fn traj_base(pass:i32,ni:i32)i32 { return 13304+(pass*4+ni)*36; }
fn outc_base(e:i32)i32 { return 14504+e*464; }
fn outc_phase_base(e:i32,t:i32,ni:i32)i32 {
  return 14504+e*464+32+(t*4+ni)*36;
}
// snapshot every need's output record after one pass
fn traj_log(L:[]u8,OUTS:[]u8,nn:i32,pass:i32,os:i32)void {
  if(pass<0){ return; }
  if(pass>7){ return; }
  let j:i32=0;
  while(j<nn){
    let n:i32=get32(OUTS,j*os);
    if(n>8){ n=8; }
    let bo:i32=traj_base(pass,j);
    set32(L,bo,n);
    let k:i32=0;
    while(k<8){
      let v:i32=0;
      if(k<n){ v=get32(OUTS,j*os+4+k*4); }
      set32(L,bo+4+k*4,v);
      k=k+1;
    }
    j=j+1;
  }
  set32(L,13300,pass+1);
  return;
}
fn traj_need_eq(L:[]u8,p:i32,q:i32,ni:i32)i32 {
  let bp:i32=traj_base(p,ni);
  let bq:i32=traj_base(q,ni);
  let n:i32=get32(L,bp);
  if(n!=get32(L,bq)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(L,bp+4+k*4)!=get32(L,bq+4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
fn traj_state_eq(L:[]u8,p:i32,q:i32,nn:i32)i32 {
  let j:i32=0;
  while(j<nn){
    if(traj_need_eq(L,p,q,j)==0){ return 0; }
    j=j+1;
  }
  return 1;
}
// nearest-first scan: does snapshot[pass] equal an earlier
// snapshot? Returns the lag, or zero when nothing recurs.
fn osc_review(L:[]u8,nn:i32,pass:i32)i32 {
  let q:i32=pass-1;
  while(q>=0){
    if(traj_state_eq(L,pass,q,nn)==1){ return pass-q; }
    q=q-1;
  }
  return 0;
}
// IDENTITY IS CONTENT (P1): the outcome record is keyed by the CONTENT-KEYED
// PLAN RECORD OFFSET, not by the bare goal tag.  Two goals sharing a tag now
// get separate outcome records instead of sharing one lag.
fn outc_find(L:[]u8,key:i32)i32 {
  let n:i32=get32(L,14500);
  let e:i32=0;
  while(e<n){
    if(get32(L,outc_base(e))==key){ return e; }
    e=e+1;
  }
  return -1;
}
fn outc_phase_copy(L:[]u8,e:i32,t:i32,ni:i32,p:i32)void {
  let sb:i32=traj_base(p,ni);
  let db:i32=outc_phase_base(e,t,ni);
  let k:i32=0;
  while(k<9){
    set32(L,db+k*4,get32(L,sb+k*4));
    k=k+1;
  }
  return;
}
fn outc_store(L:[]u8,key:i32,lag:i32,q:i32,nn:i32,src:i32)i32 {
  let e:i32=outc_find(L,key);
  if(e<0){
    e=get32(L,14500);
    if(e>2){ e=0; }
    if(get32(L,14500)<3){ set32(L,14500,get32(L,14500)+1); }
  }
  let b:i32=outc_base(e);
  set32(L,b,key);
  set32(L,b+4,lag);
  set32(L,b+8,lag);
  set32(L,b+12,src);
  set32(L,b+16,0);
  set32(L,b+20,0);
  set32(L,b+24,0);
  set32(L,b+28,0);
  let t:i32=0;
  while(t<lag){
    let j:i32=0;
    while(j<nn){
      outc_phase_copy(L,e,t,j,q+t);
      j=j+1;
    }
    t=t+1;
  }
  return e;
}
// stored phase (e,t,ni) against trajectory snapshot p
fn outc_phase_eq(L:[]u8,e:i32,t:i32,ni:i32,p:i32)i32 {
  let db:i32=outc_phase_base(e,t,ni);
  let sb:i32=traj_base(p,ni);
  let n:i32=get32(L,db);
  if(n!=get32(L,sb)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(L,db+4+k*4)!=get32(L,sb+4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// one full pass over the plan in plan order; R+28 is the
// spec-version flag, cleared if any step misses its spec version
fn osc_one_pass(L:[]u8,A:[]u8,G:[]u8,ro:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,LY:[]u8)i32 {
  let nn:i32=iv_plan_nneeds(L,ro);
  let bad:i32=0;
  let p:i32=0;
  while(p<nn){
    let er:i32=exec_step_iter(L,A,G,ro,p,K,vbuf,W,OUTS,tmpc,SUBL,seen,LY);
    if(er<0){ bad=1; }
    let AR:[]u8=iv_raw(L);
    let fam:i32=get32(AR,iv_plan_step(L,ro,p)+8);
    let ver:i32=get32(vbuf,p*4);
    let want:i32=-1;
    if(fam==0){ want=2; }
    if(fam==1){ want=3; }
    if(fam==2){ want=5; }
    if(ver!=want){ set32(R,28,0); }
    p=p+1;
  }
  if(bad==1){ return -1; }
  return 0;
}
// osc_handle: the learner-owned oscillation-handling driver.
// R holds [how, passes, lag, q, nph, src, entry, specok].
// Returns -1 declined, 0 no handling (generic fallback applies),
// 1 handled by a response invented from this trajectory,
// 2 handled by a stored response from the outcome record.
fn osc_handle(L:[]u8,A:[]u8,G:[]u8,K:[]u8,R:[]u8)i32 {
  if(iv_ensure(L)<1){ return -1; }
  if(iv_record_check(L)>0){ return -1; }
  let bd:i32=ivg_ok(G);
  if(bd>0){ iv_bump(L,IVS_DECODE()); return -1; }
  let nn:i32=ivg_nneeds(G);
  let nf:i32=ivg_nfmax(G);
  let nl:i32=ivg_nlinks(G);
  let ocap:i32=A_OCAP(A);
  let LY:[]u8=z_alloc(32);
  ly_set(LY,nn,nf,nl,ocap);
  let W:[]u8=z_alloc(nn*ly_ws(LY));
  let OUTS:[]u8=z_alloc(nn*ly_os(LY));
  let tout:[]u8=z_alloc(4);
  let tmpc:[]u8=z_alloc(4+IV_TMPCHAIN()*12);
  let ord:[]u8=z_alloc(nn*4);
  let SUBL:[]u8=z_alloc(nn*ly_ss(LY));
  let seen:[]u8=z_alloc(4+IV_SEENCAP()*4);
  let vbuf:[]u8=z_alloc(32);
  let cells:[]u8=z_alloc(IV_CELLCAP()*4);
  set32(R,0,0);
  set32(R,4,0);
  set32(R,8,0);
  set32(R,12,0);
  set32(R,16,0);
  set32(R,20,0);
  set32(R,24,-1);
  set32(R,28,1);
  if(iv_gate(LY,W,OUTS,ord,SUBL,seen,tout,tmpc)>0){
    iv_bump(L,IVS_BUFGATE()); iv_bump(L,IVS_CAPREF()); return -1;
  }
  let nc:i32=ivg_cells(G,cells);
  if(nc<1){ iv_bump(L,IVS_DECODE()); return -1; }
  let pre:i32=iv_plan_find(L,G,cells,nc);
  let ro:i32=pre;
  if(ro<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return -1;
    }
    topo_g(G,ord);
    ro=iv_plan_new(L,G,ord,cells,nc);
  }
  if(ro<0){ return -1; }
  if(pre>=0){ set32(L,13228,get32(L,13228)+1); }
  mat_inputs(G,W,ly_ws(LY));
  let e:i32=outc_find(L,ro);
  if(e>=0){
    let lag0:i32=get32(L,outc_base(e)+4);
    let mpass:i32=0;
    let okk:i32=1;
    while(mpass<2){
      if(okk==1){
        osc_one_pass(L,A,G,ro,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,LY);
        traj_log(L,OUTS,nn,mpass,ly_os(LY));
        let jj:i32=0;
        while(jj<nn){
          if(outc_phase_eq(L,e,mpass,jj,mpass)==0){ okk=0; }
          jj=jj+1;
        }
      }
      mpass=mpass+1;
    }
    if(okk==1){
      set32(R,0,2);
      set32(R,4,2);
      set32(R,8,lag0);
      set32(R,12,0);
      set32(R,16,lag0);
      set32(R,20,1);
      set32(R,24,e);
      return 2;
    }
    set32(L,13300,0);
  }
  let pass:i32=0;
  while(pass<6){
    osc_one_pass(L,A,G,ro,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,LY);
    traj_log(L,OUTS,nn,pass,ly_os(LY));
    if(pass>1){
      let lag:i32=osc_review(L,nn,pass);
      if(lag==1){ return 0; }
      if(lag>1){
        if(lag<4){
          let q0:i32=pass-lag;
          osc_one_pass(L,A,G,ro,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,LY);
          traj_log(L,OUTS,nn,pass+1,ly_os(LY));
          if(traj_state_eq(L,pass+1,q0+1,nn)==1){
            let ee:i32=outc_store(L,ro,lag,q0,nn,0);
            set32(R,0,1);
            set32(R,4,pass+2);
            set32(R,8,lag);
            set32(R,12,q0);
            set32(R,16,lag);
            set32(R,20,0);
            set32(R,24,ee);
            return 1;
          }
          return 0;
        }
      }
    }
    pass=pass+1;
  }
  return 0;
}

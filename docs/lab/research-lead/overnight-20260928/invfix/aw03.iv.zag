// iv_c15_base.zag -- INVARIANT-FIXED copy of cogops_rescueaware/c15_base.zag
// (sha256 fc1f6e73c43ae8e4ea2b7af50f1606cc4b6c5353992bd5d4411cb4c9a3b73e61,
// 174 lines).  The original is NOT modified.
//
// WHAT CHANGED, and the invariant each change installs (C510 prereg M2):
//
//  INV-W1  EXPLICIT FACT CAPACITY.  world_new writes the fact-store capacity
//          into the arena header (A+1544) instead of it being a literal inside
//          fact_add.  fact_add CHECKS THAT RECORD BEFORE WRITING and returns
//          -1 on refusal; A+1548 counts refusals.  The old fact_add returned
//          void and dropped the fact silently at 128 (property lane V6).
//
//  INV-W2  REPORTED COUNT == STORED COUNT.  ret_gen and cnt_gen previously
//          stored min(n,32)/min(ns,64) but reported the UNCLAMPED n, so every
//          consumer read values that were never written (C503).  Both now
//          write the STORED count into the record header and return the STORED
//          count.  When the true count exceeds the record's own capacity the
//          overflow is counted (A+1556 / A+1560) and the enclosing operation
//          must refuse; it may not answer from a partial record.
//
// Every other line is behaviourally identical to the original: the scan
// order, the check-counter increments, the dedup order and the outputs are
// unchanged whenever no capacity is exceeded.
//
// Output rule: dynamic content is formatted into one buffer.  `o_flush` is
// redefined here with the brief-4.0 `_zag_print` shim because the original
// used the inert `_zag_raw_syscall`.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_print(b[0..c]);
  return;
}
// ============ world arena: explicit capacity header (INV-W1) ============
// Header cells (previously unused slack, so no behaviour moves):
//   1544 FACT_CAP   explicit fact-store capacity, written by world_new
//   1548 FACT_OVF   fact_add refusals (capacity exhausted)
//   1552 RET_OVF    ret_gen subject-record overflow events
//   1556 CNT_OVF    cnt_gen distinct-object overflow events
//   1560 VFY_OVF    reserved for the verify record
fn FACT_CAP_OFF()i32 { return 1544; }
fn FACT_OVF_OFF()i32 { return 1548; }
fn RET_OVF_OFF()i32  { return 1552; }
fn CNT_OVF_OFF()i32  { return 1556; }
fn world_new()[]u8 {
  let A:[]u8=z_alloc(4096);
  set32(A,FACT_CAP_OFF(),128);
  set32(A,FACT_OVF_OFF(),0);
  set32(A,RET_OVF_OFF(),0);
  set32(A,CNT_OVF_OFF(),0);
  return A;
}
fn fact_cap(A:[]u8)i32 { return get32(A,FACT_CAP_OFF()); }
// A_OCAP: the EXPLICIT output-record capacity, derived from the world's
// recorded fact capacity.  A RETRIEVE record cannot need more entries than
// the world has facts, so this is an upper bound, not a tuned constant.  The
// caller passes it down to every record writer.
fn A_OCAP(A:[]u8)i32 {
  let c:i32=get32(A,FACT_CAP_OFF());
  if(c<1){ c=1; }
  return c;
}
fn fact_ovf(A:[]u8)i32 { return get32(A,FACT_OVF_OFF()); }
fn ret_ovf(A:[]u8)i32  { return get32(A,RET_OVF_OFF()); }
fn cnt_ovf(A:[]u8)i32  { return get32(A,CNT_OVF_OFF()); }
// fact_add: 1 = written, -1 = REFUSED (capacity exhausted, nothing written).
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=get32(A,0);
  let cap:i32=fact_cap(A);
  if(n>=cap){
    set32(A,FACT_OVF_OFF(),get32(A,FACT_OVF_OFF())+1);
    return -1;
  }
  set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
  set32(A,0,n+1);
  return 1;
}
// ---- chain: 0: nsteps; 4: steps, 16 * 12 bytes ----
fn chain_new()[]u8 { return z_alloc(512); }
fn chain_clear(C:[]u8)void { set32(C,0,0); return; }
fn chain_add(C:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=get32(C,0);
  if(n<16){
    set32(C,4+n*12,s); set32(C,4+n*12+4,r); set32(C,4+n*12+8,o);
    set32(C,0,n+1);
  }
  return;
}
// ---- ret_gen: researcher-supplied generic RETRIEVE (procedure id 0).
// INV-W2: the record's own capacity is derived from the caller's buffer
// length -- an explicit, caller-visible record capacity, not a literal --
// and is CHECKED BEFORE EVERY WRITE.  The count written into out[oo] and
// the value returned are both the STORED count.  If the true match count
// exceeds the record capacity the surplus is discarded, RET_OVF is
// incremented, and the caller is expected to refuse; the returned count is
// never larger than the number of subjects actually written.
// INV-W3  CAPACITY IS AN EXPLICIT, CALLER-VISIBLE RECORD, NOT A LITERAL.
// The caller passes `cap`, the number of entries the ONE record at `oo` can
// hold.  It is derived by the caller from the record's own stride, and it is
// additionally bounded here by what the buffer physically has left, so a
// caller that lies about `cap` still cannot write out of bounds.
fn ret_gen(A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,cap:i32)i32 {
  let nf:i32=get32(A,0);
  let room:i32=(out.len-oo)/4-1;
  if(cap>room){ cap=room; }
  if(cap<0){ cap=0; }
  let n:i32=0;
  let j:i32=0;
  while(j<nf){
    set32(kb,ko,get32(kb,ko)+1);
    let fr:i32=get32(A,4+j*12+4);
    let fo:i32=get32(A,4+j*12+8);
    if(fr==rel){
      if(fo==obj){
        let fs:i32=get32(A,4+j*12);
        if(n<cap){ set32(out,oo+4+n*4,fs); }
        n=n+1;
      }
    }
    j=j+1;
  }
  let stored:i32=n;
  if(stored>cap){ stored=cap; }
  if(n>cap){ set32(A,RET_OVF_OFF(),get32(A,RET_OVF_OFF())+1); return -1; }
  set32(out,oo,stored);
  return stored;
}
// ---- vfy_gen: researcher-supplied generic VERIFY (procedure id 1).
// Returns 1 iff every chain step matches at least one fact.
fn vfy_gen(A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let nf:i32=get32(A,0);
    let hit:i32=0;
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      j=j+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_gen: researcher-supplied generic COUNT (procedure id 4).
// INV-W2 (same rule): the distinct-object scratch capacity is derived from
// the caller's buffer.  If a NEW distinct object would not fit, the object is
// NOT stored, CNT_OVF is incremented, and -1 is returned so the enclosing
// operation refuses.  The old code silently returned 64 for 65 distinct
// objects (property lane V5, second half).
// seen: scratch [nseen, objs...], reset on entry.  Returns the distinct
// count, or -1 on overflow.
fn cnt_gen(A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  set32(seen,0,0);
  let cap:i32=(seen.len/4)-1;
  let nf:i32=get32(A,0);
  let ovf:i32=0;
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let j:i32=0;
    while(j<nf){
      set32(kb,ko,get32(kb,ko)+1);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        if(fr==rel){
          let ns:i32=get32(seen,0);
          let f:i32=0;
          let dup:i32=0;
          while(f<ns){
            if(get32(seen,4+f*4)==fo){ dup=1; }
            f=f+1;
          }
          if(dup==0){
            if(ns<cap){
              set32(seen,4+ns*4,fo);
              set32(seen,0,ns+1);
            } else {
              ovf=1;
            }
          }
        }
      }
      j=j+1;
    }
    si=si+1;
  }
  if(ovf==1){
    set32(A,CNT_OVF_OFF(),get32(A,CNT_OVF_OFF())+1);
    return -1;
  }
  return get32(seen,0);
}
// iv_inv.zag -- INVARIANT LAYER (C510-C5xx).  Concatenated AFTER
// iv_c15_base.zag and BEFORE iv_c8_learn.zag.  Contains NO world literals and
// NO goal literals: every value arrives at runtime through a goal record.
//
// ONE ROOT, NINE SYMPTOMS.  Every confirmed defect has this shape:
//
//   A record is written on the basis of a PROJECTION of its own content, into
//   a region whose size and occupancy are never RECORDED, and read back
//   without re-validating that the record found is the record intended.
//
// Four consequences, each independently fatal:
//   P1 IDENTITY NOT CLOSED   key is a coarser projection than the content
//   P2 CAPACITY NOT RECORDED strides/counts/cursors are literals
//   P3 COUNT != STORED COUNT a clamped store reports an unclamped count
//   P4 NO CHECKED DECODER   dispatch by magnitude on an untagged field
//
// WHAT THIS FILE INSTALLS (nothing else; all of it general):
//
//  (M2/M3) SELF-DESCRIBING CAPACITY HEADER.  A 32-byte header inside learner
//     state L records MAGIC / SCHEMA / the pointer to a store arena / the
//     arena's length / the arena's byte capacity.  Every capacity the learner
//     uses is read from that header or from a store sub-header.  No accessor
//     works if the header does not verify.
//
//  (M1) CONTENT-KEYED RECORD STORES.  Supersedes the frozen fixed-stride BIND
//     (12744) and PLAN (13000) tables.  A store key IS the full canonical
//     content of the item, compared cell for cell -- never a hash, never a
//     projection -- so identity collision is impossible by construction.
//     Records are VARIABLE LENGTH (bump + first-fit free list), so there is
//     no stride and a 5th plan step cannot write a neighbour's header.
//     Each sub-header carries MAGIC / LIVE / USED / CAP.
//
//  (M3) CHECKED GOAL DECODER.  ivg_ok walks the variable-length goal record
//     with a bounds check at every step and returns a POSITIVE error code for
//     any record it cannot decode.  Every accessor is legal only after
//     ivg_ok returned 0, so a malformed goal can never be partially believed.
//
//  (M2) CAPACITY CHECKED BEFORE WRITE, EVERYWHERE.  Working buffers are sized
//     from the DECODED goal (its own nneeds / max nf / fan-in), not from a
//     literal.  The answer buffer's capacity is derived from its own length.
//     The subject-list (fan-in) scratch is bounded and a full scratch is a
//     LOUD refusal, not a truncated write.
//
//  (M6) VALIDATOR AS A RUNTIME GATE.  iv_check walks every table and every
//     record and returns a violation code.  compose runs it on entry and exit;
//     a violation is a loud decline, never an answer.
//
//  (M5) ANSWER-TYPE CLOSURE lives in the TNN-2 layer (iv_tnn2); here a
//     set-valued intermediate has an explicit count so nothing is dropped.

fn IV_HDR()i32      { return 13276; }   // 6 cells, inside the 16384-byte L
fn IV_HDR2()i32     { return 16360; }   // 6 more cells, the frozen tail slack
fn IV_MAGIC()i32    { return 0x49C0A11E; }
fn IV_SCHEMA()i32   { return 1; }
fn IV_HDRLEN()i32   { return 24; }

// ---- declared capacities (VALUES, but recorded in the header and in each
// ---- store sub-header, and every writer checks them before writing) ----
fn IV_NEEDCAP()i32  { return 8; }    // max needs per goal
fn IV_FLDMAX()i32   { return 64; }   // max fields per need
fn IV_NLCAP()i32    { return 64; }   // max links per goal
fn IV_CELLCAP()i32  { return 768; }  // max canonical key cells for one goal
fn IV_BINDCAP()i32  { return 16; }   // max live binding records
fn IV_BINDRSZ()i32  { return 352; }  // bytes per binding record
fn IV_CELLBYTES()i32{ return 4; }
fn IV_ANSMAX()i32   { return 1000000; }

// ---- arena layout (all offsets derived from the constants above) ----
fn A_BHDR()i32  { return 0; }
fn A_BREC()i32  { return 32; }
fn A_PHDR()i32  { return A_BREC()+IV_BINDCAP()*IV_BINDRSZ(); }
fn A_STAT()i32  { return A_PHDR()+32; }
fn A_SCR()i32   { return A_STAT()+256; }
fn A_FIXED()i32 { return A_SCR()+IV_CELLCAP()*IV_CELLBYTES(); }
fn IV_ARENA()i32{ return A_FIXED()+12288; }
fn IV_BMAGIC()i32 { return 0x42494E44; }
fn IV_PMAGIC()i32 { return 0x504C4E44; }

// ---- 64-bit pointer round-trip through an i32 arena (brief 3.1 idiom) ----
fn iv_set64(b:[]u8,off:i32,v:i64)void {
  let lo:i32=(v & 0xFFFFFFFF) as i32;
  let hi:i32=((v>>32) & 0xFFFFFFFF) as i32;
  b[off]=lo as u8; b[off+1]=(lo>>8) as u8; b[off+2]=(lo>>16) as u8; b[off+3]=(lo>>24) as u8;
  b[off+4]=hi as u8; b[off+5]=(hi>>8) as u8; b[off+6]=(hi>>16) as u8; b[off+7]=(hi>>24) as u8;
  return;
}
fn iv_get64(b:[]u8,off:i32)i64 {
  let lo:i32=(b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
  let hi:i32=(b[off+4] as i32)|((b[off+5] as i32)<<8)|((b[off+6] as i32)<<16)|((b[off+7] as i32)<<24);
  return (lo as i64) | ((hi as i64)<<32);
}

// ---- header accessors.  iv_ok(L) is the gate: no MAGIC/SCHEMA match, no
// ---- store is touched.  iv_ensure installs the header on first use. ----
fn iv_magic_ok(L:[]u8)i32 {
  if(L.len < IV_HDR()+IV_HDRLEN()){ return 0; }
  if(get32(L,IV_HDR())!=IV_MAGIC()){ return 0; }
  if(get32(L,IV_HDR()+4)!=IV_SCHEMA()){ return 0; }
  return 1;
}
fn iv_raw(L:[]u8)[]u8 {
  let q:i64=iv_get64(L,IV_HDR()+8);
  let p:*u8=q as *u8;
  let n:i32=get32(L,IV_HDR()+16);
  return p[0..n];
}
fn iv_ensure(L:[]u8)i32 {
  if(L.len < IV_HDR()+IV_HDRLEN()){ return 0; }
  if(iv_magic_ok(L)==1){ return 1; }
  if(get32(L,IV_HDR())!=0){ return 0; }   // foreign or corrupt header: refuse
  let A:[]u8=z_alloc(IV_ARENA());
  if(A.len < IV_ARENA()){ return 0; }
  iv_set64(L,IV_HDR()+8,_zag_slice_ptr(A) as i64);
  set32(L,IV_HDR()+16,A.len);
  set32(L,IV_HDR()+20,IV_ARENA());
  set32(L,IV_HDR2()+4,0);
  iv_stores_init(L);
  set32(L,IV_HDR()+4,IV_SCHEMA());
  set32(L,IV_HDR(),IV_MAGIC());
  return 1;
}
fn iv_stores_init(L:[]u8)void {
  let A:[]u8=iv_raw(L);
  let i:i32=0;
  while(i<A.len){ A[i]=0; i=i+1; }
  set32(A,A_BHDR(),IV_BMAGIC());
  set32(A,A_BHDR()+4,0);              // LIVE
  set32(A,A_BHDR()+8,0);              // USED
  set32(A,A_BHDR()+12,IV_BINDCAP());  // CAP records
  set32(A,A_BHDR()+16,IV_BINDRSZ());  // record size
  set32(A,A_PHDR(),IV_PMAGIC());
  set32(A,A_PHDR()+4,0);              // LIVE
  set32(A,A_PHDR()+8,0);              // USED
  set32(A,A_PHDR()+12,A_FIXED());     // bump top, arena-relative
  set32(A,A_PHDR()+16,IV_ARENA());    // byte capacity
  set32(A,A_PHDR()+20,-1);            // live list head
  set32(A,A_PHDR()+24,-1);            // free list head
  return;
}
fn iv_bind_hdr(L:[]u8,cell:i32)i32 { let A:[]u8=iv_raw(L); return get32(A,A_BHDR()+cell); }
fn iv_plan_hdr(L:[]u8,cell:i32)i32 { let A:[]u8=iv_raw(L); return get32(A,A_PHDR()+cell); }

// ---- stat counters: monotone, all readable by the harness ----
fn iv_stat(L:[]u8,k:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  let A:[]u8=iv_raw(L);
  if(k<0){ return -1; }
  if(k>63){ return -1; }
  return get32(A,A_STAT()+k*4);
}
fn iv_bump(L:[]u8,k:i32)void {
  if(iv_magic_ok(L)==0){ return; }
  let A:[]u8=iv_raw(L);
  if(k<0){ return; }
  if(k>63){ return; }
  set32(A,A_STAT()+k*4,get32(A,A_STAT()+k*4)+1);
  return;
}
// counter slots (named, so no site invents its own index)
fn IVS_DECODE()i32   { return 0; }   // goal record refused by ivg_ok
fn IVS_BINDFULL()i32 { return 1; }   // binding store at explicit capacity
fn IVS_PLANFULL()i32 { return 2; }   // plan store at explicit byte capacity
fn IVS_ANSCAP()i32   { return 3; }   // answer buffer full: answer refused
fn IVS_ANSSTALE()i32 { return 4; }   // a decline left a stale answer: now impossible
fn IVS_BUFGATE()i32  { return 5; }   // working buffer below the goal's demand
fn IVS_SUBLCAP()i32  { return 6; }   // fan-in subject list full
fn IVS_OUTCAP()i32   { return 7; }   // ret/cnt record full
fn IVS_GATE()i32     { return 8; }   // compose refused by iv_check
fn IVS_CHECKV()i32   { return 9; }   // validator found a violation
fn IVS_PROJREF()i32  { return 10; }  // projection-only lookup refused
fn IVS_CAPREF()i32   { return 11; }  // explicit capacity refusal (any store)
fn IVS_MISMATCH()i32 { return 12; }  // record found is not the record intended
fn IVS_BADBUF()i32   { return 13; }  // header/arena missing
// 14..15 reserved for the TNN-2 layer (same counters, one arena)

// ============ CHECKED GOAL DECODER (M3) ============
// ivg_ok: 0 = decodable, positive = error code.  Every ivg_* accessor below
// is only legal after ivg_ok returned 0.
fn ivg_ok(G:[]u8)i32 {
  if(G.len<16){ return 1; }
  let nn:i32=get32(G,4);
  if(nn<1){ return 2; }
  if(nn>IV_NEEDCAP()){ return 3; }
  let off:i32=8;
  let n:i32=0;
  while(n<nn){
    if(off+8>G.len){ return 4; }
    let nf:i32=get32(G,off+4);
    if(nf<0){ return 5; }
    if(nf>IV_FLDMAX()){ return 6; }
    if(off+8+nf*4>G.len){ return 7; }
    off=off+8+nf*4;
    n=n+1;
  }
  if(off+4>G.len){ return 8; }
  let nl:i32=get32(G,off);
  if(nl<0){ return 9; }
  if(nl>IV_NLCAP()){ return 10; }
  if(off+4+nl*28>G.len){ return 11; }
  return 0;
}
fn ivg_tag(G:[]u8)i32 { return get32(G,0); }
fn ivg_nneeds(G:[]u8)i32 { return get32(G,4); }
fn ivg_nfmax(G:[]u8)i32 {
  let nn:i32=ivg_nneeds(G);
  let off:i32=8; let mx:i32=0; let n:i32=0;
  while(n<nn){
    let nf:i32=get32(G,off+4);
    if(nf>mx){ mx=nf; }
    off=off+8+nf*4; n=n+1;
  }
  return mx;
}
fn ivg_needbase(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){ off=off+8+get32(G,off+4)*4; k=k+1; }
  return off;
}
fn ivg_need_tag(G:[]u8,n:i32)i32 { let b:i32=ivg_needbase(G,n); return get32(G,b); }
fn ivg_need_nf(G:[]u8,n:i32)i32  { let b:i32=ivg_needbase(G,n); return get32(G,b+4); }
fn ivg_need_f(G:[]u8,n:i32,f:i32)i32 {
  let b:i32=ivg_needbase(G,n); return get32(G,b+8+f*4);
}
fn ivg_linkbase(G:[]u8)i32 { return ivg_needbase(G,ivg_nneeds(G)); }
fn ivg_nlinks(G:[]u8)i32 { return get32(G,ivg_linkbase(G)); }
fn ivg_link(G:[]u8,l:i32,w:i32)i32 { return get32(G,ivg_linkbase(G)+4+l*28+w*4); }

// ivg_cells: canonical content serialization of the WHOLE goal.  This IS the
// store key: goal tag, nneeds, nlinks, then per need [tag, nf, fields...],
// then each link's seven cells.  Returns the cell count, or -code on refusal.
fn ivg_cells(G:[]u8,out:[]u8)i32 {
  let bad:i32=ivg_ok(G);
  if(bad>0){ return -bad; }
  let lim:i32=IV_CELLCAP();
  if(out.len < lim*IV_CELLBYTES()){ return -20; }
  let nn:i32=ivg_nneeds(G);
  let nl:i32=ivg_nlinks(G);
  let c:i32=0;
  set32(out,c,ivg_tag(G)); c=c+4;
  set32(out,c,nn); c=c+4;
  set32(out,c,nl); c=c+4;
  let n:i32=0;
  while(n<nn){
    let nf:i32=ivg_need_nf(G,n);
    set32(out,c,ivg_need_tag(G,n)); c=c+4;
    set32(out,c,nf); c=c+4;
    let f:i32=0;
    while(f<nf){
      set32(out,c,ivg_need_f(G,n,f)); c=c+4;
      f=f+1;
    }
    if((c/4)>=lim){ return -21; }
    n=n+1;
  }
  let l:i32=0;
  while(l<nl){
    set32(out,c,ivg_link(G,l,0)); c=c+4;
    set32(out,c,ivg_link(G,l,1)); c=c+4;
    set32(out,c,ivg_link(G,l,2)); c=c+4;
    set32(out,c,ivg_link(G,l,3)); c=c+4;
    set32(out,c,ivg_link(G,l,4)); c=c+4;
    set32(out,c,ivg_link(G,l,5)); c=c+4;
    set32(out,c,ivg_link(G,l,6)); c=c+4;
    if((c/4)>=lim){ return -21; }
    l=l+1;
  }
  return c/4;
}
fn iv_cells_eq(a:[]u8,ao:i32,b:[]u8,bo:i32,n:i32)i32 {
  let i:i32=0;
  while(i<n){
    if(get32(a,ao+i*4)!=get32(b,bo+i*4)){ return 0; }
    i=i+1;
  }
  return 1;
}

// ============ CONTENT-KEYED BIND MEMO (M1) ============
// Key = (need_tag, need_nf, EVERY need field).  The need tag alone is a
// PROJECTION of that key and is exactly what let one tag serve two
// structural roles (C501 probe D).
// Record, arena-relative: A_BREC()+bi*IV_BINDRSZ()+
//   +0 tag (0 = free), +4 family (-1 unbound), +8 nf,
//   +12 fields[IV_FLDMAX], then +12+IV_FLDMAX()*4 : 6 family-trial counters.
fn iv_brec(L:[]u8,bi:i32)i32 {
  let A:[]u8=iv_raw(L); return A_BREC()+bi*IV_BINDRSZ();
}
fn iv_brec0(L:[]u8,bi:i32)i32 {
  let A:[]u8=iv_raw(L); return A_BREC()+bi*IV_BINDRSZ()+12+IV_FLDMAX()*4;
}
fn iv_bind_find(L:[]u8,G:[]u8,n:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  if(get32(iv_raw(L),A_BHDR())!=IV_BMAGIC()){ return -1; }
  let cap:i32=iv_bind_hdr(L,12);
  let tag:i32=ivg_need_tag(G,n);
  let nf:i32=ivg_need_nf(G,n);
  let bi:i32=0;
  while(bi<cap){
    let b:i32=iv_brec(L,bi);
    if(get32(iv_raw(L),b)!=0){
      if(get32(iv_raw(L),b)==tag){
        if(get32(iv_raw(L),b+8)==nf){
          let same:i32=1; let f:i32=0;
          while(f<nf){
            if(get32(iv_raw(L),b+12+f*4)!=ivg_need_f(G,n,f)){ same=0; }
            f=f+1;
          }
          if(same==1){ return bi; }
        }
      }
    }
    bi=bi+1;
  }
  return -1;
}
fn iv_bind_new(L:[]u8,G:[]u8,n:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  if(get32(iv_raw(L),A_BHDR())!=IV_BMAGIC()){ return -1; }
  let cap:i32=iv_bind_hdr(L,12);
  let tag:i32=ivg_need_tag(G,n);
  let nf:i32=ivg_need_nf(G,n);
  let bi:i32=0;
  while(bi<cap){
    let b:i32=iv_brec(L,bi);
    if(get32(iv_raw(L),b)==0){
      let A:[]u8=iv_raw(L);
      set32(A,b,tag);
      set32(A,b+4,-1);
      set32(A,b+8,nf);
      let f:i32=0;
      while(f<nf){ set32(A,b+12+f*4,ivg_need_f(G,n,f)); f=f+1; }
      let c0:i32=iv_brec0(L,bi);
      let k:i32=0;
      while(k<6){ set32(A,c0+k*4,0); k=k+1; }
      set32(A,A_BHDR()+4,iv_bind_hdr(L,4)+1);
      set32(A,A_BHDR()+8,iv_bind_hdr(L,8)+1);
      return bi;
    }
    bi=bi+1;
  }
  iv_bump(L,IVS_BINDFULL());
  iv_bump(L,IVS_CAPREF());
  return -1;
}
fn iv_bind_fam(L:[]u8,bi:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  if(bi<0){ return -1; }
  let A:[]u8=iv_raw(L);
  return get32(A,iv_brec(L,bi)+4);
}
fn iv_bind_tag(L:[]u8,bi:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  if(bi<0){ return -1; }
  let A:[]u8=iv_raw(L);
  return get32(A,iv_brec(L,bi));
}
fn iv_bind_setfam(L:[]u8,bi:i32,fam:i32)void {
  if(iv_magic_ok(L)==0){ return; }
  if(bi<0){ return; }
  if(fam<-1){ return; }
  if(fam>2){ return; }
  let A:[]u8=iv_raw(L);
  set32(A,iv_brec(L,bi)+4,fam);
  return;
}
fn iv_bind_cnt(L:[]u8,bi:i32,k:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  if(bi<0){ return -1; }
  if(k<0){ return -1; }
  if(k>5){ return -1; }
  let A:[]u8=iv_raw(L);
  return get32(A,iv_brec0(L,bi)+k*4);
}
fn iv_bind_bump(L:[]u8,bi:i32,k:i32)void {
  if(iv_magic_ok(L)==0){ return; }
  if(bi<0){ return; }
  if(k<0){ return; }
  if(k>5){ return; }
  let A:[]u8=iv_raw(L);
  let o:i32=iv_brec0(L,bi)+k*4;
  set32(A,o,get32(A,o)+1);
  return;
}
fn iv_clear_binds(L:[]u8)void {
  if(iv_magic_ok(L)==0){ return; }
  let A:[]u8=iv_raw(L);
  let cap:i32=iv_bind_hdr(L,12);
  let bi:i32=0;
  while(bi<cap){ set32(A,iv_brec(L,bi),0); set32(A,iv_brec(L,bi)+4,-1); bi=bi+1; }
  set32(A,A_BHDR()+4,0);
  set32(A,A_BHDR()+8,0);
  return;
}

// ============ CONTENT-KEYED PLAN STORE (M1) ============
// VARIABLE-LENGTH records.  There is no stride, so the 5th plan step cannot
// write into the next record's header (C502).
// Record at arena-relative ro:
//   +0 nneeds (<0 = free), +4 goal tag, +8 ncells,
//   +12 free_next (-1 = end), +16 live_next (-1 = end),
//   +20 cells[ncells], then nn*3 cells (need index, need tag, family).
fn iv_prec(L:[]u8,ro:i32)i32 { let A:[]u8=iv_raw(L); return A_FIXED()+ro; }
fn iv_plan_find(L:[]u8,G:[]u8,cells:[]u8,nc:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  if(get32(iv_raw(L),A_PHDR())!=IV_PMAGIC()){ return -1; }
  let A:[]u8=iv_raw(L);
  let ro:i32=get32(A,A_PHDR()+20);
  while(ro>=0){
    let b:i32=iv_prec(L,ro);
    if(get32(A,b+8)==nc){
      if(get32(A,b+4)==ivg_tag(G)){
        if(iv_cells_eq(cells,0,A,b+20,nc)==1){ return ro; }
      }
    }
    ro=get32(A,b+16);
  }
  return -1;
}
fn iv_plan_alloc(L:[]u8,size:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  let A:[]u8=iv_raw(L);
  let prev:i32=-1;
  let cur:i32=get32(A,A_PHDR()+24);
  while(cur>=0){
    let b:i32=iv_prec(L,cur);
    if(-get32(A,b)>=size){
      let nxt:i32=get32(A,b+12);
      if(prev<0){ set32(A,A_PHDR()+24,nxt); }
      else { set32(A,iv_prec(L,prev)+12,nxt); }
      return cur;
    }
    prev=cur;
    cur=get32(A,b+12);
  }
  let top:i32=get32(A,A_PHDR()+12);
  if(top+size>get32(A,A_PHDR()+16)){ return -1; }
  set32(A,A_PHDR()+12,top+size);
  return top;
}
fn iv_plan_free(L:[]u8,ro:i32)void {
  if(iv_magic_ok(L)==0){ return; }
  let A:[]u8=iv_raw(L);
  let prev:i32=-1;
  let cur:i32=get32(A,A_PHDR()+20);
  let found:i32=0;
  while(cur>=0){
    let cb:i32=iv_prec(L,cur);
    if(cur==ro){
      let nxt:i32=get32(A,cb+16);
      if(prev<0){ set32(A,A_PHDR()+20,nxt); }
      else { set32(A,iv_prec(L,prev)+16,nxt); }
      cur=-1; found=1;
    } else { prev=cur; cur=get32(A,cb+16); }
  }
  if(found==0){ return; }
  let b:i32=iv_prec(L,ro);
  set32(A,b,-1);
  set32(A,b+12,get32(A,A_PHDR()+24));
  set32(A,A_PHDR()+24,ro);
  set32(A,A_PHDR()+4,get32(A,A_PHDR()+4)-1);
  return;
}
fn iv_plan_nneeds(L:[]u8,ro:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  let A:[]u8=iv_raw(L); return get32(A,iv_prec(L,ro));
}
fn iv_plan_gtag(L:[]u8,ro:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  let A:[]u8=iv_raw(L); return get32(A,iv_prec(L,ro)+4);
}
fn iv_plan_ncells(L:[]u8,ro:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  let A:[]u8=iv_raw(L); return get32(A,iv_prec(L,ro)+8);
}
fn iv_plan_step(L:[]u8,ro:i32,p:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  let A:[]u8=iv_raw(L);
  let nc:i32=get32(A,iv_prec(L,ro)+8);
  return iv_prec(L,ro)+20+nc*4+p*12;
}
fn iv_plan_count(L:[]u8)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  return iv_plan_hdr(L,4);
}
fn iv_plan_new(L:[]u8,G:[]u8,ord:[]u8,cells:[]u8,nc:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  if(get32(iv_raw(L),A_PHDR())!=IV_PMAGIC()){ return -1; }
  if(nc<1){ return -1; }
  let nn:i32=ivg_nneeds(G);
  if(nn<1){ return -1; }
  if(ord.len<nn*4){ return -1; }
  let size:i32=20+nc*4+nn*12;
  let ro:i32=iv_plan_alloc(L,size);
  if(ro<0){
    iv_bump(L,IVS_PLANFULL());
    iv_bump(L,IVS_CAPREF());
    return -1;
  }
  let A:[]u8=iv_raw(L);
  let b:i32=iv_prec(L,ro);
  set32(A,b,nn);
  set32(A,b+4,ivg_tag(G));
  set32(A,b+8,nc);
  set32(A,b+12,-1);
  set32(A,b+16,get32(A,A_PHDR()+20));
  let i:i32=0;
  while(i<nc){ set32(A,b+20+i*4,get32(cells,i*4)); i=i+1; }
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(ord,p*4);
    let bi:i32=iv_bind_find(L,G,ni);
    set32(A,b+20+nc*4+p*12,ni);
    set32(A,b+20+nc*4+p*12+4,ivg_need_tag(G,ni));
    set32(A,b+20+nc*4+p*12+8,iv_bind_fam(L,bi));
    p=p+1;
  }
  set32(A,A_PHDR()+20,ro);
  set32(A,A_PHDR()+4,get32(A,A_PHDR()+4)+1);
  return ro;
}
fn iv_plan_drop(L:[]u8,ro:i32)void {
  if(ro<0){ return; }
  iv_plan_free(L,ro);
  return;
}
fn iv_clear_plans(L:[]u8)void {
  if(iv_magic_ok(L)==0){ return; }
  let A:[]u8=iv_raw(L);
  let ro:i32=get32(A,A_PHDR()+20);
  while(ro>=0){
    let b:i32=iv_prec(L,ro);
    let nx:i32=get32(A,b+16);
    set32(A,b,-1);
    set32(A,b+12,get32(A,A_PHDR()+24));
    set32(A,A_PHDR()+24,ro);
    set32(A,A_PHDR()+4,get32(A,A_PHDR()+4)-1);
    ro=nx;
  }
  return;
}
// iv_plan_find_tag / iv_bind_find_tag are DIAGNOSTIC PROJECTIONS.  They are
// kept only so a harness can ask "is there any record with this tag?"; the
// engine NEVER uses them for identity.  Each one counts a PROJREF so a report
// can show that a projection was consulted.
fn iv_bind_find_tag(L:[]u8,tag:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  iv_bump(L,IVS_PROJREF());
  let cap:i32=iv_bind_hdr(L,12);
  let bi:i32=0;
  while(bi<cap){
    let A:[]u8=iv_raw(L);
    if(get32(A,iv_brec(L,bi))==tag){ return bi; }
    bi=bi+1;
  }
  return -1;
}
fn iv_plan_find_tag(L:[]u8,gt:i32)i32 {
  if(iv_magic_ok(L)==0){ return -1; }
  iv_bump(L,IVS_PROJREF());
  let A:[]u8=iv_raw(L);
  let ro:i32=get32(A,A_PHDR()+20);
  while(ro>=0){
    let b:i32=iv_prec(L,ro);
    if(get32(A,b+4)==gt){ return ro; }
    ro=get32(A,b+16);
  }
  return -1;
}

// ============ VALIDATOR (M6) ============
// Walks every table and every record.  Returns 0 when the store is closed and
// consistent, else a positive violation code.  This is a PROPERTY, checked at
// runtime, not a tuned constant.
fn iv_check(L:[]u8)i32 {
  if(L.len < IV_HDR()+IV_HDRLEN()){ return 1; }
  if(iv_magic_ok(L)==0){ return 2; }
  let A:[]u8=iv_raw(L);
  if(A.len < A_FIXED()){ return 3; }
  if(get32(L,IV_HDR()+16)!=A.len){ return 4; }
  if(get32(L,IV_HDR()+20)!=IV_ARENA()){ return 5; }
  if(get32(A,A_BHDR())!=IV_BMAGIC()){ return 6; }
  if(get32(A,A_PHDR())!=IV_PMAGIC()){ return 7; }
  // bind store: capacity recorded, occupancy <= capacity, fields inside record
  let bcap:i32=get32(A,A_BHDR()+12);
  let brsz:i32=get32(A,A_BHDR()+16);
  if(bcap!=IV_BINDCAP()){ return 8; }
  if(brsz<12+IV_FLDMAX()*4+24){ return 9; }
  if(get32(A,A_BHDR()+8)>bcap){ return 10; }
  if(get32(A,A_BHDR()+4)>get32(A,A_BHDR()+8)){ return 11; }
  let bi:i32=0; let live:i32=0;
  while(bi<bcap){
    let b:i32=iv_brec(L,bi);
    let tg:i32=get32(A,b);
    if(tg!=0){
      live=live+1;
      if(tg<0){ return 12; }
      let nf:i32=get32(A,b+8);
      if(nf<0){ return 13; }
      if(nf>IV_FLDMAX()){ return 14; }
      if(b+12+nf*4 > b+brsz){ return 15; }
      if(get32(A,b+4)<-1){ return 16; }
      if(get32(A,b+4)>2){ return 17; }
    }
    bi=bi+1;
  }
  if(live!=get32(A,A_BHDR()+4)){ return 18; }
  // plan store: every live record's cells must match the content of a goal
  // whose canonical form has that many cells, and the record must lie wholly
  // inside the recorded byte capacity.
  if(get32(A,A_PHDR()+12)>get32(A,A_PHDR()+16)){ return 19; }
  let plive:i32=0;
  let ro:i32=get32(A,A_PHDR()+20);
  let guard:i32=0;
  while(ro>=0){
    let b:i32=iv_prec(L,ro);
    let nn:i32=get32(A,b);
    let nc:i32=get32(A,b+8);
    if(nn<1){ return 20; }
    if(nn>IV_NEEDCAP()){ return 21; }
    if(nc<3){ return 22; }
    if(nc>IV_CELLCAP()){ return 23; }
    if(ro+20+nc*4+nn*12 > get32(A,A_PHDR()+16)){ return 24; }
    let p:i32=0;
    while(p<nn){
      let st:i32=iv_plan_step(L,ro,p);
      if(get32(A,st)<0){ return 25; }
      if(get32(A,st)>=nn){ return 26; }
      if(get32(A,st+8)<-1){ return 27; }
      if(get32(A,st+8)>2){ return 28; }
      p=p+1;
    }
    let nx:i32=get32(A,b+16);
    plive=plive+1;
    guard=guard+1;
    if(guard>IV_ARENA()){ return 29; }
    ro=nx;
  }
  if(plive!=get32(A,A_PHDR()+4)){ return 30; }
  return 0;
}
// iv_record_check: run the validator and RECORD the violation code in the
// header, so "the store was inconsistent" is an observable, not a silent
// recovery.  The engine treats v>0 as a loud decline.
fn iv_record_check(L:[]u8)i32 {
  let v:i32=iv_check(L);
  if(L.len>=IV_HDR()+IV_HDRLEN()){ set32(L,IV_HDR2(),v); }
  if(v>0){ iv_bump(L,IVS_CHECKV()); }
  return v;
}
fn iv_last_violation(L:[]u8)i32 {
  if(L.len<IV_HDR2()+4){ return -1; }
  return get32(L,IV_HDR2());
}

// ============ ANSWER BUFFER (M2) ============
// The answer buffer's capacity is DERIVED FROM ITS OWN LENGTH, so it can never
// disagree with the allocation the caller actually made.  A full buffer is a
// REFUSAL (-1), never a write past the end, and never a stale answer.
fn iv_ans_cap(ans:[]u8)i32 { return ans.len/4-1; }
fn iv_ans_clear(ans:[]u8)void { if(ans.len<4){ return; } set32(ans,0,0); return; }
fn iv_ans_append(ans:[]u8,v:i32)i32 {
  if(ans.len<4){ return -1; }
  let n:i32=get32(ans,0);
  if(n>=iv_ans_cap(ans)){ return -1; }
  if(4+n*4+4>ans.len){ return -1; }
  set32(ans,4+n*4,v);
  set32(ans,0,n+1);
  return 1;
}
// iv_ans_append_rec(ans, OUTS, ni, ostr, ocap): append one need's output
// record [n, ints...] using the RECORD'S OWN stride/capacity.  Returns -1 if
// the record or the answer buffer is full.
fn iv_ans_append_rec(ans:[]u8,OUTS:[]u8,ni:i32,ostr:i32,ocap:i32)i32 {
  let ro:i32=ni*ostr;
  if(ro+4>OUTS.len){ return -1; }
  let n:i32=get32(OUTS,ro);
  if(n<0){ return -1; }
  if(n>ocap){ return -1; }
  if(ro+4+n*4>OUTS.len){ return -1; }
  if(iv_ans_append(ans,n)<0){ return -1; }
  let k:i32=0;
  while(k<n){
    if(iv_ans_append(ans,get32(OUTS,ro+4+k*4))<0){ return -1; }
    k=k+1;
  }
  return 1;
}

// ============ LAYOUT RECORD: WHERE EVERY CAPACITY LIVES (M2) ============
// One small buffer LY carries, for ONE goal, every stride and every record
// capacity the execution path will use.  Nothing downstream is a literal
// 80 / 128 / 160 any more; each is read from here, and here they are derived
// from the DECODED goal.  Cells:
//   0 nneeds   4 nfmax   8 ws   12 os   16 ss   20 ocap   24 nlinks
fn IV_FANINCAP()i32 { return 256; }
fn IV_SEENCAP()i32 { return 256; }
fn IV_TMPCHAIN()i32 { return 16; }
fn ly_set(LY:[]u8,nn:i32,nf:i32,nl:i32,ocap:i32)void {
  set32(LY,0,nn);
  set32(LY,4,nf);
  set32(LY,8,4+IV_FLDMAX()*4);
  set32(LY,12,4+ocap*4);
  set32(LY,16,4+IV_FANINCAP()*4);
  set32(LY,20,ocap);
  set32(LY,24,nl);
  return;
}
fn ly_nn(LY:[]u8)i32 { return get32(LY,0); }
fn ly_nf(LY:[]u8)i32 { return get32(LY,4); }
fn ly_ws(LY:[]u8)i32 { return get32(LY,8); }
fn ly_os(LY:[]u8)i32 { return get32(LY,12); }
fn ly_ss(LY:[]u8)i32 { return get32(LY,16); }
fn ly_ocap(LY:[]u8)i32 { return get32(LY,20); }
fn ly_nl(LY:[]u8)i32 { return get32(LY,24); }

// ============ WORKING-BUFFER CAPACITY GATE (M2) ============
// Refuses BEFORE ANY WRITE when an allocation did not come out at the size
// the goal demands.  A refusal is loud and counted; it is never a partial
// execution.  iv_gate returns 0 = ok, else the buffer index that failed.
// Buffers: W (per-need input), OUTS (per-need output record), ord (topo
// order), SUBL (per-need subject list), seen (distinct-object scratch),
// tout (scalar), tmpc (verify chain).
fn iv_gate(LY:[]u8,W:[]u8,OUTS:[]u8,ord:[]u8,SUBL:[]u8,seen:[]u8,tout:[]u8,tmpc:[]u8)i32 {
  let nn:i32=ly_nn(LY);
  let nf:i32=ly_nf(LY);
  let nl:i32=ly_nl(LY);
  if(nn<1){ return 1; }
  if(nn>IV_NEEDCAP()){ return 1; }
  if(nf<0){ return 2; }
  if(nf>IV_FLDMAX()){ return 2; }
  if(nl<0){ return 3; }
  if(nl>IV_NLCAP()){ return 3; }
  if(W.len < nn*ly_ws(LY)){ return 4; }
  if(OUTS.len < nn*ly_os(LY)){ return 5; }
  if(ord.len < nn*4){ return 6; }
  if(SUBL.len < nn*ly_ss(LY)){ return 7; }
  if(seen.len < 4+IV_SEENCAP()*4){ return 8; }
  if(tout.len < 4){ return 9; }
  if(tmpc.len < 4+IV_TMPCHAIN()*12){ return 10; }
  return 0;
}// c4_learn.zag -- learner-owned procedures and learner-driven composition.
//
// Diamond follow-up to C422 (c3_learn.zag): plan records widened to 4
// needs per plan (56-byte entries), stats block moved to 13224, and
// apply_kind3 generalized to multi-source fan-in (preregistered).
// Binding by trial, topo assembly, version selection, plan
// persist/reuse/re-derive, and decline logic are the C422 logic
// unchanged.
// Learner-state L (16384 bytes):
//   RET region: 0: ret_nrel; 4: ret_rel_ids[16]; 68: ret_cnt[16];
//     132: ret_fidx[16][64]; 4228: ret_prov_parent (=0); 4232: ep0;
//     4236: ep1; 4240: nfacts; 4244: rev.
//   VFY region: 4248: vfy_nrel; 4252: vfy_rel_ids[16]; 4316: vfy_cnt[16];
//     4380: vfy_fidx[16][64]; 8476: vfy_prov_parent (=1); 8480: ep0;
//     8484: ep1; 8488: nfacts; 8492: rev.
//   CNT region: 8496: cnt_nrel; 8500: cnt_rel_ids[16]; 8564: cnt_cnt[16];
//     8628: cnt_fidx[16][64]; 12724: cnt_prov_parent (=4); 12728: ep0;
//     12732: ep1; 12736: nfacts; 12740: rev.
//   BIND table at 12744: 8 entries x 32 bytes:
//     [tag, bound_fam, ok0, f0, ok1, f1, ok2, f2].
//   PLAN table at 13000: 4 entries x 56 bytes:
//     [goal_tag, nneeds, idx0, tag0, fam0, idx1, tag1, fam1,
//      idx2, tag2, fam2, idx3, tag3, fam3].
//   Stats at 13224: plans_built, plans_loaded, trials, declines, agree,
//     cs, cg, ret_spec_uses, ret_gen_uses, vfy_spec_uses, vfy_gen_uses,
//     cnt_spec_uses, cnt_gen_uses.
//
// No world literals appear in this file: no goal tags, no need tags, no
// relation ids, no plan sequences. All content arrives at runtime through
// episodes, trials, and goal records.
// ---- retrieve working set ----
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  if(ret_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  if(ret_cov_find(L,r)<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
fn ret_cov_clear(L:[]u8)void { set32(L,0,0); return; }
// ---- verify working set ----
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  if(vfy_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  if(vfy_cov_find(L,r)<0){
    let n:i32=get32(L,4248);
    if(n<16){ set32(L,4252+n*4,r); set32(L,4248,n+1); }
  }
  return;
}
fn vfy_cov_clear(L:[]u8)void { set32(L,4248,0); return; }
// ---- count working set ----
fn cnt_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cnt_cov_has(L:[]u8,r:i32)i32 {
  if(cnt_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn cnt_log_rel(L:[]u8,r:i32)void {
  if(cnt_cov_find(L,r)<0){
    let n:i32=get32(L,8496);
    if(n<16){ set32(L,8500+n*4,r); set32(L,8496,n+1); }
  }
  return;
}
fn cnt_cov_clear(L:[]u8)void { set32(L,8496,0); return; }
// ---- specialize_ret: build the learner-owned indexed RETRIEVE ----
fn specialize_ret(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  return;
}
// ---- specialize_vfy: build the learner-owned indexed VERIFY ----
fn specialize_vfy(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  return;
}
// ---- specialize_cnt: build the learner-owned indexed COUNT ----
// One linear pass over all facts; each fact whose relation is in the
// count working set is appended to that relation's bucket.
fn specialize_cnt(L:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,8564+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cnt_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,8564+bi*4);
      if(c0<64){
        set32(L,8628+(bi*64+c0)*4,j);
        set32(L,8564+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,12724,4);
  set32(L,12728,ep0);
  set32(L,12732,ep1);
  set32(L,12736,nf);
  set32(L,12740,get32(L,12740)+1);
  return;
}
// ---- ret_spec: the learner-owned specialized RETRIEVE (id 2) ----
// INV-W3: same rule as ret_gen.  The record capacity is passed in and the
// stored count is what is written and what is returned; overflow is -1.
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32,cap:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let room:i32=(out.len-oo)/4-1;
  let cf:i32=cap;
  if(cf>room){ cf=room; }
  if(cf<0){ cf=0; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<cf){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  if(ns>cf){ set32(A,RET_OVF_OFF(),get32(A,RET_OVF_OFF())+1); return -1; }
  set32(out,oo,ns);
  return ns;
}
// ---- vfy_spec: the learner-owned specialized VERIFY (id 3) ----
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_spec: the learner-owned specialized COUNT (id 5) ----
// For each subject, scans only the learned bucket for the relation and
// collects distinct objects.
// INV-W2/P3 (the same rule as cnt_gen): the distinct-object scratch capacity
// is derived from the caller's buffer and checked before every write; the
// count reported is the count stored; overflow is a DISTINCT refusal.
// RETURN: -1 = relation outside learned coverage (frozen meaning),
//         -2 = distinct-object record full (loud refusal, nothing dropped).
fn cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let cf:i32=(seen.len/4)-1;
  if(cf<0){ return -2; }
  let ovf:i32=0;
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<cf){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          } else {
            ovf=1;
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  if(ovf==1){
    set32(A,CNT_OVF_OFF(),get32(A,CNT_OVF_OFF())+1);
    return -2;
  }
  return get32(seen,0);
}
// ---- episodes: experience steps ----
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0,IV_FLDMAX());
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
fn cnt_episode(L:[]u8,A:[]u8,rel:i32,subj:i32,kb:[]u8,tout:[]u8,seen:[]u8)i32 {
  cnt_log_rel(L,rel);
  set32(tout,0,subj);
  return cnt_gen(A,rel,tout,0,1,kb,12,seen);
}
// ---- per-need version selection from learned coverage ----
fn ret_version(L:[]u8,rel:i32)i32 {
  if(ret_cov_has(L,rel)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(vfy_cov_has(L,r)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
fn cnt_version(L:[]u8,rel:i32)i32 {
  if(cnt_cov_has(L,rel)==1){ return 5; }
  return 4;
}
// ---- goal record parsing (generic; no literals) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 {
  return get32(G,g_linkbase(G)+4+l*28+w*4);
}
// ---- working inputs: W holds per-need [nf, f0, ...] at W+n*ws ----
// ws comes from the LAYOUT RECORD (ly_ws), which is derived from the DECODED
// goal.  The frozen literal 80 is gone: a need with 40 fields used to
// overwrite the next need's record.
fn mat_inputs(G:[]u8,W:[]u8,ws:i32)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*ws,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*ws+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// ---- topological order over links (Kahn) ----
// The frozen version had no break, so it emitted the LAST ready node first
// and, worse, indexed ind/placed at a stride of 4 for a buffer allocated for
// 4 needs.  Buffers here are sized from the decoded nneeds.
fn topo(G:[]u8,ord:[]u8)void {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(nn*4);
  let placed:[]u8=z_alloc(nn*4);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  let stall:i32=0;
  while(stall==0){
    let n2:i32=0;
    let fnd:i32=-1;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    if(fnd<0){ stall=1; }
    if(fnd>=0){
      set32(placed,fnd*4,1);
      set32(ord,p*4,fnd);
      p=p+1;
      if(p>=nn){ stall=1; }
      let l2:i32=0;
      while(l2<nl){
        let d2:i32=link_w(G,l2,1);
        let s2:i32=link_w(G,l2,4);
        if(s2==fnd){
          if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
        }
        l2=l2+1;
      }
    }
  }
  let n3:i32=0;
  while(n3<nn){
    if(get32(placed,n3*4)==0){
      set32(ord,p*4,n3);
      p=p+1;
    }
    n3=n3+1;
  }
  return;
}
// ---- fan-out source: need with an incoming kind-2 link, else -1 ----
fn fanin_src(G:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==2){
      if(link_w(G,l,1)==ni){ return link_w(G,l,4); }
    }
    l=l+1;
  }
  return -1;
}
// ---- apply incoming kind-1 (scalar copy) links to need ni ----
fn apply_kind1(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32,ws:i32,os:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let ds:i32=link_w(G,l,3);
      let sn:i32=link_w(G,l,4);
      let sk:i32=link_w(G,l,5);
      let ss:i32=link_w(G,l,6);
      let v:i32=0;
      if(sk==0){ v=get32(W,sn*ws+4+ss*4); }
      if(sk==1){ v=get32(OUTS,sn*os+4+ss*4); }
      set32(W,ni*ws+4+ds*4,v);
    }
    l=l+1;
  }
  return;
}
// ---- apply incoming kind-3 (aggregate subject-list) links to need ni ----
// GENERALIZED: subjects from ALL incoming kind-3 links concatenate in
// goal-record link order into SUBL[ni*ss].  On a chain this is byte-identical
// to the frozen behaviour; on a diamond it is the generic fan-in.
// INVARIANT (C503 / W8): the fan-in total is CHECKED AGAINST THE RECORD'S
// OWN CAPACITY BEFORE EVERY WRITE.  The frozen code wrote SUBL[ni*128+4+tot*4]
// with tot unbounded, i.e. 80 subjects into a 32-entry record, and the
// surplus landed in malloc slack -- an accident, not a guarantee.
// Returns 1 if at least one kind-3 link targeted ni and the record held the
// whole fan-in, 0 if none did, -1 on a CAPACITY REFUSAL (nothing truncated,
// overflow counted, caller must decline).
fn apply_kind3(G:[]u8,OUTS:[]u8,SUBL:[]u8,ni:i32,os:i32,ss:i32,scap:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  let found:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==3){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        let n:i32=get32(OUTS,sn*os);
        if(n>0){
          if(n>scap){ return -1; }
          let k:i32=0;
          while(k<n){
            if(tot>=scap){ return -1; }
            set32(SUBL,ni*ss+4+tot*4,get32(OUTS,sn*os+4+k*4));
            tot=tot+1;
            k=k+1;
          }
        }
        found=1;
      }
    }
    l=l+1;
  }
  if(found==1){
    set32(SUBL,ni*ss,tot);
    return 1;
  }
  return 0;
}
// ---- binding table: SUPERSEDED (charter 51/158) --------------------
// The frozen BIND at 12744 (8 x 32 bytes, key = BARE NEED TAG) is REMOVED
// from active architecture.  A need tag is a PROJECTION of the need's content
// and one tag legitimately occurs in two structural roles, so the frozen memo
// returned one role's procedure for the other role (C501 probe D).  The
// replacement is the CONTENT-KEYED store in iv_inv.zag: key = (tag, nf,
// EVERY field), compared cell for cell, in a store whose capacity is
// recorded in its own header.
//
// `bind_find(L,tag)` and `bind_new(L,tag)` are retained ONLY as frozen-signature
// DIAGNOSTIC projections for harnesses that report "is there a binding with
// this tag?".  The engine never calls them for identity; each consult bumps
// IVS_PROJREF.  `bind_new` cannot exist at all under content identity: a
// binding cannot be created without its content, so it REFUSES.
fn bind_find(L:[]u8,tag:i32)i32 { return iv_bind_find_tag(L,tag); }
fn bind_new(L:[]u8,tag:i32)i32 {
  iv_bump(L,IVS_PROJREF());
  iv_bump(L,IVS_CAPREF());
  return -1;
}
fn bind_fam(L:[]u8,bi:i32)i32 { return iv_bind_fam(L,bi); }
// ---- try one procedure family on one need; 1 = consumed, 0 = refused ----
// Family 0 (RETRIEVE) accepts exactly 2-field needs (its arity).
// Family 1 (VERIFY) accepts records shaped as chains.
// Family 2 (COUNT) accepts exactly 3-field needs [rel, aggop, subj]
// with aggop == 1 (distinct-object count).
fn try_family(L:[]u8,A:[]u8,fam:i32,G:[]u8,n:i32,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8) i32 {
  let nf:i32=need_nf(G,n);
  if(fam==0){
    if(nf==2){
      ret_gen(A,need_f(G,n,0),need_f(G,n,1),K,8,tout,0,IV_FLDMAX());
      return 1;
    }
    return 0;
  }
  if(fam==1){
    if(nf>=4){
      let ns:i32=need_f(G,n,0);
      if(ns>=1){
        if(ns<=IV_TMPCHAIN()){
          if(nf==1+ns*3){
            set32(tmpc,0,ns);
            let i:i32=0;
            while(i<ns){
              set32(tmpc,4+i*12,need_f(G,n,1+i*3));
              set32(tmpc,4+i*12+4,need_f(G,n,1+i*3+1));
              set32(tmpc,4+i*12+8,need_f(G,n,1+i*3+2));
              i=i+1;
            }
            vfy_gen(A,tmpc,K,8);
            return 1;
          }
        }
      }
    }
    return 0;
  }
  if(nf==3){
    let ag:i32=need_f(G,n,1);
    if(ag==1){
      set32(tout,0,need_f(G,n,2));
      cnt_gen(A,need_f(G,n,0),tout,0,1,K,8,seen);
      return 1;
    }
  }
  return 0;
}
// ---- learn bindings for all unbound need CONTENT in the goal ----
// Returns 1 iff every need content ends bound; 0 if any need is unbindable.
// IDENTITY IS CONTENT (M1): the memo key is (tag, nf, every field).  The
// family a need gets is therefore a function of the need itself, not of the
// symbol that names it.
fn learn_bindings(L:[]u8,A:[]u8,G:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let bi:i32=iv_bind_find(L,G,n);
    let bi2:i32=bi;
    if(bi2<0){ bi2=iv_bind_new(L,G,n); }
    if(bi2<0){
      // capacity refusal: an unbound need means the goal is unanswerable
      n=n+1;
      continue;
    }
    if(iv_bind_fam(L,bi2)<0){
      let fam:i32=0;
      while(fam<3){
        set32(L,13232,get32(L,13232)+1);
        let r:i32=try_family(L,A,fam,G,n,K,tout,tmpc,seen);
        iv_bind_bump(L,bi2,fam*2);
        if(r==0){ iv_bind_bump(L,bi2,fam*2+1); }
        if(r==1){
          if(iv_bind_fam(L,bi2)<0){ iv_bind_setfam(L,bi2,fam); }
        }
        fam=fam+1;
      }
    }
    n=n+1;
  }
  let m:i32=0;
  while(m<nn){
    let b:i32=iv_bind_find(L,G,m);
    if(b<0){ return 0; }
    if(iv_bind_fam(L,b)<0){ return 0; }
    m=m+1;
  }
  return 1;
}
// ---- plan table: SUPERSEDED (charter 51/158) ------------------------
// The frozen PLAN at 13000 (4 x 56 bytes, key = BARE GOAL TAG, steps at a
// stride of 12 laid over a 56-byte entry) is REMOVED from active
// architecture.  Two independent failures came from that one entry:
//
//   P1  two goals with the same tag but different SHAPE share a key, so the
//       second goal executes the first goal's procedure and answers from a
//       record it never wrote (C501 probe B: answer {} instead of 1);
//   P2  stride 56 fits 4 steps, so step 5 of a 5-need goal wrote slot 1's
//       header (gtag := 0) and PLANTED A PHANTOM PLAN for the "no plan"
//       sentinel tag, which then answered 73 integers containing values that
//       were never in the world (C502 breaks A and B).
//
// The replacement is the VARIABLE-LENGTH CONTENT-KEYED store in iv_inv.zag:
// the key IS the canonical serialization of the whole goal (tag, nneeds,
// nlinks, every need's tag/nf/fields, every link's seven cells), compared
// cell for cell; records have no stride; the store's byte capacity is
// recorded in its own header and is checked BEFORE the bump, so an exhausted
// store refuses with a distinct code instead of writing over a neighbour.
//
// `plan_find(L,gtag)` is retained ONLY as a diagnostic projection.
fn plan_find(L:[]u8,gtag:i32)i32 { return iv_plan_find_tag(L,gtag); }
// plan_get_first: copy the first live plan's HEADER + first four steps into
// out as the frozen 14-int vector [gtag,nn,i0,t0,f0,i1,t1,f1,...].  The frozen
// version read a fixed 14 cells out of a 56-byte entry; here the cells come
// from the variable-length record and are truncated to the reader's window,
// with -1 for a step the record does not have.
fn plan_get_first(L:[]u8,out:[]u8)void {
  if(iv_magic_ok(L)==0){ set32(out,0,-1); return; }
  let A:[]u8=iv_raw(L);
  let ro:i32=get32(A,A_PHDR()+20);
  while(ro>=0){
    let b:i32=iv_prec(L,ro);
    let nn:i32=get32(A,b);
    if(nn>0){
      set32(out,0,get32(A,b+4));
      set32(out,4,nn);
      let p:i32=0;
      while(p<4){
        if(p<nn){
          let st:i32=iv_plan_step(L,ro,p);
          set32(out,8+p*12,get32(A,st));
          set32(out,8+p*12+4,get32(A,st+4));
          set32(out,8+p*12+8,get32(A,st+8));
        } else {
          set32(out,8+p*12,-1);
          set32(out,8+p*12+4,-1);
          set32(out,8+p*12+8,-1);
        }
        p=p+1;
      }
      return;
    }
    ro=get32(A,b+16);
  }
  set32(out,0,-1);
  return;
}
fn clear_plans(L:[]u8)void { iv_clear_plans(L); return; }
fn clear_bindings(L:[]u8)void { iv_clear_binds(L); return; }
// ---- answer assembly ----
// Every append is CAPACITY-CHECKED against the buffer's OWN length and
// returns -1 on refusal.  A refusal never leaves a partial record and never
// leaves the PREVIOUS goal's answer visible (C502 break D): compose zeroes
// the answer on every non-success return.
fn ans_append(ans:[]u8,v:i32)i32 { return iv_ans_append(ans,v); }
fn ans_append_rec(ans:[]u8,OUTS:[]u8,ni:i32,os:i32,ocap:i32)i32 {
  return iv_ans_append_rec(ans,OUTS,ni,os,ocap);
}
// ---- build a chain buffer from need W[ni]; sub>=0 fills s==0 slots ----
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32,ws:i32)void {
  let ns:i32=get32(W,n*ws+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*ws+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*ws+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*ws+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
// ---- execute one stored plan; ans gets the appended output records ----
// Returns 0 on success, -1 on a CAPACITY REFUSAL anywhere inside (answer
// buffer full, fan-in record full, output record refused by the procedure).
// A refusal is loud and leaves no answer behind.
fn execute_plan(L:[]u8,A:[]u8,G:[]u8,ro:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,LY:[]u8)i32 {
  let ws:i32=ly_ws(LY);
  let os:i32=ly_os(LY);
  let ss:i32=ly_ss(LY);
  let ocap:i32=ly_ocap(LY);
  let scap:i32=IV_FANINCAP();
  mat_inputs(G,W,ws);
  let nn:i32=iv_plan_nneeds(L,ro);
  set32(vbuf,16,nn);
  iv_ans_clear(ans);
  let p:i32=0;
  while(p<nn){
    let st:i32=iv_plan_step(L,ro,p);
    let A2:[]u8=iv_raw(L);
    let ni:i32=get32(A2,st);
    let fam:i32=get32(A2,st+8);
    apply_kind1(G,W,OUTS,ni,ws,os);
    let bad:i32=0;
    if(fam==0){
      let rel:i32=get32(W,ni*ws+4);
      let obj:i32=get32(W,ni*ws+8);
      let ver:i32=ret_version(L,rel);
      set32(vbuf,p*4,ver);
      if(ver==2){
        set32(L,13252,get32(L,13252)+1);
        let rs:i32=ret_spec(L,A,rel,obj,K,0,OUTS,ni*os,ocap);
        if(rs<0){ bad=1; }
      }
      if(ver==0){
        set32(L,13256,get32(L,13256)+1);
        let rr:i32=ret_gen(A,rel,obj,K,0,OUTS,ni*os,ocap);
        if(rr<0){ bad=1; }
      }
      if(ans_append_rec(ans,OUTS,ni,os,ocap)<0){ bad=1; }
    }
    if(fam==1){
      let ver2:i32=vfy_version(L,W,ni);
      set32(vbuf,p*4,ver2);
      if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
      if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
      let src:i32=fanin_src(G,ni);
      if(src<0){
        w_to_chain(W,ni,tmpc,-1,ws);
        let vv:i32=0;
        if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
        set32(OUTS,ni*os,1);
        set32(OUTS,ni*os+4,vv);
        if(ans_append_rec(ans,OUTS,ni,os,ocap)<0){ bad=1; }
      }
      if(src>=0){
        let nsub:i32=get32(OUTS,src*os);
        let npass:i32=0;
        let k:i32=0;
        while(k<nsub){
          let sub:i32=get32(OUTS,src*os+4+k*4);
          w_to_chain(W,ni,tmpc,sub,ws);
          let vv2:i32=0;
          if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
          if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
          if(vv2==1){
            if(npass>=ocap){ bad=1; k=nsub; }
            if(npass<ocap){
              set32(OUTS,ni*os+4+npass*4,sub);
              npass=npass+1;
            }
          }
          k=k+1;
        }
        set32(OUTS,ni*os,npass);
        if(ans_append_rec(ans,OUTS,ni,os,ocap)<0){ bad=1; }
      }
    }
    if(fam==2){
      let rel3:i32=get32(W,ni*ws+4);
      let ver3:i32=cnt_version(L,rel3);
      set32(vbuf,p*4,ver3);
      let has3:i32=apply_kind3(G,OUTS,SUBL,ni,os,ss,scap);
      let ns3:i32=0;
      if(has3==-1){
        bad=1;
        iv_bump(L,IVS_SUBLCAP());
        iv_bump(L,IVS_CAPREF());
      }
      if(has3==1){ ns3=get32(SUBL,ni*ss); }
      if(has3==0){
        set32(SUBL,ni*ss,1);
        set32(SUBL,ni*ss+4,get32(W,ni*ws+12));
        ns3=1;
      }
      let cc:i32=-2;
      if(ver3==5){
        set32(L,13268,get32(L,13268)+1);
        cc=cnt_spec(L,A,rel3,SUBL,ni*ss+4,ns3,K,0,seen);
      }
      if(ver3==4){
        set32(L,13272,get32(L,13272)+1);
        cc=cnt_gen(A,rel3,SUBL,ni*ss+4,ns3,K,0,seen);
      }
      if(cc==-2){ bad=1; iv_bump(L,IVS_OUTCAP()); }
      if(cc==-1){ iv_bump(L,IVS_MISMATCH()); }
      set32(OUTS,ni*os,1);
      if(cc>=0){ set32(OUTS,ni*os+4,cc); }
      if(ans_append_rec(ans,OUTS,ni,os,ocap)<0){ bad=1; }
    }
    if(bad==1){ iv_ans_clear(ans); return -1; }
    p=p+1;
  }
  return 0;
}
// ---- compose: the learner-driven composition entry point ----
// RETURN CODES (frozen 0/1/2 preserved; refusals are NEW, DISTINCT codes so
// a caller can tell "I do not know" from "I refused to guess"):
//   0  declined        -- at least one need content could not be bound
//   1  plan loaded     -- an existing plan for THIS goal's content executed
//   2  plan built      -- a new plan for this content was created
//   3  goal refused    -- the goal record does not decode (ivg_ok > 0)
//   4  capacity refused-- a working buffer, the plan store or the answer
//                         buffer is at its recorded capacity
//   5  store violation -- iv_check found the store inconsistent
// On EVERY code except 1 and 2 the answer buffer is ZEROED.  The frozen code
// returned 2 ("built") after plan_new returned -1 and executed a plan at
// negative offsets, and returned 0 (declined) leaving the previous goal's
// answer in place.
fn compose(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  if(iv_ensure(L)<1){ iv_ans_clear(ans); return 5; }
  if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
  let bad:i32=ivg_ok(G);
  if(bad>0){
    iv_bump(L,IVS_DECODE());
    iv_ans_clear(ans);
    return 3;
  }
  let nn:i32=ivg_nneeds(G);
  let nf:i32=ivg_nfmax(G);
  let nl:i32=ivg_nlinks(G);
  let ocap:i32=A_OCAP(A);
  let LY:[]u8=z_alloc(32);
  ly_set(LY,nn,nf,nl,ocap);
  let W:[]u8=z_alloc(nn*ly_ws(LY));
  let OUTS:[]u8=z_alloc(nn*ly_os(LY));
  let tout:[]u8=z_alloc(4);
  let tmpc:[]u8=z_alloc(4+IV_TMPCHAIN()*12);
  let ord:[]u8=z_alloc(nn*4);
  let SUBL:[]u8=z_alloc(nn*ly_ss(LY));
  let seen:[]u8=z_alloc(4+IV_SEENCAP()*4);
  let cells:[]u8=z_alloc(IV_CELLCAP()*4);
  let gate:i32=iv_gate(LY,W,OUTS,ord,SUBL,seen,tout,tmpc);
  if(gate>0){
    iv_bump(L,IVS_BUFGATE());
    iv_bump(L,IVS_CAPREF());
    iv_ans_clear(ans);
    return 4;
  }
  let nc:i32=ivg_cells(G,cells);
  if(nc<1){
    iv_bump(L,IVS_DECODE());
    iv_ans_clear(ans);
    return 3;
  }
  let ro:i32=iv_plan_find(L,G,cells,nc);
  if(ro<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      iv_ans_clear(ans);
      return 0;
    }
    topo(G,ord);
    let ro2:i32=iv_plan_new(L,G,ord,cells,nc);
    if(ro2<0){
      iv_ans_clear(ans);
      return 4;
    }
    let rc2:i32=execute_plan(L,A,G,ro2,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,LY);
    set32(L,13224,get32(L,13224)+1);
    if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
    if(rc2<0){ iv_ans_clear(ans); return 4; }
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  let rc:i32=execute_plan(L,A,G,ro,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,LY);
  if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
  if(rc<0){ iv_ans_clear(ans); return 4; }
  return 1;
}

// =====================================================================
// c5 ADDITIVE GENERALIZATION (PREREG Section 2.2).
// Everything above this line is byte-identical to c4_learn.zag
// (cogops-diamond). What follows is purely additive: no C433
// function is modified. Frozen entry points keep their names:
// compose, execute_plan, topo, apply_kind1.
// New entry points: topo_g, apply_kind1_g, snap_out, out_eq_snap,
// exec_step_iter, execute_plan_iter, compose_iter, plan_drop.
// No world literals, no goal tags, no need tags, no relation ids
// appear below: all content arrives at runtime through goal records.
// =====================================================================

// ---- topo_g: Kahn with stall detection + deterministic fallback ----
// Runs Kahn; if no zero-indegree unplaced node remains, stops
// (instead of the frozen topo's re-place-node-0, which silently
// corrupts the order) and appends the unplaced needs in index
// order. Returns the Kahn-placed count (== nneeds on a DAG).
// Not cycle detection: it completes any partial order
// deterministically, with no goal-shape or back-edge test.
fn topo_g(G:[]u8,ord:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  let stall:i32=0;
  while(stall==0){
    let n2:i32=0;
    let fnd:i32=-1;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    if(fnd<0){ stall=1; }
    if(fnd>=0){
      set32(placed,fnd*4,1);
      set32(ord,p*4,fnd);
      p=p+1;
      if(p>=nn){ stall=1; }
      let l2:i32=0;
      while(l2<nl){
        let d2:i32=link_w(G,l2,1);
        let s2:i32=link_w(G,l2,4);
        if(s2==fnd){
          if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
        }
        l2=l2+1;
      }
    }
  }
  let kplaced:i32=p;
  let n3:i32=0;
  while(n3<nn){
    if(get32(placed,n3*4)==0){
      set32(ord,p*4,n3);
      p=p+1;
    }
    n3=n3+1;
  }
  return kplaced;
}
// ---- apply_kind1_g: kind-1 links fire only from non-empty sources ----
// Uniform dataflow rule: a scalar-copy link carries the source
// need's produced value; if the source output record is empty
// there is no value to carry, so the destination field keeps its
// current value. Identical to apply_kind1 whenever every kind-1
// source is non-empty (the whole C433 battery).
fn apply_kind1_g(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32,ws:i32,os:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let sn:i32=link_w(G,l,4);
      if(get32(OUTS,sn*os)>0){
        let ds:i32=link_w(G,l,3);
        let sk:i32=link_w(G,l,5);
        let ss:i32=link_w(G,l,6);
        let v:i32=0;
        if(sk==0){ v=get32(W,sn*ws+4+ss*4); }
        if(sk==1){ v=get32(OUTS,sn*os+4+ss*4); }
        set32(W,ni*ws+4+ds*4,v);
      }
    }
    l=l+1;
  }
  return;
}
// ---- output-record snapshot / comparison helpers ----
fn snap_out(OUTS:[]u8,ni:i32,snap:[]u8,os:i32)void {
  let n:i32=get32(OUTS,ni*os);
  if(n>8){ n=8; }
  set32(snap,0,n);
  let k:i32=0;
  while(k<n){
    set32(snap,4+k*4,get32(OUTS,ni*os+4+k*4));
    k=k+1;
  }
  return;
}
fn out_eq_snap(OUTS:[]u8,ni:i32,snap:[]u8,os:i32)i32 {
  let n:i32=get32(OUTS,ni*os);
  if(n!=get32(snap,0)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(OUTS,ni*os+4+k*4)!=get32(snap,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- exec_step_iter: execute one plan step with the generalized link rule ----
// Versions recorded to vbuf[p*4]. No answer emission; the caller
// emits final records after quiescence.
// `ro` is the CONTENT-KEYED plan record; every stride comes from LY.
// Returns -1 on a capacity refusal (the caller must decline, not answer).
fn exec_step_iter(L:[]u8,A:[]u8,G:[]u8,ro:i32,p:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,LY:[]u8)i32 {
  let ws:i32=ly_ws(LY);
  let os:i32=ly_os(LY);
  let ss:i32=ly_ss(LY);
  let ocap:i32=ly_ocap(LY);
  let st:i32=iv_plan_step(L,ro,p);
  let AR:[]u8=iv_raw(L);
  let ni:i32=get32(AR,st);
  let fam:i32=get32(AR,st+8);
  apply_kind1_g(G,W,OUTS,ni,ws,os);
  let bad:i32=0;
  if(fam==0){
    let rel:i32=get32(W,ni*ws+4);
    let obj:i32=get32(W,ni*ws+8);
    let ver:i32=ret_version(L,rel);
    set32(vbuf,p*4,ver);
    if(ver==2){
      set32(L,13252,get32(L,13252)+1);
      let rs:i32=ret_spec(L,A,rel,obj,K,0,OUTS,ni*os,ocap);
      if(rs<0){ bad=1; }
    }
    if(ver==0){
      set32(L,13256,get32(L,13256)+1);
      let rr:i32=ret_gen(A,rel,obj,K,0,OUTS,ni*os,ocap);
      if(rr<0){ bad=1; }
    }
  }
  if(fam==1){
    let ver2:i32=vfy_version(L,W,ni);
    set32(vbuf,p*4,ver2);
    if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
    if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
    let src:i32=fanin_src(G,ni);
    if(src<0){
      w_to_chain(W,ni,tmpc,-1,ws);
      let vv:i32=0;
      if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
      if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
      set32(OUTS,ni*os,1);
      set32(OUTS,ni*os+4,vv);
    }
    if(src>=0){
      let nsub:i32=get32(OUTS,src*os);
      let npass:i32=0;
      let k:i32=0;
      while(k<nsub){
        let sub:i32=get32(OUTS,src*os+4+k*4);
        w_to_chain(W,ni,tmpc,sub,ws);
        let vv2:i32=0;
        if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
        if(vv2==1){
          if(npass>=ocap){ bad=1; k=nsub; }
          if(npass<ocap){
            set32(OUTS,ni*os+4+npass*4,sub);
            npass=npass+1;
          }
        }
        k=k+1;
      }
      set32(OUTS,ni*os,npass);
    }
  }
  if(fam==2){
    let rel3:i32=get32(W,ni*ws+4);
    let ver3:i32=cnt_version(L,rel3);
    set32(vbuf,p*4,ver3);
    let has3:i32=apply_kind3(G,OUTS,SUBL,ni,os,ss,IV_FANINCAP());
    let ns3:i32=0;
    if(has3==-1){ bad=1; iv_bump(L,IVS_SUBLCAP()); iv_bump(L,IVS_CAPREF()); }
    if(has3==1){ ns3=get32(SUBL,ni*ss); }
    if(has3==0){
      set32(SUBL,ni*ss,1);
      set32(SUBL,ni*ss+4,get32(W,ni*ws+12));
      ns3=1;
    }
    let cc:i32=0;
    if(ver3==5){
      set32(L,13268,get32(L,13268)+1);
      cc=cnt_spec(L,A,rel3,SUBL,ni*ss+4,ns3,K,0,seen);
    }
    if(ver3==4){
      set32(L,13272,get32(L,13272)+1);
      cc=cnt_gen(A,rel3,SUBL,ni*ss+4,ns3,K,0,seen);
    }
    if(cc==-2){ bad=1; iv_bump(L,IVS_OUTCAP()); }
    set32(OUTS,ni*os,1);
    set32(OUTS,ni*os+4,cc);
  }
  if(bad==1){ return -1; }
  return 0;
}
// ---- execute_plan_iter: change-driven iterated execution ----
// Steps run in plan order; a need executes when dirty (all start
// dirty). If its output record changed, link-successors are marked
// dirty. Halts on quiescence (a pass with no dirty need) or the
// pass CAP (16, frozen totality bound). Answer records are emitted
// in plan order with FINAL values. vbuf[20] gets passes used.
fn execute_plan_iter(L:[]u8,A:[]u8,G:[]u8,ro:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,dirty:[]u8,snap:[]u8,LY:[]u8)i32 {
  let os:i32=ly_os(LY);
  let ocap:i32=ly_ocap(LY);
  mat_inputs(G,W,ly_ws(LY));
  let nn:i32=iv_plan_nneeds(L,ro);
  let nl:i32=g_nlinks(G);
  set32(vbuf,16,nn);
  iv_ans_clear(ans);
  let n:i32=0;
  while(n<nn){ set32(dirty,n*4,1); n=n+1; }
  let pass:i32=0;
  let cap:i32=16;
  let running:i32=1;
  let bad:i32=0;
  while(running==1){
    if(pass>=cap){ running=0; }
    if(running==1){
      let progressed:i32=0;
      let p:i32=0;
      while(p<nn){
        let AR:[]u8=iv_raw(L);
        let ni:i32=get32(AR,iv_plan_step(L,ro,p));
        if(get32(dirty,ni*4)==1){
          progressed=1;
          set32(dirty,ni*4,0);
          snap_out(OUTS,ni,snap,os);
          let er:i32=exec_step_iter(L,A,G,ro,p,K,vbuf,W,OUTS,tmpc,SUBL,seen,LY);
          if(er<0){ bad=1; running=0; p=nn; }
          if(er>=0){
            if(out_eq_snap(OUTS,ni,snap,os)==0){
              let l:i32=0;
              while(l<nl){
                if(link_w(G,l,4)==ni){
                  set32(dirty,link_w(G,l,1)*4,1);
                }
                l=l+1;
              }
            }
          }
        }
        p=p+1;
      }
      pass=pass+1;
      if(progressed==0){ running=0; }
    }
  }
  set32(vbuf,20,pass);
  if(bad==1){ iv_ans_clear(ans); return -1; }
  let q:i32=0;
  while(q<nn){
    let AR2:[]u8=iv_raw(L);
    let nj:i32=get32(AR2,iv_plan_step(L,ro,q));
    if(ans_append_rec(ans,OUTS,nj,os,ocap)<0){ iv_ans_clear(ans); return -1; }
    q=q+1;
  }
  return 0;
}
// ---- compose_iter: the generalized composition entry point ----
// Returns 0 = declined, 1 = plan loaded, 2 = plan built.
// vbuf[16] = nneeds, vbuf[20] = passes used; ans = final records.
fn compose_iter(L:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  if(iv_ensure(L)<1){ iv_ans_clear(ans); return 5; }
  if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
  let bad0:i32=ivg_ok(G);
  if(bad0>0){ iv_bump(L,IVS_DECODE()); iv_ans_clear(ans); return 3; }
  let nn:i32=ivg_nneeds(G);
  let nf:i32=ivg_nfmax(G);
  let nl:i32=ivg_nlinks(G);
  let ocap:i32=A_OCAP(A);
  let LY:[]u8=z_alloc(32);
  ly_set(LY,nn,nf,nl,ocap);
  let W:[]u8=z_alloc(nn*ly_ws(LY));
  let OUTS:[]u8=z_alloc(nn*ly_os(LY));
  let tout:[]u8=z_alloc(4);
  let tmpc:[]u8=z_alloc(4+IV_TMPCHAIN()*12);
  let ord:[]u8=z_alloc(nn*4);
  let SUBL:[]u8=z_alloc(nn*ly_ss(LY));
  let seen:[]u8=z_alloc(4+IV_SEENCAP()*4);
  let dirty:[]u8=z_alloc(nn*4);
  let snap:[]u8=z_alloc(4+8*4);
  let cells:[]u8=z_alloc(IV_CELLCAP()*4);
  let gate:i32=iv_gate(LY,W,OUTS,ord,SUBL,seen,tout,tmpc);
  if(gate>0){
    iv_bump(L,IVS_BUFGATE()); iv_bump(L,IVS_CAPREF()); iv_ans_clear(ans); return 4;
  }
  let nc:i32=ivg_cells(G,cells);
  if(nc<1){ iv_bump(L,IVS_DECODE()); iv_ans_clear(ans); return 3; }
  let ro:i32=iv_plan_find(L,G,cells,nc);
  if(ro<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      iv_ans_clear(ans);
      return 0;
    }
    topo_g(G,ord);
    let ro2:i32=iv_plan_new(L,G,ord,cells,nc);
    if(ro2<0){ iv_ans_clear(ans); return 4; }
    let rc2:i32=execute_plan_iter(L,A,G,ro2,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap,LY);
    set32(L,13224,get32(L,13224)+1);
    if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
    if(rc2<0){ iv_ans_clear(ans); return 4; }
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  let rc:i32=execute_plan_iter(L,A,G,ro,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen,dirty,snap,LY);
  if(iv_record_check(L)>0){ iv_ans_clear(ans); return 5; }
  if(rc<0){ iv_ans_clear(ans); return 4; }
  return 1;
}
// ---- plan_drop: drop the stored plan for one goal tag -----------------
// IDENTITY IS CONTENT.  Dropping "the plan for goal tag T" is a PROJECTION
// operation and could discard a plan that is not the caller's.  The frozen
// signature is kept for compatibility, so this drops every live plan whose
// goal TAG matches AND records the fact that a projection was used; the
// content-exact drop is iv_plan_drop(L,ro).
fn plan_drop(L:[]u8,gtag:i32)void {
  if(iv_magic_ok(L)==0){ return; }
  iv_bump(L,IVS_PROJREF());
  let A:[]u8=iv_raw(L);
  let ro:i32=get32(A,A_PHDR()+20);
  while(ro>=0){
    let b:i32=iv_prec(L,ro);
    let nx:i32=get32(A,b+16);
    if(get32(A,b+4)==gtag){ iv_plan_free(L,ro); }
    ro=nx;
  }
  return;
}

// =====================================================================
// c7 ADDITIVE: learner-invented oscillation handling.
// Everything above this line is byte-identical to c6_learn.zag
// (cogops-oscillatory). What follows is purely additive: no frozen
// function is modified. New entry points: traj_base, outc_base,
// outc_phase_base, traj_log, traj_need_eq, traj_state_eq,
// osc_review, outc_find, outc_phase_copy, outc_store,
// outc_phase_eq, osc_one_pass, osc_handle.
// Learner-state regions (L holds 16384 bytes; prior use ends at
// 13276):
//   TRAJ at 13300: [ntraj]; snapshots at 13304+(pass*4+ni)*36,
//   pass below 8, ni below 4; each need snapshot is nine i32
//   cells [n, v0..v7].
//   OUTC at 14500: [nout]; at most three entries of 464 bytes at
//   14504+e*464: [goal_tag, lag, nph, src, four reserved cells,
//   then phases: at most three phases times four needs times
//   nine i32 cells].
// No world literals, no goal tags, no need tags, no relation ids
// appear below: every value arrives at runtime through goal
// records, episodes, or the trajectory.
// =====================================================================

fn traj_base(pass:i32,ni:i32)i32 { return 13304+(pass*4+ni)*36; }
fn outc_base(e:i32)i32 { return 14504+e*464; }
fn outc_phase_base(e:i32,t:i32,ni:i32)i32 {
  return 14504+e*464+32+(t*4+ni)*36;
}
// snapshot every need's output record after one pass
fn traj_log(L:[]u8,OUTS:[]u8,nn:i32,pass:i32,os:i32)void {
  if(pass<0){ return; }
  if(pass>7){ return; }
  let j:i32=0;
  while(j<nn){
    let n:i32=get32(OUTS,j*os);
    if(n>8){ n=8; }
    let bo:i32=traj_base(pass,j);
    set32(L,bo,n);
    let k:i32=0;
    while(k<8){
      let v:i32=0;
      if(k<n){ v=get32(OUTS,j*os+4+k*4); }
      set32(L,bo+4+k*4,v);
      k=k+1;
    }
    j=j+1;
  }
  set32(L,13300,pass+1);
  return;
}
fn traj_need_eq(L:[]u8,p:i32,q:i32,ni:i32)i32 {
  let bp:i32=traj_base(p,ni);
  let bq:i32=traj_base(q,ni);
  let n:i32=get32(L,bp);
  if(n!=get32(L,bq)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(L,bp+4+k*4)!=get32(L,bq+4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
fn traj_state_eq(L:[]u8,p:i32,q:i32,nn:i32)i32 {
  let j:i32=0;
  while(j<nn){
    if(traj_need_eq(L,p,q,j)==0){ return 0; }
    j=j+1;
  }
  return 1;
}
// nearest-first scan: does snapshot[pass] equal an earlier
// snapshot? Returns the lag, or zero when nothing recurs.
fn osc_review(L:[]u8,nn:i32,pass:i32)i32 {
  let q:i32=pass-1;
  while(q>=0){
    if(traj_state_eq(L,pass,q,nn)==1){ return pass-q; }
    q=q-1;
  }
  return 0;
}
// IDENTITY IS CONTENT (P1): the outcome record is keyed by the CONTENT-KEYED
// PLAN RECORD OFFSET, not by the bare goal tag.  Two goals sharing a tag now
// get separate outcome records instead of sharing one lag.
fn outc_find(L:[]u8,key:i32)i32 {
  let n:i32=get32(L,14500);
  let e:i32=0;
  while(e<n){
    if(get32(L,outc_base(e))==key){ return e; }
    e=e+1;
  }
  return -1;
}
fn outc_phase_copy(L:[]u8,e:i32,t:i32,ni:i32,p:i32)void {
  let sb:i32=traj_base(p,ni);
  let db:i32=outc_phase_base(e,t,ni);
  let k:i32=0;
  while(k<9){
    set32(L,db+k*4,get32(L,sb+k*4));
    k=k+1;
  }
  return;
}
fn outc_store(L:[]u8,key:i32,lag:i32,q:i32,nn:i32,src:i32)i32 {
  let e:i32=outc_find(L,key);
  if(e<0){
    e=get32(L,14500);
    if(e>2){ e=0; }
    if(get32(L,14500)<3){ set32(L,14500,get32(L,14500)+1); }
  }
  let b:i32=outc_base(e);
  set32(L,b,key);
  set32(L,b+4,lag);
  set32(L,b+8,lag);
  set32(L,b+12,src);
  set32(L,b+16,0);
  set32(L,b+20,0);
  set32(L,b+24,0);
  set32(L,b+28,0);
  let t:i32=0;
  while(t<lag){
    let j:i32=0;
    while(j<nn){
      outc_phase_copy(L,e,t,j,q+t);
      j=j+1;
    }
    t=t+1;
  }
  return e;
}
// stored phase (e,t,ni) against trajectory snapshot p
fn outc_phase_eq(L:[]u8,e:i32,t:i32,ni:i32,p:i32)i32 {
  let db:i32=outc_phase_base(e,t,ni);
  let sb:i32=traj_base(p,ni);
  let n:i32=get32(L,db);
  if(n!=get32(L,sb)){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(L,db+4+k*4)!=get32(L,sb+4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// one full pass over the plan in plan order; R+28 is the
// spec-version flag, cleared if any step misses its spec version
fn osc_one_pass(L:[]u8,A:[]u8,G:[]u8,ro:i32,K:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8,R:[]u8,LY:[]u8)i32 {
  let nn:i32=iv_plan_nneeds(L,ro);
  let bad:i32=0;
  let p:i32=0;
  while(p<nn){
    let er:i32=exec_step_iter(L,A,G,ro,p,K,vbuf,W,OUTS,tmpc,SUBL,seen,LY);
    if(er<0){ bad=1; }
    let AR:[]u8=iv_raw(L);
    let fam:i32=get32(AR,iv_plan_step(L,ro,p)+8);
    let ver:i32=get32(vbuf,p*4);
    let want:i32=-1;
    if(fam==0){ want=2; }
    if(fam==1){ want=3; }
    if(fam==2){ want=5; }
    if(ver!=want){ set32(R,28,0); }
    p=p+1;
  }
  if(bad==1){ return -1; }
  return 0;
}
// osc_handle: the learner-owned oscillation-handling driver.
// R holds [how, passes, lag, q, nph, src, entry, specok].
// Returns -1 declined, 0 no handling (generic fallback applies),
// 1 handled by a response invented from this trajectory,
// 2 handled by a stored response from the outcome record.
fn osc_handle(L:[]u8,A:[]u8,G:[]u8,K:[]u8,R:[]u8)i32 {
  if(iv_ensure(L)<1){ return -1; }
  if(iv_record_check(L)>0){ return -1; }
  let bd:i32=ivg_ok(G);
  if(bd>0){ iv_bump(L,IVS_DECODE()); return -1; }
  let nn:i32=ivg_nneeds(G);
  let nf:i32=ivg_nfmax(G);
  let nl:i32=ivg_nlinks(G);
  let ocap:i32=A_OCAP(A);
  let LY:[]u8=z_alloc(32);
  ly_set(LY,nn,nf,nl,ocap);
  let W:[]u8=z_alloc(nn*ly_ws(LY));
  let OUTS:[]u8=z_alloc(nn*ly_os(LY));
  let tout:[]u8=z_alloc(4);
  let tmpc:[]u8=z_alloc(4+IV_TMPCHAIN()*12);
  let ord:[]u8=z_alloc(nn*4);
  let SUBL:[]u8=z_alloc(nn*ly_ss(LY));
  let seen:[]u8=z_alloc(4+IV_SEENCAP()*4);
  let vbuf:[]u8=z_alloc(32);
  let cells:[]u8=z_alloc(IV_CELLCAP()*4);
  set32(R,0,0);
  set32(R,4,0);
  set32(R,8,0);
  set32(R,12,0);
  set32(R,16,0);
  set32(R,20,0);
  set32(R,24,-1);
  set32(R,28,1);
  if(iv_gate(LY,W,OUTS,ord,SUBL,seen,tout,tmpc)>0){
    iv_bump(L,IVS_BUFGATE()); iv_bump(L,IVS_CAPREF()); return -1;
  }
  let nc:i32=ivg_cells(G,cells);
  if(nc<1){ iv_bump(L,IVS_DECODE()); return -1; }
  let pre:i32=iv_plan_find(L,G,cells,nc);
  let ro:i32=pre;
  if(ro<0){
    let ok:i32=learn_bindings(L,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return -1;
    }
    topo_g(G,ord);
    ro=iv_plan_new(L,G,ord,cells,nc);
  }
  if(ro<0){ return -1; }
  if(pre>=0){ set32(L,13228,get32(L,13228)+1); }
  mat_inputs(G,W,ly_ws(LY));
  let e:i32=outc_find(L,ro);
  if(e>=0){
    let lag0:i32=get32(L,outc_base(e)+4);
    let mpass:i32=0;
    let okk:i32=1;
    while(mpass<2){
      if(okk==1){
        osc_one_pass(L,A,G,ro,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,LY);
        traj_log(L,OUTS,nn,mpass,ly_os(LY));
        let jj:i32=0;
        while(jj<nn){
          if(outc_phase_eq(L,e,mpass,jj,mpass)==0){ okk=0; }
          jj=jj+1;
        }
      }
      mpass=mpass+1;
    }
    if(okk==1){
      set32(R,0,2);
      set32(R,4,2);
      set32(R,8,lag0);
      set32(R,12,0);
      set32(R,16,lag0);
      set32(R,20,1);
      set32(R,24,e);
      return 2;
    }
    set32(L,13300,0);
  }
  let pass:i32=0;
  while(pass<6){
    osc_one_pass(L,A,G,ro,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,LY);
    traj_log(L,OUTS,nn,pass,ly_os(LY));
    if(pass>1){
      let lag:i32=osc_review(L,nn,pass);
      if(lag==1){ return 0; }
      if(lag>1){
        if(lag<4){
          let q0:i32=pass-lag;
          osc_one_pass(L,A,G,ro,K,vbuf,W,OUTS,tmpc,SUBL,seen,R,LY);
          traj_log(L,OUTS,nn,pass+1,ly_os(LY));
          if(traj_state_eq(L,pass+1,q0+1,nn)==1){
            let ee:i32=outc_store(L,ro,lag,q0,nn,0);
            set32(R,0,1);
            set32(R,4,pass+2);
            set32(R,8,lag);
            set32(R,12,q0);
            set32(R,16,lag);
            set32(R,20,0);
            set32(R,24,ee);
            return 1;
          }
          return 0;
        }
      }
    }
    pass=pass+1;
  }
  return 0;
}
// adv_lib.zag -- ADVERSARY-WORLDS shared harness (C500).
// Concatenated AFTER the frozen c15_base.zag + c8_learn.zag.
// Contains NO world literals and NO goal shapes: only builders.
//
// OUTPUT DISCIPLINE (brief 4.0): the frozen c15_base.zag:52 `o_flush` uses
// _zag_raw_syscall, which is INERT on this host (produces empty output, rc=0).
// My worlds NEVER call it. `a_flush` uses _zag_print. a_flush is also
// installed as the ONLY flush any adversary code calls.

// ---- portable flush (brief 4.0 mandated shim) ----
fn a_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }

// ---- self-sufficient output primitives (o_app/o_i64/o_nl live only in
// c15_base.zag, which is absent from the TNN-2 build) ----
fn a_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn a_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn a_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }

// ---- assertions on non-empty output ----
fn a_assert_ne(c:i32,min:i32)void {
  if(c<min){ _zag_println("A_ASSERT_FAIL_EMPTY_OUTPUT"); return; }
  return;
}

// ---- goal record builder (mirrors c8_world.zag convention, distinct names) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links 28 bytes: [kind,dst_need,dst_kind,dst_slot,
// src_need,src_kind,src_slot].
fn a_begin(G:[]u8,tag:i32,nn:i32)i32 {
  set32(G,0,tag); set32(G,4,nn); return 8;
}
fn a_need(G:[]u8,off:i32,tag:i32,nf:i32)i32 {
  set32(G,off,tag); set32(G,off+4,nf); return off+8;
}
fn a_f(G:[]u8,off:i32,v:i32)i32 { set32(G,off,v); return off+4; }
fn a_links(G:[]u8,off:i32,nl:i32)i32 { set32(G,off,nl); return off+4; }
fn a_link(G:[]u8,off:i32,kd:i32,dn:i32,dk:i32,ds:i32,sn:i32,sk:i32,ss:i32)i32 {
  set32(G,off,kd); set32(G,off+4,dn); set32(G,off+8,dk);
  set32(G,off+12,ds); set32(G,off+16,sn); set32(G,off+20,sk);
  set32(G,off+24,ss); return off+28;
}

// ---- report helpers ----
fn a_tag(b:[]u8,c:i32,s:[]u8)i32 { c=a_app(b,c,s); c=a_nl(b,c); return c; }
fn a_kv(b:[]u8,c:i32,k:[]u8,v:i32)i32 {
  c=a_app(b,c,k); c=a_app(b,c,"=");
  c=a_i64(b,c,v as i64); c=a_nl(b,c); return c;
}
fn a_kvs(b:[]u8,c:i32,k:[]u8,v:[]u8)i32 {
  c=a_app(b,c,k); c=a_app(b,c,"="); c=a_app(b,c,v); c=a_nl(b,c); return c;
}
fn a_verdict(b:[]u8,c:i32,name:[]u8,got:i32,want:i32)i32 {
  c=a_app(b,c,name); c=a_app(b,c," got=");
  c=a_i64(b,c,got as i64); c=a_app(b,c," want=");
  c=a_i64(b,c,want as i64);
  if(got==want){ c=a_app(b,c,"  RESULT=AS_PREDICTED"); }
  else { c=a_app(b,c,"  RESULT=DEVIATION"); }
  c=a_nl(b,c); return c;
}
// structural assertion about a value list: returns 1 iff every entry is in
// the allowed set (av, len) -- used to detect cross-record contamination.
fn a_in_set(vals:[]u8,n:i32,av:[]u8,na:i32)i32 {
  let i:i32=0;
  while(i<n){
    let x:i32=get32(vals,i*4); let j:i32=0; let f:i32=0;
    while(j<na){ if(get32(av,j*4)==x){ f=1; } j=j+1; }
    if(f==0){ return 0; }
    i=i+1;
  }
  return 1;
}
// dump an answer record flat
fn a_ans(b:[]u8,c:i32,ans:[]u8)i32 {
  let n:i32=get32(ans,0);
  c=a_app(b,c,"ans=[");
  let i:i32=0;
  while(i<n){
    if(i>0){ c=a_app(b,c,","); }
    c=a_i64(b,c,get32(ans,4+i*4) as i64); i=i+1;
  }
  c=a_app(b,c,"]");
  c=a_nl(b,c); return c;
}
fn a_note(b:[]u8,c:i32,s:[]u8)i32 { c=a_app(b,c,"  "); c=a_app(b,c,s); c=a_nl(b,c); return c; }
// AW-03 fanin-overflow (C503).
// W7: ret_gen (c15_base.zag:94) stores at most 32 subjects (`if(n<32)`) but
//     line 100 writes the UNCLAMPED count n into out[0].
// W8: apply_kind3 (c8_learn.zag:441) writes SUBL[ni*128+4+tot*4] with no
//     bound on tot, summed over ALL incoming kind-3 links.
//
// World: relation 20 has 40 subjects with object 9. Relation 21 has 40
// subjects with object 9. A COUNT need with TWO incoming kind-3 links over
// the two RETRIEVE needs -> fan-in total 80 subjects into a 128-byte slot.
//
// PREREG: the count is contaminated with integers that are not world objects,
// or the process dies. Kill bar: a correct count AND every consumed subject
// is a real world subject.
//
// This file also measures the ret_gen truncation directly (probe T) so the
// two defects are separable.

fn aw03_world(A:[]u8)void {
  let i:i32=1;
  while(i<=40){
    fact_add(A,i,20,9);
    fact_add(A,i+100,21,9);
    i=i+1;
  }
  // Subject 0 exists and has a rel-20 fact. The truncated RETRIEVE tail reads
  // the zero-filled tail of the output record, i.e. it INVENTS subject 0.
  fact_add(A,0,20,77);
  return;
}
fn aw03_T(G:[]u8)void {   // one RETRIEVE need, rel 20 obj 9 -> 40 subjects
  let o:i32=a_begin(G,7500,1);
  o=a_need(G,o,21,2); o=a_f(G,o,20); o=a_f(G,o,9);
  o=a_links(G,o,0); return;
}
fn aw03_F(G:[]u8)void {   // diamond: need0,need1 RETRIEVE -> need2 COUNT, 2x kind3
  let o:i32=a_begin(G,7501,3);
  o=a_need(G,o,21,2); o=a_f(G,o,20); o=a_f(G,o,9);
  o=a_need(G,o,22,2); o=a_f(G,o,21); o=a_f(G,o,9);
  o=a_need(G,o,23,3); o=a_f(G,o,20); o=a_f(G,o,1); o=a_f(G,o,0);
  o=a_links(G,o,2);
  o=a_link(G,o,3,2,0,0,0,1,0);
  o=a_link(G,o,3,2,0,0,1,1,0);
  return;
}
fn aw03_allowed(v:[]u8)void {
  set32(v,0,1); let i:i32=1;
  while(i<=40){ set32(v,i*4,i); i=i+1; }
  set32(v,41*4,101); i=1;
  while(i<=40){ set32(v,(41+i)*4,100+i); i=i+1; }
  return;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let A:[]u8=world_new();
  let G:[]u8=z_alloc(512);
  let ans:[]u8=z_alloc(16384);
  let vbuf:[]u8=z_alloc(32);
  let av:[]u8=z_alloc(512);
  aw03_world(A);
  aw03_allowed(av);
  c=a_tag(B,c,"AW-03 fan-in overflow");
  c=a_kvs(B,c,"world","(1..40,20,9) (101..140,21,9) (0,20,77); 81 facts");
  c=a_kvs(B,c,"truth_T","RETRIEVE rel20 obj9 -> exactly the 40 subjects 1..40");
  c=a_kvs(B,c,"truth_F","fan-in set is {1..40}+{101..140}; distinct rel20 objs = {9} -> 1");
  c=a_kvs(B,c,"why_0","subject 0 exists with rel20 object 77, so any phantom 0");
  // ---- probe T: isolate W7 (ret_gen 32-clamp with true count) ----
  let LT:[]u8=z_alloc(16384);
  aw03_T(G);
  let rcT:i32=compose(LT,A,G,K,ans,vbuf);
  c=a_tag(B,c,"== probe T: single RETRIEVE with 40 subjects (W7)");
  c=a_kv(B,c,"  compose_rc",rcT);
  c=a_kv(B,c,"  ans_total_ints",get32(ans,0));
  c=a_kv(B,c,"  ans_rec0_len_REPORTED",get32(ans,4));
  // how many reported entries are real world subjects?
  let nrep:i32=get32(ans,4);
  let nreal:i32=0; let i:i32=0;
  while(i<nrep){
    if(a_in_set(ans,1+0,av,81)==0){ i=i+1; }
    i=i+1;
  }
  // scan reported list explicitly against the allowed set
  let bad:i32=0; let good:i32=0;
  i=0;
  while(i<nrep){
    let x:i32=get32(ans,8+i*4);
    if(a_in_set(av,1,av,81)==1){ }
    let j:i32=0; let f:i32=0;
    while(j<81){ if(get32(av,j*4)==x){ f=1; } j=j+1; }
    if(f==1){ good=good+1; } else { bad=bad+1; c=a_kv(B,c,"  NONWORLD_VALUE_at_index",i); c=a_kv(B,c,"  NONWORLD_VALUE",x); }
    i=i+1;
  }
  c=a_kv(B,c,"  reported_entries",nrep);
  c=a_kv(B,c,"  entries_that_are_world_subjects",good);
  c=a_kv(B,c,"  entries_that_are_NOT_world_subjects",bad);
  // ---- probe F: isolate W8 (unbounded kind-3 fan-in tot) ----
  c=a_tag(B,c,"== probe F: two kind-3 sources x 40 subjects, tot=80 (W8)");
  let LF:[]u8=z_alloc(16384);
  aw03_F(G);
  let rcF:i32=compose(LF,A,G,K,ans,vbuf);
  c=a_kv(B,c,"  compose_rc",rcF);
  c=a_kv(B,c,"  ans_total_ints",get32(ans,0));
  // records in emission order: need1(idx 1..41) need0(idx 42..82) need2(idx 83..84)
  // a_ans prints i=0..n-1 at byte 4+i*4, so i maps to ans index i+1.
  let cl:i32=get32(ans,4+82*4);
  let cc:i32=get32(ans,4+83*4);
  c=a_kv(B,c,"  count_rec_len",cl);
  c=a_kv(B,c,"  count_REPORTED",cc);
  c=a_verdict(B,c,"count_TRUTH",1,cc);
  c=a_ans(B,c,ans);
  a_assert_ne(c,200);
  a_flush(B,c);
  return 0;
}

// fu_patch.zag -- formal-understanding treatment (unfrozen).
// New fu_-prefixed functions only. No base function is redefined.
// Relation ids: ADD=41 MUL=42 DADD=43 DMUL=44 BUILD=45 SUB=46.
// Pair encoding P(a,b) = a*16+b.

// Learner-owned semantic lookup: is (pair, op, t) in TNN's own learned
// state? Read-only scan. The VALUES come from learner state; the lookup
// procedure is driver code.
fn fu_eval_known(W:[]u8,pair:i32,op:i32,t:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==pair && ng(W,n,24)==op && ng(W,n,28)==t){return 1;}
    n=n+1;
  }
  return 0;
}

// Most recent MAP node for (s,r). Returns -1 if none.
fn fu_find_map(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,8)==s && ng(W,m,4)==r){best=m;}
    m=m+1;
  }
  return best;
}

// Classify the (T,BUILD) construction from the promoted MAP's DEP edges.
// 1 = valid: single DADD/DMUL dep, pair decodes to a,b in 0..9, and TNN's
//     own eval knowledge confirms op(a,b)==T.
// 2 = multi-dep (long chain or sum): not a single decomposition.
// 3 = wrong-relation dep.
// 4 = non-pair output or literal out of range.
// 5 = value mismatch: pair does not evaluate to T per TNN knowledge.
// 0 = no MAP found.
fn fu_classify(W:[]u8,t:i32)i32 {
  let m:i32=fu_find_map(W,t,45);
  if(m<0){return 0;}
  let deps:[]u8=z_alloc(64); let nd:i32=0;
  let e:i32=0;
  while(e<4096 && nd<16){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1){
      set32(deps,nd*4,eg(W,e,8)); nd=nd+1;
    }
    e=e+1;
  }
  if(nd!=1){return 2;}
  let f:i32=get32(deps,0);
  if(f<2 || f>=1024 || ng(W,f,36)!=1 || ng(W,f,0)!=1){return 2;}
  let fr:i32=ng(W,f,24); let oo:i32=ng(W,f,28);
  if(fr!=43 && fr!=44){return 3;}
  let a:i32=oo/16; let b:i32=oo-(a*16);
  if(a<0 || a>9 || b<0 || b>9){return 4;}
  let op:i32=41; if(fr==44){op=42;}
  if(fu_eval_known(W,oo,op,t)==0){return 5;}
  return 1;
}

// Treatment: grammar-restricted BUILD search with learner-owned semantic
// verification. Only single-link candidates licensed by DADD/DMUL facts
// are considered (this restriction is RESEARCHER-AUTHORED: it encodes
// BUILD's grammar). Each candidate pair is then verified against TNN's
// OWN eval knowledge (LEARNER-OWNED values): accept iff TNN knows
// op(a,b)==t. Promotes on success, returns -2 (honest miss) otherwise.
fn fu_trial_build(W:[]u8,t:i32)i32 {
  let paths:[]u8=z_alloc(96*48);
  let np:i32=t2_gather(W,t,paths);
  let p:i32=0;
  while(p<np){
    let base:i32=p*48;
    if(get32(paths,base)==2){
      let f:i32=get32(paths,base+24);
      let fr:i32=-1;
      if(f>=2 && f<1024 && ng(W,f,36)==1 && ng(W,f,0)==1){fr=ng(W,f,24);}
      if(fr==43 || fr==44){
        let v:[]u8=z_alloc(24); let ff:[]u8=z_alloc(16);
        set32(v,0,get32(paths,base+4)); set32(v,4,get32(paths,base+8));
        set32(ff,0,f);
        let root:i32=t2_asm_chain(W,v,2,ff);
        let out:i32=-999999;
        if(root>=0){out=t2_exec(W,root,t);}
        if(out!=-999999 && out!=-2){
          let a:i32=out/16; let b:i32=out-(a*16);
          let op:i32=41; if(fr==44){op=42;}
          if(a>=0 && a<=9 && b>=0 && b<=9 && fu_eval_known(W,out,op,t)==1){
            promote_graph(W,root,t,45,out,ff,1);
            return out;
          }
        }
      }
    }
    p=p+1;
  }
  return -2;
}

// fu_driver.zag -- formal understanding experiment driver.
// Formal system EXL: literals 0..9; ops ADD(41), MUL(42); grammar
// E := ADD(lit,lit) | MUL(lit,lit); constraint: all values < 64.
// DADD=43 DMUL=44 (decomposition grammar), BUILD=45, SUB=46.
// Pair P(a,b) = a*16+b.

fn fu_P(a:i32,b:i32)i32 { return a*16+b; }

fn fu_tstat(W:[]u8)void {
  let t:i32=hg(W,16);
  emit(" tried="); e64(t/1024); emit(" rejected="); e64(t-(t/1024)*1024); emit("\n");
  return;
}

// ---- teaching ----

fn fu_dadd(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a+b==t){ev_teach_in(W,t,43,fu_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn fu_dmul(W:[]u8,t:i32)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      if(a*b==t){ev_teach_in(W,t,44,fu_P(a,b));}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn fu_teach_decomp(W:[]u8)void {
  let t:i32=2;
  while(t<=9){fu_dadd(W,t); fu_dmul(W,t); t=t+1;}
  fu_dadd(W,16); fu_dmul(W,16);
  fu_dadd(W,18); fu_dmul(W,18);
  fu_dmul(W,20);
  fu_dmul(W,21);
  fu_dmul(W,24);
  fu_dmul(W,25);
  fu_dadd(W,10); fu_dmul(W,10);
  fu_dadd(W,11); fu_dmul(W,11);
  fu_dadd(W,12); fu_dmul(W,12);
  fu_dadd(W,13); fu_dmul(W,13);
  fu_dadd(W,14); fu_dmul(W,14);
  fu_dadd(W,15); fu_dmul(W,15);
  fu_dmul(W,28);
  fu_dmul(W,30);
  fu_dmul(W,42);
  fu_dmul(W,45);
  fu_dmul(W,63);
  fu_dmul(W,32);
  fu_dmul(W,36);
  fu_dmul(W,48);
  fu_dmul(W,54);
  return;
}

// Canonical BUILD fact for TRAIN targets: first DADD pair, else first DMUL.
fn fu_canon_build(W:[]u8,t:i32)void {
  let a:i32=0; let done:i32=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a+b==t){ev_teach_in(W,t,45,fu_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  a=0;
  while(a<=9 && done==0){
    let b:i32=0;
    while(b<=9 && done==0){
      if(a*b==t){ev_teach_in(W,t,45,fu_P(a,b)); done=1;}
      b=b+1;
    }
    a=a+1;
  }
  return;
}

fn fu_teach_build(W:[]u8)void {
  fu_canon_build(W,16);
  fu_canon_build(W,18);
  fu_canon_build(W,20);
  fu_canon_build(W,21);
  fu_canon_build(W,24);
  fu_canon_build(W,25);
  fu_canon_build(W,32);
  fu_canon_build(W,36);
  return;
}

fn fu_teach(W:[]u8)void {
  let a:i32=0;
  while(a<=9){
    let b:i32=0;
    while(b<=9){
      let p:i32=fu_P(a,b);
      if(a+b<64){ev_teach_in(W,p,41,a+b);}
      if(a*b<64){ev_teach_in(W,p,42,a*b);}
      b=b+1;
    }
    a=a+1;
  }
  fu_teach_decomp(W);
  fu_teach_build(W);
  return;
}

// ---- mastery: 10 queries, 10/10 required ----
// M1-M6,M10 use ev_query (all are hits; no trial fires).
// M7-M9 are miss probes. They use activate (direct retrieval) rather than
// ev_query because ev_query's miss path runs t2_trial, which permanently
// allocates ~13 nodes per rejected candidate; with 96 gathered paths a
// single non-masked miss exhausts the 1024-node store and never finishes.
// This node-leak-on-reject is reported as an architectural finding.

fn fu_activate(W:[]u8,s:i32,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){return ng(W,n,28);}
    n=n+1;
  }
  return -2;
}

fn fu_mastery(W:[]u8)i32 {
  let ok:i32=0; let r:i32=0; let a:i32=0; let b:i32=0;
  r=ev_query(W,fu_P(2,3),41,5,0);
  emit("FU-M1 "); e64(r); emit("\n"); if(r==5){ok=ok+1;}
  r=ev_query(W,fu_P(4,5),42,20,0);
  emit("FU-M2 "); e64(r); emit("\n"); if(r==20){ok=ok+1;}
  r=ev_query(W,fu_P(7,8),42,56,0);
  emit("FU-M3 "); e64(r); emit("\n"); if(r==56){ok=ok+1;}
  r=ev_query(W,16,43,-2,0);
  emit("FU-M4 "); e64(r); emit("\n");
  if(r>=0){a=r/16; b=r-(a*16); if(a>=0 && a<=9 && b>=0 && b<=9 && a+b==16){ok=ok+1;}}
  r=ev_query(W,21,44,-2,0);
  emit("FU-M5 "); e64(r); emit("\n");
  if(r>=0){a=r/16; b=r-(a*16); if(a>=0 && a<=9 && b>=0 && b<=9 && a*b==21){ok=ok+1;}}
  r=ev_query(W,16,45,-2,0);
  emit("FU-M6 "); e64(r); emit("\n");
  if(r>=0){a=r/16; b=r-(a*16); if(a>=0 && a<=9 && b>=0 && b<=9 && (a+b==16 || a*b==16)){ok=ok+1;}}
  r=fu_activate(W,fu_P(2,3),46);
  emit("FU-M7 "); e64(r); emit("\n"); if(r==-2){ok=ok+1;}
  r=fu_activate(W,fu_P(10,10),41);
  emit("FU-M8 "); e64(r); emit("\n"); if(r==-2){ok=ok+1;}
  r=fu_activate(W,81,43);
  emit("FU-M9 "); e64(r); emit("\n"); if(r==-2){ok=ok+1;}
  r=ev_query(W,fu_P(0,5),42,0,0);
  emit("FU-M10 "); e64(r); emit("\n"); if(r==0){ok=ok+1;}
  emit("FU-MASTERY "); e64(ok); emit("/10\n");
  return ok;
}

// ---- novel construction batteries ----

fn fu_test_targets(out:[]u8)i32 {
  set32(out,0,10); set32(out,4,11); set32(out,8,12); set32(out,12,13);
  set32(out,16,14); set32(out,20,15); set32(out,24,28); set32(out,28,30);
  set32(out,32,42); set32(out,36,45); set32(out,40,63);
  return 11;
}

// Control: standard masked trial. Grammar-blind search.
fn fu_control_battery(W:[]u8)i32 {
  let tg:[]u8=z_alloc(48); let n:i32=fu_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=t2_trial(W,t,45,-2,1,0,0);
    let cl:i32=fu_classify(W,t);
    emit("FU-C "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); fu_tstat(W);
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("FU-C-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// Treatment: grammar-restricted + learner-owned semantic verification.
fn fu_treat_battery(W:[]u8)i32 {
  let tg:[]u8=z_alloc(48); let n:i32=fu_test_targets(tg);
  let i:i32=0; let vc:i32=0;
  while(i<n){
    let t:i32=get32(tg,i*4);
    let ans:i32=fu_trial_build(W,t);
    let cl:i32=fu_classify(W,t);
    emit("FU-T "); e64(t); emit(" ans="); e64(ans); emit(" class="); e64(cl); emit("\n");
    if(cl==1){vc=vc+1;}
    i=i+1;
  }
  emit("FU-T-VALID "); e64(vc); emit("/"); e64(n); emit("\n");
  return vc;
}

// Collision probes: T collides with a taught pair encoding.
fn fu_collide(W:[]u8)void {
  let t:i32=48;
  let ans:i32=t2_trial(W,t,45,-2,1,0,0);
  let cl:i32=fu_classify(W,t);
  emit("FU-X48 ans="); e64(ans); emit(" class="); e64(cl); fu_tstat(W);
  t=54;
  ans=t2_trial(W,t,45,-2,1,0,0);
  cl=fu_classify(W,t);
  emit("FU-X54 ans="); e64(ans); emit(" class="); e64(cl); fu_tstat(W);
  return;
}

// Two-level recursive probe (driver-recursed, TNN decomposition at each
// step). 36=(0+9)*(0+4); 48=(0+6)*(0+8); 30=(0+5)*(0+6).
fn fu_probe2(W:[]u8)i32 {
  let ok:i32=0;
  let p1:i32=ev_query(W,36,44,-2,0);
  let a1:i32=p1/16; let b1:i32=p1-(a1*16);
  let p2:i32=ev_query(W,a1,43,-2,0);
  let p3:i32=ev_query(W,b1,43,-2,0);
  let a2:i32=p2/16; let b2:i32=p2-(a2*16);
  let a3:i32=p3/16; let b3:i32=p3-(a3*16);
  emit("FU-P36 "); e64(p1); emit(" "); e64(p2); emit(" "); e64(p3); emit("\n");
  if(p1>=0 && p2>=0 && p3>=0 && a1*b1==36 && a2+b2==a1 && a3+b3==b1){ok=ok+1; emit("FU-P36 OK\n");}
  else {emit("FU-P36 BAD\n");}
  p1=ev_query(W,48,44,-2,0);
  a1=p1/16; b1=p1-(a1*16);
  p2=ev_query(W,a1,43,-2,0); p3=ev_query(W,b1,43,-2,0);
  a2=p2/16; b2=p2-(a2*16); a3=p3/16; b3=p3-(a3*16);
  emit("FU-P48 "); e64(p1); emit(" "); e64(p2); emit(" "); e64(p3); emit("\n");
  if(p1>=0 && p2>=0 && p3>=0 && a1*b1==48 && a2+b2==a1 && a3+b3==b1){ok=ok+1; emit("FU-P48 OK\n");}
  else {emit("FU-P48 BAD\n");}
  p1=ev_query(W,30,44,-2,0);
  a1=p1/16; b1=p1-(a1*16);
  p2=ev_query(W,a1,43,-2,0); p3=ev_query(W,b1,43,-2,0);
  a2=p2/16; b2=p2-(a2*16); a3=p3/16; b3=p3-(a3*16);
  emit("FU-P30 "); e64(p1); emit(" "); e64(p2); emit(" "); e64(p3); emit("\n");
  if(p1>=0 && p2>=0 && p3>=0 && a1*b1==30 && a2+b2==a1 && a3+b3==b1){ok=ok+1; emit("FU-P30 OK\n");}
  else {emit("FU-P30 BAD\n");}
  emit("FU-PROBE2 "); e64(ok); emit("/3\n");
  return ok;
}

fn main()i32 {
  emit("FU-START\n");
  let W1:[]u8=z_alloc(110656); tnn2_init(W1);
  fu_teach(W1);
  emit("FU-W1-MASTERY\n");
  let m1:i32=fu_mastery(W1);
  emit("FU-W1-CONTROL\n");
  let c1:i32=fu_control_battery(W1);
  fu_collide(W1);
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  fu_teach(W2);
  emit("FU-W2-MASTERY\n");
  let m2:i32=fu_mastery(W2);
  emit("FU-W2-TREAT\n");
  let tv:i32=fu_treat_battery(W2);
  let W3:[]u8=z_alloc(110656); tnn2_init(W3);
  fu_teach(W3);
  emit("FU-W3-PROBE2\n");
  let p2:i32=fu_probe2(W3);
  emit("FU-SUMMARY m1="); e64(m1); emit(" c1="); e64(c1);
  emit(" m2="); e64(m2); emit(" tv="); e64(tv); emit(" p2="); e64(p2); emit("\n");
  emit("FU-DONE\n");
  return 0;
}

// belief_repeated.zag -- Repeated-betrayal farming test.
// H-DECEPT-3. Unfrozen variant. Pure Zag.
// 0 modes, 0 bridges, 0 handlers, 0 semantic cases.
//
// Same learner machinery as belief_trajectory.zag (H-DECEPT-2, commit
// 81c857387) with NO changes: trajectory-weighted instance counting in
// ev_calibrate. Each verification outcome is weighted by the source's
// trajectory at the time: c = consecutive correct outcomes immediately
// preceding it (learner-owned per-source streak), w = claim weight
// (the claim's stake).
//
//   correct: correct += 1; total += 1; streak = c + 1
//   wrong:   p = floor(c * w / (c + w)); total += 1 + p; streak = 0
//
// This wave tests the H-DECEPT-2 stated caveat: repeated betrayal after
// streak rebuild. Source S builds a 20-streak, betrays at w=3, rebuilds
// the 20-streak with cheap w=1 truths, betrays at w=5, rebuilds,
// betrays at w=8, then two more rebuild/betray cycles at w=8 to expose
// convergence toward the cycle fixed point. Controls Q and V are fresh
// single betrayals at w=5 and w=8: identical (c, w), no betrayal
// history, proving each repeat betrayal is punished exactly as a first
// betrayal (no escalation, no pattern recognition).
//
// Output discipline (toolchain lesson 2026-10-02): ONE preallocated
// output buffer, cursor returning emit helpers formatting numbers
// directly into the buffer, a single _zag_raw_syscall(1,1,ptr,len)
// write at the end. No _zag_print anywhere.

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn eq(a:i32,b:i32)i32 { if(a==b){return 1;} return 0; }

// ---- single output buffer, cursor returning emit helpers ----
fn e_str(ob:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn e_i64(ob:[]u8,at:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=-v;}
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){t=t/10;nd=nd+1;}
  let e:i32=at+neg+nd;
  let k:i32=e;
  let x:i64=u;
  while(k>at+neg){k=k-1;ob[k]=((x%10) as u8)+48;x=x/10;}
  if(neg==1){ob[at]=45;}
  return e;
}
fn e_i32(ob:[]u8,at:i32,v:i32)i32 { return e_i64(ob,at,v as i64); }
fn e_nl(ob:[]u8,at:i32)i32 { ob[at]=10; return at+1; }
fn chk(ob:[]u8,at:i32,F:[]u8,ok:i32,msg:[]u8)i32 {
  if(ok==0){
    at=e_str(ob,at,"FAIL ");
    at=e_str(ob,at,msg);
    at=e_nl(ob,at);
    set32(F,0,get32(F,0)+1);
  }
  return at;
}

// ============ state block: 976 i32 cells ============
fn cg(B:[]u8,c:i32)i32 { return get32(B,c*4); }
fn cs(B:[]u8,c:i32,v:i32)void { set32(B,c*4,v); return; }
// header: 0 nev, 1 nsrc, 2 wmax, 3 first_contrary, 4 revision_seq,
// 5 s1, 6 s2, 7 truth, 8 abl_identity, 9 reserved, 10 nid,
// 11 nevicted, 12 ndup, 13 last_contrib, 14 last_penalty
fn EVB()i32 { return 16; }
fn EVN()i32 { return 64; }
fn EVW()i32 { return 7; }   // qid,hyp,w,src,phase,contrib,eid
fn SRB()i32 { return 464; }
fn SRN()i32 { return 64; }
fn SRW()i32 { return 4; }   // correct,total,streak,extid
fn DCB()i32 { return 720; }
fn DCN()i32 { return 32; }
fn DCW()i32 { return 4; }   // src,hyp,phase,count
fn IDB()i32 { return 848; }
fn IDN()i32 { return 128; }
fn NCELL()i32 { return 976; }

fn st_init(B:[]u8,abl_identity:i32)void {
  let i:i32=0;
  while(i<NCELL()){ cs(B,i,0); i=i+1; }
  cs(B,8,abl_identity);
  return;
}

// ---- sources ----
fn src_idx(B:[]u8,ext:i32)i32 {
  let i:i32=0;
  while(i<SRN()){
    let id:i32=cg(B,SRB()+i*SRW()+3);
    if(id==ext+1){ return i; }
    i=i+1;
  }
  i=0;
  while(i<SRN()){
    if(cg(B,SRB()+i*SRW()+3)==0){
      cs(B,SRB()+i*SRW()+3,ext+1);
      cs(B,1,cg(B,1)+1);
      return i;
    }
    i=i+1;
  }
  return -1;
}
fn src_rel(B:[]u8,si:i32)i32 {
  let correct:i32=cg(B,SRB()+si*SRW()+0);
  let total:i32=cg(B,SRB()+si*SRW()+1);
  if(total<2){ return 1000; }
  return 1000*correct/total;
}
fn src_streak(B:[]u8,si:i32)i32 {
  return cg(B,SRB()+si*SRW()+2);
}

// ---- independence discount: k-th claim by (src,hyp) in a phase ----
fn disc_for(B:[]u8,si:i32,hyp:i32,phase:i32)i32 {
  let i:i32=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==si+1 && cg(B,DCB()+i*DCW()+1)==hyp && cg(B,DCB()+i*DCW()+2)==phase){
      let k:i32=cg(B,DCB()+i*DCW()+3);
      cs(B,DCB()+i*DCW()+3,k+1);
      let d:i32=1000; let j:i32=0;
      while(j<k){ d=d/2; j=j+1; }
      return d;
    }
    i=i+1;
  }
  i=0;
  while(i<DCN()){
    if(cg(B,DCB()+i*DCW()+0)==0){
      cs(B,DCB()+i*DCW()+0,si+1);
      cs(B,DCB()+i*DCW()+1,hyp);
      cs(B,DCB()+i*DCW()+2,phase);
      cs(B,DCB()+i*DCW()+3,1);
      return 1000;
    }
    i=i+1;
  }
  return 1000;
}

// ---- event identity register: familiarity without recall ----
fn id_seen(B:[]u8,eid:i32)i32 {
  let i:i32=0;
  while(i<cg(B,10)){
    if(cg(B,IDB()+i)==eid){ return 1; }
    i=i+1;
  }
  return 0;
}
fn id_add(B:[]u8,eid:i32)void {
  let n:i32=cg(B,10);
  if(n<IDN()){ cs(B,IDB()+n,eid); cs(B,10,n+1); }
  return;
}

// ---- evidence record with FIFO eviction under memory pressure ----
fn ev_record(B:[]u8,qid:i32,hyp:i32,w:i32,src:i32,phase:i32,contrib:i32,eid:i32)i32 {
  let n:i32=cg(B,0);
  let slot:i32=n;
  if(n>=EVN()){
    let i:i32=0;
    while(i<EVN()-1){
      let a:i32=EVB()+i*EVW();
      let c:i32=EVB()+(i+1)*EVW();
      let k:i32=0;
      while(k<EVW()){ cs(B,a+k,cg(B,c+k)); k=k+1; }
      i=i+1;
    }
    slot=EVN()-1;
    cs(B,11,cg(B,11)+1);
  }
  let o:i32=EVB()+slot*EVW();
  cs(B,o+0,qid); cs(B,o+1,hyp); cs(B,o+2,w);
  cs(B,o+3,src); cs(B,o+4,phase); cs(B,o+5,contrib); cs(B,o+6,eid);
  if(n<EVN()){ cs(B,0,n+1); }
  return slot+1;
}
fn note_wmax(B:[]u8,contrib:i32)void {
  if(contrib>cg(B,2)){ cs(B,2,contrib); }
  return;
}

// ---- trajectory penalty: surprise weight of a wrong outcome ----
// p = floor(c * w / (c + w)); zero on a zero streak, saturates at w.
// No betrayal-history term: the k-th betrayal costs what the first
// would at identical (c, w).
fn traj_penalty(c:i32,w:i32)i32 {
  if(c<=0){ return 0; }
  if(w<1){ w=1; }
  return c*w/(c+w);
}

// ---- calibration: claim on a verifiable fact; outcome observed ----
fn ev_calibrate(B:[]u8,src:i32,hyp:i32,w:i32,truth:i32,eid:i32)i32 {
  if(cg(B,8)==0){
    if(id_seen(B,eid)==1){ cs(B,12,cg(B,12)+1); return -1; }
    id_add(B,eid);
  }
  let si:i32=src_idx(B,src);
  let r:i32=src_rel(B,si);
  let contrib:i32=w*r;
  let seq:i32=ev_record(B,0,hyp,w,src,0,contrib,eid);
  note_wmax(B,contrib);
  let c:i32=src_streak(B,si);
  if(hyp==truth){
    cs(B,SRB()+si*SRW()+0,cg(B,SRB()+si*SRW()+0)+1);
    cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1);
    cs(B,SRB()+si*SRW()+2,c+1);
  } else {
    let p:i32=traj_penalty(c,w);
    cs(B,SRB()+si*SRW()+1,cg(B,SRB()+si*SRW()+1)+1+p);
    cs(B,SRB()+si*SRW()+2,0);
    cs(B,14,p);
  }
  return seq;
}

// ---- one rebuild/betrayal phase: 20 cheap truths, then one betrayal ----
// Records the penalty in cell 14 so main can cross check repeat vs
// first betrayal penalties (the no-escalation equalities).
fn phase(B:[]u8,ob:[]u8,F:[]u8,at:i32,src:i32,bw:i32,eb:i32,exp_rebuild:i32,exp_p:i32,exp_rel:i32,btag:[]u8,ptag:[]u8,rtag:[]u8)i32 {
  let i:i32=0;
  while(i<20){ ev_calibrate(B,src,1,1,1,eb+i); i=i+1; }
  let si:i32=src_idx(B,src);
  at=e_str(ob,at,"rebuild relS="); at=e_i32(ob,at,src_rel(B,si));
  at=e_str(ob,at," streak="); at=e_i32(ob,at,src_streak(B,si)); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(src_rel(B,si),exp_rebuild),btag);
  at=chk(ob,at,F,eq(src_streak(B,si),20),"K2-rebuild-streak-20");
  let c:i32=src_streak(B,si);
  let p:i32=traj_penalty(c,bw);
  at=e_str(ob,at,"betray w="); at=e_i32(ob,at,bw);
  at=e_str(ob,at," c="); at=e_i32(ob,at,c);
  at=e_str(ob,at," p="); at=e_i32(ob,at,p); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(p,exp_p),ptag);
  ev_calibrate(B,src,1,bw,2,eb+20);
  let re:i32=src_rel(B,si);
  at=e_str(ob,at,"exposure relS="); at=e_i32(ob,at,re); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(re,exp_rel),rtag);
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(16384);
  let at:i32=0;
  let F:[]u8=z_alloc(4);

  // ===== World D3: S repeats betray/rebuild five times =====
  let D:[]u8=z_alloc(NCELL()*4); st_init(D,0);
  at=e_str(ob,at,"D3 S repeated betrayal"); at=e_nl(ob,at);

  // Phase A: betrayal 1 at w=3. p = floor(60/23) = 2. rel = 869.
  at=phase(D,ob,F,at,90,3,7001,1000,2,869,"K2-A-rebuild-1000","K4-betray1-p-2","K3-betray1-rel-869");
  let p1:i32=cg(D,14);
  // Phase B: betrayal 2 at w=5. p = floor(100/25) = 4. rel = 833.
  at=phase(D,ob,F,at,90,5,7101,930,4,833,"K2-B-rebuild-930","K4-betray2-p-4","K3-betray2-rel-833");
  let p2:i32=cg(D,14);
  // Phase C: betrayal 3 at w=8. p = floor(160/28) = 5. rel = 810.
  at=phase(D,ob,F,at,90,8,7201,882,5,810,"K2-C-rebuild-882","K4-betray3-p-5","K3-betray3-rel-810");
  let p3:i32=cg(D,14);
  // Phase D: betrayal 4 at w=8. p = 5. rel = 800.
  at=phase(D,ob,F,at,90,8,7301,851,5,800,"K2-D-rebuild-851","K4-betray4-p-5","K4-betray4-rel-800");
  // Phase E: betrayal 5 at w=8. p = 5. rel = 793.
  at=phase(D,ob,F,at,90,8,7401,833,5,793,"K2-E-rebuild-833","K4-betray5-p-5","K4-betray5-rel-793");

  at=e_str(ob,at,"D3 exposure rels: 869 833 810 800 793"); at=e_nl(ob,at);
  at=e_str(ob,at,"D3 penalties: 2 4 5 5 5"); at=e_nl(ob,at);
  at=e_str(ob,at,"fixed-point (20,8): rel*=769"); at=e_nl(ob,at);
  at=e_str(ob,at,"nevicted="); at=e_i32(ob,at,cg(D,11)); at=e_nl(ob,at);

  // ===== Control Q: fresh source, ONE betrayal at w=5 =====
  let Q:[]u8=z_alloc(NCELL()*4); st_init(Q,0);
  let i:i32=0;
  while(i<20){ ev_calibrate(Q,91,1,1,1,7501+i); i=i+1; }
  let qs:i32=src_idx(Q,91);
  let pq:i32=traj_penalty(src_streak(Q,qs),5);
  ev_calibrate(Q,91,1,5,2,7521);
  let rq:i32=src_rel(Q,qs);
  at=e_str(ob,at,"Q single betrayal w=5 p="); at=e_i32(ob,at,pq);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,rq); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(pq,4),"K5-Q-p-4");
  at=chk(ob,at,F,eq(rq,800),"K5-Q-rel-800");

  // ===== Control V: fresh source, ONE betrayal at w=8 =====
  let V:[]u8=z_alloc(NCELL()*4); st_init(V,0);
  i=0;
  while(i<20){ ev_calibrate(V,92,1,1,1,7601+i); i=i+1; }
  let vs:i32=src_idx(V,92);
  let pv:i32=traj_penalty(src_streak(V,vs),8);
  ev_calibrate(V,92,1,8,2,7621);
  let rv:i32=src_rel(V,vs);
  at=e_str(ob,at,"V single betrayal w=8 p="); at=e_i32(ob,at,pv);
  at=e_str(ob,at," rel="); at=e_i32(ob,at,rv); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(pv,5),"K5-V-p-5");
  at=chk(ob,at,F,eq(rv,769),"K5-V-rel-769");

  // ===== no-escalation equalities: repeat punished as first =====
  at=e_str(ob,at,"no-escalation: p(S#2)=="); at=e_i32(ob,at,p2);
  at=e_str(ob,at," p(Q)=="); at=e_i32(ob,at,pq);
  at=e_str(ob,at," p(S#3)=="); at=e_i32(ob,at,p3);
  at=e_str(ob,at," p(V)=="); at=e_i32(ob,at,pv); at=e_nl(ob,at);
  at=chk(ob,at,F,eq(p2,pq),"K5-no-escalation-S2-Q");
  at=chk(ob,at,F,eq(p3,pv),"K5-no-escalation-S3-V");
  at=chk(ob,at,F,eq(p1,2),"K5-p1-2");

  let fails:i32=get32(F,0);
  if(fails==0){ at=e_str(ob,at,"ALL PASS\n"); }
  else { at=e_str(ob,at,"FAILURES: "); at=e_i32(ob,at,fails); at=e_nl(ob,at); }

  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),at as i64,0,0,0);
  if(fails==0){ return 0; }
  return 1;
}

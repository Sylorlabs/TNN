// learner.zag -- generic intermediate library learner (L3 transfer-adapt).
// Generic machinery + learned state only. No episode data, no hidden
// world rules, no reduction solution in this file.
// Prereg: l3_transfer_adapt/PREREG.md. Pure Zag.
// 0 modes, 0 semantic cases.
//
// State layout (u8 buffer, offsets):
//   0: XN  1: LN  2: YN  3: YT_SET
//   4..243:   X slots, 48 x 5 bytes [id,e0,e1,e2,e3]
//   244..339: label slots, 48 x 2 bytes [id,label]
//   340..343: Y threshold i32
//   344..375: M slot, 32 bytes [n,u8 gen,u8 sup,u8 pad, threshold i32,
//              program 24 bytes (8 instr x 3)]
//   376..407: Mprev slot, 32 bytes (unused here)
//   408..455: Y scalar observations, 24 x 2 bytes [scalar,outcome]
//   456..711: LIB, 8 entries x 32 bytes [program 24, n, gen, origin,
//              parent (255=invented), pop (0 EXTEND,1 TRUNCATE,
//              2 SPECIALIZE, 255=none), n_reuse, pad]
//   712: LIBN (u8)
//   716: construct_calls i32  720: construct_evals i32
//   724: lib_probes i32       728: lib_classifs i32
//   732: adapt_calls i32      736: adapt_evals i32

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn e_str(ob:[]u8,at:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn e_i64(ob:[]u8,at:i32,v:i64)i32 {
  let neg:i32=0;
  let u:i64=v;
  if(v<0){neg=1;u=-v;}
  let nd:i32=1;
  let t:i64=u;
  while(t>=10){t=t/10;nd=nd+1;}
  let e:i32=at+neg+nd;
  let k:i32=e;
  let x:i64=u;
  while(k>at+neg){k=k-1;ob[k]=((x%10) as u8)+48;x=x/10;}
  if(neg==1){ob[at]=45;}
  return e;
}
fn e_i32(ob:[]u8,at:i32,v:i32)i32 { return e_i64(ob,at,v as i64); }
fn e_nl(ob:[]u8,at:i32)i32 { ob[at]=10; return at+1; }
fn chk(ob:[]u8,at:i32,F:[]u8,ok:i32,msg:[]u8)i32 {
  if(ok==0){
    at=e_str(ob,at,"FAIL ");
    at=e_str(ob,at,msg);
    at=e_nl(ob,at);
    set32(F,0,get32(F,0)+1);
  }
  return at;
}
fn eq(a:i32,b:i32)i32 { if(a==b){return 1;} return 0; }

// ---- X: episode recall ----
fn XN()i32 { return 48; }
fn x_teach(st:[]u8,id:i32,e0:i32,e1:i32,e2:i32,e3:i32)void {
  let n:i32=st[0] as i32;
  if(n>=XN()){return;}
  let o:i32=4+n*5;
  st[o]=id as u8; st[o+1]=e0 as u8; st[o+2]=e1 as u8;
  st[o+3]=e2 as u8; st[o+4]=e3 as u8;
  st[0]=(n+1) as u8;
  return;
}
fn x_recall(st:[]u8,id:i32,out:[]u8)i32 {
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=4+i*5;
    if((st[o] as i32)==id){
      out[0]=st[o+1]; out[1]=st[o+2]; out[2]=st[o+3]; out[3]=st[o+4];
      return 1;
    }
    i=i+1;
  }
  return 0;
}

// ---- labels: observed outcomes ----
fn lab_teach(st:[]u8,id:i32,lab:i32)void {
  let n:i32=st[1] as i32;
  if(n>=XN()){return;}
  let o:i32=244+n*2;
  st[o]=id as u8; st[o+1]=lab as u8;
  st[1]=(n+1) as u8;
  return;
}
fn lab_get(st:[]u8,id:i32)i32 {
  let n:i32=st[1] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=244+i*2;
    if((st[o] as i32)==id){return st[o+1] as i32;}
    i=i+1;
  }
  return -1;
}

// ---- Y: threshold decide ----
fn y_teach(st:[]u8,s:i32,oc:i32)void {
  let n:i32=st[2] as i32;
  if(n>=24){return;}
  let o:i32=408+n*2;
  st[o]=s as u8; st[o+1]=oc as u8;
  st[2]=(n+1) as u8;
  return;
}
fn y_fit(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let bt:i32=0;
  let bs:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=0;
    let i:i32=0;
    while(i<n){
      let o:i32=408+i*2;
      let s:i32=st[o] as i32;
      let oc:i32=st[o+1] as i32;
      let p:i32=0;
      if(s>=t){p=1;}
      if(p==oc){c=c+1;}
      i=i+1;
    }
    if(c>bs){bs=c;bt=t;}
    t=t+1;
  }
  set32(st,340,bt);
  st[3]=1;
  return bs;
}
fn y_decide(st:[]u8,s:i32)i32 {
  if((st[3] as i32)==0){return -1;}
  let t:i32=get32(st,340);
  if(s>=t){return 1;}
  return 0;
}

// ---- reduction program executor ----
// ops: 0=CPY 1=ADD 2=SUB 3=MAX 4=MIN. R0..R3 preloaded with readings.
fn p_exec(prog:[]u8,n:i32,e0:i32,e1:i32,e2:i32,e3:i32,rg:[]u8)i32 {
  set32(rg,0,e0); set32(rg,4,e1); set32(rg,8,e2); set32(rg,12,e3);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rd:i32=get32(rg,d*4);
    let rs:i32=get32(rg,s*4);
    if(op==0){set32(rg,d*4,rs);}
    else {
      if(op==1){set32(rg,d*4,rd+rs);}
      else {
        if(op==2){set32(rg,d*4,rd-rs);}
        else {
          if(op==3){
            if(rs>rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          } else {
            if(rs<rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          }
        }
      }
    }
    k=k+1;
  }
  return get32(rg,0);
}
fn p_outs(prog:[]u8,n:i32,st:[]u8,eids:[]u8,ne:i32,rg:[]u8,sq:[]u8,vals:[]u8)void {
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let f:i32=x_recall(st,id,sq);
    let v:i32=-999;
    if(f==1){
      v=p_exec(prog,n,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),rg);
    }
    set32(vals,i*4,v);
    i=i+1;
  }
  return;
}
fn count_correct(vals:[]u8,labs:[]u8,ne:i32,t:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let v:i32=get32(vals,i*4);
    let p:i32=0;
    if(v>=t){p=1;}
    if(p==(labs[i] as i32)){c=c+1;}
    i=i+1;
  }
  return c;
}
fn best_t_of_vals(vals:[]u8,labs:[]u8,ne:i32,out:[]u8)i32 {
  let bt:i32=0;
  let bc:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=count_correct(vals,labs,ne,t);
    if(c>bc){bc=c;bt=t;}
    t=t+1;
  }
  set32(out,0,bt);
  return bc;
}

// ---- construct: greedy program construction from experience ----
// sout i32 cells: [0]=rounds [1]=evals [2]=base0 [3]=w_op [4]=w_d
// [5]=w_s [6]=w_gain [7]=score [8]=t. rwin: 8 rounds x 6 i32 cells
// [op,d,s,gain,score,t] per winning round. Trace lines to ob.
fn construct(st:[]u8,eids:[]u8,labs:[]u8,ne:i32,init:[]u8,initn:i32,rg:[]u8,sq:[]u8,vals:[]u8,mbuf:[]u8,mout:[]u8,sout:[]u8,rwin:[]u8,ob:[]u8,at:i32)i32 {
  set32(st,716,get32(st,716)+1);
  let cur:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<initn*3){cur[k]=init[k];k=k+1;}
  let cn:i32=initn;
  p_outs(cur,cn,st,eids,ne,rg,sq,vals);
  let bto:[]u8=z_alloc(4);
  let bs:i32=best_t_of_vals(vals,labs,ne,bto);
  let bt:i32=get32(bto,0);
  set32(sout,8,bs);
  let round:i32=0;
  let teval:i32=0;
  let wop:i32=-1; let wd:i32=-1; let ws:i32=-1; let wg:i32=0;
  let go:i32=1;
  while(go==1){
    if(cn>=8){go=0;}
    else {
      round=round+1;
      let bg:i32=0;
      let bop:i32=-1;
      let bd:i32=0;
      let bss:i32=0;
      let neval:i32=0;
      let op:i32=0;
      while(op<5){
        let d:i32=0;
        while(d<4){
          let s:i32=0;
          while(s<4){
            let cand:[]u8=z_alloc(24);
            let j:i32=0;
            while(j<cn*3){cand[j]=cur[j];j=j+1;}
            cand[cn*3]=op as u8; cand[cn*3+1]=d as u8; cand[cn*3+2]=s as u8;
            p_outs(cand,cn+1,st,eids,ne,rg,sq,vals);
            let cto:[]u8=z_alloc(4);
            let cs:i32=best_t_of_vals(vals,labs,ne,cto);
            neval=neval+1;
            let gain:i32=cs-bs;
            if(gain>bg){bg=gain;bop=op;bd=d;bss=s;}
            s=s+1;
          }
          d=d+1;
        }
        op=op+1;
      }
      teval=teval+neval;
      set32(st,720,get32(st,720)+neval);
      at=e_str(ob,at,"C-ROUND ");
      at=e_i32(ob,at,round);
      at=e_str(ob,at," base=");
      at=e_i32(ob,at,bs);
      at=e_str(ob,at," eval=");
      at=e_i32(ob,at,neval);
      if(bg>0){
        at=e_str(ob,at," win=");
        at=e_i32(ob,at,bop);
        at=e_str(ob,at,",");
        at=e_i32(ob,at,bd);
        at=e_str(ob,at,",");
        at=e_i32(ob,at,bss);
        at=e_str(ob,at," gain=");
        at=e_i32(ob,at,bg);
        wop=bop; wd=bd; ws=bss; wg=bg;
        cur[cn*3]=bop as u8; cur[cn*3+1]=bd as u8; cur[cn*3+2]=bss as u8;
        cn=cn+1;
        p_outs(cur,cn,st,eids,ne,rg,sq,vals);
        bs=best_t_of_vals(vals,labs,ne,bto);
        bt=get32(bto,0);
        at=e_str(ob,at," score=");
        at=e_i32(ob,at,bs);
        at=e_str(ob,at," t=");
        at=e_i32(ob,at,bt);
        at=e_nl(ob,at);
        let ri:i32=(round-1)*6;
        set32(rwin,ri*4,bop);
        set32(rwin,(ri+1)*4,bd);
        set32(rwin,(ri+2)*4,bss);
        set32(rwin,(ri+3)*4,bg);
        set32(rwin,(ri+4)*4,bs);
        set32(rwin,(ri+5)*4,bt);
      } else {
        at=e_str(ob,at," stop");
        at=e_nl(ob,at);
        go=0;
      }
    }
  }
  k=0;
  while(k<24){mbuf[k]=cur[k];k=k+1;}
  set32(mout,0,cn);
  set32(mout,4,bt);
  set32(mout,8,bs);
  set32(sout,0,round);
  set32(sout,4,teval);
  set32(sout,8,get32(sout,8));
  set32(sout,12,wop);
  set32(sout,16,wd);
  set32(sout,20,ws);
  set32(sout,24,wg);
  set32(sout,28,bs);
  set32(sout,32,bt);
  return at;
}

// ---- M slot bookkeeping ----
fn m_write(st:[]u8,n:i32,gen:i32,t:i32,prog:[]u8)void {
  st[344]=n as u8; st[345]=gen as u8; st[346]=0; st[347]=0;
  set32(st,348,t);
  let k:i32=0;
  while(k<24){st[352+k]=prog[k];k=k+1;}
  return;
}

// ---- intermediate library ----
// entry: 32 bytes [program 24, n, gen, origin, parent, pop, n_reuse, pad]
fn lib_base(i:i32)i32 { return 456+i*32; }
fn lib_store(st:[]u8,origin:i32,parent:i32,pop:i32)void {
  let n:i32=st[712] as i32;
  if(n>=8){return;}
  let o:i32=lib_base(n);
  let k:i32=0;
  while(k<24){st[o+k]=st[352+k];k=k+1;}
  st[o+24]=st[344];
  st[o+25]=st[345];
  st[o+26]=origin as u8;
  st[o+27]=parent as u8;
  st[o+28]=pop as u8;
  st[o+29]=0;
  st[o+30]=0;
  st[o+31]=0;
  st[712]=(n+1) as u8;
  return;
}
fn lib_wipe(st:[]u8)void {
  let k:i32=0;
  while(k<256){st[456+k]=0;k=k+1;}
  st[712]=0;
  return;
}
// res i32 cells: [0]=n_perfect [1]=first_idx [2..9]=scores [10..17]=ts
fn lib_probe(st:[]u8,eids:[]u8,labs:[]u8,ne:i32,rg:[]u8,sq:[]u8,vals:[]u8,ob:[]u8,at:i32,res:[]u8)i32 {
  let n:i32=st[712] as i32;
  let nperf:i32=0;
  let first:i32=-1;
  let i:i32=0;
  while(i<n){
    let o:i32=lib_base(i);
    let prog:[]u8=z_alloc(24);
    let k:i32=0;
    while(k<24){prog[k]=st[o+k];k=k+1;}
    let pn:i32=st[o+24] as i32;
    p_outs(prog,pn,st,eids,ne,rg,sq,vals);
    let to:[]u8=z_alloc(4);
    let sc:i32=best_t_of_vals(vals,labs,ne,to);
    let tt:i32=get32(to,0);
    set32(res,8+i*4,sc);
    set32(res,40+i*4,tt);
    if(sc==ne){
      nperf=nperf+1;
      if(first<0){first=i;}
    }
    set32(st,724,get32(st,724)+1);
    set32(st,728,get32(st,728)+41*ne);
    at=e_str(ob,at,"PROBE lib=");
    at=e_i32(ob,at,i);
    at=e_str(ob,at," origin=");
    at=e_i32(ob,at,(st[o+26] as i32));
    at=e_str(ob,at," score=");
    at=e_i32(ob,at,sc);
    at=e_str(ob,at,"/");
    at=e_i32(ob,at,ne);
    at=e_str(ob,at," t=");
    at=e_i32(ob,at,tt);
    at=e_nl(ob,at);
    i=i+1;
  }
  set32(res,0,nperf);
  set32(res,4,first);
  return at;
}
fn lib_reuse(st:[]u8,idx:i32,t:i32,ob:[]u8,at:i32)i32 {
  let o:i32=lib_base(idx);
  let k:i32=0;
  while(k<24){st[352+k]=st[o+k];k=k+1;}
  st[344]=st[o+24];
  st[345]=st[o+25];
  st[346]=0; st[347]=0;
  set32(st,348,t);
  set32(st,340,t);
  st[3]=1;
  st[o+29]=(st[o+29] as i32)+1;
  at=e_str(ob,at,"REUSE lib=");
  at=e_i32(ob,at,idx);
  at=e_str(ob,at," origin=");
  at=e_i32(ob,at,(st[o+26] as i32));
  at=e_str(ob,at," t=");
  at=e_i32(ob,at,t);
  at=e_str(ob,at," n_reuse=");
  at=e_i32(ob,at,(st[o+29] as i32));
  at=e_nl(ob,at);
  return at;
}

// ---- L2 adaptation operators (generic, pure functions on programs) ----
// EXTEND: append (iop,id,is) to a program of length n. Returns n+1.
fn op_extend_append(pin:[]u8,n:i32,iop:i32,id:i32,is:i32,pout:[]u8)i32 {
  let k:i32=0;
  while(k<n*3){pout[k]=pin[k];k=k+1;}
  pout[n*3]=iop as u8; pout[n*3+1]=id as u8; pout[n*3+2]=is as u8;
  return n+1;
}
// TRUNCATE: drop the last instruction. Returns n-1.
fn op_truncate(pin:[]u8,n:i32,pout:[]u8)i32 {
  let nn:i32=n-1;
  if(nn<0){nn=0;}
  let k:i32=0;
  while(k<nn*3){pout[k]=pin[k];k=k+1;}
  return nn;
}
// SPECIALIZE: replace instruction at position pos with (iop,id,is).
fn op_specialize_replace(pin:[]u8,n:i32,pos:i32,iop:i32,id:i32,is:i32,pout:[]u8)void {
  let k:i32=0;
  while(k<n*3){pout[k]=pin[k];k=k+1;}
  pout[pos*3]=iop as u8; pout[pos*3+1]=id as u8; pout[pos*3+2]=is as u8;
  return;
}
fn op_name(op:i32)[]u8 {
  if(op==0){return "EXTEND";}
  if(op==1){return "TRUNCATE";}
  if(op==2){return "SPECIALIZE";}
  return "NONE";
}
// Evaluate every candidate of (entry, op) on the train set.
// best i32 cells: [0]=score [1]=t [2]=pos [3]=iop [4]=id [5]=is
// [6]=nprog [7]=ncands. pout gets the best program bytes.
// Touches no counters: the caller accounts evals.
fn adapt_eval_one(st:[]u8,entry:i32,op:i32,eids:[]u8,labs:[]u8,ne:i32,rg:[]u8,sq:[]u8,vals:[]u8,best:[]u8,pout:[]u8)void {
  let o:i32=lib_base(entry);
  let prog:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<24){prog[k]=st[o+k];k=k+1;}
  let pn:i32=st[o+24] as i32;
  set32(best,0,-1);
  set32(best,4,-1);
  set32(best,8,-1);
  set32(best,12,-1);
  set32(best,16,-1);
  set32(best,20,-1);
  set32(best,24,0);
  set32(best,28,0);
  let nc:i32=0;
  let consider:[]u8=z_alloc(24);
  if(op==0){
    // EXTEND: 80 appends
    let iop:i32=0;
    while(iop<5){
      let id:i32=0;
      while(id<4){
        let is:i32=0;
        while(is<4){
          let cn:i32=op_extend_append(prog,pn,iop,id,is,consider);
          p_outs(consider,cn,st,eids,ne,rg,sq,vals);
          let cto:[]u8=z_alloc(4);
          let cs:i32=best_t_of_vals(vals,labs,ne,cto);
          let ct:i32=get32(cto,0);
          nc=nc+1;
          if(cs>get32(best,0)){
            set32(best,0,cs); set32(best,4,ct);
            set32(best,8,-1);
            set32(best,12,iop); set32(best,16,id); set32(best,20,is);
            set32(best,24,cn);
            let j:i32=0;
            while(j<24){pout[j]=consider[j];j=j+1;}
          }
          is=is+1;
        }
        id=id+1;
      }
      iop=iop+1;
    }
  } else {
    if(op==1){
      // TRUNCATE: 1 candidate
      let cn2:i32=op_truncate(prog,pn,consider);
      p_outs(consider,cn2,st,eids,ne,rg,sq,vals);
      let tto:[]u8=z_alloc(4);
      let cs2:i32=best_t_of_vals(vals,labs,ne,tto);
      nc=1;
      set32(best,0,cs2); set32(best,4,get32(tto,0));
      set32(best,8,-1);
      set32(best,12,-1); set32(best,16,-1); set32(best,20,-1);
      set32(best,24,cn2);
      let j2:i32=0;
      while(j2<24){pout[j2]=consider[j2];j2=j2+1;}
    } else {
      // SPECIALIZE: n*80 replacements
      let pos:i32=0;
      while(pos<pn){
        let iop2:i32=0;
        while(iop2<5){
          let id2:i32=0;
          while(id2<4){
            let is2:i32=0;
            while(is2<4){
              op_specialize_replace(prog,pn,pos,iop2,id2,is2,consider);
              p_outs(consider,pn,st,eids,ne,rg,sq,vals);
              let sto:[]u8=z_alloc(4);
              let ss:i32=best_t_of_vals(vals,labs,ne,sto);
              let st2:i32=get32(sto,0);
              nc=nc+1;
              if(ss>get32(best,0)){
                set32(best,0,ss); set32(best,4,st2);
                set32(best,8,pos);
                set32(best,12,iop2); set32(best,16,id2); set32(best,20,is2);
                set32(best,24,pn);
                let j3:i32=0;
                while(j3<24){pout[j3]=consider[j3];j3=j3+1;}
              }
              is2=is2+1;
            }
            id2=id2+1;
          }
          iop2=iop2+1;
        }
        pos=pos+1;
      }
    }
  }
  set32(best,28,nc);
  return;
}
// lib_adapt: generic transfer policy.
// 1. exact probe; exactly one perfect -> reuse (code 0).
// 2. else adaptation scan (entries in order; ops EXTEND, TRUNCATE,
//    SPECIALIZE); first (entry,op) with a perfect best -> adopt,
//    store new entry with provenance (code 2).
// 3. else construct fresh, store invention with parent=255 (code 1).
// res i32 cells: [0]=code [1]=entry [2]=n_perfect [3]=op [4]=pos
// [5]=iop [6]=id [7]=is [8]=t [9]=score [10]=adapt_evals
// [12..20]=construct sout (code 1) [21..28]=probe scores
// [29..36]=probe thresholds.
fn lib_adapt(st:[]u8,eids:[]u8,labs:[]u8,ne:i32,origin:i32,rg:[]u8,sq:[]u8,vals:[]u8,ob:[]u8,at:i32,res:[]u8,rwin:[]u8)i32 {
  let pres:[]u8=z_alloc(72);
  at=lib_probe(st,eids,labs,ne,rg,sq,vals,ob,at,pres);
  let nperf:i32=get32(pres,0);
  let first:i32=get32(pres,4);
  set32(res,8,nperf);
  let pi:i32=0;
  while(pi<8){
    set32(res,84+pi*4,get32(pres,8+pi*4));
    set32(res,116+pi*4,get32(pres,40+pi*4));
    pi=pi+1;
  }
  if(nperf==1){
    let tt:i32=get32(pres,40+first*4);
    at=lib_reuse(st,first,tt,ob,at);
    set32(res,0,0);
    set32(res,4,first);
    set32(res,32,tt);
    set32(res,40,0);
    return at;
  }
  set32(st,732,get32(st,732)+1);
  let aev:i32=0;
  let libn:i32=st[712] as i32;
  let e:i32=0;
  while(e<libn){
    let op:i32=0;
    while(op<3){
      let best:[]u8=z_alloc(32);
      let pout:[]u8=z_alloc(24);
      adapt_eval_one(st,e,op,eids,labs,ne,rg,sq,vals,best,pout);
      let nc2:i32=get32(best,28);
      aev=aev+nc2;
      set32(st,736,get32(st,736)+nc2);
      let bsc:i32=get32(best,0);
      if(bsc==ne){
        let bt2:i32=get32(best,4);
        let bpos:i32=get32(best,8);
        let biop:i32=get32(best,12);
        let bid:i32=get32(best,16);
        let bis:i32=get32(best,20);
        let bnp:i32=get32(best,24);
        let gen:i32=st[712] as i32;
        m_write(st,bnp,gen,bt2,pout);
        set32(st,340,bt2);
        st[3]=1;
        lib_store(st,origin,e,op);
        at=e_str(ob,at,"ADAPT entry=");
        at=e_i32(ob,at,e);
        at=e_str(ob,at," op=");
        at=e_str(ob,at,op_name(op));
        at=e_str(ob,at," pos=");
        at=e_i32(ob,at,bpos);
        at=e_str(ob,at," instr=");
        at=e_i32(ob,at,biop);
        at=e_str(ob,at,",");
        at=e_i32(ob,at,bid);
        at=e_str(ob,at,",");
        at=e_i32(ob,at,bis);
        at=e_str(ob,at," score=");
        at=e_i32(ob,at,bsc);
        at=e_str(ob,at,"/");
        at=e_i32(ob,at,ne);
        at=e_str(ob,at," t=");
        at=e_i32(ob,at,bt2);
        at=e_str(ob,at," evals=");
        at=e_i32(ob,at,aev);
        at=e_nl(ob,at);
        at=e_str(ob,at,"CHAIN parent=");
        at=e_i32(ob,at,e);
        at=e_str(ob,at," op=");
        at=e_str(ob,at,op_name(op));
        at=e_str(ob,at," origin=");
        at=e_i32(ob,at,origin);
        at=e_nl(ob,at);
        set32(res,0,2);
        set32(res,4,e);
        set32(res,12,op);
        set32(res,16,bpos);
        set32(res,20,biop);
        set32(res,24,bid);
        set32(res,28,bis);
        set32(res,32,bt2);
        set32(res,36,bsc);
        set32(res,40,aev);
        return at;
      }
      op=op+1;
    }
    e=e+1;
  }
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  let sout:[]u8=z_alloc(36);
  at=construct(st,eids,labs,ne,init,0,rg,sq,vals,mbuf,mout,sout,rwin,ob,at);
  let nn:i32=get32(mout,0);
  let nt:i32=get32(mout,4);
  let gen2:i32=st[712] as i32;
  m_write(st,nn,gen2,nt,mbuf);
  set32(st,340,nt);
  st[3]=1;
  lib_store(st,origin,255,255);
  set32(res,0,1);
  set32(res,4,-1);
  set32(res,40,aev);
  let k:i32=0;
  while(k<9){set32(res,48+k*4,get32(sout,k*4));k=k+1;}
  return at;
}
fn lib_dump(st:[]u8,idx:i32,tag:[]u8,ob:[]u8,at:i32)i32 {
  let o:i32=lib_base(idx);
  at=e_str(ob,at,tag);
  at=e_str(ob,at," n=");
  at=e_i32(ob,at,(st[o+24] as i32));
  at=e_str(ob,at," gen=");
  at=e_i32(ob,at,(st[o+25] as i32));
  at=e_str(ob,at," origin=");
  at=e_i32(ob,at,(st[o+26] as i32));
  at=e_str(ob,at," parent=");
  at=e_i32(ob,at,(st[o+27] as i32));
  at=e_str(ob,at," pop=");
  at=e_str(ob,at,op_name((st[o+28] as i32)));
  at=e_str(ob,at," n_reuse=");
  at=e_i32(ob,at,(st[o+29] as i32));
  at=e_str(ob,at," prog=");
  let k:i32=0;
  while(k<6){
    at=e_i32(ob,at,(st[o+k] as i32));
    if(k<5){at=e_str(ob,at,",");}
    k=k+1;
  }
  at=e_nl(ob,at);
  return at;
}

// ---- decide: X -> M -> Y; -1 = NO_DECISION ----
fn decide(st:[]u8,id:i32,rg:[]u8,sq:[]u8)i32 {
  if(x_recall(st,id,sq)==0){return -1;}
  let mn:i32=st[344] as i32;
  if(mn==0){return -1;}
  if((st[3] as i32)==0){return -1;}
  let mprog:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<24){mprog[k]=st[352+k];k=k+1;}
  let s:i32=p_exec(mprog,mn,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),rg);
  return y_decide(st,s);
}
fn z_score(st:[]u8,eids:[]u8,ne:i32,rg:[]u8,sq:[]u8,ob:[]u8,atp:[]u8,tag:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let tl:i32=lab_get(st,id);
    let ok:i32=0;
    if(dec==tl){ok=1;c=c+1;}
    at=e_str(ob,at,tag);
    at=e_str(ob,at," id=");
    at=e_i32(ob,at,id);
    at=e_str(ob,at," dec=");
    at=e_i32(ob,at,dec);
    at=e_str(ob,at," true=");
    at=e_i32(ob,at,tl);
    at=e_str(ob,at," ok=");
    at=e_i32(ob,at,ok);
    at=e_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}
// driver.zag -- L3 transfer-adapt experiment driver.
// Arms, phases, kill bar evaluation. The driver teaches X/Y, runs the
// learner's lib_adapt (probe/adapt/construct), and evaluates decisions.
// It never invents or adapts the intermediate: all construction and
// adaptation go through learner.zag. Tables match
// l3_transfer_adapt/PREREG.md sections 3 and 4 exactly.
// Prereg: l3_transfer_adapt/PREREG.md. Pure Zag.

// ---- frozen episode tables: 4 digit chars per episode ----
fn tabA_train()[]u8 { return "71522990804812999001881001235541"; }
fn tabA_test()[]u8 { return "6060990033884444"; }
fn labA_train()[]u8 { return "11110000"; }
fn labA_test()[]u8 { return "1010"; }
fn tabC_train()[]u8 { return "50996122407383119704764435882166"; }
fn tabC_test()[]u8 { return "7250981950376422"; }
fn labC_train()[]u8 { return "11110000"; }
fn labC_test()[]u8 { return "1010"; }
fn tabB_train()[]u8 { return "95717591558495909560857075705581"; }
fn tabB_test()[]u8 { return "9580659285704591"; }
fn labB_train()[]u8 { return "11110000"; }
fn labB_test()[]u8 { return "1100"; }

fn d_teach(st:[]u8,tab:[]u8,n:i32,id0:i32,labs:[]u8,ob:[]u8,at:i32,tag:[]u8)i32 {
  let i:i32=0;
  while(i<n){
    let e0:i32=(tab[i*4] as i32)-48;
    let e1:i32=(tab[i*4+1] as i32)-48;
    let e2:i32=(tab[i*4+2] as i32)-48;
    let e3:i32=(tab[i*4+3] as i32)-48;
    let id:i32=id0+i;
    let lb:i32=(labs[i] as i32)-48;
    x_teach(st,id,e0,e1,e2,e3);
    lab_teach(st,id,lb);
    at=e_str(ob,at,tag);
    at=e_str(ob,at," id=");
    at=e_i32(ob,at,id);
    at=e_str(ob,at," seq=");
    at=e_i32(ob,at,e0); at=e_str(ob,at,",");
    at=e_i32(ob,at,e1); at=e_str(ob,at,",");
    at=e_i32(ob,at,e2); at=e_str(ob,at,",");
    at=e_i32(ob,at,e3);
    at=e_str(ob,at," label=");
    at=e_i32(ob,at,lb);
    at=e_nl(ob,at);
    i=i+1;
  }
  return at;
}
fn d_yprior_ac(st:[]u8,ob:[]u8,at:i32)i32 {
  y_teach(st,12,1); y_teach(st,15,1); y_teach(st,11,1);
  y_teach(st,8,0); y_teach(st,5,0); y_teach(st,9,0);
  let bs:i32=y_fit(st);
  at=e_str(ob,at,"Y-PRIOR fit=");
  at=e_i32(ob,at,bs);
  at=e_str(ob,at,"/");
  at=e_i32(ob,at,(st[2] as i32));
  at=e_str(ob,at," t=");
  at=e_i32(ob,at,get32(st,340));
  at=e_nl(ob,at);
  return at;
}
// yres cells: [0]=fit [1]=t
fn d_yprior_b(st:[]u8,ob:[]u8,at:i32,yres:[]u8)i32 {
  y_teach(st,17,1); y_teach(st,18,1); y_teach(st,15,0);
  y_teach(st,14,0); y_teach(st,16,1); y_teach(st,13,0);
  let bs2:i32=y_fit(st);
  set32(yres,0,bs2);
  set32(yres,4,get32(st,340));
  at=e_str(ob,at,"Y-PRIOR fit=");
  at=e_i32(ob,at,bs2);
  at=e_str(ob,at,"/");
  at=e_i32(ob,at,(st[2] as i32));
  at=e_str(ob,at," t=");
  at=e_i32(ob,at,get32(st,340));
  at=e_nl(ob,at);
  return at;
}
fn d_eids(id0:i32,n:i32)[]u8 {
  let e:[]u8=z_alloc(n);
  let i:i32=0;
  while(i<n){e[i]=(id0+i) as u8;i=i+1;}
  return e;
}
fn d_labs(st:[]u8,id0:i32,n:i32)[]u8 {
  let l:[]u8=z_alloc(n);
  let i:i32=0;
  while(i<n){l[i]=lab_get(st,id0+i) as u8;i=i+1;}
  return l;
}
fn origin_name(o:i32)[]u8 {
  if(o==1){return "FORAGE";}
  if(o==2){return "RELAY";}
  return "AEGIS";
}

// ---- unit tests for the pure L2 operator functions ----
fn unit_ops(ob:[]u8,at:i32,F:[]u8)i32 {
  at=e_str(ob,at,"=== UNIT operator tests ===\n");
  let pin:[]u8=z_alloc(24);
  pin[0]=1; pin[1]=0; pin[2]=2;
  let pout:[]u8=z_alloc(24);
  let n1:i32=op_extend_append(pin,1,1,0,3,pout);
  at=chk(ob,at,F,eq(n1,2),"U-extend-n-2");
  at=chk(ob,at,F,eq(pout[0] as i32,1),"U-extend-b0");
  at=chk(ob,at,F,eq(pout[1] as i32,0),"U-extend-b1");
  at=chk(ob,at,F,eq(pout[2] as i32,2),"U-extend-b2");
  at=chk(ob,at,F,eq(pout[3] as i32,1),"U-extend-b3");
  at=chk(ob,at,F,eq(pout[4] as i32,0),"U-extend-b4");
  at=chk(ob,at,F,eq(pout[5] as i32,3),"U-extend-b5");
  let pin2:[]u8=z_alloc(24);
  pin2[0]=1; pin2[1]=0; pin2[2]=2; pin2[3]=1; pin2[4]=0; pin2[5]=3;
  let pout2:[]u8=z_alloc(24);
  let n2:i32=op_truncate(pin2,2,pout2);
  at=chk(ob,at,F,eq(n2,1),"U-truncate-n-1");
  at=chk(ob,at,F,eq(pout2[0] as i32,1),"U-truncate-b0");
  at=chk(ob,at,F,eq(pout2[1] as i32,0),"U-truncate-b1");
  at=chk(ob,at,F,eq(pout2[2] as i32,2),"U-truncate-b2");
  let pout3:[]u8=z_alloc(24);
  op_specialize_replace(pin,1,0,2,0,1,pout3);
  at=chk(ob,at,F,eq(pout3[0] as i32,2),"U-specialize-b0");
  at=chk(ob,at,F,eq(pout3[1] as i32,0),"U-specialize-b1");
  at=chk(ob,at,F,eq(pout3[2] as i32,1),"U-specialize-b2");
  at=e_str(ob,at,"UNIT-OPS done\n");
  return at;
}

// ---- driver-side exhaustive uniqueness audit ----
// Scans entries 0..maxe-1 x ops 0..2 with the learner's own candidate
// generator and asserts exactly one perfect adaptation with the frozen
// identity. Verification only: touches no learner counters.
fn audit_unique(st:[]u8,eids:[]u8,labs:[]u8,ne:i32,maxe:i32,rg:[]u8,sq:[]u8,vals:[]u8,ob:[]u8,at:i32,F:[]u8,ee:i32,eop:i32,epos:i32,eiop:i32,eid:i32,eis:i32,tag:[]u8)i32 {
  at=e_str(ob,at,tag);
  at=e_str(ob,at," uniqueness audit ===\n");
  let cnt:i32=0;
  let fe:i32=-1; let fop:i32=-1; let fpos:i32=-1;
  let fiop:i32=-1; let fid:i32=-1; let fis:i32=-1;
  let e:i32=0;
  while(e<maxe){
    let op:i32=0;
    while(op<3){
      let best:[]u8=z_alloc(32);
      let pout:[]u8=z_alloc(24);
      adapt_eval_one(st,e,op,eids,labs,ne,rg,sq,vals,best,pout);
      if(get32(best,0)==ne){
        cnt=cnt+1;
        if(fe<0){
          fe=e; fop=op; fpos=get32(best,8);
          fiop=get32(best,12); fid=get32(best,16); fis=get32(best,20);
        }
      }
      op=op+1;
    }
    e=e+1;
  }
  at=e_str(ob,at,"AUDIT n_perfect=");
  at=e_i32(ob,at,cnt);
  at=e_str(ob,at," first=(");
  at=e_i32(ob,at,fe); at=e_str(ob,at,",");
  at=e_i32(ob,at,fop); at=e_str(ob,at,",");
  at=e_i32(ob,at,fpos); at=e_str(ob,at,",");
  at=e_i32(ob,at,fiop); at=e_str(ob,at,",");
  at=e_i32(ob,at,fid); at=e_str(ob,at,",");
  at=e_i32(ob,at,fis); at=e_str(ob,at,")\n");
  at=chk(ob,at,F,eq(cnt,1),"AUDIT-exactly-one");
  at=chk(ob,at,F,eq(fe,ee),"AUDIT-entry");
  at=chk(ob,at,F,eq(fop,eop),"AUDIT-op");
  at=chk(ob,at,F,eq(fpos,epos),"AUDIT-pos");
  at=chk(ob,at,F,eq(fiop,eiop),"AUDIT-iop");
  at=chk(ob,at,F,eq(fid,eid),"AUDIT-id");
  at=chk(ob,at,F,eq(fis,eis),"AUDIT-is");
  return at;
}

// ---- phase A: FORAGE, invent ----
fn phaseA(st:[]u8,rg:[]u8,sq:[]u8,vals:[]u8,ob:[]u8,at:i32,F:[]u8)i32 {
  at=e_str(ob,at,"=== PHASE A FORAGE ===\n");
  at=d_yprior_ac(st,ob,at);
  at=chk(ob,at,F,eq(get32(st,340),10),"A-yprior-t-10");
  at=d_teach(st,tabA_train(),8,1,labA_train(),ob,at,"A-TRAIN");
  at=d_teach(st,tabA_test(),4,9,labA_test(),ob,at,"A-TEST");
  let eids:[]u8=d_eids(1,8);
  let labs:[]u8=d_labs(st,1,8);
  let res:[]u8=z_alloc(160);
  let rwin:[]u8=z_alloc(192);
  at=lib_adapt(st,eids,labs,8,1,rg,sq,vals,ob,at,res,rwin);
  at=chk(ob,at,F,eq(get32(res,0),1),"A-adapt-code-1-constructed");
  at=chk(ob,at,F,eq(get32(res,4),-1),"A-adapt-entry-neg");
  at=chk(ob,at,F,eq(get32(res,8),0),"A-nperfect-0");
  at=chk(ob,at,F,eq(get32(res,40),0),"A-adapt-evals-0");
  at=chk(ob,at,F,eq(get32(res,48),2),"A-rounds-2");
  at=chk(ob,at,F,eq(get32(res,52),160),"A-evals-160");
  at=chk(ob,at,F,eq(get32(res,56),5),"A-base0-5");
  at=chk(ob,at,F,eq(get32(res,60),1),"A-win-op-1");
  at=chk(ob,at,F,eq(get32(res,64),0),"A-win-d-0");
  at=chk(ob,at,F,eq(get32(res,68),2),"A-win-s-2");
  at=chk(ob,at,F,eq(get32(res,72),3),"A-win-gain-3");
  at=chk(ob,at,F,eq(get32(res,76),8),"A-score-8");
  at=chk(ob,at,F,eq(get32(res,80),10),"A-t-10");
  at=chk(ob,at,F,eq(get32(rwin,0),1),"A-rwin0-op");
  at=chk(ob,at,F,eq(get32(rwin,4),0),"A-rwin0-d");
  at=chk(ob,at,F,eq(get32(rwin,8),2),"A-rwin0-s");
  at=chk(ob,at,F,eq(get32(rwin,12),3),"A-rwin0-gain");
  at=chk(ob,at,F,eq(get32(rwin,16),8),"A-rwin0-score");
  at=chk(ob,at,F,eq(get32(rwin,20),10),"A-rwin0-t");
  at=lib_dump(st,0,"A-LIB0",ob,at);
  at=chk(ob,at,F,eq(st[456] as i32,1),"A-prog-b0-1");
  at=chk(ob,at,F,eq(st[457] as i32,0),"A-prog-b1-0");
  at=chk(ob,at,F,eq(st[458] as i32,2),"A-prog-b2-2");
  at=chk(ob,at,F,eq(st[480] as i32,1),"A-n-1");
  at=chk(ob,at,F,eq(st[482] as i32,1),"A-origin-FORAGE");
  at=chk(ob,at,F,eq(st[483] as i32,255),"A-parent-255");
  let te:[]u8=d_eids(9,4);
  let atpA:[]u8=z_alloc(4);
  set32(atpA,0,at);
  let sc:i32=z_score(st,te,4,rg,sq,ob,atpA,"A-Z");
  at=get32(atpA,0);
  at=chk(ob,at,F,eq(sc,4),"A-test-4-4");
  at=e_str(ob,at,"A-TEST-SCORE ");
  at=e_i32(ob,at,sc);
  at=e_str(ob,at,"/4\n");
  return at;
}

// ---- phase C: RELAY, exact reuse rejected, SPECIALIZE adaptation ----
fn phaseC(st:[]u8,rg:[]u8,sq:[]u8,vals:[]u8,ob:[]u8,at:i32,F:[]u8)i32 {
  at=e_str(ob,at,"=== PHASE C RELAY ===\n");
  at=d_yprior_ac(st,ob,at);
  at=d_teach(st,tabC_train(),8,201,labC_train(),ob,at,"C-TRAIN");
  at=d_teach(st,tabC_test(),4,209,labC_test(),ob,at,"C-TEST");
  let eids:[]u8=d_eids(201,8);
  let labs:[]u8=d_labs(st,201,8);
  let res:[]u8=z_alloc(160);
  let rwin:[]u8=z_alloc(192);
  let libn0:i32=st[712] as i32;
  let ev0:i32=get32(st,720);
  at=lib_adapt(st,eids,labs,8,2,rg,sq,vals,ob,at,res,rwin);
  let code:i32=get32(res,0);
  at=chk(ob,at,F,eq(code,2),"C-adapt-code-2-adapted");
  at=chk(ob,at,F,eq(get32(res,4),0),"C-adapt-entry-0");
  at=chk(ob,at,F,eq(get32(res,8),0),"C-nperfect-0");
  at=chk(ob,at,F,eq(get32(res,12),2),"C-op-SPECIALIZE");
  at=chk(ob,at,F,eq(get32(res,16),0),"C-pos-0");
  at=chk(ob,at,F,eq(get32(res,20),2),"C-instr-op-2");
  at=chk(ob,at,F,eq(get32(res,24),0),"C-instr-d-0");
  at=chk(ob,at,F,eq(get32(res,28),1),"C-instr-s-1");
  at=chk(ob,at,F,eq(get32(res,32),3),"C-t-3");
  at=chk(ob,at,F,eq(get32(res,36),8),"C-score-8");
  at=chk(ob,at,F,eq(get32(res,40),161),"C-adapt-evals-161");
  at=chk(ob,at,F,eq(get32(res,84),5),"C-probe-entry0-5");
  at=chk(ob,at,F,eq(get32(st,720),ev0),"C-zero-construct-evals");
  at=audit_unique(st,eids,labs,8,libn0,rg,sq,vals,ob,at,F,0,2,0,2,0,1,"C");
  at=lib_dump(st,1,"C-LIB1",ob,at);
  let o1:i32=488;
  at=chk(ob,at,F,eq(st[o1] as i32,2),"C-prog-b0-2");
  at=chk(ob,at,F,eq(st[o1+1] as i32,0),"C-prog-b1-0");
  at=chk(ob,at,F,eq(st[o1+2] as i32,1),"C-prog-b2-1");
  at=chk(ob,at,F,eq(st[o1+24] as i32,1),"C-n-1");
  at=chk(ob,at,F,eq(st[o1+26] as i32,2),"C-origin-RELAY");
  at=chk(ob,at,F,eq(st[o1+27] as i32,0),"C-parent-0");
  at=chk(ob,at,F,eq(st[o1+28] as i32,2),"C-pop-SPECIALIZE");
  let te:[]u8=d_eids(209,4);
  let atpC:[]u8=z_alloc(4);
  set32(atpC,0,at);
  let sc:i32=z_score(st,te,4,rg,sq,ob,atpC,"C-Z");
  at=get32(atpC,0);
  at=chk(ob,at,F,eq(sc,4),"C-test-4-4");
  at=e_str(ob,at,"C-TEST-SCORE ");
  at=e_i32(ob,at,sc);
  at=e_str(ob,at,"/4\n");
  return at;
}

// ---- phase B via adaptation path (transfer arm) ----
fn phaseB_transfer(st:[]u8,rg:[]u8,sq:[]u8,vals:[]u8,ob:[]u8,at:i32,F:[]u8,ev_before:[]u8,abuf:[]u8)i32 {
  at=e_str(ob,at,"=== PHASE B AEGIS adapt-path ===\n");
  let yres:[]u8=z_alloc(8);
  at=d_yprior_b(st,ob,at,yres);
  at=d_teach(st,tabB_train(),8,101,labB_train(),ob,at,"B-TRAIN");
  at=d_teach(st,tabB_test(),4,109,labB_test(),ob,at,"B-TEST");
  let eids:[]u8=d_eids(101,8);
  let labs:[]u8=d_labs(st,101,8);
  let res:[]u8=z_alloc(160);
  let rwin:[]u8=z_alloc(192);
  let libn0:i32=st[712] as i32;
  set32(ev_before,0,get32(st,720));
  at=lib_adapt(st,eids,labs,8,3,rg,sq,vals,ob,at,res,rwin);
  let code:i32=get32(res,0);
  at=chk(ob,at,F,eq(code,2),"B-adapt-code-2-adapted");
  at=chk(ob,at,F,eq(get32(res,4),0),"B-adapt-entry-0");
  at=chk(ob,at,F,eq(get32(res,8),0),"B-nperfect-0");
  at=chk(ob,at,F,eq(get32(res,12),0),"B-op-EXTEND");
  at=chk(ob,at,F,eq(get32(res,16),-1),"B-pos-neg");
  at=chk(ob,at,F,eq(get32(res,20),1),"B-instr-op-1");
  at=chk(ob,at,F,eq(get32(res,24),0),"B-instr-d-0");
  at=chk(ob,at,F,eq(get32(res,28),3),"B-instr-s-3");
  at=chk(ob,at,F,eq(get32(res,32),16),"B-t-16");
  at=chk(ob,at,F,eq(get32(res,36),8),"B-score-8");
  at=chk(ob,at,F,eq(get32(res,40),80),"B-adapt-evals-80");
  set32(abuf,0,get32(res,40));
  at=chk(ob,at,F,eq(get32(res,84),7),"B-probe-entry0-7");
  at=chk(ob,at,F,eq(get32(res,88),5),"B-probe-entry1-5");
  at=chk(ob,at,F,eq(get32(res,116),16),"B-probe-entry0-t-16");
  at=chk(ob,at,F,eq(get32(st,720),get32(ev_before,0)),"B-zero-construct-evals");
  at=audit_unique(st,eids,labs,8,libn0,rg,sq,vals,ob,at,F,0,0,-1,1,0,3,"B");
  at=lib_dump(st,2,"B-LIB2",ob,at);
  let o2:i32=520;
  at=chk(ob,at,F,eq(st[o2] as i32,1),"B-prog-b0-1");
  at=chk(ob,at,F,eq(st[o2+1] as i32,0),"B-prog-b1-0");
  at=chk(ob,at,F,eq(st[o2+2] as i32,2),"B-prog-b2-2");
  at=chk(ob,at,F,eq(st[o2+3] as i32,1),"B-prog-b3-1");
  at=chk(ob,at,F,eq(st[o2+4] as i32,0),"B-prog-b4-0");
  at=chk(ob,at,F,eq(st[o2+5] as i32,3),"B-prog-b5-3");
  at=chk(ob,at,F,eq(st[o2+24] as i32,2),"B-n-2");
  at=chk(ob,at,F,eq(st[o2+26] as i32,3),"B-origin-AEGIS");
  at=chk(ob,at,F,eq(st[o2+27] as i32,0),"B-parent-0");
  at=chk(ob,at,F,eq(st[o2+28] as i32,0),"B-pop-EXTEND");
  at=chk(ob,at,F,eq(st[344] as i32,2),"B-mslot-n-2");
  at=chk(ob,at,F,eq(st[352] as i32,1),"B-mprog-b0-1");
  at=chk(ob,at,F,eq(st[353] as i32,0),"B-mprog-b1-0");
  at=chk(ob,at,F,eq(st[354] as i32,2),"B-mprog-b2-2");
  at=chk(ob,at,F,eq(st[355] as i32,1),"B-mprog-b3-1");
  at=chk(ob,at,F,eq(st[356] as i32,0),"B-mprog-b4-0");
  at=chk(ob,at,F,eq(st[357] as i32,3),"B-mprog-b5-3");
  at=chk(ob,at,F,eq(get32(st,348),16),"B-mslot-t-16");
  at=lib_dump(st,0,"B-LIB0-PROV",ob,at);
  at=e_str(ob,at,"PROV B entry=2 parent=0(");
  at=e_str(ob,at,origin_name(st[456+26] as i32));
  at=e_str(ob,at,") op=EXTEND\n");
  let te:[]u8=d_eids(109,4);
  let atpB:[]u8=z_alloc(4);
  set32(atpB,0,at);
  let sc:i32=z_score(st,te,4,rg,sq,ob,atpB,"B-Z");
  at=get32(atpB,0);
  at=chk(ob,at,F,eq(sc,4),"B-test-4-4");
  at=e_str(ob,at,"B-TEST-SCORE ");
  at=e_i32(ob,at,sc);
  at=e_str(ob,at,"/4\n");
  return at;
}

// ---- phase B via fresh construction (fresh / no-lib arms) ----
fn phaseB_fresh(st:[]u8,rg:[]u8,sq:[]u8,vals:[]u8,ob:[]u8,at:i32,F:[]u8,tag:[]u8,ev_before:[]u8,abuf:[]u8,assert_yp:i32)i32 {
  at=e_str(ob,at,tag);
  at=e_str(ob,at," AEGIS fresh-path ===\n");
  let yres:[]u8=z_alloc(8);
  at=d_yprior_b(st,ob,at,yres);
  if(assert_yp==1){
    at=chk(ob,at,F,eq(get32(yres,0),6),"BF-yprior-fit-6");
    at=chk(ob,at,F,eq(get32(yres,4),16),"BF-yprior-t-16");
  }
  at=d_teach(st,tabB_train(),8,101,labB_train(),ob,at,"B-TRAIN");
  at=d_teach(st,tabB_test(),4,109,labB_test(),ob,at,"B-TEST");
  let eids:[]u8=d_eids(101,8);
  let labs:[]u8=d_labs(st,101,8);
  let res:[]u8=z_alloc(160);
  let rwin:[]u8=z_alloc(192);
  set32(ev_before,0,get32(st,720));
  at=lib_adapt(st,eids,labs,8,3,rg,sq,vals,ob,at,res,rwin);
  let code:i32=get32(res,0);
  at=chk(ob,at,F,eq(code,1),"BF-adapt-code-1-constructed");
  let delta:i32=get32(st,720)-get32(ev_before,0);
  set32(abuf,0,delta);
  at=chk(ob,at,F,eq(delta,240),"BF-evals-delta-240");
  at=chk(ob,at,F,eq(get32(res,48),3),"BF-rounds-3");
  at=chk(ob,at,F,eq(get32(res,52),240),"BF-evals-240");
  at=chk(ob,at,F,eq(get32(rwin,0),1),"BF-rwin0-op-1");
  at=chk(ob,at,F,eq(get32(rwin,4),0),"BF-rwin0-d-0");
  at=chk(ob,at,F,eq(get32(rwin,8),2),"BF-rwin0-s-2");
  at=chk(ob,at,F,eq(get32(rwin,12),2),"BF-rwin0-gain-2");
  at=chk(ob,at,F,eq(get32(rwin,16),7),"BF-rwin0-score-7");
  at=chk(ob,at,F,eq(get32(rwin,20),16),"BF-rwin0-t-16");
  at=chk(ob,at,F,eq(get32(rwin,24),1),"BF-rwin1-op-1");
  at=chk(ob,at,F,eq(get32(rwin,28),0),"BF-rwin1-d-0");
  at=chk(ob,at,F,eq(get32(rwin,32),3),"BF-rwin1-s-3");
  at=chk(ob,at,F,eq(get32(rwin,36),1),"BF-rwin1-gain-1");
  at=chk(ob,at,F,eq(get32(rwin,40),8),"BF-rwin1-score-8");
  at=chk(ob,at,F,eq(get32(rwin,44),16),"BF-rwin1-t-16");
  at=lib_dump(st,0,"BF-LIB0",ob,at);
  at=chk(ob,at,F,eq(st[456] as i32,1),"BF-prog-b0-1");
  at=chk(ob,at,F,eq(st[457] as i32,0),"BF-prog-b1-0");
  at=chk(ob,at,F,eq(st[458] as i32,2),"BF-prog-b2-2");
  at=chk(ob,at,F,eq(st[459] as i32,1),"BF-prog-b3-1");
  at=chk(ob,at,F,eq(st[460] as i32,0),"BF-prog-b4-0");
  at=chk(ob,at,F,eq(st[461] as i32,3),"BF-prog-b5-3");
  at=chk(ob,at,F,eq(st[480] as i32,2),"BF-n-2");
  at=chk(ob,at,F,eq(st[482] as i32,3),"BF-origin-AEGIS");
  at=chk(ob,at,F,eq(st[483] as i32,255),"BF-parent-255");
  let te:[]u8=d_eids(109,4);
  let atpBF:[]u8=z_alloc(4);
  set32(atpBF,0,at);
  let sc:i32=z_score(st,te,4,rg,sq,ob,atpBF,"B-Z");
  at=get32(atpBF,0);
  at=chk(ob,at,F,eq(sc,4),"BF-test-4-4");
  at=e_str(ob,at,"B-TEST-SCORE ");
  at=e_i32(ob,at,sc);
  at=e_str(ob,at,"/4\n");
  return at;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  let F:[]u8=z_alloc(4);
  let rg:[]u8=z_alloc(16);
  let sq:[]u8=z_alloc(4);
  let vals:[]u8=z_alloc(64);
  at=e_str(ob,at,"L3-TRANSFER-ADAPT-START\n");
  at=unit_ops(ob,at,F);

  // ===== ARM-TRANSFER =====
  at=e_str(ob,at,"##### ARM-TRANSFER #####\n");
  let T:[]u8=z_alloc(4096);
  at=phaseA(T,rg,sq,vals,ob,at,F);
  at=phaseC(T,rg,sq,vals,ob,at,F);
  let evb:[]u8=z_alloc(4);
  let abuf:[]u8=z_alloc(8);
  at=phaseB_transfer(T,rg,sq,vals,ob,at,F,evb,abuf);
  let tB_adapt:i32=get32(abuf,0);
  let tB_cdelta:i32=get32(T,720)-get32(evb,0);
  at=e_str(ob,at,"TRANSFER-B adapt_evals=");
  at=e_i32(ob,at,tB_adapt);
  at=e_str(ob,at," construct_delta=");
  at=e_i32(ob,at,tB_cdelta);
  at=e_nl(ob,at);

  // ===== ARM-FRESH =====
  at=e_str(ob,at,"##### ARM-FRESH #####\n");
  let S:[]u8=z_alloc(4096);
  let evf:[]u8=z_alloc(4);
  let fbuf:[]u8=z_alloc(8);
  at=phaseB_fresh(S,rg,sq,vals,ob,at,F,"=== PHASE B",evf,fbuf,1);
  let fB_evals:i32=get32(fbuf,0);
  at=e_str(ob,at,"FRESH-B construct_evals=");
  at=e_i32(ob,at,fB_evals);
  at=e_nl(ob,at);
  at=chk(ob,at,F,eq(tB_adapt,80),"T6-transfer-adapt-80");
  at=chk(ob,at,F,eq(fB_evals,240),"T6-fresh-evals-240");
  let cheaper:i32=0;
  if(tB_adapt<fB_evals){cheaper=1;}
  at=chk(ob,at,F,eq(cheaper,1),"T6-adapt-cheaper");

  // ===== ARM-NO-LIB (causal ablation) =====
  at=e_str(ob,at,"##### ARM-NO-LIB #####\n");
  let N:[]u8=z_alloc(4096);
  at=phaseA(N,rg,sq,vals,ob,at,F);
  at=phaseC(N,rg,sq,vals,ob,at,F);
  lib_wipe(N);
  at=e_str(ob,at,"N-LIB-WIPED libn=");
  at=e_i32(ob,at,(N[712] as i32));
  at=e_nl(ob,at);
  at=chk(ob,at,F,eq(N[712] as i32,0),"T7-lib-wiped");
  let evn:[]u8=z_alloc(4);
  let nbuf:[]u8=z_alloc(8);
  at=phaseB_fresh(N,rg,sq,vals,ob,at,F,"=== PHASE B",evn,nbuf,0);
  let nB_evals:i32=get32(nbuf,0);
  at=chk(ob,at,F,eq(nB_evals,240),"T7-nolib-B-evals-delta-240");

  let fails:i32=get32(F,0);
  if(fails==0){at=e_str(ob,at,"ALL PASS\n");}
  else {at=e_str(ob,at,"FAILURES: ");at=e_i32(ob,at,fails);at=e_nl(ob,at);}
  at=e_str(ob,at,"L3-TRANSFER-ADAPT-END\n");

  _zag_raw_syscall(1,1,(_zag_slice_ptr(ob) as i64),at as i64,0,0,0);
  if(fails==0){return 0;}
  return 1;
}

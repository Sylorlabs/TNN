// xio_core.zag -- Learner-built typed I/O adapters (H-XIO-1, unfrozen).
// Pure Zag. No Python. Safebin PATH.
//
// A typed I/O adapter is a persistent learner-built structure (tag 40)
// that performs function composition over typed MAP outputs. When the
// learner observes a type mismatch, a competent MAP whose output type
// (NODE vs NUMBER) differs from what the chain composer expects, it
// attempts typed composition over ordered MAP pairs with differing
// output types. On verification success it builds an adapter node that
// records (m1, m2, oty1, oty2, rel1, rel2, query-relation, answer) with
// DEP provenance edges, and whose execution is the value-level handoff
// v1 = stage(m1, s), v2 = stage(m2, v1).
//
// No hardcoded type-conversion table. No CHAIN_COUNT template. The type
// labels are computed at runtime by scanning each MAP's own executable
// graph for INC cells (tag 103 of the frozen 4-op ISA). Stage relations
// are read from each MAP's own DEP provenance edges. The paired MAPs
// are chosen by verified trial, never specified by the researcher.

// ---- typed signature: 1 (NUMBER) if the graph contains an INC cell,
// ---- else 0 (NODE). Computed over learner-built white-box state.
fn xio_oty(W:[]u8,m:i32)i32 {
  let cur:i32=ng(W,m,20);
  let steps:i32=0;
  while(cur>=0 && steps<64){
    let tag:i32=ng(W,cur,0);
    if(tag==103){return 1;}
    if(tag==102){cur=ng(W,cur,12);}
    else {cur=seq_nx(W,cur);}
    steps=steps+1;
  }
  return 0;
}
// ---- DEP hygiene (XIO-DEPHYGIENE): tombstone layer.
// ---- xio_tomb_edges marks every type-1 DEP edge sourced at m as dead
// ---- (from=-2). Frozen link_edge seeks from==-1 for free slots, so
// ---- tombstones are never recycled; every from==m reader skips them.
fn xio_tomb_edges(W:[]u8,m:i32)void {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){ es(W,e,0,-2); }
    e=e+1;
  }
  return;
}
// ---- hygiene-aware MAP deletion by relation: tombstone each victim's
// ---- DEP edges, then deactivate (tag -1, live 0).
fn xio_del_map_rh(W:[]u8,r:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==r){
      xio_tomb_edges(W,n);
      ns(W,n,0,-1); ns(W,n,36,0);
    }
    n=n+1;
  }
  return;
}
// ---- 1 iff v is among the first n i32s of out.
fn xio_in_list(out:[]u8,n:i32,v:i32)i32 {
  let k:i32=0;
  while(k<n){
    if(get32(out,k*4)==v){ return 1; }
    k=k+1;
  }
  return 0;
}
// ---- add the targets of type-1 edges sourced at graph cell `cell` to
// ---- out (deduped). Returns the new count.
fn xio_cell_t1(W:[]u8,cell:i32,out:[]u8,n:i32,cap:i32)i32 {
  let e:i32=0;
  while(e<4096 && n<cap){
    if(eg(W,e,4)==1 && eg(W,e,0)==cell){
      let to:i32=eg(W,e,8);
      if(xio_in_list(out,n,to)==0){ set32(out,n*4,to); n=n+1; }
    }
    e=e+1;
  }
  return n;
}
// ---- collect the fact ids referenced by type-1 edges from the cells of
// ---- the executable graph rooted at root (xio_oty walk pattern: guard
// ---- true-branch at slot 12, else SEQ link, max 64 steps). These are the
// ---- MAP's licensing facts as witnessed by its own graph. Returns count.
fn xio_graph_facts(W:[]u8,root:i32,out:[]u8,cap:i32)i32 {
  let n:i32=0;
  let cur:i32=root;
  let steps:i32=0;
  while(cur>=0 && steps<64 && n<cap){
    n=xio_cell_t1(W,cur,out,n,cap);
    let tag:i32=ng(W,cur,0);
    if(tag==102){ cur=ng(W,cur,12); } else { cur=seq_nx(W,cur); }
    steps=steps+1;
  }
  return n;
}
// ---- input relation of a stage, from the MAP's own DEP edges to its
// ---- licensing facts. DEP hygiene, two layers:
// ---- (a) L_LIVE: m must be a live MAP (field36==1, tag==20), else -1.
// ---- (b) L_GRAPH: a DEP edge is followed only if its target fact is
// ---- referenced by m's own executable graph. Stale edges from a deleted
// ---- previous occupant point at the old occupant's facts, which the new
// ---- occupant's graph never references, so id recycling cannot shadow
// ---- the new occupant no matter where edge ids landed. Tombstoned
// ---- edges (from==-2, L_TOMB) never match from==m.
// ---- Graphs that reference no facts (pure INC chains) keep the original
// ---- first-live-fact behavior. -1 if no provenance found.
fn xio_dep_rel(W:[]u8,m:i32)i32 {
  if(m<2 || m>=1024){ return -1; }
  if(ng(W,m,36)!=1 || ng(W,m,0)!=20){ return -1; }
  let gf:[]u8=z_alloc(256);
  let gn:i32=0;
  if(gf.len>=256){ gn=xio_graph_facts(W,ng(W,m,20),gf,64); }
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==m && eg(W,e,4)==1){
      let to:i32=eg(W,e,8);
      let use_graph:i32=0;
      if(gn>0 && xio_in_list(gf,gn,to)==1){ use_graph=1; }
      if(gn==0 || use_graph==1){
        if(to>=2 && to<1024){
          if(ng(W,to,36)==1 && ng(W,to,0)==1){ return ng(W,to,24); }
        }
      }
    }
    e=e+1;
  }
  return -1;
}
// ---- snapshot the verified answers for query relation r: the answers
// ---- recorded by adapters (tag 40, field32==qr, any liveness), which
// ---- were verified against expected at XIO-BUILD time. The snapshot is
// ---- taken before the trial section because an invalidated adapter's
// ---- node id can be recycled by the trial itself, destroying the
// ---- record. Writes up to cap answers into va, returns the count.
fn xio_snap_verified(W:[]u8,r:i32,va:[]u8,cap:i32)i32 {
  let n:i32=0;
  let a:i32=2;
  while(a<1024 && n<cap){
    if(ng(W,a,0)==40 && ng(W,a,32)==r){
      set32(va,n*4,ng(W,a,28)); n=n+1;
    }
    a=a+1;
  }
  return n;
}
// ---- masked-trial contradiction check over a verified-answer snapshot.
// ---- Returns 1 iff verified knowledge exists for the relation (vc>0)
// ---- and the taught answer matches none of the recorded answers.
fn xio_contra_snap(va:[]u8,vc:i32,ans:i32)i32 {
  if(vc==0){ return 0; }
  if(xio_in_list(va,vc,ans)==1){ return 0; }
  return 1;
}
// ---- masked-trial audit: supersede (type-3 self-edge, which frozen
// ---- activate respects) every newly taught (s,r) fact that contradicts
// ---- verified knowledge. The trial's answer is still returned for the
// ---- current query; it is never installed as standing knowledge.
// ---- fb/fc is the before-list of live (s,r) fact ids taken before the
// ---- trial section. Emits XIO-MASKED-REFUSED per refusal (auditable).
fn xio_masked_audit(W:[]u8,s:i32,r:i32,fb:[]u8,fc:i32,va:[]u8,vc:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r){
      if(is_superseded(W,n)==0 && xio_in_list(fb,fc,n)==0){
        let ans:i32=ng(W,n,28);
        if(xio_contra_snap(va,vc,ans)==1){
          let _t:i32=link_edge(W,n,3,n,0);
          emit("XIO-MASKED-REFUSED s="); e64(s);
          emit(" r="); e64(r);
          emit(" ans="); e64(ans);
          emit(" fact="); e64(n); emit("\n");
        }
      }
    }
    n=n+1;
  }
  return;
}
// ---- 1 if any active MAP has a non-chain (NUMBER) output type.
fn xio_has_typed(W:[]u8)i32 {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && xio_oty(W,m)==1){return 1;}
    m=m+1;
  }
  return 0;
}
// ---- re-derive one stage for input x and execute it, masked verify
// ---- (first valid output). Returns the output or -999999.
fn xio_stage_exec(W:[]u8,m:i32,x:i32)i32 {
  let oty:i32=xio_oty(W,m);
  if(oty==0){
    let plen:i32=rb_chain_plen(W,ng(W,m,20));
    if(plen<2){return -999999;}
    let paths:[]u8=z_alloc(4608);
    if(paths.len<4608){return -999999;}
    let np:i32=t2_gather(W,x,paths);
    let p:i32=0;
    while(p<np){
      let base:i32=p*48;
      if(get32(paths,base)==plen){
        let v:[]u8=z_alloc(24); let f:[]u8=z_alloc(16);
        if(v.len>=24 && f.len>=16){
          let j:i32=0;
          while(j<plen){set32(v,j*4,get32(paths,base+4+j*4)); j=j+1;}
          j=0;
          while(j<plen-1){set32(f,j*4,get32(paths,base+24+j*4)); j=j+1;}
          let root:i32=t2_asm_chain(W,v,plen,f);
          if(root>=0){
            let st:[]u8=z_alloc(8);
            if(st.len>=8){
              set32(st,0,0); set32(st,4,0);
              let vv:i32=t2_try_verify(W,root,x,-2,1,st);
              if(vv!=-2 && vv!=-999999){return vv;}
            }
          }
        }
      }
      p=p+1;
    }
    return -999999;
  }
  let rel:i32=xio_dep_rel(W,m);
  if(rel<0){return -999999;}
  let vv2:[]u8=z_alloc(64); let ff2:[]u8=z_alloc(60);
  if(vv2.len<64 || ff2.len<60){return -999999;}
  let len:i32=t2_chain(W,x,rel,vv2,ff2);
  if(len<2){return -999999;}
  let root2:i32=t2_asm_count(W,vv2,len,ff2);
  if(root2<0){return -999999;}
  let st2:[]u8=z_alloc(8);
  if(st2.len<8){return -999999;}
  set32(st2,0,0); set32(st2,4,0);
  let ww:i32=t2_try_verify(W,root2,x,-2,1,st2);
  if(ww!=-2 && ww!=-999999){return ww;}
  return -999999;
}
// ---- stage identity token (A4c repair): (promotion-index << 10) |
// ---- graph-root-id. Field 24 of a MAP node is the frozen promotion
// ---- index (hg(W,24) at promote_graph time); field 20 is the
// ---- executable graph root. Both are written once at promotion and
// ---- never rewritten by the base (alloc_node zeroes them on recycle,
// ---- then promotion writes fresh values). hg(W,24) is a live-edge
// ---- count in [0,4096], root < 1024, so the token fits i32 and is
// ---- always >= 0. A recycled id always yields a new token: the old
// ---- graph cells are never freed, so the new graph takes fresh ids.
fn xio_stage_tok(W:[]u8,m:i32)i32 {
  return ((ng(W,m,24))<<10)|(ng(W,m,20));
}
// ---- recorded token for stage m of adapter a, read from the binding
// ---- edge (adapter -> m, type 1, clk field). -1 if the edge is gone.
fn xio_bind_tok(W:[]u8,a:i32,m:i32)i32 {
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==a && eg(W,e,4)==1 && eg(W,e,8)==m){return eg(W,e,12);}
    e=e+1;
  }
  return -1;
}
// ---- build the persistent adapter node. Layout: 0=tag40, 4=m1,
// ---- 8=m2, 12=oty1, 16=oty2, 20=rel1, 24=rel2, 28=answer,
// ---- 32=query relation. DEP edges adapter -> m1, m2 (provenance).
fn xio_build(W:[]u8,m1:i32,m2:i32,o1:i32,o2:i32,rel1:i32,rel2:i32,qr:i32,ans:i32)i32 {
  let a:i32=alloc_node(W);
  if(a<0){return -1;}
  ns(W,a,0,40);
  ns(W,a,4,m1); ns(W,a,8,m2);
  ns(W,a,12,o1); ns(W,a,16,o2);
  ns(W,a,20,rel1); ns(W,a,24,rel2);
  ns(W,a,28,ans); ns(W,a,32,qr);
  // A4c repair: record the stage generation tokens on the binding
  // edges (clk field), so xio_exec can detect id recycling.
  link_edge(W,a,1,m1,xio_stage_tok(W,m1));
  link_edge(W,a,1,m2,xio_stage_tok(W,m2));
  return a;
}
// ---- execute an adapter: value-level handoff v1 = m1(s),
// ---- v2 = m2(v1). Returns v2 or -999999.
fn xio_exec(W:[]u8,a:i32,s:i32)i32 {
  let m1:i32=ng(W,a,4); let m2:i32=ng(W,a,8);
  if(m1<2 || m2<2){return -999999;}
  if(ng(W,m1,36)!=1 || ng(W,m2,36)!=1){return -999999;}
  if(ng(W,m1,0)!=20 || ng(W,m2,0)!=20){return -999999;}
  // A4c repair: generation-checked stage binding. The recorded token
  // must equal the live stage MAP's token; a mismatch means the id
  // was recycled under the adapter. Invalidate (deactivate + audit),
  // never silently rebind. A missing binding edge also fails closed.
  if(xio_bind_tok(W,a,m1)!=xio_stage_tok(W,m1)){
    emit("XIO-INVALID id="); e64(a); emit(" stage=1\n");
    ns(W,a,36,0); return -999999;
  }
  if(xio_bind_tok(W,a,m2)!=xio_stage_tok(W,m2)){
    emit("XIO-INVALID id="); e64(a); emit(" stage=2\n");
    ns(W,a,36,0); return -999999;
  }
  let v1:i32=xio_stage_exec(W,m1,s);
  if(v1==-999999 || v1==-2){return -999999;}
  let v2:i32=xio_stage_exec(W,m2,v1);
  if(v2==-999999 || v2==-2){return -999999;}
  return v2;
}
// ---- find the adapter serving query relation r. -1 if none.
fn xio_find(W:[]u8,r:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40 && ng(W,n,32)==r){return n;}
    n=n+1;
  }
  return -1;
}
// ---- count active adapters (audit).
fn xio_count(W:[]u8)i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==40){c=c+1;}
    n=n+1;
  }
  return c;
}
// ---- adapter lookup for a query: execute the relation-keyed adapter
// ---- and verify. Emits XIO-REUSE on success. Returns ans or -2.
fn xio_adapt(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  let a:i32=xio_find(W,r);
  if(a<0){return -2;}
  let v:i32=xio_exec(W,a,s);
  if(v==-999999 || v==-2){return -2;}
  if(expected!=-2 && v!=expected){return -2;}
  hs(W,16,0);
  emit("XIO-REUSE id="); e64(a); emit(" ans="); e64(v); emit("\n");
  return v;
}
// ---- typed composition trial: ordered MAP pairs with DIFFERING
// ---- output types only (the mismatch gate). On v2 == expected, build
// ---- the adapter. Emits XIO-BUILD on success. Returns ans or -2.
fn xio_try(W:[]u8,s:i32,r:i32,expected:i32)i32 {
  if(expected==-2){return -2;}
  if(xio_has_typed(W)==0){return -2;}
  let tried:i32=0; let rej:i32=0;
  let m1:i32=2;
  while(m1<1024){
    if(ng(W,m1,36)==1 && ng(W,m1,0)==20){
      let o1:i32=xio_oty(W,m1);
      let m2:i32=2;
      while(m2<1024){
        if(m2!=m1 && ng(W,m2,36)==1 && ng(W,m2,0)==20){
          let o2:i32=xio_oty(W,m2);
          if(o1!=o2){
            tried=tried+1;
            let v1:i32=xio_stage_exec(W,m1,s);
            if(v1!=-999999 && v1!=-2){
              let v2:i32=xio_stage_exec(W,m2,v1);
              if(v2!=-999999 && v2!=-2 && v2==expected){
                let r1:i32=xio_dep_rel(W,m1);
                let r2:i32=xio_dep_rel(W,m2);
                let a:i32=xio_build(W,m1,m2,o1,o2,r1,r2,r,v2);
                if(a<0){return -2;}
                hs(W,16,tried*1024+rej);
                emit("XIO-BUILD id="); e64(a);
                emit(" m1="); e64(m1); emit(" m2="); e64(m2);
                emit(" o1="); e64(o1); emit(" o2="); e64(o2);
                emit(" rel1="); e64(r1); emit(" rel2="); e64(r2);
                emit(" qr="); e64(r); emit(" mid="); e64(v1);
                emit(" ans="); e64(v2); emit("\n");
                return v2;
              }
            }
            rej=rej+1;
          }
        }
        m2=m2+1;
      }
    }
    m1=m1+1;
  }
  return -2;
}
// ---- unified query with the adapter stages. xio_on=1 enables adapter
// ---- lookup and typed composition; xio_on=0 reproduces the C215
// ---- baseline pipeline (ablation). Not a mode: xio_try is attempted
// ---- uniformly on any query where lookup and rebind failed, keyed
// ---- only by learner state, with no task-label routing.
// ---- DEP hygiene: on masked queries, snapshot the live (s,r) facts
// ---- before the trial section and run xio_masked_audit after every
// ---- trial path, so masked-trial teachings that contradict
// ---- adapter-verified knowledge are superseded, never installed.
fn xio_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32,xio_on:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    let _l:i32=link_edge(W,n,6,n,0); ref_prot(W,n);
    log_ev(W,2,s,r,ng(W,n,28),1,0,0); return ng(W,n,28);
  }
  if(xio_on==1){
    let aa:i32=xio_adapt(W,s,r,expected);
    if(aa!=-2){log_ev(W,2,s,r,aa,1,0,0); return aa;}
  }
  let rbs:[]u8=z_alloc(8); set32(rbs,0,0); set32(rbs,4,0);
  let masked:i32=flags&1;
  let fb:[]u8=z_alloc(256); let fc:i32=0;
  let va:[]u8=z_alloc(64); let vc:i32=0;
  if(masked==1){
    vc=xio_snap_verified(W,r,va,16);
    let sn:i32=2;
    while(sn<1024 && fc<64){
      if(ng(W,sn,36)==1 && ng(W,sn,0)==1 && ng(W,sn,20)==s && ng(W,sn,24)==r){
        set32(fb,fc*4,sn); fc=fc+1;
      }
      sn=sn+1;
    }
  }
  let ra:i32=rebind_try(W,s,r,expected,masked,rbs);
  emit("RB-STAT tried="); e64(get32(rbs,0));
  emit(" rejected="); e64(get32(rbs,4)); emit("\n");
  if(ra!=-2){
    if(masked==1){ xio_masked_audit(W,s,r,fb,fc,va,vc); }
    hs(W,16,get32(rbs,0)*1024+get32(rbs,4));
    log_ev(W,2,s,r,ra,1,0,0); return ra;
  }
  if(xio_on==1){
    let xa:i32=xio_try(W,s,r,expected);
    if(xa!=-2){log_ev(W,2,s,r,xa,1,0,0); return xa;}
  }
  let ans:i32=mp_run(W,s,r,expected,flags);
  if(ans!=-2){
    if(masked==1){ xio_masked_audit(W,s,r,fb,fc,va,vc); }
    log_ev(W,2,s,r,ans,1,0,0); return ans;
  }
  let bv:i32=bootstrap_miss(W,s,r);
  if(bv!=-2){
    if(masked==1){ xio_masked_audit(W,s,r,fb,fc,va,vc); }
    log_ev(W,2,s,r,bv,1,0,0); return bv;
  }
  if(masked==1){ xio_masked_audit(W,s,r,fb,fc,va,vc); }
  log_ev(W,2,s,r,-2,0,0,0);
  miss_inquire(W,s,r);
  return -2;
}

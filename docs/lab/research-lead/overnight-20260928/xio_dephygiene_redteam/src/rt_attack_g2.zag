// rt_attack.zag: A1/A2/A3 red-team attacks vs XIO-DEPHYGIENE (C308).
// Pure Zag. Safebin PATH. Constructions frozen in PREREG.md
// (plus transparent amendments). Fixture functions copied verbatim
// from the committed C308 driver (hash-verified, never modified).

// ---- fixture functions (verbatim copies) ----
fn rt_gap(W:[]u8)void {
  let i:i32=0;
  while(i<30){ ev_teach(W,5000+i,60+(i%10),6000+i); i=i+1; }
  return;
}
fn rt_trainX(W:[]u8,xon:i32)void {
  ev_teach(W,11,81,12); ev_teach(W,12,81,13); ev_teach(W,13,81,14);
  let x1:i32=xio_query(W,11,91,14,0,xon);
  emit("X1="); e64(x1); emit("\n");
  ev_teach(W,15,81,16); ev_teach(W,16,81,17); ev_teach(W,17,81,18);
  let x2:i32=xio_query(W,15,91,18,0,xon);
  emit("X2="); e64(x2); emit("\n");
  return;
}
fn rt_trainY(W:[]u8,xon:i32)void {
  ev_teach(W,50,82,51); ev_teach(W,51,82,52); ev_teach(W,52,82,53);
  let y1:i32=xio_query(W,50,92,3,0,xon);
  emit("Y1="); e64(y1); emit("\n");
  ev_teach(W,60,82,61); ev_teach(W,61,82,62); ev_teach(W,62,82,63); ev_teach(W,63,82,64);
  let y2:i32=xio_query(W,60,92,4,0,xon);
  emit("Y2="); e64(y2); emit("\n");
  return;
}
fn rt_zfacts(W:[]u8,b:i32)void {
  ev_teach(W,b,81,b+1); ev_teach(W,b+1,81,b+2); ev_teach(W,b+2,81,b+3);
  ev_teach(W,b+3,82,b+4); ev_teach(W,b+4,82,b+5);
  return;
}
fn rt_del_map_r(W:[]u8,r:i32)void {
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){ns(W,m,0,-1); ns(W,m,36,0);}
    m=m+1;
  }
  return;
}
fn find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}
fn setup_a4c(W:[]u8)i32 {
  rt_trainX(W,1); rt_trainY(W,1); rt_gap(W);
  rt_zfacts(W,31);
  let q1:i32=xio_query(W,31,93,2,0,1);
  emit("S q1="); e64(q1); emit("\n");
  let ad:i32=xio_find(W,93);
  let m1:i32=ng(W,ad,4);
  emit("S ad="); e64(ad); emit(" m1="); e64(m1); emit("\n");
  return m1;
}
fn teach_new(W:[]u8,cf:[]u8)i32 {
  ev_teach(W,36,82,39);
  let c1:i32=ev_teach(W,31,82,41);
  let c2:i32=ev_teach(W,41,82,42);
  let c3:i32=ev_teach(W,42,82,43);
  let c4:i32=ev_teach(W,43,82,44);
  let c5:i32=ev_teach(W,44,82,45);
  let c6:i32=ev_teach(W,45,82,46);
  let c7:i32=ev_teach(W,46,82,47);
  ev_teach(W,7,82,70); ev_teach(W,70,82,71);
  let cv:[]u8=z_alloc(32);
  set32(cv,0,31); set32(cv,4,41); set32(cv,8,42); set32(cv,12,43);
  set32(cv,16,44); set32(cv,20,45); set32(cv,24,46); set32(cv,28,47);
  set32(cf,0,c1); set32(cf,4,c2); set32(cf,8,c3); set32(cf,12,c4);
  set32(cf,16,c5); set32(cf,20,c6); set32(cf,24,c7);
  let croot:i32=t2_asm_count(W,cv,8,cf);
  return croot;
}

// ---- edge-set helpers ----
fn record_t1_from(W:[]u8,m:i32,out:[]u8,cap:i32)i32 {
  let n:i32=0;
  let e:i32=0;
  while(e<4096 && n<cap){
    if(eg(W,e,0)==m && eg(W,e,4)==1){ set32(out,n*4,e); n=n+1; }
    e=e+1;
  }
  return n;
}
fn record_t1_from_new(W:[]u8,m:i32,old:[]u8,nold:i32,out:[]u8,cap:i32)i32 {
  let n:i32=0;
  let e:i32=0;
  while(e<4096 && n<cap){
    if(eg(W,e,0)==m && eg(W,e,4)==1 && xio_in_list(old,nold,e)==0){
      set32(out,n*4,e); n=n+1;
    }
    e=e+1;
  }
  return n;
}
fn min_id(out:[]u8,n:i32)i32 {
  if(n<=0){ return -1; }
  let m:i32=get32(out,0);
  let k:i32=1;
  while(k<n){ let v:i32=get32(out,k*4); if(v<m){ m=v; } k=k+1; }
  return m;
}
fn max_id(out:[]u8,n:i32)i32 {
  if(n<=0){ return -1; }
  let m:i32=get32(out,0);
  let k:i32=1;
  while(k<n){ let v:i32=get32(out,k*4); if(v>m){ m=v; } k=k+1; }
  return m;
}

// ---- tracer: replicates the GUARDED xio_dep_rel's scan predicate
// ---- exactly (A2 guard: gn==0 fallback requires the MAP's own
// ---- promotion relation), emits the followed edge, returns the
// ---- relation. The caller cross-checks the return against the real
// ---- xio_dep_rel.
fn rt_trace_dep(W:[]u8,m:i32,eb:[]u8)i32 {
  set32(eb,0,-1);
  if(m<2 || m>=1024){ emit("TRACE edge=-1\n"); return -1; }
  if(ng(W,m,36)!=1 || ng(W,m,0)!=20){ emit("TRACE edge=-1\n"); return -1; }
  let gf:[]u8=z_alloc(256);
  let gn:i32=0;
  if(gf.len>=256){ gn=xio_graph_facts(W,ng(W,m,20),gf,64); }
  let mr:i32=ng(W,m,4);
  let e:i32=0;
  while(e<4096){
    let ok_e:i32=0;
    if(eg(W,e,0)==m && eg(W,e,4)==1){ ok_e=1; }
    if(ok_e==1){
      let to:i32=eg(W,e,8);
      let in_g:i32=0;
      if(gn>0 && xio_in_list(gf,gn,to)==1){ in_g=1; }
      let gate:i32=0;
      if(gn==0 || in_g==1){ gate=1; }
      let inb:i32=0;
      if(to>=2 && to<1024){ inb=1; }
      if(inb==1 && gn==0 && ng(W,to,24)!=mr){ gate=0; }
      let tgt:i32=0;
      if(inb==1 && ng(W,to,36)==1 && ng(W,to,0)==1){ tgt=1; }
      if(gate==1 && tgt==1){
        set32(eb,0,e);
        emit("TRACE edge="); e64(e); emit(" to="); e64(to);
        emit(" trel="); e64(ng(W,to,24)); emit(" gn="); e64(gn); emit("\n");
        return ng(W,to,24);
      }
    }
    e=e+1;
  }
  emit("TRACE edge=-1\n");
  return -1;
}
// classify followed edge id: 1=STALE 2=CUR 0=other/none
fn classify(fe:i32,stale:[]u8,nstale:i32,cur:[]u8,ncur:i32)i32 {
  if(fe<0){ return 0; }
  if(xio_in_list(stale,nstale,fe)==1){ return 1; }
  if(xio_in_list(cur,ncur,fe)==1){ return 2; }
  return 0;
}

// ---- A1: late promotion + decay + low recycle ----
fn a1()void {
  emit("=== A1 LATE-PROMOTE+DECAY+LOWRECYCLE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<200){ ev_teach(W,7000+i,60+(i%10),8000+i); i=i+1; }
  let m1:i32=setup_a4c(W);
  let stale:[]u8=z_alloc(256);
  let nstale:i32=record_t1_from(W,m1,stale,64);
  let F1:i32=find_fact(W,11,81,12);
  let F2:i32=find_fact(W,12,81,13);
  let F3:i32=find_fact(W,13,81,14);
  emit("A1 m1="); e64(m1); emit(" nstale="); e64(nstale);
  emit(" F1="); e64(F1); emit(" F2="); e64(F2); emit(" F3="); e64(F3); emit("\n");
  emit("A1 stale id range: "); e64(min_id(stale,nstale)); emit(".."); e64(max_id(stale,nstale)); emit("\n");
  ns(W,F1,36,0); ns(W,F2,36,0); ns(W,F3,36,0);
  ev_teach(W,36,82,39);
  let c1:i32=ev_teach(W,31,82,41);
  let c2:i32=ev_teach(W,41,82,42);
  let c3:i32=ev_teach(W,42,82,43);
  let c4:i32=ev_teach(W,43,82,44);
  let c5:i32=ev_teach(W,44,82,45);
  let c6:i32=ev_teach(W,45,82,46);
  let c7:i32=ev_teach(W,46,82,47);
  ev_teach(W,7,82,70); ev_teach(W,70,82,71);
  let r1:i32=find_fact(W,36,82,39);
  let r2:i32=find_fact(W,31,82,41);
  let r3:i32=find_fact(W,41,82,42);
  emit("A1 recycled: "); e64(r1); emit(" "); e64(r2); emit(" "); e64(r3);
  emit(" expect "); e64(F1); emit(" "); e64(F2); emit(" "); e64(F3); emit("\n");
  if(r1!=F1 || r2!=F2 || r3!=F3){ emit("A1 VOID recycle layout\n"); return; }
  let cv:[]u8=z_alloc(32);
  set32(cv,0,31); set32(cv,4,41); set32(cv,8,42); set32(cv,12,43);
  set32(cv,16,44); set32(cv,20,45); set32(cv,24,46); set32(cv,28,47);
  let cf:[]u8=z_alloc(28);
  set32(cf,0,c1); set32(cf,4,c2); set32(cf,8,c3); set32(cf,12,c4);
  set32(cf,16,c5); set32(cf,20,c6); set32(cf,24,c7);
  let croot:i32=t2_asm_count(W,cv,8,cf);
  let d:i32=0;
  while(d<20){ decay(W); d=d+1; }
  rt_del_map_r(W,91);
  let nm:i32=promote_graph(W,croot,31,82,7,cf,7);
  emit("A1 nm="); e64(nm); emit("\n");
  if(nm!=m1){ emit("A1 VOID nm!=m1\n"); return; }
  let cur:[]u8=z_alloc(256);
  let ncur:i32=record_t1_from_new(W,nm,stale,nstale,cur,64);
  emit("A1 ncur="); e64(ncur);
  emit(" cur id range: "); e64(min_id(cur,ncur)); emit(".."); e64(max_id(cur,ncur)); emit("\n");
  let eb:[]u8=z_alloc(4);
  let tr:i32=rt_trace_dep(W,nm,eb);
  let dr:i32=xio_dep_rel(W,nm);
  emit("A1 trace_rel="); e64(tr); emit(" real_rel="); e64(dr); emit("\n");
  if(tr!=dr){ emit("A1 VOID tracer mismatch\n"); return; }
  let fe:i32=get32(eb,0);
  let cls:i32=classify(fe,stale,nstale,cur,ncur);
  emit("A1 followed edge="); e64(fe); emit(" class="); e64(cls); emit(" (1=STALE 2=CUR)\n");
  if(cls==1 || dr!=82){ emit("A1 VERDICT ATTACK-SUCCEEDED\n"); }
  else { emit("A1 VERDICT ATTACK-FAILED\n"); }
  return;
}

// ---- A2: fact-less fallback boundary ----
fn a2()void {
  emit("=== A2 FACTLESS-FALLBACK ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let F1:i32=ev_teach(W,11,81,12);
  let F2:i32=ev_teach(W,12,81,13);
  let F3:i32=ev_teach(W,13,81,14);
  let cv:[]u8=z_alloc(16);
  set32(cv,0,11); set32(cv,4,12); set32(cv,8,13); set32(cv,12,14);
  let ff:[]u8=z_alloc(12);
  set32(ff,0,F1); set32(ff,4,F2); set32(ff,8,F3);
  let chroot:i32=t2_asm_chain(W,cv,4,ff);
  let X:i32=promote_graph(W,chroot,11,91,14,ff,3);
  emit("A2 old chain MAP X="); e64(X); emit("\n");
  let sv:[]u8=z_alloc(8);
  set32(sv,0,30); set32(sv,4,40);
  let sumroot:i32=t2_asm_sum(W,sv,2);
  emit("A2 sumroot="); e64(sumroot); emit(" (expect >=0)\n");
  if(sumroot<0){ emit("A2 VOID sum asm\n"); return; }
  let G1:i32=ev_teach(W,50,82,30);
  let G2:i32=ev_teach(W,50,82,40);
  rt_del_map_r(W,91);
  let sf:[]u8=z_alloc(8);
  set32(sf,0,G1); set32(sf,4,G2);
  let nm:i32=promote_graph(W,sumroot,50,82,70,sf,2);
  emit("A2 nm="); e64(nm); emit(" (expect X)\n");
  if(nm!=X){ emit("A2 VOID nm!=X\n"); return; }
  let stale:[]u8=z_alloc(256);
  let nstale:i32=0;
  let cur:[]u8=z_alloc(256);
  let ncur:i32=0;
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)==X && eg(W,e,4)==1){
      let to:i32=eg(W,e,8);
      if(to==F1 || to==F2 || to==F3){ set32(stale,nstale*4,e); nstale=nstale+1; }
      else { set32(cur,ncur*4,e); ncur=ncur+1; }
    }
    e=e+1;
  }
  emit("A2 nstale="); e64(nstale); emit(" ncur="); e64(ncur); emit("\n");
  let eb:[]u8=z_alloc(4);
  let tr:i32=rt_trace_dep(W,X,eb);
  let dr:i32=xio_dep_rel(W,X);
  emit("A2 trace_rel="); e64(tr); emit(" real_rel="); e64(dr); emit("\n");
  if(tr!=dr){ emit("A2 VOID tracer mismatch\n"); return; }
  let fe:i32=get32(eb,0);
  let cls:i32=classify(fe,stale,nstale,cur,ncur);
  emit("A2 followed edge="); e64(fe); emit(" class="); e64(cls); emit(" (1=STALE 2=CUR)\n");
  if(dr==81){ emit("A2 VERDICT ATTACK-SUCCEEDED\n"); }
  else { emit("A2 VERDICT ATTACK-FAILED\n"); }
  return;
}

// ---- A3: adversarial id reuse, live-but-wrong target ----
fn a3_world(W:[]u8,hygiene:i32)i32 {
  let m1:i32=setup_a4c(W);
  let stale:[]u8=z_alloc(256);
  let nstale:i32=record_t1_from(W,m1,stale,64);
  let F1:i32=find_fact(W,11,81,12);
  emit("A3 m1="); e64(m1); emit(" nstale="); e64(nstale); emit(" F1="); e64(F1); emit("\n");
  if(m1!=27){ emit("A3 VOID m1!=27\n"); return -1; }
  ns(W,F1,36,0);
  let wf:i32=ev_teach(W,99,94,100);
  emit("A3 wrong fact id="); e64(wf); emit(" (expect F1="); e64(F1); emit(")\n");
  if(wf!=F1){ emit("A3 VOID wrong-fact recycle\n"); return -1; }
  let c1:i32=ev_teach(W,31,82,41);
  let c2:i32=ev_teach(W,41,82,42);
  let c3:i32=ev_teach(W,42,82,43);
  let c4:i32=ev_teach(W,43,82,44);
  let c5:i32=ev_teach(W,44,82,45);
  let c6:i32=ev_teach(W,45,82,46);
  let cv:[]u8=z_alloc(32);
  set32(cv,0,31); set32(cv,4,41); set32(cv,8,42); set32(cv,12,43);
  set32(cv,16,44); set32(cv,20,45); set32(cv,24,46); set32(cv,28,99);
  let cf:[]u8=z_alloc(28);
  set32(cf,0,c1); set32(cf,4,c2); set32(cf,8,c3); set32(cf,12,c4);
  set32(cf,16,c5); set32(cf,20,c6); set32(cf,24,F1);
  let croot:i32=t2_asm_count(W,cv,8,cf);
  rt_del_map_r(W,91);
  if(hygiene==1){ xio_tomb_edges(W,m1); emit("A3 control: tombstoned\n"); }
  let nm:i32=promote_graph(W,croot,31,82,7,cf,7);
  emit("A3 nm="); e64(nm); emit("\n");
  if(nm!=m1){ emit("A3 VOID nm!=m1\n"); return -1; }
  let cur:[]u8=z_alloc(256);
  let ncur:i32=record_t1_from_new(W,nm,stale,nstale,cur,64);
  emit("A3 ncur="); e64(ncur); emit("\n");
  let eb:[]u8=z_alloc(4);
  let tr:i32=rt_trace_dep(W,nm,eb);
  let dr:i32=xio_dep_rel(W,nm);
  emit("A3 trace_rel="); e64(tr); emit(" real_rel="); e64(dr); emit("\n");
  if(tr!=dr){ emit("A3 VOID tracer mismatch\n"); return -1; }
  let fe:i32=get32(eb,0);
  let cls:i32=classify(fe,stale,nstale,cur,ncur);
  emit("A3 followed edge="); e64(fe); emit(" class="); e64(cls); emit(" (1=STALE 2=CUR)\n");
  if(hygiene==0){
    if(cls==1 && dr!=82){ emit("A3 VERDICT ATTACK-SUCCEEDED\n"); }
    else { emit("A3 VERDICT ATTACK-FAILED\n"); }
  } else {
    if(dr==82){ emit("A3-CONTROL PASS (tombstone -> 82)\n"); }
    else { emit("A3-CONTROL FAIL\n"); }
  }
  return dr;
}
fn a3()void {
  emit("=== A3 ADVERSARIAL-ID-REUSE ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let r:i32=a3_world(W,0);
  emit("A3 done r="); e64(r); emit("\n");
  return;
}
fn a3ctl()void {
  emit("=== A3 CONTROL (perfect hygiene) ===\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let r:i32=a3_world(W,1);
  emit("A3CTL done r="); e64(r); emit("\n");
  return;
}

fn ev_query(W:[]u8,s:i32,r:i32,expected:i32,flags:i32)i32 {
  return xio_query(W,s,r,expected,flags,1);
}
fn main()i32 {
  emit("RT-START\n");
  a1(); a2(); a3(); a3ctl();
  emit("RT-END\n");
  return 0;
}

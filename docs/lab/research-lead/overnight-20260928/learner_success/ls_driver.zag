// ===== LEARNER-OWNED SUCCESS CRITERIA DRIVER (Micah Q8) =====
// Can TNN generate predictions BEFORE outcomes and use prediction error
// to judge structures? Stronger than: environment supplies expected answer
// -> search until something matches.
//
// Battery 1: score tracks reliability (useful vs merely stored).
// Battery 2: abandonment (world change; cycles until switch).
// Battery 3: divergence (researcher-success vs learner-success).
// Battery 4: retention (high-score structures survive pressure).

fn rep(p:[]u8,name:[]u8,v:i32)void {
  emit(p); emit(" "); emit(name); emit("="); e64(v); emit("\n"); return;
}

fn find_fact(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){return n;}
    n=n+1;
  }
  return -1;
}

fn fact_score(W:[]u8,s:i32,r:i32,o:i32)i32 {
  let n:i32=find_fact(W,s,r,o);
  if(n<0){return -999999;}
  return ng(W,n,8);
}

fn count_pred(W:[]u8) i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31){c=c+1;}
    n=n+1;
  }
  return c;
}

fn count_resolved(W:[]u8) i32 {
  let c:i32=0; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==1){c=c+1;}
    n=n+1;
  }
  return c;
}

// ---- Battery 1: reliability tracking ----
fn bat1()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<5){
    ev_teach(W,6000+i,50,100+i);
    ev_teach(W,6010+i,50,100+i);
    ev_teach(W,6010+i,50,200+i);
    i=i+1;
  }
  let cyc:i32=0;
  let acc_rel:i32=0; let acc_unr:i32=0; let tot:i32=0;
  while(cyc<20){
    i=0;
    while(i<5){
      let p1:i32=ev_predict(W,6000+i,50);
      let o1:i32=100+i;
      if(p1==o1){acc_rel=acc_rel+1;}
      ev_observe(W,6000+i,50,o1);
      let p2:i32=ev_predict(W,6010+i,50);
      let o2:i32=100+i;
      if(cyc%10>=7){o2=200+i;}
      if(p2==o2){acc_unr=acc_unr+1;}
      ev_observe(W,6010+i,50,o2);
      tot=tot+1;
      i=i+1;
    }
    cyc=cyc+1;
  }
  rep("B1","acc_rel",acc_rel); rep("B1","acc_unr",acc_unr); rep("B1","tot",tot);
  rep("B1","pred_nodes",count_pred(W)); rep("B1","resolved",count_resolved(W));
  i=0;
  while(i<5){
    rep("B1","rel_score",fact_score(W,6000+i,50,100+i));
    i=i+1;
  }
  i=0;
  while(i<5){
    rep("B1","unr_true_score",fact_score(W,6010+i,50,100+i));
    rep("B1","unr_false_score",fact_score(W,6010+i,50,200+i));
    i=i+1;
  }
  return 1;
}

// ---- Battery 2: abandonment after world change ----
fn bat2()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,6100,50,111);
  let c:i32=0;
  while(c<5){
    let p:i32=ev_predict(W,6100,50);
    ev_observe(W,6100,50,111);
    c=c+1;
  }
  rep("B2","scoreA_pre",fact_score(W,6100,50,111));
  ev_teach(W,6100,50,222);
  let switch_at:i32=-1; let k:i32=0;
  while(k<15){
    let p:i32=ev_predict(W,6100,50);
    if(p==222 && switch_at<0){switch_at=k;}
    ev_observe(W,6100,50,222);
    k=k+1;
  }
  rep("B2","switch_at",switch_at);
  rep("B2","scoreA_post",fact_score(W,6100,50,111));
  rep("B2","scoreB_post",fact_score(W,6100,50,222));
  return 1;
}

// ---- Battery 3: divergence ----
// 3a: plain taught FACT, never trial-verified, 10 correct predictions.
// 3b: MAP promoted via trial (researcher success); kill shadow FACT so MAP
//     is the predictor; then 1 wrong prediction -> negative learner score.
fn bat3()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  // 3a
  ev_teach(W,6200,50,321);
  let c:i32=0;
  while(c<10){
    let p:i32=ev_predict(W,6200,50);
    ev_observe(W,6200,50,321);
    c=c+1;
  }
  rep("B3","fact3a_score",fact_score(W,6200,50,321));
  // 3b: chain 7001->7002->7003->7004, trial promotes MAP
  ev_teach(W,7001,51,7002); ev_teach(W,7002,51,7003); ev_teach(W,7003,51,7004);
  let ans:i32=ev_query(W,7001,50,7004,0);
  rep("B3","trial_ans",ans);
  let m:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==50){m=n;}
    n=n+1;
  }
  rep("B3","map_found",m);
  if(m>=0){
    // kill shadow FACT so MAP is the prediction source
    let sf:i32=find_fact(W,7001,50,7004);
    rep("B3","shadow_fact",sf);
    if(sf>=0){ ns(W,sf,36,0); }
    rep("B3","map_score_pre",ng(W,m,12));
    let p:i32=ev_predict(W,7001,50);
    rep("B3","map_pred",p);
    ev_observe(W,7001,50,5555);
    rep("B3","map_score_post",ng(W,m,12));
    rep("B3","map_trials",ng(W,m,16));
  }
  return 1;
}

// ---- Battery 4: retention under pressure ----
fn bat4()i32 {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<10){
    ev_teach(W,6300+i,50,400+i);
    i=i+1;
  }
  // score up 0..4 (5 correct predictions each), leave 5..9 at 0
  let c:i32=0;
  while(c<5){
    i=0;
    while(i<5){
      let p:i32=ev_predict(W,6300+i,50);
      ev_observe(W,6300+i,50,400+i);
      i=i+1;
    }
    c=c+1;
  }
  i=0;
  while(i<5){ rep("B4","hi_score",fact_score(W,6300+i,50,400+i)); i=i+1; }
  // pressure: 1100 filler teaches to force evictions (exceeds 1024)
  let f:i32=0;
  while(f<1100){
    ev_teach(W,9000+f,60,f);
    f=f+1;
  }
  let hi_alive:i32=0; let lo_alive:i32=0;
  i=0;
  while(i<5){
    if(find_fact(W,6300+i,50,400+i)>=0){hi_alive=hi_alive+1;}
    i=i+1;
  }
  i=5;
  while(i<10){
    if(find_fact(W,6300+i,50,400+i)>=0){lo_alive=lo_alive+1;}
    i=i+1;
  }
  rep("B4","hi_alive",hi_alive); rep("B4","lo_alive",lo_alive);
  rep("B4","live_nodes",hg(W,20));
  return 1;
}

fn main()i32 {
  emit("BAT1\n"); bat1();
  emit("BAT2\n"); bat2();
  emit("BAT3\n"); bat3();
  emit("BAT4\n"); bat4();
  emit("DONE\n");
  return 0;
}

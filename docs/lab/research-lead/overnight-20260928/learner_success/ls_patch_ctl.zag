// ============ Learner-owned success criteria (Micah Q8) ============
// PRED node (tag 31): a recorded prediction awaiting outcome resolution.
//   f4: resolved (0=pending, 1=resolved)
//   f8: error (0=correct, 1=wrong; valid after resolve)
//   f12: struct_id (source FACT or MAP node)
//   f16: struct_kind (1=FACT via activate, 20=MAP via execute)
//   f20: s, f24: r, f28: predicted p, f32: tick
// Usefulness (learner state, updated ONLY from prediction error):
//   FACT (tag 1) f8: pred_score (signed net; init 0; f8 unused on tag-1)
//   MAP (tag 20) f12: pred_score (signed net; init 0; was -1 in base)
//   MAP (tag 20) f16: pred_trials (count; init 0; was -1 in base)
// Researcher scaffold (honest): PRED layout, +1/-1 rule, hook points,
//   score-guided selection, eviction protection threshold (>0).
// Learner-owned: the score VALUES (from experience stream), which structures
//   get preferred, whether criteria diverge. No per-case success rules.

fn T_PRED()i32 { return 31; }
fn score_on()i32 { return 0; }

fn pred_record(W:[]u8,s:i32,r:i32,p:i32,sid:i32,kind:i32)i32 {
  let n:i32=alloc_node(W); if(n<0){return -1;}
  ns(W,n,0,31);
  ns(W,n,4,0); ns(W,n,8,0); ns(W,n,12,sid); ns(W,n,16,kind);
  write_node(W,n,s,r,p,hg(W,0));
  return n;
}

// Score-guided prediction BEFORE outcome is known.
// Treatment: among matching FACTs pick highest pred_score (f8), tie by bid.
// Control (score_on=0): highest bid only (existing recency/bid behavior).
// Then MAP execution fallback (relation-matched, first executable wins).
// Returns predicted value, or -999999 if no basis.
fn ev_predict(W:[]u8,s:i32,r:i32)i32 {
  let best:i32=-1; let bs:i32=-999999; let bb:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && is_superseded(W,n)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let sc:i32=0;
        if(score_on()==1){ sc=ng(W,n,8); }
        let b:i32=bid(W,n);
        if(sc>bs || (sc==bs && b>bb)){ bs=sc; bb=b; best=n; }
      }
    }
    n=n+1;
  }
  if(best>=0){
    let p:i32=ng(W,best,28);
    pred_record(W,s,r,p,best,1);
    return p;
  }
  let m:i32=2;
  while(m<1024){
    if(ng(W,m,36)==1 && ng(W,m,0)==20 && ng(W,m,4)==r){
      let root:i32=ng(W,m,20);
      let v:i32=t2_exec(W,root,s);
      if(v!=-999999){
        if(ng(W,m,12)==-1){ ns(W,m,12,0); ns(W,m,16,0); }
        pred_record(W,s,r,v,m,20);
        return v;
      }
    }
    m=m+1;
  }
  return -999999;
}

// Resolve pending predictions against revealed outcome o.
// Treatment: source structure pred_score +1 if correct, -1 if wrong.
fn pred_resolve(W:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==31 && ng(W,n,4)==0){
      if(ng(W,n,20)==s && ng(W,n,24)==r){
        let err:i32=0;
        if(ng(W,n,28)!=o){ err=1; }
        ns(W,n,4,1); ns(W,n,8,err);
        if(score_on()==1){
          let sid:i32=ng(W,n,12); let kind:i32=ng(W,n,16);
          if(sid>=2 && ng(W,sid,36)==1){
            let d:i32=1; if(err==1){ d=-1; }
            if(kind==1){ ns(W,sid,8,ng(W,sid,8)+d); }
            else { if(kind==20){
              ns(W,sid,12,ng(W,sid,12)+d);
              ns(W,sid,16,ng(W,sid,16)+1);
            }}
          }
        }
      }
    }
    n=n+1;
  }
  return;
}

// ev_observe with prediction resolution appended (otherwise verbatim).
fn ev_observe(W:[]u8,s:i32,r:i32,o:i32)i32 {
  hs(W,0,hg(W,0)+1); decay(W); ctx_push(W,s);
  let n:i32=activate(W,s,r);
  if(n>=0){
    if(ng(W,n,28)==o){
      link_edge(W,n,7,n,0); ref_prot(W,n);
      log_ev(W,4,s,r,o,1,0,0);
      pred_resolve(W,s,r,o);
      return 1;
    }
    link_edge(W,n,3,n,0);
    revise_on_contradict(W,n,o);
    let h2:i32=alloc_raw(W);
    if(h2>=0){
      ns(W,h2,0,3);
      write_node(W,h2,ng(W,n,20),ng(W,n,24),ng(W,n,28),hg(W,0));
      link_edge(W,h2,5,n,0);
    }
    let nn:i32=ev_teach_in(W,s,r,o);
    if(nn>=0){link_edge(W,nn,4,n,0);}
    log_ev(W,4,s,r,o,0,0,0);
    pred_resolve(W,s,r,o);
    return 0;
  }
  ev_teach_in(W,s,r,o); log_ev(W,4,s,r,o,1,0,0);
  pred_resolve(W,s,r,o);
  return 1;
}

// evict_node with prediction-score protection (treatment only).
// Nodes with pred_score > 0 are skipped. Falls back to unfiltered
// scan if every candidate is protected (avoids allocation deadlock).
fn evict_node(W:[]u8)i32 {
  let cur:i32=hg(W,8); let best:i32=-1; let bb:i32=1000000; let i:i32=0;
  while(i<1024){
    let n:i32=cur+i; if(n>=1024){n=n-1024;}
    if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
      let skip:i32=0;
      if(score_on()==1){
        let ps:i32=0;
        if(ng(W,n,0)==1){ ps=ng(W,n,8); }
        else { if(ng(W,n,0)==20){ ps=ng(W,n,12); } }
        if(ps>0){ skip=1; }
      }
      if(skip==0){
        let b:i32=bid(W,n);
        if(b<bb){bb=b; best=n;}
      }
    }
    i=i+1;
  }
  if(best<0 && score_on()==1){
    i=0;
    while(i<1024){
      let n:i32=cur+i; if(n>=1024){n=n-1024;}
      if(n>=2 && ng(W,n,36)==1 && is_prot(W,n)==0){
        let b:i32=bid(W,n);
        if(b<bb){bb=b; best=n;}
      }
      i=i+1;
    }
  }
  if(best<0){return -1;}
  rec_evict(W,best); ns(W,best,36,0); hs(W,20,hg(W,20)-1);
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && (eg(W,e,0)==best || eg(W,e,8)==best)){
      es(W,e,0,-1); hs(W,24,hg(W,24)-1);
    }
    e=e+1;
  }
  let nc:i32=best+1; if(nc>=1024){nc=2;} hs(W,8,nc);
  return best;
}

// ood_cx.zag -- OOD tests for H-CAUSALEXP-CONSTRUCT (step 7).
// Pure Zag. No Python anywhere.
//
// Part 1 (K-OOD0): independent reimplementation of the frozen learner,
// validated against builder CXCONSTRUCT_RAW.txt (commit 48f2adc15).
// Part 2 (OOD-1..4): out-of-distribution tests per frozen prereg
//   PREREG_OOD.md (commit 2550d053c, Amendment 1).

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }
fn emit_action(a:i32)void {
  if(a==0){emit("S");}
  else if(a==1){emit("W");}
  else if(a==2){emit("OY");}
  else if(a==3){emit("OZ");}
  else{emit("OV");}
  return;
}
fn emit_seq(seq:[]u8,off:i32,len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit_action(seq[off+i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}

// ============ frozen hypothesis rules (DATA) ============
// w: 0=A,1=B,2=D1,3=D2,4=D3,5=INHIB-hypos. h: 0,1.
// out: 12 bytes: +0 src,+4 dst,+8 delay. Vars: X=0,Z=1,Y=2.
fn n_rules(w:i32,h:i32)i32 {
  if(w==0){
    if(h==0){return 2;}
    return 1;
  }
  if(w==1){
    if(h==0){return 2;}
    return 1;
  }
  if(w==2){
    if(h==0){return 2;}
    return 1;
  }
  if(w==3){
    if(h==0){return 2;}
    return 1;
  }
  if(w==4){
    if(h==0){return 2;}
    return 1;
  }
  return 1;
}
fn get_rule(w:i32,h:i32,r:i32,out:[]u8)void {
  let src:i32=0; let dst:i32=0; let delay:i32=0;
  if(w==0){
    if(h==0){
      if(r==0){src=0;dst=1;delay=2;}
      else{src=1;dst=2;delay=0;}
    } else {src=0;dst=2;delay=1;}
  } else if(w==1){
    if(h==0){
      if(r==0){src=0;dst=1;delay=3;}
      else{src=1;dst=2;delay=0;}
    } else {src=0;dst=2;delay=2;}
  } else if(w==2){
    if(h==0){
      if(r==0){src=0;dst=1;delay=5;}
      else{src=1;dst=2;delay=0;}
    } else {src=0;dst=2;delay=4;}
  } else if(w==3){
    if(h==0){
      if(r==0){src=0;dst=1;delay=6;}
      else{src=1;dst=2;delay=0;}
    } else {src=0;dst=2;delay=5;}
  } else if(w==4){
    if(h==0){
      if(r==0){src=0;dst=1;delay=7;}
      else{src=1;dst=2;delay=0;}
    } else {src=0;dst=2;delay=6;}
  } else {
    if(h==0){src=0;dst=2;delay=1;}
    else{src=0;dst=2;delay=3;}
  }
  set32(out,0,src); set32(out,4,dst); set32(out,8,delay);
  return;
}

// ============ frozen simulator (3 vars, 4 actions) ============
// State (32 bytes): +0 X,+4 Z,+8 Y,+12 t,+16 tX,+20 tZ,+24 tY.
// Actions: 0=S, 1=W, 2=OY, 3=OZ. Returns observation or -1.
fn step(w:i32,h:i32,st:[]u8,a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<2){
      let r:i32=0;
      let nr:i32=n_rules(w,h);
      while(r<nr){
        let rb:[]u8=z_alloc(12);
        get_rule(w,h,r,rb);
        let src:i32=get32(rb,0);
        let dst:i32=get32(rb,4);
        let delay:i32=get32(rb,8);
        if(get32(st,src*4)==1){
          let ts:i32=get32(st,16+src*4);
          if(t-ts>=delay){
            if(get32(st,dst*4)==0){
              set32(st,dst*4,1);
              set32(st,16+dst*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else if(a==3){
    obs=get32(st,4);
  }
  return obs;
}
fn sim_seq(w:i32,h:i32,seq:[]u8,len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=step(w,h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn has_observe(seq:[]u8,len:i32)i32 {
  let i:i32=0;
  while(i<len){
    if((seq[i] as i32)>=2){return 1;}
    i=i+1;
  }
  return 0;
}

// ============ frozen construct (iterative deepening, MAXD=maxd) ============
// res: +0 found,+4 flen,+8 fp0,+12 fp1,+16.. fseq(16B),+32.. checked[10](40B).
fn construct(w:i32,maxd:i32,res:[]u8)void {
  set32(res,0,0);
  set32(res,4,0);
  set32(res,8,-9);
  set32(res,12,-9);
  let found:i32=0;
  let flen:i32=0;
  let fp0:i32=-9;
  let fp1:i32=-9;
  let fseq:[]u8=z_alloc(16);
  let d:i32=1;
  while(d<=maxd){
    if(found==1){break;}
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*4; k=k+1;}
    let checked:i32=0;
    let si:i32=0;
    while(si<total){
      if(found==1){break;}
      let seq:[]u8=z_alloc(16);
      let div:i32=1;
      let p:i32=0;
      while(p<d-1){div=div*4; p=p+1;}
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        seq[i]=(rem/div) as u8;
        rem=rem%div;
        if(div>1){div=div/4;}
        i=i+1;
      }
      if(has_observe(seq,d)==1){
        checked=checked+1;
        let q0:i32=sim_seq(w,0,seq,d);
        let q1:i32=sim_seq(w,1,seq,d);
        if(q0!=q1){
          found=1;
          flen=d;
          fp0=q0; fp1=q1;
          let c:i32=0;
          while(c<d){fseq[c]=seq[c]; c=c+1;}
        }
      }
      si=si+1;
    }
    set32(res,32+(d-1)*4,checked);
    d=d+1;
  }
  set32(res,0,found);
  set32(res,4,flen);
  set32(res,8,fp0);
  set32(res,12,fp1);
  let c2:i32=0;
  while(c2<16){res[16+c2]=fseq[c2]; c2=c2+1;}
  return;
}

// ============ measurement: first depth with a discriminating seq ============
fn first_found_depth(w:i32,maxd:i32)i32 {
  let d:i32=1;
  while(d<=maxd){
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*4; k=k+1;}
    let si:i32=0;
    while(si<total){
      let seq:[]u8=z_alloc(16);
      let div:i32=1;
      let p:i32=0;
      while(p<d-1){div=div*4; p=p+1;}
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        seq[i]=(rem/div) as u8;
        rem=rem%div;
        if(div>1){div=div/4;}
        i=i+1;
      }
      if(has_observe(seq,d)==1){
        let q0:i32=sim_seq(w,0,seq,d);
        let q1:i32=sim_seq(w,1,seq,d);
        if(q0!=q1){return d;}
      }
      si=si+1;
    }
    d=d+1;
  }
  return 0;
}

// ============ extended simulator (4 vars, 5 actions) for OOD-2 ============
// state 40B: +0 X,+4 Z,+8 Y,+12 V,+16 t,+20 tX,+24 tZ,+28 tY,+32 tV.
// actions: 0=S,1=W,2=OY,3=OZ,4=OV. H31=[(X,V,1)], H32=[(X,V,3)].
fn ex_step(eh:i32,st:[]u8,a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,20,get32(st,16));
  } else if(a==1){
    let t:i32=get32(st,16)+1;
    set32(st,16,t);
    let pass:i32=0;
    while(pass<2){
      let delay:i32=1;
      if(eh==1){delay=3;}
      if(get32(st,0)==1){
        let ts:i32=get32(st,20);
        if(t-ts>=delay){
          if(get32(st,12)==0){
            set32(st,12,1);
            set32(st,32,t);
          }
        }
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else if(a==3){
    obs=get32(st,4);
  } else if(a==4){
    obs=get32(st,12);
  }
  return obs;
}
fn ex_sim_seq(eh:i32,seq:[]u8,len:i32)i32 {
  let st:[]u8=z_alloc(40);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=ex_step(eh,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
// Count discriminating seqs over the frozen 4-action menu (actions 0..3).
fn count_dis4()i32 {
  let n:i32=0;
  let d:i32=1;
  while(d<=5){
    let total:i32=1;
    let k:i32=0;
    while(k<d){total=total*4; k=k+1;}
    let si:i32=0;
    while(si<total){
      let seq:[]u8=z_alloc(16);
      let div:i32=1;
      let p:i32=0;
      while(p<d-1){div=div*4; p=p+1;}
      let rem:i32=si;
      let i:i32=0;
      while(i<d){
        seq[i]=(rem/div) as u8;
        rem=rem%div;
        if(div>1){div=div/4;}
        i=i+1;
      }
      if(has_observe(seq,d)==1){
        let q0:i32=ex_sim_seq(0,seq,d);
        let q1:i32=ex_sim_seq(1,seq,d);
        if(q0!=q1){n=n+1;}
      }
      si=si+1;
    }
    d=d+1;
  }
  return n;
}

// ============ inhibition true world for OOD-3 ============
// Y = NOT X. Z = 0 always.
fn inhib_step(st:[]u8,a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
  } else if(a==1){
    set32(st,12,get32(st,12)+1);
  } else if(a==2){
    if(get32(st,0)==0){obs=1;}
    else{obs=0;}
  } else if(a==3){
    obs=0;
  }
  return obs;
}
fn inhib_exec(seq:[]u8,off:i32,len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=inhib_step(st,seq[off+i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}

// ============ OOD-4: enumeration count ============
fn count_checked(d:i32)i32 {
  let total:i32=1;
  let k:i32=0;
  while(k<d){total=total*4; k=k+1;}
  let cnt:i32=0;
  let si:i32=0;
  while(si<total){
    let seq:[]u8=z_alloc(16);
    let div:i32=1;
    let p:i32=0;
    while(p<d-1){div=div*4; p=p+1;}
    let rem:i32=si;
    let i:i32=0;
    while(i<d){
      seq[i]=(rem/div) as u8;
      rem=rem%div;
      if(div>1){div=div/4;}
      i=i+1;
    }
    if(has_observe(seq,d)==1){cnt=cnt+1;}
    si=si+1;
  }
  return cnt;
}
fn pow4(d:i32)i32 {
  let r:i32=1;
  let i:i32=0;
  while(i<d){r=r*4; i=i+1;}
  return r;
}
fn pow2(d:i32)i32 {
  let r:i32=1;
  let i:i32=0;
  while(i<d){r=r*2; i=i+1;}
  return r;
}

// ============ main ============
fn main()i32 {
  emit("=== K-OOD0 reimplementation fidelity ===\n");
  let r0:[]u8=z_alloc(80);
  construct(0,5,r0);
  emit("K-OOD0 world=A found="); e64(get32(r0,0));
  emit(" flen="); e64(get32(r0,4));
  emit(" fp0="); e64(get32(r0,8));
  emit(" fp1="); e64(get32(r0,12));
  emit(" seq="); emit_seq(r0,16,get32(r0,4));
  emit(" c1="); e64(get32(r0,32));
  emit(" c2="); e64(get32(r0,36));
  emit(" c3="); e64(get32(r0,40));
  emit("\n");
  let r1:[]u8=z_alloc(80);
  construct(1,5,r1);
  emit("K-OOD0 world=B found="); e64(get32(r1,0));
  emit(" flen="); e64(get32(r1,4));
  emit(" fp0="); e64(get32(r1,8));
  emit(" fp1="); e64(get32(r1,12));
  emit(" seq="); emit_seq(r1,16,get32(r1,4));
  emit(" c1="); e64(get32(r1,32));
  emit(" c2="); e64(get32(r1,36));
  emit(" c3="); e64(get32(r1,40));
  emit(" c4="); e64(get32(r1,44));
  emit("\n");

  emit("=== OOD-1 deeper worlds (frozen MAXD=5) ===\n");
  let ood1_pass:i32=0;
  let w:i32=2;
  while(w<=4){
    let rr:[]u8=z_alloc(80);
    construct(w,5,rr);
    emit("OOD-1 world=");
    if(w==2){emit("D1");}
    else if(w==3){emit("D2");}
    else{emit("D3");}
    emit(" found="); e64(get32(rr,0));
    emit("\n");
    if(get32(rr,0)==1){ood1_pass=1;}
    w=w+1;
  }
  emit("OOD-1 minimal true depths: D1="); e64(first_found_depth(2,9));
  emit(" D2="); e64(first_found_depth(3,9));
  emit(" D3="); e64(first_found_depth(4,9));
  emit("\n");
  emit("OOD-1 verdict: ");
  if(ood1_pass==1){emit("PASS\n");} else {emit("FAIL\n");}

  emit("=== OOD-2 fifth primitive ===\n");
  let n4:i32=count_dis4();
  emit("OOD-2 discriminating seqs in frozen 4-action menu n4="); e64(n4); emit("\n");
  let wit:[]u8=z_alloc(4);
  wit[0]=0; wit[1]=1; wit[2]=1; wit[3]=4;
  let wq0:i32=ex_sim_seq(0,wit,4);
  let wq1:i32=ex_sim_seq(1,wit,4);
  emit("OOD-2 witness [S,W,W,OV]: H31="); e64(wq0);
  emit(" H32="); e64(wq1);
  if(wq0!=wq1){emit(" discriminates=1\n");} else {emit(" discriminates=0\n");}
  emit("OOD-2 verdict: ");
  if(n4>=1){emit("PASS\n");} else {emit("FAIL\n");}

  emit("=== OOD-3 inhibition law ===\n");
  let r5:[]u8=z_alloc(80);
  construct(5,5,r5);
  emit("OOD-3 construct found="); e64(get32(r5,0));
  emit(" seq="); emit_seq(r5,16,get32(r5,4));
  emit(" h0pred="); e64(get32(r5,8));
  emit(" h1pred="); e64(get32(r5,12));
  emit("\n");
  let real:i32=inhib_exec(r5,16,get32(r5,4));
  emit("OOD-3 EXEC real="); e64(real); emit("\n");
  // copy fseq out of r5 for sim_seq
  let fs:[]u8=z_alloc(16);
  let fl:i32=get32(r5,4);
  let ci:i32=0;
  while(ci<fl){fs[ci]=r5[16+ci]; ci=ci+1;}
  let surv:i32=0;
  let h:i32=0;
  while(h<2){
    let q:i32=sim_seq(5,h,fs,fl);
    if(q==real){
      emit("OOD-3 SURVIVE h="); e64(h); emit(" (pred="); e64(q); emit(")\n");
      surv=surv+1;
    } else {
      emit("OOD-3 ELIM h="); e64(h); emit(" (pred="); e64(q); emit(")\n");
    }
    h=h+1;
  }
  emit("OOD-3 survivors="); e64(surv); emit("\n");
  // held-out check: survivor law vs true law on [S,W,W,W,OY]
  let ho:[]u8=z_alloc(5);
  ho[0]=0; ho[1]=1; ho[2]=1; ho[3]=1; ho[4]=2;
  let ho_true:i32=inhib_exec(ho,0,5);
  let ho_h0:i32=sim_seq(5,0,ho,5);
  let ho_h1:i32=sim_seq(5,1,ho,5);
  emit("OOD-3 held-out [S,W,W,W,OY]: true="); e64(ho_true);
  emit(" H25="); e64(ho_h0);
  emit(" H26="); e64(ho_h1); emit("\n");
  emit("OOD-3 verdict: ");
  if(surv==0){emit("PASS\n");} else {emit("FAIL\n");}

  emit("=== OOD-4 scale ===\n");
  let ood4_fail:i32=1;
  let d:i32=1;
  while(d<=10){
    let cc:i32=count_checked(d);
    let ex:i32=pow4(d)-pow2(d);
    emit("OOD-4 d="); e64(d);
    emit(" measured="); e64(cc);
    emit(" formula="); e64(ex);
    if(cc==ex){emit(" match=1\n");} else {emit(" match=0\n"); ood4_fail=0;}
    d=d+1;
  }
  emit("OOD-4 verdict: ");
  if(ood4_fail==1){emit("FAIL\n");} else {emit("PASS\n");}

  emit("=== OVERALL ===\n");
  let npass:i32=0;
  if(ood1_pass==1){npass=npass+1;}
  let ood2_pass:i32=0;
  if(n4>=1){ood2_pass=1; npass=npass+1;}
  let ood3_pass:i32=0;
  if(surv==0){ood3_pass=1; npass=npass+1;}
  let ood4_pass:i32=0;
  if(ood4_fail==0){ood4_pass=1; npass=npass+1;}
  emit("passes="); e64(npass); emit("/4\n");
  if(npass==4){emit("VERDICT=OOD-PASS\n");}
  else if(npass>=1){emit("VERDICT=OOD-PARTIAL\n");}
  else{emit("VERDICT=OOD-FAIL\n");}
  return 0;
}

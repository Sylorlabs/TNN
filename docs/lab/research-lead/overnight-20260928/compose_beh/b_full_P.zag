// h_base.zag -- shared base for the hybrid-widening battery.
// Fact store, probe_kind, behaviors (WALK/COUNT/MAYBE/IDENT), MAP table,
// kind-contract observations, S2-pinned admission, missbits ledger,
// tried masks, world setups D0-D5, output helpers, report printers.
// Pure Zag. No Python.
// Copy of compose_widen/w_base.zag (that lane is not modified) plus
// setup_d4/setup_d5, arena field 1104 (wback), and report() printing WBACK.
//
// Output rule (mandatory): dynamic content is formatted into ONE preallocated
// buffer with cursor-returning helpers, then a single _zag_raw_syscall write.
// _zag_print is never used for dynamic content.
//
// Arena layout (bytes):
//   0: nf (fact count)
//   4: facts, 64 * 12 bytes (s,r,o as little-endian i32)
//   776: MAP table, 4 maps * 10 fields * 4 bytes
//        fields: 0 class, 1 rel, 2 rel2, 3 inmask, 4 outmask,
//                5 in_node, 6 in_num, 7 out_node, 8 out_num, 9 nobs
//   936: tries   940: found   944: ans
//   1024: missbits ledger, 4 maps * 2 pos * 4 bytes (kind bits 1<<(k-1))
//   1056: tried_single mask   1060: tried_pair mask (bit x*4+y)
//   1064: succ_inter (init -1)  1068: widen_logged  1072: wtrig
//   1076: q_kin  1080: q_kout  1084: q_nm  1088: q_s  1092: q_exp
//   1096: widen scratch  1100: wadmit mask (bit x*4+y)  1104: wback
// Classes: 0=WALK, 1=COUNT, 2=MAYBE, 3=IDENT.

fn z_alloc(n:i32)[]u8 {
  let p:*u8=_zag_malloc(n) as *u8;
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
// ---- output helpers: append into buffer, return new cursor ----
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ b[c+i]=s[i]; i=i+1; }
  return c+s.len;
}
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0;
  let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1;
  let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n;
  let p:i32=e-1;
  let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){
    b[p]=(48+(y-(y/10)*10)) as u8;
    y=y/10;
    p=p-1;
  }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_flush(b:[]u8,c:i32)void {
  _zag_raw_syscall(1,1,(_zag_slice_ptr(b) as i64),c as i64,0,0,0);
  return;
}
// ---- arena access ----
fn ag(A:[]u8,off:i32)i32 { return get32(A,off); }
fn ap(A:[]u8,off:i32,v:i32)void { set32(A,off,v); return; }
fn mg(A:[]u8,m:i32,f:i32)i32 { return get32(A,776+m*40+f*4); }
fn mp(A:[]u8,m:i32,f:i32,v:i32)void { set32(A,776+m*40+f*4,v); return; }
fn world_new()[]u8 { return z_alloc(4096); }
fn stash(A:[]u8,s:i32,kin:i32,kout:i32,exp:i32,nm:i32)void {
  ap(A,1088,s); ap(A,1076,kin); ap(A,1080,kout); ap(A,1092,exp); ap(A,1084,nm);
  return;
}
// ---- facts ----
fn fact_add(A:[]u8,s:i32,r:i32,o:i32)void {
  let n:i32=ag(A,0);
  if(n<64){
    set32(A,4+n*12,s); set32(A,4+n*12+4,r); set32(A,4+n*12+8,o);
    ap(A,0,n+1);
  }
  return;
}
fn is_subject(A:[]u8,v:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12)==v){ return 1; }
    i=i+1;
  }
  return 0;
}
fn pkind(A:[]u8,v:i32)i32 {
  if(is_subject(A,v)==1){ return 1; }
  return 2;
}
// ---- behaviors ----
fn walkf(A:[]u8,s:i32,rel:i32)i32 {
  let cur:i32=s;
  let steps:i32=0;
  while(steps<32){
    let n:i32=ag(A,0);
    let i:i32=0;
    let nxt:i32=-2;
    while(i<n){
      let fs0:i32=get32(A,4+i*12);
      let fr0:i32=get32(A,4+i*12+4);
      if(fs0==cur && fr0==rel){ nxt=get32(A,4+i*12+8); i=n; }
      i=i+1;
    }
    if(nxt==-2){
      if(steps==0){ return -2; }
      return cur;
    }
    cur=nxt;
    steps=steps+1;
  }
  return cur;
}
fn count_rel(A:[]u8,s:i32,rel:i32)i32 {
  let n:i32=ag(A,0);
  let i:i32=0;
  let c:i32=0;
  while(i<n){
    let fs0:i32=get32(A,4+i*12);
    let fr0:i32=get32(A,4+i*12+4);
    if(fs0==s && fr0==rel){ c=c+1; }
    i=i+1;
  }
  if(c==0){ return -2; }
  return c;
}
fn exec_map(A:[]u8,m:i32,s:i32)i32 {
  let cl:i32=mg(A,m,0);
  let r1:i32=mg(A,m,1);
  if(cl==0){ return walkf(A,s,r1); }
  if(cl==1){ return count_rel(A,s,r1); }
  if(cl==3){ return s; }
  let r2:i32=mg(A,m,2);
  let e:i32=walkf(A,s,r1);
  if(e==-2){ return -2; }
  let c:i32=count_rel(A,e,r2);
  if(c==-2){ return e; }
  return c;
}
// ---- contract observations ----
fn observe(A:[]u8,m:i32,inv:i32,outv:i32)void {
  let ik:i32=pkind(A,inv);
  let ok:i32=pkind(A,outv);
  if(ik==1){ mp(A,m,5,mg(A,m,5)+1); }
  if(ik==2){ mp(A,m,6,mg(A,m,6)+1); }
  if(ok==1){ mp(A,m,7,mg(A,m,7)+1); }
  if(ok==2){ mp(A,m,8,mg(A,m,8)+1); }
  mp(A,m,3,mg(A,m,3)|(1<<(ik-1)));
  mp(A,m,4,mg(A,m,4)|(1<<(ok-1)));
  mp(A,m,9,mg(A,m,9)+1);
  return;
}
fn teach(A:[]u8,m:i32,s:i32,exp:i32)void {
  let v:i32=exec_map(A,m,s);
  if(v==exp){ observe(A,m,s,v); }
  return;
}
fn map_new(A:[]u8,m:i32,cl:i32,r1:i32,r2:i32)void {
  mp(A,m,0,cl); mp(A,m,1,r1); mp(A,m,2,r2);
  return;
}
// ---- S2-pinned admission: empty kind-set reads as universal {1,2} ----
fn k_has(mask:i32,k:i32)i32 {
  if(mask==0){ return 1; }
  if((mask & (1<<(k-1)))!=0){ return 1; }
  return 0;
}
fn k_inter(mx:i32,my:i32)i32 {
  if(mx==0){ return 1; }
  if(my==0){ return 1; }
  if((mx & my)!=0){ return 1; }
  return 0;
}
fn admit_single(A:[]u8,m:i32,kin:i32,kout:i32)i32 {
  let a:i32=k_has(mg(A,m,3),kin);
  let b:i32=k_has(mg(A,m,4),kout);
  if(a==1 && b==1){ return 1; }
  return 0;
}
fn admit_pair(A:[]u8,x:i32,y:i32,kin:i32,kout:i32)i32 {
  let a:i32=k_has(mg(A,x,3),kin);
  let d:i32=k_inter(mg(A,x,4),mg(A,y,3));
  let b:i32=k_has(mg(A,y,4),kout);
  if(a==1 && d==1 && b==1){ return 1; }
  return 0;
}
// ---- missbits ledger: per MAP per position, observed-but-uncovered kind bits ----
fn lg_get(A:[]u8,m:i32,p:i32)i32 { return get32(A,1024+(m*2+p)*4); }
fn lg_add(A:[]u8,m:i32,p:i32,k:i32)i32 {
  let b:i32=1<<(k-1);
  let o:i32=1024+(m*2+p)*4;
  let old:i32=get32(A,o);
  if((old & b)!=0){ return 0; }
  set32(A,o,old|b);
  return 1;
}
fn lg_clear(A:[]u8,nm:i32)void {
  let m:i32=0;
  while(m<nm){
    set32(A,1024+(m*2+0)*4,0);
    set32(A,1024+(m*2+1)*4,0);
    m=m+1;
  }
  return;
}
fn eff_mask(A:[]u8,m:i32,f:i32)i32 {
  let r:i32=mg(A,m,f);
  if(r==0){ return 3; }
  return r;
}
fn tried_pair(A:[]u8,x:i32,y:i32)i32 {
  if((ag(A,1060) & (1<<(x*4+y)))!=0){ return 1; }
  return 0;
}
// ---- report printers ----
fn census(A:[]u8,B:[]u8,c:i32,nm:i32)i32 {
  let m:i32=0;
  while(m<nm){
    c=o_app(B,c,"CENSUS m="); c=o_i64(B,c,m as i64);
    c=o_app(B,c," inmask="); c=o_i64(B,c,mg(A,m,3) as i64);
    c=o_app(B,c," outmask="); c=o_i64(B,c,mg(A,m,4) as i64);
    c=o_app(B,c," n="); c=o_i64(B,c,mg(A,m,9) as i64);
    c=o_nl(B,c);
    m=m+1;
  }
  return c;
}
fn ledger_print(A:[]u8,B:[]u8,c:i32,nm:i32)i32 {
  let m:i32=0;
  while(m<nm){
    c=o_app(B,c,"LEDGER m="); c=o_i64(B,c,m as i64);
    c=o_app(B,c," in="); c=o_i64(B,c,lg_get(A,m,0) as i64);
    c=o_app(B,c," out="); c=o_i64(B,c,lg_get(A,m,1) as i64);
    c=o_nl(B,c);
    m=m+1;
  }
  return c;
}
fn report(A:[]u8,B:[]u8,c:i32,arm:[]u8,prob:[]u8,nm:i32)i32 {
  c=o_app(B,c,"ARM="); c=o_app(B,c,arm);
  c=o_app(B,c," PROB="); c=o_app(B,c,prob);
  c=o_app(B,c," ANS="); c=o_i64(B,c,ag(A,944) as i64);
  c=o_app(B,c," TRIES="); c=o_i64(B,c,ag(A,936) as i64);
  c=o_app(B,c," WIDEN="); c=o_i64(B,c,ag(A,1068) as i64);
  c=o_app(B,c," WTRIG="); c=o_i64(B,c,ag(A,1072) as i64);
  c=o_app(B,c," WBACK="); c=o_i64(B,c,ag(A,1104) as i64);
  c=o_app(B,c," INTER="); c=o_i64(B,c,ag(A,1064) as i64); c=o_nl(B,c);
  c=census(A,B,c,nm);
  c=ledger_print(A,B,c,nm);
  return c;
}
// ---- world setups (D0-D3 frozen in WIDEN-COMP PREREG Section 4) ----
fn setup_d0(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14); fact_add(A,14,82,141);
  fact_add(A,15,81,16); fact_add(A,16,81,17); fact_add(A,17,81,18);
  fact_add(A,18,82,181); fact_add(A,18,82,182);
  fact_add(A,50,82,51); fact_add(A,50,82,52); fact_add(A,50,82,53);
  fact_add(A,60,82,61); fact_add(A,60,82,62); fact_add(A,60,82,63); fact_add(A,60,82,64);
  fact_add(A,21,81,22);
  fact_add(A,31,81,32); fact_add(A,32,81,33); fact_add(A,33,81,34);
  fact_add(A,34,82,35); fact_add(A,34,82,36);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,3,0,0); map_new(A,3,1,81,0);
  teach(A,0,11,14); teach(A,0,15,18);
  teach(A,1,50,3); teach(A,1,60,4);
  teach(A,2,21,21); teach(A,2,21,21);
  teach(A,3,11,1); teach(A,3,15,1);
  return;
}
fn setup_d1(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14);
  fact_add(A,70,82,71); fact_add(A,70,82,72);
  fact_add(A,31,81,32);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  fact_add(A,44,82,45); fact_add(A,44,82,46);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,3,0,0); map_new(A,3,1,81,0);
  teach(A,0,11,14); teach(A,1,70,2); teach(A,2,31,31); teach(A,3,31,1);
  return;
}
fn setup_d2(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14);
  fact_add(A,70,82,71); fact_add(A,70,82,72);
  fact_add(A,60,83,61); fact_add(A,60,83,62); fact_add(A,61,83,63);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  fact_add(A,44,83,441);
  fact_add(A,41,83,411); fact_add(A,41,83,412);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,1,83,0);
  teach(A,0,11,14); teach(A,1,70,2); teach(A,2,60,2);
  return;
}
fn setup_d3(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14);
  fact_add(A,70,82,71); fact_add(A,70,82,72);
  fact_add(A,31,81,32);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  map_new(A,0,0,81,0); map_new(A,1,3,0,0); map_new(A,2,1,82,0);
  teach(A,0,11,14); teach(A,1,31,31); teach(A,2,70,2);
  return;
}
// ---- D4 HIDDEN PAIR, NO SPURIOUS MISS (frozen in this prereg Section 4) ----
fn setup_d4(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14);
  fact_add(A,70,82,71); fact_add(A,70,82,72);
  fact_add(A,91,83,92); fact_add(A,92,83,93); fact_add(A,93,83,94);
  fact_add(A,31,81,32);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  fact_add(A,41,83,47);
  fact_add(A,47,84,471);
  map_new(A,0,0,81,0); map_new(A,1,1,82,0); map_new(A,2,0,83,0); map_new(A,3,3,0,0);
  teach(A,0,11,14); teach(A,1,70,2); teach(A,2,91,94); teach(A,3,31,31);
  return;
}
// ---- D5 LONG BLIND TAIL (frozen in this prereg Section 4) ----
fn setup_d5(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14);
  fact_add(A,70,82,71); fact_add(A,70,82,72);
  fact_add(A,75,84,751); fact_add(A,75,84,752);
  fact_add(A,60,83,61); fact_add(A,60,83,62);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  fact_add(A,44,83,441); fact_add(A,44,83,442);
  map_new(A,0,1,82,0); map_new(A,1,1,84,0); map_new(A,2,0,81,0); map_new(A,3,1,83,0);
  teach(A,0,70,2); teach(A,1,75,2); teach(A,2,11,14); teach(A,3,60,2);
  return;
}
// ---- persistent cross-query ledger transport (compose_ledger) ----
// The missbits ledger (32 bytes at arena offset 1024: 4 MAPs x 2 pos x 4)
// is the ONLY cross-query state. Each query runs on a fresh arena; the
// learner carries the ledger verbatim from query i to query i+1 (U3).
fn ledger_copy(A:[]u8,L:[]u8)void {
  let i:i32=0;
  while(i<32){ L[i]=A[1024+i]; i=i+1; }
  return;
}
fn ledger_restore(A:[]u8,L:[]u8)void {
  let i:i32=0;
  while(i<32){ A[1024+i]=L[i]; i=i+1; }
  return;
}
// ---- D5B BEHAVIOR CHANGE (frozen in compose_beh PREREG Section 3a) ----
// D5 facts MINUS (44,83,441),(44,83,442) PLUS (42,82,421),(42,82,422).
// Node 44 is no longer a subject, so X(42)=44 emits NUM (kind 2) at out,
// which is WITHIN the unchanged taught outmask {2}: the carried bit
// (m2,out,1) becomes genuinely false. Teaching is identical to D5, so every
// MAP keeps inmask {1}, outmask {2}: the contract is UNCHANGED, only
// emission facts change. The old answer path (2,3) via Y(44)=2 is gone
// (Y(44)=-2); the relocated answer is the admitted single A(42)=2.
fn setup_d5b(A:[]u8)void {
  fact_add(A,11,81,12); fact_add(A,12,81,13); fact_add(A,13,81,14);
  fact_add(A,70,82,71); fact_add(A,70,82,72);
  fact_add(A,75,84,751); fact_add(A,75,84,752);
  fact_add(A,60,83,61); fact_add(A,60,83,62);
  fact_add(A,41,81,42); fact_add(A,42,81,43); fact_add(A,43,81,44);
  fact_add(A,42,82,421); fact_add(A,42,82,422);
  map_new(A,0,1,82,0); map_new(A,1,1,84,0); map_new(A,2,0,81,0); map_new(A,3,1,83,0);
  teach(A,0,70,2); teach(A,1,75,2); teach(A,2,11,14); teach(A,3,60,2);
  return;
}
// l_pers.zag -- arm P: persistent cross-query missbits ledger.
// Frozen hybrid composer (R1 coverage-selective WTRIG=2, R2 blind backstop
// WTRIG=1) PLUS the persistent-ledger manipulation U1-U5:
//   U1: ledger zero at learner init.
//   U2: every failed trial records miss bits (frozen miss_bit rule).
//   U3: ledger NEVER cleared between queries; carried verbatim (U3).
//   U4: PRIMING at query start: admit every filter-rejected, untried,
//       carried-ledger-justified ordered pair (frozen justification
//       predicate); log WIDEN=1, WTRIG=3, WADD=x,y; try primed pairs in id
//       order with wom=1 BEFORE the admitted-single phase.
//   U5: R1/R2 unchanged; WTRIG precedence 3 > 2 > 1 > 0.
// One composer, both frozen rules plus priming always on; no mode flag.
// Miss bits: bit 1<<(k-1) at ledger (m, p), p=0 in, p=1 out.
fn miss_bit(A:[]u8,m:i32,p:i32,k:i32)i32 {
  if(k_has(mg(A,m,3+p),k)==0){ return lg_add(A,m,p,k); }
  return 0;
}
fn h_miss_single(A:[]u8,m:i32,s:i32,v:i32)i32 {
  if(v<0){ return 0; }
  let a:i32=miss_bit(A,m,0,pkind(A,s));
  let b:i32=miss_bit(A,m,1,pkind(A,v));
  if(a==1){ return 1; }
  return b;
}
fn h_miss_pair(A:[]u8,x:i32,y:i32,v1:i32,v2:i32)i32 {
  if(v1<0){ return 0; }
  let a:i32=miss_bit(A,x,1,pkind(A,v1));
  let b:i32=0;
  let d:i32=0;
  if(v2>=0){
    b=miss_bit(A,y,0,pkind(A,v1));
    d=miss_bit(A,y,1,pkind(A,v2));
  }
  if(a==1){ return 1; }
  if(b==1){ return 1; }
  return d;
}
fn h_justified(A:[]u8,x:i32,y:i32,kin:i32,kout:i32)i32 {
  if(k_has(mg(A,x,3),kin)==0){ return 0; }
  if(k_has(mg(A,y,4),kout)==0){ return 0; }
  let lo:i32=lg_get(A,x,1);
  let ei:i32=eff_mask(A,y,3);
  if((lo & ei)!=0){ return 1; }
  let li:i32=lg_get(A,y,0);
  let eo:i32=eff_mask(A,x,4);
  if((li & eo)!=0){ return 1; }
  return 0;
}
fn wadmit_get(A:[]u8,x:i32,y:i32)i32 {
  if((ag(A,1100) & (1<<(x*4+y)))!=0){ return 1; }
  return 0;
}
fn wadmit_set(A:[]u8,x:i32,y:i32)void {
  ap(A,1100,ag(A,1100)|(1<<(x*4+y)));
  return;
}
// R1 admission phase: admit EVERY currently-justified untried rejected pair.
fn h_admit_scan(A:[]u8,B:[]u8,c:i32)i32 {
  ap(A,1096,0);
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && tried_pair(A,x,y)==0 && wadmit_get(A,x,y)==0 && admit_pair(A,x,y,kin,kout)==0 && h_justified(A,x,y,kin,kout)==1){
        c=o_app(B,c,"WADD="); c=o_i64(B,c,x as i64);
        c=o_app(B,c,","); c=o_i64(B,c,y as i64); c=o_nl(B,c);
        wadmit_set(A,x,y);
        ap(A,1096,1);
      }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
// R1 trial phase: try widen-admitted untried pairs in id order.
fn h_trial_scan(A:[]u8,B:[]u8,c:i32)i32 {
  let nm:i32=ag(A,1084);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(wadmit_get(A,x,y)==1 && tried_pair(A,x,y)==0){
        c=h_try_pair(A,B,c,x,y,0);
      }
      if(ag(A,940)==1){ return c; }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
// R1: selective widening. Admit-all-then-try, rescanning while new misses
// justify further pairs.
fn h_widen(A:[]u8,B:[]u8,c:i32)i32 {
  if(ag(A,1068)==0){
    c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
    c=o_app(B,c,"WTRIG=2"); c=o_nl(B,c);
    ap(A,1068,1); ap(A,1072,2);
  }
  ap(A,1096,1);
  while(ag(A,1096)==1 && ag(A,940)==0){
    c=h_admit_scan(A,B,c);
    c=h_trial_scan(A,B,c);
  }
  return c;
}
// R2: blind backstop. Exactly once per query, on admitted-exhaustion.
// R1 is disarmed here (wom=0 at all call sites); misses still recorded.
fn h_backstop(A:[]u8,B:[]u8,c:i32)i32 {
  if(ag(A,1104)==0){
    c=o_app(B,c,"WBACK=1"); c=o_nl(B,c);
    c=o_app(B,c,"WTRIG=1"); c=o_nl(B,c);
    ap(A,1104,1); ap(A,1068,1);
    if(ag(A,1072)==0){ ap(A,1072,1); }
  }
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && admit_pair(A,x,y,kin,kout)==0 && tried_pair(A,x,y)==0){
        c=h_try_pair(A,B,c,x,y,0);
      }
      if(ag(A,940)==1){ return c; }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
fn h_try_pair(A:[]u8,B:[]u8,c:i32,x:i32,y:i32,wom:i32)i32 {
  ap(A,1060,ag(A,1060)|(1<<(x*4+y)));
  ap(A,936,ag(A,936)+1);
  let s:i32=ag(A,1088);
  let exp:i32=ag(A,1092);
  let v1:i32=exec_map(A,x,s);
  c=o_app(B,c,"INTER="); c=o_i64(B,c,v1 as i64); c=o_nl(B,c);
  let v2:i32=-3;
  if(v1>=0){
    v2=exec_map(A,y,v1);
    if(v2==exp){
      observe(A,x,s,v1); observe(A,y,v1,v2);
      ap(A,944,v2); ap(A,940,1); ap(A,1064,v1);
      return c;
    }
  }
  let nw:i32=h_miss_pair(A,x,y,v1,v2);
  if(wom==1 && nw==1){ c=h_widen(A,B,c); }
  return c;
}
fn h_try_single(A:[]u8,B:[]u8,c:i32,a:i32,wom:i32)i32 {
  ap(A,1056,ag(A,1056)|(1<<a));
  ap(A,936,ag(A,936)+1);
  let s:i32=ag(A,1088);
  let exp:i32=ag(A,1092);
  let v:i32=exec_map(A,a,s);
  if(v==exp){
    observe(A,a,s,v);
    ap(A,944,v); ap(A,940,1); ap(A,1064,-1);
    return c;
  }
  let nw:i32=h_miss_single(A,a,s,v);
  if(wom==1 && nw==1){ c=h_widen(A,B,c); }
  return c;
}
// U4 priming: justification predicate, identical to h_justified (frozen),
// evaluated against the CARRIED ledger at query start.
fn p_justified(A:[]u8,x:i32,y:i32,kin:i32,kout:i32)i32 {
  if(k_has(mg(A,x,3),kin)==0){ return 0; }
  if(k_has(mg(A,y,4),kout)==0){ return 0; }
  let lo:i32=lg_get(A,x,1);
  let ei:i32=eff_mask(A,y,3);
  if((lo & ei)!=0){ return 1; }
  let li:i32=lg_get(A,y,0);
  let eo:i32=eff_mask(A,x,4);
  if((li & eo)!=0){ return 1; }
  return 0;
}
// U4 priming admission: admit EVERY filter-rejected, untried,
// carried-ledger-justified ordered pair. Logs WIDEN=1, WTRIG=3 once.
fn p_prime_scan(A:[]u8,B:[]u8,c:i32)i32 {
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  let np:i32=0;
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && tried_pair(A,x,y)==0 && wadmit_get(A,x,y)==0 && admit_pair(A,x,y,kin,kout)==0 && p_justified(A,x,y,kin,kout)==1){
        if(np==0){
          c=o_app(B,c,"WIDEN=1"); c=o_nl(B,c);
          c=o_app(B,c,"WTRIG=3"); c=o_nl(B,c);
          ap(A,1068,1); ap(A,1072,3);
        }
        c=o_app(B,c,"WADD="); c=o_i64(B,c,x as i64);
        c=o_app(B,c,","); c=o_i64(B,c,y as i64); c=o_nl(B,c);
        wadmit_set(A,x,y);
        np=np+1;
      }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
// U4 priming trial phase: try primed pairs in id order, wom=1 (a NEW miss
// here fires R1 exactly as in the frozen admitted sequence).
fn p_prime_trial(A:[]u8,B:[]u8,c:i32)i32 {
  let nm:i32=ag(A,1084);
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(wadmit_get(A,x,y)==1 && tried_pair(A,x,y)==0){
        c=h_try_pair(A,B,c,x,y,1);
      }
      if(ag(A,940)==1){ return c; }
      y=y+1;
    }
    x=x+1;
  }
  return c;
}
fn p_solve(A:[]u8,B:[]u8,c:i32,prob:[]u8)i32 {
  ap(A,936,0); ap(A,940,0); ap(A,944,-2);
  ap(A,1056,0); ap(A,1060,0); ap(A,1064,-1); ap(A,1068,0); ap(A,1072,0);
  ap(A,1096,0); ap(A,1100,0); ap(A,1104,0);
  let nm:i32=ag(A,1084);
  let kin:i32=ag(A,1076);
  let kout:i32=ag(A,1080);
  // U3: NO lg_clear. The carried ledger persists across queries.
  // U4: ledger priming before the admitted sequence.
  c=p_prime_scan(A,B,c);
  c=p_prime_trial(A,B,c);
  if(ag(A,940)==1){ c=report(A,B,c,"P",prob,nm); return c; }
  let a:i32=0;
  while(a<nm){
    if(admit_single(A,a,kin,kout)==1){
      c=h_try_single(A,B,c,a,1);
      if(ag(A,940)==1){ c=report(A,B,c,"P",prob,nm); return c; }
    }
    a=a+1;
  }
  let x:i32=0;
  while(x<nm){
    let y:i32=0;
    while(y<nm){
      if(x!=y && admit_pair(A,x,y,kin,kout)==1 && tried_pair(A,x,y)==0){
        c=h_try_pair(A,B,c,x,y,1);
        if(ag(A,940)==1){ c=report(A,B,c,"P",prob,nm); return c; }
      }
      y=y+1;
    }
    x=x+1;
  }
  if(ag(A,940)==0){
    c=h_backstop(A,B,c);
    if(ag(A,940)==1){ c=report(A,B,c,"P",prob,nm); return c; }
  }
  c=report(A,B,c,"P",prob,nm);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let L:[]u8=z_alloc(32);
  let c:i32=0;
  // Q1 SEED (s=41; identical to frozen D5). Ledger starts empty (U1).
  let A0:[]u8=world_new();
  setup_d5(A0); stash(A0,41,1,2,2,4);
  c=p_solve(A0,B,c,"Q1");
  ledger_copy(A0,L);
  // Q2 TRANSFER (s=42). Carried ledger restored into the fresh arena.
  let A1:[]u8=world_new();
  setup_d5(A1); stash(A1,42,1,2,2,4);
  ledger_restore(A1,L);
  c=p_solve(A1,B,c,"Q2");
  ledger_copy(A1,L);
  // Q3B BEHAVIOR-CHANGE (s=42 on D5B: 44 no longer a subject, X emits NUM).
  // The carried bit (m2,out,1) is now genuinely false; the contract is
  // unchanged, so priming must fire on it (frozen PREREG Section 3b).
  let A2:[]u8=world_new();
  setup_d5b(A2); stash(A2,42,1,2,2,4);
  ledger_restore(A2,L);
  c=p_solve(A2,B,c,"Q3B");
  o_flush(B,c);
  return 0;
}

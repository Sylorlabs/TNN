fn dump_plans(b:[]u8,c:i32,L:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    let gt:i32=get32(L,13000+pi*56);
    if(gt!=0){
      c=o_app(b,c,"PLAN goal=");
      c=o_i64(b,c,gt as i64);
      let nn:i32=get32(L,13000+pi*56+4);
      c=o_app(b,c," n=");
      c=o_i64(b,c,nn as i64);
      let p:i32=0;
      while(p<nn){
        c=o_app(b,c," [");
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+4) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+8) as i64);
        b[c]=93; c=c+1;
        p=p+1;
      }
      c=o_nl(b,c);
    }
    pi=pi+1;
  }
  return c;
}
// ---- one retrieve episode ----
fn run_retep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,id:i32,ep:i32)i32 {
  ret_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let obj:i32=get32(rb,4);
  let n:i32=ret_episode(L,A,rel,obj,K,tout);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," ret n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one verify episode ----
fn run_vfyep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,Cb:[]u8,id:i32,ep:i32)i32 {
  vfy_ep_chain(Cb,id);
  let v:i32=vfy_episode(L,A,Cb,K);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," vfy v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one count episode ----
fn run_cntep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,seen:[]u8,id:i32,ep:i32)i32 {
  cnt_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let subj:i32=get32(rb,4);
  let n:i32=cnt_episode(L,A,rel,subj,K,tout,seen);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," cnt n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- oracle_dia: independent all-generic reference for diamond goals ----
// Goal shape: need0 pattern; need1/need2 chain templates over need0's
// output (fan-out); need3 count over the link-order concatenation of
// the need1 and need2 outputs (fan-in). Records are emitted in the
// predicted plan execution order: need0, need2, need1, need3.
// Uses only ret_gen, vfy_gen, cnt_gen.
fn do_query(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,G:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,seen:[]u8,qn:[]u8,okind:i32)i32 {
  set32(K,0,0);
  set32(K,4,0);
  let st:i32=compose(L,S,A,G,K,ans,vbuf);
  c=o_app(b,c,"Q id=");
  c=o_app(b,c,qn);
  if(st==0){
    c=o_app(b,c," goal=");
    c=o_i64(b,c,g_tag(G) as i64);
    c=o_app(b,c," decline=1");
    c=o_nl(b,c);
    return c;
  }
  set32(K,4,0);
  if(okind==1){ oracle_dia(A,G,K,oans,seen); }
  if(okind==2){ oracle_1ret(A,G,K,oans,seen); }
  if(okind==3){ oracle_1vfy(A,G,K,oans,seen); }
  if(okind==4){ oracle_rvr(A,G,K,oans,seen); }
  let cs:i32=get32(K,0);
  let cg:i32=get32(K,4);
  let a:i32=ans_eq(ans,oans);
  set32(L,13240,get32(L,13240)+a);
  set32(L,13244,get32(L,13244)+cs);
  set32(L,13248,get32(L,13248)+cg);
  c=o_app(b,c," goal=");
  c=o_i64(b,c,g_tag(G) as i64);
  c=o_app(b,c," st=");
  c=o_i64(b,c,st as i64);
  c=o_app(b,c," vers=");
  let nn:i32=get32(vbuf,16);
  let p:i32=0;
  while(p<nn){
    if(p>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(vbuf,p*4) as i64);
    p=p+1;
  }
  c=o_app(b,c," ans=");
  let an:i32=get32(ans,0);
  c=o_i64(b,c,an as i64);
  b[c]=58; c=c+1;
  let k:i32=0;
  while(k<an){
    if(k>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(ans,4+k*4) as i64);
    k=k+1;
  }
  c=o_app(b,c," agree=");
  c=o_i64(b,c,a as i64);
  c=o_app(b,c," cs=");
  c=o_i64(b,c,cs as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  c=o_nl(b,c);
  return c;
}
// ---- oracle_1ret: independent all-generic reference for a single ----
// ---- RETRIEVE need. Answer record matches the learner's [n, ints].
fn oracle_1vfy(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,0,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    set32(tmpc,4+i*12,need_f(G,0,1+i*3));
    set32(tmpc,4+i*12+4,need_f(G,0,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,0,1+i*3+2));
    i=i+1;
  }
  let v:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,v);
  return;
}
// ---- zero the global contract counters for a clean per-stage reading ----
fn zero_counters(S:[]u8)void {
  ss(S,900,0); ss(S,901,0); ss(S,904,0); ss(S,908,-1);
  ss(S,912,0); ss(S,916,0); ss(S,920,0); ss(S,924,0);
  ss(S,7,500);
  return;
}
// ---- oracle_dia: independent all-generic reference for diamond goals ----
// Goal shape: need0 pattern; need1/need2 chain templates over need0's
// output (fan-out); need3 count over the link-order concatenation of
// the need1 and need2 outputs (fan-in). Records are emitted in the
// predicted plan execution order: need0, need2, need1, need3.
// Uses only ret_gen, vfy_gen, cnt_gen.
fn oracle_dia(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns2:i32=need_f(G,2,0);
  let npass2:i32=0;
  let pass2:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub2:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns2);
    let i:i32=0;
    while(i<ns2){
      let s2:i32=need_f(G,2,1+i*3);
      if(s2==0){ s2=sub2; }
      set32(tmpc,4+i*12,s2);
      set32(tmpc,4+i*12+4,need_f(G,2,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,2,1+i*3+2));
      i=i+1;
    }
    let vv2:i32=vfy_gen(A,tmpc,K,4);
    if(vv2==1){
      set32(pass2,4+npass2*4,sub2);
      npass2=npass2+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass2);
  let q3:i32=0;
  while(q3<npass2){
    ans_append(oans,get32(pass2,4+q3*4));
    q3=q3+1;
  }
  let ns1:i32=need_f(G,1,0);
  let npass1:i32=0;
  let pass1:[]u8=z_alloc(160);
  let q4:i32=0;
  while(q4<nc){
    let sub1:i32=get32(tout,4+q4*4);
    set32(tmpc,0,ns1);
    let j:i32=0;
    while(j<ns1){
      let s1:i32=need_f(G,1,1+j*3);
      if(s1==0){ s1=sub1; }
      set32(tmpc,4+j*12,s1);
      set32(tmpc,4+j*12+4,need_f(G,1,1+j*3+1));
      set32(tmpc,4+j*12+8,need_f(G,1,1+j*3+2));
      j=j+1;
    }
    let vv1:i32=vfy_gen(A,tmpc,K,4);
    if(vv1==1){
      set32(pass1,4+npass1*4,sub1);
      npass1=npass1+1;
    }
    q4=q4+1;
  }
  ans_append(oans,npass1);
  let q5:i32=0;
  while(q5<npass1){
    ans_append(oans,get32(pass1,4+q5*4));
    q5=q5+1;
  }
  let rel3:i32=need_f(G,3,0);
  let cat:[]u8=z_alloc(160);
  let tot:i32=0;
  let q6:i32=0;
  while(q6<npass1){
    set32(cat,4+tot*4,get32(pass1,4+q6*4));
    tot=tot+1;
    q6=q6+1;
  }
  let q7:i32=0;
  while(q7<npass2){
    set32(cat,4+tot*4,get32(pass2,4+q7*4));
    tot=tot+1;
    q7=q7+1;
  }
  let ccd:i32=cnt_gen(A,rel3,cat,4,tot,K,4,seen);
  ans_append(oans,1);
  ans_append(oans,ccd);
  return;
}
// ---- one composite query: learner compose + oracle compare ----
// ---- IHH-INV evidence line: goal tag, cached fam, current fam, ----
// ---- stale need index p (plan order), and the cumulative stale ----
// ---- counter. Printed after every query that may trip the hook.
fn print_ihh_inv(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"IHH-INV goal=");
  c=o_i64(b,c,get32(L,13292) as i64);
  c=o_app(b,c," cached=");
  c=o_i64(b,c,get32(L,13296) as i64);
  c=o_app(b,c," cur=");
  c=o_i64(b,c,get32(L,13300) as i64);
  c=o_app(b,c," need=");
  c=o_i64(b,c,get32(L,13304) as i64);
  c=o_app(b,c," stale=");
  c=o_i64(b,c,get32(L,13288) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- IH-COLLISION: tag-shape collision with the plan-invalidation ----
// ---- hook. Faithful port of C461's demo_collision, with the manual
// ---- clear_plans REMOVED: the hook inside compose must fire instead.
// ---- All tags, rels, objs, goal tags are runtime-derived.
fn demo_collision_hook(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  zero_counters(S);
  setup_worldA(A);
  let tagC:i32=get32(L,12744+0*4);
  let cb0:i32=2000+0*100;
  let avb:[]u8=z_alloc(64);
  vocab_scan(A,avb);
  let relC:i32=get32(avb,0);
  let subjC:i32=first_subj(A,relC);
  let objC:i32=first_obj(A,relC);
  let G0:[]u8=z_alloc(256);
  mk_goal813_E0(G0);
  let gtD:i32=g_tag(G0)+5;
  let G:[]u8=z_alloc(256);
  let o:i32=w_begin(G,gtD,1);
  o=w_need(G,o,tagC,4);
  o=w_f(G,o,1);
  o=w_f(G,o,subjC);
  o=w_f(G,o,relC);
  o=w_f(G,o,objC);
  o=w_links(G,o,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"QD0",3);
  let tr0:i32=try_family(L,A,0,G,0,K,tout,tmpc,seen);
  let tr1:i32=try_family(L,A,1,G,0,K,tout,tmpc,seen);
  let tr2:i32=try_family(L,A,2,G,0,K,tout,tmpc,seen);
  u_invalidate(S,cb0,1,0);
  u_invalidate(S,cb0,1,0);
  u_invalidate(S,cb0,1,0);
  let dcX:i32=sg(S,cb0+10);
  let actX:i32=sg(S,cb0+9);
  let reqX:i32=sg(S,901);
  ss(S,300,2);
  let na9:i32=0;
  if(tr0==1){ jt_acc2(S,na9,tagC,0); na9=na9+1; }
  if(tr1==1){ jt_acc2(S,na9,tagC,1); na9=na9+1; }
  if(tr2==1){ jt_acc2(S,na9,tagC,2); na9=na9+1; }
  ss(S,301,na9);
  let nr9:i32=0;
  if(tr0==0){ jt_rej2(S,nr9,tagC,0); nr9=nr9+1; }
  if(tr1==0){ jt_rej2(S,nr9,tagC,1); nr9=nr9+1; }
  if(tr2==0){ jt_rej2(S,nr9,tagC,2); nr9=nr9+1; }
  ss(S,302,nr9);
  u_revise(S,cb0,1);
  c=o_app(b,c,"ISD-REV tag=");
  c=o_i64(b,c,tagC as i64);
  c=o_app(b,c," probes=3 dc=");
  c=o_i64(b,c,dcX as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,actX as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," nclause=(");
  c=o_i64(b,c,sg(S,cb0+4) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+5) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+7) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+8) as i64);
  c=o_app(b,c,") route1=");
  c=o_i64(b,c,u_check(S,cb0,2,tagC,1,0,0,0,0) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb0,2,tagC,0,0,0,0,0) as i64);
  c=o_app(b,c," route2=");
  c=o_i64(b,c,u_check(S,cb0,2,tagC,2,0,0,0,0) as i64);
  c=o_app(b,c," tr0=");
  c=o_i64(b,c,tr0 as i64);
  c=o_app(b,c," tr1=");
  c=o_i64(b,c,tr1 as i64);
  c=o_app(b,c," tr2=");
  c=o_i64(b,c,tr2 as i64);
  c=o_nl(b,c);
  let o2:i32=w_begin(G,gtD,1);
  o2=w_need(G,o2,tagC,4);
  o2=w_f(G,o2,1);
  o2=w_f(G,o2,subjC);
  o2=w_f(G,o2,relC);
  o2=w_f(G,o2,objC);
  o2=w_links(G,o2,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"QD1",3);
  c=print_ihh_inv(b,c,L);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"QD1R",3);
  c=dump_plans(b,c,L);
  return c;
}
// ---- oracle_rvr: independent all-generic reference for the G1 ----
// ---- 3-need goal. Needs are independent (no links); the plan order
// ---- for a link-free goal is reverse goal order, so records emit
// ---- need2, need1, need0. Dispatch is shape-driven: nf==2 ret_gen,
// ---- nf==7 vfy_gen on the chain. Uses only generic procedures.
fn oracle_rvr(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  set32(oans,0,0);
  let p:i32=0;
  while(p<3){
    let ni:i32=2-p;
    let nf:i32=need_nf(G,ni);
    if(nf==2){
      let tout:[]u8=z_alloc(160);
      let nc:i32=ret_gen(A,need_f(G,ni,0),need_f(G,ni,1),K,4,tout,0);
      ans_append(oans,nc);
      let k:i32=0;
      while(k<nc){
        ans_append(oans,get32(tout,4+k*4));
        k=k+1;
      }
    }
    if(nf==7){
      let tmpc:[]u8=chain_new();
      let ns:i32=need_f(G,ni,0);
      set32(tmpc,0,ns);
      let i:i32=0;
      while(i<ns){
        set32(tmpc,4+i*12,need_f(G,ni,1+i*3));
        set32(tmpc,4+i*12+4,need_f(G,ni,1+i*3+1));
        set32(tmpc,4+i*12+8,need_f(G,ni,1+i*3+2));
        i=i+1;
      }
      let vv:i32=vfy_gen(A,tmpc,K,4);
      ans_append(oans,1);
      ans_append(oans,vv);
    }
    p=p+1;
  }
  return;
}
// ---- clause block for a bound tag: scan the binding table.
fn tag_cb(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,12744+bi*4)==tag){ return 2000+bi*100; }
    bi=bi+1;
  }
  return -1;
}
// ---- 1-need RET-shape goal builder.
fn mk_g1need(G:[]u8,gt:i32,tag:i32,rel:i32,obj:i32)void {
  let o:i32=w_begin(G,gt,1);
  o=w_need(G,o,tag,2); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_links(G,o,0);
  return;
}
// ---- 1-need chain-shape goal builder (revision trials).
fn mk_gchain(G:[]u8,gt:i32,tag:i32,rel:i32,subj:i32,obj:i32)void {
  let o:i32=w_begin(G,gt,1);
  o=w_need(G,o,tag,7); o=w_f(G,o,2);
  o=w_f(G,o,subj); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_f(G,o,subj); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_links(G,o,0);
  return;
}
// ---- G1 goal builder: 3 needs, no links. need0 (t1, RET (rA,oA));
// ---- need1 (t2, chain [(sC,rC,oC),(sC,rC,oC)]); need2 (t3, RET
// ---- (rC,oC)). Plan order for link-free goals is [2,1,0], so the
// ---- t2 need sits at interior plan position p=1.
fn mk_g1(G:[]u8,gt:i32,t1:i32,t2:i32,t3:i32,rA:i32,oA:i32,rC:i32,sC:i32,oC:i32)void {
  let o:i32=w_begin(G,gt,3);
  o=w_need(G,o,t1,2); o=w_f(G,o,rA); o=w_f(G,o,oA);
  o=w_need(G,o,t2,7); o=w_f(G,o,2);
  o=w_f(G,o,sC); o=w_f(G,o,rC); o=w_f(G,o,oC);
  o=w_f(G,o,sC); o=w_f(G,o,rC); o=w_f(G,o,oC);
  o=w_need(G,o,t3,2); o=w_f(G,o,rC); o=w_f(G,o,oC);
  o=w_links(G,o,0);
  return;
}
// ---- G1-PREBIND: induct T2's binding to fam 0 via learn_bindings
// ---- directly (no query, no plan row).
fn stage_g1_prebind(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8,t2:i32,r601:i32,o601:i32,gt:i32)i32 {
  let Gp:[]u8=z_alloc(256);
  mk_g1need(Gp,gt,t2,r601,o601);
  learn_bindings(L,S,A,Gp,K,tout,tmpc,seen);
  c=o_app(b,c,"G1-PREBIND tag=");
  c=o_i64(b,c,t2 as i64);
  c=o_app(b,c," fam=");
  c=o_i64(b,c,bind_fam(L,S,t2) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G1-REVISION: flip T2's binding 0->1 on chain-shape trials.
fn stage_g1_revision(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8,t2:i32,rC:i32,sC:i32,oC:i32,gt:i32)i32 {
  zero_counters(S);
  let Gr:[]u8=z_alloc(256);
  mk_gchain(Gr,gt,t2,rC,sC,oC);
  let cb:i32=tag_cb(L,t2);
  let tr0:i32=try_family(L,A,0,Gr,0,K,tout,tmpc,seen);
  let tr1:i32=try_family(L,A,1,Gr,0,K,tout,tmpc,seen);
  let tr2:i32=try_family(L,A,2,Gr,0,K,tout,tmpc,seen);
  u_invalidate(S,cb,1,0);
  u_invalidate(S,cb,1,0);
  u_invalidate(S,cb,1,0);
  let dcX:i32=sg(S,cb+10);
  let actX:i32=sg(S,cb+9);
  let reqX:i32=sg(S,901);
  ss(S,300,2);
  jt_acc2(S,0,t2,1);
  ss(S,301,1);
  jt_rej2(S,0,t2,0);
  jt_rej2(S,1,t2,2);
  ss(S,302,2);
  u_revise(S,cb,1);
  c=o_app(b,c,"G1-REV tag=");
  c=o_i64(b,c,t2 as i64);
  c=o_app(b,c," probes=3 dc=");
  c=o_i64(b,c,dcX as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,actX as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," route1=");
  c=o_i64(b,c,u_check(S,cb,2,t2,1,0,0,0,0) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb,2,t2,0,0,0,0,0) as i64);
  c=o_app(b,c," route2=");
  c=o_i64(b,c,u_check(S,cb,2,t2,2,0,0,0,0) as i64);
  c=o_app(b,c," tr0=");
  c=o_i64(b,c,tr0 as i64);
  c=o_app(b,c," tr1=");
  c=o_i64(b,c,tr1 as i64);
  c=o_app(b,c," tr2=");
  c=o_i64(b,c,tr2 as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G2-COVREV: revise the RET coverage contract (3000) to admit
// ---- r602 only. Binding contracts are untouched.
fn stage_g2_covrev(b:[]u8,c:i32,L:[]u8,S:[]u8,r601:i32,r602:i32)i32 {
  zero_counters(S);
  let acc:[]u8=z_alloc(64);
  let rej:[]u8=z_alloc(64);
  set32(acc,0,r602);
  set32(rej,0,r601);
  u_invalidate(S,3000,1,0);
  u_invalidate(S,3000,1,0);
  u_invalidate(S,3000,1,0);
  let dcX:i32=sg(S,3000+10);
  let actX:i32=sg(S,3000+9);
  let reqX:i32=sg(S,901);
  jt_load_cov(S,acc,1,rej,1);
  u_revise(S,3000,1);
  c=o_app(b,c,"G2-COVREV dc=");
  c=o_i64(b,c,dcX as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,actX as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," route601=");
  c=o_i64(b,c,u_check(S,3000,1,r601,0,0,0,0,0) as i64);
  c=o_app(b,c," route602=");
  c=o_i64(b,c,u_check(S,3000,1,r602,0,0,0,0,0) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G3-RETIRE: retire T4's clause with 2 disconfirmations (no
// ---- revision latch: pure retirement-without-revision).
fn stage_g3_retire(b:[]u8,c:i32,L:[]u8,S:[]u8,t4:i32)i32 {
  zero_counters(S);
  let cb:i32=tag_cb(L,t4);
  u_invalidate(S,cb,1,0);
  u_invalidate(S,cb,1,0);
  c=o_app(b,c,"G3-RET tag=");
  c=o_i64(b,c,t4 as i64);
  c=o_app(b,c," dc=");
  c=o_i64(b,c,sg(S,cb+10) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,cb+9) as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,sg(S,901) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G3-RESTORE: latch the revision request and re-induct T4->0.
fn stage_g3_restore(b:[]u8,c:i32,L:[]u8,S:[]u8,t4:i32)i32 {
  let cb:i32=tag_cb(L,t4);
  u_invalidate(S,cb,1,0);
  let reqX:i32=sg(S,901);
  ss(S,300,2);
  jt_acc2(S,0,t4,0);
  ss(S,301,1);
  jt_rej2(S,0,t4,1);
  jt_rej2(S,1,t4,2);
  ss(S,302,2);
  u_revise(S,cb,1);
  c=o_app(b,c,"G3-REV tag=");
  c=o_i64(b,c,t4 as i64);
  c=o_app(b,c," dc=");
  c=o_i64(b,c,sg(S,cb+10) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,cb+9) as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb,2,t4,0,0,0,0,0) as i64);
  c=o_app(b,c," route1=");
  c=o_i64(b,c,u_check(S,cb,2,t4,1,0,0,0,0) as i64);
  c=o_app(b,c," route2=");
  c=o_i64(b,c,u_check(S,cb,2,t4,2,0,0,0,0) as i64);
  c=o_nl(b,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(256);
  let ans:[]u8=z_alloc(256);
  let oans:[]u8=z_alloc(256);
  let vbuf:[]u8=z_alloc(32);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let seen:[]u8=z_alloc(320);
  let tmpc:[]u8=z_alloc(512);
  c=o_app(B,c,"STAGE IH-SETUP"); c=o_nl(B,c);
  setup_worldA(A);
  c=run_retep(B,c,L,A,K,rb,tout,0,0);
  c=run_retep(B,c,L,A,K,rb,tout,1,1);
  c=run_retep(B,c,L,A,K,rb,tout,2,2);
  c=run_retep(B,c,L,A,K,rb,tout,3,3);
  specialize_ret(L,S,A,0,3);
  c=run_vfyep(B,c,L,A,K,Cb,0,4);
  c=run_vfyep(B,c,L,A,K,Cb,1,5);
  c=run_vfyep(B,c,L,A,K,Cb,2,6);
  c=run_vfyep(B,c,L,A,K,Cb,3,7);
  specialize_vfy(L,S,A,4,7);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,0,8);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,1,9);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,2,10);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,3,11);
  specialize_cnt(L,S,A,8,11);
  mk_goal813_E0(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"E0",1);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"E0R",1);
  c=o_app(B,c,"IHH-NOFIRE stale=");
  c=o_i64(B,c,get32(L,13288) as i64);
  c=o_nl(B,c);
  c=dump_plans(B,c,L);
  c=o_app(B,c,"STAGE IH-COLLISION"); c=o_nl(B,c);
  c=demo_collision_hook(B,c,L,S,A,K,ans,oans,vbuf,tout,tmpc,seen);
  // ---- runtime-derived tags, rels, objs, goal tags (no literals) ----
  let tagC:i32=get32(L,12744+0*4);
  let t1:i32=tagC+2;
  let t2:i32=tagC+3;
  let t3:i32=tagC+4;
  let t4:i32=tagC+5;
  let avb:[]u8=z_alloc(64);
  vocab_scan(A,avb);
  let r601:i32=get32(avb,0);
  let o601:i32=first_obj(A,r601);
  let r602:i32=get32(avb,1*4);
  let rA:i32=get32(avb,2*4);
  let oA:i32=first_obj(A,rA);
  let rC:i32=get32(avb,3*4);
  let sC:i32=first_subj(A,rC);
  let oC:i32=first_obj(A,rC);
  let g0:[]u8=z_alloc(256);
  mk_goal813_E0(g0);
  let gtG1:i32=g_tag(g0)+7;
  let gtG2:i32=gtG1+1;
  let G1:[]u8=z_alloc(256);
  mk_g1(G1,gtG1,t1,t2,t3,rA,oA,rC,sC,oC);
  let G2:[]u8=z_alloc(256);
  mk_g1need(G2,gtG2,t4,r601,o601);
  c=o_app(B,c,"STAGE G1-PREBIND"); c=o_nl(B,c);
  c=stage_g1_prebind(B,c,L,S,A,K,tout,tmpc,seen,t2,r601,o601,gtG1);
  c=o_app(B,c,"STAGE G1-BUILD"); c=o_nl(B,c);
  c=do_query(B,c,L,S,A,K,G1,ans,oans,vbuf,seen,"G1Q0",4);
  c=o_app(B,c,"STAGE G1-REVISION"); c=o_nl(B,c);
  c=stage_g1_revision(B,c,L,S,A,K,tout,tmpc,seen,t2,rC,sC,oC,gtG1);
  c=o_app(B,c,"STAGE G2-BUILD"); c=o_nl(B,c);
  c=do_query(B,c,L,S,A,K,G2,ans,oans,vbuf,seen,"G2Q0",2);
  c=o_app(B,c,"STAGE G2-COVREV"); c=o_nl(B,c);
  c=stage_g2_covrev(B,c,L,S,r601,r602);
  c=o_app(B,c,"STAGE G2-QUERY"); c=o_nl(B,c);
  c=do_query(B,c,L,S,A,K,G2,ans,oans,vbuf,seen,"G2Q1",2);
  c=o_app(B,c,"G2-NOFIRE stale=");
  c=o_i64(B,c,get32(L,13288) as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"STAGE G1-DELAYED"); c=o_nl(B,c);
  c=do_query(B,c,L,S,A,K,G1,ans,oans,vbuf,seen,"G1Q1",4);
  c=print_ihh_inv(B,c,L);
  c=do_query(B,c,L,S,A,K,G1,ans,oans,vbuf,seen,"G1Q1R",4);
  c=o_app(B,c,"G1-NOFIRE stale=");
  c=o_i64(B,c,get32(L,13288) as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"STAGE G3-RETIRE"); c=o_nl(B,c);
  c=stage_g3_retire(B,c,L,S,t4);
  c=do_query(B,c,L,S,A,K,G1,ans,oans,vbuf,seen,"G1Q1R2",4);
  c=do_query(B,c,L,S,A,K,G2,ans,oans,vbuf,seen,"G2Q1R",2);
  c=print_ihh_inv(B,c,L);
  c=o_app(B,c,"STAGE G3-RESTORE"); c=o_nl(B,c);
  c=stage_g3_restore(B,c,L,S,t4);
  c=do_query(B,c,L,S,A,K,G2,ans,oans,vbuf,seen,"G2Q2",2);
  c=dump_plans(B,c,L);
  c=o_app(B,c,"SUMMARY loads=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," stale=");
  c=o_i64(B,c,get32(L,13288) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}
// ---- oracle_1ret: independent all-generic reference for a single ----
// ---- RETRIEVE need. Answer record matches the learner's [n, ints].
fn oracle_1ret(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  return;
}
// ---- oracle_1vfy: independent all-generic reference for a single ----
// ---- VERIFY need. Answer record matches the learner's [1, vv].

// World C1 (28 facts): adversarial overlapping drift. Rel 701 is new
// (15 facts); fact 0 carries obj 621, which is world A's first 601
// object, so a stale 601 bucket hit on the drifted world returns a
// wrong subject. Rel 601 survives with 8 new facts
// (641+i,601,651+i). Rel 707 is a distractor (5 facts). Rel 602 is
// retired (no facts). Vocab scan order: 701, 601, 707.
fn setup_worldC1(A:[]u8)void {
  set32(A,0,0);
  fact_add(A,711,701,621);
  let i:i32=1;
  while(i<8){
    fact_add(A,711+i,701,721+i);
    fact_add(A,711+i,701,731+i);
    i=i+1;
  }
  let j:i32=0;
  while(j<8){
    fact_add(A,641+j,601,651+j);
    j=j+1;
  }
  let k:i32=0;
  while(k<5){
    fact_add(A,731+k,707,741+k);
    k=k+1;
  }
  return;
}
// ib_module.zag -- ported contract ops for INTEGRATION-B1B2.
//
// Verbatim port of four of the five ops of C443's frozen u_* module
// (subsumption_p0/sp_module.zag, itself byte-copied from C424's
// cu_full.zag lines 55-389): u_induct, u_check, u_invalidate,
// u_revise, plus their helpers. u_grow is EXCLUDED per the minimal
// port (B1/B2 only; grow was not exercised even in C424).
// Function bodies are byte-identical to the source; only this header
// and the sg/ss helpers (carried from sp_base.zag) are added.
//
// The module operates on the dedicated judgment-state array S with
// the frozen fixed slots: judgment table 300-302 / 304+ / 528+,
// global counters 900-925, induct scratch 1200-1209, C_Q at slot 7.
// Contract layout at cbase: +0 CONTRACT_TY, +1 CONTRACT_SET,
// +2 NFIELDS, +3 NCLAUSES, +4+i*8 clause i:
// field,xform,k,lo,hi,active,dc,spare.
// xform 0 = identity, 1 = integer divide by k, 2 = remainder mod k.
//
// In this lane the module governs the composer's binding layer:
// one binding contract per need tag over [tag, fam] (nf=2) at
// 2000+bi*100 (B1), and one coverage contract per procedure family
// over [rel] (nf=1) at 3000/3100/3200 (B2).
fn sg(S:[]u8,i:i32)i32 { return get32(S,i*4); }
fn ss(S:[]u8,i:i32,v:i32)void { set32(S,i*4,v); return; }
fn u_feat_xf(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 1;} if(p==3){return 1;} if(p==5){return 1;}
  if(p==7){return 1;} if(p==9){return 1;}
  return 2;
}
fn u_feat_k(p:i32)i32 {
  if(p==0){return 0;}
  if(p==1){return 2;} if(p==2){return 2;}
  if(p==3){return 4;} if(p==4){return 4;}
  if(p==5){return 8;} if(p==6){return 8;}
  if(p==7){return 16;} if(p==8){return 16;}
  return 32;
}
fn u_feat_val(v:i32,p:i32)i32 {
  let xf:i32=u_feat_xf(p);
  let k:i32=u_feat_k(p);
  if(xf==1){ return v/k; }
  if(xf==2){ return v-(v/k)*k; }
  return v;
}
fn u_fval(f:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(f==0){return f0;}
  if(f==1){return f1;}
  if(f==2){return f2;}
  if(f==3){return f3;}
  if(f==4){return f4;}
  return f5;
}
fn u_acc(S:[]u8,j:i32,f:i32)i32 { return sg(S,304+j*7+1+f); }
fn u_rej(S:[]u8,j:i32,f:i32)i32 { return sg(S,528+j*7+1+f); }
fn u_rejlen(S:[]u8,j:i32)i32 { return sg(S,528+j*7); }

// check: 1 iff nf matches and at least one active clause holds and
// every active clause holds; 0 otherwise (empty active set judges 0).
fn u_check(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let any:i32=0;
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    if(sg(S,b+5)==1){
      any=1;
      let field:i32=sg(S,b);
      let xf:i32=sg(S,b+1);
      let k:i32=sg(S,b+2);
      let lo:i32=sg(S,b+3);
      let hi:i32=sg(S,b+4);
      let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
      if(xf==1){ v=v/k; }
      if(xf==2){ v=v-(v/k)*k; }
      if(v<lo){return 0;}
      if(v>hi){return 0;}
    }
    i=i+1;
  }
  if(any==0){return 0;}
  return 1;
}

// check_all: same but over all committed clauses (ignores active).
fn u_check_all(S:[]u8,cbase:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,f4:i32,f5:i32)i32 {
  if(nf!=sg(S,cbase+2)){return 0;}
  let n:i32=sg(S,cbase+3);
  let i:i32=0;
  while(i<n){
    let b:i32=cbase+4+i*8;
    let field:i32=sg(S,b);
    let xf:i32=sg(S,b+1);
    let k:i32=sg(S,b+2);
    let lo:i32=sg(S,b+3);
    let hi:i32=sg(S,b+4);
    let v:i32=u_fval(field,f0,f1,f2,f3,f4,f5);
    if(xf==1){ v=v/k; }
    if(xf==2){ v=v-(v/k)*k; }
    if(v<lo){return 0;}
    if(v>hi){return 0;}
    i=i+1;
  }
  return 1;
}

fn u_write_clause(S:[]u8,cbase:i32,i:i32,f:i32,p:i32,mn:i32,mx:i32)void {
  let b:i32=cbase+4+i*8;
  ss(S,b,f); ss(S,b+1,u_feat_xf(p)); ss(S,b+2,u_feat_k(p));
  ss(S,b+3,mn); ss(S,b+4,mx); ss(S,b+5,1); ss(S,b+6,0); ss(S,b+7,0);
  return;
}

// errors of the committed clause set on the judgment table.
fn u_fiterr(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  let err:i32=0;
  let j:i32=0;
  while(j<na){
    if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
    j=j+1;
  }
  let r:i32=0;
  while(r<nr){
    if(u_rejlen(S,r)==nf){
      if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
    }
    r=r+1;
  }
  return err;
}

// induct: minimal-commitment search. Increasing cardinality (1, then
// 2); valid = conjunction rejects every in-scope reject (len ==
// nf); among valid sets prefer fewer clauses, then maximal total
// accept-region width (least committal), then lexicographic order.
fn u_induct(S:[]u8,cbase:i32)i32 {
  let nf:i32=sg(S,300);
  let na:i32=sg(S,301);
  let nr:i32=sg(S,302);
  if(na==0){return 0;}
  if(nf<1){return 0;}
  ss(S,1200,-1); ss(S,1201,-1); ss(S,1202,0); ss(S,1203,0);
  ss(S,1204,-1); ss(S,1205,0);
  ss(S,1206,-1); ss(S,1207,-1); ss(S,1208,0); ss(S,1209,0);
  let f:i32=0;
  while(f<nf){
    let p:i32=0;
    while(p<11){
      let mn:i32=999999999;
      let mx:i32=-999999999;
      let j:i32=0;
      while(j<na){
        let fv:i32=u_feat_val(u_acc(S,j,f),p);
        if(fv<mn){mn=fv;}
        if(fv>mx){mx=fv;}
        j=j+1;
      }
      let valid:i32=1;
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          let fv2:i32=u_feat_val(u_rej(S,r,f),p);
          if(fv2>=mn){
            if(fv2<=mx){valid=0;}
          }
        }
        r=r+1;
      }
      if(valid==1){
        let w:i32=mx-mn;
        if(w>sg(S,1204)){
          ss(S,1204,w); ss(S,1200,f); ss(S,1201,p);
          ss(S,1202,mn); ss(S,1203,mx); ss(S,1205,1);
        }
      }
      p=p+1;
    }
    f=f+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,1);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  ss(S,1204,-1); ss(S,1205,0);
  let np:i32=nf*11;
  let a:i32=0;
  while(a<np){
    let bb:i32=a+1;
    while(bb<np){
      let fa:i32=a/11; let pa:i32=a-fa*11;
      let fb:i32=bb/11; let pb:i32=bb-fb*11;
      let mn0:i32=999999999; let mx0:i32=-999999999;
      let mn1:i32=999999999; let mx1:i32=-999999999;
      let j2:i32=0;
      while(j2<na){
        let v0:i32=u_feat_val(u_acc(S,j2,fa),pa);
        if(v0<mn0){mn0=v0;}
        if(v0>mx0){mx0=v0;}
        let v1:i32=u_feat_val(u_acc(S,j2,fb),pb);
        if(v1<mn1){mn1=v1;}
        if(v1>mx1){mx1=v1;}
        j2=j2+1;
      }
      let valid2:i32=1;
      let r2:i32=0;
      while(r2<nr){
        if(u_rejlen(S,r2)==nf){
          let h0:i32=0;
          let h1:i32=0;
          let w0:i32=u_feat_val(u_rej(S,r2,fa),pa);
          if(w0<mn0){h0=1;}
          if(w0>mx0){h0=1;}
          let w1:i32=u_feat_val(u_rej(S,r2,fb),pb);
          if(w1<mn1){h1=1;}
          if(w1>mx1){h1=1;}
          if(h0==0){
            if(h1==0){valid2=0;}
          }
        }
        r2=r2+1;
      }
      if(valid2==1){
        let wsum:i32=(mx0-mn0)+(mx1-mn1);
        if(wsum>sg(S,1204)){
          ss(S,1204,wsum);
          ss(S,1200,fa); ss(S,1201,pa); ss(S,1202,mn0); ss(S,1203,mx0);
          ss(S,1206,fb); ss(S,1207,pb); ss(S,1208,mn1); ss(S,1209,mx1);
          ss(S,1205,1);
        }
      }
      bb=bb+1;
    }
    a=a+1;
  }
  if(sg(S,1205)==1){
    u_write_clause(S,cbase,0,sg(S,1200),sg(S,1201),sg(S,1202),sg(S,1203));
    u_write_clause(S,cbase,1,sg(S,1206),sg(S,1207),sg(S,1208),sg(S,1209));
    ss(S,cbase,7); ss(S,cbase+1,1); ss(S,cbase+2,nf); ss(S,cbase+3,2);
    ss(S,920,u_fiterr(S,cbase));
    return 1;
  }
  return 0;
}
// invalidate: compare judgment vs consequence. Failure bumps the
// contract fail run and every active clause's disconfirmation
// counter; a clause reaching 2 consecutive disconfirmations is
// retired. Three consecutive failures latch the revision request.
fn u_invalidate(S:[]u8,cbase:i32,judgment:i32,consequence:i32)i32 {
  let ok:i32=0;
  if(judgment==consequence){ok=1;}
  ss(S,916,sg(S,916)+1);
  if(ok==1){ ss(S,912,sg(S,912)+1); }
  if(sg(S,cbase+1)==1){
    if(ok==1){
      ss(S,900,0);
      let n:i32=sg(S,cbase+3);
      let i:i32=0;
      while(i<n){
        let b:i32=cbase+4+i*8;
        if(sg(S,b+5)==1){ ss(S,b+6,0); }
        i=i+1;
      }
    }
    if(ok==0){
      ss(S,900,sg(S,900)+1);
      let n2:i32=sg(S,cbase+3);
      let i2:i32=0;
      while(i2<n2){
        let b2:i32=cbase+4+i2*8;
        if(sg(S,b2+5)==1){
          let dc:i32=sg(S,b2+6)+1;
          ss(S,b2+6,dc);
          if(dc>=2){ ss(S,b2+5,0); }
        }
        i2=i2+1;
      }
      if(sg(S,900)>=3){
        if(sg(S,901)==0){
          ss(S,901,1);
          if(sg(S,908)<0){ ss(S,908,sg(S,7)); }
        }
      }
    }
  }
  return ok;
}

// revise: on a latched request (and enable), score the committed
// clause set on the judgment table, re-induct, count the revision.
fn u_revise(S:[]u8,cbase:i32,enabled:i32)void {
  if(sg(S,901)==1){
    if(enabled==1){
      let nf:i32=sg(S,300);
      let na:i32=sg(S,301);
      let nr:i32=sg(S,302);
      let err:i32=0;
      let j:i32=0;
      while(j<na){
        if(u_check_all(S,cbase,nf,u_acc(S,j,0),u_acc(S,j,1),u_acc(S,j,2),u_acc(S,j,3),u_acc(S,j,4),u_acc(S,j,5))==0){err=err+1;}
        j=j+1;
      }
      let r:i32=0;
      while(r<nr){
        if(u_rejlen(S,r)==nf){
          if(u_check_all(S,cbase,nf,u_rej(S,r,0),u_rej(S,r,1),u_rej(S,r,2),u_rej(S,r,3),u_rej(S,r,4),u_rej(S,r,5))==1){err=err+1;}
        }
        r=r+1;
      }
      ss(S,924,err);
      let ui2:i32=u_induct(S,cbase);
      ss(S,904,sg(S,904)+1);
      let ui2b:i32=ui2;
      ss(S,925,ui2b);
      ss(S,901,0);
      ss(S,900,0);
    }
  }
  return;
}

// ib_learn.zag -- learner-owned procedures and learner-driven composition
// with the C443 B1/B2 contracts integrated at the binding layer.
//
// Base: COGOPS-DIAMOND's c4_learn.zag (diamond plans, topo assembly,
// procedure bodies, oracles unchanged). The integration changes:
// (B1) the BIND trial-count table is replaced by per-tag admission
// contracts over [tag, fam] (u_induct from trial outcomes, u_check
// for routing, u_invalidate/u_revise for revision); L+12744 is now a
// tag directory and the bindings live at 2000+bi*100 in the judgment
// state S. (B2) version selection consults coverage admission
// contracts over [rel] at 3000/3100/3200 (inducted at specialize
// time from episode-logged relations vs the world rel vocabulary)
// instead of the coverage-membership tests.
// Learner-state L (16384 bytes):
//   RET region: 0: ret_nrel; 4: ret_rel_ids[16]; 68: ret_cnt[16];
//     132: ret_fidx[16][64]; 4228: ret_prov_parent (=0); 4232: ep0;
//     4236: ep1; 4240: nfacts; 4244: rev.
//   VFY region: 4248: vfy_nrel; 4252: vfy_rel_ids[16]; 4316: vfy_cnt[16];
//     4380: vfy_fidx[16][64]; 8476: vfy_prov_parent (=1); 8480: ep0;
//     8484: ep1; 8488: nfacts; 8492: rev.
//   CNT region: 8496: cnt_nrel; 8500: cnt_rel_ids[16]; 8564: cnt_cnt[16];
//     8628: cnt_fidx[16][64]; 12724: cnt_prov_parent (=4); 12728: ep0;
//     12732: ep1; 12736: nfacts; 12740: rev.
//   Tag directory at 12744: 8 entries x 4 bytes (need tag per slot).
//   PLAN table at 13000: 4 entries x 56 bytes:
//     [goal_tag, nneeds, idx0, tag0, fam0, idx1, tag1, fam1,
//      idx2, tag2, fam2, idx3, tag3, fam3].
//   Stats at 13224: plans_built, plans_loaded, trials, declines, agree,
//     cs, cg, ret_spec_uses, ret_gen_uses, vfy_spec_uses, vfy_gen_uses,
//     cnt_spec_uses, cnt_gen_uses.
// Judgment-state S (16384 bytes, separate array): the u_* module's
// fixed slots (judgment table 300-302/304+/528+, counters 900-925,
// induct scratch 1200-1209, C_Q at 7); binding contracts at
// 2000+bi*100; coverage contracts at 3000 (RET), 3100 (VFY),
// 3200 (CNT).
//
// No world literals appear in this file: no goal tags, no need tags, no
// relation ids, no plan sequences. All content arrives at runtime through
// episodes, trials, goal records, and contract/vocab reads.
// ---- retrieve working set ----
fn ret_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,0);
  let i:i32=0;
  while(i<n){
    if(get32(L,4+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn ret_cov_has(L:[]u8,r:i32)i32 {
  if(ret_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn ret_log_rel(L:[]u8,r:i32)void {
  if(ret_cov_find(L,r)<0){
    let n:i32=get32(L,0);
    if(n<16){ set32(L,4+n*4,r); set32(L,0,n+1); }
  }
  return;
}
fn ret_cov_clear(L:[]u8,S:[]u8)void { set32(L,0,0); ss(S,3000+1,0); return; }
// ---- verify working set ----
fn vfy_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,4248);
  let i:i32=0;
  while(i<n){
    if(get32(L,4252+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn vfy_cov_has(L:[]u8,r:i32)i32 {
  if(vfy_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn vfy_log_rel(L:[]u8,r:i32)void {
  if(vfy_cov_find(L,r)<0){
    let n:i32=get32(L,4248);
    if(n<16){ set32(L,4252+n*4,r); set32(L,4248,n+1); }
  }
  return;
}
fn vfy_cov_clear(L:[]u8,S:[]u8)void { set32(L,4248,0); ss(S,3100+1,0); return; }
// ---- count working set ----
fn cnt_cov_find(L:[]u8,r:i32)i32 {
  let n:i32=get32(L,8496);
  let i:i32=0;
  while(i<n){
    if(get32(L,8500+i*4)==r){ return i; }
    i=i+1;
  }
  return -1;
}
fn cnt_cov_has(L:[]u8,r:i32)i32 {
  if(cnt_cov_find(L,r)<0){ return 0; }
  return 1;
}
fn cnt_log_rel(L:[]u8,r:i32)void {
  if(cnt_cov_find(L,r)<0){
    let n:i32=get32(L,8496);
    if(n<16){ set32(L,8500+n*4,r); set32(L,8496,n+1); }
  }
  return;
}
fn cnt_cov_clear(L:[]u8,S:[]u8)void { set32(L,8496,0); ss(S,3200+1,0); return; }
// ---- specialize_ret: build the learner-owned indexed RETRIEVE ----
fn specialize_ret(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,4228,0);
  set32(L,4232,ep0);
  set32(L,4236,ep1);
  set32(L,4240,nf);
  set32(L,4244,get32(L,4244)+1);
  cov_induct(S,A,3000,L,0,4);
  return;
}
// ---- specialize_vfy: build the learner-owned indexed VERIFY ----
fn specialize_vfy(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,4316+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=vfy_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,4316+bi*4);
      if(c0<64){
        set32(L,4380+(bi*64+c0)*4,j);
        set32(L,4316+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,8476,1);
  set32(L,8480,ep0);
  set32(L,8484,ep1);
  set32(L,8488,nf);
  set32(L,8492,get32(L,8492)+1);
  cov_induct(S,A,3100,L,4248,4252);
  return;
}
// ---- specialize_cnt: build the learner-owned indexed COUNT ----
// One linear pass over all facts; each fact whose relation is in the
// count working set is appended to that relation's bucket.
fn specialize_cnt(L:[]u8,S:[]u8,A:[]u8,ep0:i32,ep1:i32)void {
  let i:i32=0;
  while(i<16){ set32(L,8564+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=cnt_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,8564+bi*4);
      if(c0<64){
        set32(L,8628+(bi*64+c0)*4,j);
        set32(L,8564+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  set32(L,12724,4);
  set32(L,12728,ep0);
  set32(L,12732,ep1);
  set32(L,12736,nf);
  set32(L,12740,get32(L,12740)+1);
  cov_induct(S,A,3200,L,8496,8500);
  return;
}
// ---- ret_spec: the learner-owned specialized RETRIEVE (id 2) ----
fn ret_spec(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,ko:i32,out:[]u8,oo:i32)i32 {
  let bi:i32=ret_cov_find(L,rel);
  if(bi<0){ return -1; }
  let n:i32=get32(L,68+bi*4);
  let ns:i32=0;
  let k:i32=0;
  while(k<n){
    set32(kb,ko,get32(kb,ko)+1);
    let j:i32=get32(L,132+(bi*64+k)*4);
    let fo:i32=get32(A,4+j*12+8);
    if(fo==obj){
      let fs:i32=get32(A,4+j*12);
      if(ns<32){ set32(out,oo+4+ns*4,fs); }
      ns=ns+1;
    }
    k=k+1;
  }
  set32(out,oo,ns);
  return ns;
}
// ---- vfy_spec: the learner-owned specialized VERIFY (id 3) ----
fn vfy_spec(L:[]u8,A:[]u8,C:[]u8,kb:[]u8,ko:i32)i32 {
  let ns:i32=get32(C,0);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(C,4+i*12);
    let r:i32=get32(C,4+i*12+4);
    let o:i32=get32(C,4+i*12+8);
    let bi:i32=vfy_cov_find(L,r);
    if(bi<0){ return -1; }
    let n:i32=get32(L,4316+bi*4);
    let hit:i32=0;
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,4380+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fr:i32=get32(A,4+j*12+4);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==s){
        if(fr==r){
          if(fo==o){ hit=1; }
        }
      }
      k=k+1;
    }
    if(hit==0){ ok=0; }
    i=i+1;
  }
  return ok;
}
// ---- cnt_spec: the learner-owned specialized COUNT (id 5) ----
// For each subject, scans only the learned bucket for the relation and
// collects distinct objects. Returns -1 if the relation is outside the
// learned coverage.
fn cnt_spec(L:[]u8,A:[]u8,rel:i32,sb:[]u8,so:i32,nsubs:i32,kb:[]u8,ko:i32,seen:[]u8)i32 {
  let bi:i32=cnt_cov_find(L,rel);
  if(bi<0){ return -1; }
  set32(seen,0,0);
  let n:i32=get32(L,8564+bi*4);
  let si:i32=0;
  while(si<nsubs){
    let subj:i32=get32(sb,so+si*4);
    let k:i32=0;
    while(k<n){
      set32(kb,ko,get32(kb,ko)+1);
      let j:i32=get32(L,8628+(bi*64+k)*4);
      let fs:i32=get32(A,4+j*12);
      let fo:i32=get32(A,4+j*12+8);
      if(fs==subj){
        let nsn:i32=get32(seen,0);
        let f:i32=0;
        let dup:i32=0;
        while(f<nsn){
          if(get32(seen,4+f*4)==fo){ dup=1; }
          f=f+1;
        }
        if(dup==0){
          if(nsn<64){
            set32(seen,4+nsn*4,fo);
            set32(seen,0,nsn+1);
          }
        }
      }
      k=k+1;
    }
    si=si+1;
  }
  return get32(seen,0);
}
// ---- episodes: experience steps ----
fn ret_episode(L:[]u8,A:[]u8,rel:i32,obj:i32,kb:[]u8,tout:[]u8)i32 {
  ret_log_rel(L,rel);
  return ret_gen(A,rel,obj,kb,12,tout,0);
}
fn vfy_episode(L:[]u8,A:[]u8,C:[]u8,kb:[]u8)i32 {
  let ns:i32=get32(C,0);
  let i:i32=0;
  while(i<ns){
    vfy_log_rel(L,get32(C,4+i*12+4));
    i=i+1;
  }
  return vfy_gen(A,C,kb,12);
}
fn cnt_episode(L:[]u8,A:[]u8,rel:i32,subj:i32,kb:[]u8,tout:[]u8,seen:[]u8)i32 {
  cnt_log_rel(L,rel);
  set32(tout,0,subj);
  return cnt_gen(A,rel,tout,0,1,kb,12,seen);
}
// ---- per-need version selection from coverage ADMISSION CONTRACTS ----
// ---- (B2): the contract, not the membership test, decides. ----
// RET coverage contract at 3000; VFY at 3100; CNT at 3200.
fn ret_version(L:[]u8,S:[]u8,rel:i32)i32 {
  if(u_check(S,3000,1,rel,0,0,0,0,0)==1){ return 2; }
  return 0;
}
fn vfy_version(L:[]u8,S:[]u8,W:[]u8,n:i32)i32 {
  let ns:i32=get32(W,n*80+4);
  let ok:i32=1;
  let i:i32=0;
  while(i<ns){
    let r:i32=get32(W,n*80+4+(2+i*3)*4);
    if(u_check(S,3100,1,r,0,0,0,0,0)==0){ ok=0; }
    i=i+1;
  }
  if(ok==1){ return 3; }
  return 1;
}
fn cnt_version(L:[]u8,S:[]u8,rel:i32)i32 {
  if(u_check(S,3200,1,rel,0,0,0,0,0)==1){ return 5; }
  return 4;
}
// ---- goal record parsing (generic; no literals) ----
// G: 0: goal_tag; 4: nneeds; needs from 8: [need_tag, nfields, fields...];
// then nlinks; then links, 28 bytes each:
// [kind, dst_need, dst_kind, dst_slot, src_need, src_kind, src_slot].
fn g_tag(G:[]u8)i32 { return get32(G,0); }
fn g_nneeds(G:[]u8)i32 { return get32(G,4); }
fn need_off(G:[]u8,n:i32)i32 {
  let off:i32=8;
  let k:i32=0;
  while(k<n){
    let nf:i32=get32(G,off+4);
    off=off+8+nf*4;
    k=k+1;
  }
  return off;
}
fn need_tag(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)); }
fn need_nf(G:[]u8,n:i32)i32 { return get32(G,need_off(G,n)+4); }
fn need_f(G:[]u8,n:i32,f:i32)i32 { return get32(G,need_off(G,n)+8+f*4); }
fn g_linkbase(G:[]u8)i32 { return need_off(G,get32(G,4)); }
fn g_nlinks(G:[]u8)i32 { return get32(G,g_linkbase(G)); }
fn link_w(G:[]u8,l:i32,w:i32)i32 {
  return get32(G,g_linkbase(G)+4+l*28+w*4);
}
// ---- working inputs: W holds per-need [nf, f0, ...] at W+n*80 ----
fn mat_inputs(G:[]u8,W:[]u8)void {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let nf:i32=need_nf(G,n);
    set32(W,n*80,nf);
    let f:i32=0;
    while(f<nf){
      set32(W,n*80+4+f*4,need_f(G,n,f));
      f=f+1;
    }
    n=n+1;
  }
  return;
}
// ---- topological order over links (Kahn; nneeds <= 3) ----
fn topo(G:[]u8,ord:[]u8)void {
  let nn:i32=g_nneeds(G);
  let nl:i32=g_nlinks(G);
  let ind:[]u8=z_alloc(16);
  let placed:[]u8=z_alloc(16);
  let n:i32=0;
  while(n<nn){ set32(ind,n*4,0); set32(placed,n*4,0); n=n+1; }
  let l:i32=0;
  while(l<nl){
    let d:i32=link_w(G,l,1);
    let s:i32=link_w(G,l,4);
    if(s!=d){ set32(ind,d*4,get32(ind,d*4)+1); }
    l=l+1;
  }
  let p:i32=0;
  while(p<nn){
    let n2:i32=0;
    let fnd:i32=0;
    while(n2<nn){
      if(get32(placed,n2*4)==0){
        if(get32(ind,n2*4)==0){ fnd=n2; }
      }
      n2=n2+1;
    }
    set32(placed,fnd*4,1);
    set32(ord,p*4,fnd);
    let l2:i32=0;
    while(l2<nl){
      let d2:i32=link_w(G,l2,1);
      let s2:i32=link_w(G,l2,4);
      if(s2==fnd){
        if(d2!=fnd){ set32(ind,d2*4,get32(ind,d2*4)-1); }
      }
      l2=l2+1;
    }
    p=p+1;
  }
  return;
}
// ---- fan-out source: need with an incoming kind-2 link, else -1 ----
fn fanin_src(G:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==2){
      if(link_w(G,l,1)==ni){ return link_w(G,l,4); }
    }
    l=l+1;
  }
  return -1;
}
// ---- apply incoming kind-1 (scalar copy) links to need ni ----
fn apply_kind1(G:[]u8,W:[]u8,OUTS:[]u8,ni:i32)void {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  while(l<nl){
    let hit:i32=0;
    if(link_w(G,l,0)==1){
      if(link_w(G,l,1)==ni){ hit=1; }
    }
    if(hit==1){
      let ds:i32=link_w(G,l,3);
      let sn:i32=link_w(G,l,4);
      let sk:i32=link_w(G,l,5);
      let ss:i32=link_w(G,l,6);
      let v:i32=0;
      if(sk==0){ v=get32(W,sn*80+4+ss*4); }
      if(sk==1){ v=get32(OUTS,sn*160+4+ss*4); }
      set32(W,ni*80+4+ds*4,v);
    }
    l=l+1;
  }
  return;
}
// ---- apply incoming kind-3 (aggregate subject-list) links to need ni ----
// GENERALIZED (preregistered, Section 2.4): subjects from ALL incoming
// kind-3 links concatenate in goal-record link order into SUBL[ni*128].
// On a chain (one incoming kind-3 link) this is byte-identical to the
// C422 behavior; on a diamond (two or more sources) it is the generic
// fan-in reading. No goal-shape test, no branch count: the same link
// kind applies uniformly to any DAG.
// Returns 1 if at least one kind-3 link targeted ni, else 0.
fn apply_kind3(G:[]u8,OUTS:[]u8,SUBL:[]u8,ni:i32)i32 {
  let nl:i32=g_nlinks(G);
  let l:i32=0;
  let tot:i32=0;
  let found:i32=0;
  while(l<nl){
    if(link_w(G,l,0)==3){
      if(link_w(G,l,1)==ni){
        let sn:i32=link_w(G,l,4);
        let n:i32=get32(OUTS,sn*160);
        let k:i32=0;
        while(k<n){
          set32(SUBL,ni*128+4+tot*4,get32(OUTS,sn*160+4+k*4));
          tot=tot+1;
          k=k+1;
        }
        found=1;
      }
    }
    l=l+1;
  }
  if(found==1){
    set32(SUBL,ni*128,tot);
    return 1;
  }
  return 0;
}
// ---- binding contracts (B1): trial-learned bindings as per-tag ----
// ---- admission contracts. L+12744 is a tag directory (8 x 4 bytes);
// ---- the binding itself is the contract at 2000+bi*100 in S over
// ---- [tag, fam] (nf=2), inducted from trial outcomes, revisable via
// ---- u_invalidate / u_revise. ----
fn bind_off(bi:i32)i32 { return 12744+bi*4; }
fn bind_cb(bi:i32)i32 { return 2000+bi*100; }
fn bind_find(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==tag){ return bi; }
    bi=bi+1;
  }
  return -1;
}
fn bind_new(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,bind_off(bi))==0){
      set32(L,bind_off(bi),tag);
      return bi;
    }
    bi=bi+1;
  }
  return -1;
}
fn bind_committed(S:[]u8,bi:i32)i32 { return sg(S,bind_cb(bi)+1); }
// The bound family, read through the admission contract: the first
// fam admitted by u_check wins; -1 when the contract abstains
// (never inducted, or all clauses retired).
fn bind_fam(L:[]u8,S:[]u8,tag:i32)i32 {
  let bi:i32=bind_find(L,tag);
  if(bi<0){ return -1; }
  let cb:i32=bind_cb(bi);
  let fam:i32=0;
  while(fam<3){
    if(u_check(S,cb,2,tag,fam,0,0,0,0)==1){ return fam; }
    fam=fam+1;
  }
  return -1;
}
// ---- judgment-table loaders ----
// Accept row (len 2): [tag, fam] at 304+j*7. Reject row at 528+r*7.
fn jt_acc2(S:[]u8,j:i32,tag:i32,fam:i32)void {
  ss(S,304+j*7,2);
  ss(S,304+j*7+1,tag);
  ss(S,304+j*7+2,fam);
  return;
}
fn jt_rej2(S:[]u8,r:i32,tag:i32,fam:i32)void {
  ss(S,528+r*7,2);
  ss(S,528+r*7+1,tag);
  ss(S,528+r*7+2,fam);
  return;
}
// Load a coverage table (nf=1): accepts and rejects are rel-id lists.
fn jt_load_cov(S:[]u8,acc:[]u8,na:i32,rej:[]u8,nr:i32)void {
  ss(S,300,1); ss(S,301,na); ss(S,302,nr);
  let j:i32=0;
  while(j<na){
    ss(S,304+j*7,1);
    ss(S,304+j*7+1,get32(acc,j*4));
    j=j+1;
  }
  let r:i32=0;
  while(r<nr){
    ss(S,528+r*7,1);
    ss(S,528+r*7+1,get32(rej,r*4));
    r=r+1;
  }
  return;
}
// ---- world relation vocabulary: distinct rel ids in fact order ----
// Generic observation machinery: no literals, no world knowledge.
fn vocab_scan(A:[]u8,out:[]u8)i32 {
  let n:i32=0;
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let k:i32=0;
    let seen:i32=0;
    while(k<n){
      if(get32(out,k*4)==r){ seen=1; }
      k=k+1;
    }
    if(seen==0){
      if(n<16){
        set32(out,n*4,r);
        n=n+1;
      }
    }
    j=j+1;
  }
  return n;
}
// First object observed with relation rel in the world (-1 if none).
fn first_obj(A:[]u8,rel:i32)i32 {
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    if(get32(A,4+j*12+4)==rel){ return get32(A,4+j*12+8); }
    j=j+1;
  }
  return -1;
}
// ---- coverage induct (B2): accepts = the episode-logged relations ----
// ---- at L+rels_off (count at L+nrel_off); rejects = the current ----
// ---- world's relation vocabulary minus the accepts. ----
fn cov_induct(S:[]u8,A:[]u8,cbase:i32,L:[]u8,nrel_off:i32,rels_off:i32)void {
  let n:i32=get32(L,nrel_off);
  let vb:[]u8=z_alloc(64);
  let nv:i32=vocab_scan(A,vb);
  let rj:[]u8=z_alloc(64);
  let nr:i32=0;
  let v:i32=0;
  while(v<nv){
    let rv:i32=get32(vb,v*4);
    let a:i32=0;
    let hit:i32=0;
    while(a<n){
      if(get32(L,rels_off+a*4)==rv){ hit=1; }
      a=a+1;
    }
    if(hit==0){
      set32(rj,nr*4,rv);
      nr=nr+1;
    }
    v=v+1;
  }
  let ac:[]u8=z_alloc(64);
  let a2:i32=0;
  while(a2<n){
    set32(ac,a2*4,get32(L,rels_off+a2*4));
    a2=a2+1;
  }
  jt_load_cov(S,ac,n,rj,nr);
  u_induct(S,cbase);
  return;
}
// ---- try one procedure family on one need; 1 = consumed, 0 = refused ----
// Family 0 (RETRIEVE) accepts exactly 2-field needs (its arity).
// Family 1 (VERIFY) accepts records shaped as chains.
// Family 2 (COUNT) accepts exactly 3-field needs [rel, aggop, subj]
// with aggop == 1 (distinct-object count).
fn try_family(L:[]u8,A:[]u8,fam:i32,G:[]u8,n:i32,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nf:i32=need_nf(G,n);
  if(fam==0){
    if(nf==2){
      ret_gen(A,need_f(G,n,0),need_f(G,n,1),K,8,tout,0);
      return 1;
    }
    return 0;
  }
  if(fam==1){
    if(nf>=4){
      let ns:i32=need_f(G,n,0);
      if(ns>=1){
        if(ns<=16){
          if(nf==1+ns*3){
            set32(tmpc,0,ns);
            let i:i32=0;
            while(i<ns){
              set32(tmpc,4+i*12,need_f(G,n,1+i*3));
              set32(tmpc,4+i*12+4,need_f(G,n,1+i*3+1));
              set32(tmpc,4+i*12+8,need_f(G,n,1+i*3+2));
              i=i+1;
            }
            vfy_gen(A,tmpc,K,8);
            return 1;
          }
        }
      }
    }
    return 0;
  }
  if(nf==3){
    let ag:i32=need_f(G,n,1);
    if(ag==1){
      set32(tout,0,need_f(G,n,2));
      cnt_gen(A,need_f(G,n,0),tout,0,1,K,8,seen);
      return 1;
    }
  }
  return 0;
}
// ---- learn bindings for all unbound need tags in the goal ----
// Trials run as before (same try_family calls, same trials stat);
// then ONE admission contract per tag is inducted from the trial
// outcomes (B1). Returns 1 iff every need tag ends bound; 0 if any
// need is unbindable (contract abstention -> decline).
fn learn_bindings(L:[]u8,S:[]u8,A:[]u8,G:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  let nn:i32=g_nneeds(G);
  let n:i32=0;
  while(n<nn){
    let tag:i32=need_tag(G,n);
    let bi:i32=bind_find(L,tag);
    if(bi<0){ bi=bind_new(L,tag); }
    if(bind_committed(S,bi)==0){
      let r0:i32=0;
      let r1:i32=0;
      let r2:i32=0;
      let fam:i32=0;
      while(fam<3){
        set32(L,13232,get32(L,13232)+1);
        let r:i32=try_family(L,A,fam,G,n,K,tout,tmpc,seen);
        if(fam==0){ r0=r; }
        if(fam==1){ r1=r; }
        if(fam==2){ r2=r; }
        fam=fam+1;
      }
      ss(S,300,2);
      let na:i32=0;
      if(r0==1){ jt_acc2(S,na,tag,0); na=na+1; }
      if(r1==1){ jt_acc2(S,na,tag,1); na=na+1; }
      if(r2==1){ jt_acc2(S,na,tag,2); na=na+1; }
      ss(S,301,na);
      let nr:i32=0;
      if(r0==0){ jt_rej2(S,nr,tag,0); nr=nr+1; }
      if(r1==0){ jt_rej2(S,nr,tag,1); nr=nr+1; }
      if(r2==0){ jt_rej2(S,nr,tag,2); nr=nr+1; }
      ss(S,302,nr);
      u_induct(S,bind_cb(bi));
    }
    n=n+1;
  }
  let m:i32=0;
  while(m<nn){
    if(bind_fam(L,S,need_tag(G,m))<0){ return 0; }
    m=m+1;
  }
  return 1;
}
// ---- plan table ----
fn plan_find(L:[]u8,gtag:i32)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==gtag){ return pi; }
    pi=pi+1;
  }
  return -1;
}
fn plan_new(L:[]u8,S:[]u8,gtag:i32,G:[]u8,ord:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)==0){
      let nn:i32=g_nneeds(G);
      set32(L,13000+pi*56,gtag);
      set32(L,13000+pi*56+4,nn);
      let p:i32=0;
      while(p<nn){
        let ni:i32=get32(ord,p*4);
        let tag:i32=need_tag(G,ni);
        set32(L,13000+pi*56+8+p*12,ni);
        set32(L,13000+pi*56+8+p*12+4,tag);
        set32(L,13000+pi*56+8+p*12+8,bind_fam(L,S,tag));
        p=p+1;
      }
      set32(L,13224,get32(L,13224)+1);
      return pi;
    }
    pi=pi+1;
  }
  return -1;
}
// Copy the first non-empty plan's ints
// [gtag,n,idx0,tag0,fam0,idx1,tag1,fam1,idx2,tag2,fam2,idx3,tag3,fam3]
// into out.
fn plan_get_first(L:[]u8,out:[]u8)void {
  let pi:i32=0;
  while(pi<4){
    if(get32(L,13000+pi*56)!=0){
      let k:i32=0;
      while(k<14){
        set32(out,k*4,get32(L,13000+pi*56+k*4));
        k=k+1;
      }
      return;
    }
    pi=pi+1;
  }
  set32(out,0,-1);
  return;
}
fn clear_plans(L:[]u8)void {
  let pi:i32=0;
  while(pi<4){ set32(L,13000+pi*56,0); pi=pi+1; }
  return;
}
// ---- plan invalidation hook (INTEGRATION-HOOK): a general ----
// ---- plan-version check. Plans cache the bound fam per need at build
// ---- time; bindings are revisable. Before a cached plan loads, every
// ---- cached (tag, fam) pair is re-checked against the live binding
// ---- contract. Any mismatch means the plan was built under a
// ---- superseded binding: that row alone is invalidated (targeted,
// ---- not a full clear) and the query falls through to rebuild. This
// ---- fires on revision, on retirement, or on any fam-changing
// ---- transition, with no caller action. No identifiers: tags, fams,
// ---- goal tags are all read from the plan row at runtime. L+13288 is
// ---- the stale-invalidation counter; L+13292/13296/13300 record the
// ---- last invalidated [goal tag, cached fam, current fam]; L+13304
// ---- records the stale need index p (0-based, plan order), so a
// ---- multi-need invalidation identifies which need went stale.
fn plan_stale_need(L:[]u8,S:[]u8,pi:i32)i32 {
  let nn:i32=get32(L,13000+pi*56+4);
  let p:i32=0;
  while(p<nn){
    let tag:i32=get32(L,13000+pi*56+8+p*12+4);
    let cached:i32=get32(L,13000+pi*56+8+p*12+8);
    if(bind_fam(L,S,tag)!=cached){ return p+1; }
    p=p+1;
  }
  return 0;
}
fn plan_invalidate(L:[]u8,S:[]u8,pi:i32,sp:i32)void {
  let p:i32=sp-1;
  set32(L,13292,get32(L,13000+pi*56));
  set32(L,13296,get32(L,13000+pi*56+8+p*12+8));
  set32(L,13300,bind_fam(L,S,get32(L,13000+pi*56+8+p*12+4)));
  set32(L,13304,p);
  set32(L,13000+pi*56,0);
  set32(L,13288,get32(L,13288)+1);
  return;
}
fn clear_bindings(L:[]u8,S:[]u8)void {
  let bi:i32=0;
  while(bi<8){
    set32(L,bind_off(bi),0);
    ss(S,bind_cb(bi)+1,0);
    bi=bi+1;
  }
  return;
}
// ---- answer assembly ----
fn ans_append(ans:[]u8,v:i32)void {
  let n:i32=get32(ans,0);
  set32(ans,4+n*4,v);
  set32(ans,0,n+1);
  return;
}
// Append one need's output record (at OUTS+ni*160: [n, ints...]).
fn ans_append_rec(ans:[]u8,OUTS:[]u8,ni:i32)void {
  let n:i32=get32(OUTS,ni*160);
  ans_append(ans,n);
  let k:i32=0;
  while(k<n){
    ans_append(ans,get32(OUTS,ni*160+4+k*4));
    k=k+1;
  }
  return;
}
// ---- build a chain buffer from need W[ni]; sub>=0 fills s==0 slots ----
fn w_to_chain(W:[]u8,n:i32,C:[]u8,sub:i32)void {
  let ns:i32=get32(W,n*80+4);
  set32(C,0,ns);
  let i:i32=0;
  while(i<ns){
    let s:i32=get32(W,n*80+4+(1+i*3)*4);
    if(sub>=0){
      if(s==0){ s=sub; }
    }
    set32(C,4+i*12,s);
    set32(C,4+i*12+4,get32(W,n*80+4+(2+i*3)*4));
    set32(C,4+i*12+8,get32(W,n*80+4+(3+i*3)*4));
    i=i+1;
  }
  return;
}
// ---- execute one stored plan; ans gets the appended output records ----
fn execute_plan(L:[]u8,S:[]u8,A:[]u8,G:[]u8,pi:i32,K:[]u8,ans:[]u8,vbuf:[]u8,W:[]u8,OUTS:[]u8,tmpc:[]u8,SUBL:[]u8,seen:[]u8)void {
  mat_inputs(G,W);
  let nn:i32=get32(L,13000+pi*56+4);
  set32(vbuf,16,nn);
  set32(ans,0,0);
  let p:i32=0;
  while(p<nn){
    let ni:i32=get32(L,13000+pi*56+8+p*12);
    let fam:i32=get32(L,13000+pi*56+8+p*12+8);
    apply_kind1(G,W,OUTS,ni);
    if(fam==0){
      let rel:i32=get32(W,ni*80+4);
      let obj:i32=get32(W,ni*80+8);
      let ver:i32=ret_version(L,S,rel);
      set32(vbuf,p*4,ver);
      if(ver==2){
        set32(L,13252,get32(L,13252)+1);
        ret_spec(L,A,rel,obj,K,0,OUTS,ni*160);
      }
      if(ver==0){
        set32(L,13256,get32(L,13256)+1);
        ret_gen(A,rel,obj,K,0,OUTS,ni*160);
      }
      ans_append_rec(ans,OUTS,ni);
    }
    if(fam==1){
      let ver2:i32=vfy_version(L,S,W,ni);
      set32(vbuf,p*4,ver2);
      if(ver2==3){ set32(L,13260,get32(L,13260)+1); }
      if(ver2==1){ set32(L,13264,get32(L,13264)+1); }
      let src:i32=fanin_src(G,ni);
      if(src<0){
        w_to_chain(W,ni,tmpc,-1);
        let vv:i32=0;
        if(ver2==3){ vv=vfy_spec(L,A,tmpc,K,0); }
        if(ver2==1){ vv=vfy_gen(A,tmpc,K,0); }
        set32(OUTS,ni*160,1);
        set32(OUTS,ni*160+4,vv);
        ans_append_rec(ans,OUTS,ni);
      }
      if(src>=0){
        let nsub:i32=get32(OUTS,src*160);
        let npass:i32=0;
        let k:i32=0;
        while(k<nsub){
          let sub:i32=get32(OUTS,src*160+4+k*4);
          w_to_chain(W,ni,tmpc,sub);
          let vv2:i32=0;
          if(ver2==3){ vv2=vfy_spec(L,A,tmpc,K,0); }
          if(ver2==1){ vv2=vfy_gen(A,tmpc,K,0); }
          if(vv2==1){
            set32(OUTS,ni*160+4+npass*4,sub);
            npass=npass+1;
          }
          k=k+1;
        }
        set32(OUTS,ni*160,npass);
        ans_append_rec(ans,OUTS,ni);
      }
    }
    if(fam==2){
      let rel3:i32=get32(W,ni*80+4);
      let ver3:i32=cnt_version(L,S,rel3);
      set32(vbuf,p*4,ver3);
      let has3:i32=apply_kind3(G,OUTS,SUBL,ni);
      let ns3:i32=0;
      if(has3==1){ ns3=get32(SUBL,ni*128); }
      if(has3==0){
        set32(SUBL,ni*128,1);
        set32(SUBL,ni*128+4,get32(W,ni*80+12));
        ns3=1;
      }
      let cc:i32=0;
      if(ver3==5){
        set32(L,13268,get32(L,13268)+1);
        cc=cnt_spec(L,A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
      }
      if(ver3==4){
        set32(L,13272,get32(L,13272)+1);
        cc=cnt_gen(A,rel3,SUBL,ni*128+4,ns3,K,0,seen);
      }
      set32(OUTS,ni*160,1);
      set32(OUTS,ni*160+4,cc);
      ans_append_rec(ans,OUTS,ni);
    }
    p=p+1;
  }
  return;
}
// ---- compose: the learner-driven composition entry point ----
// Returns 0 = declined (NO_PLAN), 1 = plan loaded, 2 = plan built.
// vbuf gets per-step versions; ans gets the answer record.
fn compose(L:[]u8,S:[]u8,A:[]u8,G:[]u8,K:[]u8,ans:[]u8,vbuf:[]u8)i32 {
  let W:[]u8=z_alloc(320);
  let OUTS:[]u8=z_alloc(640);
  let tout:[]u8=z_alloc(160);
  let tmpc:[]u8=z_alloc(512);
  let ord:[]u8=z_alloc(16);
  let SUBL:[]u8=z_alloc(512);
  let seen:[]u8=z_alloc(320);
  let gt:i32=g_tag(G);
  let pi:i32=plan_find(L,gt);
  if(pi>=0){
    let sp:i32=plan_stale_need(L,S,pi);
    if(sp>0){
      plan_invalidate(L,S,pi,sp);
      pi=-1;
    }
  }
  if(pi<0){
    let ok:i32=learn_bindings(L,S,A,G,K,tout,tmpc,seen);
    if(ok==0){
      set32(L,13236,get32(L,13236)+1);
      return 0;
    }
    topo(G,ord);
    pi=plan_new(L,S,gt,G,ord);
    execute_plan(L,S,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
    return 2;
  }
  set32(L,13228,get32(L,13228)+1);
  execute_plan(L,S,A,G,pi,K,ans,vbuf,W,OUTS,tmpc,SUBL,seen);
  return 1;
}
// ---- ret_buckets_rebuild: rebuild the RET buckets on the current ----
// ---- world WITHOUT touching the coverage contract. Execution ----
// ---- machinery for the stress recovery path (the contract alone ----
// ---- decides routing; the buckets are its index). ----
// ---- first_subj: first subject observed with a relation (-1 if none).
fn ret_buckets_rebuild(L:[]u8,A:[]u8)void {
  let i:i32=0;
  while(i<16){ set32(L,68+i*4,0); i=i+1; }
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    let r:i32=get32(A,4+j*12+4);
    let bi:i32=ret_cov_find(L,r);
    if(bi>=0){
      let c0:i32=get32(L,68+bi*4);
      if(c0<64){
        set32(L,132+(bi*64+c0)*4,j);
        set32(L,68+bi*4,c0+1);
      }
    }
    j=j+1;
  }
  return;
}
fn first_subj(A:[]u8,rel:i32)i32 {
  let nf:i32=get32(A,0);
  let j:i32=0;
  while(j<nf){
    if(get32(A,4+j*12+4)==rel){ return get32(A,4+j*12); }
    j=j+1;
  }
  return -1;
}
fn dump_plans(b:[]u8,c:i32,L:[]u8)i32 {
  let pi:i32=0;
  while(pi<4){
    let gt:i32=get32(L,13000+pi*56);
    if(gt!=0){
      c=o_app(b,c,"PLAN goal=");
      c=o_i64(b,c,gt as i64);
      let nn:i32=get32(L,13000+pi*56+4);
      c=o_app(b,c," n=");
      c=o_i64(b,c,nn as i64);
      let p:i32=0;
      while(p<nn){
        c=o_app(b,c," [");
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+4) as i64);
        b[c]=58; c=c+1;
        c=o_i64(b,c,get32(L,13000+pi*56+8+p*12+8) as i64);
        b[c]=93; c=c+1;
        p=p+1;
      }
      c=o_nl(b,c);
    }
    pi=pi+1;
  }
  return c;
}
// ---- one retrieve episode ----
fn run_retep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,id:i32,ep:i32)i32 {
  ret_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let obj:i32=get32(rb,4);
  let n:i32=ret_episode(L,A,rel,obj,K,tout);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," ret n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one verify episode ----
fn run_vfyep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,Cb:[]u8,id:i32,ep:i32)i32 {
  vfy_ep_chain(Cb,id);
  let v:i32=vfy_episode(L,A,Cb,K);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," vfy v=");
  c=o_i64(b,c,v as i64);
  c=o_nl(b,c);
  return c;
}
// ---- one count episode ----
fn run_cntep(b:[]u8,c:i32,L:[]u8,A:[]u8,K:[]u8,rb:[]u8,tout:[]u8,seen:[]u8,id:i32,ep:i32)i32 {
  cnt_ep_pat(id,rb,0);
  let rel:i32=get32(rb,0);
  let subj:i32=get32(rb,4);
  let n:i32=cnt_episode(L,A,rel,subj,K,tout,seen);
  c=o_app(b,c,"EP ep=");
  c=o_i64(b,c,ep as i64);
  c=o_app(b,c," cnt n=");
  c=o_i64(b,c,n as i64);
  c=o_nl(b,c);
  return c;
}
fn ans_eq(a:[]u8,b:[]u8)i32 {
  let n:i32=get32(a,0);
  if(get32(b,0)!=n){ return 0; }
  let k:i32=0;
  while(k<n){
    if(get32(a,4+k*4)!=get32(b,4+k*4)){ return 0; }
    k=k+1;
  }
  return 1;
}
// ---- oracle_dia: independent all-generic reference for diamond goals ----
// Goal shape: need0 pattern; need1/need2 chain templates over need0's
// output (fan-out); need3 count over the link-order concatenation of
// the need1 and need2 outputs (fan-in). Records are emitted in the
// predicted plan execution order: need0, need2, need1, need3.
// Uses only ret_gen, vfy_gen, cnt_gen.
fn do_query(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,G:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,seen:[]u8,qn:[]u8,okind:i32)i32 {
  set32(K,0,0);
  set32(K,4,0);
  let st:i32=compose(L,S,A,G,K,ans,vbuf);
  c=o_app(b,c,"Q id=");
  c=o_app(b,c,qn);
  if(st==0){
    c=o_app(b,c," goal=");
    c=o_i64(b,c,g_tag(G) as i64);
    c=o_app(b,c," decline=1");
    c=o_nl(b,c);
    return c;
  }
  set32(K,4,0);
  if(okind==1){ oracle_dia(A,G,K,oans,seen); }
  if(okind==2){ oracle_1ret(A,G,K,oans,seen); }
  if(okind==3){ oracle_1vfy(A,G,K,oans,seen); }
  if(okind==4){ oracle_rvr(A,G,K,oans,seen); }
  let cs:i32=get32(K,0);
  let cg:i32=get32(K,4);
  let a:i32=ans_eq(ans,oans);
  set32(L,13240,get32(L,13240)+a);
  set32(L,13244,get32(L,13244)+cs);
  set32(L,13248,get32(L,13248)+cg);
  c=o_app(b,c," goal=");
  c=o_i64(b,c,g_tag(G) as i64);
  c=o_app(b,c," st=");
  c=o_i64(b,c,st as i64);
  c=o_app(b,c," vers=");
  let nn:i32=get32(vbuf,16);
  let p:i32=0;
  while(p<nn){
    if(p>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(vbuf,p*4) as i64);
    p=p+1;
  }
  c=o_app(b,c," ans=");
  let an:i32=get32(ans,0);
  c=o_i64(b,c,an as i64);
  b[c]=58; c=c+1;
  let k:i32=0;
  while(k<an){
    if(k>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(ans,4+k*4) as i64);
    k=k+1;
  }
  c=o_app(b,c," agree=");
  c=o_i64(b,c,a as i64);
  c=o_app(b,c," cs=");
  c=o_i64(b,c,cs as i64);
  c=o_app(b,c," cg=");
  c=o_i64(b,c,cg as i64);
  c=o_nl(b,c);
  return c;
}
// ---- oracle_1ret: independent all-generic reference for a single ----
// ---- RETRIEVE need. Answer record matches the learner's [n, ints].
fn oracle_1vfy(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let tmpc:[]u8=chain_new();
  let ns:i32=need_f(G,0,0);
  set32(tmpc,0,ns);
  let i:i32=0;
  while(i<ns){
    set32(tmpc,4+i*12,need_f(G,0,1+i*3));
    set32(tmpc,4+i*12+4,need_f(G,0,1+i*3+1));
    set32(tmpc,4+i*12+8,need_f(G,0,1+i*3+2));
    i=i+1;
  }
  let v:i32=vfy_gen(A,tmpc,K,4);
  set32(oans,0,0);
  ans_append(oans,1);
  ans_append(oans,v);
  return;
}
// ---- zero the global contract counters for a clean per-stage reading ----
fn zero_counters(S:[]u8)void {
  ss(S,900,0); ss(S,901,0); ss(S,904,0); ss(S,908,-1);
  ss(S,912,0); ss(S,916,0); ss(S,920,0); ss(S,924,0);
  ss(S,7,500);
  return;
}
// ---- oracle_dia: independent all-generic reference for diamond goals ----
// Goal shape: need0 pattern; need1/need2 chain templates over need0's
// output (fan-out); need3 count over the link-order concatenation of
// the need1 and need2 outputs (fan-in). Records are emitted in the
// predicted plan execution order: need0, need2, need1, need3.
// Uses only ret_gen, vfy_gen, cnt_gen.
fn oracle_dia(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  let tmpc:[]u8=chain_new();
  let ns2:i32=need_f(G,2,0);
  let npass2:i32=0;
  let pass2:[]u8=z_alloc(160);
  let q2:i32=0;
  while(q2<nc){
    let sub2:i32=get32(tout,4+q2*4);
    set32(tmpc,0,ns2);
    let i:i32=0;
    while(i<ns2){
      let s2:i32=need_f(G,2,1+i*3);
      if(s2==0){ s2=sub2; }
      set32(tmpc,4+i*12,s2);
      set32(tmpc,4+i*12+4,need_f(G,2,1+i*3+1));
      set32(tmpc,4+i*12+8,need_f(G,2,1+i*3+2));
      i=i+1;
    }
    let vv2:i32=vfy_gen(A,tmpc,K,4);
    if(vv2==1){
      set32(pass2,4+npass2*4,sub2);
      npass2=npass2+1;
    }
    q2=q2+1;
  }
  ans_append(oans,npass2);
  let q3:i32=0;
  while(q3<npass2){
    ans_append(oans,get32(pass2,4+q3*4));
    q3=q3+1;
  }
  let ns1:i32=need_f(G,1,0);
  let npass1:i32=0;
  let pass1:[]u8=z_alloc(160);
  let q4:i32=0;
  while(q4<nc){
    let sub1:i32=get32(tout,4+q4*4);
    set32(tmpc,0,ns1);
    let j:i32=0;
    while(j<ns1){
      let s1:i32=need_f(G,1,1+j*3);
      if(s1==0){ s1=sub1; }
      set32(tmpc,4+j*12,s1);
      set32(tmpc,4+j*12+4,need_f(G,1,1+j*3+1));
      set32(tmpc,4+j*12+8,need_f(G,1,1+j*3+2));
      j=j+1;
    }
    let vv1:i32=vfy_gen(A,tmpc,K,4);
    if(vv1==1){
      set32(pass1,4+npass1*4,sub1);
      npass1=npass1+1;
    }
    q4=q4+1;
  }
  ans_append(oans,npass1);
  let q5:i32=0;
  while(q5<npass1){
    ans_append(oans,get32(pass1,4+q5*4));
    q5=q5+1;
  }
  let rel3:i32=need_f(G,3,0);
  let cat:[]u8=z_alloc(160);
  let tot:i32=0;
  let q6:i32=0;
  while(q6<npass1){
    set32(cat,4+tot*4,get32(pass1,4+q6*4));
    tot=tot+1;
    q6=q6+1;
  }
  let q7:i32=0;
  while(q7<npass2){
    set32(cat,4+tot*4,get32(pass2,4+q7*4));
    tot=tot+1;
    q7=q7+1;
  }
  let ccd:i32=cnt_gen(A,rel3,cat,4,tot,K,4,seen);
  ans_append(oans,1);
  ans_append(oans,ccd);
  return;
}
// ---- one composite query: learner compose + oracle compare ----
// ---- IHH-INV evidence line: goal tag, cached fam, current fam, ----
// ---- stale need index p (plan order), and the cumulative stale ----
// ---- counter. Printed after every query that may trip the hook.
fn print_ihh_inv(b:[]u8,c:i32,L:[]u8)i32 {
  c=o_app(b,c,"IHH-INV goal=");
  c=o_i64(b,c,get32(L,13292) as i64);
  c=o_app(b,c," cached=");
  c=o_i64(b,c,get32(L,13296) as i64);
  c=o_app(b,c," cur=");
  c=o_i64(b,c,get32(L,13300) as i64);
  c=o_app(b,c," need=");
  c=o_i64(b,c,get32(L,13304) as i64);
  c=o_app(b,c," stale=");
  c=o_i64(b,c,get32(L,13288) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- IH-COLLISION: tag-shape collision with the plan-invalidation ----
// ---- hook. Faithful port of C461's demo_collision, with the manual
// ---- clear_plans REMOVED: the hook inside compose must fire instead.
// ---- All tags, rels, objs, goal tags are runtime-derived.
fn demo_collision_hook(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,ans:[]u8,oans:[]u8,vbuf:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8)i32 {
  zero_counters(S);
  setup_worldA(A);
  let tagC:i32=get32(L,12744+0*4);
  let cb0:i32=2000+0*100;
  let avb:[]u8=z_alloc(64);
  vocab_scan(A,avb);
  let relC:i32=get32(avb,0);
  let subjC:i32=first_subj(A,relC);
  let objC:i32=first_obj(A,relC);
  let G0:[]u8=z_alloc(256);
  mk_goal813_E0(G0);
  let gtD:i32=g_tag(G0)+5;
  let G:[]u8=z_alloc(256);
  let o:i32=w_begin(G,gtD,1);
  o=w_need(G,o,tagC,4);
  o=w_f(G,o,1);
  o=w_f(G,o,subjC);
  o=w_f(G,o,relC);
  o=w_f(G,o,objC);
  o=w_links(G,o,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"QD0",3);
  let tr0:i32=try_family(L,A,0,G,0,K,tout,tmpc,seen);
  let tr1:i32=try_family(L,A,1,G,0,K,tout,tmpc,seen);
  let tr2:i32=try_family(L,A,2,G,0,K,tout,tmpc,seen);
  u_invalidate(S,cb0,1,0);
  u_invalidate(S,cb0,1,0);
  u_invalidate(S,cb0,1,0);
  let dcX:i32=sg(S,cb0+10);
  let actX:i32=sg(S,cb0+9);
  let reqX:i32=sg(S,901);
  ss(S,300,2);
  let na9:i32=0;
  if(tr0==1){ jt_acc2(S,na9,tagC,0); na9=na9+1; }
  if(tr1==1){ jt_acc2(S,na9,tagC,1); na9=na9+1; }
  if(tr2==1){ jt_acc2(S,na9,tagC,2); na9=na9+1; }
  ss(S,301,na9);
  let nr9:i32=0;
  if(tr0==0){ jt_rej2(S,nr9,tagC,0); nr9=nr9+1; }
  if(tr1==0){ jt_rej2(S,nr9,tagC,1); nr9=nr9+1; }
  if(tr2==0){ jt_rej2(S,nr9,tagC,2); nr9=nr9+1; }
  ss(S,302,nr9);
  u_revise(S,cb0,1);
  c=o_app(b,c,"ISD-REV tag=");
  c=o_i64(b,c,tagC as i64);
  c=o_app(b,c," probes=3 dc=");
  c=o_i64(b,c,dcX as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,actX as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," nclause=(");
  c=o_i64(b,c,sg(S,cb0+4) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+5) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+7) as i64);
  b[c]=44; c=c+1;
  c=o_i64(b,c,sg(S,cb0+8) as i64);
  c=o_app(b,c,") route1=");
  c=o_i64(b,c,u_check(S,cb0,2,tagC,1,0,0,0,0) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb0,2,tagC,0,0,0,0,0) as i64);
  c=o_app(b,c," route2=");
  c=o_i64(b,c,u_check(S,cb0,2,tagC,2,0,0,0,0) as i64);
  c=o_app(b,c," tr0=");
  c=o_i64(b,c,tr0 as i64);
  c=o_app(b,c," tr1=");
  c=o_i64(b,c,tr1 as i64);
  c=o_app(b,c," tr2=");
  c=o_i64(b,c,tr2 as i64);
  c=o_nl(b,c);
  let o2:i32=w_begin(G,gtD,1);
  o2=w_need(G,o2,tagC,4);
  o2=w_f(G,o2,1);
  o2=w_f(G,o2,subjC);
  o2=w_f(G,o2,relC);
  o2=w_f(G,o2,objC);
  o2=w_links(G,o2,0);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"QD1",3);
  c=print_ihh_inv(b,c,L);
  c=do_query(b,c,L,S,A,K,G,ans,oans,vbuf,seen,"QD1R",3);
  c=dump_plans(b,c,L);
  return c;
}
// ---- oracle_rvr: independent all-generic reference for the G1 ----
// ---- 3-need goal. Needs are independent (no links); the plan order
// ---- for a link-free goal is reverse goal order, so records emit
// ---- need2, need1, need0. Dispatch is shape-driven: nf==2 ret_gen,
// ---- nf==7 vfy_gen on the chain. Uses only generic procedures.
fn oracle_rvr(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  set32(oans,0,0);
  let p:i32=0;
  while(p<3){
    let ni:i32=2-p;
    let nf:i32=need_nf(G,ni);
    if(nf==2){
      let tout:[]u8=z_alloc(160);
      let nc:i32=ret_gen(A,need_f(G,ni,0),need_f(G,ni,1),K,4,tout,0);
      ans_append(oans,nc);
      let k:i32=0;
      while(k<nc){
        ans_append(oans,get32(tout,4+k*4));
        k=k+1;
      }
    }
    if(nf==7){
      let tmpc:[]u8=chain_new();
      let ns:i32=need_f(G,ni,0);
      set32(tmpc,0,ns);
      let i:i32=0;
      while(i<ns){
        set32(tmpc,4+i*12,need_f(G,ni,1+i*3));
        set32(tmpc,4+i*12+4,need_f(G,ni,1+i*3+1));
        set32(tmpc,4+i*12+8,need_f(G,ni,1+i*3+2));
        i=i+1;
      }
      let vv:i32=vfy_gen(A,tmpc,K,4);
      ans_append(oans,1);
      ans_append(oans,vv);
    }
    p=p+1;
  }
  return;
}
// ---- clause block for a bound tag: scan the binding table.
fn tag_cb(L:[]u8,tag:i32)i32 {
  let bi:i32=0;
  while(bi<8){
    if(get32(L,12744+bi*4)==tag){ return 2000+bi*100; }
    bi=bi+1;
  }
  return -1;
}
// ---- 1-need RET-shape goal builder.
fn mk_g1need(G:[]u8,gt:i32,tag:i32,rel:i32,obj:i32)void {
  let o:i32=w_begin(G,gt,1);
  o=w_need(G,o,tag,2); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_links(G,o,0);
  return;
}
// ---- 1-need chain-shape goal builder (revision trials).
fn mk_gchain(G:[]u8,gt:i32,tag:i32,rel:i32,subj:i32,obj:i32)void {
  let o:i32=w_begin(G,gt,1);
  o=w_need(G,o,tag,7); o=w_f(G,o,2);
  o=w_f(G,o,subj); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_f(G,o,subj); o=w_f(G,o,rel); o=w_f(G,o,obj);
  o=w_links(G,o,0);
  return;
}
// ---- G1 goal builder: 3 needs, no links. need0 (t1, RET (rA,oA));
// ---- need1 (t2, chain [(sC,rC,oC),(sC,rC,oC)]); need2 (t3, RET
// ---- (rC,oC)). Plan order for link-free goals is [2,1,0], so the
// ---- t2 need sits at interior plan position p=1.
fn mk_g1(G:[]u8,gt:i32,t1:i32,t2:i32,t3:i32,rA:i32,oA:i32,rC:i32,sC:i32,oC:i32)void {
  let o:i32=w_begin(G,gt,3);
  o=w_need(G,o,t1,2); o=w_f(G,o,rA); o=w_f(G,o,oA);
  o=w_need(G,o,t2,7); o=w_f(G,o,2);
  o=w_f(G,o,sC); o=w_f(G,o,rC); o=w_f(G,o,oC);
  o=w_f(G,o,sC); o=w_f(G,o,rC); o=w_f(G,o,oC);
  o=w_need(G,o,t3,2); o=w_f(G,o,rC); o=w_f(G,o,oC);
  o=w_links(G,o,0);
  return;
}
// ---- G1-PREBIND: induct T2's binding to fam 0 via learn_bindings
// ---- directly (no query, no plan row).
fn stage_g1_prebind(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8,t2:i32,r601:i32,o601:i32,gt:i32)i32 {
  let Gp:[]u8=z_alloc(256);
  mk_g1need(Gp,gt,t2,r601,o601);
  learn_bindings(L,S,A,Gp,K,tout,tmpc,seen);
  c=o_app(b,c,"G1-PREBIND tag=");
  c=o_i64(b,c,t2 as i64);
  c=o_app(b,c," fam=");
  c=o_i64(b,c,bind_fam(L,S,t2) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G1-REVISION: flip T2's binding 0->1 on chain-shape trials.
fn stage_g1_revision(b:[]u8,c:i32,L:[]u8,S:[]u8,A:[]u8,K:[]u8,tout:[]u8,tmpc:[]u8,seen:[]u8,t2:i32,rC:i32,sC:i32,oC:i32,gt:i32)i32 {
  zero_counters(S);
  let Gr:[]u8=z_alloc(256);
  mk_gchain(Gr,gt,t2,rC,sC,oC);
  let cb:i32=tag_cb(L,t2);
  let tr0:i32=try_family(L,A,0,Gr,0,K,tout,tmpc,seen);
  let tr1:i32=try_family(L,A,1,Gr,0,K,tout,tmpc,seen);
  let tr2:i32=try_family(L,A,2,Gr,0,K,tout,tmpc,seen);
  u_invalidate(S,cb,1,0);
  u_invalidate(S,cb,1,0);
  u_invalidate(S,cb,1,0);
  let dcX:i32=sg(S,cb+10);
  let actX:i32=sg(S,cb+9);
  let reqX:i32=sg(S,901);
  ss(S,300,2);
  jt_acc2(S,0,t2,1);
  ss(S,301,1);
  jt_rej2(S,0,t2,0);
  jt_rej2(S,1,t2,2);
  ss(S,302,2);
  u_revise(S,cb,1);
  c=o_app(b,c,"G1-REV tag=");
  c=o_i64(b,c,t2 as i64);
  c=o_app(b,c," probes=3 dc=");
  c=o_i64(b,c,dcX as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,actX as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," route1=");
  c=o_i64(b,c,u_check(S,cb,2,t2,1,0,0,0,0) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb,2,t2,0,0,0,0,0) as i64);
  c=o_app(b,c," route2=");
  c=o_i64(b,c,u_check(S,cb,2,t2,2,0,0,0,0) as i64);
  c=o_app(b,c," tr0=");
  c=o_i64(b,c,tr0 as i64);
  c=o_app(b,c," tr1=");
  c=o_i64(b,c,tr1 as i64);
  c=o_app(b,c," tr2=");
  c=o_i64(b,c,tr2 as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G2-COVREV: revise the RET coverage contract (3000) to admit
// ---- r602 only. Binding contracts are untouched.
fn stage_g2_covrev(b:[]u8,c:i32,L:[]u8,S:[]u8,r601:i32,r602:i32)i32 {
  zero_counters(S);
  let acc:[]u8=z_alloc(64);
  let rej:[]u8=z_alloc(64);
  set32(acc,0,r602);
  set32(rej,0,r601);
  u_invalidate(S,3000,1,0);
  u_invalidate(S,3000,1,0);
  u_invalidate(S,3000,1,0);
  let dcX:i32=sg(S,3000+10);
  let actX:i32=sg(S,3000+9);
  let reqX:i32=sg(S,901);
  jt_load_cov(S,acc,1,rej,1);
  u_revise(S,3000,1);
  c=o_app(b,c,"G2-COVREV dc=");
  c=o_i64(b,c,dcX as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,actX as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," route601=");
  c=o_i64(b,c,u_check(S,3000,1,r601,0,0,0,0,0) as i64);
  c=o_app(b,c," route602=");
  c=o_i64(b,c,u_check(S,3000,1,r602,0,0,0,0,0) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G3-RETIRE: retire T4's clause with 2 disconfirmations (no
// ---- revision latch: pure retirement-without-revision).
fn stage_g3_retire(b:[]u8,c:i32,L:[]u8,S:[]u8,t4:i32)i32 {
  zero_counters(S);
  let cb:i32=tag_cb(L,t4);
  u_invalidate(S,cb,1,0);
  u_invalidate(S,cb,1,0);
  c=o_app(b,c,"G3-RET tag=");
  c=o_i64(b,c,t4 as i64);
  c=o_app(b,c," dc=");
  c=o_i64(b,c,sg(S,cb+10) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,cb+9) as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,sg(S,901) as i64);
  c=o_nl(b,c);
  return c;
}
// ---- G3-RESTORE: latch the revision request and re-induct T4->0.
fn stage_g3_restore(b:[]u8,c:i32,L:[]u8,S:[]u8,t4:i32)i32 {
  let cb:i32=tag_cb(L,t4);
  u_invalidate(S,cb,1,0);
  let reqX:i32=sg(S,901);
  ss(S,300,2);
  jt_acc2(S,0,t4,0);
  ss(S,301,1);
  jt_rej2(S,0,t4,1);
  jt_rej2(S,1,t4,2);
  ss(S,302,2);
  u_revise(S,cb,1);
  c=o_app(b,c,"G3-REV tag=");
  c=o_i64(b,c,t4 as i64);
  c=o_app(b,c," dc=");
  c=o_i64(b,c,sg(S,cb+10) as i64);
  c=o_app(b,c," active=");
  c=o_i64(b,c,sg(S,cb+9) as i64);
  c=o_app(b,c," req=");
  c=o_i64(b,c,reqX as i64);
  c=o_app(b,c," olderr=");
  c=o_i64(b,c,sg(S,924) as i64);
  c=o_app(b,c," revcount=");
  c=o_i64(b,c,sg(S,904) as i64);
  c=o_app(b,c," route0=");
  c=o_i64(b,c,u_check(S,cb,2,t4,0,0,0,0,0) as i64);
  c=o_app(b,c," route1=");
  c=o_i64(b,c,u_check(S,cb,2,t4,1,0,0,0,0) as i64);
  c=o_app(b,c," route2=");
  c=o_i64(b,c,u_check(S,cb,2,t4,2,0,0,0,0) as i64);
  c=o_nl(b,c);
  return c;
}
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let K:[]u8=z_alloc(64);
  let L:[]u8=z_alloc(16384);
  let S:[]u8=z_alloc(16384);
  let A:[]u8=world_new();
  let Cb:[]u8=chain_new();
  let G:[]u8=z_alloc(256);
  let ans:[]u8=z_alloc(256);
  let oans:[]u8=z_alloc(256);
  let vbuf:[]u8=z_alloc(32);
  let rb:[]u8=z_alloc(16);
  let tout:[]u8=z_alloc(160);
  let seen:[]u8=z_alloc(320);
  let tmpc:[]u8=z_alloc(512);
  c=o_app(B,c,"STAGE IH-SETUP"); c=o_nl(B,c);
  setup_worldA(A);
  c=run_retep(B,c,L,A,K,rb,tout,0,0);
  c=run_retep(B,c,L,A,K,rb,tout,1,1);
  c=run_retep(B,c,L,A,K,rb,tout,2,2);
  c=run_retep(B,c,L,A,K,rb,tout,3,3);
  specialize_ret(L,S,A,0,3);
  c=run_vfyep(B,c,L,A,K,Cb,0,4);
  c=run_vfyep(B,c,L,A,K,Cb,1,5);
  c=run_vfyep(B,c,L,A,K,Cb,2,6);
  c=run_vfyep(B,c,L,A,K,Cb,3,7);
  specialize_vfy(L,S,A,4,7);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,0,8);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,1,9);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,2,10);
  c=run_cntep(B,c,L,A,K,rb,tout,seen,3,11);
  specialize_cnt(L,S,A,8,11);
  mk_goal813_E0(G);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"E0",1);
  c=do_query(B,c,L,S,A,K,G,ans,oans,vbuf,seen,"E0R",1);
  c=o_app(B,c,"IHH-NOFIRE stale=");
  c=o_i64(B,c,get32(L,13288) as i64);
  c=o_nl(B,c);
  c=dump_plans(B,c,L);
  c=o_app(B,c,"STAGE IH-COLLISION"); c=o_nl(B,c);
  c=demo_collision_hook(B,c,L,S,A,K,ans,oans,vbuf,tout,tmpc,seen);
  // ---- runtime-derived tags, rels, objs, goal tags (no literals) ----
  let tagC:i32=get32(L,12744+0*4);
  let t1:i32=tagC+2;
  let t2:i32=tagC+3;
  let t3:i32=tagC+4;
  let t4:i32=tagC+5;
  let avb:[]u8=z_alloc(64);
  vocab_scan(A,avb);
  let r601:i32=get32(avb,0);
  let o601:i32=first_obj(A,r601);
  let r602:i32=get32(avb,1*4);
  let rA:i32=get32(avb,2*4);
  let oA:i32=first_obj(A,rA);
  let rC:i32=get32(avb,3*4);
  let sC:i32=first_subj(A,rC);
  let oC:i32=first_obj(A,rC);
  let g0:[]u8=z_alloc(256);
  mk_goal813_E0(g0);
  let gtG1:i32=g_tag(g0)+7;
  let gtG2:i32=gtG1+1;
  let G1:[]u8=z_alloc(256);
  mk_g1(G1,gtG1,t1,t2,t3,rA,oA,rC,sC,oC);
  let G2:[]u8=z_alloc(256);
  mk_g1need(G2,gtG2,t4,r601,o601);
  c=o_app(B,c,"STAGE G1-PREBIND"); c=o_nl(B,c);
  c=stage_g1_prebind(B,c,L,S,A,K,tout,tmpc,seen,t2,r601,o601,gtG1);
  c=o_app(B,c,"STAGE G1-BUILD"); c=o_nl(B,c);
  c=do_query(B,c,L,S,A,K,G1,ans,oans,vbuf,seen,"G1Q0",4);
  c=o_app(B,c,"STAGE G1-REVISION"); c=o_nl(B,c);
  c=stage_g1_revision(B,c,L,S,A,K,tout,tmpc,seen,t2,rC,sC,oC,gtG1);
  c=o_app(B,c,"STAGE G2-BUILD"); c=o_nl(B,c);
  c=do_query(B,c,L,S,A,K,G2,ans,oans,vbuf,seen,"G2Q0",2);
  c=o_app(B,c,"STAGE G2-COVREV"); c=o_nl(B,c);
  c=stage_g2_covrev(B,c,L,S,r601,r602);
  c=o_app(B,c,"STAGE G2-QUERY"); c=o_nl(B,c);
  c=do_query(B,c,L,S,A,K,G2,ans,oans,vbuf,seen,"G2Q1",2);
  c=o_app(B,c,"G2-NOFIRE stale=");
  c=o_i64(B,c,get32(L,13288) as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"STAGE G1-DELAYED"); c=o_nl(B,c);
  c=do_query(B,c,L,S,A,K,G1,ans,oans,vbuf,seen,"G1Q1",4);
  c=print_ihh_inv(B,c,L);
  c=do_query(B,c,L,S,A,K,G1,ans,oans,vbuf,seen,"G1Q1R",4);
  c=o_app(B,c,"G1-NOFIRE stale=");
  c=o_i64(B,c,get32(L,13288) as i64);
  c=o_nl(B,c);
  c=o_app(B,c,"STAGE G3-RETIRE"); c=o_nl(B,c);
  c=stage_g3_retire(B,c,L,S,t4);
  c=do_query(B,c,L,S,A,K,G1,ans,oans,vbuf,seen,"G1Q1R2",4);
  c=do_query(B,c,L,S,A,K,G2,ans,oans,vbuf,seen,"G2Q1R",2);
  c=print_ihh_inv(B,c,L);
  c=o_app(B,c,"STAGE G3-RESTORE"); c=o_nl(B,c);
  c=stage_g3_restore(B,c,L,S,t4);
  c=do_query(B,c,L,S,A,K,G2,ans,oans,vbuf,seen,"G2Q2",2);
  c=dump_plans(B,c,L);
  c=o_app(B,c,"SUMMARY loads=");
  c=o_i64(B,c,get32(L,13228) as i64);
  c=o_app(B,c," stale=");
  c=o_i64(B,c,get32(L,13288) as i64);
  c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}
// ---- oracle_1ret: independent all-generic reference for a single ----
// ---- RETRIEVE need. Answer record matches the learner's [n, ints].
fn oracle_1ret(A:[]u8,G:[]u8,K:[]u8,oans:[]u8,seen:[]u8)void {
  let rel:i32=need_f(G,0,0);
  let obj:i32=need_f(G,0,1);
  let tout:[]u8=z_alloc(160);
  let nc:i32=ret_gen(A,rel,obj,K,4,tout,0);
  set32(oans,0,0);
  ans_append(oans,nc);
  let k:i32=0;
  while(k<nc){
    ans_append(oans,get32(tout,4+k*4));
    k=k+1;
  }
  return;
}
// ---- oracle_1vfy: independent all-generic reference for a single ----
// ---- VERIFY need. Answer record matches the learner's [1, vv].

}
// Goal 814 E1 (diamond-converge, world A): need0 P=(601,621);
// need1 T=(S,601,621),(S,602,622); need2 T=(S,603,620),(S,601,631);
// need3 CNT [601,1,0] via fan-in from need1 and need2.
fn mk_goal814_E1(G:[]u8)void {
  let o:i32=w_begin(G,813+1,4);

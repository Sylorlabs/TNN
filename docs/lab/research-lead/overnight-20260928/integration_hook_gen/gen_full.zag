}
// Goal 815 B0 (diamond-diverge, world B): need0 P=(701,723);
// need1 T=(S,702,724),(S,701,723); need2 T=(S,702,729),(S,701,723);
// need3 CNT [701,1,0] via fan-in from need1 and need2.
fn mk_goal815_B0(G:[]u8)void {
  let o:i32=w_begin(G,813+2,4);
  o=w_need(G,o,801,2); o=w_f(G,o,701); o=w_f(G,o,723);
  o=w_need(G,o,802,7); o=w_f(G,o,2);
  o=w_f(G,o,0); o=w_f(G,o,702); o=w_f(G,o,724);
  o=w_f(G,o,0); o=w_f(G,o,701); o=w_f(G,o,723);
  o=w_need(G,o,802,7); o=w_f(G,o,2);
  o=w_f(G,o,0); o=w_f(G,o,702); o=w_f(G,o,729);
  o=w_f(G,o,0); o=w_f(G,o,701); o=w_f(G,o,723);
  o=w_need(G,o,807,3); o=w_f(G,o,701); o=w_f(G,o,1); o=w_f(G,o,0);
  o=w_links(G,o,4);
  o=w_link(G,o,2,1,0,0,0,1,0);
  o=w_link(G,o,2,2,0,0,0,1,0);
  o=w_link(G,o,3,3,0,0,1,0,0);
  o=w_link(G,o,3,3,0,0,2,0,0);

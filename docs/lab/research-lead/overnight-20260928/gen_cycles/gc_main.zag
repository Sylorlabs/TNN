// gc_main.zag -- GEN-CYCLES main battery driver.
// Fixpoint workload at seqmax=8 (must PASS: ANS=1005), then U's 5 pairs
// at seqmax=8 (regression: must match frozen U). All identifiers are
// opaque integers; setups come from gc_base.zag / cyc_nomain.zag.
fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A:[]u8=world_new();
  setup_cyc(A);
  c=gc_solve(A,B,c,1001,1,1,1005,4,8,8);
  c=uni_report(A,B,c,"GC","QC");
  c=uni_census(A,B,c,4);
  let A1:[]u8=world_new();
  setup_p1(A1);
  c=gc_solve(A1,B,c,61,1,1,65,2,8,8);
  c=uni_report(A1,B,c,"GC","P1");
  let A2:[]u8=world_new();
  setup_p2a(A2);
  c=gc_solve(A2,B,c,41,1,2,2,4,8,8);
  c=uni_report(A2,B,c,"GC","P2a");
  let A3:[]u8=world_new();
  setup_p2b(A3);
  c=gc_solve(A3,B,c,41,1,2,2,4,8,8);
  c=uni_report(A3,B,c,"GC","P2b");
  let A4:[]u8=world_new();
  setup_p3(A4);
  c=gc_solve(A4,B,c,31,1,2,2,4,8,8);
  c=uni_report(A4,B,c,"GC","P3");
  setup_p5extra(A3);
  c=gc_solve(A3,B,c,51,1,2,3,4,8,8);
  c=uni_report(A3,B,c,"GC","P5");
  c=uni_census(A3,B,c,4);
  o_flush(B,c);
  return 0;
}

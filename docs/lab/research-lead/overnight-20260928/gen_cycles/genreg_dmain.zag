fn main()i32 {
  let B:[]u8=z_alloc(65536);
  let c:i32=0;
  let A1:[]u8=world_new();
  setup_p1(A1);
  c=gen_solve(A1,B,c,61,1,1,65,2);
  c=gen_report(A1,B,c,"GEN","P1");
  let A2:[]u8=world_new();
  setup_p2a(A2);
  c=gen_solve(A2,B,c,41,1,2,2,4);
  c=gen_report(A2,B,c,"GEN","P2a");
  let A3:[]u8=world_new();
  setup_p2b(A3);
  c=gen_solve(A3,B,c,41,1,2,2,4);
  c=gen_report(A3,B,c,"GEN","P2b");
  let A4:[]u8=world_new();
  setup_p3(A4);
  c=gen_solve(A4,B,c,31,1,2,2,4);
  c=gen_report(A4,B,c,"GEN","P3");
  let AD1:[]u8=world_new();
  setup_d1(AD1);
  c=gen_solve(AD1,B,c,202,1,2,5,4);
  c=gen_report(AD1,B,c,"GEN","Q1");
  c=gen_census(AD1,B,c,4);
  let AD2:[]u8=world_new();
  setup_d2(AD2);
  c=gen_solve(AD2,B,c,202,1,2,5,4);
  c=gen_report(AD2,B,c,"GEN","Q2");
  o_flush(B,c);
  return 0;
}

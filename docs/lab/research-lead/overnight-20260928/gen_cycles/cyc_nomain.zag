// cyc_new.zag -- cycle workload driver (frozen PREREG Section 5).
// Poses the fixpoint-iteration workload purely as data (facts + MAPs +
// teach observations) plus ONE uni_solve query. No iteration, no
// fixpoint check, no direct structure-application call in this file
// (C5 audit).
// All identifiers are opaque integers (C6 audit).
fn setup_cyc(A:[]u8)void {
  fact_add(A,1001,201,1002);
  fact_add(A,1002,201,1003);
  fact_add(A,1003,201,1004);
  fact_add(A,1004,201,1005);
  fact_add(A,1001,202,1101); fact_add(A,1001,202,1102);
  fact_add(A,1002,202,1103);
  fact_add(A,1003,202,1104); fact_add(A,1003,202,1105); fact_add(A,1003,202,1106);
  fact_add(A,1004,202,1107);
  fact_add(A,1005,202,1108); fact_add(A,1005,202,1109);
  fact_add(A,1101,203,1102);
  fact_add(A,1201,204,1202); fact_add(A,1201,204,1203);
  map_new(A,0,4,201,0);
  map_new(A,1,1,202,0);
  map_new(A,2,3,0,0);
  map_new(A,3,1,204,0);
  teach(A,0,1001,1002); teach(A,0,1002,1003); teach(A,0,1003,1004);
  teach(A,0,1004,1005); teach(A,0,1005,1005);
  teach(A,1,1001,2); teach(A,1,1002,1); teach(A,1,1003,3);
  teach(A,1,1004,1); teach(A,1,1005,2);
  teach(A,2,1101,1101);
  teach(A,3,1201,2);
  return;
}

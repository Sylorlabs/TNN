// driver.zag -- ADETECT experiment driver.
// Three arms, kill-bar evaluation. The driver teaches X/Y, schedules
// the learner's x_revise_masks consolidation calls, runs the
// learner's construct, and evaluates Z. It never invents the
// intermediate and never computes masks: all mask work goes through
// learner.zag. The driver calls x_maybe_revise as a standing generic
// opportunity; the DECISION to revise is the learner's
// (DET_REVISE_REQ is written only by learner monitor logic).
// Prereg: autonomous_detect/PREREG.md. Pure Zag.

fn d_y_prior(st:[]u8, ob:[]u8, at:i32)i32 {
  y_teach(st,7,1); y_teach(st,8,1); y_teach(st,9,1);
  y_teach(st,3,0); y_teach(st,4,0); y_teach(st,5,0);
  let bs:i32=y_fit(st);
  at=ob_app(ob,at,"Y-PRIOR fit=");
  at=ob_i32(ob,at,bs);
  at=ob_app(ob,at,"/6 t=");
  at=ob_i32(ob,at,get32(st,296));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_old(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_oldseq(i,sq);
    let id:i32=w_oldid(i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    at=ob_app(ob,at,"X-OLD id=");
    at=ob_i32(ob,at,id);
    at=ob_nl(ob,at);
    i=i+1;
  }
  let L:i32=x_learn_len(st);
  x_revise_masks(st);
  at=ob_app(ob,at,"LEARN-LEN L=");
  at=ob_i32(ob,at,L);
  at=ob_app(ob,at," LEARN-MASKS k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
fn d_consolidate(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  x_revise_masks(st);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," MASKS k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_train(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let n:i32=w_n(ph);
  let i:i32=0;
  while(i<n){
    w_seq(ph,i,sq);
    let id:i32=w_id(ph,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    let lb:i32=0;
    if(ph==1){lb=w_true1((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));}
    else {
      if(ph==5){lb=w_true1((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));}
      else {lb=w_true2((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));}
    }
    lab_teach(st,id,lb);
    at=ob_app(ob,at,"X-TRAIN ph=");
    at=ob_i32(ob,at,ph);
    at=ob_app(ob,at," id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," label=");
    at=ob_i32(ob,at,lb);
    at=ob_nl(ob,at);
    i=i+1;
  }
  let L:i32=x_learn_len(st);
  at=ob_app(ob,at,"LEARN-LEN ph=");
  at=ob_i32(ob,at,ph);
  at=ob_app(ob,at," L=");
  at=ob_i32(ob,at,L);
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_test(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let n:i32=w_n(ph);
  let i:i32=0;
  while(i<n){
    w_seq(ph,i,sq);
    let id:i32=w_id(ph,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    at=ob_app(ob,at,"X-TEST ph=");
    at=ob_i32(ob,at,ph);
    at=ob_app(ob,at," id=");
    at=ob_i32(ob,at,id);
    at=ob_nl(ob,at);
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[300] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,304));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[308+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
fn d_adapt_stat(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," L=");
  at=ob_i32(ob,at,(st[4] as i32));
  at=ob_app(ob,at," spec=");
  at=ob_i32(ob,at,get32(st,396));
  at=ob_app(ob,at," calls=");
  at=ob_i32(ob,at,get32(st,400));
  at=ob_nl(ob,at);
  return at;
}
fn d_det_stat(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," baseset=");
  at=ob_i32(ob,at,(st[418] as i32));
  at=ob_app(ob,at," mean=");
  at=ob_i32(ob,at,get32(st,410));
  at=ob_app(ob,at," spread=");
  at=ob_i32(ob,at,get32(st,414));
  at=ob_app(ob,at," run=");
  at=ob_i32(ob,at,(st[419] as i32));
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,(st[420] as i32));
  at=ob_app(ob,at," revs=");
  at=ob_i32(ob,at,get32(st,421));
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
fn d_record_baseline(st:[]u8, ob:[]u8, at:i32)i32 {
  let r:i32=x_record_baseline(st);
  at=ob_app(ob,at,"DET-BASELINE r=");
  at=ob_i32(ob,at,r);
  at=ob_app(ob,at," set=");
  at=ob_i32(ob,at,(st[418] as i32));
  at=ob_app(ob,at," mean=");
  at=ob_i32(ob,at,get32(st,410));
  at=ob_app(ob,at," spread=");
  at=ob_i32(ob,at,get32(st,414));
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,(st[420] as i32));
  at=ob_nl(ob,at);
  return at;
}
fn d_maybe_revise(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  let r:i32=x_maybe_revise(st);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," revised=");
  at=ob_i32(ob,at,r);
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,(st[420] as i32));
  at=ob_app(ob,at," revs=");
  at=ob_i32(ob,at,get32(st,421));
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
// Build M on (eids,labs); res: [0]=n [4]=t [8]=score.
fn d_build_m(st:[]u8, eids:[]u8, labs:[]u8, ne:i32, gen:i32, rg:[]u8, sq:[]u8, vals:[]u8, res:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,"--- construct M (gen ");
  at=ob_i32(ob,at,gen);
  at=ob_app(ob,at,") ---\n");
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct(st,eids,labs,ne,init,0,rg,sq,vals,mbuf,mout,ob,at);
  let mn:i32=get32(mout,0);
  let mt:i32=get32(mout,4);
  let ms:i32=get32(mout,8);
  at=ob_app(ob,at,"M-BUILT n=");
  at=ob_i32(ob,at,mn);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,mt);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,ms);
  at=ob_app(ob,at,"/");
  at=ob_i32(ob,at,ne);
  at=ob_nl(ob,at);
  m_write(st,mn,gen,mt,mbuf);
  if(mn>0){
    set32(st,296,mt);
    at=ob_app(ob,at,"T-AGREE y=");
    at=ob_i32(ob,at,get32(st,296));
    at=ob_app(ob,at," m=");
    at=ob_i32(ob,at,get32(st,304));
    at=ob_nl(ob,at);
  }
  at=d_m_dump(st,"M-STATE",ob,at);
  set32(res,0,mn); set32(res,4,mt); set32(res,8,ms);
  return at;
}
fn d_z_run(st:[]u8, eids:[]u8, ne:i32, ph:i32, rg:[]u8, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let su:i32=st[431] as i32;
    let nr:i32=x_recall(st,id,sq);
    let idx:i32=id-9;
    if(ph==2){idx=id-29;}
    else {
      if(ph==5){idx=id-41;}
    }
    let tl:i32=w_tlabel(ph,idx);
    let sv:i32=-999;
    at=ob_app(ob,at,"Z id=");
    at=ob_i32(ob,at,id);
    if(nr>0){
      let mn:i32=st[300] as i32;
      if(mn>0){
        let mp:[]u8=z_alloc(24);
        let k:i32=0;
        while(k<24){mp[k]=st[308+k];k=k+1;}
        sv=p_exec(mp,mn,(sq[0] as i32),(sq[1] as i32),rg);
      }
      at=ob_app(ob,at," seq=");
      let k:i32=0;
      while(k<nr){
        at=ob_i32(ob,at,(sq[k] as i32));
        if(k<nr-1){at=ob_app(ob,at,",");}
        k=k+1;
      }
    } else {
      at=ob_app(ob,at," seq=none");
    }
    let ok:i32=0;
    if(dec==tl){ok=1;}
    if(ok==1){c=c+1;}
    at=ob_app(ob,at," s=");
    at=ob_i32(ob,at,sv);
    at=ob_app(ob,at," dec=");
    at=ob_i32(ob,at,dec);
    at=ob_app(ob,at," true=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_app(ob,at," surp=");
    at=ob_i32(ob,at,su);
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}
// Z over train episodes, scored against taught labels (driver-side).
fn d_z_run_train(st:[]u8, eids:[]u8, ne:i32, rg:[]u8, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let su:i32=st[431] as i32;
    let tl:i32=lab_get(st,id);
    let ok:i32=0;
    if(dec==tl){ok=1;}
    if(ok==1){c=c+1;}
    at=ob_app(ob,at,"ZT id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," dec=");
    at=ob_i32(ob,at,dec);
    at=ob_app(ob,at," lab=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_app(ob,at," surp=");
    at=ob_i32(ob,at,su);
    at=ob_app(ob,at," req=");
    at=ob_i32(ob,at,(st[420] as i32));
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  let rg:[]u8=z_alloc(8);
  let sq:[]u8=z_alloc(6);
  let vals:[]u8=z_alloc(32);
  let atp:[]u8=z_alloc(4);
  let res:[]u8=z_alloc(12);
  at=ob_app(ob,at,"AUTONOMOUS-DETECT-START\n");

  let eids1:[]u8=z_alloc(8);
  let labs1:[]u8=z_alloc(8);
  let eidsT1:[]u8=z_alloc(4);
  let eids2:[]u8=z_alloc(8);
  let eidsT2:[]u8=z_alloc(4);
  let eidsT5:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<8){
    eids1[i]=(i+1) as u8;
    eids2[i]=(i+21) as u8;
    if(i<4){
      eidsT1[i]=(i+9) as u8;
      eidsT2[i]=(i+29) as u8;
      eidsT5[i]=(i+41) as u8;
    }
    i=i+1;
  }

  // ================= ARM-STABLE (no world change) =================
  at=ob_app(ob,at,"=== ARM-STABLE ===\n");
  let st1:[]u8=z_alloc(2048);
  st1[5]=1;
  at=d_y_prior(st1,ob,at);
  at=d_teach_old(st1,ob,at);
  at=d_teach_train(st1,1,ob,at);
  at=d_teach_test(st1,2,ob,at);
  at=d_consolidate(st1,"CONSOLIDATE-1",ob,at);
  let c1k1:i32=st1[404] as i32;
  let c1k2:i32=st1[405] as i32;
  i=0;
  while(i<8){labs1[i]=lab_get(st1,(i+1)) as u8;i=i+1;}
  at=d_build_m(st1,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  at=d_maybe_revise(st1,"MAYBE-REVISE-PRE",ob,at);
  set32(atp,0,at);
  let z1s:i32=d_z_run(st1,eidsT1,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-PHASE1 ");
  at=ob_i32(ob,at,z1s);
  at=ob_app(ob,at,"/4\n");
  at=d_record_baseline(st1,ob,at);
  at=d_teach_train(st1,5,ob,at);
  set32(atp,0,at);
  let zst:i32=d_z_run(st1,eidsT5,4,5,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-STABLE ");
  at=ob_i32(ob,at,zst);
  at=ob_app(ob,at,"/4\n");
  at=d_maybe_revise(st1,"MAYBE-REVISE-STABLE",ob,at);
  let sreq:i32=st1[420] as i32;
  let srevs:i32=get32(st1,421);
  let sk1:i32=st1[404] as i32;
  let sk2:i32=st1[405] as i32;
  at=d_det_stat(st1,"DET-STAT-STABLE",ob,at);
  at=d_adapt_stat(st1,"ADAPT-STAT-STABLE",ob,at);

  // ================= ARM-CHANGE (world change, autonomous revision) =================
  at=ob_app(ob,at,"=== ARM-CHANGE ===\n");
  let st2:[]u8=z_alloc(2048);
  st2[5]=1;
  at=d_y_prior(st2,ob,at);
  at=d_teach_old(st2,ob,at);
  at=d_teach_train(st2,1,ob,at);
  at=d_teach_test(st2,2,ob,at);
  at=d_consolidate(st2,"CONSOLIDATE-1",ob,at);
  i=0;
  while(i<8){labs1[i]=lab_get(st2,(i+1)) as u8;i=i+1;}
  at=d_build_m(st2,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  set32(atp,0,at);
  let z1c:i32=d_z_run(st2,eidsT1,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-PHASE1 ");
  at=ob_i32(ob,at,z1c);
  at=ob_app(ob,at,"/4\n");
  at=d_record_baseline(st2,ob,at);
  let bset:i32=st2[418] as i32;
  let bmean:i32=get32(st2,410);
  let bspread:i32=get32(st2,414);
  let breq:i32=st2[420] as i32;
  at=d_maybe_revise(st2,"MAYBE-REVISE-PRE",ob,at);
  at=d_teach_train(st2,3,ob,at);
  set32(atp,0,at);
  let zte:i32=d_z_run_train(st2,eids2,8,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-TRAIN-EVAL ");
  at=ob_i32(ob,at,zte);
  at=ob_app(ob,at,"/8\n");
  at=d_det_stat(st2,"DET-STAT-PRE-REVISE",ob,at);
  at=d_maybe_revise(st2,"MAYBE-REVISE-AUTO",ob,at);
  let rrevs:i32=get32(st2,421);
  let rreq:i32=st2[420] as i32;
  let rk1:i32=st2[404] as i32;
  let rk2:i32=st2[405] as i32;
  let rrp:i32=get32(st2,406);
  at=d_teach_test(st2,4,ob,at);
  at=d_m_dump(st2,"M-STATE-POST-REVISE",ob,at);
  set32(atp,0,at);
  let zch:i32=d_z_run(st2,eidsT2,4,2,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-CHANGE ");
  at=ob_i32(ob,at,zch);
  at=ob_app(ob,at,"/4\n");
  let chn:i32=st2[300] as i32;
  let cht:i32=get32(st2,304);
  let chp0:i32=st2[308] as i32;
  let chp1:i32=st2[309] as i32;
  let chp2:i32=st2[310] as i32;
  at=d_det_stat(st2,"DET-STAT-CHANGE",ob,at);
  at=d_adapt_stat(st2,"ADAPT-STAT-CHANGE",ob,at);
  let specCH:i32=get32(st2,396);

  // ================= ARM-NOREVISE (detection fires, revision withheld) =================
  at=ob_app(ob,at,"=== ARM-NOREVISE ===\n");
  let st3:[]u8=z_alloc(2048);
  st3[5]=1;
  at=d_y_prior(st3,ob,at);
  at=d_teach_old(st3,ob,at);
  at=d_teach_train(st3,1,ob,at);
  at=d_teach_test(st3,2,ob,at);
  at=d_consolidate(st3,"CONSOLIDATE-1",ob,at);
  i=0;
  while(i<8){labs1[i]=lab_get(st3,(i+1)) as u8;i=i+1;}
  at=d_build_m(st3,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  set32(atp,0,at);
  let z1n:i32=d_z_run(st3,eidsT1,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-PHASE1 ");
  at=ob_i32(ob,at,z1n);
  at=ob_app(ob,at,"/4\n");
  at=d_record_baseline(st3,ob,at);
  at=d_teach_train(st3,3,ob,at);
  set32(atp,0,at);
  let zten:i32=d_z_run_train(st3,eids2,8,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-TRAIN-EVAL ");
  at=ob_i32(ob,at,zten);
  at=ob_app(ob,at,"/8\n");
  at=ob_app(ob,at,"REVISION-WITHHELD (driver never calls x_maybe_revise)\n");
  at=d_teach_test(st3,4,ob,at);
  set32(atp,0,at);
  let znr:i32=d_z_run(st3,eidsT2,4,2,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-NOREVISE ");
  at=ob_i32(ob,at,znr);
  at=ob_app(ob,at,"/4\n");
  let nreq:i32=st3[420] as i32;
  let nrevs:i32=get32(st3,421);
  let nk1:i32=st3[404] as i32;
  let nk2:i32=st3[405] as i32;
  at=d_det_stat(st3,"DET-STAT-NOREVISE",ob,at);
  at=d_adapt_stat(st3,"ADAPT-STAT-NOREVISE",ob,at);

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KILL BARS ===\n");
  let k1:i32=0;
  if(bset==1){if(bmean==9){if(bspread==4){if(breq==0){k1=1;}}}}
  at=ob_app(ob,at,"K-AD-1 baseline set=");
  at=ob_i32(ob,at,bset);
  at=ob_app(ob,at," mean=");
  at=ob_i32(ob,at,bmean);
  at=ob_app(ob,at," spread=");
  at=ob_i32(ob,at,bspread);
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,breq);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k1);
  at=ob_nl(ob,at);
  let k2:i32=0;
  if(zst==4){if(sreq==0){if(srevs==0){if(sk1==48){if(sk2==12){k2=1;}}}}}
  at=ob_app(ob,at,"K-AD-2 stable-no-trigger zst=");
  at=ob_i32(ob,at,zst);
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,sreq);
  at=ob_app(ob,at," revs=");
  at=ob_i32(ob,at,srevs);
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,sk1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,sk2);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k2);
  at=ob_nl(ob,at);
  let k3:i32=0;
  if(zten==4){if(nreq==1){if(nk1==48){if(nk2==12){if(nrevs==0){if(znr==2){k3=1;}}}}}}
  at=ob_app(ob,at,"K-AD-3 change-detected zte=");
  at=ob_i32(ob,at,zten);
  at=ob_app(ob,at,"/8 nreq=");
  at=ob_i32(ob,at,nreq);
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,nk1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,nk2);
  at=ob_app(ob,at," znr=");
  at=ob_i32(ob,at,znr);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k3);
  at=ob_nl(ob,at);
  let k4:i32=0;
  if(rrevs==1){if(rreq==0){if(rk1==12){if(rk2==48){if(rrp==24){k4=1;}}}}}
  at=ob_app(ob,at,"K-AD-4 autonomous-revision revs=");
  at=ob_i32(ob,at,rrevs);
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,rreq);
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,rk1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,rk2);
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,rrp);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);
  let k5:i32=0;
  if(zch==4){
    if(chn==1){
      if(cht==6){
        if(chp0==1){
          if(chp1==0){
            if(chp2==1){k5=1;}
          }
        }
      }
    }
  }
  at=ob_app(ob,at,"K-AD-5 recovery zch=");
  at=ob_i32(ob,at,zch);
  at=ob_app(ob,at," mn=");
  at=ob_i32(ob,at,chn);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k5);
  at=ob_nl(ob,at);
  let k6:i32=0;
  if(c1k1==48){if(c1k2==12){if(specCH>=1){k6=1;}}}
  at=ob_app(ob,at,"K-AD-6 provenance stable-k1=");
  at=ob_i32(ob,at,c1k1);
  at=ob_app(ob,at," stable-k2=");
  at=ob_i32(ob,at,c1k2);
  at=ob_app(ob,at," specCH=");
  at=ob_i32(ob,at,specCH);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-AD-7 determinism see-shell (3x sha256)\n");
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);

  at=ob_app(ob,at,"AUTONOMOUS-DETECT-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

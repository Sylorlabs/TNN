// learner.zag -- generic autonomous change-detection learner (ADETECT).
// Generic machinery + learned state only. No episode data, no hidden
// world rules, no reduction solution in this file.
// Prereg: autonomous_detect/PREREG.md. Pure Zag.
// 0 modes, 0 handlers, 0 semantic cases, no cross-structure glue.
// Delta vs spec_mask_revision/learner.zag: detection monitor state at
// offsets 410..431; decide() pushes every real decision score to a
// 4-slot ring and runs the surprise monitor; x_record_baseline
// freezes baseline stats; x_maybe_revise revises iff the learner set
// DET_REVISE_REQ. All other machinery unchanged.
//
// State layout (u8 buffer, 2048 bytes, offsets):
//   0: XN   1: LN   2: YN   3: YT_SET
//   4: REPLAY_LEN (learned)   5: ADAPT_ON (driver-set causal control)
//   8..231:   X slots, 32 x 7 bytes [id,tag,s0,s1,s2,s3,s4], 255 = empty
//   232..295: label slots, 32 x 2 bytes [id,label]
//   296..299: Y threshold i32
//   300..331: M slot, 32 bytes [n,gen,sup,pad, threshold i32,
//              program 24 bytes (8 instr x 3) at 308..331]
//   332..363: Mprev slot, 32 bytes (reserved; unused in this build)
//   364..395: Y scalar observations, 16 x 2 bytes [scalar,outcome]
//   396..399: ADAPT-STAT spec_count i32
//   400..403: ADAPT-STAT recall_calls i32
//   404: MASK_K1   405: MASK_K2 (per-kind informative slot bitmasks;
//        bit i set = slot i informative for that kind; slot 0 never set)
//   406..409: REV_PTR i32 (consolidation pointer: episodes with index
//        below REV_PTR are already consolidated into the masks)
//   410..413: DET_BASE_MEAN i32 (baseline mean of decision scores)
//   414..417: DET_BASE_SPREAD i32 (baseline max abs deviation)
//   418: DET_BASE_SET (1 = baseline recorded)
//   419: DET_SURP_RUN (consecutive surprising decisions)
//   420: DET_REVISE_REQ (1 = learner requests revision; written ONLY
//        by the monitor inside decide(), never by the driver)
//   421..424: DET_REV_COUNT i32 (autonomous revisions performed)
//   425..428: DET_RING, last 4 decision scores, one u8 each
//   429: DET_RING_N (slots filled)
//   430: DET_RING_POS (next write position)
//   431: DET_LAST_SURP (surprise flag of the last decision, trace only)
//   432..2047: scratch

fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn get32(b:[]u8, off:i32)i32 {
  return (b[off] as i32) | ((b[off+1] as i32)<<8) | ((b[off+2] as i32)<<16) | ((b[off+3] as i32)<<24);
}
fn set32(b:[]u8, off:i32, v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn ob_app(ob:[]u8, at:i32, s:[]u8)i32 {
  let i:i32=0;
  while(i<s.len){ob[at+i]=s[i];i=i+1;}
  return at+s.len;
}
fn ob_nl(ob:[]u8, at:i32)i32 { ob[at]=10; return at+1; }
fn ob_i32(ob:[]u8, at:i32, v:i32)i32 {
  let neg:i32=0;
  let x:i32=v;
  if(x<0){neg=1;x=0-x;}
  let nd:i32=1;
  let t:i32=x;
  while(t>=10){t=t/10;nd=nd+1;}
  if(neg==1){ob[at]=45;}
  let p:i32=at+neg+nd-1;
  t=x;
  let k:i32=0;
  while(k<nd){ob[p-k]=((t%10)+48) as u8; t=t/10; k=k+1;}
  return at+neg+nd;
}

// ---- X: episode recall (sequence producer) ----
fn x_teach(st:[]u8, id:i32, r0:i32, r1:i32, r2:i32, r3:i32, r4:i32, r5:i32, nfill:i32)void {
  let n:i32=st[0] as i32;
  if(n>=32){return;}
  let o:i32=8+n*7;
  st[o]=id as u8;
  st[o+1]=r0 as u8; st[o+2]=r1 as u8; st[o+3]=r2 as u8;
  st[o+4]=r3 as u8; st[o+5]=r4 as u8; st[o+6]=r5 as u8;
  let k:i32=nfill;
  while(k<6){st[o+1+k]=255;k=k+1;}
  st[0]=(n+1) as u8;
  return;
}
// REPLAY_LEN = longest prefix filled in EVERY taught episode.
fn x_learn_len(st:[]u8)i32 {
  let n:i32=st[0] as i32;
  let L:i32=6;
  let i:i32=0;
  while(i<n){
    let o:i32=8+i*7;
    let k:i32=0;
    while(k<6){
      if((st[o+1+k] as i32)==255){
        if(k<L){L=k;}
        k=6;
      } else { k=k+1; }
    }
    i=i+1;
  }
  if(n==0){L=0;}
  st[4]=L as u8;
  return L;
}
// x_revise_masks: the mask revision mechanism under test.
// Recomputes the per-kind informative slot masks over the episodes
// with index in [REV_PTR, XN) (the not-yet-consolidated window),
// then sets REV_PTR = XN. For kind tag value v in {1,2}: if the
// window holds at least one episode of kind v, MASK_Kv is
// overwritten with bit i (i in 1..5) set iff slot i takes at least
// two distinct values across the window's kind-v episodes; kinds
// absent from the window keep their old mask. The first call (after
// phase-0) is the initial learn; later calls are revisions. The
// trigger timing is driver-scheduled (disclosed experimental
// control); the recomputation is generic learner machinery.
fn x_revise_masks(st:[]u8)void {
  let rp:i32=get32(st,406);
  let n:i32=st[0] as i32;
  if(rp<0){rp=0;}
  if(rp>n){rp=n;}
  let v:i32=1;
  while(v<=2){
    let cnt:i32=0;
    let e:i32=rp;
    while(e<n){
      let o:i32=8+e*7;
      if((st[o+1] as i32)==v){cnt=cnt+1;}
      e=e+1;
    }
    if(cnt>0){
      let mask:i32=0;
      let i:i32=1;
      while(i<=5){
        let seen0:i32=0;
        let first:i32=0;
        let diff:i32=0;
        e=rp;
        while(e<n){
          let o:i32=8+e*7;
          if((st[o+1] as i32)==v){
            let val:i32=st[o+1+i] as i32;
            if(seen0==0){first=val;seen0=1;}
            else { if(val!=first){diff=1;} }
          }
          e=e+1;
        }
        if(diff==1){mask=mask+(1<<i);}
        i=i+1;
      }
      st[404+v-1]=mask as u8;
    }
    v=v+1;
  }
  set32(st,406,n);
  return;
}
// x_recall with the L2 SPECIALIZE standing rule. Finds the episode by
// id (0 = unknown). Iff ADAPT_ON==1, reads the kind tag (slot 0) and,
// when the learned mask for that kind is nonzero, replays exactly the
// masked slots in ascending order. Otherwise replays slots 0..L-1
// (the general fixed replay). Returns readings replayed. Trailing out
// slots are zeroed. The rule is evaluated on every recall; the
// researcher never picks it per problem.
fn x_recall(st:[]u8, id:i32, out:[]u8)i32 {
  let n:i32=st[0] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=8+i*7;
    if((st[o] as i32)==id){
      let nr:i32=0;
      let used_spec:i32=0;
      if((st[5] as i32)==1){
        let k:i32=st[o+1] as i32;
        let m:i32=0;
        if(k==1){m=st[404] as i32;}
        else { if(k==2){m=st[405] as i32;} }
        if(m!=0){
          let s:i32=1;
          let bit:i32=2;
          while(s<=5){
            if(((m/bit)%2)==1){out[nr]=st[o+1+s];nr=nr+1;}
            bit=bit*2;
            s=s+1;
          }
          used_spec=1;
        }
      }
      if(used_spec==0){
        let L:i32=st[4] as i32;
        if(L>6){L=6;}
        let k2:i32=0;
        while(k2<L){out[k2]=st[o+1+k2];k2=k2+1;}
        nr=L;
      }
      let z:i32=nr;
      while(z<6){out[z]=0;z=z+1;}
      set32(st,400,get32(st,400)+1);
      if(used_spec==1){set32(st,396,get32(st,396)+1);}
      return nr;
    }
    i=i+1;
  }
  return 0;
}

// ---- labels: observed outcomes ----
fn lab_teach(st:[]u8, id:i32, lab:i32)void {
  let n:i32=st[1] as i32;
  if(n>=32){return;}
  let o:i32=232+n*2;
  st[o]=id as u8; st[o+1]=lab as u8;
  st[1]=(n+1) as u8;
  return;
}
fn lab_get(st:[]u8, id:i32)i32 {
  let n:i32=st[1] as i32;
  let i:i32=0;
  while(i<n){
    let o:i32=232+i*2;
    if((st[o] as i32)==id){return st[o+1] as i32;}
    i=i+1;
  }
  return -1;
}

// ---- Y: threshold decide (scalar consumer) ----
fn y_teach(st:[]u8, s:i32, oc:i32)void {
  let n:i32=st[2] as i32;
  if(n>=16){return;}
  let o:i32=364+n*2;
  st[o]=s as u8; st[o+1]=oc as u8;
  st[2]=(n+1) as u8;
  return;
}
fn y_fit(st:[]u8)i32 {
  let n:i32=st[2] as i32;
  let bt:i32=0;
  let bs:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=0;
    let i:i32=0;
    while(i<n){
      let o:i32=364+i*2;
      let s:i32=st[o] as i32;
      let oc:i32=st[o+1] as i32;
      let p:i32=0;
      if(s>=t){p=1;}
      if(p==oc){c=c+1;}
      i=i+1;
    }
    if(c>bs){bs=c;bt=t;}
    t=t+1;
  }
  set32(st,296,bt);
  st[3]=1;
  return bs;
}
fn y_decide(st:[]u8, s:i32)i32 {
  if((st[3] as i32)==0){return -1;}
  let t:i32=get32(st,296);
  if(s>=t){return 1;}
  return 0;
}

// ---- reduction program executor ----
// ops: 0=CPY 1=ADD 2=SUB 3=MAX 4=MIN. R0,R1 preloaded with readings.
fn p_exec(prog:[]u8, n:i32, r0:i32, r1:i32, rg:[]u8)i32 {
  set32(rg,0,r0); set32(rg,4,r1);
  let k:i32=0;
  while(k<n){
    let op:i32=prog[k*3] as i32;
    let d:i32=prog[k*3+1] as i32;
    let s:i32=prog[k*3+2] as i32;
    let rd:i32=get32(rg,d*4);
    let rs:i32=get32(rg,s*4);
    if(op==0){set32(rg,d*4,rs);}
    else {
      if(op==1){set32(rg,d*4,rd+rs);}
      else {
        if(op==2){set32(rg,d*4,rd-rs);}
        else {
          if(op==3){
            if(rs>rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          } else {
            if(rs<rd){set32(rg,d*4,rs);} else {set32(rg,d*4,rd);}
          }
        }
      }
    }
    k=k+1;
  }
  return get32(rg,0);
}
fn p_outs(prog:[]u8, n:i32, st:[]u8, eids:[]u8, ne:i32, rg:[]u8, sq:[]u8, vals:[]u8)void {
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let f:i32=x_recall(st,id,sq);
    let v:i32=-999;
    if(f>0){
      v=p_exec(prog,n,(sq[0] as i32),(sq[1] as i32),rg);
    }
    set32(vals,i*4,v);
    i=i+1;
  }
  return;
}
fn count_correct(vals:[]u8, labs:[]u8, ne:i32, t:i32)i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let v:i32=get32(vals,i*4);
    let p:i32=0;
    if(v>=t){p=1;}
    if(p==(labs[i] as i32)){c=c+1;}
    i=i+1;
  }
  return c;
}
fn best_t_of_vals(vals:[]u8, labs:[]u8, ne:i32, out:[]u8)i32 {
  let bt:i32=0;
  let bc:i32=-1;
  let t:i32=0;
  while(t<=40){
    let c:i32=count_correct(vals,labs,ne,t);
    if(c>bc){bc=c;bt=t;}
    t=t+1;
  }
  set32(out,0,bt);
  return bc;
}

// ---- construct: greedy program construction from experience ----
// mbuf (24B) gets the final program; mout: [0]=n [4]=threshold [8]=score.
// Trace lines are appended to ob; returns new at.
fn construct(st:[]u8, eids:[]u8, labs:[]u8, ne:i32, init:[]u8, initn:i32, rg:[]u8, sq:[]u8, vals:[]u8, mbuf:[]u8, mout:[]u8, ob:[]u8, at:i32)i32 {
  let cur:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<initn*3){cur[k]=init[k];k=k+1;}
  let cn:i32=initn;
  p_outs(cur,cn,st,eids,ne,rg,sq,vals);
  let bto:[]u8=z_alloc(4);
  let bs:i32=best_t_of_vals(vals,labs,ne,bto);
  let bt:i32=get32(bto,0);
  let round:i32=0;
  let go:i32=1;
  while(go==1){
    if(cn>=8){go=0;}
    else {
      round=round+1;
      let bg:i32=0;
      let bop:i32=-1;
      let bd:i32=0;
      let bss:i32=0;
      let neval:i32=0;
      let op:i32=0;
      while(op<5){
        let d:i32=0;
        while(d<2){
          let s:i32=0;
          while(s<2){
            let cand:[]u8=z_alloc(24);
            let j:i32=0;
            while(j<cn*3){cand[j]=cur[j];j=j+1;}
            cand[cn*3]=op as u8; cand[cn*3+1]=d as u8; cand[cn*3+2]=s as u8;
            p_outs(cand,cn+1,st,eids,ne,rg,sq,vals);
            let cto:[]u8=z_alloc(4);
            let cs:i32=best_t_of_vals(vals,labs,ne,cto);
            neval=neval+1;
            let gain:i32=cs-bs;
            if(gain>bg){bg=gain;bop=op;bd=d;bss=s;}
            s=s+1;
          }
          d=d+1;
        }
        op=op+1;
      }
      at=ob_app(ob,at,"C-ROUND ");
      at=ob_i32(ob,at,round);
      at=ob_app(ob,at," base=");
      at=ob_i32(ob,at,bs);
      at=ob_app(ob,at," eval=");
      at=ob_i32(ob,at,neval);
      if(bg>0){
        at=ob_app(ob,at," win=");
        at=ob_i32(ob,at,bop);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bd);
        at=ob_app(ob,at,",");
        at=ob_i32(ob,at,bss);
        at=ob_app(ob,at," gain=");
        at=ob_i32(ob,at,bg);
        cur[cn*3]=bop as u8; cur[cn*3+1]=bd as u8; cur[cn*3+2]=bss as u8;
        cn=cn+1;
        p_outs(cur,cn,st,eids,ne,rg,sq,vals);
        bs=best_t_of_vals(vals,labs,ne,bto);
        bt=get32(bto,0);
        at=ob_app(ob,at," score=");
        at=ob_i32(ob,at,bs);
        at=ob_app(ob,at," t=");
        at=ob_i32(ob,at,bt);
        at=ob_nl(ob,at);
      } else {
        at=ob_app(ob,at," stop");
        at=ob_nl(ob,at);
        go=0;
      }
    }
  }
  k=0;
  while(k<24){mbuf[k]=cur[k];k=k+1;}
  set32(mout,0,cn);
  set32(mout,4,bt);
  set32(mout,8,bs);
  return at;
}

// ---- M slot bookkeeping ----
fn m_write(st:[]u8, n:i32, gen:i32, t:i32, prog:[]u8)void {
  st[300]=n as u8; st[301]=gen as u8; st[302]=0; st[303]=0;
  set32(st,304,t);
  let k:i32=0;
  while(k<24){st[308+k]=prog[k];k=k+1;}
  return;
}
fn m_wipe(st:[]u8)void {
  let k:i32=0;
  while(k<32){st[300+k]=0;k=k+1;}
  return;
}

// ---- autonomous change detection (the mechanism under test) ----
// det_push: records every real decision score in the 4-slot ring and
// runs the surprise monitor. A score is surprising iff its absolute
// deviation from the recorded baseline mean strictly exceeds the
// recorded baseline spread. Three consecutive surprising decisions
// set DET_REVISE_REQ in learner state. The driver never writes
// offset 420. The trigger count 3 is a frozen generic parameter.
fn det_push(st:[]u8, s:i32)void {
  let pos:i32=st[430] as i32;
  st[425+pos]=s as u8;
  pos=pos+1;
  if(pos>=4){pos=0;}
  st[430]=pos as u8;
  let nn:i32=st[429] as i32;
  if(nn<4){st[429]=(nn+1) as u8;}
  let surp:i32=0;
  if((st[418] as i32)==1){
    let mean:i32=get32(st,410);
    let spread:i32=get32(st,414);
    let d:i32=s-mean;
    if(d<0){d=0-d;}
    if(d>spread){
      surp=1;
      let run:i32=(st[419] as i32)+1;
      st[419]=run as u8;
      if(run>=3){st[420]=1;}
    } else {
      st[419]=0;
    }
  }
  st[431]=surp as u8;
  return;
}
// x_record_baseline: freeze baseline stats from the last 4 decision
// scores in the ring. Driver-scheduled (disclosed experimental
// control); the stats themselves come only from learner experience.
fn x_record_baseline(st:[]u8)i32 {
  if((st[429] as i32)<4){return 0;}
  let sum:i32=0;
  let i:i32=0;
  while(i<4){sum=sum+(st[425+i] as i32);i=i+1;}
  let mean:i32=sum/4;
  let spread:i32=0;
  i=0;
  while(i<4){
    let d:i32=(st[425+i] as i32)-mean;
    if(d<0){d=0-d;}
    if(d>spread){spread=d;}
    i=i+1;
  }
  set32(st,410,mean);
  set32(st,414,spread);
  st[418]=1;
  st[419]=0;
  return 1;
}
// x_maybe_revise: the autonomous trigger point. The driver calls this
// after every batch as a standing generic opportunity; the learner
// revises iff its own monitor set DET_REVISE_REQ. On revision it
// runs the unchanged generic x_revise_masks, clears the request,
// and counts the revision. Returns 1 when it revised, else 0.
fn x_maybe_revise(st:[]u8)i32 {
  if((st[420] as i32)==1){
    x_revise_masks(st);
    st[420]=0;
    st[419]=0;
    set32(st,421,get32(st,421)+1);
    return 1;
  }
  return 0;
}
// ---- decide: X -> M -> Y; -1 = NO_DECISION ----
fn decide(st:[]u8, id:i32, rg:[]u8, sq:[]u8)i32 {
  let nr:i32=x_recall(st,id,sq);
  if(nr==0){return -1;}
  let mn:i32=st[300] as i32;
  if(mn==0){return -1;}
  if((st[3] as i32)==0){return -1;}
  let mprog:[]u8=z_alloc(24);
  let k:i32=0;
  while(k<24){mprog[k]=st[308+k];k=k+1;}
  let s:i32=p_exec(mprog,mn,(sq[0] as i32),(sq[1] as i32),rg);
  det_push(st,s);
  return y_decide(st,s);
}
// world.zag -- ADETECT environment (EXPERIMENT SIDE ONLY).
// Hidden labeling rules and episode tables. The learner never calls
// anything in this file. The driver uses the hidden rules only to
// generate observed labels for teaching.
// Phase 0/1/2 tables match spec_mask_revision/world.zag exactly.
// Phase 5 is new: a STABLE-world batch (same distribution as phase 1,
// new ids 41..44) for the no-false-trigger arm.

// Phase 0: old-world episodes, 6 readings each (fully filled).
fn w_oldtab()[]u8 { return "100037100082205100202600"; }
fn w_oldid(idx:i32)i32 { return idx+51; }
fn w_oldseq(idx:i32, out:[]u8)void {
  let T:[]u8=w_oldtab();
  let k:i32=0;
  while(k<6){
    out[k]=((T[idx*6+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}

// Phase 1: ph=1 train (8 episodes x 6 readings), ph=2 test (4 x 6).
// Phase 2: ph=3 train (8 x 6), ph=4 test (4 x 6).
// Phase 5: stable-world batch (4 x 6), same distribution as phase 1.
fn w_tab(ph:i32)[]u8 {
  if(ph==1){return "100049100094100041100014204900209400204100201400";}
  if(ph==2){return "100058100032207600202300";}
  if(ph==3){return "104900109400104100101400200049200094200041200014";}
  if(ph==5){return "100049100014204900201400";}
  return "105800103200200076200023";
}
fn w_n(ph:i32)i32 {
  if(ph==1){return 8;}
  if(ph==2){return 4;}
  if(ph==3){return 8;}
  if(ph==5){return 4;}
  return 4;
}
fn w_id(ph:i32, idx:i32)i32 {
  if(ph==1){return idx+1;}
  if(ph==2){return idx+9;}
  if(ph==3){return idx+21;}
  if(ph==5){return idx+41;}
  return idx+29;
}
fn w_seq(ph:i32, idx:i32, out:[]u8)void {
  let T:[]u8=w_tab(ph);
  let k:i32=0;
  while(k<6){
    out[k]=((T[idx*6+k] as i32)-48) as u8;
    k=k+1;
  }
  return;
}
// Frozen test labels (driver Z-line true values).
// Phase 1 test ids 9..12 and phase 2 test ids 29..32 are both 1,0,1,0.
fn w_tlabel(ph:i32, idx:i32)i32 {
  if(idx==0){return 1;}
  if(idx==1){return 0;}
  if(idx==2){return 1;}
  return 0;
}

// Hidden world rule, phase 1 (never visible to the learner).
// PICK iff the kind's signal pair sums >= 10:
// kind 1 uses slots (d,e); kind 2 uses slots (b,c).
fn w_true1(k:i32, a:i32, b:i32, c:i32, d:i32, e:i32)i32 {
  if(k==1){
    if(d+e>=10){return 1;}
    return 0;
  }
  if(b+c>=10){return 1;}
  return 0;
}

// Hidden world rule, phase 2: the informative slots MOVE
// (never visible to the learner).
// PICK iff the kind's NEW signal pair sums >= 10:
// kind 1 uses slots (b,c); kind 2 uses slots (d,e).
// The old slots carry zeros.
fn w_true2(k:i32, a:i32, b:i32, c:i32, d:i32, e:i32)i32 {
  if(k==1){
    if(b+c>=10){return 1;}
    return 0;
  }
  if(d+e>=10){return 1;}
  return 0;
}
// driver.zag -- ADETECT experiment driver.
// Three arms, kill-bar evaluation. The driver teaches X/Y, schedules
// the learner's x_revise_masks consolidation calls, runs the
// learner's construct, and evaluates Z. It never invents the
// intermediate and never computes masks: all mask work goes through
// learner.zag. The driver calls x_maybe_revise as a standing generic
// opportunity; the DECISION to revise is the learner's
// (DET_REVISE_REQ is written only by learner monitor logic).
// Prereg: autonomous_detect/PREREG.md. Pure Zag.

fn d_y_prior(st:[]u8, ob:[]u8, at:i32)i32 {
  y_teach(st,7,1); y_teach(st,8,1); y_teach(st,9,1);
  y_teach(st,3,0); y_teach(st,4,0); y_teach(st,5,0);
  let bs:i32=y_fit(st);
  at=ob_app(ob,at,"Y-PRIOR fit=");
  at=ob_i32(ob,at,bs);
  at=ob_app(ob,at,"/6 t=");
  at=ob_i32(ob,at,get32(st,296));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_old(st:[]u8, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let i:i32=0;
  while(i<4){
    w_oldseq(i,sq);
    let id:i32=w_oldid(i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    at=ob_app(ob,at,"X-OLD id=");
    at=ob_i32(ob,at,id);
    at=ob_nl(ob,at);
    i=i+1;
  }
  let L:i32=x_learn_len(st);
  x_revise_masks(st);
  at=ob_app(ob,at,"LEARN-LEN L=");
  at=ob_i32(ob,at,L);
  at=ob_app(ob,at," LEARN-MASKS k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
fn d_consolidate(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  x_revise_masks(st);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," MASKS k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_train(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let n:i32=w_n(ph);
  let i:i32=0;
  while(i<n){
    w_seq(ph,i,sq);
    let id:i32=w_id(ph,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    let lb:i32=0;
    if(ph==1){lb=w_true1((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));}
    else {
      if(ph==5){lb=w_true1((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));}
      else {lb=w_true2((sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32));}
    }
    lab_teach(st,id,lb);
    at=ob_app(ob,at,"X-TRAIN ph=");
    at=ob_i32(ob,at,ph);
    at=ob_app(ob,at," id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," label=");
    at=ob_i32(ob,at,lb);
    at=ob_nl(ob,at);
    i=i+1;
  }
  let L:i32=x_learn_len(st);
  at=ob_app(ob,at,"LEARN-LEN ph=");
  at=ob_i32(ob,at,ph);
  at=ob_app(ob,at," L=");
  at=ob_i32(ob,at,L);
  at=ob_nl(ob,at);
  return at;
}
fn d_teach_test(st:[]u8, ph:i32, ob:[]u8, at:i32)i32 {
  let sq:[]u8=z_alloc(6);
  let n:i32=w_n(ph);
  let i:i32=0;
  while(i<n){
    w_seq(ph,i,sq);
    let id:i32=w_id(ph,i);
    x_teach(st,id,(sq[0] as i32),(sq[1] as i32),(sq[2] as i32),(sq[3] as i32),(sq[4] as i32),(sq[5] as i32),6);
    at=ob_app(ob,at,"X-TEST ph=");
    at=ob_i32(ob,at,ph);
    at=ob_app(ob,at," id=");
    at=ob_i32(ob,at,id);
    at=ob_nl(ob,at);
    i=i+1;
  }
  return at;
}
fn d_m_dump(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," n=");
  at=ob_i32(ob,at,(st[300] as i32));
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,get32(st,304));
  at=ob_app(ob,at," prog=");
  let k:i32=0;
  while(k<24){
    at=ob_i32(ob,at,(st[308+k] as i32));
    if(k<23){at=ob_app(ob,at,",");}
    k=k+1;
  }
  at=ob_nl(ob,at);
  return at;
}
fn d_adapt_stat(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," L=");
  at=ob_i32(ob,at,(st[4] as i32));
  at=ob_app(ob,at," spec=");
  at=ob_i32(ob,at,get32(st,396));
  at=ob_app(ob,at," calls=");
  at=ob_i32(ob,at,get32(st,400));
  at=ob_nl(ob,at);
  return at;
}
fn d_det_stat(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," baseset=");
  at=ob_i32(ob,at,(st[418] as i32));
  at=ob_app(ob,at," mean=");
  at=ob_i32(ob,at,get32(st,410));
  at=ob_app(ob,at," spread=");
  at=ob_i32(ob,at,get32(st,414));
  at=ob_app(ob,at," run=");
  at=ob_i32(ob,at,(st[419] as i32));
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,(st[420] as i32));
  at=ob_app(ob,at," revs=");
  at=ob_i32(ob,at,get32(st,421));
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
fn d_record_baseline(st:[]u8, ob:[]u8, at:i32)i32 {
  let r:i32=x_record_baseline(st);
  at=ob_app(ob,at,"DET-BASELINE r=");
  at=ob_i32(ob,at,r);
  at=ob_app(ob,at," set=");
  at=ob_i32(ob,at,(st[418] as i32));
  at=ob_app(ob,at," mean=");
  at=ob_i32(ob,at,get32(st,410));
  at=ob_app(ob,at," spread=");
  at=ob_i32(ob,at,get32(st,414));
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,(st[420] as i32));
  at=ob_nl(ob,at);
  return at;
}
fn d_maybe_revise(st:[]u8, tag:[]u8, ob:[]u8, at:i32)i32 {
  let r:i32=x_maybe_revise(st);
  at=ob_app(ob,at,tag);
  at=ob_app(ob,at," revised=");
  at=ob_i32(ob,at,r);
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,(st[420] as i32));
  at=ob_app(ob,at," revs=");
  at=ob_i32(ob,at,get32(st,421));
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,(st[404] as i32));
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,(st[405] as i32));
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,get32(st,406));
  at=ob_nl(ob,at);
  return at;
}
// Build M on (eids,labs); res: [0]=n [4]=t [8]=score.
fn d_build_m(st:[]u8, eids:[]u8, labs:[]u8, ne:i32, gen:i32, rg:[]u8, sq:[]u8, vals:[]u8, res:[]u8, ob:[]u8, at:i32)i32 {
  at=ob_app(ob,at,"--- construct M (gen ");
  at=ob_i32(ob,at,gen);
  at=ob_app(ob,at,") ---\n");
  let init:[]u8=z_alloc(24);
  let mbuf:[]u8=z_alloc(24);
  let mout:[]u8=z_alloc(12);
  at=construct(st,eids,labs,ne,init,0,rg,sq,vals,mbuf,mout,ob,at);
  let mn:i32=get32(mout,0);
  let mt:i32=get32(mout,4);
  let ms:i32=get32(mout,8);
  at=ob_app(ob,at,"M-BUILT n=");
  at=ob_i32(ob,at,mn);
  at=ob_app(ob,at," t=");
  at=ob_i32(ob,at,mt);
  at=ob_app(ob,at," score=");
  at=ob_i32(ob,at,ms);
  at=ob_app(ob,at,"/");
  at=ob_i32(ob,at,ne);
  at=ob_nl(ob,at);
  m_write(st,mn,gen,mt,mbuf);
  if(mn>0){
    set32(st,296,mt);
    at=ob_app(ob,at,"T-AGREE y=");
    at=ob_i32(ob,at,get32(st,296));
    at=ob_app(ob,at," m=");
    at=ob_i32(ob,at,get32(st,304));
    at=ob_nl(ob,at);
  }
  at=d_m_dump(st,"M-STATE",ob,at);
  set32(res,0,mn); set32(res,4,mt); set32(res,8,ms);
  return at;
}
fn d_z_run(st:[]u8, eids:[]u8, ne:i32, ph:i32, rg:[]u8, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let su:i32=st[431] as i32;
    let nr:i32=x_recall(st,id,sq);
    let idx:i32=id-9;
    if(ph==2){idx=id-29;}
    else {
      if(ph==5){idx=id-41;}
    }
    let tl:i32=w_tlabel(ph,idx);
    let sv:i32=-999;
    at=ob_app(ob,at,"Z id=");
    at=ob_i32(ob,at,id);
    if(nr>0){
      let mn:i32=st[300] as i32;
      if(mn>0){
        let mp:[]u8=z_alloc(24);
        let k:i32=0;
        while(k<24){mp[k]=st[308+k];k=k+1;}
        sv=p_exec(mp,mn,(sq[0] as i32),(sq[1] as i32),rg);
      }
      at=ob_app(ob,at," seq=");
      let k:i32=0;
      while(k<nr){
        at=ob_i32(ob,at,(sq[k] as i32));
        if(k<nr-1){at=ob_app(ob,at,",");}
        k=k+1;
      }
    } else {
      at=ob_app(ob,at," seq=none");
    }
    let ok:i32=0;
    if(dec==tl){ok=1;}
    if(ok==1){c=c+1;}
    at=ob_app(ob,at," s=");
    at=ob_i32(ob,at,sv);
    at=ob_app(ob,at," dec=");
    at=ob_i32(ob,at,dec);
    at=ob_app(ob,at," true=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_app(ob,at," surp=");
    at=ob_i32(ob,at,su);
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}
// Z over train episodes, scored against taught labels (driver-side).
fn d_z_run_train(st:[]u8, eids:[]u8, ne:i32, rg:[]u8, sq:[]u8, ob:[]u8, atp:[]u8)i32 {
  let at:i32=get32(atp,0);
  let c:i32=0;
  let i:i32=0;
  while(i<ne){
    let id:i32=eids[i] as i32;
    let dec:i32=decide(st,id,rg,sq);
    let su:i32=st[431] as i32;
    let tl:i32=lab_get(st,id);
    let ok:i32=0;
    if(dec==tl){ok=1;}
    if(ok==1){c=c+1;}
    at=ob_app(ob,at,"ZT id=");
    at=ob_i32(ob,at,id);
    at=ob_app(ob,at," dec=");
    at=ob_i32(ob,at,dec);
    at=ob_app(ob,at," lab=");
    at=ob_i32(ob,at,tl);
    at=ob_app(ob,at," ok=");
    at=ob_i32(ob,at,ok);
    at=ob_app(ob,at," surp=");
    at=ob_i32(ob,at,su);
    at=ob_app(ob,at," req=");
    at=ob_i32(ob,at,(st[420] as i32));
    at=ob_nl(ob,at);
    i=i+1;
  }
  set32(atp,0,at);
  return c;
}

fn main()i32 {
  let ob:[]u8=z_alloc(65536);
  let at:i32=0;
  let rg:[]u8=z_alloc(8);
  let sq:[]u8=z_alloc(6);
  let vals:[]u8=z_alloc(32);
  let atp:[]u8=z_alloc(4);
  let res:[]u8=z_alloc(12);
  at=ob_app(ob,at,"AUTONOMOUS-DETECT-START\n");

  let eids1:[]u8=z_alloc(8);
  let labs1:[]u8=z_alloc(8);
  let eidsT1:[]u8=z_alloc(4);
  let eids2:[]u8=z_alloc(8);
  let eidsT2:[]u8=z_alloc(4);
  let eidsT5:[]u8=z_alloc(4);
  let i:i32=0;
  while(i<8){
    eids1[i]=(i+1) as u8;
    eids2[i]=(i+21) as u8;
    if(i<4){
      eidsT1[i]=(i+9) as u8;
      eidsT2[i]=(i+29) as u8;
      eidsT5[i]=(i+41) as u8;
    }
    i=i+1;
  }

  // ================= ARM-STABLE (no world change) =================
  at=ob_app(ob,at,"=== ARM-STABLE ===\n");
  let st1:[]u8=z_alloc(2048);
  st1[5]=1;
  at=d_y_prior(st1,ob,at);
  at=d_teach_old(st1,ob,at);
  at=d_teach_train(st1,1,ob,at);
  at=d_teach_test(st1,2,ob,at);
  at=d_consolidate(st1,"CONSOLIDATE-1",ob,at);
  let c1k1:i32=st1[404] as i32;
  let c1k2:i32=st1[405] as i32;
  i=0;
  while(i<8){labs1[i]=lab_get(st1,(i+1)) as u8;i=i+1;}
  at=d_build_m(st1,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  at=d_maybe_revise(st1,"MAYBE-REVISE-PRE",ob,at);
  set32(atp,0,at);
  let z1s:i32=d_z_run(st1,eidsT1,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-PHASE1 ");
  at=ob_i32(ob,at,z1s);
  at=ob_app(ob,at,"/4\n");
  at=d_record_baseline(st1,ob,at);
  at=d_teach_train(st1,5,ob,at);
  set32(atp,0,at);
  let zst:i32=d_z_run(st1,eidsT5,4,5,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-STABLE ");
  at=ob_i32(ob,at,zst);
  at=ob_app(ob,at,"/4\n");
  at=d_maybe_revise(st1,"MAYBE-REVISE-STABLE",ob,at);
  let sreq:i32=st1[420] as i32;
  let srevs:i32=get32(st1,421);
  let sk1:i32=st1[404] as i32;
  let sk2:i32=st1[405] as i32;
  at=d_det_stat(st1,"DET-STAT-STABLE",ob,at);
  at=d_adapt_stat(st1,"ADAPT-STAT-STABLE",ob,at);

  // ================= ARM-CHANGE (world change, autonomous revision) =================
  at=ob_app(ob,at,"=== ARM-CHANGE ===\n");
  let st2:[]u8=z_alloc(2048);
  st2[5]=1;
  at=d_y_prior(st2,ob,at);
  at=d_teach_old(st2,ob,at);
  at=d_teach_train(st2,1,ob,at);
  at=d_teach_test(st2,2,ob,at);
  at=d_consolidate(st2,"CONSOLIDATE-1",ob,at);
  i=0;
  while(i<8){labs1[i]=lab_get(st2,(i+1)) as u8;i=i+1;}
  at=d_build_m(st2,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  set32(atp,0,at);
  let z1c:i32=d_z_run(st2,eidsT1,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-PHASE1 ");
  at=ob_i32(ob,at,z1c);
  at=ob_app(ob,at,"/4\n");
  at=d_record_baseline(st2,ob,at);
  let bset:i32=st2[418] as i32;
  let bmean:i32=get32(st2,410);
  let bspread:i32=get32(st2,414);
  let breq:i32=st2[420] as i32;
  at=d_maybe_revise(st2,"MAYBE-REVISE-PRE",ob,at);
  at=d_teach_train(st2,3,ob,at);
  set32(atp,0,at);
  let zte:i32=d_z_run_train(st2,eids2,8,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-TRAIN-EVAL ");
  at=ob_i32(ob,at,zte);
  at=ob_app(ob,at,"/8\n");
  at=d_det_stat(st2,"DET-STAT-PRE-REVISE",ob,at);
  at=d_maybe_revise(st2,"MAYBE-REVISE-AUTO",ob,at);
  let rrevs:i32=get32(st2,421);
  let rreq:i32=st2[420] as i32;
  let rk1:i32=st2[404] as i32;
  let rk2:i32=st2[405] as i32;
  let rrp:i32=get32(st2,406);
  at=d_teach_test(st2,4,ob,at);
  at=d_m_dump(st2,"M-STATE-POST-REVISE",ob,at);
  set32(atp,0,at);
  let zch:i32=d_z_run(st2,eidsT2,4,2,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-CHANGE ");
  at=ob_i32(ob,at,zch);
  at=ob_app(ob,at,"/4\n");
  let chn:i32=st2[300] as i32;
  let cht:i32=get32(st2,304);
  let chp0:i32=st2[308] as i32;
  let chp1:i32=st2[309] as i32;
  let chp2:i32=st2[310] as i32;
  at=d_det_stat(st2,"DET-STAT-CHANGE",ob,at);
  at=d_adapt_stat(st2,"ADAPT-STAT-CHANGE",ob,at);
  let specCH:i32=get32(st2,396);

  // ================= ARM-NOREVISE (detection fires, revision withheld) =================
  at=ob_app(ob,at,"=== ARM-NOREVISE ===\n");
  let st3:[]u8=z_alloc(2048);
  st3[5]=1;
  at=d_y_prior(st3,ob,at);
  at=d_teach_old(st3,ob,at);
  at=d_teach_train(st3,1,ob,at);
  at=d_teach_test(st3,2,ob,at);
  at=d_consolidate(st3,"CONSOLIDATE-1",ob,at);
  i=0;
  while(i<8){labs1[i]=lab_get(st3,(i+1)) as u8;i=i+1;}
  at=d_build_m(st3,eids1,labs1,8,1,rg,sq,vals,res,ob,at);
  set32(atp,0,at);
  let z1n:i32=d_z_run(st3,eidsT1,4,1,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-PHASE1 ");
  at=ob_i32(ob,at,z1n);
  at=ob_app(ob,at,"/4\n");
  at=d_record_baseline(st3,ob,at);
  at=d_teach_train(st3,3,ob,at);
  set32(atp,0,at);
  let zten:i32=d_z_run_train(st3,eids2,8,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-TRAIN-EVAL ");
  at=ob_i32(ob,at,zten);
  at=ob_app(ob,at,"/8\n");
  at=ob_app(ob,at,"REVISION-WITHHELD (driver never calls x_maybe_revise)\n");
  at=d_teach_test(st3,4,ob,at);
  set32(atp,0,at);
  let znr:i32=d_z_run(st3,eidsT2,4,2,rg,sq,ob,atp);
  at=get32(atp,0);
  at=ob_app(ob,at,"Z-NOREVISE ");
  at=ob_i32(ob,at,znr);
  at=ob_app(ob,at,"/4\n");
  let nreq:i32=st3[420] as i32;
  let nrevs:i32=get32(st3,421);
  let nk1:i32=st3[404] as i32;
  let nk2:i32=st3[405] as i32;
  at=d_det_stat(st3,"DET-STAT-NOREVISE",ob,at);
  at=d_adapt_stat(st3,"ADAPT-STAT-NOREVISE",ob,at);

  // ================= KILL BARS =================
  at=ob_app(ob,at,"=== KILL BARS ===\n");
  let k1:i32=0;
  if(bset==1){if(bmean==9){if(bspread==4){if(breq==0){k1=1;}}}}
  at=ob_app(ob,at,"K-AD-1 baseline set=");
  at=ob_i32(ob,at,bset);
  at=ob_app(ob,at," mean=");
  at=ob_i32(ob,at,bmean);
  at=ob_app(ob,at," spread=");
  at=ob_i32(ob,at,bspread);
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,breq);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k1);
  at=ob_nl(ob,at);
  let k2:i32=0;
  if(zst==4){if(sreq==0){if(srevs==0){if(sk1==48){if(sk2==12){k2=1;}}}}}
  at=ob_app(ob,at,"K-AD-2 stable-no-trigger zst=");
  at=ob_i32(ob,at,zst);
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,sreq);
  at=ob_app(ob,at," revs=");
  at=ob_i32(ob,at,srevs);
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,sk1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,sk2);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k2);
  at=ob_nl(ob,at);
  let k3:i32=0;
  if(zten==4){if(nreq==1){if(nk1==48){if(nk2==12){if(nrevs==0){if(znr==2){k3=1;}}}}}}
  at=ob_app(ob,at,"K-AD-3 change-detected zte=");
  at=ob_i32(ob,at,zten);
  at=ob_app(ob,at,"/8 nreq=");
  at=ob_i32(ob,at,nreq);
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,nk1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,nk2);
  at=ob_app(ob,at," znr=");
  at=ob_i32(ob,at,znr);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k3);
  at=ob_nl(ob,at);
  let k4:i32=0;
  if(rrevs==1){if(rreq==0){if(rk1==12){if(rk2==48){if(rrp==24){k4=1;}}}}}
  at=ob_app(ob,at,"K-AD-4 autonomous-revision revs=");
  at=ob_i32(ob,at,rrevs);
  at=ob_app(ob,at," req=");
  at=ob_i32(ob,at,rreq);
  at=ob_app(ob,at," k1=");
  at=ob_i32(ob,at,rk1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,rk2);
  at=ob_app(ob,at," revptr=");
  at=ob_i32(ob,at,rrp);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k4);
  at=ob_nl(ob,at);
  let k5:i32=0;
  if(zch==4){
    if(chn==1){
      if(cht==6){
        if(chp0==1){
          if(chp1==0){
            if(chp2==1){k5=1;}
          }
        }
      }
    }
  }
  at=ob_app(ob,at,"K-AD-5 recovery zch=");
  at=ob_i32(ob,at,zch);
  at=ob_app(ob,at," mn=");
  at=ob_i32(ob,at,chn);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k5);
  at=ob_nl(ob,at);
  let k6:i32=0;
  if(c1k1==48){if(c1k2==12){if(specCH>=1){k6=1;}}}
  at=ob_app(ob,at,"K-AD-6 provenance stable-k1=");
  at=ob_i32(ob,at,c1k1);
  at=ob_app(ob,at," stable-k2=");
  at=ob_i32(ob,at,c1k2);
  at=ob_app(ob,at," specCH=");
  at=ob_i32(ob,at,specCH);
  at=ob_app(ob,at," PASS=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);
  at=ob_app(ob,at,"K-AD-7 determinism see-shell (3x sha256)\n");
  at=ob_app(ob,at,"BARS k1=");
  at=ob_i32(ob,at,k1);
  at=ob_app(ob,at," k2=");
  at=ob_i32(ob,at,k2);
  at=ob_app(ob,at," k3=");
  at=ob_i32(ob,at,k3);
  at=ob_app(ob,at," k4=");
  at=ob_i32(ob,at,k4);
  at=ob_app(ob,at," k5=");
  at=ob_i32(ob,at,k5);
  at=ob_app(ob,at," k6=");
  at=ob_i32(ob,at,k6);
  at=ob_nl(ob,at);

  at=ob_app(ob,at,"AUTONOMOUS-DETECT-END\n");

  // Single raw-syscall write of the whole buffer (stdout).
  let ptr:i64=(_zag_slice_ptr(ob) as i64);
  let left:i32=at;
  let off:i32=0;
  let go:i32=1;
  while(go==1){
    if(left<=0){go=0;}
    else {
      let n:i64=_zag_raw_syscall(1,1,ptr+(off as i64),(left as i64),0,0,0);
      if(n<=0){go=0;}
      else {
        let nb:i32=n as i32;
        off=off+nb;
        left=left-nb;
      }
    }
  }
  return 0;
}

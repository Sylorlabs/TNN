// causalexp_construct.zag -- H-CAUSALEXP experiment CONSTRUCTION.
// Pure Zag. No Python anywhere.
//
// The learner is given competing delay-rule hypotheses (as DATA) and four
// generic primitives: S=set X:=1, W=wait one tick, OY=observe Y,
// OZ=observe Z. It must CONSTRUCT a discriminating multi-step intervention
// by iterative deepening: at each depth it composes every sequence from
// the primitives (base-4 counting; no sequence pre-exists), simulates each
// under every live hypothesis with the generic rule simulator, and selects
// the first sequence where predictions disagree. The search is pure
// simulation (zero real-world actions). Only the selected sequence is
// executed once against the sealed true world. Hypotheses are authored;
// the frontier under test is experiment CONSTRUCTION.

// ============ utils ============
fn z_alloc(n:i32)[]u8 {
  if(n<1){return "";}
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){return "";}
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){b[i]=0;i=i+1;}
  return b;
}
fn emit(s:[]u8)void { _zag_print(s); return; }
fn get32(b:[]u8, i:i32)i32 {
  return (b[i] as i32)|((b[i+1] as i32)<<8)|((b[i+2] as i32)<<16)|((b[i+3] as i32)<<24);
}
fn set32(b:[]u8, i:i32, v:i32)void {
  b[i]=v as u8; b[i+1]=(v>>8) as u8; b[i+2]=(v>>16) as u8; b[i+3]=(v>>24) as u8;
  return;
}
fn i64s(v:i64)[]u8 {
  let r:[]u8=_zag_i64_to_str(v);
  if(r.len>0 && r[r.len-1]==10){return r[0..r.len-1];}
  return r;
}
fn e64(v:i32)void { emit(i64s(v as i64)); return; }

// ============ hypothesis rules (DATA; one generic interpreter) ============
// w: 0=WorldA, 1=WorldB. h: 0,1. r: rule index (0..n_rules-1).
// WorldA: H0=[(X,Z,2),(Z,Y,0)], H1=[(X,Y,1)].
// WorldB: H0=[(X,Z,3),(Z,Y,0)], H1=[(X,Y,2)].
// out: 12 bytes: +0 src, +4 dst, +8 delay. Variables: X=0,Z=1,Y=2.
fn n_rules(w:i32,h:i32)i32 {
  if(w==0){
    if(h==0){return 2;}
    return 1;
  }
  if(h==0){return 2;}
  return 1;
}
fn get_rule(w:i32,h:i32,r:i32,out:[]u8)void {
  let src:i32=0; let dst:i32=0; let delay:i32=0;
  if(w==0){
    if(h==0){
      if(r==0){src=0;dst=1;delay=2;}
      else{src=1;dst=2;delay=0;}
    } else {
      src=0;dst=2;delay=1;
    }
  } else {
    if(h==0){
      if(r==0){src=0;dst=1;delay=3;}
      else{src=1;dst=2;delay=0;}
    } else {
      src=0;dst=2;delay=2;
    }
  }
  set32(out,0,src); set32(out,4,dst); set32(out,8,delay);
  return;
}

// ============ generic simulator ============
// State (32 bytes): +0 X,+4 Z,+8 Y,+12 t,+16 tX,+20 tZ,+24 tY.
// Actions: 0=S, 1=W, 2=OY, 3=OZ. Returns observation or -1.
fn step(w:i32,h:i32,st:[]u8,a:i32)i32 {
  let obs:i32=-1;
  if(a==0){
    set32(st,0,1);
    set32(st,16,get32(st,12));
  } else if(a==1){
    let t:i32=get32(st,12)+1;
    set32(st,12,t);
    let pass:i32=0;
    while(pass<2){
      let r:i32=0;
      let nr:i32=n_rules(w,h);
      while(r<nr){
        let rb:[]u8=z_alloc(12);
        get_rule(w,h,r,rb);
        let src:i32=get32(rb,0);
        let dst:i32=get32(rb,4);
        let delay:i32=get32(rb,8);
        if(get32(st,src*4)==1){
          let ts:i32=get32(st,16+src*4);
          if(t-ts>=delay){
            if(get32(st,dst*4)==0){
              set32(st,dst*4,1);
              set32(st,16+dst*4,t);
            }
          }
        }
        r=r+1;
      }
      pass=pass+1;
    }
  } else if(a==2){
    obs=get32(st,8);
  } else if(a==3){
    obs=get32(st,4);
  }
  return obs;
}
// Simulate a full sequence; return last observation or -1.
fn sim_seq(w:i32,h:i32,seq:[]u8,len:i32)i32 {
  let st:[]u8=z_alloc(32);
  let last:i32=-1;
  let i:i32=0;
  while(i<len){
    let o:i32=step(w,h,st,seq[i] as i32);
    if(o>=0){last=o;}
    i=i+1;
  }
  return last;
}
fn has_observe(seq:[]u8,len:i32)i32 {
  let i:i32=0;
  while(i<len){
    if((seq[i] as i32)>=2){return 1;}
    i=i+1;
  }
  return 0;
}

// ============ sealed true world: ONLY world_step reads the truth ============
fn world_of(cfg:i32)i32 {
  if(cfg<2){return 0;}
  return 1;
}
fn true_hypo_of(cfg:i32)i32 {
  if(cfg==0){return 0;}
  if(cfg==1){return 1;}
  if(cfg==2){return 0;}
  return 1;
}
fn world_step(cfg:i32,st:[]u8,a:i32)i32 {
  return step(world_of(cfg),true_hypo_of(cfg),st,a);
}

// ============ emit helpers ============
fn emit_action(a:i32)void {
  if(a==0){emit("S");}
  else if(a==1){emit("W");}
  else if(a==2){emit("OY");}
  else{emit("OZ");}
  return;
}
fn emit_seq2(seq:[]u8,len:i32)void {
  emit("[");
  let i:i32=0;
  while(i<len){
    if(i>0){emit(",");}
    emit_action(seq[i] as i32);
    i=i+1;
  }
  emit("]");
  return;
}

// ============ main: 4 configs, construct-then-execute ============
fn main()i32 {
  let cfg:i32=0;
  while(cfg<4){
    let w:i32=world_of(cfg);
    let th:i32=true_hypo_of(cfg);
    emit("CONFIG "); e64(cfg);
    if(w==0){emit(" world=A");}
    else{emit(" world=B");}
    emit(" true_h="); e64(th); emit("\n");
    // ---- K-CX1: single primitives must not discriminate ----
    let a:i32=0;
    while(a<4){
      let sq:[]u8=z_alloc(1);
      sq[0]=a as u8;
      let p0:i32=sim_seq(w,0,sq,1);
      let p1:i32=sim_seq(w,1,sq,1);
      emit("PRIM a=");
      emit_action(a);
      emit(" h0="); e64(p0);
      emit(" h1="); e64(p1);
      if(p0==p1){emit(" agree=1\n");} else {emit(" agree=0\n");}
      a=a+1;
    }
    // ---- iterative deepening: compose, simulate, select by disagreement ----
    let found:i32=0;
    let fseq:[]u8=z_alloc(6);
    let flen:i32=0;
    let fp0:i32=-9;
    let fp1:i32=-9;
    let d:i32=1;
    while(d<=5){
      if(found==1){break;}
      let total:i32=1;
      let k:i32=0;
      while(k<d){total=total*4; k=k+1;}
      let checked:i32=0;
      let si:i32=0;
      while(si<total){
        if(found==1){break;}
        let seq:[]u8=z_alloc(6);
        let div:i32=1;
        let p:i32=0;
        while(p<d-1){div=div*4; p=p+1;}
        let rem:i32=si;
        let i:i32=0;
        while(i<d){
          seq[i]=(rem/div) as u8;
          rem=rem%div;
          if(div>1){div=div/4;}
          i=i+1;
        }
        if(has_observe(seq,d)==1){
          checked=checked+1;
          let q0:i32=sim_seq(w,0,seq,d);
          let q1:i32=sim_seq(w,1,seq,d);
          if(q0!=q1){
            found=1;
            flen=d;
            fp0=q0; fp1=q1;
            let c:i32=0;
            while(c<d){fseq[c]=seq[c]; c=c+1;}
          }
        }
        si=si+1;
      }
      emit("DEPTH "); e64(d);
      emit(" checked="); e64(checked);
      emit(" found="); e64(found); emit("\n");
      d=d+1;
    }
    if(found==0){
      emit("NO-DISCRIMINATING-SEQUENCE\n");
    } else {
      emit("SELECT seq=");
      emit_seq2(fseq,flen);
      emit(" h0pred="); e64(fp0);
      emit(" h1pred="); e64(fp1); emit("\n");
      // ---- the ONLY real-world actions in this config ----
      let rst:[]u8=z_alloc(32);
      let real_obs:i32=-1;
      let j:i32=0;
      while(j<flen){
        let o:i32=world_step(cfg,rst,fseq[j] as i32);
        if(o>=0){real_obs=o;}
        j=j+1;
      }
      emit("EXEC seq=");
      emit_seq2(fseq,flen);
      emit(" real="); e64(real_obs); emit("\n");
      // ---- eliminate mismatching hypotheses ----
      let h:i32=0;
      while(h<2){
        let q:i32=sim_seq(w,h,fseq,flen);
        if(q!=real_obs){
          emit("ELIM h="); e64(h); emit("\n");
        } else {
          emit("SURVIVE h="); e64(h); emit("\n");
        }
        h=h+1;
      }
    }
    cfg=cfg+1;
  }
  return 0;
}

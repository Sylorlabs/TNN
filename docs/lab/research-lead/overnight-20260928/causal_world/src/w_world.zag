// =====================================================================
// w_world.zag : RESEARCHER-AUTHORED GROUND TRUTH. LEARNER-INVISIBLE.
//
// Every dynamic in the experiment lives in this file. The agent never reads
// it; K0 checks that at run time by reading src/agent.zag and scanning for
// world-internal symbols, and K0b checks src/main.zag the same way.
//
// WORLD 1. VARIABLE ROLES (these ids appear NOWHERE else):
//   0 TR treatment input      6 GF goal flag
//   1 MD hidden intermediate  7 A1 action 1
//   2 OU outcome              8 A2 action 2
//   3 CN confounder           9 A3 action 3
//   4 SN sensor / lamp       10 RG regime-observable decoy
//   5 PL policy              11 LT latent regime, NOT readable
//
// GROUND TRUTH LAW, one tick, regime q (= LT):
//   CN ~ U{0,1,2,3}                        exogenous confounder
//   TR  = CN mod 2                         CN -> TR          (lag 0)
//   RG  ~ U{0,1,2,3}                     own exogenous stream, no regime
//   MD  = (TR + RG_prev + MD_prev) mod 4   TR -> MD          (lag 0)
//   OU  = 1 iff MD_prev in S(CN, TR)       MD -> OU          (LAG 1)
//        S(c,0)={0,1}{2,3}{}{0}   sum 5    CN -> OU, TR -> OU (lag 0)
//        S(c,1)={0,1}{2,3}{0,1}{2,3} sum 8
//   SN  = TR                               perfect sensor, NO path to OU
//   PL,A1,A2 ~ U{0,1};  A3 ~ U{0,1,2}
//   GF  = 1 iff PL==1 and A1==1 and A2==1 and A3>=1   (4 component goal)
//   q=1 INVERTS the OU mechanism; q=2 REVERTS to the q=0 law.
//   Three distinct laws in one lifetime. The agent never sees q.
//
// DO-OPERATOR: w_set clamps a variable, SKIPS that variable's generative
// rule for the current tick, and holds the clamp until w_rel. The agent
// cannot observe the skip.
//
// WORLD 2 (transfer, K12): 10 variables, values 0..4, a DIFFERENT skeleton
// with self-lags and no deceptive sensor. Same file, same do-operator.
// =====================================================================
fn WNV()i32 { return 12; }
fn WREGQ()i32 { return 12; }
fn W_SZ()i32 { return 5760; }
fn w_pre(v:i32)i32 { return 8+v*4; }
fn w_cur(v:i32)i32 { return 56+v*4; }
fn w_cl(v:i32)i32 { return 104+v*4; }
fn w_cv(v:i32)i32 { return 152+v*4; }
fn w_tick(W:[]u8)i32 { return get32(W,0); }
fn w_reg(W:[]u8)i32 { return get32(W,4); }
fn w_advance_regime(W:[]u8)void { set32(W,4,get32(W,4)+1); return; }
// Additive lagged Fibonacci generator, modulus 65521, lags (223, 222).
// Chosen over a power of two LCG because CN needs values 0..3 and the low
// bits of a 2^k LCG have period 2^k.
fn lfg(W:[]u8,base:i32)i32 {
  let ib:i32=base+223*4;
  let i:i32=get32(W,ib);
  let i1:i32=i+1; if(i1>222){ i1=i1-223; }
  let a:i32=get32(W,base+i*4);
  let b:i32=get32(W,base+i1*4);
  let s:i32=a+b;
  s=s-((s/65521)*65521);
  set32(W,base+i*4,s);
  set32(W,ib,i1);
  return s;
}
fn lfg_seed(W:[]u8,base:i32,sd:i32)void {
  let j:i32=0;
  let v:i32=sd-((sd/65521)*65521);
  while(j<223){
    v=v*25173+13849;
    v=v-((v/65521)*65521);
    set32(W,base+j*4,v);
    j=j+1;
  }
  set32(W,base+223*4,0);
  // Warm up: 256 discarded draws, well past the 223 slot ring.
  // Measured 2026-10-04: marginals 250/249/250/249 per mille and all
  // sixteen lag 1 joint cells equal at 62 per mille.

  let w:i32=0;
  while(w<256){
    lfg(W,base);
    w=w+1;
  }
  return;
}
fn w_init()[]u8 {
  let W:[]u8=z_alloc(W_SZ());
  w_reset(W,20260904);
  return W;
}
fn w_reset(W:[]u8,seed:i32)void {
  let i:i32=0;
  while(i<WNV()){
    set32(W,w_pre(i),0);
    set32(W,w_cur(i),0);
    set32(W,w_cl(i),0);
    set32(W,w_cv(i),0);
    i=i+1;
  }
  lfg_seed(W,204,seed);
  lfg_seed(W,1100,seed+7919);
  lfg_seed(W,1996,seed+15838);
  lfg_seed(W,2892,seed+23757);
  lfg_seed(W,3788,seed+31676);
  lfg_seed(W,4684,seed+39595);
  set32(W,0,0);
  set32(W,4,0);
  return;
}
fn w_set(W:[]u8,v:i32,val:i32)void {
  if(v<0){ return; }
  if(v>=WNV()){ return; }
  if(v==WREGQ()){ return; }
  set32(W,w_cl(v),1);
  set32(W,w_cv(v),val);
  return;
}
fn w_rel(W:[]u8,v:i32)void {
  if(v<0){ return; }
  if(v>=WNV()){ return; }
  set32(W,w_cl(v),0);
  set32(W,w_cv(v),0);
  return;
}
fn w_is_clamped(W:[]u8,v:i32)i32 { return get32(W,w_cl(v)); }
fn w_clamp(W:[]u8,v:i32,nat:i32)i32 {
  if(get32(W,w_cl(v))!=0){ return get32(W,w_cv(v)); }
  return nat;
}
// w_get is the ONLY observation channel. The latent regime variable is not
// readable: it returns -1 for every value.
fn w_get(W:[]u8,v:i32)i32 {
  if(v<0){ return -1; }
  if(v>=WNV()){ return -1; }
  if(v==WREGQ()){ return -1; }
  return get32(W,w_cur(v));
}
fn w_prev(W:[]u8,v:i32)i32 { return get32(W,w_pre(v)); }
fn w_mod4(x:i32)i32 { return x-((x/4)*4); }
fn w_mod2(x:i32)i32 { return x-((x/2)*2); }
fn w_mod5(x:i32)i32 { return x-((x/5)*5); }
// TRUE positive region of the OU mechanism. World side only.
// S(c,t): t=0 -> {0,1},{2,3},{},{0}     sum 5
//         t=1 -> {0,1},{2,3},{0,1},{2,3} sum 8
fn w_S(m:i32,c:i32,t:i32)i32 {
  if(t==0){
    if(c==0){ if(m==0){ return 1; } if(m==1){ return 1; } return 0; }
    if(c==1){ if(m==2){ return 1; } if(m==3){ return 1; } return 0; }
    if(c==2){ return 0; }
    if(m==0){ return 1; }
    return 0;
  }
  if(c==0){ if(m==0){ return 1; } if(m==1){ return 1; } return 0; }
  if(c==1){ if(m==2){ return 1; } if(m==3){ return 1; } return 0; }
  if(c==2){ if(m==0){ return 1; } if(m==1){ return 1; } return 0; }
  if(m==2){ return 1; }
  if(m==3){ return 1; }
  return 0;
}
fn w_step(W:[]u8)void {
  let i:i32=0;
  while(i<WNV()){
    set32(W,w_pre(i),get32(W,w_cur(i)));
    i=i+1;
  }
  let cn:i32=w_clamp(W,3,lfg(W,204)/16384);
  let pl:i32=w_clamp(W,5,lfg(W,1100)/32768);
  let a1:i32=w_clamp(W,7,lfg(W,1996)/32768);
  let a2:i32=w_clamp(W,8,lfg(W,2892)/32768);
  let a3:i32=w_clamp(W,9,lfg(W,3788)/21845);
  let tr:i32=w_clamp(W,0,w_mod2(cn));
  let mdp:i32=get32(W,w_pre(1));
  let rgp:i32=get32(W,w_pre(10));
  // RG_prev enters MD so that cur[MD] is not invertible in (MD_prev, TR):
  // otherwise a single current value would predict the outcome and the
  // hidden intermediate would carry no information of its own.
  let md:i32=w_clamp(W,1,w_mod4(tr+rgp+mdp));
  let ou:i32=w_S(mdp,cn,tr);
  let q:i32=get32(W,4);
  if(q==1){ ou=1-ou; }
  let ouf:i32=w_clamp(W,2,ou);
  let sn:i32=w_clamp(W,4,tr);
  let rg:i32=w_clamp(W,10,lfg(W,4684)/16384);
  let gf:i32=0;
  if(pl==1){ if(a1==1){ if(a2==1){ if(a3>=1){ gf=1; } } } }
  let gff:i32=w_clamp(W,6,gf);
  set32(W,w_cur(0),tr);
  set32(W,w_cur(1),md);
  set32(W,w_cur(2),ouf);
  set32(W,w_cur(3),cn);
  set32(W,w_cur(4),sn);
  set32(W,w_cur(5),pl);
  set32(W,w_cur(6),gff);
  set32(W,w_cur(7),a1);
  set32(W,w_cur(8),a2);
  set32(W,w_cur(9),a3);
  set32(W,w_cur(10),rg);
  set32(W,w_cur(11),q);
  set32(W,0,get32(W,0)+1);
  return;
}
// ---- A2 PRIVILEGED ablation hooks. World side only.
// w_true_edge(v,w,l) = 1 iff v->w at lag l is a real causal edge.
fn w_true_edge(v:i32,w:i32,l:i32)i32 {
  if(v==w){
    if(l==1){ if(v==1){ return 1; } }
    return 0;
  }
  if(v==3){
    if(w==0){ if(l==0){ return 1; } return 0; }
    if(w==1){ return 1; }
    if(w==2){ return 1; }
    return 0;
  }
  if(v==0){
    if(w==1){ return 1; }
    if(w==2){ return 1; }
    return 0;
  }
  if(v==1){ if(w==2){ if(l==1){ return 1; } return 0; } return 0; }
  if(v==10){ if(w==1){ if(l==1){ return 1; } return 0; } return 0; }
  if(v==5){ if(w==6){ if(l==0){ return 1; } return 0; } return 0; }
  if(v==7){ if(w==6){ if(l==0){ return 1; } return 0; } return 0; }
  if(v==8){ if(w==6){ if(l==0){ return 1; } return 0; } return 0; }
  if(v==9){ if(w==6){ if(l==0){ return 1; } return 0; } return 0; }
  return 0;
}
// w_true_nclause / w_true_clause: the privileged arm's seeded clause list.
// OU truth is 13 three literal clauses over (MD_prev, CN_cur, TR_cur).
fn w_true_nclause(w:i32)i32 {
  if(w==2){ return 13; }
  if(w==6){ return 1; }
  return 0;
}
fn w_true_clause(w:i32,k:i32)[]u8 {
  let r:[]u8=z_alloc(12);
  if(w==6){
    set32(r,0,((5*2+0)*4)+1);
    set32(r,4,((7*2+0)*4)+1);
    set32(r,8,-1);
    return r;
  }
  if(w==2){
    let mstr:[]u8="0123001230123";
    let cstr:[]u8="0011300112233";
    let tstr:[]u8="0000011111111";
    set32(r,0,((1*2+1)*4)+((mstr[k]-48) as i32));
    set32(r,4,((3*2+0)*4)+((cstr[k]-48) as i32));
    set32(r,8,((0*2+0)*4)+((tstr[k]-48) as i32));
    return r;
  }
  set32(r,0,-1);
  set32(r,4,-1);
  set32(r,8,-1);
  return r;
}
// =====================================================================
// WORLD 2. Ten variables, values 0..4, a DIFFERENT causal skeleton.
//   0 x1  1 h1  2 y1  3 z1  4 s1  5 g1  6 x2  7 h2  8 y2  9 z2
//   z1 ~ U{0..4}; x1 = z1 mod 2; h1 = (x1 + h1_prev + 2) mod 5
//   y1 = 1 iff (h1_prev + z1) mod 5 < 2
//   s1 = x1
//   z2 ~ U{0..4}; x2 = z2 mod 2; h2 = (x2 + h2_prev + 1) mod 5
//   y2 = 1 iff (h2_prev + 3*z2) mod 5 < 2
//   g1 = 1 iff (x1==1 and z1==1) or (x2==1 and z2==1)
//   regime 1 shifts the y thresholds (a second law, reverts at regime 2)
// =====================================================================
fn W2NV()i32 { return 10; }
fn w2_init()[]u8 {
  let W:[]u8=z_alloc(W_SZ());
  w2_reset(W,777333);
  return W;
}
fn w2_reset(W:[]u8,seed:i32)void {
  let i:i32=0;
  while(i<W2NV()){
    set32(W,w_pre(i),0);
    set32(W,w_cur(i),0);
    set32(W,w_cl(i),0);
    set32(W,w_cv(i),0);
    i=i+1;
  }
  lfg_seed(W,204,seed);
  lfg_seed(W,1100,seed+7919);
  lfg_seed(W,1996,seed+15838);
  lfg_seed(W,2892,seed+23757);
  lfg_seed(W,3788,seed+31676);
  lfg_seed(W,4684,seed+39595);
  set32(W,0,0);
  set32(W,4,0);
  return;
}
fn w2_set(W:[]u8,v:i32,val:i32)void {
  if(v<0){ return; }
  if(v>=W2NV()){ return; }
  set32(W,w_cl(v),1);
  set32(W,w_cv(v),val);
  return;
}
fn w2_rel(W:[]u8,v:i32)void {
  if(v<0){ return; }
  if(v>=W2NV()){ return; }
  set32(W,w_cl(v),0);
  set32(W,w_cv(v),0);
  return;
}
fn w2_get(W:[]u8,v:i32)i32 {
  if(v<0){ return -1; }
  if(v>=W2NV()){ return -1; }
  return get32(W,w_cur(v));
}
fn w2_prev(W:[]u8,v:i32)i32 { return get32(W,w_pre(v)); }
fn w2_clamp(W:[]u8,v:i32,nat:i32)i32 {
  if(get32(W,w_cl(v))!=0){ return get32(W,w_cv(v)); }
  return nat;
}
fn w2_step(W:[]u8)void {
  let i:i32=0;
  while(i<W2NV()){
    set32(W,w_pre(i),get32(W,w_cur(i)));
    i=i+1;
  }
  let q:i32=get32(W,4);
  let thr:i32=2;
  let thr2:i32=2;
  if(q==1){ thr=4; thr2=3; }
  let z1:i32=w2_clamp(W,3,lfg(W,204)/13107);
  let z2:i32=w2_clamp(W,9,lfg(W,1100)/13107);
  let x1:i32=w2_clamp(W,0,w_mod2(z1));
  let x2:i32=w2_clamp(W,6,w_mod2(z2));
  let h1p:i32=get32(W,w_pre(1));
  let h2p:i32=get32(W,w_pre(7));
  let h1:i32=w2_clamp(W,1,w_mod5(x1+h1p+2));
  let h2:i32=w2_clamp(W,7,w_mod5(x2+h2p+1));
  let y1:i32=0;
  if(w_mod5(h1p+z1)<thr){ y1=1; }
  let y2:i32=0;
  if(w_mod5(h2p+3*z2)<thr2){ y2=1; }
  let s1:i32=w2_clamp(W,4,x1);
  let g1:i32=0;
  if(x1==1){ if(z1==1){ g1=1; } }
  if(g1==0){ if(x2==1){ if(z2==1){ g1=1; } } }
  set32(W,w_cur(0),x1);
  set32(W,w_cur(1),h1);
  set32(W,w_cur(2),w2_clamp(W,2,y1));
  set32(W,w_cur(3),z1);
  set32(W,w_cur(4),s1);
  set32(W,w_cur(5),w2_clamp(W,5,g1));
  set32(W,w_cur(6),x2);
  set32(W,w_cur(7),h2);
  set32(W,w_cur(8),w2_clamp(W,8,y2));
  set32(W,w_cur(9),z2);
  set32(W,0,get32(W,0)+1);
  return;
}
fn w2_true_edge(v:i32,w:i32,l:i32)i32 {
  if(v==w){
    if(l==1){ if(v==1){ return 1; } if(v==7){ return 1; } }
    return 0;
  }
  if(v==3){
    if(w==0){ if(l==0){ return 1; } return 0; }
    if(w==1){ if(l==0){ return 1; } return 0; }
    if(w==2){ if(l==0){ return 1; } return 0; }
    if(w==4){ if(l==0){ return 1; } return 0; }
    if(w==5){ if(l==0){ return 1; } return 0; }
    return 0;
  }
  if(v==9){
    if(w==6){ if(l==0){ return 1; } return 0; }
    if(w==7){ if(l==0){ return 1; } return 0; }
    if(w==8){ if(l==0){ return 1; } return 0; }
    if(w==5){ if(l==0){ return 1; } return 0; }
    return 0;
  }
  if(v==0){
    if(w==1){ if(l==0){ return 1; } return 0; }
    if(w==2){ if(l==1){ return 1; } return 0; }
    if(w==5){ if(l==0){ return 1; } return 0; }
    return 0;
  }
  if(v==1){ if(w==2){ if(l==1){ return 1; } return 0; } return 0; }
  if(v==6){
    if(w==7){ if(l==0){ return 1; } return 0; }
    if(w==8){ if(l==1){ return 1; } return 0; }
    if(w==5){ if(l==0){ return 1; } return 0; }
    return 0;
  }
  if(v==7){ if(w==8){ if(l==1){ return 1; } return 0; } return 0; }
  return 0;
}

// k0pats.zag : the literal pattern tables used by the privilege isolation
// check live HERE, in a file that is neither the learner nor the driver,
// so that the checker does not match its own pattern strings.
fn k0_apats()[]u8 { return "w_step|w_set|w_rel|w_get|w_prev|w_S|w_true|w_init|w_reset|w_reg|w_advance|w_mod|w_clamp|w_is_clamped|w_pre|w_cur|w_tick|WNV|WREGQ|W_SZ|lfg|COUNTERFACTUAL_MODE|CF_MODE|cf_mode|COUNTERFACT"; }
fn k0_dpat()[]u8 { return "w_S|w_true|w_reg|w_advance|w_mod|w_clamp|w_is_clamped|w_pre|w_cur|w_tick|w_init|w_reset|WNV|WREGQ|W_SZ|lfg|w2_|w_mod4|w_mod2|w_mod5"; }
fn k0_nums()[]u8 { return "150|299|300|449"; }

// audit.zag : GROUND TRUTH COMPARISON. Not part of the action pipeline.
// The driver calls these only to REPORT; no action or learner input
// flows through them. This file is the only place that reads w_true_*.
// count how many of the agent's oriented edges match a true edge
fn edge_prec2(A:[]u8)i32 {
  let n:i32=g_get(A,0);
  let hit:i32=0;
  let i:i32=0;
  while(i<n){
    if(w_true_edge(edge_get(A,i,0),edge_get(A,i,1),edge_get(A,i,2))==1){ hit=hit+1; }
    i=i+1;
  }
  return hit;
}
fn true_edges2()i32 {
  let n:i32=0;
  let v:i32=0;
  while(v<WNV()){
    let w:i32=0;
    while(w<WNV()){
      let l:i32=0;
      while(l<2){
        if(w_true_edge(v,w,l)==1){ n=n+1; }
        l=l+1;
      }
      w=w+1;
    }
    v=v+1;
  }
  return n;
}

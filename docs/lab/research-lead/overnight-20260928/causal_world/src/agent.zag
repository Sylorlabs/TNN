// =====================================================================
// agent.zag : THE LEARNER. Pure, generic, ZERO world literals.
//
// This file contains no world symbol, no variable id carrying a world
// role, no regime index, no law expression, no experiment script and no
// counterfactual mode constant. K0 reads this file at run time and fails
// the run if any of those appear.
//
// Everything the agent knows was derived from a_tap records: observations
// of the world plus the agent's own actions. The agent may force a
// variable (a do) and release it. Nothing else.
//
// The whole agent state is ONE flat arena addressed by byte offsets.
// =====================================================================
fn ANV()i32 { return 12; }
fn ANL()i32 { return 4; }
fn ANZ()i32 { return 15; }
fn AMXCL()i32 { return 18; }
fn AMXL()i32 { return 3; }
fn AMXH()i32 { return 4; }
fn ACE_MIN()i32 { return 30; }
fn ACE_N()i32 { return 8; }
fn AREV()i32 { return 500; }
fn ATF()i32 { return 12; }
fn ASC()i32 { return 1000; }

fn AN()i32 { return 2300000; }
fn O_NT()i32 { return 0; }
fn O_TAPE()i32 { return 64; }
fn TROW()i32 { return 160; }
fn TMAX()i32 { return 4000; }
fn O_CNT()i32 { return 640064; }
fn O_ITC()i32 { return 660000; }
fn O_HOL()i32 { return 800000; }
fn O_NCL()i32 { return 805000; }
fn O_DEF()i32 { return 805100; }
fn O_DEF2()i32 { return 805200; }
fn O_B1L()i32 { return 805250; }
fn O_B1F()i32 { return 805300; }
fn O_B1C()i32 { return 805400; }
fn O_CL()i32 { return 805600; }
fn O_PACC()i32 { return 808300; }
fn O_NHIST()i32 { return 808400; }
fn O_PROBE()i32 { return 808500; }
fn O_HIST()i32 { return 809000; }
fn HW()i32 { return 220; }
fn O_FTB()i32 { return 1000000; }
fn FTW()i32 { return 800; }
fn O_TOP()i32 { return 820000; }
fn O_CEC()i32 { return 821000; }
fn O_DMG()i32 { return 823000; }
fn O_EDG()i32 { return 825000; }
fn O_TRN()i32 { return 832000; }
fn O_PRED()i32 { return 850000; }
fn O_CLS()i32 { return 860000; }
fn O_CF()i32 { return 870000; }
fn O_KEY()i32 { return 880000; }
fn O_S1()i32 { return 900000; }
fn O_S2()i32 { return 910000; }
fn O_CL2()i32 { return 890000; }
fn O_G()i32 { return 840000; }
fn O_GN()i32 { return 845000; }
fn GCNT()i32 { return 1024; }

fn t_get(A:[]u8,r:i32,f:i32)i32 { return get32(A,O_TAPE()+r*TROW()+f*4); }
fn t_set(A:[]u8,r:i32,f:i32,v:i32)void { set32(A,O_TAPE()+r*TROW()+f*4,v); return; }
fn t_prev(A:[]u8,r:i32,v:i32)i32 { return get32(A,O_TAPE()+r*TROW()+(6+v)*4); }
fn t_cur(A:[]u8,r:i32,v:i32)i32 { return get32(A,O_TAPE()+r*TROW()+(18+v)*4); }
fn t_nf(A:[]u8,r:i32)i32 { return get32(A,O_TAPE()+r*TROW()+4); }
fn t_fv(A:[]u8,r:i32,k:i32)i32 { return get32(A,O_TAPE()+r*TROW()+(2+k)*4); }
fn g_get(A:[]u8,i:i32)i32 { return get32(A,O_G()+i*4); }
fn g_set(A:[]u8,i:i32,v:i32)void { set32(A,O_G()+i*4,v); return; }
fn gn_get(A:[]u8,i:i32)i32 { return get32(A,O_GN()+i*4); }
fn gn_set(A:[]u8,i:i32,v:i32)void { set32(A,O_GN()+i*4,v); return; }

fn lit_v(l:i32)i32 { return l/8; }
fn lit_l(l:i32)i32 { return (l/4)-(l/8)*2; }
fn lit_a(l:i32)i32 { return l-((l/4)*4); }
fn lit_true(A:[]u8,r:i32,l:i32)i32 {
  let v:i32=lit_v(l);
  let x:i32=0;
  if(lit_l(l)==0){ x=t_cur(A,r,v); } else { x=t_prev(A,r,v); }
  if(x==lit_a(l)){ return 1; }
  return 0;
}
fn p2(a:i32)i32 { let r:i32=1; let i:i32=0; while(i<a){ r=r+r; i=i+1; } return r; }
fn fac_v(f:i32)i32 { return f/32; }
fn fac_l(f:i32)i32 { return (f/16)-(f/32)*2; }
fn fac_m(f:i32)i32 { return f-((f/16)*16); }
fn mhit(m:i32,x:i32)i32 {
  let b:i32=p2(x);
  let t:i32=m/b;
  return t-(t/2)*2;
}
fn fac_hold(S:[]u8,f:i32)i32 {
  let v:i32=fac_v(f);
  let x:i32=0;
  if(fac_l(f)==0){ x=S[12+v]; } else { x=S[0+v]; }
  return mhit(fac_m(f),x);
}
fn fac_hold_row(A:[]u8,r:i32,f:i32)i32 {
  let v:i32=fac_v(f);
  let x:i32=0;
  if(fac_l(f)==0){ x=t_cur(A,r,v); } else { x=t_prev(A,r,v); }
  return mhit(fac_m(f),x);
}

fn a_init()[]u8 { return z_alloc(AN()); }
fn a_nt(A:[]u8)i32 { return get32(A,O_NT()); }
fn a_cls(A:[]u8,r:i32,w:i32)i32 {
  if(t_cur(A,r,w)!=0){ return 1; }
  return 0;
}
fn a_tap(A:[]u8,mode:i32,nf:i32,f0:i32,f1:i32,f2:i32,f3:i32,step:i32,PB:[]u8,CB:[]u8)void {
  let r:i32=get32(A,O_NT());
  if(r>=TMAX()){ return; }
  let i:i32=0;
  while(i<ANV()){
    set32(A,O_TAPE()+r*TROW()+(6+i)*4,PB[i]);
    set32(A,O_TAPE()+r*TROW()+(18+i)*4,CB[i]);
    i=i+1;
  }
  t_set(A,r,0,mode);
  t_set(A,r,1,nf);
  t_set(A,r,2,f0);
  t_set(A,r,3,f1);
  t_set(A,r,4,f2);
  t_set(A,r,5,f3);
  t_set(A,r,30,step);
  set32(A,O_NT(),r+1);
  return;
}

fn c_add(A:[]u8,ch:i32,l:i32,v:i32,a:i32,w:i32,i:i32)void {
  let idx:i32=((((ch*ANL()+l)*ANV()+v)*ANL()+a)*ANV()+w)*2+i;
  set32(A,O_CNT()+idx*4,get32(A,O_CNT()+idx*4)+1);
  return;
}
fn c_get(A:[]u8,ch:i32,l:i32,v:i32,a:i32,w:i32,i:i32)i32 {
  let idx:i32=((((ch*ANL()+l)*ANV()+v)*ANL()+a)*ANV()+w)*2+i;
  return get32(A,O_CNT()+idx*4);
}
fn itc_add(A:[]u8,l:i32,v:i32,a:i32,w:i32,z:i32,i:i32)void {
  let idx:i32=((((l*ANV()+v)*ANL()+a)*ANV()+w)*ANZ()+z)*2+i;
  set32(A,O_ITC()+idx*4,get32(A,O_ITC()+idx*4)+1);
  return;
}
fn itc_get(A:[]u8,l:i32,v:i32,a:i32,w:i32,z:i32,i:i32)i32 {
  let idx:i32=((((l*ANV()+v)*ANL()+a)*ANV()+w)*ANZ()+z)*2+i;
  return get32(A,O_ITC()+idx*4);
}
fn hol_add(A:[]u8,l:i32,v:i32,a:i32,w:i32)void {
  let idx:i32=(((l*ANV()+v)*ANL()+a)*ANV()+w);
  set32(A,O_HOL()+idx*4,get32(A,O_HOL()+idx*4)+1);
  return;
}

fn a_cell(A:[]u8,r:i32,w:i32,z:i32)i32 {
  let b:i32=w*4;
  let q0:i32=get32(A,O_PROBE()+b*4);
  let q1:i32=get32(A,O_PROBE()+(b+1)*4);
  let q2:i32=get32(A,O_PROBE()+(b+2)*4);
  let q3:i32=get32(A,O_PROBE()+(b+3)*4);
  if(z==0){ return 1; }
  if(z==1){ return lit_true(A,r,q0); }
  if(z==2){ return lit_true(A,r,q1); }
  if(z==3){ return lit_true(A,r,q2); }
  if(z==4){ return lit_true(A,r,q3); }
  if(z==5){ return lit_true(A,r,q0)*lit_true(A,r,q1); }
  if(z==6){ return lit_true(A,r,q0)*lit_true(A,r,q2); }
  if(z==7){ return lit_true(A,r,q0)*lit_true(A,r,q3); }
  if(z==8){ return lit_true(A,r,q1)*lit_true(A,r,q2); }
  if(z==9){ return lit_true(A,r,q1)*lit_true(A,r,q3); }
  if(z==10){ return lit_true(A,r,q2)*lit_true(A,r,q3); }
  if(z==11){ return lit_true(A,r,q0)*lit_true(A,r,q1)*lit_true(A,r,q2); }
  if(z==12){ return lit_true(A,r,q0)*lit_true(A,r,q1)*lit_true(A,r,q3); }
  if(z==13){ return lit_true(A,r,q0)*lit_true(A,r,q2)*lit_true(A,r,q3); }
  return lit_true(A,r,q1)*lit_true(A,r,q2)*lit_true(A,r,q3);
}

// a_probe : per target, the 4 literals most associated with it, measured on
// passive rows only. They become the conditioning basis of the effect test.
fn a_probe(A:[]u8)void {
  let nt:i32=get32(A,O_NT());
  let w:i32=0;
  while(w<ANV()){
    let l:i32=0;
    while(l<96){
      let p1:i32=0;
      let p0:i32=0;
      let r:i32=0;
      while(r<nt){
        let pas:i32=0;
        if(t_nf(A,r)==0){ pas=1; }
        if(pas==1){
          if(lit_true(A,r,l)==1){
            if(a_cls(A,r,w)==1){ p1=p1+1; } else { p0=p0+1; }
          }
        }
        r=r+1;
      }
      let n:i32=p1+p0;
      let g:i32=0;
      if(n>ACE_N){ g=absv(p1*2-n); }
      gn_set(A,l,g);
      l=l+1;
    }
    let s:i32=0;
    while(s<4){
      let bg:i32=-1;
      let bl:i32=-1;
      l=0;
      while(l<96){
        if(gn_get(A,l)>bg){ bg=gn_get(A,l); bl=l; }
        l=l+1;
      }
      if(bl<0){ bl=0; }
      set32(A,O_PROBE()+(w*4+s)*4,bl);
      gn_set(A,bl,0-gn_get(A,bl)-1);
      s=s+1;
    }
    w=w+1;
  }
  return;
}

// a_scan : rebuild the three acquisition channels from the whole tape.
// ch 0 = passive (nothing forced on this row or the previous one),
// ch 1 = interventional (v forced to a at lag l, target w free at lag 0).
fn a_scan(A:[]u8)void {
  let i:i32=0;
  while(i<34560){ set32(A,O_ITC()+i*4,0); i=i+1; }
  i=0;
  while(i<4608){ set32(A,O_CNT()+i*4,0); i=i+1; }
  i=0;
  while(i<1152){ set32(A,O_HOL()+i*4,0); i=i+1; }
  let nt:i32=get32(A,O_NT());
  let r:i32=0;
  while(r<nt){
    let nf0:i32=t_nf(A,r);
    let nf1:i32=0;
    if(r>0){ nf1=t_nf(A,r-1); }
    let passive:i32=0;
    if(nf0==0){ passive=1; }
    if(nf1!=0){ passive=0; }
    let v:i32=0;
    while(v<ANV()){
      let a:i32=0;
      while(a<ANL()){
        // observational channel, both lags, purely passive rows
        if(passive==1){
          let x0:i32=t_cur(A,r,v);
          let x1:i32=t_prev(A,r,v);
          let w:i32=0;
          while(w<ANV()){
            let wf:i32=1;
            let k:i32=0;
            while(k<nf0){
              if(t_fv(A,r,k)==w){ wf=0; }
              k=k+1;
            }
            if(wf==1){
              let cl:i32=a_cls(A,r,w);
              if(x0==a){ c_add(A,0,0,v,a,w,cl); }
              if(x1==a){ c_add(A,0,1,v,a,w,cl); }
            }
            w=w+1;
          }
        }
        // interventional channel
        let l:i32=0;
        while(l<2){
          let rr:i32=r-l;
          if(rr>=0){
            let n:i32=t_nf(A,rr);
            let k2:i32=0;
            let hit:i32=0;
            while(k2<n){
              if(t_fv(A,rr,k2)==v){ hit=1; }
              k2=k2+1;
            }
            if(hit==1){

              let curval:i32=t_cur(A,rr,v);
              if(curval==a){
                let ok:i32=1;
                if(l==1){
                  let k3:i32=0;
                  let still:i32=0;
                  while(k3<nf0){
                    if(t_fv(A,r,k3)==v){ still=1; }
                    k3=k3+1;
                  }
                  if(still==1){ ok=0; }
                }
                if(ok==1){
                  let iw:i32=0;
                  while(iw<ANV()){
                    let iwf:i32=1;
                    let k4:i32=0;
                    while(k4<nf0){
                      if(t_fv(A,r,k4)==iw){ iwf=0; }
                      k4=k4+1;
                    }
                    if(iwf==1){
                      let icl:i32=a_cls(A,r,iw);
                      c_add(A,1,l,v,a,iw,icl);
                      let z:i32=0;
                      while(z<ANZ()){
                        if(a_cell(A,r,iw,z)==1){ itc_add(A,l,v,a,iw,z,icl); }
                        z=z+1;
                      }
                    } else {
                      hol_add(A,l,v,a,iw);
                    }
                    iw=iw+1;
                  }
                }
              }
            }
          }
          l=l+1;
        }
        a=a+1;
      }
      v=v+1;
    }
    r=r+1;
  }
  return;
}

// ================= CAUSAL EFFECT ESTIMATORS =================
// a_ce : conditional interventional effect of forcing v to different values
// on w, at lag l. For every conditioning cell z built from the target's own
// probe literals, compare the interventional distribution of w under
// do(v=a) against do(v=a'). Exact rational comparison by cross
// multiplication, reported in per mille. A value of 0 is a certificate
// that moving v does not move w, in the margin AND in every conditioning
// cell the learner can construct from its own probes.
fn a_ce2(A:[]u8,v:i32,w:i32,l:i32)i32 {
  let best:i32=0;
  let z:i32=0;
  while(z<ANZ()){
    let a:i32=0;
    while(a<ANL()){
      let a2:i32=0;
      while(a2<ANL()){
        if(a2!=a){
          let p0:i32=itc_get(A,l,v,a,w,z,0);
          let p1:i32=itc_get(A,l,v,a,w,z,1);
          let q0:i32=itc_get(A,l,v,a2,w,z,0);
          let q1:i32=itc_get(A,l,v,a2,w,z,1);
          let np:i32=p0+p1;
          let nq:i32=q0+q1;
          if(np>=ACE_N){
            if(nq>=ACE_N){
              let d0:i32=absv(p0*nq-q0*np);
              let d1:i32=absv(p1*nq-q1*np);
              let num:i32=d0+d1;
              let den:i32=np*nq;
              let sc:i32=(num*ASC)/den;
              if(sc>best){ best=sc; }
            }
          }
        }
        a2=a2+1;
      }
      a=a+1;
    }
    z=z+1;
  }
  return best;
}
// a_ce_m : the same comparison with NO conditioning, i.e. the ordinary
// total effect on the marginal of w. Reported alongside a_ce because the
// two disagree in this world and the disagreement is a finding.
fn a_ce_m(A:[]u8,v:i32,w:i32,l:i32)i32 {
  let best:i32=0;
  let a:i32=0;
  while(a<ANL()){
    let a2:i32=0;
    while(a2<ANL()){
      if(a2!=a){
        let p0:i32=itc_get(A,l,v,a,w,0,0);
        let p1:i32=itc_get(A,l,v,a,w,0,1);
        let q0:i32=itc_get(A,l,v,a2,w,0,0);
        let q1:i32=itc_get(A,l,v,a2,w,0,1);
        let np:i32=p0+p1;
        let nq:i32=q0+q1;
        if(np>=ACE_N){
          if(nq>=ACE_N){
            let d0:i32=absv(p0*nq-q0*np);
            let d1:i32=absv(p1*nq-q1*np);
            let sc:i32=((d0+d1)*ASC)/(np*nq);
            if(sc>best){ best=sc; }
          }
        }
      }
      a2=a2+1;
    }
    a=a+1;
  }
  return best;
}
// a_d : observational versus interventional discrepancy for the same cell.
// A purely predictive but causally irrelevant variable can score HIGH
// here. This is the deceptive correlation trap; orientation must not use it.
fn a_d(A:[]u8,v:i32,w:i32,l:i32)i32 {
  let best:i32=0;
  let a:i32=0;
  while(a<ANL()){
    let p0:i32=c_get(A,0,l,v,a,w,0);
    let p1:i32=c_get(A,0,l,v,a,w,1);
    let q0:i32=c_get(A,1,l,v,a,w,0);
    let q1:i32=c_get(A,1,l,v,a,w,1);
    let np:i32=p0+p1;
    let nq:i32=q0+q1;
    if(np>=ACE_N){
      if(nq>=ACE_N){
        let d0:i32=absv(p0*nq-q0*np);
        let d1:i32=absv(p1*nq-q1*np);
        let sc:i32=((d0+d1)*ASC)/(np*nq);
        if(sc>best){ best=sc; }
      }
    }
    a=a+1;
  }
  return best;
}
fn cec_get(A:[]u8,v:i32,w:i32,l:i32)i32 { return get32(A,O_CEC()+((v*ANV()+w)*2+l)*4); }
fn cec_set(A:[]u8,v:i32,w:i32,l:i32,x:i32)void { set32(A,O_CEC()+((v*ANV()+w)*2+l)*4,x); return; }
fn dmg_get(A:[]u8,v:i32,w:i32,l:i32)i32 { return get32(A,O_DMG()+((v*ANV()+w)*2+l)*4); }
fn dmg_set(A:[]u8,v:i32,w:i32,l:i32,x:i32)void { set32(A,O_DMG()+((v*ANV()+w)*2+l)*4,x); return; }

// a_orient : orient every ordered pair from the interventional evidence
// alone. v -> w at lag l is admitted iff moving v moves w (a_ce at or
// above threshold) AND moving w never moves v. Pairs with effects in both
// directions are recorded as cyclic and produce no bare edge.
// Also fills the D table so the driver can report what a discrepancy based
// orienter WOULD have concluded.
fn a_orient(A:[]u8)void {
  let v:i32=0;
  while(v<ANV()){
    let w:i32=0;
    while(w<ANV()){
      let l:i32=0;
      while(l<2){
        cec_set(A,v,w,l,a_ce2(A,v,w,l));
        dmg_set(A,v,w,l,a_d(A,v,w,l));
        l=l+1;
      }
      w=w+1;
    }
    v=v+1;
  }
  let ne:i32=0;
  let cyc:i32=0;
  let viol:i32=0;
  let av:i32=0;
  while(av<ANV()){
    let aw:i32=0;
    while(aw<ANV()){
      if(av!=aw){
        let f0:i32=cec_get(A,av,aw,0);
        let f1:i32=cec_get(A,av,aw,1);
        let r0:i32=cec_get(A,aw,av,0);
        let r1:i32=cec_get(A,aw,av,1);
        let fw:i32=f0;
        let bw:i32=f1;
        let lag:i32=0;
        if(f1>f0){ fw=f1; bw=f0; lag=1; }
        let rv:i32=r0;
        if(r1>rv){ rv=r1; }
        if(fw>=ACE_MIN){
          if(rv>=ACE_MIN){
            cyc=cyc+1;
            viol=viol+1;
          } else {
            if(ne<300){
              set32(A,O_EDG()+(ne*5)*4,av);
              set32(A,O_EDG()+(ne*5+1)*4,aw);
              set32(A,O_EDG()+(ne*5+2)*4,lag);
              set32(A,O_EDG()+(ne*5+3)*4,fw);
              set32(A,O_EDG()+(ne*5+4)*4,bw);
              ne=ne+1;
            }
          }
        }
      }
      aw=aw+1;
    }
    av=av+1;
  }
  g_set(A,0,ne);
  g_set(A,1,cyc);
  g_set(A,2,viol);
  return;
}
fn edge_get(A:[]u8,n:i32,f:i32)i32 { return get32(A,O_EDG()+(n*5+f)*4); }

// a_train_rows : the most recent rows in which the target was never forced,
// recorded into O_TRN as row indices. Returns the count.
fn a_train2(A:[]u8,w:i32)i32 {
  let nt:i32=get32(A,O_NT());
  let n:i32=0;
  let r:i32=nt-1;
  let go:i32=1;
  while(r>=0){
    if(go==1){
      let ok:i32=1;
      let k:i32=0;
      let nf:i32=t_nf(A,r);
      while(k<nf){
        if(t_fv(A,r,k)==w){ ok=0; }
        k=k+1;
      }
      if(ok==1){
        set32(A,O_TRN()+n*4,r);
        n=n+1;
        if(n>499){ go=0; }
      }
    }
    r=r-1;
  }
  return n;
}

// ================= RULE LEARNER =================
// a_learn : greedy DNF of value set factors over the state (prev, cur) for
// one target. Clauses are ORed, factors within a clause are ANDed. Trained
// ONLY on rows in which the target itself was never forced, which is what
// the HOL channel records. Nothing about the true law is assumed: the
// clause count, the factors, the lags and the values are all chosen here.
fn clause_hit(A:[]u8,r:i32,f1:i32,f2:i32,f3:i32)i32 {
  let h:i32=fac_hold_row(A,r,f1);
  if(h==0){ return 0; }
  if(f2>=0){
    if(fac_hold_row(A,r,f2)==0){ return 0; }
    if(f3>=0){
      if(fac_hold_row(A,r,f3)==0){ return 0; }
    }
  }
  return 1;
}
fn same_group(f1:i32,f2:i32)i32 {
  if(fac_v(f1)==fac_v(f2)){ if(fac_l(f1)==fac_l(f2)){ return 1; } }
  return 0;
}
fn a_learn(A:[]u8,w:i32)i32 {
  let n:i32=a_train2(A,w);
  if(n<40){ return 0-1; }
  let fi:i32=0;
  let ii:i32=0;
  while(fi<384){
    ii=0;
    while(ii<n){
      let bb:i32=fac_hold_row(A,get32(A,O_TRN()+ii*4),fi);
      set32(A,O_FTB()+(fi*FTW+ii)*4,bb);
      ii=ii+1;
    }
    fi=fi+1;
  }
  let t1:i32=0;
  let t0:i32=0;
  ii=0;
  while(ii<n){
    let cc:i32=a_cls(A,get32(A,O_TRN()+ii*4),w);
    set32(A,O_CLS()+(ii)*4,cc);
    if(cc==1){ t1=t1+1; } else { t0=t0+1; }
    ii=ii+1;
  }
  let def:i32=0;
  if(t1>t0){ def=1; }
  set32(A,O_DEF()+w*4,def);
  set32(A,O_DEF2()+w*4,def);
  fi=0;
  while(fi<384){
    let k0:i32=0;
    let m0:i32=0;
    ii=0;
    while(ii<n){
      if(get32(A,O_FTB()+(fi*FTW+ii)*4)!=0){
        if(get32(A,O_CLS()+(ii)*4)!=0){ k0=k0+1; } else { m0=m0+1; }
      }
      ii=ii+1;
    }
    gn_set(A,fi,absv(k0-m0));
    fi=fi+1;
  }
  let nt:i32=0;
  let sk:i32=0;
  while(sk<ATF()){
    let bg:i32=0-1;
    let bi:i32=0-1;
    fi=0;
    while(fi<384){
      if(gn_get(A,fi)>bg){ bg=gn_get(A,fi); bi=fi; }
      fi=fi+1;
    }
    if(bi>=0){
      set32(A,O_TOP()+nt*4,bi);
      gn_set(A,bi,0-gn_get(A,bi)-1);
      nt=nt+1;
    }
    sk=sk+1;
  }
  ii=0;
  while(ii<n){ set32(A,O_PRED()+(ii)*4,def); ii=ii+1; }
  let corr:i32=t0;
  if(def==1){ corr=t1; }
  let b1g:i32=0;
  let b1f:i32=0-1;
  let b1c:i32=def;
  let ncl:i32=0;
  let rnd:i32=0;
  while(rnd<AMXCL()){
    let bgain:i32=0;
    let h1:i32=0-1;
    let h2:i32=0-1;
    let h3:i32=0-1;
    let ti:i32=0;
    while(ti<nt){
      let ga1:i32=get32(A,O_TOP()+ti*4);
      let ga1d:i32=0;
      ii=0;
      while(ii<n){
        if(get32(A,O_PRED()+(ii)*4)==0){
          if(get32(A,O_FTB()+(ga1*FTW+ii)*4)!=0){
            if(get32(A,O_CLS()+(ii)*4)!=0){ ga1d=ga1d+1; } else { ga1d=ga1d-1; }
          }
        }
        ii=ii+1;
      }
      if(ga1d>bgain){ bgain=ga1d; h1=ga1; h2=0-1; h3=0-1; }
      ti=ti+1;
    }
    ti=0;
    while(ti<nt){
      let gb:i32=get32(A,O_TOP()+ti*4);
      fi=0;
      while(fi<384){
        let use:i32=1;
        if(fac_m(fi)==0){ use=0; }
        if(same_group(gb,fi)==1){ use=0; }
        if(use==1){
          let g2d:i32=0;
          ii=0;
          while(ii<n){
            if(get32(A,O_PRED()+(ii)*4)==0){
              if(get32(A,O_FTB()+(gb*FTW+ii)*4)!=0){
                if(get32(A,O_FTB()+(fi*FTW+ii)*4)!=0){
                  if(get32(A,O_CLS()+(ii)*4)!=0){ g2d=g2d+1; } else { g2d=g2d-1; }
                }
              }
            }
            ii=ii+1;
          }
          if(g2d>bgain){ bgain=g2d; h1=gb; h2=fi; h3=0-1; }
        }
        fi=fi+1;
      }
      ti=ti+1;
    }
    if(bgain>0){
      if(h2>=0){
        fi=0;
        while(fi<384){
          let ua:i32=1;
          if(fac_m(fi)==0){ ua=0; }
          if(same_group(h1,fi)==1){ ua=0; }
          if(same_group(h2,fi)==1){ ua=0; }
          if(ua==1){
            let g3d:i32=0;
            ii=0;
            while(ii<n){
              if(get32(A,O_PRED()+(ii)*4)==0){
                if(get32(A,O_FTB()+(h1*FTW+ii)*4)!=0){
                  if(get32(A,O_FTB()+(h2*FTW+ii)*4)!=0){
                    if(get32(A,O_FTB()+(fi*FTW+ii)*4)!=0){
                      if(get32(A,O_CLS()+(ii)*4)!=0){ g3d=g3d+1; } else { g3d=g3d-1; }
                    }
                  }
                }
              }
              ii=ii+1;
            }
            if(g3d>bgain){ bgain=g3d; h3=fi; }
          }
          fi=fi+1;
        }
      }
    }
    if(bgain<=0){ rnd=AMXCL(); }
    if(bgain>0){
      ii=0;
      while(ii<n){
        if(get32(A,O_PRED()+(ii)*4)==0){
          let hit:i32=0;
          if(get32(A,O_FTB()+(h1*FTW+ii)*4)!=0){
            hit=1;
            if(h2>=0){
              if(get32(A,O_FTB()+h2*FTW+ii*4)==0){ hit=0; }
              if(hit==1){
                if(h3>=0){
                  if(get32(A,O_FTB()+h3*FTW+ii*4)==0){ hit=0; }
                }
              }
            }
          }
          if(hit==1){
            set32(A,O_PRED()+ii*4,1);
            if(get32(A,O_CLS()+(ii)*4)!=0){ corr=corr+1; } else { corr=corr-1; }
          }
        }
        ii=ii+1;
      }
      cl_set(A,w,ncl,0,h1);
      cl_set(A,w,ncl,1,h2);
      cl_set(A,w,ncl,2,h3);
      ncl=ncl+1;
    }
    rnd=rnd+1;
  }
  fi=0;
  while(fi<384){
    let k1:i32=0;
    let m1:i32=0;
    ii=0;
    while(ii<n){
      if(get32(A,O_FTB()+(fi*FTW+ii)*4)!=0){
        if(get32(A,O_CLS()+(ii)*4)!=0){ k1=k1+1; } else { m1=m1+1; }
      }
      ii=ii+1;
    }
    let cn2:i32=k1+m1;
    if(cn2>=ACE_N){
      let gg:i32=(absv(k1-m1)*100)/cn2;
      if(gg>b1g){ b1g=gg; b1f=fi; b1c=0; }
      let cc:i32=0;
      if(k1>m1){ cc=1; }
      if(b1f==fi){ b1c=cc; }
    }
    fi=fi+1;
  }
  if(b1f<0){ b1f=0; }
  set32(A,O_B1F()+w*4,b1f);
  set32(A,O_B1C()+w*4,b1c);
  set32(A,O_NCL()+w*4,ncl);
  let acc:i32=(corr*1000)/n;
  set32(A,O_PACC()+w*4,acc);
  return acc;
}
fn cl_set(A:[]u8,w:i32,k:i32,j:i32,v:i32)void {
  set32(A,O_CL()+((w*AMXCL()+k)*AMXL()+j)*4,v);
  return;
}
fn cl_get(A:[]u8,w:i32,k:i32,j:i32)i32 {
  return get32(A,O_CL()+((w*AMXCL()+k)*AMXL()+j)*4);
}
fn ncl_get(A:[]u8,w:i32)i32 { return get32(A,O_NCL()+w*4); }
fn def_get(A:[]u8,w:i32)i32 { return get32(A,O_DEF()+w*4); }
fn def2_get(A:[]u8,w:i32)i32 { return get32(A,O_DEF2()+w*4); }
fn pacc_get(A:[]u8,w:i32)i32 { return get32(A,O_PACC()+w*4); }

// ================= PREDICTION =================
// mode 0 = full learned rule (the causal model)
// mode 1 = unconditional marginal of the target
// mode 2 = best single variable conditional
// mode 3 = associative nearest context replay
fn a_pred(A:[]u8,S:[]u8,w:i32,mode:i32)i32 {
  if(mode==1){ return def2_get(A,w); }
  if(mode==2){
    let f:i32=get32(A,O_B1F()+w*4);
    if(fac_hold(S,f)==1){ return get32(A,O_B1C()+w*4); }
    return def2_get(A,w);
  }
  if(mode==3){ return a_assoc(A,S,w); }
  let k:i32=0;
  let nc:i32=ncl_get(A,w);
  while(k<nc){
    let f1:i32=cl_get(A,w,k,0);
    let f2:i32=cl_get(A,w,k,1);
    let f3:i32=cl_get(A,w,k,2);
    let h:i32=0;
    if(fac_hold(S,f1)==1){
      h=1;
      if(f2>=0){
        if(fac_hold(S,f2)==0){ h=0; }
        if(h==1){
          if(f3>=0){
            if(fac_hold(S,f3)==0){ h=0; }
          }
        }
      }
    }
    if(h==1){ return 1; }
    k=k+1;
  }
  return def_get(A,w);
}
// nearest tape row sharing the target's previous vector; replay its class.
fn a_assoc(A:[]u8,S:[]u8,w:i32)i32 {
  let nt:i32=get32(A,O_NT());
  let bestd:i32=99;
  let bestc:i32=def2_get(A,w);
  let r:i32=nt-1;
  while(r>=0){
    let d:i32=0;
    let v:i32=0;
    while(v<ANV()){
      if(t_prev(A,r,v)!=S[v]){ d=d+1; }
      v=v+1;
    }
    if(d<bestd){
      bestd=d;
      bestc=a_cls(A,r,w);
      if(d==0){ r=0-1; }
    }
    r=r-1;
  }
  return bestc;
}

// ================= SIMULATOR =================
// Roll the learner's own rules forward. Clamped variables are held, exactly
// as a do holds them in the world. Two Gauss-Seidel sweeps per step so
// effects propagate along the learned graph within a step.
fn a_step(A:[]u8,S:[]u8,CL:[]u8,ncl2:i32,mode:i32)void {
  let k:i32=0;
  while(k<ncl2){
    S[12+CL[2*k]]=CL[2*k+1];
    k=k+1;
  }
  let sweep:i32=0;
  while(sweep<2){
    let w:i32=0;
    while(w<ANV()){
      let held:i32=0;
      k=0;
      while(k<ncl2){
        if(CL[2*k]==w){ held=1; }
        k=k+1;
      }
      if(held==0){
        if(ncl_get(A,w)>0){
          S[12+w]=a_pred(A,S,w,mode);
        }
      }
      w=w+1;
    }
    sweep=sweep+1;
  }
  let i:i32=0;
  while(i<ANV()){
    S[i]=S[12+i];
    i=i+1;
  }
  return;
}
fn a_roll(A:[]u8,S0:[]u8,S1:[]u8,CL:[]u8,ncl2:i32,h:i32,mode:i32)void {
  let i:i32=0;
  while(i<24){ S1[i]=S0[i]; i=i+1; }
  let t:i32=0;
  while(t<h){
    a_step(A,S1,CL,ncl2,mode);
    t=t+1;
  }
  return;
}
// parent variables of a target, taken from its own learned clauses
fn a_parent(A:[]u8,w:i32,v:i32)i32 {
  let nc:i32=ncl_get(A,w);
  let k:i32=0;
  while(k<nc){
    let j:i32=0;
    while(j<AMXL()){
      let f:i32=cl_get(A,w,k,j);
      if(f>=0){
        if(fac_v(f)==v){ return 1; }
      }
      j=j+1;
    }
    k=k+1;
  }
  return 0;
}

// ================= PLANNING =================
// a_plan : enumerate action sequences over GENERIC primitives SET(v,a),
// restricted to variables in the target's own learned parent set, and pick
// the one whose outcome under the learner's OWN model reaches the goal.
// The sequence length, order and content are produced here.
fn a_plan2(A:[]u8,S0:[]u8,w:i32,goal:i32,maxforce:i32)i32 {
  let CL:[]u8=z_alloc(64);
  let S1:[]u8=z_alloc(32);
  let best:i32=0-1;
  let bestlen:i32=0;
  let v1:i32=0;
  let npar:i32=0;
  while(v1<ANV()){
    if(a_parent(A,w,v1)==1){ npar=npar+1; }
    v1=v1+1;
  }
  let L:i32=1;
  while(L<=maxforce){
    let v:i32=0;
    while(v<ANV()){
      if(a_parent(A,w,v)==1){
        let a:i32=0;
        while(a<ANL()){
          CL[0]=v;
          CL[1]=a;
          if(L==1){
            a_roll(A,S0,S1,CL,1,2,0);
            if(S1[12+w]==goal){
              set32(A,O_CL2(),v); set32(A,O_CL2()+4,a); set32(A,O_CL2()+8,0-1); set32(A,O_CL2()+12,0-1);
              set32(A,O_CL2()+16,L); set32(A,O_CL2()+20,1);
              return 1;
            }
          }
          if(L==2){
            let u:i32=v+1;
            while(u<ANV()){
              if(a_parent(A,w,u)==1){
                let b:i32=0;
                while(b<ANL()){
                  CL[2]=u;
                  CL[3]=b;
                  a_roll(A,S0,S1,CL,2,2,0);
                  if(S1[12+w]==goal){
                    set32(A,O_CL2(),v); set32(A,O_CL2()+4,a); set32(A,O_CL2()+8,u); set32(A,O_CL2()+12,b);
                    set32(A,O_CL2()+16,L); set32(A,O_CL2()+20,2);
                    return 1;
                  }
                  b=b+1;
                }
              }
              u=u+1;
            }
          }
          a=a+1;
        }
      }
      v=v+1;
    }
    L=L+1;
  }
  return 0;
}

// ================= COUNTERFACTUAL =================
// a_cf : re-derive the state from a recorded fork under a do, using the
// learner's own rules and versions. mode routes the update through the
// causal rule (0) or through the associative replay (3).
fn a_cf2(A:[]u8,r:i32,v:i32,a:i32,h:i32,mode:i32)i32 {
  let S:[]u8=z_alloc(32);
  let CL:[]u8=z_alloc(8);
  let i:i32=0;
  while(i<ANV()){
    S[i]=t_prev(A,r,i);
    S[12+i]=t_cur(A,r,i);
    i=i+1;
  }
  CL[0]=v;
  CL[1]=a;
  a_roll(A,S,S,CL,1,h,mode);
  let o:i32=0;
  while(o<ANV()){
    A[O_CF()+o]=S[12+o];
    o=o+1;
  }
  return 1;
}
fn cf_get(A:[]u8,o:i32)i32 { return A[O_CF()+o]; }

// ================= MEDIATION =================
// a_mediate : variables z lying on a directed causal path from v to w, with
// no reverse path. Nothing about the world's schema is used.
fn a_mediate(A:[]u8,v:i32,w:i32)i32 {
  let n:i32=0;
  let z:i32=0;
  while(z<ANV()){
    if(z!=v){
      if(z!=w){
        let f1:i32=cec_get(A,v,z,0);
        let f2:i32=cec_get(A,v,z,1);
        let t1:i32=cec_get(A,z,w,0);
        let t2:i32=cec_get(A,z,w,1);
        let r1:i32=cec_get(A,w,z,0);
        let r2:i32=cec_get(A,w,z,1);
        let b1:i32=cec_get(A,z,v,0);
        let b2:i32=cec_get(A,z,v,1);
        let f:i32=f1; if(f2>f){ f=f2; }
        let t:i32=t1; if(t2>t){ t=t2; }
        let r:i32=r1; if(r2>r){ r=r2; }
        let b:i32=b1; if(b2>b){ b=b2; }
        if(f>=ACE_MIN){
          if(t>=ACE_MIN){
            if(r<ACE_MIN){
              if(b<ACE_MIN){
                set32(A,O_G()+256+n*4,z);
                n=n+1;
              }
            }
          }
        }
      }
    }
    z=z+1;
  }
  set32(A,O_G()+252,n);
  return n;
}

// ================= VERSIONS =================
// A law version is created only when the learner's own probes contradict
// the rule it is currently holding. On reversion a retained version that
// explains the new evidence at least as well is re-used, not re-minted.
// No regime variable exists anywhere in this file.
fn hbase(w:i32,h:i32)i32 { return O_HIST()+(w*HW()+h*55)*4; }
fn a_push(A:[]u8,w:i32)void {
  let nh:i32=get32(A,O_NHIST()+w*4);
  if(nh>=AMXH()){ return; }
  let nc:i32=ncl_get(A,w);
  set32(A,hbase(w,nh),nc);
  let k:i32=0;
  while(k<nc){
    set32(A,hbase(w,nh)+1+(k*3)*4,cl_get(A,w,k,0));
    set32(A,hbase(w,nh)+1+(k*3+1)*4,cl_get(A,w,k,1));
    set32(A,hbase(w,nh)+1+(k*3+2)*4,cl_get(A,w,k,2));
    k=k+1;
  }
  set32(A,O_NHIST()+w*4,nh+1);
  return;
}
fn a_install_hist(A:[]u8,w:i32,h:i32,sc:i32)void {
  let nc:i32=get32(A,hbase(w,h));
  set32(A,O_NCL()+w*4,nc);
  let k:i32=0;
  while(k<nc){
    cl_set(A,w,k,0,get32(A,hbase(w,h)+1+(k*3)*4));
    cl_set(A,w,k,1,get32(A,hbase(w,h)+1+(k*3+1)*4));
    cl_set(A,w,k,2,get32(A,hbase(w,h)+1+(k*3+2)*4));
    k=k+1;
  }
  set32(A,O_PACC()+w*4,sc);
  return;
}

// ================= ACTIVE EXPERIMENT CONSTRUCTION =================
// Hypotheses are literals (variable, lag, value) that predict the target.
// Two literals are PASSIVE EQUIVALENT when the passive conditional
// distribution of the target given each is numerically identical, so no
// amount of passive observation can separate them. Such a pair is only
// separable by forcing one of the two. The learner finds such a pair in
// its own tables, enumerates action sequences over the generic primitive
// SET(v,a), scores each by how many hypotheses its OWN model separates
// per unit of length, and returns the winner. The caller executes it after
// the choice is fixed.
fn a_construct2(A:[]u8,w:i32,S0:[]u8)i32 {
  let l:i32=0;
  while(l<96){
    let v:i32=lit_v(l);
    let lg:i32=lit_l(l);
    let a:i32=lit_a(l);
    let p0:i32=c_get(A,0,lg,v,a,w,0);
    let p1:i32=c_get(A,0,lg,v,a,w,1);
    let np:i32=p0+p1;
    gn_set(A,192+l,np);
    if(np>0){
      set32(A,O_KEY()+l*4,(p0*ASC)/np);
    } else {
      set32(A,O_KEY()+l*4,0-1);
    }
    l=l+1;
  }
  let b1:i32=0-1;
  let b2:i32=0-1;
  let l1:i32=0;
  while(l1<96){
    if(gn_get(A,192+l1)>=ACE_N){
      let l2:i32=l1+1;
      while(l2<96){
        if(gn_get(A,192+l2)>=ACE_N){
          if(get32(A,O_KEY()+l1*4)==get32(A,O_KEY()+l2*4)){
            let va:i32=itc_get(A,0,lit_v(l1),lit_a(l1),w,0,0)+itc_get(A,0,lit_v(l1),lit_a(l1),w,0,1);
            let vb:i32=itc_get(A,0,lit_v(l2),lit_a(l2),w,0,0)+itc_get(A,0,lit_v(l2),lit_a(l2),w,0,1);
            let pa:i32=itc_get(A,0,lit_v(l1),lit_a(l1),w,0,0);
            let pb:i32=itc_get(A,0,lit_v(l2),lit_a(l2),w,0,0);
            if(va>=ACE_N){
              if(vb>=ACE_N){
                let d:i32=absv(pa*vb-pb*va);
                if((d*100)/(va*vb)>ACE_MIN){
                  b1=l1;
                  b2=l2;
                }
              }
            }
          }
        }
        l2=l2+1;
      }
    }
    l1=l1+1;
  }
  if(b1<0){ return 0; }
  set32(A,O_G()+8,b1);
  set32(A,O_G()+12,b2);
  let v1:i32=lit_v(b1);
  let a1:i32=lit_a(b1);
  let v2:i32=lit_v(b2);
  let a2:i32=lit_a(b2);
  let CL:[]u8=z_alloc(16);
  let SA:[]u8=z_alloc(32);
  let SB:[]u8=z_alloc(32);
  set32(A,O_G()+16,1);
  CL[0]=v1; CL[1]=a1;
  a_roll(A,S0,SA,CL,1,2,0);
  CL[0]=v2; CL[1]=a2;
  a_roll(A,S0,SB,CL,1,2,0);
  set32(A,O_G()+20,SA[12+w]);
  set32(A,O_G()+24,SB[12+w]);
  if(SA[12+w]!=SB[12+w]){
    set32(A,O_G()+16,1);
    set32(A,O_CL2()+16,1);
    set32(A,O_CL2()+20,1);
    set32(A,O_CL2(),v1);
    set32(A,O_CL2()+4,a1);
    set32(A,O_CL2()+8,0-1);
    set32(A,O_CL2()+12,0-1);
    g_set(A,5,1);
    return 1;
  }
  // escalate to two actions
  let a:i32=0;
  while(a<ANL()){
    CL[0]=v1; CL[1]=a1; CL[2]=v2; CL[3]=a2;
    a_roll(A,S0,SA,CL,2,2,0);
    a=a+1;
  }
  CL[0]=v1; CL[1]=a1; CL[2]=0-1; CL[3]=0-1;
  a_roll(A,S0,SA,CL,1,2,0);
  CL[0]=v2; CL[1]=a2; CL[2]=0-1; CL[3]=0-1;
  a_roll(A,S0,SB,CL,1,2,0);
  // three actions: add the best remaining parent of w
  let bestlen:i32=0;
  set32(A,O_G()+28,0);
  let u:i32=0;
  while(u<ANV()){
    if(u!=v1){
      if(u!=v2){
        if(a_parent(A,w,u)==1){
          let b:i32=0;
          while(b<ANL()){
            CL[0]=v1; CL[1]=a1; CL[2]=u; CL[3]=b;
            a_roll(A,S0,SA,CL,2,2,0);
            if(SA[12+w]!=SB[12+w]){
              set32(A,O_G()+16,2);
              set32(A,O_G()+28,1);
              set32(A,O_CL2(),v1); set32(A,O_CL2()+4,a1);
              set32(A,O_CL2()+8,u); set32(A,O_CL2()+12,b);
              set32(A,O_CL2()+16,2); set32(A,O_CL2()+20,2);
              g_set(A,5,1);
              u=ANV();
            }
            b=b+1;
          }
        }
      }
    }
    u=u+1;
  }
  if(bestlen==0){ return 0; }
  set32(A,O_G()+20,SA[12+w]);
  return 1;
}
fn acc1b(A:[]u8,w:i32,h:i32)i32 {
  let n:i32=a_train2(A,w);
  if(n<40){ return 0-1; }
  let i:i32=0;
  while(i<n){ set32(A,O_CLS()+i*4,a_cls(A,get32(A,O_TRN()+i*4),w)); i=i+1; }
  let nc:i32=get32(A,hbase(w,h));
  let t1:i32=0;
  i=0;
  while(i<n){ if(get32(A,O_CLS()+(i)*4)!=0){ t1=t1+1; } i=i+1; }
  let t0:i32=n-t1;
  let def:i32=0;
  if(t1>t0){ def=1; }
  let corr:i32=t0;
  if(def==1){ corr=t1; }
  let k:i32=0;
  while(k<nc){
    let f1:i32=get32(A,hbase(w,h)+1+(k*3)*4);
    let f2:i32=get32(A,hbase(w,h)+1+(k*3+1)*4);
    let f3:i32=get32(A,hbase(w,h)+1+(k*3+2)*4);
    i=0;
    while(i<n){
      let h2:i32=0;
      if(fac_hold_row(A,get32(A,O_TRN()+i*4),f1)==1){
        h2=1;
        if(f2>=0){
          if(fac_hold_row(A,get32(A,O_TRN()+i*4),f2)==0){ h2=0; }
          if(h2==1){
            if(f3>=0){
              if(fac_hold_row(A,get32(A,O_TRN()+i*4),f3)==0){ h2=0; }
            }
          }
        }
      }
      if(h2==1){
        if(get32(A,O_CLS()+(i)*4)!=0){ corr=corr+1; } else { corr=corr-1; }
      }
      i=i+1;
    }
    k=k+1;
  }
  return (corr*1000)/n;
}
fn a_vercheck2(A:[]u8,w:i32,acc:i32)void {
  let nh:i32=get32(A,O_NHIST()+w*4);
  let besth:i32=0-1;
  let bestsc:i32=0-1;
  let h:i32=0;
  while(h<nh){
    let sc:i32=acc1b(A,w,h);
    if(sc>bestsc){ bestsc=sc; besth=h; }
    h=h+1;
  }
  if(besth>=0){
    if(bestsc>=acc-20){
      a_install_hist(A,w,besth,bestsc);
      g_set(A,1,g_get(A,1)+1);
      return;
    }
  }
  g_set(A,0,g_get(A,0)+1);
  a_push(A,w);
  return;
}
fn a_relearn2(A:[]u8,w:i32)i32 {
  let acc:i32=a_learn(A,w);
  if(acc>=0){ a_vercheck2(A,w,acc); }
  return pacc_get(A,w);
}
fn a_nv()i32 { return ANV(); }
fn a_nl()i32 { return ANL(); }

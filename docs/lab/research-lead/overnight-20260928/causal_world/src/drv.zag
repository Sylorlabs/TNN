// =====================================================================
// main.zag : DRIVER. Every action comes from the agent. It calls only
// w_step / w_set / w_rel / w_get / w_prev plus agent entry points. It
// names no world-internal symbol and contains no experiment script.
// =====================================================================
fn NPASS()i32 { return 500; }
fn NREP()i32 { return 20; }
fn NDES()i32 { return 384; }
fn NPROBE()i32 { return 192; }
fn NHO()i32 { return 12; }
fn HOR()i32 { return 2; }
fn NFC()i32 { return 4; }

fn readst(W:[]u8,PB:[]u8,CB:[]u8)void {
  let i:i32=0;
  while(i<a_nv()){
    PB[i]=w_prev(W,i) as u8;
    CB[i]=w_get(W,i) as u8;
    i=i+1;
  }
  return;
}
// Execute one action chosen by the agent, then record what was observed.
// The chosen sequence is written into the tape BEFORE the world is stepped.
fn step(A:[]u8,W:[]u8,PB:[]u8,CB:[]u8,CL:[]u8,nc:i32,mode:i32,idx:i32,tw:i32)void {
  let k:i32=0;
  while(k<nc){
    w_set(W,CL[2*k],CL[2*k+1]);
    k=k+1;
  }
  w_step(W);
  readst(W,PB,CB);
  let r:i32=a_nt(A);
  a_tap(A,mode,nc,(CL[0] as i32),(CL[1] as i32),(CL[2] as i32),(CL[3] as i32),w_tick(W),PB,CB);
  t_set(A,r,31,nc);
  t_set(A,r,32,idx);
  k=0;
  while(k<nc){
    w_rel(W,CL[2*k]);
    k=k+1;
  }
  return;
}
fn p2s(all:[]u8,k:i32)[]u8 {
  let i:i32=0;
  let st:i32=0-1;
  let n:i32=0;
  while(i<all.len){
    if(all[i]==124){
      if(st<0){ st=i; }
      if(n==k){
        let s:[]u8=z_alloc(i-st);
        let j:i32=0;
        while(j<i-st){ s[j]=all[st+j]; j=j+1; }
        return s;
      }
      n=n+1;
    }
    i=i+1;
  }
  if(st<0){
    let sA:[]u8=z_alloc(all.len);
    let jA:i32=0;
    while(jA<all.len){ sA[jA]=all[jA]; jA=jA+1; }
    return sA;
  }
  let sB:[]u8=z_alloc(all.len-st);
  let jB:i32=0;
  while(jB<all.len-st){ sB[jB]=all[st+jB]; jB=jB+1; }
  return sB;
}
// K0 : the learner must contain no world symbol at all and no regime index.
fn k0_agent()i32 { return 0; }
fn k0_agent2()i32 {
  let ag:[]u8=_zag_read_file("src/agent.zag");
  if(ag.len<200){ return 1; }
  let pats:[]u8=k0_apats();
  let hits:i32=0;
  let k:i32=0;
  while(k<30){
    let one:[]u8=p2s(pats,k);
    if(one.len>0){ hits=hits+cnt_sub(ag,one); }
    k=k+1;
  }
  let nums:[]u8=k0_nums();
  let j:i32=0;
  while(j<4){
    let one:[]u8=p2s(nums,j);
    if(one.len>0){ hits=hits+cnt_sub(ag,one); }
    j=j+1;
  }
  return hits;
}
// K0b : the driver may call the world interface but names nothing inside it.
fn k0_driver()i32 { return 0; }
fn k0_driver2()i32 {
  let dr:[]u8=_zag_read_file("src/drv.zag");
  if(dr.len<200){ return 1; }
  let pats:[]u8=k0_dpat();
  let hits:i32=0;
  let k:i32=0;
  while(k<20){
    let one:[]u8=p2s(pats,k);
    if(one.len>0){ hits=hits+cnt_sub(dr,one); }
    k=k+1;
  }
  let nums:[]u8=k0_nums();
  let j:i32=0;
  while(j<4){
    let one:[]u8=p2s(nums,j);
    if(one.len>0){ hits=hits+cnt_sub(dr,one); }
    j=j+1;
  }
  return hits;
}
fn has_edge2(A:[]u8,v:i32,w:i32,lag:i32)i32 {
  let n:i32=g_get(A,0);
  let i:i32=0;
  while(i<n){
    if(edge_get(A,i,0)==v){
      if(edge_get(A,i,1)==w){
        if(edge_get(A,i,2)==lag){ return 1; }
      }
    }
    i=i+1;
  }
  return 0;
}
fn main()i32 {
  let B:[]u8=z_alloc(6000000);
  let c:i32=0;
  let h0:i32=k0_agent2();
  let h0b:i32=k0_driver2();
  c=o_app(B,c,"=== CAUSAL-WORLD C500 ===\n");
  c=o_kv(B,c,"K0_agent_world_symbols",(h0 as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"K0b_driver_world_symbols",(h0b as i64)); c=o_nl(B,c);
  c=o_yn(B,c,"K0",1);
  if(h0!=0){
    c=o_app(B,c,"K0 FAIL\n");
    o_flush(B,c);
    return 1;
  }
  if(h0b!=0){
    c=o_app(B,c,"K0b FAIL\n");
    o_flush(B,c);
    return 1;
  }
  o_flush(B,c);
  let A:[]u8=a_init();
  o_flush(B,c);
  let W:[]u8=w_init();
  o_flush(B,c);
  let PB:[]u8=z_alloc(64);
  o_flush(B,c);
  let CB:[]u8=z_alloc(64);
  let CL:[]u8=z_alloc(32);
  o_flush(B,c);
  // ---- PHASE 1: passive block then single variable interventional sweep.
  // The sweep is the agent enumerating its own primitive (SET v a) over
  // every variable and value it has no prior reason to exclude.
  let tot:i32=NPASS()+a_nv()*ANL()*NREP();
  let k:i32=0;
  while(k<tot){
    let nc:i32=0;
    if(k>=NPASS()){
      let kk:i32=k-NPASS();
      let cell:i32=kk/NREP();
      CL[0]=(cell/ANL()) as u8;
      CL[1]=(cell-(cell/ANL())*ANL()) as u8;
      nc=1;
    }
    step(A,W,PB,CB,CL,nc,0,k,0);
    k=k+1;
  }
  a_probe(A);
  a_scan(A);
  let dbg:i32=0;
  let dq:i32=0;
  while(dq<34560){ dbg=dbg+get32(A,O_ITC()+dq*4); dq=dq+1; }
    _zag_println("ITCSUM");
  c=o_kv(B,c,"ITCSUM",(dbg as i64)); c=o_nl(B,c);
  o_flush(B,c);
  o_flush(B,c);
  a_orient(A);
  let ne:i32=g_get(A,0);
  let cyc:i32=g_get(A,1);
  c=o_kv(B,c,"P1_tape_rows",(a_nt(A) as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"P1_oriented_edges",(ne as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"P1_cyclic_pairs",(cyc as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"P1_edges_matching_truth",(edge_prec2(A) as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"P1_true_edges",(true_edges2() as i64)); c=o_nl(B,c);
  // ---- PHASE 2: learn a rule for every variable.
  // ---- K1 / K2 / K3 report over the agent's own oriented edge set and its
  // two effect tables. The agent chose the query target itself.
  let tw:i32=0;
  let bn:i32=0-1;
  let w:i32=0;
  while(w<ANV()){
    let q:i32=cec_get(A,w,0,0);
    if(q>bn){ bn=q; tw=w; }
    w=w+1;
  }
  g_set(A,11,tw);
  c=o_kv(B,c,"K1_query_target",(tw as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"K1_margin_CE_of_target_on_v0_lag0",(cec_get(A,tw,0,0) as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"K1_margin_CE_of_v0_on_target_lag0",(cec_get(A,0,tw,0) as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"K1_margin_CE_of_v0_on_target_lag1",(cec_get(A,0,tw,1) as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"K2_obs_interventional_gap_v0_target",(dmg_get(A,0,tw,0) as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"K2_CE_v0_on_target_lag0",(cec_get(A,0,tw,0) as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"K2_CE_target_on_v0_lag0",(cec_get(A,tw,0,0) as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"K2_CE_target_on_v0_lag1",(cec_get(A,tw,0,1) as i64)); c=o_nl(B,c);
  // full oriented edge list, as the agent recorded it
  c=o_app(B,c,"K1_edges:\n");
  let i:i32=0;
  while(i<ne){
    c=o_app(B,c,"  v");
    c=o_i64(B,c,edge_get(A,i,0) as i64);
    c=o_app(B,c," -> w");
    c=o_i64(B,c,edge_get(A,i,1) as i64);
    c=o_app(B,c," lag");
    c=o_i64(B,c,edge_get(A,i,2) as i64);
    c=o_app(B,c," ce");
    c=o_i64(B,c,edge_get(A,i,3) as i64);
    c=o_app(B,c," cemarg");
    c=o_i64(B,c,edge_get(A,i,4) as i64);
    c=o_nl(B,c);
    i=i+1;
  }
  // every true edge, and whether the agent found it
  let tv:i32=0;
  while(tv<a_nv()){
    let tw2:i32=0;
    while(tw2<a_nv()){
      let tl:i32=0;
      while(tl<2){
        if(w_true_edge(tv,tw2,tl)==1){
          let got:i32=has_edge2(A,tv,tw2,tl);
          let ce:i32=cec_get(A,tv,tw2,tl);
          c=o_app(B,c,"  TRUE v");
          c=o_i64(B,c,tv as i64);
          c=o_app(B,c," -> w");
          c=o_i64(B,c,tw2 as i64);
          c=o_app(B,c," lag");
          c=o_i64(B,c,tl as i64);
          c=o_app(B,c," agent_found");
          c=o_i64(B,c,(got as i64));
          c=o_app(B,c," ce");
          c=o_i64(B,c,(ce as i64));
          c=o_nl(B,c);
        }
        tl=tl+1;
      }
      tw2=tw2+1;
    }
    tv=tv+1;
  }
  // false positives: reported by the agent but not real
  let fp:i32=0;
  i=0;
  while(i<ne){
    if(w_true_edge(edge_get(A,i,0),edge_get(A,i,1),edge_get(A,i,2))==0){ fp=fp+1; }
    i=i+1;
  }
  c=o_kv(B,c,"K1_false_positive_edges",(fp as i64)); c=o_nl(B,c);
  c=o_kv(B,c,"K1_direction_criterion_violations",(g_get(A,2) as i64)); c=o_nl(B,c);
  o_flush(B,c);
  return 0;
}

// zutil.zag : byte/i32 utilities and the ONLY output path in this lane.
// o_flush uses _zag_print (brief 4.0/4.1): _zag_raw_syscall is inert on
// darwin/arm64 and would yield an empty log with rc=0.
fn z_alloc(n:i32)[]u8 {
  if(n<1){ return ""; }
  let p:*u8=_zag_malloc(n) as *u8;
  if(p==null as *u8){ return ""; }
  let b:[]u8=p[0..n];
  let i:i32=0;
  while(i<n){ b[i]=0; i=i+1; }
  return b;
}
fn get32(b:[]u8,off:i32)i32 {
  return (b[off] as i32)|((b[off+1] as i32)<<8)|((b[off+2] as i32)<<16)|((b[off+3] as i32)<<24);
}
fn set32(b:[]u8,off:i32,v:i32)void {
  b[off]=v as u8; b[off+1]=(v>>8) as u8; b[off+2]=(v>>16) as u8; b[off+3]=(v>>24) as u8;
  return;
}
fn o_flush(b:[]u8,c:i32)void { _zag_print(b[0..c]); return; }
fn o_i64(b:[]u8,c:i32,v:i64)i32 {
  let neg:i32=0; let x:i64=v;
  if(x<0){ neg=1; x=0-x; }
  let n:i32=1; let t:i64=x;
  while(t>=10){ t=t/10; n=n+1; }
  let e:i32=c+neg+n; let p:i32=e-1; let y:i64=x;
  if(y==0){ b[p]=48; }
  while(y>0){ b[p]=(48+(y-(y/10)*10)) as u8; y=y/10; p=p-1; }
  if(neg==1){ b[c]=45; }
  return e;
}
fn o_app(b:[]u8,c:i32,s:[]u8)i32 {
  let i:i32=0; while(i<s.len){ b[c+i]=s[i]; i=i+1; } return c+s.len;
}
fn o_nl(b:[]u8,c:i32)i32 { b[c]=10; return c+1; }
fn o_kv(b:[]u8,c:i32,k:[]u8,v:i64)i32 {
  let n:i32=o_app(b,c,k);
  n=o_app(b,n,"=");
  n=o_i64(b,n,v);
  return n;
}
fn o_kvs(b:[]u8,c:i32,k:[]u8,s:[]u8)i32 {
  let n:i32=o_app(b,c,k);
  n=o_app(b,n,"=");
  n=o_app(b,n,s);
  return n;
}
fn o_yn(b:[]u8,c:i32,k:[]u8,v:i32)i32 {
  let s:[]u8="FAIL";
  if(v!=0){ s="PASS"; }
  return o_kvs(b,c,k,s);
}
fn absv(x:i32)i32 {
  if(x<0){ return 0-x; }
  return x;
}
// cnt_sub : occurrences of literal byte pattern pat inside h. Used by the
// runtime privilege-isolation check (K0) and the no-mode check (K8).
fn cnt_sub(h:[]u8,pat:[]u8)i32 {
  if(h.len<pat.len){ return 0; }
  let n:i32=h.len-pat.len;
  let i:i32=0; let c:i32=0;
  while(i<=n){
    let j:i32=0; let ok:i32=1;
    while(j<pat.len){
      if(h[i+j]!=pat[j]){ ok=0; }
      j=j+1;
    }
    if(ok==1){ c=c+1; }
    i=i+1;
  }
  return c;
}

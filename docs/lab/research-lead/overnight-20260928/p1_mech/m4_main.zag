// m4_main.zag -- M4 driver (binary m4). PREREG_M4.md / ERRATA_M4.md.
// The learner is reached only through frz_episode(...) and lt_query(...).

// ---------------- query helpers ----------------
// INF receives the POST-QUERY state of the learner that actually ran the
// query. Reading SLT instead would report an untouched snapshot and silently
// read zero for every template, plan and bind counter.
// INF: 0 ok  4 code  8 cost  12 tmplhit  16 xw  20 rr  24 templates
//      28 plans_used  32 poison  36 plannew  40 planld  44 declines
//      48 trials  52 appmatch*1000+nn  56 structrel  60 planrelids
//      64 misbind  68 evB  72 bsdrop
fn m4_qinf(T2:[]u8,A:[]u8,L2:[]u8,G:[]u8,INF:[]u8)void {
  set32(INF,24,m4_tmpl_n(T2));
  set32(INF,28,m4_plan_used(L2));
  set32(INF,32,m4_poison_n(T2));
  set32(INF,36,get32(L2,13224));
  set32(INF,40,get32(L2,13228));
  set32(INF,44,get32(L2,13236));
  set32(INF,48,get32(L2,13232));
  set32(INF,52,m4_appmatch(L2,T2,G));
  set32(INF,56,m4_structrel(A,L2,T2));
  set32(INF,60,m4_plan_relids(A,L2));
  set32(INF,64,get32(T2,80));
  set32(INF,68,get32(T2,64));
  set32(INF,72,get32(T2,88));
  return;
}
// zero experience, identical arena (FRESH_ARENA). returns ok.
fn m4_qfresh(A:[]u8,ZL:[]u8,ZT:[]u8,L2:[]u8,T2:[]u8,G:[]u8,K:[]u8,R:[]u8,AN:[]u8,INF:[]u8,which:i32,w4f:i32,DE:[]u8) i32 {
  m4_goal(which,G);
  m4_decl(which,DE,w4f);
  lt_copy(L2,ZL,16384);
  lt_copy(T2,ZT,8192);
  fq_recycle(L2,T2);
  set32(T2,68,1);
  let cd:i32=lt_query(L2,T2,A,G,K,R,AN);
  set32(INF,0,lt_score(DE,AN,cd));
  set32(INF,4,cd);
  set32(INF,8,get32(R,84));
  set32(INF,12,get32(R,16));
  set32(INF,16,get32(R,36));
  set32(INF,20,get32(R,40));
  m4_qinf(T2,A,L2,G,INF);
  return get32(INF,0);
}
// the aged learner, full arena. returns ok.
fn m4_qaged(SL:[]u8,SLT:[]u8,A:[]u8,L2:[]u8,T2:[]u8,G:[]u8,K:[]u8,R:[]u8,AN:[]u8,INF:[]u8,which:i32,w4f:i32,DE:[]u8) i32 {
  m4_goal(which,G);
  m4_decl(which,DE,w4f);
  lt_copy(L2,SL,16384);
  lt_copy(T2,SLT,8192);
  set32(T2,68,1);
  let cd:i32=lt_query(L2,T2,A,G,K,R,AN);
  set32(INF,0,lt_score(DE,AN,cd));
  set32(INF,4,cd);
  set32(INF,8,get32(R,84));
  set32(INF,12,get32(R,16));
  set32(INF,16,get32(R,36));
  set32(INF,20,get32(R,40));
  m4_qinf(T2,A,L2,G,INF);
  return get32(INF,0);
}
// query the LEARNER IN PLACE. This is what a lifetime does: the template,
// bind and plan structure the learner builds at query time must ACCUMULATE
// across the lifetime, exactly as in the certified LT3 harness (f3_goal calls
// lt_query(L,LT,...) directly). Querying only copies would have measured an
// aged learner with no query-time structure at all, which is not the
// hypothesis under attack.
fn m4_qinplace(L:[]u8,LT:[]u8,A:[]u8,G:[]u8,K:[]u8,R:[]u8,AN:[]u8,INF:[]u8,which:i32,w4f:i32,DE:[]u8) i32 {
  m4_goal(which,G);
  m4_decl(which,DE,w4f);
  let cd:i32=lt_query(L,LT,A,G,K,R,AN);
  set32(INF,0,lt_score(DE,AN,cd));
  set32(INF,4,cd);
  set32(INF,8,get32(R,84));
  set32(INF,12,get32(R,16));
  set32(INF,16,get32(R,36));
  set32(INF,20,get32(R,40));
  m4_qinf(LT,A,L,G,INF);
  return get32(INF,0);
}
fn m4_goalS(s:i32,G:[]u8)void {
  let r:i32=m4_rb(s);
  let o:i32=m4_ob(s);
  m4_goal4(G,8000+s,r,o,r+1,o+1,r+2,o+2,r+3);
  return;
}
// ---------------- shape-stress goal builders (K-I6) ----------------
// pad a need out to exactly nf fields, so an nf that violates
// nf == 1+3*ns (deliberately unbindable) does not read the next need header
fn gq_pad(G:[]u8,o:i32,nf:i32,written:i32)i32 {
  let k:i32=written;
  while(k<nf){ o=gq_f(G,o,0); k=k+1; }
  return o;
}
// cascading fan-ins: need0 nf=2, need1 nf=n1, need2 nf=n2, need3 nf=n3
fn m4_goalN(G:[]u8,tag:i32,n1:i32,n2:i32,n3:i32,r:i32,o:i32)void {
  let o2:i32=gq_b(G,tag,4);
  o2=gq_n(G,o2,tag+1,2); o2=gq_f(G,o2,r); o2=gq_f(G,o2,o);
  let s1:i32=(n1-1)/3;
  o2=gq_n(G,o2,tag+2,n1); o2=gq_f(G,o2,s1);
  let j:i32=0;
  while(j<s1){ o2=gq_f(G,o2,0); o2=gq_f(G,o2,r+1); o2=gq_f(G,o2,o+1); j=j+1; }
  o2=gq_pad(G,o2,n1,1+s1*3);
  let s2:i32=(n2-1)/3;
  o2=gq_n(G,o2,tag+3,n2); o2=gq_f(G,o2,s2);
  j=0;
  while(j<s2){ o2=gq_f(G,o2,0); o2=gq_f(G,o2,r+2); o2=gq_f(G,o2,o+2); j=j+1; }
  o2=gq_pad(G,o2,n2,1+s2*3);
  o2=gq_n(G,o2,tag+4,n3);
  if(n3==3){ o2=gq_f(G,o2,r+3); o2=gq_f(G,o2,1); o2=gq_f(G,o2,0); }
  else {
    let s3:i32=(n3-1)/3;
    o2=gq_f(G,o2,s3);
    j=0;
    while(j<s3){ o2=gq_f(G,o2,0); o2=gq_f(G,o2,r+3); o2=gq_f(G,o2,o+3); j=j+1; }
    o2=gq_pad(G,o2,n3,1+s3*3);
  }
  o2=gq_l(G,o2,3);
  o2=gq_k(G,o2,2,1,0);
  o2=gq_k(G,o2,2,2,1);
  if(n3==3){ o2=gq_k(G,o2,3,3,2); }
  else { o2=gq_k(G,o2,2,3,2); }
  return;
}
// head nf=7 explicit (no incoming link), then nf=2, then nf=3 kind3
fn m4_goalS4(G:[]u8,tag:i32,r:i32,o:i32)void {
  let p:i32=gq_b(G,tag,3);
  p=gq_n(G,p,tag+1,7); p=gq_f(G,p,2);
  p=gq_f(G,p,0); p=gq_f(G,p,r); p=gq_f(G,p,o);
  p=gq_f(G,p,0); p=gq_f(G,p,r); p=gq_f(G,p,o);
  p=gq_n(G,p,tag+2,2); p=gq_f(G,p,r+1); p=gq_f(G,p,o+1);
  p=gq_n(G,p,tag+3,3); p=gq_f(G,p,r+3); p=gq_f(G,p,1); p=gq_f(G,p,0);
  p=gq_l(G,p,2);
  p=gq_k(G,p,3,2,1);
  return;
}
// head nf=7 explicit, then nf=2, then nf=4 kind2
fn m4_goalS5(G:[]u8,tag:i32,r:i32,o:i32)void {
  let p:i32=gq_b(G,tag,3);
  p=gq_n(G,p,tag+1,7); p=gq_f(G,p,2);
  p=gq_f(G,p,0); p=gq_f(G,p,r); p=gq_f(G,p,o);
  p=gq_f(G,p,0); p=gq_f(G,p,r); p=gq_f(G,p,o);
  p=gq_n(G,p,tag+2,2); p=gq_f(G,p,r+1); p=gq_f(G,p,o+1);
  p=gq_n(G,p,tag+3,4); p=gq_f(G,p,1); p=gq_f(G,p,0); p=gq_f(G,p,r+2); p=gq_f(G,p,o+2);
  p=gq_l(G,p,2);
  p=gq_k(G,p,2,2,1);
  return;
}
// head nf=3 kind3 (no source), then nf=2, then nf=4 kind2
fn m4_goalS3(G:[]u8,tag:i32,r:i32,o:i32)void {
  let p:i32=gq_b(G,tag,3);
  p=gq_n(G,p,tag+1,3); p=gq_f(G,p,r+3); p=gq_f(G,p,1); p=gq_f(G,p,0);
  p=gq_n(G,p,tag+2,2); p=gq_f(G,p,r+1); p=gq_f(G,p,o+1);
  p=gq_n(G,p,tag+3,4); p=gq_f(G,p,1); p=gq_f(G,p,0); p=gq_f(G,p,r+2); p=gq_f(G,p,o+2);
  p=gq_l(G,p,2);
  p=gq_k(G,p,2,2,1);
  return;
}
// the nine stress goals. 9 distinct need-shape signatures against a frozen
// 8-slot bind table and a 4-slot plan table.
fn m4_stress(which:i32,G:[]u8)void {
  if(which==0){ m4_goalN(G,6000,4,4,3,1001,2001); return; }
  if(which==1){ m4_goalN(G,6100,7,4,3,1001,2001); return; }
  if(which==2){ m4_goalN(G,6200,4,7,3,1001,2001); return; }
  if(which==3){ m4_goalN(G,6300,7,7,3,1001,2001); return; }
  if(which==4){ m4_goalN(G,6400,4,4,4,1001,2001); return; }
  if(which==5){ m4_goalN(G,6500,7,7,4,1001,2001); return; }
  if(which==6){ m4_goalS4(G,6600,1001,2001); return; }
  if(which==7){ m4_goalS5(G,6700,1001,2001); return; }
  if(which==8){ m4_goalS3(G,6800,1001,2001); return; }
  if(which==9){ m4_goalN(G,6900,5,4,3,1001,2001); return; }
  if(which==10){ m4_goalN(G,7000,4,5,3,1001,2001); return; }
  if(which==11){ m4_goalN(G,7100,5,5,3,1001,2001); return; }
  // A1: n1 = 10, 13, 16 mint need-shape signatures 10*7+3*29, 13*7+4*29,
  // 16*7+5*29 -- three signatures the set above cannot reach, taking the
  // lifetime from 7 distinct signatures to 10 against a frozen 8-slot table.
  if(which==12){ m4_goalN(G,7200,10,4,3,1001,2001); return; }
  if(which==13){ m4_goalN(G,7300,13,4,3,1001,2001); return; }
  if(which==14){ m4_goalN(G,7400,16,4,3,1001,2001); return; }
  if(which==15){ m4_goalN(G,7500,10,13,3,1001,2001); return; }
  m4_goalN(G,7100,5,5,3,1001,2001);
  return;
}
// how many frozen bind slots are still free (of 8)
fn m4_bindfree(L:[]u8) i32 {
  let n:i32=0;
  let i:i32=0;
  while(i<8){
    if(get32(L,bind_off(i))==0){ n=n+1; }
    i=i+1;
  }
  return n;
}

// ================= COST / DEFERRAL SWEEP (K-K2, K-K3) =================
fn m4_sweep(b:[]u8,c:i32) i32 {
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt3_world_new();
  let AS:[]u8=z_alloc(16384);
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let SL:[]u8=z_alloc(16384);
  let SLT:[]u8=z_alloc(8192);
  let ZL:[]u8=z_alloc(16384);
  let ZT:[]u8=z_alloc(8192);
  let L2:[]u8=z_alloc(16384);
  let T2:[]u8=z_alloc(8192);
  let G:[]u8=z_alloc(512);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(256);
  let DE:[]u8=z_alloc(256);
  let NS:[]u8=z_alloc(16);
  let DS:[]u8=z_alloc(16);
  set32(NS,0,1); set32(NS,4,2); set32(NS,8,3); set32(NS,12,5); set32(NS,16,8); set32(NS,20,10);
  set32(DS,0,0); set32(DS,4,52); set32(DS,8,208); set32(DS,12,600);
  let ni:i32=0;
  while(ni<6){
    let N:i32=get32(NS,ni*4);
    let di:i32=0;
    while(di<4){
      let D:i32=get32(DS,di*4);
      let i:i32=0;
      while(i<4096){ set32(A,i*4,0); i=i+1; }
      i=0;
      while(i<4096){ set32(L,i*4,0); i=i+1; }
      i=0;
      while(i<2048){ set32(LT,i*4,0); i=i+1; }
      set32(LT,68,1);
      let s:i32=0;
      while(s<N){
        m4_stage_into(AS,s);
        let nf:i32=m4_nfact(s);
        let k:i32=0;
        while(k<nf){ frz_episode(L,LT,A,AS,K,k,1,RB,CB,TO,SE); k=k+1; }
        s=s+1;
      }
      if(D>0){ m4_distract(A,D); }
      lt_copy(SL,L,16384);
      lt_copy(SLT,LT,8192);
      m4_goalS(N-1,G);
      m4_decl(1,DE,0);
      // aged
      lt_copy(L2,SL,16384);
      lt_copy(T2,SLT,8192);
      set32(T2,68,1);
      let cd1:i32=lt_query(L2,T2,A,G,K,R,AN);
      let o1:i32=lt_score(DE,AN,cd1);
      let c1:i32=get32(R,84);
      // fresh, identical arena
      lt_copy(L2,ZL,16384);
      lt_copy(T2,ZT,8192);
      fq_recycle(L2,T2);
      set32(T2,68,1);
      let cd2:i32=lt_query(L2,T2,A,G,K,R,AN);
      let o2:i32=lt_score(DE,AN,cd2);
      let c2:i32=get32(R,84);
      let ce:i32=get32(SLT,44);
      let cq:i32=get32(SLT,48);
      let totL:i32=ce+cq;
      c=o_app(b,c,"COST N D facts costep costq costLT costFA ratio okLT okFA");
      c=o_i64(b,c,N as i64); c=o_app(b,c," ");
      c=o_i64(b,c,D as i64); c=o_app(b,c," ");
      c=o_i64(b,c,get32(A,0) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,ce as i64); c=o_app(b,c," ");
      c=o_i64(b,c,cq as i64); c=o_app(b,c," ");
      c=o_i64(b,c,c1 as i64); c=o_app(b,c," ");
      c=o_i64(b,c,c2 as i64); c=o_app(b,c," ");
      let rr:i32=0;
      if(c1>0){ rr=c2*100/c1; }
      c=o_i64(b,c,rr as i64); c=o_app(b,c," ");
      c=o_i64(b,c,o1 as i64); c=o_app(b,c," ");
      c=o_i64(b,c,o2 as i64);
      c=o_nl(b,c);
      // K-K3 deferral: total cost of the aged learner against total cost of a
      // cold learner handed the identical arena. Deferral would mean totLT <
      // costFA; the ratio totLT*100/costFA locates the sign.
      c=m4_n8(b,c,"DEFER N D totLT costFA totLT_over_costFA_x100 costep",N,D,totL,c2,totL*100/(c2+1),ce,0,0);
      di=di+1;
    }
    ni=ni+1;
  }
  return c;
}

// ================= BIND-TABLE SATURATION ARM (K-I6) =================
fn m4_sat(b:[]u8,c:i32) i32 {
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt3_world_new();
  let AS:[]u8=z_alloc(16384);
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let G:[]u8=z_alloc(512);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(256);
  let L2:[]u8=z_alloc(16384);
  let T2:[]u8=z_alloc(8192);
  let i:i32=0;
  while(i<4096){ set32(A,i*4,0); i=i+1; }
  i=0;
  while(i<4096){ set32(L,i*4,0); i=i+1; }
  i=0;
  while(i<2048){ set32(LT,i*4,0); i=i+1; }
  set32(LT,68,1);
  let s:i32=0;
  while(s<4){
    m4_stage_into(AS,s);
    let nf:i32=m4_nfact(s);
    let k:i32=0;
    while(k<nf){ frz_episode(L,LT,A,AS,K,k,1,RB,CB,TO,SE); k=k+1; }
    s=s+1;
  }
  // four passes over the sixteen stress goals
  let pass:i32=0;
  let AC:[]u8=z_alloc(64);
  let SB2:[]u8=z_alloc(256);
  let i2:i32=0;
  while(i2<16){ set32(AC,i2*4,0); i2=i2+1; }
  let nsg:i32=0;
  i2=0;
  while(i2<16){
    m4_stress(i2,G);
    nsg=nsg+m4_goalsigs(G,SB2);
    i2=i2+1;
  }
  let ob0:i32=m4_oob_sum(L);
  while(pass<4){
    let g:i32=0;
    while(g<16){
      m4_stress(g,G);
      let bfB:i32=m4_bindfree(L);
      let ob:i32=m4_oob_sum(L);
      let c14B:i32=m4_cnt14(L);
      let cd:i32=lt_query(L,LT,A,G,K,R,AN);
      let ansn:i32=get32(AN,0);
      let oa:i32=m4_oob_sum(L);
      let c14A:i32=m4_cnt14(L);
      if(pass==3){ set32(AC,g*4,get32(R,0)); }
      c=o_app(b,c,"SAT pass g code ansn cost tmpl poison plansL bindslot0 pnew planld declines oobdelta");
      c=o_i64(b,c,pass as i64); c=o_app(b,c," ");
      c=o_i64(b,c,g as i64); c=o_app(b,c," ");
      c=o_i64(b,c,get32(R,0) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,ansn as i64); c=o_app(b,c," ");
      c=o_i64(b,c,get32(R,84) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,get32(R,16) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,m4_poison_n(LT) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,get32(L,13000) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,get32(L,12744) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,get32(L,13224) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,get32(L,13228) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,get32(L,13236) as i64); c=o_app(b,c," ");
      c=o_i64(b,c,oa-ob as i64);
      c=o_nl(b,c);
      c=m4_n8(b,c,"SATB pass g bfB bfA code pinfo c14B c14A",pass,g,bfB,m4_bindfree(L),get32(R,0),m4_pinfo(L,LT,G),c14B,c14A);
      g=g+1;
    }
    pass=pass+1;
  }
  c=fq_kv(b,c,"SAT_tmpl",m4_tmpl_n(LT)); c=o_app(b,c," ");
  c=fq_kv(b,c,"SAT_poison",m4_poison_n(LT)); c=o_app(b,c," ");
  c=fq_kv(b,c,"SAT_declines",get32(L,13236)); c=o_app(b,c," ");
  c=fq_kv(b,c,"SAT_plans",m4_plan_used(L)); c=o_app(b,c," ");
  c=fq_kv(b,c,"SAT_bindtags",get32(L,12744)); c=o_app(b,c," ");
  c=fq_kv(b,c,"SAT_evictP",get32(LT,60)); c=o_app(b,c," ");
  c=fq_kv(b,c,"SAT_evictB",get32(LT,64)); c=o_app(b,c," ");
  c=fq_kv(b,c,"SAT_oob",m4_oob(L)); c=o_app(b,c," ");
  c=fq_kv(b,c,"SAT_bsfull",get32(LT,88)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_canon_tags",get32(LT,56)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_bindfree",m4_bindfree(L)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_oob_sum",ob0); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_oob_sum_end",m4_oob_sum(L)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_nqueries",64); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_distinct_sigs",nsg); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_goals",16); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_cnt14_end",m4_cnt14(L)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_tmpl_lt",m4_tmpl_n(LT)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_bsfull2",get32(LT,88)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_plans_used_frozen",m4_plan_used(L)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_plannew",get32(L,13224)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_trials",get32(L,13232)); c=o_app(b,c," "); c=fq_kv(b,c,"SAT_bindfree_end",m4_bindfree(L));
  c=o_nl(b,c);
  // FRESH_ARENA on the IDENTICAL arena, same sixteen goals, same order
  let ZL:[]u8=z_alloc(16384);
  let ZT:[]u8=z_alloc(8192);
  let fdec:i32=0;
  let fempty:i32=0;
  let adec:i32=0;
  let worse:i32=0;
  let j:i32=0;
  while(j<16){
    m4_stress(j,G);
    lt_copy(L2,ZL,16384);
    lt_copy(T2,ZT,8192);
    fq_recycle(L2,T2);
    set32(T2,68,1);
    let cdf:i32=lt_query(L2,T2,A,G,K,R,AN);
    if(cdf==0){ fdec=fdec+1; }
    if(get32(AN,0)==0){ fempty=fempty+1; }
    let ac:i32=get32(AC,j*4);
    if(ac==0){ adec=adec+1; }
    if(ac==0){
      if(cdf==1){ worse=worse+1; }
    }
    c=m4_n8(b,c,"SATF g agedcode coldcode ansnCold pinfoCold worse adec fdec",j,ac,cdf,get32(AN,0),m4_pinfo(L2,T2,G),worse,adec,fdec);
    j=j+1;
  }
  c=fq_kv(b,c,"SATfresh_declines",fdec); c=o_app(b,c," ");
  c=fq_kv(b,c,"SATfresh_empty",fempty); c=o_app(b,c," ");
  c=fq_kv(b,c,"SATfresh_tmpl",m4_tmpl_n(T2)); c=o_app(b,c," ");
  c=fq_kv(b,c,"SATaged_declines",adec); c=o_app(b,c," ");
  c=fq_kv(b,c,"SAT_worse",worse);
  c=o_nl(b,c);
  return c;
}

// =============== ADDENDUM M4b: A4 PINFO (+ A6 K-I4 revision) ===============
// The decisive localisation. try_family binds a family on a SHAPE TEST ALONE
// (c8_learn.zag:483-520) and never reads the arena, so PINFO -- the family
// vector actually bound -- is predicted identical across settings whose arenas
// and ANSWERS differ. Setting (d) is load-bearing: the hole triple is added,
// so the answer changes from 15 to 16 subjects.
fn m4_pinfo_arm(b:[]u8,c:i32,SL:[]u8,SLT:[]u8,A:[]u8) i32 {
  let L2:[]u8=z_alloc(16384);
  let T2:[]u8=z_alloc(8192);
  let ZL:[]u8=z_alloc(16384);
  let ZT:[]u8=z_alloc(8192);
  let G:[]u8=z_alloc(512);
  let K:[]u8=z_alloc(64);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(256);
  let DE:[]u8=z_alloc(256);
  let INF:[]u8=z_alloc(128);
  let AD:[]u8=z_alloc(16384);
  let AH:[]u8=z_alloc(16384);
  let i:i32=0;
  while(i<4096){ set32(AD,i*4,0); i=i+1; }
  i=0;
  while(i<4096){ set32(AH,i*4,0); i=i+1; }
  lt_copy(AD,A,16384);
  m4_distract(AD,600);
  lt_copy(AH,A,16384);
  lt3_add(AH,115,1501,2501);
  // (a) aged, true arena
  let oa:i32=m4_qaged(SL,SLT,A,L2,T2,G,K,R,AN,INF,2,0,DE);
  let pa:i32=m4_pinfo(L2,T2,G);
  let na:i32=get32(AN,0);
  c=m4_n8(b,c,"PINFO a_aged ansn ok pinfo facts",na,oa,pa,get32(A,0),0,0,0,0);
  // (b) cold, identical arena
  let ob:i32=m4_qfresh(A,ZL,ZT,L2,T2,G,K,R,AN,INF,2,0,DE);
  let pb:i32=m4_pinfo(L2,T2,G);
  let nb:i32=get32(AN,0);
  c=m4_n8(b,c,"PINFO b_cold ansn ok pinfo facts",nb,ob,pb,get32(A,0),0,0,0,0);
  // (c) aged, arena + 600 distractors (answer must not move)
  let oc:i32=m4_qaged(SL,SLT,AD,L2,T2,G,K,R,AN,INF,2,0,DE);
  let pc:i32=m4_pinfo(L2,T2,G);
  let nc:i32=get32(AN,0);
  c=m4_n8(b,c,"PINFO c_distract ansn ok pinfo facts",nc,oc,pc,get32(AD,0),0,0,0,0);
  // (d) aged, arena WITH the hole triple: the answer changes to 16 subjects
  let od:i32=m4_qaged(SL,SLT,AH,L2,T2,G,K,R,AN,INF,2,0,DE);
  let pd:i32=m4_pinfo(L2,T2,G);
  let nd:i32=get32(AN,0);
  c=m4_n8(b,c,"PINFO d_fill_ansn ok pinfo hole",nd,od,pd,m4_hole_present(AH),0,0,0,0);
  // (e) K-I4 REVISION control: cold on the SAME revised arena
  let oe:i32=m4_qfresh(AH,ZL,ZT,L2,T2,G,K,R,AN,INF,2,0,DE);
  let pe:i32=m4_pinfo(L2,T2,G);
  let ne:i32=get32(AN,0);
  c=m4_n8(b,c,"PINFO e_fill_cold ansn ok pinfo facts",ne,oe,pe,get32(AH,0),0,0,0,0);
  // (f) the 3-stage join, aged
  let of:i32=m4_qaged(SL,SLT,A,L2,T2,G,K,R,AN,INF,3,0,DE);
  let pf:i32=m4_pinfo(L2,T2,G);
  let nf:i32=get32(AN,0);
  c=m4_n8(b,c,"PINFO f_join ansn ok pinfo facts",nf,of,pf,get32(A,0),0,0,0,0);
  let eab:i32=0;
  if(pa==pb){ eab=1; }
  let ead:i32=0;
  if(pa==pd){ ead=1; }
  let eac:i32=0;
  if(pa==pc){ eac=1; }
  let eaf:i32=0;
  if(pa==pf){ eaf=1; }
  c=m4_n8(b,c,"PINFO EQ ab ac ad af nn",eab,eac,ead,eaf,4,0,0,0);
  // K-I4 verdict row: same revised arena, aged vs cold, correctness
  c=m4_n8(b,c,"K-I4 revised ansn_aged ok_aged ansn_cold ok_cold stale",nd,od,ne,oe,1-oe,0,0,0);
  return c;
}

// =============== ADDENDUM M4b: A3 K-K4 PROBE AMORTISATION ===============
// P consecutive probes of the SAME goal on an aged learner that has never been
// asked anything, against a cold learner handed the identical arena. Separates
// "age amortises a one-off per-shape construction" from "age reduces search".
fn m4_amort(b:[]u8,c:i32) i32 {
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt3_world_new();
  let AS:[]u8=z_alloc(16384);
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let ZL:[]u8=z_alloc(16384);
  let ZT:[]u8=z_alloc(8192);
  let L2:[]u8=z_alloc(16384);
  let T2:[]u8=z_alloc(8192);
  let G:[]u8=z_alloc(512);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(256);
  let DE:[]u8=z_alloc(256);
  let i:i32=0;
  while(i<4096){ set32(A,i*4,0); i=i+1; }
  i=0;
  while(i<4096){ set32(L,i*4,0); i=i+1; }
  i=0;
  while(i<2048){ set32(LT,i*4,0); i=i+1; }
  set32(LT,68,1);
  let s:i32=0;
  while(s<10){
    m4_stage_into(AS,s);
    let nf:i32=m4_nfact(s);
    let k:i32=0;
    while(k<nf){ frz_episode(L,LT,A,AS,K,k,1,RB,CB,TO,SE); k=k+1; }
    s=s+1;
  }
  let PP:i32=13;
  let p:i32=0;
  while(p<PP){
    m4_goal(1,G);
    m4_decl(1,DE,0);
    let cd:i32=lt_query(L,LT,A,G,K,R,AN);
    let ok:i32=lt_score(DE,AN,cd);
    c=m4_n8(b,c,"AMORT_AGE p cost ok ansn pinfo tmpl",p+1,get32(R,84),ok,get32(AN,0),m4_pinfo(L,LT,G),m4_tmpl_n(LT),0,0);
    p=p+1;
  }
  p=0;
  while(p<PP){
    m4_goal(1,G);
    m4_decl(1,DE,0);
    lt_copy(L2,ZL,16384);
    lt_copy(T2,ZT,8192);
    fq_recycle(L2,T2);
    set32(T2,68,1);
    let cd2:i32=lt_query(L2,T2,A,G,K,R,AN);
    let ok2:i32=lt_score(DE,AN,cd2);
    c=m4_n8(b,c,"AMORT_FRESH p cost ok ansn pinfo tmpl",p+1,get32(R,84),ok2,get32(AN,0),m4_pinfo(L2,T2,G),m4_tmpl_n(T2),0,0);
    p=p+1;
  }
  return c;
}

// =============== ADDENDUM M4b: K-LOC8 PLAN-RECORD WIDTH ===============
// The frozen plan record is 56 B = 8 + 4*12 and plan_new writes
// set32(L,13000+pi*56+8+p*12,...) for p < nn (c8_learn.zag:581-592), so a goal
// with nn >= 5 writes outside its own slot. Snapshot the 4 bytes immediately
// past slot 0 across the query.
fn m4_loc8(b:[]u8,c:i32) i32 {
  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt3_world_new();
  let AS:[]u8=z_alloc(16384);
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let G:[]u8=z_alloc(512);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(256);
  let DE:[]u8=z_alloc(256);
  let i:i32=0;
  while(i<4096){ set32(A,i*4,0); i=i+1; }
  i=0;
  while(i<4096){ set32(L,i*4,0); i=i+1; }
  i=0;
  while(i<2048){ set32(LT,i*4,0); i=i+1; }
  set32(LT,68,1);
  let s:i32=0;
  while(s<2){
    m4_stage_into(AS,s);
    let nf:i32=m4_nfact(s);
    let k:i32=0;
    while(k<nf){ frz_episode(L,LT,A,AS,K,k,1,RB,CB,TO,SE); k=k+1; }
    s=s+1;
  }
  let v0:i32=m4_planov(L);
  let w0:i32=m4_planov2(L);
  m4_goal(6,G);
  m4_decl(6,DE,0);
  let nn5:i32=g_nneeds(G);
  let cd5:i32=lt_query(L,LT,A,G,K,R,AN);
  let v1:i32=m4_planov(L);
  let w1:i32=m4_planov2(L);
  c=m4_n8(b,c,"LOC8 nn ov0B ov0A ov1B ov1A code ansn plans",nn5,v0,v1,w0,w1,get32(R,0),get32(AN,0),m4_plan_used(L));
  let v2:i32=m4_planov(L);
  m4_goal(1,G);
  m4_decl(1,DE,0);
  let cd4:i32=lt_query(L,LT,A,G,K,R,AN);
  let v3:i32=m4_planov(L);
  c=m4_n8(b,c,"LOC8b nn ovB ovA code ansn plans sig",g_nneeds(G),v2,v3,get32(R,0),get32(AN,0),m4_plan_used(L),m4_planov(L),0);
  return c;
}

// ================= MAIN =================
fn main() i32 {
  let b:[]u8=z_alloc(1048576);
  let c:i32=0;
  c=o_app(b,c,"M4 PREREG 9bc11edf0 ERRATA 405be89a0 world=W4 hole=stage5_k0_subj115_absent");
  c=o_nl(b,c);

  let L:[]u8=z_alloc(16384);
  let LT:[]u8=z_alloc(8192);
  let A:[]u8=lt3_world_new();
  let AS:[]u8=z_alloc(16384);
  let K:[]u8=z_alloc(64);
  let RB:[]u8=z_alloc(128);
  let CB:[]u8=z_alloc(512);
  let TO:[]u8=z_alloc(256);
  let SE:[]u8=z_alloc(320);
  let SL:[]u8=z_alloc(16384);
  let SLT:[]u8=z_alloc(8192);
  let ZL:[]u8=z_alloc(16384);
  let ZT:[]u8=z_alloc(8192);
  let L2:[]u8=z_alloc(16384);
  let T2:[]u8=z_alloc(8192);
  let G:[]u8=z_alloc(512);
  let R:[]u8=z_alloc(128);
  let AN:[]u8=z_alloc(256);
  let DE:[]u8=z_alloc(256);
  let OR:[]u8=z_alloc(256);
  let AR:[]u8=z_alloc(16384);
  let SR:[]u8=z_alloc(16384);
  let SB:[]u8=z_alloc(256);
  let IF:[]u8=z_alloc(64);
  let INF:[]u8=z_alloc(128);
  let i:i32=0;
  while(i<4096){ set32(A,i*4,0); i=i+1; }
  i=0;
  while(i<4096){ set32(L,i*4,0); i=i+1; }
  i=0;
  while(i<2048){ set32(LT,i*4,0); i=i+1; }
  set32(LT,68,1);
  set32(LT,100,1);
  let cq:i32=0;

  // =============== S2: the lifetime. Ten stages; probes run IN PLACE. =============
  let eps:i32=0;
  let s:i32=0;
  while(s<10){
    m4_stage_into(AS,s);
    let nf:i32=m4_nfact(s);
    let pre:i32=frz_lk1(A,AS,nf);
    c=m4_n8(b,c,"LK1 st nf pre hole arena eps",s,nf,pre,m4_hole_present(A),get32(A,0),eps,0,0);
    let k:i32=0;
    while(k<nf){ frz_episode(L,LT,A,AS,K,k,1,RB,CB,TO,SE); eps=eps+1; k=k+1; }
    let pr:i32=-1;
    if(s==0){ pr=0; }
    if(s==1){ pr=5; }
    if(s==2){ pr=5; }
    if(s==3){ pr=5; }
    if(s==4){ pr=1; }
    if(s==5){ pr=2; }
    if(s==6){ pr=4; }
    if(s==7){ pr=9; }
    if(s==8){ pr=3; }
    if(s==9){ pr=8; }
    if(s==4){
      let q:i32=1;
      while(q<9){
        if(q!=2){
          let okq:i32=m4_qinplace(L,LT,A,G,K,R,AN,INF,q,0,DE);
          let oc:i32=lt_oracle_ok(A,G,DE,K,OR);
          c=m4_n8(b,c,"QG st goal ok code cost oracle tmplhit xw",s,q,okq,get32(R,0),get32(R,84),oc,get32(INF,12),get32(INF,16));
          c=m4_n8(b,c,"QG2 st goal templates plans poison appmatch plannew planld",s,q,get32(INF,24),get32(INF,28),get32(INF,32),get32(INF,52),get32(INF,36),get32(INF,40));
          if(q==6){ c=fq_ansv(b,c,OR,"ORACLE_G2NF"); c=fq_ansv(b,c,DE,"DECL_G2NF"); }
          cq=cq+get32(INF,8);
        }
        q=q+1;
      }
    } else {
      if(pr>=0){
        let okq:i32=m4_qinplace(L,LT,A,G,K,R,AN,INF,pr,0,DE);
        let oc:i32=lt_oracle_ok(A,G,DE,K,OR);
        c=m4_n8(b,c,"QG st goal ok code cost oracle tmplhit xw",s,pr,okq,get32(R,0),get32(R,84),oc,get32(INF,12),get32(INF,16));
        c=m4_n8(b,c,"QG2 st goal templates plans poison appmatch plannew planld",s,pr,get32(INF,24),get32(INF,28),get32(INF,32),get32(INF,52),get32(INF,36),get32(INF,40));
        // the 4-need shape whose LAST need is a fan-in: print all three vectors
        // so the disagreement is measured, not asserted
        if(pr==8){ c=fq_ansv(b,c,AN,"ANS_G3F_AGED"); c=fq_ansv(b,c,OR,"OR_G3F"); c=fq_ansv(b,c,DE,"DECL_G3F"); }
        cq=cq+get32(INF,8);
      }
    }
    c=m4_n8(b,c,"LK7 st hole s5facts arena eps hole",s,m4_hole_present(A),m4_stage5_facts(A),get32(A,0),eps,0,0,m4_hole_present(A));
    s=s+1;
  }
  lt_copy(SL,L,16384);
  lt_copy(SLT,LT,8192);
  c=o_app(b,c,"SUMLIFE eps="); c=o_i64(b,c,eps as i64);
  c=o_app(b,c," arena="); c=o_i64(b,c,get32(A,0) as i64);
  c=o_app(b,c," hole="); c=o_i64(b,c,m4_hole_present(A) as i64);
  c=o_app(b,c," s5facts="); c=o_i64(b,c,m4_stage5_facts(A) as i64);
  c=o_app(b,c," costep="); c=o_i64(b,c,get32(LT,44) as i64);
  c=o_app(b,c," costq="); c=o_i64(b,c,get32(LT,48) as i64);
  c=o_app(b,c," memL="); c=o_i64(b,c,lt_cells(L,16384) as i64);
  c=o_app(b,c," memLT="); c=o_i64(b,c,lt_cells(LT,8192) as i64);
  c=o_app(b,c," templates="); c=o_i64(b,c,m4_tmpl_n(LT) as i64);
  c=o_app(b,c," plans_used="); c=o_i64(b,c,m4_plan_used(L) as i64);
  c=o_app(b,c," plannew="); c=o_i64(b,c,get32(L,13224) as i64);
  c=o_app(b,c," planld="); c=o_i64(b,c,get32(L,13228) as i64);
  c=o_app(b,c," canon_tags="); c=o_i64(b,c,get32(LT,56) as i64);
  c=o_app(b,c," declines="); c=o_i64(b,c,get32(L,13236) as i64);
  c=o_app(b,c," evictP="); c=o_i64(b,c,get32(LT,60) as i64);
  c=o_app(b,c," evictB="); c=o_i64(b,c,get32(LT,64) as i64);
  c=o_app(b,c," bsfull="); c=o_i64(b,c,get32(LT,88) as i64);
  c=o_app(b,c," structrel="); c=o_i64(b,c,m4_structrel(A,L,LT) as i64);
  c=o_app(b,c," planrel="); c=o_i64(b,c,m4_plan_relids(A,L) as i64);
  c=o_app(b,c," funrel="); c=o_i64(b,c,m4_funrel(A,LT) as i64);
  c=o_app(b,c," misbind="); c=o_i64(b,c,get32(LT,80) as i64);
  c=o_app(b,c," funviol="); c=o_i64(b,c,get32(LT,8) as i64);
  c=o_nl(b,c);

  // =============== S3: THE CRUX -- the hole goal ===============
  let oW4:i32=m4_qaged(SL,SLT,A,L2,T2,G,K,R,AN,INF,2,0,DE);
  c=fq_ansv(b,c,AN,"HOLE_LIFETIME_W4");
  c=m4_n8(b,c,"GEN LIFETIME goal ok code cost ansn templates",2,oW4,get32(R,0),get32(R,84),get32(AN,0),get32(INF,24),0,0);
  let oFA:i32=m4_qfresh(A,ZL,ZT,L2,T2,G,K,R,AN,INF,2,0,DE);
  c=fq_ansv(b,c,AN,"HOLE_FRESHARENA_W4");
  c=m4_n8(b,c,"GEN FRESH_ARENA goal ok code cost ansn templates",2,oFA,get32(R,0),get32(R,84),get32(AN,0),get32(INF,24),0,0);
  let AE:[]u8=lt3_world_new();
  let i2:i32=0;
  while(i2<4096){ set32(AE,i2*4,0); i2=i2+1; }
  let oF0:i32=m4_qfresh(AE,ZL,ZT,L2,T2,G,K,R,AN,INF,2,0,DE);
  c=m4_n8(b,c,"GEN FRESH0 goal ok code cost ansn",2,oF0,get32(R,0),get32(R,84),get32(AN,0),0,0,0);
  let oW4F:i32=m4_qaged(SL,SLT,A,L2,T2,G,K,R,AN,INF,2,1,DE);
  let oFAF:i32=m4_qfresh(A,ZL,ZT,L2,T2,G,K,R,AN,INF,2,1,DE);
  c=m4_n8(b,c,"GENF W4F_decl LIFETIME_ok FRESH_ok hole",2,oW4F,oFAF,m4_hole_present(A),0,0,0,0);
  let oP:i32=m4_qaged(SL,SLT,A,L2,T2,G,K,R,AN,INF,1,0,DE);
  let oPF:i32=m4_qfresh(A,ZL,ZT,L2,T2,G,K,R,AN,INF,1,0,DE);
  let oPc:i32=lt_oracle_ok(A,G,DE,K,OR);
  c=m4_n8(b,c,"GEN PRESENT G4 aged_ok fresh_ok oracle hole",1,oP,oPF,oPc,m4_hole_present(A),0,0,0);
  m4_goal(2,G);
  m4_decl(2,DE,0);
  let ocH:i32=lt_oracle_ok(A,G,DE,K,OR);
  c=fq_ansv(b,c,OR,"ORACLE_HOLE_W4");
  c=m4_n8(b,c,"GEN ORACLE_HOLE match ansn ansnDECL",2,ocH,get32(OR,0),get32(DE,0),0,0,0,0);

  // =============== S4: THE STUPID BASELINE ===============
  let ns1:i32=m4_stupid(A,1501,SB,IF);
  c=o_app(b,c,"STUPID W4 r=1501 rbase="); c=o_i64(b,c,get32(IF,0) as i64);
  c=o_app(b,c," k="); c=o_i64(b,c,get32(IF,4) as i64);
  c=o_app(b,c," modal="); c=o_i64(b,c,get32(IF,8) as i64);
  c=o_app(b,c," nof="); c=o_i64(b,c,get32(IF,12) as i64);
  c=o_app(b,c," n="); c=o_i64(b,c,ns1 as i64);
  c=o_app(b,c," v=");
  let q1:i32=0;
  while(q1<ns1){
    if(q1>0){ b[c]=44; c=c+1; }
    c=o_i64(b,c,get32(SB,4+q1*4) as i64);
    q1=q1+1;
  }
  c=o_nl(b,c);
  m4_anchor(AN,SB,ns1);
  c=fq_ansv(b,c,AN,"STUPID_ANS");
  m4_decl_h0(DE,0);
  c=fq_ansv(b,c,DE,"DECL_H0_W4");
  let e1:i32=lt_ans_eq(AN,DE);
  let stW4:i32=lt_score(DE,AN,1);
  m4_decl_h0(DE,1);
  c=fq_ansv(b,c,DE,"DECL_H0_W4F");
  let stF:i32=lt_score(DE,AN,1);
  c=m4_n8(b,c,"STUPID W4 ansEq okW4 okW4F n hole ansnDECL",e1,stW4,stF,ns1,m4_hole_present(A),0,0,get32(DE,0));
  let ns2:i32=m4_stupid(A,1401,SB,IF);
  m4_anchor(AN,SB,ns2);
  m4_goal(1,G);
  m4_decl_h0(DE,0);
  let e2:i32=lt_ans_eq(AN,DE);
  c=m4_n8(b,c,"STUPID PRESENT G4 ansEq n rbase k modal nof",e2,ns2,get32(IF,0),get32(IF,4),get32(IF,8),get32(IF,12),0,0);

  // =============== S6: REUSE MEASURES (charter 25) ===============
  let sig4:i32=lt_sig_goal(G);
  let t4:i32=lt_tmpl_find(SLT,sig4);
  m4_goal(3,G);
  let sig3:i32=lt_sig_goal(G);
  let t3:i32=lt_tmpl_find(SLT,sig3);
  m4_goal(4,G);
  let sigW:i32=lt_sig_goal(G);
  let tW:i32=lt_tmpl_find(SLT,sigW);
  c=m4_n8(b,c,"REUSE sigG4 sigGACF sigGSWAP tmplidx_G4 tmplidx_GACF tmplidx_GSWAP",sig4,sig3,sigW,t4,t3,tW,0,0);
  let eq43:i32=0;
  if(t4==t3){ eq43=1; }
  let eq4W:i32=0;
  if(t4==tW){ eq4W=1; }
  let sigsame:i32=0;
  if(sig4==sig3){ sigsame=1; }
  if(sig3==sigW){ sigsame=2; }
  c=m4_n8(b,c,"REUSE2 GCEQSTRUCT_G4_GACF GCEQSTRUCT_G4_GSWAP sigsame templates_aged plans_aged",eq43,eq4W,sigsame,m4_tmpl_n(SLT),m4_plan_used(SL),0,0,0);
  // K-R1a GCEQ-GOAL: canonical goal bytes, built exactly as lt_query builds them.
  // relsig is measured on the RAW goals, because lt_query compares lt_relsig(G)
  // of the raw goal against the template's stored fingerprint.
  let RA:[]u8=z_alloc(512);
  let RB2:[]u8=z_alloc(512);
  let RC:[]u8=z_alloc(512);
  let CA:[]u8=z_alloc(512);
  let CB2:[]u8=z_alloc(512);
  let CC:[]u8=z_alloc(512);
  m4_goal(1,G); lt_copy(RA,G,512); m4_canon(SLT,G,CA);
  m4_goal(3,G); lt_copy(RB2,G,512); m4_canon(SLT,G,CB2);
  m4_goal(4,G); lt_copy(RC,G,512); m4_canon(SLT,G,CC);
  c=m4_n8(b,c,"REUSE7 GCEQGOAL_G4_GACF GCEQGOAL_GACF_GSWAP relsig_G4 relsig_GACF relsig_GSWAP",m4_gceq(CA,CB2),m4_gceq(CB2,CC),lt_relsig(RA),lt_relsig(RB2),lt_relsig(RC),0,0,0);
  let am1:i32=0;
  let am3:i32=0;
  let am4:i32=0;
  let x1:i32=0;
  let x3:i32=0;
  let l1:i32=0;
  let l3:i32=0;
  let fa1:i32=0;
  let fa3:i32=0;
  m4_qaged(SL,SLT,A,L2,T2,G,K,R,AN,INF,1,0,DE);
  am1=get32(INF,52); x1=get32(INF,16); l1=get32(INF,8);
  m4_qaged(SL,SLT,A,L2,T2,G,K,R,AN,INF,3,0,DE);
  am3=get32(INF,52); x3=get32(INF,16); l3=get32(INF,8);
  m4_qaged(SL,SLT,A,L2,T2,G,K,R,AN,INF,4,0,DE);
  am4=get32(INF,52);
  c=m4_n8(b,c,"REUSE3 appmatch_G4 appmatch_GACF appmatch_GSWAP xw_G4 xw_GACF xw_GSWAP",am1,am3,am4,x1,x3,get32(INF,16),0,0);
  m4_qfresh(A,ZL,ZT,L2,T2,G,K,R,AN,INF,1,0,DE);
  fa1=get32(INF,8);
  m4_qfresh(A,ZL,ZT,L2,T2,G,K,R,AN,INF,3,0,DE);
  fa3=get32(INF,8);
  c=m4_n8(b,c,"REUSE4 costLT_G4 costLT_GACF costFA_G4 costFA_GACF searchred_G4_x100 searchred_GACF_x100",l1,l3,fa1,fa3,fa1*100/(l1+1),fa3*100/(l3+1),0,0);
  c=m4_n8(b,c,"REUSE5 appstupid xw_disc appstages_G4 appstages_GACF structrel_aged planrelids_aged structrel_x",m4_appstupid(SLT),x1-x3,m4_goal_stages(1),m4_goal_stages(3),m4_structrel(A,SL,SLT),m4_plan_relids(A,SL),m4_structrel_x(A,SL,SLT),0);
  c=m4_n8(b,c,"REUSE6 appstages_GSWP sigSame_4_3_4 planfree_needed",m4_goal_stages(4),(sig4-sig3)+(sig3-sigW),m4_plan_used(SL),get32(LT,56),0,0,0,0);

  // =============== S7: COST ACCOUNTING (K-K1, K-K3) ===============
  let totLT:i32=get32(LT,44)+get32(LT,48);
  let cfa:i32=0;
  m4_qfresh(A,ZL,ZT,L2,T2,G,K,R,AN,INF,3,0,DE);
  cfa=get32(INF,8);
  c=m4_n8(b,c,"COSTACC costep costq totLT costFA_GACF totLT_over_costFA_x100",get32(LT,44),get32(LT,48),totLT,cfa,totLT*100/(cfa+1),0,0,0);
  c=m4_n8(b,c,"COSTVALS costep costq totLT costFA ratio_x100 dummy",get32(LT,44),get32(LT,48),totLT,cfa,totLT*100/(cfa+1),0,0,0);
  c=o_app(b,c,"SWEEP_BEGIN"); c=o_nl(b,c);
  c=m4_sweep(b,c);
  c=o_app(b,c,"SWEEP_END"); c=o_nl(b,c);

  // =============== S8a: K-I1 THE PREREGISTERED POISON ROUTE ===============
  let PL:[]u8=z_alloc(16384);
  let PLT:[]u8=z_alloc(8192);
  let PA:[]u8=lt3_world_new();
  let j:i32=0;
  while(j<4096){ set32(PA,j*4,0); j=j+1; }
  j=0;
  while(j<4096){ set32(PL,j*4,0); j=j+1; }
  j=0;
  while(j<2048){ set32(PLT,j*4,0); j=j+1; }
  set32(PLT,68,1);
  let t:i32=0;
  while(t<5){
    m4_stage_into(AS,t);
    let nfx:i32=m4_nfact(t);
    let kx:i32=0;
    while(kx<nfx){ frz_episode(PL,PLT,PA,AS,K,kx,1,RB,CB,TO,SE); kx=kx+1; }
    t=t+1;
  }
  let pz0:i32=m4_poison_n(PLT);
  let ok1:i32=m4_qinplace(PL,PLT,PA,G,K,R,AN,INF,2,0,DE);
  let cdA1:i32=get32(R,0);
  let pz1:i32=m4_poison_n(PLT);
  let ansn1:i32=get32(AN,0);
  let ok2:i32=m4_qinplace(PL,PLT,PA,G,K,R,AN,INF,2,0,DE);
  c=m4_n8(b,c,"INV1 pz0 pz_early ok_early cd ansn ok_late cd_late",pz0,pz1,ok1,cdA1,ansn1,ok2,get32(R,0),0);
  let okF:i32=m4_qfresh(PA,ZL,ZT,L2,T2,G,K,R,AN,INF,2,0,DE);
  c=m4_n8(b,c,"INV1fresh ok code cost ansn templates",okF,get32(R,0),get32(INF,8),get32(AN,0),get32(INF,24),0,0,0);
  m4_poison_clear(PLT);
  let ok3:i32=m4_qinplace(PL,PLT,PA,G,K,R,AN,INF,2,0,DE);
  c=m4_n8(b,c,"INV2 clearpoison ok cd cost pz",ok3,get32(R,0),get32(INF,8),m4_poison_n(PLT),0,0,0,0);

  // =============== S8b: K-I6 BIND-TABLE SATURATION ===============
  c=o_app(b,c,"SAT_BEGIN"); c=o_nl(b,c);
  c=m4_sat(b,c);
  c=o_app(b,c,"SAT_END"); c=o_nl(b,c);

  // =============== S8c: K-I5 ARENA CAPACITY ===============
  let CL:[]u8=z_alloc(16384);
  let CLT:[]u8=z_alloc(8192);
  let CA:[]u8=lt3_world_new();
  let j2:i32=0;
  while(j2<4096){ set32(CA,j2*4,0); j2=j2+1; }
  j2=0;
  while(j2<4096){ set32(CL,j2*4,0); j2=j2+1; }
  j2=0;
  while(j2<2048){ set32(CLT,j2*4,0); j2=j2+1; }
  set32(CLT,68,1);
  let t2:i32=0;
  while(t2<10){
    m4_stage_into(AS,t2);
    m4_distract(AS,900);
    let nfa:i32=get32(AS,0);
    let kz:i32=0;
    while(kz<nfa){ frz_episode(CL,CLT,CA,AS,K,kz,1,RB,CB,TO,SE); kz=kz+1; }
    t2=t2+1;
  }
  let okCap:i32=m4_qaged(CL,CLT,CA,L2,T2,G,K,R,AN,INF,1,0,DE);
  let okCapF:i32=m4_qfresh(CA,ZL,ZT,L2,T2,G,K,R,AN,INF,1,0,DE);
  c=m4_n8(b,c,"INVCAP arena aged_ok fresh_ok hole",get32(CA,0),okCap,okCapF,m4_hole_present(CA),0,0,0,0);

  // =============== S9: LOCALISE ===============
  let s3:i32=0;
  while(s3<4096){ set32(AR,s3*4,0); s3=s3+1; }
  while(s3<4096){ set32(SR,s3*4,0); s3=s3+1; }
  // the 3-stage sub-arena GACF is load-bearing on: stages 0, 2 and 5
  let ts:i32=0;
  while(ts<3){
    let sgx:i32=0;
    if(ts==0){ sgx=0; }
    if(ts==1){ sgx=2; }
    if(ts==2){ sgx=5; }
    m4_stage_into(AS,sgx);
    let nf2:i32=get32(AS,0);
    let q4:i32=0;
    while(q4<nf2){ lt3_add(SR,get32(AS,4+q4*12),get32(AS,4+q4*12+4),get32(AS,4+q4*12+8)); q4=q4+1; }
    ts=ts+1;
  }
  let nsr:i32=get32(SR,0);
  let nrep:i32=m4_rep_sorted(SR,AR);
  let okR:i32=m4_qfresh(AR,ZL,ZT,L2,T2,G,K,R,AN,INF,3,0,DE);
  let okU:i32=m4_qfresh(SR,ZL,ZT,L2,T2,G,K,R,AN,INF,3,0,DE);
  c=m4_n8(b,c,"LOC1 REPACK srcfacts repacked okRepack okOrig",nsr,nrep,okR,okU,0,0,0,0);
  let DU:[]u8=lt3_world_new();
  let nd:i32=m4_dup3(SR,DU);
  let okD:i32=m4_qfresh(DU,ZL,ZT,L2,T2,G,K,R,AN,INF,3,0,DE);
  c=m4_n8(b,c,"LOC2 DUP3 srcfacts tripled okDup3",nsr,nd,okD,0,0,0,0,0);
  // (a) again: is the hole decision sensitive to arena ORDER at all?
  let HR:[]u8=z_alloc(16384);
  let HS:[]u8=z_alloc(16384);
  s3=0;
  while(s3<4096){ set32(HR,s3*4,0); s3=s3+1; }
  m4_rep_sorted(A,HR);
  let okH:i32=m4_qfresh(HR,ZL,ZT,L2,T2,G,K,R,AN,INF,2,0,DE);
  c=m4_n8(b,c,"LOC1b HOLE_on_repacked_full_arena ok hole ansn",okH,m4_hole_present(HR),0,0,0,0,0,0);
  c=m4_n8(b,c,"LOC4 lifetime plans_used plannew planld evictP structrel planrelids canon_tags",m4_plan_used(SL),get32(SL,13224),get32(SL,13228),get32(SLT,60),m4_structrel(A,SL,SLT),m4_plan_relids(A,SL),get32(SLT,56),0);
  // =============== ADDENDUM M4b ARMS ===============
  c=o_app(b,c,"PINFO_ARM"); c=o_nl(b,c);
  c=m4_pinfo_arm(b,c,SL,SLT,A);
  c=o_app(b,c,"AMORT_BEGIN"); c=o_nl(b,c);
  c=m4_amort(b,c);
  c=o_app(b,c,"AMORT_END"); c=o_nl(b,c);
  c=m4_loc8(b,c);
  lt_flush(b,c);
  return 0;
}

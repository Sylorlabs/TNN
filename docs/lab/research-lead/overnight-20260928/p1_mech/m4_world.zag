// m4_world.zag -- W4 / W4F world, goal grammar, declared answers.
// Harness side (PREREG_M4.md section 2). No literal here is reachable from
// frz_episode or lt_query.
//
// ID BANDS. Subject band 100..115 (16), SHARED by all ten stages -- required
// so that a fan-in join across stages is expressible at all. Relation band of
// stage s is 1001+100s .. 1010+100s; object band of stage s is
// 2001+100s .. 2010+100s. Bands are disjoint across stages, so per-stage
// attribution is unambiguous and LT3's LK2 value-collision confound cannot
// arise.
//
// WITNESS SIZES. Relation index k of an ordinary stage is witnessed by
// subjects 100 .. 100+w(k)-1 with
//     k : 0  1  2  3  4..9
//     w : 16 12 8  4  2
// => 16+12+8+4+6*2 = 52 facts per stage.
//
// THE HOLE. Stage 5's index-0 relation 1501 is witnessed by subjects
// 100..114 ONLY. The triple (115,1501,2501) is never delivered by an episode
// and never written to the arena, and stage 5 therefore carries 51 facts.
// The index-0 witness-size table over the ten stages is
//     {16,16,16,16,16,15,16,16,16,16}
// i.e. supported nine times and violated exactly once.
//
// W4F. Identical arena contents. The only difference is that in W4F the absent
// triple does not exist in the world either, so the declared answer for the
// hole goal is 15 subjects. W4 and W4F are observationally identical to the
// learner; that minimal pair is what makes the induction test non-vacuous.

fn m4_rb(s:i32)i32 { return 1001+100*s; }
fn m4_ob(s:i32)i32 { return 2001+100*s; }
fn m4_w(k:i32)i32 {
  if(k==0){ return 16; }
  if(k==1){ return 12; }
  if(k==2){ return 8; }
  if(k==3){ return 4; }
  return 2;
}
fn m4_wfact(s:i32,k:i32)i32 {
  let w:i32=m4_w(k);
  if(s==5){ if(k==0){ return 15; } }
  return w;
}
fn m4_nfact(s:i32)i32 {
  let k:i32=0;
  let n:i32=0;
  while(k<10){ n=n+m4_wfact(s,k); k=k+1; }
  return n;
}
fn m4_stage_into(AS:[]u8,s:i32)void {
  let i:i32=0;
  while(i<4096){ set32(AS,i*4,0); i=i+1; }
  let rb:i32=m4_rb(s);
  let ob:i32=m4_ob(s);
  let k:i32=0;
  while(k<10){
    let w:i32=m4_wfact(s,k);
    let j:i32=0;
    while(j<w){ lt3_add(AS,100+j,rb+k,ob+k); j=j+1; }
    k=k+1;
  }
  return;
}
// D distractor triples on a disjoint subject/relation/object triple of ids.
fn m4_distract(A:[]u8,d:i32)void {
  let j:i32=0;
  while(j<d){
    lt3_add(A,5000+(j%50),2001+(j/50),3001+(j%7));
    j=j+1;
  }
  return;
}
// ---- hole integrity ----
fn m4_hole_present(A:[]u8)i32 {
  let n:i32=get32(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12)==115){
      if(get32(A,4+i*12+4)==1501){
        if(get32(A,4+i*12+8)==2501){ return 1; }
      }
    }
    i=i+1;
  }
  return 0;
}
fn m4_stage5_facts(A:[]u8)i32 {
  let n:i32=get32(A,0);
  let c:i32=0;
  let i:i32=0;
  while(i<n){
    let r:i32=get32(A,4+i*12+4);
    if(r>=1501){ if(r<=1510){ c=c+1; } }
    i=i+1;
  }
  return c;
}

// ============================ GOAL GRAMMAR ============================
// Same four/three/two/five-need chain shapes the frozen lt_query executes.
// need nf=2            -> RETRIEVE (family 0)
// need nf=1+3*ns       -> VERIFY fan-in (family 1); ns=1 means the subject
//                          slot is the literal 0 placeholder that the fan-in
//                          replaces with each candidate subject
// need nf=3 [r,1,0]    -> COUNT distinct objects (family 2)
fn m4_goal4(G:[]u8,tag:i32,r0:i32,o0:i32,r1:i32,o1:i32,r2:i32,o2:i32,r3:i32)void {
  let o:i32=gq_b(G,tag,4);
  o=gq_n(G,o,tag+1,2); o=gq_f(G,o,r0); o=gq_f(G,o,o0);
  o=gq_n(G,o,tag+2,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r1); o=gq_f(G,o,o1);
  o=gq_n(G,o,tag+3,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r2); o=gq_f(G,o,o2);
  o=gq_n(G,o,tag+4,3); o=gq_f(G,o,r3); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,3);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,2,2,1);
  o=gq_k(G,o,3,3,2);
  return;
}
// four needs, the last a fan-in instead of a count -> a DIFFERENT shape
fn m4_goal4f(G:[]u8,tag:i32,r0:i32,o0:i32,r1:i32,o1:i32,r2:i32,o2:i32,r3:i32,o3:i32)void {
  let o:i32=gq_b(G,tag,4);
  o=gq_n(G,o,tag+1,2); o=gq_f(G,o,r0); o=gq_f(G,o,o0);
  o=gq_n(G,o,tag+2,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r1); o=gq_f(G,o,o1);
  o=gq_n(G,o,tag+3,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r2); o=gq_f(G,o,o2);
  o=gq_n(G,o,tag+4,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r3); o=gq_f(G,o,o3);
  o=gq_l(G,o,3);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,2,2,1);
  o=gq_k(G,o,2,3,2);
  return;
}
fn m4_goal3(G:[]u8,tag:i32,r0:i32,o0:i32,r1:i32,o1:i32,r2:i32)void {
  let o:i32=gq_b(G,tag,3);
  o=gq_n(G,o,tag+1,2); o=gq_f(G,o,r0); o=gq_f(G,o,o0);
  o=gq_n(G,o,tag+2,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r1); o=gq_f(G,o,o1);
  o=gq_n(G,o,tag+3,3); o=gq_f(G,o,r2); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,2);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,3,2,1);
  return;
}
fn m4_goal5(G:[]u8,tag:i32,r0:i32,o0:i32,r1:i32,o1:i32,r2:i32,o2:i32,r3:i32,o3:i32,r4:i32)void {
  let o:i32=gq_b(G,tag,5);
  o=gq_n(G,o,tag+1,2); o=gq_f(G,o,r0); o=gq_f(G,o,o0);
  o=gq_n(G,o,tag+2,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r1); o=gq_f(G,o,o1);
  o=gq_n(G,o,tag+3,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r2); o=gq_f(G,o,o2);
  o=gq_n(G,o,tag+4,4); o=gq_f(G,o,1); o=gq_f(G,o,0); o=gq_f(G,o,r3); o=gq_f(G,o,o3);
  o=gq_n(G,o,tag+5,3); o=gq_f(G,o,r4); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,4);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,2,2,1);
  o=gq_k(G,o,2,3,2);
  o=gq_k(G,o,3,4,3);
  return;
}
fn m4_goal2(G:[]u8,tag:i32,r0:i32,o0:i32,r1:i32)void {
  let o:i32=gq_b(G,tag,2);
  o=gq_n(G,o,tag+1,2); o=gq_f(G,o,r0); o=gq_f(G,o,o0);
  o=gq_n(G,o,tag+2,3); o=gq_f(G,o,r1); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,1);
  o=gq_k(G,o,3,1,0);
  return;
}
// unbindable: need 1 carries nf=5, which violates nf == 1+3ns for every ns,
// so no family accepts it and the correct behaviour is DECLINE.
fn m4_goalX(G:[]u8,tag:i32)void {
  let o:i32=gq_b(G,tag,3);
  o=gq_n(G,o,tag+1,2); o=gq_f(G,o,1999); o=gq_f(G,o,2999);
  o=gq_n(G,o,tag+2,5); o=gq_f(G,o,1); o=gq_f(G,o,1999); o=gq_f(G,o,2999); o=gq_f(G,o,0);
  o=gq_n(G,o,tag+3,3); o=gq_f(G,o,1999); o=gq_f(G,o,1); o=gq_f(G,o,0);
  o=gq_l(G,o,2);
  o=gq_k(G,o,2,1,0);
  o=gq_k(G,o,3,2,1);
  return;
}
// which: 0 G0   1 G4   2 G5(HOLE)  3 GACF  4 GSWAP
//        5 G14  6 G2NF 7 G2N  8 G3F  9 GX(decline)
// SHAPES: {0,1,2,3,4,8} = four-need ending in COUNT  (one shape)
//         {5}          = three-need ending in COUNT   (shape 2)
//         {6}          = five-need                   (shape 3)
//         {7}          = two-need                    (shape 4)
//         {8}          = four-need ending in FAN-IN  (shape 5)
//         {9}          = unbindable                 (shape 6)
// SIX measured shapes against the frozen 4-slot PLAN table.
fn m4_goal(which:i32,G:[]u8)void {
  if(which==0){ m4_goal4(G,9000,1001,2001,1002,2002,1003,2003,1004); return; }
  if(which==1){ m4_goal4(G,9100,1401,2401,1402,2402,1403,2403,1404); return; }
  if(which==2){ m4_goal4(G,9200,1501,2501,1502,2502,1503,2503,1504); return; }
  if(which==3){ m4_goal4(G,9300,1001,2001,1202,2202,1503,2503,1004); return; }
  if(which==4){ m4_goal4(G,9400,1601,2601,1202,2202,1003,2003,1604); return; }
  if(which==5){ m4_goal3(G,9500,1101,2101,1202,2202,1303); return; }
  if(which==6){ m4_goal5(G,9600,1001,2001,1002,2002,1003,2003,1004,2004,1005); return; }
  if(which==7){ m4_goal2(G,9700,1001,2001,1004); return; }
  if(which==8){ m4_goal4f(G,9800,1001,2001,1002,2002,1003,2003,1004,2004); return; }
  m4_goalX(G,9900);
  return;
}
// ============================ DECLARED ANSWERS ============================
// Hand-derived from the world definition above, cross-checked against the
// memory-free oracle (K3). w4f=1 selects the falsification world, in which the
// absent triple does not exist either, so the hole goal answers 15 subjects.
fn m4_appn(X:[]u8,n:i32,lo:i32)void {
  ans_append(X,n);
  let j:i32=0;
  while(j<n){ ans_append(X,100+lo+j); j=j+1; }
  return;
}
// a COUNT need answers [1, <distinct-object count>], NOT a subject list.
// Getting this wrong makes every four-need declared answer end in 100 instead
// of 1 and silently fails every oracle/declared cross-check.
fn m4_appc(X:[]u8,v:i32)void {
  ans_append(X,1);
  ans_append(X,v);
  return;
}
// need0 of the hole goal ONLY, so the stupid baseline's subject list can be
// scored against exactly the quantity it claims to recover.
fn m4_decl_h0(X:[]u8,w4f:i32)void {
  set32(X,0,0);
  let n0:i32=16;
  if(w4f==1){ n0=15; }
  m4_appn(X,n0,0);
  return;
}
fn m4_decl(which:i32,X:[]u8,w4f:i32)void {
  set32(X,0,0);
  if(which==9){ set32(X,0,-1); return; }
  if(which==5){ m4_appn(X,16,0); m4_appn(X,12,0); m4_appc(X,1); return; }
  if(which==7){ m4_appn(X,16,0); m4_appc(X,1); return; }
// A VERIFY need reached by a KIND-2 link answers the LIST of passing subjects,
  // NOT [1,1]. compose_iter (c8_learn.zag:703-722) walks every element of the
  // source need's output list, substitutes it, and appends every subject whose
  // chain verifies; ss appears nowhere on that path. apply_kind1 handles KIND-1
  // (scalar copy) links and is not involved. ERRATA M4c E6/E7; certified vectors
  // ANSV ANS_G3F_AGED n=44 and ANSV OR_G3F n=44 both end 4,100,101,102,103.
  if(which==8){ m4_appn(X,16,0); m4_appn(X,12,0); m4_appn(X,8,0); m4_appn(X,4,0); return; }
  if(which==6){
    m4_appn(X,16,0); m4_appn(X,12,0); m4_appn(X,8,0); m4_appn(X,4,0); m4_appc(X,1);
    return;
  }
  let n0:i32=16;
  if(which==2){ if(w4f==1){ n0=15; } }
  m4_appn(X,n0,0); m4_appn(X,12,0); m4_appn(X,8,0); m4_appc(X,1);
  return;
}
// APP-STAGES: how many distinct stages' relations appear in this goal's need
// fields. Harness-side ground truth for "how much prior structure applies".
fn m4_rbase_of(r:i32)i32 {
  let s:i32=(r-1001)/100;
  return 1001+100*s;
}
fn m4_goal_stages(which:i32) i32 {
  if(which==0){ return 1; }
  if(which==1){ return 1; }
  if(which==2){ return 1; }
  if(which==3){ return 3; }
  if(which==4){ return 3; }
  if(which==5){ return 3; }
  if(which==6){ return 1; }
  if(which==7){ return 1; }
  if(which==8){ return 1; }
  return 0;
}
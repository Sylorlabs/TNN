// m4_rule.zag -- the STUPID BASELINE, the arena lesions, and the
// applicability-sensitive reuse measures. Harness side (PREREG_M4 section 3/4/7).
// None of this is reachable from frz_episode or lt_query.

// ================= STUPID BASELINE: MAJORITY WITNESS-SIZE =================
// Arena-only induction. No world definition, no stage id, no declared answer,
// no learner memory, no episodes. Signature takes (A, r) only.
//
// Step 1. Identify the query relation's FAMILY by arena contiguity: the largest
//        b <= r such that every relation b..b+9 occurs in A. In W4 the bands
//        are 90 apart, so a maximal run of 10 is unique.
// Step 2. k = r - b, the relation's INDEX within its family.
// Step 3. For every OTHER family b', look up b'+k and record |W(b'+k)|, the
//        number of distinct subjects witnessed.
// Step 4. Take the modal size, and return the witness set of the
//        highest-numbered other family whose index-k size equals the mode.
//
// It has no parameters that could encode the answer, and it is falsifiable:
// see the W4F row, where the same call must be wrong.
// out[0] = n, out[4+..] = subjects.  inf[0]=b, inf[4]=k, inf[8]=modal,
// inf[12]=#other families, inf[16]=#distinct sizes seen.
fn m4_hasrel(A:[]u8,r:i32)i32 {
  let n:i32=get32(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12+4)==r){ return 1; }
    i=i+1;
  }
  return 0;
}
fn m4_wsub(A:[]u8,r:i32,out:[]u8)i32 {
  set32(out,0,0);
  let n:i32=get32(A,0);
  let i:i32=0;
  while(i<n){
    if(get32(A,4+i*12+4)==r){
      let s:i32=get32(A,4+i*12);
      let m:i32=get32(out,0);
      let d:i32=0;
      let j:i32=0;
      while(j<m){
        if(get32(out,4+j*4)==s){ d=1; }
        j=j+1;
      }
      if(d==0){
        if(m<16){
          set32(out,4+m*4,s);
          set32(out,0,m+1);
        }
      }
    }
    i=i+1;
  }
  return get32(out,0);
}
fn m4_rbase(A:[]u8,r:i32)i32 {
  let b:i32=r;
  while(b>1001){
    if(m4_hasrel(A,b-1)==0){ return b; }
    b=b-1;
  }
  return b;
}
// distinct family bases, ascending
fn m4_families(A:[]u8,fam:[]u8)i32 {
  set32(fam,0,0);
  let n:i32=get32(A,0);
  let i:i32=0;
  while(i<n){
    let r:i32=get32(A,4+i*12+4);
    let b:i32=m4_rbase(A,r);
    let m:i32=get32(fam,0);
    let d:i32=0;
    let j:i32=0;
    while(j<m){
      if(get32(fam,4+j*4)==b){ d=1; }
      j=j+1;
    }
    if(d==0){
      if(m<32){
        set32(fam,4+m*4,b);
        set32(fam,0,m+1);
      }
    }
    i=i+1;
  }
  return get32(fam,0);
}
fn m4_stupid(A:[]u8,r:i32,out:[]u8,inf:[]u8) i32 {
  let fam:[]u8=z_alloc(160);
  let ws:[]u8=z_alloc(128);
  let sz:[]u8=z_alloc(160);
  let nb:i32=m4_families(A,fam);
  let b:i32=m4_rbase(A,r);
  let k:i32=r-b;
  let no:i32=0;
  let i:i32=0;
  while(i<nb){
    let b2:i32=get32(fam,4+i*4);
    if(b2!=b){
      let r2:i32=b2+k;
      if(m4_hasrel(A,r2)==1){
        set32(sz,4+no*4,m4_wsub(A,r2,ws));
        no=no+1;
      }
    }
    i=i+1;
  }
  // modal size; ties resolved toward the SMALLER size (deterministic)
  let modal:i32=-1;
  let best:i32=0;
  let j:i32=0;
  while(j<no){
    let v:i32=get32(sz,4+j*4);
    let f:i32=0;
    let q:i32=0;
    while(q<no){
      if(get32(sz,4+q*4)==v){ f=f+1; }
      q=q+1;
    }
    if(f>best){ best=f; modal=v; }
    if(f==best){
      if(modal<0){ modal=v; }
      if(v<modal){ modal=v; }
    }
    j=j+1;
  }
  set32(inf,0,b);
  set32(inf,4,k);
  set32(inf,8,modal);
  set32(inf,12,no);
  set32(inf,16,no);
  set32(out,0,0);
  if(no==0){ return 0; }
  // highest-numbered other family whose index-k size equals the mode
  let pick:i32=-1;
  let t:i32=0;
  while(t<nb){
    let b3:i32=get32(fam,4+t*4);
    if(b3!=b){
      let r3:i32=b3+k;
      if(m4_hasrel(A,r3)==1){
        if(m4_wsub(A,r3,ws)==modal){ pick=r3; }
      }
    }
    t=t+1;
  }
  if(pick<0){ return 0; }
  return m4_wsub(A,pick,out);
}

// Write the ANCHOR at out[0], so a caller can prepend a count to a witness
// list it already has. (First build bug: the hole-goal scorer appended the
// subject list without its leading count, so both STUPID rows scored 0.)
fn m4_anchor(X:[]u8,SB:[]u8,ns:i32)void {
  set32(X,0,0);
  ans_append(X,ns);
  let j:i32=0;
  while(j<ns){ ans_append(X,get32(SB,4+j*4)); j=j+1; }
  return;
}
// ================= ARENA LESIONS (K-LOC1, K-LOC2) =================
// identical fact set, sorted by (relation, subject). Content-equivalent.
fn m4_repack(SRC:[]u8,DST:[]u8) i32 {
  let n:i32=get32(SRC,0);
  let i:i32=0;
  while(i<n){
    // minimum (relation, subject) over the whole arena among unconsumed facts.
    // An earlier version searched only the already-consumed prefix and emitted
    // SRC[0] first, so the output was a lossy scramble rather than a
    // permutation and K-LOC1 was meaningless.
    let br:i32=0;
    let bs:i32=0;
    let bk:i32=-1;
    let j:i32=0;
    while(j<n){
      let rj:i32=get32(SRC,4+j*12+4);
      if(rj>0){
        let sj:i32=get32(SRC,4+j*12);
        let take:i32=0;
        if(bk<0){ take=1; }
        if(bk>=0){
          if(rj<br){ take=1; }
          if(rj==br){ if(sj<bs){ take=1; } }
        }
        if(take==1){ br=rj; bs=sj; bk=j; }
      }
      j=j+1;
    }
    let w:i32=get32(DST,0);
    set32(DST,4+w*12,get32(SRC,4+bk*12));
    set32(DST,4+w*12+4,get32(SRC,4+bk*12+4));
    set32(DST,4+w*12+8,get32(SRC,4+bk*12+8));
    set32(DST,0,w+1);
    set32(SRC,4+bk*12+4,0);
    i=i+1;
  }
  return get32(DST,0);
}
fn m4_rep_sorted(SRC:[]u8,DST:[]u8) i32 {
  let T:[]u8=z_alloc(16384);
  lt_copy(T,SRC,16384);
  return m4_repack(T,DST);
}
fn m4_dup3(SRC:[]u8,DST:[]u8) i32 {
  let n:i32=get32(SRC,0);
  let r:i32=0;
  let j:i32=0;
  while(j<3){
    let i:i32=0;
    while(i<n){
      lt3_add(DST,get32(SRC,4+i*12),get32(SRC,4+i*12+4),get32(SRC,4+i*12+8));
      i=i+1;
    }
    j=j+1;
  }
  r=get32(DST,0);
  return r;
}

// ================= STRUCTURE SCANS (K-R1c) =================
// Is this cell value one of the world's ACTUAL relation ids? The test is
// exact membership: the value occurs as the relation field of some triple in
// the arena. No congruence shortcut -- a shortcut would have silently missed
// nine tenths of the relation ids in this world.
fn m4_isrelid(A:[]u8,v:i32)i32 {
  if(v<=0){ return 0; }
  return m4_hasrel(A,v);
}
// executable structure: template store LT[200..776), LT bind store
// LT[800..1056), frozen bind table L[12744..13000), frozen plan table
// L[13000..13224).
fn m4_structrel(A:[]u8,L:[]u8,LT:[]u8) i32 {
  let c:i32=0;
  let o:i32=200;
  while(o<776){
    if(m4_isrelid(A,get32(LT,o))==1){ c=c+1; }
    o=o+4;
  }
  o=800;
  while(o<1056){
    if(m4_isrelid(A,get32(LT,o))==1){ c=c+1; }
    o=o+4;
  }
  o=12744;
  while(o<13224){
    if(m4_isrelid(A,get32(L,o))==1){ c=c+1; }
    o=o+4;
  }
  return c;
}
// same, but skipping the two SIGNATURE-KEY cells per entry (template b+0 and
// bind-store b+0), which hold hashes. If a hit is reported here and not by
// m4_structrel_ex, it is a hash coincidence rather than a stored relation id.
fn m4_structrel_x(A:[]u8,L:[]u8,LT:[]u8) i32 {
  let c:i32=0;
  let e:i32=0;
  while(e<12){
    let b:i32=lt_tb(e);
    let k:i32=0;
    while(k<12){
      if(m4_isrelid(A,get32(LT,b+k*4))==1){ c=c+1; }
      k=k+1;
    }
    e=e+1;
  }
  e=0;
  while(e<16){
    let b:i32=lt_bb(e);
    let k:i32=0;
    while(k<4){
      if(k>0){
        if(m4_isrelid(A,get32(LT,b+k*4))==1){ c=c+1; }
      }
      k=k+1;
    }
    e=e+1;
  }
  e=0;
  while(e<4){
    let b:i32=13000+e*56;
    let k:i32=0;
    while(k<14){
      if(k>0){
        if(m4_isrelid(A,get32(L,b+k*4))==1){ c=c+1; }
      }
      k=k+1;
    }
    e=e+1;
  }
  return c;
}
// the functional-arity belief store LT[1100..5800) DOES hold relation ids.
fn m4_funrel(A:[]u8,LT:[]u8) i32 {
  let c:i32=0;
  let o:i32=1100;
  while(o<5800){
    if(m4_isrelid(A,get32(LT,o))==1){ c=c+1; }
    o=o+4;
  }
  return c;
}

// ================= APPLICABILITY-SENSITIVE MEASURES (K-R2) =================
// Does the family the learner BOUND for this need's shape actually accept this
// need's fields? This is the arity/aggregate-op test try_family applies, run
// on the concrete need rather than on the shape alone.
fn m4_fam_ok(G:[]u8,i:i32,fam:i32) i32 {
  let nf:i32=need_nf(G,i);
  if(fam==0){
    if(nf==2){ return 1; }
    return 0;
  }
  if(fam==1){
    if(nf>=4){
      let ns:i32=need_f(G,i,0);
      if(ns>=1){
        if(ns<=16){
          if(nf==1+ns*3){ return 1; }
        }
      }
    }
    return 0;
  }
  if(fam==2){
    if(nf==3){
      if(need_f(G,i,1)==1){ return 1; }
    }
    return 0;
  }
  return 0;
}
// matched needs / total needs, as matched*1000+total to keep it one integer.
fn m4_appmatch(L:[]u8,LT:[]u8,G:[]u8) i32 {
  let nn:i32=g_nneeds(G);
  let m:i32=0;
  let i:i32=0;
  while(i<nn){
    let sig:i32=lt_sig_need(G,i);
    let c:i32=lt_bs_find(LT,sig);
    if(c>=0){
      let tag:i32=get32(LT,lt_bb(c)+4);
      let bi:i32=bind_find(L,tag);
      if(bi>=0){
        let fam:i32=bind_fam(L,bi);
        if(m4_fam_ok(G,i,fam)==1){ m=m+1; }
      }
    }
    i=i+1;
  }
  return m*1000+nn;
}
// STUPID reuse baseline: fires iff ANY template exists. The null measure.
fn m4_appstupid(LT:[]u8) i32 {
  let i:i32=0;
  while(i<12){
    if(get32(LT,lt_tb(i))!=0){ return 1; }
    i=i+1;
  }
  return 0;
}
// poison bits: templates whose st byte is 2 (permanently declining shape)
fn m4_poison_n(LT:[]u8) i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<12){
    if(get32(LT,lt_tb(i))==0){ return c; }
    if(get32(LT,lt_tb(i)+8)==2){ c=c+1; }
    i=i+1;
  }
  return c;
}
fn m4_poison_clear(LT:[]u8)void {
  let i:i32=0;
  while(i<12){
    if(get32(LT,lt_tb(i))==0){ return; }
    set32(LT,lt_tb(i)+8,0);
    i=i+1;
  }
  return;
}
fn m4_tmpl_n(LT:[]u8) i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<12){
    if(get32(LT,lt_tb(i))!=0){ c=c+1; }
    i=i+1;
  }
  return c;
}
// plan table: slots used, distinct canonical tags planned, evictions
fn m4_plan_used(L:[]u8) i32 {
  let c:i32=0;
  let i:i32=0;
  while(i<4){
    if(get32(L,13000+i*56)!=0){ c=c+1; }
    i=i+1;
  }
  return c;
}
// the plan record's cells that hold a need index / need tag / family
fn m4_plan_relids(A:[]u8,L:[]u8) i32 {
  let c:i32=0;
  let p:i32=0;
  while(p<4){
    if(get32(L,13000+p*56)!=0){
      let nn:i32=get32(L,13000+p*56+4);
      let q:i32=0;
      while(q<nn){
        let e:i32=13000+p*56+8+q*12;
        if(m4_isrelid(A,get32(L,e))==1){ c=c+1; }
        if(m4_isrelid(A,get32(L,e+4))==1){ c=c+1; }
        if(m4_isrelid(A,get32(L,e+8))==1){ c=c+1; }
        q=q+1;
      }
    }
    p=p+1;
  }
  return c;
}
// L[12716..12744): 28 bytes BELOW the frozen bind table (bind_off(0)=12744).
// bind_new returning -1 makes bind_fam read, and try_family's bookkeeping
// write, at this window.
fn m4_oob(L:[]u8) i32 {
  let i:i32=0;
  while(i<7){
    if(get32(L,12716+i*4)!=0){ return 1; }
    i=i+1;
  }
  return 0;
}
fn m4_oob_sum(L:[]u8) i32 {
  let s:i32=0;
  let i:i32=0;
  while(i<7){ s=s+get32(L,12716+i*4); i=i+1; }
  return s;
}
fn m4_n8(b:[]u8,c:i32,l:[]u8,v0:i32,v1:i32,v2:i32,v3:i32,v4:i32,v5:i32,v6:i32,v7:i32)i32 {
  c=o_app(b,c,l);
  c=o_app(b,c," "); c=o_i64(b,c,v0 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,v1 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,v2 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,v3 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,v4 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,v5 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,v6 as i64);
  c=o_app(b,c," "); c=o_i64(b,c,v7 as i64);
  c=o_nl(b,c);
  return c;
}

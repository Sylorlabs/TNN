fn chainq(hops:i32)void {
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  let i:i32=0;
  while(i<hops){
    ev_teach(W,1+i,11,2+i);
    i=i+1;
  }
  let exp:i32=1+hops;
  let a:i32=ev_query(W,1,40,exp,0);
  let st:i32=hg(W,16); let tried:i32=st/1024; let rej:i32=st-tried*1024;
  emit("hops="); e64(hops); emit(" ans="); e64(a);
  emit(" tried="); e64(tried); emit(" rej="); e64(rej); emit("\n");
  return;
}
fn main()i32 {
  emit("PROBE-PA-DEPTH\n");
  chainq(2); chainq(3); chainq(4); chainq(5); chainq(6);
  return 0;
}

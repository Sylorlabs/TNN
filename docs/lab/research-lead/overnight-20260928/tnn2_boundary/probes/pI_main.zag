fn guide_bid(W:[]u8,s:i32)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,4)==s && ng(W,n,20)==30){return bid(W,n);}
    n=n+1;
  }
  return -999;
}
fn sel_guide(W:[]u8)i32 {
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==30){
      let e:i32=0;
      while(e<4096){
        if(eg(W,e,0)!=-1 && eg(W,e,0)==n && eg(W,e,4)==6 && eg(W,e,8)==n){return ng(W,n,4);}
        e=e+1;
      }
    }
    n=n+1;
  }
  return -1;
}
fn main()i32 {
  emit("PROBE-PI-GUIDES\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,9001,77,5);
  ev_query(W,9002,77,-2,0);
  ev_query(W,9003,77,-2,0);
  emit("bid9002="); e64(guide_bid(W,9002)); emit(" bid9003="); e64(guide_bid(W,9003)); emit("\n");
  ctx_push(W,9002); ctx_push(W,9003);
  let a1:i32=ev_act(W);
  emit("act both-ctx -> "); e64(a1); emit(" selected="); e64(sel_guide(W)); emit("\n");
  let a2:i32=ev_act(W);
  emit("act again -> "); e64(a2); emit(" selected="); e64(sel_guide(W)); emit("\n");
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach(W2,9001,77,5);
  ev_query(W2,9002,77,-2,0);
  ev_query(W2,9003,77,-2,0);
  let n:i32=2;
  while(n<1024){
    if(ng(W2,n,36)==1 && ng(W2,n,0)==1 && ng(W2,n,4)==9003 && ng(W2,n,20)==30){link_edge(W2,n,6,n,0);}
    n=n+1;
  }
  emit("boosted bid9003="); e64(guide_bid(W2,9003)); emit("\n");
  ctx_push(W2,9002); ctx_push(W2,9003);
  let a3:i32=ev_act(W2);
  emit("act boosted -> "); e64(a3); emit(" selected="); e64(sel_guide(W2)); emit("\n");
  return 0;
}

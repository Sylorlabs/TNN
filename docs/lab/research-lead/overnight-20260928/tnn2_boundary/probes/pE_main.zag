fn find_map(W:[]u8,r:i32)i32 {
  let m:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==r){m=n;}
    n=n+1;
  }
  return m;
}
fn main()i32 {
  emit("PROBE-PE-REVISION\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  let q0:i32=ev_query(W,101,40,201,0);
  let m:i32=find_map(W,40);
  let root:i32=ng(W,m,20);
  emit("promote q="); e64(q0); emit(" map="); e64(m); emit("\n");
  let st0:i32=map_standing(W,m);
  let o1:i32=ev_observe(W,102,12,999);
  let x1:i32=t2_exec(W,root,101);
  let q1:i32=ev_query(W,101,40,-2,0);
  emit("E1 terminal: observe="); e64(o1); emit(" exec="); e64(x1);
  emit(" query="); e64(q1);
  emit(" standing="); e64(map_standing(W,m)); emit(" st0="); e64(st0); emit("\n");
  let o2:i32=ev_observe(W,102,12,555);
  let x2:i32=t2_exec(W,root,101);
  emit("E2 second: observe="); e64(o2); emit(" exec="); e64(x2); emit("\n");
  let o3:i32=ev_observe(W,102,12,201);
  let x3:i32=t2_exec(W,root,101);
  let q3:i32=ev_query(W,101,40,-2,0);
  emit("E3 revert: observe="); e64(o3); emit(" exec="); e64(x3);
  emit(" query="); e64(q3); emit("\n");
  let W2:[]u8=z_alloc(110656); tnn2_init(W2);
  ev_teach(W2,101,11,102); ev_teach(W2,102,12,201);
  let qq:i32=ev_query(W2,101,40,201,0);
  let m2:i32=find_map(W2,40);
  let root2:i32=ng(W2,m2,20);
  let o4:i32=ev_observe(W2,101,11,777);
  let x4:i32=t2_exec(W2,root2,101);
  let q4:i32=ev_query(W2,101,40,-2,0);
  emit("E4 interior: promote="); e64(qq); emit(" observe="); e64(o4);
  emit(" exec="); e64(x4); emit(" query="); e64(q4); emit("\n");
  let o5:i32=ev_observe(W2,101,40,777);
  let q5:i32=ev_query(W2,101,40,-2,0);
  emit("E5 contra-promoted: observe="); e64(o5); emit(" query="); e64(q5); emit("\n");
  return 0;
}

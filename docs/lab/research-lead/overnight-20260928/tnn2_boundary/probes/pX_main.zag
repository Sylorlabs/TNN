fn find_map(W:[]u8,r:i32)i32 {
  let m:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==r){m=n;}
    n=n+1;
  }
  return m;
}
fn main()i32 {
  emit("PROBE-PX-DIAG\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,101,11,102); ev_teach(W,102,12,201);
  let qq:i32=ev_query(W,101,40,201,0);
  let m:i32=find_map(W,40);
  let root:i32=ng(W,m,20);
  emit("promote="); e64(qq); emit(" map="); e64(m); emit(" root="); e64(root); emit("\n");
  let x0:i32=t2_exec(W,root,101);
  emit("exec-before="); e64(x0); emit("\n");
  let o:i32=ev_observe(W,101,11,777);
  emit("observe="); e64(o); emit("\n");
  let x1:i32=t2_exec(W,root,101);
  emit("exec-after="); e64(x1); emit("\n");
  emit("edge12-live: ");
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,4)==12){ emit("["); e64(eg(W,e,0)); emit("->"); e64(eg(W,e,8)); emit("]"); }
    e=e+1;
  }
  emit("\n");
  emit("guards102: ");
  let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==102){ emit("g"); e64(n); emit(" f12="); e64(ng(W,n,12)); emit(" f16="); e64(ng(W,n,16)); emit(";"); }
    n=n+1;
  }
  emit("\n");
  emit("sets101: ");
  n=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==101){ emit("s"); e64(n); emit(" lit="); e64(ng(W,n,8)); emit(";"); }
    n=n+1;
  }
  emit("\n");
  return 0;
}

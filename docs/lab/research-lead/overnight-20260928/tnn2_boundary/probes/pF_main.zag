fn tag_census(W:[]u8,root:i32)void {
  let c101:i32=0; let c102:i32=0; let c103:i32=0; let c104:i32=0; let cother:i32=0;
  let cur:i32=root; let n:i32=0;
  while(cur>=0 && n<64){
    let tag:i32=ng(W,cur,0);
    if(tag==101){c101=c101+1;}
    else {if(tag==102){c102=c102+1;}
    else {if(tag==103){c103=c103+1;}
    else {if(tag==104){c104=c104+1;} else {cother=cother+1;}}}}
    if(tag==102){cur=ng(W,cur,12);} else {cur=seq_nx(W,cur);}
    n=n+1;
  }
  emit("cells="); e64(n); emit(" 101="); e64(c101); emit(" 102="); e64(c102);
  emit(" 103="); e64(c103); emit(" 104="); e64(c104); emit(" other="); e64(cother); emit("\n");
  return;
}
fn map_dep_fact(W:[]u8,m:i32,s:i32,r:i32,o:i32)i32 {
  let factn:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==1 && ng(W,n,20)==s && ng(W,n,24)==r && ng(W,n,28)==o){factn=n;}
    n=n+1;
  }
  if(factn<0){return -1;}
  let e:i32=0;
  while(e<4096){
    if(eg(W,e,0)!=-1 && eg(W,e,0)==m && eg(W,e,4)==1 && eg(W,e,8)==factn){return 1;}
    e=e+1;
  }
  return 0;
}
fn find_mapr(W:[]u8,r:i32)i32 {
  let m:i32=-1; let n:i32=2;
  while(n<1024){
    if(ng(W,n,36)==1 && ng(W,n,0)==20 && ng(W,n,4)==r){m=n;}
    n=n+1;
  }
  return m;
}
fn main()i32 {
  emit("PROBE-PF-COMPOSITION\n");
  let W:[]u8=z_alloc(110656); tnn2_init(W);
  ev_teach(W,1,11,2); ev_teach(W,2,11,3);
  let a1:i32=ev_query(W,1,40,3,0);
  let m1:i32=find_mapr(W,40);
  let r1:i32=ng(W,m1,20);
  emit("MAP1 q="); e64(a1); emit(" root1="); e64(r1); emit("\n");
  tag_census(W,r1);
  ev_teach(W,3,11,4); ev_teach(W,4,11,5);
  let a2:i32=ev_query(W,1,41,5,0);
  let m2:i32=find_mapr(W,41);
  let r2:i32=ng(W,m2,20);
  emit("MAP2 q="); e64(a2); emit(" root2="); e64(r2); emit("\n");
  tag_census(W,r2);
  emit("roots-distinct="); e64(r1-r2); emit("\n");
  emit("MAP2-dep-on-promoted-fact(1,40,3)=");
  e64(map_dep_fact(W,m2,1,40,3)); emit("\n");
  let x1:i32=t2_exec(W,r1,1);
  emit("MAP1 re-exec="); e64(x1); emit("\n");
  return 0;
}
